{"ID":"20230927161520-pd01b21","Spec":"2","Type":"NodeDocument","Properties":{"id":"20230927161520-pd01b21","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20230927161520-pd01b21\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20230927161520-oit0qa1\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20230927161520-oit0qa1\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20230927161520-oit0qa1\u0026quot;,\u0026quot;focusStart\u0026quot;:69,\u0026quot;focusEnd\u0026quot;:69\u0026#125;","title":"【桑菊饮】","type":"doc","updated":"20230927161524"},"Children":[{"ID":"20230927161520-oit0qa1","Type":"NodeParagraph","Properties":{"id":"20230927161520-oit0qa1","updated":"20230927161524"},"Children":[{"Type":"NodeText","Data":"桑菊饮组成：杏仁二钱，连翘一钱五分，薄荷八分，桑叶二钱五分，菊花一钱，苦梗二钱，甘草八分（生），苇根二钱。上用水二杯，煮取一杯，一日二次。"}]}]}