6sj","updated":"20231220162241"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"坎一联申脉，照海坤二五。"}]},{"ID":"20231220161722-bxxcs2r","Type":"NodeParagraph","Properties":{"id":"20231220161722-bxxcs2r","updated":"20231220162242"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"震三属外关，巽四临泣数。"}]},{"ID":"20231220161725-49s3gy8","Type":"NodeParagraph","Properties":{"id":"20231220161725-49s3gy8","updated":"20231220162244"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乾六是公孙，兑七后溪府。"}]},{"ID":"20231220161727-hjtx3wj","Type":"NodeParagraph","Properties":{"id":"20231220161727-hjtx3wj","updated":"20231220162245"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艮八系内关，离九列缺主。"}]},{"ID":"20230928082155-ul2lql6","Type":"NodeParagraph","Properties":{"id":"20230928082155-ul2lql6"}},{"ID":"20230928082152-u7aso08","Type":"NodeParagraph","Properties":{"id":"20230928082152-u7aso08","updated":"20230928082224"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"后溪：督脉\t（跟申脉是一组）"}]},{"ID":"20230928082152-5lg82m1","Type":"NodeParagraph","Properties":{"id":"20230928082152-5lg82m1","updated":"20230928082225"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"公孙：冲脉\t（跟内关是一组）"}]},{"ID":"20230928082152-6ds2nw7","Type":"NodeParagraph","Properties":{"id":"20230928082152-6ds2nw7","updated":"20230928082225"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"申脉：阳跷\t（跟后溪是一组）"}]},{"ID":"20230928082152-ki14lio","Type":"NodeParagraph","Properties":{"id":"20230928082152-ki14lio","updated":"20230928082228"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内关：阴维\t（跟公孙是一组）"}]},{"ID":"20230928082152-xsw9hfv","Type":"NodeParagraph","Properties":{"id":"20230928082152-xsw9hfv","updated":"20230928082227"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外关：阳维\t（跟临泣是一组）"}]},{"ID":"20230928082152-ryniw2y","Type":"NodeParagraph","Properties":{"id":"20230928082152-ryniw2y","updated":"20230928082229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"临泣：带脉\t（跟外关是一组）"}]},{"ID":"20230928082152-3t0rp6q","Type":"NodeParagraph","Properties":{"id":"20230928082152-3t0rp6q","updated":"20230928082229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"列缺：任脉\t（跟照海是一组）"}]},{"ID":"20230928082152-zzlrkth","Type":"NodeParagraph","Properties":{"id":"20230928082152-zzlrkth","updated":"20230928082231"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"照海：阴跷\t（跟列缺是一组）"}]},{"ID":"20230928082219-l9mrdpl","Type":"NodeParagraph","Properties":{"id":"20230928082219-l9mrdpl"}},{"ID":"20230928082152-79rc6cy","Type":"NodeParagraph","Properties":{"id":"20230928082152-79rc6cy","updated":"20230928082234"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"灵龟八法：无需辩证，在该日该时辰按照灵龟八法下针，皆可有效；唯一需要判断的就是根据病人虚实症进行补或泻；"}]},{"ID":"20230928082152-xf8co26","Type":"NodeParagraph","Properties":{"id":"20230928082152-xf8co26","updated":"20230928082236"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一组一组扎，如算的当前应该扎临泣穴，那就扎临泣+外关穴；"}]},{"ID":"20230928082152-207d4qz","Type":"NodeParagraph","Properties":{"id":"20230928082152-207d4qz","updated":"20230928082236"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：如开数是5，男取照海，女取内关；"}]},{"ID":"20231211102949-0nyqmi9","Type":"NodeParagraph","Properties":{"id":"20231211102949-0nyqmi9"}},{"ID":"20231211102949-1o83vcj","Type":"NodeParagraph","Properties":{"id":"20231211102949-1o83vcj"}},{"ID":"20231211102941-hndie0y","Type":"NodeParagraph","Properties":{"id":"20231211102941-hndie0y","updated":"20231211102947"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"灵龟八法日时天干的代表数值"}]},{"ID":"20231211102957-ec9huub","Type":"NodeParagraph","Properties":{"id":"20231211102957-ec9huub","updated":"20231211102957"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20231211102957-wvqzcsv.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20230928082152-vockcki","Type":"NodeParagraph","Properties":{"id":"20230928082152-vockcki","updated":"20231211103012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"除，所得"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E4%BD%99%E6%95%B0/6180737?fromModule=lemma_inlink","TextMarkTextContent":"余数"},{"Type":"NodeText","Data":"（不是商数）就是九宫数。如恰能除尽，则阳日之九宫数（余数）是9，阴日之九宫数是6。"}]},{"ID":"20231211103025-q2bb07o","Type":"NodeParagraph","Properties":{"id":"20231211103025-q2bb07o","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"计算范例"}]},{"ID":"20231211103025-6a9l2v2","Type":"NodeParagraph","Properties":{"id":"20231211103025-6a9l2v2","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"例一：甲子日"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E6%88%8A%E8%BE%B0%E6%97%B6/6753514?fromModule=lemma_inlink","TextMarkTextContent":"戊辰时"},{"Type":"NodeText","Data":"，用灵龟八法，取何穴？"}]},{"ID":"20231211103025-j3l186l","Type":"NodeParagraph","Properties":{"id":"20231211103025-j3l186l","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解答：甲得10数，子得7数，戊得5数，辰得5数，"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E7%94%B2%E5%AD%90/35869?fromModule=lemma_inlink","TextMarkTextContent":"甲子"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E6%88%8A%E8%BE%B0/4091482?fromModule=lemma_inlink","TextMarkTextContent":"戊辰"},{"Type":"NodeText","Data":"之基数相加，共得27数（10+7+"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/5+5/3068962?fromModule=lemma_inlink","TextMarkTextContent":"5+5"},{"Type":"NodeText","Data":"=27）。"}]},{"ID":"20231211103025-cneuv35","Type":"NodeParagraph","Properties":{"id":"20231211103025-cneuv35","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"此甲子日是阳日，应除以九，余9数（27/9得商3"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E4%BD%99%E6%95%B0/6180737?fromModule=lemma_inlink","TextMarkTextContent":"余数"},{"Type":"NodeText","Data":"0——"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E9%99%A4%E5%B0%BD/6281997?fromModule=lemma_inlink","TextMarkTextContent":"除尽"},{"Type":"NodeText","Data":"则以9代之，因为27/9得商2余数9——取此余数9查八穴纳卦数）。"}]},{"ID":"20231211103025-xfcaqy4","Type":"NodeParagraph","Properties":{"id":"20231211103025-xfcaqy4","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即取离宫9数为"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E5%88%97%E7%BC%BA/10047628?fromModule=lemma_inlink","TextMarkTextContent":"列缺"},{"Type":"NodeText","Data":"穴。"}]},{"ID":"20231211103025-oun7uth","Type":"NodeParagraph","Properties":{"id":"20231211103025-oun7uth","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"例二：乙丑日"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E5%A3%AC%E5%8D%88%E6%97%B6/7143392?fromModule=lemma_inlink","TextMarkTextContent":"壬午时"},{"Type":"NodeText","Data":"，用灵龟八法，取何穴？"}]},{"ID":"20231211103025-i5yenva","Type":"NodeParagraph","Properties":{"id":"20231211103025-i5yenva","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解答：乙得9数，丑得10数，壬得6数，午得9数，共34数（9+10+6+9=34）。"}]},{"ID":"20231211103025-goch1al","Type":"NodeParagraph","Properties":{"id":"20231211103025-goch1al","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"此乙丑日是阴日，应除以六，余4数（34/6=5"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E5%95%86%E6%95%B0/3212397?fromModule=lemma_inlink","TextMarkTextContent":"商数"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://baike.baidu.com/item/%E4%BD%99%E6%95%B0/6180737?fromModule=lemma_inlink","TextMarkTextContent":"余数"},{"Type":"NodeText","Data":"4）。"}]},{"ID":"20231211103025-goj7v7i","Type":"NodeParagraph","Properties":{"id":"20231211103025-goj7v7i","updated":"20231211103025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即取巽4临泣穴。"}]},{"ID":"20231211103024-fpxvtnw","Type":"NodeParagraph","Properties":{"id":"20231211103024-fpxvtnw"}},{"ID":"20230928082301-c2w39tn","Type":"NodeParagraph","Properties":{"id":"20230928082301-c2w39tn","updated":"20230928082301"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"灵龟八法"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/灵龟八法-20230928082301-0ywcb4e.jpeg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20231211102936-0i7a9vz","Type":"NodeParagraph","Properties":{"id":"20231211102936-0i7a9vz"}}]}