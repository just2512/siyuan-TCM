{"ID":"20230928082526-9b5phxl","Spec":"2","Type":"NodeDocument","Properties":{"id":"20230928082526-9b5phxl","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20230928082526-9b5phxl\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20230928082532-vckgaih\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20230928082532-yzvad59\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20230928082532-yzvad59\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:32\u0026#125;","title":"【五俞穴治疗法】","type":"doc","updated":"20230928082615"},"Children":[{"ID":"20230928082532-vckgaih","Type":"NodeParagraph","Properties":{"id":"20230928082532-vckgaih","updated":"20230928082609"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"井（冬）\t\t主心下满"}]},{"ID":"20230928082532-wukby2t","Type":"NodeParagraph","Properties":{"id":"20230928082532-wukby2t","updated":"20230928082610"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荣（春）\t\t主身热"}]},{"ID":"20230928082532-cm7e1mk","Type":"NodeParagraph","Properties":{"id":"20230928082532-cm7e1mk","updated":"20230928082611"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俞（夏）\t\t主体重、结痛"}]},{"ID":"20230928082532-46oxo8l","Type":"NodeParagraph","Properties":{"id":"20230928082532-46oxo8l","updated":"20230928082612"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"经（长夏）\t主喘、咳、嗽"}]},{"ID":"20230928082532-6yaq498","Type":"NodeParagraph","Properties":{"id":"20230928082532-6yaq498","updated":"20230928082612"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"合（秋）\t\t主逆气而泄"}]},{"ID":"20230928082534-h28tvt1","Type":"NodeParagraph","Properties":{"id":"20230928082534-h28tvt1"}},{"ID":"20230928082532-0cse4hl","Type":"NodeParagraph","Properties":{"id":"20230928082532-0cse4hl","updated":"20230928082614"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用场景：例如有人头昏发热恶风，太阳症，则可以下太阳经的荣穴，通谷穴；"}]},{"ID":"20230928082532-xusz6er","Type":"NodeParagraph","Properties":{"id":"20230928082532-xusz6er","updated":"20230928082614"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用场景：例有人关节疼痛，疼痛点后项的位置，后项有膀胱经和胆经络过，这时可以下膀胱经和胆经的俞穴；"}]},{"ID":"20230928082532-yzvad59","Type":"NodeParagraph","Properties":{"id":"20230928082532-yzvad59","updated":"20230928082615"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用场景：例喘咳寒热、嗝逆、上吐下泻、打嗝放屁不断，可以用合穴；"}]}]}