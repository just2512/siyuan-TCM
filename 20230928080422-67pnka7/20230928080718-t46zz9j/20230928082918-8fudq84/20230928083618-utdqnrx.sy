{"ID":"20230928083618-utdqnrx","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20230928083618-utdqnrx","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20230928083618-utdqnrx\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20230928083626-wsiulae\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20230928083738-6qrvct9\u0026quot;,\u0026quot;scrollTop\u0026quot;:400,\u0026quot;focusId\u0026quot;:\u0026quot;20230928083626-9wxsfqc\u0026quot;,\u0026quot;focusStart\u0026quot;:7,\u0026quot;focusEnd\u0026quot;:7\u0026#125;","title":"【正经】【手厥阴心包经】","type":"doc","updated":"20240912173904"},"Children":[{"ID":"20240912165422-exds3ts","Type":"NodeParagraph","Properties":{"id":"20240912165422-exds3ts","updated":"20240912173829"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"【手厥阴心包经穴位】：天池穴、天泉穴、曲泽穴、郄门穴、间使穴、内关穴、大陵穴、劳宫穴、中冲穴。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20230928083626-wsiulae","Type":"NodeParagraph","Properties":{"id":"20230928083626-wsiulae","updated":"20230928083629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心脏，是君主之官，本身不受病；心脏产生的热称之为相火，心包则将火包裹其中；"}]},{"ID":"20230928083626-dfa8rj1","Type":"NodeParagraph","Properties":{"id":"20230928083626-dfa8rj1","updated":"20230928083629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生理学上来看，心包就是心脏外包着的那层膜；"}]},{"ID":"20230928083626-uqllups","Type":"NodeParagraph","Properties":{"id":"20230928083626-uqllups","updated":"20230928083630"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心主汗，主汗液；心脏病治疗时如病人发汗，说明正常了；"}]},{"ID":"20230928083626-vn0184r","Type":"NodeParagraph","Properties":{"id":"20230928083626-vn0184r","updated":"20230928083631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心开窍在舌；"}]},{"ID":"20230928083626-tjsmg3x","Type":"NodeParagraph","Properties":{"id":"20230928083626-tjsmg3x","updated":"20230928083631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"今年夏至到今年的冬至，心包经属火；"}]},{"ID":"20230928083626-swvs2n4","Type":"NodeParagraph","Properties":{"id":"20230928083626-swvs2n4","updated":"20230928083632"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"今年的冬至到隔年的夏至，心包经属水；"}]},{"ID":"20230928083626-1bfdanx","Type":"NodeParagraph","Properties":{"id":"20230928083626-1bfdanx","updated":"20230928083633"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"所以夏至到冬至期间，木穴是心包经的母穴，土穴是心包经的子穴；"}]},{"ID":"20230928083626-rs09yij","Type":"NodeParagraph","Properties":{"id":"20230928083626-rs09yij","updated":"20230928083634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以及冬至到夏至期间，金穴是心包经的母穴，母穴是心包经的子穴；"}]},{"ID":"20230928083626-gzcfgdl","Type":"NodeParagraph","Properties":{"id":"20230928083626-gzcfgdl","updated":"20230928083635"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"井\t木\t中冲穴"}]},{"ID":"20230928083626-k2v3fgs","Type":"NodeParagraph","Properties":{"id":"20230928083626-k2v3fgs","updated":"20230928083635"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荣\t火\t劳宫穴"}]},{"ID":"20230928083626-736dewp","Type":"NodeParagraph","Properties":{"id":"20230928083626-736dewp","updated":"20230928083636"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俞\t土\t大陵穴"}]},{"ID":"20230928083626-qpra8ww","Type":"NodeParagraph","Properties":{"id":"20230928083626-qpra8ww","updated":"20230928083636"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"经\t金\t间使穴"}]},{"ID":"20230928083626-9wxsfqc","Type":"NodeParagraph","Properties":{"id":"20230928083626-9wxsfqc","updated":"20230928083830"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"合\t水\t曲泽穴"}]},{"ID":"20230928083626-n6tzexq","Type":"NodeParagraph","Properties":{"id":"20230928083626-n6tzexq","updated":"20230928083640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"郄门穴：心包经郄穴；"}]},{"ID":"20230928083626-846bd0s","Type":"NodeParagraph","Properties":{"id":"20230928083626-846bd0s","updated":"20230928083641"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内关穴管的阴维脉；"}]},{"ID":"20230928083626-egdq0ab","Type":"NodeParagraph","Properties":{"id":"20230928083626-egdq0ab","updated":"20230928083642"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内关穴，是心包经的络穴；"}]},{"ID":"20230928083730-w9oveh5","Type":"NodeParagraph","Properties":{"id":"20230928083730-w9oveh5"}},{"ID":"20230928083732-gkn3ds6","Type":"NodeParagraph","Properties":{"id":"20230928083732-gkn3ds6","updated":"20230928083732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"手厥阴心包经"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/手厥阴心包经-20230928083732-uqp287g.gif"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20230928083735-ky40odr","Type":"NodeParagraph","Properties":{"id":"20230928083735-ky40odr","updated":"20230928083735"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"手厥阴心包经1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/手厥阴心包经1-20230928083735-vt17fsk.gif"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20230928083738-6qrvct9","Type":"NodeParagraph","Properties":{"id":"20230928083738-6qrvct9","updated":"20230928083738"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"s