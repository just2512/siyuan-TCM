{"ID":"20230928084622-g64omxd","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20230928084622-g64omxd","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20230928084622-g64omxd\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20230928084635-defl9z3\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20230928084758-66su2pn\u0026quot;,\u0026quot;scrollTop\u0026quot;:4659,\u0026quot;focusId\u0026quot;:\u0026quot;20230928084758-66su2pn\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"【正经】【足太阴脾经】","type":"doc","updated":"20240912173439"},"Children":[{"ID":"20240912164936-7tpqaqk","Type":"NodeParagraph","Properties":{"id":"20240912164936-7tpqaqk","updated":"20240912173430"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"【足太阴脾经穴位】：隐白穴、大都穴、太白穴、公孙穴、商丘穴、三阴交穴、漏谷穴、地机穴、阴陵泉穴、血海穴、箕门穴、冲门穴、府舍穴、腹结，大横穴、腹哀穴、食窦穴、天溪穴、胸乡穴、周荣穴、大包穴。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20230928084635-defl9z3","Type":"NodeParagraph","Properties":{"id":"20230928084635-defl9z3","updated":"20230928084644"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主四肢，四肢的问题，都是脾在管；"}]},{"ID":"20230928084635-ds8eu56","Type":"NodeParagraph","Properties":{"id":"20230928084635-ds8eu56","updated":"20230928084644"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主肌肉；"}]},{"ID":"20230928084635-3j70vtz","Type":"NodeParagraph","Properties":{"id":"20230928084635-3j70vtz","updated":"20230928084645"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主少腹；"}]},{"ID":"20230928084635-ocefqlz","Type":"NodeParagraph","Properties":{"id":"20230928084635-ocefqlz","updated":"20230928084646"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主湿；"}]},{"ID":"20230928084635-3c0kt4o","Type":"NodeParagraph","Properties":{"id":"20230928084635-3c0kt4o","updated":"20230928084646"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾，是谏议之官；意思是谏言上诉争议；"}]},{"ID":"20230928084635-is58x9m","Type":"NodeParagraph","Properties":{"id":"20230928084635-is58x9m","updated":"20230928084647"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主甘，甜味；"}]},{"ID":"20230928084635-ehnb272","Type":"NodeParagraph","Properties":{"id":"20230928084635-ehnb272","updated":"20230928084648"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主黄色；"}]},{"ID":"20230928084635-dd2ufgt","Type":"NodeParagraph","Properties":{"id":"20230928084635-dd2ufgt","updated":"20230928084649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾之音是‘宫’（宫商角徵羽）；宫的声就是呼吸的‘呼’音；（方法：手挨着脾脏的地方如左肋，两手按住，呼气的时候，脾开窍在唇，所以把嘴唇呼成圆形，呼到没气了，把肛门提起来，用身体的内力把所有的气都呼出来）"}]},{"ID":"20230928084635-n1niwy3","Type":"NodeParagraph","Properties":{"id":"20230928084635-n1niwy3","updated":"20230928084651"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾在声为哕（哕：打嗝）；"}]},{"ID":"20230928084635-xb5ho7b","Type":"NodeParagraph","Properties":{"id":"20230928084635-xb5ho7b","updated":"20230928084650"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾主味，胃口或味觉，是脾脏在管；"}]},{"ID":"20230928084635-6xm8o35","Type":"NodeParagraph","Properties":{"id":"20230928084635-6xm8o35","updated":"20230928084651"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思伤脾；如思念过度，吃东西如同嚼蜡，感觉不到味道；"}]},{"ID":"20230928084706-pgnunq1","Type":"NodeParagraph","Properties":{"id":"20230928084706-pgnunq1"}},{"ID":"20230928084635-5cc3smp","Type":"NodeParagraph","Properties":{"id":"20230928084635-5cc3smp","updated":"20230928084652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中医认为，脾胃为后天之本，肾脏为先天之本；"}]},{"ID":"20230928084703-oh6sqm3","Type":"NodeParagraph","Properties":{"id":"20230928084703-oh6sqm3"}},{"ID":"20230928084635-o9ntweu","Type":"NodeParagraph","Properties":{"id":"20230928084635-o9ntweu","updated":"20230928084710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"井\t木\t隐白穴"}]},{"ID":"20230928084635-bhtfpqz","Type":"NodeParagraph","Properties":{"id":"20230928084635-bhtfpqz","updated":"20230928084711"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荣\t火\t大都穴\t\t母穴；适于虚症，强脾"}]},{"ID":"20230928084635-91ttykb","Type":"NodeParagraph","Properties":{"id":"20230928084635-91ttykb","updated":"20230928084711"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俞\t土\t太白穴\t\t同属性，可补可泄"}]},{"ID":"20230928084635-h4qyu5f","Type":"NodeParagraph","Properties":{"id":"20230928084635-h4qyu5f","updated":"20230928084712"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"经\t金\t商丘穴\t\t子穴；能助孕"}]},{"ID":"20230928084635-utxojre","Type":"NodeParagraph","Properties":{"id":"20230928084635-utxojre","updated":"20230928084713"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"合\t水\t阴陵泉"}]},{"ID":"20230928084716-qa7huor","Type":"NodeParagraph","Properties":{"id":"20230928084716-qa7huor"}},{"ID":"20230928084635-pbhzu02","Type":"NodeParagraph","Properties":{"id":"20230928084635-pbhzu02","updated":"20230928084720"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脾经络穴：漏谷穴；"}]},{"ID":"20230928084635-vgs7c6g","Type":"NodeParagraph","Properties":{"id":"20230928084635-vgs7c6g","updated":"20230928084721"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"郄穴：地机穴；（消炎镇痛）"}]},{"ID":"20230928084635-s61ekui","Type":"NodeParagraph","Properties":{"id":"20230928084635-s61ekui","updated":"20230928084722"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"阴陵泉：脾经的合穴"}]},{"ID":"20230928084635-2woy5it","Type":"NodeParagraph","Properties":{"id":"20230928084635-2woy5it","updated":"20230928084723"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"血海穴：妇科名穴；月经来过多或不来皆可对治；血海里有筋，所以扎浅针（一寸左右）；"}]},{"ID":"20230928084725-d5xbtsi","Type":"NodeParagraph","Properties":{"id":"20230928084725-d5xbtsi"}},{"ID":"20230928084635-05kzvi9","Type":"NodeParagraph","Properties":{"id":"20230928084635-05kzvi9","updated":"20230928084727"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"冲门穴与云门穴相对（对称治疗）；"}]},{"ID":"20230928084728-cz7wcyb","Type":"NodeParagraph","Properties":{"id":"20230928084728-cz7wcyb"}},{"ID":"20230928084635-aeu1f8i","Type":"NodeParagraph","Properties":{"id":"20230928084635-aeu1f8i","updated":"20230928084730"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"公孙穴：脾经络穴；实则肠中切痛，泻之，虚则鼓胀，补之；"}]},{"ID":"20230928084635-0u9whh9","Type":"NodeParagraph","Properties":{"id":"20230928084635-0u9whh9","updated":"20230928084730"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大包穴，脾之大络；全身的络都归大包穴管；虚证实证皆可治；"}]},{"ID":"20230928084635-k133ghz","Type":"NodeParagraph","Properties":{"id":"20230928084635-k133ghz","updated":"20230928084731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"象征性来说，脾脏就像是一个水坝，水坝需要供水到各个地方种田，其中供水的管道就叫做大包穴；所以脾脏之所以能够管五个脏，是因为有大包穴；"}]},{"ID":"20230928084635-85hsshe","Type":"NodeParagraph","Properties":{"id":"20230928084635-85hsshe","updated":"20230928084732"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"病例：如黄疸；黄疸就是肝胆的问题，肝胆为木，木克土，土为脾胃；脾的消化能力变差，导致脾脏输送给脾营养能量无法吸收，就发出来，人的脸就会发黄；同理，脸黑的就是肾脏病；"}]},{"ID":"20230928084733-l2w5zh0","Type":"NodeParagraph","Properties":{"id":"20230928084733-l2w5zh0"}},{"ID":"20230928084733-w9xxgm2","Type":"NodeParagraph","Properties":{"id":"20230928084733-w9xxgm2"}},{"ID":"20230928084749-a8x6cmq","Type":"NodeParagraph","Properties":{"id":"20230928084749-a8x6cmq","updated":"20230928084749"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"足太阴脾经"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/足太阴脾经-20230928084749-ulk95hl.gif"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20230928084753-dae3tcc","Type":"NodeParagraph","Properties":{"id":"20230928084753-dae3tcc","updated":"20230928084753"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"足太阴脾经1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/足太阴脾经1-20230928084753-ti80tb6.gif"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20230928084758-66su2pn","Type":"NodeParagraph","Properties":{"id":"20230928084758-66su2pn","updated":"20230928084758"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"足太阴脾经2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/足太阴脾经2-20230928084758-y0mec92.gif"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240912173438-3s8sot3","Type":"NodeThematicBreak","Properties":{"id":"20240912173438-3s8sot3"}},{"ID":"20240912173439-8br0jj1","Type":"NodeParagraph","Properties":{"id":"20240912173439-8br0jj1"}}]}