{"ID":"20231025155350-twh31oz","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","icon":"2b50","id":"20231025155350-twh31oz","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20231025155350-twh31oz\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20231025155350-593w9iz\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20231025160546-lujesew\u0026quot;,\u0026quot;scrollTop\u0026quot;:400,\u0026quot;focusId\u0026quot;:\u0026quot;20231025155350-593w9iz\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"节气","type":"doc","updated":"20231025160546"},"Children":[{"ID":"20231025155350-593w9iz","Type":"NodeParagraph","Properties":{"id":"20231025155350-593w9iz","updated":"20231025155412"}},{"ID":"20231025155413-b85s7r5","Type":"NodeParagraph","Properties":{"id":"20231025155413-b85s7r5","updated":"20231025160159"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"粗分一年有四季："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"}]},{"ID":"20231025155956-al43wp2","Type":"NodeParagraph","Properties":{"id":"20231025155956-al43wp2","updated":"20231025160006"},"Children":[{"Type":"NodeText","Data":"春季、夏季、秋季、冬季"}]},{"ID":"20231025155423-d5teahn","Type":"NodeParagraph","Properties":{"id":"20231025155423-d5teahn"}},{"ID":"20231025155423-lir3b8t","Type":"NodeParagraph","Properties":{"id":"20231025155423-lir3b8t","updated":"20231025160204"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"细分五季："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"},{"Type":"NodeText","Data":"春季、夏季、秋季、冬季、长夏季"}]},{"ID":"20231025155458-ga0ionu","Type":"NodeParagraph","Properties":{"id":"20231025155458-ga0ionu"}},{"ID":"20231025155458-h2ntii7","Type":"NodeParagraph","Properties":{"id":"20231025155458-h2ntii7","updated":"20231025160212"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"再细分一年十二月："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"}]},{"ID":"20231025155848-f9uk78a","Type":"NodeParagraph","Properties":{"id":"20231025155848-f9uk78a","updated":"20231025160011"},"Children":[{"Type":"NodeText","Data":"一月：正月、柳月、端月、初月、嘉月、新月、开岁、陬月。"}]},{"ID":"20231025155851-qnwxd9f","Type":"NodeParagraph","Properties":{"id":"20231025155851-qnwxd9f","updated":"20231025160015"},"Children":[{"Type":"NodeText","Data":"二月：杏月、仲春、仲阳、如月、丽月、花月、仲月、酣月。"}]},{"ID":"20231025155854-jtwx5o3","Type":"NodeParagraph","Properties":{"id":"20231025155854-jtwx5o3","updated":"20231025160024"},"Children":[{"Type":"NodeText","Data":"三月：桃月、春晚、晚春、暮春、蚕月、上春、春日、绸月、季月、莺月、末春。"}]},{"ID":"20231025155856-5nhvnow","Type":"NodeParagraph","Properties":{"id":"20231025155856-5nhvnow","updated":"20231025160031"},"Children":[{"Type":"NodeText","Data":"四月：槐月、孟夏、首夏、初夏、阳月麦月梅月纯月清和余月。"}]},{"ID":"20231025155900-suea2ck","Type":"NodeParagraph","Properties":{"id":"20231025155900-suea2ck","updated":"20231025160043"},"Children":[{"Type":"NodeText","Data":"五月：蒲月、仲夏、超夏、榴月、郁月、呜蜩、天中、仲夏、皋月。"}]},{"ID":"20231025155904-1khhgda","Type":"NodeParagraph","Properties":{"id":"20231025155904-1khhgda","updated":"20231025160046"},"Children":[{"Type":"NodeText","Data":"六月：荷月、季月、伏月、焦月、署月、精阳、溽暑、季暑、且月。"}]},{"ID":"20231025155906-wo2lfg1","Type":"NodeParagraph","Properties":{"id":"20231025155906-wo2lfg1","updated":"20231025160050"},"Children":[{"Type":"NodeText","Data":"七月：巧月、瓜月、兰月、兰秋、肇秋、新秋、首秋、相月、孟秋、初秋。"}]},{"ID":"20231025155911-vlo8i8l","Type":"NodeParagraph","Properties":{"id":"20231025155911-vlo8i8l","updated":"20231025160053"},"Children":[{"Type":"NodeText","Data":"八月：桂月、壮月、仲秋、中秋、仲商、桂秋、正秋、商吕、竹春。"}]},{"ID":"20231025155913-xsou0i6","Type":"NodeParagraph","Properties":{"id":"20231025155913-xsou0i6","updated":"20231025160058"},"Children":[{"Type":"NodeText","Data":"九月：深秋、暮秋、穷秋、凉秋、霜商、商序、菊月、季秋、晚秋、杪秋、三秋、暮商、霜序、朽月、玄月、青女月、三孟秋。"}]},{"ID":"20231025155916-oa3mjtt","Type":"NodeParagraph","Properties":{"id":"20231025155916-oa3mjtt","updated":"20231025160104"},"Children":[{"Type":"NodeText","Data":"十月：阳月、阴月、小阳春、孟冬、初冬、上冬、良月、露月、开冬、冬、飞阴月。"}]},{"ID":"20231025155918-q9eq80x","Type":"NodeParagraph","Properties":{"id":"20231025155918-q9eq80x","updated":"20231025160107"},"Children":[{"Type":"NodeText","Data":"十一月：辜月、冬月、仲冬、中冬、畅月、葭月、龙潜月。"}]},{"ID":"20231025155922-9mvfgnq","Type":"NodeParagraph","Properties":{"id":"20231025155922-9mvfgnq","updated":"20231025160113"},"Children":[{"Type":"NodeText","Data":"十二月：腊月、季冬、严冬、残冬、冰月、严月、除月、季冬、残冬、末冬、嘉平、穷节、星回节。"}]},{"ID":"20231025155748-30a5li1","Type":"NodeParagraph","Properties":{"id":"20231025155748-30a5li1"}},{"ID":"20231025160116-bu3htt4","Type":"NodeParagraph","Properties":{"id":"20231025160116-bu3htt4","updated":"20231025160300"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"再细分一年24节气："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"}]},{"ID":"20231025160222-u72ayd3","Type":"NodeParagraph","Properties":{"id":"20231025160222-u72ayd3","updated":"20231025160457"},"Children":[{"Type":"NodeText","Data":"立春、雨水、惊蛰、春分、清明、谷雨、立夏、小满 、芒种、夏至、小暑、大暑、立秋、处暑、白露、秋分、寒露、霜降、立冬、小雪、大雪、冬至、小寒、大寒"}]},{"ID":"20231025160534-4t7kmyj","Type":"NodeParagraph","Properties":{"id":"20231025160534-4t7kmyj","updated":"20231025160534"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20231025160534-pp56n0r.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20231025160342-2rdtp1o","Type":"NodeParagraph","Properties":{"id":"20231025160342-2rdtp1o","updated":"20231025160342"},"Children":[{"Type":"NodeText","Data":"《二十四节气歌》春雨惊春清谷天，夏满芒夏暑相连。秋处露秋寒霜降，冬雪雪冬小大寒。每月两节不变更，最多相差一两天。上半年来六廿一，下半年是八廿三。"}]},{"ID":"20231025160545-s6td688","Type":"NodeParagraph","Properties":{"id":"20231025160545-s6td688"}},{"ID":"20231025160546-lujesew","Type":"NodeParagraph","Properties":{"id":"20231025160546-lujesew"}}]}