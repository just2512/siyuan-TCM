ata":"1. 睡好許多,且較長"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 小腹肝經痛很少了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 睡前頭暈感覺較明顯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便泡沫仍多,色淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 雙耳鳴仍有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 大便很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 體力尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 雙足稍冷"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈弦洪"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白黃,紅較多在旁邊,有一點濕熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"瞳孔反應慢,肝區圈紋,白點,混濁"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"腎陽不足 肝區積肥氣"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 同 4/9.加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"茜草三錢 紫根三錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→少腹瘀血痛"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子三錢 白朮三錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→合前方藥為真武湯治睡前頭暈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"敗龜板三錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→入腎 益陰滋血 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12碗煮4碗 Bf B/S"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. HT-99斑龍丸補腎精 6兩 30x2 Bf L/Bed"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"治肝必瀉南補北及實脾 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"肝臟好者睡眠品質會好 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"使他腎臟功能恢復後就不會暈了 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4."},{"Type":"NodeText","Data":"補此人之腎要陰陽雙補"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeText","Data":"10天後再來"}]}]}]}]}