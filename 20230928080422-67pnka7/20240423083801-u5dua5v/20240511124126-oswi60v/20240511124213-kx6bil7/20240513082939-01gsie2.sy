ata":"br"},{"Type":"NodeText","Data":"3. 右腳膝蓋外側有小硬塊"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 大便秘，腹中有氣(近幾日才有)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 小便有未盡出感"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 睡眠:品質好，但只睡4-5個小時"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 雙足冷，身體溫度沒特別感覺。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 口渴：無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 胃口：平平"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 月經正常"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈數"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"肺區有痰濕，及肝區有些褐點"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"腎陽不足， 宜補金瀉木"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":"膏肓放血"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1．小承氣湯 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"便秘且腹中有氣，典型的小承氣湯證"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"100 caps 8x2 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"中餐及睡前每次 8粒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2．"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡3錢，玉金5錢 黃芩3錢 龍膽草3錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"瀉木→清肝 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麥冬3錢， 淮山3錢， 杏仁3錢，半夏3錢，南星3錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"補金→清肺之積痰並滋肺陰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"烏藥5錢，細辛2錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"溫腎散寒， 治療小便未盡出感 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白朮3錢，茯苓5錢，澤瀉5錢。"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"利水，滲濕，泄熱 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9→3 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一次"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"長期性的腳水腫跟心腎有關係，偶發性的水腫與肺金生水的過程中發生問題有關，影响到肾功能，故小便有不尽感"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"---需用"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"瀉木補金"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"方法治療以恢复肾功 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"右膝的硬塊應是鈣化的結晶， 只要不繼續長大，可不加理會， 也可以試著用龍骨牡蠣來軟堅"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"女人腳腫並不會要人命，若是男人腳腫命在旦夕，若不治療最長期限為兩星期即有生命危險"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]}]}]}