g","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":" 1. 左邊臉麻與去年十月相同，月經來前明顯，月經來後較好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便一天一次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 自覺身熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 精神好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 月經來前兩天全身痛，左半身會變的比較麻，月經過後減輕"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"雙脈弦細小，重按附骨且有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：氣色很好\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"瞳孔反應很好"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→查腎，因腦與腎相通"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷：第五椎仍有壓痛，但比去年輕"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 病情緩下(腫瘤沒變大就是好事，跟腫瘤和平共存身體無不適就好)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n1."},{"Type":"NodeText","Data":"噴鼻粉五罐  一日一次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"同 2007年10月1日方加黃耆五錢   鉤陳四錢   瓦楞子五錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"20帖  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9→3 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各喝一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"HT-2 退奶丸  30X2 月經來前一周及月經來的期間，早晚飯後服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說： \n1."},{"Type":"NodeText","Data":"左主血，右主氣，血不行是因氣不行，故加黃耆 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"瓦楞子鹹能軟堅 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":" 治腦瘤常用麝香礬石散噴鼻，因腦與鼻相通，此散噴鼻可以把腦部積水排出"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" \n4."},{"Type":"NodeText","Data":"月經來前正常人奶水聚集在胸部，但她心臟不好，不能把奶水集中於胸部往下導，故有些奶水逆流至腦部支援腦瘤，故他左半身麻"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeText","Data":"囑不可吃高麗參、西洋参、乳製品、女性荷爾蒙。"}]}]}]}]}