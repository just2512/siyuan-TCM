{"ID":"20240513082941-o884tmn","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513082941-o884tmn","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513082941-o884tmn\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513180150-0zqiaww\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513180150-0zqiaww\u0026quot;,\u0026quot;scrollTop\u0026quot;:28\u0026#125;","title":"351","type":"doc","updated":"20240515114848"},"Children":[{"ID":"20240513180150-0zqiaww","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 918px;","id":"20240513180150-0zqiaww","updated":"20240515114848"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/03/06"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"244-2 W, S"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"中年，超重"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/03/20"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"攝護腺癌做過化療。三月六日初診後，服湯藥兩周，自覺體力好轉，複診。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"仍不好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、大便："},{"Type":"NodeText","Data":"好轉，仍時秘。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、"},{"Type":"NodeText","Data":"人仍覺乾"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"。\n4、"},{"Type":"NodeText","Data":"雙足仍麻，踝，膝等皆很痛。"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→原因有二：一為此人過胖，二為心臟弱。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、胃口："},{"Type":"NodeText","Data":"好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、"},{"Type":"NodeText","Data":"服上方後有無舌麻(上方含有生附)：沒有舌麻"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"左脈小細無力"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→血虛；右脈較大有力。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡黃，中間濕，有裂紋，兩邊亁"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeText","Data":"手掌皮乾脫落"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→攝護腺癌患者常有此症狀"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"進步許多，胃氣好轉。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n今日加重桂枝與白芍的劑量"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生附子三錢（另包）  乾薑二錢  炙甘草三錢，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"陳皮三錢  桂枝五錢  白芍一兩，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連二錢  黃芩三錢  阿膠三錢（分三包，烊盡）"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→黃連阿膠湯治療睡不好"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麥冬五錢  知母五錢  當歸三錢  熟地三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補津液"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牛膝三錢補骨脂三錢澤瀉五錢  茯苓五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→減少腎臟負擔，利尿，減輕下半身痛"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服時加麥芽糖一匙，生蛋黃一枚沖入。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":" 手掌皮乾脫落，攝護腺癌患者常有此症狀，師曰若治到此人手掌皮膚濕潤則代表病好了。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}