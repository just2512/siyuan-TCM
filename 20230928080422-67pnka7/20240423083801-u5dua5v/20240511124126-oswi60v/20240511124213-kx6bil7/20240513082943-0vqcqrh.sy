{"ID":"20240513082943-0vqcqrh","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513082943-0vqcqrh","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513082943-0vqcqrh\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513180012-5kepj34\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513180012-5kepj34\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240513180012-5kepj34\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:247\u0026#125;","title":"348","type":"doc","updated":"20240515124811"},"Children":[{"ID":"20240513180012-5kepj34","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 862px;","id":"20240513180012-5kepj34","updated":"20240515124811"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄   初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"243-2 W, P"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"54歲，瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080501"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乳癌移轉肺癌、骨癌"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服甘遂半夏膠囊6粒後，大便排4-6次水出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右肋仍有些痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 睡不好，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不易入眠"},{"Type":"NodeText","Data":"，AM2:30，4:30時醒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 胃口尚好，想增加體重，因去年體重少了十磅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡時全身都溫熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 不易汗出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 可平躺睡，可右側躺"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 右腎區骨痛減少"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 雙側後肋(肺下)仍有痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 仍有咳嗽多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11. 呼吸不舒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12. 感冒: 喉痛、畏寒"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"浮"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃白乾，萎縮"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"心陽反逆不入陰"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→治心要治肺"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桔梗一兩  炙甘草一兩(欲強心故重用)"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→桔梗甘草湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"射干三錢  紫苑三錢  冬花二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→射干麻黃湯加減；去麻黃，因不易入眠"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連二錢  黃芩三錢  白芍五錢  阿膠三錢(分三包烊盡)"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→黃連阿膠湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→強心，欲令其汗"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生薑二片  大棗十枚牡蠣五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→鹹能軟堅"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生硫磺三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→因全身溫熱，為陰實進入全身三焦淋巴，故用生硫磺入三焦攻陰實。 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"400粒膠囊  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三餐飯錢各8顆"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}