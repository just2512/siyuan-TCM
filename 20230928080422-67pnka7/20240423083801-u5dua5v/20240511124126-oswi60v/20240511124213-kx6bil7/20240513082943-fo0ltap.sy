{"ID":"20240513082943-fo0ltap","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513082943-fo0ltap","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513082943-fo0ltap\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513175856-83y9rrn\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513175925-ysk7buz\u0026quot;,\u0026quot;scrollTop\u0026quot;:598,\u0026quot;focusId\u0026quot;:\u0026quot;20240513175925-ysk7buz\u0026quot;,\u0026quot;focusStart\u0026quot;:730,\u0026quot;focusEnd\u0026quot;:730\u0026#125;","title":"347","type":"doc","updated":"20240515114925"},"Children":[{"ID":"20240513175856-83y9rrn","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 719px;","id":"20240513175856-83y9rrn","updated":"20240515112602"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄    初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"243-1 W, P"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"54歲，瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080121(Dr.Wang)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"乳癌移轉肺及骨癌西醫檢查右邊骨仍有癌，減少了，仍有痛"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 大便每日"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 睡AM3:30~4:30醒來"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 每天咳，呼吸尚可，有時不暢，吸入較不佳"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 四肢仍冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 精神好，痛時須平躺，仍吃西藥止痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 有時夜汗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"右弦速，左弦細速"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃濕"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方:"},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左行間、公孫、大鐘、照海、太谿"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 柴胡三錢  玉金六錢  半夏三錢  黃芩三錢  炒麥芽三錢  炮附子四錢    乾薑二錢  炙甘草三錢  黃連三錢  黃柏三錢  白朮三錢  茯苓四錢  牡蠣一兩  陽起石三錢  杏仁三錢  厚朴三錢  杜仲三錢  補骨脂三錢  當歸三錢  川芎三錢  熟地三錢  白芍三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十二碗煮四碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 金鈴子1  延胡索1 200粒  午餐及飯前各8顆"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]},{"ID":"20240513175925-e9vjxaw","Type":"NodeParagraph","Properties":{"id":"20240513175925-e9vjxaw"}},{"ID":"20240513175925-ysk7buz","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 914px;","id":"20240513175925-ysk7buz","updated":"20240515114925"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄   初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"Weaver Patricia"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"54歲，瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080411"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乳癌移轉肺癌、骨癌"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 癌指數又上升了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 右肋下方有出過帶狀皰疹"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 右肺積水(曾作過引流)仍有咳嗽"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 甲狀腺功能很低"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 血糖很低"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 左眼之前紅且淚多六週"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 可平躺睡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便好，一日二三次，成形"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便中黃到淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 身熱尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 睡在AM2:30醒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 體力還好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 右肋間痛，下午後背痛(無服止痛藥)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11. 夜間背後盜汗(骨癌處)"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→陽不入陰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"弦數有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃濕，舌根處苔中空"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"仍是柴胡證，右肋右肺下方有積水"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 海藻丸"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→for 甲狀腺  400粒  早晚飯後各8顆"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 柴胡3  玉金5  半夏3  黃芩3  金鈴子2  延胡索2  炮附子4  乾薑2  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連2  炙鱉甲3  茜草3  白芍4  龍骨3  牡蠣5  當歸2  川芎2"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"400粒 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三餐飯前各8顆"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 甘遂1(去肺中水)  生半夏1(肺為最高之臟，故用生半夏去水)  大棗2(補腸胃津液)  生薑1(解半夏毒)"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→此為甘遂半夏湯(去肋間積水)與十棗湯(去肺積水)之折衷方；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"去甘遂半夏湯中酸收之白芍，蓄水之炙甘草；欲使積水由大便出，而非取吐法。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"40 粒  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早餐前服4粒"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→服三天後，若右脅下仍脹滿、大便沒變軟，表積水  未出，仍有肺積水，則改飯後服。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 此病人的盲點在於，作過放射治療，故無法確知肺損傷程度如何，故使用甘遂半夏湯與十棗湯之折衷方。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4/15病人來電：服藥後欲嘔但沒吐，一點拉稀，右脅肋仍痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"倪師令其：續服甘遂半夏大棗生薑膠囊，改早餐飯前服6顆。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}