ta":"膝五針 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左陽池（三焦經，治腕痛），天井（三焦經，治手肘痛） "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右：俠溪（膽經母穴），解溪（胃經母穴）（治左足三小趾麻） "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右∶肝關（經外奇穴，解左肋下痛）"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃芪五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→行氣，治表虛"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝三錢  白芍三錢 生薑二片 大棗十枚 炙甘草三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→桂枝湯方"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白朮三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→收濕  "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去寒  "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"防風五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去風"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"師曰：白朮、炮附子、桂枝、炙甘草為甘草附子湯治療