{"ID":"20240513082949-9vabi7i","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513082949-9vabi7i","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513082949-9vabi7i\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513175405-1ee8ktm\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513175405-1ee8ktm\u0026quot;,\u0026quot;scrollTop\u0026quot;:545,\u0026quot;focusId\u0026quot;:\u0026quot;20240513175405-1ee8ktm\u0026quot;,\u0026quot;focusStart\u0026quot;:462,\u0026quot;focusEnd\u0026quot;:462\u0026#125;","title":"337","type":"doc","updated":"20240515115011"},"Children":[{"ID":"20240513175405-1ee8ktm","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 874px;","id":"20240513175405-1ee8ktm","updated":"20240515115011"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"237-6 S, N"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"62歲，偏瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"05/08/2008"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"仍有兩碗湯藥未服, 可能因未加生蛋黃服用, 故不易入眠. 其它都好."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 無法入睡 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"心藏神, 從心臟下手"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") 很累"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 胸口有一點拉扯痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 雙足稍冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 大便稀, 但很好, 褐色."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 口渴有, 溫飲或熱飲("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"胃寒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 吃食無問題, 但不覺很餓."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 小便不易出, 且斷續才排完. 小便無痛."},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"洪大有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃厚濕("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"因胃的容量減少百分之七十, 故多餘胃氣反逆"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"心區扁平、淡白(陰陽兩虛)；胰區很小"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心陰陽兩虛"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"病人脈大舌黃 仍為黃蓮阿膠湯症: "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃蓮二錢 黃芩三錢 白芍五錢 阿膠三錢(分三包 烊盡) "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麥冬三錢 西洋蔘三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→治心須先潤肺"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"吳茱萸二錢 乾薑二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→胃寒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"車前子三錢 豬苓三錢 茯苓三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→利尿"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"巴戟天三錢 補骨脂三錢 細辛二錢 炮附子三錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→下焦寒(大便稀，足冷)須熱其下焦,，得氣化，則小便出 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉五錢 白朮三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去濕"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服時加生蛋黃一只 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮成三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}