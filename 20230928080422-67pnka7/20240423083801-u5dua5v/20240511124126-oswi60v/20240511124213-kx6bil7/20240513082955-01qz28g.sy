extMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"睡不好。最多連睡三小時，多數只能連睡二小時。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、胃口："},{"Type":"NodeText","Data":"好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、大便："},{"Type":"NodeText","Data":"一天二次、鬆軟稀、褐色。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、小便："},{"Type":"NodeText","Data":"淡清。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、口渴："},{"Type":"NodeText","Data":"尚好。喜溫飲。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、手足溫度："},{"Type":"NodeText","Data":"雙足仍冷但無麻了。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7、掌額溫度："},{"Type":"NodeText","Data":"手冷額熱。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"8、"},{"Type":"NodeText","Data":"多數時候身溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"9、"},{"Type":"NodeText","Data":"你有覺得心跳快嗎？答：沒有"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"一息六到七至，中空(芤脈"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→血虛"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")。(虛熱)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診："},{"Type":"NodeText","Data":"心區扁平。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"黃亁"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"上焦燥熱、心血不足。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連二錢 黃芩三錢 白芍五錢 阿膠三錢(分三包) 桂枝三錢 炙甘草三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"七付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"六碗水煮二碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前 每次加一生蛋黃"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"此人睡不好是因為血虛，心中一滴血沒了。此人的脈數是虛熱，血虛而熱。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}