{"ID":"20240513083002-dz02y6r","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083002-dz02y6r","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083002-dz02y6r\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513174459-t052bmq\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513174459-t052bmq\u0026quot;,\u0026quot;scrollTop\u0026quot;:500,\u0026quot;focusId\u0026quot;:\u0026quot;20240513174459-t052bmq\u0026quot;,\u0026quot;focusStart\u0026quot;:492,\u0026quot;focusEnd\u0026quot;:492\u0026#125;","title":"322","type":"doc","updated":"20240515115151"},"Children":[{"ID":"20240513174459-t052bmq","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 851px;","id":"20240513174459-t052bmq","updated":"20240515115151"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄   初診日期：05/27/2008"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"232 R, LK"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"40歲，中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"2008/05/27"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. B型肝炎帶原"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 五月份以來因航空公司工作壓力大，十天前發生小便深黃、之後嘔吐，經西醫查出肝指數很高"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 易疲勞、起風疹"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 餓感沒了，味覺淡了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 口苦，口中味重"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 打嗝"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 易累、身倦"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 失眠，睡三小時即醒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 小便現為淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 便秘，每日有但不易出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 體內無寒熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 雙足有時會冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11. 手涼額熱"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"弦數無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"瞳孔過大"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→病在腎，過勞傷腎，水反客土，土又反克木"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"腎陽虛，水反侮到土，再到木"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 補骨脂三錢  澤瀉五錢  巴戟天三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乾薑二錢  吳茱萸三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→胃寒打嗝"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏四錢  柴胡三錢  黃芩三錢  龍膽草三錢  鬱金五錢  大黃二錢  白芍六錢  茜草三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→大柴胡湯加減，加強疏肝"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"梔子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去虛熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"酸棗仁三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→酸收入肝"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"茵陳三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去黃"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白朮三錢  茯苓五錢  陳皮三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→健脾去溼開胃"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝三錢  炙甘草二錢  大棗十枚"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→合白芍六錢為小建中湯 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗  服時加一匙麥芽糖"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. HT-99斑龍丸(6兩)  睡前30顆(服完湯藥後，無嘔噁、胃口好再開始服滋補藥)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}