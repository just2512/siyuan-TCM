{"ID":"20240513083004-i8l6pqz","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083004-i8l6pqz","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083004-i8l6pqz\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513174251-jvlxpu5\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513174251-jvlxpu5\u0026quot;,\u0026quot;scrollTop\u0026quot;:11,\u0026quot;focusId\u0026quot;:\u0026quot;20240513174251-jvlxpu5\u0026quot;,\u0026quot;focusStart\u0026quot;:368,\u0026quot;focusEnd\u0026quot;:368\u0026#125;","title":"318","type":"doc","updated":"20240515124840"},"Children":[{"ID":"20240513174251-jvlxpu5","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 741px;","id":"20240513174251-jvlxpu5","updated":"20240515124840"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":"    初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"230-1 P, K"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"老年，胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080512"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"攝護腺癌偶然輕微頭痛.時倦怠.右膝無力.左手前三指麻.吹風會流淚."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、大便："},{"Type":"NodeText","Data":"每日2,3次。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、手足溫度："},{"Type":"NodeText","Data":"雙足溫許多；手不冷了，掌膚仍乾(攝護腺癌未癒)，指麻減少。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、體力："},{"Type":"NodeText","Data":"不好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、頭身："},{"Type":"NodeText","Data":"頭不痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、其他："},{"Type":"NodeText","Data":"血壓 120/70, 149/69"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診："},{"Type":"NodeText","Data":"腎陽反應差，心區扁平"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左：頭臨泣,睛明,合谷."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右：太淵,曲池,大凌,頭臨泣,睛明,合谷."},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同5/6方加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子四錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→ 補腎陽，令下焦熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"瓜蔞實三錢 薤白三錢 枳實三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→心臟結構好即能固住心陽，故以此法強心陽。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(1) 瓜蔞薤白枳實湯方為治心臟病第一藥方"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(2) 此人左手肺大腸心包三經痛,針右側對稱治療."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(3) 吹風會流淚必針頭臨泣,效果佳."},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}