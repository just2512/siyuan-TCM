{"ID":"20240513083006-7mo0kn2","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083006-7mo0kn2","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083006-7mo0kn2\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513174023-owztuq9\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513174023-owztuq9\u0026quot;,\u0026quot;scrollTop\u0026quot;:19,\u0026quot;focusId\u0026quot;:\u0026quot;20240513174023-owztuq9\u0026quot;,\u0026quot;focusStart\u0026quot;:419,\u0026quot;focusEnd\u0026quot;:419\u0026#125;","title":"314","type":"doc","updated":"20240515124913"},"Children":[{"ID":"20240513174023-owztuq9","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 782px;","id":"20240513174023-owztuq9","updated":"20240515124913"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"227-2 P, D"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"F"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"75歲"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"2008/05/27"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"左側乳癌第四期移轉肺癌、骨癌。(未經西醫動手)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 睡原本很好，但上週有胸痛，痛在深處且到處遊走，時右時左、由前痛至後"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→紫參甘草湯 且腦筋停不下來，故睡不太好"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 右眼一直流淚"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 口渴無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 可平躺睡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 雙足溫正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"易出汗了"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→心臟功能恢復"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"晚上睡時全身時冷時熱"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→若陰實已成上身燥熱會加重"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 有盜汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11. 雙手指關節變形"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→類風溼性關節炎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12. 體力很好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：1、舌診："},{"Type":"NodeText","Data":"淡黃乾"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"病人進步中"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. HT-100歷節丸  (6兩)  午餐睡前各30顆"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 同9/7方，加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"陽起石三錢、黃耆五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→升陽、行氣→女人胸為陽，腹為陰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"益智仁五錢、補骨脂三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→針對其記憶不好而下"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢  續斷三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→入少陽三焦，治折跌傷科(撞到右乳)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"紫參四錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→肺痛 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"15付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十二碗煮四碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]}]}]}