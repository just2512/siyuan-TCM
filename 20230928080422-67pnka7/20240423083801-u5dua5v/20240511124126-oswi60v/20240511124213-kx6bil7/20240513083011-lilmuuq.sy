":"strong","TextMarkTextContent":"其他"},{"Type":"NodeText","Data":" : 頸項很緊,無法轉動,自覺食道較開,且鬆些。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"浮數無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"病在上,取吐法,裡寒重仍有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"藜蘆 一錢半 (吐法,有毒)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生甘草 四錢 (解藜蘆毒)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"梔子 三錢 半夏 三錢 炮附子 四錢 (利膈湯,鬆喉部)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"細辛 二錢 大黃 三錢 絡石藤 五錢 絡石藤可開喉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"陳皮 三錢 厚樸 三錢 澤瀉 四錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乾薑 二錢 (防止入肺)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蠣 一兩 (鹹能軟堅)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"防己 五錢 (入三焦系統)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"南星 三錢 蘇葉 三錢 夏枯草 五錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9→3碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早餐前及晚餐前各一