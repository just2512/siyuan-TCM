kType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠："},{"Type":"NodeText","Data":"晚上咳多, 出黃痰, 濁而不黏, 故無法睡好; 可平躺睡。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"好, 有餓; 味覺喪失一些; 有嚥下困難, 脖子有變大一些。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"每日三行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雙足溫度："},{"Type":"NodeText","Data":"雙足冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌額溫度："},{"Type":"NodeText","Data":"掌溫額溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問汗 :"},{"Type":"NodeText","Data":" 有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體力:"},{"Type":"NodeText","Data":" 好轉, 但欲寐。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"頭身："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他 :"},{"Type":"NodeText","Data":"無痛, 但頸很緊, 很難轉動。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"寸關脈小, 重按無, 尺脈過大且數, 陰盛於陽 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→金匱說寸上寸為喉病, 此病人未見寸上寸脈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"有紅點, , 舌紅無苔"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 腎氣受阻於喉"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：\n千金葦莖湯、半夏厚朴湯"},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"葦莖 五錢  丹皮 三錢  桃仁 三錢  冬瓜仁 三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"絡石藤 五錢  生附子 三錢 (另包)  南星 三錢      "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蠣 五錢半夏 三錢  梔子 三錢  陳皮 三錢  厚朴 三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"蘇葉 三錢  澤瀉 四錢  乾薑 二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9 "},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"3 碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早餐前及晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"此方有下列四種作用"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 加強心陽 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 加強脾胃功能"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 縮小腫瘤"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 使痰易咳出"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"囑: "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 因病人報告仍有二碗未喝, 故囑先停前二碗, 置冷凍庫備用, 先服今日之方, 下週四再來。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 此方服後唇舌有可能會有麻感。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}