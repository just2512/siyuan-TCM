{"ID":"20240513083012-qsup444","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083012-qsup444","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083012-qsup444\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513173219-jydvwk0\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513173219-jydvwk0\u0026quot;,\u0026quot;scrollTop\u0026quot;:549,\u0026quot;focusId\u0026quot;:\u0026quot;20240513173219-jydvwk0\u0026quot;,\u0026quot;focusStart\u0026quot;:474,\u0026quot;focusEnd\u0026quot;:474\u0026#125;","title":"304","type":"doc","updated":"20240515115329"},"Children":[{"ID":"20240513173219-jydvwk0","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 821px;","id":"20240513173219-jydvwk0","updated":"20240515115329"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：05/01/2008"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"223-1 L, V "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"40 中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"05/01/08"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"2005年被診斷為淋巴癌, 有二次化學治療(病人為俄羅斯人，1993年來美國，吃很多垃圾食物)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 睡時好時壞"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 口渴重, 喜温飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 胃口好, 有餓"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 大便每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 小便淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 雙足冷, 有時又熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 身温尚好, 有時覺冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 體力不好, 時呼吸困難,時又很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 有汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、 時無法集中注意力"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11、 頸腫大且咳出黃痰, 呼吸短促"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡紅, 黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"肝區受損(西藥造成), 腎區反應不好，胰區分離"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、觸診："},{"Type":"NodeText","Data":"督脈無壓痛且喜按，督脈浮出"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→陽不足"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 濕熱在肺, 金不生水"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"葦莖5錢, 丹皮3錢, 桃仁3錢, 冬瓜仁3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→千金葦莖湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"絡石藤5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→針對頸項腫瘤(喉癌、甲狀腺腫)專用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生硫磺2錢(另包)"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→色淡黃，入三焦"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蠣5錢, 海藻3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→鹹能軟堅"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→增潤津液"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子5錢 梔子3錢, 半夏4錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→利膈湯，開胸膈、利呼吸吞嚥"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白术3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→健脾去濕 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5 付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗煮3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"BF B/S."},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"1. 此人除了頸部腫大，其他內臟無大礙；少陰腎主喉，因為金不生水，津液堵在頸部，其病在肺，治應通利三焦。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}