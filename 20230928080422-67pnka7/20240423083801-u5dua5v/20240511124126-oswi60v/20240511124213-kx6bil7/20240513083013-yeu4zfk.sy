NodeText","Data":"自述從小有過敏。(疫苗傷害免疫系統)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3.)"},{"Type":"NodeText","Data":"身上多處皮膚乾皺紅赤。。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4.)"},{"Type":"NodeText","Data":"氣候變時紅疹明顯。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診：\n1.)睡眠："},{"Type":"NodeText","Data":"1:00"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"3:00 Am會醒來，3:00"},{"Type":"NodeText","Data":"5:00 Am也會醒來，半夜會盜汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.)大便："},{"Type":"NodeText","Data":"每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3.)小便："},{"Type":"NodeText","Data":"淡黃，多(10次)，(喝水多)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4.)胃口："},{"Type":"NodeText","Data":"好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5.)口渴："},{"Type":"NodeText","Data":"無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6.)身："},{"Type":"NodeText","Data":"覺熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7.)手足："},{"Type":"NodeText","Data":"雙足冷(需蓋被)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"8.)體力："},{"Type":"NodeText","Data":"佳"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"9.)汗出："},{"Type":"NodeText","Data":"運動後汗出，汗出會痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"稍洪大(符合節氣夏)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"瞳孔收縮不佳(腎陽不足)，心區扁平(心陽不足)，右眼肺區上方灰濁(痰濁)，右眼肺區上方有藍色小點(寄生蟲)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"清熱解毒，增潤津液，肝積毒素，肺中積痰、熱、燥，腎陽不足。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":"合谷，曲池，血海，三陰交，築賓(止癢)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：\n1.)"},{"Type":"NodeText","Data":"石膏 3兩，知母5錢，黃芩3錢，天花3錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"清肺熱、中焦熱，生津"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"南星3錢，半夏3錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"袪痰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡3錢，鬱金5錢，龍膽草3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"(疏肝解鬱，清肝溼熱)(清肝解毒)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"巴戟天3錢，龍骨5錢，牡蠣5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"(補腎楊，鎮浮陽、斂虛汗)(潛陽止盜汗)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"杏仁3錢，淮山3錢，白芷3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"(滋潤肺津、潤膚，散肺胃大腸氣分之熱)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"連翹3錢，銀花3錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"托散鬱火，解皮癢"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"共10付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗煮3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前服 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"ps若皮膚更新不理想，再加 蛇蛻、蟬蛻。 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.)"},{"Type":"NodeText","Data":"漢唐40號6兩 30x2(一天兩次，午餐前、睡前一次30粒)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"1.) 須停所有的西藥，疫苗。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"2.) 忌食精製甜食，甲殼類，魚蝦。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"3.) 類固醇越擦皮膚越粗。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}