{"ID":"20240513083021-xj97k71","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083021-xj97k71","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083021-xj97k71\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513171843-x76c2w9\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513171843-x76c2w9\u0026quot;,\u0026quot;scrollTop\u0026quot;:500,\u0026quot;focusId\u0026quot;:\u0026quot;20240513171843-x76c2w9\u0026quot;,\u0026quot;focusStart\u0026quot;:440,\u0026quot;focusEnd\u0026quot;:440\u0026#125;","title":"290","type":"doc","updated":"20240514174238"},"Children":[{"ID":"20240513171843-x76c2w9","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 850px;","id":"20240513171843-x76c2w9","updated":"20240514174238"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/05/12"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"218-4 L, YH"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"69歲  瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/05/16"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"肝癌"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠：睡整夜。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"飲食：納佳。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二便：小便排出來了，昨天下利二次。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胸腹：心臟還是緊緊的。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診： \n2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方： \n曲池、足三里"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→針對肩關節不好活動。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"後谿、申脈"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→針對後部大筋痛。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"公孫、內關"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→治胃心胸部之病。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天突、巨闕、關元"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→治心，心募巨關，小腸募關元。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"期門、左肝關"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→治肝，肝募期門。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"章門"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→治臟病，臟會章門。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水分、水道、陰陵泉"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"→利水。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便自己排出，而不是利尿劑排出，只要好好保養，不要熬夜少喝一點酒，常運動，腹水就不會回來。長期的飛機不要坐，沒有病人坐了腳不會腫。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"因為我在攻堅，所以會下利，我們治肝要治大腸。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"因為他給西醫碰過，如果沒有碰過，到我手上很快。大多數的肝癌患者腹水排不出來，因為栓塞的程度不一樣，而栓塞又不是我們做的，我們也不知塞到怎樣的程度。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"像我用藥是輕輕一推，不要重壓。所以我們遇到重病的患者，可能劑量會減輕，而加重劑量是等於要用藥物去取代身體的功能才這樣做。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}