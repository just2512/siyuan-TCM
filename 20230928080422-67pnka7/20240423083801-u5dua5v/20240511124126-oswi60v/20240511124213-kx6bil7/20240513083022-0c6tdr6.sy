Br","Data":"br"},{"Type":"NodeText","Data":"肆付     "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"→"},{"Type":"NodeText","Data":" 2碗    早晚餐飯前服用          "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(2) 同5/12 (3)方 再參付  中餐與睡前服用"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1.生冷食物加重脾濕, 需熟食"},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.分消湯每味劑量勿用太重，輕推才是甘淡滲利"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註：建議 不要吃生食,蔬菜,水果"}]}]}]}]}