Text","Data":"1、 病人進步中"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 肋痛減輕很多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 睡覺: 好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 胃口: 有改進, 會餓, 吃不多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 四肢: 睡要蓋被, 手足皆溫熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 大便: 每天都有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 小便: 深黃, 量增加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 口渴: 有, 喜冷飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 胸口仍有綁緊感，心臟好像被抓住"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→半夏厚朴湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"洪大 (原洪大且弦)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、"},{"Type":"NodeText","Data":"舌診：黃乾"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 病人(陰陽決離)好轉中"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"曲池  天突  巨闕  中脘  關元  期門  章門   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"後溪  曲池("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text