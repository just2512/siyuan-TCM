"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、胃口：好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、大便：不規則,時2次,時7次,平均4次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、小便：淡白"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、口渴： 無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、手足溫度："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、掌額溫度："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、問汗："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、體力：不好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、頭身：多數時身熱冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11、生理期：月經4月一次,因服避孕藥"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12、其他： 近一、二個月白帶多。一直有感冒症狀。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"細數,重按無脈"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"黃亁"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 虛熱"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"梔子3、豆豉2、酸棗仁3、黃芩3、半夏2、粳米3"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"400 粒, 每天3次,8粒/次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"梔子3錢、豆豉2錢、黃芩3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→