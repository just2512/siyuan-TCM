,{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 大便: 一日4 , 5次, 軟便, 時如鞭狀, 肚子稍脹感, 排氣有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 小便: 淡黃, 但仍濁且泡沫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 肛門仍有壓力"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 身熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 口渴: 有, 喜冷飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 胃口: 好, 中午時最餓 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 無胸脇苦滿"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"脈診： 浮, 洪大"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、舌診：舌根白濕，舌前半部淡紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診：N/A"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷： 進步中, 仍為大承氣湯症"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" N/A"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n大承氣湯"},{"Type":"NodeText","Data":" 100粒,  8x3  三餐前服用 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"HT- 26 (豬苓湯)        6兩  40 x 2  早晚餐前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":