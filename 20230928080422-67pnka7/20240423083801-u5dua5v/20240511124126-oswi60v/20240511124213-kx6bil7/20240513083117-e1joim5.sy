)。睡眠好轉許多。胃口下降了。口不渴。短氣好轉很多。小便中黃。體力尚可。躺下睡覺時喉中會有痰，造成咻咻聲。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"左脈小，右脈稍大"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白，旁邊牙痕多且伴有紫黑瘀塊"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 病人進步中，症同前"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子四錢  細辛二錢  大黃七錢  麻黃三錢  黃連二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃芩三錢  白芍一兩  炙甘草三錢  石膏六兩  知母五錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢  鬱金五錢  龍膽草三錢  丹皮三錢  桃仁三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏四錢  南星三錢   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗水煮成3碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent"