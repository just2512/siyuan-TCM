{"ID":"20240513083124-leab0g1","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083124-leab0g1","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083124-leab0g1\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513161003-6ppdqfr\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513161003-6ppdqfr\u0026quot;,\u0026quot;scrollTop\u0026quot;:300,\u0026quot;focusId\u0026quot;:\u0026quot;20240513161003-6ppdqfr\u0026quot;,\u0026quot;focusStart\u0026quot;:538,\u0026quot;focusEnd\u0026quot;:538\u0026#125;","title":"210","type":"doc","updated":"20240514152219"},"Children":[{"ID":"20240513161003-6ppdqfr","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 928px;","id":"20240513161003-6ppdqfr","updated":"20240514152219"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":"      初診日期：2008/03/25"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"170 C, FY"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"1947年生 有點胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"2008/03/25"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"右肋時不舒服，左胸上方時悶痛。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"睡不好、小便多、無固定時間。小便後不易回睡。多夢，故睡覺品質不好。上午十點多與下午三點多最想睡。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、胃口："},{"Type":"NodeText","Data":"不好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、大便："},{"Type":"NodeText","Data":"有時一日兩次，未盡感(裡急後重)。近幾日先血後便(內痔)。痔瘡四時年前開過瘻管"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、小便："},{"Type":"NodeText","Data":"淡黃。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、口渴："},{"Type":"NodeText","Data":"尚好。口乾。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、手足溫度："},{"Type":"NodeText","Data":"雙手足溫。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7、掌額溫度："},{"Type":"NodeText","Data":"手溫額涼。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"8、其他："},{"Type":"NodeText","Data":"小魚際有時會泛紅且有斑點。(肝內有積)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"右手脈大於左手脈(男子正常)。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"肝區平整、肺區有痰(色黃，為相生之色故尚好)、腎陽不足、脾區稍大。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"腎陽不足，肝肺脾虛證。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(1)黃芩三錢 黃連兩錢 白芍五錢 阿膠三錢 補骨脂三錢 澤瀉五錢 細辛二錢 烏藥五錢 巴戟天三錢 槐花三錢 當歸三錢 赤豆五錢 大黃二錢 柴胡三錢 鬱金五錢 龍膽草三錢  半夏三錢 南星三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(2)HT-14 治療膽結石 六兩 早晚飯前個三十顆 (因膽結石點有壓痛)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"治肝要瀉南補北。黃芩黃連為瀉南；補骨脂、澤瀉為補北(腎) "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"大黃加芩連可去大腸溼熱治療裡急後重"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}