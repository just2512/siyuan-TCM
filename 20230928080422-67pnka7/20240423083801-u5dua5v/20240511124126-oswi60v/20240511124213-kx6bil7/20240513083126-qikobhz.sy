":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠："},{"Type":"NodeText","Data":"不好, 盜汗多, 且身很冷, 似風吹進來。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口:"},{"Type":"NodeText","Data":" 好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"秘, 二天一次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"渴:"},{"Type":"NodeText","Data":" 有, 喜溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雙足:"},{"Type":"NodeText","Data":" 冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"月經:"},{"Type":"NodeText","Data":" 仍有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他 :"},{"Type":"NodeText","Data":" 全身到處痛, 左眼濕多"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":" 右寸上寸弦, 細, 浮"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td