","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 項緊"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 大便一日二三次,稀(已停大黃水)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 排氣多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便每1-2小時一次,時黃時白"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 手足心汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 渴有喜冰水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 廣步沙灘,滿頭大汗,油光(陽氣旺)滿面"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診：\n2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" 同前穴 加風池 天柱 大抒 後溪 申脈 治項緊"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同4/25方 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"改 炮附子二錢"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"渴喜冰飲"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"由四錢減為二錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"加 川芎三錢"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"引明目藥如決明子等上到眼睛  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"bf B/S"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"頭痛時必用川芎,若為throbbing pain重用勾陳"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"瘀血外用川芎粉(棉布包,撒點酒固定外敷,藥包勿曬到太陽則可重複使用),亦可用於足大指內側突起(穿高跟鞋引起),軟骨增生,腱鞘囊腫"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}