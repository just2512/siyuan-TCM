{"ID":"20240513083131-4kpmk8i","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083131-4kpmk8i","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083131-4kpmk8i\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513155916-zi9u8gu\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513155916-zi9u8gu\u0026quot;,\u0026quot;scrollTop\u0026quot;:437,\u0026quot;focusId\u0026quot;:\u0026quot;20240513155916-zi9u8gu\u0026quot;,\u0026quot;focusStart\u0026quot;:266,\u0026quot;focusEnd\u0026quot;:266\u0026#125;","title":"202","type":"doc","updated":"20240514144915"},"Children":[{"ID":"20240513155916-zi9u8gu","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 856px;","id":"20240513155916-zi9u8gu","updated":"20240514144915"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"165-4 C, MC"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型："},{"Type":"NodeText","Data":"體型中等偏瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"20080505"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"弱視"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 動輒汗出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 左耳後小腫塊漸消,壓時微痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便日二三行,飲大黃水似微溏"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 尿頻,時急時緩,量一般"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 晨起口乾微苦,有痰"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 足稍冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 手足腋下汗多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 胃口好,但食量減少"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 渴喜冰飲"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診：\n2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： 同前穴"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同4/25方 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"改  炮附子二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→渴喜冰飲→熱已回,故由四錢減為二錢"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"加  川芎三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→頭痛 餘同"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.先停大黃水,因目紅已減"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.退化為寒,如視力減退等"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}