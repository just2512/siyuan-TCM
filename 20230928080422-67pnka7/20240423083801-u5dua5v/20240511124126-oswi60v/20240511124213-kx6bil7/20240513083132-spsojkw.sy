{"ID":"20240513083132-spsojkw","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083132-spsojkw","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083132-spsojkw\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513155634-u5p1g6i\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513155634-u5p1g6i\u0026quot;,\u0026quot;scrollTop\u0026quot;:282\u0026#125;","title":"200","type":"doc","updated":"20240515122151"},"Children":[{"ID":"20240513155634-u5p1g6i","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 1045px;","id":"20240513155634-u5p1g6i","updated":"20240515122151"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"165-2 C, MC"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型來診日期："},{"Type":"NodeText","Data":"4/25/2008"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"來診原因：　弱視"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 左耳旁頭皮長了一粒凸起的 – 濕熱性皮膚炎"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 早上醒來有眼屎,癢,有時很多,黏住眼皮"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 脖子鬆不了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 大便每日2-3次,有時較不濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 小便每1-2小時一次,甚急, 量不多不少,時黃時白"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 每日八點起來,嘴巴喉嚨微乾微痰"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 手温普通,足温微冷,腳底是冰冷的"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 手心腳心易出汗,腋下鼠蹊腎部亦有汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 睡眠好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11、 渴想喝冰水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12、 左腳扭到好了"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診：\n2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上焦濕熱仍有, 下寒濕"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" 針同前穴"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黃片3片, 每日一片泡茶喝,每日至少三杯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"蒼朮3錢, 黃芩3錢, 黃連2錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→上焦濕熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花5錢, 麥冬3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→生津"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"烏葯5錢, 細辛3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→溫下焦"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"何首烏5錢, 當歸2錢, 側柏葉5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→生髮烏髮"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炙甘草5錢, 白芍5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→芍藥甘草湯，治腳冷"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"決明子4錢, 柴胡3錢, 玉金5錢, 龍胆草3錢,"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→清肝明目"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗煮3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"BF B.S.　"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}