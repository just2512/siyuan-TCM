{"ID":"20240513083133-qaljby0","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083133-qaljby0","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083133-qaljby0\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513155554-5d3jz41\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513155554-5d3jz41\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240513155554-5d3jz41\u0026quot;,\u0026quot;focusStart\u0026quot;:249,\u0026quot;focusEnd\u0026quot;:249\u0026#125;","title":"199","type":"doc","updated":"20240514143718"},"Children":[{"ID":"20240513155554-5d3jz41","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 1006px;","id":"20240513155554-5d3jz41","updated":"20240514143718"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"165-1 C, MC"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型來診日期："},{"Type":"NodeText","Data":"4/21/2008"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"來診原因：弱視"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左耳旁頭皮長了一粒凸起的 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→濕熱性皮膚炎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左腳扭到"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"脖子鬆不了"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→老師說這是裡寒造成的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 大便每日2-3次,微濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 小便每1-2小時一次,甚急, 量不多不少,有時黃, 這2個星期幾乎都早上3點起來撒一泡尿,才回去睡覺."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 每日七八點起來,嘴巴喉嚨微乾微痰"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 手微冷,腳仍冰冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 手心腳心易出汗,腋下鼠蹊臀部亦有汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 睡眠好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 胃口超級好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 口渴想喝冰水"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診：\n2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上熱下寒, 肝胆經之濕熱重症"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" 針同前穴 + 埋耳針(眼)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"蒼朮3錢, 黃芩3錢, 黃連2錢, 天花5錢, 　麥冬3錢, 生附子3錢(另包), "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乾薑2錢, 桂枝3錢, 白芍3錢, 龍骨5錢, 牡蠣5錢, 炙甘草3錢, 決明子3錢, "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡3錢, 玉金5錢, 龍胆草3錢, 烏葯3錢, 細辛2錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗水煮成3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"倪師曰：「治療脂漏性皮炎的方式與治療但頭汗出相同，病機都是陽浮於上，所以治療要潛陽。」"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}