pe":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 大便每天一行，肛门仍痒。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 小便黄"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 耳中仍闻人声。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 口渴有，室温水（以前饮冰的）。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 抽筋没有了。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 胃口有饿。味覺好。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診：淡红无苔。舌体萎缩。\n2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"魄不守，故闻人声。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong strong","TextMarkTextContent":"1． "},{"Type":"NodeTextMark","TextMarkType":"strong strong strong","TextMarkTextContent":"蛇床子粉（治阴痒）"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.甘麦大枣汤（"},{"Type":"NodeText","Data":"治如見神明状的幻听症） 800粉量"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当归二钱，川芎三钱，生地三钱，白芍五钱，黄连二钱，黄芩三钱，阿胶三钱，柴胡三钱，郁金五钱，龍胆草三钱，远志五钱，茯神三钱，泽泻五钱，蛇床子三钱，天花粉五钱，麦冬五钱，白术三钱，茯苓五钱，乌药五钱，细辛二钱"},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5 帖   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗水煮成3碗   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每天早晚飯前各喝一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：方中黄连阿胶汤补心血治失眠。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡，玉金，龍膽草"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→清肝解毒。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"遠志，茯神，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→安神。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花，麥冬"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→生津 涼肺潤肺 止渴。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉，茯苓，生地"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→补腎，滋陰。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乌药，细辛治頻尿。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"四物湯活血补血。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"此女不可便秘，因肺與大腸相表裡，而此女病在魄。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}