t","TextMarkTextContent":"→潤腸 活血"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5月1日方如下："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連二錢 黃芩三錢 白芍五錢 阿膠三錢\u003c分三包烊盡\u003e"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→黃連阿膠湯 補心血"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢 玉金五錢 龍膽草三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":" →清肝解毒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"遠志五錢 茯神三錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→安神"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"補骨脂三錢 澤瀉五錢 生地三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→捕腎 滋陰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花五錢 麥冬五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→生津 涼肺潤肺 止渴"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服時加生蛋黃一只 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三帖 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9煮3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"中午 及睡前服一碗  \u003c代煮\u003e"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"\u003c三\u003e甘麥大棗湯 200粉量 三餐後沖水服 每次三茶匙"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"治如見神靈状"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":" 1.頻尿之因有二："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"一為肺氣無法下降"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"小便還可控制，只是常有尿意 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"二為小腸熱度不夠"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"頻尿無法控制 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.肺藏魄，魄不藏則會白天見鬼，幻聽也是白天見鬼的一種，甘麥大棗湯可補肺津使魄守"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeText","Data":"大承氣湯 10粒如無大便可再加五粒多到戶外走走"}]}]}]},{"ID":"20240513155022-e53m7w6","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"","id":"20240513155022-e53m7w6","updated":"20240513155033"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th"}]}]}]}]}