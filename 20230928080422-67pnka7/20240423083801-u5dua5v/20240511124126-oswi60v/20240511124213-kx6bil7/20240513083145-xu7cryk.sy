{"ID":"20240513083145-xu7cryk","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083145-xu7cryk","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083145-xu7cryk\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513151920-jpwrim5\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513151920-jpwrim5\u0026quot;,\u0026quot;scrollTop\u0026quot;:701,\u0026quot;focusId\u0026quot;:\u0026quot;20240513151920-jpwrim5\u0026quot;,\u0026quot;focusStart\u0026quot;:415,\u0026quot;focusEnd\u0026quot;:590\u0026#125;","title":"187","type":"doc","updated":"20240515122417"},"Children":[{"ID":"20240513151920-jpwrim5","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 884px;","id":"20240513151920-jpwrim5","updated":"20240515122417"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/05/20"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"159-1 C, JF "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"51歲 中等身材"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/05/20"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.疲勞時易腹瀉 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.中午沒睡、午覺易腹瀉 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3.頭髮白 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4.久站時腰痠痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、胃口："},{"Type":"NodeText","Data":"胃口尚可"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、大便："},{"Type":"NodeText","Data":"平時軟每日一行.喝涼第二天大便則散"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、小便："},{"Type":"NodeText","Data":"淡白 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、手足溫度："},{"Type":"NodeText","Data":"雙足熱.喝冰則冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、口渴："},{"Type":"NodeText","Data":"口渴想喝涼.但第二天大便即散"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7、體力 ："},{"Type":"NodeText","Data":"早上體力尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"8、汗："},{"Type":"NodeText","Data":"易出汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"9、其他："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、腹痛發生在腹瀉之前，瀉後則不痛，水便色黃.味臭,水便後熱氣上 浮面部。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、上廁所之前腹痛，上完腹痛即止。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":" 稍數"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"無"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 裏濕熱重.補腎陽"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連2錢.黃芩2錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去熱 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白朮5錢.茯苓5錢.澤瀉5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去濕 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"側柏葉3錢.當歸2錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":" →生髮 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生地2錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補陰 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"何首烏5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→治白髮 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"補骨脂3錢.炮附子3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎陽.固腎陽"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"    "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"3碗 BF B/S"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1、治腎當治心，中午沒睡耗損心力，心力耗損之後緊跟者表現腎衰， 腎主二便，故引起腹瀉。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、久立傷腎，故久站後腰痠痛，白髮亦是腎虛。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、上廁所之前腹痛，上完腹痛即止和脾有關，脾主少腹。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、若補陰不補陽則陰不守，固陽則陰不流失。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、若不易出汗則用炮附子更不易出汗。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、陰虛日久陽虛，陽虛日久成陰實，故陰實必需要補陽，而補陰時必  需要陽藥固守。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}