tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠："},{"Type":"NodeText","Data":"很好，一覺到天亮，沒有吃安眠藥"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"好，有餓，味覺好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"會，喜冷冰飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 雙足冷，身體無特別感到寒熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 月經準時，每月9日或4日來"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 精神體力差"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 手冷額熱，掌色淡黃"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→血虛，因為肝脾不和(肝藏血、脾統血)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白乾紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"瞳孔反應好，但腎區大； 肝脾區混在一起，如同木被砍後打碎與泥土和在一起。"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→肝脾不和"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 血不足；肝脾失衡；腎陽不足"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡3錢 黃芩3錢 鬱金6錢 龍膽草3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":" → 清肝"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"山茱萸3錢 淮山3錢 當歸2錢 川芎3錢 茜草3錢 何首烏3錢 炙甘草5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→ 補肝血活血"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"熟地2錢 澤瀉5錢 補骨脂3錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"遠志5錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":" → 安神定志 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"伍付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"HT-71(清鬱開結丸)   中餐前及睡前各30顆"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 肝主怒，脾主思，合在一起就是憂。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 此女病在少陽，以柴胡為主，即使手冷也不需用桂枝，方向對，柴胡也可使手溫起來，並非手冷就要用桂枝。其手掌色萎黃慘白為血虛，眼診發現肝腎均受損，處方以疏肝、健土、補腎為主，並加以言語鼓勵，重建患者信心，使其大事化小，小事化無。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 腎藏志、主恐，腎功能正常，人才會有安全感，反之則會焦慮。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. HT-71為加味逍遙處方，只要使肝脾調和，人就會開心。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeText","Data":"人為甚麼會憂鬱，找出原因治療加以疏解，而不是服用藥物壓制，抗憂鬱藥物有導致自殺的副作用。"}]}]}]}]}