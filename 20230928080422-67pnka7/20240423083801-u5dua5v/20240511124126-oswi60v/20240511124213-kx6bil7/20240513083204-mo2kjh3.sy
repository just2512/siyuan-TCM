xtMarkTextContent":"小便 :"},{"Type":"NodeText","Data":" 好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他體症 :"},{"Type":"NodeText","Data":" 頭痛. 自腰以下無知覺"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→此乃類固醇及放射線的副作用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"。性功能喪失("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"化療與類固醇的副作用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":").時常仍有失去平衡感. 口苦仍重, 食道有炙熱感."},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈數有力, 一息六至."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他：\n1、舌診："},{"Type":"NodeText","Data":"白濕, 舌面有紅點"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"心陽不足, 肺區白點多"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"心陽不足, 肺區白點多, 腎陽回復許多但大便仍無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子四錢  生硫磺二錢  桂枝三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢  玉金五錢  龍膽草三錢  丹皮三錢  川芎三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"熟地三錢  陽起石三錢  黃蓮二錢  黃芩三錢  阿膠三錢(分三包) 白芍五錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"瓦楞子五錢  牡蠣一兩南星三錢  地龍三錢  桔梗五錢   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"七付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"HT- 41(中安丸, 失眠用) 30 x 2 (after lunch \u0026 before bed)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeText","Data":"2008/6/21 同上方, 去阿膠 再三付"}]}]}]},{"ID":"20240513150350-cqgds33","Type":"NodeParagraph","Properties":{"id":"20240513150350-cqgds33"}},{"ID":"20240513150351-04lf1mn","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 922px;","id":"20240513150351-04lf1mn","updated":"20240514133709"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2005/05/24"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"Basam Ahmed"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"49歲, 約旦人"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2005/07/30"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"腦瘤與淋巴癌.作完化療後, 全身免疫功能下降至零. 在醫院得到嚴重肺炎, 幾乎死去, 體重下降至80磅. 目前全身發炎, 口中發炎, 食道發炎. 已完成18次放射治療, 一次化療. 三週前檢查得知, 腦瘤已消除99%."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠 :"},{"Type":"NodeText","Data":" 不好."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口 :"},{"Type":"NodeText","Data":" 不好, 腹滿."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴 :"},{"Type":"NodeText","Data":" 有. 但是喝不多."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"身體溫度 :"},{"Type":"NodeText","Data":" 無寒熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他體症 :"},{"Type":"NodeText","Data":" 面色青黑, 下肢無力. 咳嗽多, 痰清白."},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"細數虛無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他：1、舌診："},{"Type":"NodeText","Data":"淡黃紅厚, 唇口破裂."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷： 腎陽衰, 肝損重, 肺萎。需大劑四逆湯救助"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[