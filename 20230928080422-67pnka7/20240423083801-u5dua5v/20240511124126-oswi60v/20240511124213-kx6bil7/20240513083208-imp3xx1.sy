{"ID":"20240513083208-imp3xx1","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083208-imp3xx1","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083208-imp3xx1\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513142724-i14otcl\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513142724-i14otcl\u0026quot;,\u0026quot;scrollTop\u0026quot;:200,\u0026quot;focusId\u0026quot;:\u0026quot;20240513142724-i14otcl\u0026quot;,\u0026quot;focusStart\u0026quot;:252,\u0026quot;focusEnd\u0026quot;:252\u0026#125;","title":"169","type":"doc","updated":"20240514132928"},"Children":[{"ID":"20240513142724-i14otcl","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 955px;","id":"20240513142724-i14otcl","updated":"20240514132928"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"147-6 Z, YX"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"35歲 身材好"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/05/28"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"調理身體。病人好轉中"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 腳從三陰交以下冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 腰痠減少"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 這兩天口唇乾(因上方有炮附子)，喉疼"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 大便天天有但排出困難，質硬"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 小便黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 有排氣"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 手好冰冷，一直如此"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 下焦仍有實，先不管寒水"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： 小承氣湯 400粒  8X2 早晚飯前服"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說： \n1."},{"Type":"NodeText","Data":"現在要去掉炮附子，專心通便，讓胃氣下行則三陰交以下就不冷了"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}