{"ID":"20240513083209-ieoy9i3","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083209-ieoy9i3","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083209-ieoy9i3\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513142604-7ck1k4k\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513142604-7ck1k4k\u0026quot;,\u0026quot;scrollTop\u0026quot;:623,\u0026quot;focusId\u0026quot;:\u0026quot;20240513142604-7ck1k4k\u0026quot;,\u0026quot;focusStart\u0026quot;:567,\u0026quot;focusEnd\u0026quot;:567\u0026#125;","title":"167","type":"doc","updated":"20240515122701"},"Children":[{"ID":"20240513142604-7ck1k4k","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 931px;","id":"20240513142604-7ck1k4k","updated":"20240515122701"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"147-4 Z, YX"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"05/02/2008"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服前方後, 雙膝下仍有冷(非持續性), 天氣冷, 便覺寒, 有時又覺熱."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 便秘, 二至三天一次. ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"病人前方服用當歸四逆湯, 當歸潤腸, 木通利大便但病人仍便秘"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 胃口很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 睡眠尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 口渴少 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"因有寒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 月經尚未至, 但乳房已有漲感. ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"女子欲停止脯乳時, 或月經來前乳房漲滿時, 可以四物湯加炒麥芽退奶"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 平時月經有血塊("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"少腹寒冷"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 小便淡黃有時深("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"當歸四逆湯治寒症, 但病人時有小便深黃, 表陽明熱. 為承氣湯症. 故寒藥不治其熱實便秘"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 排氣不多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 多數覺寒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、 不覺噁心 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"病人便秘, 舌淡黃但多數覺寒. 不覺燥熱, 無噁心. 故不考慮大柴胡湯症"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11、 無汗，服四逆湯(3/27方)時有流汗且渴飲水多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12、 總是左頰(胃經)過敏"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"細小無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 陽明燥實兼心陽不足"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生附子三錢 乾薑二錢 炙甘草五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→四逆湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白芍五錢 茜草三錢 桃仁三錢(月經有血塊) 丹皮三錢 川芎三錢 當歸三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→月經將至，活血、去瘀、補血"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大黃三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去實"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"細辛二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炒麥芽五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→助排淨奶水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"熟地三錢 澤瀉五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(不加白朮茯苓, 怕胃口大開) "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}