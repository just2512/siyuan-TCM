pe":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 胃口很餓、味覺沒了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 大便一日二、三次，色棕黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 小便色淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 不易出汗"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→心臟不夠強，因木為火之母"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 近來仍有抽筋且手抖"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 體力好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 體重上升一點"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"洪大中空有力、緩"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"肝區鬆動、剝落狀、破洞、圈紋，腎區反應好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、面色："},{"Type":"NodeText","Data":"氣色好多了"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"肝主筋，筋不養則痙"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.  平胃散   200粉   三餐前三茶匙"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.  四神湯加蔗糖水"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"囑做些運動令汗出"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→使天陽入肺，只有肺金能治肝木。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]}]}]}