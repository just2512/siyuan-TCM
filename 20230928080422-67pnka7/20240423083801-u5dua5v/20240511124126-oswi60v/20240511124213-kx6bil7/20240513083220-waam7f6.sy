{"ID":"20240513083220-waam7f6","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083220-waam7f6","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083220-waam7f6\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513135246-g14inag\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513135246-g14inag\u0026quot;,\u0026quot;scrollTop\u0026quot;:763,\u0026quot;focusId\u0026quot;:\u0026quot;20240513135246-g14inag\u0026quot;,\u0026quot;focusStart\u0026quot;:620,\u0026quot;focusEnd\u0026quot;:620\u0026#125;","title":"155","type":"doc","updated":"20240515122852"},"Children":[{"ID":"20240513135246-g14inag","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 940px;","id":"20240513135246-g14inag","updated":"20240515122852"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄   初診日期：2008/03/26"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"119-4 T, M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"59歲，過胖很多"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080515"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 星期六星期天都有癫痫发作(因做房地產，整晚看電腦造成)，发作时无法言语。 动作迟缓。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 仍然在服用抗癫痫药物"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 大便一天2次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 小便淡黃，量很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 胃口：減少了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 體重沒下降了"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→经常很晚吃很多东西，所以很难瘦下来。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 口渴仍重，喜冰冷飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 睡時:身无寒熱，睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 體力仍差"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 每天花很多时间在电脑上工作、很晚睡"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡白乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"瞳孔反應差"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→腎陽不好；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"肝區有黑點破洞"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→肝積毒素 肺区有两条鸡爪丝，如果这碰到眼珠子，癫痫就会再发作"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"陽明經熱兼腑熱"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：\n延用 4/22 的方继续服用。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"石膏八兩  知母五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去陽明經熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"厚朴二錢  枳實三錢  大黃三錢  芒硝三錢(分三包沖服)"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→大承氣湯，清腑實"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢  鬱金五錢  黃芩三錢  龍膽草三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→清肝"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花八錢  生地三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→因渴重，增津液"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"防己五錢  茯苓六錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→令水由三焦出"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"遠志三錢  茯神三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→安神定志"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉六錢  補骨脂三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"升麻三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→升提津液   "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"400 caps "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三餐飯后各8 caps"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"动作迟缓是因长期的服用抗癫痫药物的副作用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"。"},{"Type":"NodeText","Data":"发过长时间工作在电脑上可能是导致癫痫发作的原因"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 不要吃任何营养及维他命，晚上睡前不要吃食物，应保持空腹睡觉，如果饿可以服用此膠囊代替食物      "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 改善饮食习惯如high fat, low sugar, low protein.可减少癫痫的发作。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}