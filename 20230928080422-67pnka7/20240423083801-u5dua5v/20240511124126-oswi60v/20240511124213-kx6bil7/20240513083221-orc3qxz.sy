,"Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 口渴更重"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 大便時隔日一行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 胃口降一半"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便中黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 較易出汗了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 睡好，體力仍差"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 睡時身熱仍有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 體重下降16磅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 情緒好多了"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃乾"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"仍有陽明熱"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"石膏八兩  知母五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去陽明經熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Ty