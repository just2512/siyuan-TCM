{"ID":"20240513083225-ac132qw","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083225-ac132qw","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083225-ac132qw\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513134642-fv0bqy9\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513134642-fv0bqy9\u0026quot;,\u0026quot;scrollTop\u0026quot;:400,\u0026quot;focusId\u0026quot;:\u0026quot;20240513134642-fv0bqy9\u0026quot;,\u0026quot;focusStart\u0026quot;:481,\u0026quot;focusEnd\u0026quot;:481\u0026#125;","title":"148","type":"doc","updated":"20240515122956"},"Children":[{"ID":"20240513134642-fv0bqy9","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 1038px;","id":"20240513134642-fv0bqy9","updated":"20240515122956"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"117-11 S, T"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"58歲,胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"20080514"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"肺積水,雙足水腫"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服前方後, 呼吸短促好轉許多, 可平躺睡, 且3:00AM不醒來了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 胃口平平"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 小便還好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 口渴無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 身溫正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 體力差"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 大便好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 病人沒感覺心悸"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈仍數,一息7-8至,細,數,沉,夏逢冬脈,土來制水"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白紅"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→好轉,且不再陷很深,有浮起狀(心陽回頭)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心藏肥大好轉,肺積水退,腎陽不足"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： 針同前穴"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麻黃五錢 射干三錢 紫苑三錢 冬花三錢 生姜二片 乾姜二錢 細辛二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏五錢 五味子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→射干麻黃湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉五錢 白朮三錢 茯苓五錢 車前子四錢 通草五分"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→健脾利水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"陳皮三錢 厚樸二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→開胃降氣 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"壹付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"今日晚餐前4:00PM,睡前8:00PM,及明日早餐前各一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"如服此方很好,小便大量出,則續用不變內容"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.病人昨日藥後心跳未加快"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→麻黃對症(提壺揭蓋,助水排出)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.昨日藥後身僅有微汗出"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去炮附子,加重麻黃至五錢→毛孔打開以助排水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3.排水時應注意口渴情形"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→病人口不渴→水排出而無脫水現象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}