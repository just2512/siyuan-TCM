{"ID":"20240513083226-b5m6j6x","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083226-b5m6j6x","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083226-b5m6j6x\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513134605-uy1wume\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513134605-uy1wume\u0026quot;,\u0026quot;scrollTop\u0026quot;:141,\u0026quot;focusId\u0026quot;:\u0026quot;20240513134605-uy1wume\u0026quot;,\u0026quot;focusStart\u0026quot;:437,\u0026quot;focusEnd\u0026quot;:437\u0026#125;","title":"147","type":"doc","updated":"20240515125335"},"Children":[{"ID":"20240513134605-uy1wume","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 896px;","id":"20240513134605-uy1wume","updated":"20240515125335"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"117-10 S, T"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"58歲,胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"20080513"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"肺積水,雙足水腫"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 肺中仍積水,服前方後,排下多量水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 原可平躺,後到3:00AM又醒來無法再睡,自覺無法呼吸"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 雙足不冷了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便持續增加中"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 胃口不好,人倦怠"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 無口渴"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 身無寒熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 肺無痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 雙小腿,足仍有水腫"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈時數時緩"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"白濕厚苔,中凹陷(心臟肥大)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"右眼肺區有一點點白點"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心藏肥大,肺積水(陰實之症),但仍不明顯"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麻黃三錢 射干三錢 紫苑三錢 冬花三錢 生姜二片 乾姜二錢 細辛二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏五錢 五味子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→射干麻黃湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→合細辛溫下焦助小便"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉五錢 白朮三錢 茯苓五錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→健脾利水 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"壹付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"今日晚餐前,睡前,及明日早餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.毛孔不開故水不去,故用射干麻黃湯於十棗湯後避免水又回來"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.病人同時有腳腫,按理應用炙甘草強心陽,但病人有水腫故不能用"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3.病人睡時有頭面盜汗,表示陽氣不能入陰而上浮"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→可能有陰實"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]}]}]}