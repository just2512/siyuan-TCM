xtMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 晚上睡好,呼吸仍困難,仍有時須要坐起睡"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→肺中仍有積水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 胃口好許多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便量增加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 口渴無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 身一般較冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 晚上有盜汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 咳嗽無,只有短氣"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈一息八至,有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白厚,中凹陷"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心包仍積濕,肺中有一點水"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： 同前穴(陰陵泉 地機 三陰交 復溜 水泉 照海 公孫 內關 足三里 巨闕 關元)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十棗湯  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8粒一劑    "},{"Typ