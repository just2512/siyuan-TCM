Mark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠："},{"Type":"NodeText","Data":"好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"好; 仍有一點胃酸反逆"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"每日三行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"手足溫度："},{"Type":"NodeText","Data":"雙足時溫時冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體力:"},{"Type":"NodeText","Data":" 好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 雙膝為人工關節"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 今晨血壓116/71"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩無力中空"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃, 較前淡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"肝區較鬆"},{"Type":"Node