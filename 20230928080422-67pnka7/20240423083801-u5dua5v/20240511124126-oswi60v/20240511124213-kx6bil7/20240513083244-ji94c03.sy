{"ID":"20240513083244-ji94c03","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083244-ji94c03","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083244-ji94c03\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513132856-pjug9ot\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513132856-pjug9ot\u0026quot;,\u0026quot;scrollTop\u0026quot;:597,\u0026quot;focusId\u0026quot;:\u0026quot;20240513132856-pjug9ot\u0026quot;,\u0026quot;focusStart\u0026quot;:535,\u0026quot;focusEnd\u0026quot;:535\u0026#125;","title":"127","type":"doc","updated":"20240515123116"},"Children":[{"ID":"20240513132856-pjug9ot","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 906px;","id":"20240513132856-pjug9ot","updated":"20240515123116"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/3/10"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"096-1 P, T"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓別"},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出生年"},{"Type":"NodeText","Data":"56歳"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"2008/3/10"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左腿有血塊，因左腿兩年前突然腫大故知有血塊，之後被西醫確診罹血癌，有做化療，服食多種西藥。心情憂鬱沮喪，有吃prozac抗憂鬱藥"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡："},{"Type":"NodeText","Data":"不佳"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"每日有。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeText","Data":"淡白。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"渴："},{"Type":"NodeText","Data":"有，愛喝冰水。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"手足溫度："},{"Type":"NodeText","Data":"雙手足冷"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→造成左腿血塊，並有中風、心臟病之危險"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出汗："},{"Type":"NodeText","Data":"兩三週前半夜盜汗。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有嚴重口臭"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→師曰：胃不好"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"心脈洪大"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeText","Data":"皮膚不好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"觸診："},{"Type":"NodeText","Data":"壓督脈第五椎下痛，第六椎下無壓痛"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→無血癌，心有問題，睡不好的原因。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："},{"Type":"NodeText","Data":"心區無壓痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡白紅。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"四逆證。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：當歸四逆湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝三錢 白芍三錢 炙甘草三錢 大棗十枚  當歸二錢 木通二錢 細辛二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃芩三錢 黃連一錢半 阿膠三錢（分三包）"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→黃連阿膠湯，前三天加蛋黃，之後若睡眠好，去蛋黃。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→收表，解決盜汗問題。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"丹皮三錢 川芎三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→活血化瘀"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢 玉金五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→疏肝令心情愉悅"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9—3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早餐前及晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1、"},{"Type":"NodeText","Data":"單純心力不足造成之手腳冰冷用四逆湯，血虛血寒之四逆用當歸四逆湯。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、"},{"Type":"NodeText","Data":"禁食西藥，咖啡及人工甘味食品，可多食葡萄、海藻，茶及黑糖水。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、"},{"Type":"NodeText","Data":"若有下利噁心、胃寒的症狀可加吳茱萸、亁薑。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}