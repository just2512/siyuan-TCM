extMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 胃口好，味覺好，偶然有一點噁心"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 大便"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"："},{"Type":"NodeText","Data":"前一周有便秘，近五天大便又出來了，且色很黑"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 三週前右肋仍有痛、胸痛，現又無了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 小便"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"："},{"Type":"NodeText","Data":"淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 口渴有，喜常溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7、"},{"Type":"NodeText","Data":"雙足溫度：雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"8、"},{"Type":"NodeText","Data":"體力尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"9、"},{"Type":"NodeText","Data":"前兩週身很熱，第三周以後很好且穩定"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"10、"},{"Type":"NodeText","Data":"右腎痛減少"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"11、"},{"Type":"NodeText","Data":"肌肉痛、關節痛仍有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"12、"},{"Type":"NodeText","Data":"手溫額涼"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"肝區生動很多但仍有圈紋，已好很多，尚有些白點 瞳孔反應比上次好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"進步中。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同3/24方加  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"滑石六錢  豬苓五錢  赤小豆五錢  柏子仁三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢 黃芩三錢 郁金八錢 青皮五錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"排肝毒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"瀉南"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白芍八錢 茜草五錢 炙鱉甲六錢 川芎三錢 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"攻肝淤血"},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"細辛二錢 烏藥五錢 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鞏固頻尿療效"},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"補骨脂三錢 覆盆子三錢 澤瀉六錢