{"ID":"20240513083246-9t6q3gy","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083246-9t6q3gy","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083246-9t6q3gy\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513132730-xg4y8uo\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513132730-xg4y8uo\u0026quot;,\u0026quot;scrollTop\u0026quot;:300,\u0026quot;focusId\u0026quot;:\u0026quot;20240513132730-xg4y8uo\u0026quot;,\u0026quot;focusStart\u0026quot;:329,\u0026quot;focusEnd\u0026quot;:329\u0026#125;","title":"125","type":"doc","updated":"20240514123204"},"Children":[{"ID":"20240513132730-xg4y8uo","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 699px;","id":"20240513132730-xg4y8uo","updated":"20240514123204"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"095-3 P, R"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"Male"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"45+ 中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/04/21"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"C肝復診。上次服藥后，第一周肝腎區痛，第二周好多了。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"頭身："},{"Type":"NodeText","Data":"仍有身熱，輕微頭痛，肌肉關節有時痛，以前有鼻塞流涕，現在好轉許多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"時好時壞，一日一行，時間不規則"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeText","Data":"淡黃清"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"會口渴，喜常溫水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 睡時身熱些"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體力："},{"Type":"NodeText","Data":"尚好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈弦有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡白濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："},{"Type":"NodeText","Data":"腎點有壓痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"觸診："},{"Type":"NodeText","Data":"右腳腎石點壓痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 查其手掌顏色好(查肝)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診："},{"Type":"NodeText","Data":"肝區圈紋，有白點破洞"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 病人進步中"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同3/24 加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"滑石六錢，豬苓五錢，赤小豆五錢，柏子仁三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十二碗水煮成四碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1."},{"Type":"NodeText","Data":"患者述之前腎區會痛，查其耳穴腎區有壓痛，再查其右踝腎石點有壓痛，加上小便淡黃無血尿，故知此腎區痛乃腎結石引起的痛，若是腎臟癌則會有血尿。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"麻子仁入脾臟，柏子仁入肝臟。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"治肝病一定要會用白芍，白芍可把血酸收回肝。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}