trong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體力："},{"Type":"NodeText","Data":"好轉"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→陽氣回頭"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"平平"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"不規則"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeText","Data":"淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"無，喜溫飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"頭身："},{"Type":"NodeText","Data":"身體覺熱，無乳痛，乳頭仍凹陷"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→師曰：治到身體涼，乳頭凸出來就是好了"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"手足："},{"Type":"NodeText","Data":"雙足熱，手冷額熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生理期："},{"Type":"NodeText","Data":"正值月經期中（剛開始）"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠："},{"Type":"NodeText","Data":"不好，每小時小便一次，睡淺"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問汗："},{"Type":"NodeText","Data":"不出汗"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→心陽稍差，身熱而且無汗為陽不入陰，陰實。治到令她熱退且有汗就是好了"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩有力，一息五至"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→病情穩定"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心陰不足，陽不入陰"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 黃連二錢，黃芩三錢，白芍五錢，瓦愣子五錢，炒麥芽五錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蠣一兩，防己五錢，黃芪五錢，桂枝三錢，炙甘草五錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"烏藥五錢，細辛二錢，當歸二錢，川芎三錢，生地三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"丹皮三錢，桃仁三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前服 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 同上方300CAPS   8x3         旅行使用"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"手冷故用桂枝加炙甘草 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"牡蠣用來攻堅，以鈣攻鈣 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"現正值經期故勿用阿膠(黃連阿膠湯去阿膠)，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"如病人血不足，即使月經來亦可用阿膠，不但血不會停，反而更易入眠"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}