","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 身熱足冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 小便淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 口渴喜冰飲(白虎湯症)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 胃口好  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 體力好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 大便每日行"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"細小有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃乾"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上熱下寒("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"不當的飲食或由於幼時注射疫苗引起"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" 石膏五兩 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"病人胃口好, 代表藥是對的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") 知母五錢 炮附子三錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"石膏常與炮附子同用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") 細辛三錢 炙甘草三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮成三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗 熱藥冷服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":" 生附為陽藥用於心陽不足, 心臟衰弱時一般劑量三錢. 急救時可用至五錢. 炮附用於表虛; 收表陽. 桂附八味丸內即用炮附子, 因為下焦的陽不夠時, 此藥可以補腎. 下焦的陽源頭來自心陽, 心陽在, 但下焦較為寒濕時則用炮附子. 病人上熱下寒, 故此處用炮附子."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}