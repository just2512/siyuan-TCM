{"ID":"20240513083257-mvcyavx","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083257-mvcyavx","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083257-mvcyavx\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513131927-vdn6pmy\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513131927-vdn6pmy\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240513131927-vdn6pmy\u0026quot;,\u0026quot;focusStart\u0026quot;:319,\u0026quot;focusEnd\u0026quot;:319\u0026#125;","title":"113","type":"doc","updated":"20240514113939"},"Children":[{"ID":"20240513131927-vdn6pmy","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 964px;","id":"20240513131927-vdn6pmy","updated":"20240514113939"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：04/24/2008"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"091-2 P, PH"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"29歲 中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"04/29/2008"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"喉中異物感, 痛經, 右肋下方壓力感仍在. 病人欲降低食慾."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 體力轉好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 心情轉好("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"因心臟功能回復"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 容易入眠"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 口渴程度減少("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"因前方中有天花, 麥冬, 使其津液增加"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 喜溫飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 身體常溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 大便每日行, 較之前稀, 排氣較多."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 額熱手涼仍有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 胃口仍大"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：1、舌診："},{"Type":"NodeText","Data":"黃白濕("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"裡濕仍盛"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上熱下寒"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" 同前方 改石膏五兩(另包) ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"因病人胃口仍大, 故重用石膏至五兩以降低食慾"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"), 加黃芩三錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"仍有口渴, 以此藥去上焦熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"二付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮成三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"病人想降低食慾, 故不用白朮去濕. 仍以前方的知母去裡濕. 此次石膏加重, 若胃口仍大, 再加重劑量. 如胃口反而更大, 則考慮以”熱極生寒, 寒極生熱”之治則, 改以生附子治之."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}