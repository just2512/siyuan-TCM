yle":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→即胸脅苦滿"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"痛經於經前經後及期中發生；月經週期30-40天.　每次4-5日.　　"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 口渴喜冰冷飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 大便每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 小便淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 不易入眠"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 情緒溫和"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 月經剛結束一星期"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"弦(上焦有點寒)數有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、耳診："},{"Type":"NodeText","Data":"肝區無反應"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上熱下寒"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"石膏三兩　知母五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去上熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子四錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"熱藥，化子宮淤血"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")  白芍五錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"酸收, 止腹痛；若有靜脈曲張，須加重至一兩以上"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炙甘草五錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"壯胸陽"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去下焦寒　"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麥冬五錢　生地三錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"喉主腎以此補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉四錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"幫助腎臟利小便, 腎得以稍事休息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") 　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花三錢　升麻三錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"升提津液"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")　淮山三錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"增潤津液"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")　半夏三錢　白芷三錢("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"美白肌膚"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮成三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗 熱藥冷服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.HT-5(通乳丸) 六兩  早晚餐後各三十粒"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 病人口渴喜冰冷飲, 脈數, 舌苔淡黃, 表有熱象. 以石膏知母去其熱. 但月經遲至, 有弦脈, 提示有寒. 用炮附子, 白芍, 炙甘草去其寒以止經痛. 因桃紅四物湯只能去淤血不能去寒, 不去寒無以根治經痛. 故此處不用. 又病人無靜脈瘤, 因此白芍僅用五錢. 餘藥幫助病人消除喉中異物感. "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 美白須增潤津液。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}