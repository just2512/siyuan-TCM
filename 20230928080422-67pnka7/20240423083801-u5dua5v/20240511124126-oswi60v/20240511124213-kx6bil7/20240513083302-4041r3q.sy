tMark","TextMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"好轉， 但是夜裏會起床小便。上週白天想睡覺這周情况好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、大便："},{"Type":"NodeText","Data":"每日2次（早上）"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、小便："},{"Type":"NodeText","Data":"淡黃，有時淡清"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、口渴："},{"Type":"NodeText","Data":"會口渴，喜冰水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、手足溫度："},{"Type":"NodeText","Data":"溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、"},{"Type":"NodeText","Data":"咳嗽仍有且變壞。可平躺。吸入仍困難。"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→金不能生水故呼吸困難，只要能改善他的腎臟功能，他的吸入困難就會改善。因為吸入問題主要責之於腎。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7、"},{"Type":"NodeText","Data":"左背痛(在膀胱經上)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡黄乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："},{"Type":"NodeText","Data":"肺點有壓痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診："},{"Type":"NodeText","Data":"左腎陽不足；肝有褐點；右眼白外側有痰及血絲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"觸診："},{"Type":"NodeText","Data":"T3壓痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 肺陰實（進步中）"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： 右委中，右陰谷， 腰腿點"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→治左背痛"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同3/20之方。加 熟地三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎陰  "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→固腎陽"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"  改 桔梗一兩(加重劑量) "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"今日方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"紫參三錢，甘草三錢，桔梗一兩，半夏三錢，南星三錢，柴胡三錢，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"郁金五錢，黃芩三錢，茜草三錢，牡蠣一兩，五味子三錢，乾薑二錢，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"補骨脂三錢，炙鼈甲三錢 熟地三錢  炮附子三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：1."},{"Type":"NodeText","Data":"治肺必先治肝且要顧脾土"}]}]}]}]}