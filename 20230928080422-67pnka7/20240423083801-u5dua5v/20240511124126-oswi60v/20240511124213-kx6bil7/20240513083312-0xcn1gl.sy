TableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"有二天沒大便, 但今天又好了。(前此服單劑甘遂半夏湯後便瀉二週之後)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他 :"},{"Type":"NodeText","Data":" 咳嗽有痰鳴聲。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡紅白"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"右外眼白處(肺區)仍有些痰塊；脾區好；肝區尚可"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"紫參 四錢  炙甘草 四錢  射干 三錢  麻黃 三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"紫菀 三錢  冬花 二錢  桔梗 一兩  柴胡 三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"玉金 五錢  青皮 三錢  生薑 二片  半夏 三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"拾付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9 →3 碗   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早餐前及晚餐前各一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"針: "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右足踝不適 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右商丘透丘墟 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左解谿, 丘墟, 陽池"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"形寒飲冷則傷肺 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"治肺要守肝，把土固好(胃口)，土可以生金 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"金不能剋木時就會去生腎水，此時(金可生水)就好了"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}