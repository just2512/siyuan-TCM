{"ID":"20240513083315-5k5dkdu","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083315-5k5dkdu","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083315-5k5dkdu\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513114046-5fswvll\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513114046-5fswvll\u0026quot;,\u0026quot;scrollTop\u0026quot;:536,\u0026quot;focusId\u0026quot;:\u0026quot;20240513114046-5fswvll\u0026quot;,\u0026quot;focusStart\u0026quot;:434,\u0026quot;focusEnd\u0026quot;:434\u0026#125;","title":"095","type":"doc","updated":"20240515123504"},"Children":[{"ID":"20240513114046-5fswvll","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 1043px;","id":"20240513114046-5fswvll","updated":"20240515123504"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Properties":{"colspan":"1"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: colspan=\"1\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"079-2 L, E"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"1942年出生   瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"2008/3/11"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"回診"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"吃藥後覺得如何："},{"Type":"NodeText","Data":"仍有乾咳無痰，吸氣仍不順，其他都很好，右胸不痛，不下痢了，每日大便一次"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→紫參甘草湯發揮作用，患者原來下利一天五六次，服藥後減為一次。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡："},{"Type":"NodeText","Data":"尚好，仍頻尿。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeText","Data":"次數少。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"手足溫度："},{"Type":"NodeText","Data":"正常。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeText","Data":"手掌顏色正常。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"正常。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"濕白紅。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"觸診："},{"Type":"NodeText","Data":"壓督脈第三椎下不痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："},{"Type":"NodeText","Data":"壓右耳肺點仍痛"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→右肺仍有問題"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"頻尿，肺家陰寒實，病人進步中。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"紫參二錢 甘草二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→紫參甘草湯，用沸水泡服乃是生用，藥物生用力量強"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"14付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每日一包，加兩匙蔗糖沖熱水當茶喝"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏四錢 南星三錢 桔梗一兩"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去痰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢 玉金五錢 青皮二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→治肺先治肝，防止病再進"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生薑二片川芎三錢 白芍五錢 當歸二錢 熟地三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→四物湯，入肝順氣行血"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"乾薑二錢 五味子三錢 細辛二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→苓薑甘味辛夏湯，去肺寒，病人頻尿因此去茯苓"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"烏藥四錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→頻尿 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9—3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早餐前及晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}