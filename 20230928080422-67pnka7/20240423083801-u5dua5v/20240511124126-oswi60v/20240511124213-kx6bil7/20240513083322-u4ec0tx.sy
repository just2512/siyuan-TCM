{"ID":"20240513083322-u4ec0tx","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083322-u4ec0tx","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083322-u4ec0tx\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513113255-7ur0m1q\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513113255-7ur0m1q\u0026quot;,\u0026quot;scrollTop\u0026quot;:633,\u0026quot;focusId\u0026quot;:\u0026quot;20240513113255-7ur0m1q\u0026quot;,\u0026quot;focusStart\u0026quot;:400,\u0026quot;focusEnd\u0026quot;:400\u0026#125;","title":"088","type":"doc","updated":"20240515125519"},"Children":[{"ID":"20240513113255-7ur0m1q","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 890px;","id":"20240513113255-7ur0m1q","updated":"20240515125519"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄    初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"070-8 L, L"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"25+歲，嬌小"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080425"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服前方後，"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 值經期，此次月經延期三天，來後有一點痛(下針後好了)，約需一周才結束"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 睡眠有時淺"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便量增加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 肌肉瞤動、腸鳴仍有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 遊走性疼痛好轉中"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 有汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 雙足熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 體重上升些"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 體力好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"值經期，經延後為裡寒"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三錢  黃芩三錢  半夏三錢  玉金五錢 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→小柴胡湯，因在經期中"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白芍八錢  茜草五錢  牡丹皮三錢  炙鱉甲三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→活血化瘀與攻堅，針對左少腹硬塊（可能在卵巢上）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去下焦寒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"川芎三錢  當歸二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→和白芍，為四物湯去熟地，因熟地蓄水，故去之。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"茯苓四錢  澤瀉五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"厚朴二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→排氣"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蠣六錢  瓦楞子四錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→趁經期攻乳房堅塊"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炒麥芽五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→助排出多餘奶水 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"四付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚-飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}