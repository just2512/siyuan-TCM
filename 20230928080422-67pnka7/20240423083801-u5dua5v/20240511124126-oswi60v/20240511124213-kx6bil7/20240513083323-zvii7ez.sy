{"ID":"20240513083323-zvii7ez","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083323-zvii7ez","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083323-zvii7ez\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513113222-lim5p0n\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513113222-lim5p0n\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240513113222-lim5p0n\u0026quot;,\u0026quot;focusStart\u0026quot;:288,\u0026quot;focusEnd\u0026quot;:307\u0026#125;","title":"087","type":"doc","updated":"20240515123607"},"Children":[{"ID":"20240513113222-lim5p0n","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 801px;","id":"20240513113222-lim5p0n","updated":"20240515123607"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄    初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"070-7 L, L"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"25+歲，嬌小"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080417"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服前方後，肌肉瞤動剩一點，腹中仍有些水聲，身上游走性疼痛仍有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 小便量多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 月經下周一來，乳房開始脹痛，尤其是左邊，痛及腋下及左上臂心經處，左少腹硬塊隨月經僵滯而變大，約掌心大，無痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 氣溫下降就怕冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 口渴尚好，喜溫飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 不大流汗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡紅"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"裡寒漸出"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同4/14方 加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炒麥芽五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→退乳"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"當歸二錢  川芎二錢  熟地二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→合白芍為四物湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蠣五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→攻堅 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"四物湯加炒麥芽為去乳房硬塊之經驗用方。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}