d","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 睡尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 口渴有，喜溫熱飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 大便每日行，第一次正常，之後稀軟"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 小便量較多，淡黃色"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 手足天冷時即涼"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 晚上睡時身溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 月經下周一來"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"稍浮"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"仍有些潤動"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝五錢  茯苓五錢  白朮五錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白芍五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→酸收，增加血液回心力量，與桂枝等量調和陰陽"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生薑二片  大棗十枚 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三付  "},{"