Data":"1. 腸鳴，大便正常，一日一、二次，有時稀"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 服前方，小便量無增加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 怕冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 無汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 無噁心、胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 肌肉潤動多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 月經十天後將至"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 乳房無刺痛感"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"弦浮稍數"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝五錢  茯苓五錢  白朮五錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"豬苓三錢  澤瀉五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→利水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去水 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白芍五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→酸收，增加血液回心力量，與桂枝等量調和陰陽 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"六碗煮二碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"1. 炙甘草會蓄水，故去之。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}