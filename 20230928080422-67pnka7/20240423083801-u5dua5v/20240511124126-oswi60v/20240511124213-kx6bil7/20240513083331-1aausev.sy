strong","TextMarkTextContent":"問診：\n睡眠："},{"Type":"NodeText","Data":"不好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"不規則。色中黃。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeText","Data":"深黃，喝果汁時淡黃 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"由熱轉寒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"口渴。喜歡喝室溫的水。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體溫："},{"Type":"NodeText","Data":"雙足冷。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體力："},{"Type":"NodeText","Data":"不好。黃昏倦怠、胃脘不舒服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他："},{"Type":"NodeText","Data":"週六吃海鮮皮膚出紅疹，會癢。吃過東西之後，不會噁心，但是胃酸多。另胸骨痛。喜喝極酸的果汁"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"洪數無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n舌診："},{"Type":"NodeText","Data":"白濕、紅乾。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診："},{"Type":"NodeText","Data":"瞳孔大且對光無反應"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→腎陽不足，所以她焦慮 肝區受損"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"胃家寒症，心陽不足，腎陽不守"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"旋覆花三錢 代赭石三錢 乾薑二錢 吳茱萸三錢  炙甘草三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大棗十枚 桂枝三錢 白芍三錢細辛二錢 當歸二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"木通三錢 茯神五錢 遠志三錢 澤瀉五錢 補骨脂三錢柴胡三錢 郁金五錢三付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"師建議: 不喝咖啡、不吃人工糖或其他人工添加物。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃酸過多用旋覆代赭湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃寒用吳茱萸加亁薑"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手足冷用當歸四逆湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"腎陽不足致焦慮故用補骨脂、澤瀉、茯神、遠志補腎安神"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}