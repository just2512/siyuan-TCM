{"ID":"20240513083335-8h18gfh","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083335-8h18gfh","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083335-8h18gfh\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513112128-nj53rhp\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513112128-nj53rhp\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240513112128-nj53rhp\u0026quot;,\u0026quot;focusStart\u0026quot;:323,\u0026quot;focusEnd\u0026quot;:323\u0026#125;","title":"075","type":"doc","updated":"20240515125600"},"Children":[{"ID":"20240513112128-nj53rhp","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 884px;","id":"20240513112128-nj53rhp","updated":"20240515125600"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄    初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"060-16 L, ML"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"50歲，瘦小"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080514"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"雙側乳癌，左側已潰，移轉雙腋淋巴結腫熱痛，至今約三年多，未經西醫治療。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 大便好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 睡因肩痛(左背痠麻)不好睡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 運動後腋下及額頭出一點汗"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→心陽未復"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 身溫尚好，背熱"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→女子背為陰；病仍在少陽，進不了厥陰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 雙足晚上溫、白天涼"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 體力尚好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"目前陰陽仍在相抗中"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方:"},{"Type":"NodeText","Data":" 針同前穴"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 同5/2方 再一付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 當歸二錢  川芎三錢  白芍三錢  熟地二錢  一付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"自加生薑二片、放山雞一隻，用八碗水加二碗酒，煮成八碗"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補充體力用，勿喝過多。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左腋下腫較硬、小"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→奶水累積其中(左主血)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右腋下腫較軟、大"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→津液累積，因少動"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}