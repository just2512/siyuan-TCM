a":"br"},{"Type":"NodeText","Data":"1. 胃口尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 服前方時胃脹、不消化，有餓感"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便好，一日二次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便量增加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 手指尖仍冷、額熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 晚上有時熱、不大痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 右手臂腫消許多，”蝴蝶袖”出現了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 睡，一天好一天不好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈稍數"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、身體："},{"Type":"NodeText","Data":"下臂內側溫潤，上臂涼"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→陰陽稍和"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方:"},{"Type":"NodeText","Data":" 針同前穴"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}