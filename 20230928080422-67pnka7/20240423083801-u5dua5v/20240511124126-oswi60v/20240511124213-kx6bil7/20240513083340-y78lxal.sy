ta":"br"},{"Type":"NodeText","Data":"1. 近二日右背後痠痛、用力時才痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 體重：增加一公斤"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 睡：好些"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 大便：好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 身體：較熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 雙足：溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 胃口：好，會餓"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 小便量：差不多、色較黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 傷口：仍有膿血出、時刺痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 雙腋腫塊：有時刺痛、較軟些"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈稍數無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、身體："},{"Type":"NodeText","Data":"下臂內側溫潤，上臂涼"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→陰陽稍和"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"三焦積濕"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方:"},{"Type":"NodeText","Data":" 同前"}]}]},{"Type":"NodeTableRow","Data":"tr","