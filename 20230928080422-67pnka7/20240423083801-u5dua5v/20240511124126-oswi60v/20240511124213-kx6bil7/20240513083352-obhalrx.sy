g","TextMarkTextContent":"問診：\n前方為四物湯+"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四逆湯"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"仍在服用中\n1、大便："},{"Type":"NodeText","Data":"每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、小便："},{"Type":"NodeText","Data":"並沒有增加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、手足溫度："},{"Type":"NodeText","Data":"不太冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、汗："},{"Type":"NodeText","Data":" 沒有明顯的改善 心功能並未完全回頭"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、睡眠："},{"Type":"NodeText","Data":"沒有明顯的改善， 每到下午就很想睡"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→ 但欲寐"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6、身體寒熱："},{"Type":"NodeText","Data":"睡時身體不覺得冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7、體力："},{"Type":"NodeText","Data":"比以前好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷：少陰證"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"舌診："},{"Type":"NodeText","Data":"淡紅有牙痕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"細小無力"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→少陰證脈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1． 麻黃2，炮附子2，細辛1 脈細小無力，但欲寐，典型少陰證的麻黃附子細辛湯 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"400caps "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8x3"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三餐飯前服用"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2． 當歸2錢 川芎2錢 熟地2錢 白芍三錢 槴子2錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"加清酒燉雞湯 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每日喝3"},{"Type":"NodeText","Data":"→"},{"Type":"NodeText","Data":"5碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"(1) 服前方後心生血仍不夠→故還有貧血現象，魂魄無法歸心，睡眠雖有改善仍不理想"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"(2) 四物湯燉雞繼續補她心不生血的問題，方中加槴子 因此患者有虛熱現象，以防止服藥後太燥的現象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"(3) 舌頭有牙痕，表示此患者少腹有瘀的現象-→方中炮附子，當歸，白芍及川芎 皆有助於化瘀"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}