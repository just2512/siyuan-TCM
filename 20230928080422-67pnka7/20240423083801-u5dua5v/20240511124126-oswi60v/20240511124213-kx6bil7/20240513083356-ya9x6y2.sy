{"ID":"20240513083356-ya9x6y2","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083356-ya9x6y2","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083356-ya9x6y2\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513110409-x9wyuog\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513110409-x9wyuog\u0026quot;,\u0026quot;scrollTop\u0026quot;:486,\u0026quot;focusId\u0026quot;:\u0026quot;20240513110409-x9wyuog\u0026quot;,\u0026quot;focusStart\u0026quot;:267,\u0026quot;focusEnd\u0026quot;:267\u0026#125;","title":"057","type":"doc","updated":"20240514102032"},"Children":[{"ID":"20240513110409-x9wyuog","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 873px;","id":"20240513110409-x9wyuog","updated":"20240514102032"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"050-9 H, YT"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"體形中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"20080509"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"肺癌"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 胸痛徹背仍有,肺痛已無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 睡不好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 胃口平平"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 口渴還好,想喝冷水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 下午肚子餓"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. 呼吸正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. 咳嗽好轉,且淺又短"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 手溫,手背涼,額熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11. 晚上全身熱(這幾天天氣熱，所以覺得熱是正常的)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"右寸脈微細小"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同前(公孫 內關 天突 巨闕 關元 魚際 中脘 章門 左行間 左俠谿 右太陽透率谷 厥陰俞 心俞 肝俞)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"加耳針心點"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"見病人有心痛徹背,背痛徹心時,應針後即止.若不止者,須注意有其他問題存在"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}