{"ID":"20240513083357-rp8gp9q","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083357-rp8gp9q","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083357-rp8gp9q\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513110323-zmm50s7\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513110323-zmm50s7\u0026quot;,\u0026quot;scrollTop\u0026quot;:876,\u0026quot;focusId\u0026quot;:\u0026quot;20240513110323-zmm50s7\u0026quot;,\u0026quot;focusStart\u0026quot;:487,\u0026quot;focusEnd\u0026quot;:487\u0026#125;","title":"056","type":"doc","updated":"20240515124044"},"Children":[{"ID":"20240513110323-zmm50s7","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 784px;","id":"20240513110323-zmm50s7","updated":"20240515124044"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/04/25"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"050-8 H, YT"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"體形中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"20080508"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"肺癌"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 胸痛是持續的"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→影響睡眠"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 晚上最痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 月經4/22來的(3-5天經期)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 胃口平平"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 大便每日行,一日一次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 睡時全身熱,足亦熱"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈已不附骨,但陰實仍有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡白紅T4、T5有壓痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"病人進步中,以後出現"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(1)睡好,可通宵"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(2)上寒下熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(3)無胸痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"(4)頭髮變好 就好了"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" 公孫 內關 天突 巨闕 關元 魚際 中脘 章門"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左行間 左俠谿 右太陽透率谷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"厥陰俞 心俞 肝俞"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.同5/5方不加紫參,去白芍 龍骨 牡蠣不用 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"伍付帶回台灣 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9-3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"bf B/S"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.HT-32烏金丸 2罐6兩"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"30x2  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"bf L/Bed"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3.HT-25治三叉神經痛頭痛 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2罐6兩       "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"30x2  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"After B\u0026S 30x2 af B/S"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4.紫參 半斤    包  備用"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.病人明天回台灣,讓病人帶藥回去繼續服用"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.方中加紫參攻之,病人出現胸腔痛"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→紫參有類似顯影劑的作用,讓肺癌現形"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3.叮囑病人持續運動幫助汗出"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→心主五液→強心→把心藏治好才能去病根"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}