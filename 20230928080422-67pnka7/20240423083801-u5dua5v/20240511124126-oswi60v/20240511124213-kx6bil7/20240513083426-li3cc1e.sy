{"ID":"20240513083426-li3cc1e","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083426-li3cc1e","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083426-li3cc1e\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513104144-qbikdlj\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240514093637-w56cgu0\u0026quot;,\u0026quot;scrollTop\u0026quot;:300,\u0026quot;focusId\u0026quot;:\u0026quot;20240513104144-qbikdlj\u0026quot;,\u0026quot;focusStart\u0026quot;:394,\u0026quot;focusEnd\u0026quot;:394\u0026#125;","title":"031","type":"doc","updated":"20240515124352"},"Children":[{"ID":"20240513104144-qbikdlj","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 968px;","id":"20240513104144-qbikdlj","updated":"20240515124352"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄   初診日期：20080313"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"014-10 C, M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"37歲，中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080428"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服前方後，"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"想吃但不餓，胃口不好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"骨關節痛已無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 大便每日一行，未盡感，須久坐才可出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 小便量少、尿意多、頻尿；色淡，多時黃色"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→寒去熱回，藥到了"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 雙足仍冷，足底仍冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 眼仍有乾澀"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 口渴有，想喝涼水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"風吹肚易痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"惡風"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10. 手出虛汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11. 飯後(尤其晚餐後)少腹易脹"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"12. 掌色淡黃"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→此為血的本色，血不足；指甲床為粉紅→血虛不嚴重"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"13. 吃素六年"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→素食均為甘淡滲利屬陽，肉屬陰，所以陽氣夠，但陰不足"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診：脈小無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"脾陽不足，陰虛，裡寒出"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝三錢  白芍六錢  炙甘草三錢  大棗十枚  生薑二片"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→小建中湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"烏藥四錢  細辛二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→治頻尿"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"厚朴二錢  代赭石二錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→降氣 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各服一碗  服時加麥芽糖二茶匙"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]},{"ID":"20240514093637-w56cgu0","Type":"NodeParagraph","Properties":{"id":"20240514093637-w56cgu0"}}]}