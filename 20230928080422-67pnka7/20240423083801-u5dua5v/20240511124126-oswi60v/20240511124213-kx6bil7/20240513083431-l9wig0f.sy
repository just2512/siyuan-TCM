{"ID":"20240513083431-l9wig0f","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083431-l9wig0f","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083431-l9wig0f\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513103706-r0t3eg3\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513103706-r0t3eg3\u0026quot;,\u0026quot;scrollTop\u0026quot;:100,\u0026quot;focusId\u0026quot;:\u0026quot;20240513103706-r0t3eg3\u0026quot;,\u0026quot;focusStart\u0026quot;:172,\u0026quot;focusEnd\u0026quot;:172\u0026#125;","title":"025","type":"doc","updated":"20240515124539"},"Children":[{"ID":"20240513103706-r0t3eg3","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 795px;","id":"20240513103706-r0t3eg3","updated":"20240515124539"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄   初診日期：20080313"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"014-04 C, M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"37歲，中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"20080402"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服前方後，前兩天全身微濕黏(clammy)；有濕氣時，關節仍痛，濕氣退即好"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→關節之濕排出"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 仍怕風"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 月經應04/05來(以前來之前會覺得特別冷)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 手足有時仍很冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 睡不好，因消化不好，腹脹"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→+吳茱萸、乾薑"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 大便有未盡感"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 小便量少、次數多、色白、未盡感"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→腎著湯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 口渴有，喜飲室溫水，口唇乾"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"稍浮，重按無力，肌膚濕潤"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃厚"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→仍有濕熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"裡寒仍有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：當歸四逆湯加吳茱萸乾薑、腎著湯、甘草附子湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"吳茱萸三錢  乾薑二錢  桂枝五錢  白芍五錢  炙甘草三錢  木通三錢  當歸三錢  細辛二錢  大棗十枚"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白朮三錢  茯苓五錢  豬苓三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去濕，使濕由小便出"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"澤瀉五錢  補骨脂三錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子五錢"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→去寒 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各服一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}