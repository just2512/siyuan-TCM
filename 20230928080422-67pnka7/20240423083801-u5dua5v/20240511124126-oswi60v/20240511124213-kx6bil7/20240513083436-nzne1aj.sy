{"ID":"20240513083436-nzne1aj","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083436-nzne1aj","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083436-nzne1aj\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513103234-reciwrk\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513103234-reciwrk\u0026quot;,\u0026quot;scrollTop\u0026quot;:300,\u0026quot;focusId\u0026quot;:\u0026quot;20240513103234-reciwrk\u0026quot;,\u0026quot;focusStart\u0026quot;:425,\u0026quot;focusEnd\u0026quot;:425\u0026#125;","title":"021","type":"doc","updated":"20240515124649"},"Children":[{"ID":"20240513103234-reciwrk","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 886px;","id":"20240513103234-reciwrk","updated":"20240515124649"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"008-5 B, S"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"05/16/2008"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服前方後"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1、 睡有時醒,因更年期身熱 (病人時常睡前進食,"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"宜戒之,虛比實好"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":") "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、 身熱. (但更年期潮熱已退許多)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3、 大便有時一日兩次, 有時又無.(上方含大黃五錢)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4、 胃口好, 味覺好."},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5、 小便深黃 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"仍有宿便"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6、 口渴尚好 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"時忘記飲水,表流汗少"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7、 雙足熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8、 體力好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9、 下背時緊"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"10、 左乳頭下之硬塊縮小"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"11、 近日排氣不多"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"尺脈沉有力 ("},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"仍有宿便"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃濕有裂痕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeText","Data":"腎陽已動"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 仍有宿食在大腸中"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同3/10方 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"加敗龜板三錢 補骨脂三錢 (病人喜勞力工作,常腰痠背痛此為腎虛"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→ 補腎"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":")"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大黃五錢 澤瀉五錢 玉金三錢 梔子三錢 厚朴二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十二碗煮成四碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便深黃亦可見於勞力工作較多的人,因出汗多(汗尿同源)故致之。需分別其與宿便之差異。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"她晚上會忘記喝水，代表他沒有流太多汗，津液未喪失故不口渴，此時他小便黃是內有宿便。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}