":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 無原因易憂鬱傷心5. 喝奶類會指節痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 睡不好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. 不易汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3. 身多熱(更年期)，但無汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"4. 大便每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5. 雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"6. 睡時感身熱或冷：感身熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"7. 左乳頭周圍硬塊約5X5cm，表面光滑"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"左脈小，右脈大"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→女子應左脈大於右，因左主血右主氣"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"血虛，溫經湯證"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"吳茱萸三錢  當歸二錢  川芎三錢  白芍三錢  熟地二錢  阿膠三錢(分三包烊盡)  黃芩三錢  黃柏二錢  酸棗仁三錢  防己五錢  牡蠣一兩  瓦楞子五錢  桂枝三錢  炙甘草三錢  炒麥芽五錢  小麥五錢  大棗十枚 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1."},{"Type":"NodeText","Data":"方中含四物湯與炒麥芽，可使奶水往下而不會累積于乳房 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"牡蠣與瓦楞子味鹹可軟堅散結，治療乳房內結塊 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"甘麥大棗湯治療她無原因憂鬱傷心"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]},{"ID":"20240513101615-ij5ghvx","Type":"NodeParagraph","Properties":{"id":"20240513101615-ij5ghvx"}},{"ID":"20240513101616-v8o6za6","Type":"NodeParagraph","Properties":{"id":"20240513101616-v8o6za6"}},{"ID":"20240513101618-h18duo8","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 881px;","id":"20240513101618-h18duo8","updated":"20240515125858"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"倪醫師病案紀錄    初診日期：2008/03/10"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"Brown, Sandra"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextC