"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"有吃甜食嗎?"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"答：「長期沒有吃甜食」"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡時身熱多汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"感覺體力差,記憶不佳。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴尚好，喜溫飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便正常"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"虛緩無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕裂痕"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"胃家微寒"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"溫經湯粉"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"5加半夏1 粉劑 100克 三餐前 三茶匙"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1. 此女沒有嘔酸且長期沒吃甜食，故非旋覆代赭證。她"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"會噁心是因為停經後奶水無法進入子宮，若停聚中焦造成嘔"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"，溫經湯常用於更年期女性。子宮有血塊，造成心熱反逆的現象，方中吳茱萸亦可止嘔。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2. "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"吳茱萸可暖肝"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeText","Data":"，肝經絡過子宮(生殖器)故吳茱萸可溫暖子宮。另外肝有問題引起的噁心嘔吐都會用到吳茱萸。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}