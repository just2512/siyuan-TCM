{"ID":"20240513083445-0m4b2o8","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240513083445-0m4b2o8","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240513083445-0m4b2o8\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240513101138-dadj5cw\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240513101138-dadj5cw\u0026quot;,\u0026quot;scrollTop\u0026quot;:145,\u0026quot;focusId\u0026quot;:\u0026quot;20240513101138-dadj5cw\u0026quot;,\u0026quot;focusStart\u0026quot;:421,\u0026quot;focusEnd\u0026quot;:421\u0026#125;","title":"014","type":"doc","updated":"20240514090710"},"Children":[{"ID":"20240513101138-dadj5cw","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 1062px;","id":"20240513101138-dadj5cw","updated":"20240514090710"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":"      初診日期：2008/03/21"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"003-3 B, YR"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別"},{"Type":"NodeText","Data":"F"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"1936"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期"},{"Type":"NodeText","Data":"2008/04/03"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服前方後回診。右膝打太極拳時某一動作才會痛，平常走路上下樓梯都不痛。"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"→ 二選一，1.不打打極拳 2.痛打到不痛。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診\n手足溫度："},{"Type":"NodeText","Data":"手足溫。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胃口："},{"Type":"NodeText","Data":"飯後仍逆氣。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便："},{"Type":"NodeText","Data":"尿急仍有。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"睡眠："},{"Type":"NodeText","Data":"改善。(因為清肝)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問汗："},{"Type":"NodeText","Data":"右側臉仍無汗出，右額上方有潮濕感。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"口渴："},{"Type":"NodeText","Data":"無。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"頭身："},{"Type":"NodeText","Data":"睡時常溫。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"疼痛："},{"Type":"NodeText","Data":"右膝仍痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大便："},{"Type":"NodeText","Data":"近來不盡出。肚子不痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小便顏色："},{"Type":"NodeText","Data":"淡黃色。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"喝水："},{"Type":"NodeText","Data":"溫飲。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"體力："},{"Type":"NodeText","Data":"好轉中。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他："},{"Type":"NodeText","Data":"腰背痛好轉。自訴聽到水聲則想要小便(同氣相求)。(師問：肌肉是否有跳動。答：否。師曰：用半夏即可。)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈沉有力。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"中焦有寒水。(在心與小腸之間)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"旋覆花三 代赭石三 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"半夏三 乾薑二(半夏去水、乾薑去寒)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡三 鬱金五 黃芩三 龍膽草三"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"枳實三 大黃二"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三七三 續斷三"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝四 白芍四 炙甘草三 大棗十枚 生薑二 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"四百粉量 三餐飯前三茶匙"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}