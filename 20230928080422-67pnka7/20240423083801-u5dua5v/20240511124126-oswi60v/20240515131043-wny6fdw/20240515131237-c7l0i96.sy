}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：常在凌晨2:30醒，能很快回睡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"晚上睡时温度很好，無特殊寒熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"二便：大便每日一、二次，小便淡黄"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口：还好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：稍有一点口渴"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"双足：温"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"体力：好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脉稍洪大，一息6-7至"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黄红"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1."},{"Type":"NodeText","Data":"桔梗5 炙甘草2  补骨脂3  续断3   炒麦芽3当归3  川芎3  金铃子3   延胡索3  熟地2"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡3  玉金3  黄芩3    党参3  生姜3炮附子4 桂枝3   白芍6   茯苓3  海藻5"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蛎5  枳实3   代赭石3   旋覆花3  泽泻6 猪苓3 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"800粒 每服8粒，三餐前服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"汉唐60号六两  每服8粒，三餐前服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"解說：  汉唐60号→收敛静脉。"}]}]}]}]}