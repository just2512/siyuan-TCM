Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：睡觉好，一觉到天亮"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"二便：大便时有时秘，小便淡黄"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"食欲：胃口还好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：口渴尚好，有时要冰有时不要"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"汗：  有时有汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手足温度：足冰冷的，手凉额热"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"肌肉：有时肌肉酸痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脉稍数、一息六至"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黄湿"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 下焦寒、阳热反逆上头"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麦冬2  党参2 细辛1 乌药3 炮附子2 白芍3  栀子1 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麻子仁1  桂枝1. 5   白术1   炙甘草 1 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"200 粉  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"三餐前一茶匙"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手凉额热、足冰冷的→下焦寒、阳热反逆上头"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便时有时秘→小肠冷，以“细辛 乌药 炮附子”升小肠温度 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"肺主静藏魄，主忧。肺燥则人燥动，在小儿则多动，以“麦冬 党参”润肺"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝、白芍→调和营卫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝、白术→行阳利中焦湿"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"栀子→清虚热"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麻子仁→润肠通便"},{"Type":"NodeBr","Data":"br"}]}]}]}]}