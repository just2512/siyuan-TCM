{"ID":"20240515131352-b6gdz8y","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131352-b6gdz8y","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131352-b6gdz8y\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515142601-x96fe42\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515142601-x96fe42\u0026quot;,\u0026quot;scrollTop\u0026quot;:728,\u0026quot;focusId\u0026quot;:\u0026quot;20240515142601-x96fe42\u0026quot;,\u0026quot;focusStart\u0026quot;:525,\u0026quot;focusEnd\u0026quot;:525\u0026#125;","title":"094","type":"doc","updated":"20240515182019"},"Children":[{"ID":"20240515142601-x96fe42","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 758px;","id":"20240515142601-x96fe42","updated":"20240515182019"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/08/28"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"OM"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"49歲, 中等身材"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/28"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"去年10月至今洗腎。之前有冒眩及倦怠。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口： 好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便：不正常，隔日一行。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便：淡白。小便便意不強，力量還好。一天4次。量不好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：尚好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙踝腫。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"身冷多。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"出汗：有一點汗，很少出汗。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足溫度：雙足冷。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"月事：4年前更年期已過。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：睡尚好。洗腎前一天無法睡。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"血壓：平均190/110。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"有心悸。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈洪大有力，中空→芤脈，心真臟脈。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"白厚濕。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"血虛，腎衰竭。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生附子三錢 乾薑二錢 炙甘草三錢 桂枝五錢 白朮五錢 茯苓五錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"豬苓三錢 澤瀉五錢當歸二錢 木通三錢 細辛二錢 烏藥四錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"補骨脂三錢 巴戟天三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗 →3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各服 1碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1"},{"Type":"NodeText","Data":"生附子 乾薑 炙甘草 → 壯心陽。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"桂枝 炙甘草 → 心動悸。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"細辛 烏藥 → 下焦寒，尿意不強。尿意更弱則加炮附子。細辛加烏藥可治頻尿與小便不利"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"桂枝 白朮 茯苓 豬苓 澤瀉 → 五苓散 → 利尿"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5"},{"Type":"NodeText","Data":"倪師欲開四逆湯但方中有炙甘草，可是患者有水腫，因此用不用炙甘草曾一度斟酌，於是問患者有無心悸，患者答有，於是倪師決定保留炙甘草。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6"},{"Type":"NodeText","Data":" 補骨脂 巴戟天 → 補腎陽。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}