xtMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":"  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口: 差，无食欲，时有恶心"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便：每日行，色黑"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便：黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：有"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手足凉"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脉弦数"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黄白，边见牙痕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 胃穿孔出血（口服抗生素所致），淋病"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：\n黃土湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"熟地二钱 黄芩三钱 白术三钱 阿胶三钱（分三包烊盡）炙甘草三钱 灶心土五钱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子三钱 滑石六钱 泽泻三钱 黄柏三钱 乌药五钱 龙骨五钱 牡蛎八钱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"土茯苓四钱 大黄二钱 陈皮二钱 厚朴二钱 草果三钱 赤小豆四钱 当归二钱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"槐花三钱 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"拾伍付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9-3碗，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每日早晚餐前服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1"},{"Type":"NodeText","Data":" 阿胶、炮附子→固阳止血，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":" 熟地、白术→健睥，补血"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3"},{"Type":"NodeText","Data":" 灶心土→补胃穿孔出血处"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4"},{"Type":"NodeText","Data":" 大黄、黄芩、黄柏、土茯苓、泽泻、滑石→清利下焦湿热，土茯苓为治淋病要药"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5"},{"Type":"NodeText","Data":" 龙骨、牡蛎→潜阳涩精，止遗精"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6"},{"Type":"NodeText","Data":" 草果、陈皮、厚朴→開胃助消化，草果善化肉食"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7"},{"Type":"NodeText","Data":" 赤小豆、当归、槐花→疗痔疮"},{"Type":"NodeBr","Data":"br"}]}]}]}]}