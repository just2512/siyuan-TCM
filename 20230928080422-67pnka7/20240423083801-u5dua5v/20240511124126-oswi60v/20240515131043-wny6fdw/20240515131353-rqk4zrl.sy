Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴尚好，喜溫飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"嗜甜食"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足冷"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈稍數無力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診：\n2、眼診 : "},{"Type":"NodeText","Data":"瞳孔對光反應差→腎陽不足"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上熱下寒，腎陽不足"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方：  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"石膏五兩  知母五錢  防己三錢  茯苓三錢  澤瀉四錢 炮附子三錢  細辛二錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連二前  黃芩三錢  補骨脂三錢 敗龜板二錢  生地二錢 熱藥冷服  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5 帖   "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗水煮成3 碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各喝一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"."},{"Type":"NodeText","Data":"此人腎陽不足故他體力差 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.補骨脂偏於補腎陰。若患者精神尚可則用補骨脂及熟地即可。若體力不好，腎很差了就要用敗龜板、炮附子、補骨脂。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"3.菟絲子、覆盆子用於補腎精、男人的精子。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}