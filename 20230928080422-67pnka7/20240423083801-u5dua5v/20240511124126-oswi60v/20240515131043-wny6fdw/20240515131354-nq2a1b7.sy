:"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１大便三四次一天。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２有二次看到一點血，混在大便中。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３雙足溫（不覺冷） "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４喜冷飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５睡時身冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６小便淡黃到中黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７睡皆好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"８直腸沒有痛感，也沒有灼燒感"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"９掌冷額溫"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"尺脈浮有力，附骨"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"舌淡紅，濕，舌體大"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"病人尺脈仍數有力，為裡熱仍有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同前方，去麻子仁不用，400 caps　8x3　三餐飯前服用"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１原方有效則效不更方，藥太苦故改成膠囊，大便次數過多故去掉麻子仁。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２腸癌位在降結腸者，開刀後易轉移成為肝癌。位在直腸肛門位者者，開刀後易轉移到肺癌。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]},{"ID":"20240515142411-ffa8mr3","Type":"NodeParagraph","Properties":{"id":"20240515142411-ffa8mr3"}}]}