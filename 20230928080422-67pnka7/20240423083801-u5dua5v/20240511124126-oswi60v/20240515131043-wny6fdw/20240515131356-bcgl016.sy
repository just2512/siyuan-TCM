e":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"無頭昏噁心了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"皮膚不癢了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"更年期身熱退了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便不規則，時利"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便意強量好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"身體溫熱許多"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"細"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"舌苔白濕，略帶淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeText","Data":" 腎陽反應尚好，肝區仍有破洞"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"裡寒仍有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同8/7處方 再4付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"8/7處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生附子三錢，乾薑二錢，炙甘草三錢，澤瀉六錢，豬苓三錢，茯苓五錢，當歸三錢，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝五錢，白朮五錢，半夏三錢，吳茱萸二錢，側柏葉四錢，炮附子四錢，生薑二錢，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"川芎三錢，丹皮三錢，柴胡三錢，鬱金三錢"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"治腎臟病的關鍵是在治心（水剋火）。四逆湯就是治心陽的處方。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}