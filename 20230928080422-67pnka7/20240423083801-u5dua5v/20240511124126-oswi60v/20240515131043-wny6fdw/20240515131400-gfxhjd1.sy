{"ID":"20240515131400-gfxhjd1","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131400-gfxhjd1","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131400-gfxhjd1\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515141814-6jvdxgr\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515141814-6jvdxgr\u0026quot;,\u0026quot;scrollTop\u0026quot;:450,\u0026quot;focusId\u0026quot;:\u0026quot;20240515141814-6jvdxgr\u0026quot;,\u0026quot;focusStart\u0026quot;:471,\u0026quot;focusEnd\u0026quot;:471\u0026#125;","title":"081","type":"doc","updated":"20240515172618"},"Children":[{"ID":"20240515141814-6jvdxgr","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 808px;","id":"20240515141814-6jvdxgr","updated":"20240515172618"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"LY"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"37岁 瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/21傳真回診"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服前药后"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左头及左颈肩背酸痛，手指节、脚指节不时地隐隐胀痛，后脚跟疼痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手臂疼痛，自觉是骨头痛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胸口有时闷闷的"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡时会严重地磨牙，咬得很紧"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"时有口臭"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"舌头不时觉得燥、干"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"月经昨天（第5天）结束，断得很干净，月经时没有什么血块，以前经期都是25~27天，流产后，现在都是28天。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：很不好，没有睡意，很难入睡，睡时很短"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"排便：每日一、二次，有时成形，有时散状，一两次有腹痛，色黄"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"排尿：每天约7~8次，色淡黄。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口：还好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：喜欢温热饮料"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"双手足：手冷有好转，仍手冷额温，手掌色淡红；足趾冷，足底温度适中。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"体力：一直很疲劳"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"不詳"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"自述淡黄白"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝 五钱 白术 五钱 炮附子 三钱 炙甘草 三钱 补骨脂 三钱 巴戟天 三钱泽泻 三钱 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"熟地 二钱  细辛 二钱  乌药 三钱  枳实 三钱  厚朴 二钱党参 二钱 栀子 三钱 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"酸枣仁 三钱  知母 三钱  茯苓 三钱  川芎 三钱當歸 三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"拾付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9—3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前服"},{"Type":"NodeBr","Data":"br"}]}]}]}]}