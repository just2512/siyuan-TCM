"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"仍有兩碗藥未服，望診臥蠶明顯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡覺每兩小時醒，11:30 , 2:00 , 4:00 , 5:30 醒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"晚上上半身溫熱，膝以下自覺冷，手一直是冷的"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口一直渴，喜冰飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"體力好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便一天2~3次，質硬"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便淡白清"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"不易出汗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈浮稍數，重按即無"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃濕 望其手上脈(青筋)已有縮小"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心陽不足，心包積濕，脾陽不振，無陰實之證"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同 2008年8月7日方加生附子二錢(另包)  乾薑二錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"天花三錢  熟地二錢  黃連二錢  厚朴三錢 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"5帖  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗水煮成3碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各喝一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.病人一直瘦下去，照理說寒證才會瘦，可他又喜冰飲，所以喜冰飲是假象 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.照理說舌苔黃應該用生地，但他下焦寒故用熟地。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}