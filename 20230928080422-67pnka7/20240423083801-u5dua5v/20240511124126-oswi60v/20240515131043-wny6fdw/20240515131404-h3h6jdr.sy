{"ID":"20240515131404-h3h6jdr","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131404-h3h6jdr","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131404-h3h6jdr\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515141437-a4nmy5s\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515141437-a4nmy5s\u0026quot;,\u0026quot;scrollTop\u0026quot;:20,\u0026quot;focusId\u0026quot;:\u0026quot;20240515141437-a4nmy5s\u0026quot;,\u0026quot;focusStart\u0026quot;:509,\u0026quot;focusEnd\u0026quot;:509\u0026#125;","title":"073","type":"doc","updated":"20240515171822"},"Children":[{"ID":"20240515141437-a4nmy5s","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 830px;","id":"20240515141437-a4nmy5s","updated":"20240515171822"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/08/12"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"LQ"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"年約40，中等身材略瘦"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/15"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"初診主訴頭風、左邊額頭上方有一腫塊，以及皮疹搔癢。二診諸證皆改善。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":"病人諸證皆有改善。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈浮洪"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeText","Data":"左額上之脂肪瘤明顯消退"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："},{"Type":"NodeText","Data":"無"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 頭風、濕在皮下、脂肪瘤"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方：(同初診)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左額上腫塊報刺、百會、右合谷、右外關、左頭臨泣、左太陽透率谷、右俠谿、"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左右委中、左右陰谷、左腿膕中稍下方腰痛點(阿是穴)，左右腎俞"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： (同初診方)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"麻黃二錢、杏仁二錢、薏苡仁三錢、炙甘草三錢、連翹二錢、川芎二錢、"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"白附子二錢、僵蠶二錢、勾陳二錢、秦艽二錢、杜仲二錢、荊芥二錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"七付，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每付六碗煮二碗，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1"},{"Type":"NodeText","Data":"皮疹是皮下有濕，外乾內濕用麻杏薏甘湯。如果病人不出汗加桂枝，能出汗用荊芥即可。會癢可加連翹、銀花。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"秦艽除督脈痛、杜仲除腰痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"額頭上的腫塊，如果低頭會變大就是血管瘤，不可報刺。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"膕中相當於腰，承山相當於魄(肛)門，可於此兩者之間找相對應之壓痛點，即阿是穴。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5"},{"Type":"NodeText","Data":"頭臨泣專治眼珠後的痛(痛連目睛)，也可治膽經上的頭痛、"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6"},{"Type":"NodeText","Data":"川芎、白附子、僵蠶、勾陳皆治頭痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"7"},{"Type":"NodeText","Data":"白附子專治風吹就痛的頭痛。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"8"},{"Type":"NodeText","Data":"脈浮洪是夏逢夏脈，正常。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}