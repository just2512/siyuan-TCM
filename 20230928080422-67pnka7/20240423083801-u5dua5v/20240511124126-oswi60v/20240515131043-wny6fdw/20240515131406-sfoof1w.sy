ong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口上升，喜飯麵等碳水化合物。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"喝水多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"直立走的很好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手溫額溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"體力、肌肉皆好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"喜光亮環境→陽回之現象"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"現在對很多事物都感興趣"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診："},{"Type":"NodeText","Data":"她現在對人的呼叫比較有反應了，且有點可以溝通了。她直立走路走的比上次又更好了。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 病人進步中，再用前方即可"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同8/11方 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"再十付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗，"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每天早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"解說： 今天她父親帶她來，問說她都沒有流汗。師云繼續吃前方，可吃到流出汗來。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}