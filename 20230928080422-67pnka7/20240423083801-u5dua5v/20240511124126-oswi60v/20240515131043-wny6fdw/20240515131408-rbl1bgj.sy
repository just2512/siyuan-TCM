TextMarkType":"strong","TextMarkTextContent":"問診：\n1、睡眠："},{"Type":"NodeText","Data":"不好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、胃口："},{"Type":"NodeText","Data":"時好時壞"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、大便："},{"Type":"NodeText","Data":"一天一次"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4、口渴："},{"Type":"NodeText","Data":"口渴喜室溫飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5、其他："},{"Type":"NodeText","Data":"胃酸逆流好了。體重降了一點點。Hot flashes基本沒了。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"心脈小，胃脈大→胃下垂之脈"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃白"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"裡熱仍有，經熱與腑熱皆有"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"石膏 五兩，知母 五錢，生甘草 三錢→白虎湯，去陽明經熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"柴胡 三錢，黃芩 三錢，龍膽草 三錢，鬱金 五錢，茵陳 三錢→清肝解毒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"黃連 二錢，阿膠 三錢，白芍 五錢→黃連阿膠湯，補心血"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"連翹 三錢，銀花 二錢→質輕，走上走表，清皮表風熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9→3碗，早晚餐前加生蛋黃一只溫服一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"HT-85敷臉方 6兩 外敷，和蛋清混合"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"1.心脈大者不易入眠 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2.女性生殖器官有疾病或裝避孕器常會在臉上陽明經處出現斑點"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}