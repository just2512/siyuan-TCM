{"ID":"20240515131410-f4fjrkk","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131410-f4fjrkk","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131410-f4fjrkk\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515140937-i14zuk5\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515140937-i14zuk5\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240515140937-i14zuk5\u0026quot;,\u0026quot;focusStart\u0026quot;:83,\u0026quot;focusEnd\u0026quot;:83\u0026#125;","title":"064","type":"doc","updated":"20240515140937"},"Children":[{"ID":"20240515140937-i14zuk5","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 621px;","id":"20240515140937-i14zuk5","updated":"20240515140937"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/04/1"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"LJ"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"F"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"16歲，略矮，中等身材"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/22"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"服藥之後仍無汗出。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"（1）服藥之後仍沒有心悸。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"（2）但不易入眠。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"可用消導劑從下治。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五苓散 400 caps，三餐前每服八粒。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"病患服藥後仍無明顯汗出，手掌及足部仍有熱感（本次就診膚色較不若前次絳紅），倪師認為病患已有不易入眠的症狀，此乃麻黃劑量較大、發陽所致。若再加大劑量發表，恐睡眠狀況會更差，經詢問病患，病患不願睡眠差，故倪師改變引邪外出之途徑，以五苓散將表濕從皮下排出。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}