strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"抽腹水之後，小便出500cc，大便出成形"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴有，喝室溫水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"身體內是熱的，全身熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口好，會餓"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"呼吸短氣，一點咳嗽"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"稍洪數，一息六至"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"黃厚乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 仍以健脾為主要方，利濕"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" 因昨天抽腹水，身體虛，不下針"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n1"},{"Type":"NodeText","Data":"補氣治濕湯+生硫磺三錢(另包)  十二付 六碗水煮成兩碗 早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"胃苓湯  400粉  午餐前、睡前各二茶匙"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":" 此人因有開刀、化療過，師認為因身體結構被破壞而會讓中醫下手時產生盲點，故之前有說若腹水嚴重可去抽水，但一定要完全用中藥調理"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}