[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診： \n1、舌診：\n2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷：表受風邪，汗未出盡。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方： 皮癢五針：血海、三陰交、築賓、曲池、合谷。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方：  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong strong","TextMarkTextContent":"桂枝三錢 白芍三錢 麻黃三錢 杏仁三錢 薏苡仁四錢 生薑三片"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大棗十枚 炙甘草三錢 連翹三錢 銀花二錢 荊芥三錢"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n沿用麻杏薏甘湯，加桂枝湯固脾胃以堅固汗水之源，並加連翹、銀花、荊芥等發表。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註：須翌日再針"}]}]}]}]}