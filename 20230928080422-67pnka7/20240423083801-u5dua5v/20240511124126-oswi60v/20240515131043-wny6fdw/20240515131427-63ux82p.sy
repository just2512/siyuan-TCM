{"ID":"20240515131427-63ux82p","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131427-63ux82p","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131427-63ux82p\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515134510-aznb1ix\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515134510-aznb1ix\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240515134510-aznb1ix\u0026quot;,\u0026quot;focusStart\u0026quot;:347,\u0026quot;focusEnd\u0026quot;:349\u0026#125;","title":"040","type":"doc","updated":"20240515155321"},"Children":[{"ID":"20240515134510-aznb1ix","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 847px;","id":"20240515134510-aznb1ix","updated":"20240515155321"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"ED"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"30+, 非常肥胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/22"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"減肥, 少了45磅。77度的室溫, 覺得很舒適。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：很好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便：時隔日, 因吃不多了。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：有, 喜嚼冰塊。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便 : 淡白。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"身溫：全身都冷, 時又熱。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"月事：服藥後, 月經即止。不吃, 月經直來不停。每次來9天, 停11天。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈浮, 一點數。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃濕。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 上焦仍有餘熱。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n1."},{"Type":"NodeText","Data":" 膠艾湯 8 乾薑 1     ２００粒 (月經不止時才服) 8X3三餐飯前服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":" 白虎湯４黃連１黃芩１黃柏１大黃１  400粒 8X3三餐飯前服"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n1"},{"Type":"NodeText","Data":"膠艾湯 乾薑 → 月經惡漏不止。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"白虎湯 四黃 → 瀉上焦餘熱。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3 "},{"Type":"NodeText","Data":"此人身上聚集有很多陳舊的奶水。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4 "},{"Type":"NodeText","Data":"此人先前就是無時無刻都覺得很熱，倪師予以大劑白虎湯，石膏最高用至一斤仍覺得很熱，之後倪師依熱極生寒之理改予生附子，此人服後就覺得身體冷下來了。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}