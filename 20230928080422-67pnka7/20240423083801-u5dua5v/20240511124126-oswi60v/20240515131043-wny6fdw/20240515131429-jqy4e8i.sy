{"Type":"NodeText","Data":"右眼靜脈血管問題，服用baby aspirin。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２大便很好，小便淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３口渴無"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６有汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７身溫無異常，偶而身熱一下"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"８體力好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"９手冷額熱"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"關寸上焦脈洪大，有力，重按仍有，附骨脈"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"舌淡黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"上焦乳房陰實（癌症復發），真寒徦熱。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炒麥芽五錢　當歸二錢　川芎三錢　白芍五錢　熟地二錢　龍骨五錢　牡蠣一兩　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"陽起石三錢　桂枝五錢　炙甘草五錢　生硫磺二錢另包　茜草三錢　辛夷三錢　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"菖蒲三錢　知母五錢　赤小豆三錢　炮附子五錢　白朮三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"貳付　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗水　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生硫磺走三焦。知母和赤小豆去濕。炮附子合白朮為排膿湯。掌冷額熱為陽不入陰。Aspirin可用川芎等活血化瘀藥取代。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："},{"Type":"NodeText","Data":"下週二回診"}]}]}]}]}