"TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便：一日2、3次，稀"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口：過好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：尚可"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足較冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"易出汗，運動後汗出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"近來大便軟，腸鳴多，易流鼻水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"上身熱、下身冷月經正常來，3天即止"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃(微熱)乾(燥)"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 : "},{"Type":"NodeText","Data":"左眼腎區反應不佳、肝區有圈紋(脂肪肝)及破洞"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 肝積肥氣、左腎陽不足、燥熱、上熱下寒"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： 肉瘤處用「暴刺法」"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n1"},{"Type":"NodeText","Data":"柴胡三錢 玉金三錢 黃芩三錢 側柏葉四錢 當歸二錢 首烏三錢 石膏二兩知母五錢 炮附子三錢 炙甘草三錢 大棗十枚 蒼朮五錢 辛夷二錢 菖蒲三錢黃柏三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗，每天早晚飯前各一碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"熱藥冷服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":" HT-31澤蘭丸(欲減肥)  2罐6兩  30x2 早晚飯後各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說： \n1"},{"Type":"NodeText","Data":"炮附子→固表"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"蒼朮→消頭頂肉瘤內之濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"辛夷、菖蒲→流鼻水"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}