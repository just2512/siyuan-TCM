extMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" 左眼過乾，但視力好轉"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右手無名指又生一硬節(類風濕)→近風寒濕三痺"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"查關節冷冰"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"自述非常不易出汗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"沉緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 可用汗法"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方： \n1"},{"Type":"NodeText","Data":"雙：合谷、養老、睛明"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"美容針"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n1"},{"Type":"NodeText","Data":"回吃HT-100(自己仍有一罐)  早晚飯前各吃30粒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"桂枝四錢 白芍四錢 麻黃三錢 杏仁三錢 炙甘草三錢 大棗十枚 生薑二片白朮三錢 決明子五錢 生地二錢 女貞子三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每天早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說： \n1"},{"Type":"NodeText","Data":"美容針→用「擔法」：每條皺紋中間斜刺，淺針，針倒、留針"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2"},{"Type":"NodeText","Data":" HT-100(歷節丸)→烏頭湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3"},{"Type":"NodeText","Data":"中藥處方2為麻黃湯+甘草附子湯去炮附子(無汗)+補眼(決明子)+補肝腎(用水生木：生地、女貞子)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}