{"ID":"20240515131439-hhzdok5","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131439-hhzdok5","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131439-hhzdok5\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515133512-qwqzx0l\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515133512-qwqzx0l\u0026quot;,\u0026quot;scrollTop\u0026quot;:400,\u0026quot;focusId\u0026quot;:\u0026quot;20240515133512-qwqzx0l\u0026quot;,\u0026quot;focusStart\u0026quot;:447,\u0026quot;focusEnd\u0026quot;:447\u0026#125;","title":"024","type":"doc","updated":"20240515152324"},"Children":[{"ID":"20240515133512-qwqzx0l","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 976px;","id":"20240515133512-qwqzx0l","updated":"20240515152324"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/06/09"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"Coulter John"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"M"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"年齡不知，體格壯碩"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/8/20"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"酸血症（Acidic blood）、高血壓（平素約148/98mmHg）。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左肋下偶而疼痛，飽滿造成。（病患平時有喝咖啡）"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"鼻炎好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左足丘墟處痛（膽經）。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"自覺手足冰冷。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"病患尚有一帖藥未服，提前就診。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"夜間睡眠因夜尿有一兩次醒，但可回睡。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左肋痛仍有一些。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"鼻炎已無症狀。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足仍冷。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便淡黃到中黃。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"體力好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"血壓155/101mmHg（未服降壓西藥），病患有吃一些起司及冰淇淋。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"身時出汗，皮濕。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈弦有力。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診舌診："},{"Type":"NodeText","Data":"黃白厚濕。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"表虛裡寒。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同2008/08/12處方，炮附子加重至六錢（原來四錢）"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"四帖"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9碗水煮成3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各服1碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"★前次剩餘的一包藥再加入二錢炮附子"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"本病患脈象弦數，且夜間無特別寒熱感，並非生附子適應症，故不用之；而病患較無改善及較不穩定之症狀與表虛裡寒較有關，因此守方並以加重炮附劑量治療裡寒兼固表。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"倪師衛教：不可喝牛乳及所有相關乳製品。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}