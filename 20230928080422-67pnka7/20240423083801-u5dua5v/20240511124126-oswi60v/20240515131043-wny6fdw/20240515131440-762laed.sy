{"ID":"20240515131440-762laed","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131440-762laed","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131440-762laed\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515133419-5pdebgv\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515133419-5pdebgv\u0026quot;,\u0026quot;scrollTop\u0026quot;:300,\u0026quot;focusId\u0026quot;:\u0026quot;20240515133419-5pdebgv\u0026quot;,\u0026quot;focusStart\u0026quot;:485,\u0026quot;focusEnd\u0026quot;:485\u0026#125;","title":"023","type":"doc","updated":"20240515152133"},"Children":[{"ID":"20240515133419-5pdebgv","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 942px;","id":"20240515133419-5pdebgv","updated":"20240515152133"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期："}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"CJ"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"男"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"約40歲，中等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/8/12"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"左肋偶爾痛一下，飲酒造成。血中酸過多，BP 148/98，乾眼症，左足胆經上丘墟麻，鼻炎。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：尚好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"身温正常。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便正常。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便中黃。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴尚好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足冷（很久了）"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"易出汗。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手冷足冰(自知)額熱"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n舌診："},{"Type":"NodeText","Data":"黃乾厚。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診 ："},{"Type":"NodeText","Data":"脾區過大，肝區有破損且圈紋多(圈紋代表有脂肪肝)，瞳孔對光反應差→腎陽不足。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 脾受損，酸剋甘，腎陽不足，心陽亦不足。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝五錢　白芍五錢　旋覆花三錢　代赭石三錢　生薑三片　乾薑二錢　當歸二錢　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"木通二錢　黃芩三錢　細辛二錢　蒼朮三錢　澤瀉五錢　炮附子四錢　補骨脂三錢　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"敗龜板二錢　辛夷三錢　菖蒲三錢　玉金五錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9—3碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"解說： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"當歸四逆湯去炙甘草→治手足厥冷，炙甘草增膩故去。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"旋覆花三錢　代赭石三錢→治嘔酸。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"生薑温中，乾薑散水。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便好木通用二錢即可。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"蒼朮三錢　澤瀉五錢→解酒毒。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子四錢　補骨脂三錢　敗龜板二錢→補腎陽。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"辛夷三錢　菖蒲三錢→鼻塞。玉金五錢→病人近日喪父，壓力大。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"老師告知病人，當手足温度回升就表示病已轉好。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}