:"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１口渴還好，室溫水"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３雙足涼"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５大便每日有，一日一行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６有時有脫肛"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７運動汗較多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"８不胸悶"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9 情緒易不好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"浮稍短"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診\n舌診："},{"Type":"NodeText","Data":"黃濕2、"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"桂枝５　炙甘草３　黃連２　黃芩３　升麻３　麻黃３　射干２　紫苑２　冬花２　生薑１　半夏２　炮附子２"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"膠囊４００粒　８ｘ３　三餐飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"此例可捨脈取證，桂枝甘草湯治心悸，射干麻黃湯治久咳化痰水，炮附子收斂固表，（炮附子可治狐臭疝氣脫肛等）。脫肛就是上焦肺的力量不夠，故加升麻提升中氣。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}