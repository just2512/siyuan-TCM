{"ID":"20240515131445-rs22w5o","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131445-rs22w5o","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131445-rs22w5o\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515133037-f4f8l3n\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515133037-f4f8l3n\u0026quot;,\u0026quot;scrollTop\u0026quot;:500,\u0026quot;focusId\u0026quot;:\u0026quot;20240515133037-f4f8l3n\u0026quot;,\u0026quot;focusStart\u0026quot;:545,\u0026quot;focusEnd\u0026quot;:545\u0026#125;","title":"016","type":"doc","updated":"20240515151118"},"Children":[{"ID":"20240515133037-f4f8l3n","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 981px;","id":"20240515133037-f4f8l3n","updated":"20240515151118"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/08/21"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"CD"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"女"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"49岁 中等偏胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/21"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因："},{"Type":"NodeText","Data":"左肋痛，左下腹痛，吃任何东西就呕吐下利甲状腺病仍亢进，胸口痛，手冷冰"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：不好，倦怠"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"寒热：身恶寒，无汗，但一工作则多汗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"二便：大便出多，下利，仍见清谷，味重"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口：有，但怕吃，食后即恶心"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴：有，喜温饮"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"双手足：冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"其他：下雨则关节痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"右脉沉小无力，左脉稍大于右"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"白湿"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":"寒湿在四肢及胃中，肠中又多湿热兼一点寒，少阴证"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"中藥處方："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炮附子 四钱 生姜 二片 白术 三钱 吴茱萸 三钱 干姜 二钱 炙甘草 五钱 桂枝 五钱 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"旋覆花 三钱 代赭石 五钱 大枣 十二枚 党参 三钱  麻黄 三钱 细辛 二钱 海藻 四钱 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"牡蛎 五钱 黄柏 三钱黄芩 三钱  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五付 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"9-3碗 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚餐前服，每服半碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong strong","TextMarkTextContent":"麻黄附子细辛汤：主少阴证，脉沉小，倦怠。\n四逆汤（炮附子、干姜、炙甘草）：身恶寒，手足冰冷，下利清谷\n甘草附子汤（炙甘草、炮附子、桂枝、白术） 去风化湿散寒逐四肢关节弊痛，因患者下雨关节痛，无汗，动则汗多。\n吴茱萸、干姜， 温胃散寒；旋覆花 代赭石，降逆止呕。\n黄柏、黄芩：清肠中湿热，止利\n海藻 牡蛎：软坚散结，疗甲状腺病"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪師曰：四逆湯原方為生附今改炮附，因為病人屬少陰證，但又兼肺家寒證。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}