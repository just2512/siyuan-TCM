extMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１大便好轉，二次一天"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２小便時深時淡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３睡好轉許多（兩三點醒來，立即可回睡）。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４下午潮熱退許多。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５胃口好，仍無汗出。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６臉紅蝴蝶斑退許多。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７胃酸好了不反逆。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"８甲狀腺稍腫（無心悸）。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"９雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１０手溫頭熱手背涼下。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷： 病人進步許多"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"同8/13加"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"厚朴二錢　大黃三錢　柴胡三錢　鬱金五錢　龍膽草三錢　茜草三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"伍付　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗水　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１胰臟癌病人一定要大便通暢，同時顧肝。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２因為體溫夠熱，所以不用擔心甲狀腺有不好的問題，而且沒有心悸，故不是甲狀腺的問題。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}