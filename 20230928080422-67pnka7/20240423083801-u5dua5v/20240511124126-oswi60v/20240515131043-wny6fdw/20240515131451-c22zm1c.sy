TextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１大便未盡出"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２小便中黃，比以前淡"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３睡在凌晨兩點到三點醒來，之後可睡到天亮"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４身熱退"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７不易出汗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"比較好，細小"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"一點淡黃紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" 同8/13加厚朴二錢　大黃三錢　柴胡三錢　鬱金五錢　龍膽草三錢　茜草三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"伍付　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗水　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１因大便未盡出故加大黃厚朴。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２丑時醒來，加柴胡鬱金龍膽草茜草"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３胰臟癌病人幾乎百分之百便秘"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註：服藥完再來找我"}]}]}]}]}