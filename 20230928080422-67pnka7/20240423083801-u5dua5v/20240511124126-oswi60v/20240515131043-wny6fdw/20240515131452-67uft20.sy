xtMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２大便又秘，近六個月不規則，色黑"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３小便深黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４排氣少　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６口渴還好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７睡不好，時醒。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"８身時熱時冷"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"９無月經了，仍有子宮卵巢等在"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１０中午以後會潮熱，下午痛變嚴重"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１１有胃酸反逆"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"舌淡黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 中焦濕熱，因ＡＣＩＤ"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"旋覆花三錢　代赭石五錢　生薑三片　大棗十枚　石膏四兩　知母五錢　澤瀉五錢　當歸二錢　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"側柏葉三錢　枳實三錢　豬苓三錢　瓜婁實五錢　桂枝三錢　海藻四錢　茯苓三錢　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"伍付　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗水　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說：\n此例已接近胰臟癌。\n１"},{"Type":"NodeText","Data":"代赭石重鎮降逆為主藥，因有胃酸故加重。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"２"},{"Type":"NodeText","Data":"炙甘草增膩故不用。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"３"},{"Type":"NodeText","Data":"不用白朮因怕他胃口會更好。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}