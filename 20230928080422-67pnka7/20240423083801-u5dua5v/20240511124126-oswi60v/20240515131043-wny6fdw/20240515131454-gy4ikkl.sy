rk","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":" 睡眠：在AM1:00～2:00醒"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便中黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴尚好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口平平"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙足一點冷了"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"月經準時來，前二天量很多"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右下腹痛，在經前經後都會痛"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈緩有力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃(鮮黃)紅"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 裡寒濕，右卵巢瘤"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n1、"},{"Type":"NodeText","Data":"HT-8(b)桂枝茯苓丸加味  6兩  30x2 午餐前及睡前服"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、"},{"Type":"NodeText","Data":"桂枝四錢 炙甘草四錢 茯苓五錢 柴胡三錢 玉金五錢 黃芩三錢 龍膽草三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"茜草五錢 白芍八錢 丹皮三錢 川芎三錢 當歸二錢 生附子二錢(另包) 乾薑二錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"十付  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"每天早晚飯前各一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說： \n1."},{"Type":"NodeText","Data":"師云患者再8天MC來，故趁機攻之。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2."},{"Type":"NodeText","Data":"患者在凌晨一兩點鐘會醒，要清一下肝。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3."},{"Type":"NodeText","Data":"月經腹痛可用茜草，丹皮、白芍、川芎等入肝經的活血藥治之。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}