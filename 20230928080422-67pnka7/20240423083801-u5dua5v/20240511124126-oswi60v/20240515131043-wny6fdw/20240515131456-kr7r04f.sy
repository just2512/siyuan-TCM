{"ID":"20240515131456-kr7r04f","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240515131456-kr7r04f","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240515131456-kr7r04f\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240515132118-bu0oilp\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240515132118-bu0oilp\u0026quot;,\u0026quot;scrollTop\u0026quot;:300,\u0026quot;focusId\u0026quot;:\u0026quot;20240515132118-bu0oilp\u0026quot;,\u0026quot;focusStart\u0026quot;:444,\u0026quot;focusEnd\u0026quot;:444\u0026#125;","title":"002","type":"doc","updated":"20240515144409"},"Children":[{"ID":"20240515132118-bu0oilp","Type":"NodeTable","TableAligns":[0],"Properties":{"colgroup":"width: 912px;","id":"20240515132118-bu0oilp","updated":"20240515144409"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倪醫師病案紀錄"},{"Type":"NodeText","Data":" 初診日期：2008/08/15"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姓名"},{"Type":"NodeText","Data":"BB"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性別："},{"Type":"NodeText","Data":"F"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"年齡及體型"},{"Type":"NodeText","Data":"目視約四十歲 胖"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診日期："},{"Type":"NodeText","Data":"2008/08/15"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"來診原因：\n１"},{"Type":"NodeText","Data":"今年三月感冒後，一直很久沒好，鼻子跟喉嚨一直沒好，喉中一直很乾。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"２"},{"Type":"NodeText","Data":"之後，六週前摔倒，左足掌內側足脾經會痛，右膝也同時受傷。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"３"},{"Type":"NodeText","Data":"五週後要唱歌。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"４"},{"Type":"NodeText","Data":"想減肥。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１睡好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２大便每日行"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３胃口好"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４口渴有，冷飲"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"５雙足溫"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"６睡時身熱"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"７小便中黃，深黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"８月經來算正常"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"９有排氣，吃藥才有每天大便→小承氣湯"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩有力→脈不浮故知已無表證"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"舌淡黃濕"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、"},{"Type":"NodeText","Data":"眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 白虎湯證，小承氣湯"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１雙列缺　雙照海　天突→治喉乾"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２右太白　右公孫　右魚際→治左足掌脾經痛，採對稱治療。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３雙迎香→治鼻病。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"４右膝五針→治膝蓋扭傷。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"石膏五兩　知母五錢　甘草三錢　麥冬三錢　黃芩三錢　天花三錢　夏枯草五錢　辛夷三錢　菖蒲三錢　蒼朮三錢　葛根六錢　厚朴二錢　枳實二錢　大黃四錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"拾付　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗煮三碗水　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"解說： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"１喉乾，口渴，身熱為白虎湯證。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"２葛根生津液，治喉乾可用之。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"３大黃配上厚朴枳實則攻下不會肚子痛。"},{"Type":"NodeBr","Data":"br"}]}]}]}]}