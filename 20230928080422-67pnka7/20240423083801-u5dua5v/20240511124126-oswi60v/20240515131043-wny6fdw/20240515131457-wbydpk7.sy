TextMark","TextMarkType":"strong","TextMarkTextContent":"脈診：脈穩定"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"診斷： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"TMJ→足陽明經實症"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左手臂麻→手三陽經虛症"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"雙 (內庭，合谷，下關，梁丘)  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"右 (曲池，中渚，後谿)"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： HT-64 　　　早晚飯前各服 ３0粒"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解說："},{"Type":"NodeText","Data":"　"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"１. "},{"Type":"NodeText","Data":"TMJ 僅一週 →實症→內庭(代厲兌為子穴)，合谷(止面部疼痛)，下關(天應)，梁丘(郄穴)。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"２."},{"Type":"NodeText","Data":"手臂時好時麻 →虛症→手三陽經母穴 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"３."},{"Type":"NodeText","Data":" HT-64 →(溫經湯加減) 治療更年期身熱 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"４."},{"Type":"NodeText","Data":"脈穩定→身體還好"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}