:"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":"  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"服上方後有無出汗？答：有一點 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"自覺很虛弱。睡眠較前好轉，仍有寒熱往來。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"左側時麻時止，時有力時無力。 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"體力差 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口無 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便每日行 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早上有心痛徹背 "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴喜冷飲"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"脈洪時快時慢"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n1、舌診："},{"Type":"NodeText","Data":"淡黃"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、眼診 :"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 心血不足。虛證中風，心氣受阻。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"針灸處方： "}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中藥處方： \n炙甘草湯"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"炙甘草一兩  生薑兩片  大棗十枚  桂枝四錢  熟地三錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"阿膠三錢(分三包烊盡)   黨參三錢   麥冬三錢    枳實三錢"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"薤白三錢  瓜蔞實五錢  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"五帖  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"九碗水煮成三碗  "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"早晚飯前各喝一碗"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"解說： "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"倪師把脈時發現她的脈洪時快時慢故知她心臟有問題，因此問他是否有胸痛，他說：「早上有心痛徹背」"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"心臟病不舒服若是心氣方面的問題則方中用枳實、薤白、瓜蔞實。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"備註："}]}]}]}]}