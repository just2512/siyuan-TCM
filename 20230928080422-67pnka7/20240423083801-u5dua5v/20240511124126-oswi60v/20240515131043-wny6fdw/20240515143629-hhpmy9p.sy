extMarkType":"strong","TextMarkTextContent":"問診："},{"Type":"NodeText","Data":" "},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"睡眠：時好時壞，近來最差。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"大便：每天行，不成形。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"小便淡黃。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"手足冷。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"胃口好。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"口渴無。"},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脈診："},{"Type":"NodeText","Data":"緩有力（老師口述為洪數）。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望診：\n舌診："},{"Type":"NodeText","Data":"黃濕，中間白。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"眼診 ："},{"Type":"NodeBr","Data":"br"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特殊診斷："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耳診："}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"診斷："},{"Type":"NodeText","Data":" 調胃承氣湯症。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"針灸處方："},{"Type":"NodeText","Data":" 雙手神門，後溪。"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkTyp