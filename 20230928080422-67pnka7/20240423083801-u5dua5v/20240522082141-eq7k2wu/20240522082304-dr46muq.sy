49"},"Children":[{"Type":"NodeText","Data":"問小便，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"淡白，5-6次"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"}]}]},{"ID":"20240522084954-ln8sgor","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ny4=","Num":7},"Properties":{"id":"20240522084954-ln8sgor","updated":"20240522085103"},"Children":[{"ID":"20240522084954-vnxio7f","Type":"NodeParagraph","Properties":{"id":"20240522084954-vnxio7f","updated":"20240522085103"},"Children":[{"Type":"NodeText","Data":"問寒熱，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"額頭較熱, 手腳溫熱, 喜喝溫水，下午容易發熱"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":" (日哺所潮熱)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]}]},{"ID":"20240522084954-jey37et","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OC4=","Num":8},"Properties":{"id":"20240522084954-jey37et","updated":"20240522085053"},"Children":[{"ID":"20240522084954-fx15cg5","Type":"NodeParagraph","Properties":{"id":"20240522084954-fx15cg5","updated":"20240522085053"},"Children":[{"Type":"NodeText","Data":"問口渴，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"不渴，但會逼自己喝水"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"}]}]}]},{"ID":"20240522084954-x537qsk","Type":"NodeParagraph","Properties":{"id":"20240522084954-x537qsk","updated":"20240522084954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"腹診 :"}]},{"ID":"20240522084954-twbah64","Type":"NodeParagraph","Properties":{"id":"20240522084954-twb