,{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒴藋 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒴藋 6-20240826103905-hz7qw2k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 806px;\" parent-style=\"width: 816px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 349px;","style":"width: 339px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒴藋 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒴藋 3-20240826103541-17ecw4y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 339px;\" parent-style=\"width: 349px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826113434-mbv4p0n","Type":"NodeParagraph","Properties":{"id":"20240826113434-mbv4p0n","updated":"20240826113434"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 753px;","style":"width: 743px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒴藋 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒴藋 11-20240826113332-k9i0diy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 743px;\" parent-style=\"width: 753px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 426px;","style":"width: 416px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒴藋 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒴藋 10-20240826113245-yr7x4lk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 416px;\" parent-style=\"width: 426px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826103101-3oj2vyc","Type":"NodeParagraph","Properties":{"id":"20240826103101-3oj2vyc","updated":"20240828141251"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 595px;","style":"width: 585px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒴藋"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒴藋-20240826103101-ytue71n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 585px;\" parent-style=\"width: 595px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒴细叶"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒴细叶-20240619165917-26ar6jh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704144714-tqfv9uy","Type":"NodeParagraph","Properties":{"id":"20240704144714-tqfv9uy","updated":"20240704144723"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点击跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240506102408-a2yo2s3","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"308陆英（八棱麻、接骨草）"}]},{"ID":"20240704142333-tujxnj8","Type":"NodeParagraph","Properties":{"id":"20240704142333-tujxnj8","updated":"20240704142830"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：蒴藋就是陆英，也叫八棱麻（茎上有八条棱）。"}]},{"ID":"20240614112215-n24wmdc","Type":"NodeThematicBreak","Properties":{"id":"20240614112215-n24wmdc"}},{"ID":"20240614112523-id9yhzg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112523-id9yhzg","updated":"20240614112533"},"Children":[{"Type":"NodeText","Data":"蒴《新修本草》"}]},{"ID":"20240614112523-cmwsvrb","Type":"NodeParagraph","Properties":{"id":"20240614112523-cmwsvrb","updated":"20240614112523"},"Children":[{"Type":"NodeText","Data":"味酸，温，有毒。主风瘙瘾疹，身痒、湿痹，可作浴汤。一名堇草，一名芨。生田野。"}]},{"ID":"20240614112523-rl07v21","Type":"NodeParagraph","Properties":{"id":"20240614112523-rl07v21","updated":"20240614112523"},"Children":[{"Type":"NodeText","Data":"春夏采叶，秋冬采茎、根。"}]},{"ID":"20240614112523-zuhcqvn","Type":"NodeParagraph","Properties":{"id":"20240614112523-zuhcqvn","updated":"20240614112523"},"Children":[{"Type":"NodeText","Data":"田野墟村中甚多，绝疗风痹痒痛，多用薄洗，不堪入服，亦有酒渍根，稍饮之者。"}]},{"ID":"20240614112523-nwgmmb6","Type":"NodeParagraph","Properties":{"id":"20240614112523-nwgmmb6","updated":"20240614112523"},"Children":[{"Type":"NodeText","Data":"〔谨案《尔雅》云∶芨，堇草。郭注云∶乌头苗也。检三堇别名，又无此者。蜀人谓乌头苗为堇草。"}]},{"ID":"20240614112523-78z5frz","Type":"NodeParagraph","Properties":{"id":"20240614112523-78z5frz","updated":"20240614112523"},"Children":[{"Type":"NodeText","Data":"陶引此条，不知所出处。"}]},{"ID":"20240614112523-kd9v5wl","Type":"NodeParagraph","Properties":{"id":"20240614112523-kd9v5wl","updated":"20240614112523"},"Children":[{"Type":"NodeText","Data":"《药对》及古方无蒴 ，惟言陆英也。"}]},{"ID":"20240614112215-pz8kaph","Type":"NodeThematicBreak","Properties":{"id":"20240614112215-pz8kaph"}},{"ID":"20240614112449-4fzui9e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112449-4fzui9e","updated":"20240614112453"},"Children":[{"Type":"NodeText","Data":"蒴《本草衍义》"}]},{"ID":"20240614112449-az3jmhg","Type":"NodeParagraph","Properties":{"id":"20240614112449-az3jmhg","updated":"20240614112449"},"Children":[{"Type":"NodeText","Data":"蒴 与陆英，既性味及出产处不同，治疗又别，自是二物，断无疑焉。况蒴 花白，子初青如绿豆颗，每朵如盏面大，又平生，有一二百子，十月方熟红，岂得言剩出此条，孟浪之甚也。"}]},{"ID":"20240614112215-k9cj9ks","Type":"NodeThematicBreak","Properties":{"id":"20240614112215-k9cj9ks"}},{"ID":"20240614112441-e9n90o4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112441-e9n90o4","updated":"20240614112444"},"Children":[{"Type":"NodeText","Data":"蒴《名医别录》"}]},{"ID":"20240614112441-jurxy5v","Type":"NodeParagraph","Properties":{"id":"20240614112441-jurxy5v","updated":"20240614112441"},"Children":[{"Type":"NodeText","Data":"味酸，温，有毒．主治风瘙瘾疹、身痒、湿痹，可作浴汤．一名堇草，一名芨．生田春夏采叶，秋冬采茎、根．"}]},{"ID":"20240614112215-5wfka70","Type":"NodeThematicBreak","Properties":{"id":"20240614112215-5wfka70"}},{"ID":"20240614112432-rvv2kel","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112432-rvv2kel","updated":"20240614112436"},"Children":[{"Type":"NodeText","Data":"蒴《本草经集注》"}]},{"ID":"20240614112432-625wcqo","Type":"NodeParagraph","Properties":{"id":"20240614112432-625wcqo","updated":"20240614112432"},"Children":[{"Type":"NodeText","Data":"味酸，温，有毒。主治风瘙瘾疹，身痒，湿痹，可作浴汤。一名 草，一名芨，生田野。春夏采叶，秋冬采茎、根。"}]},{"ID":"20240614112432-6b46bn1","Type":"NodeParagraph","Properties":{"id":"20240614112432-6b46bn1","updated":"20240614112432"},"Children":[{"Type":"NodeText","Data":"田野墟村中甚多，绝治风痹痒痛，多用薄洗，不堪入服，亦有酒渍根，稍饮之者。"}]},{"ID":"20240614112215-rmt85o1","Type":"NodeThematicBreak","Properties":{"id":"20240614112215-rmt85o1"}},{"ID":"20240614112239-q3r7oqj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112239-q3r7oqj","updated":"20240614112244"},"Children":[{"Type":"NodeText","Data":"蒴翟《本草纲目》"}]},{"ID":"20240614112239-t6st92u","Type":"NodeParagraph","Properties":{"id":"20240614112239-t6st92u","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"「释名」朔吊。接骨草。"}]},{"ID":"20240614112239-ui4jwir","Type":"NodeParagraph","Properties":{"id":"20240614112239-ui4jwir","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"「气味」酸、温、有毒。"}]},{"ID":"20240614112239-v26ublu","Type":"NodeParagraph","Properties":{"id":"20240614112239-v26ublu","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614112239-j6oaqhx","Type":"NodeParagraph","Properties":{"id":"20240614112239-j6oaqhx","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"1、手中偏风，取蒴翟叶，用火烤热，厚铺床上，趁热睡卧。叶冷则换。冬月取根捣碎，熬热后用。"}]},{"ID":"20240614112239-gvb778n","Type":"NodeParagraph","Properties":{"id":"20240614112239-gvb778n","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"2、风湿冷痹。治方同上。"}]},{"ID":"20240614112239-d8rs1h0","Type":"NodeParagraph","Properties":{"id":"20240614112239-d8rs1h0","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"3、寒湿腰痛。治方同上。"}]},{"ID":"20240614112239-6fjbtks","Type":"NodeParagraph","Properties":{"id":"20240614112239-6fjbtks","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"4、脚气胫肿内痛。用蒴翟根研碎，加酒醋一起蒸熟。封裹肿痛处，一二日即消。"}]},{"ID":"20240614112239-pbqs5d4","Type":"NodeParagraph","Properties":{"id":"20240614112239-pbqs5d4","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"5、浑身水肿，坐卧不得，用蒴翟根，去皮，捣汁一合，和酒一合暖服，鉴别有吐泻。"}]},{"ID":"20240614112239-uphnfc1","Type":"NodeParagraph","Properties":{"id":"20240614112239-uphnfc1","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"6、头风眩晕。用蒴翟、独活、白石膏各一两，少枳实七钱半。每取三钱，加酒一碗，煎至六成服下。"}]},{"ID":"20240614112239-fzbymdb","Type":"NodeParagraph","Properties":{"id":"20240614112239-fzbymdb","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"7、产后恶露不尽。用蒴翟二十两，锉细，加水一半斗，煮成三升，分三次服。"}]},{"ID":"20240614112239-496s0s9","Type":"NodeParagraph","Properties":{"id":"20240614112239-496s0s9","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"8、疟疾不止。用蒴翟一把，火炙到红，以不浓煎一碗，发病前服下。"}]},{"ID":"20240614112239-e0dvto1","Type":"NodeParagraph","Properties":{"id":"20240614112239-e0dvto1","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"9、腹内突然出现硬块，极痛。用蒴翟根一小束，洗净切细，泡在酒二升中三晚，每温服五合至一升，一天服三次。"}]},{"ID":"20240614112239-2xu68i9","Type":"NodeParagraph","Properties":{"id":"20240614112239-2xu68i9","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"10、鳖瘕坚硬（肿起如盆，不能星卧）。用蒴翟根白皮一把，捣成汁，和水服。"}]},{"ID":"20240614112239-0sywqf8","Type":"NodeParagraph","Properties":{"id":"20240614112239-0sywqf8","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"11、风疹。用蒴翟叶捣烂敷搽。"}]},{"ID":"20240614112239-3kbz1h3","Type":"NodeParagraph","Properties":{"id":"20240614112239-3kbz1h3","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"12、丹毒。用蒴翟叶捣烂敷搽。"}]},{"ID":"20240614112239-1nk0jwh","Type":"NodeParagraph","Properties":{"id":"20240614112239-1nk0jwh","updated":"20240614112239"},"Children":[{"Type":"NodeText","Data":"13、痈肿。用蒴翟烧灰、石灰，各淋取汁，然后合在一起，浓煎成膏，敷患处。能蚀掉恶肉，亦去痣瘢。膏制成后的有效期只有十日。"}]},{"ID":"20240614112240-inonful","Type":"NodeThematicBreak","Properties":{"id":"20240614112240-inonful"}},{"ID":"20240614112305-lzzvlw6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112305-lzzvlw6","updated":"20240614112311"},"Children":[{"Type":"NodeText","Data":"蒴《证类本草》"}]},{"ID":"20240614112305-bd59lf7","Type":"NodeParagraph","Properties":{"id":"20240614112305-bd59lf7","updated":"20240614112305"},"Children":[{"Type":"NodeText","Data":"味酸，温，有毒。主风瘙瘾疹，身痒湿痹，可作浴汤。一名堇草，一名芨。生田野，春夏采叶，秋冬采茎、根。"}]},{"ID":"20240614112305-ve0lc1u","Type":"NodeParagraph","Properties":{"id":"20240614112305-ve0lc1u","updated":"20240614112305"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶田野墟村中甚多。绝疗风痹痒痛，多用薄洗，不堪入服，亦有酒渍根，稍饮之者。唐本注云∶此陆英也，剩出此条。《尔雅》云∶芨，堇草。郭注云∶乌头苗也。检三堇别名。又无此者，蜀人谓乌头苗为堇草。陶引此条，不知所出处。《药对》∶及古方无蒴 ，唯言陆英也。今注蒴 条，唐本编在野狼跋子之后，而与陆英条注解并云剩出一条。今详陆英，味苦，寒，无毒。蒴 ，味酸，温，有毒。既此不同，难谓一种，盖其类尔。今但移附陆英之下。臣禹锡等谨按日华子云∶味苦，凉，有毒。治 癞风痹，并煎汤浸，并叶用。"}]},{"ID":"20240614112305-0asvj59","Type":"NodeParagraph","Properties":{"id":"20240614112305-0asvj59","updated":"20240614112305"},"Children":[{"Type":"NodeText","Data":"图经文具陆英条下。"}]},{"ID":"20240614112305-2z3es77","Type":"NodeParagraph","Properties":{"id":"20240614112305-2z3es77","updated":"20240614112305"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使之，春用隔年花蕊，夏用根，秋冬并总用作煎，只取根，用铜刀细切，于柳木臼中捣取自然汁，缓缓于锅子中煎如稀饧。任用也。外台秘要∶治卒暴症，腹中有物坚如石，痛欲死。取蒴 根一小束，洗沥去水细擘，以酒二升，渍三宿，暖温服五合至一升，日三，若欲速得服，于热灰中温令药味出服之。此方无毒，已愈十六人，神验。药尽复作服之。又方∶治腰痛方∶蒴 叶，火燎，浓铺床上，趁热卧眠于上，冷复易之。冬月取根，舂碎熬及热准前用。并治风温湿冷痹及产妇患伤冷，腰痛不得动亦用。又方∶治下部闭不通。取蒴 根一把，捣汁水和，绞去滓。强人服一升。数用之，并治香港脚。千金方∶治岭南香港脚，从足至膝胫肿，骨疼者。蒴 根碎，和酒醋共三分，根一分合蒸熟，封裹肿上。二、三日即消。亦治不仁。又方∶治头风。取蒴 根二升，酒二升，煮服之。梅师方∶治水肿，坐卧不得，头面身体悉肿。取蒴根刮去皮，捣汁一合，和酒一合，暖空心服，当微吐利。又方∶治一切疹。用煮蒴 汤，和少酒涂，无不瘥。姚氏方同。孙真人食忌主卒脚肿渐上。以蒴 茎、叶，埋热灰中令热，敷肿上，瘥即易。斗门方治疟疾。用蒴 一大握炙令黄色，以水浓煎一盏，欲发前服。张文仲治手足忽生疣目。蒴 赤子，挪使坏疣目上令赤，涂之瘥。又方∶治熊伤人疮。蒴 一大把锉碎，以水一升渍，须臾取汁饮，余滓以封裹疮。子母秘录治小儿赤游行于身上，下至心即死。蒴 煎汁洗之。"}]},{"ID":"20240614112305-c66zzef","Type":"NodeParagraph","Properties":{"id":"20240614112305-c66zzef","updated":"20240614112305"},"Children":[{"Type":"NodeText","Data":"衍义曰∶蒴 ，与陆英既性味及出产处不同，治疗又别，自是二物，断无疑焉。况蒴花白子初青如绿豆颗，每朵如盏面大，又平生，有一、二百子，十月方熟红，忌得言剩？出此条，孟浪之甚也。"}]},{"ID":"20240614112306-qmeek84","Type":"NodeThematicBreak","Properties":{"id":"20240614112306-qmeek84"}},{"ID":"20240614112329-xqhc2xt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112329-xqhc2xt","updated":"20240614112333"},"Children":[{"Type":"NodeText","Data":"蒴细叶《本草乘雅半偈》"}]},{"ID":"20240614112329-cbho132","Type":"NodeParagraph","Properties":{"id":"20240614112329-cbho132","updated":"20240614112329"},"Children":[{"Type":"NodeText","Data":"（别录下品）"}]},{"ID":"20240614112329-uyx788i","Type":"NodeParagraph","Properties":{"id":"20240614112329-uyx788i","updated":"20240614112329"},"Children":[{"Type":"NodeText","Data":"【气味】酸，温，有毒。"}]},{"ID":"20240614112329-bk2bpsf","Type":"NodeParagraph","Properties":{"id":"20240614112329-bk2bpsf","updated":"20240614112329"},"Children":[{"Type":"NodeText","Data":"【主治】风瘙，瘾疹，身痒，湿痹，可作浴汤。"}]},{"ID":"20240614112329-yh8ix9s","Type":"NodeParagraph","Properties":{"id":"20240614112329-yh8ix9s","updated":"20240614112329"},"Children":[{"Type":"NodeText","Data":"【核】曰∶蒴 ，出熊耳川谷，及冤句，今田野丘墟间亦有之。春初生苗，每枝五叶，夏半花白，如盏大。结子青碧，类绿豆，十月红熟，一名接骨。芹族也，芹品凡三∶一水芹，水英也；二旱芹，陆英也；三蒴 ，木英也。盖木谓之华，草谓之荣，不荣而实，谓之秀；"}]},{"ID":"20240614112329-hkh3hpv","Type":"NodeParagraph","Properties":{"id":"20240614112329-hkh3hpv","updated":"20240614112329"},"Children":[{"Type":"NodeText","Data":"荣而不实，谓之英。陆英精专者荣，采其英；蒴 专精者叶，摘其叶。仲景金匮要略论，王不留行散，疗金疮，用蒴 叶，因名蒴 。细叶者，初生嫩绿小叶也。修事∶初春摘取细叶，阴干，他时叶转大，气味劣薄矣。"}]},{"ID":"20240614112329-36ada7t","Type":"NodeParagraph","Properties":{"id":"20240614112329-36ada7t","updated":"20240614112329"},"Children":[{"Type":"NodeText","Data":"【 】曰∶蒴 谐声，草谐蒴 也。盖月冥初苏之为朔，雉伏翕羽之为翟，喻功力用相肖耳。故得开宣阳气，熏肤充身，而疮疡辟。乃回阴气，骨接肌连，而金疮合，枢机之为用，铸形良品也。"}]},{"ID":"20240614112330-w03mqvm","Type":"NodeThematicBreak","Properties":{"id":"20240614112330-w03mqvm"}},{"ID":"20240614112545-emx9s30","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614112545-emx9s30","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"蒴藋"}]},{"ID":"20240614112545-5xc9vzr","Type":"NodeParagraph","Properties":{"id":"20240614112545-5xc9vzr","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614112545-l2oagam","Type":"NodeParagraph","Properties":{"id":"20240614112545-l2oagam","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" Shuò Diào"}]},{"ID":"20240614112545-gpemihk","Type":"NodeParagraph","Properties":{"id":"20240614112545-gpemihk","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614112545-m3sycfe","Type":"NodeParagraph","Properties":{"id":"20240614112545-m3sycfe","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 接骨草（《履巉岩本草》），接骨木（《东医宝鉴》），真珠花、珊瑚花、排风藤、铁篱笆（《植物名实图考长编》），吴草（《草木便方》），英雄草（《分类草药性》），苛草（《天宝本草》），走马箭、赤苓叶（《岭南采药录》），公道老（《中国树木分类学》），排风草、鸡罅风（《中国药植志》），扫地风、八棱麻（《贵州民间方药集》），葛辣、五甲皮、龙州三七（《广西中兽医药植》），大臭草（《民间常用草药汇编》），七叶麻（《江西民间药草》），马鞭三七、落得打、珍珠连（《浙江民间草药》），秧心草（《四川中药志》），八里麻、臭"}]},{"ID":"20240614112545-28gwx4m","Type":"NodeParagraph","Properties":{"id":"20240614112545-28gwx4m","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614112545-obvzqin","Type":"NodeParagraph","Properties":{"id":"20240614112545-obvzqin","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240614112545-joaf8rz","Type":"NodeParagraph","Properties":{"id":"20240614112545-joaf8rz","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614112545-ftn6zwg","Type":"NodeParagraph","Properties":{"id":"20240614112545-ftn6zwg","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 为忍冬科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蒴藋"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240614112545-ddib4fz","Type":"NodeParagraph","Properties":{"id":"20240614112545-ddib4fz","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614112545-fwvoew0","Type":"NodeParagraph","Properties":{"id":"20240614112545-fwvoew0","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 生长于山脚、河边。分布山东、河南、江西、湖北、湖南、江苏、浙江、福建、广东、广西、云南、贵州、四川等圪。"}]},{"ID":"20240614112545-ja8e4wh","Type":"NodeParagraph","Properties":{"id":"20240614112545-ja8e4wh","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614112545-1qb7eka","Type":"NodeParagraph","Properties":{"id":"20240614112545-1qb7eka","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 灌木状草本，高达3米。主根垂直，副根不多。茎具棱，平滑无毛，多分枝。叶对生，单数羽状复叶，小叶5～9，长椭圆状披针形，长8～15厘米，宽3～5厘米，先端渐尖，基部偏斜稍圆或阔模形，边缘具密而尖锐的锯齿，上面暗绿色，下面淡绿色，两面均平滑无毛，或叶脉上有短柔毛；叶柄长约3厘米，无托叶，小叶柄短或近于无柄。复伞房花序顶生，直径约20～30厘米，有短柔毛或几为绒毛；小苞片细小，卵状披针形；花小，白色，萼5裂，下部愈合成钟状：花冠辐射，5裂，裂片卵形；雄蕊5，与花冠裂片互生，花丝短，药室向外开裂；雌蕊1，子房卵圆形，柱头头状；花间杂有黄色杯状的腺体。浆果球形，红色，直径3～4毫米。花期8月。果期10月。"}]},{"ID":"20240614112545-g6jcib3","Type":"NodeParagraph","Properties":{"id":"20240614112545-g6jcib3","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"本植物的花（陆英），果实（蒴藋赤子）亦供药用。各详专条。"}]},{"ID":"20240614112545-jdotkd3","Type":"NodeParagraph","Properties":{"id":"20240614112545-jdotkd3","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614112545-zebu036","Type":"NodeParagraph","Properties":{"id":"20240614112545-zebu036","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 全草含黄酮类、酚性成分、鞣质、糖类、绿原酸。种子含氰甙类。根含大量鞣质、还原糖外，还含生物碱。又从干叶分离出β-谷甾醇，豆甾醇、菜油甾醇、α-香树脂醇棕榈酸酯、熊果酸和多量硝酸钾。"}]},{"ID":"20240614112545-dwzdqjx","Type":"NodeParagraph","Properties":{"id":"20240614112545-dwzdqjx","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614112545-vvueglf","Type":"NodeParagraph","Properties":{"id":"20240614112545-vvueglf","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" ①加速骨折愈合的作用"}]},{"ID":"20240614112545-jv4t3i2","Type":"NodeParagraph","Properties":{"id":"20240614112545-jv4t3i2","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"家兔用人工方法造成骨折，经夹板固定后，外敷散落得打（酒调），3日更换1次。每日内服落得打煎剂，第4周末有圆形较致密之多量骨痂及显着钙化（X线照片），组织切片上可观察到，大块骨痂组织己大部分骨化，多量的骨小梁形成。从骨折局部血肿中注入磷32，用落得打后，脉冲消散率较快，说明有\"活血散瘀\"作用。组织中磷的沉积也高于对照组，说明落得打能促进磷在骨痂中的沉积，因而加速骨折愈合。"}]},{"ID":"20240614112545-b47rn1s","Type":"NodeParagraph","Properties":{"id":"20240614112545-b47rn1s","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"②消肿作用"}]},{"ID":"20240614112545-fx6v403","Type":"NodeParagraph","Properties":{"id":"20240614112545-fx6v403","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"家兔外敷落得打醇糊剂未出现局部血管扩张现象。其煎剂对蟾蜍下肢血管的收缩作用不显著，较高浓度对离体兔耳血管有显著的收缩血管作用，其油膏剂在家兔及小鼠的实验中，均有轻度减少毛细血管通透性的作用。上述作用可能与其消肿的疗效有关。"}]},{"ID":"20240614112545-1zqso4t","Type":"NodeParagraph","Properties":{"id":"20240614112545-1zqso4t","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240614112545-wiui2rl","Type":"NodeParagraph","Properties":{"id":"20240614112545-wiui2rl","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"落得打煎剂对小鼠热板法并不表现镇痛作用，对金黄色葡萄球菌、大肠杆菌试管内无抑制作用。"}]},{"ID":"20240614112545-bhd5l3g","Type":"NodeParagraph","Properties":{"id":"20240614112545-bhd5l3g","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614112545-eomembs","Type":"NodeParagraph","Properties":{"id":"20240614112545-eomembs","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 《长沙药解》：\"入足厥阴肝经。\""}]},{"ID":"20240614112545-hhd47uf","Type":"NodeParagraph","Properties":{"id":"20240614112545-hhd47uf","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614112545-sh3rjkn","Type":"NodeParagraph","Properties":{"id":"20240614112545-sh3rjkn","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 甘酸，温。"}]},{"ID":"20240614112545-46wzi27","Type":"NodeParagraph","Properties":{"id":"20240614112545-46wzi27","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味酸，温，有毒。\""}]},{"ID":"20240614112545-7n3dyon","Type":"NodeParagraph","Properties":{"id":"20240614112545-7n3dyon","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"②《云南中草药选》：\"辛湿，温。\""}]},{"ID":"20240614112545-73135kr","Type":"NodeParagraph","Properties":{"id":"20240614112545-73135kr","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"③《四川中药志》：\"性微温，味甘淡，无毒。\""}]},{"ID":"20240614112545-rfpkgcf","Type":"NodeParagraph","Properties":{"id":"20240614112545-rfpkgcf","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614112545-svobqo3","Type":"NodeParagraph","Properties":{"id":"20240614112545-svobqo3","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 江西《中草药学》：\"孕妇禁服。\""}]},{"ID":"20240614112545-28a3pjg","Type":"NodeParagraph","Properties":{"id":"20240614112545-28a3pjg","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614112545-g2uozx5","Type":"NodeParagraph","Properties":{"id":"20240614112545-g2uozx5","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 祛风除湿，活血散瘀。治风湿疼痛，肾炎水肿，脚气浮肿，痢疾，黄疸，慢性气管炎，风疹瘙痒，丹毒，疮肿，跌打损伤、骨折。"}]},{"ID":"20240614112545-fbbbls1","Type":"NodeParagraph","Properties":{"id":"20240614112545-fbbbls1","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主风瘙瘾疹身痒，湿痹。可作浴汤。\""}]},{"ID":"20240614112545-r1mqeuz","Type":"NodeParagraph","Properties":{"id":"20240614112545-r1mqeuz","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"治瘑癞，风痹。煎汤浸，并叶用。\""}]},{"ID":"20240614112545-148rg6v","Type":"NodeParagraph","Properties":{"id":"20240614112545-148rg6v","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"③《长沙药解》：\"行血通经，消瘀化凝。疗水肿，逐湿痹，下症块，破瘀血，洗瘾疹风瘙，敷脚膝肿痛。\""}]},{"ID":"20240614112545-h2fbb5a","Type":"NodeParagraph","Properties":{"id":"20240614112545-h2fbb5a","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"④《分类草药性》：\"根，治筋骨痛，两足疼痛，跌打损伤。\""}]},{"ID":"20240614112545-obbm9li","Type":"NodeParagraph","Properties":{"id":"20240614112545-obbm9li","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑤《贵州民间方药集》：\"茎叶可利尿，治脚肿胀，除风湿。外用治痈肿、疮疖，又治蛇虫咬伤。\""}]},{"ID":"20240614112545-qkvrc85","Type":"NodeParagraph","Properties":{"id":"20240614112545-qkvrc85","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑥《四川中药志》：\"根能利尿，消痰降气，治黄疸肿胀，脾胃虚弱和消化不良。\""}]},{"ID":"20240614112545-h5i9faq","Type":"NodeParagraph","Properties":{"id":"20240614112545-h5i9faq","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑦《上海常用中草药》：\"茎叶，发汗利尿。根，活血散瘀，祛风活络。\""}]},{"ID":"20240614112545-7sx0pkd","Type":"NodeParagraph","Properties":{"id":"20240614112545-7sx0pkd","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614112545-q7f8vvh","Type":"NodeParagraph","Properties":{"id":"20240614112545-q7f8vvh","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱（鲜者3～4两）；捣汁或浸酒。外用：煎水洗浴或捣敷。"}]},{"ID":"20240614112545-fb4v898","Type":"NodeParagraph","Properties":{"id":"20240614112545-fb4v898","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614112545-ycwgdaz","Type":"NodeParagraph","Properties":{"id":"20240614112545-ycwgdaz","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" ①治偏枯冷痹，缓弱疼重，或腰痛挛脚重痹：蒴藋叶火燎，厚安席上，及热眠上，冷复燎之。冬月取根，春取茎，熬，卧之佳。其余薄熨不及蒴藋蒸也。诸处风湿，亦用此法。（《千金方》）"}]},{"ID":"20240614112545-6cxywjf","Type":"NodeParagraph","Properties":{"id":"20240614112545-6cxywjf","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"②治水肿，坐卧不得，头面身体悉肿：蒴藋根刮去皮，捣汁一合，和酒一合，暖，空心服，当微吐利。（《梅师集验方》）"}]},{"ID":"20240614112545-33istjq","Type":"NodeParagraph","Properties":{"id":"20240614112545-33istjq","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"③治脚气初起，从足起至膝胫骨肿疼者：蒴藋根捣碎，和酒糟三分，根一分，合蒸热，及热封裹肿上，日二。亦治不仁顽痹。（《千金方》）"}]},{"ID":"20240614112545-4jnpwob","Type":"NodeParagraph","Properties":{"id":"20240614112545-4jnpwob","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"④治肾炎水肿，脚气水肿：蒴藋全草四至八钱。水煎服。（广州部队《常用中草药手册》）"}]},{"ID":"20240614112545-87xwp2v","Type":"NodeParagraph","Properties":{"id":"20240614112545-87xwp2v","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑤治黄疸：蒴藋根炖五花肉服。（《四川中药志》）"}]},{"ID":"20240614112545-ah3xauh","Type":"NodeParagraph","Properties":{"id":"20240614112545-ah3xauh","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑥治五淋：蒴藋鲜根每次三至四两。合猪赤肉炖服（合猪小肚亦佳），连服三四次。（《泉州本草》）"}]},{"ID":"20240614112545-j3uaxb2","Type":"NodeParagraph","Properties":{"id":"20240614112545-j3uaxb2","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑦治妇人赤白带：蒴藋鲜根每次三两。合猪小肠炖服，连服三至五次。（《泉州本草》）"}]},{"ID":"20240614112545-55yt6j4","Type":"NodeParagraph","Properties":{"id":"20240614112545-55yt6j4","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑧治跌打受伤及骨折疼痛：蒴藋根六钱。酒、水各半煎好，滤去渣，加白糖一两，搅和服。（《江西民间草药》）"}]},{"ID":"20240614112545-zrtl4ey","Type":"NodeParagraph","Properties":{"id":"20240614112545-zrtl4ey","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑨治骨折：鲜血满草根皮及叶，共捣烂外敷。（《云南中草药选》）"}]},{"ID":"20240614112545-qb72qts","Type":"NodeParagraph","Properties":{"id":"20240614112545-qb72qts","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑩治打伤或扭筋肿痛：蒴藋鲜根切碎，同连须葱白、酒酿糟，捣烂敷患处，一日换一次。（《江西民间草药》）"}]},{"ID":"20240614112545-26h7a7g","Type":"NodeParagraph","Properties":{"id":"20240614112545-26h7a7g","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑾治风湿性关节炎，慢性腰腿痛，急性扭伤血肿，水肿：血满草五钱至一荫。煎服或煎水外洗患部。（《云南中草药选》）"}]},{"ID":"20240614112545-mrrrkca","Type":"NodeParagraph","Properties":{"id":"20240614112545-mrrrkca","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑿治打伤吐血：蒴藋干根、侧柏叶各三钱，地榆四钱。煎服。（《浙江民间草药》）"}]},{"ID":"20240614112545-wjlfcon","Type":"NodeParagraph","Properties":{"id":"20240614112545-wjlfcon","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⒀治风疹瘙痒：蒴藋全草，煎水外洗。（广州部队《常用中草药手册》）"}]},{"ID":"20240614112545-h6li3gw","Type":"NodeParagraph","Properties":{"id":"20240614112545-h6li3gw","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⒁治小儿赤游行身上下：蒴藋煎汁洗之。（《子母秘录》）"}]},{"ID":"20240614112545-7uo5rhq","Type":"NodeParagraph","Properties":{"id":"20240614112545-7uo5rhq","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⒂治痈肿恶肉不尽者：蒴藋灰，石灰。上二味各淋取汁，合煎如膏。膏成食恶肉，亦去黑子。此药过十日后不中用。（《千金方》）"}]},{"ID":"20240614112545-oacm3rl","Type":"NodeParagraph","Properties":{"id":"20240614112545-oacm3rl","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⒃治红肿痈毒：蒴藋鲜根或叶切碎捣烂，稍加鸡蛋。捣和，敷患处。（《江西民间草药》）"}]},{"ID":"20240614112545-2tiyjdp","Type":"NodeParagraph","Properties":{"id":"20240614112545-2tiyjdp","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614112545-qoe1oy7","Type":"NodeParagraph","Properties":{"id":"20240614112545-qoe1oy7","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" ①治疗急性菌痢"}]},{"ID":"20240614112545-dr2i21n","Type":"NodeParagraph","Properties":{"id":"20240614112545-dr2i21n","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"100％蒴藋注射液，每6小时肌肉注射2毫升，3、4天后改为每日2次，每次2毫升，至大便正常后停药。治疗57例，痊愈53例，无效4例。大便肉眼观察正常平均为4.9天、镜检正常为5.6天、培养转阴为5.9天。"}]},{"ID":"20240614112545-e9qag7t","Type":"NodeParagraph","Properties":{"id":"20240614112545-e9qag7t","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"②治疗急性化脓性扁桃体炎"}]},{"ID":"20240614112545-405oq6t","Type":"NodeParagraph","Properties":{"id":"20240614112545-405oq6t","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"以100％蒴藋注射液2毫升，肌肉注射，每日2次。治疗20例，全部治愈。治疗时间平均3天。"}]},{"ID":"20240614112545-q91hkin","Type":"NodeParagraph","Properties":{"id":"20240614112545-q91hkin","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"③治疗肺炎"}]},{"ID":"20240614112545-wzc21vy","Type":"NodeParagraph","Properties":{"id":"20240614112545-wzc21vy","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"用100％的蒴藋注射液肌肉注射，2岁以内2毫升，3～4岁3毫升，4岁以上4毫升，均每日2次，至体温正常后3～5天停药。治疗16例，治愈12例，临床症状完全消失，胸透检查炎性病变全部吸收；1例临床症状体征好转，胸透炎性病变大部分吸收；3例无效。"}]},{"ID":"20240614112545-xquuq9h","Type":"NodeParagraph","Properties":{"id":"20240614112545-xquuq9h","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"④治疗慢性气管炎"}]},{"ID":"20240614112545-tfq8iya","Type":"NodeParagraph","Properties":{"id":"20240614112545-tfq8iya","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"用小臭牡丹鲜品茎叶4两，加水煎约1小时，每日3次分服，10日为一疗程。治疗183例，经三个疗程，近期控制40例（26.7％），显效62例（33.8％），好转56例（30.6％），无效16例（8.9％）。据观察，病型与疗效无显著差别，但显效以上的效率，喘息型较单纯型明显增高；对并发肺气肿者也有-定的疗效。本品能解除支气管平滑肌痉挛，故平喘作用较好；并有一定的止咳祛痰作用，但消炎作用较差，有的疗效还不巩固，药物显效时间亦较慢。治程中有2例服药后有轻度头昏、恶心、呕吐及上腹隐痛，1例发生过敏性紫斑。此外，曾采用小臭牡丹滴鼻剂滴鼻，臭草挥发油胶丸内服，亦均有一定近期疗效。"}]},{"ID":"20240614112545-jg1yv8i","Type":"NodeParagraph","Properties":{"id":"20240614112545-jg1yv8i","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑤用于止痛"}]},{"ID":"20240614112545-dfv1pvr","Type":"NodeParagraph","Properties":{"id":"20240614112545-dfv1pvr","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"八棱麻全草粉末装入胶囊，每粒0.3克。痛时服2粒。用于各种手术后切口痛、牙痛、腹痛等100例，92例用药后15～30分钟疼痛明显减轻或消失，有效率达92％。"}]},{"ID":"20240614112545-z1hl46o","Type":"NodeParagraph","Properties":{"id":"20240614112545-z1hl46o","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"⑥治疗骨折"}]},{"ID":"20240614112545-19t2bvt","Type":"NodeParagraph","Properties":{"id":"20240614112545-19t2bvt","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"取落得打根茎，洗净烘干后研成细末，用时掺入少许面粉（4：1），以白酒调成泥状，平铺在纱布上敷于骨折处，再用夹板固定，每5～10天换药1次，每隔1天滴入白酒1次，以加强药性作用。定期作X线检查，一般不同时并用牵引法。早期抬高患肢并作自主性肌肉收缩活动以利消肿，以后适当活动促使功能恢复。治疗各部位闭合性骨折45例，平均治愈时间33～48天。其疗效原理似为：外敷落得打以后，首先对于血管起收缩作用，可使毛细血管肌细胞收缩，致减少或阻止血液由长流毛细血管向网状毛细血管的流入，因而网状毛细血管内压力变低，使组织内水肿液容易被吸收；同时由于血管收缩，长流毛细血管血流加快，又可使在其远心段与网状毛细血管汇合处形成负压样的吸引作用，进一步减低网状毛细血管内压，更有利于渗出液的吸收。由于这种良性循环的形成，外伤性炎症区的静脉回流障碍得以较快的解除，软组织的肿胀得以迅速地消退，疼痛亦随之而减轻，亦有利于骨折的愈合。"}]},{"ID":"20240614112545-c2vi155","Type":"NodeParagraph","Properties":{"id":"20240614112545-c2vi155","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"此外，以100％蒴藋注射液2毫升，每日2次肌肉注射，对多发性疖肿有较好效果。"}]},{"ID":"20240614112545-8ahsyin","Type":"NodeParagraph","Properties":{"id":"20240614112545-8ahsyin","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614112545-7xeomti","Type":"NodeParagraph","Properties":{"id":"20240614112545-7xeomti","updated":"20240614112545"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614112546-yu1uaoj","Type":"NodeThematicBreak","Properties":{"id":"20240614112546-yu1uaoj"}},{"ID":"20240614112547-jxqbxtr","Type":"NodeParagraph","Properties":{"id":"20240614112547-jxqbxtr"}}]}