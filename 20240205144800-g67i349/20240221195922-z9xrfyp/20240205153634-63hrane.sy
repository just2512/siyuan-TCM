 10-20240809095228-yigg3ut.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 616px;\" parent-style=\"width: 626px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 626px;","style":"width: 616px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"酸枣 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/酸枣 11-20240809095303-kjivrom.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 616px;\" parent-style=\"width: 626px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240809094508-kvo86mo","Type":"NodeParagraph","Properties":{"id":"20240809094508-kvo86mo","updated":"20240809094526"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"酸枣 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/酸枣 2-20240809094508-lqxk25m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"酸枣 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/酸枣 3-20240809094526-hgnl1pm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607142357-vqtfzm3","Type":"NodeThematicBreak","Properties":{"id":"20240607142357-vqtfzm3"}},{"ID":"20240607142541-ufrwnpc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142541-ufrwnpc","updated":"20240607142541"},"Children":[{"Type":"NodeText","Data":"酸枣《神农本草经》"}]},{"ID":"20240607142541-pbkfc54","Type":"NodeParagraph","Properties":{"id":"20240607142541-pbkfc54","updated":"20240607142541"},"Children":[{"Type":"NodeText","Data":"味酸平。"}]},{"ID":"20240607142541-xdmg0gz","Type":"NodeParagraph","Properties":{"id":"20240607142541-xdmg0gz","updated":"20240607142541"},"Children":[{"Type":"NodeText","Data":"主心腹寒热，邪结气聚，四肢酸疼，湿痹。久服安五藏，轻身延年。生川泽。"}]},{"ID":"20240607142541-2ppzst0","Type":"NodeParagraph","Properties":{"id":"20240607142541-2ppzst0","updated":"20240607142541"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生河东，八月采实，阴干，四十日成。"}]},{"ID":"20240607142541-8cpwgcq","Type":"NodeParagraph","Properties":{"id":"20240607142541-8cpwgcq","updated":"20240607142541"},"Children":[{"Type":"NodeText","Data":"案《说文》云：樲，酸枣也；《尔雅》云：樲，酸枣；郭璞云："}]},{"ID":"20240607142541-ytuxw8j","Type":"NodeParagraph","Properties":{"id":"20240607142541-ytuxw8j","updated":"20240607142541"},"Children":[{"Type":"NodeText","Data":"味小实酢；孟子云：养其樲棘；赵岐云：樲棘，小棘，所谓酸枣是也。"}]},{"ID":"20240607142337-sdtktfu","Type":"NodeThematicBreak","Properties":{"id":"20240607142337-sdtktfu"}},{"ID":"20240607142402-er4lib9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142402-er4lib9","updated":"20240607142407"},"Children":[{"Type":"NodeText","Data":"酸枣《本草蒙筌》"}]},{"ID":"20240607142402-0dvz0h6","Type":"NodeParagraph","Properties":{"id":"20240607142402-0dvz0h6","updated":"20240607142402"},"Children":[{"Type":"NodeText","Data":"味酸，气平。无毒。生河东川泽，秋采实阴干。因肉味酸，故名酸枣。凡仗入药，碎核取仁。粒遍色丹，亦不易得。市家往往以棘实充卖，不可不细认焉。能治多眠不眠，必分生用炒用。多眠胆实有热，生研末，取茶叶姜汁调吞；不眠胆虚有寒，炒作散，采竹叶煎汤送下。倘和诸药共剂，却恶防己须知。宁心志，益肝补中。敛虚汗，驱烦止渴。去心腹寒热，五脏能安。疗手足酸疼，筋骨堪健。久服长寿，且令人肥。核壳烧末水调，刺入肉中敷效。"}]},{"ID":"20240607142402-wmt8egd","Type":"NodeThematicBreak","Properties":{"id":"20240607142402-wmt8egd"}},{"ID":"20240607142432-xx8yi2f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142432-xx8yi2f","updated":"20240607142437"},"Children":[{"Type":"NodeText","Data":"酸枣《本草纲目》"}]},{"ID":"20240607142432-n4wwy84","Type":"NodeParagraph","Properties":{"id":"20240607142432-n4wwy84","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"「释名」山枣。"}]},{"ID":"20240607142432-ck37ygu","Type":"NodeParagraph","Properties":{"id":"20240607142432-ck37ygu","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"「气味」（酸枣）酸、平、无毒。"}]},{"ID":"20240607142432-2mmo22h","Type":"NodeParagraph","Properties":{"id":"20240607142432-2mmo22h","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240607142432-ajmqgf9","Type":"NodeParagraph","Properties":{"id":"20240607142432-ajmqgf9","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"1、胆风沉星（胆风毒气，虚实不调，昏沉多睡）。用酸枣仁一两（生用）、蜡茶二两，以生姜汁涂炙微焦为散。每取二钱，加水七分煎至六分，温服。"}]},{"ID":"20240607142432-nkdd2mu","Type":"NodeParagraph","Properties":{"id":"20240607142432-nkdd2mu","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"2、胆虚不眠（心多惊悸）。用酸枣仁一两，炒香，捣为散。每服二钱，竹叶汤调下。又方：再加人参一两、辰砂半两、乳香二钱半，调炬蜜做成丸子服下。"}]},{"ID":"20240607142432-67tvttu","Type":"NodeParagraph","Properties":{"id":"20240607142432-67tvttu","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"3、振悸不眠。用酸枣仁二升，茯苓、白术、人参、甘草各二两，生姜六两，加水八升，煮成三分，分次服。此方称“酸枣仁汤”。"}]},{"ID":"20240607142432-3ui97nu","Type":"NodeParagraph","Properties":{"id":"20240607142432-3ui97nu","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"4、虚烦不眠。用酸枣仁二升，母、干姜、茯苓、芎各二两，甘草（炙）一两，先以水一斗煮枣仁，得汁七程式，再放入其余各药同煮，最后得汁三程式，分次服下。此方名“酸枣仁汤”。"}]},{"ID":"20240607142432-xpdteam","Type":"NodeParagraph","Properties":{"id":"20240607142432-xpdteam","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"5、骨蒸不眠。用酸枣仁一两，加水二碗研绞取汁，下粳米二合煮粥。粥熟后，再下地黄汁一合，煮匀吃下。"}]},{"ID":"20240607142432-d31s35x","Type":"NodeParagraph","Properties":{"id":"20240607142432-d31s35x","updated":"20240607142432"},"Children":[{"Type":"NodeText","Data":"6、盗汗，用酸枣仁、人参、茯苓，等分为末，每服一钱，米汤送下。"}]},{"ID":"20240607142447-22fa79a","Type":"NodeThematicBreak","Properties":{"id":"20240607142447-22fa79a"}},{"ID":"20240607142507-81gk27p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142507-81gk27p","updated":"20240607142519"},"Children":[{"Type":"NodeText","Data":"酸枣《证类本草》"}]},{"ID":"20240607142513-fhaki5m","Type":"NodeParagraph","Properties":{"id":"20240607142513-fhaki5m","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主心腹寒热，邪结气聚，四肢酸疼，湿痹，烦心不得眠，脐上下痛，血转久泄，虚汗烦渴，补中，益肝气，坚筋骨，助阴气，令人肥健。久服安五脏，轻身延年。"}]},{"ID":"20240607142513-5y3gn6k","Type":"NodeParagraph","Properties":{"id":"20240607142513-5y3gn6k","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"生河东川泽。八月采实，阴干，四十日成。（恶防己。）"}]},{"ID":"20240607142513-m3eyend","Type":"NodeParagraph","Properties":{"id":"20240607142513-m3eyend","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出东山间，云即是山枣树。子似武昌枣而味极酸，东人啖之以醒睡，与此疗不得眠，正反矣。唐本注云∶此即 （贰）枣实也，树大如大枣，实无常形，但大枣中味酸者是。《本经》唯用实，疗不得眠，不言用人。今方用其人，补中益气，自补中益肝以下，此为酸枣仁之功能。又于下品白棘条中，复云用其实。今医以棘实为酸枣，大误。今注陶云醒睡，而《经》云疗不得眠。盖其子肉味酸，食之使不思睡，核中仁，服之疗不得眠，正如麻黄发汗，根节止汗也。此乃棘实，更非他物。若谓是大枣味酸者，全非也。酸枣小而圆，其核中仁微扁；大枣仁大而长，不类也。臣禹锡等谨按蜀本图经云∶今河东及滑州，以其木为车轴及匙箸等，木甚细理而硬，所在有之。八月采实，晒干。药性论云∶酸枣仁，主筋骨风，炒末作汤服之。陈藏器云∶按酸枣，既是枣中之酸，更无他异，此即真枣，何复名酸，既云其酸，又云其小，今枣中酸者，未必即小，小者未必即酸，虽欲为枣生文，展转未离于枣，若道枣中酸者，枣条无令睡之功，道棘子不酸，今人有众呼之目。枣、棘一也。酸、甜两焉。纵令以枣当之，终其非也。嵩阳了曰∶余家于滑台。今酸枣县，即滑之属邑也。其地名酸枣焉，其树高数丈，径围一、二尺，木理极细，坚而且重，其树皮亦细纹似蛇鳞。其枣圆小而味酸，其核微圆，其仁稍长，色赤如丹。此医之所重，居人不易得。今市之卖者，皆棘子为之。又云山枣树如棘，子如生枣，里有核如骨，其肉酸滑好食，山人以当果。五代史后唐刊《石药验》云∶酸枣仁睡多生使，不得睡炒熟。日华子云∶酸枣仁治脐下满痛。"}]},{"ID":"20240607142513-7gvqz7l","Type":"NodeParagraph","Properties":{"id":"20240607142513-7gvqz7l","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"图经曰∶酸枣，生河东川泽，今近京及西北州郡皆有之，野生多在坡 及城垒间。似枣木而皮细，其木心赤色，茎、叶俱青，花似枣花。八月结实，紫红色，似枣而圆小味酸。"}]},{"ID":"20240607142513-mqy2wfn","Type":"NodeParagraph","Properties":{"id":"20240607142513-mqy2wfn","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"当月采实，取核中仁，阴干，四十日成。《尔雅》辨枣之种类曰∶实小而酸，曰 枣。《孟子》曰∶养其 枣。赵歧注∶所谓酸枣是也。一说唯酸枣县出者为真，其木高数丈，径围一、二尺，木理极细，坚而且重，邑人用为车轴及匕箸。其皮亦细，纹似蛇鳞。其核仁稍长而色赤如丹，亦不易得。今市之货者，皆棘实耳，用之尤宜详辨也。《本经》主烦心不得眠。今医家两用之，睡多生使，不得睡炒熟。生熟便尔顿异。而胡洽治振悸不得眠，有酸枣仁汤∶酸枣仁二升，茯苓、白术、人参、甘草各二两，生姜六两，六物切，以水八升，煮取三升，分四服。深师主虚不得眠，烦不可宁，有酸枣仁二汤∶酸枣仁二升， 母、干姜、茯苓、芎各二两，甘草一两炙，并切，以水一斗，先煮枣，减三升后，纳五物，煮取三升，分服。一方更加桂一两。二汤酸枣并生用，疗不得眠，岂便以煮汤为熟乎？"}]},{"ID":"20240607142513-xas84t1","Type":"NodeParagraph","Properties":{"id":"20240607142513-xas84t1","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"雷公云∶酸枣仁，凡使，采得后晒干，取叶重拌酸枣仁蒸半日了，去尖皮了，任研用。"}]},{"ID":"20240607142513-did44rj","Type":"NodeParagraph","Properties":{"id":"20240607142513-did44rj","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"食疗酸枣，平。主寒热结气，安五脏，疗不得眠。圣惠方治胆虚睡卧不安，心多惊悸。用酸枣仁一两，炒令香熟，捣细为散。每服二钱，竹叶汤调下，不计时候服。又方治夜不眠睡。"}]},{"ID":"20240607142513-4n3wwhu","Type":"NodeParagraph","Properties":{"id":"20240607142513-4n3wwhu","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"用酸枣仁半两，炒黄研末，以酒三合浸汁，先以粳米三合煮作粥，临熟下枣仁汁，更煮三、五沸。空心食之。又方治骨蒸劳，心烦不得眠卧。用酸枣仁二两，水二大盏，半研绞取汁，下米二合煮粥，候熟下地黄汁一合，更渐煮过。不计时候食之。外台秘要疗齿虫腐烂，棘针二百枚即是枣树棘朽落地者。以水二升，煎取一升含之，日四、五度，即瘥。又方疗刺在仁肉中不出。酸枣仁核烧末，水服之，立便得出。简要济众治胆风毒瓦斯，虚实不调，昏沉睡多。"}]},{"ID":"20240607142513-e7b101o","Type":"NodeParagraph","Properties":{"id":"20240607142513-e7b101o","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"酸枣仁一两生用，金挺腊茶二两，以生姜汁涂，炙令微焦，捣罗为散。每服二钱，水七分，煎六分，无时温服。"}]},{"ID":"20240607142513-bkrt3md","Type":"NodeParagraph","Properties":{"id":"20240607142513-bkrt3md","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"衍义曰∶酸枣，微热，《经》不言用仁，仍疗不得眠。天下皆有之，但以土产宜与不宜。"}]},{"ID":"20240607142513-nj71n36","Type":"NodeParagraph","Properties":{"id":"20240607142513-nj71n36","updated":"20240607142513"},"Children":[{"Type":"NodeText","Data":"嵩阳子曰∶酸枣县，即滑之属邑。其木高数丈，味酸，医之所重。今市人卖者皆棘子，此说未尽。殊不知小则为棘，大则为酸枣，平地则易长，居崖堑则难生。故棘多生崖堑上，久不樵则成干，人方呼为酸枣，更不言棘，徒以世人之意如此，在物则曷若是也。其实一本。以其不甚为世所须，及碍塞行路，故成大木者少，多为人樵去。然此物才及三尺，便开花结子，但并可取仁。后有白棘条，乃是酸枣未长大时，枝上刺也。及至长成，其刺亦少，实亦大。故枣取大木，刺取小窠也，亦不必强分别尔。"}]},{"ID":"20240607142514-4bc32f1","Type":"NodeThematicBreak","Properties":{"id":"20240607142514-4bc32f1"}},{"ID":"20240607142602-l7tbw9f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142602-l7tbw9f","updated":"20240607142605"},"Children":[{"Type":"NodeText","Data":"酸枣《千金翼方》"}]},{"ID":"20240607142602-y5pelus","Type":"NodeParagraph","Properties":{"id":"20240607142602-y5pelus","updated":"20240607142602"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主心腹寒热，邪结气聚，四肢酸疼，湿痹，烦心不得眠，脐上下痛，血转久泻，虚汗烦渴，补中，益肝气，坚筋骨，助阴气，令人肥健。久服安五脏，轻身延年。"}]},{"ID":"20240607142602-ykz1ncm","Type":"NodeParagraph","Properties":{"id":"20240607142602-ykz1ncm","updated":"20240607142602"},"Children":[{"Type":"NodeText","Data":"生河东川泽，八月采实，阴干，四十日成。"}]},{"ID":"20240607142606-4qr08ba","Type":"NodeThematicBreak","Properties":{"id":"20240607142606-4qr08ba"}},{"ID":"20240607142611-x92nf1r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142611-x92nf1r","updated":"20240607142616"},"Children":[{"Type":"NodeText","Data":"酸枣《汤液本草》"}]},{"ID":"20240607142611-7id0twy","Type":"NodeParagraph","Properties":{"id":"20240607142611-7id0twy","updated":"20240607142611"},"Children":[{"Type":"NodeText","Data":"气平，味酸。无毒。"}]},{"ID":"20240607142611-5vkz819","Type":"NodeParagraph","Properties":{"id":"20240607142611-5vkz819","updated":"20240607142611"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主心腹寒热，邪结气聚，四肢酸疼湿痹，烦心不得眠，脐上下痛，血转久泄，虚汗烦渴；补中、益肝气，坚筋骨，助阴气，令人肥健。久服，安五脏、轻身、延年。"}]},{"ID":"20240607142611-2pkf7hh","Type":"NodeParagraph","Properties":{"id":"20240607142611-2pkf7hh","updated":"20240607142611"},"Children":[{"Type":"NodeText","Data":"胡洽治振悸不得眠，人参、白术、白茯苓、甘草、生姜、酸枣仁六物煮服。"}]},{"ID":"20240607142611-157rdnb","Type":"NodeParagraph","Properties":{"id":"20240607142611-157rdnb","updated":"20240607142611"},"Children":[{"Type":"NodeText","Data":"《圣惠方》∶胆虚不眠，寒也。酸枣仁炒香，竹叶汤调服。"}]},{"ID":"20240607142611-t8da124","Type":"NodeParagraph","Properties":{"id":"20240607142611-t8da124","updated":"20240607142611"},"Children":[{"Type":"NodeText","Data":"《济众方》∶胆实多睡，热也。酸枣仁生用，末，茶、姜汁调服。"}]},{"ID":"20240607142612-m5aw4n7","Type":"NodeThematicBreak","Properties":{"id":"20240607142612-m5aw4n7"}},{"ID":"20240617103733-rd2ooai","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103733-rd2ooai","updated":"20240617103740"},"Children":[{"Type":"NodeText","Data":"酸枣《本草衍义》"}]},{"ID":"20240617103733-gkh905j","Type":"NodeParagraph","Properties":{"id":"20240617103733-gkh905j","updated":"20240617103733"},"Children":[{"Type":"NodeText","Data":"酸枣微热。经不言用仁，仍疗不得眠。天下皆有之，但以土产宜与不宜。嵩阳子曰∶“酸枣县，即滑之属邑，其木高数丈，味酸，医之所重。今市人卖者，皆棘子。”此说未尽。殊不知小则为棘，大则为酸枣，平地则易长，居崖堑则难生。故枣多生崖堑上，久不樵则成干，人方呼为酸枣，更不言棘，徒以世人之意如此，在物则曷若是也，其实一本。以其不甚为世所须，及碍塞行路，故成大木者少，多为人樵去。然此物才及三尺，便开花结子。但窠小者气味薄，本大者气味浓，又有此别。今陕西临潼山野所出者亦好，亦土地所宜也，并可取仁。后有白棘条，乃是酸枣未为大时，枝上刺也。及至长成，其刺亦少，实亦大。故枣取大木，刺取小窠也，亦不必强分别尔。"}]},{"ID":"20240617103733-dz2q74y","Type":"NodeThematicBreak","Properties":{"id":"20240617103733-dz2q74y"}},{"ID":"20240617103748-gyiodq2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103748-gyiodq2","updated":"20240617103752"},"Children":[{"Type":"NodeText","Data":"酸枣《新修本草》"}]},{"ID":"20240617103748-buja1n7","Type":"NodeParagraph","Properties":{"id":"20240617103748-buja1n7","updated":"20240617103748"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主心腹寒热，邪结气，四肢酸疼湿痹，烦心不得眠，脐上下痛，血转、久益肝气，坚筋大骨，助阴气，令人肥健。久服安五脏，轻身延年。"}]},{"ID":"20240617103748-t0e2cbl","Type":"NodeParagraph","Properties":{"id":"20240617103748-t0e2cbl","updated":"20240617103748"},"Children":[{"Type":"NodeText","Data":"生河东川泽。八月采实，阴干卅日成。"}]},{"ID":"20240617103748-0q03q0m","Type":"NodeParagraph","Properties":{"id":"20240617103748-0q03q0m","updated":"20240617103748"},"Children":[{"Type":"NodeText","Data":"恶防己。今出东山间，云即是山枣树子，子似武昌枣，而味极酸，东人乃啖之以醒睡，与此疗不得眠，正反矣。"}]},{"ID":"20240617103748-unvqdnn","Type":"NodeParagraph","Properties":{"id":"20240617103748-unvqdnn","updated":"20240617103748"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此即 枣实也，树大如大枣，实无常形，但大枣中味酸者是。《本经》唯用实，疗不得眠，不言用仁。今方用其仁，补中益气。自补中益肝以下，此为酸枣仁之功能。又于下品白棘条中，复云用其实。今医以棘实为酸枣，大误矣。"}]},{"ID":"20240617103748-7s3wnmd","Type":"NodeThematicBreak","Properties":{"id":"20240617103748-7s3wnmd"}},{"ID":"20240617104036-kqt5ai5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104036-kqt5ai5","updated":"20240617104041"},"Children":[{"Type":"NodeText","Data":"酸枣《本草图经》"}]},{"ID":"20240617104036-a182h28","Type":"NodeParagraph","Properties":{"id":"20240617104036-a182h28","updated":"20240617104036"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"酸枣"},{"Type":"NodeText","Data":"，生河东川泽，今近京及西北州郡皆有之，野生多在坡 及城垒间。似枣木而皮细，其木心赤色；茎、叶俱青；花似枣花；八月结实，紫红色，似枣而圆小，味酸。当月采实，取核中仁，阴干，四十日成。《尔雅》辨枣之种类曰∶实小而酸，曰 枣。《孟子》曰∶养其枣。赵岐注∶所谓酸枣是也。一说惟酸枣县出者为真，其木高数丈，径围一、二尺，木理极细，坚而且重，邑人用为车轴及匕筋；其皮亦细，纹似蛇鳞；其核仁稍长，而色赤如丹，亦不易得。今市之货者，皆棘实耳，用之尤宜详辨也。《本经》主烦心不得眠。今医家两用之，睡多生使，不得睡炒熟，生熟便尔顿异。而胡洽治振悸不得眠，有酸枣仁汤∶酸枣仁二升，茯苓、白术、人参、甘草各二两，生姜六两，六物切，以水八升，煮取三升，分四服。深师主虚不得眠，烦不可宁，有酸枣仁汤∶酸枣仁二升， 母、干姜、茯苓，芎 各二两，甘草一两炙，二汤酸枣并生用，疗不得眠，岂便以煮汤为熟乎？"}]},{"ID":"20240617104036-ha4fwfg","Type":"NodeThematicBreak","Properties":{"id":"20240617104036-ha4fwfg","updated":"20240617104036"}},{"ID":"20240617103757-mb1is1g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103757-mb1is1g","updated":"20240617103808"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草便读》"}]},{"ID":"20240617103757-iw459xg","Type":"NodeParagraph","Properties":{"id":"20240617103757-iw459xg","updated":"20240617103757"},"Children":[{"Type":"NodeText","Data":"入肝脏藏魂镇摄．用疗胆怯无眠．走心家敛液固虚．可治表疏有汗．性颇平滑．味属甘酸．（酸枣仁凡仁皆可入心．酸者皆入肝．酸甘而平．润泽之品．故能入心肝．敛液固虚．但善滑大肠．至于炒熟．治胆虚不眠．生用治胆热好眠之说．亦习俗相沿．究竟不眠好眠．各有成病之由．非一物枣仁可以统治也．）"}]},{"ID":"20240617103758-fw0nw52","Type":"NodeThematicBreak","Properties":{"id":"20240617103758-fw0nw52"}},{"ID":"20240617103813-0lu6rzn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103813-0lu6rzn","updated":"20240617103819"},"Children":[{"Type":"NodeText","Data":"酸枣仁《药鉴》"}]},{"ID":"20240617103813-zrymrmu","Type":"NodeParagraph","Properties":{"id":"20240617103813-zrymrmu","updated":"20240617103813"},"Children":[{"Type":"NodeText","Data":"气平，味甘酸，无毒。能安和五脏，大补心脾。故血不归脾，而睡卧不宁者，多用之。"}]},{"ID":"20240617103813-eint4ze","Type":"NodeParagraph","Properties":{"id":"20240617103813-eint4ze","updated":"20240617103813"},"Children":[{"Type":"NodeText","Data":"盖血不归脾，则五脏不安和，而睡卧自不宁矣。今既大补心脾，则血归脾，而五脏和，睡卧岂有不宁者哉。然心家有实热者，生研为良，心家若虚寒者，炒研才妙。"}]},{"ID":"20240617103813-97ziwxr","Type":"NodeThematicBreak","Properties":{"id":"20240617103813-97ziwxr"}},{"ID":"20240617103824-5o65gbp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103824-5o65gbp","updated":"20240617103830"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草经解》"}]},{"ID":"20240617103824-qigdjm5","Type":"NodeParagraph","Properties":{"id":"20240617103824-qigdjm5","updated":"20240617103824"},"Children":[{"Type":"NodeText","Data":"气平．味酸．无毒．主心腹寒热．邪结气聚．四肢酸痛．湿痹．久服安五脏．轻身延年．（炒研）"}]},{"ID":"20240617103824-jbstubl","Type":"NodeParagraph","Properties":{"id":"20240617103824-jbstubl","updated":"20240617103824"},"Children":[{"Type":"NodeText","Data":"枣仁气平．禀天秋敛之金气．入手太阴肺经．味酸无毒．得地东方之木味．入足厥阴肝经、手厥阴风木心包络经．气味俱降．阴也．心者胸臆之分．手厥阴心包络脉起之处．腹者中脘之分．足厥阴肝经行之地．心包络主热．肝主寒．厥阴主散．不能散则寒热邪结气聚矣．枣仁味酸．入厥阴．厥阴和．则结者散也．四肢者手足也．两厥阴经行之地也．酸痛湿痹．风湿在厥阴络也．枣仁味酸益血．血行风息．气平益肺．肺理湿行．所以主之也．心包络者．心之臣使也．代君行事之经也．肝者生生之脏．发荣之主也．久服枣仁．则厥阴阴足．所以五脏皆安．气平益肺．所以轻身延年也．"}]},{"ID":"20240617103824-7wzrha9","Type":"NodeParagraph","Properties":{"id":"20240617103824-7wzrha9","updated":"20240617103824"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240617103824-ouoiila","Type":"NodeParagraph","Properties":{"id":"20240617103824-ouoiila","updated":"20240617103824"},"Children":[{"Type":"NodeText","Data":"枣仁同茯神、远志、麦冬、石斛、五味、圆肉、人参．治惊悸．同生地、白芍、麦冬、五味、圆肉、竹叶．治自汗．同茯神、人参．治盗汗．同人参、茯神、白术、甘草．治振悸不眠．同知母、茯神、甘草．名酸枣仁汤．治虚烦不眠．"}]},{"ID":"20240617103825-43lw2bf","Type":"NodeThematicBreak","Properties":{"id":"20240617103825-43lw2bf"}},{"ID":"20240617103843-1l7csvo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103843-1l7csvo","updated":"20240617103850"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草述钩元》"}]},{"ID":"20240617103843-5jpnemv","Type":"NodeParagraph","Properties":{"id":"20240617103843-5jpnemv","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"本经用实。今皆用仁。"}]},{"ID":"20240617103843-fwvbal2","Type":"NodeParagraph","Properties":{"id":"20240617103843-fwvbal2","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"味酸辛甘。气平。微热。阳中之阴。入足少阳厥阴手少阴足太阴之经。恶防己。主治心腹寒热。邪结气聚。除四肢酸痛湿痹。疗烦心不得眠。补中益肝气。宁心志。敛虚汗。"}]},{"ID":"20240617103843-j881eum","Type":"NodeParagraph","Properties":{"id":"20240617103843-j881eum","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"去筋骨风。助阴气。方书更治中风虚劳。癫狂惊痫。振颤挛悸。虚烦健忘。消瘅。善太息。"}]},{"ID":"20240617103843-afr5xrw","Type":"NodeParagraph","Properties":{"id":"20240617103843-afr5xrw","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"赤白浊。着痹胁痛。腰痛咽喉。胆虚不眠。寒也。炒熟枣仁为末。竹叶汤调服。胆实多睡。"}]},{"ID":"20240617103843-3gyspw1","Type":"NodeParagraph","Properties":{"id":"20240617103843-3gyspw1","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"热也。生枣仁为末。姜茶汁调服。（海藏）血不归脾而睡卧不宁者。宜用此大补心脾。俾血归脾而五脏安和。宁神就睡。（丹溪）枣仁得木之气而兼土化。专补肝胆。亦复醒脾。"}]},{"ID":"20240617103843-mpl5psq","Type":"NodeParagraph","Properties":{"id":"20240617103843-mpl5psq","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"从其类也。熟者香气入脾。故能补脾。又补胆气。故可温胆。母子之气通。故亦主心虚惊悸等病。入温胆汤。治病后胆虚不眠。入归脾汤。治脾家气血虚自汗。不眠惊悸。不嗜食。"}]},{"ID":"20240617103843-hy2jq5n","Type":"NodeParagraph","Properties":{"id":"20240617103843-hy2jq5n","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"君茯神远志麦冬石斛五味人参龙眼。止惊悸。并一切胆虚易惊。睡中盗汗。枣仁茯苓人参等分。为末。每服一钱。米饮下。凡服固表药而汗不止者。用枣仁炒研一两。同地黄白芍麦冬五味龙眼肉竹叶煎服。多服取效。自汗。服诸止汗固表药愈涩。而汗愈不收者。止可理心血。盖汗乃心液。心无取养不能摄血。故溢而为汗也。以大补黄汤加枣仁。有微热者。"}]},{"ID":"20240617103843-qbz4f1u","Type":"NodeParagraph","Properties":{"id":"20240617103843-qbz4f1u","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"更加石斛。兼下灵砂丹。胆风沉睡。（胆风毒瓦斯。虚实不调。）枣仁生用一两。全挺腊茶二两。以生姜汁涂。炙微焦为散。每服二钱。水煎温服。痰在胆经。神不归舍。亦令不寐。"}]},{"ID":"20240617103843-epyp7ep","Type":"NodeParagraph","Properties":{"id":"20240617103843-epyp7ep","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"宜温胆汤。减竹茹一半。加南星炒枣仁各一钱。下青灵丹。虚劳虚烦不得眠。枣仁炒二升。"}]},{"ID":"20240617103843-x8jv3px","Type":"NodeParagraph","Properties":{"id":"20240617103843-x8jv3px","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"甘草一两。知母茯苓芎各二两。以水一斗。先煮枣仁。减三升。乃同煮。取三升。分服。病后虚弱。及高年阳衰不寐。六君子加炒枣仁炙黄各一钱。骨蒸心烦不眠。枣仁一两。水二盏。研绞取汁。下粳米二合。煮粥候熟。下地黄汁一合。再煮匀食。虚劳筋极。脚手拘挛。指甲痛。数转筋。甚则舌卷卵缩。唇青面黑。木瓜虎胫骨酥炙五加皮当归酒浸桑寄生人参黄柏仁枣仁各一两。炙甘草半两。每服四钱。水一盏。姜五片。煎服。喉舌生疮菌。"}]},{"ID":"20240617103843-ejxbylf","Type":"NodeParagraph","Properties":{"id":"20240617103843-ejxbylf","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"真琥珀生犀屑各一钱。人参枣仁去皮茯神去皮木辰砂各二钱。片脑一字。为末。炼蜜和为膏。"}]},{"ID":"20240617103843-grzlpft","Type":"NodeParagraph","Properties":{"id":"20240617103843-grzlpft","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"磁器收贮。疾作。每服一弹〔论〕酸枣仁所治。有多眠不眠之异。即本经首主寒热结气一语。足以概之。盖寒热即阴阳之气。结而聚。则不得其合和而为阴阳之偏。凡多眠是阴胜于阳。宜以疏阴为先。生用此味。不眠则阳胜于阴。宜以益阴为先。熟用此味。（所谓宜疏。即曰实。所谓宜益。即曰虚。究之阴阳。各处其虚。非多眠属实。而不眠属虚。）疏阴者。导阴而使之化也。补阴者。滋阴而俾之生也。生化之机合。缪氏故谓补血无如酸枣也。（生化之机合。则邪不得结。"}]},{"ID":"20240617103843-rhwdray","Type":"NodeParagraph","Properties":{"id":"20240617103843-rhwdray","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"气举身中阴阳。其气为寒为热而偏胜者。即结聚于中。惟足少阳表里一身。足厥阴为阴阳独使。故不论感伤寒热之错出。以变生中外者。先受于肝胆二经。而阴跷阳跷。行身左右之脉。实合之（足少阳厥阴脉行身之侧）以见所患之证。如不眠多眠是也。（卫气不得入于阴。"}]},{"ID":"20240617103843-nzwfhiq","Type":"NodeParagraph","Properties":{"id":"20240617103843-nzwfhiq","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"常留于阳。阳气满。阳跷盛。阴气虚。故目不瞑也。卫气留于阴。不得行于阳。阴气盛。阴跷满。阳气虚。故目闭也。此不眠及多眠之故。）枣仁专入肝胆血分。生用以治多眠者。"}]},{"ID":"20240617103843-vntv3bb","Type":"NodeParagraph","Properties":{"id":"20240617103843-vntv3bb","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"疏阴中之壅气以致于阳也。其味酸而归于辛也。炒熟以治不眠者。发阴中之和气以召乎阳也。"}]},{"ID":"20240617103843-w1whtwo","Type":"NodeParagraph","Properties":{"id":"20240617103843-w1whtwo","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"其味酸辛而更归于甘也。阴中之壅气。疏之而能致于阳。则气之偏结于阴者。不病于寒矣。"}]},{"ID":"20240617103843-ab25wpl","Type":"NodeParagraph","Properties":{"id":"20240617103843-ab25wpl","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"阴中之和气。发之而能召乎阳。则气之偏结于阳者。不病于热矣。其为肝胆血分之要剂。职是故欤。方书枣仁首治中风。盖因入肝胆益血。血脏即风脏。故病于风者。即以益同脏之血治之。至于挛惊癫狂诸证。皆虚风之治也。其补虚。自肝而外。当先属胆。次即属心。以心为肝子。肝脏血虚。心已先亏其化源。故欲补心血。而不裕其用于肝。则生化之源无地也。此外有治心肾不交之证者。以肝为一阴。一阴为独使。肝脏之血。原于水而成于火。枣仁之交水火。正因其为厥阴经药耳。又阳跷阴跷二脉。足少阴肾之别脉也。方书治心肾不交。"}]},{"ID":"20240617103843-vnm67wh","Type":"NodeParagraph","Properties":{"id":"20240617103843-vnm67wh","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"故入兹味于诸药中。"}]},{"ID":"20240617103843-xbpcjgr","Type":"NodeParagraph","Properties":{"id":"20240617103843-xbpcjgr","updated":"20240617103843"},"Children":[{"Type":"NodeText","Data":"性味酸敛。凡肝胆脾三经有实邪而热者。勿用。（仲淳）〔修事〕粒粗。勿碎皮者良。炒爆研细入药。如砂仁法。勿隔宿。"}]},{"ID":"20240617103844-4z99yxb","Type":"NodeThematicBreak","Properties":{"id":"20240617103844-4z99yxb"}},{"ID":"20240617103855-q6pbwe7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103855-q6pbwe7","updated":"20240617103901"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草求真》"}]},{"ID":"20240617103855-crmo8cc","Type":"NodeParagraph","Properties":{"id":"20240617103855-crmo8cc","updated":"20240617103855"},"Children":[{"Type":"NodeText","Data":"（灌木）收肝胆虚热不眠"}]},{"ID":"20240617103855-gtlhm1w","Type":"NodeParagraph","Properties":{"id":"20240617103855-gtlhm1w","updated":"20240617103855"},"Children":[{"Type":"NodeText","Data":"酸枣仁（专入肝胆。兼入脾）。甘酸而润。仍有生熟之分。生则能导虚热。故疗肝热好眠。神昏燥倦之症。熟则津液。故疗胆虚不眠。烦渴虚汗之症。（志曰。按五代史后唐刊石药验云。酸枣仁睡多生使。不得睡炒熟。陶云。食之醒睡。而经云疗不得眠。盖其子肉味酸。食之使不思睡。核中仁服之。疗不得眠。正如麻黄发汗。根节止汗也。）本肝胆二经要药。因其气香味甘。故又能舒太阴之脾。（时珍曰。今人专以为心家药。殊昧此理。）按肝虚则阴伤而心烦。而魂不能藏。（肝藏魂。）是以不得眠也。故凡伤寒虚烦多汗。及虚人盗汗。皆炒熟用之。取其肝脾之津液也。（如心多惊悸。用酸枣仁一两。炒香。捣为散。每服二钱。竹叶汤调下。又温胆汤或加枣仁。金匮治虚劳虚烦。用酸枣仁汤。枣仁三升。甘草一两炙。知母茯苓芎 各二两。深师加生姜二两。此补肝之剂。）归脾汤用以滋营气。亦以营气得养。则肝自藏魂而弥安。血自归脾而卧见矣。其曰胆热好眠可疗。因其胆被热淫。神志昏冒。故似好眠。其症仍兼烦燥。用此（同茶）疗热。热疗则神清气爽。又安有好眠之弊乎？（汪昂曰。温胆汤治不眠。内用二陈加竹茹枳实凉味。乃凉肺泻胃之热以温胆之寒也。其以温胆名汤者。以胆欲不寒不燥。常温为候耳。）但仁性多润。滑泄最忌。纵使香能舒脾。难免润不受滑矣。附记以补书所未及。炒研用。（炒久则油香不香。碎久则气味俱失。便难见功。）恶防己。"}]},{"ID":"20240617103856-26ap9hi","Type":"NodeThematicBreak","Properties":{"id":"20240617103856-26ap9hi"}},{"ID":"20240617103905-i90u5qg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103905-i90u5qg","updated":"20240617103912"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草新编》"}]},{"ID":"20240617103905-7v4gyp9","Type":"NodeParagraph","Properties":{"id":"20240617103905-7v4gyp9","updated":"20240617103905"},"Children":[{"Type":"NodeText","Data":"酸枣仁，味酸，气平，无毒。入心、肝、胆与胞络四经。宁心志，益肝胆，补中，敛虚汗，祛烦止渴，安五脏，止手足酸痛，且健筋骨，久服多寿。以上治疗，俱宜炒用，惟夜不能眠者，必须生用，或神思昏倦，久苦梦遗者，亦宜生用。可为臣佐，多用尤佳，常服亦妙也。"}]},{"ID":"20240617103905-uzdi93p","Type":"NodeParagraph","Properties":{"id":"20240617103905-uzdi93p","updated":"20240617103905"},"Children":[{"Type":"NodeText","Data":"或问酸枣仁只能益心，何以补肾之药，古人往往用之乎？盖心肾原不可两治也。因世人贪色者多，仲景夫子所以只立六味、八味，以补肾中之水火宜。然而肾火原通于胞络，而肾水原通于心，补心未尝不能益肾，古人所以用枣仁以安心，即安肾也。且世人入房而强战者，心君不动，而相火乃克其力以用命。心君一移，而相火即懈，精即下泄，可见补心所以补肾，心气足而肾气更坚，不信然哉。"}]},{"ID":"20240617103905-esc48w9","Type":"NodeParagraph","Properties":{"id":"20240617103905-esc48w9","updated":"20240617103905"},"Children":[{"Type":"NodeText","Data":"或问酸枣仁之治心也，不寐则宜炒，多寐则宜生，又云夜不能寐者，必须生用。何其自相背谬耶？不知此实用药之机权也。夫人不寐，乃心气之不安也，酸枣仁安心，宜用之以治不寐矣。然何以炒用枣仁则补心也？夫人多寐，乃心气之大昏也。炒用，则补心气而愈昏；生用，则心清而不寐耳。夜不能寐者，乃心气不交于肾也；日不能寐者，乃肾气不交于心也。肾气不交于心，宜补其肾；心气不交于肾，宜补其心。用枣仁正所以补心也。补心宜炒用矣，何以又生用。不知夜之不寐，正心气之有余，清其心，则心气定，而肾气亦定矣，此所以必须生用。若日夜不寐，正宜用炒，而不宜用生矣。"}]},{"ID":"20240617103905-1phbci2","Type":"NodeParagraph","Properties":{"id":"20240617103905-1phbci2","updated":"20240617103905"},"Children":[{"Type":"NodeText","Data":"或疑枣仁安心，人人知之，安心而能安肾，此则人未知也。曰∶枣仁岂特安心以安肾而已乎，更能安五脏之气。盖心肾安，而五脏有不安者乎，不必其入脾、入肺、入肝而后能安也。"}]},{"ID":"20240617103906-78hz9zw","Type":"NodeThematicBreak","Properties":{"id":"20240617103906-78hz9zw"}},{"ID":"20240617103922-nn5p2bd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103922-nn5p2bd","updated":"20240617103929"},"Children":[{"Type":"NodeText","Data":"酸枣仁《医学入门》"}]},{"ID":"20240617103922-ir6isqr","Type":"NodeParagraph","Properties":{"id":"20240617103922-ir6isqr","updated":"20240617103922"},"Children":[{"Type":"NodeText","Data":"酸枣仁平止烦渴，引血归脾安睡歇，补中止泄及脐疼，宁心益胆除脾蹶。"}]},{"ID":"20240617103922-5guf86p","Type":"NodeParagraph","Properties":{"id":"20240617103922-5guf86p","updated":"20240617103922"},"Children":[{"Type":"NodeText","Data":"出酸枣县者真。味酸，无毒。除骨蒸烦热及心虚惊悸不眠。丹溪云∶血不归脾而睡卧不宁者，宜用此大补心脾，则血归脾，而五脏安和，则睡卧自宁。又补中益气。治心腹寒热，邪结气聚，脐上下痛满，血转久泄，宁心志，敛虚汗，益胆气，又治四肢酸疼湿痹，筋骨风。久服助阴气，安五脏，令人肥健，轻身延年。"}]},{"ID":"20240617103922-2jumoym","Type":"NodeParagraph","Properties":{"id":"20240617103922-2jumoym","updated":"20240617103922"},"Children":[{"Type":"NodeText","Data":"睡多，生用∶不得睡，炒熟，再蒸半日，去皮尖，研碎用。恶防己。"}]},{"ID":"20240617103922-um92zh8","Type":"NodeParagraph","Properties":{"id":"20240617103922-um92zh8","updated":"20240617103922"},"Children":[{"Type":"NodeText","Data":"以上解热生津药。"}]},{"ID":"20240617103923-wddsh71","Type":"NodeThematicBreak","Properties":{"id":"20240617103923-wddsh71"}},{"ID":"20240617103934-0om04yy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103934-0om04yy","updated":"20240617103941"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草备要》"}]},{"ID":"20240617103934-qx9mm34","Type":"NodeParagraph","Properties":{"id":"20240617103934-qx9mm34","updated":"20240617103934"},"Children":[{"Type":"NodeText","Data":"补而润，敛汗，宁心"}]},{"ID":"20240617103934-6t2r5zc","Type":"NodeParagraph","Properties":{"id":"20240617103934-6t2r5zc","updated":"20240617103934"},"Children":[{"Type":"NodeText","Data":"甘酸而润（凡仁皆润）。专补肝胆。炒熟酸温而香，亦能醒脾（故归脾汤用之）。助阴气，坚筋骨，除烦止渴（敛阴生津），敛汗（《经疏》曰∶凡服固表药，而汗不止者，用枣仁炒研，同生地、白芍、五味，麦冬、竹叶、龙眼肉煎服多效。汗为心液故也）宁心（心君易动，皆由胆怯所致。经曰∶凡十一官皆取决于胆也）。"}]},{"ID":"20240617103934-th8gj3k","Type":"NodeParagraph","Properties":{"id":"20240617103934-th8gj3k","updated":"20240617103934"},"Children":[{"Type":"NodeText","Data":"疗胆虚不眠（温胆汤中或用之。肝虚则胆也虚，肝不藏魂，故不寐。血不归脾，卧亦不安。《金匮》治虚劳烦不眠，用酸枣仁汤。枣仁二升，甘草一两炙，知母、茯苓、芎 各二两，深师加生姜二两，此补肝之剂。经曰∶卧则血归于肝。苏颂曰∶一方加桂一两，二方枣仁并生用，治不得眠，岂得以煮过便为熟乎？），酸痹久泻（酸收涩，香舒脾）。"}]},{"ID":"20240617103934-aj98t7k","Type":"NodeParagraph","Properties":{"id":"20240617103934-aj98t7k","updated":"20240617103934"},"Children":[{"Type":"NodeText","Data":"生用酸平，疗胆热好眠（时珍曰∶今人专以为心家药，殊昧此理。昂按∶胆热必有心烦口苦之证，何以反能好眠乎？温胆汤治不眠，用二陈加竹茹、枳实，二味皆凉药，乃以凉肺、胃之热，非以温胆经之寒也。其以温胆名汤者，以胆欲不寒不燥，当温为候耳。胆热好眠四字，不能无疑也）。"}]},{"ID":"20240617103934-affnart","Type":"NodeParagraph","Properties":{"id":"20240617103934-affnart","updated":"20240617103934"},"Children":[{"Type":"NodeText","Data":"炒，研用。恶防己。"}]},{"ID":"20240617103935-ggn0qda","Type":"NodeThematicBreak","Properties":{"id":"20240617103935-ggn0qda"}},{"ID":"20240617103947-ubgmexm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103947-ubgmexm","updated":"20240617103953"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草从新》"}]},{"ID":"20240617103947-p3tk9hw","Type":"NodeParagraph","Properties":{"id":"20240617103947-p3tk9hw","updated":"20240617103947"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补肝胆、敛汗、宁心醒脾．"}]},{"ID":"20240617103947-t2b1ah5","Type":"NodeParagraph","Properties":{"id":"20240617103947-t2b1ah5","updated":"20240617103947"},"Children":[{"Type":"NodeText","Data":"甘酸而润．生用酸平．专补肝胆．（今人专以为心家药、殊未明耳．）炒熟酸温而香．亦能醒脾．助阴气．坚筋骨．除烦止渴．（敛阴生津．）敛汗．（经疏曰∶凡服固表药而汗不止者、用枣仁炒研、同生地、白芍、北五味、麦冬、龙眼肉、竹叶煎服多效、以汗为心液也．）宁心．（心君易动、皆由胆怯所致、经曰∶凡十一官、皆取决于胆也．）疗胆虚不眠．（温胆汤中、或加用之、肝虚则胆亦虚、肝不藏魂、故不寐、血不归脾、卧亦不安、金匮治虚劳虚烦不升、甘草炙、知母、茯苓、芎 各二两、深师加生姜二两、此补肝之剂、经曰∶卧则血归于肝、苏颂曰∶一方加桂一两、二方枣仁皆生用、治不得眠、则生用疗胆热好眠之说、未可信也、盖胆热必有心烦口苦之证、何以反能好眠乎、若肝火郁于胃中、以致倦怠嗜卧、则当用辛凉透发肝火、如柴薄之属、非枣仁所得司也．）酸痹久泻．（酸收涩、香舒脾．）肝胆二经有实邪．热者勿用．炒香研．恶防己．"}]},{"ID":"20240617103947-fiw1k53","Type":"NodeThematicBreak","Properties":{"id":"20240617103947-fiw1k53"}},{"ID":"20240617104002-azpxnxd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104002-azpxnxd","updated":"20240617104007"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本经逢原》"}]},{"ID":"20240617104002-jpv4zi3","Type":"NodeParagraph","Properties":{"id":"20240617104002-jpv4zi3","updated":"20240617104002"},"Children":[{"Type":"NodeText","Data":"实酸平，仁甘平，无毒。"}]},{"ID":"20240617104002-tovre4l","Type":"NodeParagraph","Properties":{"id":"20240617104002-tovre4l","updated":"20240617104002"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹寒热邪结气聚，四肢酸痛湿痹，久服安五脏。"}]},{"ID":"20240617104002-u812j9k","Type":"NodeParagraph","Properties":{"id":"20240617104002-u812j9k","updated":"20240617104002"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"酸枣仁味甘而润。熟则收敛津液，故疗胆虚不得眠，烦渴虚汗之证。生则导虚热，故疗胆热好眠，神昏倦怠之证；足厥阴少阳本药，兼入足太阴脾经。按∶酸枣本酸而性收，其仁则甘润而性温，能散肝胆二经之滞。故《本经》治心腹寒热，邪气结聚酸痛，血痹等证，皆生用，以疏利肝脾之血脉也。盖肝虚则阴伤两烦心，不能藏魂，故不得眠也。伤寒虚烦多汗及虚人盗汗，皆炒熟用之，总取收敛肝脾之津液也。归脾汤用以滋养营气，则脾热自除。单用煮粥除烦益胆气，胆气宁而魂梦安矣。今人专以为心家药，殊昧此理。"}]},{"ID":"20240617104002-8awjz4g","Type":"NodeThematicBreak","Properties":{"id":"20240617104002-8awjz4g"}},{"ID":"20240617104012-9z5p05r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104012-9z5p05r","updated":"20240617104019"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草崇原》"}]},{"ID":"20240617104012-09amppk","Type":"NodeParagraph","Properties":{"id":"20240617104012-09amppk","updated":"20240617104012"},"Children":[{"Type":"NodeText","Data":"气味酸平，无毒。主治心腹寒热，邪结气聚，四肢 痛，湿痹。久服安五脏，轻身延年。"}]},{"ID":"20240617104012-s234ckn","Type":"NodeParagraph","Properties":{"id":"20240617104012-s234ckn","updated":"20240617104012"},"Children":[{"Type":"NodeText","Data":"（酸枣始出河东川泽，今近汴洛及西北州郡皆有之。一名山枣，《尔雅》名 ，孟子曰∶养其棘是也。其树枝有刺，实形似枣而圆小，其味酸，其色红紫。八月采实，只取核中之仁。仁皮赤，仁肉黄白。）"}]},{"ID":"20240617104012-z2r4x4h","Type":"NodeParagraph","Properties":{"id":"20240617104012-z2r4x4h","updated":"20240617104012"},"Children":[{"Type":"NodeText","Data":"（按∶酸枣肉味酸，其仁味甘而不酸。今既云酸枣仁，又云气味酸平，讹也，当改正。）"}]},{"ID":"20240617104012-hb98u84","Type":"NodeParagraph","Properties":{"id":"20240617104012-hb98u84","updated":"20240617104012"},"Children":[{"Type":"NodeText","Data":"枣肉味酸，肝之果也。得东方木味，能达肝气上行，食之主能醒睡。枣仁形园色赤，禀火土之气化。火归中土，则神气内藏，食之主能寤寐。《本经》不言用仁，而今时多用之。心腹寒热，邪结气聚者，言心腹不和，为寒为热，则邪结气聚。枣仁色赤象心，能导心气以下交，肉黄象土，能助脾气以上达，故心腹之寒热邪结之气聚可治也。土气不达于四肢，则四肢酸痛。火气不温于肌肉，则周身湿痹。枣仁禀火土之气化，故四肢酸痛，周身湿痹可治也。"}]},{"ID":"20240617104012-1mk7f8l","Type":"NodeParagraph","Properties":{"id":"20240617104012-1mk7f8l","updated":"20240617104012"},"Children":[{"Type":"NodeText","Data":"久服安五脏，轻身延年。言不但心腹和平，且安五脏也。五脏既安，则气血日益，故又可轻身延年。"}]},{"ID":"20240617104012-10ryvg3","Type":"NodeThematicBreak","Properties":{"id":"20240617104012-10ryvg3"}},{"ID":"20240617104109-gym6gao","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104109-gym6gao","updated":"20240617104113"},"Children":[{"Type":"NodeText","Data":"酸枣仁《本草思辨录》"}]},{"ID":"20240617104109-oucs04l","Type":"NodeParagraph","Properties":{"id":"20240617104109-oucs04l","updated":"20240617104121"},"Children":[{"Type":"NodeText","Data":"酸枣丛生而气薄，气薄则发泄，味酸亦泄，啖之使阳不得入于阴，故醒睡。仁则甘平，甘平由酸而来，性故微敛而微守。酸枣肝药，仁不能大戾乎枣，亦必入肝。皮赤则入心，内黄则入脾。酸枣仁自当为心肝脾三经之药。心得之则神安，肝得之则魂藏，脾得之则思靖，其治不得眠，尚有何疑。独是酸枣仁汤治虚劳虚烦不得眠，则更有进焉。按栀子豉汤证，亦为虚烦不得眠，而彼为有伤寒余邪，此由于虚劳，故加虚劳字以别之。劳之为病，其脉浮大，手足烦，阴寒，精自出，酸削不能行。此云虚烦不得眠，脉必浮而微数。盖阳上淫而不下则烦，阴下亏而不上则不得眠，其责在肾。非酸枣仁收摄浮阳，不能使心肝脾咸循其职。故推酸枣仁为君，而臣以知母滋肾之液，茯苓泄肾之邪，扰心之烦可不作矣。而心肾不交，犹未足以成寐。后世医者，必将以远志配枣仁，为一降一升之法。不知远志乃阴中升阳之药，此非阳不升而实阴不升，既以枣仁摄之，知母滋之，茯苓泄之，阴中之阴，自有能升之理。特三物皆下行，而肾阴向上之机不能无滞，故又加芎 通阴阳以利之，甘草居中宫以和之，标之曰酸枣仁汤者，以酸枣仁为首功也。"}]},{"ID":"20240617104110-qbk24jj","Type":"NodeThematicBreak","Properties":{"id":"20240617104110-qbk24jj"}},{"ID":"20240617104110-p1cr0pg","Type":"NodeParagraph","Properties":{"id":"20240617104110-p1cr0pg"}}]}