odeParagraph","Properties":{"id":"20240815085319-o4kzk0g","updated":"20240815092133"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 355px;","style":"width: 345px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 10-20240815085319-ary70c9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 345px;\" parent-style=\"width: 355px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 356px;","style":"width: 346px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 11-20240815085902-gpu0936.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 346px;\" parent-style=\"width: 356px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 470px;","style":"width: 460px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (21)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 21-20240815091734-ea23om9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 460px;\" parent-style=\"width: 470px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240815092106-jhaw1ky","Type":"NodeParagraph","Properties":{"id":"20240815092106-jhaw1ky","updated":"20240815092119"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上图片未按品种分类；"}]},{"ID":"20240611154416-q71oags","Type":"NodeThematicBreak","Properties":{"id":"20240611154416-q71oags"}},{"ID":"20240611154507-lyvvekm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154507-lyvvekm","updated":"20240611154511"},"Children":[{"Type":"NodeText","Data":"紫菀《本草求真》"}]},{"ID":"20240611154507-hzotxh9","Type":"NodeParagraph","Properties":{"id":"20240611154507-hzotxh9","updated":"20240611154507"},"Children":[{"Type":"NodeText","Data":"（隰草）泻肺血热"}]},{"ID":"20240611154507-n8yb9yz","Type":"NodeParagraph","Properties":{"id":"20240611154507-n8yb9yz","updated":"20240611154507"},"Children":[{"Type":"NodeText","Data":"紫菀（专入肺）。辛苦而温。色赤。虽入至高之脏。仍兼下降。故书载入肺金血分。（辛入肺。赤入血。）能治虚痨咳嗽惊悸吐衄诸血。又能通调水道。（苦可下降。）以治溺涩便血。用此上下皆宜。且此辛而不燥。润而不滞。（李士材比为金玉君子。非多用独用不能速效。）于肺实为有益。然疏泄性多。培养力少。与桑白皮杏仁同为一类。但桑白皮杏仁则泻肺经气分。此则专泻血经气分也。故肺虚干咳禁用。（干咳类多血虚。不宜再泻。）紫色润软者良。（人多以车前旋复花乱之。）其药虽分上中与下。然下疏泄尤甚。蜜炒用款冬为使。白者名女菀。入气分。大泄肺气。肘后方用此三分。铅丹一分。并酸浆服一刀圭。日进三服。至二十一日。能令面黑转白。过服不宜。去头须。蜜水炒用。款冬为使。恶天雄瞿麦 本远志。畏茵陈。"}]},{"ID":"20240611154440-nu604gw","Type":"NodeThematicBreak","Properties":{"id":"20240611154440-nu604gw"}},{"ID":"20240611154453-2ykevtd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154453-2ykevtd","updated":"20240611154459"},"Children":[{"Type":"NodeText","Data":"紫菀《得配本草》"}]},{"ID":"20240611154453-78u60hv","Type":"NodeParagraph","Properties":{"id":"20240611154453-78u60hv","updated":"20240611154453"},"Children":[{"Type":"NodeText","Data":"款冬为之使。畏茵陈。恶天雄、瞿麦、 本、雷丸、远志。"}]},{"ID":"20240611154453-mk4wr04","Type":"NodeParagraph","Properties":{"id":"20240611154453-mk4wr04","updated":"20240611154453"},"Children":[{"Type":"NodeText","Data":"苦、辛、平、微温。入手太阴、少阴经血分。泄上炎之火，散结滞之气。治痰血，利小便，开喉痹，退惊痫。（气痛诸症悉退。）配生地、麦冬，入心以宁神。配丹皮、白芍，入胃以清热。配款冬、百部、乌梅，治久嗽。配白前、半夏，治水气。去头须，洗净，蜜水浸，焙干用。"}]},{"ID":"20240611154453-ggzp5f3","Type":"NodeParagraph","Properties":{"id":"20240611154453-ggzp5f3","updated":"20240611154453"},"Children":[{"Type":"NodeText","Data":"肺气结滞，郁而为热，致肺叶焦枯，久嗽不止，用紫菀散之，则肺窍通而郁热自除。若阴虚肺液干枯，服散气走液之剂，为害不浅。人何以此为痨嗽之圣药，不究其源而妄用之，致阴受其害而不之知也。若滋阴重剂内，加紫菀四五分以通其滞，亦可。"}]},{"ID":"20240611154440-vhp9420","Type":"NodeThematicBreak","Properties":{"id":"20240611154440-vhp9420"}},{"ID":"20240611154441-bcvxbvr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154441-bcvxbvr","updated":"20240611154448"},"Children":[{"Type":"NodeText","Data":"紫菀《本草图经》"}]},{"ID":"20240611154441-as21b8z","Type":"NodeParagraph","Properties":{"id":"20240611154441-as21b8z","updated":"20240611154445"},"Children":[{"Type":"NodeText","Data":"紫菀，生房陵山谷，及真定邯郸，今耀、成、泗、寿、台、孟州、兴国军皆有之。三月内布地生苗叶，其叶三、四相连；五月、六月内开黄紫白花；结黑子。本有白毛，根甚柔细。二月、三月内取根，阴干用。又有一种白者，名白菀。苏恭云∶白菀即女菀也，疗体并同。无紫菀时，亦可通用女菀。下自有条。今人亦稀用。古今《传信方》用之最要，近医疗久嗽不瘥，此方甚佳。紫菀去芦头，款冬花各一两，百部半两，三物捣罗为散，每服三钱匕。生姜三片，乌梅一个，同煎汤调下，食后欲卧，各一服。"}]},{"ID":"20240611154416-gsky2no","Type":"NodeThematicBreak","Properties":{"id":"20240611154416-gsky2no"}},{"ID":"20240611154427-gmn6jzk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154427-gmn6jzk","updated":"20240611154433"},"Children":[{"Type":"NodeText","Data":"紫菀《长沙药解》"}]},{"ID":"20240611154427-ydo7fsw","Type":"NodeParagraph","Properties":{"id":"20240611154427-ydo7fsw","updated":"20240611154427"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦温。主咳逆上气，胸中寒热结气，去蛊毒痿蹶，安五藏。生山谷。"}]},{"ID":"20240611154427-p3br87w","Type":"NodeParagraph","Properties":{"id":"20240611154427-p3br87w","updated":"20240611154427"},"Children":[{"Type":"NodeText","Data":"味苦、辛，入手太阴肺经。降气逆而止咳，平息贲而止喘。"}]},{"ID":"20240611154427-xp71mqm","Type":"NodeParagraph","Properties":{"id":"20240611154427-xp71mqm","updated":"20240611154427"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"射干麻黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在射干。"},{"Type":"NodeText","Data":"用之治咳而上气，以其清肺而降逆也。"}]},{"ID":"20240611154427-dk291gs","Type":"NodeParagraph","Properties":{"id":"20240611154427-dk291gs","updated":"20240611154427"},"Children":[{"Type":"NodeText","Data":"紫菀清金润肺，止咳定喘，而兼善敛血。劳嗽吐血之证，因于肺逆而不敛，肺气清降，则血自敛矣。其诸主治，开喉痹，通小便，定喘促，破息贲，止吐血，住便血，疗肺痈，行脓血，皆清金降逆之力也。"}]},{"ID":"20240611154531-8xlpd9p","Type":"NodeThematicBreak","Properties":{"id":"20240611154531-8xlpd9p","updated":"20240611154531"}},{"ID":"20240611154531-3a8omq4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154531-3a8omq4","updated":"20240611154531"},"Children":[{"Type":"NodeText","Data":"紫菀《滇南本草》"}]},{"ID":"20240611154531-cg9azys","Type":"NodeParagraph","Properties":{"id":"20240611154531-cg9azys","updated":"20240611154531"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"紫菀（图缺）"},{"Type":"NodeText","Data":"，味苦、辛，性温。苦走心，心主血，止血养血；辛走肺，多功于肺。治咳嗽、痰气喘促、补肺、阴虚痨嗽、衄血、咳血、阴虚、痰上带血丝。"}]},{"ID":"20240611154531-xz7c6g7","Type":"NodeParagraph","Properties":{"id":"20240611154531-xz7c6g7","updated":"20240611154531"},"Children":[{"Type":"NodeText","Data":"紫菀（二钱） 知母（一钱） 焦黄柏（五分） 陈皮（二钱） 不用引，水煎服。"}]},{"ID":"20240611154416-gvari2m","Type":"NodeThematicBreak","Properties":{"id":"20240611154416-gvari2m"}},{"ID":"20240611154417-ttj2x1g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154417-ttj2x1g","updated":"20240611154421"},"Children":[{"Type":"NodeText","Data":"紫菀《本草从新》"}]},{"ID":"20240611154417-a1wnr8o","Type":"NodeParagraph","Properties":{"id":"20240611154417-a1wnr8o","updated":"20240611154417"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"润肺下气．"}]},{"ID":"20240611154417-4niiv64","Type":"NodeParagraph","Properties":{"id":"20240611154417-4niiv64","updated":"20240611154417"},"Children":[{"Type":"NodeText","Data":"辛温润肺，苦温下气，化痰止渴．治寒热结气．咳逆上气．咳吐脓血．（专治血痰、为血劳圣药．）肺经虚热．小儿惊痫．（亦虚而有热．）能开喉痹．取恶涎．又能通利小肠．（本草汇云∶苦能达下、辛可益金、故吐血保肺、收为上剂、虽入至高、善于达下、使气化及于州都、小便自利．）辛散性滑．暂用之品．阴虚肺热者、不宜专用多用．须地黄麦冬共之．根作节、紫色润软者良．（今人多以车前、旋复根伪之．）白者名女菀．（时珍曰∶紫入血分、白入气分．）去头须．蜜水浸焙．款冬为使．恶天雄、瞿麦、 本、远志．畏茵陈．（妇人小便卒不得出、或小便血、紫菀为末服．）"}]},{"ID":"20240611154344-k37u168","Type":"NodeThematicBreak","Properties":{"id":"20240611154344-k37u168"}},{"ID":"20240611154407-vgxaoep","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154407-vgxaoep","updated":"20240611154411"},"Children":[{"Type":"NodeText","Data":"紫菀《本经逢原》"}]},{"ID":"20240611154407-lvq45h0","Type":"NodeParagraph","Properties":{"id":"20240611154407-lvq45h0","updated":"20240611154407"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白者名女菀"}]},{"ID":"20240611154407-iuvzgml","Type":"NodeParagraph","Properties":{"id":"20240611154407-iuvzgml","updated":"20240611154407"},"Children":[{"Type":"NodeText","Data":"苦辛微温，无毒。或酒洗，或蜜水炒用。"}]},{"ID":"20240611154407-kdflk93","Type":"NodeParagraph","Properties":{"id":"20240611154407-kdflk93","updated":"20240611154407"},"Children":[{"Type":"NodeText","Data":"《本经》主咳逆上气，胸中寒热结气，去蛊毒，痿 、安五脏。女菀治风寒洗洗，霍乱泄利，肠鸣上下无常处，惊痫，寒热百病。"}]},{"ID":"20240611154407-kjuvoh6","Type":"NodeParagraph","Properties":{"id":"20240611154407-kjuvoh6","updated":"20240611154407"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"紫菀，肺经血分之药。《本经》止咳逆上气，胸中寒热结气，取性疏利肺经血气也。去蛊毒痿 者，以其辛苦微温，能散结降气，蛊毒自不能留。痿 由肺热叶焦，紫菀专通肺气，使热从溲便去耳。《别录》疗咳唾脓血。《大明》消痰止渴，皆滋肺经血气之效。"}]},{"ID":"20240611154407-u66x93l","Type":"NodeParagraph","Properties":{"id":"20240611154407-u66x93l","updated":"20240611154407"},"Children":[{"Type":"NodeText","Data":"《金匮》泽漆汤用以治咳而脉沉者，咳属肺；脉沉则血分之病也。亦治下痢肺痛，与紫参同功。其性辛而不燥，润而不寒，补而不滞，善调五劳体虚，止咳定喘，疗惊悸，吐衄诸血。又能通调水道，故溺涩便血单服一两即效。然大泄肺气，阴虚肺热干咳禁用，以其性专温散而无培养之力也。白者曰女菀，大泄肺气。《本经》主风寒洗洗，霍乱泄利，肠鸣上下无常处，惊痫寒热百病，一皆气分受伤之病。《肘后方》治人面黑令白，方用女菀三分，铅丹一分为末，醋浆服一刀圭，日进三服，十日大便黑，二十一日面白，便止。过用则太白矣。"}]},{"ID":"20240611154407-esdf9f9","Type":"NodeParagraph","Properties":{"id":"20240611154407-esdf9f9","updated":"20240611154407"},"Children":[{"Type":"NodeText","Data":"《千金方》用酒服，男十日，女二十日，黑色皆从大便去。三十岁后不可服，以肺气渐减，不可复泄也。"}]},{"ID":"20240611154353-nikv4b4","Type":"NodeThematicBreak","Properties":{"id":"20240611154353-nikv4b4"}},{"ID":"20240611154354-yfszk7f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154354-yfszk7f","updated":"20240611154400"},"Children":[{"Type":"NodeText","Data":"紫菀《本草便读》"}]},{"ID":"20240611154354-65jq7p5","Type":"NodeParagraph","Properties":{"id":"20240611154354-65jq7p5","updated":"20240611154354"},"Children":[{"Type":"NodeText","Data":"性温利肺．治风寒咳逆之邪．色赤和营．疗痿 吐红之疾．皆为苦能降气．金肃则小但辛苦之性．疏邪降逆．是其所长．故一切风寒风热咳嗽痰血等证．凡属肺金之邪郁而不宜者．皆可用之．惟润养之力为不足耳．因紫菀根虽柔软．然亦非润药．皆以辛散苦泄为功．若内无郁结．外无表邪．肺阴不足．虚火上刑者．仍不可用．）"}]},{"ID":"20240611154344-bf7v99l","Type":"NodeThematicBreak","Properties":{"id":"20240611154344-bf7v99l"}},{"ID":"20240611154345-rj855z9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154345-rj855z9","updated":"20240611154349"},"Children":[{"Type":"NodeText","Data":"紫菀《本草经集注》"}]},{"ID":"20240611154345-8gy754g","Type":"NodeParagraph","Properties":{"id":"20240611154345-8gy754g","updated":"20240611154345"},"Children":[{"Type":"NodeText","Data":"味苦、辛，温，无毒。主治咳逆上气，胸中寒热结气，去蛊毒、痿蹶，安五脏。治咳唾脓血，止喘悸，五劳体虚，补不足，小儿惊痫。一名紫 ，一名青菀。生房陵山谷及真定、邯郸，二月、三月采根，阴干。（款冬为之使，恶天雄、瞿麦、雷丸、远志，畏茵陈蒿。）近道处处有，生布地，花亦紫，本有白毛，根甚柔细。有白者名白菀，不复用。"}]},{"ID":"20240611154317-co2nbnw","Type":"NodeThematicBreak","Properties":{"id":"20240611154317-co2nbnw"}},{"ID":"20240611154330-ngy4war","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154330-ngy4war","updated":"20240611154337"},"Children":[{"Type":"NodeText","Data":"紫菀《神农本草经赞》"}]},{"ID":"20240611154330-qvvv4il","Type":"NodeParagraph","Properties":{"id":"20240611154330-qvvv4il","updated":"20240611154330"},"Children":[{"Type":"NodeText","Data":"味苦温。主咳逆上气。胸中寒热结气。去蛊毒。痿。安五脏。生山谷。"}]},{"ID":"20240611154330-cy6uyd9","Type":"NodeParagraph","Properties":{"id":"20240611154330-cy6uyd9","updated":"20240611154330"},"Children":[{"Type":"NodeText","Data":"有菀其特。上气夷瘳。紫深节润。白贲毛柔。山疏春暮。水注东流。羊须练色。漫易牵牛。"}]},{"ID":"20240611154330-576fxbh","Type":"NodeParagraph","Properties":{"id":"20240611154330-576fxbh","updated":"20240611154330"},"Children":[{"Type":"NodeText","Data":"诗。有菀其特。灵枢经曰。风寒舍于肺。发咳上气。诗。靡有夷瘳。日华子曰。根作节紫色。润软为佳。陶弘景曰。本有白毛。根甚柔细。名医曰。三月采根。阴干。雷论曰。凡使用东流水洗净。有白如练色者名羊须草。自然不同。孟子。以羊易之。李时珍曰。一名夜牵牛。"}]},{"ID":"20240611154317-kji4mv5","Type":"NodeThematicBreak","Properties":{"id":"20240611154317-kji4mv5"}},{"ID":"20240611154318-6zjzgie","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154318-6zjzgie","updated":"20240611154323"},"Children":[{"Type":"NodeText","Data":"紫菀《证类本草》"}]},{"ID":"20240611154318-hddmwso","Type":"NodeParagraph","Properties":{"id":"20240611154318-hddmwso","updated":"20240611154318"},"Children":[{"Type":"NodeText","Data":"味苦、辛，温，无毒。主咳逆上气，胸中寒热结气，去蛊毒，痿蹶，安五脏，疗咳唾脓血，止喘悸，五劳体虚，补不足，小儿惊痫。一名紫茜，一名青苑。生房陵山谷及真定、邯郸。二月、三月采根，阴干。款冬为之使，恶天雄、瞿麦、雷丸、远志，畏茵陈蒿。陶隐居云∶近道处处有，生布地，花亦紫，本有白毛，根甚柔细。有白者名白菀，不复用。唐本注云∶白菀即女菀也。疗体与紫菀同。无紫菀时亦用白菀。陶云不复用，或者未悉。臣禹锡等谨按药性论云∶紫菀，臣，味苦，平。能治尸疰，补虚，下气及胸胁逆气，治百邪鬼魅，劳气虚热。日华子云∶调中及肺痿吐血，消痰止渴，润肌肤，添骨髓。形似重台，根作节，紫色，润软者佳。"}]},{"ID":"20240611154318-n05m465","Type":"NodeParagraph","Properties":{"id":"20240611154318-n05m465","updated":"20240611154318"},"Children":[{"Type":"NodeText","Data":"图经曰∶紫菀，生房陵山谷及真定、邯郸，今耀、成、泗、寿、台、孟州，兴国军皆有之。"}]},{"ID":"20240611154318-q337zhc","Type":"NodeParagraph","Properties":{"id":"20240611154318-q337zhc","updated":"20240611154318"},"Children":[{"Type":"NodeText","Data":"三月内布地生苗叶，其叶三、四相连，五月、六月内开黄、紫、白花，结黑子。本有白毛，根甚柔细。二月、三月内取根阴干用。又有一种白者名白菀。苏恭云∶白菀即女菀也。疗体并同，无紫菀时，亦可通用。女菀下自有条，今人亦稀用。《古今传信方》∶用之最要，近医疗久嗽不瘥，此方甚佳。紫菀去芦头、款冬花各一两，百部半两，三物捣罗为散，每服三钱匕。生姜三片，乌梅一个，同煎汤调下，食后、欲卧各一服。"}]},{"ID":"20240611154318-qg0lxhs","Type":"NodeParagraph","Properties":{"id":"20240611154318-qg0lxhs","updated":"20240611154318"},"Children":[{"Type":"NodeText","Data":"唐本余∶治气喘，阴痿。雷公云∶凡使，先去髭，有白如练色者，号曰羊须草，自然不同。"}]},{"ID":"20240611154318-tyqj0bd","Type":"NodeParagraph","Properties":{"id":"20240611154318-tyqj0bd","updated":"20240611154318"},"Children":[{"Type":"NodeText","Data":"采得后，去头土了，用东流水淘洗令净，用蜜浸一宿。至明于火上焙干用。凡修一两，用蜜二分。千金方∶治妇人卒不得小便。紫菀末，以井花水服三撮，便通。小便血，服五撮立止。斗门方治缠喉风，喉闭饮食不通欲死者。用返魂草根一茎，净洗纳入喉中，待取恶涎出即瘥，神效。更以马牙硝津咽之，即绝根本。一名紫菀，又南中呼为液牵牛是也。"}]},{"ID":"20240611154318-azghmz0","Type":"NodeParagraph","Properties":{"id":"20240611154318-azghmz0","updated":"20240611154318"},"Children":[{"Type":"NodeText","Data":"衍义曰∶紫菀，用根。其根柔细，紫色，益肺气，《经》具言之。《唐本》注言无紫菀时，亦用白菀。白菀即女菀也。今本草无白菀之名，盖唐修本草时已删去。"}]},{"ID":"20240611154224-xcyvi08","Type":"NodeThematicBreak","Properties":{"id":"20240611154224-xcyvi08"}},{"ID":"20240611154259-xlqubhg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154259-xlqubhg","updated":"20240611154309"},"Children":[{"Type":"NodeText","Data":"紫菀《神农本草经读》"}]},{"ID":"20240611154259-5hby4ta","Type":"NodeParagraph","Properties":{"id":"20240611154259-5hby4ta","updated":"20240611154259"},"Children":[{"Type":"NodeText","Data":"气味苦、温，无毒。主咳逆上气，胸中寒热结气，去蛊毒，痿，安五脏。"}]},{"ID":"20240611154259-7e3ikfa","Type":"NodeParagraph","Properties":{"id":"20240611154259-7e3ikfa","updated":"20240611154259"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶紫者，黑赤之间色也；黑赤，水火之色也。紫菀气味苦温，禀火气也；其质阴柔，禀水气也。主治咳逆上气者，启太阳寒水之气从皮毛而合肺也。治胸中寒热结气者，助少阴火热之气，通利三焦而上达也。蛊毒在腹属土，火能生土，故去蛊毒。痿在筋属水，水能生木，故去痿。水火者，阴阳之征兆也，水火交则阴阳合，故安五脏。"}]},{"ID":"20240611154236-s8biag2","Type":"NodeThematicBreak","Properties":{"id":"20240611154236-s8biag2"}},{"ID":"20240611154248-0julc14","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154248-0julc14","updated":"20240611154252"},"Children":[{"Type":"NodeText","Data":"紫菀《本草纲目》"}]},{"ID":"20240611154248-mfk9co5","Type":"NodeParagraph","Properties":{"id":"20240611154248-mfk9co5","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"「释名」亦名青菀、紫茜、返魂草、夜牵牛。"}]},{"ID":"20240611154248-4ehdov0","Type":"NodeParagraph","Properties":{"id":"20240611154248-4ehdov0","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、温、无毒。"}]},{"ID":"20240611154248-x8b8bqn","Type":"NodeParagraph","Properties":{"id":"20240611154248-x8b8bqn","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611154248-a7qbmuw","Type":"NodeParagraph","Properties":{"id":"20240611154248-a7qbmuw","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"1、肺伤咳嗽。用紫菀花五钱，加水一碗，煎至七成，温服。一天服三次。"}]},{"ID":"20240611154248-7mns7i0","Type":"NodeParagraph","Properties":{"id":"20240611154248-7mns7i0","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"2、久咳不愈，用紫菀、款冬花各一两，百部半两，捣、筛为末。每服三钱，以姜三片、乌梅一个，煎汤调下。一天服两次。"}]},{"ID":"20240611154248-xqlafor","Type":"NodeParagraph","Properties":{"id":"20240611154248-xqlafor","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"3、吐血咳嗽。用紫苑、五味子炒过，共研为末，加蜜做成丸子，如芡子大。每次含化一丸。"}]},{"ID":"20240611154248-chnmn4s","Type":"NodeParagraph","Properties":{"id":"20240611154248-chnmn4s","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"4、产后下血。用紫菀末五撮，水冲服。"}]},{"ID":"20240611154248-kc9onjh","Type":"NodeParagraph","Properties":{"id":"20240611154248-kc9onjh","updated":"20240611154248"},"Children":[{"Type":"NodeText","Data":"5、缠喉风痹。用紫菀根一条，洗净，放入喉部，有涎出，病即渐愈。"}]},{"ID":"20240611154236-rvay7j0","Type":"NodeThematicBreak","Properties":{"id":"20240611154236-rvay7j0"}},{"ID":"20240611154237-5g6oelh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154237-5g6oelh","updated":"20240611154241"},"Children":[{"Type":"NodeText","Data":"紫菀《本草备要》"}]},{"ID":"20240611154237-5ryc6zl","Type":"NodeParagraph","Properties":{"id":"20240611154237-5ryc6zl","updated":"20240611154237"},"Children":[{"Type":"NodeText","Data":"润肺，泻火"}]},{"ID":"20240611154237-qjlbput","Type":"NodeParagraph","Properties":{"id":"20240611154237-qjlbput","updated":"20240611154237"},"Children":[{"Type":"NodeText","Data":"辛温润肺，苦温下气。补虚调中，消痰止渴。"}]},{"ID":"20240611154237-gi2ga02","Type":"NodeParagraph","Properties":{"id":"20240611154237-gi2ga02","updated":"20240611154237"},"Children":[{"Type":"NodeText","Data":"治寒热结气，咳逆上气，咳吐脓血（专治血痰，为血劳圣药），肺经虚热，小儿惊痫（亦虚而有热）。能开喉痹，取恶涎，然辛散性滑，不宜多用独用（《本草汇》云∶苦能达下，辛可益金，故吐血保肺，收为上剂。虽入至高善于达下，使气化及于州都，小便自利，人所不知。李士材曰∶辛而不燥，润而不寒，补而不滞，诚金玉君子，非多用独用，不能速效。州都，膀胱也）。"}]},{"ID":"20240611154237-hvixvkf","Type":"NodeParagraph","Properties":{"id":"20240611154237-hvixvkf","updated":"20240611154237"},"Children":[{"Type":"NodeText","Data":"根作节、紫色润软者良（人多以车前、旋复根伪之，误服误人）。去头须蜜水浸，焙用。"}]},{"ID":"20240611154237-fp69m8n","Type":"NodeParagraph","Properties":{"id":"20240611154237-fp69m8n","updated":"20240611154237"},"Children":[{"Type":"NodeText","Data":"款冬为使。恶天雄、瞿麦、 本、远志。畏茵陈。白者名菀（时珍曰∶紫入血分，白入气分）"}]},{"ID":"20240611154224-krfbvwb","Type":"NodeThematicBreak","Properties":{"id":"20240611154224-krfbvwb"}},{"ID":"20240611154225-1q6qfkz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154225-1q6qfkz","updated":"20240611154230"},"Children":[{"Type":"NodeText","Data":"紫菀《本草经解》"}]},{"ID":"20240611154225-5klv6pk","Type":"NodeParagraph","Properties":{"id":"20240611154225-5klv6pk","updated":"20240611154225"},"Children":[{"Type":"NodeText","Data":"气温．味苦．无毒．主咳逆上气．胸中寒热结气．去蛊毒．痿 安五脏．（蜜蒸）"}]},{"ID":"20240611154225-tnsuv0s","Type":"NodeParagraph","Properties":{"id":"20240611154225-tnsuv0s","updated":"20240611154225"},"Children":[{"Type":"NodeText","Data":"紫菀气温．禀天春升之木气．入手厥阴心包络经．味苦无毒．得地南方之火味．入手少阴心经．气升味降．阴也．心为君火．火刑肺金则咳逆上气矣．紫菀入心．味苦清火．所以主之也．心包络手厥阴脉．起于胸中．手厥阴之筋．其支者入腋散胸中．厥阴主散寒热结气者．厥阴有或寒或热之气结也．结而不散．厥阴病矣．紫菀气温．可以散寒．味苦可以散热也．蛊毒者．湿热之毒．化虫成蛊也．味苦无毒．泄而杀虫．所以主之也．痿 者．肺受湿热熏蒸．不能行清肃之令．心气热下脉厥而上．上实下虚．枢折挈胫纵不任地．而生痿 也．味苦入心．清热降气．故主痿 也．心为君．主十二官之宰．五脏之主也．味苦益心．心安则五脏皆安也．"}]},{"ID":"20240611154225-ql9xuek","Type":"NodeParagraph","Properties":{"id":"20240611154225-ql9xuek","updated":"20240611154225"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611154225-0kkc3gm","Type":"NodeParagraph","Properties":{"id":"20240611154225-0kkc3gm","updated":"20240611154225"},"Children":[{"Type":"NodeText","Data":"紫菀五钱煎．治肺伤咳嗽．紫菀、款冬各一两．百部五钱末．姜、乌梅煎汤．调服三钱．治久咳嗽．同杏仁等分蜜丸．五味汤化服．治小儿咳嗽．同五味丸含化．治吐血痰咳．为末水服三撮．治女人卒不小便．及小便血．"}]},{"ID":"20240611154016-30fut6q","Type":"NodeThematicBreak","Properties":{"id":"20240611154016-30fut6q"}},{"ID":"20240611154212-l5041sc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154212-l5041sc","updated":"20240611154219"},"Children":[{"Type":"NodeText","Data":"紫菀《本草新编》"}]},{"ID":"20240611154212-8c3zfep","Type":"NodeParagraph","Properties":{"id":"20240611154212-8c3zfep","updated":"20240611154212"},"Children":[{"Type":"NodeText","Data":"紫菀，味苦、辛，温，无毒。入手太阴，兼入足阳明。主咳逆上气，胸中寒热结气，去蛊毒，疗咳唾脓血，止喘悸、五劳体虚，治久嗽。然亦只可为佐使，而不可单用以取效。"}]},{"ID":"20240611154212-hiulanh","Type":"NodeParagraph","Properties":{"id":"20240611154212-hiulanh","updated":"20240611154212"},"Children":[{"Type":"NodeText","Data":"或问缪仲醇云∶观紫菀能开喉痹，取恶涎，则辛散之功烈矣。然而又云∶其性温，肺病咳逆喘嗽，皆阴虚肺热症也，不宜多用等语，似乎紫菀并不可以治嗽也。曰∶紫菀舍治嗽之外，原无多奇功。治缠喉风、喉闭者，正取其治肺经咳逆、阴虚肺热也，而仲醇以此相戒，何哉。夫喉闭，未有非下寒上热之症也。紫菀性温，而又兼辛散，从其火热之性而解之，乃从治之法，治之最巧者也。仲醇最讲阴虚火动之旨，何独于紫菀而昧之，此铎所不解也。"}]},{"ID":"20240611154212-1lor1kb","Type":"NodeParagraph","Properties":{"id":"20240611154212-1lor1kb","updated":"20240611154212"},"Children":[{"Type":"NodeText","Data":"或谓紫菀治肺之热，而性温而辛散，从火热之性而解之是矣。然而肺经最恶热，以热攻热，必伤肺矣。吾恐邪去而肺伤也。曰∶久嗽则肺必寒，以温治寒，则肺且受益，何伤之有。"}]},{"ID":"20240611154017-7kopcl7","Type":"NodeThematicBreak","Properties":{"id":"20240611154017-7kopcl7"}},{"ID":"20240611154044-80g6jzy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154044-80g6jzy","updated":"20240611154049"},"Children":[{"Type":"NodeText","Data":"紫菀《本草新编》"}]},{"ID":"20240611154044-w999y1p","Type":"NodeParagraph","Properties":{"id":"20240611154044-w999y1p","updated":"20240611154044"},"Children":[{"Type":"NodeText","Data":"紫菀，味苦、辛，温，无毒。入手太阴，兼入足阳明。主咳逆上气，胸中寒热结气，去蛊毒，疗咳唾脓血，止喘悸、五劳体虚，治久嗽。然亦只可为佐使，而不可单用以取效。"}]},{"ID":"20240611154044-9okkupr","Type":"NodeParagraph","Properties":{"id":"20240611154044-9okkupr","updated":"20240611154044"},"Children":[{"Type":"NodeText","Data":"或问缪仲醇云∶观紫菀能开喉痹，取恶涎，则辛散之功烈矣。然而又云∶其性温，肺病咳逆喘嗽，皆阴虚肺热症也，不宜多用等语，似乎紫菀并不可以治嗽也。曰∶紫菀舍治嗽之外，原无多奇功。治缠喉风、喉闭者，正取其治肺经咳逆、阴虚肺热也，而仲醇以此相戒，何哉。夫喉闭，未有非下寒上热之症也。紫菀性温，而又兼辛散，从其火热之性而解之，乃从治之法，治之最巧者也。仲醇最讲阴虚火动之旨，何独于紫菀而昧之，此铎所不解也。"}]},{"ID":"20240611154044-f2fnadj","Type":"NodeParagraph","Properties":{"id":"20240611154044-f2fnadj","updated":"20240611154044"},"Children":[{"Type":"NodeText","Data":"或谓紫菀治肺之热，而性温而辛散，从火热之性而解之是矣。然而肺经最恶热，以热攻热，必伤肺矣。吾恐邪去而肺伤也。曰∶久嗽则肺必寒，以温治寒，则肺且受益，何伤之有。"}]},{"ID":"20240611154017-tit53is","Type":"NodeThematicBreak","Properties":{"id":"20240611154017-tit53is"}},{"ID":"20240611154032-kx42kyv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154032-kx42kyv","updated":"20240611154039"},"Children":[{"Type":"NodeText","Data":"紫菀《医学入门》"}]},{"ID":"20240611154032-az8mqzv","Type":"NodeParagraph","Properties":{"id":"20240611154032-az8mqzv","updated":"20240611154032"},"Children":[{"Type":"NodeText","Data":"紫菀苦温能调肺，消痰嗽血定喘悸，寒热胸结气能消，补虚治蹶并劳疰。"}]},{"ID":"20240611154032-s7qlrt5","Type":"NodeParagraph","Properties":{"id":"20240611154032-s7qlrt5","updated":"20240611154032"},"Children":[{"Type":"NodeText","Data":"菀，软也。色紫而体软润者佳。又有白菀，性亦颇同。无毒。益肺，安五脏。消痰止渴，止久嗽及肺痈咳唾脓血，喘悸，咳逆上气，胸胁寒热结气。补虚劳不足，润肌添髓。兼治喉痹，痿蹶，尸疰劳气百邪，妇人卒不得小便，小儿惊痫。去芦，蜜水浸一宿，焙干。款冬花为使。恶天雄、瞿麦、雷丸、远志，畏茵陈。治久嗽不瘥，紫菀、款冬花各一两，百部五钱，为末，生姜、乌梅煎汤下三钱，甚效。"}]},{"ID":"20240611154017-q2kk7f8","Type":"NodeThematicBreak","Properties":{"id":"20240611154017-q2kk7f8"}},{"ID":"20240611154018-2b3rna5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154018-2b3rna5","updated":"20240611154025"},"Children":[{"Type":"NodeText","Data":"紫菀《千金翼方》"}]},{"ID":"20240611154018-73qz1td","Type":"NodeParagraph","Properties":{"id":"20240611154018-73qz1td","updated":"20240611154018"},"Children":[{"Type":"NodeText","Data":"味苦辛，温，无毒。主咳逆上气，胸中寒热结气，去蛊毒，痿蹶，安五脏。疗咳唾脓血，止喘悸，五劳体虚，补不足，小儿惊痫。一名紫 ，一名青苑。生房陵山谷及真定、邯郸，二月三月采根，阴干。"}]},{"ID":"20240611153843-4vg2t9o","Type":"NodeThematicBreak","Properties":{"id":"20240611153843-4vg2t9o"}},{"ID":"20240611153911-bclw183","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153911-bclw183","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"紫苑"}]},{"ID":"20240611153911-pyxk1av","Type":"NodeParagraph","Properties":{"id":"20240611153911-pyxk1av","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153911-vdbapf0","Type":"NodeParagraph","Properties":{"id":"20240611153911-vdbapf0","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 紫菀、青菀、辫紫苑、软紫苑、返魂草根。"}]},{"ID":"20240611153911-46u9nsb","Type":"NodeParagraph","Properties":{"id":"20240611153911-46u9nsb","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611153911-9is1klq","Type":"NodeParagraph","Properties":{"id":"20240611153911-9is1klq","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" Tatarian Aster Root。"}]},{"ID":"20240611153911-99ah90r","Type":"NodeParagraph","Properties":{"id":"20240611153911-99ah90r","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153911-v1fv8h0","Type":"NodeParagraph","Properties":{"id":"20240611153911-v1fv8h0","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 菊科植物紫苑Aster tataricus L.f.的根及根茎。"}]},{"ID":"20240611153911-hzldcx5","Type":"NodeParagraph","Properties":{"id":"20240611153911-hzldcx5","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"植物形态"}]},{"ID":"20240611153911-89r6o3f","Type":"NodeParagraph","Properties":{"id":"20240611153911-89r6o3f","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高1～1.5米。根茎短，密生多数细根，根皮紫红色。茎直立，上部疏生短毛。基生叶丛生，长椭圆形，长20～50厘米，宽6～12厘米，基部渐狭呈翼状柄，边缘具锯齿，两面疏生糙毛，叶柄长，花期枯萎；茎生叶互生，卵形或长椭圆形，长18～35厘米，宽5～10厘米，渐上无柄。头状花序排成伞房状，有长梗，密被短毛；总苞片球形，总苞片3层，边缘紫红色；舌状花蓝紫色，筒状花黄色。瘦果扁平，一侧弯凸，一侧平直，有短毛，冠毛灰白色或带红色，较瘦果长3～4倍。花期7～8月，果期8～10月。"}]},{"ID":"20240611153911-el4obki","Type":"NodeParagraph","Properties":{"id":"20240611153911-el4obki","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611153911-6eb9ikm","Type":"NodeParagraph","Properties":{"id":"20240611153911-6eb9ikm","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 生于山坡、草地、河边。河北、安徽等地有大量栽培。分布于黑龙江、吉林、辽宁、河北、山西、内蒙古、安徽、陕西、甘肃、青海等地。"}]},{"ID":"20240611153911-7le1bsj","Type":"NodeParagraph","Properties":{"id":"20240611153911-7le1bsj","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"采收加工"}]},{"ID":"20240611153911-qkjwwmj","Type":"NodeParagraph","Properties":{"id":"20240611153911-qkjwwmj","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 春、秋季采挖，除去有节的根茎(习称“母根”)和泥沙，编成辫状晒干，或直接晒干。"}]},{"ID":"20240611153911-o908nf4","Type":"NodeParagraph","Properties":{"id":"20240611153911-o908nf4","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153911-sz950yn","Type":"NodeParagraph","Properties":{"id":"20240611153911-sz950yn","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 不规则块状，大小不一，顶端有茎、叶的残基，质稍硬。根茎簇生多数细根，长3～15厘米，直径0.1～0.3厘米，多编成辫状；表面紫红色或灰红色，有纵皱纹；质较柔韧。气微香，味甜、微苦。"}]},{"ID":"20240611153911-1atbd30","Type":"NodeParagraph","Properties":{"id":"20240611153911-1atbd30","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"性味归经"}]},{"ID":"20240611153911-4jhdats","Type":"NodeParagraph","Properties":{"id":"20240611153911-4jhdats","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 性温，味辛、苦。归肺经。"}]},{"ID":"20240611153911-gs5hnk9","Type":"NodeParagraph","Properties":{"id":"20240611153911-gs5hnk9","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153911-32o1pkt","Type":"NodeParagraph","Properties":{"id":"20240611153911-32o1pkt","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 润肺下气、消痰止咳。属化痰止咳平喘药下属分类的止咳平喘药"}]},{"ID":"20240611153911-o3xar51","Type":"NodeParagraph","Properties":{"id":"20240611153911-o3xar51","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611153911-silnlit","Type":"NodeParagraph","Properties":{"id":"20240611153911-silnlit","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 用量5～9克，水煎服；润肺宜蜜炙用。用治痰多喘咳、新久咳嗽、劳嗽咳血。"}]},{"ID":"20240611153911-qq9krwy","Type":"NodeParagraph","Properties":{"id":"20240611153911-qq9krwy","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611153911-z30u6yk","Type":"NodeParagraph","Properties":{"id":"20240611153911-z30u6yk","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 现代药理试验证实，有祛痰镇咳作用，并对金黄色葡萄球菌、痢疾杆菌、伤寒杆菌、大肠杆菌、绿脓杆菌、霍乱弧菌皆有抑制作用;对结核杆菌亦有抑制作用。此外，还有抗病毒、抗癌、溶血及利尿等作用。"}]},{"ID":"20240611153911-p87r836","Type":"NodeParagraph","Properties":{"id":"20240611153911-p87r836","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611153911-fkdpi0k","Type":"NodeParagraph","Properties":{"id":"20240611153911-fkdpi0k","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 含紫苑酮、槲皮素、无羁萜、表无羁萜和挥发油。挥发油中含毛叶醇、毛叶醇乙酯、茴香醚、烃、脂肪酸、芳香酸等，并分得琥珀酸。另含紫菀氯环五肽、芦丁、紫菀苷A、紫菀苷B、紫菀苷C，表无羁萜醇、毛叶醇等成分。"}]},{"ID":"20240611153911-zp3ax93","Type":"NodeParagraph","Properties":{"id":"20240611153911-zp3ax93","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611153911-2p6meli","Type":"NodeParagraph","Properties":{"id":"20240611153911-2p6meli","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" 有实热者慎服。"}]},{"ID":"20240611153911-75fm7q2","Type":"NodeParagraph","Properties":{"id":"20240611153911-75fm7q2","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"相关药方"}]},{"ID":"20240611153911-f6hxjgj","Type":"NodeParagraph","Properties":{"id":"20240611153911-f6hxjgj","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":" ①治久嗽不瘥：紫苑(去芦头)、款冬花各30克，百部15克。三物捣罗为散。每服9克，生姜三片，乌梅一个，同煎汤调下，食后、欲卧各一服。(《本草图经》)"}]},{"ID":"20240611153911-t4dn20u","Type":"NodeParagraph","Properties":{"id":"20240611153911-t4dn20u","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"②治小儿咳嗽，声不出者：紫苑末、杏仁泥等分。入蜜同研。丸芡实大。每服一丸，五味子汤下。(《全幼心鉴》)"}]},{"ID":"20240611153911-j1x0izq","Type":"NodeParagraph","Properties":{"id":"20240611153911-j1x0izq","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"③治吐血，咯血，嗽血：紫苑、茜根等分。为细末，炼蜜为丸，炼如樱桃子大。含化一丸，不以时。(《鸡峰普济方》紫菀丸)"}]},{"ID":"20240611153911-nnlxp38","Type":"NodeParagraph","Properties":{"id":"20240611153911-nnlxp38","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"④治小便不利：紫菀、车前子(布包)各12克。煎服。(《安徽中草药》)"}]},{"ID":"20240611153911-f8hioul","Type":"NodeParagraph","Properties":{"id":"20240611153911-f8hioul","updated":"20240611153911"},"Children":[{"Type":"NodeText","Data":"⑤治习惯性便秘：紫菀、苦杏仁、当归、肉苁蓉各9克。煎服。(《安徽中草药》)"}]},{"ID":"20240611153843-zdk0spb","Type":"NodeThematicBreak","Properties":{"id":"20240611153843-zdk0spb"}},{"ID":"20240611153852-ydy6kxi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153852-ydy6kxi","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"《中国药典》：紫菀"}]},{"ID":"20240611153852-8pqqhn0","Type":"NodeParagraph","Properties":{"id":"20240611153852-8pqqhn0","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611153852-kg56qkd","Type":"NodeParagraph","Properties":{"id":"20240611153852-kg56qkd","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" Zǐ Wǎn"}]},{"ID":"20240611153852-v7cknwt","Type":"NodeParagraph","Properties":{"id":"20240611153852-v7cknwt","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153852-3pl744z","Type":"NodeParagraph","Properties":{"id":"20240611153852-3pl744z","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 紫苑、小辫儿、夹板菜、驴耳朵菜、软紫菀"}]},{"ID":"20240611153852-n1hs86b","Type":"NodeParagraph","Properties":{"id":"20240611153852-n1hs86b","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611153852-el31wza","Type":"NodeParagraph","Properties":{"id":"20240611153852-el31wza","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" RADIX ASTERIS"}]},{"ID":"20240611153852-kldr5um","Type":"NodeParagraph","Properties":{"id":"20240611153852-kldr5um","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153852-aacy3ar","Type":"NodeParagraph","Properties":{"id":"20240611153852-aacy3ar","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫菀"},{"Type":"NodeText","Data":"Aster tataricus L. f.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去有节的根茎（习称“母根”）和泥沙，编成辫状晒干，或直接晒干。"}]},{"ID":"20240611153852-2mhckiv","Type":"NodeParagraph","Properties":{"id":"20240611153852-2mhckiv","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153852-tikj6lg","Type":"NodeParagraph","Properties":{"id":"20240611153852-tikj6lg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 本品根茎呈不规则块状，大小不一，顶端有茎、叶的残基，质稍硬。根茎簇生多数细根，长3～15cm,直径0.1～0.3cm，多编成辫状；表面紫红色或灰红色，有纵皱纹；质较柔韧。气微香，味甜、微苦。"}]},{"ID":"20240611153852-vbgu6y7","Type":"NodeParagraph","Properties":{"id":"20240611153852-vbgu6y7","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611153852-sndp7qp","Type":"NodeParagraph","Properties":{"id":"20240611153852-sndp7qp","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防潮。"}]},{"ID":"20240611153852-brqn9vh","Type":"NodeParagraph","Properties":{"id":"20240611153852-brqn9vh","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611153852-zkjqbrv","Type":"NodeParagraph","Properties":{"id":"20240611153852-zkjqbrv","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫菀"},{"Type":"NodeText","Data":"：除去杂质，洗净，稍润，切厚片，干燥。"}]},{"ID":"20240611153852-5ttyzfl","Type":"NodeParagraph","Properties":{"id":"20240611153852-5ttyzfl","updated":"20240611153852"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜜紫菀"},{"Type":"NodeText","Data":"：取紫菀片，照蜜炙法（附录Ⅱ D）炒至不粘手。"}]},{"ID":"20240611153852-rf0i7xs","Type":"NodeParagraph","Properties":{"id":"20240611153852-rf0i7xs","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611153852-syzubgp","Type":"NodeParagraph","Properties":{"id":"20240611153852-syzubgp","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" （1）本品根横切面：表皮细胞多萎缩或有时脱落，内含紫红色色素。下皮细胞1 列，略切向延长，侧壁及内壁稍厚，有的含紫红色色素。皮层宽广，有细胞间隙；分泌道4～6个，位于皮层内侧；内皮层明显。中柱小，木质部略呈多角形；韧皮部束位于木质部弧角间；中央通常有髓。根茎表皮有腺毛，皮层散有石细胞及厚壁细胞。根及根茎薄壁细胞含菊糖，有的含草酸钙簇晶。"}]},{"ID":"20240611153852-9b6j2q8","Type":"NodeParagraph","Properties":{"id":"20240611153852-9b6j2q8","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加水20ml，置60℃水浴上加热10分钟，趁热滤过，放冷。取滤液2ml ，置具塞试管中，用力振摇1 分钟，产生持久性泡沫，10分钟内不消失。"}]},{"ID":"20240611153852-ul00re9","Type":"NodeParagraph","Properties":{"id":"20240611153852-ul00re9","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末2g，加石油醚（60～90℃）30ml，加热回流30分钟，滤过，滤液浓缩至1ml,作为供试品溶液。另取紫菀酮对照品，加氯仿制成每1ml含1mg有溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一硅胶Ｇ薄层板上，以石油醚（60～90℃）-醋酸乙酯（9：1）为展开剂，展开，取出，晾干，喷以二硝基苯肼试液，日光下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同的黄色斑点。"}]},{"ID":"20240611153852-ybcvmqo","Type":"NodeParagraph","Properties":{"id":"20240611153852-ybcvmqo","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240611153852-sz0hdt9","Type":"NodeParagraph","Properties":{"id":"20240611153852-sz0hdt9","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 取本品粉末（过40目筛）约1g〔同时另取本品测定水分（附录Ⅸ H 第一法）〕，精密称定，精密加氯仿50ml，称定重量，40℃温浸1小时后，超声处理1小时，取出，冷却，再称定重量，用氯仿补足减失的重量，摇匀，滤过，精密量取续滤液25ml，挥干，残渣用氯仿溶解并转移至5ml量瓶中，加氯仿至刻度，作为供试品溶液。另取紫菀酮对照品适量，精密称定，加氯仿溶解，制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，精密吸取供试品溶液10μl、对照品溶液2μl和4μl，分别交叉点于同一硅胶G薄层板上，以石油醚（60～90℃）-醋酸乙酯（19：1）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，110℃加热至斑点显色清晰，取出，在薄层板上覆盖同样大小的玻璃板，周围用胶布固定，照薄层色谱法（附录Ⅵ B薄层扫描法）进行扫描，波长：λs=390nm，λR=650nm，测量供试品吸收度积分值与对照品吸收度积分值，计算，即得。"}]},{"ID":"20240611153852-lleq2xl","Type":"NodeParagraph","Properties":{"id":"20240611153852-lleq2xl","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含紫菀酮（C30H50O）不得少于0.20％。"}]},{"ID":"20240611153852-ok5qreq","Type":"NodeParagraph","Properties":{"id":"20240611153852-ok5qreq","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611153852-llg0ye3","Type":"NodeParagraph","Properties":{"id":"20240611153852-llg0ye3","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 归肺经。"}]},{"ID":"20240611153852-ej4ce1m","Type":"NodeParagraph","Properties":{"id":"20240611153852-ej4ce1m","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611153852-v9098bo","Type":"NodeParagraph","Properties":{"id":"20240611153852-v9098bo","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 辛，苦，温。"}]},{"ID":"20240611153852-n59ncb8","Type":"NodeParagraph","Properties":{"id":"20240611153852-n59ncb8","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153852-11nlp2q","Type":"NodeParagraph","Properties":{"id":"20240611153852-11nlp2q","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 润肺下气，消痰止咳。用于痰多喘咳，新久咳嗽，劳嗽咳血。"}]},{"ID":"20240611153852-9gwfidk","Type":"NodeParagraph","Properties":{"id":"20240611153852-9gwfidk","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611153852-mvbuary","Type":"NodeParagraph","Properties":{"id":"20240611153852-mvbuary","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 5～9g。"}]},{"ID":"20240611153852-3h0v2d8","Type":"NodeParagraph","Properties":{"id":"20240611153852-3h0v2d8","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611153852-btzl1ad","Type":"NodeParagraph","Properties":{"id":"20240611153852-btzl1ad","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611153852-rzqx5av","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153852-rzqx5av","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：紫菀"}]},{"ID":"20240611153852-q3wjyl2","Type":"NodeParagraph","Properties":{"id":"20240611153852-q3wjyl2","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611153852-gp616tz","Type":"NodeParagraph","Properties":{"id":"20240611153852-gp616tz","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" Zǐ Wǎn"}]},{"ID":"20240611153852-m3nqasg","Type":"NodeParagraph","Properties":{"id":"20240611153852-m3nqasg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153852-ppxtju3","Type":"NodeParagraph","Properties":{"id":"20240611153852-ppxtju3","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 青菀（《吴普本草》），紫蒨（《别录》），返魂草根、夜牵牛（《斗门方》），紫菀茸（《本草述》）。"}]},{"ID":"20240611153852-jjfs54d","Type":"NodeParagraph","Properties":{"id":"20240611153852-jjfs54d","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611153852-183x1ud","Type":"NodeParagraph","Properties":{"id":"20240611153852-183x1ud","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611153852-7ohspqj","Type":"NodeParagraph","Properties":{"id":"20240611153852-7ohspqj","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153852-ryg39zv","Type":"NodeParagraph","Properties":{"id":"20240611153852-ryg39zv","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫菀"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋均可采挖，除去茎叶及泥土，晒干，或将须根编成小辫晒干，商品称为\"辫紫菀\"。"}]},{"ID":"20240611153852-hmt0b49","Type":"NodeParagraph","Properties":{"id":"20240611153852-hmt0b49","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611153852-hmo74mu","Type":"NodeParagraph","Properties":{"id":"20240611153852-hmo74mu","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 生于山地或河边草地。分布黑龙江、吉林、辽宁、河北等地。河北、安徽等地有栽培。主产河北、安徽等地。"}]},{"ID":"20240611153852-we12v3d","Type":"NodeParagraph","Properties":{"id":"20240611153852-we12v3d","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611153852-cnx318c","Type":"NodeParagraph","Properties":{"id":"20240611153852-cnx318c","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高1～1.5米。根茎短，簇生多数细根，外皮灰褐色。茎直立，上部分枝，表面有沟槽。根生叶丛生，开花时脱落；叶片篦状长椭圆形至椭圆状披针形，长20～40厘米，宽6～12厘米，先端钝，基部渐狭，延成长翼状的叶柄，边缘具锐齿，两面疏生小刚毛；茎生叶互生，几无柄，叶片狭长椭圆形或披针形，长18～35厘米，宽5～10厘米，先端锐尖，常带小尖头，中部以下渐狭缩成一狭长基部。头状花序多数，伞房状排列，直径2.5～3.5厘米，有长梗，梗上密被刚毛；总苞半球形，苞片3列，长圆状披针形，绿色微带紫；舌状花带蓝紫色，单性，花冠长15～18毫米，先端3浅裂，基部呈管状，花柱1枚，柱头2叉；管状花黄色，长约6毫米，先端5齿裂，雄蕊5，花药细长，聚合，包围花柱；子房下位，柱头2叉，瘦果扁平，一侧弯曲，长3毫米，被短毛；冠毛白色或淡褐色，较瘦果长3～4倍。花期8月。果期9～10月。"}]},{"ID":"20240611153852-7komgl9","Type":"NodeParagraph","Properties":{"id":"20240611153852-7komgl9","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153852-dj1r0yv","Type":"NodeParagraph","Properties":{"id":"20240611153852-dj1r0yv","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 干燥的根茎呈圆形的疙瘩头状，长约2～6厘米，径约1.5～3厘米，顶端有茎基及叶柄的残痕，底部常有一条未除净的母根，直径约3毫米，淡灰黄色，纤维性，质稍硬；疙瘩头下簇生许多须根，根长约5～14厘米，多编成辫状；表面紫红色或灰红色，有纵皱纹。质柔韧，不易折断，断面灰白色有紫边。微有香气，味甜微苦。以根长、色紫、质柔韧、去净茎苗者为佳。"}]},{"ID":"20240611153852-m9sml93","Type":"NodeParagraph","Properties":{"id":"20240611153852-m9sml93","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611153852-7jmjtbl","Type":"NodeParagraph","Properties":{"id":"20240611153852-7jmjtbl","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 根含无羁萜醇、无羁萜、紫菀酮、紫菀皂甙、槲皮素，挥发油中含毛叶醇、乙酸毛叶酯、茴香醚、烃、脂肪酸、芳香族酸等。"}]},{"ID":"20240611153852-bnxyphg","Type":"NodeParagraph","Properties":{"id":"20240611153852-bnxyphg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611153852-uun3cpa","Type":"NodeParagraph","Properties":{"id":"20240611153852-uun3cpa","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" ①祛痰、镇咳作用"}]},{"ID":"20240611153852-j696q5n","Type":"NodeParagraph","Properties":{"id":"20240611153852-j696q5n","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"麻醉兔灌服煎剂1克/公斤，有显着祛痰作用（呼吸道分泌量测定法），作用可持续4小时以上，粗提取物口服对大鼠气管分泌物也有明显增加作用。对碘液注入猫右肋膜腔引起的咳嗽，灌服煎剂无效，但用氨水喷雾引起的小鼠咳嗽则有显着效果。"}]},{"ID":"20240611153852-9wzy8yz","Type":"NodeParagraph","Properties":{"id":"20240611153852-9wzy8yz","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②抗菌作用"}]},{"ID":"20240611153852-dg70n0o","Type":"NodeParagraph","Properties":{"id":"20240611153852-dg70n0o","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"体外试验对大肠杆菌、痢疾杆菌（宋内氏）、变形杆菌、伤寒杆菌、副伤寒杆菌、绿脓杆菌及霍乱弧菌等有一定的抑制作用。"}]},{"ID":"20240611153852-oweo82g","Type":"NodeParagraph","Properties":{"id":"20240611153852-oweo82g","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"③抗癌作用"}]},{"ID":"20240611153852-g80ioba","Type":"NodeParagraph","Properties":{"id":"20240611153852-g80ioba","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"从紫菀中分离出的表无羁萜醇对艾氏腹水癌有一定抗癌作用。"}]},{"ID":"20240611153852-oens1k4","Type":"NodeParagraph","Properties":{"id":"20240611153852-oens1k4","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611153852-q64p16o","Type":"NodeParagraph","Properties":{"id":"20240611153852-q64p16o","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 紫菀：捡去杂质，除去残茎，洗净，稍闷润，切成小段晒干。蜜紫菀：取紫菀段加炼蜜（和以适量开水）拌匀，稍闷润，用文火炒至不粘手为度，取出放凉。（每紫菀100斤，用炼蜜25斤）"}]},{"ID":"20240611153852-ju8pq3h","Type":"NodeParagraph","Properties":{"id":"20240611153852-ju8pq3h","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611153852-jrfsb1e","Type":"NodeParagraph","Properties":{"id":"20240611153852-jrfsb1e","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 入肺经。"}]},{"ID":"20240611153852-zqh7dp6","Type":"NodeParagraph","Properties":{"id":"20240611153852-zqh7dp6","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入心、肺二经。\""}]},{"ID":"20240611153852-7vecdu1","Type":"NodeParagraph","Properties":{"id":"20240611153852-7vecdu1","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入手太阴，兼入足阳明。\""}]},{"ID":"20240611153852-gurij92","Type":"NodeParagraph","Properties":{"id":"20240611153852-gurij92","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611153852-5p1qb6v","Type":"NodeParagraph","Properties":{"id":"20240611153852-5p1qb6v","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 苦，温。"}]},{"ID":"20240611153852-6m434nr","Type":"NodeParagraph","Properties":{"id":"20240611153852-6m434nr","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，温。\""}]},{"ID":"20240611153852-l7mdptm","Type":"NodeParagraph","Properties":{"id":"20240611153852-l7mdptm","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛，无毒。\""}]},{"ID":"20240611153852-lw8vx4w","Type":"NodeParagraph","Properties":{"id":"20240611153852-lw8vx4w","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦，平。\""}]},{"ID":"20240611153852-k63jtav","Type":"NodeParagraph","Properties":{"id":"20240611153852-k63jtav","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"④《本草通玄》：\"辛甘，微温。\""}]},{"ID":"20240611153852-lafgimm","Type":"NodeParagraph","Properties":{"id":"20240611153852-lafgimm","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611153852-qp9p6v4","Type":"NodeParagraph","Properties":{"id":"20240611153852-qp9p6v4","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 有实热者忌服。"}]},{"ID":"20240611153852-xwvqqaq","Type":"NodeParagraph","Properties":{"id":"20240611153852-xwvqqaq","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"款冬为使。恶天雄、瞿麦、雷丸、远志。畏茵陈蒿。\""}]},{"ID":"20240611153852-jfttl6q","Type":"NodeParagraph","Properties":{"id":"20240611153852-jfttl6q","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"恶蒿本。\""}]},{"ID":"20240611153852-f4slmh3","Type":"NodeParagraph","Properties":{"id":"20240611153852-f4slmh3","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"劳伤肺肾、水亏金燥而咳喘者非所宜。\""}]},{"ID":"20240611153852-vixg9nl","Type":"NodeParagraph","Properties":{"id":"20240611153852-vixg9nl","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153852-b99zo93","Type":"NodeParagraph","Properties":{"id":"20240611153852-b99zo93","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 温肺，下气，消痰，止咳。治风寒咳嗽气喘，虚劳咳吐脓血，喉痹，小便不利。"}]},{"ID":"20240611153852-2fwqe31","Type":"NodeParagraph","Properties":{"id":"20240611153852-2fwqe31","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主咳逆上气，胸中寒热结气，去蛊毒、痿蹷，安五藏。\""}]},{"ID":"20240611153852-g5qs96n","Type":"NodeParagraph","Properties":{"id":"20240611153852-g5qs96n","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗咳唾脓血，止喘悸，五劳体虚，补不足，小儿惊痫。\""}]},{"ID":"20240611153852-veob1g7","Type":"NodeParagraph","Properties":{"id":"20240611153852-veob1g7","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"补虚下气，治胸胁逆气，劳气虚热。\""}]},{"ID":"20240611153852-5g18xa9","Type":"NodeParagraph","Properties":{"id":"20240611153852-5g18xa9","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"治气喘，阴痿。\""}]},{"ID":"20240611153852-cnxyhnu","Type":"NodeParagraph","Properties":{"id":"20240611153852-cnxyhnu","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"调中及肺痿吐血，消痰止咳。\""}]},{"ID":"20240611153852-g6neh6q","Type":"NodeParagraph","Properties":{"id":"20240611153852-g6neh6q","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑥《本草衍义》：\"益肺气。\""}]},{"ID":"20240611153852-quxaao1","Type":"NodeParagraph","Properties":{"id":"20240611153852-quxaao1","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑦王好古：\"主息贲。\""}]},{"ID":"20240611153852-oss91ck","Type":"NodeParagraph","Properties":{"id":"20240611153852-oss91ck","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑧宁原《食鉴本草》：\"主肺经虚热，开喉痹，取恶涎。\""}]},{"ID":"20240611153852-wi2mx56","Type":"NodeParagraph","Properties":{"id":"20240611153852-wi2mx56","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑨《本草从新》：\"专治血痰，为血劳圣药。又能通利小肠。\""}]},{"ID":"20240611153852-yihu2g2","Type":"NodeParagraph","Properties":{"id":"20240611153852-yihu2g2","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"润肺下气，寒痰及虚喘者宜之。\""}]},{"ID":"20240611153852-lzxjz3y","Type":"NodeParagraph","Properties":{"id":"20240611153852-lzxjz3y","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611153852-a53puoi","Type":"NodeParagraph","Properties":{"id":"20240611153852-a53puoi","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～3钱；或入丸、散。"}]},{"ID":"20240611153852-ngadkmr","Type":"NodeParagraph","Properties":{"id":"20240611153852-ngadkmr","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611153852-nkdo92u","Type":"NodeParagraph","Properties":{"id":"20240611153852-nkdo92u","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" ①治久咳不瘥：紫菀（去芦头）、款冬花各一两，百部半两。三物捣罗为散，每服三钱匕，生姜三片，乌梅一个，同煎汤调下，食后、欲卧各一服。（《本草图经》）"}]},{"ID":"20240611153852-dlgpwzp","Type":"NodeParagraph","Properties":{"id":"20240611153852-dlgpwzp","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②治伤寒后肺痿劳嗽，唾脓血腥臭，连连不止，渐将羸瘦：紫菀一两，桔梗一两半（去芦头），天门冬一两（去心），贝母一两（煨令微黄），百合三分，知母三分，生干地黄一两半。上药捣筛为散，每服四钱，以水一中盏，煎至六分，去滓，温服。（《圣惠方》紫菀散）"}]},{"ID":"20240611153852-b44hfjv","Type":"NodeParagraph","Properties":{"id":"20240611153852-b44hfjv","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"③治小儿咳逆上气，喉中有声，不通利：紫菀一两，杏仁（去皮尖）、细辛、款冬花各一分。上四味，捣罗为散，二三岁儿，每服半钱匕，米饮调下，日三，更量大小加减。（《圣济总录》紫菀散）"}]},{"ID":"20240611153852-xfxa9ib","Type":"NodeParagraph","Properties":{"id":"20240611153852-xfxa9ib","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"④治妊娠咳嗽不止，胎动不安：紫菀一两，桔梗半两，甘草、杏仁、桑白皮各二钱半，天门冬一两。上细切，每服三钱。竹茹一块，水煎，去滓，入蜜半匙，再煎二沸，温服。（《伤寒保命集》紫菀汤）"}]},{"ID":"20240611153852-68u5nrg","Type":"NodeParagraph","Properties":{"id":"20240611153852-68u5nrg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑤治吐血、咯血、嗽血：真紫菀、茜根等分。为细末，炼蜜为丸，如樱桃子大，含化一丸，不以时。（《鸡峰普济方》紫菀丸）"}]},{"ID":"20240611153852-re98k2w","Type":"NodeParagraph","Properties":{"id":"20240611153852-re98k2w","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑥治妇人卒不得小便：紫菀末，井华水服三指撮。（《千金方》）"}]},{"ID":"20240611153852-ydajmjn","Type":"NodeParagraph","Properties":{"id":"20240611153852-ydajmjn","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑦肺伤咳嗽。用紫菀花五钱，加水一碗，煎至七成，温服。一天服三次。"}]},{"ID":"20240611153852-cge133s","Type":"NodeParagraph","Properties":{"id":"20240611153852-cge133s","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑧吐血咳嗽。用紫苑、五味子炒过，共研为末，加蜜做成丸子，如芡子大。每次含化一丸。"}]},{"ID":"20240611153852-1f0087q","Type":"NodeParagraph","Properties":{"id":"20240611153852-1f0087q","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑨产后下血。用紫菀末五撮，水冲服。"}]},{"ID":"20240611153852-6u5eo2v","Type":"NodeParagraph","Properties":{"id":"20240611153852-6u5eo2v","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑩缠喉风痹。用紫菀根一条，洗净，放入喉部，有涎出，病即渐愈。"}]},{"ID":"20240611153852-nnt9q2w","Type":"NodeParagraph","Properties":{"id":"20240611153852-nnt9q2w","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611153852-wkx81fw","Type":"NodeParagraph","Properties":{"id":"20240611153852-wkx81fw","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"紫菀，观其能开喉痹，取恶涎，则辛散之功烈矣，而其性温，肺病咳逆喘嗽，皆阴虚肺热证也，不宜专用及多用，即用亦须与天门冬、百部、麦冬、桑白皮苦寒之药参用，则无害。\""}]},{"ID":"20240611153852-xrvufp0","Type":"NodeParagraph","Properties":{"id":"20240611153852-xrvufp0","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"紫菀，辛而不燥，润而不寒，补而不滞。然非独用、多用不能速效，小便不通及溺血者服一两立效。\""}]},{"ID":"20240611153852-0ig4aq7","Type":"NodeParagraph","Properties":{"id":"20240611153852-0ig4aq7","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"紫菀，辛能入肺，苦能降气，故治咳嗽上气、痰喘，惟肺实气壅，或火邪刑金而致咳唾脓血者，乃可用之。观陶氏《别录》谓其补不足，其亦言之过也。\""}]},{"ID":"20240611153852-wezut4z","Type":"NodeParagraph","Properties":{"id":"20240611153852-wezut4z","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"紫菀，味甘而带苦，性凉而体润，恰合肺部血分。主治肺焦叶举，久嗽痰中带血，及肺痿，痰喘，消渴，使肺窍有清凉沛泽之功。...用入肝经，凡劳热不足，肝之表病也；蓄热结气，肝之里病也；吐血衄血，肝之逆上也；便血溺血，肝之妄下也；无不奏效。因其体润，善能滋肾，盖肾主二便，以此润大便燥结，利小便短赤，开发阴阳，宣通壅滞，大有神功。同生地、麦冬入心，宁神养血。同丹皮、赤芍入胃，清热凉血。其桑皮为肺中气药，紫菀为肺中血药，宜分别用。\""}]},{"ID":"20240611153852-b66pk29","Type":"NodeParagraph","Properties":{"id":"20240611153852-b66pk29","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑤《本草逢原》：\"紫菀，肺金血分之药，《本经》止咳逆上气，胸中寒热结气，取性疏利肺经血气也。去蛊毒痿躄者，以其辛苦微温，能散结降气，蛊毒自不能留，痿躄由肺热叶焦，紫菀专通肺气，使热从溲便去耳。《别录》疗咳唾脓血，大明消痰止渴，皆滋肺经血气之效。《金匮》泽漆汤用以治咳血而脉沉者，咳属肺，脉沉则血分之病也。亦治下痢肺痛，与紫参同功。\""}]},{"ID":"20240611153852-xhva4ue","Type":"NodeParagraph","Properties":{"id":"20240611153852-xhva4ue","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"⑥《本草正义》：\"紫菀，柔润有余，虽曰苦辛而温，非爆烈可比，专能开泄肺郁，定咳降逆，宣通窒滞，兼疏肺家气血。凡风寒外束，肺气壅塞，咳呛不爽，喘促哮吼，及气火燔灼，郁为肺痈，咳吐脓血，痰臭腥秽诸证，无不治之。而寒饮蟠踞，浊涎胶固喉中如水鸡声者，尤为相宜。惟其温而不热，润而不燥，所以寒热皆宜，无所避忌。景岳谓水亏金燥，咳嗽失血者，非其所宜；石顽谓阴虚肺热干咳者忌之；盖恐开泄太过，重伤肺金，又恐辛温之性，或至助火。要之虚劳作嗽，亦必有浊痰阻塞肺窍，故频频作咳，以求其通，不为开之，咳亦不止，以此温润之品，泄化垢腻，顺调气机，而不伤于正，不偏于燥，又不犯寒凉遏抑、滋腻恋郁等弊，岂非正治？且柔润之质，必不偏热，较之二冬、二母，名为滋阴，而群阴腻滞，阻塞隧道者，相去犹远。惟实火作咳，及肺痈成脓者，则紫菀虽能泄降，微嫌其近于辛温，不可重任，然借为向导，以捣穴犁庭，亦无不可。总之，肺金窒塞，无论为寒为火，皆有非此不开之势。\""}]},{"ID":"20240611153852-cmp0csd","Type":"NodeParagraph","Properties":{"id":"20240611153852-cmp0csd","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611153852-nrg07sk","Type":"NodeParagraph","Properties":{"id":"20240611153852-nrg07sk","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 紫菀除了上述一种外，在新疆地区以阿尔泰狗哇花的根入药（参见\"阿尔泰紫菀\"条）；西藏地区以缘毛紫菀及重冠紫菀的根及根茎入药。在东北、华北、陕西、云南、四川、新疆等地，还以菊科橐吾属多种植物的根部作紫菀入药，商品统称\"山紫菀\"。其质硬而易断，气香而微辣。原植物主要为肾叶橐吾（参见\"葫芦七\"条）、西伯利亚橐吾、狭苞橐吾、四川橐吾（参见\"南瓜七\"条）、大叶橐吾、裂叶橐吾等。"}]},{"ID":"20240611153852-rhifhey","Type":"NodeParagraph","Properties":{"id":"20240611153852-rhifhey","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611153852-v51tipe","Type":"NodeParagraph","Properties":{"id":"20240611153852-v51tipe","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611153852-9dtum12","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153852-9dtum12","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"《中华本草》：紫菀"}]},{"ID":"20240611153852-66xyfag","Type":"NodeParagraph","Properties":{"id":"20240611153852-66xyfag","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611153852-p6wceji","Type":"NodeParagraph","Properties":{"id":"20240611153852-p6wceji","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" Zǐ Wǎn"}]},{"ID":"20240611153852-2xwh4gw","Type":"NodeParagraph","Properties":{"id":"20240611153852-2xwh4gw","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153852-q3c0m0v","Type":"NodeParagraph","Properties":{"id":"20240611153852-q3c0m0v","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 青菀、紫葥、返魂草根、夜牵牛、紫菀茸、关公须"}]},{"ID":"20240611153852-gqrib37","Type":"NodeParagraph","Properties":{"id":"20240611153852-gqrib37","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611153852-3bzv0jp","Type":"NodeParagraph","Properties":{"id":"20240611153852-3bzv0jp","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" Tatarian Aster Root"}]},{"ID":"20240611153852-xe585qu","Type":"NodeParagraph","Properties":{"id":"20240611153852-xe585qu","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611153852-c2tscrt","Type":"NodeParagraph","Properties":{"id":"20240611153852-c2tscrt","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611153852-1foe1kz","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611153852-1foe1kz","updated":"20240611153852"},"Children":[{"ID":"20240611153852-cg1n000","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611153852-cg1n000","updated":"20240611153852"},"Children":[{"ID":"20240611153852-xaif32z","Type":"NodeParagraph","Properties":{"id":"20240611153852-xaif32z","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"陶弘景：紫菀，近道处处有生。布地，花亦紫，本有白毛，根甚柔细。"}]}]}]},{"ID":"20240611153852-tjlmibx","Type":"NodeParagraph","Properties":{"id":"20240611153852-tjlmibx","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：紫菀，形似重台，根作节，紫色润软者佳。"}]},{"ID":"20240611153852-kk4sr5d","Type":"NodeParagraph","Properties":{"id":"20240611153852-kk4sr5d","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"3.《本草图组》：紫菀，三月内布地生苗叶，其叶三四相连，五月六月内开黄紫白花，结黑子，本有白毛，根基柔细，二月三月内取根阴干用。"}]},{"ID":"20240611153852-af25j01","Type":"NodeParagraph","Properties":{"id":"20240611153852-af25j01","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"4.《本草衍义》：紫菀用根，其根柔细，紫色，益肺气，《经》具言之。《唐本注》言无紫菀时，亦用白"}]},{"ID":"20240611153852-127fvqb","Type":"NodeParagraph","Properties":{"id":"20240611153852-127fvqb","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153852-7i8tjac","Type":"NodeParagraph","Properties":{"id":"20240611153852-7i8tjac","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物紫菀的根和根茎。"}]},{"ID":"20240611153852-k8b9dlw","Type":"NodeParagraph","Properties":{"id":"20240611153852-k8b9dlw","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Aster tataricus L. F."}]},{"ID":"20240611153852-bfq9ukg","Type":"NodeParagraph","Properties":{"id":"20240611153852-bfq9ukg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"采收和储藏：10月下旬至翌年刂春，待地上部分枯萎后，挖掘根部，除去枯叶，将细根编成小辫状，晒至全干。"}]},{"ID":"20240611153852-aesebqn","Type":"NodeParagraph","Properties":{"id":"20240611153852-aesebqn","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611153852-cbikc7i","Type":"NodeParagraph","Properties":{"id":"20240611153852-cbikc7i","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于低山阴披湿地、山顶和低山草地及沼泽地。"}]},{"ID":"20240611153852-q2e90m0","Type":"NodeParagraph","Properties":{"id":"20240611153852-q2e90m0","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、陕西、甘肃南部有安徽北部、河南西部。"}]},{"ID":"20240611153852-ony4d14","Type":"NodeParagraph","Properties":{"id":"20240611153852-ony4d14","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611153852-t2m354q","Type":"NodeParagraph","Properties":{"id":"20240611153852-t2m354q","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 紫菀 多年生草本，高40-150cm。茎直立，通常不分，粗壮，有疏糙毛。根茎短，必生多数须根。基生叶花期枯萎、脱落，长圆状或椭圆状匙形，长20-50cm，宽3-13cm，基部下延；茎生叶互生，无柄；叶片长椭圆形或披针形，长18-35cm，基部下延；茎生叶互生，无柄；叶片椭圆形或披针形，长18-35cm，宽5-10cm，中脉粗壮，有6-10对羽状侧脉。头花序多数，直径2.5-4.5cm，排列成复伞房状；决苞半球形，宽10-25mm，总苞片3层，外层渐短，全部或上部草质，先端尖或圆形，边缘宽膜质，紫红色；花序边缘为舌状花，约20多个，蓝紫色，舌片先端3齿裂，花柱，柱头2分叉；中央有多数筒状花，两性，黄色，先端5齿裂；雄蕊5；柱头2分叉。瘦果倒卵状长圆形，扁平，紫褐色，长2.5-3mm，两面各有1脉或少有3脉，上部具短伏毛，冠毛污白色或带红色。花期7-9月，果期9-10月。"}]},{"ID":"20240611153852-6qwkk65","Type":"NodeParagraph","Properties":{"id":"20240611153852-6qwkk65","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611153852-qv0o7v2","Type":"NodeParagraph","Properties":{"id":"20240611153852-qv0o7v2","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，耐寒，耐涝、怕时时。冬季气温-20℃时根可以安全越冬。除盐碱地外均可栽种，尤以土层深厚、疏松肥沃，富含腐殖质，排水良好的砂质壤土栽培为宜，粗性土不宜栽培。忌连作。"}]},{"ID":"20240611153852-v8qgchi","Type":"NodeParagraph","Properties":{"id":"20240611153852-v8qgchi","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"栽培技术 用根茎、根头繁殖。根茎繁殖：11月上旬至4月上旬，选择鲜嫩、粗壮、节必、无病虫害的紫红色的根茎，截成5-8cm长的小段，每段应带有2-3个芽作种茎。条栽，按行析距30cm开沟，沟深9cm，每隔24cm，顺沟平放种根一段，覆土、镇压、浇水。穴栽，按行株距30cm×24cm开穴，穴深3-5cm，平放种茎2-3段，覆土、浇。气温在10-15℃时，约经10-15d左右出苗。根头繁殖：将带有须根的根头分切成几小块，按行距30cm开沟，沟深3-6cm，每隔12-15cm，栽种1块，芽头向上，覆土，稍加镇压、浇水。春栽根状茎需窖藏。"}]},{"ID":"20240611153852-t4z2zpj","Type":"NodeParagraph","Properties":{"id":"20240611153852-t4z2zpj","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"田间管理 出苗后要间苗，除去必苗、弱苗。6-7月要经常浇水保湿，但不可过湿，以免影响扎根；并追施硫酸铵、过磷酸钙。抽苔时要摘花苔。"}]},{"ID":"20240611153852-tz11a3w","Type":"NodeParagraph","Properties":{"id":"20240611153852-tz11a3w","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有白绢病、褐斑病，可喷1：1：100倍波尔多液或多抗每素200倍液。虫害有地老虎、蛴螬、菜青虫等为害。"}]},{"ID":"20240611153852-ggw5qss","Type":"NodeParagraph","Properties":{"id":"20240611153852-ggw5qss","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153852-bgd4fuj","Type":"NodeParagraph","Properties":{"id":"20240611153852-bgd4fuj","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎一规则块状，长2-5cm，直径1-3cm；表面紫红色或灰红色，顶端殖留茎基及叶柄殖痕，中下部丛生多数细根；质坚硬，断面较平坦，显油性。根多数，细长，长6-15cm，直径1-3mm，多编成辫状；表面紫红色或灰红色，有纵皱纹；质较柔韧，易折断，断面淡棕色，边缘一圈现紫红色，中内有细小木心。气微香，味甜、微苦。"}]},{"ID":"20240611153852-mgty497","Type":"NodeParagraph","Properties":{"id":"20240611153852-mgty497","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"以根长、色紫红、质柔韧者为佳。"}]},{"ID":"20240611153852-yo9ao5u","Type":"NodeParagraph","Properties":{"id":"20240611153852-yo9ao5u","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：表皮细胞类圆形或类方形，多脱落或皱缩，内含紫红色色素。下皮细胞1列，略切向延长，侧壁及内壁增厚，有的内含紫红色色素。皮层宽广，有少数厚壁细胞，散在；油管呈类圆形或扁圆形，直径30-75μm，位于皮层内侧，常与韧皮部束同数并相对；内皮层明显。中柱小，中柱鞘1-2列细胞；初生木质部4-6原型。中央常有髓。本品薄壁细胞含菊糖。"}]},{"ID":"20240611153852-gsdnzqy","Type":"NodeParagraph","Properties":{"id":"20240611153852-gsdnzqy","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"粉末特征：红棕色。①菊糖碎块，用冷水合氯醛装置，叶房形、半圆形或不规则形，表面现放射状线纹。②下皮细胞紫红色、淡黄棕色或无色；表面观略呈长方形，垂周壁稍增厚，细波状弯曲。③石细胞（根茎）单个散在，类长方形、类圆形或圆三角形，直径44-154μm，长95-177μm，壁厚6-22μm，层纹及孔沟明显，有的胸腔内含草酸钙簇晶或黄棕色物。④厚壁细胸长条形，直径38-73μm，长可至315μm，壁厚2-10μm，非木化，纹孔排列成纵行。⑤油管碎片易见，分泌细胞及管道内均含黄棕色或红棕色分泌物。⑥草酸钙簇晶存在于薄壁细胞中，直径8-20μm，有的一个细胞含数个结晶，或含晶细胞纵向连接，簇晶排列成行。此外，可见木纤维、导管等。"}]},{"ID":"20240611153852-iv1qlxt","Type":"NodeParagraph","Properties":{"id":"20240611153852-iv1qlxt","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611153852-bf3keaa","Type":"NodeParagraph","Properties":{"id":"20240611153852-bf3keaa","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 紫菀皂甙有溶血作用，制剂不宜静脉注射。"}]},{"ID":"20240611153852-mhwc7hd","Type":"NodeParagraph","Properties":{"id":"20240611153852-mhwc7hd","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611153852-m7d9uhi","Type":"NodeParagraph","Properties":{"id":"20240611153852-m7d9uhi","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 根含无羁萜（freidelin）[1]，表无羁萜醇（epifriedeliol），紫菀酮（shionone）[1，2]，紫菀甙（shionoside）A、B[2]及C[3]，紫菀皂甙（asetr saponin）A、B、C、D[4]、E、F[5]及G[6]，紫菀五肽（asterin）A、B[7]，紫菀氯环五肽（astin，曾用名 asterin）C[8，9]；还含植物甾醇葡萄糖甙（phytosterol glucosides）及挥发油，押发油的成分有毛叶醇（lachnophyllol），乙酸毛叶酯（lachnophyl-lol acetate），茴香脑（anethole），烃，脂肪酸，芒香族酸等[10]。"}]},{"ID":"20240611153852-w00m2jf","Type":"NodeParagraph","Properties":{"id":"20240611153852-w00m2jf","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"另有报道紫菀含紫菀氯环五肽（astin）A、B、C[9]，D、E[11]及丁基-D-核酮糖甙(butyl-d-RIBULOSIDE）[12]。"}]},{"ID":"20240611153852-jjl9unf","Type":"NodeParagraph","Properties":{"id":"20240611153852-jjl9unf","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611153852-tvwve82","Type":"NodeParagraph","Properties":{"id":"20240611153852-tvwve82","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 1.祛痰作用：中医认为紫菀具有温肺，下气，消痰、止咳嗽的功能。实验表明，水煎剂有祛痰作用而无镇咳及平喘作用；苯及甲醇提取物也有祛痰作用。"}]},{"ID":"20240611153852-3u6ynlw","Type":"NodeParagraph","Properties":{"id":"20240611153852-3u6ynlw","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用：紫菀在体外对大肠杆菌、痢疾杆菌、变形菌、伤寒杆菌、副伤寒杆菌、绿脓杆菌及霍乱弧菌等7种革兰氏阴性肠内致病菌有一定的抑制作用；并有对抗致病性真菌的作用。"}]},{"ID":"20240611153852-hnyo0vu","Type":"NodeParagraph","Properties":{"id":"20240611153852-hnyo0vu","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"3.抗病毒作用：水煎剂在鸡胚尿囊中对流感病毒有明显的抑制作用。"}]},{"ID":"20240611153852-wq7vl7u","Type":"NodeParagraph","Properties":{"id":"20240611153852-wq7vl7u","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"4.抑制肿瘤的作用：据报道分离出的表无羁萜醇对小鼠艾氏腹水癌有抑瘤作用；也有报道从紫菀根的正丁醇提取部分分离出的环肽类化合物对S180有抗肿瘤活性。"}]},{"ID":"20240611153852-3m7kebi","Type":"NodeParagraph","Properties":{"id":"20240611153852-3m7kebi","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611153852-esfsyd3","Type":"NodeParagraph","Properties":{"id":"20240611153852-esfsyd3","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 紫菀：拣去杂质，除去残茎，洗净，稍闷润，切成小段晒干。蜜紫菀： 取紫菀段加炼蜜(和以适量开水)拌匀，稍闷，用文火炒至不粘手为度，取出放凉。(每紫菀100斤，用炼蜜25斤)"}]},{"ID":"20240611153852-xlyvlap","Type":"NodeParagraph","Properties":{"id":"20240611153852-xlyvlap","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611153852-j0d0i7a","Type":"NodeParagraph","Properties":{"id":"20240611153852-j0d0i7a","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末2g，加水20ml，置60℃水浴上加热10min，趁热滤过，放冷。取滤液2ml，置带塞试管中，用力振摇1min，产生持久性泡沫，10min，内不消失。（检查皂甙）"}]},{"ID":"20240611153852-byqd6vv","Type":"NodeParagraph","Properties":{"id":"20240611153852-byqd6vv","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611153852-nvlfya5","Type":"NodeParagraph","Properties":{"id":"20240611153852-nvlfya5","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 归肺经"}]},{"ID":"20240611153852-guarkou","Type":"NodeParagraph","Properties":{"id":"20240611153852-guarkou","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611153852-cuearcl","Type":"NodeParagraph","Properties":{"id":"20240611153852-cuearcl","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性温"}]},{"ID":"20240611153852-8qklimd","Type":"NodeParagraph","Properties":{"id":"20240611153852-8qklimd","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611153852-a4h4dt6","Type":"NodeParagraph","Properties":{"id":"20240611153852-a4h4dt6","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 有实热者忌服。"}]},{"ID":"20240611153852-4jb92x7","Type":"NodeParagraph","Properties":{"id":"20240611153852-4jb92x7","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：款冬为使。恶天雄、瞿麦、雷丸、远志。畏茵陈蒿。"}]},{"ID":"20240611153852-n0oqxww","Type":"NodeParagraph","Properties":{"id":"20240611153852-n0oqxww","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：恶藁本。"}]},{"ID":"20240611153852-zp2wrhj","Type":"NodeParagraph","Properties":{"id":"20240611153852-zp2wrhj","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：劳伤肺肾、水亏金燥而咳喘失血者非所。"}]},{"ID":"20240611153852-2tep9nt","Type":"NodeParagraph","Properties":{"id":"20240611153852-2tep9nt","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153852-yi07bdz","Type":"NodeParagraph","Properties":{"id":"20240611153852-yi07bdz","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 润肺下气；化痰止咳。主咳嗽；肺虚劳嗽；肺痿肺痈；咳吐脓血；小便不利"}]},{"ID":"20240611153852-qvqw93i","Type":"NodeParagraph","Properties":{"id":"20240611153852-qvqw93i","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611153852-djuo80j","Type":"NodeParagraph","Properties":{"id":"20240611153852-djuo80j","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，4.5-10g；或入丸、散。"}]},{"ID":"20240611153852-nm6no4d","Type":"NodeParagraph","Properties":{"id":"20240611153852-nm6no4d","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611153852-1fpyh8z","Type":"NodeParagraph","Properties":{"id":"20240611153852-1fpyh8z","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" ①治久嗽不瘥：紫菀(去芦头)、款冬花各一两，百部半两。三物捣罗为散，每服三钱匕，生姜三片，乌梅一个，同煎汤调下，食后、欲卧各一服。(《本草图经》)②治伤寒后肺痿劳嗽， 唾脓血腥臭，连连不止，渐将羸瘦： 紫菀一两，桔梗一两半(去芦头)，天门冬一两(去心)，贝母一两(煨令微黄)，百合三分，知母三分，生干地黄一两半。上药捣筛为散，每服四钱，以水一中盏，煎至六分，去滓，温服。(《圣惠方》紫菀散)③治小儿咳逆上气，喉中有声，不通利： 紫菀一两，杏仁(去皮尖)、细辛、款冬花各一分。上四味，捣罗为散，二三岁儿，每服半钱匕，米饮调下，日三，更量大小加减。(《圣济总录》紫菀散)④治妊娠咳嗽不止，胎不安： 紫菀一两，桔梗半两，甘草、杏仁、桑白皮各二钱半，天门冬一两。上细切，每服三钱。竹茹一块，水煎，去滓，入蜜半匙，再煎二沸，温服。(《伤寒保命集》紫菀汤)⑤治吐血、咯血、嗽血： 真紫菀、茜根等分。为细末，炼蜜为丸，如樱桃子大，含化一丸，不以时。 (《鸡峰普济方》紫菀丸)⑥治妇人卒不得小便：紫菀末，井华水服三指撮。(《千金方》)"}]},{"ID":"20240611153852-tbo7civ","Type":"NodeParagraph","Properties":{"id":"20240611153852-tbo7civ","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611153852-tk6xcwe","Type":"NodeParagraph","Properties":{"id":"20240611153852-tk6xcwe","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 1.《本草经疏》：紫菀，观其能开喉痹，取恶涎，则辛散之功烈矣，而其性温，肺病咳逆喘嗽，皆阴虚肺热证也，不宜专用及多用，即用亦须与天门冬、百部、麦冬、桑白皮苦寒之药参用，则无害。"}]},{"ID":"20240611153852-4oqvka4","Type":"NodeParagraph","Properties":{"id":"20240611153852-4oqvka4","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"2.《本草通玄》：紫菀，辛而不燥，润而不寒，补而不滞。然非独用、多用不能速效，小便不通及溺血者服一两立效。"}]},{"ID":"20240611153852-unqvhju","Type":"NodeParagraph","Properties":{"id":"20240611153852-unqvhju","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：紫菀，辛能入肺，苦能降气，故治咳嗽上气、痰喘，惟肺实气壅，或火邪刑金而致咳唾脓血者，乃可用之。观陶氏《别录》谓其补不足，治五劳体虚，其亦言之过也。"}]},{"ID":"20240611153852-xdgab67","Type":"NodeParagraph","Properties":{"id":"20240611153852-xdgab67","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：紫菀，味甘而带苦，性凉而体润，恰合肺部血分。主治肺焦叶举，久嗽痰中带血，及肺痿，痰喘，消渴，使肺窍有清凉沛泽之功。用入肝经，凡劳热不足，肝之表病也；蓄热结气，肝之里病也；吐血衄血，肝之逆上也；便血溺血，肝之妄下也；无不奏效。 因其体润，善能滋肾，盖肾主二便，以此润大便燥结，利小便短赤，开发阴阳，宣通壅滞，大有神功。同生地、麦冬入心，宁神养血。同丹皮、赤芍入胃，清热凉血。其桑皮为肺中气药，紫菀为肺中血药，宜分别用。"}]},{"ID":"20240611153852-ncyv6tn","Type":"NodeParagraph","Properties":{"id":"20240611153852-ncyv6tn","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"5.《本经逢原》：紫菀，肺金血分之药，《本经》止咳逆上气，胸中寒热结气，取性疏利肺经血气也。去蛊毒痿者，以其辛苦微温，能散结降气，蛊毒自不能留，痿由肺热叶焦，紫菀专通肺气，使热从溲便去耳。《别录》疗嘛咳唾脓血，大明消痰止渴， 皆滋肺经血气之效。《金匮》泽漆汤用以治咳血而脉沉者，咳属肺，脉沉则血分之病也。亦治下痢肺病，与紫参同功。"}]},{"ID":"20240611153852-m4jugh4","Type":"NodeParagraph","Properties":{"id":"20240611153852-m4jugh4","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"6.《本草正义》：紫菀，柔润有余，虽曰苦宰而温，非燥烈可比，专能开泄肺郁，定咳降逆，宣通窒滞，兼疏肺家气血。凡风寒外束，肺气壅塞，咳呛不爽，喘促哮吼，及气火燔灼，郁为肺痈，咳吐脓血，痰臭腥秽诸证，无不治之。而寒饮蟠踞，浊涎胶固，喉中如水鸡声者，尤为相宜。惟其温而不热，润而不燥，所以寒热皆宜，无所避忌。景岳谓水亏金燥，咳嗽失血者，非其所宜；石顽谓阴虚肺热干咳者忌之；盖恐开泄太过，重伤肺金，又恐辛温之性，或至助火。 要之虚劳作嗽，亦必有浊痰阻塞肺窍，故频频作咳，以求其通，不为开之，咳亦不止，以此温润之品，泄化垢腻，顺调气机，而不伤于正，不偏于燥，又不犯寒凉遏抑、滋腻恋邪等弊，岂非正治且柔润之质，必不偏热，较之二冬、二母，名为滋阴，而群阴腻滞，阻塞隧道者，相去犹远。惟实火作咳，及肺痈成脓者，则紫菀虽能泄降，微嫌其近于辛温，不可重任，然借为向导，以捣穴犁庭，亦无不可。总之，肺金窒塞，无论为寒为火，皆有非此不开之势。"}]},{"ID":"20240611153852-qg97l55","Type":"NodeParagraph","Properties":{"id":"20240611153852-qg97l55","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"7.《本经》：主咳逆上气，胸中寒热结气，去蛊毒、痿，安五藏。"}]},{"ID":"20240611153852-yj2su3f","Type":"NodeParagraph","Properties":{"id":"20240611153852-yj2su3f","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"8.《别录》：疗咳唾脓血，止喘悸，五劳体虚，补不足，小儿惊痫。"}]},{"ID":"20240611153852-grof1v1","Type":"NodeParagraph","Properties":{"id":"20240611153852-grof1v1","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：补虚下气。治脑胁逆气，劳气虚热。"}]},{"ID":"20240611153852-i4dgfzg","Type":"NodeParagraph","Properties":{"id":"20240611153852-i4dgfzg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"10.《唐本草》：治气喘，阴痿。"}]},{"ID":"20240611153852-vmwuxhg","Type":"NodeParagraph","Properties":{"id":"20240611153852-vmwuxhg","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"11.《日华子本草》：调中及肺痿吐血，消痰止咳。"}]},{"ID":"20240611153852-cob9ndy","Type":"NodeParagraph","Properties":{"id":"20240611153852-cob9ndy","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"12.《本草衍义》：益肺气。"}]},{"ID":"20240611153852-yr71gvv","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611153852-yr71gvv","updated":"20240611153852"},"Children":[{"ID":"20240611153852-jhe4fd5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTMu","Num":13},"Properties":{"id":"20240611153852-jhe4fd5","updated":"20240611153852"},"Children":[{"ID":"20240611153852-wfgvo5p","Type":"NodeParagraph","Properties":{"id":"20240611153852-wfgvo5p","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"王好古：主息贲。"}]}]},{"ID":"20240611153852-6ok831f","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTQu","Num":14},"Properties":{"id":"20240611153852-6ok831f","updated":"20240611153852"},"Children":[{"ID":"20240611153852-6hcuhqx","Type":"NodeParagraph","Properties":{"id":"20240611153852-6hcuhqx","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"宁原《食鉴本草》：主肺经虚热，开喉痹，取恶涎。"}]}]}]},{"ID":"20240611153852-fv1rker","Type":"NodeParagraph","Properties":{"id":"20240611153852-fv1rker","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"14.《本草从新》：专治血痰，为血劳圣药。又能通利小肠。"}]},{"ID":"20240611153852-po7v1o0","Type":"NodeParagraph","Properties":{"id":"20240611153852-po7v1o0","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"15.《本草再新》：润肺下气、寒痰及虚喘者宜之。"}]},{"ID":"20240611153852-mnxypx7","Type":"NodeParagraph","Properties":{"id":"20240611153852-mnxypx7","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611153852-95i30v1","Type":"NodeParagraph","Properties":{"id":"20240611153852-95i30v1","updated":"20240611153852"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611153854-9bgft2s","Type":"NodeThematicBreak","Properties":{"id":"20240611153854-9bgft2s"}},{"ID":"20240611153855-c12f2er","Type":"NodeParagraph","Properties":{"id":"20240611153855-c12f2er"}}]}