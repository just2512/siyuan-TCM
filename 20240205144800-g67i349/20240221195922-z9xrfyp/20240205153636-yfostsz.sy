{"ID":"20240205153636-yfostsz","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153636-yfostsz","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153636-yfostsz\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206093750-3mbqi9k\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611153855-c12f2er\u0026quot;,\u0026quot;scrollTop\u0026quot;:3100,\u0026quot;focusId\u0026quot;:\u0026quot;20240625081922-wauvhzo\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"179紫苑（紫菀）","type":"doc","updated":"20240815084848"},"Children":[{"ID":"20240206093750-3mbqi9k","Type":"NodeParagraph","Properties":{"id":"20240206093750-3mbqi9k","updated":"20240206093758"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产东北、西北地区和安徽等地。\n【性状】\t根茎不规则块状，大小不一，顶端有茎、叶的残基，下端偶有末除尽的母根，质梢硬。根茎簇生多数细根，长315cm，直径0.10.3cm，多编成辫状；表面紫红色或灰红色，有纵皱纹；质较柔韧。气微香，味甜、微苦。\n【性味】\t辛、苦，温。\n【功效】\t润肺下气，消痰止咳。用于痰多喘咳、新久咳嗽、劳嗽咳血。\n【注解】\t“辫紫菀”：子玩的根茎下簇生多数须根，形如马尾，因药材质地柔软，编成辫状出售。"}]},{"ID":"20240206093751-23n842g","Type":"NodeParagraph","Properties":{"id":"20240206093751-23n842g","updated":"20240206093751"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206093751-v38xlmi.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205164324-w3dhvdt","Type":"NodeParagraph","Properties":{"id":"20240205164324-w3dhvdt","updated":"20240205164324"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀-20240205164324-oi1la92.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240618113328-rhkd5ow","Type":"NodeParagraph","Properties":{"id":"20240618113328-rhkd5ow","updated":"20240815084848"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 358px;","style":"width: 348px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀6-20240625082543-tytsu30.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 348px;\" parent-style=\"width: 358px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 462px;","style":"width: 452px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 1-20240815083413-m5ecrpc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 452px;\" parent-style=\"width: 462px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 9-20240815084848-bszlbkg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240815090915-qdmss83","Type":"NodeParagraph","Properties":{"id":"20240815090915-qdmss83","updated":"20240815090915"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 392px;","style":"width: 382px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 12-20240815090349-7b5za9g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 382px;\" parent-style=\"width: 392px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 13-20240815090441-q52kcie.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 392px;","style":"width: 382px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 14-20240815090545-8n5mult.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 382px;\" parent-style=\"width: 392px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240815090915-78216b8","Type":"NodeParagraph","Properties":{"id":"20240815090915-78216b8","updated":"20240815090915"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 393px;","style":"width: 383px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫菀 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫菀 15-20240815090707-dq30ajj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 383px;\" parent-style=\"width: 393px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 40