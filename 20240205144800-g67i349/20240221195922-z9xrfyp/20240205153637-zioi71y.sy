x;\" parent-style=\"width: 557px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240822143648-99d2w7r","Type":"NodeParagraph","Properties":{"id":"20240822143648-99d2w7r","updated":"20240822162206"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 494px;","style":"width: 484px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葶苈 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葶苈 13-20240822155017-j6hwuz1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 484px;\" parent-style=\"width: 494px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葶苈 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葶苈 14-20240822155127-9tjrngh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 288px;","style":"width: 278px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葶苈 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葶苈 19-20240822161747-ziehsw8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 278px;\" parent-style=\"width: 288px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822142447-weydrfo","Type":"NodeParagraph","Properties":{"id":"20240822142447-weydrfo","updated":"20240822162047"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：葶苈以抖音创作者百草恒益的观点为准，伤寒论正宗的葶苈子应该是北葶苈即独行菜种子，不是播娘蒿（据百草恒益所述，市面上百分之九十八以上的葶苈都是播娘蒿）；"}]},{"ID":"20240822161538-3qsai6p","Type":"NodeParagraph","Properties":{"id":"20240822161538-3qsai6p","updated":"20240822161646"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：独行菜开花结果之前跟荠菜较相像，区分点在于独行菜的叶子是尖尖的，像三叉戟一样，荠菜的叶子较圆；"}]},{"ID":"20240612183052-1u0b501","Type":"NodeThematicBreak","Properties":{"id":"20240612183052-1u0b501","updated":"20240822155813"}},{"ID":"20240612183132-6jdptix","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183132-6jdptix","updated":"20240612183138"},"Children":[{"Type":"NodeText","Data":"葶苈子《本草经解》"}]},{"ID":"20240612183132-fyvgl3s","Type":"NodeParagraph","Properties":{"id":"20240612183132-fyvgl3s","updated":"20240612183132"},"Children":[{"Type":"NodeText","Data":"气寒．味辛．无毒．主症瘕积聚结气．饮食寒热．破坚逐邪．通利水道．（炒用）"}]},{"ID":"20240612183132-q8eett3","Type":"NodeParagraph","Properties":{"id":"20240612183132-q8eett3","updated":"20240612183132"},"Children":[{"Type":"NodeText","Data":"葶苈子气寒．禀天冬寒之水气．入足太阳寒水膀胱经、手太阳寒水小肠经．味辛无毒．得地西方之金味．入手太阴肺经．气味降多于升．阴也．其主症瘕积聚结气者．气结聚而成积．有形可征者谓之症．假物成形者谓之瘕．葶苈入肺．肺主气．而味辛可以散结也．小肠为受盛之官．饮食入肠．寒热之物．皆从此运转．如调摄失宜．则寒热之物积矣．葶苈气寒可以去热．味辛可以散寒．下泄可以去积也．破坚者辛散之功．逐邪者下泄之力．十剂云．泄可去闭．葶苈是也．肺者通调水道．下输膀胱．葶苈入肺入膀胱．辛寒下泄．所以通利也．"}]},{"ID":"20240612183132-pgnxk2z","Type":"NodeParagraph","Properties":{"id":"20240612183132-pgnxk2z","updated":"20240612183132"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612183132-lbwo78p","Type":"NodeParagraph","Properties":{"id":"20240612183132-lbwo78p","updated":"20240612183132"},"Children":[{"Type":"NodeText","Data":"葶苈炒成末蜜丸．大枣同煎．治肺痈喘急．及支饮不得息．同枣肉丸．治通身浮肿．专酒浸．治腹胀积聚．"}]},{"ID":"20240612183052-0i626ud","Type":"NodeThematicBreak","Properties":{"id":"20240612183052-0i626ud"}},{"ID":"20240612183122-822c3u7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183122-822c3u7","updated":"20240612183127"},"Children":[{"Type":"NodeText","Data":"葶苈《汤液本草》"}]},{"ID":"20240612183122-kv0n1qz","Type":"NodeParagraph","Properties":{"id":"20240612183122-kv0n1qz","updated":"20240612183122"},"Children":[{"Type":"NodeText","Data":"气大寒，味苦、辛。无毒。"}]},{"ID":"20240612183122-73d02vl","Type":"NodeParagraph","Properties":{"id":"20240612183122-73d02vl","updated":"20240612183122"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主症瘕积聚结气，饮食寒热；破坚逐邪，通利水道，下膀胱水，伏留热气，及皮间邪水上出，面目浮肿，身暴中风，热痱痒，利小便。久服，令人虚。又云∶疗肺壅上气咳嗽，定喘促，除胸中痰饮。"}]},{"ID":"20240612183122-s0ja8sr","Type":"NodeParagraph","Properties":{"id":"20240612183122-s0ja8sr","updated":"20240612183122"},"Children":[{"Type":"NodeText","Data":"《液》云∶苦、甜二味，主治同。仲景用苦，余方或有用甜者，或有不言甜、苦者。大抵苦则下泄，甜则少缓。量病虚实用之，不可不审。《本草》虽云治同，甜、苦之味安得不异？榆白皮为之使。恶僵蚕、石龙芮。仲景葶苈大枣泻肺汤用之。"}]},{"ID":"20240612183313-4ahwers","Type":"NodeThematicBreak","Properties":{"id":"20240612183313-4ahwers"}},{"ID":"20240612183314-c82vkog","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183314-c82vkog","updated":"20240612183319"},"Children":[{"Type":"NodeText","Data":"葶苈子《本草从新》"}]},{"ID":"20240612183314-ur7cgro","Type":"NodeParagraph","Properties":{"id":"20240612183314-ur7cgro","updated":"20240612183314"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大泻气闭、通、行水．"}]},{"ID":"20240612183314-mc5kyd6","Type":"NodeParagraph","Properties":{"id":"20240612183314-mc5kyd6","updated":"20240612183314"},"Children":[{"Type":"NodeText","Data":"辛苦大寒．性急．大能下气．行膀胱水．肺中水气 急者．非此不能除．破积聚症结．"}]},{"ID":"20240612183314-safcemb","Type":"NodeParagraph","Properties":{"id":"20240612183314-safcemb","updated":"20240612183314"},"Children":[{"Type":"NodeText","Data":"伏留热气．消肿除痰．止嗽定喘．（皆水湿泛溢．）通经利便．（十剂曰∶泄可去闭、葶苈大黄之属是也、大黄泄阴分血闭、葶苈泄阳分气闭．）性峻．不可混服．有甜苦二种．甜者力稍缓葶苈大枣泻肺汤、治肺气喘急不得卧、 庵曰∶辅以大枣、补土所以制水．）子如黍米微长．色黄．糯米微炒．去米．或酒拌炒．榆皮为使．（头风疼痛、葶苈子为末、以汤淋汁、沐头三四度、即愈．）"}]},{"ID":"20240612183052-tgarjnc","Type":"NodeThematicBreak","Properties":{"id":"20240612183052-tgarjnc"}},{"ID":"20240612183104-6fdql69","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183104-6fdql69","updated":"20240612183109"},"Children":[{"Type":"NodeText","Data":"葶苈《药征》"}]},{"ID":"20240612183104-1g2lsje","Type":"NodeParagraph","Properties":{"id":"20240612183104-1g2lsje","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"主治水病也，旁治肺痈结胸。"}]},{"ID":"20240612183104-s5jwjbz","Type":"NodeParagraph","Properties":{"id":"20240612183104-s5jwjbz","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240612183104-x9juy86","Type":"NodeParagraph","Properties":{"id":"20240612183104-x9juy86","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"葶苈大枣汤证曰∶肺痈、胸满胀、一身面目浮肿。"}]},{"ID":"20240612183104-2idwhuj","Type":"NodeParagraph","Properties":{"id":"20240612183104-2idwhuj","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"以上一方，葶苈捣丸如弹丸大。"}]},{"ID":"20240612183104-luitqlr","Type":"NodeParagraph","Properties":{"id":"20240612183104-luitqlr","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"大陷胸丸证曰∶结胸。"}]},{"ID":"20240612183104-pbw8g13","Type":"NodeParagraph","Properties":{"id":"20240612183104-pbw8g13","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"以上一方，葶苈半升。"}]},{"ID":"20240612183104-gq6dym6","Type":"NodeParagraph","Properties":{"id":"20240612183104-gq6dym6","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"己椒苈黄丸证曰∶肠间有水气。"}]},{"ID":"20240612183104-d636rd0","Type":"NodeParagraph","Properties":{"id":"20240612183104-d636rd0","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"以上一方，葶苈一两。"}]},{"ID":"20240612183104-zc6s4h1","Type":"NodeParagraph","Properties":{"id":"20240612183104-zc6s4h1","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"大陷胸丸，则水利而疾愈，然则葶苈之治水也明矣。"}]},{"ID":"20240612183104-m9f2xcg","Type":"NodeParagraph","Properties":{"id":"20240612183104-m9f2xcg","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240612183104-6n4fiqp","Type":"NodeParagraph","Properties":{"id":"20240612183104-6n4fiqp","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"或问曰∶葶苈大枣汤、桔梗汤、桔梗白散，同治肺痈，而异其方，何也？为则答曰∶用桔梗之证，浊唾腥臭，久久吐脓者也。用葶苈之证，浮肿清涕，咳逆喘鸣者也。故因其见证而处方，不为病名所绊，斯为得也。"}]},{"ID":"20240612183104-4nprn67","Type":"NodeParagraph","Properties":{"id":"20240612183104-4nprn67","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"《淮南子》曰∶葶苈愈胀。为则按∶胀是水病也。"}]},{"ID":"20240612183104-5g2iutr","Type":"NodeParagraph","Properties":{"id":"20240612183104-5g2iutr","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240612183104-v3ygtxx","Type":"NodeParagraph","Properties":{"id":"20240612183104-v3ygtxx","updated":"20240612183104"},"Children":[{"Type":"NodeText","Data":"葶苈 有甜苦二种。而甜者不中用焉，本邦未出苦葶苈也。或曰∶关以东间有之。"}]},{"ID":"20240612183052-40sv4va","Type":"NodeThematicBreak","Properties":{"id":"20240612183052-40sv4va"}},{"ID":"20240612183053-724esyc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183053-724esyc","updated":"20240612183057"},"Children":[{"Type":"NodeText","Data":"葶苈《神农本草经读》"}]},{"ID":"20240612183053-j1hp2w1","Type":"NodeParagraph","Properties":{"id":"20240612183053-j1hp2w1","updated":"20240612183053"},"Children":[{"Type":"NodeText","Data":"味辛寒。主症瘕、积聚、结气，（水饮所结之疾。）饮食寒热，破坚逐邪，（亦皆水气之疾。）通利水道。（肺气降则水道自通。）徐灵胎曰∶葶苈滑润而香，专泻肺气，肺为水源，故能泻肺，即能泻水，凡积聚寒热从水气来者，此药主之。"}]},{"ID":"20240612183053-0gyoc4o","Type":"NodeParagraph","Properties":{"id":"20240612183053-0gyoc4o","updated":"20240612183053"},"Children":[{"Type":"NodeText","Data":"大黄之泻，从中焦始；葶苈之泻，从上焦始。故《伤寒论》中承气汤用大黄，而陷胸汤用葶苈也。"}]},{"ID":"20240612183040-83bh06f","Type":"NodeThematicBreak","Properties":{"id":"20240612183040-83bh06f"}},{"ID":"20240612183041-6301kah","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183041-6301kah","updated":"20240612183046"},"Children":[{"Type":"NodeText","Data":"葶苈《神农本草经百种录》"}]},{"ID":"20240612183041-zionks9","Type":"NodeParagraph","Properties":{"id":"20240612183041-zionks9","updated":"20240612183041"},"Children":[{"Type":"NodeText","Data":"味辛寒。主症瘕，积聚结气，水饮所结之疾。饮食寒热，破坚逐邪，亦皆水气之疾。"}]},{"ID":"20240612183041-hacfkas","Type":"NodeParagraph","Properties":{"id":"20240612183041-hacfkas","updated":"20240612183041"},"Children":[{"Type":"NodeText","Data":"通利水道。肺气降则水道自通。"}]},{"ID":"20240612183041-idj3mag","Type":"NodeParagraph","Properties":{"id":"20240612183041-idj3mag","updated":"20240612183041"},"Children":[{"Type":"NodeText","Data":"葶苈滑润而香，专泻肺气，肺为水源，故能泻肺，即能泻水。凡积聚寒热从水气来者，此药主之。大黄之泻从中焦始，葶苈之泻从上焦始。故《伤寒论》中承气汤用大黄，而陷胸汤用葶苈也。"}]},{"ID":"20240612183005-lbh7bvr","Type":"NodeThematicBreak","Properties":{"id":"20240612183005-lbh7bvr"}},{"ID":"20240612183027-tfqe5ll","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183027-tfqe5ll","updated":"20240612183032"},"Children":[{"Type":"NodeText","Data":"葶苈《医学入门》"}]},{"ID":"20240612183027-i5xbtex","Type":"NodeParagraph","Properties":{"id":"20240612183027-i5xbtex","updated":"20240612183027"},"Children":[{"Type":"NodeText","Data":"葶苈大寒辛苦味，善消水肿泻肺气，更医肾瘅破脾积，解毒祛风治疙痱。"}]},{"ID":"20240612183027-18q7ur7","Type":"NodeParagraph","Properties":{"id":"20240612183027-18q7ur7","updated":"20240612183027"},"Children":[{"Type":"NodeText","Data":"葶，定也；苈，沥也，行也。能定肺喘而行水。无毒。沉也，阴中阴也。东垣云∶除遍身之浮肿，逐膀胱之留热，定肺痈上气喘促，疗胸中积壅痰嗽。兼治肾瘅唇干，破 瘕积聚结气，饮食寒热，解一切毒入腹不可疗及马汗。用一两炒研浸水，利下恶血，又煎汤洗头风，捣末敷白秃，身暴中风热痱痒者亦可洗且涂之。"}]},{"ID":"20240612183027-84r57ua","Type":"NodeParagraph","Properties":{"id":"20240612183027-84r57ua","updated":"20240612183027"},"Children":[{"Type":"NodeText","Data":"丹溪云∶属火，性急走泄为功，苦者尤甚，甜者少缓。病患稍涉虚者远之，杀人甚捷。不必久服乃虚，隔纸炒香，或蒸熟。榆皮为使。恶干姜、石龙芮。含膏丸∶葶苈、知母、贝母各一两，枣肉五钱，砂糖一两半，丸如弹子。每以新绵裹一丸含咽，治嗽喘，三丸即效。"}]},{"ID":"20240612183006-0q52v8u","Type":"NodeThematicBreak","Properties":{"id":"20240612183006-0q52v8u"}},{"ID":"20240612183018-xesk274","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183018-xesk274","updated":"20240612183022"},"Children":[{"Type":"NodeText","Data":"葶苈《本草纲目》"}]},{"ID":"20240612183018-ybh0d63","Type":"NodeParagraph","Properties":{"id":"20240612183018-ybh0d63","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"「释名」丁苈、大室、大适、狗荠。"}]},{"ID":"20240612183018-g95clcr","Type":"NodeParagraph","Properties":{"id":"20240612183018-g95clcr","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"「气味」（苗、子）苦、平、无毒。"}]},{"ID":"20240612183018-mza04u0","Type":"NodeParagraph","Properties":{"id":"20240612183018-mza04u0","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612183018-vlhg6tc","Type":"NodeParagraph","Properties":{"id":"20240612183018-vlhg6tc","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"1、阳性水肿（面赤、烦渴、喘急、小便涩）。用甜葶苈一两半（炒后研末）、汉防己末二两，和鸭血及头同捣极烂，做成丸子，如梧子大。视病情每服五至十丸，一天服三次，以小便通畅为验。"}]},{"ID":"20240612183018-mp5jo7x","Type":"NodeParagraph","Properties":{"id":"20240612183018-mp5jo7x","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"2、遍身肿满，用苦葶苈（炒）四两，研细，和枣肉做成丸子，如梧子大。每服十五丸，桑白皮汤送下。一天服三次。"}]},{"ID":"20240612183018-afutk8g","Type":"NodeParagraph","Properties":{"id":"20240612183018-afutk8g","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"3、在腹水肿。用革葶苈二升，炒后研末，与雄鸡血及头一起捣至极烂，做成丸子，如梧子大。每服十丸，小豆汤送下。一天服三次。又方：葶苈二升，用酒五升泡一夜，服一合即通一天服三次。又方：葶苈一两杏仁十枚，同熬成黄色。取出捣烂，分十次服。"}]},{"ID":"20240612183018-h98c7g1","Type":"NodeParagraph","Properties":{"id":"20240612183018-h98c7g1","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"4、肺湿痰喘。用甜葶苈炒为末，加枣肉和成丸子服下。"}]},{"ID":"20240612183018-0ldsehb","Type":"NodeParagraph","Properties":{"id":"20240612183018-0ldsehb","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"5、咳嗽上气（不能睡卧，或遍体气肿，或单面肿、足肿）。用葶苈子三长，经微火熬研后，装入布袋，泡在清酒五升中。几日后饮酒，每次一小杯。一天饮四次。如病急，等不到酒泡透，可以榨汁服。"}]},{"ID":"20240612183018-0dc3xf3","Type":"NodeParagraph","Properties":{"id":"20240612183018-0dc3xf3","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"6、肺壅喘急。用葶苈炒黄，研为末，加蜜和成丸子，如弹子大。服药时先用大枣二十枚，加水三升，煎取二升，然后放入葶苈一丸，继续煎水至一升，一次服下，此方名“葶苈大枣泻肺汤”。"}]},{"ID":"20240612183018-6d3gpzm","Type":"NodeParagraph","Properties":{"id":"20240612183018-6d3gpzm","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"7、月经不通。用葶苈一升，研为末，加蜜做成丸子，如弹子大，棉裹，纳入阴道中。过一夜，换药一次，汗出即出可停药。"}]},{"ID":"20240612183018-m5ikkcw","Type":"NodeParagraph","Properties":{"id":"20240612183018-m5ikkcw","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"8、突发颠狂。用葶苈一程式，捣极细，加白犬血和成丸子，如麻子大。每服二丸，酒送下，三服即愈。"}]},{"ID":"20240612183018-t5m07as","Type":"NodeParagraph","Properties":{"id":"20240612183018-t5m07as","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"9、虫牙用葶苈、雄黄，等分为末调腊月猪油点痛处。"}]},{"ID":"20240612183018-8qisgg4","Type":"NodeParagraph","Properties":{"id":"20240612183018-8qisgg4","updated":"20240612183018"},"Children":[{"Type":"NodeText","Data":"10、瘰疬已溃。用葶苈二合、豉一升，捣烂作成饼子，如钱大，厚二分。安在疮孔上，外用艾灸使受温热，但不可伤肉，亦不可灸初起之疮。"}]},{"ID":"20240612183006-wip9vnx","Type":"NodeThematicBreak","Properties":{"id":"20240612183006-wip9vnx"}},{"ID":"20240612183007-crqn7mq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183007-crqn7mq","updated":"20240612183011"},"Children":[{"Type":"NodeText","Data":"葶苈《新修本草》"}]},{"ID":"20240612183007-8sjx579","Type":"NodeParagraph","Properties":{"id":"20240612183007-8sjx579","updated":"20240612183007"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、大寒，无毒。主症瘕积聚结气，饮食寒热，破坚逐邪，通利水道，下膀胱水，腹留热气，皮间邪水上出，面目浮肿，身暴中风热痱痒，利小腹。久服令人虚。一名大室，一名大适，一名丁历，一名 蒿。生 城平泽及田野。立夏后采实，阴干。"}]},{"ID":"20240612183007-qxw7p5j","Type":"NodeParagraph","Properties":{"id":"20240612183007-qxw7p5j","updated":"20240612183007"},"Children":[{"Type":"NodeText","Data":"得酒良，榆皮为之使，恶僵蚕、石龙芮。出彭城者最胜，今近道亦有。母即公荠，子细黄至苦，用之当熬也。"}]},{"ID":"20240612182917-nispghz","Type":"NodeThematicBreak","Properties":{"id":"20240612182917-nispghz"}},{"ID":"20240612182956-cbejzl0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182956-cbejzl0","updated":"20240612183000"},"Children":[{"Type":"NodeText","Data":"葶苈《本草备要》"}]},{"ID":"20240612182956-m666h45","Type":"NodeParagraph","Properties":{"id":"20240612182956-m666h45","updated":"20240612182956"},"Children":[{"Type":"NodeText","Data":"大泻气秘，通，行水"}]},{"ID":"20240612182956-476u042","Type":"NodeParagraph","Properties":{"id":"20240612182956-476u042","updated":"20240612182956"},"Children":[{"Type":"NodeText","Data":"辛苦大寒。属火性急，大能下气，行膀胱水。肿中水气 急者，非此不能除。破积聚症结，伏留热气，消肿除痰，止嗽定喘（水湿泛溢，为肿胀，为痰嗽，为喘满）通经利便。久服令人虚（《十剂》曰∶泄可去闭，葶苈、大黄之属是也。大黄泄阴分血闭，葶苈泄阳分气闭，气味俱浓，不减大黄。然有甜、苦二种，甜者性缓，苦者性急，泄肺而伤胃，宜大枣辅之。仲景有葶苈大枣泻肺汤，治肺气喘急不得卧。昂按∶辅以大枣，补土所以制水）。"}]},{"ID":"20240612182956-meoaxrs","Type":"NodeParagraph","Properties":{"id":"20240612182956-meoaxrs","updated":"20240612182956"},"Children":[{"Type":"NodeText","Data":"子如黍米，微长色黄。合糯米微炒，去米用。得酒良。榆皮为使。"}]},{"ID":"20240612182917-hjmq1rh","Type":"NodeThematicBreak","Properties":{"id":"20240612182917-hjmq1rh"}},{"ID":"20240612182942-v4gm3bo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182942-v4gm3bo","updated":"20240612182947"},"Children":[{"Type":"NodeText","Data":"葶苈《证类本草》"}]},{"ID":"20240612182942-8o51a7w","Type":"NodeParagraph","Properties":{"id":"20240612182942-8o51a7w","updated":"20240612182942"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、大寒，无毒。主症瘕积聚积气，饮食寒热，破坚逐邪，通利水道，下膀胱水，伏留热气，皮间邪水上出，面目浮肿，身暴中风热痱（音沸）痒，利小腹。久服令人虚。一名丁历，一名 （音典）蒿，一名大室，一名大适。生 城平泽及田野。立夏后采实，阴干。得酒良。（榆皮为之使，恶僵蚕、石龙芮。）"}]},{"ID":"20240612182942-wlwo11x","Type":"NodeParagraph","Properties":{"id":"20240612182942-wlwo11x","updated":"20240612182942"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶出彭城者最胜，今近道亦有。母则公荠，子细黄至苦，用之当熬。今按此药亦疗肺壅上气咳嗽，定喘促，除胸中痰饮。臣禹锡等谨按蜀本云∶苗似荠 ，春末生，高二、三尺，花黄，角生子黄细。五月熟，采子曝干。药性论云∶葶苈，臣，味酸，有小毒。能利小便，抽肺气上喘息急。止嗽。尔雅云∶ ，亭历。注∶实、叶皆似芥，一名狗荠。日华子云∶利小肠，通水气虚肿。"}]},{"ID":"20240612182942-jcbsm4y","Type":"NodeParagraph","Properties":{"id":"20240612182942-jcbsm4y","updated":"20240612182942"},"Children":[{"Type":"NodeText","Data":"图经曰∶葶苈，生 城平泽及田野，今京东、陕西、河北州郡皆有之，曹州者尤胜。初春生苗叶，高六、七寸，有似荠。根白，枝茎俱青。三月开花，微黄。结角，子扁小如黍粒微长，黄色。立夏后采实，曝干。《月令》∶孟夏之月，靡草死。许慎，郑康成注∶皆云靡草，荠、葶苈之属是也。至夏则枯死，故此时采之。张仲景治肺痈，喘不得卧，葶苈大枣泻肺汤主之。葶苈炒黄色，捣末为丸，大如弹丸。每服用大枣二十枚，水三升，煎之取二升，然后纳一弹丸更煎，取一升，顿服之。支饮不得息亦主之。崔知悌方∶疗上气咳嗽，长引气不得卧，或遍体气肿，或单面肿，或足肿，并主之。葶苈子三升，微火熬，捣筛为散，以清酒五升渍之。冬七日，夏三日。初服如桃许大，日三夜一，冬日二夜二。量其气力，取微利一、二为度。如患急困者，不得待日满，亦可以绵细绞。即服其葶苈单茎向上，叶端出角，角粗且短。又有一种苟芥草，叶近根下作奇，生角细长。取时必须分别前件二种也。又《箧中方》治嗽含膏丸∶曹州葶苈子一两，纸衬熬令黑，知母一两，贝母一两，三物同捣筛，以枣肉半两，别销沙糖一两半，同入药中和为丸，大如弹丸。每服以新绵裹一丸，含之徐徐咽津，甚者不过三丸。今医亦多用。"}]},{"ID":"20240612182942-849rk5b","Type":"NodeParagraph","Properties":{"id":"20240612182942-849rk5b","updated":"20240612182942"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用赤须子，真相似葶苈子，只是味微甘苦。葶苈子入顶苦。凡使，以糯米相合，于焙上，微微焙，待米熟，去米，单捣用。圣惠方∶治上气喘急，遍身浮肿。用甜葶苈一升，隔纸炒令紫色，捣令极细，用生绢袋盛，以清酒五升浸三日后，每服抄一匙，用粥饮调下，日三、四服。又方∶治支饮久不瘥，大腹水肿，喘促不止。用甜葶苈三两，隔纸炒令紫色，捣如膏。每服丸如弹子大，以水一中盏，入枣四枚，煎至五分去滓，非时服。外台秘要∶治食饮不得息。葶苈子三两，熬令黄，捣为末。以水三升煮，大枣三十枚，得汁一升纳药中。每服如枣大，煎取七合顿服。千金方∶治腹胀积聚症瘕。葶苈子一升熬，以酒五升浸七日。日服三合。千金翼∶治头风。捣葶苈子，以汤淋取汁洗头上。经验方∶河东裴氏传经效，治水肿及暴肿。葶苈三两，杵六千下，令如泥。即下汉防己末四两，取绿头鸭就药臼中截头沥血于臼中，血尽，和鸭头更捣五千下，丸如梧桐子。患甚者，空腹白汤下十丸，稍可者五丸，频服，五日止。此药利小便，有效如神。梅师方∶治遍身肿满，小便涩。葶苈子二两，大枣二十枚，以水一大升，煎取一小升，去枣，纳葶苈于枣汁煎丸如梧子，饮下十丸。又方∶治肺壅气喘急不得卧。葶苈子三两炒，大枣三十枚，水三升煮枣，取二升，又煎取一升去滓，并，二服。简要济众治小儿水气腹肿，兼下痢脓血，小便涩。葶苈子半两，微炒捣如泥，以枣肉和捣为丸如绿豆大。每服五丸，枣汤下，空心、晚后量儿大小，加减服之。续十全方治一切毒，入腹不可疗及马汗。用葶苈子一两炒研，以水一升浸汤服，取下恶血。崔氏治水气。葶苈三两，以物盛，甑上蒸令熟，即捣万杵，若丸得如梧桐子，不须蜜和。一服五丸，渐加至七丸，以得微利即佳。不可多服，令人不堪美食。若气发，又服之。得利，气下定即停。此方治水气无比。萧驸马患水肿，唯服此得瘥。伤寒类要治肾瘅唇干，以葶苈主之。子母秘录∶治小儿白秃。葶苈捣末，以汤洗汽涂上。姚和众治孩儿蛔虫。葶苈子一分，生为末用，以水三合，煎取一合，一日服尽。"}]},{"ID":"20240612182942-nmj95ea","Type":"NodeParagraph","Properties":{"id":"20240612182942-nmj95ea","updated":"20240612182942"},"Children":[{"Type":"NodeText","Data":"衍义曰∶葶苈，用子。子之味有甜、苦两等，其形则一也。《经》既言味辛、苦，即甜者于复更入药也。大概治体皆以行水走泄为用，故曰久服令人虚。盖取苦泄之义，其理甚明。《药性论》所说尽矣，但不当言味酸。"}]},{"ID":"20240612183234-xlpuwhj","Type":"NodeThematicBreak","Properties":{"id":"20240612183234-xlpuwhj"}},{"ID":"20240612183235-73m2heq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183235-73m2heq","updated":"20240612183243"},"Children":[{"Type":"NodeText","Data":"葶苈子《本草便读》"}]},{"ID":"20240612183235-5t216ie","Type":"NodeParagraph","Properties":{"id":"20240612183235-5t216ie","updated":"20240612183235"},"Children":[{"Type":"NodeText","Data":"功专苦降．气属辛寒．泻肺气以行痰．水满上焦喘可愈．利二肠而治咳．热从下导胀能消．（葶苈子苦辛寒．入肺家气分．大泻肺脏水邪．凡仁皆降．故能降气行痰．肺脏热结者宜之．若寒饮阴水等证．及虚弱者．不可用也．有甜苦二种．苦者性急下泄．甜者性缓．乃大泻肺气之药．气降则诸邪皆散耳．）"}]},{"ID":"20240612183251-eggy82n","Type":"NodeThematicBreak","Properties":{"id":"20240612183251-eggy82n"}},{"ID":"20240612183252-clhhmhv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183252-clhhmhv","updated":"20240612183257"},"Children":[{"Type":"NodeText","Data":"葶苈《本草经集注》"}]},{"ID":"20240612183252-wx2eghu","Type":"NodeParagraph","Properties":{"id":"20240612183252-wx2eghu","updated":"20240612183252"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、大寒，无毒。主治症瘕积聚，结气，饮食寒热，破坚逐邪，通利水道。"}]},{"ID":"20240612183252-q8t2hf1","Type":"NodeParagraph","Properties":{"id":"20240612183252-q8t2hf1","updated":"20240612183252"},"Children":[{"Type":"NodeText","Data":"下膀胱水，腹留热气，皮间邪水上出，面目浮肿，身暴中风热痱痒，利小腹。久服令人虚。"}]},{"ID":"20240612183252-3siowhb","Type":"NodeParagraph","Properties":{"id":"20240612183252-3siowhb","updated":"20240612183252"},"Children":[{"Type":"NodeText","Data":"一名大室，一名大适。一名丁历，一名 蒿。生 城平泽及田野。立夏后采实，阴干。（得酒良，榆皮为之使，恶僵蚕、石龙芮。）"}]},{"ID":"20240612183252-4rrwdpx","Type":"NodeParagraph","Properties":{"id":"20240612183252-4rrwdpx","updated":"20240612183252"},"Children":[{"Type":"NodeText","Data":"出彭城者最胜，今近道亦有，母即公荠，子细黄至苦，用之当熬也。"}]},{"ID":"20240612183217-6yx58m3","Type":"NodeThematicBreak","Properties":{"id":"20240612183217-6yx58m3"}},{"ID":"20240612183218-ewtql86","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183218-ewtql86","updated":"20240612183222"},"Children":[{"Type":"NodeText","Data":"葶苈子《本草择要纲目》"}]},{"ID":"20240612183218-gs1cwq9","Type":"NodeParagraph","Properties":{"id":"20240612183218-gs1cwq9","updated":"20240612183218"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612183218-oa2sdz6","Type":"NodeParagraph","Properties":{"id":"20240612183218-oa2sdz6","updated":"20240612183218"},"Children":[{"Type":"NodeText","Data":"辛寒无毒．阴中阳也．"}]},{"ID":"20240612183218-z7bi60v","Type":"NodeParagraph","Properties":{"id":"20240612183218-z7bi60v","updated":"20240612183218"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240612183218-jjo8ofn","Type":"NodeParagraph","Properties":{"id":"20240612183218-jjo8ofn","updated":"20240612183218"},"Children":[{"Type":"NodeText","Data":"通利水道．疗肺壅上气．止喘促．除胸中痰饮．但葶苈属火．性急善下．与大黄同功．病患稍涉虚者宜远之．"}]},{"ID":"20240612183205-o5ad2op","Type":"NodeThematicBreak","Properties":{"id":"20240612183205-o5ad2op"}},{"ID":"20240612183206-39xwv34","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183206-39xwv34","updated":"20240612183211"},"Children":[{"Type":"NodeText","Data":"葶苈子《本草崇原》"}]},{"ID":"20240612183206-0pqrxuh","Type":"NodeParagraph","Properties":{"id":"20240612183206-0pqrxuh","updated":"20240612183206"},"Children":[{"Type":"NodeText","Data":"气味辛寒，无毒。主治症瘕积聚，结气，饮食寒热，破坚逐邪，通利水道。"}]},{"ID":"20240612183206-3axbf2j","Type":"NodeParagraph","Properties":{"id":"20240612183206-3axbf2j","updated":"20240612183206"},"Children":[{"Type":"NodeText","Data":"（葶苈子始出 城平泽田野间，汴东、陕西、河北州郡亦有之，近以彭城、曹州者为胜。"}]},{"ID":"20240612183206-3g2b533","Type":"NodeParagraph","Properties":{"id":"20240612183206-3g2b533","updated":"20240612183206"},"Children":[{"Type":"NodeText","Data":"春初生苗，叶高六七寸，似荠，故《别录》名狗荠。根白色，枝茎俱青，三月开花微黄，结角于扁小，如黍粒微长，黄色，《月令》∶孟夏之月靡草死。许慎、郑元注皆云∶靡草、狗荠、葶苈之属是也。）"}]},{"ID":"20240612183206-r3oszyq","Type":"NodeParagraph","Properties":{"id":"20240612183206-r3oszyq","updated":"20240612183206"},"Children":[{"Type":"NodeText","Data":"葶苈花实黄色，根白味辛，盖禀土金之气化。禀金气，故主治症瘕积聚之结气。禀土气，故主治饮食不调之寒热。破坚逐邪，金气盛也。通利水道，土气盛也。"}]},{"ID":"20240612183206-59te7zv","Type":"NodeParagraph","Properties":{"id":"20240612183206-59te7zv","updated":"20240612183206"},"Children":[{"Type":"NodeText","Data":"（李杲曰∶《本草十剂》云∶泄可去闭，葶苈、大黄之属二味，皆大苦寒，一泄血闭，一味俱浓，不减大黄，又性过于诸药，以泄阳分肺中之闭，亦能泄大便，为体轻象阳故也。《别录》云∶久服令人虚。朱丹溪谓∶葶苈属火性急，善遂水，病患稍涉，虚者宜远之，且杀人，甚健何必久服而后虚也。"}]},{"ID":"20240612183206-03r85oi","Type":"NodeParagraph","Properties":{"id":"20240612183206-03r85oi","updated":"20240612183206"},"Children":[{"Type":"NodeText","Data":"李时珍曰∶葶苈子有甜苦二种，正如牵牛黑白二色，急缓不同。又如葫芦甘苦二味，良毒亦异，大抵甜者下泄之性缓，虽泄肺而不伤胃，苦者下泄之性急，既泄肺而兼伤胃，故古方多以大枣辅之。若肺中水气 满急者，非去则止，不可过剂，既不久服，何至杀人。淮南子云∶大戟去水，葶苈愈胀，用之不节，及反成病，亦在用之有节与不耳。）"}]},{"ID":"20240612182917-z5wd6a8","Type":"NodeThematicBreak","Properties":{"id":"20240612182917-z5wd6a8"}},{"ID":"20240612182922-t1b917c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182922-t1b917c","updated":"20240612182934"},"Children":[{"Type":"NodeText","Data":"葶苈《本草图经》"}]},{"ID":"20240612182922-0gb993t","Type":"NodeParagraph","Properties":{"id":"20240612182922-0gb993t","updated":"20240612182930"},"Children":[{"Type":"NodeText","Data":"葶苈，生 城平泽及田野，今京东、陕西、河北州郡皆有之，曹州者尤胜。初春生苗叶，高六、七寸，有似荠；根白，枝茎俱青；三月开花，微黄；结角，子扁小如黍粒微长，黄色；立夏后采实，曝干。《月令》∶孟夏之月，靡草死；许慎、郑康成注皆云∶靡草，荠、葶苈之属是也。此草至夏则枯死，故此时采之。张仲景治肺痈喘不得卧，葶苈大枣泻肺汤主之。"}]},{"ID":"20240612182922-sy1bvj8","Type":"NodeParagraph","Properties":{"id":"20240612182922-sy1bvj8","updated":"20240612182922"},"Children":[{"Type":"NodeText","Data":"葶苈炒黄色捣末为丸，大如弹丸。每服用大枣二十枚，水三升，煎之取二升，然后内一弹丸，更煎取一升，顿服之。支饮不得息亦主之。崔知悌方，疗上气咳嗽，长引气不得卧，或遍体气肿，或单面肿，或足肿，并主之。葶苈子三升，微火熬，捣筛为散，以清酒五升渍之，冬七日，夏三日。初服如桃许大，日三夜一，冬日二夜二。量其气力，取微利一、二为度。如患急困者，不得待日满，亦可以绵细绞即服。其葶苈单茎向上，叶端出角，角粗且短，又有一种苟芥草，叶近根下作奇，生角细长。取时必须分别前件二种也。又《箧中方》，治嗽含膏丸，曹州葶苈子一两，纸衬熬令黑，知母一两，贝母一两，三物同捣筛，以枣肉半两，别销沙糖一两半，同入药中，和为丸，大如弹丸，每服以新绵裹一丸，含之，徐徐咽津，甚者不过三丸。今医亦多用。"}]},{"ID":"20240612171817-5mrludo","Type":"NodeThematicBreak","Properties":{"id":"20240612171817-5mrludo"}},{"ID":"20240612182901-klnmoye","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182901-klnmoye","updated":"20240612182912"},"Children":[{"Type":"NodeText","Data":"葶苈《要药分剂》"}]},{"ID":"20240612182901-gepduup","Type":"NodeParagraph","Properties":{"id":"20240612182901-gepduup","updated":"20240612182901"},"Children":[{"Type":"NodeText","Data":"味辛苦。性大寒。无毒。禀阴金之气以生。降也。阳中阴也。榆皮为使。得酒良。宜大枣。恶僵蚕。"}]},{"ID":"20240612182901-nggjcpl","Type":"NodeParagraph","Properties":{"id":"20240612182901-nggjcpl","updated":"20240612182901"},"Children":[{"Type":"NodeText","Data":"【主治】主症瘕积聚。结气饮食寒热。破坚逐邪。通利水道。（本经）下膀胱水。伏留热气。"}]},{"ID":"20240612182901-kelthxj","Type":"NodeParagraph","Properties":{"id":"20240612182901-kelthxj","updated":"20240612182901"},"Children":[{"Type":"NodeText","Data":"咳嗽。"}]},{"ID":"20240612182901-0oe289d","Type":"NodeParagraph","Properties":{"id":"20240612182901-0oe289d","updated":"20240612182901"},"Children":[{"Type":"NodeText","Data":"【归经】入肺大肠膀胱三经。为下气行水之品。（兼通剂肺家正药善逐水病）【前论】东垣曰。大降气。只可与辛酸同用以导肿气。宗曰。有甜苦二种。其形则一。"}]},{"ID":"20240612182901-jn4s06w","Type":"NodeParagraph","Properties":{"id":"20240612182901-jn4s06w","updated":"20240612182901"},"Children":[{"Type":"NodeText","Data":"皆以【禁忌】经疏曰。肿满由脾虚不能制水。小便不通。由膀胱虚无气以化者。均忌。盖不利于【炮制】雷公曰。凡使。同糯米微焙。待米熟。去米。捣用。"}]},{"ID":"20240612171817-4blzrhj","Type":"NodeThematicBreak","Properties":{"id":"20240612171817-4blzrhj"}},{"ID":"20240612182731-yl2imom","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182731-yl2imom","updated":"20240612182736"},"Children":[{"Type":"NodeText","Data":"葶苈《本草求真》"}]},{"ID":"20240612182731-86wh3ip","Type":"NodeParagraph","Properties":{"id":"20240612182731-86wh3ip","updated":"20240612182731"},"Children":[{"Type":"NodeText","Data":"（隰草）泻肺停水"}]},{"ID":"20240612182731-msakkhz","Type":"NodeParagraph","Properties":{"id":"20240612182731-msakkhz","updated":"20240612182731"},"Children":[{"Type":"NodeText","Data":"葶苈（专入肺。兼入胃）。辛苦大寒。性急不减硝黄。大泻肺中水气。 急下行膀胱。故凡积聚症结。伏留热气。水肿痰壅。嗽喘经闭。便塞至极等症。（诸症皆就水气停肺而言。）无不当用此调。昔本草十剂篇云。泄可去闭。葶苈大黄之属。但大黄则泻脾胃阴分血闭。葶苈则泻肺经阳分气闭。葶苈有苦有甜。甜者性缓。虽泻而不伤。苦者性急。既泻肺而复伤胃。故必用以大枣补土以制水。但水去则止。不可过剂。观金匮所云用葶苈以治头疮。药气入脑杀人。其意大可知矣！子如黍米微长。色黄。糯米微炒用。得酒良。榆皮为使。（榆皮性亦利水。）"}]},{"ID":"20240612183151-myi6m4s","Type":"NodeThematicBreak","Properties":{"id":"20240612183151-myi6m4s"}},{"ID":"20240612183152-fj2g26o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183152-fj2g26o","updated":"20240612183156"},"Children":[{"Type":"NodeText","Data":"葶苈子《中药学》"}]},{"ID":"20240612183152-47hg9f8","Type":"NodeParagraph","Properties":{"id":"20240612183152-47hg9f8","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【药用】本品为十字花科植物播娘蒿的种子。"}]},{"ID":"20240612183152-0vgga3p","Type":"NodeParagraph","Properties":{"id":"20240612183152-0vgga3p","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，大寒。入肺、膀胱经。"}]},{"ID":"20240612183152-ty52ky9","Type":"NodeParagraph","Properties":{"id":"20240612183152-ty52ky9","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【功效】泻肺定喘，行水消肿。"}]},{"ID":"20240612183152-jdyouhh","Type":"NodeParagraph","Properties":{"id":"20240612183152-jdyouhh","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于痰涎壅滞、咳嗽气喘等症。"}]},{"ID":"20240612183152-c2fm7tb","Type":"NodeParagraph","Properties":{"id":"20240612183152-c2fm7tb","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"葶苈子能泄肺而下行，行水而消痰，故有泻肺定喘的功效，适用于痰涎壅肺、咳嗽痰喘、喉中有痰声如拉锯，在应用时可与桑白皮、旋覆花等药同用。"}]},{"ID":"20240612183152-cahyn3j","Type":"NodeParagraph","Properties":{"id":"20240612183152-cahyn3j","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"2.用于面目浮肿，胸腹积水而小便不利者。"}]},{"ID":"20240612183152-etg9yox","Type":"NodeParagraph","Properties":{"id":"20240612183152-etg9yox","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"本品泻肺气之闭，利膀胱之水，故又可用于面浮、小便不利、胸腹积水而属于实症者，常与防己、椒目、大黄等品配伍同用。"}]},{"ID":"20240612183152-abq2152","Type":"NodeParagraph","Properties":{"id":"20240612183152-abq2152","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【处方用名】甜葶苈、葶苈子（晒干用）、炒葶苈（炒用）、炙葶苈（蜜炙用）"}]},{"ID":"20240612183152-iamn7z8","Type":"NodeParagraph","Properties":{"id":"20240612183152-iamn7z8","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，包煎。"}]},{"ID":"20240612183152-c719trk","Type":"NodeParagraph","Properties":{"id":"20240612183152-c719trk","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【按语】1.葶苈子苦泄下降，能泄肺平喘、利水消肿，功似桑白皮而力较强。"}]},{"ID":"20240612183152-32lj1zd","Type":"NodeParagraph","Properties":{"id":"20240612183152-32lj1zd","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"2.过去，一般认为葶苈子泻肺行水之力较为峻烈，只宜用于实症，对肺虚喘促、脾虚肿满等症则非所宜。但近来有用以配合黄耆、附子等药治疗肺原性心脏病喘促浮肿等症的报导。"}]},{"ID":"20240612183152-k36ms03","Type":"NodeParagraph","Properties":{"id":"20240612183152-k36ms03","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"3.前人说葶苈子有苦有甜，甜者性缓，苦者性急。现上海地区药店中只有一种，习称甜葶苈，并无苦葶苈。"}]},{"ID":"20240612183152-wgcgbor","Type":"NodeParagraph","Properties":{"id":"20240612183152-wgcgbor","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"4.据考证，上海地区所用的葶苈子为播娘蒿的种子，习称南葶苈子；而北方地区多用十字花科植物独行菜的种子，习称北葶苈子。"}]},{"ID":"20240612183152-z8a37hj","Type":"NodeParagraph","Properties":{"id":"20240612183152-z8a37hj","updated":"20240612183152"},"Children":[{"Type":"NodeText","Data":"【方剂举例】葶苈大枣泻肺汤《金匮要略》：葶苈子、大枣。治肺中水饮壅塞，胸满喘咳，一身面目浮肿。"}]},{"ID":"20240612171817-v8gyq0v","Type":"NodeThematicBreak","Properties":{"id":"20240612171817-v8gyq0v"}},{"ID":"20240612182754-27envrp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182754-27envrp","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"《中国药典》：葶苈子"}]},{"ID":"20240612182754-600xajw","Type":"NodeParagraph","Properties":{"id":"20240612182754-600xajw","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612182754-5k36zem","Type":"NodeParagraph","Properties":{"id":"20240612182754-5k36zem","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" Tínɡ Lì Zǐ"}]},{"ID":"20240612182754-l8yvmlq","Type":"NodeParagraph","Properties":{"id":"20240612182754-l8yvmlq","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612182754-yera90k","Type":"NodeParagraph","Properties":{"id":"20240612182754-yera90k","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" SEMEN LEPIDII/SEMEN DESCURAINIAE"}]},{"ID":"20240612182754-ugovnvi","Type":"NodeParagraph","Properties":{"id":"20240612182754-ugovnvi","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612182754-ji330rp","Type":"NodeParagraph","Properties":{"id":"20240612182754-ji330rp","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 本品为十字花科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"独行菜"},{"Type":"NodeText","Data":"Lepidium apetalum Willd. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"播娘蒿"},{"Type":"NodeText","Data":"Descurainia sophia （L.）Webb ex prantl的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种子"},{"Type":"NodeText","Data":"。前者习称“北葶苈子”，后者习称“南葶苈子”。夏季果实成熟时采割植株，晒干，搓出种子，除去杂质。"}]},{"ID":"20240612182754-9bjoytu","Type":"NodeParagraph","Properties":{"id":"20240612182754-9bjoytu","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612182754-tr3jkam","Type":"NodeParagraph","Properties":{"id":"20240612182754-tr3jkam","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 北葶苈子：呈扁卵形，长1～1.5mm，宽0.5～1mm。表面棕色或红棕色，微有光泽，具纵沟2条，其中1条较明显。一端钝圆，另端尖而微凹，类白色，种脐位于凹入端。无臭，味微辛辣，黏性较强。"}]},{"ID":"20240612182754-s2ihtlz","Type":"NodeParagraph","Properties":{"id":"20240612182754-s2ihtlz","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"南葶苈子：呈长圆形略扁，长约1mm,宽约0.5mm。一端钝圆，另端微凹或较平截。味微辛、苦，略带黏性。"}]},{"ID":"20240612182754-uu0nvub","Type":"NodeParagraph","Properties":{"id":"20240612182754-uu0nvub","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612182754-rt3chmg","Type":"NodeParagraph","Properties":{"id":"20240612182754-rt3chmg","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240612182754-74nnyib","Type":"NodeParagraph","Properties":{"id":"20240612182754-74nnyib","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612182754-ryytu3m","Type":"NodeParagraph","Properties":{"id":"20240612182754-ryytu3m","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葶苈子"},{"Type":"NodeText","Data":"：除去杂质及灰屑。"}]},{"ID":"20240612182754-9c33jsl","Type":"NodeParagraph","Properties":{"id":"20240612182754-9c33jsl","updated":"20240612182754"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒葶苈子"},{"Type":"NodeText","Data":"：取净葶苈子，照清炒法（附录Ⅱ D）炒至有爆声。"}]},{"ID":"20240612182754-4ra5aa4","Type":"NodeParagraph","Properties":{"id":"20240612182754-4ra5aa4","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612182754-rgps13n","Type":"NodeParagraph","Properties":{"id":"20240612182754-rgps13n","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" （1）取本品少量，加水浸泡后，用扩大镜观察，北葶苈子透明状黏液层较厚，厚度可超过种子宽度的1/2 以上。南葶苈子透明状黏液层薄，厚度约为种子宽度的1/5 以下。"}]},{"ID":"20240612182754-73wxr4g","Type":"NodeParagraph","Properties":{"id":"20240612182754-73wxr4g","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"（2）北葶苈子 粉末黄棕色。种皮表皮细胞为黏液细胞，断面观略呈长方形，内壁增厚向外延伸成纤维素柱，纤维素柱长24～34μm,顶端钝圆、偏斜或平截，周围可见黏液质纹理。种皮内表皮细胞为黄色，表面观呈多角形、类方形、少数长多角形，直径15～42μm,壁厚5～8μm 。"}]},{"ID":"20240612182754-lsh38s6","Type":"NodeParagraph","Properties":{"id":"20240612182754-lsh38s6","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"南葶苈子 种皮外表皮细胞断面观类方形，纤维素柱短，长8～18μm，种皮内表皮细胞表面观长方多角形。"}]},{"ID":"20240612182754-or79dzd","Type":"NodeParagraph","Properties":{"id":"20240612182754-or79dzd","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612182754-mc19cb5","Type":"NodeParagraph","Properties":{"id":"20240612182754-mc19cb5","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 归肺、膀胱经。"}]},{"ID":"20240612182754-0hsq4wk","Type":"NodeParagraph","Properties":{"id":"20240612182754-0hsq4wk","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612182754-826igjv","Type":"NodeParagraph","Properties":{"id":"20240612182754-826igjv","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 辛、苦，大寒。"}]},{"ID":"20240612182754-gi4l154","Type":"NodeParagraph","Properties":{"id":"20240612182754-gi4l154","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612182754-68gjkmn","Type":"NodeParagraph","Properties":{"id":"20240612182754-68gjkmn","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 泻肺平喘，行水消肿。用于痰涎壅肺，喘咳痰多，胸胁胀满，不得平卧，胸腹水肿，小便不利；肺原性心脏病水肿。"}]},{"ID":"20240612182754-3cys1qa","Type":"NodeParagraph","Properties":{"id":"20240612182754-3cys1qa","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612182754-ywneut5","Type":"NodeParagraph","Properties":{"id":"20240612182754-ywneut5","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 3～9g，包煎。"}]},{"ID":"20240612182754-3fp9bhj","Type":"NodeParagraph","Properties":{"id":"20240612182754-3fp9bhj","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612182754-oscr28r","Type":"NodeParagraph","Properties":{"id":"20240612182754-oscr28r","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612182754-crtjzew","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182754-crtjzew","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：葶苈子"}]},{"ID":"20240612182754-wmv6cd3","Type":"NodeParagraph","Properties":{"id":"20240612182754-wmv6cd3","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612182754-pqkq0dj","Type":"NodeParagraph","Properties":{"id":"20240612182754-pqkq0dj","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" Tínɡ Lì Zǐ"}]},{"ID":"20240612182754-ekrq2da","Type":"NodeParagraph","Properties":{"id":"20240612182754-ekrq2da","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612182754-u9zlbql","Type":"NodeParagraph","Properties":{"id":"20240612182754-u9zlbql","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 大适、大室（《本经》），蕇蒿、丁历（《别录》）。"}]},{"ID":"20240612182754-caqglhj","Type":"NodeParagraph","Properties":{"id":"20240612182754-caqglhj","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612182754-pg84kdb","Type":"NodeParagraph","Properties":{"id":"20240612182754-pg84kdb","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612182754-lilu776","Type":"NodeParagraph","Properties":{"id":"20240612182754-lilu776","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612182754-5jyza9p","Type":"NodeParagraph","Properties":{"id":"20240612182754-5jyza9p","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 为十字花科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"独行菜、北美独行莱"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"播娘蒿"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。夏季果实成熟时，割取全草，晒干，打下种子，筛净杂质。"}]},{"ID":"20240612182754-mrk8tvn","Type":"NodeParagraph","Properties":{"id":"20240612182754-mrk8tvn","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612182754-y0vgj65","Type":"NodeParagraph","Properties":{"id":"20240612182754-y0vgj65","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" ①独行菜，又名：腺茎独行菜、辣辣根、羊辣罐、拉拉罐、白花草。"}]},{"ID":"20240612182754-tdczfx1","Type":"NodeParagraph","Properties":{"id":"20240612182754-tdczfx1","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"一年生或二年生草本，高10～30厘米。茎直立，上部多分枝，被有多数微小的头状毛。叶互生；茎下部叶狭长椭圆形，长3～5厘米，宽1～1.5厘米，边缘浅裂或深裂；茎上部叶线形，较小，全缘或前端有疏锯齿；叶基部均有耳，上面疏生微小短毛，下面无毛。长总状花序，顶生；花小；萼4，椭圆形；花瓣通常很小，呈退化状；雄蕊2～4，蜜腺4，短小，三角状广椭圆形；子房扁圆形，2室，柱头头状。短角果，卵状椭圆形，扁平，长2.5毫米，顶端微凹，果柄细，密生头状毛；中央开裂，假隔膜膜质白色。种子倒卵状椭圆形，淡红棕色。花期5～6月。果期6～7月。"}]},{"ID":"20240612182754-5oiwv5u","Type":"NodeParagraph","Properties":{"id":"20240612182754-5oiwv5u","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"生于田野、荒地、路旁。分布东北、河北、内蒙古、山东、山西、甘肃、青海、云南、四川等地。"}]},{"ID":"20240612182754-fgvv4r2","Type":"NodeParagraph","Properties":{"id":"20240612182754-fgvv4r2","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②北美独行菜，又名：美洲独行菜。"}]},{"ID":"20240612182754-2ltbxfo","Type":"NodeParagraph","Properties":{"id":"20240612182754-2ltbxfo","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"一年生或二年生草本。茎直立，上部分枝，枝上疏生短毛或近于无毛。叶互生；茎下部的叶狭披针形，长2～3.5厘米，宽4～10毫米，先端渐尖，基部渐狭成柄，边缘成羽状浅裂；茎上部的叶线形至线状披针形，较小，边缘羽状浅裂或近于全缘；上面疏生短毛，下面无毛。花紧密排列成顶生总状花序；萼4，线状披针形；花瓣4，白色，广卵形，先端微凹，基部呈爪状；雄蕊2～4，花丝扁平；子房扁卵圆形，2室，柱头头状。短角果，扁平，圆形，长约2.2毫米，先端微凹，略有翅。种子小，卵圆形而扁，棕黄色。花期6月。果期7月。"}]},{"ID":"20240612182754-v0cfo57","Type":"NodeParagraph","Properties":{"id":"20240612182754-v0cfo57","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"生于山坡、路旁等杂草丛中。分布吉林、辽宁、河北、安徽、浙江、江苏、河南、福建、江西等地。"}]},{"ID":"20240612182754-zjt87ee","Type":"NodeParagraph","Properties":{"id":"20240612182754-zjt87ee","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③播娘蒿（《救荒本草》），又名：眉毛蒿、眉眉蒿、婆婆蒿、黄蒿、密密蒿、米米蒿、麦蒿、米蒿。"}]},{"ID":"20240612182754-o8cql7f","Type":"NodeParagraph","Properties":{"id":"20240612182754-o8cql7f","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"一年生或二年生草本，高30～70厘米，全体灰白色而被叉状或分歧柔毛。茎上部多分枝，较柔细。叶互生；2～3回羽状分裂，最终的裂片狭线形，先端渐尖；在茎下部的叶有柄，渐向上则渐短或近于无柄。总状花序顶生，果序时特别伸长；花小；萼4，十字形排列，线形，先端渐尖，易早脱；花瓣4，黄色，匙形，较花萼稍长，先端微凹，基部渐狭而呈线状；雄蕊6，4强，均伸出于花瓣外，花丝扁平；子房圆柱形，2室，柱头呈扁压头状。长角果，线形，长2～3厘米，宽约1毫米。种子小，卵状扁平，褐色。花期4～6月。果期5～7月。"}]},{"ID":"20240612182754-r44o76m","Type":"NodeParagraph","Properties":{"id":"20240612182754-r44o76m","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"生于田野间。分布黑龙江、吉林、辽宁、内蒙古、河北、山东、安徽、河南、江苏、浙江、陕西、甘肃、湖北、四川、云南等地。"}]},{"ID":"20240612182754-vkkplmm","Type":"NodeParagraph","Properties":{"id":"20240612182754-vkkplmm","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612182754-u4jxlan","Type":"NodeParagraph","Properties":{"id":"20240612182754-u4jxlan","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" ①北葶苈子"}]},{"ID":"20240612182754-pbidytp","Type":"NodeParagraph","Properties":{"id":"20240612182754-pbidytp","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"又名：苦葶苈。为植物独行菜或北美独行菜的种子。形如瓜子而扁，黄棕色，长约1.5毫米，宽约0.75毫米。一端钝圆，一端渐尖而微凹，种脐位于凹入处，但不明显；扩大镜观察，表面多颗粒状细小突起，并有2条纵列的浅槽。气微，味苦辛，有粘性。以子粒充实、均匀、黄棕色、无杂质者为佳。"}]},{"ID":"20240612182754-rv6iixg","Type":"NodeParagraph","Properties":{"id":"20240612182754-rv6iixg","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"主产于河北、辽宁、内蒙古；此外，吉林、山西、甘肃、青海、黑龙江等地亦产。"}]},{"ID":"20240612182754-53nf17f","Type":"NodeParagraph","Properties":{"id":"20240612182754-53nf17f","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②华东葶苈子"}]},{"ID":"20240612182754-r9z0jzk","Type":"NodeParagraph","Properties":{"id":"20240612182754-r9z0jzk","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"又名：甜葶苈。为植物播娘蒿的种子。长圆形而扁，黄棕色，微有光泽，长约1毫米，径约0.5毫米，一端钝圆，另一端近截形，二边往往不等长，中央凹入，种脐位于凹入处，但不甚明显，种子表面具有细密的网纹及2条纵列的浅槽。气微，味淡，有粘性。以粒均匀、充实、黄棕色、无杂质者为佳。"}]},{"ID":"20240612182754-16e3fu8","Type":"NodeParagraph","Properties":{"id":"20240612182754-16e3fu8","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"主产江苏、山东、安徽。此外，甘肃、河南、山西、陕西、河北、浙江等地亦产。"}]},{"ID":"20240612182754-xzxy8oh","Type":"NodeParagraph","Properties":{"id":"20240612182754-xzxy8oh","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"此外，尚有①宽叶独行菜的种子在青海、甘肃作葶苈子使用（参见\"宽叶独行菜\"条）；②柱腺独行菜的种子在甘肃作葶苈子使用。③桂竹糖芥的种子在山东、河北、内蒙古等部分地区作葶苈子使用，山东称为苦葶苈子，参见\"桂竹糖芥\"条。"}]},{"ID":"20240612182754-28wu3yk","Type":"NodeParagraph","Properties":{"id":"20240612182754-28wu3yk","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"历代本草所载葶苈子的原植物不止一种。其中《政和本和所记载的葶苈均为独行菜属植物，即今之药材北葶苈子。《本草图经》的描述及《本草纲目》、《植物名实图考》所载的，则为蔊菜，其种子呈球形，略具棱角，长不足1毫米，黄褐色。目前在安徽、江西等地仍作葶苈子使用。"}]},{"ID":"20240612182754-kig4322","Type":"NodeParagraph","Properties":{"id":"20240612182754-kig4322","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612182754-tqbvl5g","Type":"NodeParagraph","Properties":{"id":"20240612182754-tqbvl5g","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 独行菜种子含脂肪油、芥子甙、蛋白质、糖类。"}]},{"ID":"20240612182754-rxpev3g","Type":"NodeParagraph","Properties":{"id":"20240612182754-rxpev3g","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"播娘蒿种子含挥发油，为异硫氰酸苄酯、异硫氰酸烯丙酯、二烯丙基二硫化物，脂肪油获得率15～20％，含亚麻酸7.54％，亚油酸32.5％，油酸25.1％，芥酸21.4％，棕榈酸9.64％，硬脂酸3.81％，非皂化部分含谷甾醇及少量黄色物质。种子中尚分出两种强心甙，其一名七里香甙甲。"}]},{"ID":"20240612182754-z27ve0h","Type":"NodeParagraph","Properties":{"id":"20240612182754-z27ve0h","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612182754-qug6dyf","Type":"NodeParagraph","Properties":{"id":"20240612182754-qug6dyf","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 播娘蒿、北美独行菜及独行菜的干燥种子之醇提取物，均表现强心作用，对在位蛙心可使之停止于收缩期，在位兔、猫心，猫心肺装置，猫心电图等研究，均使心收缩加强，心率减慢，心传导阻滞，对衰竭的心脏可增加输出量，降低静脉压。三种葶苈子均需要较大的剂量才能引起心甙样的特异作用，从播娘蒿中提得两种心甙，一种为七里香甙，另一种可能为伊夫单甙，其含量很低（一批含0.2％，另一批含0.03％），北美独行菜的含量更低。独行菜与桂竹糖芥等均属十字花科，作用可能相近似。其生物活性，如以每公斤体重折合生药计算（鸽法），播娘蒿醇提取物2.125克/公斤±0.116，北美独行菜4.36克/公斤±0.14，前者作用较强。七里香甙0.12毫克/公斤（猫法）或0.249±0.01毫克/公斤（鸽法），猫鸽之比为1：2，与毒毛旋花子甙相似。播娘蒿对猫灌胃吸收率最高为21.87％（给药后6小时），24小时对鸽的蓄积率42.3％，七里香甙24小时对鸽的蓄积率30.7±5.6％（24小时，鸽法），故推论为速效心甙。"}]},{"ID":"20240612182754-3hei5tr","Type":"NodeParagraph","Properties":{"id":"20240612182754-3hei5tr","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612182754-2bp5xac","Type":"NodeParagraph","Properties":{"id":"20240612182754-2bp5xac","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 葶苈子：拣净杂质，筛去灰屑。炒葶苈子：取净葶苈子置锅内，用文火炒至微鼓起，并有香气为度。取出，放凉。"}]},{"ID":"20240612182754-wh4vshd","Type":"NodeParagraph","Properties":{"id":"20240612182754-wh4vshd","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使葶苈，以糯米相合，微微焙，待米熟，去米，单捣用。\""}]},{"ID":"20240612182754-0h1vgnl","Type":"NodeParagraph","Properties":{"id":"20240612182754-0h1vgnl","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612182754-cbc7sbh","Type":"NodeParagraph","Properties":{"id":"20240612182754-cbc7sbh","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 入肺、膀胱经。"}]},{"ID":"20240612182754-agfuydp","Type":"NodeParagraph","Properties":{"id":"20240612182754-agfuydp","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"肺、心、脾、膀胱四经。\""}]},{"ID":"20240612182754-dewyolc","Type":"NodeParagraph","Properties":{"id":"20240612182754-dewyolc","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"为手太阴经正药，亦入手阳明，足太阳经。\""}]},{"ID":"20240612182754-a59zffe","Type":"NodeParagraph","Properties":{"id":"20240612182754-a59zffe","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入肺，兼入胃。\""}]},{"ID":"20240612182754-5spqot2","Type":"NodeParagraph","Properties":{"id":"20240612182754-5spqot2","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入肝、肺二经。\""}]},{"ID":"20240612182754-e75be72","Type":"NodeParagraph","Properties":{"id":"20240612182754-e75be72","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612182754-xa2pf7x","Type":"NodeParagraph","Properties":{"id":"20240612182754-xa2pf7x","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 辛苦，寒。"}]},{"ID":"20240612182754-vwhugjf","Type":"NodeParagraph","Properties":{"id":"20240612182754-vwhugjf","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，寒。\""}]},{"ID":"20240612182754-lr4nqd1","Type":"NodeParagraph","Properties":{"id":"20240612182754-lr4nqd1","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，大寒，无毒。\""}]},{"ID":"20240612182754-6s8ip76","Type":"NodeParagraph","Properties":{"id":"20240612182754-6s8ip76","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味酸，有小毒。\""}]},{"ID":"20240612182754-df1zwcr","Type":"NodeParagraph","Properties":{"id":"20240612182754-df1zwcr","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612182754-q991z8f","Type":"NodeParagraph","Properties":{"id":"20240612182754-q991z8f","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 肺虚喘咳、脾虚肿满者忌服。"}]},{"ID":"20240612182754-7r0ldiq","Type":"NodeParagraph","Properties":{"id":"20240612182754-7r0ldiq","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"榆皮为之使。得酒良。恶僵蚕、石龙芮。\""}]},{"ID":"20240612182754-o50vqiy","Type":"NodeParagraph","Properties":{"id":"20240612182754-o50vqiy","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"久服令人虚。\""}]},{"ID":"20240612182754-xf8391y","Type":"NodeParagraph","Properties":{"id":"20240612182754-xf8391y","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"不利于脾胃虚弱及真阴不足之人。凡肿满由于脾虚不能制水，水气泛溢；小便不通由于膀胱虚无气以化者，法所咸忌。\""}]},{"ID":"20240612182754-pn2qy1g","Type":"NodeParagraph","Properties":{"id":"20240612182754-pn2qy1g","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"④《本草便读》：\"寒饮、阴水等证及虚弱者，不可用也。\""}]},{"ID":"20240612182754-bfzn4xn","Type":"NodeParagraph","Properties":{"id":"20240612182754-bfzn4xn","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612182754-t19ytum","Type":"NodeParagraph","Properties":{"id":"20240612182754-t19ytum","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 下气行水。治肺壅喘急，痰坎咳嗽，水肿胀满。"}]},{"ID":"20240612182754-dgs9fr9","Type":"NodeParagraph","Properties":{"id":"20240612182754-dgs9fr9","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主症瘕积聚结气，饮食寒热，破坚逐邪，通利水道。\""}]},{"ID":"20240612182754-jnpfp2a","Type":"NodeParagraph","Properties":{"id":"20240612182754-jnpfp2a","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"下膀胱水，伏留热气，皮间邪水上出，面目浮肿，身暴中风热痱痒，利小腹。\""}]},{"ID":"20240612182754-b04pafz","Type":"NodeParagraph","Properties":{"id":"20240612182754-b04pafz","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③《药性沦》：\"利小便，抽肺气上喘息急，止嗽。\""}]},{"ID":"20240612182754-gy661jt","Type":"NodeParagraph","Properties":{"id":"20240612182754-gy661jt","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"④《开宝本草》：\"疗肺壅上气咳嗽，定喘促，除胸中痰饮。\""}]},{"ID":"20240612182754-18zn75e","Type":"NodeParagraph","Properties":{"id":"20240612182754-18zn75e","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑤《伤寒类要》：\"治肾瘅、唇干。\""}]},{"ID":"20240612182754-jo8yb54","Type":"NodeParagraph","Properties":{"id":"20240612182754-jo8yb54","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"通月经。\""}]},{"ID":"20240612182754-fhz9fll","Type":"NodeParagraph","Properties":{"id":"20240612182754-fhz9fll","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612182754-nj3mss1","Type":"NodeParagraph","Properties":{"id":"20240612182754-nj3mss1","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外甩：煎水洗或研末调敷。"}]},{"ID":"20240612182754-5adm799","Type":"NodeParagraph","Properties":{"id":"20240612182754-5adm799","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612182754-v0kkut9","Type":"NodeParagraph","Properties":{"id":"20240612182754-v0kkut9","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" ①治肺壅咳嗽脓血，喘嗽不得睡卧：甜葶苈二两半（隔纸炒令紫）。为末，每服二钱，水一盏，煎至六分，不拘时温服。（《世医得效方》葶苈散）"}]},{"ID":"20240612182754-6d1hsoe","Type":"NodeParagraph","Properties":{"id":"20240612182754-6d1hsoe","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②治嗽：葶苈子一两（纸衬熬令黑），知母一两，贝母一两。三物同捣筛，以枣肉半两，别销沙糖一两半，同入药中为丸，大如弹丸，每服以新绵裹一丸含之，徐徐咽津，甚者不过三丸。（《箧中方》含膏丸）"}]},{"ID":"20240612182754-vimvfxt","Type":"NodeParagraph","Properties":{"id":"20240612182754-vimvfxt","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③治上气咳嗽，长引气不得卧，或水肿，或遍体气肿，或单面肿，或足肿：葶苈子三升，微熬，捣筛为散，以清酒五升渍之，春夏三日，秋冬七日。初服如胡桃许大，日三夜一，冬日二夜二，量其气力，取微利为度，如患急困者，不得待日满，亦可以绵细绞即服。（《外台秘要方》）"}]},{"ID":"20240612182754-tqfgsnn","Type":"NodeParagraph","Properties":{"id":"20240612182754-tqfgsnn","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"④治咳嗽痰涎喘急：葶苈半两，半夏（生姜汁浸软，切作片子）半两，巴豆四十九粒（去皮，同上二味一处炒，候半夏黄为度）。上件除巴豆不用，只用上二味为细末，每服一钱，以生姜汁入蜜少许同调下，食后。（《杨氏家藏方》葶苈散）"}]},{"ID":"20240612182754-zjdfn30","Type":"NodeParagraph","Properties":{"id":"20240612182754-zjdfn30","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑤治肺痈喘不得卧：葶苈（熬令黄色、捣，丸如弹子大），大枣十二枚。上先以水三升，煮枣取二升，去枣内葶苈，煮取一升，顿服。（《金匮要略》葶苈大枣泻肺汤）"}]},{"ID":"20240612182754-1gdqh1q","Type":"NodeParagraph","Properties":{"id":"20240612182754-1gdqh1q","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑥治卒大腹水病：葶苈一两，杏仁二十枚。并熬黄色，捣，分十服，小便去，瘥。（《补缺肘后方》）"}]},{"ID":"20240612182754-cgwkvxl","Type":"NodeParagraph","Properties":{"id":"20240612182754-cgwkvxl","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑦治阳水暴肿，面赤烦渴，喘急，小便涩：甜葶苈一两半（炒，研末），汉防己（末）二两。以绿头鸭血及头，合捣万杵，丸如梧子大，甚者，空腹白汤下十丸，轻者五丸，日三、四服，五日止。小便利为验。（《外台秘要方》）"}]},{"ID":"20240612182754-eug06yi","Type":"NodeParagraph","Properties":{"id":"20240612182754-eug06yi","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑧治肿满腹大，四肢枯瘦，小便涩浊：甜葶苈（纸隔炒）、荠菜根等分。上为末，蜜丸如弹子大。每服一丸，陈皮汤嚼下，只三丸，小便清，数丸，腹当依旧。（《三因方》葶苈大丸）"}]},{"ID":"20240612182754-drohx49","Type":"NodeParagraph","Properties":{"id":"20240612182754-drohx49","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑨治男女大小头面手足肿：苦葶苈炒研，枣肉和丸，小豆大，每服十丸，煎麻子汤下，日三服，五七日小便多，则消肿也。忌咸酸生冷。（《外科精义》）"}]},{"ID":"20240612182754-37qmrrj","Type":"NodeParagraph","Properties":{"id":"20240612182754-37qmrrj","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑩治腹满口舌干燥，此肠间有水气：防己、椒目、葶苈（熬）、大黄各一两。上四味，末之，蜜丸如梧子大。先食饮服一丸，日三服，稍增，口中有津液，渴者，加芒硝半两。（《金匮要赂》已椒苈黄丸）"}]},{"ID":"20240612182754-s0wp5e6","Type":"NodeParagraph","Properties":{"id":"20240612182754-s0wp5e6","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑾治头风疼痛：葶苈子为末，以酒淋汁沐头，三、四度。（《肘后方》）"}]},{"ID":"20240612182754-24iqmf3","Type":"NodeParagraph","Properties":{"id":"20240612182754-24iqmf3","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑿治瘰疬结核：葶苈子二合，豉半斤（汤浸令软）。上药，都捣熟，捻作饼子如钱厚，安在疬子上，以艾炷如小指大，灸饼上，五日一度，灸七壮。（《圣惠方》葶苈饼子法）"}]},{"ID":"20240612182754-0lr5o5y","Type":"NodeParagraph","Properties":{"id":"20240612182754-0lr5o5y","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⒀治小儿白秃：葶苈捣末，以汤洗讫涂上。（《子母秘录》）"}]},{"ID":"20240612182754-8vzjiqs","Type":"NodeParagraph","Properties":{"id":"20240612182754-8vzjiqs","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⒁治月经不通：葶苈一升。为末，蜜丸如弹子大。绵裹纳阴中，入三寸，每丸一宿易之，有汁出止。（《千金方》）"}]},{"ID":"20240612182754-4eygkrj","Type":"NodeParagraph","Properties":{"id":"20240612182754-4eygkrj","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⒂治疳虫蚀齿：葶苈，雄黄等分。为末，腊月猪脂和成，以绵裹槐枝蘸点。（《金匮要略》）"}]},{"ID":"20240612182754-9142pe6","Type":"NodeParagraph","Properties":{"id":"20240612182754-9142pe6","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612182754-i0bg9fq","Type":"NodeParagraph","Properties":{"id":"20240612182754-i0bg9fq","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 治疗慢性肺原性心脏病并发心力衰竭"}]},{"ID":"20240612182754-9jcmo40","Type":"NodeParagraph","Properties":{"id":"20240612182754-9jcmo40","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"以北葶苈子末3～6克，每日分3次食后服，并配合一般对症处理和抗菌素以控制感染。曾治10例，效果良好。服药后多在第4日开始见尿量增加，浮肿渐退；心力衰竭到2～3周时见显着减轻或消失。服药过程中未发现任何副作用。"}]},{"ID":"20240612182754-kjshthg","Type":"NodeParagraph","Properties":{"id":"20240612182754-kjshthg","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612182754-zf8qx7h","Type":"NodeParagraph","Properties":{"id":"20240612182754-zf8qx7h","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义》：\"葶苈用子，子之味有甜苦两等，其形则一也。《经》既言味辛苦，则甜者不复更入药也。大概治体皆以行水走泄为用，故曰久服令人虚，盖取苦泄之义，其理甚明。《药性论》所说尽矣，但不当言味酸。\""}]},{"ID":"20240612182754-fvo727n","Type":"NodeParagraph","Properties":{"id":"20240612182754-fvo727n","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"②李杲：\"葶苈大降气，与辛酸同用以导肿气。本草十剂云：泄可去闭，葶苈、大黄之属。此二味皆大苦寒，一泄血闭，一泄气闭。盖葶苈之苦寒，气味俱厚，不减大黄，又性过于诸药，以泄阳分肺中之闭，亦能泄大便，为体轻象阳故也。\""}]},{"ID":"20240612182754-28a5em4","Type":"NodeParagraph","Properties":{"id":"20240612182754-28a5em4","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"葶苈，苦、甜二味，主治同。仲景用苦，余方或有用甜者，或有不言甜、苦者。大抵苦则下泄，甜则少缓，量病虚实用之，不可不审。本草虽云治同，甜、苦之味，安得不异。\""}]},{"ID":"20240612182754-vwtddfp","Type":"NodeParagraph","Properties":{"id":"20240612182754-vwtddfp","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"葶苈甘苦二种，正如牵牛黑白二色，急缓不同；又如葫芦甘苦二味，良毒亦异。大抵甜者下泄之性缓，虽泄肺而不伤胃；苦者下泄之性急，既泄肺而易伤胃，故以大枣辅之。然肺中水气膹满患者，非此不能除，但水去则止，不可过剂尔。既不久服，何致伤人，《淮南子》云：大戟去水，葶苈愈胀，用之不节，乃反成病。亦在用之有节。\""}]},{"ID":"20240612182754-9yym2vs","Type":"NodeParagraph","Properties":{"id":"20240612182754-9yym2vs","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑤《本草经疏》：\"葶苈，为手太阴经正药，故仲景泻肺汤用之，亦入手阳明、足太阳经。肺属金，主皮毛，膀胱属水，藏津液，肺气壅塞则膀胱与焉，譬之上窍闭则下窍不通，下窍不通，则水湿泛溢为喘满、为肿胀、为积聚，种种之病生矣。辛能散，苦能泄，大寒沉阴能下行逐水，故能疗《本经》所主诸病。\""}]},{"ID":"20240612182754-sni46ym","Type":"NodeParagraph","Properties":{"id":"20240612182754-sni46ym","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑥《本草经百种录》：\"葶苈滑润而香，专泻肺气，肺如水源，故能泻肺即能泻水。凡积聚寒热从水气来者，此药主之。\"\"大黄之泻从中焦始，葶苈之泻从上焦始，故《伤寒论》中承气汤用大黄，而陷胸汤用葶苈也。\""}]},{"ID":"20240612182754-ymrzf39","Type":"NodeParagraph","Properties":{"id":"20240612182754-ymrzf39","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"⑦《本草正义》：\"葶苈子苦降辛散，而性寒凉，故能破滞开结，定逆止喘，利水消肿。《本经》主治，皆以破泄为义。惟寒泄之品。能通利邪气之有余，不能补益正气之不足，苟非实热郁窒，自当知所顾忌。《别录》久服令人虚，本是至理。然肺家痰火壅塞，及寒饮弥漫，喘急气促，或为肿胀等证，亦必赖此披坚执锐之才，以成捣穴犁庭之绩。自徐氏之才，论\"十剂\"之泄以去闭，偶以大黄、葶苈二物并举，而东垣遂谓葶苈气味俱厚，不减大黄，景岳从而和之，石顽且谓苦寒不减硝黄，丹溪亦有葶苈性急，病涉虚者，杀人甚捷之说，遂令俗人不辨是否，畏如蛇蝎，即寻常肺气喘满、痰饮室塞之证，亦几有不敢轻试之意，其亦知实在性质，不过开泄二字，且体质本轻，故能上行人肺，而味又甚淡，何至猛烈乃尔。\""}]},{"ID":"20240612182754-vc1nplx","Type":"NodeParagraph","Properties":{"id":"20240612182754-vc1nplx","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612182754-ez3n93g","Type":"NodeParagraph","Properties":{"id":"20240612182754-ez3n93g","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612182754-slqvdt9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612182754-slqvdt9","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"《中华本草》：葶苈子"}]},{"ID":"20240612182754-rv0hb6v","Type":"NodeParagraph","Properties":{"id":"20240612182754-rv0hb6v","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612182754-o0qmsmj","Type":"NodeParagraph","Properties":{"id":"20240612182754-o0qmsmj","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" Tínɡ Lì Zǐ"}]},{"ID":"20240612182754-nsqv4u7","Type":"NodeParagraph","Properties":{"id":"20240612182754-nsqv4u7","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612182754-my4bn36","Type":"NodeParagraph","Properties":{"id":"20240612182754-my4bn36","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 丁历、大适、大室。"}]},{"ID":"20240612182754-2kv2xix","Type":"NodeParagraph","Properties":{"id":"20240612182754-2kv2xix","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612182754-3x5azg8","Type":"NodeParagraph","Properties":{"id":"20240612182754-3x5azg8","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" Seed of Pepperweed,Seed of Peppergrass, Seed of Flixweed Tansymustard, Pepperweed Seed Tansymustard Seed"}]},{"ID":"20240612182754-8a9avqa","Type":"NodeParagraph","Properties":{"id":"20240612182754-8a9avqa","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612182754-gi968ew","Type":"NodeParagraph","Properties":{"id":"20240612182754-gi968ew","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612182754-mlqr6us","Type":"NodeParagraph","Properties":{"id":"20240612182754-mlqr6us","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使葶苈子勿用赤须子，真相似，只是味微甘苦，葶苈子入顶苦。"}]},{"ID":"20240612182754-nw7ylzi","Type":"NodeParagraph","Properties":{"id":"20240612182754-nw7ylzi","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：葶苈，生藁城平泽田野。立夏后采实阴干。"}]},{"ID":"20240612182754-eey5foo","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612182754-eey5foo","updated":"20240612182754"},"Children":[{"ID":"20240612182754-7ooo6je","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240612182754-7ooo6je","updated":"20240612182754"},"Children":[{"ID":"20240612182754-p9cuy59","Type":"NodeParagraph","Properties":{"id":"20240612182754-p9cuy59","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"陶弘景：葶苈，出彭城者最胜，今近道亦有。母则公荠，子细黄，至苦，用之当熬。"}]}]}]},{"ID":"20240612182754-6ck78i3","Type":"NodeParagraph","Properties":{"id":"20240612182754-6ck78i3","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"4.《蜀本草》：葶苈，苗似荠，春末生，高二、三尺，花黄，角生子黄细，五月熟，采之暴干。"}]},{"ID":"20240612182754-35r8lny","Type":"NodeParagraph","Properties":{"id":"20240612182754-35r8lny","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：葶苈，今京东、陕西、河"}]},{"ID":"20240612182754-97ovgjh","Type":"NodeParagraph","Properties":{"id":"20240612182754-97ovgjh","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612182754-az2qxys","Type":"NodeParagraph","Properties":{"id":"20240612182754-az2qxys","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 药材基源：为十字花科植物葶苈、琴叶葶苈和播娘蒿的种子。"}]},{"ID":"20240612182754-p457ite","Type":"NodeParagraph","Properties":{"id":"20240612182754-p457ite","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Lepidium apetalum Willd.2.Lepidium virginicum L.3.Descurainia sophia(L.)Webb ex Prant[Sisymbrium sophia L.]"}]},{"ID":"20240612182754-8z8dbfx","Type":"NodeParagraph","Properties":{"id":"20240612182754-8z8dbfx","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"采收和储藏：翌年4月底5月上旬采收，果实呈黄绿色时及时收割，以免过熟种子脱落。晒干，除去茎、叶杂质，放入麻袋或其他包装物，贮放干燥处，防潮、粘结和发霉。"}]},{"ID":"20240612182754-3hd6owm","Type":"NodeParagraph","Properties":{"id":"20240612182754-3hd6owm","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612182754-o0cmqeo","Type":"NodeParagraph","Properties":{"id":"20240612182754-o0cmqeo","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔 400-2000m的山坡、沟旁、路旁及村庄附近，为常见的田间杂草。"}]},{"ID":"20240612182754-vovktnl","Type":"NodeParagraph","Properties":{"id":"20240612182754-vovktnl","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2.生于路旁、荒地及田野。"}]},{"ID":"20240612182754-55bed5s","Type":"NodeParagraph","Properties":{"id":"20240612182754-55bed5s","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"3.生于山坡、田野和农田。"}]},{"ID":"20240612182754-mgkxw5u","Type":"NodeParagraph","Properties":{"id":"20240612182754-mgkxw5u","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华北、西北、华东、西南等地。"}]},{"ID":"20240612182754-pgavonw","Type":"NodeParagraph","Properties":{"id":"20240612182754-pgavonw","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2.原产美洲；我国分布于山东、江苏、安徽、浙江、江西、福建、台湾、河南、湖北、广西等地。"}]},{"ID":"20240612182754-zy096hb","Type":"NodeParagraph","Properties":{"id":"20240612182754-zy096hb","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"3.分布于东北、华北、西北、华东、西南等地。"}]},{"ID":"20240612182754-7noscu7","Type":"NodeParagraph","Properties":{"id":"20240612182754-7noscu7","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612182754-ocu5f8e","Type":"NodeParagraph","Properties":{"id":"20240612182754-ocu5f8e","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 1.葶苈 一年生或二年生草本，高5-30cm。茎直立，或自基部具多数分枝，被白色微小头状毛。基生叶有柄，叶柄长1-2cm；叶片狭匙形或倒披针形，一回羽状浅裂或深裂，长3-5cm，宽1-1.5cm，先端短尖，边缘有稀疏缺刻状锯齿，基部渐狭；茎生叶披针形或长圆形，中部叶片长1.5-2cm，宽2-5mm，基部稍宽，无柄，贴茎生，边缘有疏齿；最上部叶线形，先端尖，边缘少有疏齿或近于全缘；两面无毛或疏披头状毛。总状花序顶生，果期可延长至5cm；花小，排列疏松；萼片4，近卵形，边缘白色膜质状，外面有弯曲的白色柔毛；花瓣不存或者退化成丝状，比萼片短；雄蕊2或4，等长；蜜腺4，短小；雌蕊1，子房卵圆形而扁，无花柱，柱头圆形而扁。短角果卵圆形或椭圆形，长2-3mm，扁平，顶端微凹，宿存极短花枝，果瓣顶部具极狭翅，假隔膜宽不到lmm。种子椭圆状卵形，表面平滑，棕红色或黄褐色。花期5-6月，果期6-7月。"}]},{"ID":"20240612182754-e88m6x2","Type":"NodeParagraph","Properties":{"id":"20240612182754-e88m6x2","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2．琴叶葶琴叶葶苈 一年生或二年生草本，高20-50cm。茎直立，单一，表面具柱状腺毛；上部分枝，枝上疏生短柔毛或近于无毛。叶互生；基生叶具柄，叶柄长1-1.5cm；叶片倒披针形，长l-5cm，羽状分裂或大头羽状分裂，裂片大小不等，卵形或长圆形，基部斯狭，边缘有锯齿，两面有短伏毛；茎生叶有短柄，叶片倒披针形或线形，长1.5-5cm，宽2-10mm，光瑞急尖，基部渐狭。总状花序顶生，花多数；等片4，绿色，卵形或椭圆形，长约1mm；花瓣4,白色，倒卵形，和萼片等长或稍长；雄蕊2或4，近等长，长1.5-2mm；雌蕊1，子房卵圆形而扁， 2室，花柱不明显，柱头头状。短角果近圆形，长3mm，宽l-2mm，扁平，先端微凹，边缘有窄翅，花柱极短。种子每室1粒，卵形，长约1mm，光滑，红棕色，边缘有白色窄翅。花期4-5月，果期6-7月。"}]},{"ID":"20240612182754-zvghw3o","Type":"NodeParagraph","Properties":{"id":"20240612182754-zvghw3o","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"3．播娘蒿 一年生或二年生草本，高20-80cm。全株呈灰白色。茎直立，上部分枝，具纵梭槽，密被分技状短柔毛。叶轮廓为长圆形或长国状披针形，长3-7cm，宽1-4cm，二至三回羽状全裂或深裂，最终裂片条形或条状长圆形，长2-5mm，先端钝，全缘，两面被分枝短柔毛；茎下部叶有叶柄，向上叶柄逐渐缩短或近于无柄。总状花序顶生，具多数花；萼片4，条状长圆形，先端钝，长约2mm，边缘膜质，背面有分枝细柔毛；花瓣黄色，匙形，与萼片近等长；雄蕊6，几与花瓣等长，基部并有爪；雌蕊1，子房圆柱形，花柱短，柱头呈扁压的头状。长角果圆筒状，长2.5-3cm，无毛，稍内曲，与果梗不成直线，果辩中脉明显。种子每室1行，形小，多数个圆形，稍扁，淡红褐色，表面有细网纹，潮湿后有粘胶物质。花、果朝为4-7月。"}]},{"ID":"20240612182754-u0qx0ep","Type":"NodeParagraph","Properties":{"id":"20240612182754-u0qx0ep","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612182754-6xv0ep5","Type":"NodeParagraph","Properties":{"id":"20240612182754-6xv0ep5","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖、湿润、阳光充足的环境，适宜栽培在土壤肥沃、疏松、排水良好的坡地。"}]},{"ID":"20240612182754-5l8ml3a","Type":"NodeParagraph","Properties":{"id":"20240612182754-5l8ml3a","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"栽培技术 种子繁殖，9月下旬前播种，按行珠距40cm×20cm穴播，11-12月结合除草匀苗、补苗，每穴留壮苗4-5株。翌年2月结合中耕除草，追施人粪尿1次。"}]},{"ID":"20240612182754-hhyg9it","Type":"NodeParagraph","Properties":{"id":"20240612182754-hhyg9it","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"病虫害防治 菌核病，播种时用5％食盐水浸种20min，或5％石灰水淋穴。"}]},{"ID":"20240612182754-cnty4c4","Type":"NodeParagraph","Properties":{"id":"20240612182754-cnty4c4","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612182754-8snar9k","Type":"NodeParagraph","Properties":{"id":"20240612182754-8snar9k","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）北葶苈子 种子扁卵形，长1-1.5-mm，宽0。5-1mm。表面黄棕色或红棕色，微有光泽，具多数细微颗粒状突起，并可见2条纵列的浅槽，其中一条较明显，一端钝圆，另端渐尖而微凹，种脐位于凹下处，但不明显。无臭，味微苦辛，粘性较强。"}]},{"ID":"20240612182754-ei5yn7n","Type":"NodeParagraph","Properties":{"id":"20240612182754-ei5yn7n","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"（2）南葶苈子 长圆形略扁，长0.8-1.2mm，宽约0.5mm；表面黄棕色，一端钝圆，另一端微凹或较平截，中央凹入，种脐位于凹下处，种子表面具有细密的网纹及2条纵列的浅槽。气微，味微辛，略带粘性。"}]},{"ID":"20240612182754-qdlkipe","Type":"NodeParagraph","Properties":{"id":"20240612182754-qdlkipe","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"显微鉴别 种子横切面：（l）北葶苈子表皮为1列粘液细胞，其外壁向外特化成粘液层，厚度可达216μm，内壁有纤维素沉积形成径向延伸的纤维素柱，长24-34μm，先端钝圆、偏斜或平截，周围可见粘液质纹理。栅状细胞1列，略呈方形，宽26-34μm，侧壁和内壁增厚，强木化。色素层细胞颓废状，其下方有1列扁平的内胚乳细胞，内含糊粉粒。子叶占大部分，细胞呈不规则多边形，壁稍厚，内含糊粉粒。"}]},{"ID":"20240612182754-nepld5j","Type":"NodeParagraph","Properties":{"id":"20240612182754-nepld5j","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"（2）南葶苈子 粘液细胞外壁的粘液层较薄，厚约100μm，内壁纤维素柱长8-28μm。余同北葶苈子。"}]},{"ID":"20240612182754-z5xkyl6","Type":"NodeParagraph","Properties":{"id":"20240612182754-z5xkyl6","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612182754-l9x1i2u","Type":"NodeParagraph","Properties":{"id":"20240612182754-l9x1i2u","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 1．葶苈 种子含黑芥子甙（sinigrin）。"}]},{"ID":"20240612182754-39lk45o","Type":"NodeParagraph","Properties":{"id":"20240612182754-39lk45o","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2．播娘蒿 种子含芥子酸（sinapic acid），毒毛花甙元（strophanthidin），黄白糖芥甙（helveticoside）[即是糖芥甙（erysimin），又名糖芥毒甙忒（erysimotoxin）]，卫矛单糖甙（evomonoside），卫矛双糖甙（evobioside），葡萄糖糖芥甙（erysimo-side），芥子碱（sinapine）。种子的挥发油含芥子油甙（giucosinolate），芥酸（erucic acid），异硫氰酸苄酯（benzyl isthiocyanate），异硫氰酸烯丙酯（allyl isothiocyanate），二烯丙基二硫化物（allyl disulfide）；还含脂肪油，其中脂肪酸为亚油酸（linoleic acid），亚麻酸（linolenic acid），油酸（oleic cid），棕榈酸（palmitic acid），硬脂酸（stearic acid）及芥酸，非皂化部分含β-谷甾醇（β-sitosterol）。全草含顺式芥子酸葡萄糖甙（cis-sinapic acid glu-coside）及反式芥子酸葡萄糖甙（trans-sinapic acid glucoside）。"}]},{"ID":"20240612182754-uhcy1b6","Type":"NodeParagraph","Properties":{"id":"20240612182754-uhcy1b6","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612182754-26aa9gn","Type":"NodeParagraph","Properties":{"id":"20240612182754-26aa9gn","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 1.强心作用：播娘蒿、北美独行菜及独行莱的干燥种子之醇提取物，均表观强心作用，对在位娃心可使之停止于收缩期，在位兔、猫心，猫心肺装置，猫心电图等研究，均使心收缩加强，心率减慢，心传导阻滞，对衰竭的心脏可增加输出量，降低静脉压。三种葶苈子均需要较大的剂量才能引起心甙样的特异作用，从播娘蒿中提得两种心甙，一种为七里香甙，另一种可能为伊夫单甙(Evomonoside)，其含量很低(一批含0.2%，另一批含0.03%)，北美独行菜的含量更低。独行菜与桂竹糖芥等均属十字花科，作用可能相近似。其生物活性，如以每公斤体重折合生药计算(鸽法)，播娘蒿醇提取物2.125g／kg±0.116，北美独行菜4.36g／kg±0.14，前者作用较强。七里香甙0.12mg／kg(猫法)或0.249±0.01mg／kg(鸽法)，猫鸽之比为1∶2，与毒毛旋花子甙相似。播娘蒿对猫灌胃吸收收率最高为21.87%(给药后6小时)，24小时对鸽的蓄积率42.3%，七里香甙24小时对鸽的蓄积率；30.7±5.6%(24小时，鸽法)，故推论为速效心甙。播娘蒿种子和独行菜种子的醇提物用在体心脏（蛙、兔、猫）、猫心电图描记发心肺制备禁区本试验均呈强心甙样的作用，能增强心肌收缩力，减慢心率，降低传导速度，大剂量可引起心动过速、心室颤动等强心甙中毒症状；鸽静脉注射量小致死量播娘蒿种子为2.125g/kg，独行菜种子为4.36g/kg。"}]},{"ID":"20240612182754-8byrtw8","Type":"NodeParagraph","Properties":{"id":"20240612182754-8byrtw8","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2.利尿作用：葶苈子有利尿作用。"}]},{"ID":"20240612182754-uz1yoke","Type":"NodeParagraph","Properties":{"id":"20240612182754-uz1yoke","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612182754-6392k5o","Type":"NodeParagraph","Properties":{"id":"20240612182754-6392k5o","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 葶苈子：拣净杂质，筛去灰屑。炒葶苈子：取净葶苈子置锅内，用文火炒至微鼓起，并有香气为度。取出，放凉。《雷公炮炙论》：凡使葶苈，以糯米相合，微微焙，待米熟，去米，单捣用。"}]},{"ID":"20240612182754-8fxyuf2","Type":"NodeParagraph","Properties":{"id":"20240612182754-8fxyuf2","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612182754-bykv0dz","Type":"NodeParagraph","Properties":{"id":"20240612182754-bykv0dz","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品少量，加水浸泡后，用放大镜观察：北葶苈子透明状粘液层较厚，其厚度可超过种子宽度的1/2以上；其膨胀度不低于12。南葶苈子透明状粘液层薄，厚度约为种子宽度的1/5以下，其膨胀度不低于3。（2）取粉末约1g，置硬质试管内，加氢氧化钠1小粒，置酒精灯上灼热，放冷，加水2ml使溶解，滤过。取滤液lml加5％盐酸酸化，即有硫化氢产生，通新制的醋酸铅试纸显有光泽的棕黑色。另取亚硝基铁氰化钠1小粒，置白瓷板上，加水1-2滴使溶解，加上述滤液1-2滴，显紫红色。（检查异硫氰甙类）"}]},{"ID":"20240612182754-307iyip","Type":"NodeParagraph","Properties":{"id":"20240612182754-307iyip","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612182754-dt4med1","Type":"NodeParagraph","Properties":{"id":"20240612182754-dt4med1","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 肺；心；肝；胃；膀胱经"}]},{"ID":"20240612182754-5vs3e7g","Type":"NodeParagraph","Properties":{"id":"20240612182754-5vs3e7g","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612182754-gskdd5r","Type":"NodeParagraph","Properties":{"id":"20240612182754-gskdd5r","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 辛；苦；寒"}]},{"ID":"20240612182754-giiy4fw","Type":"NodeParagraph","Properties":{"id":"20240612182754-giiy4fw","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612182754-fk1708w","Type":"NodeParagraph","Properties":{"id":"20240612182754-fk1708w","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 肺虚喘咳、脾虚肿满者忌服。"}]},{"ID":"20240612182754-oo3lsjf","Type":"NodeParagraph","Properties":{"id":"20240612182754-oo3lsjf","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"1.《别录》：久服令人虚。"}]},{"ID":"20240612182754-ejqj9m4","Type":"NodeParagraph","Properties":{"id":"20240612182754-ejqj9m4","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：不利于脾胃虚弱及真阴不足之人。凡肿满由于脾虚不能制水，水气泛溢；小便不通由于膀胱虚无气以化者，法所咸忌。"}]},{"ID":"20240612182754-1bqb3qe","Type":"NodeParagraph","Properties":{"id":"20240612182754-1bqb3qe","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"3.《本草便读》：寒饮、阴水等证及虚弱者，不可用也。"}]},{"ID":"20240612182754-6ar6nhc","Type":"NodeParagraph","Properties":{"id":"20240612182754-6ar6nhc","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612182754-frwm6rs","Type":"NodeParagraph","Properties":{"id":"20240612182754-frwm6rs","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 泻肺降气；祛痰平喘；利水消肿；泄逐邪。主痰涎壅肺之喘咳痰多；肺痈；水肿；胸腹积水；小便不利；慢性肺源性心脏病；心力衰竭之喘肿；瘰疬结核"}]},{"ID":"20240612182754-nceyyo9","Type":"NodeParagraph","Properties":{"id":"20240612182754-nceyyo9","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612182754-iqx1wo8","Type":"NodeParagraph","Properties":{"id":"20240612182754-iqx1wo8","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或入丸、散。外用：适量，煎水洗或研研末调敷。利水消肿宜生用；治痰饮喘咳宜炒用；肺虚痰阴喘咳 宜蜜炙用。"}]},{"ID":"20240612182754-rmjaqa4","Type":"NodeParagraph","Properties":{"id":"20240612182754-rmjaqa4","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612182754-823pvf2","Type":"NodeParagraph","Properties":{"id":"20240612182754-823pvf2","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" ①治肺壅咳嗽脓血，喘嗽不得睡卧：甜葶苈二两半(隔纸炒令紫)。为末，每服二钱，水一盏，煎至六分，不拘时温服。 (《世医得效方》葶苈散)②治嗽： 葶苈子一两(纸衬熬令黑)，知母一两，贝母一两。三物同捣筛，以枣肉半两，别销沙糖一两半，同入药中为丸，大如弹丸，每服以新绵裹一丸含之，徐徐咽律，甚者不过三丸。 (《箧中方》含膏丸)③治上气咳嗽，长引气不得卧，或水肿，或遍体气肿，或单面肿，或足肿： 葶苈子三升，微熬，捣筛为散，以清酒五升渍之，春夏三日，秋冬七日。初服如胡桃许大，日三夜一，冬日二夜二，量其气力，取微利为度，如患急困者，不得待日满，亦可以绵细绞即服。 (《外台秘要方》)④治咳嗽痰涎喘急： 葶苈半两，半夏(生姜汁浸软，切作片子)半两，巴豆四十九粒(去皮，同上二味一处炒，候半夏黄为度)。上件除巴豆不用，只用上二味为细末，每服一钱，以生姜汁入蜜少许同调下，食后。(《杨氏家藏方》葶苈散)⑤治肺痈喘不得卧： 葶苈(熬令黄色、捣，丸如弹子大)，大枣十二枚。上先以水三升，煮枣取二升，去枣内葶苈，煮取一升，顿服。(《金匮要略》葶苈大枣泻肺汤)⑥治卒大腹水病： 葶苈一两，杏仁二十枚。并熬黄色，捣，分十服，小便去，瘥。(《补缺肘后方》)⑦治阳水暴肿，面赤烦渴，喘急，小便涩：甜葶苈一两半(炒，研末)，汉防己(末)二两。以绿头鸭血及头，合捣万杵，丸如梧子大，甚者，空腹白汤下十丸，轻者五丸，日三、四服，五日止。小便利为验。 (《外台秘要方》)⑧治肿满腹大，四肢枯瘦，小便涩浊：甜葶苈(纸隔炒)、荠菜根等分。上为末，蜜丸如弹子大。每服一丸，陈皮汤嚼下，只三丸，小便清，数丸，腹当依旧。(《三因方》葶苈大丸)⑨治男女大小头面手足肿： 苦葶苈炒研，枣肉和丸，小豆大，每服十丸，煎麻子汤下，日三服，五七日小便多，则消肿也。 忌咸酸生冷。 (《外科精义》)⑩治膜满口舌干燥， 此肠间有水气： 防己、椒目、葶苈(熬)、大黄各一两。上四味，末之，蜜丸如梧子大。先食饮服一丸，日三服，稍增，口中有津液渴者，加芒硝半两。 (《金匮要略》己椒苈黄丸)(11)治头风疼痛： 葶苈子为未，以酒淋汁沐头，三、四度。(《肘后方》)(12)治瘰疬结核： 葶苈子二合，豉半斤(汤浸令软)。上药，都捣熟，捻作饼子如钱厚，安在疬子上，以艾炷如小指大，灸饼上，五日一度，灸七壮。(《圣惠方》葶苈饼子法)(13)治小儿白秃：葶苈捣末， 以汤洗讫涂上。(《子母秘录》)(14)治月经不通： 葶苈一升。为末，蜜丸如弹子大。绵裹纳阴中，入三寸，每丸一宿易之，有汁出止。(《千金方》)(15)治疳虫蚀齿：葶苈、雄黄等分。为末，腊月猪脂和成，以绵裹槐枝蘸点。 (《金匮要略》)"}]},{"ID":"20240612182754-3v8h3ky","Type":"NodeParagraph","Properties":{"id":"20240612182754-3v8h3ky","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612182754-tdpgnfr","Type":"NodeParagraph","Properties":{"id":"20240612182754-tdpgnfr","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 治疗慢性肺原性心脏病并发心力衰竭。以北葶苈子末3-6g，每日分3次食后服，并配合一般对症处理和抗菌素以控制感染。曾治10例，效果良好。服药后多在第4日开始见尿量增加，浮肿渐退；心力衰竭到2-3周时见显着减轻或消失。服药过程中未发现任何副作用。"}]},{"ID":"20240612182754-uirt3cv","Type":"NodeParagraph","Properties":{"id":"20240612182754-uirt3cv","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612182754-9fbgl7f","Type":"NodeParagraph","Properties":{"id":"20240612182754-9fbgl7f","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：葶苈用子，子之味有甜苦两等，其形则一也。《经》既言味辛苦，则甜者不复更入药也。大概治体皆以行水走泄为用，故曰久服令人虚，盖取苦泄之义，其理甚明。《药性论》所说尽矣，但不当言味酸。"}]},{"ID":"20240612182754-wnefl2u","Type":"NodeParagraph","Properties":{"id":"20240612182754-wnefl2u","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"2.李杲：葶苈大降气，与辛酸同用以导肿气。本草十剂云：泄可去闭，葶苈、大黄之属。此二味皆大苦寒，一泄血闭，一泄气闭。盖葶苈之苦寒，气味俱厚，不减大黄，又性过于诸药，以泄阳分肺中之闭，亦能泄大便，为体轻象阳故也。"}]},{"ID":"20240612182754-ww2id70","Type":"NodeParagraph","Properties":{"id":"20240612182754-ww2id70","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"3.《汤液本草》：葶苈，苦、甜二味，主治同。仲景用苦，余方或有用甜者，或有不言甜、苦者。大抵苦则下泄，甜则少缓，量病虚实用之，不可不审，本草虽云治同，甜、苦之味，安得不异。"}]},{"ID":"20240612182754-edom8fh","Type":"NodeParagraph","Properties":{"id":"20240612182754-edom8fh","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：葶苈甘苦二种，正如牵牛黑白二色，急缓不同；又如葫芦甘苦二味，良毒亦异。大抵甜者下泄之性缓，虽泄肺而不伤胃；苦者下汇之性急，既汇肺而易伤胃，故以大枣辅之。然肺中水气满急者，非此不能除，但水去则止，不可过剂尔。既不久服，何致伤人《淮南子》云：大戟去水，葶苈愈胀，用之不节，乃反成病。亦在用之有节。"}]},{"ID":"20240612182754-3hniqhc","Type":"NodeParagraph","Properties":{"id":"20240612182754-3hniqhc","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"5.《本草经疏》：葶苈，为手太阴经正药，故仲景泻肺汤用之，亦入手阳明、足太阳经。肺届金，主皮毛，膀胱属水，藏津液，肺气壅塞则膀胱与焉，譬之上窍闭则下窍不通，下窍不通，则水湿泛溢为喘满、为肿胀、为积聚，种种之病生矣。辛能散，苦能泄，大寒沉阴能下行逐水，故能疗《本经》所主诸病。"}]},{"ID":"20240612182754-666csse","Type":"NodeParagraph","Properties":{"id":"20240612182754-666csse","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"6.《本草经百种录》：葶苈滑润而香，专泻肺气，肺如水源，故能泻肺即能泻水。凡积聚寒热从水气来者，此药主之。大黄之泻从中焦始，葶苈之泻从上焦始，故《伤寒论》中承气汤用大黄，而陷胸汤用葶苈也。"}]},{"ID":"20240612182754-19jftcv","Type":"NodeParagraph","Properties":{"id":"20240612182754-19jftcv","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"7.《本草正义》：葶苈子苦降辛散，而性寒凉，故能破滞开结，定逆止喘，利水消肿。《本经》主治，皆以破泄为义。惟寒泄之品，能通利邪气之有余，不能补益正气之不足，苟非实热郁窒，自当知所顾忌。《别录》久服令人虚，本是至理。然肺家痰火壅塞，及寒饮弥漫，喘急气促，或为肿胀等证，亦必赖此披坚执锐之才，以成捣穴犁庭之绩。自徐氏之才，论十剂之泄以去闭，偶以大黄、葶苈二物并举，而东垣遂谓葶苈气味俱厚，不减犬黄，景岳从而和之，石顽且谓苦寒不减硝黄，丹溪亦有葶苈性急，病涉虚看，杀人甚捷之说，遂令俗人不辨是否，畏如蛇蝎，即寻常肺气喘满、痰饮窒塞之证，亦几有不敢轻试之意，其亦知实在性质，不过开泄二字，且体质本轻；故能上行入肺，而味又甚淡，何至猛烈乃尔。"}]},{"ID":"20240612182754-i03u3hb","Type":"NodeParagraph","Properties":{"id":"20240612182754-i03u3hb","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"8.《本经》：主症瘕积聚结气，饮食寒热，破坚逐邪，通利水道。"}]},{"ID":"20240612182754-vpk447w","Type":"NodeParagraph","Properties":{"id":"20240612182754-vpk447w","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"9.《别录》：下膀胱水，伏留热气，皮间邪水上出，面目浮肿，身暴中风热痱痒，利小腹。"}]},{"ID":"20240612182754-960fof4","Type":"NodeParagraph","Properties":{"id":"20240612182754-960fof4","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"10.《药性论》：利小便，抽肺气上喘息急，止嗽。"}]},{"ID":"20240612182754-5moskao","Type":"NodeParagraph","Properties":{"id":"20240612182754-5moskao","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"11.《开宝本草》：疗肺壅上气咳嗽，定喘促，除胸中痰饮。"}]},{"ID":"20240612182754-dmlh6q8","Type":"NodeParagraph","Properties":{"id":"20240612182754-dmlh6q8","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"12.《伤寒类要》：治肾瘅、唇干。"}]},{"ID":"20240612182754-gnpecb8","Type":"NodeParagraph","Properties":{"id":"20240612182754-gnpecb8","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"13.《纲目》：通月经。"}]},{"ID":"20240612182754-3lqdy7a","Type":"NodeParagraph","Properties":{"id":"20240612182754-3lqdy7a","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612182754-d0wjxqb","Type":"NodeParagraph","Properties":{"id":"20240612182754-d0wjxqb","updated":"20240612182754"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612182755-1kg0mk6","Type":"NodeThematicBreak","Properties":{"id":"20240612182755-1kg0mk6"}},{"ID":"20240612182757-bgqjxii","Type":"NodeParagraph","Properties":{"id":"20240612182757-bgqjxii"}}]}