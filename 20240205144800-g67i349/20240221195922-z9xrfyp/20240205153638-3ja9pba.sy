odeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑葚 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑葚 1-20240715132109-37eakvq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715132550-l90ql7k","Type":"NodeParagraph","Properties":{"id":"20240715132550-l90ql7k","updated":"20240715132701"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 356px;","style":"width: 346px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑葚 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑葚 4-20240715132550-goqmo7h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 346px;\" parent-style=\"width: 356px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 788px;","style":"width: 778px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑葚 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑葚 5-20240715132701-el4fje4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 778px;\" parent-style=\"width: 788px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715132232-fjhj64r","Type":"NodeParagraph","Properties":{"id":"20240715132232-fjhj64r","updated":"20240715132232"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 666px;","style":"width: 656px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626081624-o3gs902.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 656px;\" parent-style=\"width: 666px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 580px;","style":"width: 570px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626081527-rvkifua.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 570px;\" parent-style=\"width: 580px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715132934-k4xg43m","Type":"NodeParagraph","Properties":{"id":"20240715132934-k4xg43m","updated":"20240821085006"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 752px;","style":"width: 742px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑葚 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑葚 7-20240715132928-u3xsjds.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 742px;\" parent-style=\"width: 752px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 397px;","style":"width: 387px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626081425-wipp1mb.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 387px;\" parent-style=\"width: 397px;\"}"},{"Type":"NodeText","Data":"​​​​​​​"}]},{"ID":"20240715132749-4ehmvva","Type":"NodeParagraph","Properties":{"id":"20240715132749-4ehmvva","updated":"20240821085008"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 732px;","style":"width: 722px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑葚 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑葚 6-20240715132749-l90vlid.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 722px;\" parent-style=\"width: 732px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626081328-z2wkq85.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612085605-dmch594","Type":"NodeThematicBreak","Properties":{"id":"20240612085605-dmch594"}},{"ID":"20240612085701-ermr87t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085701-ermr87t","updated":"20240612085706"},"Children":[{"Type":"NodeText","Data":"桑根白皮《神农本草经》"}]},{"ID":"20240612085701-62c9jvt","Type":"NodeParagraph","Properties":{"id":"20240612085701-62c9jvt","updated":"20240612085701"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240612085701-6au6cqq","Type":"NodeParagraph","Properties":{"id":"20240612085701-6au6cqq","updated":"20240612085701"},"Children":[{"Type":"NodeText","Data":"主伤中，五劳六极，羸瘦，崩中，脉绝，补虚益气。"}]},{"ID":"20240612085701-rk4pvn6","Type":"NodeParagraph","Properties":{"id":"20240612085701-rk4pvn6","updated":"20240612085701"},"Children":[{"Type":"NodeText","Data":"叶主除寒热出汗。桑耳黑者，主女子漏下，赤白汁，血病，症瘕积聚，阴补阴阳，寒热，无子。五木耳名糯，益气不饥，轻身强志。生山谷。"}]},{"ID":"20240612085701-7taijak","Type":"NodeParagraph","Properties":{"id":"20240612085701-7taijak","updated":"20240612085701"},"Children":[{"Type":"NodeText","Data":"《名医》曰：桑耳一名桑菌，一名木麦，生犍为，六月多雨时采，即暴干。"}]},{"ID":"20240612085701-61sdoe9","Type":"NodeParagraph","Properties":{"id":"20240612085701-61sdoe9","updated":"20240612085701"},"Children":[{"Type":"NodeText","Data":"案《说文》云：桑，蚕所食叶，木（上卄中而下大），木耳也。蕈，桑（上卄中而下大）。《尔雅》云：桑瓣有葚栀。舍人云：桑树一半有葚，半无葚，名栀也。郭璞云：瓣，半也，又女桑，（木夷）桑。郭璞云：今俗呼桑树小而条长者，为女桑树，又（上厌下水）山桑。郭璞云：似桑材中作弓及草辕，又桑柳槐条。郭璞云：阿那垂条。"}]},{"ID":"20240612085711-abft2zx","Type":"NodeThematicBreak","Properties":{"id":"20240612085711-abft2zx"}},{"ID":"20240612085712-nfbjvie","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085712-nfbjvie","updated":"20240612085716"},"Children":[{"Type":"NodeText","Data":"桑根白皮《名医别录》"}]},{"ID":"20240612085712-8n6bng7","Type":"NodeParagraph","Properties":{"id":"20240612085712-8n6bng7","updated":"20240612085712"},"Children":[{"Type":"NodeText","Data":"无毒．主去肺中水气，止唾血，热渴，水肿，腹满，胪胀，利水道，去寸白，创．采无时，出土上者杀人．（续断、桂心、麻子为之使，叶汁解蜈蚣毒．）"}]},{"ID":"20240612085733-28u614q","Type":"NodeThematicBreak","Properties":{"id":"20240612085733-28u614q"}},{"ID":"20240612085734-0x9ezgy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085734-0x9ezgy","updated":"20240612085739"},"Children":[{"Type":"NodeText","Data":"桑根白皮《本草衍义》"}]},{"ID":"20240612085734-nzvlfel","Type":"NodeParagraph","Properties":{"id":"20240612085734-nzvlfel","updated":"20240612085734"},"Children":[{"Type":"NodeText","Data":"桑根白皮条中，桑之用稍多，然独遗乌椹，桑之精英尽在于此。采摘，微研，以布滤去滓，石器中熬成稀膏，量多少入蜜，再熬成稠膏，贮瓷器中。每抄一二钱，食后、夜卧，以沸汤点服。治服金石发热渴，生精神，及小肠热，性微凉。"}]},{"ID":"20240612085721-6kbtu4s","Type":"NodeThematicBreak","Properties":{"id":"20240612085721-6kbtu4s"}},{"ID":"20240612085722-3f3dqbe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085722-3f3dqbe","updated":"20240612085727"},"Children":[{"Type":"NodeText","Data":"桑根白皮《本经逢原》"}]},{"ID":"20240612085722-ot3t001","Type":"NodeParagraph","Properties":{"id":"20240612085722-ot3t001","updated":"20240612085722"},"Children":[{"Type":"NodeText","Data":"甘寒无毒。须蜜酒相和拌令湿透，炙熟用。否则伤肺泄气，大不利人。根见土面者有毒伤人。"}]},{"ID":"20240612085722-90z1u4i","Type":"NodeParagraph","Properties":{"id":"20240612085722-90z1u4i","updated":"20240612085722"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"桑根白皮泻肺气之有余，止嗽而能利水。肺中有水气及肺火有余者宜之。肺虚无火，因风寒而嗽者服之，风邪反闭固不散而成久嗽者有之。甄权治肺中水气，唾血，热渴水肿，腹满胪胀，利水道，去寸白虫。可以缝金疮，缝后以热鸡血涂之，桑皮之功用尽矣。"}]},{"ID":"20240612085605-eku4cog","Type":"NodeThematicBreak","Properties":{"id":"20240612085605-eku4cog"}},{"ID":"20240612085651-l0is03q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085651-l0is03q","updated":"20240612085655"},"Children":[{"Type":"NodeText","Data":"桑根白皮《顾松园医镜》"}]},{"ID":"20240612085651-ooqix7h","Type":"NodeParagraph","Properties":{"id":"20240612085651-ooqix7h","updated":"20240612085651"},"Children":[{"Type":"NodeText","Data":"〔甘寒，入肺经。刮去粗皮，蜜水炙。有涎出，勿去之。〕泻肺火而止喘定嗽，〔专泻肺中之伏火，若肺中有水气者，用之亦当。〕利小肠而消肿除胀。〔长于利小水，故能治水气肿胀。〕下气消痰，〔气降而痰亦降。〕除热止渴。〔甘寒除内热，而渴自止。〕桑叶〔甘寒〕除寒热而止汗出，〔甘能益血，寒能凉血，是以能止阴虚寒热，及因内热汗出也。〕治咳嗽而止消渴，〔治咳嗽者，下气之功，止渴者，益阴之功〕。益血祛风，〔血行风自灭也。〕明目长发，〔煎汤洗沐甚效。〕桑枝〔苦平〕治遍体风痒，〔性能祛风，久服终身不患偏风。〕疗四肢拘挛，〔以其能通利利关节也。故许学士患臂痛，诸药不应，服此数剂即愈。〕咳嗽能除，〔一少年咳嗽，百药不效，用南向桑枝。寸折煎汤，频饮而愈。〕香港脚可用。〔炒香水煎，空心服之。〕桑椹〔甘寒〕补血安神，生精止渴。"}]},{"ID":"20240612085651-bgcwplh","Type":"NodeParagraph","Properties":{"id":"20240612085651-bgcwplh","updated":"20240612085651"},"Children":[{"Type":"NodeText","Data":"桑皮泻火，肺虚无火，因风寒而咳嗽者勿服。"}]},{"ID":"20240612085605-ulimn1v","Type":"NodeThematicBreak","Properties":{"id":"20240612085605-ulimn1v"}},{"ID":"20240612085639-szyyzo9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085639-szyyzo9","updated":"20240612085645"},"Children":[{"Type":"NodeText","Data":"桑根白皮《要药分剂》"}]},{"ID":"20240612085639-ulivfz1","Type":"NodeParagraph","Properties":{"id":"20240612085639-ulivfz1","updated":"20240612085639"},"Children":[{"Type":"NodeText","Data":"味甘辛。性寒。无毒。得土金之气而生。降多于升。阳中阴也。续断、桂心、麻忌铁。"}]},{"ID":"20240612085639-2mwi3o8","Type":"NodeParagraph","Properties":{"id":"20240612085639-2mwi3o8","updated":"20240612085639"},"Children":[{"Type":"NodeText","Data":"【主治】主肺气喘满。伤中。五劳六极。（本经）去肺中水气。唾血热咳。水肿腹满胪胀。"}]},{"ID":"20240612085639-esrwqiz","Type":"NodeParagraph","Properties":{"id":"20240612085639-esrwqiz","updated":"20240612085639"},"Children":[{"Type":"NodeText","Data":"客忤。"}]},{"ID":"20240612085639-7ks94yu","Type":"NodeParagraph","Properties":{"id":"20240612085639-7ks94yu","updated":"20240612085639"},"Children":[{"Type":"NodeText","Data":"出汗水气颂）【归经】入肺经。为清金之品。（兼燥剂辛泻肺邪有余而止嗽甘固元气不足而补虚）【前论】罗谦甫曰。桑皮泻肺。是泻肺中火邪。非泻肺气也。火与元气不两立。火去则气得火入【禁忌】经疏曰。凡肺虚无火。因寒袭之而咳嗽者。勿用桑皮。"}]},{"ID":"20240612085606-2yerfl4","Type":"NodeThematicBreak","Properties":{"id":"20240612085606-2yerfl4"}},{"ID":"20240612085627-eb65ng5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085627-eb65ng5","updated":"20240612085632"},"Children":[{"Type":"NodeText","Data":"桑根白皮《千金翼方》"}]},{"ID":"20240612085627-l5hpxa5","Type":"NodeParagraph","Properties":{"id":"20240612085627-l5hpxa5","updated":"20240612085627"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主伤中五劳六极，羸瘦，崩中脉绝，补虚益气，去肺中水气，唾血热渴，水肿，腹满胪胀，利水道，去寸白，可以缝金疮，采无时，出土上者杀人。叶∶主除寒热出汗。汁∶解蜈蚣毒。"}]},{"ID":"20240612085606-xxmlrok","Type":"NodeThematicBreak","Properties":{"id":"20240612085606-xxmlrok"}},{"ID":"20240612085618-6ka77tm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085618-6ka77tm","updated":"20240612085622"},"Children":[{"Type":"NodeText","Data":"桑根白皮《新修本草》"}]},{"ID":"20240612085618-6fdjxvb","Type":"NodeParagraph","Properties":{"id":"20240612085618-6fdjxvb","updated":"20240612085618"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主伤中五劳六极，羸瘦，崩中，脉绝，补虚，益气。去肺中水气，止唾血，热渴，水肿，腹满，颅胀，利水道，去寸白，可以缝创。采无时。出土上者杀人。续断、桂心、麻子为之使。叶，主除寒热，出汗。汁，解蜈蚣毒。"}]},{"ID":"20240612085618-ckyvcou","Type":"NodeParagraph","Properties":{"id":"20240612085618-ckyvcou","updated":"20240612085618"},"Children":[{"Type":"NodeText","Data":"桑耳，味甘，有毒。黑者，主女子漏下赤白汁，血病，症瘕积聚，腹痛，阴阳寒热无子，疗止久泄，益气不饥。其金色者，疗 痹饮，积聚，腹病，金创。"}]},{"ID":"20240612085618-psf2q4u","Type":"NodeParagraph","Properties":{"id":"20240612085618-psf2q4u","updated":"20240612085618"},"Children":[{"Type":"NodeText","Data":"一名桑茵，一名木麦。五木耳名 ，益气不饥，轻身强志。生犍为山谷。六月多雨时采木耳，即曝干。"}]},{"ID":"20240612085618-j5vf8c2","Type":"NodeParagraph","Properties":{"id":"20240612085618-j5vf8c2","updated":"20240612085618"},"Children":[{"Type":"NodeText","Data":"东行桑根乃易得，而江边多出土，不可轻信。桑耳，《断谷方》云∶木 又呼为桑上寄生，此云五木耳，而不显四者是何木？案老桑树生燥耳，有黄、赤、白者，又多雨时亦生软湿者，人采以作菹，皆无复药用。"}]},{"ID":"20240612085618-t9y4zp6","Type":"NodeParagraph","Properties":{"id":"20240612085618-t9y4zp6","updated":"20240612085618"},"Children":[{"Type":"NodeText","Data":"〔谨案〕柠耳，人常食；槐耳，用疗痔；榆、柳、桑耳，此为五耳，软者并堪啖。桑椹，味甘，寒，无毒，单食，主消渴；叶，味苦、甘，寒，有小毒。水煎灰等，同灭痣疵黑子，蚀恶肉。煮小豆，大下水胀。敷金创止血，生肌也。"}]},{"ID":"20240612085606-m06u8we","Type":"NodeThematicBreak","Properties":{"id":"20240612085606-m06u8we"}},{"ID":"20240612085607-syv73xq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085607-syv73xq","updated":"20240612085612"},"Children":[{"Type":"NodeText","Data":"桑根白皮《神农本草经读》"}]},{"ID":"20240612085607-95nr7uq","Type":"NodeParagraph","Properties":{"id":"20240612085607-95nr7uq","updated":"20240612085607"},"Children":[{"Type":"NodeText","Data":"气味甘、寒，无毒。主伤中，五劳六极，羸瘦，崩中绝脉，补虚益气。（旧本列为中品，今从《崇原》。）叶天士曰∶桑皮气寒，禀水气而入肾；味甘无毒，得土味而入脾。中者，中州脾也。脾为阴气之原，热则中伤，桑皮甘寒，故主伤中。五劳者，五脏劳伤真气也。六极者，六腑之气虚极也。脏腑俱虚，所以肌肉削而羸瘦也。其主之者，桑皮甘以固脾气而补不足，寒以清内热而退火邪，邪气退而脾阴充，脾主肌肉，自然肌肉丰而劳极愈矣。崩中者，血脱也；脉者，血之府；血脱故脉绝不来也。脾统血而为阴气之原，甘能益脾，所以主崩中绝脉也。火与元气势不两立，气寒清火，味甘益气，气充火退，虚得补而气受益也。"}]},{"ID":"20240612085607-l2glisw","Type":"NodeParagraph","Properties":{"id":"20240612085607-l2glisw","updated":"20240612085607"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶今人以补养之药，误认为清肺利水之品，故用多不效。且谓生用大泻肺气，宜涂蜜炙之。然此药忌火，不可不知。"}]},{"ID":"20240612085607-0ap4dsc","Type":"NodeParagraph","Properties":{"id":"20240612085607-0ap4dsc","updated":"20240612085607"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶桑割而复茂，生长之气最盛，故补续之功如此。"}]},{"ID":"20240612085336-pe5mdkj","Type":"NodeThematicBreak","Properties":{"id":"20240612085336-pe5mdkj"}},{"ID":"20240612085546-awwqx1k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085546-awwqx1k","updated":"20240612085557"},"Children":[{"Type":"NodeText","Data":"桑根白皮《证类本草》"}]},{"ID":"20240612085546-yqw1wku","Type":"NodeParagraph","Properties":{"id":"20240612085546-yqw1wku","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主伤中，五劳六极，羸瘦，崩中脉绝，补虚益气，去肺中水气，唾血热渴，水肿腹满胪胀，利水道，去寸白，可以缝金疮。采无时。出土上者杀人。（续断、桂心、麻子为之使。）"}]},{"ID":"20240612085546-cy5up1w","Type":"NodeParagraph","Properties":{"id":"20240612085546-cy5up1w","updated":"20240612085546"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"主除寒热，出汗。汁解蜈蚣毒。"}]},{"ID":"20240612085546-m0649jg","Type":"NodeParagraph","Properties":{"id":"20240612085546-m0649jg","updated":"20240612085546"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桑耳"},{"Type":"NodeText","Data":"味甘，有毒。黑者主女子漏下赤白汁，血病症瘕积聚，阴痛，阴阳寒热，无子，疗月水不调。其黄熟陈白者，止久泄，益气，不饥。其金色者，治癖饮积聚，腹痛，金疮。一名桑菌，一名木麦蜀本麦作 （诠荀切）"}]},{"ID":"20240612085546-sk5enrg","Type":"NodeParagraph","Properties":{"id":"20240612085546-sk5enrg","updated":"20240612085546"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"五木耳"},{"Type":"NodeText","Data":"名 （音软），益气不饥，轻身强志。生犍为山谷。六月多雨时采，即曝干。"}]},{"ID":"20240612085546-3oraj04","Type":"NodeParagraph","Properties":{"id":"20240612085546-3oraj04","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶东行桑根乃易得，而江边多出土，不可轻信。桑耳断谷方云∶木 ，又呼为桑上寄生，此云五木耳。而不显四者是何木。按 老桑树，生燥耳。有黄者、赤白者，又多雨时，亦生软湿者。人采以作菹，皆无复药用。唐本注云∶楮耳，人常食；槐耳，用疗痔；榆、柳、桑耳；此为五耳。软者并堪啖。桑椹，味甘，寒，无毒。单食主消渴。叶，味苦、甘，寒，有少毒。水煎取浓汁，除香港脚水肿，利大小肠。灰，味辛，寒，有小毒。蒸淋取汁为煎，与冬灰等同灭志疵黑子，蚀恶肉，煮小豆大下水胀，敷金疮止血生肌也。今按陈藏器本草云∶桑叶汁，主霍乱腹痛吐下。冬月用干者浓煮服之，研取白汁合金疮，又主小儿吻疮。"}]},{"ID":"20240612085546-cr63y9o","Type":"NodeParagraph","Properties":{"id":"20240612085546-cr63y9o","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"细锉，大釜中煎，取如赤糖，去老风及宿血。叶桠者名鸡桑，最堪入用。椹，利五脏、关节，通血气。久服不饥。多收曝干。捣末蜜和为丸。每日服六十丸，变白不老。取黑椹一升，和科斗子一升，瓶盛封闭悬屋东头，一百日尽化为黑泥，染白鬓如漆。又取二七枚和胡桃脂研如泥，拔去白发，点孔中即生黑者。臣禹锡等谨按药性论云∶桑白皮，使，平。能治肺气喘满，水气浮肿，主伤绝，利水道，消水气，虚劳客热，头痛，内补不足。桑耳，使。一名桑臣，又名桑黄。味甘、辛，无毒。能治女子崩中带下，月闭血凝，产后血凝，男子 癖，兼疗伏血，下赤血。又云木耳，亦可单用，平。孟诜云∶寒，无毒。利五脏，宣肠胃气拥，毒气。不可多食，唯益服丹石人热发，和葱、豉作羹。萧炳云∶桑叶炙煮饮，止霍乱。孟诜云∶桑根白皮煮汁饮，利五脏。又入散用，下一切风气，水气。又云桑叶炙煎饮之，止渴，一如茶法。又云桑皮煮汁，可染褐色久不落，柴烧灰淋汁入炼，五金家用。日华子云∶桑白皮，温。调中下气，益五脏，消痰止渴，利大小肠，开胃下食，杀腹脏虫，止霍乱吐泻，此即出桑根皮。又云家桑东行根，暖，无毒。研汁治小儿天吊惊痫，客忤，及敷鹅口疮，大验。又云家桑叶，暖，无毒。利五脏，通关节，下气。煎服，除风痛出汗，并扑损瘀血，并蒸后 蛇虫蜈蚣咬，盐挪敷上。春叶未开枝可作煎，酒服治一切风。又云桑耳，温，微毒。止肠风泻血，妇人心腹痛。药性论云∶蕈耳亦可单用，平。古槐、桑树上者良。能治破血益力，其余树上多动风气，发痼疾，令人肋下急，损经络，背膊闷。又煮浆粥，安槐木上，草覆之，即生蕈，次柘木者良。孟诜云∶菌子，寒。发五脏风，拥经脉，动痔病，令人昏昏多睡，背膊四肢无力。又菌子有数般，槐树上生者良。野田中者，恐有毒，杀人。又多发冷气，令腹中微微痛。"}]},{"ID":"20240612085546-m5bkby7","Type":"NodeParagraph","Properties":{"id":"20240612085546-m5bkby7","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"图经曰∶桑根白皮，《本经》不着所出州土，今处处有之。采无时。不可用出土上者，用东行根益佳。或云木白皮亦可用。初采得，以铜刀剥去上粗皮，取其里白切焙干。其皮中青涎，勿使刮去，药力都在其上。恶铁及铅，不可近之。桑叶以夏秋再生者为上，霜后采之。"}]},{"ID":"20240612085546-s8q5ih7","Type":"NodeParagraph","Properties":{"id":"20240612085546-s8q5ih7","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"煮汤淋渫手足，去风痹殊胜。桑耳，一名桑黄。有黄熟陈白者，又有金色者，皆可用，碎切，酒煎，主带下。其实椹，有白、黑二种，曝干。皆主变白发。皮上白藓，花亦名桑花，状似地钱。刀削取炒干，以止衄、吐血等。其柴烧灰淋汁，医家亦多用之。桑上蠹虫，主暴心痛，金疮肉生不足。皮中白汁主小儿口疮，敷之便愈。又以涂金刃所伤燥痛，须臾血止，更剥白皮裹之，令汁得入疮中，良。冬月用根皮皆验。白皮作线，以缝金创肠出者，更以热鸡血涂之。唐·安金藏剖腹用此法，便愈。桑条作煎见《近效方》。云∶桑煎疗水气，肺气，香港脚，痈肿兼风气。桑条二两，用大秤七两，一物细切如豆，以水一大升，煎取三大合，如欲得多造，准此增加，先熬令香，然后煎。每服肚空时吃，或茶汤、或羹粥，每服半大升，亦无禁忌也。本方云∶桑枝，平。不冷不热，可以常服。疗遍体风痒干燥，香港脚，风气，四肢拘挛，上气，眼晕，肺气嗽，消食，利小便。久服轻身，聪明耳目，令人光泽，兼疗口干。《仙经》云∶一切仙药，不得桑煎不服。出《抱朴子》。本方∶桑枝一小升，细切熬令香，以水三大升，煎取二大升。一日服尽，无问食前后，此服只根据前方也。桑叶可常服。神仙服食方∶以四月桑茂盛时采叶，又十月霜后，三分二分已落时，一分在者，名神仙叶，即采取。"}]},{"ID":"20240612085546-3ub52bb","Type":"NodeParagraph","Properties":{"id":"20240612085546-3ub52bb","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"与前叶同阴干。捣末丸散任服，或煎以代茶饮。又采椹，曝干。和蜜食之，并令人聪明，安魂镇神。又炙叶，令微干。和桑衣煎服。治痢，亦主金创及诸损伤，止血。方书称桑之功最神，在人资用尤多。《尔雅》云∶桑辨有葚（与椹同），栀。郭璞云∶辨，半也。一半有葚，半无名曰栀。又云∶女桑， 桑。俗间呼桑木之小而条长者为女桑。又山桑木堪弓弩， 桑丝中琴瑟，皆材之美者也，他木鲜及焉。"}]},{"ID":"20240612085546-cxcuh9y","Type":"NodeParagraph","Properties":{"id":"20240612085546-cxcuh9y","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，十年以上向东畔嫩根，采得后，铜刀剥上青黄薄皮一重，只取第二重白嫩青涎者，于槐砧上用铜刀锉了，焙令干。勿使皮上涎落，涎是药力。此药恶铁并铅也。圣惠方∶治大风，头面髭发脱落。以桑柴灰热汤淋取汁洗头面（以大豆水研取浆，解泽灰味，弥佳）。次用熟水，入绿豆面濯之，取净。不遇十度良。三日一沐头，一日一洗面。外台秘要∶治偏风及一切风。桑枝锉一大升，用今年新嫩枝，以水一大斗，煎取二大升。夏用井中沉，恐酢坏。每日服一盏，空心服尽。又煎服终身，不患偏风，若预防风，能服一大升佳。"}]},{"ID":"20240612085546-ahgw4d6","Type":"NodeParagraph","Properties":{"id":"20240612085546-ahgw4d6","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"又方∶脉极寒，发鬓堕落，令发润生。桑白皮二升，以水淹浸，煮五、六沸去滓，洗沐鬓发自不落。又方∶五痔。以桑耳作羹，空心下饭饱食之，日三食之。待孔卒痛如乌啄，取大小豆各一升，合捣作两囊蒸之及热，更互坐之，即瘥。千金方∶治口疮白漫漫。取桑树汁，先以发拭口，次以汁敷之。又方八月、九月中刺，手足犯恶露肿，多杀人。以桑枝三条，纳灰中炮令极热，破断，以头柱疮口上，令热尽即易之。尽二条，则疮自烂，仍取韭白敷疮上，以布帛急裹之。若有肿者更作，用薤白佳。肘后方∶治人少小鼻衄，小劳辄出。桑耳无多少，熬令焦，捣末。每衄发，辄以杏仁大塞鼻，数度即可断。《深师方》同。葛氏方∶卒小便多，消渴。入地三尺取桑根，剥取白皮，炙令黄黑，锉，以水煮之令浓，随意饮之，亦可纳少米，勿入盐。又方∶产后下血不止，炙桑白皮煮水饮之。又方∶血露不绝。锯截桑根，取屑五指撮，取醇酒服之。日三。又方∶因疮而肿者，皆因中水浸中风寒所作，其肿入腹则杀人。多以桑灰淋汁渍，冷复易，取愈。《梅师方》同。又方∶饮食中蛊毒，令人腹内坚痛，面黄青，淋露骨立，病变无常。取桑木心，锉得一槲，着釜中以水淹之，令上有三斗水，煮取二斗，澄取清，微火煎，得五升。宿勿食，旦服五合，则吐蛊毒出。梅师方∶治水肿，坐卧不得，头面身体悉肿。取东引花桑枝，烧灰淋汁，煮赤小豆。空心食令饱，饥即食尽，不得吃饮。"}]},{"ID":"20240612085546-e1qztxk","Type":"NodeParagraph","Properties":{"id":"20240612085546-e1qztxk","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"又方∶治金疮止痛。取桑柴灰研敷疮上，佳。经验方∶治咳嗽甚者，或有吐血殷鲜。桑根白皮一斤，米泔浸三宿，净刮上黄皮，锉细，入糯米四两，焙干。一处捣为末。"}]},{"ID":"20240612085546-so72bwa","Type":"NodeParagraph","Properties":{"id":"20240612085546-so72bwa","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"每服米饮调下一、两钱。又方∶治青盲，此一法当根据而用之，视物如鹰鹘，有此效。正月八、二月八、三月六、四月六、五月五、六月二、七月七、八月二十五、九月十二、十月十二、十一月二十六、十二月晦，每遇上件神日，用桑柴灰一合，以煎汤沃之，于瓷器中澄令极清，以药汁稍热洗之。如觉冷，即重汤煮令得所，不住手洗，遇上件日不得不洗，缘此神日本法也。经验后方治肺毒疮如大风疾。绿云散∶以桑叶好者，净洗过，熟蒸一宿，候晒干曝为末。水调二钱匕服。又方∶坠马拗损。以桑根白皮五斤为末，水一升煎成膏，敷于损处，便止。"}]},{"ID":"20240612085546-prfuyd7","Type":"NodeParagraph","Properties":{"id":"20240612085546-prfuyd7","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"以后亦无宿血，终不发动。广利方治泻血不止。桑耳一大两，熬令黑，以水一大升三合，煎取六大合，去滓。空心分温三服。又方∶治蛇咬疮，桑树白皮汁敷之瘥。又方∶治金疮。"}]},{"ID":"20240612085546-er9wo12","Type":"NodeParagraph","Properties":{"id":"20240612085546-er9wo12","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"取新桑白皮烧灰和马粪涂疮上，数易之。胜金方∶治小儿渴。用桑叶不拘多少，用生蜜逐叶上敷过，将线系叶蒂上绷，阴干细切，用水煎汁。服之瘥。钱相公箧中方∶治蜈蚣及蜘蛛毒。"}]},{"ID":"20240612085546-ix46321","Type":"NodeParagraph","Properties":{"id":"20240612085546-ix46321","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"取桑白皮汁敷之，效。子母秘录∶治落胎下血不止。以桑木中蝎虫烧末，酒服方寸匕，日二服。又方∶小儿重舌。桑白皮煮汁，涂乳饮之。又方小儿鹅口，桑白皮汁和胡粉敷之。杨氏产乳∶凡子不得与桑椹子食，令儿心寒。宫气方∶治小儿舌上生疮如粥皮。桑白皮汁敷之，三、两度瘥。仙方桑椹熟时，收之晒干。为末，蜜和丸桐子大。空心酒服四十丸，长服之良。"}]},{"ID":"20240612085546-0syuhlf","Type":"NodeParagraph","Properties":{"id":"20240612085546-0syuhlf","updated":"20240612085546"},"Children":[{"Type":"NodeText","Data":"史记∶桑树根旁行出地者，各为伏蛇。治心痛一绝。《本经》云∶桑根出土者杀人。此用治心痛，宜更研访。毛诗泮水篇云∶食我桑椹，怀我好音。氓诗无食桑葚，注∶葚，桑实也。食过则醉，伤其性。丹房镜源桑灰结汞。"}]},{"ID":"20240612085546-ghyu7ik","Type":"NodeParagraph","Properties":{"id":"20240612085546-ghyu7ik","updated":"20240612085754"},"Children":[{"Type":"NodeText","Data":"衍义曰∶桑根白皮条中言∶桑之用稍备；然独遗乌椹，桑之精英尽在于此。采摘，微研，以布滤去滓，石器中熬成稀膏，量多少入蜜，再熬成稠膏，贮瓷器中。每抄一、二钱，食后、夜卧，以沸汤点服。治服金石发热渴，生精神，及小肠热，性微凉。"}]},{"ID":"20240612085837-q285li9","Type":"NodeThematicBreak","Properties":{"id":"20240612085837-q285li9"}},{"ID":"20240612085839-aojuwra","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612085839-aojuwra","updated":"20240612085919"},"Children":[{"Type":"NodeText","Data":"桑根白皮《本草图经》"}]},{"ID":"20240612085839-jxqst6z","Type":"NodeParagraph","Properties":{"id":"20240612085839-jxqst6z","updated":"20240612085921"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桑根白皮"},{"Type":"NodeText","Data":"，《本经》不着所出州土，今处处有之。采无时。不可用出土上者，用东行根益佳，或云木白皮亦可用。初采得，以铜刀剥去上粗皮，其取里白，切，焙干。其皮中青涎勿使刮去，药力都在其上。恶铁及铅，不可近之。桑叶以夏秋再生者为上，霜后采之，煮汤淋渫手足，去风痹殊胜。桑耳，一名桑黄，有黄熟陈白者，又有金色者，皆可用。碎切，酒煎，主带下。其实，椹。有白、黑二种，曝干，皆主变白发，皮上白藓。花，亦名桑花，状似地钱，刀削取，炒干，以止衄、吐血等。其柴烧灰淋汁，医家亦多用之。桑上蠹虫，主暴心痛，金疮肉生不足。皮中白汁，主小儿口疮，傅之便愈，又以涂金刃所伤，燥痛须臾血止。更剥白皮裹之，令汁得入疮中良。冬月用根皮皆验。白皮作线，以缝金创肠出者，更以热鸡血涂之。"}]},{"ID":"20240612085839-jppe3wz","Type":"NodeParagraph","Properties":{"id":"20240612085839-jppe3wz","updated":"20240612085839"},"Children":[{"Type":"NodeText","Data":"唐·安金藏剖腹，用此法便愈。桑条作煎，见近效方。云桑煎疗水气、肺气、香港脚、痈肿兼风气。桑条二两，用大秆六两，一物细切如豆，以水一大升，煎取三大合，如欲得多造，准此增加。先熬令香，然后煎。每服，肚空时吃，或茶汤，或羹粥，每服半大升。亦无禁忌也。本方云桑枝，平，不冷不热，可以常服。疗遍体风痒干燥，香港脚风气，四肢拘挛，上气眼晕，肺气嗽，消食，利小便。久服轻身，聪明耳目，令人光泽，兼疗口干。《仙经》云∶一切仙药，不得桑煎不服。出《抱朴子》。本方桑枝一小升，细切，熬令香，以水三大升，煎取二大升，一日服尽，无问食前后，此服只依前方也。桑叶可常服，神仙服食方，以四月桑茂盛时采叶。又十月霜后，三分二分已落时，一分在者，名神仙叶，即采取与前叶同阴干，捣末，丸、散任服，或煎以代茶饮。又采椹曝干，和蜜食之，并令人聪明，安魂镇神。又炙叶令微干，和桑衣煎服，治痢，亦主金创及诸损伤。止血方书∶称桑之功最神，在人资用尤多。《尔雅》云∶桑辨有葚（与椹同）、栀。郭璞云∶辨半也，一半有葚，半无，名曰栀。又云∶女桑、 桑，俗间呼桑木之小而条长者为女桑。又山桑，木堪弓弩。 桑丝中琴瑟，皆材之美者也，他木鲜及焉。"}]},{"ID":"20240612085826-1vgz1xy","Type":"NodeThematicBreak","Properties":{"id":"20240612085826-1vgz1xy"}},{"ID":"20240612085827-cx9kre4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085827-cx9kre4","updated":"20240612085914"},"Children":[{"Type":"NodeText","Data":"桑根白皮《本草经集注》"}]},{"ID":"20240612085827-umvwcp0","Type":"NodeParagraph","Properties":{"id":"20240612085827-umvwcp0","updated":"20240612085827"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主治伤中，五劳，六极，羸瘦，崩中，脉绝，补虚，益气。去肺中水气，止唾血，热渴，水肿，腹满，胪胀，利水道，去寸白，可以缝创。采无时。出土上者杀人。（续断、桂心、麻子为之使。）叶∶主除寒热，出汗。汁∶解蜈蚣毒。桑耳∶味甘，有毒。"}]},{"ID":"20240612085827-hi6udrt","Type":"NodeParagraph","Properties":{"id":"20240612085827-hi6udrt","updated":"20240612085827"},"Children":[{"Type":"NodeText","Data":"黑者，主女子漏下赤白汁，血病，症瘕积聚，腹痛，阴阳寒热无子，治月水不调。其黄熟陈白者，止久泄，益气不饥。其金色者，治 痹饮，积聚，腹病，金创。一名桑菌，一名木麦。"}]},{"ID":"20240612085827-lcdeksv","Type":"NodeParagraph","Properties":{"id":"20240612085827-lcdeksv","updated":"20240612085827"},"Children":[{"Type":"NodeText","Data":"五木耳∶名 ，益气，不饥，轻身，强志。生犍为山谷。六月多雨时采木耳，即曝干东行桑根乃易得，而江边多出土，不可轻信。桑耳，《断谷方》云∶木 又呼为桑上寄生，此云五木耳，而不显四者是何木？案老桑树生燥耳，有黄、赤、白者，又多雨时亦生软湿者，人采以作菹，皆无复药用。"}]},{"ID":"20240612085814-ef707qz","Type":"NodeThematicBreak","Properties":{"id":"20240612085814-ef707qz"}},{"ID":"20240612085815-2231z3b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085815-2231z3b","updated":"20240612085819"},"Children":[{"Type":"NodeText","Data":"桑白皮《本草害利》"}]},{"ID":"20240612085815-i3mtyf1","Type":"NodeParagraph","Properties":{"id":"20240612085815-i3mtyf1","updated":"20240612085815"},"Children":[{"Type":"NodeText","Data":"〔害〕甘寒泻肺，肺中有水气，及肺火有余者宜之。性不纯良，不宜多用，肺虚无火而小便自利者，及因风寒而发咳嗽者勿服。桑根见地上者，名马额，有毒杀人。"}]},{"ID":"20240612085815-dqsh7i1","Type":"NodeParagraph","Properties":{"id":"20240612085815-dqsh7i1","updated":"20240612085815"},"Children":[{"Type":"NodeText","Data":"〔利〕甘辛而寒，泻肺金之有余，止咳定喘，疏小肠之闭滞，逐水宽膨、消肿，治肤胀，散瘀血，主降气，能止渴下气清痰。"}]},{"ID":"20240612085815-j31gexw","Type":"NodeParagraph","Properties":{"id":"20240612085815-j31gexw","updated":"20240612085815"},"Children":[{"Type":"NodeText","Data":"〔修治〕采无时，凡使采十年以上，向东畔嫩根，铜刀刮去青黄薄皮一重。取里白皮切焙干用，或蜜炙入药，其皮中涎勿去之，但药力俱在其上也。忌铁及铅。"}]},{"ID":"20240612085803-b056x6o","Type":"NodeThematicBreak","Properties":{"id":"20240612085803-b056x6o"}},{"ID":"20240612085805-138wkd3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085805-138wkd3","updated":"20240612085809"},"Children":[{"Type":"NodeText","Data":"桑白皮《医学入门》"}]},{"ID":"20240612085805-oei8ns7","Type":"NodeParagraph","Properties":{"id":"20240612085805-oei8ns7","updated":"20240612085805"},"Children":[{"Type":"NodeText","Data":"桑（白）皮甘涩寒无毒，泻肺客热嗽痰红，去肺邪水消浮满，益肺元气主伤中。"}]},{"ID":"20240612085805-fgvdnnn","Type":"NodeParagraph","Properties":{"id":"20240612085805-fgvdnnn","updated":"20240612085805"},"Children":[{"Type":"NodeText","Data":"桑字从 从木，众手采取之形。叶可食蚕，根皮入药，入手太阴经。泻肺客热有余，喘嗽烦渴，痰中见红，去肺中邪水，浮肿腹满利水道，益肺元气不足。内伤羸瘦崩中脉绝，兼去寸白虫。作线可缝金疮，更以热鸡血涂之。采土内东行嫩根去骨，铜刀刮去薄皮，勿令皮上涎落，利水生用，咳嗽蜜蒸或炒。出土者杀人。续断、桂心、麻子为使，忌铁与铅。桑皮中白汁，主小儿口疮及鹅口舌上生疮，敷之神效。又涂刀伤燥痛，须臾血止，更剥白皮裹之，令汁入疮中良。蛇咬，蜈蚣、蜘蛛毒敷之效。桑叶，主除寒热风痛、霍乱腹痛，盐捣敷治蛇虫蜈蚣咬，遍身汗出，乘露采叶，焙为末，空心米饮下二钱。桑枝平，细锉炒香，水煎浓汁服之，疗偏体风痒干燥，香港脚风气拘挛，肺嗽口干，利小便，久服轻身，聪明耳目，令人光泽，暑月遇渴即饮。一学士常病两臂痛，诸药不效，服此寻愈，凡服一月见效。桑耳，味甘。有毒。黑者主女子漏下赤白，血痛 瘕，阴痛无子；黄熟陈白者，止久泄益气；金色者，治癖饮、积聚、腹痛、金疮。桑椹晒干捣末，蜜丸服。止消渴，治金石发热。"}]},{"ID":"20240612085336-oj42y9s","Type":"NodeThematicBreak","Properties":{"id":"20240612085336-oj42y9s"}},{"ID":"20240612085531-ujc0vb7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085531-ujc0vb7","updated":"20240612085536"},"Children":[{"Type":"NodeText","Data":"桑根白皮《本草崇原》"}]},{"ID":"20240612085531-50dc3rp","Type":"NodeParagraph","Properties":{"id":"20240612085531-50dc3rp","updated":"20240612085531"},"Children":[{"Type":"NodeText","Data":"气味甘寒，无毒。主治伤中，五劳六极，羸瘦崩中，绝脉，补虚，益气。（《纲目》误书中品，夫桑上之寄生得列上品，岂桑反在中品也，今改入上品。）"}]},{"ID":"20240612085531-42pgekw","Type":"NodeParagraph","Properties":{"id":"20240612085531-42pgekw","updated":"20240612085531"},"Children":[{"Type":"NodeText","Data":"（桑处处有之，而江浙独盛。二月发叶，深秋黄陨，四月椹熟，其色赤黑，味甘性温。）"}]},{"ID":"20240612085531-qi2k6s7","Type":"NodeParagraph","Properties":{"id":"20240612085531-qi2k6s7","updated":"20240612085531"},"Children":[{"Type":"NodeText","Data":"桑名白桑，落叶后望之，枝干皆白，根皮作纸，洁白而绵，蚕食桑精，叶丝如银，盖得阳明金精之气。阳明属金而兼土，故味甘。阳明主燥而金气微寒，故气寒，主治伤中，续经脉也。五劳，志劳，思劳、烦劳、忧劳、恚劳也。六极，气极、血极、筋极、骨极、肌极、精极也。羸瘦者，肌肉消减。崩中者，血液下注。脉绝者，脉络不通。桑皮禀阳明土金之气，刈而复茂，生长之气最盛，故补续之功如此。"}]},{"ID":"20240612085336-rt0ouw2","Type":"NodeThematicBreak","Properties":{"id":"20240612085336-rt0ouw2"}},{"ID":"20240612085457-54egbro","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085457-54egbro","updated":"20240612085502"},"Children":[{"Type":"NodeText","Data":"桑白皮《中药学》"}]},{"ID":"20240612085457-9w8hwfs","Type":"NodeParagraph","Properties":{"id":"20240612085457-9w8hwfs","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【药用】本品为桑科植物桑的根皮。"}]},{"ID":"20240612085457-4l77d4o","Type":"NodeParagraph","Properties":{"id":"20240612085457-4l77d4o","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，寒。入肺经。"}]},{"ID":"20240612085457-6adke4d","Type":"NodeParagraph","Properties":{"id":"20240612085457-6adke4d","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【功效】泻肺平喘，行水消肿。"}]},{"ID":"20240612085457-o2ky4nm","Type":"NodeParagraph","Properties":{"id":"20240612085457-o2ky4nm","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肺热咳嗽，喘逆痰多等症。"}]},{"ID":"20240612085457-nuxfamr","Type":"NodeParagraph","Properties":{"id":"20240612085457-nuxfamr","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"本品能泻肺热而下气平喘，故适用于肺热喘咳，如喘咳而兼身热者，常与地骨皮、黄芩、生甘草等配合应用。"}]},{"ID":"20240612085457-94gsfcf","Type":"NodeParagraph","Properties":{"id":"20240612085457-94gsfcf","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"2.用于面目浮肿、小便不利等症。"}]},{"ID":"20240612085457-wel3as7","Type":"NodeParagraph","Properties":{"id":"20240612085457-wel3as7","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"桑白皮有利尿消肿作用，用治面目浮肿、小便不利等症，常与生苡仁、茯苓、泽泻、车前子等配合应用。"}]},{"ID":"20240612085457-2ig849x","Type":"NodeParagraph","Properties":{"id":"20240612085457-2ig849x","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【处方用名】桑白皮（洗净，晒干，切碎用）"}]},{"ID":"20240612085457-79uyslj","Type":"NodeParagraph","Properties":{"id":"20240612085457-79uyslj","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240612085457-8ox8ik8","Type":"NodeParagraph","Properties":{"id":"20240612085457-8ox8ik8","updated":"20240612085457"},"Children":[{"Type":"NodeText","Data":"【方剂举例】泻肺散：地骨皮、桑白皮、生甘草、粳米。治肺热喘咳。"}]},{"ID":"20240612085336-zrb4ud5","Type":"NodeThematicBreak","Properties":{"id":"20240612085336-zrb4ud5"}},{"ID":"20240612085411-w34u5ql","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085411-w34u5ql","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"《中国药典》：桑白皮"}]},{"ID":"20240612085411-z5ihebk","Type":"NodeParagraph","Properties":{"id":"20240612085411-z5ihebk","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612085411-wq5c9qy","Type":"NodeParagraph","Properties":{"id":"20240612085411-wq5c9qy","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" Sānɡ Bái Pí"}]},{"ID":"20240612085411-d8z68xs","Type":"NodeParagraph","Properties":{"id":"20240612085411-d8z68xs","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612085411-9cl6ysz","Type":"NodeParagraph","Properties":{"id":"20240612085411-9cl6ysz","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 桑根皮"}]},{"ID":"20240612085411-escihh7","Type":"NodeParagraph","Properties":{"id":"20240612085411-escihh7","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612085411-3k9l948","Type":"NodeParagraph","Properties":{"id":"20240612085411-3k9l948","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" CORTEX MORI"}]},{"ID":"20240612085411-ikx9btp","Type":"NodeParagraph","Properties":{"id":"20240612085411-ikx9btp","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612085411-zwxkdo0","Type":"NodeParagraph","Properties":{"id":"20240612085411-zwxkdo0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 本品为桑科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桑"},{"Type":"NodeText","Data":"Morus alba L.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。秋末叶落时至次春发芽前采挖根部，刮去黄棕色粗皮，纵向剖开，剥取根皮，晒干。"}]},{"ID":"20240612085411-oxetnop","Type":"NodeParagraph","Properties":{"id":"20240612085411-oxetnop","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612085411-4obutvd","Type":"NodeParagraph","Properties":{"id":"20240612085411-4obutvd","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 本品呈扭曲的卷筒状、槽状或板片状，长短宽窄不一，厚1～4mm。外表面白色或淡黄白色，较平坦，有的残留橙黄色或棕黄色鳞片状粗皮；内表面黄白色或灰黄色，有细纵纹。体轻，质韧，纤维性强，难折断，易纵向撕裂，撕裂时有粉尘飞扬。气微，味微甘。"}]},{"ID":"20240612085411-q7jd6l7","Type":"NodeParagraph","Properties":{"id":"20240612085411-q7jd6l7","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612085411-hzrag7m","Type":"NodeParagraph","Properties":{"id":"20240612085411-hzrag7m","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮，防蛀。"}]},{"ID":"20240612085411-tm3keiu","Type":"NodeParagraph","Properties":{"id":"20240612085411-tm3keiu","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612085411-2o5vvyu","Type":"NodeParagraph","Properties":{"id":"20240612085411-2o5vvyu","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桑白皮"},{"Type":"NodeText","Data":"：洗净，稍润，切丝，干燥。"}]},{"ID":"20240612085411-deyroj2","Type":"NodeParagraph","Properties":{"id":"20240612085411-deyroj2","updated":"20240612085411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜜桑白皮"},{"Type":"NodeText","Data":"：取桑白皮丝，照蜜炙法（附录Ⅱ D）炒至不粘手。"}]},{"ID":"20240612085411-j14kdpx","Type":"NodeParagraph","Properties":{"id":"20240612085411-j14kdpx","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612085411-yh93u67","Type":"NodeParagraph","Properties":{"id":"20240612085411-yh93u67","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：韧皮部射线宽2～6列细胞；散有乳管；纤维单个散在或成束，非木化或微木化；薄壁细胞含淀粉粒，有的细胞含草酸钙方晶。较老的根皮中，散在夹有石细胞的厚壁细胞群，胞腔大多含方晶。粉末淡灰黄色。纤维甚多，多碎断，直径13～26μm ，壁厚，非木化至微木化，孔沟不明显。草酸钙方晶直径11～32μm 。石细胞类圆形、类方形或形状不规则，直径22～52μm ，壁较厚或极厚，纹孔及孔沟明显，胞腔内有的含方晶。另有含晶厚壁细胞，纹孔不明显。淀粉粒甚多，类圆形，直径4～16μm。"}]},{"ID":"20240612085411-e0yejbk","Type":"NodeParagraph","Properties":{"id":"20240612085411-e0yejbk","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加饱和碳酸钠溶液20ml，超声处理20分钟，滤过，滤液加稀盐酸调节pH值至1～2，静置30分钟，滤过，滤液用醋酸乙酯振摇提取2次，每次10ml，合并醋酸乙酯液，蒸干，残渣加甲醇1ml使溶解。作为供试品溶液。另取桑白皮对照药材2g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一聚酰胺薄膜上，以醋酸为展开剂，展开约10cm，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同的两个荧光主斑点。"}]},{"ID":"20240612085411-bw3lq47","Type":"NodeParagraph","Properties":{"id":"20240612085411-bw3lq47","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612085411-4y322ru","Type":"NodeParagraph","Properties":{"id":"20240612085411-4y322ru","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 归肺经。"}]},{"ID":"20240612085411-gyzzssd","Type":"NodeParagraph","Properties":{"id":"20240612085411-gyzzssd","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612085411-p2hzi37","Type":"NodeParagraph","Properties":{"id":"20240612085411-p2hzi37","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240612085411-rys2fia","Type":"NodeParagraph","Properties":{"id":"20240612085411-rys2fia","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612085411-6q939i3","Type":"NodeParagraph","Properties":{"id":"20240612085411-6q939i3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 泻肺平喘，利水消肿。用于肺热喘咳，水肿胀满尿少，面目肌肤浮肿。"}]},{"ID":"20240612085411-kqi7g85","Type":"NodeParagraph","Properties":{"id":"20240612085411-kqi7g85","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612085411-6obzc9r","Type":"NodeParagraph","Properties":{"id":"20240612085411-6obzc9r","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240612085411-a7eyabk","Type":"NodeParagraph","Properties":{"id":"20240612085411-a7eyabk","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612085411-edpov5q","Type":"NodeParagraph","Properties":{"id":"20240612085411-edpov5q","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612085411-fcerk7c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085411-fcerk7c","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：桑白皮"}]},{"ID":"20240612085411-25mqsr7","Type":"NodeParagraph","Properties":{"id":"20240612085411-25mqsr7","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612085411-ua2cccb","Type":"NodeParagraph","Properties":{"id":"20240612085411-ua2cccb","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" Sānɡ Bái Pí"}]},{"ID":"20240612085411-7k9zurc","Type":"NodeParagraph","Properties":{"id":"20240612085411-7k9zurc","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612085411-iztzux9","Type":"NodeParagraph","Properties":{"id":"20240612085411-iztzux9","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 桑根白皮（《本经》），桑根皮、桑皮（孟诜），白桑皮（《山西中药志》）。"}]},{"ID":"20240612085411-pcw0f1z","Type":"NodeParagraph","Properties":{"id":"20240612085411-pcw0f1z","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612085411-1khxr8e","Type":"NodeParagraph","Properties":{"id":"20240612085411-1khxr8e","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 《药性论》"}]},{"ID":"20240612085411-s8zpx7l","Type":"NodeParagraph","Properties":{"id":"20240612085411-s8zpx7l","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612085411-upmu5lf","Type":"NodeParagraph","Properties":{"id":"20240612085411-upmu5lf","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 为桑科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桑"},{"Type":"NodeText","Data":"除"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"去栓皮的根皮"},{"Type":"NodeText","Data":"。冬季采挖，洗净，趁新鲜刮去背棕色栓皮，纵向剖开，以木槌轻击，使皮部与木心分离，剥取白皮，晒干。"}]},{"ID":"20240612085411-sig53ba","Type":"NodeParagraph","Properties":{"id":"20240612085411-sig53ba","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612085411-d35drwm","Type":"NodeParagraph","Properties":{"id":"20240612085411-d35drwm","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 主产安徽、河南、浙江、江苏、湖南等地；其他各地亦产。"}]},{"ID":"20240612085411-3wz7iq5","Type":"NodeParagraph","Properties":{"id":"20240612085411-3wz7iq5","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612085411-sfpccgg","Type":"NodeParagraph","Properties":{"id":"20240612085411-sfpccgg","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 干燥根皮多呈长而扭曲的板状，或两边向内卷曲成槽状。长短宽狭不一，厚1～5毫米。外表面淡黄白色或近白色，有少数棕黄色或红黄色斑点，较平坦，有纵向裂纹及稀疏的纤维。内表面黄白色或灰黄色，平滑，有细纵纹，或纵向裂开，霉出纤维。体轻，质韧，难折断，易纵裂，撕裂时有白色粉尘飞出。微有豆腥气，味甘微苦。以色白、皮厚、粉性足者为佳。"}]},{"ID":"20240612085411-z2uwyp8","Type":"NodeParagraph","Properties":{"id":"20240612085411-z2uwyp8","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612085411-36qv6ka","Type":"NodeParagraph","Properties":{"id":"20240612085411-36qv6ka","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 含伞形花内酯、东莨菪素和黄酮成分桑根皮素、桑素、桑色烯、环桑素、环桑色烯等。又含有作用类似乙酰胆碱的降压成分，并含鞣质5.6％，粘液素9％。"}]},{"ID":"20240612085411-xlhn01f","Type":"NodeParagraph","Properties":{"id":"20240612085411-xlhn01f","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612085411-2cc7tz1","Type":"NodeParagraph","Properties":{"id":"20240612085411-2cc7tz1","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" ①利尿作用"}]},{"ID":"20240612085411-l6tim17","Type":"NodeParagraph","Properties":{"id":"20240612085411-l6tim17","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"家兔以桑白皮煎剂2克/公斤灌胃，6小时内排尿量及其氯化物均有较显着增加，7～24小时恢复正常。"}]},{"ID":"20240612085411-v4024wc","Type":"NodeParagraph","Properties":{"id":"20240612085411-v4024wc","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②降压作用"}]},{"ID":"20240612085411-oboo1en","Type":"NodeParagraph","Properties":{"id":"20240612085411-oboo1en","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"日人早年即报告桑树煎剂给动物口服有轻微而缓慢的降压作用，又称必须用根或枝的皮方有降压效果，根及新梢叶则无作用。用乙醚、热水或温甲醇的提取液对兔皮下注射1克（生药）/公斤时，可使血压下降15～25毫米汞柱。从桑白皮中提得一种物质，给兔静脉注射10毫克/公斤，血压立即显着下降；切断颈迷走神经或颈椎，此作用仍存在。它能抑制离体蛙心、兴奋兔离体肠管，此等作用皆可被阿托品阻断，故推测可能是乙酰胆碱样物质。对兔耳血管有扩张作用，对蛙下肢血管则为收缩。能兴奋离体兔子宫，轻度促进兔耳下腺的分泌，注射（动脉或静脉）给药对猫瞬膜收缩并无影响，但如直接涂于颈交感神经节上，则可抑制电刺激节前纤维引起的瞬膜收缩。对水蛭背肌单用无作用，如先加依色林后再用，则可使水蛭背肌的紧张度有显著上升。此物质对小鼠静脉注射之半数致死量为32.7毫克/公斤。据日人报道，中国产桑白皮的提取物较日本产者降压作用强，毒性亦大，所含乙酰胆碱样物质的成分较多。"}]},{"ID":"20240612085411-obsjves","Type":"NodeParagraph","Properties":{"id":"20240612085411-obsjves","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240612085411-vjgmys0","Type":"NodeParagraph","Properties":{"id":"20240612085411-vjgmys0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"桑白皮提取物对小鼠有镇静作用。在狗身上，初步证明用桑白皮线缝合之伤口可无需拆线。"}]},{"ID":"20240612085411-74jtnlk","Type":"NodeParagraph","Properties":{"id":"20240612085411-74jtnlk","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612085411-e3lori9","Type":"NodeParagraph","Properties":{"id":"20240612085411-e3lori9","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 桑皮：刷去灰屑，洗净，润透后切丝，晒干。蜜桑皮：取桑皮丝，加炼熟蜂蜜与开水少许，拌匀，稍闷，置锅内用文火炒至变为黄色、不粘手为度，取出，放凉。（每桑皮丝100斤，用炼熟蜂蜜30斤）"}]},{"ID":"20240612085411-j6lc29d","Type":"NodeParagraph","Properties":{"id":"20240612085411-j6lc29d","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使（桑白皮）采十年已上嫩根，铜刀剥上青黄薄皮一重，只取第二重白嫩青涎者，用铜刀锉了，焙令干，勿使皮上涎落，涎是药力。此药恶铁并铅。\""}]},{"ID":"20240612085411-3ec5qav","Type":"NodeParagraph","Properties":{"id":"20240612085411-3ec5qav","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612085411-371v5m8","Type":"NodeParagraph","Properties":{"id":"20240612085411-371v5m8","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 入肺、脾经。"}]},{"ID":"20240612085411-8hzxh0f","Type":"NodeParagraph","Properties":{"id":"20240612085411-8hzxh0f","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴经。\""}]},{"ID":"20240612085411-mfgh12f","Type":"NodeParagraph","Properties":{"id":"20240612085411-mfgh12f","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入脾、肺二经。\""}]},{"ID":"20240612085411-dy6qj1r","Type":"NodeParagraph","Properties":{"id":"20240612085411-dy6qj1r","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入肺、大肠二经。\""}]},{"ID":"20240612085411-3l18tlv","Type":"NodeParagraph","Properties":{"id":"20240612085411-3l18tlv","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612085411-ue1qs2b","Type":"NodeParagraph","Properties":{"id":"20240612085411-ue1qs2b","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240612085411-jn6s2jb","Type":"NodeParagraph","Properties":{"id":"20240612085411-jn6s2jb","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"甘，寒。\""}]},{"ID":"20240612085411-45fum6i","Type":"NodeParagraph","Properties":{"id":"20240612085411-45fum6i","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240612085411-o4dgy5d","Type":"NodeParagraph","Properties":{"id":"20240612085411-o4dgy5d","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"平。\""}]},{"ID":"20240612085411-ukcxr63","Type":"NodeParagraph","Properties":{"id":"20240612085411-ukcxr63","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"气寒，味苦酸。\""}]},{"ID":"20240612085411-8b0f31i","Type":"NodeParagraph","Properties":{"id":"20240612085411-8b0f31i","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612085411-vxlqdrj","Type":"NodeParagraph","Properties":{"id":"20240612085411-vxlqdrj","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 肺虚无火，小便多及风寒咳嗽忌服。"}]},{"ID":"20240612085411-r17zs8s","Type":"NodeParagraph","Properties":{"id":"20240612085411-r17zs8s","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"续断、桂心、麻子为之使。\""}]},{"ID":"20240612085411-jo0w4c3","Type":"NodeParagraph","Properties":{"id":"20240612085411-jo0w4c3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"肺虚无火，因寒袭之而发咳嗽者勿服。\""}]},{"ID":"20240612085411-dcdwv9u","Type":"NodeParagraph","Properties":{"id":"20240612085411-dcdwv9u","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"肺虚，小便利者禁用。\""}]},{"ID":"20240612085411-utqbiwc","Type":"NodeParagraph","Properties":{"id":"20240612085411-utqbiwc","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612085411-fy63und","Type":"NodeParagraph","Properties":{"id":"20240612085411-fy63und","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 泻肺平喘，行水消肿。治肺热喘咳，吐血，水肿，脚气，小便不利。"}]},{"ID":"20240612085411-651dm8o","Type":"NodeParagraph","Properties":{"id":"20240612085411-651dm8o","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤中，五劳六极羸瘦，崩中，脉绝，补虚益气。\""}]},{"ID":"20240612085411-m8212r0","Type":"NodeParagraph","Properties":{"id":"20240612085411-m8212r0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"去肺中水气，唾血，热渴，水肿，腹满胪胀，利水道，去寸白，可以缝金疮。\""}]},{"ID":"20240612085411-bdg3hc4","Type":"NodeParagraph","Properties":{"id":"20240612085411-bdg3hc4","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治肺气喘满，水气浮肿，主伤绝，利水道，消水气，虚劳客热，头痛，内补不足。\""}]},{"ID":"20240612085411-r6jznj3","Type":"NodeParagraph","Properties":{"id":"20240612085411-r6jznj3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"④孟诜：\"入散用，下一切风气水气。\""}]},{"ID":"20240612085411-3gn820s","Type":"NodeParagraph","Properties":{"id":"20240612085411-3gn820s","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"止肺热咳嗽。\""}]},{"ID":"20240612085411-u407b6r","Type":"NodeParagraph","Properties":{"id":"20240612085411-u407b6r","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"泻肺，降气，散血。。"}]},{"ID":"20240612085411-bvz8y0h","Type":"NodeParagraph","Properties":{"id":"20240612085411-bvz8y0h","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》：\"治脚气痹挛，目昏，黄疸，通二便，治尿数。\""}]},{"ID":"20240612085411-mlvlo4v","Type":"NodeParagraph","Properties":{"id":"20240612085411-mlvlo4v","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑧《贵州民间方药集》：\"治风湿麻木。\""}]},{"ID":"20240612085411-fmzvqie","Type":"NodeParagraph","Properties":{"id":"20240612085411-fmzvqie","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612085411-2qwtmdl","Type":"NodeParagraph","Properties":{"id":"20240612085411-2qwtmdl","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～5钱；或入散剂。外用：捣汁涂或煎水洗。"}]},{"ID":"20240612085411-tdu8us6","Type":"NodeParagraph","Properties":{"id":"20240612085411-tdu8us6","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612085411-j0t6dog","Type":"NodeParagraph","Properties":{"id":"20240612085411-j0t6dog","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" ①治小儿肺盛，气急喘嗽：地骨皮、桑白皮（炒）各一两，甘草（炙）一钱。锉散，入粳米一撮，水二小盏，煎七分，食前服。（《小儿药证直诀》泻白散）"}]},{"ID":"20240612085411-7bpnve5","Type":"NodeParagraph","Properties":{"id":"20240612085411-7bpnve5","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②治咳嗽甚者，或有吐血殷鲜：桑根白皮一斤。米泔浸三宿，净刮上黄皮，锉细，入糯米四两，焙干，一处捣为末。每服米饮调下一、二钱。（《经验方》）"}]},{"ID":"20240612085411-zmocnqv","Type":"NodeParagraph","Properties":{"id":"20240612085411-zmocnqv","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③治水饮停肺，胀满喘急：桑根白皮二钱，麻黄、桂枝各一钱五分，杏仁十四粒（去皮），细辛、干婪各一钱五分。水煎服。（《本草汇言》）"}]},{"ID":"20240612085411-s015fi6","Type":"NodeParagraph","Properties":{"id":"20240612085411-s015fi6","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"④治小便不利，面目浮肿：桑白皮四钱，冬瓜仁五钱，葶苈子三钱。煎汤服。（《上海常用中草药》）"}]},{"ID":"20240612085411-zwzlckj","Type":"NodeParagraph","Properties":{"id":"20240612085411-zwzlckj","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑤治卒小便多，消渴：桑根白皮，炙令黄黑，锉，以水煮之令浓，随意饮之；亦可纳少米，勿用盐。（《肘后方》）"}]},{"ID":"20240612085411-czx15h9","Type":"NodeParagraph","Properties":{"id":"20240612085411-czx15h9","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑥治糖尿病：桑白皮四钱，枸杞子五钱，煎汤服。（《上海常用中草药》）"}]},{"ID":"20240612085411-r1f23bz","Type":"NodeParagraph","Properties":{"id":"20240612085411-r1f23bz","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑦治传染性肝炎：鲜桑白皮二两，白糖适量。水煎，分二次服。（《福建中医药》（3）：26，1961）"}]},{"ID":"20240612085411-xhhgmkn","Type":"NodeParagraph","Properties":{"id":"20240612085411-xhhgmkn","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑧治产后下血不止：炙桑白皮，煮水饮之。（《肘后方》）"}]},{"ID":"20240612085411-5zpmg27","Type":"NodeParagraph","Properties":{"id":"20240612085411-5zpmg27","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑨治小儿尿灶丹，初从两股起，及脐间，走阴头，皆赤色者：水二升，桑皮（切）二升，煮取汁，浴之。（《千金方》）"}]},{"ID":"20240612085411-me9kfin","Type":"NodeParagraph","Properties":{"id":"20240612085411-me9kfin","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑩治石痈坚如石，不作脓者：蜀桑根白皮，阴干捣末，烊胶，以酒和敷肿。（《千金方》）"}]},{"ID":"20240612085411-35cf5jm","Type":"NodeParagraph","Properties":{"id":"20240612085411-35cf5jm","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑾治蜈蚣毒：桑根皮捣烂敷或煎洗。（《湖南药物志》）"}]},{"ID":"20240612085411-66iukcv","Type":"NodeParagraph","Properties":{"id":"20240612085411-66iukcv","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"⑿治坠马拗损：桑根白皮五斤。为末，水一升，煎成膏。敷于损处。（《经验后方》）"}]},{"ID":"20240612085411-vs2c7f3","Type":"NodeParagraph","Properties":{"id":"20240612085411-vs2c7f3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612085411-qytcwc9","Type":"NodeParagraph","Properties":{"id":"20240612085411-qytcwc9","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" ①李杲：\"桑白皮，甘以固元气之不足而补虚，辛以泻肺气之有余而止嗽。又桑白皮泻肺，然性不纯良，不宜多用。\""}]},{"ID":"20240612085411-uiqbmxo","Type":"NodeParagraph","Properties":{"id":"20240612085411-uiqbmxo","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"桑白皮，长于利小水，乃实则泻其子也，故肺中有水气及肺火有余者宜之。\"十剂\"云，燥可去湿，桑白皮、赤小豆之属是矣。宋医钱乙治肺气热盛，咳嗽而后喘，面肿身热，泻白散。……桑白皮、地骨皮皆能泻火从小便去，甘草泻火而缓中，粳米清肺而养血，此乃泻肺诸方之准绳也。元医罗天益言其泻肺中伏火而补正气，泻邪所以补正也。若肺虚而小便利者，不宜用之。\""}]},{"ID":"20240612085411-tpd0q90","Type":"NodeParagraph","Properties":{"id":"20240612085411-tpd0q90","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"桑皮，散热，主治喘满咳嗽，热痰唾血，皆由实邪郁遏，肺窍不得通畅，借此渗之散之，以利肺气，诸证自愈。故云泻肺之有余，非桑皮不可。以此治皮里膜外水气浮肿及肌肤邪热，浮风燥痒，悉能去之。同甘菊、扁豆通鼻塞热壅，合沙参、黄芪止肠红下血皆效。\""}]},{"ID":"20240612085411-ceon514","Type":"NodeParagraph","Properties":{"id":"20240612085411-ceon514","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612085411-tyahmcp","Type":"NodeParagraph","Properties":{"id":"20240612085411-tyahmcp","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612085411-gq1z7q3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612085411-gq1z7q3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"《中华本草》：桑白皮"}]},{"ID":"20240612085411-sl75ru4","Type":"NodeParagraph","Properties":{"id":"20240612085411-sl75ru4","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612085411-obgsuvr","Type":"NodeParagraph","Properties":{"id":"20240612085411-obgsuvr","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" Sānɡ Bái Pí"}]},{"ID":"20240612085411-o50c159","Type":"NodeParagraph","Properties":{"id":"20240612085411-o50c159","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612085411-z2b8nsl","Type":"NodeParagraph","Properties":{"id":"20240612085411-z2b8nsl","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 桑根白皮、白桑皮桑桑皮、根皮"}]},{"ID":"20240612085411-0tnu53x","Type":"NodeParagraph","Properties":{"id":"20240612085411-0tnu53x","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612085411-swsuoy8","Type":"NodeParagraph","Properties":{"id":"20240612085411-swsuoy8","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》。《本草图经》： 桑根白皮，作线以缝金创肠出者，更以热鸡血涂之。唐安金藏剖腹，用此法便愈。"}]},{"ID":"20240612085411-j2bfe5n","Type":"NodeParagraph","Properties":{"id":"20240612085411-j2bfe5n","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612085411-iiylfu0","Type":"NodeParagraph","Properties":{"id":"20240612085411-iiylfu0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 药材基源：为桑科植物桑根皮。"}]},{"ID":"20240612085411-ercsbj9","Type":"NodeParagraph","Properties":{"id":"20240612085411-ercsbj9","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Morus alba L."}]},{"ID":"20240612085411-mz02vi5","Type":"NodeParagraph","Properties":{"id":"20240612085411-mz02vi5","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"采收和储藏：多在春、秋季挖取根部，南方各地冬季也可挖取，去净泥土及须根，趁鲜时刮去黄棕色粗皮，用刀纵向剖开皮部，以木槌轻，使皮部与木部分离，除去木心，晒干。"}]},{"ID":"20240612085411-vmp0yov","Type":"NodeParagraph","Properties":{"id":"20240612085411-vmp0yov","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612085411-c2yizdh","Type":"NodeParagraph","Properties":{"id":"20240612085411-c2yizdh","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于丘陵、山坡、村旁、田野等处，多为人工栽培。"}]},{"ID":"20240612085411-vajgy3m","Type":"NodeParagraph","Properties":{"id":"20240612085411-vajgy3m","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国各地。"}]},{"ID":"20240612085411-ivo3j5a","Type":"NodeParagraph","Properties":{"id":"20240612085411-ivo3j5a","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612085411-fla5een","Type":"NodeParagraph","Properties":{"id":"20240612085411-fla5een","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 落叶灌木或小乔木，高3-15m。树皮灰白色，有条状浅裂；根皮黄棕色或红黄色，纤维性强。单叶互生；叶柄长l-2.5cm；叶片卵形或宽卵形，长5-20cm，宽4-10cm，先端锐尖或渐尖，基部圆形或近心形，边缘有粗锯齿或圆齿，有时有不规则的分裂，上面无毛，有光泽，下面脉上有短毛，腋间有毛，基出脉3条与细脉交织成网状，背面较明显；托叶披针形，早落。花单性，雌雄异株；雌、雄花序均排列成穗状葇荑花序，腋生；雌花序长l-2cm，被毛，总花梗长5-10mm；雄花序长1-2.5cm，下垂，略被细毛；雄花具花被片4，雄蕊4，中央有不育的雌蕊；雌花具花被片4，基部合生，柱头2裂。瘦果，多数密集成一卵圆形或长圆形的聚合果，长l-2.5cm，初时绿色，成熟后变肉质、黑紫色或红色。种子小。花期4-5月，果期5-6月。"}]},{"ID":"20240612085411-nbh5vkh","Type":"NodeParagraph","Properties":{"id":"20240612085411-nbh5vkh","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612085411-vnynq15","Type":"NodeParagraph","Properties":{"id":"20240612085411-vnynq15","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根皮呈扭曲的卷筒状、槽状或板片状，长 短宽窄不一，厚1-4mm。外表面白色或淡黄白色，较平坦，有的残留橙黄色或棕黄色鳞片状粗皮；内表面黄白色或灰黄色，有细纵纹。体轻，质韧，纤维性强，难折断，易纵向撕裂，撕裂时有粉尘飞扬。气微，味微甘。"}]},{"ID":"20240612085411-frjssrk","Type":"NodeParagraph","Properties":{"id":"20240612085411-frjssrk","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"以色白、皮厚、柔韧者为佳。"}]},{"ID":"20240612085411-1vxh2to","Type":"NodeParagraph","Properties":{"id":"20240612085411-1vxh2to","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根皮横切面：韧皮部射线宽2-6列细胞；散有乳管；纤维单个散在或成束，非木化或微木化；薄壁细胞含淀粉粒，有的细胞 含草酸钙方晶。较老根皮中石细胞常与含晶厚壁细胞连结成群。"}]},{"ID":"20240612085411-w3ff0zg","Type":"NodeParagraph","Properties":{"id":"20240612085411-w3ff0zg","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粉末0.2g，加乙醇8ml，水浴加热5min，滤过。取滤液Zml，加镁粉少许混匀，滴加浓盐酸数滴，溶液呈樱红色，并有气泡产生。（检查黄酮类）（2）取本品粗粉5g,;；加苯20ml回流提取15min，滤过。滤液蒸干，残渣用少量氯仿溶解于小试管中，加冰醋酸1ml，沿试管壁缓缓加入浓硫酸1ml使成两层，两液界面显红色环。"}]},{"ID":"20240612085411-roqkhne","Type":"NodeParagraph","Properties":{"id":"20240612085411-roqkhne","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612085411-d7sl6y0","Type":"NodeParagraph","Properties":{"id":"20240612085411-d7sl6y0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 桑白皮经石油醚、乙醇、乙醚、醋酸酐、水、乙酸乙酯等反复处理，所得黄色粉末，给小鼠静脉注射的 半数致死量为 32.7mg/kg。而正丁醇提取物或水提取物给小鼠灌胃或腹腔注射 10g/kg，或静脉注射 5g/kg 均未引起死亡。醇提取物无论是1次大量或多次小量给药，对实验动物均未表现不良影响，似可认为该药毒性较小。"}]},{"ID":"20240612085411-cmj3sp3","Type":"NodeParagraph","Properties":{"id":"20240612085411-cmj3sp3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612085411-yvumv2g","Type":"NodeParagraph","Properties":{"id":"20240612085411-yvumv2g","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 含黄酮类成分：桑素（muberrin），桑色烯（mulberrochromene），环桑素（cyclomulberrin），环染色烯（cyclo－mulberrochromene）[1]，桑根皮素（morusin）[2,3],环桑根皮素（Cy-clomorusin),化合物（compound）A[3]，氧化二氢桑根皮素（oxydi-hydromorusin］[4,5]，桑黄酮（kuwanon）A、B、C[4，5]、D、 E、 F、［6］、G（即albanin F，moracenin B）[7]、H（即albanin G，moracenin A）[8]、Ⅰ[9，10]、K、L[11]、Y、Z［[12]、桑白皮素（moracenin）C[13]、D[14]，桑根酮（sanggenone）A[10,21]、B、C、D[10]、E[10，20]、F[22]、G[23]、H、I、J、K[24]、L、M、N[25]、O[26]、P[27]。又含桑色呋喃（mulberrofuran)A［15］、B［16］、C［l0］、K、 N、O[17]、M[18]、P[19]、Q[20]，伞形花内酯（umbelliferone），东莨菪素（scopoletin）[28]，桑糖朊（moran）A[29]及具降压作用的乙酰胆碱类似物成分[30]。"}]},{"ID":"20240612085411-ufxo5e6","Type":"NodeParagraph","Properties":{"id":"20240612085411-ufxo5e6","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612085411-2c6h1fe","Type":"NodeParagraph","Properties":{"id":"20240612085411-2c6h1fe","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 1.利尿与导泻作用 桑白皮煎剂2g/kg相当生药量灌胃兔，桑白皮水提物取或正丁醇提取物300-500mg/kg给大鼠灌胃或腹腔注射，均有利尿作用。尿量及钠、钾离子和氯化物排出量均增加。水提取物3g/kg灌胃小鼠，可排出液状粪便，表明有导泻作用。"}]},{"ID":"20240612085411-mjip9h7","Type":"NodeParagraph","Properties":{"id":"20240612085411-mjip9h7","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的作用 桑白皮煎剂和水、乙醇、正丁醇或乙醚等多种溶煤提取物，经静脉注射、十二指肠给药或口服，对正常犬、兔、大鼠或高血压动物，均有不同程度的降压作用，且比较持久，并伴有心动徐缓。其降压作用可被阿托品或切断两侧迷走神经所抑制，而不受氯苯吡胺的影响。但另有报道，切断两侧迷走神经或于第5-6颈椎部位切断脊髓，其降压作用仍存在，提示该提取物中可能含有乙酰胆碱样物质，国产桑白皮的降压作用较日本产者力强，但毒性也较大。桑白皮提取物能抑制离体蛙心，此作用亦可被阿托品所阻断。正丁醇提取物1mg/ml可使离体大鼠心房收缩频率及收缩力明显增加，随后轻度抑制；水提物则产生轻度的抑制作用。提取物对蛙心下肢血管表现收缩作用；对离体兔耳血管有扩张作用，能增加血流量，此作用亦可被被阿托品所阻断。"}]},{"ID":"20240612085411-xj6ckuz","Type":"NodeParagraph","Properties":{"id":"20240612085411-xj6ckuz","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"3.对平滑肌的作用 犬实验表明，正丁醇提取物50mg/kg 静脉注射能明显增加胃肠道活动；而水提取物则无此作用。正丁醇提取物0.1mg/ml 能松弛离体豚鼠回肠，且能抑制其自动节律性活动。对大鼠胃贲门窦条片有轻度兴奋作用。提取物对兔离体肠和子宫有兴奋作用。"}]},{"ID":"20240612085411-lkmwhpj","Type":"NodeParagraph","Properties":{"id":"20240612085411-lkmwhpj","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"4.对神经系统的作用 （1）．镇静及安定作用 给小鼠腹腔注射桑白皮水或正丁醇提取物50mg/kg以上可发生镇静和安定作用，动物自发性活动减少，触觉及痛觉反应降低，瞳孔扩大。"}]},{"ID":"20240612085411-97zr1q6","Type":"NodeParagraph","Properties":{"id":"20240612085411-97zr1q6","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"（2）．抗惊厥作用 白皮正丁醇或水提取物均能轻度抑制小鼠电休克发作，但仍表现伸肌紧张。实验动物死亡数较对照组明显减少。"}]},{"ID":"20240612085411-ljc4cby","Type":"NodeParagraph","Properties":{"id":"20240612085411-ljc4cby","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"（3）．镇痛作用 小鼠醋酸扭体及压尾实验表明，水提取物有明显的镇痛作用，可提高痛阈，2g/kg 灌胃 与阿司匹林0.5g/kg的作用相似。"}]},{"ID":"20240612085411-5fvmhe6","Type":"NodeParagraph","Properties":{"id":"20240612085411-5fvmhe6","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"（4）．降温正丁醇提取物小鼠腹腔注射有降温作用。但大鼠口服则无效。"}]},{"ID":"20240612085411-m0weaal","Type":"NodeParagraph","Properties":{"id":"20240612085411-m0weaal","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"（5.）抗菌作用 100%煎剂对金黄色葡萄球菌、伤寒杆菌、福氏痢疾杆菌有抑制作用。对发癣菌也有抑制作用。对结核杆菌无抑制作用。"}]},{"ID":"20240612085411-lt1xa7b","Type":"NodeParagraph","Properties":{"id":"20240612085411-lt1xa7b","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"（6.）其它作用 对大鼠角叉菜胶及葡聚糖所引起的脚肿有抑制作用。有轻度镇咳作用。桑白皮提取物单用对青蛙背肌无影响，但可使蛙腹直肌紧张性增加。上述2种标本如预先用毒扁豆碱处理，则桑白皮提取物作用显着增强，对兔腮腺的分泌有轻度促进作用。桑白皮热水提取物体外实验对人子宫颈癌 JTC－26 株的抑制率为70%左右。"}]},{"ID":"20240612085411-d8bwlje","Type":"NodeParagraph","Properties":{"id":"20240612085411-d8bwlje","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612085411-z1iyxnv","Type":"NodeParagraph","Properties":{"id":"20240612085411-z1iyxnv","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 桑皮：刷去灰屑，洗净，润透后切丝，晒干。蜜桑皮：取桑皮丝，加炼熟蜂蜜与开水少许，拌匀，稍闷，置锅内用文火炒至变为黄色、不粘手为度，取出，放凉。(每桑皮丝100斤，用炼熟蜂蜜30斤)《雷公炮炙论》：凡使(桑白皮)采十年已上嫩根，铜刀剥上青黄薄皮一重，只取第二重白撇青涎者，用铜刀锻了，焙令干，勿使皮上涎落，涎是药力。此药恶铁并铅。"}]},{"ID":"20240612085411-lxhzf5x","Type":"NodeParagraph","Properties":{"id":"20240612085411-lxhzf5x","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612085411-lssp2l2","Type":"NodeParagraph","Properties":{"id":"20240612085411-lssp2l2","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 肺；脾经"}]},{"ID":"20240612085411-8t9yqk7","Type":"NodeParagraph","Properties":{"id":"20240612085411-8t9yqk7","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612085411-vwo6so2","Type":"NodeParagraph","Properties":{"id":"20240612085411-vwo6so2","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 甘；辛；性寒"}]},{"ID":"20240612085411-wcb599z","Type":"NodeParagraph","Properties":{"id":"20240612085411-wcb599z","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612085411-d87j6yf","Type":"NodeParagraph","Properties":{"id":"20240612085411-d87j6yf","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 肺虚无火力、便多及风寒咳嗽忌服。"}]},{"ID":"20240612085411-6a2h8ba","Type":"NodeParagraph","Properties":{"id":"20240612085411-6a2h8ba","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：续断、桂心、麻干为之使。"}]},{"ID":"20240612085411-d9x1mc8","Type":"NodeParagraph","Properties":{"id":"20240612085411-d9x1mc8","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：肺虚无火，因寒袭之而发咳嗽者勿服。"}]},{"ID":"20240612085411-jbbmqjc","Type":"NodeParagraph","Properties":{"id":"20240612085411-jbbmqjc","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"3.《得配本草》：肺虚，小便利者蒙用。"}]},{"ID":"20240612085411-ryunwv0","Type":"NodeParagraph","Properties":{"id":"20240612085411-ryunwv0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612085411-egqbx5w","Type":"NodeParagraph","Properties":{"id":"20240612085411-egqbx5w","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 泻肺平喘；利水消肿。主肺热喘痰；水饮停肺；胀满喘急；水肿；脚气；小便不利"}]},{"ID":"20240612085411-krp4je4","Type":"NodeParagraph","Properties":{"id":"20240612085411-krp4je4","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612085411-5lpxzjv","Type":"NodeParagraph","Properties":{"id":"20240612085411-5lpxzjv","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g；或入散剂。外用：适量，捣汁涂或煎水洗。"}]},{"ID":"20240612085411-d96c82x","Type":"NodeParagraph","Properties":{"id":"20240612085411-d96c82x","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612085411-jos98y5","Type":"NodeParagraph","Properties":{"id":"20240612085411-jos98y5","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" ①治小儿肺盛，气急喘嗽： 地骨皮、桑白皮(炒)各一两，甘草(炙)一钱。挫散，入棱米一撮，水二小盏，煎七分，食前服。(刮、儿药证直诀》泻自散)②治咳嗽甚看，或有吐血殷鲜： 桑根白皮一斤。米浴浸三宿，净刮上黄皮，挫细，人糯米四两，焙干，一处捣为末。每服米钦调下一、二钱。(《经验方》)③治水饮潮市，胀满喘急：桑根自皮二钱，麻黄、桂枝各一钱五分，杏仁十四粒(去皮)，细辛、干姜各一钱五分。水煎服。(《本草汇言》)④治小便不利，面目浮肿： 桑白皮四钱，冬瓜仁五钱，草苗子三钱。煎汤服。(《上海常用中草药》)⑤治卒小便多，消渴： 桑根自皮，炙令黄黑，挫，以水煮之令浓，随意饮之；亦可纳少米，匆用盐。(《肘后方》)⑥治糖尿病： 桑自皮四钱，拘把子五钱。煎汤服。(《上海常用中草药》)⑦治传染性肝炎： 鲜桑白皮二两，白糖适量。水煎，分二次服。〔《福建中医药》(3)：26，1961〕⑧治产后下血不止：炙桑白皮，煮水饮之。 (《肘后方》)⑨治小儿尿灶丹，初从两股起，及脐间，走阴头，皆赤色者：水二升，桑皮(切)二升，煮取汁，浴之。(《千金方》)⑩治石痈坚如石，不作脓者： 蜀桑根自皮，阴干捣末，佯胶，以酒和数肿。(《干金方》)11.治娱蚁毒： 桑根皮捣烂敷或煎洗。 (《湖南药物志》)12.治坠马锄损：桑根白皮五斤。为末，水一升，煎成膏。敷于损处。(《经验后方》)"}]},{"ID":"20240612085411-mr2yn1u","Type":"NodeParagraph","Properties":{"id":"20240612085411-mr2yn1u","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612085411-f0mihu5","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612085411-f0mihu5","updated":"20240612085411"},"Children":[{"ID":"20240612085411-8y79p4u","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612085411-8y79p4u","updated":"20240612085411"},"Children":[{"ID":"20240612085411-5o5noyp","Type":"NodeParagraph","Properties":{"id":"20240612085411-5o5noyp","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"李杲：桑白皮，甘以固元气之不足而补虚，宰以泻肺气之有余而止嗽。又桑自皮泻肺， 然性不纯良，不宜多用。"}]}]}]},{"ID":"20240612085411-qyilgl0","Type":"NodeParagraph","Properties":{"id":"20240612085411-qyilgl0","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：桑自皮，长于利小水，乃实则泻其子也，故肺中有水气及肺火有余者宜之。十剂云，燥可去湿，桑白皮、赤小豆之属是矣。宋医钱乙治肺气热盛，咳嗽而后喘，面肿身热，泻白散。桑自皮、地召皮皆能泻火从小便去，甘草泻火而缓中，粳米清肺而养血， 此乃泻肺诸方之准绳也。元医罗天益言其泻肺中伏火而补正气，泻邪所以补正也。若肺虚而小便利看，不宜用之。"}]},{"ID":"20240612085411-b5mpsnu","Type":"NodeParagraph","Properties":{"id":"20240612085411-b5mpsnu","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"3.《药品化义》：桑皮，散热，主治喘满咳嗽，热痰唾血，皆由实邪郁遏，肺窍不得通畅，借此渗之散之，以利肺气，诸证自愈。故云泻肺之有余，非桑皮不可。以此治皮里膜外水气浮肿及肌肤邪热，浮风燥痒，悉能去之。 同甘菊、扁豆通鼻塞热壅，合沙参、黄芪止肠红下血皆效。"}]},{"ID":"20240612085411-s1j6c4f","Type":"NodeParagraph","Properties":{"id":"20240612085411-s1j6c4f","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612085411-sfavhm3","Type":"NodeParagraph","Properties":{"id":"20240612085411-sfavhm3","updated":"20240612085411"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612085413-3yyegx1","Type":"NodeThematicBreak","Properties":{"id":"20240612085413-3yyegx1"}},{"ID":"20240612085414-m743ig7","Type":"NodeParagraph","Properties":{"id":"20240612085414-m743ig7"}}]}