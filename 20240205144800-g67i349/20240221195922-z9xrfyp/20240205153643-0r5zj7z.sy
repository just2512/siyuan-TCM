le":"width: 671px;","style":"width: 661px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杏花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杏花-20240703172008-awg9gq9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 661px;\" parent-style=\"width: 671px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 598px;","style":"width: 588px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杏花2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杏花2-20240703172134-4y9ju4q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240703172401-793u0h0","Type":"NodeParagraph","Properties":{"id":"20240703172401-793u0h0","updated":"20240828095924"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 849px;","style":"width: 839px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杏花5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杏花5-20240703172401-tsx1nx1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 839px;\" parent-style=\"width: 849px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 428px;","style":"width: 418px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杏花6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杏花6-20240703175206-73tpnra.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 418px;\" parent-style=\"width: 428px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240703172210-77ugckp","Type":"NodeParagraph","Properties":{"id":"20240703172210-77ugckp","updated":"20240828095925"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 852px;","style":"width: 842px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杏树1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杏树1-20240703172254-ik7k0mo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 842px;\" parent-style=\"width: 852px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 383px;","style":"width: 373px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杏树2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杏树2-20240703172523-xwvfi7u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 373px;\" parent-style=\"width: 383px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240802124727-3rp5htv","Type":"NodeParagraph","Properties":{"id":"20240802124727-3rp5htv","updated":"20240828095710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：药用杏仁用的是苦杏仁；（买杏仁时最好买未去皮去尖的杏仁，因为那层皮能保持油脂，过早去掉影响药效）"}]},{"ID":"20240614091339-zfvb4jl","Type":"NodeThematicBreak","Properties":{"id":"20240614091339-zfvb4jl"}},{"ID":"20240614091447-dxz9tx6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091447-dxz9tx6","updated":"20240614091459"},"Children":[{"Type":"NodeText","Data":"杏核仁《神农本草经》"}]},{"ID":"20240614091605-rm8mslw","Type":"NodeParagraph","Properties":{"id":"20240614091605-rm8mslw","updated":"20240614091605"},"Children":[{"Type":"NodeText","Data":"味甘温。"}]},{"ID":"20240614091605-3j4si11","Type":"NodeParagraph","Properties":{"id":"20240614091605-3j4si11","updated":"20240614091605"},"Children":[{"Type":"NodeText","Data":"主咳逆上气，雷呜，喉痹下气，产乳，金创，寒心，贲豚，生川谷。"}]},{"ID":"20240614091605-08ad1rr","Type":"NodeParagraph","Properties":{"id":"20240614091605-08ad1rr","updated":"20240614091605"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生晋山。"}]},{"ID":"20240614091605-rxi3c11","Type":"NodeParagraph","Properties":{"id":"20240614091605-rxi3c11","updated":"20240614091605"},"Children":[{"Type":"NodeText","Data":"案《说文》云：杏，果也。《管子·地员篇》云：五沃之土，其木宜杏，高诱注《淮南子》云：杏有窍在中。"}]},{"ID":"20240614091605-yu8249u","Type":"NodeParagraph","Properties":{"id":"20240614091605-yu8249u","updated":"20240614091605"},"Children":[{"Type":"NodeText","Data":"上果，下品二种旧同。"}]},{"ID":"20240614091529-sdttv4i","Type":"NodeThematicBreak","Properties":{"id":"20240614091529-sdttv4i"}},{"ID":"20240614091530-4n45oxx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091530-4n45oxx","updated":"20240614091534"},"Children":[{"Type":"NodeText","Data":"杏核仁《新修本草》"}]},{"ID":"20240614091530-8deufer","Type":"NodeParagraph","Properties":{"id":"20240614091530-8deufer","updated":"20240614091530"},"Children":[{"Type":"NodeText","Data":"味甘、苦，温，冷利，有毒。主咳逆上气，雷鸣，喉痹，下气，产乳，金创，寒心，贲豚，惊痫，心下烦热，风气去来，时行头痛，解肌，消心下急，杀狗毒，一名杏子。五月采。其花，味苦，无毒。主补不足，女子伤中，寒热痹，厥逆。实，味酸，不可多食，伤筋骨。生晋山川谷。"}]},{"ID":"20240614091530-q14rjyi","Type":"NodeParagraph","Properties":{"id":"20240614091530-q14rjyi","updated":"20240614091530"},"Children":[{"Type":"NodeText","Data":"得火良，恶黄 、黄芩、葛根，解锡毒，畏 草。处处有，药中多用之，汤浸去赤皮，熬令黄。"}]},{"ID":"20240614091652-89vlt58","Type":"NodeThematicBreak","Properties":{"id":"20240614091652-89vlt58"}},{"ID":"20240614091654-p5n5noy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091654-p5n5noy","updated":"20240614091701"},"Children":[{"Type":"NodeText","Data":"杏核仁《本草蒙筌》"}]},{"ID":"20240614091654-qr1wu4u","Type":"NodeParagraph","Properties":{"id":"20240614091654-qr1wu4u","updated":"20240614091654"},"Children":[{"Type":"NodeText","Data":"味甘、苦，气温。可升可降，阴中阳也。有小毒。树种山傍园侧，（家园种者妙，山杏不堪用。）实结生青熟黄。五月摘收，堪为果品。凡资拯治，惟取核仁。所恶药有三般，黄芪黄芩干葛。解锡毒，得火良。单仁者泡去皮尖，麸炒入药；双仁者惟堪毒狗，误服杀人。专入太阴肺经，乃为利下之剂。除胸中气逆喘促，止咳嗽坠痰；润大肠气闭便难，逐贲豚散结。研纳女人阴户，又治发痒虫疽。根主堕胎，花治厥逆。实啖多瞀，伤筋骨伤神。叶逢端午采收，煎汤洗眼止泪。"}]},{"ID":"20240614091654-yy176ki","Type":"NodeParagraph","Properties":{"id":"20240614091654-yy176ki","updated":"20240614091654"},"Children":[{"Type":"NodeText","Data":"（谟）按：东垣云：杏仁下喘，用治气也。桃仁疗狂，用治血也。俱治大便闭燥，但有气血之分。昼则便难，行阳气也；夜则便难，行阴血也。年高人便闭，不可泄者。脉浮在气，宜杏仁陈皮治之；脉沉在血，宜桃仁陈皮治之。所以俱用陈皮者，以其手阳明病与手太阴相为表里，故用之以为使也。"}]},{"ID":"20240614091724-2pba5a7","Type":"NodeThematicBreak","Properties":{"id":"20240614091724-2pba5a7"}},{"ID":"20240614091726-ae4q1f9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091726-ae4q1f9","updated":"20240614091731"},"Children":[{"Type":"NodeText","Data":"杏核仁《千金翼方》"}]},{"ID":"20240614091726-w4l4tor","Type":"NodeParagraph","Properties":{"id":"20240614091726-w4l4tor","updated":"20240614091726"},"Children":[{"Type":"NodeText","Data":"味甘苦，温，冷利，有毒。主咳逆上气，雷鸣，喉痹，下气，产乳，金疮，寒心，贲豚，惊痫，心下烦热，风气去来，时行头痛，解肌，消心下急，杀狗毒。五月采之。其两仁者杀人，可以毒狗。"}]},{"ID":"20240614091726-8dqg3n8","Type":"NodeParagraph","Properties":{"id":"20240614091726-8dqg3n8","updated":"20240614091726"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"}]},{"ID":"20240614091726-ixjz3xd","Type":"NodeParagraph","Properties":{"id":"20240614091726-ixjz3xd","updated":"20240614091726"},"Children":[{"Type":"NodeText","Data":"味苦，无毒，主补不足，女子伤中，寒热痹，厥逆。"}]},{"ID":"20240614091726-1cc92wx","Type":"NodeParagraph","Properties":{"id":"20240614091726-1cc92wx","updated":"20240614091726"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"}]},{"ID":"20240614091726-y2q0etk","Type":"NodeParagraph","Properties":{"id":"20240614091726-y2q0etk","updated":"20240614091726"},"Children":[{"Type":"NodeText","Data":"味酸，不可多食，伤筋骨，生晋山川谷。"}]},{"ID":"20240614091707-dzduj3w","Type":"NodeThematicBreak","Properties":{"id":"20240614091707-dzduj3w"}},{"ID":"20240614091708-1dgjaia","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091708-1dgjaia","updated":"20240614091719"},"Children":[{"Type":"NodeText","Data":"杏核仁《本草图经》"}]},{"ID":"20240614091708-5ics9wj","Type":"NodeParagraph","Properties":{"id":"20240614091708-5ics9wj","updated":"20240614091711"},"Children":[{"Type":"NodeText","Data":"生晋川山谷，今处处有之。其实亦数种，黄而圆者名金杏。相传云：种出济南郡之分流山，彼人谓之汉帝杏，今近都多种之，熟最早。其扁而青黄者名木杏，味酢不及金杏。杏子入药，今以东来者为胜，仍用家园种者。山杏不堪入药。五月采，破核去双仁者。古方有单服杏仁，修治如法，自朝蒸之，至午而止，便以慢火微烘，至七日乃收贮之。每旦腹空时，不约多少，任意啖之，积久不止，驻颜延年，云是夏姬法。然杏仁能使人血溢，少误之，必出血不已或至委顿，故近人少有服者。又有杏酥法：去风虚，除百病。捣烂杏仁一石，以好酒二石，研滤取汁一石五斗，入白蜜一斗五升，搅匀，封于新瓮中，勿泄气。三十日看酒上酥出，即掠取内瓷器中贮之。取其酒滓团如梨大，置空屋中，作格安之。候成饴脯状，旦服一枚，以前酒下，其酒任性饮之。杏花，干之亦入药。杏枝，主堕伤，取一握，水一大升煮半，下酒三合，分再服，大效。其实不可多食，伤神损筋骨。刘禹锡《传信方》治嗽补肺丸，杏仁二大升，山者不中，拣却双仁及陈臭，以童子小便一斗浸之，春夏七日，秋冬二七日，并皮尖于砂盆子中研细，滤取汁，煮令鱼眼沸，候软如面糊即成，仍时以柳篦搅，勿令著底，后即以马尾罗或粗布下之，日曝，通丸即丸，服之时，食前后总须服三十丸、五十丸，任意茶、酒下，忌白水粥。只是为米泔耳。自初浸至成，常以纸盖之，以畏尘土也。如无马尾罗，即以粗布袋下之，如取枣穰法。"}]},{"ID":"20240614091610-hazv6ea","Type":"NodeThematicBreak","Properties":{"id":"20240614091610-hazv6ea"}},{"ID":"20240614091611-1y9tuoa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091611-1y9tuoa","updated":"20240614091615"},"Children":[{"Type":"NodeText","Data":"杏核仁《本草衍义》"}]},{"ID":"20240614091611-3qpk38w","Type":"NodeParagraph","Properties":{"id":"20240614091611-3qpk38w","updated":"20240614091611"},"Children":[{"Type":"NodeText","Data":"犬伤人，量所伤大小，烂嚼沃破处，以帛系定，至瘥无苦。又汤去皮，研一升，以水一升半，翻复绞取稠汁，入生蜜四两、甘草一茎约一钱，银石器中熳火熬成稀膏，瓷器盛。食后、夜卧，入少酥，沸汤点一匙匕服，治肺燥喘热，大肠秘，润泽五脏。如无上证，更入盐点尤佳。"}]},{"ID":"20240614091620-5i4ebav","Type":"NodeThematicBreak","Properties":{"id":"20240614091620-5i4ebav"}},{"ID":"20240614091621-pvz6mfa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091621-pvz6mfa","updated":"20240614091633"},"Children":[{"Type":"NodeText","Data":"杏核《名医别录》"}]},{"ID":"20240614091621-cuek1bk","Type":"NodeParagraph","Properties":{"id":"20240614091621-cuek1bk","updated":"20240614091621"},"Children":[{"Type":"NodeText","Data":"味苦，冷利，有毒．主治惊痫，心下烦热，风气去来，时行头痛，解肌，消心下急，狗毒．一名杏子．五月采．其两仁者杀人，可以毒狗．花，味苦，无毒．主补不足，女子伤中，寒热痹，厥逆．实，味酸，不可多食，伤筋骨．生晋山．（得火良，恶黄 、黄芩、根，解锡毒，畏 草．）"}]},{"ID":"20240614091621-y17ftms","Type":"NodeParagraph","Properties":{"id":"20240614091621-y17ftms","updated":"20240614091621"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶杏核仁，味甘，温．主咳逆上气雷鸣，喉痹，下气，产乳金创，寒心贲豚．生川谷．"}]},{"ID":"20240614091539-8zshyq6","Type":"NodeThematicBreak","Properties":{"id":"20240614091539-8zshyq6"}},{"ID":"20240614091541-a37dbdc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091541-a37dbdc","updated":"20240614091545"},"Children":[{"Type":"NodeText","Data":"杏核仁《本草乘雅半偈》"}]},{"ID":"20240614091541-smronn7","Type":"NodeParagraph","Properties":{"id":"20240614091541-smronn7","updated":"20240614091541"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240614091541-pkq38rp","Type":"NodeParagraph","Properties":{"id":"20240614091541-pkq38rp","updated":"20240614091541"},"Children":[{"Type":"NodeText","Data":"自下而上曰竖穷，从内而外曰横遍。"}]},{"ID":"20240614091541-2xs3qz3","Type":"NodeParagraph","Properties":{"id":"20240614091541-2xs3qz3","updated":"20240614091541"},"Children":[{"Type":"NodeText","Data":"【气味】甘苦温，有小毒。"}]},{"ID":"20240614091541-qnjn32v","Type":"NodeParagraph","Properties":{"id":"20240614091541-qnjn32v","updated":"20240614091541"},"Children":[{"Type":"NodeText","Data":"【主治】主咳逆上气，雷鸣，喉痹，下气，产乳，金疮，寒心，奔豚。"}]},{"ID":"20240614091541-7ao4uac","Type":"NodeParagraph","Properties":{"id":"20240614091541-7ao4uac","updated":"20240614091541"},"Children":[{"Type":"NodeText","Data":"【核】曰∶诸杏叶皆圆而端有尖，二三月开淡红色花，妖娆艳丽，比桃花伯仲间，亦可爱也。故骚人咏物，与梅并言，则曰梅杏，盖取其叶之似也。与桃并言，则曰桃杏，盖取其花之近也。有叶多者，黄花者，千瓣者。单瓣者结实，实甘而沙曰沙杏，黄而酢曰梅杏，青而黄曰柰杏。金杏大如梨，黄如橘。西京杂记载∶蓬莱杏花五色。北方有肉杏，赤大而扁曰金刚拳。有曰杏熟时色青白，入药宜山杏，收取仁用。修治，以沸汤浸去皮尖，每斤用白火石一斤，黑豆三合，以东流水同煮，从巳至午，漉出，劈开如金色，晒干乃用。得火良。恶黄芩、黄 、葛根。畏 草。"}]},{"ID":"20240614091541-f0pox4s","Type":"NodeParagraph","Properties":{"id":"20240614091541-f0pox4s","updated":"20240614091541"},"Children":[{"Type":"NodeText","Data":"【 】曰∶枝叶华实皆赤，肉理络脉如营，气味苦温，诚心之果，具心之体与用者。仁则包蕴全体，窦发端倪，枢机颇锐，偏心之用与气者。咳逆上气，雷鸣喉痹，寒心奔豚，此一唯从升，不能从出，正回则不转矣。杏仁窦发横遍之机，使竖穷者，随玉衡以为旋转，正神转不回，乃得其机矣。咳逆上气，息若雷鸣，以及喉痹，谓心之火用不及亦可；谓客淫外束亦可；谓客淫外束，致心之火用不及亦可；谓心之火用不及，致客淫外束亦可；寒心奔豚，谓心之火体不及亦可；谓心之火用不及亦可；谓心之火用不及，致心之火体不及亦可；谓心之火体不及，致心之火用不及亦可；盖火爰物以显用，即用以显体故也。奔豚者肾之积，上逆奔心，缘火位之下，水气承之，火不及，则承乃亢，亢则害矣。与妄汗致承者不同类，妄汗则出有余，此则升太过。下气者，转竖穷与横遍，下非降也，降则涉金，非火令矣。产乳固属甲拆，而解孚全仗横遍，横遍始甲拆耳。金刃成疮，此肉理断绝，络脉不营，杏以脉胜，仍（欲尽物性，先察物情。如桃为肺果，肺主毛，桃有毛，专精于毛矣。杏与心果，心主脉，杏有脉，专精于脉矣。顾精之所专，即情之所钟，情之所钟，即性之所生。人苦不知性耳，能尽一物之性，即能达万物之情。欲尽一物之性者，亦若物性之精有所专，靡不见性矣。）"}]},{"ID":"20240614091339-q4qq8q9","Type":"NodeThematicBreak","Properties":{"id":"20240614091339-q4qq8q9"}},{"ID":"20240614091404-2pu21m3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091404-2pu21m3","updated":"20240614091441"},"Children":[{"Type":"NodeText","Data":"杏核仁《证类本草》"}]},{"ID":"20240614091404-4fxr7jb","Type":"NodeParagraph","Properties":{"id":"20240614091404-4fxr7jb","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"味甘、苦，温、冷利，有毒。主咳逆上气，雷鸣，喉痹，下气，产乳，金疮，寒心，贲豚，惊痫，心下烦热，风气去来，时行头痛，解肌，消心下急，杀狗毒。五月采之。其两仁者杀人，可以毒狗。"}]},{"ID":"20240614091404-85lrc86","Type":"NodeParagraph","Properties":{"id":"20240614091404-85lrc86","updated":"20240614091404"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"味苦，无毒。主补不足，女子伤中，寒热痹，厥逆。"}]},{"ID":"20240614091404-9n4n3c4","Type":"NodeParagraph","Properties":{"id":"20240614091404-9n4n3c4","updated":"20240614091404"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"味酸，不可多食，伤筋骨。生晋山川谷。（得火良，恶黄芩、黄 、葛根，解锡毒，畏陶隐居云∶处处有，药中多用之，汤浸去尖、皮，熬令黄。臣禹锡等谨按药性论云∶杏仁，能治腹痹不通，发汗，主温病，治心下急满痛，除心腹烦闷，疗肺气，咳嗽上气、喘促，入天门冬煎，润心肺，可和酪作汤，益润声气，宿即动冷气。孟诜云∶杏，热。面 者取仁，去皮，捣和鸡子白，夜卧涂面，明早以暖清酒洗之。人患卒哑，取杏仁三分，去皮、尖熬，别杵桂一分，和如泥，取李核大绵裹含，细细咽之。日五夜三。谨按心腹中结伏气，杏仁、桔皮、桂心、诃梨勒皮为丸。空心服三十丸。无忌。又烧令烟尽，研如泥，绵裹，纳女人阴中，治虫疽。陈藏器云∶杏仁本功外，杀虫，烧令烟未尽，细研如脂，物裹纳 齿孔中。"}]},{"ID":"20240614091404-jm1itxf","Type":"NodeParagraph","Properties":{"id":"20240614091404-jm1itxf","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"亦主产门中虫疮痒不可忍者，去人及诸畜疮，中风。取仁去皮熬令赤，和桂末，研如泥，绵裹如指大，含之，利喉咽，去喉痹，痰唾，咳嗽，喉中热结生疮。杏酪浓煎如膏服之，润五脏，去痰嗽。生熟吃俱得，半生半熟杀人。日华子云∶杏，热，有毒。不可多食，伤神。"}]},{"ID":"20240614091404-jxwve7x","Type":"NodeParagraph","Properties":{"id":"20240614091404-jxwve7x","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"图经曰∶杏核仁，生晋川山谷，今处处有之，其实亦数种，黄而圆者名金杏。相传云∶种出济南郡之分流山，彼人谓之汉帝杏，今近都多种之，熟最早。其扁而青黄者名木杏，味酢，不及金杏。杏子入药，今以东来者为胜，仍用家园种者，山杏不堪入药。五月采，破核去双仁者。古方∶有单服。杏仁修治如法，自朝蒸之至午而止，便以慢火微烘，至七日乃收贮之。"}]},{"ID":"20240614091404-rdapdee","Type":"NodeParagraph","Properties":{"id":"20240614091404-rdapdee","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"每旦腹空时，不约多少，任意啖之，积久不止，驻颜延年。云是夏姬法，然杏仁能使人血溢，少误之必出血不已。或至委顿。故近人少有服者。又有杏酥法∶主风虚，除百病，捣烂杏仁一石，以好酒二石，研滤取汁一石五斗，入白蜜一斗五升，搅匀，封于新瓮中，勿泄气，三十日看酒上酥出即掠取，纳瓷器中贮之，取其酒滓，团如梨大，置空屋中，作格安之。候成饴脯状，旦服一枚，以前酒下，其酒任性饮之。杏花，干之亦入药。杏枝，主堕伤，取一握，水一大升煮半，下酒三合，分再服，大效。其实不可多食，伤神，损筋骨。刘禹锡《传信方》治嗽补肺丸，杏仁二大升，山者不中，拣却双仁及陈臭，以童子小便一斗浸之，春夏七日、秋冬二七日，并皮、尖，于砂盆子中，研细滤取汁，煮令鱼眼沸，候软如面糊即成。"}]},{"ID":"20240614091404-680im7t","Type":"NodeParagraph","Properties":{"id":"20240614091404-680im7t","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"仍时以柳篦搅，勿令着底，后即以马尾罗或粗布下之。日暴通丸即丸，服之时食前后总须服三十丸、五十丸。任意茶、酒下。忌白水粥，只是为米泔耳。自初浸至成，当以纸盖之，以畏尘土也。如无马罗，即以粗布袋下之。如取枣穣法。"}]},{"ID":"20240614091404-1hmvbn6","Type":"NodeParagraph","Properties":{"id":"20240614091404-1hmvbn6","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，须以沸汤浸少时，去皮膜，去尖，擘作两片，用白火石并乌豆、杏仁三件，于锅子中，下东流水煮，从巳至午，其杏仁色褐黄则去尖，然用。每修一斤，用白火石一斤，乌豆三合，水旋添，勿令阙，免反血为妙也。食疗云∶主热风头痛。又，烧令烟尽，去皮，以乱发裹之，咬于所患齿下，其痛便止。熏诸虫出并去风，便瘥。重者不过再服。外台秘要∶治偏风，半身不遂，兼失音不语。生吞杏仁七枚，不去皮、尖，日别从一七，渐加至七七枚，七七日周而复始。食后即以竹沥下之，任意多少，日料一升取尽。又方∶治耳聋。以杏仁七枚，去皮拍碎为三分，以绵裹，于中着颗盐如小豆许，以器盛于饭甑中蒸之，候饭熟出裹。"}]},{"ID":"20240614091404-sxlf6vi","Type":"NodeParagraph","Properties":{"id":"20240614091404-sxlf6vi","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"令患人侧卧，和绵捻一裹，以油汁滴入耳中。久又一裹，根据前法。千金方∶治咳嗽旦夕加重，增寒壮热，少喜多嗔，忽进退，面色不润，积渐少食，状若肺脉强紧浮者。杏仁半斤，去皮、尖，入于瓶内，童子小便二斗，浸七日了，漉出，去小便，以暖水淘过，于沙盆内研成泥，别入瓷瓶中。以小便三升，煎之如膏。量其轻重，食上熟水下一钱匕。妇人、室女服之更妙。又方∶主卒中风，头面肿。杵杏仁如膏敷之。又方∶治一切风虚，常恶头痛欲破者。"}]},{"ID":"20240614091404-du3gxbl","Type":"NodeParagraph","Properties":{"id":"20240614091404-du3gxbl","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"杏仁去皮、尖，干曝为末，水九升研滤，如作粥法，缓火煎令如麻腐，起取和羹粥酒纳一匙服之。每七日后，大汗出，慎风、冷、猪、鱼、鸡、蒜、大酢。一剂后，诸风减瘥。春夏恐酢少作服之，秋九月后煎之，此法神妙，可深秘之。又方∶治鼻中生疮。杵杏仁，乳头。冷汗尽，三度瘥。又方∶治破伤风肿。浓敷杏仁膏，燃烛遥炙。又方∶治疳虫蚀鼻生疮。"}]},{"ID":"20240614091404-hn08lo0","Type":"NodeParagraph","Properties":{"id":"20240614091404-hn08lo0","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"治喉痹。杏仁熬熟，杵丸如弹子，含咽其汁。为末帛裹，含之亦得。"}]},{"ID":"20240614091404-g7mqu0r","Type":"NodeParagraph","Properties":{"id":"20240614091404-g7mqu0r","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"取杏仁熬熏，杵膏敷之。又方∶治小儿，大人咳逆上气。杏仁三升去皮、尖，炒令黄，杵如膏，蜜一升，分为三分，纳杏仁，杵令得所，更纳一分杵如膏。又纳一分杵熟，水一膏，敷之良。又方∶箭镝及诸刀刃在喉咽、胸膈诸隐处不出，杵杏仁敷之。梅师方∶治食狗肉不消，心下下肉为度度易之，欲好声。杏仁一升，熬去皮、尖，酥一两，蜜少许，为丸如梧桐子大。空心米汤下十五丸。"}]},{"ID":"20240614091404-15g3muy","Type":"NodeParagraph","Properties":{"id":"20240614091404-15g3muy","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"又方∶杏，味壅身热。食医心心吃二合。又方∶主停冷，空心食之。又方水三升，研滤取汁，于铛吐。胜金方∶治久患肺三、四换，浸半月，取焙同煎，取七分，食后温服出。生杏仁七枚去皮，秘录∶治小儿脐赤肿。杏张。以杏仁碎之，蒸令溜细研，煮一、两沸，承热东引杏枝三两，细锉微熬伤寒类要∶治温病食劳。以小便。杏仁二七枚，去皮、仁、桂心各一两同研匀，用半熟杏，不用多食，令人目盲。又方慈秘诀∶杏金丹，本出浑皇子，亦轻重如金，软而可食，因此立名。"}]},{"ID":"20240614091404-jcrwh9y","Type":"NodeParagraph","Properties":{"id":"20240614091404-jcrwh9y","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"祖皆炼之。彭祖曰∶宁可见此方，仙秘要，服皆得力。只为作之者难，世俗之人心洁净，浪有恶物触犯，药即不成，徒劳损废，心人、女人、小人，知见丹亦不成，丹成无忌。"}]},{"ID":"20240614091404-bsw22hg","Type":"NodeParagraph","Properties":{"id":"20240614091404-bsw22hg","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"丹法∶从寅月修，杏树人罕到者良。又以寅月锄锄草，恐损地力。至三月，离树五步作畦 ，使人迹、畜兽践踏，只亢旱即泉源水洒润其树下。初春有霜雪，即树下烧火以救之，恐损花苞萼。至五月杏熟，收取当月旬内自落者，去核取仁六斗，以热汤退皮，去双仁，取南流水三石和研，取汁两石八斗，去滓，并小美者亦得。取新铁釜受三石以来，作灶须具五岳三台形，用朱砂图画之，其灶通四脚去地五寸，着镣不得绝稠，恐下灰不得。其釜用酥三斤，以糠火及炭然釜少少磨，三斤酥尽，即纳汁釜中。"}]},{"ID":"20240614091404-rw2op9w","Type":"NodeParagraph","Properties":{"id":"20240614091404-rw2op9w","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"釜上安盆，盆上钻孔，用筝弦悬车辖至釜底，其孔以纸缠塞，勿令泄气。初着糠火并干牛粪火，一日三动车辖，以衮其汁。五日有露液生，十日白霜起，又三日白霜尽，即金花出，若见此候，即知丹霜成。开盆用炭火炙干，以雄鸡翎扫取，以枣肉和为丸，如梧桐子大。釜中独角成者为上，其釜口次也，丹滓亦能治冷疾。服丹法∶如人吃一斗酒，醉，即吃五升；吃一升者只吃半升。下药取满日，空心暖酒服三丸。至七日，宿疾除，愈声喑、盲、挛跛、疝气、野鸡、瘿气、风痫、 气、疮肿，万病皆除。愈头白却黑，齿落更生。张先师云∶二两为一剂，一剂延八十年，两剂延二百四十年，三剂通灵不死。若为天仙一万年，永忌房室。"}]},{"ID":"20240614091404-vs10ove","Type":"NodeParagraph","Properties":{"id":"20240614091404-vs10ove","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"若为地仙五千年，三年忌房室。若为人仙一千五百年，百日忌房室。陈居士上表，十月以后，泥炉造为雷息之时，亦不用车马轰阗声。何以十月造？天雷二月起八月息。初造丹时，祭五岳、神仙地祗，亦取童子看火候。二十四气，五星五行，阴阳十二时，取此气候用火，丹乃成矣。圣所服皆致长生久寿，世人不能常服。或言此药无效，若精气确志，必就神仙长年矣。"}]},{"ID":"20240614091404-n0rmwfl","Type":"NodeParagraph","Properties":{"id":"20240614091404-n0rmwfl","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"衍义曰∶杏核仁，犬伤人，量所伤大小，烂嚼沃破处，以帛系定，至瘥，无苦。又汤去皮，研一升，以水一升半，翻复绞取稠汁，入生蜜四两，甘草一茎约一钱，银、石器中，熳火熬成稀膏，瓷器盛。食后、夜卧，入少酥，沸汤点一匙匕服，治肺燥喘热，大肠秘，润泽五脏。"}]},{"ID":"20240614091404-h9v1n4o","Type":"NodeParagraph","Properties":{"id":"20240614091404-h9v1n4o","updated":"20240614091404"},"Children":[{"Type":"NodeText","Data":"如无上证，更入盐点，尤佳。杏实，《本经》别无治疗，日华子言多食伤神。有数种皆热，小儿尤不可食，多致疮痈及上膈热。晒蓄为干果，其深赭色，核大而褊者为金杏。此等须接，其他皆不逮也。如山杏辈，只可收仁。又有白杏，至熟色青白或微黄，其味甘淡而不酸。"}]},{"ID":"20240614091339-c35q0jd","Type":"NodeThematicBreak","Properties":{"id":"20240614091339-c35q0jd"}},{"ID":"20240614091345-z62u5w3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091345-z62u5w3","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：杏仁"}]},{"ID":"20240614091345-5s5cs9x","Type":"NodeParagraph","Properties":{"id":"20240614091345-5s5cs9x","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614091345-oqb988b","Type":"NodeParagraph","Properties":{"id":"20240614091345-oqb988b","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" Xìnɡ Rén"}]},{"ID":"20240614091345-umytcdv","Type":"NodeParagraph","Properties":{"id":"20240614091345-umytcdv","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614091345-nbf7gbm","Type":"NodeParagraph","Properties":{"id":"20240614091345-nbf7gbm","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 杏核仁（《本经》），杏子（《伤寒论》），木落子（《石药尔雅》），苦杏仁（《临证指南》），杏梅仁（《浙江中药手册》）。"}]},{"ID":"20240614091345-mj6odtf","Type":"NodeParagraph","Properties":{"id":"20240614091345-mj6odtf","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614091345-17p17nh","Type":"NodeParagraph","Properties":{"id":"20240614091345-17p17nh","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240614091345-qbshntd","Type":"NodeParagraph","Properties":{"id":"20240614091345-qbshntd","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614091345-w4mnt02","Type":"NodeParagraph","Properties":{"id":"20240614091345-w4mnt02","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杏"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山杏"},{"Type":"NodeText","Data":"等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"味苦的干燥种子"},{"Type":"NodeText","Data":"。夏季果实成熟时采摘，除去果肉及核壳，取种仁，晾干。置阴凉干燥处，防虫蛀。"}]},{"ID":"20240614091345-w9r035y","Type":"NodeParagraph","Properties":{"id":"20240614091345-w9r035y","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614091345-blizjw1","Type":"NodeParagraph","Properties":{"id":"20240614091345-blizjw1","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 主产东北、华北各省。"}]},{"ID":"20240614091345-hjvuyt5","Type":"NodeParagraph","Properties":{"id":"20240614091345-hjvuyt5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614091345-0yn0wgv","Type":"NodeParagraph","Properties":{"id":"20240614091345-0yn0wgv","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" ①杏（《本经》），又名：甜梅（《江南录》）。"}]},{"ID":"20240614091345-0dgplry","Type":"NodeParagraph","Properties":{"id":"20240614091345-0dgplry","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高4～9米。树皮暗红棕色，幼枝光滑，有不整齐纵裂纹。叶互生；卵圆形，长5～9厘米，宽7～8厘米，先端长渐尖，基部圆形或略近心脏形，边缘有细锯齿或不明显的重锯齿，主脉基部被白色柔毛；叶柄长2.5～4.5厘米，带红色，具2腺体。花先叶开放，单生于小枝端；花梗短或几无梗；花萼5裂，裂片三角状椭圆形，基部合生成筒状；花瓣5，白色或粉红色，阔卵形，长阔几相等；雄蕊多数，着生于萼简边缘，不等长；雌蕊1，子房1室，花柱光滑，仅基部有淡黄色柔毛，柱头头状。核果黄红色，心脏卵圆形，略扁，侧面具一浅凹槽，径3～4厘米，微被绒毛；核近于光滑，坚硬，扁心形，具沟状边缘；内有种子1枚，心脏卵形，红色。花期3～4月。果期4～6月。"}]},{"ID":"20240614091345-zitp1m2","Type":"NodeParagraph","Properties":{"id":"20240614091345-zitp1m2","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"野生或栽培。分布黑龙江、辽宁、吉林、内蒙古、河北、河南、山东、江苏、山西、陕西、甘肃、宁夏、新疆、四川、贵州等地。"}]},{"ID":"20240614091345-yz0ckoj","Type":"NodeParagraph","Properties":{"id":"20240614091345-yz0ckoj","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②山杏（《本草图经》）"}]},{"ID":"20240614091345-9m3o9es","Type":"NodeParagraph","Properties":{"id":"20240614091345-9m3o9es","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"形状与上种相近，叶较小，长4～5厘米，宽3～4厘米，先端长渐尖，基部呈同楔形或截形。果较小，果肉亦较薄；核的边缘薄而锐利；种子味苦。"}]},{"ID":"20240614091345-m3g0bg8","Type":"NodeParagraph","Properties":{"id":"20240614091345-m3g0bg8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"生于山坡，间有栽培。分布辽宁、河北、内蒙古、山东、山西、陕西、宁夏、甘肃、江苏等地。"}]},{"ID":"20240614091345-anxe43s","Type":"NodeParagraph","Properties":{"id":"20240614091345-anxe43s","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"以上2种植物的树根（杏树根）、树皮（杏树皮）、树枝（杏枝）、叶（杏叶）、花（杏花）、果实（杏子）亦供药用，各详专条。"}]},{"ID":"20240614091345-hgsxu5t","Type":"NodeParagraph","Properties":{"id":"20240614091345-hgsxu5t","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614091345-j2y87z8","Type":"NodeParagraph","Properties":{"id":"20240614091345-j2y87z8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 干燥种子，呈心脏形略扁，长1～1.5厘米，宽约1厘米左右，顶端渐尖，基部钝圆，左右不对称。种皮红棕色或暗棕色，自基部向上端散出褐色条纹，表面有细微纵皱；尖端有不明显的珠孔，其下方侧面脊棱上，有一浅色棱线状的种脐，合点位于底端凹入部，自合点至种脐，有一颜色较深的纵线，是为种脊，种皮菲薄，内有乳白色肥润的子叶两片，富于油质，接合面中间，常有空隙，胚根位于其尖端，味苦，有特殊的杏仁味。以颗粒均匀、饱满肥厚、味苦、不发油者为佳。"}]},{"ID":"20240614091345-mjblh77","Type":"NodeParagraph","Properties":{"id":"20240614091345-mjblh77","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"杏仁有甜、苦之分，栽培杏所产者甜的较多，野生的一般均为苦的。从原植物来看，西伯利亚杏、辽杏及野生山杏的杏仁为苦杏仁，而杏及山杏的栽培种的杏仁有些是苦杏仁，有些是甜杏仁。"}]},{"ID":"20240614091345-2jda3dm","Type":"NodeParagraph","Properties":{"id":"20240614091345-2jda3dm","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614091345-290nvcs","Type":"NodeParagraph","Properties":{"id":"20240614091345-290nvcs","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 过量服用苦杏仁，可发生中毒，表现为眩晕，突然晕倒、心悸、头疼、恶心呕吐、惊厥、昏迷、紫绀、瞳孔散大、对光反应消失、脉搏弱慢、呼吸急促或缓慢而不规则。若不及时抢救，可因呼吸衰竭而死亡。中毒者内服杏树皮或杏树根煎剂可以解救，参见\"杏树皮\"、\"杏树根\"条。"}]},{"ID":"20240614091345-ffy4114","Type":"NodeParagraph","Properties":{"id":"20240614091345-ffy4114","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614091345-adfiwzt","Type":"NodeParagraph","Properties":{"id":"20240614091345-adfiwzt","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 含苦杏仁甙约3％、脂肪油（杏仁油）约50％、蛋白质和各种游离氨基酸。苦杏仁甙受杏仁中的苦杏仁酶及樱叶酶等β-葡萄糖甙酶水解，依次生成野樱皮甙和扁桃腈，再分解生成苯甲醛和氢氰酸。"}]},{"ID":"20240614091345-nfioab9","Type":"NodeParagraph","Properties":{"id":"20240614091345-nfioab9","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614091345-9aprxg3","Type":"NodeParagraph","Properties":{"id":"20240614091345-9aprxg3","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 见\"巴旦杏仁\"条。"}]},{"ID":"20240614091345-7ewmd2n","Type":"NodeParagraph","Properties":{"id":"20240614091345-7ewmd2n","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614091345-p1gc3iu","Type":"NodeParagraph","Properties":{"id":"20240614091345-p1gc3iu","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 杏仁：拣净杂质，置沸水中略煮，俟皮微皱起捞出，浸凉水中，脱去种皮，晒干，簸净。炒杏仁：取净杏仁置锅内用文火炒至微黄色，取出放凉。"}]},{"ID":"20240614091345-hg44c87","Type":"NodeParagraph","Properties":{"id":"20240614091345-hg44c87","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614091345-ozw7bzq","Type":"NodeParagraph","Properties":{"id":"20240614091345-ozw7bzq","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 入肺、大肠经。"}]},{"ID":"20240614091345-8s0nimk","Type":"NodeParagraph","Properties":{"id":"20240614091345-8s0nimk","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴经。\""}]},{"ID":"20240614091345-2gwx2vu","Type":"NodeParagraph","Properties":{"id":"20240614091345-2gwx2vu","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"入脾、肺二经。\""}]},{"ID":"20240614091345-l5nn6se","Type":"NodeParagraph","Properties":{"id":"20240614091345-l5nn6se","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入肺、大肠二经。\""}]},{"ID":"20240614091345-xajun3b","Type":"NodeParagraph","Properties":{"id":"20240614091345-xajun3b","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614091345-o57tzxj","Type":"NodeParagraph","Properties":{"id":"20240614091345-o57tzxj","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 苦，温，有毒。"}]},{"ID":"20240614091345-7ak3rtn","Type":"NodeParagraph","Properties":{"id":"20240614091345-7ak3rtn","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，温。\""}]},{"ID":"20240614091345-fs5dfsi","Type":"NodeParagraph","Properties":{"id":"20240614091345-fs5dfsi","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，冷利，有毒。\""}]},{"ID":"20240614091345-wzfhnii","Type":"NodeParagraph","Properties":{"id":"20240614091345-wzfhnii","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味苦辛微甘。\""}]},{"ID":"20240614091345-zdqhld5","Type":"NodeParagraph","Properties":{"id":"20240614091345-zdqhld5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614091345-60zbjia","Type":"NodeParagraph","Properties":{"id":"20240614091345-60zbjia","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 阴虚咳嗽及大便溏泄者忌服。"}]},{"ID":"20240614091345-emq7cdd","Type":"NodeParagraph","Properties":{"id":"20240614091345-emq7cdd","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"得火良。恶黄耆、黄芩、葛根。畏蓑草。\""}]},{"ID":"20240614091345-xl58ryo","Type":"NodeParagraph","Properties":{"id":"20240614091345-xl58ryo","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"阴虚咳嗽，肺家有虚热、热痰者忌之。\""}]},{"ID":"20240614091345-bvkwbtv","Type":"NodeParagraph","Properties":{"id":"20240614091345-bvkwbtv","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"元气虚陷者勿用，恐其沉降太泄。\""}]},{"ID":"20240614091345-0jsangc","Type":"NodeParagraph","Properties":{"id":"20240614091345-0jsangc","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"亡血家尤为切禁。\""}]},{"ID":"20240614091345-p2np3d6","Type":"NodeParagraph","Properties":{"id":"20240614091345-p2np3d6","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑤《本草从新》：\"因虚而咳嗽便秘者忌之。\""}]},{"ID":"20240614091345-yjyilj2","Type":"NodeParagraph","Properties":{"id":"20240614091345-yjyilj2","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614091345-8qhb465","Type":"NodeParagraph","Properties":{"id":"20240614091345-8qhb465","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 祛痰止咳，平喘，润肠。治外感咳嗽，喘满，喉痹，肠燥便秘。"}]},{"ID":"20240614091345-5wrlf4w","Type":"NodeParagraph","Properties":{"id":"20240614091345-5wrlf4w","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主咳逆上气雷鸣，喉痹，下气，产乳金疮，寒心奔豚。\""}]},{"ID":"20240614091345-vk4y8c2","Type":"NodeParagraph","Properties":{"id":"20240614091345-vk4y8c2","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"解锡、胡粉毒。\""}]},{"ID":"20240614091345-rdlqzum","Type":"NodeParagraph","Properties":{"id":"20240614091345-rdlqzum","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"主惊痫，心下烦热，风气去来，时行头痛，解肌，消心下急，杀狗毒。\""}]},{"ID":"20240614091345-kp690ac","Type":"NodeParagraph","Properties":{"id":"20240614091345-kp690ac","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治腹痹不通，发汗，主温病。治心下急满痛，除心腹烦闷，疗肺气咳嗽，上气喘促。入天门冬煎，润心肺。可和酪作汤，益润声气。宿即动冷气。\""}]},{"ID":"20240614091345-73iprmu","Type":"NodeParagraph","Properties":{"id":"20240614091345-73iprmu","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑤崔禹锡《食经》：\"理风噤及言吮不开。\""}]},{"ID":"20240614091345-kz6nlhi","Type":"NodeParagraph","Properties":{"id":"20240614091345-kz6nlhi","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"除肺中燥，治风燥在于胸膈。《主治秘诀》云，润肺气，消食，升滞气。\""}]},{"ID":"20240614091345-r6rx256","Type":"NodeParagraph","Properties":{"id":"20240614091345-r6rx256","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑦《滇南本草》：\"止咳嗽，消痰润肺，润肠胃，消面粉积，下气，治疳虫。\""}]},{"ID":"20240614091345-v47uwnd","Type":"NodeParagraph","Properties":{"id":"20240614091345-v47uwnd","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"杀虫，治诸疮疥，消肿，去头面诸风气鼓疱。\""}]},{"ID":"20240614091345-kif4b37","Type":"NodeParagraph","Properties":{"id":"20240614091345-kif4b37","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614091345-swsax80","Type":"NodeParagraph","Properties":{"id":"20240614091345-swsax80","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱，或入丸、散。外用：捣敷。"}]},{"ID":"20240614091345-g4437r0","Type":"NodeParagraph","Properties":{"id":"20240614091345-g4437r0","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614091345-j2t2q13","Type":"NodeParagraph","Properties":{"id":"20240614091345-j2t2q13","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" ①治肺寒卒咳嗽：细辛半两（捣为末），杏仁半两（汤浸，去皮尖、双仁，麸炒微黄，研如膏）。上药，于铛中熔蜡半两，次下酥一分，入细辛、杏仁，丸如羊枣大。不计时候，以绵裹一丸，含化咽津。（《圣惠方》）"}]},{"ID":"20240614091345-w0pf0vo","Type":"NodeParagraph","Properties":{"id":"20240614091345-w0pf0vo","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②治咳逆上气：杏仁三升，熟捣如膏，蜜一升，为三分，以一分内杏仁捣，令强，更内一分捣之如膏，又内一分捣熟止。先食已含咽之，多少自在，日三。每服不得过半方寸匕，则痢。（《千金方》杏仁丸）"}]},{"ID":"20240614091345-9g8p4p2","Type":"NodeParagraph","Properties":{"id":"20240614091345-9g8p4p2","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"③治久患肺喘，咳嗽不止，睡卧不得者：杏仁（去皮尖，微炒）半两，胡桃肉（去皮）半两。上件入生蜜少许，同研令极细，每一两作一十丸。每服一丸，生姜汤嚼下，食后临卧。（《杨氏家藏方》杏仁煎）"}]},{"ID":"20240614091345-jhvw4yb","Type":"NodeParagraph","Properties":{"id":"20240614091345-jhvw4yb","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"④治上气喘急：桃仁、杏仁（并去双仁、皮尖，炒）各半两。上二味，细研，水调生面少许，和丸如梧桐子大。每服十丸，生姜、蜜汤下，微利为度。（《圣济总录》双仁丸）"}]},{"ID":"20240614091345-r4e1bx5","Type":"NodeParagraph","Properties":{"id":"20240614091345-r4e1bx5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑤治气喘促浮肿，小便淋沥：杏仁一两，去皮尖，熬研，和米煮粥极熟，空心吃二合。（《食医心镜》）"}]},{"ID":"20240614091345-s742qs8","Type":"NodeParagraph","Properties":{"id":"20240614091345-s742qs8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑥治肺病咯血：杏仁四十个，以黄蜡炒黄，研，入青黛一钱，作饼，用柿饼一个，破开包药，湿纸裹，煨熟食之。（朱震亨）"}]},{"ID":"20240614091345-hv3kqy5","Type":"NodeParagraph","Properties":{"id":"20240614091345-hv3kqy5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑦利喉咽，去喉痹，痰唾咳嗽，喉中热结生疮：杏仁去皮熬令赤，和桂末，研如泥，绵裹如指大，含之。（《本草拾遗》）"}]},{"ID":"20240614091345-i5k457p","Type":"NodeParagraph","Properties":{"id":"20240614091345-i5k457p","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑧治久病大肠燥结不利：杏仁八两，桃仁六两（俱用汤泡去皮），蒌仁十两（去壳净），三味总捣如泥；川贝八两，陈胆星四两（经三制者），同贝母研极细，拌入杏、桃、蒌三仁内。神曲四两研末，打糊为丸，梧子大。每早服三钱，淡姜汤下。（《方脉正宗》）"}]},{"ID":"20240614091345-atm6w04","Type":"NodeParagraph","Properties":{"id":"20240614091345-atm6w04","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑨治暴下水泻及积痢：杏仁二十粒（汤浸去皮尖），巴豆二十粒（去膜油令尽）。上件研细，蒸枣肉为丸，如芥子大，朱砂为衣。每服一丸，食前。（《杨氏家藏方》朱砂丸）"}]},{"ID":"20240614091345-fl0wb3p","Type":"NodeParagraph","Properties":{"id":"20240614091345-fl0wb3p","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑩治上气，头面风，头痛，胸中气满贲豚，气上下往来，心下烦热，产妇金疮：杏仁一升，捣研，以水一斗滤取汁，令尽，以铜器螗火上从旦煮至日入，当熟如脂膏，下之。空腹酒服一方寸匕，日三，不饮酒者，以饮服之。（《千金方》杏仁膏）"}]},{"ID":"20240614091345-my35ucw","Type":"NodeParagraph","Properties":{"id":"20240614091345-my35ucw","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑾治眼疾翳膜遮障，但瞳子不破者：杏人三升（汤浸去皮尖、双人）。每一升，以面裹，于煻灰火中炮热，去面，研杏仁压取油，又取铜绿一钱与杏油同研，以铜箸点眼。（《圣济总录》杏仁膏）"}]},{"ID":"20240614091345-1a2dhn6","Type":"NodeParagraph","Properties":{"id":"20240614091345-1a2dhn6","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⑿治鼻中生疮：捣杏仁乳敷之；亦烧核，压取油敷之。（《千金方》）"}]},{"ID":"20240614091345-ks8qt25","Type":"NodeParagraph","Properties":{"id":"20240614091345-ks8qt25","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⒀治诸疮肿痛：杏仁去皮，研滤取膏，入轻粉、麻油调搽，不拘大人小儿。（《纲目》）"}]},{"ID":"20240614091345-a6qmq63","Type":"NodeParagraph","Properties":{"id":"20240614091345-a6qmq63","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"⒁治犬啮人：熬杏人五合，令黑，碎研成膏敷之。（《千金方》）"}]},{"ID":"20240614091345-zhl0atc","Type":"NodeParagraph","Properties":{"id":"20240614091345-zhl0atc","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614091345-itq1tz1","Type":"NodeParagraph","Properties":{"id":"20240614091345-itq1tz1","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" ①治疗慢性气管炎"}]},{"ID":"20240614091345-zli2ltk","Type":"NodeParagraph","Properties":{"id":"20240614091345-zli2ltk","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"取带皮苦杏仁与等量冰糖研碎混合，制成杏仁糖。早晚各服3钱，10天为一疗程。治疗124例，基本治愈23例，显效66例，好转31例，无效4例，总有效率96.8％。对咳、痰、喘都有治疗作用，一般服药3～4天见效。个别患者服后有头晕、恶心、心慌等副作用，1～2天后自然消失。"}]},{"ID":"20240614091345-egfqm7x","Type":"NodeParagraph","Properties":{"id":"20240614091345-egfqm7x","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②治疗外阴瘙痒"}]},{"ID":"20240614091345-wuuf6e7","Type":"NodeParagraph","Properties":{"id":"20240614091345-wuuf6e7","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"取杏仁3两，炒枯研成细粉，加麻油1.5两调成糊状。用时先取桑叶煎水冲洗外阴、阴道，然后用杏仁油糊涂搽，每日1次，或用带线棉球蘸杏仁油糊塞入阴道24小时后取出。治疗136例，有效率约90％，平均用药4～7次痒止。亦可用带皮杏仁，捣烂后，加水2倍，搅匀绞汁，以纱布浸透填塞阴道，每日1次，每次3～4小时。治疗阴道滴虫病6例，均获近期治愈。"}]},{"ID":"20240614091345-y44lcof","Type":"NodeParagraph","Properties":{"id":"20240614091345-y44lcof","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614091345-67ebvxh","Type":"NodeParagraph","Properties":{"id":"20240614091345-67ebvxh","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 除上述品种外，以下两种同属植物的种子亦同等使用。其形态特点："}]},{"ID":"20240614091345-w374r0k","Type":"NodeParagraph","Properties":{"id":"20240614091345-w374r0k","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"①西伯利亚杏"}]},{"ID":"20240614091345-fko6szo","Type":"NodeParagraph","Properties":{"id":"20240614091345-fko6szo","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"叶片卵形或阔卵形，叶基部圆形或稍狭，边缘具细钝齿，背面脉腋常具有白色柔毛。花梗极短或缺如。核果球形，果肉薄，直径约2厘米，成熟时开裂。分布东北、内蒙古、河北、山西。"}]},{"ID":"20240614091345-wg6xiiq","Type":"NodeParagraph","Properties":{"id":"20240614091345-wg6xiiq","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"②辽杏"}]},{"ID":"20240614091345-mjkdjfu","Type":"NodeParagraph","Properties":{"id":"20240614091345-mjkdjfu","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"大部分的特征与杏相同，但其叶基部很少呈心形，边缘有粗而深锐的重锯齿，花梗一般较萼筒为长，无毛。核边缘圆钝。分布东北。"}]},{"ID":"20240614091345-ilioagc","Type":"NodeParagraph","Properties":{"id":"20240614091345-ilioagc","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614091345-wdhtzoz","Type":"NodeParagraph","Properties":{"id":"20240614091345-wdhtzoz","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614091345-hadyeio","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091345-hadyeio","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"《中华本草》：杏仁"}]},{"ID":"20240614091345-gfqlijd","Type":"NodeParagraph","Properties":{"id":"20240614091345-gfqlijd","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614091345-c02dpdf","Type":"NodeParagraph","Properties":{"id":"20240614091345-c02dpdf","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" Xìnɡ Rén"}]},{"ID":"20240614091345-wcnt0o3","Type":"NodeParagraph","Properties":{"id":"20240614091345-wcnt0o3","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614091345-q2cqs21","Type":"NodeParagraph","Properties":{"id":"20240614091345-q2cqs21","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 杏核仁、杏子、木落子、苦杏仁、杏梅仁、杏、甜梅。"}]},{"ID":"20240614091345-4im8dt8","Type":"NodeParagraph","Properties":{"id":"20240614091345-4im8dt8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614091345-f6k0tyz","Type":"NodeParagraph","Properties":{"id":"20240614091345-f6k0tyz","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" Bitter Apricot Seed"}]},{"ID":"20240614091345-aukg5s1","Type":"NodeParagraph","Properties":{"id":"20240614091345-aukg5s1","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614091345-oir0pad","Type":"NodeParagraph","Properties":{"id":"20240614091345-oir0pad","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 出自《本草经集注》。"}]},{"ID":"20240614091345-h8pgglj","Type":"NodeParagraph","Properties":{"id":"20240614091345-h8pgglj","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：杏核仁，五月采之。其两仁者杀人，可以毒狗。生晋山川谷。"}]},{"ID":"20240614091345-1l2w5w9","Type":"NodeParagraph","Properties":{"id":"20240614091345-1l2w5w9","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.孙思邈：杏仁作汤，如白沫不解者，食之令气壅身热；汤经宿者，动冷气。"}]},{"ID":"20240614091345-1o8n3h4","Type":"NodeParagraph","Properties":{"id":"20240614091345-1o8n3h4","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：杏酪浓煎如膏，服之润五脏，去痰嗽。"}]},{"ID":"20240614091345-c9gobr6","Type":"NodeParagraph","Properties":{"id":"20240614091345-c9gobr6","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.《养性要钞》：治食杏仁中毒，下利烦苦，方以梅子汁解之。又方以蓝青汁服之。"}]},{"ID":"20240614091345-if0cpld","Type":"NodeParagraph","Properties":{"id":"20240614091345-if0cpld","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：杏核仁，今处处有之。其实亦数种，黄而圆者名金杏。相传"}]},{"ID":"20240614091345-8w0ixe8","Type":"NodeParagraph","Properties":{"id":"20240614091345-8w0ixe8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614091345-p0mruxo","Type":"NodeParagraph","Properties":{"id":"20240614091345-p0mruxo","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物杏、野杏、山杏、东北杏的种子。"}]},{"ID":"20240614091345-ljultpz","Type":"NodeParagraph","Properties":{"id":"20240614091345-ljultpz","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Armeniaca vulgaris Lam.[Prunus armeniaca L.]2.Armeniaca vulgaris Lam.var.ansu(Maxim.)Yü et Lu[Prunus armeniaca L.var.ansu Maxim.]3.Armeniaca sibirica(L.)Lam.[Prunus sibirica L.]4.Armeniaca mandshurica(Maxim.)Skv.[Prunus mandshurica(Maxim.)Koehne]"}]},{"ID":"20240614091345-zxm9o92","Type":"NodeParagraph","Properties":{"id":"20240614091345-zxm9o92","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6-7月果实成熟时采摘。"}]},{"ID":"20240614091345-kgddp5r","Type":"NodeParagraph","Properties":{"id":"20240614091345-kgddp5r","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614091345-h84gowy","Type":"NodeParagraph","Properties":{"id":"20240614091345-h84gowy","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 生态环境：3.山杏 生于海拔700-2000m的干燥向阳、丘陵、草原。"}]},{"ID":"20240614091345-y7kcuct","Type":"NodeParagraph","Properties":{"id":"20240614091345-y7kcuct","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.东北杏 生于海拔400-1000m的开阔的向阳山坡灌木林或杂木林下。"}]},{"ID":"20240614091345-hwou8ce","Type":"NodeParagraph","Properties":{"id":"20240614091345-hwou8ce","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"资源分布：1.杏 分布于全国各地，多系栽培。在新疆伊犁一带有野生。"}]},{"ID":"20240614091345-6fwom4v","Type":"NodeParagraph","Properties":{"id":"20240614091345-6fwom4v","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.野杏 主产于我国北部地区，栽培或野生，尤其在河北、山西等地普遍野生，山东、江苏等地也产。"}]},{"ID":"20240614091345-733fztr","Type":"NodeParagraph","Properties":{"id":"20240614091345-733fztr","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.山杏 分布于东北、华北和甘肃等地。"}]},{"ID":"20240614091345-pmfxoj8","Type":"NodeParagraph","Properties":{"id":"20240614091345-pmfxoj8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.东北杏 分布于吉林、辽宁等地。"}]},{"ID":"20240614091345-wvtr9zp","Type":"NodeParagraph","Properties":{"id":"20240614091345-wvtr9zp","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614091345-ocm2q8d","Type":"NodeParagraph","Properties":{"id":"20240614091345-ocm2q8d","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.杏 落叶小乔木，高4-10cm；树皮暗红棕色，纵裂。单叶互生；叶片圆卵形或宽卵形，长 5-9cm，宽4-8cm。春季先叶开花，花单生枝端，着生较密，稍似总状；花几无梗，花萼基部成筒状，外面被短柔毛，上部5裂；花瓣5，白色或浅粉红色，圆形至宽倒卵形；雄蕊多数，着生萼筒边缘；雌蕊单心皮，着生萼筒基部。核果圆形，稀倒卵形，直径2.5cm以上。种子1，心状卵形，浅红色。花期3-4月，果期6-7月。"}]},{"ID":"20240614091345-ybtnmw5","Type":"NodeParagraph","Properties":{"id":"20240614091345-ybtnmw5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.野杏 本变种的主要特征为 叶片基部楔形或宽楔形；花常2朵簇生，淡红色；果实近球形，红色；核卵球形，离肉，表面粗糙而有网纹，腹棱常锐利。"}]},{"ID":"20240614091345-membe9s","Type":"NodeParagraph","Properties":{"id":"20240614091345-membe9s","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.山杏 灌木或小乔木，高2-5m。叶卵形或近圆形，长(3-)5-10cm，宽(2.5-)4-7cm。花单生，直径1.5-2cm；萼片长圆状椭圆形，先端尖；花瓣近圆形或倒卵形，白色或粉红色。果实扁球形，直径 1.5-2.5cm，两侧扁，果肉薄而干燥，熟时开裂，味酸涩，不能吃。核易与果肉分离，基部一侧不对称，平滑。花期3-4月，果期6-7月。"}]},{"ID":"20240614091345-lz9ymfj","Type":"NodeParagraph","Properties":{"id":"20240614091345-lz9ymfj","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.东北杏 大乔木，高5-15m。幼枝无毛。叶椭圆形或卵形，长6-12cm，宽3-8cm。花粉红色或白色；雄蕊多数；子房密被柔毛。核果近球形，直径1.5-2.6cm，黄色；核近球形或宽椭圆形，长13-18mm，宽11-18mm，粗糙，边缘钝。花期4-5月，果期7月。"}]},{"ID":"20240614091345-qoxujsw","Type":"NodeParagraph","Properties":{"id":"20240614091345-qoxujsw","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614091345-1h5as2y","Type":"NodeParagraph","Properties":{"id":"20240614091345-1h5as2y","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.生物学特性 适应性强，耐旱，耐寒，耐瘠薄，抗盐碱。夏季在43.9℃高温下，生长正常；在-40℃低温可安全越冬。可栽种于平地或坡地。对土壤要求不严。"}]},{"ID":"20240614091345-xkmo664","Type":"NodeParagraph","Properties":{"id":"20240614091345-xkmo664","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.栽培技术 用种子或嫁接繁殖。种子繁殖：采摘成熟果实，搓去果肉，大粒每50kg出种子5-10kg，小粒每50kg出种子7.5-15kg，种子纯度为98%，发芽率为86%，以1：3湿沙混合进行冬季沙藏。春播于3月下旬，秋播于11月下旬（放于通风处阴干后即可播种）。常采用大垅播种，每垅播种1行，点播株距为10-15cm，每穴1颗种子，播后覆土厚5-6cm(约为种子直径的3倍)，镇压。嫁接繁殖：砧木用杏播种的实生苗或山杏苗，枝接于3月下旬，芽接于7月上旬至8月下旬进行。"}]},{"ID":"20240614091345-j7g6rrw","Type":"NodeParagraph","Properties":{"id":"20240614091345-j7g6rrw","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.田间管理 幼苗出现3-4片叶时进行疏苗，2-3星期后进行第2次间苗，并及时灌水，防止风吹伤根，遇天气干旱酌情灌水，7-8月雨季注意排涝。苗高达45cm，可在芽接前1个月摘去嫩尖。冬季11月至翌年3月进行修剪，分3种树形；自然圆头形，疏散分层形，自然开心形。4-6月追灌肥水，在幼芽萌发前与幼果生长期间各追速效肥1次，每株成年树可施0.25kg，然后灌水。"}]},{"ID":"20240614091345-ty14wm5","Type":"NodeParagraph","Properties":{"id":"20240614091345-ty14wm5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有杏疔叶斑，发芽前喷5度石硫合剂，展叶时喷0.3度石硫合剂。虫害有杏象鼻虫，另有袋蛾、天牛等。"}]},{"ID":"20240614091345-m1kq0xl","Type":"NodeParagraph","Properties":{"id":"20240614091345-m1kq0xl","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614091345-z3qh8da","Type":"NodeParagraph","Properties":{"id":"20240614091345-z3qh8da","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 显微鉴别 种子中部横切面：（1）杏仁 外种皮细胞1列，散有长圆形、卵圆形，偶有贝壳形及顶端平截呈梯形的黄色石细胞高38-95μm，宽30-57μm。埋在薄壁 组织部分壁较薄，纹孔及孔沟较多；出部分壁较厚，纹孔较少或无。种皮下方为细胞皱缩的营养层，有细不维管束。内种皮细胞1列，含黄色物质。外胚乳为数列废的薄壁细胞。内胚乳为1列长方形细胞，内含糊粉粒及脂肪油。"}]},{"ID":"20240614091345-tv0n32v","Type":"NodeParagraph","Properties":{"id":"20240614091345-tv0n32v","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"（2）野杏仁 种皮表面石细胞单个或2-5个（或更多）散在于种皮薄壁细胞中，石细胞呈类、多角形、类多角形或梭形，纹孔大而密；侧面观呈贝壳形、类圆形、卵圆形、类方形、类多角形或梭形，径向27-76μm，底部宽18-60μm，突出于表皮层的部分呈半月形、弓形或圆拱形，约占高度的一半，色较淡，壁厚5-8(-10)μm，层纹及纹明显，底部壁厚3-5μm，层纹无或极少，纹孔密。"}]},{"ID":"20240614091345-rw2b8r4","Type":"NodeParagraph","Properties":{"id":"20240614091345-rw2b8r4","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"（3）山杏仁 石细胞表面观较宽扁，呈类圆形、卵圆形、类多角形、类方形，纹孔大而密；侧面观多为宽贝壳形、类圆形或扁梭形，少见长圆形或卵圆形，高46-84μm，宽34-68μm。"}]},{"ID":"20240614091345-my76388","Type":"NodeParagraph","Properties":{"id":"20240614091345-my76388","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"（4）东北杏仁 石细胞多为较高的长贝壳形，顶端较小，向基部渐宽大，高46-95μm，宽41-91μm，纹孔及孔沟均细密。"}]},{"ID":"20240614091345-w225evj","Type":"NodeParagraph","Properties":{"id":"20240614091345-w225evj","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品0.5g，置带塞试管中，加5%硫酸溶液3ml充分摇匀，在试管口放一用三硝基苯酚钠溶液湿润的滤纸条，塞紧塞子，试管置40-50℃水浴中加热10min，滤纸条由黄色变砖红色。"}]},{"ID":"20240614091345-21b16x7","Type":"NodeParagraph","Properties":{"id":"20240614091345-21b16x7","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"（2）薄层色谱 取本品0.5g，加等量碳酸钙共研碎，放入带塞三角瓶内，加石油醚(60-90℃)4ml，冷浸过夜后，滤过。残渣挥干石油醚，加入乙醇4ml冷浸过夜后，滤过。滤液浓缩作供试品。以苦杏仁甙作对照品。分别点样于同一硅胶G薄层板上，以氯仿-乙醇乙酯-乙醇（2：1：2）展开，碘蒸气显色。供试品色谱中，在与对照品色谱中，在与对照品色谱的相应位置上，显相同颜色的斑点。"}]},{"ID":"20240614091345-cppdkrf","Type":"NodeParagraph","Properties":{"id":"20240614091345-cppdkrf","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614091345-l1uf6jn","Type":"NodeParagraph","Properties":{"id":"20240614091345-l1uf6jn","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 过量服用苦杏仁，可发生中毒，表现为眩晕，突然晕倒、心悸、头疼、恶心呕吐、惊厥、昏迷、紫绀、瞳孔散大、对光反应消失、脉搏弱慢、呼吸急促或缓慢而不规则。若不及时抢救，可因呼吸衰竭而死亡。中毒者内服杏树皮或杏树根煎剂可以解救，参见“杏树皮”、“杏树根”条。苦杏仁甙的LD50：大鼠、小鼠静脉注射为25g／kg；大鼠腹腔注射为8g／kg。大鼠op为0.6g／kg。MTD：小鼠、兔、犬静脉注射和肌肉注射均为3g／kg；口服均为0.075g／kg；人静脉注射为5g（约0.07g／kg）。人口服苦杏仁55枚（约60g），含苦杏仁甙约1.8g（约0.024g／kg），可致死。苦杏仁大量口服易产生中毒。首先作用于延脑的呕吐、呼吸、迷走及血管运动等中枢，均引起兴奋，随后进入昏迷、惊厥，继而整个中枢神经系统麻痹，由于呼吸中枢麻痹而死亡。其中毒机理主要是由于杏仁所含的氢氰酸很易与线粒体中的细胞色素氧化酶的三价铁起反应，形成细胞色素氧化酶-氰复合物，从而使细胞的呼吸受抑制，形成组织窒息，导致死亡。由于肠道菌丛含有β-葡萄糖甙酶，给正常鼠口服600mg／kg苦杏仁甙，2-5小时内导致死亡。检查血中CN-达到2.6-4.5μg/ml；而给无菌鼠服用相同剂量的苦否仁甙，小鼠无死亡；血中CN-不到0.4μg/ml。说明肠道菌丛是造成苦杏仁甙口服中毒的根源，其毒性比静注大40倍左右。用Ames法，TA100株，S-9，Mix（＋），苦杏仁甙有致死作用。"}]},{"ID":"20240614091345-vk48yjy","Type":"NodeParagraph","Properties":{"id":"20240614091345-vk48yjy","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614091345-e6encus","Type":"NodeParagraph","Properties":{"id":"20240614091345-e6encus","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.杏 种仁含苦味氰甙：苦杏仁甙(amygdalin)约4%和野樱甙(prunasin)；脂肪油约50%，油中有8种脂肪酸，主要的是亚油酸(linoeic acid)占27%，油酸(oleic acid)占67%及棕榈酸(palmitic acid)占 5.2%。还含绿原酸(chlorogenic acid)即是5'-咖啡酰奎宁酸(5'-caffeoylquinic acid)，新绿原酸(neochlorogenic acid)即是3'-咖啡酰奎宁酸(3'-caffeoylquinic acid)，3'-阿魏酰奎宁酸(3'-feruloylquinic acid)，5'-阿魏酰奎宁酸(5'-feruloylquinic acid)，3'-对香豆酰奎宁酸(3'-Pcoumaroylquinic acid)，肌醇(inositol)，豆甾醇(stigmasterol)，β-谷甾醇(β-sitosterol)，△5-燕麦甾醇(△5-avenasterol)，胆甾醇(cholesterol)24-胆甾烯醇(△24-chlestenol)，雌性酮(estrone)，17β-雌二醇(17β-estyadiol)，甘油三油酸酯(triolein)。另含有抗炎和镇痛活性的2种蛋白质成分：KR-A和KR-B，其含量分别为4.44%和0.41%。又含与杏仁香味有关的挥发性成分：本甲醛(benzaldehyde)，芳樟醇(linalool)，4-松油烯醇(4-terpinenol)，α-松油醇(α-terpineol)。"}]},{"ID":"20240614091345-39dziwr","Type":"NodeParagraph","Properties":{"id":"20240614091345-39dziwr","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.野杏 种仁含苦杏仁甙约4.84%，还含挥发油，其中主要成分有：下已醛(n-hexanal)占4.81%，反式-2-已烯醛(2-hexenal)占11.57%下已醇(n-hexanol)占14.38%，反式-2-已烯-1-醇(2-hexen-1-ol)占8.28%，芳樟醇占12.61%，a-松油醇占5.69%。牻牛儿醇(geraniol)占2.78%和十四烷酸(teradecanoic acid)占3.6%。"}]},{"ID":"20240614091345-c6j9yp9","Type":"NodeParagraph","Properties":{"id":"20240614091345-c6j9yp9","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.山杏 种仁含苦杏仁甙约4.84%。"}]},{"ID":"20240614091345-pazdrwm","Type":"NodeParagraph","Properties":{"id":"20240614091345-pazdrwm","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.东北杏 种仁含苦杏仁甙。"}]},{"ID":"20240614091345-idn7sx0","Type":"NodeParagraph","Properties":{"id":"20240614091345-idn7sx0","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614091345-vt76cf7","Type":"NodeParagraph","Properties":{"id":"20240614091345-vt76cf7","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.抗炎：杏仁球蛋白组分KR-A40mg/kg、KR-B5mg/kg、白蛋白组分KR-A0.5mg/kg、AR-B0.5mg/kg静脉搏注射，对角叉菜胶引起的大鼠足跖肿胀有抑制作用。"}]},{"ID":"20240614091345-n5mp4i1","Type":"NodeParagraph","Properties":{"id":"20240614091345-n5mp4i1","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.镇痛：杏仁球蛋白组分KR-A5mg/kg、KR-B5mg/kg、白蛋白组分AR-A5mg/kg、AR-B0.5mg/kg静脉注射，对小鼠苯醌扭体法试验，表明有镇痛作用。"}]},{"ID":"20240614091345-fv6s7j7","Type":"NodeParagraph","Properties":{"id":"20240614091345-fv6s7j7","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.对胃酸的作用：苦杏仁甙可被胃酸或苦杏仁酶水解，产生氢氰酸和苯甲醛，普通1g杏仁约可产生2.5mg氢氰酸。氢氰酸是剧毒物质，人的致死量大约为0.05g，苯甲醛可抑制胃蛋白酶的消化功能。服用小量杏仁，在体内慢慢水解，逐渐产生微量的氢氰酸，不致引起中毒，而呈镇静呼吸中枢的作用，因此能使呼吸运动趋于安静而显镇咳平喘的功效。"}]},{"ID":"20240614091345-hryux4d","Type":"NodeParagraph","Properties":{"id":"20240614091345-hryux4d","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.20%煎剂1ml/kg给猫静脉注射，可致明显持久的血压下降。"}]},{"ID":"20240614091345-2dyyjf1","Type":"NodeParagraph","Properties":{"id":"20240614091345-2dyyjf1","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"5.杏仁中含苦杏仁甙及苦杏仁酶，内服后，苦杏仁甙可被酶水解产生氢氰酸和苯甲醛，普通1g杏仁约可产生2.5mg氢氰酸。氢氰酸是剧毒物质，人的致死量大约0.05g（氰化钾约为0.2-0.3g），苯甲醛可抑制胃蛋白酶的消化功能，成人服苦杏仁约50-60个，小儿7-10个即可致死，致死原因主要为组织窒息，苦杏仁久贮，苦杏仁甙含量可减少，同时服糖，毒性可降低。关于杏仁中毒的报道不少，主要症状为呼吸困难，抽搐，昏迷，瞳孔散大，心跳速而弱，四肢冰冷，急救必须争取时间，立即口服活性炭或过锰酸钾（1：1000）或硫代硫酸钠（5%），尽快洗胃，并吸入亚硝酸异戊酯，静脉注射亚硝酸钠（3%10ml），随后注射硫代硫酸钠（25%50ml），及其他对症治疗如人工呼吸，输血等，有人认为服用小量杏仁，在体内慢慢分解，逐渐产生微量的氢氰酸，不致引起中毒，而呈镇静呼吸中枢的作用，因此能使呼吸运动趋于安静而奏镇咳平喘的功效。1/20最小致死量的氢氰酸静脉注射能短暂而强烈地兴奋呼吸中枢。直接涂于正常皮肤，可产生局部麻醉（如止痒等）。"}]},{"ID":"20240614091345-2mmhqb9","Type":"NodeParagraph","Properties":{"id":"20240614091345-2mmhqb9","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"6.抗癌作用：苦杏仁提取物按100mg和200mg／kg体重剂量灌胃10天，对小鼠移植性肝癌有明显的抑制作用。以200mg／kg体重剂量将苦否仁提取物分别给正常小鼠灌胃5天、10天、15天，灌胃5天后，小鼠肝P-450含量增高，灌胃10天和15天后恢复到正常水平。肝脏P-450含量变化。苦杏仁提取物对正常小鼠肝脏P-450有一时性升高作用。苦杏仁提取物以300mg／kg剂量给移植性肝癌小鼠腹腔注射14天，其肿瘤抑制率为72%（P＜O.001），以400mg／kg给移植性肝癌小鼠腹腔注射10天，其肿瘤抑制率为60.8%（P＜0.001），以600mg／kg剂量给移植性肝癌小鼠腹腔注射10天，其肿瘤抑制率为51.O%（P＜0.001）。移植性肝癌小鼠肝脏微粒体细胞色素P-450含量比正常小鼠显着下降（P＜0.001），但苦杏仁提取物给药（400mg／kg）10天，小鼠P-450含量达到了正常水平。移植性肝癌小鼠肝胞浆以1，2-二氯-4硝基苯（DCNB）为底物的GST活性显着升高（P＜0.001），而苦杏仁提取物给药组（400mg/kg）以DCNB为底物的GST活性高于肿瘤组（P＜0.05）。以1-氯-2，4-二硝基苯（CDNB）为底物的GST活性在肿瘤组与给药组同正常对照组比较无显着变化。就肝微粒体GST活性的变化情况来看，移植性肝癌小鼠以CDNB为底物的微粒体GST活性高于正常小鼠（P＜0.05），但苦否仁提取物给药组的该酶活性无显着变化。以DC-NB为底物的肝微粒体GST活性，无论在肝癌组和苦杏仁提取物给药组均无明显变化。"}]},{"ID":"20240614091345-chp37ja","Type":"NodeParagraph","Properties":{"id":"20240614091345-chp37ja","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"7.促进肺表面活性物质合成作用：苦杏仁在正常动物可促进肺表面活性物质的合成，在油酸型RDS实验动物不仅可促进肺表面活性物质的合成，并可使病变得到改善。"}]},{"ID":"20240614091345-qrv7m4d","Type":"NodeParagraph","Properties":{"id":"20240614091345-qrv7m4d","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"8.其它作用：苦杏仁甙有抗突变作用和预防和治疗抗肿瘤药阿脲引起的糖尿病的作用。此外，苦扁桃油（即苦杏仁油）有驱虫，杀菌作用。体外试验对人蛔虫，蚯蚓等均有杀死作用，并能杀死伤寒，副伤寒杆菌，临床应用对蛔虫，钩虫及蛲虫均有效，且无副作用。"}]},{"ID":"20240614091345-z88uu3s","Type":"NodeParagraph","Properties":{"id":"20240614091345-z88uu3s","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614091345-91ht121","Type":"NodeParagraph","Properties":{"id":"20240614091345-91ht121","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.杏仁：拣净杂质，置沸水中略煮，俟皮微皱起捞出，浸凉水中，脱去种皮，晒干，簸净。"}]},{"ID":"20240614091345-h441iy5","Type":"NodeParagraph","Properties":{"id":"20240614091345-h441iy5","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.炒杏仁：取净杏仁置锅内用文火炒至微黄色，取出放凉。"}]},{"ID":"20240614091345-lk2ahk2","Type":"NodeParagraph","Properties":{"id":"20240614091345-lk2ahk2","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614091345-6jya8jz","Type":"NodeParagraph","Properties":{"id":"20240614091345-6jya8jz","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" （1）取本品0.5g，置带塞试管中，加5%硫酸溶液3ml充分摇匀，在试管口放一用三硝基苯酚钠溶液湿润的滤纸条，塞紧塞子，试管置40-50℃水浴中加热10min，滤纸条由黄色变砖红色。（检查氰甙）（2）薄层色谱 取本品0.5g，加等量碳酸钙共研碎，放入带塞三角瓶内，加石油醚（60-90℃）4ml，冷浸过夜后，滤过。残渣挥干石油醚，加入乙醇4ml冷浸过夜，滤过。滤液浓缩作供试品。以苦杏仁甙作对照。分别点样于同一硅胶G薄层板上，以氯仿-乙酸乙酯-乙醇（2：1：2）展开，碘蒸气显色。供试品色谱中，在与对照品色谱的相应位置上，显相同颜色的斑点。"}]},{"ID":"20240614091345-qpqlq03","Type":"NodeParagraph","Properties":{"id":"20240614091345-qpqlq03","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614091345-gnuvkhm","Type":"NodeParagraph","Properties":{"id":"20240614091345-gnuvkhm","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 肺；脾；大肠经"}]},{"ID":"20240614091345-y4ikpwf","Type":"NodeParagraph","Properties":{"id":"20240614091345-y4ikpwf","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614091345-719cilg","Type":"NodeParagraph","Properties":{"id":"20240614091345-719cilg","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 苦；温；有毒"}]},{"ID":"20240614091345-w8h8upr","Type":"NodeParagraph","Properties":{"id":"20240614091345-w8h8upr","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614091345-ywb5glv","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240614091345-ywb5glv","updated":"20240614091345"},"Children":[{"ID":"20240614091345-j5guld6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240614091345-j5guld6","updated":"20240614091345"},"Children":[{"ID":"20240614091345-srntp8h","Type":"NodeParagraph","Properties":{"id":"20240614091345-srntp8h","updated":"20240614091345"}}]}]},{"ID":"20240614091345-xqe3z51","Type":"NodeParagraph","Properties":{"id":"20240614091345-xqe3z51","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：得火良。恶黄耆、黄芩、葛根。畏蘘草。"}]},{"ID":"20240614091345-ud5tv9e","Type":"NodeParagraph","Properties":{"id":"20240614091345-ud5tv9e","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：阴虚咳嗽，肺家有虚热、热痰者忌之。"}]},{"ID":"20240614091345-539iixm","Type":"NodeParagraph","Properties":{"id":"20240614091345-539iixm","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.《本草正》：元气虚陷者勿用，恐其沉降太泄。"}]},{"ID":"20240614091345-x3zzm79","Type":"NodeParagraph","Properties":{"id":"20240614091345-x3zzm79","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"5.《本经逢原》：亡血家尤为切禁。"}]},{"ID":"20240614091345-pahg5cc","Type":"NodeParagraph","Properties":{"id":"20240614091345-pahg5cc","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"6.《本草从新》：因虚而咳嗽便秘者忌之。"}]},{"ID":"20240614091345-ys1qj65","Type":"NodeParagraph","Properties":{"id":"20240614091345-ys1qj65","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614091345-fa9m022","Type":"NodeParagraph","Properties":{"id":"20240614091345-fa9m022","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 祛痰止咳；平喘；润肠；下气开痹。主外感咳嗽；喘满；伤燥咳嗽；寒气奔豚；惊痫；胸痹；食滞脘痛；血崩；耳聋；疳肿胀；湿热淋证；疥疮；喉痹；肠燥便秘"}]},{"ID":"20240614091345-2or7e6i","Type":"NodeParagraph","Properties":{"id":"20240614091345-2or7e6i","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614091345-dtvpbdo","Type":"NodeParagraph","Properties":{"id":"20240614091345-dtvpbdo","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。外用：捣敷。"}]},{"ID":"20240614091345-n43a0xi","Type":"NodeParagraph","Properties":{"id":"20240614091345-n43a0xi","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614091345-rd400rg","Type":"NodeParagraph","Properties":{"id":"20240614091345-rd400rg","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.麻黄汤(《伤寒论》)，用治外感风寒。2.三拗汤(《太平惠民和剂局方》)，用治感受风邪，鼻塞身重，语音不出，或伤风伤冷，头痛目眩，四肢拘绻，咳嗽痰多，胸满气短。3.大青龙汤(《伤寒论》)，用治风热袭肺，或风寒郁而化火，壅遏于肺的喘咳证。5.麻黄杏仁薏苡甘草汤(《伤寒论》)，用治风湿在表的风寒表湿证。"}]},{"ID":"20240614091345-mjxptkh","Type":"NodeParagraph","Properties":{"id":"20240614091345-mjxptkh","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614091345-pkmjvxq","Type":"NodeParagraph","Properties":{"id":"20240614091345-pkmjvxq","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主咳逆上气雷鸣，喉痹，下气，产乳金疮，寒心奔豚。"}]},{"ID":"20240614091345-gds41mu","Type":"NodeParagraph","Properties":{"id":"20240614091345-gds41mu","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：解锡、胡粉毒。"}]},{"ID":"20240614091345-s7shfc8","Type":"NodeParagraph","Properties":{"id":"20240614091345-s7shfc8","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"3.《名医别录》：主惊癎，心下烦热，风气去来，时行头痛，解肌，消心下急，杀狗毒。"}]},{"ID":"20240614091345-5q3sc2k","Type":"NodeParagraph","Properties":{"id":"20240614091345-5q3sc2k","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：治腹痹不通，发汗，主温病。治心下急满痛，除心腹烦闷，疗肺气咳嗽，上气喘促。入天门冬煎，润心肺。可和酪作汤，益润声气。宿即动冷气。"}]},{"ID":"20240614091345-s3t6kju","Type":"NodeParagraph","Properties":{"id":"20240614091345-s3t6kju","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"5.崔禹锡《食经》：理风噤及言吮不开。"}]},{"ID":"20240614091345-zq843wa","Type":"NodeParagraph","Properties":{"id":"20240614091345-zq843wa","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"6.《医学启源》：除肺中燥，治风燥在于胸膈。《主治秘诀》云，润肺气，消食，升滞气。"}]},{"ID":"20240614091345-sy4mm3r","Type":"NodeParagraph","Properties":{"id":"20240614091345-sy4mm3r","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"7.《滇南本草》：止咳嗽，消痰润肺，润肠胃，消面粉积，下气。治疳虫。"}]},{"ID":"20240614091345-z4wwv0q","Type":"NodeParagraph","Properties":{"id":"20240614091345-z4wwv0q","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"8.《本草纲目》：杀虫，治诸疮疥，消肿，去头面诸风气皶疱。"}]},{"ID":"20240614091345-4wm9h1q","Type":"NodeParagraph","Properties":{"id":"20240614091345-4wm9h1q","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"9.李杲：杏仁下喘，治气也。桃仁疗狂，治血也。桃、杏仁俱治大便秘，当以气血分之。昼则难便，行阳气也；夜则难便，行阴血也。故虚人大便燥秘不可过泄者，脉浮在气，用杏仁、陈皮；脉沉在血，用桃仁、陈皮；所以俱用陈皮者，以手阳明与手太阴为表里也。贲门上，主往来，魄门下，主收闭。故王氏言，肺与大肠为通道也。"}]},{"ID":"20240614091345-hpd3xyu","Type":"NodeParagraph","Properties":{"id":"20240614091345-hpd3xyu","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"10.《本草纲目》：杏仁能散能降，故解肌、散风、降气、润燥、消积，治伤损药中用之。治疮杀虫，用其毒也。治风寒肺病药中，亦有连皮尖用者，取其发散也。"}]},{"ID":"20240614091345-xsp1yuv","Type":"NodeParagraph","Properties":{"id":"20240614091345-xsp1yuv","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"11.《长沙药解》：肺主藏气，降于胸膈而行于经络，气逆则胸膈闭阻而生喘咳，藏病而不能降，因以痞塞，经病而不能行，于是肿痛。杏仁疏利开通，破壅降逆，善于开痹而止喘，消肿而润燥，调理气分之郁，无以易此。其诸主治，治咳逆，调失音，止咯血，断血崩，杀虫NI，除ZHA刺，开耳聋，去目翳，平胬肉，消停食，润大肠，通小便，种种功效，皆其降浊消郁之能事也。"}]},{"ID":"20240614091345-961twaa","Type":"NodeParagraph","Properties":{"id":"20240614091345-961twaa","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"12.《本草求真》：杏仁，既有发散风寒之能，复有下气除喘之力，缘辛则散邪，苦则下气，润则通秘，温则宣滞行痰。杏仁气味俱备，故凡肺经感受风寒，而见喘嗽咳逆、胸满便秘、烦热头痛，与夫蛊毒、疮疡、狗毒、面毒、锡毒、金疮，无不可以调治。东垣论杏仁与紫菀，均属宣肺除郁开溺，而一主于肺经之血，一主于肺经之气；杏仁与桃仁，俱治便秘，而一治其脉浮气喘便秘，于昼而见；一治其脉沉狂发便秘，于夜而见。冯楚瞻论杏仁、栝萎，均属除痰，而一从腠理中发散以祛，故表虚者最忌；一从肠胃中清利以除，故里虚者切忌。诸药貌虽相同，而究实有分辨，不可不细审而详察也。但用杏仁以治便秘，须用陈皮以佐，则气始通。"}]},{"ID":"20240614091345-dkxn9v1","Type":"NodeParagraph","Properties":{"id":"20240614091345-dkxn9v1","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"13.《药征》：杏仁主治胸间停水，故治喘咳，而旁治短气结胸，心痛，形体浮肿。"}]},{"ID":"20240614091345-ssxfypx","Type":"NodeParagraph","Properties":{"id":"20240614091345-ssxfypx","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"14.《本经疏证》：麻黄汤、大青龙汤、麻黄杏仁甘草石膏汤、麻黄加术汤、麻黄杏仁薏苡甘草汤、厚朴麻黄汤、文蛤汤，皆麻黄、杏仁并用，盖麻黄主开散，其力悉在毛窍，非借杏仁伸其血络中气，则其行反濡缓而有所伤，则可谓麻黄之于杏仁，犹桂枝之于芍药，水母之于虾矣。"}]},{"ID":"20240614091345-a7k3qqp","Type":"NodeParagraph","Properties":{"id":"20240614091345-a7k3qqp","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"15.《本草便读》：凡仁皆降，故（杏仁）功专降气，气降则痰消嗽止。能润大肠，故大肠气闭者可用之。考杏仁之性似无辛味，似乎止有润降之功，而无解散立力，但风寒外束，肺气壅逆，不得不用此苦降之品，使气顺而表方得解，故麻黄汤用之，亦此意耳。桃仁、杏仁，其性相似，一入肝经血分，一入肺经气分。至于解毒杀虫，彼此均可，在乎用者之神明耳。"}]},{"ID":"20240614091345-lxhjcv4","Type":"NodeParagraph","Properties":{"id":"20240614091345-lxhjcv4","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614091345-7b4guu7","Type":"NodeParagraph","Properties":{"id":"20240614091345-7b4guu7","updated":"20240614091345"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614091346-u8i9qe3","Type":"NodeThematicBreak","Properties":{"id":"20240614091346-u8i9qe3"}},{"ID":"20240614091347-r1j3zui","Type":"NodeParagraph","Properties":{"id":"20240614091347-r1j3zui"}}]}