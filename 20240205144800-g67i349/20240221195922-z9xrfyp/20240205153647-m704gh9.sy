-style":"width: 700px;","style":"width: 690px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星1-20240627174956-qesc79h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 690px;\" parent-style=\"width: 700px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星 3-20240822105310-86ef2f9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822105352-ik4q7uy","Type":"NodeParagraph","Properties":{"id":"20240822105352-ik4q7uy","updated":"20240822105352"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 429px;","style":"width: 419px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星 4-20240822105352-tdk4jd4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 419px;\" parent-style=\"width: 429px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 385px;","style":"width: 375px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星3-20240628083420-86fem32.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 375px;\" parent-style=\"width: 385px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星4-20240628083724-7egzau4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822105442-ilj1ti2","Type":"NodeParagraph","Properties":{"id":"20240822105442-ilj1ti2","updated":"20240822105558"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星 5-20240822105442-fcvy6cp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 298px;","style":"width: 288px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星 6-20240822105517-6go317q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 288px;\" parent-style=\"width: 298px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 298px;","style":"width: 288px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天南星 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天南星 7-20240822105558-ujil3t2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 288px;\" parent-style=\"width: 298px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628084558-sgncjso","Type":"NodeParagraph","Properties":{"id":"20240628084558-sgncjso","updated":"20240822105615"}},{"ID":"20240717194326-vd999p8","Type":"NodeParagraph","Properties":{"id":"20240717194326-vd999p8","updated":"20240718081924"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"禹南星（禹州天南星）"}]},{"ID":"20240717194338-g4popjg","Type":"NodeParagraph","Properties":{"id":"20240717194338-g4popjg","updated":"20240822105625"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 362px;","style":"width: 352px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"禹南星"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/禹南星-20240717194417-olwa4te.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 352px;\" parent-style=\"width: 362px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 809px;","style":"width: 799px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"虎掌"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/虎掌-20240717194251-bnlo735.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 799px;\" parent-style=\"width: 809px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612170631-73630w9","Type":"NodeParagraph","Properties":{"id":"20240612170631-73630w9","updated":"20240628084136"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：天南星用的是根部块茎。"}]},{"ID":"20240612170632-cw3151v","Type":"NodeThematicBreak","Properties":{"id":"20240612170632-cw3151v"}},{"ID":"20240612170633-uejs2mu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170633-uejs2mu","updated":"20240612170638"},"Children":[{"Type":"NodeText","Data":"虎掌《神农本草经》"}]},{"ID":"20240612170633-1ukw5ua","Type":"NodeParagraph","Properties":{"id":"20240612170633-1ukw5ua","updated":"20240612170633"},"Children":[{"Type":"NodeText","Data":"味苦温。"}]},{"ID":"20240612170633-32iasy4","Type":"NodeParagraph","Properties":{"id":"20240612170633-32iasy4","updated":"20240612170633"},"Children":[{"Type":"NodeText","Data":"主心痛，寒热，结气，积聚，伏梁，伤筋，痿，拘缓，利水道。生山谷。"}]},{"ID":"20240612170633-fgbo9th","Type":"NodeParagraph","Properties":{"id":"20240612170633-fgbo9th","updated":"20240612170633"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：虎掌，神农雷公苦无毒，岐伯桐君辛有毒，立秋九月采之（《御览》引云，或生太山，或宛朐）。"}]},{"ID":"20240612170633-yyq7rhb","Type":"NodeParagraph","Properties":{"id":"20240612170633-yyq7rhb","updated":"20240612170633"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汉中及冤句，二月、八月采，阴干。"}]},{"ID":"20240612170633-yc1q20v","Type":"NodeParagraph","Properties":{"id":"20240612170633-yc1q20v","updated":"20240612170633"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：虎掌，瓜属也。"}]},{"ID":"20240612170645-jekylmz","Type":"NodeThematicBreak","Properties":{"id":"20240612170645-jekylmz"}},{"ID":"20240612170646-sapweve","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170646-sapweve","updated":"20240612170652"},"Children":[{"Type":"NodeText","Data":"虎掌《新修本草》"}]},{"ID":"20240612170646-l1e1zf3","Type":"NodeParagraph","Properties":{"id":"20240612170646-l1e1zf3","updated":"20240612170646"},"Children":[{"Type":"NodeText","Data":"味苦，温、微寒，有大毒。主心痛，寒热结气，积聚伏梁，伤筋痿拘缓，利水道。除阴下湿，风眩。生汉中山谷及宛朐。二月、八月采，阴干。"}]},{"ID":"20240612170646-23d0jnz","Type":"NodeParagraph","Properties":{"id":"20240612170646-23d0jnz","updated":"20240612170646"},"Children":[{"Type":"NodeText","Data":"蜀漆为之使，恶莽草。近道亦有，极似半夏，但皆大，四边有子如虎掌。今用多破之，或三、四片耳，方药亦不正用也。"}]},{"ID":"20240612170649-m3e2m56","Type":"NodeParagraph","Properties":{"id":"20240612170649-m3e2m56","updated":"20240612170738"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药，是由跋宿者，其苗一茎，茎头一叶，枝丫夹茎。根大者如拳，小者若卵，都似扁柿，四畔有圆牙，看如虎掌，故有此名。其由跋是新根，犹大于半夏二、三倍，但四畔无子牙耳。陶云虎掌似半夏，也即由跋，以由跋为半夏，释由跋苗全说鸢尾，南人至今犹用由跋为半夏也。"}]},{"ID":"20240612170135-f7xw8sw","Type":"NodeThematicBreak","Properties":{"id":"20240612170135-f7xw8sw"}},{"ID":"20240612170604-xkpu0pz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170604-xkpu0pz","updated":"20240612170608"},"Children":[{"Type":"NodeText","Data":"虎掌《本草纲目》"}]},{"ID":"20240612170604-c2vgz1o","Type":"NodeParagraph","Properties":{"id":"20240612170604-c2vgz1o","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"「释名」虎膏、鬼。"}]},{"ID":"20240612170604-ryctx6p","Type":"NodeParagraph","Properties":{"id":"20240612170604-ryctx6p","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"「气味」苦、温、有大毒。"}]},{"ID":"20240612170604-h3t4bk2","Type":"NodeParagraph","Properties":{"id":"20240612170604-h3t4bk2","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612170604-z5ufk7t","Type":"NodeParagraph","Properties":{"id":"20240612170604-z5ufk7t","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"1、中风口噤目闭。用天南星研为末，加白龙脑等分，调匀。每次用手指点末擦啮二、三十遍，口自开。此方名“开失散”或“破棺散”。"}]},{"ID":"20240612170604-x04nfyq","Type":"NodeParagraph","Properties":{"id":"20240612170604-x04nfyq","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"2、小儿惊风。用一两重的天南星一个，放酒中浸透。取出，安新瓦上，周围用炭火炙裂。放冷，出火毒。研为末，加朱砂一分。每服半钱，荆芥汤调下。每日空心服一次。午时再服一次。此主名“坠涎散”。"}]},{"ID":"20240612170604-1tsx6r2","Type":"NodeParagraph","Properties":{"id":"20240612170604-1tsx6r2","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"3、口眼斜。用天南星（生）研为末，自然姜汁调匀。病在左，敷右侧；病在右，敷左侧。"}]},{"ID":"20240612170604-qc6gpxx","Type":"NodeParagraph","Properties":{"id":"20240612170604-qc6gpxx","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"4、角弓反张。用天南星、半夏，等分为末，姜汁、竹沥灌下一钱。同时烘炙印堂。"}]},{"ID":"20240612170604-f5n8vvj","Type":"NodeParagraph","Properties":{"id":"20240612170604-f5n8vvj","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"5、痰迷心窍（心胆被惊，神不守舍，恍惚健忘，妄言妄见）。用天南星一斤，先掘一土坑，以炭火三十斤烧红，倒入酒五升，渗干后，把天南星安放在内，用盆盖住，勿令走气。次日取出研为末，加琥珀一两、朱砂二两，共研细，以生姜汁调面将药做成丸子，如梧子大。每服三十至五十丸，煎人参、石菖蒲汤送下。一天服三次此方名“寿星丸”。"}]},{"ID":"20240612170604-odvi4hq","Type":"NodeParagraph","Properties":{"id":"20240612170604-odvi4hq","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"6、吐泄不止，四肢厥逆，甚至不省人事。用天南星研为末，每服三钱，加枣二枚，水二盅，煎取八成，温服。无效，可再服。此方名“回阳散”。"}]},{"ID":"20240612170604-e04dr0i","Type":"NodeParagraph","Properties":{"id":"20240612170604-e04dr0i","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"7、小儿解颅（囟门不合，鼻塞不通）。用天南星炮过，去皮，研为末，加淡醋调匀摊布上，贴囟门，再把手烘热，频频在囟门处摩熨。"}]},{"ID":"20240612170604-smbjj32","Type":"NodeParagraph","Properties":{"id":"20240612170604-smbjj32","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"8、下颚脱。用天南星末，调姜汁涂两颊，一夜即能使关节处长原。"}]},{"ID":"20240612170604-zkufoox","Type":"NodeParagraph","Properties":{"id":"20240612170604-zkufoox","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"9、喉风喉痹。用天南星一个，挖空，放入白僵蚕七枚，纸包煨熟，研为末，姜汁调服一钱。病重者灌下，吐涎即愈。此方名“如圣散”。"}]},{"ID":"20240612170604-kdyfazv","Type":"NodeParagraph","Properties":{"id":"20240612170604-kdyfazv","updated":"20240612170604"},"Children":[{"Type":"NodeText","Data":"10、身面疣子。用醋调天南星末涂搽。"}]},{"ID":"20240612170618-lbv8t30","Type":"NodeThematicBreak","Properties":{"id":"20240612170618-lbv8t30"}},{"ID":"20240612170619-drc13y5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170619-drc13y5","updated":"20240612170625"},"Children":[{"Type":"NodeText","Data":"虎掌《增广和剂局方药性总论》"}]},{"ID":"20240612170619-f58scdj","Type":"NodeParagraph","Properties":{"id":"20240612170619-f58scdj","updated":"20240612170619"},"Children":[{"Type":"NodeText","Data":"味苦，温、微寒，有大毒。主心痛，寒热，结气，积聚，伏梁，伤筋，萎，拘缓，利水道，除阴下湿，风眩。《药性论》云∶使。味甘。能治风眩目转，疝瘕肠痛，伤寒时疾，强阴。蜀漆为之使。恶∶莽草。生∶汉中山谷及冤句。二月、八月采，阴干。"}]},{"ID":"20240612170136-4iomwf4","Type":"NodeThematicBreak","Properties":{"id":"20240612170136-4iomwf4"}},{"ID":"20240612170152-c86mfoe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170152-c86mfoe","updated":"20240612170200"},"Children":[{"Type":"NodeText","Data":"虎掌《证类本草》"}]},{"ID":"20240612170145-r7xx651","Type":"NodeParagraph","Properties":{"id":"20240612170145-r7xx651","updated":"20240612170145"},"Children":[{"Type":"NodeText","Data":"味苦，温、微寒，有大毒。主心痛，寒热结气，积聚伏梁，伤筋痿拘缓，利水道，除阴下湿，风眩。生汉中山谷及冤句。二月、八月采，阴干。（蜀漆为之使，恶莽草。）"}]},{"ID":"20240612170145-5dmr24h","Type":"NodeParagraph","Properties":{"id":"20240612170145-5dmr24h","updated":"20240612170145"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道亦有。形似半夏，但皆大。四边有子如虎掌。今用多破之或三、四片尔。"}]},{"ID":"20240612170145-gfo9jtn","Type":"NodeParagraph","Properties":{"id":"20240612170145-gfo9jtn","updated":"20240612170145"},"Children":[{"Type":"NodeText","Data":"方药亦不正用也。唐本注云∶此药是由跋宿者。其苗一茎，茎头一叶，枝丫（音鸦） （古协切）"}]},{"ID":"20240612170145-5j1vjph","Type":"NodeParagraph","Properties":{"id":"20240612170145-5j1vjph","updated":"20240612170145"},"Children":[{"Type":"NodeText","Data":"茎。根大者如拳，小者如鸡卵，都似扁柿，四畔有圆牙，看如虎掌，故有此名。其由跋是新根，犹大于半夏二、三倍，但四畔无子牙尔。陶云虎掌似半夏，即由跋，以由跋为半夏，释由跋苗，全说鸢尾南人至今犹用由跋为半夏也。臣禹锡等谨按蜀本图经云∶其茎端有八、九叶，花生茎间。根周遭有芽，然若兽掌也。吴氏云∶虎掌，神农、雷公∶苦，无毒。歧伯、桐君∶辛，有毒。立秋，九月采。药性论云∶虎掌，使，味甘。不入汤服，治风眩目转，主疝瘕肠痛，主伤寒时疾，强阴。"}]},{"ID":"20240612170145-qf5o2zg","Type":"NodeParagraph","Properties":{"id":"20240612170145-qf5o2zg","updated":"20240612170145"},"Children":[{"Type":"NodeText","Data":"图经曰∶虎掌，生汉中山谷及冤句，今河北州郡亦有之。初生根如豆大，渐长大似半夏而扁，累年者，其根圆及寸，大者如鸡卵。周回生圆芽二、三枚，或五、六枚。三月、四月生苗，高尺余。独茎上有叶如爪，五、六出分布，尖而圆。一窠生七、八茎，时出一茎作穗，直上如鼠尾。中生一叶如匙，裹茎作房，旁开一口，上下尖。中有花，微青褐色。结实如麻子大，熟即白色，自落布地，一子生一窠。九月苗残取根，以汤入器中，渍五、七日，汤冷乃易。日换三、四遍，洗去涎，曝干用之。或再火炮。今冀州人菜园中种之，亦呼为天南星。江州有一种草，叶大如掌，面青背紫，四畔有芽如虎掌，生三、五叶为一本，冬青。治心痛寒热积气，不结花实，与此名同，故附见之。"}]},{"ID":"20240612170145-o43tb3k","Type":"NodeThematicBreak","Properties":{"id":"20240612170145-o43tb3k"}},{"ID":"20240612170205-5ngml7c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170205-5ngml7c","updated":"20240612170210"},"Children":[{"Type":"NodeText","Data":"虎掌《本草乘雅半偈》"}]},{"ID":"20240612170205-2cls9dn","Type":"NodeParagraph","Properties":{"id":"20240612170205-2cls9dn","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240612170205-kzo0nui","Type":"NodeParagraph","Properties":{"id":"20240612170205-kzo0nui","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"【气味】苦温，有大毒。"}]},{"ID":"20240612170205-4pi6215","Type":"NodeParagraph","Properties":{"id":"20240612170205-4pi6215","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"【主治】主心腹寒热结气，积聚伏梁，伤筋痿拘挛，利水道。"}]},{"ID":"20240612170205-m2rmdty","Type":"NodeParagraph","Properties":{"id":"20240612170205-m2rmdty","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出汉中山谷，及冤句、安东、河北州郡，近道亦有之。四月生苗，高尺余。"}]},{"ID":"20240612170205-ih6i3g0","Type":"NodeParagraph","Properties":{"id":"20240612170205-ih6i3g0","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"独茎上有叶如爪，一窠生八九茎，时出一茎作穗，直上如鼠尾。中生一叶如匙，裹茎作房，旁开一口，上下尖。中有花，青褐色。结实如麻子，熟便白色，自落布地，一子只一窠。九月叶残取根。但初孕之根，仅如豆大，渐长者似半夏而扁，年久者始圆及寸，大如鸡卵。周匝生芽，三四枝，或五六枝，圆如指顶，宛若虎掌。冀州一种，呼天南星，二月生苗，高一、二二、八月采根，似芋而扁，与 相类，人多误采，了不可辨。但 茎斑花紫，南星根小肌腻，炮之易裂为别。然南星即虎掌，同类而异种。其根大者，周匝亦有圆芽，但不若虎掌茎叶似爪，五出分列也。江州一种，草虎掌，叶大如掌，面青背紫，三四叶为一本，经冬不凋，不结花实，根之四畔，亦有圆芽，名象虽同治疗迥别。修事，取重一两者，气专力倍。"}]},{"ID":"20240612170205-mh66rqf","Type":"NodeParagraph","Properties":{"id":"20240612170205-mh66rqf","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"用治风痰，生用须温汤洗净，再以白矾作汤，或皂角煎汁，浸二三日，每日一换，浸足暴干。熟用，择黄土地上，掘一小坑，深五六寸，先以炭火烧红，次用好酒沃之，乃安虎掌于坑内，上以瓦盆覆定，灰泥固济，过夜取用。设急用，用湿纸包裹，埋糠灰火中，周匝绽裂，便可用矣。一法∶以酒浸一宿，用桑柴火蒸之，尝令洒酒入甑内，令气猛。一伏时取出，竹刀剖开，味不麻舌为度。一法以生姜杵碎，和黄泥包虎掌煨熟，去泥焙用。若造曲用，生姜汁，及矾作汤，和虎掌末作小饼子，安篮内，楮叶包盖，俟上有黄衣生，取晒收之。造胆星法∶将虎掌研末，腊月取黄牯牛胆汁和匀，纳胆囊内，悬系有风处，干之，年久弥佳。蜀漆为之使。恶莽草。"}]},{"ID":"20240612170205-9ofr483","Type":"NodeParagraph","Properties":{"id":"20240612170205-9ofr483","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"先人云∶名色性气，合属燥金；味苦气温又得火化，为肺金之用药也。与易称 万物令燥者合其德，当治风，第可平诸疾生风，不可平风生诸疾，以非真实燥故。其治诸暴强直，支痛里急，筋缩 戾，平以虎掌，风从燥已矣。"}]},{"ID":"20240612170205-iu50jik","Type":"NodeParagraph","Properties":{"id":"20240612170205-iu50jik","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"【 】曰∶命名虎掌，不独茎叶根 形相似也，虎力在掌，故主寒热气结，积聚伏梁，以及心腹，若探囊耳。盖掌用在筋，且风生从虎，故主厥阴风木，变生筋主为病，以致筋痿挛拘也。风行水涣，故并利水道。"}]},{"ID":"20240612170205-r94x01u","Type":"NodeParagraph","Properties":{"id":"20240612170205-r94x01u","updated":"20240612170205"},"Children":[{"Type":"NodeText","Data":"（厥阴变眚，则风木之化不行焉。虎啸风生，从其类也。风感水受，水道乃行，故利水道。）"}]},{"ID":"20240612170453-5rvw4p2","Type":"NodeThematicBreak","Properties":{"id":"20240612170453-5rvw4p2"}},{"ID":"20240612170454-vspte3w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170454-vspte3w","updated":"20240612170500"},"Children":[{"Type":"NodeText","Data":"虎掌《神农本草经赞》"}]},{"ID":"20240612170454-x3f716v","Type":"NodeParagraph","Properties":{"id":"20240612170454-x3f716v","updated":"20240612170454"},"Children":[{"Type":"NodeText","Data":"味苦温。主心痛。寒热结气。积聚伏梁。伤筋痿拘缓。利水道。生山谷。（今名天南星）布地荑科。萌生毒卉。翘企蛇头。细抽鼠尾。圆掌威伸。繁星光炜。由跋根新。体孱才菲。"}]},{"ID":"20240612170454-matkro2","Type":"NodeParagraph","Properties":{"id":"20240612170454-matkro2","updated":"20240612170454"},"Children":[{"Type":"NodeText","Data":"谢灵运赋。散叶荑科。国语。逆节萌生。柳宗元记。嘉葩毒卉。苏颂曰。初生作穗直上如鼠尾。花似蛇头。结子自落布地。一子生一窠。苏恭曰。根似扁柿。四畔有圆牙。看如虎掌。"}]},{"ID":"20240612170454-u02pbxo","Type":"NodeParagraph","Properties":{"id":"20240612170454-u02pbxo","updated":"20240612170454"},"Children":[{"Type":"NodeText","Data":"傅咸表。威风得伸。庾阐诗。繁星如散锦。李时珍曰。虎掌因叶形似之。非根也。南星因根圆白。形如老人星状。故名由跋。是南星之新根。其气未足。不堪服食。梁萧赋。才菲而体孱。"}]},{"ID":"20240612170506-cxigqac","Type":"NodeThematicBreak","Properties":{"id":"20240612170506-cxigqac"}},{"ID":"20240612170508-oyvkawl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170508-oyvkawl","updated":"20240612170516"},"Children":[{"Type":"NodeText","Data":"虎掌《本草图经》"}]},{"ID":"20240612170508-ehf7dpq","Type":"NodeParagraph","Properties":{"id":"20240612170508-ehf7dpq","updated":"20240612170521"},"Children":[{"Type":"NodeText","Data":"虎掌，生汉中山谷及冤句，今河北州郡亦有之。初生根如豆大，渐长大，似半夏而扁，累年者其根圆及寸，大者如鸡卵。周匝生圆芽二、三枚或五、六枚；三月、四月生苗，高尺余；独茎上有叶如爪，五、六出分布，尖而圆；一窠生七、八茎，时出一茎作穗，直上如鼠尾；中生一叶如匙，裹茎作房，旁开一口，上下尖，中有花，微青褐色；结实如麻子大，熟即白色，自落布地，一子生一窠。九月苗残取根，以汤入器中，渍三、七日，汤冷乃易，日换三、四遍，洗去涎，曝干用之。或再火炮。今冀州人菜园中种之，亦呼为天南星。江州有一种草，叶大如掌，面青背紫，四畔有芽如虎掌，生三、五叶为一本，冬青。治心痛寒热积气。"}]},{"ID":"20240612170508-kq1ef82","Type":"NodeParagraph","Properties":{"id":"20240612170508-kq1ef82","updated":"20240612170508"},"Children":[{"Type":"NodeText","Data":"不结花实，与此名同，故附见之。"}]},{"ID":"20240612170549-366phna","Type":"NodeThematicBreak","Properties":{"id":"20240612170549-366phna"}},{"ID":"20240612170550-esfpkt7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170550-esfpkt7","updated":"20240612170555"},"Children":[{"Type":"NodeText","Data":"虎掌《医学入门》"}]},{"ID":"20240612170550-04cscqh","Type":"NodeParagraph","Properties":{"id":"20240612170550-04cscqh","updated":"20240612170550"},"Children":[{"Type":"NodeText","Data":"山谷近道有之。其苗一茎，茎头一叶，五六出如爪，根似大半夏，四周生芽如虎掌。味苦，微寒，有大毒。主利水道，除阴下湿，风眩目转，心腹寒热结气，疝瘕肠痛，积聚伏梁，筋痿拘缓。汤泡七次，火煨。"}]},{"ID":"20240612170550-vozoi54","Type":"NodeParagraph","Properties":{"id":"20240612170550-vozoi54","updated":"20240612170550"},"Children":[{"Type":"NodeText","Data":"蜀漆为使。畏莽草。"}]},{"ID":"20240612170539-0lap1qv","Type":"NodeThematicBreak","Properties":{"id":"20240612170539-0lap1qv"}},{"ID":"20240612170540-r5zdn1c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170540-r5zdn1c","updated":"20240612170544"},"Children":[{"Type":"NodeText","Data":"虎掌《本草经集注》"}]},{"ID":"20240612170540-5uyzlqz","Type":"NodeParagraph","Properties":{"id":"20240612170540-5uyzlqz","updated":"20240612170540"},"Children":[{"Type":"NodeText","Data":"味苦，温、微寒，有大毒。主治心痛，寒热，结气，积聚，伏梁，伤筋痿拘缓，利水道。"}]},{"ID":"20240612170540-cfhtdtu","Type":"NodeParagraph","Properties":{"id":"20240612170540-cfhtdtu","updated":"20240612170540"},"Children":[{"Type":"NodeText","Data":"除阴下湿，风眩。生汉中山谷及宛朐。二月、八月采，阴干。（蜀漆为之使，恶莽草。）"}]},{"ID":"20240612170540-ylod5qa","Type":"NodeParagraph","Properties":{"id":"20240612170540-ylod5qa","updated":"20240612170540"},"Children":[{"Type":"NodeText","Data":"近道亦有，极似半夏，但皆大，四边有子如虎掌。今用多破之，或三、四片尔，方药亦不正用也。"}]},{"ID":"20240612170528-90i2962","Type":"NodeThematicBreak","Properties":{"id":"20240612170528-90i2962"}},{"ID":"20240612170529-goyj6hx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170529-goyj6hx","updated":"20240612170533"},"Children":[{"Type":"NodeText","Data":"虎掌《名医别录》"}]},{"ID":"20240612170529-xkr6kuv","Type":"NodeParagraph","Properties":{"id":"20240612170529-xkr6kuv","updated":"20240612170529"},"Children":[{"Type":"NodeText","Data":"微寒，有大毒．除阴下湿，风眩．生汉中及宛朐．二月、八月采，阴干．（蜀漆为之恶莽草．）"}]},{"ID":"20240612170529-666gw5j","Type":"NodeParagraph","Properties":{"id":"20240612170529-666gw5j","updated":"20240612170529"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶虎掌，味苦，温．主心痛，寒热结气，积聚伏梁，伤筋痿拘缓，利水道．生山谷．"}]},{"ID":"20240612170417-ik15k97","Type":"NodeThematicBreak","Properties":{"id":"20240612170417-ik15k97"}},{"ID":"20240612170418-7542155","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170418-7542155","updated":"20240612170423"},"Children":[{"Type":"NodeText","Data":"虎掌《吴普本草》"}]},{"ID":"20240612170418-3ckxl8a","Type":"NodeParagraph","Properties":{"id":"20240612170418-3ckxl8a","updated":"20240612170418"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十"}]},{"ID":"20240612170418-exlt7si","Type":"NodeParagraph","Properties":{"id":"20240612170418-exlt7si","updated":"20240612170418"},"Children":[{"Type":"NodeText","Data":"神农、雷公∶苦，无毒。岐伯、桐君∶辛，有毒。或生太山，或宛朐。立秋九月采。"}]},{"ID":"20240612170442-9gbk53t","Type":"NodeThematicBreak","Properties":{"id":"20240612170442-9gbk53t"}},{"ID":"20240612170443-tchbi30","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170443-tchbi30","updated":"20240612170447"},"Children":[{"Type":"NodeText","Data":"虎掌《千金翼方》"}]},{"ID":"20240612170443-huq5fj1","Type":"NodeParagraph","Properties":{"id":"20240612170443-huq5fj1","updated":"20240612170443"},"Children":[{"Type":"NodeText","Data":"味苦，温，微寒，有大毒。主心痛寒热，结气积聚，伏梁，伤筋痿拘缓，利水道。除阴下湿，风眩。生汉中山谷及冤句，二月八月采，阴干。"}]},{"ID":"20240612170330-spqobi8","Type":"NodeThematicBreak","Properties":{"id":"20240612170330-spqobi8"}},{"ID":"20240612170353-3krskhd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170353-3krskhd","updated":"20240612170403"},"Children":[{"Type":"NodeText","Data":"天南星《本草图经》"}]},{"ID":"20240612170353-ucmcxuj","Type":"NodeParagraph","Properties":{"id":"20240612170353-ucmcxuj","updated":"20240612170353"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"天南星（图缺）"},{"Type":"NodeText","Data":"，《本经》不载所出州土，云生平泽，今处处有之。二月生苗，似荷梗；茎高一尺以来；叶如 ，两枝相抱；五月开花似蛇头，黄色，七月结子作穗似石榴子，红色；根似芋而圆。二月、八月采根，亦与 根相类，人多误采。茎斑花紫，是 。一说天南星如本草所说，即虎掌也。小者名由跋，后人采用，乃别立一名尔。今天南星大者四边皆有子，采时尽削去之。又陈藏器云∶半夏高一、二尺，由跋高一、二寸，此正误相反言也。今由跋苗高一、二尺，茎似 而无斑，根如鸡卵。半夏高一、二寸，亦有盈尺者，根如小指正圆也。江南吴中，又有白 ，亦日鬼芋根，都似天南星，生下平泽极多，皆杂采以为天南星，了不可辨，市中所收，往往是也。但天南星小，柔腻肌细，炮之易裂，差可辨尔。古方多用虎掌，不言天南星。天南星近出唐世，中风痰毒方中多用之。《续传信方》治风痛，用天南星、踯躅花，并生时同捣，罗作饼子，甑上蒸四、五过，以稀葛囊盛之。候要，即取焙捣为末，蒸饼，丸如梧桐子，温酒下三丸。腰脚骨痛，空心服；手臂痛，食后服，大良。"}]},{"ID":"20240612170429-qdljtor","Type":"NodeThematicBreak","Properties":{"id":"20240612170429-qdljtor"}},{"ID":"20240612170431-3dql5td","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170431-3dql5td","updated":"20240612170437"},"Children":[{"Type":"NodeText","Data":"天南星《本经逢原》"}]},{"ID":"20240612170431-2b3otr2","Type":"NodeParagraph","Properties":{"id":"20240612170431-2b3otr2","updated":"20240612170431"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名虎掌"}]},{"ID":"20240612170431-wqqrgwh","Type":"NodeParagraph","Properties":{"id":"20240612170431-wqqrgwh","updated":"20240612170431"},"Children":[{"Type":"NodeText","Data":"苦辛温，有毒，治风痰生用，须以矾汤浸。若熟用以湿纸包，于 火中炮制。用造胆星法，以南星磨末，筛去皮，腊月入黄牛胆中，悬当风处干之，年久多拌者良。或兼蜂蜜以润其燥，但色易黑，不能久藏。"}]},{"ID":"20240612170431-pq6u5ac","Type":"NodeParagraph","Properties":{"id":"20240612170431-pq6u5ac","updated":"20240612170431"},"Children":[{"Type":"NodeText","Data":"《本经》主心痛寒热结气，积聚，伏梁、筋痿拘缓，利水道。"}]},{"ID":"20240612170431-cjcrlao","Type":"NodeParagraph","Properties":{"id":"20240612170431-cjcrlao","updated":"20240612170431"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"天南星之名，始自《开宝》，即《本经》之虎掌也，以叶取象，则名虎掌，根类取名，故名南星。虽具二名，实系一物。为开涤风痰之专药。《本经》治心痛、寒热、结气，即《开宝》之下气利胸膈也。《本经》之治积聚、伏梁，即《开宝》之破坚积也。《本经》之治筋痿拘缓，即《开宝》之治中风，除麻痹也。《本经》之利水道，即《开宝》之散血堕胎也。夫水由血不归经所化，蕴积于经而为湿热，则风从内发，津液凝聚为肿胀，为麻痹，为眩晕，为颠仆，为口噤身强，为筋脉拘缓，为口眼 斜，各随身之所偏而留着不散，内为积聚，外为痈肿，上为心痛，下为堕胎，种种变端总由湿热所致，盖缘一物二名。后世各执一例，是不能无两岐之说，即仲淳之明，尚以《开宝》之文衍之为疏，而《本经》主治置之罔闻，何怪诸家采集药性，一皆舍本逐末乎。按∶天南星味辛而麻，故能治风散血。气温而燥，故能胜湿除痰。性紧而毒，故能攻积拔肿而治口 舌糜。诸风口禁，更以石菖蒲、人参佐之。南星、半夏皆治痰药也。然南星专走经络，故中风麻痹以之为响导，半夏专走肠胃，故呕逆泄泻以之为响导。《千金》治妇人头风，攻目作痛，掘地作坑烧赤，入南星于中，以醋沃之，盖定候冷为末，酒服半钱。《易简》治面生疣子，醋调南星末涂之，其新生之芽曰由跋。《本经》治毒肿结气。《千金方》用之取其开结热之用耳。"}]},{"ID":"20240612170321-z83cayl","Type":"NodeThematicBreak","Properties":{"id":"20240612170321-z83cayl"}},{"ID":"20240612170322-b0gmujt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170322-b0gmujt","updated":"20240612170325"},"Children":[{"Type":"NodeText","Data":"天南星《本草崇原》"}]},{"ID":"20240612170322-khy5ngs","Type":"NodeParagraph","Properties":{"id":"20240612170322-khy5ngs","updated":"20240612170322"},"Children":[{"Type":"NodeText","Data":"气味苦温，有大毒。主治心痛寒热，结气积聚，伏梁，伤筋痿拘缓，利水道。"}]},{"ID":"20240612170322-36foj0t","Type":"NodeParagraph","Properties":{"id":"20240612170322-36foj0t","updated":"20240612170322"},"Children":[{"Type":"NodeText","Data":"（《本经》之虎掌，今人谓之天南星，处处平泽有之。四月生苗，状如荷梗，高一二尺，一茎直上，茎端有叶如爪，岐分四步，岁久则叶不生，而中抽一茎，作穗直上如鼠尾，穗下舒一叶如匙，斑烂似素锦，一片裹茎作房。穗上布蕊满之，花青褐色，子如御粟子，生白熟则微红，久又变为蓝色。其根形圆，色白，大如半夏二三倍。曰虎掌者，因叶形似之；曰天南星者，以根形圆白，如天上南方之大星，取以为名也。）"}]},{"ID":"20240612170322-nze09kj","Type":"NodeParagraph","Properties":{"id":"20240612170322-nze09kj","updated":"20240612170322"},"Children":[{"Type":"NodeText","Data":"天南星色白根圆，得阳明金土之气化，味苦性温，又得阳明燥烈之气化，故有大毒。主治心痛寒热结气者，若先入心而清热，温能散寒而治痛结也。积聚、伏梁者，言不但治痛结无形之气，且治有形之积聚、伏梁。所以然者，禀金气而能攻坚破积也。伤筋痿拘缓者，言筋受伤而痿拘能缓也。夫小筋受伤而驰长为痿，犹放纵而委弃也。大筋受伤而软短为拘，犹缩急而拘挛也。阳明主润宗筋，束骨而利机关，故伤筋痿拘能缓。缓，舒缓也。利水道者，金能生水，温能下行也。"}]},{"ID":"20240612170205-2ya0bn0","Type":"NodeThematicBreak","Properties":{"id":"20240612170205-2ya0bn0"}},{"ID":"20240612170307-tmfyh5v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170307-tmfyh5v","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"《中国药典》：天南星"}]},{"ID":"20240612170307-qr1n5w3","Type":"NodeParagraph","Properties":{"id":"20240612170307-qr1n5w3","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612170307-7ha32op","Type":"NodeParagraph","Properties":{"id":"20240612170307-7ha32op","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" Tiān Nán Xīnɡ"}]},{"ID":"20240612170307-84xgk8m","Type":"NodeParagraph","Properties":{"id":"20240612170307-84xgk8m","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612170307-7qxx7ab","Type":"NodeParagraph","Properties":{"id":"20240612170307-7qxx7ab","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 南星、白南星、山苞米、蛇包谷、山棒子"}]},{"ID":"20240612170307-pft6b1x","Type":"NodeParagraph","Properties":{"id":"20240612170307-pft6b1x","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612170307-qhb1qgm","Type":"NodeParagraph","Properties":{"id":"20240612170307-qhb1qgm","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" RHIZOMA ARISAEMATIS"}]},{"ID":"20240612170307-rgfrv5l","Type":"NodeParagraph","Properties":{"id":"20240612170307-rgfrv5l","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612170307-q0kwahg","Type":"NodeParagraph","Properties":{"id":"20240612170307-q0kwahg","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 本品为天南星科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天南星"},{"Type":"NodeText","Data":"Arisaema erubescens （Wall.）Schott.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异叶天南星"},{"Type":"NodeText","Data":"Arisaema heterophyllum Blume或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"东北天南星"},{"Type":"NodeText","Data":"Arisaema amurense Maxim.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。秋、冬二季茎叶枯萎时采挖，除去须根及外皮，干燥。"}]},{"ID":"20240612170307-7fjcnym","Type":"NodeParagraph","Properties":{"id":"20240612170307-7fjcnym","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612170307-gxiryqy","Type":"NodeParagraph","Properties":{"id":"20240612170307-gxiryqy","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 本品呈扁球形，高1～2cm，直径1.5～6.5cm。表面类白色或淡棕色，较光滑，顶端有凹陷的茎痕，周围有麻点状根痕，有的块茎周边有小扁球状侧芽。质坚硬，不易破碎，断面不平坦，白色，粉性。气微辛，味麻辣。"}]},{"ID":"20240612170307-cxosi49","Type":"NodeParagraph","Properties":{"id":"20240612170307-cxosi49","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612170307-ay95nme","Type":"NodeParagraph","Properties":{"id":"20240612170307-ay95nme","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防霉、防蛀。"}]},{"ID":"20240612170307-chnrmqg","Type":"NodeParagraph","Properties":{"id":"20240612170307-chnrmqg","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612170307-8jz5qak","Type":"NodeParagraph","Properties":{"id":"20240612170307-8jz5qak","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生天南星"},{"Type":"NodeText","Data":":除去杂质，洗净，干燥。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"制天南星（姜南星）："},{"Type":"NodeText","Data":"取净天南星，按大小分别用水浸泡，每日换水 2～3 次，如起白沫时，换水后加白矾（每 100kg天南星，加白矾 2kg），泡一日后，再进行换水，至切开口尝微有麻舌感时取出。将生姜片、白矾置锅内加适量水煮沸后，倒入天南星共煮至无干心时取出，除去姜片，晾至四至六成干，切薄片，干燥。每100kg天南星，用生姜、白矾各12.5kg。"}]},{"ID":"20240612170307-q6bl0c6","Type":"NodeParagraph","Properties":{"id":"20240612170307-q6bl0c6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612170307-yd0ddim","Type":"NodeParagraph","Properties":{"id":"20240612170307-yd0ddim","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 本品粉末类白色。淀粉粒以单粒为主，圆球形或长圆形，直径 2～17μｍ，脐点点状，裂缝状，大粒层纹隐约可见；复粒少数，由 2～12分粒组成。草酸钙针晶散在或成束存在于黏液细胞中，长63～131 μｍ。草酸钙方晶多见于导管旁的薄壁细胞中，直径 3～20μｍ。"}]},{"ID":"20240612170307-bzqzxt0","Type":"NodeParagraph","Properties":{"id":"20240612170307-bzqzxt0","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612170307-vtd604l","Type":"NodeParagraph","Properties":{"id":"20240612170307-vtd604l","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 归肺、肝、脾经。"}]},{"ID":"20240612170307-e18f3id","Type":"NodeParagraph","Properties":{"id":"20240612170307-e18f3id","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612170307-4xdlyll","Type":"NodeParagraph","Properties":{"id":"20240612170307-4xdlyll","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 苦、辛，温；有毒。"}]},{"ID":"20240612170307-tl7onwu","Type":"NodeParagraph","Properties":{"id":"20240612170307-tl7onwu","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612170307-gkhq2h8","Type":"NodeParagraph","Properties":{"id":"20240612170307-gkhq2h8","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240612170307-58zgxan","Type":"NodeParagraph","Properties":{"id":"20240612170307-58zgxan","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612170307-j1efxyy","Type":"NodeParagraph","Properties":{"id":"20240612170307-j1efxyy","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 燥湿化痰，祛风止痉，散结消肿。用于顽痰咳嗽，风痰眩晕，中风痰壅，口眼歪斜，半身不遂，癫痫，惊风，破伤风。生用外治痈肿，蛇虫咬伤。"}]},{"ID":"20240612170307-lfswdg4","Type":"NodeParagraph","Properties":{"id":"20240612170307-lfswdg4","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612170307-rpew2oy","Type":"NodeParagraph","Properties":{"id":"20240612170307-rpew2oy","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 一般炮制后用，3～9g；外用生品适量，研末以醋或酒调敷患处。"}]},{"ID":"20240612170307-4t0862t","Type":"NodeParagraph","Properties":{"id":"20240612170307-4t0862t","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612170307-y91fs2p","Type":"NodeParagraph","Properties":{"id":"20240612170307-y91fs2p","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" （1）天南星中毒，可致舌、喉发痒而灼热，肿大，严重的以致窒息，呼吸停止。轻者可服稀醋或鞣酸及浓茶、蛋清、甘草水、姜汤等解之。如呼吸困难则给氧气，必要时作气管切开。"}]},{"ID":"20240612170307-xsbud9b","Type":"NodeParagraph","Properties":{"id":"20240612170307-xsbud9b","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612170307-oqahiod","Type":"NodeParagraph","Properties":{"id":"20240612170307-oqahiod","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612170307-zsuj3ya","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170307-zsuj3ya","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：天南星"}]},{"ID":"20240612170307-8fkz7nx","Type":"NodeParagraph","Properties":{"id":"20240612170307-8fkz7nx","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612170307-zukr8sm","Type":"NodeParagraph","Properties":{"id":"20240612170307-zukr8sm","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" Tiān Nán Xīnɡ"}]},{"ID":"20240612170307-hxu1j86","Type":"NodeParagraph","Properties":{"id":"20240612170307-hxu1j86","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612170307-2fi7iat","Type":"NodeParagraph","Properties":{"id":"20240612170307-2fi7iat","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 虎掌（《本经》），半夏精（侯宁极《药谱》），蛇头天南星（《履巉岩本草》），南星、虎掌南星、虎膏（《纲目》），蛇芋（《植物名实图考》），蛇包谷（《昆明药植调查报告》），山苞米（《辽宁主要药材》），三棒子、药狗丹（《河北药材》），大扁老鸦芋头（《山东中药》），斑杖（《南宁市药物志》），蛇六谷（《浙江农药志》），野芋头（《中药材手册》），蛇木芋（《南方主要有毒植物》）。"}]},{"ID":"20240612170307-o4rimaf","Type":"NodeParagraph","Properties":{"id":"20240612170307-o4rimaf","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612170307-jofeydk","Type":"NodeParagraph","Properties":{"id":"20240612170307-jofeydk","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 《本草拾遗》"}]},{"ID":"20240612170307-mcur4gu","Type":"NodeParagraph","Properties":{"id":"20240612170307-mcur4gu","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612170307-pefvrkm","Type":"NodeParagraph","Properties":{"id":"20240612170307-pefvrkm","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 为天南星科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天南星、东北天南星"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异叶天南星"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。秋、冬二季采挖，除去残茎、须根及外皮，晒干。或晒至半干时，用硫黄熏一次，则色白，易干。亦有用明矾水浸泡，待色白后去皮晒干者，此法外皮易于脱落。"}]},{"ID":"20240612170307-ikywv8t","Type":"NodeParagraph","Properties":{"id":"20240612170307-ikywv8t","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612170307-xr3888e","Type":"NodeParagraph","Properties":{"id":"20240612170307-xr3888e","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 主产四川、河南、贵州、云南、广西等地。此外。山东、河北、江苏、浙江、安徽、陕西、甘肃、辽宁、吉林等地亦产。"}]},{"ID":"20240612170307-w7mk869","Type":"NodeParagraph","Properties":{"id":"20240612170307-w7mk869","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612170307-dv5l9jb","Type":"NodeParagraph","Properties":{"id":"20240612170307-dv5l9jb","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" ①天南星"}]},{"ID":"20240612170307-ovm0u99","Type":"NodeParagraph","Properties":{"id":"20240612170307-ovm0u99","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"多年生草本，高40～90厘米。块茎扁球形，外皮黄褐色，直径2.5～5.5厘米。叶1片，基生；叶柄肉质，圆柱形，直立，长40～55厘米，下部成鞘，基部包有透明膜质长鞘，白绿色或散生污紫色斑点；叶片全裂成小叶片状，颇似掌状复叶，裂片7～23片，披针形至长披针形，长13～19厘米，宽1.5～2.5厘米，先端渐尖，至末端呈芒状，基部狭楔形，叶脉羽状，全缘，两面光滑无毛，上面绿色，下面淡绿色。花雌雄异株，成肉穗花序，花序柄长30～70厘米；佛焰苞绿色，偶为紫色，长11～10厘米，先端芒状；花序轴肥厚，先端附属物棍棒状；雄花有多数雄蕊，每2～4枚雄蕊聚成一簇，花药黑紫色，孔裂；雌花密聚，每花由一雌蕊组成，子房卵形，花柱短。浆果红色。花期5～6月。果期8月。"}]},{"ID":"20240612170307-asdo3t3","Type":"NodeParagraph","Properties":{"id":"20240612170307-asdo3t3","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"生长于阴坡较阴湿的树林下。分布河北，河南、广西、陕西、湖北、四川、贵州、云南、山西等地。"}]},{"ID":"20240612170307-xcrc0yb","Type":"NodeParagraph","Properties":{"id":"20240612170307-xcrc0yb","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"②东北天南星，又名：羹匙菜、大头参。"}]},{"ID":"20240612170307-ntze1mj","Type":"NodeParagraph","Properties":{"id":"20240612170307-ntze1mj","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"多年生草本，高35～60厘米。块茎近球状或扁球状，直径约2.5厘米，上方须根放射状分布。叶1片，鸟趾状全裂，裂片5枚（一年生裂片3枚），倒卵形或广倒卵形，长11～15厘米，宽6～8厘米，基部楔形，全缘或有不规则牙齿。花序柄长20～40厘米，较叶低；佛焰苞全长11～14厘米，下部筒状，口缘平截，绿色或带紫色；花序轴先端附属物棍棒状。浆果红色。花期7～8月。"}]},{"ID":"20240612170307-qfywqos","Type":"NodeParagraph","Properties":{"id":"20240612170307-qfywqos","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"生长于阴坡较为阴湿的林下。分布黑龙江，吉林、辽宁、河北，江西、湖北、四川等地。"}]},{"ID":"20240612170307-xpf3uwo","Type":"NodeParagraph","Properties":{"id":"20240612170307-xpf3uwo","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"③异叶天南星，又名：独角莲，狗爪南星、母子半夏、虎掌半夏、狗爪半夏、独叶一枝枪。"}]},{"ID":"20240612170307-lf8y9u0","Type":"NodeParagraph","Properties":{"id":"20240612170307-lf8y9u0","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60～80厘米。块茎近球状或扁球状，直径1.5厘米左右。叶1片，鸟趾状全裂，裂片9～17枚，通常13枚左右，长圆形、倒披针形或长圆状倒卵形，长4～12厘米，宽1.3～3厘米，先端渐尖，基部楔形，中央裂片最小。花序柄长50～80厘米；佛焰苞绿色，下部筒状，花序轴先端附属物鼠尾状，延伸于佛焰苞外甚多。浆果红色。花期7～8月。"}]},{"ID":"20240612170307-tri9bvn","Type":"NodeParagraph","Properties":{"id":"20240612170307-tri9bvn","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"生长于阴坡或山谷较为阴湿的地方。分布黑龙江、吉林、辽宁、浙江、江苏、讧西、湖北、四川、陕西等地。"}]},{"ID":"20240612170307-iiwlsqj","Type":"NodeParagraph","Properties":{"id":"20240612170307-iiwlsqj","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"此外，下列同属植物亦可入药：①拟天南星"}]},{"ID":"20240612170307-40658s6","Type":"NodeParagraph","Properties":{"id":"20240612170307-40658s6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"块茎小，碟状。叶l片，有淡绿色或红色的柄；中间小叶两端狭，中间宽。佛焰苞开展部分的边缘很少卷曲（分布江苏、湖北）。②朝鲜天南星，块茎球形或扁球形。茎具明显的紫黑色斑纹。复叶2枚，小叶5～15片，小叶片先端尖锐，基部楔形。肉穗花序轴顶端棍棒状（分布吉林，辽宁）。③虎掌块茎近球形。叶1片，叶柄深褐色；中间小叶先端长尖，下部短狭。佛焰苞开展部分的边缘卷曲（分布湖南、湖北、江苏、安徽、福建、江西、陕西）。④鬼蒟蒻，又名日本天南星。复叶2枚，小叶9～15片，呈鸟趾状排列；小叶片狭长椭圆形至广披针形，先端渐尖，边缘略波状（分布四川）。⑤多疣天甫星，块茎大而扁，干后黑色。叶1片，叶柄粗壮，暗绿色，密生多数小疣；小叶3片，菱状圆形至宽卵形，下面紫红色，布满小点。花茎短，亦有小疣；佛焰苞先端延长，有深紫色宽条纹（分布云南）。⑥偏叶天南星，又名花南星。复叶2枚，小叶3片，顶生小叶具柄，侧生小叶基部偏斜（分布陕西）。⑦象天南星，小叶3片，有柄，叶缘波状（分布陕西）。"}]},{"ID":"20240612170307-g9129ba","Type":"NodeParagraph","Properties":{"id":"20240612170307-g9129ba","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612170307-ydo4zfu","Type":"NodeParagraph","Properties":{"id":"20240612170307-ydo4zfu","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 干燥的块茎，呈扁圆形块状。直径2～7厘米，厚1～2厘米。表面乳白色或棕色，皱缩或较光滑，茎基处有凹人痕迹，周围有麻点状须根痕。块茎的周围具球状侧芽的，习称\"虎掌南星\"，亦有不带侧芽的。质坚硬，不易破碎，断面不平坦，色白，粉性。微有辛气，味辣而麻。以体大、色白、粉性足、有侧芽者为佳。未去外皮者不宜入药。"}]},{"ID":"20240612170307-amd8q6z","Type":"NodeParagraph","Properties":{"id":"20240612170307-amd8q6z","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612170307-ocqltxd","Type":"NodeParagraph","Properties":{"id":"20240612170307-ocqltxd","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 含β-谷甾醇-D-葡萄糖甙及氨基酸。"}]},{"ID":"20240612170307-822m4c3","Type":"NodeParagraph","Properties":{"id":"20240612170307-822m4c3","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612170307-kwotrwa","Type":"NodeParagraph","Properties":{"id":"20240612170307-kwotrwa","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 天南星具有抗肿瘤作用。"}]},{"ID":"20240612170307-te7xm6c","Type":"NodeParagraph","Properties":{"id":"20240612170307-te7xm6c","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612170307-c2k4kek","Type":"NodeParagraph","Properties":{"id":"20240612170307-c2k4kek","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 天南星：拣去杂质，洗净灰屑，晒干。制南星：取拣净的天南星，用凉水浸漂，避免日晒，每日换水2～3次，根据其产地、质量及大小，适当掌握浸漂日数。至起白沫时，每南星100斤加白矾2斤，浸泡一月后，继续换水，直至口尝无麻辣感为止，捞出，与鲜姜片及白矾粉层层均匀铺入容器内，加水淹没，约经3～4星期，复倒入锅内煮至内无白心，取出，拣去姜片，晾至六成干，闷润后切片，晒干（每天南星100斤，用鲜姜25斤，白矾12.5～25斤）。"}]},{"ID":"20240612170307-uicr7ke","Type":"NodeParagraph","Properties":{"id":"20240612170307-uicr7ke","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612170307-d99u3k3","Type":"NodeParagraph","Properties":{"id":"20240612170307-d99u3k3","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 入肺、肝、脾经。"}]},{"ID":"20240612170307-6nkaglp","Type":"NodeParagraph","Properties":{"id":"20240612170307-6nkaglp","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"手、足太阴。\""}]},{"ID":"20240612170307-7ye41ex","Type":"NodeParagraph","Properties":{"id":"20240612170307-7ye41ex","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"肺、脾、肝。\""}]},{"ID":"20240612170307-o02tn6u","Type":"NodeParagraph","Properties":{"id":"20240612170307-o02tn6u","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入脾、肺、心三经。\""}]},{"ID":"20240612170307-dz0u7wy","Type":"NodeParagraph","Properties":{"id":"20240612170307-dz0u7wy","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612170307-xcggj0q","Type":"NodeParagraph","Properties":{"id":"20240612170307-xcggj0q","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 苦辛，温，有毒。"}]},{"ID":"20240612170307-aej5q2o","Type":"NodeParagraph","Properties":{"id":"20240612170307-aej5q2o","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，温。\""}]},{"ID":"20240612170307-8o2mco3","Type":"NodeParagraph","Properties":{"id":"20240612170307-8o2mco3","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"岐伯、桐君：辛，有毒。\""}]},{"ID":"20240612170307-cdr4qmn","Type":"NodeParagraph","Properties":{"id":"20240612170307-cdr4qmn","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味甘。\""}]},{"ID":"20240612170307-byibpk4","Type":"NodeParagraph","Properties":{"id":"20240612170307-byibpk4","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"④《履巉岩本草》：\"温，有小毒。\""}]},{"ID":"20240612170307-ej4gjgs","Type":"NodeParagraph","Properties":{"id":"20240612170307-ej4gjgs","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612170307-mz2lfdi","Type":"NodeParagraph","Properties":{"id":"20240612170307-mz2lfdi","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 阴虚燥痰及孕妇忌服。"}]},{"ID":"20240612170307-yhffvts","Type":"NodeParagraph","Properties":{"id":"20240612170307-yhffvts","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"蜀漆为之使。恶莽草。\""}]},{"ID":"20240612170307-wrzle6e","Type":"NodeParagraph","Properties":{"id":"20240612170307-wrzle6e","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"畏附子、干姜、生姜。\""}]},{"ID":"20240612170307-jl0v85n","Type":"NodeParagraph","Properties":{"id":"20240612170307-jl0v85n","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"③《本草备要》：\"阴虚燥痰禁用。\""}]},{"ID":"20240612170307-vvcozd4","Type":"NodeParagraph","Properties":{"id":"20240612170307-vvcozd4","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"④《会约医镜》：\"孕妇忌之。\""}]},{"ID":"20240612170307-vzeror9","Type":"NodeParagraph","Properties":{"id":"20240612170307-vzeror9","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612170307-f04lsj6","Type":"NodeParagraph","Properties":{"id":"20240612170307-f04lsj6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 燥湿化痰，祛风定惊，消肿散结。治中风痰塑，口眼歪斜，半身不遂，癫痫，惊风，破伤风，风痰眩晕，喉痹，瘰疬，痈肿，跌扑折伤，蛇虫咬伤。"}]},{"ID":"20240612170307-1t9pghz","Type":"NodeParagraph","Properties":{"id":"20240612170307-1t9pghz","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"生用外治痈肿、蛇虫咬伤。祛风痰，解痉痫：用于风痰壅盛之中风眩晕、口眼歪斜、半身不遂、抽搐惊痫，常配半夏、天麻。也可用于破伤风。"}]},{"ID":"20240612170307-7d6bj11","Type":"NodeParagraph","Properties":{"id":"20240612170307-7d6bj11","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心痛，寒热，结气，积聚，伏梁，伤筋，痿，拘缓，利水道。\""}]},{"ID":"20240612170307-5eph3v8","Type":"NodeParagraph","Properties":{"id":"20240612170307-5eph3v8","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除阴下湿，风眩。\""}]},{"ID":"20240612170307-bdfugv5","Type":"NodeParagraph","Properties":{"id":"20240612170307-bdfugv5","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治风眩目转，主疝瘕肠痛，伤寒时疾，强阴。\""}]},{"ID":"20240612170307-f9fvqjn","Type":"NodeParagraph","Properties":{"id":"20240612170307-f9fvqjn","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"主金疮伤折瘀血。碎敷伤处。\""}]},{"ID":"20240612170307-6g55z6v","Type":"NodeParagraph","Properties":{"id":"20240612170307-6g55z6v","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"窨蛇、虫咬、疥癣恶疮。\""}]},{"ID":"20240612170307-ck5srla","Type":"NodeParagraph","Properties":{"id":"20240612170307-ck5srla","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑥《开宝本草》：\"主中风，除痰，麻痹，下气，破坚积，消痈肿，利胸膈，散血堕胎。\""}]},{"ID":"20240612170307-pja649w","Type":"NodeParagraph","Properties":{"id":"20240612170307-pja649w","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑦《医学启源》：\"去上焦痰及头眩晕。\""}]},{"ID":"20240612170307-280spsu","Type":"NodeParagraph","Properties":{"id":"20240612170307-280spsu","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑧李杲：\"主破伤风，口噤身强。\""}]},{"ID":"20240612170307-wxs83tk","Type":"NodeParagraph","Properties":{"id":"20240612170307-wxs83tk","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑨王好古：\"补肝风虚。治痰功同半夏。\""}]},{"ID":"20240612170307-m59lamp","Type":"NodeParagraph","Properties":{"id":"20240612170307-m59lamp","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑩《纲目》：\"治惊痫，口眼歪斜，喉痹，口舌疮糜，结核，解颅。\""}]},{"ID":"20240612170307-owocw8e","Type":"NodeParagraph","Properties":{"id":"20240612170307-owocw8e","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612170307-h1i829g","Type":"NodeParagraph","Properties":{"id":"20240612170307-h1i829g","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.8～1.5钱；或入丸、散。外用：研末撒或调敷。"}]},{"ID":"20240612170307-kapzqwl","Type":"NodeParagraph","Properties":{"id":"20240612170307-kapzqwl","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612170307-k8dvc34","Type":"NodeParagraph","Properties":{"id":"20240612170307-k8dvc34","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" ①治卒中昏不知人，口眼歪斜，半身不遂，咽喉作声，痰气上壅，无问外感风寒，内伤喜怒，或六脉沉伏，或指下浮盛，并宜服之。兼治痰厥气逆，及气虚眩晕：南星（生用）一两，木香一分，川乌（生，去皮）、附子（生，去皮）各半两。上细切，每服半两，水二大盏，姜十五片，煎至八分，去滓，温服，不拘时侯。（《局方》三生饮）"}]},{"ID":"20240612170307-dfjq541","Type":"NodeParagraph","Properties":{"id":"20240612170307-dfjq541","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑤治暴中风口眼歪斜：天南星为细末，生姜自然汁调摊纸上贴之，左歪贴右，右歪贴左，才正便洗去。（《杨氏家藏方》天南星膏）"}]},{"ID":"20240612170307-gk629uq","Type":"NodeParagraph","Properties":{"id":"20240612170307-gk629uq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑥治风痫：天南星（九蒸九晒）为末，姜汁糊丸，梧子大。煎人参、菖蒲汤或麦门冬汤下二十丸。（《中藏经》）"}]},{"ID":"20240612170307-zvx4qxe","Type":"NodeParagraph","Properties":{"id":"20240612170307-zvx4qxe","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"④治破伤风：㈠天南星、防风各-两。上二味，捣罗为末，先用童子小便洗疮口，后以此药末酒调贴之。（《圣济总录》夺命散）㈡白芷、南星、白附子、天麻、羌活、防风各一两。研末调敷伤处。如破伤风初起，角弓反张，牙关紧急，每用三钱，热童便调服。（《医宗金鉴》玉真散）"}]},{"ID":"20240612170307-t9kqqo0","Type":"NodeParagraph","Properties":{"id":"20240612170307-t9kqqo0","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑤治小儿惊风，大人诸风：生半夏七两，生天南星三两，生白附子二两，生川乌头半两（去皮及脐）。上捣罗为细末，以生绢袋盛，用井花水摆，未出者，更以手揉令出，如有滓，更研，再入绢袋摆尽为度，放磁盆中，日晒夜露，至晓弃水，别用井花水搅，又晒，至来日早，再换新水搅，如此春五日、夏三日、秋七日、冬十日，去水，晒干后如玉片，研细，以糯米粉煎粥清，丸绿豆大。每服三、五丸，薄荷汤下，大人每服二十丸，生姜汤下，瘫痪风温酒下，并不以时候服。（《阎氏小儿方论》青州白丸子）"}]},{"ID":"20240612170307-pjdl6tt","Type":"NodeParagraph","Properties":{"id":"20240612170307-pjdl6tt","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑥治诸风口噤：天南星（炮，锉），大人三钱，小儿三字，生姜五片，苏叶一钱。水煎减半，入雄猪胆汁少许，温服。（《仁斋直指方》）"}]},{"ID":"20240612170307-kesrihq","Type":"NodeParagraph","Properties":{"id":"20240612170307-kesrihq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑦治风痰头痛不可忍：天南星（大者，去皮）、茴香（炒）。上等分，为细末，入盐少许在面内，用淡醋打糊为丸，如梧桐子大，每服三、五十丸，食后姜汤下。（《魏氏家藏方》上清丹）"}]},{"ID":"20240612170307-v1fdg96","Type":"NodeParagraph","Properties":{"id":"20240612170307-v1fdg96","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑧治小儿走马疳，蚀透损骨：天南星大者一枚，雄黄皂子大。上二味，先用天南星当心剜作坑子，次安雄黄一块在内，甩大麦面裹合，炭火内烧令烟尽，取出候冷，入麝香一字同研为细末。先以新绵揾血，然后于疮上掺药。一日三次。（《圣济总录》天南星散）"}]},{"ID":"20240612170307-w73ysme","Type":"NodeParagraph","Properties":{"id":"20240612170307-w73ysme","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑨治喉闭：白僵蚕、天南星（并生用）等分。为末，以生姜自然汁调一字许，用笔管灌在喉中，仍咬干姜皂子大，引涎出。（《中藏经》）"}]},{"ID":"20240612170307-n3i37zw","Type":"NodeParagraph","Properties":{"id":"20240612170307-n3i37zw","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑩治头面及皮肤生窟，大者如拳，小者如栗，或软或硬，不疼不痒，不可辄用钎灸：生天南星一枚（洗，切。如无生者，以干者为末），滴醋研细如膏，将小针制病处，令气透，将膏摊贴纸上如瘤大贴之，觉痒即易，日三、五上。（《圣济总录》天南星膏）"}]},{"ID":"20240612170307-8c83fq1","Type":"NodeParagraph","Properties":{"id":"20240612170307-8c83fq1","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑾治痰湿臂痛，右边者：天南星、苍术等分。生姜三片，水煎服之。（《摘元方》）"}]},{"ID":"20240612170307-r5uiarl","Type":"NodeParagraph","Properties":{"id":"20240612170307-r5uiarl","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"⑿治身面疣子：醋调南星末涂之。（《简易方论》）"}]},{"ID":"20240612170307-g4lruki","Type":"NodeParagraph","Properties":{"id":"20240612170307-g4lruki","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612170307-8sx8qpe","Type":"NodeParagraph","Properties":{"id":"20240612170307-8sx8qpe","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" ①治疗子宫颈癌"}]},{"ID":"20240612170307-g4buakh","Type":"NodeParagraph","Properties":{"id":"20240612170307-g4buakh","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"采取阴道局部用药与口服相结合的治疗方法，对于Ⅲ期及少数晚Ⅱ期的病人加用宫旁四野的体外放射治疗。内服药：生天南星煎汤代茶，剂量由每日5钱逐渐增加到1.5两，另根据病情、体质，辨证用药。局部用药可采用不同的剂型及用药途径：㈠药包：鲜天南星根部洗净泥砂（不可泡在水中）。每3钱加75％酒精0.5毫升，捣成浆状，用一层纱布包扎成椭圆状，塞在癌灶部位.㈡栓剂：每片含生药60克，覆盖在宫颈的癌灶上。㈢棒剂：每根含生药10克，可塞在颈管内。㈣针剂：每支2毫升，含生药10克，每天或隔天注入宫颈及宫旁组织4毫升。此外，尚可用天南星提取物行盆腔离子透入法。用上法治疗105例，近期治愈20例，显效46例，有效16例。有效率为78％。对Ⅰ期的疗效较好，Ⅱ、Ⅲ期疗效较差；对于溃疡型、结节型效果最好，糜烂型与菜花型次之，空洞型效果较差。应用天南星治疗开始有显著效果，治疗一个时期会停滞不前（可能因产生抗药性），如应用其他药物治疗病情改善后，再用天南星治疗则又有效果。内服或注射天南星对肝、肾功能及血象无异常改变，可能对癌细胞有特异的抑制作用。"}]},{"ID":"20240612170307-20u54wf","Type":"NodeParagraph","Properties":{"id":"20240612170307-20u54wf","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"②治疗腮腺炎"}]},{"ID":"20240612170307-gjlfdbq","Type":"NodeParagraph","Properties":{"id":"20240612170307-gjlfdbq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"取生天南星研粉浸于食醋中，5天后外涂患处，每天3～4次。治疗6例，当天即退热，症状减轻，平均3～4天肿胀逐渐消退。"}]},{"ID":"20240612170307-dmomex7","Type":"NodeParagraph","Properties":{"id":"20240612170307-dmomex7","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612170307-72bzj81","Type":"NodeParagraph","Properties":{"id":"20240612170307-72bzj81","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612170307-4gb8vi7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170307-4gb8vi7","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"《中华本草》：天南星"}]},{"ID":"20240612170307-ndxtutc","Type":"NodeParagraph","Properties":{"id":"20240612170307-ndxtutc","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612170307-054bqj4","Type":"NodeParagraph","Properties":{"id":"20240612170307-054bqj4","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" Tiān Nán Xīnɡ"}]},{"ID":"20240612170307-biljiin","Type":"NodeParagraph","Properties":{"id":"20240612170307-biljiin","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612170307-v88w46u","Type":"NodeParagraph","Properties":{"id":"20240612170307-v88w46u","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 半夏精、鬼南星、虎膏、蛇芋、野芋头、蛇木芋、山苞米、蛇包谷、山棒子"}]},{"ID":"20240612170307-p61ywo6","Type":"NodeParagraph","Properties":{"id":"20240612170307-p61ywo6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612170307-bq88953","Type":"NodeParagraph","Properties":{"id":"20240612170307-bq88953","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" Pedate PinalliaJackinthepulpit Rhizome, Jackinthepulpit Tuber"}]},{"ID":"20240612170307-85vavan","Type":"NodeParagraph","Properties":{"id":"20240612170307-85vavan","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612170307-dsxynp2","Type":"NodeParagraph","Properties":{"id":"20240612170307-dsxynp2","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 1.出自《本草纲目拾遗》。《南方主要有毒植物》》：天南星，全株有毒。含毒成分：根头含有毒的生物碱；根、叶、茎都含苛辣性毒素。"}]},{"ID":"20240612170307-9l7a150","Type":"NodeParagraph","Properties":{"id":"20240612170307-9l7a150","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.中毒症状：皮肤与之接触发生瘙痒；误食后舌、喉发痒而灼热，肿大，严重的以致窒息，呼吸停止。食五钱可引起中毒。"}]},{"ID":"20240612170307-1e3egw5","Type":"NodeParagraph","Properties":{"id":"20240612170307-1e3egw5","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"3.解救方法：3.1.皮肤中毒可用水或稀醋。鞣酸洗涤。"}]},{"ID":"20240612170307-qd0sz2z","Type":"NodeParagraph","Properties":{"id":"20240612170307-qd0sz2z","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"3.2.误食中毒服稀醋或鞣酸或浓茶、蛋清等。如呼吸困难则供氧气，必要时作气管切开。"}]},{"ID":"20240612170307-i5n24t1","Type":"NodeParagraph","Properties":{"id":"20240612170307-i5n24t1","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612170307-e5c4nxd","Type":"NodeParagraph","Properties":{"id":"20240612170307-e5c4nxd","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 药材基源：为天南星科植物虎掌、天南星、一把伞南星及东北天南星的块茎。"}]},{"ID":"20240612170307-v6f79fr","Type":"NodeParagraph","Properties":{"id":"20240612170307-v6f79fr","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Pinellia pedatisecta Schott2.Arisaema heterophyllum Bl3.Arisaema erubescens(Wall.)Schott[Arumerubescens Wall.;A.consanguineum Schott]"}]},{"ID":"20240612170307-poql2w5","Type":"NodeParagraph","Properties":{"id":"20240612170307-poql2w5","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"采收和储藏：10月挖出块茎，去掉泥土及茎叶、须根，装入撞兜内撞搓，撞去表皮，倒出用水清洗，对未撞净的表皮再用竹刀刮净，最后用硫黄熏制，使之色白，晒干。本品有毒，加工操作时应戴手套、口罩或手上擦菜油，可预防皮肤发痒红肿。"}]},{"ID":"20240612170307-yx9uc0q","Type":"NodeParagraph","Properties":{"id":"20240612170307-yx9uc0q","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612170307-1n9cbow","Type":"NodeParagraph","Properties":{"id":"20240612170307-1n9cbow","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 生态环境：1. 生于山谷、河岸、草地、草丛及竹林下。"}]},{"ID":"20240612170307-1vr8vcz","Type":"NodeParagraph","Properties":{"id":"20240612170307-1vr8vcz","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.生于灌丛、草地及林下。3.生于荒地、草坡、灌丛及林下。"}]},{"ID":"20240612170307-1cfn8pl","Type":"NodeParagraph","Properties":{"id":"20240612170307-1cfn8pl","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"4.生于海拔50-1200m的林下和沟旁。"}]},{"ID":"20240612170307-qdl8m0q","Type":"NodeParagraph","Properties":{"id":"20240612170307-qdl8m0q","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于华北、华东。"}]},{"ID":"20240612170307-h2gl4rh","Type":"NodeParagraph","Properties":{"id":"20240612170307-h2gl4rh","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"中南、西南及陕西等地。"}]},{"ID":"20240612170307-1tq4n6v","Type":"NodeParagraph","Properties":{"id":"20240612170307-1tq4n6v","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.分布于全国大部分地区（西北和西藏以外）。"}]},{"ID":"20240612170307-xjxogww","Type":"NodeParagraph","Properties":{"id":"20240612170307-xjxogww","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"3.分布于除东北、内蒙古和新疆以外的大部分省区。"}]},{"ID":"20240612170307-192b4x9","Type":"NodeParagraph","Properties":{"id":"20240612170307-192b4x9","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"4.分布于东北、华北及陕西、宁夏、山东、江苏、河南等地。"}]},{"ID":"20240612170307-sbvifnj","Type":"NodeParagraph","Properties":{"id":"20240612170307-sbvifnj","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612170307-x9raen6","Type":"NodeParagraph","Properties":{"id":"20240612170307-x9raen6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 1.虎掌, 多年生草本。1-2年生块茎近圆球形，三年以上块茎由于侧生2-5个乳头状小块茎而呈扁柿形，直径达6cm。叶自芽眼抽出，2-6丛生；叶片鸟足状分裂，裂片5-13，卵状披针形或椭圆状披针形，中裂片比例裂片长大，长15-18cm，宽约3cm。花序便2-4，亦自芽眼抽出，长15-30cm；佛焰苞为匙状披针形，问下渐变细，色质如叶，宿存响穗花序雌花序轴部分与佛焰苞贴生，长1-3cm，外侧着花；雄花序轴部分游离，长5-7mm；小花密集，黄色；附属器形如鼠尾，长达15cm。浆果卵形，熟时绿白色，易脱落布地，当年发芽长出新株。花期5-7月，果期6-10月。"}]},{"ID":"20240612170307-n9ffwxq","Type":"NodeParagraph","Properties":{"id":"20240612170307-n9ffwxq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.大南星，多年生草本。块茎近圆球形，直径2-5cm。叶常单一；叶柄卜部鞘状，下部具膜质鳞叶2-3；叶片鸟足状分裂，裂片11-19，线状长圆形或倒被外形，中裂片比两侧短小。花序柄从叶柄中部分出；佛焰苞管部长3-6cm，绿白色，喉部截形，外线反卷，檐部卵状披针形，有时下弯呈盔状，淡绿色全淡黄色；向穗花序袖与佛焰苞完全分离；肉穗花序两性或雄花序单性；两性花序下部雌花序长约2cm，花密，上都雄花序长约3cm，花疏；单性雄花序长3-5cm，粗3-5mm；附属器基部直径0.5-1cm，长达20cm，伸出佛焰苞喉部后呈“之”字形上升。果序近圆锥形，浆果熟时红色，佛焰苞枯萎而效果序裸露。种子黄红色。花期4-5月，果期6-9月。"}]},{"ID":"20240612170307-q19kcm6","Type":"NodeParagraph","Properties":{"id":"20240612170307-q19kcm6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"3.一把伞南星，多年生草本。块茎近圆球形，直径达6cm。鳞叶紫红色或绿白色，间有褐色斑块。叶单一；柄长达70cm，中部以下具叶鞘；叶片放射状分裂，裂片7-20，披计形或长圆形，长7-24cm ，宽1-4cm，长渐尖或延长为线尾状。花序柄自叶辆中部分出，短于叶柄；佛焰苞颜色多样，绿色问有白色条纹或淡紫色至深紫色中夹杂着绿色、白色条纹；喉部扩展，边缘外卷，檐部宽大，三角状卵形至长圆卵形，光瑞延伸为长达15cm的线尾；肉穗花序；雌花序轮在下部，中性花序轴位于中段，紧接雄花序轴，其上为长约5cm的棒状附属器。果序成熟时裸露，浆果红色。种子1-2，球形，淡褐色。花期4-6月，果期8-9月。"}]},{"ID":"20240612170307-7hz0xuz","Type":"NodeParagraph","Properties":{"id":"20240612170307-7hz0xuz","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"4.东北天南星，与天南星及一把伞南星的区别为：本叶；叶柄长17-30cm，下部1/3具鞘，紫色；叶片鸟足状分裂，裂片5，倒卵状被针形或椭圆形，先端短渐尖或锐尖，基部楔形，中裂片具长约2cm的柄，长7-12cm，宽4-7cm，例裂片具长约1cm。共同的柄，全缘。花序柄短于叶柄，佛焰苞绿色或紫色具白色条纹；肉穗花序单件；雄花序年约2cm，花疏；雌花序长约1cm；各附属器具短柄，棒状。浆果红色；种子4颗，红色。肉穗花序轴常于果期增大，果落后紫红色。"}]},{"ID":"20240612170307-p4sqiot","Type":"NodeParagraph","Properties":{"id":"20240612170307-p4sqiot","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612170307-kx41ji7","Type":"NodeParagraph","Properties":{"id":"20240612170307-kx41ji7","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜冷凉湿润气候和阴湿环境，怕强光，应适度荫蔽或与高秆作物或林木间作。以选湿润、疏松、肥沃富含腐殖质的壤上或砂质壤土栽培，粘土及洼地不宜种植。山区可在山间沟谷、溪流两岸或疏林下的阴湿地种植。忌连作。"}]},{"ID":"20240612170307-vn2uajm","Type":"NodeParagraph","Properties":{"id":"20240612170307-vn2uajm","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"栽培技术用种子或块茎繁殖。种子繁殖：选择当年新收种子于8月上旬播种，按行距12-15cm开浅沟，把种子插入沟内，覆土约1.5cm，温度在20℃左右，约10d出苗。翌年4、5月苗高5-10cm，按株距15cm定植。亦可用湿沙贮藏，翌年春季播种育苗。因种子繁殖生长期长，产量不高，故一般多不采用。块茎繁殖：于 10-11月收获时，选无病虫害、健壮、中等大小的块茎作种茎，贮放于地窖内。翌年4月在畦面开浅沟，沟距20-25cm，株距15cm下种，芽头向上，覆土4-5cm，浇水，每1hm2需大的种茎600-750kg，小的种茎30-40kg，裁后15d左右出苗。"}]},{"ID":"20240612170307-lwpk97n","Type":"NodeParagraph","Properties":{"id":"20240612170307-lwpk97n","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期间要注意浇水，经常保持土壤湿润，雨季注意排水。7月苗高15-20cm，追施人粪尿1次。初次追肥后，直深中耕，第2次追肥在8月，施硫酸铵和过磷酸钙混合肥料，施肥后要浇足水。花期除留种株外，其余花序全部摘除。"}]},{"ID":"20240612170307-6f2el5p","Type":"NodeParagraph","Properties":{"id":"20240612170307-6f2el5p","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有病毒病，要注意选留健壮无病殊作种，并防治蚜虫为害。虫害有短须螨，成、若虫于叶背吸食汁液，使叶变黄，脱落。用20%双甲眯乳油1000倍液或73%克螨特3000倍喷雾。"}]},{"ID":"20240612170307-lhrvogu","Type":"NodeParagraph","Properties":{"id":"20240612170307-lhrvogu","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612170307-w4vqn83","Type":"NodeParagraph","Properties":{"id":"20240612170307-w4vqn83","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）虎掌块茎呈扁平而不规则的类圆形，由主块茎及多数。附着的小块茎组成，形如虎的脚掌，直径1.5-5cm。表面淡黄色或淡棕色，每一块茎中心都有一茎痕，周围有点状须根痕。质坚实而重，断面不平坦，色白，粉性。气微，味辣，有麻舌感。"}]},{"ID":"20240612170307-32uytbb","Type":"NodeParagraph","Properties":{"id":"20240612170307-32uytbb","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"（2）天南星 块茎呈稍扁的圆球形，直径1.5-4cm。表面类白色或淡棕色，较光滑，顶端有凹陷的茎痕，周围有1圈1-3列显着的根痕，周边偶有少数微突起的小侧芽，有时已磨平、气味同上。"}]},{"ID":"20240612170307-cc2j627","Type":"NodeParagraph","Properties":{"id":"20240612170307-cc2j627","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"（3）一把伞南星块茎呈扁圆球形，直径2-5.5cm，表面淡黄色至淡棕色，顶端较平，中心茎痕浅凹，四周有叶痕形成的环纹，周围有大的麻点状根痕，但不明显，周边无小侧芽。质坚硬，断面白色粉性。气味同上。"}]},{"ID":"20240612170307-df55f2x","Type":"NodeParagraph","Properties":{"id":"20240612170307-df55f2x","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"（4）东北天南星块茎呈扁圆形，直径1.5-4cm，中心茎痕大而稍平坦，呈浅皿状，环纹少，麻点状根痕细，排列不整齐，周围有微突出的小侧芽。气味同上。"}]},{"ID":"20240612170307-udbgixf","Type":"NodeParagraph","Properties":{"id":"20240612170307-udbgixf","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"以个大。色白、粉性足者为佳。"}]},{"ID":"20240612170307-7sd170p","Type":"NodeParagraph","Properties":{"id":"20240612170307-7sd170p","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：（1）虎掌 ①淀粉粒单粒呈圆球形、椭圆形或盔帽，直径3-13-21pm，长至26m，脐点圆点状、裂缝状、星状或“人”字状；复粒极多，由2-10多分粒组成。②草酸钙针晶长20-60μm。③粘液细胞直径60-135μm。"}]},{"ID":"20240612170307-leircgh","Type":"NodeParagraph","Properties":{"id":"20240612170307-leircgh","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"（2）天南星 ①淀粉粒单粒呈圆球形、半球形或不规则形，直径2-18μm，脐点圆点状、星状、裂缝状、三叉状；复粒甚多，由2-10分粒组成，脐点多不明显。②草酸钙针晶长13-64-86μm。"}]},{"ID":"20240612170307-okaax8y","Type":"NodeParagraph","Properties":{"id":"20240612170307-okaax8y","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"（3）一把伞南星 ①淀粉粒极多。单粒大多呈圆球形，稀椭圆形或半球形，直径2-20μm，脐点圆点状、裂缝状、“十”字状、“人”字状或星状，大粒层纹隐约可见；复粒由2-4分粒组成，脐点明显，螺纹、环纹导管直径8-27μm。②草酸钙针晶束及外晶随处可见，草酸钙针晶长34-52μm。此外，可见草酸钙方晶、棕色块。"}]},{"ID":"20240612170307-m0yaaqv","Type":"NodeParagraph","Properties":{"id":"20240612170307-m0yaaqv","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"（4）东北天南星 ①淀粉粒单粒呈圆球形。椭圆形，直径2-26μm，脐点三义状、“人”字状、“十”字状或裂缝状，大粒层纹隐约可见；复粒由2-10多分粒组成。③草酸钙针晶长20-60μm。"}]},{"ID":"20240612170307-jsny4pt","Type":"NodeParagraph","Properties":{"id":"20240612170307-jsny4pt","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612170307-2s5gdnd","Type":"NodeParagraph","Properties":{"id":"20240612170307-2s5gdnd","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 天南星（未鉴定品种）根茎生食有强烈的刺激作用，口腔粘膜轻度糜烂，甚至部分坏死脱落，咽喉干燥，并有烧灼感，舌体肿大，口唇水肿，大量流涎，口舌麻木，味觉丧失，声音嘶哑，张口困难。小鼠腹腔注射鬼蒟箬水浸液半数致死量为13.5g/kg。"}]},{"ID":"20240612170307-m332veq","Type":"NodeParagraph","Properties":{"id":"20240612170307-m332veq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"1.天南星不同炮制法对饮片毒性的影响：杨守业等对天南星生品、白矾浸制片、热压片和药典法炮制品对粘膜的刺激性，急性和亚急性毒性进行了比较研究。实验结果表明，炮制能够使其毒性降低或消除，不同南星制品分别灌胃小鼠50g/kg，不引起死亡，生片和药典法饮片汤剂150g/kg灌胃小鼠亦未见毒性反应，且对大鼠生长及肝功能无不利影响。在小鼠亚毒试验中热压片和药典法制品呈现一定的毒性反应，可能与炮制品中白矾存留量有关。"}]},{"ID":"20240612170307-urtuk7x","Type":"NodeParagraph","Properties":{"id":"20240612170307-urtuk7x","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.天南星不同炮制品水煎剂150g/kg灌胃大小鼠急性和亚急性试验未见毒性反应。天南星醇浸膏给小鼠皮下注射后可使动物因惊厥而死亡。"}]},{"ID":"20240612170307-658allg","Type":"NodeParagraph","Properties":{"id":"20240612170307-658allg","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612170307-wzfntn0","Type":"NodeParagraph","Properties":{"id":"20240612170307-wzfntn0","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 虎掌的根、茎含多种生物碱和环二肽类化合物成分，已经分离得到：3-异丙基吡咯并[1，2a]哌嗪-2，5-二酮[3-isopo pyl-pyrrolo[1,2a]piperazine-2,5-dione]即是L-脯氨酰-L-缬氨酸酐(L-prolyl-LK-valine anhydride)，3，6-二异丙基-2，5-哌嗪二酮(3,6-diisopropyl-2,5-piperazinedione)即是L-缬氨酰-L-缬氨酸酐(L-valyl-L-valine anhydride)，3-异丙基-6-叔丁基-2，5-哌嗪二酮(3-isopropyl-6-tert-butyl-2,5-piperazinedione)，3-异丙基-6-甲基-2，5-哌嗪二酮(3-isopropyl-6-methyl-2,5piperazinedione)即是L-缬氨酰-L-丙氨酸酐(L-valyl-L-alanine anhydride)，β-卡啉(β-carboline)，1-乙酰基-β-卡啉(1-acetyl-β-carboline),2-甲基-3-羟基吡啶(2-methyl-3-hydroxypyridine)，脲嘧啶(uracil)，5-甲基脲嘧啶(5-methylk uracil)即是胸腺嘧啶(thymine)，烟酰胺(nicotinamide)，双吡咯并[1，2a][1,2d]六氢吡嗪-2，5-二酮[bispyrrala[1,2a][1,2d]-hexahydropyrazine-2,5-dione]即是L-脯氨酰-L-脯氨酸酐(L-proly-L-proline anhydride)，3-异丙基-6-异丁基-2，5-哌嗪二酮(3-isopropyl-6-isobutyl-2,5-piperazinedione)即是L-缬氨酰-L-亮氨酸酐(L-valyl-L-leucine anhydride)，3-基-6-甲基-2，5-哌嗪二酮(3-benzyl-6-methyl-2,5-piperazinedione)即是L-苯丙氨酰-L-丙氨酸酐(L-phenylalanyl-L-alanine anhydride)，吡咯并[1，2a]六氢吡嗪1，4-二酮(pyrrolo[1,2a]hexahydropyrazine-1,4-dione)即是L-甘氨酰-L-脯氨酸酐(L-glucyl-L-proline anhydride)，L-顺式-3-(对-羟下基)-6-异丁基-2，5-哌嗪二酮[l-cis-3-(p-hydroxybenzyl)-6-isobutyl-2,5-piperazinedione]即是L-酷氨酰-L-亮氨酸酐(L-tyrosyl-L-leucine anhydride)，3-甲基-6-异丁基-2，5-哌嗪二酮(3-methyl-6-isobutyl-2,5-piperazinedione)即是L-丙氨酰-L-亮氨酸酐(L-alanyl-L-leucine anhydricde)，3-甲基-6-仲丁基-2，5-哌唪二酮(3-methyl-6-secbutyl-2,5-piperazinedione)，L-苯丙氨酰-L-丝氨酸酐(L-phenylalanyl-L-serine anhydride)，L-酷氨酰-L-丙氨酸酐(L-tyrosyl-L-alanine anhydride)，L-脯氨酰-L-丙氨酸酐(L-prolyl-L-alanine anhydride)，3-乙酰氨基-2-哌啶酮(3-acetamino-2-piperidone)，腺苷(adenosine)，以及掌叶半夏碱(pedatisectine)A、B、C、D、E。掌叶半夏碱A的结构是5-羟基-2-吡啶甲基腺嘌呤(5-hydroxy-2-pyridylmethyl-adenine)，常叶半夏碱B京是腺嘌呤(adenine)，掌叶半夏碱C的结构是1-丙烯酸乙酯-7-醛基卡啉[1-(3-ethylacrylate)-7-aldehydocarboline]，掌叶半夏碱D的结构是2-甲基-3-(2，3，4-三羟基丁基)吡嗪[2-methyl-3-(2,3,4-trihydroxybutyl)pyrazine]，掌叶半夏碱E的结构是2-甲基-3-(1,2,3,4-甲羟基丁基)吡嗪[2-methyl-3(1,2,3,4-tetrahydroxybutyl)。还含胡萝卜甙(daucosterol)，β-谷甾醇(β-sitosterol)，棕榈酸(palmitic acid)，丝氨酸(serine)，缬氨酸(valine)，赖氨酸(lysine)，脯氨酸(proline)等30多种氨基酸和镁、铝、锌、铜、硒、钒、钴等20多种无机微量元素。"}]},{"ID":"20240612170307-1ktlyv6","Type":"NodeParagraph","Properties":{"id":"20240612170307-1ktlyv6","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"天南星、一把伞南星的根茎均含β-谷甾醇以及与虎掌相同的多种氨基酸和无机微量元素，只是含量有所不同。"}]},{"ID":"20240612170307-i362n2k","Type":"NodeParagraph","Properties":{"id":"20240612170307-i362n2k","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"东北天南星含植物凝集素(phytohemagglutinin)。"}]},{"ID":"20240612170307-5xeh56r","Type":"NodeParagraph","Properties":{"id":"20240612170307-5xeh56r","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612170307-p3c87a9","Type":"NodeParagraph","Properties":{"id":"20240612170307-p3c87a9","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 1.抗惊厥作用：腹腔注射天南星水煎剂3g/kg，可明显对抗士的宁，五甲烯四氮唑及咖啡因引起的惊厥，但不能对抗电休克的发作，且品种不同其抗惊强度有所差异，但也有报告指出，天南星不能对抗士的宁所致的惊厥和死亡，但能对抗烟碱所致的惊厥死亡，尚能消除其肌肉震颤症状；对小鼠肌肉注射破伤风毒素所致的惊厥，天南星能推迟动物死亡的效果。"}]},{"ID":"20240612170307-ayymkwb","Type":"NodeParagraph","Properties":{"id":"20240612170307-ayymkwb","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.镇静、镇痛作用：兔及大鼠腹腔注射天南星煎剂后，均呈活动减少、安静、翻正反射迟钝。并能延长小鼠对成巴比妥纳的睡眠时间，且有明显的镇痛作用。"}]},{"ID":"20240612170307-gbid9qz","Type":"NodeParagraph","Properties":{"id":"20240612170307-gbid9qz","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"3.祛痰作用：采用小鼠酚红排泄法进行实验，表明天南星水剂有祛痰作用，给药组自呼吸道排出酚红量分别为对照组的150%及170%。"}]},{"ID":"20240612170307-7fx97yf","Type":"NodeParagraph","Properties":{"id":"20240612170307-7fx97yf","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"4.抗肿瘤作用：鲜天南星（未鉴定品种）的水提取液经醇处理的制剂，体外对Hela细胞有抑制作用，对小鼠实验性肿瘤如肉瘤S180，HCA实体型及U14等均有一定抑制作用，并证实d一甘露醇可能是抗癌有效成分。"}]},{"ID":"20240612170307-6ecx2m7","Type":"NodeParagraph","Properties":{"id":"20240612170307-6ecx2m7","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"5.抗氧化作用：天南星所含两种生物碱有不同程度的清除超氧阴离子自由基，抑制肝线粒体脂质过氧化反应等活性。"}]},{"ID":"20240612170307-moal730","Type":"NodeParagraph","Properties":{"id":"20240612170307-moal730","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"6.其它作用：天南星中两种生物碱S201和S202对离体犬的心房和乳头肌收缩力及窦房节频率均有抑制作用，并能拮抗异丙肾上腺素对心脏的作用。鲜天南星的水提醇沉制剂，体外对Hela细胞有抑制作用。对小鼠实验性肿瘤有效，对S180、HCA实体型、U14等均有一定抑制作用。"}]},{"ID":"20240612170307-dkexlnq","Type":"NodeParagraph","Properties":{"id":"20240612170307-dkexlnq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612170307-ip049eu","Type":"NodeParagraph","Properties":{"id":"20240612170307-ip049eu","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 天南星：拣去杂质，洗净灰屑，晒于。制南星：取拣净的天南星，用凉水浸漂，避免日晒，每日换水2-3次，根据其产地、质量及大小，适当掌握浸漂日数。至起白沫时，每南星100斤加白矾2斤，浸泡一月后，继续换水，直至口尝无麻辣感为止，捞出，与鲜姜片及白矾粉层层均匀铺入容器内，加水淹没，约经3-4星期，复倒入锅内煮至内无白心，取出，拣去姜片，晾至六成干，闷润后切片，晒干（每天南星100斤，用鲜姜25斤，白矾12.5-25斤）。"}]},{"ID":"20240612170307-4ic7hzk","Type":"NodeParagraph","Properties":{"id":"20240612170307-4ic7hzk","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612170307-znvufql","Type":"NodeParagraph","Properties":{"id":"20240612170307-znvufql","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 理化鉴别（1）取本品粉末2g，以温水20ml浸泡4h后，滤过。滤液浓缩点样，按纸层析法，以甲醇展开，喷以0.2%茚三酮醇溶液，80℃烘干10min，现蓝紫色斑点。（检查氨基酸）（2）薄层色谱取本品粉末1g，以乙醇10ml浸泡24h离心后吸取上清液，挥去乙醇，加 0.5ml盐酸水解，用乙醚提取，取乙醚液浓缩点样，以3，4-二羟基苯甲醛为对照品，分别点样于硅胶G薄板上，用氯仿-甲醇-甲酸（9.2：o.6：O.2）展开，2%间苯三酚乙醇液一浓硫酸（1：1）显色。供试液色谱中在与对照品色谱相应位置，显相同的红色斑点。"}]},{"ID":"20240612170307-snwua2m","Type":"NodeParagraph","Properties":{"id":"20240612170307-snwua2m","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612170307-crtoybx","Type":"NodeParagraph","Properties":{"id":"20240612170307-crtoybx","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 肺；肝；脾经"}]},{"ID":"20240612170307-bn8v3oq","Type":"NodeParagraph","Properties":{"id":"20240612170307-bn8v3oq","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612170307-m6pm4d5","Type":"NodeParagraph","Properties":{"id":"20240612170307-m6pm4d5","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性温；有毒"}]},{"ID":"20240612170307-a31tsdk","Type":"NodeParagraph","Properties":{"id":"20240612170307-a31tsdk","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612170307-elo0qb3","Type":"NodeParagraph","Properties":{"id":"20240612170307-elo0qb3","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 阴虚燥咳，热极、血虚动风者禁服，孕妇慎服。生天南星使用不当易致中毒，症状有口腔粘膜糜烂，甚至坏死脱落，唇舌咽喉麻木肿胀，运动失灵，味觉消失，大量流涎；声音嘶哑，言语不清，发热，头昏，心慌，四肢麻木，严重者可出现昏迷，惊厥；窒息，呼吸停止。"}]},{"ID":"20240612170307-wp4l07s","Type":"NodeParagraph","Properties":{"id":"20240612170307-wp4l07s","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612170307-yhyxfi1","Type":"NodeParagraph","Properties":{"id":"20240612170307-yhyxfi1","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 祛风止痉；化痰散结。主中风痰壅；口眼歪任意；半身不遂；手足麻痹；风痰眩晕；癫闲；惊风；破伤风；咳嗽多痰；痈肿；瘰疬；跌打麻痹；毒蛇咬伤"}]},{"ID":"20240612170307-wc6z03d","Type":"NodeParagraph","Properties":{"id":"20240612170307-wc6z03d","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612170307-97zx4vt","Type":"NodeParagraph","Properties":{"id":"20240612170307-97zx4vt","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g，一般制后用：或入丸散。外用：生品适量，研末以醋或酒调敷。"}]},{"ID":"20240612170307-3yf2l2l","Type":"NodeParagraph","Properties":{"id":"20240612170307-3yf2l2l","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612170307-28250bg","Type":"NodeParagraph","Properties":{"id":"20240612170307-28250bg","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：天南星，欲其下行，以黄柏引之。"}]},{"ID":"20240612170307-xrtqe45","Type":"NodeParagraph","Properties":{"id":"20240612170307-xrtqe45","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：虎掌天南星，味辛而麻，故能治风散血；气温而燥，故能胜湿除涎；性紧而毒，故能攻积拔肿而治口喎舌糜。杨士赢《直指方》云，诸风口噤，宜用南星，更以人参、石菖蒲佐之。南星得防风则不麻，得牛胆则不燥，得火炮则不毒。"}]},{"ID":"20240612170307-k50991a","Type":"NodeParagraph","Properties":{"id":"20240612170307-k50991a","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：半夏治湿痰多，南星主风痰多，是其异矣。"}]},{"ID":"20240612170307-c8ql6js","Type":"NodeParagraph","Properties":{"id":"20240612170307-c8ql6js","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"4.《本草汇言》：天南星，开结闭。散风痰之药也。但其性味辛燥而烈，与半夏略同，而毒则过之。半夏之性，燥而稍缓，南星之性，燥而颇急；半夏之辛，劣而能守，南星之辛，劣而善行。若风痰湿痰，急闭涎痰，非南星不能散。"}]},{"ID":"20240612170307-elreaj9","Type":"NodeParagraph","Properties":{"id":"20240612170307-elreaj9","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"5.《本经逢原》：天南星，即《本经》之虎掌也。为开涤风痰之专药。《本经》治心痛、寒热、结气，即《开宝》之下气、利胸膈也。《本经》之治积聚伏梁，即《开宝》之破坚积也。《本经》之治筋痿拘缓，即《开宝》之治中风、除麻痹也。《本经》之利水道，即《开宝》之散血堕胎也。盖缘一物二名，后世各执一例，是不能无两歧之说。南星、半夏皆治痰药也。然南星专走经络，故中风麻痹以之为向导，半夏专走肠胃，故呕逆泄泻以之为向导。"}]},{"ID":"20240612170307-y9erfe8","Type":"NodeParagraph","Properties":{"id":"20240612170307-y9erfe8","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"6.《本经》：主心痛，寒热，结气，积聚，伏梁，伤筋，痿，拘缓,利水道。"}]},{"ID":"20240612170307-oty6x2s","Type":"NodeParagraph","Properties":{"id":"20240612170307-oty6x2s","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"7.《别录》：除阴下湿，风眩。"}]},{"ID":"20240612170307-6kr15go","Type":"NodeParagraph","Properties":{"id":"20240612170307-6kr15go","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：治风眩目转，主疝瘕肠痛，伤寒时疾，强阴。"}]},{"ID":"20240612170307-7b8dfd4","Type":"NodeParagraph","Properties":{"id":"20240612170307-7b8dfd4","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"9.《本草拾遗》：主金疮伤折瘀血。碎敷伤处。"}]},{"ID":"20240612170307-be7fkt5","Type":"NodeParagraph","Properties":{"id":"20240612170307-be7fkt5","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"10.《日华子本草》：窨蛇、虫咬、疥癣恶疮。"}]},{"ID":"20240612170307-g4a3rkl","Type":"NodeParagraph","Properties":{"id":"20240612170307-g4a3rkl","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"11.《开宝本草》：主中风，除痰，麻痹，下气，破坚积，消痈肿，利胸膈，散血堕胎。"}]},{"ID":"20240612170307-n8cg2ow","Type":"NodeParagraph","Properties":{"id":"20240612170307-n8cg2ow","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"12.《医学启源》：去上焦痰及头眩晕。"}]},{"ID":"20240612170307-c6ejy10","Type":"NodeParagraph","Properties":{"id":"20240612170307-c6ejy10","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"13.李杲：主破伤风，口噤身强。"}]},{"ID":"20240612170307-ap9uncs","Type":"NodeParagraph","Properties":{"id":"20240612170307-ap9uncs","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"14.王好古：补肝风虚。治痰功同半夏。"}]},{"ID":"20240612170307-70wcnp9","Type":"NodeParagraph","Properties":{"id":"20240612170307-70wcnp9","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"15.《纲目》：治惊癎，口眼喎斜，喉痹，口舌疮糜，结核，解颅。"}]},{"ID":"20240612170307-ctitsg4","Type":"NodeParagraph","Properties":{"id":"20240612170307-ctitsg4","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612170307-wp0z8xh","Type":"NodeParagraph","Properties":{"id":"20240612170307-wp0z8xh","updated":"20240612170307"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612170308-cahwqcz","Type":"NodeThematicBreak","Properties":{"id":"20240612170308-cahwqcz"}},{"ID":"20240612170309-dpf83hg","Type":"NodeParagraph","Properties":{"id":"20240612170309-dpf83hg"}}]}