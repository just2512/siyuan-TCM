tyle=\"width: 583px;\" parent-style=\"width: 593px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 594px;","style":"width: 584px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗 2-20240718082527-gh7fqyz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 584px;\" parent-style=\"width: 594px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628102602-3bvagii","Type":"NodeParagraph","Properties":{"id":"20240628102602-3bvagii","updated":"20240822163235"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 556px;","style":"width: 546px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗2-20240620081539-re2x3va.webp"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 546px;\" parent-style=\"width: 556px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗6-20240628102647-vd5xokn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240628102945-4qinwso","Type":"NodeParagraph","Properties":{"id":"20240628102945-4qinwso","updated":"20240822163237"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 838px;","style":"width: 828px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗10-20240628102945-clga6oo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 828px;\" parent-style=\"width: 838px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 360px;","style":"width: 350px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗 1-20240822162810-noy89il.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 350px;\" parent-style=\"width: 360px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718082223-crzrw9t","Type":"NodeParagraph","Properties":{"id":"20240718082223-crzrw9t","updated":"20240822163239"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 434px;","style":"width: 424px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗1-20240620081534-0mjj7nu.webp"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 424px;\" parent-style=\"width: 434px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗3-20240620081547-py7ugih.webp"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 326px;","style":"width: 316px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗 2-20240822162952-rltviv3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 316px;\" parent-style=\"width: 326px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240718082323-i562p16","Type":"NodeParagraph","Properties":{"id":"20240718082323-i562p16","updated":"20240822163241"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 817px;","style":"width: 807px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗-20240718082323-aw1h4wp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 807px;\" parent-style=\"width: 817px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 312px;","style":"width: 302px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桔梗"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桔梗-20240822162654-c0uly5x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 302px;\" parent-style=\"width: 312px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612183746-v97i6h4","Type":"NodeParagraph","Properties":{"id":"20240612183746-v97i6h4","updated":"20240822163207"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：桔梗用的是根，药用桔梗至少要长三年；"}]},{"ID":"20240612183746-dio32gy","Type":"NodeThematicBreak","Properties":{"id":"20240612183746-dio32gy"}},{"ID":"20240612183757-1x3mfs0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183757-1x3mfs0","updated":"20240612183802"},"Children":[{"Type":"NodeText","Data":"桔梗《神农本草经》"}]},{"ID":"20240612183757-mghwz6a","Type":"NodeParagraph","Properties":{"id":"20240612183757-mghwz6a","updated":"20240612183757"},"Children":[{"Type":"NodeText","Data":"味辛微温。"}]},{"ID":"20240612183757-cmnvp5g","Type":"NodeParagraph","Properties":{"id":"20240612183757-cmnvp5g","updated":"20240612183757"},"Children":[{"Type":"NodeText","Data":"主胸胁痛如刀刺，腹满，肠鸣，幽幽惊恐悸气（《御览》引云：一名利如，《大观本》，作黑字）。生山谷。"}]},{"ID":"20240612183757-rdnnrgk","Type":"NodeParagraph","Properties":{"id":"20240612183757-rdnnrgk","updated":"20240612183757"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：桔梗，一名符扈，一名白药，一名利如，一名梗草，一名卢如，神农医和苦无毒，扁鹊黄帝咸，岐伯雷公甘无毒，李氏大寒，叶如荠苨，茎如笔管，紫赤，二月生（《御览》）。"}]},{"ID":"20240612183757-r22lr2y","Type":"NodeParagraph","Properties":{"id":"20240612183757-r22lr2y","updated":"20240612183757"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名利如，一名房图，一名白药，一名梗草，一名荠苨，生蒿高及冤句，二八月采根，暴干。"}]},{"ID":"20240612183757-aob6w2r","Type":"NodeParagraph","Properties":{"id":"20240612183757-aob6w2r","updated":"20240612183757"},"Children":[{"Type":"NodeText","Data":"案《说文》云：桔，桔梗，药名。《广雅》云：犁如。桔梗也。战国策云：今求柴胡，及之睾黍梁父之阴，则郄车而载耳。桔梗于沮泽，则累世不得一焉。"}]},{"ID":"20240612183757-kw7x10x","Type":"NodeParagraph","Properties":{"id":"20240612183757-kw7x10x","updated":"20240612183757"},"Children":[{"Type":"NodeText","Data":"《尔雅》云：苨，菧苨。郭璞云：荠苨。据《名医》云是此别名，下又出荠苨条，非，然陶宏景亦别为二矣。"}]},{"ID":"20240612183820-p0gxine","Type":"NodeThematicBreak","Properties":{"id":"20240612183820-p0gxine"}},{"ID":"20240612183821-ge8zr6c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183821-ge8zr6c","updated":"20240612183826"},"Children":[{"Type":"NodeText","Data":"桔梗《本草纲目》"}]},{"ID":"20240612183821-hxwonpu","Type":"NodeParagraph","Properties":{"id":"20240612183821-hxwonpu","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"「释名」亦名白药、梗草、荠。"}]},{"ID":"20240612183821-7d3t4dh","Type":"NodeParagraph","Properties":{"id":"20240612183821-7d3t4dh","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、微温、有小毒。李时珍认为：“当以苦、辛、平为”。"}]},{"ID":"20240612183821-r7lhhwc","Type":"NodeParagraph","Properties":{"id":"20240612183821-r7lhhwc","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612183821-lu6o7gq","Type":"NodeParagraph","Properties":{"id":"20240612183821-lu6o7gq","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"1、胸满不痛。用桔梗、枳壳等分。煎水二杯，成一杯，温服。"}]},{"ID":"20240612183821-ggyzjaj","Type":"NodeParagraph","Properties":{"id":"20240612183821-ggyzjaj","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"2、伤寒腹胀（阴阳不和）。用桔梗、半夏、陈皮各三钱，生姜五片，煎水二杯，成一杯服。此方名“桔梗半夏汤”。"}]},{"ID":"20240612183821-tr5vo53","Type":"NodeParagraph","Properties":{"id":"20240612183821-tr5vo53","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"3、痰嗽喘急。用桔梗一两半，研细，用童便半升，煎成四合，去渣后温服。"}]},{"ID":"20240612183821-yj0wwma","Type":"NodeParagraph","Properties":{"id":"20240612183821-yj0wwma","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"4、肺痈咳嗽（胸满振寒，脉数咽干，先吐臭痰，后吐臭脓）。用桔梗一两、甘草二两，加水三升，煮成一升，温服。吐出脓因时，是病渐愈之象。此方名“桔梗汤”。"}]},{"ID":"20240612183821-n7bxgo9","Type":"NodeParagraph","Properties":{"id":"20240612183821-n7bxgo9","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"5、喉痹。用桔梗二两，水三升，煎成一升。一次服下。"}]},{"ID":"20240612183821-uh6qc1k","Type":"NodeParagraph","Properties":{"id":"20240612183821-uh6qc1k","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"6、咽痛。先服甘草汤，如不愈，再服桔梗汤。"}]},{"ID":"20240612183821-kwyfk1t","Type":"NodeParagraph","Properties":{"id":"20240612183821-kwyfk1t","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"7、口舌生疮。治法同上。"}]},{"ID":"20240612183821-hni935u","Type":"NodeParagraph","Properties":{"id":"20240612183821-hni935u","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"8、虫牙肿痛。用桔梗、薏苡，等分为末，内服。"}]},{"ID":"20240612183821-fz1op61","Type":"NodeParagraph","Properties":{"id":"20240612183821-fz1op61","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"9、骨槽风（牙龈肿痛）。用桔梗研细，与枣肉调成丸子，如皂角子大。裹棉内，上下牙咬住。常用荆芥煎汤嗽口。"}]},{"ID":"20240612183821-hujkcz1","Type":"NodeParagraph","Properties":{"id":"20240612183821-hujkcz1","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"10、牙疳。用桔梗、茴香等分，略烧后研细敷患处。"}]},{"ID":"20240612183821-wnx3rwu","Type":"NodeParagraph","Properties":{"id":"20240612183821-wnx3rwu","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"11、眼睛痛，眼发黑。用桔梗一斤、黑牵牛头三两，共研细，加蜜成丸，如梧子大。每服四十丸，温水送下。一天服二次。此方称“桔梗丸”。"}]},{"ID":"20240612183821-dnbjvtw","Type":"NodeParagraph","Properties":{"id":"20240612183821-dnbjvtw","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"12、鼻血不止。用桔梗研细，加水调匀。每服一茶匙，一天服四次。药中加生犀牛角屑亦可。"}]},{"ID":"20240612183821-3ei94ek","Type":"NodeParagraph","Properties":{"id":"20240612183821-3ei94ek","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"13、吐血下血。治法同上。"}]},{"ID":"20240612183821-zs14yvn","Type":"NodeParagraph","Properties":{"id":"20240612183821-zs14yvn","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"14、打伤阏血。用桔梗末，每服少许，米汤送下。"}]},{"ID":"20240612183821-thsu32q","Type":"NodeParagraph","Properties":{"id":"20240612183821-thsu32q","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"15、中蛊下血（下血如鸡肝色，大量排出，病热很险）。用桔梗研细，每服一茶匙，酒送下。一天服三次。初时须强灌。约七天之后，血止。可吃猪肝汤补身体。药中也可加犀角，用量与桔梗等分。"}]},{"ID":"20240612183821-a2hoq66","Type":"NodeParagraph","Properties":{"id":"20240612183821-a2hoq66","updated":"20240612183821"},"Children":[{"Type":"NodeText","Data":"16、怀孕中恶（心腹突然大痛）。用桔梗一两，锉细，加生姜三片。水一杯煎服。"}]},{"ID":"20240612183847-op7f3tu","Type":"NodeThematicBreak","Properties":{"id":"20240612183847-op7f3tu"}},{"ID":"20240612183851-mspu3e3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183851-mspu3e3","updated":"20240612183857"},"Children":[{"Type":"NodeText","Data":"桔梗《本草便读》"}]},{"ID":"20240612183851-857vp18","Type":"NodeParagraph","Properties":{"id":"20240612183851-857vp18","updated":"20240612183851"},"Children":[{"Type":"NodeText","Data":"为诸药之舟楫．开提肺气散风寒．扫上部之邪氛．清利咽喉平咳逆．升而复降．宣胸快膈有功．苦且辛平．泄郁消痰多效．（桔梗味苦而辛．性平入肺．一切肺部风寒风热皆可用．此解散之从辛也．其降气下痰从苦也．肺喜清肃．以下行为顺．外邪固束．则肺气不降．肺不降则生痰．桔梗能治之．惟阴虚气升者不宜耳．桔梗色白．为肺之专药．凡一切肺痿肺痈寒热咳嗽皆可治耳．）"}]},{"ID":"20240612183902-xprw9br","Type":"NodeThematicBreak","Properties":{"id":"20240612183902-xprw9br"}},{"ID":"20240612183903-elh7je3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183903-elh7je3","updated":"20240612183912"},"Children":[{"Type":"NodeText","Data":"桔梗《新修本草》"}]},{"ID":"20240612183903-zhkle2d","Type":"NodeParagraph","Properties":{"id":"20240612183903-zhkle2d","updated":"20240612183903"},"Children":[{"Type":"NodeText","Data":"味辛、苦，微温，有小毒。主胸胁痛如刀刺，腹满，肠鸣幽幽，惊恐悸气。利五脏肠胃，补血气，除寒热风痹，温中消谷，疗喉咽痛，下蛊毒。一名利如，一名房图，一名白药，一名梗草，一名荠 ，生嵩高山谷及宛朐。二、八月采根，曝干。"}]},{"ID":"20240612183903-36bwq7l","Type":"NodeParagraph","Properties":{"id":"20240612183903-36bwq7l","updated":"20240612183903"},"Children":[{"Type":"NodeText","Data":"节皮为之使。得牡蛎、远志疗恚怒，得硝石、石膏疗伤寒。畏白芨、龙眼、龙胆。近道处处有，叶名隐忍。二、三月生，可煮食之。桔梗疗蛊毒甚验。俗方用此，乃名荠 。今别有荠 ，能解药毒，所谓乱人参者便是，非此桔梗，而叶甚相似。但荠 叶下光明、滑泽，无毛为异，叶生又不如人参相对者尔。"}]},{"ID":"20240612183903-dv0dnop","Type":"NodeParagraph","Properties":{"id":"20240612183903-dv0dnop","updated":"20240612183903"},"Children":[{"Type":"NodeText","Data":"〔谨案〕人参，苗似五加阔短，茎圆，有三、四丫，丫头有五叶。陶引荠 乱人参，谬矣。且荠 、桔梗，又有叶差互者，亦有叶三、四对者，皆一茎直上，叶既相乱，惟以根有心、无心为别尔。"}]},{"ID":"20240612184002-bc6b9ch","Type":"NodeThematicBreak","Properties":{"id":"20240612184002-bc6b9ch"}},{"ID":"20240612184004-pn7v4z0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612184004-pn7v4z0","updated":"20240612184008"},"Children":[{"Type":"NodeText","Data":"桔梗《本经逢原》"}]},{"ID":"20240612184004-fm5ioa9","Type":"NodeParagraph","Properties":{"id":"20240612184004-fm5ioa9","updated":"20240612184004"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名荠"}]},{"ID":"20240612184004-1ncshdp","Type":"NodeParagraph","Properties":{"id":"20240612184004-1ncshdp","updated":"20240612184004"},"Children":[{"Type":"NodeText","Data":"辛甘苦微温，无毒。甘者为荠 ，苦者为苦梗，咬之腥涩者为木梗，不堪入药。"}]},{"ID":"20240612184004-1rey9sa","Type":"NodeParagraph","Properties":{"id":"20240612184004-1rey9sa","updated":"20240612184004"},"Children":[{"Type":"NodeText","Data":"《本经》主胸胁痛如刀刺，腹满肠鸣幽幽，惊恐悸气。"}]},{"ID":"20240612184004-bu8uftv","Type":"NodeParagraph","Properties":{"id":"20240612184004-bu8uftv","updated":"20240612184004"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"桔梗上升清肺气，利咽喉，为肺部引经，又能开发皮腠，故与羌、独、柴胡、、苏辈同为解表药。与甘草同为舟楫之剂，诸药有此一味不能下沉也。伤寒邪结胸胁，则痛如刀刺，邪在中焦则腹满肠鸣幽幽。辛甘升发，苦淡降泄，则邪解而气和矣。其主惊恐悸气者，心脾气郁不舒，用以升散之也。朱肱用桔梗治胸中痞满，总不出《本经》主治，仲景治寒实结胸，同贝母、巴豆，取其温中消谷破积也。治肺痈唾脓血，用桔梗、甘草，取排脓而清浊气也。治少阴证，二三日咽痛，用甘桔汤，取其调寒热通阴气也。《千金方》治喉痹毒气，桔梗二两，水煎顿服。加甘草、连翘、荆、防名如圣汤，通治咽喉诸病。桔梗有甘、苦二种，甘者曰荠 ，《千金》治强中为病，茎长兴发，不交精出，取其能升解热邪于上也。"}]},{"ID":"20240612184004-1rmev73","Type":"NodeParagraph","Properties":{"id":"20240612184004-1rmev73","updated":"20240612184004"},"Children":[{"Type":"NodeText","Data":"又干咳嗽乃痰火之邪郁在肺中，亦宜甘以润之。痢疾腹痛乃肺金之气郁在大肠，则宜苦以开之。甘升而苦降也。此药升降诸气，能入肺使诸气下降，俗泥为上升而不能下行，失其用矣。痘疹下部不能起发，为之切忌，以其性升，能阻药力于上，不得下达也。惟阴虚久嗽不宜用，以其通阳泄气也。其芦吐膈上风热实痰，生研末，白汤调服二三钱，探吐之。"}]},{"ID":"20240612184026-a1ttfkx","Type":"NodeThematicBreak","Properties":{"id":"20240612184026-a1ttfkx"}},{"ID":"20240612184027-n6xsky6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612184027-n6xsky6","updated":"20240612184041"},"Children":[{"Type":"NodeText","Data":"桔梗《本草图经》"}]},{"ID":"20240612184027-xic6yjy","Type":"NodeParagraph","Properties":{"id":"20240612184027-xic6yjy","updated":"20240612184033"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桔梗"},{"Type":"NodeText","Data":"，生嵩高山谷及冤句，今在处有之。根如小指大，黄白色；春生苗，茎高尺余；叶似杏叶而长椭，四叶相对而生，嫩时亦可煮食之；夏开花紫碧色，颇似牵牛子花，秋后结子。八月采根，细锉曝干用。叶名隐忍。其根有心，无心者乃荠 也。而荠 亦能解毒，二物颇相乱。但荠 叶下光泽无毛为异。关中桔梗，根黄，颇似蜀葵根；茎细，青色；叶小，青色，似菊花叶。古方亦单用之。《古今录验》疗卒中蛊下血如鸡肝者，昼夜出血石余，四脏皆损，惟心未毁，或鼻破待死者。取桔梗捣屑，以酒服方寸匕，日三。不能下药，以物拗口开灌之。心中当烦，须臾自定，服七日止。当食猪肝 以补之，神良。《集验方》∶疗胸中满而振寒，脉数，咽燥不渴，时时出浊唾腥臭，久久吐脓如粳米粥，是肺痈。治之以桔梗、甘草各二两炙，以水三升，煮取一升，分再服，朝暮吐脓血则瘥。"}]},{"ID":"20240612184057-ppztgow","Type":"NodeThematicBreak","Properties":{"id":"20240612184057-ppztgow"}},{"ID":"20240612184058-prmggxw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612184058-prmggxw","updated":"20240612184102"},"Children":[{"Type":"NodeText","Data":"桔梗《本草衍义》"}]},{"ID":"20240612184058-slup16t","Type":"NodeParagraph","Properties":{"id":"20240612184058-slup16t","updated":"20240612184058"},"Children":[{"Type":"NodeText","Data":"治肺热，气奔促，嗽逆，肺痈，排脓。陶隐居云∶俗方用此，乃名荠 。今别有荠，所谓乱人参者便是，非此桔梗也。《唐本》注云∶“陶引荠 乱人参，谬矣。”今详之，非也。隐居所言，其意只以根言之，所以言乱人参。《唐本》注却以苗难之，乃本注误矣。"}]},{"ID":"20240612184046-miaqfw4","Type":"NodeThematicBreak","Properties":{"id":"20240612184046-miaqfw4"}},{"ID":"20240612184048-mp9arcz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612184048-mp9arcz","updated":"20240612184052"},"Children":[{"Type":"NodeText","Data":"桔梗《本草择要纲目》"}]},{"ID":"20240612184048-cjp20tl","Type":"NodeParagraph","Properties":{"id":"20240612184048-cjp20tl","updated":"20240612184048"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612184048-9u1zdig","Type":"NodeParagraph","Properties":{"id":"20240612184048-9u1zdig","updated":"20240612184048"},"Children":[{"Type":"NodeText","Data":"辛苦微温无毒．浮而升．阳也．入手太阴足少阴经．（去芦净米泔水浸一宿．焙干用．）"}]},{"ID":"20240612184048-1q3jvy9","Type":"NodeParagraph","Properties":{"id":"20240612184048-1q3jvy9","updated":"20240612184048"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240612184048-bmmtt4z","Type":"NodeParagraph","Properties":{"id":"20240612184048-bmmtt4z","updated":"20240612184048"},"Children":[{"Type":"NodeText","Data":"肺热气奔促咳逆肺痈．排脓．开提气血．咽中痛．非此不能除．清利头目．破滞及积块．诸药有此不能下沉．谓之舟楫．"}]},{"ID":"20240612184014-uylb1jn","Type":"NodeThematicBreak","Properties":{"id":"20240612184014-uylb1jn"}},{"ID":"20240612184015-q1fg8s6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612184015-q1fg8s6","updated":"20240612184020"},"Children":[{"Type":"NodeText","Data":"桔梗《得配本草》"}]},{"ID":"20240612184015-b725fe1","Type":"NodeParagraph","Properties":{"id":"20240612184015-b725fe1","updated":"20240612184015"},"Children":[{"Type":"NodeText","Data":"节皮为之使。畏白芨、龙胆草。忌猪肉。伏砒。"}]},{"ID":"20240612184015-w3gl8g3","Type":"NodeParagraph","Properties":{"id":"20240612184015-w3gl8g3","updated":"20240612184015"},"Children":[{"Type":"NodeText","Data":"辛、苦、平。入手太阴经气分。行表达窍，开提气血，能载诸药上浮，以消郁结。治痰壅喘促，鼻塞，肺痈，干咳，目赤，喉痹咽痛，齿痛口疮，胸膈刺痛，腹痛肠鸣。配栀子、大黄，治目赤肿痛。配大力子、大黄，治疫毒。配阿胶，治肺痿。配诃子，治失音。配茴香，烧研敷牙疳臭烂。配枳壳，利胸膈。君甘草，治少阴咽痛，及肺痈咳嗽吐脓如粳米粥者。入凉膈散，则不峻下。入补血药，清理咽喉。入治痢药，开肺气之郁于大肠。入治嗽药，散火邪之郁于肺中。"}]},{"ID":"20240612184015-hoc83ko","Type":"NodeParagraph","Properties":{"id":"20240612184015-hoc83ko","updated":"20240612184015"},"Children":[{"Type":"NodeText","Data":"刮去浮皮，米泔浸，微炒。若欲专用降剂，此物不宜同用。诸气上浮，血病火炎，二者禁用。"}]},{"ID":"20240612183945-3ymxaqj","Type":"NodeThematicBreak","Properties":{"id":"20240612183945-3ymxaqj"}},{"ID":"20240612183946-ky000zi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183946-ky000zi","updated":"20240612183951"},"Children":[{"Type":"NodeText","Data":"桔梗《本草思辨录》"}]},{"ID":"20240612183946-tjq0his","Type":"NodeParagraph","Properties":{"id":"20240612183946-tjq0his","updated":"20240612183946"},"Children":[{"Type":"NodeText","Data":"桔梗能升能降，能散能泄，四者兼具。故升不逮升柴，降不逮枳朴，散不逮麻杏，泄不逮硝黄。盖其色白，味辛，气微温，纯乎肺药（肺恶寒恶热）。而中心微黄，味又兼苦，则能由肺以达肠胃。辛升而散，苦降而泄，苦先辛后，降而复升，辗转于咽喉胸腹肠胃之间。"}]},{"ID":"20240612183946-g3539ag","Type":"NodeParagraph","Properties":{"id":"20240612183946-g3539ag","updated":"20240612183946"},"Children":[{"Type":"NodeText","Data":"本经所桔梗实不入肾，仲圣桔梗汤治少阴病咽痛，是肾家邪热循经而上，肺为热壅，以桔梗开提肺气，佐甘草以缓之，自然热散痛止，并非治肾，邹氏之论极是。气为血帅，气利则血亦利，故桔梗汤并主血痹。推之排脓与治肺痈，治结胸，仲圣诸方，无不与本经吻合。即肘后方治肠内瘀血，丹溪治痢疾腹痛，亦只如其分以任之耳。"}]},{"ID":"20240612183946-t9vcgi1","Type":"NodeParagraph","Properties":{"id":"20240612183946-t9vcgi1","updated":"20240612183946"},"Children":[{"Type":"NodeText","Data":"物理至微，古圣何能尽言，得其旨而扩之，方为善读古书。易老舟楫之剂载药不沉之说，大为张隐庵所訾。其实桔梗降而复升，性与肺比，不易下沉，外科于上焦痈疡，所以非此不可，洄溪评外科正宗无异言。且易老以为舟楫之剂者，与甘草同用也。桔梗得甘草，自更羁留于上，名之为舟楫何害。至备要表散寒邪一语，桔梗岂胜发汗之任，骤阅之不无可诧，然古方表剂固多用之。盖其开提气血，通窍宣滞，与羌防橘半等为伍，殊有捷效，鼻塞尤宜。"}]},{"ID":"20240612183946-we1sztt","Type":"NodeParagraph","Properties":{"id":"20240612183946-we1sztt","updated":"20240612183946"},"Children":[{"Type":"NodeText","Data":"惟属以偏裨之任则可，若竟恃为表剂，则不能无弊。又徐氏谓咳证用桔梗，是宋以后法，升提究非所宜。不知肺苦气上逆，而气逆之因不一。若肺感风寒，气不得宣而逆而咳，非开肺郁而提出之，曷云能瘳。况桔梗白散治咳而胸满，载在外台。洄溪盖尝讥叶氏未阅外台者，何遂忘之谓是宋后法也。"}]},{"ID":"20240612183946-j1s7tp9","Type":"NodeParagraph","Properties":{"id":"20240612183946-j1s7tp9","updated":"20240612183946"},"Children":[{"Type":"NodeText","Data":"桔梗与芍药，皆能治痢疾腹痛。惟桔梗是治肺气之郁于大肠，散而上行。芍药是治脾家血中之气结，破而下行。若非滞下之痢，二者皆不相宜。伤寒金匮两书，凡云利者即是泻，非今之所谓痢，痢则必加下重字以别之。故真武汤若下利者去芍药，四逆散治泄利下重不去，通脉四逆汤治下利清谷本无芍药，腹中痛始加之，以其为姜附之佐，于里寒无伤也。咽痛去之者，芍药不能散上结之阳也。桔梗之加，全为咽痛。虽不治利而利时不去，与芍药不去之意正同。利不止，无怪脉之不出，利止而脉不出，则桔梗之散，大有妨于生脉，与芍药之有妨咽痛亦同。故必须去之而加生脉之人参，此仲圣或去或加之所以然也。邹氏不达，而谓芍药止腹痛下利，桔梗亦止腹痛下利，误之至矣。"}]},{"ID":"20240612183930-npco0as","Type":"NodeThematicBreak","Properties":{"id":"20240612183930-npco0as"}},{"ID":"20240612183932-hok3wce","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183932-hok3wce","updated":"20240612183938"},"Children":[{"Type":"NodeText","Data":"桔梗《神农本草经赞》"}]},{"ID":"20240612183932-985gni5","Type":"NodeParagraph","Properties":{"id":"20240612183932-985gni5","updated":"20240612183932"},"Children":[{"Type":"NodeText","Data":"味辛微温。主胸胁痛如刀刺。腹满肠鸣幽幽。惊恐悸气。生山谷。"}]},{"ID":"20240612183932-uvnhfys","Type":"NodeParagraph","Properties":{"id":"20240612183932-uvnhfys","updated":"20240612183932"},"Children":[{"Type":"NodeText","Data":"沮泽庸求。有无心摄。关内葵根。嵩高杏叶。梗直疏通。蜜甘调燮。承载功同。巨川舟楫。"}]},{"ID":"20240612183932-9e6w0fg","Type":"NodeParagraph","Properties":{"id":"20240612183932-9e6w0fg","updated":"20240612183932"},"Children":[{"Type":"NodeText","Data":"战国策。求桔梗于沮泽。则累世不得一焉。苏恭曰。桔梗荠叶有差互者。有三四对者。"}]},{"ID":"20240612183932-0dhcbur","Type":"NodeParagraph","Properties":{"id":"20240612183932-0dhcbur","updated":"20240612183932"},"Children":[{"Type":"NodeText","Data":"皆一茎直上。惟以根有心为别耳。苏颂曰。关中所出。根黄皮似蜀葵。叶如菊。群芳谱。生嵩高山谷及冤句。根如指大。叶似杏叶。李时珍曰。此草之根。结实而梗直故名。名医曰。甘草一名蜜甘。张元素曰。为肺部引经。与甘草同行。譬如铁石入江。非舟楫不载。诸药有此一味。不能下沉也。"}]},{"ID":"20240612183919-jeh8vi5","Type":"NodeThematicBreak","Properties":{"id":"20240612183919-jeh8vi5"}},{"ID":"20240612183921-fwn1qsl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183921-fwn1qsl","updated":"20240612183925"},"Children":[{"Type":"NodeText","Data":"桔梗《本草崇原》"}]},{"ID":"20240612183921-6bcrtb9","Type":"NodeParagraph","Properties":{"id":"20240612183921-6bcrtb9","updated":"20240612183921"},"Children":[{"Type":"NodeText","Data":"气味辛，微温，有小毒。主治胸胁痛如刀刺，腹满，肠鸣幽幽，惊恐悸气。"}]},{"ID":"20240612183921-4tuknn8","Type":"NodeParagraph","Properties":{"id":"20240612183921-4tuknn8","updated":"20240612183921"},"Children":[{"Type":"NodeText","Data":"（桔梗近道处处有之，二三月生苗，叶如杏叶而有毛，茎如笔管，紫赤色，高尺余，夏开小花紫碧色，秋后结实。其根外白中黄有心，味辛而苦；若无心味甜者，荠 也。）"}]},{"ID":"20240612183921-75bv3o6","Type":"NodeParagraph","Properties":{"id":"20240612183921-75bv3o6","updated":"20240612183921"},"Children":[{"Type":"NodeText","Data":"桔梗根色黄白，叶毛，味辛，禀太阴金土之气化。味苦性温，花茎紫赤，又禀少阴火热之气化。主治胸胁痛如刀刺者，桔梗辛散温行，能治上焦之胸痛，而旁行于胁，复能治少阳之胁痛而上达于胸也。腹满，肠鸣幽幽者，腹中寒则满，肠中寒则鸣。腹者土也，肠者金也。桔梗禀火土金相生之气化，能以火而温腹满之土寒，更能以火而温肠鸣之金寒也。惊恐悸气，少阴病也。心虚则惊，肾虚则恐，心肾皆虚则悸。桔梗得少阴之火化，故治惊恐悸气。"}]},{"ID":"20240612183921-vnubsyr","Type":"NodeParagraph","Properties":{"id":"20240612183921-vnubsyr","updated":"20240612183921"},"Children":[{"Type":"NodeText","Data":"愚按∶梗桔治少阳之胁痛，上焦之胸痹，中焦之肠鸣，下焦之腹满。又，惊则气上，恐则气下，悸则动中，是桔梗为气分之药，上中下皆可治也。张元素不参经义，谓桔梗乃舟楫之药，载诸药而不沉。今人熟念在口，终身不忘。夫以元素杜撰之言为是，则《本经》几可废矣。医门豪杰之士，阐明神农之《本经》，轩岐之《灵》《素》，仲祖之《论》《略》，则千百方书，皆为糟粕。设未能也，必为方书所囿，而蒙蔽一生矣，可畏哉。"}]},{"ID":"20240612183837-g0jj4ze","Type":"NodeThematicBreak","Properties":{"id":"20240612183837-g0jj4ze"}},{"ID":"20240612183838-0z7pt1f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183838-0z7pt1f","updated":"20240612183842"},"Children":[{"Type":"NodeText","Data":"桔梗《本草新编》"}]},{"ID":"20240612183838-5rg1w6n","Type":"NodeParagraph","Properties":{"id":"20240612183838-5rg1w6n","updated":"20240612183838"},"Children":[{"Type":"NodeText","Data":"桔梗，味苦，气微温，阳中阴也，有小毒。入手足肺、胆二经。润胸膈，除上气壅闭，清头目，散表寒邪，祛胁下刺痛，通鼻中窒塞，治咽喉肿痛，消肺热有神，消肺痈殊效，能消恚怒，真舟楫之需，引诸药上升，解小儿惊痫，提男子血气，为药中必用之品，而不可多用者也。盖少用，则攻补之药，恃之上行以去病；多用，则攻补之药，借之上行而生殃。惟咽喉疼痛，与甘草多用，可以立时解氛，余则戒多用也。"}]},{"ID":"20240612183838-eriu39n","Type":"NodeParagraph","Properties":{"id":"20240612183838-eriu39n","updated":"20240612183838"},"Children":[{"Type":"NodeText","Data":"或问桔梗乃舟楫之需，毋论攻补之药，俱宜载之而上行矣，然亦有不能载之者，何故？"}]},{"ID":"20240612183838-p15it2v","Type":"NodeParagraph","Properties":{"id":"20240612183838-p15it2v","updated":"20240612183838"},"Children":[{"Type":"NodeText","Data":"曰∶桔梗之性上行，安有不能载之者乎。其不能载者，必用药之误也。夫桔梗上行之药，用下行之药于攻补之中，则桔梗欲上而不能上，势必下行之药，欲下而不能下矣。余犹记在襄武先辈徐叔岩，闻余论医，阴虚者宜用六味地黄汤，阳虚者宜用补中益气汤。徐君曰∶余正阴阳两虚也。余劝其夜服地黄汤，日服补中益气汤，服旬日，而精神健旺矣。别二年复聚，惊其精神不复似昔，问曾服前二汤否，徐君曰∶子以二汤治予病，得愈后，因客中无仆，不能朝夕煎饮消息子之二方，而合为丸服，后气闭于胸膈之间，医者俱言二方之不可长服，予久谢绝。今幸再晤，幸为我治之。予仍以前二方，令其朝夕分服，精神如旧。徐君曰∶何药经吾子之手，而病即去也，非夫医而何？余曰∶非余之能，君自误耳。徐问故。余曰∶六味地黄汤，补阴精之药，下降者也；补中益气汤，补阳气之药，上升者也。二汤分早晚服之，使两不相妨，而两有益也。今君合而为一，则阳欲升，阴又欲降，彼此势均力敌，两相持，而两无升降，所以饱闷于中焦，不上不下也。徐君谢曰∶医道之渊微也如此。夫桔梗与升麻、柴胡，同是升举之味，而升麻、柴胡用之于六味汤丸之内，其不能升举如此，然则桔梗之不能载药上行，又何独不然哉。正可比类而共观也。"}]},{"ID":"20240612183838-w9nur0d","Type":"NodeParagraph","Properties":{"id":"20240612183838-w9nur0d","updated":"20240612183838"},"Children":[{"Type":"NodeText","Data":"或问桔梗散邪，而不耗正气，何以戒多用也？曰∶桔梗亦有多用而成功。少阴风邪，致喉痛如破者，多用之而邪散如响。是邪在上者，宜多用；而邪在下者，即不宜多用。"}]},{"ID":"20240612183838-vlnun1x","Type":"NodeParagraph","Properties":{"id":"20240612183838-vlnun1x","updated":"20240612183838"},"Children":[{"Type":"NodeText","Data":"或问《古今录验方》中载桔梗治中蛊毒。下血如鸡肝片者血块石余，服方寸匕，七日三服而愈，其信然乎？曰∶此失其治蛊之神方，止记其引导之味也。中蛊必须消毒，下血必须生血，一定之理也。桔梗既非消毒之品，又非生血之药，乌能治蛊而止血乎。盖当时必有神奇之丸，以酒调化，同桔梗汤送之奏功，而误传为桔梗，《古今录》遂志之也。"}]},{"ID":"20240612183838-av4xz5t","Type":"NodeParagraph","Properties":{"id":"20240612183838-av4xz5t","updated":"20240612183838"},"Children":[{"Type":"NodeText","Data":"或问桔梗不可多用，而吾子又谓可以多用，何言之相背也？曰∶邪在上者宜多，邪在下者宜少，余已先辨之，未尝相背也。虽然，用药贵得其宜，要在临症斟酌。有邪在上，多用桔梗而转甚；有邪在下，少用桔梗而更危。盖邪有虚实之不同，而桔梗非多寡之可定，故实邪可用桔梗，而虚邪断不可用桔梗也。（〔批〕寒邪者，实邪也，热邪者，虚邪也，又不可不知。）"}]},{"ID":"20240612183807-8bc7087","Type":"NodeThematicBreak","Properties":{"id":"20240612183807-8bc7087"}},{"ID":"20240612183808-xxv6tyb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183808-xxv6tyb","updated":"20240612183812"},"Children":[{"Type":"NodeText","Data":"桔梗《本草从新》"}]},{"ID":"20240612183808-puwfmkg","Type":"NodeParagraph","Properties":{"id":"20240612183808-puwfmkg","updated":"20240612183808"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣通气血、泻火散寒、载药上浮．"}]},{"ID":"20240612183808-552s5lb","Type":"NodeParagraph","Properties":{"id":"20240612183808-552s5lb","updated":"20240612183808"},"Children":[{"Type":"NodeText","Data":"苦辛平．色白属金．入肺．（气分．）泻热．兼入手少阴心．足阳明胃经．开提气血．表散寒邪．清利头目咽喉．开胸膈滞气．凡痰壅喘促．鼻塞（肺气不利．）目赤．喉痹咽痛．（两少阴火．）齿痛（阳明风热）口疮．肺痈干咳．（火郁在肺．）胸膈刺痛．（火郁上焦．）腹痛肠鸣．（肺火郁于大肠．）并宜苦梗以开之．为诸药舟楫．载之上浮．能引苦泄峻下之剂．至于至高之分成功．（既上行而又能下气、何也、肺主气、肺金清肃、气自下行耳、枳桔汤治胸中痞满不痛、取其能通肺、利膈下气也、甘桔汤通治咽喉口舌诸病、取其苦辛散寒、甘平除热也．）去浮皮．泔浸．微炒．畏龙胆、白芨；忌猪肉．（本经、桔梗一名荠 、盖桔梗荠 乃一类、有甜苦二种、别录始分荠 条．）"}]},{"ID":"20240612183746-8f0lf80","Type":"NodeThematicBreak","Properties":{"id":"20240612183746-8f0lf80"}},{"ID":"20240612183747-45pn3e1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183747-45pn3e1","updated":"20240612183751"},"Children":[{"Type":"NodeText","Data":"桔梗《医学入门》"}]},{"ID":"20240612183747-01sixw9","Type":"NodeParagraph","Properties":{"id":"20240612183747-01sixw9","updated":"20240612183747"},"Children":[{"Type":"NodeText","Data":"桔梗苦辛提气血，头目鼻咽皆肺热，胸胁腹肠多有痰，又定惊痫排疮疖。"}]},{"ID":"20240612183747-49yvl5g","Type":"NodeParagraph","Properties":{"id":"20240612183747-49yvl5g","updated":"20240612183747"},"Children":[{"Type":"NodeText","Data":"桔，结也；梗，绠也，其文缔结如绠也。气微温。小毒。浮而升，阴中阳也，手太阴引经药。《衍义》谓其开提气血。凡气血药中宜用，载诸药不致下沉，为舟楫之剂。主肺热气促，嗽逆脓血寒热，肺痿肺痈，及头目不清，鼻塞鼻衄，口疮牙风，喉痹咽肿，胸胁痛如刀刺，腹满积块，肠鸣下痢，中冷食不消，霍乱转筋，皆气凝血滞痰壅也。兼定大人惊恐风痹，小儿客忤惊痫，一切疮疖痈疽在表实证，假此引药行上行表。抑论本草云补气血，又曰养血补内漏。许旌阳谓其能升水降火。愚亦谓其有桔槔之义，故仲景用治少阴咽痛咽干。然则《衍义》所谓能开散气血凝滞，而痰亦疏通，能升提行上行表，而升中有降，故丹溪曰∶惟下虚及怒气上升者不宜。去头及两畔附枝，米泔浸一宿，焙干，节皮为使。畏白芨、龙眼、龙胆。与牡蛎、远志同用疗恚怒，与石膏、葱白同用能升气于至阴之下，与硝黄同用能引至胞中至高之分，利五脏肠胃。又有一种甜桔梗，即荠根，足以乱人参。见后卷。"}]},{"ID":"20240612183722-2arxhos","Type":"NodeThematicBreak","Properties":{"id":"20240612183722-2arxhos"}},{"ID":"20240612183723-70sjddp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183723-70sjddp","updated":"20240612183735"},"Children":[{"Type":"NodeText","Data":"桔梗《证类本草》"}]},{"ID":"20240612183723-1mcucba","Type":"NodeParagraph","Properties":{"id":"20240612183723-1mcucba","updated":"20240612183723"},"Children":[{"Type":"NodeText","Data":"味辛、苦，微温，有小毒。主胸胁痛如刀刺，腹满肠鸣幽幽，惊恐悸气利五脏肠胃，补血气，除寒热风痹，温中消谷，疗喉咽痛，下蛊毒。一名利如，一名房图，一名白药，一名梗草，一名荠 。生嵩高山谷及冤句。二、八月采根，曝干。（节皮为之使。得牡蛎、远志，疗恚怒。得硝石、石膏，疗伤寒。畏白芨、龙眼、龙胆。）"}]},{"ID":"20240612183723-qi0hgxt","Type":"NodeParagraph","Properties":{"id":"20240612183723-qi0hgxt","updated":"20240612183723"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处有，叶名隐忍。二、三月生，可煮食之。桔梗疗蛊毒甚验，俗方用此，乃名荠 。今别有荠 ，能解药毒。所谓乱人参者便是。非此桔梗，而叶甚相似。但荠 叶下光明、滑泽、无毛为异，叶生又不如人参相对者尔。唐本注云∶人参，苗似互加阔短，茎圆，有三、四桠，桠头有五叶。陶引荠 乱人参，谬矣。且荠 、桔梗，又有叶差互者，亦有叶三、四对者，皆一茎直上，叶既相乱，唯以根有心、无心为别尔。臣禹锡等谨按药性论云∶桔梗，臣，味苦，平，无毒。能治下痢，破血，去积气，消积聚痰涎，主肺气气促嗽逆，除腹中冷痛，主中恶及小儿惊痫。日华子云∶下一切气，止霍乱转筋，心腹胀痛，补五劳，养气，除邪辟温，补虚，消痰破症瘕，养血排脓，补内漏及喉痹， 毒。以白粥解。"}]},{"ID":"20240612183723-03owsid","Type":"NodeParagraph","Properties":{"id":"20240612183723-03owsid","updated":"20240612183723"},"Children":[{"Type":"NodeText","Data":"图经曰∶桔梗，生嵩高山谷及冤句，今在处有之。根如小指大，黄白色。春生苗，茎高尺余。"}]},{"ID":"20240612183723-gnfj0qc","Type":"NodeParagraph","Properties":{"id":"20240612183723-gnfj0qc","updated":"20240612183723"},"Children":[{"Type":"NodeText","Data":"叶似杏叶而长椭，四叶相对而生，嫩时亦可煮食之。夏开花紫碧色，颇似牵牛子花，秋后结子．八月采根，细锉曝干用。叶名隐忍。其根有心，无心者乃荠 也。而荠 亦能解毒，二物颇相乱。但荠 叶下光泽无毛为异。关中桔梗，根苗，颇似蜀葵根。茎细，青色。叶小，青色，似菊花叶。古方亦单用之。《古今录验》∶疗卒中蛊下血如鸡肝者，昼夜出血石余，四脏皆损，唯心未毁，或鼻破待死者。取桔梗捣屑，以酒服方寸匕，日三。不能下药，以物拗口开灌之，心中当烦，须臾自定，服七日止。当食猪肝 以补之，神良。《集验方》∶疗胸中满而振寒，脉数，咽燥，不渴，时时出浊唾腥臭，久久吐脓如粳米粥，是肺痈。治之以梧梗、甘草各二两炙，以水三升，煮取一升。分再服，朝暮吐脓血则瘥。"}]},{"ID":"20240612183723-a2gwetj","Type":"NodeParagraph","Properties":{"id":"20240612183723-a2gwetj","updated":"20240612183723"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用木梗，真似桔梗，咬之只是腥涩不堪。凡使，去头上尖硬二、三分以来，并两畔附枝子。于槐砧上细锉，用百合水浸一伏时，漉出，缓火熬令干用。每修事四两，用生百合五分捣作膏，投于水中浸。圣惠方∶治马喉痹并毒瓦斯壅塞。用桔梗二两去芦头锉，以水三大盏，煎至一盏，去滓，不计时分温三服。又方妊娠中恶，心腹疼痛。用桔梗一两细锉，水一中盏，人生姜三片，煎至六分去滓，非时温服。外台秘要治卒客忤停尸不能言者。烧桔梗二两，末，米饮服，仍吞麝香如大豆许，佳。千金方∶治喉闭并毒瓦斯。桔梗二两，水三升，煮取一升，顿服。又方∶鼻衄方∶桔梗为末，水服方寸匕，日四、五，亦止吐下血。百一方∶若被打击，瘀血在肠内。久不消，时发动者。取桔梗末，熟水下刀圭。经验后方∶治骨 风，牙疼肿。桔梗为末，枣穣和丸如皂子大，绵裹咬之。肿则荆芥汤漱之。简要济众∶治痰嗽喘急不定。桔梗一两半，捣罗为散，用童子小便半升，煎取四合，去滓温服。子母秘录治小儿卒客忤死。烧桔梗末，三钱匕饮服。杜壬治上焦有热，口舌咽中生疮，嗽有脓血。桔梗一两，甘草二两，右为末，每服二钱，水一盏，煎六分去滓，温服，食后细呷之，亦治肺壅。梅师方∶治卒蛊毒，下血如鹅肝，昼夜不绝，脏腑败坏。桔梗捣汁，服七合佳。"}]},{"ID":"20240612183723-7esbqwa","Type":"NodeParagraph","Properties":{"id":"20240612183723-7esbqwa","updated":"20240612183723"},"Children":[{"Type":"NodeText","Data":"衍义曰∶桔梗，治肺热气奔促、嗽逆，肺痈排脓。陶隐居云∶俗方用此，乃名荠 。今别有荠，所谓乱人参者便是，非此桔梗也。《唐本》注云∶陶引荠 乱人参，谬矣。今详之∶非也。陶隐居所言，其意只以根言之，所以言乱人参。《唐本》注却以苗难之，乃本注误矣。"}]},{"ID":"20240612183612-ndkbw25","Type":"NodeThematicBreak","Properties":{"id":"20240612183612-ndkbw25"}},{"ID":"20240612183710-3zuzzzl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183710-3zuzzzl","updated":"20240612183715"},"Children":[{"Type":"NodeText","Data":"桔梗《长沙药解》"}]},{"ID":"20240612183710-a5p9h8x","Type":"NodeParagraph","Properties":{"id":"20240612183710-a5p9h8x","updated":"20240612183710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛微温。主胸胁痛如刀刺，腹满，肠鸣，幽幽惊恐悸气。生山谷。"}]},{"ID":"20240612183710-tmnzl05","Type":"NodeParagraph","Properties":{"id":"20240612183710-tmnzl05","updated":"20240612183710"},"Children":[{"Type":"NodeText","Data":"味苦、辛，入手太阴肺经。散结滞而消肿硬，化凝郁而排脓血，疗咽痛如神，治肺痈至妙，善下冲逆，最开壅塞。"}]},{"ID":"20240612183710-t6lg4uw","Type":"NodeParagraph","Properties":{"id":"20240612183710-t6lg4uw","updated":"20240612183710"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桔梗汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桔梗二两，甘草二两。"},{"Type":"NodeText","Data":"治少阴病，咽痛者。以少阴肾脉，循喉咙而挟舌本，少阴心脉，挟咽而击目系，少阴病则癸水上冲，丁火不降，郁热抟结而生咽痛。桔梗开冲塞而利咽喉，生甘草泻郁热而缓迫急也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通脉四逆汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在甘草。"},{"Type":"NodeText","Data":"治少阴病，下利脉微。咽痛者，去芍药，加桔梗一两，亦此法也。《金匮》以治肺痈，咳而胸满，振寒脉数，咽干不渴，时出浊唾腥臭，久而吐脓如米粥者。以肺气壅塞，湿热淫蒸，浊瘀腐败，化而为脓。桔梗破壅塞而行腐败，生甘草泻郁热而清肺金也。"}]},{"ID":"20240612183710-amp48hq","Type":"NodeParagraph","Properties":{"id":"20240612183710-amp48hq","updated":"20240612183710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二白散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桔梗三分，贝母三分，巴豆一分。为散，白饮和服。"},{"Type":"NodeText","Data":"治太阳中风，寒实结胸。以经病未解，而水土湿寒，乃以冷水潠灌，愈闭其表。寒湿郁动，逆冲清道，与膈上之阳，两相隔拒，寒热逼迫，痞结不开。桔梗、贝母，清降其虚热，巴豆温下其湿寒，结散郁开，腐败难容，在上则涌吐而出，在下则泄利而去矣。《外台》以治肺痈者，排决脓瘀，令其吐泄而下，肺腑清空，正气续复，不使养痈以胎祸也。"}]},{"ID":"20240612183710-oa0ngom","Type":"NodeParagraph","Properties":{"id":"20240612183710-oa0ngom","updated":"20240612183710"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"排脓汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桔梗三两，甘草二两，大枣十枚，生姜二两。"},{"Type":"NodeText","Data":"以疮疽脓硬，必当排而行之，使肿消而脓化。而死肌腐化，全赖中气，甘、枣培补脾精，生姜和中而行气，桔梗消结而化脓也。"}]},{"ID":"20240612183710-035ijrn","Type":"NodeParagraph","Properties":{"id":"20240612183710-035ijrn","updated":"20240612183710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"排脓散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桔梗二分，芍药六分，枳实十六枚。为散，鸡子黄一枚，以散数钱揉均，饮和服之，日一服。"},{"Type":"NodeText","Data":"以疮疽脓成，必当排而决之，使腐去新生。而脓瘀既泻，营血必伤，桔梗行其凝郁，枳实逐其腐败，芍药清肝风而凉营，鸡子黄补脾精而养血也。"}]},{"ID":"20240612183710-51wlio0","Type":"NodeParagraph","Properties":{"id":"20240612183710-51wlio0","updated":"20240612183710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在薯蓣。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"竹叶汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在竹叶。"},{"Type":"NodeText","Data":"并用之，以降肺气之逆也。"}]},{"ID":"20240612183710-ug6k4w6","Type":"NodeParagraph","Properties":{"id":"20240612183710-ug6k4w6","updated":"20240612183710"},"Children":[{"Type":"NodeText","Data":"桔梗苦泻辛通，疏利排决，长于降逆而开结，消瘀而化凝，故能清咽喉而止肿痛，疗疮疽而排脓血。其诸主治，清头面，理目痛，通鼻塞，疗口疮，止气喘，平腹胀，调痢疾，破血瘀，皆降逆疏壅之力也。"}]},{"ID":"20240612183613-kfvh9i8","Type":"NodeThematicBreak","Properties":{"id":"20240612183613-kfvh9i8"}},{"ID":"20240612183658-e3ahd8l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183658-e3ahd8l","updated":"20240612183703"},"Children":[{"Type":"NodeText","Data":"桔梗《本草经解》"}]},{"ID":"20240612183658-uzhzkq4","Type":"NodeParagraph","Properties":{"id":"20240612183658-uzhzkq4","updated":"20240612183658"},"Children":[{"Type":"NodeText","Data":"气微温．味辛．有小毒．主胸胁痛如刀刺．腹满．肠鸣幽幽．惊恐悸气．桔梗气微温．禀天初春稚阳之木气．入足少阳胆经．味辛有小毒．得地西方阴惨之金味．入手太阴肺经．气味俱升．阳也．胸者肺之分也．胁者胆之分也．胆气不升．肺气不降．则滞于胸胁．痛如刀刺矣．其主之者．辛以散之．温以达之也．足之三阴．从足走腹．太阴行气于三阴者也．肺亦太阴．通调上下．相传之职．太阴不能通调．则腹饱满矣．其主之者．辛以调气．温以行气也．大肠者燥金之腑也．大肠湿热．则鸣幽幽．肺与大肠为表里．桔梗辛以益肺．肺通调水道．则湿热行而肠鸣自止．胆为中正之官．胆者担也．胆气伤．则不能担当而惊恐悸矣．桔梗辛温．则扶苏条达．遂其生发之性．复其果敢之职．而惊恐悸自平也．"}]},{"ID":"20240612183658-law6uqo","Type":"NodeParagraph","Properties":{"id":"20240612183658-law6uqo","updated":"20240612183658"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612183658-c4wretw","Type":"NodeParagraph","Properties":{"id":"20240612183658-c4wretw","updated":"20240612183658"},"Children":[{"Type":"NodeText","Data":"桔梗同贝母、巴霜．名结胸汤．治痰在中焦．同人参、北味、麦冬．治小便不通．同枳壳．治胸满不痛．同甘草．名甘桔汤．治肺痈． 同生姜．治妊娠中恶心腹痛．"}]},{"ID":"20240612183613-ndvhxk6","Type":"NodeThematicBreak","Properties":{"id":"20240612183613-ndvhxk6"}},{"ID":"20240612183647-god5exp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183647-god5exp","updated":"20240612183652"},"Children":[{"Type":"NodeText","Data":"桔梗《本草述钩元》"}]},{"ID":"20240612183647-a7p9hwo","Type":"NodeParagraph","Properties":{"id":"20240612183647-a7p9hwo","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"八月采根。如指大。边白中微黄。有心。味苦而辛。苦为胜。若无心味甜者。荠耳。有一种木梗真同桔梗。只是咬之腥涩不堪为异。"}]},{"ID":"20240612183647-y7unws1","Type":"NodeParagraph","Properties":{"id":"20240612183647-y7unws1","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"根苦辛甘平。微温。味浓气轻。入手太阴肺经气分及少阴经。兼入足阳明经。主治喉咽痛。肺热气促嗽逆。除鼻塞。清利头目。口舌生疮。赤目肿痛。肺部风热。胸膈滞气及痛。"}]},{"ID":"20240612183647-p32rw54","Type":"NodeParagraph","Properties":{"id":"20240612183647-p32rw54","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"疗胸胁痛如刀刺。胸腹胀满。肠鸣幽幽。惊恐悸气。下一切气。（肺金得令则浊气自下行）破血积气。消聚痰涎。治肺痈养血排脓。补内漏。桔梗利胸中之气。能开提气血。盖中焦为气所从出之处。如有痰水饮食压在气上。惟用桔梗开通壅塞之道。升提其气上行。能使痰水饮食降下也。干咳嗽。由痰火之邪郁在肺中。宜苦桔以开之。痢疾腹痛。乃肺金之气郁在大肠。亦宜苦桔开之。后用痢药。（丹溪）与甘草同行。为舟楫之剂。诸药有此一味。不能下沉。（洁古）胸中痞满不通。同枳壳用。取其通肺利膈下气也。寒实结胸。同贝母巴豆用。"}]},{"ID":"20240612183647-m8ze801","Type":"NodeParagraph","Properties":{"id":"20240612183647-m8ze801","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"取其温中消谷破积也。肺痈唾脓。同甘草用。取其苦辛清肺。甘温泻火。又能排脓血补内漏也。少阴咽痛。亦用甘桔。取其苦辛散寒。甘平除热。合用能调寒热也。后人通治咽喉口舌诸病。加荆防连翘。名如圣汤。（濒湖）与牡蛎远志同用。疗恚怒。与石膏葱白同用。能升气于至阴之下。与硝黄同用。能引至胸中至高之分。利五脏肠胃。"}]},{"ID":"20240612183647-xuztcpj","Type":"NodeParagraph","Properties":{"id":"20240612183647-xuztcpj","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"〔论〕桔梗色白。而心微黄。质禀金气。其味先苦后辛。化火者仍归于金。是苦而胜者。正金气之归元。乃还而大畅其横遍之用耳。盖由辛宣而苦泻。以至于地。使无有壅阏。旋归辛宣者。统其气化而至于天。故能开提气血。为诸药之任载。惟兼升降而尽其功于辛宣。与上升之剂不同。所主咽痛鼻塞肺热咳逆奔促。乃其专功。至如余证。由其能行上行表。"}]},{"ID":"20240612183647-tdloqzv","Type":"NodeParagraph","Properties":{"id":"20240612183647-tdloqzv","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"使气血流通耳。海藏谓入足少阴者。以桔梗固气分药。而肾为气之元。苦则至下也。（方书治香港脚剂中。有桔梗。须空心服。益证此味之入肾矣。丹溪云。香港脚湿者。须先升提之。不用升柴。而以此代。其义可思。）桔梗与紫菀。味俱先苦后辛。苦胜辛劣。而紫菀之苦尤胜。"}]},{"ID":"20240612183647-4itl8jx","Type":"NodeParagraph","Properties":{"id":"20240612183647-4itl8jx","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"但桔梗质白属金。从金化火。仍归于金。是金能用火。金为主也。紫菀色紫属火。即从火生苦。苦为胜而终之以微金。是火为金用。火又主也。若诃子止有涩而无辛。其苦味最胜。则是金从火为用也。"}]},{"ID":"20240612183647-q162m8m","Type":"NodeParagraph","Properties":{"id":"20240612183647-q162m8m","updated":"20240612183647"},"Children":[{"Type":"NodeText","Data":"下虚及怒气上升。（嵩）又凡气逆不得下降者。弗用。攻补下焦药中。勿入。（仲淳）〔修治〕去头及两畔附枝。米泔浸一宿。焙干。"}]},{"ID":"20240612183422-opfysch","Type":"NodeThematicBreak","Properties":{"id":"20240612183422-opfysch"}},{"ID":"20240612183607-fly188g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183607-fly188g","updated":"20240612183611"},"Children":[{"Type":"NodeText","Data":"桔梗《要药分剂》"}]},{"ID":"20240612183607-89s3bhg","Type":"NodeParagraph","Properties":{"id":"20240612183607-89s3bhg","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"味苦辛。性微温。有小毒。感轻清之气而生。升也。阳中阴也。畏白芨、龙胆草。忌猪肉。伏砒。"}]},{"ID":"20240612183607-agw3fxk","Type":"NodeParagraph","Properties":{"id":"20240612183607-agw3fxk","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"【主治】主胸胁痛如刀刺。腹满肠鸣幽幽。惊恐悸气。（本经）利五脏肠胃。除寒热风痹。"}]},{"ID":"20240612183607-nqannif","Type":"NodeParagraph","Properties":{"id":"20240612183607-nqannif","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"疗咽喉痛。下蛊毒。（别录）治下痢。破血积气。消聚痰涎。去肺热气促嗽逆。除腹中冷痛。"}]},{"ID":"20240612183607-lu5pgsc","Type":"NodeParagraph","Properties":{"id":"20240612183607-lu5pgsc","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"主中恶。小儿惊痫。（甄权）下一切气。止霍乱转筋。心腹胀痛。除邪辟温。破症瘕肺痈。"}]},{"ID":"20240612183607-zxhriic","Type":"NodeParagraph","Properties":{"id":"20240612183607-zxhriic","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"养血排脓。补内漏。及喉痹。（大明）利窍。治肺部风热。清利头目咽嗌胸膈滞气及痛。除鼻塞（元素）治寒呕。（东垣）主口舌生疮。赤目肿痛。（时珍）【归经】入肺心二经。兼入胃经。为开发和解之品。（兼泻剂肺经气分药）【前论】张元素曰。桔梗清肺气。利咽喉。其色白。故为肺部引经。同甘草为舟楫之剂。"}]},{"ID":"20240612183607-5tvlj7t","Type":"NodeParagraph","Properties":{"id":"20240612183607-5tvlj7t","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"如大黄苦泄峻下之药。欲引至胸中至高之分。须用辛甘升之。譬如铁石入江。非舟楫不载。"}]},{"ID":"20240612183607-9pfigok","Type":"NodeParagraph","Properties":{"id":"20240612183607-9pfigok","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"所以诸药有此一味。不能下沉也。朱震亨曰。干咳嗽。乃痰火之邪郁在肺中。宜桔梗开之。"}]},{"ID":"20240612183607-c66fg9r","Type":"NodeParagraph","Properties":{"id":"20240612183607-c66fg9r","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"痢【禁忌】经疏曰。凡攻补下焦药中勿入。气逆上升不得下降。及邪在下焦。均忌。"}]},{"ID":"20240612183607-d074zfi","Type":"NodeParagraph","Properties":{"id":"20240612183607-d074zfi","updated":"20240612183607"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。凡用。须去头上尖硬二三分。并去浮皮。泔浸。微炒。"}]},{"ID":"20240612183422-5kfh3pk","Type":"NodeThematicBreak","Properties":{"id":"20240612183422-5kfh3pk"}},{"ID":"20240612183552-xlv1ky5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183552-xlv1ky5","updated":"20240612183557"},"Children":[{"Type":"NodeText","Data":"桔梗《本草备要》"}]},{"ID":"20240612183552-owd8efd","Type":"NodeParagraph","Properties":{"id":"20240612183552-owd8efd","updated":"20240612183552"},"Children":[{"Type":"NodeText","Data":"宣通气血，泻火散寒，载药上浮"}]},{"ID":"20240612183552-f8tgzs4","Type":"NodeParagraph","Properties":{"id":"20240612183552-f8tgzs4","updated":"20240612183552"},"Children":[{"Type":"NodeText","Data":"苦辛而平。色白属金，入肺（气分）泻热，兼入手少阴心、足阳明胃经。开提气血，表散寒邪，清利头目咽喉，开胸膈滞气。"}]},{"ID":"20240612183552-sdygls7","Type":"NodeParagraph","Properties":{"id":"20240612183552-sdygls7","updated":"20240612183552"},"Children":[{"Type":"NodeText","Data":"凡痰壅喘促、鼻塞（肺气不利）目赤、喉痹咽痛（两少阴火）、齿痛（阳明风热）口疮、肺痈干咳（火郁在肺）、胸膈刺痛（火郁上焦）、下痢腹痛、腹满肠鸣（肺火郁于大肠），并宜苦梗以开之。为诸药舟楫，载之上浮，能引苦泄峻下之剂。至于至高之分成功（既上行而又能下气何也？肺主气，肺金清，浊气自下行耳），养血排脓，补内漏（故治肺痈。时珍曰∶枳桔汤治胸中痞满不痛，取其通肺利膈下气也。甘桔汤通治咽喉口舌诸病，取其苦辛散寒、甘平除热也。宋仁宗加荆芥、防风、连翘，遂名如圣汤。王好古加味甘桔汤，失音加诃子，声不出加半夏，上气加陈皮，涎嗽加知母、贝母，咳渴加五味，酒毒加葛根，少气加人参，呕加半夏、生姜，吐脓血加紫菀，肺痿加阿胶，胸膈不利加枳壳，痞满加枳实，目赤加栀子、大黄，面肿加茯苓，肤痛加黄 ，发斑加荆、防，疫毒加牛蒡、大黄，不得眠加栀子。昂按∶观海藏所加，则用药之大较，亦可识矣）。"}]},{"ID":"20240612183552-wcryzih","Type":"NodeParagraph","Properties":{"id":"20240612183552-wcryzih","updated":"20240612183552"},"Children":[{"Type":"NodeText","Data":"去浮皮，泔浸微炒用。畏龙胆、白芨。忌猪肉。"}]},{"ID":"20240612183422-x3jomtl","Type":"NodeThematicBreak","Properties":{"id":"20240612183422-x3jomtl"}},{"ID":"20240612183542-kj6xvm1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183542-kj6xvm1","updated":"20240612183546"},"Children":[{"Type":"NodeText","Data":"桔梗《汤液本草》"}]},{"ID":"20240612183542-vek380c","Type":"NodeParagraph","Properties":{"id":"20240612183542-vek380c","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"气微温，味辛、苦，阳中之阳。味浓，气轻，阳中之阴也。有小毒。"}]},{"ID":"20240612183542-1go769n","Type":"NodeParagraph","Properties":{"id":"20240612183542-1go769n","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"入足少阴经，入手太阴肺经药。"}]},{"ID":"20240612183542-t6tls60","Type":"NodeParagraph","Properties":{"id":"20240612183542-t6tls60","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"《象》云∶治咽喉痛，利肺气。去芦，米泔浸一宿，焙干用。"}]},{"ID":"20240612183542-vbvka0e","Type":"NodeParagraph","Properties":{"id":"20240612183542-vbvka0e","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"《珍》云∶阳中之阴，谓之“舟楫”，诸药有此一味，不能下沉。治鼻塞。"}]},{"ID":"20240612183542-1kf18mx","Type":"NodeParagraph","Properties":{"id":"20240612183542-1kf18mx","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"《心》云∶利咽嗌胸膈之气。以其色白，故属肺。辛、甘，微温，治寒呕，若咽中痛，桔梗能散之也。"}]},{"ID":"20240612183542-dca24oo","Type":"NodeParagraph","Properties":{"id":"20240612183542-dca24oo","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主胸胁痛如刀刺，腹满，肠鸣幽幽，惊恐悸气。利五脏肠胃，补血气，除寒热风痹，温中消谷，疗咽喉痛，下蛊毒。"}]},{"ID":"20240612183542-ipwebcr","Type":"NodeParagraph","Properties":{"id":"20240612183542-ipwebcr","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"易老云∶与国老并行，同为舟楫之剂。如将军苦泄峻下之药，欲引至胸中至高之分成功，非此辛甘不居，譬如铁石入江，非舟楫不载，故用辛甘之剂以升之也。"}]},{"ID":"20240612183542-jw6c96n","Type":"NodeParagraph","Properties":{"id":"20240612183542-jw6c96n","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶治肺热气奔促，咳逆，肺痈排脓。"}]},{"ID":"20240612183542-y9av1zl","Type":"NodeParagraph","Properties":{"id":"20240612183542-y9av1zl","updated":"20240612183542"},"Children":[{"Type":"NodeText","Data":"《本草》又云∶节皮为之使。得牡蛎、远志，疗恚怒；得硝石、石膏，疗伤寒。畏白芨、龙眼、龙胆。"}]},{"ID":"20240612183423-p7xczqb","Type":"NodeThematicBreak","Properties":{"id":"20240612183423-p7xczqb"}},{"ID":"20240612183531-b3xpw8g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183531-b3xpw8g","updated":"20240612183535"},"Children":[{"Type":"NodeText","Data":"桔梗《名医别录》"}]},{"ID":"20240612183531-sj86i0a","Type":"NodeParagraph","Properties":{"id":"20240612183531-sj86i0a","updated":"20240612183531"},"Children":[{"Type":"NodeText","Data":"味苦，有小毒．主利五脏肠胃，补血气，除寒热风痹，温中，消谷，治喉咽痛，下蛊一名利如，一名房图，一名白药，一名梗草，一名荠 ．生嵩高及宛朐．二、八月采根干．（节皮为之使，得牡蛎、远志治恚怒；得硝石、石膏治伤寒．畏白芨、龙眼、龙胆"}]},{"ID":"20240612183531-n26e6rc","Type":"NodeParagraph","Properties":{"id":"20240612183531-n26e6rc","updated":"20240612183531"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶桔梗，味辛，微温．主胸胁痛如刀刺，腹满肠鸣幽幽，惊恐悸气．生山谷．"}]},{"ID":"20240612183423-upvv8ln","Type":"NodeThematicBreak","Properties":{"id":"20240612183423-upvv8ln"}},{"ID":"20240612183521-ayb03jd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183521-ayb03jd","updated":"20240612183526"},"Children":[{"Type":"NodeText","Data":"桔梗《本草求真》"}]},{"ID":"20240612183521-e1wlbo6","Type":"NodeParagraph","Properties":{"id":"20240612183521-e1wlbo6","updated":"20240612183521"},"Children":[{"Type":"NodeText","Data":"（山草）开提肺中风寒载药上行"}]},{"ID":"20240612183521-ospl5q7","Type":"NodeParagraph","Properties":{"id":"20240612183521-ospl5q7","updated":"20240612183521"},"Children":[{"Type":"NodeText","Data":"桔梗（专入肺。兼入心胃）。辛苦而平。按书既载能引诸药上行。又载能以下气。其义何居。盖缘人之脏腑胸膈。本贵通利。一有寒邪阻塞。则气血不通。其在于肺。则或为不利。而见痰壅喘促鼻塞。其在阳明。（胃）则或风热相搏。而见齿痛。其在少阴。（肾）则因寒蔽火郁。而见目赤喉痹咽痛。久而火郁于肺。则见口疮肺痈干咳。火郁上焦。则见胸膈刺痛。肺火移郁大肠。则见下痢腹痛。腹满肠鸣。总皆寒入于肺。闭其窍道。（一语透尽诸病根源。）则清不得上行。浊因不得下降耳。桔梗味苦气平。质浮色白。系开提肺气之圣药。可为诸药舟楫。载之上浮。能引苦泄峻下之剂至于至高之分成功。俾清气既得上升。则浊气自克下降。降气之说。理根于是。是以好古加味甘桔。无不因症加药。如失音则加诃子。声不出加半夏。上气加陈皮。涎嗽加知母贝母。咳渴加五味。酒毒加葛根。少气加人参。呕加半夏生姜。吐脓血加紫苑。肺萎加阿胶。胸膈不快加枳壳。痞满加枳实。目赤加栀子大黄。面肿加茯苓。肤痛加黄 。发斑加荆防。疫疠加牛蒡大黄。不得眠加栀子。总不离乎桔梗以为开提。（时珍曰。朱肱活人书治胸中痞满不痛。用桔梗枳壳。取其通肺利膈下气也。张仲景伤寒论治寒实结胸。用桔梗贝母巴豆。取其消谷破积也。又治肺痈唾脓。用桔梗甘草。取其苦辛清肺。甘温泻火。又能排脓血。补内漏也。其治少阴症三四日咽痛。亦用桔梗甘草。取其苦辛。甘平除热。合而用之。能除寒热也。后人易名甘桔汤。通治咽喉口舌诸病。宋仁宗加荆芥防风连翘。遂名如圣汤。极言其验也。）奈世仅知此属上升。而不知其下行。其失远矣！但痘疹下部不起勿用。以其性升之故。久嗽不宜妄用。以其通阳泄气之故。阴虚不宜妄用。以其拔火上乘之故。其芦能吐膈上风热痰实。生研末。水调服。探吐。去浮皮。泔浸微炒用。畏龙胆草白芨。忌猪肉。"}]},{"ID":"20240612183334-svj6k1m","Type":"NodeThematicBreak","Properties":{"id":"20240612183334-svj6k1m"}},{"ID":"20240612183415-4qc7qe3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183415-4qc7qe3","updated":"20240612183420"},"Children":[{"Type":"NodeText","Data":"桔梗《中药学》"}]},{"ID":"20240612183415-bwzobio","Type":"NodeParagraph","Properties":{"id":"20240612183415-bwzobio","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【药用】本品为桔梗科植物桔梗的根。"}]},{"ID":"20240612183415-xjxox2s","Type":"NodeParagraph","Properties":{"id":"20240612183415-xjxox2s","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、辛，平。入肺经。"}]},{"ID":"20240612183415-7wrszug","Type":"NodeParagraph","Properties":{"id":"20240612183415-7wrszug","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【功效】宣肺袪痰，排脓。"}]},{"ID":"20240612183415-0u8j1cl","Type":"NodeParagraph","Properties":{"id":"20240612183415-0u8j1cl","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于咳嗽痰多及咽痛音哑等症。"}]},{"ID":"20240612183415-sdudxr6","Type":"NodeParagraph","Properties":{"id":"20240612183415-sdudxr6","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"桔梗辛开苦泄，功能宣肺袪痰。如外感咳嗽，常配合解表药同用。属于外感风寒者，可与荆芥、防风、紫苏叶、杏仁等配伍；外感风热，可与前胡、牛蒡子、菊花、桑叶等配伍应用。如咽喉肿痛、声音嘶哑，可与牛蒡子、甘草、山豆根、射干等同用。"}]},{"ID":"20240612183415-2ab3krt","Type":"NodeParagraph","Properties":{"id":"20240612183415-2ab3krt","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"2.用于肺痈及咽喉肿痛等症。"}]},{"ID":"20240612183415-pqqfou5","Type":"NodeParagraph","Properties":{"id":"20240612183415-pqqfou5","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"本品能祛痰而排脓，用治肺痈，可与生苡仁、冬瓜子、桃仁、鲜芦根、鱼腥草等配伍；治咽喉痈肿，可与板蓝根、牛蒡子、马勃、白僵蚕、甘草等同用。"}]},{"ID":"20240612183415-n7zaa26","Type":"NodeParagraph","Properties":{"id":"20240612183415-n7zaa26","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【处方用名】苦桔梗、白桔梗、玉桔梗（洗净，晒干，切片用）"}]},{"ID":"20240612183415-bve7uv5","Type":"NodeParagraph","Properties":{"id":"20240612183415-bve7uv5","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至二钱，煎服。"}]},{"ID":"20240612183415-wejme0q","Type":"NodeParagraph","Properties":{"id":"20240612183415-wejme0q","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【按语】1.桔梗辛散苦泄，善能宣通肺气、袪痰排脓，故适用于咳嗽多痰、咯痰不爽、咽痛、失音以及肺痈等病症。"}]},{"ID":"20240612183415-519pt6i","Type":"NodeParagraph","Properties":{"id":"20240612183415-519pt6i","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"2.本品配甘草，可袪痰利咽；配枳壳，可利胸膈；配鱼腥草，可排脓解毒而治肺痈。"}]},{"ID":"20240612183415-5qphjxd","Type":"NodeParagraph","Properties":{"id":"20240612183415-5qphjxd","updated":"20240612183415"},"Children":[{"Type":"NodeText","Data":"【方剂举例】桔梗汤《金匮要略》：桔梗、甘草。治肺痈、咳逆胸满、吐脓。"}]},{"ID":"20240612183334-gvfi2k9","Type":"NodeThematicBreak","Properties":{"id":"20240612183334-gvfi2k9"}},{"ID":"20240612183356-zmytdam","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183356-zmytdam","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"《中国药典》：桔梗"}]},{"ID":"20240612183356-n5e9dv4","Type":"NodeParagraph","Properties":{"id":"20240612183356-n5e9dv4","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612183356-dixlei7","Type":"NodeParagraph","Properties":{"id":"20240612183356-dixlei7","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" Jú Gěnɡ"}]},{"ID":"20240612183356-0hturnw","Type":"NodeParagraph","Properties":{"id":"20240612183356-0hturnw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612183356-jh10sh2","Type":"NodeParagraph","Properties":{"id":"20240612183356-jh10sh2","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 包袱花、铃当花、道拉基"}]},{"ID":"20240612183356-y87zx43","Type":"NodeParagraph","Properties":{"id":"20240612183356-y87zx43","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612183356-rrf8jte","Type":"NodeParagraph","Properties":{"id":"20240612183356-rrf8jte","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" RADIX PLATYCODONIS"}]},{"ID":"20240612183356-w383tms","Type":"NodeParagraph","Properties":{"id":"20240612183356-w383tms","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612183356-iklo52d","Type":"NodeParagraph","Properties":{"id":"20240612183356-iklo52d","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 本品为桔梗科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桔梗"},{"Type":"NodeText","Data":"Platycodon grandiflorum（Jacq.）A.DC.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋二季采挖，洗净，除去须根，趁鲜剥去外皮或不去外皮，干燥。"}]},{"ID":"20240612183356-tlshc3p","Type":"NodeParagraph","Properties":{"id":"20240612183356-tlshc3p","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612183356-li972z5","Type":"NodeParagraph","Properties":{"id":"20240612183356-li972z5","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 本品呈圆柱形或略呈纺锤形，下部渐细，有的有分枝，略扭曲，长7～20cm，直径0.7～2cm。表面白色或淡黄白色，不去外皮者表面黄棕色至灰棕色；具纵扭皱沟，并有横长的皮孔样斑痕及支根痕。上部有横纹。有的顶端有较短的根茎或不明显，其上有数个半月形茎痕。质脆，断面不平坦，形成层环棕色，皮部类白色，有裂隙，木部淡黄白色。无臭，味微甜后苦。"}]},{"ID":"20240612183356-e4iko3f","Type":"NodeParagraph","Properties":{"id":"20240612183356-e4iko3f","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612183356-1xq449l","Type":"NodeParagraph","Properties":{"id":"20240612183356-1xq449l","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240612183356-c6kkj8o","Type":"NodeParagraph","Properties":{"id":"20240612183356-c6kkj8o","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612183356-lml0us3","Type":"NodeParagraph","Properties":{"id":"20240612183356-lml0us3","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240612183356-nnrmvng","Type":"NodeParagraph","Properties":{"id":"20240612183356-nnrmvng","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"本品为斜椭圆形或不规则薄片，外皮多已除去或偶有残留。切面皮部淡黄白色，较窄；形成层环纹明显，淡褐色；木部宽，有较多裂隙。质脆，易析断。照上述[含量测定]项下的方法测定，含总皂苷不得少于5.5％。"}]},{"ID":"20240612183356-ukz2xsz","Type":"NodeParagraph","Properties":{"id":"20240612183356-ukz2xsz","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612183356-3p0zzbx","Type":"NodeParagraph","Properties":{"id":"20240612183356-3p0zzbx","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：木栓细胞有时残存，不去外皮者有栓皮层，细胞中含草酸钙小棱晶。皮层窄，常见裂隙。韧皮部乳管群散在，壁略厚，内含微细颗粒状黄棕色物。形成层成环。木质部导管单个散在或数个相聚，呈放射状排列。薄壁细胞含菊糖。"}]},{"ID":"20240612183356-cofgvon","Type":"NodeParagraph","Properties":{"id":"20240612183356-cofgvon","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"（2）取本品，切片，用稀甘油装片，置显微镜下观察，可见扇形或类圆形的菊糖结晶。"}]},{"ID":"20240612183356-5n8duty","Type":"NodeParagraph","Properties":{"id":"20240612183356-5n8duty","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加7％硫酸乙醇-水（1：3）混合液20ml，加热回流3小时，放冷，用氯仿振摇提取2次，每次20ml，合并氯仿液，加水30ml洗涤，弃去洗液，氯仿液用无水硫酸钠脱水，滤过，滤液蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取桔梗对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各10μl，分别点于同一硅胶G薄层板上，以氯仿-乙醚（1：1）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在105℃加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240612183356-g1i1ill","Type":"NodeParagraph","Properties":{"id":"20240612183356-g1i1ill","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612183356-a61z4yg","Type":"NodeParagraph","Properties":{"id":"20240612183356-a61z4yg","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 归肺经。"}]},{"ID":"20240612183356-ljkkp45","Type":"NodeParagraph","Properties":{"id":"20240612183356-ljkkp45","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612183356-q6dhr47","Type":"NodeParagraph","Properties":{"id":"20240612183356-q6dhr47","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 苦、辛，平。"}]},{"ID":"20240612183356-r0tdlw4","Type":"NodeParagraph","Properties":{"id":"20240612183356-r0tdlw4","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612183356-ywrfbe2","Type":"NodeParagraph","Properties":{"id":"20240612183356-ywrfbe2","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 宣肺，利咽，祛痰，排脓。用于咳嗽痰多，胸闷不畅，咽痛，音哑，肺痈吐脓，疮疡脓成不溃。"}]},{"ID":"20240612183356-b8pmytr","Type":"NodeParagraph","Properties":{"id":"20240612183356-b8pmytr","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612183356-ekrr7i6","Type":"NodeParagraph","Properties":{"id":"20240612183356-ekrr7i6","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240612183356-rkddzf9","Type":"NodeParagraph","Properties":{"id":"20240612183356-rkddzf9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612183356-4giio83","Type":"NodeParagraph","Properties":{"id":"20240612183356-4giio83","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612183356-8s0e3b9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183356-8s0e3b9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：桔梗"}]},{"ID":"20240612183356-s1mkuqw","Type":"NodeParagraph","Properties":{"id":"20240612183356-s1mkuqw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612183356-2jpqx2e","Type":"NodeParagraph","Properties":{"id":"20240612183356-2jpqx2e","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" Jú Gěnɡ"}]},{"ID":"20240612183356-bmd9sif","Type":"NodeParagraph","Properties":{"id":"20240612183356-bmd9sif","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612183356-acicz78","Type":"NodeParagraph","Properties":{"id":"20240612183356-acicz78","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 符蔰、白药、利如、梗草、卢如（《吴普本草》），房图、荠苨（《别录》），苦梗（《丹溪心法》），苦桔梗（《纲目》），大药（《江苏植药志》）。"}]},{"ID":"20240612183356-2llbs2f","Type":"NodeParagraph","Properties":{"id":"20240612183356-2llbs2f","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612183356-64vjzmk","Type":"NodeParagraph","Properties":{"id":"20240612183356-64vjzmk","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612183356-z0naaze","Type":"NodeParagraph","Properties":{"id":"20240612183356-z0naaze","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612183356-3ehsrld","Type":"NodeParagraph","Properties":{"id":"20240612183356-3ehsrld","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 为桔梗科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桔梗"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋两季采收，而以秋采者体重质实，质量较佳。挖取后去净苗叶，洗净泥土，即浸水中，刮去外皮，晒干。如遇阴雨应即烘干。"}]},{"ID":"20240612183356-y5tkayj","Type":"NodeParagraph","Properties":{"id":"20240612183356-y5tkayj","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612183356-fcpm5j7","Type":"NodeParagraph","Properties":{"id":"20240612183356-fcpm5j7","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 野生于山坡草丛中。我国大部分地区均有分布。全国各地均产。主产安徽、河南、湖北、辽宁、吉林、河北、内蒙古等地。"}]},{"ID":"20240612183356-74ddl3j","Type":"NodeParagraph","Properties":{"id":"20240612183356-74ddl3j","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612183356-q3aug5j","Type":"NodeParagraph","Properties":{"id":"20240612183356-q3aug5j","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 桔梗，又名：包袱花、四叶菜、沙油菜、山铃铛花。"}]},{"ID":"20240612183356-zlb2om6","Type":"NodeParagraph","Properties":{"id":"20240612183356-zlb2om6","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～90厘米，全株光滑无毛。根肉质，圆柱形，或有分枝。茎直立，单一或分枝。叶近于无柄，生于茎中、下部的叶对生或3～4片轮生，茎上部的叶有时为互生；叶片卵状披针形，长3～6厘米，宽1～2.5厘米，先端尖，基部楔形或近圆形，边缘有锯齿。花单生于茎顶，或数朵成疏生的总状花序；花萼钟状，先端5裂；花冠钟状，蓝紫色，径3～5厘米，5裂，裂片三角形；雄蕊5，花丝短，基部扩大，花药围绕花柱四周；子房半下位，5室，柱头5裂，反卷，被白柔毛。朔果倒卵形，熟时顶部5瓣裂。种子卵形，有3棱。花期7～9月。果期8～10月。"}]},{"ID":"20240612183356-0rce3q2","Type":"NodeParagraph","Properties":{"id":"20240612183356-0rce3q2","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612183356-w25bweb","Type":"NodeParagraph","Properties":{"id":"20240612183356-w25bweb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 干燥根呈长纺锤形或长圆柱形。下部渐细，有时分歧稍弯曲，顶端具根茎（芦头），上面有许多半月形茎痕（芦碗）。全长6～30厘米，直径约0.5～2厘米。表面白色或淡棕色，皱缩，上部有横纹，通体有纵沟，下部尤多，并有类白色或淡棕色的皮孔样根痕，横向略延长。质坚脆，易折断，断面类白色至类棕色，略带颗粒状，有放射状裂隙，皮部较窄，形成层显着，淡棕色，木部类白色，中央无髓。气无，味微甘而后苦。以条粗均匀，坚实、洁白、味苦者佳。条不均匀，折断中空，色灰白者质次。"}]},{"ID":"20240612183356-lvgnxv7","Type":"NodeParagraph","Properties":{"id":"20240612183356-lvgnxv7","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612183356-2x6iow1","Type":"NodeParagraph","Properties":{"id":"20240612183356-2x6iow1","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 桔梗皂甙有溶血作用，不能用于注射，口服后在消化道水解破坏，即无溶血作用。给小鼠皮下注射，最小致死量为770毫克/公斤。"}]},{"ID":"20240612183356-noqya35","Type":"NodeParagraph","Properties":{"id":"20240612183356-noqya35","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612183356-h098hlm","Type":"NodeParagraph","Properties":{"id":"20240612183356-h098hlm","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 根含皂甙，已知其成分有远志酸，桔梗皂甙元及葡萄糖。又含菠菜甾醇、α-菠菜甾莳-β-D-葡萄糖甙、Δ7-豆甾烯醇、白桦脂醇，并含菊糖、桔梗聚糖。又从桔梗得到三个三萜烯类物质：桔梗酸A、B、及C。"}]},{"ID":"20240612183356-mv6hsc9","Type":"NodeParagraph","Properties":{"id":"20240612183356-mv6hsc9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"花含飞燕草素-3二-咖啡酰芦丁糖-5-葡萄糖甙。"}]},{"ID":"20240612183356-v03s4t7","Type":"NodeParagraph","Properties":{"id":"20240612183356-v03s4t7","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612183356-bmmoigo","Type":"NodeParagraph","Properties":{"id":"20240612183356-bmmoigo","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" ①祛痰作用"}]},{"ID":"20240612183356-lh8pc1b","Type":"NodeParagraph","Properties":{"id":"20240612183356-lh8pc1b","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"麻醉犬口服煎剂1克/公斤后，呼吸道粘液分泌量显着增加，作用强度可与氯化铵相比。另有报道认为其作用强于远志而次于美远志，而用酚红排泄测定法时，其作用比远志弱。对麻醉猫，也有促进呼吸道粘液分泌的作用。祛痰作用主要由于其中所含的皂甙所引起，小剂量时能刺激胃粘膜，引起轻度恶心，因而反射地增加支气管的分泌。按照溶血作用强弱的比较，认为野生桔梗比栽培的作用强，未剥皮的比剥皮的作用强得多，紫花的比白花的作用稍大，生长2年的作用最强，1年的次之，3年的作用最小。与远志相比，桔梗的溶血作用较弱。"}]},{"ID":"20240612183356-6qtoqk1","Type":"NodeParagraph","Properties":{"id":"20240612183356-6qtoqk1","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240612183356-wgrejia","Type":"NodeParagraph","Properties":{"id":"20240612183356-wgrejia","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"家兔内服桔梗的水或酒精提取物均可使血糖下降，对四氧嘧啶引起的家兔糖尿病，降低血糖的作用更加显著，肝糖原的降低在用药后亦可恢复。桔梗皂甙能降低大鼠肝内胆甾醇含量及增加类甾醇和没食子酸的分泌，因而对胆甾醇代谢有影响。体外试验水浸剂对絮状表皮癣菌有抑制作用。"}]},{"ID":"20240612183356-9fniwsk","Type":"NodeParagraph","Properties":{"id":"20240612183356-9fniwsk","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612183356-xsxhx01","Type":"NodeParagraph","Properties":{"id":"20240612183356-xsxhx01","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去芦头，洗净捞出，润透后切片，晒干。"}]},{"ID":"20240612183356-690l1h8","Type":"NodeParagraph","Properties":{"id":"20240612183356-690l1h8","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使桔梗，去头上尖硬二三分已来，并两畔附枝子，细锉，用百合水浸一伏时。漉出，缓火熬令干用。每修事四两，用生百合五分，捣作膏投于水中浸。\""}]},{"ID":"20240612183356-5k899qb","Type":"NodeParagraph","Properties":{"id":"20240612183356-5k899qb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"桔梗，今但刮去浮皮。米泔水浸一夜，切片微炒用。\""}]},{"ID":"20240612183356-6881tn8","Type":"NodeParagraph","Properties":{"id":"20240612183356-6881tn8","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612183356-1nyo58i","Type":"NodeParagraph","Properties":{"id":"20240612183356-1nyo58i","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 入肺、胃经。"}]},{"ID":"20240612183356-a8wb0ke","Type":"NodeParagraph","Properties":{"id":"20240612183356-a8wb0ke","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足少阴、手太阴。\""}]},{"ID":"20240612183356-njic0vq","Type":"NodeParagraph","Properties":{"id":"20240612183356-njic0vq","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②《品汇精要》：\"行足太阴经。\""}]},{"ID":"20240612183356-1ley3gk","Type":"NodeParagraph","Properties":{"id":"20240612183356-1ley3gk","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入手太阴、少阴，兼入足阳明胃经。\""}]},{"ID":"20240612183356-4p6hi28","Type":"NodeParagraph","Properties":{"id":"20240612183356-4p6hi28","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612183356-0gpa1ca","Type":"NodeParagraph","Properties":{"id":"20240612183356-0gpa1ca","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 苦辛，平。"}]},{"ID":"20240612183356-kc83t02","Type":"NodeParagraph","Properties":{"id":"20240612183356-kc83t02","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"辛，微温。\""}]},{"ID":"20240612183356-ekih4qa","Type":"NodeParagraph","Properties":{"id":"20240612183356-ekih4qa","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，有小毒。\""}]},{"ID":"20240612183356-vvbk5pa","Type":"NodeParagraph","Properties":{"id":"20240612183356-vvbk5pa","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"苦，平，无毒。\""}]},{"ID":"20240612183356-xb2lv94","Type":"NodeParagraph","Properties":{"id":"20240612183356-xb2lv94","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612183356-ay84l7z","Type":"NodeParagraph","Properties":{"id":"20240612183356-ay84l7z","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 阴虚久嗽、气逆及咳血者忌服。"}]},{"ID":"20240612183356-j14sivb","Type":"NodeParagraph","Properties":{"id":"20240612183356-j14sivb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"畏白及、龙眼、龙胆。\""}]},{"ID":"20240612183356-v92wq8x","Type":"NodeParagraph","Properties":{"id":"20240612183356-v92wq8x","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②《药对》：\"忌猪肉。得牡蛎、远志疗恚怒；得消石、石膏疗伤寒。\""}]},{"ID":"20240612183356-emk4xpy","Type":"NodeParagraph","Properties":{"id":"20240612183356-emk4xpy","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"③朱震亨：\"下虚及怒气上升者不宜。\""}]},{"ID":"20240612183356-tbqw4v5","Type":"NodeParagraph","Properties":{"id":"20240612183356-tbqw4v5","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"阴虚久嗽不宜用，以其通阳泄气也。\""}]},{"ID":"20240612183356-8djg3qd","Type":"NodeParagraph","Properties":{"id":"20240612183356-8djg3qd","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612183356-wae8759","Type":"NodeParagraph","Properties":{"id":"20240612183356-wae8759","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 开宣肺气，祛痰排脓。治外感咳嗽，咽喉肿痛，肺痈吐脓，胸满胁痛，痢疾腹痛。"}]},{"ID":"20240612183356-i5dwbvb","Type":"NodeParagraph","Properties":{"id":"20240612183356-i5dwbvb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主胸胁痛如刀刺，腹满，肠鸣幽幽，惊恐悸气。\""}]},{"ID":"20240612183356-rik4zio","Type":"NodeParagraph","Properties":{"id":"20240612183356-rik4zio","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"利五脏肠胃，补血气，除寒热、风痹，温中消谷，疗喉咽痛。\""}]},{"ID":"20240612183356-ohg3tty","Type":"NodeParagraph","Properties":{"id":"20240612183356-ohg3tty","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治下痢，破血，去积气，消积聚，痰涎，主肺热气促嗽逆，除腹中冷痛，主中恶及小儿惊痫。\""}]},{"ID":"20240612183356-n86g4rw","Type":"NodeParagraph","Properties":{"id":"20240612183356-n86g4rw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"下一切气，止霍乱转筋，心腹胀痛，补五劳，养气，除邪辟温，补虚消痰，破症瘕，养血排脓，补内漏及喉痹。\""}]},{"ID":"20240612183356-jtre6mq","Type":"NodeParagraph","Properties":{"id":"20240612183356-jtre6mq","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑤《本草衍义》：\"治肺痈。\""}]},{"ID":"20240612183356-jszqmx9","Type":"NodeParagraph","Properties":{"id":"20240612183356-jszqmx9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"疗咽喉痛，利肺气，治鼻塞。\""}]},{"ID":"20240612183356-jz9my4r","Type":"NodeParagraph","Properties":{"id":"20240612183356-jz9my4r","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑦李杲：\"利胸膈，（治）咽喉气壅及痛，破滞气及积块，（除）肺部风热，清利头目，利窍。\""}]},{"ID":"20240612183356-cbehxcw","Type":"NodeParagraph","Properties":{"id":"20240612183356-cbehxcw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"主口舌生疮，赤目肿痛。\""}]},{"ID":"20240612183356-kss7s2e","Type":"NodeParagraph","Properties":{"id":"20240612183356-kss7s2e","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑨《中药形性经验鉴别法》：\"催乳。\""}]},{"ID":"20240612183356-r8ae2gg","Type":"NodeParagraph","Properties":{"id":"20240612183356-r8ae2gg","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612183356-l0tts5b","Type":"NodeParagraph","Properties":{"id":"20240612183356-l0tts5b","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱；或入丸、散。"}]},{"ID":"20240612183356-ama66ih","Type":"NodeParagraph","Properties":{"id":"20240612183356-ama66ih","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612183356-e0km6ju","Type":"NodeParagraph","Properties":{"id":"20240612183356-e0km6ju","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" ①治肺痈，咳而胸满，振寒脉数，咽干不渴，时出浊唾腥臭，久久吐脓如米粥者：桔梗一两，甘草二两。上二味，以水三升，煮取一升，分温再服，则吐脓血也。（《金匮要略》桔梗汤）"}]},{"ID":"20240612183356-2ckcakm","Type":"NodeParagraph","Properties":{"id":"20240612183356-2ckcakm","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②治痰嗽喘急不定：桔梗一两半。捣罗为散，用童子小便半升，煎取四合，去滓温服。（《简要济众方》）"}]},{"ID":"20240612183356-znb06yt","Type":"NodeParagraph","Properties":{"id":"20240612183356-znb06yt","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"③治喉痹及毒气：桔梗二两。水三升，煮取一升，顿服之。（《千金方））"}]},{"ID":"20240612183356-b4jovmb","Type":"NodeParagraph","Properties":{"id":"20240612183356-b4jovmb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"④治寒实结胸，无热证者：桔梗三分，巴豆一分（去皮、心，熬黑，研如脂），贝母三分。上三味为散，以白饮和服，强人半钱匕，羸者减之。病在膈上必吐，在膈下必利，不利，进热粥一杯，利过不止，进冷粥一杯。（《伤寒论》白散）"}]},{"ID":"20240612183356-apaq17k","Type":"NodeParagraph","Properties":{"id":"20240612183356-apaq17k","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑤治伤寒痞气，胸满欲死：桔梗、枳壳（炙，去穰）各一两。上锉如米豆大，用水一升半，煎减半，去滓，分二服。（《苏沈良方》枳壳汤）"}]},{"ID":"20240612183356-09yazrb","Type":"NodeParagraph","Properties":{"id":"20240612183356-09yazrb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑥治牙疳臭烂：桔梗、茴香等分。烧研敷之。（《卫生易简方》）"}]},{"ID":"20240612183356-v00bdb9","Type":"NodeParagraph","Properties":{"id":"20240612183356-v00bdb9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑦胸满不痛。用桔梗、枳壳等分。煎水二杯，成一杯，温服。"}]},{"ID":"20240612183356-5n9rw1i","Type":"NodeParagraph","Properties":{"id":"20240612183356-5n9rw1i","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑧伤寒腹胀（阴阳不和）。用桔梗、半夏、陈皮各三钱，生姜五片，煎水二杯，成一杯服。此方名\"桔梗半夏汤\"。"}]},{"ID":"20240612183356-uu3jehy","Type":"NodeParagraph","Properties":{"id":"20240612183356-uu3jehy","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑨咽痛。先服甘草汤，如不愈，再服桔梗汤。"}]},{"ID":"20240612183356-nj31k5l","Type":"NodeParagraph","Properties":{"id":"20240612183356-nj31k5l","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑩口舌生疮。治法同上。"}]},{"ID":"20240612183356-bdo2kjb","Type":"NodeParagraph","Properties":{"id":"20240612183356-bdo2kjb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑾虫牙肿痛。用桔梗、薏苡，等分为末，内服。"}]},{"ID":"20240612183356-2fxutxr","Type":"NodeParagraph","Properties":{"id":"20240612183356-2fxutxr","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑿骨槽风（牙龈肿痛）。用桔梗研细，与枣肉调成丸子，如皂角子大。裹棉内，上下牙咬住。常用荆芥煎汤嗽口。"}]},{"ID":"20240612183356-kw45nf1","Type":"NodeParagraph","Properties":{"id":"20240612183356-kw45nf1","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⒀眼睛痛，眼发黑。用桔梗一斤、黑牵牛头三两，共研细，加蜜成丸，如梧子大。每服四十丸，温水送下。一天服二次。此方称\"桔梗丸\"。"}]},{"ID":"20240612183356-qehg9pf","Type":"NodeParagraph","Properties":{"id":"20240612183356-qehg9pf","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⒁鼻血不止。用桔梗研细，加水调匀。每服一茶匙，一天服四次。药中加生犀牛角屑亦可。"}]},{"ID":"20240612183356-vubi653","Type":"NodeParagraph","Properties":{"id":"20240612183356-vubi653","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⒂吐血下血。治法同上。"}]},{"ID":"20240612183356-mnrpen4","Type":"NodeParagraph","Properties":{"id":"20240612183356-mnrpen4","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⒃打伤瘀血。用桔梗末，每服少许，米汤送下。"}]},{"ID":"20240612183356-if9nxmu","Type":"NodeParagraph","Properties":{"id":"20240612183356-if9nxmu","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⒄中蛊下血（下血如鸡肝色，大量排出，病热很险）。用桔梗研细，每服一茶匙，酒送下。一天服三次。初时须强灌。约七天之后，血止。可吃猪肝汤补身体。药中也可加犀角，用量与桔梗等分。"}]},{"ID":"20240612183356-nbqsfqn","Type":"NodeParagraph","Properties":{"id":"20240612183356-nbqsfqn","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⒅怀孕中恶（心腹突然大痛）。用桔梗一两，锉细，加生姜三片。水一杯煎服。"}]},{"ID":"20240612183356-2k5ps10","Type":"NodeParagraph","Properties":{"id":"20240612183356-2k5ps10","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612183356-nlhgqp0","Type":"NodeParagraph","Properties":{"id":"20240612183356-nlhgqp0","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"朱肱《活人书》治胸中痞满不痛，用桔梗、积壳，取其通肺利膈下气也；张仲景《伤寒论》治寒实结胸，用桔梗、贝母、巴豆，取其温中、消谷、破积也；又治肺痈唾脓，用桔梗、甘草，取其苦辛清肺，甘温泻火，又能排脓血、补内漏也。其治少阴证二、三日咽痛，亦用桔梗。甘草，取其苦辛散寒，甘平除热，合而用之，能调寒热也。后人易名甘桔汤，通治咽喉口舌诸病。宋仁宗加荆芥、防风、连翘，遂名如圣汤，极言其验也。按王好古《医垒元戎》载之颇详，云失音加诃子，声不出加半夏，上气加陈皮，涎嗽加知母、贝母，咳渴加五味，酒毒加葛根，少气加人参，呕加半夏、生姜，唾脓血加紫菀，肺痿加阿胶，胸膈不利加枳壳，心胸痞满加枳实，目赤加栀子、大黄，面肿加茯苓，肤痛加黄耆，发斑加防风、荆芥，疫毒加鼠粘子、大黄，不得眠加栀子。\""}]},{"ID":"20240612183356-el6fy45","Type":"NodeParagraph","Properties":{"id":"20240612183356-el6fy45","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"②《本草经疏）：\"桔梗，观其所主诸病，应是辛苦甘平，微温无毒。伤寒邪结胸胁，则痛如刀刺；邪在中焦，则腹满及肠鸣幽幽，辛散升发，苦泄甘和，则邪解而气和，诸证自退矣。其主惊恐悸气者，心脾气血不足，则现此证，诸补心药中，借其升上之力，以为舟楫胜载之用，此佐使之职也。《别录》利五脏肠胃，补血气者，盖指邪解则脏腑肠胃自和，和则血气自生也。除寒热风痹、温中、疗喉咽痛、下蛊毒者，皆散邪解毒通利之功也。消谷者，以其升载阳气，使居中焦而不下陷，则脾中阳气长浮，而谷食自消矣。甄权用以治下痢，及去肺热气促者，升散热邪之故也。日华子用以除邪辟瘟，肺痈排脓；洁古用以利窍除肺部风热，清利头目，咽嗌胸膈滞气及痛，除鼻塞者，入肺开发和解之功也。\""}]},{"ID":"20240612183356-34fedzy","Type":"NodeParagraph","Properties":{"id":"20240612183356-34fedzy","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"桔梗之用，惟其上入肺经，肺为主气之脏，故能使诸气下降，世俗泥为上升之剂不能下行，失其用矣。\""}]},{"ID":"20240612183356-cekhjqc","Type":"NodeParagraph","Properties":{"id":"20240612183356-cekhjqc","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"④《本草崇原》：\"桔梗，治少阳之胁痛，上焦之胸痹，中焦之肠鸣，下焦之腹满。又惊则气上，恐则气下，悸则动中，是桔梗为气分之药，上中下皆可治也。\""}]},{"ID":"20240612183356-tfpnft9","Type":"NodeParagraph","Properties":{"id":"20240612183356-tfpnft9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑤《本草求真》：\"桔梗，按书既载能引诸药上行，又载能以下气，其义何居?盖缘人之脏腑胸膈，本贵通利，一有寒邪阻塞，则气血不通，其在于肺，则或为不利，而见痰壅喘促鼻塞；其在阳明，则或风热相搏，而见齿痛；其在少阴，则因寒闭火郁，而见目赤喉痹咽痛；久而火郁于肺，则见口疮肺痈干咳；火郁上焦，则见胸膈刺痛；肺火移郁大肠，则见下痢腹痛，腹满肠鸣。总皆寒郁于肺，闭其窍道，则清不得上行，浊因不得下降耳。桔梗系开提肺气之药，可为诸药舟楫，载之上浮，能引苦泄峻下之剂，至于至高之分成功，俾清气既得上升，则浊气自克下降，降气之说理根于是。\""}]},{"ID":"20240612183356-b945hcw","Type":"NodeParagraph","Properties":{"id":"20240612183356-b945hcw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑥《药征》：\"桔梗，主治浊唾肿脓也，旁治咽喉痛。…仲景曰：咽痛者，可与甘草汤，不瘥者，与桔梗汤也。是乃甘草者，缓其毒之急迫也，而浊唾吐脓，非甘草之所主，故其不瘥者，乃加桔梗也。由是观之，肿痛急迫则桔梗汤，浊唾吐脓多则排脓汤。\""}]},{"ID":"20240612183356-rx91jlz","Type":"NodeParagraph","Properties":{"id":"20240612183356-rx91jlz","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"⑦《重庆堂随笔》：\"桔梗，开肺气之结，宣心气之郁，上焦药也。肺气开则府气通，故亦治腹痛下利，昔人谓其升中有降者是矣。然毕竟升药，病属上焦实证而下焦无病者，固可用也；若下焦阴虚而浮火易动者，即当慎之。其病虽见于上焦，而来源于下焦者，尤为禁剂。昔人舟楫之说，最易误人。夫气味轻清之药，皆治上焦，载以舟楫，已觉多事。质重味厚之药，皆治下焦，载以上行，更属无谓。故不但下焦病不可用，即上焦病，亦惟邪痹于肺、气郁于心，结在阳分者，始可用之。如咽喉痰嗽等证，惟风寒外闭者宜之。不但阴虚内伤为禁药，即火毒上升之宜清降者，亦不可用也。\""}]},{"ID":"20240612183356-4ytm04s","Type":"NodeParagraph","Properties":{"id":"20240612183356-4ytm04s","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612183356-oqnebt2","Type":"NodeParagraph","Properties":{"id":"20240612183356-oqnebt2","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612183356-j94l2qx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612183356-j94l2qx","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"《中华本草》：桔梗"}]},{"ID":"20240612183356-3d3bxvb","Type":"NodeParagraph","Properties":{"id":"20240612183356-3d3bxvb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612183356-r8449se","Type":"NodeParagraph","Properties":{"id":"20240612183356-r8449se","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" Jú Gěnɡ"}]},{"ID":"20240612183356-rvxclvh","Type":"NodeParagraph","Properties":{"id":"20240612183356-rvxclvh","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612183356-u9hz8t3","Type":"NodeParagraph","Properties":{"id":"20240612183356-u9hz8t3","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 符蔰、白药、利如、梗草、卢茹、房图、荠世纪、苦梗、苦桔梗、大药、苦菜根"}]},{"ID":"20240612183356-4oee9tx","Type":"NodeParagraph","Properties":{"id":"20240612183356-4oee9tx","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612183356-6bvm15g","Type":"NodeParagraph","Properties":{"id":"20240612183356-6bvm15g","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" Platycodon Root"}]},{"ID":"20240612183356-sq9zv7p","Type":"NodeParagraph","Properties":{"id":"20240612183356-sq9zv7p","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612183356-rzajc1j","Type":"NodeParagraph","Properties":{"id":"20240612183356-rzajc1j","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612183356-ht5jp25","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612183356-ht5jp25","updated":"20240612183356"},"Children":[{"ID":"20240612183356-audahmd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612183356-audahmd","updated":"20240612183356"},"Children":[{"ID":"20240612183356-tp2fgzq","Type":"NodeParagraph","Properties":{"id":"20240612183356-tp2fgzq","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"陶弘景：桔梗，近道处处有。叶名隐忍，二、三月生，可煮食之。俗方用此，乃名荠苨。今别有荠苨，能解药毒，所谓乱人参者便是，非此桔梗，而叶甚相似，但荠苨叶下光明滑泽无毛为异，叶生又不如人参相对者尔。"}]}]}]},{"ID":"20240612183356-flqhg8m","Type":"NodeParagraph","Properties":{"id":"20240612183356-flqhg8m","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：人参苗似五加阔短，茎圆，有三、四桠，桠头有五叶。陶引荠苨乱人参，谬矣。且荠苨、桔梗，又有叶差互者，亦有叶三、四对者，皆一茎直上，叶既相乱，惟以根有心无"}]},{"ID":"20240612183356-klypmb3","Type":"NodeParagraph","Properties":{"id":"20240612183356-klypmb3","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612183356-h7khyk2","Type":"NodeParagraph","Properties":{"id":"20240612183356-h7khyk2","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 药材基源：为桔梗科植物桔梗的根。"}]},{"ID":"20240612183356-nmm8cyd","Type":"NodeParagraph","Properties":{"id":"20240612183356-nmm8cyd","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Platycodon grandiflorus (Jacq.)A. DC. [Campanula grandiflora Jacq.]"}]},{"ID":"20240612183356-g3esfzo","Type":"NodeParagraph","Properties":{"id":"20240612183356-g3esfzo","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"采收和储藏：播种两年或栽培当年秋季采挖，割去茎叶，挖出全根，洗净泥土，乘鲜用碗片或重型片刮去外皮，放清水中浸2-3h，挥起，晒干；或去芦切片，晒干。"}]},{"ID":"20240612183356-cisd7lq","Type":"NodeParagraph","Properties":{"id":"20240612183356-cisd7lq","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612183356-s4g48yg","Type":"NodeParagraph","Properties":{"id":"20240612183356-s4g48yg","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山地草坡、林缘或有栽培。"}]},{"ID":"20240612183356-lmwjpej","Type":"NodeParagraph","Properties":{"id":"20240612183356-lmwjpej","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国各地区。"}]},{"ID":"20240612183356-qimlei5","Type":"NodeParagraph","Properties":{"id":"20240612183356-qimlei5","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612183356-w2dlx6x","Type":"NodeParagraph","Properties":{"id":"20240612183356-w2dlx6x","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 桔梗 多年生草本，高30-120cm。全株有白色乳汁。主根长纺锤形，少分枝。茎无毛，通常不分枝或上部稍分枝。叶3-4片轮生、对生或互生；无柄或有极短的柄；叶片卵形至披针形，长2-7cm，宽0.5-3cm，先端尖，基部楔形，边缘有尖锯齿，下面被白粉。花1朵至数朵单生茎顶或集成疏总状花序；花萼钟状，裂片5；花冠阔钟状，直径4-6cm，蓝色或蓝紫色，裂片5，三角形；雄蕊5，花丝基部变宽，密被细毛；子房下位，花柱5裂。蒴果倒卵圆形，熟时顶部5瓣裂。种子多数，褐色。花期7-9月，果期8-10月。"}]},{"ID":"20240612183356-nsw8ybi","Type":"NodeParagraph","Properties":{"id":"20240612183356-nsw8ybi","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612183356-guzlato","Type":"NodeParagraph","Properties":{"id":"20240612183356-guzlato","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽气候，耐寒、喜阳光。宜栽培在海拔1100m以下的丘陵地带，半服半阳的砂质壤土中，以富含磷钾肥的中性夹沙土生长较好，种子寿命为1年，在低温下贮藏，能延长种子寿命。0-4℃干贮种子18个月，其发芽率比常温贮藏提高3.5-4倍。种子发芽率70%，在温度18-25℃，有足够温度，播种后15d出苗。"}]},{"ID":"20240612183356-ka0gui7","Type":"NodeParagraph","Properties":{"id":"20240612183356-ka0gui7","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖，分直播法和育苗移栽法。直播法，播前用温水浸种24h，或用0.3%高锰酸钾浸种12h。春播和秋播均可，以秋播为好。条播，行距20-25cm，深3-5cm，播后盖火灰，稍镇压浇水。约2星期出苗。待苗高5cm左右，结合松土，可间去过密或纤弱的幼苗，苗高10-15cm，按10cm株距定苗。育苗法，在较干旱地区，没有灌溉条件时采用。作150cm宽的畦，条播，行距5-10cm，覆土1-1.5cm，保持土壤湿润。约2星期左右出苗。苗齐后拔除过密的幼苗，并松土除草，至翌年4月即可移栽大田。"}]},{"ID":"20240612183356-8ir594l","Type":"NodeParagraph","Properties":{"id":"20240612183356-8ir594l","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"田间管理 移栽后1个有左右，苗出土5-10cm时，结合中耕除草追肥1次，每1hm2施清淡人畜粪水15000kg。6-7月开花前，每1hm2施过磷酸钙150-225kg，赤可再追施人畜粪液1次。冬季植析枯萎后，重施冬肥，以人畜粪和杂肥为主。由于桔梗花期较长，花朵的生长发育消耗大量营养，故摘除花果，减少对养分的消耗，可以提高根的产量。在盛花期喷1×10-3乙烯利1次，基本上达到除花目的。抽茎现蕾后要培土壅根，以防倒伏。"}]},{"ID":"20240612183356-o3xhh8l","Type":"NodeParagraph","Properties":{"id":"20240612183356-o3xhh8l","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"病虫防治 病害有轮纹病及斑枯病为害叶生。发病初期喷1：1：100波尔多液或50%多菌灵1000倍液。根腐病，可在发病初期拔除病株，还可用退菌特50%可湿性粉剂500倍液灌注。虫害有拟地甲，为害桔梗根部，可用90%敌百虫800倍液或50%锌硫磷1000倍液喷杀。还有红蜘蛛、地老虎、蚜虫、食子虫为害。"}]},{"ID":"20240612183356-9uef6j4","Type":"NodeParagraph","Properties":{"id":"20240612183356-9uef6j4","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612183356-p71uch4","Type":"NodeParagraph","Properties":{"id":"20240612183356-p71uch4","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根圆柱形或纺锤形，下部渐细，有的分枝，长6-20cm，直径1-2cm。表面淡黄白色，微有光泽，皱缩，有扭曲的纵沟，并有横向皮孔玟痕及支根痕，有时可见未刮净的黄棕色或灰棕色栓皮；上端根茎（芦头）长0.5-4cm，直径约1cm，具半月形的茎痕，呈盘节状。质硬脆，易折断，折断面略不平坦，可见放射状裂隙，皮部类白色，形成层环棕色，木部淡黄色。气微，味微甜、苦。"}]},{"ID":"20240612183356-mb5ow22","Type":"NodeParagraph","Properties":{"id":"20240612183356-mb5ow22","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"以根肥大、白色、质充实、味苦者为佳。"}]},{"ID":"20240612183356-1c4jrst","Type":"NodeParagraph","Properties":{"id":"20240612183356-1c4jrst","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：木栓层有时残存；木枪细胞偶含草酸钙小方晶。皮层窗。韧皮部宽广，外侧有时有裂隙；外侧韧皮射线渐弯曲；筛管群与乳管群伴生，作径向散列，乳管壁略厚，内含黄棕色颗粒状物。形成层成环。木质部导管单个散在或数个相聚，施射状排列；木射线较宽。本品薄壁细胞含菊糖。"}]},{"ID":"20240612183356-s0def5z","Type":"NodeParagraph","Properties":{"id":"20240612183356-s0def5z","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"粉末特征：米黄色。①菊糖众多，用冷水合氯醛液装置，薄壁细胞中的菊糖团块呈扇形。②乳汁管为有节联结乳汁管，直径14-25μm，内含浅黄色油滴及颗粒状物。③梯纹、网纹及具缘纹孔导管直径16-72μm。④木薄壁细胞纵面观长方形，末端壁微波状弯曲。未去净外皮的可见木栓细胞，淡棕色，有的含细小草酸钙结晶。"}]},{"ID":"20240612183356-gnwq3xe","Type":"NodeParagraph","Properties":{"id":"20240612183356-gnwq3xe","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612183356-cmlftra","Type":"NodeParagraph","Properties":{"id":"20240612183356-cmlftra","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 桔梗皂甙有溶血作用，不能用于注射，口服后在消化道水解破坏，即无溶血作用。给小鼠皮下注射，最小致死量为770mg/kg。"}]},{"ID":"20240612183356-x2d3t1r","Type":"NodeParagraph","Properties":{"id":"20240612183356-x2d3t1r","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"小鼠灌胃桔梗煎剂的半数致死量为24g/kg，兔灌胃本品煎剂40/kg，于24小时内5兔全部死亡，剂量为20/kg时，则全部存活，桔梗皂甙有很强的溶血作用，其溶血指数与来源产地和生长年限、采集时间、加工方法等而异，从1：100 到 1 ：1000 不等，韧皮部的溶血作用为本质部的 4.4-6.5倍，不去皮的桔梗溶血作用略大于去皮桔梗。因此桔梗不可注射给药。小鼠皮下注射的最小致死量为770mg/kg。粗桔梗皂甙灌胃小鼠和大鼠的半数致死量分别为420mg/kg和人于800mg/kg，皮下注射分别为22.3mg/kg和14.1mg/kg。灌胃大剂量桔梗皂甙，可反射性兴奋呕吐中枢，可引起恶心、呕吐。"}]},{"ID":"20240612183356-pmyguzw","Type":"NodeParagraph","Properties":{"id":"20240612183356-pmyguzw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612183356-6pb7ymz","Type":"NodeParagraph","Properties":{"id":"20240612183356-6pb7ymz","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 根含多种皂甙，迄今已分得18种三萜皂甙，它们是；桔梗皂甙（platycodin）A、C、D[1]、D2、D3，去芹菜糖基桔梗皂甙（deapioplatycodin）D、D3、，2-O-=乙酰基桔梗皂甙（2-O-acetylplatycodin）D2，3-O-乙酰基桔梗皂甙（3-O-acetylplaty-codin）D2，远志皂甙（polyglalacin）D、D2，2-O-乙酰基远志皂甙（2-O-acetylpolygalacin）D、D2，3-O-乙酰基远志皂甙（3-O-acetylpolygalacin）D、D2，桔梗甙酸-A甲酯（methyl platyconate-A），2-O-甲基桔梗甙酸-A甲酯（methyl-2-O-methyplatyconate-A），桔梗甙酸-A内酯（platyconic acid-A lactone）[2]，其中主成分是桔梗皂甙D，桔梗皂甙A又叫做2-O-乙酰基桔梗皂甙D，桔梗皂甙C又叫做3-O-乙酰基桔梗皂甙D。多种混合皂甙经完全水解所产生的皂甙元有：桔梗皂甙元（platycodigenin）[3]，远志酸（polygalacic acid）[4]，以及少量的桔梗酸（platycodigenin）[3]，远志酸（polygalacic acid）[4]，以及少量的桔梗酸（platycogenic acid）A、B、C[5]；如混合皂甙进行部分水解，则得到8种次皂甙（pros-aponin），它们在分离过程中是以甲酯形或分得的：3-O-β-D-吡喃葡萄糖基远志酸甲酯（methyl 3-O-β-D-glucpyranosyl polygala-cate，3-O-β-昆布二糖基远志酸甲酯（methyl 3-O-β-laminaribiosyl polygalacate），3-O-β-D-吡喃葡萄糖基桔梗皂甙元甲酯（3-O-β-D=glucopyranosyl platycodigenin methyl ester）3-O-β-龙胆二糖基桔梗皂甙元甲酯（3-O-β-gluctinobiosylplatycodi-genin methyl ester），3-O-β-D-吡喃葡萄糖基桔梗酸A内酯甲酯（3-O-β-D-glucopyranosyl platycogenin A lactone methyl ester）,3-O-β-D-吡喃葡萄糖基桔梗酸A二甲酯（dimethyl 3-O-β-D-glu-copyranosyl platycogenate A）,2-O-甲基-3-O-β-D-吡喃葡萄糖基桔梗酸A 二甲酯（dimethyl 2-O-methyl-3-O-methyl-3-O-D-glucopyranosyl platycogenate A）[6].根还含白桦脂醇（betulin）,α-菠菜菜甾醇（α-spinasterol），α-菠菜甾醇-β-D-葡萄糖甙（α-spinasteryl-β-D-gluco-side）[2]。"}]},{"ID":"20240612183356-6q87bp9","Type":"NodeParagraph","Properties":{"id":"20240612183356-6q87bp9","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612183356-c633h5d","Type":"NodeParagraph","Properties":{"id":"20240612183356-c633h5d","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 1.祛痰与镇咳作用：麻醉犬口服本品煎剂1g/kg，能显着增加呼吸道粘液的分泌量，其强度可与氯化铵相比。对麻醉猫亦有明显的祛痰作用。有报道桔梗皂甙的祛痰作用强于远志，次于美远志（Poygala senegaL.）。而小鼠酚红法试验结果则弱于远志。桔梗所含皂甙口服时对咽喉粘膜及胃粘膜造成某种程度的刺激，反射地引起呼吸道粘膜分泌亢进，使痰液稀释，促使其排出，粗制桔梗皂甙有镇咳作用。豚鼠腹腔注射和镇咳半数有效量为6.4mg/kg。"}]},{"ID":"20240612183356-q1jusx3","Type":"NodeParagraph","Properties":{"id":"20240612183356-q1jusx3","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"2.降血糖作用：兔灌胃桔梗水或醇提取物200mg/kg可使血糖下降，水提取物的降血糖曲线与灌胃 25-50mg/kg甲磺丁脲相似。水和醇提取物500mg/kg连续4天灌胃，对实验性四氧嘧啶糖尿病兔亦有降血糖作用，降低的肝糖原在用药后也见恢复，且能抑制食物性血糖上升，醇提取物的作用较水提取物强。"}]},{"ID":"20240612183356-cl50wr1","Type":"NodeParagraph","Properties":{"id":"20240612183356-cl50wr1","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"3.抑制胃液分泌和抗溃疡作用：粗制桔梗皂甙在低于1/5半数致死量的剂量时有抑制大鼠胃液分泌和抗消化性溃疡作用。100mg/kg剂量时，几乎能完全抑制大鼠幽门结扎所致的胃液分泌。大鼠十二指肠注入25mg/kg粗制桔梗皂甙，可防止消化性溃疡形成，其作用与皮下注射l0mg/kg阿托品相当，但100mg/kg 灌胃 对应激性溃疡形成的预防作用比皮下注射阿托品10mg/kg弱两倍，对大鼠醋酸所致的溃疡模型，粗制桔梗皂甙可使溃疡系数明显减少，且每日25mg/kg组的疗效比甘草提取物FM100每日200mg/kg组为高。"}]},{"ID":"20240612183356-i8u834i","Type":"NodeParagraph","Properties":{"id":"20240612183356-i8u834i","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"4.抗炎作用：粗桔梗皂甙有抗炎作用，灌服1/10-1/5半数致死量 的剂量对大鼠后肢角叉菜胶性脚肿与醋酸性肿胀均有抗炎效果。灌胃小于1/10半数致死量 的剂量，每日1次，连续给药，对大鼠棉球肉芽肿也有显着抑制作用，且对大鼠佐剂性关节炎也有效。此种制剂还能降低过敏反应，小鼠的毛细血管通透性。腹腔注射桔梗皂甙引起的小鼠扭体反应与腹腔渗出，灌胃同一皂甙可产生抑制。桔梗无直接抗菌作用，但其水提取物可增强巨噬细胞吞噬功能，增强中性白细胞的杀菌力。提高溶菌酶的活性。"}]},{"ID":"20240612183356-1qd6rud","Type":"NodeParagraph","Properties":{"id":"20240612183356-1qd6rud","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"5.对循环系统的作用：大鼠以粗制桔梗皂甙静脉注射，可见暂时性血压下降，心率减慢和呼吸抑制。对离体豚鼠心耳，高浓度时呈负性肌力作用。麻醉犬动脉注入200-800mg/kg粗桔梗皂甙，能降低冠状动脉和尼肢血管的阻力，增加血流量，其强度可与罂粟碱相比。当4mg/kg静脉注射 时也可增加冠状动脉和后肢血流量，并伴有暂时性低血压。据认为这种血管扩张是对外周血管的直接作用。"}]},{"ID":"20240612183356-0yeqozt","Type":"NodeParagraph","Properties":{"id":"20240612183356-0yeqozt","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"6.其它作用：粗桔梗皂甙有镇静、镇痛和解热作用。能抑制小鼠自发性活动，延长环己巴比妥钠的睡眠时间。但对电击和戊四氮惊厥无保护作用。桔梗皂甙可降低大鼠肝内胆固醇的含量，增加胆固醇和胆酸的排泄，还有抗乙酰胆碱和抗组胺作用，能抑制乙酰胆碱与组胺引起的离体豚鼠回肠收缩。大鼠灌胃桔梗2g/kg，对双侧颈静脉结扎造成的充血性水肿有抑制和利尿作用。体外试验表明，本品煎剂1：10对絮状表皮癣菌有抑制作用，本品所含的桦木醇400mg/kg时对大鼠瓦克Z56肌注肿瘤系统（SWA16）有边缘抗肿瘤活性。"}]},{"ID":"20240612183356-l3lewcl","Type":"NodeParagraph","Properties":{"id":"20240612183356-l3lewcl","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612183356-1r9gl81","Type":"NodeParagraph","Properties":{"id":"20240612183356-1r9gl81","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去芦头，洗净捞出，润透后切片，晒干。"}]},{"ID":"20240612183356-gx42k7x","Type":"NodeParagraph","Properties":{"id":"20240612183356-gx42k7x","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使桔梗，去头上尖硬二三分巳来，并两畔附枝子，细锉，用百合水浸一伏时。漉出，缓火熬令干用。每修事四两，用生百合五分，捣作膏投于水中浸。"}]},{"ID":"20240612183356-comuufl","Type":"NodeParagraph","Properties":{"id":"20240612183356-comuufl","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：桔梗，今但刮去浮皮。米泔水浸一夜，切片微炒用。"}]},{"ID":"20240612183356-v2b4tz8","Type":"NodeParagraph","Properties":{"id":"20240612183356-v2b4tz8","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612183356-rna8jhs","Type":"NodeParagraph","Properties":{"id":"20240612183356-rna8jhs","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 粉末或切片遇α-萘酚浓醇试液显紫堇色。"}]},{"ID":"20240612183356-gzmykdp","Type":"NodeParagraph","Properties":{"id":"20240612183356-gzmykdp","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612183356-b70fix5","Type":"NodeParagraph","Properties":{"id":"20240612183356-b70fix5","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 归肺；胃经"}]},{"ID":"20240612183356-1pbh2l2","Type":"NodeParagraph","Properties":{"id":"20240612183356-1pbh2l2","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612183356-7owketr","Type":"NodeParagraph","Properties":{"id":"20240612183356-7owketr","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性平"}]},{"ID":"20240612183356-mea3t0e","Type":"NodeParagraph","Properties":{"id":"20240612183356-mea3t0e","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612183356-1q1u1p6","Type":"NodeParagraph","Properties":{"id":"20240612183356-1q1u1p6","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 阴虚久嗽、气逆及咳血者忌服。"}]},{"ID":"20240612183356-uwalr35","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612183356-uwalr35","updated":"20240612183356"},"Children":[{"ID":"20240612183356-0hw6xkv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612183356-0hw6xkv","updated":"20240612183356"},"Children":[{"ID":"20240612183356-so9rfa6","Type":"NodeParagraph","Properties":{"id":"20240612183356-so9rfa6","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"宋震亨：下虚及怒气上升者不宜。"}]}]}]},{"ID":"20240612183356-lleequw","Type":"NodeParagraph","Properties":{"id":"20240612183356-lleequw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：阴虚久嗽不宜用，以其通阳泄气也。"}]},{"ID":"20240612183356-7eiu1nw","Type":"NodeParagraph","Properties":{"id":"20240612183356-7eiu1nw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612183356-meauyfg","Type":"NodeParagraph","Properties":{"id":"20240612183356-meauyfg","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 宣肺；祛痰；利咽；排脓。主咳嗽痰多；咽喉肿痛；肺痈吐脓；胞满胁痛；痢疾腹痛；小便癃闭"}]},{"ID":"20240612183356-yvcjrgc","Type":"NodeParagraph","Properties":{"id":"20240612183356-yvcjrgc","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612183356-h0cpuay","Type":"NodeParagraph","Properties":{"id":"20240612183356-h0cpuay","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。外用：适量，烧灰研末敷。"}]},{"ID":"20240612183356-9omswim","Type":"NodeParagraph","Properties":{"id":"20240612183356-9omswim","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612183356-ofy2kv0","Type":"NodeParagraph","Properties":{"id":"20240612183356-ofy2kv0","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" ①治肺痈，咳而胸满，振寒脉数，咽干不渴，时出浊唾腥臭，久久吐脓如米粥者：桔梗一两，甘草二两。上二味，以水三升，煮取一升，分温再服，则吐脓血也。(《金匮要略》桔梗汤)②治痰嗽喘急不定：桔梗一两半。捣罗为散，用童子小便半升，煎取四合，去滓温服。(《简要济众方》)③治喉痹及毒气：桔梗二两。水三升，煮取一升，顿服之。(《千金方》)④治寒实结胸，无热证者：桔梗三分，巴豆一分(去皮、心，熬黑，研如脂)，贝母三分。上三味为散，以白饮和服，强人半钱匕，羸者减之。病在膈上必吐，在膈下必利，不利，进热粥一杯，利过不止，进冷粥一杯。(《伤寒论》白散)⑤治伤寒痞气，胸满欲死：桔梗、枳壳(炙，去穰)各一两。上锉如米豆大，用水一升半，煎减半，去滓，分二服。(《苏沈良方》枳壳汤)⑥治牙疳臭烂：桔梗、茴香等分。烧研敷之。(《卫生易简方》)"}]},{"ID":"20240612183356-dk3zjas","Type":"NodeParagraph","Properties":{"id":"20240612183356-dk3zjas","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612183356-gcywlvi","Type":"NodeParagraph","Properties":{"id":"20240612183356-gcywlvi","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：朱肱《活人书》治胸中痞满不痛，用桔梗、枳壳，取其通肺利膈下气也；张仲景《伤寒论》治寒实结胸，用桔梗、贝母、巴豆，取其温中、消谷、破积也；又治肺痈唾脓，用桔梗、甘草，取其苦辛清肺，甘温泻火，又能排脓血、补内漏也。其治少阴证二、三日咽痛，亦用桔梗、甘草，取其苦辛散寒，甘平除热，合而用之，能调寒热也。后人易名甘桔汤，通治咽喉口舌诸病。宋仁宗加荆芥、防风、连翘，遂名如圣汤，极言其验也。按王好古《医垒元戎》载之颇详，云失音加诃子，声不出加半夏，上气加陈皮，涎嗽加知母、贝母，咳渴加五味，酒毒加葛根，少气加人参，呕加半夏、生姜，唾脓血加紫菀，肺痿加阿胶，胸膈不利加枳壳，心胸痞满加枳实，目赤加栀子、大黄，面肿加茯苓，肤痛加黄耆，发斑加防风、荆芥，疫毒加鼠粘子、大黄，不得眠加栀子。"}]},{"ID":"20240612183356-444mli4","Type":"NodeParagraph","Properties":{"id":"20240612183356-444mli4","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：桔梗，观其所主诸病，应是辛苦甘平，微温无毒。伤寒邪结胸胁，则痛如刀刺；邪在中焦，则腹满及肠鸣幽幽，辛散升发，苦泄甘和，则邪解而气和，诸证自退矣。其主惊恐悸气者，心脾气血不足，则现此证，诸补心药中，借其升上之力，以为舟楫胜载之用，此佐使之职也。《别录》利五脏肠胃，补血气者，盖指邪解则脏腑肠胃自和，和则血气自生也。除寒热风痹、温中、疗喉咽痛、下蛊毒者，皆散邪解毒通利之功也、消谷者，以其升载阳气，使居中焦而不下陷，则脾中阳气长浮，而谷食自消矣。甄权用以治下痢，及去肺热气促者，升散热邪之故也。日华子用以除邪辟瘟，肺痈排脓；洁古用以利窍除肺部风热，清利头目，咽嗌胸膈滞气及痛，除鼻塞者，入肺开发和解之功也。"}]},{"ID":"20240612183356-f0ac1fb","Type":"NodeParagraph","Properties":{"id":"20240612183356-f0ac1fb","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"3.《本草通玄》：桔梗之用，惟其上入肺经，肺为主气之脏，故能使诸气下降，世俗泥为上升之剂不能下行，失其用矣。"}]},{"ID":"20240612183356-a3vfiaw","Type":"NodeParagraph","Properties":{"id":"20240612183356-a3vfiaw","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"4.《本草崇原》：桔梗，治少阳之胁痛，上焦之胸痹，中焦之肠鸣，下焦之腹满。又惊则气上，恐则气下，悸则动中，是桔梗为气分之药，上中下皆可治也。"}]},{"ID":"20240612183356-7s44gdk","Type":"NodeParagraph","Properties":{"id":"20240612183356-7s44gdk","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：桔梗，按书既载能引诸药上行，又载能以下气，其义何居? 盖缘人之脏腑胸膈，本贵通利，一有寒邪阻塞，则气血不通，其在于肺，则或为不利，而见痰壅喘促鼻塞；其在阳明，则或风热相搏，而见齿痛；其在少阴，则困寒闭火郁，而见目赤喉痹咽痛；久而火郁于肺，则见口疮肺痈干咳；火郁上焦，则见胸膈刺痛；肺火移郁大肠，则见下痢腹痛，腹满肠鸣。总皆寒郁于肺，闭其窍道，则清不得上行，浊因不得下降耳。桔梗系开提肺气之药，可为诸药舟楫，载之上浮，能引苦泄峻下之剂，至于至高之分成功，俾清气既得上升，则浊气自克下降，降气之说理根于是。"}]},{"ID":"20240612183356-kovd181","Type":"NodeParagraph","Properties":{"id":"20240612183356-kovd181","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"6.《药征》：桔梗，主治浊唾肿脓也，旁治咽喉痛。仲景曰：咽痛者，可与甘草汤，不瘥者，与桔梗汤也。是乃甘草者，缓其毒之急迫也，而浊唾吐脓，非甘草之所主，故其不瘥者，乃加桔梗也。由是观之，肿痛急迫则桔梗汤，浊唾吐脓多则排脓汤。"}]},{"ID":"20240612183356-miyl0ou","Type":"NodeParagraph","Properties":{"id":"20240612183356-miyl0ou","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"7.《重庆堂随笔》：桔梗，开肺气之结，宣心气之郁，上焦药也。肺气开则府气通，故亦治腹痛下利，昔人谓其升中有降者是矣。然毕竟升药，病属上焦实证而下焦无病者，固可用也；若下焦阴虚而浮火易动者，即当慎之。其病虽见于上焦，而来源于下焦者，尤为禁剂。昔人舟揖之说，最易误人。夫气味轻清之药，皆治上焦，载以舟楫，已觉多事。质重味厚之药，皆治下焦，载以上行，更属无谓。故不但下焦病不可用，即上焦病，亦惟邪痹于肺、气郁于心，结在阳分者，始可用之。如咽喉痰嗽等证，惟风寒外闭者宜之。不但阴虚内伤为禁药，即火毒上升之宜清降者，亦不可用也。"}]},{"ID":"20240612183356-4ocyzmc","Type":"NodeParagraph","Properties":{"id":"20240612183356-4ocyzmc","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"8.《本经》：主胸胁痛如刀刺，腹满，肠鸣幽幽，惊恐悸气。"}]},{"ID":"20240612183356-7bvrnbp","Type":"NodeParagraph","Properties":{"id":"20240612183356-7bvrnbp","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"9.《别录》：利五脏肠胃，补血气，除寒热、风痹，温中消谷，疗喉咽痛。"}]},{"ID":"20240612183356-n5g1sbk","Type":"NodeParagraph","Properties":{"id":"20240612183356-n5g1sbk","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"10．《药性论》：治下痢，破血，去积气，消积聚，痰涎，主肺热气促嗽逆，除腹中冷痛，主中恶及小儿惊癎。"}]},{"ID":"20240612183356-ljwjvir","Type":"NodeParagraph","Properties":{"id":"20240612183356-ljwjvir","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"11.《日华子本草》：下一切气，止霍乱转筋，心腹胀痛，补五劳，养气，除邪辟温，补虚消痰，被症瘕，养血排脓，补内漏及喉痹。"}]},{"ID":"20240612183356-94pzven","Type":"NodeParagraph","Properties":{"id":"20240612183356-94pzven","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"12.《本草衍义》：治肺痈。"}]},{"ID":"20240612183356-1x11ybu","Type":"NodeParagraph","Properties":{"id":"20240612183356-1x11ybu","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"13.《珍珠囊》：疗咽喉痛，利肺气，治鼻塞。"}]},{"ID":"20240612183356-k71vnbd","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612183356-k71vnbd","updated":"20240612183356"},"Children":[{"ID":"20240612183356-jqk983t","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTQu","Num":14},"Properties":{"id":"20240612183356-jqk983t","updated":"20240612183356"},"Children":[{"ID":"20240612183356-vezjzyd","Type":"NodeParagraph","Properties":{"id":"20240612183356-vezjzyd","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"李杲：利胸膈，(治)咽喉气壅及痛，破滞气及积块，(除)肺部风热，清利头目，利窍。"}]}]}]},{"ID":"20240612183356-7bxvfwi","Type":"NodeParagraph","Properties":{"id":"20240612183356-7bxvfwi","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"15.《纲目》：主口舌生疮，赤目肿痛。"}]},{"ID":"20240612183356-aln7qye","Type":"NodeParagraph","Properties":{"id":"20240612183356-aln7qye","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"16.《中药形性经验鉴别法》：催乳。"}]},{"ID":"20240612183356-1h7dwu0","Type":"NodeParagraph","Properties":{"id":"20240612183356-1h7dwu0","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612183356-v2gi8p5","Type":"NodeParagraph","Properties":{"id":"20240612183356-v2gi8p5","updated":"20240612183356"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612183358-jegns9d","Type":"NodeThematicBreak","Properties":{"id":"20240612183358-jegns9d"}},{"ID":"20240612183359-rm0pt83","Type":"NodeParagraph","Properties":{"id":"20240612183359-rm0pt83"}}]}