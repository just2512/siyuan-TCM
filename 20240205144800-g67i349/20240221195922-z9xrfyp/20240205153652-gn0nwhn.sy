n"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 412px;\" parent-style=\"width: 422px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 406px;","style":"width: 396px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 16-20240814161933-ebo6i0m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 396px;\" parent-style=\"width: 406px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 407px;","style":"width: 397px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 17-20240814162027-ri7yvlh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 397px;\" parent-style=\"width: 407px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814160810-gfoczgf","Type":"NodeParagraph","Properties":{"id":"20240814160810-gfoczgf","updated":"20240814162111"},"Children":[{"Type":"NodeText","Data":"​​"}]},{"ID":"20240705151004-izswbkq","Type":"NodeParagraph","Properties":{"id":"20240705151004-izswbkq"}},{"ID":"20240705151004-oput34f","Type":"NodeParagraph","Properties":{"id":"20240705151004-oput34f","updated":"20240705151007"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"土贝母"}]},{"ID":"20240705160808-5xfdxjf","Type":"NodeParagraph","Properties":{"id":"20240705160808-5xfdxjf","updated":"20240705160808"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产河南、河北、陕西、山西等地。\n【性状】\t干燥块茎呈不规则块状，多角或三棱形，高0.61.6cm，直径0.72cm。暗棕色至半透明的红棕色，表面凹凸不平，多裂纹，顶端常有一突起的芽状物。质坚硬，不易折断。断面角质，光亮而平滑微有焦糊气，味微咸而苦。"},{"Type":"NodeBr","Data":"br"},{"Type":"NodeText","Data":"【性味】\t味苦，微寒。\n【功效】\t散结，消肿，解毒。用于乳痈，瘰疬；乳腺炎，颈淋巴结结核，慢性淋巴结炎，肥厚性鼻炎。"}]},{"ID":"20240705160808-xawitvd","Type":"NodeParagraph","Properties":{"id":"20240705160808-xawitvd","updated":"20240705160808"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206092522-g6akojy.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705161018-1qrytk6","Type":"NodeParagraph","Properties":{"id":"20240705161018-1qrytk6","updated":"20240705161018"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土贝母15"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土贝母15-20240705161018-n5vtu8g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240705152035-f9veuuo","Type":"NodeParagraph","Properties":{"id":"20240705152035-f9veuuo","updated":"20240814164916"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 624px;","style":"width: 614px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土贝母7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土贝母7-20240705152137-u19f4cy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 614px;\" parent-style=\"width: 624px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 394px;","style":"width: 384px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705160630-e4dygak.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 384px;\" parent-style=\"width: 394px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705151244-qcvv4nz","Type":"NodeParagraph","Properties":{"id":"20240705151244-qcvv4nz","updated":"20240814160826"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土贝母3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土贝母3-20240705151540-3r9oycs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 316px;","style":"width: 306px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土贝母"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土贝母-20240705151244-wcner4o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 306px;\" parent-style=\"width: 316px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240814170329-g1h4nqm","Type":"NodeParagraph","Properties":{"id":"20240814170329-g1h4nqm","updated":"20240814170358"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 654px;","style":"width: 644px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (29)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 29-20240814170153-cm8bdl4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 644px;\" parent-style=\"width: 654px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-sty