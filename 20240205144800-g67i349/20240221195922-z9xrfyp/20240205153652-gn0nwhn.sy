pe":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土贝母8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土贝母8-20240705152226-532qpay.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 740px;\" parent-style=\"width: 750px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814164049-vpb4hnq","Type":"NodeParagraph","Properties":{"id":"20240814164049-vpb4hnq","updated":"20240814165045"},"Children":[{"Type":"NodeText","Data":"​​"}]},{"ID":"20240814165042-auqy5uz","Type":"NodeParagraph","Properties":{"id":"20240814165042-auqy5uz","updated":"20240814165042"}},{"ID":"20240814164049-81aahn5","Type":"NodeParagraph","Properties":{"id":"20240814164049-81aahn5","updated":"20240814164106"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"其他（轮生贝母、一叶贝母）"}]},{"ID":"20240814164050-n764ezw","Type":"NodeParagraph","Properties":{"id":"20240814164050-n764ezw","updated":"20240814164128"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 360px;","style":"width: 350px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 3-20240814160105-eraoe8n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 350px;\" parent-style=\"width: 360px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 842px;","style":"width: 832px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (23)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 23-20240814164128-xpg5wra.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 832px;\" parent-style=\"width: 842px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814171201-2mmm51l","Type":"NodeParagraph","Properties":{"id":"20240814171201-2mmm51l","updated":"20240814171213"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (31)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 31-20240814171030-10jizwb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 629px;","style":"width: 619px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 18-20240814162356-bwuak1w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 619px;\" parent-style=\"width: 629px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240814171212-eqg36yt","Type":"NodeParagraph","Properties":{"id":"20240814171212-eqg36yt","updated":"20240814171212"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 772px;","style":"width: 762px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 19-20240814162655-i34mp50.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 762px;\" parent-style=\"width: 772px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 425px;","style":"width: 415px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贝母 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贝母 20-20240814162840-smorpbv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611145014-23xjf9f","Type":"NodeThematicBreak","Properties":{"id":"20240611145014-23xjf9f"}},{"ID":"20240611145035-irv0ctn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145035-irv0ctn","updated":"20240611145039"},"Children":[{"Type":"NodeText","Data":"贝母《神农本草经》"}]},{"ID":"20240611145035-c5qx3uh","Type":"NodeParagraph","Properties":{"id":"20240611145035-c5qx3uh","updated":"20240611145035"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240611145035-lkuqk2m","Type":"NodeParagraph","Properties":{"id":"20240611145035-lkuqk2m","updated":"20240611145035"},"Children":[{"Type":"NodeText","Data":"主伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金创，风痉。一名空草。"}]},{"ID":"20240611145035-awci6ay","Type":"NodeParagraph","Properties":{"id":"20240611145035-awci6ay","updated":"20240611145035"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名药实，一名苦花，一名苦菜，一名商（莔字）草，一名勤母，生晋地，十月采根暴干。"}]},{"ID":"20240611145035-g904ev7","Type":"NodeParagraph","Properties":{"id":"20240611145035-g904ev7","updated":"20240611145035"},"Children":[{"Type":"NodeText","Data":"案《说文》云：莔，贝母也。《广雅》云：贝父，药实也。《尔雅》云：莔，贝母。郭璞云：根如小贝，圆而白华，叶似韭。《毛诗》云：言采其虻。《传》云：虻，贝母也。陆玑云：其叶如括楼而细小，其子在根下如芋子，正白，四方连累相着有分解也。"}]},{"ID":"20240611145051-oa16gjp","Type":"NodeThematicBreak","Properties":{"id":"20240611145051-oa16gjp"}},{"ID":"20240611145052-n3ddu55","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145052-n3ddu55","updated":"20240611145056"},"Children":[{"Type":"NodeText","Data":"贝母《新修本草》"}]},{"ID":"20240611145052-aoxe939","Type":"NodeParagraph","Properties":{"id":"20240611145052-aoxe939","updated":"20240611145052"},"Children":[{"Type":"NodeText","Data":"味辛、苦，平、微寒，无毒。主伤寒烦热，淋沥邪气，疝瘕，喉痹乳难，金疮风痉。疗腹中结实，心下满，洗洗恶风寒，目眩项直，咳嗽上气，止烦热渴，出汗，安五脏，利骨髓。一名苦花，一名苦菜，一名商草，一名勒母。生晋地。十月采根，曝干。"}]},{"ID":"20240611145052-h9ls53g","Type":"NodeParagraph","Properties":{"id":"20240611145052-h9ls53g","updated":"20240611145052"},"Children":[{"Type":"NodeText","Data":"浓朴、白薇为之使，恶桃花，畏秦艽、 石、莽草，反乌头。 今出近道，形似聚贝子，故〔谨案〕此叶似大蒜，四月蒜熟时采，良。若十月，苗枯根亦不佳者，最佳，江南诸州亦有。"}]},{"ID":"20240611145052-mzltd4i","Type":"NodeParagraph","Properties":{"id":"20240611145052-mzltd4i","updated":"20240611145052"},"Children":[{"Type":"NodeText","Data":"味甘、苦，不辛。按《尔雅》亦名 也。"}]},{"ID":"20240611145751-htw0kb3","Type":"NodeThematicBreak","Properties":{"id":"20240611145751-htw0kb3"}},{"ID":"20240611145752-n7wzr1m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145752-n7wzr1m","updated":"20240611145758"},"Children":[{"Type":"NodeText","Data":"贝母《本草乘雅半偈》"}]},{"ID":"20240611145752-bxmeson","Type":"NodeParagraph","Properties":{"id":"20240611145752-bxmeson","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240611145752-j10k3rs","Type":"NodeParagraph","Properties":{"id":"20240611145752-j10k3rs","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"阴阳左右，各十有二，两边分解者，各得其平，丹龙精仅独粒，则左难右难矣。"}]},{"ID":"20240611145752-zwmi4c6","Type":"NodeParagraph","Properties":{"id":"20240611145752-zwmi4c6","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"【气味】辛平，无毒。"}]},{"ID":"20240611145752-xxinnxc","Type":"NodeParagraph","Properties":{"id":"20240611145752-xxinnxc","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"【主治】主伤寒烦热，淋沥，邪气，疝瘕，喉痹，乳难，金疮，风痉。"}]},{"ID":"20240611145752-cm98yyx","Type":"NodeParagraph","Properties":{"id":"20240611145752-cm98yyx","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"【核】曰∶贝母，一名勤母、空草、苦菜、苦花。出晋地、润州者最佳。今河中、江陵、郢、寿、随、郑、蔡、滁诸州亦有之。二月生苗，叶随苗出，如荞麦状，茎叶并青。七月开花，碧绿色，形如百合，斜悬向下，上有红脉，若似人肺。八月采根，根有瓣子，黄白色，如聚贝子。一种叶如栝蒌而细小，子在根下，如芋子，正白色，连累相着而可分解。一种叶如韭而花色白，根子亦作两瓣也。修治，先于柳木灰中炮黄，擘去口中米许大心，再拌糯米同炒，俟米黄，去米用。勿用独粒，不作两瓣者，号丹龙精，误服令人筋脉永不收，唯黄精、小蓝汁服之可立解。浓朴、白薇为之使。恶桃花。畏秦艽、莽草、矾石。反乌头。"}]},{"ID":"20240611145752-iz3vh0g","Type":"NodeParagraph","Properties":{"id":"20240611145752-iz3vh0g","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"先人云∶形如聚贝，独贵其母，若用空解，肺肝可施。"}]},{"ID":"20240611145752-6e83se5","Type":"NodeParagraph","Properties":{"id":"20240611145752-6e83se5","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"【 】曰，虽有多种，但苗叶别异，萼悉上昂，花悉下垂，此开机互阖，阖机互开，少阳胆之枢药也。根形如贝，色白味辛，以金为用，肝之肺药，肺之肝药也。以太阴肺主开，厥阴肝主阖，靡不取决于少阳胆主枢者。如伤寒烦热，喉痹风痉，乃开机反阖，不能转开；"}]},{"ID":"20240611145752-16ebnju","Type":"NodeParagraph","Properties":{"id":"20240611145752-16ebnju","updated":"20240611145752"},"Children":[{"Type":"NodeText","Data":"如淋沥，乃开机反折，不能互阖；如乳难，乃不能为开；如金疮，乃不能为阖；如疝瘕，乃不能为开为阖也。贝母功力，能使阖者开，开者阖，阖折不能互开者，能使之互开；开折不能互阖者，能使之互阖；不能阖者，能顺其阖；不能开者，能顺其开；不能为开为阖者，能顺其为开为阖也。盖开与阖，莫不取决于枢，以为开阖故尔。"}]},{"ID":"20240611145752-nalo19p","Type":"NodeParagraph","Properties":{"id":"20240611145752-nalo19p","updated":"20240611145755"},"Children":[{"Type":"NodeText","Data":"（萼主垂而昂，花主昂而垂，此阴阳颠倒象，金木互交机也。其使之互交，令之颠倒者，谁..."}]},{"ID":"20240611145912-b7l2b97","Type":"NodeThematicBreak","Properties":{"id":"20240611145912-b7l2b97"}},{"ID":"20240611145913-cl6fay9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145913-cl6fay9","updated":"20240611145923"},"Children":[{"Type":"NodeText","Data":"贝母《本经逢原》"}]},{"ID":"20240611145913-ffzxpfu","Type":"NodeParagraph","Properties":{"id":"20240611145913-ffzxpfu","updated":"20240611145913"},"Children":[{"Type":"NodeText","Data":"甘苦平微寒，无毒。反乌头。川者味甘最佳，西者味薄次之，象山者微苦又次之，一种大而苦者，仅能解毒，并去心用。凡肺经药皆当去心，不独贝母也。其独颗无瓣者名丹龙睛，误服令人筋不收持。"}]},{"ID":"20240611145913-pmrl1mg","Type":"NodeParagraph","Properties":{"id":"20240611145913-pmrl1mg","updated":"20240611145913"},"Children":[{"Type":"NodeText","Data":"《本经》主伤寒烦热，淋沥邪风，疝瘕喉痹，乳难金疮，风痉。"}]},{"ID":"20240611145913-uatzc75","Type":"NodeParagraph","Properties":{"id":"20240611145913-uatzc75","updated":"20240611145913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"贝母乃手太阴肺经气分药，兼入手少阴心经。一名虻 风，言采其虻，善解心胸郁结之气，故诗人以此寓焉。肺受心包火乘，因而生痰；或为邪热所干，喘嗽烦闷，非此莫治。详《本经》主伤寒烦热者，甘寒能解烦热也。淋沥者，热结二肠也。清心肺郁热而淋沥通矣。疝瘕者，足厥阴之邪干手厥阴也。《经》曰∶诊得心脉搏滑急，为心疝，少腹当有形也。喉痹者，热郁结于上也。《经》云∶二阴一阳结，谓之喉痹，心主三焦之脉，皆络于喉也。乳难者，郁热结于手足厥阴也。风痉者，金疮热郁生风而成痉，总取解散郁结之邪也。仲景治伤寒寒实结胸，外无热证者，小陷胸汤主之，白散亦可。二方，一主热痰内结，一主寒实内结，虽同一例，治不可混也。俗以半夏性燥，用贝母代之，不知贝母寒润治肺家燥痰，痰因郁结者宜之。半夏性燥治脾胃湿痰，痰因湿滞者宜之。二者天渊，何可代用。若虚劳咳嗽，吐血咯血，肺痿肺痈，痈疽及诸郁火证，半夏乃禁忌，皆贝母为向导也。至于脾胃湿热，涎化为痰，久则生火，火痰上攻，昏愦僵仆，蹇涩诸证，生死旦夕，岂贝母可治乎。浙产者，治疝瘕，喉痹，乳难，金疮，风痉，一切痈疡。又同苦参、当归治妊娠小便难，同青黛治人面恶疮，同连翘治项上结核，皆取其开郁散结化痰解毒之功也。"}]},{"ID":"20240611145813-0m366iv","Type":"NodeThematicBreak","Properties":{"id":"20240611145813-0m366iv"}},{"ID":"20240611145816-c92r0jc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145816-c92r0jc","updated":"20240611145823"},"Children":[{"Type":"NodeText","Data":"贝母《长沙药解》"}]},{"ID":"20240611145816-ktiwath","Type":"NodeParagraph","Properties":{"id":"20240611145816-ktiwath","updated":"20240611145816"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛平。主伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金创，风痉。一名空草。"}]},{"ID":"20240611145816-vh5iwv3","Type":"NodeParagraph","Properties":{"id":"20240611145816-vh5iwv3","updated":"20240611145816"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，入手太阴肺经。清金泻热，消郁破凝。"}]},{"ID":"20240611145816-p3eyqi7","Type":"NodeParagraph","Properties":{"id":"20240611145816-p3eyqi7","updated":"20240611145816"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二白散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在桔梗。"},{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当归贝母苦参丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在当归。"},{"Type":"NodeText","Data":"并用之，以其清金而泻热也。"}]},{"ID":"20240611145816-jg7q4ue","Type":"NodeParagraph","Properties":{"id":"20240611145816-jg7q4ue","updated":"20240611145816"},"Children":[{"Type":"NodeText","Data":"贝母苦寒之性，泻热凉金，降浊消痰，其力非小，然轻清而不败胃气，甚可嘉焉。其诸主治，疗喉痹，治乳痈，消瘿瘤，去努肉，点翳障，敷疮痈，止吐衄，驱痰浊，润心肺，解燥渴，清烦热，下乳汁，除咳嗽，利水道。"}]},{"ID":"20240611150047-dv9qg9m","Type":"NodeThematicBreak","Properties":{"id":"20240611150047-dv9qg9m"}},{"ID":"20240611150049-5zdw0n2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150049-5zdw0n2","updated":"20240611150053"},"Children":[{"Type":"NodeText","Data":"贝母《本草经解》"}]},{"ID":"20240611150049-9kyzsfc","Type":"NodeParagraph","Properties":{"id":"20240611150049-9kyzsfc","updated":"20240611150049"},"Children":[{"Type":"NodeText","Data":"一名 ．读萌．诗采 ．取能散心胸郁结也．本草称治乳难．盖乳病多由郁结．故相宜．又唐时有病患面疮者．用贝母愈．正曼倩酒浇怪哉．取散郁蠲忿意也．苏子容谓类金疮．故宜贝母．岂其然乎．"}]},{"ID":"20240611150102-2jhhmdh","Type":"NodeThematicBreak","Properties":{"id":"20240611150102-2jhhmdh"}},{"ID":"20240611150103-vv9a7n3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150103-vv9a7n3","updated":"20240611150108"},"Children":[{"Type":"NodeText","Data":"川贝母《本草害利》"}]},{"ID":"20240611150103-1s80szc","Type":"NodeParagraph","Properties":{"id":"20240611150103-1s80szc","updated":"20240611150103"},"Children":[{"Type":"NodeText","Data":"〔害〕凡风寒湿滞诸痰并禁用贝母。故云能入肺治燥，非脾家所喜也。及食积痰火作嗽，湿痰在胃，恶心欲吐，痰饮作寒热，脾胃湿痰作眩晕，及痰厥头痛，中恶吐呕，胃寒作泄，法以辛温燥热之药，如南星、半夏、天麻、二术、茯苓之类治之者。"}]},{"ID":"20240611150103-m8ohjx0","Type":"NodeParagraph","Properties":{"id":"20240611150103-m8ohjx0","updated":"20240611150103"},"Children":[{"Type":"NodeText","Data":"〔利〕苦辛微寒，消痰润肺，涤热清心，故能解郁结，咳嗽，上气，吐血，咯血，肺痈，肺痿，喉痹。"}]},{"ID":"20240611150103-t01uf5l","Type":"NodeParagraph","Properties":{"id":"20240611150103-t01uf5l","updated":"20240611150103"},"Children":[{"Type":"NodeText","Data":"淅贝，一名象贝，体坚味苦，去时感风痰。"}]},{"ID":"20240611150103-v71bix4","Type":"NodeParagraph","Properties":{"id":"20240611150103-v71bix4","updated":"20240611150103"},"Children":[{"Type":"NodeText","Data":"川贝化虚痰，土贝形大味苦，治外科化痰毒。应用有别，俱去心。"}]},{"ID":"20240611150103-25ryfjk","Type":"NodeParagraph","Properties":{"id":"20240611150103-25ryfjk","updated":"20240611150103"},"Children":[{"Type":"NodeText","Data":"〔修治〕八月采根，根有瓣子黄白色，形如聚贝子，名曰贝母。曝干。先于柳木灰中炮黄，擘去内口鼻中有米许大者心一颗后，糯米拌炒，待米黄，去米用。"}]},{"ID":"20240611150032-c23xpi1","Type":"NodeThematicBreak","Properties":{"id":"20240611150032-c23xpi1"}},{"ID":"20240611150033-iedrdt7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150033-iedrdt7","updated":"20240611150039"},"Children":[{"Type":"NodeText","Data":"贝母《神农本草经赞》"}]},{"ID":"20240611150033-w90l37o","Type":"NodeParagraph","Properties":{"id":"20240611150033-w90l37o","updated":"20240611150033"},"Children":[{"Type":"NodeText","Data":"味辛平。主伤寒烦热。淋沥。邪气。疝瘕。喉痹。乳难。金创。风痉。一名空草。陟彼阿邱。物融心会。叶接苗生。根连蒂荟。采候熟葫。聚陈编贝。精结丹龙。筋摧脉害。"}]},{"ID":"20240611150033-g8cdukp","Type":"NodeParagraph","Properties":{"id":"20240611150033-g8cdukp","updated":"20240611150033"},"Children":[{"Type":"NodeText","Data":"诗。陟彼阿邱。诗注。采虻贝母也。主疗郁结之疾。江休复诗。心会境物融。苏颂曰。"}]},{"ID":"20240611150033-pvn881a","Type":"NodeParagraph","Properties":{"id":"20240611150033-pvn881a","updated":"20240611150033"},"Children":[{"Type":"NodeText","Data":"叶随苗出。诗疏。贝母子在根下。连累相着。苏恭曰。蒜熟时采之良。尔雅翼。大蒜为葫。陶弘景曰。形似聚贝子。雷论。贝母中有独颗者名丹龙精。误服令人筋脉不收。"}]},{"ID":"20240611150020-z0ehjct","Type":"NodeThematicBreak","Properties":{"id":"20240611150020-z0ehjct"}},{"ID":"20240611150021-yi3d9kg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150021-yi3d9kg","updated":"20240611150026"},"Children":[{"Type":"NodeText","Data":"贝母《汤液本草》"}]},{"ID":"20240611150021-tpqt8gp","Type":"NodeParagraph","Properties":{"id":"20240611150021-tpqt8gp","updated":"20240611150021"},"Children":[{"Type":"NodeText","Data":"气平，微寒，味辛、苦。无毒。"}]},{"ID":"20240611150021-2hv2w70","Type":"NodeParagraph","Properties":{"id":"20240611150021-2hv2w70","updated":"20240611150021"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主伤寒烦热，淋沥、邪气，疝瘕、喉痹，乳难，金疮，风痉。疗腹中结实，心下满，洗洗恶风寒，目眩项直，咳嗽上气。止烦渴，出汗，安五脏，利骨髓。"}]},{"ID":"20240611150021-hz7wj3s","Type":"NodeParagraph","Properties":{"id":"20240611150021-hz7wj3s","updated":"20240611150021"},"Children":[{"Type":"NodeText","Data":"仲景∶寒实结胸，外无热证者，三物小陷胸汤主之，白散亦可。以其内有贝母也。别说，贝母能散胸中郁结之气，殊有功。"}]},{"ID":"20240611150021-brvpht2","Type":"NodeParagraph","Properties":{"id":"20240611150021-brvpht2","updated":"20240611150021"},"Children":[{"Type":"NodeText","Data":"《本草》又云∶浓朴、白薇为之使，恶桃花，畏秦艽、 石、莽草，反乌头。"}]},{"ID":"20240611150021-ndeif0h","Type":"NodeParagraph","Properties":{"id":"20240611150021-ndeif0h","updated":"20240611150021"},"Children":[{"Type":"NodeText","Data":"海藏祖方，下乳三母散∶牡蛎、知母、贝母三物为细末，猪蹄汤调下。"}]},{"ID":"20240611145148-zyj5nt5","Type":"NodeThematicBreak","Properties":{"id":"20240611145148-zyj5nt5"}},{"ID":"20240611145149-og1yymr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145149-og1yymr","updated":"20240611145155"},"Children":[{"Type":"NodeText","Data":"贝母《神农本草经读》"}]},{"ID":"20240611145149-46jfhiw","Type":"NodeParagraph","Properties":{"id":"20240611145149-46jfhiw","updated":"20240611145149"},"Children":[{"Type":"NodeText","Data":"气味辛、平，无毒。主伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金疮，风痉。"}]},{"ID":"20240611145149-k0yyimr","Type":"NodeParagraph","Properties":{"id":"20240611145149-k0yyimr","updated":"20240611145149"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶贝母气平味辛，气味俱属于金，为手太阴、手阳明药也。其主伤寒烦热者，取西方之金气以除酷暑；《伤寒论》以白虎汤命名，亦此意也。其主淋沥邪气者，肺之治节行于膀胱，则邪热之气除，而淋沥愈矣。疝瘕为肝木受病，此则金平木也。喉痹为肺窍内闭，此能宣通肺气也。乳少为阳明之汁不通，金疮为阳明之经脉受伤，风痉为阳明之宗筋不利，贝母清润而除热，所以统治之。今人以主治痰嗽，大失经旨。"}]},{"ID":"20240611145149-ifsmrcj","Type":"NodeParagraph","Properties":{"id":"20240611145149-ifsmrcj","updated":"20240611145149"},"Children":[{"Type":"NodeText","Data":"且李士材谓∶贝母主燥痰，半夏主湿痰，二物如水炭之反，皆臆说也。"}]},{"ID":"20240611145221-j4e2pmr","Type":"NodeThematicBreak","Properties":{"id":"20240611145221-j4e2pmr"}},{"ID":"20240611145222-obapfv1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145222-obapfv1","updated":"20240611145232"},"Children":[{"Type":"NodeText","Data":"贝母《本草便读》"}]},{"ID":"20240611145222-wgbabb5","Type":"NodeParagraph","Properties":{"id":"20240611145222-wgbabb5","updated":"20240611145222"},"Children":[{"Type":"NodeText","Data":"甘寒润肺可消痰．当求川种．解郁宽胸且散结．言采其虻．象贝之功．治咳还能解表．浙中所种．疏痰并可消痈．为肺燥之神丹．清心涤热．乃脾湿之禁剂．微苦兼辛．（贝母川产野生者良．性味甘寒微苦．色白而润．专入心肺．善解胸中郁结之气．盖郁则生热．热则生痰．故贝母治火痰燥痰有功．亦郁解则热退．热退则痰除．而肺咳自宁耳．今浙中所种者．形亦相象而较大．味兼苦劣．用亦稍异耳．又贝母以其有解郁散结化痰除热之功．故一切外证疮疡用之而效者．亦此意也．所谓毒者．即火结气郁所致．火解气舒．又何毒之有哉．）"}]},{"ID":"20240611145211-e24vpi9","Type":"NodeThematicBreak","Properties":{"id":"20240611145211-e24vpi9"}},{"ID":"20240611145212-ckw8soc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145212-ckw8soc","updated":"20240611145216"},"Children":[{"Type":"NodeText","Data":"贝母《本草述钩元》"}]},{"ID":"20240611145212-zcyjtem","Type":"NodeParagraph","Properties":{"id":"20240611145212-zcyjtem","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"二月生苗。叶随苗出。七月开花碧绿。形如百合。斜悬向下。上有红脉似人肺。八月采根。根有瓣子黄白色。如聚贝子。一种子在根下。如芋子。正白色。连累相着而可分解。"}]},{"ID":"20240611145212-lrbx04c","Type":"NodeParagraph","Properties":{"id":"20240611145212-lrbx04c","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"气味苦平。微寒。阴中微阳。可升可降。阴也。入手太阴少阴。为肺经气分药。润肺清心。开郁结。和中气。除邪气烦热。心下实满。胸胁逆气。涤热消痰。疗喘嗽红痰。治产难及胞衣不下。下乳汁。凡疔肿瘤疡。可以托里护心。收敛解毒。（诸本草）方书治虚劳（消痰止嗽。和中气。安五脏。为怯证之要药。）疟喑鼻衄舌衄自汗小便不通淋鼻病舌病。肺有热因而生痰。或为热邪所干。喘嗽烦闷。必此主之。其性专能散结除热。（仲淳）能散心胸郁结之气。用治心中不快多愁郁者。殊有功。（承）俗以半夏有毒。用贝母代之。夫贝母乃太阴肺药。半夏乃太阴阳明脾胃药。如何可代。若虚劳咳嗽。吐血咯血。肺痿肺痈。妇人乳痈痈疽。及诸郁证。皆须贝母为向导。而忌半夏。至于脾胃湿热。涎化为痰。久则生火。"}]},{"ID":"20240611145212-jthtsui","Type":"NodeParagraph","Properties":{"id":"20240611145212-jthtsui","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"痰火上攻。昏愦僵仆蹇涩诸证。此非贝母可代。（石山）同参术用。行补不腻。与归芍用。"}]},{"ID":"20240611145212-to9p1cu","Type":"NodeParagraph","Properties":{"id":"20240611145212-to9p1cu","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"行气和荣。助知母疗肺疾而滋阴。得浓朴开脾郁而清气。合芩连能清火郁。偕黄柏可疗诸疮。"}]},{"ID":"20240611145212-u6dhtu9","Type":"NodeParagraph","Properties":{"id":"20240611145212-u6dhtu9","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"君元参立消喉痹。臣桔梗便治肺痈。同连翘主项下瘤瘿。和抚芎解遍身气痛。烧灰油调。敷恶疮人面。作末酒服。下难产胞衣。（能）孕妇咳嗽。贝母去心。麸炒黄为末。沙糖拌。丸芡子大。每含咽一丸。神效。小儿嗽。（百日内咳嗽痰壅）贝母五钱。生炙甘草各一钱。"}]},{"ID":"20240611145212-vsdxumi","Type":"NodeParagraph","Properties":{"id":"20240611145212-vsdxumi","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"为末。沙糖丸。芡子大。每米饮化下一丸。化痰降气。止咳解郁。消食除胀。用贝母去心一两。姜制浓朴五钱。蜜丸梧子大。每白汤下五十丸。有奇效。便痈肿痛。贝母白芷等分。为末。酒调。或酒煎服。以渣贴之。同知母前胡葛根麦冬甘草。治斑疹初发。壮热喘嗽。有痰不得眠。同知母天麦冬桑白皮枇杷叶百部桔梗甘草。治肺热咳嗽。及胸中烦热。同番降香郁金橘红远志苏梗苏子香附白豆蔻。开郁。痰加抚芎神曲。并解一切气郁。同橘皮前胡石膏知母麦冬竹沥。治痰疟。同大力子元参栝蒌根僵蚕桔梗甘草。治风痉。同甘菊紫地丁金银花夏枯草大力子生甘草白芨白蔹。治一切热毒。消一切痈疽。同郁金连翘橘叶栝蒌根大力子夏枯草山茨菇山豆根元参。消一切结核乳岩瘰。同百部百合薏仁麦冬苏子郁金童便竹沥鱼腥草。"}]},{"ID":"20240611145212-nxnqvs0","Type":"NodeParagraph","Properties":{"id":"20240611145212-nxnqvs0","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"治肺热吐脓血〔论〕贝母采根于八月。取其受金气之专。其味苦胜辛微。辛在苦后。且苦合于气之微寒以归辛。是二阴至肺之义也。夫苦合于气之微寒。为在地之阴。乃便能至于在天之阳以益肺者。观其叶随苗出。有直透而无濡留。则知功所独擅。即在直透以开热之结。无濡留以达肺之郁矣。（是以嗽疾主用独多）抑以在地之阴。和乎在天之阳。如阳中之太阳心也。肾脉之支者。更从肺而络之。则其由肺及心。无不和于阴而裕。从升得降之元机。又安有实满逆气之患哉。（方书治小水不通及淋证。即皆从升得降之故。）至以肺经气分药而能疗血证者。"}]},{"ID":"20240611145212-iefgi46","Type":"NodeParagraph","Properties":{"id":"20240611145212-iefgi46","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"盖主血虽属心。更藉肺阴下降入心而生之。又主下乳汁。（心与小肠。女子平居主月水。胎后主乳汁。）正见在地之阴。和于在天之阳。以为化育之一端也。"}]},{"ID":"20240611145212-hlfzst6","Type":"NodeParagraph","Properties":{"id":"20240611145212-hlfzst6","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"缪氏云。凡脾胃寒湿。生痰作嗽。及食积痰饮。中恶呕吐。胃寒作泄。法当以辛温燥热治之者。并禁。"}]},{"ID":"20240611145212-vk472u4","Type":"NodeParagraph","Properties":{"id":"20240611145212-vk472u4","updated":"20240611145212"},"Children":[{"Type":"NodeText","Data":"〔辨治〕川贝母小而尖白者良。浙贝母极大而圆色黄。不堪入药。姜汁泡。去心。其中有独颗而不团作两片无皱者。名丹龙精。损人筋脉。"}]},{"ID":"20240611145159-zoyacgb","Type":"NodeThematicBreak","Properties":{"id":"20240611145159-zoyacgb"}},{"ID":"20240611145200-eijs7jg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145200-eijs7jg","updated":"20240611145205"},"Children":[{"Type":"NodeText","Data":"贝母《本草求真》"}]},{"ID":"20240611145200-hk9tpog","Type":"NodeParagraph","Properties":{"id":"20240611145200-hk9tpog","updated":"20240611145200"},"Children":[{"Type":"NodeText","Data":"（山草）清肺心痰热"}]},{"ID":"20240611145200-y2mf6u1","Type":"NodeParagraph","Properties":{"id":"20240611145200-y2mf6u1","updated":"20240611145200"},"Children":[{"Type":"NodeText","Data":"贝母（专入肺。兼入心）。辛苦微寒。世多用为治痰之药。殊不知痰有因燥因湿之不同。（痰有风痰寒痰湿痰火痰燥痰虚痰热痰之别。须在临症细分。）如果肺因火刑。水饮不化。郁而为痰。此痰因于燥者也。脾胃虚寒。水饮停积。窒而不通。此痰因于湿者也。因以燥者。非用苦以泻火。辛以散郁。寒以折热莫治。因以湿者。非用辛以。湿以燥湿莫投。贝母味苦而辛。其性微寒。止于心肺燥郁。痰食壅盛。及虚劳烦热。肺痿肺痈。喉痹咯血吐血。（火刑于肺。）目眩淋沥。（火移小肠。）瘿瘤乳闭。难产恶疮不敛等症服之。卒能有效。（承曰。贝母能散心胸郁之气。故诗云言采其商是也。作诗者本以不得志而言。今用治心中不快。多愁郁者殊有功。）若使因于脾虚而见咳嗽不宁。混以贝母妄代。其失远矣！盖一宜半夏。一宜贝母。况半夏兼治脾肺。贝母独清肺金。半夏用其辛。贝母用其苦。半夏用其温。贝母用其凉。半夏性速。贝母性缓。半夏。贝母清热。气味阴阳。大有不同。（汪昂云。故凡风寒湿食诸痰。贝母非所宜也。）彼此误投。为害不浅。大者为土贝母。大苦大寒。（如浙江贝母之类。）清解之功居多。小者川贝母。味甘微寒。滋润胜于清解。不可不辨。川产开瓣者良。独瓣不堪入药。去心。米拌炒用。浓朴白薇为使。畏秦艽。反乌头。"}]},{"ID":"20240611145136-uha2nto","Type":"NodeThematicBreak","Properties":{"id":"20240611145136-uha2nto"}},{"ID":"20240611145139-krjhrw7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145139-krjhrw7","updated":"20240611145142"},"Children":[{"Type":"NodeText","Data":"贝母《本草纲目》"}]},{"ID":"20240611145139-4ek24hw","Type":"NodeParagraph","Properties":{"id":"20240611145139-4ek24hw","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"「释名」亦名苘、勤母、苦菜、苦花、空草、药实。"}]},{"ID":"20240611145139-nx27oql","Type":"NodeParagraph","Properties":{"id":"20240611145139-nx27oql","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、平、无毒。"}]},{"ID":"20240611145139-6iasf1d","Type":"NodeParagraph","Properties":{"id":"20240611145139-6iasf1d","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611145139-uqwi8hi","Type":"NodeParagraph","Properties":{"id":"20240611145139-uqwi8hi","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"1、胸膈郁积。用贝母（去心），加姜汁炒后研细，再和姜汁、面糊做成丸子。每服七十丸。"}]},{"ID":"20240611145139-6iu56vv","Type":"NodeParagraph","Properties":{"id":"20240611145139-6iu56vv","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"2、化痰降气，止咳解郁。用贝母（去心）一两、姜制厚朴半两，加蜜做成丸子，如梧子大。每服五十丸，开水送下。"}]},{"ID":"20240611145139-gz8j1b9","Type":"NodeParagraph","Properties":{"id":"20240611145139-gz8j1b9","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"3、小儿百日咳。用贝母五钱、甘草（半生半灸）二钱，共研为末，加沙糖调成丸子，如芡子大，每次以米汤化服一丸。"}]},{"ID":"20240611145139-wjh83un","Type":"NodeParagraph","Properties":{"id":"20240611145139-wjh83un","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"4、乳汁不下。用贝母、知母、牡蛎粉等分，研为细末。每服二钱，猪蹄汤调服。此方名“二母散”。"}]},{"ID":"20240611145139-egb1722","Type":"NodeParagraph","Properties":{"id":"20240611145139-egb1722","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"5、目昏，流冷泪。用贝母一枚、胡椒七料，共研为细末，点眼。"}]},{"ID":"20240611145139-t5qmfid","Type":"NodeParagraph","Properties":{"id":"20240611145139-t5qmfid","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"6、目生弩肉。用贝母、丁香，等分为末，加乳汁调匀点眼。"}]},{"ID":"20240611145139-55nn5lq","Type":"NodeParagraph","Properties":{"id":"20240611145139-55nn5lq","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"7、吐血、鼻血不止。用贝母（炮过），研为细末。每服二钱，温浆水送下。"}]},{"ID":"20240611145139-sdyw5n9","Type":"NodeParagraph","Properties":{"id":"20240611145139-sdyw5n9","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"8、小儿鹅口，满口白烂。用贝母（去心，研细）半钱，加水五分、蜜少许，煎三沸。取抹患处。"}]},{"ID":"20240611145139-imcv05d","Type":"NodeParagraph","Properties":{"id":"20240611145139-imcv05d","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"9、乳痈。用酒送服贝母二钱，另找人吮乳，使之通畅。"}]},{"ID":"20240611145139-g2jqa1c","Type":"NodeParagraph","Properties":{"id":"20240611145139-g2jqa1c","updated":"20240611145139"},"Children":[{"Type":"NodeText","Data":"10、紫白瘢。用贝母、南星，等分为末。生姜带汁调药搽瘢上。"}]},{"ID":"20240611145124-tyg7knf","Type":"NodeThematicBreak","Properties":{"id":"20240611145124-tyg7knf"}},{"ID":"20240611145125-244kgf5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145125-244kgf5","updated":"20240611145131"},"Children":[{"Type":"NodeText","Data":"贝母《本草经集注》"}]},{"ID":"20240611145125-na565e5","Type":"NodeParagraph","Properties":{"id":"20240611145125-na565e5","updated":"20240611145125"},"Children":[{"Type":"NodeText","Data":"味辛、苦，平、微寒，无毒。主治伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金疮，风痉。治腹中结实，心下满，洗洗恶风寒，目眩项直，咳嗽上气，止烦热渴，出汗，安五脏，利骨髓。一名空草，一名药实，一名苦花，一名苦菜，一名商草，一名勒母。生晋地。十月采根，曝干。（浓朴、白薇为之使，恶桃花，畏秦椒、 石、莽草，反乌头。）"}]},{"ID":"20240611145125-yj4s3ie","Type":"NodeParagraph","Properties":{"id":"20240611145125-yj4s3ie","updated":"20240611145125"},"Children":[{"Type":"NodeText","Data":"今出近道，形似聚贝子，故名贝母。断谷服之不饥。"}]},{"ID":"20240611145112-zb7zdhq","Type":"NodeThematicBreak","Properties":{"id":"20240611145112-zb7zdhq"}},{"ID":"20240611145113-f6r2gje","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145113-f6r2gje","updated":"20240611145118"},"Children":[{"Type":"NodeText","Data":"贝母《医学入门》"}]},{"ID":"20240611145113-rqt1lgl","Type":"NodeParagraph","Properties":{"id":"20240611145113-rqt1lgl","updated":"20240611145113"},"Children":[{"Type":"NodeText","Data":"贝母苦辛平散郁，降火消痰清肺疾，烦热咳渴咽项风，淋疸疝瘕心腹实。"}]},{"ID":"20240611145113-u1mkg10","Type":"NodeParagraph","Properties":{"id":"20240611145113-u1mkg10","updated":"20240611145113"},"Children":[{"Type":"NodeText","Data":"形如聚贝子。无毒。丹溪云∶贝母治诸疾者，辛能散结，苦能降火，气血调畅，而疾自愈，收敛疮口亦此意也。消痰止嗽，润肺清心，和中气，安五脏，乃怯症之要药也。又主伤寒淅淅恶风寒，目眩项直，烦热咳嗽，作渴无汗，喉痹，淋沥，时气黄胆，疝瘕，腹中结实，心胁满逆，兼治妇人难产，胞衣不下，乳难，乳痈，去目中肤翳，项下瘿瘤痰核，金疮风痉，人面恶疮。姜汁泡去心，雷公用灰火炮黄去心，和糯米炒黄熟，去米用。"}]},{"ID":"20240611145113-pfk9zre","Type":"NodeParagraph","Properties":{"id":"20240611145113-pfk9zre","updated":"20240611145113"},"Children":[{"Type":"NodeText","Data":"其中有根颗不作两片无皱者，名丹龙精，损人筋脉。浓朴、白薇为使。恶桃花，畏秦艽、矾石、莽草，反乌头。"}]},{"ID":"20240611145113-hdllwvm","Type":"NodeParagraph","Properties":{"id":"20240611145113-hdllwvm","updated":"20240611145113"},"Children":[{"Type":"NodeText","Data":"三母散∶知母、贝母、牡蛎，为末，猪悬蹄汤调服，善下乳汁。又单贝母为末，砂糖丸含化，止嗽。"}]},{"ID":"20240611145102-d9uj6of","Type":"NodeThematicBreak","Properties":{"id":"20240611145102-d9uj6of"}},{"ID":"20240611145103-19nk1ew","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145103-19nk1ew","updated":"20240611145108"},"Children":[{"Type":"NodeText","Data":"贝母《本草新编》"}]},{"ID":"20240611145103-xil1qu2","Type":"NodeParagraph","Properties":{"id":"20240611145103-xil1qu2","updated":"20240611145103"},"Children":[{"Type":"NodeText","Data":"贝母，味苦，气平、微寒，无毒。入肺、胃、脾、心四经。消热痰最利，止久嗽宜用，心中逆气多愁郁者可解，并治伤寒结胸之症，疗人面疮能效。难产与胞衣不下，调服于人参汤中最神。黄瘅赤眼，消渴除烦，喉痹，疝瘕，皆可佐使，但少用足以成功，多用或以取败。宜于阴虚火盛，不宜于阳旺湿痰。世人不知贝母与半夏，性各不同，惧半夏之毒，每改用贝母。不知贝母消热痰，而不能消寒痰，半夏消寒痰，而不能消热痰也。故贝母逢寒痰，则愈增其寒；半夏逢热痰，则大添其热。二品泾渭各殊，乌可代用。前人辨贝母入肺，而不入胃，半夏入脾胃，而不入肺经，尚不知贝母之深也。盖贝母入肺、胃、脾，心四经，岂有不入脾、胃之理哉。正寒热之不相宜，故不可代用也。（〔批〕辨得入微尽妙。）"}]},{"ID":"20240611145103-c0kim84","Type":"NodeParagraph","Properties":{"id":"20240611145103-c0kim84","updated":"20240611145103"},"Children":[{"Type":"NodeText","Data":"或问贝母之疗人面疮，可信不可信乎？曰∶此前人之成效，胡必疑之。然而有可疑者。"}]},{"ID":"20240611145103-jiolp87","Type":"NodeParagraph","Properties":{"id":"20240611145103-jiolp87","updated":"20240611145103"},"Children":[{"Type":"NodeText","Data":"人面疮，口能食而面能愁，盖有祟凭之矣。祟凭必须解祟，何以用贝母即解，予久不得其故，后遇岐天师于燕市，另传治法，而后悟贝母之疗人面疮也，亦消其痰而已矣。夫怪病多起于痰，贝母消痰，故能愈也。如半夏亦消痰圣药，何治人面疮无效？不知人面疮，乃热痰结成热毒，半夏性燥，燥以治热，更添热矣。贝母乃治热痰圣药，以寒治热，而热毒自消，又何疑哉。"}]},{"ID":"20240611145103-xqg9m4i","Type":"NodeParagraph","Properties":{"id":"20240611145103-xqg9m4i","updated":"20240611145103"},"Children":[{"Type":"NodeText","Data":"或问贝母消痰，消热痰也，然火沸为痰，非热乎，何以用之而绝无效耶？曰∶火沸生痰，乃肾中之火上沸，非肺中之火上升。贝母只可治肺中之火痰，不化肾中之火痰也。岂惟不能化肾中之火痰，且动火而生痰矣。夫肾中之火，非补水不能除，肾火之痰，亦非补水不能消。贝母消肺中之痰，必铄肺中之气，肺虚则肾水之化源竭矣，何以生肾水哉。肾水不生，则肾火不降。肾火不降，又何以健脾而消痰哉。势必所用水谷不化精而化痰矣。然则用贝母以治火沸为痰，不犹添薪而望止沸乎。毋怪沓无功效也。"}]},{"ID":"20240611145103-yj1qrua","Type":"NodeParagraph","Properties":{"id":"20240611145103-yj1qrua","updated":"20240611145103"},"Children":[{"Type":"NodeText","Data":"或疑贝母不可治火沸为痰之症，吾用之六味丸中，亦可以治之乎？曰∶六味汤止治火沸为痰之圣药也，加入贝母，则不效矣。盖火沸为痰，乃肾中之真水上沸而成痰，非肺中之津液上存而为痰也。六味汤补水以止沸，非化痰以止火，倘加入贝母，则六味欲趋于肾中，而贝母又欲留于肺内，两相牵掣，则药必停于不上不下之间，痰既不消，火又大炽，不更益其沸，而转添其咳嗽哉。此贝母断不可入于六味汤丸之中，治火沸为痰之病也。"}]},{"ID":"20240611145014-el5vp85","Type":"NodeThematicBreak","Properties":{"id":"20240611145014-el5vp85"}},{"ID":"20240611145025-snf6jll","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145025-snf6jll","updated":"20240611145029"},"Children":[{"Type":"NodeText","Data":"贝母《本草从新》"}]},{"ID":"20240611145025-x95cxz4","Type":"NodeParagraph","Properties":{"id":"20240611145025-x95cxz4","updated":"20240611145025"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、散结清火、润肺、化燥痰．"}]},{"ID":"20240611145025-qxexd72","Type":"NodeParagraph","Properties":{"id":"20240611145025-qxexd72","updated":"20240611145025"},"Children":[{"Type":"NodeText","Data":"甘微寒．泻心火．辛散肺郁．（入肺经气分、心火降则肺气宁、诗曰∶言采其虻、虻、即贝母也、取其解郁．）润心肺．化燥痰．治虚劳烦热．咳嗽上气．吐血咯血．肺痿肺痈．喉痹（小肠邪热、心与小肠相为表里、肺为气化之源．）瘿瘤．（化痰．）乳闭．产难．功专散结除热．敷恶疮．敛疮口．（火降邪散、疮口自敛、非贝母性敛也．）能入肺治燥．非脾家所喜．汪机曰∶俗以半夏燥毒、代以贝母、不知贝母寒润、主肺家燥痰、半夏温燥、主脾家湿痰、何可代也、故凡风寒湿热诸痰、贝母非所宜也、宜用半夏南星．）川产最佳．圆正底平．开瓣味甘．象山贝母．体坚味苦．去时感风痰．土贝母．形大味苦．治外科证痰毒．俱去心捣用．浓朴、白薇为使．畏秦艽．反乌头．"}]},{"ID":"20240611145014-arbzgf3","Type":"NodeThematicBreak","Properties":{"id":"20240611145014-arbzgf3"}},{"ID":"20240611145015-7rls6ca","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145015-7rls6ca","updated":"20240611145019"},"Children":[{"Type":"NodeText","Data":"贝母《本草经解》"}]},{"ID":"20240611145015-u7dglsx","Type":"NodeParagraph","Properties":{"id":"20240611145015-u7dglsx","updated":"20240611145015"},"Children":[{"Type":"NodeText","Data":"气平．味辛．无毒．主伤寒烦热．淋沥邪气．疝瘕．喉痹．乳难．金疮．风痉．（去心糯米炒）"}]},{"ID":"20240611145015-a3hrnqx","Type":"NodeParagraph","Properties":{"id":"20240611145015-a3hrnqx","updated":"20240611145015"},"Children":[{"Type":"NodeText","Data":"贝母气平．禀天秋平之金气．入手太阴肺经．味辛无毒．得地西方之金味．入手阳明燥金大肠经．气味降多于升．阴也．其主伤寒烦热者．伤寒有五．风寒湿热温．而风与热．乃阳盛之症．阳盛所以烦热也．贝母气平则清．味辛润散．故主之也．淋沥者膀胱有热也．邪气者热邪之气也．膀胱以气化为主．贝母味辛润肺．肺乃主气之脏．肺化则气润及于州都．小便通而不淋沥矣．其主疝瘕者．肺气不治．则不能通调水道．下输膀胱．因而湿热之邪．聚结成疝成瘕．贝母气平．可以通调水道．味辛可以散热结也．大肠之脉．其正者上循咽喉．火发于标．乃患喉痹．痹者闭也．其主之者．味辛气平．能解大肠之热结也．肺乃津液之腑．主乳难者．味辛能润．润则乳自通也．肺主皮毛．味辛气平．则肺润而皮毛理．可愈金疮也．风痉者．风湿流于关节．致血不能养筋而筋急也．贝母味辛．辛则散风湿而润血．且贝母入肺．肺润则水道通而津液足．所以风湿逐而筋脉舒也．"}]},{"ID":"20240611145015-nt73zwa","Type":"NodeParagraph","Properties":{"id":"20240611145015-nt73zwa","updated":"20240611145015"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611145015-cagoe26","Type":"NodeParagraph","Properties":{"id":"20240611145015-cagoe26","updated":"20240611145015"},"Children":[{"Type":"NodeText","Data":"贝母、姜汁丸．治忧郁不伸．同浓朴丸．化痰降气．同知母、牡蛎末．猪蹄汤调服．治乳汁不下．专末．治吐血衄血．吹鼻中．治吹乳作痛．同知母、前胡、麦冬、葛根、甘草．治伤寒烦热．同陈皮、前胡、石膏、知母、麦冬、竹沥．治痰疟．同白芷、白蒺藜．治郁症乳痈．"}]},{"ID":"20240611144953-p35vpl7","Type":"NodeThematicBreak","Properties":{"id":"20240611144953-p35vpl7"}},{"ID":"20240611145003-it5d8su","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611145003-it5d8su","updated":"20240611145008"},"Children":[{"Type":"NodeText","Data":"贝母《药鉴》"}]},{"ID":"20240611145003-qahyloh","Type":"NodeParagraph","Properties":{"id":"20240611145003-qahyloh","updated":"20240611145003"},"Children":[{"Type":"NodeText","Data":"气寒，味苦辛，辛能散郁，苦能降火，故凡心中不和，而生诸疾者，皆当用之。治喉痹，消痈肿，止咳嗽，疗金疮，消痰润肺之要药也。人多用之代半夏，误矣。盖贝母本手太阴之剂，而半夏乃足太阴阳明之药也。但烦渴热极诸失血，及痰中带血，阴虚火动而咳嗽者，禁用半夏，为其燥也。此皆以贝母为佐使者宜矣。若脾胃之津液不能营运，因而成痰者，非半夏何以燥之。"}]},{"ID":"20240611144953-x2908aj","Type":"NodeThematicBreak","Properties":{"id":"20240611144953-x2908aj"}},{"ID":"20240611144954-cvo280v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144954-cvo280v","updated":"20240611144958"},"Children":[{"Type":"NodeText","Data":"贝母《本草崇原》"}]},{"ID":"20240611144954-krven21","Type":"NodeParagraph","Properties":{"id":"20240611144954-krven21","updated":"20240611144954"},"Children":[{"Type":"NodeText","Data":"气味辛平，无毒。主治伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金疮风痉。"}]},{"ID":"20240611144954-z8zq4kd","Type":"NodeParagraph","Properties":{"id":"20240611144954-z8zq4kd","updated":"20240611144954"},"Children":[{"Type":"NodeText","Data":"（贝母《尔雅》名 ，《国风》名虻。河中、荆襄、江南皆有，唯川蜀出者为佳，其子在根下，内心外瓣，其色黄白，如聚贝子，故名贝母。）"}]},{"ID":"20240611144954-sr5c85f","Type":"NodeParagraph","Properties":{"id":"20240611144954-sr5c85f","updated":"20240611144954"},"Children":[{"Type":"NodeText","Data":"贝母川产者味甘淡，土产者味苦辛。《本经》气味辛平，合根苗而言也。根形象肺，色白味辛，生于西川，清补肺金之药也。主治伤寒烦热者，寒邪在胸，则为烦为热。贝母清肺，故胸中之烦热可治也。淋沥邪气者，邪入膀胱，不能随太阳而出于肤表。则小便淋沥。贝母通肺气于皮毛，故淋沥邪气可治也。疝瘕乃肝木受病。治疝瘕，金能平木也。喉痹乃肺窍内闭，治喉痹，通肺气也。乳难乃阳明津汁不通。金疮风 ，乃阳明经脉受伤，贝母色白味辛，禀阳明秋金之气，内开郁结，外达皮肤故皆治之。"}]},{"ID":"20240611144757-z6wn2mr","Type":"NodeThematicBreak","Properties":{"id":"20240611144757-z6wn2mr"}},{"ID":"20240611144758-986bnze","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144758-986bnze","updated":"20240611144804"},"Children":[{"Type":"NodeText","Data":"贝母《中药学》"}]},{"ID":"20240611144758-7ikwagb","Type":"NodeParagraph","Properties":{"id":"20240611144758-7ikwagb","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【药用】本品为百合科植物卷叶川贝、川贝母，以及浙贝母等的鳞茎。"}]},{"ID":"20240611144758-nqab89x","Type":"NodeParagraph","Properties":{"id":"20240611144758-nqab89x","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【性味与归经】川贝母：苦、甘，微寒。浙贝母：苦，寒。入心、肺经。"}]},{"ID":"20240611144758-7dkkpq8","Type":"NodeParagraph","Properties":{"id":"20240611144758-7dkkpq8","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【功效】止咳化痰，清热散结。"}]},{"ID":"20240611144758-uuujulx","Type":"NodeParagraph","Properties":{"id":"20240611144758-uuujulx","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肺虚久咳、痰少咽燥及外感风热咳嗽，郁火痰结咳嗽、咯痰黄稠等症。"}]},{"ID":"20240611144758-y2nbtv2","Type":"NodeParagraph","Properties":{"id":"20240611144758-y2nbtv2","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"川贝与浙贝皆属性寒而有苦味，都能清肺化痰而止咳，可用于痰热咳嗽等症。然川贝性凉而有甘味，兼有润肺之功，而清火散结之力则不及浙贝母，故宜用于肺虚久咳、痰少咽燥等症，可与沙参、麦冬、天冬等品配伍；浙贝母苦寒之性较重，开泄力胜，大多用于外感风邪、痰热郁肺所引起的咳嗽，常与桑叶、杏仁、牛蒡子、前胡等品配伍同用。"}]},{"ID":"20240611144758-l783nji","Type":"NodeParagraph","Properties":{"id":"20240611144758-l783nji","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"2.用于瘰历、疮痈肿毒及肺痈、乳痈等症。"}]},{"ID":"20240611144758-kh327es","Type":"NodeParagraph","Properties":{"id":"20240611144758-kh327es","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"二贝都有清热散结的功效，可用于瘰历、疮痈、乳痈及肺痈等症。然浙贝偏于苦寒，长于清火散结，故一般认为用浙贝较佳。在临床应用方面，治瘰历可与玄参、牡蛎配伍；治疮痈可与连翘、蒲公英、天花粉等配伍；治肺痈，可与鲜芦根、生苡仁、冬瓜子、鱼腥草等同用。"}]},{"ID":"20240611144758-z0prer8","Type":"NodeParagraph","Properties":{"id":"20240611144758-z0prer8","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【处方用名】川贝母、川贝、京川贝（均为川贝母）、象贝母、浙贝（均为象贝母）"}]},{"ID":"20240611144758-13tkcqj","Type":"NodeParagraph","Properties":{"id":"20240611144758-13tkcqj","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。川贝母价格较贵，以研粉吞服为宜，每次吞服三分至五分。"}]},{"ID":"20240611144758-5uxg6io","Type":"NodeParagraph","Properties":{"id":"20240611144758-5uxg6io","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【按语】贝母与半夏，都能止咳化痰。但贝母苦寒清热，功专治肺，适用于热痰、燥痰；半夏辛温散寒，治在肺脾，适用于寒痰、湿痰。故一润一燥，各有所长。"}]},{"ID":"20240611144758-0osn2i4","Type":"NodeParagraph","Properties":{"id":"20240611144758-0osn2i4","updated":"20240611144758"},"Children":[{"Type":"NodeText","Data":"【方剂举例】二母散《和剂局方》：贝母、知母。治阴虚发热咳嗽。"}]},{"ID":"20240611144806-f4uvp40","Type":"NodeThematicBreak","Properties":{"id":"20240611144806-f4uvp40"}},{"ID":"20240611144825-urhdhqk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144825-urhdhqk","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《中国药典》：川贝母"}]},{"ID":"20240611144825-imwbjv1","Type":"NodeParagraph","Properties":{"id":"20240611144825-imwbjv1","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611144825-myi4lfi","Type":"NodeParagraph","Properties":{"id":"20240611144825-myi4lfi","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" Chuān Bèi Mǔ"}]},{"ID":"20240611144825-oybk1ub","Type":"NodeParagraph","Properties":{"id":"20240611144825-oybk1ub","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611144825-7v4uhwg","Type":"NodeParagraph","Properties":{"id":"20240611144825-7v4uhwg","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 贝母、川贝"}]},{"ID":"20240611144825-mqtljyp","Type":"NodeParagraph","Properties":{"id":"20240611144825-mqtljyp","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611144825-2lwgcu2","Type":"NodeParagraph","Properties":{"id":"20240611144825-2lwgcu2","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" BULBUS FRITILLARIAE CIRRHOSAE"}]},{"ID":"20240611144825-qi40te2","Type":"NodeParagraph","Properties":{"id":"20240611144825-qi40te2","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611144825-qnhu9tu","Type":"NodeParagraph","Properties":{"id":"20240611144825-qnhu9tu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 本品为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川贝母"},{"Type":"NodeText","Data":"Fritillaria cirrhosa D.Don、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"暗紫贝母"},{"Type":"NodeText","Data":"Fritillaria unibracteata Hsiao et K.C.Hsia、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"甘肃贝母"},{"Type":"NodeText","Data":"Fritillaria przewalskii Maxim. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"梭砂贝母"},{"Type":"NodeText","Data":"Fritillaria delavayi Franch. 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干燥鳞茎"},{"Type":"NodeText","Data":"。前三者按性状不同分别习称“松贝”和“青贝”，后者习称“炉贝”。夏、秋二季或积雪融化时采挖，除去须根、粗皮及泥沙，晒干或低温干燥。"}]},{"ID":"20240611144825-xj6uyez","Type":"NodeParagraph","Properties":{"id":"20240611144825-xj6uyez","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611144825-g8l8fn4","Type":"NodeParagraph","Properties":{"id":"20240611144825-g8l8fn4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 松贝：呈类圆锥形或近球形，高0.3～0.8cm，直径0.3～0.9cm。表面类白色。外层鳞叶2瓣，大小悬殊，大瓣紧抱小瓣，未抱部分呈新月形，习称“怀中抱月”；顶部闭合，内有类圆柱形、顶端稍尖的心芽和小鳞叶1～2枚；先端钝圆或稍尖，底部平，微凹入，中心有1灰褐色的鳞茎盘，偶有残存须根。质硬而脆，断面白色，富粉性。气微，味微苦。"}]},{"ID":"20240611144825-q6eq4b4","Type":"NodeParagraph","Properties":{"id":"20240611144825-q6eq4b4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"青贝：呈类扁球形，高0.4～1.4cm，直径0.4～1.6cm。外层鳞叶2瓣，大小相近，相对抱合，顶部开裂，内有心芽和小鳞叶2～3枚及细圆柱形的残茎。"}]},{"ID":"20240611144825-q6h1vhn","Type":"NodeParagraph","Properties":{"id":"20240611144825-q6h1vhn","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"炉贝呈长圆锥形，高0.7～2.5cm，直径0.5～2.5cm。表面类白色或浅棕黄色，有的具棕色斑点。外层鳞叶2瓣，大小相近，顶部开裂而略尖，基部稍尖或较钝。"}]},{"ID":"20240611144825-z7y7kgb","Type":"NodeParagraph","Properties":{"id":"20240611144825-z7y7kgb","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611144825-6rf8kss","Type":"NodeParagraph","Properties":{"id":"20240611144825-6rf8kss","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240611144825-ute1c91","Type":"NodeParagraph","Properties":{"id":"20240611144825-ute1c91","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611144825-hukc03z","Type":"NodeParagraph","Properties":{"id":"20240611144825-hukc03z","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 本品粉末类白色。"}]},{"ID":"20240611144825-a5yzhdy","Type":"NodeParagraph","Properties":{"id":"20240611144825-a5yzhdy","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"松贝、青贝 淀粉粒甚多，广卵形、长圆形或不规则圆形，有的边缘不平整或略作分枝状，直径 5～64μｍ，脐点短缝状、点状、人字状或马蹄状，层纹隐约可见。表皮细胞类长方形，垂周壁微波状弯曲，偶见不定式气孔，圆形或扁圆形。螺纹导管直径5～26μｍ。"}]},{"ID":"20240611144825-vjlrjv0","Type":"NodeParagraph","Properties":{"id":"20240611144825-vjlrjv0","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"炉贝 淀粉粒广卵形、贝壳形、肾形或椭圆形，直径约至60μｍ，脐点人字状、星状或点状，层纹明显。螺纹及网纹导管直径可达64μｍ。"}]},{"ID":"20240611144825-22n7tec","Type":"NodeParagraph","Properties":{"id":"20240611144825-22n7tec","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611144825-krmsvnr","Type":"NodeParagraph","Properties":{"id":"20240611144825-krmsvnr","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 归肺、心经。"}]},{"ID":"20240611144825-d9i6s2q","Type":"NodeParagraph","Properties":{"id":"20240611144825-d9i6s2q","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611144825-n6j3jm6","Type":"NodeParagraph","Properties":{"id":"20240611144825-n6j3jm6","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 苦、甘，微寒。"}]},{"ID":"20240611144825-jnb6ujf","Type":"NodeParagraph","Properties":{"id":"20240611144825-jnb6ujf","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611144825-4v9uwrx","Type":"NodeParagraph","Properties":{"id":"20240611144825-4v9uwrx","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 不宜与乌头类药材同用。"}]},{"ID":"20240611144825-ogeb1gc","Type":"NodeParagraph","Properties":{"id":"20240611144825-ogeb1gc","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611144825-ooez1nb","Type":"NodeParagraph","Properties":{"id":"20240611144825-ooez1nb","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 清热润肺，化痰止咳。用于肺热燥咳，干咳少痰，阴虚劳嗽，咯痰带血。"}]},{"ID":"20240611144825-lh921ia","Type":"NodeParagraph","Properties":{"id":"20240611144825-lh921ia","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611144825-9vhwmtr","Type":"NodeParagraph","Properties":{"id":"20240611144825-9vhwmtr","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 3～9g；研粉冲服，一次1～2g。"}]},{"ID":"20240611144825-fs2hwgx","Type":"NodeParagraph","Properties":{"id":"20240611144825-fs2hwgx","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611144825-q8fu5cs","Type":"NodeParagraph","Properties":{"id":"20240611144825-q8fu5cs","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611144825-ek6hyt5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144825-ek6hyt5","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：川贝母"}]},{"ID":"20240611144825-aozdo9y","Type":"NodeParagraph","Properties":{"id":"20240611144825-aozdo9y","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611144825-mdtoce5","Type":"NodeParagraph","Properties":{"id":"20240611144825-mdtoce5","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" Chuān Bèi Mǔ"}]},{"ID":"20240611144825-fe3fnd7","Type":"NodeParagraph","Properties":{"id":"20240611144825-fe3fnd7","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611144825-tivb7ak","Type":"NodeParagraph","Properties":{"id":"20240611144825-tivb7ak","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 虻（《诗经》），黄虻（《管子》），苘（《尔稚》），贝母、空草（《本经》），贝父、药实（《广雅》），苦花、苦菜、勤母（《别录》）。"}]},{"ID":"20240611144825-0grv0w9","Type":"NodeParagraph","Properties":{"id":"20240611144825-0grv0w9","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611144825-m3svaiy","Type":"NodeParagraph","Properties":{"id":"20240611144825-m3svaiy","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 《滇南本草》"}]},{"ID":"20240611144825-8ezac8g","Type":"NodeParagraph","Properties":{"id":"20240611144825-8ezac8g","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611144825-xhaa33a","Type":"NodeParagraph","Properties":{"id":"20240611144825-xhaa33a","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"卷叶贝母"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌花贝母"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"棱砂贝母"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳞茎"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611144825-t0omwpp","Type":"NodeParagraph","Properties":{"id":"20240611144825-t0omwpp","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611144825-z3y4w5h","Type":"NodeParagraph","Properties":{"id":"20240611144825-z3y4w5h","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" ①卷叶贝母"}]},{"ID":"20240611144825-nxv6ato","Type":"NodeParagraph","Properties":{"id":"20240611144825-nxv6ato","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15～55厘米。鳞茎圆锥形或近球形，直径5～12毫米。茎直立，绿色或微带褐紫色，具细小灰色斑点。叶片着生在茎上部1／3或1／5的部分，通常下端对生，上端3叶轮生，少为互生；叶片线形，长5～12厘米，宽2～10毫米，先端卷曲呈卷须状。花单生于茎顶，少有2朵，下垂，钟状；花被6片，菱状椭圆形，长2．5～3厘米，外轮3片较挟，先端钝圆或梢尖，黄绿色，具紫色方块纹及脉纹：雄蕊6，长1～1．5厘米；子房3室，花柱较粗，柱头3歧而外反。蒴果六角矩形，长7～20毫米，径达12毫米。种子薄而扁平，半圆形，黄色。花期6月。果熟期8月。"}]},{"ID":"20240611144825-0aakmv3","Type":"NodeParagraph","Properties":{"id":"20240611144825-0aakmv3","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"生于高山草地或湿润的灌木丛中。分布四川、西藏、云南、甘肃、青海等地。"}]},{"ID":"20240611144825-l3j8xvy","Type":"NodeParagraph","Properties":{"id":"20240611144825-l3j8xvy","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"形态与卷叶贝母相似，惟本种鳞茎圆锥形，直径6～8毫米。叶下部的常对生，上部的互生或近对生，线形或线状披针形，长4～6．5匣米，宽3～5毫米，先端不卷曲。花被片长2～2．5厘米，外轮长椭圆形，内轮矩状倒卵形，外面浓紫色，内面黄绿色并带不规则的紫色斑点及脉纹；花丝密被短毛。"}]},{"ID":"20240611144825-1j1cijq","Type":"NodeParagraph","Properties":{"id":"20240611144825-1j1cijq","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"生高山阳光充足的草坡上。分布四川和青海交界处。"}]},{"ID":"20240611144825-pj0plc4","Type":"NodeParagraph","Properties":{"id":"20240611144825-pj0plc4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"③棱砂贝母，又名：雪山贝。"}]},{"ID":"20240611144825-kwhjuj3","Type":"NodeParagraph","Properties":{"id":"20240611144825-kwhjuj3","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"多年生草本，高25～40厘米。鳞茎圆锥形，径1．5～2厘米，鳞叶6～10片。茎绿褐色．叶互生，少有对生，无柄，基部稍抱茎，绿褐色或紫褐色：叶片长卵圆形，长4厘米左右，宽5～20毫米，先端不卷曲，上方叶窄小，顶生叶披针形。花单生于茎顶；花被长卵形，长3～4厘米，黄绿色，并有深色的平行脉纹及紫褐色的标点，基部中央具长6毫米，宽2毫米的腺穴；雄蕊6，花丝无毛。蒴果长16毫米。种子椭圆形，具翅，大小约2～3毫米；花期5月。果期7月。"}]},{"ID":"20240611144825-dw85agq","Type":"NodeParagraph","Properties":{"id":"20240611144825-dw85agq","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"生于高寒地带。分布云南、四川、西藏等地。"}]},{"ID":"20240611144825-6lgbtwj","Type":"NodeParagraph","Properties":{"id":"20240611144825-6lgbtwj","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611144825-43f1blq","Type":"NodeParagraph","Properties":{"id":"20240611144825-43f1blq","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 川贝母的商品主要有松贝、青贝、炉贝3类。松贝、青贝的原植物为卷叶贝母、乌花贝母；炉贝的原植物为棱砂贝母。"}]},{"ID":"20240611144825-ds71rlg","Type":"NodeParagraph","Properties":{"id":"20240611144825-ds71rlg","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①松贝"}]},{"ID":"20240611144825-ubc2yy9","Type":"NodeParagraph","Properties":{"id":"20240611144825-ubc2yy9","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"干燥鳞茎，全体呈圆锥形，顶端尖或微尖，直径4～12毫米，颗粒最小者称\"珍珠贝\"。表面白色诚淡黄色，外围为2瓣鳞叶，1瓣大，略呈马蹄形，1瓣小，略呈披针形，相对抱合，其内包有小鳞叶数枚。底部中央，有一细小而坚硬的鳞茎盘，其下残留少数须根痕。不论颗粒大小，均能端正起立，顶端均不开裂。质硬而脆，富粉性，断面白色，呈颗粒状。气微弱，味微苦。以质坚实，颗粒均匀整齐、顶端不开裂、色洁白、粉性足者为佳。"}]},{"ID":"20240611144825-0g06b4p","Type":"NodeParagraph","Properties":{"id":"20240611144825-0g06b4p","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"主产四川（阿坝藏族自治州），为川贝中之最优品。"}]},{"ID":"20240611144825-kfx8zlb","Type":"NodeParagraph","Properties":{"id":"20240611144825-kfx8zlb","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②青贝"}]},{"ID":"20240611144825-a70yk5a","Type":"NodeParagraph","Properties":{"id":"20240611144825-a70yk5a","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"干燥鳞茎，呈扁球形或略呈圆锥形，颗粒多歪曲，高5～10毫米，直径1～1．6厘米。外表色白微黄，顶端开裂，平或略尖，外层2鳞叶大小几乎相等，墓部常残留须根。断面粉白色，颗粒性，富粉性而坚实。气无，味淡。以粒小均匀、色洁白、粉性足者为佳。"}]},{"ID":"20240611144825-tw9pee4","Type":"NodeParagraph","Properties":{"id":"20240611144825-tw9pee4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"主产青海、四川和云南交界处，品质亦优。"}]},{"ID":"20240611144825-kwmm3ov","Type":"NodeParagraph","Properties":{"id":"20240611144825-kwmm3ov","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"③炉贝"}]},{"ID":"20240611144825-ixz2g8y","Type":"NodeParagraph","Properties":{"id":"20240611144825-ixz2g8y","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"干燥鳞茎，呈长圆锥形如马齿，顶端尖，高1～2厘米，直径约1～1．5厘米。外表白色或黄白色而有深黄色斑点，形成虎纹，习称\"虎皮贝\"。外层2鳞叶大小相等，顶端开裂，基部较尖或圆。断面均显粉白色，粉质而较坚。气微弱，味淡。以质坚实、色白者为佳。"}]},{"ID":"20240611144825-3pj5uce","Type":"NodeParagraph","Properties":{"id":"20240611144825-3pj5uce","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"主产四川（昌都）、云南（德钦、大理），品质次于松贝、青贝。"}]},{"ID":"20240611144825-7fuoesu","Type":"NodeParagraph","Properties":{"id":"20240611144825-7fuoesu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611144825-al9zfyn","Type":"NodeParagraph","Properties":{"id":"20240611144825-al9zfyn","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，用水稍泡，捞出，闷润，剥去心，晒干。"}]},{"ID":"20240611144825-h8ffahp","Type":"NodeParagraph","Properties":{"id":"20240611144825-h8ffahp","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使贝母先于柳木灰中炮令黄，擘破，去内口鼻上有米许大者心一小颗后，拌糯米于磝上同炒，待米黄熟，然后去米取出。\""}]},{"ID":"20240611144825-0shmq60","Type":"NodeParagraph","Properties":{"id":"20240611144825-0shmq60","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②《本草述钩元》：\"姜汁泡，去心。\""}]},{"ID":"20240611144825-ayn90k5","Type":"NodeParagraph","Properties":{"id":"20240611144825-ayn90k5","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611144825-i2zzbus","Type":"NodeParagraph","Properties":{"id":"20240611144825-i2zzbus","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 入肺经。"}]},{"ID":"20240611144825-o6l88tl","Type":"NodeParagraph","Properties":{"id":"20240611144825-o6l88tl","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①王好古：\"肺经。\""}]},{"ID":"20240611144825-a17j8lc","Type":"NodeParagraph","Properties":{"id":"20240611144825-a17j8lc","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、肺二经。\""}]},{"ID":"20240611144825-z7am411","Type":"NodeParagraph","Properties":{"id":"20240611144825-z7am411","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"③《本草经解，：\"入手太阴肺经、手阳明大肠经。\""}]},{"ID":"20240611144825-v6xh1yk","Type":"NodeParagraph","Properties":{"id":"20240611144825-v6xh1yk","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611144825-gbsut95","Type":"NodeParagraph","Properties":{"id":"20240611144825-gbsut95","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 苦甘，凉。"}]},{"ID":"20240611144825-0as0ax0","Type":"NodeParagraph","Properties":{"id":"20240611144825-0as0ax0","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240611144825-ym1kfyr","Type":"NodeParagraph","Properties":{"id":"20240611144825-ym1kfyr","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，微寒，无毒。\""}]},{"ID":"20240611144825-tmij1hn","Type":"NodeParagraph","Properties":{"id":"20240611144825-tmij1hn","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑧《唐本草》：\"味甘苦，不辛。\""}]},{"ID":"20240611144825-fjsx3nu","Type":"NodeParagraph","Properties":{"id":"20240611144825-fjsx3nu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611144825-jorfda4","Type":"NodeParagraph","Properties":{"id":"20240611144825-jorfda4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒及有湿痰者不宜。"}]},{"ID":"20240611144825-2s1xqqw","Type":"NodeParagraph","Properties":{"id":"20240611144825-2s1xqqw","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①《本草经集庄》：\"厚朴、白薇为之使。恶槐花。畏秦艽、矾石、莽草。反乌头。\""}]},{"ID":"20240611144825-kjzuwdo","Type":"NodeParagraph","Properties":{"id":"20240611144825-kjzuwdo","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"寒湿痰及食积痰火作嗽，湿痰在胃恶心欲吐，痰饮作寒热，脾胃湿痰作眩晕及我厥头痛中恶呕吐，胃寒作泄并禁用。\""}]},{"ID":"20240611144825-b2kanlq","Type":"NodeParagraph","Properties":{"id":"20240611144825-b2kanlq","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611144825-cn4xdik","Type":"NodeParagraph","Properties":{"id":"20240611144825-cn4xdik","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 润肺散结，止嗽化痰。治虚劳咳嗽，吐痰咯血，心胸郁结，肺痿，肺痈，瘿瘤，廉疬，喉痹，乳痈。"}]},{"ID":"20240611144825-eh8nqkb","Type":"NodeParagraph","Properties":{"id":"20240611144825-eh8nqkb","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金疮风痉。\""}]},{"ID":"20240611144825-1mi6z9q","Type":"NodeParagraph","Properties":{"id":"20240611144825-1mi6z9q","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗腹中结实，心下满，洗洗恶风寒，目眩，项直，咳嗽上气，止烦热渴，出汗，安五脏，利骨髓。\""}]},{"ID":"20240611144825-z8pb612","Type":"NodeParagraph","Properties":{"id":"20240611144825-z8pb612","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治虚热，主难产作末服之；兼治胞衣不出，取七枚末，酒下；末，点眼去肤翳；主胸胁逆气，疗时疾黄疸，与连翘同主项下瘤瘿疾。\""}]},{"ID":"20240611144825-2lv1y2f","Type":"NodeParagraph","Properties":{"id":"20240611144825-2lv1y2f","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"消痰，润心肺。末，和砂糖为丸含，止嗽；烧灰油敷人畜恶疮。\""}]},{"ID":"20240611144825-iujrjvk","Type":"NodeParagraph","Properties":{"id":"20240611144825-iujrjvk","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑤《本草别说》：\"能散心胸郁结之气。\""}]},{"ID":"20240611144825-8qqnmpo","Type":"NodeParagraph","Properties":{"id":"20240611144825-8qqnmpo","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑥《本草会缠）：\"治虚劳咳嗽，吐血咯血，肺痿肺痈，妇人乳痈、痈疽及诸郁之证。\""}]},{"ID":"20240611144825-qra1yjl","Type":"NodeParagraph","Properties":{"id":"20240611144825-qra1yjl","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑦《本草正》：\"降胸中因热结脚及乳痈流痰结核。\""}]},{"ID":"20240611144825-1gv2042","Type":"NodeParagraph","Properties":{"id":"20240611144825-1gv2042","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑧《本草述》：\"疗肿瘤疡，可以托里护心，收敛解毒。\""}]},{"ID":"20240611144825-9n5dk9o","Type":"NodeParagraph","Properties":{"id":"20240611144825-9n5dk9o","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611144825-ser70ff","Type":"NodeParagraph","Properties":{"id":"20240611144825-ser70ff","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。外用：研末撒或调敷。"}]},{"ID":"20240611144825-ujy1szh","Type":"NodeParagraph","Properties":{"id":"20240611144825-ujy1szh","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611144825-pbz5lq5","Type":"NodeParagraph","Properties":{"id":"20240611144825-pbz5lq5","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" ①治肺热咳嗽多痰，咽喉中干：见母（去心）一两半，甘草（炙）三分，杏仁（汤浸去皮、尖、炒）一两半。上三味，捣罗为末，炼蜜丸如弹子大。含化咽津。（《圣济总录》贝母丸）"}]},{"ID":"20240611144825-zr9a6w1","Type":"NodeParagraph","Properties":{"id":"20240611144825-zr9a6w1","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②治伤风暴得咳嗽：贝母（安心）三分，款冬花、麻黄（去根节）、杏仁（汤浸，去皮、尖、双仁，炒研）各一两，甘草（炙锉）三分。上五味，粗捣筛，每服三钱匕，水一盏，生姜三片，煎至七分，去滓温服，不拘时。（《圣济总录》贝母汤）"}]},{"ID":"20240611144825-6lfs7hj","Type":"NodeParagraph","Properties":{"id":"20240611144825-6lfs7hj","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"③治伤寒后暴嗽、喘急；欲成肺萎、劳嗽：贝母一两半（煨令微黄）。桔梗一两（去芦头），甘草一两（炙微赤、锉），紫菀一两（洗去苗土），杏仁半两（汤浸，去皮、尖、双仁、麸炒微黄）。上药捣罗为末，炼蜜丸如梧桐子大。每服不计时候，以粥饮下二十丸；如弹子大，绵襄一丸，含咽亦佳。（《圣惠力》贝母丸）"}]},{"ID":"20240611144825-5y03dlo","Type":"NodeParagraph","Properties":{"id":"20240611144825-5y03dlo","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"④治小儿咳嗽喘闷：贝母（去心，麸炒）半两，甘草（炙）一分。上二味捣罗为散，如二、三岁儿，每一钱匕，水七分，煎至四分，去滓，入牛黄末少许，食后温分二服，更量儿大小加减。（《圣济总录》贝母散）"}]},{"ID":"20240611144825-gx98yhu","Type":"NodeParagraph","Properties":{"id":"20240611144825-gx98yhu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑤治百日咳：川贝母五钱，黄郁金、葶苈子、桑白皮、白前、马兜铃各五分。共轧为极细末，备用。1．5～3岁，每次二分；4～7岁，每次五分；8～10岁，每次七分，均一日三次，温水调冲，小儿酌加白糖或蜜糖亦可。（《江苏中医》（2）：36，1965）"}]},{"ID":"20240611144825-hhq79va","Type":"NodeParagraph","Properties":{"id":"20240611144825-hhq79va","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑥治久嗽咽嗌妨闷，咽痛咯血：贝母不以多少，为细末炼蜜和丸，如弹子大，每服一丸，食后含化，日可三服。（《鸡峰普济方》贝母丸）"}]},{"ID":"20240611144825-ublwrpv","Type":"NodeParagraph","Properties":{"id":"20240611144825-ublwrpv","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑦治肺痈肺萎：川贝一两，天竺黄、硼砂各一钱，文蛤五分（醋炒）。为末，以枇杷叶刷净蜜炙，熬膏作丸，芡实大，噙咽之。（《医级》贝母括痰丸）"}]},{"ID":"20240611144825-86d758q","Type":"NodeParagraph","Properties":{"id":"20240611144825-86d758q","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑧治吐血衄血，或发或止，皆心藏积热所致：贝母一两（炮令黄）。捣细罗为散，不计时候，以温浆调下二钱。（《圣惠方》）"}]},{"ID":"20240611144825-vmfbrxr","Type":"NodeParagraph","Properties":{"id":"20240611144825-vmfbrxr","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑨治忧郁不伸，胸膈不宽：贝母去心，姜汁炒研，姜汁面糊丸，每次七十丸。（《集效方》）"}]},{"ID":"20240611144825-yiklxa5","Type":"NodeParagraph","Properties":{"id":"20240611144825-yiklxa5","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑩化痰降气，止咳解郁，消食除胀：贝母（去心）一两，姜制厚朴半两。蜜丸梧子大，每白汤下五十丸。（《卫生杂兴》）"}]},{"ID":"20240611144825-265ys19","Type":"NodeParagraph","Properties":{"id":"20240611144825-265ys19","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑾下乳：牡蛎、知母、贝母，三物为细末，同猪蹄汤调下。（《汤液本草》三母散）"}]},{"ID":"20240611144825-4jz2htk","Type":"NodeParagraph","Properties":{"id":"20240611144825-4jz2htk","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⑿治瘰疬便毒：皿母、皂角子各半斤。为细末，用皂角半斤锉碎，搓揉浓水，滤过作膏子，和药末，丸如梧桐子大。每服五、七十丸，早晨酒下。（《昔济方》贝母丸）"}]},{"ID":"20240611144825-lgt3q00","Type":"NodeParagraph","Properties":{"id":"20240611144825-lgt3q00","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⒀治喉痹肿胀：贝母、山豆根、桔梗、甘草、荆芥、薄荷，煎汤服。（《本草切要》）"}]},{"ID":"20240611144825-n7730w1","Type":"NodeParagraph","Properties":{"id":"20240611144825-n7730w1","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⒁治乳痈初发：贝母为末，每服二钱，温酒调下，即以两手覆按于桌上，垂乳良久乃通。（《仁斋直指加）"}]},{"ID":"20240611144825-z4bazme","Type":"NodeParagraph","Properties":{"id":"20240611144825-z4bazme","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⒂治冷泪目昏：贝母一枚，胡椒七粒，为末点之。（《儒门事亲》）"}]},{"ID":"20240611144825-3zrnawa","Type":"NodeParagraph","Properties":{"id":"20240611144825-3zrnawa","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"⒃治小儿鹅口，满口白烂：贝母去心为末，半钱，水五分，蜜少许，煎三沸，缴净抹之，日四、五度。（《圣惠方》）"}]},{"ID":"20240611144825-b6cfl5h","Type":"NodeParagraph","Properties":{"id":"20240611144825-b6cfl5h","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611144825-42wpxsh","Type":"NodeParagraph","Properties":{"id":"20240611144825-42wpxsh","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 此外，尚有下列几种，亦作川贝母使用："}]},{"ID":"20240611144825-551n5ij","Type":"NodeParagraph","Properties":{"id":"20240611144825-551n5ij","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"①岷贝，为植物甘肃贝母的干燥鳞茎。"}]},{"ID":"20240611144825-incawsm","Type":"NodeParagraph","Properties":{"id":"20240611144825-incawsm","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"鳞茎圆锥形。叶生于下部的对生，披针形至线形，长5～9厘米，宽5～10毫米，先端钝；上部的叶互生，对生，或3叶轮生，多成线形，先端不弯曲。花钟形，下垂，花被片长3～4．5厘米，黄色，有淡紫小斑点，花丝具乳头状突起。"}]},{"ID":"20240611144825-x6n1icx","Type":"NodeParagraph","Properties":{"id":"20240611144825-x6n1icx","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"主产甘肃。"}]},{"ID":"20240611144825-y4964vi","Type":"NodeParagraph","Properties":{"id":"20240611144825-y4964vi","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"药材性状似青贝，但色泽较白。"}]},{"ID":"20240611144825-zpzalf2","Type":"NodeParagraph","Properties":{"id":"20240611144825-zpzalf2","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"②平贝，为植物平贝母的干燥鳞茎。"}]},{"ID":"20240611144825-jxz4da6","Type":"NodeParagraph","Properties":{"id":"20240611144825-jxz4da6","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"鳞茎圆而扁平。下部叶轮生，上部叶对生或互生，线形，长9～12厘米，宽2～6毫米，先端渐尖，呈卷须状。花单生叶腋，狭钟形，下垂，花被片长2～3厘米，紫黄色，具多数黄色斑痕。"}]},{"ID":"20240611144825-qvtx7wf","Type":"NodeParagraph","Properties":{"id":"20240611144825-qvtx7wf","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"药材圆而扁平，高5～8毫米，直径1～2厘米。表面类白色或微棕黄色，外层2鳞片较厚，大小相似，互相合抱，顶端常开裂。断面颗粒性，粉质，坚实。气微酸，味苦。"}]},{"ID":"20240611144825-t7m1zam","Type":"NodeParagraph","Properties":{"id":"20240611144825-t7m1zam","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"主产黑龙江、吉林、辽宁等地。"}]},{"ID":"20240611144825-g2vc6ph","Type":"NodeParagraph","Properties":{"id":"20240611144825-g2vc6ph","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"③生贝，为植物伊贝母（又名：西贝母）的干燥鳞茎。"}]},{"ID":"20240611144825-pbshoye","Type":"NodeParagraph","Properties":{"id":"20240611144825-pbshoye","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"伊贝母鳞茎卵圆形。叶互生或对生，无柄，下部叶广披针形至椭圆形，长4～11厘米，宽22～30毫米，顶叶轮生，线形至披针形，先端不呈卷须状。花单生或2～6朵成束状，顶生，钟形，长3～4．5厘米，宽2～2．5厘米，花被片黄色或白绿色，内面有不明显的暗色斑点。"}]},{"ID":"20240611144825-k03nvcf","Type":"NodeParagraph","Properties":{"id":"20240611144825-k03nvcf","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"药材扁圆球形或类扁圆锥形，大小及形态极不整齐，高1～2厘米，直径1．5～2．5厘米。表面黄白色，有深黄色斑点，顶端尖或平，开裂或不开裂，基部扁平而凹入，外层鳞片有的似浙贝母而较薄，内表面棕黄色。质轻而疏松，折断面颗粒性，微带灰质。气微弱，味微苦或带咸。以坚实而有粉性、不带咸味者为佳。"}]},{"ID":"20240611144825-khlrbfu","Type":"NodeParagraph","Properties":{"id":"20240611144825-khlrbfu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"主产新疆。"}]},{"ID":"20240611144825-8t3u40a","Type":"NodeParagraph","Properties":{"id":"20240611144825-8t3u40a","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"④北贝，为植物一轮贝母的干燥鳞茎。"}]},{"ID":"20240611144825-43s189m","Type":"NodeParagraph","Properties":{"id":"20240611144825-43s189m","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"一轮贝母鳞茎扁球形，直径在1厘米以下。叶4～5片轮生于茎上部（仅1轮，偶有2轮），其余的叶对生或互生，叶片先端不卷曲。花单生，暗紫色，上有黄色斑点。产华北、东北。"}]},{"ID":"20240611144825-0gaeiod","Type":"NodeParagraph","Properties":{"id":"20240611144825-0gaeiod","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611144825-6b7ca3s","Type":"NodeParagraph","Properties":{"id":"20240611144825-6b7ca3s","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611144825-grd0l69","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144825-grd0l69","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《中华本草》：川贝母"}]},{"ID":"20240611144825-igob1os","Type":"NodeParagraph","Properties":{"id":"20240611144825-igob1os","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611144825-3zrtgeh","Type":"NodeParagraph","Properties":{"id":"20240611144825-3zrtgeh","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" Chuān Bèi Mǔ"}]},{"ID":"20240611144825-hod2792","Type":"NodeParagraph","Properties":{"id":"20240611144825-hod2792","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611144825-ggf1mpi","Type":"NodeParagraph","Properties":{"id":"20240611144825-ggf1mpi","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 虻、黄虻、莔、贝母、勤母、药实"}]},{"ID":"20240611144825-5mrre2e","Type":"NodeParagraph","Properties":{"id":"20240611144825-5mrre2e","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611144825-pqxvu4a","Type":"NodeParagraph","Properties":{"id":"20240611144825-pqxvu4a","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" Unibract Fritillary Bulb， Bulb of Unibract Fritillary， Bulb of Tendrilleaf Fritillary， Bulb of Przewalsk Fritillary， Bulb of Delavay Fritillary"}]},{"ID":"20240611144825-e3nhoc8","Type":"NodeParagraph","Properties":{"id":"20240611144825-e3nhoc8","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611144825-bub5nvq","Type":"NodeParagraph","Properties":{"id":"20240611144825-bub5nvq","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 出自《滇南本草》1.《雷公炮炙论》：贝母有独颗团不作两片无皱者，号曰丹龙精，不入用。若误服，令人筋脉永不收。用黄精、小蓝汁合服立愈。"}]},{"ID":"20240611144825-37tyslg","Type":"NodeParagraph","Properties":{"id":"20240611144825-37tyslg","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：贝母，叶似大蒜。四月蒜熟时采，良。若十月苗枯，根亦不佳也。出润州、荆州、襄州者最佳。江南诸州亦有。"}]},{"ID":"20240611144825-vsrep7m","Type":"NodeParagraph","Properties":{"id":"20240611144825-vsrep7m","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：贝母，今河中、江陵府、郢、寿、随、郑、莱、润、滁州皆有之。根有瓣子，黄白色；二月生苗，茎细青色；叶亦青，似荞麦叶，随苗出"}]},{"ID":"20240611144825-gt4i0j4","Type":"NodeParagraph","Properties":{"id":"20240611144825-gt4i0j4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611144825-eyvy1s9","Type":"NodeParagraph","Properties":{"id":"20240611144825-eyvy1s9","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物暗紫贝母、卷叶贝母、棱砂贝母、甘肃贝母、康定贝母等的鳞茎。"}]},{"ID":"20240611144825-suc2dy9","Type":"NodeParagraph","Properties":{"id":"20240611144825-suc2dy9","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Fritillaria unibracteata Hsiao et K.C. Hsia， Fritillaria cirrhosa D. Don， Fritillaria delavayi Franch.，Fritillaria przewalskii Maxim.ex Batal.，Fritillaria cirrhosa D.Don var. ecirrhosa Franch."}]},{"ID":"20240611144825-hro9c1b","Type":"NodeParagraph","Properties":{"id":"20240611144825-hro9c1b","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"采收和储藏：种子播种栽培的第3生长季，鳞茎繁殖栽培的次年，都可采挖。6-7月茎叶枯萎后，选晴天采挖，清除泥土，注意避免损伤，不能淘洗，及时将采回的鲜贝母摊放竹席上晒干，以1d能晒至半天，次日能晒干为好。干燥时不能堆沤，否则发黄变质。如遇雨天，可以烘干，烘温40-50度为宜。"}]},{"ID":"20240611144825-9jm9oru","Type":"NodeParagraph","Properties":{"id":"20240611144825-9jm9oru","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611144825-rxptzti","Type":"NodeParagraph","Properties":{"id":"20240611144825-rxptzti","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 生态环境：1..暗紫贝母生于海拔3200-4500m的草地上。 2.卷叶贝母生于林中灌丛下、草地、河滩、山谷等湿地或岩缝中。 3.棱砂贝母生于海拔3800-4700m的流沙滩上的岩石缝隙中。 4.甘肃贝母生于海拔2800-4400m的灌丛中或草地上。5.康定贝母生于海拓3500-4100的河边林下或草地上。"}]},{"ID":"20240611144825-r54y6k3","Type":"NodeParagraph","Properties":{"id":"20240611144825-r54y6k3","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"资源分布：1.暗紫贝母 分布于四川、青海。 2.卷叶贝母 分布于四川、云南、西藏等地。 3.棱砂贝母 分布于青海、四川、云南、西藏等地。 4.甘肃贝母 分布于甘肃、青海、四川。 5.康定贝母 分布于四川康定一带。"}]},{"ID":"20240611144825-nmbna6o","Type":"NodeParagraph","Properties":{"id":"20240611144825-nmbna6o","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611144825-rg5o1bh","Type":"NodeParagraph","Properties":{"id":"20240611144825-rg5o1bh","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 1.暗紫贝母 多年生草本，高15-25cm。鳞茎球形或圆锥形，由2枚鳞片组成，直径6-8mm。茎直立，单一，无毛。叶在下面的1-2对为对生，上面的1-2枚散生或对生，无柄，条形或条状披针形，长3.6-6.5cm；宽3-7mm，先端急尖，不卷曲。花单生于茎顶，深黄色，有黄褐色小方格；叶状苞片1枚，先端不卷曲；花被片6，2轮，长2.5-2.7cm，内3片倒卵状长圆形，宽约1cm，外3片近长圆形，宽约6mm；蜜腺窝稍凸出或不很明显；雄蕊6，长约为花被片的一半，花药近基着生，花丝具或不具小乳突；柱头3裂，裂片短而外展，长0.5-1mm。蒴果长圆形，长1-1.5cm，宽1-1.2cm，具6棱，棱上的翅很窄，宽约1mm。花期6月，果期8月。 2.卷叶贝母 多年生草本，植物形态变化较大。鳞茎卵圆形，由2枚鳞片组成，直径1-1.5cm叶通常对生，少数在中部兼有散生或轮生；叶片条形至条状披针形，先端稍卷曲或不卷曲。花单生茎顶，紫色至黄绿色，通常有小方格，少数仅有斑点或条纹；每花有3枚叶状苞片，狭长，宽2-4mm；花被片6，长3-4cm，外轮3片，宽1-1.4cm，内轮3片近倒卵形或椭圆状倒卵形，宽可达1.8cm；蜜腺窝在背面明显凸出；雄蕊长约为花被片的3/5，花药近基着生，花丝多少具小乳突；柱头裂片长3-5mm。蒴果棱上具宽1-1.5mm的窄翅。花期5-7月，果期8-10月。 3.棱砂贝母 多年生草本，高17-35cm。鳞茎长卵圆形，由2（-3）枚鳞片组成，直径1-2cm。叶互生，3-5枚（包括叶状苞片）较紧密地生于植株中部或上部； 叶片狭卵形至卵状椭圆形，长2-7cm，宽1-3cm，先端不卷曲。单花顶生，宽钟状，略俯垂，浅黄色，具红褐色斑点或小方格；花被片长3.2-4.5cm，宽1.2-1.5cm，内三片比外三片稍长而宽；雄蕊长约为花被片的一半，花丝不具小乳突；柱头裂片长约1mm。蒴果棱上的翅宽约1mm，宿存花被常多少包住蒴果。花期6-7月，果期8-9月。 4.甘肃贝母 多年生草本，高20-40cm。鳞茎圆锥形，由2枚鳞片组成，直径6-13mm。叶通常最下面的2枚对生，上面的2-3枚散生；叶片条形，长3-7cm，宽3-4mm，先端通常不卷曲。单花顶生，稀为2朵，浅黄色，有黑紫色斑点；叶状苞片1枚，先端稍卷曲或不卷曲；花被片长2-3cm，内3片宽6-7mm，蜜腺窝不很明显；雄蕊长约为花被片的一半；花丝具小乳突；柱头裂片长不及1mm。蒴果棱上具宽约1mm的窄翅。花期6-7月，果期8月。 5.康定贝母 与卷叶贝母相似，但植株和鳞茎常较大。叶除最下面的1-2对为对生外，余多为散生，先端不卷曲。叶状苞片通常1枚，极少为3枚。花具明显的紫色方格斑。"}]},{"ID":"20240611144825-tre2e6q","Type":"NodeParagraph","Properties":{"id":"20240611144825-tre2e6q","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611144825-k1wi6jm","Type":"NodeParagraph","Properties":{"id":"20240611144825-k1wi6jm","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽温和气候，适宜生长在1600-3000m的高寒山区的小灌木林下及草丛中。选择土层深厚、腐殖质丰富的砂质壤土栽培。忌积水、高温。 栽培技术 用种子和鳞茎繁殖。种子繁殖：种子成熟时胚尚处于原胚阶段，需用腐殖土或锯木末层积贮藏于室内，温度10-15度进行后熟处理，保持一定温度，待种子有芽口时播种。坡地撒播平地条播条播幅度10-15cm，幅间距7-10cm。鳞茎繁殖：在果实成熟或政党枯苗后及时挖取，选鳞茎肥厚、无损伤的作种用，入选的种鳞茎在15度以下通风良好的室内或荫棚下，晾置1-2星期，待隐伤表面呈浅棕色后栽种。在畦上横向开平底沟，开一沟栽一沟，沟底先放基肥，再放入种鳞茎，行株距为（13-20）cm×（13-15）cm。 田间管理 防旱、防洪涝、防溅泥污染。现适宜栽培川贝的地方，多无灌溉条件，要采取覆盖地面减少蒸发，截流溶雪、溶冻水和防止暴雨溅泥。种子播种地第1、2年生长季枯苗后，须培土2-3cm，除第1年生长季不需追肥外，以后各年及鳞茎栽培，在出苗或展叶时，均需追厩肥或堆肥，并应及时除草。为保持土壤结构和良好的生产性能，可实施2茬贝母1茬大麻轮作，麻根留槎或拔除，麻秆作覆盖材料后再翻入土壤。 病虫害防治 病害有锈病，出苗期，每2-3星期用粉锈宁1000倍液喷洒1次。白腐病，用50%多菌灵1000倍液浸种。日灼病，雨季来临前用稿秆碎节覆盖，防溅泥土，发现叶片等处被泥土污染，应及时冲洗。虫害有金针虫、蛴螬、地老虎。"}]},{"ID":"20240611144825-5w0oys8","Type":"NodeParagraph","Properties":{"id":"20240611144825-5w0oys8","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611144825-5bnbj5h","Type":"NodeParagraph","Properties":{"id":"20240611144825-5bnbj5h","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 暗紫贝母、卷叶贝母、甘肃贝母的鳞茎，按性状不同分别习称“松贝”和“青贝”，棱砂贝母习称“炉贝” （1）松贝 呈类圆锥形或近球形，高0.3-0.8cm，直径0.3-0.9cm。表面类白色。外层鳞叶2瓣，大小悬殊，大瓣紧抱小瓣，未抱部分呈新月形，习称“杯中抱月；”顶部闭合，内有类圆柱形、顶端稍尖的心芽和小鳞叶1-2枚；先端钝圆或稍尖，底部平，微凹入，中心有1灰褐色的鳞茎盘，偶有残厚须根。质根而脆，断面白色，富粉性。气微，味微苦。 （2）青贝 呈类扁球形，高0.4-1.4cm，直径0.4-1.6cm。外层鳞叶2瓣，大小相近，相对抱合，顶部开裂，内有心芽和小鳞叶2-3枚及细圆柱形的残茎。 （3）炉贝 呈长圆锥形，高0.7-2.5cm，直径0.5-2.5cm。表面类白色或浅棕黄色，有的具棕色斑点。外层鳞叶2瓣，大小相近，顶部开裂略尖，基部稍尖或较钝。 显微鉴别 粉末特征：（1）暗紫贝母 类白色。①淀粉粒极多。单粒三角状卵形、灯泡形、广卵形、贝壳形、不规则4-7边形等，边缘略凹凸不平，直径4-60μm，长约56（-64）μm，脐点点状、人字形、短缝状，层纹细密；复粒少数，2-3分粒组成；半复粒较多，脐点的单粒。②气孔类圆形，直径40-52μm，副卫细胞5-7个。表皮细胞较大，略延长，垂周壁波状弯曲；有少数草酸钙细小方晶。 （2）卷叶贝母 类白色。淀粉粒单粒多呈圆三角状卵形、类贝壳形或广卵形，直径5-56μm，长约至51μm，脐点偶见，细点状或短缝状，层纹细密；复粒稀少，2-4分粒组成；2脐点的单粒偶见。 （3）棱砂贝母 类白色。淀粉粒单粒呈广卵形、梨形、盾形，有的边缘凹凸不平，直径5-54μm，长约至66（-76）μm，脐点人字形、线形、马蹄形或三叉状，层纹明显，复粒2-5分粒组成；半复粒脐点2-5；2-5脐点单粒较多见。 （4）甘肃贝母 类白色。淀粉粒单粒圆三角形、三角状卵形、类圆形、泡形、类方形等，直径约至49μm，长约至56μm，少数边缘微凹凸，脐点人字形、马蹄形、大字形、星状、三叉状、点状、裂缝状，层纹不甚明显；复粒偶见，2（-3）分粒组成；半复粒多见，脐点2-8；2-8脐点单粒少见。 商品规格 商品川贝 松贝分两等，青贝分四等，炉贝分两等。 松贝 一等：类圆锥形或近球形，鳞瓣2，大瓣紧抱小瓣，未抱部分呈新月形，顶端闭口，基部底平。味甘微苦。每50g在240粒以外，无黄贝、油贝、碎贝。二等：顶端闭口或开口，基部平底或近似平底。每50g在240粒以内。间有黄贝、油贝、碎贝、破贝，余同一等。 青贝 一等：扁球形或类圆形，两鳞片大小相似。顶端闭口或微开口，基部较平或圆形。表面白色。味淡微苦。每50g在190粒以外。对开瓣不超过20%。无黄贝、油贝、碎贝。二等：第50g在130粒以外。对开瓣不超过25%。间有花油贝、花黄贝，不超过5%。无全黄贝、油贝、碎贝。余同一等。三等：每50g在100粒以外。对开瓣不超过30%，间有油贝、碎贝、黄贝不超5%。余同二等。四等：顶端闭口或开口较多。大小粒不分。兼有油贝、碎贝、黄贝、余同一等。"}]},{"ID":"20240611144825-nssxbi4","Type":"NodeParagraph","Properties":{"id":"20240611144825-nssxbi4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611144825-kzkdpt2","Type":"NodeParagraph","Properties":{"id":"20240611144825-kzkdpt2","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 小鼠ig组培川贝和野生川贝混悬液，8.0g/kg为可能用的最大剂量，观察1周，小鼠一切活动正常，均未出现死亡。平贝母总碱小鼠iv的LD50为84.2mg/kg，ip为148.4mg/kg。亚急性毒性：小鼠36只，均分为3组，给药组（2，3组）分别sc总碱0.3、0.15mg/10g（分别相当于LD50的1/5和1/10），对照组给同体积的生理盐水，每日给药1次，隔日称1次体重，给药3周后处死，检查血象、肝功、肾功，每组取5只做心、肝、脾、肺、肾的病理切片。结果表明，总碱对小鼠的血象、肝功、肾功，以及各脏器均未见影响。"}]},{"ID":"20240611144825-b30gf4q","Type":"NodeParagraph","Properties":{"id":"20240611144825-b30gf4q","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611144825-oehb3tz","Type":"NodeParagraph","Properties":{"id":"20240611144825-oehb3tz","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 1.暗紫贝母 鳞茎含生物碱：松贝辛（songbeisine），松贝甲素（sonbeinine）。还含蔗糖（sucrose），硬脂酸（stearic acid），棕榈酸（palmitic acid），β-谷甾醇（β-sitosterol）。 2.卷叶贝母 鳞茎含生物碱：川贝碱（fritimine），西贝素（sipeimine）。 3.棱砂贝母 鳞茎含生物碱：棱砂贝母碱（delavine），棱砂贝母酮碱（delavinone），川贝酮碱（chuanbeinone），棱砂贝母芬碱（delafrine），棱砂贝母芬酮碱（delafrinone），（22R，25S）-5-茄啶-烯-3β，5α，6β-三醇〔（22R，25S）-solanid-5-en-3β，5α，6β-triol〕，贝母辛碱（peimissine），西贝母碱（imperialine）即是西贝素，川贝碱，炉贝碱（fritiminine）。"}]},{"ID":"20240611144825-aveo5qd","Type":"NodeParagraph","Properties":{"id":"20240611144825-aveo5qd","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611144825-o479qlt","Type":"NodeParagraph","Properties":{"id":"20240611144825-o479qlt","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 1.对呼吸系统的作用：1.1镇咳作用：小鼠氨水引咳法证明，ig贝母总生物碱及非生碱部分均有镇咳作用。小鼠ig家种及野生川贝母流浸膏，则无明显镇咳作用。小鼠二氧化硫引咳法表明，贝母生物碱亦无明显镇咳作用。Ig贝母一皂甙Ⅱ号，能使小鼠咳嗽潜伏期明显延长。采用小鼠氨水引咳法，发现组织培养川贝和野生川贝均具有显着的镇咳作用，给药后（3.0g/kgig）30分钟作用较强，止咳率大于50%，在60分钟时两种川贝作用均己下降，但直至2小时药物仍有显着作用。选镇咳作用较强的30分钟，按1.5g/kg及3.0g/kg给药，发现组培川贝和野生川贝一样，止咳效果随剂量加大而增强。"}]},{"ID":"20240611144825-tzw9rwj","Type":"NodeParagraph","Properties":{"id":"20240611144825-tzw9rwj","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"1.2祛痰作用：采用小鼠酚红排泌法，以3.9g/kg（ig）剂量作时效曲线，分别在给药后30、60、120分钟立即ip0.25%酚红（（0.2ml/10g），按分光光度法测558nm处吸收度。结果表明，组培川贝和野生川贝均具有祛痰作用，给药60分钟后为作用峰值，给药2小时后作用下降。选时效峰值时间60分钟，按1.5g/kg及3.0g/kg给药，结果表明，两种川贝的祛痰效果均随剂量加大而增强。其它小鼠服用30g/kg川贝母煎剂，药后60分钟与药前比较，痛阈降低。"}]},{"ID":"20240611144825-kp3hhvz","Type":"NodeParagraph","Properties":{"id":"20240611144825-kp3hhvz","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"2.抗溃疡作用2.1对大鼠结扎幽门性溃疡的影响：大鼠断食48h后麻醉、开腹，结扎胃幽门，缝合腹壁后sc平贝总生物碱（简称总碱）3、1.5mg/100g，对照组用等体积生理盐水。给药后9小时断头处死，收集胃液，同时测定胃液量，游离酸，总酸及胃蛋白酶活性，并用肉眼观察溃疡形成情况。结果两种剂量对胃蛋白酶有显着的抑制作用，与对照组比较P＜0.01，1.5mg/100g组的溃疡指数亦显着低于对照组P＜0.01。"}]},{"ID":"20240611144825-7vrw0ou","Type":"NodeParagraph","Properties":{"id":"20240611144825-7vrw0ou","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"2.2对应激性溃疡的影响：采用上述剂量，观察对应激性溃疡大鼠的溃疡指数。结果1.5mg/100g组有明显的抑制作用，与生理盐水对照组比较P＜0.05。"}]},{"ID":"20240611144825-3qkbm07","Type":"NodeParagraph","Properties":{"id":"20240611144825-3qkbm07","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"2.3对消炎痛所致胃溃疡的影响：大鼠按上述剂量ip给药后各组均ip消炎痛40mg/kg，给药后处死，取胃观察溃疡程度。结果3.0mg/100g的总碱对消炎痛所致的胃溃疡有抑制作用，与对照组比较P＜0·01。"}]},{"ID":"20240611144825-c76f8zn","Type":"NodeParagraph","Properties":{"id":"20240611144825-c76f8zn","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"3.其它作用 川贝母碱静脉注射对麻醉猫产生持久的血压下降，伴以短时呼吸抑制，能增强豚鼠离体子宫收缩，抑制离体兔肠，并无扩大瞳孔的作用。对小鼠的最小致死量为40mg/公斤，死前有痉挛，还引起家兔血糖升高。"}]},{"ID":"20240611144825-h3bixl0","Type":"NodeParagraph","Properties":{"id":"20240611144825-h3bixl0","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"西贝母碱对麻醉狗有降压作用，主要由于外周血管扩张，对心电图无明显影响。对离体豚鼠回肠、兔十二指肠、大鼠子宫及整体狗小肠均有明显松弛作用，解痉作用类似罂粟碱。"}]},{"ID":"20240611144825-2q2vtjh","Type":"NodeParagraph","Properties":{"id":"20240611144825-2q2vtjh","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"贝母素丙（川贝母素，fritimine）4mg/kg静脉注射，能吏麻醉猫产生持久性血压下降，伴以短暂的呼吸抑制；7.5-16mg/kg静脉注射，能使兔血糖升高；1：50000浓度能使离体豚鼠子宫收缩，1:100000浓度能抑制离体兔肠的运动；对小鼠的最小致死量为40mg/kg。"}]},{"ID":"20240611144825-y1tesxw","Type":"NodeParagraph","Properties":{"id":"20240611144825-y1tesxw","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"平贝母浸膏对实验动物具有中枢神经系统抑制作用。"}]},{"ID":"20240611144825-ezntxe2","Type":"NodeParagraph","Properties":{"id":"20240611144825-ezntxe2","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611144825-5cf3z71","Type":"NodeParagraph","Properties":{"id":"20240611144825-5cf3z71","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，用水稍泡，捞出，闷润，剥去心，晒干。1.《雷公炮炙论》：凡使贝母先于柳木灰中炮令黄，摩破，去内口鼻上有米许大者心一小颗后，拌糯米于？上同炒，待米黄熟，然后去米取出。2.《本草述钩元》：姜汁泡，去心，"}]},{"ID":"20240611144825-8x2my7l","Type":"NodeParagraph","Properties":{"id":"20240611144825-8x2my7l","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611144825-y3bhqz4","Type":"NodeParagraph","Properties":{"id":"20240611144825-y3bhqz4","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 归肺；心经"}]},{"ID":"20240611144825-w2asp0v","Type":"NodeParagraph","Properties":{"id":"20240611144825-w2asp0v","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611144825-ptk02uw","Type":"NodeParagraph","Properties":{"id":"20240611144825-ptk02uw","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 味甘、苦；性微寒"}]},{"ID":"20240611144825-03oyna6","Type":"NodeParagraph","Properties":{"id":"20240611144825-03oyna6","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611144825-by1ogca","Type":"NodeParagraph","Properties":{"id":"20240611144825-by1ogca","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒及寒痰、湿痰者慎服。反乌头。"}]},{"ID":"20240611144825-okdjfbp","Type":"NodeParagraph","Properties":{"id":"20240611144825-okdjfbp","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611144825-s7o11s7","Type":"NodeParagraph","Properties":{"id":"20240611144825-s7o11s7","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 清热润肺；化痰止咳；散结消肿。主肺虚；久咳；虚劳咳嗽；燥热咳嗽；肺痈；瘰疬；痈肿；乳痈"}]},{"ID":"20240611144825-4fx8js2","Type":"NodeParagraph","Properties":{"id":"20240611144825-4fx8js2","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611144825-gkx8i6z","Type":"NodeParagraph","Properties":{"id":"20240611144825-gkx8i6z","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；研末，1-1.5g；或入丸、散。外用：适量，研末撒；或调敷"}]},{"ID":"20240611144825-bxfyf2o","Type":"NodeParagraph","Properties":{"id":"20240611144825-bxfyf2o","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611144825-vvl37cz","Type":"NodeParagraph","Properties":{"id":"20240611144825-vvl37cz","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 《本草别说》：能散心胸郁结之气 贝母，治心中气不快多愁郁者殊有功。王好古：贝母，乃肺经气分药也，仲景治寒实结胸，外无热证者，三物小陷胸汤主之，白散亦可，以其内有贝母也。成无己云：辛散而苦泄，桔梗、贝母之苦辛，用以下气。"}]},{"ID":"20240611144825-x2vrlub","Type":"NodeParagraph","Properties":{"id":"20240611144825-x2vrlub","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《本草会编》：俗以半夏有毒，用贝母代之，夫贝母乃大阴肺经之药，半夏乃太阴脾经、阳明胃经之药，何可以代?若虚劳咳嗽，吐血咯血，肺痿、肺痈，妇人乳痈、痈疽及诸郁之证，半夏乃禁忌，皆贝母为向导，犹可代也。至于脾胃湿热，涎化为痰，久则生火，痰火上攻，香愦、僵仆、蹇涩诸证，生死旦夕，亦岂贝母可代乎？《本草经疏》：贝母，肺有热，因而生痰，或为热邪所干，喘嗽烦闷，必此主之，其主伤寒烦热者，辛寒兼苦，能解除烦热故也。淋沥者，小肠有热也，心与小肠为表里，清心家之烦热，则小肠之热亦解矣。邪气者、邪热也，辛以散结，苦以泄邪，寒以折热，故主邪气也。《经》曰：一阴一阳结为喉痹，一阴者少阴君火也，一阳者少阳相火也，解少阴少阳之热，除胸中烦热，则喉痹自愈矣。乳难者，足厥阴、足阳明之气结滞而不通，辛能散结气，通其结滞，则乳难自瘳。热解则血凉，血凉则不痛，故主金疮。热则生风，故主风痉。"}]},{"ID":"20240611144825-7mzq868","Type":"NodeParagraph","Properties":{"id":"20240611144825-7mzq868","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《别录》又疗腹中结实，心下满，洗洗恶风寒者，肺主皮毛也。目眩者，热上攻也。项直，即风痉也。咳嗽上气，气上逆也。烦热渴邪不解，汗不出者，邪热盛也。其性专能散结除热，则上来诸证，皆自愈矣。病去则五脏自安。骨髓自利也。《别录》：疗腹中结实，心下满，洗洗恶风寒，目眩，项直，咳嗽上气，止烦热渴，出汗，安五脏，利骨髓。"}]},{"ID":"20240611144825-ojjvfo5","Type":"NodeParagraph","Properties":{"id":"20240611144825-ojjvfo5","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《药性论》：治虚热，主难产作末服之；兼治胞衣不出，取七枚末，酒下；末，点眼去肤翳；主胸胁逆气，疗时疾黄疸，与连翘同主项下瘤瘿疾。"}]},{"ID":"20240611144825-dg30o5n","Type":"NodeParagraph","Properties":{"id":"20240611144825-dg30o5n","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《本草汇言》：贝母，开郁、下气、化痰之药也。润肺消痰，止咳定喘，则虚劳火结之证，贝母专司首剂。故配知母，可以清气滋阴；配芩、连可以清痰降火；配耆参可以行补不聚；配归、芍可以调气和营；又配连翘可解郁毒，治项下瘿核；配二陈代半夏用，可以补肺消痰、和中降火者也。以上修用，必以川者为妙。若解痈毒，破症结，消实痰，敷恶疮，又以土者为佳。然川者味淡性优，土者味苦性劣，二者以分别用。"}]},{"ID":"20240611144825-iynp0rq","Type":"NodeParagraph","Properties":{"id":"20240611144825-iynp0rq","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《本草正》：半夏、贝母，俱治痰嗽。但半夏兼治脾肺，贝母独善清金。半夏用其辛，贝母用其苦；半夏用其温，贝母用其凉；半夏性速，贝母性缓；半夏散寒，贝母清热；性味阴阳，大有不同。俗有代用者，其谬孰甚。......降胸中因热结胸及乳痈流痰结核。"}]},{"ID":"20240611144825-m1zuvtv","Type":"NodeParagraph","Properties":{"id":"20240611144825-m1zuvtv","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《药品化义》：贝母，味苦能下降，微辛能散郁，气味俱清，故用入心肺，主治郁痰、虚痰、热痰及痰中带血，虚劳咳嗽，胸膈逆气，烦渴热甚，此导热下行，痰气自利也。取其下利则毒去，散气则毒解，用疗肺痿、肺痈、瘿瘤痰核、痈疽疮毒，此皆开郁散结，血脉流通之功也。又取其性凉能降，善调脾气，治胃火上炎，冲逼肺金，致痰嗽不止，此清气滋阴，肺部自宁也。"}]},{"ID":"20240611144825-ouk9ivi","Type":"NodeParagraph","Properties":{"id":"20240611144825-ouk9ivi","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《长沙药解》：贝母苦寒之性，泄热凉金，降浊消痰，其力非小，然清金而不败胃气，甚可嘉焉。"}]},{"ID":"20240611144825-4tvhf4m","Type":"NodeParagraph","Properties":{"id":"20240611144825-4tvhf4m","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《本经》：主伤寒烦热，淋沥邪气，疝瘕，喉痹，乳难，金疮风痉。"}]},{"ID":"20240611144825-4e7xm4f","Type":"NodeParagraph","Properties":{"id":"20240611144825-4e7xm4f","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《日华子本草》：消痰，润心肺。末，和砂糖为丸含，止嗽；烧灰油敷人畜恶疮。"}]},{"ID":"20240611144825-ryxswxh","Type":"NodeParagraph","Properties":{"id":"20240611144825-ryxswxh","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"《本草述》：疗肿瘤疡，可以托里护心，收敛解毒。"}]},{"ID":"20240611144825-fmasueu","Type":"NodeParagraph","Properties":{"id":"20240611144825-fmasueu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611144825-ywr5asu","Type":"NodeParagraph","Properties":{"id":"20240611144825-ywr5asu","updated":"20240611144825"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611144826-bw58q0i","Type":"NodeThematicBreak","Properties":{"id":"20240611144826-bw58q0i"}},{"ID":"20240611144827-k9hj9kw","Type":"NodeParagraph","Properties":{"id":"20240611144827-k9hj9kw"}}]}