:"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏 6-20240822101138-uxrr1eb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 481px;\" parent-style=\"width: 491px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717193521-k6t765s","Type":"NodeParagraph","Properties":{"id":"20240717193521-k6t765s","updated":"20240822101213"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 402px;","style":"width: 392px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"半夏 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏 1-20240822100657-99dh9it.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 392px;\" parent-style=\"width: 402px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 795px;","style":"width: 785px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"半夏"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏-20240717193521-d6si941.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 785px;\" parent-style=\"width: 795px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822101207-9w8n3vo","Type":"NodeParagraph","Properties":{"id":"20240822101207-9w8n3vo","updated":"20240822101212"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"半夏 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏 4-20240822101001-wc3hm5p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 760px;","style":"width: 750px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"半夏3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏3-20240627173201-pvj90yh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 750px;\" parent-style=\"width: 760px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822101257-ngfovii","Type":"NodeParagraph","Properties":{"id":"20240822101257-ngfovii","updated":"20240822101257"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 401px;","style":"width: 391px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"半夏 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏 7-20240822101257-zsvvrxb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 391px;\" parent-style=\"width: 401px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 793px;","style":"width: 783px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"半夏2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/半夏2-20240627173733-ohs5mcu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 783px;\" parent-style=\"width: 793px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612165511-vtrsqeh","Type":"NodeParagraph","Properties":{"id":"20240612165511-vtrsqeh","updated":"20240627173352"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：半夏用的是根部的块茎，非种子。"}]},{"ID":"20240612165530-2woz5ec","Type":"NodeThematicBreak","Properties":{"id":"20240612165530-2woz5ec"}},{"ID":"20240612165651-mmpaocd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165651-mmpaocd","updated":"20240612165655"},"Children":[{"Type":"NodeText","Data":"半夏《神农本草经》"}]},{"ID":"20240612165651-25c0nh3","Type":"NodeParagraph","Properties":{"id":"20240612165651-25c0nh3","updated":"20240612165651"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240612165651-li78dkb","Type":"NodeParagraph","Properties":{"id":"20240612165651-li78dkb","updated":"20240612165651"},"Children":[{"Type":"NodeText","Data":"主伤寒，寒热，心下坚，下气，喉咽肿痛，头眩胸张，咳逆肠鸣，止汗。一名地文，一名水玉（已上八字，元本黑字）。生川谷。"}]},{"ID":"20240612165651-27mp9rf","Type":"NodeParagraph","Properties":{"id":"20240612165651-27mp9rf","updated":"20240612165651"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：半夏一名和姑，生微邱，或生野中，叶三三相偶，二月始生，白华员上（《御览》）。"}]},{"ID":"20240612165651-cub3jqm","Type":"NodeParagraph","Properties":{"id":"20240612165651-cub3jqm","updated":"20240612165651"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名示姑，生槐里，五月、八月，采根暴干。"}]},{"ID":"20240612165651-uf4xk0l","Type":"NodeParagraph","Properties":{"id":"20240612165651-uf4xk0l","updated":"20240612165651"},"Children":[{"Type":"NodeText","Data":"案月令云：二月半夏生。《范子计然》云：半夏出三辅，色白者善。《列仙传》云：赤松子服水玉以教神农，疑即半夏别名。"}]},{"ID":"20240612165530-y8byfz0","Type":"NodeThematicBreak","Properties":{"id":"20240612165530-y8byfz0"}},{"ID":"20240612165640-3nnuqm4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165640-3nnuqm4","updated":"20240612165646"},"Children":[{"Type":"NodeText","Data":"半夏《本草纲目》"}]},{"ID":"20240612165640-5t64plg","Type":"NodeParagraph","Properties":{"id":"20240612165640-5t64plg","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"「释名」守田、水玉、地文、和姑。"}]},{"ID":"20240612165640-p4xb1s3","Type":"NodeParagraph","Properties":{"id":"20240612165640-p4xb1s3","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、平、有毒。"}]},{"ID":"20240612165640-yexsyx9","Type":"NodeParagraph","Properties":{"id":"20240612165640-yexsyx9","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612165640-icurbtb","Type":"NodeParagraph","Properties":{"id":"20240612165640-icurbtb","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"1、老人风痰。用半夏（泡七次，焙过）、硝石各半两，共研为末，加入白面捣匀，调水做成丸子，如绿豆大。每服五十丸，姜汤送下。"}]},{"ID":"20240612165640-bqny5k0","Type":"NodeParagraph","Properties":{"id":"20240612165640-bqny5k0","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"2、风痰头晕（哎逆目眩，面色黄，脉弦）。用生半夏、生天南星、寒水石（煅）各一两，天麻半两，雄黄二钱，小麦面三两，共研为末，加水和成饼，水煮浮起，取出捣烂做成丸子，如梧子大。每服五十丸，姜汤送下。极效。亦治风痰咳嗽、二便不通、风痰头痛等病。"}]},{"ID":"20240612165640-8mtaq1y","Type":"NodeParagraph","Properties":{"id":"20240612165640-8mtaq1y","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"3、热痰咳嗽（烦热面赤，口燥心痛，脉洪数）。用半夏、天南星各一两，黄芩一两半，共研为末，加姜汁浸蒸饼做成丸子，如梧子大。每服五十至七十丸，饭后服，姜汤送下。此方名“小黄丸”。"}]},{"ID":"20240612165640-emws1v8","Type":"NodeParagraph","Properties":{"id":"20240612165640-emws1v8","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"4、湿痰咳嗽（面黄体重，贪睡易惊，消化力弱，脉缓）。用半夏、天南星各一两，白术一两半，共研为末加薄糊做成丸子，如梧子大。每服五十至七十丸姜汤送下。此方名“白术丸”。"}]},{"ID":"20240612165640-mdwlpqq","Type":"NodeParagraph","Properties":{"id":"20240612165640-mdwlpqq","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"5、气痰咳嗽（面白气促，洒淅恶寒，忧悉不乐，脉涩）。用半夏、天南星各一两，官桂半两，共研为末，加糊做成丸子，如梧子大。每服五十丸，姜汤送下。此方名“玉粉丸”。"}]},{"ID":"20240612165640-ijswkrz","Type":"NodeParagraph","Properties":{"id":"20240612165640-ijswkrz","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"6、呕吐反胃。用半夏三升、人参三两、白蜜一升、水一半二千，细捣过，煮成三升半，温服一升。一天服两次。此方名为“大半夏汤”。"}]},{"ID":"20240612165640-4krhc6o","Type":"NodeParagraph","Properties":{"id":"20240612165640-4krhc6o","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"7、黄疸喘满，小便自利，不可除热。用半夏、生姜各半斤，加水七升，煮取一升五合，分两次服下。"}]},{"ID":"20240612165640-jmz32hd","Type":"NodeParagraph","Properties":{"id":"20240612165640-jmz32hd","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"8、老人便结。用半夏（泡，炒）、生硫磺，等分为末加自然姜汁煮糊做成丸子，如梧子大。每服五十丸，空心服，温酒送下。此方名“半硫丸”。"}]},{"ID":"20240612165640-0akkzqa","Type":"NodeParagraph","Properties":{"id":"20240612165640-0akkzqa","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"9、失血喘急（吐血下血，崩中带下，喘急痰呕，中满宿瘀）。用半夏捶扁，包在以姜汁调匀的面中，放火上煨黄，研为末，加米糊成丸子，如梧子大。每服三十丸，白开水送下。"}]},{"ID":"20240612165640-sgmhzko","Type":"NodeParagraph","Properties":{"id":"20240612165640-sgmhzko","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"10、喉痹肿塞。用生半夏末鼻内，涎出见效。"}]},{"ID":"20240612165640-uklgv21","Type":"NodeParagraph","Properties":{"id":"20240612165640-uklgv21","updated":"20240612165640"},"Children":[{"Type":"NodeText","Data":"11、骨鲠在咽。用半夏、白牙，等分为末，取一匙，水冲服，当呕出。忌食羊肉。"}]},{"ID":"20240612165717-p9jujel","Type":"NodeThematicBreak","Properties":{"id":"20240612165717-p9jujel"}},{"ID":"20240612165718-f3588xu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165718-f3588xu","updated":"20240612165722"},"Children":[{"Type":"NodeText","Data":"半夏《本草经解》"}]},{"ID":"20240612165718-dbfb05o","Type":"NodeParagraph","Properties":{"id":"20240612165718-dbfb05o","updated":"20240612165718"},"Children":[{"Type":"NodeText","Data":"气平．味辛．有毒．主伤寒寒热心下坚．胸胀咳逆头眩．咽喉肿痛．肠鸣．下气．止汗．（汤浸去涎净姜汁拌焙）"}]},{"ID":"20240612165718-ropufnz","Type":"NodeParagraph","Properties":{"id":"20240612165718-ropufnz","updated":"20240612165718"},"Children":[{"Type":"NodeText","Data":"半夏气平．禀天秋燥之金气．入手太阴肺经．味辛有毒．得地西方酷烈之金味．入足阳明胃经、手阳明大肠经．气平味升．阳也．主伤寒寒热心下坚者．心下脾肺之区．太阴经行之地也．病伤寒寒热而心下坚硬．湿痰在太阴也．半夏辛平．消痰去湿．所以主之．胸者肺之部也．胀者气逆也．半夏辛平．辛则能开．平则能降．所以主之也．咳逆头眩者．痰在肺．则气不下降．气逆而头眩晕也．东垣曰．太阴头痛．必有痰也．半夏辛平消痰．所以主之．咽喉太阴经行之地．火结则肿痛．其主之者．辛能散结．平可下气．气下则火降也．肠鸣者．大肠受湿．则肠中切痛．而鸣濯濯也．辛平燥湿．故主肠鸣．下气者．半夏入肺．肺平则气下也．阳明之气本下行．上逆则汗自出矣．平能降气．所以止汗也．"}]},{"ID":"20240612165718-pp4r9re","Type":"NodeParagraph","Properties":{"id":"20240612165718-pp4r9re","updated":"20240612165718"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612165718-u7vxt74","Type":"NodeParagraph","Properties":{"id":"20240612165718-u7vxt74","updated":"20240612165718"},"Children":[{"Type":"NodeText","Data":"半夏同黄连、栝蒌实．名小陷胸汤．治心下坚．同甘草、防风、生姜．治痰厥中风．同神曲、南星、白术、枳实、姜汁．治风痰湿痰．同甘草．治风痰喘急．同黄芩、姜汁．治上焦热痰．同白芍、甘草、黄芩．治身热吐泻．同瓜仁．治肺热咳．同陈皮．治痰饮．同白茯．治水饮．同人参．治反胃．同白茯、甘草丸．名消暑丸．治伏暑．同人参、白茯、白术、甘草、陈皮．名六君子汤．治脾湿生痰．不思饮食．"}]},{"ID":"20240612165825-d3k5pjt","Type":"NodeThematicBreak","Properties":{"id":"20240612165825-d3k5pjt"}},{"ID":"20240612165826-i9azqg4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165826-i9azqg4","updated":"20240612165830"},"Children":[{"Type":"NodeText","Data":"半夏《本草崇原》"}]},{"ID":"20240612165826-gnz90mc","Type":"NodeParagraph","Properties":{"id":"20240612165826-gnz90mc","updated":"20240612165826"},"Children":[{"Type":"NodeText","Data":"气味辛平，有毒。主治伤寒寒热，心下坚，胸胀咳逆，头眩，咽喉肿痛，肠鸣，下气，止汗。"}]},{"ID":"20240612165826-axilkf1","Type":"NodeParagraph","Properties":{"id":"20240612165826-axilkf1","updated":"20240612165826"},"Children":[{"Type":"NodeText","Data":"（半夏青齐江浙在处有之。二月生苗，一茎高八九寸，茎端三叶，三三相偶，略似竹叶，其根圆白，五月八月采根晒干，不厌陈久。）"}]},{"ID":"20240612165826-s7i1tyb","Type":"NodeParagraph","Properties":{"id":"20240612165826-s7i1tyb","updated":"20240612165826"},"Children":[{"Type":"NodeText","Data":"《月令》∶五月半夏生，盖当夏之半也。《脉解篇》云∶阳明者，午也。五月盛阳之阴也，半夏生当夏半，白色味辛，禀阳明燥金之气化。主治伤寒寒热者，辛以散之也。阳明胃络上通于心，胃络不通于心，则心下坚。胸者，肺之部，阳明金气上合于肺。金气不和于肺，则胸胀咳逆。半夏色白属金，主宣达阳明之气，故皆治之。金能制风，故治头眩，以及咽喉肿痛。燥能胜湿，故治肠鸣之下气而止汗也。"}]},{"ID":"20240612165933-illww14","Type":"NodeThematicBreak","Properties":{"id":"20240612165933-illww14"}},{"ID":"20240612165934-t0rbdbs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165934-t0rbdbs","updated":"20240612165938"},"Children":[{"Type":"NodeText","Data":"半夏《药性切用》"}]},{"ID":"20240612165934-lmwtv7c","Type":"NodeParagraph","Properties":{"id":"20240612165934-lmwtv7c","updated":"20240612165934"},"Children":[{"Type":"NodeText","Data":"辛温性燥，入脾胃而化痰止呕，燥湿醒脾。生姜汁制透用。半夏曲∶以半夏末入面作盒生黄衣，性稍和缓，能治血虚伏湿之痰。霞天曲∶以霞天膏渣入半夏末和造龛成，能虚沉痼之痰。霞天膏∶以嫩黄牛肉煮取净汁煎炼成膏，大补中虚羸弱。按∶南星、半夏燥药，但南星治风痰，半夏治湿痰，为不同。"}]},{"ID":"20240612165943-vggul81","Type":"NodeThematicBreak","Properties":{"id":"20240612165943-vggul81"}},{"ID":"20240612165944-dqmjlr9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165944-dqmjlr9","updated":"20240612165953"},"Children":[{"Type":"NodeText","Data":"半夏《本草图经》"}]},{"ID":"20240612165944-r92gvji","Type":"NodeParagraph","Properties":{"id":"20240612165944-r92gvji","updated":"20240612165948"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏"},{"Type":"NodeText","Data":"，生槐里川谷，今在处有之，以齐州者为佳。二月生苗，一茎，茎端出三叶，浅绿色，颇似竹叶而光，江南者似芍药叶；根下相重生，上大下小，皮黄肉白；五月、八月内采根，以灰 二日，汤洗曝干。一云∶五月采者虚小，八月采者实大，然以圆白陈久者为佳。其平泽生者甚小，名羊眼半夏。又由跋绝类半夏，而苗高近一、二尺许，根如鸡卵，大多生林下，或云即虎掌之小者，足以相乱。半夏主胃冷呕哕，方药之最要。张仲景治反胃呕吐，大半夏汤。半夏三升，人参三两，白蜜一升，以水一斗二升，和扬之一百四十遍，煮取三升半，温服一升，日再。亦治膈间支饮。又主呕哕，谷不得下，眩悸，半夏加茯苓汤。半夏一升，生姜半斤，茯苓三两，切，以水七升，煎取一升半，分温服之。又主心下悸，半夏麻黄丸，二物等分，筛末，蜜丸，大如小豆，每服三丸，日三。其余主寒厥，赤风，四逆，呕吐。附子粳米汤，及伤寒方。用半夏一升，洗去滑，焙干，捣末，小麦面一升，合和，以水搜令熟，丸如弹丸，以水煮令面熟，则药成。初吞四、五枚，日二稍稍增至十五枚，旋煮旋服，觉病减，欲更重合亦佳。禁食饧与羊肉。"}]},{"ID":"20240612170025-zgmiibe","Type":"NodeThematicBreak","Properties":{"id":"20240612170025-zgmiibe"}},{"ID":"20240612170026-e7y3vdz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170026-e7y3vdz","updated":"20240612170031"},"Children":[{"Type":"NodeText","Data":"半夏《本草便读》"}]},{"ID":"20240612170026-rocg1l5","Type":"NodeParagraph","Properties":{"id":"20240612170026-rocg1l5","updated":"20240612170026"},"Children":[{"Type":"NodeText","Data":"性温体滑．入阳明并走心脾．质燥味辛．治呕吐专消痰饮．通阴阳而和胃．不寐堪医．散逆气以调中．郁邪可解．痰厥头疼当取服．中风暴卒急宜求．辛润通肠．半硫主津凝虚闭．温宣消痞．制法系姜汁青盐．（半夏味辛．质滑．性温．有小毒．善劫痰水．导大便．痰水去则土燥．脾喜燥而恶湿．故宜之．味辛善散逆结之气．故能解郁调中．为治呕吐蠲饮邪之圣药．总之脾有湿邪者宜用．若阴虚血燥之人当为禁服．）"}]},{"ID":"20240612170041-sfiudnh","Type":"NodeThematicBreak","Properties":{"id":"20240612170041-sfiudnh"}},{"ID":"20240612170043-jb4afic","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170043-jb4afic","updated":"20240612170047"},"Children":[{"Type":"NodeText","Data":"半夏《顾松园医镜》"}]},{"ID":"20240612170043-crbfxwm","Type":"NodeParagraph","Properties":{"id":"20240612170043-crbfxwm","updated":"20240612170043"},"Children":[{"Type":"NodeText","Data":"〔辛温有毒，入脾、胃、心、胆四经。反乌头，忌羊血饧糖。洗净滑液，姜汁炒。〕治痰饮之咳嗽，〔寒痰、湿痰，或因留饮致咳，宜用之，若阴虚痰嗽者大忌。〕止胃冷之呕吐，〔因胃停积冷痰留饮致吐，宜用，若由胃热火冲而呕，则忌之。〕疗痰厥头痛眩晕，〔湿痰厥逆而上，则上实而为痛为眩为晕，此为对症，若因血虚火痰而致者，用之则误。〕除留饮胸满短气，〔膈有留饮湿聚则为满闷，射肺则为喘为咳，阻气不布，而为短气，此为的药；若非留饮满闷，阴虚气喘气短，投之立祸。〕燥湿消痰祛饮之要药。"}]},{"ID":"20240612170043-6w9ma4u","Type":"NodeParagraph","Properties":{"id":"20240612170043-6w9ma4u","updated":"20240612170043"},"Children":[{"Type":"NodeText","Data":"古人有三禁，谓血家、渴家、汗家是也。若无脾湿，且且有肺燥，误服半夏，悔不可追，谨之戒之。又有似中风热痰壅盛，此属阴虚者居多，大忌犯之，能堕胎，孕妇亦忌。每见世医，执丹溪言二陈汤治一身之痰，见痰即用，不知世之患燥痰甚多，惟此一味贻害不少，特表着误。"}]},{"ID":"20240612170105-562cfyt","Type":"NodeThematicBreak","Properties":{"id":"20240612170105-562cfyt"}},{"ID":"20240612170106-eygunca","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170106-eygunca","updated":"20240612170111"},"Children":[{"Type":"NodeText","Data":"半夏《本草择要纲目》"}]},{"ID":"20240612170106-3qv1xwi","Type":"NodeParagraph","Properties":{"id":"20240612170106-3qv1xwi","updated":"20240612170106"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612170106-nebuk5r","Type":"NodeParagraph","Properties":{"id":"20240612170106-nebuk5r","updated":"20240612170106"},"Children":[{"Type":"NodeText","Data":"辛平有毒．沉而降．阴中阳也．入手阳明太阴少阴三经．（凡采得以白芥子为末二两．酽醋三两．搅浊投半夏于内．浸洗去涎．涎若不尽．令人气逆．肝气怒满．又造曲法云．以半夏为主．入姜汁白矾．加以干面和搅作面．入楮叶包置篮中．候生黄衣．日干．久贮听用．极为良品．）"}]},{"ID":"20240612170106-n2fm6f8","Type":"NodeParagraph","Properties":{"id":"20240612170106-n2fm6f8","updated":"20240612170106"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240612170106-jmppy2s","Type":"NodeParagraph","Properties":{"id":"20240612170106-jmppy2s","updated":"20240612170106"},"Children":[{"Type":"NodeText","Data":"寒痰及形寒饮冷伤肺而咳嗽．脾胃湿．益脾胃之气．消肿散结．渴则忌之．但今人惟知半夏去痰不能益脾．孰知脾恶湿．湿则濡困．困则不能治水．半夏之性辛而能润．可使脾无留湿．湿去而土自燥．痰乃不生．其功之益脾何如也．又丹溪以二陈汤治一身之痰．庸医执之．概以有痰者．即以此方为对症之剂．岂知二陈汤唯风寒湿食之痰用之．乃宜至于劳痰失血用之．反能燥血．其所当禁用又何如也．又俗以半夏性燥有毒．多以贝母代之．岂知贝母乃太阴肺经之药．唯咳嗽吐痰．虚劳吐血．或痰中见血．诸郁咽痛喉痹．肺痈肺痿痈疽．妇人乳痈等症．此则宜以贝母为之向导．若涎者脾之液．美味膏粱炙爆．皆能生脾胃湿热．令涎化为痰．久则痰火上攻．使人昏愦口噤偏废僵仆蹇涩不语．自非半夏何以行湿利窍．通大便而泄小便．使脾为生痰之源．肺为贮痰之器．各得滑泽自安也．又俗言半夏入方药中．能泄痰之标．不能泄痰之本．岂知肾主五液化为五湿．自入为唾．入肝为泣．入心为汗．入脾为痰．入肺为涕．半夏能流湿润燥．无形之咳．有形之痰．悉能荡涤必清．其泄肾非泄痰之本乎．又俗言半夏之辛．只能入肺散气．岂知止呕吐为足阳明．除痰为足太阴之剂．如柴胡汤中用之．虽为止呕．亦能助柴胡黄芩之清凉．主寒热之往来．是又非足少阳阳明之对剂乎．然热痰佐以黄芩．风痰佐以南星．寒痰佐以干姜．痰痞佐以陈皮白术．多用则泻脾胃．诸血证及口渴者则禁用．是又在驱使者之得宜也．"}]},{"ID":"20240612165922-2yyzd5j","Type":"NodeThematicBreak","Properties":{"id":"20240612165922-2yyzd5j"}},{"ID":"20240612165923-nry6qpr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165923-nry6qpr","updated":"20240612165927"},"Children":[{"Type":"NodeText","Data":"半夏《汤液本草》"}]},{"ID":"20240612165923-550idv8","Type":"NodeParagraph","Properties":{"id":"20240612165923-550idv8","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"气微寒，味辛、平。苦而辛，辛浓苦轻，阳中阴也。生微寒，熟温。有毒。"}]},{"ID":"20240612165923-c8f1xmg","Type":"NodeParagraph","Properties":{"id":"20240612165923-c8f1xmg","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"入足阳明经、太阴经、少阳经。"}]},{"ID":"20240612165923-c1sitfp","Type":"NodeParagraph","Properties":{"id":"20240612165923-c1sitfp","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"《象》云∶治寒痰，及形寒饮冷伤肺而咳。大和胃气，除胃寒，进食。治太阴痰厥头痛，非此不能除。"}]},{"ID":"20240612165923-958eoco","Type":"NodeParagraph","Properties":{"id":"20240612165923-958eoco","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"《心》云∶能胜脾胃之湿，所以化痰。渴者禁用。"}]},{"ID":"20240612165923-6p77hov","Type":"NodeParagraph","Properties":{"id":"20240612165923-6p77hov","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"《珍》云∶消胸中痞，去膈上痰。"}]},{"ID":"20240612165923-6urmkcl","Type":"NodeParagraph","Properties":{"id":"20240612165923-6urmkcl","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主伤寒寒热，心下坚，下气，咽喉肿痛，头眩，胸胀，咳逆肠鸣。止汗。"}]},{"ID":"20240612165923-3whuj5m","Type":"NodeParagraph","Properties":{"id":"20240612165923-3whuj5m","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"消心腹、胸膈痰热满结，咳嗽上气，心下急痛坚痞，时气呕逆，消痈肿，堕胎，疗痿黄，悦泽面目。生，令人吐；熟，令人下。用之汤洗去滑令尽。用生姜等分制用，能消痰涎，开胃健脾。射干为之使。恶皂荚。畏雄黄、生姜、干姜、秦皮、龟甲。反乌头。"}]},{"ID":"20240612165923-1t5yfaq","Type":"NodeParagraph","Properties":{"id":"20240612165923-1t5yfaq","updated":"20240612165923"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶半夏使。忌羊血、海藻、饴糖。柴胡为之使。俗用为肺药，非也。止吐，为足阳明；除痰，为足太阴。小柴胡中虽为止呕，亦助柴胡能止恶寒，是又为足少阳也；又助黄芩能去热，是又为足阳明也。往来寒热在表里之中，故用此有各半之意。本以治伤寒之寒热，所以名半夏。经云∶肾主五液，化为五湿，自入为唾，入肝为泣，入心为汗，入脾为痰，入肺为涕。有涎曰嗽，无涎曰咳，痰者因咳而动脾之湿也。半夏能泄痰之标，不能泄痰之本，泄本者，泄肾也。咳无形，痰有形，无形则润，有形则燥，所以为流湿润燥也。"}]},{"ID":"20240612165911-wje9hi0","Type":"NodeThematicBreak","Properties":{"id":"20240612165911-wje9hi0"}},{"ID":"20240612165912-ajc9tt2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165912-ajc9tt2","updated":"20240612165917"},"Children":[{"Type":"NodeText","Data":"半夏《本草备要》"}]},{"ID":"20240612165912-d9ar43s","Type":"NodeParagraph","Properties":{"id":"20240612165912-d9ar43s","updated":"20240612165912"},"Children":[{"Type":"NodeText","Data":"燥湿痰，润肾燥，宣通阴阳"}]},{"ID":"20240612165912-wnljeyj","Type":"NodeParagraph","Properties":{"id":"20240612165912-wnljeyj","updated":"20240612165912"},"Children":[{"Type":"NodeText","Data":"辛温有毒，体滑性燥，能走能散，能燥能润。和胃健脾（去湿），补肝（辛散）润肾，除湿化痰，发表开郁，下逆气，止烦呕，发音声，利水道（燥去湿，故利水；辛通气，能化液，故润燥。丹溪谓∶二陈汤能使大便润而小便长），救暴卒（葛生曰∶凡遇五绝之病，用半夏末吹入鼻中即活，盖取其能作嚏也。五绝，谓缢死、溺死、压死、魇死、产死也）。"}]},{"ID":"20240612165912-rmc0t7i","Type":"NodeParagraph","Properties":{"id":"20240612165912-rmc0t7i","updated":"20240612165912"},"Children":[{"Type":"NodeText","Data":"治咳逆头眩（火炎痰升则眩），痰厥头痛，眉棱骨痛（风热与痰），咽痛（成无己曰∶半夏辛散，行水气而润肾燥。又局方半硫丸，治老人虚秘，皆取其润滑也。俗以半夏、南星为性燥误矣，湿去则土燥，痰涎不生，非二物之性燥也。古方用治咽痛、喉痹、吐血，非禁剂也。二物亦能散血，故破伤、扑打皆主之。惟阴虚劳损，则非湿热之邪，而用利窍行湿之药，是重竭其津液，医之罪也，岂药之咎哉。《甲乙经》用治之眠，是果性燥者乎！半夏、硫黄等分，生姜糊丸，名半硫丸）胸胀（仲景小陷胸汤用之），伤寒寒热（故小柴胡汤用之），痰疟不眠（《素问》曰∶胃不和，则卧不安。半夏能和胃气而通阴阳。《灵枢》曰∶阳气满，不得入于阴，阴气虚，故目不得瞑，饮以半夏汤，阴阳既通，其卧立安。又有喘嗽不得眠者。"}]},{"ID":"20240612165912-4ltp8i0","Type":"NodeParagraph","Properties":{"id":"20240612165912-4ltp8i0","updated":"20240612165912"},"Children":[{"Type":"NodeText","Data":"左不得眠属肝胀，宜清肝；右不得眠属肺胀，宜清肺），反胃吐食（痰膈），散痞除瘿（瘿多属痰），消肿止汗（胜湿）。孕妇忌之（王好古曰∶肾主五液，化为五湿，本经为唾、入肝为泪、入心为汗、入肺为涕、入脾为痰。痰者因咳而动，脾之湿也，半夏泄痰之际，不能治痰之本，治本者治肾也。咳无形，痰有形，无形则润，有形则燥，所以为流脾湿而润肾燥之剂也。俗以半夏为肺药非也，止呕为足阳明，除痰为足太阴。柴胡为之使，故柴胡汤用之。虽云止呕，亦助柴、芩主寒热往来，是又为足少阳也。时珍曰∶脾无湿不生痰，故脾为生痰之源，肺为贮痰之器。按∶有声无痰曰咳，盖伤于肺气；有痰无声曰嗽，盖动于脾湿也；有声有痰曰咳嗽，或因火、因风、因寒、因湿、因虚劳、因食积，宜分证论治。大法治嗽，当以治痰为先，而治痰又以顺气为主。宜以半夏、南星燥其湿，枳壳、橘红利其气，肺虚加温敛之味，肺热加凉泻之剂。赵继宗曰∶二陈治痰，世医执之，内有半夏，其性燥烈，若风、寒、湿、食诸痰则相宜，至于劳痰、失血诸痰，用之反能燥血液而加病。按古有三禁，血家、汗家、渴家忌之，然亦间有用之者。俗以半夏专为除痰，而半夏之功用，不复见知于世矣。小柴胡汤、半夏泻心汤，皆用半夏，岂为除痰乎？火结为痰，气顺则火降而痰消）。"}]},{"ID":"20240612165912-apiqn88","Type":"NodeParagraph","Properties":{"id":"20240612165912-apiqn88","updated":"20240612165912"},"Children":[{"Type":"NodeText","Data":"圆白而大，陈久者良，浸七日，逐日换水，沥去涎，切片，姜汁拌（性畏生姜，用之以制其毒，得姜而功愈彰）。柴胡、射干为使。畏生姜、秦皮、龟甲、雄黄。忌羊肉、海藻、饴糖。恶皂角。反乌头（合陈皮、茯苓、甘草、名二陈汤，为治痰之总剂。寒痰佐以干姜、芥子，热痰佐以黄芩、栝蒌，湿痰佐以苍术、茯苓，风痰佐以南星、前胡，痞痰佐以枳实、白术。更看痰之所在，加导引药，惟燥痰非半夏所司也）。"}]},{"ID":"20240612165912-zuyxmt0","Type":"NodeParagraph","Properties":{"id":"20240612165912-zuyxmt0","updated":"20240612165912"},"Children":[{"Type":"NodeText","Data":"韩飞霞造曲十法（一姜汁浸造，名生姜曲，治浅近诸痰。一矾水煮透，兼姜糊造，名矾曲，矾最能却水，治清水痰。一煮皂角汁，炼膏，和半夏末为曲，或加南星，或加麝香，名皂角曲，治风痰开经络。一用白芥子等分，或三分之一，竹沥和成，略加曲糊，名竹沥曲，治皮里膜外结核隐显之痰。一麻油浸半夏三五日，炒干为末，曲糊造成。油以润燥，名麻油曲，治虚热劳咳之痰。一用腊月黄牛胆汁，略加热蜜和造，名牛胆曲，治癫痫风痰。一用香附、苍术、抚芎等分，熬膏，和半夏末作曲，名开郁曲，治郁痰；一用芒硝居半夏十分之三，煮透为末，煎大黄膏和成，名硝磺曲，治中风、卒厥、伤寒宜下由于痰者。一用海粉一两、雄黄一两、半夏二两，为末炼蜜和造，名海粉曲，治积痰沉痼；一用黄牛肉煎汁炼膏，即霞天膏，和半夏末为曲，名霞天曲，治沉 痼痰，功效最烈）。以上并照造曲法，草庵七日，待生黄衣晒干，悬挂风处，愈久愈良。"}]},{"ID":"20240612165900-ke3qvsy","Type":"NodeThematicBreak","Properties":{"id":"20240612165900-ke3qvsy"}},{"ID":"20240612165901-1ogitd8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165901-1ogitd8","updated":"20240612165905"},"Children":[{"Type":"NodeText","Data":"半夏《本草求真》"}]},{"ID":"20240612165901-98bl8gr","Type":"NodeParagraph","Properties":{"id":"20240612165901-98bl8gr","updated":"20240612165901"},"Children":[{"Type":"NodeText","Data":"（毒草）主散肠胃湿痰"}]},{"ID":"20240612165901-8c6hi41","Type":"NodeParagraph","Properties":{"id":"20240612165901-8c6hi41","updated":"20240612165901"},"Children":[{"Type":"NodeText","Data":"半夏（专入脾胃胆。兼入心）。书言辛温有毒。体滑性燥。能走能散。能燥能润。和胃健脾。补肝润肾数语。业已道其主治大要矣。第不详悉注明。犹未有解。盖半夏味辛。辛则液化而便利。故云能润肾燥也！（成无己曰。半夏辛散行水而润肾燥。盖燥去湿则水利。辛化液则燥润。局方半硫丸治老人虚秘。皆取其润滑也。俗以半夏南星为性燥。误矣。湿去则土燥。痰涎不生。非二物之性燥也。）脾苦湿。必得味辛气温以为之燥。半夏辛温。能于脾中涤痰除垢。痰去而脾自健。故云能以健脾也。（王好古曰。肾主五液。化为五湿。在肾为唾。在肝为泪。在心为汗。在肺为涕。在脾为痰。痰者因咳而动脾之湿也。半夏泄痰之标。不能泄痰之本。泄本者泄肾也。咳无形。痰有声。无形则润。有声则燥。所以为疏脾湿而润肾燥之剂也。）胃为痰气壅塞。则胃不和之极。半夏既能温脾以除痰。又合生姜暖胃以除呕。若合柴苓以治少阳寒热往来。则胃更见和谐。故云能以和胃也。（王好古曰。俗以半夏为肺药。非也。止呕为足阳明。除痰为足太阴。柴胡为之使。故柴胡汤用之。虽云止呕。亦助柴苓主寒热往来。是又为足少阳药也。时珍曰。脾无湿不生痰。故脾为生痰之源。肺为贮痰之器。按有声无痰曰咳。盖伤于肺气。有痰无声曰嗽。盖动于脾湿也。有声有痰曰咳嗽。或因火因风因寒因湿因虚劳因食积。宜分症论治。大法治嗽当以治痰为先。而治痰又以顺气为主。宜以半夏燥其湿。枳壳橘红利其气。肺虚加温敛之药。肺热加凉泻之剂。）他如气逆能下。（痰除而气自下。）郁结能开。（痰除而郁与结亦开。）暴死。以末吹鼻能救。（如缢死溺死压死魇死产死之类。）不眠。以半夏汤通其阴阳得卧。（素问曰。胃不和则卧不安。半夏能和胃气而通阴阳。灵枢曰。阳气满不得入于阴。阴气虚故目不得瞑。饮以半夏汤。阴阳既通。其卧立至。又有咳嗽不得眠者。左不得眠属肝胀。右不得眠属肺胀。宜清肺。）胸胀。合栝蒌等药名小陷胸汤以除。少阴咽痛生疮。语声不出。合鸡子苦酒名苦酒汤以服。（仲景用此以治少阴咽痛。）亦何莫非半夏之妙用。而为开窍利湿之药。（合陈皮茯苓甘草名二陈汤。为治痰之总剂。寒积佐以干姜芥子。积热佐以黄芩栝蒌。湿痰佐以苍术茯苓。风痰佐以南星前胡。痞痰佐以枳实白术。更看痰所在加导引药。惟燥痰非半夏所能司也已。）但阴虚火盛。热结胎滑痰涌等症。则非所宜。不可不慎。（赵继宗曰。二陈治痰。世医执之。内有半夏。其性燥烈。若风湿食诸痰则相宜。至于劳痰失血诸痰。用之反能燥血液而加病。按古半夏有二禁。汗家渴家忌之。然亦间有用者。）圆白而大陈久者良。浸七日。逐日换水。沥去涎。同皂荚白矾姜煮熟。（半夏畏姜。偏用姜以制其毒。）或七日夜。用净水淘浸。（以除其涎。）再用皂荚水浸七日夜。（同皂荚可治风痰。）又用灰水淘浸七日夜。（可治脾胃痰。）又用白矾水淘浸七日夜。（可治清水痰。）又用生姜水淘浸七日夜。（可治寒痰。）又用甘草水淘浸七日夜。（可解其毒及调制药之性。）洗净焙干用。柴胡射干为使。畏生姜秦皮龟甲雄黄。忌羊血海藻饴糖。（以甘腻凝滞故忌。）恶皂荚。反乌头。（乌头辛燥悍烈。故反。）其用姜汁浸造。名生姜曲。矾水煮造。（兼姜糊入）"}]},{"ID":"20240612165901-icxllm3","Type":"NodeParagraph","Properties":{"id":"20240612165901-icxllm3","updated":"20240612165901"},"Children":[{"Type":"NodeText","Data":"名矾曲。同皂角煮造。（炼膏）名皂角曲。同白芥子等分煮造。（有竹沥三分之）名竹沥曲。同麻油浸造。炒干为末造成。名麻油曲。同黄牛胆与蜜造。名牛胆曲。同香附苍术抚芎和半熬膏造。名开郁曲。同芒硝（十分之三）煮与大黄煎膏造。名硝黄曲。同海粉雄黄（各十分之五）"}]},{"ID":"20240612165901-f3q9igf","Type":"NodeParagraph","Properties":{"id":"20240612165901-f3q9igf","updated":"20240612165901"},"Children":[{"Type":"NodeText","Data":"炼蜜造。名海粉曲。同生黄牛肉熬膏。名霞天曲。并照造曲法草 七日。待生黄衣。悬干挂风处。至用曲治之症。则随制药能治病症之性以为治焉。（如生姜治寒痰。皂角治风痰。白矾治湿痰。牛肉治沉 痼痰之类。）"}]},{"ID":"20240612165847-fv2zfpj","Type":"NodeThematicBreak","Properties":{"id":"20240612165847-fv2zfpj"}},{"ID":"20240612165848-6fhugml","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165848-6fhugml","updated":"20240612165854"},"Children":[{"Type":"NodeText","Data":"半夏《名医别录》"}]},{"ID":"20240612165848-7envbrl","Type":"NodeParagraph","Properties":{"id":"20240612165848-7envbrl","updated":"20240612165848"},"Children":[{"Type":"NodeText","Data":"生微寒、熟温，有毒．主消心腹胸中膈痰热满结，咳嗽上气，心下急痛坚痞，时气呕消痈肿，胎堕，治痿黄， 泽面目．生令人吐，熟令人下．用之汤洗，令滑尽．一名守一名示姑．生槐里．五月、八月采根，曝干．（射干为之使，恶皂荚，畏雄黄、生姜、秦皮、龟甲，反乌头．）"}]},{"ID":"20240612165848-0w8ia44","Type":"NodeParagraph","Properties":{"id":"20240612165848-0w8ia44","updated":"20240612165848"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶半夏，味辛，平．主伤寒寒热，心下坚，下气，喉咽肿痛，头眩，胸胀咳逆，肠鸣，止汗．"}]},{"ID":"20240612165836-u1ucicy","Type":"NodeThematicBreak","Properties":{"id":"20240612165836-u1ucicy"}},{"ID":"20240612165837-gtxdngn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165837-gtxdngn","updated":"20240612165842"},"Children":[{"Type":"NodeText","Data":"半夏《本草分经》"}]},{"ID":"20240612165837-vxc3lcx","Type":"NodeParagraph","Properties":{"id":"20240612165837-vxc3lcx","updated":"20240612165837"},"Children":[{"Type":"NodeText","Data":"辛温，体滑性燥，和胃健脾，兼行胆经，发表开郁，下气止呕，除湿痰利二便，能行水气以润肾，燥和胃气而通阴阳，治一切脾湿之症，血家渴家汗家慎用，肺燥者不可误服，须制用，亦有造曲者。"}]},{"ID":"20240612165814-x6mt2t0","Type":"NodeThematicBreak","Properties":{"id":"20240612165814-x6mt2t0"}},{"ID":"20240612165815-0slw9ld","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165815-0slw9ld","updated":"20240612165819"},"Children":[{"Type":"NodeText","Data":"半夏《本经逢原》"}]},{"ID":"20240612165815-oqs9zig","Type":"NodeParagraph","Properties":{"id":"20240612165815-oqs9zig","updated":"20240612165815"},"Children":[{"Type":"NodeText","Data":"辛温，有毒。汤浸，同皂荚、白矾煮熟，姜汁拌、焙干用；或皂荚、白矾、姜汁、竹沥四制尤妙。咽痛醋炒用。小儿惊痰发搐及胆虚不得眠，猪胆汁炒。入脾胃丸剂，为细末姜汁拌和作面，候陈炒用。反乌附者，以辛燥鼓激悍烈之性也。忌羊血、海藻、饴糖者，以甘腻凝滞开发之力也。"}]},{"ID":"20240612165815-ijwpsz6","Type":"NodeParagraph","Properties":{"id":"20240612165815-ijwpsz6","updated":"20240612165815"},"Children":[{"Type":"NodeText","Data":"《本经》主伤寒寒热，心下坚，胸胀，咳逆，头眩，咽喉肿痛，肠鸣下气，止汗。"}]},{"ID":"20240612165815-j8w4tzh","Type":"NodeParagraph","Properties":{"id":"20240612165815-j8w4tzh","updated":"20240612165815"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"半夏为足少阳本药，兼入足阳明、太阴。虚而有痰气宜加用之，胃冷呕哕方药之最要。止呕为足阳明，除痰为足太阴，柴胡为之使，故小柴胡汤用之，虽为止呕，亦助柴胡、黄芩主往来寒热也。《本经》治伤寒寒热，非取其辛温散结之力欤。治心下坚、胸胀，非取其攻坚消痞之力欤。治咳逆、头眩、非取其涤痰散邪之力欤。治咽喉肿痛，非取其分解阴火之力欤。治肠鸣下气止汗，非取其利水开痰之力欤。同苍术、茯苓治湿痰，同栝蒌、黄芩治热痰，同南星、前胡治风痰，同芥子、姜汁治寒痰，惟燥痰宜栝蒌、贝母、非半夏所能治也。半夏性燥能去湿、豁痰、健脾。今人惟知半夏去痰，不言益脾利水，脾无留湿则不生痰，故脾为生痰之源，肺为贮痰之器。半夏能主痰饮及腹胀者，为其体滑而味辛性温也，二陈汤能使大便润而小便长。世俗皆以半夏、南星为性燥，误矣。湿去则土燥，痰涎不生，非二物之性燥也。古方治咽痛喉痹，吐血、下血多用二物，非禁剂也。按∶《灵枢》云，阳气满则阳 盛不得入于阴，阴虚则目不瞑，饮以半夏汤一剂通其阴阳，其卧立至。半夏得栝蒌实、黄连，名小陷胸汤，治伤寒小结胸。得鸡子清、苦酒，名苦酒汤，治少阴咽痛生疮，语声不出。得生姜，名小半夏汤，治支饮作呕。得人参、白蜜，名大半夏汤，治呕吐反胃。得麻黄，蜜丸名半夏麻黄丸，治心下悸忪。得茯苓、甘草，以醋煮半夏共为末，姜汁面糊丸，名消暑丸，治伏暑引饮，脾胃不和，此皆得半夏之妙用。惟阴虚羸瘦，骨蒸汗泄，火郁头痛，热伤咳嗽，及消渴肺痿，咳逆失血，肢体羸瘦禁用，以非湿热之邪，而用利窍行湿之药，重竭其津，医之罪也，岂药之咎哉！"}]},{"ID":"20240612165741-h64928r","Type":"NodeThematicBreak","Properties":{"id":"20240612165741-h64928r"}},{"ID":"20240612165743-au4pcjo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165743-au4pcjo","updated":"20240612165749"},"Children":[{"Type":"NodeText","Data":"半夏《神农本草经读》"}]},{"ID":"20240612165743-mukdw5m","Type":"NodeParagraph","Properties":{"id":"20240612165743-mukdw5m","updated":"20240612165743"},"Children":[{"Type":"NodeText","Data":"气味辛、平，有毒。主伤寒寒热，心下坚，胸胀咳逆，头眩，咽喉肿痛，肠鸣，下气，止汗。"}]},{"ID":"20240612165743-qlvmcmn","Type":"NodeParagraph","Properties":{"id":"20240612165743-qlvmcmn","updated":"20240612165743"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶半夏气平，禀天秋金之燥气，而入手太阴；味辛有毒，得地西方酷烈之味，而入手足阳明。辛则能开诸结，平则能降诸逆也。伤寒寒热、心下坚者，邪积于半表半里之间，其主之者，以其辛而能开也。胸胀咳逆、咽喉肿痛、头眩上气者，邪逆于巅顶胸膈之上，其主之者，以其平而能降也。鸣者，大肠受湿，则肠中切痛而鸣濯濯也；其主之者，以其辛平能燥湿也。又云止汗者，别着其辛中带涩之功也。仲景于小柴胡汤用之治寒热，泻心汤用之以治胸满肠鸣，少阴咽痛亦用之，《金匮》头眩亦用之，且呕者必加此味，大得其开结降逆之旨。用药悉遵《本经》，所以为医中之圣。"}]},{"ID":"20240612165743-ied1345","Type":"NodeParagraph","Properties":{"id":"20240612165743-ied1345","updated":"20240612165743"},"Children":[{"Type":"NodeText","Data":"又曰∶今人以半夏功专祛痰，概用白矾煮之，服者往往致吐，且致酸心少食，制法相沿之陋也。古人只用汤洗七次，去涎，今人畏其麻口，不敢从之。余每年收干半夏数十斤，洗去粗皮，以生姜汁、甘草水浸一日夜，洗净，又用河水浸三日，一日一换，滤起蒸熟，晒干切片，隔一年用之，甚效。此药盖是太阴、阳明、少阳之大药，祛痰却非专长。故仲景诸方加减，俱云呕者加半夏，痰多者加茯苓，末闻以痰多加半夏也。"}]},{"ID":"20240612165728-vhva1zo","Type":"NodeThematicBreak","Properties":{"id":"20240612165728-vhva1zo"}},{"ID":"20240612165729-pkocnzy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165729-pkocnzy","updated":"20240612165733"},"Children":[{"Type":"NodeText","Data":"半夏《本草经集注》"}]},{"ID":"20240612165729-239ff13","Type":"NodeParagraph","Properties":{"id":"20240612165729-239ff13","updated":"20240612165729"},"Children":[{"Type":"NodeText","Data":"味辛，平、生微寒、熟温，有毒。主治伤寒寒热，心下坚，下气，喉咽肿痛，头眩，胸胀，咳逆，肠鸣，止汗。消心腹胸中膈痰热满结，咳嗽上气，心下急痛坚痞，时气呕逆，消痈肿，胎堕，治痿黄，悦泽面目。生令人吐，熟令人下。用之汤洗，令滑尽。一名地文，一名水玉，一名守田，一名示姑。生槐里川谷。五月、八月采根，曝干。（射干为之使，恶皂荚，畏雄黄、生姜、干姜、秦皮、龟甲，反乌头。）"}]},{"ID":"20240612165729-r0rqhsv","Type":"NodeParagraph","Properties":{"id":"20240612165729-r0rqhsv","updated":"20240612165729"},"Children":[{"Type":"NodeText","Data":"槐里属扶风，今第一出青州，吴中亦有，以肉白者为佳，不厌陈久，用之皆汤洗十许过，令滑尽，不尔戟人咽喉。方中有半夏，必须生姜者，亦以制其毒故也。"}]},{"ID":"20240612165703-d9zeaen","Type":"NodeThematicBreak","Properties":{"id":"20240612165703-d9zeaen"}},{"ID":"20240612165705-46v8lh1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165705-46v8lh1","updated":"20240612165711"},"Children":[{"Type":"NodeText","Data":"半夏《本草新编》"}]},{"ID":"20240612165705-85zpfjv","Type":"NodeParagraph","Properties":{"id":"20240612165705-85zpfjv","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"半夏，味辛、微苦，气平，生寒，熟温，沉而降，阴中阳也。入胆、脾、胃三经。研末，每一两，用入枯矾二钱、姜汁一合，捏饼，楮叶包裹，阴干，又名半夏曲也。片则力峻，曲则力柔，统治痰涎甚验。无论火痰、寒痰、湿痰、老痰与痰饮、痰核、痰涎、痰结、痰迷，俱可用，但不可治阴火之痰。孕妇勿用，恐坠胎元。然有不可不用之时，暂用亦无碍。吐血家亦不可用，恐性愈动火也。片半夏为末，吹鼻中，可救五绝，并产后血晕甚效。"}]},{"ID":"20240612165705-vcix9rp","Type":"NodeParagraph","Properties":{"id":"20240612165705-vcix9rp","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"人身原无痰也，饮食入胃，化精而不化痰。惟肾中真火虚，则火沸为痰，亦肾之真水虚，则水泛为痰矣。火沸为痰与水泛为痰，虽原于肾，而痰乃留于脾也。半夏既治痰，岂难消化，况痰已入脾中，安在不能化之。然而终不能消者，以其能消已入脾中之痰，而不能断其将入脾中之痰也。盖肾中之痰也，必须肾气丸，始得逐之，非半夏所能祛也，半夏泄痰之标，不能治痰之本。半夏性沉而降，似乎能入至阴之中，然而阳多于阴，止可浅入脾阴，而不能深入肾阴也。况半夏泻阴而不补阴，而肾又可补而不可泻，半夏欲入于肾，而肾所以不受也。"}]},{"ID":"20240612165705-yia8yg9","Type":"NodeParagraph","Properties":{"id":"20240612165705-yia8yg9","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"半夏既不能入肾之内，又何以化肾中之痰哉。可见痰在脾为标，痰在肾为本，以脾之痰出于肾也。消脾之痰，不可以见标本之异哉。"}]},{"ID":"20240612165705-5y7uuqw","Type":"NodeParagraph","Properties":{"id":"20240612165705-5y7uuqw","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"肾气丸治痰，是择其本也。水不上泛为痰，何必更消其痰。火不上沸为痰，何必再清其痰。"}]},{"ID":"20240612165705-f9eq8o8","Type":"NodeParagraph","Properties":{"id":"20240612165705-f9eq8o8","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"用肾气丸而痰已绝。用半夏以治标，恐及动其祛痰也。半夏燥气之药，再耗肾中之气，气一耗，则火动水燥，不生精而生痰，势所必至，不特无益，反害之矣。故既治本，不必更治标也。"}]},{"ID":"20240612165705-8jkwm9h","Type":"NodeParagraph","Properties":{"id":"20240612165705-8jkwm9h","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"或疑半夏性燥，故便子治湿痰也，不识用何药以制其燥，并可以治热痰乎？夫燥湿之性各殊，虽制之得宜，只可去其大过，而不能移其性也。然而未制其燥，与已制其燥，自然少异。"}]},{"ID":"20240612165705-4fidhp0","Type":"NodeParagraph","Properties":{"id":"20240612165705-4fidhp0","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"铎有制法，并传于此。用半夏一斤、生姜片四两，先煮数沸，取起晒干。用桑叶一百片，水十碗，煎汁二碗，将半夏泡透，又晒干。复用盐一两、滚水一碗，又泡透，切片用之，则燥性去其六，湿之性得其四。寒热之痰，与水火泛沸之痰，俱可少用，以为权宜之计矣。然又只可暂用，而不可据之为久治也。"}]},{"ID":"20240612165705-3f9za7r","Type":"NodeParagraph","Properties":{"id":"20240612165705-3f9za7r","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"或疑制半夏，以治燥热之痰妙矣，恐反不宜于寒湿之痰，奈何？此则无容虑也。半夏性燥，治寒湿之痰正宜，制过燥，而无伤气之忧与损肺之失，可用之而无恐也。"}]},{"ID":"20240612165705-rdnfcyt","Type":"NodeParagraph","Properties":{"id":"20240612165705-rdnfcyt","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"或疑半夏治湿痰，而不可治燥痰；治寒痰，而不可治热痰，俱闻命矣。痰之中更有吐黑痰者，其故何也？吾观其人则甚健，谓是火而口不渴，谓是虚而肾不亏，又可以半夏治之乎？此乃邪结于肾之中，非痰塞于肺之窍也。此症本起于久旷之夫，思女色而不可得，又不敢御外色以泄精，于是邪入于肾中，精即化痰，而若吐有如墨之黑者矣。宜用于降火之药，佐之白芥子以消痰，而更用于荆芥之类，以散其火于血分之中。否则，必有失血之患，温疟之苦矣。"}]},{"ID":"20240612165705-eays5lp","Type":"NodeParagraph","Properties":{"id":"20240612165705-eays5lp","updated":"20240612165705"},"Children":[{"Type":"NodeText","Data":"数剂之后，身必畏寒，然后用于加味逍遥散，大用于半夏，以清于其表里之邪，则寒热乃除去，而黑痰又乃以渐愈矣也。此等之病症，尝实亲试之，而往往有效验也，故敢论之于书也。"}]},{"ID":"20240612165757-se291gn","Type":"NodeThematicBreak","Properties":{"id":"20240612165757-se291gn"}},{"ID":"20240612165759-w65vc7m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165759-w65vc7m","updated":"20240612165806"},"Children":[{"Type":"NodeText","Data":"半夏《长沙药解》"}]},{"ID":"20240612165759-qhhr0x1","Type":"NodeParagraph","Properties":{"id":"20240612165759-qhhr0x1","updated":"20240612165759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛平。主伤寒，寒热，心下坚，下气，喉咽肿痛，头眩胸张，咳逆肠鸣，止汗。一名地文，一名水玉。生川谷。"}]},{"ID":"20240612165759-nl9jiap","Type":"NodeParagraph","Properties":{"id":"20240612165759-nl9jiap","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"味辛，气平，入手太阴肺、足阳明胃经。下冲逆而除咳嗽，降浊阴而止呕吐，排决水饮，清涤涎沫，开胸膈胀塞，消咽喉肿痛，平头上之眩晕，泻心下之痞满，善调反胃，妙安惊悸。"}]},{"ID":"20240612165759-qzr93pg","Type":"NodeParagraph","Properties":{"id":"20240612165759-qzr93pg","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏半升，人参、甘草、干姜、黄芩、黄连各三两，大枣十二枚。"},{"Type":"NodeText","Data":"治少阳伤寒，下后心下痞满而不痛者。以中气虚寒，胃土上逆，迫于甲木，经气结涩，是以作痞。少阳之经，循胃口而下胁肋，随阳明而下行，胃逆则胆无降路，故与胃气并郁于心胁。甲木化气于相火，君相同气，胃逆而君相皆腾，则生上热。参、甘、姜、枣，温补中脘之虚寒，黄芩、黄连，清泻上焦之郁热，半夏降胃气而消痞满也。《金匮》治呕而肠鸣，心下痞者。中气虚寒则肠鸣，胃气上逆则呕吐也。"}]},{"ID":"20240612165759-gdxhoua","Type":"NodeParagraph","Properties":{"id":"20240612165759-gdxhoua","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大半夏汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏二升，人参三两，白蜜一斤，水一斗二升，和蜜扬之二百四十遍，煮，分三服。"},{"Type":"NodeText","Data":"治胃反呕吐者。以脾阳虚败，水谷不消，而土木郁陷，下窍堵塞，是以不为泄利，而为呕吐。胃以下行为顺，反而逆行，故名胃反。人参补中脘之阳，建其枢轴，白蜜润下窍之结涩，半夏降上逆之胃气也。"}]},{"ID":"20240612165759-nallavk","Type":"NodeParagraph","Properties":{"id":"20240612165759-nallavk","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩加半夏生姜汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄芩三两，芍药二两，甘草二两，大枣十二枚，半夏半升，生姜三两。"},{"Type":"NodeText","Data":"治太阳少阳合病，下利而作呕者。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在黄芩"},{"Type":"NodeText","Data":"。治太少之下利，加半夏、生姜，降胃逆而止呕也。"}]},{"ID":"20240612165759-28stusw","Type":"NodeParagraph","Properties":{"id":"20240612165759-28stusw","updated":"20240612165759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葛根加半夏汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"葛根四两，麻黄三两，桂枝二两，甘草二两，芍药二两，生姜三两，大枣十二枚，半夏半升。"},{"Type":"NodeText","Data":"治太阳阳明合病，不下利，但呕者。以阳明为少阳胆木所逼，水谷莫容，已消而在下脘则为利，未消而在上脘则为呕。半夏降胃逆而止呕也。"}]},{"ID":"20240612165759-0dud9y4","Type":"NodeParagraph","Properties":{"id":"20240612165759-0dud9y4","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏干姜散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏、干姜等分。为散，浆水服方寸匕。"},{"Type":"NodeText","Data":"治干呕、吐逆，吐涎沫。以中寒胃逆，浊阴冲塞，肺气堙郁，淫蒸涎沫。干姜温中而下冲气，半夏降逆而荡瘀浊也。"}]},{"ID":"20240612165759-cdcuihj","Type":"NodeParagraph","Properties":{"id":"20240612165759-cdcuihj","updated":"20240612165759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小半夏汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏一升，生姜一斤。"},{"Type":"NodeText","Data":"治心下有支饮，呕而不渴者。以饮居心下，阻隔胃气，故胃逆作呕，而不觉燥渴。半夏、生姜，降逆气而排水饮也。"}]},{"ID":"20240612165759-b7xgbf8","Type":"NodeParagraph","Properties":{"id":"20240612165759-b7xgbf8","updated":"20240612165759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苓甘五味姜辛加半夏汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"茯苓四两，甘草三两，五味半升，干姜三两，细辛一两，半夏半升。"},{"Type":"NodeText","Data":"治支饮，昏冒作呕，而不渴者。以饮居心下，隔其胃阳，阳升则冒，胃逆则呕，半夏驱水饮而止呕冒也。"}]},{"ID":"20240612165759-thhsnip","Type":"NodeParagraph","Properties":{"id":"20240612165759-thhsnip","updated":"20240612165759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"越婢加半夏汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"麻黄六两，石膏半斤，甘草一两，生姜三两，大枣十五枚，半夏半升。"},{"Type":"NodeText","Data":"治肺胀，咳喘上气，目如脱，脉浮大者。以中气虚滞，肺胃之降令素迟，一遇风寒，闭其皮毛，里郁莫泄，胃气逆升，肺壅为热，是以咳喘上气而脉浮大。此为肺胀之病，即伤风齁喘而为热者。甘、枣补其中虚，麻黄泻其皮毛，石膏清其肺热，生姜、半夏，降冲逆而破壅塞也。"}]},{"ID":"20240612165759-l1hncgn","Type":"NodeParagraph","Properties":{"id":"20240612165759-l1hncgn","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏、甘草、桂枝等分，为散，白饮和服方寸匕。不能服散，水煎服。"},{"Type":"NodeText","Data":"治少阴病，咽痛者。以阴气上冲，因致咽痛。半夏、桂枝，降其冲逆，甘草缓其急迫也。"}]},{"ID":"20240612165759-4r2xbwp","Type":"NodeParagraph","Properties":{"id":"20240612165759-4r2xbwp","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏厚朴汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏一升，厚朴三两，茯苓四两，生姜五两，苏叶二两。"},{"Type":"NodeText","Data":"治妇人咽中如有炙脔。以湿旺气逆，血肉凝瘀。茯苓泻其湿，朴、半、姜、苏，降其逆而散其滞也。"}]},{"ID":"20240612165759-f36tylw","Type":"NodeParagraph","Properties":{"id":"20240612165759-f36tylw","updated":"20240612165759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏麻黄丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"半夏、麻黄等分，蜜丸。"},{"Type":"NodeText","Data":"治心下悸者。以阳衰土湿，升降失政，脾陷而乙木不能直升，则郁勃而为悸，胃逆而甲木不能顺降，则悬虚而为惊。胃土上逆，浊阴填塞，心下更郁，经络壅涩，碍厥阴风木升达之路，是以心下悸动。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"《素问》：胃之大络，名曰虚里，出于左乳下，其动应衣，即此谓也。"},{"Type":"NodeText","Data":"惊原于魂气之虚飘，悸原于经气之阻碍。半夏降胃逆而驱浊阴，麻黄开堙郁而通络路也。"}]},{"ID":"20240612165759-rixzy6y","Type":"NodeParagraph","Properties":{"id":"20240612165759-rixzy6y","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"人之中气，左右回旋，脾主升清，胃主降浊。在下之气，不可一刻而不升，在上之气，不可一刻而不降。一刻不升，则清气下陷，一刻不降，则浊气上逆。浊气上逆，则呕哕痰饮皆作，一切惊悸眩晕，吐衄嗽喘，心痞胁胀，膈噎反胃，种种诸病，于是生焉，而总由于中气之湿寒。盖中脘者，气化之原，清于此升，浊于此降，四象推迁，莫不本乎是。不寒不热，不燥不湿，阴阳和平，气机自转。寒湿偏旺，气化停滞，枢机不运，升降乃反，此脾陷胃逆之根也。安有中气健运，而病胃逆者哉！"}]},{"ID":"20240612165759-g5yv9wj","Type":"NodeParagraph","Properties":{"id":"20240612165759-g5yv9wj","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"甲木下行而交癸水者，缘于戊土之降。戊土不降，甲木失根，神魂浮荡，此惊悸眩晕所由来也。二火升炎，肺金被克，此燥渴烦躁所由来也。收令不遂，清气堙郁，此吐衄痰嗽所由来也。胆胃逆行，土木壅迫，此痞闷膈噎所由来也。凡此诸证，悉宜温中燥土之药，加半夏以降之。其火旺金热，须用清敛金火之品。然肺为病标而胃为病本，必降戊土，以转火金，胃气不降，金火无下行之路也。半夏辛燥开通，沉重下达，专入胃腑，而降逆气。胃土右转，浊瘀扫荡，胃腑冲和，神气归根，则鹤胎龟息，绵绵不绝竭矣。"}]},{"ID":"20240612165759-346ga2n","Type":"NodeParagraph","Properties":{"id":"20240612165759-346ga2n","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"血原于脏而统于经，升于肝而降于肺，肝脾不升，则血病下陷，肺胃不降，则血病上逆。缘中脘湿寒，胃土上郁，浊气冲塞，肺津隔碍，收令不行，是以吐衄。此与虚劳惊悸，本属同原，未有虚劳之久，不生惊悸，惊悸之久，不生吐衄者。当温中燥土，暖水敛火，以治其本，而用半夏降摄胃气，以治其标。"}]},{"ID":"20240612165759-ykgcji0","Type":"NodeParagraph","Properties":{"id":"20240612165759-ykgcji0","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"庸工以为阴虚火动，不宜半夏，率以清凉滋润之法，刊诸纸素。千载一辙，四海同风，《灵枢》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏秫米之方"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"治目不得瞑，在“邪客篇”。"},{"Type":"NodeText","Data":"《金匮》半夏麻黄之制，绝无解者。仁人同心，下士不悟，迢迢长夜，悲叹殷庐，悠悠苍天，此何心哉。"}]},{"ID":"20240612165759-zrti8wx","Type":"NodeParagraph","Properties":{"id":"20240612165759-zrti8wx","updated":"20240612165759"},"Children":[{"Type":"NodeText","Data":"洗去白矾用。妊娠姜汁炒。"}]},{"ID":"20240612165530-qw9fo51","Type":"NodeThematicBreak","Properties":{"id":"20240612165530-qw9fo51"}},{"ID":"20240612165539-ayqz6f3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165539-ayqz6f3","updated":"20240612165544"},"Children":[{"Type":"NodeText","Data":"半夏《中药学》"}]},{"ID":"20240612165539-m0wye95","Type":"NodeParagraph","Properties":{"id":"20240612165539-m0wye95","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【药用】天南星科草本植物半夏Pinelliaternata（Thunb.）Breit.的块茎。"}]},{"ID":"20240612165539-mnmprhy","Type":"NodeParagraph","Properties":{"id":"20240612165539-mnmprhy","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛，温有毒。归脾、胃经。"}]},{"ID":"20240612165539-u084mze","Type":"NodeParagraph","Properties":{"id":"20240612165539-u084mze","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【功效】燥湿化痰，消痞散结，降逆止呕。"}]},{"ID":"20240612165539-qeqlrw7","Type":"NodeParagraph","Properties":{"id":"20240612165539-qeqlrw7","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于痰多咳嗽。"}]},{"ID":"20240612165539-yon073n","Type":"NodeParagraph","Properties":{"id":"20240612165539-yon073n","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"半夏性燥而功能化痰，其所化之痰，以脾不化湿，聚而成痰者为主，为治湿痰的要药，适用于痰湿壅滞、咳嗽气逆等症，常与陈皮、茯苓等配伍；治痰多咳嗽，又常与贝母配伍应用。因其性温，故又可用治寒痰，宜与白芥子、生姜等同用；因其化痰力佳，故亦可治热痰与风痰，治热痰可与瓜蒌、黄芩等配伍；致风痰，宜与天南星等同用。"}]},{"ID":"20240612165539-rzup92i","Type":"NodeParagraph","Properties":{"id":"20240612165539-rzup92i","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"2.用于胸脘痞闷，胸痹，结胸等症。"}]},{"ID":"20240612165539-myil3jg","Type":"NodeParagraph","Properties":{"id":"20240612165539-myil3jg","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"半夏功能辛散温通、化痰、燥湿，故可用于痰内阻、胸脘痞闷病症，可配陈皮、茯苓等同用；如寒热互结，有可配黄芩、黄连、干姜等同用，可收辛开苦降、散结除痞的功效（如半夏泻心汤）。此外，又常用于胸痹疼痛，配瓜蒌、薤白等同用；治结胸症可与瓜蒌、黄连等同用。"}]},{"ID":"20240612165539-etfgcew","Type":"NodeParagraph","Properties":{"id":"20240612165539-etfgcew","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"3.用于瘿瘤瘰历、疮疡肿痛、梅核气等症。"}]},{"ID":"20240612165539-0tu4whi","Type":"NodeParagraph","Properties":{"id":"20240612165539-0tu4whi","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"半夏又能化痰散结，可用以治疗痰湿结聚所致的瘿瘤、瘰历痰核、阴疽肿痛，或痰气互结的梅核气等病症。用治瘿瘤瘰历痰核，可与海藻、黄独、贝母等配用。痈疽未溃者可用生半夏配生南星等同研，调醋外敷，有散结消肿的功效。用治梅核气，可配厚朴、紫苏等同用。"}]},{"ID":"20240612165539-waw9c2h","Type":"NodeParagraph","Properties":{"id":"20240612165539-waw9c2h","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"4.用于胃气上逆、恶心呕吐。"}]},{"ID":"20240612165539-7b82e38","Type":"NodeParagraph","Properties":{"id":"20240612165539-7b82e38","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"半夏有良好的降逆止呕功效，可用于多种呕吐症候，在使用时应根据不同的症状而予以不同的配伍。如治胃寒呕吐，可配合生姜或藿香、丁香等品；治胃热呕吐可配合黄连、竹茹等药；治妊娠呕吐，可配合灶心土等品；治胃虚呕吐，可配人参、白蜜同用。"}]},{"ID":"20240612165539-5p8ibk6","Type":"NodeParagraph","Properties":{"id":"20240612165539-5p8ibk6","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"此外，配秫米同用还能治胃不和而卧不安，配硫黄而治肾阳不足、大便失调之症。"}]},{"ID":"20240612165539-7bhjs9a","Type":"NodeParagraph","Properties":{"id":"20240612165539-7bhjs9a","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【处方用名】制半夏、姜半夏（用明矾粉、生姜汁腌制后漂净，晒干用）、生半夏（生用，有毒，主要作为外用）"}]},{"ID":"20240612165539-5v5wf82","Type":"NodeParagraph","Properties":{"id":"20240612165539-5v5wf82","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。外用适量。"}]},{"ID":"20240612165539-ly2nzoe","Type":"NodeParagraph","Properties":{"id":"20240612165539-ly2nzoe","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【按语】1.半夏性味辛温，入脾胃经，化痰力佳，为治各种痰症要药。其性温而燥，尤为属寒有湿者在所必用；若为热痰，当与清热化痰之品配伍始妥。唯其有伤阴耗津之弊，故燥痰者忌用。所主消痞，实亦化痰除湿之功；至于散结无非辛散温通之效。和中而能降逆为止呕之良药，无论胃寒、胃热、胃虚、恶阻咸可应用，配伍适当，每奏卓效。此外，胃不和而卧不安者，肾阳不足而大便失调者，皆可配合应用，亦有殊功。"}]},{"ID":"20240612165539-rb9l16y","Type":"NodeParagraph","Properties":{"id":"20240612165539-rb9l16y","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"2.半夏昔人以为妊娠忌用之品，然恶阻用之有止呕之效，并无堕胎之虞。又以为性滑，则其体虽滑，而其性温燥，决非润泽之品，故阴虚津少者应于慎用。"}]},{"ID":"20240612165539-hzrwjhp","Type":"NodeParagraph","Properties":{"id":"20240612165539-hzrwjhp","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"3.半夏主要功用为化痰止呕，故为脾胃两经要药。脾为生痰之源，胃为受纳之器。痰湿恋脾，半夏能燥湿化痰；胃气不和，半夏亦能和胃降逆。"}]},{"ID":"20240612165539-qoaok65","Type":"NodeParagraph","Properties":{"id":"20240612165539-qoaok65","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"4.半夏化痰，以脾不化湿、聚而为痰者为主；因其性温燥，故对于寒痰，亦可应用。如属热痰，则须以清肺药配合同用。至于阴虚燥痰、津少口渴等症，则不宜应用。"}]},{"ID":"20240612165539-zbbdrow","Type":"NodeParagraph","Properties":{"id":"20240612165539-zbbdrow","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"5.半夏止呕，以痰气壅塞、胃逆不和为主；但因它具有良好的降逆止呕作用，故除适用于痰饮呕吐之外，尚可用于胃虚呕吐，如《金匮要略》大半夏汤以半夏配伍人参、白蜜等同用；至于胃热呕吐，宜用清胃药如麦冬、竹茹等同用，以防温燥过热、耗伤胃阴。"}]},{"ID":"20240612165539-snu85r7","Type":"NodeParagraph","Properties":{"id":"20240612165539-snu85r7","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"6.《别录》有半夏堕胎的记载，可是《金匮要略》的干姜人参半夏汤早已用治妊娠呕吐，而并不碍胎。从这个例子，启示我们阅读前人本草文献时，必须持有辩证唯物一分为二的观点，使能取其精华，去其糟粕。"}]},{"ID":"20240612165539-xucwwtv","Type":"NodeParagraph","Properties":{"id":"20240612165539-xucwwtv","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"7.半夏生用有毒，生姜、明矾能制其毒，所以用制半夏，多以生姜、明矾制。此外，过去上海地区除姜制半夏之外，上有竹沥半夏、宋半夏、仙半夏等多种制法，现在已于简化，药店主要供应制半夏，不在加工炮制上述品种。"}]},{"ID":"20240612165539-nfh8bvz","Type":"NodeParagraph","Properties":{"id":"20240612165539-nfh8bvz","updated":"20240612165539"},"Children":[{"Type":"NodeText","Data":"【方剂举例】小半夏汤《金匮要略》：半夏、生姜。治痰饮呕吐，心下痞闷不渴者。"}]},{"ID":"20240612165511-qifwa00","Type":"NodeThematicBreak","Properties":{"id":"20240612165511-qifwa00"}},{"ID":"20240612165524-y4fouf6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165524-y4fouf6","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：半夏"}]},{"ID":"20240612165524-7ftqlbf","Type":"NodeParagraph","Properties":{"id":"20240612165524-7ftqlbf","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612165524-o0hxfxt","Type":"NodeParagraph","Properties":{"id":"20240612165524-o0hxfxt","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" Bàn Xià"}]},{"ID":"20240612165524-v241v7y","Type":"NodeParagraph","Properties":{"id":"20240612165524-v241v7y","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612165524-1b9l3qu","Type":"NodeParagraph","Properties":{"id":"20240612165524-1b9l3qu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 三叶半夏、三叶老、三步跳、麻玉果、燕子尾"}]},{"ID":"20240612165524-heixye2","Type":"NodeParagraph","Properties":{"id":"20240612165524-heixye2","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612165524-567wi9n","Type":"NodeParagraph","Properties":{"id":"20240612165524-567wi9n","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" RHIZOMA PINELLIAE"}]},{"ID":"20240612165524-em1iwdm","Type":"NodeParagraph","Properties":{"id":"20240612165524-em1iwdm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612165524-pv3ea6y","Type":"NodeParagraph","Properties":{"id":"20240612165524-pv3ea6y","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 本品为天南星科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏"},{"Type":"NodeText","Data":"Pinellia ternata （Thunb.） Breit. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。夏、秋二季采挖，洗净，除去外皮及须根，晒干。"}]},{"ID":"20240612165524-ma5fyl9","Type":"NodeParagraph","Properties":{"id":"20240612165524-ma5fyl9","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612165524-irgigl0","Type":"NodeParagraph","Properties":{"id":"20240612165524-irgigl0","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 本品呈类球形，有的稍偏斜，直径1～1.5cm。表面白色或浅黄色，顶端有凹陷的茎痕，周围密布麻点状根痕；下面钝圆，较光滑。质坚实，断面洁白，富粉性。无臭，味辛辣、麻舌而剌喉。"}]},{"ID":"20240612165524-6c0reea","Type":"NodeParagraph","Properties":{"id":"20240612165524-6c0reea","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612165524-5w47c0h","Type":"NodeParagraph","Properties":{"id":"20240612165524-5w47c0h","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240612165524-op52v18","Type":"NodeParagraph","Properties":{"id":"20240612165524-op52v18","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612165524-emv9mrd","Type":"NodeParagraph","Properties":{"id":"20240612165524-emv9mrd","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"清半夏"},{"Type":"NodeText","Data":"：取净半夏，大小分开，用8％白矾溶液浸泡至内无干心，口尝微有麻舌感，取出，洗净，切厚片，干燥。每100kg半夏，用白矾20kg。本品为椭圆形、类圆形或不规则片状，切面淡灰色至灰白色，可见灰白色点状或短线状维管束迹，有的残留栓皮处下方显淡紫红色斑纹。质脆，易折断，断面略呈角质样。气微，味微涩、微有麻舌感。"}]},{"ID":"20240612165524-zkoa1q0","Type":"NodeParagraph","Properties":{"id":"20240612165524-zkoa1q0","updated":"20240612165524"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姜半夏"},{"Type":"NodeText","Data":"：取净半夏，大小分开，用水浸泡至内无干心时；另取生姜切片煎汤，加白矾与半夏共煮透，取出，晾至半干，切薄片，干燥。每100kg半夏，用生姜25kg、白矾12.5kg。本品为片状、不规则颗粒状或类球形。表面棕色至棕褐色。质硬脆，断面淡黄棕色，常具角质样光泽。气微香，味淡、微有麻舌感，嚼之略粘牙。"}]},{"ID":"20240612165524-5u9wwm9","Type":"NodeParagraph","Properties":{"id":"20240612165524-5u9wwm9","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612165524-ifyo9zj","Type":"NodeParagraph","Properties":{"id":"20240612165524-ifyo9zj","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末类白色。淀粉粒甚多，单粒类圆形、半圆形或圆多角形，直径2～20μm，脐点裂缝状、人字状或星状；复粒由2～6分粒组成。草酸钙针晶束存在于椭圆形黏液细胞中，或随处散在，针晶长20～110μm。螺纹导管直径10～24μm。"}]},{"ID":"20240612165524-kd7wy0p","Type":"NodeParagraph","Properties":{"id":"20240612165524-kd7wy0p","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末1g，加甲醇10ml，加热回流30分钟，滤过，滤液挥至约0.5ml,作为供试品溶液。另取精氨酸、丙氨酸、缬氨酸、亮氨酸对照品，加70％甲醇制成每1ml 各含1mg 的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液5μl、对照品溶液1μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以正丁醇－冰醋酸－水（8:3:1） 为展开剂，展开，取出，晾干，喷以茚三酮试液，在105℃ 加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240612165524-q9lw05x","Type":"NodeParagraph","Properties":{"id":"20240612165524-q9lw05x","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612165524-hhuag8n","Type":"NodeParagraph","Properties":{"id":"20240612165524-hhuag8n","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、肺经。"}]},{"ID":"20240612165524-7dujmib","Type":"NodeParagraph","Properties":{"id":"20240612165524-7dujmib","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612165524-2yiyjk4","Type":"NodeParagraph","Properties":{"id":"20240612165524-2yiyjk4","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 辛，温；有毒。"}]},{"ID":"20240612165524-0t88gkm","Type":"NodeParagraph","Properties":{"id":"20240612165524-0t88gkm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612165524-oz3mgvt","Type":"NodeParagraph","Properties":{"id":"20240612165524-oz3mgvt","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 不宜与乌头类药材同用。"}]},{"ID":"20240612165524-r5uwepu","Type":"NodeParagraph","Properties":{"id":"20240612165524-r5uwepu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612165524-9uv4yb1","Type":"NodeParagraph","Properties":{"id":"20240612165524-9uv4yb1","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 燥湿化痰，降逆止呕，消痞散结。用于痰多咳喘，痰饮眩悸，风痰眩晕，痰厥头痛，呕吐反胃，胸脘痞闷，梅核气；生用外治痈肿痰核。姜半夏多用于降逆止呕。"}]},{"ID":"20240612165524-9ehyhcb","Type":"NodeParagraph","Properties":{"id":"20240612165524-9ehyhcb","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612165524-ptw1l4u","Type":"NodeParagraph","Properties":{"id":"20240612165524-ptw1l4u","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 3～9g。外用适量，磨汁涂或研末以酒调敷患处。"}]},{"ID":"20240612165524-onkp3wn","Type":"NodeParagraph","Properties":{"id":"20240612165524-onkp3wn","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612165524-fo7f32q","Type":"NodeParagraph","Properties":{"id":"20240612165524-fo7f32q","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612165524-u3ipwjc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165524-u3ipwjc","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：半夏"}]},{"ID":"20240612165524-ozaxw5c","Type":"NodeParagraph","Properties":{"id":"20240612165524-ozaxw5c","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612165524-gxsqi5t","Type":"NodeParagraph","Properties":{"id":"20240612165524-gxsqi5t","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" Bàn Xià"}]},{"ID":"20240612165524-m5zx7zj","Type":"NodeParagraph","Properties":{"id":"20240612165524-m5zx7zj","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612165524-7faegdo","Type":"NodeParagraph","Properties":{"id":"20240612165524-7faegdo","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 地文、水玉（《本经》），守田、示姑（《别录》），羊眼半夏（《唐本草》），和姑（《纲目》），蝎子草（《植物名实图考》），地珠半夏（《昆明药植调查报告》），麻芋果（《贵州民间方药集》），三步跳、泛石子（《湖南野生植物》），地鹧鸪、地茨菇（《广西中兽医药植》），老黄嘴、老和尚头、野芋头，老鸹头（《江苏植药志》），捉嘴豆子，地巴豆（《河北药材》），无心菜根、天落星、老鸹眼、麻芋子（《山东中药》），地雷公、老瓜蒜、狗芋头（《中药志》），珠半夏（《广西中药志》），裂刀菜（《辽宁经济植物志》），麻草子（安徽《"}]},{"ID":"20240612165524-olin704","Type":"NodeParagraph","Properties":{"id":"20240612165524-olin704","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612165524-lrg91t1","Type":"NodeParagraph","Properties":{"id":"20240612165524-lrg91t1","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612165524-qd3thq3","Type":"NodeParagraph","Properties":{"id":"20240612165524-qd3thq3","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612165524-ate5d9u","Type":"NodeParagraph","Properties":{"id":"20240612165524-ate5d9u","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 为天南星科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。7～9月间采挖，洗净泥土，除去外皮，晒干或烘干。"}]},{"ID":"20240612165524-hj56x0g","Type":"NodeParagraph","Properties":{"id":"20240612165524-hj56x0g","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612165524-edw86az","Type":"NodeParagraph","Properties":{"id":"20240612165524-edw86az","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 野生于山坡、溪边阴湿的草丛中或林下。我国大部分地区有分布。全国大部分地区均产；主产四川、湖北、安徽、江苏、河南，浙江等地；以四川产量大、质量好。"}]},{"ID":"20240612165524-qsq8odn","Type":"NodeParagraph","Properties":{"id":"20240612165524-qsq8odn","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612165524-kry5pxx","Type":"NodeParagraph","Properties":{"id":"20240612165524-kry5pxx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 半夏，又名：三叶半夏。多年生小草本，高15～30厘米。块茎近球形。叶出自块茎顶端，叶柄长6～23厘米，在叶柄下部内侧生一白色珠芽；一年生的叶为单叶，卵状心形；2～3年后，叶为3小叶的复叶，小叶椭圆形至披针形，中间小叶较大，长5～8厘米，宽3～4厘米，两侧的较小，先端锐尖，基部楔形，全缘，两面光滑无毛。肉穗花序顶生，花序梗常较叶柄长；佛焰苞绿色，长6～7厘米；花单性，无花被，雌雄同株；雄花着生在花序上部，白色，雄蕊密集成圆筒形，雌花着生于雄花的下部，绿色，两者相距5～8毫米；花序中轴先端附属物延伸呈鼠尾状，通常长7～10厘米，直立，伸出在佛焰苞外。浆果卵状椭圆形，绿色，长4～5毫米。花期5～7月。果期8～9月。"}]},{"ID":"20240612165524-gnki2uk","Type":"NodeParagraph","Properties":{"id":"20240612165524-gnki2uk","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612165524-r315gvj","Type":"NodeParagraph","Properties":{"id":"20240612165524-r315gvj","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 干燥块茎呈圆球形、半圆球形或偏斜状，直径0.8～2厘米。表面白色，或浅黄色，未去净的外皮呈黄色斑点。上端多圆平，中心有凹陷的黄棕色的茎痕，周围密布棕色凹点状须根痕，下面钝圆而光滑。质坚实，致密。纵切面呈肾脏形，洁白，粉性充足；质老或干燥过程不适宜者呈灰白色或显黄色纹。粉末嗅之呛鼻，味辛辣，嚼之发粘，麻舌而刺喉。以个大、皮净、色白、质坚实、粉性足者为佳。以个小、去皮不净、色黄白、粉性小者为次。"}]},{"ID":"20240612165524-c3y6uyo","Type":"NodeParagraph","Properties":{"id":"20240612165524-c3y6uyo","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612165524-s1174ll","Type":"NodeParagraph","Properties":{"id":"20240612165524-s1174ll","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 曾有报道，4例误食生半夏0.1～0.2克、1.4克、1.8克、2.4克而引起中毒者，症状表现主要为口腔及咽喉部粘膜的烧灼感和麻辣味，胃部不适、恶心及胸前压迫感。4例中除1例因误食量甚少而自愈外，其余3例均经服生姜而痊愈。"}]},{"ID":"20240612165524-29h8vuq","Type":"NodeParagraph","Properties":{"id":"20240612165524-29h8vuq","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612165524-j9bmjur","Type":"NodeParagraph","Properties":{"id":"20240612165524-j9bmjur","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 块茎含挥发油、少量脂肪（其脂肪酸约34％为固体酸、66％为液体酸）、淀粉、烟碱、粘液质、天门冬氨酸、谷氨酸、精氨酸、β-氨基丁酸等氨基酸、β-谷甾醇、胆碱、β-谷甾醇-β-D-葡萄糖甙、3，4-二羟基苯甲醛，又含药理作用与毒芹碱及烟碱相似的生物碱、类似原白头翁素刺激皮肤的物质。嫩芽含尿黑酸及其甙。"}]},{"ID":"20240612165524-56cp5uv","Type":"NodeParagraph","Properties":{"id":"20240612165524-56cp5uv","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612165524-u6n10cv","Type":"NodeParagraph","Properties":{"id":"20240612165524-u6n10cv","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 生半夏：拣去杂质，筛去灰屑。法半夏：取净半夏，用凉水浸漂，避免日晒，根据其产地质量及其颗粒大小，斟酌调整浸泡日数。泡至10日后，如起白沫时，每半夏100斤加白矾2斤，泡1日后再进行换水，至口尝稍有麻辣感为度，取出略晾。另取甘草碾成粗块，加水煎汤，用甘草汤泡石灰块，再加水混合，除去石灰渣，倒入半夏缸中浸泡，每日搅拌，使其颜色均匀，至黄色已浸透，内无白心为度。捞出，阴干。（每半夏100斤，用白矾2斤，甘草16斤，石灰块20斤）"}]},{"ID":"20240612165524-7m4y0gk","Type":"NodeParagraph","Properties":{"id":"20240612165524-7m4y0gk","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"姜半夏：取拣净的半夏，照上述法半夏项下的方法浸泡至口尝稍有麻辣感后，另取生姜切片煎汤，加白矾与半夏共煮透，取出，晾至六成干，闷润后切片，晾干。（每半夏100斤，用生姜25斤，白矾12斤8两，夏季用14斤8两）"}]},{"ID":"20240612165524-9eunpx7","Type":"NodeParagraph","Properties":{"id":"20240612165524-9eunpx7","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"清半夏：取拣净的半夏，照上述法半夏项下的方法浸泡至口尝稍有麻辣感后，加白矾与水共煮透，取出，晾至六成干，闷润后切片，晾干。（每半夏100斤，用白矾12斤8两，夏季用14斤8两）"}]},{"ID":"20240612165524-k9usqpp","Type":"NodeParagraph","Properties":{"id":"20240612165524-k9usqpp","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"修事半夏四两，用捣了白芥子末二两，头醋六两，二味搅令浊，将半夏投于中，洗三遍用之。半夏上有隟涎，若洗不尽，令人气逆，肝气怒满。\""}]},{"ID":"20240612165524-parp3gl","Type":"NodeParagraph","Properties":{"id":"20240612165524-parp3gl","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"半夏，用之皆先汤洗十许过，令滑尽，不尔戟人咽喉。\""}]},{"ID":"20240612165524-7l4uclq","Type":"NodeParagraph","Properties":{"id":"20240612165524-7l4uclq","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612165524-kpvrc1i","Type":"NodeParagraph","Properties":{"id":"20240612165524-kpvrc1i","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240612165524-5i2iecu","Type":"NodeParagraph","Properties":{"id":"20240612165524-5i2iecu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足阳明、太阴、少阳经。\""}]},{"ID":"20240612165524-r86nnvf","Type":"NodeParagraph","Properties":{"id":"20240612165524-r86nnvf","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、脾、胃三经。\""}]},{"ID":"20240612165524-g1uda9f","Type":"NodeParagraph","Properties":{"id":"20240612165524-g1uda9f","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足太阴、阳明、少阳，手少阴经。\""}]},{"ID":"20240612165524-x2y41p0","Type":"NodeParagraph","Properties":{"id":"20240612165524-x2y41p0","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》：\"入手阳明、太阴、少阴三经。\""}]},{"ID":"20240612165524-hok67kb","Type":"NodeParagraph","Properties":{"id":"20240612165524-hok67kb","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑤《本草再新》：\"入肝、脾、肺三经。\""}]},{"ID":"20240612165524-onanxxf","Type":"NodeParagraph","Properties":{"id":"20240612165524-onanxxf","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612165524-499p8pd","Type":"NodeParagraph","Properties":{"id":"20240612165524-499p8pd","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 辛，温，有毒。"}]},{"ID":"20240612165524-ln2t4lx","Type":"NodeParagraph","Properties":{"id":"20240612165524-ln2t4lx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"辛，平。\""}]},{"ID":"20240612165524-iawjnat","Type":"NodeParagraph","Properties":{"id":"20240612165524-iawjnat","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"生微寒，熟温，有毒。\""}]},{"ID":"20240612165524-ler6k0p","Type":"NodeParagraph","Properties":{"id":"20240612165524-ler6k0p","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"有大毒。\""}]},{"ID":"20240612165524-psaf2lx","Type":"NodeParagraph","Properties":{"id":"20240612165524-psaf2lx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"味辛。\""}]},{"ID":"20240612165524-wl1ry8z","Type":"NodeParagraph","Properties":{"id":"20240612165524-wl1ry8z","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑤（医学启源》：\"《主治秘要》云，性温，味辛苦。\""}]},{"ID":"20240612165524-bemitze","Type":"NodeParagraph","Properties":{"id":"20240612165524-bemitze","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612165524-nb6f4ky","Type":"NodeParagraph","Properties":{"id":"20240612165524-nb6f4ky","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 一切血证及阴虚燥咳、津伤口渴者忌服。"}]},{"ID":"20240612165524-dgxg533","Type":"NodeParagraph","Properties":{"id":"20240612165524-dgxg533","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"射干为之使。恶皂荚。畏雄黄、生姜、干姜、秦皮、龟甲。反乌头。\""}]},{"ID":"20240612165524-xcpv1zs","Type":"NodeParagraph","Properties":{"id":"20240612165524-xcpv1zs","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"忌羊血、海藻、饴糖。柴胡为之使。\""}]},{"ID":"20240612165524-ergu2ys","Type":"NodeParagraph","Properties":{"id":"20240612165524-ergu2ys","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"③张元素：\"诸血证及口渴者禁用。孕妇忌之，用生姜则无害。\""}]},{"ID":"20240612165524-xk3znb3","Type":"NodeParagraph","Properties":{"id":"20240612165524-xk3znb3","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"④《医学入门》：\"凡诸血证及自汗，渴者禁用。\""}]},{"ID":"20240612165524-ifox5vh","Type":"NodeParagraph","Properties":{"id":"20240612165524-ifox5vh","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612165524-p4wxik1","Type":"NodeParagraph","Properties":{"id":"20240612165524-p4wxik1","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 燥湿化痰，降逆止呕，消痞散结。治湿痰冷饮，呕吐，反胃，咳喘痰多，胸膈胀满，痰厥头痛，头晕不眠。外消痈肿。"}]},{"ID":"20240612165524-na6jovk","Type":"NodeParagraph","Properties":{"id":"20240612165524-na6jovk","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"用于痰多咳喘、痰饮眩悸、内痰眩晕、呕吐反胃、胸脘痞闷、梅核气症；生用外治痈肿痰核。姜半夏多用于降逆止呕。"}]},{"ID":"20240612165524-xiko83u","Type":"NodeParagraph","Properties":{"id":"20240612165524-xiko83u","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（1）燥湿化痰：用于痰清稀而多之湿痰、寒痰，常配陈皮。"}]},{"ID":"20240612165524-82rfpli","Type":"NodeParagraph","Properties":{"id":"20240612165524-82rfpli","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（2）降逆止呕：降逆止呕之功颇着，可用于各种呕吐，尤宜于湿浊中阻所致的脘闷呕吐，常配生姜、茯苓。热证呕吐，应配清热泻火药。"}]},{"ID":"20240612165524-w833uux","Type":"NodeParagraph","Properties":{"id":"20240612165524-w833uux","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（3）消肿止痛：外用治疮疡肿毒、毒蛇咬伤。"}]},{"ID":"20240612165524-msqidxr","Type":"NodeParagraph","Properties":{"id":"20240612165524-msqidxr","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤寒寒热，心下坚，下气，喉咽肿痛，头眩胸胀，咳逆，肠鸣，止汗。\""}]},{"ID":"20240612165524-qonedpr","Type":"NodeParagraph","Properties":{"id":"20240612165524-qonedpr","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"消心腹胸膈痰热满结，咳嗽上气，心下急痛坚痞，时气呕逆；消痈肿，堕胎，疗痿黄，悦泽面目。生令人吐，熟令人下。\""}]},{"ID":"20240612165524-476vneh","Type":"NodeParagraph","Properties":{"id":"20240612165524-476vneh","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"消痰涎，开胃健脾，止呕吐，去胸中痰满，下肺气，主咳结。新生者摩涂痈肿不消，能除瘤瘿。气虚而有痰气，加而用之。\""}]},{"ID":"20240612165524-vs72yqm","Type":"NodeParagraph","Properties":{"id":"20240612165524-vs72yqm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治吐食反胃，霍乱转筋，肠腹冷，痰疟。\""}]},{"ID":"20240612165524-q4e2mqw","Type":"NodeParagraph","Properties":{"id":"20240612165524-q4e2mqw","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑤《本草图经》：\"主胃冷，呕哕。\""}]},{"ID":"20240612165524-n41t88v","Type":"NodeParagraph","Properties":{"id":"20240612165524-n41t88v","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"治寒痰及形寒钦冷伤肺而咳，大和胃气，除胃寒，进饮食。治太阳痰厥头痛，非此不能除。《主治秘要》云，燥胃湿，化痰，益脾胃气，消肿散结，除胸中痰涎。\""}]},{"ID":"20240612165524-3qn44ph","Type":"NodeParagraph","Properties":{"id":"20240612165524-3qn44ph","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑦朱震亨：\"治眉棱骨痛。\""}]},{"ID":"20240612165524-d9xs4v4","Type":"NodeParagraph","Properties":{"id":"20240612165524-d9xs4v4","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"治腹胀，目不得瞑，白浊，梦遗，带下。\""}]},{"ID":"20240612165524-5e9e53d","Type":"NodeParagraph","Properties":{"id":"20240612165524-5e9e53d","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612165524-6yeek44","Type":"NodeParagraph","Properties":{"id":"20240612165524-6yeek44","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钨；或入丸、散。外用：研末调默。"}]},{"ID":"20240612165524-xhz7i9j","Type":"NodeParagraph","Properties":{"id":"20240612165524-xhz7i9j","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612165524-ic38jth","Type":"NodeParagraph","Properties":{"id":"20240612165524-ic38jth","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" ①治湿痰，咳嗽脉缓，面黄，肢体沉重，嗜卧不收，腹胀而食不消化：南星、半夏（俱汤洗）各一两，白术一两半。上为细末，糊为丸，如桐子大.每服五、七十丸，生姜汤下。（《紊问病机保命集》）"}]},{"ID":"20240612165524-xyd9vv7","Type":"NodeParagraph","Properties":{"id":"20240612165524-xyd9vv7","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②治湿痰喘急，止心痛：半夏不拘多少，香油炒，为末，粥丸梧子大。每服三、五十丸，姜汤下。（《丹溪心法》）"}]},{"ID":"20240612165524-hp5rgd7","Type":"NodeParagraph","Properties":{"id":"20240612165524-hp5rgd7","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"③治痰饮咳嗽：大半夏一斤，汤泡七次，晒干，为细末，用生绢袋盛贮，于磁盆内用净水洗，出去粗柤，将洗出半夏末，就于盆内日晒夜露，每日换新水，七日七夜了，澄去水，晒干，每半夏粉一两，入飞过细朱砂末一钱，用生姜汁糊为丸，如梧桐子大。每服七十丸，用淡生姜汤下，食后服。（《袖珍方》辰砂半夏丸）"}]},{"ID":"20240612165524-guzjsaz","Type":"NodeParagraph","Properties":{"id":"20240612165524-guzjsaz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"④治心下有支饮（呕家本渴，渴者为欲解，今反不渴）：半夏一升，生姜半斤。上二味，以水七升，煮取一升半，分温再服。（《金匮要略》小半夏汤）"}]},{"ID":"20240612165524-rq9ul9x","Type":"NodeParagraph","Properties":{"id":"20240612165524-rq9ul9x","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑤治肺胃虚弱，好食酸冷，寒痰停积，呕逆恶心，涎唾稠粘，或积吐，粥药不下，手足逆冷，目眩身重；又治伤寒时气，欲吐不吐，欲呕不呕，昏瞶闷乱，或饮酒过多，中寒停饮，喉中涎声，干哕不止：陈皮（去白）、半夏（煮）各七两。上二件，锉为粗散，每服三钱，生姜十片，水二盏，煎至一中盏，去滓温服，不拘时候。留二服滓并作一服，再煎服。（《局方》橘皮半夏汤）"}]},{"ID":"20240612165524-xqq7n6i","Type":"NodeParagraph","Properties":{"id":"20240612165524-xqq7n6i","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑥治卒呕吐，心下痞，膈间有水，眩悸者：半夏一升，生姜半斤，茯芩三两。上三味，以水七升，煮取一升五合，分温再服。（《金匮要略》小半夏加茯苓汤）"}]},{"ID":"20240612165524-bec3x3v","Type":"NodeParagraph","Properties":{"id":"20240612165524-bec3x3v","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑦治胃反呕吐者：半夏二升（洗完用），人参三两，白蜜一升。上三味，以水一斗二升，和蜜汤之二百四十遍，煮药取二升半，温服一升，余分再服。（《金匮要略》大半夏汤）"}]},{"ID":"20240612165524-tbjv0us","Type":"NodeParagraph","Properties":{"id":"20240612165524-tbjv0us","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑧治妊娠呕吐不止：干姜、人参各一两，半夏二两。上三味，末之，以生姜汁糊为丸，如梧子大。饮服十丸，日三服。（《金匮要略》干姜人参半夏丸）"}]},{"ID":"20240612165524-jocnqqm","Type":"NodeParagraph","Properties":{"id":"20240612165524-jocnqqm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑨治小儿痰热，咳嗽惊悸：半夏、南星等分，为末，牛胆汁，入胆内和，悬风处待干，蒸饼丸，绿豆大。每服三、五丸，姜汤下。（《摘元方》）"}]},{"ID":"20240612165524-in243sz","Type":"NodeParagraph","Properties":{"id":"20240612165524-in243sz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑩治霍乱心腹胀痛，烦满短气，未得吐下：桂、半夏等分。末，方寸匕，水一升，和服之。（《补缺肘后方》）"}]},{"ID":"20240612165524-jcb2ndj","Type":"NodeParagraph","Properties":{"id":"20240612165524-jcb2ndj","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑾除积冷，暖元藏，温脾胃，进饮食，治心腹一切痃癖冷气及年高风秘、冷秘或泄泻：半夏（汤浸七次，焙干，为细末）、硫黄（明净好者，研令极细）。上等分，以生姜自然汁同熬，入干蒸饼末搅和匀，入臼内杵数百下，丸如梧桐子大。每服空心温酒或生姜汤下十五丸至二十丸，妇人醋汤下。（《局方》半硫丸）"}]},{"ID":"20240612165524-92hjtb0","Type":"NodeParagraph","Properties":{"id":"20240612165524-92hjtb0","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑿治痰厥：半夏八两，防风四两，甘草二两。同为细末，分作四十服，每服用水一大盏半，姜二十片，煎至七分，去滓温服，不计时侯。（《卫生家宝方》省风汤）"}]},{"ID":"20240612165524-vwk92qt","Type":"NodeParagraph","Properties":{"id":"20240612165524-vwk92qt","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒀治目不瞑，不卧：以流水千里已外者八升，扬之万遍，取其清五升煮之，炊以苇薪火，沸，置秫米一升，治半夏五合，徐炊令竭，为一升半，去其滓，饮汁一小杯，日三，稍益，以知为度。（《灵枢》半夏秫米汤）"}]},{"ID":"20240612165524-cgii7ox","Type":"NodeParagraph","Properties":{"id":"20240612165524-cgii7ox","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒁治少阴病，咽中痛：半夏（洗）、桂枝（去皮）、甘草（炙）。上三味等分，各别捣筛已，合治之，白饮和服方寸匕，日三服。若不能服散者，以水一升，煎七沸，纳散两方寸匕，更煮三沸，下火令小冷，少少咽之。（《伤寒论》半夏散及汤）"}]},{"ID":"20240612165524-p9hewjh","Type":"NodeParagraph","Properties":{"id":"20240612165524-p9hewjh","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒂治痰结，咽喉不利，语音不出：半夏（洗）五钱，草乌一字（炒），桂一字（炙）。上同为末，生姜汁浸蒸饼为丸，如鸡头大，每服一丸，至夜含化。（《素问病机保命集》玉粉丸）"}]},{"ID":"20240612165524-xbu0f1n","Type":"NodeParagraph","Properties":{"id":"20240612165524-xbu0f1n","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒃治喉痹肿塞：生半夏末搐鼻内，涎出效。（《濒湖集简方》）"}]},{"ID":"20240612165524-z3c8oqx","Type":"NodeParagraph","Properties":{"id":"20240612165524-z3c8oqx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒄治产后晕绝：半夏末，冷水和丸，大豆大，纳鼻中。（《肘后方》）"}]},{"ID":"20240612165524-1pd5hzn","Type":"NodeParagraph","Properties":{"id":"20240612165524-1pd5hzn","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒅治奶发，诸痈疽发背及乳方：末半夏，鸡于白和涂之，水磨敷。（《补缺肘后方》）"}]},{"ID":"20240612165524-ntki5kz","Type":"NodeParagraph","Properties":{"id":"20240612165524-ntki5kz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒆治小儿惊风：生半夏一钱，皂角半钱。为末，吹少许入鼻。（《仁斋直指方》嚏惊散）"}]},{"ID":"20240612165524-yetrlfc","Type":"NodeParagraph","Properties":{"id":"20240612165524-yetrlfc","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⒇治重舌木舌，肿大塞口：半夏煎醋，合漱之。（《纲目》）"}]},{"ID":"20240612165524-0m5cuew","Type":"NodeParagraph","Properties":{"id":"20240612165524-0m5cuew","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（21）治诸瘘五六孔相通：生半夏末，水调涂孔内，一日二次。（《外科小品》）"}]},{"ID":"20240612165524-4pqipqm","Type":"NodeParagraph","Properties":{"id":"20240612165524-4pqipqm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（22）治外伤性出血：生半夏、乌贼骨等分，研细末，撒患处。（徐州《单方验方新医疗法选编》）"}]},{"ID":"20240612165524-4mgr59u","Type":"NodeParagraph","Properties":{"id":"20240612165524-4mgr59u","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（23）治蛇伤：鲜半夏、鸭食菜（苦麻菜）、香蒿尖各等量，混合捣碎成膏状，敷于伤处。（辽宁《中草药新医疗法资料选编》）"}]},{"ID":"20240612165524-gzqzcqv","Type":"NodeParagraph","Properties":{"id":"20240612165524-gzqzcqv","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（24）老人风痰。用半夏（泡七次，焙过）、硝石各半两，共研为末，加入白面捣匀，调水做成丸子，如绿豆大。每服五十丸，姜汤送下。"}]},{"ID":"20240612165524-kfgr5wu","Type":"NodeParagraph","Properties":{"id":"20240612165524-kfgr5wu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（25）风痰头晕（哎逆目眩，面色黄，脉弦）。用生半夏、生天南星、寒水石（煅）各一两，天麻半两，雄黄二钱，小麦面三两，共研为末，加水和成饼，水煮浮起，取出捣烂做成丸子，如梧子大。每服五十丸，姜汤送下。极效。亦治风痰咳嗽、二便不通、风痰头痛等病。"}]},{"ID":"20240612165524-6y6daxj","Type":"NodeParagraph","Properties":{"id":"20240612165524-6y6daxj","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（26）热痰咳嗽（烦热面赤，口燥心痛，脉洪数）。用半夏、天南星各一两，黄芩一两半，共研为末，加姜汁浸蒸饼做成丸子，如梧子大。每服五十至七十丸，饭后服，姜汤送下。此方名\"小黄丸\"。"}]},{"ID":"20240612165524-85dqss6","Type":"NodeParagraph","Properties":{"id":"20240612165524-85dqss6","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（27）湿痰咳嗽（面黄体重，贪睡易惊，消化力弱，脉缓）。用半夏、天南星各一两，白术一两半，共研为末加薄糊做成丸子，如梧子大。每服五十至七十丸姜汤送下。此方名\"白术丸\"。"}]},{"ID":"20240612165524-fprze78","Type":"NodeParagraph","Properties":{"id":"20240612165524-fprze78","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（28）气痰咳嗽（面白气促，洒淅恶寒，忧悉不乐，脉涩）。用半夏、天南星各一两，官桂半两，共研为末，加糊做成丸子，如梧子大。每服五十丸，姜汤送下。此方名\"玉粉丸\"。"}]},{"ID":"20240612165524-sv3nnuc","Type":"NodeParagraph","Properties":{"id":"20240612165524-sv3nnuc","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（29）呕吐反胃。用半夏三升、人参三两、白蜜一升、水一半二千，细捣过，煮成三升半，温服一升。一天服两次。此方名为\"大半夏汤\"。"}]},{"ID":"20240612165524-7s9ys42","Type":"NodeParagraph","Properties":{"id":"20240612165524-7s9ys42","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（30）黄疸喘满，小便自利，不可除热。用半夏、生姜各半斤，加水七升，煮取一升五合，分两次服下。"}]},{"ID":"20240612165524-d032hpz","Type":"NodeParagraph","Properties":{"id":"20240612165524-d032hpz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（31）老人便结。用半夏（泡，炒）、生硫磺，等分为末加自然姜汁煮糊做成丸子，如梧子大。每服五十丸，空心服，温酒送下。此方名\"半硫丸\"。"}]},{"ID":"20240612165524-28zmpn6","Type":"NodeParagraph","Properties":{"id":"20240612165524-28zmpn6","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（32）失血喘急（吐血下血，崩中带下，喘急痰呕，中满宿瘀）。用半夏捶扁，包在以姜汁调匀的面中，放火上煨黄，研为末，加米糊成丸子，如梧子大。每服三十丸，白开水送下。"}]},{"ID":"20240612165524-jn1yw7g","Type":"NodeParagraph","Properties":{"id":"20240612165524-jn1yw7g","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（33）喉痹肿塞。用生半夏末 鼻内，涎出见效。"}]},{"ID":"20240612165524-7flssv5","Type":"NodeParagraph","Properties":{"id":"20240612165524-7flssv5","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"（34）骨鲠在咽。用半夏、白牙，等分为末，取一匙，水冲服，当呕出。忌食羊肉。"}]},{"ID":"20240612165524-f2qvbt0","Type":"NodeParagraph","Properties":{"id":"20240612165524-f2qvbt0","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612165524-z7a9ucm","Type":"NodeParagraph","Properties":{"id":"20240612165524-z7a9ucm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" ①治疗呕吐"}]},{"ID":"20240612165524-mt3iitv","Type":"NodeParagraph","Properties":{"id":"20240612165524-mt3iitv","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"用姜半夏制成1：1注射液，肌肉注射，每次2毫升。治疗各种呕吐，临床上可代替\"爱茂尔\"应用，有人认为其镇吐作用比\"爱茂尔\"强两倍多。未发现副作用。"}]},{"ID":"20240612165524-aa91oai","Type":"NodeParagraph","Properties":{"id":"20240612165524-aa91oai","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"②治疗疟疾"}]},{"ID":"20240612165524-o6r8sqd","Type":"NodeParagraph","Properties":{"id":"20240612165524-o6r8sqd","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"生半夏2钱，捣烂置于胶布上。于疟疾发作前3～4小时贴于脐部，可控制发作。"}]},{"ID":"20240612165524-qnattba","Type":"NodeParagraph","Properties":{"id":"20240612165524-qnattba","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"③治疗急性乳腺炎"}]},{"ID":"20240612165524-mvxxauf","Type":"NodeParagraph","Properties":{"id":"20240612165524-mvxxauf","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"取生半夏1～2钱，葱白2～3根，共捣烂，揉成团（亦可用生半夏捣细和米饭少许捏成丸），塞于患乳对侧鼻孔，每日2次，每次塞半小时。用于急性乳腺炎早期计72例，多数治疗2～3次见效。"}]},{"ID":"20240612165524-o3fi85m","Type":"NodeParagraph","Properties":{"id":"20240612165524-o3fi85m","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"④治疗鸡眼"}]},{"ID":"20240612165524-ns1ko0e","Type":"NodeParagraph","Properties":{"id":"20240612165524-ns1ko0e","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"半夏研末敷于患部。用药前先洗净患处，消毒后用手术刀削去鸡眼的角化组织，呈一凹面，然后放入半夏末，外贴胶布。经5～7天后，鸡眼坏死脱落，生出新生肉芽组织，再过数日即可痊愈。治疗30余例未见复发。"}]},{"ID":"20240612165524-tjyu25t","Type":"NodeParagraph","Properties":{"id":"20240612165524-tjyu25t","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑤治疗牙痛"}]},{"ID":"20240612165524-g5lrprf","Type":"NodeParagraph","Properties":{"id":"20240612165524-g5lrprf","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"生半夏1两，捣碎，置于90％酒精3两中，浸泡1日后即可使用。用时以棉球蘸药液塞入龋齿洞中，或涂擦痛牙周围。治疗100余例，95％以上患者均有效果。"}]},{"ID":"20240612165524-omi5z1o","Type":"NodeParagraph","Properties":{"id":"20240612165524-omi5z1o","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑥治疗急慢性化脓性中耳炎"}]},{"ID":"20240612165524-ozair9c","Type":"NodeParagraph","Properties":{"id":"20240612165524-ozair9c","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"生半夏研末溶于米酒或50％酒精中（1份半夏，3份酒精），浸泡24小时以上，取上层澄清液滴耳。用时先用双氧水洗涤外耳道，然后滴入药液数滴，每天1～2次。据10例观察，对急性中耳炎效果较好，一般1～2天见效，1周内可治愈。"}]},{"ID":"20240612165524-3hsr30m","Type":"NodeParagraph","Properties":{"id":"20240612165524-3hsr30m","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑦预防和减轻血吸虫病口服锑剂的中毒反应"}]},{"ID":"20240612165524-3lzjyog","Type":"NodeParagraph","Properties":{"id":"20240612165524-3lzjyog","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"口服锑剂治疗血吸虫病过程中，呕吐是常见的毒性反应，往往迫使治疗中断；如于口撮锑剂同时加服法半夏粉与甘草粉，则有预防或减轻中毒反应的作用。每口服锑剂1次，服半夏粉3.2分，生甘草粉4.8分。据12例观察，一般服药期间都能照常工作，精神愉快，食欲正常；仅4例有轻微不适：略感恶心呕吐，或短暂的腹痛或腹泻，均不影响工作。"}]},{"ID":"20240612165524-0r58zra","Type":"NodeParagraph","Properties":{"id":"20240612165524-0r58zra","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"⑧治疗矽肺"}]},{"ID":"20240612165524-kmjuamf","Type":"NodeParagraph","Properties":{"id":"20240612165524-kmjuamf","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"据144例各期患者的初步观察，对主观症状有不同程度的改善；客观检查除个别病例的血清粘蛋白下降和血矽增高外，其它检查（如X线摄片）尚无明显变化。少数病例对肝功能有不良影响，尿中出现红细胞，故应用时应紧密注意肝肾的毒性反应。用法：用姜半夏口服、肌肉注射或喷雾给药，剂量一般为每日7钱。治疗持续1～10个月不等，大多在3～5个月左右。"}]},{"ID":"20240612165524-ht3hq21","Type":"NodeParagraph","Properties":{"id":"20240612165524-ht3hq21","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612165524-553l85v","Type":"NodeParagraph","Properties":{"id":"20240612165524-553l85v","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 除上述品种外，尚有同属植物掌叶半夏的块茎，在江苏、河南、河北、山西等地亦作半夏使用。与半夏的主要区别点为：掌叶半夏的块茎较大，通常直径3～4厘米；叶片掌状，有小叶9～11枚。参见\"掌叶半夏\"条。"}]},{"ID":"20240612165524-23ugipo","Type":"NodeParagraph","Properties":{"id":"20240612165524-23ugipo","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612165524-xevf14v","Type":"NodeParagraph","Properties":{"id":"20240612165524-xevf14v","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612165524-4ykovxc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165524-4ykovxc","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"《中华本草》：半夏"}]},{"ID":"20240612165524-blqgieg","Type":"NodeParagraph","Properties":{"id":"20240612165524-blqgieg","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612165524-n7n5afz","Type":"NodeParagraph","Properties":{"id":"20240612165524-n7n5afz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" Bàn Xià"}]},{"ID":"20240612165524-dt7mp65","Type":"NodeParagraph","Properties":{"id":"20240612165524-dt7mp65","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612165524-85fnx3c","Type":"NodeParagraph","Properties":{"id":"20240612165524-85fnx3c","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 水玉、地文、和姑、害田、示姑、羊眼半夏、地珠半夏、麻芋果、三步跳、泛石子、老和尚头、老鸹头、地巴豆、无心菜根、老鸹眼、地雷公、狗芋头"}]},{"ID":"20240612165524-ry3io16","Type":"NodeParagraph","Properties":{"id":"20240612165524-ry3io16","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612165524-2zqil4t","Type":"NodeParagraph","Properties":{"id":"20240612165524-2zqil4t","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" Pinellia Tuber, Tuber of Pinellia"}]},{"ID":"20240612165524-h5zbztn","Type":"NodeParagraph","Properties":{"id":"20240612165524-h5zbztn","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612165524-sdlqaez","Type":"NodeParagraph","Properties":{"id":"20240612165524-sdlqaez","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.《御药院方》：法制半夏，清痰化饮，壮脾顺气。用大半夏汤洗七次，焙干再洗，如此七转，以浓米泔浸一日夜。每一两用白矾一两半，温水化浸五日，焙干。以铅白霜一钱，温水化，又浸七日，以浆水慢火内煮沸，焙干收之。每嚼一、二粒，姜汤送化下。红半夏，消风热，清痰涎，降气利咽。大半夏汤浸焙制如上法。每一两入龙脑五分，朱砂为衣染之。先铺灯草一重，约一指厚，排半夏于上，再以灯草盖一指厚，以炒豆焙之"}]},{"ID":"20240612165524-ymq3uq1","Type":"NodeParagraph","Properties":{"id":"20240612165524-ymq3uq1","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612165524-4rn1gbd","Type":"NodeParagraph","Properties":{"id":"20240612165524-4rn1gbd","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 药材基源：为天南星科半夏的块茎。"}]},{"ID":"20240612165524-ib288ba","Type":"NodeParagraph","Properties":{"id":"20240612165524-ib288ba","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Pinellia ternata (Thunb.) Breit.[Arumternatum Thunb.]"}]},{"ID":"20240612165524-nhut5zu","Type":"NodeParagraph","Properties":{"id":"20240612165524-nhut5zu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"采收和储藏：种子繁殖培育3年；珠芽繁殖培育在第2年，块茎繁殖春栽当年9月下旬至11月收获。挖取块茎，筛去泥土，按大、中、小分开，放筐内，于流水下用棍棒捣脱皮，也可用半夏脱皮机去皮，洗净，晒干或烘干。"}]},{"ID":"20240612165524-dd2mard","Type":"NodeParagraph","Properties":{"id":"20240612165524-dd2mard","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612165524-6qh3qel","Type":"NodeParagraph","Properties":{"id":"20240612165524-6qh3qel","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 生态环境：野生于山坡、溪边阴湿的草丛中或林下。"}]},{"ID":"20240612165524-hba7cj0","Type":"NodeParagraph","Properties":{"id":"20240612165524-hba7cj0","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"资源分布：我国大部分地区有分布。"}]},{"ID":"20240612165524-6rp9okg","Type":"NodeParagraph","Properties":{"id":"20240612165524-6rp9okg","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612165524-4ozu3zu","Type":"NodeParagraph","Properties":{"id":"20240612165524-4ozu3zu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 半夏，多年生草本，高15-30cm。块茎球形，直径0.5-1.5cm。叶2-5，幼时单叶，2-3年后为三出复叶；叶柄长达20cm，近基部内侧和复叶基部生有珠芽；叶片卵圆形至窄披针形，中间小叶较大，长5-8cm，两侧小叶轮小，光端锐尖，两面光滑，全线。花序辆与叶辆近等K或更K；佛焰苞卷合成弧曲形管状，绿色，上部内面常为深紫红色；肉德花序顶生；其雌花序轴与佛焰苞贴上，绿色，长6-7cm ；雄花序长2-6cm；附属器长鞭状。浆果卵圆形，绿白色。花期5-7月，果期8月。南方1年出苗2-3次，故9-10月间仍可见到花果。"}]},{"ID":"20240612165524-pwp4vrt","Type":"NodeParagraph","Properties":{"id":"20240612165524-pwp4vrt","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"生于山地、农田、溪边或林下。分布于我国大部分地区。"}]},{"ID":"20240612165524-xdpljz1","Type":"NodeParagraph","Properties":{"id":"20240612165524-xdpljz1","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612165524-vno3m5t","Type":"NodeParagraph","Properties":{"id":"20240612165524-vno3m5t","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温和湿润气候和荫蔽的环境，伯高温、干旱及强光照射，耐寒。选土层深厚、疏松肥沃、排水良好的砂质壤上栽培，土壤粘重不宜种植。忌连作，可与果树、农作物问、套作。"}]},{"ID":"20240612165524-7zd557w","Type":"NodeParagraph","Properties":{"id":"20240612165524-7zd557w","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"栽培技术 半夏有四个品系：小技针叶型、大披针叶型。五出叶型和椭圆型。用快蔓、种片和珠芽繁殖。块茎繁殖：块茎繁殖培更快，当年就叶收获，一般多用此法。9月下旬将地下茎挖出，选横径0.5-11cm的块茎作种，栽种量1hm22250kg左右。秋栽或春栽，行株距为20cm×3cm。珠芽繁殖：在5-6月，选叶柄下成熟的珠穿进行繁殖，计为栽种，行林距为15cm×3cm。种子繁殖：夏秋季种子成熟时，随来随播，也可贮藏于湿沙中翌年春播。条播，行距15cm，开2cm深的沟，将种子撒于沟内，覆土。"}]},{"ID":"20240612165524-1rvn9kr","Type":"NodeParagraph","Properties":{"id":"20240612165524-1rvn9kr","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"田间管理 半夏植株矮小，在生长期间要经常松土除草。除施足基肥外，还要及时进行追肥培土，5月下旬或6月上旬，将圈肥与尿素拌匀，沟施结合培土。如不留种，应摘去半夏的花序，可提高块茎产量。干旱注意浇水，雨季及时排水，防止积水，以防烂根。在无荫蔽的地方栽培，最好与其他作物间作，以防夏季烈日照射为害。"}]},{"ID":"20240612165524-m93yhx8","Type":"NodeParagraph","Properties":{"id":"20240612165524-m93yhx8","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有叶斑病，叮喷1：1：150波尔多液或65%代森锌500倍液。块茎腐烂病叶用50%多菌灵1000倍液喷射。虫害有红天峨，为害叶，可人工捕杀或用90%晶体敌百虫800-1000倍液喷雾。还有金针虫、蛴螬等为害。"}]},{"ID":"20240612165524-j3mu3a9","Type":"NodeParagraph","Properties":{"id":"20240612165524-j3mu3a9","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612165524-9v8zvyg","Type":"NodeParagraph","Properties":{"id":"20240612165524-9v8zvyg","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 块茎呈类球形，有的销偏斜，直径0.8-1.5cm。表面白色或浅黄色，顶端中心有凹陷的茎痕，周围密布棕色凹点状的根痕；下端钝圆，较光滑。质坚实，断面白色，富粉性。气微，味辛辣、麻香而刺喉以个大、质坚实、色白、粉性定者为佳。"}]},{"ID":"20240612165524-vcziquv","Type":"NodeParagraph","Properties":{"id":"20240612165524-vcziquv","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"显微鉴别块茎横切面：沙州社仁薄壁细胞会淀粉拉较少，渐次向内含淀粉植渐多，薄杜州沙小散有椭圆形粘液细胞，内含草酸钙针晶束，针晶长20-144μm。维管束纵横散列。淀粉粒众多，单粒类圆形、半圆形或钝多角形，直径4-30μm，脐点裂颖状、点状或星状；复粒以2-4粒为多见，偶有至8分粒的。"}]},{"ID":"20240612165524-mtsaqot","Type":"NodeParagraph","Properties":{"id":"20240612165524-mtsaqot","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"粉末特征：类白色。①淀粉粒单粒类球形或圆多角形，直径4-30μm，脐点短缝状、点状或星状，大粒层纹陷约可见；复粒由2-8分粒组成。②草酸钙针晶随处散在，或成束存在于椭圆形粘液细胞中针晶长20-144μm。③螺纹及环纹导管直径10-38μm。"}]},{"ID":"20240612165524-34gtkmj","Type":"NodeParagraph","Properties":{"id":"20240612165524-34gtkmj","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612165524-3rde3dt","Type":"NodeParagraph","Properties":{"id":"20240612165524-3rde3dt","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 1.浸膏给小鼠腹腔注射半数致死量为13.142g/kg。家兔灌服0.5g/只/日，连服40日，一般情况良好，体重增加；剂量加倍，多数兔有腹泻，半数兔于20日内死亡。小鼠口服各种制剂的混悬液，以死亡为指标，则生半夏毒性最大，次为漂半夏，再次为生姜浸半夏和蒸半夏，白矾半夏最小。前四种给鸽灌胃均能引起呕吐，喂给豚鼠能使其声音嘶哑或失声，白矾半夏则无此副作用。经白矾处理似能解除半夏的毒性。半夏催吐成分不溶或难溶于水，加热可破坏。半夏水溶成分内加入醋酸铅后沉淀的物质中，含有引起蛙及小鼠骨胳肌痉挛的物质，用碱性醋酸铅生成的沉淀中，含有使蛙瞳孔散大的物质，滤液中则含有使蛙产生中枢性及箭毒样肌麻痹的物质。"}]},{"ID":"20240612165524-8k0cld0","Type":"NodeParagraph","Properties":{"id":"20240612165524-8k0cld0","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"2.毒性：半夏蛋白质皮下注射对小鼠的LD50为175mg/kg。生半夏及漂、姜浸和蒸半夏混悬剂及生半夏煎剂无上述反应；对小鼠急性毒性以生半夏混悬剂毒性最大，漂、姜浸及蒸制毒性依次降低，矾浸及煎剂毒性最低，因此，半夏的止吐、镇咳成分可溶于热水，而刺激咽喉失音及呕吐等毒性成分难于溶于水，不能因蒸、漂或姜浸破坏，但可被矾浸解除其毒性。生半夏粉（混悬液）0.5g/kg灌胃，连续3天，可促进小鼠胃肠运动，抑制大鼠胃液PGE2的分泌，抑制胃蛋白质酶活性，对胃粘膜损伤较大，而姜矾半夏和姜煮半夏抑制小鼠胃肠运动，对大鼠胃液PGE2的含量及胃蛋白酶活性无明显影响，说明两种姜制半夏的方法可消除生半夏对胃肠粘膜的损作用。生半夏、姜半夏、法半夏10g/kg腹腔注射，连续10天，对小鼠胚胎有毒性，并有致畸作用。"}]},{"ID":"20240612165524-8f0qdp4","Type":"NodeParagraph","Properties":{"id":"20240612165524-8f0qdp4","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"3.生半夏浸膏小鼠1次ip的LD50为325mｇ（生药）/kｇ。生半夏混悬液iｇ给药的LD50为42.7±1.27ｇ/kｇ。制半夏混悬液（制半夏按中国药典1985年版方法）iｇ给药，每3小时l次，共5次。总剂量80ｇ/kｇ，观察l周，对小鼠未见任何毒性反应。与同剂量的生半夏组比较，说明炮制用的白矾对生半夏有解毒作用。生半夏汤剂和制半夏汤剂iｇ给于小鼠，每次0.8ml/只，每隔3小时l次，连续给药5次。总剂量为100ｇ/kｇ。观察1周，未见任何毒性反应，表明生半夏制成汤剂后比生半夏混悬液的毒性己大大降低。亚急性毒性和蓄积毒性试验：小鼠100只，均分5组。对照组iｇ常水。生半夏9ｇ/kｇ（＝1/5LD50）组：iｇ30%生半夏混悬液。生半夏4.5ｇ/kｇ（-1/10LD50）组：iｇl5%生半夏混悬液。生半夏2.25ｇ/kｇ（-1/20LD50：iｇ7.5%生半夏混悬液。制半夏9ｇ/kｇ组：iｇ30%制半夏混悬液。每天给药1次，连续3周。结果：制半夏对小鼠体重无影响；而生半夏各组均有显着地抑制小鼠体重增长的作用，随时间和剂量的增加而作用更为显着。制半夏组未见毒性反应，而生半夏各组均有死亡。肝、肾功能虽然与对照组无明显差异，但肾指数（肾重/体重）显然地高于对照组。提示生半夏较长时间给药后引起肾脏代偿性的增大。生半夏长时间给药所引起的中毒靶器官主要是肝肠和肾脏。病理检查，各给药组和对照组比较，均未见明显的病理形态学的改变。"}]},{"ID":"20240612165524-wk8j5b4","Type":"NodeParagraph","Properties":{"id":"20240612165524-wk8j5b4","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"4.半夏对大白鼠妊娠和胚胎的毒性试验表明：生半夏粉9ｇ/kｇiｇ，对妊娠母鼠和胚胎均有非常显着的毒性，而相同剂量的制半夏粉与对照组无显着的差异，但制半夏汤剂30ｇ/kｇ（相当于临床常用量的150倍）能引起孕鼠阴道出血，胚胎早期死亡数增加，胎儿体重显着降低。生半夏汤剂30ｇ/kｇ对大鼠妊娠和胚胎的毒性与制半夏汤剂无差异，说明对妊娠和胚胎产生毒性的成分不因炮制而降低。姜半夏30ｇ/kｇ剂量，可诱发孕小鼠骨髓细胞姐妹染色体交换（SCE）轻微升高，15ｇ/kｇ和9ｇ/kｇ剂量无影响，说明高剂量（相当临床剂量100倍）对DNA可能有一定损伤作用。而3个剂量对胎鼠肝细胞的SCE率均无影响，说明胎盘对姜半夏可能有屏障作用。"}]},{"ID":"20240612165524-37qucf6","Type":"NodeParagraph","Properties":{"id":"20240612165524-37qucf6","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612165524-fk6xn9g","Type":"NodeParagraph","Properties":{"id":"20240612165524-fk6xn9g","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 块茎含挥发油，内含主成分为3-乙酰氨基-5-甲基异唑(3-acetoamino-5-methylisooxazole)，丁基乙烯基醚(butyl-ethylene ether)，3-甲基二十烷(3-methyleicosane)，十六碳烯二酸(hexadecylendioic acid)，还有2-氯丙烯酸甲酯(methyl-2-chloropropenoate)，茴香脑(anethole)，苯甲醛(benzaldehyde)，1，5-戊二醇(1,5-pentadiol)，2-甲基吡嗪(2-methylpyrazine)，柠檬醛(ciTCMLIBal)，1-辛烯(1-octene)，β榄香烯(β-elemene)，2-十一烷酮(2-undecanone)，9-十七烷醇(9-heptadecanol)，棕榈酸乙酯(ethylpalmitate)，戊醛肟(pentaldehyde oxime)等60多种成分。还含左旋麻黄碱(ephedrine)，胆碱(choline)，β-谷甾醇(β-ssitosterol)，胡萝卜甙(daucosterol)，尿黑酸(homogentisic acid)，原儿茶醛(protocatechualdehyde)，姜辣烯酮(shogaol)，黄芩甙(baicaline)，黄芩甙元(baicalein)，姜辣醇(gingerol)，1，2，3，4，6-五-O-没食子酰葡萄糖(1,2,3,4,6-penta-Ogalloylglucose)，12,13-环氧-9-羟基十九碳-7，10-二烯酸(12,13-epoxy-9-hydroxynonadeca-7,10-dienoic acid)及基衍生物等。又含以α-及β-氨基丁酸(aminobutyric acid)，天冬氨酸(aspartic acid)为主成分的氨基酸和以钙、铁、铝、镁、锰、铊、磷等为主的无机元素。另含多糖，直链淀粉，半夏蛋白(系1种植物凝集素)和胰蛋白酶抑制剂。"}]},{"ID":"20240612165524-n21iwkx","Type":"NodeParagraph","Properties":{"id":"20240612165524-n21iwkx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612165524-k5u0v9c","Type":"NodeParagraph","Properties":{"id":"20240612165524-k5u0v9c","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 1.镇咳作用:生半夏、姜半夏、姜浸半夏和明矾半夏的煎剂，0.6-1g/kgig或iv，对猫碘液注入胸腔或电刺激喉上神经所致的咳嗽有明显的镇咳作用，且可维持5小时以上。0.6g/kg的镇咳作用接近于可待因lmg/kg的作用。"}]},{"ID":"20240612165524-j18sr69","Type":"NodeParagraph","Properties":{"id":"20240612165524-j18sr69","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"2.抑制腺体分泌的作用:半夏制剂ip，对毛果芸香碱引起的唾液分泌有显着的抑制作用，亦有报道煎剂po时，唾液分泌先增加，后减少。"}]},{"ID":"20240612165524-0nj9now","Type":"NodeParagraph","Properties":{"id":"20240612165524-0nj9now","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"3.镇吐和催吐作用:半夏加热炮制或加明矾、姜汁炮制的各种制剂，对去水吗啡、洋地黄、硫酸铜引起的呕吐，都有一定的镇吐作用。上述3种催吐剂的作用机制不同，而半夏都可显示镇吐作用，推测其镇吐作用机制是对呕吐中枢的抑制。"}]},{"ID":"20240612165524-uzaodn6","Type":"NodeParagraph","Properties":{"id":"20240612165524-uzaodn6","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"4.抗生育作用:半夏蛋白1.25mg/ml（在0.9%NaCl中）sc0.2ml对早孕小鼠的抑孕率为50%。结晶半夏蛋白经6M盐酸胍变性后，用分步透析法（即用缓冲液等体积递减稀释变性剂），最终恢复半夏蛋白在生理盐水中平衡，去除变性剂后可以重新天然化，并恢复其原有活力。不同逆转条件的恢复半夏蛋白，对小鼠抗早孕的抑孕率在69-88%之间，仅一种逆转条件为5-8℃者，抑孕率仅36%。利用辣根过氧化物酶标记定位术显示子宫内膜、腺管上皮细胞以及胚胎外胚盘锥体上某些部分细胞团和半夏蛋白有专一性的结合。这些部位很可能就是外源蛋白质一半夏蛋白的抗孕作用部位。如直接将半夏蛋白注入小鼠子宫腔内也表明有抗早孕作用。如果上述结合部位确实是半夏蛋白影响小鼠已着床的子宫内膜和胚胎，产生抗早孕作用，则上述部位也可能起着床识别的作用，因为半夏蛋白不仅能终止小鼠早期妊娠，还有制止兔胚泡着床的效应。半夏蛋白还有很强的抗兔胚泡着床作用，子宫内注射500ug，抗着床率达100%。经半夏蛋白作用后的子宫内膜能使被移植的正常胚泡不着床。在子宫内经半夏蛋白孵育的胚泡移植到同步的假孕子宫，着床率随孵育时间延长而降低。"}]},{"ID":"20240612165524-uf7dbma","Type":"NodeParagraph","Properties":{"id":"20240612165524-uf7dbma","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"5.对胰蛋白酶的抑制作用:半夏胰蛋白酶抑制剂只抑制胰蛋白酶对酰胺、酯、血红蛋白和酪蛋白的水解，不能抑制胰凝乳蛋白酶、舒缓激肽释枚酶、枯草杆菌蛋白酶和木瓜蛋白酶对各自底物的水解。抑制剂对猪胰蛋白酶水解酰胺、酯、血红蛋白和酪蛋白的重量抑制比值分别为1：0.71、1：O.88、1：0.71和1：0.71。从化学分子大小的范围看，半夏胰蛋白酶抑制剂应属大分子抑制剂。6.炮制品的药理作用:清半夏（按中国药典85年版制法）水煎液200%浓度26.5ml/kｇ预防给药时，对氯化钡诱发的大鼠室性心律失常有明显的对抗作用（P\u003c0.05）。小鼠ip60ｇ/kｇ对自发活动有明显的影响（P\u003c0.05）。Ip15ｇ/kｇ或30ｇ/kｇ可显着增加戊巴比妥钠阈下催眠剂量的睡眠率（P\u003c0.05）。并有延长戊巴比妥钠睡眠时间的趋势，但无统计学意义。大剂量对电惊厥有轻微的对抗趋势。30ml/kｇ剂量iｇ，可明显抑制（P\u003c0.05）硝酸毛果芸香碱5mｇ/kｇ对唾液的分泌作用。"}]},{"ID":"20240612165524-w1h4goh","Type":"NodeParagraph","Properties":{"id":"20240612165524-w1h4goh","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"7.其它作用:7.1. 降压作用:半夏浸膏对离体哇心和兔心呈抑制作用。Iv对犬、猫和兔有短暂降压作用，具有快速耐受性。煎剂iｇ时小鼠肾上腺皮质功能有轻度刺激作用。若持续给药，能引起功能抑制。"}]},{"ID":"20240612165524-ell6emx","Type":"NodeParagraph","Properties":{"id":"20240612165524-ell6emx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"7.2.凝血作用：半夏蛋白也是一种植物凝集素，它与兔红血球有专一的血凝活力，浓度低至每1ml2μg仍有凝集作用。除免红细胞外，对羊、狗、猫、豚鼠、大鼠、小鼠和鸽的红细胞亦有凝集作用。但不凝集人、猴、猪和鸡、鸭、鹅、龟、蟾蜍、鳝的红细胞。半夏蛋白是目前已知的唯一只与甘露糖而不与葡萄糖结合的一种具有凝集素作用的蛋白质。除红细胞外半夏蛋白亦凝集其它细胞，对小鼠脾细胞、人肝癌细胞（QGY7703-3和7402）、艾氏腹水癌和腹水型肝癌细胞均能被半夏蛋白凝集，但它不凝集大鼠附睾和猪大网膜脂肪细胞，虽然它能和这两种细胞结合。提示半夏蛋白的细胞凝集作用不仅具有动物种属专一性并存在细胞类别专一性。"}]},{"ID":"20240612165524-guz54py","Type":"NodeParagraph","Properties":{"id":"20240612165524-guz54py","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"7.3.促细胞分裂作用：半夏蛋白的促细胞分裂作用亦有动物种属专一性，它促使兔外周血淋巴细胞转化，但不促使人外周血淋巴细胞分裂。"}]},{"ID":"20240612165524-hebfokt","Type":"NodeParagraph","Properties":{"id":"20240612165524-hebfokt","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612165524-ro4wo0s","Type":"NodeParagraph","Properties":{"id":"20240612165524-ro4wo0s","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 1.生半夏：拣去杂质，筛去灰屑。"}]},{"ID":"20240612165524-opl0nho","Type":"NodeParagraph","Properties":{"id":"20240612165524-opl0nho","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"2.法半夏：取净半夏，用凉水浸漂，避免日晒，根据其产地质量及其颗粒大小，斟酌调整浸泡日数。泡至10日后，如起白沫时，每半夏100斤加白矾2斤，泡1日后再进行换水，至口尝稍有麻辣感为度，取出略晾。另取甘草碾成粗块，加水煎汤，用甘草汤泡石灰块，再加水混合，除去石灰渣，倒入半夏缸中浸泡，每日搅拌，使其颜色均匀，至黄色己浸透，内无白心为度。捞出，阴干。（每半夏100斤，用白矾2斤，甘草16斤，石灰块20斤）3.姜半夏：取拣净的半夏，照上述法半夏项下的方法浸泡至口尝稍有麻辣感后，另取生姜切片煎汤，加白矾与半夏共煮透，取出，晾至六成干，闷润后切片，晾干。（每半夏100斤，用生姜25斤，白矾12斤8两，夏季用14斤8两）4.清半夏：取拣净的半夏，照上述法半夏项下的方法浸泡至口尝稍有麻辣感后，加白矾与水共煮透，取出，晾至六成干，闷润后切片，晾干。（每半夏100斤，用白矾12斤8两，夏季用14斤8两）5.《雷公炮炙论》:修事半夏四两，用捣了白芥子末二两，头醋六两，二味搅令浊，将半夏投于中，洗三遍用之，半夏上有鄛涎，若洗不尽，令人气逆，肝气怒满。"}]},{"ID":"20240612165524-c3rx33s","Type":"NodeParagraph","Properties":{"id":"20240612165524-c3rx33s","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"6.陶弘景：半夏，用之皆先汤洗十许过，令滑尽，不尔戟人咽喉。"}]},{"ID":"20240612165524-1k5ziig","Type":"NodeParagraph","Properties":{"id":"20240612165524-1k5ziig","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612165524-nnv7aod","Type":"NodeParagraph","Properties":{"id":"20240612165524-nnv7aod","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 薄层色谱：①取本品粉末1g,加石油醚（60℃-90℃）10ml，冷浸1昼夜，吸取上清液30μl点样，以β-谷甾醇为对照品。分别点样f硅胶G薄层极上，以氢仿-甲醇（9.5：0.5）展开，10%磷铅酸乙醇液喷雾，供试品色谱在与对照品相应位置上显相同斑点。③取本品粉末2g加甲醇20ml，80℃回流提出4h滤过。浓缩甲醇液供点样，以精氨酸、丙氨酸、缬氨酸、亮氨酸为对照品。分别点样于硅胶G－CMC薄层板上，以正丁醇-冰醋酸-水（35：10：10）展开，用0.2%茚三酮丙酮溶液喷雾，热气流烘烤，供试品色谱在与对照品色谱相应位置上显相同斑点。"}]},{"ID":"20240612165524-8jxjdfv","Type":"NodeParagraph","Properties":{"id":"20240612165524-8jxjdfv","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"商品规格 一等：块茎呈圆球形、半圆球形或稍偏斜，去净外皮。表面白色或浅黄白色，上端圆平，中心凹陷，周围有点状根痕，下面钝圆，较平滑。质坚实。断面洁白或白色，粉质细腻。气微，味辛、麻香而刺喉。每1kg800粒以内。二等：每1kg1200粒以内，余同一等。三等：每1kg3000粒以内，余同一等。统货：块望略呈椭圆形、圆锥形或半圆形，去净外皮，大小不分。"}]},{"ID":"20240612165524-7emyn56","Type":"NodeParagraph","Properties":{"id":"20240612165524-7emyn56","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"发面类白色或淡黄色，略有皱纹，有的下端略尖。质坚实，断面白色，粉性。气微，味辣、麻香而刺喉。颗粒不得小于0.5cm。"}]},{"ID":"20240612165524-of37c28","Type":"NodeParagraph","Properties":{"id":"20240612165524-of37c28","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612165524-mfcj39e","Type":"NodeParagraph","Properties":{"id":"20240612165524-mfcj39e","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 脾；胃；肺经"}]},{"ID":"20240612165524-4t6nxpq","Type":"NodeParagraph","Properties":{"id":"20240612165524-4t6nxpq","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612165524-2gsqpbm","Type":"NodeParagraph","Properties":{"id":"20240612165524-2gsqpbm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 味辛；性温；有毒"}]},{"ID":"20240612165524-rmbgnwi","Type":"NodeParagraph","Properties":{"id":"20240612165524-rmbgnwi","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612165524-m05s5p5","Type":"NodeParagraph","Properties":{"id":"20240612165524-m05s5p5","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 阴虚燥咳、津伤口渴、血证及燥痰者禁服，孕妇慎服。半夏使用不当可引起中毒，表现为口舌咽喉痒痛麻木，声音嘶哑，言语不清，流涎，味觉消失，恶心呕吐，胸闷，腹痛腹泻严重者可出现喉头痉挛，呼吸困难，四肢麻痹，血压下降，肝肾功能损害等，最后可因呼吸中枢麻痹而死亡。"}]},{"ID":"20240612165524-0u8jgkw","Type":"NodeParagraph","Properties":{"id":"20240612165524-0u8jgkw","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612165524-ss8gkoe","Type":"NodeParagraph","Properties":{"id":"20240612165524-ss8gkoe","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 燥湿化痰；降逆止呕；消痞散结。主咳喘痰多；呕吐反胃；胸脘痞满头痛眩晕；夜卧不安；瘿瘤痰核；痈疽肿毒"}]},{"ID":"20240612165524-hcqpoke","Type":"NodeParagraph","Properties":{"id":"20240612165524-hcqpoke","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612165524-1ftx2ni","Type":"NodeParagraph","Properties":{"id":"20240612165524-1ftx2ni","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；入丸、散。外用：适量，生品研末，水调敷，或用酒、醋调敷。"}]},{"ID":"20240612165524-g1runqm","Type":"NodeParagraph","Properties":{"id":"20240612165524-g1runqm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612165524-pving0n","Type":"NodeParagraph","Properties":{"id":"20240612165524-pving0n","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：半夏，今人惟知去痰，不言益脾，盖能分水故也。脾恶湿，湿则濡而困，困则不能制水。《经》曰，湿胜则泻。一男子夜数如厕，或教以生姜一两碎之，半夏汤洗，与大枣各三十枚，水一升，瓷瓶中慢火烧为熟水，时时呷，数日便己。"}]},{"ID":"20240612165524-0kuc1w2","Type":"NodeParagraph","Properties":{"id":"20240612165524-0kuc1w2","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"2.成无己：辛者散也，半夏之辛以散逆气，以除烦呕，辛入肺而散气，辛以散结气，辛以发声音。张元素：半夏，热痰佐以黄芩，风痰佐以南星，寒痰佐以干姜，痰痞佐以陈皮、白术。多用则泻脾胃。"}]},{"ID":"20240612165524-6ai41fn","Type":"NodeParagraph","Properties":{"id":"20240612165524-6ai41fn","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"3.《汤液本草》:半夏，俗用力肺药，非也。止吐为足阳明，除痰为足太阴，小柴胡中虽为止呕，亦助柴胡能主恶寒,是又为足少阳也，又助黄芩能去热，是又为足阳明也。往来寒热，在表里之中，故用此有各半之意，本以治伤寒之寒热，所以名半夏。《经》云，肾主五液，化为五湿，自入为唾，入肝为位，入心为汗，入脾为痰，入肺为涕。有涎曰嗽，无涎曰咳，痰者因咳而动，脾之湿也。半夏能泄痰之标，不能泄痰之本，泄本者泄肾也。咳无形，痰有形，无形则润，有形则燥，所以为流湿润燥也。"}]},{"ID":"20240612165524-3va9hur","Type":"NodeParagraph","Properties":{"id":"20240612165524-3va9hur","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"4.《本草会编》：俗以半夏性燥有毒，多以贝母代之，贝母乃太阴肺经之药，半夏乃太阴脾经、阳明胃经之药，何可代也。夫咳嗽吐痰，虚劳吐血，或痰中见血，诸郁咽痛喉痹，肺痈，肺痿，痈疽，妇人乳难，此皆贝母为向导，半夏乃禁用之药。若涎者脾之液，美味膏粱炙?，皆能生脾胃湿热，故涎化为痰，久则痰火上攻，令人昏愦口噤，偏废僵仆，蹇涩不语，生死旦夕，自非半夏、南星曷可治乎？若以贝母代之，则翘首待毙矣。"}]},{"ID":"20240612165524-33gvwe3","Type":"NodeParagraph","Properties":{"id":"20240612165524-33gvwe3","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：脾无留湿不生痰，故脾为生痰之源，肺为贮痰之器。半夏能主痰饮及腹胀者，为其体滑而味辛性温也，涎滑能润，辛温能散亦能润，故行湿而通大便，利窍而泄小便，所谓辛走气能化痰，辛以润之是矣。洁古张氏云,半夏、南星治其痰，而咳嗽自愈。丹溪朱氏云，二陈汤能使大便润而小便长。聊摄成氏云，半夏辛而散，行水气而润肾燥。又《和剂局方》用半硫丸，治老人虚秘，皆取其滑润也。世俗皆以南星、半夏为性燥，误矣。湿去则土燥，痰涎不生，非二物之性燥也。古方治咽痛喉痹，吐血下血，多用二物，非禁剂也。二物亦能散血，故破伤打扑皆主之。惟阴虚劳损，则非湿热之邪，而用利窍行湿之药，是乃重竭其精液。"}]},{"ID":"20240612165524-w02y4eu","Type":"NodeParagraph","Properties":{"id":"20240612165524-w02y4eu","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"6.《本草经疏》：半夏，柴胡为之使。辛温善散，故主伤寒邪在表里之间，往来寒热。苦善下泄，邪在胸中，则心中坚，胸胀咳逆；邪在上焦，则头眩；邪在少阴，则咽喉肿痛。《别录》亦谓其消心腹胸膈痰热满结，咳逆上气，心下急痛坚痞，时气呕逆，亦皆邪在上焦胸中之所致，故悉主之也。中焦者，足太阴之所治也，有湿有热，清浊不分则肠鸣，湿热胜则自汗，入足太阴故并主之。辛能散结，故消痈肿。脾家湿热，则面色痿黄，实脾、分水、燥湿，则前证俱除，面目因而滑泽矣。辛温有毒，体滑性燥，故堕胎也。半夏，古人立三禁，谓血家、渴家、汗家也。其所最易误而难明者，世医类以其能去痰，凡见痰嗽，莫不先投之，殊不知咳嗽吐痰，寒热骨蒸，类皆阴虚肺热，津液不足之候，误服此药，愈损津液，则肺家愈燥，阴气愈虚，浓痰愈结，必致声哑而死。若合参术，祸不旋踵。盖以其本脾胃家药，而非肺肾药也。寒湿痰饮作嗽，属胃病者固宜，然亦百之一、二，其阴虚火炽，煎熬真阴，津液化为结痰，以致喉痒发咳者，往往而是，故凡痰中带血，口渴、咽干，阴虚咳嗽者，大忌之。又有似中风，痰壅失音，偏枯拘挛，及二便闭涩，血虚腹痛，于法并忌。犯之过多,则非药可救。7.《本经逢原》：半夏，同苍术、茯苓治湿痰；同栝萎、黄芩治热痰；同南星、前胡治风痰；同芥子、姜汁治寒痰；惟燥痰宜栝萎、贝母，非半夏所能治也。"}]},{"ID":"20240612165524-8bftasx","Type":"NodeParagraph","Properties":{"id":"20240612165524-8bftasx","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"8.《药征》：余尝读《本草纲目》半夏条曰，孕妇忌半夏，为其燥津液也。不思之甚矣。古语有之曰，有故无殒，此证而用此药，夫何忌之有。妊娠呕吐不止者，仲景氏用干姜人参半夏丸，余亦尝治孕妇留饮掣痛者，与十枣汤数剂，及期而娩，母子无害也。"}]},{"ID":"20240612165524-qdzmx5i","Type":"NodeParagraph","Properties":{"id":"20240612165524-qdzmx5i","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"9.《本草经读》：今人以半夏功专祛痰，概用白矾煮之，服者往往致吐，且致酸心少食，制法相沿之陋也。古人只用汤洗七次，去涎，今人畏其麻口，不敢从之。此药是太阴、阳明、少阳之大药，祛痰却非专长，故仲景诸方加减，俱云呕者加半夏，痰多者加茯苓，未闻以痰多加半夏也。张寿颐：半夏味辛，辛能泄散，而多涎甚滑，则又速降，《本经》以主伤寒寒热，是取其辛散之义，又治心下坚满而下气者，亦辛以开泄其坚满，而滑能降达逆气也。咽喉肿痛,头眩咳逆，皆气逆上冲，多升少降使然，滑而善降，是以主之。胸胀即心下之坚满，肠鸣乃腹里之窒塞，固无一非泄降开通之效用。止汗者，汗出多属气火上逆为病，此能抑而平之，所以可止，固非肌腠空疏，卫气不固之虚汗可知。后人止知半夏为消痰主将，而《本经》乃无一字及于痰饮，然后知此物之长，全在于开宣滑降四字，初非以治痰专长，其所以能荡涤痰浊者，盖即其开泄滑下之作用。《本经》主治，皆就其力量之所以然者而诠次之。至《别录》主治，大率皆与《本经》同义，惟多痈肿痿黄两症，盖痈肿仍是脉络之结滞，痿黄又多湿热之不通，此能主之，亦犹是开泄之力。悦泽面目，则外敷之面脂药也。俗本医书，皆谓半夏专治湿痰，贝母专治燥痰，此其说实自汪?庵开之。究之古用半夏治痰，惟取其涎多而滑降，且兼取其味辛而开泄，本未有燥湿之意，惟其涎莶甚，激刺之力甚猛，故为有毒之品，多服者必有喉痛之患，而生姜则专解此毒。古无制药之法，凡方有半夏者，必合生姜用之，正取其克制之义。而六朝以降，始讲制药，且制法日以益密，而于此物之制造，则尤百出而不穷，于是浸之又浸，捣之又捣，药物本真，久已消灭，甚至重用白矾，罨之悠久，而辛开滑降之实，竟无丝毫留存，乃一变而为大燥之渣滓，则古人所称种种功用，皆不可恃，此所谓矫枉而过其正。或者又疑古书之不可信，不亦冤耶。古书每谓半夏善治风痰，说者辄以辛能散风作解，遂谓治大人中风，小儿惊痫，皆其法风搜风之功。其实半夏泄降，惟积痰生热，积热气升，而内风自动者，此能降气开痰，则风阳自息，决非可以发散外感之风。"}]},{"ID":"20240612165524-x380l35","Type":"NodeParagraph","Properties":{"id":"20240612165524-x380l35","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"10.《本经》：生伤寒寒热，心下坚，下气，喉咽肿痛，头眩胸胀，咳逆，肠鸣，止汗。"}]},{"ID":"20240612165524-7a7uhtz","Type":"NodeParagraph","Properties":{"id":"20240612165524-7a7uhtz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"11.《别录》：消心腹胸膈痰热满结，咳嗽上气，心下急痛坚痞，时气呕逆；消痈肿，堕胎，疗痿黄，悦泽面目。生令人吐，熟令人下。"}]},{"ID":"20240612165524-1t5902z","Type":"NodeParagraph","Properties":{"id":"20240612165524-1t5902z","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"12.《药性论》：消痰涎，开胃健脾，止呕吐，去胸中痰满，下肺气，主咳结。新生者摩涂痈肿不消，能除瘤瘿。气虚而有痰气，加而用之。"}]},{"ID":"20240612165524-ecw813m","Type":"NodeParagraph","Properties":{"id":"20240612165524-ecw813m","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"13.《日华子本草》：治吐食反胃，霍乱转筋，肠腹冷，痰疟。"}]},{"ID":"20240612165524-p6nvufn","Type":"NodeParagraph","Properties":{"id":"20240612165524-p6nvufn","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"14.《本草图经》：主胃冷，呕哕。"}]},{"ID":"20240612165524-bzo9c1m","Type":"NodeParagraph","Properties":{"id":"20240612165524-bzo9c1m","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"15.《医学启源》：治寒痰及形寒饮冷伤肺而咳，大和胃气，除胃寒，进饮食。治太阳痰厥头痛，非此不能除。"}]},{"ID":"20240612165524-pz80hi2","Type":"NodeParagraph","Properties":{"id":"20240612165524-pz80hi2","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"16.《主治秘要》云，燥胃湿，化痰，益脾胃气，消肿散结，除胸中痰涎。朱震亨：治眉棱骨痛。"}]},{"ID":"20240612165524-a87nwge","Type":"NodeParagraph","Properties":{"id":"20240612165524-a87nwge","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"17.《纲目》：治腹胀，目不得瞑，白浊，梦遗，带下。"}]},{"ID":"20240612165524-tw14nvm","Type":"NodeParagraph","Properties":{"id":"20240612165524-tw14nvm","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612165524-lrly2vz","Type":"NodeParagraph","Properties":{"id":"20240612165524-lrly2vz","updated":"20240612165524"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612165525-goolkgc","Type":"NodeThematicBreak","Properties":{"id":"20240612165525-goolkgc"}},{"ID":"20240612165526-z1eppqt","Type":"NodeParagraph","Properties":{"id":"20240612165526-z1eppqt"}}]}