":"assets/白前4-20240705133421-0vnbd4c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 316px;","style":"width: 306px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前 2-20240828161313-jdnzzfl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 306px;\" parent-style=\"width: 316px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前 1-20240828161236-zat483z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705132533-74y9697","Type":"NodeParagraph","Properties":{"id":"20240705132533-74y9697","updated":"20240828161329"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 642px;","style":"width: 632px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前2-20240705133224-ct6gnq1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 632px;\" parent-style=\"width: 642px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 589px;","style":"width: 579px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前3-20240705133324-b7qcy12.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 579px;\" parent-style=\"width: 589px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240705133539-c87qzlv","Type":"NodeParagraph","Properties":{"id":"20240705133539-c87qzlv","updated":"20240828161552"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 408px;","style":"width: 398px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前 5-20240828161538-hbvjzq5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 398px;\" parent-style=\"width: 408px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 458px;","style":"width: 448px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前8-20240705134210-apewn6s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 448px;\" parent-style=\"width: 458px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 459px;","style":"width: 449px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前5-20240705133655-53vvsny.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 449px;\" parent-style=\"width: 459px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828161151-efq14lk","Type":"NodeParagraph","Properties":{"id":"20240828161151-efq14lk","updated":"20240828161335"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白前"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白前-20240828161151-axghzqq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828161555-xtzlpep","Type":"NodeParagraph","Properties":{"id":"20240828161555-xtzlpep","updated":"20240828161602"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图未按品种分类；"}]},{"ID":"20240614125802-58v3pc4","Type":"NodeThematicBreak","Properties":{"id":"20240614125802-58v3pc4"}},{"ID":"20240614125959-gadnnw5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125959-gadnnw5","updated":"20240614130004"},"Children":[{"Type":"NodeText","Data":"白前《本草纲目》"}]},{"ID":"20240614125959-a4qepe0","Type":"NodeParagraph","Properties":{"id":"20240614125959-a4qepe0","updated":"20240614125959"},"Children":[{"Type":"NodeText","Data":"「释名」亦名石蓝、嗽药。"}]},{"ID":"20240614125959-n42icwg","Type":"NodeParagraph","Properties":{"id":"20240614125959-n42icwg","updated":"20240614125959"},"Children":[{"Type":"NodeText","Data":"「气味」苦、微温、无毒。"}]},{"ID":"20240614125959-2r9ta2n","Type":"NodeParagraph","Properties":{"id":"20240614125959-2r9ta2n","updated":"20240614125959"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614125959-kx4d0jp","Type":"NodeParagraph","Properties":{"id":"20240614125959-kx4d0jp","updated":"20240614125959"},"Children":[{"Type":"NodeText","Data":"1、久嗽咳血。用白前、桔梗、桑白皮各三两（炒过），甘草一两（灸），加水六升，煮成一升，分三次服下。忌食猪肉、白菜。"}]},{"ID":"20240614125959-hpqvz31","Type":"NodeParagraph","Properties":{"id":"20240614125959-hpqvz31","updated":"20240614125959"},"Children":[{"Type":"NodeText","Data":"2、久咳气壅（体肿、短气、胀满、喉中呼吸有声，不能平躺卧下）。用白前二两，紫苑、半夏各三两，大戟七合，以水一斗浸一夜后煮成三升，分数次服。忌食羊内，饩糖。"}]},{"ID":"20240614130036-idh9691","Type":"NodeThematicBreak","Properties":{"id":"20240614130036-idh9691"}},{"ID":"20240614130037-psdzjsz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130037-psdzjsz","updated":"20240614130042"},"Children":[{"Type":"NodeText","Data":"白前《本草述钩元》"}]},{"ID":"20240614130037-xxvbrfo","Type":"NodeParagraph","Properties":{"id":"20240614130037-xxvbrfo","updated":"20240614130037"},"Children":[{"Type":"NodeText","Data":"生洲渚沙碛上。秋后采根。粗长坚直。色白微黄。折之易断者。为白前。细短柔韧。色黄微白。折之不断者。白薇也。味甘辛。气微温微寒。阳中之阴。降也。手太阴肺家治咳要药。更入手阳明足阳明经。主胸胁逆气。咳嗽上气。呼吸欲绝。（别录）又治肺气烦闷。"}]},{"ID":"20240614130037-yqez857","Type":"NodeParagraph","Properties":{"id":"20240614130037-yqez857","updated":"20240614130037"},"Children":[{"Type":"NodeText","Data":"贲豚肾气。（日华子）长于降气。肺气壅实而有痰者宜之。若虚而长哽气者。不可用。（濒湖）凡咳嗽而喉中作声者。一味白前煎服妙。久咳上气。体肿气短。昼夜倚壁不得卧。常作水鸡声者。深师白前汤。白前紫菀半夏大戟各三两。水一斗。渍一宿。煮取三升。分数十服。"}]},{"ID":"20240614130037-2cafa32","Type":"NodeParagraph","Properties":{"id":"20240614130037-2cafa32","updated":"20240614130037"},"Children":[{"Type":"NodeText","Data":"间〔论〕白前主治。首言胸胁逆气。夫胸中固肺所治。而胁则阴阳升降之道路也。又主咳嗽上气。呼吸欲绝。夫呼吸即升降之气。阴阳之分而合者。肺为气主。贯心脉而行呼吸。呼吸欲绝。是有升无降。或阴或阳。皆能病之。如下之真阴不足。不能召上之阳。即无以吸上而气不降。（此为气不归元）上之真阳不足。不能生下之阴。即无以归下而气亦不降。（此中气大虚而失守。须大剂参而愈。）二者皆虚证。非白前可治也。惟是后天气血之病。偏胜所成。上实而下即虚。（如痰热上壅。阳愈失阴而亢。气固不降。）下实而上即虚。（如贲豚肾气。阴愈逼阳而僭。其气亦不降。）随其所主之味。而以兹味为前导。庶乎近之。（此味三阴并施。脏腑咸入。其功靡不前至。故名。）缪氏云。走散下气。性无补益。凡咳逆气上。不由于邪客壅实者。禁用。"}]},{"ID":"20240614130037-x4wwl0t","Type":"NodeParagraph","Properties":{"id":"20240614130037-x4wwl0t","updated":"20240614130037"},"Children":[{"Type":"NodeText","Data":"〔修治〕甘草水浸。去头须。焙干用。"}]},{"ID":"20240614125802-nv0aoj6","Type":"NodeThematicBreak","Properties":{"id":"20240614125802-nv0aoj6"}},{"ID":"20240614125940-wyztkw9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125940-wyztkw9","updated":"20240614130051"},"Children":[{"Type":"NodeText","Data":"白前《本草蒙筌》"}]},{"ID":"20240614125940-ak6bryc","Type":"NodeParagraph","Properties":{"id":"20240614125940-ak6bryc","updated":"20240614125940"},"Children":[{"Type":"NodeText","Data":"味甘、辛，气微温。无毒。出江浙蜀川，生洲渚砂碛。叶如柳树叶，苗似芫花苗。根粗长与牛膝颇同，但坚脆（音翠）而柔软鲜有。凡资入药，秋后采根。甘草汤浸一宵，折去傍须焙用。咳嗽上气能降，胸胁逆气堪驱。气壅膈，倒睡不得者殊功；气冲喉，呼吸欲绝者立效。仍治气塞咽嗌，时作水鸡声鸣。故古人气嗽方中，每每用之不遗，亦以其善主一切气也。又能保定肺气，温药佐使尤奇。"}]},{"ID":"20240614125940-zhlxwfn","Type":"NodeParagraph","Properties":{"id":"20240614125940-zhlxwfn","updated":"20240614125940"},"Children":[{"Type":"NodeText","Data":"（谟）按∶白薇、白前，近道俱有。苗茎根叶，形色颇同。倘误采收，杀人顷刻，必辨认的实，方入药拯 。白前似牛膝，粗长坚脆易断。白薇似牛膝，短小柔软能弯。仍噬汁味相参，庶不失于差误。此医家大关键，匪特一药为然。凡相类者，俱不可不细察尔。"}]},{"ID":"20240614130156-9o44svl","Type":"NodeThematicBreak","Properties":{"id":"20240614130156-9o44svl"}},{"ID":"20240614130157-etnmhh9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130157-etnmhh9","updated":"20240614130200"},"Children":[{"Type":"NodeText","Data":"白前《本草从新》"}]},{"ID":"20240614130157-i3c2bcr","Type":"NodeParagraph","Properties":{"id":"20240614130157-i3c2bcr","updated":"20240614130157"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻肺降气、下痰．"}]},{"ID":"20240614130157-s2w7x4y","Type":"NodeParagraph","Properties":{"id":"20240614130157-s2w7x4y","updated":"20240614130157"},"Children":[{"Type":"NodeText","Data":"辛甘微寒．长于降气、下痰止嗽．治肺气壅实．（喉中作水鸡声者、服之立愈．）胸膈逆满．"}]},{"ID":"20240614130157-ykwxwaf","Type":"NodeParagraph","Properties":{"id":"20240614130157-ykwxwaf","updated":"20240614130157"},"Children":[{"Type":"NodeText","Data":"肺实者宜．否则忌也．似牛膝．粗长坚直．脆而易断者．白前也．短小柔软．能弯不断者．"}]},{"ID":"20240614130157-4rprh9a","Type":"NodeParagraph","Properties":{"id":"20240614130157-4rprh9a","updated":"20240614130157"},"Children":[{"Type":"NodeText","Data":"白薇也．（近道多有、形色颇同、以此别之．）去头须．甘草水浸一伏时．焙用．忌羊肉．"}]},{"ID":"20240614130146-anjt6sy","Type":"NodeThematicBreak","Properties":{"id":"20240614130146-anjt6sy"}},{"ID":"20240614130147-u7g18lr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130147-u7g18lr","updated":"20240614130151"},"Children":[{"Type":"NodeText","Data":"白前《冯氏锦囊秘录》"}]},{"ID":"20240614130147-hhcd3tr","Type":"NodeParagraph","Properties":{"id":"20240614130147-hhcd3tr","updated":"20240614130147"},"Children":[{"Type":"NodeText","Data":"色白形似白微，又似牛豚，但脆白易折，不若白微之可弯而不折也。感秋之气，得土之冲味，味甘辛气微温，一云微寒无毒，阳中之阴，降也。入手太阴肺家之要药。甘能缓，辛能散，温能下，故善能下气，治气逆咳嗽湿痰，停饮短气，水湿体重胀满，昼夜倚壁不得卧，喉作水鸡声者神效。"}]},{"ID":"20240614130147-bux0dla","Type":"NodeParagraph","Properties":{"id":"20240614130147-bux0dla","updated":"20240614130245"},"Children":[{"Type":"NodeText","Data":"白前，似牛膝，粗长坚脆易断，主咳嗽上气能降，胸胁逆气堪驱，气壅膈，倒睡不得者殊功，气冲喉，呼吸欲纵者立效，并气寒咽嗌，时作水鸡声鸣者，服之即瘳。"}]},{"ID":"20240614130246-eueon24","Type":"NodeThematicBreak","Properties":{"id":"20240614130246-eueon24"}},{"ID":"20240614130248-ur6inh6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130248-ur6inh6","updated":"20240614130252"},"Children":[{"Type":"NodeText","Data":"白前《本经逢原》"}]},{"ID":"20240614130248-yhz4wrq","Type":"NodeParagraph","Properties":{"id":"20240614130248-yhz4wrq","updated":"20240614130248"},"Children":[{"Type":"NodeText","Data":"甘辛微温，无毒。"}]},{"ID":"20240614130248-z3ians9","Type":"NodeParagraph","Properties":{"id":"20240614130248-z3ians9","updated":"20240614130248"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"时珍曰∶白前入手太阴，长于降气，肺气壅实而有痰者宜之。《金匮》治咳嗽而脉沉者，用泽漆汤，以中有白前也。《深师》治久嗽上气，体肿短气，倚息不得卧，常作水鸡声者，用白前汤。《外台》治久嗽吐血，用白前、桔梗、桑白皮、甘草，皆取其下气耳。"}]},{"ID":"20240614130248-g3ulofu","Type":"NodeParagraph","Properties":{"id":"20240614130248-g3ulofu","updated":"20240614130248"},"Children":[{"Type":"NodeText","Data":"若虚嗽常哽气者，不可用也。白前较白薇稍温，较细辛稍平，专搜肺窍中风水。非若白薇之咸寒，专泄肺胃之燥热；亦不似细辛之辛窜，能治肾肝之沉寒也。"}]},{"ID":"20240614130234-7mui91o","Type":"NodeThematicBreak","Properties":{"id":"20240614130234-7mui91o"}},{"ID":"20240614130235-5gsuqzb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130235-5gsuqzb","updated":"20240614130239"},"Children":[{"Type":"NodeText","Data":"白前《本草衍义》"}]},{"ID":"20240614130235-hz7xrfl","Type":"NodeParagraph","Properties":{"id":"20240614130235-hz7xrfl","updated":"20240614130235"},"Children":[{"Type":"NodeText","Data":"保定肺气，治嗽多用。白而长于细辛，但粗而脆，不似细辛之柔。以温药相佐使，则尤佳。余如经。"}]},{"ID":"20240614130225-2kmsw1t","Type":"NodeThematicBreak","Properties":{"id":"20240614130225-2kmsw1t"}},{"ID":"20240614130226-v412ud0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130226-v412ud0","updated":"20240614130230"},"Children":[{"Type":"NodeText","Data":"白前《汤液本草》"}]},{"ID":"20240614130226-kdflsa8","Type":"NodeParagraph","Properties":{"id":"20240614130226-kdflsa8","updated":"20240614130226"},"Children":[{"Type":"NodeText","Data":"气微温，味甘，微寒。无毒。"}]},{"ID":"20240614130226-izmqo1w","Type":"NodeParagraph","Properties":{"id":"20240614130226-izmqo1w","updated":"20240614130226"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主胸胁逆气，咳嗽上气。状似白薇、牛膝辈。"}]},{"ID":"20240614130226-g2uve1b","Type":"NodeParagraph","Properties":{"id":"20240614130226-g2uve1b","updated":"20240614130226"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶白前保定肺气，治嗽多用，白而长于细辛，但粗而脆，不似细辛之柔。若以温药相佐使则尤佳。仲景用。"}]},{"ID":"20240614130214-vlb4duk","Type":"NodeThematicBreak","Properties":{"id":"20240614130214-vlb4duk"}},{"ID":"20240614130215-ypz5w8c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130215-ypz5w8c","updated":"20240614130219"},"Children":[{"Type":"NodeText","Data":"白前《本草经集注》"}]},{"ID":"20240614130215-isenspp","Type":"NodeParagraph","Properties":{"id":"20240614130215-isenspp","updated":"20240614130215"},"Children":[{"Type":"NodeText","Data":"味甘，微温，无毒。主治胸胁逆气，咳嗽上气。"}]},{"ID":"20240614130215-22fckvm","Type":"NodeParagraph","Properties":{"id":"20240614130215-22fckvm","updated":"20240614130215"},"Children":[{"Type":"NodeText","Data":"此药出近道，似细辛而大，色白易折。主气嗽方多用之。"}]},{"ID":"20240614130137-73v2adi","Type":"NodeThematicBreak","Properties":{"id":"20240614130137-73v2adi"}},{"ID":"20240614130139-5l4ghqq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130139-5l4ghqq","updated":"20240614130142"},"Children":[{"Type":"NodeText","Data":"白前《本草从新》"}]},{"ID":"20240614130139-rntho3w","Type":"NodeParagraph","Properties":{"id":"20240614130139-rntho3w","updated":"20240614130139"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻肺降气、下痰．"}]},{"ID":"20240614130139-32hzx0t","Type":"NodeParagraph","Properties":{"id":"20240614130139-32hzx0t","updated":"20240614130139"},"Children":[{"Type":"NodeText","Data":"辛甘微寒．长于降气、下痰止嗽．治肺气壅实．（喉中作水鸡声者、服之立愈．）胸膈逆满．"}]},{"ID":"20240614130139-mk47mp0","Type":"NodeParagraph","Properties":{"id":"20240614130139-mk47mp0","updated":"20240614130139"},"Children":[{"Type":"NodeText","Data":"肺实者宜．否则忌也．似牛膝．粗长坚直．脆而易断者．白前也．短小柔软．能弯不断者．"}]},{"ID":"20240614130139-ageama1","Type":"NodeParagraph","Properties":{"id":"20240614130139-ageama1","updated":"20240614130139"},"Children":[{"Type":"NodeText","Data":"白薇也．（近道多有、形色颇同、以此别之．）去头须．甘草水浸一伏时．焙用．忌羊肉．"}]},{"ID":"20240614130128-ifmckys","Type":"NodeThematicBreak","Properties":{"id":"20240614130128-ifmckys"}},{"ID":"20240614130129-u8k4d97","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130129-u8k4d97","updated":"20240614130133"},"Children":[{"Type":"NodeText","Data":"白前《得配本草》"}]},{"ID":"20240614130129-ehmaidg","Type":"NodeParagraph","Properties":{"id":"20240614130129-ehmaidg","updated":"20240614130129"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名嗽药"}]},{"ID":"20240614130129-02z92o6","Type":"NodeParagraph","Properties":{"id":"20240614130129-02z92o6","updated":"20240614130129"},"Children":[{"Type":"NodeText","Data":"忌猪羊肉、菘菜、饴糖。"}]},{"ID":"20240614130129-x78woym","Type":"NodeParagraph","Properties":{"id":"20240614130129-x78woym","updated":"20240614130129"},"Children":[{"Type":"NodeText","Data":"辛、甘、微寒。入手太阴经气分。下胸胁逆气，咳嗽上气，呼吸喉中作水鸡声。（痰气壅盛也。）配紫菀、半夏、大戟，治久咳上气。（体肿、短气、胀满，昼夜不得卧，喉中常作水鸡声。）配桔梗、桑皮，治久嗽吐血。佐苍术，治湿肿。焙研为末，温酒服二钱，治久嗽 呷不得眠。"}]},{"ID":"20240614130129-0y93jaf","Type":"NodeParagraph","Properties":{"id":"20240614130129-0y93jaf","updated":"20240614130129"},"Children":[{"Type":"NodeText","Data":"去头须，以生甘草水浸一宿，焙用。"}]},{"ID":"20240614130129-8z8cefz","Type":"NodeParagraph","Properties":{"id":"20240614130129-8z8cefz","updated":"20240614130129"},"Children":[{"Type":"NodeText","Data":"味苦者非真也。似牛膝粗长而坚直易断者，白前也。短小柔软而能弯不断者，白薇也。"}]},{"ID":"20240614130129-o1fhtzl","Type":"NodeParagraph","Properties":{"id":"20240614130129-o1fhtzl","updated":"20240614130129"},"Children":[{"Type":"NodeText","Data":"气虚，虚痰，二者禁用。"}]},{"ID":"20240614130117-rrurom7","Type":"NodeThematicBreak","Properties":{"id":"20240614130117-rrurom7"}},{"ID":"20240614130119-gzgnu60","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130119-gzgnu60","updated":"20240614130123"},"Children":[{"Type":"NodeText","Data":"白前《冯氏锦囊秘录》"}]},{"ID":"20240614130119-w0ffjdk","Type":"NodeParagraph","Properties":{"id":"20240614130119-w0ffjdk","updated":"20240614130119"},"Children":[{"Type":"NodeText","Data":"色白形似白微，又似牛豚，但脆白易折，不若白微之可弯而不折也。感秋之气，得土之冲味，味甘辛气微温，一云微寒无毒，阳中之阴，降也。入手太阴肺家之要药。甘能缓，辛能散，温能下，故善能下气，治气逆咳嗽湿痰，停饮短气，水湿体重胀满，昼夜倚壁不得卧，喉作水鸡声者神效。"}]},{"ID":"20240614130119-2llsc92","Type":"NodeParagraph","Properties":{"id":"20240614130119-2llsc92","updated":"20240614130119"},"Children":[{"Type":"NodeText","Data":"白前，似牛膝，粗长坚脆易断，主咳嗽上气能降，胸胁逆气堪驱，气壅膈，倒睡不得者殊功，气冲喉，呼吸欲纵者立效，并气寒咽嗌，时作水鸡声鸣者，服之即瘳。"}]},{"ID":"20240614130107-xpry22b","Type":"NodeThematicBreak","Properties":{"id":"20240614130107-xpry22b"}},{"ID":"20240614130109-mxt3kfs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130109-mxt3kfs","updated":"20240614130113"},"Children":[{"Type":"NodeText","Data":"白前《新修本草》"}]},{"ID":"20240614130109-en9t9hp","Type":"NodeParagraph","Properties":{"id":"20240614130109-en9t9hp","updated":"20240614130109"},"Children":[{"Type":"NodeText","Data":"味甘，微温，无毒。主胸胁逆气，咳嗽上气。"}]},{"ID":"20240614130109-ocgegjo","Type":"NodeParagraph","Properties":{"id":"20240614130109-ocgegjo","updated":"20240614130109"},"Children":[{"Type":"NodeText","Data":"此药出近道，似细辛而大，色白易折。主气嗽方多用之。"}]},{"ID":"20240614130109-96rw0yr","Type":"NodeParagraph","Properties":{"id":"20240614130109-96rw0yr","updated":"20240614130109"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药叶似柳，或似芫花上。根白，长于细辛，味甘，俗以酒渍服，主上气。不生近道，俗名石蓝，又名嗽药。今用蔓生者味苦，非真也。"}]},{"ID":"20240614130056-b962gjs","Type":"NodeThematicBreak","Properties":{"id":"20240614130056-b962gjs"}},{"ID":"20240614130058-lvsoj0e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130058-lvsoj0e","updated":"20240614130103"},"Children":[{"Type":"NodeText","Data":"白前《要药分剂》"}]},{"ID":"20240614130058-lqsc5q5","Type":"NodeParagraph","Properties":{"id":"20240614130058-lqsc5q5","updated":"20240614130058"},"Children":[{"Type":"NodeText","Data":"味甘。性微温。无毒。感秋之气而得土之冲味以生。降也。阳中阴也。"}]},{"ID":"20240614130058-tahrfwx","Type":"NodeParagraph","Properties":{"id":"20240614130058-tahrfwx","updated":"20240614130058"},"Children":[{"Type":"NodeText","Data":"【主治】主胸胁逆气。咳嗽上气。呼吸欲绝。（别录）主一切气。肺气烦闷。奔豚肾气。"}]},{"ID":"20240614130058-6fwews3","Type":"NodeParagraph","Properties":{"id":"20240614130058-6fwews3","updated":"20240614130058"},"Children":[{"Type":"NodeText","Data":"（大【归经】入肺经。为泻肺下气降痰之品。（肺家要药）【前论】寇氏曰。此能保定肺气。治嗽多用。以温药相佐。尤佳。"}]},{"ID":"20240614130058-c6hsbj1","Type":"NodeParagraph","Properties":{"id":"20240614130058-c6hsbj1","updated":"20240614130058"},"Children":[{"Type":"NodeText","Data":"鳌按、白前性无补益。虽寇氏称其能保肺气。但其功能专于降气。气降故痰亦下。故惟肺气【炮制】雷公曰。生甘草水浸一伏时。去头须。焙干用。"}]},{"ID":"20240614130020-9yx63pg","Type":"NodeThematicBreak","Properties":{"id":"20240614130020-9yx63pg"}},{"ID":"20240614130021-7yhf3c0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130021-7yhf3c0","updated":"20240614130029"},"Children":[{"Type":"NodeText","Data":"白前《本草图经》"}]},{"ID":"20240614130021-ncbd45q","Type":"NodeParagraph","Properties":{"id":"20240614130021-ncbd45q","updated":"20240614130024"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"白前"},{"Type":"NodeText","Data":"，旧不载所出州土，陶隐居云出近道，今蜀中及淮浙州郡皆有之。"}]},{"ID":"20240614130021-sbvyocj","Type":"NodeParagraph","Properties":{"id":"20240614130021-sbvyocj","updated":"20240614130021"},"Children":[{"Type":"NodeText","Data":"苗似细辛而大，色白，易折；亦有叶似柳，或似芫花苗者，并高尺许。生洲渚沙碛之上，根白，长于细辛，亦似牛膝、白薇辈。今用蔓生者，味苦，非真也。二月、八月采根，曝干。深师疗久咳逆上气，体肿，短气，胀满，昼夜倚壁不得卧，常作水鸡声者，白前汤主之。白前二两，紫菀、半夏，洗，各三两，大戟七合，切，四物以水一斗，渍一宿，明旦煮取三升，分三服。禁食羊肉、饧，大佳。"}]},{"ID":"20240614130010-jruquad","Type":"NodeThematicBreak","Properties":{"id":"20240614130010-jruquad"}},{"ID":"20240614130012-8xeqzhr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614130012-8xeqzhr","updated":"20240614130016"},"Children":[{"Type":"NodeText","Data":"白前《医学入门》"}]},{"ID":"20240614130012-juetxk5","Type":"NodeParagraph","Properties":{"id":"20240614130012-juetxk5","updated":"20240614130012"},"Children":[{"Type":"NodeText","Data":"白前气味甘辛平，善保肺气嗽有情，胸胁烦闷气冲上，不眠喉作水鸡声。"}]},{"ID":"20240614130012-7ha3xeu","Type":"NodeParagraph","Properties":{"id":"20240614130012-7ha3xeu","updated":"20240614130012"},"Children":[{"Type":"NodeText","Data":"色白，苗类前胡，根似白薇、细辛。保肺清肺，气嗽久嗽多用，以温药相佐尤佳。主胸胁烦闷，气逆上冲，呼吸欲绝不得眠，喉中常作水鸡声。《日华》用治奔豚上气烦闷。甘草水浸，去头须，焙干。"}]},{"ID":"20240614125802-ih6dt7x","Type":"NodeThematicBreak","Properties":{"id":"20240614125802-ih6dt7x"}},{"ID":"20240614125830-ml6ys0c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125830-ml6ys0c","updated":"20240614125952"},"Children":[{"Type":"NodeText","Data":"白前《中药学》"}]},{"ID":"20240614125830-i0eryb2","Type":"NodeParagraph","Properties":{"id":"20240614125830-i0eryb2","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【药用】本品为萝藦科植物白前（斯氏牛皮消）的根茎及叶。"}]},{"ID":"20240614125830-f1pmkhl","Type":"NodeParagraph","Properties":{"id":"20240614125830-f1pmkhl","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、甘，微温。入肺经。"}]},{"ID":"20240614125830-y25l8kx","Type":"NodeParagraph","Properties":{"id":"20240614125830-y25l8kx","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【功效】袪痰，降气。"}]},{"ID":"20240614125830-3kh5iiq","Type":"NodeParagraph","Properties":{"id":"20240614125830-3kh5iiq","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于咳嗽痰多，气逆喘促等症。"}]},{"ID":"20240614125830-wrkjtvc","Type":"NodeParagraph","Properties":{"id":"20240614125830-wrkjtvc","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"本品善于降气袪痰，故适用于痰多壅肺、咳嗽气促等症，可与紫菀、半夏等品配伍同用。"}]},{"ID":"20240614125830-hoslaep","Type":"NodeParagraph","Properties":{"id":"20240614125830-hoslaep","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【处方用名】白前（洗净，晒干，切片用）。降气袪痰之力较强。、炙白前（蜜炙用，润肺，降气、袪痰，作用较缓）、炒白前（清炒用。药性较缓和）"}]},{"ID":"20240614125830-b4yg57k","Type":"NodeParagraph","Properties":{"id":"20240614125830-b4yg57k","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至二钱，煎服。"}]},{"ID":"20240614125830-pxs31ca","Type":"NodeParagraph","Properties":{"id":"20240614125830-pxs31ca","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【按语】1.白前一药，《别录》说它微温，《唐本草》认为微寒。然白前治嗽，并不专用于寒嗽，亦可应用于痰火气壅上逆的咳嗽。因痰浊蕴肺，肺失清肃而嗽作，白前即以清肃肺气为用，功能袪痰降气，不论寒嗽、热咳，只要肺气壅实有痰而咯吐不畅者，都可使用。治寒嗽，可与紫菀、款冬花、半夏等配伍；治热咳，可与桑白皮、地骨皮、前胡等同用。"}]},{"ID":"20240614125830-t9ddzv2","Type":"NodeParagraph","Properties":{"id":"20240614125830-t9ddzv2","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"2.经临床实践，本品袪痰作用颇强，对胃稍有刺激性，如素有胃病者，用量不过多，如果用量过多，易引起恶心呕吐。故使用时必须注意。又本品无补益作用，功专辛散下气，对于肺虚干咳者，不宜应用。"}]},{"ID":"20240614125830-03ji7xh","Type":"NodeParagraph","Properties":{"id":"20240614125830-03ji7xh","updated":"20240614125830"},"Children":[{"Type":"NodeText","Data":"【方剂举例】止嗽散《医学心悟》：白前、紫菀、荆芥、百部、桔梗、陈皮、甘草。治新久咳嗽。"}]},{"ID":"20240614125802-qm6aikp","Type":"NodeThematicBreak","Properties":{"id":"20240614125802-qm6aikp"}},{"ID":"20240614125817-qwt1s65","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125817-qwt1s65","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"《中国药典》：白前"}]},{"ID":"20240614125817-bj8iqej","Type":"NodeParagraph","Properties":{"id":"20240614125817-bj8iqej","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614125817-370yzo3","Type":"NodeParagraph","Properties":{"id":"20240614125817-370yzo3","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" Bái Qián"}]},{"ID":"20240614125817-fn83mjo","Type":"NodeParagraph","Properties":{"id":"20240614125817-fn83mjo","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614125817-z6b83jw","Type":"NodeParagraph","Properties":{"id":"20240614125817-z6b83jw","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 鹅管白前、竹叶白前"}]},{"ID":"20240614125817-is6bkf8","Type":"NodeParagraph","Properties":{"id":"20240614125817-is6bkf8","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614125817-6fqquh6","Type":"NodeParagraph","Properties":{"id":"20240614125817-6fqquh6","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" RHIZOMA CYNANCHI STAUNTONII"}]},{"ID":"20240614125817-3yz2yko","Type":"NodeParagraph","Properties":{"id":"20240614125817-3yz2yko","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614125817-095ngp6","Type":"NodeParagraph","Properties":{"id":"20240614125817-095ngp6","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 本品为萝藦科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柳叶白前"},{"Type":"NodeText","Data":"Cynanchum stauntonii （Decne.） Schltr. ex Levl.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芫花叶白前"},{"Type":"NodeText","Data":"Cynanchum glaucescens （Decne.） Hand.-Mazz.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋季采挖，洗净，晒干。"}]},{"ID":"20240614125817-ku9olwz","Type":"NodeParagraph","Properties":{"id":"20240614125817-ku9olwz","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614125817-5f32p24","Type":"NodeParagraph","Properties":{"id":"20240614125817-5f32p24","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 柳叶白前：根茎呈细长圆柱形，有分枝，稍弯曲，长4～15cm,直径1.5～4mm。表面黄白色或黄棕色，节明显，节间长1.5～4.5cm，顶端有残茎。质脆，断面中空。节处簇生纤细弯曲的根，长可达10cm，直径不及1mm,有多次分枝呈毛须状，常盘曲成团。气微，味微甜。"}]},{"ID":"20240614125817-vdumopw","Type":"NodeParagraph","Properties":{"id":"20240614125817-vdumopw","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"芫花叶白前：根茎较短小或略呈块状；表面灰绿色或灰黄色，节间长1～2cm。质较硬。根稍弯曲，直径约1mm,分枝少。"}]},{"ID":"20240614125817-95cex6q","Type":"NodeParagraph","Properties":{"id":"20240614125817-95cex6q","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614125817-3eflw77","Type":"NodeParagraph","Properties":{"id":"20240614125817-3eflw77","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白前"},{"Type":"NodeText","Data":"：除去杂质，洗净，润透，切段，干燥。蜜白前：取净白前，照蜜炙法（附录Ⅱ D）炒至不粘手。"}]},{"ID":"20240614125817-nrlgbfq","Type":"NodeParagraph","Properties":{"id":"20240614125817-nrlgbfq","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614125817-3qhw6j9","Type":"NodeParagraph","Properties":{"id":"20240614125817-3qhw6j9","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 取本品粗粉1g，加70％乙醇10ml，加热回流1 小时，滤过。取滤液1ml,蒸干，残渣加醋酐1ml 使溶解，再加硫酸1 滴，柳叶白前显红紫色，放置后变为污绿色；芫花叶白前显棕红色，放置后不变色。"}]},{"ID":"20240614125817-yxk5693","Type":"NodeParagraph","Properties":{"id":"20240614125817-yxk5693","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614125817-b2ggpyi","Type":"NodeParagraph","Properties":{"id":"20240614125817-b2ggpyi","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 归肺经。"}]},{"ID":"20240614125817-znjl4ee","Type":"NodeParagraph","Properties":{"id":"20240614125817-znjl4ee","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614125817-0ols28z","Type":"NodeParagraph","Properties":{"id":"20240614125817-0ols28z","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 辛、苦，微温。"}]},{"ID":"20240614125817-lyl7osh","Type":"NodeParagraph","Properties":{"id":"20240614125817-lyl7osh","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614125817-su01bzk","Type":"NodeParagraph","Properties":{"id":"20240614125817-su01bzk","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 降气，消痰，止咳。用于肺气壅实，咳嗽痰多，胸满喘急。"}]},{"ID":"20240614125817-u0wqfvy","Type":"NodeParagraph","Properties":{"id":"20240614125817-u0wqfvy","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614125817-8x0odmc","Type":"NodeParagraph","Properties":{"id":"20240614125817-8x0odmc","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240614125817-d71bhp9","Type":"NodeParagraph","Properties":{"id":"20240614125817-d71bhp9","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614125817-es06um3","Type":"NodeParagraph","Properties":{"id":"20240614125817-es06um3","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240614125817-jh4wsai","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125817-jh4wsai","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白前"}]},{"ID":"20240614125817-zu4bcly","Type":"NodeParagraph","Properties":{"id":"20240614125817-zu4bcly","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614125817-of3dhs8","Type":"NodeParagraph","Properties":{"id":"20240614125817-of3dhs8","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" Bái Qián"}]},{"ID":"20240614125817-mwh9sbr","Type":"NodeParagraph","Properties":{"id":"20240614125817-mwh9sbr","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614125817-1ssrbb2","Type":"NodeParagraph","Properties":{"id":"20240614125817-1ssrbb2","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 石蓝、嗽药（《唐本草》）。"}]},{"ID":"20240614125817-j8vt9dd","Type":"NodeParagraph","Properties":{"id":"20240614125817-j8vt9dd","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614125817-z6fjd8z","Type":"NodeParagraph","Properties":{"id":"20240614125817-z6fjd8z","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240614125817-fngz3kz","Type":"NodeParagraph","Properties":{"id":"20240614125817-fngz3kz","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614125817-ll956n4","Type":"NodeParagraph","Properties":{"id":"20240614125817-ll956n4","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 为萝藦科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柳叶白前"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芫花叶白前"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。8月挖根，或拔起全株，割去地上部分，洗净，晒干。"}]},{"ID":"20240614125817-ro5qrsg","Type":"NodeParagraph","Properties":{"id":"20240614125817-ro5qrsg","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614125817-b8zrcjg","Type":"NodeParagraph","Properties":{"id":"20240614125817-b8zrcjg","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" ①柳叶白前，又名：水杨柳、大鹤瓢、水柳。"}]},{"ID":"20240614125817-fgrrtsv","Type":"NodeParagraph","Properties":{"id":"20240614125817-fgrrtsv","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"多年生草本。高30～60厘米。根茎匍匐。茎直立，单一，下部木质化。单叶对生，具短柄；叶片披针形至线状披针形，长3～8厘米，宽3～8毫米，先端渐尖，基部渐狭，边缘反卷；下部的叶较短而宽；顶端的叶渐短而狭。聚伞花序腋生，总花梗长8～15毫米，中部以上着生多数小苞片；花萼绿色，5深裂，裂片卵状披针形；花冠紫色，5深裂，裂片线形，长约5毫米，基部短筒状；副花冠5，上部围绕于蕊柱顶端，较蕊柱短；雄蕊5，与雌蕊合成蕊柱，花药2室；雌蕊1，子房上位，2心皮几乎分离，花柱2，在顶端连合成一平盘状的柱头。蓇葖果角状，长约7厘米。种子多数，顶端具白色细绒毛。花期6月。果期10月。"}]},{"ID":"20240614125817-71eepvp","Type":"NodeParagraph","Properties":{"id":"20240614125817-71eepvp","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"生长于溪滩、江边砂碛之上或山谷中阴湿处。分布浙江、江苏、安徽、江西、湖南、湖北、广西、广东、贵州、云南、四川等地。"}]},{"ID":"20240614125817-ny5jh27","Type":"NodeParagraph","Properties":{"id":"20240614125817-ny5jh27","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"②芜花叶白前，又名：溪瓢羹、消结草、乌梗仔。"}]},{"ID":"20240614125817-iox0ya2","Type":"NodeParagraph","Properties":{"id":"20240614125817-iox0ya2","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"多年生草本，高25～40厘米。根茎匍匐，节上簇生多数须根。茎直立，幼枝被棕色毛茸，老枝往往残留一部分毛茸。叶对生，几无柄；叶片椭圆形，长2.5～5厘米，宽0.8～1.5厘米，先端圆或锐尖，基部楔形，全缘。聚伞状花序腋生；花萼黄绿色，近于全裂，裂片卵形；花冠黄白色，深5裂，裂片卵圆形；副花冠5，黄绿色，肉质瘤状，上部围绕于蕊柱顶端，与蕊柱几等长；雄蕊5，药覆盖蕊柱先端；子房上位，由2个几乎分离的心皮组成，两花柱顶端连合而成肥厚平盘状柱头。蓇葖果1～2个，狭长卵形，长约4.5厘米。种子多数，顶端具白色细绒毛。花期8月。果期9～10月。"}]},{"ID":"20240614125817-u360h2a","Type":"NodeParagraph","Properties":{"id":"20240614125817-u360h2a","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"生长环境及分布与柳叶白前同。两者常群生一起。"}]},{"ID":"20240614125817-j165sju","Type":"NodeParagraph","Properties":{"id":"20240614125817-j165sju","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614125817-wlbe359","Type":"NodeParagraph","Properties":{"id":"20240614125817-wlbe359","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" ①柳叶白前"}]},{"ID":"20240614125817-qaxwly5","Type":"NodeParagraph","Properties":{"id":"20240614125817-qaxwly5","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"又名：鹤管白前。为干燥的根茎及根，弯曲扭转而成团状。根茎呈管状，细长有节，略弯曲，长约4～15厘米，直径1.5～5毫米，表面浅黄色至黄棕色，有细纵皱纹，节部膨大，常有分歧，并密生须根，顶端常残留灰绿色或紫棕色的地上茎；质坚脆，易折断，断面类圆形，中空或有膜质的髓。根细长弯曲，长约1～10厘米，多数呈毛须状，表面棕色或紫棕色，有细缴皱，并具多数小须根。质坚脆，易折断，断面类白色，扩大镜下可见中心木部。气微弱，味甜。"}]},{"ID":"20240614125817-ibmg82n","Type":"NodeParagraph","Properties":{"id":"20240614125817-ibmg82n","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"②芫花叶白前"}]},{"ID":"20240614125817-kde0tfr","Type":"NodeParagraph","Properties":{"id":"20240614125817-kde0tfr","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"干燥的根及根茎，形状与柳叶白前相似，但根茎及地上茎节部的芽对生而显著；根较长而粗，长约5～20厘米，直径约0.5～1毫米；色亦较浅，常为灰黄色。气微弱，味微甜。"}]},{"ID":"20240614125817-zl6dmrt","Type":"NodeParagraph","Properties":{"id":"20240614125817-zl6dmrt","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"以上两种，均以根茎粗、须根长、无泥土及杂质者为佳。"}]},{"ID":"20240614125817-pt6qou6","Type":"NodeParagraph","Properties":{"id":"20240614125817-pt6qou6","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"主产浙江、安徽，此外，江苏、湖北、江西等地亦产。"}]},{"ID":"20240614125817-abbj81a","Type":"NodeParagraph","Properties":{"id":"20240614125817-abbj81a","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614125817-82xgf01","Type":"NodeParagraph","Properties":{"id":"20240614125817-82xgf01","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 含三萜皂甙、海罂栗甙元A、B（glaucogenin A，B）、海罂粟甙A（glaucoside A）及海罂粟甙元C- 黄花夹竹桃单糖甙（glaucogenin- C-mono- D-theve-toside）等。芫花叶白前含三萜皂甙。"}]},{"ID":"20240614125817-rpr9our","Type":"NodeParagraph","Properties":{"id":"20240614125817-rpr9our","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614125817-uhyh7us","Type":"NodeParagraph","Properties":{"id":"20240614125817-uhyh7us","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 白前：拣去杂质，洗净泥土，稍浸泡后捞出，润透，切段，晒干。蜜白前：取白前片用炼蜜加水适量拌匀，文火炒至蜜汁全部吸干，呈老黄色不粘手为度，取出放凉。（每白前片100斤，用炼蜜25斤）"}]},{"ID":"20240614125817-nzolhhz","Type":"NodeParagraph","Properties":{"id":"20240614125817-nzolhhz","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使白前，先用生甘草水浸一伏时后漉出，去头须了，焙干。任入药中用。\""}]},{"ID":"20240614125817-pv90akf","Type":"NodeParagraph","Properties":{"id":"20240614125817-pv90akf","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614125817-8ygk793","Type":"NodeParagraph","Properties":{"id":"20240614125817-8ygk793","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 入肺经。"}]},{"ID":"20240614125817-dfffts4","Type":"NodeParagraph","Properties":{"id":"20240614125817-dfffts4","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"手太阴。\""}]},{"ID":"20240614125817-26vbpx9","Type":"NodeParagraph","Properties":{"id":"20240614125817-26vbpx9","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肝、肺二经。\""}]},{"ID":"20240614125817-8opkgj3","Type":"NodeParagraph","Properties":{"id":"20240614125817-8opkgj3","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614125817-2dfdgmj","Type":"NodeParagraph","Properties":{"id":"20240614125817-2dfdgmj","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 辛甘，微温。"}]},{"ID":"20240614125817-2jx5zsm","Type":"NodeParagraph","Properties":{"id":"20240614125817-2jx5zsm","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味甘，微温，无毒。\""}]},{"ID":"20240614125817-oyvnxfg","Type":"NodeParagraph","Properties":{"id":"20240614125817-oyvnxfg","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味辛。\""}]},{"ID":"20240614125817-u0f52a7","Type":"NodeParagraph","Properties":{"id":"20240614125817-u0f52a7","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"③《药材资料汇编》：\"味苦，微辛。\""}]},{"ID":"20240614125817-dhfyg2r","Type":"NodeParagraph","Properties":{"id":"20240614125817-dhfyg2r","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614125817-p4p8w69","Type":"NodeParagraph","Properties":{"id":"20240614125817-p4p8w69","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 《本草经疏》：\"凡咳逆上气，咳嗽气逆，由于气虚气不归元，而不由于肺气因邪客壅实者，禁用。\""}]},{"ID":"20240614125817-c19ya4c","Type":"NodeParagraph","Properties":{"id":"20240614125817-c19ya4c","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614125817-6ijiofl","Type":"NodeParagraph","Properties":{"id":"20240614125817-6ijiofl","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 泻肺降气，下痰止嗽。治肺实喘满，咳嗽，多痰，胃脘疼痛。"}]},{"ID":"20240614125817-tnln893","Type":"NodeParagraph","Properties":{"id":"20240614125817-tnln893","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主胸胁逆气，咳嗽上气。\""}]},{"ID":"20240614125817-vs9xouo","Type":"NodeParagraph","Properties":{"id":"20240614125817-vs9xouo","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"主上气冲喉中，呼吸欲绝。\""}]},{"ID":"20240614125817-hcekgb1","Type":"NodeParagraph","Properties":{"id":"20240614125817-hcekgb1","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"洽贲豚肾气，肺气烦闷及上气。\""}]},{"ID":"20240614125817-p2pxa45","Type":"NodeParagraph","Properties":{"id":"20240614125817-p2pxa45","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"降气下痰。\""}]},{"ID":"20240614125817-k46kfuy","Type":"NodeParagraph","Properties":{"id":"20240614125817-k46kfuy","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"⑤《本草备要》：\"泻肺。\""}]},{"ID":"20240614125817-4pzewlm","Type":"NodeParagraph","Properties":{"id":"20240614125817-4pzewlm","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"⑥《福建中草药》：\"行气消积，健脾和胃。\""}]},{"ID":"20240614125817-kfngj2b","Type":"NodeParagraph","Properties":{"id":"20240614125817-kfngj2b","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614125817-0b1qdis","Type":"NodeParagraph","Properties":{"id":"20240614125817-0b1qdis","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱。"}]},{"ID":"20240614125817-00flcpw","Type":"NodeParagraph","Properties":{"id":"20240614125817-00flcpw","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614125817-v7tnu0k","Type":"NodeParagraph","Properties":{"id":"20240614125817-v7tnu0k","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" ①治久患暇呷咳嗽，喉中作声，不得眠：白前，捣为末，温酒调二钱匕，服。（《梅师集验方》）"}]},{"ID":"20240614125817-qyu3bz8","Type":"NodeParagraph","Properties":{"id":"20240614125817-qyu3bz8","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"②治久嗽兼唾血：白前三两，桑白皮、桔梗各二两，甘草一两（炙）。上四味切，以水二大升，煮取半大升，空腹顿服。若重者，十数剂。忌猪肉、海藻、菘菜。（《近效方》）"}]},{"ID":"20240614125817-widkca0","Type":"NodeParagraph","Properties":{"id":"20240614125817-widkca0","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"③治胃脘痛，虚热痛：白前和重阳木根各五钱。水煎服。"}]},{"ID":"20240614125817-t4bjg42","Type":"NodeParagraph","Properties":{"id":"20240614125817-t4bjg42","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"④治疟母（脾肿大）：白前五钱。水煎服。"}]},{"ID":"20240614125817-m752acb","Type":"NodeParagraph","Properties":{"id":"20240614125817-m752acb","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"⑤治小儿疳积：白前、重阳木或兖州卷柏全草各三钱。水炖服。"}]},{"ID":"20240614125817-l8p2gpi","Type":"NodeParagraph","Properties":{"id":"20240614125817-l8p2gpi","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"⑥治跌打胁痛：白前五钱，香附三钱，青皮一钱。水煎服。（③方以下出《福建中草药》）"}]},{"ID":"20240614125817-q3nq0w2","Type":"NodeParagraph","Properties":{"id":"20240614125817-q3nq0w2","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614125817-kgntu3q","Type":"NodeParagraph","Properties":{"id":"20240614125817-kgntu3q","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614125817-yy5d8nb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125817-yy5d8nb","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"《中华本草》：白前"}]},{"ID":"20240614125817-df8xzf1","Type":"NodeParagraph","Properties":{"id":"20240614125817-df8xzf1","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614125817-bkhb27v","Type":"NodeParagraph","Properties":{"id":"20240614125817-bkhb27v","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" Bái Qián"}]},{"ID":"20240614125817-80pmzcf","Type":"NodeParagraph","Properties":{"id":"20240614125817-80pmzcf","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614125817-ok8oha8","Type":"NodeParagraph","Properties":{"id":"20240614125817-ok8oha8","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 石蓝、嗽药、柳叶白前、水杨柳、大鹤瓢、水柳、芫花叶白前、溪瓢羹、消结草、乌梗仔、蜜白前、炒白前、鹅管白前"}]},{"ID":"20240614125817-z6muo5e","Type":"NodeParagraph","Properties":{"id":"20240614125817-z6muo5e","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614125817-6i3z3jo","Type":"NodeParagraph","Properties":{"id":"20240614125817-6i3z3jo","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" Willowleaf Swallowwort Rhizome， Glaucescent Swallowwort Rhizome， Rhizome of Willowleaf Swallowwort， Rhizome of Glaucescent Swallowwort"}]},{"ID":"20240614125817-wg86t3b","Type":"NodeParagraph","Properties":{"id":"20240614125817-wg86t3b","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614125817-jhyrgd4","Type":"NodeParagraph","Properties":{"id":"20240614125817-jhyrgd4","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 出自1.《别录》。"}]},{"ID":"20240614125817-5btn7e4","Type":"NodeParagraph","Properties":{"id":"20240614125817-5btn7e4","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：白前，出近道。似细辛而大，色白易折。主气嗽方多用之。"}]},{"ID":"20240614125817-erku103","Type":"NodeParagraph","Properties":{"id":"20240614125817-erku103","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：白前，叶似柳，或似芫花，苗高尺许，生洲渚沙碛之上。根白，长于细辛，味甘。俗以酒渍服，主上气。不生近道。今用蔓生者，味苦，非真也。"}]},{"ID":"20240614125817-8s2v6j5","Type":"NodeParagraph","Properties":{"id":"20240614125817-8s2v6j5","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"4.《开宝本草》：别本注云，(白前)二月、八月采根，暴干。根似牛膝、白薇。"}]},{"ID":"20240614125817-hkmyv9v","Type":"NodeParagraph","Properties":{"id":"20240614125817-hkmyv9v","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：白前，今蜀中及淮、浙州郡皆有之。"}]},{"ID":"20240614125817-hxkcr4m","Type":"NodeParagraph","Properties":{"id":"20240614125817-hxkcr4m","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614125817-mptt32f","Type":"NodeParagraph","Properties":{"id":"20240614125817-mptt32f","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 药材基源：为双子叶植物药萝藦科植物柳叶白前或芫花叶白前的根及根茎。"}]},{"ID":"20240614125817-l4l1gmr","Type":"NodeParagraph","Properties":{"id":"20240614125817-l4l1gmr","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Cynanchum stauntoni(Decne.) Schltr. Ex Levl.[pcntasacme stauntonii Deone]2.Cynanchum glaucescens(Decne.) Hand. Mazz.[pentasachme glaucescens Deone]"}]},{"ID":"20240614125817-9pilvsx","Type":"NodeParagraph","Properties":{"id":"20240614125817-9pilvsx","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后第2年秋后挖取全株，将根及根茎采下，洗净，晒干或烘干。"}]},{"ID":"20240614125817-mnwaiko","Type":"NodeParagraph","Properties":{"id":"20240614125817-mnwaiko","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614125817-l4c8fqf","Type":"NodeParagraph","Properties":{"id":"20240614125817-l4c8fqf","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.柳叶白前生长于溪滩、江边砂碛处，以至半浸于水中。"}]},{"ID":"20240614125817-zgl8682","Type":"NodeParagraph","Properties":{"id":"20240614125817-zgl8682","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"2.芫花叶白前生长环境及分布与柳叶白前同。两者常群生一起。"}]},{"ID":"20240614125817-z8pni9p","Type":"NodeParagraph","Properties":{"id":"20240614125817-z8pni9p","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"资源分布：1.柳叶白前分布于江苏、江苏、安徽、浙江、江西、福建、湖北、湖南、广东、广西、贵州等地。"}]},{"ID":"20240614125817-gutntmg","Type":"NodeParagraph","Properties":{"id":"20240614125817-gutntmg","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"2.芫花叶白前分布与柳叶白前相同。"}]},{"ID":"20240614125817-5lu2d08","Type":"NodeParagraph","Properties":{"id":"20240614125817-5lu2d08","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614125817-nq3wwto","Type":"NodeParagraph","Properties":{"id":"20240614125817-nq3wwto","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 1.多年生直立半灌木，高0.5-1cm。根茎横生或斜生，空如鹅管状，系极发达，根多而细，呈须状，黄白色或略带红棕。茎圆柱形，表面灰绿色，有细棱。叶对生，具短柄；叶片纸质，披针形或线状披针形，长3-12cm，宽0.3-1.4cm,先端渐尖，基部渐窄，全缘，中脉在叶背明显，侧脉约6对。伞形聚伞花序腋生，有3-8朵，小苞片多数；花萼5深裂，内面基部腺体不多；花冠辐状，5深裂，裂片线形，紫红色，内面具长柔毛；副花冠裂征盾状，肥厚，较花药为短；雄蕊5，与雌蕊合生成蕊柱，花药2室每室具一淡黄色下垂的花粉块；柱头微突，包在花药的薄膜内。蓇葖果单生，窄长披针形，长达9cm。种子披针形，黄棕色。先端具白色丝状绢毛。花期5-8月，果期9-10月。"}]},{"ID":"20240614125817-njwq6v7","Type":"NodeParagraph","Properties":{"id":"20240614125817-njwq6v7","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"2.芫花叶白前 本种与柳叶白前的区别点为：茎具2列柔毛。叶片长椭圆形或长圆状披针形，先端略钝，状如芫花叶，长3-5cm，宽1-1.5cm，近于无柄。花较大，花冠黄白色。"}]},{"ID":"20240614125817-rybye3t","Type":"NodeParagraph","Properties":{"id":"20240614125817-rybye3t","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614125817-bzqdiew","Type":"NodeParagraph","Properties":{"id":"20240614125817-bzqdiew","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 生物学物性 喜温暖湿润气候，忌干燥，适宜土层深厚肥沃的腐殖土壤栽培。"}]},{"ID":"20240614125817-c77uv5l","Type":"NodeParagraph","Properties":{"id":"20240614125817-c77uv5l","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子或分根繁殖。种子繁殖：春季2月、3月播种育苗，4月底或5月初苗高15cm左右即可移栽。分根繁殖：宜在春季3月、4月进行，每株根茎应带有芽1-2个，穴栽，每穴1株，覆土压实。"}]},{"ID":"20240614125817-bc7stsz","Type":"NodeParagraph","Properties":{"id":"20240614125817-bc7stsz","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期应注意除草、浇水。苗高30cm左右，追肥1次。"}]},{"ID":"20240614125817-vyk6mns","Type":"NodeParagraph","Properties":{"id":"20240614125817-vyk6mns","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614125817-uhych3i","Type":"NodeParagraph","Properties":{"id":"20240614125817-uhych3i","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）柳叶白前根茎圆柱形，有分枝，长4-14cm，直径2-4mm；表面黄白色至黄棕色，具细纵皱纹，节明显，节间长1.5-4cm，顶端有数个残茎；质脆易断，断面中空或有膜质髓。根纤细而弯曲，簇生于节处，长工3-10cm，直径不及1mm，多次分枝成毛须状，常盘结成团；质脆，断面白色。气微味苦。"}]},{"ID":"20240614125817-5rgl9cm","Type":"NodeParagraph","Properties":{"id":"20240614125817-5rgl9cm","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"（2）芫花叶白前 根茎较短小；表面灰绿色或淡黄色，节间长1-2cm；质较硬，折断面空腔较小。须根稍粗长，长5-15cm，直径约1mm，分枝较小；质脆，易折断。以根茎粗壮、须根长者为佳。"}]},{"ID":"20240614125817-yxdkt67","Type":"NodeParagraph","Properties":{"id":"20240614125817-yxdkt67","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"显微鉴别（1）柳叶白前 根茎横切面：表皮细胞1列，外侧壁增厚。下皮为1列较小的细胞。皮层有乳波士顿管。有时可见中柱鞘纤维继续排列成环，前有单个或成群的石细胞。维管束双韧型，木质部导管、木纤维及木薄壁细胞均木化。髓多成空腔。本品薄壁细胞含淀粉粒或草酸钙簇晶。根横切面：表皮细胞外侧壁增厚。皮层出不穷薄壁细胞含淀粉或草酸钙簇晶。内皮层氏明显。中柱鞘为1列薄壁细胞。韧皮部狭窄，木质部二原型。"}]},{"ID":"20240614125817-v0u140z","Type":"NodeParagraph","Properties":{"id":"20240614125817-v0u140z","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"（2）芫花叶白前 根茎皮层没有乳汁管，其余与柳叶白前相似。"}]},{"ID":"20240614125817-unbnj9e","Type":"NodeParagraph","Properties":{"id":"20240614125817-unbnj9e","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614125817-7h8g0xo","Type":"NodeParagraph","Properties":{"id":"20240614125817-7h8g0xo","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 柳叶白前根茎中含有β-谷甾醇（β-sitosterol），高级脂肪酸和华北白前醇（hancokind)[1]2.芫花叶白前根中含有白前皂甙（glaucoside)A,B,C,D,E[2],F，G[3]，H，I，J[4]，K[5]，白前皂甙式（glaucogenin)A和B，白前皂甙式C单-D-黄花夹竹桃糖甙（glaucogenin C-mono-D-thevetlside）[6]，白前新皂甙（neoglaucoside)A和B[5]及白前二糖（glaucobiose）[7]。"}]},{"ID":"20240614125817-ryjd51t","Type":"NodeParagraph","Properties":{"id":"20240614125817-ryjd51t","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614125817-pfzjaeg","Type":"NodeParagraph","Properties":{"id":"20240614125817-pfzjaeg","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 皂甙有祛痰作用。"}]},{"ID":"20240614125817-vd4bh55","Type":"NodeParagraph","Properties":{"id":"20240614125817-vd4bh55","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614125817-nvnnvsx","Type":"NodeParagraph","Properties":{"id":"20240614125817-nvnnvsx","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 1.白前：拣去杂质，洗净泥土，稍浸泡后捞出，润透，切段，晒干。"}]},{"ID":"20240614125817-ucrgkt9","Type":"NodeParagraph","Properties":{"id":"20240614125817-ucrgkt9","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"2.炒白前用文火加热，炒至老黄色，微焦，取出放凉。炒后偏于温肺散寒、化痰止咳，多用于寒痰或痰湿、咳喘。"}]},{"ID":"20240614125817-v5dwy0k","Type":"NodeParagraph","Properties":{"id":"20240614125817-v5dwy0k","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"3.密白前现行，取炼密用适量开水稀释，加入白前段拌匀，闷润后置锅内，用文火加热，炒至表面深黄色，不粘手为度，取出放凉。每白前段100kg，用炼密25kg。密炙后可缓和对胃的剌激性，增强润肺止咳作用多用于肺虚咳嗽。饮片性状：白前参见“药材鉴别”项。炒白前形如白前，表面老黄色。密白前表面金黄色，略带粘性，味甜。贮干燥容器内，炒白前、密白前密闭，置阴凉干燥外。"}]},{"ID":"20240614125817-kaxfxla","Type":"NodeParagraph","Properties":{"id":"20240614125817-kaxfxla","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614125817-cqw5qvh","Type":"NodeParagraph","Properties":{"id":"20240614125817-cqw5qvh","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" （1）柳叶白前 取本品粗粉1g加70%乙醇10ml，加热回流1h，滤过。取滤液1ml，置蒸发皿内蒸干，残渣加醋酐1ml，使溶解，再加浓硫酸1滴，显红紫色，放置后变为污绿色。"}]},{"ID":"20240614125817-vxanovm","Type":"NodeParagraph","Properties":{"id":"20240614125817-vxanovm","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"（2）芫花叶白前 试验方法同柳叶白前。加浓硫酸后显棕红色，放置后不变色。"}]},{"ID":"20240614125817-ju18omf","Type":"NodeParagraph","Properties":{"id":"20240614125817-ju18omf","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614125817-e0229ks","Type":"NodeParagraph","Properties":{"id":"20240614125817-e0229ks","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 肺经"}]},{"ID":"20240614125817-n3qfr2m","Type":"NodeParagraph","Properties":{"id":"20240614125817-n3qfr2m","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614125817-xx7v04n","Type":"NodeParagraph","Properties":{"id":"20240614125817-xx7v04n","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 辛甘；微温；无毒"}]},{"ID":"20240614125817-yx40z6u","Type":"NodeParagraph","Properties":{"id":"20240614125817-yx40z6u","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614125817-4bec5z4","Type":"NodeParagraph","Properties":{"id":"20240614125817-4bec5z4","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 《本草经疏》：凡咳逆上气，咳嗽气逆，由于气虚气不归元，而不由于肺气因邪客壅实者，禁用。"}]},{"ID":"20240614125817-e11ys9x","Type":"NodeParagraph","Properties":{"id":"20240614125817-e11ys9x","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614125817-i7jj7jf","Type":"NodeParagraph","Properties":{"id":"20240614125817-i7jj7jf","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 泻肺降气；下痰止嗽。主主冶肺气壅实之咳嗽痰多；气逆喘促；胃脘疼痛；儿疳积；跌打损伤"}]},{"ID":"20240614125817-avfzaka","Type":"NodeParagraph","Properties":{"id":"20240614125817-avfzaka","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614125817-230ly7e","Type":"NodeParagraph","Properties":{"id":"20240614125817-230ly7e","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤3-10g；或入丸、散"}]},{"ID":"20240614125817-ycv5dl3","Type":"NodeParagraph","Properties":{"id":"20240614125817-ycv5dl3","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614125817-1yky7zp","Type":"NodeParagraph","Properties":{"id":"20240614125817-1yky7zp","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 地骨皮汤《圣济总录》；白前汤《千金方》；前胡汤《圣济总录》；防已汤《圣济总录》；款肺病汤《圣济总录》；贝母煎《圣济总录》"}]},{"ID":"20240614125817-0adyk53","Type":"NodeParagraph","Properties":{"id":"20240614125817-0adyk53","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614125817-mqz7zb7","Type":"NodeParagraph","Properties":{"id":"20240614125817-mqz7zb7","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：白前，保定肺气，治嗽多用。以温药相佐使，则尤佳。"}]},{"ID":"20240614125817-5dpmt22","Type":"NodeParagraph","Properties":{"id":"20240614125817-5dpmt22","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：白前，长于降气，肺气壅实而有痰者宜之。若虚而长哽气者不可用。张仲景治嗽而脉沉者，泽漆汤中亦用之。"}]},{"ID":"20240614125817-ivpq80a","Type":"NodeParagraph","Properties":{"id":"20240614125817-ivpq80a","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：白前，肺家之要药。甘能缓，辛能散，温能下，以其长于下气，故主胸胁逆气，咳嗽上气。二病皆气升、气逆，痰随气壅所致，气降则痰自降，能降气则病本立拔矣。白前性温，走散下气，性无补益。深师方中所主久咳上气，体肿短气，胀满，当是有停饮、水湿、湿痰之病，乃可用之，病不由于此者，不得轻施。"}]},{"ID":"20240614125817-lb0r6tb","Type":"NodeParagraph","Properties":{"id":"20240614125817-lb0r6tb","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：白前，较白薇稍温，较细辛稍平。专搜肺窍中风水，非若白薇之咸寒，专泄肺、胃之燥热，亦不似细辛之辛窜，能治肾、肝之沉寒也。"}]},{"ID":"20240614125817-saq862x","Type":"NodeParagraph","Properties":{"id":"20240614125817-saq862x","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：白前，专主肺家，为治咳嗽降气之要药。《别录》谓其微温，以其主治寒嗽，则能疏散寒邪，其性质必含温养之气也。然白前治嗽，亦不专于寒嗽一面，即痰火气壅，上逆咳嗽，亦能定之，则又有似乎寒降，是以苏恭竟作微寒。然其所以能止嗽者，则在于平逆顺气，使膈下之浊气不上凌而犯肺金，斯肺气得顺其清肃之性，而咳自除，此以静肃为用，必不可遽谓其温。且古今主治，恒用之于火气逆升之症，无不应手，自当以苏恭微寒之说为长。且寒邪寒饮之咳，辛温开肺，别有专司，固非白前之长技，特微寒顺气，非如沙参、知母之寒凉直折，亦非如桑根皮、枇杷叶之清降遏抑，故为定咳止嗽之主药，而绝无流弊。虽不见于《本经》，而《别录》主胸胁逆气，咳嗽上气，甚至称其治呼吸欲绝，可见其清肃肺家，功效卓绝。白前顺气，清肃肺金，是其全体大用，此外别无效力。而《日华子本草》且称其治奔豚肾气，殆因其能降肺逆而推广言之。然白前主治上焦，而不能下坠直降，肾气之治，失其旨矣。"}]},{"ID":"20240614125817-afm8jpw","Type":"NodeParagraph","Properties":{"id":"20240614125817-afm8jpw","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"6.《别录》：主胸胁逆气，咳嗽上气。"}]},{"ID":"20240614125817-dcykk3z","Type":"NodeParagraph","Properties":{"id":"20240614125817-dcykk3z","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"7.《唐本草》：主上气冲喉中，呼吸欲绝。"}]},{"ID":"20240614125817-wvytfhk","Type":"NodeParagraph","Properties":{"id":"20240614125817-wvytfhk","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"8.《本草备要》：泻肺。"}]},{"ID":"20240614125817-ivdmd1v","Type":"NodeParagraph","Properties":{"id":"20240614125817-ivdmd1v","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"9.《福建中草药》：行气消积，健脾和胃。"}]},{"ID":"20240614125817-qau5sbq","Type":"NodeParagraph","Properties":{"id":"20240614125817-qau5sbq","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614125817-a2k14k1","Type":"NodeParagraph","Properties":{"id":"20240614125817-a2k14k1","updated":"20240614125817"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614125818-p1yznsw","Type":"NodeThematicBreak","Properties":{"id":"20240614125818-p1yznsw"}},{"ID":"20240614125819-e6vf148","Type":"NodeParagraph","Properties":{"id":"20240614125819-e6vf148"}}]}