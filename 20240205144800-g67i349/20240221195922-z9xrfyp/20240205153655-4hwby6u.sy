0240705101238-ot16w7z"}},{"ID":"20240705091850-ag2b2yk","Type":"NodeParagraph","Properties":{"id":"20240705091850-ag2b2yk","updated":"20240705092528"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"注：郁金为姜科植物温郁金、姜黄、广西莪术、蓬莪术的干燥块根（郁金是一种多基原的中药，很多种植物的块根都可以入药当郁金用的，因此来源较其他中药复杂些）。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240614123841-dxas5hh","Type":"NodeParagraph","Properties":{"id":"20240614123841-dxas5hh","updated":"20240705085617"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"郁金对比图"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/郁金对比图-20240705085556-2mv1hs0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705085733-ebxtv72","Type":"NodeParagraph","Properties":{"id":"20240705085733-ebxtv72","updated":"20240705091143"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"因郁金原产地在浙江温州，所以也叫"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"温郁金"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，是传统浙八味之一。因为颜色灰褐色，有的可以看到断面发黑，有些人也称之为黑郁金。（产地浙江温州；块根呈长卵圆形，略扁，两端渐尖，表面灰褐色，质地坚硬，断面灰棕色；温郁金用光照射透光非常好，有蜡质感）"}]},{"ID":"20240705090121-3o8h0mc","Type":"NodeParagraph","Properties":{"id":"20240705090121-3o8h0mc","updated":"20240705091216"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 509px;","style":"width: 499px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705091213-cl4t60g.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 499px;\" parent-style=\"width: 509px;\"}"},{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"温郁金"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/温郁金-20240705090210-p43yh01.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240705085735-91gw7ke","Type":"NodeParagraph","Properties":{"id":"20240705085735-91gw7ke","updated":"20240705094032"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"姜黄"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"这个植物加工出来的郁金，因为颜色黄，所以也被称为"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"黄丝郁金"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"。（产地云南，块根形态呈纺锤形，两端渐尖表面灰黄色，质地非常坚硬；断面黄色，光照下也是透亮的）"}]},{"ID":"20240705090456-k92dfgx","Type":"NodeParagraph","Properties":{"id":"20240705090456-k92dfgx","updated":"20240705090538"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 279px;","style":"width: 269px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705090456-ealf777.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 269px;\" parent-style=\"width: 279px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 284px;","style":"width: 274px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705090538-7ifzpw6.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 274px;\" parent-style=\"width: 284px;\"}"}]},{"ID":"20240705091250-4gyuxzp","Type":"NodeParagraph","Properties":{"id":"20240705091250-4gyuxzp","updated":"20240705091433"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"还有一种"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"桂郁金"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，也就是广西郁金。"}]},{"ID":"20240705091450-k5826wv","Type":"NodeParagraph","Properties":{"id":"20240705091450-k5826wv","updated":"20240705091450"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705091449-2xl6l1j.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705091442-npqd3yq","Type":"NodeParagraph","Properties":{"id":"20240705091442-npqd3yq","updated":"20240705091633"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在日常生活中，温郁金和桂郁金是最常用的，量最大，黄丝郁金价格高，市场流通量不多。但综合评价来说，黄丝郁金的品质是最好的，香气浓郁。著名中成药安宫牛黄丸里面，最开始用的郁金就是黄丝郁金，后来黄丝郁金替换了，效果其实是打了折扣的。从气味上来看，黄丝郁金的气味，明显是温郁金和桂郁金所不能匹及的。"}]},{"ID":"20240705085250-ajbxbek","Type":"NodeParagraph","Properties":{"id":"20240705085250-ajbxbek"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"如下为分类表。"}]},{"ID":"20240705085211-7eyu322","Type":"NodeParagraph","Properties":{"id":"20240705085211-7eyu322","updated":"20240705085212"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705085212-t293lce.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240614123841-xhw1iac","Type":"NodeThematicBreak","Properties":{"id":"20240614123841-xhw1iac"}},{"ID":"20240614124000-nrzzt37","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124000-nrzzt37","updated":"20240614124006"},"Children":[{"Type":"NodeText","Data":"郁金《本草述钩元》"}]},{"ID":"20240614124000-soqfvkb","Type":"NodeParagraph","Properties":{"id":"20240614124000-soqfvkb","updated":"20240614124008"},"Children":[{"Type":"NodeText","Data":"生蜀地及西戎。今广南江西州郡亦有之，然不及蜀中者佳。四月生苗似姜黄，亦不结实。根如指顶，长者寸许，体圆有横纹如蝉腹状，外黄内赤，不如姜黄纯黄也。"}]},{"ID":"20240614124000-cx58byc","Type":"NodeParagraph","Properties":{"id":"20240614124000-cx58byc","updated":"20240617115342"},"Children":[{"Type":"NodeText","Data":"味辛而苦，气寒性轻扬。气味俱厚。入手少阴足厥阴，兼通足阳明经。主凉心经，治血气心腹痛，及阳毒入胃，下血频痛。疗失心癫狂，血积蛊毒，尿血血淋，女子产后败血冲心。方书治发热郁，狂痫头痛，眩晕咳嗽，齿衄咳血，滞下淋，并目鼻舌喉等证。郁金无香，而性轻扬，能达酒气于高远，古人用治郁遏不能升者。（丹溪）　周人尚臭，灌用鬯，（以郁合秬，酿之成鬯。）阴达于九渊，阳彻于九天，故能条畅于上下，致气于高远以降神也。（之颐）　与香薷合其德，略有异同。香薷偏于卫与阳，郁金偏于营与阴。至于将形脏，弥元府，敷幽门，则一耳。（又）　郁金属火与土而有水，治吐衄唾血血腥，及经脉逆行，并宜磨末。加韭汁、姜汁、童便和服，其血自清。痰中带血者，加竹沥。（丹溪）　入心及包络，治病经验方。有惊忧痰血，络聚心窍，致成颠狂久病。用真郁金七两，明礬三两，为末，薄米糊丸梧子大，每白汤下五十丸。有妇人初服此，心胸间如有物脱去，神气洒然，再服而苏。此由郁金入心去恶血，明礬化顽痰故也。（濒湖）　郁金治诸血证之上行，皆属于内热火炎。盖此药能降气，气降即是火降。又本为血分气药，故血不妄行也。（仲淳）　伤寒斑痘，始有白泡，忽搐入腹，渐作紫黑色，无脓，日夜叫乱者。郁金一枚，甘草二钱半，水半碗，煮干，去甘草，切片烘研为末，入真脑子五分。每用一钱，以生猪血五七滴，新汲水调下，不过二服。甚者毒气从手足心出如痈状，乃瘥。此五死一生之候也。（庞安常）　同番降香、韭菜、生地、当归、童便，治怒气伤肝吐血。胃口作痛，牵引两胁并背，不可忍。郁金一钱半，酒炒香附三钱，条甘草一钱，水酒各半，煎服立效。按此味由气畅血，性本轻扬，其散血积，与他散血之味不同。厥心气痛不可忍。郁金、附子干姜、等分，为末，醋糊丸梧子大，朱砂为衣。每服三十丸，男酒女醋下。按郁金类同寒凉药用，此与姜附治寒水上逆，则其不专以阴胜可知。阳毒下血，热气入胃，痛不可忍。郁金五大个，牛黄一厘，皂荚子为散，每服用醋浆水一盏，同煎三沸，温服。风痰壅滞。郁金一分，藜芦十分，为末。每服一字，温浆水调下，仍以浆水一盏漱口，以食压之。痔疮肿痛。郁金末水调，涂之即消。中砒毒。郁金末二钱，入蜜少许，冷水调服。"}]},{"ID":"20240614124000-q5qwlxs","Type":"NodeParagraph","Properties":{"id":"20240614124000-q5qwlxs","updated":"20240614124000"},"Children":[{"Type":"NodeText","Data":"〔论〕姜黄之味，辛胜于苦，其气温。郁金苦胜于辛，其气寒。方书俱以为入血，不知姜黄本于卫之阳以入血，宣血中结滞之邪而利之。郁金本于营之阴以入血，畅血中精微之化而行之也。郁金四月生苗，秋末乃于茎中吐华，由火土而趋金水，以宣其所孕。且其精英不结于实，仍返于根。根色黄赤，犹存火土之质，而大蕴金水之精。所以气寒而味苦，即火土之质，而气味全蕴金水。故能化火土之浊，即金水之化而形质不离火土，乃能就其阴之精微以肆其阳之脱化。夫精微之化，其气疏越而条达，丹溪所谓轻扬上行，用治遏郁不升，斯言微中矣。（本草首主血积。夫血之周流，由于气治，血积未有不畅气者。）大凡阴阳之气能化，未有不本于升降者，能升未有不降者。观其去心经痰血之络，聚并包络与胃中血热之毒，上而头面一切，下及二便，是岂升而不降者哉？至于洁古纯阴之说，当不尽然，何者？兹味之使阳脱化，乃其阴之精微也，固非以气之辛散为功，又岂纯阴而不能化者，所得奏效于上下。且纯阴性味，必不能解郁也。试就根之黄赤而却苦寒，两不相忤以为理，其义可参。"}]},{"ID":"20240614124000-ldcjgz0","Type":"NodeParagraph","Properties":{"id":"20240614124000-ldcjgz0","updated":"20240614124013"},"Children":[{"Type":"NodeText","Data":"缪氏云：凡阴虚火炎，薄血上溢，而非气分拂逆伤肝致吐者，不宜用，即用亦无效。"}]},{"ID":"20240614124000-ckflb3x","Type":"NodeParagraph","Properties":{"id":"20240614124000-ckflb3x","updated":"20240614124014"},"Children":[{"Type":"NodeText","Data":"〔辨治〕郁金、姜黄，实不同种。郁金味苦寒，色赤类蝉肚圆尖。姜黄味辛温，色黄似姜瓜圆大。第郁金最少，而姜黄常多，今市家欺人，谓原本一物，指其大者为姜黄，小者为郁金，不可不察。倘难得真郁金，可采山茶花烧灰存性，研细调服代之。（嘉谟）　置生鸡血中化成水者真。磨汁，临服入药。"}]},{"ID":"20240614123842-4shjpq4","Type":"NodeThematicBreak","Properties":{"id":"20240614123842-4shjpq4"}},{"ID":"20240614123936-rodzosx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123936-rodzosx","updated":"20240614123940"},"Children":[{"Type":"NodeText","Data":"郁金《新修本草》"}]},{"ID":"20240614123936-v3gajrp","Type":"NodeParagraph","Properties":{"id":"20240614123936-v3gajrp","updated":"20240614123936"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒，无毒。主血积，下气，生肌，止血，破恶血，血淋，尿血，金疮。"}]},{"ID":"20240614123936-x52ptfi","Type":"NodeParagraph","Properties":{"id":"20240614123936-x52ptfi","updated":"20240614123936"},"Children":[{"Type":"NodeText","Data":"此药苗似姜黄，花白质红，末秋出茎，心无实，根黄赤，取四畔子根，去皮火干之。生蜀地及西戎，马药用之。破血而补。胡人谓之马 。岭南者有实似小豆蔻，不堪啖。（新附）"}]},{"ID":"20240614123842-jd6f1og","Type":"NodeThematicBreak","Properties":{"id":"20240614123842-jd6f1og"}},{"ID":"20240614123926-fmjecxm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123926-fmjecxm","updated":"20240614123930"},"Children":[{"Type":"NodeText","Data":"郁金《本草从新》"}]},{"ID":"20240614123926-bxw5gq8","Type":"NodeParagraph","Properties":{"id":"20240614123926-bxw5gq8","updated":"20240614123926"},"Children":[{"Type":"NodeText","Data":"（宣、解郁、泻、凉血破瘀．）"}]},{"ID":"20240614123926-oi0g2p6","Type":"NodeParagraph","Properties":{"id":"20240614123926-oi0g2p6","updated":"20240614123926"},"Children":[{"Type":"NodeText","Data":"辛苦微甘．气寒．其性轻扬．上行入心及包络．兼入肺经．凉心热．散肝郁．破血下气．治吐衄尿血．妇人经脉逆行．（经不下行、上为吐衄诸证、用郁金末、加韭汁、姜汁、童便服、其血自清、痰中带血者、加竹沥．）血气诸痛．产后败血攻心．颠狂失心．（颠多喜笑、尚知畏惧、证属不足、狂多忿怒、人莫能制、证属有余、因惊忧痰血塞于心窍所致、用郁金七两、白矾三两、薄荷糊丸、名白金丸、郁金散恶血、白矾化顽痰．）痘毒入心．（因瘀血凝滞、而痘疹陷伏者、可用．）阳毒．生肌定痛．能开肺金之郁．故名．今医用此开郁．罕效．"}]},{"ID":"20240614123926-37p5iax","Type":"NodeParagraph","Properties":{"id":"20240614123926-37p5iax","updated":"20240614123926"},"Children":[{"Type":"NodeText","Data":"如真阴虚火亢吐血．不关肺肝气逆．不宜用也．（近日郁证、多属血亏、用破血之药开郁、郁不能开、而阴已先败、致不救者多矣．）出川广．体锐圆如蝉肚．外黄内赤．色鲜微香．"}]},{"ID":"20240614123926-0uc2tsv","Type":"NodeParagraph","Properties":{"id":"20240614123926-0uc2tsv","updated":"20240614123926"},"Children":[{"Type":"NodeText","Data":"折之光明脆彻．苦中带甘者乃真．（今市中所用者、多是姜黄、并有以蓬莪术伪之者、俱峻削性烈、挟虚者大忌．）"}]},{"ID":"20240614123842-v7zo2hd","Type":"NodeThematicBreak","Properties":{"id":"20240614123842-v7zo2hd"}},{"ID":"20240614123916-uz7n2ic","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123916-uz7n2ic","updated":"20240614123919"},"Children":[{"Type":"NodeText","Data":"郁金《要药分剂》"}]},{"ID":"20240614123916-czkq44b","Type":"NodeParagraph","Properties":{"id":"20240614123916-czkq44b","updated":"20240614123916"},"Children":[{"Type":"NodeText","Data":"味辛苦。性寒。无毒。禀天令清凉之气。兼得土中金火之味以生。降也。阴也。入酒亦能升。"}]},{"ID":"20240614123916-c4u4t9x","Type":"NodeParagraph","Properties":{"id":"20240614123916-c4u4t9x","updated":"20240614123916"},"Children":[{"Type":"NodeText","Data":"【主治】主血积。下气。生肌止血。血淋。尿血。金疮。（本经）单用治女人宿血气心痛。"}]},{"ID":"20240614123916-x28t74y","Type":"NodeParagraph","Properties":{"id":"20240614123916-x28t74y","updated":"20240614123916"},"Children":[{"Type":"NodeText","Data":"冷心癫狂蛊【归经】入心肝二经。兼入胃经。为行气解郁凉血破瘀之品。（兼泻剂）【前论】仲淳曰。郁金本入血分之气药。其治诸血症者。正谓血之上行皆属内热火炎。"}]},{"ID":"20240614123916-qf9nphi","Type":"NodeParagraph","Properties":{"id":"20240614123916-qf9nphi","updated":"20240614123916"},"Children":[{"Type":"NodeText","Data":"此药乃【禁忌】经疏曰。凡病属真阴虚极。阴分火炎。迫血妄行。溢出上窍。而非气分拂逆。"}]},{"ID":"20240614123842-9kpma6q","Type":"NodeThematicBreak","Properties":{"id":"20240614123842-9kpma6q"}},{"ID":"20240614123858-xpjs31i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123858-xpjs31i","updated":"20240614123903"},"Children":[{"Type":"NodeText","Data":"郁金《本草纲目》"}]},{"ID":"20240614123858-h1m6qhk","Type":"NodeParagraph","Properties":{"id":"20240614123858-h1m6qhk","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"「释名」马。"}]},{"ID":"20240614123858-1kzqpnd","Type":"NodeParagraph","Properties":{"id":"20240614123858-1kzqpnd","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、苦、寒、无毒。"}]},{"ID":"20240614123858-uy6fckl","Type":"NodeParagraph","Properties":{"id":"20240614123858-uy6fckl","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614123858-zuu92q2","Type":"NodeParagraph","Properties":{"id":"20240614123858-zuu92q2","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"1、颠狂症。用郁金七两、明矾三两，共研为末，加稀同做成丸子，如梧子大。每服五十丸，开水送下。"}]},{"ID":"20240614123858-lc379d7","Type":"NodeParagraph","Properties":{"id":"20240614123858-lc379d7","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"2、痘毒攻心（痘疮忽由白色变成紫黑我，不出脓，日夜哭叫）。用郁金一枚、甘草二钱半，加水半碗煮干，去甘草，将郁金切片焙干，研为末，加脑子（炒）半钱。每服一钱，以生猪血五七滴和新汲水调下。二服后毒气从手足心发出，如痈状，病乃全愈。"}]},{"ID":"20240614123858-ifscn81","Type":"NodeParagraph","Properties":{"id":"20240614123858-ifscn81","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"3、心气痛。和郁金、附子、干姜，等分为末，加醋、糊做成丸子，如梧子大。朱砂为衣。每服三十丸。男用酒，女用醋送下。"}]},{"ID":"20240614123858-xhpbzm3","Type":"NodeParagraph","Properties":{"id":"20240614123858-xhpbzm3","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"4、产后心痛（血气上冲欲死）。用郁金（烧存性）研细，取二钱，以米醋调灌能，转危为安。"}]},{"ID":"20240614123858-acxhz99","Type":"NodeParagraph","Properties":{"id":"20240614123858-acxhz99","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"5、鼻血、吐血。用郁金研细，水服二钱。不愈。再服一次。"}]},{"ID":"20240614123858-b8az12g","Type":"NodeParagraph","Properties":{"id":"20240614123858-b8az12g","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"6、阳毒下血（热气入骨，痛不可忍）。用郁金五个，牛黄一个、如皂荚子大，做成散剂，每服用醋浆水一碗煎三沸后，待温把药送下。"}]},{"ID":"20240614123858-ddyhra6","Type":"NodeParagraph","Properties":{"id":"20240614123858-ddyhra6","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"7、尿血。用郁金一两、葱白一握，加水一碗煎成三合，温服。一天服三次。"}]},{"ID":"20240614123858-k9k43gk","Type":"NodeParagraph","Properties":{"id":"20240614123858-k9k43gk","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"8、风痰壅塞。用郁金一分、藜芦十分，共研为末。每取少许，温浆水调下。同时，以浆水一碗，漱口吐涎。可以吃一点东西压一下药味。"}]},{"ID":"20240614123858-iaig6pa","Type":"NodeParagraph","Properties":{"id":"20240614123858-iaig6pa","updated":"20240614123858"},"Children":[{"Type":"NodeText","Data":"9、痔疮肿痛。用郁金研细，加水调匀搽患处。"}]},{"ID":"20240614123842-17d6ljg","Type":"NodeThematicBreak","Properties":{"id":"20240614123842-17d6ljg"}},{"ID":"20240614123843-7w143zv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123843-7w143zv","updated":"20240614123848"},"Children":[{"Type":"NodeText","Data":"郁金《神农本草经读》"}]},{"ID":"20240614123843-i2f114q","Type":"NodeParagraph","Properties":{"id":"20240614123843-i2f114q","updated":"20240614123843"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒主血积，下气，生肌止血，破恶血，血淋，尿血，金疮。（《唐本草》）陈修园曰∶时医徇名有二误∶一曰生脉散，因其有生脉二字，每用之以救脉脱，入咽少顷，脉未生而人已死矣。一曰郁金，因其命名为郁，往往取治于气郁之症，数服之后，郁末解，而血脱立至矣。医道不明，到处皆然，而江、浙、闽、粤尤其甚者。"}]},{"ID":"20240614123240-ezdz5qp","Type":"NodeThematicBreak","Properties":{"id":"20240614123240-ezdz5qp"}},{"ID":"20240614123829-2wldji7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123829-2wldji7","updated":"20240614123835"},"Children":[{"Type":"NodeText","Data":"郁金《本草便读》"}]},{"ID":"20240614123829-nkq3rv9","Type":"NodeParagraph","Properties":{"id":"20240614123829-nkq3rv9","updated":"20240614123829"},"Children":[{"Type":"NodeText","Data":"解郁宽胸．心肺可通肝可及．辛开苦降．血瘀能逐气能宣．因其质属芳香．豁痰涎于心窍．却谓性偏寒燥．疗癫痫于肝家．广产者色黄．善行气而有功肺部．川产者色紫．能破血而兼达营中．（郁金辛苦而寒．善宣善达．入上焦心肺二经．功专破血行气．气行血开．则郁自解．痰自降．其所以祛心窍痰涎恶血者．皆无非辛散苦降之功．川产者色紫质坚．稍有区别耳．郁金之功．皆取其苦辛香燥．逐瘀行气力量．若病因虚而致者．不可用也．）"}]},{"ID":"20240614123307-mw6gbnm","Type":"NodeThematicBreak","Properties":{"id":"20240614123307-mw6gbnm"}},{"ID":"20240614123818-6ocpcdg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123818-6ocpcdg","updated":"20240614123823"},"Children":[{"Type":"NodeText","Data":"郁金《本草分经》"}]},{"ID":"20240614123818-ma4aq21","Type":"NodeParagraph","Properties":{"id":"20240614123818-ma4aq21","updated":"20240614123818"},"Children":[{"Type":"NodeText","Data":"辛苦微甘，轻扬上行，入心包、心、肺，凉心热，散肝郁，破血下气，治经水逆行、气血诸痛，耗真阴。"}]},{"ID":"20240614123308-itgo8hl","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-itgo8hl"}},{"ID":"20240614123730-w5o7xhd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123730-w5o7xhd","updated":"20240614123738"},"Children":[{"Type":"NodeText","Data":"郁金《本草图经》"}]},{"ID":"20240614123730-82od63n","Type":"NodeParagraph","Properties":{"id":"20240614123730-82od63n","updated":"20240614123734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"郁金"},{"Type":"NodeText","Data":"，《本经》不载所出州土。苏恭云∶生蜀地及西戎，胡人谓之马 。"}]},{"ID":"20240614123730-436moum","Type":"NodeParagraph","Properties":{"id":"20240614123730-436moum","updated":"20240614123730"},"Children":[{"Type":"NodeText","Data":"今广南、江西州郡亦有之，然不及蜀中者佳。四月初生，苗似姜黄；花白质红，末秋出茎，心无实；根黄赤，去四畔子根，去皮，火干之。古方稀用，今小儿方及马医多用之。谨按许慎《说文解字》云∶郁，芳草也。十叶为贯，百二十贯，筑以煮之为郁。郁，今郁林郡也。木部中品有郁金香，云生大秦国，二月、三月有花，状如红蓝。其花即香也。陈氏云∶为百草之英。既云百草之英，乃是草类，又与此同名，而在木部非也。今人不复用，亦无辨之者，故但附于此耳。"}]},{"ID":"20240614123308-jc05lqh","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-jc05lqh"}},{"ID":"20240614123717-cz2cx6q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123717-cz2cx6q","updated":"20240614123723"},"Children":[{"Type":"NodeText","Data":"郁金《证类本草》"}]},{"ID":"20240614123717-d3c87s0","Type":"NodeParagraph","Properties":{"id":"20240614123717-d3c87s0","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒，无毒。主血积下气，生肌止血，破恶血，血淋尿血，金疮。"}]},{"ID":"20240614123717-h5hl1va","Type":"NodeParagraph","Properties":{"id":"20240614123717-h5hl1va","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此药苗似姜黄，花白质红，末秋出茎心，无实，根黄赤。取四畔子根，去皮火干之。生蜀地及西戎。马药用之，破血而补，胡人谓之马 。岭南者有实似小豆蔻，不堪啖。"}]},{"ID":"20240614123717-jp6j83v","Type":"NodeParagraph","Properties":{"id":"20240614123717-jp6j83v","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"（唐本先附）臣禹锡等谨按药性论云∶郁金，单用亦可。治女人宿血气心痛，冷气结聚。温醋摩服之。亦啖马药，用治胀痛。"}]},{"ID":"20240614123717-dkiqdkv","Type":"NodeParagraph","Properties":{"id":"20240614123717-dkiqdkv","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"图经曰∶郁金，《本经》不载所出州土，苏恭云∶生蜀地及西戎，胡人主谓之马 ，今广南、江西州郡亦有之，然不及蜀中者佳。四月初生，苗似姜黄，花白质红，末秋出茎心，无实。"}]},{"ID":"20240614123717-53apkfg","Type":"NodeParagraph","Properties":{"id":"20240614123717-53apkfg","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"根黄赤，取四畔子根，去皮火干之。古方稀用。今小儿方及马医多用之。谨按许慎《说文解字》云∶郁，芳草也。十叶为贯，百二十贯筑以煮之为郁。郁，今郁林郡也。木部中品有郁金香，云生大秦国。二月、三月有花，状如红蓝，其花即香也。陈氏云∶为百草之英，既云百草之英，乃是草类。又与此同名，而在木部，非也。今人不复用，亦无辨之者，故但附于此耳。"}]},{"ID":"20240614123717-oh6if9u","Type":"NodeParagraph","Properties":{"id":"20240614123717-oh6if9u","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"经验方∶治尿血不定。以一两捣为末，葱白一握相和，以水一盏，煎至三合，去滓，温服，日须三服。经验后方∶治风痰。郁金一分，藜芦十分，各为末，和令匀，每服一字，用温浆水一盏，先以少浆水调下，余者水漱口都服。便以食压之。孙用和治阳毒入胃，下血频，疼痛不可忍。郁金五个大者，牛黄一皂荚子，别细研，二味同为散。每服用醋浆水一盏，同煎三沸，温服。丹房镜源云灰可用结砂子。说文曰芳草也。十叶为贯，百廿贯筑以煮之为郁。从臼门缶鬯 其饰也，一曰郁鬯，百草之华。远方郁人，所贡芳草。合酿之以降神。周礼郁人，凡祭祀之裸，用郁鬯。"}]},{"ID":"20240614123717-7lft99l","Type":"NodeParagraph","Properties":{"id":"20240614123717-7lft99l","updated":"20240614123717"},"Children":[{"Type":"NodeText","Data":"衍义曰∶郁金不香，今人将染妇人衣最鲜明，然不耐日炙。染成衣，则微有郁金之气。"}]},{"ID":"20240614123308-hb4jvhy","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-hb4jvhy"}},{"ID":"20240614123707-iarlr5i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123707-iarlr5i","updated":"20240614123711"},"Children":[{"Type":"NodeText","Data":"郁金《本经逢原》"}]},{"ID":"20240614123707-u8dfdu3","Type":"NodeParagraph","Properties":{"id":"20240614123707-u8dfdu3","updated":"20240614123707"},"Children":[{"Type":"NodeText","Data":"辛苦平，无毒。《本草》以为性寒，误矣。安有辛香而寒之理，蜀产者体圆尾锐，如蝉腹状，发苗处有小孔，皮黄而带黑，通身粗皱如梧桐子纹，每枚约重半钱，折开质坚色黄中带紫黑，嗅之微香不烈者真。若大小不等、色黄、皮起细横纹、有须如线，折之中空、质柔、内外皆黄、其气烈者，即片子姜黄也。体圆首尾相似，通身横纹，发苗处无小孔，折开气烈触鼻者，染色姜黄中之小者也。莪术则大块、色青黑，最大者为广术，与此不类。"}]},{"ID":"20240614123707-syzd6ao","Type":"NodeParagraph","Properties":{"id":"20240614123707-syzd6ao","updated":"20240614123707"},"Children":[{"Type":"NodeText","Data":"苏恭不能分别，乃为一物，谬矣。"}]},{"ID":"20240614123707-i3ni1lr","Type":"NodeParagraph","Properties":{"id":"20240614123707-i3ni1lr","updated":"20240614123707"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"郁金辛香不烈，先升后降，入心及包络。治吐血、衄血、唾血血腥，破恶血。血淋，尿血，妇人经脉逆行，产后败血冲心，及宿血心痛，并宜郁金末加姜汁、童便同服，其血自清。痰中带血者加竹沥。又鼻血上行者加入四物汤。一妇患失心风癫十年，用郁金四两，佐明矾一两为丸，朱砂为衣，才服五十丸，心间如有物脱去，再服而苏。以郁金入心去恶血，明矾化顽痰，朱砂安神故也。又能化症瘕为水，岭南蛊毒为害，初觉胸腹痛，即用升麻或胆矾吐之。若膈下急痛，以米汤调郁金末三钱服之，即泻恶物。或合升麻、郁金服之，不吐则下，此李巽岩为雷州司理，鞫狱得此方活人甚多。按∶以上诸治，其功皆在破血生新。"}]},{"ID":"20240614123707-8auon85","Type":"NodeParagraph","Properties":{"id":"20240614123707-8auon85","updated":"20240614123707"},"Children":[{"Type":"NodeText","Data":"今世误以为诸血圣药，病者不惜重费，医者藉为射利，咸以姜黄代充，为害非浅。凡属阴虚失血，及阴火迫血上逆，咸为切禁。"}]},{"ID":"20240614123308-cnrrqaw","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-cnrrqaw"}},{"ID":"20240614123655-cn8iefo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123655-cn8iefo","updated":"20240614123700"},"Children":[{"Type":"NodeText","Data":"郁金《本草备要》"}]},{"ID":"20240614123655-5rj2daq","Type":"NodeParagraph","Properties":{"id":"20240614123655-5rj2daq","updated":"20240614123655"},"Children":[{"Type":"NodeText","Data":"宣，行气解郁，泻，泄血破瘀"}]},{"ID":"20240614123655-88sr37i","Type":"NodeParagraph","Properties":{"id":"20240614123655-88sr37i","updated":"20240614123655"},"Children":[{"Type":"NodeText","Data":"辛苦气寒。纯阳之品，其性轻扬上行，入心及包络，兼入肺经。凉心热，散肝郁，下气破血（行滞气，亦不损正气。破瘀血，亦能生新血）。"}]},{"ID":"20240614123655-7i0t9er","Type":"NodeParagraph","Properties":{"id":"20240614123655-7i0t9er","updated":"20240614123655"},"Children":[{"Type":"NodeText","Data":"治吐衄尿血，妇人经脉逆行（经不下行，上为吐衄诸症。用郁金末，加韭汁、姜汁、童便服，其血自清。痰中带血者，加竹沥），血气诸痛，产后败血攻心，癫狂失心（癫多喜笑，尚知畏惧，证属不足；狂多忿怒，人莫能制，证属有余。此病多因惊忧、瘀血塞于心窍所致。郁金七两，白矾三两，米糊丸服，名白金丸。郁金入心散恶血，明矾化顽痰故也），痘毒入心（郁金一两，甘草二钱半，煮干焙研末，冰片五分，每用一钱，加猪血五、七滴，新汲水下。治斑痘始有白泡，忽搐入腹，紫黑无脓），下蛊毒（同升麻服，不吐则下）。"}]},{"ID":"20240614123655-gdhs0g8","Type":"NodeParagraph","Properties":{"id":"20240614123655-gdhs0g8","updated":"20240614123655"},"Children":[{"Type":"NodeText","Data":"出川广，体锐圆如蝉肚，外黄内赤，色鲜微香，味苦带甘者真（市人多以姜黄伪之）。"}]},{"ID":"20240614123308-6vlofa7","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-6vlofa7"}},{"ID":"20240614123634-mrkxfw2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123634-mrkxfw2","updated":"20240614123638"},"Children":[{"Type":"NodeText","Data":"郁金《中药炮制》"}]},{"ID":"20240614123634-if6e29z","Type":"NodeParagraph","Properties":{"id":"20240614123634-if6e29z","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『来源』本品为姜科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"郁金"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"温郁金"},{"Type":"NodeText","Data":"的干燥块根。"}]},{"ID":"20240614123634-bpulxfv","Type":"NodeParagraph","Properties":{"id":"20240614123634-bpulxfv","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『常用名』川玉金、广玉金、黄玉金。"}]},{"ID":"20240614123634-3h2per7","Type":"NodeParagraph","Properties":{"id":"20240614123634-3h2per7","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『产地』四川、广东等地。"}]},{"ID":"20240614123634-blaqj84","Type":"NodeParagraph","Properties":{"id":"20240614123634-blaqj84","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『采收季节』夏秋季采挖。"}]},{"ID":"20240614123634-srosdlo","Type":"NodeParagraph","Properties":{"id":"20240614123634-srosdlo","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『炮制方法』去杂质，洗净灰尘，放缸内，用米汤浸泡1～3天，取出洗净，再放锅内，加米汤，高于药面5分，同煮，至半干，每斤药加明矾粉3克拌入药内，经常翻动，以无白心为度，取出晒至半干，投入缸内润透，切片1厘厚，晾干。若取其入肝，则用醋煮法，每斤药用醋一两，明矾粉3克，再加米汤高于药面1寸拌匀，用大火煮至水干，取出凉至七成干，切片晾干。也可用蒸法和温水浸法等。"}]},{"ID":"20240614123634-ecwgfkx","Type":"NodeParagraph","Properties":{"id":"20240614123634-ecwgfkx","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『用量』3～9克。"}]},{"ID":"20240614123634-mrmwetw","Type":"NodeParagraph","Properties":{"id":"20240614123634-mrmwetw","updated":"20240614123634"},"Children":[{"Type":"NodeText","Data":"『贮存』装箱内加盖，防潮。"}]},{"ID":"20240614123308-akiu5qw","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-akiu5qw"}},{"ID":"20240614123618-9exzmlh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123618-9exzmlh","updated":"20240614123622"},"Children":[{"Type":"NodeText","Data":"郁金《本草简要方》"}]},{"ID":"20240614123618-xf01lq8","Type":"NodeParagraph","Properties":{"id":"20240614123618-xf01lq8","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"主治。下气破血。散肝。定痛。妇人血气诸痛。经脉逆行。产后败血攻心作痛。"}]},{"ID":"20240614123618-eje8hx5","Type":"NodeParagraph","Properties":{"id":"20240614123618-eje8hx5","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"郁金丸。郁金朱砂白矾研末。水泛丸梧子大。每服三四十丸。治风痰或至癫狂。"}]},{"ID":"20240614123618-1rx5ts0","Type":"NodeParagraph","Properties":{"id":"20240614123618-1rx5ts0","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"又方。郁金木香（勿见火）明雄黄（为衣）各三钱。五灵脂（醋炒）一两。玄胡索八钱。"}]},{"ID":"20240614123618-xokgkt7","Type":"NodeParagraph","Properties":{"id":"20240614123618-xokgkt7","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"砂仁（炒）生明矾各五钱。研末。神曲糊丸萝卜子大。每服三四十丸。唾津咽下。少用熟汤。治痧证腹痛。并治九种心痛。"}]},{"ID":"20240614123618-5czwak5","Type":"NodeParagraph","Properties":{"id":"20240614123618-5czwak5","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"郁金散。郁金滑石川芎各等分研末。每服二三钱。空腹齑汁调下。若有宿痰者瓜蒂散吐之。治头痛晕眩。"}]},{"ID":"20240614123618-20mnak9","Type":"NodeParagraph","Properties":{"id":"20240614123618-20mnak9","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"郁金黄连丸郁金黄连各一两。琥珀（研）大黄（酒浸）黄芩各二两。白茯苓滑石各四两。"}]},{"ID":"20240614123618-13nskjo","Type":"NodeParagraph","Properties":{"id":"20240614123618-13nskjo","updated":"20240614123618"},"Children":[{"Type":"NodeText","Data":"黑牵牛（炒取头末）三两。研末水泛丸梧子大。每服五十丸。空心下。治水火不济脬囊积热癃闭遗精。五淋白浊。"}]},{"ID":"20240614123308-6jonrq9","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-6jonrq9"}},{"ID":"20240614123557-hmu8moz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123557-hmu8moz","updated":"20240614123601"},"Children":[{"Type":"NodeText","Data":"郁金《汤液本草》"}]},{"ID":"20240614123557-8pwjhpj","Type":"NodeParagraph","Properties":{"id":"20240614123557-8pwjhpj","updated":"20240614123557"},"Children":[{"Type":"NodeText","Data":"味辛苦，纯阴。"}]},{"ID":"20240614123557-ok1k6i0","Type":"NodeParagraph","Properties":{"id":"20240614123557-ok1k6i0","updated":"20240614123557"},"Children":[{"Type":"NodeText","Data":"《珍》云∶凉心。"}]},{"ID":"20240614123557-a0em3t9","Type":"NodeParagraph","Properties":{"id":"20240614123557-a0em3t9","updated":"20240614123557"},"Children":[{"Type":"NodeText","Data":"《局方本草》∶郁金，味辛、苦，寒，无毒。主血积，下气，生肌止血，破恶血，血淋，尿血，金疮。"}]},{"ID":"20240614123557-jjdpv7y","Type":"NodeParagraph","Properties":{"id":"20240614123557-jjdpv7y","updated":"20240614123557"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶单用亦可。治妇人宿血结聚，温醋磨服。"}]},{"ID":"20240614123557-2qmm7pa","Type":"NodeParagraph","Properties":{"id":"20240614123557-2qmm7pa","updated":"20240614123557"},"Children":[{"Type":"NodeText","Data":"《经验方》云∶尿血不定，葱白相和，煎服，效。"}]},{"ID":"20240614123557-xxse43x","Type":"NodeParagraph","Properties":{"id":"20240614123557-xxse43x","updated":"20240614123557"},"Children":[{"Type":"NodeText","Data":"《本草》云∶生蜀者，佳。胡人谓之马 ，亦啖马。药用治胀痛，破血而补。"}]},{"ID":"20240614123308-4lgp2q9","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-4lgp2q9"}},{"ID":"20240614123546-c60v7ly","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123546-c60v7ly","updated":"20240614123550"},"Children":[{"Type":"NodeText","Data":"郁金《得配本草》"}]},{"ID":"20240614123546-0o0wy5b","Type":"NodeParagraph","Properties":{"id":"20240614123546-0o0wy5b","updated":"20240614123546"},"Children":[{"Type":"NodeText","Data":"辛、苦、寒。入手少阴、厥阴经。凉心散郁，破血下气。治血气心腹诸痛，妇人经脉逆行，吐血衄血，产后血败冲心，失心颠狂，痰迷心窍，痘毒入心，挑生蛊毒。得甘草、猪心血、冰片，治痘毒入心。得明矾，治痰痴。配葱白，治尿血。配升麻，治挑生蛊毒。（岭南有挑生之害于饮食中者，鱼肉能反生于人腹中，须此解之。）佐藜芦，决风痰壅滞。佐槐花，解热毒。调韭汁、姜汁、童便，治逆经。冲淡竹沥，降痰火。（气降火亦降。）捣末用，或磨汁用。阴虚火炎，气虚胀滞，吐血不关气郁者，禁用。"}]},{"ID":"20240614123308-y4w7dkl","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-y4w7dkl"}},{"ID":"20240614123537-7zv30ep","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123537-7zv30ep","updated":"20240614123542"},"Children":[{"Type":"NodeText","Data":"郁金《本草撮要》"}]},{"ID":"20240614123537-vl9lpof","Type":"NodeParagraph","Properties":{"id":"20240614123537-vl9lpof","updated":"20240614123537"},"Children":[{"Type":"NodeText","Data":"味辛．入手少阴厥阴经．功专去恶血．破结聚．得明矾治失心癫狂．得甘草、片脑治痘毒入心经不下行．上为吐衄．及下为尿血．用郁金末、韭汁、姜汁、童便服．痰中带血加入竹沥．"}]},{"ID":"20240614123308-5831n2o","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-5831n2o"}},{"ID":"20240614123520-oyk8yae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123520-oyk8yae","updated":"20240614123525"},"Children":[{"Type":"NodeText","Data":"郁金《本草求真》"}]},{"ID":"20240614123520-7uglcej","Type":"NodeParagraph","Properties":{"id":"20240614123520-7uglcej","updated":"20240614123520"},"Children":[{"Type":"NodeText","Data":"（芳草）入心散瘀通滞"}]},{"ID":"20240614123520-4glgell","Type":"NodeParagraph","Properties":{"id":"20240614123520-4glgell","updated":"20240614123520"},"Children":[{"Type":"NodeText","Data":"郁金（专入心）。辛苦而平。诸书论断不一。有言此属纯阴。其论所治。皆属破气之说。有言性温不寒。其论所治。则有疗寒除冷之谓。究之体轻气窜。其气先上行而微下达。凡有宿血凝积。及有恶血不堪之物。先于上处而行其气。若使其邪其气其痰其血在于膈上而难消者。须审宜温宜凉。同于他味。兼为调治之。（震亨曰。郁金属火与土。其性轻扬上行。治吐血衄血唾血血腥。及经脉逆行。并宜郁金末加韭汁姜汁童尿同服。其血自消。痰中带血者。加竹沥。又鼻血上行者。郁金韭汁加四物服之。）如败血冲心。加以姜汁童便。去心疯癫。明矾为丸。朱砂为衣。与受蛊毒。加以升麻之类。（经验方治失心癫狂。用真郁金七两。明矾三两。为末。薄糊丸。白汤下。又妇人癫狂十年。至人授此。初服心胸间有物脱去。神气洒然。再服而苏。此惊忧。痰血络聚心窍所致。郁金入心去恶血。明矾化顽痰故也。又范石湖文集云。岭南有挑生之害。于饮食中行厌胜法。鱼肉能反生于人腹中。而人以死。则阴役其家。初得觉胸腹痛。次日刺人。十日则生在腹中也。凡胸膈痛。即用升麻或胆矾吐之。若膈下痛。即以米汤调郁金末二钱服。即泻出恶物。或合升麻郁金服之。不吐则下。）若使恶血恶痰恶瘀恶淋恶痔。在于下部而难消者。俟其辛气既散。苦气下行。即为疏泄。而无郁滞难留之弊矣！此药本属入心散瘀。（庞安常伤寒论方云。斑痘始有白泡。忽搐入腹。紫黑无脓。用郁金一两。甘草二钱半。水半杯。煮干。去甘草。切片。焙。研末。入冰片五分。每用一钱。以生猪血五七滴。新汲水下。）因瘀去而金得泄。故命其名曰郁金。书云此药纯阴而寒者。因性主下而言也。有云是药性温而言者。因气味辛香主上而言也。各有论说不同。以致理难画一耳。因为辨论正之。出川广。圆如蝉肚。外黄内赤。色鲜微香带甘者真。市人多以姜黄伪充。"}]},{"ID":"20240614123308-v4lg7ox","Type":"NodeThematicBreak","Properties":{"id":"20240614123308-v4lg7ox"}},{"ID":"20240614123315-q810l0q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123315-q810l0q","updated":"20240614123351"},"Children":[{"Type":"NodeText","Data":"郁金《本草乘雅半偈》"}]},{"ID":"20240614123315-7kvs0cf","Type":"NodeParagraph","Properties":{"id":"20240614123315-7kvs0cf","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"（唐本草）"}]},{"ID":"20240614123315-2ybmdzx","Type":"NodeParagraph","Properties":{"id":"20240614123315-2ybmdzx","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"【气味】辛苦寒，无毒。"}]},{"ID":"20240614123315-gl4w1xe","Type":"NodeParagraph","Properties":{"id":"20240614123315-gl4w1xe","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"【主治】主血积，下气，生肌，止血，破恶血，血淋，尿血，金疮。"}]},{"ID":"20240614123315-ibtp8zh","Type":"NodeParagraph","Properties":{"id":"20240614123315-ibtp8zh","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"【核】曰∶原从大秦国，及西戎来，今蜀地、广南、江西州郡亦有，不及蜀中者佳。四月生苗，茎叶都似姜黄，末秋复从茎心抽茎，黄花红质，不结实，根如指顶，长寸许，体圆无枝，芳香色黄，横纹宛如蝉腹也。古者合玄 以酿酒，名之曰鬯。周礼郁人掌 器，凡祭祀宾客之 事，和郁鬯以实彝而陈之。浸水染衣，色极鲜丽，经久不变，炙之微有郁气也。"}]},{"ID":"20240614123315-o3aw7ct","Type":"NodeParagraph","Properties":{"id":"20240614123315-o3aw7ct","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"先人云∶金本克木，反为木用，故名郁金。其轻达有金象，其高远似春暄。"}]},{"ID":"20240614123315-17s7m6b","Type":"NodeParagraph","Properties":{"id":"20240614123315-17s7m6b","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"【 】曰∶以郁合 ，酿之成鬯，则酒色香而黄，在器流动，诗所谓黄流在中者是矣。"}]},{"ID":"20240614123315-uy6f1sj","Type":"NodeParagraph","Properties":{"id":"20240614123315-uy6f1sj","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"周人尚臭灌用鬯，阴达于九渊，阳彻于九天，故曰条畅于上下，致气于高远，所以降神也。"}]},{"ID":"20240614123315-kwva017","Type":"NodeParagraph","Properties":{"id":"20240614123315-kwva017","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"经云∶脏真高于肺，以行营卫阴阳也。设遏逆于中，则萎畅于四肢，为结、为积、为宿、为淋矣。与香薷合其德，略有异同。香薷偏于卫与阳，郁金偏于营与阴。将形脏，弥玄府，敷幽门则一耳。"}]},{"ID":"20240614123315-c3fp1yx","Type":"NodeParagraph","Properties":{"id":"20240614123315-c3fp1yx","updated":"20240614123315"},"Children":[{"Type":"NodeText","Data":"（ 者百谷之本；郁者百草之华，合以成鬯。上畅于天，下畅于地，无所不畅。故天子以鬯为贽。）"}]},{"ID":"20240614123240-1opbdwa","Type":"NodeThematicBreak","Properties":{"id":"20240614123240-1opbdwa"}},{"ID":"20240614123301-k08tkfu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123301-k08tkfu","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"《中国药典》：郁金"}]},{"ID":"20240614123301-3d14oxn","Type":"NodeParagraph","Properties":{"id":"20240614123301-3d14oxn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614123301-uoz4aho","Type":"NodeParagraph","Properties":{"id":"20240614123301-uoz4aho","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" Yù Jīn"}]},{"ID":"20240614123301-eswdl4b","Type":"NodeParagraph","Properties":{"id":"20240614123301-eswdl4b","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614123301-f77srbe","Type":"NodeParagraph","Properties":{"id":"20240614123301-f77srbe","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 玉金、白丝郁金"}]},{"ID":"20240614123301-7wpvenq","Type":"NodeParagraph","Properties":{"id":"20240614123301-7wpvenq","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614123301-4u72rdg","Type":"NodeParagraph","Properties":{"id":"20240614123301-4u72rdg","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" RADIX CURCUMAE"}]},{"ID":"20240614123301-dyuifps","Type":"NodeParagraph","Properties":{"id":"20240614123301-dyuifps","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614123301-e2thspq","Type":"NodeParagraph","Properties":{"id":"20240614123301-e2thspq","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 本品为姜科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"温郁金"},{"Type":"NodeText","Data":"Curcuma wenyujin Y. H. Chen et C. Ling、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姜黄"},{"Type":"NodeText","Data":"Curcuma longa L.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"广西莪术"},{"Type":"NodeText","Data":"Curcuma kwangsiensis S. G. Lee et C. F. Liang或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蓬莪术"},{"Type":"NodeText","Data":"Curcuma phaeocaulis Val.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。前两者分别习称“温郁金”和“黄丝郁金”，其余按性状不同习称“桂郁金”或“绿丝郁金”。冬季茎叶枯萎后采挖，除去泥沙及细根，蒸或煮至透心，干燥。"}]},{"ID":"20240614123301-n8azldn","Type":"NodeParagraph","Properties":{"id":"20240614123301-n8azldn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614123301-kxldl4v","Type":"NodeParagraph","Properties":{"id":"20240614123301-kxldl4v","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 温郁金：呈长圆形或卵圆形，稍扁，有的微弯曲，两端渐尖。长3.5～7cm,直径1.2～2.5cm。表面灰褐色或灰棕色，具不规则的纵皱纹，纵纹隆起处色较浅。质坚实，断面灰棕色，角质样；内皮层环明显。气微香，味微苦。"}]},{"ID":"20240614123301-ugeol6n","Type":"NodeParagraph","Properties":{"id":"20240614123301-ugeol6n","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"黄丝郁金：呈纺锤形，有的一端细长，长2.5～4.5cm，直径1～1.5cm。表面棕灰色或灰黄色，具细皱纹，断面橙黄色，外周棕黄色至棕红色。气芳香，味辛辣。"}]},{"ID":"20240614123301-gn6p8n1","Type":"NodeParagraph","Properties":{"id":"20240614123301-gn6p8n1","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"桂郁金：呈长圆锥形或长圆形，长2～6.5cm，直径1～1.8cm。表面具疏浅纵纹或较粗糙网状皱纹。气微，味微辛苦。"}]},{"ID":"20240614123301-q5sm6eb","Type":"NodeParagraph","Properties":{"id":"20240614123301-q5sm6eb","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"绿丝郁金：呈长椭圆形，较粗壮，长1.5～3.5cm，直径1～1.2cm。气微，味淡。"}]},{"ID":"20240614123301-ytdpk6x","Type":"NodeParagraph","Properties":{"id":"20240614123301-ytdpk6x","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614123301-0spke0m","Type":"NodeParagraph","Properties":{"id":"20240614123301-0spke0m","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240614123301-ko2718m","Type":"NodeParagraph","Properties":{"id":"20240614123301-ko2718m","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614123301-h6ubmo0","Type":"NodeParagraph","Properties":{"id":"20240614123301-h6ubmo0","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 洗净，润透，切薄片，干燥；或洗净，干燥，打碎。"}]},{"ID":"20240614123301-dyctbh7","Type":"NodeParagraph","Properties":{"id":"20240614123301-dyctbh7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614123301-c4l6nj2","Type":"NodeParagraph","Properties":{"id":"20240614123301-c4l6nj2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 本品横切面：温郁金 表皮细胞有时残存，外壁稍厚。根被狭窄，为4～8 列细胞，壁薄，略呈波状，排列整齐；皮层宽约为根直径的 1/2，油细胞难察见，内皮层明显。中柱韧皮部束与木质部束各40～55个，间隔排列，木质部束导管2～4个，并有微木化的木纤维，导管多角形，壁薄，直径20～90μm。薄壁细胞中的淀粉粒均糊化。"}]},{"ID":"20240614123301-ftwlsio","Type":"NodeParagraph","Properties":{"id":"20240614123301-ftwlsio","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"黄丝郁金 根被最内层细胞壁增厚，有时木质部导管与纤维连接成环。油细胞众多。薄壁组织中随处散有色素细胞。"}]},{"ID":"20240614123301-s8d3190","Type":"NodeParagraph","Properties":{"id":"20240614123301-s8d3190","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"桂郁金 根被细胞偶有增厚，根被内方有1～2列厚壁细胞，成环，层纹明显。导管类圆形，直径可达 160μm。"}]},{"ID":"20240614123301-4mvx5nl","Type":"NodeParagraph","Properties":{"id":"20240614123301-4mvx5nl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"绿丝郁金 根被细胞无增厚 。中柱外侧的皮层处常有色素细胞，韧皮部皱缩,木质部束较多，64～72个，导管扁平。"}]},{"ID":"20240614123301-a965e2f","Type":"NodeParagraph","Properties":{"id":"20240614123301-a965e2f","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614123301-eenz6p2","Type":"NodeParagraph","Properties":{"id":"20240614123301-eenz6p2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 归肝、心、肺经。"}]},{"ID":"20240614123301-hqcj0ek","Type":"NodeParagraph","Properties":{"id":"20240614123301-hqcj0ek","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614123301-mvcf0wx","Type":"NodeParagraph","Properties":{"id":"20240614123301-mvcf0wx","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 辛、苦，寒。"}]},{"ID":"20240614123301-bd4qsqc","Type":"NodeParagraph","Properties":{"id":"20240614123301-bd4qsqc","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614123301-itxo8mr","Type":"NodeParagraph","Properties":{"id":"20240614123301-itxo8mr","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 行气化瘀，清心解郁，利胆退黄。用于经闭痛经,胸腹胀痛、刺痛，热病神昏，癫痫发狂，黄疸尿赤。"}]},{"ID":"20240614123301-jepamil","Type":"NodeParagraph","Properties":{"id":"20240614123301-jepamil","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614123301-cakf26w","Type":"NodeParagraph","Properties":{"id":"20240614123301-cakf26w","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240614123301-eezzhu3","Type":"NodeParagraph","Properties":{"id":"20240614123301-eezzhu3","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614123301-87qa735","Type":"NodeParagraph","Properties":{"id":"20240614123301-87qa735","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240614123301-yzdgq8l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123301-yzdgq8l","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：郁金"}]},{"ID":"20240614123301-z3e40n0","Type":"NodeParagraph","Properties":{"id":"20240614123301-z3e40n0","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614123301-dfcdaop","Type":"NodeParagraph","Properties":{"id":"20240614123301-dfcdaop","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" Yù Jīn"}]},{"ID":"20240614123301-pnpzsro","Type":"NodeParagraph","Properties":{"id":"20240614123301-pnpzsro","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614123301-4nrpuwn","Type":"NodeParagraph","Properties":{"id":"20240614123301-4nrpuwn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 马蒁（《唐本草》），黄郁（《石药尔雅》）。"}]},{"ID":"20240614123301-glmmg2j","Type":"NodeParagraph","Properties":{"id":"20240614123301-glmmg2j","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614123301-u6x64ph","Type":"NodeParagraph","Properties":{"id":"20240614123301-u6x64ph","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 《药性论》"}]},{"ID":"20240614123301-hzhndj7","Type":"NodeParagraph","Properties":{"id":"20240614123301-hzhndj7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614123301-ofpq9i3","Type":"NodeParagraph","Properties":{"id":"20240614123301-ofpq9i3","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 为姜科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姜黄、郁金"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"莪术"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。冬、春采挖，摘取块根，除去须根，洗净泥土，入沸水中煮或蒸至透心，取出，晒干。"}]},{"ID":"20240614123301-rq1ruol","Type":"NodeParagraph","Properties":{"id":"20240614123301-rq1ruol","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614123301-9hvn766","Type":"NodeParagraph","Properties":{"id":"20240614123301-9hvn766","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" ①姜黄，详\"姜黄\"条。"}]},{"ID":"20240614123301-9rxr0ef","Type":"NodeParagraph","Properties":{"id":"20240614123301-9rxr0ef","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②郁金，又名：毛姜黄（《广州植物志》）。"}]},{"ID":"20240614123301-wqxfwgj","Type":"NodeParagraph","Properties":{"id":"20240614123301-wqxfwgj","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"多年生宿根草本。根粗壮，末端膨大成长卵形块根。块茎卵圆状，侧生，根茎圆柱状，断面黄色。叶基生：叶柄长约5厘米，基部的叶柄短，或近于无柄，具叶耳；叶片长圆形，长15～37厘米，宽7～10厘米，先端尾尖，基部圆形或三角形。穗状花序，长约13厘米；总花梗长7～15厘米；具鞘状叶，基部苞片阔卵圆形，小花数朵，生于苞片内，顶端苞片较狭，腋内无花；花萼白色筒状，不规则3齿裂；花冠管呈漏斗状，裂片3，粉白色，上面1枚较大，两侧裂片长圆形；侧生退化雄蕊长圆形，药隔距形，花丝扁阔；子房被伏毛，花柱丝状，光滑或被疏毛，基部有2棒状附属物，柱头略呈2唇形，具缘毛。花期4～6月，极少秋季开花。"}]},{"ID":"20240614123301-6utr63c","Type":"NodeParagraph","Properties":{"id":"20240614123301-6utr63c","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"分布江苏、浙江、福建、广东、广西、江西、四川、云南等地。"}]},{"ID":"20240614123301-38prk1w","Type":"NodeParagraph","Properties":{"id":"20240614123301-38prk1w","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"本植物的根茎（姜黄或蓬莪术）亦供药用，另详专条。"}]},{"ID":"20240614123301-1rm59ft","Type":"NodeParagraph","Properties":{"id":"20240614123301-1rm59ft","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③莪术，详\"蓬莪术\"条。"}]},{"ID":"20240614123301-sstc828","Type":"NodeParagraph","Properties":{"id":"20240614123301-sstc828","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614123301-prp71r4","Type":"NodeParagraph","Properties":{"id":"20240614123301-prp71r4","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" ①黄郁金"}]},{"ID":"20240614123301-1tx6jz1","Type":"NodeParagraph","Properties":{"id":"20240614123301-1tx6jz1","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"又名：黄丝郁金、广玉金。为植物姜黄的干燥块根，呈卵圆形或长卵圆形，两端稍尖，中部微满，长2～4厘米，中部直径1～2厘米。表面灰黄色或淡棕色，有灰白色细皱纹及凹下的小点，一端显折断的痕迹，呈鲜黄色，另一端稍尖。质坚实，横断面平坦光亮，呈角质状，杏黄色或橙黄色，中部有一颜色较浅的圆心。微有姜香气，味辛而苦。以个大、肥满、外皮皱纹细、断面橙黄色者为佳。"}]},{"ID":"20240614123301-zyoc6xx","Type":"NodeParagraph","Properties":{"id":"20240614123301-zyoc6xx","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"主产四川。"}]},{"ID":"20240614123301-zg7pn2y","Type":"NodeParagraph","Properties":{"id":"20240614123301-zg7pn2y","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②黑郁金"}]},{"ID":"20240614123301-r9aprwn","Type":"NodeParagraph","Properties":{"id":"20240614123301-r9aprwn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"又名：温郁金、川玉金。为植物郁金的干燥块根。长纺锤形，稍扁，多弯曲，两端钝尖，有折断痕而呈灰黑色，长3～6厘米，中部直径1～1.5厘米。表面灰褐色，外皮皱缩或有细皱纹。横断面暗灰色发亮，中部有l条颜色较浅的环纹，中心扁圆形。气无，味淡而辛凉。以个大、外皮少皱缩、断面灰黑色者为佳。"}]},{"ID":"20240614123301-c1jtlfa","Type":"NodeParagraph","Properties":{"id":"20240614123301-c1jtlfa","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"主产浙江。"}]},{"ID":"20240614123301-l5ynzeh","Type":"NodeParagraph","Properties":{"id":"20240614123301-l5ynzeh","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③白丝郁金"}]},{"ID":"20240614123301-9f6xzwl","Type":"NodeParagraph","Properties":{"id":"20240614123301-9f6xzwl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"亦为植物郁金的干燥块根。外形较黄郁金瘦长。断面内心呈白色（姜黄色素含量较少），内圈与外层之间有1条黄白色的环纹，质地模糊不透明。味微辛，香气亦较差。以个大、皮细、断面结实者为佳。"}]},{"ID":"20240614123301-h40e5ay","Type":"NodeParagraph","Properties":{"id":"20240614123301-h40e5ay","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"主产四川。"}]},{"ID":"20240614123301-gtt6wqz","Type":"NodeParagraph","Properties":{"id":"20240614123301-gtt6wqz","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"④绿丝郁金"}]},{"ID":"20240614123301-lox584b","Type":"NodeParagraph","Properties":{"id":"20240614123301-lox584b","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"为植物莪术的干燥块根。形状质地同黄郁金，但表皮较粗，断面色暗淡，深浅不一，少透明。味辛而重，香气不显。"}]},{"ID":"20240614123301-du3chww","Type":"NodeParagraph","Properties":{"id":"20240614123301-du3chww","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"产四川。"}]},{"ID":"20240614123301-s7tjgf4","Type":"NodeParagraph","Properties":{"id":"20240614123301-s7tjgf4","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614123301-8wlwnnk","Type":"NodeParagraph","Properties":{"id":"20240614123301-8wlwnnk","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240614123301-ge4y8eu","Type":"NodeParagraph","Properties":{"id":"20240614123301-ge4y8eu","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614123301-l82yijr","Type":"NodeParagraph","Properties":{"id":"20240614123301-l82yijr","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 郁金块根含挥发油6.1％，其中莰烯0.8％，樟脑2.5％，倍半萜烯65.5％，主为姜黄烯，倍半萜烯醇22％等。还含姜黄素0.3％、脱甲氧基姜黄素、双脱甲氧基姜黄素、姜黄酮和芳基姜黄酮。另含淀粉30～40％，脂肪油3％，橡胶，黄色染料，葛缕酮及水芹烯。其有效成分是对-甲苯基-甲基羟甲基姜黄素。"}]},{"ID":"20240614123301-vjkbis2","Type":"NodeParagraph","Properties":{"id":"20240614123301-vjkbis2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614123301-in6vtyt","Type":"NodeParagraph","Properties":{"id":"20240614123301-in6vtyt","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" ①对脂质代谢的影响"}]},{"ID":"20240614123301-loz18yv","Type":"NodeParagraph","Properties":{"id":"20240614123301-loz18yv","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"对胆甾醇（每天给予1克）引起动脉粥样硬化的家兔，每天口服郁金水煎剂10克左右，100天后血清胆甾醇不仅没有下降，反而比对照组高，磷脂升高较明显，β-脂蛋白、三酸甘油酯稍有上升，但与对照组无差异。郁金粉按134毫克/100克给予实验性动脉粥样硬化的大白鼠，血清胆甾醇及C／P值均有轻度上升，但能减轻家兔或大白鼠主动脉及冠状动脉内膜斑块的形成及脂质沉积。患有高胆甾醇血症的兔，口服同属植物Curcuma amada的乙醚提取物，在3周内使血胆甾醇由266毫克％下降到36毫克％，C／P比值也相应下降，主动脉重量亦明显减轻，动物体重增加。"}]},{"ID":"20240614123301-mlhqo0a","Type":"NodeParagraph","Properties":{"id":"20240614123301-mlhqo0a","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240614123301-ifm2jrb","Type":"NodeParagraph","Properties":{"id":"20240614123301-ifm2jrb","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"郁金水浸剂（1：3）在试管内对多种致病真菌有抑制作用。用郁金挥发油乳剂作人胆囊造影时，无收缩胆囊的作用。"}]},{"ID":"20240614123301-lwak760","Type":"NodeParagraph","Properties":{"id":"20240614123301-lwak760","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614123301-66axeox","Type":"NodeParagraph","Properties":{"id":"20240614123301-66axeox","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 用水浸泡，洗净，捞出晒晾，润进，切片，晒干。"}]},{"ID":"20240614123301-34s8o81","Type":"NodeParagraph","Properties":{"id":"20240614123301-34s8o81","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614123301-4zb3cw5","Type":"NodeParagraph","Properties":{"id":"20240614123301-4zb3cw5","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 入心、肺、肝经。"}]},{"ID":"20240614123301-wogr1nb","Type":"NodeParagraph","Properties":{"id":"20240614123301-wogr1nb","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入心及包络。\""}]},{"ID":"20240614123301-38tvfnh","Type":"NodeParagraph","Properties":{"id":"20240614123301-38tvfnh","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、肺二经。\""}]},{"ID":"20240614123301-9lridgt","Type":"NodeParagraph","Properties":{"id":"20240614123301-9lridgt","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入手少阴、足厥阴，兼通足阳明经。\""}]},{"ID":"20240614123301-zmetmwh","Type":"NodeParagraph","Properties":{"id":"20240614123301-zmetmwh","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614123301-usz6jv3","Type":"NodeParagraph","Properties":{"id":"20240614123301-usz6jv3","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 辛苦，凉。"}]},{"ID":"20240614123301-hxja7cn","Type":"NodeParagraph","Properties":{"id":"20240614123301-hxja7cn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"味辛苦，寒，无毒。\""}]},{"ID":"20240614123301-9ferc2z","Type":"NodeParagraph","Properties":{"id":"20240614123301-9ferc2z","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"辛苦，平，无毒。\""}]},{"ID":"20240614123301-rtowf7f","Type":"NodeParagraph","Properties":{"id":"20240614123301-rtowf7f","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614123301-wcip0mn","Type":"NodeParagraph","Properties":{"id":"20240614123301-wcip0mn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 阴虚失血及无气滞血瘀者忌服，孕妇慎服。"}]},{"ID":"20240614123301-amndjhl","Type":"NodeParagraph","Properties":{"id":"20240614123301-amndjhl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》\"凡病属真阴虚极，阴分火炎，薄血妄行，溢出上窍，而非气分拂逆，肝气不平，以致伤肝吐血者不宜用也。即用之亦无效。\""}]},{"ID":"20240614123301-4a3ys10","Type":"NodeParagraph","Properties":{"id":"20240614123301-4a3ys10","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"胀满，膈逆，疼痛，关乎胃虚血虚者，不宜用也。\""}]},{"ID":"20240614123301-gn19gr2","Type":"NodeParagraph","Properties":{"id":"20240614123301-gn19gr2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"气虚胀滞禁用。\""}]},{"ID":"20240614123301-frwrtpw","Type":"NodeParagraph","Properties":{"id":"20240614123301-frwrtpw","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614123301-z38z1n2","Type":"NodeParagraph","Properties":{"id":"20240614123301-z38z1n2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 行气解郁，凉血破瘀。治胸腹胁肋诸痛，失心癫狂，热病神昏，吐血，衄血，尿血，血淋，妇女倒经，黄疸。"}]},{"ID":"20240614123301-elpvgc2","Type":"NodeParagraph","Properties":{"id":"20240614123301-elpvgc2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"治女人宿血气心痛，冷气结聚，温醋摩服之。\""}]},{"ID":"20240614123301-3wphlly","Type":"NodeParagraph","Properties":{"id":"20240614123301-3wphlly","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"主血积，下气，生肌，止血，破恶血，血淋，尿血，金疮。\""}]},{"ID":"20240614123301-dxmuqvk","Type":"NodeParagraph","Properties":{"id":"20240614123301-dxmuqvk","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③《珍珠囊》：\"凉心。\""}]},{"ID":"20240614123301-uir24cj","Type":"NodeParagraph","Properties":{"id":"20240614123301-uir24cj","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"④李杲：\"治阳毒入胃，下血频痛。\""}]},{"ID":"20240614123301-4178ezs","Type":"NodeParagraph","Properties":{"id":"20240614123301-4178ezs","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑤《本草衍义补遗》：\"治郁遏不能散。\""}]},{"ID":"20240614123301-cqopk0i","Type":"NodeParagraph","Properties":{"id":"20240614123301-cqopk0i","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治血气心腹痛，产后败血冲心欲死，失心颠狂。\""}]},{"ID":"20240614123301-4dwiv8g","Type":"NodeParagraph","Properties":{"id":"20240614123301-4dwiv8g","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑦《本草通玄》：\"治痘毒入心。\""}]},{"ID":"20240614123301-p5i0cm9","Type":"NodeParagraph","Properties":{"id":"20240614123301-p5i0cm9","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑧《本草正》：\"止吐血，衄血；单用治妇人冷气血积，结聚气滞，心腹作痛。\""}]},{"ID":"20240614123301-87spral","Type":"NodeParagraph","Properties":{"id":"20240614123301-87spral","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑨《本草述》：\"治发热，郁，咳嗽，齿衄，咳嗽血，溲血，头痛眩晕，狂痫，滞下，淋，并眼目鼻舌咽喉等证。\""}]},{"ID":"20240614123301-0o53pwd","Type":"NodeParagraph","Properties":{"id":"20240614123301-0o53pwd","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑩《本草备要》：\"行气，解郁；泄血，破瘀。凉心热，散肝郁。治妇人经脉逆行，\""}]},{"ID":"20240614123301-x4bygkn","Type":"NodeParagraph","Properties":{"id":"20240614123301-x4bygkn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑾《本草从新》：\"能开肺金之郁。\""}]},{"ID":"20240614123301-bmzwjkv","Type":"NodeParagraph","Properties":{"id":"20240614123301-bmzwjkv","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑿《要药分剂》：\"凉血。\""}]},{"ID":"20240614123301-b23w4mm","Type":"NodeParagraph","Properties":{"id":"20240614123301-b23w4mm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614123301-n652zyy","Type":"NodeParagraph","Properties":{"id":"20240614123301-n652zyy","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；磨汁或入丸、散。"}]},{"ID":"20240614123301-pcbc026","Type":"NodeParagraph","Properties":{"id":"20240614123301-pcbc026","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614123301-lpftonw","Type":"NodeParagraph","Properties":{"id":"20240614123301-lpftonw","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" ①治心悬急懊痛：郁金半两，黄芩一两，赤芍药一两，枳壳一两（麸炒微黄，去瓤），生干地黄一两，大腹皮一两（锉）。上药，细锉和匀。每服一分，以水一中盏，入生姜半分，煎至六分，去滓，不计时候，稍熬服。（《圣惠方》郁金饮子）"}]},{"ID":"20240614123301-e22jgbw","Type":"NodeParagraph","Properties":{"id":"20240614123301-e22jgbw","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②治一切厥心（痛）、小肠膀胱痛不可忍者：附子（炮）、郁金、干姜。上各等分为细末，醋煮糊为丸，如梧桐子大，朱砂为衣。每服三十丸，男子温洒下，妇人醋汤下，食远服。（《奇效良方》辰砂一粒金丹）"}]},{"ID":"20240614123301-u0z4l3s","Type":"NodeParagraph","Properties":{"id":"20240614123301-u0z4l3s","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③治妇人胁肋胀满，因气逆者：郁金、木香、莪术、牡丹皮。白汤磨服。（《女科方要》）"}]},{"ID":"20240614123301-ofi9mha","Type":"NodeParagraph","Properties":{"id":"20240614123301-ofi9mha","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"④治产后心痛，血气上冲欲死：郁金烧存性为末二钱，米醋一呷，调灌。（《袖珍方》）"}]},{"ID":"20240614123301-5f95eam","Type":"NodeParagraph","Properties":{"id":"20240614123301-5f95eam","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑤治癫狂因忧郁而得，痰涎阻塞包络心窍者：白矾三两，郁金七两。米糊为丸，梧子大。每服五十丸，水送下。（《本事方》白金丸）"}]},{"ID":"20240614123301-kjywvra","Type":"NodeParagraph","Properties":{"id":"20240614123301-kjywvra","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑥治痫疾：川芎二两，防风、郁金、猪牙皂角、明矾各一两，蜈蚣二条（黄、赤脚各一）。上为末，蒸饼丸，如桐子大。空心茶清下十五丸。（《摄生众妙方》郁金丹）"}]},{"ID":"20240614123301-i8utdbk","Type":"NodeParagraph","Properties":{"id":"20240614123301-i8utdbk","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑦治风痰：郁金一分，藜芦十分。各为末，和令匀。每服一字，用温浆水一盏，先以少浆水调下，馀者水漱口都服，便以食压之。（《经验后方》）"}]},{"ID":"20240614123301-zc7c7vu","Type":"NodeParagraph","Properties":{"id":"20240614123301-zc7c7vu","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑧治衄血吐血：郁金为末，水服二钱，甚者再服。（《简易方论》）"}]},{"ID":"20240614123301-6tjtz0n","Type":"NodeParagraph","Properties":{"id":"20240614123301-6tjtz0n","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑨治呕血：用韭汁、姜汁、童便磨郁金，同饮之。（《丹溪心法》）"}]},{"ID":"20240614123301-nki6fdp","Type":"NodeParagraph","Properties":{"id":"20240614123301-nki6fdp","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑩治尿血不定：郁金一两，捣为末，葱白一握相和，以水一盏，煎至三合，去滓，温服，日须三服。（《经验方》）"}]},{"ID":"20240614123301-rlznkwb","Type":"NodeParagraph","Properties":{"id":"20240614123301-rlznkwb","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑾治血淋，心头烦，水道中涩痛，及治小肠积热，尿血出者：生干地黄、郁金、蒲黄。上等分，为细末。每于食前，煎车前子叶汤调下一钱，酒调下亦得。（《普济方》郁金散）"}]},{"ID":"20240614123301-rn8oxdm","Type":"NodeParagraph","Properties":{"id":"20240614123301-rn8oxdm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⑿治阳毒入胃下血，频疼痛不可忍：郁金五个大者，牛黄一皂荚子（别研细）。二味同为散。每服用醋浆水一盏，同煎三沸，温服。（孙用和）"}]},{"ID":"20240614123301-pm3q4zt","Type":"NodeParagraph","Properties":{"id":"20240614123301-pm3q4zt","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒀治谷疽，唇口先黄，腹胀气急：郁金一两，牛胆一枚（干者），麝香（研）半钱.上三味，捣研为细散。每服半钱匕，新汲水调下，不拘时。（《圣济总录》郁金散）"}]},{"ID":"20240614123301-psm5902","Type":"NodeParagraph","Properties":{"id":"20240614123301-psm5902","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒁治胆石及黄疸：郁金、熊胆、明矾、火硝。研细为丸或作散剂。每服一至三分。（《四川中药志》）"}]},{"ID":"20240614123301-0imrta0","Type":"NodeParagraph","Properties":{"id":"20240614123301-0imrta0","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒂治肠梗阻：郁金、桃仁、瓜蒌各三钱。水煎后加麻油五两，一次温服。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240614123301-yyxj2gs","Type":"NodeParagraph","Properties":{"id":"20240614123301-yyxj2gs","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒃治耳内极痛：郁金末，研细，每用一字，以净水调，倾入耳内，却急倾出。（《圣济总录》）"}]},{"ID":"20240614123301-smaposs","Type":"NodeParagraph","Properties":{"id":"20240614123301-smaposs","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒄治自汗不止：郁金末，卧时调涂于乳上。（《濒湖集简方》）"}]},{"ID":"20240614123301-v4uq6ql","Type":"NodeParagraph","Properties":{"id":"20240614123301-v4uq6ql","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒅治痔疮肿痛：郁金末，水调涂之。（《医方摘要》）"}]},{"ID":"20240614123301-evijfi1","Type":"NodeParagraph","Properties":{"id":"20240614123301-evijfi1","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒆颠狂症。用郁金七两、明矾三两，共研为末，加稀同做成丸子，如梧子大。每服五十丸，开水送下。"}]},{"ID":"20240614123301-psmbycz","Type":"NodeParagraph","Properties":{"id":"20240614123301-psmbycz","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"⒇痘毒攻心（痘疮忽由白色变成紫黑我，不出脓，日夜哭叫）。用郁金一枚、甘草二钱半，加水半碗煮干，去甘草，将郁金切片焙干，研为末，加脑子（炒）半钱。每服一钱，以生猪血五七滴和新汲水调下。二服后毒气从手足心发出，如痈状，病乃全愈。"}]},{"ID":"20240614123301-l63l6nr","Type":"NodeParagraph","Properties":{"id":"20240614123301-l63l6nr","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（21）心气痛。和郁金、附子、干姜，等分为末，加醋、糊做成丸子，如梧子大。朱砂为衣。每服三十丸。男用酒，女用醋送下。"}]},{"ID":"20240614123301-sf8h6se","Type":"NodeParagraph","Properties":{"id":"20240614123301-sf8h6se","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（22）产后心痛（血气上冲欲死）。用郁金（烧存性）研细，取二钱，以米醋调灌能，转危为安。"}]},{"ID":"20240614123301-23761wl","Type":"NodeParagraph","Properties":{"id":"20240614123301-23761wl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（23）鼻血、吐血。用郁金研细，水服二钱。不愈。再服一次。"}]},{"ID":"20240614123301-ngrpyh8","Type":"NodeParagraph","Properties":{"id":"20240614123301-ngrpyh8","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（24）阳毒下血（热气入骨，痛不可忍）。用郁金五个，牛黄一个、如皂荚子大，做成散剂，每服用醋浆水一碗煎三沸后，待温把药送下。"}]},{"ID":"20240614123301-t2p4pai","Type":"NodeParagraph","Properties":{"id":"20240614123301-t2p4pai","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（25）尿血。用郁金一两、葱白一握，加水一碗煎成三合，温服。一天服三次。"}]},{"ID":"20240614123301-vu9vckm","Type":"NodeParagraph","Properties":{"id":"20240614123301-vu9vckm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（26）风痰壅塞。用郁金一分、藜芦十分，共研为末。每取少许，温浆水调下。同时，以浆水一碗，漱口吐涎。可以吃一点东西压一下药味。"}]},{"ID":"20240614123301-zajqnb2","Type":"NodeParagraph","Properties":{"id":"20240614123301-zajqnb2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（27）痔疮肿痛。用郁金研细，加水调匀搽患处。"}]},{"ID":"20240614123301-izxnpzz","Type":"NodeParagraph","Properties":{"id":"20240614123301-izxnpzz","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614123301-rntu3wc","Type":"NodeParagraph","Properties":{"id":"20240614123301-rntu3wc","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 治疗传染性肝炎：取郁金粉每次5克，日服3次。共治33例（急性22例，慢性11例），结果自觉症状消失者21例，减轻者11例，1例无改变，疗程平均为31天；有明显体征的26例中，14例完全消失，9例减轻，3例无改变。所有病例在治疗前转氨酶都有明显变化，治疗后完全达到正常者18例，明显降低或接近正常者9例，其余无改变。24例患者经血清蛋白检查，治疗后都有不同程度的白蛋白升高现象；7例做了马尿酸排出试验，治疗2～3星期后，有6例排出量明显增加。据本组病例观察，郁金对止痛、退黄、使肝脾缩小等方面都有较好的效果。"}]},{"ID":"20240614123301-w7limax","Type":"NodeParagraph","Properties":{"id":"20240614123301-w7limax","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614123301-0an9hzx","Type":"NodeParagraph","Properties":{"id":"20240614123301-0an9hzx","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"郁金本入血分之气药，其治已上诸血证者，正谓血之上行，皆属于内热火炎，此药能降气，气降即是火降，而共性又入血分，故能降下火气，则血不妄行。\""}]},{"ID":"20240614123301-hgilbk8","Type":"NodeParagraph","Properties":{"id":"20240614123301-hgilbk8","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"郁金，清气化痰，散瘀血之药也。其性轻扬，能散郁滞，顺逆气，上达高巅，善行下焦，心肺肝胃气血火痰郁遏不行者最验，故治胸胃膈痛，两胁胀满，肚腹攻疼，饮食不思等证。又治经脉逆行，吐血衄血，唾血血腥。此药能降气，气降则火降，而痰与血，亦各循其所安之处而归原矣。前人未达此理，乃谓止血生肌，错谬甚矣。\""}]},{"ID":"20240614123301-sqqhpp2","Type":"NodeParagraph","Properties":{"id":"20240614123301-sqqhpp2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"③《本草经读》：\"郁金，气味苦寒者，谓气寒而善降，味苦而善泄也。其云血积者，血不行则为积，积不去则为恶血，血逆于上，从口鼻而出，则为衄血吐血，血走于下，从便溺而出，有痛为血淋，无痛为尿血，即金疮之瘀血不去，则血水不断，不能生肌，此物所以统主之者，以其病原皆由于积血，特取其大有破恶血之功也。盖血以气为主，又标之曰下气者，以苦寒大泄其气，即所以大破其血，视他药更进一步。若经水不调，因实而闭者，不妨以此决之，若因虚而闭者，是其寇仇。且病起于郁者，即《内经》所谓二阳之病发心脾，大有深旨，若错认此药为解郁而频用之，十不救一。至于怀孕，最忌攻破，此药更不可以沾唇。即在产后，非热结停瘀者，亦不可轻用。若外邪未净者，以此擅攻其内，则邪气乘虚而内陷。若气血两虚者，以此重虚其虚，则气血无根而暴脱。此女科习用郁金之害人也。\""}]},{"ID":"20240614123301-glc1j4w","Type":"NodeParagraph","Properties":{"id":"20240614123301-glc1j4w","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614123301-lgko7qc","Type":"NodeParagraph","Properties":{"id":"20240614123301-lgko7qc","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614123301-p5ck6q2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614123301-p5ck6q2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"《中华本草》：郁金"}]},{"ID":"20240614123301-9hg4sjm","Type":"NodeParagraph","Properties":{"id":"20240614123301-9hg4sjm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614123301-423ptgq","Type":"NodeParagraph","Properties":{"id":"20240614123301-423ptgq","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" Yù Jīn"}]},{"ID":"20240614123301-ybnigdi","Type":"NodeParagraph","Properties":{"id":"20240614123301-ybnigdi","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614123301-pjkyw21","Type":"NodeParagraph","Properties":{"id":"20240614123301-pjkyw21","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 马蒁、五帝足、黄郁、乌头"}]},{"ID":"20240614123301-a5sl7i6","Type":"NodeParagraph","Properties":{"id":"20240614123301-a5sl7i6","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614123301-14vlapc","Type":"NodeParagraph","Properties":{"id":"20240614123301-14vlapc","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" Turmeric Root-tuber, Root-tuber of Aromatic Turmeric, Root-tuber of Kwangsi Turmeric, Root-tuber of Common turmeric, Root-tuber of Zedoary Turmeric"}]},{"ID":"20240614123301-osl6c8o","Type":"NodeParagraph","Properties":{"id":"20240614123301-osl6c8o","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614123301-sanfwun","Type":"NodeParagraph","Properties":{"id":"20240614123301-sanfwun","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》。"}]},{"ID":"20240614123301-dl5ix97","Type":"NodeParagraph","Properties":{"id":"20240614123301-dl5ix97","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：郁金，今广南、江西州郡亦有之，然不及蜀中者佳。古方稀用，今小儿方及马医多用之。"}]},{"ID":"20240614123301-1y1e7p7","Type":"NodeParagraph","Properties":{"id":"20240614123301-1y1e7p7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：郁金，蜀产者体圆尾锐，如蝉腹状，发苗处有小孔，皮黄而带黑，通身粗皱如梧桐子纹，每枚约重半钱，折开质坚色黄，中带紫黑，嗅之微香不烈者真。若大小不等，折之中空质柔，内外皆黄，其气烈者，即片子姜黄也。体圆，首尾相似，通身横纹，发苗处无小孔，折开气烈触鼻者，染色"}]},{"ID":"20240614123301-ae05hiz","Type":"NodeParagraph","Properties":{"id":"20240614123301-ae05hiz","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614123301-0ixd0s1","Type":"NodeParagraph","Properties":{"id":"20240614123301-0ixd0s1","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 药材基源：为姜科植物温郁金、姜黄、广西莪术、莪术或川郁金的块根。"}]},{"ID":"20240614123301-g9qwxfy","Type":"NodeParagraph","Properties":{"id":"20240614123301-g9qwxfy","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Curcuma wenyujin Y.H.Chen et C.Ling2.Curcuma longa L3.Curcuma kwangsiensis S.G.Lee et C.F.Liang4.Curcuma aeruginosa Roxb5.Curcuma chuanyujin C.K.Hsieh et H.Zhang"}]},{"ID":"20240614123301-i3n6c5o","Type":"NodeParagraph","Properties":{"id":"20240614123301-i3n6c5o","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在栽种当年12月中下旬，茎叶逐渐顶枯萎，选晴天干燥时，将地上叶苗割去，挖出地下部分，抖去泥土，摘下块根，蒸或煮红15min，晒干或烘干，撞去须根即成。"}]},{"ID":"20240614123301-3prcw5g","Type":"NodeParagraph","Properties":{"id":"20240614123301-3prcw5g","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614123301-vdivqcl","Type":"NodeParagraph","Properties":{"id":"20240614123301-vdivqcl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于土质肥沃、湿润的向阳山坡或田 地，多系栽培。"}]},{"ID":"20240614123301-xo0cp98","Type":"NodeParagraph","Properties":{"id":"20240614123301-xo0cp98","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于四川省。"}]},{"ID":"20240614123301-cbboul3","Type":"NodeParagraph","Properties":{"id":"20240614123301-cbboul3","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614123301-eoug8s5","Type":"NodeParagraph","Properties":{"id":"20240614123301-eoug8s5","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 1.温郁金，多年生草本，高80-160cm。主根茎陀罗状，侧根茎指状，内面柠檬色。须根细长，末端常膨大成纹锤形块根，内面白色。叶片4-7，2列，叶柄短，长不及叶片的一半；叶片宽椭圆形，长35-75cm，宽14-22cm，先端渐尖或短尾状渐尖，基部楔形，下延至叶柄，下面无毛。穗状花序圆柱状，先叶于根茎处抽出，长20-30cm，直径4-6cm ，上部无花的苞片长椭圆形，长5-7cm，宽1.5-2.5cm，蔷薇红色，中下部有花的苞片长椭圆形，长3-5cm，宽2-4cm，绿白色；花萼筒白色，先端具不等的3齿；花冠管漏斗状，白色，裂片3，膜质，长椭圆形，后方一片较大，先端略成兜状，近先端处有粗糙毛；侧生退化雄蕊花瓣叛变 ，黄色，唇瓣倒卵形，外折，黄色，先端微凹；能育雄蕊1，花药基部有距；子房被长柔毛，花柱细长。花期4-6月。"}]},{"ID":"20240614123301-speksl3","Type":"NodeParagraph","Properties":{"id":"20240614123301-speksl3","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"2.姜黄，姜黄，多年生草本，高1-1.5m。根茎发达，成丛，分枝呈椭圆形或圆柱状，橙黄色，极香；根粗壮，末端膨大成块根。叶基生，5-7片，2列；叶柄长20-45cm；叶片长圆形或窄椭圆形，长20-50cm，宽5-15cm，先端渐尖，基部楔形，下延至叶柄，上面黄绿色，下面浅绿色，无毛。花葶由叶鞘中抽出，总花梗长12-20cm，穗状花序圆柱状，长12-18cm；上部无花的苞片粉红色或淡红紫色，长椭圆形，长4-6cm，宽1-1.5cm，中下部有花的苞片嫩绿色或绿白色，卵形至近圆形，长3-4cm；花萼简绿白色，具3齿；花冠管漏斗形，长约1.5cm，淡黄色，喉部密生柔毛，裂片3；能育雄蕊1，花丝短而扁平，花药长圆形，基部有距；子房下位，外被柔毛，花柱细长，基部有2个棒状腺体，柱头稍膨大，略呈唇形。花期8月。"}]},{"ID":"20240614123301-uip5ykr","Type":"NodeParagraph","Properties":{"id":"20240614123301-uip5ykr","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"3.广西莪术，多年生草本，高50-110cm。主根茎卵圆形，侧根茎指状，断面白色或微黄色。须根末端常膨大成组锤形块根，断面白色。叶基生，叶柄为叶片长度的1/4，被短柔毛；叶鞘长10-33cm，被短柔毛；叶2-5片，直立，叶片长椭圆形，长14-39cm，宽4.5-7(-9.5)cm，先端短尖至渐尖，基部渐狭，下延，两面密被粗柔毛，有的类型沿中脉两侧有紫晕。稳状花序从根茎中抽出，圆柱形，先叶或与叶同时抽出，长约15cm，直径约7cm，花序下的苞片阔卵形，淡绿色，上部的苞片长圆形，淡红色；花萼白色，长约Icm，一侧裂至中部，先端有3钝齿；花冠近漏斗状，长2-2.5cm，花瓣3，粉红色，长圆形，后方的1片较宽，先端略成兜状；侧生退化雄蕊花瓣状，淡黄色，唇瓣近圆形，淡黄色，先端3浅圆裂，花药基部有距；子房被长柔毛，花柱丝状，柱头头状，有毛。花期5-7月。"}]},{"ID":"20240614123301-w4lmrkw","Type":"NodeParagraph","Properties":{"id":"20240614123301-w4lmrkw","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"4.莪术，多年生草本，高80-150cm。主根茎陀罗状至锥状陀罗形，侧根茎指状，内面黄绿色至墨绿色，或有时发蓝色，须根末端膨大成肉质纺锤形，内面黄绿或近白色。叶鞘下段常为褐紫色。叶基生，4-7片；叶柄短，为叶片长度的1/3-1/2或更短；叶片长圆状椭圆形，长20-50cm，宽8-20cm，先端渐尖至短尾尖，基部下延成柄，两面无毛，上面沿中脉两侧有1-2cm宽的紫色晕。穗状花序圆柱状，从根茎中抽出，长12-20cm，有苞片20多枚，上部苞片长椭圆形，长4-6cm，宽1.5-2cm，粉红色呈紫红色；中下部苞片近圆形，长2-3.5cm，宽1.5-3.2cm，淡绿色至白色。花期4-6月。"}]},{"ID":"20240614123301-cpdpfle","Type":"NodeParagraph","Properties":{"id":"20240614123301-cpdpfle","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.川郁金，多年生草本，高80-120cm。块根纹锤形，断面浅黄色至白色。主根茎陀罗形，侧根茎指状，断面黄色。叶2列，4-7枚，叶柄长为叶片的1/4-1/3；叶片长圆形，先端急尖，基部楔形并下延至叶柄，两面有茸毛。穗状花痛圆锥状，从根茎上抽出，缨部苞片粉红色至淡红色，腑内无花，中下部苞片绿色，上面光滑，背部有柔毛，腑内有花数朵，有小苞片数枚，小苞片白色、透明；花萼筒3齿，外被柔毛，白色，膜质；花冠管长约6.5cm，喉部密生柔毛，裂片3，略呈粉红色，上方一片较大，先端卷曲；侧生退化雄蕊花瓣状，黄色，唇瓣近圆形，先端明显3裂；能痛雄蕊1，花丝短而扁平，花药长圆形，长5mm，基部有距；花柱细长，从药室中穿过，基部具2棒状体，子房下位，外被柔毛。花期4-6月。"}]},{"ID":"20240614123301-58pze33","Type":"NodeParagraph","Properties":{"id":"20240614123301-58pze33","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614123301-pnroqxr","Type":"NodeParagraph","Properties":{"id":"20240614123301-pnroqxr","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 生物学特性，喜温暖湿润气候，阳光充足，雨量充沛的环境，怕严寒霜冻，怕干旱积水。宜在土层深厚、上层疏松、下层较紧密的砂质壤土栽培。忌连作，栽培多与高秆作物套种。"}]},{"ID":"20240614123301-72ktowk","Type":"NodeParagraph","Properties":{"id":"20240614123301-72ktowk","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"栽培技术，用根茎繁殖。收获时，选无病虫害、无损伤的根茎作种。种根茎置室内干燥通风处堆放贮藏过冬，春季栽部时取出。栽种前将大的根茎纵切成两半或小块，每块具2个芽以上，为了防止种根茎腐烂，待切面稍晾干后下种，也可边切边沾上石灰或草木灰后，立即栽种。畦栽，行距33-40cm穴距27-33cm，每穴栽根茎3-5块，芽朝上，覆土，稍加镇压。每1hm2用种量2250-3000kg .田间管理，齐苗后要及时进行中耕除草，常年进行3-4次，并结合追肥，肥料以人粪尿或硫酸铵等氨肥为主。9月间重施磷钾肥，以促进块根生长。干旱时，特别是在块根形成膨大期，必须注意藻溉，当水分过多、四周积水时，必须及时排除，以免要腐。"}]},{"ID":"20240614123301-sd1qsoc","Type":"NodeParagraph","Properties":{"id":"20240614123301-sd1qsoc","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"病虫害防治，病害有黑斑病，为害叶片，发病初期及时摘除病叶，用50%托布津500倍液或65%代森锌可湿性粉剂400-800倍液喷射。虫害有地老虎和蛴螬，在幼苗期咬食须根，使块根不能形成，可人工捕捉或毒饵诱杀。还有姜弄蝶、玉米螟等为害。"}]},{"ID":"20240614123301-ii2mipo","Type":"NodeParagraph","Properties":{"id":"20240614123301-ii2mipo","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614123301-fbsn1hl","Type":"NodeParagraph","Properties":{"id":"20240614123301-fbsn1hl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）温郁金块根长圆形或卵圆形，稍扁，有的微弯曲，两端渐尖。长3.5-7cm，直径1.2-2.5cm。表面灰褐色或灰棕色，具不规则的纵皱纹，纵纹隆起处其较浅。质坚实，断面灰棕色或灰绿色，具蜡样光泽；内皮层环明显。气微许，味微持。"}]},{"ID":"20240614123301-txp3tdk","Type":"NodeParagraph","Properties":{"id":"20240614123301-txp3tdk","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（2）美黄（黄丝郁金）块根纺锤形，有的一端细长，一端肥大。长2.5-4.5cm，直径1-1.5cm。表面棕灰色或灰黄色，具细皱纹。质坚硬、断面角质，中央橙黄色，外周棕黄色至棕红色。气芳香，味辛辣。"}]},{"ID":"20240614123301-qvof3zs","Type":"NodeParagraph","Properties":{"id":"20240614123301-qvof3zs","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（3）广西莪术（桂郁金）块根长圆锥形或民圆形，长2-6.5cm，直径1-1.8cm 。表面暗棕色或土黄色，具疏浅纵纹及较粗糙网状纹理。质坚硬。断面角质，灰棕至棕色，内皮层较明显。气微，味微辛苦。"}]},{"ID":"20240614123301-5r32e6t","Type":"NodeParagraph","Properties":{"id":"20240614123301-5r32e6t","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（4）莪术（绿丝郁金）块根长椭圆形，较粗壮，长1.5-3.5cm，直径1-1.2cm ，表白灰色或灰黑色，具皱纹。质坚硬、断面个角债，微显灰棕色，内皮层较明显。气微，味淡。"}]},{"ID":"20240614123301-6wkqcga","Type":"NodeParagraph","Properties":{"id":"20240614123301-6wkqcga","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（5）川郁金（白丝郁金或黄白丝郁金）块根纺锤形或长圆形，长1.7-5cm，直径1-1.2cm，表面土黄或全棕色。断面角质，具蜡样光泽，浅棕色或近白色。气微，味辛。"}]},{"ID":"20240614123301-rqt7q5u","Type":"NodeParagraph","Properties":{"id":"20240614123301-rqt7q5u","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"显微鉴别 横切面：（1）温郁金根被细胞1-8列，壁薄。"}]},{"ID":"20240614123301-4xihea1","Type":"NodeParagraph","Properties":{"id":"20240614123301-4xihea1","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"内皮层明显。韧皮部束与木质部束各40-55个、导管旁伴有纤维。薄壁细胞含糊化淀粉粒。"}]},{"ID":"20240614123301-6wivi9d","Type":"NodeParagraph","Properties":{"id":"20240614123301-6wivi9d","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（2）姜黄（黄丝郁金）根被细胞最内1列，壁增厚，木比。"}]},{"ID":"20240614123301-b7jkcey","Type":"NodeParagraph","Properties":{"id":"20240614123301-b7jkcey","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"内皮层明显。木质部来与韧皮都来各22-29个，导管分偶有纤维。油细胞和色素细胞众多。"}]},{"ID":"20240614123301-gnbgvtz","Type":"NodeParagraph","Properties":{"id":"20240614123301-gnbgvtz","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（3）广西获术（桂郁金）根被细胞壁偶有增厚。木质部束与韧皮部柬各42-48个，导管常伴有纤维。"}]},{"ID":"20240614123301-iq9mxba","Type":"NodeParagraph","Properties":{"id":"20240614123301-iq9mxba","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（4）莪术（绿丝郁金）根被细胞壁元增厚。木质部束与韧皮部束各64-72个，导管劳多伴有纤维。"}]},{"ID":"20240614123301-7qr7hee","Type":"NodeParagraph","Properties":{"id":"20240614123301-7qr7hee","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（5）川郁金根被细胞壁增厚，非木化或偶有木化。木质部束与韧皮都束各30-40个，导管旁常伴有纤维。"}]},{"ID":"20240614123301-2g7ebjm","Type":"NodeParagraph","Properties":{"id":"20240614123301-2g7ebjm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614123301-t7epp81","Type":"NodeParagraph","Properties":{"id":"20240614123301-t7epp81","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 用体重21-25g雌性小鼠50只，分为5组，每组10只，由腹腔注射不同剂量的片姜黄水煎剂。给药1次，观察72小时，记录死亡动物数。按寇氏法求得ＬD50为33.79g／kg，SD为3.09g／kg。给药5分钟后，小鼠活动减少，大剂量组于0.5小时内全部死亡，死前出现抽搐。低剂量组小鼠在给药后，略呈安静状态，第2天恢复正常。姜黄色素胶囊剂小鼠口服6g／kg测不出半数致死量。大鼠亚急性毒性试验结果表明，对大鼠食欲、体重、一般状况、血液学和血液生化学指标及肝、肾重量均无明显影响。"}]},{"ID":"20240614123301-cr5w2yc","Type":"NodeParagraph","Properties":{"id":"20240614123301-cr5w2yc","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614123301-jway7xk","Type":"NodeParagraph","Properties":{"id":"20240614123301-jway7xk","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 1.温郁金，块根含姜黄素类化合物：姜黄素(curcumin)，去甲氧基姜黄素(demethoxycurcumin)，双去甲氧基姜黄素(bisdemethoxycurcumin)。"}]},{"ID":"20240614123301-jkcl1gq","Type":"NodeParagraph","Properties":{"id":"20240614123301-jkcl1gq","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"2.姜黄，块根含姜黄素类化合物：姜黄素、去甲氧基姜黄素、双去甲氧基姜黄素；挥发油基主要成分有姜黄酮(turmerone)，芳香-姜黄酮(ar-turmerone)，大牻牛儿酮(germacrone)，松油烯(terpinene)，姜黄烯(curcumene)，芳香-姜黄烯(ar-curcumene)，藜术二酮(curdiene)，莪术醇(curcumol)，桉叶素(cineole)，丁香烯(caryophyllene)，柠檬烯(linonene)，芳樟醇(linalool)，α-蒎烯(α-pinene)，β-蒎烯(β-pinene)，樟烯(camphene)及异龙脑(isoborneol)等。"}]},{"ID":"20240614123301-zlg8vwy","Type":"NodeParagraph","Properties":{"id":"20240614123301-zlg8vwy","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"3.广西莪术，含挥发油，其成分主要有-β-蒎烯，桉叶素，龙脑(borneol)，异龙脑，丁香烯，樟脑(camphor)，β-榄香烯(β-elemene)，δ-榄香烯(δ-elemene)，律草烯(humulene)，α-松油烯，芳樟醇，乌药奥(linderazulene)异莪术烯醇(isocurcumenol)，桂莪术内酯(gweicurculactone)等。还含β-谷甾醇(β-sitosterol)，胡萝卜甙(daucosterol)及棕榈酸(palmitic acid)。"}]},{"ID":"20240614123301-aztqav0","Type":"NodeParagraph","Properties":{"id":"20240614123301-aztqav0","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"4.莪术，块根含姜黄素，去甲氧基姜黄素，双去甲氧基姜黄素。"}]},{"ID":"20240614123301-j7u9jrf","Type":"NodeParagraph","Properties":{"id":"20240614123301-j7u9jrf","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.川郁金，块根含姜黄素，去甲氧基姜黄素，双去甲氧基姜黄素。"}]},{"ID":"20240614123301-bkv7k3k","Type":"NodeParagraph","Properties":{"id":"20240614123301-bkv7k3k","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614123301-67696x1","Type":"NodeParagraph","Properties":{"id":"20240614123301-67696x1","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 1.对动物妊娠作用的影响：1.1.对小白鼠和家兔的终止妊娠作用：实验小鼠用未生育过的昆明种成年健康雌小鼠，体重28-35g，与健康成年雄小鼠合笼。每天检查雌鼠1次，发现阴栓作为妊娠第1天。小鼠分别于妊娠早期（6-7天）、中期（10-14天）和晚期（16-18天）腹腔注射或皮下注射片姜黄水煎剂5或10g／kg体重，每天1次，连续2天。小鼠于停药后1-5天解剖，检查子宫内胚胎发育情况，记录妊娠动物数，正常胚胎和坏死胚胎数。并在给药期间每天检查小鼠阴道2次，观察有无出血现象，凡阴道无出血，剖检时又无着床痕迹，则不列入计数。结果表明腹腔注射或皮下注射片姜黄水煎液对小鼠早、中、晚各期妊娠都有明显作用，终止妊娠率分别为90-100%，口服给药则无效。实验家兔用健康雌性家兔，体重2-3kg，经隔离3-4周，确定无孕后，肌肉注射苯甲酸雌二醇80μg，24小时后先后与有生育力的2只雄兔交配，于阴道内检出精子作为妊娠第1天，分别于妊娠早期（8-10天）、中期（13-15天）和晚期（23-25天），腹腔注射或皮下注射片姜黄水煎液4-8g／kg，每天1次，连续2-3天，于停药后3-7天解剖，检查子宫，并记录胚胎数。结果表明，腹腔注射或皮下注射8g／kg片姜黄水煎液，可全部终止家兔早期和中期妊娠，使晚期妊娠家兔全部流产。"}]},{"ID":"20240614123301-i1o6w3h","Type":"NodeParagraph","Properties":{"id":"20240614123301-i1o6w3h","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"1.2.对小鼠子宫创伤性蜕膜形成的作用：于小鼠假孕第4天，在右侧子宫角1／3系膜对侧处穿一丝线，同时皮下注射片姜黄水煎液0.3g／只，每天1次，连续2天。于假孕第8天将动物处死，取出两侧子宫，按Greenwald法，以两侧子宫角重量之差，为蜕膜瘤生成的指标，并与对照组比较。结果表明对照组假孕小鼠创伤性子宫蜕膜重量比对照组子宫角增加499.3%，而给药组实验侧子宫重量下降1.5%，蜕膜生长明显受到抑制。由此认为片姜黄具有明显的抗孕激素活性。张寅恭等的研究还证实，片姜黄无雌激素和抗雌激素活性，但具有拮抗内源性妊娠早期孕酮（黄体酮）的作用。根据实验中观察到的片姜黄可使小鼠及家兔妊娠晚期的胎仔和胎盘完整地排出或娩出这一现象以及上述的研究结果，认为片姜黄终止动物妊娠的作用机理，很可能与该药的抗孕激素活性和收缩子宫作用有关。有报道表明，片姜黄水煎剂和盐酸浸剂对动物离体和在体子宫都有明显的收缩作用，且作用时间相当持久，发生阵发性收缩相当规律。"}]},{"ID":"20240614123301-1t5pzj7","Type":"NodeParagraph","Properties":{"id":"20240614123301-1t5pzj7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"2.对中毒性肝炎的作用：姜黄块根的50%乙醇提取物1mg／ml，可使四氯化碳培养基的GPT活性上升，抑制到约为对照组的10%，以这种GPT活性为指标进行分离，得到姜黄块根的抑制四氯化碳肝细胞损害成分姜黄素（Curcumin）、香豆基阿魏酸乙烷（Coumaroylferuloylethane）、二-对-香豆基甲烷（Di-p-coumaroylmethane），其LD50分别为0.11mg／ml、0.14mg／ml、0.25mg／ml，这些化合物对半乳糖胺肝细胞损害亦有显着的抑制作用。通过测定GOT和GPT证明，从姜黄块根中分得的p-香豆阿魏酰甲烷（p-Coumaroylferuloylmethane）和二-P-香豆酰甲烷（Di-p-doumaroylmethane）对用四氯化碳及半乳糖胺分别诱发小鼠和大鼠肝损伤均具有显着的抗肝毒作用。用四氯化碳法制造小鼠中毒性肝炎模型，通过碳粒廓清试验、溶血素测定、脾细胞PFC试验，观察郁金挥发油对其免疫功能的影响，结果表明、模型组经用郁金挥发油注射液治疗后，其溶血素含量和脾细胞PFC均明显降低（P＜0.05，＜0.01），郁金挥发油能调节中毒性肝炎小鼠的体液免疫，具有免疫抑制剂的作用。"}]},{"ID":"20240614123301-ast7f6e","Type":"NodeParagraph","Properties":{"id":"20240614123301-ast7f6e","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"3.抗真菌作用：用滤纸圆片扩散平板法测定姜黄根茎挥发油抗真菌活性表明，挥发油对产黄青霉的抑制活性最大，对P.Lapagericola最小。挥发油经1：1000稀释后仍对大多数试验菌具有足够的抑制作用。挥发油对石交状小孢霉（M.Gypseum）和须发癣菌（T.Mentagrophytes）均无抑制作用。"}]},{"ID":"20240614123301-t0jmvjm","Type":"NodeParagraph","Properties":{"id":"20240614123301-t0jmvjm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"4.免疫活性：郁金多糖具有强的网状内皮系统激活活性，吞噬指数K为0.2526。"}]},{"ID":"20240614123301-jtu267r","Type":"NodeParagraph","Properties":{"id":"20240614123301-jtu267r","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.对循环系统的影响：。"}]},{"ID":"20240614123301-w0ldizh","Type":"NodeParagraph","Properties":{"id":"20240614123301-w0ldizh","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.1.对血液流变的影响：姜黄醇提取物对纤维蛋白原有明显的影响，其活血作用与其降低血浆纤维蛋白原含量有关。"}]},{"ID":"20240614123301-gdwlvui","Type":"NodeParagraph","Properties":{"id":"20240614123301-gdwlvui","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.2.对血脂影响：姜黄色素80mg／kg，每天1次，连续40天，对大鼠血清、主动脉和肝脏的胆固醇和甘油三酯含量升高有明显的抑制作用。黄再峰等报道姜黄醇提取物对胆固醇无明显影响。薛春生报道姜黄醇提取物、姜黄挥发油、姜黄素均有降血浆胆固醇、β-脂蛋白和甘油三酯的作用，并能使主动脉中的总胆固醇、甘油三酯含量降低，其中尤以姜黄醇提取物和姜黄素的作用最为明显。"}]},{"ID":"20240614123301-zndxji7","Type":"NodeParagraph","Properties":{"id":"20240614123301-zndxji7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.对消化系统的影响：。"}]},{"ID":"20240614123301-58s5cxm","Type":"NodeParagraph","Properties":{"id":"20240614123301-58s5cxm","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.1.胃酸分泌：口服郁金煎剂前胃酸分泌量为4.24±0.58mol／L·h，口服后为10.8±0.93mol／L·h。"}]},{"ID":"20240614123301-kiewryi","Type":"NodeParagraph","Properties":{"id":"20240614123301-kiewryi","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.2.十二指肠液中HCO3-浓度：注入郁金煎剂前为7.04±5.6mmol／L，注入后为22.4±8.4mmol／L，使十二指肠液中［HCO3（-）］增高。"}]},{"ID":"20240614123301-4h6q62n","Type":"NodeParagraph","Properties":{"id":"20240614123301-4h6q62n","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.3.血清胃泌素浓度：口服郁金煎剂前血清胃泌素浓度为91.27±10.97ng／L，口服后为98.93±14.27ng／L，差异不显着。"}]},{"ID":"20240614123301-13nsgi7","Type":"NodeParagraph","Properties":{"id":"20240614123301-13nsgi7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.4.血清胰泌素浓度：注入郁金煎剂前为70.36±43.5pg／ml、注入后为93.4±49.7pg／ml，郁金煎剂有刺激胰泌素分泌的作用，使血清胰泌素水平升高。"}]},{"ID":"20240614123301-jmsi7zv","Type":"NodeParagraph","Properties":{"id":"20240614123301-jmsi7zv","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.5.对大鼠胆汁排出量的影响：姜黄色素和去氧胆酸钠对大鼠胆汁排出量有很明显的增加作用，去氧胆酸钠的作用最为显着。"}]},{"ID":"20240614123301-jkldqcp","Type":"NodeParagraph","Properties":{"id":"20240614123301-jkldqcp","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614123301-zyjkhns","Type":"NodeParagraph","Properties":{"id":"20240614123301-zyjkhns","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 1.用水浸泡，洗净，捞出晒晾，润透，切片，晒干。"}]},{"ID":"20240614123301-4blqydg","Type":"NodeParagraph","Properties":{"id":"20240614123301-4blqydg","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"2.醋炒：取郁金片加米醋拌匀，闷透。置锅内用文火加热炒干，取出，放凉。每100kg郁金片，用醋10kg。"}]},{"ID":"20240614123301-lsvt17h","Type":"NodeParagraph","Properties":{"id":"20240614123301-lsvt17h","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"3醋蒸：取原药去净杂质，加醋10%及水适量，浸吸约2天，常翻拌，吸透后，入甑内用武火，蒸约2-3小时，取出切成厚约2mm顺片，晒干。"}]},{"ID":"20240614123301-v7mm0jf","Type":"NodeParagraph","Properties":{"id":"20240614123301-v7mm0jf","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"4.醋煮：取净郁金，用水浸泡4成透；捞出，移出锅内，加醋，水同煮至水尽，取出，晾至半干时，切斜片，晒干，每郁金500g，用醋120g。"}]},{"ID":"20240614123301-de1kkyl","Type":"NodeParagraph","Properties":{"id":"20240614123301-de1kkyl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.酒制：取郁金片与黄酒拌匀，置锅内用文火炒至微干，取出晾干，每郁金片500g，用黄酒60g。"}]},{"ID":"20240614123301-flu3ava","Type":"NodeParagraph","Properties":{"id":"20240614123301-flu3ava","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.炒制：取净郁金片，置锅内用文火加热，炒至深黄色。"}]},{"ID":"20240614123301-h87kkhp","Type":"NodeParagraph","Properties":{"id":"20240614123301-h87kkhp","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"7.蒸制：取原药材，拣去杂质，清水洗净，浸泡2-3小时，捞起，闷润4-5小时，置锅内隔水蒸至透心，刨成薄片，晒干即得。"}]},{"ID":"20240614123301-0og3afw","Type":"NodeParagraph","Properties":{"id":"20240614123301-0og3afw","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"8.矾制：郁金加明矾水，用微火炒干，至呈老黄色为度，每郁金黄色16kg，用明矾2kg。水适量。"}]},{"ID":"20240614123301-6xqpuen","Type":"NodeParagraph","Properties":{"id":"20240614123301-6xqpuen","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"9.矾、醋制：取郁金与米醋，倒入热米汤中，加白矾搅匀，放24小时后，再煮2小时，至米汤干，晒至7-8成干，润2天，切1-1.5mm厚的片，晒干，每郁金10kg，用米醋1kg，白矾30g，米汤适量。"}]},{"ID":"20240614123301-iupjq38","Type":"NodeParagraph","Properties":{"id":"20240614123301-iupjq38","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614123301-obmix9l","Type":"NodeParagraph","Properties":{"id":"20240614123301-obmix9l","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱：取温郁金、姜黄、广西我术、我木块根粉末各100g,用水蒸气蒸馏，取微量挥发油点祥于桂胶薄层板上，以获术醇、美黄酮为对照品，己烷-乙酸乙酯（85：15）展开，10%磷铝酸乙醇溶液显色，样品色谱在与对照品色谱的相应位置上，有相同的斑点。"}]},{"ID":"20240614123301-rhe01fi","Type":"NodeParagraph","Properties":{"id":"20240614123301-rhe01fi","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"商品规格商品按产地分为川都金、温郁金和桂郁金。（1）川郁金根据性状分布的丝和绿白丝两种规格，平均以每1kg600粒以内为一等，600粒以外，直径入少于0.5cm为二等。"}]},{"ID":"20240614123301-fpd6nzg","Type":"NodeParagraph","Properties":{"id":"20240614123301-fpd6nzg","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（2）温郁金 有绿丝规格，每1kg 280粒以内为一等， 280粒以外，直径不少于0.5cm为二等。"}]},{"ID":"20240614123301-r7m35zf","Type":"NodeParagraph","Properties":{"id":"20240614123301-r7m35zf","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"（3）桂郁金不分规格和等级。"}]},{"ID":"20240614123301-vk7xnw7","Type":"NodeParagraph","Properties":{"id":"20240614123301-vk7xnw7","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614123301-210gd5k","Type":"NodeParagraph","Properties":{"id":"20240614123301-210gd5k","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 心；肝；胆经"}]},{"ID":"20240614123301-kwrpcz2","Type":"NodeParagraph","Properties":{"id":"20240614123301-kwrpcz2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614123301-p7s166i","Type":"NodeParagraph","Properties":{"id":"20240614123301-p7s166i","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性寒"}]},{"ID":"20240614123301-7ncp5fg","Type":"NodeParagraph","Properties":{"id":"20240614123301-7ncp5fg","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614123301-fs8ht3i","Type":"NodeParagraph","Properties":{"id":"20240614123301-fs8ht3i","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 阴虚失血及无气滞血瘀者忌服，孕妇慎服。"}]},{"ID":"20240614123301-2t62ho5","Type":"NodeParagraph","Properties":{"id":"20240614123301-2t62ho5","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614123301-kuqmsrw","Type":"NodeParagraph","Properties":{"id":"20240614123301-kuqmsrw","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 活血止能；行气解郁；清心凉血；疏肝利胆。主胸腹胁肋诸痛；妇女痛经；经闭；症瘕结块；热病神昏；癫狂；惊痫；吐血；衄备；血淋；砂淋；黄疸"}]},{"ID":"20240614123301-1y76br3","Type":"NodeParagraph","Properties":{"id":"20240614123301-1y76br3","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614123301-yfugcds","Type":"NodeParagraph","Properties":{"id":"20240614123301-yfugcds","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸散。"}]},{"ID":"20240614123301-0m5g31j","Type":"NodeParagraph","Properties":{"id":"20240614123301-0m5g31j","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614123301-wpua5j6","Type":"NodeParagraph","Properties":{"id":"20240614123301-wpua5j6","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 1.《本草经疏》：郁金本入血分之气药，其治已上诸血证者，正谓血之上行，皆属于内热火炎，此药能降气，气降即是火降，而其性又入血分，故能降下火气，则血不妄行。"}]},{"ID":"20240614123301-rx7h7k2","Type":"NodeParagraph","Properties":{"id":"20240614123301-rx7h7k2","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：郁金，清气化痰，散瘀血之药也。其性轻扬，能散郁滞，顺逆气，上达高巅，善行下焦，心肺肝胃气血火痰郁遏不行者最验，故治胸胃膈痛，两胁胀满，肚腹攻疼，饮食不思等证。又治经脉逆行，吐血衄血，唾血血腥。此药能降气，气降则火降，而痰与血，亦各循其所安之处而归原矣。前人未达此理，乃谓止血生肌，错谬甚矣。"}]},{"ID":"20240614123301-94rwcxp","Type":"NodeParagraph","Properties":{"id":"20240614123301-94rwcxp","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：郁金，辛平无毒，《本草》以为辛寒，误矣，安有辛香而寒之理。"}]},{"ID":"20240614123301-fb02dxl","Type":"NodeParagraph","Properties":{"id":"20240614123301-fb02dxl","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：郁金，辛苦而平。诸书论断不一，有言此属纯阴，其论所治，皆属破气下血之说。有言性温不寒。其论所治，则有疗寒除冷之谓。究之，体轻气窜，其气先上行而微下达，凡有宿血凝积，及有恶血不堪之物，先于上处而行其气，若使其邪、其气、其痰、其血在于膈上而难消者，须审宜温、宜凉，同于他味兼为调治之。如败血冲心，加以姜汁童便；去心疯癫，明矾为丸、朱砂为衣之类。若使恶血、恶痰、恶瘀、恶淋、恶痔在于下部而难消者，俟其辛气既散，苦气下行，即为疏泄，而无郁滞难（羁）留之弊矣。书云，此药纯阴而寒者，因性主下而言也。有云是药性温者，因气味辛香，主上而言也。各有论说不同，以致理难划一耳，因为辨论正之。"}]},{"ID":"20240614123301-apdhk68","Type":"NodeParagraph","Properties":{"id":"20240614123301-apdhk68","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"5.《本草经读》：郁金，气味苦寒者，谓气寒而善降，味苦而善泄也。其云血积者，血不行则为积，积不去则为恶血，血逆于上，从口鼻而出，则为衄血吐血，血走于下，从便溺而出，有痛为血淋，无痛为尿血，即金疮之瘀血不去，则血水不断，不能生肌，此物所以统主之者，以其病原皆由于积血，特取其大有破恶血之功也。盖血以气为主，又标之曰下气者，以苦寒大泄其气，即所以大破其血，视他药更进一步。若经水不调，因实而闭者，不妨以此决之，若因虚而闭者，是其寇仇。且病起于郁者，即《内经》所谓二阳之病发心脾，大有深旨，若错认此药为解郁而频用之，十不救一。至于怀孕，最忌攻破，此药更不可以沾唇。即在产后，非热结停瘀者，亦不可轻用。若外邪未净者，以此擅攻其内，则邪气乘虚而内陷。若气血两虚者，以此重虚其虚，则气血无根而暴脱。此女科习用郁金之害人也。"}]},{"ID":"20240614123301-95nxv38","Type":"NodeParagraph","Properties":{"id":"20240614123301-95nxv38","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"6.《药性论》：治女人宿血气心痛，冷气结聚，温醋摩服之。"}]},{"ID":"20240614123301-smzl926","Type":"NodeParagraph","Properties":{"id":"20240614123301-smzl926","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"7.《唐本草》：主血积，下气，生肌，止血，破恶血，血淋，尿血，金疮。"}]},{"ID":"20240614123301-qsqdwjs","Type":"NodeParagraph","Properties":{"id":"20240614123301-qsqdwjs","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"8.《珍珠囊》：凉心。"}]},{"ID":"20240614123301-wjgd14a","Type":"NodeParagraph","Properties":{"id":"20240614123301-wjgd14a","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"9.李杲：治阳毒入胃，下血频痛。"}]},{"ID":"20240614123301-8lkfiki","Type":"NodeParagraph","Properties":{"id":"20240614123301-8lkfiki","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"10.《本草衍义补遗》：治郁遏不能散。"}]},{"ID":"20240614123301-13ubuqg","Type":"NodeParagraph","Properties":{"id":"20240614123301-13ubuqg","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"11.《本草纲目》：治血气心腹痛，产后败血冲心欲死，失心颠狂。"}]},{"ID":"20240614123301-e06nbcn","Type":"NodeParagraph","Properties":{"id":"20240614123301-e06nbcn","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"12.《本草通玄》：治痘毒入心。"}]},{"ID":"20240614123301-15eduky","Type":"NodeParagraph","Properties":{"id":"20240614123301-15eduky","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"13.《本草正》：止吐血，衄血；单用治妇人冷气血积，结聚气滞，心腹作痛。"}]},{"ID":"20240614123301-76hv10k","Type":"NodeParagraph","Properties":{"id":"20240614123301-76hv10k","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"14.《本草述》：治发热，郁，咳嗽，齿衄，咳嗽血，溲血，头痛眩晕，狂痫，滞下，淋，并眼目鼻舌咽喉等证。"}]},{"ID":"20240614123301-60ezv5a","Type":"NodeParagraph","Properties":{"id":"20240614123301-60ezv5a","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"15.《本草备要》：行气，解郁；泄血，破瘀。凉心热，散肝郁。妇人经脉逆行。"}]},{"ID":"20240614123301-65m28xb","Type":"NodeParagraph","Properties":{"id":"20240614123301-65m28xb","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"16.《本草从新》：能开肺金之郁。"}]},{"ID":"20240614123301-my9cd6c","Type":"NodeParagraph","Properties":{"id":"20240614123301-my9cd6c","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"17.《要药分剂》：凉血。"}]},{"ID":"20240614123301-0hkdt4o","Type":"NodeParagraph","Properties":{"id":"20240614123301-0hkdt4o","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614123301-sq6bi0g","Type":"NodeParagraph","Properties":{"id":"20240614123301-sq6bi0g","updated":"20240614123301"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614123302-ztm4dzi","Type":"NodeThematicBreak","Properties":{"id":"20240614123302-ztm4dzi"}},{"ID":"20240614123303-ugiuczr","Type":"NodeParagraph","Properties":{"id":"20240614123303-ugiuczr"}}]}