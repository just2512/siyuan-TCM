e":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益母草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益母草 4-20240802085221-qci67xh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 520px;\" parent-style=\"width: 530px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619173056-x97d65s","Type":"NodeParagraph","Properties":{"id":"20240619173056-x97d65s","updated":"20240802090053"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 499px;","style":"width: 489px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益母草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益母草-20240619173057-d5kcfbt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 489px;\" parent-style=\"width: 499px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 499px;","style":"width: 489px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益母草 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益母草 12-20240802090053-pwgvvw8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 489px;\" parent-style=\"width: 499px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240802085950-r8mzhsh","Type":"NodeParagraph","Properties":{"id":"20240802085950-r8mzhsh","updated":"20240802085950"}},{"ID":"20240802084500-mq1z8d1","Type":"NodeParagraph","Properties":{"id":"20240802084500-mq1z8d1","updated":"20240802084508"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"益母草、艾草区别"}]},{"ID":"20240802085001-k75te2s","Type":"NodeParagraph","Properties":{"id":"20240802085001-k75te2s","updated":"20240802085047"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 569px;","style":"width: 559px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益母草艾草对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益母草艾草对比-20240802085001-lordqhw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 559px;\" parent-style=\"width: 569px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 594px;","style":"width: 584px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益母草艾草对比 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益母草艾草对比 1-20240802085047-pw308c7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 584px;\" parent-style=\"width: 594px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607095542-d3ly9ie","Type":"NodeParagraph","Properties":{"id":"20240607095542-d3ly9ie","updated":"20240802092538"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：茺蔚子即益母草的果实，益母草有白花益母草和红花益母草两种，其中白花益母草较少见；"}]},{"ID":"20240802084826-me60j7q","Type":"NodeParagraph","Properties":{"id":"20240802084826-me60j7q","updated":"20240802084857"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：益母草未开花时跟艾草较为相似，注意甄别；"}]},{"ID":"20240616090429-7s8bk5e","Type":"NodeThematicBreak","Properties":{"id":"20240616090429-7s8bk5e"}},{"ID":"20240616090430-0pmk92j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090430-0pmk92j","updated":"20240616090437"},"Children":[{"Type":"NodeText","Data":"茺蔚子《千金翼方》"}]},{"ID":"20240616090430-9jtm1ca","Type":"NodeParagraph","Properties":{"id":"20240616090430-9jtm1ca","updated":"20240616090430"},"Children":[{"Type":"NodeText","Data":"味辛甘，微温，微寒，无毒。主明目，益精，除水气。疗血逆，大热，头痛，心烦。久服轻身。"}]},{"ID":"20240616090445-yyljea2","Type":"NodeThematicBreak","Properties":{"id":"20240616090445-yyljea2"}},{"ID":"20240616090446-lcrnwr5","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240616090446-lcrnwr5","updated":"20240616090450"},"Children":[{"Type":"NodeText","Data":"茺蔚《本经逢原》"}]},{"ID":"20240616090446-kqdikj4","Type":"NodeParagraph","Properties":{"id":"20240616090446-kqdikj4","updated":"20240616090446"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俗名益母"}]},{"ID":"20240616090446-9yk1e99","Type":"NodeParagraph","Properties":{"id":"20240616090446-9yk1e99","updated":"20240616090446"},"Children":[{"Type":"NodeText","Data":"辛甘微温，无毒。忌犯铁器。其子微炒香。蒸熟烈日曝燥杵，去壳用。"}]},{"ID":"20240616090446-8ydmwrb","Type":"NodeParagraph","Properties":{"id":"20240616090446-8ydmwrb","updated":"20240616090446"},"Children":[{"Type":"NodeText","Data":"《本经》茺蔚子明目益精，除水气，茎治瘾疹，可作浴汤。"}]},{"ID":"20240616090446-fk4elos","Type":"NodeParagraph","Properties":{"id":"20240616090446-fk4elos","updated":"20240616090446"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"茺蔚入手少阴、足厥阴血分，活血行气，有补阴之功。凡胎前产后所恃者血气也，胎前无滞，产后无虚，以其行中有补也。然所谓补者，是散其瘀而营血受荫，非补养血气之谓。《丹方》以益母之叶阴干，拌童便、陈酒九蒸九晒，入四物汤料为丸，治产后诸证。"}]},{"ID":"20240616090446-qfan5gy","Type":"NodeParagraph","Properties":{"id":"20240616090446-qfan5gy","updated":"20240616090446"},"Children":[{"Type":"NodeText","Data":"但功专行血，故崩漏下血，若脾胃不实，大肠不固者勿用，为其性下行也。近世治番痧，腹痛呕逆，用以浓煎，少加生蜜放温，恣饮有效，取其能散恶血也。其子能明目，功专益精利水，水亏而瞳子收小者宜之。若火盛瞳子散大者切忌，为其辛散能助火邪也。白花者名錾菜，嫩苗可食，故谓之菜。藏器主产后腹痛。今人治白带用一味为末，服之大效。"}]},{"ID":"20240616090355-zu165vk","Type":"NodeThematicBreak","Properties":{"id":"20240616090355-zu165vk"}},{"ID":"20240616090356-mt3tuwy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090356-mt3tuwy","updated":"20240616090401"},"Children":[{"Type":"NodeText","Data":"茺蔚子《医学入门》"}]},{"ID":"20240616090356-ojhc4o1","Type":"NodeParagraph","Properties":{"id":"20240616090356-ojhc4o1","updated":"20240616090356"},"Children":[{"Type":"NodeText","Data":"茺蔚子味甘辛温，行血养血解心烦，逐水去风止损痛，女药称仙号返魂，茎可洗疮花治带，叶敷诸疮可无痕。"}]},{"ID":"20240616090356-feffyi7","Type":"NodeParagraph","Properties":{"id":"20240616090356-feffyi7","updated":"20240616090356"},"Children":[{"Type":"NodeText","Data":"茺，充实也；蔚，盛貌。无毒。善行瘀血，养新血。治血逆心烦，益心力，逐水气浮肿，去风热疮毒。"}]},{"ID":"20240616090356-z878i5r","Type":"NodeParagraph","Properties":{"id":"20240616090356-z878i5r","updated":"20240616090356"},"Children":[{"Type":"NodeText","Data":"治折伤内损有瘀，天阴则痛。兼能明目养精，除大热头痛。一名益母者，善救胎前因热病子死腹中，难产，产后血胀血晕，产前诸疾，求嗣调经，无所不效，故曰妇人仙药。单用煎膏，号曰返魂丹，详七卷。茎，煎汤，洗瘾疹瘙痒；若初生小儿浴之，不生疮疥。花，治妇人赤白带下，每末二钱，空心温汤下。叶，治小儿疳痢垂死、大人痔疮，煮粥或取汁饮之。疔肿、乳痛、丹毒、诸恶疮疖、蛇毒，已破未破，捣汁内服、外敷。"}]},{"ID":"20240616090356-wdfpqz9","Type":"NodeParagraph","Properties":{"id":"20240616090356-wdfpqz9","updated":"20240616090356"},"Children":[{"Type":"NodeText","Data":"面上风刺。为末，用面汤调，烧灰涂之。亦制硫黄。子、苗，入洗面药，令光泽。小儿 耳，取汁滴之。治马咬，和醋炒为末封之。初春亦可取作菜食。治病，花、茎、子、叶同功。"}]},{"ID":"20240616090345-g56mth7","Type":"NodeThematicBreak","Properties":{"id":"20240616090345-g56mth7"}},{"ID":"20240616090346-a24hacf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090346-a24hacf","updated":"20240616090350"},"Children":[{"Type":"NodeText","Data":"茺蔚子《名医别录》"}]},{"ID":"20240616090346-b2ledfl","Type":"NodeParagraph","Properties":{"id":"20240616090346-b2ledfl","updated":"20240616090346"},"Children":[{"Type":"NodeText","Data":"味甘，微寒，无毒，主治血逆大热，头痛，心烦．一名贞蔚．生海滨．五月采．"}]},{"ID":"20240616090346-iktso9s","Type":"NodeParagraph","Properties":{"id":"20240616090346-iktso9s","updated":"20240616090346"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶充蔚子，味辛，微温．主明目，益精，除水气．久服轻身．茎，主瘾疹痒，"}]},{"ID":"20240616090636-tmk6pkh","Type":"NodeThematicBreak","Properties":{"id":"20240616090636-tmk6pkh"}},{"ID":"20240616090637-35g9ot1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090637-35g9ot1","updated":"20240616090640"},"Children":[{"Type":"NodeText","Data":"茺蔚子《本草衍义》"}]},{"ID":"20240616090637-ccayctn","Type":"NodeParagraph","Properties":{"id":"20240616090637-ccayctn","updated":"20240616090637"},"Children":[{"Type":"NodeText","Data":"叶至初春亦可煮作菜食，凌冬不凋悴。唐武后九烧与灰入紧面药。九烧之义，已具冬灰条中。"}]},{"ID":"20240616090625-fotz2xt","Type":"NodeThematicBreak","Properties":{"id":"20240616090625-fotz2xt"}},{"ID":"20240616090627-xqtkabe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090627-xqtkabe","updated":"20240616090631"},"Children":[{"Type":"NodeText","Data":"茺蔚子《增广和剂局方药性总论》"}]},{"ID":"20240616090627-889aszw","Type":"NodeParagraph","Properties":{"id":"20240616090627-889aszw","updated":"20240616090627"},"Children":[{"Type":"NodeText","Data":"味辛甘，微温，微寒、无毒。主明目，益精，除水气，疗血逆，大热头痛心烦。日云∶治产后血胀，及治勒乳痛成痈。一云∶治折伤瘀血及小儿疳痢、痔疾。茎∶主瘾疹可作汤浴之。一名益母，一名益明，生海滨池泽，五月采。一云∶捣茎敷疔肿，服汁内消，又下子死腹中。"}]},{"ID":"20240616090615-55rarxu","Type":"NodeThematicBreak","Properties":{"id":"20240616090615-55rarxu"}},{"ID":"20240616090616-jjqwxaf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090616-jjqwxaf","updated":"20240616090620"},"Children":[{"Type":"NodeText","Data":"茺蔚子《新修本草》"}]},{"ID":"20240616090616-5qtv8f0","Type":"NodeParagraph","Properties":{"id":"20240616090616-5qtv8f0","updated":"20240616090616"},"Children":[{"Type":"NodeText","Data":"味辛、甘，微温、微寒，无毒。主明目益精，除水气，疗血逆大热，头痛，心烦。久服轻身。茎，主瘾疹痒，可作浴汤。一名益母，一名益明，一名大札，一名贞蔚。生海滨池泽，五月采。"}]},{"ID":"20240616090616-1a4eg47","Type":"NodeParagraph","Properties":{"id":"20240616090616-1a4eg47","updated":"20240616090616"},"Children":[{"Type":"NodeText","Data":"今处处有。叶如荏，方茎，子形细长三棱。方用亦稀。"}]},{"ID":"20240616090616-vqnsg47","Type":"NodeParagraph","Properties":{"id":"20240616090616-vqnsg47","updated":"20240616090616"},"Children":[{"Type":"NodeText","Data":"〔谨案〕捣茺蔚茎，敷疔肿，服汁使疔肿毒内消。又下子死腹中，主产后血胀闷，诸杂毒肿、丹游等肿。取汁如豆滴耳中，主 耳。中虺蛇毒敷之良。"}]},{"ID":"20240616090602-dw6psj0","Type":"NodeThematicBreak","Properties":{"id":"20240616090602-dw6psj0"}},{"ID":"20240616090603-tqfaa3d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090603-tqfaa3d","updated":"20240616090607"},"Children":[{"Type":"NodeText","Data":"茺蔚《本草简要方》"}]},{"ID":"20240616090603-96emlfh","Type":"NodeParagraph","Properties":{"id":"20240616090603-96emlfh","updated":"20240616090603"},"Children":[{"Type":"NodeText","Data":"子与根茎功用略同。"}]},{"ID":"20240616090603-oab9xtj","Type":"NodeParagraph","Properties":{"id":"20240616090603-oab9xtj","updated":"20240616090603"},"Children":[{"Type":"NodeText","Data":"主治。通血脉。治血逆。妇女一切子宫病。子又能治目疾。济阴返魂丹。在端午小暑茺蔚开花时。连根采取阴干。忌铁器。以石器研末蜜丸梧子大。每服五七十丸。治妇人胎前产后诸病。今皆捣汁滤净熬膏。名益母膏。胎前脐腹痛或作声者。米汤下。胎前产后脐腹刺痛。"}]},{"ID":"20240616090603-2lmzzxd","Type":"NodeParagraph","Properties":{"id":"20240616090603-2lmzzxd","updated":"20240616090603"},"Children":[{"Type":"NodeText","Data":"胎动不安。下血不止。当归汤下。产后以童便化下。能调顺百病胎衣不下死胎不出。炒盐汤下。产后血晕口渴烦闷。童便和酒下。产后恶血脐腹奔痛。时发寒热有冷汗心烦。童便和酒下。或薄荷自然汁下。产后血水不止。枣汤下。产后血崩漏下。糯米汤下。月水不调。妇人无子。温酒下。"}]},{"ID":"20240616090603-krrfu39","Type":"NodeParagraph","Properties":{"id":"20240616090603-krrfu39","updated":"20240616090603"},"Children":[{"Type":"NodeText","Data":"煎益母膏法。三月中连根叶采茺蔚洗净。箔上摊曝水干。以竹刀切长五寸许。置大沙锅中。水浸过二三寸。煎至草烂。水减三之二。漉去草。取汁约五六斗。入盆中澄半日。再滤去滓。以清汁入釜中。慢火煎取一斗如稀饧状。瓷瓶封收待用。茺蔚子丸。茺蔚子泽泻各五钱。枸杞子青葙子枳壳（麸炒）生地（焙）各一两。麦冬（去心焙）细辛石决明车前子各二两。"}]},{"ID":"20240616090603-60b5ura","Type":"NodeParagraph","Properties":{"id":"20240616090603-60b5ura","updated":"20240616090603"},"Children":[{"Type":"NodeText","Data":"黄连三两。研末蜜丸梧子大。每服三十丸。食后浆水下。治时气后目昏暗及有翳膜。"}]},{"ID":"20240616090603-u694j82","Type":"NodeParagraph","Properties":{"id":"20240616090603-u694j82","updated":"20240616090603"},"Children":[{"Type":"NodeText","Data":"干霍乱腹痛骤发。现深赤斑。用益母草浓煎。加生白蜜少许。放温恣服。或加生姜莱菔汁半杯。"}]},{"ID":"20240616090547-4cctm48","Type":"NodeThematicBreak","Properties":{"id":"20240616090547-4cctm48"}},{"ID":"20240616090548-u3nersv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090548-u3nersv","updated":"20240616090556"},"Children":[{"Type":"NodeText","Data":"茺蔚《本草述钩元》"}]},{"ID":"20240616090548-oi1zoj2","Type":"NodeParagraph","Properties":{"id":"20240616090548-oi1zoj2","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"即益母草。一名野天麻。亦名夏枯草。古用实。今用草。是物专精在实。取茺盛密蔚之义。用草则舍密从疏矣。（核）生田野近水湿处。二月苗如嫩蒿。入夏渐高三四尺。茎四棱有节。节节生穗。叶尖歧如艾。四五月穗开红紫小花。亦有白者。每萼内细子四粒。色黑褐。有三棱。生时微臭。夏至后茎叶皆枯。其根色白。（又）"}]},{"ID":"20240616090548-3ysgero","Type":"NodeParagraph","Properties":{"id":"20240616090548-3ysgero","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"子"}]},{"ID":"20240616090548-twcl15d","Type":"NodeParagraph","Properties":{"id":"20240616090548-twcl15d","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"味微辛甘。气微温微寒。阴中之阳。手足厥阴经药也。主治益气通血脉。养肝明目。"}]},{"ID":"20240616090548-1heh3zw","Type":"NodeParagraph","Properties":{"id":"20240616090548-1heh3zw","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"调女子经脉。（由于肝气虚而滞者）并崩中带下。（由于肝气有损者）白花者入气分。紫花者入血分。治妇女经脉不调。胎产一切血气诸病。（濒湖）活血行气。有补阴之功。凡胎前产后所恃者血气也。胎前无滞。产后无虚。以其行中有补也。（丹溪）本经首主明目。方书亦止目病之治为多。但血滞目病则宜之。瞳子散大者禁用。目得血而能视。茺蔚子行血甚捷。"}]},{"ID":"20240616090548-hikh8bd","Type":"NodeParagraph","Properties":{"id":"20240616090548-hikh8bd","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"瞳子散大。血不足也。故禁之。非如东垣助火之说。"}]},{"ID":"20240616090548-uu685bz","Type":"NodeParagraph","Properties":{"id":"20240616090548-uu685bz","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"茎根花叶"}]},{"ID":"20240616090548-svtlrc3","Type":"NodeParagraph","Properties":{"id":"20240616090548-svtlrc3","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"茎叶味辛微苦。花味微苦甘。根味甘。主胎前胎动下血。及产难产后胎衣不下。血胀血晕血风等证。并打扑内损瘀血。二便不通。捣汁服。并敷之。消疔肿乳痈丹游等毒。其子补而能行。辛散而兼润。凡治手足厥阴血分风热。明目益精。调女人经脉。则单用子。其根茎花叶专于行。若治肿毒疮疡。消水行血。妇人胎产诸病。则宜并用。茺蔚实作三棱。合于天三生木。得木体之全。大益肝胆者也。十一脏取决于胆。茺蔚之用。自上按下。从内彻外。"}]},{"ID":"20240616090548-b8umzm7","Type":"NodeParagraph","Properties":{"id":"20240616090548-b8umzm7","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"丰美备足。故主上明眼目。下输水气。内益精髓。外固形骸。益母者胎从厥阴始结。产自少阳发伸。娠前娠后。靡不恃肝胆为主持。种种功力。悉以充肝之用。蔚木之体尔。（子由）禀地中之阳气。而兼感乎上天春夏之气。亦阳草也。（仲淳）午月五日。采紫花益母草捣汁。"}]},{"ID":"20240616090548-6we9cif","Type":"NodeParagraph","Properties":{"id":"20240616090548-6we9cif","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"分贮瓷器内。各少许。晒干剔取。和蜂蜜封固。加人参琥珀乳香没药血竭沉香丹砂五灵脂。"}]},{"ID":"20240616090548-o7fm5on","Type":"NodeParagraph","Properties":{"id":"20240616090548-o7fm5on","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"主催生及胞衣不下神效。兼治产后血晕。瘀血薄心。恶露不行腹痛。少腹儿枕痛。又能调经。"}]},{"ID":"20240616090548-tpgr4yn","Type":"NodeParagraph","Properties":{"id":"20240616090548-tpgr4yn","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"治血闭经阻。经行作痛。单用和童便服。能下死胎。及治热入血室。发热烦躁。类伤寒。同四物阿胶续断杜仲为丸。安胎止痛。得生地白芍麦冬枇杷叶青蒿子五味子阿胶。治血热经行先期。及胎漏下血。同生甘菊苍耳草金银花紫地丁各一握。贝母大力子白芷白芨白蔹僵蚕生地连翘生甘草各三钱。熬夏枯草汁和药。浓煎顿饮。消一切疔肿发背。及无名肿毒。济阴丹。"}]},{"ID":"20240616090548-lbtzgyo","Type":"NodeParagraph","Properties":{"id":"20240616090548-lbtzgyo","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"治女子胎前产后诸证。取茺蔚开红紫花者。连根收采阴干。用叶及花子。忌铁器。石臼研为细末。炼蜜丸弹子大。随证用汤使嚼服。其根烧存性为末。酒服。功与黑神散同。其药不限丸数。以愈为度。又可捣汁滤净。熬膏服之。胎前脐腹痛。或作声者。米饮下。胎前产后脐腹刺痛。胎动不安。下血不止。当归汤下。产后用童便化下一丸。能安魂定魄。调顺血气。"}]},{"ID":"20240616090548-s84r8jc","Type":"NodeParagraph","Properties":{"id":"20240616090548-s84r8jc","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"诸病不生。又能破血痛。养脉息。调经络。并温酒下。胎衣不下。及横生死胎。经日胀满。"}]},{"ID":"20240616090548-s0lqb0j","Type":"NodeParagraph","Properties":{"id":"20240616090548-s0lqb0j","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"心闷心痛。并用炒盐汤下。产后血晕。眼黑血热。口渴烦闷。如见鬼神。狂言不省人事。童便和酒化下。产后血结成块。脐腹奔痛。寒热冷汗。面垢颜赤。五心烦热。并用童便酒下。"}]},{"ID":"20240616090548-fwlf8pf","Type":"NodeParagraph","Properties":{"id":"20240616090548-fwlf8pf","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"或薄荷自然汁下。产后恶露不尽。结滞刺痛。上冲心胸满闷。童便酒下。产后血崩漏下。糯米汤下。产后泻血水。枣汤下。产后痢疾。米汤下。产后赤白带下。胶艾汤下。产后中风。"}]},{"ID":"20240616090548-hk6n70s","Type":"NodeParagraph","Properties":{"id":"20240616090548-hk6n70s","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"牙关紧急。半身不遂。失音不语。童便酒下。产后气喘咳嗽。胸膈不利。恶心吐酸。面目浮肿。两胁疼痛。举动失力。温酒下。产后月内。咳嗽自汗发热。久则变为骨蒸。童便酒下。"}]},{"ID":"20240616090548-jodrj28","Type":"NodeParagraph","Properties":{"id":"20240616090548-jodrj28","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"产后鼻衄舌黑口干。童便酒下。产后两太阳穴痛。呵欠心忪。气短羸瘦。不思饮食。血风身热。手足顽麻。百节疼痛。并米饮化下。产后大小便不通。烦躁口苦者。薄荷汤下。月水不调。温酒下。久无子息。温酒下。"}]},{"ID":"20240616090548-edt6g4q","Type":"NodeParagraph","Properties":{"id":"20240616090548-edt6g4q","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"〔论〕茺蔚春生夏荣。其茎节节生穗。夏至后茎叶皆枯。是则生成在春。蕃秀在夏。迨阳盛阴生。便已归根复命矣。所谓备肝木之体用。而茺盛密蔚。初不受降收之气者。古人命名可思也。第子则甘中兼辛。以补而行。（辛甘固无降也）茎叶甘辛而兼苦。苦以泄之。则行之功胜于苦。本经于子。首主明目。（专精于肝）益精。（气盛则精盈）除水气。（气盛则液化血）于茎叶根仅主瘾疹作浴汤。则子之补胜于行。茎叶根之行胜于补。确然明矣。茺蔚与夏枯草同枯于夏。而夏枯草之枯也早。一则以阳气之极而枯。一则不受阴气而枯。况气味之辛甘温与苦寒有异乎。盖茺蔚裕出地之阳。故能生血而致其阳于阴。夏枯草达阴中之阳。"}]},{"ID":"20240616090548-7mffa9o","Type":"NodeParagraph","Properties":{"id":"20240616090548-7mffa9o","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"故能化气而致其阴于阳也。"}]},{"ID":"20240616090548-8fa179j","Type":"NodeParagraph","Properties":{"id":"20240616090548-8fa179j","updated":"20240616090548"},"Children":[{"Type":"NodeText","Data":"辛甘为阳。性善行走。血崩禁用。瞳子散大。禁用。惟热血欲贯瞳仁者。同凉血药用则不忌。（仲淳）〔修治〕子微炒香。或蒸熟晒燥。舂簸去壳。取仁用。花实茎叶。皆忌铁器。以其入肝而畏金也。"}]},{"ID":"20240616090520-172mewe","Type":"NodeThematicBreak","Properties":{"id":"20240616090520-172mewe"}},{"ID":"20240616090521-ub2yqai","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090521-ub2yqai","updated":"20240616090527"},"Children":[{"Type":"NodeText","Data":"茺蔚（益母草）《本草纲目》"}]},{"ID":"20240616090521-q4cl4fm","Type":"NodeParagraph","Properties":{"id":"20240616090521-q4cl4fm","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"「释名」益母、益明、贞蔚、推、野天麻猪麻、郁臭草、苦低草、夏枯草、土质汗。"}]},{"ID":"20240616090521-vra7a7b","Type":"NodeParagraph","Properties":{"id":"20240616090521-vra7a7b","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"「气味」（子）辛、甘、微温、无毒。"}]},{"ID":"20240616090521-mggrgz4","Type":"NodeParagraph","Properties":{"id":"20240616090521-mggrgz4","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"（茎、叶）辛、微温、无毒。"}]},{"ID":"20240616090521-zp1ele6","Type":"NodeParagraph","Properties":{"id":"20240616090521-zp1ele6","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"（花）微苦、甘、无毒。"}]},{"ID":"20240616090521-sxk4q6k","Type":"NodeParagraph","Properties":{"id":"20240616090521-sxk4q6k","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"（根）甘、无毒。"}]},{"ID":"20240616090521-pyp52wf","Type":"NodeParagraph","Properties":{"id":"20240616090521-pyp52wf","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616090521-7eq1t44","Type":"NodeParagraph","Properties":{"id":"20240616090521-7eq1t44","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"1、妇女胎前产后各种疾病。用连根收采的正在开花的益母草，阴干后，取叶及花、子，碾为细末，加炼蜜和丸，如弹子大。每服不限丸数，以病愈为度。如做成梧子大的丸子，则每服为五十至七十丸。服药时，随不同的病症，用不同的汤汁送下：（1）胎前脐腹前或作响，用米汤；（2）腹痛胎动，下血不止，用当归汤；（3）胎衣不下，死胎不下，横生倒产，用炒盐汤；（4）产后晕眼黑。发狂或不省人事，用童便和酒；（5）产后腹痛，时发寒热，出冷汗用童便和酒或薄荷自然汁；（6）产后痢疾，用米汤；（7）产后月经不调，用温酒；（8）产后中风，半身不遂，用童便和酒；（9）产后气喘咳嗽，面目浮肿，用温酒；（10）产后流鼻血，舌黑口干，用童便和酒；（11）产后大小便不通，烦躁口苦，用薄荷汤；（12）妇女久无子息，用温酒。此方名“济阴近魂丹”。"}]},{"ID":"20240616090521-ku3oezp","Type":"NodeParagraph","Properties":{"id":"20240616090521-ku3oezp","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"2、产妇诸疾及内脏受伤瘀血等下。用益母草全草洗净，竹刀（忌铁刀）切为小段，不中煮烂，去草取汁，约得五、六斗。澄清半日后，滤去浊渣，以清汁在慢火上煎成一斗状如糖稀。收存瓶中。每取一杯，和酒内服。一天两次，此方名“益母膏”。"}]},{"ID":"20240616090521-ho0zjxp","Type":"NodeParagraph","Properties":{"id":"20240616090521-ho0zjxp","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"3、尿血。用益母草捣汁服一升。"}]},{"ID":"20240616090521-bfur0b6","Type":"NodeParagraph","Properties":{"id":"20240616090521-bfur0b6","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"4、赤白痢。用益母草（晒干）、陈盐梅（烧存性），等分为末。每服三钱，白痢以干姜汤、赤痢以甘草汤关定。此方名“二灵散”。"}]},{"ID":"20240616090521-1oeq7ah","Type":"NodeParagraph","Properties":{"id":"20240616090521-1oeq7ah","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"5、小儿疳痢。用益母草嫩叶同米煮粥吃。到病愈为止。常服嫩叶汁亦可。"}]},{"ID":"20240616090521-evklsbw","Type":"NodeParagraph","Properties":{"id":"20240616090521-evklsbw","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"6、痔疮下因。用益母草叶捣汁服。"}]},{"ID":"20240616090521-k1zf97x","Type":"NodeParagraph","Properties":{"id":"20240616090521-k1zf97x","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"7、各种痈疮（妇女乳痈、小儿头疮，黄烂熟疮、疥疽阴蚀等）。用益母草切五升，加水一斗半，煮成一头号，分几次洗名贵怍。"}]},{"ID":"20240616090521-ty1bqaj","Type":"NodeParagraph","Properties":{"id":"20240616090521-ty1bqaj","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"8、各种疔疮。用益母草捣烂封疮，另取益母草绞汁内服。又方：益母草，烧存性。先用刀划破疔根，挤出血，然后挑药入疔内，疔深者，用捻子把药送入底部。过一会，有污血流出，拭净，再次上药，直到看见红血乃止。一、二日后，根烂出，以针挑去，再敷上药，不久，合口自愈。"}]},{"ID":"20240616090521-xnyvvc0","Type":"NodeParagraph","Properties":{"id":"20240616090521-xnyvvc0","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"9、喉闭肿痛。用益母草捣烂，加新汲水一碗，绞出浓汁一次饮下。冬月用益母草根。"}]},{"ID":"20240616090521-mmffuc0","Type":"NodeParagraph","Properties":{"id":"20240616090521-mmffuc0","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"10、耳。用益母茎叶榨汁滴耳内。"}]},{"ID":"20240616090521-6pbmwd7","Type":"NodeParagraph","Properties":{"id":"20240616090521-6pbmwd7","updated":"20240616090521"},"Children":[{"Type":"NodeText","Data":"11、作洗婴汤。儿将生，先取益母草五两煎汤，儿生下后，即用此汤洗浴，可预防生疮生疥。"}]},{"ID":"20240616090417-pon0xp1","Type":"NodeThematicBreak","Properties":{"id":"20240616090417-pon0xp1"}},{"ID":"20240616090418-z5wsa87","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090418-z5wsa87","updated":"20240616090422"},"Children":[{"Type":"NodeText","Data":"茺蔚子《得配本草》"}]},{"ID":"20240616090418-xm4b4m7","Type":"NodeParagraph","Properties":{"id":"20240616090418-xm4b4m7","updated":"20240616090418"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即益母子"}]},{"ID":"20240616090418-xblsdz7","Type":"NodeParagraph","Properties":{"id":"20240616090418-xblsdz7","updated":"20240616090418"},"Children":[{"Type":"NodeText","Data":"制硫黄、砒石。"}]},{"ID":"20240616090418-hhy2fbc","Type":"NodeParagraph","Properties":{"id":"20240616090418-hhy2fbc","updated":"20240616090418"},"Children":[{"Type":"NodeText","Data":"辛、甘、微温。入足厥阴经血分。除风热，明眼目，调经水，惟子为良。治疮肿，消水气，行郁血，茎叶为良。"}]},{"ID":"20240616090418-hcldvfu","Type":"NodeParagraph","Properties":{"id":"20240616090418-hcldvfu","updated":"20240616090418"},"Children":[{"Type":"NodeText","Data":"或炒用，或蒸熟烈日晒燥用。禁用与益母草同。"}]},{"ID":"20240616090408-h8u3lwg","Type":"NodeThematicBreak","Properties":{"id":"20240616090408-h8u3lwg"}},{"ID":"20240616090409-y32zjjb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090409-y32zjjb","updated":"20240616090413"},"Children":[{"Type":"NodeText","Data":"茺蔚子《神农本草经赞》"}]},{"ID":"20240616090409-c1vf095","Type":"NodeParagraph","Properties":{"id":"20240616090409-c1vf095","updated":"20240616090409"},"Children":[{"Type":"NodeText","Data":"味辛微温。主明目益精。除水气。久服轻身。茎主瘾疹痒。可作浴汤。一名益母。"}]},{"ID":"20240616090409-wo1xfmc","Type":"NodeParagraph","Properties":{"id":"20240616090409-wo1xfmc","updated":"20240616090409"},"Children":[{"Type":"NodeText","Data":"一名大札。生池泽。"}]},{"ID":"20240616090409-mzj77ba","Type":"NodeParagraph","Properties":{"id":"20240616090409-mzj77ba","updated":"20240616090409"},"Children":[{"Type":"NodeText","Data":"诗有。施于中谷。植茂春融。枯摧夏燠。括目益明。澡身具浴。用利坤贞。载生载育。"}]},{"ID":"20240616090409-49klhyk","Type":"NodeParagraph","Properties":{"id":"20240616090409-49klhyk","updated":"20240616090409"},"Children":[{"Type":"NodeText","Data":"诗注。有。也。即今益母草。诗。施于中谷。李时珍曰。春初生苗。夏至后即枯。"}]},{"ID":"20240616090409-1mc5kdf","Type":"NodeParagraph","Properties":{"id":"20240616090409-1mc5kdf","updated":"20240616090409"},"Children":[{"Type":"NodeText","Data":"其功宜于妇人。易注。坤贞之所利。诗。载生载育。"}]},{"ID":"20240616090334-px96okr","Type":"NodeThematicBreak","Properties":{"id":"20240616090334-px96okr"}},{"ID":"20240616090336-75aoiff","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090336-75aoiff","updated":"20240616090339"},"Children":[{"Type":"NodeText","Data":"茺蔚子《本草崇原》"}]},{"ID":"20240616090336-dv3ckuh","Type":"NodeParagraph","Properties":{"id":"20240616090336-dv3ckuh","updated":"20240616090336"},"Children":[{"Type":"NodeText","Data":"气味辛甘，微温，无毒。主明目，益精，除水气。久服轻身。"}]},{"ID":"20240616090336-0r8wzse","Type":"NodeParagraph","Properties":{"id":"20240616090336-0r8wzse","updated":"20240616090336"},"Children":[{"Type":"NodeText","Data":"（茺蔚《本经》名益母，又名益明。《尔雅》名 。今处处有之，近水湿处甚繁。春生苗如嫩蒿，入夏长三四尺，其茎方，其叶如艾，节节生穗，充盛蔚密，故名茺蔚。五月采穗，九月采子，每萼内有细子四粒，色黑褐。）"}]},{"ID":"20240616090336-zvr1pln","Type":"NodeParagraph","Properties":{"id":"20240616090336-zvr1pln","updated":"20240616090336"},"Children":[{"Type":"NodeText","Data":"茺蔚茎叶甘寒，子辛温。《本经》辛甘微温，概苗实而言也。茎方子黑，喜生湿地，禀水土之气化，明目益精，得水气也。除水气，土气盛也。久服则精气充尉，故轻身。"}]},{"ID":"20240616090325-jkr6xnc","Type":"NodeThematicBreak","Properties":{"id":"20240616090325-jkr6xnc"}},{"ID":"20240616090326-6qgtjrx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090326-6qgtjrx","updated":"20240616090330"},"Children":[{"Type":"NodeText","Data":"茺蔚子《本草经集注》"}]},{"ID":"20240616090326-i2y8ssy","Type":"NodeParagraph","Properties":{"id":"20240616090326-i2y8ssy","updated":"20240616090326"},"Children":[{"Type":"NodeText","Data":"味辛、甘，微温、微寒，无毒。主明目，益精，除水气。治血逆大热，头痛，心烦。久服轻身。茎∶主治瘾疹痒，可作浴汤。一名益母，一名益明，一名大札，一名贞蔚。生海滨池泽，五月采。"}]},{"ID":"20240616090326-l8u7iin","Type":"NodeParagraph","Properties":{"id":"20240616090326-l8u7iin","updated":"20240616090326"},"Children":[{"Type":"NodeText","Data":"今处处有。叶如荏，方茎，子形细长三棱。方用亦稀。"}]},{"ID":"20240616090314-5rfafll","Type":"NodeThematicBreak","Properties":{"id":"20240616090314-5rfafll"}},{"ID":"20240616090315-b8kzsws","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090315-b8kzsws","updated":"20240616090318"},"Children":[{"Type":"NodeText","Data":"茺蔚子《千金翼方》"}]},{"ID":"20240616090315-oltg7kz","Type":"NodeParagraph","Properties":{"id":"20240616090315-oltg7kz","updated":"20240616090315"},"Children":[{"Type":"NodeText","Data":"味辛甘，微温，微寒，无毒。主明目，益精，除水气。疗血逆，大热，头痛，心烦。久服轻身。"}]},{"ID":"20240616090315-xpcbbgu","Type":"NodeParagraph","Properties":{"id":"20240616090315-xpcbbgu","updated":"20240616090315"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎"}]},{"ID":"20240616090315-iuvp88z","Type":"NodeParagraph","Properties":{"id":"20240616090315-iuvp88z","updated":"20240616090315"},"Children":[{"Type":"NodeText","Data":"主瘾疹痒，可作浴汤。一名益母，一名益明，一名大札，一名贞蔚。生海滨池泽，五月采。"}]},{"ID":"20240616090302-vvqyzao","Type":"NodeThematicBreak","Properties":{"id":"20240616090302-vvqyzao"}},{"ID":"20240616090303-x72sj41","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090303-x72sj41","updated":"20240616090309"},"Children":[{"Type":"NodeText","Data":"茺蔚子《本草图经》"}]},{"ID":"20240616090303-w10qyar","Type":"NodeParagraph","Properties":{"id":"20240616090303-w10qyar","updated":"20240616090305"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"茺蔚子"},{"Type":"NodeText","Data":"，生海滨池泽，今处处有之。谨按《毛诗》云∶中谷有 （他回切）。《尔雅》云∶萑（音佳）， 。郭璞云∶今茺蔚也。叶似荏，方茎白华，华生节间。陆机云∶《韩诗》及《三苍》皆云∶ ，益母也。故曾子见之感恩。刘歆亦谓∶ ，臭秽。臭秽即茺蔚也。今园圃及田野见者极多，形色皆如郭说。而苗叶上节节生花，实似鸡冠，子黑色，茎作四方棱。五月采。又云九月采实，医方中稀见用实者。唐天后炼益母草泽面法，五月五日采根苗具者，勿令着土，曝干捣罗，以水和之。令极熟，团之如鸡子大，再曝，仍作一炉，四曝开窍，上下置火。安药中央，大火烧一炊，久即去大火，留小火养之，勿令绝。经一伏时出之，瓷器中研治下筛，再研，三日收之，使如澡豆法。《广济方》疗小儿疳痢困垂死者，取益母草煮食之，取足，瘥止，甚佳。韦丹治女子因热病，胎死腹中，捣此草并苗，令熟，以少许暖水和，绞取汁，顿服，良。又主难产，捣取汁七大合，煎半，顿服，立下。无新者，以干者一大握，水七合，煎服。又名郁臭草，又名苦低草。亦主马啮，细切此草，和醋炒，敷之良。"}]},{"ID":"20240607095543-ljmow48","Type":"NodeThematicBreak","Properties":{"id":"20240607095543-ljmow48"}},{"ID":"20240607095544-gdrfh6u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095544-gdrfh6u","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"《中国药典》：茺蔚子"}]},{"ID":"20240607095544-g6barv9","Type":"NodeParagraph","Properties":{"id":"20240607095544-g6barv9","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095544-dnlnjrk","Type":"NodeParagraph","Properties":{"id":"20240607095544-dnlnjrk","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" Chōnɡ Wèi Zǐ"}]},{"ID":"20240607095544-sm89z9o","Type":"NodeParagraph","Properties":{"id":"20240607095544-sm89z9o","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607095544-iskwpsr","Type":"NodeParagraph","Properties":{"id":"20240607095544-iskwpsr","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" FRUCTUS LEONURI"}]},{"ID":"20240607095544-w5z8r8o","Type":"NodeParagraph","Properties":{"id":"20240607095544-w5z8r8o","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095544-zavqlrx","Type":"NodeParagraph","Properties":{"id":"20240607095544-zavqlrx","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 本品为唇形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"益母草"},{"Type":"NodeText","Data":"Leonurus japonicus Houtt.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。秋季果实成熟时采割地上部分，晒干，打下果实，除去杂质。"}]},{"ID":"20240607095544-8ofonx1","Type":"NodeParagraph","Properties":{"id":"20240607095544-8ofonx1","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095544-dq2wgpa","Type":"NodeParagraph","Properties":{"id":"20240607095544-dq2wgpa","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 本品呈三棱形，长2～3mm，宽约1.5mm。表面灰棕色至灰褐色，有深色斑点，一端稍宽，平截状，另一端渐窄而钝尖。果皮薄，子叶类白色，富油性。无臭，味苦。"}]},{"ID":"20240607095544-tirutyi","Type":"NodeParagraph","Properties":{"id":"20240607095544-tirutyi","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607095544-7e481jp","Type":"NodeParagraph","Properties":{"id":"20240607095544-7e481jp","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240607095544-biooo5z","Type":"NodeParagraph","Properties":{"id":"20240607095544-biooo5z","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095544-0tc2gpd","Type":"NodeParagraph","Properties":{"id":"20240607095544-0tc2gpd","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茺蔚子"},{"Type":"NodeText","Data":"：除去杂质，洗净，干燥。"}]},{"ID":"20240607095544-84qvo1d","Type":"NodeParagraph","Properties":{"id":"20240607095544-84qvo1d","updated":"20240607095544"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒茺蔚子"},{"Type":"NodeText","Data":"：取净茺蔚子，照清炒法（附录Ⅱ D）炒至有爆声。"}]},{"ID":"20240607095544-3tu7hg8","Type":"NodeParagraph","Properties":{"id":"20240607095544-3tu7hg8","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607095544-e92ip9g","Type":"NodeParagraph","Properties":{"id":"20240607095544-e92ip9g","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 本品粉末黄棕色至深棕色。外果皮细胞横断面观略径向延长，长度不一，形成多数隆起的脊，脊中央为黄色网纹细胞，壁非木化；表面观类多角形，有条状角质纹理，网纹细胞具条状增厚壁。内果皮厚壁细胞断面观略切向延长，界限不甚明显，内壁极厚，外壁薄，胞腔偏靠外侧，内含草酸钙方晶；表面观呈星状或细胞界限不明显，方晶明显。中果皮细胞表面观类多角形，壁薄，细波状弯曲。种皮表皮细胞类方形，壁稍厚，略波状弯曲，胞腔内含淡黄棕色物，内胚乳细胞含脂肪油滴及糊粉粒。"}]},{"ID":"20240607095544-tpexypj","Type":"NodeParagraph","Properties":{"id":"20240607095544-tpexypj","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095544-uhj0it9","Type":"NodeParagraph","Properties":{"id":"20240607095544-uhj0it9","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 归心包、肝经。"}]},{"ID":"20240607095544-94qzyxc","Type":"NodeParagraph","Properties":{"id":"20240607095544-94qzyxc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095544-vs9hezu","Type":"NodeParagraph","Properties":{"id":"20240607095544-vs9hezu","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 辛、苦，微寒。"}]},{"ID":"20240607095544-mb8aia4","Type":"NodeParagraph","Properties":{"id":"20240607095544-mb8aia4","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095544-srsqziv","Type":"NodeParagraph","Properties":{"id":"20240607095544-srsqziv","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 瞳孔散大者慎用。"}]},{"ID":"20240607095544-6y33kyj","Type":"NodeParagraph","Properties":{"id":"20240607095544-6y33kyj","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095544-bra1sf7","Type":"NodeParagraph","Properties":{"id":"20240607095544-bra1sf7","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 活血调经，清肝明目。用于月经不调，经闭，痛经，目赤翳障，头晕胀痛。"}]},{"ID":"20240607095544-axabsob","Type":"NodeParagraph","Properties":{"id":"20240607095544-axabsob","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095544-735rnac","Type":"NodeParagraph","Properties":{"id":"20240607095544-735rnac","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 4.5～9g。"}]},{"ID":"20240607095544-ofz32yf","Type":"NodeParagraph","Properties":{"id":"20240607095544-ofz32yf","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607095544-mk06vqd","Type":"NodeParagraph","Properties":{"id":"20240607095544-mk06vqd","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" （1）有报导"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茺蔚子"},{"Type":"NodeText","Data":"炒熟研粉，一次服30克可引起中毒，服后4～6小时出现胸闷无力，全身酸痛，下肢不能活动等症状。"}]},{"ID":"20240607095544-pybiv9h","Type":"NodeParagraph","Properties":{"id":"20240607095544-pybiv9h","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095544-xm3glyc","Type":"NodeParagraph","Properties":{"id":"20240607095544-xm3glyc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607095544-eft69r9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095544-eft69r9","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：茺蔚子"}]},{"ID":"20240607095544-ttp3xmr","Type":"NodeParagraph","Properties":{"id":"20240607095544-ttp3xmr","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095544-0p7xi1w","Type":"NodeParagraph","Properties":{"id":"20240607095544-0p7xi1w","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" Chōnɡ Wèi Zǐ"}]},{"ID":"20240607095544-jf90chy","Type":"NodeParagraph","Properties":{"id":"20240607095544-jf90chy","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095544-lliixh2","Type":"NodeParagraph","Properties":{"id":"20240607095544-lliixh2","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 益母草子、苦草子、小胡麻（《江苏药材志》），野黄麻、六角天麻（《浙江民间常用草药》）、茺玉子（《河北药材》）。"}]},{"ID":"20240607095544-hj8d2ni","Type":"NodeParagraph","Properties":{"id":"20240607095544-hj8d2ni","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607095544-c7086al","Type":"NodeParagraph","Properties":{"id":"20240607095544-c7086al","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607095544-54onf0l","Type":"NodeParagraph","Properties":{"id":"20240607095544-54onf0l","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095544-mrgzkpy","Type":"NodeParagraph","Properties":{"id":"20240607095544-mrgzkpy","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 为唇形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"益母草"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。8～10月果实成熟时割取全株，晒干，打下果实，拣去枝叶，筛净杂质。"}]},{"ID":"20240607095544-gg2hodl","Type":"NodeParagraph","Properties":{"id":"20240607095544-gg2hodl","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607095544-nx7kybc","Type":"NodeParagraph","Properties":{"id":"20240607095544-nx7kybc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 全国大部地区均产。"}]},{"ID":"20240607095544-4g95way","Type":"NodeParagraph","Properties":{"id":"20240607095544-4g95way","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095544-b6kbp99","Type":"NodeParagraph","Properties":{"id":"20240607095544-b6kbp99","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 干燥果实呈三棱形，一端稍宽，似平截状；另一端渐窄而钝尖，长2～3毫米，宽约1.5毫米。表面灰棕色，具深色斑点，无光泽，或微粗糙。横切面呈三角形。在放大镜下观察，可见外皮棕黑色；胚乳极薄，灰色，附着于种皮上；子叶灰白色，油质。气无，味苦。以粒大饱满、无杂质者为佳。"}]},{"ID":"20240607095544-tymtpeq","Type":"NodeParagraph","Properties":{"id":"20240607095544-tymtpeq","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607095544-lvie19b","Type":"NodeParagraph","Properties":{"id":"20240607095544-lvie19b","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 服食大量的茺蔚子后可发生中毒。据25例报告，一般服食20～30克后即可于4～10小时发病；但亦有人在10天内连续服至500克而始发病的。临床中毒症状为突然全身无力，下肢不能活动呈瘫痪状态，但神志、言语清楚，苔脉多正常。经中西医综合治疗均获恢复，无1例死亡。"}]},{"ID":"20240607095544-zowrwez","Type":"NodeParagraph","Properties":{"id":"20240607095544-zowrwez","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607095544-vln2vv7","Type":"NodeParagraph","Properties":{"id":"20240607095544-vln2vv7","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 茺蔚子含有益母草宁。含油37.02％。茺蔚子油中油酸占63.75％，亚麻酸占21.13％。茺蔚子含维生素A类物质，其含量按维生素A计算为0.0439％。"}]},{"ID":"20240607095544-iscwywp","Type":"NodeParagraph","Properties":{"id":"20240607095544-iscwywp","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095544-27ij335","Type":"NodeParagraph","Properties":{"id":"20240607095544-27ij335","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 入心胞、肝经。"}]},{"ID":"20240607095544-rap2kja","Type":"NodeParagraph","Properties":{"id":"20240607095544-rap2kja","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"①《纲目》；\"手、足厥阴经。\""}]},{"ID":"20240607095544-kjptryf","Type":"NodeParagraph","Properties":{"id":"20240607095544-kjptryf","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"②《本草经解》:\"入足厥阴肝经、手太阴肺经、足太阴脾经。\""}]},{"ID":"20240607095544-wwgytqn","Type":"NodeParagraph","Properties":{"id":"20240607095544-wwgytqn","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095544-d1av57t","Type":"NodeParagraph","Properties":{"id":"20240607095544-d1av57t","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 甘宰，凉。"}]},{"ID":"20240607095544-3he2ruc","Type":"NodeParagraph","Properties":{"id":"20240607095544-3he2ruc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"味辛，微温。\""}]},{"ID":"20240607095544-uradhr8","Type":"NodeParagraph","Properties":{"id":"20240607095544-uradhr8","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"甘，微寒，无毒。\""}]},{"ID":"20240607095544-q4k9327","Type":"NodeParagraph","Properties":{"id":"20240607095544-q4k9327","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"③《本草从新》:\"味辛微苦，微寒。\""}]},{"ID":"20240607095544-5r5gsv5","Type":"NodeParagraph","Properties":{"id":"20240607095544-5r5gsv5","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095544-qxj49wq","Type":"NodeParagraph","Properties":{"id":"20240607095544-qxj49wq","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 肝血不足，瞳子散大及孕妇忌服。"}]},{"ID":"20240607095544-2uo7wsa","Type":"NodeParagraph","Properties":{"id":"20240607095544-2uo7wsa","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"①《经效产宝》:\"忌铁器。\""}]},{"ID":"20240607095544-kjnuegc","Type":"NodeParagraph","Properties":{"id":"20240607095544-kjnuegc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"②李杲:\"瞳子散大者禁用。\""}]},{"ID":"20240607095544-ez2lc9s","Type":"NodeParagraph","Properties":{"id":"20240607095544-ez2lc9s","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"③《本草经硫》:\"血崩禁用。瞳子散大禁用，惟热血欲贯瞳人者，与凉血药同用则不忌。\""}]},{"ID":"20240607095544-m03rb7g","Type":"NodeParagraph","Properties":{"id":"20240607095544-m03rb7g","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"④《本草从新》:\"非血滞、血热者勿与。\""}]},{"ID":"20240607095544-3dcyax1","Type":"NodeParagraph","Properties":{"id":"20240607095544-3dcyax1","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095544-0dkmggj","Type":"NodeParagraph","Properties":{"id":"20240607095544-0dkmggj","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 活血调经，疏风清热。治妇女月经不调，崩中带下，产后瘀血作痛；肝热头痛，目赤肿痛，或生翳膜。"}]},{"ID":"20240607095544-fykqery","Type":"NodeParagraph","Properties":{"id":"20240607095544-fykqery","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"主明目，益精，除水气。\""}]},{"ID":"20240607095544-ypbr7iu","Type":"NodeParagraph","Properties":{"id":"20240607095544-ypbr7iu","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"疗血逆，大热头痛心烦。\""}]},{"ID":"20240607095544-oou8c69","Type":"NodeParagraph","Properties":{"id":"20240607095544-oou8c69","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》:\"治产后血胀。\""}]},{"ID":"20240607095544-te5lfl4","Type":"NodeParagraph","Properties":{"id":"20240607095544-te5lfl4","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"④《开宝本草》:\"作煎及捣绞取汁服之，下死胎。\""}]},{"ID":"20240607095544-eugbwtx","Type":"NodeParagraph","Properties":{"id":"20240607095544-eugbwtx","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"⑤《日用本草》:\"春仁，生食补中益气，通血脉，填精髓，止渴，润肺。\""}]},{"ID":"20240607095544-xa5bkjo","Type":"NodeParagraph","Properties":{"id":"20240607095544-xa5bkjo","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》:\"治风解热，顺气活血，养肝益心，安魂定魄，调女人经脉，崩中带下，产后胎前诸疾。\""}]},{"ID":"20240607095544-a4qesrz","Type":"NodeParagraph","Properties":{"id":"20240607095544-a4qesrz","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095544-2ih1cl3","Type":"NodeParagraph","Properties":{"id":"20240607095544-2ih1cl3","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 内服:煎汤，2～3钱；或入丸、散。"}]},{"ID":"20240607095544-qcvlojv","Type":"NodeParagraph","Properties":{"id":"20240607095544-qcvlojv","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607095544-0xdxwb2","Type":"NodeParagraph","Properties":{"id":"20240607095544-0xdxwb2","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 治子宫脱垂:茺蔚子五钱，枳壳四钱。水煎服。（《湖南药物志》）"}]},{"ID":"20240607095544-y110sgl","Type":"NodeParagraph","Properties":{"id":"20240607095544-y110sgl","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607095544-9b3ww5h","Type":"NodeParagraph","Properties":{"id":"20240607095544-9b3ww5h","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" ①朱震亨:\"茺蔚子，活血行气，有补阴之功，故名益母。凡胎前产后所恃者，血气也。胎前无滞，产后无虚，以其行中有补也。\""}]},{"ID":"20240607095544-1qkea29","Type":"NodeParagraph","Properties":{"id":"20240607095544-1qkea29","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"②《纲目》:\"茺蔚子，白花者入气分，紫花者入血分。治妇女经脉不调，胎产一切血气诸病，妙品也。而医方鲜知用，时珍常以之同四物、香附诸药治人，获效甚多。盖包络生血，肝藏血，此物能活血补阴，故能明目、益精、调经，治女人诸病也。东垣李氏言瞳子散大者，禁用茺蔚子，为其辛温主散，能助火也。当归虽辛温，而兼苦甘，能和血，故不禁之。愚谓目得血而能视，茺蔚行血甚捷，瞳子散大，血不足也，故禁之，非助火也，血滞病目则宜之，故曰明目。\""}]},{"ID":"20240607095544-x9f7mmu","Type":"NodeParagraph","Properties":{"id":"20240607095544-x9f7mmu","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》:\"茺蔚子，为妇人胎产调经之要药。此药补而能行，辛散而兼润者也。目者，肝之窍也，益肝行血，故明目益精。其气纯阳，辛走而不守，故除水气。肝脏有火则血逆，肝凉则降而顺矣。大热头痛心烦，皆血虚而热之侯也，清肝散热和血，则头痛心烦俱解。\""}]},{"ID":"20240607095544-16i5nn1","Type":"NodeParagraph","Properties":{"id":"20240607095544-16i5nn1","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"④《本草正义》:\"茺蔚，古人止用其子。《本经》之明目益精，则温和养血，而又沉重，直达下焦，故为补益肾阴之用。除水气者，辛温下降，故能通络而逐水。其茎可浴疹痒，则活血疏风之功也。《别录》加以微寒，则亦温亦寒，大是不妥，盖当时以治热症，...疗血逆者，温和行血，又子能重坠下降，故能平逆。惟主大热头痛心烦，则与温养之性不符，存而不论可也。\""}]},{"ID":"20240607095544-2087toq","Type":"NodeParagraph","Properties":{"id":"20240607095544-2087toq","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095544-3jrre08","Type":"NodeParagraph","Properties":{"id":"20240607095544-3jrre08","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607095544-ljecv4x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095544-ljecv4x","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"《中华本草》：茺蔚子"}]},{"ID":"20240607095544-jkj57nh","Type":"NodeParagraph","Properties":{"id":"20240607095544-jkj57nh","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095544-9y1e8uq","Type":"NodeParagraph","Properties":{"id":"20240607095544-9y1e8uq","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" Chōnɡ Wèi Zǐ"}]},{"ID":"20240607095544-kqbygij","Type":"NodeParagraph","Properties":{"id":"20240607095544-kqbygij","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095544-ax3px2r","Type":"NodeParagraph","Properties":{"id":"20240607095544-ax3px2r","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 益母子、冲玉子、益母草子、小胡麻"}]},{"ID":"20240607095544-f2fedjs","Type":"NodeParagraph","Properties":{"id":"20240607095544-f2fedjs","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607095544-jdqfoqi","Type":"NodeParagraph","Properties":{"id":"20240607095544-jdqfoqi","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" Motherwort Fruit"}]},{"ID":"20240607095544-tbm4jn4","Type":"NodeParagraph","Properties":{"id":"20240607095544-tbm4jn4","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607095544-bwfq1ws","Type":"NodeParagraph","Properties":{"id":"20240607095544-bwfq1ws","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》《日华子本草》：益母草子，如鸡冠子，黑色，九月采。"}]},{"ID":"20240607095544-ub6xnzm","Type":"NodeParagraph","Properties":{"id":"20240607095544-ub6xnzm","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095544-nn6t3u4","Type":"NodeParagraph","Properties":{"id":"20240607095544-nn6t3u4","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 药材基源：为唇形科植物益母草的果实。"}]},{"ID":"20240607095544-8fcgl0t","Type":"NodeParagraph","Properties":{"id":"20240607095544-8fcgl0t","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Leonurus japonicus Houtt. Leonurus sibiricus L."}]},{"ID":"20240607095544-vo2u4qm","Type":"NodeParagraph","Properties":{"id":"20240607095544-vo2u4qm","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季在全株花谢、果实成熟时割取全株，晒干，打下果实，除去叶片、杂质。"}]},{"ID":"20240607095544-cyedum3","Type":"NodeParagraph","Properties":{"id":"20240607095544-cyedum3","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607095544-dtsw8ud","Type":"NodeParagraph","Properties":{"id":"20240607095544-dtsw8ud","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 一年生或二年生草本，高60-100cm。茎直立，四棱形，被微毛。叶对生；叶形多种；叶柄长0.5-8cm。一年生植物基生叶具长柄，叶片略呈圆形，直径4-8cm，5-9浅裂，裂片具2-3钝齿，基部心形；茎中部叶有短柄，3全裂，裂片近披针形，中央裂片常再3裂，两侧裂片再1-2裂，最终片宽度通常在3mm以上，先端渐尖，边缘疏生锯齿或近全缘；最上部叶不分裂，，线形，近无柄，上面绿色，被糙伏毛，下面淡绿色，被疏柔毛及腺点。轮伞花序腋生，具花8-15朵；小苞片针刺状，无花梗；花萼钟形，外面贴生微柔毛，先端5齿裂，具刺尖，下方2齿比上方2齿长，宿存；花冠唇形，淡红色或紫红色，长9-12mm，外面被柔毛，上唇与下唇几等长，上唇长圆形，全缘，边缘具纤毛，下唇3裂，中央裂片较大，倒心形；雄蕊4，二强，着生在花冠内面近中部，花丝疏被鳞状毛，花药2室；雌蕊1，子房4裂，花柱丝状，略长于雄蕊，柱头2裂。小坚果褐色，三棱形，先端较宽而平截，基部楔形，长2-2.5mm，直径约1.5mm。花期6-9月，果期7-10月。"}]},{"ID":"20240607095544-oxjsxtb","Type":"NodeParagraph","Properties":{"id":"20240607095544-oxjsxtb","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"一年生或二年生草本，株高达80cm。茎直立，四棱形，有糙伏毛，叶对生。叶柄长0.5-5cm；茎最下部的叶早落，中部的叶卵形，掌状3全裂，长约5cm，宽约4cm，裂片长圆状鞭形，再羽状分裂成3裂的线状小裂片，宽度通常1-3mm；最上部叶明显3裂，小裂片线形，近无柄，上面绿色，疏伞花序腋生，多花；无花梗；小苞片针刺状，比萼筒短，被糙伏毛，花萼钟形，外面被柔毛，先端5齿裂，具尖刺，上方3齿比下方2齿短，宿存。花冠唇形，淡红以或紫红色，长15-20mm，外面密被长柔毛，上唇比下唇长1/4左右，由唇长圆形，全缘，下唇3裂，中央裂片卵形；雄蕊4，二强，着生在花冠内面近中部，花丝疏被鳞状毛，花花2室；雌蕊1，子房4裂，花柱丝状，略长于雄蕊，柱头2裂。小坚果褐色，三棱形，上端较宽而平截，基部楔形，长约2.5mm。花期6-9月，果期7-10月。"}]},{"ID":"20240607095544-csfhsay","Type":"NodeParagraph","Properties":{"id":"20240607095544-csfhsay","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095544-ey1qjmc","Type":"NodeParagraph","Properties":{"id":"20240607095544-ey1qjmc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 小坚果长圆形，具三棱，长2-3mm，直径1-1.5mm，上端平截，下端渐窄，有凹入的果柄痕。表面灰褐色或褐色，有稀疏深色斑点。切面果皮褐色，胚乳、子叶白色，富油质，气微、味苦。"}]},{"ID":"20240607095544-xs91gnn","Type":"NodeParagraph","Properties":{"id":"20240607095544-xs91gnn","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"以粒大、饱满者为佳。"}]},{"ID":"20240607095544-ilxiu1z","Type":"NodeParagraph","Properties":{"id":"20240607095544-ilxiu1z","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果实横切面：外果皮为1列浅黄色径向延长的细胞。中果皮为2-3列类方形薄壁细胞，近内果皮的细胞中含草酸钙方晶。内果皮坚硬，为1列径向延长的石细胞，木化。种皮为1列切向延长的棕色色素细胞。胚乳和子叶细胞含糊粉粒及脂肪油。"}]},{"ID":"20240607095544-nr0k82g","Type":"NodeParagraph","Properties":{"id":"20240607095544-nr0k82g","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607095544-t10m2fy","Type":"NodeParagraph","Properties":{"id":"20240607095544-t10m2fy","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 含益母草宁碱（leonurinine)，水苏碱（stachy-drine)及脂肪油26%，油中主成分为油酸（oleic acid）占油总量的63.75%及亚麻酸（linolenic acid)占21.13%，另含维生素A样物质0.04%[1，2]。"}]},{"ID":"20240607095544-jlp5ob5","Type":"NodeParagraph","Properties":{"id":"20240607095544-jlp5ob5","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607095544-of0ami5","Type":"NodeParagraph","Properties":{"id":"20240607095544-of0ami5","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 1.降压作用 茺蔚子水浸出液或醇-水浸出液对麻醉动静脉注射有轻微降压作用[1]。"}]},{"ID":"20240607095544-ltjwf87","Type":"NodeParagraph","Properties":{"id":"20240607095544-ltjwf87","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"2.毒性 人一次口服茺蔚子30g以上，可于4-6h后出现中毒反应，症状为全射无力，下肢不能活动，财身酸麻疼痛，重者汗多呈虚脱状态[2]。"}]},{"ID":"20240607095544-9labgx5","Type":"NodeParagraph","Properties":{"id":"20240607095544-9labgx5","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607095544-dbosqbe","Type":"NodeParagraph","Properties":{"id":"20240607095544-dbosqbe","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱 取本品粗粉5g，加盐酸甲醇（1：100）液50ml冷浸过夜，滤过，取滤液45ml浓缩，再加入蒸馏水5ml，再次滤过，浓缩后，加正丁醇至2ml，作供试液，另取水苏碱作对照品，分别点样于硅胶G板上，用正丁醇-乙酸乙酯-盐酸（4：0.5：1.5）展开，干后心肝碘化铋钾试剂显色，供试品色谱中在与对照品色谱相应的位置处显相同的橙红色斑点。"}]},{"ID":"20240607095544-fra0lwt","Type":"NodeParagraph","Properties":{"id":"20240607095544-fra0lwt","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095544-4e0228w","Type":"NodeParagraph","Properties":{"id":"20240607095544-4e0228w","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 归肝经"}]},{"ID":"20240607095544-i90792r","Type":"NodeParagraph","Properties":{"id":"20240607095544-i90792r","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095544-ret0pgo","Type":"NodeParagraph","Properties":{"id":"20240607095544-ret0pgo","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 味甘；辛；性微寒；上毒"}]},{"ID":"20240607095544-be7dz6o","Type":"NodeParagraph","Properties":{"id":"20240607095544-be7dz6o","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095544-3au5d8v","Type":"NodeParagraph","Properties":{"id":"20240607095544-3au5d8v","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 肝血不足，瞳子散大及孕妇忌服。"}]},{"ID":"20240607095544-0opsglm","Type":"NodeParagraph","Properties":{"id":"20240607095544-0opsglm","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"1.《经效产宝》：忌铁器。"}]},{"ID":"20240607095544-2fldi5l","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607095544-2fldi5l","updated":"20240607095544"},"Children":[{"ID":"20240607095544-eofw81e","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240607095544-eofw81e","updated":"20240607095544"},"Children":[{"ID":"20240607095544-qvrv46f","Type":"NodeParagraph","Properties":{"id":"20240607095544-qvrv46f","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"李杲：瞳子散大者禁用。"}]}]}]},{"ID":"20240607095544-kjinn71","Type":"NodeParagraph","Properties":{"id":"20240607095544-kjinn71","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：血崩禁用。瞳子散大禁用，惟热血欲贯瞳人者，与凉血药同用则不忌。"}]},{"ID":"20240607095544-htbkqem","Type":"NodeParagraph","Properties":{"id":"20240607095544-htbkqem","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"4.《本草从新》：非血滞、血热者勿与。"}]},{"ID":"20240607095544-0n0z09t","Type":"NodeParagraph","Properties":{"id":"20240607095544-0n0z09t","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095544-0qwzzvo","Type":"NodeParagraph","Properties":{"id":"20240607095544-0qwzzvo","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 活血调经；清肝明目。主月经不调；痛经；闭经；产后瘀滞腹痛；肝热头痛；头晕；目赤肿痛；目生翳障"}]},{"ID":"20240607095544-89mc0v7","Type":"NodeParagraph","Properties":{"id":"20240607095544-89mc0v7","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095544-7ht7gwn","Type":"NodeParagraph","Properties":{"id":"20240607095544-7ht7gwn","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g；或入丸、散；或捣绞取汁。"}]},{"ID":"20240607095544-qp7ystt","Type":"NodeParagraph","Properties":{"id":"20240607095544-qp7ystt","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607095544-ob8govo","Type":"NodeParagraph","Properties":{"id":"20240607095544-ob8govo","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 治子宫脱垂：茺蔚子五钱，枳壳四钱。水煎服。(《湖南药物志》)"}]},{"ID":"20240607095544-mr59i6e","Type":"NodeParagraph","Properties":{"id":"20240607095544-mr59i6e","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607095544-cl5iz45","Type":"NodeParagraph","Properties":{"id":"20240607095544-cl5iz45","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 服食大量的茺蔚子后可发生中毒。据25例报告，一般服食20-30g后即可于4-10小时发病；但亦有人在10天内连续服至500g而始发病的。临床中毒症状为突然全身无力，下肢不能活动呈瘫痪状态，但神志、言语清楚，苔脉多正常。经中西医综合治疗均获恢复，无1例死亡。"}]},{"ID":"20240607095544-72a61ya","Type":"NodeParagraph","Properties":{"id":"20240607095544-72a61ya","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607095544-a82rqyp","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607095544-a82rqyp","updated":"20240607095544"},"Children":[{"ID":"20240607095544-ddom9wb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240607095544-ddom9wb","updated":"20240607095544"},"Children":[{"ID":"20240607095544-5d1dnja","Type":"NodeParagraph","Properties":{"id":"20240607095544-5d1dnja","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"朱震亨：茺蔚子，活血行气，有补阴之功，故名益母。凡胎前产后所恃者，血气也。胎前无滞，产后无虚，以其行中有补也。"}]}]}]},{"ID":"20240607095544-gnmyk5q","Type":"NodeParagraph","Properties":{"id":"20240607095544-gnmyk5q","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：茺蔚子，白花者入气分，紫花者入血分。治妇女经脉不调，胎产一切血气诸病，妙品也。而医方鲜知用，时珍常以之同四物、香附诸药治人，获效甚多。盖包络生血，肝藏血，此物能活血补阴，故能明目。益精。调经，治女人诸病也。东垣李氏言瞳子散大者，禁用茺蔚子，为其辛温主散，能助火也，当归虽辛温，而兼苦甘，能和血，故不禁之。愚谓目得血而能视，茺蔚行血甚捷，瞳子散大，血不足也，故禁之，非助火也。血滞病目则宜之，故曰明目。"}]},{"ID":"20240607095544-h04wn6n","Type":"NodeParagraph","Properties":{"id":"20240607095544-h04wn6n","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：茺蔚子，为妇人胎产调经之要药。此药补而能行，辛散而兼润者也。目者，肝之窍也，益肝行血，故明目益精。其气纯阳，辛走而不守，故除水气。肝脏有火则血逆，肝凉则降而顺矣。大热头痛心烦，皆血虚而热之候也，清肝散热和血，则头痛心烦俱解。"}]},{"ID":"20240607095544-y5ozabx","Type":"NodeParagraph","Properties":{"id":"20240607095544-y5ozabx","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：茺蔚，古人止用其子。《本经》之明目益精，则温和养血，而又沉重，直达下焦，故为补益肾阴之用。除水气者，辛温下降，故能通络而逐水。其茎可浴疹痒。则活血疏风之功也。《别录》加以微寒，则亦温亦寒，大是不妥，盖当时以治热症，因而羼入此说，疗血逆者，温和行血，又子能重坠下降，故能平逆，惟主大热头痛心烦，则与温养之性不符，存而不论可也。"}]},{"ID":"20240607095544-przesu2","Type":"NodeParagraph","Properties":{"id":"20240607095544-przesu2","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主明目，益精，除水气。"}]},{"ID":"20240607095544-vgwynmr","Type":"NodeParagraph","Properties":{"id":"20240607095544-vgwynmr","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"6.《别录》：疗血逆，大热头痛心烦。"}]},{"ID":"20240607095544-x7cmtrc","Type":"NodeParagraph","Properties":{"id":"20240607095544-x7cmtrc","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"7.《日华子本草》：治产后血胀。"}]},{"ID":"20240607095544-7157s07","Type":"NodeParagraph","Properties":{"id":"20240607095544-7157s07","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"8.《开宝本草》：作煎及捣绞取汁服之，下死胎。"}]},{"ID":"20240607095544-axzep8y","Type":"NodeParagraph","Properties":{"id":"20240607095544-axzep8y","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"9.《日用本草》：春仁，生食补中益气，通血脉，填精髓，止渴，润肺。"}]},{"ID":"20240607095544-jwsi9qe","Type":"NodeParagraph","Properties":{"id":"20240607095544-jwsi9qe","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"10.《纲目》：治风解热，顺气活血，养肝益心，安魂定魄，调女人经脉，崩中带下，产后胎前诸疾。"}]},{"ID":"20240607095544-yntguan","Type":"NodeParagraph","Properties":{"id":"20240607095544-yntguan","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095544-80hlr3y","Type":"NodeParagraph","Properties":{"id":"20240607095544-80hlr3y","updated":"20240607095544"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607095545-j86xsek","Type":"NodeThematicBreak","Properties":{"id":"20240607095545-j86xsek"}},{"ID":"20240607095547-x14ajsd","Type":"NodeParagraph","Properties":{"id":"20240607095547-x14ajsd"}}]}