{"ID":"20240205153657-nr3s17p","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153657-nr3s17p","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153657-nr3s17p\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206103203-0my7n43\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240614090805-ue4fbu1\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240614091252-2prsjiz\u0026quot;,\u0026quot;focusStart\u0026quot;:10,\u0026quot;focusEnd\u0026quot;:10\u0026#125;","title":"352桃核仁（桃仁）","type":"doc","updated":"20240828095523"},"Children":[{"ID":"20240206103203-0my7n43","Type":"NodeParagraph","Properties":{"id":"20240206103203-0my7n43","updated":"20240206103211"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产北京、河北、陕西等地。\n【性状】\t种子扁卵形或椭圆形，一端尖，另端钝圆而偏斜，边缘较薄，长1.22cm，宽11.2cm，厚35mm。表面黄棕色或红棕色，有纵脉纹及密布细粒状突起，近尖端侧边有长46mm的线形种脐。种皮薄，子叶两片肥大，黄白色，富油质。味微苦。\n【性味】\t苦、甘，平。\n【功效】\t活血祛瘀，润肠通便，止咳平喘。用于经闭，痛经，癓瘕痞块，跌扑损伤，肠燥便秘。"}]},{"ID":"20240206103204-w3n3at0","Type":"NodeParagraph","Properties":{"id":"20240206103204-w3n3at0","updated":"20240206103204"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206103204-4e4u15a.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205163524-notfn0m","Type":"NodeParagraph","Properties":{"id":"20240205163524-notfn0m","updated":"20240205163524"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃仁"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃仁-20240205163524-5heq4d8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828094816-7bdrff9","Type":"NodeParagraph","Properties":{"id":"20240828094816-7bdrff9","updated":"20240828094902"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 686px;","style":"width: 676px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树-20240828094816-0il5vo4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 676px;\" parent-style=\"width: 686px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 357px;","style":"width: 347px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树 1-20240828094902-ue9hb4k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 347px;\" parent-style=\"width: 357px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703162234-2g6zemg","Type":"NodeParagraph","Properties":{"id":"20240703162234-2g6zemg","updated":"20240828094924"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 543px;","style":"width: 533px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃子3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃子3-20240703162358-mnwoq5g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 533px;\" parent-style=\"width: 543px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 547px;","style":"width: 537px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃子2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃子2-20240703162324-r0xi7px.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 537px;\" parent-style=\"width: 547px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240614090801-hbebmmt","Type":"NodeParagraph","Properties":{"id":"20240614090801-hbebmmt","updated":"20240828094927"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 587px;","style":"width: 577px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃子-20240703162234-otevci4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 577px;\" parent-style=\"width: 587px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 522px;","style":"width: 512px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃子5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃子5-20240703163418-ryg2omh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 512px;\" parent-style=\"width: 522px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828095017-z0xkndq","Type":"NodeParagraph","Properties":{"id":"20240828095017-z0xkndq","updated":"20240828095023"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 588px;","style":"width: 578px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树 2-20240828095017-owjnvpl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 578px;\" parent-style=\"width