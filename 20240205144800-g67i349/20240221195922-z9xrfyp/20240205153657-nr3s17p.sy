pe":"NodeLinkText","Data":"桃树 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树 3-20240828095139-45cg1tf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 829px;\" parent-style=\"width: 839px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703163913-zzrumqz","Type":"NodeParagraph","Properties":{"id":"20240703163913-zzrumqz","updated":"20240828095149"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃花-20240703163913-dcabn84.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 285px;","style":"width: 275px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃花5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃花5-20240703164120-n2mlbi5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 275px;\" parent-style=\"width: 285px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703164241-utt7fkt","Type":"NodeParagraph","Properties":{"id":"20240703164241-utt7fkt","updated":"20240828095516"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 584px;","style":"width: 574px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃花2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃花2-20240703164303-ksivqx8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 574px;\" parent-style=\"width: 584px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 655px;","style":"width: 645px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃花-20240828095310-d92c8af.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 645px;\" parent-style=\"width: 655px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240703162951-tfinowp","Type":"NodeParagraph","Properties":{"id":"20240703162951-tfinowp","updated":"20240828095523"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树6-20240703165809-cd0xwoe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 854px;","style":"width: 844px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桃树4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桃树4-20240703165501-bdiqwmg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 844px;\" parent-style=\"width: 854px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240614091251-h35owbi","Type":"NodeThematicBreak","Properties":{"id":"20240614091251-h35owbi"}},{"ID":"20240614091252-2prsjiz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091252-2prsjiz","updated":"20240614091300"},"Children":[{"Type":"NodeText","Data":"桃核仁《神农本草经》"}]},{"ID":"20240614091252-3tmdw5s","Type":"NodeParagraph","Properties":{"id":"20240614091252-3tmdw5s","updated":"20240614091252"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240614091252-t6bts2j","Type":"NodeParagraph","Properties":{"id":"20240614091252-t6bts2j","updated":"20240614091252"},"Children":[{"Type":"NodeText","Data":"主淤血，血闭瘕邪，杀小虫。桃花杀注恶鬼，令人好颜色。"}]},{"ID":"20240614091252-t6nlqc7","Type":"NodeParagraph","Properties":{"id":"20240614091252-t6nlqc7","updated":"20240614091252"},"Children":[{"Type":"NodeText","Data":"桃凫，微湿，主杀百鬼精物（初学记引云，枭桃在树不落，杀百鬼）。"}]},{"ID":"20240614091252-d5zhpjr","Type":"NodeParagraph","Properties":{"id":"20240614091252-d5zhpjr","updated":"20240614091252"},"Children":[{"Type":"NodeText","Data":"桃毛，主下血瘕寒热，积寒无子，桃蠹，杀鬼邪恶不祥。生川谷。"}]},{"ID":"20240614091252-opxfqg5","Type":"NodeParagraph","Properties":{"id":"20240614091252-opxfqg5","updated":"20240614091252"},"Children":[{"Type":"NodeText","Data":"《名医》曰：桃核，七月采，取仁，阴干，花三月三日采，阴干，桃凫一名桃奴，一名枭景，是实着树不落，实中者，正月采之，桃蠹，食桃树虫也。生太山。"}]},{"ID":"20240614091252-lljnj6y","Type":"NodeParagraph","Properties":{"id":"20240614091252-lljnj6y","updated":"20240614091252"},"Children":[{"Type":"NodeText","Data":"案《说文》云：桃，果也。玉篇云：桃，毛果也。《尔雅》云：桃李丑核。郭璞云：子中有核仁。孙炎云：桃李之实，类皆有核。"}]},{"ID":"20240614090801-6ijr13k","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-6ijr13k"}},{"ID":"20240614091212-78imy8b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091212-78imy8b","updated":"20240614091240"},"Children":[{"Type":"NodeText","Data":"桃仁《本草撮要》"}]},{"ID":"20240614091212-u0jlsjl","Type":"NodeParagraph","Properties":{"id":"20240614091212-u0jlsjl","updated":"20240614091212"},"Children":[{"Type":"NodeText","Data":"味苦甘辛．入手足厥阴经血分．功专破瘀润肠．止心腹痛．得吴茱萸治冷劳减食．得延胡索、川楝子治肝厥胃脘痛．妇人阴痒．杵桃仁绵裹塞之．阴肿敷之立效．疟疾寒热．以桃仁一百枚．去皮尖．置钵内研成膏．不得犯生水．入黄丹三钱．丸梧子大．每服三丸．当发日面北温酒下．合此丸须端午午时．忌妇人鸡犬见．"}]},{"ID":"20240614090801-6dj3awk","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-6dj3awk"}},{"ID":"20240614091203-772fzt1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091203-772fzt1","updated":"20240614091206"},"Children":[{"Type":"NodeText","Data":"桃仁《本经逢原》"}]},{"ID":"20240614091203-zqj2fuz","Type":"NodeParagraph","Properties":{"id":"20240614091203-zqj2fuz","updated":"20240614091203"},"Children":[{"Type":"NodeText","Data":"苦甘平，无毒。去皮尖。生用则和血，连皮尖炒用即破血。同干漆拌炒大破宿血。双仁者有毒勿用。"}]},{"ID":"20240614091203-zw9znlu","Type":"NodeParagraph","Properties":{"id":"20240614091203-zw9znlu","updated":"20240614091203"},"Children":[{"Type":"NodeText","Data":"《本经》主瘀血血闭症瘕邪气，杀三虫。"}]},{"ID":"20240614091203-hhvsuv1","Type":"NodeParagraph","Properties":{"id":"20240614091203-hhvsuv1","updated":"20240614091203"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"桃仁入手足厥阴血分，为血瘀、血闭之专药。苦以泄滞血，甘以生新血，毕竟破血之功居多。观《本经》主治可知仲景桃核承气，抵当汤，皆取破血之用。又治热入血室瘀积症瘕经闭疟母，心腹痛，大肠秘结，亦取散肝经之血结。熬香治 疝痛痒，《千金》法也。桃实甘酸，多食令人腹热作泻。桃奴杀百鬼精物，疗中恶腹痛瘀血症坚，破血，酒磨服；"}]},{"ID":"20240614091203-9ugen7x","Type":"NodeParagraph","Properties":{"id":"20240614091203-9ugen7x","updated":"20240614091203"},"Children":[{"Type":"NodeText","Data":"止血，烧灰服。桃树上胶最通津液，能治血淋、石淋、痘疮黑陷，必胜膏用之。桃叶治传尸，有水炙法，方用桃叶一斗，艾叶、浓朴各二两，分二囊盛，置以火酒数斤煮沸，更迭煮药，熨患人背脊，酒尽为度，不过三次，瘵虫永绝。又疮中小虫，捣烂涂之。"}]},{"ID":"20240614091131-14yylbk","Type":"NodeThematicBreak","Properties":{"id":"20240614091131-14yylbk"}},{"ID":"20240614091150-556yu7c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091150-556yu7c","updated":"20240614091156"},"Children":[{"Type":"NodeText","Data":"桃仁《本草备要》"}]},{"ID":"20240614091150-qsgqbuc","Type":"NodeParagraph","Properties":{"id":"20240614091150-qsgqbuc","updated":"20240614091150"},"Children":[{"Type":"NodeText","Data":"泻，破血，润燥"}]},{"ID":"20240614091150-iv135ow","Type":"NodeParagraph","Properties":{"id":"20240614091150-iv135ow","updated":"20240614091150"},"Children":[{"Type":"NodeText","Data":"苦平微甘（孙思邈辛，孟诜温。孙思邈，着《千金方》，孟诜，着《食疗本草》）厥阴（心包、肝）血分药。苦以泄血滞，甘以缓肝气新血（成无己曰∶肝者，血之源，血聚，则肝气燥。肝苦急，宜急食甘以缓之）。通大肠血秘。"}]},{"ID":"20240614091150-cuo0od5","Type":"NodeParagraph","Properties":{"id":"20240614091150-cuo0od5","updated":"20240614091150"},"Children":[{"Type":"NodeText","Data":"治热入血室（冲脉），血燥血痞，损伤积血。血痢经闭，咳逆上气（血和则气降），皮肤血热，燥痒蓄血，发热如狂（仲景治膀胱蓄血，有桃仁承气汤即调胃承气汤加桃仁、桂枝。"}]},{"ID":"20240614091150-p4pawby","Type":"NodeParagraph","Properties":{"id":"20240614091150-p4pawby","updated":"20240614091150"},"Children":[{"Type":"NodeText","Data":"抵当汤，用桃仁、大黄、虻虫、水蛭。水蛭，即马蟥。蛭食血之虫，能通肝经聚血，性最难死。虽炙为末，得水即活，若入腹中，生子为患，田泥和水饮下之。虻虫即蚊虫，因其食血，故用以治血）。血不足者禁用。行血连皮、尖生用，润燥去皮、尖炒用，俱研碎，或烧存性用。双仁者有毒，不可食。香附为使。"}]},{"ID":"20240614091150-2b4luxs","Type":"NodeParagraph","Properties":{"id":"20240614091150-2b4luxs","updated":"20240614091150"},"Children":[{"Type":"NodeText","Data":"桃花苦平。下宿水，除痰饮，消积聚，利二便，疗风狂（范纯佑女，丧夫发狂，夜断窗，登桃树食花几尽，自是遂愈。以能泻痰饮、滞血也）。"}]},{"ID":"20240614091150-vg26hr4","Type":"NodeParagraph","Properties":{"id":"20240614091150-vg26hr4","updated":"20240614091150"},"Children":[{"Type":"NodeText","Data":"桃叶能发汗（凡伤寒、风痹发汗不出，以火 地，用水洒之，铺干桃叶浓二三寸，席卧，温复取大汗，敷粉极燥，即瘥。麦麸、蚕沙，皆可如此法用。桃为五木之精，其枝、叶、花、仁，并能辟邪。《食医心镜》桃仁煮粥，治鬼证咳嗽。生桃食多生痈疖）。"}]},{"ID":"20240614091131-1ibjrg0","Type":"NodeThematicBreak","Properties":{"id":"20240614091131-1ibjrg0"}},{"ID":"20240614091141-guj2qaj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091141-guj2qaj","updated":"20240614091145"},"Children":[{"Type":"NodeText","Data":"桃仁《汤液本草》"}]},{"ID":"20240614091141-jhnihx0","Type":"NodeParagraph","Properties":{"id":"20240614091141-jhnihx0","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"气温，味苦、甘、性平，苦重于甘，阴中阳也。无毒。"}]},{"ID":"20240614091141-zgz35vh","Type":"NodeParagraph","Properties":{"id":"20240614091141-zgz35vh","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"入手、足厥阴经。"}]},{"ID":"20240614091141-3wr8t30","Type":"NodeParagraph","Properties":{"id":"20240614091141-3wr8t30","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"《象》云∶治大便血结、血秘、血燥，通润大便。七宣丸中，专治血结，破血。以汤浸，去皮尖，研如泥用。"}]},{"ID":"20240614091141-me7q8o2","Type":"NodeParagraph","Properties":{"id":"20240614091141-me7q8o2","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"《心》云∶苦以泄滞血，甘以生新血，故凝血须用。又去血中之热。"}]},{"ID":"20240614091141-bl0paso","Type":"NodeParagraph","Properties":{"id":"20240614091141-bl0paso","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主瘀血血闭，症瘕邪气。杀小虫，止咳逆上气，消心下坚。"}]},{"ID":"20240614091141-6amb29u","Type":"NodeParagraph","Properties":{"id":"20240614091141-6amb29u","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"除卒暴击血，通月水，止痛破血。入手足厥阴。"}]},{"ID":"20240614091141-6peenlm","Type":"NodeParagraph","Properties":{"id":"20240614091141-6peenlm","updated":"20240614091141"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶老人虚秘，与柏子仁、火麻仁、松子仁，等分同研，熔白蜡，和丸如桐子大。以少黄丹汤下。仲景治中焦畜血用之。"}]},{"ID":"20240614091131-gl4c9x8","Type":"NodeThematicBreak","Properties":{"id":"20240614091131-gl4c9x8"}},{"ID":"20240614091132-mnez3um","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091132-mnez3um","updated":"20240614091136"},"Children":[{"Type":"NodeText","Data":"桃仁《冯氏锦囊秘录》"}]},{"ID":"20240614091132-bfle724","Type":"NodeParagraph","Properties":{"id":"20240614091132-bfle724","updated":"20240614091132"},"Children":[{"Type":"NodeText","Data":"禀地二之气，兼得天五之气以生，故其味苦重甘微，气平无毒。思邈言辛，盂诜言温，亦皆有之。入手足厥阴经，夫血者阴也，有形者也，周流乎一身，一有凝滞则为瘕，瘀血血闭，或妇人月水不通，或击扑伤损积血，及心下宿血坚痛，皆从足厥阴受病，以其为藏血之脏也。苦能泄滞，辛能散结，甘温通行而缓肝，故并主之，所以为蓄血症必需之药。且桃为五之木精，能镇辟不详，故主邪气，味苦而辛，故能杀小虫，虽云∶苦能去滞甘能生新，但苦重甘微气薄，味浓沉而下降，故泻多补少，散而不收，用之不当，及过用多用，使血下不止，损伤真阴不可不慎。桃岛一名桃奴，是桃实着树经冬不落者，得气尤全，正月采用，盖桃为仙木、五木之精也，最能辟邪，故用杀诸精鬼，中恶腹痛，五毒不祥，其苦温之性，又能通滞散邪，故治血之功，与桃仁同，鬼击吐血，以为必需。"}]},{"ID":"20240614091132-ktskws9","Type":"NodeParagraph","Properties":{"id":"20240614091132-ktskws9","updated":"20240614091132"},"Children":[{"Type":"NodeText","Data":"桃仁，主瘀血血闭，血结血燥，通润大便。行月水止痛及 瘕邪气，杀虫辟邪，苦以破滞血，甘以主新血，花味苦，三月三日采阴干，杀鬼疰，美颜色，除水肿石淋，利二便，下三虫，酒渍服，除百病。然性走泻下降，利大肠甚快，干粪塞肠，胀痛不通，用毛桃花者湿者一两，和面三两，作馄饨煮熟，空心食之，午间腹鸣如雷，当下恶物也。叶味苦辛，出疮中虫并尸虫。并取汁饮，诸虫入耳，女人阴疮，虫咬疼痛，并将裹塞，枝煎酒饮。治痛心痛，煮汤浴不染时瘟，实恣痰作热。桃凫，辟恶杀邪，吐血用之，烧灰米汤调服立止。桃胶，乃树中流汁，下淋破血中恶炼服。桃中蠹，亦杀鬼恶。桃上毛，更破 坚。树白皮，治 生齿间。桃寄生，疗蛊中腹内。"}]},{"ID":"20240614091132-6jclj4a","Type":"NodeParagraph","Properties":{"id":"20240614091132-6jclj4a","updated":"20240614091132"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 桃仁，宜择去双仁者，以汤浸去皮尖研用。此与杏仁润大肠功同，但杏仁治气秘，桃仁治血秘，虽云苦以去滞，甘以生新，然究竟破血之功多，而益血之力少，但走血分而性滑润。佐麻仁当归以治燥结如神耳。露桃花味苦辟邪，除百毒并痘毒瓦斯斑疮，宜清晨带露摘取，饭上蒸熟，焙干用。不宜多用，用多则泻，古方用治痘，一二日焦紫及丹，盖以其性阴而和阳也。"}]},{"ID":"20240614090801-929ug0q","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-929ug0q"}},{"ID":"20240614091122-rdncd43","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091122-rdncd43","updated":"20240614091126"},"Children":[{"Type":"NodeText","Data":"桃仁《中药炮制》"}]},{"ID":"20240614091122-emyavwv","Type":"NodeParagraph","Properties":{"id":"20240614091122-emyavwv","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『来源』本品为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山桃"},{"Type":"NodeText","Data":"的干燥成熟种子。"}]},{"ID":"20240614091122-59jv3y1","Type":"NodeParagraph","Properties":{"id":"20240614091122-59jv3y1","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『常用名』单桃仁。"}]},{"ID":"20240614091122-12nnu2s","Type":"NodeParagraph","Properties":{"id":"20240614091122-12nnu2s","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『产地』河南、湖北。"}]},{"ID":"20240614091122-ggztg9r","Type":"NodeParagraph","Properties":{"id":"20240614091122-ggztg9r","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『采收季节』6～7月。"}]},{"ID":"20240614091122-e0rwfet","Type":"NodeParagraph","Properties":{"id":"20240614091122-e0rwfet","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『炮制方法』拣去杂质，筛去灰土，将桃仁放入盆内，用开水泡5～10分钟，其皮鼓起，及时取出，用手去皮或略用二块木板擦去皮，再用清水洗一次，捞起滤干水份，晒干后，簸去皮取得。如用炒桃仁，将锅烧热投入桃仁，用文火炒至焦黑斑点即可。"}]},{"ID":"20240614091122-re2amf6","Type":"NodeParagraph","Properties":{"id":"20240614091122-re2amf6","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『用量』3～9克。"}]},{"ID":"20240614091122-fp0krln","Type":"NodeParagraph","Properties":{"id":"20240614091122-fp0krln","updated":"20240614091122"},"Children":[{"Type":"NodeText","Data":"『贮存』用缸装加盖，防潮，防虫，防走油，防变色。"}]},{"ID":"20240614090801-klv6h8y","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-klv6h8y"}},{"ID":"20240614091113-cxjwj37","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091113-cxjwj37","updated":"20240614091117"},"Children":[{"Type":"NodeText","Data":"桃仁《本草择要纲目》"}]},{"ID":"20240614091113-4ytjgyh","Type":"NodeParagraph","Properties":{"id":"20240614091113-4ytjgyh","updated":"20240614091113"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240614091113-0lpb8j1","Type":"NodeParagraph","Properties":{"id":"20240614091113-0lpb8j1","updated":"20240614091113"},"Children":[{"Type":"NodeText","Data":"苦甘平无毒．沉而降．阴中之阳．入手足厥阴经血分．"}]},{"ID":"20240614091113-qi442dx","Type":"NodeParagraph","Properties":{"id":"20240614091113-qi442dx","updated":"20240614091113"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240614091113-qfgcjes","Type":"NodeParagraph","Properties":{"id":"20240614091113-qfgcjes","updated":"20240614091113"},"Children":[{"Type":"NodeText","Data":"热入血室．泄腹中滞血．除皮肤血热燥痒．行皮肤凝聚之血．伤寒八九日．内有蓄血．发热如狂．小腹满．小便自利者．又有当汗失汗．热毒深入．吐血及血结胸烦燥谵语者．仲景俱以抵当汤主之．与虻虫水蛭大黄同用．总以桃仁之苦可以泄滞．破血以生新血也．"}]},{"ID":"20240614090956-bh7knip","Type":"NodeThematicBreak","Properties":{"id":"20240614090956-bh7knip"}},{"ID":"20240614091104-xviqtiq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091104-xviqtiq","updated":"20240614091108"},"Children":[{"Type":"NodeText","Data":"桃仁《药性切用》"}]},{"ID":"20240614091104-l4k8fbx","Type":"NodeParagraph","Properties":{"id":"20240614091104-l4k8fbx","updated":"20240614091104"},"Children":[{"Type":"NodeText","Data":"苦平微甘，入厥阴而调经破瘀，润燥通肠。去皮尖研如泥用。肠滑者忌。桃花∶苦血分，而消积下滞，利水除痰，为痰饮滞血专药。误服泻人。桃叶∶苦平，杀虫发汗。辛酸甘热，多食，壅热生疡。正月采桃，名桃枭，辟邪祟。桃干∶在树名僵桃，缩邪"}]},{"ID":"20240614091018-2ar4unh","Type":"NodeThematicBreak","Properties":{"id":"20240614091018-2ar4unh"}},{"ID":"20240614091053-orw4x5t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091053-orw4x5t","updated":"20240614091057"},"Children":[{"Type":"NodeText","Data":"桃仁《本草求真》"}]},{"ID":"20240614091053-s4eoy29","Type":"NodeParagraph","Properties":{"id":"20240614091053-s4eoy29","updated":"20240614091053"},"Children":[{"Type":"NodeText","Data":"（五果）入心包肝破血通瘀"}]},{"ID":"20240614091053-fqu7s9e","Type":"NodeParagraph","Properties":{"id":"20240614091053-fqu7s9e","updated":"20240614091053"},"Children":[{"Type":"NodeText","Data":"桃仁（专入心包肝）。辛苦甘温。为厥阴心包肝血分主药。夫血者阴也。有形者也。周流乎一身。一有凝滞。则为症瘕瘀血血闭。或妇人月水不通。或跌扑损伤积血。及心下宿血坚痛。皆从足厥阴受病。以其为藏血之脏也。苦能泄滞。辛能散结。甘温通行而缓肝。故并主之。所以为蓄血必需之药。（成无己曰。肝者血之源。血聚则肝气燥。肝苦急。急食甘以缓之。桃仁之甘以缓肝。以散血。故张仲景抵当汤用之以治伤寒八九日。内有蓄血。发热如狂。小腹满痛。小便自利者。又有当汗失汗。热毒深入吐血。及血结胸烦燥谵语者。亦以此汤主之。与虻虫水蛭大黄同用。）且桃为五木之精。能镇辟不祥。故主辟邪。味苦而辛。故能杀小虫。虽云苦能去滞。甘能生辛。但苦重甘微。气薄味浓。沉而下降。故泻多补少。散而不收。用之不当。及过用多用。使血下不止。损伤真阴。不可不慎。（张璐曰。大抵气血喜温而恶寒。寒则泣不能流。温则消而去之。此轩岐密旨。但世之名于医者。一见血症。每以寒凉济阴为务。其始非不应手而取效于一时。屡发屡折。而既病之虚阳愈衰。必致呕逆喘乏。夺食泄泻。尚以药力未逮。猛进苦寒。有阴不济阳而上溢者。尚为戈戟。况阳不统阴而亡脱者。尤为砒鸩。盖因阳药性暴。稍有不顺。下咽立见其害。不若阴柔之性。至死不知其误而免旁人之讥谤也。噫！医之弊。仅可为知己道。难为俗人言耳！）行血连皮尖生用。润燥去皮尖炒用。俱研碎。或烧存性用。双仁者有毒不可食。香附为使。（诜曰。能发丹石毒。生者尤损人。瑞曰。桃与鳖同食。患心腹痛。服术人忌之。）"}]},{"ID":"20240614091019-spy9ogo","Type":"NodeThematicBreak","Properties":{"id":"20240614091019-spy9ogo"}},{"ID":"20240614091042-xhbe224","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091042-xhbe224","updated":"20240614091046"},"Children":[{"Type":"NodeText","Data":"桃仁《长沙药解》"}]},{"ID":"20240614091042-gv80n19","Type":"NodeParagraph","Properties":{"id":"20240614091042-gv80n19","updated":"20240614091042"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614091042-boate69","Type":"NodeParagraph","Properties":{"id":"20240614091042-boate69","updated":"20240614091042"},"Children":[{"Type":"NodeText","Data":"味甘、苦、辛，入足厥阴肝经。通经而行瘀涩，破血而化癥瘕。"}]},{"ID":"20240614091042-vclhlep","Type":"NodeParagraph","Properties":{"id":"20240614091042-vclhlep","updated":"20240614091042"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃核承气汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桃仁五十枚，甘草、桂枝、芒硝各一两，大黄四两。"},{"Type":"NodeText","Data":"治太阳伤寒，热结膀胱，其人如狂，外证已解，但小腹急结者。太阳为膀胱之经，膀胱为太阳之腑，太阳表证不解，经热内传，结于膀胱之腑，血室瘀蒸，其人如狂，是宜攻下。若外证未解，不可遽下，俟其表热汗散，但只小腹急结者，乃用下法。甘草补其中气，桂枝、桃仁，行经脉而破凝瘀，芒硝、大黄，泻郁热而下积血也。"}]},{"ID":"20240614091042-4d1scvc","Type":"NodeParagraph","Properties":{"id":"20240614091042-4d1scvc","updated":"20240614091042"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"抵当汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治血结膀胱，少腹硬满。《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳖甲煎丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在鳖甲。"},{"Type":"NodeText","Data":"用之治久疟不愈，结为癥瘕。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄（庶/虫）虫丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治虚劳腹满，内有干血。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝茯苓丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在桂枝。"},{"Type":"NodeText","Data":"用之治宿有癥病，胎动下血。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"下瘀血汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治产妇腹痛，中有瘀血。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄牡丹皮汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治肠痈脓成，其脉洪数，以其破癥瘀而行脓血也。"}]},{"ID":"20240614091042-4h1vzto","Type":"NodeParagraph","Properties":{"id":"20240614091042-4h1vzto","updated":"20240614091042"},"Children":[{"Type":"NodeText","Data":"桃仁辛苦滑利，通经行血，善润结燥而破癥瘀。其诸主治，止咳逆，平喘息，断崩漏，杀虫（匿/虫虫），疗心痛，医腹痛，通经闭，润便燥，消心下坚积，止阴中肿痒，缩小儿癞疝，扫男子牙血。"}]},{"ID":"20240614091019-7it5ok9","Type":"NodeThematicBreak","Properties":{"id":"20240614091019-7it5ok9"}},{"ID":"20240614091029-ubrgxl6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091029-ubrgxl6","updated":"20240614091033"},"Children":[{"Type":"NodeText","Data":"桃仁《神农本草经读》"}]},{"ID":"20240614091029-6ftg65u","Type":"NodeParagraph","Properties":{"id":"20240614091029-6ftg65u","updated":"20240614091029"},"Children":[{"Type":"NodeText","Data":"气味苦、甘、平，无毒。主淤血、血闭、症瘕邪气，杀小虫。（双仁者，大毒。）陈修园曰∶桃仁气平为金气，味苦为大味，味甘为上味。所以泻多而补少者，以气平主降，味苦主泄，甘味之少，不能与之为敌也。"}]},{"ID":"20240614091029-w53vol6","Type":"NodeParagraph","Properties":{"id":"20240614091029-w53vol6","updated":"20240614091029"},"Children":[{"Type":"NodeText","Data":"徐灵胎曰∶桃得三月春和之气以生，而花色鲜明似血，故凡血郁血结之疾，不能调和畅达者，此能入于其中而和之散之。然其生血之功少，而去淤之功多者，何也？盖桃核本非血类，故不能有所补益。若淤瘕皆已败之血，非生气不能流通。桃之生气，皆在于仁，而味苦又能开泄，故能逐旧而不伤新也。"}]},{"ID":"20240614091019-meff2qq","Type":"NodeThematicBreak","Properties":{"id":"20240614091019-meff2qq"}},{"ID":"20240614091020-w316nm1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091020-w316nm1","updated":"20240614091024"},"Children":[{"Type":"NodeText","Data":"桃仁《本草从新》"}]},{"ID":"20240614091020-vp1grn4","Type":"NodeParagraph","Properties":{"id":"20240614091020-vp1grn4","updated":"20240614091020"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻、破血润燥．"}]},{"ID":"20240614091020-51mwl1o","Type":"NodeParagraph","Properties":{"id":"20240614091020-51mwl1o","updated":"20240614091020"},"Children":[{"Type":"NodeText","Data":"苦平微甘．苦以泄血滞，甘以缓肝气而生新血．（成无己曰∶肝者、血之源、血聚则肝气燥、肝苦急、急食甘以缓之．）通大肠血秘．治热入血室．（冲脉．）血燥血痞．损伤积血．血痢经闭．咳逆上气．（血和则气降．）皮肤燥痒．（肌有血凝．）发热如狂．（若小腹满痛、小便自利者、为畜血．）若非血瘀而误用之．大伤阴气．泡去皮尖炒．研碎．双仁者有毒．不可用．香附为使．（妇人阴痒、桃仁杵烂、绵裹塞之、产后阴肿、桃仁捣研傅之、俱妙．）"}]},{"ID":"20240614091020-3jgsea3","Type":"NodeParagraph","Properties":{"id":"20240614091020-3jgsea3","updated":"20240614091020"},"Children":[{"Type":"NodeText","Data":"桃花（通、大泻．） 苦平．下宿水．除痰饮．消积聚．利二便．疗风狂．（苏鹗杜阳编载、范纯佑女、丧夫发狂、闭之室中、夜断窗棂、登桃树、食花几尽、自是遂愈、以能泻痰饮滞血也．儒门事亲载、一妇滑泻数年、百治不效、或言此伤饮有积也、桃花落时、以棘针刺取数十萼、勿犯人手、以面和作饼、煨熟食之、米饮送下、不一二时、泻下如倾、六日行至数百行、昏困、唯饮凉水而平．）以攻决为用．但可施于气实有余之证．若无故而因除百病、美颜色诸谬说而服之．为害不小．三月三日．采花拣净．以绢袋盛．悬檐下阴干．千叶者勿用．"}]},{"ID":"20240614091020-u76xgfb","Type":"NodeParagraph","Properties":{"id":"20240614091020-u76xgfb","updated":"20240614091020"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃叶"},{"Type":"NodeText","Data":"（宣、发汗、苦平．杀虫发汗．（凡伤寒风痹、发汗不出、以火烧地、用水洒之、布干桃叶于上、浓二三寸、席卧温复、取大汗、被中敷粉极燥、便瘥、凡麦麸蚕沙、皆可如此法用．）采嫩者．名桃心．入药尤胜．桃子辛酸甘热．微毒．多食令人有热．生痈疖．（有损无益、五果列桃为下、以此与鳖同食、患心痛、服术人尤忌之．）桃枭（是桃子在树、经冬不落者、正月采之．）苦微温．有小毒．辟邪祛祟．（白秃头疮、干桃一两、黑丑一合为末、腊猪脂调搽．）"}]},{"ID":"20240614090956-50m8kfj","Type":"NodeThematicBreak","Properties":{"id":"20240614090956-50m8kfj"}},{"ID":"20240614091009-ndg8179","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614091009-ndg8179","updated":"20240614091013"},"Children":[{"Type":"NodeText","Data":"桃仁《医学入门》"}]},{"ID":"20240614091009-tv1arv3","Type":"NodeParagraph","Properties":{"id":"20240614091009-tv1arv3","updated":"20240614091009"},"Children":[{"Type":"NodeText","Data":"桃仁无毒苦甘平，破血通肠利月经，兼除咳逆心胸满，疝瘕腰痛杀虫精，花悦颜色医淋肿，奴散气血肺心清。"}]},{"ID":"20240614091009-nys32u8","Type":"NodeParagraph","Properties":{"id":"20240614091009-nys32u8","updated":"20240614091009"},"Children":[{"Type":"NodeText","Data":"桃者，逃也，能令鬼邪逃循，五木之精也。无毒。沉而降，阴也。入手、足厥阴经。主瘀血、血闭、血结、血热、血证、血瘕及卒暴击血、心痛、骨蒸、偏风、半身不遂，润大肠，通月水。兼主上气咳嗽、喘急、胸膈痞满，止疝痛、腰疼，杀虫及尸疰邪祟。又小儿 卵、妇人阴痒，捣泥敷之。心云∶苦以泻滞血，甘以生新血。"}]},{"ID":"20240614091009-7y6r5ay","Type":"NodeParagraph","Properties":{"id":"20240614091009-7y6r5ay","updated":"20240614091009"},"Children":[{"Type":"NodeText","Data":"血结实者可用，血燥虚者慎之。凡使，汤泡去皮尖，炒赤，研如泥用。桃花，除百病，悦颜色。治水种、石淋，利大小便。三月采，阴干，千叶者不用。桃奴，即干实着树上经冬不落者。微温。治伏梁气在心下结聚不散。"}]},{"ID":"20240614091009-4jsn7x2","Type":"NodeParagraph","Properties":{"id":"20240614091009-4jsn7x2","updated":"20240614091009"},"Children":[{"Type":"NodeText","Data":"烧灰存性，治肺气吐血，诸药不止及胎下血不止。正月采，酒拌蒸软，铜刀切取肉，焙干用。茎白皮，除中恶腹痛，去胃中热。桃枝，戊子日取作枕，补心虚健忘、耳目聪明。煎膏涂口疮及下部 疮，煎汤洗天行疫疠。"}]},{"ID":"20240614091009-c8kn6bv","Type":"NodeParagraph","Properties":{"id":"20240614091009-c8kn6bv","updated":"20240614091009"},"Children":[{"Type":"NodeText","Data":"桃叶，出疮中虫，治霍乱腹痛，大小肠不通，小儿寒热客忤，多用作汤导药。桃实，味酸，无毒。多食令人发热。有味辛者，肺病宜食。食桃讫，入水浴成淋。桃胶，主保中不饥，忍风寒，下石淋，破血，愈百病。桑灰汁煮三次，阴干用。桃寄生，主小儿中蛊毒令腹内坚痛，面目青黄，淋露骨立，病变无常。花、叶、枝、茎等俱能辟不祥，杀邪魅，疗中恶蛊疰，今人用桃作符着门上者，亦取其厌邪也。"}]},{"ID":"20240614090956-vdhrosq","Type":"NodeThematicBreak","Properties":{"id":"20240614090956-vdhrosq"}},{"ID":"20240614090958-48mbb4r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090958-48mbb4r","updated":"20240614091003"},"Children":[{"Type":"NodeText","Data":"桃仁《本草经解》"}]},{"ID":"20240614090958-puwv6g5","Type":"NodeParagraph","Properties":{"id":"20240614090958-puwv6g5","updated":"20240614090958"},"Children":[{"Type":"NodeText","Data":"气平．味苦甘．无毒．主瘀血．血闭症瘕邪气．杀小虫．（双仁者大毒）"}]},{"ID":"20240614090958-1tjia2e","Type":"NodeParagraph","Properties":{"id":"20240614090958-1tjia2e","updated":"20240614090958"},"Children":[{"Type":"NodeText","Data":"桃仁气平．禀天秋收之金气．入手太阴肺经．味苦甘无毒．得地中南火土之味．入手少阴心经、足太阴脾经．气味降多于升．阴也．心主血．脾统血．血者阴也．有形者也．周流乎一身．灌溉乎五脏者也．一有凝滞．非瘀即闭矣．至有形可征即成症．假物成形则成瘕．盖皆心脾不运故也．桃仁甘以和血．苦以散结．则瘀者化．闭者通．而积者消矣．桃为五木之精．能镇辟不祥．所以主邪气．禀火之苦味．所以杀小虫也．"}]},{"ID":"20240614090958-iskj3wg","Type":"NodeParagraph","Properties":{"id":"20240614090958-iskj3wg","updated":"20240614090958"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614090958-k2zmql1","Type":"NodeParagraph","Properties":{"id":"20240614090958-k2zmql1","updated":"20240614090958"},"Children":[{"Type":"NodeText","Data":"桃仁同大黄、朴硝、甘草、桂枝．名桃仁承气汤．治蓄血．"}]},{"ID":"20240614090801-1rl7sqr","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-1rl7sqr"}},{"ID":"20240614090944-dvy4hvy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090944-dvy4hvy","updated":"20240614090951"},"Children":[{"Type":"NodeText","Data":"桃仁《本草便读》"}]},{"ID":"20240614090944-wlk31xj","Type":"NodeParagraph","Properties":{"id":"20240614090944-wlk31xj","updated":"20240614090944"},"Children":[{"Type":"NodeText","Data":"破瘀留于肝络．味苦兼甘．通燥结于肺肠．性平且润．可辟八方之鬼魅．乃缘五木之精英．（桃仁味苦兼甘．性平而润．专入肝经．兼入肺与大肠．破血润燥．杀虫者．虫因血裹而生也．祛风者．血行风自灭也．至其能治肝疟鬼疰疼痛等证．均为肝病血结显然．辟鬼除邪之说．自古相传．故桃符桃枝桃枭桃核之类．皆有所取也．欲散连皮尖．欲降去皮尖．均研用．）"}]},{"ID":"20240614090801-yfgtlcv","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-yfgtlcv"}},{"ID":"20240614090931-llr1utd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090931-llr1utd","updated":"20240614090937"},"Children":[{"Type":"NodeText","Data":"桃仁《要药分剂》"}]},{"ID":"20240614090931-pbewo1n","Type":"NodeParagraph","Properties":{"id":"20240614090931-pbewo1n","updated":"20240614090931"},"Children":[{"Type":"NodeText","Data":"味苦甘。性平。无毒。禀火土之气以生。降也。阴中阳也。香附为使。"}]},{"ID":"20240614090931-fu6fs4f","Type":"NodeParagraph","Properties":{"id":"20240614090931-fu6fs4f","updated":"20240614090931"},"Children":[{"Type":"NodeText","Data":"【主治】主行瘀血。血闭。症瘕。（本经）止咳逆上气。消心下坚硬。除猝暴击血。"}]},{"ID":"20240614090931-70kab55","Type":"NodeParagraph","Properties":{"id":"20240614090931-70kab55","updated":"20240614090931"},"Children":[{"Type":"NodeText","Data":"通月水热燥痒【归经】入肝心包二经。为破血润燥之品。（二经血分药苦能泄血滞甘能缓肝气而生新血）【前论】陈承曰。行血。连皮尖生用。润燥去皮尖炒用。俱研碎。"}]},{"ID":"20240614090931-o44m7wz","Type":"NodeParagraph","Properties":{"id":"20240614090931-o44m7wz","updated":"20240614090931"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。桃仁散而不收。泻而无补。过用或不当。能使血下不止。损伤真阴。"}]},{"ID":"20240614090801-60q2mr5","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-60q2mr5"}},{"ID":"20240614090922-v3q7v3i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090922-v3q7v3i","updated":"20240614090925"},"Children":[{"Type":"NodeText","Data":"桃仁《本草分经》"}]},{"ID":"20240614090922-z7jxeli","Type":"NodeParagraph","Properties":{"id":"20240614090922-z7jxeli","updated":"20240614090922"},"Children":[{"Type":"NodeText","Data":"苦平微甘，缓肝气泄血滞，通大肠血秘，治血燥经闭，热入血室无瘀慎用，泡去皮尖，炒研。桃花苦平，专于攻决，下水除痰，消积聚利二便疗疯狂，千叶者勿用。桃叶苦平，杀虫发汗。桃子辛酸甘热微毒，多食有热生痈疖有损无益。桃枭苦微温，辟邪。"}]},{"ID":"20240614090801-9qnlb84","Type":"NodeThematicBreak","Properties":{"id":"20240614090801-9qnlb84"}},{"ID":"20240614090802-di8soaa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090802-di8soaa","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"《中国药典》：桃仁"}]},{"ID":"20240614090802-41b7xbj","Type":"NodeParagraph","Properties":{"id":"20240614090802-41b7xbj","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614090802-498fvb9","Type":"NodeParagraph","Properties":{"id":"20240614090802-498fvb9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" Táo Rén"}]},{"ID":"20240614090802-04fucuc","Type":"NodeParagraph","Properties":{"id":"20240614090802-04fucuc","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614090802-8pqqja2","Type":"NodeParagraph","Properties":{"id":"20240614090802-8pqqja2","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" SEMEN PERSICAE"}]},{"ID":"20240614090802-dutb71g","Type":"NodeParagraph","Properties":{"id":"20240614090802-dutb71g","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614090802-vmu7nnp","Type":"NodeParagraph","Properties":{"id":"20240614090802-vmu7nnp","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 本品为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃"},{"Type":"NodeText","Data":"Prunus persica （L.） Batsch 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山桃"},{"Type":"NodeText","Data":"Prunus davidiana （Carr.）Franch.的干燥成熟"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。果实成熟后采收，除去果肉及核壳，取出种子，晒干。"}]},{"ID":"20240614090802-bz8queh","Type":"NodeParagraph","Properties":{"id":"20240614090802-bz8queh","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614090802-2s2sg4u","Type":"NodeParagraph","Properties":{"id":"20240614090802-2s2sg4u","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 桃仁：呈扁长卵形，长1.2～1.8cm，宽0.8～1.2cm，厚0.2～0.4cm。表面黄棕色至红棕色，密布颗粒状突起。一端尖，中部膨大，另端钝圆稍扁斜，边缘较薄。尖端一侧有短线形种脐，圆端有颜色略深不甚明显的合点，自合点处散出多数纵向维管束。种皮薄，子叶2，类白色，富油性。气微，味微苦。"}]},{"ID":"20240614090802-idbqb3b","Type":"NodeParagraph","Properties":{"id":"20240614090802-idbqb3b","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"山桃仁：呈类卵圆形，较小而肥厚，长约0.9cm，宽约0.7cm，厚约0.5cm。"}]},{"ID":"20240614090802-si1n757","Type":"NodeParagraph","Properties":{"id":"20240614090802-si1n757","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614090802-pqiu7fo","Type":"NodeParagraph","Properties":{"id":"20240614090802-pqiu7fo","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防蛀。"}]},{"ID":"20240614090802-o3v6261","Type":"NodeParagraph","Properties":{"id":"20240614090802-o3v6261","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614090802-t77fba0","Type":"NodeParagraph","Properties":{"id":"20240614090802-t77fba0","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃仁"},{"Type":"NodeText","Data":"：除去杂质。用时捣碎。"}]},{"ID":"20240614090802-mr9w3mp","Type":"NodeParagraph","Properties":{"id":"20240614090802-mr9w3mp","updated":"20240614090802"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"燀桃仁"},{"Type":"NodeText","Data":"：取净桃仁，照燀法（附录Ⅱ A）去皮。用时捣碎。"}]},{"ID":"20240614090802-uye1ryj","Type":"NodeParagraph","Properties":{"id":"20240614090802-uye1ryj","updated":"20240614090802"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒桃仁"},{"Type":"NodeText","Data":"：取燀桃仁，照清炒法（附录Ⅱ D）炒至黄色。用时捣碎。"}]},{"ID":"20240614090802-17zxvyn","Type":"NodeParagraph","Properties":{"id":"20240614090802-17zxvyn","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614090802-3c1hw1d","Type":"NodeParagraph","Properties":{"id":"20240614090802-3c1hw1d","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 本品种皮粉末（或解离）片："}]},{"ID":"20240614090802-bs9j1iu","Type":"NodeParagraph","Properties":{"id":"20240614090802-bs9j1iu","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"桃仁 石细胞黄色或黄棕色，侧面观贝壳形、盔帽形、弓形或椭圆形，高54～153μm，底部宽约至180μm，壁一边较厚，层纹细密；表面观类圆形、圆多角形或类方形，底部壁上纹孔大而较密。"}]},{"ID":"20240614090802-qswpe17","Type":"NodeParagraph","Properties":{"id":"20240614090802-qswpe17","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"山桃仁 石细胞淡黄色、橙黄色或橙红色，侧面观贝壳形、矩圆形、椭圆形或长条形，高81～198（279）μm，宽约至128（198）μm ；表面观类圆形、类六角形、长多角形或类方形，底部壁厚薄不匀，纹孔较小。"}]},{"ID":"20240614090802-hn0ay26","Type":"NodeParagraph","Properties":{"id":"20240614090802-hn0ay26","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614090802-zjwzfdf","Type":"NodeParagraph","Properties":{"id":"20240614090802-zjwzfdf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 归心、肝、大肠经。"}]},{"ID":"20240614090802-2tc4wld","Type":"NodeParagraph","Properties":{"id":"20240614090802-2tc4wld","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614090802-radq06h","Type":"NodeParagraph","Properties":{"id":"20240614090802-radq06h","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 苦、甘，平。"}]},{"ID":"20240614090802-vwa3o4c","Type":"NodeParagraph","Properties":{"id":"20240614090802-vwa3o4c","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614090802-lgsox2u","Type":"NodeParagraph","Properties":{"id":"20240614090802-lgsox2u","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240614090802-75jmhr4","Type":"NodeParagraph","Properties":{"id":"20240614090802-75jmhr4","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614090802-xujz0uu","Type":"NodeParagraph","Properties":{"id":"20240614090802-xujz0uu","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 活血祛瘀，润肠通便。用于经闭，痛经，癓瘕痞块，跌扑损伤，肠燥便秘。"}]},{"ID":"20240614090802-bmu592t","Type":"NodeParagraph","Properties":{"id":"20240614090802-bmu592t","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614090802-k0v7ssj","Type":"NodeParagraph","Properties":{"id":"20240614090802-k0v7ssj","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 4.5～9g。"}]},{"ID":"20240614090802-imiht8w","Type":"NodeParagraph","Properties":{"id":"20240614090802-imiht8w","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614090802-vf0wpfl","Type":"NodeParagraph","Properties":{"id":"20240614090802-vf0wpfl","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240614090802-znroufp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090802-znroufp","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：桃仁"}]},{"ID":"20240614090802-lqnnn5n","Type":"NodeParagraph","Properties":{"id":"20240614090802-lqnnn5n","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614090802-ssmdygx","Type":"NodeParagraph","Properties":{"id":"20240614090802-ssmdygx","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" Táo Rén"}]},{"ID":"20240614090802-roc3lo3","Type":"NodeParagraph","Properties":{"id":"20240614090802-roc3lo3","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614090802-xsgwzbq","Type":"NodeParagraph","Properties":{"id":"20240614090802-xsgwzbq","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 桃核仁（《本经》）。"}]},{"ID":"20240614090802-30cjecy","Type":"NodeParagraph","Properties":{"id":"20240614090802-30cjecy","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614090802-qptwfou","Type":"NodeParagraph","Properties":{"id":"20240614090802-qptwfou","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240614090802-bc8t5ds","Type":"NodeParagraph","Properties":{"id":"20240614090802-bc8t5ds","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614090802-mva09jp","Type":"NodeParagraph","Properties":{"id":"20240614090802-mva09jp","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山桃"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。6～7月果实成热时采摘，除去果肉及核壳，取出种子，晒干。放阴凉干燥处，防虫蛀、走油。"}]},{"ID":"20240614090802-llayn99","Type":"NodeParagraph","Properties":{"id":"20240614090802-llayn99","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614090802-lor9cts","Type":"NodeParagraph","Properties":{"id":"20240614090802-lor9cts","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 主产四川、云南、陕西、山东、河北、山西、河南等地。"}]},{"ID":"20240614090802-y5luyn9","Type":"NodeParagraph","Properties":{"id":"20240614090802-y5luyn9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614090802-s4p32tw","Type":"NodeParagraph","Properties":{"id":"20240614090802-s4p32tw","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" ①桃（《诗经》）又名：毛桃（《纲目》），白桃、红桃。"}]},{"ID":"20240614090802-6jphnmo","Type":"NodeParagraph","Properties":{"id":"20240614090802-6jphnmo","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"落叶小乔木，高达8米。小枝绿色或半边红褐色，无毛，冬芽有细柔毛。叶互生，在短枝上呈簇生状；叶片椭圆状披针形至倒卵状披针形，中部最阔，长8～15厘米，宽2～3.5厘米，先端长尖，基部阔楔形，边缘具细锯齿，两面无毛；叶柄长7～12毫米，具腺点。花通常单生，直径约2.5～3.5厘米；具短梗；萼片5，基部合生成短萼筒，红色，外面有绒毛；花瓣5，倒卵形，粉红色；雄蕊多数，着生于萼筒边缘；子房1室，花柱细长，柱头小，圆头状。核果近球形，直径5～7厘米，有短绒毛；果肉白色或黄色；核极硬，有不规则的凹点及深沟。种子1枚，扁卵状心形。花期4月，先叶开放。果熟期6～7月。"}]},{"ID":"20240614090802-mjtgk97","Type":"NodeParagraph","Properties":{"id":"20240614090802-mjtgk97","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"全国各地普遍栽培。"}]},{"ID":"20240614090802-igdn594","Type":"NodeParagraph","Properties":{"id":"20240614090802-igdn594","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②山桃（《尔雅》），又名：榹桃（《尔雅》），山毛桃、野桃、花桃。"}]},{"ID":"20240614090802-jlgpcd7","Type":"NodeParagraph","Properties":{"id":"20240614090802-jlgpcd7","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"落叶小乔木，高5～9米。叶互生；托叶早落；叶柄长1.5～3厘米；叶片卵状披针形，长4～8厘米，宽2～3.5厘米，中部以上渐尖，近基部最宽，基部呈广楔形或圆形，边缘具细锯齿。花单生；萼片5，多无毛；花瓣5，阔倒卵形，粉红色至白色。核果近圆形；黄绿色，表面被黄褐色柔毛，果肉离核；核小坚硬，表面有网状的凹纹。种子1枚，棕红色。花期3～4月。果期6～7月。"}]},{"ID":"20240614090802-jigucfg","Type":"NodeParagraph","Properties":{"id":"20240614090802-jigucfg","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"多生于石灰岩的山谷中。分布辽宁、河北、河南、山东、山西、四川、云南、贵州、陕西等地。"}]},{"ID":"20240614090802-vhpwy47","Type":"NodeParagraph","Properties":{"id":"20240614090802-vhpwy47","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"以上两种植物的根及根皮（桃根）、去掉栓皮的树皮（桃茎白皮）、嫩枝（桃枝）、叶（桃叶）、花（桃花）、成熟的果实（桃子）、未成熟的果实（碧桃干）、树脂（桃胶）亦供药用，各详专条。"}]},{"ID":"20240614090802-n4ichl9","Type":"NodeParagraph","Properties":{"id":"20240614090802-n4ichl9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614090802-x1vcyf4","Type":"NodeParagraph","Properties":{"id":"20240614090802-x1vcyf4","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 干燥种子呈扁平长卵形，长1～1.6厘米，宽0.8～1厘米，外表红棕色或黄棕色，有纵皱。先端尖，中间膨大，基部钝圆而扁斜，自底部散出多数脉纹，脐点位于上部边缘上，深褐色，棱线状微突起。种皮菲薄，质脆；种仁乳白色，富含油脂，2子叶之结合面有空隙。气微弱，味微苦。以颗粒均匀、饱满、整齐、不破碎者为佳。"}]},{"ID":"20240614090802-76h6twu","Type":"NodeParagraph","Properties":{"id":"20240614090802-76h6twu","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614090802-st57kfw","Type":"NodeParagraph","Properties":{"id":"20240614090802-st57kfw","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 桃仁含苦杏仁甙约3.6％，挥发油0.4％，脂肪油45％；油中主含油酸甘油酯和少量亚油酸甘油酯。另含苦杏仁酶等。"}]},{"ID":"20240614090802-b4pm28h","Type":"NodeParagraph","Properties":{"id":"20240614090802-b4pm28h","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614090802-usbgmoo","Type":"NodeParagraph","Properties":{"id":"20240614090802-usbgmoo","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 苦杏仁甙之药理见\"杏仁\"条。桃仁的醇提取物有抗血凝作用及较弱的溶血作用。对正常大鼠有降压作用，乃中毒所致。桃仁提取物0.5克（相当生药4.0克）溶于1毫升水中，每日饲喂大鼠，共1周，对血糖、血清蛋白、肝功能检查，及肺、心、肝、脾、肾及肾上腺的组织学检查，皆无异常。"}]},{"ID":"20240614090802-o4xhy8y","Type":"NodeParagraph","Properties":{"id":"20240614090802-o4xhy8y","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614090802-th0enrb","Type":"NodeParagraph","Properties":{"id":"20240614090802-th0enrb","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 除去硬壳杂质，置沸水锅中煮至外皮微皱，捞出，浸入凉水中，搓去种皮，晒干，簸净。"}]},{"ID":"20240614090802-gmho9uq","Type":"NodeParagraph","Properties":{"id":"20240614090802-gmho9uq","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614090802-lumiv9a","Type":"NodeParagraph","Properties":{"id":"20240614090802-lumiv9a","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 入心、肝、大肠经。"}]},{"ID":"20240614090802-2kbvza7","Type":"NodeParagraph","Properties":{"id":"20240614090802-2kbvza7","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手、足厥阴经。\""}]},{"ID":"20240614090802-bk4kj2b","Type":"NodeParagraph","Properties":{"id":"20240614090802-bk4kj2b","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肝、大肠二经。\""}]},{"ID":"20240614090802-sjq7dlb","Type":"NodeParagraph","Properties":{"id":"20240614090802-sjq7dlb","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入手太阴肺经，手少阴心经，足太阴脾经。\""}]},{"ID":"20240614090802-qlqkfj8","Type":"NodeParagraph","Properties":{"id":"20240614090802-qlqkfj8","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614090802-30ma711","Type":"NodeParagraph","Properties":{"id":"20240614090802-30ma711","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 苦甘，平。"}]},{"ID":"20240614090802-ihjmb24","Type":"NodeParagraph","Properties":{"id":"20240614090802-ihjmb24","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240614090802-r6xmlpm","Type":"NodeParagraph","Properties":{"id":"20240614090802-r6xmlpm","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240614090802-rmy28vo","Type":"NodeParagraph","Properties":{"id":"20240614090802-rmy28vo","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"③《千金·食治》：\"味苦甘辛，平，无毒。\""}]},{"ID":"20240614090802-ykn3fzf","Type":"NodeParagraph","Properties":{"id":"20240614090802-ykn3fzf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614090802-vpzh559","Type":"NodeParagraph","Properties":{"id":"20240614090802-vpzh559","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 孕妇忌服。"}]},{"ID":"20240614090802-op3a98x","Type":"NodeParagraph","Properties":{"id":"20240614090802-op3a98x","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"①《医学入门》：\"血燥虚者慎之。\""}]},{"ID":"20240614090802-maaiia5","Type":"NodeParagraph","Properties":{"id":"20240614090802-maaiia5","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"香附为之使。\""}]},{"ID":"20240614090802-wmnxcpf","Type":"NodeParagraph","Properties":{"id":"20240614090802-wmnxcpf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"凡经闭不通由于血枯，而不由于瘀滞；产后腹痛由于血虚，而不由于留血结块；大便不通由于津液不足，而不由于血燥秘结，法并忌之。\""}]},{"ID":"20240614090802-36ypf62","Type":"NodeParagraph","Properties":{"id":"20240614090802-36ypf62","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614090802-ssvm1wl","Type":"NodeParagraph","Properties":{"id":"20240614090802-ssvm1wl","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 破血行瘀，润燥滑肠。治经闭，症瘕，热病蓄血，风痹，疟疾，跌打损伤，瘀血肿痛，血燥便秘。"}]},{"ID":"20240614090802-shcurvf","Type":"NodeParagraph","Properties":{"id":"20240614090802-shcurvf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主瘀血，血闭症瘕，邪气，杀小虫。\""}]},{"ID":"20240614090802-58f09pa","Type":"NodeParagraph","Properties":{"id":"20240614090802-58f09pa","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"止咳逆上气，消心下坚，除卒暴击血，破症瘕，通脉，止痛。\""}]},{"ID":"20240614090802-1mxq1km","Type":"NodeParagraph","Properties":{"id":"20240614090802-1mxq1km","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"③孟诜：\"杀三虫，止心痛。\""}]},{"ID":"20240614090802-atmnljn","Type":"NodeParagraph","Properties":{"id":"20240614090802-atmnljn","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"治大便血结。\""}]},{"ID":"20240614090802-rw5azgf","Type":"NodeParagraph","Properties":{"id":"20240614090802-rw5azgf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑤李杲：\"治热入血室，腹中滞血，皮肤血热燥痒，皮肤凝聚之血。\""}]},{"ID":"20240614090802-rqtv0e8","Type":"NodeParagraph","Properties":{"id":"20240614090802-rqtv0e8","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"治血痰。\""}]},{"ID":"20240614090802-8mvia91","Type":"NodeParagraph","Properties":{"id":"20240614090802-8mvia91","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"主血滞风痹，骨蒸，肝疟寒热，产后血病。\""}]},{"ID":"20240614090802-af8hu81","Type":"NodeParagraph","Properties":{"id":"20240614090802-af8hu81","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑧《现代实用中药》：\"治高血压及慢性盲肠炎，妇人子宫血肿。\""}]},{"ID":"20240614090802-bxlak9c","Type":"NodeParagraph","Properties":{"id":"20240614090802-bxlak9c","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614090802-jluf0dh","Type":"NodeParagraph","Properties":{"id":"20240614090802-jluf0dh","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外用：捣敷。"}]},{"ID":"20240614090802-4y9qcds","Type":"NodeParagraph","Properties":{"id":"20240614090802-4y9qcds","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614090802-h3apcne","Type":"NodeParagraph","Properties":{"id":"20240614090802-h3apcne","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" ①治妇人室女，血闭不通，五心烦热：桃仁（焙）、红花、当归（洗焙）、杜牛膝等分为末。每服三钱，温酒调下，空心食前。（《杨氏家藏方》桃仁散）"}]},{"ID":"20240614090802-0v4blqw","Type":"NodeParagraph","Properties":{"id":"20240614090802-0v4blqw","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②治产后腹痛，干血着脐下，亦主经水不利：大黄三两，桃仁二十枚，蟅虫二十枚（熬，去足）。上三味，末之，炼蜜和为四丸，以酒一升煎一丸，取八合。顿服之，新血下如豚肝。（《金匮要略》下瘀血汤）"}]},{"ID":"20240614090802-tnreev1","Type":"NodeParagraph","Properties":{"id":"20240614090802-tnreev1","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"③治产后血闭：桃仁二十枚（去皮、尖），藕一块。水煎服之。（《唐瑶经验方》）"}]},{"ID":"20240614090802-8okck05","Type":"NodeParagraph","Properties":{"id":"20240614090802-8okck05","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"④治产后恶露不净，脉弦滞涩者：桃仁三钱，当归三钱，赤芍、桂心各钱半，沙糖三钱（炒炭）。水煎，去渣温服。（《医略六书》桃仁煎）"}]},{"ID":"20240614090802-ti5cqzp","Type":"NodeParagraph","Properties":{"id":"20240614090802-ti5cqzp","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑤治血癥，漏下不止：桃仁（去皮、尖，熬）、芍药、桂枝、茯苓、牡丹（去心）各等分。上五味为末，炼蜜和丸如兔屎大。每日食前服一丸，不知，加至三丸。（《金匮要略》桂枝茯苓丸）"}]},{"ID":"20240614090802-6oey0ym","Type":"NodeParagraph","Properties":{"id":"20240614090802-6oey0ym","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑥治太阳病不解，热结膀胱，其人如狂，少腹急结：桃仁五十个（去皮、尖），大黄四两，桂枝二两（去皮），甘草（炙）二两，芒硝二两。上五味，以水七升，煮取二升半，去滓，内芒硝，更上火微沸，下火。先食温服五合，日三服，当微利。（《伤寒论》桃核承气汤）"}]},{"ID":"20240614090802-s6yl0x2","Type":"NodeParagraph","Properties":{"id":"20240614090802-s6yl0x2","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑦治伤寒蓄血，发热如狂，少腹鞕满，小便自利：桃仁二十个（去皮、尖），大黄三两（酒洗），水蛭（熬）、虻虫（去翅、足，熬）各三十个。上四味，以水五升，煮取三升，去滓。温服一升，不下，更服。（《伤寒论》抵当汤）"}]},{"ID":"20240614090802-qka69h0","Type":"NodeParagraph","Properties":{"id":"20240614090802-qka69h0","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑧治热邪干于血分，溺血蓄血者：桃仁三钱（研如泥），丹皮、当归、赤芍各一钱，阿胶二钱，滑石五钱。水煎服。（《瘟疫论》桃仁汤）"}]},{"ID":"20240614090802-3aya6c7","Type":"NodeParagraph","Properties":{"id":"20240614090802-3aya6c7","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑨治上气咳嗽，胸膈痞满，气喘：桃仁三两，去皮、尖，以水一大升，研汁，和粳米二合，煮粥食。（《食医心镜》）"}]},{"ID":"20240614090802-6lzrzr6","Type":"NodeParagraph","Properties":{"id":"20240614090802-6lzrzr6","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑩治老人虚秘：桃仁、柏子仁、火麻仁、松子仁等分。同研，烙白蜡和丸如桐子大，以少黄丹汤下。（《汤液本草》）"}]},{"ID":"20240614090802-lbda0n8","Type":"NodeParagraph","Properties":{"id":"20240614090802-lbda0n8","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑾治里急后重，大便不快：桃仁（去皮）三两，吴茱萸二两，盐一两。上三味，同炒熟，去盐并茱萸。只以桃仁，空心夜卧不拘时，任意嚼五、七粒至一、二十粒。（《圣济总录》）"}]},{"ID":"20240614090802-pmeao8z","Type":"NodeParagraph","Properties":{"id":"20240614090802-pmeao8z","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑿治从高坠下，胸腹中有血，不得气息：桃仁十四枚，大黄、消石、甘草各一两，蒲黄一两半，大枣二十枚。上六味，细切，以水三升，煮取一升，绞去滓，适寒温尽服之。当下，下不止，渍麻汁一杯，饮之即止。（《千金方》桃仁汤）"}]},{"ID":"20240614090802-m7ue3to","Type":"NodeParagraph","Properties":{"id":"20240614090802-m7ue3to","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒀治疟：桃仁一百个，去皮、尖，于乳钵中细研成膏，不得犯生水，候成膏，入黄丹三钱，丸如梧桐子大。每服三丸，当发日用温酒吞下，如不饮酒，井花水亦得。（《证类本草》）"}]},{"ID":"20240614090802-zqsw5m4","Type":"NodeParagraph","Properties":{"id":"20240614090802-zqsw5m4","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒁治风劳毒肿挛痛，或牵引小腹及腰痛：桃仁一升，去皮、尖，熬令黑烟出，热研如脂膏。以酒三升，搅和服，暖卧取汗。（《食医心镜》）"}]},{"ID":"20240614090802-qmddznf","Type":"NodeParagraph","Properties":{"id":"20240614090802-qmddznf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒂治崩中漏下赤白不止，气虚竭：烧桃核为末，酒服方寸匕，日三。（《千金方》）"}]},{"ID":"20240614090802-xb7v2c9","Type":"NodeParagraph","Properties":{"id":"20240614090802-xb7v2c9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒃治小儿烂疮初起，膘浆似火疮：杵桃仁面脂敷上。（《子母秘录》）"}]},{"ID":"20240614090802-wpsostq","Type":"NodeParagraph","Properties":{"id":"20240614090802-wpsostq","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒄治聤耳：桃仁熟捣，以故绯绢裹，纳耳中，日三易，以瘥为度。（《千金方》）"}]},{"ID":"20240614090802-an8hr3k","Type":"NodeParagraph","Properties":{"id":"20240614090802-an8hr3k","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒅治风虫牙痛：针刺桃仁，灯上烧烟出，吹灭，安痛齿上咬之。（《卫生家宝方》）"}]},{"ID":"20240614090802-y6bvczn","Type":"NodeParagraph","Properties":{"id":"20240614090802-y6bvczn","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⒆治女人阴户内生疮，作痛如虫咬，或作痒难忍者：桃仁、桃叶相等捣烂，丝绵纳裹其中，日易三、四次。（孟诜）"}]},{"ID":"20240614090802-tl2uzcf","Type":"NodeParagraph","Properties":{"id":"20240614090802-tl2uzcf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614090802-y23bllx","Type":"NodeParagraph","Properties":{"id":"20240614090802-y23bllx","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" ①成无己：\"肝者血之源，血聚则肝气燥，肝苦急，急食甘以缓之。桃仁之甘以缓肝散血，故张仲景抵当汤用之，以治伤寒八、九日，内有蓄血，发热如狂，小腹满痛，小便自利者。又有当汗失汗，热毒深入，吐血及血结胸，烦躁讝语者，亦以此汤主之。与虻虫、水蛭、大黄同用。\""}]},{"ID":"20240614090802-kqsnksy","Type":"NodeParagraph","Properties":{"id":"20240614090802-kqsnksy","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"②《用药心法》：\"桃仁，苦以泄滞血，甘以生新血，故凝血须用。又去血中之热。\""}]},{"ID":"20240614090802-yzl983a","Type":"NodeParagraph","Properties":{"id":"20240614090802-yzl983a","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"桃仁行血，宜连皮尖生用；润燥活血，宜汤浸去皮尖炒黄用，或麦麸同炒，或烧存性，各随本方。\""}]},{"ID":"20240614090802-sma6gtz","Type":"NodeParagraph","Properties":{"id":"20240614090802-sma6gtz","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"夫血者阴也；有形者也，周流夫一身者也，一有凝滞则为癥瘕，瘀血血闭，或妇人月水不通，或击扑损伤积血，及心下宿血坚痛，皆从足厥阴受病，以其为藏血之脏也。桃核仁苦能泄滞，辛能散结，甘温通行而缓肝，故主如上等证也。心下宿血去则气自下，咳逆自止。味苦而辛，故又能杀小虫也。\"\"桃仁性善破血，散而不收，泻而无补，过用之，及用之不得其当，能使血下不止，损伤真阴。\""}]},{"ID":"20240614090802-345t0mr","Type":"NodeParagraph","Properties":{"id":"20240614090802-345t0mr","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑤《药品化义》：\"桃仁，味苦能泻血热，体润能滋肠燥。若连皮研碎多用，走肝经，主破蓄血，逐月水，及遍身疼痛，四肢木痹，左半身不遂，左足痛甚者，以其舒经活血行血，有去瘀生新之功，若去皮捣烂少用，入大肠，治血枯便闭，血燥便难，以其濡润凉血和血，有开结通滞之力。\""}]},{"ID":"20240614090802-e0bpw3r","Type":"NodeParagraph","Properties":{"id":"20240614090802-e0bpw3r","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑥《本经逢原》：\"桃仁，为血瘀血闭之专药。苦以泄滞血，甘以生新血。毕竟破血之功居多，观《本经》主治可知。仲景桃核承气、抵当汤，皆取破血之用。又治热入血室，瘀积癥瘕，经闭，疟母，心腹痛，大肠秘结，亦取散肝经之血结。熬香治颓疝痛痒，《千金》法也。\""}]},{"ID":"20240614090802-czl6ptn","Type":"NodeParagraph","Properties":{"id":"20240614090802-czl6ptn","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"⑦《本草思辨录》：\"桃仁，主攻瘀血而为肝药，兼疏肤腠之瘀。惟其为肝药，故桃核承气汤、抵当汤、抵当丸治在少腹，鳖甲煎丸治在胁下，大黄牡丹汤治在大肠，桂枝茯苓丸治在癥痼，下瘀血汤治在脐下。惟其兼疏肤腠之瘀，故大黄蟅虫丸治肌肤甲错，《千金》苇茎汤治胸中甲错，王海藏以桂枝红花汤加海蛤、桃仁治妇人血结胸，桃仁之用尽于是矣。\""}]},{"ID":"20240614090802-ix261ey","Type":"NodeParagraph","Properties":{"id":"20240614090802-ix261ey","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614090802-tssma6m","Type":"NodeParagraph","Properties":{"id":"20240614090802-tssma6m","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614090802-75ezyyn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614090802-75ezyyn","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"《中华本草》：桃仁"}]},{"ID":"20240614090802-9uxoom7","Type":"NodeParagraph","Properties":{"id":"20240614090802-9uxoom7","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614090802-gf1tdph","Type":"NodeParagraph","Properties":{"id":"20240614090802-gf1tdph","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" Táo Rén"}]},{"ID":"20240614090802-8rpgerc","Type":"NodeParagraph","Properties":{"id":"20240614090802-8rpgerc","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614090802-5376dx7","Type":"NodeParagraph","Properties":{"id":"20240614090802-5376dx7","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 桃核仁、桃核人"}]},{"ID":"20240614090802-k6z4e7v","Type":"NodeParagraph","Properties":{"id":"20240614090802-k6z4e7v","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614090802-c9jv3c0","Type":"NodeParagraph","Properties":{"id":"20240614090802-c9jv3c0","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" Peach Seed"}]},{"ID":"20240614090802-izbr1i3","Type":"NodeParagraph","Properties":{"id":"20240614090802-izbr1i3","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614090802-1bfi4td","Type":"NodeParagraph","Properties":{"id":"20240614090802-1bfi4td","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 出自《本草经集注》。"}]},{"ID":"20240614090802-n1e5wuv","Type":"NodeParagraph","Properties":{"id":"20240614090802-n1e5wuv","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：桃核仁并花、实等，今处处皆有之，京东、陕西出者尤大而美。大都佳果，多是圃人以他木接根上栽之，遂至肥美，殊失本性，此等药中不可用之，当以一生者为佳。七月采核破之，取仁阴干。今都下市贾多取炒货之，云食之亦益人。然亦多杂接实之核，为不堪也。"}]},{"ID":"20240614090802-w3m9b0z","Type":"NodeParagraph","Properties":{"id":"20240614090802-w3m9b0z","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.《纲目》，惟山中毛桃，即《尔雅》所谓榹桃者，小而多毛，核粘味恶，其仁充满多脂，可入药用，盖外不足者，内有余也"}]},{"ID":"20240614090802-1mj0128","Type":"NodeParagraph","Properties":{"id":"20240614090802-1mj0128","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614090802-9s4tenw","Type":"NodeParagraph","Properties":{"id":"20240614090802-9s4tenw","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物桃或山桃的种子"}]},{"ID":"20240614090802-q43cip0","Type":"NodeParagraph","Properties":{"id":"20240614090802-q43cip0","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Amygdalus persica L.[Prunus persica (L.) Batsch.]2.Amygdalus davidiana (Carr.)C.de Vos ex Henry[Persica davidiana Carr.;Prunus davidiana (Carr.) Franch.]"}]},{"ID":"20240614090802-lja55yz","Type":"NodeParagraph","Properties":{"id":"20240614090802-lja55yz","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"采收和储藏：6-7月果实成熟时采摘，除去果肉及核壳，取出种子，晒干。放阴凉干燥处，防虫蛀、走油。"}]},{"ID":"20240614090802-2imh2vw","Type":"NodeParagraph","Properties":{"id":"20240614090802-2imh2vw","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614090802-ntbev9c","Type":"NodeParagraph","Properties":{"id":"20240614090802-ntbev9c","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔800-1200m的山坡、山谷沟底或荒野疏林及灌丛内。"}]},{"ID":"20240614090802-aqk5nqm","Type":"NodeParagraph","Properties":{"id":"20240614090802-aqk5nqm","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"资源分布：1.桃全国各地普遍栽培。"}]},{"ID":"20240614090802-6nuqg2j","Type":"NodeParagraph","Properties":{"id":"20240614090802-6nuqg2j","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.分布于河北、山西、陕西、甘肃、山东、河南、四川、云南等地。"}]},{"ID":"20240614090802-s01udhv","Type":"NodeParagraph","Properties":{"id":"20240614090802-s01udhv","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614090802-7vgvnpf","Type":"NodeParagraph","Properties":{"id":"20240614090802-7vgvnpf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 1.桃 落叶小乔木，高达3-8m。小枝绿色或半边红褐色，无毛。叶互生，在短枝上呈簇生状；叶柄长1-2cm，通常有1至数枚腺体；叶片椭圆状披针形至倒卵状披针形，边缘具细锯齿，两面无毛。花通常单生，生于叶开放，直径约2.5-3.5cm，具短梗；萼片5，基部合生成短萼筒，无毛。叶柄长7-12mm，具腺点。花通常单生，直径约2.5-3.5cm；具短梗；萼片5，基部合生成短萼筒，外被绒毛；花瓣5，倒卵形，粉红色；罕为白色；雄蕊多数，子房1室。花柱细长，柱头小，圆头状。核果近球形，直径5-7cm，表面有短绒毛；果肉白色或黄色；离核或粘核。种子1枚，扁卵状心形。花期3-4月，果期6-7月。"}]},{"ID":"20240614090802-59j411t","Type":"NodeParagraph","Properties":{"id":"20240614090802-59j411t","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.山桃 落叶小乔木，高5-9m。叶互生；托叶早落；叶柄长1.5-3cm；叶片卵状披针形，长4-8cm，宽2-3.5cm，花单生，萼片5，花瓣5，阔倒卵形，粉红色至白色。核果近圆形，黄绿色，表面被黄褐色柔毛。果肉离核；核小，坚硬。种子1颗，棕红色。花期3-4月。果期6-7月。"}]},{"ID":"20240614090802-bq262ww","Type":"NodeParagraph","Properties":{"id":"20240614090802-bq262ww","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614090802-k8wi001","Type":"NodeParagraph","Properties":{"id":"20240614090802-k8wi001","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 生物学特性 1.桃 喜阳光和温暖的气候，在肥沃高燥的砂质壤土中生长最好。怕涝，在低洼碱性土壤中生长不良。幼树抗寒力弱，容易冻梢。耐修剪，寿命较短。"}]},{"ID":"20240614090802-xjxzzlz","Type":"NodeParagraph","Properties":{"id":"20240614090802-xjxzzlz","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.山桃 喜光，在半阴处也能生长，耐寒，耐旱。对土壤要求不严贫瘠、荒山均可种植。"}]},{"ID":"20240614090802-88ig5t3","Type":"NodeParagraph","Properties":{"id":"20240614090802-88ig5t3","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"栽培技术 1. 桃 以嫁接繁殖为主。用山桃、毛桃、为砧木，可增强其抗涝、抗寒性。供砧木用桃核在湿沙中完成春化阶段，使硬壳容易裂开，易于发芽，3月播种，4月上旬即可出芽。有经沙藏的种子，可在秋季播种，选地势高燥的圃地培育桃苗，苗木生长迅速，当年秋季幼苗可长20-30cm高。芽接一般以8月下旬、中旬为宜，多采用丁字形芽接法，或在春季4月上旬进行枝接，多采用切接、腹接和劈接法。"}]},{"ID":"20240614090802-chkn0d9","Type":"NodeParagraph","Properties":{"id":"20240614090802-chkn0d9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.山桃 用种子繁殖。6-9月份摘下成熟果实，除去果肉，将种子在水中冲洗干净，捞出晾干，沙藏。春播，3月上旬进行至4月初播种，把经过沙藏种子取出，按行株距35cm×(20-30)cm，深5-6cm穴播，覆土，浇水，15d左右可出苗。幼苗在苗圃培育1-2年出圃定植。秋播于10月中旬至11月上旬，可以当年采收的种子，不经沙藏处理，直接播种，于翌年春生苗。山桃苗木一般常作为桃树品种的砧木。"}]},{"ID":"20240614090802-ca0blhv","Type":"NodeParagraph","Properties":{"id":"20240614090802-ca0blhv","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"田间管理 1.桃 注意整形修剪，加强土、肥、水管理。"}]},{"ID":"20240614090802-luzu1ib","Type":"NodeParagraph","Properties":{"id":"20240614090802-luzu1ib","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2 .山桃 幼苗出土后，应及时进行追肥、浇水、中耕除草。定植结果后，于每年的冬季进行修剪，剪除徒长枝、过密枝、病虫枝、细弱枝，使通风透光，提高果实的产量。"}]},{"ID":"20240614090802-06vr1j8","Type":"NodeParagraph","Properties":{"id":"20240614090802-06vr1j8","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"病虫害防治1.桃 抗病能力弱，量易遭受虫害。桃炭疽病，主要为害果实，也为害叶和新梢，发芽前喷波美3度石硫合剂，发芽后喷65%代森锌500倍液2-3次。流胶病，发生在树枝干，加强栽培管理，枝干涂白，预防冻害和日烧伤，防治蛀食枝干的害虫。桃蚜，为害叶片，发芽前喷波美3度石硫合剂，生长期用2.5%溴氰菊酯5000倍液。"}]},{"ID":"20240614090802-5x3bhcy","Type":"NodeParagraph","Properties":{"id":"20240614090802-5x3bhcy","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.山桃 桃缩叶病，为害叶片、新梢、果实，严重时造成落叶甚至枝条枯死。发芽前喷波美5度石硫合剂。虫害有桃芽、桃粉蚜。"}]},{"ID":"20240614090802-cyum1k9","Type":"NodeParagraph","Properties":{"id":"20240614090802-cyum1k9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614090802-flqamk0","Type":"NodeParagraph","Properties":{"id":"20240614090802-flqamk0","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 性状鉴定：桃仁 种子呈扁椭圆形，先端具尖，中部略膨大，基部钝圆而偏斜，边缘较薄。长1.2-1.8cm，宽0.8-1.2cm，厚2-4mm。表面红棕色或黄棕色，有细小颗粒状突起。尖端一侧有一棱线状种脐，基部有合点，并自该处分散出多数棕色维管束脉纹，形成布满种皮的纵向凹纹，种皮薄。子叶肥大，富油质。气微，味微苦。"}]},{"ID":"20240614090802-3djeyr9","Type":"NodeParagraph","Properties":{"id":"20240614090802-3djeyr9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.山桃仁 种子呈卵圆形，基部偏斜，较小而肥厚。长0.9-1.5cm，宽约7mm，厚约5mm。种皮红棕色或黄棕色，表面颗粒较粗而密。"}]},{"ID":"20240614090802-jho4i2i","Type":"NodeParagraph","Properties":{"id":"20240614090802-jho4i2i","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"匀以饱满、种仁白、完整为佳。"}]},{"ID":"20240614090802-aqwebch","Type":"NodeParagraph","Properties":{"id":"20240614090802-aqwebch","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"显微鉴别：1.桃仁 黄白色。①种皮外表皮石细胞，单个散在或2-5（-11）个连接成行或聚集成群。侧面观多呈贝壳形、盔帽形或弓形，径向54-153μm，底部切向18-180μm，突出于表皮层的部分呈拱形，壁厚约34μm，层纹细密整齐，孔沟无稀少，底部壁厚约12μm，层纹少见，孔沟及纹孔较密，胞腔内含淡棕色物，表面观呈类圆形、圆多角形，或类方形，纹孔大而较密。另有纺锤形石细胞，宽约至230μm。②种皮外表皮细胞橙红色或樱红色，呈类圆形或多角形，常与石细胞连生。③种皮内表皮细胞淡黄棕色或红棕色，断面观为1列类长方形色素细胞，表面呈类多角形，垂周壁微波状弯曲。④内胚乳细胞，壁稍厚，胞腔内含脂肪油滴。⑤子叶细胞含糊粉及脂肪油滴。"}]},{"ID":"20240614090802-4zzyhib","Type":"NodeParagraph","Properties":{"id":"20240614090802-4zzyhib","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.山桃 黄白色。①种皮外表皮石细胞，侧面观呈贝壳形、矩圆形、椭圆形或长条形，径向81-198（-279）μm，切向27-128（-198）μm，突出部分近圆拱形，壁厚约34μm，层纹细密整齐，孔沟无或稀少，底部壁厚薄不匀，薄处层纹少见，孔沟较密，厚处层纹明显，无孔沟；表面观呈类圆形、类六角形、长多角形、类方形或类斜方形，有的一端锐尖，壁厚薄相间，角隅处特厚，层纹明显，壁厚处有孔沟。偶见非腺毛状石细胞，长至234μm，直径23-42μm。②草酸钙簇晶少数，直径12-27μm。另有种皮外表皮细胞、种皮内表皮细胞、内胚乳细胞及子叶细胞。"}]},{"ID":"20240614090802-rakfwbu","Type":"NodeParagraph","Properties":{"id":"20240614090802-rakfwbu","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614090802-gljh34e","Type":"NodeParagraph","Properties":{"id":"20240614090802-gljh34e","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 对正常大鼠有降压作用，乃中毒所致。桃仁提取物0.5g(相当生药4.0g)溶于 1ml水中，每日饲喂大鼠，共 1周，对血糖、血清蛋白、肝功能检查，及肺、心、肝、脾、肾及肾上腺的组织学检查，皆无异常。"}]},{"ID":"20240614090802-weskcme","Type":"NodeParagraph","Properties":{"id":"20240614090802-weskcme","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614090802-342dt7m","Type":"NodeParagraph","Properties":{"id":"20240614090802-342dt7m","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 桃仁含苦杏仁甙(amygdalin)，24-亚甲基环木菠萝烷醇(24-methylene cycloartanol)，柠檬甾二烯醇(citrostadienol)，7-去氢燕麦甾醇(7-dehydroavenasterol)，野樱甙(prunasin)，β-谷甾醇(β-sitosterol)，菜油甾醇(campesterol)，β-谷甾醇-3-O-β-D-吡喃葡萄糖甙(β-sitosterol-3-O-β-D-glucopyranoside)，菜油甾醇-3-O-β-D-吡喃葡萄糖甙(campesterol-3-O-β-D-glucopyranoside)，β-谷甾醇-3-O-β-D-（6-O-棕榈酰）吡喃葡萄糖甙[β-sitosterol3-O-β-D-(6-O-palmityl)glucopyranoside]，β-谷甾醇-3-O-β-D-（6-O-油酰）吡喃葡萄糖甙[β-sitosterol3-O-β-D-(6-0-oleyl)glucopyranoside]，菜油甾醇-3-O-β-D-（6-O-棕榈酰）吡喃葡萄糖甙[campesterol3-O-β-D-(6-O-palmityl)glucopyranoside]，菜油甾醇-3-O-β-D-（6-O-油酰）吡喃葡萄糖甙[campesterol3-O-β-D-(6-O-o-leyl)glucopyranoside]，甲基-a-D-呋喃果糖甙(methyl-a-D-fructofuranoside)，甲基-β-D-吡喃葡萄糖甙(methyl-β-D-glucopyranoside)，色氨酸(tryptophane)，葡萄糖(glucose)及蔗糖(sucrose)。还含绿原素(chlorogenic acid)，3-咖啡酰奎宁酸(3-caffeoylquinic acid)，3-对香豆酰奎宁酸(3-ρ-coumaroylquinic acid)，3-阿魏酰奎宁酸(3-feruloylquinic acid)，甘油三油酸酯(triolein)。又从桃仁中分离到2种蛋白质成分PR-A和PR-B，有强的抗炎镇痛药理活性。桃仁油富含不饱和脂肪酸，主要为油酸(oleic acid)和亚油酸(linoleic acid)。"}]},{"ID":"20240614090802-5nw4t4d","Type":"NodeParagraph","Properties":{"id":"20240614090802-5nw4t4d","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614090802-is4uhjs","Type":"NodeParagraph","Properties":{"id":"20240614090802-is4uhjs","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 1.祛瘀血作用：本品水煎醇沉液可使离体兔耳静脉血管流量增加，有舒张血管作用。给麻醉犬动脉注射，能增加股动脉血流量及降低血管阻力，对血管壁有直接扩张作用。本品还有抑制血液凝固和溶血作用。桃仁提取物50mg/ml，脾动脉内给药可使麻醉大鼠肝脏微循环内血流加速,并与剂量相关，提示对肝脏表面微循环有一定的改善作用。"}]},{"ID":"20240614090802-mrv68jj","Type":"NodeParagraph","Properties":{"id":"20240614090802-mrv68jj","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.抗炎作用：本品在的蛋白成分中的两个均一蛋白成分，静脉注射给药，对二甲苯所致小鼠耳急性炎症反应，均有显着抑制作用。"}]},{"ID":"20240614090802-y92zz0s","Type":"NodeParagraph","Properties":{"id":"20240614090802-y92zz0s","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"3.抗过敏作用：桃仁水提物能抑制小鼠血清中的皮肤过敏抗体及鼷鼠脾溶血性细胞的产生，其乙醇提取物口服能抑制小鼠含有皮肤过敏性抗体的抗血清引起的PCA反应（被动皮肤过敏反应）的色素渗出量。"}]},{"ID":"20240614090802-gp5swai","Type":"NodeParagraph","Properties":{"id":"20240614090802-gp5swai","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"4.其它作用：苦否仁甙，有镇咳作用。桃仁中的脂肪油（扁桃油）有驱虫作用，对蛲虫的驱虫效果为80.8%，对蛔虫效果为70%。"}]},{"ID":"20240614090802-kb2uchq","Type":"NodeParagraph","Properties":{"id":"20240614090802-kb2uchq","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614090802-4vw3q5r","Type":"NodeParagraph","Properties":{"id":"20240614090802-4vw3q5r","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 除去硬壳杂质，置沸水锅中煮至外皮微皱，捞出，浸入凉水中，搓去种皮，晒干，簸净。"}]},{"ID":"20240614090802-97ukx2o","Type":"NodeParagraph","Properties":{"id":"20240614090802-97ukx2o","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614090802-0jeko0j","Type":"NodeParagraph","Properties":{"id":"20240614090802-0jeko0j","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 心；肝；大肠；肺；脾经"}]},{"ID":"20240614090802-tgaavja","Type":"NodeParagraph","Properties":{"id":"20240614090802-tgaavja","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614090802-48uzz5c","Type":"NodeParagraph","Properties":{"id":"20240614090802-48uzz5c","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 苦甘；平；无毒"}]},{"ID":"20240614090802-q5tghot","Type":"NodeParagraph","Properties":{"id":"20240614090802-q5tghot","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614090802-m7qlxy5","Type":"NodeParagraph","Properties":{"id":"20240614090802-m7qlxy5","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 孕妇忌服。"}]},{"ID":"20240614090802-1pnwtxz","Type":"NodeParagraph","Properties":{"id":"20240614090802-1pnwtxz","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"1.《医学入门》：血燥虚者慎之。"}]},{"ID":"20240614090802-zumtyjn","Type":"NodeParagraph","Properties":{"id":"20240614090802-zumtyjn","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：凡经闭不通由于血枯，而不由于瘀滞；产后腹痛由于血虚，而不由于留血结块；大便不通由于津液不足，而不由于血燥秘结，法并忌之。"}]},{"ID":"20240614090802-abq9bkb","Type":"NodeParagraph","Properties":{"id":"20240614090802-abq9bkb","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614090802-l4wazat","Type":"NodeParagraph","Properties":{"id":"20240614090802-l4wazat","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 破血行瘀；润燥滑肠。主经闭；症瘕；热病蓄血；风痹；疟疾；跌打损伤；瘀血肿痛；血燥便秘"}]},{"ID":"20240614090802-tvk8hog","Type":"NodeParagraph","Properties":{"id":"20240614090802-tvk8hog","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614090802-2dsc9o9","Type":"NodeParagraph","Properties":{"id":"20240614090802-2dsc9o9","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5-3钱；或入丸、散。外用：捣敷"}]},{"ID":"20240614090802-2to6t0o","Type":"NodeParagraph","Properties":{"id":"20240614090802-2to6t0o","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614090802-msswdwk","Type":"NodeParagraph","Properties":{"id":"20240614090802-msswdwk","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" ①治妇人室女，血闭不通，五心烦热：桃仁(焙)、红花、当归(洗焙)、杜牛膝等分为末。每服三钱，温酒调下，空心食前。(《杨氏家藏方》桃仁散)②治产后腹痛，干血着脐下，亦主经水不利：大黄三两，桃仁二十枚，ZHE虫二十枚(熬，去足)。上三味，末之，炼蜜和为四丸，以酒一升煎一丸，取八合。顿服之，新血下如豚肝。(《金匮要略》下瘀血汤)③治产后血闭：桃仁二十枚(去皮、尖)，藕一块。水煎服之。(《唐瑶经验方》)④治产后恶露不净，脉弦滞涩者：桃仁三钱，当归三钱，赤芍、桂心各钱半，沙糖三钱(炒炭)。水煎，去渣温服。(《医略六书》桃仁煎)⑤治血症，漏下不止：桃仁(去皮、尖，熬)、芍药、桂枝、茯苓、牡丹(去心)各等分。上五味为末，炼蜜和丸如兔屎大。每日食前服一丸，不知，加至三丸。(《金匮要略》桂枝茯苓丸)⑥治太阳病不解，热结膀胱，其人如狂，少腹急结：桃仁五十个(去皮、尖)，大黄四两，桂枝二两(去皮)，甘草(炙)二两，芒硝二两。上五味，以水七升，煮取二升半，去滓，内芒硝，更上火微沸，下火。先食温服五合，日三服，当微利。(《伤寒论》桃核承气汤)⑦治伤寒蓄血，发热如狂，少腹鞕满，小便自利：桃仁二十个(去皮、尖)，大黄三两(酒洗)，水蛭(熬)、蛀虫(去翅、足，熬)各三十个。上四味，以水五升，煮取三升，去滓。温服一升，不下，更服。(《伤寒论》抵当汤)⑧治热邪干于血分，溺血蓄血者：桃仁三钱(研如泥)，丹皮、当归、赤芍各一钱，阿胶二钱，滑石五钱。水煎服。(《瘟疫论》桃仁汤)⑨治上气咳嗽，胸膈痞满，气喘：桃仁三两，去皮、尖，以水一大升，研汁，和粳米二合，煮粥食。(《食医心镜》)⑩治老人虚秘：桃仁、柏子仁、火麻仁、松子仁等分。同研，熔白蜡和丸如桐子大，以少黄丹汤下。(《汤液本草》)11.治里急后重，大便不快：桃仁(去皮)三两，吴茱萸二两，盐一两。上三味，同炒熟，去盐并茱萸。只以桃仁，空心夜卧不拘时，任意嚼五、七粒至一、二十～粒。(《圣济总录》)12.治从高坠下，胸腹中有血，不得气息：桃仁十四枚，大黄、消石、甘草各一两，蒲黄一两半，大枣二十枚。上六味，细切，以水三升，煮取一升，绞去滓，适寒温尽服之。当下，下不止，渍麻汁一杯，饮之即止。(《千金方》桃仁汤)13.治疟：桃仁一百个，去皮、尖，于乳钵中细研成膏，不得犯生水，候成膏，入黄丹三钱，丸如梧桐子大。每服三丸，当发日用温酒吞下，如不饮酒，井花水亦得。(《证类本草》)14.治风劳毒肿挛痛，或牵引小腹及腰痛：桃仁一升，去皮、尖，熬令黑烟出，热研如脂膏。以酒三升，搅和服，暖卧取汗。(《食医心镜》)15.治崩中漏下赤白不止，气虚竭：烧桃核为末，酒服方寸匕，日三。(《千金方》)16.治小儿烂疮初起，膘浆似火疮：杵桃仁面脂敷上。(《子母秘录》)17.治聤耳：桃仁熟捣，以故绯绢裹，纳耳中，日三易，以瘥为度。(《千金方》)18.治风虫牙痛：针刺桃仁，灯上烧烟出，吹灭，安痛齿上咬之。(《卫生家宝方》)19.治女人阴户内生疮，作痛如虫咬，或作痒难忍者：桃仁、桃叶相等捣烂，丝绵纳裹其中，日易三、四次。(孟诜)"}]},{"ID":"20240614090802-wrdovwf","Type":"NodeParagraph","Properties":{"id":"20240614090802-wrdovwf","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614090802-in3oc3c","Type":"NodeParagraph","Properties":{"id":"20240614090802-in3oc3c","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 1.成无己：肝者血之源，血聚则肝气燥，肝苦急，急食甘以缓之。桃仁之甘以缓肝散血，故张仲景抵当汤用之，以治伤寒八、九日，内有蓄血，发热如狂，小腹满痛，小便自利者。又有当汗失汗，热毒深入，吐血及血结胸，烦躁谵语者，亦以此汤主之。与虻虫、水蛭、大黄同用。"}]},{"ID":"20240614090802-x0p4yqt","Type":"NodeParagraph","Properties":{"id":"20240614090802-x0p4yqt","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"2.《用药心法》：桃仁，苦以泄滞血，甘以生新血，故凝血须用。又去血中之热。"}]},{"ID":"20240614090802-sdkb6mp","Type":"NodeParagraph","Properties":{"id":"20240614090802-sdkb6mp","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：桃仁行血，宜连皮尖生用；润燥活血，宜汤浸去皮尖炒黄用，或麦麸同炒，或烧存性，各随本方。"}]},{"ID":"20240614090802-hqxujem","Type":"NodeParagraph","Properties":{"id":"20240614090802-hqxujem","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"4.《本草经硫》：夫血者阴也，有形者也，周流夫一身者也，一有凝滞则为症瘕，瘀血血闭，或妇人月水不通，或击扑损伤积血，及心下宿血坚痛，皆从足厥阴受病，以其为藏血之脏也。桃核仁苦能泄滞，辛能散结，甘温通行而缓肝，故主如上等证也。心下宿血去则气自下，咳逆自止。味苦而辛，故又能杀小虫也。桃仁性善被血，散而不收，泻而无补，过用之，及用之不得其当，能使血下不止，损伤真阴。"}]},{"ID":"20240614090802-ab5seas","Type":"NodeParagraph","Properties":{"id":"20240614090802-ab5seas","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"5.《药品化义》：桃仁，味苦能泻血热，体润能滋肠燥。若连皮研碎多用，走肝经，主破蓄血，逐月水，及遍身疼痛，四肢木痹，左半身不遂，左足痛甚者，以其舒经活血行血，有去瘀生新之功，若去皮捣烂少用，入大肠，治血枯便闭，血燥便难，以其濡润凉血和血，有开结通滞之力。"}]},{"ID":"20240614090802-4nmlfe1","Type":"NodeParagraph","Properties":{"id":"20240614090802-4nmlfe1","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"6.《本经逢原》：桃仁，为血瘀血闭之专药。苦以泄滞血，甘以生新血。毕竟破血之功居多，观《本经》主治可知。仲景桃核承气、抵当汤，皆取破血之用。又治热入血室，瘀积症瘕，经闭，疟母，心腹痛，大肠秘结，亦取散肝经之血结。熬香治TUI疝痛痒，《千金》法也。"}]},{"ID":"20240614090802-qxxa7pv","Type":"NodeParagraph","Properties":{"id":"20240614090802-qxxa7pv","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"7.《本草思辨录》：桃仁，主攻瘀血而为肝药，兼疏肤腠之瘀。惟其为肝药，故桃核承气汤、抵当汤、抵当丸治在少腹，鳖甲煎丸治在胁下，大黄牡丹汤治在大肠，桂枝茯苓丸治在症痼，下瘀血汤治在脐下。惟其兼疏肤腠之瘀，故大黄ZHE虫丸治肌肤甲错，《千金》苇茎汤治胸中甲错，王海藏以桂枝红花汤加海蛤、桃仁治妇人血结胸，桃仁之用尽于是矣。"}]},{"ID":"20240614090802-x2nlw95","Type":"NodeParagraph","Properties":{"id":"20240614090802-x2nlw95","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614090802-xnmng0d","Type":"NodeParagraph","Properties":{"id":"20240614090802-xnmng0d","updated":"20240614090802"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614090804-yq3qe9w","Type":"NodeThematicBreak","Properties":{"id":"20240614090804-yq3qe9w"}},{"ID":"20240614090805-ue4fbu1","Type":"NodeParagraph","Properties":{"id":"20240614090805-ue4fbu1"}}]}