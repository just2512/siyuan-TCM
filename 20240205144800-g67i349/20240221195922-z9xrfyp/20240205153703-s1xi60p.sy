":"{: style=\"width: 702px;\" parent-style=\"width: 712px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 562px;","style":"width: 552px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花 4-20240828122154-uqkqf65.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 552px;\" parent-style=\"width: 562px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704092115-x2rmej0","Type":"NodeParagraph","Properties":{"id":"20240704092115-x2rmej0","updated":"20240828122206"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花3-20240704092115-zfuayof.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 510px;","style":"width: 500px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花4-20240704092138-peeb5xc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 500px;\" parent-style=\"width: 510px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828122248-09nen7j","Type":"NodeParagraph","Properties":{"id":"20240828122248-09nen7j","updated":"20240828122327"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 678px;","style":"width: 668px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花 5-20240828122248-jlc3j0h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 668px;\" parent-style=\"width: 678px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 456px;","style":"width: 446px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花 6-20240828122327-3bdq8fy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 446px;\" parent-style=\"width: 456px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614094601-9mhblu1","Type":"NodeParagraph","Properties":{"id":"20240614094601-9mhblu1"}},{"ID":"20240614094602-pc4w4kn","Type":"NodeParagraph","Properties":{"id":"20240614094602-pc4w4kn","updated":"20240704090935"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藏红花川红花对比"}]},{"ID":"20240828122419-2jx9xyy","Type":"NodeParagraph","Properties":{"id":"20240828122419-2jx9xyy","updated":"20240828122419"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 700px;","style":"width: 690px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花 7-20240828122419-kqd4ek3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 690px;\" parent-style=\"width: 700px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614095126-sxlihvw","Type":"NodeThematicBreak","Properties":{"id":"20240614095126-sxlihvw"}},{"ID":"20240614095127-u8azheb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095127-u8azheb","updated":"20240614095134"},"Children":[{"Type":"NodeText","Data":"红蓝花《滇南本草》"}]},{"ID":"20240614095127-91aoqly","Type":"NodeParagraph","Properties":{"id":"20240614095127-91aoqly","updated":"20240614095131"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"红蓝花"},{"Type":"NodeText","Data":"，禀火与土之气，故味苦、辛，性温。无毒。阴中之阳，入心肝二经，血分之药。本草亦谓之红蓝花、蓝叶红花，滇中处处有之。"}]},{"ID":"20240614095127-opzyscx","Type":"NodeParagraph","Properties":{"id":"20240614095127-opzyscx","updated":"20240614095127"},"Children":[{"Type":"NodeText","Data":"噤、化痘斑、凉血热、稀痘疹。多用则入心养血，行血，活血而润燥也。"}]},{"ID":"20240614095238-h1y2i43","Type":"NodeThematicBreak","Properties":{"id":"20240614095238-h1y2i43"}},{"ID":"20240614095239-fnl9h7m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095239-fnl9h7m","updated":"20240614095243"},"Children":[{"Type":"NodeText","Data":"红蓝花《冯氏锦囊秘录》"}]},{"ID":"20240614095239-ktq3ce9","Type":"NodeParagraph","Properties":{"id":"20240614095239-ktq3ce9","updated":"20240614095239"},"Children":[{"Type":"NodeText","Data":"禀土与火之气，故味苦辛温，无毒，阴中之阳也。入心。肝二经，血分之药。"}]},{"ID":"20240614095239-trf0w0l","Type":"NodeParagraph","Properties":{"id":"20240614095239-trf0w0l","updated":"20240614095239"},"Children":[{"Type":"NodeText","Data":"红蓝花，治胎死腹中，为未生要药，疗口禁血晕，诚已产仙丹，化痘斑血热痘疹。"}]},{"ID":"20240614095239-hp4y8bm","Type":"NodeParagraph","Properties":{"id":"20240614095239-hp4y8bm","updated":"20240614095239"},"Children":[{"Type":"NodeText","Data":"凡多用则破血通经，酒煮方妙；少用则入心养血，水煎为安。入心、肝二经，为行血活血润燥之药也。同当归则生血，佐肉桂则散瘀、配治既异，而功用有二途矣。产后勿宜过用，多用以便血行不止而毙，慎哉！"}]},{"ID":"20240614095239-ig1q1fx","Type":"NodeParagraph","Properties":{"id":"20240614095239-ig1q1fx","updated":"20240614095239"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 治痘血热血凝不行，污血化成斑点，用此之滞，有去旧生新之妙用。多用则行血破血，少用则活血归经，入心养血和血。与当归同功，然大抵活血之功多，而养血之力少也。子吞数粒，能不染天行痘疮。凡疮色红紫之血热也，宜红花酒浸晒干用。加疮子黑陷者，用子酒浸晒干，慢火微炒研用。胭脂即红花汁成之，痘将出时，以此涂眼四围，痘不入目，兼能活血，故解片毒最良。"}]},{"ID":"20240614095226-3soine9","Type":"NodeThematicBreak","Properties":{"id":"20240614095226-3soine9"}},{"ID":"20240614095227-bld6p8i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095227-bld6p8i","updated":"20240614095232"},"Children":[{"Type":"NodeText","Data":"红蓝花《汤液本草》"}]},{"ID":"20240614095227-l879pl4","Type":"NodeParagraph","Properties":{"id":"20240614095227-l879pl4","updated":"20240614095227"},"Children":[{"Type":"NodeText","Data":"气温，味辛。辛而甘温苦，阴中之阳。无毒。"}]},{"ID":"20240614095227-6toehsr","Type":"NodeParagraph","Properties":{"id":"20240614095227-6toehsr","updated":"20240614095227"},"Children":[{"Type":"NodeText","Data":"《象》云∶治产后口噤血晕，腹内恶血不尽，绞痛。破留血，神效。搓碎用。"}]},{"ID":"20240614095227-uxeo5ms","Type":"NodeParagraph","Properties":{"id":"20240614095227-uxeo5ms","updated":"20240614095227"},"Children":[{"Type":"NodeText","Data":"《心》云∶和血，与当归同用。"}]},{"ID":"20240614095227-ga3jsyo","Type":"NodeParagraph","Properties":{"id":"20240614095227-ga3jsyo","updated":"20240614095227"},"Children":[{"Type":"NodeText","Data":"《珍》云∶入心养血。谓苦为阴中之阳，故入心。"}]},{"ID":"20240614095227-67mnqjg","Type":"NodeParagraph","Properties":{"id":"20240614095227-67mnqjg","updated":"20240614095227"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主产后血晕，胎死腹中，并酒煮服。亦主蛊毒下血。其苗，生捣敷游肿。"}]},{"ID":"20240614095227-cnr588p","Type":"NodeParagraph","Properties":{"id":"20240614095227-cnr588p","updated":"20240614095227"},"Children":[{"Type":"NodeText","Data":"其子，吞数粒，主天行疮子不出。其胭脂，主小儿 耳，滴耳中。仲景治六十二种风，兼腹中血气刺痛，用红花一大两，分为四分，酒一大升，煎强半，顿服之。"}]},{"ID":"20240614095217-z8298b9","Type":"NodeThematicBreak","Properties":{"id":"20240614095217-z8298b9"}},{"ID":"20240614095218-o1mvxs7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095218-o1mvxs7","updated":"20240614095222"},"Children":[{"Type":"NodeText","Data":"红蓝花《本草述钩元》"}]},{"ID":"20240614095218-2lnsmmw","Type":"NodeParagraph","Properties":{"id":"20240614095218-2lnsmmw","updated":"20240614095218"},"Children":[{"Type":"NodeText","Data":"即红花。"}]},{"ID":"20240614095218-08sksgg","Type":"NodeParagraph","Properties":{"id":"20240614095218-08sksgg","updated":"20240614095218"},"Children":[{"Type":"NodeText","Data":"味甘苦而辛。气温。阴中之阳。入心养血。又为肝经血分药。入酒良。多用破留血。少用养腹中红花汁少用多用三桶于窗死腹中。新胡当归生地红花捣绞汁采头次红花服二分。次日〔论〕红花开于盛夏。其色正红。火也。其气温。其味辛甘。发散为阳而归于苦。苦又火味分破凡服红花。但令血晕解。留滞行。即止。若过多。能使血行不止而毙。世所不知。（仲淳）〔修治〕养血水煎。破血酒煮。"}]},{"ID":"20240614095207-8bzs3qt","Type":"NodeThematicBreak","Properties":{"id":"20240614095207-8bzs3qt"}},{"ID":"20240614095209-5uziqb2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095209-5uziqb2","updated":"20240614095213"},"Children":[{"Type":"NodeText","Data":"红蓝花《本经逢原》"}]},{"ID":"20240614095209-dm6vqpa","Type":"NodeParagraph","Properties":{"id":"20240614095209-dm6vqpa","updated":"20240614095209"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即红花"}]},{"ID":"20240614095209-ycpk0zg","Type":"NodeParagraph","Properties":{"id":"20240614095209-ycpk0zg","updated":"20240614095209"},"Children":[{"Type":"NodeText","Data":"辛温，无毒。"}]},{"ID":"20240614095209-xr40bhr","Type":"NodeParagraph","Properties":{"id":"20240614095209-xr40bhr","updated":"20240614095209"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"血生于心包，藏于肝，属于冲任，红花汁与之同类。故能行男子血脉，通妇人经水，活血，解痘毒，散赤肿。产后血晕及胎死腹中，并宜和童便服之。少则养血，多则行血，过用使人血行不止，且性兼上行，不可不知。亦主蛊毒下血，堪作胭脂，治小儿 耳，解痘疔毒肿。产后血闷，以红花十斤煮汤盛桶，置于横格之下，舁妇寝上熏之，汤冷再加，半日乃苏。"}]},{"ID":"20240614095155-t45gq29","Type":"NodeThematicBreak","Properties":{"id":"20240614095155-t45gq29"}},{"ID":"20240614095156-79ecx73","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095156-79ecx73","updated":"20240614095201"},"Children":[{"Type":"NodeText","Data":"红蓝花《长沙药解》"}]},{"ID":"20240614095156-209guxo","Type":"NodeParagraph","Properties":{"id":"20240614095156-209guxo","updated":"20240614095156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614095156-1ep32en","Type":"NodeParagraph","Properties":{"id":"20240614095156-1ep32en","updated":"20240614095156"},"Children":[{"Type":"NodeText","Data":"味辛，入足厥阴肝经。专行血瘀，最止腹痛。"}]},{"ID":"20240614095156-zgl6dzj","Type":"NodeParagraph","Properties":{"id":"20240614095156-zgl6dzj","updated":"20240614095156"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红蓝花酒"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"红蓝花一两，酒一升。煎减半，分服。"},{"Type":"NodeText","Data":"治妇人诸风，腹中血气刺痛。肝主藏血，木郁风动，肝血枯燥，郁克己土，则生疼痛。红蓝花行血而破瘀，黄酒温经而散滞也。"}]},{"ID":"20240614095156-qm8yusz","Type":"NodeParagraph","Properties":{"id":"20240614095156-qm8yusz","updated":"20240614095156"},"Children":[{"Type":"NodeText","Data":"红蓝花活血行瘀，润燥止痛，最能疏木而清风。其诸主治，通经脉，消胕肿，下胎衣，开喉闭，苏血晕，吹聍耳。"}]},{"ID":"20240614095138-o27tesn","Type":"NodeThematicBreak","Properties":{"id":"20240614095138-o27tesn"}},{"ID":"20240614095140-qjwu5zm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095140-qjwu5zm","updated":"20240614095148"},"Children":[{"Type":"NodeText","Data":"红蓝花《本草择要纲目》"}]},{"ID":"20240614095140-wzj5cg3","Type":"NodeParagraph","Properties":{"id":"20240614095140-wzj5cg3","updated":"20240614095140"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240614095140-lhuvp5y","Type":"NodeParagraph","Properties":{"id":"20240614095140-lhuvp5y","updated":"20240614095140"},"Children":[{"Type":"NodeText","Data":"辛温无毒．"}]},{"ID":"20240614095140-qpfuc0w","Type":"NodeParagraph","Properties":{"id":"20240614095140-qpfuc0w","updated":"20240614095140"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240614095140-mt7rxax","Type":"NodeParagraph","Properties":{"id":"20240614095140-mt7rxax","updated":"20240614095140"},"Children":[{"Type":"NodeText","Data":"产后血晕口噤．腹内恶血不尽绞痛．胎死腹中．多用破留血．少用养血．润燥止痛．散肿通经．凡血生于心包．藏于肝．属于冲任．红花与之同类．故能行男子血脉．通女子经水．其性苦温．为阴中之阳．故入心．佐当归生新血．又辛而甘．为肝经血分之药．"}]},{"ID":"20240614095116-cm78ttw","Type":"NodeThematicBreak","Properties":{"id":"20240614095116-cm78ttw"}},{"ID":"20240614095117-pu7u3i7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095117-pu7u3i7","updated":"20240614095122"},"Children":[{"Type":"NodeText","Data":"红蓝花《医学入门》"}]},{"ID":"20240614095117-ge5r1fc","Type":"NodeParagraph","Properties":{"id":"20240614095117-ge5r1fc","updated":"20240614095117"},"Children":[{"Type":"NodeText","Data":"红蓝花辛温散血，胎死产晕口噤结，兼治诸风及痹喉，少用补血东垣诀，若作胭脂功又奇，小儿 耳不可缺。"}]},{"ID":"20240614095117-6b8dq0j","Type":"NodeParagraph","Properties":{"id":"20240614095117-6b8dq0j","updated":"20240614095117"},"Children":[{"Type":"NodeText","Data":"色红，叶如蓝，即今染红及作胭脂者，俗名红花。无毒。阴中阳也。《衍义》云∶辛温则血调和，故少用则能入心养血；过于辛温则血走散，故多用则能破血。治胎死腹中及产后血晕口噤，腹内恶血不尽绞痛，经闭腹内血气刺痛，并酒煮服，兼治三十六种风及产后中风，血热烦渴，喉痹壅塞不通，一切肿毒及蛊毒下血，生绞汁或煎服之。东垣谓∶补血虚者，佐补血药而少用也。搓碎用。苗生捣碎，敷游肿。子吞数粒主天行痘子不出。胭脂点小儿 耳，滴耳中。"}]},{"ID":"20240614095117-x44ozj5","Type":"NodeParagraph","Properties":{"id":"20240614095117-x44ozj5","updated":"20240614095117"},"Children":[{"Type":"NodeText","Data":"以上滋血润燥药。"}]},{"ID":"20240614095105-hxbwicn","Type":"NodeThematicBreak","Properties":{"id":"20240614095105-hxbwicn"}},{"ID":"20240614095106-mzjm3h3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095106-mzjm3h3","updated":"20240614095111"},"Children":[{"Type":"NodeText","Data":"红蓝花《证类本草》"}]},{"ID":"20240614095106-qnfodp5","Type":"NodeParagraph","Properties":{"id":"20240614095106-qnfodp5","updated":"20240614095106"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主产后血晕口噤，腹内恶血不尽绞痛，胎死腹中，并酒煮服。亦主蛊毒下血。堪作燕脂。其苗生捣碎，敷游肿。其子吞数颗，主天行疮子不出。其燕脂，主小儿 耳，滴耳中。生梁、汉及西域。一名黄蓝。《博物志》云∶黄蓝，张骞所得。今仓魏地亦种之。（今附）"}]},{"ID":"20240614095106-8qeqd2l","Type":"NodeParagraph","Properties":{"id":"20240614095106-8qeqd2l","updated":"20240614095106"},"Children":[{"Type":"NodeText","Data":"图经曰∶红蓝花，即红花也。生梁、汉及西域，今处处有之。人家场圃所种，冬而布子于熟地，至春生苗，夏乃有花。下作 汇，多刺，花蕊出 上。圃人承露采之，采已复出，至尽而罢。 中结实，白颗如小豆大。其花曝干，以染真红及作燕脂。主产后血病为胜，其实亦同，叶颇似蓝，故有蓝名，又名黄蓝。《博物志》云∶张骞所得也。张仲景治六十二种风，兼腹内血气刺痛。用红花一大两，分为四分，以酒一大升，煎强半，顿服之。不止，再服。"}]},{"ID":"20240614095106-b7hli6e","Type":"NodeParagraph","Properties":{"id":"20240614095106-b7hli6e","updated":"20240614095106"},"Children":[{"Type":"NodeText","Data":"又一方∶用红蓝子一升捣碎，以无灰酒一大升八合，拌了曝令干，重捣筛，蜜丸如桐子大，空腹酒下四十丸。《正元广利方》治女子中风，血热烦渴者。以红蓝子五大合，微熬捣碎，旦日取半大匙，以水一升，煎取七合，去滓，细细咽之。又崔元亮《海上方》∶治喉痹，壅塞不通者。取红蓝花捣，绞取汁一小升服之，以瘥为度。如冬月无湿花，可浸干者浓绞取汁，如前服之，极验。但咽喉塞服之皆瘥。亦疗妇人产运绝者。"}]},{"ID":"20240614095106-zy13e6i","Type":"NodeParagraph","Properties":{"id":"20240614095106-zy13e6i","updated":"20240614095106"},"Children":[{"Type":"NodeText","Data":"唐本注云∶治口噤不语，血结，产后诸疾，堪染红。外台秘要∶治一切肿方∶以红花熟烂捣取汁服之，不过再三服便瘥。服之多少，量肿大小而进之。简要济众∶产后血晕，心闷气绝。红花一两，捣为末，分作两服，酒二中盏，煎取一盏并服。如口噤，斡开灌之。《子母秘录》同。产宝∶疗产后中风，烦渴。红花子五合，微熬研碎，以一匙水一升，煎取七合，徐徐呷之。近效方∶治血晕绝不识人，烦闷者。红花三两，新者佳。无灰酒半升，童子小便半升，煮取一大盏，去滓，候冷，顿服之，新汲水煮之亦良。"}]},{"ID":"20240614095055-4k3xnnu","Type":"NodeThematicBreak","Properties":{"id":"20240614095055-4k3xnnu"}},{"ID":"20240614095056-6592qnd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614095056-6592qnd","updated":"20240614095100"},"Children":[{"Type":"NodeText","Data":"红蓝花《本草纲目》"}]},{"ID":"20240614095056-cvg7xpx","Type":"NodeParagraph","Properties":{"id":"20240614095056-cvg7xpx","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"「释名」亦名红花、黄蓝。"}]},{"ID":"20240614095056-kpg7jzm","Type":"NodeParagraph","Properties":{"id":"20240614095056-kpg7jzm","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"「气味」（花）辛、温、无毒。"}]},{"ID":"20240614095056-cts6e35","Type":"NodeParagraph","Properties":{"id":"20240614095056-cts6e35","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614095056-z0hwdm5","Type":"NodeParagraph","Properties":{"id":"20240614095056-z0hwdm5","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"1、风疾兼腹内血气痛。用红花一两，分为四份。先取一份以酒一升，煎成一杯半，一次服下。不止，再服。"}]},{"ID":"20240614095056-s7yoapq","Type":"NodeParagraph","Properties":{"id":"20240614095056-s7yoapq","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"2、一切肿疾。用红花熟捣取汁服。"}]},{"ID":"20240614095056-vn6iho8","Type":"NodeParagraph","Properties":{"id":"20240614095056-vn6iho8","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"3、喉痹壅塞。用红花捣烂，取汁一小升服下，病愈为止。冬月无花，可用干花浸湿压汁煎服。"}]},{"ID":"20240614095056-45xsgi1","Type":"NodeParagraph","Properties":{"id":"20240614095056-45xsgi1","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"4、胎死腹中，或胎衣不下。用红花煮酒服。"}]},{"ID":"20240614095056-0zgpb7q","Type":"NodeParagraph","Properties":{"id":"20240614095056-0zgpb7q","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"5、产后血晕。用红花一两研细，分作二服，每服以酒二碗煎成一碗送下。"}]},{"ID":"20240614095056-zi4qewn","Type":"NodeParagraph","Properties":{"id":"20240614095056-zi4qewn","updated":"20240614095056"},"Children":[{"Type":"NodeText","Data":"6、耳出水。用红花三钱半、枯矾五钱，共研为末，先用棉花把耳擦净，然后把药末吹入耳内。无花则用枝叶为末亦可。有的处方只用红花一味，不用枯矾。"}]},{"ID":"20240704084856-m5scl98","Type":"NodeThematicBreak","Properties":{"id":"20240704084856-m5scl98","updated":"20240704084856"}},{"ID":"20240704084856-xf28zqe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084856-xf28zqe","updated":"20240704084856"},"Children":[{"Type":"NodeText","Data":"红蓝花《本草图经》"}]},{"ID":"20240704084856-i0h5tx4","Type":"NodeParagraph","Properties":{"id":"20240704084856-i0h5tx4","updated":"20240704084856"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"红蓝花"},{"Type":"NodeText","Data":"，即红花也，生梁汉及西域，今处处有之，人家场圃所种，冬而布子于熟地，至春生苗，夏乃有花。下作球汇多刺，花蕊出球上，圃人承露采之，采已夏出，至尽而罢。球中结实，白颗如小豆大。其花曝干，以染真红及作燕脂，主产后病为胜。其实亦同叶，颇似蓝，故有蓝名，又名黄蓝。《博物志》云∶张骞所得也。张仲景治六十二种风，兼腹内血气刺痛，用红花一大两，分为四分，以酒一大升煎强半，顿服之，不止再服。又一方用红蓝子一升，捣碎，以无灰酒一大升八合，拌了，曝令干，重捣筛，蜜丸如桐子大，空腹酒下四十丸。"}]},{"ID":"20240704084856-kfdvcnx","Type":"NodeParagraph","Properties":{"id":"20240704084856-kfdvcnx","updated":"20240704084856"},"Children":[{"Type":"NodeText","Data":"《正元广利方》治女子中风，血热烦渴者，以红蓝子五大合，微熬，捣碎，旦日取半大匙，以水一升，煎取七合，去滓，细细咽之。又崔元亮《海上方》治喉痹壅塞不通者，取红蓝花捣绞取汁一小升，服之，以瘥为度。如冬月无湿花，可浸干者浓绞取汁如前，服之，极验。"}]},{"ID":"20240704084856-li1nr8c","Type":"NodeParagraph","Properties":{"id":"20240704084856-li1nr8c","updated":"20240704084857"},"Children":[{"Type":"NodeText","Data":"但咽喉塞服之，皆瘥。亦疗妇人产运绝者"}]},{"ID":"20240704084902-34f7vpo","Type":"NodeThematicBreak","Properties":{"id":"20240704084902-34f7vpo"}},{"ID":"20240614094833-wakqivi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094833-wakqivi","updated":"20240614094837"},"Children":[{"Type":"NodeText","Data":"红花《得配本草》"}]},{"ID":"20240614094833-1zhnzl5","Type":"NodeParagraph","Properties":{"id":"20240614094833-1zhnzl5","updated":"20240614094833"},"Children":[{"Type":"NodeText","Data":"得酒良。"}]},{"ID":"20240614094833-s6hidxo","Type":"NodeParagraph","Properties":{"id":"20240614094833-s6hidxo","updated":"20240614094833"},"Children":[{"Type":"NodeText","Data":"辛、甘、苦，温。入手少阴、足厥阴经血分。破瘀血，行新血，散肿止痛。（血行痛自止。）"}]},{"ID":"20240614094833-yz3zimd","Type":"NodeParagraph","Properties":{"id":"20240614094833-yz3zimd","updated":"20240614094833"},"Children":[{"Type":"NodeText","Data":"配当归，活血。配肉桂，散瘀。破血，多用，酒煮。养血，少用，水煮。产后勿宜过用，使血行不止而死。"}]},{"ID":"20240614094833-09b1771","Type":"NodeParagraph","Properties":{"id":"20240614094833-09b1771","updated":"20240614094833"},"Children":[{"Type":"NodeText","Data":"子 吞数粒，使痘疮不染。痘子黑陷者，用子酒浸晒干，微炒研用。"}]},{"ID":"20240614094602-ginuaa4","Type":"NodeThematicBreak","Properties":{"id":"20240614094602-ginuaa4"}},{"ID":"20240614094824-soxhq3m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094824-soxhq3m","updated":"20240614094828"},"Children":[{"Type":"NodeText","Data":"红花《本草简要方》"}]},{"ID":"20240614094824-e7vzuze","Type":"NodeParagraph","Properties":{"id":"20240614094824-e7vzuze","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"产西藏者良。以一瓣飘水面。即有红丝下垂到底。瓣亦流转不定。"}]},{"ID":"20240614094824-msigbqu","Type":"NodeParagraph","Properties":{"id":"20240614094824-msigbqu","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"主治。行血。破瘀。养血。活血。下死胎。通月经。此为行血要药。多服则血行不止。"}]},{"ID":"20240614094824-akdkt3k","Type":"NodeParagraph","Properties":{"id":"20240614094824-akdkt3k","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"危及生命。"}]},{"ID":"20240614094824-8i5lh53","Type":"NodeParagraph","Properties":{"id":"20240614094824-8i5lh53","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"红花酒。红花一两。酒一大升。煎减半。顿服一半。未愈再服。治妇人六十二种风。腹中血气刺痛。"}]},{"ID":"20240614094824-w6q45n8","Type":"NodeParagraph","Properties":{"id":"20240614094824-w6q45n8","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"红花散。红花当归生干地黄赤芍鬼箭虎杖大腹皮麦冬土瓜根地骨皮枳壳炙草各五钱。柴胡一两五钱。锉粗末。每服四两。水一中盏。加生姜五厘。煎至六分。去滓温服。治妇人热劳。四肢羸瘦。经水不通。"}]},{"ID":"20240614094824-ter0fnc","Type":"NodeParagraph","Properties":{"id":"20240614094824-ter0fnc","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"红花桃仁汤。红花桃仁麻黄各五分。黄柏生地各一钱五分。猪苓泽泻苍术当归梢汉防己防风各一钱。水三盏煎至一盏。食前服。治痔漏有脓血。大便燥硬作痛。红花散。红花干荷叶丹皮当归蒲黄（炒）各等分。研末。每服五钱。酒煎连滓服。治产后血昏血晕血崩。及经水不调。远年干血气。如胎衣不下。榆白皮煎汤调服。"}]},{"ID":"20240614094824-bktsuy9","Type":"NodeParagraph","Properties":{"id":"20240614094824-bktsuy9","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"又方。红花黄芩苏木各八分。天花粉六分。水煎空腹服。治倒经。"}]},{"ID":"20240614094824-ks2n0cw","Type":"NodeParagraph","Properties":{"id":"20240614094824-ks2n0cw","updated":"20240614094824"},"Children":[{"Type":"NodeText","Data":"按用此药若得真藏红花。分量宜酌减。"}]},{"ID":"20240614094602-ep3z9m4","Type":"NodeThematicBreak","Properties":{"id":"20240614094602-ep3z9m4"}},{"ID":"20240704084930-szwjy6o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-szwjy6o","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《本草从新》"}]},{"ID":"20240704084930-55nj39j","Type":"NodeParagraph","Properties":{"id":"20240704084930-55nj39j","updated":"20240704084930"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"古名红蓝花．通、行血润燥．"}]},{"ID":"20240704084930-6jf8oum","Type":"NodeParagraph","Properties":{"id":"20240704084930-6jf8oum","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"辛苦甘温．入肝经而破瘀血．活血（瘀行则血活、有热结于中、暴吐紫黑血者、吐出为好、吐未尽、加桃仁红花行之、大抵鲜血宜止、瘀血宜行．）润燥．消肿止痛．（凡血热血瘀、则作肿作痛．）治经闭便难．胎死腹中．（非活血行血不能下．）产后血晕口噤．（有产妇血闷而死、名医陆氏、以红花数十斤煮汤、寝妇于上而熏之、汤冷再加、半日而苏、金匮有红蓝花酒、治妇人六十二种风证．）喉痹不通．痘疮血滞．过用、能使血行不止而毙．酒喷微焙．胭脂活血．解痘毒．敷痘疔．（挑破、以油胭脂敷之．）子功与花同．叶捣涂游肿．"}]},{"ID":"20240704084930-mqeis6n","Type":"NodeThematicBreak","Properties":{"id":"20240704084930-mqeis6n","updated":"20240704084930"}},{"ID":"20240704084930-50uqazz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-50uqazz","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《本草求真》"}]},{"ID":"20240704084930-g5uby4n","Type":"NodeParagraph","Properties":{"id":"20240704084930-g5uby4n","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"（隰草）通瘀"}]},{"ID":"20240704084930-efg6qmb","Type":"NodeParagraph","Properties":{"id":"20240704084930-efg6qmb","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花（专入心包肝）。辛苦而温。色红入血。为通瘀活血要剂。（血之下而清者。营虚有热。血之下而浊者。热与湿蒸。血色鲜者属火发。血色黑者属血燥极。血与泄物并下者。属有积。或因脉络受伤。血从尿出者。属阴虚火动。或因房劳过度。营血妄行。血色黑黯。面色枯白。尺脉沉迟者。属下元虚寒。阳虚阴走。呕吐而见血色紫凝者。属热甚销铄。故见稠浊。热甚水化。故血见黑而紫。血从汗者属火。喜伤心。喜则气散。故血随气以行。血在粪前者为近血。其血由于大肠。血在粪后者为远血。其血自于肺胃。由气虚肠薄。故血渗入而下出也。血自口鼻上出。为阳盛阴衰。有升无降。）盖血生于心包。藏于肝。属于冲任。一有外邪内侵。则血滞而不行。红花汁与血类。故凡血燥而见喉痹不通。痘疮不起。肌肤肿痛。（因血热血瘀。作肿作痛。）经闭便难。（经闭本有血滞血枯之分。但此止就血滞论。）血晕口噤。子死腹中。治当用此通活。（时珍曰。红花汁与之同类。故能行男子血脉。女子经水。多则行血。少则养血。按养 漫笔云。新昌徐氏妇病产晕已死。但胸膈微热。有名医陆氏曰。血闷也。得红花数十斤乃可活。遂亟购得。以大锅煮汤。盛二桶于窗格之下。畀妇寝其上熏之。汤冷再加。少倾指动。半日乃苏。）但用不宜过多。少用则合当归能生。多用则血能行。过用则能使血下行不止而毙。胭脂系红花染出。可治小儿 耳。（红蓝花三钱半。枯矾五钱。为末。以绵杖缴净吹之。无花则用枝叶。一方去矾。）并解痘疮毒肿。（有痘疮挑破。以油胭脂敷之良。）"}]},{"ID":"20240704084930-za6r8l5","Type":"NodeThematicBreak","Properties":{"id":"20240704084930-za6r8l5","updated":"20240704084930"}},{"ID":"20240704084930-hzbouor","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-hzbouor","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《药性切用》"}]},{"ID":"20240704084930-3fbd1c8","Type":"NodeParagraph","Properties":{"id":"20240704084930-3fbd1c8","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"古名红蓝花。辛苦甘温，入肝治血。少用活血、和血，多用破血、行血。子∶散血结叶∶涂痈肿。"}]},{"ID":"20240704084930-bqd7ov7","Type":"NodeThematicBreak","Properties":{"id":"20240704084930-bqd7ov7","updated":"20240704084930"}},{"ID":"20240704084930-pbwqnn6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-pbwqnn6","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《本草撮要》"}]},{"ID":"20240704084930-c4w1qwy","Type":"NodeParagraph","Properties":{"id":"20240704084930-c4w1qwy","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"味辛．入手少阴经．功专活血消肿．得去风药治六十二种风．得补益药生新血．作胭脂活血解毒．痘疔挑破．以油胭脂敷之良．过服血行不止．"}]},{"ID":"20240704084930-ic4giva","Type":"NodeThematicBreak","Properties":{"id":"20240704084930-ic4giva","updated":"20240704084930"}},{"ID":"20240704084930-91glb9i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-91glb9i","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《得配本草》"}]},{"ID":"20240704084930-9jyvuaj","Type":"NodeParagraph","Properties":{"id":"20240704084930-9jyvuaj","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"得酒良。"}]},{"ID":"20240704084930-q2zmcvi","Type":"NodeParagraph","Properties":{"id":"20240704084930-q2zmcvi","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"辛、甘、苦，温。入手少阴、足厥阴经血分。破瘀血，行新血，散肿止痛。（血行痛自止。）"}]},{"ID":"20240704084930-ot0y404","Type":"NodeParagraph","Properties":{"id":"20240704084930-ot0y404","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"配当归，活血。配肉桂，散瘀。破血，多用，酒煮。养血，少用，水煮。产后勿宜过用，使血行不止而死。"}]},{"ID":"20240704084930-h9tn5z3","Type":"NodeParagraph","Properties":{"id":"20240704084930-h9tn5z3","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"子 吞数粒，使痘疮不染。痘子黑陷者，用子酒浸晒干，微炒研用。"}]},{"ID":"20240704084930-haftiw7","Type":"NodeThematicBreak","Properties":{"id":"20240704084930-haftiw7","updated":"20240704084930"}},{"ID":"20240704084930-0nmgtyd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-0nmgtyd","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《顾松园医镜》"}]},{"ID":"20240704084930-tztdtwh","Type":"NodeParagraph","Properties":{"id":"20240704084930-tztdtwh","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"〔辛温，入心、肝二经。酒喷微焙。〕行男子血脉，通女子经水。〔少用则养血，多用则破血。〕产后血晕急需，胎死腹中必用。活血润燥，为行血之要药。"}]},{"ID":"20240704084930-a47pyul","Type":"NodeParagraph","Properties":{"id":"20240704084930-a47pyul","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"过用，使人血行不止而毙，可弗慎欤！孕妇禁之。"}]},{"ID":"20240704084930-3qkutqn","Type":"NodeThematicBreak","Properties":{"id":"20240704084930-3qkutqn","updated":"20240704084930"}},{"ID":"20240704084930-9satol8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240704084930-9satol8","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花《本草简要方》"}]},{"ID":"20240704084930-l864644","Type":"NodeParagraph","Properties":{"id":"20240704084930-l864644","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"产西藏者良。以一瓣飘水面。即有红丝下垂到底。瓣亦流转不定。"}]},{"ID":"20240704084930-mowmmer","Type":"NodeParagraph","Properties":{"id":"20240704084930-mowmmer","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"主治。行血。破瘀。养血。活血。下死胎。通月经。此为行血要药。多服则血行不止。"}]},{"ID":"20240704084930-1qxftrk","Type":"NodeParagraph","Properties":{"id":"20240704084930-1qxftrk","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"危及生命。"}]},{"ID":"20240704084930-ha4p01s","Type":"NodeParagraph","Properties":{"id":"20240704084930-ha4p01s","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花酒。红花一两。酒一大升。煎减半。顿服一半。未愈再服。治妇人六十二种风。腹中血气刺痛。"}]},{"ID":"20240704084930-llqip8r","Type":"NodeParagraph","Properties":{"id":"20240704084930-llqip8r","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花散。红花当归生干地黄赤芍鬼箭虎杖大腹皮麦冬土瓜根地骨皮枳壳炙草各五钱。柴胡一两五钱。锉粗末。每服四两。水一中盏。加生姜五厘。煎至六分。去滓温服。治妇人热劳。四肢羸瘦。经水不通。"}]},{"ID":"20240704084930-bu24syw","Type":"NodeParagraph","Properties":{"id":"20240704084930-bu24syw","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"红花桃仁汤。红花桃仁麻黄各五分。黄柏生地各一钱五分。猪苓泽泻苍术当归梢汉防己防风各一钱。水三盏煎至一盏。食前服。治痔漏有脓血。大便燥硬作痛。红花散。红花干荷叶丹皮当归蒲黄（炒）各等分。研末。每服五钱。酒煎连滓服。治产后血昏血晕血崩。及经水不调。远年干血气。如胎衣不下。榆白皮煎汤调服。"}]},{"ID":"20240704084930-xbtzfmr","Type":"NodeParagraph","Properties":{"id":"20240704084930-xbtzfmr","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"又方。红花黄芩苏木各八分。天花粉六分。水煎空腹服。治倒经。"}]},{"ID":"20240704084930-y1jdnhj","Type":"NodeParagraph","Properties":{"id":"20240704084930-y1jdnhj","updated":"20240704084930"},"Children":[{"Type":"NodeText","Data":"按用此药若得真藏红花。分量宜酌减。"}]},{"ID":"20240704084932-yt5qhxg","Type":"NodeThematicBreak","Properties":{"id":"20240704084932-yt5qhxg"}},{"ID":"20240614094813-eaffw6h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094813-eaffw6h","updated":"20240614094819"},"Children":[{"Type":"NodeText","Data":"红花《本草分经》"}]},{"ID":"20240614094813-y1i8yd3","Type":"NodeParagraph","Properties":{"id":"20240614094813-y1i8yd3","updated":"20240614094813"},"Children":[{"Type":"NodeText","Data":"辛甘苦温，入肝经，破瘀活血，润燥消肿，过用能使血行不止。胭脂活血解痘毒。绛纬略得红花之力，可以养血而又借蚕丝以行经络，虚而血滞者用之最宜。"}]},{"ID":"20240614094602-78zyf8h","Type":"NodeThematicBreak","Properties":{"id":"20240614094602-78zyf8h"}},{"ID":"20240614094756-d0blpgr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094756-d0blpgr","updated":"20240614094806"},"Children":[{"Type":"NodeText","Data":"红花《本草便读》"}]},{"ID":"20240614094756-sk9sy92","Type":"NodeParagraph","Properties":{"id":"20240614094756-sk9sy92","updated":"20240614094756"},"Children":[{"Type":"NodeText","Data":"色赤而温．心肝皆及．味甘且苦．辛散俱优．调血脉可去瘀生新．治折伤理胎前产后．（红花行散之品．专入心肝血分．破瘀活血．是其所长．至于消肿治风．理伤疗产等法．亦在人之善用耳．红花开于盛夏．其味虽有辛甘．然毕竟苦温色赤．为心之正药．少用和血．多用行血．治风者亦凡花皆散．又血行风自灭也．）"}]},{"ID":"20240614094602-pbwipxj","Type":"NodeThematicBreak","Properties":{"id":"20240614094602-pbwipxj"}},{"ID":"20240614094748-w8o1tgy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094748-w8o1tgy","updated":"20240614094751"},"Children":[{"Type":"NodeText","Data":"红花《要药分剂》"}]},{"ID":"20240614094748-y0l0v20","Type":"NodeParagraph","Properties":{"id":"20240614094748-y0l0v20","updated":"20240614094748"},"Children":[{"Type":"NodeText","Data":"味辛甘。性温。无毒。禀火土之气而生。可升可降。阴中阳也。得酒良。"}]},{"ID":"20240614094748-muj6ry9","Type":"NodeParagraph","Properties":{"id":"20240614094748-muj6ry9","updated":"20240614094748"},"Children":[{"Type":"NodeText","Data":"【主治】主产后血晕口噤。腹内恶血不尽绞痛。胎死腹中。并酒煮服。亦主蛊毒下血。"}]},{"ID":"20240614094748-zv65sqg","Type":"NodeParagraph","Properties":{"id":"20240614094748-zv65sqg","updated":"20240614094748"},"Children":[{"Type":"NodeText","Data":"堪作（【归经】入肝经。为行血之品。（肝经血分药入心养血生新多用破留血少用养血）【前论】汪颖曰。凡瘀行则血活。有热结于中。暴吐紫黑血者。吐出为好。吐未尽。加桃仁花汁红花。"}]},{"ID":"20240614094748-wc9o0vg","Type":"NodeParagraph","Properties":{"id":"20240614094748-wc9o0vg","updated":"20240614094748"},"Children":[{"Type":"NodeText","Data":"鳌按、番红花能令人心喜。及治惊悸。皆由能养心血也。"}]},{"ID":"20240614094748-0neayh9","Type":"NodeParagraph","Properties":{"id":"20240614094748-0neayh9","updated":"20240614094748"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。红花本行血药。血晕解。留滞行。即止。过用。能使血行不止而毙。"}]},{"ID":"20240614094603-1mzd0p3","Type":"NodeThematicBreak","Properties":{"id":"20240614094603-1mzd0p3"}},{"ID":"20240614094734-borl56d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094734-borl56d","updated":"20240614094742"},"Children":[{"Type":"NodeText","Data":"红花《本草经解》"}]},{"ID":"20240614094734-kf3vlgi","Type":"NodeParagraph","Properties":{"id":"20240614094734-kf3vlgi","updated":"20240614094734"},"Children":[{"Type":"NodeText","Data":"气温．味辛．无毒．主产后血晕口噤．腹内恶血不尽绞痛．胎死腹中．并酒煮服．亦主蛊毒．红花气温．禀天春和之木气．入足厥阴肝经．味辛无毒．得地西方之金味．入手太阴肺经．气味俱升．阳也．肝为藏血之脏．生生之经．产后血晕口噤者．产后则肝血不藏．肝枯则风炽．所以血晕而口噤也．治风先治血．血行风自灭．红花辛温润血．所以主之．腹内恶血不尽绞痛．胎死腹中．皆血寒不行．不能养肝之故．红花辛温．活血畅肝．所以主之也．并酒煎服者．借酒活血润血之力也．亦主蛊毒者．辛温则散而毒可解也．"}]},{"ID":"20240614094734-jd6ra36","Type":"NodeParagraph","Properties":{"id":"20240614094734-jd6ra36","updated":"20240614094734"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614094734-5sgtp81","Type":"NodeParagraph","Properties":{"id":"20240614094734-5sgtp81","updated":"20240614094734"},"Children":[{"Type":"NodeText","Data":"红花煎汁和童便服．治胞衣不下．产后血晕．同当归、生地、牛膝、白芍、益母、川芎、延胡索．治产后恶血不尽．"}]},{"ID":"20240614094603-7ng7tgy","Type":"NodeThematicBreak","Properties":{"id":"20240614094603-7ng7tgy"}},{"ID":"20240614094624-uqsf08z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094624-uqsf08z","updated":"20240614094627"},"Children":[{"Type":"NodeText","Data":"红花《中药学》"}]},{"ID":"20240614094624-25pkfwk","Type":"NodeParagraph","Properties":{"id":"20240614094624-25pkfwk","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【药用】菊科本草植物红花CarthamustinctoriusL.的筒状花序。"}]},{"ID":"20240614094624-g0u7ic2","Type":"NodeParagraph","Properties":{"id":"20240614094624-g0u7ic2","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、温。归肝、心经。"}]},{"ID":"20240614094624-wffjn84","Type":"NodeParagraph","Properties":{"id":"20240614094624-wffjn84","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【功效】活血祛瘀"}]},{"ID":"20240614094624-4ar4qgo","Type":"NodeParagraph","Properties":{"id":"20240614094624-4ar4qgo","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于症瘕结块，疮痈肿痛，跌仆伤痛，风湿痹痛，月经不调，经闭腹痛，产后瘀痛等症。"}]},{"ID":"20240614094624-gvtx8xu","Type":"NodeParagraph","Properties":{"id":"20240614094624-gvtx8xu","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"红花辛散温通，少用活血，多用祛瘀，为治瘀血组滞之要药，尤为妇女调经常用之品。在配伍方面，本品每与桃仁相须为用，活血则加当归、川芎、芍药等；祛瘀则加用三棱、莪朮、大黄、蟅虫等。"}]},{"ID":"20240614094624-j4l93l6","Type":"NodeParagraph","Properties":{"id":"20240614094624-j4l93l6","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"2.用于斑疹色暗。"}]},{"ID":"20240614094624-08ebeiy","Type":"NodeParagraph","Properties":{"id":"20240614094624-08ebeiy","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"本品又可用于麻疹出而复收，或热郁血滞、斑疹色不活红，取其活血祛瘀以化滞，可与当归、紫草、大青叶等活血凉血、泄热解毒之品配伍。"}]},{"ID":"20240614094624-tv8iw19","Type":"NodeParagraph","Properties":{"id":"20240614094624-tv8iw19","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"此外，近年来用本品治疗冠心病心绞痛，常与丹参、川芎、赤芍等同用；用于血栓闭塞性脉管炎，与当归、桃仁、赤芍、乳香等同用。"}]},{"ID":"20240614094624-yfzuoul","Type":"NodeParagraph","Properties":{"id":"20240614094624-yfzuoul","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【处方用名】红花杜红花（晒干用）"}]},{"ID":"20240614094624-nl72cv3","Type":"NodeParagraph","Properties":{"id":"20240614094624-nl72cv3","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。月经过多，孕妇忌用。"}]},{"ID":"20240614094624-s6fpdlo","Type":"NodeParagraph","Properties":{"id":"20240614094624-s6fpdlo","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【附药】番红花：又名藏红花。及鸢尾科草本植物番红花的干燥柱头。性味甘，寒。功效与红花相似，临床应用也基本相同，又兼有凉血解毒作用，可用于温病热入血分及斑痧大热等症。一般用量三分至一钱，煎服。因本品货少价格昂贵，故临床上较少应用。"}]},{"ID":"20240614094624-hc0ho8j","Type":"NodeParagraph","Properties":{"id":"20240614094624-hc0ho8j","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"【方剂举例】红花汤（《活法机要》）红花、干荷叶、牡丹皮、当归、蒲黄。治经闭腹痛，产后瘀血上逆之血晕。"}]},{"ID":"20240614094624-mgsrsfu","Type":"NodeParagraph","Properties":{"id":"20240614094624-mgsrsfu","updated":"20240614094624"},"Children":[{"Type":"NodeText","Data":"当归红花饮（《麻科活人全书》）当归、红花、牛蒡子、连翘、葛根、甘草。治疹出而复收，或热郁血滞，斑疹色暗者。"}]},{"ID":"20240614094603-f7pwlw7","Type":"NodeThematicBreak","Properties":{"id":"20240614094603-f7pwlw7"}},{"ID":"20240614094612-d5yvczg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094612-d5yvczg","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"《中国药典》：红花"}]},{"ID":"20240614094612-klvewx8","Type":"NodeParagraph","Properties":{"id":"20240614094612-klvewx8","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614094612-zn0tosp","Type":"NodeParagraph","Properties":{"id":"20240614094612-zn0tosp","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" Hónɡ Huā"}]},{"ID":"20240614094612-4i0bgt4","Type":"NodeParagraph","Properties":{"id":"20240614094612-4i0bgt4","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614094612-igc6qh8","Type":"NodeParagraph","Properties":{"id":"20240614094612-igc6qh8","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 草红花"}]},{"ID":"20240614094612-kqb2e4b","Type":"NodeParagraph","Properties":{"id":"20240614094612-kqb2e4b","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614094612-08caf2r","Type":"NodeParagraph","Properties":{"id":"20240614094612-08caf2r","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" FLOS CARTHAMI"}]},{"ID":"20240614094612-iwqa9mm","Type":"NodeParagraph","Properties":{"id":"20240614094612-iwqa9mm","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614094612-l5inr71","Type":"NodeParagraph","Properties":{"id":"20240614094612-l5inr71","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红花"},{"Type":"NodeText","Data":"Carthamus tinctorius L.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"。夏季花由黄变红时采摘取管状花，注意勿伤基部的子房，除去杂质，阴干或微火烘干，此时质较软，色深红最佳。（采收花朵时，应趁早晨露水未干、苞叶锐刺较软时进行，但也不宜过早。）"}]},{"ID":"20240614094612-kmwmqou","Type":"NodeParagraph","Properties":{"id":"20240614094612-kmwmqou","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614094612-sotsas6","Type":"NodeParagraph","Properties":{"id":"20240614094612-sotsas6","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 本品为不带子房的管状花，长1～2cm。表面红黄色或红色。花冠筒细长，先端5裂，裂片呈狭条形，长5～8mm。雄蕊5，花药聚合成筒状，黄白色；柱头长圆柱形，顶端微分叉。质柔软。气微香，味微苦。"}]},{"ID":"20240614094612-hwlm68f","Type":"NodeParagraph","Properties":{"id":"20240614094612-hwlm68f","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614094612-w3mv6n8","Type":"NodeParagraph","Properties":{"id":"20240614094612-w3mv6n8","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防潮，防蛀。"}]},{"ID":"20240614094612-lqwcwm2","Type":"NodeParagraph","Properties":{"id":"20240614094612-lqwcwm2","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614094612-pqhka0q","Type":"NodeParagraph","Properties":{"id":"20240614094612-pqhka0q","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末橙黄色。花冠、花丝、柱头碎片多见，有长管道状分泌细胞，常位于导管旁，直径约至 66μm，含黄棕色至红棕色分泌物。花冠裂片顶端表皮细胞外壁突起呈短绒毛状。柱头及花柱上部表皮细胞分化成圆锥形单细胞毛，先端尖或稍钝。花粉粒类圆形、椭圆形或橄榄形，直径约至 60μm，具3 个萌发孔，外壁有齿状突起。草酸钙方晶存在于薄壁细胞中，直径2～6μm。"}]},{"ID":"20240614094612-r8lqfof","Type":"NodeParagraph","Properties":{"id":"20240614094612-r8lqfof","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末0.5g，加80％丙酮溶液 5ml，密塞，振摇15分钟，静置，吸取上清液，作为供试品溶液。另取红花对照药材0.5g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｈ薄层板上，以醋酸乙酯－甲酸－水－甲醇（7:2:3:0.4） 为展开剂，展开，取出，晾干。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240614094612-saczorf","Type":"NodeParagraph","Properties":{"id":"20240614094612-saczorf","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614094612-5oljbgx","Type":"NodeParagraph","Properties":{"id":"20240614094612-5oljbgx","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 归心、肝经。"}]},{"ID":"20240614094612-wl9l6q3","Type":"NodeParagraph","Properties":{"id":"20240614094612-wl9l6q3","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614094612-5wplyw0","Type":"NodeParagraph","Properties":{"id":"20240614094612-5wplyw0","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240614094612-chsj9gu","Type":"NodeParagraph","Properties":{"id":"20240614094612-chsj9gu","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614094612-2lgl2il","Type":"NodeParagraph","Properties":{"id":"20240614094612-2lgl2il","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240614094612-hf62gfv","Type":"NodeParagraph","Properties":{"id":"20240614094612-hf62gfv","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614094612-21cjyf6","Type":"NodeParagraph","Properties":{"id":"20240614094612-21cjyf6","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 活血通经，散瘀止痛。用于经闭，痛经，恶露不行，症瘕痞块，跌扑损伤，疮疡肿痛。"}]},{"ID":"20240614094612-r2vxcfe","Type":"NodeParagraph","Properties":{"id":"20240614094612-r2vxcfe","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614094612-mjcxij1","Type":"NodeParagraph","Properties":{"id":"20240614094612-mjcxij1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240614094612-zkz4hvh","Type":"NodeParagraph","Properties":{"id":"20240614094612-zkz4hvh","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614094612-7t0l845","Type":"NodeParagraph","Properties":{"id":"20240614094612-7t0l845","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240614094612-jrea96i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094612-jrea96i","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：红花"}]},{"ID":"20240614094612-lm5d4ia","Type":"NodeParagraph","Properties":{"id":"20240614094612-lm5d4ia","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614094612-fu2mal5","Type":"NodeParagraph","Properties":{"id":"20240614094612-fu2mal5","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" Hónɡ Huā"}]},{"ID":"20240614094612-9bpoale","Type":"NodeParagraph","Properties":{"id":"20240614094612-9bpoale","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614094612-o469xrp","Type":"NodeParagraph","Properties":{"id":"20240614094612-o469xrp","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 红蓝花（《金匮要略》），刺红花（《四州中药志》），草红花（《陕西中药志》）。"}]},{"ID":"20240614094612-ry4nk14","Type":"NodeParagraph","Properties":{"id":"20240614094612-ry4nk14","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614094612-69erq81","Type":"NodeParagraph","Properties":{"id":"20240614094612-69erq81","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 《本草图经》"}]},{"ID":"20240614094612-x6yct4c","Type":"NodeParagraph","Properties":{"id":"20240614094612-x6yct4c","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614094612-tqtk2q1","Type":"NodeParagraph","Properties":{"id":"20240614094612-tqtk2q1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红花"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"。5～6月当花瓣由黄变红时采摘管状花，晒干、阴干或烘干。"}]},{"ID":"20240614094612-f0hsc08","Type":"NodeParagraph","Properties":{"id":"20240614094612-f0hsc08","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614094612-xy962hp","Type":"NodeParagraph","Properties":{"id":"20240614094612-xy962hp","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 全国各地多有栽培。主产河南、浙江、四川等地。"}]},{"ID":"20240614094612-wc1mu6e","Type":"NodeParagraph","Properties":{"id":"20240614094612-wc1mu6e","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614094612-rl5tejm","Type":"NodeParagraph","Properties":{"id":"20240614094612-rl5tejm","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 红花，又名：黄蓝（《博物志》），红蓝（崔豹《古今注》），红花草（《履巉岩本草》），红花菜（《救荒本草》）。"}]},{"ID":"20240614094612-j334bue","Type":"NodeParagraph","Properties":{"id":"20240614094612-j334bue","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"一年生草本，高30～90厘米，全体光滑无毛。茎直立，基部木质化，上部多分枝。叶互生，质硬，近于无柄而抱茎；卵形或卵状披针形，长3.5、9厘米，宽1～3.5厘米，基部渐狭，先端尖锐，边缘具刺齿；上部叶逐渐变小，成苞片状，围绕头状花序。花序大，顶生，总苞片多列，外面2～3列呈叶状，披针形，边缘有针刺；内列呈卵形，边缘无刺而呈白色膜质；花托扁平；管状花多数，通常两性，橘红色，先端5裂，裂片线形；雄蕊5，花药聚合；雌蕊1，花柱细长，伸出花药管外面，柱头2裂，裂片短，舌状。瘦果椭圆形或倒卵形，长约5毫米，基部稍歪斜，白色，具4肋。花期6～7月。果期8～9月。"}]},{"ID":"20240614094612-xc6m37a","Type":"NodeParagraph","Properties":{"id":"20240614094612-xc6m37a","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614094612-hscdf0g","Type":"NodeParagraph","Properties":{"id":"20240614094612-hscdf0g","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 干燥的管状花，长约1.5厘米，橙红色，花管狭细，先端5裂，裂片狭线形，长5～7毫米，雄蕊5枚，花药黄色，联合成管，高出裂片之外，其中央有柱头露出。具特异香气，味微苦。以花片长、色鲜红、质柔软者为佳。"}]},{"ID":"20240614094612-ylmzyhv","Type":"NodeParagraph","Properties":{"id":"20240614094612-ylmzyhv","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614094612-v1lj4w1","Type":"NodeParagraph","Properties":{"id":"20240614094612-v1lj4w1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 红花含红花黄色素及红花甙。红花甙经盐酸水解，得葡萄糖和红花素。还含15α，20β-二羟基-Δ4-娠烯-3-酮。另尚含脂肪油称红花油，是棕榈酸、硬脂酸、花生酸、油酸、亚油酸、亚麻酸等的甘油酯类。"}]},{"ID":"20240614094612-gxcvrln","Type":"NodeParagraph","Properties":{"id":"20240614094612-gxcvrln","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"叶含木犀草素-7-葡萄糖甙"}]},{"ID":"20240614094612-9am4bx5","Type":"NodeParagraph","Properties":{"id":"20240614094612-9am4bx5","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614094612-mcsfqip","Type":"NodeParagraph","Properties":{"id":"20240614094612-mcsfqip","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" ①对子宫的作用"}]},{"ID":"20240614094612-nlcd3iu","Type":"NodeParagraph","Properties":{"id":"20240614094612-nlcd3iu","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"煎剂对小鼠、豚鼠、兔、犬、猫之离体、在位子宫及家兔子宫瘘均有兴奋作用，但弱于番红花煎剂。早年报告之红花的药理研究品种未经鉴定，结果亦颇多未定之处。"}]},{"ID":"20240614094612-kvbcc0w","Type":"NodeParagraph","Properties":{"id":"20240614094612-kvbcc0w","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"②对循环系统的作用"}]},{"ID":"20240614094612-78yem2a","Type":"NodeParagraph","Properties":{"id":"20240614094612-78yem2a","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"煎剂与番红花煎剂性质相似，对麻醉动物有降压、抑制心脏等作用，但较弱。在离体兔耳标本上，有收缩血管的作用。冠心2号方（丹参：红花：赤芍：川芎：降香=2：1：1：1：1）水溶部分对犬在体冠状动脉（电磁流量计测定）及股动脉有扩张作用；其水、煎剂给大鼠连续4天，对垂体后叶素引起的心肌缺血则无作用。此外，红花水提取液10毫克／公斤静脉注射，对麻醉狗的冠脉流量（冠状窦插管法）有一定程度的增加。水提取液对血压无明显影响，而乙醇提取液（100～300毫克／公斤）则能使血压下降。对小鼠能增强其耐缺氧（置鼠于250毫升密闭广口瓶中，观察死亡时间）能力。"}]},{"ID":"20240614094612-hztjkdw","Type":"NodeParagraph","Properties":{"id":"20240614094612-hztjkdw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240614094612-ejr5jya","Type":"NodeParagraph","Properties":{"id":"20240614094612-ejr5jya","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"对高胆甾醇血症的家兔，口服红花油1克／公斤／日，可降低血清中总胆甾醇、总脂、三硝酸甘油酯吸非酯化脂肪酸的水平，口服冠心2号方浸膏（10毫升／只／天）可使实验性动脉粥样硬化之家兔的血清胆甾醇、中性脂肪和β-脂蛋白显著降低，主动脉壁的总胆甾醇和总脂量也较低，主动脉壁内膜斑块的面积及厚度以及冠状动脉前降枝和心肌内小动脉的病变均减轻，斑块的脂质染色比对照组较不均匀和脂质向中层移动，说明斑块有消退的倾向，但组织生化与形态观察指标按统计方法处理并无显著性。红花油也能兴奋某些平滑肌器官如小肠、支气管等。冠心2号方对离体大鼠回肠有抑制作用，并能拮抗乙酰胆碱所引起的肠管痉挛。红花毒性远较番红花为小：饲料中混入6％的红花药粉饲养小鼠1个月以上，未见体重下降，如增至8～10％时，体重下降，高达15％时才引起死亡；而番红花混入2％即可使小鼠在1个月以后出现体重减轻，再增加即出现死亡。"}]},{"ID":"20240614094612-22i5f7s","Type":"NodeParagraph","Properties":{"id":"20240614094612-22i5f7s","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614094612-yev9ojw","Type":"NodeParagraph","Properties":{"id":"20240614094612-yev9ojw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去茎叶、蒂头，晒干。"}]},{"ID":"20240614094612-l9ld4lw","Type":"NodeParagraph","Properties":{"id":"20240614094612-l9ld4lw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614094612-9qso2i2","Type":"NodeParagraph","Properties":{"id":"20240614094612-9qso2i2","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 入心、肝经。"}]},{"ID":"20240614094612-h8qh1cz","Type":"NodeParagraph","Properties":{"id":"20240614094612-h8qh1cz","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入心、肝二经。\""}]},{"ID":"20240614094612-otw9977","Type":"NodeParagraph","Properties":{"id":"20240614094612-otw9977","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"②《本草经解》：\"入足厥阴肝经，手太阴肺经。\""}]},{"ID":"20240614094612-t3aqbea","Type":"NodeParagraph","Properties":{"id":"20240614094612-t3aqbea","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、肾二经。\""}]},{"ID":"20240614094612-cw4iz3f","Type":"NodeParagraph","Properties":{"id":"20240614094612-cw4iz3f","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614094612-a0mz928","Type":"NodeParagraph","Properties":{"id":"20240614094612-a0mz928","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240614094612-3rn3ama","Type":"NodeParagraph","Properties":{"id":"20240614094612-3rn3ama","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"①《开宝本草》：\"辛，温，无毒。\""}]},{"ID":"20240614094612-wqpuzbi","Type":"NodeParagraph","Properties":{"id":"20240614094612-wqpuzbi","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"②《汤液本草》：\"辛而甘温苦。\""}]},{"ID":"20240614094612-wknvl40","Type":"NodeParagraph","Properties":{"id":"20240614094612-wknvl40","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614094612-t84ccuz","Type":"NodeParagraph","Properties":{"id":"20240614094612-t84ccuz","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 孕妇忌服。"}]},{"ID":"20240614094612-hb438o1","Type":"NodeParagraph","Properties":{"id":"20240614094612-hb438o1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614094612-5hs3hgz","Type":"NodeParagraph","Properties":{"id":"20240614094612-5hs3hgz","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 活血通经，去瘀止痛。治经闭，症瘕，难产，死胎，产后恶露不行、瘀血作痛，痈肿，跌扑损伤。"}]},{"ID":"20240614094612-75jtwer","Type":"NodeParagraph","Properties":{"id":"20240614094612-75jtwer","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"治口噤不语，血结，产后诸疾。\""}]},{"ID":"20240614094612-h13xlp5","Type":"NodeParagraph","Properties":{"id":"20240614094612-h13xlp5","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》：\"主产后血运口噤，腹内恶血不尽、绞痛，胎死腹中，并酒煮服。亦主蛊毒下血。\""}]},{"ID":"20240614094612-70ixp55","Type":"NodeParagraph","Properties":{"id":"20240614094612-70ixp55","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"③《本草蒙筌》：\"喉痹噎塞不通，捣汁咽。\""}]},{"ID":"20240614094612-9egur0l","Type":"NodeParagraph","Properties":{"id":"20240614094612-9egur0l","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"活血，润燥，止痛，散肿，通经。\""}]},{"ID":"20240614094612-817sqwp","Type":"NodeParagraph","Properties":{"id":"20240614094612-817sqwp","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"达痘疮血热难出，散斑疹血滞不消。\""}]},{"ID":"20240614094612-mqy1e28","Type":"NodeParagraph","Properties":{"id":"20240614094612-mqy1e28","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"利水消肿，安生胎，堕死胎。\""}]},{"ID":"20240614094612-4qjywym","Type":"NodeParagraph","Properties":{"id":"20240614094612-4qjywym","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614094612-cs4pw56","Type":"NodeParagraph","Properties":{"id":"20240614094612-cs4pw56","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱；入散剂或浸酒，鲜者捣汁。外用：研末撒。"}]},{"ID":"20240614094612-88oks65","Type":"NodeParagraph","Properties":{"id":"20240614094612-88oks65","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614094612-jk1n60u","Type":"NodeParagraph","Properties":{"id":"20240614094612-jk1n60u","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" ①治女子经脉不通，如血膈者：好红花（细擘）、苏枋木（捶碎）、当归等分。细切，每用一两，以水一升半，先煎花、木：然后入酒一盏，并当归再煎，空心食前温服。（《朱氏集验医方》）"}]},{"ID":"20240614094612-3a4qn1n","Type":"NodeParagraph","Properties":{"id":"20240614094612-3a4qn1n","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"②治热病胎死：红花酒煮汁，饮二、三盏。（《妇人良方补遗》）"}]},{"ID":"20240614094612-1rerwyh","Type":"NodeParagraph","Properties":{"id":"20240614094612-1rerwyh","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"③治胎衣不下：红花酒煮汁，饮二、三盏。（《产乳集验方》）"}]},{"ID":"20240614094612-vdpj78j","Type":"NodeParagraph","Properties":{"id":"20240614094612-vdpj78j","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"④治妇人六十二种风及腹中血气刺痛：红蓝花一两。以酒一大升，煎减半，顿服一半，未止再服。（《金匮要略》红蓝花酒）"}]},{"ID":"20240614094612-4fayt4b","Type":"NodeParagraph","Properties":{"id":"20240614094612-4fayt4b","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑤治一切肿：红蓝花，熟揉捣取汁服之。（《外台秘要方》）"}]},{"ID":"20240614094612-5zskccd","Type":"NodeParagraph","Properties":{"id":"20240614094612-5zskccd","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑥治喉痹壅塞不通者：红蓝花捣绞取汁一小升，服之，以差为度。如冬月无湿花，可浸干者浓绞取汁，如前服之。（《海上集验方》）"}]},{"ID":"20240614094612-fobza5a","Type":"NodeParagraph","Properties":{"id":"20240614094612-fobza5a","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑦治聤耳，累年脓水不绝，臭秽：红花一分，白矾一两（烧灰）。上件药，细研为末，每用少许，纳耳中。（《圣惠方》）"}]},{"ID":"20240614094612-ponovlh","Type":"NodeParagraph","Properties":{"id":"20240614094612-ponovlh","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑧治跌打及墙壁压伤：川麻一分，木香二分，红花三分，甘草四分。均生用，研末，黄酒送下。（《急救便方》）"}]},{"ID":"20240614094612-ppqjlg1","Type":"NodeParagraph","Properties":{"id":"20240614094612-ppqjlg1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑨治褥疮：红花适量，泡酒外搽。（《云南中草药》）"}]},{"ID":"20240614094612-qxu5wsg","Type":"NodeParagraph","Properties":{"id":"20240614094612-qxu5wsg","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614094612-85zhi87","Type":"NodeParagraph","Properties":{"id":"20240614094612-85zhi87","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" ①治疗急慢性肌肉劳损"}]},{"ID":"20240614094612-bupusak","Type":"NodeParagraph","Properties":{"id":"20240614094612-bupusak","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"用红花制成5％的注射液，在痛点或循经取穴注射。针头刺入后先行提插，待患者有酸麻胀感后再注入药液，每穴0.5～1毫升，每天或隔天1次，疗程视病情而定。观察132例，经治3～15次后，痊愈51例（37.8％），显效49例（37.1％），好转21例（15.9％），无效11例（8.3％），有效率达90.8％。有的注射5～6次即愈，1年多未见复发。治程中未发现不良反应；有的首次注射后有酸痛加重现象，以后多能逐渐减轻，一般仍继续治疗，不需使用辅助药物。"}]},{"ID":"20240614094612-d9ldwrw","Type":"NodeParagraph","Properties":{"id":"20240614094612-d9ldwrw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"②治疗砸伤、扭伤所致的皮下充血、肿胀等"}]},{"ID":"20240614094612-jvqqyoc","Type":"NodeParagraph","Properties":{"id":"20240614094612-jvqqyoc","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"取干红花按1％的比例浸入40％的酒精中一周，待红花呈黄白色沉于瓶底后，用纱布过滤。临用时加1倍蒸馏水稀释，以脱脂棉浸湿外敷，用绷带包扎，如果加热则效果更为显著。换药次数视伤处的轻重而增减。治砸伤、扭伤775例，痊愈347例，好转399例，无效29例。较轻病例2～3天即可恢复，较重者敷药后3～5天亦即充血消失，肿胀渐消。另治腱鞘炎59例，痊愈18例，好转39例，无效2例。此外，本品对疖肿初期亦有效，但已化脓者无效。"}]},{"ID":"20240614094612-vrvg149","Type":"NodeParagraph","Properties":{"id":"20240614094612-vrvg149","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"③治疗褥疮"}]},{"ID":"20240614094612-li4xwfe","Type":"NodeParagraph","Properties":{"id":"20240614094612-li4xwfe","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"用红花500克加水7000毫升，约煎2小时红花呈白色后过滤取液，再用文火煎约3～4小时，使呈胶状。用时涂于纱布上贴患部，覆以消毒纱布，固定。隔日换药1次。据20例24处褥疮治疗观察，5次以内治愈者8处，10次以内治愈者11处，10次以上者5处（其中有20～25次治愈的2例，病程达1～2年）"}]},{"ID":"20240614094612-fvvm0bs","Type":"NodeParagraph","Properties":{"id":"20240614094612-fvvm0bs","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"④治疗冠心病"}]},{"ID":"20240614094612-a23qwc8","Type":"NodeParagraph","Properties":{"id":"20240614094612-a23qwc8","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"用红花5钱、郁金6钱、丹参6钱、瓜蒌1两为一剂，经煎熬成流浸膏再烘干研碎后压成片剂30片。每次10片，日服3次，以4周为一疗程。观察44例，经2～4疗程后，90％以上心绞痛患者的症状获得不同程度的缓解（其中显效48.8％，改善41.5％）；对心电图的总有效率为63.5％（显效40.9％，好转22.6％）。初步证明：对轻度、中度慢性冠心病、心绞痛效果良好，并具有如下特点：㈠疗效出现较快（第1疗程症状改善者达75.6％）；㈡服药期间疗效较稳定（硝酸甘油类药物停减率100％）；㈢对合并有第一期和第二期高血压的患者同样有效。服药后几无副作用，除1例仅有短时上腹不适、轻度腹泻外，并无影响食欲和肠胃功能及其它不良反应。"}]},{"ID":"20240614094612-w282n0h","Type":"NodeParagraph","Properties":{"id":"20240614094612-w282n0h","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"⑤治疗胼胝"}]},{"ID":"20240614094612-17rzej1","Type":"NodeParagraph","Properties":{"id":"20240614094612-17rzej1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"取红花和地骨皮各40克研成细末，加甘油适量（约100克）搅匀备用。用药前以温肥皂水洗脚，擦干，涂油于足底，用消毒敷料包扎，每日2次，换药周余即可获愈。如胼胝有脓液内积，可以无菌梅花针轻刺引流脓液后，再行涂药，经数日后亦可痊愈。"}]},{"ID":"20240614094612-z587vuh","Type":"NodeParagraph","Properties":{"id":"20240614094612-z587vuh","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614094612-5on4q6q","Type":"NodeParagraph","Properties":{"id":"20240614094612-5on4q6q","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614094612-yz7aryw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614094612-yz7aryw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"《中华本草》：红花"}]},{"ID":"20240614094612-yr2q6k6","Type":"NodeParagraph","Properties":{"id":"20240614094612-yr2q6k6","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614094612-un9xf5q","Type":"NodeParagraph","Properties":{"id":"20240614094612-un9xf5q","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" Hónɡ Huā"}]},{"ID":"20240614094612-zw3s57c","Type":"NodeParagraph","Properties":{"id":"20240614094612-zw3s57c","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614094612-7a4h86c","Type":"NodeParagraph","Properties":{"id":"20240614094612-7a4h86c","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 红蓝花、刺红花、草红花"}]},{"ID":"20240614094612-80hsmql","Type":"NodeParagraph","Properties":{"id":"20240614094612-80hsmql","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614094612-x395zqp","Type":"NodeParagraph","Properties":{"id":"20240614094612-x395zqp","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" Safflower"}]},{"ID":"20240614094612-oqr929q","Type":"NodeParagraph","Properties":{"id":"20240614094612-oqr929q","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614094612-twsh7md","Type":"NodeParagraph","Properties":{"id":"20240614094612-twsh7md","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 1.出自《本草图经》：红蓝花，即红花也。今处处有之。人家场圃所种，冬而布子于熟地，至春生苗，夏乃有花，下作梂汇，多刺，花蕊出梂上，圃人承露采之，采已复出，至尽而罢。梂中结实，白颗，如小豆大。其花暴干以染真红，及作燕脂。主产后血病为胜。其实亦同。叶颇似蓝，故有蓝名。"}]},{"ID":"20240614094612-u9aimxd","Type":"NodeParagraph","Properties":{"id":"20240614094612-u9aimxd","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.《本草述钩元》：红蓝花，养血水煎，破血酒煮。"}]},{"ID":"20240614094612-9a6jmnx","Type":"NodeParagraph","Properties":{"id":"20240614094612-9a6jmnx","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614094612-aizfvtb","Type":"NodeParagraph","Properties":{"id":"20240614094612-aizfvtb","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物红花的花。"}]},{"ID":"20240614094612-bovhylf","Type":"NodeParagraph","Properties":{"id":"20240614094612-bovhylf","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Carthamus tinctorius L."}]},{"ID":"20240614094612-rk62l0r","Type":"NodeParagraph","Properties":{"id":"20240614094612-rk62l0r","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5月下旬开花，5月底至6月中、下旬盛花期，分批采摘。选晴天，每日早晨6-8时，待管状花充分展开呈金黄色时采摘，过迟则管状花发蔫并呈红黑色，收获困难，质量差，产量低。采回后阴干或用40-60℃低温烘干。"}]},{"ID":"20240614094612-aiy9s83","Type":"NodeParagraph","Properties":{"id":"20240614094612-aiy9s83","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614094612-htjm4gi","Type":"NodeParagraph","Properties":{"id":"20240614094612-htjm4gi","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 我国东北、华北、西北及山东、浙江、贵州、四川、西藏等地广泛栽培。"}]},{"ID":"20240614094612-4bzt9r6","Type":"NodeParagraph","Properties":{"id":"20240614094612-4bzt9r6","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614094612-rw2y20w","Type":"NodeParagraph","Properties":{"id":"20240614094612-rw2y20w","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 红花 越年生草本，高50-100cm。茎直立，上部分枝，白色或淡白色，光滑无毛。叶互生；无柄；中下部茎生叶披针形、卵状披针形或条椭圆形，长7-15cm，宽2.5-6cm，边缘具大锯齿、重锯齿、小锯齿或全缘，稀羽状深裂，齿顶有针刺，刺长1-1.5mm，向上的叶渐小，披针形，边缘有锯齿，齿顶针刺较长，可达3mm；全部叶质坚硬，革质，两面无毛，无腺点，有光泽。头状花序多数，在茎枝顶端排成伞房花序，为苞叶所围绕；苞片椭圆形或卵状披针形，连先端针刺长2.5-3cm，边缘有或无针刺；总苞片形，直径2.5cm；总苞片4层，外层竖琴状，中部或下部有收缢，收缢以上叶质绿色，边缘无针刺或有篦齿状针刺，收缢以下黄白色；中内层硬膜质，倒披针状椭圆形至长倒披针形，长达2.2cm，先端渐尖；全部苞片无毛，无腺点；小花红色、桔红色，全部为两性，花冠长2.8cm，细管部长2cm，花冠裂片几达檐部基部。瘦果倒卵形，长5.5mm，宽5mm，乳白色，有4棱，无冠毛。花果期5-8月。"}]},{"ID":"20240614094612-z4lirfx","Type":"NodeParagraph","Properties":{"id":"20240614094612-z4lirfx","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614094612-x71osv5","Type":"NodeParagraph","Properties":{"id":"20240614094612-x71osv5","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖干燥气候，耐寒、耐旱、耐盐碱、耐脊薄。发芽最适温度25℃，幼苗能耐-5℃。南方秋播生育期200-250d，北方春播生育期120d。以选向阳、地热高燥、土层深厚、中等肥力、排水良好的砂质壤土栽培为宜。忌连作，花期忌涝。前作以豆科、禾本科作物为好，可与蔬菜间作。"}]},{"ID":"20240614094612-6rzri5i","Type":"NodeParagraph","Properties":{"id":"20240614094612-6rzri5i","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。选种可用音株混合选择法，选取生长健壮，高度适中，分枝低而多，花序多，管状花桔红色，无病虫害的植株作留种植株。北方以栽无刺红花为主，南方以栽有刺红花为主。近年生来新疆和西北地区引进油红花栽培。播种前般用52-54℃温水浸种10min，转入冷水中冷却后，取出晾干后播种。赤有用30%菲酯拌种进行种子消素或用退菌特或多菌灵可湿性粉剂按种量的0.3%拌种后，施塑粒袋内闷1-2d，再行播种。播种期南方秋季10月中旬至11月初，北方春季3-4月，宜早不宜迟。穴播或条播。穴播按行析距40cm×25cm开穴，穴深6cm，每穴播种5-6颗。每1hm2用种量22.5-30kg。条播按行距40cm开条沟，沟深5-6cm，将种子均匀播入沟内，覆土，稍加镇压。每1hm2用种最30-45kg。约经15d左右出苗。"}]},{"ID":"20240614094612-ocqc17n","Type":"NodeParagraph","Properties":{"id":"20240614094612-ocqc17n","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高6-8cm时定苗，每穴留苗2株。条播按株距10-15cm间苗，遇有缺株，应时补苗。生长期需中耕除草3次，结合追肥培土。施肥应施足基肥，早施春肥，重施抽苔肥。基肥施用完全腐离的堆肥或厩肥。苗期追施两次粪肥，3-4月施人粪尿及过磷酸钙；4月上旬现蕾进施硫酸铵，过磷酸钙；开花前用1%的尿互。3%地磷酸钙浇施。赤可根外追肥，用0.1%-0.3%磷酸二氢钾单一或混合喷施，可促使花蕾多而大。苗期和开花期遇旱，需要浇水保持土壤一定的温度；多雨季节要及时开沟排水。抽苔后摘除顶芽，促使分枝和花苗增多，如栽培过密或土地脊薄则不宜摘心去顶。"}]},{"ID":"20240614094612-9ibueva","Type":"NodeParagraph","Properties":{"id":"20240614094612-9ibueva","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"病虫害防治 红花炭疽病，发病部伴茎、叶、花蕾。5月发病，出现紫经色或褐色纺锤形病斑，逐渐扩大，稍凹，并有橙红色粘性物质，使茎枝枯萎，花蕾不能开放。防治方法，实行水旱轮作。发病时可用代森锌500-600倍或可湿性甲基托布津500-600倍液喷射。锈病，高湿易发病，应选地热高燥处实行轮作，种子进行消毒。发病时喷15%粉锈宁500倍液。红花枯萎病，为害茎中或主根，使轮导组织破坏而枯萎。5月发病，可用50%甲基托布津1000倍液浇灌或50%多菌灵500-600倍液灌根部。另有菌核病等为害。虫害有红花实蝇，用90%晶体敌百虫800倍液喷射。红花指管蚜，为害茎叶及嫩梢，4月下旬吸取植析汁液，用花学药剂或用鱼藤粉700-800倍液喷射。赤要用烟草浸在水中（1：10）24h，加热煮沸，地滤去渣，取澄清液稀释使用，最好加紫洗衣为分，增加粘着力，又可延长药效。现用食蚜蝇作天敌进行防治。"}]},{"ID":"20240614094612-yy3giq1","Type":"NodeParagraph","Properties":{"id":"20240614094612-yy3giq1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614094612-dn6eapm","Type":"NodeParagraph","Properties":{"id":"20240614094612-dn6eapm","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 为不带子房的筒状花，长1-2cm。表面红黄色或红色。花冠筒细长，先端5裂，裂片呈狭条形，长5-8mm。雄蕊5，花药聚合成筒状，黄白色。柱头长圆柱形，顶端微分叉。质柔软。气微香，味微苦。"}]},{"ID":"20240614094612-5mi603k","Type":"NodeParagraph","Properties":{"id":"20240614094612-5mi603k","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"以花冠长、色红、鲜艳、质柔软无枝刺者为佳。"}]},{"ID":"20240614094612-hqv1hq7","Type":"NodeParagraph","Properties":{"id":"20240614094612-hqv1hq7","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"显微特征 粉末特征：橙黄色。①分泌细胞呈长管状，常位于导管旁，直径约至66μm，含黄棕色至红棕色分泌物。②花冠裂片顶端表皮细胞外壁突起呈短绒毛状。③柱头及花柱上部表皮细胞分化成圆锥单细胞毛，先端尖或稍钝。④花粉粒深黄色，类圆形、椭圆形或橄榄形，直径约至60μm，具3个萌发孔，外壁有齿状突起。⑤草酸钙方晶直径2-6μm，存在于薄壁细胞中。"}]},{"ID":"20240614094612-jpk7uhg","Type":"NodeParagraph","Properties":{"id":"20240614094612-jpk7uhg","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614094612-kprfcdn","Type":"NodeParagraph","Properties":{"id":"20240614094612-kprfcdn","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 毒性:红花黄色素静脉注射对小鼠的LD50为2.35±0.14g/kg。红花醇提液静肪红药对小鼠的LD50为5.3g/kg。红花煎剂小鼠1p的MLD约等于1.2g/kg。小鼠iv醇提液LD505.3g（相当生药量）/kg。红花甙小鼠1v的LD50为2.35±0.14g/kg，po的安全剂量＞8g/kg。50%红花注射液给兔点眼，对结膜无刺激性；试管内无溶血作用；小鼠ip12.5g/kg，观察2天不致死，也无毒性反应。红花黄色素ip和ig对小鼠72小时的LD50分别为5.49g/kg，5.53g/kg，小鼠死前出现活动增加，行立不稳，呼吸急促，竖尾，随即发生强直惊厥，最后出现呼吸抑制。多数于24小时内死亡。红花黄色素的亚急性毒性观察，家兔10只，随机分为对照组4只，实验组6只，ig550mg/kg，每天1次，连续10天，实验组3只兔于停药后3天，另3只于停药后20天分别处死，体重、血红蛋白、白细胞总数及血小板计数、脏器重量及组织学检查，均未见明显影响。红花甙混入饲料中喂养幼龄大鼠，每天摄入量约0.015-1.5g/kg，连续3mo。结果血象和肝、肾功能无明显改变，心、肝、肾、胃、肠等脏器的形态也未发现异常。"}]},{"ID":"20240614094612-a2ebxyf","Type":"NodeParagraph","Properties":{"id":"20240614094612-a2ebxyf","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614094612-1ecw5s3","Type":"NodeParagraph","Properties":{"id":"20240614094612-1ecw5s3","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 1.花含红色的和黄色的色素，从中分离得到：红花甙（carthamin），前红花甙（precarthamin），红花黄色素（safflow yellow）A及B[1-3]，红花明甙（safflominA）A[4]。又含多酚类成分：绿原酸（chlorogenic acid），加啡酸（caffeic acid），儿茶酚（cate-chol），焦性儿茶酚（pyrocatechol），多巴（dopa）[1]。还含挥发性成分八十余种，已确定结构的有：乙酸乙酯（ethyl acetate），苯（benzene），1-戊烯-3-醇（pent-1-en-3-ol），3-已醇（3-hexanol），2-已醇（2-hexanol），（E）-2-已烯醛[（E）-2-hexenal]，3-甲基丁酸（3-methyl butyric acid），2-甲基丁酸（2-methy butyric acid），乙苯（ethylbenzene），对二甲苯（p-xylene），邻二甲苯（o-xylene），苯乙醛（phenyl acetaldehyde），壬醛（nonanal），松油烯-4-醇（terpinen-4-ol），马革命烯酮（verbenone），癸醛（decanal），苯并噻唑（benzothia-zole），（E、E）-2，4-癸二烯醛[（E、E）-2，4-decadienal]，桂皮酸甲酯（methyl cinnamate），1，2，3-三甲氧基-5-甲基苯（1，2，3-TCMLIBimethoxy-5-methylbenzene），α-（王古）（王巴）烯（α-copaene），1-二四碳烯（1-teTCMLIBadecene），α-柏木烯（α-cedrene），丁香烯（caryophyllene），（E）-β-金合欢烯[（E）-β-farnesene]，葎草烯（humulene），β-紫罗兰酮（β-ionone），β-芹子烯（β-selinene），二氢猕桃内酯（dihydroac-tinidiolide），1-十五碳烯（1-pentadecene），ζ-荜澄茄烯（ζ-cadinene），丁香烯环氧化物（caryophyllene epoxide），1-十六碳烯（1-hexadecene），1，3，5，11-十三碳四烯-7，9-二炔（1，3，5，11-TCMLIBidecateTCMLIBaene-7，9-diyne），（E、E、E）、（E、Z、E）和（Z、E、E）的三种异构体，（Z、Z）-1，3，11-十三碳三烯-5，7，9-三炔[（Z、Z）-1，3，11-TCMLIBidecaTCMLIBiene-5，7，9-TCMLIBiyen]，（Z、Z）-1，8，11-十七碳三烯[（Z、Z）-1，8，11-heptadecaTCMLIBiene]，1，3，11-十三碳三烯-5，7，9-三炔（1，2，33-TCMLIBidecaTCMLIBiene-5，7，9-TCMLIBiyne）的（Z、E）和（E、E）的两种异构体，（Z、Z、Z）-1，8，11，14-十七碳四烯[（Z、Z、Z）-1，8-11，14-hep-tadecateTCMLIBaene]，（Z）-1，11-十三碳二烯-3，5，7，9-四炔[（Z）-1，3，5-十三碳三烯-7，9-11-三炔][（E、Z）-1，3，5-TCMLIBidecaTCMLIBiene-7，9，11-TCMLIBiyen]，1-十七碳烯（1-heptadecaene），（E）-1，3，5-TCMLIBidecaTCMLIBiene-7，9，11-TCMLIBiyne]，1，3-十三碳二烯-5，7，9，11-四炔（1，3-TCMLIBidecadiene-5，7，9-teTCMLIBayne），1，3-十三碳二烯-5，5，7，9-四炔[（E）-1，11-TCMLIBidecadiene-3，5，7，9-teTCMLIBayne]，1，3-十三碳二烯-5，7，9，11-四炔（1，3-TCMLIBidecadiene-5，7，9，11-teTCMLIBayne）有（E）和（Z）两种异构体，（E、E）-1，3，5-十三碳三烯-7，9，11-三炔[（E、E）-1，3，5-TCMLIBideca-TCMLIBiene-7，9，11-TCMLIBiyne]，3-甲基丁酸-4，6-癸二炔-1-醇酯（deca-4，6-diyn-1-yl 3-methylbutyrate），1-十三碳烯-3，5，7，9，11-五炔（1-TCMLIBidecene-3，5，7，9，11-pentayne）]，3-甲基丁酸-（Z）-8-癸烯-4，6-二炔醇-1-酯[（Z）-8- decene-4，6-二炔-1-醇酯[（E、Z）-2，8-decadiene-4，6-diyn-1-yl 3-methyl butyrate][5]等。又含量最少的是带有苯环的和含硫的氨基酸[6]。还含鼠李糖（rhamnose），阿拉伯糖（arabinose），木糖（xylose），葡萄糖（glucose），甘露糖（mannose）[6]，二十九烷（nonacosane），β-谷甾醇（β-sitosterol），棕榈酸（palmitic acid），肉豆蔻酸（myristic acid），月桂酸（lauric acid）[7]，α，γ-二棕榈酸甘油酯（α，γ-dipalmitin），油酸（oleic acid），亚油酸（linoleic acid），β-谷甾醇-3-O-葡萄糖甙（β-sitosterol-3-O-glucoside）[8]。另含红花多糖，系由葡萄糖，木糖，阿拉伯糖与半乳糖（galactose）以β-链联接的一种多糖[9]。又含具降血压作用的丙三醇-呋喃阿糖-吡喃葡萄糖甙[propaneTCMLIBiol-α-L-arabinofuranosyl(1→4)-β-D-glucopyrano-side][10]。"}]},{"ID":"20240614094612-8w0n350","Type":"NodeParagraph","Properties":{"id":"20240614094612-8w0n350","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"新钱花蕾含木犀草素-7-O-葡萄糖甙（luteolin-7-O-gluco-side），胆甾醇（cholesterol），豆甾醇（stigmasterol），β-谷甾醇，月桂酸，肉豆蔻酸，棕榈酸，亚油酸，硬脂酸（stearic acid），花生酸（arachidic acid）[11]。"}]},{"ID":"20240614094612-xrej421","Type":"NodeParagraph","Properties":{"id":"20240614094612-xrej421","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614094612-yhsyuas","Type":"NodeParagraph","Properties":{"id":"20240614094612-yhsyuas","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 1.对心血管系统的作用:1.1.抑制心脏作用：红花煎剂小剂量能使蟾蜍离体心脏及兔在体心脏轻度兴奋，使心跳有力，振幅加大；大剂量则对心脏有抑制作用，使心率减慢，心肌收缩力减弱，心搏出量减少。"}]},{"ID":"20240614094612-md4esoa","Type":"NodeParagraph","Properties":{"id":"20240614094612-md4esoa","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"1.2.对冠脉血流量的实验研究表明:红花水提取物及红花水溶性混合物-红花黄色素有增加冠脉血流量及心肌营养性血流量的作用；而红花乙醇提取物的扩张冠脉及增加冠脉血流量的作用则不明显或无影响。"}]},{"ID":"20240614094612-un5qie8","Type":"NodeParagraph","Properties":{"id":"20240614094612-un5qie8","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"1.3.对实验性心肌缺血及心肌梗塞的实验研究表明：在兔、大鼠、犬等造成实验性心肌缺血或心肌梗塞的动物模型上，红花及其制剂均有不同程度的对抗作用。红花可使因垂体后叶素引起的大鼠或家兔急性心肌缺血有明显保护作用；可使反复短暂阻断冠状动脉血流造成麻醉犬急性心肌缺血的程度明显减轻，范围缩小，心率减慢，并保护急性心肌梗塞区的边缘，区而缩小梗塞范围及降低边缘区心电图ST段抬高的幅度，从而改善缺血心肌氧的供求关系。"}]},{"ID":"20240614094612-3r08ya3","Type":"NodeParagraph","Properties":{"id":"20240614094612-3r08ya3","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"1.4.红花对血管作用的研究发现：如先用含微量肾上腺素或去甲肾上腺素的洛氏液灌流血管，使动物离体血管平滑肌收缩保持一定的血管紧张性，造成可能类似人的血脉不通、血瘀状态。红花可使紧张性增高的豚鼠后肢和兔耳呈现血管扩张作用，并随剂量增加而作用明显，红花亦可增加麻醉犬股动脉血流量，但对蟾蜍和兔的正常离体血管可使之收缩。表明红花扩张血管作用与血管的功能状态和药物的剂量有关。其作用机制可能主要是直接或部分对抗a-肾上腺素能受体的作用而使血管扩张，并有较弱的直接收缩血管作用。"}]},{"ID":"20240614094612-18bei8f","Type":"NodeParagraph","Properties":{"id":"20240614094612-18bei8f","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"1.5.红花对实验动物缺血性脑卒中引起的脑水肿的影响：应用红花注射液（1ml内含生药lg），对63只蒙古沙土鼠进行术前30分钟ip给于10g/kg红花注射液，并设立了手术对照组和假手术组，观察红花对缺血性脑水肿的影响，并研究了同一脑区的单胺类神经介质含量的变化。结果提示红花减轻缺血性脑水肿的机理，可能与它能影响组织中单胺类神经介质的代谢紊乱有关。并进一步证实红花确实能降低脑卒中发生率及死亡率，对实验性胸梗塞动物的脑组织具有保护作用。"}]},{"ID":"20240614094612-a8zcqdg","Type":"NodeParagraph","Properties":{"id":"20240614094612-a8zcqdg","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"1.6.降压作用:红花煎剂、红花黄色素及其他制剂对麻醉猫或犬均有不同程度的迅速降压作用，平均血压下降20分钟Hg左右，持续约30分钟后恢复。"}]},{"ID":"20240614094612-xpheu2l","Type":"NodeParagraph","Properties":{"id":"20240614094612-xpheu2l","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"1.7.红花黄色素的抗凝血作用实验研究表明:红花黄色素具有非常显着地抑制ADP诱导的家兔血小板聚集作用，并对ADP已聚集的血小板也有非常明显的解聚作用。当剂量为0.22g/ml时，聚集抑制率和解聚百分率分别达到85.9%和78.9%。红花黄色素的这些作用，随着剂量的增加而增强。红花黄色素对大鼠实验性血栓形成，有非常显着的抑制效应，其抑制率为73.4%。由于实验采用丝线上形成的血栓物质基础系血小板聚集物，因此血栓湿重的减轻，显然是药物抑制血小板聚集的结果。与体外实验所证实的红花黄色素能抑制ADP引起的血小板聚集作用是一致的。红花黄色素尚可明显延长家兔血浆复钙时间、凝血酶原时间和凝血时间。表明它能同时影响体内和体外的凝血系统。此外，红花油有降低血脂作用。"}]},{"ID":"20240614094612-f3su7sf","Type":"NodeParagraph","Properties":{"id":"20240614094612-f3su7sf","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.对动物耐缺氧的影响:2.1.抗疲劳作用:红花黄色素1100mg/kg小鼠与对照组（用等量生理盐水）比较，游泳时间明显延长，延长率达117.O%，P\u003c0.01。"}]},{"ID":"20240614094612-3ifueav","Type":"NodeParagraph","Properties":{"id":"20240614094612-3ifueav","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.2.对小鼠常压缺氧耐力的影响:小鼠ipll00mg/kg红花黄色素，与对照组（等容量生理盐水）比较，在给药30分钟后，每鼠分别放入盛有15g钠石灰的125ml密闭玻璃瓶中，实验组延长存活时间48.8%，P\u003c0.01。"}]},{"ID":"20240614094612-1wi2rzr","Type":"NodeParagraph","Properties":{"id":"20240614094612-1wi2rzr","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.3.对小鼠减压缺氧耐力的影响:同上法小鼠给药30分钟后，将小鼠分别放入容积相等的仓内，密闭减压至负压450mmHg，观察60分钟。结果与对照组比较，存活率（%）15：10，给药组延长存活时间168.72%，P\u003c0.001。"}]},{"ID":"20240614094612-jezsa6s","Type":"NodeParagraph","Properties":{"id":"20240614094612-jezsa6s","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.4.对异丙肾上腺增加耗氧量的影响实验表明:红花黄色素可显着延长小鼠对减压缺氧的存活时间（P\u003c0.001)，但对存活率提高不明显。"}]},{"ID":"20240614094612-qeagfx0","Type":"NodeParagraph","Properties":{"id":"20240614094612-qeagfx0","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.5.对NaNO2中毒组织缺氧的影响:实验组与对照组小鼠各10只，给红花黄色素1100mg/kg30分钟后，两组动物均ip2%NaNO2溶液0.1ml/10g，记录小鼠存活时间。结果表明红花黄色素组动物存活时间（118.40±84.31分钟）比对照组动物存活时间（56.30±25.30分钟）延长110.3%（P\u003c0.05)。"}]},{"ID":"20240614094612-da184l8","Type":"NodeParagraph","Properties":{"id":"20240614094612-da184l8","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.6.对脑缺血性缺氧的影响:取小鼠24只，分两组。Ip红花黄色素1100mg/kg后30分钟，采用Yasuda氏测定脑缺血性缺氧法略加改变。观察断头至最后一次喘息所需时间。结果表明，小鼠脑缺血性缺氧后的喘息延续时间，红花黄色素组（18.88±4.02s）比对照组（12.83±4.11s）有显着地延长，其延长率为47.2%（P\u003c0.01）。"}]},{"ID":"20240614094612-q577fsj","Type":"NodeParagraph","Properties":{"id":"20240614094612-q577fsj","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.7.对心肌缺氧的影响:红花黄色素可明显增加离体家兔心脏和心肌缺氧时的冠脉流量。从灌流侧管注入22%红花黄色素0.2ml连续记录1，3，5，7，10分钟流量，取其均值，比较给药前后的冠脉流量。结果当注药l分钟时冠脉流量增加最明显（P\u003c0.001），7分钟后逐渐恢复到给药前水平。氮气缺氧情况下，冠脉流量1-3分钟亦有明显增加（P\u003c0.01），5分钟后流量逐渐减少。红花乙醇提取液4.0g/kg给大鼠ip及红花水煎剂1.0g/kg给小鼠ip，均能显着延长常压缺氧条件下的存活时间。"}]},{"ID":"20240614094612-ud92n40","Type":"NodeParagraph","Properties":{"id":"20240614094612-ud92n40","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"3.对子宫的作用:红花煎剂对小鼠、豚鼠、兔与犬的离体子宫均有兴奋作用。麻醉动物实验表明，煎剂iv对小鼠、猫与犬的在位子宫也都有兴奋作用。无论离体或在位于宫给药后紧张性或（和）节律性明显增加，有时兴奋作用强烈，可引起痉挛。对已孕子宫的作用比未孕者更为明显。子宫瘘兔iv煎剂后亦出现子宫兴奋反应，收缩频率增加，幅度加大，作用较持久。亦有报道，在摘除卵巢小鼠的阴道周围注射红花煎剂，可使子宫重量明显增加，提示有雌激素样作用。"}]},{"ID":"20240614094612-oi0c8e4","Type":"NodeParagraph","Properties":{"id":"20240614094612-oi0c8e4","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"4.镇痛和镇静作用:取小鼠40只，分4组。分别ip红花黄色素550mg/kg、1100mg/kg、盐酸吗啡20mg/kg及等容量生理盐水。30分钟后ip0.7%冰醋酸0.1ml/10g。观察每鼠在20分钟内扭体次数，与对照组比较，计算小鼠扭体反应抑制率。结果两种剂量的红花黄色素均能明显抑制小鼠扭体反应，P均\u003c0.001。用上述两种剂量的组的小鼠，30分钟后各组动物ip巴比妥钠阈下催眠剂量300mg/kg或水合氯醛阈下催眠剂量250mg/kg。观察30分钟内翻正反射消失达l分钟以上的小鼠数，计算各组动物入睡率。结果表明，给巴比妥钠阈下剂量的对照动物均呈清醒状态，而与红花黄色素合用，大剂量的入睡率提高40%，大剂量提高70%（P\u003c0.01）；两种剂量可使水合氯醛阈下剂量入睡率由20%，分别提高50%和80%（P\u003c0.01），提示红花黄色素有明显增强巴比妥及水合氯醛的中枢抑制作用，其作用与用量成平行关系。"}]},{"ID":"20240614094612-2f6b0hu","Type":"NodeParagraph","Properties":{"id":"20240614094612-2f6b0hu","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"5.抗炎作用:5.1.对大鼠甲醛性足跖肿胀的影响:15只大鼠分为3组，分别ipll00mg/kg红花黄色素、氢化可的松20mg/kg和生理盐水。给药后30分钟，于左右足跖部sc2.5%甲醛溶液0.05ml致炎，致炎后1、3、5、7、24小时，用于分尺测量大鼠足肿厚度，并与致炎前的足肿厚度比较，计算各药物组不同时间的足肿胀率。结果红花黄色素对甲醛性足肿胀有明显抑制作用（P"}]},{"ID":"20240614094612-4r0sbgs","Type":"NodeParagraph","Properties":{"id":"20240614094612-4r0sbgs","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"5.2.对大鼠毛细血管通透性的影响:大鼠14只，分2组，用药组ipll00mg/kg红花黄色素，对照组给于等量生理盐水。30分钟后，于大鼠腹部皮内注射磷酸组胺50?g/0.05ml，立即ivl%伊文氏蓝10mg/kg。20分钟后断头处死动物，剥开皮肤，观察注射组胺部位皮内蓝染面积，比较两组间差异。结果红花黄色素及对照组的染色面积分别为63.6±9.9mm2和582.3±6.6mm2（X±SD）。用药组的抑制率为89.1%（P\u003c0.001）。表明对组胺引起的大鼠皮肤毛细血管的通透量增加有明显的抑制作用。"}]},{"ID":"20240614094612-rplzm76","Type":"NodeParagraph","Properties":{"id":"20240614094612-rplzm76","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"5.3.对大鼠棉球肉芽肿形成的影响:采用Meier氏等的棉球法，在大鼠两侧腋部皮下各埋入重10mg无菌棉球1个。实验组7只大鼠每天ipll00mg/kg红花黄色素，对照组5只大鼠用等量生理盐水，共给药4天。D5天处死动物，取出棉球肉芽组织，烘干称重。比较两组肉芽肿形成的抑制率。结果红花黄色素对大鼠棉球肉芽肿形成有显着抑制作用（P\u003c0.001）。"}]},{"ID":"20240614094612-llhccj6","Type":"NodeParagraph","Properties":{"id":"20240614094612-llhccj6","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"6.免疫活性:红花多糖不同于高等植物中a-键连接的多糖，类似于细菌来源的多糖。从体外淋转实验表明，红花多糖与T细胞致有丝分裂原ConA有协同作用，对B细胞致有丝分裂原Dex-TCMLIBansulfate无明显影响。但体内PFC试验，红花多糖与一般认为作用于B细胞的黄芪多糖作用趋势一致。给小鼠注射红花多糖的时间不同，小鼠PFC值的变化也不同：致敏后给药组的PFC被促进，而致敏前给药组的PFC反被抑制。表明红花多糖同样显示了免疫药物的双向性。红花多糖能明显对抗强的松龙的免疫抑制作用，它对强的松龙抑制小鼠的免疫增强作用较对正常小鼠的作用更为明显。因此，红花多糖能促进淋已细胞转化，增加脾细胞对羊红细胞空斑形成的细胞数，对抗强的松龙的免疫抑制作用等，表明它是一种新的、值得进一步研究的免疫调节剂。另红花总黄素（SY）降低血清溶菌酶含量、腹腔巨噬细胞和全血白细胞吞噬功能；使PFC、SRFC和抗体产生减少；抑制DH反应和SOI诱导的Tｓ细胞活化，体外，SY0.03-3.0，0.1-2.O和0.1-2.5mg/ml抑制TdR掺入的T、B淋巴细胞转化、MLC反应、IL2的产生及其活性。"}]},{"ID":"20240614094612-5k1thwk","Type":"NodeParagraph","Properties":{"id":"20240614094612-5k1thwk","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"7.对神经系统的作用：小鼠ip红花黄色素0.55g/kg、1.1g/kg，对注射戊巴比妥钠阈下剂量0.3g/kg或水合氯醛阈下剂量0.25g/kg的小鼠，均能提高入睡率（P\u003c0.01，P\u003c0.001），说明能明显增强戊巴比妥钠及水合氯醛的中枢抑制作用，其作用强度与用量成平行关系。1.1g/kg红花黄色素对小鼠ip，能明显减少尼可刹米引起的小鼠惊厥反应率和死亡率（P\u003c0.05），但不能对抗戊四氮、咖啡因和硝酸一叶?碱引起的惊厥和死亡。红花注射液10g/kg，对蒙古沙士鼠ip，能降低一侧左颈动脉结扎的脑卒中发生率，明显减轻由脑卒中引起的脑水肿，说明红花降低卒中发生率可能与减轻脑水肿有一定关系。由于红花可使支循环扩张，增加脑缺血区的血流量，从而减轻脑水肿。红花又能减轻脑组织中单胺类神经介质的代谢紊乱，使下降的神经介质恢复正常或接近正常。这可能也是红花减轻脑水肿的机理之一。"}]},{"ID":"20240614094612-r2i0cc5","Type":"NodeParagraph","Properties":{"id":"20240614094612-r2i0cc5","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614094612-m5nfep1","Type":"NodeParagraph","Properties":{"id":"20240614094612-m5nfep1","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去茎叶、蒂头，晒干。"}]},{"ID":"20240614094612-hv5ijnn","Type":"NodeParagraph","Properties":{"id":"20240614094612-hv5ijnn","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614094612-t8ce3co","Type":"NodeParagraph","Properties":{"id":"20240614094612-t8ce3co","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品1g，加70%乙醇10ml，浸清。倾取浸出液，于浸出液内悬挂一滤纸条，5min后把滤纸条放入水中，随即取出，滤纸条上部显淡黄色，下部显淡红色。（检查红花甙）"}]},{"ID":"20240614094612-6uhkna9","Type":"NodeParagraph","Properties":{"id":"20240614094612-6uhkna9","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614094612-trgxujp","Type":"NodeParagraph","Properties":{"id":"20240614094612-trgxujp","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 归心；肚经"}]},{"ID":"20240614094612-1vnyw04","Type":"NodeParagraph","Properties":{"id":"20240614094612-1vnyw04","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614094612-ypfnc5q","Type":"NodeParagraph","Properties":{"id":"20240614094612-ypfnc5q","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 味辛；性温"}]},{"ID":"20240614094612-o2qkutj","Type":"NodeParagraph","Properties":{"id":"20240614094612-o2qkutj","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614094612-n2tq64k","Type":"NodeParagraph","Properties":{"id":"20240614094612-n2tq64k","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 孕妇忌服。"}]},{"ID":"20240614094612-kd13csu","Type":"NodeParagraph","Properties":{"id":"20240614094612-kd13csu","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614094612-93s81k7","Type":"NodeParagraph","Properties":{"id":"20240614094612-93s81k7","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 活血通经；祛瘀止痛。主经闭；痛经；产后瘀阻腹痛；胞痹心痛症瘕积聚；跌打损伤；关节疼痛；中风偏竣；斑疹"}]},{"ID":"20240614094612-umxyood","Type":"NodeParagraph","Properties":{"id":"20240614094612-umxyood","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614094612-o6u3kzr","Type":"NodeParagraph","Properties":{"id":"20240614094612-o6u3kzr","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g。养血和血宜少用；活血祛瘀宜多用。"}]},{"ID":"20240614094612-5sbq68l","Type":"NodeParagraph","Properties":{"id":"20240614094612-5sbq68l","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614094612-23b7mo9","Type":"NodeParagraph","Properties":{"id":"20240614094612-23b7mo9","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 1.红蓝花酒方(《金匮要略》)，具活血行瘀，利气止痛之功。2.桃红四物汤(《医宗金鉴》)，养血，活血，逐瘀。3.血府逐瘀汤(《医林改错》)，活血祛瘀，行气止痛，主治胸中血瘀，血行不畅，胸痛，头痛日久不愈，痛如针刺而有定处等症。4.通窍活血汤(《医林改错》)，活血通窍，主治瘀阻头面的头痛头昏，或白癜风，以及妇女干血痨，小儿疳积等。5.身痛逐瘀汤(《医林改错》)，活血行气，祛瘀通络，通痹止痛，主治气血痹阻经络所致的肩痛，臂痛，腰痛，腿痛，或周身疼痛，经久不愈。6.复元活血汤(《医学发明》)，活血祛瘀，疏肝通络，主治跌打损伤，瘀血留于胁下，痛不可忍。"}]},{"ID":"20240614094612-q625nqu","Type":"NodeParagraph","Properties":{"id":"20240614094612-q625nqu","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614094612-egfu5hw","Type":"NodeParagraph","Properties":{"id":"20240614094612-egfu5hw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 1.《唐本草》：治口噤不语，血结，产后诸疾。"}]},{"ID":"20240614094612-bbtph68","Type":"NodeParagraph","Properties":{"id":"20240614094612-bbtph68","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"2.《开宝本草》：主产后血运口噤，腹内恶血不尽、绞痛，胎死腹中，并酒煮服。亦主蛊毒下血。"}]},{"ID":"20240614094612-3mvlzle","Type":"NodeParagraph","Properties":{"id":"20240614094612-3mvlzle","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"3.《本草蒙筌》：喉痹噎塞不通，捣汁咽。"}]},{"ID":"20240614094612-vi894s3","Type":"NodeParagraph","Properties":{"id":"20240614094612-vi894s3","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：活血，润燥，止痛，散肿，通经。"}]},{"ID":"20240614094612-8e96cr4","Type":"NodeParagraph","Properties":{"id":"20240614094612-8e96cr4","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"5.《本草正》：达痘疮血热难出，散斑疹血滞不消。"}]},{"ID":"20240614094612-hs9u9cv","Type":"NodeParagraph","Properties":{"id":"20240614094612-hs9u9cv","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"6.《本草再新》：利水消肿，安生胎，堕死胎。"}]},{"ID":"20240614094612-lcmad3h","Type":"NodeParagraph","Properties":{"id":"20240614094612-lcmad3h","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"7.《本草衍义补遗》：红花，破留血，养血。多用则破血，少用则养血。"}]},{"ID":"20240614094612-ul69c4j","Type":"NodeParagraph","Properties":{"id":"20240614094612-ul69c4j","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"8.《本草经疏》：红蓝花，乃行血之要药。其主产后血晕口噤者，缘恶血不下，逆上冲心，故神昏而晕及口噤，入心入肝，使恶血下行，则晕与口噤自止。腹内绞痛，由于恶血不尽，胎死腹中，非行血活血则不下；瘀行则血活，故能止绞痛，下死胎也。红蓝花本行血之药也，血晕解、留滞行，即止，过用能使血行不止而毙。"}]},{"ID":"20240614094612-09k464n","Type":"NodeParagraph","Properties":{"id":"20240614094612-09k464n","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"9.《本草汇言》：红花，破血、行血、和血、调血之药也。主胎产百病因血为患，或血烦血晕，神昏不语；或恶露抢心，脐腹绞痛；或沥浆难生，；或胞衣不落，子死腹中，是皆临产诸证，非红花不能治。若产后血晕、口噤指搦；或邪入血室，谵语发狂；或血闷内胀，僵仆如死，是皆产后诸证，非红花不能定。凡如经闭不通而寒热交作，或过期腹痛而紫黑淋漓，或跌扑损伤而气血瘀积，或疮疡痛痒而肿溃不安，是皆气血不和之证，非红花不能调。"}]},{"ID":"20240614094612-dmhgivw","Type":"NodeParagraph","Properties":{"id":"20240614094612-dmhgivw","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"10.《药品化义》：红花，善通利经脉，为血中气药，能泻而又能补，各有妙义。若多用三、四钱，则过于辛温，使血走散。同苏木逐瘀血，合肉桂通经闭，佐归、芍治遍身或胸腹血气刺痛，此其行导而活血也。若少用七、八分，以疏肝气，以助血海，大补血虚，此其调畅而和血也；若止用二、三分，入心以配心血，解散心经邪火，令血调和，此其滋养而生血也；分量多寡之义，岂浅鲜哉。"}]},{"ID":"20240614094612-29o3p0k","Type":"NodeParagraph","Properties":{"id":"20240614094612-29o3p0k","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614094612-tv1u980","Type":"NodeParagraph","Properties":{"id":"20240614094612-tv1u980","updated":"20240614094612"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614094614-wjcnubp","Type":"NodeThematicBreak","Properties":{"id":"20240614094614-wjcnubp"}},{"ID":"20240614094615-lmlumbz","Type":"NodeParagraph","Properties":{"id":"20240614094615-lmlumbz"}}]}