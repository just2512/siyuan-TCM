NodeImage","Data":"span","Properties":{"parent-style":"width: 642px;","style":"width: 632px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红花-20240828121658-u9thab9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 632px;\" parent-style=\"width: 642px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704090414-d668jca","Type":"NodeParagraph","Properties":{"id":"20240704090414-d668jca","updated":"20240828121729"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 487px;","style":"width: 477px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红花-20240717175410-2p7717v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 477px;\" parent-style=\"width: 487px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 778px;","style":"width: 768px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川红花4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川红花4-20240704085715-8w6xvgp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 768px;\" parent-style=\"width: 778px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704085142-qdq88pn","Type":"NodeParagraph","Properties":{"id":"20240704085142-qdq88pn"},"Children":[{"Type":"NodeText","Data":"​"}]},{"ID":"20240206112948-62k082v","Type":"NodeParagraph","Properties":{"id":"20240206112948-62k082v","updated":"20240206112953"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藏红花（西红花）"}]},{"ID":"20240206113119-lhifh7w","Type":"NodeParagraph","Properties":{"id":"20240206113119-lhifh7w","updated":"20240206113122"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于欧洲南部至伊朗。浙江、江西、江苏、北京、上海有少量栽培。\n【性状】\t本品呈线形，三分枝，长约3cm暗红色，上部较宽而略扁平，顶端边缘显不整齐的街状，内侧有一短裂隙，下端有时残留一小段黄色花柱。体轻，质松软。无油润光泽，干燥后质脆易断。气特异，微有刺激性，味微苦。\n【性味】\t甘，平。\n【功效】\t活血化瘀，凉血解毒，解郁安神。用于经闭症瘕、产后瘀阻、温毒发斑、忧郁痞闷、惊悸发狂。"}]},{"ID":"20240206113013-4vjduxp","Type":"NodeParagraph","Properties":{"id":"20240206113013-4vjduxp","updated":"20240828121731"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206113013-bvd5h25.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704091148-tv724nt","Type":"NodeParagraph","Properties":{"id":"20240704091148-tv724nt","updated":"20240828121732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704091148-pin9as2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828121830-xavjtr5","Type":"NodeParagraph","Properties":{"id":"20240828121830-xavjtr5","updated":"20240828121917"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏红花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藏红花-20240828121830-kjlz2ga.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 656px;","style":"width: 646px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藏