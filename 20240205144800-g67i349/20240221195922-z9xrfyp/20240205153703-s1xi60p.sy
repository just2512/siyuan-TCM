{"ID":"20240205153703-s1xi60p","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153703-s1xi60p","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153703-s1xi60p\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240704084830-mnwit5d\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240704084930-bu24syw\u0026quot;,\u0026quot;scrollTop\u0026quot;:6500,\u0026quot;focusId\u0026quot;:\u0026quot;20240704090936-v0t00nt\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"360补03红花","type":"doc","updated":"20240828122419"},"Children":[{"ID":"20240704084830-mnwit5d","Type":"NodeParagraph","Properties":{"id":"20240704084830-mnwit5d","updated":"20240704084833"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川红花"}]},{"ID":"20240206112116-40raaas","Type":"NodeParagraph","Properties":{"id":"20240206112116-40raaas","updated":"20240206112126"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于河南、湖北、四川、云南、浙江等地。\n【性状】\t本品为不带子房的管状花，表面红黄色或红色，花冠筒细长，先端5裂，裂片呈狭条形，雄蕊5，花药聚合成筒状，黄白色；柱头长圆柱形，顶端微分叉。质柔软。气微香，味微苦。\n【性味】\t辛，温。\n【功效】\t活血通经，散瘀止痛，用于闭经，痛经，恶露不行，症瘕痞块，胸痹心痛，痴滞腹痛，胸胁刺痛，跌扑损伤，疮疡肿痛。"}]},{"ID":"20240206112117-2kay0la","Type":"NodeParagraph","Properties":{"id":"20240206112117-2kay0la","updated":"20240206112117"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206112116-elnt3fm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205162949-j27nk7k","Type":"NodeParagraph","Properties":{"id":"20240205162949-j27nk7k","updated":"20240717175612"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红花-20240205162949-1t4nnst.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717180230-0j9ar8a","Type":"NodeParagraph","Properties":{"id":"20240717180230-0j9ar8a","updated":"20240717180230"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 706px;","style":"width: 696px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红花果实"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红花果实-20240717175612-7owtkja.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 696px;\" parent-style=\"width: 706px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717180232-2tcmach","Type":"NodeParagraph","Properties":{"id":"20240717180232-2tcmach","updated":"20240717180240"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（上图是川红花的种子）"}]},{"ID":"20240828121715-um1vxu7","Type":"NodeParagraph","Properties":{"id":"20240828121715-um1vxu7","updated":"20240828121715"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 415px;","style":"width: 405px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川红花7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川红花7-20240704090332-aqrfgf7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 405px;\" parent-style=\"width: 415px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 615px;","style":"width: 605px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":