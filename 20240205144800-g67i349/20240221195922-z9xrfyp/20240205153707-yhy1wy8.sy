AL","Data":"{: style=\"width: 240px;\" parent-style=\"width: 250px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 147px;","style":"width: 137px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 11-20240802082847-0ew5uxg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 137px;\" parent-style=\"width: 147px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240802082656-0e7jtcd","Type":"NodeParagraph","Properties":{"id":"20240802082656-0e7jtcd","updated":"20240802083222"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 413px;","style":"width: 403px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 13-20240802083211-1fxvdg0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 403px;\" parent-style=\"width: 413px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 312px;","style":"width: 302px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 2-20240801162911-vptii0v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 302px;\" parent-style=\"width: 312px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 548px;","style":"width: 538px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 4-20240802081717-vebq0ri.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 538px;\" parent-style=\"width: 548px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240802082043-tj2j5yh","Type":"NodeParagraph","Properties":{"id":"20240802082043-tj2j5yh","updated":"20240802083143"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 637px;","style":"width: 627px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 6-20240802082042-mbrrj8i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 627px;\" parent-style=\"width: 637px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 641px;","style":"width: 631px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 5-20240802081758-yq3542e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 631px;\" parent-style=\"width: 641px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801162911-4yt0524","Type":"NodeParagraph","Properties":{"id":"20240801162911-4yt0524","updated":"20240802082612"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 476px;","style":"width: 466px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛膝"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛膝-20240717171357-lef3i24.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 466px;\" parent-style=\"width: 476px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 424px;","style":"width: 414px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝 9-20240802082612-2b24pax.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 414px;\" parent-style=\"width: 424px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240802082802-1729os1","Type":"NodeParagraph","Properties":{"id":"20240802082802-1729os1","updated":"20240802082856"}},{"ID":"20240801161849-pvztm07","Type":"NodeParagraph","Properties":{"id":"20240801161849-pvztm07","updated":"20240801161905"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"怀牛膝、川牛膝、土牛膝"}]},{"ID":"20240801162135-9d3fi93","Type":"NodeParagraph","Properties":{"id":"20240801162135-9d3fi93","updated":"20240801162342"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"怀牛膝 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/怀牛膝 8-20240801162135-mt6nvqd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 191px;","style":"width: 181px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土牛膝"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土牛膝-20240801162250-7w9ienj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 181px;\" parent-style=\"width: 191px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 233px;","style":"width: 223px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川牛膝"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川牛膝-20240801162342-idygfuw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 223px;\" parent-style=\"width: 233px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801161906-ttdmg5r","Type":"NodeParagraph","Properties":{"id":"20240801161906-ttdmg5r","updated":"20240801162052"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（从左往右分别为怀牛膝、土牛膝、川牛膝）"}]},{"ID":"20240801161630-vw9xk4o","Type":"NodeParagraph","Properties":{"id":"20240801161630-vw9xk4o","updated":"20240801162228"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：怀牛膝、川牛膝、土牛膝区别方法——怀牛膝穗状花序顶生或腋生，长为3-5厘米；土牛膝穗状花序顶生，直立，长10-30厘米；川牛膝花序为密集圆头状；"}]},{"ID":"20240801162410-ho3vzck","Type":"NodeParagraph","Properties":{"id":"20240801162410-ho3vzck","updated":"20240801162606"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：怀牛膝重在补益肝肾强筋骨，川牛膝重在逐瘀通经利关节，土牛膝擅长清热利咽；"}]},{"ID":"20240616085707-cszkko3","Type":"NodeThematicBreak","Properties":{"id":"20240616085707-cszkko3"}},{"ID":"20240616085708-c9c8ids","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085708-c9c8ids","updated":"20240616085712"},"Children":[{"Type":"NodeText","Data":"牛膝《神农本草经》"}]},{"ID":"20240616085708-yzf6trs","Type":"NodeParagraph","Properties":{"id":"20240616085708-yzf6trs","updated":"20240616085708"},"Children":[{"Type":"NodeText","Data":"味苦酸（《御览》作辛）。"}]},{"ID":"20240616085708-j23a92v","Type":"NodeParagraph","Properties":{"id":"20240616085708-j23a92v","updated":"20240616085708"},"Children":[{"Type":"NodeText","Data":"主寒（《御览》作伤寒），湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气伤，热，火烂，堕胎。久服轻身耐老（《御览》作能老）。"}]},{"ID":"20240616085708-ii5lsyy","Type":"NodeParagraph","Properties":{"id":"20240616085708-ii5lsyy","updated":"20240616085708"},"Children":[{"Type":"NodeText","Data":"一名百倍，生川谷。"}]},{"ID":"20240616085708-2kofirr","Type":"NodeParagraph","Properties":{"id":"20240616085708-2kofirr","updated":"20240616085708"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：牛膝，神农甘，一经酸，黄帝扁鹊甘，李氏温，雷公酸无毒，生河内，或临邛，叶如夏蓝，茎，本赤，二月八月采（《御览》）。"}]},{"ID":"20240616085708-d9wabl4","Type":"NodeParagraph","Properties":{"id":"20240616085708-d9wabl4","updated":"20240616085708"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生河内及临朐，二月八月十月，采根，阴干。"}]},{"ID":"20240616085708-nt70fah","Type":"NodeParagraph","Properties":{"id":"20240616085708-nt70fah","updated":"20240616085818"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：牛茎牛膝也；陶宏景云：其茎有节似膝，故以为名也，膝当为膝。"}]},{"ID":"20240616090005-xovxc1x","Type":"NodeThematicBreak","Properties":{"id":"20240616090005-xovxc1x"}},{"ID":"20240616090012-kpiw6xc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090012-kpiw6xc","updated":"20240616090015"},"Children":[{"Type":"NodeText","Data":"牛膝《本草衍义》"}]},{"ID":"20240616090012-ir8twng","Type":"NodeParagraph","Properties":{"id":"20240616090012-ir8twng","updated":"20240616090012"},"Children":[{"Type":"NodeText","Data":"今西京作畦种，有长三尺者最佳。与苁蓉浸酒服，益肾。竹木刺入肉，嚼烂罨之，即出。"}]},{"ID":"20240616085842-816njn2","Type":"NodeThematicBreak","Properties":{"id":"20240616085842-816njn2"}},{"ID":"20240616085842-oqealoe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085842-oqealoe","updated":"20240616085846"},"Children":[{"Type":"NodeText","Data":"牛膝《本草新编》"}]},{"ID":"20240616085842-4r4kyhx","Type":"NodeParagraph","Properties":{"id":"20240616085842-4r4kyhx","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"牛膝，味甘酸，气平，无毒。蜀产者佳。善走十二经络，宽筋骨，补中绝续，益阴壮阳，除腰膝酸疼，最能通尿管涩痛，引诸药下走。近人多用此药以治血症血瘕，绝无一效，亦未取其功用而一思之也。夫血症血瘕，乃脾经之病。牛膝能走于经络之中，而不能走于肠腹之内。况症瘕之结痰包血也。牛膝乃阴分之药，总能逐血而不能逐痰，此所以终岁而无效耳。至于血晕血虚，儿枕作痛，尤不宜轻用，而近人用之，往往变生不测，亦未悟用牛膝之误也。"}]},{"ID":"20240616085842-c8256ky","Type":"NodeParagraph","Properties":{"id":"20240616085842-c8256ky","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"牛膝善走而不善守，产晕，血虚之极也，无血以养心，所以生晕。不用归芎以补血，反用牛膝以走血，不更下之石乎。虽儿枕作痛，似乎有瘀血在腹，然而产后气血大亏，多有阴寒之变，万一不是瘀血，而亦疑是儿枕之作痛，妄用牛膝以逐瘀，去生远矣。故必手按之而痛甚者，始可少用牛膝于归芎之内。否则勿轻用耳。"}]},{"ID":"20240616085842-pnvgf48","Type":"NodeParagraph","Properties":{"id":"20240616085842-pnvgf48","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"或问牛膝最善堕胎，是非补剂，似产前均宜忌之。然前人间用于产前，而胎安然不损者何耶？夫牛膝岂堕胎药哉，乃补损药也。凡有断续者，尚可再接，岂未损者而反使之堕乎。古人有用牛膝，合之麝香之中，外治以堕胎，取其性走之意。然而堕胎实麝香之故，而非牛膝也。从未闻用牛膝内治而能堕胎者，但性既善走，在胎产亦不宜多用，而终不可谓牛膝是堕胎之物也。"}]},{"ID":"20240616085842-3y29wjm","Type":"NodeParagraph","Properties":{"id":"20240616085842-3y29wjm","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"或问牛膝乃下部之药，用之以补两膝，往往未见功效，岂牛膝非健步之药乎。夫牛膝治下部，前人言之未可尽非，但膝之坚实，非牛膝之可能独健也。膝之所以健者，由于骨中之髓满，髓空斯足弱矣。故欲膝之健者，必须补髓，然而髓之所以满者，又由于肾水之足，肾水不足，则骨中之髓何由满。故欲补骨中之髓者，又须补肾中之精也。虽牛膝亦补精之味，而终不能大补其精，则单用牛膝以治肾虚之膝，又何易奏效哉。"}]},{"ID":"20240616085842-sllx9ih","Type":"NodeParagraph","Properties":{"id":"20240616085842-sllx9ih","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"或问牛膝健足之药，近人见下部之病辄用之，而取效甚少，得毋止可健膝而不可健足耶？"}]},{"ID":"20240616085842-7fjxfvu","Type":"NodeParagraph","Properties":{"id":"20240616085842-7fjxfvu","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"不知健膝即所以健足，而健膝不可徒健夫膝也。凡足之所以能步者，气充之也。不补气以运足，而徒用牛膝以健膝，膝且不能健，又何以健足哉。（〔批〕健足由于健膝，膝健由于气充，至论也。）"}]},{"ID":"20240616085842-2ajkkgs","Type":"NodeParagraph","Properties":{"id":"20240616085842-2ajkkgs","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"或疑牛膝血分之药，入气分药中转易成功，其故何也？盖牛膝性善走，气亦善走，两相合则气无止遏，而血无凝滞，自然血易生而气易旺，又安有不成功者哉。"}]},{"ID":"20240616085842-q0poeqv","Type":"NodeParagraph","Properties":{"id":"20240616085842-q0poeqv","updated":"20240616085842"},"Children":[{"Type":"NodeText","Data":"或疑牛膝乃补中续绝之圣药，何子反略而不谈？曰∶牛膝补中续绝，前人已言之矣，何必再论。惟是补中续绝，实别有说。盖牛膝走而不守，能行血于断续之间，而不能补血于断续之内，必须用牛膝于补气补血之中，而后能收其续绝之效。此补中续绝之义，实前人所未及也。"}]},{"ID":"20240616085854-ramzsr0","Type":"NodeThematicBreak","Properties":{"id":"20240616085854-ramzsr0"}},{"ID":"20240616085856-e6unrwo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085856-e6unrwo","updated":"20240616085905"},"Children":[{"Type":"NodeText","Data":"牛膝《证类本草》"}]},{"ID":"20240616085856-5few6lc","Type":"NodeParagraph","Properties":{"id":"20240616085856-5few6lc","updated":"20240616085856"},"Children":[{"Type":"NodeText","Data":"味苦、酸，平，无毒。主寒湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气，伤热火烂，堕胎，疗伤中少气，男子阴消，老人失溺，补中续绝，填骨髓，除脑中痛及腰脊痛，妇人月水不通，血结，益精，利阴气，止发白。久服轻身耐老。一名百倍。生河内川谷及临朐。二月、八月、十月采根，阴干。（恶萤火、陆英、龟甲，畏白前。）"}]},{"ID":"20240616085856-8nnszxh","Type":"NodeParagraph","Properties":{"id":"20240616085856-8nnszxh","updated":"20240616085856"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出近道蔡州者最长大，柔润，其茎有节似牛膝，故以为名也。乃云有雌雄，雄KT烂黑黯。其十月以后至正月，乃可阴干。臣禹锡等谨按药性论云∶牛膝，臣，忌牛肉。能治阴痿，补肾填精，逐恶血流结，助十二经脉。病患虚羸，加而用之。日华子云∶牛膝，治腰膝软怯冷弱，被症结，排脓止痛，产后心腹痛并血晕，落死胎，壮阳。怀州者长白，近道苏州者色紫。"}]},{"ID":"20240616085856-tuymjsy","Type":"NodeParagraph","Properties":{"id":"20240616085856-tuymjsy","updated":"20240616085856"},"Children":[{"Type":"NodeText","Data":"图经曰∶牛膝，生河内川谷及临朐，今江、淮、闽、粤、关中亦有之，然不及怀州者为真。"}]},{"ID":"20240616085856-iqad62l","Type":"NodeParagraph","Properties":{"id":"20240616085856-iqad62l","updated":"20240616085856"},"Children":[{"Type":"NodeText","Data":"生苗，茎高二、三尺，青紫色，有节如鹤膝，又如牛膝状，以此名之。叶尖圆如匙，两两相对。于节上生花作穗，秋结实甚细。此有二种∶茎紫节大者为雄。青细者为雌。二月、八月、十月采根，阴干。根极长大而柔润者佳。茎叶亦可单用。葛洪治老疟久不断者，取茎叶一把，切，以酒三升渍服，令微有酒气，不即断，更作，不过三剂止。唐·崔元亮《海上方》治疟用水煮牛膝根，未发前服。今福州人单用土牛膝根，净洗，切，焙干，捣，下筛，酒煎，温服，云治妇人血块极效。"}]},{"ID":"20240616085856-u0dwtx7","Type":"NodeParagraph","Properties":{"id":"20240616085856-u0dwtx7","updated":"20240616085856"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，去头并尘土了，用黄精自然汁浸一宿，漉出，细锉，焙干用之。圣惠方∶治眼卒生珠管。牛膝并叶捣绞取汁，日三、四度点之。又方∶治气湿痹腰膝痛。用牛膝叶一斤切，以米三合，于豉汁中相和，煮作粥，和盐、酱，空腹食之。外台秘要∶治劳疟积久不断者。长生牛膝一握，切，以水六升，煮取二升，分二服，未发前服，临发又一服。千金方∶治妇人小户嫁痛。牛膝五两，酒三升，煮取一升半，去滓，分作三服。又方∶治风瘙瘾疹。牛膝末，酒服方寸匕，日三。并主骨疽癞病及 。肘后方∶口中及舌上生疮烂。取牛膝酒渍，含渐之，无酒者，空含亦佳。又方∶治卒暴症，腹中有如石刺，昼夜啼呼。牛膝二斤，以酒一斗渍，密封，热灰火中温令味出。服五合至一升，量力服之。又方∶治齿痛，牛膝末着齿间含之。又方∶凡痢下应先白后赤，若先赤后白为肠蛊。牛膝三两捣碎，以酒一升渍，经一宿。每服饮一、两杯，日三服。又方∶治小便不利，茎中痛欲死，兼治妇人血结腹坚痛。牛膝一大把并叶，不以多少，酒煮饮之，立愈。经验后方∶治消渴不止，下元虚损。牛膝五两，细锉为末，生地黄汁五升浸，昼曝夜浸，汗尽为度，蜜丸梧桐子大，空心温酒下三十丸。久服壮筋骨，驻颜色，黑发，津液自完。梅师方∶治竹木针在肉中不出。取生牛膝茎捣末，涂之即出。又方∶治胞衣不出。牛膝八两，葵子一两。以水九升，煎取三升，分三服。又方∶治金疮痛所。生牛膝捣敷疮上，立瘥。孙真人食忌治牙齿疼痛，烧牛膝根灰致牙齿间。又方∶治卒得恶疮，人不识者。以牛膝根捣敷之。"}]},{"ID":"20240616085856-14cvveg","Type":"NodeParagraph","Properties":{"id":"20240616085856-14cvveg","updated":"20240616090002"},"Children":[{"Type":"NodeText","Data":"衍义曰∶牛膝，今西京作畦种，有长三尺者最佳。与苁蓉酒浸服，益肾。竹木刺入肉，嚼烂罨之，即出。"}]},{"ID":"20240616090036-nqw52qx","Type":"NodeThematicBreak","Properties":{"id":"20240616090036-nqw52qx"}},{"ID":"20240616090037-f7a4vla","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616090037-f7a4vla","updated":"20240616090042"},"Children":[{"Type":"NodeText","Data":"牛膝《冯氏锦囊秘录》"}]},{"ID":"20240616090037-3b1zrq9","Type":"NodeParagraph","Properties":{"id":"20240616090037-3b1zrq9","updated":"20240616090037"},"Children":[{"Type":"NodeText","Data":"禀地中阳气以生，气则兼乎水火之用，故其味苦酸平，无毒。味浓气薄，走而能补，性善下行，专入肝肾，宜长大肥润者，去芦。若入引火下趋药中，宜生用。若入补药中，宜洒拌蒸晒干用。"}]},{"ID":"20240616090037-vw12twz","Type":"NodeParagraph","Properties":{"id":"20240616090037-vw12twz","updated":"20240616090037"},"Children":[{"Type":"NodeText","Data":"牛膝，理一身虚羸，助十二经脉，壮筋骨，利腰膝。足痿筋挛，阴痿失尿；散恶血而治心腹诸痛；催难产而理膏血诸淋，痈肿恶疮，金疮伤折，手足寒湿痿痹，大筋拘挛；膀胱气化便难，小水短少；补中续绝，益阴壮阳填髓，除腰膝酸痛。单煎治老疟弗愈，女人血 血瘕，月水行迟；产妇血晕，血虚，儿枕痛甚。同麝纳阴户，使胎即堕；梦遗若误用，其病益增；引诸药下走如奔。凡病在腰腿下部所必用，走而能补，强阴益精，肝肾之要药，且能引火下趋，降浊澄清，故浊阴不降，脑中作痛，喉痹齿痛，虚火上浮，咳嗽不宁者并宜。若嚼烂罨之，能出木竹诸刺。然性能降而不能升，惟元气下陷，血崩遗滑诸症，法当禁绝。"}]},{"ID":"20240616090037-8wk90qx","Type":"NodeParagraph","Properties":{"id":"20240616090037-8wk90qx","updated":"20240616090037"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 主四肢拘挛，屈伸不便，活血生血，引药下行。且杜仲主下部气分，牛膝主下部血分。故每相需为用。"}]},{"ID":"20240616090037-vzss4pw","Type":"NodeParagraph","Properties":{"id":"20240616090037-vzss4pw","updated":"20240616090037"},"Children":[{"Type":"NodeText","Data":"按∶牛膝性专走下而滑窍，故梦遗精滑，脾虚下陷禁之。"}]},{"ID":"20240616085829-s4fm0l7","Type":"NodeThematicBreak","Properties":{"id":"20240616085829-s4fm0l7"}},{"ID":"20240616085831-vzy0umj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085831-vzy0umj","updated":"20240616085835"},"Children":[{"Type":"NodeText","Data":"牛膝《神农本草经百种录》"}]},{"ID":"20240616085831-l8wct87","Type":"NodeParagraph","Properties":{"id":"20240616085831-l8wct87","updated":"20240616085831"},"Children":[{"Type":"NodeText","Data":"味苦酸。此止言味而不言性，疑阙文也。后凡不言性者仿此。主寒湿痿痹，四肢拘挛，膝痛不可屈伸，皆舒筋行血之功。逐血气，破瘀血也。伤热火烂，清热也。堕胎。降血气也。久服，轻身耐老。血和之功。"}]},{"ID":"20240616085831-bmglk1p","Type":"NodeParagraph","Properties":{"id":"20240616085831-bmglk1p","updated":"20240616085831"},"Children":[{"Type":"NodeText","Data":"此乃以其形而知其性也。凡物之根皆横生，而牛膝独直下，其长细而韧，酷似人筋，所以能舒筋通脉，下血降气，为诸下达药之先导也。筋属肝，肝藏血，凡能舒筋之药，俱能治血，故又为通利血脉之品。"}]},{"ID":"20240616085818-1hbl2z4","Type":"NodeThematicBreak","Properties":{"id":"20240616085818-1hbl2z4"}},{"ID":"20240616085820-pyvwi5x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085820-pyvwi5x","updated":"20240616085823"},"Children":[{"Type":"NodeText","Data":"牛膝《本草分经》"}]},{"ID":"20240616085820-1dx83z1","Type":"NodeParagraph","Properties":{"id":"20240616085820-1dx83z1","updated":"20240616085820"},"Children":[{"Type":"NodeText","Data":"苦酸平，入肝肾，能引诸药下行，散恶血，疗心腹痛，治淋堕胎，出竹木刺，酒浸蒸则甘酸而温，益肝肾强筋骨。"}]},{"ID":"20240616085806-lj7hwtg","Type":"NodeThematicBreak","Properties":{"id":"20240616085806-lj7hwtg"}},{"ID":"20240616085807-lq88jp8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085807-lq88jp8","updated":"20240616085813"},"Children":[{"Type":"NodeText","Data":"牛膝《本草述钩元》"}]},{"ID":"20240616085807-w06cqty","Type":"NodeParagraph","Properties":{"id":"20240616085807-w06cqty","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"根直下生。其茎有节。似牛膝。故名。又称暴节。二八十月采根。阴干用。根长约三二尺者良。江淮闽粤关中皆有。不及怀庆生者。根极长大而柔润也。土牛膝处处有之。"}]},{"ID":"20240616085807-lo8lu38","Type":"NodeParagraph","Properties":{"id":"20240616085807-lo8lu38","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"不堪服食。惟北土及川中人家栽莳者为良。土牛膝所禀薄。故短而细。主破血气。（士材）春夏用叶。秋冬用根。惟叶汁效尤速。（叶皆对生。似苋而长。且尖梢。）川牛膝所禀浓。"}]},{"ID":"20240616085807-zgxxcdv","Type":"NodeParagraph","Properties":{"id":"20240616085807-zgxxcdv","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"故肥而长。主补精髓。（士材）味苦酸平。气薄味浓。走而能补。性善下行。入足厥阴少阴经。生者去恶血。得酒能补肝心溪言妇人得之。应归血海行血。）酒蒸熟用。更主寒湿痿痹。四肢拘挛。膝痛不可屈伸。"}]},{"ID":"20240616085807-redflgi","Type":"NodeParagraph","Properties":{"id":"20240616085807-redflgi","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"益肾强筋。理腰膝软怯冷弱。及腰脊痛。利阴气。补精气。疗伤中少气。男子阴消。老人失溺少干用。"}]},{"ID":"20240616085807-erdrbui","Type":"NodeParagraph","Properties":{"id":"20240616085807-erdrbui","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"术仙茅瓜首乌生地四肢拘挛。"}]},{"ID":"20240616085807-jmkqgiy","Type":"NodeParagraph","Properties":{"id":"20240616085807-jmkqgiy","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"地黄柏五加皮二三两浓橘皮去茎中痛腹坚痛。小便淋痛。或尿血膝亦可。或入麝香乳香尤良。"}]},{"ID":"20240616085807-e57ikzr","Type":"NodeParagraph","Properties":{"id":"20240616085807-e57ikzr","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"附专用土牛膝方喉痹乳蛾。鲜牛膝根一握。艾叶七片捣和人乳。取汁灌入鼻内。须臾痰涎二两温服〔论〕牛膝味苦。苦就下。入于至阴之肾无疑。苦后有酸。而气复温。是又阴中少阳之肝火。"}]},{"ID":"20240616085807-zjzrneq","Type":"NodeParagraph","Properties":{"id":"20240616085807-zjzrneq","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"哉。"}]},{"ID":"20240616085807-b3unvct","Type":"NodeParagraph","Properties":{"id":"20240616085807-b3unvct","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"肾肝于金之诚不妄故直藉何居。"}]},{"ID":"20240616085807-c98qlrr","Type":"NodeParagraph","Properties":{"id":"20240616085807-c98qlrr","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"浮气曰卫其气之精气着以为肠则痢。"}]},{"ID":"20240616085807-g5gma85","Type":"NodeParagraph","Properties":{"id":"20240616085807-g5gma85","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"金水于下。"}]},{"ID":"20240616085807-lqjbmav","Type":"NodeParagraph","Properties":{"id":"20240616085807-lqjbmav","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"又如五及之。"}]},{"ID":"20240616085807-35968jt","Type":"NodeParagraph","Properties":{"id":"20240616085807-35968jt","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"能化。"}]},{"ID":"20240616085807-uksueie","Type":"NodeParagraph","Properties":{"id":"20240616085807-uksueie","updated":"20240616085807"},"Children":[{"Type":"NodeText","Data":"主治之足。乃水以顺之气不缪氏上焦药中勿入。凡经闭未久疑似有娠者。勿用。脾虚清气下陷而泄痢。及脾虚而腿痛〔修治〕行血。生用。入滋补药。酒拌。蒸过用。"}]},{"ID":"20240616085750-4x5bg05","Type":"NodeThematicBreak","Properties":{"id":"20240616085750-4x5bg05"}},{"ID":"20240616085751-mndro47","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085751-mndro47","updated":"20240616085756"},"Children":[{"Type":"NodeText","Data":"牛膝《本经逢原》"}]},{"ID":"20240616085751-kzbr6y8","Type":"NodeParagraph","Properties":{"id":"20240616085751-kzbr6y8","updated":"20240616085751"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名百倍"}]},{"ID":"20240616085751-0dy8n6l","Type":"NodeParagraph","Properties":{"id":"20240616085751-0dy8n6l","updated":"20240616085751"},"Children":[{"Type":"NodeText","Data":"苦酸平，无毒。怀产者长而无傍须，水道涩渗者宜之。川产者细而微黑，精气不固者宜之。忌牛肉。"}]},{"ID":"20240616085751-a4ril6j","Type":"NodeParagraph","Properties":{"id":"20240616085751-a4ril6j","updated":"20240616085751"},"Children":[{"Type":"NodeText","Data":"《本经》主寒湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气，伤热火烂，坠胎。"}]},{"ID":"20240616085751-gdvt0lc","Type":"NodeParagraph","Properties":{"id":"20240616085751-gdvt0lc","updated":"20240616085751"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"牛膝气薄味浓，性沉降泄，乃足厥阴之药。《本经》专主寒湿痿痹，四肢拘挛等病，不及补养下元之功，岂圣法有所未尽欤。丹溪言∶牛膝能引诸药下行，筋骨痛风在下者宜加用之，其性虽下行走筋，然滑利之品，精气不固者，终非所宜。得酒蒸则能养筋，生用则去恶血。其治腰膝痛不可屈伸足痿之病，非取其养血营筋之力欤。其治痈肿恶疮、金疮折伤、尿血淋痛、妇人经秘不通，非取其活血破瘀之力欤。《外台》以生牛膝一味浓煎，治积久劳疟。《肘后》以二斤浸酒治卒暴症疾，延年。以之同葵子煎服下胞衣。《卫生》以之捣罨折伤。《梅师》以之捣涂金疮。《千金》以之捣敷毒肿。《集验》以之通利溺闭。皆取其性滑利窍，消血解毒之功，虽强阴强筋，而气虚下陷，大便易泄，梦泄遗精，妊娠崩漏，俱禁用。惟川产者，气味形质与续断仿佛，庶无精滑之虞。盖肾司闭藏，肝司疏泄，此味专司疏泄，而无固热之功。世俗妄谓益肾而培养下元药中往往用之，与延盗入室何异。其土牛膝亦能解毒利窍，专治血鼓，一味浓煎，姿意服之。又锁喉风诸治不效，以土牛膝和醋捣绞取汁，蘸鸡翎探吐稠痰，不过二三次神验。"}]},{"ID":"20240616085740-sigu87b","Type":"NodeThematicBreak","Properties":{"id":"20240616085740-sigu87b"}},{"ID":"20240616085741-kzdmwld","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085741-kzdmwld","updated":"20240616085745"},"Children":[{"Type":"NodeText","Data":"牛膝《千金翼方》"}]},{"ID":"20240616085741-qsj15ig","Type":"NodeParagraph","Properties":{"id":"20240616085741-qsj15ig","updated":"20240616085741"},"Children":[{"Type":"NodeText","Data":"为君，味苦酸，平，无毒。主寒湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气，伤烂，堕胎。疗伤中少气，男子阴消，老人失溺，补中续绝，填骨髓，除脑中痛及腰脊痛，妇人月水不通，血结，益精，利阴气，止发白。久服轻身耐老。一名百倍。生河内川谷及临朐，二月八月十月采根，阴干。"}]},{"ID":"20240616085727-y1b7jl2","Type":"NodeThematicBreak","Properties":{"id":"20240616085727-y1b7jl2"}},{"ID":"20240616085727-js1b1nh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085727-js1b1nh","updated":"20240616085736"},"Children":[{"Type":"NodeText","Data":"牛膝《本草简要方》"}]},{"ID":"20240616085727-t7e11k4","Type":"NodeParagraph","Properties":{"id":"20240616085727-t7e11k4","updated":"20240616085727"},"Children":[{"Type":"NodeText","Data":"主治补血。益肾强筋骨去风湿助十二经脉。四肢拘挛。膝痛足痿。妇人经闭。血晕。"}]},{"ID":"20240616085727-itruqnt","Type":"NodeParagraph","Properties":{"id":"20240616085727-itruqnt","updated":"20240616085727"},"Children":[{"Type":"NodeText","Data":"难产。金疮痈肿。焙用或酒拌则滋补。生用则下行。牛膝丸。牛膝（酒浸）萆杜仲（炒去丝）白蒺藜防风菟丝子（酒浸）肉苁蓉（酒浸）各等分。官桂减半。研末。酒煮猪腰子捣和为丸。"}]},{"ID":"20240616085727-deqth72","Type":"NodeParagraph","Properties":{"id":"20240616085727-deqth72","updated":"20240616085727"},"Children":[{"Type":"NodeText","Data":"梧子大。每服五七十丸。空腹温酒下。益精暖中。治肝肾虚损。骨痿筋弱。牛膝散。牛膝（酒制）一两。桂心赤芍桃仁玄胡索（炒）当归（酒浸）丹皮木香各七钱五分。研末。每服一钱。"}]},{"ID":"20240616085727-2zaooen","Type":"NodeParagraph","Properties":{"id":"20240616085727-2zaooen","updated":"20240616085727"},"Children":[{"Type":"NodeText","Data":"空腹温酒下。治经水不利。脐腹作痛。或小腹引腰气攻胸胁。牛膝汤。牛膝根茎一握。当归（焙）一两。黄芩五钱。研末。每服五钱。水一盏半。煎至七分。去滓温服。日三次。治小便不通。"}]},{"ID":"20240616085727-yrhmuwa","Type":"NodeParagraph","Properties":{"id":"20240616085727-yrhmuwa","updated":"20240616085727"},"Children":[{"Type":"NodeText","Data":"茎中痛。妇女血结腹坚痛。又方。牛膝八两。葵子一合。水九升。煎三升。分三服。治胎衣不下。按此药通利下部孕妇忌之。"}]},{"ID":"20240616085304-ua141xr","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-ua141xr"}},{"ID":"20240616085534-4kh1i1x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085534-4kh1i1x","updated":"20240616085540"},"Children":[{"Type":"NodeText","Data":"牛膝《名医别录》"}]},{"ID":"20240616085534-fp4fasz","Type":"NodeParagraph","Properties":{"id":"20240616085534-fp4fasz","updated":"20240616085534"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒．主伤中少气，男子阴消，老人失溺，补中续绝，填骨髓，除脑中痛腰脊痛，妇人月水不通，血结，益精，利阴气，止发白．生河内及临朐．二月、八月、十月采根，阴干．（恶萤火、龟甲、陆英，畏白前．）"}]},{"ID":"20240616085534-b9pljk1","Type":"NodeParagraph","Properties":{"id":"20240616085534-b9pljk1","updated":"20240616085722"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶牛膝，味苦．主寒湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气，伤热火烂，堕胎．久服轻身耐老。"}]},{"ID":"20240616085635-mpi3mde","Type":"NodeThematicBreak","Properties":{"id":"20240616085635-mpi3mde"}},{"ID":"20240616085636-uyo1mjz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085636-uyo1mjz","updated":"20240616085640"},"Children":[{"Type":"NodeText","Data":"牛膝《本草备要》"}]},{"ID":"20240616085636-xn2fe00","Type":"NodeParagraph","Properties":{"id":"20240616085636-xn2fe00","updated":"20240616085636"},"Children":[{"Type":"NodeText","Data":"补肝肾，泻恶血"}]},{"ID":"20240616085636-qpbaqiu","Type":"NodeParagraph","Properties":{"id":"20240616085636-qpbaqiu","updated":"20240616085636"},"Children":[{"Type":"NodeText","Data":"苦酸而平。足厥阴、少阴经药（肝肾），能引诸药下行。酒蒸则甘酸而温，益肝肾，强筋骨（肝主筋，肾主骨），治腰膝骨痛，足痿筋挛（下行故理足，补肝则筋舒，血行则痛止），阴痿失溺（筋衰则阴痿，肾虚则失溺），久疟下痢，伤中少气（以土皆补肝肾之功）。"}]},{"ID":"20240616085636-4wyys5q","Type":"NodeParagraph","Properties":{"id":"20240616085636-4wyys5q","updated":"20240616085636"},"Children":[{"Type":"NodeText","Data":"生用，则散恶血，破症结（血行则结散），治心腹诸痛，淋痛尿血（热蓄膀胱、便涩而痛曰淋。气淋便涩余沥，劳淋房劳即发，冷淋寒战后溲，膏淋便出如膏，石淋精结成石，尿血即血淋也。鲜色者，心与小肠实热；色瘀者，肾与膀胱虚冷。张子和曰∶石淋乃肝经移热于胞中，日久熬煎成石，非肾与小肠病也。大法治淋宜通气、清心、平火、利湿。不宜用补，恐湿热得补增剧也。牛膝，淋证要药，血淋尤宜用之，杜牛膝亦可。又有中气不足致小便不利者，宜补中益气，经所谓气化则能出是也，忌用淋药通之），经闭产难（下行之效，误用堕胎），喉痹齿痛（引火下行），痈肿恶疮，金疮伤折（以上皆散恶血之功），出竹木刺（捣烂罨之即出；纵疮口合，刺犹自出）。然性下行而滑窍，梦遗失精及脾虚下陷，因而腿膝肿痛者禁用。"}]},{"ID":"20240616085636-kqq2x1l","Type":"NodeParagraph","Properties":{"id":"20240616085636-kqq2x1l","updated":"20240616085636"},"Children":[{"Type":"NodeText","Data":"出西川及怀庆府，长大肥润者良。下行生用，入滋补药酒浸蒸。恶龟甲。畏白前。忌羊肉。"}]},{"ID":"20240616085614-u3n2skj","Type":"NodeThematicBreak","Properties":{"id":"20240616085614-u3n2skj"}},{"ID":"20240616085616-zxwv8h5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085616-zxwv8h5","updated":"20240616085621"},"Children":[{"Type":"NodeText","Data":"牛膝《本草纲目》"}]},{"ID":"20240616085616-qsti83a","Type":"NodeParagraph","Properties":{"id":"20240616085616-qsti83a","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"「释名」亦名牛茎、百倍、山苋菜、对节菜。"}]},{"ID":"20240616085616-frm5t3r","Type":"NodeParagraph","Properties":{"id":"20240616085616-frm5t3r","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、酸、平、无毒。"}]},{"ID":"20240616085616-pyfzu75","Type":"NodeParagraph","Properties":{"id":"20240616085616-pyfzu75","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616085616-lpkomqw","Type":"NodeParagraph","Properties":{"id":"20240616085616-lpkomqw","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"1、劳疟积久。用长牛膝一把，生切，加水六升，煮成二升，分三次服完（清晨一服，未发疟前一服，临发疟时一服。）"}]},{"ID":"20240616085616-spb7pqa","Type":"NodeParagraph","Properties":{"id":"20240616085616-spb7pqa","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"2、消渴不止（下元虚损）。用牛膝五两，研细，浸入生地黄汁五升中。日晒夜浸，直到汁尽。加蜜和丸，如梧子大。每服三十丸，空心服，温酒送下。久服于身体有益。"}]},{"ID":"20240616085616-7by36gb","Type":"NodeParagraph","Properties":{"id":"20240616085616-7by36gb","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"3、妇女血病（月经淋闭，月经不来，绕脐寒疝痛，产后血气不调，腹中结症瘕不散诸病）。用牛膝在酒中浸一夜，取出焙干；另用漆炒令烟尽。各一两为末，加生地黄汁一升，慢火上熬成浓糊，团成丸子，如梧子大。每服三丸，空心服，米汤送下。此方名“万病丸”。"}]},{"ID":"20240616085616-v7hzurf","Type":"NodeParagraph","Properties":{"id":"20240616085616-v7hzurf","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"4、胞衣不下。用牛膝八两、葵子一合，加水九升，煎成三升。分三次服。"}]},{"ID":"20240616085616-1w0xzog","Type":"NodeParagraph","Properties":{"id":"20240616085616-1w0xzog","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"5、产后尿血。用川牛膝水煎常服。"}]},{"ID":"20240616085616-0u4e439","Type":"NodeParagraph","Properties":{"id":"20240616085616-0u4e439","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"6、喉痹乳蛾。用新鲜牛膝根一把、艾叶七片，同人乳捣和，取汗灌入鼻内。不久，痰涎从口鼻流出即愈。不用艾叶亦可。又方：牛膝捣汁和陈醋灌病人。"}]},{"ID":"20240616085616-2a1ory4","Type":"NodeParagraph","Properties":{"id":"20240616085616-2a1ory4","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"7、口舌疮烂。用牛膝浸酒含漱，亦可煎饮。"}]},{"ID":"20240616085616-hsjagmn","Type":"NodeParagraph","Properties":{"id":"20240616085616-hsjagmn","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"8、牙齿疼痛。用牛膝研末含漱，也可以用牛膝烧灰敷患处。"}]},{"ID":"20240616085616-7yz0ndd","Type":"NodeParagraph","Properties":{"id":"20240616085616-7yz0ndd","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"9、恶疮（人不知名）。用牛膝根捣敷。"}]},{"ID":"20240616085616-ykv3fhh","Type":"NodeParagraph","Properties":{"id":"20240616085616-ykv3fhh","updated":"20240616085616"},"Children":[{"Type":"NodeText","Data":"10、痈疖已溃。用牛膝根略刮去皮，插入疮口中，留半寸在外，以嫩橘叶及地锦草各一把，捣烂后涂疮上。"}]},{"ID":"20240616085605-yf0s0ol","Type":"NodeThematicBreak","Properties":{"id":"20240616085605-yf0s0ol"}},{"ID":"20240616085606-swn9yp6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085606-swn9yp6","updated":"20240616085610"},"Children":[{"Type":"NodeText","Data":"牛膝《本草崇原》"}]},{"ID":"20240616085606-y1t23kt","Type":"NodeParagraph","Properties":{"id":"20240616085606-y1t23kt","updated":"20240616085606"},"Children":[{"Type":"NodeText","Data":"气味苦酸平，无毒。主寒湿痿痹、四肢拘挛、膝痛不可屈伸，逐血气伤热火烂，堕胎。久服轻身耐老。"}]},{"ID":"20240616085606-mln78ky","Type":"NodeParagraph","Properties":{"id":"20240616085606-mln78ky","updated":"20240616085606"},"Children":[{"Type":"NodeText","Data":"（牛膝《本经》名百倍。始出河内川谷及临朐，今江淮闽粤关中皆有，然不及怀庆川中者佳。春生苗，枝节两两相对，故又名对节草，其根一本直下，长二三尺，以肥阔粗大者为上。）"}]},{"ID":"20240616085606-csxix8g","Type":"NodeParagraph","Properties":{"id":"20240616085606-csxix8g","updated":"20240616085606"},"Children":[{"Type":"NodeText","Data":"《本经》谓∶百倍气味苦酸，概根苗而言也。今时所用，乃根下之茎，味甘臭酸，其性微寒。《易》曰∶干为马，坤为牛，牛之力在膝，取名牛膝者，禀太阴湿土之气化，而能资养筋骨也。主治寒湿痿痹，言或因于寒，或因于湿，而成痿痹之证也。痿痹则四肢拘挛，四肢拘挛，则膝痛不可屈伸。牛膝禀湿土柔和之化，而资养筋骨，故能治之。血气伤热火烂，言血气为热所伤，则为火烂之证。牛膝味甘性寒，故可逐也。根下之茎，形如大筋，性唯下泄，故堕胎。久服则筋骨强健，故轻身耐老。"}]},{"ID":"20240616085556-dw5ujwt","Type":"NodeThematicBreak","Properties":{"id":"20240616085556-dw5ujwt"}},{"ID":"20240616085557-vidd7i5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085557-vidd7i5","updated":"20240616085601"},"Children":[{"Type":"NodeText","Data":"牛膝《医学入门》"}]},{"ID":"20240616085557-xcu9g7k","Type":"NodeParagraph","Properties":{"id":"20240616085557-xcu9g7k","updated":"20240616085557"},"Children":[{"Type":"NodeText","Data":"牛膝苦酸气亦平，酸痹拘挛疮疹灵，男子精虚脑齿痛，妇人经闭结瘕 。"}]},{"ID":"20240616085557-gfaawzy","Type":"NodeParagraph","Properties":{"id":"20240616085557-gfaawzy","updated":"20240616085557"},"Children":[{"Type":"NodeText","Data":"茎有节似牛之膝。无毒。沉也，阴也。主寒湿痿痹，四肢拘挛疼痛不可屈伸，凡腰腿之疾，必用引下。治恶疮风疹口舌生疮，伤热火烂。又竹木刺入肉，嚼烂罨之即出。皮肤疾亦用之。男子肾虚阴消失溺，多渴，脑痛，发白早，齿常痛，服之填精益髓自愈。妇人经闭，恶血结为 瘕，产后心腹痛血晕。又治男妇小便不利，茎中痛，活血生血剂也。兼止老疟久痢。长大柔润者佳，酒洗用。恶龟甲、白前，忌牛肉。"}]},{"ID":"20240616085545-dw5lc6v","Type":"NodeThematicBreak","Properties":{"id":"20240616085545-dw5lc6v"}},{"ID":"20240616085546-vpqo1ae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085546-vpqo1ae","updated":"20240616085550"},"Children":[{"Type":"NodeText","Data":"牛膝《要药分剂》"}]},{"ID":"20240616085546-2362gsv","Type":"NodeParagraph","Properties":{"id":"20240616085546-2362gsv","updated":"20240616085546"},"Children":[{"Type":"NodeText","Data":"味苦酸。性平。无毒。禀地中阳气。兼乎木火之化以生。降也。阴中阳也。恶龟甲。"}]},{"ID":"20240616085546-nx6274d","Type":"NodeParagraph","Properties":{"id":"20240616085546-nx6274d","updated":"20240616085546"},"Children":[{"Type":"NodeText","Data":"畏白前。忌牛肉乳。"}]},{"ID":"20240616085546-fvr6u6o","Type":"NodeParagraph","Properties":{"id":"20240616085546-fvr6u6o","updated":"20240616085546"},"Children":[{"Type":"NodeText","Data":"【主治】主寒湿痿痹。四肢拘挛。膝痛不可屈伸。逐血气。伤热火烂。堕胎。（本经）疗伤中血【归经】入肝肾二经。为走而能补之品。（兼泻剂能引诸药下行）【前论】丹溪曰。牛膝能引诸药下行。筋骨痛风在下者。宜加用。张子和曰。大法治淋。"}]},{"ID":"20240616085546-0cczdge","Type":"NodeParagraph","Properties":{"id":"20240616085546-0cczdge","updated":"20240616085546"},"Children":[{"Type":"NodeText","Data":"宜牛膝淋酒蒸。益肝肾。强筋骨。治腰膝骨痛。足痿筋挛。阴痿失溺。久疟下痢。伤中少气。皆取其补肝肾之功也。"}]},{"ID":"20240616085546-sqsapxp","Type":"NodeParagraph","Properties":{"id":"20240616085546-sqsapxp","updated":"20240616085546"},"Children":[{"Type":"NodeText","Data":"鳌按、杜牛膝性专下走。毫无补益。肝肾二家虚弱者。不可轻投。"}]},{"ID":"20240616085546-eqjnxdb","Type":"NodeParagraph","Properties":{"id":"20240616085546-eqjnxdb","updated":"20240616085546"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。误用必伤胎。经闭未久。疑似有妊者。忌用。上焦药中勿入。血崩不止。"}]},{"ID":"20240616085304-pqada1a","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-pqada1a"}},{"ID":"20240616085525-mz0mv5d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085525-mz0mv5d","updated":"20240616085528"},"Children":[{"Type":"NodeText","Data":"牛膝《本草蒙筌》"}]},{"ID":"20240616085525-0odkgjz","Type":"NodeParagraph","Properties":{"id":"20240616085525-0odkgjz","updated":"20240616085525"},"Children":[{"Type":"NodeText","Data":"味苦、酸，气平。无毒。忌牛肉，畏白前。所恶之药有三，萤火陆英龟甲。地产尚怀庆，（注前。）种类有雌雄。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雌牛膝"},{"Type":"NodeText","Data":"节细，茎青根短，坚脆无力；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雄牛膝"},{"Type":"NodeText","Data":"节大，茎紫根长，柔润有功。秋后采根，曝干待用。去蚀烂黑黯，选肥壮鲜明。因与牛膝同形，人故假此为誉。凡入药剂，酒渍 咀。善理一身虚羸，能助十二经脉。主手足寒湿痿痹，大筋拘挛；理膀胱气化迟难，小便短少。补中续绝，益阴壮阳。填髓除腰膝酸疼，滑血滋须发乌黑。竹木刺入肉，嚼烂浓罨；老疟久弗痊，单煎连服。卒得不识恶毒，捣生根敷上即差；尿管涩痛几危，煮浓酒饮下立愈。治女人血症血瘕，月水行迟；疗产妇血晕血虚，儿枕痛甚。同麝香堕胎甚捷，（牡牛膝一两、麝香一钱，捣细，熔蜡搓成长条，插阴户内即堕。）引诸药下走如奔。故凡病在腰腿 踝之间，必兼用之而勿缺也。亦宜久服，耐老轻身。"}]},{"ID":"20240616085304-q8sla3d","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-q8sla3d"}},{"ID":"20240616085515-uqij315","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085515-uqij315","updated":"20240616085519"},"Children":[{"Type":"NodeText","Data":"牛膝《本草求真》"}]},{"ID":"20240616085515-xmotmj1","Type":"NodeParagraph","Properties":{"id":"20240616085515-xmotmj1","updated":"20240616085515"},"Children":[{"Type":"NodeText","Data":"（隰草）引入下部经络血分"}]},{"ID":"20240616085515-az7m7us","Type":"NodeParagraph","Properties":{"id":"20240616085515-az7m7us","updated":"20240616085515"},"Children":[{"Type":"NodeText","Data":"牛膝（专入肝肾）。苦酸而平。按据诸书。虽载酒蒸温补肝肾。强健筋骨。凡足痿筋挛。阴痿失溺。久疟下痢。伤中少气。治皆有效。又载生用则能活血。破瘀消肿。治痛通淋。引药下行。（淋属热。至其茎痛不可忍。手按热如火烁。血出鲜红不黯。淋出如砂如石。脐下妨闷。烦燥热渴。六脉沉数有力。淋属虚致。其茎多不见痛。即痛或喜手按。或于溺后才痛。稍久则止。或登厕小便涩痛。大便牵痛。面色痿黄。饮食少思。语言懒怯。六脉虚浮无力。淋属虚实兼致。其茎或见痛极。六脉弦数而按不甚有力。饮食少思而神不见昏倦。溺即滴点不断。而出则无砂石膏血。脉即虚软无力。而血反见鲜润。腹即胀硬不消。而气短结。牛膝虽淋症要药。然亦须审虚实权衡。不可尽以牛膝治也。）然味薄气浓。性沉。炙滑。用于下部经络血分舒气则可。若使肺分气薄遗脱泄泻。则又当知忌戒。不可因其气虚而概用之。（时珍曰。牛膝乃足厥阴少阴所主之病。大抵得酒则能补肝肾。生用则能去恶血。二者而已。其治腰膝骨痛足痿阴消失溺久疟伤中少气诸病。非取其补肝肾之功欤！其治症瘕心腹诸痛痈肿恶疮金疮折伤喉齿淋痛尿血经候胎产诸病。非取其去恶血之功欤！）出于川者性味形质虽与续断相似。服之可无精滑之弊。然肝主司疏泄。肾主闭藏。此则疏泄独具而鲜固蛰。书云益肾。殊觉未是。杜牛膝气味更凉。嚼之味甘而不苦。主治多是解毒破血。泻热吐痰。（如溺闭症见气喘面赤有斑。用杜牛膝浓煎膏饮。下血一桶。小便通而愈。又不省人事。绞汁入好酒。灌之即苏。以醋拌渣敷项下。惊风痰疟。服汁能吐痰涎。喉痹用杜牛膝捣汁。和米醋半盏。用鸡翅毛蘸搅喉中以通其气。）较之川牛膝。微觉有别。牛膝出西川及怀庆府。长大肥润者良。下行生用。入滋补药酒蒸。恶龟甲。畏白前。忌牛肉。"}]},{"ID":"20240616085304-or117qp","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-or117qp"}},{"ID":"20240616085506-c734xbb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085506-c734xbb","updated":"20240616085510"},"Children":[{"Type":"NodeText","Data":"牛膝《玉楸药解》"}]},{"ID":"20240616085506-cb3o8fn","Type":"NodeParagraph","Properties":{"id":"20240616085506-cb3o8fn","updated":"20240616085506"},"Children":[{"Type":"NodeText","Data":"味苦、酸，气平，入足太阳膀胱、足厥阴肝经。利水开淋，破血通经。"}]},{"ID":"20240616085506-ag371ws","Type":"NodeParagraph","Properties":{"id":"20240616085506-ag371ws","updated":"20240616085506"},"Children":[{"Type":"NodeText","Data":"牛膝疏利水道，治小便淋涩疼痛，疗膝胫痿痹拘挛，通女子经脉闭结，起男子宗筋软缩，破坚癥老血，消毒肿恶疮、木器刺伤。捣敷金疮，溃痈排脓。坠胎下衣、喉痹舌疮、扑伤打损、瘾疹风癞皆效。"}]},{"ID":"20240616085506-0480lru","Type":"NodeParagraph","Properties":{"id":"20240616085506-0480lru","updated":"20240616085506"},"Children":[{"Type":"NodeText","Data":"其性下行，肝脾郁陷者勿用。"}]},{"ID":"20240616085304-f1ekjn5","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-f1ekjn5"}},{"ID":"20240616085454-ek2dvbm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085454-ek2dvbm","updated":"20240616085501"},"Children":[{"Type":"NodeText","Data":"牛膝《新修本草》"}]},{"ID":"20240616085454-ka29l40","Type":"NodeParagraph","Properties":{"id":"20240616085454-ka29l40","updated":"20240616085454"},"Children":[{"Type":"NodeText","Data":"为君，味苦、酸，平，无毒。主寒湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气，伤热火烂，堕胎。疗伤中少气，男子阴消，老人失溺，补中续绝，填骨髓，除脑中痛及腰脊痛，妇人月水不通，血结，益精，利阴气，止发白。久服轻身耐老。一名百倍。生河内川谷及临朐。二恶萤火、陆英、龟甲，畏白前。今出近道蔡州者，最长大柔润，其茎有节，似牛膝，故以为名也。乃云有雌雄，雄者茎紫色而节大为胜尔。"}]},{"ID":"20240616085454-3t4ji8e","Type":"NodeParagraph","Properties":{"id":"20240616085454-3t4ji8e","updated":"20240616085454"},"Children":[{"Type":"NodeText","Data":"〔谨案〕诸药，八月以前采者，皆晒干、火其十月以后至正月，乃可阴干。"}]},{"ID":"20240616085304-9yn8zi3","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-9yn8zi3"}},{"ID":"20240616085444-kfzdnuo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085444-kfzdnuo","updated":"20240616085448"},"Children":[{"Type":"NodeText","Data":"牛膝《神农本草经读》"}]},{"ID":"20240616085444-yz4oq2p","Type":"NodeParagraph","Properties":{"id":"20240616085444-yz4oq2p","updated":"20240616085444"},"Children":[{"Type":"NodeText","Data":"　　气味苦酸、平，无毒。主寒湿痿痹，四肢拘挛，膝痛不可屈伸，逐血气，伤热火烂，堕胎。久服轻身耐老。"}]},{"ID":"20240616085444-hr4h39f","Type":"NodeParagraph","Properties":{"id":"20240616085444-hr4h39f","updated":"20240616085444"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶牛膝气平，禀金气而入肺；味苦，得火味而入心包；味酸，得木味而入肝。"}]},{"ID":"20240616085444-rf1sf77","Type":"NodeParagraph","Properties":{"id":"20240616085444-rf1sf77","updated":"20240616085444"},"Children":[{"Type":"NodeText","Data":"唯其入肺，则能通调水道而寒湿行，胃热清而痿愈矣。唯其入肝，肝藏血而养筋，则拘挛可愈，膝亦不痛而能屈伸矣。唯其入心包，苦能泄实，则血因气凝之病可逐也。苦能泻火，则热汤之伤与火伤之烂可完也。苦味本伐生生之气，而又合以酸味，而遂大申其涌泄之权，则胎无不堕矣。久服轻身耐老者，又统言其流通血脉之功也。"}]},{"ID":"20240616085304-xae05a7","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-xae05a7"}},{"ID":"20240616085434-3s57brj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085434-3s57brj","updated":"20240616085440"},"Children":[{"Type":"NodeText","Data":"牛膝《顾松园医镜》"}]},{"ID":"20240616085434-oxckuy0","Type":"NodeParagraph","Properties":{"id":"20240616085434-oxckuy0","updated":"20240616085434"},"Children":[{"Type":"NodeText","Data":"〔甘酸平，入肝、肾二经。〕壮筋骨而理腰膝软弱，〔峻补肝、肾精血之功。〕治痹症而解四肢拘挛。〔补血则筋舒，行血则痛止，正旺血行邪自除矣。〕益精止腰脊之痛，填髓去脑中之疼。〔热多则阴分伤也。〕善疗五淋，〔小肠有气，则小便胀，有血则淋，有热则痛，故便淋或尿血，茎中痛甚者用之，取其性下行，逐恶血也。〕破 结，更主通经，堕胎，理拆伤。又能消痈散肿，〔皆行血逐瘀之功。〕肝、肾二经之药。大抵酒蒸则能补精血，生用则能祛恶血。"}]},{"ID":"20240616085434-w3bw4wf","Type":"NodeParagraph","Properties":{"id":"20240616085434-w3bw4wf","updated":"20240616085434"},"Children":[{"Type":"NodeText","Data":"善引诸药下行，上焦药中勿入，血崩不止者，切戒用之。"}]},{"ID":"20240616085304-t4aaclu","Type":"NodeThematicBreak","Properties":{"id":"20240616085304-t4aaclu"}},{"ID":"20240616085421-o2vo5tu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085421-o2vo5tu","updated":"20240616085425"},"Children":[{"Type":"NodeText","Data":"牛膝《雷公炮制药性解》"}]},{"ID":"20240616085421-g1t6pkl","Type":"NodeParagraph","Properties":{"id":"20240616085421-g1t6pkl","updated":"20240616085421"},"Children":[{"Type":"NodeText","Data":"味苦酸，性平无毒，入肾经。补精气，利腰膝，填骨髓，除脑漏，祛寒湿，破血结，通月经，坠胎孕，理膀胱气化迟难，阴中作痛欲死。去芦，酒浸一宿用，恶龟甲、萤火、陆英，畏白前白、藓皮，忌牛肉。"}]},{"ID":"20240616085421-5vs9sgp","Type":"NodeParagraph","Properties":{"id":"20240616085421-5vs9sgp","updated":"20240616085421"},"Children":[{"Type":"NodeText","Data":"按∶丹溪云∶牛膝引诸药下行，宜入足少阴以理诸疾，妇人得之，应归血海，故行血有功，脾虚气陷及腿膝肿者，不宜用之。有二种，土牛膝所禀薄，故短而细主破血，气川牛膝，所雷公云∶凡使去头并尘土了，用黄精自然汁浸一宿，漉出，细锉，焙干用。"}]},{"ID":"20240616085652-r50m4c2","Type":"NodeThematicBreak","Properties":{"id":"20240616085652-r50m4c2"}},{"ID":"20240616085653-o36zw06","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616085653-o36zw06","updated":"20240616085657"},"Children":[{"Type":"NodeText","Data":"牛膝《中药学》"}]},{"ID":"20240616085653-6pi8dmm","Type":"NodeParagraph","Properties":{"id":"20240616085653-6pi8dmm","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【药用】苋科草本植物川牛膝CyathulaofficinalisKuan或牛膝Achyranthes bidentataBL.的根。"}]},{"ID":"20240616085653-0t7maty","Type":"NodeParagraph","Properties":{"id":"20240616085653-0t7maty","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、酸，平。归肝、肾经。"}]},{"ID":"20240616085653-isi7ms8","Type":"NodeParagraph","Properties":{"id":"20240616085653-isi7ms8","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【功效】祛瘀通经疗伤，补肝肾、强筋骨，引血下行，利水通淋。"}]},{"ID":"20240616085653-xjxq6md","Type":"NodeParagraph","Properties":{"id":"20240616085653-xjxq6md","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于瘀滞经闭，产后瘀痛，跌扑伤痛等症。"}]},{"ID":"20240616085653-qhrc7y0","Type":"NodeParagraph","Properties":{"id":"20240616085653-qhrc7y0","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"牛膝善于活血祛瘀，对妇科、伤科各种瘀血凝滞的病症，常和红花、桃仁、当归、延胡索等药同用，既可活血调经，又能祛瘀疗伤。"}]},{"ID":"20240616085653-28sbli5","Type":"NodeParagraph","Properties":{"id":"20240616085653-28sbli5","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"2.用于腰膝酸痛，足膝萎软无力。"}]},{"ID":"20240616085653-v67tw1s","Type":"NodeParagraph","Properties":{"id":"20240616085653-v67tw1s","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"牛膝性善下行，入肝肾二经，能补肝肾、强筋骨，又能通血脉、利关节，为治腰膝下肢病症常用药。对肝肾不足引起的腰膝酸痛，常与苍朮、狗脊、木瓜等同用；如因湿热下注引起的腰膝关节疼痛，常与苍朮、黄柏等同用；如风湿痹痛、下肢关节疼痛为甚，可与木瓜、防己、独活等同用。"}]},{"ID":"20240616085653-2xkcam3","Type":"NodeParagraph","Properties":{"id":"20240616085653-2xkcam3","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"3.用于吐血、衄血、牙龈肿痛、头痛晕眩等症。"}]},{"ID":"20240616085653-ohzdzmk","Type":"NodeParagraph","Properties":{"id":"20240616085653-ohzdzmk","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"牛膝苦泄下降，能引血下行，导热下泄，可治上部血热妄行的症候，常配合侧柏叶、白茅根、小蓟等药，以治吐血、衄血；又可配养阴清热药如生地、石膏等，用治牙龈肿痛属于阴虚火旺的症候；治肝阳上亢，气血并走于上，头痛眩晕之症，常与平肝药如代赭石、龙骨、牡蛎等同用。"}]},{"ID":"20240616085653-sasp784","Type":"NodeParagraph","Properties":{"id":"20240616085653-sasp784","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"4.用于小便不利、淋沥涩痛及尿血等症。"}]},{"ID":"20240616085653-simm71y","Type":"NodeParagraph","Properties":{"id":"20240616085653-simm71y","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"本品又有利水通淋功效，能导膀胱湿热外泄，且能活血祛瘀，故可用于小便不利、淋沥涩痛及尿血之症，常与瞿麦、滑石、通草等同用。"}]},{"ID":"20240616085653-exm1z8i","Type":"NodeParagraph","Properties":{"id":"20240616085653-exm1z8i","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【处方用名】怀牛膝、淮牛膝（补肝肾、强筋骨作用较好）、川牛膝（活血祛瘀作用较好）"}]},{"ID":"20240616085653-irepg8a","Type":"NodeParagraph","Properties":{"id":"20240616085653-irepg8a","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240616085653-7tsc3kv","Type":"NodeParagraph","Properties":{"id":"20240616085653-7tsc3kv","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【附药】土牛膝：又名杜牛膝。即苋科植物牛膝的野生品的干燥根。性味苦、酸，平。功能活血祛瘀，泻火解毒，利尿。适用于妇女经闭，风湿痹痛，跌打损伤及咽喉肿痛、白喉等病症。一般用量三钱至五钱，煎服。"}]},{"ID":"20240616085653-r3j5dwk","Type":"NodeParagraph","Properties":{"id":"20240616085653-r3j5dwk","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【按语】牛膝入肝肾二经，性善下行，能治虚火上炎，祛瘀通经，善治妇女血瘀之证；利水通淋，除小便淋痛；补益肝肾，疗腰膝酸软。然有川牛膝、怀牛膝两种，性用略异，用当区别，行血脉则用川者，补肝肾则用怀者。孕妇、月经过多者忌用。"}]},{"ID":"20240616085653-spn9o0h","Type":"NodeParagraph","Properties":{"id":"20240616085653-spn9o0h","updated":"20240616085653"},"Children":[{"Type":"NodeText","Data":"【方剂举例】牛膝散（《证治准绳》）牛膝、当归、桂心、赤芍、桃仁、延胡索、丹皮、木香。治经水不利，脐腹作痛。"}]},{"ID":"20240607095447-gpix06n","Type":"NodeThematicBreak","Properties":{"id":"20240607095447-gpix06n"}},{"ID":"20240607095500-3lp2w0q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095500-3lp2w0q","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"《中国药典》：牛膝"}]},{"ID":"20240607095500-rxl1mjw","Type":"NodeParagraph","Properties":{"id":"20240607095500-rxl1mjw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095500-7kzqsxw","Type":"NodeParagraph","Properties":{"id":"20240607095500-7kzqsxw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" Niú Xī"}]},{"ID":"20240607095500-47b15at","Type":"NodeParagraph","Properties":{"id":"20240607095500-47b15at","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095500-nio3ldm","Type":"NodeParagraph","Properties":{"id":"20240607095500-nio3ldm","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 怀牛膝、牛髁膝、山苋菜、对节草、红牛膝、杜牛膝、土牛膝[野生品]"}]},{"ID":"20240607095500-m9qz6yv","Type":"NodeParagraph","Properties":{"id":"20240607095500-m9qz6yv","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607095500-tvrr9bl","Type":"NodeParagraph","Properties":{"id":"20240607095500-tvrr9bl","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" RADIX ACHYRANTHIS BIDENTATAE"}]},{"ID":"20240607095500-zy0txrq","Type":"NodeParagraph","Properties":{"id":"20240607095500-zy0txrq","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095500-1lbrva2","Type":"NodeParagraph","Properties":{"id":"20240607095500-1lbrva2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 本品为苋科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛膝"},{"Type":"NodeText","Data":"Achyranthes bidentata Blume. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。冬季茎叶枯萎时采挖，除去须根及泥沙，捆成小把，晒至干皱后，将顶端切齐，晒干。"}]},{"ID":"20240607095500-nzgwvcl","Type":"NodeParagraph","Properties":{"id":"20240607095500-nzgwvcl","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095500-mtvgudq","Type":"NodeParagraph","Properties":{"id":"20240607095500-mtvgudq","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 本品呈细长圆柱形，稍弯曲，上端稍粗，下端较细，长15～50（90）cm，直径0.4～1cm。表面灰黄色或淡棕色，有略扭曲而细微的纵皱纹、横长皮孔及稀疏的细根痕。质硬而脆，易折断，受潮则变柔软，断面平坦，黄棕色，微呈角质样而油润，中心维管束木部较大，黄白色，其外围散有多数点状的维管束，排列成2～4轮。气微，味微甜而稍苦涩。"}]},{"ID":"20240607095500-ep0ijm9","Type":"NodeParagraph","Properties":{"id":"20240607095500-ep0ijm9","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607095500-j19ktm2","Type":"NodeParagraph","Properties":{"id":"20240607095500-j19ktm2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防潮。"}]},{"ID":"20240607095500-ntdqw8q","Type":"NodeParagraph","Properties":{"id":"20240607095500-ntdqw8q","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095500-kb8wsx3","Type":"NodeParagraph","Properties":{"id":"20240607095500-kb8wsx3","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒牛膝"},{"Type":"NodeText","Data":"：取净牛膝段，放锅内炒热，喷洒黄酒，炒至微干，取出放凉（每100斤用黄酒10斤）。"}]},{"ID":"20240607095500-tcmrb8d","Type":"NodeParagraph","Properties":{"id":"20240607095500-tcmrb8d","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607095500-i6r0apo","Type":"NodeParagraph","Properties":{"id":"20240607095500-i6r0apo","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：木栓层为数列细胞。皮层较窄。维管束断续排列成 2～4 轮；最外轮维管束较小，有时仅 1至数个导管；形成层几连接成环；向内维管束较大，木质部由导管、木纤维及木薄壁细胞组成；中心木质部集成 2～3 群。薄壁细胞含草酸钙砂晶。"}]},{"ID":"20240607095500-wze2u3w","Type":"NodeParagraph","Properties":{"id":"20240607095500-wze2u3w","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加乙醇20ml，加热回流40分钟，静置。取上清液10ml，加盐酸1ml ，加热回流 1小时后浓缩至约 5ml，加水10ml，用石油醚（60～90℃）20ml提取，提取液蒸干，残渣加乙醇 2ml使溶解，作为供试品溶液。另取齐墩果酸对照品，加乙醇制成每 1ml含 1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液10～20μl、对照品溶液10μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｈ薄层板上，以氯仿－甲醇（40:1）为展开剂，展开，取出，晾干，喷以磷钼酸试液，在 110℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱中相应的位置上，显相同的蓝色斑点。"}]},{"ID":"20240607095500-ev5wpmr","Type":"NodeParagraph","Properties":{"id":"20240607095500-ev5wpmr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095500-qs3m2m2","Type":"NodeParagraph","Properties":{"id":"20240607095500-qs3m2m2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607095500-jrhbzgf","Type":"NodeParagraph","Properties":{"id":"20240607095500-jrhbzgf","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095500-cjgeu4r","Type":"NodeParagraph","Properties":{"id":"20240607095500-cjgeu4r","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 苦、酸，平。"}]},{"ID":"20240607095500-b58hcr2","Type":"NodeParagraph","Properties":{"id":"20240607095500-b58hcr2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095500-2txd2qe","Type":"NodeParagraph","Properties":{"id":"20240607095500-2txd2qe","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240607095500-pcoe3o7","Type":"NodeParagraph","Properties":{"id":"20240607095500-pcoe3o7","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095500-gapo6i4","Type":"NodeParagraph","Properties":{"id":"20240607095500-gapo6i4","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强筋骨，逐瘀通经，引血下行。用于腰膝酸痛，筋骨无力，经闭症瘕，肝阳眩晕。"}]},{"ID":"20240607095500-9vy7dzi","Type":"NodeParagraph","Properties":{"id":"20240607095500-9vy7dzi","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095500-8ktjjql","Type":"NodeParagraph","Properties":{"id":"20240607095500-8ktjjql","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 4.5～9g。"}]},{"ID":"20240607095500-r2rz79h","Type":"NodeParagraph","Properties":{"id":"20240607095500-r2rz79h","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095500-oxq20vd","Type":"NodeParagraph","Properties":{"id":"20240607095500-oxq20vd","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607095500-8kgqil2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095500-8kgqil2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：牛膝"}]},{"ID":"20240607095500-sjfd4up","Type":"NodeParagraph","Properties":{"id":"20240607095500-sjfd4up","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095500-58z5p2d","Type":"NodeParagraph","Properties":{"id":"20240607095500-58z5p2d","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" Niú Xī"}]},{"ID":"20240607095500-882mopy","Type":"NodeParagraph","Properties":{"id":"20240607095500-882mopy","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095500-gyc5pix","Type":"NodeParagraph","Properties":{"id":"20240607095500-gyc5pix","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 百倍（《本经》），怀牛膝（《本草便读》），鸡胶骨（《闽东本草》）。"}]},{"ID":"20240607095500-17z2xf8","Type":"NodeParagraph","Properties":{"id":"20240607095500-17z2xf8","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607095500-q8qt5qz","Type":"NodeParagraph","Properties":{"id":"20240607095500-q8qt5qz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607095500-a6rrtvr","Type":"NodeParagraph","Properties":{"id":"20240607095500-a6rrtvr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095500-eyma31y","Type":"NodeParagraph","Properties":{"id":"20240607095500-eyma31y","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 为苋科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛膝"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。牛膝的根，于冬季茎叶枯萎时采挖，去净须根，泥土，晒至干皱后，用硫黄熏数次，然后将顶端切齐、晒干。"}]},{"ID":"20240607095500-2dqwo7j","Type":"NodeParagraph","Properties":{"id":"20240607095500-2dqwo7j","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607095500-d2bsmcd","Type":"NodeParagraph","Properties":{"id":"20240607095500-d2bsmcd","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 栽培或野生于山野路旁。分布河南。山西，山东、江苏、安徽、浙江、江西、湖南、湖北、四川、云南、贵州等地。主产河南。"}]},{"ID":"20240607095500-qpsvka7","Type":"NodeParagraph","Properties":{"id":"20240607095500-qpsvka7","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607095500-sqta9e0","Type":"NodeParagraph","Properties":{"id":"20240607095500-sqta9e0","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高30～100厘米。根细长，直径0.6～1厘米，外皮土黄色。茎直立，四棱形，具条纹，疏被柔毛，节略膨大，节上对生分枝。叶对生，叶柄长约5～20毫米；叶片椭圆形或椭圆状披针形，长2～10厘米，宽1～5厘米，先端长尖，基部楔形或广楔形，全缘，两面被柔毛。穗状花序腋生兼顶生，初时花序短，花紧密，其后伸长，连下部总梗在内长约15～20厘米；花皆下折贴近花梗；苞片1，膜质，宽卵形，上部突尖成粗刺状，另有2枚小苞片针状，先端略向外曲，基部两侧各具，1卵状膜质小裂片；花被绿色，5片，直立，披针形，有光泽，长3～5毫米，具1脉，边缘膜质；雄蕊5，花丝细，基部合生，花药卵形，2室，退化雄蕊顶端平或呈波状缺刻；子房长圆形，花柱线状，柱头头状。胞果长圆形，光滑。种子1枚，黄褐色，花期7～9月。果期9～10月。"}]},{"ID":"20240607095500-44j1tnu","Type":"NodeParagraph","Properties":{"id":"20240607095500-44j1tnu","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095500-b4f4ng5","Type":"NodeParagraph","Properties":{"id":"20240607095500-b4f4ng5","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 干燥根呈细长圆柱形，有时稍弯曲，上端较祖，下端较细，长约30～90匣米，直径约0.5～1厘米。表面呈土黄色或淡棕色；具细微的纵皱纹和稀疏的侧根痕。质坚脆，易折断，断面平坦；微呈角质状。气特殊，味微甜而涩。以根粗长，皮细坚实，色淡黄者为佳。"}]},{"ID":"20240607095500-dp9q37x","Type":"NodeParagraph","Properties":{"id":"20240607095500-dp9q37x","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607095500-5t8esp8","Type":"NodeParagraph","Properties":{"id":"20240607095500-5t8esp8","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 根含皂甙，并含脱皮甾酮和牛膝甾酮。"}]},{"ID":"20240607095500-vy5xkag","Type":"NodeParagraph","Properties":{"id":"20240607095500-vy5xkag","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095500-1jlqh12","Type":"NodeParagraph","Properties":{"id":"20240607095500-1jlqh12","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 牛膝：拣去杂质，洗净，润软，去芦，切段，晒干。酒牛膝：取牛膝段，用黄酒喷淋拌匀，闷润后，置锅内炒至微干，取出放凉。（牛膝段每100斤，用黄酒10斤）"}]},{"ID":"20240607095500-oqa57jj","Type":"NodeParagraph","Properties":{"id":"20240607095500-oqa57jj","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使牛膝，去头并尘土，用黄精自然汁浸一宿，漉出，细割，焙干用之。\""}]},{"ID":"20240607095500-ctd3lga","Type":"NodeParagraph","Properties":{"id":"20240607095500-ctd3lga","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"牛膝，今惟以酒浸入药，欲下行则生用，滋补则焙用，或酒拌蒸过用。\""}]},{"ID":"20240607095500-ldtzh3y","Type":"NodeParagraph","Properties":{"id":"20240607095500-ldtzh3y","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095500-qqw2mzg","Type":"NodeParagraph","Properties":{"id":"20240607095500-qqw2mzg","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607095500-y11p72p","Type":"NodeParagraph","Properties":{"id":"20240607095500-y11p72p","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"足厥阴，少阴。\""}]},{"ID":"20240607095500-jm5llbi","Type":"NodeParagraph","Properties":{"id":"20240607095500-jm5llbi","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入足三阴经。\""}]},{"ID":"20240607095500-ouwxpco","Type":"NodeParagraph","Properties":{"id":"20240607095500-ouwxpco","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095500-lxyjr66","Type":"NodeParagraph","Properties":{"id":"20240607095500-lxyjr66","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 甘苦酸，平。"}]},{"ID":"20240607095500-h71ep59","Type":"NodeParagraph","Properties":{"id":"20240607095500-h71ep59","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦酸。\""}]},{"ID":"20240607095500-sm2969n","Type":"NodeParagraph","Properties":{"id":"20240607095500-sm2969n","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"酸，平，无毒。\""}]},{"ID":"20240607095500-i21x4f9","Type":"NodeParagraph","Properties":{"id":"20240607095500-i21x4f9","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味苦甘，气微凉。\""}]},{"ID":"20240607095500-wgrw1vj","Type":"NodeParagraph","Properties":{"id":"20240607095500-wgrw1vj","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095500-8w0fd9h","Type":"NodeParagraph","Properties":{"id":"20240607095500-8w0fd9h","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 凡中气下陷，脾虚泄泻，下元不固，梦遗失精，月经过多，及孕妇均忌服。"}]},{"ID":"20240607095500-810f73d","Type":"NodeParagraph","Properties":{"id":"20240607095500-810f73d","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶萤火，龟甲，陆英。畏白前。\""}]},{"ID":"20240607095500-touafjc","Type":"NodeParagraph","Properties":{"id":"20240607095500-touafjc","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"②《品汇精要》：\"妊妇不可服。\""}]},{"ID":"20240607095500-hqt7ot3","Type":"NodeParagraph","Properties":{"id":"20240607095500-hqt7ot3","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"经闭未久，疑似有娠者勿用；上焦药中勿入；血崩不止者忌之。\""}]},{"ID":"20240607095500-dhksf5f","Type":"NodeParagraph","Properties":{"id":"20240607095500-dhksf5f","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"④《本草通玄》：\"梦遗失精者，在所当禁。\""}]},{"ID":"20240607095500-vtoa1dl","Type":"NodeParagraph","Properties":{"id":"20240607095500-vtoa1dl","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"脏寒便滑，下元不固者当忌用之。\""}]},{"ID":"20240607095500-4cr5090","Type":"NodeParagraph","Properties":{"id":"20240607095500-4cr5090","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑥《药品化义》：\"若泻痢脾虚而腿膝酸痛不宜用。\""}]},{"ID":"20240607095500-vt1hj3h","Type":"NodeParagraph","Properties":{"id":"20240607095500-vt1hj3h","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑦《得配本草》：\"中气不足。小便自利，俱禁用。\""}]},{"ID":"20240607095500-mzxs1x1","Type":"NodeParagraph","Properties":{"id":"20240607095500-mzxs1x1","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095500-qkpfea1","Type":"NodeParagraph","Properties":{"id":"20240607095500-qkpfea1","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 生用散瘀血，消痈肿。治淋病，尿血，经闭，症瘕，难产，胞衣不下，产后瘀血腹痛，喉痹，痈肿，跌打损伤。熟用补肝肾，强筋骨。治腰膝骨痛，四肢拘挛，痿痹。"}]},{"ID":"20240607095500-4opah1a","Type":"NodeParagraph","Properties":{"id":"20240607095500-4opah1a","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒湿痿痹，四肢拘挛，膝痛不可屈，逐血气，伤热火烂，堕胎。\""}]},{"ID":"20240607095500-9v5ejym","Type":"NodeParagraph","Properties":{"id":"20240607095500-9v5ejym","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗伤中少气，男肾阴消，老人失溺，补中续绝，填骨髓，除脑中痛及腰脊痛，妇人月水不通，血结，益精，利阴气，止发白。\""}]},{"ID":"20240607095500-wttd526","Type":"NodeParagraph","Properties":{"id":"20240607095500-wttd526","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治阴痿，补肾填精，逐恶血流结，助十二经脉。\""}]},{"ID":"20240607095500-ab3f7c9","Type":"NodeParagraph","Properties":{"id":"20240607095500-ab3f7c9","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治腰膝软怯冷弱，破癥结，排脓止痛，产后心腹痛并血运，落胎，壮阳。\""}]},{"ID":"20240607095500-14hbjkz","Type":"NodeParagraph","Properties":{"id":"20240607095500-14hbjkz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑤《本草衍义》：\"与苁蓉浸酒服，益肾；竹木刺入肉，捣烂罨之，即出。\""}]},{"ID":"20240607095500-a8uizue","Type":"NodeParagraph","Properties":{"id":"20240607095500-a8uizue","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑥张元素：\"强筋。\""}]},{"ID":"20240607095500-np5vx84","Type":"NodeParagraph","Properties":{"id":"20240607095500-np5vx84","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑦《本草衍义补遗》：\"能引诸药下行。\""}]},{"ID":"20240607095500-652v9hw","Type":"NodeParagraph","Properties":{"id":"20240607095500-652v9hw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑧《滇南本草》：\"止筋骨疼，强筋舒筋，止腰膝酸麻，破瘀坠胎，散结核，攻瘰疬，退痈疽、疥癞、血风、牛皮癣、脓窠。\""}]},{"ID":"20240607095500-5gfz216","Type":"NodeParagraph","Properties":{"id":"20240607095500-5gfz216","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑨《纲目》：\"治久疟寒热，五淋尿血，茎中痛，下痢，喉痹，口疮，齿痛，痈肿恶疮，伤折。\""}]},{"ID":"20240607095500-abi402v","Type":"NodeParagraph","Properties":{"id":"20240607095500-abi402v","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑩《本草正》：\"主手足血热瘙痹，血燥拘挛，通膀胱涩秘，大肠干结，补髓填精，益阴活血。\""}]},{"ID":"20240607095500-i94o8et","Type":"NodeParagraph","Properties":{"id":"20240607095500-i94o8et","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑾《本草备要》：\"酒蒸则益肝肾，强筋骨，治腰膝骨痛，足痿筋挛，阴痿失溺，久疟，下痢，伤中少气，生用则散恶血，破癥结，治心腹诸痛，淋痛尿血，经闭难产，喉痹齿痛，痈疽恶疮。\""}]},{"ID":"20240607095500-my9jaju","Type":"NodeParagraph","Properties":{"id":"20240607095500-my9jaju","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095500-o87iu0k","Type":"NodeParagraph","Properties":{"id":"20240607095500-o87iu0k","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；浸酒、熬膏或入丸、散。外用：捣敷。"}]},{"ID":"20240607095500-8it00sd","Type":"NodeParagraph","Properties":{"id":"20240607095500-8it00sd","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607095500-5uwuv7w","Type":"NodeParagraph","Properties":{"id":"20240607095500-5uwuv7w","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" ①治小便不利，茎中痛欲死，兼治妇人血结腹坚痛：牛膝一大把并叶，不以多少，酒煮饮之。（《肘后方》）"}]},{"ID":"20240607095500-xu2sa48","Type":"NodeParagraph","Properties":{"id":"20240607095500-xu2sa48","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"②治室女月经不通，脐下坚结，大如杯升，发热往来，下痢羸瘦，此为血瘕：干漆（杵细，炒令烟尽），牛膝（酒浸一宿）各一两六钱（为末）。生地黄四两八钱，取汁，慢火熬，丸如桐子大。空心，米饮或温酒下二丸，日再，勿妄加，病去止药。（《三因方》万病丸）"}]},{"ID":"20240607095500-wbnwxiq","Type":"NodeParagraph","Properties":{"id":"20240607095500-wbnwxiq","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"③治暴症，腹中有物如石，痛如刺，昼夜啼呼：牛膝二斤，以酒一斗，渍，密封，于热炭火中温令味出，服五合至一升，量力服之。（《补缺肘后方》）"}]},{"ID":"20240607095500-zhne9wa","Type":"NodeParagraph","Properties":{"id":"20240607095500-zhne9wa","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"④治胞衣不出：牛膝八两，葵子一两。以水九升，煎取三升，分三服。（《梅师集验方》）"}]},{"ID":"20240607095500-hqv78bo","Type":"NodeParagraph","Properties":{"id":"20240607095500-hqv78bo","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑤取胎：用雄土牛膝一两，真麝香一钱，捣匀，溶蜡搓成长条，插入阴户，即能坠胎。（《药鉴》）"}]},{"ID":"20240607095500-nkoz1hm","Type":"NodeParagraph","Properties":{"id":"20240607095500-nkoz1hm","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑥治喉痹、乳蛾：新鲜牛膝根一握，艾叶七片。捣，和人乳，取汁灌入鼻内，须臾痰涎从口鼻出。无艾亦可。（《纲目》）"}]},{"ID":"20240607095500-5jn5ebw","Type":"NodeParagraph","Properties":{"id":"20240607095500-5jn5ebw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑦治痈疖已溃：牛膝根略刮去皮，插入疮口中，留半寸在外，以嫩橘叶及地锦草各一握，捣，（敷）其上，随干随换。（《陈日华经验方》）"}]},{"ID":"20240607095500-fqyt8mr","Type":"NodeParagraph","Properties":{"id":"20240607095500-fqyt8mr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑧治口中及舌上生疮，烂：牛膝酒渍含漱之，无酒者空含亦佳。（《肘后方》）"}]},{"ID":"20240607095500-0kk2d0m","Type":"NodeParagraph","Properties":{"id":"20240607095500-0kk2d0m","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑨治风瘙隐疹、骨疽、癞病：牛膝为末，酒下方寸匕，日三。（《千金方》）"}]},{"ID":"20240607095500-vtzvlkz","Type":"NodeParagraph","Properties":{"id":"20240607095500-vtzvlkz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑩治金疮痛：生牛膝捣敷疮上。（《梅师集验方》）"}]},{"ID":"20240607095500-nuj0zzw","Type":"NodeParagraph","Properties":{"id":"20240607095500-nuj0zzw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑾治风湿痹，腰痛少力：牛膝一两（去苗），桂心三分，山茱萸一两。上件药，捣细罗为散。每于食前，以温酒调下二钱。（《圣惠方》）"}]},{"ID":"20240607095500-ntmwhxt","Type":"NodeParagraph","Properties":{"id":"20240607095500-ntmwhxt","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⑿治湿热下流，两脚麻木，或如火烙之热：苍术六两（米泔浸三宿，细切，焙干），黄柏四两（切片，酒拌略炒），川牛膝（去芦）二两。上为细末，面糊为丸，如桐子大。每服五、七、十丸，空心姜盐汤下，忌鱼腥、荞麦、热面、煎炒等物。（《医学正传》三妙丸）"}]},{"ID":"20240607095500-e8nd3d2","Type":"NodeParagraph","Properties":{"id":"20240607095500-e8nd3d2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒀治鹤膝风：牛膝、木瓜、五加皮、骨碎补、金银花、紫花地丁、黄柏、萆薢、甘菊根，水煎服。（《本草汇言》）"}]},{"ID":"20240607095500-obb9j40","Type":"NodeParagraph","Properties":{"id":"20240607095500-obb9j40","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒁治痿痹，补虚损，壮筋骨，除久疟：牛膝煎汁和曲米酿酒，或切碎袋盛浸酒，煮饮之。（《纲目》牛膝酒）"}]},{"ID":"20240607095500-c6rp9pj","Type":"NodeParagraph","Properties":{"id":"20240607095500-c6rp9pj","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒂治痨疟积久不断：长生大牛膝一虎口。切，以水六升，煮取二升，分再服，第一服取未发前一食顷服，第二服临发服。（《千金方》）"}]},{"ID":"20240607095500-btmdtkj","Type":"NodeParagraph","Properties":{"id":"20240607095500-btmdtkj","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒃治痢下先赤后白：牛膝三两。捣碎，以酒一升，渍经一宿，每服饮两杯，日三服。（《肘后方》）"}]},{"ID":"20240607095500-7ozihmf","Type":"NodeParagraph","Properties":{"id":"20240607095500-7ozihmf","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒄治消渴不止，下元虚损：牛膝五两，细判，为末，生地黄汁五升，浸，昼曝夜浸，汁尽为度，蜜丸桐子大，空心温酒下三十丸。（《经验后方》）"}]},{"ID":"20240607095500-mlv8js9","Type":"NodeParagraph","Properties":{"id":"20240607095500-mlv8js9","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒅劳疟积久。用长牛膝一把，生切，加水六升，煮成二升，分三次服完（清晨一服，未发疟前一服，临发疟时一服。）"}]},{"ID":"20240607095500-zx92ifs","Type":"NodeParagraph","Properties":{"id":"20240607095500-zx92ifs","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒆消渴不止（下元虚损）。用牛膝五两，研细，浸入生地黄汁五升中。日晒夜浸，直到汁尽。加蜜和丸，如梧子大。每服三十丸，空心服，温酒送下。久服于身体有益。"}]},{"ID":"20240607095500-hallhp0","Type":"NodeParagraph","Properties":{"id":"20240607095500-hallhp0","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"⒇妇女血病（月经淋闭，月经不来，绕脐寒疝痛，产后血气不调，腹中结症瘕不散诸病）。用牛膝在酒中浸一夜，取出焙干；另用漆炒令烟尽。各一两为末，加生地黄汁一升，慢火上熬成浓糊，团成丸子，如梧子大。每服三丸，空心服，米汤送下。此方名\"万病丸\"。"}]},{"ID":"20240607095500-rvk2zu3","Type":"NodeParagraph","Properties":{"id":"20240607095500-rvk2zu3","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（21）胞衣不下。用牛膝八两、葵子一合，加水九升，煎成三升。分三次服。"}]},{"ID":"20240607095500-do0hszh","Type":"NodeParagraph","Properties":{"id":"20240607095500-do0hszh","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（22）产后尿血。用川牛膝水煎常服。"}]},{"ID":"20240607095500-3aroolr","Type":"NodeParagraph","Properties":{"id":"20240607095500-3aroolr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（23）喉痹乳蛾。用新鲜牛膝根一把、艾叶七片，同人乳捣和，取汗灌入鼻内。不久，痰涎从口鼻流出即愈。不用艾叶亦可。又方：牛膝捣汁和陈醋灌病人。"}]},{"ID":"20240607095500-8kxmyzd","Type":"NodeParagraph","Properties":{"id":"20240607095500-8kxmyzd","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（24）口舌疮烂。用牛膝浸酒含漱，亦可煎饮。"}]},{"ID":"20240607095500-p78cmi0","Type":"NodeParagraph","Properties":{"id":"20240607095500-p78cmi0","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（25）牙齿疼痛。用牛膝研末含漱，也可以用牛膝烧灰敷患处。"}]},{"ID":"20240607095500-sry62ws","Type":"NodeParagraph","Properties":{"id":"20240607095500-sry62ws","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（26）恶疮（人不知名）。用牛膝根捣敷。"}]},{"ID":"20240607095500-o0fsgln","Type":"NodeParagraph","Properties":{"id":"20240607095500-o0fsgln","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"（27）痈疖已溃。用牛膝根略刮去皮，插入疮口中，留半寸在外，以嫩橘叶及地锦草各一把，捣烂后涂疮上。"}]},{"ID":"20240607095500-bo61fhr","Type":"NodeParagraph","Properties":{"id":"20240607095500-bo61fhr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607095500-y8nlwqz","Type":"NodeParagraph","Properties":{"id":"20240607095500-y8nlwqz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 用于扩张子宫颈管：取直径0.2～0.3厘米的干品切削成7～9厘米长的圆形小棒，前端钝圆，洗净，晾干，尾端用丝线扎住，用高压蒸气消毒后备用。术前准备及手术操作按妇科常规。宫颈固定后，用探针探察宫颈之方向及大小，经产妇一般宫口较松，无须扩张颈管，可直接用阴道长钳挟牛膝前端插入6～8厘米（必须达子宫内口1～2厘米），尾端及丝线外露，然后用无菌纱布填塞阴道。术后可照常活动。经12～24小时后拉出牛膝，行刮宫术。据78例观察，插牛膝后颈管部有充血、软化、松弛等变化，宫口扩大；部分病例在刮宫时感觉胎盘组织与宫壁粘着较松，似有剥离现象。对人工早孕流产，过期流产及葡萄胎等以牛膝插入代替金属棒扩张颈管，具有一定的优越性，可以缩短手术时间、减少病人痛苦。"}]},{"ID":"20240607095500-1d6rair","Type":"NodeParagraph","Properties":{"id":"20240607095500-1d6rair","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607095500-8dsh782","Type":"NodeParagraph","Properties":{"id":"20240607095500-8dsh782","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 李时珍说：\"牛膝乃足厥阴、少阴之药。所主之药，大抵得酒则能补肝、肾，生用则能去恶血，二者而已。其治腰膝骨痛、足痿阴消，失溺、久疟、伤中少气诸病，非取其补肝肾之功欤？其治症瘕、心腹诸痛、痈肿恶疮、金疮折伤、喉齿、淋痛、尿血、经候、胎产诸病，非取其去恶血之功欤？\""}]},{"ID":"20240607095500-3xbwg6v","Type":"NodeParagraph","Properties":{"id":"20240607095500-3xbwg6v","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095500-s1r6i06","Type":"NodeParagraph","Properties":{"id":"20240607095500-s1r6i06","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607095500-bkpjic5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095500-bkpjic5","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"《中华本草》：牛膝"}]},{"ID":"20240607095500-zmxc3gu","Type":"NodeParagraph","Properties":{"id":"20240607095500-zmxc3gu","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095500-rmykdli","Type":"NodeParagraph","Properties":{"id":"20240607095500-rmykdli","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" Niú Xī"}]},{"ID":"20240607095500-4t5serr","Type":"NodeParagraph","Properties":{"id":"20240607095500-4t5serr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095500-e1v39xy","Type":"NodeParagraph","Properties":{"id":"20240607095500-e1v39xy","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 百倍、牛茎、脚斯蹬、铁牛膝、杜牛膝、怀牛膝、怀夕、真夕、怀膝、土牛膝、淮牛膝、红牛膝、牛磕膝、牛克膝、牛盖膝、粘草子根、牛胳膝盖、野牛充膝、接骨丹、牛盖膝头"}]},{"ID":"20240607095500-piog689","Type":"NodeParagraph","Properties":{"id":"20240607095500-piog689","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607095500-2bvvdb0","Type":"NodeParagraph","Properties":{"id":"20240607095500-2bvvdb0","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607095500-qubkzxc","Type":"NodeParagraph","Properties":{"id":"20240607095500-qubkzxc","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：牛膝，今出近道，蔡州者最良。大柔润，其茎有节似牛膝，故以为名也。乃云有雌雄，雄者茎紫色而节大者为胜尔。"}]},{"ID":"20240607095500-tyiunly","Type":"NodeParagraph","Properties":{"id":"20240607095500-tyiunly","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：牛膝，怀州者长白，近道、苏州者色紫。"}]},{"ID":"20240607095500-hgzhdt5","Type":"NodeParagraph","Properties":{"id":"20240607095500-hgzhdt5","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：牛膝，今江淮、闽粤、关中亦有之，然不及怀州者为真。春生苗，茎高二、三尺，青紫色，有节如鹤膝，又如牛膝状，以此名之。叶尖圆如匙，两两相对，于节上生花作穗，秋结实甚细。此有"}]},{"ID":"20240607095500-0bmnm9l","Type":"NodeParagraph","Properties":{"id":"20240607095500-0bmnm9l","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095500-n1o37rx","Type":"NodeParagraph","Properties":{"id":"20240607095500-n1o37rx","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 药材基源：为苋科植物牛膝的根。"}]},{"ID":"20240607095500-ub6zfdr","Type":"NodeParagraph","Properties":{"id":"20240607095500-ub6zfdr","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Achyranthes bidentata Bl."}]},{"ID":"20240607095500-0krg356","Type":"NodeParagraph","Properties":{"id":"20240607095500-0krg356","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"采收和储藏：南方在11月下旬至12月中旬，北方在10月中旬至11月上旬收获。先割会地上茎叶，依次将根挖出，剪除芦头，去净泥土和杂质。按根的粗细不同，晒至六七成干后，集中室内加盖草席，堆闷2～3d，分级，扎把，晒干。"}]},{"ID":"20240607095500-f0eg1c5","Type":"NodeParagraph","Properties":{"id":"20240607095500-f0eg1c5","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607095500-9yybk54","Type":"NodeParagraph","Properties":{"id":"20240607095500-9yybk54","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于屋旁、林缘、山坡草丛中。"}]},{"ID":"20240607095500-yha06q5","Type":"NodeParagraph","Properties":{"id":"20240607095500-yha06q5","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于除东北以外的全国广大地区。在有些地区则大量栽培，河南产的怀牛膝为地道药材。"}]},{"ID":"20240607095500-epun9bp","Type":"NodeParagraph","Properties":{"id":"20240607095500-epun9bp","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607095500-u413tw2","Type":"NodeParagraph","Properties":{"id":"20240607095500-u413tw2","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高70-120cm。根圆柱形，直径5-10mm，土黄色。茎有棱角或四方形，绿色或带紫色，有白色贴生或开展柔毛，或近无毛，分枝对生，节膨大。单叶对生；叶柄长5-30mm;叶片膜质，椭圆形或椭圆状披针形，长5-12cm，宽2-6cm，先端渐尖，基部宽楔形，全缘，两面被柔毛。穗状花序项生及腋生，长3-5cm，花期后反折；总花梗长1-2cm，有白色柔毛；花多数，密生，长5mm；苞片宽卵形，长2-3mm，先端长渐尖；小苞片刺状，长2.5-3mm，先端弯曲，基部两侧各有1卵形膜质小裂片，长约1mm；花被片披针形，长3-5mm，光亮，先端急尖，有1中脉；雄蕊长2-2.5mm；退化雄蕊先端平圆，稍有缺刻状细锯齿。胞果长圆形，长2-2.5mm，黄褐色，光滑。种子长圆形，长1mm，黄褐色。花期7-9月，果期9-10月。"}]},{"ID":"20240607095500-rkmg0gj","Type":"NodeParagraph","Properties":{"id":"20240607095500-rkmg0gj","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607095500-vveielz","Type":"NodeParagraph","Properties":{"id":"20240607095500-vveielz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 生物学特性 为深根系植物，喜温暖干燥气候；不耐严寒，在气温-17℃时植株易冻死。以土层深厚的砂质壤土栽培为宜；粘土及碱性上不宜生长。"}]},{"ID":"20240607095500-dme2goq","Type":"NodeParagraph","Properties":{"id":"20240607095500-dme2goq","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。秋季种由青变黄褐色采种，晒，备用。播种前将种疗用30℃温水浸泡8-12h,捞出，放入容器内，覆盖温布，经常保持湿润，待50％种子萌芽时，取出再行播种。一般南方适宜播种期为6月下旬至7月上旬、中旬；北方在5月下旬至6月初。过早播种植物生长快，茎叶茂盛，开花结果早而多，但根部短而且分叉多，常现木质化，品质差；过迟播种，生长期太短，植株矮小，根细而短，产量低。适当延迟播种，可减少抽苔。南方多采用撒播，将处理的种子拌入适量细土，撒播轻耙，稍加镇压，浇水保持土壤湿润。北方常用条播，按行距12-30cm开1-2cm深的浅沟，将种子均匀播入沟内，覆土以盖没种厂为度。每1hm2用种量7．5～15kg。"}]},{"ID":"20240607095500-yjxrwc8","Type":"NodeParagraph","Properties":{"id":"20240607095500-yjxrwc8","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高7cm时间苗，苗高17-20cm时按株距13cm定苗。定苗前后中耕除草2～3次，。肥料除施足基肥外，可在7-8月追施磷、钾肥，在收获前1个月喷过磷酸钙进行根外追肥。8月下旬植物抽苔时，要及时除去花序，避免开花消耗养分，促使根生长粗壮，但切勿损伤茎叶。出苗后经常保持田间湿润。多雨季节需注意排水，防止烂根。收获前可灌水1次，以便容易挖掘根部。"}]},{"ID":"20240607095500-hcnp769","Type":"NodeParagraph","Properties":{"id":"20240607095500-hcnp769","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"病虫害防治 自锈病、叶斑病可喷1：1：120波尔多液或50％可湿性甲基托布津1000倍液防治。根腐病应注意排水并选择地势高燥的地块种植，忌连作。用50％多菌灵可湿性粉剂1000倍液或石灰2．5kg兑水50kg灌穴。另有叶斑病、线虫病为害。虫害有银纹被蛾，可捕杀或喷90％敌百虫800倍液防冶。棉红蜘蛛可用40o%；水胺硫磷1500倍液防治。另有尺蠖、猿叶虫为害。"}]},{"ID":"20240607095500-1lp5w7f","Type":"NodeParagraph","Properties":{"id":"20240607095500-1lp5w7f","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095500-lkjyexy","Type":"NodeParagraph","Properties":{"id":"20240607095500-lkjyexy","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根呈细长圆柱形，有的稍弯曲，上端稍粗，下端较细，长15-50cm，直径0．4-1cm。表面及黄色或淡棕色，具细微纵皱纹，有细小横长皮孔及稀疏的细根痕。质硬而脆，易折断，断面平坦，黄棕色，微呈角质样，中心维管束木部较大，黄白色，其外围散有多数点状维管束，排列成2-4轮。气微，味微甜、涩。"}]},{"ID":"20240607095500-ifzxzcg","Type":"NodeParagraph","Properties":{"id":"20240607095500-ifzxzcg","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"以条长、皮细肉肥、色黄白者为佳。"}]},{"ID":"20240607095500-6odx68q","Type":"NodeParagraph","Properties":{"id":"20240607095500-6odx68q","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：木栓层为数列细胞，皮层狭窄。中柱占根的大部分，布有多数维管束，断续排列成2-4-8轮，最外轮维管束较小，形成层几连接成环；向内数轮维管束较大，射线宽狭不一；木质部有导管、木纤维及木薄壁细胞组成，根中心部的次生木质部集成2-3叉状，初生木质部2-3原型。薄壁细胞中含草酸钙砂晶。"}]},{"ID":"20240607095500-uy1a3ox","Type":"NodeParagraph","Properties":{"id":"20240607095500-uy1a3ox","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）泡沫试验 取本品粉末少量，加10倍量水充分振摇，产生大量泡沫，经久不消。（检查皂式）（2）溶血试验 取用生理盐水稀释的1％新鲜兔血1ml，沿管壁加入本品的生理盐水浸液(1：10）若干，迅速发生溶血现象。（检查皂甙）（3）薄层色谱 取本品粉末2g,加乙醇20ml，回流提取40min，静置。取上清液10ml，加盐酸1ml，回流提取1h，浓缩至约5ml,加水10ml，用石油醚（60-90℃）20ml提取，提取液蒸干，残渣加乙醇2ml溶解，作供试品溶液。另取齐墩果酸加乙醇制成每1ml含1mg的溶液，作对照品溶液。吸取供试品溶液10-20μl，对照品溶液10μl，分别点于同一硅胶G薄层板上，以氯仿-甲醇（40：1）溶液展开，取出晾干，喷以磷钼酸试液，110℃供约10min。供试品色谱中，在与对照品色谱中相应的位置上，显相同的蓝色斑点。商品规格 一等（头肥）：根条均匀，中部直径0．6cm以上，长50cm以上；二等（二肥）：根条均匀，中部直径0．4cm以上，长35cm以上；三等（平条）：中部直径0．4cm以下，但不小于0．2cm，长短不分，间有冻条、油条、破条。"}]},{"ID":"20240607095500-675n8dz","Type":"NodeParagraph","Properties":{"id":"20240607095500-675n8dz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607095500-fcccuhs","Type":"NodeParagraph","Properties":{"id":"20240607095500-fcccuhs","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 促蜕皮甾酮小鼠腹腔注射的半数致死量为6.4g/kg，牛膝甾酮为7.8g/kg，灌胃时二者均\u003e9g/kg。上述样品煎剂按60g/kg/每日1次，连续30天，动物(小鼠)血象，肾功能，主要内脏及体重、活动等与正常对照组比较，均未发生异常。"}]},{"ID":"20240607095500-ydb06g7","Type":"NodeParagraph","Properties":{"id":"20240607095500-ydb06g7","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607095500-ohk2i9j","Type":"NodeParagraph","Properties":{"id":"20240607095500-ohk2i9j","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 根含三萜皂甙：齐墩果酸α-L-吡喃鼠李糖基-β-D-吡喃半乳糖甙（oleanolic acid a－L－hamnopyranosyl-β-D-galac－topyranoside）[1,2]。又含多种多糖：一种是从根的水浸液中用丙酮沉出的具有抗肿瘤活性的多糖[3]；一种是由6个葡萄糖残基和3个甘露糖残基构成的水溶性寡糖AbS,有显着的增强免疫功能的活性[4]；另一种是具有免疫活性的肽多糖ABAB，系由葡萄糖醛酸（glucuronic acid）、半乳精galactose）、半乳糖醛酸（galacturonic acid）、阿拉伯糖（arabinose）和鼠李糖（rhamnose）按摩尔比12：2：1：1：1所组成，肽的含量为24．7％，主要由甘氨酸（glycine）、谷氨酸（glutamicacid）、天冬氨酸（aspartic acid）和丝氨酸（serine）组成，相对分子质量为23 000[15]。还含蜕皮甾酮（ecdysterone），牛膝甾酮（inokosterone）[6]，红苋甾酮（rubro－sterone）[7]以及精氨酸（arginine），甘氨酸，丝氨酸，天冬氨酸，谷氨酸，苏氨酸（threonine），脯氨酸（proline），酪氨酸（tyrosine），色氨酸（TCMLIByptophan），缬氨酸（valine），苯丙氨酸（phenylalanine），亮氨酸（leucine）和生物碱类及香豆精类化合物[8]。"}]},{"ID":"20240607095500-b1008ke","Type":"NodeParagraph","Properties":{"id":"20240607095500-b1008ke","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607095500-pr8x1cz","Type":"NodeParagraph","Properties":{"id":"20240607095500-pr8x1cz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 1.对蛋白质同化作用 牛膝所含蜕皮甾酮具有较强的蛋白质合成促进作用。实验给小鼠灌胃或腹腔注射1次蜕皮甾酮后2小时，即可见小鼠肝脏细胞核、线粒体及微粒体中氨基酸前体掺入增多，4小时后作用更强。同时在肾脏也可见蛋白质合成增强现象，但于4小时后回复原有水平。蔗糖密度样度离心分析表明，给药血RNA较对照血具有2倍的铸型活性，提示蜕皮甾酮的蛋白质合成效果至少伴有促进m一RNA合成的作用。离乳雄性小鼠连续给予促蜕皮甾酮60天时，其体重增长较快，肝肾蛋白质合成水平亦增高，肝组织检查可见肝细胞功能亢进表现。"}]},{"ID":"20240607095500-ftyalsa","Type":"NodeParagraph","Properties":{"id":"20240607095500-ftyalsa","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.抗炎镇痛作用：2.1.对巴豆油耳肿胀小鼠的影响：取小鼠30只，随机分成三组，实验组注射牛膝0.5ml/20g，对照组注射生理盐水，结果牛膝对巴豆油性耳肿胀有明显的抑制作用，并且作用随着剂量增加而增加。"}]},{"ID":"20240607095500-q9ixda1","Type":"NodeParagraph","Properties":{"id":"20240607095500-q9ixda1","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.2.对甲醛性大鼠足跖肿胀的影响：取健康大鼠20只，随机分为两组，于左右跖皮下注射2.5%甲醛0.1ml致炎，左右足为自身对照。腹腔注射牛膝16.6ml/(kg.天)，结果实验组与对照组有明显差异(P\u003c0.05。"}]},{"ID":"20240607095500-b4kpnyk","Type":"NodeParagraph","Properties":{"id":"20240607095500-b4kpnyk","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.3.对醋酸热体反应小鼠的作用小鼠口服怀牛膝煎剂有极显着的镇痛作用。"}]},{"ID":"20240607095500-fkiu9hg","Type":"NodeParagraph","Properties":{"id":"20240607095500-fkiu9hg","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的作用：3.1.对心脏的影响：牛膝醇提取液对离体蛙心，麻醉猫有一定的抑制作用，水煎剂对麻醉犬心肌的作用更为明显。"}]},{"ID":"20240607095500-75a0p6j","Type":"NodeParagraph","Properties":{"id":"20240607095500-75a0p6j","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"3.2.对动物血压的影响：牛膝煎剂对麻醉猫和犬等均有短暂的降压作用，血压下降时伴有呼吸兴奋，降压作用亦无快速耐受现象，推测其作用机制可能与组胺的释放，心脏抑制及扩张外周血管有关。"}]},{"ID":"20240607095500-v25kjgg","Type":"NodeParagraph","Properties":{"id":"20240607095500-v25kjgg","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"4.对肠管的作用：选用家兔、雌雄兼用，分别选取十二指肠、空肠和回肠，每段3-4cm，按平滑肌常规实验法进行。用16只家兔，56段肠管，给以醇提取液，可使上述肠段兴奋，紧张性提高，收缩力加强，换液后很快即可恢复。"}]},{"ID":"20240607095500-2qo9q8h","Type":"NodeParagraph","Properties":{"id":"20240607095500-2qo9q8h","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"5.对子宫的作用：5.1.对离体大鼠子宫平滑肌的作用：随机选用童贞大鼠(未做性周期涂片检查)28只，体得230±SDI7.3g，按常规方法制备离体子宫标本，子宫肌段长1.5cm，置于含DeJaoln溶液I的恒温洛槽内(20ml)，调节基线张力1.5g，连续通入95%O2+5%CO2(32±0.5℃，pH=7.4-7.6)平衡30-60分钟后，开始实验。实验时联接肌力换能器，通过台式自动平衡记录仪描记子宫收缩活动。以求积仪算出子宫收缩曲线下面积(简称子宫收缩面积，UCA)做为指标。观察4种不同剂量的牛膝总皂甙对未孕离体大鼠子宫的作用。牛膝总甙有明显兴奋大鼠子宫平滑肌的作用。给药后子宫收缩振幅增高，频率加快、张力也增加。主要为规则的节律性收缩，很少出现痉挛性收缩。UCA较给药前有显着增加(P\u003c0.001)。从给药后10分钟内UCA来看，随剂量的增加，UCA也相应的增加。各组UCA的高峰也逐步前移，子宫收缩的潜伏期相应的缩短。从上述实验各剂量组中皆随机选出10例标本，光给药1次，作用3分钟后，换液冲洗3次，待标本恢复后再给药1次，观察重复给药对子宫平滑肌的作用。结果表明，随着给药剂量的增加，重复给药时牛膝总皂甙兴奋子宫平滑肌的作用明显减弱，当剂量增加到0.5mg/ml以上时，再次给药不引起明显的子宫平滑肌兴奋。"}]},{"ID":"20240607095500-4cg0qr9","Type":"NodeParagraph","Properties":{"id":"20240607095500-4cg0qr9","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"5.2.不同生理状态条件下药物的对子宫作用：选用雌性大鼠28只，其中4只为幼龄鼠(鼠龄为7周以内)，体重104±SD2.8g，其余为成熟的未孕或乙孕大鼠，体重226.8±SD15.5g。未孕成熟大鼠实验前做阴道涂片，确定性周期，按TurnerCD氏法分性周期，选取动情期、间情期大鼠。已孕大鼠按孕期分为3种怀孕状态：在7天以内为早孕，8一14天为中孕，15天以上为晚孕。另取4只大鼠，连续每日皮下注射??己烯雌酚0.lmg/kg，共2天，造成人工动情期以供实验。实验方法同前，各组实验皆用8一10例标本，比较研究0.5mg/ml牛膝总甙对不同生理状态下子宫平滑肌的作用。结果如表5。给药前10分钟内UCA各怀孕组明显高于未怀孕组(P\u003c0.05)。各组给药后UCA皆增加，其增加值按大小顺序依次排列为：晚孕组\u003e早孕组\u003e间情期组\u003e中孕组、己烯雌酚组、动情期组\u003e幼龄组。其中幼龄组最低，晚孕组最高。"}]},{"ID":"20240607095500-on9l84t","Type":"NodeParagraph","Properties":{"id":"20240607095500-on9l84t","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"5.3.牛膝总皂甙对未孕大鼠宫颈、宫角作用的比较：实验共用未孕大鼠宫颈、宫角标本各12个，标本长度1-1.5cm，按上述方法进行实验。给予牛膝总皂甙4.5mg/ml，比较药物对宫颈、宫角的作用，结果见表6。牛膝总皂甙0.5mg/ml对大鼠宫颈无明显兴奋作用。给药后大鼠宫颈除张力有一定增加外，收缩振幅及频率无明显的变化；对大鼠子宫角则有明显作用，使张力增加，收缩振幅增高、频率加快。"}]},{"ID":"20240607095500-cjdqv9o","Type":"NodeParagraph","Properties":{"id":"20240607095500-cjdqv9o","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"5.4.家兔在体子宫的作用：选用体重2-2.51g未孕、中孕(孕期10-20天)的家兔各3只，在戊巴比妥钠25mg/kg静脉注射麻醉下手术，用在位子宫悬垂法记录子宫收缩。将子宫套管下端与腹壁切口扎牢，使子宫浸泡于加温对38℃的低钙乐氏液中(1/4正常钙量)。静止负荷3-5g，稳定30-60分钟后，待所描记的子宫活动恒定时，开始实验。采用局部给药，即先将套管内的液体吸出，再加入0.5mg/ml的牛膝总皂甙(用低钙乐氏液配制)，观察记录30分钟。4例动物(未孕、中孕各半)首次给药后，换液冲洗数次，再重复给药1次。"}]},{"ID":"20240607095500-nk1gy4v","Type":"NodeParagraph","Properties":{"id":"20240607095500-nk1gy4v","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"结果表明，给药后1-4分钟内，未孕及中孕家兔在体子宫均可出现强烈的宫缩。表现为张力增加，收缩振幅加大，频率加快，兴奋作用一般持续25分钟左右逐渐减弱。重复给药仍差兴奋作用，但与首次给药时相比，作用减弱。朱和等以大鼠子宫收缩面积(UCA)为指标，用消炎痛与氯丙嗪等作阻断剂，分析了牛膝总皂甙(ABS)对大鼠离体子宫兴奋作用的机理。实验结果表明，实验前大鼠用消炎痛(75mg/只灌胃或浴槽内加消炎痛20ug/ml)，均可明显减弱ABS对大鼠离体子宫的兴奋作用。前列腺素E2200mg/ml可明显增强ABS兴奋大鼠子宫作用。氯丙嗪0.5mg/ml也可明显减弱ABS对已孕、未孕大鼠子宫的兴奋作用，而阿托品10ug/ml对ABS所致大鼠子宫兴奋无明显作用。提示ABS所致大鼠子宫兴奋无明显作用。提示ABS兴奋大鼠子宫可能与促进前列腺素及5一HT释放有关。"}]},{"ID":"20240607095500-1fyy9tn","Type":"NodeParagraph","Properties":{"id":"20240607095500-1fyy9tn","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"6.抗生育作用：6.1.怀牛膝总皂甙(ABS)对大白鼠抗生育及堕胎作用：选用体重200-250g雌性童贞大鼠36只和体重250g以上成熟雄性大鼠18只，合笼饲养2周以上，按文献方法，将雌鼠随机分成3组(每组12只)进行实验，停药后处死雌鼠，剖检子宫，计算各组怀孕百分率，平均活胎、无胎和着床点数。给药组与对照组比较，各项指标无明显差异。堕胎试验取健康雌性大鼠(230-260g)和雄性大鼠(\u003e750g)，以2：1合笼交配。将孕鼠于妊娠d10在乙醚麻醉下进行部腹检查，观察两侧宫角的植入点，缝合。Dl4-dl9给予ABS水溶液，妊娠d20全部处死动物，剖腹检查，结果给药组与对照组比较，胎仔丧失率无明显影响，仅胎仔平均体得明显低于对照组(P\u003c0.01)，亦未见有产出情况。"}]},{"ID":"20240607095500-mkxi9hl","Type":"NodeParagraph","Properties":{"id":"20240607095500-mkxi9hl","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"6.2.ABS对小白鼠抗生育、抗着床的作用：选用健康成年小白鼠，雌鼠体重26-35g，雄鼠体重30-45g，以2：1比例合笼交配，经阴栓检查，将孕鼠随机分成给药组与对照组。给药组与阴栓出现的dl-d10，每日灌胃给药1次，对照组给蒸馏水。阴栓出现dl3时，处死动物，剖检子宫，检查指标同大白鼠抗育实验，结果表明S250mg/kg灌胃10天，呈现一定的抗生育作用，该组平均死胎数，活胎数及着床点数均与对照组有明着差异(P\u003c0.05，当剂量增加500mg/kg或以上时，孕鼠率为零，呈现100%抗生育作用，按文献方法求出ABS抗生育作用的半数有效量218±48mg/kg(P=0.95)。抗着床试验于阴栓出现的dl-5，每日灌胃给药1次，停药6天后处死动物，剖检胎仔。结果经S500mg/kg灌胃后给药组怀孕小鼠的数目明显少于对照组(P\u003c0.05。"}]},{"ID":"20240607095500-m5soptn","Type":"NodeParagraph","Properties":{"id":"20240607095500-m5soptn","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"7.其它作用：促蜕皮甾酮能改善肝功能，降低血浆胆固醇作用，牛膝煎液或醇提取液有轻度利尿及缩短桑蚕龄期的作用。"}]},{"ID":"20240607095500-olsf7ik","Type":"NodeParagraph","Properties":{"id":"20240607095500-olsf7ik","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"蜕皮甾酮的体内过程：用3H一蜕皮甾酮的小鼠实验表明，腹腔注射l0分钟后，放射性强度即于各脏器达到最高水平，随之迅速下降。口服给药时则慢，且肝、血、肾等脏器的量比腹腔注射时为低。不论灌胃或腹腔注射，各脏器中均以肝脏为高。腹腔注射时，放射性活性于粪中或尿中均可迅速出现，口服时则出现较慢，两种途径给药均可见粪中此尿中多，表明破吸收的促蜕皮甾酮主要通过肝胆泌入肠道排泄。"}]},{"ID":"20240607095500-xg38q3m","Type":"NodeParagraph","Properties":{"id":"20240607095500-xg38q3m","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095500-a1npz8p","Type":"NodeParagraph","Properties":{"id":"20240607095500-a1npz8p","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 牛膝：拣去杂质，洗净，润软，去芦，切段，晒干。酒牛膝：取牛膝段，用黄酒喷淋拌匀，闷润后，置锅内炒至微干，取出放凉即得。(牛膝段每100斤，用黄酒10斤)1.《雷公炮炙论》：凡使牛膝，去头并尘土，用黄精自然汁浸一宿，漉出，细锉，焙干用之。"}]},{"ID":"20240607095500-y9cnu4v","Type":"NodeParagraph","Properties":{"id":"20240607095500-y9cnu4v","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：牛膝，今惟以酒浸入药，欲下行则生用，滋补则焙用，或酒拌蒸过用。"}]},{"ID":"20240607095500-z74ek75","Type":"NodeParagraph","Properties":{"id":"20240607095500-z74ek75","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095500-wyk868p","Type":"NodeParagraph","Properties":{"id":"20240607095500-wyk868p","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240607095500-70ba4d7","Type":"NodeParagraph","Properties":{"id":"20240607095500-70ba4d7","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095500-8sxv60w","Type":"NodeParagraph","Properties":{"id":"20240607095500-8sxv60w","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 苦；酸；性平"}]},{"ID":"20240607095500-o815t4j","Type":"NodeParagraph","Properties":{"id":"20240607095500-o815t4j","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095500-ti1ye9u","Type":"NodeParagraph","Properties":{"id":"20240607095500-ti1ye9u","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 凡中气下陷，脾虚泄泻，下元不固，梦遗失精，月经过多，及孕妇均忌服。"}]},{"ID":"20240607095500-al65rxp","Type":"NodeParagraph","Properties":{"id":"20240607095500-al65rxp","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"1.《得配本草》：中气不足，小便自利，俱禁用。"}]},{"ID":"20240607095500-qyj3it7","Type":"NodeParagraph","Properties":{"id":"20240607095500-qyj3it7","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.《品汇精要》：妊妇不可服。"}]},{"ID":"20240607095500-2jckdij","Type":"NodeParagraph","Properties":{"id":"20240607095500-2jckdij","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：经闭未久，疑似有娠者勿用；上焦药中勿入；血崩不止者忌之。"}]},{"ID":"20240607095500-r5qgjss","Type":"NodeParagraph","Properties":{"id":"20240607095500-r5qgjss","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"4.《本草通玄》：梦遗失精者，在所当禁。"}]},{"ID":"20240607095500-7mgg200","Type":"NodeParagraph","Properties":{"id":"20240607095500-7mgg200","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"5.《本草正》：脏寒便滑，下元不固者当忌用之。"}]},{"ID":"20240607095500-vqpn0qx","Type":"NodeParagraph","Properties":{"id":"20240607095500-vqpn0qx","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"6.《药品化义》：若泻痢脾虚而腿膝酸痛不宜用。"}]},{"ID":"20240607095500-b261ywf","Type":"NodeParagraph","Properties":{"id":"20240607095500-b261ywf","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095500-z8mhe2s","Type":"NodeParagraph","Properties":{"id":"20240607095500-z8mhe2s","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 补肝肾；强筋骨；活血通经；引敌国（火）下行；利尿通淋。主腰膝酸痛；下肢痿软；血滞经闭；痛经；产后血瘀腹痛；征瘕；胞衣不下；热淋；血淋；跌打损伤；痈肿恶疮；咽喉肿痛"}]},{"ID":"20240607095500-cerktqu","Type":"NodeParagraph","Properties":{"id":"20240607095500-cerktqu","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095500-3m5jhez","Type":"NodeParagraph","Properties":{"id":"20240607095500-3m5jhez","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-15g；或浸酒；或入丸、散。外用：适量，捣敷；捣汁滴鼻；或研末撒入牙缝。"}]},{"ID":"20240607095500-8fw2jvm","Type":"NodeParagraph","Properties":{"id":"20240607095500-8fw2jvm","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607095500-omitcsi","Type":"NodeParagraph","Properties":{"id":"20240607095500-omitcsi","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 1.牛膝汤(《千金要方》)，用治产儿胞衣不出，令胞烂。2.镇肝熄风汤(《医学衷中参西录》)，主治肝风内动，肝阳上亢，其脉弦长有力，或上盛下虚，头目时常眩晕，或脑中时常作发热，或目胀耳鸣，或心中烦热，或时常噫气，或肢体渐觉不利，或口眼歪斜，或面色如醉，或眩晕至于颠仆，昏不知人，移时始醒，醒后不能复原。3.牛膝散(《太平圣惠方》)用治妇人脚气浮肿，心神烦闷，月经不通。4.疗恶露不多下方(《外台秘要》)，用治产后恶露不多下。5.治鹤膝风方(《本草汇言》)。6.治胎衣不出方(《梅师集验方》)。7.治风湿痹方(《太平圣惠方》)。8.三妙丸(《医学正传》)，用治湿热下注，两脚麻木，或如火烙之热。9.牛膝酒(《本草纲目》)，用治痿痹，补虚损，壮筋骨，除久疟。10.治小便茎痛方(《肘后方》)，用治小便不利，茎中痛欲死，兼治妇人血结腹坚痛。11.万病丸(《三因方》)，用治室女月经不通，脐下坚结，大如杯升，发热往来，下痢赢瘦，此为血瘕。12.治暴症方(《补缺肘后方》)，用治暴症，腹中有物如石，痛如刺，昼夜啼呼。13.取胎方(《药鉴》)，能坠胎。14.治喉痹，乳蛾方(《本草纲目》)。15.治痈溃方(《陈日华经验方》)，用治痈疖已溃。16.治口疮方(《肘后方》)，用治口中及舌上生疮，烂。17.治皮疾方(《千金方》)，用治风瘙隐疹，骨疸，癞病等。18.治金疮痛方(《梅师集验方》)。19.治痨疟方(《千金方》)。20、治痢方(《肘后方》)，用治痢下先赤后白。"}]},{"ID":"20240607095500-9wa0xe6","Type":"NodeParagraph","Properties":{"id":"20240607095500-9wa0xe6","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607095500-bu9mr8f","Type":"NodeParagraph","Properties":{"id":"20240607095500-bu9mr8f","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主寒湿痿痹，四肢拘挛，膝痛不可屈，逐血气，伤热火烂，堕胎。"}]},{"ID":"20240607095500-gjgd89k","Type":"NodeParagraph","Properties":{"id":"20240607095500-gjgd89k","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗伤中少气，男肾阴消，老人失溺，补中续绝，填骨髓，除脑中痛及腰脊痛，妇人月水不通，血结，益精，利阴气，止发白。"}]},{"ID":"20240607095500-pm3vvvo","Type":"NodeParagraph","Properties":{"id":"20240607095500-pm3vvvo","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：治阴痿，补肾填精，逐恶血流结，助十二经脉。"}]},{"ID":"20240607095500-wxg3l3i","Type":"NodeParagraph","Properties":{"id":"20240607095500-wxg3l3i","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：治腰膝软怯冷弱，破症结，排脓止痛，产后心腹痛并血运，落胎，壮阳。"}]},{"ID":"20240607095500-szf14du","Type":"NodeParagraph","Properties":{"id":"20240607095500-szf14du","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"5.《本草衍义》：与苁蓉浸酒服，益肾；竹木刺入肉，捣烂罨之，即出。"}]},{"ID":"20240607095500-jc7zccd","Type":"NodeParagraph","Properties":{"id":"20240607095500-jc7zccd","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"6.张元素：强筋。"}]},{"ID":"20240607095500-58m8g5h","Type":"NodeParagraph","Properties":{"id":"20240607095500-58m8g5h","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"7.《本草衍义补遗》：能引诸药下行。"}]},{"ID":"20240607095500-zfy7iam","Type":"NodeParagraph","Properties":{"id":"20240607095500-zfy7iam","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"8.《滇南本草》：止筋骨疼，强筋舒筋，止腰膝酸麻，破瘀坠胎，散结核，攻瘰疬，退痈疽、疥癞、血风、牛皮癣、脓窠。"}]},{"ID":"20240607095500-78u0jpb","Type":"NodeParagraph","Properties":{"id":"20240607095500-78u0jpb","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"9.《纲目》：治久疟寒热，五淋尿血，茎中痛，下痢，喉痹，口疮，齿痛，痈肿恶疮，伤折。"}]},{"ID":"20240607095500-0kmnnw8","Type":"NodeParagraph","Properties":{"id":"20240607095500-0kmnnw8","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"10.《本草正》：主手足血热痿痹，血燥拘挛，通膀胱涩秘，大肠干结，补髓填精，益阴活血。"}]},{"ID":"20240607095500-1yv2evc","Type":"NodeParagraph","Properties":{"id":"20240607095500-1yv2evc","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"11.《本草备要》：酒蒸则益肝肾，强筋骨，治腰膝骨痛，足痿筋挛，阴痿失溺，久疟，下痢，伤中少气，生用则散恶血，破症结，治心腹诸痛，淋痛尿血，经闭难产，喉痹齿痛，痈疽恶疮。"}]},{"ID":"20240607095500-9huyt78","Type":"NodeParagraph","Properties":{"id":"20240607095500-9huyt78","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"12.朱震亨：牛膝，能引诸药下行，筋骨痛风在下者，宜加用之。"}]},{"ID":"20240607095500-58yf6ej","Type":"NodeParagraph","Properties":{"id":"20240607095500-58yf6ej","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"13.《纲目》：牛膝所主之病，大抵得酒则能补肝肾，生用则能去恶血，二者而已。其治腰膝骨痛、足痿、阴消、失溺、久疟、伤中少气诸病，非取其补肝肾之功欤。其治症瘕、心腹诸痛、痈肿恶疮、金疮折伤、喉齿淋痛、尿血、经候胎产诸病，非取其去恶血之功欤。"}]},{"ID":"20240607095500-2hkvvcf","Type":"NodeParagraph","Properties":{"id":"20240607095500-2hkvvcf","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"14.《本草经疏》：牛膝，走而能补，性善下行，故入肝肾。主寒湿痿痹，四肢拘挛、膝痛不可屈伸者，肝脾肾虚，则寒湿之邪客之而成痹，及病四肢拘挛，膝痛不可屈伸。此药性走而下行，其能逐寒湿而除痹也必矣。盖补肝则筋舒，下行则理膝，行血则痛止。逐血气，犹云能通气滞血凝也。详药性，气当作痹。伤热火烂，血焦枯之病也，血行而活，痛自止矣。入肝行血，故堕胎。伤中少气，男子阴消，老人失溺者，皆肾不足之候也。脑为髓之海，脑不满则空而痛。腰乃肾之腑，脊通髓于脑，肾虚髓少，则腰脊痛；血虚而热，则发白。虚赢劳顿，则伤绝。肝藏血，肾藏精，峻补肝肾，则血足而精满，诸证自瘳矣。血行则月水自通，血结自散。"}]},{"ID":"20240607095500-3x58lyv","Type":"NodeParagraph","Properties":{"id":"20240607095500-3x58lyv","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"15.《本草通玄》：按五淋诸证，极难见效，惟牛膝一两，入乳香少许煎服，连进数剂即安，性主下行，且能滑窍。"}]},{"ID":"20240607095500-ivgqlzz","Type":"NodeParagraph","Properties":{"id":"20240607095500-ivgqlzz","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"16.《药品化义》：牛膝，味甘能补，带涩能敛，兼苦直下，用之入肾。盖肾主闭藏，涩精敛血，引诸药下行。生用则宣，主治癃闭管涩、白浊茎痛、瘀血阻滞、症瘕凝结、妇人经闭、产后恶阻，取其活血下行之功也。酒制熟则补，主治四肢拘挛、腰膝腿痛、骨筋流痛、疟疾燥渴、湿热痿痹、老年失溺，取具补血滋阴之功也。"}]},{"ID":"20240607095500-co127fw","Type":"NodeParagraph","Properties":{"id":"20240607095500-co127fw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"17.《本经逢原》：牛膝，其性虽下行走筋，然滑利之品，精气不固者，终非所宜。得酒蒸则能养筋，生用则去恶血。《外台》以治积久劳疟，《肘后》以治卒暴症疾，《延年》以之下胞衣，《卫生》以之捣罨折伤，梅师以之捣涂金疮，《千金》以之捣敷毒肿，《集验》以之通利溺闭，皆取其性滑利窍、消血解毒之功。虽强阴强筋，而气虚下陷，大便易泄，梦遗泄精，妊娠崩漏俱禁用。惟川产者气味形质，与续断仿佛，庶无精滑之虞。盖肾司闭藏，肝主疏泄。此味专司疏泄，而无固益之功，世俗妄谓益肾，而培养下元药中往往用之，与延盗入室何异。"}]},{"ID":"20240607095500-mq60eel","Type":"NodeParagraph","Properties":{"id":"20240607095500-mq60eel","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"18.《本经续疏》：痿与痹皆筋节间病，而寒湿有已化未化，未化则浸淫筋节为病，已化则熏灼筋节为病。《素问》论痹多病于浸淫，论痿多病于熏灼。牛膝之治此，妙在不必问其已化未化，但执定其病在筋节间痛而不可屈伸者皆能已之。《别录》续增所主，皆融化《本经》之旨而扩充者也。大率强者使柔，槁者使润，上者使下，断者使连，阻者使通，尽抑火令就水，助水令充行之治。"}]},{"ID":"20240607095500-lj76hcw","Type":"NodeParagraph","Properties":{"id":"20240607095500-lj76hcw","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"19.《医学衷中参西录》：牛膝，原为补益之品，而善引气血下注，是以用药欲其下行者，恒以之为引经。故善治肾虚腰疼腿疼，或膝疼不能屈伸，或腿痿不能任地。兼治女子月闭血枯，催生下胎。又善治淋疼，通利小便，此皆其力善下行之效也。然《别录》又谓其除脑中痛，时珍又谓其治口疮齿痛者何也？盖此等证，皆因其气血随火热上升所致，重用牛膝引其气血下行，并能引其浮越之火下行，是以能愈也。愚因悟得此理，用以治脑充血证，伍以赭石、龙骨、牡蛎诸重坠收敛之品，莫不随手奏效，治愈者不胜纪矣。为其性专下注，凡下焦气化不固，一切滑脱诸证皆忌之。"}]},{"ID":"20240607095500-z3raizj","Type":"NodeParagraph","Properties":{"id":"20240607095500-z3raizj","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"20.《本草正义》：牛膝，疏利泄降，所主皆气血壅滞之病，《本经》谓主寒湿，当从《御览》所引作伤寒。其治湿流关节之痿痹，四肢拘挛，膝痛不可屈伸，固疏通壅滞之专职，要非气血枯竭之拘急不遂，可以并论。然凡属痿痹，本有湿阻、血衰两层。湿阻者，惟在驱邪而使之流通，血衰者，亦必滋养而助其营运。则牛膝曲而能达，无微不至，逐邪者，固倚为君，养正者，亦赖以辅佐，所以痿弱痹着，骨痛筋挛诸证，皆不可一日无此也。逐血气者，即所以通其壅滞，治伤热火烂，亦所以助其流通，且即此而可知牛膝之性，偏于寒凉。故能主热伤火伤。则寒湿为病，必非其任，上文之误，更显然矣。能堕胎者，滑利下行之力也。《别录》疗伤中少气，亦以湿热壅窒，中气不宣者言之，非正气不充，清阳下陷者所宜。其主男子阴消，亦主热盛伤阴而言，非能补肝肾之真阴也。老人失溺，盖地道不通，而为癃闭之病，必非下元不固，遗尿溺床之候。其所谓补中续绝填骨髓，益精，利阴气诸说，皆壅滞既疏，正气自旺，万不可误认牛膝为填补之品。脑中痛者，多阳邪之上升，牛膝下行为顺，则气火自潜。腰脊痛，亦经隧之壅滞，牛膝宣通脉络，则关节自利。又主月水不通，血结等证。则固破瘀导滞之真谛，此皆当就疏通一层着想，则牛膝之真实功用昭昭矣。"}]},{"ID":"20240607095500-tdgd0g7","Type":"NodeParagraph","Properties":{"id":"20240607095500-tdgd0g7","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095500-yk3pdp9","Type":"NodeParagraph","Properties":{"id":"20240607095500-yk3pdp9","updated":"20240607095500"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607095501-c6pyizg","Type":"NodeThematicBreak","Properties":{"id":"20240607095501-c6pyizg"}},{"ID":"20240607095502-245ts5l","Type":"NodeParagraph","Properties":{"id":"20240607095502-245ts5l"}}]}