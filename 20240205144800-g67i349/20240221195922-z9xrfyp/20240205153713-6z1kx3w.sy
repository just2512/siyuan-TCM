4","Type":"NodeThematicBreak","Properties":{"id":"20240616151829-77j6b84"}},{"ID":"20240616154003-oyxjfv7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616154003-oyxjfv7","updated":"20240616154008"},"Children":[{"Type":"NodeText","Data":"茜根《神农本草经》"}]},{"ID":"20240616154003-dyfpfee","Type":"NodeParagraph","Properties":{"id":"20240616154003-dyfpfee","updated":"20240616154003"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240616154003-8i7qnhy","Type":"NodeParagraph","Properties":{"id":"20240616154003-8i7qnhy","updated":"20240616154003"},"Children":[{"Type":"NodeText","Data":"主寒湿，风痹，黄疽，补中。生川谷。"}]},{"ID":"20240616154003-hakqxm5","Type":"NodeParagraph","Properties":{"id":"20240616154003-hakqxm5","updated":"20240616154003"},"Children":[{"Type":"NodeText","Data":"《名医》曰：可以染绛，一名地血，一名茹虑，一名茅搜，一名茜，生乔山，二月三月，采根，暴干。"}]},{"ID":"20240616154003-k3efxra","Type":"NodeParagraph","Properties":{"id":"20240616154003-k3efxra","updated":"20240616154003"},"Children":[{"Type":"NodeText","Data":"案《说文》云：茜，茅搜也，搜，茅搜，茹藘，人血所生，可以染绛，从草从鬼；《广雅》云：地血，茹藘，茜也；《尔雅》云：茹藘茅鬼；郭璞云：今茜也，可以染绛；《毛诗》云：茹藘在阪；《传》云：茹藘，茅搜也；陆玑云：一名地血，齐人谓之茜，徐州人谓之牛蔓，徐广注《史记》云：茜一名红蓝，其花染绘，赤黄也，按《名医》别出红蓝条，非。"}]},{"ID":"20240616154015-z6yth7d","Type":"NodeThematicBreak","Properties":{"id":"20240616154015-z6yth7d"}},{"ID":"20240616154016-iem58xp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616154016-iem58xp","updated":"20240616154021"},"Children":[{"Type":"NodeText","Data":"茜根《增广和剂局方药性总论》"}]},{"ID":"20240616154016-nvvf4fr","Type":"NodeParagraph","Properties":{"id":"20240616154016-nvvf4fr","updated":"20240616154016"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主寒湿风痹，黄胆，补中，止血，内崩下血，膀胱不足， 跌，蛊毒，久服益精气。《药性论》云∶主治六极伤心肺，吐血，泻血。日华子云∶止鼻洪，带下，产后血晕，乳结，月经不止，肠风痔 ，排脓，治疮疖，泄精，尿血，扑损瘀血，杀蛊毒。"}]},{"ID":"20240616154016-hv9qmxr","Type":"NodeParagraph","Properties":{"id":"20240616154016-hv9qmxr","updated":"20240616154016"},"Children":[{"Type":"NodeText","Data":"畏∶鼠姑。"}]},{"ID":"20240616154025-c0hy16j","Type":"NodeThematicBreak","Properties":{"id":"20240616154025-c0hy16j"}},{"ID":"20240616154027-lp4rw7u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616154027-lp4rw7u","updated":"20240616154030"},"Children":[{"Type":"NodeText","Data":"茜根《汤液本草》"}]},{"ID":"20240616154027-0b14paq","Type":"NodeParagraph","Properties":{"id":"20240616154027-0b14paq","updated":"20240616154027"},"Children":[{"Type":"NodeText","Data":"味苦，阴中微阳。"}]},{"ID":"20240616154027-kfn36ty","Type":"NodeParagraph","Properties":{"id":"20240616154027-kfn36ty","updated":"20240616154027"},"Children":[{"Type":"NodeText","Data":"《珍》云∶去诸死血。"}]},{"ID":"20240616154027-10l4h71","Type":"NodeParagraph","Properties":{"id":"20240616154027-10l4h71","updated":"20240616154027"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶主治六极伤心肺，吐血、泻血。"}]},{"ID":"20240616154027-ps9iect","Type":"NodeParagraph","Properties":{"id":"20240616154027-ps9iect","updated":"20240616154027"},"Children":[{"Type":"NodeText","Data":"《日华子》云∶止鼻洪，月经不止。"}]},{"ID":"20240616151829-e90x0x0","Type":"NodeThematicBreak","Properties":{"id":"20240616151829-e90x0x0"}},{"ID":"20240616152548-dx1kht8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616152548-dx1kht8","updated":"20240616155043"},"Children":[{"Type":"NodeText","Data":"根《医学入门》"}]},{"ID":"20240616152548-316a9fe","Type":"NodeParagraph","Properties":{"id":"20240616152548-316a9fe","updated":"20240616155058"},"Children":[{"Type":"NodeText","Data":"茜根苦寒清心肺，逐瘀止血及崩带，退黄治痹排脓疮，中蛊作吐称为最。"}]},{"ID":"20240616152548-wxbk523","Type":"NodeParagraph","Properties":{"id":"20240616152548-wxbk523","updated":"20240616152548"},"Children":[{"Type":"NodeText","Data":"茜，鲜也，可以染绛，西地最多。无毒。阴中微阳。主六极损伤，心肺停瘀，吐血、衄血、下血、尿血，崩中带下。月经不止，产后血晕。"}]},{"ID":"20240616152548-p19lnt8","Type":"NodeParagraph","Properties":{"id":"20240616152548-p19lnt8","updated":"20240616152548"},"Children":[{"Type":"NodeText","Data":"又治黄胆、风寒湿痹，排脓，治疮疖痔 、 折扑损瘀血，皆验。中蛊吐如烂肝者，称为最要。兼补中及膀胱不足，止遗泄亦美药也。铜刀锉炒，勿犯铁、铅，畏鼠姑。"}]},{"ID":"20240616152607-myk40xn","Type":"NodeThematicBreak","Properties":{"id":"20240616152607-myk40xn"}},{"ID":"20240616152608-lamrvt7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616152608-lamrvt7","updated":"20240616152616"},"Children":[{"Type":"NodeText","Data":"茜根《千金翼方》"}]},{"ID":"20240616152608-nr5mhrg","Type":"NodeParagraph","Properties":{"id":"20240616152608-nr5mhrg","updated":"20240616152608"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主寒湿风痹，黄胆，补中，止血，内崩下血，膀胱不足， 跌，蛊毒。"}]},{"ID":"20240616152608-x9dhy6l","Type":"NodeParagraph","Properties":{"id":"20240616152608-x9dhy6l","updated":"20240616152608"},"Children":[{"Type":"NodeText","Data":"久服益精气，轻身。可以染绛。一名地血，一名茹 ，一名茅 ，一名 。生乔山川谷，二月三月采根，曝干。"}]},{"ID":"20240616152557-ylcfuo5","Type":"NodeThematicBreak","Properties":{"id":"20240616152557-ylcfuo5"}},{"ID":"20240616152558-s2moly7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616152558-s2moly7","updated":"20240616152602"},"Children":[{"Type":"NodeText","Data":"茜根《名医别录》"}]},{"ID":"20240616152558-6nctni3","Type":"NodeParagraph","Properties":{"id":"20240616152558-6nctni3","updated":"20240616152558"},"Children":[{"Type":"NodeText","Data":"无毒．主止血内崩，下血，膀胱不足， 跌，盅毒．久服益精气，轻身．可以染绛名地血，一名茹 ，一名茅搜，一名茜．生乔山．二月、三月采根，曝干．（畏鼠姑"}]},{"ID":"20240616152558-dllnza8","Type":"NodeParagraph","Properties":{"id":"20240616152558-dllnza8","updated":"20240616152558"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶茜根，味苦，寒．主寒湿风痹，黄胆，补中．生川谷．"}]},{"ID":"20240616152622-8u7wpj1","Type":"NodeThematicBreak","Properties":{"id":"20240616152622-8u7wpj1"}},{"ID":"20240616152623-4dtoxo9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616152623-4dtoxo9","updated":"20240616153952"},"Children":[{"Type":"NodeText","Data":"茜根《证类本草》"}]},{"ID":"20240616152623-z1bklr9","Type":"NodeParagraph","Properties":{"id":"20240616152623-z1bklr9","updated":"20240616152623"},"Children":[{"Type":"NodeText","Data":"味苦，寒。无毒。主寒湿风痹，黄胆，补中，止血，内崩，下血，膀胱不足， 跌，蛊毒。久服益精气，轻身。可以染绛。一名地血，一名茹 ，一名茅搜，一名茜。生乔山川谷。二月、三月采根，曝干。（畏鼠姑。）"}]},{"ID":"20240616152623-87dlvei","Type":"NodeParagraph","Properties":{"id":"20240616152623-87dlvei","updated":"20240616152623"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此则今染绛茜草也。东间诸处乃有而少，不如西多。今俗道、经方不甚服用。"}]},{"ID":"20240616152623-htcuj6c","Type":"NodeParagraph","Properties":{"id":"20240616152623-htcuj6c","updated":"20240616152623"},"Children":[{"Type":"NodeText","Data":"此当以其为疗少而丰贱故也。《诗》云茹 在 者是。臣禹锡等谨按蜀本图经云∶染绯草，叶似枣叶，头尖下阔，茎叶俱涩，四、五叶对生节间，蔓延草木上，根紫赤色。今所在有，八月采根。尔雅云∶茹 ，茅搜。疏引陆机云∶一名地血，齐人谓之茜。徐州人谓之牛蔓。药性论云∶茜根，味甘。主治六极伤心肺，吐血，泻血用之。陈藏器云∶茜根，主蛊，煮汁服之。今之染绯者，字亦作茜。《周礼·庶氏掌》除蛊毒，以嘉草攻之。嘉草、 荷与茜，主蛊为最也。日华子云∶味 。止鼻洪，带下，产后血晕，乳结，月经不止，肠风，痔 ，排脓，治疮疖，泄精，尿血，扑损，瘀血，酒煎服。杀蛊毒，入药锉、炒用。"}]},{"ID":"20240616152623-fww72hd","Type":"NodeParagraph","Properties":{"id":"20240616152623-fww72hd","updated":"20240616152623"},"Children":[{"Type":"NodeText","Data":"图经曰∶茜根，一作茜。生乔山山谷，今近处皆有之。染绯草也。许慎《说文解字》以为人血所生，叶似枣叶而头尖下阔，三、五对生节间，其苗蔓延草木上，根紫色。陆机《草木疏》云∶茹 ，茅搜，茜草也。齐人谓之茜，徐州人谓之牛蔓。二月、三月采根，曝干。今圃人或作畦种莳。故《货殖传》云∶卮茜千石，亦比千乘之家。言地利之浓也。医家用治蛊毒尤胜。《周礼·庶氏掌》除蛊毒，以嘉草攻之。干宝以嘉草为 荷。陈藏器以为 荷与茜，主蛊之最也。"}]},{"ID":"20240616152623-5y7dtod","Type":"NodeParagraph","Properties":{"id":"20240616152623-5y7dtod","updated":"20240616152623"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用赤柳草根，真似茜根，只是味酸涩，不入药中用。若服，令人患内障眼，速服甘草水解之，即毒瓦斯散。凡使茜根，用铜刀于槐砧上锉，日干，勿犯铁并铅。简要济众∶治吐血不定。茜草一两，生捣罗为散。每服二钱，水一中盏，煎至七分，放冷，食后服之良。伤寒类要∶治心瘅烦心，心中热，茜根主之。又方∶治中蛊毒，或吐下血如烂肝。茜草根、荷叶根各三两切，以水四升，煮取二升，去滓适寒温，顿服即愈。"}]},{"ID":"20240616151829-hc9pl28","Type":"NodeThematicBreak","Properties":{"id":"20240616151829-hc9pl28"}},{"ID":"20240616152111-u3i9yzn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616152111-u3i9yzn","updated":"20240616152119"},"Children":[{"Type":"NodeText","Data":"茜根《本草经集注》"}]},{"ID":"20240616152111-wwios19","Type":"NodeParagraph","Properties":{"id":"20240616152111-wwios19","updated":"20240616152111"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主治寒湿风痹，黄疸，补中。止血，内崩，下血，膀胱不足，踒跌，蛊毒。久服益精气，轻身。可以染绛。一名地血，一名茹KT，一名茅搜，一名倩。生乔山川谷。二月、三月采根，曝干。（畏鼠姑。）"}]},{"ID":"20240616152111-hx4k1i2","Type":"NodeParagraph","Properties":{"id":"20240616152111-hx4k1i2","updated":"20240616152111"},"Children":[{"Type":"NodeText","Data":"此则今染绛茜草也。东间诸处乃有而少，不如西多。今世道经方不甚服用。此当以其为治少而丰贱故也。"}]},{"ID":"20240616151829-22nmaxl","Type":"NodeThematicBreak","Properties":{"id":"20240616151829-22nmaxl"}},{"ID":"20240616152054-hta6u22","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616152054-hta6u22","updated":"20240616152100"},"Children":[{"Type":"NodeText","Data":"茜根《本草图经》"}]},{"ID":"20240616152054-58f07sv","Type":"NodeParagraph","Properties":{"id":"20240616152054-58f07sv","updated":"20240616152057"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"茜根"},{"Type":"NodeText","Data":"，一作 ，生乔山川谷，今近处皆有之，染绯草也。许慎《说文解字》以为人血所生，叶似枣叶而头尖下阔，三、五对生节间，其苗蔓延草木上，根紫色。陆机《草木疏》云∶茹，茅 ， 草也。齐人谓之茜，徐州人谓之牛蔓。二月、三月采根，曝干。今圃人或作畦种莳。故《货殖传》云∶ 茜千石，亦比千乘之家。言地利之浓也。医家用治蛊毒尤胜。《周礼》庶氏掌除蛊毒，以嘉草攻之。干宝以嘉草为 荷。陈藏器以为 荷与茜，主蛊之最也。"}]},{"ID":"20240616154444-6b0gmgu","Type":"NodeThematicBreak","Properties":{"id":"20240616154444-6b0gmgu"}},{"ID":"20240616154445-m4zv6jp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616154445-m4zv6jp","updated":"20240616154451"},"Children":[{"Type":"NodeText","Data":"茜草根《本草崇原》"}]},{"ID":"20240616154445-nktigl2","Type":"NodeParagraph","Properties":{"id":"20240616154445-nktigl2","updated":"20240616154445"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治寒湿风痹、黄胆、补中。《别录》云∶治蛊毒，久服益精气，轻身。"}]},{"ID":"20240616154445-drp5wey","Type":"NodeParagraph","Properties":{"id":"20240616154445-drp5wey","updated":"20240616154445"},"Children":[{"Type":"NodeText","Data":"（茜草《诗》名茹 ，《别录》名地血，一名染绯草，又名过山龙，一名西天王草，又名风车草。始出乔山山谷及山阴谷中，东间诸处虽有而少，不如西间之多，故字从西。十二月生苗，蔓延数尺，方茎中空有筋，外有细刺，数寸一节，每节五叶，七八月开花，结实如小椒，中有细黑子，其根赤色。《周礼》庶氏掌除蛊毒，以嘉草攻之，嘉草者，襄荷与茜也。"}]},{"ID":"20240616154445-kd8chvd","Type":"NodeParagraph","Properties":{"id":"20240616154445-kd8chvd","updated":"20240616154445"},"Children":[{"Type":"NodeText","Data":"主茜草发于季冬，根赤子黑，气味苦寒，禀少阴水火之气化。方茎五叶，外有细刺，又禀阳明金土之气化。主治寒湿风痹者，禀少阴火气而散寒，阳明燥气而除湿，阳明金气而制风也。"}]},{"ID":"20240616154445-l9lgynu","Type":"NodeParagraph","Properties":{"id":"20240616154445-l9lgynu","updated":"20240616154445"},"Children":[{"Type":"NodeText","Data":"得少阴之水化，故清黄胆。《周礼》主除蛊毒，故补中，中土调和，则蛊毒自无矣。《素问》治气竭肝伤，血枯经闭，故久服益精气，轻身。"}]},{"ID":"20240616154445-cuadw7v","Type":"NodeParagraph","Properties":{"id":"20240616154445-cuadw7v","updated":"20240616154445"},"Children":[{"Type":"NodeText","Data":"《素问·腹中论》岐伯曰∶病名血枯者，此得之年少时，有所大脱血，若醉入房中，气竭肝伤，故月事衰少不来。帝曰∶治以何术？岐伯曰∶以四乌贼骨，一 茹，二物并合之，丸以雀卵，大如小豆，以五丸为后饭，饮以鲍鱼汁，利肠中及伤肝也。 茹当作茹 ，即茜草也。《本经》下品中有 茹。李时珍引《素问》乌贼骨 茹方注解云∶《素问》 茹，当作茹而与 音同字异也。愚谓∶乌贼骨方，当是茜草之茹 ，非下品之 茹也。恐后人疑而未决，故表正之。"}]},{"ID":"20240616155118-infpc9b","Type":"NodeThematicBreak","Properties":{"id":"20240616155118-infpc9b"}},{"ID":"20240616155119-nc4eg56","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155119-nc4eg56","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"茜草《本草纲目》"}]},{"ID":"20240616155119-z74ld3p","Type":"NodeParagraph","Properties":{"id":"20240616155119-z74ld3p","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"「释名」茅搜、茹芦、地血、染绯草、血见悉、风车草、过山龙、牛蔓。"}]},{"ID":"20240616155119-vmzhwql","Type":"NodeParagraph","Properties":{"id":"20240616155119-vmzhwql","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240616155119-3uvaswu","Type":"NodeParagraph","Properties":{"id":"20240616155119-3uvaswu","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616155119-zkdlhd7","Type":"NodeParagraph","Properties":{"id":"20240616155119-zkdlhd7","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"1、吐血。用茜根一两，捣成末。每服二钱，水煎，冷却，用水调末二钱服亦可。"}]},{"ID":"20240616155119-faombqc","Type":"NodeParagraph","Properties":{"id":"20240616155119-faombqc","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"2、妇女经闭。用茜根一两，煎酒服。"}]},{"ID":"20240616155119-uklilmm","Type":"NodeParagraph","Properties":{"id":"20240616155119-uklilmm","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"3、盅毒（吐血、下血如猪肝）用茜草根、蓑荷叶各三分，加水四升，煮成二升服。"}]},{"ID":"20240616155119-02ewx6m","Type":"NodeParagraph","Properties":{"id":"20240616155119-02ewx6m","updated":"20240616155119"},"Children":[{"Type":"NodeText","Data":"4、脱肛。用茜根、石榴皮各一把，加酒一碗，煎至七成，温服。"}]},{"ID":"20240616155211-pp7pfop","Type":"NodeThematicBreak","Properties":{"id":"20240616155211-pp7pfop"}},{"ID":"20240616155213-05e9h34","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155213-05e9h34","updated":"20240616155220"},"Children":[{"Type":"NodeText","Data":"茜草《神农本草经读》"}]},{"ID":"20240616155213-y5cnxmo","Type":"NodeParagraph","Properties":{"id":"20240616155213-y5cnxmo","updated":"20240616155213"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主寒湿风痹，黄胆，补中。"}]},{"ID":"20240616155213-k3i8hpv","Type":"NodeParagraph","Properties":{"id":"20240616155213-k3i8hpv","updated":"20240616155213"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶气味苦寒者，得少阴之气化也。风寒湿三气合而为痹，而此能入足少阴，俾上下交通而旋转，则痹自愈矣。上下交通则中土自和，斯有补中之效矣。中土和则湿热之气自化，而黄胆愈矣。又《素问》以芦茹一两，乌鱼骨四两，丸以雀卵，饮以鲍鱼汁，治气竭肝伤、脱血、血枯，妇人血枯经闭，丈夫阴痿精伤，名曰四乌骨一芦茹丸。芦茹即茜草也，亦取其入少阴以生血，补中宫以统血。汁可染绛，似血而能行血欤。（后人以此三味入乌骨白丝毛鸡腹内，以陈酒、童便、煮烂，烘干为丸。以百劳水下五七十丸，治妇人倒经血溢于上、男子咳嗽吐血、左手关脉弦，背上畏寒有淤血者。）"}]},{"ID":"20240616155119-topm2a7","Type":"NodeThematicBreak","Properties":{"id":"20240616155119-topm2a7","updated":"20240616155119"}},{"ID":"20240616155138-hqj7db0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155138-hqj7db0","updated":"20240616155145"},"Children":[{"Type":"NodeText","Data":"茜草《本草纲目》"}]},{"ID":"20240616155138-qc8br6u","Type":"NodeParagraph","Properties":{"id":"20240616155138-qc8br6u","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"「释名」茅搜、茹芦、地血、染绯草、血见悉、风车草、过山龙、牛蔓。"}]},{"ID":"20240616155138-196euh3","Type":"NodeParagraph","Properties":{"id":"20240616155138-196euh3","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240616155138-wufmvo5","Type":"NodeParagraph","Properties":{"id":"20240616155138-wufmvo5","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616155138-l9qq7u2","Type":"NodeParagraph","Properties":{"id":"20240616155138-l9qq7u2","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"1、吐血。用茜根一两，捣成末。每服二钱，水煎，冷却，用水调末二钱服亦可。"}]},{"ID":"20240616155138-y6hq8zi","Type":"NodeParagraph","Properties":{"id":"20240616155138-y6hq8zi","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"2、妇女经闭。用茜根一两，煎酒服。"}]},{"ID":"20240616155138-oh8kaeq","Type":"NodeParagraph","Properties":{"id":"20240616155138-oh8kaeq","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"3、盅毒（吐血、下血如猪肝）用茜草根、蓑荷叶各三分，加水四升，煮成二升服。"}]},{"ID":"20240616155138-0hek2kg","Type":"NodeParagraph","Properties":{"id":"20240616155138-0hek2kg","updated":"20240616155138"},"Children":[{"Type":"NodeText","Data":"4、脱肛。用茜根、石榴皮各一把，加酒一碗，煎至七成，温服。"}]},{"ID":"20240616155225-evnskp5","Type":"NodeThematicBreak","Properties":{"id":"20240616155225-evnskp5"}},{"ID":"20240616155227-0v79sjn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155227-0v79sjn","updated":"20240616155230"},"Children":[{"Type":"NodeText","Data":"茜草《要药分剂》"}]},{"ID":"20240616155227-tjfatgb","Type":"NodeParagraph","Properties":{"id":"20240616155227-tjfatgb","updated":"20240616155227"},"Children":[{"Type":"NodeText","Data":"别名血见愁。味酸咸。性寒。无毒。禀土水之气。兼得天令少阳之气以生。可升可降。阴中阴也。"}]},{"ID":"20240616155227-ogh1mzm","Type":"NodeParagraph","Properties":{"id":"20240616155227-ogh1mzm","updated":"20240616155227"},"Children":[{"Type":"NodeText","Data":"【主治】主寒湿风痹。黄胆。补中。（本经）止血内崩下血。膀胱不足。跌蛊毒。可以染绛产后血。（【归经】入心肝肾心包四经。为凉血行血之品。（兼通剂肝心包血分药凉无病之血行已伤【前论】士瀛曰。色赤入营。气温行滞。味酸入肝。兼咸走血。专于行血活血。俗方治女子治。"}]},{"ID":"20240616155227-r1fmbte","Type":"NodeParagraph","Properties":{"id":"20240616155227-r1fmbte","updated":"20240616155227"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。病患虽见血症。若加泄泻。饮食不进者。忌。"}]},{"ID":"20240616155301-pc7e90q","Type":"NodeThematicBreak","Properties":{"id":"20240616155301-pc7e90q"}},{"ID":"20240616155303-ggnuy67","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155303-ggnuy67","updated":"20240616155307"},"Children":[{"Type":"NodeText","Data":"茜草《本经逢原》"}]},{"ID":"20240616155303-addh1v3","Type":"NodeParagraph","Properties":{"id":"20240616155303-addh1v3","updated":"20240616155335"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《素问》名藘茹，又名茹藘 ，俗名血见愁"}]},{"ID":"20240616155303-073c51f","Type":"NodeParagraph","Properties":{"id":"20240616155303-073c51f","updated":"20240616155303"},"Children":[{"Type":"NodeText","Data":"苦辛微温，无毒。"}]},{"ID":"20240616155303-95rakal","Type":"NodeParagraph","Properties":{"id":"20240616155303-95rakal","updated":"20240616155303"},"Children":[{"Type":"NodeText","Data":"《本经》主寒湿风痹，黄瘅，补中。"}]},{"ID":"20240616155303-quimvh0","Type":"NodeParagraph","Properties":{"id":"20240616155303-quimvh0","updated":"20240616155303"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"茜根色赤而性温，味苦而带辛，色赤入营，性温行滞，味辛入肝，手足厥阴血分药也。《本经》又以治寒湿风痹黄瘅者，是湿热之邪痹着营分，用以清理邪湿则脾胃健运，寒湿风痹无所留着而黄瘅自除矣。其治女子经水不通甚效。详《素问》四乌 一 茹丸，治妇人脱血、血枯。《千金翼》治内崩下血，皆取以散经中瘀积也。病患虽见血证，若泄泻饮食不进者勿服。"}]},{"ID":"20240616155904-ev80tm6","Type":"NodeThematicBreak","Properties":{"id":"20240616155904-ev80tm6"}},{"ID":"20240616155906-5bf8h7d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155906-5bf8h7d","updated":"20240616155911"},"Children":[{"Type":"NodeText","Data":"茜草《本草简要方》"}]},{"ID":"20240616155906-2qag5j0","Type":"NodeParagraph","Properties":{"id":"20240616155906-2qag5j0","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"主治吐血。泻血。产后血晕。扑损瘀血。功能活血。行血。止血。治骨节风痛黄胆人血崩。下血。月经不止。茜根散。茜根地榆生干地当归（微炒）犀角（屑）黄芩各一两。"}]},{"ID":"20240616155906-6b5whvc","Type":"NodeParagraph","Properties":{"id":"20240616155906-6b5whvc","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"栀仁五钱。黄连（微炒）二两。咀。每服四钱。水一中盏。加豆豉五十粒。葱白七寸。煎至分。去滓。不拘时温服。治血痢烦热腹痛不思饮食。又方。茜根升麻犀角（屑）地榆（锉）黄芩黄连（炒）各一两研末。每服四钱。水一中盏煎至六分。去滓。不拘时温服。治蛊注鸡肝色。体热心胀烦闷。茜根汤四物汤加茜根二钱五分。（忌铁）香附一钱五分（童便浸）水煎服治吐血咯血呕血等症。二三服愈。（附）四物汤。熟地（血热用生地）当归身（大便不炒）各三钱。白芍（泄泻腹痛桂酒炒。失血醋炒）二钱。川芎（血逆童便浸）一钱五分。研末临卧温服。治失血体弱。或血虚发热。或痈疽溃后。晡热作渴。及妇人月经不调。腹脐痛。"}]},{"ID":"20240616155906-zt2lpu6","Type":"NodeParagraph","Properties":{"id":"20240616155906-zt2lpu6","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"或崩中漏下。或胎前腹痛下血。产后血块不散。恶露不止。凡属血亏之病皆可治。春加防风。"}]},{"ID":"20240616155906-d849p03","Type":"NodeParagraph","Properties":{"id":"20240616155906-d849p03","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"倍川芎。夏加黄芩倍芍药。秋加天门冬倍地黄冬加桂枝。倍当归亡血过多。恶露吴茱萸。血虚腹痛。微汗恶风者。加肉桂。头风眩晕者。加秦艽羌活气分虚弱加浓朴陈皮。气不足加参。发热烦躁不能睡卧者加黄连栀子。虚寒脉微自汗。"}]},{"ID":"20240616155906-rpb42on","Type":"NodeParagraph","Properties":{"id":"20240616155906-rpb42on","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"便者。加干姜附子。中湿身重肌凉微汗者。加白术茯苓。妇人肢节骨痛及头痛脉强。憎寒如疟者。加秦艽羌活。气血虚者。眩晕者。加羌活防风。血气上冲。心腹胁下满闷者。加木香槟榔。脐下虚冷腹痛。及腰脊间闷痛。或小腹痛者。"}]},{"ID":"20240616155906-wvqjt8e","Type":"NodeParagraph","Properties":{"id":"20240616155906-wvqjt8e","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"痛不可忍者。去地黄。加干姜。补下元加干姜甘草。"}]},{"ID":"20240616155906-btg9jk8","Type":"NodeParagraph","Properties":{"id":"20240616155906-btg9jk8","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"恶物不下者。倍当归芍药。腹痛作声经行不畅者。倍熟地加桂心半倍。经行腰腹背皆痛者。"}]},{"ID":"20240616155906-y2kdh6o","Type":"NodeParagraph","Properties":{"id":"20240616155906-y2kdh6o","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"加芸苔牛膝红花吴茱萸甘草。用银器煎汤热服而色和者。加熟地当归。经水暴下者。加黄芩。腹痛加黄连经水如黑豆汁者加黄芩黄连。经水过多别无他证者。加桂百草霜藕节败棕灰肉豆蔻当归木香龙骨白术茯苓地榆经水适来适断或有寒热往来者。先服小柴胡汤。去其寒热。再服此汤。如寒热不退勿服。血崩者加生地蒲黄。补血止崩加百草霜棕灰首绵灰蒲黄（炒）龙骨白姜。经水成片者。加生地藕节。经黑成片者。加人参白术。血脏虚冷崩中失血过多者。加阿胶艾叶。经水不调。哎遂心胀者。加陈艾黄。赤白带下者。加桂枝香附。"}]},{"ID":"20240616155906-15j7cml","Type":"NodeParagraph","Properties":{"id":"20240616155906-15j7cml","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"白淫白浊者。加龙骨地黄当归。五色浊者。与麝香同研好酒下。鲜血者。温酒或盐汤下。带下者加肉桂蒲黄百草霜甘草黑豆白术玄胡索白姜龙骨。空腹盐或酒调下。经血积滞者。加蓬莪术京三棱肉桂红花。经闭者。加木之属。陈酒水同煎。血寒加甘草乌梅柴胡桃柳枝。闭久者加肉桂甘草黄生姜大枣。血气不调者。加吴茱萸甘草。虚热病者。与参苏饮相合服。潮热者加黄芩地骨皮柴胡。虚热口干者。加麦冬黄芩。虚而口渴者加人参干葛乌梅栝蒌根。虚而多汗者。加牡蛎（）麻黄根。"}]},{"ID":"20240616155906-dj29phb","Type":"NodeParagraph","Properties":{"id":"20240616155906-dj29phb","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"虚寒潮热者加柴胡地骨皮白术茯苓甘草秦艽知母黄芩麦芽人参乌梅大枣。大便燥急者。宜与调胃承气汤各半煎服。气血俱虚者。宜与四君子汤各半煎服。有热加黄芩。妊娠加缩砂仁。因热生风者。加川大黄荜茇乳香防风荆芥地龙南星苈紫苏藿香地黄空心服芎白芷蒲黄（炒）阿胶者加白术人参呕吐不止者。加藿香白术人参。呕逆饮食不入者。加白术丁香甘草人参益智仁胡椒。咳嗽者加桑白皮半夏人参生姜北五味子甘草。感风寒嗽。加款冬花知母阿胶半夏麻黄甘草马兜铃黄芩杏仁柴胡生姜诃子乌梅。发寒热者。加干姜丹皮柴胡。寒热往来。加干姜丹皮。"}]},{"ID":"20240616155906-9nq4c29","Type":"NodeParagraph","Properties":{"id":"20240616155906-9nq4c29","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"虚眩肢倦经水不通加生姜薄荷。大渴加知母石膏。水停心下微吐逆者。加猪苓茯苓防己。心腹胀满者。加枳壳青皮。虚汗加麻黄根。汗多加浮麦。肠胃有风。大便有血。肢寒腹胀者。"}]},{"ID":"20240616155906-6f7vy84","Type":"NodeParagraph","Properties":{"id":"20240616155906-6f7vy84","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"加槐花枳壳漏芦荆芥木香白鸡冠花槐角。或再加地榆石楠叶。分二服。半煎服。半为散空腹盐汤陈酒调下。鼻衄吐头昏项强加人参黄芩有湿者与白术各半。加天麻茯苓穿山甲酒煎服。老人风秘。加青皮。有疮疾者加荆芥酒煎常服。乳痈加连翘慈菇子红荷清茶。有风者。加防风黄芩。风疮赤肿。加荆芥牛蒡子何首乌甘草防风羌活地黄。盐酒煎服。脚肿加大腹皮赤小豆茯苓皮生姜皮。妇人伤寒汗下后饮食减少。血虚者。加黄白术茯苓甘草。妊娠伤寒中风表虚自汗。头痛项强。身热恶寒脉浮而弱者。加桂枝地骨皮。伤寒中风湿之气。肢节烦疼。脉浮紧者。加麻黄细辛。中风湿之气肢节烦疼脉浮苍术。伤寒下后过经不愈。发斑如锦纹者。加升麻连翘。伤寒胸胁满痛头昏项强者。加柴胡黄芩。伤寒大便硬小便赤。气满而脉沉数者。加大黄桃仁。（麸炒）汗下后咳嗽不止。加人参五味子。汗下后不得眠。加栀子黄芩。虚痞胀满。加浓朴枳实。（麸炒）伤寒身热大渴蒸蒸而烦。脉长大者。加石膏。知母。伤寒小便不利加茯苓泽泻。伤寒小便赤如血状者。加琥珀茯苓。伤寒汗下后血漏不止。胎气损者。加阿胶艾叶。伤寒四肢拘急身凉微迟者。加附子桂。伤寒蓄血症。加生地大黄。（酒浸）胎动及漏胎下血者。加阿胶大艾甘草蒲黄。（炒）若下血不止。加艾叶五七片。葱白阿胶黄减四味之半。当归将本方药品均锉细。加熟艾（鸡子大）一团。阿胶五七片。水四盏煎至二盏半。去滓分四服。"}]},{"ID":"20240616155906-1yvn3m3","Type":"NodeParagraph","Properties":{"id":"20240616155906-1yvn3m3","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"一日尽。或加粉草干姜黄。日二三服。至二腊为度。胎前产后气虚。血海不调。或血痢不止。"}]},{"ID":"20240616155906-ula6ndy","Type":"NodeParagraph","Properties":{"id":"20240616155906-ula6ndy","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"腹痛难忍者。加阿胶艾叶。妊娠小肠气痛者加木香茴香。妊娠咳嗽兜铃半夏木通葶苈人参苦桔梗麦冬。胎气冲肝。腰脚痹痛。行步芥地黄羌活独活山栀甘草灯心。空腹服。妊娠心烦。加竹茹。有败血者。用当归易赤芍生地。"}]},{"ID":"20240616155906-bzz2lf4","Type":"NodeParagraph","Properties":{"id":"20240616155906-bzz2lf4","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"妊娠恶心面青憔悴。不思饮食。加陈皮枳壳白术茯苓甘草。损胎下加黄芩荆芥生地赤芍生姜。临产小腹紧痛。加红花滑石甘草灯心葵子。产后恶露腹痛。加桃仁苏木牛膝。血块攻肠。加没药艾叶。好酒煎。产后补血海治诸疾加生姜血停留。或胀或痛胸膈痞闷。或发寒热。四肢疼痛。加玄胡索没药白芷。研末淡醋汤或酒调下。产后血风乘虚发动。或产后伤风头疼发热。百节痛加荆芥穗天麻香附石痛者。加石膏甘草。产后虚劳日久。脉浮疾者。与小柴胡汤合用。产后虚惫发热烦闷者。加生地。产后腹胀。加枳壳肉桂。产后寒热往来。加柴胡麦冬。产后败血筑心。加地骨皮芍药。"}]},{"ID":"20240616155906-peubvi6","Type":"NodeParagraph","Properties":{"id":"20240616155906-peubvi6","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"产后潮热。加白术柴胡甘草丹皮地骨皮。产后病眼。加细辛羌活荆芥菊花甘决明。产后浮肿气急腹大喉中水鸡声。加丹皮荆芥白术桑白皮赤小豆大腹皮杏仁半夏马兜铃生姜葱白薄荷。产后失音不语。加诃子人参沙蜜百药煎。产后闷乱加茯神远志。胎后风。加乳香龙骨茱萸木香肉桂苍术丹皮白薇人参甘草泽兰大椒茴香。研末蜜丸。木瓜酒下。"}]},{"ID":"20240616155906-p136tfa","Type":"NodeParagraph","Properties":{"id":"20240616155906-p136tfa","updated":"20240616155906"},"Children":[{"Type":"NodeText","Data":"产后体虚四肢黄加甘草丹皮泽兰白薇苍术桂心茴香。研末蜜丸。盐汤或酒下。"}]},{"ID":"20240616155249-pz4lnul","Type":"NodeThematicBreak","Properties":{"id":"20240616155249-pz4lnul"}},{"ID":"20240616155250-a28zjpt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155250-a28zjpt","updated":"20240616155254"},"Children":[{"Type":"NodeText","Data":"茜草《得配本草》"}]},{"ID":"20240616155250-wfcueox","Type":"NodeParagraph","Properties":{"id":"20240616155250-wfcueox","updated":"20240616155250"},"Children":[{"Type":"NodeText","Data":"畏鼠姑。制雄黄。"}]},{"ID":"20240616155250-yo23k0x","Type":"NodeParagraph","Properties":{"id":"20240616155250-yo23k0x","updated":"20240616155250"},"Children":[{"Type":"NodeText","Data":"苦，凉。入足厥阴经血分。行血通经。除霉毒，疗乳痈。配黑豆、炙甘草，煮，治血渴。"}]},{"ID":"20240616155250-y13emfp","Type":"NodeParagraph","Properties":{"id":"20240616155250-y13emfp","updated":"20240616155250"},"Children":[{"Type":"NodeText","Data":"配石榴皮，治脱肛。佐乌梅、生地，治鼻衄不止。佐阿胶、侧柏，疗妇人败血。勿犯铅、铁器。"}]},{"ID":"20240616155250-jq0kg51","Type":"NodeParagraph","Properties":{"id":"20240616155250-jq0kg51","updated":"20240616155250"},"Children":[{"Type":"NodeText","Data":"酒炒，行血。童便炒，止血。血虚吐衄，泄泻不食，二者禁用。"}]},{"ID":"20240616155238-zrv5yld","Type":"NodeThematicBreak","Properties":{"id":"20240616155238-zrv5yld"}},{"ID":"20240616155239-deucpbw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155239-deucpbw","updated":"20240616155245"},"Children":[{"Type":"NodeText","Data":"茜草《冯氏锦囊秘录》"}]},{"ID":"20240616155239-jqw1dk2","Type":"NodeParagraph","Properties":{"id":"20240616155239-jqw1dk2","updated":"20240616155239"},"Children":[{"Type":"NodeText","Data":"禀土与水之气，兼得天令少阳之气以生，故味苦寒、微酸咸，无毒。入足厥阴、手足少阴，行血凉血之要药也。"}]},{"ID":"20240616155239-gsbuklw","Type":"NodeParagraph","Properties":{"id":"20240616155239-gsbuklw","updated":"20240616155239"},"Children":[{"Type":"NodeText","Data":"茜草疗中多蛊毒，吐下血如烂肝；治跌久损伤，凝积血成瘀块，虚热崩漏不止，劳伤吐衄时来，女子经滞不行，妇人产后血晕。凡诸血痘，并建奇功。除乳结为痈肿，黄体成疸。若虽见血症，而泄泻少食者忌服，盖苦寒能伤胃也。"}]},{"ID":"20240616155239-l80ks32","Type":"NodeParagraph","Properties":{"id":"20240616155239-l80ks32","updated":"20240616155239"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 治痘干陷，和酒常常饮之，盖能凉血行皿故也，虚寒者禁之。"}]},{"ID":"20240616155139-afed5js","Type":"NodeThematicBreak","Properties":{"id":"20240616155139-afed5js"}},{"ID":"20240616155151-0vk6c02","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155151-0vk6c02","updated":"20240616155155"},"Children":[{"Type":"NodeText","Data":"茜草《本草新编》"}]},{"ID":"20240616155151-o86jtso","Type":"NodeParagraph","Properties":{"id":"20240616155151-o86jtso","updated":"20240616155151"},"Children":[{"Type":"NodeText","Data":"茜草，味苦，气寒，阴中微阳，无毒。入胃、脾二经。止下血崩漏，始跌折损伤，散瘀血。"}]},{"ID":"20240616155151-9oytj1w","Type":"NodeParagraph","Properties":{"id":"20240616155151-9oytj1w","updated":"20240616155151"},"Children":[{"Type":"NodeText","Data":"女子经滞不行，妇人产后血晕，体黄成疸，皆能治之。但只行血而不补血，宜同补气之药以行血，不宜同补血之药以散气。至于各书言其能补虚热，且治劳伤后，虚语耳，吾未见其功也。"}]},{"ID":"20240616155151-zp1tq4u","Type":"NodeParagraph","Properties":{"id":"20240616155151-zp1tq4u","updated":"20240616155151"},"Children":[{"Type":"NodeText","Data":"或问茜草色红，何以止血？夫茜草本行血之药，行血而反能止血者，引血之归经耳。当血之逆行也，少拂其性，而其势更逆。茜草之色与血色相同，入之血中，与血相合而同行，遂能引之归经，而相忘其非类，此治法之功也。但既引入于各经，即当以补阴之药继之，则血安而不再沸。否则，血症未尝有不再发者也。"}]},{"ID":"20240616155200-yn5qim8","Type":"NodeThematicBreak","Properties":{"id":"20240616155200-yn5qim8"}},{"ID":"20240616155201-8tgwvif","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616155201-8tgwvif","updated":"20240616155205"},"Children":[{"Type":"NodeText","Data":"茜草《本草备要》"}]},{"ID":"20240616155201-htn6axy","Type":"NodeParagraph","Properties":{"id":"20240616155201-htn6axy","updated":"20240616155201"},"Children":[{"Type":"NodeText","Data":"通，行血"}]},{"ID":"20240616155201-lcfei3a","Type":"NodeParagraph","Properties":{"id":"20240616155201-lcfei3a","updated":"20240616155201"},"Children":[{"Type":"NodeText","Data":"色赤入营，气温行滞，味酸走肝，而咸走血（《本经》苦寒），入厥阴（心包、肝）血分。"}]},{"ID":"20240616155201-1avbamv","Type":"NodeParagraph","Properties":{"id":"20240616155201-1avbamv","updated":"20240616155201"},"Children":[{"Type":"NodeText","Data":"能行血止血（能行故能止。消瘀通经，又能止吐崩尿血），消瘀通经（酒煎一两，通经甚效）。"}]},{"ID":"20240616155201-2u4c31l","Type":"NodeParagraph","Properties":{"id":"20240616155201-2u4c31l","updated":"20240616155201"},"Children":[{"Type":"NodeText","Data":"治风痹黄胆（疸有五∶黄胆、谷疸、酒疸、黄汗疸、女劳疸。此盖蓄血发黄，不专于温热者也。女劳疸必属肾虚，亦不可以湿热例治。当用四物、知、柏壮其水，参、术培其气，随证而加利湿清热药），崩运扑损，痔 疮疖。血少者忌用。根可染绛，忌铁。"}]},{"ID":"20240607125034-evs8h6w","Type":"NodeThematicBreak","Properties":{"id":"20240607125034-evs8h6w"}},{"ID":"20240607125105-bl6vril","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607125105-bl6vril","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"《中国药典》：茜草"}]},{"ID":"20240607125105-jvs4enm","Type":"NodeParagraph","Properties":{"id":"20240607125105-jvs4enm","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607125105-983njbr","Type":"NodeParagraph","Properties":{"id":"20240607125105-983njbr","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" Qiàn Cǎo"}]},{"ID":"20240607125105-z385boq","Type":"NodeParagraph","Properties":{"id":"20240607125105-z385boq","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607125105-vrou7br","Type":"NodeParagraph","Properties":{"id":"20240607125105-vrou7br","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 锯锯藤、拉拉秧、活血草、红茜草、四轮车、挂拉豆、红线草、小血藤、血见愁"}]},{"ID":"20240607125105-q54o00n","Type":"NodeParagraph","Properties":{"id":"20240607125105-q54o00n","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607125105-hmrrmoe","Type":"NodeParagraph","Properties":{"id":"20240607125105-hmrrmoe","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" RADIX RUBIAE"}]},{"ID":"20240607125105-0gvll4c","Type":"NodeParagraph","Properties":{"id":"20240607125105-0gvll4c","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607125105-n3io9y7","Type":"NodeParagraph","Properties":{"id":"20240607125105-n3io9y7","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 本品为茜草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茜草"},{"Type":"NodeText","Data":"Rubia cordifolia L. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去泥沙，干燥。"}]},{"ID":"20240607125105-uch2q70","Type":"NodeParagraph","Properties":{"id":"20240607125105-uch2q70","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607125105-fjjzbao","Type":"NodeParagraph","Properties":{"id":"20240607125105-fjjzbao","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 本品根茎呈结节状，丛生粗细不等的根。根呈圆柱形，略弯曲，长10～25cm，直径0.2～1cm；表面红棕色或暗棕色，具细纵皱纹及少数细根痕；皮部脱落处呈黄红色。质脆，易折断，断面平坦皮部狭，紫红色，木部宽广，浅黄红色，导管孔多数。无臭，味微苦，久嚼刺舌。"}]},{"ID":"20240607125105-ywgkvpj","Type":"NodeParagraph","Properties":{"id":"20240607125105-ywgkvpj","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607125105-gdbb0ha","Type":"NodeParagraph","Properties":{"id":"20240607125105-gdbb0ha","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240607125105-tm63tw2","Type":"NodeParagraph","Properties":{"id":"20240607125105-tm63tw2","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607125105-02ww8o9","Type":"NodeParagraph","Properties":{"id":"20240607125105-02ww8o9","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茜草"},{"Type":"NodeText","Data":"：除去杂质，洗净，润透，切厚片或段，干燥。"}]},{"ID":"20240607125105-ly2m2ed","Type":"NodeParagraph","Properties":{"id":"20240607125105-ly2m2ed","updated":"20240607125105"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茜草炭"},{"Type":"NodeText","Data":"：取茜草片或段，照炒炭法（附录Ⅱ D）炒至表面焦黑色。"}]},{"ID":"20240607125105-42aocp5","Type":"NodeParagraph","Properties":{"id":"20240607125105-42aocp5","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607125105-n7dtolr","Type":"NodeParagraph","Properties":{"id":"20240607125105-n7dtolr","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" （1）本品根横切面：木栓细胞6～12列，含棕色物。皮层薄壁细胞有的含红棕色颗粒。韧皮部细胞较小。形成层不甚明显。木质部占根的主要部分，全部木化，射线不明显。薄壁细胞含草酸钙针晶束。"}]},{"ID":"20240607125105-nupxr61","Type":"NodeParagraph","Properties":{"id":"20240607125105-nupxr61","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.2g，加乙醚5ml,振摇数分钟，滤过。滤液加氢氧化钠试液1ml，振摇，静置使分层，水层显红色；醚层无色，置紫外光灯（365nm）下观察，显天蓝色荧光。"}]},{"ID":"20240607125105-2xacjje","Type":"NodeParagraph","Properties":{"id":"20240607125105-2xacjje","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末0.5g，置锥形瓶中，加甲醇10ml，超声处理30分钟，滤过，滤液浓缩至约1ml，作为供试品溶液。另取茜草对照药材0.5g，同法制成对照药材溶液。再取大叶茜草素对照品，加甲醇制成每1ml含2.5mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述三种溶液各5μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶G薄层板上，以石油醚（60～90℃）-丙酮（4:1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材和对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240607125105-bt10j1t","Type":"NodeParagraph","Properties":{"id":"20240607125105-bt10j1t","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240607125105-kyg4fru","Type":"NodeParagraph","Properties":{"id":"20240607125105-kyg4fru","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240607125105-vm9umg7","Type":"NodeParagraph","Properties":{"id":"20240607125105-vm9umg7","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；甲醇-水-四氢呋喃（310:90:3）为流动相；检测波长为250nm。理论板数按大叶茜草素峰计算应不低于4000。"}]},{"ID":"20240607125105-r81aj39","Type":"NodeParagraph","Properties":{"id":"20240607125105-r81aj39","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取大叶茜草素对照品适量，加甲醇制成每1ml含80μg的溶液，即得。"}]},{"ID":"20240607125105-sk3ctdq","Type":"NodeParagraph","Properties":{"id":"20240607125105-sk3ctdq","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品粉末约0.2g，精密称定，置具塞锥形瓶中，精密加甲醇25ml，称定重量，浸泡过夜，超声处理30分钟，放冷，再称定重量，用甲醇补足减失的重量，摇匀，滤过，取续滤液，即得。"}]},{"ID":"20240607125105-g8qs6eu","Type":"NodeParagraph","Properties":{"id":"20240607125105-g8qs6eu","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取对照品溶液与供试品溶液各5μl，注入液相色谱仪，测定,即得。"}]},{"ID":"20240607125105-c774xa8","Type":"NodeParagraph","Properties":{"id":"20240607125105-c774xa8","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"本品按干燥计算，含大叶茜草素（C17H15O4）不得少于0.40％。"}]},{"ID":"20240607125105-qvahuab","Type":"NodeParagraph","Properties":{"id":"20240607125105-qvahuab","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607125105-dx2obky","Type":"NodeParagraph","Properties":{"id":"20240607125105-dx2obky","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 归肝经。"}]},{"ID":"20240607125105-fc5bous","Type":"NodeParagraph","Properties":{"id":"20240607125105-fc5bous","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607125105-pabgevy","Type":"NodeParagraph","Properties":{"id":"20240607125105-pabgevy","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240607125105-ahy50mu","Type":"NodeParagraph","Properties":{"id":"20240607125105-ahy50mu","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607125105-p6bm5y6","Type":"NodeParagraph","Properties":{"id":"20240607125105-p6bm5y6","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 凉血，止血，祛瘀，通经。用于吐血，衄血，崩漏，外伤出血，经闭瘀阻，关节痹痛，跌扑肿痛。"}]},{"ID":"20240607125105-ihfkoc1","Type":"NodeParagraph","Properties":{"id":"20240607125105-ihfkoc1","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607125105-uifprv6","Type":"NodeParagraph","Properties":{"id":"20240607125105-uifprv6","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 6～9g。"}]},{"ID":"20240607125105-t34u3t3","Type":"NodeParagraph","Properties":{"id":"20240607125105-t34u3t3","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607125105-w30zssu","Type":"NodeParagraph","Properties":{"id":"20240607125105-w30zssu","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607125105-1k342wn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607125105-1k342wn","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：茜草"}]},{"ID":"20240607125105-htr1g28","Type":"NodeParagraph","Properties":{"id":"20240607125105-htr1g28","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607125105-18syriz","Type":"NodeParagraph","Properties":{"id":"20240607125105-18syriz","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" Qiàn Cǎo"}]},{"ID":"20240607125105-kbyjx2c","Type":"NodeParagraph","Properties":{"id":"20240607125105-kbyjx2c","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607125105-twmjla8","Type":"NodeParagraph","Properties":{"id":"20240607125105-twmjla8","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 四轮草、拉拉蔓、小活血、过山藤"}]},{"ID":"20240607125105-kvdhhrl","Type":"NodeParagraph","Properties":{"id":"20240607125105-kvdhhrl","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607125105-h2xdkfy","Type":"NodeParagraph","Properties":{"id":"20240607125105-h2xdkfy","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 为茜草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茜草"},{"Type":"NodeText","Data":"Rubia cordifolia L.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋季采挖，除去泥沙，晒干。"}]},{"ID":"20240607125105-o6zo4sz","Type":"NodeParagraph","Properties":{"id":"20240607125105-o6zo4sz","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607125105-zkfwhe9","Type":"NodeParagraph","Properties":{"id":"20240607125105-zkfwhe9","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 生于山坡岩石旁或沟边草丛中。主产安微、河北、陕西、河南、山东。"}]},{"ID":"20240607125105-iiu99t6","Type":"NodeParagraph","Properties":{"id":"20240607125105-iiu99t6","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607125105-owbxd41","Type":"NodeParagraph","Properties":{"id":"20240607125105-owbxd41","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 多年生攀援草本。茎四棱形，有的沿棱有倒刺。叶4片轮生，其中1对较大而具长柄，卵形或卵状披针形，长2.5"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"6cm或更长，宽1"},{"Type":"NodeText","Data":"3cm或更宽；叶缘和背脉有源小倒刺。聚伞花序顶生或腋生；花小，萼齿不明显，花冠绿色或白色，5裂，有缘毛。果肉质，小形，熟时紫黑色。花果期9~10月。"}]},{"ID":"20240607125105-ewmkoke","Type":"NodeParagraph","Properties":{"id":"20240607125105-ewmkoke","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607125105-28ljwik","Type":"NodeParagraph","Properties":{"id":"20240607125105-28ljwik","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 根茎呈不规则结节状，上侧有茎基，下侧丛生粗细不等的根。根呈圆柱子形，波状弯曲，长工10"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"25cm，直径0.2"},{"Type":"NodeText","Data":"1cm,表面红棕色或暗棕色，具细纵纹及少数细根痕。质脆，断面平坦，皮部紫红色，木部浅黄红色。气微。味微苦。性寒，味苦。"}]},{"ID":"20240607125105-0avc6v1","Type":"NodeParagraph","Properties":{"id":"20240607125105-0avc6v1","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607125105-mxyolh2","Type":"NodeParagraph","Properties":{"id":"20240607125105-mxyolh2","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 根含多种羟基蒽醌衍生物，如茜草素（alizarin）、异茜草素（purpuro-xanthin）、羟基茜草素（purpurin）、伪羟基茜草素（pseudopurpurin）、茜草酸（munjistin）、茜草甙（rubia,ruberythric acid）、大黄素甲醚等，又分离得升白活性成分茜草萘酸甙Ⅰ及Ⅱ，其甙元为茜草萘酸。"}]},{"ID":"20240607125105-pxhbuim","Type":"NodeParagraph","Properties":{"id":"20240607125105-pxhbuim","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607125105-e1ged6m","Type":"NodeParagraph","Properties":{"id":"20240607125105-e1ged6m","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 归肝经。"}]},{"ID":"20240607125105-p7e2i86","Type":"NodeParagraph","Properties":{"id":"20240607125105-p7e2i86","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607125105-qzr6ggi","Type":"NodeParagraph","Properties":{"id":"20240607125105-qzr6ggi","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240607125105-pxva3q7","Type":"NodeParagraph","Properties":{"id":"20240607125105-pxva3q7","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607125105-5o5gn2x","Type":"NodeParagraph","Properties":{"id":"20240607125105-5o5gn2x","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 凉血活血，祛瘀，通经。用于吐血、衄血、崩漏下血、外伤出血、经闭瘀阻、关节痹痛、跌扑肿痛。凉血止血，活血祛瘀：本品止血而不留瘀，用于热证出血、经闭腹痛、跌打损伤。配乌贼骨止血力更强。"}]},{"ID":"20240607125105-bh6l48p","Type":"NodeParagraph","Properties":{"id":"20240607125105-bh6l48p","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607125105-ptzwqjo","Type":"NodeParagraph","Properties":{"id":"20240607125105-ptzwqjo","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 3～9克。行血通经宜生用；止血宜炒炭用。"}]},{"ID":"20240607125105-l7cswhm","Type":"NodeParagraph","Properties":{"id":"20240607125105-l7cswhm","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607125105-p13hdwe","Type":"NodeParagraph","Properties":{"id":"20240607125105-p13hdwe","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 1、吐血。用茜根一两，捣成末。每服二钱，水煎，冷眼，用水调末二钱服亦可。"}]},{"ID":"20240607125105-xre7oo2","Type":"NodeParagraph","Properties":{"id":"20240607125105-xre7oo2","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2、妇女经闭。用茜根一两，煎酒服。"}]},{"ID":"20240607125105-ec1hrqh","Type":"NodeParagraph","Properties":{"id":"20240607125105-ec1hrqh","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"3、盅毒（吐血、下血如猪肝）用茜草根、蓑荷叶各三分，加水四升，煮成二升服。"}]},{"ID":"20240607125105-o0oi75a","Type":"NodeParagraph","Properties":{"id":"20240607125105-o0oi75a","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"4、脱肛。用茜根、石榴皮各一把，加酒一碗，煎至七成，温服。"}]},{"ID":"20240607125105-4qt94nt","Type":"NodeParagraph","Properties":{"id":"20240607125105-4qt94nt","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607125105-8buyuns","Type":"NodeParagraph","Properties":{"id":"20240607125105-8buyuns","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607125105-rj8c5b3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607125105-rj8c5b3","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"《中华本草》：茜草"}]},{"ID":"20240607125105-zwte2to","Type":"NodeParagraph","Properties":{"id":"20240607125105-zwte2to","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607125105-3a0zf33","Type":"NodeParagraph","Properties":{"id":"20240607125105-3a0zf33","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" Qiàn Cǎo"}]},{"ID":"20240607125105-bnun30e","Type":"NodeParagraph","Properties":{"id":"20240607125105-bnun30e","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607125105-hp7gvwt","Type":"NodeParagraph","Properties":{"id":"20240607125105-hp7gvwt","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 茹藘、茹卢本、茅搜、藘茹、搜、茜根、蒨草、地血、牛蔓、芦茹、血见愁、过山龙、地苏木、活血丹、红龙须根、沙茜秧根、五爪龙、满江红、九龙根、红棵子根、拉拉秧子根、小活血龙、土丹参、四方红根子、红茜根、入骨丹、红内消"}]},{"ID":"20240607125105-i0k49iq","Type":"NodeParagraph","Properties":{"id":"20240607125105-i0k49iq","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607125105-zw7l3t2","Type":"NodeParagraph","Properties":{"id":"20240607125105-zw7l3t2","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 《黄帝内经》载有\"四鸟贼骨-藘茹丸\"，这是茜草入药的最早记载。《本经》则载有\"茜根\"，明确了药用部分为根。《别录》指出茜根\"可以染绛……生乔山川谷。\"《本草经集注)云：\"此则今染绛茜草也。东间诸处乃有而少，不如西多。\"《蜀本草》曰：\"染绯草叶似枣叶，头尖下阔，茎叶俱涩，四五叶对生节间，蔓延草本上，根紫赤色。今所在有，八月采根。\"《纲目》谓：\"茜草十二月生苗，蔓延数尺。方"}]},{"ID":"20240607125105-q09scwx","Type":"NodeParagraph","Properties":{"id":"20240607125105-q09scwx","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607125105-tmohnaa","Type":"NodeParagraph","Properties":{"id":"20240607125105-tmohnaa","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 药材基源：为茜草科植物茜草的根。"}]},{"ID":"20240607125105-ie81jqo","Type":"NodeParagraph","Properties":{"id":"20240607125105-ie81jqo","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Rubia cordifolia L.[Rubia akane Nakai]"}]},{"ID":"20240607125105-q7sf4y9","Type":"NodeParagraph","Properties":{"id":"20240607125105-q7sf4y9","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后2-3年，于11月挖取根部，洗净，晒干。"}]},{"ID":"20240607125105-dkxfcnq","Type":"NodeParagraph","Properties":{"id":"20240607125105-dkxfcnq","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607125105-ebrlw81","Type":"NodeParagraph","Properties":{"id":"20240607125105-ebrlw81","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山坡路旁、沟沿、田边、灌丛及林缘。"}]},{"ID":"20240607125105-2bqsmpm","Type":"NodeParagraph","Properties":{"id":"20240607125105-2bqsmpm","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国大部分地区。"}]},{"ID":"20240607125105-52o0432","Type":"NodeParagraph","Properties":{"id":"20240607125105-52o0432","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607125105-1zdv4ix","Type":"NodeParagraph","Properties":{"id":"20240607125105-1zdv4ix","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 茜草，多年生攀援草本。根数条至数十条丛生，外皮紫红色或橙红色。茎四棱形，棱上生多数倒生的小刺。叶四片轮生，具长柄；叶片形状变化较大，卵形、三角状卵形、宽卵形至窄卵形，长2-6cm，宽1-4cm，先端通常急尖，基部心形，上面粗糙，下面沿中脉及叶柄均有倒刺，全缘，基出脉5。聚伞花序圆锥状，腋生及顶生；花小，黄白色，5数；花萼不明显；花冠辐状，直径约4mm，5裂，裂片卵状三角形，先端急尖；雄蕊5，着生在花冠管上；子房下位，2室，无毛。浆果球形，直径5-6mm，红色后转为黑色。花期6-9月，果期8-10月。"}]},{"ID":"20240607125105-egfj0qb","Type":"NodeParagraph","Properties":{"id":"20240607125105-egfj0qb","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607125105-rfyot4y","Type":"NodeParagraph","Properties":{"id":"20240607125105-rfyot4y","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 1．生物学特性：喜温暖湿润气候。适应性较强，南。北各地均可栽培。以肥沃的砂质壤土栽培为宜。"}]},{"ID":"20240607125105-rvlkvte","Type":"NodeParagraph","Properties":{"id":"20240607125105-rvlkvte","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2．栽培技术：用种于、扦插、分株繁殖。"}]},{"ID":"20240607125105-p5scjld","Type":"NodeParagraph","Properties":{"id":"20240607125105-p5scjld","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2．1．种子繁殖：10月种子成熟采收。播种期10月下旬或3月上旬，按行距30-50cm开浅沟，条播，覆土压实。"}]},{"ID":"20240607125105-bx39zuz","Type":"NodeParagraph","Properties":{"id":"20240607125105-bx39zuz","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2．2．扦插繁殖：四川地区在2-3月，选择呈圆形而未枯的老藤，剪成3个节以上约33cm长的插条，在己整好的地上，开1.3m宽的畦，按行株距50cm×33cm开穴，深约15-20cm，每穴插2-3根，插条顶端露出畦面，填土压紧，浇水。"}]},{"ID":"20240607125105-li5x9hz","Type":"NodeParagraph","Properties":{"id":"20240607125105-li5x9hz","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2．3．分株繁殖：11月上旬或3月，将植株根部挖起，剪去粗根入药，留下根茎分切成每丛有芽2-3个，并带有9cm长须根的小段，按行株距35cm×30cm，深20cm开穴，每穴栽种1株，覆土，压实，浇水。"}]},{"ID":"20240607125105-934d4kv","Type":"NodeParagraph","Properties":{"id":"20240607125105-934d4kv","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"3．田间管理：苗高30cm左右，应搭支架以利生长。苗期喜荫，用油菜、玉米间作，生长期注意松上除草、灌溉。施肥要看苗施肥，以防植株徒长，第1年4月下旬追施人畜粪肥，第2年4月施1次追肥，第3、4年可增施磷、钾肥。每年要摘除花轴。"}]},{"ID":"20240607125105-k8f3ii0","Type":"NodeParagraph","Properties":{"id":"20240607125105-k8f3ii0","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"4．病虫害防治：病害有根腐病，6-7月发生，使枝叶调萎，叶片发黄，根部发黑腐烂，逐渐枯死，发病初期，可用2%石灰水或退菌特50%的可湿性粉剂600倍液喷射；褐斑病，7月发生，为害叶部，可用l：1：120波尔多液或代森锌65%可湿性粉剂600倍液喷射。白粉病，可用波美0.5度石硫合剂喷射。虫害有蚜虫。"}]},{"ID":"20240607125105-kxvdcfh","Type":"NodeParagraph","Properties":{"id":"20240607125105-kxvdcfh","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607125105-pgm5rty","Type":"NodeParagraph","Properties":{"id":"20240607125105-pgm5rty","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 性状鉴别：根圆柱形，有的弯曲，完整的老根留有根头。根长10-30cm，直径0.1-0.5cm；表面红棕色，有细纵纹及少数须根痕；皮、木部较易分离，皮部脱落后呈黄红色。质脆，易断，断面平坦，皮部狭，红棕色，木部宽，粉红色，有众多细孔。气微，味微苦。"}]},{"ID":"20240607125105-m4rh2ft","Type":"NodeParagraph","Properties":{"id":"20240607125105-m4rh2ft","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"显微鉴别：根横切面：木栓层为6-10列细胞，细胞扁平，切向延长，有棕色内含物，栓内层为3-6列细胞，部分细胞含草酸钙针晶束，针晶束与根的长轴平行排列。韧皮薄壁细胞亦含针晶束。木质部由导管、管胞、木纤维、木薄壁细胞组成，导管直径20-130μm。木栓层、韧皮部和木质部三者径向宽度之比为1：1：4.5。"}]},{"ID":"20240607125105-bbj0zar","Type":"NodeParagraph","Properties":{"id":"20240607125105-bbj0zar","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607125105-dcay0qa","Type":"NodeParagraph","Properties":{"id":"20240607125105-dcay0qa","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 小鼠灌服茜草根煎剂150g/kg，无死亡发生。羟基茜草素。茜草素对蚯蚓、囊尾蚴、蜗牛等有毒，但对哺乳动物和人等则相对无毒性。小鼠口服茜草双酯淀粉糊200mg无任何毒性反应；腹腔注射油酸乙酯茜草双酯混悬液的半数致死量为3012.4±66.4mg／kg。狗长期毒性结果表明，每日口服茜草双酯5.4g/只，连续90天，未见毒性反应，剂量增至9.6g/只，则出现明显毒性反应，个别动物死亡。 茜草根提取物对沙门菌属伤寒杆菌TA100和TA98有致突变作用，主要由其活性物质蒽醌衍化物光泽定(lucidin)所致。"}]},{"ID":"20240607125105-dxmde7m","Type":"NodeParagraph","Properties":{"id":"20240607125105-dxmde7m","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607125105-k672zxc","Type":"NodeParagraph","Properties":{"id":"20240607125105-k672zxc","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 1．茜草根含蒽醌衍生物：茜草素(alizarin)，羟基茜草素(purpurin)，异茜草素(purpuroxanthine， xanthopurpurin)，1-羟基-2-甲基蒽醌(1-hydrox-2-methy1anthraquinone)，1， 4二羟基-6-甲基蒽醌( 1，4-dihydroxy-6-methylanthraquinone)，去甲虎刺醛(nordamnacanta1)，大黄素甲醚(physcion)，1-羟基 2-甲氧基蒽醌(1-hydroxy-2-methoxyanthraquinone)，1，4二羟基 2-甲基-5-(或8)-甲氧基蒽醌[1，4-dihvdroxy-2-methyl-5(or 8)-methoxyanthraquinone〕，1，3-二甲氧基-2-梭基蒽醌(1，3-dimethoxy-2-carboxyanthraquinone)，1， 3-二羟基-2-甲基蒽醌(1，3－dihydroxy-2-methylanthraquinone， rubiadin)，1， 3-二羟基-2-乙氧基甲基蒽醌(1，3-hydroxy-2-ethoxymethylanthraquinone)，2-甲基-1，3，6.三羟基蒽醌(2-methyl-1，3，6-trihydroxyanthraquinone)，1，4-二羟基-2-乙氧基羰基蒽醌(1，4-dihydroxy-2-carboethoxyanthraquinone)，1-羟基-2-羧基-3-甲氧基蒽醌(1-hydroxy-2-carboxy-3-methoxyanthraquinone)，1-羟基-2-甲基-6(或7)-甲氧基蒽醌[1-hydroxy-2-methyl-6 (or 7)-methoxyanthraquinone]，1，3-二羟基-2-甲氧基甲基蒽醌(1，3-dihydroxy2-methoxymethylanthraquinone)，1-甲氧基-2-甲氧基甲基-3-羟基蒽醌(1-methox-2-methoxymethyl-3-hydroxyanthraquinone)，4-羟基-2-羧基蒽醌(4-hydroxy-2-carbexyanthraquinone)，1，4-二羟基-2-羟甲基蒽醌(1，4-dihydrox-2-hydroxymethylanthraquinone )，1-羟基-2-羟甲基蒽醌(1-hydroxy-2-hydroxymethylanthraqui-none)，3-甲酯基-1-羟基蒽醌(3-carbomethoxy-1-hydroxyan-thraquinone)，1，4-二羟基-2-甲基蒽醌(1，4-dihydrox-2-methy-lanthraquinone)，乌楠醌(tectoquinone)1，2-二羟基蒽醌-2-O-β-D-木糖(1→6)-β-D-葡萄糖甙[1，2-dihydroxyanthraquinone-2-O-β-D-xylosyl(1→6)-β-D-glucoside， ruberythric acid]，1，3，6-三羟基-2-甲基蒽醌-3-0-(6'-O-乙酰基)-α-鼠李糖-(1→2)-β-葡萄糖甙[1，3，6-trihydroxy-2-methylanthraquinone-3-0-(6'-O-acetyl)-α-rhamncoyl-(1→2)-β-glucoside]，1，3，6-三羟基-甲基蒽醌-3-O-α-鼠李洛(1→2)-β-葡萄糖甙甙[1，3，6trihydrox-2-methylanthraquinone-3-O-α-rhamnosyl-(1→2)-β-glucoside]，1，3-二羟基-2-羟甲基蒽醌-3-O-木糖(1→6)-葡萄糖甙[1，3-dihydroxy-2-hy-droxymethylanthraquinone－3-O-xylosyl(1→6)-glucoside， lucidinprimevoroside]，1-乙酰氧基-6-羟基-2-甲基蒽醌-3-O-α-鼠李糖(1→4)-α-葡萄糖甙[1-acetoxyihydroxy-2-methylanthraquinone3-O-α-rhamnosyl(1→4)-α-glucoside]，1，3，6-三羟基-2-甲基蒽醌-3-O-(6'-O-乙酰基)-β-D-葡萄糖甙[1，3，6-trihydroxy-2-methylanthraquinone-3-O-(6'-O-aceiyl)-β-D－g1ucoside]，1，3， 6三羟基-2-甲基蒽醌-3-O-(3'-乙酰基)-α-鼠李糖(1→2)，葡萄糖甙[1，3， 6-trihydroxy-2-methylanthraquinone－3-O-(3'-O-acetyl)-α-rham-nosyl(1→2)glucoside]及异茜草素-3-O-β-D-葡萄糖甙(xanthop-urpurin-3-0-β-D-glucoside)。"}]},{"ID":"20240607125105-vjlb058","Type":"NodeParagraph","Properties":{"id":"20240607125105-vjlb058","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2．萘醌衍生物：大叶茜草素(mollu-gin， rubimaillin)，2-氨基甲酰基-3-甲氧基-1，4-萘醌(2-car-bamoyl-3-methoxy-1，4-naphthoquinone)，2-氨基甲酰基-3-羟基-1，4-萘醌(2-carbamoyL-3-hydroxy-1，4-naphthoquinone)，去氢-α-拉杷醌(dehydro－α-lapachone)，呋喃大叶茜草素(furomol1ugin)，二氢大叶茜草素(dihvdromollugin)，茜草内酯(rubi1ac-tone)，2'-甲氧基大叶茜草素(2'-methoxymollugin)，2'-羟基大叶茜草素(2'-hydroxymollugin)， 1-甲氧基-2'-羟基二氢大叶茜草素(1'-methoxy-2'-hydroxydihydromollugin)，1'，2'-二羟基二氢大叶茜草素(1'，2'-dihydroxydihydromollugin)，2-梭甲基-3-异戊烯基-2，3-环氧-1，4-萘醌(2-carboxymethyL-3-prenyl-2，3-epoxy-1，4-naphthpeuinone)，钩毛茜草聚萘醌(rubioncolin)。"}]},{"ID":"20240607125105-2o3gxhy","Type":"NodeParagraph","Properties":{"id":"20240607125105-2o3gxhy","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"3．萘氢醌衍生物：2-甲酯基-3-异戊烯基-1，4-萘氢醌-双-β-D-葡萄糖甙(2carbomeiboxy-3-prenyl-1，4-naphthohydroqunone-di-β-D-glucoside)，3-甲酯基-2-(3'-羟基)-异戊基-1，4-萘氢醌-1-0-β-D-葡萄糖甙[3-carbomethoxy-2-(3'-hydroxy)-isopentyl-1，4-naphthohydroquinone1-O-β-D-glucoside]等。具抗癌作用的环己肽： RA(rubiaakane)-Ⅰ、Ⅱ、Ⅲ、Ⅳ[14]、Ⅴ、Ⅶ[15]、Ⅵ、Ⅷ[16]、Ⅸ、Ⅹ^[17]、Ⅺ、Ⅻ、ⅩⅢ、ⅩⅣ[18]、ⅩⅤ、ⅩⅥ[19]。"}]},{"ID":"20240607125105-2a3362n","Type":"NodeParagraph","Properties":{"id":"20240607125105-2a3362n","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"4．三萜化合物：黑果茜草萜(ru-biprasin)A、B，茜草阿波醇(rubiarbenol)D，齐墩果酸乙酸酯(oleanolic acid acetate)，齐墩果醛乙酸酯(oleanolic aldehvde ac-etate)；其他：6-甲氧基都桷子甙酸(6-methoxygenipeidicacid)东茛菪素(scopo1eto1， scopo1etin)，脂肪酸(fattyacids)，β-谷甾醇(β-siiosterol)及胡萝卜甙(daucOsterol)等。"}]},{"ID":"20240607125105-zdsl407","Type":"NodeParagraph","Properties":{"id":"20240607125105-zdsl407","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"5．另有报道茜草尚含1.3，6-三羟基-2-甲基蒽醌-3-0-木糖(1→2)-(6'-0-乙酰基)-葡萄糖甙[1，3，6-trihydroxy-2-methylan-thraquinOnes-3-0-xylosyl( l→2)-(6'-0-acetyl)-glucoside〕，茜草萜三醇(rubiatriol)，及右旋-异落叶松脂醇(iso1ariciresin-ol)。"}]},{"ID":"20240607125105-7oulaka","Type":"NodeParagraph","Properties":{"id":"20240607125105-7oulaka","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607125105-pu7e2y8","Type":"NodeParagraph","Properties":{"id":"20240607125105-pu7e2y8","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 1.止血作用：家兔口服适量茜草温浸液2-4小时内，或腹腔注射同种剂量之茜草液后30-60分钟均有明显的促进血液凝固作用。表现为复钙时间、凝血酶原时间及白陶上部分凝血活酶时间缩短。茜草炭口服也能明显缩短小白鼠尾部出血的时间。茜草还能明显地纠正肝素所引起的凝血障碍。家兔口服温浸液后，在体内可部分纠正肝素所致的复钙时间及白陶土部分凝血活酶时间的延长。正常家兔血复钙时间及白陶土部分凝血活酶时间分别为110秒、45秒；单纯注入肝素60分钟后均大于600秒；灌注茜草温浸液(100%50ml)后90mm，再注入肝素60分钟后分别为180秒和64秒。为此，茜草可用于治疗因肝素或肝素样物质过多所致出血疾患。实验研究并证明茜草和鱼精蛋白。甲苯胺蓝均有抗肝素作用，而后两者有纠正丹参的抗凝作用。鱼精蛋白、甲苯胺蓝及茜草对丹参抗凝桔抗的作用结果：正常对照凝血酶凝固时间为9.5秒，12.5%丹参化血浆50.8秒，1%鱼精蛋白缩短34.8秒，而茜草则延长了1.2秒。提示茜草的促凝作用有其特殊性。"}]},{"ID":"20240607125105-oq7l11d","Type":"NodeParagraph","Properties":{"id":"20240607125105-oq7l11d","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2.抗血小板聚集作用：在试管内，大叶茜草素对花生四烯酸(AA)和胶原诱导的家兔血小板聚集有很强的抑制作用，ＩＣ50约为86.6mmol／L，对血小板激活因子(PAF)诱导的聚集也有一定的抑制性。2-甲基-1，3，6-三羟基蒽醌对胶原诱导的血小板聚集有根强抑制作用，对凝血酶。 AA和PAF诱导的作用虽较弱，但仍有显着性。1，3，6.三羟基-2-甲基蒽醌-3-0-(3'-O-乙酰基)-2-鼠李糖(1→2)-葡萄糖甙、异茜草素-3-0-β-D-葡萄糖甙及异茜草素为胶原诱导的血小板聚集的选择性抑制剂。"}]},{"ID":"20240607125105-oesumgw","Type":"NodeParagraph","Properties":{"id":"20240607125105-oesumgw","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"3.升高白细胞作用：茜草的粗提取物具有升高白细胞作用闷。其升高白细胞的有效成分之一为带芳香环的酚羧酸甙，该有效成分的衍生物茜草双酯已有人工合成。茜草双酯对正常小鼠、大的白细胞有升高作用，小鼠：次口服2.5mg/只，给药8小时后白细胞明显升高，给药组为对照组的151.9%(P＜0.05)。犬1次口服200mg/只，给药6小时白细胞明显增加，18-24小时达最高峰，48-72小时逐渐恢复到给药前水平。茜草双酯还有促进小鼠骨髓造血干细胞增殖和分化的作用，防治环磷酰胺所致狗白细胞减少症。"}]},{"ID":"20240607125105-7mx29sm","Type":"NodeParagraph","Properties":{"id":"20240607125105-7mx29sm","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"4.镇咳法痰作用：氨水喷雾引咳法及酚红排泌法，分别证明小鼠口服茜草根煎剂75g/kg，有明显的镇咳和祛痰作用，但加乙醇沉淀后的滤液则无效。"}]},{"ID":"20240607125105-6m25mjd","Type":"NodeParagraph","Properties":{"id":"20240607125105-6m25mjd","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"5.抗菌作用：体外试验表明，茜草根水提取液对金黄色葡萄球菌有一定的抑制作用，对肺炎链球菌、流感杆菌和部分皮肤真菌也有抑制作用。茜草素对金黄色葡萄球菌也有抑制作用。"}]},{"ID":"20240607125105-qlmhgpg","Type":"NodeParagraph","Properties":{"id":"20240607125105-qlmhgpg","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"6.抗癌作用：茜草根所含的环己肽类化合物RA(rubiaakane)-V10mg/kg， RA-Ⅶ4mg/kg腹腔注射，连续5天，对小鼠淋巴细胞白血病P388均有显着疗效。RA-V对小鼠淋巴白血病L1210、MM2乳腺癌；RA-Ⅶ对小鼠L1210、B16黑色素瘤、结肠腺癌Colon38、Lewis肺癌、艾氏癌等有明显的活性。小鼠体内肿瘤试验表明，从茜草根提取的有抗癌活性的单体RC-18，能显着延长P388、L1210和B16的小鼠寿命，但对Lewis肺癌和肉瘤S180无明显抑制作用。RC-18抗瘤谱的实验结果提示， RC-18可能发展成为一种有效的抗癌剂。此外，2-甲氧基碳基-3-异戊烯基-2，3-环氧-1，4.萘醌和二萘氢醌衍生物体外试验，对仓鼠肺(V79)细胞、淋巴白血病(P388)和人鼻咽癌细胞(KB)有抗癌活性。整体试验中对小鼠腹水型S180有效。"}]},{"ID":"20240607125105-r7nt1xc","Type":"NodeParagraph","Properties":{"id":"20240607125105-r7nt1xc","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"7.对尿路结石的作用：20%茜草(R.finctorum L)制剂喂饲小鼠，能防止实验性肾和膀胱结石的形成，尤其对碳酸钙结石的形成有抑制作用。茜草根提取液给大鼠灌服能明显提高尿液稳定性，降低尿石形成的危险性，且有一定的降尿钙作用。"}]},{"ID":"20240607125105-p5gquuj","Type":"NodeParagraph","Properties":{"id":"20240607125105-p5gquuj","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"8.对实验性心肌梗死的治疗作用：持续性结扎大的左冠状动脉前降支，造成人工心肌梗死模型，静注用不同方法分离的茜草提取物茜Ⅰ、茜Ⅱ200mg/kg，每4小时l次，共3次，均有降低S-T段的抬高和缩小心肌梗死范围的作用。其中以茜Ⅱ作用最为明显。茜草提取物的水溶部分给小鼠腹腔注射可明显地增加心肌和脑组织中ATP的含量，对ADP引起的大鼠血小板聚集有解聚作用。对麻醉大的急性心肌缺血有保护作用，使心肌损伤范围减小，损伤程度减轻，能增加冠状动脉流量。"}]},{"ID":"20240607125105-cj47qpp","Type":"NodeParagraph","Properties":{"id":"20240607125105-cj47qpp","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"9.对平滑肌的作用：茜草根煎剂能对抗乙酰胆碱所致的离体兔肠痉挛，有解痉作用。根的水提取物对离体豚鼠子宫有兴奋作用。"}]},{"ID":"20240607125105-gu3povf","Type":"NodeParagraph","Properties":{"id":"20240607125105-gu3povf","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"10.其他作用：茜草根温浸液有扩张蛙践血管的作用。茜草素与芦丁相似，能抑制大鼠皮肤结缔组织的通透性。"}]},{"ID":"20240607125105-oaw8acy","Type":"NodeParagraph","Properties":{"id":"20240607125105-oaw8acy","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607125105-9apipue","Type":"NodeParagraph","Properties":{"id":"20240607125105-9apipue","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 1.茜草(雷公炮炙论)：\"凡使茜草根，用铜刀于槐砧上锉，日干，勿犯铁并铅。\"《简要济众方》：\"生捣罗为散。\"《圣济总录》：\"拣净锉碎。\"现行，取原药材，除去杂质，洗净润透，切厚片或段，干燥，筛去灰屑。生用凉血止血，活血祛瘀。"}]},{"ID":"20240607125105-btpc7wq","Type":"NodeParagraph","Properties":{"id":"20240607125105-btpc7wq","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"2.茜草炭《十药神书》：\"烧灰存性，研极细末，用纸包，碗盖于地上一夕，出火毒。\"现行，取净茜草段或片，置锅内用武火加热，炒至表面焦黑色，内部棕褐色，喷淋清水少许，灭尽火星，取出再炒至水气逸尽，取出，晾干，凉透。炒炭后寒性降低，性变收涩，止血作用增强。"}]},{"ID":"20240607125105-l9703d9","Type":"NodeParagraph","Properties":{"id":"20240607125105-l9703d9","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"3.炒茜草《日华子》：\"入药锉炒用。\"现行，取净茜草段或片，置锅内用文火加热，炒黄。"}]},{"ID":"20240607125105-vqhghod","Type":"NodeParagraph","Properties":{"id":"20240607125105-vqhghod","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"4.酒制茜草 《外科启玄》：\"酒洗。\"《得配本草》：\"酒炒行血。\"现行，取净茜草片与黄酒拌匀，置锅内用文火微炒，取出，晾干。每茜草片100kg，用黄酒25kg。"}]},{"ID":"20240607125105-i7ydg4y","Type":"NodeParagraph","Properties":{"id":"20240607125105-i7ydg4y","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"5．饮片性状：茜草参见\"药材鉴别\"项。茜草炭形如茜草片或段，呈焦黑色，内部棕褐色。略具焦糊气，味苦。炒茜草形茜草，表面焦黄色。酒制茜草形如炒茜草，微具酒气。贮干燥容器内，置通风干燥处。酒制茜草密闭，茜草炭及时散热，防止复燃。"}]},{"ID":"20240607125105-442gyeu","Type":"NodeParagraph","Properties":{"id":"20240607125105-442gyeu","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607125105-rsjjc4b","Type":"NodeParagraph","Properties":{"id":"20240607125105-rsjjc4b","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 薄层色谱：1．取本品粉末(60目)50mg，用甲醇10ml浸泡过夜，超声波振荡30分钟，将提取液浓缩至1ml，供点样用。另取大叶茜草甙丙、茜草甙、大叶茜草甙乙、大叶茜草甙甲为对照品。分别点样于硅胶G薄层板上，以乙酸乙酯-甲醇-甲酸(4：1：0.1，并以水饱和)展开，日光下斑点显黄色或橙色。氨蒸气熏后，斑点显红色。(检查蒽醌甙)2．取本品粉末(60目)100mg，用甲醇10ml浸泡过夜，超声波振荡30分钟，提取液稍浓缩，通过小硅胶柱，石油醚-乙酸乙酯(4：1)洗脱出游离蒽醌成分，浓缩至1ml，供点样用。另取羟基茜草素、茜草素为对照品。分别点样于硅胶6薄层板上，用苯-甲酸乙酯-甲醇-甲酸(3：1：0.2：0.1，并以水饱和)展开。羟基茜草素为橘黄色，茜草素为紫红色。"}]},{"ID":"20240607125105-6fvxhi6","Type":"NodeParagraph","Properties":{"id":"20240607125105-6fvxhi6","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"3．取本品粉末(60目)50mg包于滤纸内，用70%乙醇10ml浸泡过夜，加热10分钟，滤过，滤液蒸于，以甲醇2ml溶解供点样用。另取茜草萘酸甙Ⅰ、茜草萘酸甙Ⅱ、茜草萘酸为对照品，分别点样于硅胶G薄层板上，用氯仿-甲醇-异丙醇-甲酸(5.5：2.5：2：2滴)展开，以15%硫酸水溶液喷后，吹风机热气流中烘烤。茜草萘酸甙Ⅰ为灰色，茜草萘酸甙Ⅱ为紫色，茜草萘酸为橘黄色。"}]},{"ID":"20240607125105-9h83adl","Type":"NodeParagraph","Properties":{"id":"20240607125105-9h83adl","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607125105-h5w7dw8","Type":"NodeParagraph","Properties":{"id":"20240607125105-h5w7dw8","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 肝；心；肾；脾；胃；心包经"}]},{"ID":"20240607125105-l6tn91x","Type":"NodeParagraph","Properties":{"id":"20240607125105-l6tn91x","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607125105-ndf4ydr","Type":"NodeParagraph","Properties":{"id":"20240607125105-ndf4ydr","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 苦；寒归肝；心经"}]},{"ID":"20240607125105-9m1y55g","Type":"NodeParagraph","Properties":{"id":"20240607125105-9m1y55g","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607125105-art6rh1","Type":"NodeParagraph","Properties":{"id":"20240607125105-art6rh1","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒及无瘀滞者慎服。"}]},{"ID":"20240607125105-2tvt2aw","Type":"NodeParagraph","Properties":{"id":"20240607125105-2tvt2aw","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：\"畏鼠姑。\"2.《本草蒙签》：\"勿犯铜铁。\"3.《本草经疏》：\"病人虽见血症，若加泄泻、饮食不进者，勿服。\"4.《本草正》：\"气虚不摄血及脾寒者勿用。\"5.《本草汇言》：\"精虚血少者，脾虚胃弱者，阴虚火胜者，俱禁用之。\"6.《本草从新》：\"无瘀滞者忌投。\"7.《本草求真》：\"血虚发热者忌用。\""}]},{"ID":"20240607125105-ow21uqs","Type":"NodeParagraph","Properties":{"id":"20240607125105-ow21uqs","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607125105-81lygtt","Type":"NodeParagraph","Properties":{"id":"20240607125105-81lygtt","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 凉血止血；活血化瘀。主血热咯血；吐血；衄血；尿血；便血；崩漏；经闭；产后瘀阻腹痛；跌打损伤；风湿痹痛；黄疸；疮痈；痔肿"}]},{"ID":"20240607125105-uugowip","Type":"NodeParagraph","Properties":{"id":"20240607125105-uugowip","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607125105-srf11oh","Type":"NodeParagraph","Properties":{"id":"20240607125105-srf11oh","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g；或入丸、散；或浸酒。"}]},{"ID":"20240607125105-waykwpe","Type":"NodeParagraph","Properties":{"id":"20240607125105-waykwpe","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607125105-vgetsbc","Type":"NodeParagraph","Properties":{"id":"20240607125105-vgetsbc","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 茜草，《纲目》云:“陶隐居本草言东方有而少，不如西方多，则西草为茜。”西天王草、四岳近阳草，皆为茜草之隐称也。茜，亦作蒨，《玉篇·草部》:“蒨，青葱之貌。”谓其草盛，陶弘景言此草“丰贱”，故“蒨”，当由长势茂盛得名。搜，《说文》:“搜，茅搜，茹藘(一作芦)，人血所生，可以染绛。”“人血所生”乃古人虚妄之说。段玉裁注:“云人血所生者，释此字所以从鬼也。从卄鬼，会意。茅搜、茹芦皆叠韵也。”茹芦，《说文》作“茹芦”，按《说文》:“茹，饲马也。”《尔雅义疏》云:“今田家名驴馓子，驴喜啖之也。”此名因饲驴而得，字因义类，从“卄”作“茵”，因此茹藘本当为茹芦。血见愁及诸”破血”、“活血”等名皆由化瘀止血之功。其根色紫赤，可用以染绛，故有地血、染绯草、红根草诸名，过山龙、九龙根、牛蔓等，皆因攀援蔓生而命名。叶四片轮生，故有四轮草、风车草之名。《纲目》云:“数寸一节，每节五叶”(观察有误)，故称五爪龙、五叶藤。因茎叶有倒刺，而有拉拉秧子、锯锯草、粘蔓草诸名。"}]},{"ID":"20240607125105-58g4y00","Type":"NodeParagraph","Properties":{"id":"20240607125105-58g4y00","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607125105-cgaap4s","Type":"NodeParagraph","Properties":{"id":"20240607125105-cgaap4s","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 用于血热妄行之多种出血证。茜草性寒入血分，能凉血止血，且能化瘀。凡血热妄行之出血证均可选用，兼瘀者尤宜。治血热咯血、吐血、衄血、尿血等证，轻者单用，重者可配小蓟、白茅根、山栀子等，以增强凉血止血之功，方如《十药神书》十灰散。治大肠蕴热之肠风便血，常配黄芩、地榆、槐角等药，以清肠凉血止血。治血热崩漏，常配生地、生蒲黄、侧柏叶等药，以凉血止崩；若气虚不摄，冲任虚损，漏下不止者，再配炙黄芪、山萸肉、乌贼骨等药，以补气摄血，收涩固脱。 用于瘀血经闭，产后瘀阻腹痛，跌打损伤肿痛，兼热者尤宜，因茜草有活血法瘀之功且能凉血。治瘀血经闭，可单用，或配丹参、赤芍、当归等药同用，则可增强活血通经作用；若为血枯兼瘀之经闭，又当配制首乌、熟地黄、川芎等，以养血活血通经。治产后瘀阻腹痛，属热者，常配败酱草、红藤、赤芍等药，以清热化瘀止痛；属寒滞者，常配当归、川芎、炮姜等药，以散寒暖宫、化瘀止痛；兼气虚血亏者，常配炙黄蔑、人参、当归等药，以补虚化瘀。治跌打损伤瘀肿，常配红花、川断、骨碎补等药，以活血消肿疗伤。 用于风湿痹痛。茜草活血通经，故亦治风湿痹痛，若属热痹者，常配忍冬藤、络石藤、秦艾等药，以清热通络止痛；属风寒湿痹者，又当与川乌、独活、海风藤等同用，以祛风除湿、散寒通痹。 用于黄疸。茜草凉血清瘀热而退黄，用治湿热黄疸，可配茵陈、山栀、大黄等药，以清热凉血，利湿退黄。 用于疮痈，痔肿。茜草能凉血化瘀以消散疮痈，治热毒疮疡或乳痈，常配蒲公英、银花、地丁等药；治痔疮肿痛，常配大黄、虎杖、地榆等药。"}]},{"ID":"20240607125105-glxxriw","Type":"NodeParagraph","Properties":{"id":"20240607125105-glxxriw","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607125105-73f35xm","Type":"NodeParagraph","Properties":{"id":"20240607125105-73f35xm","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 1.论茜草功擅活血：1．1．李时珍：\"茜草，气温行滞，味酸入肝，而咸走血，专于行血活血。俗方治女子经水不通，以一两煎酒服之，一日即通，甚效。\"(《纲目》)1．2．杜文燮：\"茜草，疗中多蛊毒，治跌扑损伤。吐下血如烂肝，凝积血成瘀块，虚热崩漏不止，劳伤吐衄时来，室女经滞不行，妇人产后血晕，治之皆愈。大都皆血家药也，故血滞者能行之，血死者能活之。痘家红紫干枯者，用之干活血药中甚妙。外症疮疖痈肿者，用之于排脓药中立效。其曰除乳结为痈者何？盖乳者血之所为也，用此剂以行之，则血行而痈自散矣。\"(《药鉴》))1．3．汪绂：\"茜草，色赤入血分，泻肝则血藏不瘀，补心则血用而能行，收散则用而不费；故能剂血气之平，止妄行之血而祛瘀通经，兼治痔瘘疮疡扑损。\"(《医林纂要·药性》)1．4．苏廷瑰：\"茜草，入肝与心包经，二经滞血为病宜此。方书用以疗吐血、衄血及尿血、泻血、诸热证，意主于从治而导瘀耳，非谓其性凉能止动血也。\"(《药义明辨》)1．5．蒋溶：\"茜草，惟宜血滞，缘血证滞者多也。虚劳亦因于瘀血者多，故宜治之。\"(《革金裘本草述录》)2.论茜草行血凉血为治血热诸症之要药：2．1．缪希雍：\"茜草，行血凉血之要药也。非苦不足以泄热，非甘不足以活血，非咸不足以入血软坚，非温少阳之气不足以通行，故主痹及疸，疸有五，此其为治，盖指蓄血发黄，而不专于湿热者也。痹者血病。行血软坚则痹自愈。甘能益血而补中，病去血和，补中可知矣。苦寒能下泄热气，故止内崩及下血。除热，故益膀胱。跤跌则瘀血，血行则踒跌自安。凉无病之血，行已伤之血，故治蛊毒。《药性论》味甘主六极伤心肺，吐血泻血；《日华于》味酸止鼻洪，带下，产后血晕，乳结，月经不止，肠风痔瘘，排脓，治疮疖，泄精，尿血，扑损瘀血，皆取其凉血行血，苦寒泄热之功耳。\"(《本草经疏》)2．2．张山雷：\"茜根性寒，所主多血热失血之证。古今说解，都无异义。而《本经》主治，独以寒湿二字为冠，最为不伦，虽各本无不尽同，然病情药性大相矛盾。此必古人传写之讹，不可望文生义，曲为附和。风痹指血瘀血热，痹着不行而言。茜草寒凉，入血能通瘀活络，是以主之。古人论痹，本有热痹一候，此必不可与上文寒湿连属读之，而谬谓可治寒痹、湿痹也，黄疸本属热症，此则并能清热逐瘀，缪仲淳谓指蓄血发黄，而不专于湿热，其说甚是。补中以清热，言热淫于里，则中气伤，惟去其热，清其血，则中得其补。经文最简，皆当观其会通，并非泛泛言之。"}]},{"ID":"20240607125105-ps4cz7f","Type":"NodeParagraph","Properties":{"id":"20240607125105-ps4cz7f","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607125105-5iwhwv5","Type":"NodeParagraph","Properties":{"id":"20240607125105-5iwhwv5","updated":"20240607125105"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607125106-mz1bm9v","Type":"NodeThematicBreak","Properties":{"id":"20240607125106-mz1bm9v"}},{"ID":"20240607125107-916hc2s","Type":"NodeParagraph","Properties":{"id":"20240607125107-916hc2s"}}]}