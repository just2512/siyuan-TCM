mage","Data":"span","Properties":{"parent-style":"width: 629px;","style":"width: 619px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏9-20240704123347-50moqhz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 619px;\" parent-style=\"width: 629px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 631px;","style":"width: 621px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏1-20240704122703-0cvp5cz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 621px;\" parent-style=\"width: 631px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240704123259-uwbom39","Type":"NodeParagraph","Properties":{"id":"20240704123259-uwbom39","updated":"20240828140333"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 600px;","style":"width: 590px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏10-20240704123637-k3qo7zr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 671px;","style":"width: 661px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏7-20240704123259-4ihrv45.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 661px;\" parent-style=\"width: 671px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240704123106-1ufp64f","Type":"NodeParagraph","Properties":{"id":"20240704123106-1ufp64f","updated":"20240828140335"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 380px;","style":"width: 370px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏3-20240704122857-84fzsk8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 370px;\" parent-style=\"width: 380px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 753px;","style":"width: 743px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏4-20240704123106-wfnx757.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 743px;\" parent-style=\"width: 753px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704123206-7jsu0jo","Type":"NodeParagraph","Properties":{"id":"20240704123206-7jsu0jo","updated":"20240828140347"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1136px;","style":"width: 1126px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏5-20240704123206-jj5po90.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1126px;\" parent-style=\"width: 1136px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828140618-imytj7v","Type":"NodeParagraph","Properties":{"id":"20240828140618-imytj7v","updated":"20240828140715"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 678px;","style":"width: 668px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏-20240828140618-c5jyc6x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 668px;\" parent-style=\"width: 678px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏 2-20240828140715-oqzhx17.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828141018-67l7uhz","Type":"NodeParagraph","Properties":{"id":"20240828141018-67l7uhz","updated":"20240828141018"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏 3-20240828141018-e1alr16.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704124220-86qntei","Type":"NodeParagraph","Properties":{"id":"20240704124220-86qntei","updated":"20240828141029"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏11"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏11-20240704124220-g9uu3zh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828140328-ynz7dy6","Type":"NodeParagraph","Properties":{"id":"20240828140328-ynz7dy6","updated":"20240828140328"}},{"ID":"20240704125140-hsn6f6a","Type":"NodeParagraph","Properties":{"id":"20240704125140-hsn6f6a","updated":"20240704125152"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柏叶对比"}]},{"ID":"20240704125157-yv4g7mj","Type":"NodeParagraph","Properties":{"id":"20240704125157-yv4g7mj","updated":"20240704125157"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1041px;","style":"width: 1031px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"柏叶对比图"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/柏叶对比图-20240704125157-j393ufa.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1031px;\" parent-style=\"width: 1041px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704124829-wolsun5","Type":"NodeParagraph","Properties":{"id":"20240704124829-wolsun5","updated":"20240704125102"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：侧柏叶子是扁的，都在一个平面上，所以也叫做扁柏，而柏树的叶子则是圆的。"}]},{"ID":"20240614110618-fqx5opc","Type":"NodeThematicBreak","Properties":{"id":"20240614110618-fqx5opc"}},{"ID":"20240614110716-s9m1ek9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110716-s9m1ek9","updated":"20240614110720"},"Children":[{"Type":"NodeText","Data":"柏叶《本经逢原》"}]},{"ID":"20240614110716-2o0uvac","Type":"NodeParagraph","Properties":{"id":"20240614110716-2o0uvac","updated":"20240614110716"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"节油"}]},{"ID":"20240614110716-e7i4pq2","Type":"NodeParagraph","Properties":{"id":"20240614110716-e7i4pq2","updated":"20240614110716"},"Children":[{"Type":"NodeText","Data":"苦微寒，无毒。酒浸焙熟用。"}]},{"ID":"20240614110716-w7i9xk3","Type":"NodeParagraph","Properties":{"id":"20240614110716-w7i9xk3","updated":"20240614110716"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"柏叶性寒而燥，大能伐胃。虽有止衄之功，而无阳生之力，故亡血虚家不宜擅服。然配合之力，功过悬殊。如《金匮》柏叶汤，同姜、艾治吐血不止，当无此虑矣。若《济急方》同黄连治小便血，《圣济总录》同芍药治月水不断，纵藉酒之辛温，以行苦寒之势。"}]},{"ID":"20240614110716-5duvzlf","Type":"NodeParagraph","Properties":{"id":"20240614110716-5duvzlf","updated":"20240614110716"},"Children":[{"Type":"NodeText","Data":"但酒力易过，苦寒长留，每致减食作泻，瘀积不散，是岂柏叶之过欤。柏节坚劲，用以煮汁、酿酒，去风痹历节风，烧取 油疗 疮疥癞。柏脂治身面疣，同松脂研匀涂之数日自落。"}]},{"ID":"20240614110716-k3mdwea","Type":"NodeParagraph","Properties":{"id":"20240614110716-k3mdwea","updated":"20240614110716"},"Children":[{"Type":"NodeText","Data":"根白皮以腊猪脂调，涂火灼热油烫疮，能凉血生毛发。"}]},{"ID":"20240614110618-6stojfo","Type":"NodeThematicBreak","Properties":{"id":"20240614110618-6stojfo"}},{"ID":"20240614110707-s9stiih","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110707-s9stiih","updated":"20240614110712"},"Children":[{"Type":"NodeText","Data":"柏叶《本草乘雅半偈》"}]},{"ID":"20240614110707-m0zaeud","Type":"NodeParagraph","Properties":{"id":"20240614110707-m0zaeud","updated":"20240614110707"},"Children":[{"Type":"NodeText","Data":"（李时珍）"}]},{"ID":"20240614110707-d7tr4lv","Type":"NodeParagraph","Properties":{"id":"20240614110707-d7tr4lv","updated":"20240614110707"},"Children":[{"Type":"NodeText","Data":"【气味】苦，微温无毒。"}]},{"ID":"20240614110707-pjohzcm","Type":"NodeParagraph","Properties":{"id":"20240614110707-pjohzcm","updated":"20240614110707"},"Children":[{"Type":"NodeText","Data":"【主治】煮汁，洗漆疮。"}]},{"ID":"20240614110707-dz8bppd","Type":"NodeParagraph","Properties":{"id":"20240614110707-dz8bppd","updated":"20240614110707"},"Children":[{"Type":"NodeText","Data":"【核】曰∶侧柏，侧生扁柏叶也。生成见柏实条核。"}]},{"ID":"20240614110707-78xgphs","Type":"NodeParagraph","Properties":{"id":"20240614110707-78xgphs","updated":"20240614110707"},"Children":[{"Type":"NodeText","Data":"【 】曰∶木谐白者柏，向西承制，以全木德，肝脏体用备矣。叶侧曰孙，曰络，曰经，曰脉，克肖乎形。盖肝藏血，失所藏，血吐不止。守所藏，何吐之有。时珍广之洗疗漆疮，金形人，肤受其眚，名曰横漆克承制，又何横之有。"}]},{"ID":"20240614110618-vfbz8xj","Type":"NodeThematicBreak","Properties":{"id":"20240614110618-vfbz8xj"}},{"ID":"20240614110658-cfexkrd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110658-cfexkrd","updated":"20240614110702"},"Children":[{"Type":"NodeText","Data":"柏叶《千金翼方》"}]},{"ID":"20240614110658-jhpcals","Type":"NodeParagraph","Properties":{"id":"20240614110658-jhpcals","updated":"20240614110658"},"Children":[{"Type":"NodeText","Data":"味苦，微温，无毒。主吐血衄血，利血崩中，赤白。轻身益气，令人耐寒暑，去湿痹，止饥，四时各依方面采，阴干。"}]},{"ID":"20240614111004-t4u4slr","Type":"NodeThematicBreak","Properties":{"id":"20240614111004-t4u4slr"}},{"ID":"20240614111005-x5w6ye2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614111005-x5w6ye2","updated":"20240614111015"},"Children":[{"Type":"NodeText","Data":"侧柏叶《本草求真》"}]},{"ID":"20240614111005-pcth75w","Type":"NodeParagraph","Properties":{"id":"20240614111005-pcth75w","updated":"20240614111005"},"Children":[{"Type":"NodeText","Data":"（香木）止血"}]},{"ID":"20240614111005-rpuuka7","Type":"NodeParagraph","Properties":{"id":"20240614111005-rpuuka7","updated":"20240614111005"},"Children":[{"Type":"NodeText","Data":"侧柏叶（专入肺肝）。苦涩微寒。书言养阴滋肺燥土。然禀受西金。坚劲不凋。（魏子才六书精蕴云。万木皆向阳。而柏独西指。故字从白。白者西方也。陆佃埤雅云。柏之指西。犹针之指南也。柏有数种。入药惟取叶扁而侧生者。故曰侧柏。寇宗 曰。予官陕西。登高望柏千万树。皆一一西指。盖此木至坚。不畏霜雪。得木之正气。他木不及。所以受金之正气。所制一一西指也。）服此大能伐胃。虽有止血之功。而气味与血分无情。不过仗金气以制木。借炒黑以止血耳。（汪昂曰。肢节大痛。昼静夜剧。名白虎历节风。亦风寒湿所致。）"}]},{"ID":"20240614111005-w2ijjrh","Type":"NodeParagraph","Properties":{"id":"20240614111005-w2ijjrh","updated":"20240614111005"},"Children":[{"Type":"NodeText","Data":"别录称为补益。似属未是。但涂汤火伤损。生肌杀虫。炙罨冻疮。汁染须发最佳。酒浸或炒或生用。桂牡蛎为使。恶菊花。宜酒。（元旦饮椒柏酒以辟邪。）"}]},{"ID":"20240614111102-37uwudr","Type":"NodeThematicBreak","Properties":{"id":"20240614111102-37uwudr"}},{"ID":"20240614111103-ur4br5t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614111103-ur4br5t","updated":"20240614111107"},"Children":[{"Type":"NodeText","Data":"侧柏叶《本草备要》"}]},{"ID":"20240614111103-us2qnm1","Type":"NodeParagraph","Properties":{"id":"20240614111103-us2qnm1","updated":"20240614111103"},"Children":[{"Type":"NodeText","Data":"补阴，凉血"}]},{"ID":"20240614111103-z8d4hrg","Type":"NodeParagraph","Properties":{"id":"20240614111103-z8d4hrg","updated":"20240614111103"},"Children":[{"Type":"NodeText","Data":"苦涩微寒（《本草》微温）。养阴滋肺而燥土最清血分，为补阴要药。"}]},{"ID":"20240614111103-gjnjt5b","Type":"NodeParagraph","Properties":{"id":"20240614111103-gjnjt5b","updated":"20240614111103"},"Children":[{"Type":"NodeText","Data":"止吐衄崩淋，肠风尿（血）痢（血），一切血证，去冷风湿痹，历节风痛（肢节大痛，昼静夜剧，名白虎历节风。亦风寒湿所致）。涂汤火伤（捣烂水调涂），生肌杀虫，炙罨冻疮，汁乌髭发。"}]},{"ID":"20240614111103-c7sx2lr","Type":"NodeParagraph","Properties":{"id":"20240614111103-c7sx2lr","updated":"20240614111103"},"Children":[{"Type":"NodeText","Data":"取侧者（丹溪曰∶多得月令之气，随月建方取），或炒或生用。桂、牡蛎为使。恶菊花。"}]},{"ID":"20240614111103-3z8vcsu","Type":"NodeParagraph","Properties":{"id":"20240614111103-3z8vcsu","updated":"20240614111103"},"Children":[{"Type":"NodeText","Data":"宜酒（万木皆向阳，柏独四指，受金之正气，坚劲不凋，多寿之木，故元旦饮椒柏酒以辟邪）"}]},{"ID":"20240614111052-l8bhrmm","Type":"NodeThematicBreak","Properties":{"id":"20240614111052-l8bhrmm"}},{"ID":"20240614111053-qa63u7t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614111053-qa63u7t","updated":"20240614111058"},"Children":[{"Type":"NodeText","Data":"侧柏叶《要药分剂》"}]},{"ID":"20240614111053-r9dyecg","Type":"NodeParagraph","Properties":{"id":"20240614111053-r9dyecg","updated":"20240614111053"},"Children":[{"Type":"NodeText","Data":"味苦涩。性微寒。无毒。感秋令。得金气之全而生。可升可降。阴也。肉桂、牡蛎恶菊花。宜酒。"}]},{"ID":"20240614111053-h33pxli","Type":"NodeParagraph","Properties":{"id":"20240614111053-h33pxli","updated":"20240614111053"},"Children":[{"Type":"NodeText","Data":"【主治】主吐血衄血崩中。肠风尿血痢血。一切血症。去冷风湿痹。生肌。各依方面采阴干【归经】入肝肾二经。为益阴凉血之品。（补阴要药养阴滋肺而燥土最清血分）【前论】陆佃曰。柏有数种。入药惟取叶扁而侧生者。故曰侧柏。"}]},{"ID":"20240614111053-218map8","Type":"NodeParagraph","Properties":{"id":"20240614111053-218map8","updated":"20240614111053"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。凡使柏叶。或炒或生用。"}]},{"ID":"20240614111043-guqprbz","Type":"NodeThematicBreak","Properties":{"id":"20240614111043-guqprbz"}},{"ID":"20240614111044-vudq7x3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614111044-vudq7x3","updated":"20240614111048"},"Children":[{"Type":"NodeText","Data":"侧柏叶《药性切用》"}]},{"ID":"20240614111044-qvwph6o","Type":"NodeParagraph","Properties":{"id":"20240614111044-qvwph6o","updated":"20240614111044"},"Children":[{"Type":"NodeText","Data":"味苦微寒，性涩气燥，最清血分湿热，止血痢、肠风。血虚无湿热者忌。"}]},{"ID":"20240614111033-f0rwvy6","Type":"NodeThematicBreak","Properties":{"id":"20240614111033-f0rwvy6"}},{"ID":"20240614111034-c6i2qdj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614111034-c6i2qdj","updated":"20240614111038"},"Children":[{"Type":"NodeText","Data":"柏《本草纲目》"}]},{"ID":"20240614111034-cjpcale","Type":"NodeParagraph","Properties":{"id":"20240614111034-cjpcale","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"「释名」侧柏。"}]},{"ID":"20240614111034-45ouicp","Type":"NodeParagraph","Properties":{"id":"20240614111034-45ouicp","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"「气味」柏实：甘、平、无毒。柏叶：苦、微温、无毒。"}]},{"ID":"20240614111034-myj4dly","Type":"NodeParagraph","Properties":{"id":"20240614111034-myj4dly","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614111034-gbtbyqa","Type":"NodeParagraph","Properties":{"id":"20240614111034-gbtbyqa","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"柏实："}]},{"ID":"20240614111034-qtldf1o","Type":"NodeParagraph","Properties":{"id":"20240614111034-qtldf1o","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"1、平肝润肾。延年壮神。用柏实晒干，去壳，研末。每服二钱，温酒送下。一天服三次。又方：加松子仁等分，以松脂和丸服。又方：加菊花等分，以蜜和丸服。又方：用柏子仁二斤，研为末，泡酒中成膏，加枣肉三斤，白蜜、白术末、地黄末各一斤，捣匀做成丸子，如弹子大。每嚼一丸，一日三服。"}]},{"ID":"20240614111034-iufb9jh","Type":"NodeParagraph","Properties":{"id":"20240614111034-iufb9jh","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"2、老人便秘。用柏子仁、松子仁、大麻仁，等分同研，加蜜、蜡做成丸子，如梧子大。每服二、三十丸，饭前服，少黄丹汤调下。一天服二次。"}]},{"ID":"20240614111034-awtrfpm","Type":"NodeParagraph","Properties":{"id":"20240614111034-awtrfpm","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"3、肠风下血。用柏子十四个，捶碎，贮布袋中，加入好酒三碗，煎至八成服下。"}]},{"ID":"20240614111034-ld5ppnw","Type":"NodeParagraph","Properties":{"id":"20240614111034-ld5ppnw","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"4、小儿惊明腹满，大便青白色。用柏子仁研为还想，温水落石出调服一钱。"}]},{"ID":"20240614111034-zounhlb","Type":"NodeParagraph","Properties":{"id":"20240614111034-zounhlb","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"柏叶："}]},{"ID":"20240614111034-ikd1p9a","Type":"NodeParagraph","Properties":{"id":"20240614111034-ikd1p9a","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"1、中风（涎潮口噤，语言不出，手足垂）。用柏叶一把去枝，葱白一把连根研如泥，加酒一程式，煎开多次后温服。"}]},{"ID":"20240614111034-6tzkyw6","Type":"NodeParagraph","Properties":{"id":"20240614111034-6tzkyw6","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"2、霍乱转筋。用柏叶捣烂裹脚上，另外再煎汁淋洗。"}]},{"ID":"20240614111034-04pppb8","Type":"NodeParagraph","Properties":{"id":"20240614111034-04pppb8","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"3、吐血。用青柏叶一把、干姜二片、阿胶一挺（炙），加水二升，煮成一程式，去渣，另加马通汁一升，再合煎为一升，滤过，一次服下。"}]},{"ID":"20240614111034-l09j66f","Type":"NodeParagraph","Properties":{"id":"20240614111034-l09j66f","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"4、鼻血不止。用柏叶、榴花，共研为末，吹入鼻中。"}]},{"ID":"20240614111034-hi3j68k","Type":"NodeParagraph","Properties":{"id":"20240614111034-hi3j68k","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"5、尿血。用柏叶、黄连焙过，研细，酒送服三钱。"}]},{"ID":"20240614111034-x1dcsfm","Type":"NodeParagraph","Properties":{"id":"20240614111034-x1dcsfm","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"6、大肠下血。用柏叶烧存性，研为还末。每服二钱，米汤送下。"}]},{"ID":"20240614111034-iwjuz2s","Type":"NodeParagraph","Properties":{"id":"20240614111034-iwjuz2s","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"7、月经不断。用侧柏叶（炙）、芍药等分，每取三钱，加水、酒各半煎服。对未婚妇女，用侧柏叶、木（炒至微焦），等分为末。每服二钱，米汤送下。"}]},{"ID":"20240614111034-7evyn63","Type":"NodeParagraph","Properties":{"id":"20240614111034-7evyn63","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"8、汤火伤。用柏叶生捣涂搽，二、三日后，止痛灭瘢。"}]},{"ID":"20240614111034-t0b1afy","Type":"NodeParagraph","Properties":{"id":"20240614111034-t0b1afy","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"9、大麻风（眉发脱落）。有侧柏叶九蒸九晒后研为末，加炼蜜做成丸子，如梧子大。每服五至十丸。白天服三次，晚间服一次。百日之后，眉中可再生。"}]},{"ID":"20240614111034-1j03ce8","Type":"NodeParagraph","Properties":{"id":"20240614111034-1j03ce8","updated":"20240614111034"},"Children":[{"Type":"NodeText","Data":"10、头发不生。用侧柏叶阴干研末，和麻油涂搽。"}]},{"ID":"20240614111020-qphde3q","Type":"NodeThematicBreak","Properties":{"id":"20240614111020-qphde3q"}},{"ID":"20240614111022-pe4sw7l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614111022-pe4sw7l","updated":"20240614111026"},"Children":[{"Type":"NodeText","Data":"侧柏叶《本草择要纲目》"}]},{"ID":"20240614111022-6g3gs8h","Type":"NodeParagraph","Properties":{"id":"20240614111022-6g3gs8h","updated":"20240614111022"},"Children":[{"Type":"NodeText","Data":"（凡用 去两畔并心枝丫．用糯泔浸七日．以酒拌蒸一伏时．每一斤用黄精自然汁十二两浸焙．又浸又焙．待汁干用之．此服食治法也．常用或生或炒．各从本方．）"}]},{"ID":"20240614111022-6mwcofn","Type":"NodeParagraph","Properties":{"id":"20240614111022-6mwcofn","updated":"20240614111022"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240614111022-qgshgyh","Type":"NodeParagraph","Properties":{"id":"20240614111022-qgshgyh","updated":"20240614111022"},"Children":[{"Type":"NodeText","Data":"苦微温无毒．"}]},{"ID":"20240614111022-nlh1sj4","Type":"NodeParagraph","Properties":{"id":"20240614111022-nlh1sj4","updated":"20240614111022"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240614111022-2dtb5id","Type":"NodeParagraph","Properties":{"id":"20240614111022-2dtb5id","updated":"20240614111022"},"Children":[{"Type":"NodeText","Data":"吐血衄血痢血崩中赤白．轻身益气．令人耐寒暑．去湿痹生肌．治冷风历节疼痛．止尿血．炙 冻疮．烧取汁涂头黑润鬓发．敷汤火伤．止痛灭瘢．服之疗蛊痢．作汤常服．杀五脏虫．益人．柏属阴与金善守．故采其叶随月建．方取其多得月令之气．此补阴之要药．其性多燥．久服之．大益脾土．以滋其肺．柏性后凋而耐久．禀坚凝之质．乃多寿之木．所以可入服食．道家以之点汤常饮．元旦以之浸酒辟邪．皆有取于此也．"}]},{"ID":"20240614111022-qw6nzld","Type":"NodeParagraph","Properties":{"id":"20240614111022-qw6nzld","updated":"20240614111022"},"Children":[{"Type":"NodeText","Data":"【畏】（羊蹄草 菊花）"}]},{"ID":"20240614110954-fxwzgdi","Type":"NodeThematicBreak","Properties":{"id":"20240614110954-fxwzgdi"}},{"ID":"20240614110955-fud5srz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110955-fud5srz","updated":"20240614110959"},"Children":[{"Type":"NodeText","Data":"侧柏叶《汤液本草》"}]},{"ID":"20240614110955-zri0p9v","Type":"NodeParagraph","Properties":{"id":"20240614110955-zri0p9v","updated":"20240614110955"},"Children":[{"Type":"NodeText","Data":"气微温，味苦。无毒。"}]},{"ID":"20240614110955-2j7zp2o","Type":"NodeParagraph","Properties":{"id":"20240614110955-2j7zp2o","updated":"20240614110955"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主吐血、衄血及痢血，崩中赤白，轻身益气，令人耐寒暑。"}]},{"ID":"20240614110955-f7ug0qc","Type":"NodeParagraph","Properties":{"id":"20240614110955-f7ug0qc","updated":"20240614110955"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶侧柏叶苦辛，性涩，治冷风历节疼痛，止尿血，与酒相宜。"}]},{"ID":"20240614110618-czfoplu","Type":"NodeThematicBreak","Properties":{"id":"20240614110618-czfoplu"}},{"ID":"20240614110641-hetds58","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110641-hetds58","updated":"20240614110645"},"Children":[{"Type":"NodeText","Data":"柏叶《长沙药解》"}]},{"ID":"20240614110641-vd45cib","Type":"NodeParagraph","Properties":{"id":"20240614110641-vd45cib","updated":"20240614110641"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】无。"}]},{"ID":"20240614110641-hucspd4","Type":"NodeParagraph","Properties":{"id":"20240614110641-hucspd4","updated":"20240614110641"},"Children":[{"Type":"NodeText","Data":"味苦、辛，涩，入手太阴肺经。清金益气，敛肺止血。"}]},{"ID":"20240614110641-lbbhjyq","Type":"NodeParagraph","Properties":{"id":"20240614110641-lbbhjyq","updated":"20240614110641"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柏叶汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"柏叶三两，干姜三两，艾三把，马通汁一升。"},{"Type":"NodeText","Data":"治吐血不止者。以中虚胃逆，肺金失敛，故吐血不止。干姜补中而降逆，柏、艾、马通，敛血而止吐也。"}]},{"ID":"20240614110641-nqnkopm","Type":"NodeParagraph","Properties":{"id":"20240614110641-nqnkopm","updated":"20240614110641"},"Children":[{"Type":"NodeText","Data":"血生于木而摄于金，庚金不收，则下脱于便尿，辛金不降，则上溢于鼻口。柏叶秉秋金之收气，最能止血，缘其善收土湿。湿气收则金燥而自敛也。其诸主治，止吐衄，断崩漏，收便血，除尿血，敷烧灼，润须发，治历节疼痛。"}]},{"ID":"20240614110922-fyizbjo","Type":"NodeThematicBreak","Properties":{"id":"20240614110922-fyizbjo"}},{"ID":"20240614110924-3vz215u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110924-3vz215u","updated":"20240614110928"},"Children":[{"Type":"NodeText","Data":"侧柏叶《本草从新》"}]},{"ID":"20240614110924-4g1puwx","Type":"NodeParagraph","Properties":{"id":"20240614110924-4g1puwx","updated":"20240614110924"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"凉血、清血分湿热．"}]},{"ID":"20240614110924-84m0m2i","Type":"NodeParagraph","Properties":{"id":"20240614110924-84m0m2i","updated":"20240614110924"},"Children":[{"Type":"NodeText","Data":"味苦微寒．性涩而燥．（西向得燥金之气．）最清血分湿热．止吐衄崩淋．肠风尿血．血痢．"}]},{"ID":"20240614110924-85b6pa6","Type":"NodeParagraph","Properties":{"id":"20240614110924-85b6pa6","updated":"20240614110924"},"Children":[{"Type":"NodeText","Data":"一切血证．去风湿诸痹．历节风痛．（肢节大痛、昼静夜剧、名白虎历节风、亦风寒湿所致．）涂汤火伤．（捣烂、水调涂．）生肌杀虫．炙罨冻疮．汁、乌须发．丹溪以为补阴要药．"}]},{"ID":"20240614110924-ro9nk3v","Type":"NodeParagraph","Properties":{"id":"20240614110924-ro9nk3v","updated":"20240614110924"},"Children":[{"Type":"NodeText","Data":"然终属苦寒燥涩之品．唯血分有湿热者．以此清之为宜．若真阴虚者．非所宜也．柏有数种．唯根上发枝数茎．蒙茸茂密．名千头柏．又名佛手柏者为真．或炒或生．用桂、牡蛎为使．恶菊花．宜酒．（头发不生、为末、和麻油涂．）"}]},{"ID":"20240614110906-6lepthy","Type":"NodeThematicBreak","Properties":{"id":"20240614110906-6lepthy"}},{"ID":"20240614110907-83l94ld","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110907-83l94ld","updated":"20240614110911"},"Children":[{"Type":"NodeText","Data":"侧柏叶《中药学》"}]},{"ID":"20240614110907-sb16hgo","Type":"NodeParagraph","Properties":{"id":"20240614110907-sb16hgo","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【药用】本品为柏科植物侧柏的枝叶。"}]},{"ID":"20240614110907-q466b6b","Type":"NodeParagraph","Properties":{"id":"20240614110907-q466b6b","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、涩，微寒。入肺、肝、大肠经。"}]},{"ID":"20240614110907-kz7rdo1","Type":"NodeParagraph","Properties":{"id":"20240614110907-kz7rdo1","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【功效】凉血止血。"}]},{"ID":"20240614110907-tdn2ffz","Type":"NodeParagraph","Properties":{"id":"20240614110907-tdn2ffz","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于各种出血病症。"}]},{"ID":"20240614110907-u7i4g5z","Type":"NodeParagraph","Properties":{"id":"20240614110907-u7i4g5z","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"侧柏叶生敛止血，且有凉血作用，故主要用于血热妄行引起的出血病症，如咯血、呕血、鼻衄、尿血、便血及崩漏等，多与仙鹤草、蒲黄、藕节、生地等同用。"}]},{"ID":"20240614110907-7m4io8z","Type":"NodeParagraph","Properties":{"id":"20240614110907-7m4io8z","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【处方用名】侧柏炭（炒至外呈黑色为度）、生侧柏叶（洗净，晒干，切断用）"}]},{"ID":"20240614110907-d1ti3ul","Type":"NodeParagraph","Properties":{"id":"20240614110907-d1ti3ul","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240614110907-f72iz2p","Type":"NodeParagraph","Properties":{"id":"20240614110907-f72iz2p","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【按语】1.侧柏叶止血效用较好，为治疗各种出血病症的要药。性属寒凉，所以主要用于血热妄行的出血症；若虚寒性出血，本品又可配合干姜、艾叶等同用。研末，还可用于外伤出血。"}]},{"ID":"20240614110907-1fhlmy4","Type":"NodeParagraph","Properties":{"id":"20240614110907-1fhlmy4","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"2.近年来本品在临床上应用于老年慢性支气管炎，发现它又有止咳祛痰的功效。"}]},{"ID":"20240614110907-vpg6hdc","Type":"NodeParagraph","Properties":{"id":"20240614110907-vpg6hdc","updated":"20240614110907"},"Children":[{"Type":"NodeText","Data":"【方剂举例】四生丸（《妇人良方》）生地黄、生侧柏叶、生艾叶、生荷叶。治血热妄行，吐血衄血，咽干口燥，舌绛脉数。"}]},{"ID":"20240614110618-t9hx8zu","Type":"NodeThematicBreak","Properties":{"id":"20240614110618-t9hx8zu"}},{"ID":"20240614110625-ydg0m0h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110625-ydg0m0h","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：柏树叶"}]},{"ID":"20240614110625-bgbyy53","Type":"NodeParagraph","Properties":{"id":"20240614110625-bgbyy53","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614110625-e881kzc","Type":"NodeParagraph","Properties":{"id":"20240614110625-e881kzc","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" Bǎi Shù Yè"}]},{"ID":"20240614110625-gxg141i","Type":"NodeParagraph","Properties":{"id":"20240614110625-gxg141i","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614110625-b5jkuaf","Type":"NodeParagraph","Properties":{"id":"20240614110625-b5jkuaf","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 《分类草药性》"}]},{"ID":"20240614110625-eix81s9","Type":"NodeParagraph","Properties":{"id":"20240614110625-eix81s9","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614110625-k385a2r","Type":"NodeParagraph","Properties":{"id":"20240614110625-k385a2r","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 为柏科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柏木"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枝叶"},{"Type":"NodeText","Data":"。全年可采，剪取枝叶，阴干。"}]},{"ID":"20240614110625-35y70ub","Type":"NodeParagraph","Properties":{"id":"20240614110625-35y70ub","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614110625-jykxt1b","Type":"NodeParagraph","Properties":{"id":"20240614110625-jykxt1b","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 生于山坡，公路旁、古墓和庙宇等处常栽培。全国大部分地区有分布。"}]},{"ID":"20240614110625-wybsaqj","Type":"NodeParagraph","Properties":{"id":"20240614110625-wybsaqj","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614110625-76k1v34","Type":"NodeParagraph","Properties":{"id":"20240614110625-76k1v34","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 柏木，又名:香柏（《三辅旧事》），香扁柏、垂丝柏、扫帚柏、白木树、密密松、扁柏、垂柏、柏青树、宋柏。"}]},{"ID":"20240614110625-b9sb5bq","Type":"NodeParagraph","Properties":{"id":"20240614110625-b9sb5bq","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高可达20米，直径可达1米。树皮平滑，灰褐色，枝条下垂。叶鳞片状，交互对生，紧贴枝上，呈卵状三角形，生于幼树或老树壮枝上的呈线形或锥形，3或4枚轮生而广展，先端长尖稍开展。花小，单性，同株，顶生；雄花序黄色，对生成椭圆形，雄蕊通常8。球果木质，球形，具短柄，直径8～12毫米，褐色，鳞片8，盾状，镊合状排列，背面有短尖的小凸体，每鳞片具种子3。种子卵形，稍有翅。花期4～5月。果期6～9月。"}]},{"ID":"20240614110625-axa80l1","Type":"NodeParagraph","Properties":{"id":"20240614110625-axa80l1","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614110625-83qrffk","Type":"NodeParagraph","Properties":{"id":"20240614110625-83qrffk","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 枝叶呈树枝状。叶细小鳞片形，先端锐尖，紧密贴生于小枝上，但在较大的枝上，叶尖不紧贴而成刺状突出；叶面黄绿色或灰绿色；小枝棕褐色。质脆，易断。气淡，味涩。"}]},{"ID":"20240614110625-tbrwhbu","Type":"NodeParagraph","Properties":{"id":"20240614110625-tbrwhbu","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614110625-3mqkpad","Type":"NodeParagraph","Properties":{"id":"20240614110625-3mqkpad","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" ①《分类草药性》:\"苦涩。\""}]},{"ID":"20240614110625-odakkel","Type":"NodeParagraph","Properties":{"id":"20240614110625-odakkel","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"②《重庆草药》:\"味苦辛，性温，无毒。\""}]},{"ID":"20240614110625-trpw372","Type":"NodeParagraph","Properties":{"id":"20240614110625-trpw372","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614110625-3crjj55","Type":"NodeParagraph","Properties":{"id":"20240614110625-3crjj55","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 治吐血，血痢，痔疮，烫伤。"}]},{"ID":"20240614110625-hf7ewkl","Type":"NodeParagraph","Properties":{"id":"20240614110625-hf7ewkl","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"①《分类草药性》:\"和血。治肠风痔肿，痢疾，吐血；兼涂小儿肥疮。\""}]},{"ID":"20240614110625-ewmazpw","Type":"NodeParagraph","Properties":{"id":"20240614110625-ewmazpw","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"②《重庆草药》:\"止血生肌，治刀伤。\""}]},{"ID":"20240614110625-j0pyx4e","Type":"NodeParagraph","Properties":{"id":"20240614110625-j0pyx4e","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"③《广西药植名录》:\"治咳血，心气痛，筋缩症。\""}]},{"ID":"20240614110625-cilrv88","Type":"NodeParagraph","Properties":{"id":"20240614110625-cilrv88","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614110625-uwr4e99","Type":"NodeParagraph","Properties":{"id":"20240614110625-uwr4e99","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 内服:煎汤，3～4钱；或研末。外用:捣敷或研末调敷。"}]},{"ID":"20240614110625-2685njd","Type":"NodeParagraph","Properties":{"id":"20240614110625-2685njd","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614110625-o8c8uis","Type":"NodeParagraph","Properties":{"id":"20240614110625-o8c8uis","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" ①治吐血:柏树子、柏树叶。打粉，兑酒吃，每次四钱。"}]},{"ID":"20240614110625-vpyk943","Type":"NodeParagraph","Properties":{"id":"20240614110625-vpyk943","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"②治小儿肥疮:柏树嫩叶打粉（或煅打粉），调油涂（洗净后涂）。"}]},{"ID":"20240614110625-praeuoy","Type":"NodeParagraph","Properties":{"id":"20240614110625-praeuoy","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"③治刀伤:柏树嫩叶，嚼烂敷。（①方以下出《重庆草药》）"}]},{"ID":"20240614110625-9ggfuzd","Type":"NodeParagraph","Properties":{"id":"20240614110625-9ggfuzd","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"④治蛇伤（目光复视）:柏树叶二两，香附全草二两。米泔水煎洗伤口。（江西《草药手册》）"}]},{"ID":"20240614110625-h51atnm","Type":"NodeParagraph","Properties":{"id":"20240614110625-h51atnm","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"⑤治烫伤:柏叶捣汁搽。（江西《草药手册》）"}]},{"ID":"20240614110625-nddhh3p","Type":"NodeParagraph","Properties":{"id":"20240614110625-nddhh3p","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614110625-ajlo41b","Type":"NodeParagraph","Properties":{"id":"20240614110625-ajlo41b","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614110625-vcvzjoq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110625-vcvzjoq","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"《中华本草》：柏树叶"}]},{"ID":"20240614110625-reuopys","Type":"NodeParagraph","Properties":{"id":"20240614110625-reuopys","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614110625-oy3grhe","Type":"NodeParagraph","Properties":{"id":"20240614110625-oy3grhe","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" Bǎi Shù Yè"}]},{"ID":"20240614110625-ze8b76w","Type":"NodeParagraph","Properties":{"id":"20240614110625-ze8b76w","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614110625-4m9jp46","Type":"NodeParagraph","Properties":{"id":"20240614110625-4m9jp46","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 出自《分类草药性》"}]},{"ID":"20240614110625-oa3k75p","Type":"NodeParagraph","Properties":{"id":"20240614110625-oa3k75p","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614110625-lo7w0g6","Type":"NodeParagraph","Properties":{"id":"20240614110625-lo7w0g6","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 药材基源：为柏科植物柏木的枝叶。"}]},{"ID":"20240614110625-khz1wro","Type":"NodeParagraph","Properties":{"id":"20240614110625-khz1wro","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cupressus funebris Endl."}]},{"ID":"20240614110625-1h2ssuo","Type":"NodeParagraph","Properties":{"id":"20240614110625-1h2ssuo","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年可采，剪取枝叶，阴干。"}]},{"ID":"20240614110625-9ge6f84","Type":"NodeParagraph","Properties":{"id":"20240614110625-9ge6f84","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614110625-avo6pqj","Type":"NodeParagraph","Properties":{"id":"20240614110625-avo6pqj","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 生态环境：为我国特产树种。"}]},{"ID":"20240614110625-mihf9k6","Type":"NodeParagraph","Properties":{"id":"20240614110625-mihf9k6","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及陕西、甘肃、浙江、江西、福建、湖北、湖南、广东等地。以四川、湖北西部和贵州栽部最多，江苏南部也有栽培。"}]},{"ID":"20240614110625-rhmjm22","Type":"NodeParagraph","Properties":{"id":"20240614110625-rhmjm22","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614110625-uyekjp5","Type":"NodeParagraph","Properties":{"id":"20240614110625-uyekjp5","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 乔木，高达35m，胸围达2m。树皮淡褐色；大枝开展；小枝细长、下垂，生鳞叶的小枝扁平，排成一平面，绿色，宽约1mm；较老的小枝圆柱形，暗褐色紫色，略有光泽。叶二型；鳞叶长1-1.5mm，先端锐尖，中央之叶的背面有条状腺点，两侧之叶背部有棱脊。雄球花椭圆形或卵圆形，长2.5-3mm；雌球花长3-6mm，近球形，径约3.5mm。球果圆球形，径8-12mm，熟时暗褐色；种鳞4对，先端为不规则五角形或方形，宽5-7mm，中央有尖头或无，能育种鳞有5-6粒种子；种子宽倒卵状菱形或近圆形，扁，长约2.5mm,淡褐色，有光泽，边缘具窄翅。花期3-5月，球果翌年5-6月成熟。"}]},{"ID":"20240614110625-8pl2giz","Type":"NodeParagraph","Properties":{"id":"20240614110625-8pl2giz","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614110625-ci0mksv","Type":"NodeParagraph","Properties":{"id":"20240614110625-ci0mksv","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 小枝扁平，棕褐色。叶细小，鳞片形，交互对生在小枝上，叶片先端锐尖，不紧贴生于枝上，而成刺状突起，手触时有刺感，叶面黄绿色或灰绿色。质脆，易断。气淡，味涩。以枝叶嫩、色深绿者为佳。"}]},{"ID":"20240614110625-bt452xc","Type":"NodeParagraph","Properties":{"id":"20240614110625-bt452xc","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 柏树叶与侧柏叶主要区别为，表皮和皮层有较多的含棕色物质的细胞，转输管胞的具缘孔少、草酸钙结晶主要少砂晶，偶见片状或柱状结晶。"}]},{"ID":"20240614110625-lhj0ubd","Type":"NodeParagraph","Properties":{"id":"20240614110625-lhj0ubd","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"3.理化鉴别 取本品粗粉3g，加甲醇30ml，置水浴上回流30min。滤过，滤液蒸干，残渣加5%碳酸钠15ml溶解，用水饱和正丁醇提取2次，每次10ml，再用稀盐酸调节Ph至3-4，用乙醚提取2次，每次10ml，合并醚液挥干，残渣用甲醇2ml溶解，作供试液。另取槲皮素适量，以甲醇溶解作对照液用。分别取上液10μl，点于同一硅胶GF/254薄层板上，以四苯：乙酸乙酯：甲酸（5：4：1）展开，置紫外灯下检视，供试品色谱中，在与对照品色谱相应的位置上，显相同色斑。"}]},{"ID":"20240614110625-n1u5b3k","Type":"NodeParagraph","Properties":{"id":"20240614110625-n1u5b3k","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614110625-ucpgnzf","Type":"NodeParagraph","Properties":{"id":"20240614110625-ucpgnzf","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 柏树叶含穗花杉双黄（amentoflavone），单甲基穗花杉双黄酮（monomethylamentoflavone），扁柏双黄酮（hi-nokiflavone），7″-单甲基扁柏双黄酮（7″-monomethylhinokifla-vone），柏木双黄酮（cupressuflavone）及其衍生物，脱镁叶绿素（pheophytin）a,10S和10R-羟基脱镁叶绿二酸二甲酯（methylpheophorbide）a,α-柏木萜烯（α-funebrene）。"}]},{"ID":"20240614110625-xh8wha3","Type":"NodeParagraph","Properties":{"id":"20240614110625-xh8wha3","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614110625-l77zh0h","Type":"NodeParagraph","Properties":{"id":"20240614110625-l77zh0h","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 苦；涩；性平"}]},{"ID":"20240614110625-x5nl58n","Type":"NodeParagraph","Properties":{"id":"20240614110625-x5nl58n","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614110625-tcmjrvl","Type":"NodeParagraph","Properties":{"id":"20240614110625-tcmjrvl","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 凉血止血；敛疮生肌。主吐血；血痢；痔疮；癞疮；烫伤；刀伤；毒蛇咬伤。"}]},{"ID":"20240614110625-94uzht4","Type":"NodeParagraph","Properties":{"id":"20240614110625-94uzht4","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614110625-alzz1dq","Type":"NodeParagraph","Properties":{"id":"20240614110625-alzz1dq","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g；或研末。外用：捣敷或研末调敷。"}]},{"ID":"20240614110625-x4wbwl4","Type":"NodeParagraph","Properties":{"id":"20240614110625-x4wbwl4","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614110625-6vkq2l0","Type":"NodeParagraph","Properties":{"id":"20240614110625-6vkq2l0","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" ①治刀伤：柏树嫩叶，嚼烂敷。(《重庆草药》) ②治蛇伤(目光复视)：柏树叶二两，香附全草二两，米泔水煎洗伤口。(江西《草药手册》)③治烫伤：柏叶捣汁搽。(江西《草药手册》)"}]},{"ID":"20240614110625-gftkudw","Type":"NodeParagraph","Properties":{"id":"20240614110625-gftkudw","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614110625-w92h4du","Type":"NodeParagraph","Properties":{"id":"20240614110625-w92h4du","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 1.治吐血：柏树子、柏树叶。打粉，兑酒吃，每次四钱。"}]},{"ID":"20240614110625-bzrto6n","Type":"NodeParagraph","Properties":{"id":"20240614110625-bzrto6n","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"2.治小儿肥疮：柏树嫩叶打粉(或煅打粉)，调油涂(洗净后涂)"}]},{"ID":"20240614110625-ky4agym","Type":"NodeParagraph","Properties":{"id":"20240614110625-ky4agym","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614110625-7oypk8e","Type":"NodeParagraph","Properties":{"id":"20240614110625-7oypk8e","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 1.《分类草药性》：和血。治肠风痔肿，痢疾，吐血；兼涂小儿肥疮。"}]},{"ID":"20240614110625-wq9eh5e","Type":"NodeParagraph","Properties":{"id":"20240614110625-wq9eh5e","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"2.《重庆草药》：止血生肌，治刀伤。"}]},{"ID":"20240614110625-1p66jf6","Type":"NodeParagraph","Properties":{"id":"20240614110625-1p66jf6","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"3.《广西药植名录》：治咳血，心气痛，筋缩症。"}]},{"ID":"20240614110625-qs6k5di","Type":"NodeParagraph","Properties":{"id":"20240614110625-qs6k5di","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614110625-jf8rni0","Type":"NodeParagraph","Properties":{"id":"20240614110625-jf8rni0","updated":"20240614110625"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614110626-19mr1fk","Type":"NodeThematicBreak","Properties":{"id":"20240614110626-19mr1fk"}},{"ID":"20240614110732-fs8ovm0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110732-fs8ovm0","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"《中国药典》：侧柏叶"}]},{"ID":"20240614110732-argqgka","Type":"NodeParagraph","Properties":{"id":"20240614110732-argqgka","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614110732-xlr66b5","Type":"NodeParagraph","Properties":{"id":"20240614110732-xlr66b5","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" Cè Bǎi Yè"}]},{"ID":"20240614110732-ix6gd4s","Type":"NodeParagraph","Properties":{"id":"20240614110732-ix6gd4s","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614110732-pqamjja","Type":"NodeParagraph","Properties":{"id":"20240614110732-pqamjja","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 扁柏、香柏、柏树、柏子树"}]},{"ID":"20240614110732-zcek741","Type":"NodeParagraph","Properties":{"id":"20240614110732-zcek741","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614110732-ogntwmf","Type":"NodeParagraph","Properties":{"id":"20240614110732-ogntwmf","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" CACUMEN PLATYCLADI"}]},{"ID":"20240614110732-x2ar6da","Type":"NodeParagraph","Properties":{"id":"20240614110732-x2ar6da","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614110732-sf5ktk7","Type":"NodeParagraph","Properties":{"id":"20240614110732-sf5ktk7","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 本品为柏科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"侧柏"},{"Type":"NodeText","Data":"Platycladus orientalis （L.）Franco 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枝梢"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"。多在夏、秋二季采收，阴干。"}]},{"ID":"20240614110732-crjkofk","Type":"NodeParagraph","Properties":{"id":"20240614110732-crjkofk","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614110732-32bel4o","Type":"NodeParagraph","Properties":{"id":"20240614110732-32bel4o","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 本品多分枝，小枝扁平。叶细小鳞片状，交互对生，贴伏于枝上，深绿色或黄绿色。质脆，易折断。气清香，味苦涩、微辛。"}]},{"ID":"20240614110732-trocih8","Type":"NodeParagraph","Properties":{"id":"20240614110732-trocih8","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614110732-k6ashga","Type":"NodeParagraph","Properties":{"id":"20240614110732-k6ashga","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240614110732-4qq4f4o","Type":"NodeParagraph","Properties":{"id":"20240614110732-4qq4f4o","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614110732-jjgc3qb","Type":"NodeParagraph","Properties":{"id":"20240614110732-jjgc3qb","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"侧柏叶"},{"Type":"NodeText","Data":"：除去硬梗及杂质。"}]},{"ID":"20240614110732-5p3szrw","Type":"NodeParagraph","Properties":{"id":"20240614110732-5p3szrw","updated":"20240614110732"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"侧柏炭"},{"Type":"NodeText","Data":"：取净侧柏叶，照炒炭法（附录Ⅱ D）炒至表面焦褐色，内部焦黄色。"}]},{"ID":"20240614110732-esuolcd","Type":"NodeParagraph","Properties":{"id":"20240614110732-esuolcd","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614110732-g7mfo8r","Type":"NodeParagraph","Properties":{"id":"20240614110732-g7mfo8r","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 本品粉末黄绿色。上表皮细胞长方形，壁略厚。下表皮细胞类方形；气孔甚多，凹陷型，保卫细胞较大，侧面观呈哑铃状。薄壁细胞含油滴。纤维细长，直径约18μm。具缘纹孔管胞有时可见。"}]},{"ID":"20240614110732-izi0fw7","Type":"NodeParagraph","Properties":{"id":"20240614110732-izi0fw7","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614110732-w9vgot2","Type":"NodeParagraph","Properties":{"id":"20240614110732-w9vgot2","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 归肺、肝、脾经。"}]},{"ID":"20240614110732-jz0wz8s","Type":"NodeParagraph","Properties":{"id":"20240614110732-jz0wz8s","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614110732-bgauk1z","Type":"NodeParagraph","Properties":{"id":"20240614110732-bgauk1z","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 苦、涩，寒。"}]},{"ID":"20240614110732-17pcvgn","Type":"NodeParagraph","Properties":{"id":"20240614110732-17pcvgn","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614110732-9nf3rr9","Type":"NodeParagraph","Properties":{"id":"20240614110732-9nf3rr9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 凉血止血，生发乌发。用于吐血衄血，咯血，便血，崩漏下血，血热脱发，须发早白。"}]},{"ID":"20240614110732-wkb90dq","Type":"NodeParagraph","Properties":{"id":"20240614110732-wkb90dq","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614110732-qndvc1a","Type":"NodeParagraph","Properties":{"id":"20240614110732-qndvc1a","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 6～12g；外用适量。"}]},{"ID":"20240614110732-amibh49","Type":"NodeParagraph","Properties":{"id":"20240614110732-amibh49","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614110732-9kwx87l","Type":"NodeParagraph","Properties":{"id":"20240614110732-9kwx87l","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240614110732-xxi580e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110732-xxi580e","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：侧柏叶"}]},{"ID":"20240614110732-yq38jtr","Type":"NodeParagraph","Properties":{"id":"20240614110732-yq38jtr","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614110732-4q82hoy","Type":"NodeParagraph","Properties":{"id":"20240614110732-4q82hoy","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" Cè Bǎi Yè"}]},{"ID":"20240614110732-4b7wt5p","Type":"NodeParagraph","Properties":{"id":"20240614110732-4b7wt5p","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614110732-qwe68m4","Type":"NodeParagraph","Properties":{"id":"20240614110732-qwe68m4","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 柏叶（《金匮要略》），丛柏叶（《闽东本草》）。"}]},{"ID":"20240614110732-skgxgdb","Type":"NodeParagraph","Properties":{"id":"20240614110732-skgxgdb","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614110732-j8sh0e3","Type":"NodeParagraph","Properties":{"id":"20240614110732-j8sh0e3","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 《药性论》"}]},{"ID":"20240614110732-vzdhi6h","Type":"NodeParagraph","Properties":{"id":"20240614110732-vzdhi6h","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614110732-ndb2abb","Type":"NodeParagraph","Properties":{"id":"20240614110732-ndb2abb","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 为柏科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"侧柏"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"嫩枝"},{"Type":"NodeText","Data":"与"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"。夏、秋采收，剪取小枝，晾干。"}]},{"ID":"20240614110732-jlnba6p","Type":"NodeParagraph","Properties":{"id":"20240614110732-jlnba6p","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614110732-arzx96w","Type":"NodeParagraph","Properties":{"id":"20240614110732-arzx96w","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 喜生湿润肥沃的山坡。全国大部分地区有分布。全国大部分地区有产。"}]},{"ID":"20240614110732-2ph10pt","Type":"NodeParagraph","Properties":{"id":"20240614110732-2ph10pt","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614110732-3nggae2","Type":"NodeParagraph","Properties":{"id":"20240614110732-3nggae2","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 侧柏（《药性论》）又名：柏（《诗经》），扁柏（《滇南本草》），崖柏、香柏、黄心柏、扁松、云片柏，松蟠、片松、喜柏。"}]},{"ID":"20240614110732-r0rde0n","Type":"NodeParagraph","Properties":{"id":"20240614110732-r0rde0n","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高达20米，直径可达1米。树冠圆锥形，分枝多，树皮红褐色，呈鳞片状剥落。小枝扁平，呈羽状排列。叶十字对生，细小鳞片状，紧贴于小枝上，亮绿色，端尖，背有凹陷的腺体1个。雌雄同株，雄球花多生在下部的小枝上，呈卵圆形，长2～3毫米，具短柄，有5～10对雄蕊；雌球花生于上部的小枝上，球形，无柄，直径3～4毫米，鳞片3对，有时4对，下面2对下半部肉质突起，基部各生有2个直立胚珠，球果卵圆形，长1.2～2.5厘米，肉质，浅蓝色，后变为木质，深褐色而硬，裂开，果鳞的顶端有一钩状刺，向外方卷曲。种子椭圆形，无刺，淡黄色，质柔软，长0.5厘米，径0.3厘米。花期4月。果期9～10月。"}]},{"ID":"20240614110732-oak5i23","Type":"NodeParagraph","Properties":{"id":"20240614110732-oak5i23","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614110732-bvf1d4c","Type":"NodeParagraph","Properties":{"id":"20240614110732-bvf1d4c","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 干燥枝叶，长短不一，分枝稠密。叶为细小鳞片状，贴伏于扁平的枝上，交互对生，青绿色。小枝扁平，线形，外表棕褐色。质脆，易折断。微有清香气，味微苦，微辛。以叶嫩、青绿色，无碎末者为佳。"}]},{"ID":"20240614110732-25iym8r","Type":"NodeParagraph","Properties":{"id":"20240614110732-25iym8r","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614110732-wz963xv","Type":"NodeParagraph","Properties":{"id":"20240614110732-wz963xv","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 叶含挥发油0.6～1％，中含侧柏烯、侧柏酮、小茴香酮、蒎烯、石竹烯等；黄酮类中有香橙素、槲皮素、杨梅树皮素、扁柏双黄酮、穗花杉双黄酮等。新鲜侧柏叶的粗制总黄酮含量为1.72％。还含鞣质、树脂、维生素C等。"}]},{"ID":"20240614110732-22qelkg","Type":"NodeParagraph","Properties":{"id":"20240614110732-22qelkg","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614110732-ktt2xmg","Type":"NodeParagraph","Properties":{"id":"20240614110732-ktt2xmg","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 提取物对小鼠有镇咳（氨水法）、祛痰（酚红法）作用。对其有效成分进行了分离，所含之醇性皂甙祛痰作用较强，其镇咳成分可能为一种酚性甙。对豚鼠的致喘无明显保护作用（组织胺喷雾法），但能舒张豚鼠离体气管平滑肌，并可部分阻断乙酰胆碱的作用，不能解除乙酰胆碱之致痉作用。叶中所含之黄酮250毫克／公斤腹腔注射有明显镇咳作用，200毫克／公斤腹腔注射及1000毫克／公斤口服有明显祛痰作用。叶中的有效部分提取物Ⅱ号（醋酸乙酯提取物）250毫克／公斤腹腔注射有明显镇咳作用，100及200毫克／公斤有明显祛痰作用。"}]},{"ID":"20240614110732-hp97c4p","Type":"NodeParagraph","Properties":{"id":"20240614110732-hp97c4p","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"可协同戊巴比妥钠之麻醉作用，明显减少动物之自主活动，故有中枢镇静作用。此外，可舒张离体肠段平滑肌，且可明显解除组织胺与乙酰胆碱所致肠痉挛，事先给予则可阻断两者之致痉作用。还可明显扩张兔耳血管，降低血压（麻醉猫）。"}]},{"ID":"20240614110732-l9hlila","Type":"NodeParagraph","Properties":{"id":"20240614110732-l9hlila","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"醇浸剂（1：180000）在试管中对结核杆菌的生长有抑制作用，较水煎剂强1800倍，且与异烟胼有协同作用。对肺炎球菌、卡他球菌有抑制作用。侧柏叶、小叶冬青复方对肺炎欢球菌、流感杆菌、金黄色葡萄球菌、肺炎杆菌及甲型链球菌等也有抑制作用。侧柏叶煎剂1:40对京科68-1型病毒有抑制作用。其中所含之侧柏酮在其对动物无害的剂量（1～10毫克／公斤）时，既不影响大鼠的自发活动，也不改变其后天学得的行为（只是使此种行为更加协调），很大剂量也不影响大脑皮层的呼吸活动。小白鼠口服60克／公斤，观察72小时，未见死亡，腹腔注射水煎剂半数致死量为15.2克／公斤，水煎剂醇沉淀后的制剂则为30.5克／公斤，毒性不大。"}]},{"ID":"20240614110732-ta7xekx","Type":"NodeParagraph","Properties":{"id":"20240614110732-ta7xekx","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614110732-rcfroqt","Type":"NodeParagraph","Properties":{"id":"20240614110732-rcfroqt","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 侧柏叶：拣净杂质，揉碎去梗，筛净灰屑。侧柏炭：取净侧柏叶，置锅内用武火炒至焦褐色，存性，喷洒清水，取出，晒干。"}]},{"ID":"20240614110732-qjpsr43","Type":"NodeParagraph","Properties":{"id":"20240614110732-qjpsr43","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614110732-t536ilh","Type":"NodeParagraph","Properties":{"id":"20240614110732-t536ilh","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 入心、肝、大肠经。"}]},{"ID":"20240614110732-1uivdnk","Type":"NodeParagraph","Properties":{"id":"20240614110732-1uivdnk","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"①《药品化义》：\"入肝、心、脾、肺四经。\""}]},{"ID":"20240614110732-nv6puzn","Type":"NodeParagraph","Properties":{"id":"20240614110732-nv6puzn","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②《要药分剂》：\"入肝、肾二经。\""}]},{"ID":"20240614110732-qomuzue","Type":"NodeParagraph","Properties":{"id":"20240614110732-qomuzue","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》：\"入手足太阴、阳明。\""}]},{"ID":"20240614110732-5rf078i","Type":"NodeParagraph","Properties":{"id":"20240614110732-5rf078i","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614110732-84o2mj3","Type":"NodeParagraph","Properties":{"id":"20240614110732-84o2mj3","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 苦涩，寒。"}]},{"ID":"20240614110732-mc74fuj","Type":"NodeParagraph","Properties":{"id":"20240614110732-mc74fuj","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味苦辛，性涩。\""}]},{"ID":"20240614110732-n1atb4n","Type":"NodeParagraph","Properties":{"id":"20240614110732-n1atb4n","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"性寒。\""}]},{"ID":"20240614110732-7xr1r77","Type":"NodeParagraph","Properties":{"id":"20240614110732-7xr1r77","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"味苦涩，性凉。\""}]},{"ID":"20240614110732-rcr2ot4","Type":"NodeParagraph","Properties":{"id":"20240614110732-rcr2ot4","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614110732-ik896dn","Type":"NodeParagraph","Properties":{"id":"20240614110732-ik896dn","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" ①《药性论》：\"与酒相宜。\""}]},{"ID":"20240614110732-ihfbmf9","Type":"NodeParagraph","Properties":{"id":"20240614110732-ihfbmf9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②《本草述》：\"多食亦能倒胃。\""}]},{"ID":"20240614110732-bp8dbeh","Type":"NodeParagraph","Properties":{"id":"20240614110732-bp8dbeh","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614110732-664zdgg","Type":"NodeParagraph","Properties":{"id":"20240614110732-664zdgg","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 凉血，止血，祛风湿，散肿毒。治吐血、衄血、尿血、血痢、肠风、崩漏，风湿痹痛，细菌性痢疾，高血压，咳嗽，丹毒，痄腮，烫伤。"}]},{"ID":"20240614110732-8sa6h32","Type":"NodeParagraph","Properties":{"id":"20240614110732-8sa6h32","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主吐血、衄血、痢血、崩中赤白。轻身益气，令人耐寒暑，去湿痹，生肌。\""}]},{"ID":"20240614110732-50fbogv","Type":"NodeParagraph","Properties":{"id":"20240614110732-50fbogv","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"止尿血，能治冷风历节疼痛。\""}]},{"ID":"20240614110732-pnt03n9","Type":"NodeParagraph","Properties":{"id":"20240614110732-pnt03n9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"炙窨冻疮。\""}]},{"ID":"20240614110732-1dfhe39","Type":"NodeParagraph","Properties":{"id":"20240614110732-1dfhe39","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"④《本草图经》：\"杀五藏虫。\""}]},{"ID":"20240614110732-whmogmx","Type":"NodeParagraph","Properties":{"id":"20240614110732-whmogmx","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"善清血凉血，去湿热湿痹，骨节疼痛。捣烂可敷火丹，散痄腮肿痛热毒。\""}]},{"ID":"20240614110732-a0bkdls","Type":"NodeParagraph","Properties":{"id":"20240614110732-a0bkdls","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑥《生草药性备要》：\"散血敷疮，同片糖捶敷。亦治跌打。\""}]},{"ID":"20240614110732-zpwspv1","Type":"NodeParagraph","Properties":{"id":"20240614110732-zpwspv1","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑦《医林纂要》：\"泄肺逆，泻心火，平肝热，清血分之热。\""}]},{"ID":"20240614110732-ieexm02","Type":"NodeParagraph","Properties":{"id":"20240614110732-ieexm02","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑧《岭南采药录》：\"凉血行气，祛风，利小便，散瘀。\""}]},{"ID":"20240614110732-ei40tj3","Type":"NodeParagraph","Properties":{"id":"20240614110732-ei40tj3","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614110732-czjzyqw","Type":"NodeParagraph","Properties":{"id":"20240614110732-czjzyqw","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；或入丸、散。外用：煎水洗、捣敷或研末调敷。"}]},{"ID":"20240614110732-ghcepzk","Type":"NodeParagraph","Properties":{"id":"20240614110732-ghcepzk","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614110732-0xzgi7p","Type":"NodeParagraph","Properties":{"id":"20240614110732-0xzgi7p","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" ①治吐血不止：柏叶、干姜各三两，艾三把。上三味，以水五升，取马通汁一升，合煮，取一升，分温再服。（《金匮要略》柏叶汤）"}]},{"ID":"20240614110732-luz7noi","Type":"NodeParagraph","Properties":{"id":"20240614110732-luz7noi","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②治忧恚呕血，烦满少气，胸中疼痛：柏叶捣罗为散，不计时侯，以粥饮调下二钱。（《圣惠方》）"}]},{"ID":"20240614110732-0mvpi5s","Type":"NodeParagraph","Properties":{"id":"20240614110732-0mvpi5s","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"③治鼻衄出血数升，不知人事：石榴花、柏叶等分。为末，吹鼻中。（《普济方》）"}]},{"ID":"20240614110732-3mtlk2h","Type":"NodeParagraph","Properties":{"id":"20240614110732-3mtlk2h","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"④治小便尿血：柏叶，黄连（焙研）。酒服三钱。（《济急仙方》）"}]},{"ID":"20240614110732-9k2qr6j","Type":"NodeParagraph","Properties":{"id":"20240614110732-9k2qr6j","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑤治蛊痢，大腹下黑血，茶脚色，或脓血如靛色：柏叶（焙干为末）、黄连。二味同煎为汁服之。（《本草图经》）"}]},{"ID":"20240614110732-xdibf0h","Type":"NodeParagraph","Properties":{"id":"20240614110732-xdibf0h","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑥治小儿洞痢：柏叶煮汁，代茶饮之。（《经验方》）"}]},{"ID":"20240614110732-tnen5xz","Type":"NodeParagraph","Properties":{"id":"20240614110732-tnen5xz","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑦治痔、肠风、脏毒、下血不止：柏叶烧灰调服。（《百一选方》）"}]},{"ID":"20240614110732-jjkhxoe","Type":"NodeParagraph","Properties":{"id":"20240614110732-jjkhxoe","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑧治肠风、脏毒，酒痢，下血不止：嫩柏叶（九蒸九晒）二两，陈槐花一两（炒半黑色）。上为末，炼蜜丸，梧桐子大。每服四、五十丸，空心温酒下。（《普济方》侧柏散）"}]},{"ID":"20240614110732-2qq2yry","Type":"NodeParagraph","Properties":{"id":"20240614110732-2qq2yry","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑨治妇人月水久不断：芍药、柏叶（炙）各一两。上二味，粗捣筛。每服三钱匕，水、酒各半盏，煎至七分，去滓温服。（《圣济总录》芍药汤）"}]},{"ID":"20240614110732-vkbj2k6","Type":"NodeParagraph","Properties":{"id":"20240614110732-vkbj2k6","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑩治历节风痛，痛如虎咬，走注周身，不能转动，动即痛极，昼夜不宁：侧柏叶五钱，木通，当归、红花、羌活、防风各二钱。水煎服。（《本草切要》）"}]},{"ID":"20240614110732-764bio2","Type":"NodeParagraph","Properties":{"id":"20240614110732-764bio2","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑾治风痹历节作痛：侧柏叶煮汁，同曲米酿酒饮。（《纲目》柏叶酒）"}]},{"ID":"20240614110732-rm3yas0","Type":"NodeParagraph","Properties":{"id":"20240614110732-rm3yas0","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑿治大人及小儿汤火伤：侧柏叶，入臼中湿捣令极烂如泥，冷水调作膏，涂敷于伤处，用帛子系定，三，二日疮当敛，仍灭瘢。（《本草图经》）"}]},{"ID":"20240614110732-4zimmlq","Type":"NodeParagraph","Properties":{"id":"20240614110732-4zimmlq","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⒀治高血压：侧柏叶五钱。切碎，水煎代茶饮，至血压正常为止。（《江苏省中草药新医疗法展览资料选编》）"}]},{"ID":"20240614110732-7wyi895","Type":"NodeParagraph","Properties":{"id":"20240614110732-7wyi895","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⒁治深部脓肿：侧柏叶一两，白矾五钱，酒一两。先将侧柏叶捣碎，又将白矾细粉置酒中溶化，再将侧柏叶倒入酒内和匀，调敷患处，每日换药二次。（《江苏省中草药新医疗法展览资料选编》）"}]},{"ID":"20240614110732-egh19z3","Type":"NodeParagraph","Properties":{"id":"20240614110732-egh19z3","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⒂治流行性腮腺炎：扁柏叶适量，洗净捣烂，加鸡蛋白调成泥状外敷，每天换药二次。（《草医草药简便验方汇编》）"}]},{"ID":"20240614110732-vt5njbt","Type":"NodeParagraph","Properties":{"id":"20240614110732-vt5njbt","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⒃治鹅掌风：鲜侧柏叶，放锅内水煮二、三沸，先熏后洗，一日二、三次。（《河北中医药集锦》）"}]},{"ID":"20240614110732-ositbi9","Type":"NodeParagraph","Properties":{"id":"20240614110732-ositbi9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614110732-2f6lcwc","Type":"NodeParagraph","Properties":{"id":"20240614110732-2f6lcwc","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" ①治疗急、慢性细菌性痢疾"}]},{"ID":"20240614110732-e1tmy2a","Type":"NodeParagraph","Properties":{"id":"20240614110732-e1tmy2a","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"将侧柏叶晒干或焙干后研成粗末，加入18％的酒精，以浸漫药粉为度，浸泡4昼夜，滤取浸液。每次50毫升（儿童酌减），日服3次，7～10天为一疗程。共治114例，治愈100例，治愈率87.7％。实验证明，本浸剂有较好的抑菌或杀菌效果。如经煮沸、高压消毒，或加防腐剂，则会影响疗效。"}]},{"ID":"20240614110732-98zw1il","Type":"NodeParagraph","Properties":{"id":"20240614110732-98zw1il","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②治疗慢性气管炎"}]},{"ID":"20240614110732-gevbt4f","Type":"NodeParagraph","Properties":{"id":"20240614110732-gevbt4f","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"取侧柏叶3700克，水煎浓缩成1：2的稠膏；另用侧柏叶300克研成细粉，拌入稠膏中，烘干，压制成片，每片重0.5克。每日3次，每次4片，饭后服，连服10天为一疗程。或用侧柏叶、鼠曲草（即佛耳草）各1.5两，制成片剂，一日分三次饭后服，连服10天为一疗程。疗效：㈠单纯型：用单味片剂治疗538例，近期控制28例（5.2％），显效70例（13％）；复方片剂治疗395例，近期控制1S例（3.8％），显效54例（13.7％）。㈡喘息型：用单味片剂治疗179例，近期控制7例（4％），显效37例（20.6％）；复方片剂治疗235例，近期控制6例（2.3％），显效29例（12.3％）。副反应有上腹部不适、腹胀、恶心、呕吐、胃纳不佳、咽干、头晕等，不需处理，短时间内能自行消失。少数病员曾出现皮疹瘙痒或眼睑、面部、下肢浮肿，可能系药物过敏反应，停药后即自行消失。"}]},{"ID":"20240614110732-4jifrfk","Type":"NodeParagraph","Properties":{"id":"20240614110732-4jifrfk","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"③治疗肺结核"}]},{"ID":"20240614110732-47cc5ww","Type":"NodeParagraph","Properties":{"id":"20240614110732-47cc5ww","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"㈠静脉点滴：100％侧柏叶注射液20～30毫升加入10％葡萄糖溶液150毫升中，1小时左右滴完；㈡静脉注射：100％侧柏叶注射液20～30毫升加入10％葡萄糖溶液30毫升中，15分钟左右注射完毕。64例患者经治1个月以上，临床治愈9例，显著好转6例，好转32例，无变化12例，恶化5例。疗程一般为2个月，对新鲜结核病灶和浸润期疗效较好，对陈旧性结核及厚壁纤维空洞型疗效较差。应用过程中未见毒性反应。"}]},{"ID":"20240614110732-efkjqo0","Type":"NodeParagraph","Properties":{"id":"20240614110732-efkjqo0","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"④治疗百日咳"}]},{"ID":"20240614110732-s2yqtx6","Type":"NodeParagraph","Properties":{"id":"20240614110732-s2yqtx6","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"用新鲜侧柏叶（连幼枝）1两，加水煎成100毫升，再加蜂蜜20毫升。如用干品，则每两煎成150毫升，另加蜂蜜30毫升。剂量：1岁以内每次10～15毫升，1～3岁15～30毫升，4岁以上30～50毫升，均日服3次。视病情需要连服1～3周。治疗越早，疗效越高，疗程亦短。配制本剂时可酌加防腐剂，否则超过4天即转酸味或起白沫。侧柏以新鲜者效果较佳。"}]},{"ID":"20240614110732-jwrep26","Type":"NodeParagraph","Properties":{"id":"20240614110732-jwrep26","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑤治疗溃疡病并发出血"}]},{"ID":"20240614110732-4unstm6","Type":"NodeParagraph","Properties":{"id":"20240614110732-4unstm6","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"剂型与服法：㈠煎剂：侧柏叶5钱，加水300毫升，煎成150毫升为1次量，日服3次。㈡粉剂：以侧柏叶研末焙制而成，每次3克，日服3次。除服药外，仍采用一般内科保守疗法，如静卧、保暖及流质饮食等。疗效：治疗胃及十二指肠溃疡出血50例，大便潜血平均3.5天转阴。对合并动脉硬化或高血压的患者，止血亦较迅速。除个别服药后有恶心外，一般无不良反应。对照病例采用胃病饮食、补液、输血、镇静及凝血剂等，其大便潜血转阴时间平均为4.5天。有人认为侧柏叶对溃疡病合并出血的疗效超过乌贼骨与白及粉。"}]},{"ID":"20240614110732-vcqmrjg","Type":"NodeParagraph","Properties":{"id":"20240614110732-vcqmrjg","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑥治疗秃发"}]},{"ID":"20240614110732-uzp59d7","Type":"NodeParagraph","Properties":{"id":"20240614110732-uzp59d7","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"用鲜侧柏叶浸泡于60％酒精中，7天后滤取药液，涂擦毛发脱落部位，每日3次。观察13例（均为前额、头顶至后枕部脱发，斑秃不在此列），治后全部均见毛发生长，如能坚持连续涂擦并酌量增加药物浓度，则毛发生长可较密，同时也不易脱落。"}]},{"ID":"20240614110732-v2lpmi1","Type":"NodeParagraph","Properties":{"id":"20240614110732-v2lpmi1","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614110732-q7jrsu6","Type":"NodeParagraph","Properties":{"id":"20240614110732-q7jrsu6","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义补遗》：\"柏叶，补阴之要药，其性多燥，久得之，大益脾土，以滋其肺。\""}]},{"ID":"20240614110732-hg14rjn","Type":"NodeParagraph","Properties":{"id":"20240614110732-hg14rjn","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"侧柏叶，味苦而微温，义应并于微寒，故得主诸血崩中赤白。若夫轻身益气，令人耐寒暑，则略同于柏实之性矣。惟生肌去湿痹，乃其独擅之长也。\""}]},{"ID":"20240614110732-1qklfo7","Type":"NodeParagraph","Properties":{"id":"20240614110732-1qklfo7","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"侧柏叶，止流血，去风湿之药也。凡吐血、衄血、崩血、便血，血热流溢于经络者，捣汁服之立止；凡历节风痱周身走注，痛极不能转动者，煮汁饮之即定。惟热伤血分与风湿伤筋脉者，两病专司其用。但性味苦寒多燥，如血病系热极妄行者可用，如阴虚肺燥，因咳动血者勿用也。如痹病系风湿闭滞者可用，如肝肾两亏，血枯髓败者勿用也。\""}]},{"ID":"20240614110732-rf13a16","Type":"NodeParagraph","Properties":{"id":"20240614110732-rf13a16","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"侧柏叶，昧苦滋阴，带涩敛血，专清上部逆血。又得阴气最厚，如遗精、白浊、尿管涩痛属阴脱者，同牛膝治之甚效。\""}]},{"ID":"20240614110732-2bej6bu","Type":"NodeParagraph","Properties":{"id":"20240614110732-2bej6bu","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"⑤《本经逢原》：\"柏叶，性寒而燥，大能伐胃，虽有止衄之功，而无阳生之力，故亡血虚家不宜擅服。然配合之力，功过悬殊，如《金匮》柏叶汤，同姜、艾止吐血不止，当无此虑矣。若《济急方》同黄连治小便血；《圣济总录》同芍药治月水不断，纵借酒之辛温，以行苦寒之势，但酒力易过，苦寒长留，每致减食作泻，瘀积不散，是岂柏叶之过欤?\""}]},{"ID":"20240614110732-7wlrmfs","Type":"NodeParagraph","Properties":{"id":"20240614110732-7wlrmfs","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614110732-h5jx57q","Type":"NodeParagraph","Properties":{"id":"20240614110732-h5jx57q","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 西藏地区所用的侧柏叶，为喜马拉雅柏木和曲枝柏的叶。上述植物的种仁，在当地亦作柏子仁入药。"}]},{"ID":"20240614110732-1bx62fc","Type":"NodeParagraph","Properties":{"id":"20240614110732-1bx62fc","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614110732-9w1d790","Type":"NodeParagraph","Properties":{"id":"20240614110732-9w1d790","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614110732-fp6vnh7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614110732-fp6vnh7","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"《中华本草》：侧柏叶"}]},{"ID":"20240614110732-zwyjj45","Type":"NodeParagraph","Properties":{"id":"20240614110732-zwyjj45","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614110732-4yu1do3","Type":"NodeParagraph","Properties":{"id":"20240614110732-4yu1do3","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" Cè Bǎi Yè"}]},{"ID":"20240614110732-aazp1bv","Type":"NodeParagraph","Properties":{"id":"20240614110732-aazp1bv","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614110732-r7su07o","Type":"NodeParagraph","Properties":{"id":"20240614110732-r7su07o","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 柏叶、扁柏叶、丛柏叶"}]},{"ID":"20240614110732-glrnne1","Type":"NodeParagraph","Properties":{"id":"20240614110732-glrnne1","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614110732-uff5n6r","Type":"NodeParagraph","Properties":{"id":"20240614110732-uff5n6r","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》。"}]},{"ID":"20240614110732-c00ds5w","Type":"NodeParagraph","Properties":{"id":"20240614110732-c00ds5w","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：柏有数种，入药惟取叶扁而侧生者，故曰扁柏。其树耸直，其皮薄，其肌腻，其花细琐，其实成丛，状如小铃。霜后四裂，中有数子，大如麦粒，芬芳可爱。柏叶松身者，桧也。松叶柏身者，枞也。松桧相半者，桧柏也。峨眉山中一种竹叶柏身者，谓之竹柏。"}]},{"ID":"20240614110732-su5f1zu","Type":"NodeParagraph","Properties":{"id":"20240614110732-su5f1zu","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614110732-jrie2uz","Type":"NodeParagraph","Properties":{"id":"20240614110732-jrie2uz","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 药材基源：为柏科植物侧柏的枝梢与叶。"}]},{"ID":"20240614110732-ec5gr6t","Type":"NodeParagraph","Properties":{"id":"20240614110732-ec5gr6t","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Platycladus orientalis(L.)Franco[Thujaorientalis L.;Biota orientalis(L.)Endl.]"}]},{"ID":"20240614110732-8q853n1","Type":"NodeParagraph","Properties":{"id":"20240614110732-8q853n1","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采收，以夏、秋季采收者为佳。剪下大枝。干燥后取其小枝叶，扎成小把，置通风处风干。不宜曝晒。"}]},{"ID":"20240614110732-eu6vf2r","Type":"NodeParagraph","Properties":{"id":"20240614110732-eu6vf2r","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614110732-coica2h","Type":"NodeParagraph","Properties":{"id":"20240614110732-coica2h","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于湿润肥沃地，石灰岩石地也有生长。"}]},{"ID":"20240614110732-3k9f6m9","Type":"NodeParagraph","Properties":{"id":"20240614110732-3k9f6m9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北南部，经华北向南过广东、广西北部，西至陕西、甘肃、西南至四川、云南、贵州等地。"}]},{"ID":"20240614110732-b6ya4jm","Type":"NodeParagraph","Properties":{"id":"20240614110732-b6ya4jm","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614110732-lxu3hss","Type":"NodeParagraph","Properties":{"id":"20240614110732-lxu3hss","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 常绿乔木，高达20m，胸径可达1m。树皮薄，浅灰褐色，纵裂成条片。小枝扁平，直展，排成一平面。叶鳞形，交互对生，长1-3mm，先端微钝，位于小枝上下两面之叶露出部分倒卵状菱形或斜方形，两侧的叶折覆着上下之叶的基部两侧，呈龙骨状。叶背中部均有腺槽。雌雄同株；球花单生于短枝顶端；雄球花黄色，卵圆形，长约2mm。球果当年成熟，卵圆形，长1.5-2cm,熟前肉质，蓝绿色，被白粉；熟后木质，张开，红褐色；种鳞4对，扁平，背部近先端有反曲的尖头，中部种鳞各有种子1-2颗。种子卵圆形或长卵形，长4-6mm，灰褐色或紫褐色，无翅或有棱脊，种脐大而明显。花期3-4月，球果9-11月成熟。"}]},{"ID":"20240614110732-m89xjjr","Type":"NodeParagraph","Properties":{"id":"20240614110732-m89xjjr","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614110732-tfwgdtp","Type":"NodeParagraph","Properties":{"id":"20240614110732-tfwgdtp","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 枝长短不一，多分枝，小枝扁平。叶细小鳞片状，交互对生，贴伏于枝上，深绿色或黄绿色。质脆，易折断。气清香，味苦、涩、微辛。以叶嫩、青绿色、无碎末者为佳。"}]},{"ID":"20240614110732-x07ni22","Type":"NodeParagraph","Properties":{"id":"20240614110732-x07ni22","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 鳞叶及小枝横切面：表皮细胞小，呈类方形，外被角质层，气孔内陷；内侧有1-2列下皮纤维间断排列，壁极厚；叶肉薄壁细胞形大，叶脉维管束上部有一圆形树脂道，两侧为转输组织，呈翅状延长，韧皮部细胞形小，木质部细胞多角形。小枝的皮层薄壁组织中有时可见树脂道，内侧可见含棕色物质的扁平细胞；韧皮部薄壁细胞不规则形，纤维圆形，单个环状排成数轮；木质部管胞和纤维径向排列整齐，射线1列细胞；髓部纺锤形或十字形。射线、叶肉和皮层薄壁细胞中含有草酸钙砂晶。"}]},{"ID":"20240614110732-u20lw2x","Type":"NodeParagraph","Properties":{"id":"20240614110732-u20lw2x","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"3.理化鉴别 薄层色谱：取本品粗粉3g，加甲醇30ml，置水浴上回流30min，滤过。滤液蒸干，残渣加5%的碳酸钠15ml溶解，滤液用水饱和正丁醇提取2次，每次10ml，再用稀盐酸调Ph至3-4，用乙醚提取2次，每次10ml。合并醚液，挥干，残渣用甲醇2ml 溶解，为供试品溶液。另取槲皮素适量用甲醇2ml溶解，为对照分别取对照品溶液和供试液10μl点于同一硅胶GF/254薄层板上。以甲苯-乙酸乙酯-甲酸（5：4：1）为展开剂，展距12cm，置紫外光灯下观察。供试品色谱中，在与对照品色谱的相应的位置上，显相同的暗斑。"}]},{"ID":"20240614110732-9gccbcu","Type":"NodeParagraph","Properties":{"id":"20240614110732-9gccbcu","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614110732-k6amfvr","Type":"NodeParagraph","Properties":{"id":"20240614110732-k6amfvr","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 侧柏酮在其对动物无害的剂量(1-10mg/kg)时，既不影响大鼠的自发活动，也不改变其后天学得的行为(只是使此种行为更加协调)，很大剂量也不影响大脑皮层的呼吸活动。小白鼠口服60g／kg，观察72小时，未见死亡，腹腔注射水煎剂半数致死量为15.2g/kg，水煎剂醇沉淀后的制剂则为30.5g/kg，毒性不大。小鼠灌胃侧柏叶煎剂60g／kg，观察72小时、未见死亡；小鼠腹腔注射急性LD50为15.2g／kg，水煎剂经醇沉后部份小鼠腹腔注射LD50为30.5g／kg；表明水煎剂经醇沉后，毒性就明显降低。侧柏叶的石油醚提取物灌胃对小鼠的LD50为2964mg／kg；大白鼠分别从相当临床剂量的20倍(即24g／kg)和40倍剂量(48g/kg)的煎剂连续灌胃6周，除动物活动减少，食量比对照组稍有减少外，对生长、肝功能、血象及病理检查均有明显影响。"}]},{"ID":"20240614110732-7c9vew0","Type":"NodeParagraph","Properties":{"id":"20240614110732-7c9vew0","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614110732-041kkb7","Type":"NodeParagraph","Properties":{"id":"20240614110732-041kkb7","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 叶含挥发油0.26%,油中主成分为α-侧柏酮（α-thujone），含侧柏烯（thujene），小茴香酮（fechone），蒎烯（pinene），丁香烯（caryphyllene）等。还含脂类成分：棕榈酸（palmitic acid），硬脂酸（stearic acid），月桂酸（lauric acid），肉豆蔻酸（myristic acid），油酸（oleic acid），亚油酸（linoleic acid），癸酸（capric acid）。又含黄酮类成分：柏木双黄酮（cupressuflavo-ne），芹菜素（apigenin），槲皮甙（quercitrin），山柰酚-7-O-葡萄糖甙（kaempferol-7-O-glucoside），槲皮素-7-O-鼠李糖甙（quercetin-7-O-rhamnoside），杨梅树皮素-3-O-鼠李糖甙（myricetin-3-O-α-L-rhamnoside），杨梅树皮素（myricetin），扁柏双黄酮（hinoki-flavone），穗花杉双黄酮（amentoflavone）等。另含10-二十九烷醇（10-nonacosanol），β-谷甾醇（β-sitosterol），缩合鞣质（condensed tannin），去氧鬼臼毒素（deoxypodophyllotoxin），异海松酸（isopimaric acid）。"}]},{"ID":"20240614110732-wrb33j0","Type":"NodeParagraph","Properties":{"id":"20240614110732-wrb33j0","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614110732-guscdio","Type":"NodeParagraph","Properties":{"id":"20240614110732-guscdio","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 1.镇咳作用 本品煎剂的醇沉部份、醇提取液10g／kg及其提取物黄酮250mg／kg腹腔注射，对小鼠由SO2所致的咳嗽，均有镇咳作用，石油醚提取物，乙醚析出物及酚性物对小鼠氨熏法所致咳嗽；均有显着的镇咳作用。电刺激猫喉上神经实验表明，具有明显的镇咳作用，故其作用部位可能在中枢。"}]},{"ID":"20240614110732-03o0zha","Type":"NodeParagraph","Properties":{"id":"20240614110732-03o0zha","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"2.祛痰作用 小鼠酚红排泌法证明，本品醇提取液、石油醚提取物或醇沉淀物等，均有明显的祛痰作用。近年来分及一种祛痰有效成分异海松酸。但煎剂的醇沉部份对大鼠则未见气管分泌物明显增加。本品石油醚提取物，能增加家兔呼吸道排泌酚红的作用，在切断两侧迷走神经后，仍有祛痰作用，故认为其作用可能不是通过神经反射所致，但侧柏叶石油醚的提取物，对鸡毛管纤毛运行印度油墨的速度并无明显影响。初步认为本品的祛痰方式可能主要是对支气管粘膜的直接作用。"}]},{"ID":"20240614110732-872ej5a","Type":"NodeParagraph","Properties":{"id":"20240614110732-872ej5a","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"3.平喘作用 本品煎剂醇沉后部份，对小鼠及豚鼠离体气管平滑肌均有松弛作用，并有部份阻断乙酰胆碱的作用。进一步的实验发现其有效部份主要在醋酸乙酯提取部份，但对豚鼠组胺性哮喘无明显保护作用。此外，本品对大鼠气管一肺组织呼吸有降低组织耗氧量的作用。"}]},{"ID":"20240614110732-9d6awv9","Type":"NodeParagraph","Properties":{"id":"20240614110732-9d6awv9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"4.止血作用 用小鼠测定出血时间及用兔毛细血管法进行凝血试验，均证明侧柏叶煎剂对小鼠出血时间及兔凝血时间均有明显缩短，显示有一定止血作用。但侧柏炭的凝血作用则比生品略差。"}]},{"ID":"20240614110732-66l2ms9","Type":"NodeParagraph","Properties":{"id":"20240614110732-66l2ms9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"5.镇静作用 本品煎剂能显着减少小鼠自发活动和延长戊巴比妥钠的睡眠时间，但对咖啡因所致惊厥无拮抗作用。而侧柏酮10mg／kg长期应用后，既不影响大鼠的自发活动，也不改变其条件行为，但仅使其活动协调得更好。甚至于侧柏酮经大剂量给药时，也不影响大脑皮层的组织呼吸。"}]},{"ID":"20240614110732-enyh5gp","Type":"NodeParagraph","Properties":{"id":"20240614110732-enyh5gp","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"6.对循环系统的影响 本品煎剂醇沉淀后的部份给麻醉猫静脉注射或灌胃，均可使血压轻度下降，并对离体兔耳血管也有扩张作用。"}]},{"ID":"20240614110732-yjy4qxy","Type":"NodeParagraph","Properties":{"id":"20240614110732-yjy4qxy","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"7.抗菌作用 本品煎剂在试管内，对金黄色葡萄球菌、卡他球菌、痢疾杆菌、伤寒杆菌、白喉杆菌、乙型链球菌、炭疽杆菌等均有抑制作用，本品水浸剂1：100或其醇浸剂1：180，000时，对结核杆菌有抑制作用，且和异烟肼有协同作用，但另有报告却认为无效。侧柏叶煎剂(1：40)对流感病毒京科68-1.疱疹病毒均有抑制作用。"}]},{"ID":"20240614110732-6uen4qt","Type":"NodeParagraph","Properties":{"id":"20240614110732-6uen4qt","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"8.其它作用：本品煎剂醇沉后部分60g／kgl次给药或30g／kg每天1次，连续3天，均对大鼠肾上腺维生素C含量无明显影响，表明它的作用和垂体-肾上腺皮质功能无关。煎剂醇沉后部份对豚鼠离体肠段呈明显的舒张作用。"}]},{"ID":"20240614110732-ncq55d9","Type":"NodeParagraph","Properties":{"id":"20240614110732-ncq55d9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614110732-50nctso","Type":"NodeParagraph","Properties":{"id":"20240614110732-50nctso","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 1.侧柏叶：拣净杂质，揉碎去梗，筛净灰屑。"}]},{"ID":"20240614110732-sbmkrlp","Type":"NodeParagraph","Properties":{"id":"20240614110732-sbmkrlp","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"2.侧柏炭：取净侧柏叶，置锅内用武火炒至焦褐色，存性，喷洒清水，取出，晒干。"}]},{"ID":"20240614110732-h7lzaaj","Type":"NodeParagraph","Properties":{"id":"20240614110732-h7lzaaj","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614110732-vdw08pu","Type":"NodeParagraph","Properties":{"id":"20240614110732-vdw08pu","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 肺；肝；大肠经"}]},{"ID":"20240614110732-egf8m9a","Type":"NodeParagraph","Properties":{"id":"20240614110732-egf8m9a","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614110732-442sy7s","Type":"NodeParagraph","Properties":{"id":"20240614110732-442sy7s","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 苦；涩；性微寒"}]},{"ID":"20240614110732-xcgu14t","Type":"NodeParagraph","Properties":{"id":"20240614110732-xcgu14t","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614110732-b0jgz1b","Type":"NodeParagraph","Properties":{"id":"20240614110732-b0jgz1b","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 《药性论》：与酒相宜。《本草述》：多食亦能倒胃。"}]},{"ID":"20240614110732-tqowsv9","Type":"NodeParagraph","Properties":{"id":"20240614110732-tqowsv9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614110732-lpjtvi9","Type":"NodeParagraph","Properties":{"id":"20240614110732-lpjtvi9","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 凉血止血；止咳祛痰；祛风湿；散肿毒。主治咯血；吐血；衄血；尿血；血痢；肠风下血；崩漏不止；咳嗽痰多；风湿痹痛；丹毒；痄腮，烫伤。"}]},{"ID":"20240614110732-4leegpg","Type":"NodeParagraph","Properties":{"id":"20240614110732-4leegpg","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614110732-lq4uerk","Type":"NodeParagraph","Properties":{"id":"20240614110732-lq4uerk","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g,或入丸、散。外用：适量，煎水洗，捣敷或研末调敷。"}]},{"ID":"20240614110732-uel4c6h","Type":"NodeParagraph","Properties":{"id":"20240614110732-uel4c6h","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614110732-8y6sx50","Type":"NodeParagraph","Properties":{"id":"20240614110732-8y6sx50","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 十灰散《十药神书》；柏叶汤《金匮要略》；四生丸《妇人良方》；槐花散《本事方》；双柏散《经验方》"}]},{"ID":"20240614110732-3qza0wl","Type":"NodeParagraph","Properties":{"id":"20240614110732-3qza0wl","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614110732-alx0mgd","Type":"NodeParagraph","Properties":{"id":"20240614110732-alx0mgd","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：柏叶，补阴之要药，其性多燥，久得之，大益脾土，以滋其肺。"}]},{"ID":"20240614110732-xmwnn2i","Type":"NodeParagraph","Properties":{"id":"20240614110732-xmwnn2i","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：侧柏叶，味苦而微温，义应并于微寒，故得主诸血崩中赤白。若夫轻身益气，令人耐寒暑，则略同于柏实之性矣。惟生肌去湿痹，乃其独擅之长也。"}]},{"ID":"20240614110732-lkzp05l","Type":"NodeParagraph","Properties":{"id":"20240614110732-lkzp05l","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：侧柏叶，止流血，去风湿之药也。凡吐血、衄血、崩血、便血，血热流溢于经络者，捣汁服之立止；凡历节风痱周身走注，痛极不能转动者，煮汁饮之即定。惟热伤血分与风湿伤筋脉者，两病专司其用。但性味苦寒多燥，如血病系热极妄行者可用，如阴虚肺燥，因咳动血者勿用也。如痹病系风湿闭滞者可用，如肝肾两亏，血枯髓败者匆用也。"}]},{"ID":"20240614110732-c2e6e5n","Type":"NodeParagraph","Properties":{"id":"20240614110732-c2e6e5n","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：侧柏叶，味苦滋阴，带涩敛血，专清上部逆血。又得阴气最厚，如遗精、白浊、尿营涩痛属阴脱者，同牛膝治之甚效。"}]},{"ID":"20240614110732-gkad98b","Type":"NodeParagraph","Properties":{"id":"20240614110732-gkad98b","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"5.《本经逢原》：柏叶，性寒而燥，大能伐胃，虽有止衄之功，而无阳生之力，故亡血虚家不宜擅服。然配合之力，功过悬殊，如《金匮》柏叶汤，同姜、艾止吐血不止，当无此虑矣。若《济急方》同黄连治小便血；《圣济总录》同芍药治月水不断，纵借酒之辛温，以行苦寒之势，但酒力易过，苦寒长留，每致减食作泻，瘀积不散，是岂柏叶之过欤？。"}]},{"ID":"20240614110732-b4xxlkp","Type":"NodeParagraph","Properties":{"id":"20240614110732-b4xxlkp","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"6.《本草求真》：侧柏叶，《别录》称为补益，似属未是，但涂汤火伤损、生肌杀虫，炙罨冻疮最佳。"}]},{"ID":"20240614110732-igevo52","Type":"NodeParagraph","Properties":{"id":"20240614110732-igevo52","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"7.《名医别录》：主吐血、衄血、痢血、崩中赤白。轻身益气，令人耐寒暑，去湿痹，生肌。"}]},{"ID":"20240614110732-b557prm","Type":"NodeParagraph","Properties":{"id":"20240614110732-b557prm","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：止尿血，能治冷风历节疼痛。"}]},{"ID":"20240614110732-s1w2azf","Type":"NodeParagraph","Properties":{"id":"20240614110732-s1w2azf","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"9.《日华子本草》：炙冻疮。"}]},{"ID":"20240614110732-46hkncn","Type":"NodeParagraph","Properties":{"id":"20240614110732-46hkncn","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"10.《本草图经》：杀五藏虫。"}]},{"ID":"20240614110732-i8o479w","Type":"NodeParagraph","Properties":{"id":"20240614110732-i8o479w","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"11.《本草正》：善清血凉血，去湿热湿痹，骨节疼痛。捣烂可敷火丹，散痄腮肿痛热毒。"}]},{"ID":"20240614110732-pe8mr0d","Type":"NodeParagraph","Properties":{"id":"20240614110732-pe8mr0d","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"12.《生草药性备要》：散血敷疮，同片糖捶敷。亦治跌打。"}]},{"ID":"20240614110732-uj8koyk","Type":"NodeParagraph","Properties":{"id":"20240614110732-uj8koyk","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"13.《医林纂要》：泄肺逆，泻心火，平肝热，清血分之热。"}]},{"ID":"20240614110732-vhq1355","Type":"NodeParagraph","Properties":{"id":"20240614110732-vhq1355","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"14.《岭南采药录》：凉血行气，祛风，利小便，散瘀。"}]},{"ID":"20240614110732-5bsr2r5","Type":"NodeParagraph","Properties":{"id":"20240614110732-5bsr2r5","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614110732-s6vff2w","Type":"NodeParagraph","Properties":{"id":"20240614110732-s6vff2w","updated":"20240614110732"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614110734-p0iopa0","Type":"NodeThematicBreak","Properties":{"id":"20240614110734-p0iopa0"}},{"ID":"20240614110735-449cp8j","Type":"NodeParagraph","Properties":{"id":"20240614110735-449cp8j"}}]}