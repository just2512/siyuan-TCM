,"Data":"assets/茅根 7-20240814194814-8gkgplq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 533px;\" parent-style=\"width: 543px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 637px;","style":"width: 627px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 5-20240814194611-okpxarl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 627px;\" parent-style=\"width: 637px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814195843-8zk55d3","Type":"NodeParagraph","Properties":{"id":"20240814195843-8zk55d3","updated":"20240814195843"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 792px;","style":"width: 782px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 15-20240814195843-oqr5eb1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 782px;\" parent-style=\"width: 792px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 402px;","style":"width: 392px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 2-20240814194338-ejpcc3z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 392px;\" parent-style=\"width: 402px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814194840-soguyo1","Type":"NodeParagraph","Properties":{"id":"20240814194840-soguyo1","updated":"20240814195538"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 434px;","style":"width: 424px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 8-20240814194840-mjk1w7u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 424px;\" parent-style=\"width: 434px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 434px;","style":"width: 424px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 12-20240814195504-qic82t9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 424px;\" parent-style=\"width: 434px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 13-20240814195538-w0fgkug.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240624175808-k6om0kn","Type":"NodeParagraph","Properties":{"id":"20240624175808-k6om0kn","updated":"20240814194846"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 893px;","style":"width: 883px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白茅根2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白茅根2-20240624175808-6rqdght.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 883px;\" parent-style=\"width: 893px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 384px;","style":"width: 374px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 11-20240814195116-dj4gfpu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 374px;\" parent-style=\"width: 384px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814195733-9a1f6z9","Type":"NodeParagraph","Properties":{"id":"20240814195733-9a1f6z9","updated":"20240814195733"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1277px;","style":"width: 1267px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茅根 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茅根 14-20240814195732-dwa66an.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1267px;\" parent-style=\"width: 1277px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611153759-fqg80s2","Type":"NodeThematicBreak","Properties":{"id":"20240611153759-fqg80s2"}},{"ID":"20240611153801-fyltdst","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153801-fyltdst","updated":"20240611153805"},"Children":[{"Type":"NodeText","Data":"茅根《神农本草经》"}]},{"ID":"20240611153801-aubuk4f","Type":"NodeParagraph","Properties":{"id":"20240611153801-aubuk4f","updated":"20240611153801"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240611153801-2db2czy","Type":"NodeParagraph","Properties":{"id":"20240611153801-2db2czy","updated":"20240611153801"},"Children":[{"Type":"NodeText","Data":"主劳伤虚羸，补中益气，除淤血，血闭寒热，利小便，其苗，主下水。一名兰根，一名茹根。生山谷田野。"}]},{"ID":"20240611153801-8z7eg3p","Type":"NodeParagraph","Properties":{"id":"20240611153801-8z7eg3p","updated":"20240611153801"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名地管，一名地筋，一名兼杜，生楚地，六月采根。"}]},{"ID":"20240611153801-y2b9wp9","Type":"NodeParagraph","Properties":{"id":"20240611153801-y2b9wp9","updated":"20240611153801"},"Children":[{"Type":"NodeText","Data":"案《说文》云：茅，菅也。菅，茅也。《广雅》云：菅，茅也。《尔雅》云：白华野菅。郭璞云：菅，茅属。诗云：白华菅兮，白茅束兮。《传》云：白华，野菅也，已沤，为菅。"}]},{"ID":"20240611153807-halbm6k","Type":"NodeThematicBreak","Properties":{"id":"20240611153807-halbm6k"}},{"ID":"20240611153812-1so8vgo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153812-1so8vgo","updated":"20240611153816"},"Children":[{"Type":"NodeText","Data":"茅根《本草求真》"}]},{"ID":"20240611153812-ekveiy5","Type":"NodeParagraph","Properties":{"id":"20240611153812-ekveiy5","updated":"20240611153812"},"Children":[{"Type":"NodeText","Data":"（山草）清胃火消瘀血利水道"}]},{"ID":"20240611153812-zslavpl","Type":"NodeParagraph","Properties":{"id":"20240611153812-zslavpl","updated":"20240611153812"},"Children":[{"Type":"NodeText","Data":"茅根（专入胃肝）。味甘性寒。清热。消瘀利水。凡苦寒之药。未有不伤气败胃。此药味甘性纯。专理血病。凡一切吐血衄血。血瘀血淋。血崩血闭。并哕逆喘急烦渴。黄胆水肿等症。因热因火而成者。服之热除而血即理。火退而气与水即消矣。（吐血由于心肝火旺逼而上行。与衄血由于肺火所致。皆当用此水煎温服。或为末。米泔水调服。）且能解酒毒。（恐烂五脏。用茅根汁饮一升。）溃痈疽。及疖毒诸疮。或用根捣敷。或用此煮汁调敷毒等药。或以酒煮亦无不可。此药甘不泥膈。寒不伤中。为治虚羸客犯中州之剂。（时珍曰。良药也。世人以微而忽之。惟事苦寒之剂。伤中和之气。乌足知此哉！）至云能以补中益气。虽出本经。然亦不过因其胃热既除而中气自复。岂真补益之谓哉？经解之说。似未可信。茅以白者为良。初生茅针。可以生啖。甚益小儿。功用亦同。屋上败茅。止衄敷疮最妙。"}]},{"ID":"20240611153822-573cvsy","Type":"NodeThematicBreak","Properties":{"id":"20240611153822-573cvsy"}},{"ID":"20240611153823-4lb6dj1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153823-4lb6dj1","updated":"20240611153828"},"Children":[{"Type":"NodeText","Data":"茅根《玉楸药解》"}]},{"ID":"20240611153823-0c8v9lw","Type":"NodeParagraph","Properties":{"id":"20240611153823-0c8v9lw","updated":"20240611153823"},"Children":[{"Type":"NodeText","Data":"味甘，微寒，入手太阴肺、足太阳膀胱经。清金止血，利水通淋。"}]},{"ID":"20240611153823-f92j1p4","Type":"NodeParagraph","Properties":{"id":"20240611153823-f92j1p4","updated":"20240611153823"},"Children":[{"Type":"NodeText","Data":"白茅根清金利水，敛血通经，治喘哕烦渴，吐衄崩漏，经闭溺涩，水肿黄疸。"}]},{"ID":"20240611153823-cgi28qe","Type":"NodeParagraph","Properties":{"id":"20240611153823-cgi28qe","updated":"20240611153823"},"Children":[{"Type":"NodeText","Data":"初生茅针，止衄血便血，收金疮流血，清肿败毒，下水溃痈。酒煎服。一针溃一孔，二针溃二孔。"}]},{"ID":"20240611153823-jlogw60","Type":"NodeParagraph","Properties":{"id":"20240611153823-jlogw60","updated":"20240611153823"},"Children":[{"Type":"NodeText","Data":"花止吐血，治金疮流血。"}]},{"ID":"20240611153730-vu9v743","Type":"NodeThematicBreak","Properties":{"id":"20240611153730-vu9v743"}},{"ID":"20240611153745-ks3omc2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153745-ks3omc2","updated":"20240611153755"},"Children":[{"Type":"NodeText","Data":"茅根《证类本草》"}]},{"ID":"20240611153745-0vxxqzp","Type":"NodeParagraph","Properties":{"id":"20240611153745-0vxxqzp","updated":"20240611153745"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主劳伤虚羸，补中益气，除瘀血、血闭，寒热，利小便，下五淋，除客热在肠胃，止渴，坚筋，妇人崩中。久服利人。其苗主下水。一名兰根，一名茹根，一名地菅，一名地筋，一名兼杜。生楚地山谷、田野。六月采根。"}]},{"ID":"20240611153745-ndyddsa","Type":"NodeParagraph","Properties":{"id":"20240611153745-ndyddsa","updated":"20240611153745"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此即今白茅菅（音奸）。《诗》云∶露彼菅茅，其根如渣芹，甜美。服食此，断谷甚良。俗方稀用，唯疗淋及崩中尔。唐本注云∶菅花，味甘，温，无毒。主衄血，吐血，灸疮。臣禹锡等谨按药性论云∶白茅，臣，能破血，主消渴。根治五淋，煎汁服之。陈藏器云∶茅针，味甘，平，无毒。主恶疮肿，未溃者，煮服之。服一针一孔，二针二孔。生挪敷金疮，止血。煮服之，主鼻衄及暴下血。成白花者，功用亦同。针即茅笋也。又云∶屋茅，主卒吐血。细锉三升，酒浸煮，服一升。屋上烂茅，和酱汁研敷斑疮，蚕啮疮。一名百足虫。"}]},{"ID":"20240611153745-hkfviab","Type":"NodeParagraph","Properties":{"id":"20240611153745-hkfviab","updated":"20240611153745"},"Children":[{"Type":"NodeText","Data":"茅屋滴溜水，杀云母毒。日华子云∶茅针，凉。通小肠，痈毒、软疖不作头，浓煎和酒服。"}]},{"ID":"20240611153745-3p9t1cc","Type":"NodeParagraph","Properties":{"id":"20240611153745-3p9t1cc","updated":"20240611153745"},"Children":[{"Type":"NodeText","Data":"花刀箭疮，止血并痛。根主妇人月经不匀。又云∶茅根，通血脉淋沥，是白花茅根也。又云∶屋四角茅，平，无毒。主鼻洪。"}]},{"ID":"20240611153745-p2dkefh","Type":"NodeParagraph","Properties":{"id":"20240611153745-p2dkefh","updated":"20240611153745"},"Children":[{"Type":"NodeText","Data":"图经曰∶茅根，生楚地山谷、田野，今处处有之。春生苗，布地如针，俗间谓之茅针，亦可啖，甚益小儿，夏生白花茸茸然，至秋而枯。其根至洁白，亦甚甘美，六月采根用，今人取茅针，挪以敷金疮，塞鼻洪，止暴下血及溺血者，殊效。刘禹锡《传信方》∶疗痈肿有头，使必穴方，取茅锥一茎正尔，全煎十数沸，服之，立溃。若两茎即生两孔，或折断一枝为二，亦生两穴。白茅花，亦主金疮，止血。又有菅，亦茅类也。陆机《草木疏》云∶菅似茅而滑无毛，根下五寸中有白粉者，柔韧宜为索，沤之尤善。其未沤者名野菅。《诗》所谓白茅菅兮是此也。入药与茅等。其屋苫茅经久者，主卒吐血。细锉三升，酒浸，煮服一升，良已。肘后方∶疗热。取白茅根四升锉之，以水一斗五升，煮取五升，适冷暖饮之，日三服。又方∶诸竹木刺在肉中不出。取白茅根烧末，脂膏和涂之。亦治因风致肿。"}]},{"ID":"20240611153730-w53vj9l","Type":"NodeThematicBreak","Properties":{"id":"20240611153730-w53vj9l"}},{"ID":"20240611153732-j7tm5rc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153732-j7tm5rc","updated":"20240611153739"},"Children":[{"Type":"NodeText","Data":"茅根《本草图经》"}]},{"ID":"20240611153732-qu57bmy","Type":"NodeParagraph","Properties":{"id":"20240611153732-qu57bmy","updated":"20240611153736"},"Children":[{"Type":"NodeText","Data":"茅根，生楚地山谷田野，今处处有之。春生苗，布地如针，俗间谓之茅针，亦可啖，甚益小儿。夏生白花，茸茸然，至秋而枯；其根至洁白，亦甚甘美，六月采根用。今人取茅针，以傅金疮，塞鼻洪，止暴下血及溺血者，殊效。刘禹锡《传信方》疗痈肿有头，使必穴方，取茅锥一茎正尔，全煎十数沸，服之，立溃。若两茎即生两孔，或折断一枝为二，亦生两穴。白茅花，亦主金疮止血。又有菅，亦茅类也。陆机《草木疏》云∶菅似茅而滑无毛，根下五寸中有白粉者，柔韧宜为索，沤之尤善。其未沤者，名野菅，《诗》所谓白茅菅兮是此也。入药与茅等。其屋苫茅经久者，主卒吐血，细锉三升，酒浸，煮服一升，良已。"}]},{"ID":"20240611153720-5781m0h","Type":"NodeThematicBreak","Properties":{"id":"20240611153720-5781m0h"}},{"ID":"20240611153721-5yovgpd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153721-5yovgpd","updated":"20240611153726"},"Children":[{"Type":"NodeText","Data":"茅根《本草择要纲目》"}]},{"ID":"20240611153721-l1tvc2d","Type":"NodeParagraph","Properties":{"id":"20240611153721-l1tvc2d","updated":"20240611153721"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611153721-qs4uni7","Type":"NodeParagraph","Properties":{"id":"20240611153721-qs4uni7","updated":"20240611153721"},"Children":[{"Type":"NodeText","Data":"甘寒无毒．"}]},{"ID":"20240611153721-7wyho5k","Type":"NodeParagraph","Properties":{"id":"20240611153721-7wyho5k","updated":"20240611153721"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611153721-z13oce7","Type":"NodeParagraph","Properties":{"id":"20240611153721-z13oce7","updated":"20240611153721"},"Children":[{"Type":"NodeText","Data":"劳伤虚羸．补中益气．除瘀血血闭寒热．利小便．下五淋．除客热在肠胃．止渴坚筋．妇人崩中．久服利人．主妇人月经不匀．通血脉淋沥．止吐衄诸血．伤寒哕逆．肺热喘急．水肿黄胆．解酒毒．但茅根甘能除伏热．利小便．故能止诸血哕逆喘急消渴．治黄胆水肿．乃良物也．世人因微而忽之．惟事苦寒之剂．致伤冲和之气．乌足知此哉．"}]},{"ID":"20240611153631-kql582l","Type":"NodeThematicBreak","Properties":{"id":"20240611153631-kql582l"}},{"ID":"20240611153711-bpujh1q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153711-bpujh1q","updated":"20240611153715"},"Children":[{"Type":"NodeText","Data":"茅根《本草经集注》"}]},{"ID":"20240611153711-tkvbgy0","Type":"NodeParagraph","Properties":{"id":"20240611153711-tkvbgy0","updated":"20240611153711"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主治劳伤虚羸，补中益气，除瘀血，血闭，寒热，利小便，下五淋，除客热在肠胃，止渴，坚筋，妇人崩中。久服利人。其苗∶主下水。一名兰根，一名茹根，一名地菅，一名地筋，一名兼杜。生楚地山谷田野，六月采根。"}]},{"ID":"20240611153711-jbczlp9","Type":"NodeParagraph","Properties":{"id":"20240611153711-jbczlp9","updated":"20240611153711"},"Children":[{"Type":"NodeText","Data":"此即今白茅菅。《诗》云∶“露彼菅茅”。其根如如渣芹甜美。服食此断谷甚良。世方稀用，惟治淋及崩中尔。"}]},{"ID":"20240611153658-jg0mibn","Type":"NodeThematicBreak","Properties":{"id":"20240611153658-jg0mibn"}},{"ID":"20240611153659-iq2mxd9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153659-iq2mxd9","updated":"20240611153704"},"Children":[{"Type":"NodeText","Data":"茅根《神农本草经赞》"}]},{"ID":"20240611153659-6kkx4z1","Type":"NodeParagraph","Properties":{"id":"20240611153659-6kkx4z1","updated":"20240611153659"},"Children":[{"Type":"NodeText","Data":"味甘寒。主劳伤虚羸。补中益气。除瘀血血闭。寒热。利小便。其苗主下水。一名兰根。一名茹根。生山谷田野。"}]},{"ID":"20240611153659-aw7i5aj","Type":"NodeParagraph","Properties":{"id":"20240611153659-aw7i5aj","updated":"20240611153659"},"Children":[{"Type":"NodeText","Data":"猗彼菅茅。白华洁质。三脊标灵。连茹汇吉。诱喻麇包。光留萤出。布地针穿。春郊比栉。"}]},{"ID":"20240611153659-7s26k5v","Type":"NodeParagraph","Properties":{"id":"20240611153659-7s26k5v","updated":"20240611153659"},"Children":[{"Type":"NodeText","Data":"诗。白华菅兮。白茅束兮。易疏。白茅用洁白之茅。史记书。江淮之间。一茅三脊。吕岩说。有灵茅赋。易。拔茅茹以其汇征吉。诗。野有死麇。白茅包之。有女怀春。吉士诱之。李时珍曰。其根夜视有光。腐则变为萤火。苏颂曰。春生茅。布地如针。俗谓之茅针。诗。其比如栉。"}]},{"ID":"20240611153631-xjd3fc2","Type":"NodeThematicBreak","Properties":{"id":"20240611153631-xjd3fc2"}},{"ID":"20240611153645-2bs7pcr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153645-2bs7pcr","updated":"20240611153652"},"Children":[{"Type":"NodeText","Data":"茅根《滇南本草》"}]},{"ID":"20240611153645-v13h2fv","Type":"NodeParagraph","Properties":{"id":"20240611153645-v13h2fv","updated":"20240611153649"},"Children":[{"Type":"NodeText","Data":"茅根，味甘，性寒。入胃、小肠二经。祛瘀血，通血闭，止吐血，衄血，治血淋，利小便，止妇人崩漏下血。"}]},{"ID":"20240611153632-8yl8j56","Type":"NodeThematicBreak","Properties":{"id":"20240611153632-8yl8j56"}},{"ID":"20240611153633-r84ky94","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153633-r84ky94","updated":"20240611153638"},"Children":[{"Type":"NodeText","Data":"白茅根《本草崇原》"}]},{"ID":"20240611153633-fvsdsnt","Type":"NodeParagraph","Properties":{"id":"20240611153633-fvsdsnt","updated":"20240611153633"},"Children":[{"Type":"NodeText","Data":"气味甘寒，无毒。主治劳伤虚羸，补中益气，除瘀血血闭，寒热，利小便。"}]},{"ID":"20240611153633-2csj3jc","Type":"NodeParagraph","Properties":{"id":"20240611153633-2csj3jc","updated":"20240611153633"},"Children":[{"Type":"NodeText","Data":"（茅草处处由田野有之，春生芽，布地如针，俗谓之茅针。其叶如矛，边有锋棱，又名刀茅。茅有白茅、菅茅、黄茅、香茅、芭茅数种，叶皆相似白茅，根甚洁白，味甘如蔗，其根柔软如筋，故一名地筋，干之夜视有光，故腐则变为萤火茅，叶可以苫盖，及供祭祀苞苴之用。）"}]},{"ID":"20240611153633-u3gskq9","Type":"NodeParagraph","Properties":{"id":"20240611153633-u3gskq9","updated":"20240611153633"},"Children":[{"Type":"NodeText","Data":"白茅色白味甘，上刚下柔，根多津汁，禀土金水相生之气化。主治劳伤羸瘦者，烦劳内伤，则津液不荣于外，而身体羸瘦。茅根禀水精而多汁，故治劳伤羸瘦。补中益气者，中土内虚，则气不足。茅根禀土气而味甘，故能补中益气。除瘀血血闭者，肝气内虚，则血不荣经，而为瘀血血闭之证。茅根禀金气而色白，故除瘀血血闭。肺金之气外达皮毛，则寒热自愈。皮毛之气下输膀胱，则小便自利。"}]},{"ID":"20240611153612-gbwxox1","Type":"NodeThematicBreak","Properties":{"id":"20240611153612-gbwxox1"}},{"ID":"20240611153622-43qsep8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153622-43qsep8","updated":"20240611153627"},"Children":[{"Type":"NodeText","Data":"白茅根《本草备要》"}]},{"ID":"20240611153622-xtvu3sk","Type":"NodeParagraph","Properties":{"id":"20240611153622-xtvu3sk","updated":"20240611153622"},"Children":[{"Type":"NodeText","Data":"泻火，补中，止血，止哕"}]},{"ID":"20240611153622-jfdk5s7","Type":"NodeParagraph","Properties":{"id":"20240611153622-jfdk5s7","updated":"20240611153622"},"Children":[{"Type":"NodeText","Data":"甘寒。入手少阴（心），足太阴、阳明（脾胃）。补中益气，除伏热，消瘀血，利小便，解酒毒。"}]},{"ID":"20240611153622-z1fvzkt","Type":"NodeParagraph","Properties":{"id":"20240611153622-z1fvzkt","updated":"20240611153622"},"Children":[{"Type":"NodeText","Data":"治吐、衄诸血（心肝火旺，逼血上行，则吐血；肺火盛，则衄血。茅根甘和血，寒凉血，引火下降，故治之。扑损瘀血，捣汁服。名茅花汤。亦治鼻衄产淋），血闭寒热（血瘀则闭，闭则寒热作矣），淋沥崩中（血热则崩），伤寒哕逆（即呃逆。《说文》曰∶哕，气牾也。"}]},{"ID":"20240611153622-v4b66qx","Type":"NodeParagraph","Properties":{"id":"20240611153622-v4b66qx","updated":"20240611153622"},"Children":[{"Type":"NodeText","Data":"东垣作干呕之甚者，未是），肺热喘急，内热烦渴，黄胆水肿（清火行水。时珍曰∶良药也，世人以微而忽之，惟事苦寒之剂，伤冲和之气，乌足知此哉）。"}]},{"ID":"20240611153622-7cx7zug","Type":"NodeParagraph","Properties":{"id":"20240611153622-7cx7zug","updated":"20240611153622"},"Children":[{"Type":"NodeText","Data":"茅针，溃痈疖（酒煮服。一针溃一孔，二针溃二孔），口疮之神药。角蒿。"}]},{"ID":"20240611153612-27m9lae","Type":"NodeThematicBreak","Properties":{"id":"20240611153612-27m9lae"}},{"ID":"20240611153613-l17od6q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153613-l17od6q","updated":"20240611153617"},"Children":[{"Type":"NodeText","Data":"白茅根《本草分经》"}]},{"ID":"20240611153613-bvauxh1","Type":"NodeParagraph","Properties":{"id":"20240611153613-bvauxh1","updated":"20240611153613"},"Children":[{"Type":"NodeText","Data":"甘寒，入心脾胃，凉血消瘀，除热行水，引火下降。针能溃脓，酒蒸服，一针溃一孔。花止血。"}]},{"ID":"20240611153557-6iw50g4","Type":"NodeThematicBreak","Properties":{"id":"20240611153557-6iw50g4"}},{"ID":"20240611153558-7smist7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153558-7smist7","updated":"20240611153607"},"Children":[{"Type":"NodeText","Data":"白茅根《本草述钩元》"}]},{"ID":"20240611153558-tvhmlbd","Type":"NodeParagraph","Properties":{"id":"20240611153558-tvhmlbd","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"春时布地如针。俗呼茅针。三四月开花作穗。茸白如絮。根名茹。经寸成节。柔白如筋。甘甜如蔗者。是宜六月采根用。其根之劲促者。另成他类。有入秋放花如荻。实尖黑。长分许。粘衣刺人者。管也。有茎端开叶。茎上有粉。根头有毛者。黄菅也。又有生湖南及江淮间。叶脊三棱。臭如蒲草者。菁也。（包藉缩酒用）又丛生如芦。叶大如蒲。高六七尺者。芒也。根都劲促。不堪入药。（之颐）味甘气寒。阳中之阴。入手少阴足太阴阳明经。能除内热。主劳伤虚羸。补中益气。除瘀血血闭寒热。（除热所以益气。血热则瘀。瘀则闭。闭则寒热作。）治肺热喘急。伤寒哕逆。"}]},{"ID":"20240611153558-zpqa7lj","Type":"NodeParagraph","Properties":{"id":"20240611153558-zpqa7lj","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"及客热在肠胃。止诸血吐衄。妇人崩中漏下。月经不匀。通血脉淋沥。（皆血分虚热所致）止渴利小便。下五淋。并治水肿黄胆。（诸本草）同麦冬生地杞子。治劳伤内热。同生地麦冬苏子枇杷叶白芍甘草蒲黄童便。治诸血。同牛膝生地童便。治血热经枯而闭。同竹茹麦冬石膏人参。治伤寒胃热哕逆。同枇杷叶竹茹麦冬。治火炎内热。反胃上气。又同芦根水煎饮之。治反胃上气。食入即吐。同赤白茯苓赤小豆车前子薏仁木瓜石斛木通芍药。治水肿。同生地天麦冬车前子牛膝茯苓黄柏五味枸杞童便。治溺血。温病热哕。（伏热在胃。令人胸满气逆。逆则哕。）同葛根煎汁饮之。哕止辍服。虚后水肿。（因饮水多。小便不利。）用白茅根一大把。赤小豆三升。水三升。煮干。去茅。食豆水。随小便下也。"}]},{"ID":"20240611153558-2tf7kw1","Type":"NodeParagraph","Properties":{"id":"20240611153558-2tf7kw1","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"〔论〕白茅春夏之交而华。至秋即枯。故采根以六月。夫当火土司令时。其气不禀乎燥热。反全其甘寒。是于至阳之中而禀清和之阴。即以清阴达其至阳之化者。（犹值阴寒之候。乃有独禀阳和之气者。自能令阴气益畅。）之颐谓为阳中之阴。不妄也。总纪其功。在除胃中伏热而裕阴以和阳。所治吐衄诸血证。固非以通利为功。亦不以止蓄为事。盖其能行能止者。皆阳从外而依阴。阴从中而起阳。流行坎止。应乎自然之节尔。（丹皮茅根侧柏藕节。俱能清血分中火。血药须之。）至热散阴和而阳愈宣。是以又有虚后水肿之效也。"}]},{"ID":"20240611153558-7f0t0f7","Type":"NodeParagraph","Properties":{"id":"20240611153558-7f0t0f7","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"缪氏云。凡因寒发哕。中寒呕吐。及湿痰停饮发热。并不得服。"}]},{"ID":"20240611153558-z760n83","Type":"NodeParagraph","Properties":{"id":"20240611153558-z760n83","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"〔修治〕掘土中得之。弗用露根。洗净捣烂。"}]},{"ID":"20240611153558-jhsdj9z","Type":"NodeParagraph","Properties":{"id":"20240611153558-jhsdj9z","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"茅花"}]},{"ID":"20240611153558-sjieowl","Type":"NodeParagraph","Properties":{"id":"20240611153558-sjieowl","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"气味甘温。煎饮并塞鼻。止吐衄血。又敷炙疮不合。（日华子）准绳方。用茅花同诸味。"}]},{"ID":"20240611153558-5xfep7l","Type":"NodeParagraph","Properties":{"id":"20240611153558-5xfep7l","updated":"20240611153558"},"Children":[{"Type":"NodeText","Data":"治尿血。"}]},{"ID":"20240611153530-6pbs0y0","Type":"NodeThematicBreak","Properties":{"id":"20240611153530-6pbs0y0"}},{"ID":"20240611153543-cjlk1zs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153543-cjlk1zs","updated":"20240611153549"},"Children":[{"Type":"NodeText","Data":"白茅根《本草害利》"}]},{"ID":"20240611153543-bjqsiin","Type":"NodeParagraph","Properties":{"id":"20240611153543-bjqsiin","updated":"20240611153543"},"Children":[{"Type":"NodeText","Data":"〔害〕吐血因于虚寒者，非其所宜。因寒发哕，中寒呕吐湿痰，停饮发热，并不宜服。"}]},{"ID":"20240611153543-n4qmjei","Type":"NodeParagraph","Properties":{"id":"20240611153543-n4qmjei","updated":"20240611153543"},"Children":[{"Type":"NodeText","Data":"〔利〕甘寒，入心、脾、胃、小肠四经，凉金定喘，平血逆，清血瘀，利水湿，疗淋沥崩中。"}]},{"ID":"20240611153543-1f622kl","Type":"NodeParagraph","Properties":{"id":"20240611153543-1f622kl","updated":"20240611153543"},"Children":[{"Type":"NodeText","Data":"茅花止血，茅针溃痈，一针溃一孔。能泻火消瘀，凉血止哕。"}]},{"ID":"20240611153543-mckyzov","Type":"NodeParagraph","Properties":{"id":"20240611153543-mckyzov","updated":"20240611153543"},"Children":[{"Type":"NodeText","Data":"〔修治〕三月采针，四月采花，六月掘根，去毛用。"}]},{"ID":"20240611153336-akn8l02","Type":"NodeThematicBreak","Properties":{"id":"20240611153336-akn8l02"}},{"ID":"20240611153517-cwi1hn4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153517-cwi1hn4","updated":"20240611153523"},"Children":[{"Type":"NodeText","Data":"白茅根《本经逢原》"}]},{"ID":"20240611153517-x10x2ug","Type":"NodeParagraph","Properties":{"id":"20240611153517-x10x2ug","updated":"20240611153517"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名地筋"}]},{"ID":"20240611153517-z1rnot5","Type":"NodeParagraph","Properties":{"id":"20240611153517-z1rnot5","updated":"20240611153517"},"Children":[{"Type":"NodeText","Data":"甘寒，无毒。与百脉根相类，百脉根出巴西，他处罕得。"}]},{"ID":"20240611153517-t82fm83","Type":"NodeParagraph","Properties":{"id":"20240611153517-t82fm83","updated":"20240611153517"},"Children":[{"Type":"NodeText","Data":"《本经》主劳伤虚羸，补中益气，除瘀血血闭寒热，利小便。"}]},{"ID":"20240611153517-lvx3jsp","Type":"NodeParagraph","Properties":{"id":"20240611153517-lvx3jsp","updated":"20240611153517"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"甘寒能降除伏热，利小便，止渴。治伤寒呃逆、喘哕，吐衄，便溺诸血。治黄瘅，水肿，胃反上气，五淋疼热，及痘疮干紫不起，但呕吐衄亦有因于寒者，即非所宜。《本经》主治劳伤虚羸者，以甘寒能滋虚热，而无伤犯胃气之虞也。补中益气，胃热去而中气复，是指客邪入伤中州，渐成虚羸而言，非劳伤本病所宜。昔人考本草功用，言白茅根与百脉根相类。今肃州不行岁贡，百脉根无从可得，而止渴去热之用白茅根裕如也。其茅花甘温，色白轻虚，力能上升入肺散热止衄，屋上败茅，研敷斑疮湿烂，取其收湿之力也。"}]},{"ID":"20240611153336-fnghx3x","Type":"NodeThematicBreak","Properties":{"id":"20240611153336-fnghx3x"}},{"ID":"20240611153409-hfxdg3f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153409-hfxdg3f","updated":"20240611153413"},"Children":[{"Type":"NodeText","Data":"茅根《医学入门》"}]},{"ID":"20240611153409-xh5alxr","Type":"NodeParagraph","Properties":{"id":"20240611153409-xh5alxr","updated":"20240611153409"},"Children":[{"Type":"NodeText","Data":"茅根无毒性甘平，逐瘀止血治淋难，消除客热医烦渴，灸疮血出用花安，针罨刀箭穿疮孔，烂茅止血敷疮斑。"}]},{"ID":"20240611153409-uu1ndke","Type":"NodeParagraph","Properties":{"id":"20240611153409-uu1ndke","updated":"20240611153409"},"Children":[{"Type":"NodeText","Data":"茅，冒也，毛也。冒然而生，为地之毛也。处处有之，春生苗，布地如针，夏开白花，六月采其根，洁白甘美，至秋则枯。主除瘀血，血闭寒热，止诸血吐衄及妇人崩中漏下、月经不匀。利小便，下五淋，除客热在肠胃，止渴坚筋，通血脉。劳伤中气虚羸者，亦可服之。花，性温，治吐血、衄血，及灸疮出血不止。茅针，一名茅笋。性凉，可啖，甚益小儿。通小肠，止鼻衄及暴下血、溺血，罨刀箭金疮，止血止痛。凡痈毒软疖未溃不作头脓，酒煮服之，一针一孔，二针二孔。烂茅，即茅屋上四角经霜久者。性平。止吐衄，酒煮服之。斑疮蚕咬，和酱汁研敷。茅屋滴溜水，解云母毒。"}]},{"ID":"20240611153409-gftk1h1","Type":"NodeThematicBreak","Properties":{"id":"20240611153409-gftk1h1"}},{"ID":"20240611153505-hxcn2rv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153505-hxcn2rv","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"《中国药典》：白茅根"}]},{"ID":"20240611153505-gj24s5w","Type":"NodeParagraph","Properties":{"id":"20240611153505-gj24s5w","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611153505-g1nlogp","Type":"NodeParagraph","Properties":{"id":"20240611153505-g1nlogp","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" Bái Máo Gēn"}]},{"ID":"20240611153505-0bbisjq","Type":"NodeParagraph","Properties":{"id":"20240611153505-0bbisjq","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153505-3miczau","Type":"NodeParagraph","Properties":{"id":"20240611153505-3miczau","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 丝茅草、茅草、白茅草、茅草根"}]},{"ID":"20240611153505-2ftadgw","Type":"NodeParagraph","Properties":{"id":"20240611153505-2ftadgw","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611153505-navqbaf","Type":"NodeParagraph","Properties":{"id":"20240611153505-navqbaf","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" RHIZOMA IMPERATAE"}]},{"ID":"20240611153505-xbl7i22","Type":"NodeParagraph","Properties":{"id":"20240611153505-xbl7i22","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153505-jt11gqn","Type":"NodeParagraph","Properties":{"id":"20240611153505-jt11gqn","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 本品为禾本科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白茅"},{"Type":"NodeText","Data":"Imperata cylindrica Beauv. var. major （Nees）C. E. Hubb. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋二季采挖，洗净，晒干，除去须根及膜质叶鞘，捆成小把。"}]},{"ID":"20240611153505-gop2aup","Type":"NodeParagraph","Properties":{"id":"20240611153505-gop2aup","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153505-a6ppfw1","Type":"NodeParagraph","Properties":{"id":"20240611153505-a6ppfw1","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 本品呈长圆柱形，长30～60cm，直径0.2～0.4cm。表面黄白色或淡黄色，微有光泽，具纵皱纹，节明显，稍突起，节间长短不等，通常长1.5～3cm。体轻，质略脆，断面皮部白色，多有裂隙，放射状排列，中柱淡黄色，易与皮部剥离。无臭，味微甜。"}]},{"ID":"20240611153505-w2x5rqp","Type":"NodeParagraph","Properties":{"id":"20240611153505-w2x5rqp","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611153505-7uczm15","Type":"NodeParagraph","Properties":{"id":"20240611153505-7uczm15","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白茅根"},{"Type":"NodeText","Data":"：洗净，微润，切段，干燥，除去碎屑。茅根炭：取净白茅根段，照炒炭法（附录Ⅱ D）炒至焦褐色。"}]},{"ID":"20240611153505-mm750di","Type":"NodeParagraph","Properties":{"id":"20240611153505-mm750di","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611153505-h6l1jp2","Type":"NodeParagraph","Properties":{"id":"20240611153505-h6l1jp2","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" （1） 取本品粗粉5g，加苯30ml，加热回流 1小时，滤过。取滤液5ml,蒸干，残渣加醋酐1ml 使溶解，再加硫酸1～2滴，即显红色，后渐变成紫红色、蓝紫色，最后变为污绿色。"}]},{"ID":"20240611153505-adfywqi","Type":"NodeParagraph","Properties":{"id":"20240611153505-adfywqi","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粗粉1g，加水10ml，煮沸5～10 分钟，滤过，滤液浓缩成1ml,加碱性酒石酸铜试液1ml,置水浴中加热，生成棕红色沉淀。"}]},{"ID":"20240611153505-ryuq2ue","Type":"NodeParagraph","Properties":{"id":"20240611153505-ryuq2ue","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611153505-lbzw6in","Type":"NodeParagraph","Properties":{"id":"20240611153505-lbzw6in","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 归肺、胃、膀胱经。"}]},{"ID":"20240611153505-8q05q4j","Type":"NodeParagraph","Properties":{"id":"20240611153505-8q05q4j","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611153505-45etydt","Type":"NodeParagraph","Properties":{"id":"20240611153505-45etydt","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240611153505-ffwz8kx","Type":"NodeParagraph","Properties":{"id":"20240611153505-ffwz8kx","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153505-27lbh8f","Type":"NodeParagraph","Properties":{"id":"20240611153505-27lbh8f","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 凉血止血，清热利尿。用于血热吐血，衄血，尿血，热病烦渴，黄疸，水肿，热淋涩痛；急性肾炎水肿。"}]},{"ID":"20240611153505-1j69hx0","Type":"NodeParagraph","Properties":{"id":"20240611153505-1j69hx0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611153505-son02no","Type":"NodeParagraph","Properties":{"id":"20240611153505-son02no","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 9～30g，鲜品30～60g。"}]},{"ID":"20240611153505-ykr0bxg","Type":"NodeParagraph","Properties":{"id":"20240611153505-ykr0bxg","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611153505-fqn6wkf","Type":"NodeParagraph","Properties":{"id":"20240611153505-fqn6wkf","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611153505-qnnudk6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153505-qnnudk6","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白茅根"}]},{"ID":"20240611153505-a84ff5z","Type":"NodeParagraph","Properties":{"id":"20240611153505-a84ff5z","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611153505-lk5occd","Type":"NodeParagraph","Properties":{"id":"20240611153505-lk5occd","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" Bái Máo Gēn"}]},{"ID":"20240611153505-yki8uw6","Type":"NodeParagraph","Properties":{"id":"20240611153505-yki8uw6","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153505-2oonytl","Type":"NodeParagraph","Properties":{"id":"20240611153505-2oonytl","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 茅根、兰根、茹根（《本经》），地菅、地筋、兼杜（《别录》），白花茅根（《日华子本草》），地节根（《青海药材》），茅草根（《江苏植药志》），坚草根、甜草根（《河北药材》），丝毛草根（《中药志》），寒草根（《闽东本草》）。"}]},{"ID":"20240611153505-yj811f3","Type":"NodeParagraph","Properties":{"id":"20240611153505-yj811f3","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611153505-y81buj5","Type":"NodeParagraph","Properties":{"id":"20240611153505-y81buj5","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240611153505-b0lyma5","Type":"NodeParagraph","Properties":{"id":"20240611153505-b0lyma5","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153505-sqm2ppl","Type":"NodeParagraph","Properties":{"id":"20240611153505-sqm2ppl","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 为禾本科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白茅"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋采挖，除去地上部分及泥土，洗净、晒干后，揉去须根及膜质叶鞘。"}]},{"ID":"20240611153505-th6n2xd","Type":"NodeParagraph","Properties":{"id":"20240611153505-th6n2xd","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611153505-etrqdw6","Type":"NodeParagraph","Properties":{"id":"20240611153505-etrqdw6","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 多生长于路旁、山坡、草地上。分布几遍全国。全国大部分地区均产。"}]},{"ID":"20240611153505-e70esu4","Type":"NodeParagraph","Properties":{"id":"20240611153505-e70esu4","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611153505-jjjlz4v","Type":"NodeParagraph","Properties":{"id":"20240611153505-jjjlz4v","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 白茅（《本草经集注》），又名：白茅菅（陶弘景），丝茅（《纲目》），万根草（《铁岭县志》），茅草。多年生草本。根茎密生鳞片。秆丛生，直立，高30～90厘米，具2～3节，节上有长4～10毫米的柔毛。叶多丛集基部；叶鞘无毛，或上部及边缘和鞘口具纤毛，老时基部或破碎呈纤维状；叶舌干膜质，钝头，长约1毫米；叶片线形或线状披针形，先端渐尖，基部渐狭，根生叶长，几与植株相等，茎生叶较短。圆锥花序柱状，长5～20厘米，宽1.5～3厘米，分枝短缩密集；小穗披针形或长圆形，长3～4毫米，基部密生长10～15毫米之丝状柔毛，具长短不等的小穗柄；两颖相等或第一颖稍短，除背面下部略呈草质外，余均膜质，边缘具纤毛，背面疏生丝状柔毛，第一颖较狭，具3～4脉，第二颖较宽，具4～6脉；第一外稃卵状长圆形，长约1.5毫米，先端钝，内稃缺如；第二外稃披针形，长1.2毫米，先端尖，两侧略呈细齿状；内稃长约1.2毫米，宽约1.5毫米，先端截平，具尖钝划、不同的数齿；雄蕊2，花药黄色，长约3毫米；柱头2枚，深紫色。颖果。花期夏、秋季。"}]},{"ID":"20240611153505-r5ed8th","Type":"NodeParagraph","Properties":{"id":"20240611153505-r5ed8th","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153505-3k7pxzm","Type":"NodeParagraph","Properties":{"id":"20240611153505-3k7pxzm","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 干燥的根茎，呈细长圆柱形，有时分枝，长短不一，通常长30～60厘米，直径约1.5毫米，表面乳白色或黄白色，有浅棕黄色、微隆起的节；节距约3厘米。质轻而韧，不易折断。断面纤维性，中心黄白色，并有一小孔，外圈色白，充实，或有无数空隙如车轮状，外圈与中心极易剥离。气微，味微甘。以粗肥、色白、无须根、味甜者为佳。"}]},{"ID":"20240611153505-dknlyhp","Type":"NodeParagraph","Properties":{"id":"20240611153505-dknlyhp","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611153505-ok34993","Type":"NodeParagraph","Properties":{"id":"20240611153505-ok34993","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 含多量蔗糖、葡萄糖，少量果糖、木糖及柠檬酸、草酸、苹果酸等，又含21％的淀粉。另有报道，从本品分离出白头翁素。"}]},{"ID":"20240611153505-o9hjzhl","Type":"NodeParagraph","Properties":{"id":"20240611153505-o9hjzhl","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"根茎含甘露醇、葡萄糖、果糖、蔗糖、柠檬酸、苹果酸、薏苡素及芦竹素、印白茅素等"}]},{"ID":"20240611153505-4hnj89s","Type":"NodeParagraph","Properties":{"id":"20240611153505-4hnj89s","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611153505-h2nsa3w","Type":"NodeParagraph","Properties":{"id":"20240611153505-h2nsa3w","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 干茅根：拣净杂质，洗净，微润，切段，晒干，簸净碎屑。茅根炭：取茅根段，置锅内用武火炒至黑色，喷洒清水，取出，晒干。"}]},{"ID":"20240611153505-w27b2ce","Type":"NodeParagraph","Properties":{"id":"20240611153505-w27b2ce","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611153505-8bgdb60","Type":"NodeParagraph","Properties":{"id":"20240611153505-8bgdb60","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 入肺、胃、小肠经。"}]},{"ID":"20240611153505-ec4b4c2","Type":"NodeParagraph","Properties":{"id":"20240611153505-ec4b4c2","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入胃、小肠二经。\""}]},{"ID":"20240611153505-nihdmld","Type":"NodeParagraph","Properties":{"id":"20240611153505-nihdmld","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入手少阴，足太阴、阳明。\""}]},{"ID":"20240611153505-yzn41si","Type":"NodeParagraph","Properties":{"id":"20240611153505-yzn41si","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"入手少阴、太阴，兼入足太阴、阳明经。\""}]},{"ID":"20240611153505-atblrqs","Type":"NodeParagraph","Properties":{"id":"20240611153505-atblrqs","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"④《本草求真》：\"入胃、肝。\""}]},{"ID":"20240611153505-tahlvpb","Type":"NodeParagraph","Properties":{"id":"20240611153505-tahlvpb","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611153505-qez8abl","Type":"NodeParagraph","Properties":{"id":"20240611153505-qez8abl","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 甘、寒。"}]},{"ID":"20240611153505-4pulmyg","Type":"NodeParagraph","Properties":{"id":"20240611153505-4pulmyg","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，寒。\""}]},{"ID":"20240611153505-rd0iosc","Type":"NodeParagraph","Properties":{"id":"20240611153505-rd0iosc","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611153505-x1nolli","Type":"NodeParagraph","Properties":{"id":"20240611153505-x1nolli","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"甘，凉。\""}]},{"ID":"20240611153505-qzoonds","Type":"NodeParagraph","Properties":{"id":"20240611153505-qzoonds","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"味甘苦，性寒，无毒。\""}]},{"ID":"20240611153505-67sjh6s","Type":"NodeParagraph","Properties":{"id":"20240611153505-67sjh6s","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611153505-jcae54m","Type":"NodeParagraph","Properties":{"id":"20240611153505-jcae54m","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒，溲多不渴者忌服。"}]},{"ID":"20240611153505-tsaeyhn","Type":"NodeParagraph","Properties":{"id":"20240611153505-tsaeyhn","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"因寒发哕，中寒呕吐，湿痰停饮发热，并不得服。\""}]},{"ID":"20240611153505-eqoxwp1","Type":"NodeParagraph","Properties":{"id":"20240611153505-eqoxwp1","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"吐血因于虚寒者，非所宜也。\""}]},{"ID":"20240611153505-mit346g","Type":"NodeParagraph","Properties":{"id":"20240611153505-mit346g","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153505-820g9hm","Type":"NodeParagraph","Properties":{"id":"20240611153505-820g9hm","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 凉血，止血，清热，利尿。治热病烦渴，吐血，衄血，肺热喘急，胃热哕逆，淋病，小便不利，水肿，黄疸。"}]},{"ID":"20240611153505-zkxj76w","Type":"NodeParagraph","Properties":{"id":"20240611153505-zkxj76w","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主劳伤虚羸，补中益气，除瘀血、血闭寒热，利小便。\""}]},{"ID":"20240611153505-h303msw","Type":"NodeParagraph","Properties":{"id":"20240611153505-h303msw","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"下五淋，除客热在肠胃，止渴，坚筋，妇人崩中。\""}]},{"ID":"20240611153505-4gd881g","Type":"NodeParagraph","Properties":{"id":"20240611153505-4gd881g","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"主妇人月经不匀，通血脉淋沥。\""}]},{"ID":"20240611153505-pcxfcvh","Type":"NodeParagraph","Properties":{"id":"20240611153505-pcxfcvh","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"止吐血，衄血，治血淋，利小便，止妇人崩漏下血。\""}]},{"ID":"20240611153505-hgqa9vo","Type":"NodeParagraph","Properties":{"id":"20240611153505-hgqa9vo","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"止吐衄诸血，伤寒哕逆，肺热喘急，水肿，黄疸，解酒毒。\""}]},{"ID":"20240611153505-oqe8gnb","Type":"NodeParagraph","Properties":{"id":"20240611153505-oqe8gnb","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑥《本经逢原》：\"治胃反上气，五淋疼热及痘疮干紫不起。\""}]},{"ID":"20240611153505-v2x7s38","Type":"NodeParagraph","Properties":{"id":"20240611153505-v2x7s38","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑦《动植物民间药》：\"治脚气。\""}]},{"ID":"20240611153505-2i0t0yu","Type":"NodeParagraph","Properties":{"id":"20240611153505-2i0t0yu","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611153505-liavnz2","Type":"NodeParagraph","Properties":{"id":"20240611153505-liavnz2","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱（鲜者1～2两）；捣汁或研末。"}]},{"ID":"20240611153505-f274ypx","Type":"NodeParagraph","Properties":{"id":"20240611153505-f274ypx","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611153505-8gkegbq","Type":"NodeParagraph","Properties":{"id":"20240611153505-8gkegbq","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" ①治吐血不止：白茅根一握。水煎服之。（《千金翼方》）"}]},{"ID":"20240611153505-zjg3t16","Type":"NodeParagraph","Properties":{"id":"20240611153505-zjg3t16","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"②治血热鼻衄：白茅根汁一台。饮之。（《妇人良方》）"}]},{"ID":"20240611153505-zktfp45","Type":"NodeParagraph","Properties":{"id":"20240611153505-zktfp45","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"③治鼻衄不止：茅根为末，米泔水服二钱。《圣惠方》）"}]},{"ID":"20240611153505-idavvjo","Type":"NodeParagraph","Properties":{"id":"20240611153505-idavvjo","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"④治喘：茅根一握（生用旋采），桑白皮等分。水二盏，煎至一盏，去滓温服，食后。（《圣惠方》如神汤）"}]},{"ID":"20240611153505-q2gsuo0","Type":"NodeParagraph","Properties":{"id":"20240611153505-q2gsuo0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑤治温病有热，饮水暴冷哕者：茅根、葛根（各切）半升。以水四升，煮取二升，稍温饮之，啘止则停。（《小品方》茅根汤）"}]},{"ID":"20240611153505-bwb1tjo","Type":"NodeParagraph","Properties":{"id":"20240611153505-bwb1tjo","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑥治胃反，食即吐出，上气：芦根、茅根各二两。细切，以水四升，煮取二升，顿服之，得下，良。（《千金方》）"}]},{"ID":"20240611153505-6xaaqoi","Type":"NodeParagraph","Properties":{"id":"20240611153505-6xaaqoi","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑦治小便热淋：白茅根四升。水一斗五升，煮取五升，适冷暖饮之，日三服。（《肘后方》）"}]},{"ID":"20240611153505-3osle0d","Type":"NodeParagraph","Properties":{"id":"20240611153505-3osle0d","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑧治小便出血：茅根一把。切，以水一大盏，煎至五分，去滓，温温频服。（《圣惠方》）"}]},{"ID":"20240611153505-5qgxa68","Type":"NodeParagraph","Properties":{"id":"20240611153505-5qgxa68","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑨治劳伤溺血：茅根、干姜等分。入蜜一匙，水二钟，煎一钟，日一服。（《纲目》）"}]},{"ID":"20240611153505-6cccbh1","Type":"NodeParagraph","Properties":{"id":"20240611153505-6cccbh1","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑩治血尿：白茅根，车前子各一两，白糖五钱。水煎服。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240611153505-benfsyv","Type":"NodeParagraph","Properties":{"id":"20240611153505-benfsyv","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑾治乳糜尿：鲜茅根半斤。加水2000毫升煎成约1200毫升，加糖适量。每日分三次内服，或代茶饮，连服五至十五天为一疗程。（《江苏省中草药新医疗法展览资料选编》）"}]},{"ID":"20240611153505-ucq0cs7","Type":"NodeParagraph","Properties":{"id":"20240611153505-ucq0cs7","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⑿治肾炎：白茅根一两，一枝黄花一两，葫芦壳五钱，白酒药一钱。水煎，分二次服，每日一剂，忌盐。（《单方验方调查资料选编》）"}]},{"ID":"20240611153505-bef9jd3","Type":"NodeParagraph","Properties":{"id":"20240611153505-bef9jd3","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒀治阳虚不能化阴，小便不利，或有湿热壅滞，以致小便不利，积成水肿：白茅根一斤。掘取鲜者，去净皮与节间小根，细切，将茅根用水四大碗，煮一沸，移其锅置炉旁，候十数分钟，视其茅根若不沉水底，再煮一沸，移其锅置炉旁，须臾视其根皆沉水底，其汤即成，去渣温服，多半杯，日服五、六次，夜服两、三次，使药力相继，周十二时，小便自利。（《医学衷中参西录》白茅根汤）"}]},{"ID":"20240611153505-h6w9pjc","Type":"NodeParagraph","Properties":{"id":"20240611153505-h6w9pjc","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒁治卒大腹水病：白茅根一大把，小豆三升。水三升，煮干，去茅根食豆，水随小便下。（《补缺肘后方》）"}]},{"ID":"20240611153505-fszoo84","Type":"NodeParagraph","Properties":{"id":"20240611153505-fszoo84","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒂治黄疸、谷疸、酒疸、女疸、劳疸、黄汗：生茅根一把。细切，以猪肉一斤，合作羹，尽啜食之。（《补缺肘后方》）"}]},{"ID":"20240611153505-rb1qhj0","Type":"NodeParagraph","Properties":{"id":"20240611153505-rb1qhj0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒃治血热经枯而闭：茅根、牛膝、生地黄，童便。煎服。（《本草经疏》）"}]},{"ID":"20240611153505-sh9a7kl","Type":"NodeParagraph","Properties":{"id":"20240611153505-sh9a7kl","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒄解曼陀罗中毒：白茅根一两，甘蔗一斤。捣烂，榨汁，用一个椰子水煎服。（《南方主要有毒植物》）"}]},{"ID":"20240611153505-hc6lghh","Type":"NodeParagraph","Properties":{"id":"20240611153505-hc6lghh","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒅温病热哕（胃有伏热，令人胸满，引起气逆，气逆发声称为哕）。用茅根、葛根、葛根各半斤，加水三升煎成一升半。每服一杯，温水送下。哕止即停服。"}]},{"ID":"20240611153505-9u2fd51","Type":"NodeParagraph","Properties":{"id":"20240611153505-9u2fd51","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒆反胃，食肉即吐。用茅根、芦根各二两，加水四升，煮成二升，一次服下。"}]},{"ID":"20240611153505-plw282i","Type":"NodeParagraph","Properties":{"id":"20240611153505-plw282i","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"⒇肺热气喘。用生茅根一把，口咬细，加水二碗，煮成一碗，饭后温服。三服病愈。此方名\"如神汤\"。"}]},{"ID":"20240611153505-ja8qh2b","Type":"NodeParagraph","Properties":{"id":"20240611153505-ja8qh2b","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（21）体虚水肿（小便不利，但饮水很多）。用白茅根一大把，小豆三升，加水三升煮干。去茅食品。水随小便排出。"}]},{"ID":"20240611153505-o8akz8x","Type":"NodeParagraph","Properties":{"id":"20240611153505-o8akz8x","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（22）五种黄病（黄疸、谷疸、酒疸、女疸、劳疸。身体微胖，汗出如黄汁）。用生茅根一把，切细，和猪肉一斤同煨汤吃。"}]},{"ID":"20240611153505-5r58ju4","Type":"NodeParagraph","Properties":{"id":"20240611153505-5r58ju4","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（23）小便热淋。用白茅根四升，加水一斗五升，煮成五升，温服。一天服一次。"}]},{"ID":"20240611153505-22elot0","Type":"NodeParagraph","Properties":{"id":"20240611153505-22elot0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（24）劳伤尿血。用茅根、干姜等分，加蜜一匙，水二杯，煎成一杯服下。一天服一次。"}]},{"ID":"20240611153505-787ukhn","Type":"NodeParagraph","Properties":{"id":"20240611153505-787ukhn","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（25）鼻血不止。用茅根研细，每服二钱，淘米水送下。"}]},{"ID":"20240611153505-cx2lt9g","Type":"NodeParagraph","Properties":{"id":"20240611153505-cx2lt9g","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（26）吐血不止。用白茅根一把，水煎服。"}]},{"ID":"20240611153505-s2f1ldy","Type":"NodeParagraph","Properties":{"id":"20240611153505-s2f1ldy","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"（27）竹木入肉。用白茅根烧过研末，调猪油涂伤处。"}]},{"ID":"20240611153505-ep3jcn0","Type":"NodeParagraph","Properties":{"id":"20240611153505-ep3jcn0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611153505-u6mxyya","Type":"NodeParagraph","Properties":{"id":"20240611153505-u6mxyya","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" ①治疗急性肾炎"}]},{"ID":"20240611153505-kg54chy","Type":"NodeParagraph","Properties":{"id":"20240611153505-kg54chy","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"有较好效果，可以缩短病程。据数十例的观察，服药后通常在1～5天内小便即显着增多，每日可达1500～3000毫升左右。随之水肿即渐消失，高血压及尿检变化亦渐好转而趋正常。据部分病例统计，水肿消失时间平均约4～5天或1周左右；血压恢复正常时间在5～20天，平均7～9天；尿检变化平均消失时间，自11天至26.4天不等。用于慢性肾炎亦有利尿消肿及一定的降压作用。但对肝脏病引起的腹水及心力衰竭所致的水肿，则无利尿消肿作用或作用不显着。因此有人推测，白茅根的作用主要在于缓解肾小球血管痉挛，从而使肾血流量及肾滤过率增加而产生利尿效果；同时肾缺血改善，肾素产生减少，使血压恢复正常。故对急性肾炎疗效良好，慢性肾炎疗效较差，而对肝病性及心病性的水肿几不奏效。服药期间除个别有轻微头晕或恶心外，未见不良反应。用法：一般以白茅根（干品）半斤，洗净切碎，水煎，每日2～3次分服。连服1～2周或至痊愈。亦有配合大蓟、小蓟、生地或麻黄组成复方治疗。服药同时，须注意卧床休息，限制水、盐的摄入，保暖。必要时可适当加用其它药物控制并发症及感染病灶等"}]},{"ID":"20240611153505-mpxs07d","Type":"NodeParagraph","Properties":{"id":"20240611153505-mpxs07d","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"②治疗急性传染性肝炎"}]},{"ID":"20240611153505-aba2xbs","Type":"NodeParagraph","Properties":{"id":"20240611153505-aba2xbs","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"用白茅根（干品）2两，水煎，每日两次分服。治疗28例，结果临床治愈（45天内主要症状、体征消失，肝功能恢复正常）21例，好转（临床症状好转，45天内各项肝功能的数值下降超过半数，或45天后完全恢复正常）7例。治疗后，主要症状大多在10天内消失，肝脾肿大在20天左右消失；谷丙转氨酶经45天后有80％的患者降至正常，黄疸指数平均20.15天全转正常。未见副作用。"}]},{"ID":"20240611153505-uc2ybgn","Type":"NodeParagraph","Properties":{"id":"20240611153505-uc2ybgn","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"此外，白茅根曾用于治疗高血压病，配合仙鹤草治疗上消化道出血，均有一定效果。"}]},{"ID":"20240611153505-j6okdn1","Type":"NodeParagraph","Properties":{"id":"20240611153505-j6okdn1","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611153505-0826lvl","Type":"NodeParagraph","Properties":{"id":"20240611153505-0826lvl","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611153505-8i5vjmn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611153505-8i5vjmn","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"《中华本草》：白茅根"}]},{"ID":"20240611153505-f897u3k","Type":"NodeParagraph","Properties":{"id":"20240611153505-f897u3k","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611153505-3obju5j","Type":"NodeParagraph","Properties":{"id":"20240611153505-3obju5j","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" Bái Máo Gēn"}]},{"ID":"20240611153505-sz9vj5q","Type":"NodeParagraph","Properties":{"id":"20240611153505-sz9vj5q","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611153505-2gn4ccp","Type":"NodeParagraph","Properties":{"id":"20240611153505-2gn4ccp","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 茅根、兰根、茹根、地菅、地筋、兼杜、白茅菅、白花茅根、丝茅、万根草、茅草根、地节根、坚草根、甜草根、丝毛草根、寒草根"}]},{"ID":"20240611153505-u52fzsh","Type":"NodeParagraph","Properties":{"id":"20240611153505-u52fzsh","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611153505-bzvytsw","Type":"NodeParagraph","Properties":{"id":"20240611153505-bzvytsw","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" Lalang Grass Rhizome, Rhizome of Lalang Grass"}]},{"ID":"20240611153505-rcbirri","Type":"NodeParagraph","Properties":{"id":"20240611153505-rcbirri","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611153505-4vkbmtp","Type":"NodeParagraph","Properties":{"id":"20240611153505-4vkbmtp","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 出自1.《本草经集注》。"}]},{"ID":"20240611153505-p42737m","Type":"NodeParagraph","Properties":{"id":"20240611153505-p42737m","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：茅根，今处处有之。春生芽，布地如针，俗间谓之茅针，亦可啖，甚益小儿。夏生白花，茸茸然，至秋而枯，其根至洁白，亦甚甘美，六月采根用。"}]},{"ID":"20240611153505-eevjm68","Type":"NodeParagraph","Properties":{"id":"20240611153505-eevjm68","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：茅有数种，夏花者为茅，秋花者为菅，二物功用相近，而名谓不同，《诗》云，白华菅兮，白茅束兮是也。《别录》不分茅、菅乃二种，谓茅根一名地菅，一名地筋，而有名未用，又出地筋，一名菅根。盖二物之根状皆如筋，"}]},{"ID":"20240611153505-ut52pj9","Type":"NodeParagraph","Properties":{"id":"20240611153505-ut52pj9","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611153505-yiwc25w","Type":"NodeParagraph","Properties":{"id":"20240611153505-yiwc25w","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 药材基源：为禾本科植物白茅的根茎。"}]},{"ID":"20240611153505-ipkfe11","Type":"NodeParagraph","Properties":{"id":"20240611153505-ipkfe11","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Imperata cylindrica (L.) Beauv.var.major(Nees)C.E.Hubb."}]},{"ID":"20240611153505-tv6i5j9","Type":"NodeParagraph","Properties":{"id":"20240611153505-tv6i5j9","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋季采挖，除去地上部分和鳞片状的叶鞘，洗净，鲜用或扎把晒干。"}]},{"ID":"20240611153505-kh9k62w","Type":"NodeParagraph","Properties":{"id":"20240611153505-kh9k62w","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611153505-k5435bz","Type":"NodeParagraph","Properties":{"id":"20240611153505-k5435bz","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于路旁向阳干草地或山坡上。"}]},{"ID":"20240611153505-19u8ds2","Type":"NodeParagraph","Properties":{"id":"20240611153505-19u8ds2","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华东、中南、西南及陕西、甘肃等地。"}]},{"ID":"20240611153505-d72egcv","Type":"NodeParagraph","Properties":{"id":"20240611153505-d72egcv","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611153505-lm5xcdq","Type":"NodeParagraph","Properties":{"id":"20240611153505-lm5xcdq","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 白茅，多年生草本。高20-100cm。根茎白色，匍匐横走，密被鳞片。秆从生，直产，圆柱形，光滑无毛，基部被多数老叶及残留的叶鞘。叶线形或线状披针形；根出叶长几与植株相等；茎生叶较短，宽3-8mm，叶鞘褐色，无毛，或上部及边缘和鞘口具纤毛，具短叶舌。圆锥花序紧缩呈穗状，顶生，圆筒状，长5-20cm，宽1-2.5cm；小穗披针形或长圆形，成对排列在花序轴上，其中一小穗具较长的梗，另一小穗的梗较短；花两性，每小穗具1花，基部被白色丝状柔毛；两颖相等或第1颖稍短而狭，具3-4脉，第2颖较宽，具4-6脉；稃膜质，无毛，第1外稃卵状长圆形，内稃短，第2外稃披针形，与内稃等长；雄蕊2，花药黄色，长约3mm；雌蕊1，具较长的花柱，柱头羽毛状。颖果椭圆形，暗褐色，成熟的果序被白色长柔毛。花期5-6月，果期6-7月。"}]},{"ID":"20240611153505-1c9ahy0","Type":"NodeParagraph","Properties":{"id":"20240611153505-1c9ahy0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611153505-5mc97r5","Type":"NodeParagraph","Properties":{"id":"20240611153505-5mc97r5","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，喜阳耐旱，宜选一般坡地或平地栽培。 栽培技术 用根茎繁殖。春季，挖取白茅地下根茎，按行株距30cm×30cm栽种。"}]},{"ID":"20240611153505-341uwcu","Type":"NodeParagraph","Properties":{"id":"20240611153505-341uwcu","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611153505-i4xwapq","Type":"NodeParagraph","Properties":{"id":"20240611153505-i4xwapq","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎长圆柱形，有时分枝，长短不一，直径2-4mm。表面黄白色或淡黄色，有光泽，具纵皱纹，环节明显，节上残留灰棕色鳞叶及细根，节间长1-3cm。体轻，质韧，折断面纤维性，黄白色，多具放射状裂隙，有时中心可见一小孔。气微，味微甜。 以条粗、色白、味甜者为佳。 显微鉴别 根茎横切面：表皮为1列类方形小细胞，有的含硅质块。皮层较宽，最外为1-4列纤维，壁厚，木化；叶迹维管不10余个，环列，有限外韧型，具束鞘纤维，其旁常有裂隙；内皮层细胞内壁增厚，有的有硅质块。中柱内散有多数维管束，有限外韧型，近中柱鞘的维管束小而密，由纤维相连成环。中央常成空洞。 粉末特征：黄白色。①表皮细胞平行排列，每纵行列多为1个长细胞与2个短细胞（1个木栓细胞及1个硅细胞）相间排列，偶见1个短细胞介于2个长细胞之间。②内皮层细胞长方形，一侧壁甚薄，另一侧壁增厚，层纹及孔沟明显，壁上有硅质块。③中柱鞘厚壁细胞类长方形；根茎茎节处中柱鞘细胞呈石细胞状。④下皮纤维常具横隔。此外，有木纤维。"}]},{"ID":"20240611153505-xrhs1gt","Type":"NodeParagraph","Properties":{"id":"20240611153505-xrhs1gt","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611153505-bcbg5dg","Type":"NodeParagraph","Properties":{"id":"20240611153505-bcbg5dg","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 家兔灌服煎剂25g／kg，36小时后活动受抑制，运动迟缓，呼吸增快，但很快恢复。静脉注射10-15g／kg，则出现呼吸增快，运动受抑制。1小时后逐渐恢复，剂量增加至25g／kg，6小时后死亡。"}]},{"ID":"20240611153505-z9zbc7c","Type":"NodeParagraph","Properties":{"id":"20240611153505-z9zbc7c","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611153505-9l6dsy6","Type":"NodeParagraph","Properties":{"id":"20240611153505-9l6dsy6","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 根茎含芦竹素（arundoin），印白茅素（cylindrin），薏苡素（coixol），羊齿烯醇（fernenol），西米杜鹃醇（simiarenol），异山柑子萜醇（isoarborinol），白头翁素（anemonin）；还含甾醇类：豆甾醇（stigmasterol），β-谷甾醇（β-sitosterol），菜油甾醇（camposterol），糖类，多量蔗糖（sucros），葡萄糖（glucose）及少量果糖（fructose），木糖（sylose）；简单酸类：枸橼酸（cittic acid）草酸（oxalic acid）及苹果酸（malic acid）。"}]},{"ID":"20240611153505-kjzt9im","Type":"NodeParagraph","Properties":{"id":"20240611153505-kjzt9im","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611153505-upj2s8g","Type":"NodeParagraph","Properties":{"id":"20240611153505-upj2s8g","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 1.利尿作用：白茅根煎剂和水浸剂灌服，对正常家兔有利尿作用，给药5-10天，利尿作用最为明显，20天左右即不明显。但所用剂量特别是动物进水量均不清楚，又无对照组，尚需进一步研究。也有人认为白茅根的利尿作用与其所含的丰富钾盐有关。"}]},{"ID":"20240611153505-fd0gnti","Type":"NodeParagraph","Properties":{"id":"20240611153505-fd0gnti","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"2.止血作用：白茅根粉能明显缩短兔血浆的复钙时间。但白茅根含钙较多，可能干扰实验结果。白茅根粉撒于犬或兔的股动脉出血处，压迫1-2分钟，有止血作用。临床用白茅根治疗鼻衄。"}]},{"ID":"20240611153505-4ok04hf","Type":"NodeParagraph","Properties":{"id":"20240611153505-4ok04hf","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"3.抗菌作用：白茅根煎剂在试管内对福氏及宋内氏痢疾杆菌有明显的抑制作用，但对志贺氏及舒氏痢疾杆菌却无作用。"}]},{"ID":"20240611153505-eye15gu","Type":"NodeParagraph","Properties":{"id":"20240611153505-eye15gu","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"4.对心肌86Rb摄取量的影响：白茅根水醇综合提取物胙腔注射可使小鼠心肌对86Rb的摄取量增加。"}]},{"ID":"20240611153505-a4k2u45","Type":"NodeParagraph","Properties":{"id":"20240611153505-a4k2u45","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"5.其他作用：白茅根所含的薏苡素对骨骼肌的收缩及代谢有抑制作用。此外还有镇静、解热镇痛等作用。也有报道，白茅根无解热作用。"}]},{"ID":"20240611153505-0jojp33","Type":"NodeParagraph","Properties":{"id":"20240611153505-0jojp33","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611153505-5q4mv85","Type":"NodeParagraph","Properties":{"id":"20240611153505-5q4mv85","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 1.干茅根：拣净杂质，洗净，微润，切段，晒干，簸净碎屑。"}]},{"ID":"20240611153505-t19vaq5","Type":"NodeParagraph","Properties":{"id":"20240611153505-t19vaq5","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"2.茅根炭：取茅根段，置锅内用武火炒至黑色，喷洒清水，取出，晒干。"}]},{"ID":"20240611153505-0a0upnz","Type":"NodeParagraph","Properties":{"id":"20240611153505-0a0upnz","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611153505-gtquefh","Type":"NodeParagraph","Properties":{"id":"20240611153505-gtquefh","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粗粉5g，加苯30ml，加热回流1h，滤过。取滤液1ml蒸干，残渣加醋酐1ml溶解，再加浓硫酸1-2滴，显红色，渐变成紫色、蓝紫，最后呈污绿色。（2）取本品粗粉1g，加水10ml煮沸5-10min，滤过。滤液浓缩成1ml，加新制的斐林试液1ml，置水浴中加热，发生棕红色沉淀。"}]},{"ID":"20240611153505-257rqfb","Type":"NodeParagraph","Properties":{"id":"20240611153505-257rqfb","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611153505-f1kkhhd","Type":"NodeParagraph","Properties":{"id":"20240611153505-f1kkhhd","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 肺；胃；心；膀胱经"}]},{"ID":"20240611153505-9vr6nut","Type":"NodeParagraph","Properties":{"id":"20240611153505-9vr6nut","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611153505-vo7s6sk","Type":"NodeParagraph","Properties":{"id":"20240611153505-vo7s6sk","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 甘；寒"}]},{"ID":"20240611153505-tp03ymv","Type":"NodeParagraph","Properties":{"id":"20240611153505-tp03ymv","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611153505-d30m58z","Type":"NodeParagraph","Properties":{"id":"20240611153505-d30m58z","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 1.脾胃虚寒，溲多不渴者忌服。"}]},{"ID":"20240611153505-eldjgg2","Type":"NodeParagraph","Properties":{"id":"20240611153505-eldjgg2","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：因寒发哕，中寒呕吐，湿痰停饮发热，并不得服。"}]},{"ID":"20240611153505-nsr3l5f","Type":"NodeParagraph","Properties":{"id":"20240611153505-nsr3l5f","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：吐血因于虚寒者，非所宜也。"}]},{"ID":"20240611153505-purpofh","Type":"NodeParagraph","Properties":{"id":"20240611153505-purpofh","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611153505-c1l12za","Type":"NodeParagraph","Properties":{"id":"20240611153505-c1l12za","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 凉血止血；清热生津；利尿通淋。主血热出血；热病烦渴；胃热呕逆；肺热喘咳；小便淋沥涩痛；水肿；黄疸"}]},{"ID":"20240611153505-5y1omhg","Type":"NodeParagraph","Properties":{"id":"20240611153505-5y1omhg","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611153505-ueisho2","Type":"NodeParagraph","Properties":{"id":"20240611153505-ueisho2","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-30g，鲜品30-60g；或捣汁。外用：适量，鲜品捣汁涂。"}]},{"ID":"20240611153505-wt0rq4i","Type":"NodeParagraph","Properties":{"id":"20240611153505-wt0rq4i","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611153505-t9qhbra","Type":"NodeParagraph","Properties":{"id":"20240611153505-t9qhbra","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主劳伤虚赢，补中益气，除瘀血、血闭寒热，利小便。"}]},{"ID":"20240611153505-0p6p280","Type":"NodeParagraph","Properties":{"id":"20240611153505-0p6p280","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"2.《别录》：下五淋，除客热在肠胃，止渴，坚筋，妇人崩中。"}]},{"ID":"20240611153505-km4vir0","Type":"NodeParagraph","Properties":{"id":"20240611153505-km4vir0","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：主妇人月经不匀，通血脉淋沥。"}]},{"ID":"20240611153505-1qpszr7","Type":"NodeParagraph","Properties":{"id":"20240611153505-1qpszr7","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"4.《滇南本草》：止吐血，衄血，治血淋，利小便，止妇人崩漏下血。"}]},{"ID":"20240611153505-o8v3jap","Type":"NodeParagraph","Properties":{"id":"20240611153505-o8v3jap","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：白茅根，甘能除伏热，利小便，故能止诸血、哕逆、喘急、消渴，治黄疸水肿，乃良物也。世人因微而忽之，惟事苦寒之剂，致伤冲和之气，乌足知此哉？止吐衄诸血，伤寒哕逆，肺热喘急，水肿，黄疸，解酒毒。"}]},{"ID":"20240611153505-uz2nuoz","Type":"NodeParagraph","Properties":{"id":"20240611153505-uz2nuoz","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"6.《本经逢原》：白茅根，《本经》主治劳伤虚赢者，以甘寒能滋虚热，而无伤犯胃气之虞也。言补中益气，胃热去而中气复，是指客邪入伤中州，渐成虚赢而言，非劳伤本病所宜。治胃反上气，五淋疼热及痘疮干紫不起。"}]},{"ID":"20240611153505-mnmskn5","Type":"NodeParagraph","Properties":{"id":"20240611153505-mnmskn5","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"7.《动植物民间药》：治脚气。"}]},{"ID":"20240611153505-kot1l9h","Type":"NodeParagraph","Properties":{"id":"20240611153505-kot1l9h","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"8.《本草经疏》：劳伤虚赢，必内热，茅根甘能补脾，甘则虽寒而不犯胃。甘寒能除内热，故主劳伤虚赢。益脾所以补中，除热所以益气，甘能益血，血热则瘀，瘀则闭，闭则寒热作矣，寒凉血，甘益血，热去则血和，和则瘀消而闭通，通则寒热自止也。小便不利，由于内热也，热解则便自利。淋者，血分虚热所致也，凉血益血，则淋自愈，而肠胃之客热自解，津液生而渴亦止矣。肝藏血而主筋，补血凉肝，则筋坚矣。血热则崩，凉血和血，则崩自愈矣。血热则妄行，溢出上窍为吐、为咯、为鼻衄、齿衄，凉血和血，则诸证自除。益脾补中，利小便，故亦治水肿黄疸，而兼理伤寒哕逆也。"}]},{"ID":"20240611153505-cqcl6o7","Type":"NodeParagraph","Properties":{"id":"20240611153505-cqcl6o7","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"9.《本草求原》：白茅根，和上下之阳，清脾胃伏热，生肺津以凉血，为热血妄行上下诸失血之要药。"}]},{"ID":"20240611153505-5m2iney","Type":"NodeParagraph","Properties":{"id":"20240611153505-5m2iney","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"10.《医学衷中参西录》：白茅根必用鲜者，其效方着。春前秋后剖用之味甘，至生苗盛茂时，味即不甘，用之亦有效验，远胜干者。"}]},{"ID":"20240611153505-bpw1c9t","Type":"NodeParagraph","Properties":{"id":"20240611153505-bpw1c9t","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"11.《本草正义》：白茅根，寒凉而味甚甘，能清血分之热，而不伤干燥，又不粘腻，故凉血而不虑其积瘀，以主吐衄呕血。泄降火逆，其效甚捷，故又主胃火哕逆呕吐，肺热气逆喘满。且甘寒而多脂液，虽降逆而异于苦燥，则又止渴生津，而清涤肺胃肠间之伏热，能疗消谷燥渴。又能通淋闭而治溲血下血，并主妇女血热妄行，崩中淋带。又通利小水，泄热结之水肿，导瘀热之黄疸，皆甘寒通泄之实效。然其甘寒之力，清泄肺胃，尤有专长，凡齿痛龈肿，牙疳口舌诸疮，及肺热郁窒之咽痛腐烂诸证，用以佐使，功效最着，而无流弊。"}]},{"ID":"20240611153505-eyjreix","Type":"NodeParagraph","Properties":{"id":"20240611153505-eyjreix","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611153505-gr10zkd","Type":"NodeParagraph","Properties":{"id":"20240611153505-gr10zkd","updated":"20240611153505"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611153506-lk6gkzg","Type":"NodeThematicBreak","Properties":{"id":"20240611153506-lk6gkzg"}},{"ID":"20240611153507-t5bnje9","Type":"NodeParagraph","Properties":{"id":"20240611153507-t5bnje9"}}]}