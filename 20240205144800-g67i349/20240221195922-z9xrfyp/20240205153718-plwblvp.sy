545"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 458px;","style":"width: 448px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨4-20240629090115-1chpzzv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 448px;\" parent-style=\"width: 458px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 793px;","style":"width: 783px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240629091156-hky6ku5.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 783px;\" parent-style=\"width: 793px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240629090959-ba9uopl","Type":"NodeParagraph","Properties":{"id":"20240629090959-ba9uopl","updated":"20240823111024"},"Children":[{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 761px;","style":"width: 751px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨9-20240629091037-cfba0la.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 751px;\" parent-style=\"width: 761px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨6-20240629090535-z2gs9c7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823111009-1e7u66g","Type":"NodeParagraph","Properties":{"id":"20240823111009-1e7u66g","updated":"20240823111009"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 640px;","style":"width: 630px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨 2-20240823111009-qt8cs1n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 630px;\" parent-style=\"width: 640px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 640px;","style":"width: 630px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨8-20240629090959-4oe25qd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 630px;\" parent-style=\"width: 640px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629091156-nsy4fa6","Type":"NodeParagraph","Properties":{"id":"20240629091156-nsy4fa6","updated":"20240823110939"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 807px;","style":"width: 797px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨10-20240629091414-sqp19q0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 797px;\" parent-style=\"width: 807px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 457px;","style":"width: 447px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白芨 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白芨 1-20240823110926-0p7f6st.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 447px;\" parent-style=\"width: 457px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629091258-y2nmcci","Type":"NodeParagraph","Properties":{"id":"20240629091258-y2nmcci","updated":"20240629091302"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：白及常见的颜色是紫红色，另外还有白色、红色、黄色的观赏品种以及一些杂交品种。"}]},{"ID":"20240823111851-772ogpt","Type":"NodeParagraph","Properties":{"id":"20240823111851-772ogpt","updated":"20240823112036"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：还有一种白芨名为‘独叶白芨’，其本草人们称之为毛慈菇；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240206091724-lgs50ys","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"山慈菇（毛慈姑、杜鹃兰、冰球子）"}]},{"ID":"20240613093908-ryp0ycg","Type":"NodeThematicBreak","Properties":{"id":"20240613093908-ryp0ycg"}},{"ID":"20240613093953-370nond","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093953-370nond","updated":"20240613093958"},"Children":[{"Type":"NodeText","Data":"白芨《神农本草经》"}]},{"ID":"20240613093953-pkgrz45","Type":"NodeParagraph","Properties":{"id":"20240613093953-pkgrz45","updated":"20240613093953"},"Children":[{"Type":"NodeText","Data":"（《御览》作芨）"}]},{"ID":"20240613093953-6enbwel","Type":"NodeParagraph","Properties":{"id":"20240613093953-6enbwel","updated":"20240613093953"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240613093953-y9u28y8","Type":"NodeParagraph","Properties":{"id":"20240613093953-y9u28y8","updated":"20240613093953"},"Children":[{"Type":"NodeText","Data":"主痈肿，恶创，败疽，伤阴，死肌，胃中邪气，赋风，鬼击，痱缓，不收。一名甘根，一名连及草。生川谷。"}]},{"ID":"20240613093953-x9gxsbq","Type":"NodeParagraph","Properties":{"id":"20240613093953-x9gxsbq","updated":"20240613093953"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：神农苦，黄帝辛，李氏大寒，雷公辛无毒，茎叶似生姜，藜芦，十月华，直上，紫赤，根白连，二月八月九月采。"}]},{"ID":"20240613093953-sd619pm","Type":"NodeParagraph","Properties":{"id":"20240613093953-sd619pm","updated":"20240613093953"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生北山及冤句，及越山。"}]},{"ID":"20240613093953-goi4mpo","Type":"NodeParagraph","Properties":{"id":"20240613093953-goi4mpo","updated":"20240613093953"},"Children":[{"Type":"NodeText","Data":"案隋羊公服黄精法云：黄精一名白及亦为黄精别名，今《名医》别出黄精条。"}]},{"ID":"20240613094215-e6gesiq","Type":"NodeThematicBreak","Properties":{"id":"20240613094215-e6gesiq"}},{"ID":"20240613094217-dpdhs8w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094217-dpdhs8w","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"白及"}]},{"ID":"20240613094217-wghz72k","Type":"NodeParagraph","Properties":{"id":"20240613094217-wghz72k","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"「释名」连及草、甘根、白给。"}]},{"ID":"20240613094217-fs956gk","Type":"NodeParagraph","Properties":{"id":"20240613094217-fs956gk","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、平、无毒。"}]},{"ID":"20240613094217-8v8o78x","Type":"NodeParagraph","Properties":{"id":"20240613094217-8v8o78x","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613094217-kuibdpt","Type":"NodeParagraph","Properties":{"id":"20240613094217-kuibdpt","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"1、鼻血不止。用口水调白及末涂鼻梁上低处（名“山根”）；另取白及末一钱，水冲服。"}]},{"ID":"20240613094217-wc4efwd","Type":"NodeParagraph","Properties":{"id":"20240613094217-wc4efwd","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"2、心气疼痛。用白及、石榴皮各二钱，研细，加炼蜜和成丸子，如黄豆大。每服三丸，艾醋汤送下。"}]},{"ID":"20240613094217-yopsmmn","Type":"NodeParagraph","Properties":{"id":"20240613094217-yopsmmn","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"3、妇女阴脱。用白及、川乌药，等分为末，薄布包一钱，纳入阴道中，觉胜利内热即止。每天用一次。"}]},{"ID":"20240613094217-6uq3pgf","Type":"NodeParagraph","Properties":{"id":"20240613094217-6uq3pgf","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"4、疔疮、肿疮。用白及末半钱，澄水中，等水清后，去水，以药摊厚纸上贴于患处。"}]},{"ID":"20240613094217-p0kx01c","Type":"NodeParagraph","Properties":{"id":"20240613094217-p0kx01c","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"5、跌打骨折。用白及末二钱，酒调服。"}]},{"ID":"20240613094217-txzgz8e","Type":"NodeParagraph","Properties":{"id":"20240613094217-txzgz8e","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"6、刀伤。用白及、煅石膏，等分为末，洒伤口上。"}]},{"ID":"20240613094217-8smca6n","Type":"NodeParagraph","Properties":{"id":"20240613094217-8smca6n","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"7、冬季手足皲裂。用白及粉加水调匀，填入裂口。患处不能沾水。"}]},{"ID":"20240613094217-skc5n1g","Type":"NodeParagraph","Properties":{"id":"20240613094217-skc5n1g","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"8、汤火伤。用白及粉调油涂搽。"}]},{"ID":"20240613094217-dabo5wp","Type":"NodeParagraph","Properties":{"id":"20240613094217-dabo5wp","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"9、重伤呕血。每日服白及末，米汤送下。"}]},{"ID":"20240613094217-ftfgmi8","Type":"NodeParagraph","Properties":{"id":"20240613094217-ftfgmi8","updated":"20240613094217"},"Children":[{"Type":"NodeText","Data":"10、肺、胃出血。治法同上。"}]},{"ID":"20240613093908-8mgf7at","Type":"NodeThematicBreak","Properties":{"id":"20240613093908-8mgf7at"}},{"ID":"20240613093942-rkju32i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093942-rkju32i","updated":"20240613093946"},"Children":[{"Type":"NodeText","Data":"白芨《本草经集注》"}]},{"ID":"20240613093942-owzxysr","Type":"NodeParagraph","Properties":{"id":"20240613093942-owzxysr","updated":"20240613093942"},"Children":[{"Type":"NodeText","Data":"味苦、辛，平、微寒，无毒。主治痈肿，恶疮，败疽，伤阴，死肌，胃中邪气。贼风鬼击，痱缓不收。除白癣疥虫。一名甘根，一名连及草。生北山川谷及宛朐及越山。（紫石英为之使，恶理石，畏李核、杏仁。）"}]},{"ID":"20240613093942-jmmyn3m","Type":"NodeParagraph","Properties":{"id":"20240613093942-jmmyn3m","updated":"20240613093942"},"Children":[{"Type":"NodeText","Data":"近道处处有之。叶似杜若，根形似菱米，节间有毛。方用亦稀，可以作糊。"}]},{"ID":"20240613094039-t26z7hu","Type":"NodeThematicBreak","Properties":{"id":"20240613094039-t26z7hu"}},{"ID":"20240613094040-8ub305u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094040-8ub305u","updated":"20240613094043"},"Children":[{"Type":"NodeText","Data":"白芨《本草分经》"}]},{"ID":"20240613094040-lnwc9hp","Type":"NodeParagraph","Properties":{"id":"20240613094040-lnwc9hp","updated":"20240613094040"},"Children":[{"Type":"NodeText","Data":"苦辛平，性涩入肺，止吐血，去瘀生新，肺损者能复生之，治跌打汤火伤及疮痈。"}]},{"ID":"20240613094058-9mwvh8a","Type":"NodeThematicBreak","Properties":{"id":"20240613094058-9mwvh8a"}},{"ID":"20240613094100-q9m9pvp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094100-q9m9pvp","updated":"20240613094104"},"Children":[{"Type":"NodeText","Data":"白芨《增广和剂局方药性总论》"}]},{"ID":"20240613094100-7zuhqw3","Type":"NodeParagraph","Properties":{"id":"20240613094100-7zuhqw3","updated":"20240613094100"},"Children":[{"Type":"NodeText","Data":"味辛苦，平。微寒，无毒。主痈肿恶疮败疽，伤阴死肌，胃中邪气，贼风鬼击，痱缓不收，除白癣疥虫。《药性论》云∶使。治热结不消，主阴下痿，治面上 疮。日华子云∶止惊邪，血邪，痫疾，赤眼，症结，发背，瘰 ，肠风，痔 ，刀箭疮，扑损，温热疟疾，血痢。紫石英为之使。恶∶理石。畏∶李核、杏仁。"}]},{"ID":"20240613094146-shzl2lk","Type":"NodeThematicBreak","Properties":{"id":"20240613094146-shzl2lk"}},{"ID":"20240613094147-fozvvou","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094147-fozvvou","updated":"20240613094151"},"Children":[{"Type":"NodeText","Data":"白芨《本草撮要》"}]},{"ID":"20240613094147-0evt1hj","Type":"NodeParagraph","Properties":{"id":"20240613094147-0evt1hj","updated":"20240613094147"},"Children":[{"Type":"NodeText","Data":"味苦．入手太阴经．功专疗金疮痈毒．得黄绢、丹皮能补脬损．并跌打折伤．手足皴裂．滑肌．紫石英为使．畏杏仁．反乌头．重舌鹅口为末．乳汁调涂足心．"}]},{"ID":"20240613094155-pnwu2zl","Type":"NodeThematicBreak","Properties":{"id":"20240613094155-pnwu2zl"}},{"ID":"20240613094157-3juhyzf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094157-3juhyzf","updated":"20240613094203"},"Children":[{"Type":"NodeText","Data":"白芨《新修本草》"}]},{"ID":"20240613094157-6x7mv9y","Type":"NodeParagraph","Properties":{"id":"20240613094157-6x7mv9y","updated":"20240613094157"},"Children":[{"Type":"NodeText","Data":"味苦、辛，平、微寒，无毒。主痈肿，恶疮，败疽，伤阴，死肌，胃中邪气，贼风鬼击，痱一名甘根，一名连及草。生北山川谷及宛朐及越山。"}]},{"ID":"20240613094157-dexlztv","Type":"NodeParagraph","Properties":{"id":"20240613094157-dexlztv","updated":"20240613094157"},"Children":[{"Type":"NodeText","Data":"紫石英为之使，恶理石，畏李核、杏仁。近道处处有之。叶似杜若，根形似菱米，节间有毛。方用亦希，可以作糊。"}]},{"ID":"20240613094157-nijq6q4","Type":"NodeParagraph","Properties":{"id":"20240613094157-nijq6q4","updated":"20240613094157"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物，山野人患手足皲拆，嚼以涂之有效。"}]},{"ID":"20240613094132-tkryg7q","Type":"NodeThematicBreak","Properties":{"id":"20240613094132-tkryg7q"}},{"ID":"20240613094133-18j2f32","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094133-18j2f32","updated":"20240613094141"},"Children":[{"Type":"NodeText","Data":"白芨《本草图经》"}]},{"ID":"20240613094133-fhnfguu","Type":"NodeParagraph","Properties":{"id":"20240613094133-fhnfguu","updated":"20240613094137"},"Children":[{"Type":"NodeText","Data":"白及，生北山川谷，又冤句及越山，今江淮、河、陕、汉、黔诸州皆有之，生石山上。春生苗，长一尺许，似 榈及藜芦，茎端生一台；叶两指大，青色；夏开花紫；七月结实，至熟黄黑色。至冬叶凋。根似菱米，有三角白色，角端生芽。二月、七月采根。今医治金疮不差及痈疽方中多用之。"}]},{"ID":"20240613094121-lrfardq","Type":"NodeThematicBreak","Properties":{"id":"20240613094121-lrfardq"}},{"ID":"20240613094122-0fpdve6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094122-0fpdve6","updated":"20240613094127"},"Children":[{"Type":"NodeText","Data":"白芨《得配本草》"}]},{"ID":"20240613094122-eji65cf","Type":"NodeParagraph","Properties":{"id":"20240613094122-eji65cf","updated":"20240613094122"},"Children":[{"Type":"NodeText","Data":"紫石英为之使。畏杏仁、李核仁。恶理石。反乌头。"}]},{"ID":"20240613094122-qfoxpxy","Type":"NodeParagraph","Properties":{"id":"20240613094122-qfoxpxy","updated":"20240613094122"},"Children":[{"Type":"NodeText","Data":"苦、涩、微寒。入手太阴经。治肺伤吐血，敷手足皲裂，汤火灼伤，金疮疥癣，恶疮痈毒，败疽死肌，去腐生新。"}]},{"ID":"20240613094122-cnqhlnn","Type":"NodeParagraph","Properties":{"id":"20240613094122-cnqhlnn","updated":"20240613094122"},"Children":[{"Type":"NodeText","Data":"得羊肝，蘸末，治肝血吐逆。得酒调服，治跌打骨折。配米饮，止肺伤吐血。配榴皮，艾醋汤下，治心痛。配黄绢、丹皮，补脬破损。和津敷山根上，止鼻衄。（仍以水服一钱。）"}]},{"ID":"20240613094122-nh0a2sm","Type":"NodeParagraph","Properties":{"id":"20240613094122-nh0a2sm","updated":"20240613094122"},"Children":[{"Type":"NodeText","Data":"或研用，或磨用。"}]},{"ID":"20240613094110-5pr2gqi","Type":"NodeThematicBreak","Properties":{"id":"20240613094110-5pr2gqi"}},{"ID":"20240613094111-ak28mka","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094111-ak28mka","updated":"20240613094116"},"Children":[{"Type":"NodeText","Data":"白芨《本草求真》"}]},{"ID":"20240613094111-ifji6rj","Type":"NodeParagraph","Properties":{"id":"20240613094111-ifji6rj","updated":"20240613094111"},"Children":[{"Type":"NodeText","Data":"（山草）入肺涩血散瘀"}]},{"ID":"20240613094111-t16gvw0","Type":"NodeParagraph","Properties":{"id":"20240613094111-t16gvw0","updated":"20240613094111"},"Children":[{"Type":"NodeText","Data":"白芨（专入肺）。味苦而辛。性涩而收。微寒无毒。方书既载功能入肺止血。又载能治跌扑折骨。汤火灼伤。恶疮痈肿。败疽死肌。得非似收不收。似涩不涩。似止不止乎。不知书言功能止血者。是因性涩之谓也。（血出于鼻。是由清道而至。血出于口。是由浊道而来。呕血出于肝。吐血出于胃。痰带血。出于脾。咯血出于心。唾血出于肾。摘玄云。试血法。吐水内浮者。肺血也。沉者。肝血也。半浮半沉者。心血也。服白芨须随所见。以羊肺肝心同服者佳。）书言能治痈疽损伤者。是因味辛能散之谓也。此药涩中有散。补中有破。故书又载去腐逐瘀生新。至云重囚肺有白芨一事。因剖而见。色犹不变。虽云肺叶损坏可以复生。然终涉于荒唐。未可尽信。（台州狱吏悯一重囚。囚因感之云。吾七犯死罪。遭刑拷。肺皆损伤。得一方。用白芨末米饮送下。其效如神。后囚凌迟。剖开胸。见肺间窍穴。皆白芨填补。色犹不变也。）手足皴裂。面上黑 。（即面疮）并跌打损伤。（酒调服。）汤火灼伤。（油调敷。）用治亦效。紫石英为使。恶杏仁。反乌头。"}]},{"ID":"20240613094048-s7qnyb6","Type":"NodeThematicBreak","Properties":{"id":"20240613094048-s7qnyb6"}},{"ID":"20240613094049-aauqw03","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094049-aauqw03","updated":"20240613094053"},"Children":[{"Type":"NodeText","Data":"白芨《汤液本草》"}]},{"ID":"20240613094049-4ir9318","Type":"NodeParagraph","Properties":{"id":"20240613094049-4ir9318","updated":"20240613094049"},"Children":[{"Type":"NodeText","Data":"苦、甘，阳中之阴。味辛、苦，平，微寒。无毒。"}]},{"ID":"20240613094049-jzr62q5","Type":"NodeParagraph","Properties":{"id":"20240613094049-jzr62q5","updated":"20240613094049"},"Children":[{"Type":"NodeText","Data":"《珍》云∶止肺涩。白蔹治证同。"}]},{"ID":"20240613094049-rw1mz6q","Type":"NodeParagraph","Properties":{"id":"20240613094049-rw1mz6q","updated":"20240613094049"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主痈肿恶疮、败疽，伤阴死肌，胃中邪气，贼风鬼击，痱缓不收，白癣疥虫。"}]},{"ID":"20240613094049-bqigbx1","Type":"NodeParagraph","Properties":{"id":"20240613094049-bqigbx1","updated":"20240613094049"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶使。治热结不消，主阴下痿，治面上 。"}]},{"ID":"20240613094028-ya2amhi","Type":"NodeThematicBreak","Properties":{"id":"20240613094028-ya2amhi"}},{"ID":"20240613094029-0cpmnkm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094029-0cpmnkm","updated":"20240613094034"},"Children":[{"Type":"NodeText","Data":"白芨《冯氏锦囊秘录》"}]},{"ID":"20240613094029-7t2aqwm","Type":"NodeParagraph","Properties":{"id":"20240613094029-7t2aqwm","updated":"20240613094029"},"Children":[{"Type":"NodeText","Data":"得季秋之气，兼金水之性，故味苦，辛，平、微寒，无毒。辛为金味，收为金气，苦能泄热，辛能散结，故治败疽死肌。散结逐腐，生新之要药。既能敛毒，排脓生肌长肉，又治打跌骨折，酒调白芨末二钱服之，其功不减于自然铜、古铢钱也。"}]},{"ID":"20240613094029-olybk1f","Type":"NodeParagraph","Properties":{"id":"20240613094029-olybk1f","updated":"20240613094029"},"Children":[{"Type":"NodeText","Data":"白芨，惟熬膏敷，功专收敛，然收中有散，又能腓脓去溃疡败疽，死肌腐肉，敷山根止衄，涂疥疮杀虫，古方有用以作丸，治肺叶伤破出血，亦能如溃疽长肉平满耳。"}]},{"ID":"20240613094019-tlg04cb","Type":"NodeThematicBreak","Properties":{"id":"20240613094019-tlg04cb"}},{"ID":"20240613094020-uni49f4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094020-uni49f4","updated":"20240613094024"},"Children":[{"Type":"NodeText","Data":"白芨《医学入门》"}]},{"ID":"20240613094020-g5am8ww","Type":"NodeParagraph","Properties":{"id":"20240613094020-g5am8ww","updated":"20240613094020"},"Children":[{"Type":"NodeText","Data":"白芨苦辛平无毒，痈疽疥癣裂皮肉，平胃风痱缓不收，补肺止血治打扑。"}]},{"ID":"20240613094020-hmxnjnm","Type":"NodeParagraph","Properties":{"id":"20240613094020-hmxnjnm","updated":"20240613094020"},"Children":[{"Type":"NodeText","Data":"及， 也，栏也。叶初生似井栏。阳中阴也。主痈肿恶疮，败疽死肌，除白癣疥虫。嚼涂手足皲裂、痔 、刀箭汤火等疮，生肌止痛方多用之。平胃中邪气，贼风鬼击，痱缓不收。治久咳，呕血，咯血，肠风血痢。单用为末，米饮调服。凡被打拷，肺窍控损见血者尤妙，以其能补肺窍也。又衄血不止者，津调涂山根立止。"}]},{"ID":"20240613094020-8b7wn1a","Type":"NodeParagraph","Properties":{"id":"20240613094020-8b7wn1a","updated":"20240613094020"},"Children":[{"Type":"NodeText","Data":"珍云∶涩肺与白蔹性治大同，兼治结热不消，阴痿面黯，令人肌滑。入丸可少用作糊。水洗紫石英为使，恶理石，畏李核、杏仁，反乌头。"}]},{"ID":"20240613094009-iu4kem4","Type":"NodeThematicBreak","Properties":{"id":"20240613094009-iu4kem4"}},{"ID":"20240613094010-bc1z3jp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094010-bc1z3jp","updated":"20240613094015"},"Children":[{"Type":"NodeText","Data":"白芨《证类本草》"}]},{"ID":"20240613094010-jjgw52i","Type":"NodeParagraph","Properties":{"id":"20240613094010-jjgw52i","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"味苦、辛，平、微寒，无毒。主痈肿恶疮败疽，伤阴死肌，胃中邪气，贼风鬼击，痱（音肥）缓不收，除白癣疥虫。一名甘根，一名连及草。生北山川谷，又冤句及越山。（紫石英为之使，恶理石，畏李核、杏仁。）"}]},{"ID":"20240613094010-q5m5ado","Type":"NodeParagraph","Properties":{"id":"20240613094010-q5m5ado","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处有之。叶似杜若，根形似菱米，节间有毛。方用亦稀，可以作糊。"}]},{"ID":"20240613094010-x61p4jp","Type":"NodeParagraph","Properties":{"id":"20240613094010-x61p4jp","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此物，山野人患手足皲（音军）拆，嚼以涂之有效。臣禹锡等谨按蜀本云∶反乌头。"}]},{"ID":"20240613094010-3jhnas5","Type":"NodeParagraph","Properties":{"id":"20240613094010-3jhnas5","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"又七月实熟，黄黑色，冬凋。根似菱，三角，白色，角头生芽。今出申州。二月、八月采根用。吴氏云神农∶苦。黄帝∶辛。李氏∶大寒。雷公∶辛，无毒。茎叶如生姜、藜芦，十月华，直上，紫赤，根白连，二月、八月、九月采。药性论云∶白芨，使。能治结热不消，主阴下痿，治面上 ，令人肌滑。日华子云∶味甘 止惊邪血邪，痫疾，赤眼症结，发背瘰 ，肠风痔，刀箭疮，扑损，温热疟疾，血痢，汤火疮，生肌止痛，风痹。"}]},{"ID":"20240613094010-u678a1f","Type":"NodeParagraph","Properties":{"id":"20240613094010-u678a1f","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"图经曰∶白芨，生北山川谷，又冤句及越山，今江淮、河、陕、汉、黔诸州皆有之，生石山上。春生苗，长一尺许。似 榈及藜芦，茎端生一台，叶两指大，青色。夏开花紫。七月结实至熟，黄黑色。至冬叶凋。根似菱米，有三角，白色，角端生芽。二月、七月采根。今医治金疮不瘥及痈疸方中多用之。"}]},{"ID":"20240613094010-5d4y8p6","Type":"NodeParagraph","Properties":{"id":"20240613094010-5d4y8p6","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"经验方∶治鼻衄不止甚者。白芨为末，津调涂山根上，立止。"}]},{"ID":"20240613094010-uwz16sp","Type":"NodeParagraph","Properties":{"id":"20240613094010-uwz16sp","updated":"20240613094010"},"Children":[{"Type":"NodeText","Data":"衍义∶白芨，文具白蔹条下。"}]},{"ID":"20240613093908-nrkgb9k","Type":"NodeThematicBreak","Properties":{"id":"20240613093908-nrkgb9k"}},{"ID":"20240613093931-535icp4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093931-535icp4","updated":"20240613093934"},"Children":[{"Type":"NodeText","Data":"白芨《本草从新》"}]},{"ID":"20240613093931-6tul8rg","Type":"NodeParagraph","Properties":{"id":"20240613093931-6tul8rg","updated":"20240613093931"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"涩、补肺、化瘀生新．"}]},{"ID":"20240613093931-cmtdhxw","Type":"NodeParagraph","Properties":{"id":"20240613093931-cmtdhxw","updated":"20240613093931"},"Children":[{"Type":"NodeText","Data":"苦辛而平．性涩而收．得秋金之令．入肺止吐血．（摘元去、试血法、吐水内浮者肺血也、沉者肝血也、半浮沉者心血也、各随所见、以羊肺肝心、蘸白芨末、日日服之、佳．）肺损者．能复生之．（以有形生有形也、人之五脏、惟肺叶损坏者、可以复生．）治跌打折骨．（酒服二钱．）汤火灼伤．（油调末敷．）恶疮痈肿．败疽死肌．去腐．逐瘀．生新．除面上．（ 音干、去声、面黑气、 音炮、面疮也．）涂手足皲裂．令人肌滑．紫石英为使．畏杏仁．反乌头．（重舌、鹅口、为末、乳汁调、涂足心．）"}]},{"ID":"20240613093909-sbhqtdw","Type":"NodeThematicBreak","Properties":{"id":"20240613093909-sbhqtdw"}},{"ID":"20240613093922-vqpjajf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093922-vqpjajf","updated":"20240613093926"},"Children":[{"Type":"NodeText","Data":"白芨《玉楸药解》"}]},{"ID":"20240613093922-4afl8wb","Type":"NodeParagraph","Properties":{"id":"20240613093922-4afl8wb","updated":"20240613093922"},"Children":[{"Type":"NodeText","Data":"味苦，气平，入手太阴肺经。敛肺止血，消肿散瘀。"}]},{"ID":"20240613093922-2vn3otg","Type":"NodeParagraph","Properties":{"id":"20240613093922-2vn3otg","updated":"20240613093922"},"Children":[{"Type":"NodeText","Data":"白芨黏涩，收敛肺气，止吐衄失血，治痈疽瘰疬、痔瘘疥癣、皯皰之病，跌打汤火金疮之类俱善。"}]},{"ID":"20240613093909-0mgjw6v","Type":"NodeThematicBreak","Properties":{"id":"20240613093909-0mgjw6v"}},{"ID":"20240613093910-vanfnwk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093910-vanfnwk","updated":"20240613093916"},"Children":[{"Type":"NodeText","Data":"白芨《本草新编》"}]},{"ID":"20240613093910-1lrvzqk","Type":"NodeParagraph","Properties":{"id":"20240613093910-1lrvzqk","updated":"20240613093910"},"Children":[{"Type":"NodeText","Data":"白芨，味苦、辛，气平、微寒，阳中之阴也。入肺经。功专收敛，亦能止血。败症溃疡、死肌腐肉，皆能去之。敷山根，止衄血。涂疥癣，杀虫。此物近人皆用之外治，殊不知其内治更神，用之以止血者，非外治也。将白芨研末，调入于人参、归、芎、黄 之内，一同吞服，其止血实神。夫吐血未有不伤胃者也，胃伤则血不藏而上吐矣。然而胃中原无血也，血在胃之外，伤胃则胃不能障血，而血入于胃中，胃不藏而上吐。白芨善能收敛，同参、 、归、芎直入胃中，将胃中之窍敛塞，窍闭则血从何来，此血之所以能止也。况白芨又不止治胃中之血，凡有空隙，皆能补塞。乌可徒借外治，而不亟用以内治乎。"}]},{"ID":"20240613093910-x9cixea","Type":"NodeParagraph","Properties":{"id":"20240613093910-x9cixea","updated":"20240613093910"},"Children":[{"Type":"NodeText","Data":"或问白芨能填补肺中之损，闻昔年有贼犯受伤，曾服白芨得愈，后贼被杀，开其胸膛，见白芨填塞于所伤之处，果有之乎？此前人已验之方也，何必再疑。白芨实能走肺，填塞于所伤之外。但所言只用一味服之，此则失传之误也。予见野史载此，则又不如此，史言受刑时，自云∶我服白芨散五年，得以再生，不意又死于此。人问其方，贼曰∶我遇云游道士，自称越人，传我一方∶白芨一斤、人参一两、麦冬半斤，教我研末，每日饥服三钱，吐血症全愈。然曾诫我云∶我救汝命，汝宜改过，否则，必死于刑，不意今死于此，悔不听道士之言也。我传方于世，庶不没道士之恩也。野史所载如此。方用麦冬为佐以养肺，用人参为使以益气，则白芨填补肺中之伤，自易奏功，立方甚妙。惜道士失载其姓名。所谓越人，意者即扁鹊公之化身也。"}]},{"ID":"20240613093647-lb11hvl","Type":"NodeThematicBreak","Properties":{"id":"20240613093647-lb11hvl"}},{"ID":"20240613093856-xyx6frl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093856-xyx6frl","updated":"20240613093902"},"Children":[{"Type":"NodeText","Data":"白芨《要药分剂》"}]},{"ID":"20240613093856-iwkch3q","Type":"NodeParagraph","Properties":{"id":"20240613093856-iwkch3q","updated":"20240613093856"},"Children":[{"Type":"NodeText","Data":"味苦辛。性微寒。无毒。得季秋之气。兼禀金水之性以生。降也。阳中阴也。紫石英为使。畏李核、杏仁。反乌头。"}]},{"ID":"20240613093856-52qnfp5","Type":"NodeParagraph","Properties":{"id":"20240613093856-52qnfp5","updated":"20240613093856"},"Children":[{"Type":"NodeText","Data":"【主治】主痈肿。恶疮败疽。伤阴死肌。胃中邪气。贼风鬼击。痱缓不收。（本经）止惊邪伤。"}]},{"ID":"20240613093856-5iizvww","Type":"NodeParagraph","Properties":{"id":"20240613093856-5iizvww","updated":"20240613093856"},"Children":[{"Type":"NodeText","Data":"【归经】入肺经。为补肺逐瘀生新之品。（兼补剂）【前论】思邈曰。肺损者。复能生之。丹溪曰。凡吐血不止。宜加白芨以止之。时珍曰见。"}]},{"ID":"20240613093856-is73y0s","Type":"NodeParagraph","Properties":{"id":"20240613093856-is73y0s","updated":"20240613093856"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。凡痈疽已溃。不宜同苦寒药服。"}]},{"ID":"20240613093705-0inq6xy","Type":"NodeThematicBreak","Properties":{"id":"20240613093705-0inq6xy"}},{"ID":"20240613093845-nuy5ag1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093845-nuy5ag1","updated":"20240613093850"},"Children":[{"Type":"NodeText","Data":"白芨《本草备要》"}]},{"ID":"20240613093845-zfsumwz","Type":"NodeParagraph","Properties":{"id":"20240613093845-zfsumwz","updated":"20240613093845"},"Children":[{"Type":"NodeText","Data":"涩，补肺，逐瘀生新"}]},{"ID":"20240613093845-69nx8dr","Type":"NodeParagraph","Properties":{"id":"20240613093845-69nx8dr","updated":"20240613093845"},"Children":[{"Type":"NodeText","Data":"味苦而辛，性涩而收。得秋金之令，入肺止吐血，（《摘玄》云∶试血法，吐水内浮者肺血也，沉者肝血也，半浮沉者心血也。各随所见，以羊肺、肝、心蘸白芨末，日日服之佳），肺损者能复生之（以有形生有形也。人之五脏，惟肺叶损坏者，可以复生。台州狱吏悯一重囚，囚感之曰∶吾七犯死罪，遭刑拷，肺皆损伤。得一方，用白芨末米饮日服，其效如神。后囚凌迟，剖开胸，见肺开窍穴数十，皆白芨填补，色犹不变也）。"}]},{"ID":"20240613093845-qiq2vjp","Type":"NodeParagraph","Properties":{"id":"20240613093845-qiq2vjp","updated":"20240613093845"},"Children":[{"Type":"NodeText","Data":"治跌打折骨（酒服二钱），汤火灼伤（油调末敷），恶疮痈肿，败疽死肌。去腐逐瘀生新，除面上 （ 音千，去声，面黑气。 音炮，面疮也），涂手足皴裂，令人肌滑。"}]},{"ID":"20240613093845-auxqxh3","Type":"NodeParagraph","Properties":{"id":"20240613093845-auxqxh3","updated":"20240613093845"},"Children":[{"Type":"NodeText","Data":"紫石英为使。畏杏仁。反乌头。"}]},{"ID":"20240613093705-zeyv0r2","Type":"NodeThematicBreak","Properties":{"id":"20240613093705-zeyv0r2"}},{"ID":"20240613093834-mysjdzc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093834-mysjdzc","updated":"20240613093839"},"Children":[{"Type":"NodeText","Data":"白芨《本草便读》"}]},{"ID":"20240613093834-9aacg95","Type":"NodeParagraph","Properties":{"id":"20240613093834-9aacg95","updated":"20240613093834"},"Children":[{"Type":"NodeText","Data":"清金治嗽．苦辛甘涩性平寒．止血生肌．散结敛疮质腻滑．（白芨色白．味甘苦兼辛．气平微寒．性滑．有汁极粘腻．得秋金之令．而主收敛．专入肺家血分．故止血止嗽生肌治疮．皆取用之．然必虚而有热者乃为相宜耳．白芨虽禀秋金收敛之性．而仍具苦泄辛散之意．与白蔹相近．故每相需而用．但非治病紧要之品耳．）"}]},{"ID":"20240613093705-4k6bezd","Type":"NodeThematicBreak","Properties":{"id":"20240613093705-4k6bezd"}},{"ID":"20240613093824-ujx85ut","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093824-ujx85ut","updated":"20240613093828"},"Children":[{"Type":"NodeText","Data":"白芨《本草述钩元》"}]},{"ID":"20240613093824-0ul9g13","Type":"NodeParagraph","Properties":{"id":"20240613093824-0ul9g13","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"出北山及冤句越山江淮河陕汉黔诸州。根色白似菱。有三角。角头生芽。节有毛。质极粘腻。"}]},{"ID":"20240613093824-0vgs7oa","Type":"NodeParagraph","Properties":{"id":"20240613093824-0vgs7oa","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"根味苦辛甘。气微寒。性涩而收。阳中之阴。肺药也。紫石英为之使。恶理石。畏李核杏仁。反乌头。止肺血。疗肺伤。敷痈肿恶疮败疽。伤阴死肌。（此阳毒之伤其阴血者）除白癣疥虫结热不散。止惊邪血邪。并刀箭疮伤火疮。生肌止痛。（诸本草）方书治咯血。小便不禁。为面药。凡金疮不瘥。及痈疽方多用之。能入血分。泄热散结。逐腐。第其性涩。"}]},{"ID":"20240613093824-0n75dzf","Type":"NodeParagraph","Properties":{"id":"20240613093824-0n75dzf","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"破散中又有收敛。盖去瘀即以生新之药也。（仲淳）凡吐血不止。宜加白芨。（丹溪）试血法。"}]},{"ID":"20240613093824-627qjs7","Type":"NodeParagraph","Properties":{"id":"20240613093824-627qjs7","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"吐在水碗内浮者。肺血也。沉者。肝血也。半浮半沉者。心血也。各随所见。以羊肺羊肝羊心煮熟。蘸白芨末。日日食之。（濒湖）一味为细末。米饮调三钱服。治损肺吐血。有奇效。"}]},{"ID":"20240613093824-kl78x31","Type":"NodeParagraph","Properties":{"id":"20240613093824-kl78x31","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"得白蔹红药子。加脑麝乳没。治一切痈疽肿毒。止痛散结排脓。有神。"}]},{"ID":"20240613093824-sg8kg9i","Type":"NodeParagraph","Properties":{"id":"20240613093824-sg8kg9i","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"附案一妇年五旬。素因血虚生热化风。遍体有疙瘩。经年不愈。久之。少阳相火并于阳明而患喉痹。疾暴势甚。喉中陡痒。作嗽气呛。遍喉血泡累累。上一泡。大如鸡卵。口塞不合。气涌更急。少顷。泡破血射如注。其皮尽脱。溃烂红肿。痛不可忍。且满口痰涎。"}]},{"ID":"20240613093824-8lqm2sn","Type":"NodeParagraph","Properties":{"id":"20240613093824-8lqm2sn","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"如羹如糊。此其为血泡。为喉皮溃烂。皆热壅于上。阴气大伤。缘汤药难吞。遂以养阴退阳活血止痛诸药为末。或吹或点。诸证渐退。奈喉中皮溃而肌未生。痛不止。且因皮破致时作嗽而血随出。后于吹药中。入白芨磨浆合丸。日夜噙化之。所患悉愈。可知此味和阴护阳。"}]},{"ID":"20240613093824-gzzzaet","Type":"NodeParagraph","Properties":{"id":"20240613093824-gzzzaet","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"乃能生肌。止痛。理或然也。"}]},{"ID":"20240613093824-trqnf1e","Type":"NodeParagraph","Properties":{"id":"20240613093824-trqnf1e","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"〔论〕白芨得秋金之令。性涩而收。其根色白。金气之所聚也。结实黄黑者。金气之由母而趋子也。观其似菱有三角。角头生芽。质极粘腻。则其气之所急归。归于其子矣。惟金水子母之气全。故咯血之治是为的对。至采根当以八九月者。专取归阴之盛气也。其味先苦后辛。气复微寒。从下而上。以致阴气于肺。盖即收令中而有泄热散结之能。不仅着长于收涩。总之。此味治肺伤有专功。肺主皮毛。为天表之阳。阳在上焦。无阴则不能化也。"}]},{"ID":"20240613093824-v9azyw1","Type":"NodeParagraph","Properties":{"id":"20240613093824-v9azyw1","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"缪氏曰。痈疽已溃。不宜同苦寒药服。"}]},{"ID":"20240613093824-78xg82c","Type":"NodeParagraph","Properties":{"id":"20240613093824-78xg82c","updated":"20240613093824"},"Children":[{"Type":"NodeText","Data":"〔修治〕水洗。入丸。可磨汁作糊。"}]},{"ID":"20240613093705-45wsyq5","Type":"NodeThematicBreak","Properties":{"id":"20240613093705-45wsyq5"}},{"ID":"20240613093706-8k4tvhl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093706-8k4tvhl","updated":"20240613093715"},"Children":[{"Type":"NodeText","Data":"白芨《中药学》"}]},{"ID":"20240613093706-xf35uib","Type":"NodeParagraph","Properties":{"id":"20240613093706-xf35uib","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【药用】本品为兰科植物白芨的块茎。"}]},{"ID":"20240613093706-uvlruv2","Type":"NodeParagraph","Properties":{"id":"20240613093706-uvlruv2","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、甘、涩，微寒。入肝、肺、胃经。"}]},{"ID":"20240613093706-pxd8a0u","Type":"NodeParagraph","Properties":{"id":"20240613093706-pxd8a0u","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【功效】收敛止血，消肿生肌。"}]},{"ID":"20240613093706-qg25pvg","Type":"NodeParagraph","Properties":{"id":"20240613093706-qg25pvg","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于咯血、呕血、衄血、外伤出血等症。"}]},{"ID":"20240613093706-48hb9jd","Type":"NodeParagraph","Properties":{"id":"20240613093706-48hb9jd","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"白芨收敛，功能止血，是一味止血药。者要用于肺、胃出血病症，可单独应用，也可配阿胶（蛤粉炒）、藕节、生地等治咯血；配乌贼骨等治呕血。"}]},{"ID":"20240613093706-j1nqz56","Type":"NodeParagraph","Properties":{"id":"20240613093706-j1nqz56","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"2.用于疮疡肿痛，溃疡久不收口，手足皲裂等症。"}]},{"ID":"20240613093706-7co3zdy","Type":"NodeParagraph","Properties":{"id":"20240613093706-7co3zdy","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"白芨又有消肿生肌之功，用治疮疡，不论已溃未溃均可应用，如疮疡初起未溃，配银花、贝母、天花粉、乳香等有消散作用；如疮疡已溃、久不收口以及手足皲裂，有可奏生肌敛疮之功，往往研粉外用。"}]},{"ID":"20240613093706-zvn5hg3","Type":"NodeParagraph","Properties":{"id":"20240613093706-zvn5hg3","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"此外，本品还可用于尘肺、肺痈、肺结核等病。"}]},{"ID":"20240613093706-9t3vgch","Type":"NodeParagraph","Properties":{"id":"20240613093706-9t3vgch","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【处方用名】白及、白芨（洗净，晒干，切片用）、白芨粉（研粉，吞服，开水调服或外用）"}]},{"ID":"20240613093706-uiu09wn","Type":"NodeParagraph","Properties":{"id":"20240613093706-uiu09wn","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱～三钱，煎服。研粉吞服或冲服每次2～3克。外用适量。"}]},{"ID":"20240613093706-vwshyi3","Type":"NodeParagraph","Properties":{"id":"20240613093706-vwshyi3","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【按语】白芨苦甘微寒，功能止血，能入肺胃，为吐衄咯血之要药。又能用治疮疡，未成者能予消散。已溃者可用于敛疮生肌。此外，创伤出血，皮肤皲裂，用以外治亦颇有良效。唯邪热炽盛时，亦未宜乱投也。据报导，本品治疗肺结核病，与异烟？？同用，有协同作用；对空洞性肺结核久不愈合，也可应用。"}]},{"ID":"20240613093706-7ml5til","Type":"NodeParagraph","Properties":{"id":"20240613093706-7ml5til","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"【方剂举例】白芨枇杷丸（《戴氏方》）白芨、枇杷叶、阿胶（蛤粉炒）、藕节、生地汁。治咳血吐血。"}]},{"ID":"20240613093706-adf0bgh","Type":"NodeParagraph","Properties":{"id":"20240613093706-adf0bgh","updated":"20240613093706"},"Children":[{"Type":"NodeText","Data":"止血汤（《中医方剂临床手册》上海中医学院编）白芨、仙鹤草、地榆炭、生槐花。治上消化道出血症。"}]},{"ID":"20240613093647-jfb04ao","Type":"NodeThematicBreak","Properties":{"id":"20240613093647-jfb04ao"}},{"ID":"20240613093723-nzm5gdh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093723-nzm5gdh","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：白及"}]},{"ID":"20240613093723-dohlgtq","Type":"NodeParagraph","Properties":{"id":"20240613093723-dohlgtq","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613093723-27ea9vr","Type":"NodeParagraph","Properties":{"id":"20240613093723-27ea9vr","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" Bái Jí"}]},{"ID":"20240613093723-06j923g","Type":"NodeParagraph","Properties":{"id":"20240613093723-06j923g","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613093723-tysq6da","Type":"NodeParagraph","Properties":{"id":"20240613093723-tysq6da","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 白根、地螺丝、白鸡儿、白鸡娃、连及草、羊角七"}]},{"ID":"20240613093723-f511z0t","Type":"NodeParagraph","Properties":{"id":"20240613093723-f511z0t","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613093723-64yhi9v","Type":"NodeParagraph","Properties":{"id":"20240613093723-64yhi9v","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" RHIZOMA BLETILLAE"}]},{"ID":"20240613093723-5l1s2g4","Type":"NodeParagraph","Properties":{"id":"20240613093723-5l1s2g4","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613093723-vhnjzww","Type":"NodeParagraph","Properties":{"id":"20240613093723-vhnjzww","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 本品为兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白及"},{"Type":"NodeText","Data":"Bletilla striata（Thunb.） Reichb. f.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。夏、秋二季采挖，除去须根，洗净，置沸水中煮或蒸至无白心，晒至半干，除去外皮，晒干。"}]},{"ID":"20240613093723-096r5tg","Type":"NodeParagraph","Properties":{"id":"20240613093723-096r5tg","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613093723-jxyjz66","Type":"NodeParagraph","Properties":{"id":"20240613093723-jxyjz66","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 本品呈不规则扁圆形，多有2～3个爪状分枝，长1.5～5cm，厚0.5～1.5cm。表面灰白色或黄白色，有数圈同心环节和棕色点状须根痕，上面有凸起的茎痕，下面有连接另一块茎的痕迹。质坚硬，不易折断，断面类白色，角质样。无臭，味苦，嚼之有黏性。"}]},{"ID":"20240613093723-qekxwpy","Type":"NodeParagraph","Properties":{"id":"20240613093723-qekxwpy","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613093723-nplr5ue","Type":"NodeParagraph","Properties":{"id":"20240613093723-nplr5ue","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 洗净，润透，切薄片，晒干。"}]},{"ID":"20240613093723-s0f5exr","Type":"NodeParagraph","Properties":{"id":"20240613093723-s0f5exr","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613093723-0vbsp7i","Type":"NodeParagraph","Properties":{"id":"20240613093723-0vbsp7i","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 本品粉末淡黄白色。表皮细胞表面观垂周壁波状弯曲，略增厚，木化，孔沟明显。草酸钙针晶束存在于大的类圆形黏液细胞中，或随处散在，针晶长 18 ～88μm。纤维成束，直径11～30μm，壁木化，具人字形或椭圆形纹孔。梯纹、具缘纹孔及螺纹导管直径10～32μm。糊化淀粉粒团块无色。"}]},{"ID":"20240613093723-4gs58oc","Type":"NodeParagraph","Properties":{"id":"20240613093723-4gs58oc","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613093723-4439w9d","Type":"NodeParagraph","Properties":{"id":"20240613093723-4439w9d","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 归肺、肝、胃经。"}]},{"ID":"20240613093723-0q4mtet","Type":"NodeParagraph","Properties":{"id":"20240613093723-0q4mtet","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613093723-wei67ki","Type":"NodeParagraph","Properties":{"id":"20240613093723-wei67ki","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 苦、甘、涩，微寒。"}]},{"ID":"20240613093723-aig3dkn","Type":"NodeParagraph","Properties":{"id":"20240613093723-aig3dkn","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613093723-itb2pk2","Type":"NodeParagraph","Properties":{"id":"20240613093723-itb2pk2","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 不宜与乌头类药材同用。"}]},{"ID":"20240613093723-9dfrgs4","Type":"NodeParagraph","Properties":{"id":"20240613093723-9dfrgs4","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613093723-847u018","Type":"NodeParagraph","Properties":{"id":"20240613093723-847u018","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 收敛止血，消肿生肌。用于咳血吐血，外伤出血，疮疡肿毒，皮肤皲裂；肺结核咳血，溃疡病出血。"}]},{"ID":"20240613093723-65u841v","Type":"NodeParagraph","Properties":{"id":"20240613093723-65u841v","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613093723-zsugru3","Type":"NodeParagraph","Properties":{"id":"20240613093723-zsugru3","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 6～15g，研粉吞服3～6g。外用适量。"}]},{"ID":"20240613093723-w664gco","Type":"NodeParagraph","Properties":{"id":"20240613093723-w664gco","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613093723-7wswnjc","Type":"NodeParagraph","Properties":{"id":"20240613093723-7wswnjc","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613093723-70hyxgn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093723-70hyxgn","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白及"}]},{"ID":"20240613093723-5utu6x2","Type":"NodeParagraph","Properties":{"id":"20240613093723-5utu6x2","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613093723-sky7fia","Type":"NodeParagraph","Properties":{"id":"20240613093723-sky7fia","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" Bái Jí"}]},{"ID":"20240613093723-ts7n48g","Type":"NodeParagraph","Properties":{"id":"20240613093723-ts7n48g","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613093723-pq8lhrz","Type":"NodeParagraph","Properties":{"id":"20240613093723-pq8lhrz","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 甘根（《本经》），白根（《吴普本草》），白给（《别录》），白芨（《证治准绳》），冰球子（《贵州民间方药集》），白乌儿头（《江苏植药志》），地螺丝、羊角七（《湖南药物志》），千年棕、君球子、一兜棕、白鸡儿，皲口药、利知子（江西《草药手册》）。"}]},{"ID":"20240613093723-pcjbnqn","Type":"NodeParagraph","Properties":{"id":"20240613093723-pcjbnqn","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613093723-ejcdg91","Type":"NodeParagraph","Properties":{"id":"20240613093723-ejcdg91","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613093723-22ywmp3","Type":"NodeParagraph","Properties":{"id":"20240613093723-22ywmp3","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613093723-c5809bt","Type":"NodeParagraph","Properties":{"id":"20240613093723-c5809bt","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 为兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白及"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。8～11月采挖，除去残茎、须根，洗净泥土，经蒸煮至内面无白心，然后撞去粗皮，再晒干或烘干。"}]},{"ID":"20240613093723-pn0g538","Type":"NodeParagraph","Properties":{"id":"20240613093723-pn0g538","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613093723-stzk6re","Type":"NodeParagraph","Properties":{"id":"20240613093723-stzk6re","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 生长于山野川谷较潮湿处。分布河南、陕西、甘肃、山东、安徽、江苏、浙江、福建、广东、广西、江西、湖南、湖北、四川、贵州、云南等地。"}]},{"ID":"20240613093723-7hjt9bu","Type":"NodeParagraph","Properties":{"id":"20240613093723-7hjt9bu","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613093723-w9ofw5k","Type":"NodeParagraph","Properties":{"id":"20240613093723-w9ofw5k","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 白及，又名：连及草（《本经》），箬兰、朱兰（《花镜》），紫兰、紫蕙、百笠。多年生草本，高30～70厘米。块茎肥厚肉质，为连接的三角状卵形厚块，略扁平，黄白色；须根灰白色，纤细。叶3～5片，披针形或广披针形，长15～30厘米，宽2～6厘米，先端渐尖，基部下延成长鞘状，全缘。总状花序顶生，花3～8朵，疏生；苞片披针形，长1.5～2.5／厘米；花淡紫红色或黄白色，花被片狭椭圆形，先端尖，唇瓣倒卵形，内面有5条隆起的纵线，上部3裂，中央裂片矩圆形；雄蕊与雌蕊结合为蕊柱，两侧有狭翅，柱头顶端着生1雄蕊，花粉块4对，扁而长，蜡质；子房下位，圆柱状，扭曲。蒴果圆柱形，长3.5厘米，直径1厘米，两端稍尖狭，具6纵肋，顶端常具花瓣枯萎后留下的痕迹；花期4～5月。果期7～9月。"}]},{"ID":"20240613093723-iyznabj","Type":"NodeParagraph","Properties":{"id":"20240613093723-iyznabj","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613093723-k0s9z33","Type":"NodeParagraph","Properties":{"id":"20240613093723-k0s9z33","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 干燥块茎略呈掌状扁平，有2～3个分歧，长1.5～4.5厘米，厚约0.5厘米。表面黄白色，有细皱纹，上面有凸起的茎痕，下面亦有连接另一块茎的痕迹，以茎痕为中心，周围有棕褐色同心环纹，其上有细根残痕。质坚硬，不易折断。横切面呈半透明角质状，并有分散的维管束点。气无，味淡而微苦，并有粘液性。以根茎肥厚，色白明亮，个大坚实，无须根者为佳。主产贵州、四川、湖南、湖北、河南、浙江、陕西等地；此外，安徽、云南、江西、甘肃、江苏、广西等地亦产。"}]},{"ID":"20240613093723-8qnvgnp","Type":"NodeParagraph","Properties":{"id":"20240613093723-8qnvgnp","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613093723-35w3bh8","Type":"NodeParagraph","Properties":{"id":"20240613093723-35w3bh8","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 新鲜块茎含水分14.6％、淀粉30.48％，葡萄糖1.5％。又含挥发油、粘液质。根含白及甘露聚糖，是由4份甘露糖和1份葡萄糖组成的葡配甘露聚糖。"}]},{"ID":"20240613093723-lrge2m1","Type":"NodeParagraph","Properties":{"id":"20240613093723-lrge2m1","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613093723-516a6bk","Type":"NodeParagraph","Properties":{"id":"20240613093723-516a6bk","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，用水浸泡，捞出，晾至湿度适宜，切片，干燥。"}]},{"ID":"20240613093723-p58v5u2","Type":"NodeParagraph","Properties":{"id":"20240613093723-p58v5u2","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613093723-18g4d8v","Type":"NodeParagraph","Properties":{"id":"20240613093723-18g4d8v","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 入肺经。"}]},{"ID":"20240613093723-hzexa1u","Type":"NodeParagraph","Properties":{"id":"20240613093723-hzexa1u","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入肺。\""}]},{"ID":"20240613093723-bd3himh","Type":"NodeParagraph","Properties":{"id":"20240613093723-bd3himh","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肺、肾二经。\""}]},{"ID":"20240613093723-8xuht4z","Type":"NodeParagraph","Properties":{"id":"20240613093723-8xuht4z","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613093723-83akh6z","Type":"NodeParagraph","Properties":{"id":"20240613093723-83akh6z","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 苦甘，凉。"}]},{"ID":"20240613093723-lwwlyrs","Type":"NodeParagraph","Properties":{"id":"20240613093723-lwwlyrs","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240613093723-4mkq9jx","Type":"NodeParagraph","Properties":{"id":"20240613093723-4mkq9jx","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、黄帝：辛。李氏：大寒。雷公：辛，无毒。\""}]},{"ID":"20240613093723-khupoao","Type":"NodeParagraph","Properties":{"id":"20240613093723-khupoao","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"辛，微寒，无毒。\""}]},{"ID":"20240613093723-xphdybx","Type":"NodeParagraph","Properties":{"id":"20240613093723-xphdybx","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"④李杲：\"苦甘，微寒，性涩。\""}]},{"ID":"20240613093723-z8h0j6g","Type":"NodeParagraph","Properties":{"id":"20240613093723-z8h0j6g","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613093723-hrbbxxb","Type":"NodeParagraph","Properties":{"id":"20240613093723-hrbbxxb","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 外感咳血，肺痈初起及肺胃有实热者忌服。"}]},{"ID":"20240613093723-eqi75ec","Type":"NodeParagraph","Properties":{"id":"20240613093723-eqi75ec","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"紫石英为之使。恶理石。畏李核，杏人。\""}]},{"ID":"20240613093723-x0jzgft","Type":"NodeParagraph","Properties":{"id":"20240613093723-x0jzgft","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②《蜀本草》：\"反乌头。\""}]},{"ID":"20240613093723-n9p481l","Type":"NodeParagraph","Properties":{"id":"20240613093723-n9p481l","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"痈疽已溃，不宜同苦寒药服。\""}]},{"ID":"20240613093723-cjidbgs","Type":"NodeParagraph","Properties":{"id":"20240613093723-cjidbgs","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613093723-ey8czly","Type":"NodeParagraph","Properties":{"id":"20240613093723-ey8czly","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 补肺，止血，消肿，生肌，敛疮。治肺伤咳血，衄血，金疮出血，痈疽肿毒，溃疡疼痛，汤火灼伤，手足皲裂。"}]},{"ID":"20240613093723-sa0d64g","Type":"NodeParagraph","Properties":{"id":"20240613093723-sa0d64g","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主痈肿恶疮败疽，伤阴死肌，胃中邪气，贼风痱缓不收。\""}]},{"ID":"20240613093723-vlq1ubz","Type":"NodeParagraph","Properties":{"id":"20240613093723-vlq1ubz","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除白癣疥虫。\""}]},{"ID":"20240613093723-96xoowi","Type":"NodeParagraph","Properties":{"id":"20240613093723-96xoowi","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治结热不消，主阴下痿，治面上皯疱，令人肌滑。\""}]},{"ID":"20240613093723-f5ke6sg","Type":"NodeParagraph","Properties":{"id":"20240613093723-f5ke6sg","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"手足皲拆，嚼以涂之。\""}]},{"ID":"20240613093723-wvl86j1","Type":"NodeParagraph","Properties":{"id":"20240613093723-wvl86j1","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"止惊邪、血邪，痢疾，赤眼，症结，发背，瘰疬，肠风，痔瘿，刀箭疮扑损，温热疟疾，血痢，汤火疮，生肌止痛，风痹。\""}]},{"ID":"20240613093723-ncu1z4x","Type":"NodeParagraph","Properties":{"id":"20240613093723-ncu1z4x","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑥《本草图经》：\"治金疮不瘥，痈疽方中多用之。\""}]},{"ID":"20240613093723-catcwbf","Type":"NodeParagraph","Properties":{"id":"20240613093723-catcwbf","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑦李杲：\"止肺血。\""}]},{"ID":"20240613093723-shd4r05","Type":"NodeParagraph","Properties":{"id":"20240613093723-shd4r05","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑧《滇南本草》：\"治痨伤肺气，补肺虚，止咳嗽，消肺痨咳血，收敛肺气。\""}]},{"ID":"20240613093723-uitrzfk","Type":"NodeParagraph","Properties":{"id":"20240613093723-uitrzfk","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑨《中国药植图鉴》：\"治矽肺。\""}]},{"ID":"20240613093723-0mgstb2","Type":"NodeParagraph","Properties":{"id":"20240613093723-0mgstb2","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613093723-l86psno","Type":"NodeParagraph","Properties":{"id":"20240613093723-l86psno","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。外用：研末撒或调涂。"}]},{"ID":"20240613093723-lc865zf","Type":"NodeParagraph","Properties":{"id":"20240613093723-lc865zf","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613093723-kvu61ua","Type":"NodeParagraph","Properties":{"id":"20240613093723-kvu61ua","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" ①治肺痿：白及、阿胶、款冬、紫苑等分。水煎服。（《医学启蒙》白及散）"}]},{"ID":"20240613093723-yz6ksml","Type":"NodeParagraph","Properties":{"id":"20240613093723-yz6ksml","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②治肺痿肺烂：猪肺一具，白及片一两，将猪肺挑去血筋血膜，洗净，同白及入瓦罐，加酒煮热，食肺饮汤，或稍用盐亦可。或将肺蘸白及末食更好。（《喉科心法》白及肺）"}]},{"ID":"20240613093723-a9zorrm","Type":"NodeParagraph","Properties":{"id":"20240613093723-a9zorrm","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"③治咯血：白及一两，枇杷叶（去毛，蜜炙）、藕节各五钱。上为细末，另以阿胶五钱，锉如豆大，蛤粉炒成珠，生地黄自然汁调之，火上炖化，入前药为丸如龙眼大。每服一丸，噙化。（《证治准绳》白及枇杷丸）"}]},{"ID":"20240613093723-g21f0z0","Type":"NodeParagraph","Properties":{"id":"20240613093723-g21f0z0","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"④治肺热吐血不止：白及研细末，每服二钱，白汤下。（《本草发明》）"}]},{"ID":"20240613093723-ynosxdv","Type":"NodeParagraph","Properties":{"id":"20240613093723-ynosxdv","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑤治疔疮肿毒：白及末半钱，以水澄之，去水，摊于厚纸上贴之。（《袖珍方》）"}]},{"ID":"20240613093723-pdwixaa","Type":"NodeParagraph","Properties":{"id":"20240613093723-pdwixaa","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑥治一切疮疖痈疽：白及、芙蓉叶、大黄、黄柏，五倍子。上为末，用水调搽四周。（《保婴撮要》铁箍散）"}]},{"ID":"20240613093723-qfk8oa0","Type":"NodeParagraph","Properties":{"id":"20240613093723-qfk8oa0","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑦治发背搭手：白及五钱（炙，末），广胶一两（烊化）。和匀，敷患处，空一头出气，以白蛰皮贴之。（《卫生鸿宝》白及膏）"}]},{"ID":"20240613093723-l2srggm","Type":"NodeParagraph","Properties":{"id":"20240613093723-l2srggm","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑧治瘰疬脓汁不干：白及、贝母、净黄连各半两，轻粉三十贴。前三味，锉焙为末，仍以轻粉乳钵内同杵匀，抄一钱至二钱，滴油调擦患处，用时先以槲皮散煮水侯温，洗净拭干，方涂药。（《活幼心书》白及散）"}]},{"ID":"20240613093723-5dwm31n","Type":"NodeParagraph","Properties":{"id":"20240613093723-5dwm31n","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑨治跌打骨折：酒调白芨末二钱服。（《永类铃方》）"}]},{"ID":"20240613093723-59dpebk","Type":"NodeParagraph","Properties":{"id":"20240613093723-59dpebk","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑩治刀斧损伤肌肉，出血不止：白及，研细末掺之。（《本草汇言》）"}]},{"ID":"20240613093723-5jwqa5j","Type":"NodeParagraph","Properties":{"id":"20240613093723-5jwqa5j","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑾治汤火伤灼：白及末，抽调敷。（《济急仙方》）"}]},{"ID":"20240613093723-98tfrmk","Type":"NodeParagraph","Properties":{"id":"20240613093723-98tfrmk","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑿治手足皲裂：白及末，水凋塞之，勿犯水。（《济急仙方》）"}]},{"ID":"20240613093723-ab1hhko","Type":"NodeParagraph","Properties":{"id":"20240613093723-ab1hhko","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒀治妇人子藏挺出：乌头（炮）、白及各四分。上二味捣散，取方寸匕，以绵裹内阴中，令入三寸，腹内热即止。日一度著，明晨仍须更著，以止为度。（《广济方》）"}]},{"ID":"20240613093723-ypq0yfv","Type":"NodeParagraph","Properties":{"id":"20240613093723-ypq0yfv","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒁治鼻渊：白及，末，酒糊丸。每服三钱，黄酉下，半月愈。（《外科大成》白及丸）"}]},{"ID":"20240613093723-teuiruv","Type":"NodeParagraph","Properties":{"id":"20240613093723-teuiruv","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒂治产后伤脬，小便淋敷不止：白及、凤凰庆，桑螺娟等分，入猪脬内，煮烂食之。（《梅氏验方新编》）"}]},{"ID":"20240613093723-y3id4qn","Type":"NodeParagraph","Properties":{"id":"20240613093723-y3id4qn","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒃治心气疼痛：白及、石榴皮各一钱。为末，炼蜜丸黄豆大，每服三丸，艾醋汤下。（《生生编》）"}]},{"ID":"20240613093723-3stoewn","Type":"NodeParagraph","Properties":{"id":"20240613093723-3stoewn","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒄鼻血不止。用口水调白及末涂鼻粱上低处（名\"山根\"）；另取白及末一钱，水冲服。"}]},{"ID":"20240613093723-ve9g8w7","Type":"NodeParagraph","Properties":{"id":"20240613093723-ve9g8w7","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒅心气疼痛。用白及、石榴皮各二钱，研细，加炼蜜和成丸子，如黄豆大。每服三丸，艾醋汤送下。"}]},{"ID":"20240613093723-op2pplg","Type":"NodeParagraph","Properties":{"id":"20240613093723-op2pplg","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒆妇女阴脱。用白及、川乌药，等分为末，薄布包一钱，纳入阴道中，觉胜利内热即止。每天用一次。"}]},{"ID":"20240613093723-ooqjscl","Type":"NodeParagraph","Properties":{"id":"20240613093723-ooqjscl","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⒇疔疮、肿疮。用白及末半钱，澄水中，等水清后，去水，以药摊厚纸上贴于患处。"}]},{"ID":"20240613093723-dymm5dv","Type":"NodeParagraph","Properties":{"id":"20240613093723-dymm5dv","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"（21）跌打骨折。用白及末二钱，酒调服。"}]},{"ID":"20240613093723-d8mvk6e","Type":"NodeParagraph","Properties":{"id":"20240613093723-d8mvk6e","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"（22）刀伤。用白及、煅石膏，等分为末，洒伤口上。"}]},{"ID":"20240613093723-3go4hvg","Type":"NodeParagraph","Properties":{"id":"20240613093723-3go4hvg","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"（23）冬季手足皲裂。用白及粉加水调匀，填入裂口。患处不能沾水。"}]},{"ID":"20240613093723-nolvl9p","Type":"NodeParagraph","Properties":{"id":"20240613093723-nolvl9p","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"（24）汤火全国各地。用白及粉调油涂搽。"}]},{"ID":"20240613093723-eqlos0b","Type":"NodeParagraph","Properties":{"id":"20240613093723-eqlos0b","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"（25）重伤呕血。每日服白及末，米汤送下。"}]},{"ID":"20240613093723-hemg86e","Type":"NodeParagraph","Properties":{"id":"20240613093723-hemg86e","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"（26）肺、胃出血。治法同上。"}]},{"ID":"20240613093723-ggn98g5","Type":"NodeParagraph","Properties":{"id":"20240613093723-ggn98g5","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613093723-a5esoer","Type":"NodeParagraph","Properties":{"id":"20240613093723-a5esoer","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" ①治疗肺结核"}]},{"ID":"20240613093723-plthx2f","Type":"NodeParagraph","Properties":{"id":"20240613093723-plthx2f","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"经抗痨药治疗无效或疗效缓慢的各型肺结核，加用白及后能收到较好效果。据观察：60例久治不愈患者，用药3个月后，42例临床治愈，X线显示病灶完全吸收或纤维化，空洞闭合，血沉正常，痰菌阴性，临床症状消失；13例显着进步，2例无改变。又40例有空洞的浸润型及厚壁空洞患者，服药后空洞闭合者24例，明显缩小者12例，病灶吸收好转者16例。有人认为，白及疗法以对于酪性病变为主的浸润型肺结核疗效较好；在症状方面以对咳嗽、咳血等治疗效果比较明显。用法：研粉内服。成人每日6～30克，一般用12～18克。3次分服。可连服数月，最多有服至2年的。此外，以白及粉3钱，每日3次分服，用于肺结核咯血13例，大都于1～3日内收到止血效果。"}]},{"ID":"20240613093723-3ig8oim","Type":"NodeParagraph","Properties":{"id":"20240613093723-3ig8oim","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②治疗百日咳"}]},{"ID":"20240613093723-4ih5es4","Type":"NodeParagraph","Properties":{"id":"20240613093723-4ih5es4","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"白及粉内服，剂量为1岁以内0.1～0.15克／公斤体重，1岁以上0.2～0.25克/公斤体重。治疗89例，结果37例服药5天内症状显著减轻，15例于10天内显著减轻，6例无效，31例中断治疗。"}]},{"ID":"20240613093723-3opzzs1","Type":"NodeParagraph","Properties":{"id":"20240613093723-3opzzs1","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"③治疗枝气管扩张"}]},{"ID":"20240613093723-p4ab741","Type":"NodeParagraph","Properties":{"id":"20240613093723-p4ab741","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"成人每次服白及粉2～4克，每日3次，3个月为一疗程。21例患者经1～2疗程，痰量显著减少，咳嗽减轻，咯血得到控制。"}]},{"ID":"20240613093723-i80v79a","Type":"NodeParagraph","Properties":{"id":"20240613093723-i80v79a","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"④治疗矽肺"}]},{"ID":"20240613093723-524wqw1","Type":"NodeParagraph","Properties":{"id":"20240613093723-524wqw1","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"每次服白及片5片（每片含原药1分），每日3次。44例单纯型患者，服药3个月至1年后，胸痛、气急、咳嗽、吐黑痰、咯血等症状均显著减轻或消失，体重增加，肺功能改善，血液浓枸橼酸钠反应有所进步。但X线改变不太显著。"}]},{"ID":"20240613093723-ex4jk53","Type":"NodeParagraph","Properties":{"id":"20240613093723-ex4jk53","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑤治疗胃、十二指肠溃疡出血"}]},{"ID":"20240613093723-19et2df","Type":"NodeParagraph","Properties":{"id":"20240613093723-19et2df","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"成人服白及粉每次1～2钱，每日3～4次。观察69例，大便转黄和潜血转阴平均时间分别为5.17天和6.5天，平均住院19.7天。治疗中曾以白及内服加紫珠草注射进行观察，但疗效宋见显著提高。"}]},{"ID":"20240613093723-h2tsnlb","Type":"NodeParagraph","Properties":{"id":"20240613093723-h2tsnlb","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑥治疗胃、十二指肠溃疡急性穿孔"}]},{"ID":"20240613093723-4z2f7wm","Type":"NodeParagraph","Properties":{"id":"20240613093723-4z2f7wm","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"在严格规定的指征下，白及疗法可能使某些患者免去手术；获得穿孔治愈的效果。据29例观察，成功者23例，失败改行手术治疗者1例，发生膈下脓肿及十二指肠瘘者1例，死亡4例（1例是在白及治疗过程中发生休克，改行手术后死亡。3例入院时已呈垂危状态）。适应白及疗法的理想病例是一般所谓急性溃疡穿孔，或穿孔前溃疡症状不严重，属于缝合术指征范围以内的；如病变已呈局限化的病例，则更为合适，白及疗法的反指征是：㈠胃、十二指肠溃疡穿孔诊断不够肯定者；㈡饱食穿孔者；㈢保守疗法即使获得成功，但仍须作延期手术者；㈣体检时已有明显腹胀、低位浊音，肛检有明显触痛或有肿块触及，估计腹腔内液体较多者；㈤患者一般情况已呈轻度不良者。治疗方法：先以胃管抽尽胃内容物，然后拔去胃管，用冷开水快速吞服白及粉3钱，冷开水量以不超过90毫升为宜。1小时后再重复以上剂量1次。第二天开始，白及剂量改为1钱，每日3次。第1天应绝对禁食，第2天可少量饮水或给流质；第3天开始可恢复半流质饮食。治疗过程中，抗休克、补液、输血及抗菌素的使用等与一股常规处理同，同时必须强调严格观察全身和局部症状的演变。如有全身情况恶化，如脉率增速、腹膜炎症状扩展或低位浊音程度增加等现象，应当机立断，立即改变治疗方针，采取手术治疗。实践中观察到，白及具有高度的粘性，可能在胃内形成具有一定厚度的胶状膜，从而使穿孔堵塞，胃内容物停止外溢。治疗成功的病例，疼痛在1～5小时内开始显著改善，12～24小时内可完全消失，腹肌紧张及压痛亦随之改善。但亦有报道指出：服用白及后增加胃内容，促进了胃的蠕动，妨碍了大网膜的包绕和肝的覆盖，甚至有使包绕的网膜再度脱落的流弊；服用白及时的吞咽动作和恶心、呃逆足以增加腹内压，可使穿孔扩大和再穿孔；服用白及若不成功，白及糊流入腹腔，因其具有粘性，给手术清理腹腔带来困难，甚至促成术后肠粘连，故认为白及疗法并不理想。"}]},{"ID":"20240613093723-sjycf5v","Type":"NodeParagraph","Properties":{"id":"20240613093723-sjycf5v","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑦治疗结接性瘘管"}]},{"ID":"20240613093723-xk3nkkw","Type":"NodeParagraph","Properties":{"id":"20240613093723-xk3nkkw","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"用白及粉局部外敷，根据分泌物多少每日敷药1次或隔日1次，分泌物减少后可改为每周1次或2次。通常敷药15次左右即渐趋愈合。药粉须送入瘘管深部并塞满，如瘘管口狭小可先行扩创，清除腐败物。10例肺结核并发结核性瘘管患者，经敷药12～30次左右均治愈。其愈合后的瘢痕无特别隆起，且未见复发。实践证明，白及外敷，具有吸收与排出局部分泌物，恢复和增强机能，促进肉芽组织新生，清洁伤口，加速愈合等作用"}]},{"ID":"20240613093723-f7lw7q5","Type":"NodeParagraph","Properties":{"id":"20240613093723-f7lw7q5","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑧治疗烧伤及外科创伤"}]},{"ID":"20240613093723-twwu7uh","Type":"NodeParagraph","Properties":{"id":"20240613093723-twwu7uh","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"取新鲜白及削去表皮，用灭菌生理盐水洗净，按1：10比例加入无菌蒸馏水，冷浸1夜，至次日加热至沸，以经灭菌处理的4号玻璃漏斗减压过滤。滤液分装于安瓿或玻瓶内，熔封。15磅高压蒸气灭菌30分钟，即成为白及胶浆。凡占体表面积约20％以内的局部外伤或第一、二度烧伤，均可应用白及胶浆涂敷治疗。涂药前，先以生理盐水作创面清理；涂药后用凡士林纱布覆盖，包扎固定。如无严重感染，可在5～7日后换敷。对感染创面需隔日换药1次。9例烧伤患儿（平均伤面为8％），2例阑尾手术切口及38例外伤患者（伤面平均为11％），均经1～3次治愈。白及胶浆用于一般外科创伤及烧伤，其治疗作用可能是：㈠通过神经反射机制而增强机体的防卫能力，刺激肉芽组织增生；㈡对葡萄球菌及链球菌具有抑菌作用，且可在局部形成一保护膜，能控制及防止感染；㈢可缩短血凝时间，减少出血，从而有利于创面的愈合。"}]},{"ID":"20240613093723-dfcanse","Type":"NodeParagraph","Properties":{"id":"20240613093723-dfcanse","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑨治疗肛裂"}]},{"ID":"20240613093723-fvpfqej","Type":"NodeParagraph","Properties":{"id":"20240613093723-fvpfqej","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"取白及粉用蒸馏水配成7～12％的液体。待溶解后稍加温，静置8小时，过滤，成为黄白色胶浆。每100毫升胶浆再加入石膏粉100克，搅匀，高压消毒，便成白及膏。用药前先以温水或淡高锰酸钾液行肛门坐浴，然后用无齿镊挟白及膏棉球从肛门插入约2厘米，来回涂擦2～4次，取出。再用一个白及膏棉球留置于肛门内2～3厘米处，另取一个白及膏棉球放在肛裂创面，将涂有白及膏之纱布块敷于肛门，胶布固定。每天换药1次，全疗程10～15日。如第1次治疗不能往内塞药时，可先用多量白及膏敷于肛门部；第2日肛门括约肌松弛，棉球便可顺利塞入并来回涂擦。治疗11例，经3个月观察无1例失败。9例于第1次换药后便血消失，2例括约肌痉挛，经敷药1次后括约肌松弛，能顺利塞药，第2次换药便血即止。敷药后，第1～2次大便时全部无痛或疼痛减轻；6～10日肉眼观察创面全部愈合。认为获效原因，主要是由于敷药后能很快使肛门括约肌松弛及止痛止血，同时白及膏有润滑、保护创面、促进生肌的作用。"}]},{"ID":"20240613093723-syqowi9","Type":"NodeParagraph","Properties":{"id":"20240613093723-syqowi9","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑩其他"}]},{"ID":"20240613093723-p44nqjy","Type":"NodeParagraph","Properties":{"id":"20240613093723-p44nqjy","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"用白及制成的止血粉，对某些手术的皮肤、肌层切口的小血管出血和渗血有较好的止血效果，对拔牙后的止血效果更佳；但对切断中小静、动脉的止血效果不够满意。应用白及粉治疗血吸虫病晚期的食管、胃静脉曲张出血，溃疡性结肠炎出血，出血性紫癜，以及口腔粘膜结核性溃疡，均有一定疗效。又据报道，以白及粘胶质部分制成白及代血浆，经动物实验对失血性休克具有一定疗效，与右旋糖酐有相类似的作用；临床试用有维持血容量及提高血压的效果。未发现抗原性，亦无明显副作用，无热原反应，对肝肾功能、血象、出血时间、凝血时间均无影响。试用时，有3人曾发生一过性的轻度发热（37.5℃以下），另有1人于第5次注射时曾发生过敏反应。上述情况可能与制剂不纯有关。"}]},{"ID":"20240613093723-34wo3h0","Type":"NodeParagraph","Properties":{"id":"20240613093723-34wo3h0","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613093723-vgoidtj","Type":"NodeParagraph","Properties":{"id":"20240613093723-vgoidtj","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613093723-aut7v2r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613093723-aut7v2r","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"《中华本草》：白及"}]},{"ID":"20240613093723-j7sgcok","Type":"NodeParagraph","Properties":{"id":"20240613093723-j7sgcok","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613093723-pg3c88d","Type":"NodeParagraph","Properties":{"id":"20240613093723-pg3c88d","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" Bái Jí"}]},{"ID":"20240613093723-437io6m","Type":"NodeParagraph","Properties":{"id":"20240613093723-437io6m","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613093723-ctjsk9c","Type":"NodeParagraph","Properties":{"id":"20240613093723-ctjsk9c","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 甘根、连及草、臼根、白给、冰球子、白鸟儿头、地螺丝、羊角七、千年棕、君求子、一兜棕、白鸡儿、皲口药、利知子"}]},{"ID":"20240613093723-c4prj0j","Type":"NodeParagraph","Properties":{"id":"20240613093723-c4prj0j","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613093723-6mvbd85","Type":"NodeParagraph","Properties":{"id":"20240613093723-6mvbd85","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" Common Bletilla Pseudobulb, Tuber of Common Bletilla , Tuber of Hyacinth Bletilla"}]},{"ID":"20240613093723-2ih90rf","Type":"NodeParagraph","Properties":{"id":"20240613093723-2ih90rf","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613093723-kpz701b","Type":"NodeParagraph","Properties":{"id":"20240613093723-kpz701b","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 出自1.《本经》。"}]},{"ID":"20240613093723-3plj14k","Type":"NodeParagraph","Properties":{"id":"20240613093723-3plj14k","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：《图经》云，白及叶似初生栟榈及藜芦；茎端生一薹，四月开生紫花；七月实熟，黄黑色，冬雕；根似菱，三角，白色，角头生芽。今出申州。二月、八月采根用。"}]},{"ID":"20240613093723-z861rll","Type":"NodeParagraph","Properties":{"id":"20240613093723-z861rll","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：白敛、白及，古今服饵方少有用者，多见于敛疮方中，二物多相须而行。"}]},{"ID":"20240613093723-ycm24oi","Type":"NodeParagraph","Properties":{"id":"20240613093723-ycm24oi","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：《别录》有名未用白给，即白及也，性味功用皆同。"}]},{"ID":"20240613093723-cnwgpak","Type":"NodeParagraph","Properties":{"id":"20240613093723-cnwgpak","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613093723-8b5pa7y","Type":"NodeParagraph","Properties":{"id":"20240613093723-8b5pa7y","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 药材基源：为兰科植物白及的根茎。"}]},{"ID":"20240613093723-e08libd","Type":"NodeParagraph","Properties":{"id":"20240613093723-e08libd","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Bletilla striata (Thunb.) Reichb. F.[Limodorum striata Thunb.]"}]},{"ID":"20240613093723-kqrergr","Type":"NodeParagraph","Properties":{"id":"20240613093723-kqrergr","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种3-4年后的9-10月采挖，将根茎浸水中约1h左右，洗净泥土，除支须根，经蒸煮至内面无白心时取出，晒或炕至表面干硬不粘结时，用硫黄熏1夜后，晒干或炕干，然后撞去残须，使表面成光洁淡黄白色，筛去杂质。"}]},{"ID":"20240613093723-rw3yb6s","Type":"NodeParagraph","Properties":{"id":"20240613093723-rw3yb6s","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613093723-ult8j27","Type":"NodeParagraph","Properties":{"id":"20240613093723-ult8j27","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山野、山谷较潮湿处。"}]},{"ID":"20240613093723-cpiylrd","Type":"NodeParagraph","Properties":{"id":"20240613093723-cpiylrd","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"资源分布：分布华东、中南、西南及河北、山西、陕西、甘肃、台湾等地。"}]},{"ID":"20240613093723-r9qlaq4","Type":"NodeParagraph","Properties":{"id":"20240613093723-r9qlaq4","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613093723-lk5swxk","Type":"NodeParagraph","Properties":{"id":"20240613093723-lk5swxk","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 白及，多年生草本，高15-70cm。根茎（或称假鳞茎）三角状扁球形或不规则菱形，肉质，肥厚，富粘性，常数个相连。茎直立。叶片3-5，披针形或宽披针形，长8-30cm，宽1.5-4cm，先端渐尖，基部下延成长鞘状，全缘。总状花序顶生，花3-8朵，花序轴长4-12cm；苞片披针形，长1.5-2.5cm，早落；花紫色或淡红色，直径3-4cm；萼片和花瓣等长，狭长圆形，长2.8-3cm；唇瓣倒卵形，长2.3-2.8cm，白色或具紫纹，上部3裂，中裂片边缘有波状齿，先端内凹，中央具5条褶片，侧裂片直立，合抱蕊柱，稍伸向中裂片，但不及中裂片的一半；雄蕊与雌蕊合为蕊柱，两侧有狭翅，柱头顶端着生1雄蕊，花药块4对，扁而长；子房下位，圆柱状，扭曲。蒴果圆柱形，长3.5cm，直径约1cm，两端稍尖，具6纵肋。花期4-5月。果期7-9月。"}]},{"ID":"20240613093723-smk3ivr","Type":"NodeParagraph","Properties":{"id":"20240613093723-smk3ivr","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613093723-eawh7x0","Type":"NodeParagraph","Properties":{"id":"20240613093723-eawh7x0","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，不耐寒。宜选疏松、肥沃、排水良好而又较为阴湿的砂壤土、夹砂土和腐殖土栽培，不宜在排水不良、粘性重的土壤栽种。"}]},{"ID":"20240613093723-d3e2ycj","Type":"NodeParagraph","Properties":{"id":"20240613093723-d3e2ycj","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"栽培技术 用根茎繁殖。9-10月收获时，选当年生具有嫩芽的块茎及其与先年的老鳞茎毗连接生处切下，按行株距各33cm开穴，深10-13cm，每穴栽种3个，新芽向外，成三角形平放穴中。每1hm2用种茎22.5万个左右。栽后施猪粪水，并盖拦有猪粪水的草木灰或腐熟堆肥。北方于4月底至5月初，将先年贮藏带芽种茎切下，按行株距33cm×17cm开穴，每穴栽1个，覆土3-4cm，稍加镇压，浇水。"}]},{"ID":"20240613093723-eml29hp","Type":"NodeParagraph","Properties":{"id":"20240613093723-eml29hp","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"田间管理 中耕除草每年进行4次，第1次3-4月苗出齐后，第2次5-6月生长旺盛期，第3次8-9月，第4次冬季倒苗后。每年追肥3次，前2次在中耕除草后进行，以猪粪水最好，第3次8-9月，可用过磷酸钙与堆肥堆沤之后，撒在畦上，结合中耕，混入土中。现蕾时摘除花蕾。遇旱及时灌水。栽后第1、2年冬季，在行间可间种一季短期蔬菜。"}]},{"ID":"20240613093723-czuu9n4","Type":"NodeParagraph","Properties":{"id":"20240613093723-czuu9n4","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613093723-7sao9yq","Type":"NodeParagraph","Properties":{"id":"20240613093723-7sao9yq","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎略呈不规则扁圆形或菱形，有2-3分歧似掌状，长1.5-5cm，厚0.5-1.5cm。表面灰白色或黄白色，有细皱纹，上面有凸起的茎痕，下面亦有连接另一块茎的痕迹；以茎痕为中心，数个棕褐色同心环纹，环上残留棕色点状的须根痕。质坚硬，不易折断。断面类白色，半透明，角质样，可见散在点状维管束。粗粉遇水即膨胀，有显着粘滑感，水浸液呈胶质样。无臭，味苦，嚼之有粘性。以个大、饱满、色白、半透明、质坚实者为佳。"}]},{"ID":"20240613093723-euduckn","Type":"NodeParagraph","Properties":{"id":"20240613093723-euduckn","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：黄白色。"}]},{"ID":"20240613093723-rtx2gix","Type":"NodeParagraph","Properties":{"id":"20240613093723-rtx2gix","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"①含糊化淀粉粒的薄壁细胞多呈不规则碎块，遇碘液显蓝色。"}]},{"ID":"20240613093723-24ua18g","Type":"NodeParagraph","Properties":{"id":"20240613093723-24ua18g","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"②粘液细胞甚大，类圆形或椭圆形，直径约至380μm，内含草酸钙针晶束，针晶长18-88μm。"}]},{"ID":"20240613093723-9igxcxe","Type":"NodeParagraph","Properties":{"id":"20240613093723-9igxcxe","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"③表皮细胞表面观形状不规则，垂周壁深波状弯曲，壁厚3-6μm，木化或微木化，孔沟明显，平周壁具稀疏短缝状纹孔；断面观类方形，被较厚的角质层。"}]},{"ID":"20240613093723-0yqrvtm","Type":"NodeParagraph","Properties":{"id":"20240613093723-0yqrvtm","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"④下皮细胞类多角形，壁稍弯曲，有的呈连珠状增厚，木化。"}]},{"ID":"20240613093723-dyyvdd5","Type":"NodeParagraph","Properties":{"id":"20240613093723-dyyvdd5","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"⑤纤维长梭形，壁木化，具斜纹孔或相交成人字形；纤维束周围细小类方形细胞含类圆形硅质块。此外，有梯纹、具缘纹孔及螺纹导管。"}]},{"ID":"20240613093723-g9ugidm","Type":"NodeParagraph","Properties":{"id":"20240613093723-g9ugidm","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613093723-fce01lb","Type":"NodeParagraph","Properties":{"id":"20240613093723-fce01lb","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 块茎含联苄类化合物：3，3'-二羟基-2'，6'-双（对-羟苄基）-5-甲氧基联苄[3，3'-dihydroxy-2',6'-bid(p-hydroxybezyl)-5-methoxy bibenzyl]，2，6-双（对-羟苄基）-3'，5-二甲氧基-3-羟基联苄[2，6-bis(p-hydroxybenzyl)-3',5-dimethoxy-3-hydroxybibenzyl],3,3'-二羟基-5-甲氧基-2，5'，6-三（对-羟苄基）联苄[3，3'-dihydroxy-5-methoxy-2,5',6-tris(p-hydroxybenzyl)bibenzyl]3,3',5-甲氧基联苄（3，3',5-trimethoxybibenzyl）,3,5-二甲基联苄（3，5-dimethoxybibenzyl）；二氧菲类化合物：4，7-二羟基-1-对-羟苄基-2-甲氧基-9，10-二氢菲（4,7-dihydroxy-1-p-hydroxybenzyl-2-methoxy-9,10-dihydropenanthrene）,4,7-二羟基-2-甲氧基-9，10-二氢菲（4，7-dihydroxy-2-methoxy-9,10-dihydrophenanthrene），3-（对-羟苄基）-4-甲氧基-9，10-二氢菲-2，7-二醇[3-（p-hydroxybenzyl）-4-methoxy-9,10-dihydrophenanthrene-2,7-diol],1，6-双（对-羟苄基）-4-甲氧基-9，10-二氢菲-2，7-二醇[1,6-bis(p-hydroxybenzyl)-4-methoxy-9,10-dihydrophenanthrene-2,7-diol]，2，4，7-三甲氧基-9，10-二氢菲（2，4，7-trimethoxy-9,10-dihydrophenanthrene）；联菲类化合物：白及联菲（blestriarene）A、B、C，白及联菲醇（blestrianol）A、B、C；双菲醚类化合物：白及双菲醚（blestrin）A、B、CD；二氢菲并吡喃类化合物：白及二氢菲并吡喃酚（bletlol）A、B、C；具螺内酯的菲类衍生物：白及菲螺醇（blespirol）；菲类糖甙化合物：2，7-二羟基-4-甲氧基菲-2-O-葡萄糖甙（2,7-dihydroxy-4-methoxyphenanthrene-2-O-glucoside），2，7-二羟基-4-甲氧基菲-2，7-O-二葡萄糖甙（2,7-dihydroxy-4-methoxyphenanthrene-2,7-O-diglucoside），3，7-二羟基-2，4-二甲氧基菲-3-O-葡萄糖甙（3,7-dihycroxy-2,4-dimethoyxphenanthrene-3-O-glucoside），2，7-二羟基-1-（4'-羟苄基）-9，10-二氢菲-4-O-葡萄糖甙[2,7-dihydroxy-1-（4'-hydroxybenzyl）-9,10-dihydrophenanthrene-4-glucoside]；其他菲类化合物：1-对-羟苄基-4-甲氧基菲-2，7-二醇（1-p-hydroxybenzyl-4-methoxyphenanthrene-2,7-diol），1，8-双（对-羟苄基）-4-甲氧基菲-2，7-二醇[1，8-bis(p-hydroxybenzyl)-4-methoxyphenanthrene-2,7-diol]，2，4，7-三甲氧基菲（2，4，7-trimethoxyphenanthrene），2，3，4，7-四甲氧基菲（2,3,4,7-ttetramethoxyphenanthrene）；苄类化合物：山药素（batatasin）Ⅲ3'-O-甲基山药素（3'-O-methylbatatasin）Ⅲ；蒽类化合物：大黄素甲醚（physcioin）。又含酸类成分：对-羟基苯甲酸（p-hydroxybenzoic acid），原儿茶酸（protocatechuic acid），桂皮酸（cinnamic acid）；醛类成分：对-羟基苯甲醛（p-hydroxybenzaldehyde）。新鲜块茎另含白及甘露聚糖（bletillamannan），是由4份甘露糖（mannose）和1份葡萄糖（glucose）组成的葡配甘露聚糖。"}]},{"ID":"20240613093723-fhqpo97","Type":"NodeParagraph","Properties":{"id":"20240613093723-fhqpo97","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613093723-2k30kug","Type":"NodeParagraph","Properties":{"id":"20240613093723-2k30kug","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 1.止血作用：白及根磨成细粉或白及煎煮后所得胶状液掺入淀粉烘干研末，于狗肝行止血试验，7只中有6只皆于6分钟内达到满意的止血效果；用纯淀粉或淀粉海绵止血，效果均较差。止血试验后8-27天将狗杀死检查，7只中除1只感染外，其余的出血部位均与大网膜形成粘连，结缔组织反应轻微，显微镜下检查，组织反应亦均轻微。用水提取液的纱布或水提取液经低温干燥或喷雾干燥成粉覆盖于狗肝、脾及兔肝或大腿肌肉行止血试验，出血可立即停止，肝切除或肌肉横切引起之出血，即使创面渗血很多，亦不能将其冲去。动物体温在试验前后3天内无大变化，从组织切片看，白及对组织的局部反应性很小，第5天左右即可被吸收，全部动物均未用抗菌药，并未发生化脓。白及水煎浓缩膏状物加入0.2%地衣酸钠及0.4%盐酸小檗碱，干燥后研成细粉，对兔肝、狗肝及股动脉之出血，亦有明显的止血效果。白及的止血作用与其所含胶状成分有关，其作用原理可能为物理性的。白及液注入蛙下腔静脉后，可见末梢血管内红细胞凝集，形成人工血栓，从而有修补血管缺损的作用，而又不致阻塞较大血管内血液的流通。家兔用试管法及毛细管法均证明静脉注射2%白及胶液1.5ml／kg，可显着缩短凝血时间及凝血酶元时间，并加速红细胞沉降率。"}]},{"ID":"20240613093723-ih7u872","Type":"NodeParagraph","Properties":{"id":"20240613093723-ih7u872","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"2.保护胃粘膜作用：2.1.对盐酸引起的大鼠胃粘膜损伤的保护作用：白及煎剂能明显地减轻由0.6mol／L盐酸引起的大鼠胃粘膜损伤，即有明的细胞保护作用。1%白及煎剂1.5ml/只灌胃，对盐酸灌胃引起的大鼠胃粘膜损伤有保护作用。白及煎剂对大鼠胃液分泌量、胃液总酸度均无明显影响，胃液总酸排出量反而增加；用胃内源性前列腺素合成阻断剂消炎痛，可翻转白及的细胞保护作用。因此，白及煎剂对胃粘膜保护作用的机理不是通过抑制胃酸分泌，而很可能是刺激胃粘膜合成和释放内源性前列腺素而实现的。推测1%白及煎剂刺激胃粘膜合成的前列腺素的量不足以显着性地抑制胃酸分泌，提示产生胃粘膜细胞保护作用所需的PG量远小于其抑制胃酸分泌所需的量。"}]},{"ID":"20240613093723-wsg3ey9","Type":"NodeParagraph","Properties":{"id":"20240613093723-wsg3ey9","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"2.2.对实验性胃、十二指肠穿孔的治疗作用：对麻醉犬胃小弯及十二指肠第一部前壁各作人工穿孔一个，直径皆为1cm左右，灌入白及粉9g，15秒钟后两穿孔皆为白及所堵，40秒后，十二指肠穿孔即为大网膜遮盖，待动物逐渐苏醒、轻度活动时，再由胃管内注入稀粥500ml，观察两孔皆无漏出。再由肠系膜血管注入10%氯化钠20ml，胃蠕动显然增多、增强，也无内容物漏出。术后8小时再次剖腹，腹腔内未见胃内容物，腹腔渗出液极少，培养阴性。但若狗先饱食或穿孔较大，则服白及后无堵孔作用。此种作用可能是白及借其高度粘性，在胃内形成一定厚度的胶状膜，从而使穿孔堵塞，胃内容物停止外漏，为大网膜、肝脏等的遮盖作用造成更有利的条件。"}]},{"ID":"20240613093723-6krz6j6","Type":"NodeParagraph","Properties":{"id":"20240613093723-6krz6j6","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"3.预防实验动物肠粘连的作用：健康大白兔切开阑尾后作浆肌层致密缝合，模拟临床常见的具感染、缺血、异物和创伤的多因素粘连模型。结果用白及溶胶腹腔灌注的白兔，有2只未发生粘连，即使发生粘连处数目和粘连面积均明显少于右旋糖酐组和对照组，认为预防肠粘连是有效的，且比其他药物好。"}]},{"ID":"20240613093723-om9d5ac","Type":"NodeParagraph","Properties":{"id":"20240613093723-om9d5ac","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"4.抗菌、抗真菌作用：乙醇浸液用平板稀释法，1：100对金黄色葡萄球菌，1：20对枯草杆菌以及人型结核杆菌有抑制作用。水浸剂用试管稀释法，1：4对奥杜盎小孢子菌有抑制作用。从白及中提得5个成分，3个联苯类（bibenzyls）,2个双氢菲类（dihydrophenanthrenes）,100μg/ml浓度对枯草杆菌、金黄色葡萄球菌、白色念珠菌ATCC1057及发癣菌QM248有抑制作用。"}]},{"ID":"20240613093723-h2uhzdq","Type":"NodeParagraph","Properties":{"id":"20240613093723-h2uhzdq","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"5.抗癌及防癌作用：白及粘液质部分（主要为多糖成分）50mg/只腹腔注射，连续15-27天，对大鼠瓦克癌（W256）小鼠子宫颈癌（U14）、小鼠艾氏腹水癌实体型均有抑制作用，10、20mg/kg腹腔注射，连续10-25天，对小鼠肝癌、肉瘤180也有抑制作用。白及注射液（2%）4、6、8ml/只腹腔注射，每周3次，共给药48、60、72次，分批观察，表明对大鼠二甲氨基偶氮苯（DAB）诱发肝癌有明显抑制作用；电镜观察亚微结构，白及对肝细胞有较好的抗损伤作用，二甲氨基偶氮苯诱发的肝癌细胞，核大、核膜弯曲凹陷，白及组肝细胞结构正常。"}]},{"ID":"20240613093723-z1ul916","Type":"NodeParagraph","Properties":{"id":"20240613093723-z1ul916","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"6.其它作用：由抗动物失血性休克实验表明，2%的白及制剂可起到代血浆的作用，并有维持血容量及提高血压作用。白及胶质制成的5%注射剂，可作为硬化剂，在兔肠系膜静脉主干内注射，可使末梢血管壁形成无菌性炎症，血栓形成快，止血效果良好，对肝脏、肺脏无损害，作为血管栓塞材料，效果优于鱼肝油酸钠等。"}]},{"ID":"20240613093723-yins0py","Type":"NodeParagraph","Properties":{"id":"20240613093723-yins0py","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613093723-mj37psr","Type":"NodeParagraph","Properties":{"id":"20240613093723-mj37psr","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 除去残茎、须根，洗净泥土，经蒸煮至内面无白心，然后撞去粗皮，再晒干或烘干或拣去杂质，用水浸泡，捞出，晾至湿度适宜，切片，干燥。"}]},{"ID":"20240613093723-okhi5jo","Type":"NodeParagraph","Properties":{"id":"20240613093723-okhi5jo","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613093723-ovb0emv","Type":"NodeParagraph","Properties":{"id":"20240613093723-ovb0emv","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 取本品约2g，加水20ml，在沸水中热浸30min，滤过，滤液进行下列试验：①取热水提取液1ml，加入新配制的碱性酒石酸铜试剂5-6滴，在沸水浴中加热5min，产生棕红色氧化亚铜沉淀。②取热水提取液1ml，加入5%α-萘酚乙醇溶液3滴，摇匀，沿试管壁缓缓加入浓硫酸，在试液界面处形成紫红色环。（检查糖类）"}]},{"ID":"20240613093723-o43orck","Type":"NodeParagraph","Properties":{"id":"20240613093723-o43orck","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613093723-p5mer4i","Type":"NodeParagraph","Properties":{"id":"20240613093723-p5mer4i","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 肺；胃经"}]},{"ID":"20240613093723-jenti13","Type":"NodeParagraph","Properties":{"id":"20240613093723-jenti13","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613093723-qzutjty","Type":"NodeParagraph","Properties":{"id":"20240613093723-qzutjty","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 苦；甘；涩；寒"}]},{"ID":"20240613093723-tt01rt4","Type":"NodeParagraph","Properties":{"id":"20240613093723-tt01rt4","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613093723-sk2pcw7","Type":"NodeParagraph","Properties":{"id":"20240613093723-sk2pcw7","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 外感及内热壅盛者禁服。反乌头。"}]},{"ID":"20240613093723-n42ivlw","Type":"NodeParagraph","Properties":{"id":"20240613093723-n42ivlw","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613093723-34v1k2b","Type":"NodeParagraph","Properties":{"id":"20240613093723-34v1k2b","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 收敛止血；消肿生肌。主咯血；吐血；衄血；便血；外伤出血；痈疮肿毒；烫灼伤；手足皲裂；肛裂"}]},{"ID":"20240613093723-6i209k8","Type":"NodeParagraph","Properties":{"id":"20240613093723-6i209k8","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613093723-nh8kpw1","Type":"NodeParagraph","Properties":{"id":"20240613093723-nh8kpw1","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；研末，每次1.5-3g。外用：适量，研末撒或调涂。"}]},{"ID":"20240613093723-teg0cbh","Type":"NodeParagraph","Properties":{"id":"20240613093723-teg0cbh","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613093723-421owaj","Type":"NodeParagraph","Properties":{"id":"20240613093723-421owaj","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 白及散《医学启蒙》；加味桔梗汤《医学心悟》；白及粉《症因脉治》；"}]},{"ID":"20240613093723-xlf5hq6","Type":"NodeParagraph","Properties":{"id":"20240613093723-xlf5hq6","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613093723-6gs5p9l","Type":"NodeParagraph","Properties":{"id":"20240613093723-6gs5p9l","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：白及，性涩而收，故能入肺止血，生肌治疮也。"}]},{"ID":"20240613093723-qwng22h","Type":"NodeParagraph","Properties":{"id":"20240613093723-qwng22h","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：白及，苦能泄热，辛能散结，痈疽皆由荣气不从，逆于肉里所生；败疽伤阴死肌，皆热壅血瘀所致，故悉主之也。胃中邪气者，即邪热也；贼风痱缓不收，皆血分有热，湿热伤阴之所生也，入血分以泄热，散结逐腐，则诸证靡不瘳矣。"}]},{"ID":"20240613093723-4yxsg0o","Type":"NodeParagraph","Properties":{"id":"20240613093723-4yxsg0o","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：白及，敛气，渗痰，止血，消痈之药也。此药质极粘腻，性极收涩，味苦气寒，善入肺经。凡肺叶破损，因热壅血瘀而成疾者，以此研末日服，能坚敛肺藏，封填破损，痈肿可消，溃败可托，死肌可去，脓血可洁，有托旧生新之妙用也。如肺气郁逆，有痰有火有血，迷聚于肺窍气管之中，此属统体一身气道之故，理直清肺之原，降气之逆，痰血清而火自退矣，若徒用此药，粘腻封塞，无益也。"}]},{"ID":"20240613093723-79kft3b","Type":"NodeParagraph","Properties":{"id":"20240613093723-79kft3b","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"4.《本草经百种录》：白及，气味冲淡和平，而体质滑润，又极粘腻，入于筋骨之中，能和柔滋养，与正气相调，则微邪自退也。"}]},{"ID":"20240613093723-6e8gk3g","Type":"NodeParagraph","Properties":{"id":"20240613093723-6e8gk3g","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：白及，方书既载功能入肺止血，又载能治跌扑折骨，汤火灼伤，恶疮痈肿，败疽死肌，得非似收不收，似涩不涩，似止不止乎？不知书言功能止血者，是因性涩之谓也；书言能治痈疽损伤者，是因味辛能散之谓也。此药涩中有散，补中有破，故书又载去腐、逐瘀、生新。"}]},{"ID":"20240613093723-cb5t6ti","Type":"NodeParagraph","Properties":{"id":"20240613093723-cb5t6ti","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"6.《重庆堂随笔》：白及最粘，大能补肺，可为上损善后之药。如火热未清者，不可早用，以其性涩，恐留邪也。惟味太苦，宜用甘味为佐，甘则能恋膈。又宜噙化，使其徐徐润入喉下，则功效更敏。其法以白及生研细末，白蜜丸龙眼大，临卧噙口中，或同生甘草为细末，甘梨汁为丸亦可。若痰多咳嗽久不愈者，加白前同研末，蜜丸噙化。"}]},{"ID":"20240613093723-xh12xuv","Type":"NodeParagraph","Properties":{"id":"20240613093723-xh12xuv","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"7.《本草便读》：白及，必虚而有热者，乃为相宜耳。虽禀收敛之性，而仍具苦泄辛散之意，与白蔹相近，故每相须而用。"}]},{"ID":"20240613093723-y7br9t6","Type":"NodeParagraph","Properties":{"id":"20240613093723-y7br9t6","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"8.《本草正义》：白及，《本经》主痈肿恶疮败疽，伤阴死肌，《别录》除白癣疥虫，皆以痈疡外敷及掺药言之。味苦辛而气寒，故能消散血热之痈肿；性粘而多脂，则能疗败疽之死肌；苦辛之品，又能杀虫，则除白癣、疥虫，外疡消肿生肌之要药也。主胃中邪气者，则苦寒之品，能除胃热耳。惟贼风痱缓不收，其义未详，不敢强解。白及治肺痈，世每疑其腻滞而不敢用，然苦寒本清肺胃，又能补伤，苟非火焰极盛之时，而臭痰腥秽之气，已惭退舍，即可用以兼补兼清，不致助痰留患，与二冬、玉竹等比也。"}]},{"ID":"20240613093723-pzftb1b","Type":"NodeParagraph","Properties":{"id":"20240613093723-pzftb1b","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"9.《本经》：主痈肿恶疮败疽，伤阴死肌，胃中邪气，贼风痱缓不收。"}]},{"ID":"20240613093723-p8mv3sp","Type":"NodeParagraph","Properties":{"id":"20240613093723-p8mv3sp","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"10.《别录》：除白癣疥虫。"}]},{"ID":"20240613093723-gzolmhl","Type":"NodeParagraph","Properties":{"id":"20240613093723-gzolmhl","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"11.《药性论》：治结热不消，主阴下痿，治面上疹疱，令人肌滑。"}]},{"ID":"20240613093723-3zwbd8e","Type":"NodeParagraph","Properties":{"id":"20240613093723-3zwbd8e","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"12.《唐本草》：手足皲拆，嚼以涂之。"}]},{"ID":"20240613093723-rbqjpx9","Type":"NodeParagraph","Properties":{"id":"20240613093723-rbqjpx9","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"13.《日华子本草》：止惊邪、血邪，痫疾，赤眼，症结，发背，瘰疬，肠风，痔瘘，刀箭疮扑损，温热疟疾，血痢，汤火疮，生肌止痛，风痹。"}]},{"ID":"20240613093723-9movbca","Type":"NodeParagraph","Properties":{"id":"20240613093723-9movbca","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"14.《本草图经》：治金疮不瘥，痈疽方中多用之。"}]},{"ID":"20240613093723-jhjtah0","Type":"NodeParagraph","Properties":{"id":"20240613093723-jhjtah0","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"15.李杲：止肺血。"}]},{"ID":"20240613093723-ljxr14l","Type":"NodeParagraph","Properties":{"id":"20240613093723-ljxr14l","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"16.《滇南本草》：治痨伤肺气，补肺虚，止咳嗽，消肺痨咳血，收敛肺气。"}]},{"ID":"20240613093723-b25x1pb","Type":"NodeParagraph","Properties":{"id":"20240613093723-b25x1pb","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"17.《中国药植图鉴》：治矽肺。"}]},{"ID":"20240613093723-la2ffmz","Type":"NodeParagraph","Properties":{"id":"20240613093723-la2ffmz","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613093723-fy1q8o3","Type":"NodeParagraph","Properties":{"id":"20240613093723-fy1q8o3","updated":"20240613093723"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613093724-eii609a","Type":"NodeThematicBreak","Properties":{"id":"20240613093724-eii609a"}},{"ID":"20240613093725-i4eqnse","Type":"NodeParagraph","Properties":{"id":"20240613093725-i4eqnse"}}]}