":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 726px;","style":"width: 716px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"益母草、艾叶、艾蒿对比2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/益母草、艾叶、艾蒿对比2-20240704112253-6hcjccg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 716px;\" parent-style=\"width: 726px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704111933-8rq4jaz","Type":"NodeParagraph","Properties":{"id":"20240704111933-8rq4jaz","updated":"20240828135006"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 400px;","style":"width: 390px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704111933-z5gyvcj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 390px;\" parent-style=\"width: 400px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 355px;","style":"width: 345px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704111952-fkam4pn.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 345px;\" parent-style=\"width: 355px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240704111424-raz1vh2","Type":"NodeParagraph","Properties":{"id":"20240704111424-raz1vh2","updated":"20240704111541"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：艾草叶面比较饱满，艾蒿叶面相对比较空；艾草叶尖相对没那么明显，艾蒿叶尖非常明显；"}]},{"ID":"20240614102614-81cblks","Type":"NodeThematicBreak","Properties":{"id":"20240614102614-81cblks"}},{"ID":"20240614105255-ys3la5x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105255-ys3la5x","updated":"20240614105259"},"Children":[{"Type":"NodeText","Data":"艾叶《汤液本草》"}]},{"ID":"20240614105255-813w514","Type":"NodeParagraph","Properties":{"id":"20240614105255-813w514","updated":"20240614105255"},"Children":[{"Type":"NodeText","Data":"气温，味苦，阴中之阳。无毒。"}]},{"ID":"20240614105255-lzo7ycw","Type":"NodeParagraph","Properties":{"id":"20240614105255-lzo7ycw","updated":"20240614105255"},"Children":[{"Type":"NodeText","Data":"《本草》云∶止下痢吐血，下部 疮，辟风寒，令人有子。灸百病。重午日，日未出时，不语采。"}]},{"ID":"20240614105255-zblkw3k","Type":"NodeParagraph","Properties":{"id":"20240614105255-zblkw3k","updated":"20240614105255"},"Children":[{"Type":"NodeText","Data":"《心》云∶温胃。"}]},{"ID":"20240614105205-kj0pfkr","Type":"NodeThematicBreak","Properties":{"id":"20240614105205-kj0pfkr"}},{"ID":"20240614105243-af0ye16","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105243-af0ye16","updated":"20240614105246"},"Children":[{"Type":"NodeText","Data":"艾叶《本草撮要》"}]},{"ID":"20240614105243-prjwp9w","Type":"NodeParagraph","Properties":{"id":"20240614105243-prjwp9w","updated":"20240614105243"},"Children":[{"Type":"NodeText","Data":"味苦．入足厥阴经．功专暖子宫．杀虫 ．得香附治少腹痛．得阿胶治产后下血．得雄黄治狐惑症．脑漏鼻出黄汁．以艾绒装在烟筒内吸食数日即愈．丹田气弱脐腹冷者．以熟艾装袋兜脐上效．寒湿香港脚夹入袜内佳．入茯苓数片同研则易细．香附为使．血热者忌．"}]},{"ID":"20240614105205-2d2qqzl","Type":"NodeThematicBreak","Properties":{"id":"20240614105205-2d2qqzl"}},{"ID":"20240614105233-gx7ejxf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105233-gx7ejxf","updated":"20240614105237"},"Children":[{"Type":"NodeText","Data":"艾叶《本草衍义》"}]},{"ID":"20240614105233-373rrif","Type":"NodeParagraph","Properties":{"id":"20240614105233-373rrif","updated":"20240614105233"},"Children":[{"Type":"NodeText","Data":"艾叶干捣，筛去青滓，取白。入石硫黄，为硫黄艾，灸家用。得米粉少许，可捣为末，入服食药。入硫黄别有法。"}]},{"ID":"20240614105357-g3nax26","Type":"NodeThematicBreak","Properties":{"id":"20240614105357-g3nax26"}},{"ID":"20240614105358-ckemcp9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105358-ckemcp9","updated":"20240614105405"},"Children":[{"Type":"NodeText","Data":"艾叶《本草便读》"}]},{"ID":"20240614105358-i0zqa5n","Type":"NodeParagraph","Properties":{"id":"20240614105358-i0zqa5n","updated":"20240614105358"},"Children":[{"Type":"NodeText","Data":"补命门以暖子宫．香达肝脾寒湿化．理血气而疗崩带．温通奇脉苦辛兼．可灸疮疽．能熏虫蚀．（艾叶入肝脾肾三经．芳香可以入血．辛热可以解寒．故生者能理血气．解散风寒湿邪．或炒黑．或揉熟．能温暖下元．治妇人崩带瘕疝胎产等证．属于寒湿者．皆可用之．纯阳之性．故可杀虫辟恶．其灸疮疽者．藉芳香辛热以宣通气血耳．艾叶入下焦血分．能温阴中之阳．逐下焦血分寒湿浊气．生温熟热．生者能散．熟者能守．亦若干姜炮姜之用．但艾叶之功．辛苦而香．所用在叶．非干姜之但辛热而用根也．）"}]},{"ID":"20240614105342-6ftocjr","Type":"NodeThematicBreak","Properties":{"id":"20240614105342-6ftocjr"}},{"ID":"20240614105344-c82qhvr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105344-c82qhvr","updated":"20240614105347"},"Children":[{"Type":"NodeText","Data":"艾叶《本草从新》"}]},{"ID":"20240614105344-xx8zpjo","Type":"NodeParagraph","Properties":{"id":"20240614105344-xx8zpjo","updated":"20240614105344"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣理气血、燥逐寒热．"}]},{"ID":"20240614105344-axtk2xa","Type":"NodeParagraph","Properties":{"id":"20240614105344-axtk2xa","updated":"20240614105344"},"Children":[{"Type":"NodeText","Data":"苦辛．生温熟热．纯阳之性．能回垂绝之元阳．通十二经．走三阴．（太、少、厥．）理气血．逐寒湿．暖子宫．止诸血．温中开郁．调经安胎．（胎动腰痛下血、胶艾汤良、胶艾煎服、亦治虚痢．）治吐衄崩带．（治带要药．）腹痛冷痢．血痢．霍乱转筋．杀蛔治癣．（醋煎服、外科有用干艾作汤、投白矾二三钱、洗疮、然后敷药、盖人气血冷、必假艾力以佐阳、而艾性又能杀虫也．）以之灸火．能透诸经而除百病．（丹田气弱、脐腹冷者、以熟艾装袋气亦宜、以此夹入袜内．）纯阳香燥．凡血燥生热者．禁与灸火．"}]},{"ID":"20240614105344-l4648e0","Type":"NodeParagraph","Properties":{"id":"20240614105344-l4648e0","updated":"20240614105344"},"Children":[{"Type":"NodeText","Data":"亦大伤阴血．虚者宜慎．陈久者良．揉捣如绵．谓之熟艾．灸火用．妇人丸散．醋煮捣饼．"}]},{"ID":"20240614105344-rg9bw1q","Type":"NodeParagraph","Properties":{"id":"20240614105344-rg9bw1q","updated":"20240614105344"},"Children":[{"Type":"NodeText","Data":"再为末用．（入茯苓数片同研、则易细．）煎服宜鲜者．醋、香附为使．（艾附丸、调妇人诸病、宋时重汤阴艾、自明成化来、则以蕲州艾为胜、云灸酒坛、一灸便透、蒙筌、发明、并以野艾为真蕲艾、虽香、实非艾种、今人多以蓬蒿伪蕲艾．）"}]},{"ID":"20240614105316-jr6orle","Type":"NodeThematicBreak","Properties":{"id":"20240614105316-jr6orle"}},{"ID":"20240614105317-4viio3w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105317-4viio3w","updated":"20240614105321"},"Children":[{"Type":"NodeText","Data":"艾叶《针灸聚英》"}]},{"ID":"20240614105317-znxvi6v","Type":"NodeParagraph","Properties":{"id":"20240614105317-znxvi6v","updated":"20240614105317"},"Children":[{"Type":"NodeText","Data":"本草云．艾．味苦．气微温．阴中之阳．无毒．主灸百病．三月三日．五月五日．采曝干．"}]},{"ID":"20240614105317-jbwx49b","Type":"NodeParagraph","Properties":{"id":"20240614105317-jbwx49b","updated":"20240614105317"},"Children":[{"Type":"NodeText","Data":"干燥．入臼捣之．以细筛去尘屑．每入石臼捣取．洁白为上．须令焙太燥．则灸有力．火易燃．如润无功．"}]},{"ID":"20240614105317-x16rsed","Type":"NodeParagraph","Properties":{"id":"20240614105317-x16rsed","updated":"20240614105317"},"Children":[{"Type":"NodeText","Data":"证类本草云．出明州．图经云．旧不着所出州土．但云生田野．今在处有之．以复道者为佳．七年之病．求三年之艾．丹溪云．艾性至热．入火灸则上行．入药服则下行．"}]},{"ID":"20240614105325-xoflf2p","Type":"NodeThematicBreak","Properties":{"id":"20240614105325-xoflf2p"}},{"ID":"20240614105326-5lz2but","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105326-5lz2but","updated":"20240614105336"},"Children":[{"Type":"NodeText","Data":"艾叶《本草图经》"}]},{"ID":"20240614105326-3ijmzfh","Type":"NodeParagraph","Properties":{"id":"20240614105326-3ijmzfh","updated":"20240614105330"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"艾叶"},{"Type":"NodeText","Data":"，旧不着所出州土，但云生田野，今处处有之，以复道者为佳。"}]},{"ID":"20240614105326-gsbsf3a","Type":"NodeParagraph","Properties":{"id":"20240614105326-gsbsf3a","updated":"20240614105326"},"Children":[{"Type":"NodeText","Data":"云此种灸百病尤胜。初春布地生苗，茎类蒿，而叶背白，以苗短者为佳。三月三日、五月五日采叶，曝干，经陈久方可用。俗间亦生捣叶取汁饮，止心腹恶气。古方亦用熟艾拓金疮。又中风掣痛，不仁不随。并以干艾斛许，揉团之，内瓦甑中，并下塞诸孔，独留一目，以痛处着甑目下，烧艾一时，久知矣。又治癞，取于艾随多少，以浸曲酿酒如常法，饮之，觉痹即瘥。近世亦有单服艾者，或用蒸木瓜丸之，或作汤空腹饮之，甚补虚羸，然亦有毒，其毒发，则热气冲上，狂躁不能禁，至攻眼有疮出血者，诚不可妄服也。"}]},{"ID":"20240614105305-abagbub","Type":"NodeThematicBreak","Properties":{"id":"20240614105305-abagbub"}},{"ID":"20240614105306-g1d7zr6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105306-g1d7zr6","updated":"20240614105310"},"Children":[{"Type":"NodeText","Data":"艾叶《中药炮制》"}]},{"ID":"20240614105306-d61c502","Type":"NodeParagraph","Properties":{"id":"20240614105306-d61c502","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『来源』本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艾"},{"Type":"NodeText","Data":"的干燥叶。"}]},{"ID":"20240614105306-t3zk1t1","Type":"NodeParagraph","Properties":{"id":"20240614105306-t3zk1t1","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『常用名』圻艾。"}]},{"ID":"20240614105306-uqfxcat","Type":"NodeParagraph","Properties":{"id":"20240614105306-uqfxcat","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『产地』湖北圻州等地。"}]},{"ID":"20240614105306-v9md8m2","Type":"NodeParagraph","Properties":{"id":"20240614105306-v9md8m2","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『采收季节』5～7月采收。"}]},{"ID":"20240614105306-82yjcg5","Type":"NodeParagraph","Properties":{"id":"20240614105306-82yjcg5","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『炮制方法』将艾叶放簸箕内摊开，拣去杂草，摘去柄，筛去灰尘。若取其止血，则炒炭，用文火拌炒至黑色。炒时注意，如锅内发现火星，立即洒水拌熄，取出摊冷。若取其入肝，活血止痛，则用醋炒，每斤药用醋二至四两，洒入药内，稍润片刻，投入锅内炒至焦黄色，取出摊冷（防火）。制艾绒：将艾叶放石臼或研槽内研成绒状即可。"}]},{"ID":"20240614105306-f1fphfo","Type":"NodeParagraph","Properties":{"id":"20240614105306-f1fphfo","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『用量』3～9克。"}]},{"ID":"20240614105306-6tyfcpn","Type":"NodeParagraph","Properties":{"id":"20240614105306-6tyfcpn","updated":"20240614105306"},"Children":[{"Type":"NodeText","Data":"『贮存』装箱内加盖，防灰尘。"}]},{"ID":"20240614105205-ef1l71j","Type":"NodeThematicBreak","Properties":{"id":"20240614105205-ef1l71j"}},{"ID":"20240614105222-oluzy0n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105222-oluzy0n","updated":"20240614105227"},"Children":[{"Type":"NodeText","Data":"艾《本草述钩元》"}]},{"ID":"20240614105222-ztmber6","Type":"NodeParagraph","Properties":{"id":"20240614105222-ztmber6","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"野生类蒿。复道者为佳。勿拘州土。蕲产独茎圆叶。背白有芒者。以形状考之。乃九牛草也。人都不识。并诩为艾之精英。顾经注明云。九牛草气虽艾香。实非艾种。医用作炷。"}]},{"ID":"20240614105222-eqc0aoq","Type":"NodeParagraph","Properties":{"id":"20240614105222-eqc0aoq","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"以灸风湿痹疼痨热积聚。尝获效者。亦因辛窜可以通利关窍而已。（仙制本草）味苦而辛。气温芳烈。阴中之阳。生温熟热。可升可降。纯阳之草也。入足太阴厥阴少阴经。主温下元。利阴滞。开结达气。逐冷祛湿。利肝滞冷气作痛。治血病吐衄血痢。疗女子虚漏湿带。暖子宫使孕。并妊娠漏血。产后下血不止。用灸百病。其热气内注。通筋入骨。"}]},{"ID":"20240614105222-mguekv9","Type":"NodeParagraph","Properties":{"id":"20240614105222-mguekv9","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"方书治霍乱。（乌梅散中有熟艾。盖治霍乱后痢不止。冷汗出。腹胁胀者。）痫证。（葶苈苦酒汤论治云。凡病发项强直视。不省人事。此肝经有热也。）泄泻。（白术汤治风冷入中。泄利不止。脉虚细者。）目痛（点眼金华水。治肝脏有热。血脉壅滞者。）目泪。（羌活散治目风冷泪久不瘥者）艾叶可取太阳真火。能回垂绝元阳。服之则走三阴。逐寒湿。转肃杀为融和。灸之则透诸经。治百病。起沉为康泰。其功大矣。但惟虚寒痼冷。及湿郁带漏者。以此和之。中病即止。是以归附诸药。罔不着效。若久服致燥。而归咎于艾。于艾何尤。（濒湖）艾乃温下元之药。非经行先期所宜。（阆风）少加艾叶于寒凉药中。即复卦之义。然亦有不必用者。非调经所可概施也。（又）艾附丸。治心腹少腹诸痛。开郁调经。能暖子宫使孕。姜艾丸。温中除湿。祛一切冷气。胶艾汤。治虚痢。及妊娠产后下血。尤着奇效。老人丹田气弱。脐腹畏冷者。以熟艾入布袋。兜其脐腹。妙不可言。寒湿香港脚。亦宜以此夹入袜内。作炷。灸诸经穴。不差凿窍。拔风湿毒尤验。（以上濒湖）妇人月事不调。血少无热证者。同香附醋浸。入四物汤加阿胶枳壳。神效。发背初起。急灸疮头。不痛灸至痛。痛灸至不痛。夺命神方也。纵溃。毒瓦斯外泄。不至内攻矣。若未溃疮头。用湿纸粘贴。看先干处。"}]},{"ID":"20240614105222-blxo0c0","Type":"NodeParagraph","Properties":{"id":"20240614105222-blxo0c0","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"即于此灸。熏疥疮法。熟艾一两。木鳖子三钱。雄黄二钱。硫黄一钱。为末。揉入艾中。分作四条。每以一条安阴阳瓦中。置被里烘熏。后服通圣散。火眼。用艾烧令烟起。以碗盖之。"}]},{"ID":"20240614105222-eregpon","Type":"NodeParagraph","Properties":{"id":"20240614105222-eregpon","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"候烟上碗成煤。取下水调。或洗或点。更入黄连尤妙。中风口噤。熟艾灸承浆一穴。颊车二穴。各五壮。中风掣痛。不仁不随。并以干艾斛许。揉团纳瓦甑中。塞诸孔隙。独留一目。"}]},{"ID":"20240614105222-bbgxyoe","Type":"NodeParagraph","Properties":{"id":"20240614105222-bbgxyoe","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"以痛处着甑目。烧艾熏之。癫痫诸风。取熟艾于阴囊谷道中间。随年岁灸之。头风久痛。揉艾为丸。时时嗅之。以黄水出为度。妊娠胎动。或腰痛。或抢心。或下血不止。或倒产子死腹中。艾叶一鸡子大。酒四升。煮二升。分二服。胎动迫心作痛。艾叶鸡子大。以头醋四升。"}]},{"ID":"20240614105222-r9emv4q","Type":"NodeParagraph","Properties":{"id":"20240614105222-r9emv4q","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"煎二升。分温服。吐衄血热妄行。生荷叶生艾叶侧柏叶生地黄各等分。捣烂。丸如蛋大。每丸用水二杯。煎一杯。去渣服。妇人漏下。或半产后下血不绝。或妊娠下血。并宜胶艾四物汤。阿胶二两。艾叶三两。川芎甘草各二两。当归地黄各三两。芍药四两。水酒各五升。煮取三升。纳胶令消尽。每温服一升。日二服。"}]},{"ID":"20240614105222-co92f5m","Type":"NodeParagraph","Properties":{"id":"20240614105222-co92f5m","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"〔论〕艾叶生则微苦。大辛。熟则微辛。大苦。生温熟热。纯阳也。第艾一名冰台。"}]},{"ID":"20240614105222-566wqq9","Type":"NodeParagraph","Properties":{"id":"20240614105222-566wqq9","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"博物志言削冰令圆。举而向日。以艾承其影。则得火。丹溪曰。艾属火而有水。即斯绎之。"}]},{"ID":"20240614105222-hnx78eu","Type":"NodeParagraph","Properties":{"id":"20240614105222-hnx78eu","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"是艾虽纯阳之性。乃本于阴而毕畅其阳之气者也。夫阳在阴中而畅其气。然后阴血乃生。即漏下乃固。然则艾之用。惟宜于寒湿之血病。而燥热之血病。正属相反。盖从阴中达阳。还以育阴。（此才是艾之功用。若概谓之纯阳。何以他味纯阳。不与此同其功用耶。）不谓于阳盛而更僭之。阴微而更耗之也。大凡阴虚不能生血。固宜补阴。然不鼓动其阴中之阳。则阴亦不生不化。至于胎漏腹痛。元阳下陷。血乃不固。是皆因虚化寒。因寒动湿之血病。夫因虚生寒。经固曰气虚者寒矣。其因寒动湿者。以阴中阳虚。气不能化。而郁为湿也。盖热之气固就燥。寒之气固就湿。水火之应如此。如是等证。苟用四物而舍艾。岂中的之剂乎。若四生丸之治吐血。兼投艾叶于寒凉中。使阴血有主而得以归经。又治产后虚痢。亦有入艾于寒凉者。总不欲伤其阴中之真阳也。古方调经。多用艾。与疗崩漏及妊娠下血。皆合阿胶投之。以阿胶入手太阴。为气中之阴。艾叶入肝脾肾三经。为血中之阳。有升有降。合和以调气血。而即以固脱也。用醋煮者。亦敛而归阴之义。故知所以用之。则此味生温熟热。皆可奏效矣。"}]},{"ID":"20240614105222-fjzgnco","Type":"NodeParagraph","Properties":{"id":"20240614105222-fjzgnco","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"〔附血证论治〕凡失血而上行者。皆阴不能为阳之守也。阴为阳守者。以阳原出于阴中也。故阳上行而阴即与之俱上矣。第身半以下。阴为主而阳生焉。身半以上。阳为主而阴宅焉。（阳中宅阴是即阳上行而阴与之俱上者）如阴中阳虚。则阴无以化。而病于气之化原矣。阳中阴虚。则阳无以化。而病于血之化原矣。气之化原病。则阴为死阴。死阴者无阳以使之化。能静而不能动也。血之化原病。则阳为孤阳。孤阳者无阴以为之守。能动而不能静也。如阳有阴以为之守。则阴之静者趋下。而阳亦与之俱下。乃安其静顺之化。否则阳不得阴以为依。而孤阳止有动而无静。有升而无降。且引阴所化之血而上逆矣。然则疗斯证者。"}]},{"ID":"20240614105222-pzj96ua","Type":"NodeParagraph","Properties":{"id":"20240614105222-pzj96ua","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"惟用清甘滋阴。而俾阳降乎。或必苦寒抑阳。而使之降乎。不知苦寒反能亡阴。盖阴伤则不能化阳而血病。若苦寒则阳伤而不能化阴。是亦血之化原微也。且血既妄行。迷失故道。不为之去其蓄。以利其瘀。曷以御之。滑氏云。血证皆有所挟。或挟风。或挟湿。或挟气。又有因药石而发者。虽非治本之义。然当区别以奏前茅之功也。（诸血上溢。其始率用桃仁大黄。得之以折其锐气。而后分别所伤以治之。得效乃多。）大抵治血之逆而上者。多属化阴降阳。治血之顺而下者。类属补阳育阴。二者固区以别矣。方书用艾以治溲血下血。夫溲血有虚实二因。此主宜于补者而言。下血亦指久不愈而痿黄虚惫。下元衰弱者而言。非概论二证之治也。"}]},{"ID":"20240614105222-meepjhc","Type":"NodeParagraph","Properties":{"id":"20240614105222-meepjhc","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"性气燥热。凡胎动不由于寒。下痢非单湿为病。崩中经缩不孕不由于风寒入子宫。法并忌之〔修治〕生者。取汁用。治血痢。止呕血。熟者。治漏血。入妇人丸散。须用醋煮干。"}]},{"ID":"20240614105222-el67qb7","Type":"NodeParagraph","Properties":{"id":"20240614105222-el67qb7","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"捣成饼子。烘干。再捣为末。其以糯糊和作饼及酒炒者。皆不佳。煎剂宜新鲜。气则上达。"}]},{"ID":"20240614105222-r1qt8gb","Type":"NodeParagraph","Properties":{"id":"20240614105222-r1qt8gb","updated":"20240614105222"},"Children":[{"Type":"NodeText","Data":"灸火宜陈久。气乃下行。用陈久艾叶。治令细软。谓之熟艾。若生艾灸火。则伤人肌脉。其法拣取净叶。扬去尘屑。入石臼内。木杵捣熟。罗去渣。取白者再捣。至柔烂如绵为度。用时焙燥。则灸火得力。（濒湖）艾难着力。若入白茯苓三五片同研。即时可作细末。亦一异也。（洪容斋）"}]},{"ID":"20240614102614-lnc1p5d","Type":"NodeThematicBreak","Properties":{"id":"20240614102614-lnc1p5d"}},{"ID":"20240614105155-iqoel29","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105155-iqoel29","updated":"20240614105159"},"Children":[{"Type":"NodeText","Data":"艾叶《新修本草》"}]},{"ID":"20240614105155-vt22eit","Type":"NodeParagraph","Properties":{"id":"20240614105155-vt22eit","updated":"20240614105155"},"Children":[{"Type":"NodeText","Data":"味苦，微温，无毒。主灸百病，可作煎，止下痢，吐血，下部KT 疮，妇人漏血，利阴气，生一名冰台，一名医草。生田野。三月三日采，曝干。作煎勿令见风。"}]},{"ID":"20240614105155-fqp52gh","Type":"NodeParagraph","Properties":{"id":"20240614105155-fqp52gh","updated":"20240614105155"},"Children":[{"Type":"NodeText","Data":"捣叶以灸百病，亦止伤血。汁，又杀蛔虫。苦酒煎叶，疗癣甚良。"}]},{"ID":"20240614105155-nxh5l26","Type":"NodeParagraph","Properties":{"id":"20240614105155-nxh5l26","updated":"20240614105155"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶艾脓血痢，水煮及丸散任用。"}]},{"ID":"20240614102614-chu0syg","Type":"NodeThematicBreak","Properties":{"id":"20240614102614-chu0syg"}},{"ID":"20240614105145-ffx6wnj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105145-ffx6wnj","updated":"20240614105149"},"Children":[{"Type":"NodeText","Data":"艾叶《冯氏锦囊秘录》"}]},{"ID":"20240614105145-ayh0nls","Type":"NodeParagraph","Properties":{"id":"20240614105145-ayh0nls","updated":"20240614105145"},"Children":[{"Type":"NodeText","Data":"禀天地之阳气以生，故味辛微温，其气芳烈，纯阳之草也。无毒。入足太阴、厥阴、少阴三经。生寒而兼辛散，熟则大热，火炎则气内注，通筋入骨，煮服则上升，故止崩漏安胎，且为调经治带温中除湿辟恶女科之要药。"}]},{"ID":"20240614105145-qh6vyyf","Type":"NodeParagraph","Properties":{"id":"20240614105145-qh6vyyf","updated":"20240614105145"},"Children":[{"Type":"NodeText","Data":"艾叶，祛寒湿温中，除腹痛，保孕杀虫，疗 疮作炷炙百病，熨脐腹冷疼，辟诸疫鬼气。同香附醋糊丸，名艾附丸，开郁结，调月经，温暖子宫，使孕早结。同干姜末蜜丸，名姜艾丸，驱冷气恶气，逐鬼邪气，火灼气下行。入药气上行，若阴虚血燥者，大非所宜。"}]},{"ID":"20240614103119-y8b2f68","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-y8b2f68"}},{"ID":"20240614105133-mm1tvbn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105133-mm1tvbn","updated":"20240614105137"},"Children":[{"Type":"NodeText","Data":"艾叶《本草经集注》"}]},{"ID":"20240614105133-d81es10","Type":"NodeParagraph","Properties":{"id":"20240614105133-d81es10","updated":"20240614105133"},"Children":[{"Type":"NodeText","Data":"味苦，微温，无毒。主灸百病，可作煎，止下痢，吐血，下部 疮，妇人漏血，利阴气，生肌肉，辟风寒，使人有子。一名冰台，一名医草。生田野。三月三日采，曝干。作煎勿令见风。"}]},{"ID":"20240614105133-5v3foad","Type":"NodeParagraph","Properties":{"id":"20240614105133-5v3foad","updated":"20240614105133"},"Children":[{"Type":"NodeText","Data":"捣叶以灸百病，亦止伤血。汁，又杀蛔虫。苦酒煎叶，治癣甚良。"}]},{"ID":"20240614103119-kdmptfe","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-kdmptfe"}},{"ID":"20240614105122-5rj8bwh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105122-5rj8bwh","updated":"20240614105128"},"Children":[{"Type":"NodeText","Data":"艾叶《本草蒙筌》"}]},{"ID":"20240614105122-0ax08x1","Type":"NodeParagraph","Properties":{"id":"20240614105122-0ax08x1","updated":"20240614105122"},"Children":[{"Type":"NodeText","Data":"味苦，气生寒熟温。阴中之阳。无毒。各处田野有，以复道者为佳；初春布地生，与草蒿状颇类。但叶背白，风动微香。每端午朝，天明多采。或悬户资禳疫疠，或藏家防治病邪。煎服宜新鲜，气则上达；炙火宜陈久，气仍下行。揉碎入四物汤，安胎漏腹痛；捣汁搀四生饮，止吐衄唾红。艾附丸（同香附末醋糊丸，）开郁结，调月经，温暖子宫，使孕早结。"}]},{"ID":"20240614105122-3zhmbem","Type":"NodeParagraph","Properties":{"id":"20240614105122-3zhmbem","updated":"20240614105122"},"Children":[{"Type":"NodeText","Data":"姜艾丸（同干姜末蜜丸。）驱冷气，去恶气，免证久缠。和研细雄黄，熏下部 疰湿痹及疥癣神效；和蜡片诃子，熏痢后寒热急痛并带漏殊功。作炷灸诸经穴不差，凿窍拨风湿毒尤验。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"取入药，令人有娠。助水脏壮阳，暖腰膝明目。又"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"九牛草"},{"Type":"NodeText","Data":"，产均州山。（属湖广。）叶圆长背白有芒，茎独植高二尺许。气香似艾，采亦端阳。治诸般风劳，止遍身疼痛。"}]},{"ID":"20240614105122-o7kpqzo","Type":"NodeParagraph","Properties":{"id":"20240614105122-o7kpqzo","updated":"20240614105122"},"Children":[{"Type":"NodeText","Data":"（谟）按∶艾叶，《本经》及诸注释悉云∶生于田野，类蒿复道者为佳，未尝以州土拘也。世俗反指此为野艾，至贱视之。端午节临，仅采悬户，辟疫而已。其治病症，遍求蕲州所产独茎、圆叶、背白、有芒者，称为艾之精英。倘有收藏，不吝价买。彼处仕宦，亦每采此。两京送人，重纸包封，以示珍贵。名益传远，四方尽闻。今以形状考之，九牛草者即此。人多不识，并以艾呼。经注明云∶气虽艾香，实非艾种。医用作炷，以灸风湿痹疼、痨热积聚。尝获效者，亦因辛窜可以通利关窍而已。谓之全胜真艾，未必能然。大抵人之常情，贵远贱近。泥于习俗，胶固不移。纵有《本经》之文，诸家之注，何尝着一目视，以为真伪之别耶？噫！可胜叹哉！可胜叹哉！"}]},{"ID":"20240614103119-ht0azf3","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-ht0azf3"}},{"ID":"20240614105112-jk3fzmn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105112-jk3fzmn","updated":"20240614105116"},"Children":[{"Type":"NodeText","Data":"艾叶《本草征要》"}]},{"ID":"20240614105112-ex9iqbo","Type":"NodeParagraph","Properties":{"id":"20240614105112-ex9iqbo","updated":"20240614105112"},"Children":[{"Type":"NodeText","Data":"味苦，性微温，无毒。入肺、脾、肝、肾四经。苦酒、香附为使。陈久者良。"}]},{"ID":"20240614105112-eu3vbpa","Type":"NodeParagraph","Properties":{"id":"20240614105112-eu3vbpa","updated":"20240614105112"},"Children":[{"Type":"NodeText","Data":"安胎气，暖子宫。止血痢，理肠风。灸除百病，吐衄崩中。"}]},{"ID":"20240614105112-yopeypb","Type":"NodeParagraph","Properties":{"id":"20240614105112-yopeypb","updated":"20240614105112"},"Children":[{"Type":"NodeText","Data":"幸可利窍，苦可疏通，故气血交"}]},{"ID":"20240614105112-3eh53o6","Type":"NodeParagraph","Properties":{"id":"20240614105112-3eh53o6","updated":"20240614105112"},"Children":[{"Type":"NodeText","Data":"艾性纯阳香燥，凡血燥生热者禁与。"}]},{"ID":"20240614103119-659gczh","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-659gczh"}},{"ID":"20240614105104-cd0qi8p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105104-cd0qi8p","updated":"20240614105108"},"Children":[{"Type":"NodeText","Data":"艾叶《医学入门》"}]},{"ID":"20240614105104-1xiybft","Type":"NodeParagraph","Properties":{"id":"20240614105104-1xiybft","updated":"20240614105104"},"Children":[{"Type":"NodeText","Data":"艾叶苦温最热中，霍乱腹心痛有功，杀虫调血和肝气，崩漏安胎暖子宫，生汁止痢并吐衄，实主壮阳明目瞳。"}]},{"ID":"20240614105104-02m5p3t","Type":"NodeParagraph","Properties":{"id":"20240614105104-02m5p3t","updated":"20240614105104"},"Children":[{"Type":"NodeText","Data":"艾灸百病，有惩创意，令人痛切自治。干熟者性温，无毒。辟外感风寒，温胃，止霍乱转筋，心腹痛，杀蛔虫，熏痔 ，利肝滞冷气作痛，调和血脉。治妇人崩漏带下，安胎倒产，子死腹中，产后泻血不止，暖子宫，令人有子。生捣汁，性寒有毒。治赤白痢、吐血、衄血、泻血及心腹恶气刺痛、毒发热气上冲发狂，或有疮出血者，端午日日未出时不语采，日干，陈久良者。《衍义》用艾捣筛去青渣，取白，入硫黄相和为炷，灸穴。"}]},{"ID":"20240614105104-w5rk7f4","Type":"NodeParagraph","Properties":{"id":"20240614105104-w5rk7f4","updated":"20240614105104"},"Children":[{"Type":"NodeText","Data":"实，主壮阳，助水脏，暖腰膝及子宫，明目，兼疗一切鬼邪毒瓦斯。治火眼，用艾烧令烟起，以碗盖之，候烟上碗成煤，取下用水调化，洗或点，更入黄连尤妙。"}]},{"ID":"20240614103119-szmrqvi","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-szmrqvi"}},{"ID":"20240614105047-h6dym2p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614105047-h6dym2p","updated":"20240614105054"},"Children":[{"Type":"NodeText","Data":"艾叶《证类本草》"}]},{"ID":"20240614105047-ldd1987","Type":"NodeParagraph","Properties":{"id":"20240614105047-ldd1987","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"味苦，微温，无毒。主灸百病。可作煎，止下痢，吐血，下部 疮，妇人漏血，利阴气，生肌肉，辟风寒，使人有子。一名冰台，一名医草。生田野。三月三日采，曝干。作煎勿令见风。"}]},{"ID":"20240614105047-jealqch","Type":"NodeParagraph","Properties":{"id":"20240614105047-jealqch","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶捣叶以灸百病，亦止伤血，汁又杀蛔虫，苦酒煎叶，疗癣甚良。唐本注云∶《别录》云，艾，生寒熟热。主下血，衄血，脓血痢。水煮及丸散任用。臣禹锡等谨按药性论云∶艾叶，使。能止崩血，安胎，止腹痛。醋煎作煎，治癣，止赤白痢及五脏痔泻血。煎叶，主吐血。实，主明目，疗一切鬼气。初生取作干菜食之。又除鬼气。炒艾作馄饨，吞三、五枚，以饭压之良。长服止冷痢。又心腹恶气，取叶捣汁饮。又捣末和干姜末为丸，一服三十丸，饭压，日再服。治一切冷气，鬼邪毒瓦斯，最去恶气。孟诜云∶艾实与干姜为末，蜜丸。"}]},{"ID":"20240614105047-29gc6ea","Type":"NodeParagraph","Properties":{"id":"20240614105047-29gc6ea","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"消一切冷气。田野人尤与相当。日华子云∶止霍乱转筋，治心痛，鼻洪，并带下及患痢人后分寒热急痛。和蜡并诃子烧熏，神验。艾实，暖，无毒。壮阳助水脏，腰膝及暖子宫。"}]},{"ID":"20240614105047-psxtga7","Type":"NodeParagraph","Properties":{"id":"20240614105047-psxtga7","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"图经曰∶艾叶，旧不着所出州土，但云生田野，今处处有之，以复道者为佳。云此种灸百病尤胜。初春布地生苗，茎类蒿而叶背白，以苗短者为佳。三月三日、五月五日，采叶，曝干。经陈久方可用。俗间亦生捣叶取汁饮，止心腹恶气。古方亦用熟艾拓金疮。又中风掣痛，不仁不随。并以干艾斛许，揉团之，纳瓦甑中，并下塞诸孔，独留一目，以痛处着甑目下，烧艾一时久知矣。又治癞，取干艾随多少以浸面，酿酒如常法，饮之，觉痹即瘥。近世亦有单服艾者，或用蒸木瓜丸之，或作汤，空腹饮之，甚补虚羸。然亦有毒，其毒发则热气冲上，狂躁不能禁，至攻眼有疮出血者，诚不可妄服也。"}]},{"ID":"20240614105047-ul0bzan","Type":"NodeParagraph","Properties":{"id":"20240614105047-ul0bzan","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"食疗云干者并煎者，金疮，崩中，霍乱，止胎漏。春初采，为可干饼子。入生姜煎服，止泻痢。三月三日可采作煎，甚治冷。若患冷气，取熟艾面裹作馄饨，可大如弹许。又治百恶气。取其子，和干姜捣作末，蜜丸如梧子大。空心三十丸服，以饭三、五匙压之，日再服。其鬼神速走出，颇消一切冷血。田野之人与此方相宜也。又，产后泻血不止。取干艾叶半两炙熟，老生姜半两，浓煎汤，一服便止。妙。外台秘要∶治霍乱吐下不止。艾一把，水三升，煮取一升，顿服。又方∶治诸骨鲠。生艾蒿数升，水、酒共一斗，煮取四升，稍稍饮之良。"}]},{"ID":"20240614105047-h0yb39q","Type":"NodeParagraph","Properties":{"id":"20240614105047-h0yb39q","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"肘后方∶鬼击之病，得之无渐，卒着人如刀刺状，胸胁腹内 刺切痛，不可抑按，或即吐血，鼻中出血，下血。一名鬼排。以熟艾如鸡子三枚，水五升，煎取二升，顿服之。又方∶治卒心痛。白熟艾成熟者一升，以水三升，煮取一升，去滓，顿服。若为客气所中者，当吐虫物。又方∶治去滓，顿服，取汗。又方∶治病患齿无色，舌上白，或喜睡，不知痛痒处，或下痢，急治下部。不晓此者，但攻其上，不以为意，下部生虫，食其肛，烂见五脏，便死。烧艾于管中，熏下部，令烟入，更入少雄黄良。葛氏方治蛔虫，或心如刺，口吐清水。捣生艾取汁，宿勿食，但取肥香脯一方寸片先吃，令虫闻香，然后即饮一升，当下蛔。又方∶妊娠卒胎动不安，或但腰痛，或胎转抢心，或下血不止。艾叶一鸡子大，以酒四升煮取二升，分为二服，良。经验方∶治喉痹。"}]},{"ID":"20240614105047-yunflhh","Type":"NodeParagraph","Properties":{"id":"20240614105047-yunflhh","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"青艾和茎叶一握，用醋捣敷痹上，若冬月，取干艾亦得。李亚传。又方∶王峡州传野鸡痔病方，用槐柳汤洗，便以艾灸其上七壮，以知为度。王及郎中充西川安抚判官，乘骡入洛谷，数日而痔，病因是大作，如胡 贯于肠头，其热如煨火，至一驿，僵仆，无计。"}]},{"ID":"20240614105047-nmmm4uy","Type":"NodeParagraph","Properties":{"id":"20240614105047-nmmm4uy","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"有主邮者云∶须灸即瘥。及命所使为槐柳汤热洗 上。因用艾灸三、五壮，忽觉一道热气盛入肠中，因大转泻，鲜血秽物一时出，至楚痛，泻后遂失胡 所在。孙真人粪后有血。浓煎艾叶、生姜汁，三门方治火眼。用艾烧令烟起，以碗盖之，候烟上碗成煤取下，用温水调化洗火眼，即瘥。更入黄连甚妙。又方∶治癫痫。"}]},{"ID":"20240614105047-vgtxpnk","Type":"NodeParagraph","Properties":{"id":"20240614105047-vgtxpnk","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"用艾于阴囊下谷道正门当中间，随年岁灸之。胜金方不透风，一头以艾灸之七壮。"}]},{"ID":"20240614105047-puhvacc","Type":"NodeParagraph","Properties":{"id":"20240614105047-puhvacc","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"患右灸左，患左灸右。耳痛亦灸得。初虞世治妇人崩中连日不止。熟艾鸡子大，阿胶炒为末半两，干姜一钱锉，右以水五盏先煮艾、姜至二盏半，入胶消扬，温分三服，空腹服，一日尽。兵部手集∶治发背头末成疮及诸热肿。以湿纸拓上，先干处是热气冲上，欲作疮子，便治误吞钱。取艾蒿一把细锉，用水五升，煎取一升，顿服便下。伤寒类要∶治妇人妊娠七月，若伤寒壮热，赤斑变为黑斑，溺血作罂，以竹筒如指大，一头坐罂缸中，一头纳下部孔中，以鸡子大艾一团烧之，以泥作罂口吹之，常令艾烟熏下部，强人可益久，良。子母秘录胎动上迫心痛。取艾叶如鸡子大，以头醋四升，煎取二升，分温服。又方∶治倒产子死腹中。艾叶半斤，酒四升，煮取一升服。又方∶小儿黄烂疮。烧艾叶灰敷上。荆楚岁时记端午，四民踏百草，采艾以为人悬之户上穣毒瓦斯。"}]},{"ID":"20240614105047-kdfcm9v","Type":"NodeParagraph","Properties":{"id":"20240614105047-kdfcm9v","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"又宗士炳之孙，常以端午日，鸡未鸣时采似人者，缚用灸有验。"}]},{"ID":"20240614105047-hxvm816","Type":"NodeParagraph","Properties":{"id":"20240614105047-hxvm816","updated":"20240614105047"},"Children":[{"Type":"NodeText","Data":"衍义曰∶艾叶，干捣，筛去青滓，取白，入石硫黄，为硫黄艾，灸家用。得米粉少许，可捣为末，入服食药。入硫黄别有法。"}]},{"ID":"20240614103119-5l1o25a","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-5l1o25a"}},{"ID":"20240614104144-xs83wip","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614104144-xs83wip","updated":"20240614104148"},"Children":[{"Type":"NodeText","Data":"艾叶《本草从新》"}]},{"ID":"20240614104144-9n6p3cl","Type":"NodeParagraph","Properties":{"id":"20240614104144-9n6p3cl","updated":"20240614104144"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣理气血、燥逐寒热．"}]},{"ID":"20240614104144-a2rr1m0","Type":"NodeParagraph","Properties":{"id":"20240614104144-a2rr1m0","updated":"20240614104144"},"Children":[{"Type":"NodeText","Data":"苦辛．生温熟热．纯阳之性．能回垂绝之元阳．通十二经．走三阴．（太、少、厥．）理气血．逐寒湿．暖子宫．止诸血．温中开郁．调经安胎．（胎动腰痛下血、胶艾汤良、胶艾煎服、亦治虚痢．）治吐衄崩带．（治带要药．）腹痛冷痢．血痢．霍乱转筋．杀蛔治癣．（醋煎服、外科有用干艾作汤、投白矾二三钱、洗疮、然后敷药、盖人气血冷、必假艾力以佐阳、而艾性又能杀虫也．）以之灸火．能透诸经而除百病．（丹田气弱、脐腹冷者、以熟艾装袋气亦宜、以此夹入袜内．）纯阳香燥．凡血燥生热者．禁与灸火．"}]},{"ID":"20240614104144-1wgvbz5","Type":"NodeParagraph","Properties":{"id":"20240614104144-1wgvbz5","updated":"20240614104144"},"Children":[{"Type":"NodeText","Data":"亦大伤阴血．虚者宜慎．陈久者良．揉捣如绵．谓之熟艾．灸火用．妇人丸散．醋煮捣饼．"}]},{"ID":"20240614104144-jmruxt0","Type":"NodeParagraph","Properties":{"id":"20240614104144-jmruxt0","updated":"20240614104144"},"Children":[{"Type":"NodeText","Data":"再为末用．（入茯苓数片同研、则易细．）煎服宜鲜者．醋、香附为使．（艾附丸、调妇人诸病、宋时重汤阴艾、自明成化来、则以蕲州艾为胜、云灸酒坛、一灸便透、蒙筌、发明、并以野艾为真蕲艾、虽香、实非艾种、今人多以蓬蒿伪蕲艾．）"}]},{"ID":"20240614103119-17rkv9i","Type":"NodeThematicBreak","Properties":{"id":"20240614103119-17rkv9i"}},{"ID":"20240614104134-1lpihjo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614104134-1lpihjo","updated":"20240614104138"},"Children":[{"Type":"NodeText","Data":"艾叶《本草求真》"}]},{"ID":"20240614104134-u7e0f8u","Type":"NodeParagraph","Properties":{"id":"20240614104134-u7e0f8u","updated":"20240614104134"},"Children":[{"Type":"NodeText","Data":"（隰草）除沉寒痼冷起阳气将绝"}]},{"ID":"20240614104134-6g7a8wy","Type":"NodeParagraph","Properties":{"id":"20240614104134-6g7a8wy","updated":"20240614104134"},"Children":[{"Type":"NodeText","Data":"艾叶（专入肝脾。兼入肾。）辛苦性温。其气芳烈纯阳。故可用以取火。服之则走肝脾与肾。能除沉寒痼冷。凡一切病因寒湿而见血衄崩带。腹痛冷痢。霍乱转筋。胎动腰痛。气郁经水不调。子宫虚冷。虫动疮疥者。（诸症俱就寒湿论。）服之能立见效。（故治亦就寒湿起见。）"}]},{"ID":"20240614104134-oppf6lc","Type":"NodeParagraph","Properties":{"id":"20240614104134-oppf6lc","updated":"20240614104134"},"Children":[{"Type":"NodeText","Data":"若其阳气将绝之候。灸之即能回阳。且能通诸经以治百病。（百病亦就寒湿论。汪昂曰。艾用火炎则气下。入药则热气上冲。）故古方有同阿胶以治虚痢。及胎前后下血。同香附制丸。以调经血而温子宫。兼除心腹诸痛。同干姜以蜜为丸。以除冷恶鬼邪诸气。（亦寒湿阴气。）"}]},{"ID":"20240614104134-yjinita","Type":"NodeParagraph","Properties":{"id":"20240614104134-yjinita","updated":"20240614104134"},"Children":[{"Type":"NodeText","Data":"同白矾为末。以治疮疥。又以熟艾布兜。以治寒湿香港脚及老人脐腹畏冷。用绢裹以擦风瘙瘾疹。皆取辛温则散之义。若使症非寒湿。而用是药燥烈以治。其失匪轻。（每见今人安胎。不审寒热虚实。辄用艾叶以投。殊为荒谬。）是以书载气虚血热者禁用。（包尽多少病症。）"}]},{"ID":"20240614104134-a8xwxjx","Type":"NodeParagraph","Properties":{"id":"20240614104134-a8xwxjx","updated":"20240614104134"},"Children":[{"Type":"NodeText","Data":"取蕲州艾陈者良。揉捣如绵。谓之熟艾。灸火用。妇人丸散。醋煮捣饼。再为末用。煎服生用。（生用则温。熟用则热。）苦酒香附为使。"}]},{"ID":"20240614103120-3fj6ars","Type":"NodeThematicBreak","Properties":{"id":"20240614103120-3fj6ars"}},{"ID":"20240614104124-ed0i5k5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614104124-ed0i5k5","updated":"20240614104128"},"Children":[{"Type":"NodeText","Data":"艾叶《长沙药解》"}]},{"ID":"20240614104124-136xfac","Type":"NodeParagraph","Properties":{"id":"20240614104124-136xfac","updated":"20240614104124"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】白蒿。味甘平。主五脏邪气，风寒温痹，补中益气，长毛发，令黑，疗心悬，少食，常饥。久服轻身，耳目聪明，不老。生川泽。"}]},{"ID":"20240614104124-t92oxpt","Type":"NodeParagraph","Properties":{"id":"20240614104124-t92oxpt","updated":"20240614104124"},"Children":[{"Type":"NodeText","Data":"味苦、辛，气温，入足厥阴肝经。燥湿除寒，温经止血。"}]},{"ID":"20240614104124-pq0fd2w","Type":"NodeParagraph","Properties":{"id":"20240614104124-pq0fd2w","updated":"20240614104124"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柏叶汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在柏叶。"},{"Type":"NodeText","Data":"用之治吐血不止，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胶艾汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在阿胶。"},{"Type":"NodeText","Data":"用之治胞阻漏血，以其温经而止血也。"}]},{"ID":"20240614104124-yecrcsh","Type":"NodeParagraph","Properties":{"id":"20240614104124-yecrcsh","updated":"20240614104124"},"Children":[{"Type":"NodeText","Data":"血生于肝，敛于肺，升于脾，降于胃，行于经络，而统于中气。中气旺则肝脾左升而不下泄，肺胃右降而不上溢。中气虚败，肺胃逆升，则上流于鼻口，肝脾下陷，则下脱于便溺。盖血以阴质而含阳气，其性温暖而孕君火，温则流行而条畅，寒则凝瘀而梗涩。瘀而不行，则为癥瘕，瘀而未结，则经脉莫容，势必外脱。肺胃之阳虚，则逆流而不降，肝脾之阳虚，则陷泄而不升。肺胃之逆，非无上热，肝脾之陷，非无下热，而究其根原，全缘于中下之湿寒。"}]},{"ID":"20240614104124-84hjd3o","Type":"NodeParagraph","Properties":{"id":"20240614104124-84hjd3o","updated":"20240614104124"},"Children":[{"Type":"NodeText","Data":"艾叶和煦通畅，逐湿除寒，暖补血海，而调经络。瘀涩既开，循环如旧，是以善于止血，而治疮疡。其诸主治，止吐衄便尿、胎产崩带、淋沥痔漏、刀箭跌损诸血，治发背、痈疽、疔毒、疳疮、臁疮、风癞、疥癣诸疮，除咽喉、牙齿、眼目、心腹诸痛，灭皯黯，落赘疣，调胎孕，扫虫（匿/虫虫）。"}]},{"ID":"20240614103120-unxqb6q","Type":"NodeThematicBreak","Properties":{"id":"20240614103120-unxqb6q"}},{"ID":"20240614104055-twwl7ue","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614104055-twwl7ue","updated":"20240614104102"},"Children":[{"Type":"NodeText","Data":"艾叶《本草害利》"}]},{"ID":"20240614104055-9mhmi93","Type":"NodeParagraph","Properties":{"id":"20240614104055-9mhmi93","updated":"20240614104055"},"Children":[{"Type":"NodeText","Data":"〔害〕纯阳香燥，凡血燥生热者，禁用。与炙火，亦大损阴血，虚者宜慎。胎动不安，由于热而不由于寒；妊娠下利脓血，由于暑湿；肠胃热甚，而非单湿为病；崩中由于血虚内热；"}]},{"ID":"20240614104055-fh00xiy","Type":"NodeParagraph","Properties":{"id":"20240614104055-fh00xiy","updated":"20240614104055"},"Children":[{"Type":"NodeText","Data":"经事先期，由于血热；吐衄血由于血虚；火旺由于鬼击中恶；霍乱转筋，不由于寒邪，而由于脾胃虚弱凝滞，或于暑湿所致；不孕由于血虚，而不由风冷袭入子宫者，法并忌用。"}]},{"ID":"20240614104055-qku0fqu","Type":"NodeParagraph","Properties":{"id":"20240614104055-qku0fqu","updated":"20240614104055"},"Children":[{"Type":"NodeText","Data":"〔利〕生温熟热，辛可利窍，苦能舒通，入肺、脾、肝、肾四经，气血交理。安胎气，暖子宫，故妇科带下调经多需之。理血痢肠风，治崩吐衄，外用灸除百病，陈者良。醋香附为使。"}]},{"ID":"20240614104055-u1h82z7","Type":"NodeParagraph","Properties":{"id":"20240614104055-u1h82z7","updated":"20240614104055"},"Children":[{"Type":"NodeText","Data":"〔修治〕三月三日，五月五日，采叶干曝，揉捣如绵，谓之熟艾，陈久者可用。蕲州艾为上，煎服宜鲜者。生用，或烧成炭。入女科丸，醋煮捣成饼子烘干，再捣为末用。"}]},{"ID":"20240614103120-kmi120b","Type":"NodeThematicBreak","Properties":{"id":"20240614103120-kmi120b"}},{"ID":"20240614103145-4gfxjdg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614103145-4gfxjdg","updated":"20240614103949"},"Children":[{"Type":"NodeText","Data":"艾叶《本草新编》"}]},{"ID":"20240614103145-nlqm5sy","Type":"NodeParagraph","Properties":{"id":"20240614103145-nlqm5sy","updated":"20240614103145"},"Children":[{"Type":"NodeText","Data":"艾叶，味苦，气温，阴中之阳，无毒。世人俱以蕲艾为佳。然野艾佳于蕲艾。盖蕲艾乃九牛草也，似艾而非艾，唯香过于艾，而功用殊不若野艾。入脾、肾、肺三经。祛寒气而逐湿痹，安疼痛而暖关元。胎漏可止，胎动可安，月经可调，子宫可孕，且炙经穴，可愈百病，无如世人舍近而求远，舍贱求贵，为可叹耳。"}]},{"ID":"20240614103145-fy294ds","Type":"NodeParagraph","Properties":{"id":"20240614103145-fy294ds","updated":"20240614103145"},"Children":[{"Type":"NodeText","Data":"或问艾叶，取野而不取蕲，前人已论之，但未言野艾之何以佳于蕲艾耳？夫蕲艾依种而生者，野艾则天然自长于野者也，得天地至阳之气，故能逐鬼而辟邪，祛寒而散湿，其功实胜于蕲艾药，何舍此而取彼哉。十年之疾，求三年之艾，大抵即野艾，非取乎蕲也。但野艾实妙，余启冠而肩膊患风痛，用野艾而愈。"}]},{"ID":"20240614103120-vh41iat","Type":"NodeThematicBreak","Properties":{"id":"20240614103120-vh41iat"}},{"ID":"20240614103122-n5gpe8v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614103122-n5gpe8v","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：艾叶"}]},{"ID":"20240614103122-bqk4rds","Type":"NodeParagraph","Properties":{"id":"20240614103122-bqk4rds","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614103122-z7x9s9x","Type":"NodeParagraph","Properties":{"id":"20240614103122-z7x9s9x","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" ài Yè"}]},{"ID":"20240614103122-cf50qmn","Type":"NodeParagraph","Properties":{"id":"20240614103122-cf50qmn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614103122-pywwjrn","Type":"NodeParagraph","Properties":{"id":"20240614103122-pywwjrn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 艾、艾蒿、家艾"}]},{"ID":"20240614103122-hpafv3i","Type":"NodeParagraph","Properties":{"id":"20240614103122-hpafv3i","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614103122-f8hu5z7","Type":"NodeParagraph","Properties":{"id":"20240614103122-f8hu5z7","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" FOLIUM ARTEMISIAE ARGYI"}]},{"ID":"20240614103122-muk8arx","Type":"NodeParagraph","Properties":{"id":"20240614103122-muk8arx","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614103122-xifwv96","Type":"NodeParagraph","Properties":{"id":"20240614103122-xifwv96","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艾"},{"Type":"NodeText","Data":"Artemisia argyi Levl. et Vant. 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干燥叶"},{"Type":"NodeText","Data":"。夏季花未开时采摘，除去杂质，晒干。"}]},{"ID":"20240614103122-m7x4kgd","Type":"NodeParagraph","Properties":{"id":"20240614103122-m7x4kgd","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614103122-3mdwau2","Type":"NodeParagraph","Properties":{"id":"20240614103122-3mdwau2","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 本品多皱缩、破碎，有短柄。完整叶片展平后呈卵状椭圆形，羽状深裂，裂片椭圆状披针形，边缘有不规则的粗锯齿，上表面灰绿色或深黄绿色，有稀疏的柔毛及腺点；下表面密生灰白色绒毛。质柔软。气清香，味苦。"}]},{"ID":"20240614103122-z45eqpt","Type":"NodeParagraph","Properties":{"id":"20240614103122-z45eqpt","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614103122-xcl0d6a","Type":"NodeParagraph","Properties":{"id":"20240614103122-xcl0d6a","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240614103122-54fphcr","Type":"NodeParagraph","Properties":{"id":"20240614103122-54fphcr","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614103122-mbrtghq","Type":"NodeParagraph","Properties":{"id":"20240614103122-mbrtghq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"醋艾炭"},{"Type":"NodeText","Data":"（艾叶炭）:取净艾叶，在锅内炒至大部分成焦黑色，喷米醋，拌匀后取出稍筛；也可喷洒清水扑灭火星，取出晾干，防止复燃。每100kg艾叶，用醋15kg。"}]},{"ID":"20240614103122-uw7ripz","Type":"NodeParagraph","Properties":{"id":"20240614103122-uw7ripz","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614103122-iqrger5","Type":"NodeParagraph","Properties":{"id":"20240614103122-iqrger5","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 本品粉末绿褐色。非腺毛有两种：一种为Ｔ字形毛，顶端细胞长而弯曲，两臂不等长，柄2～4细胞；另一种为单列性非腺毛，3～5细胞，顶端细胞特长而扭曲，常断落。腺毛表面观鞋底形，由 4、6 细胞相对叠合而成，无柄。草酸钙簇晶，直径3～7μm,存在于叶肉细胞中。"}]},{"ID":"20240614103122-zoxaeth","Type":"NodeParagraph","Properties":{"id":"20240614103122-zoxaeth","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614103122-dbe028l","Type":"NodeParagraph","Properties":{"id":"20240614103122-dbe028l","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 归肝、脾、肾经。"}]},{"ID":"20240614103122-b3dawr8","Type":"NodeParagraph","Properties":{"id":"20240614103122-b3dawr8","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614103122-e95owaz","Type":"NodeParagraph","Properties":{"id":"20240614103122-e95owaz","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 辛、苦，温；有小毒。"}]},{"ID":"20240614103122-4s6ddit","Type":"NodeParagraph","Properties":{"id":"20240614103122-4s6ddit","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614103122-gat0tvn","Type":"NodeParagraph","Properties":{"id":"20240614103122-gat0tvn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 散寒止痛，温经止血。用于少腹冷痛，经寒不调，宫冷不孕，吐血，衄血，崩漏经多，妊娠下血；外治皮肤瘙痒。醋艾炭温经止血。用于虚寒性出血。"}]},{"ID":"20240614103122-c4lb2dk","Type":"NodeParagraph","Properties":{"id":"20240614103122-c4lb2dk","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614103122-mo1xagg","Type":"NodeParagraph","Properties":{"id":"20240614103122-mo1xagg","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 3～9g。外用适量，供灸治或熏洗用。"}]},{"ID":"20240614103122-ecg2yud","Type":"NodeParagraph","Properties":{"id":"20240614103122-ecg2yud","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614103122-vdr3kkt","Type":"NodeParagraph","Properties":{"id":"20240614103122-vdr3kkt","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" （1）本品捣烂如绒，制成艾卷、艾柱，可做灸法之用。"}]},{"ID":"20240614103122-q0lzvez","Type":"NodeParagraph","Properties":{"id":"20240614103122-q0lzvez","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"（2）口服大量艾叶制剂后，约半小时即出现中毒症状：喉干口渴，胃肠不适，恶心，呕吐，继而全身无力，头晕耳鸣，四肢震颤乃至痉挛（中枢神经系统高度兴奋引起），痉挛发作后全身肌肉弛缓，缺乏张力，甚至瘫痪。由于神经反射及血管本身受损，可招致子宫充血、出血，孕妇甚至流产。亦可引起肝细胞代谢障碍，而致中毒性黄疸和肝炎。由于主要作用于中枢神经系统，痊愈后亦常有健忘，幻觉等后遗症。慢性中毒者则有感觉过敏、共济失调、幻想、神经炎、癫痫样痉挛等症状出现。"}]},{"ID":"20240614103122-ehtyo2f","Type":"NodeParagraph","Properties":{"id":"20240614103122-ehtyo2f","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"（3）如遇口服中毒者，首先清洗胃肠道，用骨炭粉吸收，并置病人于安静及光线较暗之房内，避免外来刺激，给予镇静剂，保护肝脏机能，以及其他一般内科常规对症治疗。"}]},{"ID":"20240614103122-ln8hhb5","Type":"NodeParagraph","Properties":{"id":"20240614103122-ln8hhb5","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614103122-gtqviv0","Type":"NodeParagraph","Properties":{"id":"20240614103122-gtqviv0","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614103122-6w3rmrl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614103122-6w3rmrl","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：艾叶"}]},{"ID":"20240614103122-8bfyums","Type":"NodeParagraph","Properties":{"id":"20240614103122-8bfyums","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614103122-mmx0qqa","Type":"NodeParagraph","Properties":{"id":"20240614103122-mmx0qqa","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" ài Yè"}]},{"ID":"20240614103122-5wwokff","Type":"NodeParagraph","Properties":{"id":"20240614103122-5wwokff","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614103122-8zly70n","Type":"NodeParagraph","Properties":{"id":"20240614103122-8zly70n","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 艾（《诗经》），又名：冰台（《尔稚》），艾蒿（《尔雅》郭璞注），医草（《别录》），灸草（《埤雅》），蕲艾（《蕲艾传》），黄草（《纲目》），家艾（《医林纂要》），甜艾（《本草求原》），草蓬、艾蓬、狼尾蒿子、香艾、野莲头、阿及艾。"}]},{"ID":"20240614103122-o3ab8jq","Type":"NodeParagraph","Properties":{"id":"20240614103122-o3ab8jq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614103122-itzy3gm","Type":"NodeParagraph","Properties":{"id":"20240614103122-itzy3gm","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240614103122-hmqq3po","Type":"NodeParagraph","Properties":{"id":"20240614103122-hmqq3po","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614103122-q42azk1","Type":"NodeParagraph","Properties":{"id":"20240614103122-q42azk1","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艾"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干燥叶"},{"Type":"NodeText","Data":"。春、夏二季，花未开、叶茂盛时采摘，晒干或阴干。"}]},{"ID":"20240614103122-5lookf9","Type":"NodeParagraph","Properties":{"id":"20240614103122-5lookf9","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614103122-2g1mbag","Type":"NodeParagraph","Properties":{"id":"20240614103122-2g1mbag","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 生长于路旁、草地、荒野等处。亦有栽培者。分布黑龙江、吉林、辽宁、河北、山东、安徽、江苏、浙江、广东、广西、江西、湖南、湖北、四川、贵州、云南、陕西、甘肃等地。 全国大部分地区多有生产。"}]},{"ID":"20240614103122-vgpaxz1","Type":"NodeParagraph","Properties":{"id":"20240614103122-vgpaxz1","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614103122-lz5ifjw","Type":"NodeParagraph","Properties":{"id":"20240614103122-lz5ifjw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高45～120厘米。茎直立，圆形，质硬，基部木质化，被灰白色软毛，从中部以上分枝。单叶，互生；茎下部的叶在开花时即枯萎；中部叶具短柄，叶片卵状椭圆形，羽状深裂，裂片椭圆状披针形，边缘具粗锯齿，上面暗绿色，稀被白色软毛，并密布腺点，下面灰绿色，密被灰白色绒毛；近茎顶端的叶无柄，叶片有时全缘完全不分裂，披针形或线状披针形。花序总状，顶生，由多数头状花序集合而成；总苞苞片4～5层，外层较小，卵状披针形，中层及内层较大，广椭圆形，边缘膜质，密被绵毛；花托扁平，半球形，上生雌花及两性花10余朵；雌花不甚发育，长约1厘米，无明显的花冠；两性花与雌花等长，花冠筒状，红色，顶端5裂；雄蕊5枚，聚药，花丝短，着生于花冠基部；花柱细长，顶端2分叉，子房下位，1室。瘦果长圆形。花期7～10月。"}]},{"ID":"20240614103122-6qqkflg","Type":"NodeParagraph","Properties":{"id":"20240614103122-6qqkflg","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614103122-h5a8qry","Type":"NodeParagraph","Properties":{"id":"20240614103122-h5a8qry","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 干燥的叶片，多皱缩破碎，有短柄.叶片略呈羽状分裂，裂片边缘有不规则的粗锯齿。上面灰绿色，生有软毛，下面密生灰白色绒毛。质柔软。气清香，味微苦辛。以下面灰白色、绒毛多、香气浓郁者为佳。"}]},{"ID":"20240614103122-kltgk3y","Type":"NodeParagraph","Properties":{"id":"20240614103122-kltgk3y","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614103122-cmdcrqc","Type":"NodeParagraph","Properties":{"id":"20240614103122-cmdcrqc","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 含挥发油，油中主要为Ⅰ，8-桉叶精、α-侧柏酮（α-thujone）、α-水芹烯（α-phellandrene）、β-丁香烯（β-caryophyllene）、莰烯、樟脑、藏茴香酮、反式苇醇（transcarveol）、Ⅰ-α-松油醇（Ⅰ-α-terpineol）。"}]},{"ID":"20240614103122-url5tgj","Type":"NodeParagraph","Properties":{"id":"20240614103122-url5tgj","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614103122-p1it8q3","Type":"NodeParagraph","Properties":{"id":"20240614103122-p1it8q3","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艾叶"},{"Type":"NodeText","Data":"：拣去杂质，去梗，筛去灰屑。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艾绒"},{"Type":"NodeText","Data":"：取晒干净艾叶碾碎成绒，拣去硬茎及叶柄，筛去灰屑。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"艾炭"},{"Type":"NodeText","Data":"：取净艾叶置锅内用武火炒至七成变黑色，用醋喷洒，拌匀后过铁丝筛，未透者重炒，取出，晾凉，防止复燃，三日后贮存。（每艾叶100斤，用醋15斤）"}]},{"ID":"20240614103122-8nnzliq","Type":"NodeParagraph","Properties":{"id":"20240614103122-8nnzliq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"①《本草衍义》：\"干捣筛去青滓，取白，入石硫黄，为硫黄艾，灸家用。得米粉少许，可捣为末，入服食药。\""}]},{"ID":"20240614103122-hnqrjnt","Type":"NodeParagraph","Properties":{"id":"20240614103122-hnqrjnt","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"凡用艾叶，须用陈久者，治令细软，谓之熟艾，若生艾灸火，则伤人肌脉。拣取净叶，扬去尘屑，入石臼内木杵捣熟，罗去渣滓，取白者再捣，至柔烂如绵为度，用时焙燥，则灸火得力。入妇人丸散，须以熟艾，用醋煮干捣成饼子，烘干再捣为末用，或以糯糊和作饼，及酒炒者皆不佳。洪氏《容斋随笔》云，艾难著力，若入白茯苓三、五片同碾，即时可作细末，亦一异也。\""}]},{"ID":"20240614103122-jzbh7dh","Type":"NodeParagraph","Properties":{"id":"20240614103122-jzbh7dh","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614103122-wnmfxeg","Type":"NodeParagraph","Properties":{"id":"20240614103122-wnmfxeg","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 入脾、肝、肾经。"}]},{"ID":"20240614103122-o5p7hwe","Type":"NodeParagraph","Properties":{"id":"20240614103122-o5p7hwe","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入足太阴、蹶阴、少阴经。\""}]},{"ID":"20240614103122-v4nok08","Type":"NodeParagraph","Properties":{"id":"20240614103122-v4nok08","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入脾、肾、肺三经。\""}]},{"ID":"20240614103122-pjyabji","Type":"NodeParagraph","Properties":{"id":"20240614103122-pjyabji","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入心、肾二经。\""}]},{"ID":"20240614103122-uzg2fx1","Type":"NodeParagraph","Properties":{"id":"20240614103122-uzg2fx1","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614103122-ns8f1rg","Type":"NodeParagraph","Properties":{"id":"20240614103122-ns8f1rg","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 苦辛，温。"}]},{"ID":"20240614103122-48qz502","Type":"NodeParagraph","Properties":{"id":"20240614103122-48qz502","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味苦，微温，无毒。\""}]},{"ID":"20240614103122-x6tq172","Type":"NodeParagraph","Properties":{"id":"20240614103122-x6tq172","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"生寒，熟热。\""}]},{"ID":"20240614103122-qsn2uof","Type":"NodeParagraph","Properties":{"id":"20240614103122-qsn2uof","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"苦而辛，生温，熟热。\""}]},{"ID":"20240614103122-07z7lva","Type":"NodeParagraph","Properties":{"id":"20240614103122-07z7lva","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614103122-kd39jzk","Type":"NodeParagraph","Properties":{"id":"20240614103122-kd39jzk","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 阴虚血热者慎用。"}]},{"ID":"20240614103122-z6n35yh","Type":"NodeParagraph","Properties":{"id":"20240614103122-z6n35yh","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"苦酒、香附为之使。\""}]},{"ID":"20240614103122-9f1pab4","Type":"NodeParagraph","Properties":{"id":"20240614103122-9f1pab4","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②《本草备要》：\"血热为病者禁用。\""}]},{"ID":"20240614103122-agwt75m","Type":"NodeParagraph","Properties":{"id":"20240614103122-agwt75m","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"阴虚火旺，血燥生热，及宿有失血病者为禁。\""}]},{"ID":"20240614103122-zyqzj0s","Type":"NodeParagraph","Properties":{"id":"20240614103122-zyqzj0s","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614103122-acsg9eo","Type":"NodeParagraph","Properties":{"id":"20240614103122-acsg9eo","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 理气血，逐寒湿；温经，止血，安胎。治心腹冷痛，泄泻转筋，久痢，吐衄，下血，月经不调，崩漏，带下，胎动不安，痈疡，疥癣。"}]},{"ID":"20240614103122-jtpu431","Type":"NodeParagraph","Properties":{"id":"20240614103122-jtpu431","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主灸百病。可作煎，止下痢，吐血，下部匿疮，妇人漏血。利阴气，生肌肉，辟风寒，使人有子。\""}]},{"ID":"20240614103122-oyfq3ug","Type":"NodeParagraph","Properties":{"id":"20240614103122-oyfq3ug","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"捣叶以灸百病，亦止伤血。汁又杀蛔虫。苦酒煎叶疗癣。\""}]},{"ID":"20240614103122-vgmh1sg","Type":"NodeParagraph","Properties":{"id":"20240614103122-vgmh1sg","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"止崩血，安胎止腹痛。止赤白痢及五藏痔泻血。\"\"长服止冷痢。又心腹恶气，取叶捣汁饮。\""}]},{"ID":"20240614103122-zkmd6wn","Type":"NodeParagraph","Properties":{"id":"20240614103122-zkmd6wn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"主下血，衄血，脓血痢，水煮及丸散任用。\""}]},{"ID":"20240614103122-twfv3re","Type":"NodeParagraph","Properties":{"id":"20240614103122-twfv3re","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"金疮，崩中，霍乱，止胎漏。\""}]},{"ID":"20240614103122-7p9twv0","Type":"NodeParagraph","Properties":{"id":"20240614103122-7p9twv0","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑥《日华子本草》：\"止霍乱转筋，治心痛，鼻洪，并带下。\""}]},{"ID":"20240614103122-ien5u3b","Type":"NodeParagraph","Properties":{"id":"20240614103122-ien5u3b","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑦《珍珠囊》：\"温胃。\""}]},{"ID":"20240614103122-vaoas2a","Type":"NodeParagraph","Properties":{"id":"20240614103122-vaoas2a","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑧《履巉岩本草》：\"治咽喉闭痛热壅，饮食有妨者，捣汁灌漱。\""}]},{"ID":"20240614103122-x614au9","Type":"NodeParagraph","Properties":{"id":"20240614103122-x614au9","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑨《王好古》：\"治带脉为病，腹胀满，腰溶溶如坐水中。\""}]},{"ID":"20240614103122-p7y019a","Type":"NodeParagraph","Properties":{"id":"20240614103122-p7y019a","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑩《纲目》：\"温中，逐冷，除湿。\""}]},{"ID":"20240614103122-0fbi2wi","Type":"NodeParagraph","Properties":{"id":"20240614103122-0fbi2wi","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑾《本草正》：\"辟风寒涅，瘴疟。\""}]},{"ID":"20240614103122-4mab3f9","Type":"NodeParagraph","Properties":{"id":"20240614103122-4mab3f9","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑿《本草再新》：\"调经开郁，理气行血。治产后惊风，小儿脐疮。\""}]},{"ID":"20240614103122-pp7cqao","Type":"NodeParagraph","Properties":{"id":"20240614103122-pp7cqao","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614103122-nbp0yd4","Type":"NodeParagraph","Properties":{"id":"20240614103122-nbp0yd4","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；入丸、散或捣汁。外用：捣绒作炷或制成艾条熏灸，捣敷、煎水熏洗或炒热温熨。"}]},{"ID":"20240614103122-xziheio","Type":"NodeParagraph","Properties":{"id":"20240614103122-xziheio","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614103122-aeeif1e","Type":"NodeParagraph","Properties":{"id":"20240614103122-aeeif1e","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" ①治卒心痛：白艾成熟者三升，以水三升，煮取一升，去滓，顿服之。若为客气所中者，当吐出虫物。（《补缺肘后方》）"}]},{"ID":"20240614103122-nqvuddp","Type":"NodeParagraph","Properties":{"id":"20240614103122-nqvuddp","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②治脾胃冷痛：白艾末煎汤服二钱。（《卫生易简方》）"}]},{"ID":"20240614103122-uehhh4o","Type":"NodeParagraph","Properties":{"id":"20240614103122-uehhh4o","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"③治肠炎、急性尿道感染、膀胱炎：艾叶二钱，辣蓼二钱，车前一两六钱。水煎服，每天一剂，早晚各服一次。（江苏徐州《单方验方新医疗法选编》）"}]},{"ID":"20240614103122-g6p3uhf","Type":"NodeParagraph","Properties":{"id":"20240614103122-g6p3uhf","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"④治气痢腹痛，睡卧不安：艾叶（炒）、陈橘皮（汤浸去白，焙）等分。上二味捣罗为末，酒煮烂饭和丸，如梧桐子大。每服二十丸，空心。（《圣济总录》香艾丸）"}]},{"ID":"20240614103122-gbzc7g0","Type":"NodeParagraph","Properties":{"id":"20240614103122-gbzc7g0","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑤治湿冷下痢脓血，腹痛，妇人下血：干艾叶四两（炒焦存性），川白姜一两（炮）。上为末，醋煮面糊丸，如梧子大。每服三十丸，温米饮下。（《世医得效方》艾姜汤）"}]},{"ID":"20240614103122-v2lypkv","Type":"NodeParagraph","Properties":{"id":"20240614103122-v2lypkv","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑥治忽吐血一、二口，或心衄，或内崩：熟艾三鸡子许，水五升，煮二升服。（《千金方》）"}]},{"ID":"20240614103122-tu74d2h","Type":"NodeParagraph","Properties":{"id":"20240614103122-tu74d2h","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑦治鼻血不止：艾灰吹之，亦可以艾叶煎服。（《圣惠方》）"}]},{"ID":"20240614103122-m11f10d","Type":"NodeParagraph","Properties":{"id":"20240614103122-m11f10d","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑧治粪后下血：艾叶、生姜。煎浓汁，服三合。（《千金方》）"}]},{"ID":"20240614103122-dto86ku","Type":"NodeParagraph","Properties":{"id":"20240614103122-dto86ku","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑨治妇人崩中，连日不止：熟艾如鸡子大，阿胶（炒为末）半两，干姜一钱。水五盏，先煮艾、姜至二盏半，入胶烊化，分三服，空腹服，一日尽。（《养生必用方》）"}]},{"ID":"20240614103122-cp0df8f","Type":"NodeParagraph","Properties":{"id":"20240614103122-cp0df8f","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑩治功能性子宫出血，产后出血：艾叶炭一两，蒲黄、蒲公英各五钱。每日一剂，煎服二次。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240614103122-6i3lo4w","Type":"NodeParagraph","Properties":{"id":"20240614103122-6i3lo4w","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑾治妇人白带淋沥：艾叶（杵如绵，扬去尘末并梗，酒煮一周时）六两，白肃、苍术各三两（俱米泔水浸，晒干炒），当归身（酒炒）二两，砂仁一两。共为末，每早服三钱，白汤调下。（《本草汇言》）"}]},{"ID":"20240614103122-um0povf","Type":"NodeParagraph","Properties":{"id":"20240614103122-um0povf","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑿治妊娠卒眙动不安，或但腰痛，或胎转抢心，或下血不止：艾叶一鸡子大，以酒四升，煮取二升，分为二服。（《肘后方》）"}]},{"ID":"20240614103122-yu78zrd","Type":"NodeParagraph","Properties":{"id":"20240614103122-yu78zrd","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⒀治产后腹痛欲死，因感寒起者：陈蕲艾二斤，焙干，捣铺脐上，以绢覆住，熨斗熨之，待口中艾气出，则痛自止。（《杨诚经验方》）"}]},{"ID":"20240614103122-7fpftga","Type":"NodeParagraph","Properties":{"id":"20240614103122-7fpftga","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⒁治盗汗不止：熟艾二钱，白茯神三钱，乌梅三个。水一钟，煎八分，临卧温服。（《纲目》）"}]},{"ID":"20240614103122-zdmvpnl","Type":"NodeParagraph","Properties":{"id":"20240614103122-zdmvpnl","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⒂治痈疽不合，疮口冷滞：以北艾煎汤洗后，白胶熏之。（《仁斋直指方》）"}]},{"ID":"20240614103122-owcn2jw","Type":"NodeParagraph","Properties":{"id":"20240614103122-owcn2jw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⒃治头风面疮，痒出黄水：艾二两，醋一升，砂锅煎取汁，每薄纸上贴之，一日二、三上。（许国桢《御药院方》）"}]},{"ID":"20240614103122-vovlrgw","Type":"NodeParagraph","Properties":{"id":"20240614103122-vovlrgw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⒃治湿疹：艾叶炭、枯矾、黄柏等分。共研细末，用香油调膏，外敷。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240614103122-ir5e1gw","Type":"NodeParagraph","Properties":{"id":"20240614103122-ir5e1gw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240614103122-yar48n1","Type":"NodeParagraph","Properties":{"id":"20240614103122-yar48n1","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" ①治疗慢性肝炎"}]},{"ID":"20240614103122-hdrk03c","Type":"NodeParagraph","Properties":{"id":"20240614103122-hdrk03c","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"取艾叶制成注射液，每毫升相当于生药0.5克，每日肌注4毫升，总疗程1～2个月。治疗期间同时给予保肝药物。治疗123例，其中迁延性肝炎39例，近期治愈28例，显效6例，好转5例；慢性肝炎46例，近期治愈21例，显效19例，好转6例；肝硬化15例，显效3例，好转4例，无效8例。总有效率92％。"}]},{"ID":"20240614103122-wg5oxvl","Type":"NodeParagraph","Properties":{"id":"20240614103122-wg5oxvl","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"②治疗肺结核喘息症"}]},{"ID":"20240614103122-u65rz6g","Type":"NodeParagraph","Properties":{"id":"20240614103122-u65rz6g","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"用10％艾叶液每次30毫升，日服3次，食前半小时服用。临床观察37例，均同时内服异烟肼，3例并发肺原性心脏病的患者出现心力衰竭时，加用毒毛旋花子甙治疗，一般服艾叶液1～1.5月。31例经过上述治疗，气短及咳嗽减轻，喘鸣消失，痰量显著减少，肺部干、湿性罗音减少或消失；其余6例疗效较差或无效。经验证明，以对肺部无严重纤维增生或肺气种存在者效果较佳。"}]},{"ID":"20240614103122-jftgh57","Type":"NodeParagraph","Properties":{"id":"20240614103122-jftgh57","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"③治疗慢性气管炎"}]},{"ID":"20240614103122-6rewz8m","Type":"NodeParagraph","Properties":{"id":"20240614103122-6rewz8m","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"取干艾1斤或鲜艾2斤，洗净、切碎，放入4000毫升水中浸泡4～6小时，煎煮过滤，约得滤液3000毫升，加适量调味剂及防腐剂。日服3次，每次30～60毫升。或制成注射剂，每日2次，每次肌注2～4毫升。治疗154例，近期控制6例，显效21例，好转81例，无效46例。或用蒸馏法提取艾叶油，制成胶丸或糖衣片服用，每日量0.1～0.3毫升，分3～4次口服，10天为一疗程。治疗138例，一个疗程总有效率81.88％，近期控制加显效者占46.37％。还有每日用艾叶2两（干品），红糖5钱，加水煎成100毫升，分3～4次服，1周为一疗程。治疗484例，有效率76.1％。"}]},{"ID":"20240614103122-fx93nph","Type":"NodeParagraph","Properties":{"id":"20240614103122-fx93nph","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"④治疗急性菌痢"}]},{"ID":"20240614103122-opebwdr","Type":"NodeParagraph","Properties":{"id":"20240614103122-opebwdr","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"用20％艾叶煎剂，日服4次，每次40毫升，观察21例，均获治愈，平均住院5.5天。治疗过程中同时补充维生素乙、丙，个别病例给予输液。"}]},{"ID":"20240614103122-7xe1r4u","Type":"NodeParagraph","Properties":{"id":"20240614103122-7xe1r4u","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑤治疗间日疟"}]},{"ID":"20240614103122-ro2ktgp","Type":"NodeParagraph","Properties":{"id":"20240614103122-ro2ktgp","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"取干艾叶0.5～1两，切碎，用文火煎2小时左右，过滤，加糖，于发作前2小时顿服，连服2天。经治疗53例，控制症状的有效率在89％上下，血内疟原虫阴转率为56.2％.药液须现制现用，每日用1两的疗效较好。"}]},{"ID":"20240614103122-fokgmcx","Type":"NodeParagraph","Properties":{"id":"20240614103122-fokgmcx","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑥治疗钩蚴皮炎"}]},{"ID":"20240614103122-5jjjfc7","Type":"NodeParagraph","Properties":{"id":"20240614103122-5jjjfc7","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"在局部钩蚴感染24小时内，取直径1.5厘米的艾绒卷，熏烫钩蚴感染部。对于皮疹多而范围广的皮炎，将患部皮肤分区逐一熏烫5分钟。治疗106例，痒感消失者77例，仍有痒感者28例，奇痒者1例。患者一般于晚间艾熏后，即痒止入睡，次晨痒感消失。对照组60例未加治疗，痒感持续时间短则3～4天，长则5～6天，少数皮炎进展为红肿、水泡戒因抓破而溃烂。治疗组呼吸道症状（气急、咳嗽）的出现率为1.88％，对照组为14％。"}]},{"ID":"20240614103122-9399joi","Type":"NodeParagraph","Properties":{"id":"20240614103122-9399joi","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑦治疗妇女白带"}]},{"ID":"20240614103122-vfiixtn","Type":"NodeParagraph","Properties":{"id":"20240614103122-vfiixtn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"取艾叶5％煎汤去渣，鸡蛋2个放入汤内煮后吃蛋喝汤，连服5天。"}]},{"ID":"20240614103122-bd8660t","Type":"NodeParagraph","Properties":{"id":"20240614103122-bd8660t","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"⑧治疗寻常疣"}]},{"ID":"20240614103122-ltnm75x","Type":"NodeParagraph","Properties":{"id":"20240614103122-ltnm75x","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"采鲜艾叶擦拭局部，每日数次，至疣自行脱落为止。治疗12例，最短3天、最长10天即行脱落。"}]},{"ID":"20240614103122-ac3ztvj","Type":"NodeParagraph","Properties":{"id":"20240614103122-ac3ztvj","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614103122-paan28m","Type":"NodeParagraph","Properties":{"id":"20240614103122-paan28m","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 本植物的果实（艾实）亦供药用，另详专条。"}]},{"ID":"20240614103122-svo96mq","Type":"NodeParagraph","Properties":{"id":"20240614103122-svo96mq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野艾"},{"Type":"NodeText","Data":"，又名：火艾、五月艾。高45～100厘米。中部叶1～2回羽状分裂，裂片椭圆形、披针形至线形，全缘或有锯齿，叶上面无腺点，近秃净，下面被白色丝状毛；上部叶近乎无柄，裂片狭窄如线.花期9～10月。全国大部分地区有分布。其叶亦可作艾叶用。"}]},{"ID":"20240614103122-9pfmks9","Type":"NodeParagraph","Properties":{"id":"20240614103122-9pfmks9","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614103122-oow87wx","Type":"NodeParagraph","Properties":{"id":"20240614103122-oow87wx","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614103122-bvsrvad","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614103122-bvsrvad","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"《中华本草》：艾叶"}]},{"ID":"20240614103122-cfo0611","Type":"NodeParagraph","Properties":{"id":"20240614103122-cfo0611","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614103122-bbbww1i","Type":"NodeParagraph","Properties":{"id":"20240614103122-bbbww1i","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" ài Yè"}]},{"ID":"20240614103122-8meumdr","Type":"NodeParagraph","Properties":{"id":"20240614103122-8meumdr","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614103122-vqph6on","Type":"NodeParagraph","Properties":{"id":"20240614103122-vqph6on","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" Argy Wormwood Leaf, Ai Ye, Aiye, Argyi Leaf, Chinese mugwort leaf, Folium Artemisiae Argyi， Artemesia，ARTEMISIA ARGYI，Artemisia leaf，Artemisiae Argyi Folium，Chinese mugwort leaf，dried leaf of artemisi"}]},{"ID":"20240614103122-mfmzvl1","Type":"NodeParagraph","Properties":{"id":"20240614103122-mfmzvl1","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614103122-9uba4un","Type":"NodeParagraph","Properties":{"id":"20240614103122-9uba4un","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 出自1.《本草经集注》。"}]},{"ID":"20240614103122-h9743cu","Type":"NodeParagraph","Properties":{"id":"20240614103122-h9743cu","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：艾叶，生田野。三月采，暴干作煎，勿令见风。"}]},{"ID":"20240614103122-aktkcs6","Type":"NodeParagraph","Properties":{"id":"20240614103122-aktkcs6","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：艾叶，旧不着所出州土，但云生田野，今处处有之。以复道者为佳。云此种灸百病尤胜。初春布地生苗，茎类蒿而叶背白，以苗短者为佳。采叶暴干，经陈久方可用。"}]},{"ID":"20240614103122-d3hajy7","Type":"NodeParagraph","Properties":{"id":"20240614103122-d3hajy7","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：艾叶，《本草》不着土产，但云生田野，宋时以汤阴、复道者为佳，四明者图形，近代惟汤阴者谓之北艾，四明者谓之海艾。自成"}]},{"ID":"20240614103122-65eus68","Type":"NodeParagraph","Properties":{"id":"20240614103122-65eus68","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614103122-epxmrwc","Type":"NodeParagraph","Properties":{"id":"20240614103122-epxmrwc","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物艾的叶。"}]},{"ID":"20240614103122-9q6fo7l","Type":"NodeParagraph","Properties":{"id":"20240614103122-9q6fo7l","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Artemisia argyi Levl .et Vant. [A. argyi Levl. Et Vant. Var .incana Pamp.]"}]},{"ID":"20240614103122-feov2v3","Type":"NodeParagraph","Properties":{"id":"20240614103122-feov2v3","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"采收和储藏：培育当年9月，第2年6月花未开时割取地上部分，摘取叶片嫩梢，晒干。"}]},{"ID":"20240614103122-s2x3lvz","Type":"NodeParagraph","Properties":{"id":"20240614103122-s2x3lvz","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614103122-5e1gm81","Type":"NodeParagraph","Properties":{"id":"20240614103122-5e1gm81","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于荒地林缘。"}]},{"ID":"20240614103122-dvs5zja","Type":"NodeParagraph","Properties":{"id":"20240614103122-dvs5zja","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国大部分地区。"}]},{"ID":"20240614103122-awtjoas","Type":"NodeParagraph","Properties":{"id":"20240614103122-awtjoas","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614103122-tozqs9b","Type":"NodeParagraph","Properties":{"id":"20240614103122-tozqs9b","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 艾 多年生草本，高50-120cm。全株密被白色茸毛，中部以上或仅上部有开展及斜升的花序枝。叶互生，下部叶在花期枯萎；中部叶卵状三角形或椭圆形，长6-9cm，宽4-8cm，基部急狭或渐狭成短或稍长的柄，或稍扩大而成托叶状；叶片羽状或浅裂，侧裂片约2对，常楔形，中裂片又常三，裂片边缘有齿，上面被蛛丝状毛，有白色密或疏腺点，下面被白色或灰色密茸毛；上部叶渐小，三裂或不分裂，无柄。头状花序多数，排列成复总状，长约3mm，直径2-3mm，花后下倾；总苞片形；总苞片4-5层，边缘膜质，背面被绵毛；花带红色，多数，外层雌性，内层两性。瘦果常几达1mm，无毛。花期7-10月。"}]},{"ID":"20240614103122-a7iqei2","Type":"NodeParagraph","Properties":{"id":"20240614103122-a7iqei2","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614103122-1wny6fb","Type":"NodeParagraph","Properties":{"id":"20240614103122-1wny6fb","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，耐旱，耐荫。以疏松肥沃、富含腐殖质的壤土栽培为宜。"}]},{"ID":"20240614103122-1fqvrzz","Type":"NodeParagraph","Properties":{"id":"20240614103122-1fqvrzz","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"栽培技术 用分株繁殖。3-4月挖掘株丛，分株栽种，按行株距33cm×33cm开穴，每穴栽3-4株，填土压实，浇水。"}]},{"ID":"20240614103122-x0kd3z5","Type":"NodeParagraph","Properties":{"id":"20240614103122-x0kd3z5","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"田间管理 每年中耕除草，施肥2-3次，可结合收获后进行，一般在5、7、9月，施肥以人畜粪肥为主。栽培3-4年后，老株要重新栽种。"}]},{"ID":"20240614103122-2wanrwj","Type":"NodeParagraph","Properties":{"id":"20240614103122-2wanrwj","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614103122-et0gg50","Type":"NodeParagraph","Properties":{"id":"20240614103122-et0gg50","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 叶皱缩，破碎，有短柄。完整叶片展平后呈卵状椭圆形，羽状溶裂，裂片椭圆状披针形，边缘有不规则粗锯齿，上表面灰绿色工深黄绿色，有稀疏的柔毛及腺点，下表面密生灰白色绒毛。质柔软。气清香，味苦。"}]},{"ID":"20240614103122-2yy614o","Type":"NodeParagraph","Properties":{"id":"20240614103122-2yy614o","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"以叶厚、色青、背面灰白色、绒毛多、质柔软、香气浓郁者为佳。"}]},{"ID":"20240614103122-cvpnsvd","Type":"NodeParagraph","Properties":{"id":"20240614103122-cvpnsvd","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：绿褐色。①非腺毛有两种：一种为T字形毛，顶端细胞长而弯曲，两壁不等长，柄2-4细胞；另一种为单列性非腺毛，3-5细胞，顶端细胞特长而扭曲，常断落。②腺毛表面观呈鞋底形，由4或6细胞相对叠合而成，无柄。③草酸钙簇晶直径3-7μm，存在于叶肉细胞中。"}]},{"ID":"20240614103122-k3spj62","Type":"NodeParagraph","Properties":{"id":"20240614103122-k3spj62","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240614103122-thfkus3","Type":"NodeParagraph","Properties":{"id":"20240614103122-thfkus3","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 毒性：艾叶油小鼠灌胃LD50为2.47ml/kg，腹腔注射为1.12ml/kg。艾叶所含挥发油对皮肤有轻度刺激作用，引起发热潮红，口服能刺激胃肠道分泌，口服干艾叶3-5g可增进食欲，但大剂量可引起胃肠道急性炎症，产生大量恶心呕吐，若大量吸收后可引起中枢神经系统过度兴奋，出现谵妄、惊厥及肝损害等。由于神经反射性的变化，以及血管壁本身受损，可招致子宫充血、出血，妊娠时甚至流产。"}]},{"ID":"20240614103122-xe01psd","Type":"NodeParagraph","Properties":{"id":"20240614103122-xe01psd","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614103122-bmn4wen","Type":"NodeParagraph","Properties":{"id":"20240614103122-bmn4wen","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 1.艾叶含挥发油0.45%-1.00%，从中鉴定出：2-甲基丁醇（2-methylbutanol），2-已烯醛（2-hexenal），顺式-3-已烯-1-醇（cis-3-hexene-1-ol），三环烯（TCMLIBicyclene），α-侧柏烯（α-thujene），α-蒎烯（α-pinene）,樟烯（camphene），香桧烯（sabinene），β-蒎烯（β-pinene），1-辛烯-3-醇（1-octen-3-ol），2，4（8）-对-孟二烯[2，4（8）-pinthadiene]，对-聚伞花素（p-cymene），1，8-桉叶互（1，8-cineole），γ-松油烯（γ-terpinene），蒿属醇（artemisia alcohol），α松油烯（α-terpinene）,二甲基苏合香烯（dimethylstyrene），樟脑（camphor），龙脑（borneol），异龙脑（dioborneol），4-松油烯醇（terpinen-4-ol），对-聚伞花-α-醇（p-cymen-α-ol），α-松油醇（α-ter-pineol），顺式辣薄荷醇（cis-pieritol），马革命草烯酮（verbenone），桃金娘醇（myrtenol），反式瓿薄荷醇（TCMLIBans-piperitol），反式午苇醇（TCMLIBans-carveol），顺式-香苇醇（cis-carveol），乙酸-顺式-3-已烯醇酯（cis-3-hexenyl acetet），对-异丙基苯甲醛（p-isopropyl-benzaldehyde），葛缕酮（carvone），香苇烯酮（carvenone），紫苏醛（perillaldehyde），乙酸龙脑酯（bornyl acetate），紫苏醇（perilla-al-cohol），香荆芥酚（carvacrol），丁香油酚（eugenol），（王古）（王巴）烯（copaene），β-波旁烯（β-borbonene），β-槛香烯（β-elemene），甲基丁香油酚（methyleugenol），反式-丁香烯（TCMLIBans-caryophyllene），β-金合欢烯（cis-β-farnesene），葎草烯（humulene），β-橄榄烯（β-maaliene），反式-β-金合欢烯（TCMLIBans-β-farnescene），β-芹子烯（β-selinene），γ-衣兰油烯（γ-muurolene），γ-榄香烯（γ-elemene），α-衣兰油烯（α-muurolene），丙酸橙花醇酯（neryl propionate），ξ-荜澄茄烯（ξ-cadinene），丁香烯氧化物（caryophylleneoxide），嗽叭醇（ledol），十五烷醛（pentadecanal），六氢金合欢烯基丙酮（hexehydroarnesylacetone），邻-苯二甲酸二丁酯（dibutylphthalate），棕样酸（palmitic acid）等60种成分[1]，另据报道，从山东崂山产野生艾蒿叶的挥发油中，复写出34种成分，其中含量较高的：棕檬烯（limonene），香桧烯，α-及β-蒎烯，乙酸龙脑酯，顺式-β-金合欢烯，α-水芹烯（α-phellan-drene），1，8-桉叶素，α-松油烯，异戊基环已烯（isopentylcy-clohexene），龙脑，4-松油烯醇，顺式-辣薄荷醇（cis-piperitol），香茅醇（ciTCMLIBonellol），α-金合欢烯-4-醇-4-醇（oct-7-en-4-ol），甲基异丙基苯（methylisopropyl benzene），1，8-桉叶素，水合樟烯（camphene hydrate），1，4-桉叶素（1，4-cineole），樟脑，龙脑，4-松油烯醇，α-松油醇，反式-香苇醇，葛缕酮，紫苏醛，乙酸龙脑酯，丁香油酚，α-金合欢烯，嗽叭醇，2-N-丙基1，3-二氧戊环（2-N-propyl-1,3-dioxolane），α-水芹烯，芳樟酸，2-四氢吡喃甲醇（2-hydroxy methyl teTCMLIBahydropyran），优葛缕酮（eucarvone），顺式豆薄荷醇，蒿属酮（artemisia ketone），辣薄荷酮（piperitone），异辣薄荷酮（isopipe-ritenone），马鞭草烯酮，2，6，6-三甲基-2，4环庚二烯酮（2，6，6-TCMLIBimethyl-2,4-cycloheptadien-1-one），α-姜黄烯（α-curcumene），二氢猕猴桃内酯（dihydroacinidiolide），羽毛柏烯（widdrene），2，2-二甲基-3-苯基丙酸乙烯酯（vinyl2,2-dimethyl-3-henyl-propi-onate）等32个成分[3]。叶还含黄酮类成分：5，7-二羟基-6，3，4-三甲氧基黄酮（eupatilin），5-羟基-6，7，3，4-四甲氧基黄酮（5-hydroxy-6,7,3,4-teTCMLIBamethoxyfloxyflavone）[4]，成分：柳杉二醇（cryptomeridiol）[5，6]，魃蒿内酯（yomogin）[5，7]，1-氧代-4β-乙酰氧基桉叶-2，11（13）-二烯-12，8β-内酯[1-oxo-4β-acetoxyeudesma-2,11(13)-dien-12,8β-olide]，1-氧代-4α-乙醇氧基桉叶-2，11（13）-二烯-12，8β-内酯[1-oxo-4α-acetoxyeudesam-2,11（13）-dien-12-8β-olide][5]；三萜类成分：α-及β-香树脂醇（amyrin），无羁萜（friedelin）[5]，α-及β-香树脂醇的乙醇酯（amyrin acetate），羽扇烯酮（lupenone），粘霉烯酮（gluctinone），羊齿烯酮（fernenone），24-亚甲基环木菠萝烷酮）（24-methylenecycloartanone），西米杜鹃醇（simiarenol），3β-四氧基-9β，19-环羊乞求甾-23（E）烯-25，26-二醇[3β-methoxy-9β，19-cycolanost-23-25,26-diol]；其他成分：β-谷甾醇（β-sitosterol），豆甾醇（stigmasterol）[5]，棕榈酸乙酯（ethyl palmitate），油酸乙酯（ethyl oleate），亚油酸乙酯（ethyl linoleate），反式的苯亚甲基丁二酸（phenylitaconic acid）[8]以及镍、钴、铝、铬、硒、铜锌、铁、锰、钙、镁等元素[9]。"}]},{"ID":"20240614103122-r4s8wtq","Type":"NodeParagraph","Properties":{"id":"20240614103122-r4s8wtq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614103122-t0oq1pc","Type":"NodeParagraph","Properties":{"id":"20240614103122-t0oq1pc","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用：1.1.艾叶在体外对炭疽杆菌、α-溶血链球菌、B-溶血链球菌、白喉杆菌、假白喉杆菌、肺类双球菌、金黄色葡萄球菌、柠檬色葡萄球菌、白色葡葡球菌、枯草杆菌等10种革兰氏阳性嗜气菌皆有抗菌作用。艾叶油4×10（-3）浓度（试管法），对肺炎双球菌、金黄色葡萄球菌、白色葡萄球菌、甲型链球菌、大肠杆菌、伤寒杆菌、副伤寒杆菌、福氏痢疾杆菌等有抑菌作用。以野艾叶、艾条或艾绒烟熏，可用于室内消毒，与苍术或与菖蒲及雄黄或与苍术、雄黄、白芷等混合烟重，对金黄色葡萄球菌、乙型溶血性链球菌、大肠杆菌、变形杆菌、白喉杆菌、伤寒及副伤寒杆菌、绿脓杆菌、枯草杆菌、产碱杆菌以及结核杆菌（人型H37RV）均有杀灭或抑制作用。艾条烟熏尚能减少烧伤创面的细菌。豚鼠结核经艾灸治疗后，疾病进展较慢，病变较轻，尤以病程后期更明显；此外还能增强网状内皮细胞的吞噬反应，但所增强的程度不如动物获得免疫性时那样显着；豚鼠网状内皮系细胞的吞噬机能与内脏的结核病变是一致的，当肝、脾受到疾病的损害时，吞噬机能即下降。"}]},{"ID":"20240614103122-1thwy01","Type":"NodeParagraph","Properties":{"id":"20240614103122-1thwy01","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"1.2.以小野艾叶烟熏，对于多种致病真菌也有抑菌作用。小野艾水浸剂及煎剂，在试管内对多种致病真菌也有一定的抑制作用。"}]},{"ID":"20240614103122-vtx0zw6","Type":"NodeParagraph","Properties":{"id":"20240614103122-vtx0zw6","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"1.3.野艾的水煎剂，在试管内对金黄色葡萄球菌、α-溶血性链球菌、肺炎双球菌、白喉杆菌、宋内氏痢疾杆菌、伤寒及副伤寒杆菌、霍乱弧菌等均有不同程度的抑制作用。"}]},{"ID":"20240614103122-hy168xc","Type":"NodeParagraph","Properties":{"id":"20240614103122-hy168xc","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用：艾叶煎液对皮癣真菌的抑菌作用最为微弱（与黄连、黄芩等煎液相比较），在15%浓度时堇色毛癣菌，开始呈抑制，30%浓度时除絮状表皮癣菌、足跖毛癣菌及白色念珠菌依然发育外，其它为许兰氏黄癣菌、许兰氏黄癣菌蒙古变种、狗山芽胞癣菌、同心性毛癣菌、红色毛癣菌、铁锈色毛癣菌、堇色毛癣菌等均停止发育。曹红烈等亦证明艾叶的水浸剂（1：4），在试管内对堇色毛癣菌，许兰氏黄癣菌、奥杜盎氏小芽胞癣菌、羊毛状小芽胞癣菌、红色表皮癣菌、星形奴卡氏菌等皮肤真菌均有不同程度的抑制作用。同时，孙迅又测定艾叶烟熏法对许兰氏黄癣菌、许兰氏黄癣菌蒙古变种、同心性毛癣菌、堇色毛癣菌、红色毛癣菌、絮状表皮癣菌、铁锈色小芽胞癣菌、足跖毛癣菌、趾间毛癣菌、狗小芽胞癣菌、石膏样毛癣菌、申克氏胞于丝菌、斐氏酿母菌等致病性皮肤真菌均有不同程度的明显抗菌作用。"}]},{"ID":"20240614103122-5z1vk5c","Type":"NodeParagraph","Properties":{"id":"20240614103122-5z1vk5c","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"3.平喘作用：3.1.艾叶油能直接松弛豚鼠气管平滑肌，也能对抗乙酰胆硷、氯化钡和组织胺引起的气管收缩现象；并增加豚鼠肺灌流量。艾叶油0.5ml/kg灌胃对乙酰胆碱-组胺混合液喷雾法致喘豚鼠有抑制作用，艾叶油2×10（-4）ml/kg对豚鼠离体气管有松弛作用，并能对抗乙酰胆碱、氯化钡引起的收缩。艾叶油加吐温-80制成的混悬液能抑制肺组织释放慢反应物质（SRS-A）；具有直接拮抗慢反应物质的作用，并能抑制肺组织和气管平滑肌释放慢反应物质；豚鼠以艾叶油一次灌胃后，肺组织内慢反应物质含量降低不明显。1981年有人从艾叶平喘作用较强的中沸点油中分离得到二个平喘作用较强的单体，即α-萜品烯醇和反式-香苇醇；动物实验表明其平喘作用比艾叶油强。艾叶油中分离得的萜品烯醇-4240-300mg/kg灌胃或喷雾给药，α-萜品烯醇80-120mg/kg灌胃，均能对抗组胺与乙酰胆碱引起的豚鼠哮喘，另两成分反式香苇醇（TCMLIBanscarveol）与β-石竹烯（β-caryophyllene）也显示有平喘作用。1%α-萜品烯醇吸入，对组胺引发的豚鼠气喘有抑制作用,并可对抗卵白蛋白致敏、攻击引起的豚鼠肺机械功能的改变。"}]},{"ID":"20240614103122-fb94oqp","Type":"NodeParagraph","Properties":{"id":"20240614103122-fb94oqp","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"3.2.野艾浸剂对豚鼠支气管有舒张作用。"}]},{"ID":"20240614103122-nni9yl2","Type":"NodeParagraph","Properties":{"id":"20240614103122-nni9yl2","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"4.利胆作用：取艾叶油胶囊，用2%叶温配成混悬液（每1ml含艾叶油75μl）。大鼠0.8ml/100g和0.3ml/100g十二指肠注射给药，分别为艾叶油一组和二组。阳性对照组用去氢胆酸（DHC），每片0.25g，配成20%混悬液，0.3ml/100g，十二脂肠给药。四氯化碳中毒组：用四氯化碳1ml／kg灌胃1次，中毒24小时作利胆实验，用艾叶油0.3ml/100g十二指肠给药。对照组用2%吐温0.3ml／100g十二指肠给药。小白鼠分3组，艾叶油组，0.2ml/10g十二指肠给药。去氢胆酸组，5%去氢胆酸0.2ml／10g十二指肠给药。生理盐水组，0.2ml/10g十二指肠给药。实验结果：艾叶油混悬液0.8ml/100g使正常大鼠胆汁流量增加91.5%，与给药前比较有极显着性差异；0.3ml／100g组使正常大鼠胆汁流最增加89%，与药前比较有极显着性差异；去氢胆酸组使大鼠胆汁流量增加83.2%；四氯化碳中毒组大鼠胆汁流量也有明显增加，与正常大鼠比，利胆作用减弱，维持时间短；2%吐温对胆汁流量无明显影响。艾叶油对小鼠也有明显的利胆作用，使其胆汁流量增加26%。"}]},{"ID":"20240614103122-4qd1dwe","Type":"NodeParagraph","Properties":{"id":"20240614103122-4qd1dwe","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"5.抑制血小板聚集作用：艾叶中β-谷甾醇和5，7-二羟-6，3'，4'，-三甲氧基黄酮，它们对抑制血小板聚集有显着作用。温瑞兴等研究了艾叶的炮制方法。不同产地的艾叶及其有效成分对血小板聚集率的影响，结果表明，艾叶的不同炮制品对血小板聚集率的作用各异。炮制方法对实验结果影响很大，不同方法的炮制产品其实验结果有很大差别。炒炭与醋炒焦的效果较差；炒焦、醋炒炭与生艾叶对血小板聚集率有很强的抑制作用，在3个剂量水平上都能极其明显地抑制血小板聚集（p\u003c0.001）。安国艾叶几种不同溶剂提取物中，以醇提物对血小板聚集的抑制作用最为突出，其它两种溶剂（乙酸乙酯、氯仿）提取物也有抑制作用，但不及醇提物效果好。3种不同产地的艾叶醇提水溶部位对血小板聚集均有抑制作用（p\u003c0.001）。这两个剂量的效果优于其它两种艾叶。在136mg/ml剂量时，3种艾叶的差异不明显。从艾叶中提取出的两种成分，β-谷甾醇与5，7-二羟基-6，3'，4'-三甲氧基黄酮均对血小板聚集有极显着的抑制作用。然而，这两种有效成分相比，β-谷甾醇的作用在0.7、1.35mg/ml剂量时均极其明显地优于后者（p\u003c0.001）。"}]},{"ID":"20240614103122-6vn9moe","Type":"NodeParagraph","Properties":{"id":"20240614103122-6vn9moe","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"6.止血作用：艾叶水浸液给兔灌胃有促进血液凝固作用，但亦有认为艾叶的止血作用未能证实。艾叶为临床上常用止血药，温经止血常炒炭用，药理实验初步证明：艾叶制炭后止血作用增强。张学兰等对其止血作用进行了比较研究，由实验结果可见，烘品2-5及炒炭品100%水煎液均可明显缩短实验小鼠的凝血及出血时间，与生理盐水组比较，具有显着性差异，以烘品2（180℃、10分钟）、烘品3（180℃、20分钟）和烘品4（200℃、10分钟）止血作用最为明显，与生品组比较也有显着性差异。其余样品组则无明显止血作用。建议艾叶制炭可改用烘法，以18℃烘10-20分钟及200℃烘10分钟，成品外表焦褐色为佳。"}]},{"ID":"20240614103122-25cwvgw","Type":"NodeParagraph","Properties":{"id":"20240614103122-25cwvgw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"7.对胃肠道及子宫的作用：野艾煎剂可兴奋家兔离体子宫，产生强直性收缩。粗制浸膏对豚鼠离体子宫亦有明显兴奋作用。小野艾水浸液对离体兔肠在大量时有抑制作用。"}]},{"ID":"20240614103122-ddmt3kc","Type":"NodeParagraph","Properties":{"id":"20240614103122-ddmt3kc","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"8.对心血管系统作用：小野艾水浸液对离体蛙心在大量时有抑制作用。从克里米亚的艾蒿Artemisiataurica分离出来的Tauremizin（是一种倍半萜烯内酯），对离体蛙心、猫心和在位猫心均能增强其收缩力，对猫心并能减慢心率，使冠脉血流量增加，有拟肾上腺素的作用。"}]},{"ID":"20240614103122-wzy4eyf","Type":"NodeParagraph","Properties":{"id":"20240614103122-wzy4eyf","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"9.抗过敏作用：艾叶油0.5ml／kg灌胃，对卵白蛋白引起的豚鼠过敏性休克有对抗作用，可降低死亡率。"}]},{"ID":"20240614103122-2gwku1x","Type":"NodeParagraph","Properties":{"id":"20240614103122-2gwku1x","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"10.其它作用：大桥秀治报告艾叶主要因其含鞣质，可使因温刺法发热的家兔的体温下降。但其作用剂量已近致死量，故不能作为解热药使用。用小白鼠耳部涂巴豆油引起炎症模型，用艾叶挥发油给小鼠皮下注射或肌肉注射0.0125g，均有抗炎效果，有效率为57.8%及75.O%；p值均小于0.001。艾叶油亦能延长戊巴比妥钠睡眠时间。小野艾水浸液对兔耳血管灌流时几无影响，给小鼠腹腔或静脉注射可降低毛细血管通透性（Lochett氏法）。大鼠内服有显着利尿作用，毒性中等，可用于临床。"}]},{"ID":"20240614103122-7drbyno","Type":"NodeParagraph","Properties":{"id":"20240614103122-7drbyno","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614103122-xgcoxzj","Type":"NodeParagraph","Properties":{"id":"20240614103122-xgcoxzj","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 1.艾叶：拣去杂质，去梗，筛去灰屑。"}]},{"ID":"20240614103122-i7e87tq","Type":"NodeParagraph","Properties":{"id":"20240614103122-i7e87tq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"2.艾绒：取晒干净艾叶碾碎成绒，拣去硬茎及叶柄，筛去灰屑。"}]},{"ID":"20240614103122-xcm2nbn","Type":"NodeParagraph","Properties":{"id":"20240614103122-xcm2nbn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"3.艾炭：取净艾叶置锅内用武火炒至七成变黑色，用醋喷洒，拌匀后过铁丝筛，未透者重炒，取出，晾凉，防止复燃，三日后贮存。（每艾叶100斤，用醋15斤）4.《本草衍义》：干捣筛去青滓，取白，入石硫黄，为硫黄艾，灸家用。得米粉少许，可捣为末，入服食药。"}]},{"ID":"20240614103122-7pyy7rt","Type":"NodeParagraph","Properties":{"id":"20240614103122-7pyy7rt","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：凡用艾叶，须用陈久者，治令细软，谓之熟艾，若生艾灸火，则伤人肌脉。拣取净叶，扬去尘屑，入石臼内木杵捣熟，罗去渣滓，取白者再捣，至柔烂如绵为度，用时焙燥，则灸火得力。治妇人丸散，须以熟艾，用醋煮干捣成饼子，烘干再捣为末用，或以糯糊和作饼，及酒炒者皆不佳。洪氏《容斋随笔》云，艾难着力，若入白茯苓三、五片同碾，即时可作细末，亦一异也。"}]},{"ID":"20240614103122-mckxli9","Type":"NodeParagraph","Properties":{"id":"20240614103122-mckxli9","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614103122-o0r3tun","Type":"NodeParagraph","Properties":{"id":"20240614103122-o0r3tun","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 归肝；脾；肾经"}]},{"ID":"20240614103122-kh1i9gw","Type":"NodeParagraph","Properties":{"id":"20240614103122-kh1i9gw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614103122-46du6fj","Type":"NodeParagraph","Properties":{"id":"20240614103122-46du6fj","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性温"}]},{"ID":"20240614103122-j85p9kt","Type":"NodeParagraph","Properties":{"id":"20240614103122-j85p9kt","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614103122-khzvi39","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240614103122-khzvi39","updated":"20240614103122"},"Children":[{"ID":"20240614103122-6222d4y","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240614103122-6222d4y","updated":"20240614103122"},"Children":[{"ID":"20240614103122-4qwyc72","Type":"NodeParagraph","Properties":{"id":"20240614103122-4qwyc72","updated":"20240614103122"}}]}]},{"ID":"20240614103122-pbpu8tn","Type":"NodeParagraph","Properties":{"id":"20240614103122-pbpu8tn","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：苦酒、香附为之使。"}]},{"ID":"20240614103122-ksk4em0","Type":"NodeParagraph","Properties":{"id":"20240614103122-ksk4em0","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614103122-4jcl1je","Type":"NodeParagraph","Properties":{"id":"20240614103122-4jcl1je","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 温经止血；散寒止痛；祛湿止痒。主吐血；衄血；吃力血；便血；便血；崩漏；妊娠下血；月经不调；痛经；胎动不安；心腹冷痛；泄泻久痢；霍乱转筋；带下；湿疹；疥癣；痔疮；痈疡"}]},{"ID":"20240614103122-8s20rkb","Type":"NodeParagraph","Properties":{"id":"20240614103122-8s20rkb","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614103122-etgdbwk","Type":"NodeParagraph","Properties":{"id":"20240614103122-etgdbwk","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散；或捣汁。外用：适量，捣绒作炷或制成艾条熏灸；工捣敷；或煎水熏洗；或炒热温熨。"}]},{"ID":"20240614103122-d6j044o","Type":"NodeParagraph","Properties":{"id":"20240614103122-d6j044o","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614103122-eh503b6","Type":"NodeParagraph","Properties":{"id":"20240614103122-eh503b6","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 胶艾汤《金匮要略》：治血虚寒滞，月经过多。香艾丸《圣济总录》：止痢定痛。艾姜汤《世医得效方》：下痢脓血。艾附暖宫丸《沈氏遵生书》：阳虚寒盛、冲任失养。《四生丸》妇人良方：凉血止血。"}]},{"ID":"20240614103122-wn95j7e","Type":"NodeParagraph","Properties":{"id":"20240614103122-wn95j7e","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614103122-npgc4sm","Type":"NodeParagraph","Properties":{"id":"20240614103122-npgc4sm","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 1.《本草图经》：近世有单服艾者，或用蒸木瓜丸之，或作汤空腹饮之，甚补虚羸。然亦有毒，其毒发热气冲上，狂躁不能禁，至攻眼有疮出血者，诚不可妄服也。"}]},{"ID":"20240614103122-7fxtf0u","Type":"NodeParagraph","Properties":{"id":"20240614103122-7fxtf0u","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"2.艾，生寒熟温，生捣汁服可止血。《本草》止言其温，不言其热。其性入火灸，则气下行，入药服，则气上行。"}]},{"ID":"20240614103122-2x63bu6","Type":"NodeParagraph","Properties":{"id":"20240614103122-2x63bu6","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：艾叶，生则微苦太辛，熟则微辛太苦，生温熟热，纯阳也。可以取太阳真火，可以回垂绝元阳。服之则走三阴而逐一切寒湿，转肃杀之气为融和；灸之则透诸经而治百种病邪，起沉疴之人为康泰，其功亦大矣。苏恭言其生寒，苏颂言其有毒，一则见其能止诸血，一则见其热气上冲，遂谓其性寒、有毒，误矣。盖不知血随气而行，气行则血散，热因久服，致火上冲之故尔。夫药以治病，中病则止。若素有虚寒痼冷，妇人湿郁滞漏之人，以艾和归、附诸药治其病，夫何不可，而乃妄意求嗣，服艾不辍，助以辛热，药性久偏，致使火燥，是谁之咎欤？于艾何尤！艾附丸治心腹、少腹诸痛，调女人诸病，颇有深功；胶艾汤治虚痢及妊娠产后下血，尤着奇效。老人丹田气弱，脐腹畏冷者，以熟艾入布袋兜其脐腹，妙不可言。寒湿脚气，亦宜以此夹入袜内。"}]},{"ID":"20240614103122-q76ecfp","Type":"NodeParagraph","Properties":{"id":"20240614103122-q76ecfp","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"4.《本草汇言》：艾叶，暖血温经，行气开郁之药也。开关窍，醒一切沉涸伏匿内闭诸疾。若气血、痰饮、积聚为病，哮喘逆气，骨蒸痞结，瘫痪痈疽，瘰疬结核等疾，灸之立起沉疴。若入服食丸散汤饮中，温中除湿，调经脉，壮子宫，故妇人方中多加用之。"}]},{"ID":"20240614103122-s8nmhdq","Type":"NodeParagraph","Properties":{"id":"20240614103122-s8nmhdq","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"5.《本草正》：艾叶，能通十二经，而尤为肝脾肾之药，善于温中、逐冷、除湿，行血中之气，气中之滞，凡妇人血气寒滞者，最宜用之。或生用捣汁，或熟用煎汤，或用灸百病，或炒热敷熨可通经络，或袋盛包裹可温脐膝，表里生熟，俱有所宜。"}]},{"ID":"20240614103122-6kchi39","Type":"NodeParagraph","Properties":{"id":"20240614103122-6kchi39","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"6.《本草正义》：古人灸法，本无一症不可治，艾之大用，惟此最多，故《别录》以冠主治之前，其作煎以下，则汤液之治疗也。止吐血者宜生用，取其辛开以疏经络之壅，然温升之性，必与上溢之症不合，古人有四生丸之制，以柏叶、荷叶、生地之清肃下降者为主，而反佐以艾叶之辛温，欲其同气相求，易于桴应，非艾之一味可以止上升之吐衄也。其止下利，则以里寒泄泻而言，辛温升举，固其所宜。下部gu疮，则湿热生虫之恙，苦温燥湿，又能杀虫，是其专职。妇人下血，则中气虚寒，下焦无摄纳之权，以致血行失道，无故妄下，《金匮》胶艾汤温经升举，固阴和阳，是其正治，非血热妄行之下血也。生肌肉者，虚羸之人，血少形癯，得此以温养之，则气血旺而肌自丰；亦有溃疡气血两虚，阳和不运，则新肌不长，艾能温煦以和脉络，而肌肉易长，若热多烁液者，非其治也。"}]},{"ID":"20240614103122-abfkt5n","Type":"NodeParagraph","Properties":{"id":"20240614103122-abfkt5n","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"7.《别录》：主灸百病。可作煎，止下痢，吐血，下部疮，妇人漏血。利阴气，生肌肉，辟风寒，使人有子。"}]},{"ID":"20240614103122-endodbf","Type":"NodeParagraph","Properties":{"id":"20240614103122-endodbf","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"8.陶弘景：捣叶以灸百病，亦止伤血。汁又杀蛔虫。苦酒煎叶疗癣。"}]},{"ID":"20240614103122-gmbbmfg","Type":"NodeParagraph","Properties":{"id":"20240614103122-gmbbmfg","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：止崩血，安胎止腹痛。止赤白痢及五藏痔泻血。长服止冷痢。又心腹恶气，取叶捣汁饮.10.《唐本草》：主下血，衄血，脓血痢，水煮及丸散任用。"}]},{"ID":"20240614103122-0bk4w9a","Type":"NodeParagraph","Properties":{"id":"20240614103122-0bk4w9a","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"11.《食疗本草》：金疮，崩中，霍乱，止胎漏。"}]},{"ID":"20240614103122-mqjh8er","Type":"NodeParagraph","Properties":{"id":"20240614103122-mqjh8er","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：止霍乱转筋，治心痛，鼻洪，并带下。"}]},{"ID":"20240614103122-eq020rr","Type":"NodeParagraph","Properties":{"id":"20240614103122-eq020rr","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"13.《珍珠囊》：温胃。"}]},{"ID":"20240614103122-5xmnb1e","Type":"NodeParagraph","Properties":{"id":"20240614103122-5xmnb1e","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"14.《履巉岩本草》：治咽喉闭痛热壅，饮食有妨者，捣汁灌漱。"}]},{"ID":"20240614103122-cx4rblw","Type":"NodeParagraph","Properties":{"id":"20240614103122-cx4rblw","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"15.《王好古》：治带脉为病，腹胀满，腰溶溶如坐水中。"}]},{"ID":"20240614103122-36mfmhk","Type":"NodeParagraph","Properties":{"id":"20240614103122-36mfmhk","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"16.《本草再新》：调经开郁，理气行血。治产后惊风，小儿脐疮。"}]},{"ID":"20240614103122-f3r80pi","Type":"NodeParagraph","Properties":{"id":"20240614103122-f3r80pi","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614103122-hionusf","Type":"NodeParagraph","Properties":{"id":"20240614103122-hionusf","updated":"20240614103122"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614102614-yjhkajc","Type":"NodeThematicBreak","Properties":{"id":"20240614102614-yjhkajc"}},{"ID":"20240614102615-n9844i6","Type":"NodeParagraph","Properties":{"id":"20240614102615-n9844i6"}}]}