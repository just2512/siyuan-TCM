es":{"parent-style":"width: 429px;","style":"width: 419px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹林"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹林-20240702132749-s8q4bxq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 419px;\" parent-style=\"width: 429px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 639px;","style":"width: 629px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹叶2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹叶2-20240626082356-8xqrpac.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 629px;\" parent-style=\"width: 639px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702132311-rvuav2n","Type":"NodeParagraph","Properties":{"id":"20240702132311-rvuav2n","updated":"20240826175951"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹子-20240702132255-d0izufu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"竹子4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/竹子4-20240702132529-dwu7af8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702132820-y8jvc69","Type":"NodeParagraph","Properties":{"id":"20240702132820-y8jvc69","updated":"20240702133315"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：雷丸是寄生于竹子底下的一种菌类植物（市面上真雷丸很少了）。"}]},{"ID":"20240613134138-7rym60x","Type":"NodeThematicBreak","Properties":{"id":"20240613134138-7rym60x"}},{"ID":"20240613134140-hb9txpc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134140-hb9txpc","updated":"20240613134145"},"Children":[{"Type":"NodeText","Data":"雷丸《神农本草经》"}]},{"ID":"20240613134140-jotyz8w","Type":"NodeParagraph","Properties":{"id":"20240613134140-jotyz8w","updated":"20240613134140"},"Children":[{"Type":"NodeText","Data":"（《御览》作雷公丸）"}]},{"ID":"20240613134140-p912v5r","Type":"NodeParagraph","Properties":{"id":"20240613134140-p912v5r","updated":"20240613134140"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613134140-oe2jnje","Type":"NodeParagraph","Properties":{"id":"20240613134140-oe2jnje","updated":"20240613134140"},"Children":[{"Type":"NodeText","Data":"主杀三虫，逐毒气，胃中热，利丈夫，不利女子作摩膏，除小儿百病（《御览》引云：一名雷矢，《大观本》，作黑字）。生山谷。"}]},{"ID":"20240613134140-59mc2lp","Type":"NodeParagraph","Properties":{"id":"20240613134140-59mc2lp","updated":"20240613134140"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：雷丸，神农苦，黄帝岐伯桐君甘有毒，扁鹊甘无毒，李氏大寒（《御览》引云：一名雷实，或生汉中，八月采）。"}]},{"ID":"20240613134140-ng7oewg","Type":"NodeParagraph","Properties":{"id":"20240613134140-ng7oewg","updated":"20240613134140"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名雷矢，一名雷实，生石城及汉中土中，八月采根暴干。"}]},{"ID":"20240613134140-zourgsc","Type":"NodeParagraph","Properties":{"id":"20240613134140-zourgsc","updated":"20240613134140"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：雷矢，出汉中，色白者善。"}]},{"ID":"20240613133847-7cnm25d","Type":"NodeThematicBreak","Properties":{"id":"20240613133847-7cnm25d"}},{"ID":"20240613133854-woxifeb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133854-woxifeb","updated":"20240613133858"},"Children":[{"Type":"NodeText","Data":"雷丸《本草纲目》"}]},{"ID":"20240613133854-nxshr1a","Type":"NodeParagraph","Properties":{"id":"20240613133854-nxshr1a","updated":"20240613133854"},"Children":[{"Type":"NodeText","Data":"「释名」雷实、雷矢、竹苓。"}]},{"ID":"20240613133854-97ld468","Type":"NodeParagraph","Properties":{"id":"20240613133854-97ld468","updated":"20240613133854"},"Children":[{"Type":"NodeText","Data":"「气味」苦、寒、有小毒辣。"}]},{"ID":"20240613133854-s79s76h","Type":"NodeParagraph","Properties":{"id":"20240613133854-s79s76h","updated":"20240613133854"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613133854-ik1fsnr","Type":"NodeParagraph","Properties":{"id":"20240613133854-ik1fsnr","updated":"20240613133854"},"Children":[{"Type":"NodeText","Data":"1、下寸白虫（绦虫）。和雷丸，水浸，去皮，切细，焙为末。五更时，吃炙肉少许，随即以稀粥送服药末一匙，上半月服药，效果轻好。"}]},{"ID":"20240613133854-bmebf7g","Type":"NodeParagraph","Properties":{"id":"20240613133854-bmebf7g","updated":"20240613133854"},"Children":[{"Type":"NodeText","Data":"2、小儿出汗，有热。用雷丸四两，研为末，加粉半斤，拌匀扑身上。"}]},{"ID":"20240613134159-wmb392t","Type":"NodeThematicBreak","Properties":{"id":"20240613134159-wmb392t"}},{"ID":"20240613134200-21hze2i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134200-21hze2i","updated":"20240613134205"},"Children":[{"Type":"NodeText","Data":"雷丸《证类本草》"}]},{"ID":"20240613134200-cz7meit","Type":"NodeParagraph","Properties":{"id":"20240613134200-cz7meit","updated":"20240613134200"},"Children":[{"Type":"NodeText","Data":"味苦、咸，寒、微寒，有小毒。主杀三虫，逐毒瓦斯，胃中热。利丈夫，不利女子。作摩膏，除小儿百病，逐邪气恶风汗出，除皮中热结积蛊毒，白虫、寸白自出不止。久服令人阴痿。一名雷矢，一名雷实。赤者杀人。生石城山谷及汉中土中。八月采根，曝干。（荔实、浓朴为之使，恶葛根。）"}]},{"ID":"20240613134200-kyhlluo","Type":"NodeParagraph","Properties":{"id":"20240613134200-kyhlluo","updated":"20240613134200"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出建平、宜都间。累累相连如丸。《本经》云∶利丈夫。《别录》云∶久服阴雷丸，竹之苓也。无有苗蔓，皆零无相连者。今出房州、金州。"}]},{"ID":"20240613134200-cgiot6x","Type":"NodeParagraph","Properties":{"id":"20240613134200-cgiot6x","updated":"20240613134200"},"Children":[{"Type":"NodeText","Data":"今注此物性寒。《本经》云∶利丈夫，不利女子。《别录》云∶久服令阴痿者，于事相反。"}]},{"ID":"20240613134200-63uelkw","Type":"NodeParagraph","Properties":{"id":"20240613134200-63uelkw","updated":"20240613134200"},"Children":[{"Type":"NodeText","Data":"按此则疏利男子元气，不疏利女子脏气，其义显矣。臣禹锡等谨按范子云∶雷矢出汉中，色白者善。吴氏云∶雷丸，神农∶苦。黄帝、歧伯、桐君∶甘，有毒。扁鹊∶甘，无毒。季氏∶大寒。药性论云∶雷丸，君，恶蓄根，味苦，有小毒。能逐风。芫花为使。主癫痫狂走，杀蛔虫。日华子云∶入药炮用。"}]},{"ID":"20240613134200-hz48kp7","Type":"NodeParagraph","Properties":{"id":"20240613134200-hz48kp7","updated":"20240613134200"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，用甘草水浸一宿了，铜刀刮上黑皮，破作四五片。又用甘草汤浸一宿后蒸，从巳至未，出，晒干。"}]},{"ID":"20240613134200-y0xlaqv","Type":"NodeParagraph","Properties":{"id":"20240613134200-y0xlaqv","updated":"20240613134200"},"Children":[{"Type":"NodeText","Data":"却以酒拌，如前从巳至未蒸，晒干用。经验前方∶下寸白虫。雷丸一味，水浸软去皮切，焙干为末。每有疾者，五更初，先食炙肉少许，便以一钱匕药，稀粥调半钱服之，服时须六衙及上半月日，虫乃下。"}]},{"ID":"20240613133923-7t913lf","Type":"NodeThematicBreak","Properties":{"id":"20240613133923-7t913lf"}},{"ID":"20240613133924-cfr3ikw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133924-cfr3ikw","updated":"20240613133928"},"Children":[{"Type":"NodeText","Data":"雷丸《本草经集注》"}]},{"ID":"20240613133924-bf547ox","Type":"NodeParagraph","Properties":{"id":"20240613133924-bf547ox","updated":"20240613133924"},"Children":[{"Type":"NodeText","Data":"味苦、咸，寒、微寒，有小毒。主杀三虫，逐毒瓦斯，胃中热，利丈夫，不利女子，作膏摩，除小儿百病。逐邪气，恶风，汗出，除皮中热结，积聚，蛊毒，白虫，寸白自出不止。"}]},{"ID":"20240613133924-p7ezyym","Type":"NodeParagraph","Properties":{"id":"20240613133924-p7ezyym","updated":"20240613133924"},"Children":[{"Type":"NodeText","Data":"久服令阴痿。一名雷矢，一名雷实，赤者杀人。生石城山谷，生汉中土中。八月采根，曝干。"}]},{"ID":"20240613133924-xi5nln7","Type":"NodeParagraph","Properties":{"id":"20240613133924-xi5nln7","updated":"20240613133924"},"Children":[{"Type":"NodeText","Data":"（荔实、浓朴为之使，恶葛根。）"}]},{"ID":"20240613133924-myrh5f3","Type":"NodeParagraph","Properties":{"id":"20240613133924-myrh5f3","updated":"20240613133924"},"Children":[{"Type":"NodeText","Data":"今出建平、宜都间，累累相连如丸。《本经》云∶利丈夫，《别录》云∶久服阴痿，于事相反。"}]},{"ID":"20240613134212-30igxq6","Type":"NodeThematicBreak","Properties":{"id":"20240613134212-30igxq6"}},{"ID":"20240613134214-j95gi0t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134214-j95gi0t","updated":"20240613134218"},"Children":[{"Type":"NodeText","Data":"雷丸《医学入门》"}]},{"ID":"20240613134214-9zuzktf","Type":"NodeParagraph","Properties":{"id":"20240613134214-9zuzktf","updated":"20240613134214"},"Children":[{"Type":"NodeText","Data":"雷丸咸苦冷微毒，逐皮热毒杀诸虫，摩膏疗儿百种病，久服伤阴男女同。"}]},{"ID":"20240613134214-umg3m89","Type":"NodeParagraph","Properties":{"id":"20240613134214-umg3m89","updated":"20240613134214"},"Children":[{"Type":"NodeText","Data":"雷，累也；丸，圆也，累累相连如圆状也。主散皮肤中热结毒瓦斯，胃中邪热。杀疮疥中虫及寸白三虫。"}]},{"ID":"20240613134214-fhn3iow","Type":"NodeParagraph","Properties":{"id":"20240613134214-fhn3iow","updated":"20240613134214"},"Children":[{"Type":"NodeText","Data":"作摩膏除小儿百般积病。本草云∶利丈夫，不利女人。疏利男子元气，不疏利女子脏气，非利益之利也。故又曰∶久服令阴痿。要之，疏利之剂伤阴损血，男女中病则已，皆不宜过服。兼治癫痫狂走，蛊毒。出汉中，白者佳，赤者杀人。醋浸泡，去黑皮，焙。雷公以甘草汤浸二日，刮去黑皮，酒拌蒸半日，焙干用。芫花、浓朴、荔核为使。恶葛根。"}]},{"ID":"20240613133941-3anj9ge","Type":"NodeThematicBreak","Properties":{"id":"20240613133941-3anj9ge"}},{"ID":"20240613133942-d7aq8ps","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133942-d7aq8ps","updated":"20240613133947"},"Children":[{"Type":"NodeText","Data":"雷丸《新修本草》"}]},{"ID":"20240613133942-6p9cda9","Type":"NodeParagraph","Properties":{"id":"20240613133942-6p9cda9","updated":"20240613133942"},"Children":[{"Type":"NodeText","Data":"味苦、咸，寒、微寒，有小毒。主杀三虫，逐毒瓦斯，胃中热，利丈夫，不利女子，作膏摩，除小儿百病。逐邪气，恶风，汗出，除皮中热结，积聚，蛊毒，白虫，寸白自出不止。久服令人阴痿。一名雷实，赤者杀人。生石城山谷，生汉中土中。八月采根，曝干。"}]},{"ID":"20240613133942-hefwhls","Type":"NodeParagraph","Properties":{"id":"20240613133942-hefwhls","updated":"20240613133942"},"Children":[{"Type":"NodeText","Data":"荔实、浓朴为之使，恶葛根。今出建平、宜都间，累累相连如丸。《本经》云∶利丈夫。"}]},{"ID":"20240613133942-ognet3j","Type":"NodeParagraph","Properties":{"id":"20240613133942-ognet3j","updated":"20240613133942"},"Children":[{"Type":"NodeText","Data":"《事相反。"}]},{"ID":"20240613133942-r4eb4ia","Type":"NodeParagraph","Properties":{"id":"20240613133942-r4eb4ia","updated":"20240613133942"},"Children":[{"Type":"NodeText","Data":"〔谨案〕雷丸是竹之苓也，无有苗蔓，皆零出，无相连者。今出房州、金州。"}]},{"ID":"20240613134005-rafxswj","Type":"NodeThematicBreak","Properties":{"id":"20240613134005-rafxswj"}},{"ID":"20240613134006-g24vbvr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134006-g24vbvr","updated":"20240613134010"},"Children":[{"Type":"NodeText","Data":"雷丸《本草撮要》"}]},{"ID":"20240613134006-6z8h1b6","Type":"NodeParagraph","Properties":{"id":"20240613134006-6z8h1b6","updated":"20240613134006"},"Children":[{"Type":"NodeText","Data":"味苦寒有小毒．入手足阳明经功专消积杀虫．腹中得应声虫非此莫治．甘草水浸一宿．酒拌蒸或炮用．浓朴、芫花为使．恶葛根．又名竹芩．"}]},{"ID":"20240613134233-vdwsumg","Type":"NodeThematicBreak","Properties":{"id":"20240613134233-vdwsumg"}},{"ID":"20240613134234-duewpab","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134234-duewpab","updated":"20240613134240"},"Children":[{"Type":"NodeText","Data":"雷丸《本草新编》"}]},{"ID":"20240613134234-m97wn0o","Type":"NodeParagraph","Properties":{"id":"20240613134234-m97wn0o","updated":"20240613134234"},"Children":[{"Type":"NodeText","Data":"雷丸，味苦、咸，气寒，有小毒。入脾、胃与大肠。胃热可解，力能杀虫。不论各虫，皆能驱逐。男妇皆利，非利男子而不利妇人也。主癫痫狂走，堕鬼胎甚速。遇怪病在腹，无药可治者，加入辄应如响。名曰雷丸者，言如雷之迅、如丸之转也，走而不留，坚者能攻，积者能去，实至神之品。但有小毒，未免损伤胃气，去病则已，不可多服。宜以之逐邪，不宜以之耗正也。"}]},{"ID":"20240613134234-6128gin","Type":"NodeParagraph","Properties":{"id":"20240613134234-6128gin","updated":"20240613134234"},"Children":[{"Type":"NodeText","Data":"或问闻雷丸善治奇病，有之乎？雷丸何能治奇病也，用之有理则奇，用之无事则拙。吾深怪世人，无理而欲眩异也。"}]},{"ID":"20240613134234-s2734no","Type":"NodeParagraph","Properties":{"id":"20240613134234-s2734no","updated":"20240613134234"},"Children":[{"Type":"NodeText","Data":"或问雷丸可以逐邪，亦可以逐鬼乎？既可逐邪，独不可以逐鬼乎。惟是逐鬼与逐邪少异，逐邪须用攻邪之药为佐，而逐鬼必须用补正之药为君，未可单用攻剂也。"}]},{"ID":"20240613134234-t0jxm3g","Type":"NodeParagraph","Properties":{"id":"20240613134234-t0jxm3g","updated":"20240613134234"},"Children":[{"Type":"NodeText","Data":"或问邪与鬼，何分？曰∶寒热之有常，此邪气而非鬼祟也。寒热之无常，此邪祟而非邪气矣。然亦不可拘也。天下有鬼祟凭之而无寒热者，亦有寒热未解，而鬼祟先去者。虽曰逐邪用攻邪之药，逐鬼用补正之药，苟能以补正为主，而佐之逐邪、逐鬼也，则无往而非宜也。"}]},{"ID":"20240613134234-muxjurf","Type":"NodeParagraph","Properties":{"id":"20240613134234-muxjurf","updated":"20240613134234"},"Children":[{"Type":"NodeText","Data":"或问雷丸性至急，不识可少制而缓之乎？夫雷丸一制，则无用矣。大凡逐邪之药，正取其迅速，制之则失其性，安能施其功用乎。设于同群之中，而佐之和平之味，则彼此调剂，自得其宜，亦不制之制也。"}]},{"ID":"20240613134016-2fwwg80","Type":"NodeThematicBreak","Properties":{"id":"20240613134016-2fwwg80"}},{"ID":"20240613134017-wopxgnb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134017-wopxgnb","updated":"20240613134021"},"Children":[{"Type":"NodeText","Data":"雷丸《本草害利》"}]},{"ID":"20240613134017-1ol5wxg","Type":"NodeParagraph","Properties":{"id":"20240613134017-1ol5wxg","updated":"20240613134017"},"Children":[{"Type":"NodeText","Data":"〔害〕赤色者能杀人，细拣去用。杀虫之外，无他长，能令人阴痿。"}]},{"ID":"20240613134017-rdto5ts","Type":"NodeParagraph","Properties":{"id":"20240613134017-rdto5ts","updated":"20240613134017"},"Children":[{"Type":"NodeText","Data":"〔利〕苦寒，入胃、大肠二经。杀脏腑诸虫，除婴儿百病，有虫者宜之。"}]},{"ID":"20240613134017-1kgsakh","Type":"NodeParagraph","Properties":{"id":"20240613134017-1kgsakh","updated":"20240613134017"},"Children":[{"Type":"NodeText","Data":"〔修治〕竹之余气，得霹雳而生，故名之。大小如栗，竹刀刮去黑皮，甘草水浸一宿，酒拌蒸或炮。"}]},{"ID":"20240613134029-yyjon4v","Type":"NodeThematicBreak","Properties":{"id":"20240613134029-yyjon4v"}},{"ID":"20240613134032-qklamya","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134032-qklamya","updated":"20240613134036"},"Children":[{"Type":"NodeText","Data":"雷丸《本草分经》"}]},{"ID":"20240613134032-qqh2gih","Type":"NodeParagraph","Properties":{"id":"20240613134032-qqh2gih","updated":"20240613134032"},"Children":[{"Type":"NodeText","Data":"苦寒，入胃大肠，功专消积杀虫而能令人阴痿。"}]},{"ID":"20240613134123-l8uywbe","Type":"NodeThematicBreak","Properties":{"id":"20240613134123-l8uywbe"}},{"ID":"20240613134124-boitffg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134124-boitffg","updated":"20240613134128"},"Children":[{"Type":"NodeText","Data":"雷丸《雷公炮制药性解》"}]},{"ID":"20240613134124-ppnyeia","Type":"NodeParagraph","Properties":{"id":"20240613134124-ppnyeia","updated":"20240613134124"},"Children":[{"Type":"NodeText","Data":"味苦咸，性寒有小毒，入肺脾胃三经。主胃中热，癫发狂走，恶风汗出，解蛊毒，杀诸虫，逐皮里膜外之水；又作糜膏，除小儿百病，利丈夫，不利女子，久服阴痿。火炮用，荔实、浓朴、芫花为使，恶葛根、扁蓄，赤者杀人。"}]},{"ID":"20240613134124-jacrb3l","Type":"NodeParagraph","Properties":{"id":"20240613134124-jacrb3l","updated":"20240613134124"},"Children":[{"Type":"NodeText","Data":"按∶雷丸苦能燥脾，而胃则其腑也，肺则其子也，故均入之。虫以湿热为巢穴，湿热去而虫可杀矣。《本经》既云利丈夫，《别录》又云久服阴痿，于事相反，陶隐居以此致疑，不知利者疏利之谓尔！非利益也。"}]},{"ID":"20240613134124-52k1qot","Type":"NodeParagraph","Properties":{"id":"20240613134124-52k1qot","updated":"20240613134124"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使用甘草，水浸一宿了，将刀刮去黑皮，破作四五片，又用甘草汤浸一宿后蒸，从巳至未，日干，却以酒拌如前，日干用之。"}]},{"ID":"20240613134113-zl1cemt","Type":"NodeThematicBreak","Properties":{"id":"20240613134113-zl1cemt"}},{"ID":"20240613134114-yrib2dm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134114-yrib2dm","updated":"20240613134118"},"Children":[{"Type":"NodeText","Data":"雷丸《本草求真》"}]},{"ID":"20240613134114-ypzqezi","Type":"NodeParagraph","Properties":{"id":"20240613134114-ypzqezi","updated":"20240613134114"},"Children":[{"Type":"NodeText","Data":"（寓木）除热消积"}]},{"ID":"20240613134114-g5y6qfy","Type":"NodeParagraph","Properties":{"id":"20240613134114-g5y6qfy","updated":"20240613134114"},"Children":[{"Type":"NodeText","Data":"雷丸（专入胃）。味苦而咸。性寒小毒。本竹余气所结。得霹雳而生。故有雷丸之号。功专入胃除热。消积化虫。故凡湿热内郁。癫痫狂走。汗出恶风。虫积殆甚。腹大气胀。虫作人声者。服之即能有效。（虫在肝。令人恐怖。眼中赤壅。虫在心。令人心烦发燥。在脾使人劳热。四肢肿急。在肺使人咳嗽气喘。）以其秉性纯阴。兼味至苦。感其霹雳。故能去其邪魅也。所云惟利男子。不利妇人。亦以妇人属阴。故于阴物不宜耳。（志曰。久服令人阴痿。）究之果属肾热。亦又何碍？但无虫积。不得妄用。皮黑肉白者良。若肉紫黑者杀人。甘草水浸一宿。酒拌蒸。或泡用。浓朴芫花为使。恶葛根。（绣按纲目述杨 腹有小声应人。后读至本草雷丸不应。知为应声虫害。其说不无可疑。）"}]},{"ID":"20240613134103-7k64j8t","Type":"NodeThematicBreak","Properties":{"id":"20240613134103-7k64j8t"}},{"ID":"20240613134105-37p3j7z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134105-37p3j7z","updated":"20240613134109"},"Children":[{"Type":"NodeText","Data":"雷丸《增广和剂局方药性总论》"}]},{"ID":"20240613134105-3xpwh6j","Type":"NodeParagraph","Properties":{"id":"20240613134105-3xpwh6j","updated":"20240613134105"},"Children":[{"Type":"NodeText","Data":"味苦咸，寒、微寒，有小毒。主杀三虫，逐毒瓦斯，胃中热，利丈夫，不利女子，作摩除小儿百病，逐邪气，恶风汗出，除皮中热，结积，蛊毒，白虫寸白自出不止。久服令人痿，赤者杀人。《药性论》云∶君。味苦，有小毒。能逐风。芫花为使，主癫痫狂走，杀蛔虫。今注云∶疏利男子元气，不疏利女子脏气。荔实、浓朴为之使。恶∶葛根、蓄根。生∶石城及汉中。"}]},{"ID":"20240613134053-jrbxva8","Type":"NodeThematicBreak","Properties":{"id":"20240613134053-jrbxva8"}},{"ID":"20240613134054-nhv962v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134054-nhv962v","updated":"20240613134059"},"Children":[{"Type":"NodeText","Data":"雷丸《本经逢原》"}]},{"ID":"20240613134054-jwss56f","Type":"NodeParagraph","Properties":{"id":"20240613134054-jwss56f","updated":"20240613134054"},"Children":[{"Type":"NodeText","Data":"苦咸寒，小毒。竹之余气所结，皮黑肉白者良。入药泡用，赤黑色者杀人。"}]},{"ID":"20240613134054-u4iao66","Type":"NodeParagraph","Properties":{"id":"20240613134054-u4iao66","updated":"20240613134054"},"Children":[{"Type":"NodeText","Data":"《本经》杀三虫，逐毒瓦斯胃中热，利丈夫不利女子。"}]},{"ID":"20240613134054-9b423da","Type":"NodeParagraph","Properties":{"id":"20240613134054-9b423da","updated":"20240613134054"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"雷丸功专杀虫，杨 得异疾，每发语则腹中有小声，渐渐声大，有道士曰，此应声虫也。但读《本草》取不应者治之，读至雷丸不应，遂顿服数粒而愈，此追虫下积之验也。《本经》称其利丈夫，《别录》云久服阴痿，似乎相反，不知利者疏利之也。疏利太过则闭藏失职，故阴痿也。《千金》治小儿伤寒，不能服药。治方中恒用之，取其逐毒瓦斯之功也。"}]},{"ID":"20240613134041-4vbvcs8","Type":"NodeThematicBreak","Properties":{"id":"20240613134041-4vbvcs8"}},{"ID":"20240613134042-5h8catj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613134042-5h8catj","updated":"20240613134046"},"Children":[{"Type":"NodeText","Data":"雷丸《得配本草》"}]},{"ID":"20240613134042-5parylb","Type":"NodeParagraph","Properties":{"id":"20240613134042-5parylb","updated":"20240613134042"},"Children":[{"Type":"NodeText","Data":"浓朴、芫花、荔实为之使。恶葛根、 蓄。"}]},{"ID":"20240613134042-alvzyvk","Type":"NodeParagraph","Properties":{"id":"20240613134042-alvzyvk","updated":"20240613134042"},"Children":[{"Type":"NodeText","Data":"苦，寒。有小毒。入手足阳明经。燥脾除热，消积杀虫。（湿热除，虫之巢穴自倒。）"}]},{"ID":"20240613134042-eo4hcgz","Type":"NodeParagraph","Properties":{"id":"20240613134042-eo4hcgz","updated":"20240613134042"},"Children":[{"Type":"NodeText","Data":"甘草汁浸，酒拌蒸，或泡用。色赤者杀人。"}]},{"ID":"20240613134042-kt2f5k3","Type":"NodeParagraph","Properties":{"id":"20240613134042-kt2f5k3","updated":"20240613134042"},"Children":[{"Type":"NodeText","Data":"怪症∶皮肉生虫，行如蟹走，声如孩啼，此筋肉之化。用雷丸合雄黄各一两，为末，掺猪肉上炙熟食之。"}]},{"ID":"20240613133952-6ctpuet","Type":"NodeThematicBreak","Properties":{"id":"20240613133952-6ctpuet"}},{"ID":"20240613133953-s3tnro1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133953-s3tnro1","updated":"20240613133959"},"Children":[{"Type":"NodeText","Data":"雷丸《本草便读》"}]},{"ID":"20240613133953-hgsgrma","Type":"NodeParagraph","Properties":{"id":"20240613133953-hgsgrma","updated":"20240613133953"},"Children":[{"Type":"NodeText","Data":"得竹之余气．苦寒能清热杀虫．感雷而成苓．阴毒可入肝达胃．（雷丸竹之苓也．生于竹下土中．如猪苓茯苓之类．乃竹之余气．得天地郁蒸之气而成．其形如丸．苦寒有毒．杀虫辟邪之外．别无所长．其所入亦不过肝胃而已．）"}]},{"ID":"20240613133932-6nwc0sh","Type":"NodeThematicBreak","Properties":{"id":"20240613133932-6nwc0sh"}},{"ID":"20240613133933-3ian28e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133933-3ian28e","updated":"20240613133936"},"Children":[{"Type":"NodeText","Data":"雷丸《本草备要》"}]},{"ID":"20240613133933-9b760vo","Type":"NodeParagraph","Properties":{"id":"20240613133933-9b760vo","updated":"20240613133933"},"Children":[{"Type":"NodeText","Data":"泻，消积，杀虫"}]},{"ID":"20240613133933-iubwtk3","Type":"NodeParagraph","Properties":{"id":"20240613133933-iubwtk3","updated":"20240613133933"},"Children":[{"Type":"NodeText","Data":"苦寒有小毒。入胃、大肠经。功专消积杀虫（杨 得异疾，每发语，腹中有小声应之，久渐声大。有道士曰∶此应声虫也，但读本草，取不应者治之。读至雷丸，不应，服之而愈）。竹之余气，得霹雳而生，故名。大小如栗，竹刀刮去黑皮。甘草水浸一宿，酒拌蒸，或炮用。浓朴、芫花为使。恶葛根。"}]},{"ID":"20240613133357-zu0w6yn","Type":"NodeThematicBreak","Properties":{"id":"20240613133357-zu0w6yn"}},{"ID":"20240613133639-0mowd3o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133639-0mowd3o","updated":"20240613133645"},"Children":[{"Type":"NodeText","Data":"雷丸《本草乘雅半偈》"}]},{"ID":"20240613133639-drlwsbs","Type":"NodeParagraph","Properties":{"id":"20240613133639-drlwsbs","updated":"20240613133639"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613133639-n2nwedg","Type":"NodeParagraph","Properties":{"id":"20240613133639-n2nwedg","updated":"20240613133639"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，有小毒。"}]},{"ID":"20240613133639-5o4iowy","Type":"NodeParagraph","Properties":{"id":"20240613133639-5o4iowy","updated":"20240613133639"},"Children":[{"Type":"NodeText","Data":"【主治】主杀三虫，逐毒瓦斯、胃中热，利丈夫，不利女子。"}]},{"ID":"20240613133639-ogetaif","Type":"NodeParagraph","Properties":{"id":"20240613133639-ogetaif","updated":"20240613133639"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出石城山谷，及汉中、建平、宜都、房州、金州诸处。生竹林土中，乃竹之余气，零落所成也。无苗蔓，不相连，状如粟，又如猪苓而圆，皮黑肉白，甚坚实。修事，用甘草水浸一宿，取出，蒸之，从巳至未，日干。酒拌润，再蒸之，日干用。荔实、浓朴、蒿根、芫花为之使，恶葛根。"}]},{"ID":"20240613133639-pou1m9w","Type":"NodeParagraph","Properties":{"id":"20240613133639-pou1m9w","updated":"20240613133639"},"Children":[{"Type":"NodeText","Data":"【 】曰∶雷丸，竹苓也。具节候之灵气，零落复震，故名雷丸。盖雷之发声，物无不同时而应，故与三虫毒瓦斯向晦者反。其味苦，其气寒，对待胃热为因，诸热若伏若匿者，亦相宜矣。利丈夫，不利女子者，震为雷，长男也。所谓方以类聚，物以群分，刚柔断而吉凶生矣。"}]},{"ID":"20240613133639-rzyul3s","Type":"NodeParagraph","Properties":{"id":"20240613133639-rzyul3s","updated":"20240613134706"},"Children":[{"Type":"NodeText","Data":"（凡物有质成，有气结，如茯苓之本乎松，雷丸之因乎竹是也。木之耐岁寒，实而坚多节者，唯松性善隐伏，故遗苓名之；草之能冬生，虚而苍色者唯竹，象切震雷，故转丸名之，其气类所感，一静一动，一秉大夫贞洁之操，一展君子奋杨之力，其功用各有致也。）"}]},{"ID":"20240613133358-z1d9znw","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-z1d9znw"}},{"ID":"20240613133618-qbe08bh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133618-qbe08bh","updated":"20240613133622"},"Children":[{"Type":"NodeText","Data":"雷丸《名医别录》"}]},{"ID":"20240613133618-9dgvzjx","Type":"NodeParagraph","Properties":{"id":"20240613133618-9dgvzjx","updated":"20240613133618"},"Children":[{"Type":"NodeText","Data":"味咸，微寒，有小寒．逐邪气，恶风，汗出，除皮中热结，积聚蛊毒，白虫、寸白自出不止．久服令人阴痿．一名雷矢，一名雷实．赤者杀人．生石城及汉中土中．八月采根，曝干．（荔实、浓朴为之使，恶葛根．）"}]},{"ID":"20240613133618-kt43tlj","Type":"NodeParagraph","Properties":{"id":"20240613133618-kt43tlj","updated":"20240613133618"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶雷丸，味苦，寒．主杀三虫，逐毒瓦斯胃中热．利丈夫，不利女子．作摩膏，除小儿百病．"}]},{"ID":"20240613133358-zk7r738","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-zk7r738"}},{"ID":"20240613133608-thaecdl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133608-thaecdl","updated":"20240613133612"},"Children":[{"Type":"NodeText","Data":"雷丸《本草崇原》"}]},{"ID":"20240613133608-6embopo","Type":"NodeParagraph","Properties":{"id":"20240613133608-6embopo","updated":"20240613133608"},"Children":[{"Type":"NodeText","Data":"气味苦寒，有小毒。主杀三虫，逐毒瓦斯，胃中热，利丈夫，不利女子。"}]},{"ID":"20240613133608-8rgn1ih","Type":"NodeParagraph","Properties":{"id":"20240613133608-8rgn1ih","updated":"20240613133608"},"Children":[{"Type":"NodeText","Data":"（雷丸出汉中、建平、宜都及房州、金州诸处，生竹林土中，乃竹之余气所结，故一名竹苓。上无苗蔓，大小如栗，状似猪苓而圆，皮黑而微赤，肉白甚坚实。）"}]},{"ID":"20240613133608-1ozj4d4","Type":"NodeParagraph","Properties":{"id":"20240613133608-1ozj4d4","updated":"20240613133608"},"Children":[{"Type":"NodeText","Data":"雷丸是竹之余气，感雷震而生，竹茎叶青翠，具东方生发之义。震为雷，乃阳动于下，雷丸气味苦寒，禀冬令寒水之精，得东方震动之气，故杀阴类之三虫，而逐邪毒之气，得寒水之精，故清胃中热。震为雷，为长男，故利丈夫，不利女子。"}]},{"ID":"20240613133608-t0zymmq","Type":"NodeParagraph","Properties":{"id":"20240613133608-t0zymmq","updated":"20240613133608"},"Children":[{"Type":"NodeText","Data":"（按∶《别录》云∶雷丸久服令人阴痿，当是气味苦寒，久服则精寒故耳。男子多服阳痿，则女子久服子宫寒冷，不能受孕，其不利可知。《本经》乃两分之曰∶利丈夫，不利女子，未审何义。马志云∶疏利男子元气，不疏利女子脏气。隐庵以震为雷，为长男为解，均未得当，尚当另参。）"}]},{"ID":"20240613133358-8eo99wx","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-8eo99wx"}},{"ID":"20240613133557-5eqcn1j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133557-5eqcn1j","updated":"20240613133602"},"Children":[{"Type":"NodeText","Data":"雷丸《本草从新》"}]},{"ID":"20240613133557-pdsngba","Type":"NodeParagraph","Properties":{"id":"20240613133557-pdsngba","updated":"20240613133557"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻、消积杀虫．"}]},{"ID":"20240613133557-s01o68h","Type":"NodeParagraph","Properties":{"id":"20240613133557-s01o68h","updated":"20240613133557"},"Children":[{"Type":"NodeText","Data":"苦寒有小毒．入胃、大肠经．功专消积杀虫．（遁斋闲览云∶杨 得异疾、每发语、腹中有小声应之、久渐声大、有道士曰∶此应声虫也、但读本草、取不应者治之、读至雷丸不应、服数粒而愈．）杀虫之外无他长．能令人阴痿．竹之余气．得霹雳而生．故名．大小如栗．"}]},{"ID":"20240613133557-rpsqejf","Type":"NodeParagraph","Properties":{"id":"20240613133557-rpsqejf","updated":"20240613133557"},"Children":[{"Type":"NodeText","Data":"竹刀刮去黑皮．甘草水浸一宿．酒拌蒸或炮．浓朴、芫花为使．恶葛根．（小儿出汗有热、雷丸末二两、粉四两、扑之．）"}]},{"ID":"20240613133358-ob7yn7j","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-ob7yn7j"}},{"ID":"20240613133549-6xx87yo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133549-6xx87yo","updated":"20240613133552"},"Children":[{"Type":"NodeText","Data":"雷丸《本草述钩元》"}]},{"ID":"20240613133549-iyc6xra","Type":"NodeParagraph","Properties":{"id":"20240613133549-iyc6xra","updated":"20240613133549"},"Children":[{"Type":"NodeText","Data":"雷斧雷楔。皆霹雳击物。精气所化。是物生土中。无苗叶。而杀虫逐邪。犹雷之丸也。竹之余气所结。故又名竹苓。（濒湖）大小如栗。状类猪苓而圆。皮黑肉白。甚坚实。（又）赤者杀人。白者善。（贞白）气味甘。微苦。微寒。有小毒。主行胃热。除皮中热结。逐风逐毒。解蛊杀虫。治癫痫狂走。利丈夫。不利女子。（非利益之利。乃疏利男子元气。不疏利女子脏气。故久服阴痿也。）久服阴痿。作摩积之膏。能疗小儿百病。下寸白虫。治应声虫。小儿出汗有热。雷丸四两。粉半斤。为末。扑之。下寸白虫。雷丸水浸。去皮。切。焙为末。五更初。食炙肉少许。以稀粥饮服一钱匕。须上半月服。虫乃下。"}]},{"ID":"20240613133549-xpzzp1g","Type":"NodeParagraph","Properties":{"id":"20240613133549-xpzzp1g","updated":"20240613133549"},"Children":[{"Type":"NodeText","Data":"〔论〕雷丸为竹之余气所结。夫竹引根于秋深。孕笋于冬半。是禀清寒以生。合于金水之阴以在下者。兹味本清阴之气味。而又能疏利。取以行气血之热。岂非良剂。第通用不无有伤元气耳。"}]},{"ID":"20240613133549-5uydbah","Type":"NodeParagraph","Properties":{"id":"20240613133549-5uydbah","updated":"20240613133549"},"Children":[{"Type":"NodeText","Data":"〔辨治〕切忌赤色者。入药炮用。"}]},{"ID":"20240613133358-b64p24x","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-b64p24x"}},{"ID":"20240613133539-lnrofwn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133539-lnrofwn","updated":"20240613133543"},"Children":[{"Type":"NodeText","Data":"雷丸《千金翼方》"}]},{"ID":"20240613133539-whqmweu","Type":"NodeParagraph","Properties":{"id":"20240613133539-whqmweu","updated":"20240613133539"},"Children":[{"Type":"NodeText","Data":"味苦咸，寒，微寒，有小毒。主杀三虫，逐毒瓦斯，胃中热，利丈夫，不利女子。作摩膏，除小儿百病。逐邪气，恶风汗出，除皮中热结，积蛊毒，白虫寸白，自出不止。久服令阴痿。"}]},{"ID":"20240613133539-grpo5oj","Type":"NodeParagraph","Properties":{"id":"20240613133539-grpo5oj","updated":"20240613133539"},"Children":[{"Type":"NodeText","Data":"一名雷失，一名雷实。赤者杀人。生石城山谷及汉中土中，八月采根，曝干。"}]},{"ID":"20240613133358-gyesmd8","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-gyesmd8"}},{"ID":"20240613133529-3kuqwz9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133529-3kuqwz9","updated":"20240613133534"},"Children":[{"Type":"NodeText","Data":"雷丸《冯氏锦囊秘录》"}]},{"ID":"20240613133529-oh3lfb9","Type":"NodeParagraph","Properties":{"id":"20240613133529-oh3lfb9","updated":"20240613133529"},"Children":[{"Type":"NodeText","Data":"禀竹之余气，得霹雳而生，故名雷丸，味苦咸，性微寒，有小毒，入手足阳明经。"}]},{"ID":"20240613133529-mxuu4nj","Type":"NodeParagraph","Properties":{"id":"20240613133529-mxuu4nj","updated":"20240613133529"},"Children":[{"Type":"NodeText","Data":"苦寒之性故入肠胃而为温热杀虫，化积解毒除狂之用，利丈夫不利女子者，盖以男子属阳，得阴而生，故喜阴寒之味，女子属阴，得阳而长，故不利阴寒之物也。宜择白者可用，盖赤者杀人，甘草汁浸一宿，去皮用。"}]},{"ID":"20240613133529-hwe8p2g","Type":"NodeParagraph","Properties":{"id":"20240613133529-hwe8p2g","updated":"20240613133529"},"Children":[{"Type":"NodeText","Data":"雷丸，胃热可解，蛊毒能驱，善杀三虫，仍杀白虫，惟治男人，不治女子，主癫痫狂走，疗汗出恶风，又作磨积之膏，专却小儿百病，无虫积者禁之。"}]},{"ID":"20240613133358-e5jt91w","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-e5jt91w"}},{"ID":"20240613133510-qq14dao","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133510-qq14dao","updated":"20240613133519"},"Children":[{"Type":"NodeText","Data":"雷丸《本草简要方》"}]},{"ID":"20240613133510-phx35gg","Type":"NodeParagraph","Properties":{"id":"20240613133510-phx35gg","updated":"20240613133510"},"Children":[{"Type":"NodeText","Data":"主治。消积。杀虫。祛风。解毒。治癫痫狂走。杀寸白虫。小儿百病。久服阴痿。雷丸丸。雷丸（炮）橘皮桃仁（麸炒）各一两二钱五分。贯众五钱。白芜荑（炒）青葙子（炒）干漆（炒令烟尽）各一两。野狼牙一两五钱。乱发（如鸡子大烧为灰）研末。蜜丸梧子大。每空腹早晚各以温酒下十五丸。治心脏劳热生蛊。贯心作痛。又方。生雷丸生鹤虱生使君子胡黄连（微炒）芦荟各五钱。麝香五分。蟾一枚（陈酒浸一宿。慢火炙熟去皮足骨焙干）木香肉豆蔻各一分。芜荑一两。朱砂二钱。（留少许为衣）研末猪胆四个取汁。入瓷盏中重汤煮过。和杵为丸。黍米大。每服五至七丸。麦冬汤下。日三次。治小儿疳。"}]},{"ID":"20240613133358-zfafyr2","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-zfafyr2"}},{"ID":"20240613133435-grct99h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133435-grct99h","updated":"20240613133515"},"Children":[{"Type":"NodeText","Data":"雷丸《中药学》"}]},{"ID":"20240613133435-7yejaq0","Type":"NodeParagraph","Properties":{"id":"20240613133435-7yejaq0","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【药用】白蘑科真菌雷丸OmphalialapidescensSchroet的菌核。"}]},{"ID":"20240613133435-2u9t5um","Type":"NodeParagraph","Properties":{"id":"20240613133435-2u9t5um","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒；有小毒。归胃、大肠经。"}]},{"ID":"20240613133435-an15bh9","Type":"NodeParagraph","Properties":{"id":"20240613133435-an15bh9","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【功效】杀虫。"}]},{"ID":"20240613133435-6l6l8jp","Type":"NodeParagraph","Properties":{"id":"20240613133435-6l6l8jp","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于线虫，蛔虫，钩虫等病"}]},{"ID":"20240613133435-7k97r00","Type":"NodeParagraph","Properties":{"id":"20240613133435-7k97r00","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"雷丸能在肠道内破坏虫体，用治绦虫，有较好的疗效。不论有钩绦虫、无钩绦虫都可应用。也可用治蛔虫病。临床可以单独应用，也可配合槟榔、使君子肉、乌梅等同用。"}]},{"ID":"20240613133435-yr48zsl","Type":"NodeParagraph","Properties":{"id":"20240613133435-yr48zsl","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【处方用名】雷丸（洗净，晒干用）。"}]},{"ID":"20240613133435-8piea4a","Type":"NodeParagraph","Properties":{"id":"20240613133435-8piea4a","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】每次6g，研粉吞服，每日2～3次，连服2～3天。"}]},{"ID":"20240613133435-1hvribp","Type":"NodeParagraph","Properties":{"id":"20240613133435-1hvribp","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【按语】雷丸以形成名。苦寒有小毒，功专于杀虫，祛绦为主，兼及蛔既可单用，有可配伍应用。本品研粉吞服。杀虫作用良好。如入煎剂，每因高热而有效成分遭到破坏，必须注意。"}]},{"ID":"20240613133435-1k66suc","Type":"NodeParagraph","Properties":{"id":"20240613133435-1k66suc","updated":"20240613133435"},"Children":[{"Type":"NodeText","Data":"【方剂举例】追虫丸（《证治准绳》）雷丸、槟榔、牵牛子、木香。治一切虫积。"}]},{"ID":"20240613133358-8ng6qs3","Type":"NodeThematicBreak","Properties":{"id":"20240613133358-8ng6qs3"}},{"ID":"20240613133359-bglaqrn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133359-bglaqrn","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"《中国药典》：雷丸"}]},{"ID":"20240613133359-0oexua9","Type":"NodeParagraph","Properties":{"id":"20240613133359-0oexua9","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613133359-z19ifnb","Type":"NodeParagraph","Properties":{"id":"20240613133359-z19ifnb","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" Léi Wán"}]},{"ID":"20240613133359-mz69h8d","Type":"NodeParagraph","Properties":{"id":"20240613133359-mz69h8d","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613133359-6rwaonk","Type":"NodeParagraph","Properties":{"id":"20240613133359-6rwaonk","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 竹苓、雷实、竹铃芝"}]},{"ID":"20240613133359-n6ah49z","Type":"NodeParagraph","Properties":{"id":"20240613133359-n6ah49z","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613133359-kx39by0","Type":"NodeParagraph","Properties":{"id":"20240613133359-kx39by0","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" OMPHALIA"}]},{"ID":"20240613133359-zwj99pq","Type":"NodeParagraph","Properties":{"id":"20240613133359-zwj99pq","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613133359-s5m7iqu","Type":"NodeParagraph","Properties":{"id":"20240613133359-s5m7iqu","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 本品为白蘑科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"真菌雷丸"},{"Type":"NodeText","Data":"Omphalia lapidescens Schroet. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菌核"},{"Type":"NodeText","Data":"。秋季采挖，洗净，晒干。"}]},{"ID":"20240613133359-uc5qfer","Type":"NodeParagraph","Properties":{"id":"20240613133359-uc5qfer","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613133359-ctgveyh","Type":"NodeParagraph","Properties":{"id":"20240613133359-ctgveyh","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 本品为类球形或不规则团块，直径1～3cm。表面黑褐色或灰褐色，有略隆起的网状细纹。质坚实，不易破裂，断面不平坦，白色或浅灰黄色，似粉状或颗粒状，常有黄棕色大理石样纹理。无臭，味微苦，嚼之有颗粒感，微带黏性，久嚼无渣。断面色褐呈角质样者，不可供药用。"}]},{"ID":"20240613133359-oaq2ypg","Type":"NodeParagraph","Properties":{"id":"20240613133359-oaq2ypg","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613133359-ffhaymh","Type":"NodeParagraph","Properties":{"id":"20240613133359-ffhaymh","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240613133359-k5fzncw","Type":"NodeParagraph","Properties":{"id":"20240613133359-k5fzncw","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613133359-wrw4su7","Type":"NodeParagraph","Properties":{"id":"20240613133359-wrw4su7","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 洗净，晒干，粉碎。不得蒸煮或高温烘烤。"}]},{"ID":"20240613133359-kt08dbw","Type":"NodeParagraph","Properties":{"id":"20240613133359-kt08dbw","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613133359-auzkn0t","Type":"NodeParagraph","Properties":{"id":"20240613133359-auzkn0t","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末淡灰色。菌丝粘结成大小不一的不规则团块，无色，少数黄棕色或棕红色。散在的菌丝较短，有分枝，直径约4μm。草酸钙方晶细小，直径约至8μm，有的聚集成群。加硫酸后可见多量针状结晶。"}]},{"ID":"20240613133359-hkhsz1v","Type":"NodeParagraph","Properties":{"id":"20240613133359-hkhsz1v","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"（2）刮取本品外层黑褐色菌丝体少量，加氢氧化钠试液 1滴，即显樱红色，再加盐酸使呈酸性，则变黄色。"}]},{"ID":"20240613133359-l3mgo42","Type":"NodeParagraph","Properties":{"id":"20240613133359-l3mgo42","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613133359-krabjea","Type":"NodeParagraph","Properties":{"id":"20240613133359-krabjea","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 归胃、大肠经。"}]},{"ID":"20240613133359-qv5bork","Type":"NodeParagraph","Properties":{"id":"20240613133359-qv5bork","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613133359-sy3x5yp","Type":"NodeParagraph","Properties":{"id":"20240613133359-sy3x5yp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 微苦，寒。"}]},{"ID":"20240613133359-w5dy89k","Type":"NodeParagraph","Properties":{"id":"20240613133359-w5dy89k","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613133359-13bzd2g","Type":"NodeParagraph","Properties":{"id":"20240613133359-13bzd2g","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 杀虫消积，用于绦虫、钩虫、蛔虫病，虫积腹痛，小儿疳积。"}]},{"ID":"20240613133359-h8891dg","Type":"NodeParagraph","Properties":{"id":"20240613133359-h8891dg","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613133359-zwb2dph","Type":"NodeParagraph","Properties":{"id":"20240613133359-zwb2dph","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 15～21g，不宜入煎剂，一般研粉服。一次5～7g，饭后用温开水调服，一日3次，连服3天。"}]},{"ID":"20240613133359-uilegkj","Type":"NodeParagraph","Properties":{"id":"20240613133359-uilegkj","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613133359-if7eghy","Type":"NodeParagraph","Properties":{"id":"20240613133359-if7eghy","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613133359-h55tzra","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613133359-h55tzra","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：雷丸"}]},{"ID":"20240613133359-n1w4jjv","Type":"NodeParagraph","Properties":{"id":"20240613133359-n1w4jjv","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613133359-nai6gci","Type":"NodeParagraph","Properties":{"id":"20240613133359-nai6gci","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" Léi Wán"}]},{"ID":"20240613133359-795febq","Type":"NodeParagraph","Properties":{"id":"20240613133359-795febq","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613133359-4y5ngbo","Type":"NodeParagraph","Properties":{"id":"20240613133359-4y5ngbo","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 雷矢（《范子计然》），雷实（《吴普本草》），竹苓（《纲目》），竹林子、竹铃芝（《中药志》），木连子（《广西中药志》）。"}]},{"ID":"20240613133359-6bs50iw","Type":"NodeParagraph","Properties":{"id":"20240613133359-6bs50iw","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613133359-7an5v7s","Type":"NodeParagraph","Properties":{"id":"20240613133359-7an5v7s","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613133359-qg1bolc","Type":"NodeParagraph","Properties":{"id":"20240613133359-qg1bolc","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613133359-1iivit9","Type":"NodeParagraph","Properties":{"id":"20240613133359-1iivit9","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 为多孔菌科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雷丸菌"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菌核"},{"Type":"NodeText","Data":"。春、秋、冬皆可采收，但以秋季为多，选枝叶枯黄的病竹，挖取根部菌核。采收后洗净，晒干。"}]},{"ID":"20240613133359-9v9oksp","Type":"NodeParagraph","Properties":{"id":"20240613133359-9v9oksp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613133359-0qx6ggu","Type":"NodeParagraph","Properties":{"id":"20240613133359-0qx6ggu","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 多寄生于病竹根部。分布长江流域以南各省及甘肃、陕西、湖北、河南等地。主产四川、贵州、云南、湖北、广西、陕西。此外，浙江、湖南、广东、安徽、福建等省亦产。"}]},{"ID":"20240613133359-gyx4yqr","Type":"NodeParagraph","Properties":{"id":"20240613133359-gyx4yqr","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613133359-gndvin2","Type":"NodeParagraph","Properties":{"id":"20240613133359-gndvin2","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 菌核体通常为不规则的坚硬块状，歪球形或歪卵形，直径0.8～2.5厘米，罕达4厘米，表面黑棕色，具细密的纵纹；内面为紧密交织的菌丝体，蜡白色，半透明而略带粘性，具同色的纹理。越冬后由菌核体发出新的子实体，一般不易见到。"}]},{"ID":"20240613133359-d4zrw67","Type":"NodeParagraph","Properties":{"id":"20240613133359-d4zrw67","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613133359-iah1fe2","Type":"NodeParagraph","Properties":{"id":"20240613133359-iah1fe2","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 干燥的菌核为球形或不规则的圆块状，大小不等，直径1～2厘米。表面呈紫褐色或灰褐色，全体有稍隆起的网状皱纹。质坚实而重，不易破裂；击开后断面不平坦，粉白色或淡灰黄色，呈颗粒状或粉质。质紧密者为半透明状，可见有半透明与不透明部分交错成纹理。气无，味淡，嚼之初有颗粒样感觉，微带粘液性，久嚼则溶化而无残渣。以个大、饱满、质坚、外紫褐色、内白色、无泥沙者为佳。"}]},{"ID":"20240613133359-5vvnlc2","Type":"NodeParagraph","Properties":{"id":"20240613133359-5vvnlc2","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613133359-lkzmcwc","Type":"NodeParagraph","Properties":{"id":"20240613133359-lkzmcwc","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 含水分6.5％，灰分4.0％，醚浸出物0.6％，醇浸出物22％。"}]},{"ID":"20240613133359-a0zl9kp","Type":"NodeParagraph","Properties":{"id":"20240613133359-a0zl9kp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"主要成分是一种蛋白酶称雷丸素，含量约3％，为驱绦虫有效成分，加热失效。此酶在pH8溶液中作用最强，酸性溶液中无效，0.06微克在10毫升弱碱性（pH8）溶液中即有分解蛋白质作用。"}]},{"ID":"20240613133359-966jjtr","Type":"NodeParagraph","Properties":{"id":"20240613133359-966jjtr","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613133359-bi4qgbp","Type":"NodeParagraph","Properties":{"id":"20240613133359-bi4qgbp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" ①驱绦虫作用"}]},{"ID":"20240613133359-a0yrpfi","Type":"NodeParagraph","Properties":{"id":"20240613133359-a0yrpfi","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"将未用药自然排出的绦虫节片置于37℃的5～30％雷丸浸出液中，快的在2小时40分钟，慢的在9小时后均致死亡，但放在生理盐水中可以生存40～62小时，放在蒸馏水中亦可生存24～30小时。雷丸对人感染有钩及无钩绦虫，犬绦虫均有驱虫作用。把服用雷丸后排出的虫体，放在微温生理盐水中，大多数是不会活动的，其细节部被破坏的程度最为显着，因此雷丸的驱绦虫作用不是麻痹虫体，而是由于雷丸中的蛋白酶对蛋白质的分解，致虫节破坏所致。"}]},{"ID":"20240613133359-6c47sfw","Type":"NodeParagraph","Properties":{"id":"20240613133359-6c47sfw","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②对蛔虫的作用"}]},{"ID":"20240613133359-hg85cbh","Type":"NodeParagraph","Properties":{"id":"20240613133359-hg85cbh","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"体外试验对猪蛔虫有效，但对蛔虫感染者无效。"}]},{"ID":"20240613133359-hwtdpns","Type":"NodeParagraph","Properties":{"id":"20240613133359-hwtdpns","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③抗阴道毛滴虫作用"}]},{"ID":"20240613133359-4xics4v","Type":"NodeParagraph","Properties":{"id":"20240613133359-4xics4v","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"10％的雷丸煎剂，药液与培养基成1：1的浓度，5分钟后大部分虫体颗粒化变形，个别虫体仍有活动。"}]},{"ID":"20240613133359-u3j63o0","Type":"NodeParagraph","Properties":{"id":"20240613133359-u3j63o0","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613133359-24ay216","Type":"NodeParagraph","Properties":{"id":"20240613133359-24ay216","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，洗净润透，切片晒干；或洗净晒干，用时捣碎。"}]},{"ID":"20240613133359-zo0nvt0","Type":"NodeParagraph","Properties":{"id":"20240613133359-zo0nvt0","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使霄丸，用甘草水浸一夜，铜刀刮上黑皮，破作四、五片。又用甘草汤浸一宿后蒸，从巳至未出。日干，却以酒拌，如前从巳至未蒸，日干用。\""}]},{"ID":"20240613133359-qyshfgq","Type":"NodeParagraph","Properties":{"id":"20240613133359-qyshfgq","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613133359-mun7p3q","Type":"NodeParagraph","Properties":{"id":"20240613133359-mun7p3q","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 入胃、大肠经。"}]},{"ID":"20240613133359-q5o0efm","Type":"NodeParagraph","Properties":{"id":"20240613133359-q5o0efm","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"入手、足阳明经。\""}]},{"ID":"20240613133359-gsd1tps","Type":"NodeParagraph","Properties":{"id":"20240613133359-gsd1tps","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、脾、胃三经。\""}]},{"ID":"20240613133359-991xde8","Type":"NodeParagraph","Properties":{"id":"20240613133359-991xde8","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③《玉楸药解》：\"入手少阴心、足厥阴肝经。\""}]},{"ID":"20240613133359-cpnhcgb","Type":"NodeParagraph","Properties":{"id":"20240613133359-cpnhcgb","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613133359-glw93el","Type":"NodeParagraph","Properties":{"id":"20240613133359-glw93el","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 苦，寒，有小毒。"}]},{"ID":"20240613133359-zu5bxsh","Type":"NodeParagraph","Properties":{"id":"20240613133359-zu5bxsh","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240613133359-wuzhysp","Type":"NodeParagraph","Properties":{"id":"20240613133359-wuzhysp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"咸，微寒，有小毒。"}]},{"ID":"20240613133359-89jj3c6","Type":"NodeParagraph","Properties":{"id":"20240613133359-89jj3c6","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘微苦，平。\""}]},{"ID":"20240613133359-yuwqh99","Type":"NodeParagraph","Properties":{"id":"20240613133359-yuwqh99","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"苦酸咸，寒。\""}]},{"ID":"20240613133359-oa4oud2","Type":"NodeParagraph","Properties":{"id":"20240613133359-oa4oud2","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613133359-36k8kg4","Type":"NodeParagraph","Properties":{"id":"20240613133359-36k8kg4","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 有虫积而脾胃虚寒者慎服。"}]},{"ID":"20240613133359-9y5decf","Type":"NodeParagraph","Properties":{"id":"20240613133359-9y5decf","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"久服令人阴痿。赤者杀人。\""}]},{"ID":"20240613133359-ocbm3w9","Type":"NodeParagraph","Properties":{"id":"20240613133359-ocbm3w9","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"荔实、厚朴为之使。恶葛根。\""}]},{"ID":"20240613133359-195wq2c","Type":"NodeParagraph","Properties":{"id":"20240613133359-195wq2c","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"恶（萹）蓄、（葛）根。芫花为使。\""}]},{"ID":"20240613133359-ts5sdge","Type":"NodeParagraph","Properties":{"id":"20240613133359-ts5sdge","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"④《医学入门》：\"久服伤阴，男女同。\""}]},{"ID":"20240613133359-hbvvjb7","Type":"NodeParagraph","Properties":{"id":"20240613133359-hbvvjb7","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"⑤《本草汇言》：\"如病虫积日久，脾胃衰惫者，亦禁用之。\""}]},{"ID":"20240613133359-jw5nr98","Type":"NodeParagraph","Properties":{"id":"20240613133359-jw5nr98","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613133359-6h2pubi","Type":"NodeParagraph","Properties":{"id":"20240613133359-6h2pubi","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 消积，杀虫。治虫积腹痛，疳疾，风痫。"}]},{"ID":"20240613133359-smx1ihn","Type":"NodeParagraph","Properties":{"id":"20240613133359-smx1ihn","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主杀三虫，逐毒气，胃中热，利丈夫，不利女子，作摩膏，除小儿百病。\""}]},{"ID":"20240613133359-fdkbxr6","Type":"NodeParagraph","Properties":{"id":"20240613133359-fdkbxr6","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"逐邪气，恶风汗出，除皮中热、结积，白虫、寸白自出不止。\""}]},{"ID":"20240613133359-ql3d5zn","Type":"NodeParagraph","Properties":{"id":"20240613133359-ql3d5zn","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能逐风，主癫痫狂走，杀蛔虫。\""}]},{"ID":"20240613133359-y2o3rsp","Type":"NodeParagraph","Properties":{"id":"20240613133359-y2o3rsp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"④《玉楸药解》：\"清热疏肝，杀寸白虫，躯风除痫，止小儿汗。\""}]},{"ID":"20240613133359-lr62to2","Type":"NodeParagraph","Properties":{"id":"20240613133359-lr62to2","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"⑤《陕西中药志》：\"消积杀虫，清热解毒。治虫积腹痛，小儿疳积，胃中热，对绦虫病疗效较显着。\""}]},{"ID":"20240613133359-ufr705h","Type":"NodeParagraph","Properties":{"id":"20240613133359-ufr705h","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613133359-7b65g82","Type":"NodeParagraph","Properties":{"id":"20240613133359-7b65g82","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～3钱；或入丸、散。外用：研粉扑或煎水洗。"}]},{"ID":"20240613133359-vcz9czz","Type":"NodeParagraph","Properties":{"id":"20240613133359-vcz9czz","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613133359-kbxh4hr","Type":"NodeParagraph","Properties":{"id":"20240613133359-kbxh4hr","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" ①下寸白虫：雷丸一味，水浸软去皮，切焙干为末，每有疾者，五更初先食炙肉少许，便以一钱匕药，稀粥调半钱服之。（《经验前方》）"}]},{"ID":"20240613133359-dign8hy","Type":"NodeParagraph","Properties":{"id":"20240613133359-dign8hy","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②治三虫：雷丸（炮）一两，芎藭一两。上二味捣罗为细散，每服一钱匕，空腹煎粟米饮调下，日午、近晚各一服。（《圣济总录》雷丸散）"}]},{"ID":"20240613133359-kktn7tc","Type":"NodeParagraph","Properties":{"id":"20240613133359-kktn7tc","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③消疳杀虫：雷丸、使君子（炮，去壳）、鹤虱、榧子肉、槟榔各等分。上药为细末，每服一钱，温米饮调下，乳食前。（《杨氏家藏方》雷丸散）"}]},{"ID":"20240613133359-mhv93lc","Type":"NodeParagraph","Properties":{"id":"20240613133359-mhv93lc","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"④治小儿风痫，掣疭戴眼，极者日数十发：雷丸、莽草各如鸡子黄大，猪脂一斤。上先煎猪脂去滓，下药，微火上煎七沸，去滓，逐痛处摩之，小儿不知痛处，先摩腹背，乃摩余处五十遍，勿近朋及目，一岁以帛包膏摩微炙身。及治大人贼风。（《普济方》雷丸膏）"}]},{"ID":"20240613133359-bzo7r5o","Type":"NodeParagraph","Properties":{"id":"20240613133359-bzo7r5o","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"⑤治小儿寒热，惊啼不安：雷丸三分，牡蛎三分，黄芩三分，细辛三分，蛇床子一两。上药以水一斗，煎取七升，去滓，分为两度，看冷暖，用，先令浴儿头，勿令水入耳目，次浴背膊，后浴腰以下，浴讫避风，以粉扑之。（《圣惠方》雷丸浴汤）"}]},{"ID":"20240613133359-houitn7","Type":"NodeParagraph","Properties":{"id":"20240613133359-houitn7","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"⑥治少小有热不汗：雷丸四两，粉半斤。捣和下筛，以粉儿身。（《千金方》二物通汗散）"}]},{"ID":"20240613133359-uw0c9jp","Type":"NodeParagraph","Properties":{"id":"20240613133359-uw0c9jp","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"⑦治风瘙皮肤瘾疹疼痛：雷丸，人参、苦参、牛膝（润、浸，切，焙）、白附子（炮）、防风（去叉）、白花蛇（润、浸，去皮、骨，炙）、甘草（炙，锉）各二两，丹参一两半。上九味捣罗为散，每服二钱匕，食前温酒调下。（《圣济总录》）雷丸散）"}]},{"ID":"20240613133359-recq3ys","Type":"NodeParagraph","Properties":{"id":"20240613133359-recq3ys","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"⑧治牡痔生鼠乳疮：雷丸、鹤虱（炒），白矾灰各一两，皂荚针灰、舶上硫黄（研）各半两。上五味，捣研为散，醋煮面糊丸，如梧桐子大，以雄黄末为衣；每服二十丸，空心食前麝香温酒下。（《圣济总录》雷丸散）"}]},{"ID":"20240613133359-bbu69f3","Type":"NodeParagraph","Properties":{"id":"20240613133359-bbu69f3","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613133359-v3r39qs","Type":"NodeParagraph","Properties":{"id":"20240613133359-v3r39qs","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" ①治疗绦虫病"}]},{"ID":"20240613133359-o4g2rsw","Type":"NodeParagraph","Properties":{"id":"20240613133359-o4g2rsw","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"取雷丸制成粉剂，每次20克，以凉开水加糖少许调服。每日3次，连服3日。第4天服硫酸镁15～20克（不服亦可）。临床观察20例，虫体多在第2、3日全部或分段排下，治疗后复查未见虫体，全部症状消失。"}]},{"ID":"20240613133359-3v0dfhs","Type":"NodeParagraph","Properties":{"id":"20240613133359-3v0dfhs","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②治疗钩虫病"}]},{"ID":"20240613133359-ib9s66a","Type":"NodeParagraph","Properties":{"id":"20240613133359-ib9s66a","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"取雷丸研成极细末，加适量乳糖或葡萄糖粉用开水调服。成人每剂60克，1次顿服或3次分服（体弱者可分2～3日服完），隔几天再服1剂。临床试治11例，服药2次以上经1～3次大便检查，除2例找到少量虫卵外，其余均阴转。但亦有观察19例，连服2次后复查，结果不管淘虫及粪检虫卵都不够满意。"}]},{"ID":"20240613133359-x78om9m","Type":"NodeParagraph","Properties":{"id":"20240613133359-x78om9m","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③治疗蛲虫病"}]},{"ID":"20240613133359-dl2wguy","Type":"NodeParagraph","Properties":{"id":"20240613133359-dl2wguy","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"取雷丸1钱，大黄3钱，二丑3钱，共研细末混匀，晨起空腹时用冷开水1次送服。小儿可按年龄递减。临床治疗188例，除2例无效外，其余均治愈。一般在服药后1～2日即可排虫，随之自觉症状消失。服药期间有13例发现短暂而轻微的腹痛。"}]},{"ID":"20240613133359-g9q9lo3","Type":"NodeParagraph","Properties":{"id":"20240613133359-g9q9lo3","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613133359-ye00z2t","Type":"NodeParagraph","Properties":{"id":"20240613133359-ye00z2t","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"雷丸，其主杀三虫，白虫、寸白自出者，肠胃湿热甚也。逐毒气，胃中热邪气，恶风，汗出，皮中热结积者，肠胃邪热盛也，苦寒能除二经（手足阳明）湿热邪气，则上来诸证自除。作摩膏治小儿百病者，以小儿好食甘肥，肠胃类多湿热虫积，苦能杀虫除湿，咸寒能清热消积，故主之也。《别录》又云，久服令人阴痿，正见其过于苦寒，偏至之气，能令阳道痿也。\"\"除杀虫外，它用甚稀。\""}]},{"ID":"20240613133359-ifeu1ol","Type":"NodeParagraph","Properties":{"id":"20240613133359-ifeu1ol","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"②《本草述》：\"雷丸，为竹之余气所结。缘清阴之气味而又能疏利，其于行气血之热，岂非良剂。第通用不无有伤元气也。悉此义则能善用此味矣。\""}]},{"ID":"20240613133359-5tpsjt1","Type":"NodeParagraph","Properties":{"id":"20240613133359-5tpsjt1","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"雷丸，《千金》治小儿伤寒，不能服药，治方中恒用之，取其逐毒气之功也。\""}]},{"ID":"20240613133359-l4toxfg","Type":"NodeParagraph","Properties":{"id":"20240613133359-l4toxfg","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613133359-v79ro4g","Type":"NodeParagraph","Properties":{"id":"20240613133359-v79ro4g","updated":"20240613133359"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613133400-1z73g76","Type":"NodeThematicBreak","Properties":{"id":"20240613133400-1z73g76"}},{"ID":"20240613133402-o0ygnas","Type":"NodeParagraph","Properties":{"id":"20240613133402-o0ygnas"}}]}