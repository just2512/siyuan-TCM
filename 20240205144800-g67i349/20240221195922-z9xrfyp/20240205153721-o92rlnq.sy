{"ID":"20240205153721-o92rlnq","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240205153721-o92rlnq","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153721-o92rlnq\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240205162429-k7ezbnf\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613133402-o0ygnas\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240702132820-y8jvc69\u0026quot;,\u0026quot;focusStart\u0026quot;:29,\u0026quot;focusEnd\u0026quot;:29\u0026#125;","title":"320雷丸（竹苓）","type":"doc","updated":"20240826175951"},"Children":[{"ID":"20240205162429-k7ezbnf","Type":"NodeParagraph","Properties":{"id":"20240205162429-k7ezbnf","updated":"20240702132951"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 367px;","style":"width: 357px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"雷丸"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/雷丸-20240205162429-pa0stql.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 357px;\" parent-style=\"width: 367px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 374px;","style":"width: 364px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702132951-1p5umxn.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 364px;\" parent-style=\"width: 374px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240702133057-cd2lxa1","Type":"NodeParagraph","Properties":{"id":"20240702133057-cd2lxa1","updated":"20240702133118"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"T