odeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 443px;\" parent-style=\"width: 453px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705131549-t3oqgio","Type":"NodeParagraph","Properties":{"id":"20240705131549-t3oqgio","updated":"20240705131549"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 638px;","style":"width: 628px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"薤白14"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/薤白14-20240705131538-a9uuxcj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 628px;\" parent-style=\"width: 638px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705131538-bq3qdmc","Type":"NodeParagraph","Properties":{"id":"20240705131538-bq3qdmc","updated":"20240705132039"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"薤和葱的区别"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240705131746-xqj5ye5","Type":"NodeParagraph","Properties":{"id":"20240705131746-xqj5ye5","updated":"20240705132030"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤比葱看起来更加健壮，整体看起来比葱粗。"}]},{"ID":"20240705131758-o71laez","Type":"NodeParagraph","Properties":{"id":"20240705131758-o71laez","updated":"20240705132031"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤和葱叶子都是细长中空，薤的断面为三角形，葱的断面为圆形。"}]},{"ID":"20240705131850-p36h82y","Type":"NodeParagraph","Properties":{"id":"20240705131850-p36h82y","updated":"20240705132031"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤颜色比葱更深，看起来比较老，葱的叶子看起来比较嫩。"}]},{"ID":"20240705131956-zbgkmgu","Type":"NodeParagraph","Properties":{"id":"20240705131956-zbgkmgu","updated":"20240705132032"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤一般用来做配菜，葱用来做配料。"}]},{"ID":"20240705132003-atuk6fo","Type":"NodeParagraph","Properties":{"id":"20240705132003-atuk6fo","updated":"20240705132033"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤的味道跟洋葱有点像，葱的香味比薤更加浓。"}]},{"ID":"20240614125641-oi7kkgr","Type":"NodeThematicBreak","Properties":{"id":"20240614125641-oi7kkgr"}},{"ID":"20240614125655-80ijvak","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125655-80ijvak","updated":"20240614125659"},"Children":[{"Type":"NodeText","Data":"薤白《汤液本草》"}]},{"ID":"20240614125655-a5em9w2","Type":"NodeParagraph","Properties":{"id":"20240614125655-a5em9w2","updated":"20240614125655"},"Children":[{"Type":"NodeText","Data":"气温，味苦、辛。无毒。"}]},{"ID":"20240614125655-1h5rcpb","Type":"NodeParagraph","Properties":{"id":"20240614125655-1h5rcpb","updated":"20240614125655"},"Children":[{"Type":"NodeText","Data":"入手阳明经。"}]},{"ID":"20240614125655-9wu3tzc","Type":"NodeParagraph","Properties":{"id":"20240614125655-9wu3tzc","updated":"20240614125655"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主金疮疮败。轻身不饥，耐老。除寒热，去水气，温中散结，利病患。诸疮中风寒水肿，以此涂之。下重者，气滞也。四逆散加此，以泄气滞。"}]},{"ID":"20240614125655-l0h90us","Type":"NodeParagraph","Properties":{"id":"20240614125655-l0h90us","updated":"20240614125655"},"Children":[{"Type":"NodeText","Data":"《心》云∶治泄痢下重，下焦气滞，泄滞气。"}]},{"ID":"20240614125641-0df6maw","Type":"NodeThematicBreak","Properties":{"id":"20240614125641-0df6maw"}},{"ID":"20240614125642-ewbxb66","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125642-ewbxb66","updated":"20240614125650"},"Children":[{"Type":"NodeText","Data":"薤白《本草经解》"}]},{"ID":"20240614125642-y0040yw","Type":"NodeParagraph","Properties":{"id":"20240614125642-y0040yw","updated":"20240614125642"},"Children":[{"Type":"NodeText","Data":"气温．味辛苦滑．无毒．主金疮疮败．轻身不饥耐老．薤白气温．禀天春和之木气．入足厥阴肝经．味辛苦滑无毒．得地西南金火之味．而有润泽之性．入手太阴肺经、手少阴心经．气味升多于降．阳也．金疮气虚．则疮口不合．气温可以益气．所以主疮败也．气温达肝．肝气条畅．则气血日生．所以轻身．温暖脾土．土健所以不饥．味辛润血．血华所以耐老也．"}]},{"ID":"20240614125642-5ykff3w","Type":"NodeParagraph","Properties":{"id":"20240614125642-5ykff3w","updated":"20240614125642"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614125642-kse8h2q","Type":"NodeParagraph","Properties":{"id":"20240614125642-kse8h2q","updated":"20240614125642"},"Children":[{"Type":"NodeText","Data":"薤白同瓜蒌、白酒．治胸痹心背痛．同瓜蒌、白酒、半夏．治胸痹不卧．心痛彻背．同枳实、桂枝、浓朴、瓜蒌．治胸痹胸满．胁下逆抢心．"}]},{"ID":"20240614125604-srzszxh","Type":"NodeThematicBreak","Properties":{"id":"20240614125604-srzszxh"}},{"ID":"20240614125632-vzw7o6d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125632-vzw7o6d","updated":"20240614125635"},"Children":[{"Type":"NodeText","Data":"薤白《本草简要方》"}]},{"ID":"20240614125632-77b7xqu","Type":"NodeParagraph","Properties":{"id":"20240614125632-77b7xqu","updated":"20240614125632"},"Children":[{"Type":"NodeText","Data":"主治利窍。泄滞。温中。散结散血。助阳。安胎。肺气喘急。霍乱干呕（水煎顿服）胸刺痛。下焦大肠气滞。奔豚气痛。（捣汁饮）水肿气痛（捣涂）久痢。冷泄。疥疮（捣烂涂）汤火伤。（蜜捣涂）蛇虎犬伤。（捣汁饮并敷）薤白汤。薤白半夏甘草人参各一两。栝蒌根二两。麦冬五合。咀。水一斗。三升。煎取四升。去滓。分五服。日三夜二次。治产后胸中烦热逆气热甚加知母一两。"}]},{"ID":"20240614125604-ix8je84","Type":"NodeThematicBreak","Properties":{"id":"20240614125604-ix8je84"}},{"ID":"20240614125621-o2cmr83","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125621-o2cmr83","updated":"20240614125626"},"Children":[{"Type":"NodeText","Data":"薤白《本草撮要》"}]},{"ID":"20240614125621-hqobynj","Type":"NodeParagraph","Properties":{"id":"20240614125621-hqobynj","updated":"20240614125621"},"Children":[{"Type":"NodeText","Data":"味苦辛温．入手太阴阳明经．功专散．滑利散结．得栝蒌、半夏治胸痹刺痛．若中恶猝死．即捣汁灌鼻中．奔豚气痛捣汁饮神效．忌牛肉．"}]},{"ID":"20240614125605-5yiz5td","Type":"NodeThematicBreak","Properties":{"id":"20240614125605-5yiz5td"}},{"ID":"20240614125606-4bn91xb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125606-4bn91xb","updated":"20240614125612"},"Children":[{"Type":"NodeText","Data":"薤白《本草便读》"}]},{"ID":"20240614125606-h1yv0u0","Type":"NodeParagraph","Properties":{"id":"20240614125606-h1yv0u0","updated":"20240614125606"},"Children":[{"Type":"NodeText","Data":"辛滑通阳．开胸痹之痰血．苦温散气．治泄痢之邪氛．（薤白其叶如韭．其根如小蒜．色白如钮．取根用．味辛而苦．性温而滑．入胃与大肠．以其辛苦温滑之性．故能通胸中阳气．散胸中痰血．至其能治赤白痢者．亦由阳气不宣而痰血交滞耳．）"}]},{"ID":"20240614125347-18yhzwo","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-18yhzwo"}},{"ID":"20240614125554-g86h3yr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125554-g86h3yr","updated":"20240614125558"},"Children":[{"Type":"NodeText","Data":"薤《本草纲目》"}]},{"ID":"20240614125554-obzncfq","Type":"NodeParagraph","Properties":{"id":"20240614125554-obzncfq","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"「释名」名叫，钓子、火葱、菜芝、鸿荟。"}]},{"ID":"20240614125554-ormur4j","Type":"NodeParagraph","Properties":{"id":"20240614125554-ormur4j","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"「气味」（薤白）辛、苦、温、滑、无毒。"}]},{"ID":"20240614125554-6e8amhw","Type":"NodeParagraph","Properties":{"id":"20240614125554-6e8amhw","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614125554-xewvmgx","Type":"NodeParagraph","Properties":{"id":"20240614125554-xewvmgx","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"1、胸痹（胸痛彻心，喘咳气短，喉中燥痒，寸脉沉迟，关脉弦数）。用栝楼实一枚、薤白半斤，加白酒七升煮成二升，分二次服。此方名“栝楼薤白汤”。又方：薤白四两，半夏一合，枳实半两，生姜一两，栝楼实半枚，切细，加醋煎服。"}]},{"ID":"20240614125554-ypewfow","Type":"NodeParagraph","Properties":{"id":"20240614125554-ypewfow","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"2、奔豚气痛。用薤白捣汁饮服。"}]},{"ID":"20240614125554-18rzt3y","Type":"NodeParagraph","Properties":{"id":"20240614125554-18rzt3y","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"3、赤白痢。用薤白一把，同米煮粥吃。"}]},{"ID":"20240614125554-chml7qr","Type":"NodeParagraph","Properties":{"id":"20240614125554-chml7qr","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"4、产后痢。我吃薤白，与羊肾同炒吃更好。"}]},{"ID":"20240614125554-ctwon29","Type":"NodeParagraph","Properties":{"id":"20240614125554-ctwon29","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"5、胎动。用薤白一升、当归四两，加水五程序煮取二升，分二次服。"}]},{"ID":"20240614125554-mg09oh4","Type":"NodeParagraph","Properties":{"id":"20240614125554-mg09oh4","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"6、间疮痛痒。煮薤叶，捣烂后涂患处。"}]},{"ID":"20240614125554-8jgbqo2","Type":"NodeParagraph","Properties":{"id":"20240614125554-8jgbqo2","updated":"20240614125554"},"Children":[{"Type":"NodeText","Data":"7、咽喉肿痛。用薤根加醋，捣烂敷肿处。"}]},{"ID":"20240614125347-iw89kdm","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-iw89kdm"}},{"ID":"20240614125544-i8ydxq7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125544-i8ydxq7","updated":"20240614125548"},"Children":[{"Type":"NodeText","Data":"薤白《本草分经》"}]},{"ID":"20240614125544-6mh9bii","Type":"NodeParagraph","Properties":{"id":"20240614125544-6mh9bii","updated":"20240614125544"},"Children":[{"Type":"NodeText","Data":"辛苦温滑，泄下焦大肠气滞，散血生肌，调中下气，取白用。"}]},{"ID":"20240614125347-aebtn1w","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-aebtn1w"}},{"ID":"20240614125535-gxgij3f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125535-gxgij3f","updated":"20240614125539"},"Children":[{"Type":"NodeText","Data":"薤白《本草思辨录》"}]},{"ID":"20240614125535-xxtluwh","Type":"NodeParagraph","Properties":{"id":"20240614125535-xxtluwh","updated":"20240614125535"},"Children":[{"Type":"NodeText","Data":"药之辛温而滑泽者，惟薤白为然。最能通胸中之阳与散大肠之结。故仲圣治胸痹用薤白，治泄利下重亦用薤白。但胸痹为阳微，痢则有冷有热，第借以疏利壅滞，故外台于冷痢热痢，皆有治以薤白者。"}]},{"ID":"20240614125347-jyxzyqk","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-jyxzyqk"}},{"ID":"20240614125526-vbb7a2v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125526-vbb7a2v","updated":"20240614125530"},"Children":[{"Type":"NodeText","Data":"薤白《要药分剂》"}]},{"ID":"20240614125526-wn9z2l6","Type":"NodeParagraph","Properties":{"id":"20240614125526-wn9z2l6","updated":"20240614125526"},"Children":[{"Type":"NodeText","Data":"味辛苦。性温。无毒。忌牛肉。"}]},{"ID":"20240614125526-xyg78dg","Type":"NodeParagraph","Properties":{"id":"20240614125526-xyg78dg","updated":"20240614125526"},"Children":[{"Type":"NodeText","Data":"【主治】主归骨。除寒热。去水气。温中。散结气。（别录）调中。补不足。止久痢冷泻。"}]},{"ID":"20240614125526-nwvp2jf","Type":"NodeParagraph","Properties":{"id":"20240614125526-nwvp2jf","updated":"20240614125526"},"Children":[{"Type":"NodeText","Data":"气。散【归经】入大肠经。为利窍助阳之品。（心病宜食大利产妇）【前论】王祯曰。薤生则气辛。熟则甘美。薤散结。蒜消症。寇氏曰。其叶光滑。露亦难下重由气滞。四逆散加此以泄滞。但按后重。亦有气虚血虚火热风燥之不同。"}]},{"ID":"20240614125347-m1s0ofd","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-m1s0ofd"}},{"ID":"20240614125512-menw169","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125512-menw169","updated":"20240614125516"},"Children":[{"Type":"NodeText","Data":"薤白《本草崇原》"}]},{"ID":"20240614125512-8mpx1nm","Type":"NodeParagraph","Properties":{"id":"20240614125512-8mpx1nm","updated":"20240614125512"},"Children":[{"Type":"NodeText","Data":"气味辛苦温滑，无毒。主治金疮疮败，轻身，不饥，耐老。"}]},{"ID":"20240614125512-igzlzt8","Type":"NodeParagraph","Properties":{"id":"20240614125512-igzlzt8","updated":"20240614125512"},"Children":[{"Type":"NodeText","Data":"（薤处处有之，正月发苗，叶状似韭，韭叶中实而扁，有剑脊，薤叶中空似细葱，而有棱，气亦如葱。二月开细花紫白色，一茎一根，根如小蒜，叶青根白，入药只用其根，故曰薤白、与韭白、葱白同一义也。根之色亦有微赤者，赤者苦而不辛，白者辛而不苦，入药以白者为佳。）"}]},{"ID":"20240614125512-dpngl44","Type":"NodeParagraph","Properties":{"id":"20240614125512-dpngl44","updated":"20240614125512"},"Children":[{"Type":"NodeText","Data":"薤用在下之根，气味辛温，其性从下而上，主助生阳之气上升者也。《金匮》胸痹证，有瓜蒌薤白白酒汤，反蒌薤白半夏汤，枳实薤白桂枝汤，皆取自下而上从阴出阳之义。金疮疮败，则皮肌经脉虚寒。薤白辛温，从内达外，故能治之，生阳上升，则轻身不饥耐老。"}]},{"ID":"20240614125347-cpk7rbt","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-cpk7rbt"}},{"ID":"20240614125449-exrdxb0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125449-exrdxb0","updated":"20240614125454"},"Children":[{"Type":"NodeText","Data":"薤白《本草经解》"}]},{"ID":"20240614125449-ynq0ii7","Type":"NodeParagraph","Properties":{"id":"20240614125449-ynq0ii7","updated":"20240614125449"},"Children":[{"Type":"NodeText","Data":"气温．味辛苦滑．无毒．主金疮疮败．轻身不饥耐老．薤白气温．禀天春和之木气．入足厥阴肝经．味辛苦滑无毒．得地西南金火之味．而有润泽之性．入手太阴肺经、手少阴心经．气味升多于降．阳也．金疮气虚．则疮口不合．气温可以益气．所以主疮败也．气温达肝．肝气条畅．则气血日生．所以轻身．温暖脾土．土健所以不饥．味辛润血．血华所以耐老也．"}]},{"ID":"20240614125449-ve0jfsk","Type":"NodeParagraph","Properties":{"id":"20240614125449-ve0jfsk","updated":"20240614125449"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614125449-2di6dva","Type":"NodeParagraph","Properties":{"id":"20240614125449-2di6dva","updated":"20240614125449"},"Children":[{"Type":"NodeText","Data":"薤白同瓜蒌、白酒．治胸痹心背痛．同瓜蒌、白酒、半夏．治胸痹不卧．心痛彻背．同枳实、桂枝、浓朴、瓜蒌．治胸痹胸满．胁下逆抢心．"}]},{"ID":"20240614125347-c3odqvo","Type":"NodeThematicBreak","Properties":{"id":"20240614125347-c3odqvo"}},{"ID":"20240614125353-wu8gl2v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125353-wu8gl2v","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"《中国药典》：薤白"}]},{"ID":"20240614125353-o0zuhpf","Type":"NodeParagraph","Properties":{"id":"20240614125353-o0zuhpf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614125353-b5v7yvq","Type":"NodeParagraph","Properties":{"id":"20240614125353-b5v7yvq","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" Xiè Bái"}]},{"ID":"20240614125353-aejol21","Type":"NodeParagraph","Properties":{"id":"20240614125353-aejol21","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614125353-8w49d52","Type":"NodeParagraph","Properties":{"id":"20240614125353-8w49d52","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 野薤、野葱、薤白头、野白头"}]},{"ID":"20240614125353-1ca3w06","Type":"NodeParagraph","Properties":{"id":"20240614125353-1ca3w06","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614125353-qp31dxe","Type":"NodeParagraph","Properties":{"id":"20240614125353-qp31dxe","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" BULBUS ALLII MACROSTEMONIS"}]},{"ID":"20240614125353-4oxa0qy","Type":"NodeParagraph","Properties":{"id":"20240614125353-4oxa0qy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614125353-3am5nh0","Type":"NodeParagraph","Properties":{"id":"20240614125353-3am5nh0","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 本品为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小根蒜"},{"Type":"NodeText","Data":"Allium macrostemon Bge.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤"},{"Type":"NodeText","Data":"Allium chinensis G. Don的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳞茎"},{"Type":"NodeText","Data":"。夏、秋二季采挖，洗净，除去须根，蒸透或置沸水中烫透，晒干。"}]},{"ID":"20240614125353-ukweio4","Type":"NodeParagraph","Properties":{"id":"20240614125353-ukweio4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614125353-7ruta7f","Type":"NodeParagraph","Properties":{"id":"20240614125353-7ruta7f","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 小根蒜：呈不规则卵圆形，高0.5～1.5cm，直径0.5～1.8cm。表面黄白色或淡黄棕色，皱缩，半透明，有类白色膜质鳞片包被，底部有突起的鳞茎盘。质硬，角质样。有蒜臭，味微辣。"}]},{"ID":"20240614125353-tdh3lc3","Type":"NodeParagraph","Properties":{"id":"20240614125353-tdh3lc3","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"薤：呈略扁的长卵形，高1～3cm，直径0.3～1.2cm。表面淡黄棕色或棕褐色，具浅纵皱纹。质较软，断面可见鳞叶2～3层，嚼之粘牙。"}]},{"ID":"20240614125353-w4268o7","Type":"NodeParagraph","Properties":{"id":"20240614125353-w4268o7","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240614125353-ehomzwn","Type":"NodeParagraph","Properties":{"id":"20240614125353-ehomzwn","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240614125353-f3fvian","Type":"NodeParagraph","Properties":{"id":"20240614125353-f3fvian","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614125353-h3nnm6p","Type":"NodeParagraph","Properties":{"id":"20240614125353-h3nnm6p","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 取本品粉末4g，加正己烷20ml，超声处理20分钟，滤过，滤液挥干，残渣加正己烷1ml使溶解，作为供试品溶液。另取薤白对照药材4g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各10μl，分别点于同一硅胶H 薄层板上，以正己烷-醋酸乙酯（10：1）为展开剂，展开，取出，晾干，用碘蒸气熏至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240614125353-u99nr92","Type":"NodeParagraph","Properties":{"id":"20240614125353-u99nr92","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614125353-may5s86","Type":"NodeParagraph","Properties":{"id":"20240614125353-may5s86","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 归肺、胃、大肠经。"}]},{"ID":"20240614125353-bl8j7i3","Type":"NodeParagraph","Properties":{"id":"20240614125353-bl8j7i3","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614125353-f5nduby","Type":"NodeParagraph","Properties":{"id":"20240614125353-f5nduby","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 辛、苦，温。"}]},{"ID":"20240614125353-ffrnqer","Type":"NodeParagraph","Properties":{"id":"20240614125353-ffrnqer","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614125353-g7hb4pr","Type":"NodeParagraph","Properties":{"id":"20240614125353-g7hb4pr","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 通阳散结，行气导滞。用于胸痹疼痛，痰饮咳喘，泄痢后重。"}]},{"ID":"20240614125353-h44za25","Type":"NodeParagraph","Properties":{"id":"20240614125353-h44za25","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614125353-44jy5t7","Type":"NodeParagraph","Properties":{"id":"20240614125353-44jy5t7","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 5～9g。"}]},{"ID":"20240614125353-gkohp1s","Type":"NodeParagraph","Properties":{"id":"20240614125353-gkohp1s","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614125353-h8l9hc4","Type":"NodeParagraph","Properties":{"id":"20240614125353-h8l9hc4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240614125353-imn473b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125353-imn473b","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：薤白"}]},{"ID":"20240614125353-nj21vmy","Type":"NodeParagraph","Properties":{"id":"20240614125353-nj21vmy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614125353-ni0wnkv","Type":"NodeParagraph","Properties":{"id":"20240614125353-ni0wnkv","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" Xiè Bái"}]},{"ID":"20240614125353-tr8wyaz","Type":"NodeParagraph","Properties":{"id":"20240614125353-tr8wyaz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614125353-ivb6qlh","Type":"NodeParagraph","Properties":{"id":"20240614125353-ivb6qlh","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 薤根（《肘后方》），藠头（《陆川本草》），大头菜子（《新疆药材》），野蒜、小独蒜（《中药形性经验鉴别法》），小蒜、宅蒜（《河北药材》），薤白头（《药材学》）。"}]},{"ID":"20240614125353-v3tvmmf","Type":"NodeParagraph","Properties":{"id":"20240614125353-v3tvmmf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614125353-bi8600i","Type":"NodeParagraph","Properties":{"id":"20240614125353-bi8600i","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 《本草图经》"}]},{"ID":"20240614125353-dpefkch","Type":"NodeParagraph","Properties":{"id":"20240614125353-dpefkch","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614125353-vezu4az","Type":"NodeParagraph","Properties":{"id":"20240614125353-vezu4az","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小根蒜"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薤"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳞茎"},{"Type":"NodeText","Data":"。北方多在春季，南方多在夏秋间采收。连根挖起，除去茎叶及须根，洗净，用沸水煮透，晒干或烘干。本品须置干燥处，防潮防蛀。"}]},{"ID":"20240614125353-8wwyfcc","Type":"NodeParagraph","Properties":{"id":"20240614125353-8wwyfcc","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614125353-ud040x3","Type":"NodeParagraph","Properties":{"id":"20240614125353-ud040x3","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 主产东北、河北、江苏、湖北等地。"}]},{"ID":"20240614125353-ga0tal8","Type":"NodeParagraph","Properties":{"id":"20240614125353-ga0tal8","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614125353-bd4k7u6","Type":"NodeParagraph","Properties":{"id":"20240614125353-bd4k7u6","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" ①小根蒜，又名：菜芝（《别录》），荞子（《本草图经》），藠子（《纲目》），祥谷菜（《铁岭县志》），小根菜。"}]},{"ID":"20240614125353-hkqbjg4","Type":"NodeParagraph","Properties":{"id":"20240614125353-hkqbjg4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"多年生草本，高达70厘米。鳞茎近球形，外被白色膜质鳞皮。叶基生；叶片线形，长20～40厘米，宽3～4毫米，先端渐尖，基部鞘状，抱茎。花茎由叶丛中抽出，单一，直立，平滑无毛；伞形花序密而多花，近球形，顶生；花梗细，长约2厘米；花被6，长圆状披针形，淡紫粉红色或淡紫色；雄蕊6，长于花被，花丝细长；雌蕊1，子房上位，3室，有2棱，花柱线形，细长。果为蒴果。花期6～8月。果期7～9月。"}]},{"ID":"20240614125353-12p34x6","Type":"NodeParagraph","Properties":{"id":"20240614125353-12p34x6","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"生于耕地杂草中及山地较干燥处。分布黑龙江、吉林、辽宁、河北、山东、湖北、贵州、云南、甘肃、江苏等地。"}]},{"ID":"20240614125353-vo9ysxz","Type":"NodeParagraph","Properties":{"id":"20240614125353-vo9ysxz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②薤（《本经》）"}]},{"ID":"20240614125353-iax48r9","Type":"NodeParagraph","Properties":{"id":"20240614125353-iax48r9","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"与上种近似。鳞茎长椭圆形，长3～4厘米。叶片2～4片，半圆柱状线形，中空。伞形花序疏松；花被片圆形或长圆形。"}]},{"ID":"20240614125353-pik9pui","Type":"NodeParagraph","Properties":{"id":"20240614125353-pik9pui","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"生于山地阴湿处。全国大部分地区有分布。"}]},{"ID":"20240614125353-vabkwbp","Type":"NodeParagraph","Properties":{"id":"20240614125353-vabkwbp","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"以上植物的叶（薤叶）亦供药用，另详专条。"}]},{"ID":"20240614125353-xj246bd","Type":"NodeParagraph","Properties":{"id":"20240614125353-xj246bd","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614125353-o402oi4","Type":"NodeParagraph","Properties":{"id":"20240614125353-o402oi4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 干燥鳞茎，呈不规则的卵圆形。大小不一，长1～1.5厘米，直径0.8～1.8厘米，上部有茎痕；表面黄白色或淡黄棕色，半透明，有纵沟与皱纹，或有数层膜质鳞片包被，揉之易脱。质坚硬，角质，不易破碎，断面黄白色。有蒜臭，味微辣。以个大、质坚、饱满、黄白色、半透明、不带花茎者为佳。"}]},{"ID":"20240614125353-2v4e2nw","Type":"NodeParagraph","Properties":{"id":"20240614125353-2v4e2nw","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614125353-zcnb40c","Type":"NodeParagraph","Properties":{"id":"20240614125353-zcnb40c","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 薤白：拣去杂质，簸筛去须毛，炒薤白：将净薤白入锅内，文火炒至外表面呈现焦斑为度，取出放凉。"}]},{"ID":"20240614125353-3yvsmt6","Type":"NodeParagraph","Properties":{"id":"20240614125353-3yvsmt6","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614125353-8ag6qeo","Type":"NodeParagraph","Properties":{"id":"20240614125353-8ag6qeo","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" ①《汤液本草》：\"入手阳明经。\""}]},{"ID":"20240614125353-fid81ni","Type":"NodeParagraph","Properties":{"id":"20240614125353-fid81ni","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②《本草经解》：\"入足厥阴肝经、手太阴肺经、手少阴心经。\""}]},{"ID":"20240614125353-g1yhtxb","Type":"NodeParagraph","Properties":{"id":"20240614125353-g1yhtxb","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614125353-mmnxizc","Type":"NodeParagraph","Properties":{"id":"20240614125353-mmnxizc","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 辛苦，温。"}]},{"ID":"20240614125353-i6nk0i4","Type":"NodeParagraph","Properties":{"id":"20240614125353-i6nk0i4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"①《木经》：\"味辛，温。\""}]},{"ID":"20240614125353-iyrygff","Type":"NodeParagraph","Properties":{"id":"20240614125353-iyrygff","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，温，无毒。\""}]},{"ID":"20240614125353-zeue0ex","Type":"NodeParagraph","Properties":{"id":"20240614125353-zeue0ex","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"③《千金·食治》：\"味苦辛，温，滑，无毒。\""}]},{"ID":"20240614125353-7o81xkd","Type":"NodeParagraph","Properties":{"id":"20240614125353-7o81xkd","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"甘酸辛，温。\""}]},{"ID":"20240614125353-6liob03","Type":"NodeParagraph","Properties":{"id":"20240614125353-6liob03","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614125353-p938t2d","Type":"NodeParagraph","Properties":{"id":"20240614125353-p938t2d","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 气虚者慎服。"}]},{"ID":"20240614125353-znlriev","Type":"NodeParagraph","Properties":{"id":"20240614125353-znlriev","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"①《食疗本草》：\"发热病人不宜多食。\""}]},{"ID":"20240614125353-a8ojdd0","Type":"NodeParagraph","Properties":{"id":"20240614125353-a8ojdd0","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"阴虚发热病不宜食。\""}]},{"ID":"20240614125353-6qwl4hi","Type":"NodeParagraph","Properties":{"id":"20240614125353-6qwl4hi","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"滑利之品，无滞勿用。\""}]},{"ID":"20240614125353-n0brnua","Type":"NodeParagraph","Properties":{"id":"20240614125353-n0brnua","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"④《随息居饮食谱》：\"多食发热，忌与韭同。\""}]},{"ID":"20240614125353-iew6jkd","Type":"NodeParagraph","Properties":{"id":"20240614125353-iew6jkd","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614125353-p8zunf4","Type":"NodeParagraph","Properties":{"id":"20240614125353-p8zunf4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 理气，宽胸，通阳，散结。治胸痹心痛彻背，脘痞不舒，干呕，泻痢后重，疮疖。"}]},{"ID":"20240614125353-jju53i0","Type":"NodeParagraph","Properties":{"id":"20240614125353-jju53i0","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主金疮疮败。\""}]},{"ID":"20240614125353-nvyjmay","Type":"NodeParagraph","Properties":{"id":"20240614125353-nvyjmay","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"归于骨。除寒热，去水气，温中散结。诸疮中风寒水肿，以涂之。\""}]},{"ID":"20240614125353-fmsm4kd","Type":"NodeParagraph","Properties":{"id":"20240614125353-fmsm4kd","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"③《千金·食治》：\"能生肌肉，利产妇。骨鲠在咽不下者，食之则去。\""}]},{"ID":"20240614125353-bvzluvs","Type":"NodeParagraph","Properties":{"id":"20240614125353-bvzluvs","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"④唐本草》：\"白者补而美，赤者主金疮及凤。\""}]},{"ID":"20240614125353-fb5np8p","Type":"NodeParagraph","Properties":{"id":"20240614125353-fb5np8p","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"治妇人赤白带下。\""}]},{"ID":"20240614125353-mhlk32y","Type":"NodeParagraph","Properties":{"id":"20240614125353-mhlk32y","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑥《本草拾遗》：\"调中，主久利不瘥，大腹内常恶者，但多煮食之。\""}]},{"ID":"20240614125353-n9m56qz","Type":"NodeParagraph","Properties":{"id":"20240614125353-n9m56qz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑦《本草图经》：\"补虚，解毒。\"\"主脚气；煮与蓐妇饮之，易产。\""}]},{"ID":"20240614125353-aov79mk","Type":"NodeParagraph","Properties":{"id":"20240614125353-aov79mk","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑧《本草衍义》：\"与蜜同捣，涂汤火伤。\""}]},{"ID":"20240614125353-ega0sfh","Type":"NodeParagraph","Properties":{"id":"20240614125353-ega0sfh","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑨《用药心法》：\"治泄痢下重，下焦气滞。\""}]},{"ID":"20240614125353-6vwty5o","Type":"NodeParagraph","Properties":{"id":"20240614125353-6vwty5o","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑩《纲目》：\"治少阴病厥逆泄痢，及胸痹刺痛，下气散血，安胎。\"\"温补助阳道。\""}]},{"ID":"20240614125353-iepjx2t","Type":"NodeParagraph","Properties":{"id":"20240614125353-iepjx2t","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑾《本草备要》：\"利窍。治肺气喘急。\""}]},{"ID":"20240614125353-f47lwwu","Type":"NodeParagraph","Properties":{"id":"20240614125353-f47lwwu","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑿《本经逢原》：\"捣汁生饮，能吐胃中痰食虫积。\""}]},{"ID":"20240614125353-uipxr17","Type":"NodeParagraph","Properties":{"id":"20240614125353-uipxr17","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒀《岭南采药录》：\"和生盐捣烂敷疮；被铁针伤，留铁锈于肌肉，敷之可以吸出。能发散解表，健胃，开膈。\""}]},{"ID":"20240614125353-qx91q3w","Type":"NodeParagraph","Properties":{"id":"20240614125353-qx91q3w","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒁《南京民间药草》：\"打烂外敷，治各种疮疖。另外取野菊花煎水内服。\""}]},{"ID":"20240614125353-i06wopt","Type":"NodeParagraph","Properties":{"id":"20240614125353-i06wopt","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614125353-bexw4o0","Type":"NodeParagraph","Properties":{"id":"20240614125353-bexw4o0","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱（鲜者1～2两）；或入丸、散。外用：捣敷或捣汁涂。"}]},{"ID":"20240614125353-k5anzxv","Type":"NodeParagraph","Properties":{"id":"20240614125353-k5anzxv","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614125353-x0ycsih","Type":"NodeParagraph","Properties":{"id":"20240614125353-x0ycsih","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" ①治胸痹之病，喘息咳唾，胸背痛，短气，寸口脉沉而迟，关上小紧数：栝楼实一枚（捣），薤白半斤，白酒七升。上三味，同煮，取二升。分温再服。（栝楼薤白白酒汤）"}]},{"ID":"20240614125353-2x7g8ih","Type":"NodeParagraph","Properties":{"id":"20240614125353-2x7g8ih","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②治胸痹，不得卧，心痛彻背者：栝楼实，一枚（捣），薤白三两，半夏半升，白酒一斗。上四味，同煮，取四升。温服一升，日三服。（栝楼薤白半夏汤）"}]},{"ID":"20240614125353-4dcwshy","Type":"NodeParagraph","Properties":{"id":"20240614125353-4dcwshy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"③治胸痹，心中痞气，气结在胸，胸满，胁下逆抢心：枳实四枚，厚朴四两，薤白半斤，桂枝一两，栝楼实一枚（捣）。上五味，以水五升，先煮枳实、厚朴取二升，去滓，纳诸药，煮数沸，分温三服。（枳实薤白桂枝汤。①方以下出《金匮要略》）"}]},{"ID":"20240614125353-cbcnjqg","Type":"NodeParagraph","Properties":{"id":"20240614125353-cbcnjqg","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"④治赤痢：薤、黄柏。煮服之。（《本草拾遗》）"}]},{"ID":"20240614125353-dyej6ui","Type":"NodeParagraph","Properties":{"id":"20240614125353-dyej6ui","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑤治赤白痢下：薤白一握。切，煮作粥食之。（《食医心镜》）"}]},{"ID":"20240614125353-ti27suh","Type":"NodeParagraph","Properties":{"id":"20240614125353-ti27suh","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑥治奔豚气痛：薤白捣汁饮之。（《肘后方》）"}]},{"ID":"20240614125353-u747mut","Type":"NodeParagraph","Properties":{"id":"20240614125353-u747mut","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑦治霍乱干呕不息：薤一虎口。以水三升煮，取半，顿服，不过三作。（《独行方》）"}]},{"ID":"20240614125353-5d40tl4","Type":"NodeParagraph","Properties":{"id":"20240614125353-5d40tl4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑧治灸疮肿痛：薤白（切）一升，猪脂一升（细切）。以苦酒浸经宿，微火煎三上三下，去滓，敷上。（《梅师集验方》）"}]},{"ID":"20240614125353-rg1d15t","Type":"NodeParagraph","Properties":{"id":"20240614125353-rg1d15t","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑨治手足瘑疮：生薤一把。以热醋投入，封疮上。（《千金方》）"}]},{"ID":"20240614125353-mwanfwr","Type":"NodeParagraph","Properties":{"id":"20240614125353-mwanfwr","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑩治咽喉肿痛：薤根，醋捣，敷肿处，冷即易之。（《圣惠方》）"}]},{"ID":"20240614125353-se784ty","Type":"NodeParagraph","Properties":{"id":"20240614125353-se784ty","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑾治鼻渊：薤白三钱，木瓜花三饯，猪鼻管四两。水煎服。（《陆川本草》）"}]},{"ID":"20240614125353-6eiukow","Type":"NodeParagraph","Properties":{"id":"20240614125353-6eiukow","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑿治食诸鱼骨鲠：小嚼薤白令柔，以绳系中，持绳端，吞薤到鲠处，引之。（《补缺肘后方》）"}]},{"ID":"20240614125353-rpo26z7","Type":"NodeParagraph","Properties":{"id":"20240614125353-rpo26z7","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒀治妊娠胎动，腹内冷痛；薤白一升，当归四两。水五升，煮二升，分二服。（《古今录验方》）"}]},{"ID":"20240614125353-99xf8ha","Type":"NodeParagraph","Properties":{"id":"20240614125353-99xf8ha","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒁治赤白痢疾：薤头60克，糯米60克，煮稀饭食。"}]},{"ID":"20240614125353-qlz1w0n","Type":"NodeParagraph","Properties":{"id":"20240614125353-qlz1w0n","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒂治小儿疳痢（包括慢性肠炎）：鲜薤头洗净，捣烂如泥，用米粉和蜜糖适量拌和做饼，烤熟食之。"}]},{"ID":"20240614125353-xivqm5n","Type":"NodeParagraph","Properties":{"id":"20240614125353-xivqm5n","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒃治胸痹心痛：薤白10克，瓜蒌仁10克，半夏5克，水煎去渣，黄酒冲服，一日两次。"}]},{"ID":"20240614125353-rzj5fzj","Type":"NodeParagraph","Properties":{"id":"20240614125353-rzj5fzj","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⒄薤白粥，薤白10-15克（鲜者30-45克），与粳米100克共煮粥。煮熟后油盐调味食用。有宽胸行气止痛作用，适用于冠心病之胸闷不舒或心绞痛，老年人慢性肠炎、菌痢。"}]},{"ID":"20240614125353-p0ul6ia","Type":"NodeParagraph","Properties":{"id":"20240614125353-p0ul6ia","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614125353-sbklh4r","Type":"NodeParagraph","Properties":{"id":"20240614125353-sbklh4r","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" ①《本草图经》：\"凡用葱、薤，皆去青留白，云白冷而青热也，故断赤下方取薤白同黄柏煮服之，言其性冷而解毒也。\""}]},{"ID":"20240614125353-1un4ifa","Type":"NodeParagraph","Properties":{"id":"20240614125353-1un4ifa","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"②《木草衍义》：\"《千金》治肺气喘急用薤白，亦取其滑泄也。\""}]},{"ID":"20240614125353-h7dlswe","Type":"NodeParagraph","Properties":{"id":"20240614125353-h7dlswe","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"下重者，气滞也，四逆散加此（薤白），以泄气滞。\""}]},{"ID":"20240614125353-e3yszxw","Type":"NodeParagraph","Properties":{"id":"20240614125353-e3yszxw","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"薤白，《本经》治金疮疮败，亦取辛以泄气，温以长肉也。\""}]},{"ID":"20240614125353-x87ed4b","Type":"NodeParagraph","Properties":{"id":"20240614125353-x87ed4b","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑤《长沙药解》：\"肺病则逆，浊气不降，故胸膈痹塞；肠病则陷，清气不升，故肛门重坠。薤白，辛温通畅，善散壅滞，故痹者下达而变冲和，重者上达而化轻清。其诸主治：断泄痢，除带下，安眙妊，散疮疡，疗金疮，下骨鲠，止气痛，消咽肿，缘其条达凝郁故也。\""}]},{"ID":"20240614125353-hfylqg4","Type":"NodeParagraph","Properties":{"id":"20240614125353-hfylqg4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑥《本草求真》：\"薤，味辛则散，散则能使在上寒滞立消；味苦则降，降则能使在下寒滞立下；气温则散，散则能使在中寒滞立除；体滑则通，通则能使久痼寒滞立解。是以下痢可除，瘀血可散，喘急可止，水肿可敷，胸痹刺痛可愈，胎产可治，汤火及中恶卒死可救，实通气、滑窍、助阳佳品也。功用有类于韭，但韭则入血行气及补肾阳，此则专通寒滞及兼滑窍之为异耳。\""}]},{"ID":"20240614125353-dfp7m7q","Type":"NodeParagraph","Properties":{"id":"20240614125353-dfp7m7q","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240614125353-idt0c33","Type":"NodeParagraph","Properties":{"id":"20240614125353-idt0c33","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 除小根蒜及薤的鳞茎作薤白使用外，尚有山东产的密花小根蒜；东北产的长梗薤白；新疆产的天蓝小根蒜的鳞茎在少数地区亦作薤白使用。"}]},{"ID":"20240614125353-916g1jj","Type":"NodeParagraph","Properties":{"id":"20240614125353-916g1jj","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614125353-v5g31o8","Type":"NodeParagraph","Properties":{"id":"20240614125353-v5g31o8","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614125353-1w1dpdd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614125353-1w1dpdd","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"《中华本草》：薤白"}]},{"ID":"20240614125353-mo29jad","Type":"NodeParagraph","Properties":{"id":"20240614125353-mo29jad","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614125353-sq7a9t7","Type":"NodeParagraph","Properties":{"id":"20240614125353-sq7a9t7","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" Xiè Bái"}]},{"ID":"20240614125353-e3i5mjw","Type":"NodeParagraph","Properties":{"id":"20240614125353-e3i5mjw","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614125353-91iuj1b","Type":"NodeParagraph","Properties":{"id":"20240614125353-91iuj1b","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 薤根、藠子、野蒜、小独蒜、薤白头"}]},{"ID":"20240614125353-eqv21kf","Type":"NodeParagraph","Properties":{"id":"20240614125353-eqv21kf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614125353-wu6pz2g","Type":"NodeParagraph","Properties":{"id":"20240614125353-wu6pz2g","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" Longstamen Onion Bulb"}]},{"ID":"20240614125353-qzltc4k","Type":"NodeParagraph","Properties":{"id":"20240614125353-qzltc4k","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614125353-gccnd98","Type":"NodeParagraph","Properties":{"id":"20240614125353-gccnd98","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 出自《本草图经》。"}]},{"ID":"20240614125353-w08ys94","Type":"NodeParagraph","Properties":{"id":"20240614125353-w08ys94","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：谨按，薤及韭类，叶不似葱。薤有赤白两种。"}]},{"ID":"20240614125353-pqlopcy","Type":"NodeParagraph","Properties":{"id":"20240614125353-pqlopcy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：《图经》云，薤白，形似韭而无实。山薤一名，茎叶相似，体性亦同，叶皆冬枯，春秋分莳。"}]},{"ID":"20240614125353-jo3uu20","Type":"NodeParagraph","Properties":{"id":"20240614125353-jo3uu20","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：薤，八月栽根，正月分莳，宜肥壤。数枝一本，则茂而根大。叶状似韭，韭叶中实而扁，有剑脊；薤叶中空，似细葱叶而有棱，气亦如葱。二月开细花，紫白色，根如小蒜，一本数颗，相依而生。五月叶青则掘之，否"}]},{"ID":"20240614125353-ssxj2py","Type":"NodeParagraph","Properties":{"id":"20240614125353-ssxj2py","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614125353-bwsn7y2","Type":"NodeParagraph","Properties":{"id":"20240614125353-bwsn7y2","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合植物小根蒜、藠子、长梗薤白或天蓝小根蒜等的鳞茎。"}]},{"ID":"20240614125353-71anvd6","Type":"NodeParagraph","Properties":{"id":"20240614125353-71anvd6","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Allium macrostemon Bunge[A.macrostemon Bunge var.uratense(Fracch.)Airy-Shaw]2.Allium chinense G.Don[A.baker Regel]3.Allium meriniflorum(Herb.) Baker[Caloscordum meriniflorum Herb.]4.Allium caeruleum Pall[A.azureum Ledeb.,A.viviparum Kar.etKir.]"}]},{"ID":"20240614125353-uzop01r","Type":"NodeParagraph","Properties":{"id":"20240614125353-uzop01r","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后第2年5-6月采收，将鳞茎挖起，除去叶苗和须根，洗去泥土，鲜和或略蒸一下，晒干或炕干。"}]},{"ID":"20240614125353-8cdb4gw","Type":"NodeParagraph","Properties":{"id":"20240614125353-8cdb4gw","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614125353-9b2uri9","Type":"NodeParagraph","Properties":{"id":"20240614125353-9b2uri9","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔1500m以下的山坡、丘陵、山谷或草地。"}]},{"ID":"20240614125353-t73h8hs","Type":"NodeParagraph","Properties":{"id":"20240614125353-t73h8hs","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"3.生于海拔2000m以下的山坡、草地或海边沙地。"}]},{"ID":"20240614125353-igwda6a","Type":"NodeParagraph","Properties":{"id":"20240614125353-igwda6a","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"4.生于海拔1100-2300m的较干旱山坡或草地上。"}]},{"ID":"20240614125353-46c5a00","Type":"NodeParagraph","Properties":{"id":"20240614125353-46c5a00","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于除新疆、青海以外的全国各地。"}]},{"ID":"20240614125353-093pn7s","Type":"NodeParagraph","Properties":{"id":"20240614125353-093pn7s","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.我国长江流域和南部各首区广泛栽培，鳞茎多供食用，也有野生者。"}]},{"ID":"20240614125353-w6w2ehh","Type":"NodeParagraph","Properties":{"id":"20240614125353-w6w2ehh","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"3.分布于东北及河北。"}]},{"ID":"20240614125353-laxf95p","Type":"NodeParagraph","Properties":{"id":"20240614125353-laxf95p","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"4.分布于新疆天山以北地区。"}]},{"ID":"20240614125353-narlarz","Type":"NodeParagraph","Properties":{"id":"20240614125353-narlarz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614125353-s3cksen","Type":"NodeParagraph","Properties":{"id":"20240614125353-s3cksen","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 1.小根蒜，多年生草本，高30-60cm。鳞茎近球形，直径0.7-1.5cm，旁侧常有1-3个小鳞茎附着，外有白色膜质鳞被，后变黑色。叶互生；叶苍绿色，半圆柱状狭线形，中空，长20-40cm，宽2-4mm，先端渐尖，基部鞘状抱茎。花茎单一，直立，高30-70cm，伞形花序顶生，球状，下有膜质苞片，卵形，先端长尖；花梗长1-2cm，有的花序只有很少的小花，而间以许多的肉质小珠芽，甚而全变不小株芽；花被片6，粉红色或玫瑰色；雄蕊6，比药被长，花丝细长，下部略扩大；子房上位，球形。蒴果倒卵形，先端凹入。花期5-6月，果期8-9月。"}]},{"ID":"20240614125353-3ura1bw","Type":"NodeParagraph","Properties":{"id":"20240614125353-3ura1bw","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.藠头，与上种相似。主要区别为：鳞茎数枚聚生，狭卵状，直径1-1.5cm；鳞茎外皮白色或带红色，膜质，不破裂。叶基生，2-5枚；具3-5棱的圆柱状，中空，近与花葶长。花葶侧年，圆柱状，高20-40cm，总苞膜质，2裂宿存，伞形花序半球形，松散，花梗为花被的2-4倍长，具苞片；花淡紫色至蓝紫色，花被片6，长4-6mm，宽椭圆形至近圆形，钝头；花丝为花被片的2倍长，仅基生部合生并与花被贴生，内轮的基部扩大，两侧各具1齿，外轮的无齿；子房宽倒卵形，基部具3个有盖的凹穴；花柱伸出花被。花、果期10-11月。"}]},{"ID":"20240614125353-axry4mq","Type":"NodeParagraph","Properties":{"id":"20240614125353-axry4mq","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"3.长梗薤白，植株无葱蒜味。鳞茎单生，卵球状或近球状，直径1-2cm；鳞茎外皮灰黑色，膜质，不破裂，内皮白色。叶圆柱状或近半圆状，中空，具纵棱，沿纵棱具细糙齿，等长于或长于花葶，宽1-3mm。伞形花序疏散；小花梗不等长，长7-11cm，基部具小苞片；花红色至紫红色；花被片基部彼此靠合成管状，花被片长7-10mm，子房每室具6胚珠。花果期7-9月。"}]},{"ID":"20240614125353-u8dp8v2","Type":"NodeParagraph","Properties":{"id":"20240614125353-u8dp8v2","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"4.天蓝小根蒜，鳞茎近球形，直径1-2cm，基部常具外皮暗紫色的小鳞茎。鳞茎外皮暗灰色，纸质，不破裂，内皮白色，膜质。叶3-5枚，条形，背面具1条纵棱，有时为三棱状条形，干时常扭卷，比花葶短，宽2-5mm，到花期逐渐枯死；叶片和叶鞘光滑或沿纵脉具细糙齿。花葶高25-85cm；伞形花序球状或半球状，具多而密集的花，有时具珠芽；小花梗近等长，比花被片长2-6倍；花天蓝色，干后常变蓝紫色。花、果期6-8月。"}]},{"ID":"20240614125353-5ytrzd4","Type":"NodeParagraph","Properties":{"id":"20240614125353-5ytrzd4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614125353-v5dcd3e","Type":"NodeParagraph","Properties":{"id":"20240614125353-v5dcd3e","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜较温暖湿润气候。以疏松肥沃、富含腐殖质、排水良好的壤土或砂质壤土 栽培为宜。"}]},{"ID":"20240614125353-ew0qxmy","Type":"NodeParagraph","Properties":{"id":"20240614125353-ew0qxmy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"栽培技术 用鳞茎繁殖。春季或秋末挖取鳞茎，大的留供药用，小的留作繁殖材料。8-9月有整好的畦上按行距20-25cm，穴距8-10cm开穴，每穴栽鳞茎3-5个，芽嘴向上，施人畜粪水，盖草木灰，覆土厚3cm。"}]},{"ID":"20240614125353-eooxmva","Type":"NodeParagraph","Properties":{"id":"20240614125353-eooxmva","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"田间管理 栽后中耕除草3次，第1次在苗出齐后，第2、3次在2、4次进行，并稍加培土。在第1、2次耕除草后，施人畜粪水。"}]},{"ID":"20240614125353-w0aow0n","Type":"NodeParagraph","Properties":{"id":"20240614125353-w0aow0n","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614125353-6t0skvj","Type":"NodeParagraph","Properties":{"id":"20240614125353-6t0skvj","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 ⑴小根蒜 鳞茎吐不规则卵圆形，长0.5-2.0cm，直径0.7-1.8cm。表面黄白色或淡黄棕色，皱缩，半透明，有缘沟及皱纹或有类白色膜质鳞片包被，顶端有残存茎基事茎痕，基部有突起的鳞茎盘。质坚硬，角质样，不易破碎，断面黄白色。微有蒜气，味微辣。"}]},{"ID":"20240614125353-7t9z5cj","Type":"NodeParagraph","Properties":{"id":"20240614125353-7t9z5cj","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑵藠头 鳞长卵形，直径1-1.5cm。⑶长梗薤白 鳞茎卵球形，直径1-2cm。"}]},{"ID":"20240614125353-uuilej1","Type":"NodeParagraph","Properties":{"id":"20240614125353-uuilej1","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"⑷天蓝小根蒜 鳞茎近球形，直径1-2cm。"}]},{"ID":"20240614125353-4qpz7wf","Type":"NodeParagraph","Properties":{"id":"20240614125353-4qpz7wf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"以个大、饱满、质坚、黄白色、半透明者为佳。"}]},{"ID":"20240614125353-ixqrp2f","Type":"NodeParagraph","Properties":{"id":"20240614125353-ixqrp2f","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：小根蒜①鳞叶表皮细胞类长方形，长60-260μm，宽20-60μm，少数呈多角形，无细胞间隙。②偶见气孔散在，圆形，直径10-16μm，副卫细胞5-6个。③较老的鳞叶表皮细胞中可见草酸钙方晶，长5-10μm，多单个存在；少数具2-4个方晶。④导管主要为螺纹导管，直径6-16μm。"}]},{"ID":"20240614125353-iuuy51h","Type":"NodeParagraph","Properties":{"id":"20240614125353-iuuy51h","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614125353-p0ckmqb","Type":"NodeParagraph","Properties":{"id":"20240614125353-p0ckmqb","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 1.小根蒜 鳞茎含薤白甙（macrostemonoside）A、D、E、F，异菝葜皂甙元-3-O-β-D-吡喃葡萄糖基（1→2）-β-D-吡喃乳糖甙（smilagenin-3-O-β-D-glucopyranosyl(1→2)-β-D-galactopyranoside），胡萝卜甙（daucoaterol），腺甙（adenoaine），β-谷甾醇（β-sitosterol），21-甲基二十三（烷）酸（21-methyl tricosanoic acid），琥珀酸（succinic acid），前列腺素（prostaglandin）A1及B1。又含具特异臭气的挥发油，内有19种含硫化合物，主要有二甲基三硫化物（dimethyl trisulfide），甲基丙基三硫化物（methylpropyl trisulfide），甲基丙基二硫化物（methylpropyl disulfide），丙基异丙基二硫化物（propylisopropyl disulfide），甲基烯丙基三硫化物（methylallyl trisulfide）以及二甲基二硫化物（dimethyl disulfide），烯丙基异丙基硫醚"}]},{"ID":"20240614125353-yb1f4ig","Type":"NodeParagraph","Properties":{"id":"20240614125353-yb1f4ig","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614125353-zyruccy","Type":"NodeParagraph","Properties":{"id":"20240614125353-zyruccy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 1.抑菌试验：薤白水煎剂对痢疾杆菌、金黄色葡萄球菌有抑制。300%水煎剂用试管稀释法，1：4对金黄色葡萄球菌、肺炎球菌有抑制作用，1：16时对八叠球菌有抑制作用。"}]},{"ID":"20240614125353-ervan63","Type":"NodeParagraph","Properties":{"id":"20240614125353-ervan63","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的作用：2.1．PGA1具有降压利尿和抗癌作用。PGB1具有血管收缩作用，其活性强于PGE2和PGE2a。"}]},{"ID":"20240614125353-d3qslmh","Type":"NodeParagraph","Properties":{"id":"20240614125353-d3qslmh","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.2．离体兔心灌流实验结果表明薤白能使冠脉流量减少（但差异无显着性），然后出现心缩力的迅速衰减，有难于恢复的特点，因此该冠脉流量减少似非由心缩力抑制所致，而可能系药物直接作用冠脉使之收缩的结果；但实验结果不完全一致，在16次实验中，作用不明显或反而使冠脉流量增加者有7次。此外，薤白对心率有抑制作用，但程度不大（小于10%）。"}]},{"ID":"20240614125353-l57ay8h","Type":"NodeParagraph","Properties":{"id":"20240614125353-l57ay8h","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.3．家兔喂薤白醇提取物3周以后血中PGE1含量明显升高，这可能是醇提取物中MATS对此类前列腺素合成的增强作用。PGE1能使血小板腺苷酸环化酶活性增强，增加 cAMP内源水平，能抑制血小板合成TXA2，抑制血小板聚集，有良好的防治血栓性血管疾病的功效，证明薤白醇提取物抑制实验性动脉粥样斑块形成作用强于PGE1。这可以认为薤白醇提物能抑制实验性TXA2和增加PGI1合成。这种抗血栓机制的结合，证实了薤白醇提物是一种防治血栓性心血管疾病的良药。"}]},{"ID":"20240614125353-1ch8rx7","Type":"NodeParagraph","Properties":{"id":"20240614125353-1ch8rx7","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．薤白提取物对实验性动脉粥样硬化（AS）的预防作用：2．4．1．长梗薤白提取物（ANBE）的降过氧化脂质（LPO）作用：高血脂时，血清LPO升高，试验结果表明给家兔饲胆固醇后，血脂升高，血清LPO亦相应升高，二者呈高度正相关。投予ANBE，血脂有所下降，而血清LPO含量则显着减少，说明ANBE有明显降血清LPO作用。其降LPO除与降血脂有关外，肯定尚有其它环节，羟基花生四烯酸（HETE）是花生四烯酸脂质氧化酶代谢途径的产物。是血中LPO的一个来源，体外实验证明：ANBE能抑制HETE的生成，推测ABNE对脂质氧化酶可能有抑制作用，从而直接减少血清LPO的生成。此外，ANBE是否同维生素E一样也是一种抗氧化剂，能接受自由基，从而减少LPO的产生亦颇值研究。"}]},{"ID":"20240614125353-sm6v12n","Type":"NodeParagraph","Properties":{"id":"20240614125353-sm6v12n","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．2．ANBE的升高PGI2的作用：6-酮-PGF1a是PGI2的非酶水解产物，性质稳定，可用以反映PGI2含量，结果表明，随血脂和血清LPO上升，对照组血浆和动脉壁中的6-酮-PGF1a含量均低于空白对照组。而ANBE治疗组血浆和动脉壁中的6-酮-PGF1a含量明显高于对照组，且亦高于空白组，说明ANBE确有升高PGI2的作用。已知LPO可以选择性抑制 PGI2合成酶，使PGI2合成减少。ANBE升高PGI2的机制可能是由于ANBE降低了血清和动脉壁中的LPO，从而使内皮细胞及平滑肌细胞的PGI2酶得到保护；此外，由于ANBE能抑制TXA2合成酶和脂质氧化酶，从而可使前列腺素的合成偏向PGI2。PGI2具有抑制血小板聚集，扩张血管，控制动脉壁胆固醇的蓄积和增加纤溶活性等作用。PGI2含量增高加大了PGI2/TXA2比值，结果减轻了AS的病变。"}]},{"ID":"20240614125353-8cluiqz","Type":"NodeParagraph","Properties":{"id":"20240614125353-8cluiqz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．3．ANBE的抗血小板聚集作用：ANB精油对各种诱聚齐引发的血小板聚集（第二相）有强抑制作用，对一次聚集引发的血小板聚体具有明显的促解离作用。实验结果表明ANBE体内给药，对血小板5min聚集率有显着的抑制作用，并且对已聚集的血小板具有解聚作用。目前已知，TXA2是迄今为止发现最强的促血小板聚集物质，而PGI2则能对抗TXA2的作用，故有抗聚集及解聚作用。人体内的血小板聚集可能受PGI2/TXA2比值所调节。还有实验证明，LPO有直接刺激血小板膜鸟甘酸环化酶，升高血小板内cGMP促进聚集的作用。根据实验结果推测，ANBE在体内抑制血小板聚集的可能饥理为：2．4．3．1．抑制LPO的生成，提高PGI2含量，后者通过升高血小板内cAMP水平而抑制血小板聚集。"}]},{"ID":"20240614125353-an0gfhk","Type":"NodeParagraph","Properties":{"id":"20240614125353-an0gfhk","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．3．2．抑制TXA2合成酶，减少TXA2的合成。"}]},{"ID":"20240614125353-0u10if2","Type":"NodeParagraph","Properties":{"id":"20240614125353-0u10if2","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．3．3．抑制LPO的生成，从而抑制其升高血小板内cAMP的作用。"}]},{"ID":"20240614125353-fr1ewy2","Type":"NodeParagraph","Properties":{"id":"20240614125353-fr1ewy2","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．3．4．ANBE含有的甲基烯丙基三硫有直接抑制血小板聚集的作用。"}]},{"ID":"20240614125353-qmgf64w","Type":"NodeParagraph","Properties":{"id":"20240614125353-qmgf64w","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．4．ANBE抑制平滑肌细胞增生和减少泡沫细胞形成：实验表明，治疗组与对照组比较，泡沫细胞数量少，体积小，平滑肌细胞增生程度亦明显减轻。分析其机理有三：2．4．4．1．ANBE明显降血脂，从而减少LDL在动脉内膜的沉积，继而减轻平滑肌细胞的增生。"}]},{"ID":"20240614125353-4tcqgxu","Type":"NodeParagraph","Properties":{"id":"20240614125353-4tcqgxu","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．4．2．在高血脂LPO生成增多的情况下，LPO分解生成的丙二醛可以改变LDL的性质。这种LDL可以经清道夫受体途径进入单核细胞和平滑肌细胞并使之转变为泡沫细胞。由于ANBE明显地降低血清LPO，减少脂质经清道夫受体途径进入细胞，减少泡沫细胞的生成。"}]},{"ID":"20240614125353-a36xehf","Type":"NodeParagraph","Properties":{"id":"20240614125353-a36xehf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2．4．4．3．ANBE升高PGI2水平，从而升高细胞内cAMP水平，其结果：a.抑制血小板聚集和释放反应，减少平滑肌细胞增生因子的产生；b.稳固溶酶体膜，保护内皮细胞免受损伤及减少泡沫细胞的崩解、进而抑制平滑肌细胞的增生；c.直接抑制平滑肌细胞的增生，d.促进平滑肌细胞内酸性胆固醇酯水解酶活性，促进胆固醇酯的水解和转运。由于ANBE明显抑制平滑肌细胞增生和减少泡沫细胞形成，所以明显地抑制AS斑块的形成。"}]},{"ID":"20240614125353-7jtk75m","Type":"NodeParagraph","Properties":{"id":"20240614125353-7jtk75m","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.4.5.ANBE的降血脂作用：血症高脂是AS的主要危险因素，内膜中脂质沉积是AS病变发生的始动环节，因而处理高脂血症是防治本病的重要措施。实验结果表明，ANBE对血清总脂，B-脂蛋白和总胆固醇都有较明显的降低作用。直接给予二烯丙基二硫，对饲胆固醇家兔有阻止血脂升高的作用。ANBE中也含有甲基烯丙基二硫和甲基烯丙基三硫及其它含硫化合物。是为 ANBE降血脂的有效成分。"}]},{"ID":"20240614125353-myxqbke","Type":"NodeParagraph","Properties":{"id":"20240614125353-myxqbke","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.4.6.薤白对花生四烯酸代谢系列的干扰作用：薤白能明显干扰血小板的花生四烯酸代谢，抑制其环氧化酶代谢途径，抑制TXB2及HHT的合成。与此同时脂质氧化酶途径的代谢产物HETE合成确有增强。薤白对血小板合成TXB2的抑制作用的IC50 为0.146mg/ml。抑制率达80.3%，HHT合成的抑制率达78.6%。而HETE增加20.2%。薤白提取物可促进兔血小板解聚，明显升高PGI2的代谢产物6-Keto-PGF1a水平，有效地抑制其主动脉脂质斑块形成，缩小其面积和减少厚度。除了PGI2合成增加外，这与TXB2合成受抑制从而更有效地改变PGI2/TXA2的比值应有密切的关系。PGI2合成的增加是薤白对动脉内膜PGI2合成的直接刺激作用，还是由于TXA2合成受抑制而使PGL2合成的底物增多的结果尚需阐明。"}]},{"ID":"20240614125353-x9ebfro","Type":"NodeParagraph","Properties":{"id":"20240614125353-x9ebfro","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614125353-yum1ct0","Type":"NodeParagraph","Properties":{"id":"20240614125353-yum1ct0","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 薤白：拣去杂质，簸筛去须毛。炒薤白：将净薤白入锅内，文火炒至外表呈现焦斑为度，取出放凉。"}]},{"ID":"20240614125353-spvdys4","Type":"NodeParagraph","Properties":{"id":"20240614125353-spvdys4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614125353-yv2yb2w","Type":"NodeParagraph","Properties":{"id":"20240614125353-yv2yb2w","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 肺；心；胃；大肠经"}]},{"ID":"20240614125353-y9vq3zz","Type":"NodeParagraph","Properties":{"id":"20240614125353-y9vq3zz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614125353-o36bv9d","Type":"NodeParagraph","Properties":{"id":"20240614125353-o36bv9d","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性温"}]},{"ID":"20240614125353-sknmjao","Type":"NodeParagraph","Properties":{"id":"20240614125353-sknmjao","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614125353-11al0e1","Type":"NodeParagraph","Properties":{"id":"20240614125353-11al0e1","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 气虚者慎用。"}]},{"ID":"20240614125353-es4v0mz","Type":"NodeParagraph","Properties":{"id":"20240614125353-es4v0mz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"1.《食疗本草》：发热病人不宜多食。"}]},{"ID":"20240614125353-53qqz3x","Type":"NodeParagraph","Properties":{"id":"20240614125353-53qqz3x","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：阴虚发热病不宜食。"}]},{"ID":"20240614125353-1b4k8np","Type":"NodeParagraph","Properties":{"id":"20240614125353-1b4k8np","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：滑利之品，无滞勿用。"}]},{"ID":"20240614125353-6seehbo","Type":"NodeParagraph","Properties":{"id":"20240614125353-6seehbo","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"4.《随新居饮食谱》：多食发热，忌与韭同。"}]},{"ID":"20240614125353-sjov1fj","Type":"NodeParagraph","Properties":{"id":"20240614125353-sjov1fj","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614125353-mhb5kju","Type":"NodeParagraph","Properties":{"id":"20240614125353-mhb5kju","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 理气宽胸；通阳散结。主胸痹心痛彻背；胸脘痞闷；咳喘痰多；脘腹疼痛；泄痢后重；白带；疮疖痈肿"}]},{"ID":"20240614125353-9g13zu9","Type":"NodeParagraph","Properties":{"id":"20240614125353-9g13zu9","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614125353-km9cwwy","Type":"NodeParagraph","Properties":{"id":"20240614125353-km9cwwy","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g，鲜品30-60g；或入丸、散，亦可煮粥食。外用：适量，捣敷；或捣汁涂。"}]},{"ID":"20240614125353-v1myey8","Type":"NodeParagraph","Properties":{"id":"20240614125353-v1myey8","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614125353-sa1vjt9","Type":"NodeParagraph","Properties":{"id":"20240614125353-sa1vjt9","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" ①治胸痹之病，喘息咳唾，胸背痛，短气，寸口脉沉而迟，关上小紧数：栝楼实一枚(捣)，薤白半斤，白酒七升。上三味，同煮，取二升。分温再服。(栝楼薤白白酒汤)②治胸痹，不得卧，心痛彻背者：栝楼实一枚(捣)，薤白三两，半夏半升，白酒一斗。上四味，同煮，取四升。温服一升，日三服。(栝楼薤白半夏汤)③治胸痹，心中痞气，气结在胸，胸满，胁下逆抢心：枳实四枚，厚朴四两，薤白半斤，桂枝一两，栝楼实一枚(捣)。上五味，以水五升，先煮枳实、厚朴取二升，去滓，纳诸药，煮数沸。分温三服。(枳实薤白桂枝汤。①方以下出《金匮要略》)④治赤痢：薤、黄柏。煮服之。(《本草拾遗》)⑤治赤白痢下：薤白一握。切，煮作粥食之。(《食医心镜》)⑥治奔豚气痛：薤白捣汁饮之。(《肘后之》)⑦治霍乱干呕不息：薤一虎口。以水三升煮，取半，顿服，不过三作。(《独行方》)⑧治炙疮肿痛：薤白(切)一升，猪脂一升(细切)。以苦酒浸经宿，微火煎三上三下，去滓，敷上。(《梅师集验方》)⑨治手足疮：生薤一把。以热醋投入，封疮上。(《千金方》)⑩治咽喉肿痛：薤根，醋捣，敷肿处，冷即易之。(《圣惠方》)(11)治鼻渊：薤白三钱，木瓜花三钱，猪鼻管四两。水煎服。(《陆川本草》)(12)治食诸鱼骨鲠：小嚼薤白令柔，以绳系中，持绳端，吞薤到鲠处，引之。(《补缺肘后方》)(13)治妊娠胎动，腹内冷痛：薤白一升。当归四两。水五升，煮二升，分二服。(《古今录验方》)"}]},{"ID":"20240614125353-k54anzr","Type":"NodeParagraph","Properties":{"id":"20240614125353-k54anzr","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614125353-o1l88eh","Type":"NodeParagraph","Properties":{"id":"20240614125353-o1l88eh","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 1.《本草图经》：凡用葱、薤，皆去青留白，云白冷而青热也，故断赤下方取薤白同黄柏煮服之，言其性冷而解毒也。"}]},{"ID":"20240614125353-9odmmtz","Type":"NodeParagraph","Properties":{"id":"20240614125353-9odmmtz","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"2.《本草衍义》：《千金》治肺气喘急用薤白，亦取其滑泄也。"}]},{"ID":"20240614125353-wo3jmpf","Type":"NodeParagraph","Properties":{"id":"20240614125353-wo3jmpf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"3.《汤液本草》：下重者，气滞也，四逆散加此（薤白），以泄气滞。"}]},{"ID":"20240614125353-9sa77al","Type":"NodeParagraph","Properties":{"id":"20240614125353-9sa77al","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：薤白，《本经》治金疮疮败，亦取辛以泄气，温以长肉也。"}]},{"ID":"20240614125353-mu6j66v","Type":"NodeParagraph","Properties":{"id":"20240614125353-mu6j66v","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"5.《长沙解药》：肺病则逆，浊气不降，故胸膈痹塞；肠病则陷，清气不升，故肛门重坠。薤白，辛温通畅，善散壅滞，故痹者下达而变冲和，重者上达而化轻清。其诸主治：断泄痢，除带下，安胎妊，散疮疡，疗金疮，下骨鲠，止气痛，消咽肿，缘其条达凝郁故也。"}]},{"ID":"20240614125353-ciupez3","Type":"NodeParagraph","Properties":{"id":"20240614125353-ciupez3","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"6.《本草求真》：薤，味辛则散，散则能使在上寒滞立消；味苦则降，降则能使在下寒滞立下；气温则散，散则能使在中寒滞立除；体滑则通，通则能使久痼寒滞立解。是以下痢可除，瘀血可散，喘急可止，水肿可敷，胸痹刺痛可愈，胎产可治，汤火及中恶卒死可救，实通气、滑窍、助阳佳品也。功用有类于韭，但韭则入血行气及补肾阳，此则专通寒滞及兼滑窍之为异耳。"}]},{"ID":"20240614125353-jjchiqp","Type":"NodeParagraph","Properties":{"id":"20240614125353-jjchiqp","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"7.《本经》：主金疮疮败。"}]},{"ID":"20240614125353-t1iqibk","Type":"NodeParagraph","Properties":{"id":"20240614125353-t1iqibk","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"8.《别录》：归于骨。除寒热，去水气，温中散结。诸疮中风寒水肿，以涂之。"}]},{"ID":"20240614125353-lwpjrnp","Type":"NodeParagraph","Properties":{"id":"20240614125353-lwpjrnp","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"9.《千金．食治》：能生肌肉，利产妇。骨鲠在咽喉不下者，食之则去。"}]},{"ID":"20240614125353-xz8xhjj","Type":"NodeParagraph","Properties":{"id":"20240614125353-xz8xhjj","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"10.《唐本草》：白者补而美，赤者主金疮及风。"}]},{"ID":"20240614125353-ewdagua","Type":"NodeParagraph","Properties":{"id":"20240614125353-ewdagua","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"11.《食疗本草》：治妇人赤白带下。"}]},{"ID":"20240614125353-ffge1it","Type":"NodeParagraph","Properties":{"id":"20240614125353-ffge1it","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"12.《本草拾遗》：调中，主久利不瘥，大腹内常恶者，但多者食之。"}]},{"ID":"20240614125353-239hzf1","Type":"NodeParagraph","Properties":{"id":"20240614125353-239hzf1","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"13.《本草图经》：补虚，解毒。主脚气；煮与蓐妇饮之，易产。"}]},{"ID":"20240614125353-euhzgkv","Type":"NodeParagraph","Properties":{"id":"20240614125353-euhzgkv","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"14.《本义衍义》：与蜜同捣，涂汤火伤。"}]},{"ID":"20240614125353-33enyeu","Type":"NodeParagraph","Properties":{"id":"20240614125353-33enyeu","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"15.《用药心法》：治泄痢下重，下焦气滞。"}]},{"ID":"20240614125353-fmp6nod","Type":"NodeParagraph","Properties":{"id":"20240614125353-fmp6nod","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"16.《纲目》：治少阴病厥逆泄痢，及胸痹刺痛，下气散血，安胎。温补助阳道。"}]},{"ID":"20240614125353-5mk11kf","Type":"NodeParagraph","Properties":{"id":"20240614125353-5mk11kf","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"17.《本草备要》：利窍。治肺气喘急。"}]},{"ID":"20240614125353-nibqkdk","Type":"NodeParagraph","Properties":{"id":"20240614125353-nibqkdk","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"18.《本经逢原》：捣汁生饮，能吐胃中痰食虫积。"}]},{"ID":"20240614125353-zjbeic4","Type":"NodeParagraph","Properties":{"id":"20240614125353-zjbeic4","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"19.《岭南采药录》：和生盐捣烂敷疮；被铁针伤，留铁锈于肌肉，敷之可以吸出。能发散解表，健胃，开膈。"}]},{"ID":"20240614125353-pr0pa6k","Type":"NodeParagraph","Properties":{"id":"20240614125353-pr0pa6k","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"20.《南京民间药草》：打烂外敷，治各种疮疖。另外取野菊花煎水内服。"}]},{"ID":"20240614125353-vexr965","Type":"NodeParagraph","Properties":{"id":"20240614125353-vexr965","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614125353-98ik0ju","Type":"NodeParagraph","Properties":{"id":"20240614125353-98ik0ju","updated":"20240614125353"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614125355-gy5datq","Type":"NodeThematicBreak","Properties":{"id":"20240614125355-gy5datq"}},{"ID":"20240614125356-rtfddye","Type":"NodeParagraph","Properties":{"id":"20240614125356-rtfddye"}}]}