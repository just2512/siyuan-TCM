assets/楝实10-20240702122310-w3068mj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 624px;\" parent-style=\"width: 634px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240902161248-sg05cwh","Type":"NodeParagraph","Properties":{"id":"20240902161248-sg05cwh","updated":"20240902161403"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 785px;","style":"width: 775px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦楝树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦楝树-20240902161403-8velu5m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 775px;\" parent-style=\"width: 785px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 446px;","style":"width: 436px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实 6-20240826150233-pvytps9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 436px;\" parent-style=\"width: 446px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826150120-z1w7uld","Type":"NodeParagraph","Properties":{"id":"20240826150120-z1w7uld","updated":"20240826150120"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 459px;","style":"width: 449px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702115742-4pw7h44.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 449px;\" parent-style=\"width: 459px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 808px;","style":"width: 798px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"楝实7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/楝实7-20240702115620-neiqzvp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 798px;\" parent-style=\"width: 808px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613131547-pfngzdu","Type":"NodeThematicBreak","Properties":{"id":"20240613131547-pfngzdu"}},{"ID":"20240613131705-on54ki8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131705-on54ki8","updated":"20240613131711"},"Children":[{"Type":"NodeText","Data":"楝实《神农本草经》"}]},{"ID":"20240613131705-eg1r43f","Type":"NodeParagraph","Properties":{"id":"20240613131705-eg1r43f","updated":"20240613131705"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613131705-lyf6ekq","Type":"NodeParagraph","Properties":{"id":"20240613131705-lyf6ekq","updated":"20240613131705"},"Children":[{"Type":"NodeText","Data":"主温疾伤寒，大热烦狂，杀三虫疥疡利，小便水道。生山谷。"}]},{"ID":"20240613131705-uemkq4v","Type":"NodeParagraph","Properties":{"id":"20240613131705-uemkq4v","updated":"20240613131705"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生荆山。"}]},{"ID":"20240613131705-klp4u00","Type":"NodeParagraph","Properties":{"id":"20240613131705-klp4u00","updated":"20240613131705"},"Children":[{"Type":"NodeText","Data":"案《说文》云：楝木也。《中山经》云：其实如楝。郭璞云：楝，木名，子如指头，白而粘，可以浣衣也。《淮南子》时则训云：七月其树楝。高诱云：楝实，凤凰所食，今雒城旁有楝树，实，秋熟。"}]},{"ID":"20240613131547-t3ky7mi","Type":"NodeThematicBreak","Properties":{"id":"20240613131547-t3ky7mi"}},{"ID":"20240613131653-wiriana","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131653-wiriana","updated":"20240613131658"},"Children":[{"Type":"NodeText","Data":"楝实《名医别录》"}]},{"ID":"20240613131653-535mimt","Type":"NodeParagraph","Properties":{"id":"20240613131653-535mimt","updated":"20240613131653"},"Children":[{"Type":"NodeText","Data":"有小毒．根微寒．治蛔虫，利大肠．生荆山．"}]},{"ID":"20240613131653-zmdev2q","Type":"NodeParagraph","Properties":{"id":"20240613131653-zmdev2q","updated":"20240613131653"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶楝实，味苦，寒．主温疾伤寒，大热烦狂，杀三虫，疥疡，利小便水道．生山谷．"}]},{"ID":"20240613131654-lt31u1v","Type":"NodeThematicBreak","Properties":{"id":"20240613131654-lt31u1v"}},{"ID":"20240613131717-2zf05pv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131717-2zf05pv","updated":"20240613131726"},"Children":[{"Type":"NodeText","Data":"楝实《本草述钩元》"}]},{"ID":"20240613131717-1efwj4o","Type":"NodeParagraph","Properties":{"id":"20240613131717-1efwj4o","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"名金铃子。产蜀川者佳。三四月开花红紫。结实如弹。生青熟黄。十二月采之。酸而纯苦。气寒。气薄味浓。降也。入心肝肾小肠膀胱经。楝实为阴中之阳。然用之乃从阳入阴。"}]},{"ID":"20240613131717-sgzdvxb","Type":"NodeParagraph","Properties":{"id":"20240613131717-sgzdvxb","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"故得致其阳于阴也。主治热厥心痛。上下部腹痛。疝气。利水道。疗虫痔。方书多主疝证。次遗精喘。诸逆冲上头痛。心胁胃脘腰痛。积聚小便数淋。溲血下血。前阴诸疾。齿病。"}]},{"ID":"20240613131717-ub5rko7","Type":"NodeParagraph","Properties":{"id":"20240613131717-ub5rko7","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"楝实为下焦气分药。（阆风）解热散结之剂。（蒿）脐之上下痛与心暴痛者。均是气滞与火。楝实酸苦。能涌泄之。（类明）楝实治阴虚阳厥。如心痛胃脘痛证。又治阴胜阳陷。"}]},{"ID":"20240613131717-uuukfnm","Type":"NodeParagraph","Properties":{"id":"20240613131717-uuukfnm","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"如疝证。同牛膝木瓜橘红荔枝核杜仲巴戟乌树子茴香。治肾虚疝气。疝肿痛。有五制四制七制用者。俱见濒湖纲目。丈夫疝气。本脏气伤。膀胱连小肠等气。楝实百枚。温汤浸过。去皮。巴豆二百枚。微打破。以面二升。同置铜铛内。炒至楝实赤色为度。放冷取出。"}]},{"ID":"20240613131717-ug8kayn","Type":"NodeParagraph","Properties":{"id":"20240613131717-ug8kayn","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"去核为末。巴面不用。每服三钱。热酒或醋汤调服。一方。入盐炒茴香半两。肾消膏淋。"}]},{"ID":"20240613131717-4kg5562","Type":"NodeParagraph","Properties":{"id":"20240613131717-4kg5562","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"病在下焦。苦楝子茴香等分。炒〔论〕楝实禀天之阴气。得地之苦味。苦应入心。然肾为心火对化。又味从乎气。故凡苦寒之属。类入于肾。而楝实独入心。如东垣所说。（东垣云。入心与小肠。）何哉。缘其味初尝有酸。后乃纯苦。禀苦寒之性。以下行逐热。实兼木火之原。以导气达阳。故解热散结。与诸苦寒之直折降热者。殊有不同。盖本木火以致于苦寒。则能引阳而归之。是以阴气衰于下。而为热厥心痛者。非此不除。（如但以为清热。则苦寒之归。下者。安能补阴气之衰耶。）至其为下焦气分药。而治疝率多用之。亦此义耳。疝之为患。多在肾肝部分。而受病则惟寒郁热之因。寒固肾与膀胱之气。热则厥阴相火之气也。此味根君火之对化。自应入肾。兼木火之气化。自应彻肝。所谓导气达阳。而兼解热散结者也。（彻肝之义。即本木火以致于苦寒之义也。洁古治茎中痛。用生甘草梢。却加延胡苦楝子。尤妙。又治淋证茎痛引胁者。有参苓琥珀汤。以苦楝为君。内经云。足厥阴循阴器而络于肝。又足厥阴之别者。循胫上睾。结于茎。信乎此味为入肝的剂矣。）诸方有同莱菔牵牛斑蝥炒。藉其破坚溃郁之气。"}]},{"ID":"20240613131717-bwb48bn","Type":"NodeParagraph","Properties":{"id":"20240613131717-bwb48bn","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"以助此味散结之功者。有引以故纸茴香。寒因热用。直入寒中之热。以竟此味逐热之功者。"}]},{"ID":"20240613131717-fm9o56d","Type":"NodeParagraph","Properties":{"id":"20240613131717-fm9o56d","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"则其主治。概可睹矣。第疝证或即曰小肠气。间曰膀胱气。是以小肠膀胱之气病。便是疝也。"}]},{"ID":"20240613131717-w68womb","Type":"NodeParagraph","Properties":{"id":"20240613131717-w68womb","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"不知离小肠膀胱以治疝。固无是理。即小肠膀胱以为疝。究有未宜。盖人身惟是水火二气。"}]},{"ID":"20240613131717-76eo83w","Type":"NodeParagraph","Properties":{"id":"20240613131717-76eo83w","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"心肾者水火之匡廓。而小肠膀胱则心肾气化之府也。使病于疝者。抹却肾及小肠膀胱。而独以肝为言。则试思肝之所以能由阴而达阳于天。复由阳而蟠阴于地者。如不藉水火之气化。"}]},{"ID":"20240613131717-j1x09mo","Type":"NodeParagraph","Properties":{"id":"20240613131717-j1x09mo","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"动而不。若小肠膀胱之用。（手太阳丙火上行。足太阳壬水下行。）将一阴何以为独使乎。"}]},{"ID":"20240613131717-ezl4noq","Type":"NodeParagraph","Properties":{"id":"20240613131717-ezl4noq","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"故曰。离小肠膀胱以治疝。无是理也。若止病于小肠膀胱。而未及病于肝。则治法固别。盖病于肝者。乃寒水之脏腑。郁其水中真阳。而肝升之阳郁。即以病同处于下之脾。卒之寒湿合化。厥阴益不得达。而病于任者愈甚。如东垣所云也。（东垣云。足太阳膀胱之气逆。上迎手太阳小肠之脉下行。致足厥阴之脉不得伸其任脉。并厥阴之脉逆。如巨川之水。使阳气下坠。致两睾肿大。谓之曰疝。大甚则为也。）至于小肠膀胱之自为病。或火淫而水虚。"}]},{"ID":"20240613131717-v4npfxu","Type":"NodeParagraph","Properties":{"id":"20240613131717-v4npfxu","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"或水泛而火虚。治此者更宜适事为故。岂得漫同于治疝之法耶。总之。楝实之用。所治者疝。而奏功之地在膀胱。其能奏功于膀胱者。又始于小肠。即其三四月已毕。历夏至冬而后采实。是固本木火之气。以致于寒水而功乃成耳。夫寒水之气大郁。不根木火之元气以达之开之。而谓疝可疗乎。矧外痼之积冷。不从以苦寒。能使木火之气。浸入于凝寒中以导气乎。"}]},{"ID":"20240613131717-wkvayih","Type":"NodeParagraph","Properties":{"id":"20240613131717-wkvayih","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"犹恐其不开。或借巴豆气以和苦寒而彻阳矣。至东垣谓其入小肠。且先之入心。何也。人身之火。原出水中。水为火之元。心为火之主。楝实本木火之气以致于寒水。故下之阴虚而阳厥者。用火之主。以归之。如热厥心痛是。盖阳归于阴。则阴自为阳守也。下之阴翳而阳陷者。用火之主以彻之。如寒郁热为疝是。盖阳彻于阴。则阴自不痼阳矣。其功皆奏于下。而所以归之彻之者。乃在上。故首言入心。又按。本木火以致苦寒。则木火入手。不与温补之味相逆。渐入而致苦寒。则与虚寒之气骤得温补者。因有同气之先导。而温补乃可以奏功。"}]},{"ID":"20240613131717-iho9n3o","Type":"NodeParagraph","Properties":{"id":"20240613131717-iho9n3o","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"如治阳虚于下而遗泄者。用以佐补阳虚。正是此义。知此则阴虚阳虚病于他证者。可以类推而治矣。"}]},{"ID":"20240613131717-aa4cbxn","Type":"NodeParagraph","Properties":{"id":"20240613131717-aa4cbxn","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"脾胃虚寒者。不宜。（仲淳）〔修事〕酒浸蒸软。去皮核。取净肉晒干。或酒煮。或盐煮。或麸炒。或巴豆炒。"}]},{"ID":"20240613131717-y8efrfe","Type":"NodeParagraph","Properties":{"id":"20240613131717-y8efrfe","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"或单炒。或不制。随证所宜。"}]},{"ID":"20240613131717-hz67u4l","Type":"NodeParagraph","Properties":{"id":"20240613131717-hz67u4l","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"苦楝皮根及木皮"}]},{"ID":"20240613131717-e6r3fa5","Type":"NodeParagraph","Properties":{"id":"20240613131717-e6r3fa5","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"味苦。气微寒。有小毒。主治游风热毒。风疹恶疮疥癞。小儿壮热（并煎汤浸洗）消渴有虫。苦楝根取新白皮（日华子言。雄者根赤。有毒。吐泻杀人。）一握。切焙。入麝香少许。水二碗。煎至一碗。空心饮之。虽困顿。不妨。自后下虫三四条。类而色红。其渴顿止。乃知消渴一证。有虫耗其津液。"}]},{"ID":"20240613131717-j7xp6qy","Type":"NodeParagraph","Properties":{"id":"20240613131717-j7xp6qy","updated":"20240613131717"},"Children":[{"Type":"NodeText","Data":"〔辨治〕雄者根赤。不可用。雌者色白。入药。每一两。可入糯米五十粒。同煎杀毒。若泻者。以冷粥止之。不泻者。以热葱粥发之。"}]},{"ID":"20240613131812-7usrvcy","Type":"NodeThematicBreak","Properties":{"id":"20240613131812-7usrvcy"}},{"ID":"20240613131814-okpxtpl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131814-okpxtpl","updated":"20240613131818"},"Children":[{"Type":"NodeText","Data":"楝实《千金翼方》"}]},{"ID":"20240613131814-0zhl9s0","Type":"NodeParagraph","Properties":{"id":"20240613131814-0zhl9s0","updated":"20240613131814"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有小毒。主温疾，伤寒大热烦狂，杀三虫疥疡，利小便水道。"}]},{"ID":"20240613131814-q8tp6wr","Type":"NodeParagraph","Properties":{"id":"20240613131814-q8tp6wr","updated":"20240613131814"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"}]},{"ID":"20240613131814-wu6eobl","Type":"NodeParagraph","Properties":{"id":"20240613131814-wu6eobl","updated":"20240613131814"},"Children":[{"Type":"NodeText","Data":"微寒。疗蛔虫，利大肠，生荆山山谷。"}]},{"ID":"20240613132044-bqm2xyu","Type":"NodeThematicBreak","Properties":{"id":"20240613132044-bqm2xyu"}},{"ID":"20240613132045-dj8xdlk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132045-dj8xdlk","updated":"20240613132049"},"Children":[{"Type":"NodeText","Data":"川楝子《本草求真》"}]},{"ID":"20240613132045-f2liax2","Type":"NodeParagraph","Properties":{"id":"20240613132045-f2liax2","updated":"20240613132045"},"Children":[{"Type":"NodeText","Data":"（乔木）解郁热狂燥疝瘕蛊毒"}]},{"ID":"20240613132045-9gjqmzg","Type":"NodeParagraph","Properties":{"id":"20240613132045-9gjqmzg","updated":"20240613132045"},"Children":[{"Type":"NodeText","Data":"川楝子（专入心包小肠膀胱）。即苦楝子。因出于川。故以川名。又名金铃子。楝实者是也。味苦气寒微毒。凡人冬时感冒寒邪。至春而发则为温。以致症见狂燥。并疝瘕。热被寒束。症见囊肿茎强。掣引作痛。与夫寒热积聚。（积由五脏所生。聚由六腑所成。）三虫内蚀者。俱宜用此调治。（有虫耗其津液而渴。须用此根叶加麝以投。）以苦主有泄热之功。寒有胜热之义。故能使热悉除。而毒蛊瘕疝。亦得因其自心下降。由于小便而乃泄矣。但人止知此为除疝之味。（内经七疝。曰冲、曰 、曰 癃、曰狐、曰 、曰瘕、曰厥）而不知有逐热解狂之力。以至废而不治。即其治疝。亦不分其是寒是热。是偏是平。与夫偏有错杂多寡之异。其痛亦不分其所痛之处。是否自下而上。从上而下。（治病要在辨症。）惟计古方茴香川楝。历为治疝千古俎豆。讵知疝属于热则痛。必见囊肿茎强。其痛亦必从下而上。用以川楝纳入以为向导。则热可除。（热疝必用。）如其疝并非热。其痛自上而下。痛引入腹。且有厥逆吐涎。非用辛温不能见效。若以川楝同入。则于理不免岐而二矣。（寒疝不宜用。）然古人立方治疝。偏以川楝同投。其意奚似。盖缘邪有错杂。则治不得不尔。若以错杂之邪而概用以辛燥。不更使病相左乎？绣尝语诸同人。凡人用药治病。须当明其偏平。偏症偏治。平症平治。错杂多寡不一之症。则即当以错杂不一以治。（括尽治病种类。）昔绣治一族叔字次周阴疝。其症是偏不平。毫无一症混杂。乃有附城一医。必执古方。用以川楝。绣谓病症不杂。何须用是。然终谓其古方所用川楝。稽书何无一语活动。间有指属反佐。亦无一语申明。以致蒙混不解。（书不尽言。）绣只据理投服。随手辄应。而不为方所执。及阅张璐本经逢原。其辨川楝功用。分为阴阳二疝。及有错杂之邪必用川楝之说。始叹理道本同。而古人则先于我而获。绣益信己所治族叔之病。而不敢用川楝者。未始不有理存。而竟所揆而如一也。（理终不易。）否则几为古方所误矣。故凡疝因热邪。及因蛊虫内蚀。宜于川楝。若使脾胃虚寒。症属阴疝。则川楝其切忌焉。楝以川产为正。去皮取肉。去核用根。有雌雄二种。雄根色赤。无子。大毒忌火。雌根白子多微毒。可采。去青留白。单味酒煎投服。杀虫治疟。煎汤洗之。可治中蛊。即时吐出。茴香为使。"}]},{"ID":"20240613132054-kd0sp78","Type":"NodeThematicBreak","Properties":{"id":"20240613132054-kd0sp78"}},{"ID":"20240613132055-pomd6jt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132055-pomd6jt","updated":"20240613132100"},"Children":[{"Type":"NodeText","Data":"楝实《增广和剂局方药性总论》"}]},{"ID":"20240613132055-c4f8ywo","Type":"NodeParagraph","Properties":{"id":"20240613132055-c4f8ywo","updated":"20240613132055"},"Children":[{"Type":"NodeText","Data":"主温疾，伤寒大热烦狂，杀三虫疥疡，利小便水道。根∶微寒。疗蛔虫，利大肠。《性论》云∶主人中大热，狂，失心躁闷。日华子云∶治游风，热毒风疹，恶疮疥癞，小儿热。《经验方》∶治脏毒下血，丈夫本脏气伤，膀胱连小肠等气。《唐本》注云∶有两种者，根赤无子，有毒，服之多使人吐泻，杀人。雌者，根白有子，微毒。用当取雌者。生∶荆山。"}]},{"ID":"20240613132032-wpjbsxf","Type":"NodeThematicBreak","Properties":{"id":"20240613132032-wpjbsxf"}},{"ID":"20240613132033-bima7qc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132033-bima7qc","updated":"20240613132038"},"Children":[{"Type":"NodeText","Data":"楝《本草纲目》"}]},{"ID":"20240613132033-j2q6tx4","Type":"NodeParagraph","Properties":{"id":"20240613132033-j2q6tx4","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"「释名」苦楝。实名金铃子。"}]},{"ID":"20240613132033-90w4s33","Type":"NodeParagraph","Properties":{"id":"20240613132033-90w4s33","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"「气味」苦、寒、有小毒。"}]},{"ID":"20240613132033-pouwv9i","Type":"NodeParagraph","Properties":{"id":"20240613132033-pouwv9i","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613132033-3qfccc4","Type":"NodeParagraph","Properties":{"id":"20240613132033-3qfccc4","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"1、热厥心前（或发或止，身热足寒，长期不愈）先灸大溪、昆仑两穴，引热下行，然后内服“金铃散”：用金铃子、元胡索各一两，共研为末，每服三钱，温酒调下。"}]},{"ID":"20240613132033-jlq4zl0","Type":"NodeParagraph","Properties":{"id":"20240613132033-jlq4zl0","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"2、小儿冷疝（气痛、阴囊浮肿）。用金铃子（去核）五钱、吴茱萸二钱半，共研为末，加酒、糊做成丸子，如黍米在。每服二、三十丸，盐汤送下。"}]},{"ID":"20240613132033-ktglltk","Type":"NodeParagraph","Properties":{"id":"20240613132033-ktglltk","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"3、疝肿痛。阴囊偏坠。用楝子肉五两，分作五份：一两用破故纸二钱炒黄，一两用小茴香三钱、食盐半钱同炒，一两用莱菔子一钱同炒，一两用牵牛子三钱同炒，一两用斑蝥七枚（去头足）同炒。炒后，分别拣去食盐、莱菔、牵牛、班蝥，只留破故纸、茴香，与楝子同研为末，加酒、面糊为丸子，如梧子大。每服五十丸，窍主服，酒送下。又方：用楝子经酒润过，取肉一斤，分作四份：一份用小麦一合、斑蝥四十九个同炒熟，去蝥；一份用小麦合、巴豆四十九枚同炒熟，去豆；一份用小麦一合、巴戟肉一两同炒熟。去戟；一份用小茴香一合、食盐一两同炒熟，去盐。再加破故纸（酒炒）一两、广木香（不见火）一两，一起研为末，酒煮面糊成丸子，如梧子大。每服五十丸，空心服，盐汤送下。一天服三次。又方：有楝子肉四十九个，分作七份：一份用小茴香五钱同炒，一分同破故纸二钱半同炒，一份用黑牵牛二钱半同炒，一份用食盐二钱同炒，一份用萝卜子二钱半同炒，一份用巴豆十四个同炒，一份用斑蝥十四个（去头足）同炒。炒后，分别拣去萝卜子、巴豆、斑蝥三味，另加入青木香五钱，南木香、官桂各二钱半，各药共研为末，酒煮面糊成丸子，如梧子大。每服三十丸，饭前服，盐汤送下。一天服三次。"}]},{"ID":"20240613132033-vgmw9o0","Type":"NodeParagraph","Properties":{"id":"20240613132033-vgmw9o0","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"4、脏毒下血。用苦楝子炒黄并研为末，加蜜做成丸子，如梧子大。每服十至二十丸，米汤送下。"}]},{"ID":"20240613132033-lvwhgd9","Type":"NodeParagraph","Properties":{"id":"20240613132033-lvwhgd9","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"5、腹中有虫。用楝实在苦酒中浸一夜，棉裹好，塞入肛门内。一天换二次。"}]},{"ID":"20240613132033-xhhf8pq","Type":"NodeParagraph","Properties":{"id":"20240613132033-xhhf8pq","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"6、小便如膏，排出困难。用苦楝子、茴香等分，炒研为末。每服一钱，温酒送下。"}]},{"ID":"20240613132033-bpolcfu","Type":"NodeParagraph","Properties":{"id":"20240613132033-bpolcfu","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"7、小儿疳疾。用苦楝子、川芎，等分为末，加猪胆汁调成丸子，米汤帝服适量。"}]},{"ID":"20240613132033-giq2z1f","Type":"NodeParagraph","Properties":{"id":"20240613132033-giq2z1f","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"根及木皮："}]},{"ID":"20240613132033-1l8ts4r","Type":"NodeParagraph","Properties":{"id":"20240613132033-1l8ts4r","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"1、消渴有虫。用苦楝根白皮一把。切细，焙干，加麝香少许，添水二碗，煎成一碗，空心服下。打下虫后，其渴自止。"}]},{"ID":"20240613132033-lxexvvs","Type":"NodeParagraph","Properties":{"id":"20240613132033-lxexvvs","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"2、小儿蛔虫。用楝木皮削去苍皮，加水煮汁，随小儿年龄适量饮食。又方：用楝木皮研末，米汤送服二钱。又方：用根皮同鸡蛋煮熟，空心吃睛，次日可将虫打邮。又方：用苦楝皮二两、白芜荑半两，共研为末，每取一、二钱，水煎服。此方“抵圣散”。又方：用楝白皮（去粗）二斤，切细，加不一斗，煮成汁三升，再熬成膏。五更时，温酒送服一匙，以虫下为度。"}]},{"ID":"20240613132033-1ecbyet","Type":"NodeParagraph","Properties":{"id":"20240613132033-1ecbyet","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"3、小儿诸疮（恶疮、秃疮、蠼螋疮、浸淫疮等）。用楝树皮或枝烧灰敷疮上。如是干疮，则用猪油调灰涂搽。"}]},{"ID":"20240613132033-mklgd4o","Type":"NodeParagraph","Properties":{"id":"20240613132033-mklgd4o","updated":"20240613132033"},"Children":[{"Type":"NodeText","Data":"4、蜈蚣或蜂螫伤。和楝树枝叶捣汁搽。"}]},{"ID":"20240613131959-3em3g86","Type":"NodeThematicBreak","Properties":{"id":"20240613131959-3em3g86"}},{"ID":"20240613132000-y628iyh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132000-y628iyh","updated":"20240613132006"},"Children":[{"Type":"NodeText","Data":"楝实《本草乘雅半偈》"}]},{"ID":"20240613132000-k32ouxo","Type":"NodeParagraph","Properties":{"id":"20240613132000-k32ouxo","updated":"20240613132000"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613132000-diyry8y","Type":"NodeParagraph","Properties":{"id":"20240613132000-diyry8y","updated":"20240613132000"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，有小毒。"}]},{"ID":"20240613132000-3l36zw7","Type":"NodeParagraph","Properties":{"id":"20240613132000-3l36zw7","updated":"20240613132000"},"Children":[{"Type":"NodeText","Data":"【主治】主温病，伤寒大热烦狂，杀三虫疥疡，利小便水道。"}]},{"ID":"20240613132000-3lomdxb","Type":"NodeParagraph","Properties":{"id":"20240613132000-3lomdxb","updated":"20240613132000"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出荆山山谷，及蜀中所在有之，蜀中者胜。木高数丈，向长甚速，叶密如槐而长。三四月开花红紫色，芬芳满境。实如金丸，生青熟黄。叶可浣衣，蛟龙畏之，獬豸食之。修治，熬干，酒拌令透，蒸之，俟实皮软，去皮取肉。凡使核不使肉，使肉不使核。如使核，捶碎，浆水煮一伏时，晒干用。"}]},{"ID":"20240613132000-mj32kss","Type":"NodeParagraph","Properties":{"id":"20240613132000-mj32kss","updated":"20240613132022"},"Children":[{"Type":"NodeText","Data":"【 】曰∶楝可浣衣，具清肃之金用。气寒味苦，具澄湛之水体。獬豸食之，火兽也，喜其洁。蛟龙畏之，木虫也，激其怒。怒则飞云弄雨，以消溽暑，此其功力。如三虫疝瘕，从蛰伏中,激之杀之,反其性耳。"}]},{"ID":"20240613131907-f32usbg","Type":"NodeThematicBreak","Properties":{"id":"20240613131907-f32usbg"}},{"ID":"20240613131909-5iootel","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131909-5iootel","updated":"20240613131913"},"Children":[{"Type":"NodeText","Data":"楝实《新修本草》"}]},{"ID":"20240613131909-hoyaxjh","Type":"NodeParagraph","Properties":{"id":"20240613131909-hoyaxjh","updated":"20240613131909"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有小毒。主温疾，伤寒大热烦狂，杀三虫，疥疡，利小便水道。根，微寒，疗蛔虫，利大肠。生荆山山谷。"}]},{"ID":"20240613131909-u8zl1fq","Type":"NodeParagraph","Properties":{"id":"20240613131909-u8zl1fq","updated":"20240613131909"},"Children":[{"Type":"NodeText","Data":"处处有，俗人五月五日皆取花叶佩带之，云辟恶。其根以苦酒磨涂疥，甚良。煮汁作糜，食〔谨案〕此物有两种，有雄有雌。雄者根赤，无子，有毒，服之多使人吐不能止，时有至死者。雌者根白，有子，微毒，用当取雌者。"}]},{"ID":"20240613131921-sq17jd6","Type":"NodeThematicBreak","Properties":{"id":"20240613131921-sq17jd6"}},{"ID":"20240613131922-cltn67h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131922-cltn67h","updated":"20240613131926"},"Children":[{"Type":"NodeText","Data":"楝实《神农本草经赞》"}]},{"ID":"20240613131922-c1jztsx","Type":"NodeParagraph","Properties":{"id":"20240613131922-c1jztsx","updated":"20240613131922"},"Children":[{"Type":"NodeText","Data":"味苦寒。主温疾伤寒。大热烦狂。杀三虫疥疡。利小便水道。生山谷。"}]},{"ID":"20240613131922-2mukbvx","Type":"NodeParagraph","Properties":{"id":"20240613131922-2mukbvx","updated":"20240613131922"},"Children":[{"Type":"NodeText","Data":"低昂红紫。花信风周。金铃摇曳。珠弹轻柔。资供雏食。善种雌求。区分肉核。性不相谋。"}]},{"ID":"20240613131922-evsojmc","Type":"NodeParagraph","Properties":{"id":"20240613131922-evsojmc","updated":"20240613131922"},"Children":[{"Type":"NodeText","Data":"韩愈诗。红紫相低昂。岁时记。花信风。始梅花。终楝花。李时珍曰。实名金铃子。孟浩然诗。王孙挟珠弹。苏颂曰。三四月开花红紫色。实如弹丸。南史传。凡所资供。一无所受。"}]},{"ID":"20240613131922-1knau6k","Type":"NodeParagraph","Properties":{"id":"20240613131922-1knau6k","updated":"20240613131922"},"Children":[{"Type":"NodeText","Data":"农书。雏食其实。净住子能生善种。诗。尚求其雌。苏恭曰。雌雄二种。雌者有子。雷论。凡使肉不使核。使核不使肉。论语。道不同不相为谋。"}]},{"ID":"20240613131857-0t22tf8","Type":"NodeThematicBreak","Properties":{"id":"20240613131857-0t22tf8"}},{"ID":"20240613131858-ulog4n6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131858-ulog4n6","updated":"20240613131902"},"Children":[{"Type":"NodeText","Data":"楝实《冯氏锦囊秘录》"}]},{"ID":"20240613131858-tki4ln4","Type":"NodeParagraph","Properties":{"id":"20240613131858-tki4ln4","updated":"20240613131858"},"Children":[{"Type":"NodeText","Data":"禀天之阴气，得地之苦味，故味极苦气寒，有小毒。入足阳明、手足太阴经。以苦寒之性，故能除温疾狂热，利水杀虫用。如脾胃虚实者忌。"}]},{"ID":"20240613131858-r3dqjkq","Type":"NodeParagraph","Properties":{"id":"20240613131858-r3dqjkq","updated":"20240613131858"},"Children":[{"Type":"NodeText","Data":"楝实即金铃子。去皮复选肉，主温疾伤寒，大热烦狂，理膀胱小肠疝气吊痛，利小便水道，杀三虫疥疮。根有雌雄、雄根赤无子大毒忌煎。雌根白子多微毒可采，东行者佳，去青留白，单味煎酒，上半月服，大能杀虫，多则成团追下，皮当逐个推来，积聚行疼痛止，研敷作痒虫疮。"}]},{"ID":"20240613131858-uh5gnfw","Type":"NodeParagraph","Properties":{"id":"20240613131858-uh5gnfw","updated":"20240613131858"},"Children":[{"Type":"NodeText","Data":"按∶苦寒之性，宜于杀虫，若脾胃虚寒者禁之。"}]},{"ID":"20240613131825-x34hew6","Type":"NodeThematicBreak","Properties":{"id":"20240613131825-x34hew6"}},{"ID":"20240613131826-5r1fse3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131826-5r1fse3","updated":"20240613131831"},"Children":[{"Type":"NodeText","Data":"楝实《本草经集注》"}]},{"ID":"20240613131826-4yfyzds","Type":"NodeParagraph","Properties":{"id":"20240613131826-4yfyzds","updated":"20240613131826"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有小毒。主治温疾，伤寒大热烦狂，杀三虫，疥疡，利小便水道。根，微寒，治蛔虫，利大肠。生荆山山谷。"}]},{"ID":"20240613131826-3heil7f","Type":"NodeParagraph","Properties":{"id":"20240613131826-3heil7f","updated":"20240613131826"},"Children":[{"Type":"NodeText","Data":"处处有，世人五月五日皆取花叶佩带之，云辟恶。其根以苦酒磨涂疥，甚良。煮汁作糜，食之去蛔虫。"}]},{"ID":"20240613131758-mww8b9x","Type":"NodeThematicBreak","Properties":{"id":"20240613131758-mww8b9x"}},{"ID":"20240613131759-isqbu22","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131759-isqbu22","updated":"20240613131807"},"Children":[{"Type":"NodeText","Data":"楝实《证类本草》"}]},{"ID":"20240613131759-wdinqmm","Type":"NodeParagraph","Properties":{"id":"20240613131759-wdinqmm","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有小毒。主温疾伤寒，大热烦狂，杀三虫，疥疡，利小便水道。"}]},{"ID":"20240613131759-jwj9lm0","Type":"NodeParagraph","Properties":{"id":"20240613131759-jwj9lm0","updated":"20240613131759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"微寒。疗蛔虫，利大肠。生荆山山谷。"}]},{"ID":"20240613131759-ddg16nq","Type":"NodeParagraph","Properties":{"id":"20240613131759-ddg16nq","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶处处有。俗人五月五日皆取叶佩之，云辟恶。其根以苦酒摩涂疥，甚良。煮汁作糜食之，去蛔虫。唐本注云∶此有两种∶有雄有雌，雄者根赤，无子，有毒，服之多使人吐，不能止，时有至死者；雌者根白，有子，微毒。用当取雌者。臣禹锡等谨按药性论云∶楝实，亦可单用。主人中大热狂，失心躁闷，作汤浴，不入汤服。日华子云∶楝皮，苦，微毒。治游风热毒，风疹恶疮疥癞，小儿壮热，并煎汤浸洗。服食须是生子者。"}]},{"ID":"20240613131759-w0jh88m","Type":"NodeParagraph","Properties":{"id":"20240613131759-w0jh88m","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"雌树皮一两，可入五十粒糯米煎煮，杀毒，泻多以冷粥止，不泻者以热葱粥发。无子雄树，能吐泻杀人，不图经曰∶楝实，即金铃子也。生荆山山谷，今处处有之，以蜀川者为佳。木高丈余，叶密如槐而长。三、四月开花，红紫色，芬香满庭间。实如弹丸，生青熟黄，十二月采实。其根采无时。此种有雌雄。雄者很赤，无子，有大毒；雌者根白，有子，微毒。当用雌者，俗间谓之苦楝子。韦宙《独行方》主蛲虫攻心如刺，口吐清水。取根锉，水煮令浓赤黑色。以汁合雷公云∶凡采得后晒干，酒拌浸令湿，蒸，待上皮软，剥去皮，取肉去核。勿单用。其核碎槌，用浆水煮一伏时了用。如使肉，即不使核，使核即不使肉。又花落子，谓之石茱萸。"}]},{"ID":"20240613131759-78ghbrh","Type":"NodeParagraph","Properties":{"id":"20240613131759-78ghbrh","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"外台秘要方∶治长虫。楝实，淳苦酒中渍宿，以绵裹，塞谷道中三寸许，日易之。千金方∶治小儿蛔虫，楝木皮削上苍皮，以水煮汁饮，量大小进。又方∶蠼 疮。楝树枝皮烧灰，和猪膏敷之。又方∶治小儿秃疮及诸恶疮。肘后方∶治 若着口。裹东行楝根细锉，水煮浓汁含之数口，吐勿咽。"}]},{"ID":"20240613131759-8arswa0","Type":"NodeParagraph","Properties":{"id":"20240613131759-8arswa0","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"经验方∶小儿杀虫，定疼痛。抵圣散∶以苦楝二两，白芜荑半两，为末，水一盏，末一钱时服之。又方∶治脏毒小血。以苦楝子炒令黄，为末蜜丸。米饮下十丸至二十丸，甚妙。又方∶治丈本脏气伤，膀胱连小肠等气。金铃子一百个，汤温浸过去皮，巴豆二百个槌微破，麸二升，同于铜铛内炒，金铃子赤熟为度，放冷取出，去核为末。每服三钱，非时热酒、醋汤调并得，其麸、巴豆不用也。斗门方∶治蛔虫咬心，用苦楝治皮煎一大盏服下。"}]},{"ID":"20240613131759-wq0zna2","Type":"NodeParagraph","Properties":{"id":"20240613131759-wq0zna2","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"又方∶治五种虫。以楝皮去其苍者，焙干为末，米饮下二钱匕。又方∶治瘾疹，楝皮浓煎浴。"}]},{"ID":"20240613131759-owlms81","Type":"NodeParagraph","Properties":{"id":"20240613131759-owlms81","updated":"20240613131759"},"Children":[{"Type":"NodeText","Data":"荆楚岁时记∶云∶风俗通，獬豸食楝。又云蛟龙裹楝。"}]},{"ID":"20240613131718-1cuuhqk","Type":"NodeThematicBreak","Properties":{"id":"20240613131718-1cuuhqk"}},{"ID":"20240613131734-dgempkt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131734-dgempkt","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：川楝子"}]},{"ID":"20240613131734-7op56vr","Type":"NodeParagraph","Properties":{"id":"20240613131734-7op56vr","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Chuān Liàn Zǐ"}]},{"ID":"20240613131734-fd0dfqp","Type":"NodeParagraph","Properties":{"id":"20240613131734-fd0dfqp","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"英文名"},{"Type":"NodeText","Data":"FRUCTUS TOOSENDAN"}]},{"ID":"20240613131734-z09r74w","Type":"NodeParagraph","Properties":{"id":"20240613131734-z09r74w","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"金铃子、川楝实"}]},{"ID":"20240613131734-rkkbujr","Type":"NodeParagraph","Properties":{"id":"20240613131734-rkkbujr","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"本品为楝科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川楝"},{"Type":"NodeText","Data":"Melia toosendan Sieb. et Zucc.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。冬季果实成熟时采收，除去杂质，干燥。"}]},{"ID":"20240613131734-4lk7jgu","Type":"NodeParagraph","Properties":{"id":"20240613131734-4lk7jgu","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"落叶乔木，高可达10米。树皮灰褐色，有纵沟纹，幼嫩部分密被星状鳞片。叶互生，二至三回单数羽状复叶。夏季开紫色花，腋生圆锥状排列的聚伞花序。核果大，椭圆形或近圆形，长约3厘米，红色或栗棕色，有光泽，核坚硬木质，有棱，6～8室。种子3～5粒。"}]},{"ID":"20240613131734-umsqfqh","Type":"NodeParagraph","Properties":{"id":"20240613131734-umsqfqh","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性状"},{"Type":"NodeText","Data":"本品呈类球形，直径2～3.2cm。表面金黄色至棕黄色，微有光泽，少数凹陷或皱缩，具深棕色小点。顶端有花柱残痕，基部凹陷，有果梗痕。外果皮革质，与果肉间常成空隙，果肉松软，淡黄色，遇水润湿显黏性。果核球形或卵圆形，质坚硬，两端平截，有6～8条纵棱，内分6～8室，每室含黑棕色长圆形的种子1粒。气特异，味酸、苦。"}]},{"ID":"20240613131734-3fi9r9w","Type":"NodeParagraph","Properties":{"id":"20240613131734-3fi9r9w","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炮制川楝子"},{"Type":"NodeText","Data":"：除去杂质。用时捣碎。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒川楝子："},{"Type":"NodeText","Data":"取净川楝子，切厚片或碾碎，照清炒法（附录Ⅱ D）炒至表面焦黄色。"}]},{"ID":"20240613131734-afhw80h","Type":"NodeParagraph","Properties":{"id":"20240613131734-afhw80h","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"苦，寒；有小毒。"}]},{"ID":"20240613131734-kb7r0oc","Type":"NodeParagraph","Properties":{"id":"20240613131734-kb7r0oc","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"归经"},{"Type":"NodeText","Data":"归肝、小肠、膀胱经。"}]},{"ID":"20240613131734-gp0nzyl","Type":"NodeParagraph","Properties":{"id":"20240613131734-gp0nzyl","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"舒肝行气止痛，驱虫。用于胸胁、脘腹胀痛，疝痛，虫积腹痛。"}]},{"ID":"20240613131734-q3ed5m1","Type":"NodeParagraph","Properties":{"id":"20240613131734-q3ed5m1","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"4.5～9g。"}]},{"ID":"20240613131734-is4mw5i","Type":"NodeParagraph","Properties":{"id":"20240613131734-is4mw5i","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"贮藏"},{"Type":"NodeText","Data":"置通风干燥处，防蛀。"}]},{"ID":"20240613131734-mmwtczz","Type":"NodeParagraph","Properties":{"id":"20240613131734-mmwtczz","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《全国中草药汇编》"}]},{"ID":"20240613131734-om12ho0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131734-om12ho0","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：川楝子"}]},{"ID":"20240613131734-0j33n22","Type":"NodeParagraph","Properties":{"id":"20240613131734-0j33n22","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Chuān Liàn Zǐ"}]},{"ID":"20240613131734-svf1uyt","Type":"NodeParagraph","Properties":{"id":"20240613131734-svf1uyt","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"楝实（《本经》），练实（《本草经集注》），金铃子。仁枣（侯宁极《药谱》），苦楝子（《本草图经））。"}]},{"ID":"20240613131734-nt9wxuo","Type":"NodeParagraph","Properties":{"id":"20240613131734-nt9wxuo","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"《本草正》"}]},{"ID":"20240613131734-p7c62fg","Type":"NodeParagraph","Properties":{"id":"20240613131734-p7c62fg","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"为樟科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川楝"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613131734-vfhc7xx","Type":"NodeParagraph","Properties":{"id":"20240613131734-vfhc7xx","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"川楝（《摘元方》）"}]},{"ID":"20240613131734-mbyslnt","Type":"NodeParagraph","Properties":{"id":"20240613131734-mbyslnt","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"乔木，高达10余米。树皮灰褐色，小枝灰黄色。2回单数羽状复叶，互生，总叶柄长5～12厘米，羽片4～5对，各对间距离疏远；小叶2～5对，卵形成窄卵形，长4～7厘米，宽2～3．5厘米，先端渐尖或长渐尖，基部圆形，常不对称，全缘或有疏锯齿。圆锥状聚伞花序，腋生，密生短毛及星状毛；总花梗长达10厘米；花淡紫色，直径6～8毫米；萼5～6片，灰绿色；花瓣5～6枚，狭长倒披针形；雄蕊2倍于花瓣数，花丝连合成管状；子房瓶状，6～8室，偶或5室。核果长圆形或近圆形，黄色或栗棕色。种子扁平长椭圆形，黑色，长约1厘米。花糊3～4月。果期9～11月。"}]},{"ID":"20240613131734-ieht16v","Type":"NodeParagraph","Properties":{"id":"20240613131734-ieht16v","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生境分部"},{"Type":"NodeText","Data":"生于疏林中潮湿处。分布四川、湖北、湖南、河南、贵州及甘肃南部等地。主产四川、湖北、贵州、河南等地。"}]},{"ID":"20240613131734-s80irf5","Type":"NodeParagraph","Properties":{"id":"20240613131734-s80irf5","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性状"},{"Type":"NodeText","Data":"干燥果实呈球形或椭圆形，长径1．5～3厘米，短径1．5～2．3厘米。表面黄色或黄棕色，微具光译，具深棕色或黄棕色圆点，微有凹陷或皱缩。一端凹陷，有果柄脱落痕迹，另一端较平，有一棕色点状蒂痕。果皮革质，与果肉间常有空隙。果肉厚，浅黄色，质松软。果核球形或卵圆形，两端平截，土黄色，表面具6～8条纵棱，内分6～8室，含黑紫色扁梭形种子6～8枚。种仁乳白色，有油性。气特异，味酸而苦。以表面金黄色，肉黄白色，厚而松软者为佳。"}]},{"ID":"20240613131734-atv5uj5","Type":"NodeParagraph","Properties":{"id":"20240613131734-atv5uj5","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"化学成分"},{"Type":"NodeText","Data":"含川楝素（toosendanin）、生物碱、山柰醇、树脂、鞣质。"}]},{"ID":"20240613131734-ohmu0g0","Type":"NodeParagraph","Properties":{"id":"20240613131734-ohmu0g0","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炮制"},{"Type":"NodeText","Data":"川楝子：拣去杂质，洗净，烘干，轧碎或劈成两半。炒川楝子：将轧碎去核的川楝肉，用麸皮拌炒至深黄色为度，取出放凉。"}]},{"ID":"20240613131734-bdqpi15","Type":"NodeParagraph","Properties":{"id":"20240613131734-bdqpi15","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"（楝实）采得后晒干，酒拌浸令湿，蒸，待上皮软，剥去皮，取肉去核，勿单用其核，槌碎，用浆水煮一伏时用。如使肉即不使核，使核即不使肉。\""}]},{"ID":"20240613131734-6stb842","Type":"NodeParagraph","Properties":{"id":"20240613131734-6stb842","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"苦，寒，有毒。"}]},{"ID":"20240613131734-elt8fqv","Type":"NodeParagraph","Properties":{"id":"20240613131734-elt8fqv","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，寒。\""}]},{"ID":"20240613131734-rmfdcuh","Type":"NodeParagraph","Properties":{"id":"20240613131734-rmfdcuh","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"有小毒。\""}]},{"ID":"20240613131734-aqk7gau","Type":"NodeParagraph","Properties":{"id":"20240613131734-aqk7gau","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"③《珍珠囊》：\"酸，苦。\""}]},{"ID":"20240613131734-xrmjfqj","Type":"NodeParagraph","Properties":{"id":"20240613131734-xrmjfqj","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"核：苦辛；寒。\""}]},{"ID":"20240613131734-od48c1d","Type":"NodeParagraph","Properties":{"id":"20240613131734-od48c1d","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"归经"},{"Type":"NodeText","Data":"入肝、胃、小肠经。"}]},{"ID":"20240613131734-ijuenrb","Type":"NodeParagraph","Properties":{"id":"20240613131734-ijuenrb","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"入心。\""}]},{"ID":"20240613131734-qefahut","Type":"NodeParagraph","Properties":{"id":"20240613131734-qefahut","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、小肠二经。\""}]},{"ID":"20240613131734-sjfz4v0","Type":"NodeParagraph","Properties":{"id":"20240613131734-sjfz4v0","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足阳明、手足太阴经。\""}]},{"ID":"20240613131734-o4lzw4o","Type":"NodeParagraph","Properties":{"id":"20240613131734-o4lzw4o","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"④《得配本草》：\"入足厥阴经。\""}]},{"ID":"20240613131734-9c5a00y","Type":"NodeParagraph","Properties":{"id":"20240613131734-9c5a00y","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"除湿热，清肝火，止痛，杀虫。治热厥心痛，胁痛，疝痛，虫积腹痛。"}]},{"ID":"20240613131734-gnkz9vt","Type":"NodeParagraph","Properties":{"id":"20240613131734-gnkz9vt","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主温疾、伤寒太热烦狂，杀三虫疥窃，利小便水道。\""}]},{"ID":"20240613131734-8r6d6vw","Type":"NodeParagraph","Properties":{"id":"20240613131734-8r6d6vw","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"主人中大热，狂，失心躁闷，作汤浴。\""}]},{"ID":"20240613131734-2okzy06","Type":"NodeParagraph","Properties":{"id":"20240613131734-2okzy06","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"③《珍珠囊》：\"主上下部腹痛，心暴痛。\""}]},{"ID":"20240613131734-ngxxhu1","Type":"NodeParagraph","Properties":{"id":"20240613131734-ngxxhu1","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治诸疝、虫、痔。\""}]},{"ID":"20240613131734-dddufym","Type":"NodeParagraph","Properties":{"id":"20240613131734-dddufym","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"泻心火，坚肾水，清肺金，清肝火。核：怡疝，去痼冷。\""}]},{"ID":"20240613131734-7nwoigw","Type":"NodeParagraph","Properties":{"id":"20240613131734-7nwoigw","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"⑥《本革求原》：\"治淋病茎痛引胁，遗精，积聚，诸逆冲上，溲下血，头痛，牙宣出血，杀虫。\""}]},{"ID":"20240613131734-czeqlq8","Type":"NodeParagraph","Properties":{"id":"20240613131734-czeqlq8","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服：煎汤，1．5～3钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240613131734-499cy2u","Type":"NodeParagraph","Properties":{"id":"20240613131734-499cy2u","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"脾胃虚寒者忌服。"}]},{"ID":"20240613131734-obfh5m3","Type":"NodeParagraph","Properties":{"id":"20240613131734-obfh5m3","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"《纲目》：\"茴香为之使。\""}]},{"ID":"20240613131734-vyorifa","Type":"NodeParagraph","Properties":{"id":"20240613131734-vyorifa","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复方"},{"Type":"NodeText","Data":"①治热厥心痛，或发或止，久不愈者：金铃子、玄胡索各一两。上为细末，每服二、三钱，酒调下，温汤亦得。（《活法机要》金铃子散）"}]},{"ID":"20240613131734-4dp9lzn","Type":"NodeParagraph","Properties":{"id":"20240613131734-4dp9lzn","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"②治膀胱疝气，闭塞下元，大小便不通，疼痛不可忍者：金铃子肉四十九枚（锉碎如豆大，不令研细，用巴豆四十九枚，去皮不令碎，与金铃子肉同炒至金铃子深黄色，不用巴豆），茴香一两（炒）。上件除巴豆不用外，将二味为细末，每服二钱，温酒调下，食前。（《杨氏家藏方》金铃子散）"}]},{"ID":"20240613131734-8ack1tk","Type":"NodeParagraph","Properties":{"id":"20240613131734-8ack1tk","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"③治寒疝，以及偏坠，小肠庙痛：川楝子三钱，小茴香五分，木香一钱，淡吴茱萸一钱。长流水煎服。（《医方简义》导气汤）"}]},{"ID":"20240613131734-812avpx","Type":"NodeParagraph","Properties":{"id":"20240613131734-812avpx","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"④治脏毒下血：苦楝子炒令黄。为末，蜜丸。米饮下十丸至二十丸。（《经验方》）"}]},{"ID":"20240613131734-0vbs0uj","Type":"NodeParagraph","Properties":{"id":"20240613131734-0vbs0uj","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"⑤治肾消膏淋，病在下焦：苦楝子、茴香等分。为末，每温酒服-钱。（《圣惠方》）"}]},{"ID":"20240613131734-ytnveoq","Type":"NodeParagraph","Properties":{"id":"20240613131734-ytnveoq","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"⑥治小儿五疳：川楝子肉、川芎等分。为末，猪胆汁丸。米次下。（《摘元方》）"}]},{"ID":"20240613131734-b5s4mcp","Type":"NodeParagraph","Properties":{"id":"20240613131734-b5s4mcp","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"⑦治耳有恶疮：楝于，捣，以绵裹塞耳内。（《圣惠方》）"}]},{"ID":"20240613131734-ya21yw6","Type":"NodeParagraph","Properties":{"id":"20240613131734-ya21yw6","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"临床应用"},{"Type":"NodeText","Data":"①治疗急性乳腺炎"}]},{"ID":"20240613131734-8hxf9aj","Type":"NodeParagraph","Properties":{"id":"20240613131734-8hxf9aj","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"将苦楝子连皮和仁，捣碎晒干，炒微黄，研细末。每次以苦楝子末3钱，红糖2两，用黄酒或开水100～200毫升冲服，每日1～2次，连服2～5次。共治43例，其中初诊时未化脓者34例，服药2～4次，均在3天内治愈。"}]},{"ID":"20240613131734-8txzvf7","Type":"NodeParagraph","Properties":{"id":"20240613131734-8txzvf7","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"②治疗头癣"}]},{"ID":"20240613131734-5kt2i0o","Type":"NodeParagraph","Properties":{"id":"20240613131734-5kt2i0o","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"苦楝子烤黄研成细末，用熟猪油或凡士林调成50％油膏。先将患者头发剃光或剪短，用清水洗净疮痂，再以5～10％明矾水洗1遍，擦干，涂油膏（约厚2～3毫米），每日1次，连续10天为一疗程，一般2～3个疗程可愈。上法共治发癣患者4000余人，有效率98％以上。"}]},{"ID":"20240613131734-vwnkitx","Type":"NodeParagraph","Properties":{"id":"20240613131734-vwnkitx","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"备注"},{"Type":"NodeText","Data":"陕西、安徽、江苏、山东、湖北等地，有时以同属植物苦楝的果实，作本品使用。苦楝果实形状较小，直径1～2厘米。表面红褐色间有黄棕色，具光泽，多皱缩，有多数棕色小点。一端可见果柄残痕，另一端有一圆形凹点。果皮革质，易剥离。果核长椭圆形，具5～6条纵棱，内含种子4～6枚。种子扁梭形，紫红色，皮薄，内有子叶2片，黄白色，富油性。气微而特异，味酸而后苦。原植物洋\"苦楝皮\"条。"}]},{"ID":"20240613131734-h4huzii","Type":"NodeParagraph","Properties":{"id":"20240613131734-h4huzii","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《中药大辞典》"}]},{"ID":"20240613131734-voupcsd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613131734-voupcsd","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"《中华本草》：川楝子"}]},{"ID":"20240613131734-0fw7m9b","Type":"NodeParagraph","Properties":{"id":"20240613131734-0fw7m9b","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Chuān Liàn Zǐ"}]},{"ID":"20240613131734-3uk8tb4","Type":"NodeParagraph","Properties":{"id":"20240613131734-3uk8tb4","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"英文名"},{"Type":"NodeText","Data":"Szechwan Chinaberry Fruit"}]},{"ID":"20240613131734-utcgmls","Type":"NodeParagraph","Properties":{"id":"20240613131734-utcgmls","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"楝实、练实、金铃子、仁枣、苦楝子、楝子、石茱萸、楝树果、川楝树子、川楝实。"}]},{"ID":"20240613131734-2p4st6c","Type":"NodeParagraph","Properties":{"id":"20240613131734-2p4st6c","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"出自《本草正》"}]},{"ID":"20240613131734-tpmnr08","Type":"NodeParagraph","Properties":{"id":"20240613131734-tpmnr08","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"药材基源：为楝科植物川楝的果实。"}]},{"ID":"20240613131734-9lvrfin","Type":"NodeParagraph","Properties":{"id":"20240613131734-9lvrfin","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Melia toosendan Sieb.et Zucc."}]},{"ID":"20240613131734-10jybcm","Type":"NodeParagraph","Properties":{"id":"20240613131734-10jybcm","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"采收和储藏：11-12月果皮呈浅黄色时采摘，晒或烘干。"}]},{"ID":"20240613131734-y60nui4","Type":"NodeParagraph","Properties":{"id":"20240613131734-y60nui4","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"川楝 乔木，高达10m。树皮灰褐色；幼嫩部分密被星状鳞片。二至三回奇数羽状复叶，长约35cm；羽片4-5对；小叶卵形或窄卵形，长4-10cm，宽2-4cm，全缘或少有疏锯齿。圆锥花序腋生；花萼灰绿色，萼片5-6；花瓣5-6，淡紫色；雄蕊10或12，花丝合生成筒。核果大，椭圆形或近球形，长约3cm，黄色或粟棕色，果皮为坚硬木质，有棱，6-8室，种子长椭圆形，扁平。花期3-4月，果期9-11月。"}]},{"ID":"20240613131734-jp7e4es","Type":"NodeParagraph","Properties":{"id":"20240613131734-jp7e4es","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生境分部"},{"Type":"NodeText","Data":"生态环境：生于海拔500-2100m的杂木林和疏林内或平坝、丘陵地带湿润处，常栽培于村旁附近或公路边。"}]},{"ID":"20240613131734-11tisza","Type":"NodeParagraph","Properties":{"id":"20240613131734-11tisza","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于甘肃、河南、湖北、湖南、广西、四川、贵州、云南等地。"}]},{"ID":"20240613131734-nqyvmfm","Type":"NodeParagraph","Properties":{"id":"20240613131734-nqyvmfm","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栽培"},{"Type":"NodeText","Data":"生物学特性 喜温暖湿润气候，喜阳，不耐荫蔽，在海拔1000m以下均可生长。以选阳光充足，土层深厚，疏松肥沃的砂质壤上栽培为宜。"}]},{"ID":"20240613131734-qugb71d","Type":"NodeParagraph","Properties":{"id":"20240613131734-qugb71d","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖，育苗移栽法。11-12月采摘浅黄色成熟果实作种，用清水浸泡2-3d，去果肉，取出果核，晾干，用湿沙贮藏催芽。翌年2月下旬至3月下旬播种。条播，按行距30cm开横沟，深约6cm，株距12cm。每穴放果核1枚，随即施人稀粪水，覆土8-10cm。播后1个月左右出苗，每枚果核可出苗3-5株。苗高10-15cm时中耕除草1次，施人粪尿；苗高18-20cm时，进行第2次中耕除草。培育1年，于冬季或第2年春季发芽前移栽。按行株距（2.5-3.5）cm ×（2.5-3.5）cm开穴，每穴栽苗1株，填上压实，浇足水。"}]},{"ID":"20240613131734-mvo8154","Type":"NodeParagraph","Properties":{"id":"20240613131734-mvo8154","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"田间管理 幼树要加强管理，以利成活。成年树每年春、秋季中耕除草，结合追肥；冬季进行修枝。遇旱及时灌水。"}]},{"ID":"20240613131734-jmpym27","Type":"NodeParagraph","Properties":{"id":"20240613131734-jmpym27","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性状"},{"Type":"NodeText","Data":"性状鉴别 核果呈类圆形，直径2-3.2cm。表面金黄色至棕黄色，微有光泽，皱缩，或略有凹陷，具深棕色小点。顶端有花柱残痕，基部凹陷，有果梗痕。外果皮革质，与果肉间常有空隙；果肉松软，淡黄色，遇水润湿显粘性。果核球形或卵圆形，质坚硬，两端平截，有6-8条纵校，内分6-8室，每室含黑棕色长圆形的种子1颗。气特异，味酸、苦。以个大、饱满、外皮金黄色、果肉黄白色者为佳。"}]},{"ID":"20240613131734-ealbqfy","Type":"NodeParagraph","Properties":{"id":"20240613131734-ealbqfy","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果皮横切面：外果皮细胞类方形，外被厚角质层。中果皮主为薄壁细胞，内含淀粉粒，有的含草酸钙簇晶，直径约16μm；分泌细胞圆形或椭圆形，长85-197μm，宽40-127μm；内侧散布有细小维管束。内果皮主要为纤维，亦分布有石细胞，靠近中果皮的纤维多纵向排列，内侧的纤维多横向排列；晶纤维的含晶细胞，壁呈不均匀增厚，常数个相联，胞腔内含草酸钙棱晶，少数含簇晶。"}]},{"ID":"20240613131734-9vibe1p","Type":"NodeParagraph","Properties":{"id":"20240613131734-9vibe1p","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄棕色。①内果皮纤维及晶纤维成束，常上下层交错排列或排列不整齐。纤维长短不一，稍弯曲，末端钝圆，直径9-36μm，壁极厚，有的不规则纵裂成须束状，孔沟不明显，有的胞腔含黄棕色颗粒状物；含晶细胞壁厚薄不一，木化，含方晶，少数含簇晶。②果皮石细胞不规则长条形或长多角形，有瘤状突起或钝圆短分枝，弯曲呈S形，有的石细胞类圆形、类长圆形，直径14-54μm，长约至150μm，壁厚9-13μm，孔沟较稀而短，胞腔细窄，每一短分枝胞腔呈星状；也有石细胞壁稍厚，胞腔充满棕色物。③果皮孔纹细胞类长多角形或长条形，壁稍厚，弯曲，具圆纹孔或斜纹孔，常可见数个纹孔集成纹孔域。④种皮细胞鲜黄色或橙黄色。断面观细胞扁平，壁厚，有纵纹孔；表面观多角形，有较密颗粒状纹理。⑤种皮含晶细胞壁厚薄不一，胸腔内充满淡黄色、黄棕色或红棕色物，并含细小草酸钙方晶。此外，有果皮表皮细胞、种皮色素细胞、种皮内表皮细胞、草酸钙方晶及簇晶。"}]},{"ID":"20240613131734-oy81gje","Type":"NodeParagraph","Properties":{"id":"20240613131734-oy81gje","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"化学成分"},{"Type":"NodeText","Data":"果实含驱蛔有效成分川楝素（toosendanin），以及多种苦味的三萜成分，苦楝子酮（melianone）、脂苦楝子醇（lipomelianol），21-O-乙酰川楝子三醇（21-O-acetyltoosendantriol），21-O-甲基川楝子五醇（21-O-methyltoosendan-pentaol）。"}]},{"ID":"20240613131734-gwzbaci","Type":"NodeParagraph","Properties":{"id":"20240613131734-gwzbaci","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药理作用"},{"Type":"NodeText","Data":"1.驱虫作用：本品有驱蛔虫作用，有效成分为川楝素，它的乙醇提取物的作用强，与山道年相比，作用缓慢而持久。低浓度（1：5000-9000）川楝素对整条猪蛔虫及其节段有明显的兴奋作用，表现为自发活动增强，间歇地出现异常的剧烈收缩，运动的规律破坏，持续10-24小时。被认为川楝素是对蛔虫肌肉的直接作用。川楝素还能使虫体三磷酸腺苷的分解代谢加快，造成能量的供不应求而导致收缩性痉挛而疲劳，最后使虫体不能附着肠壁而被驱出体外，因此临床上服用川楝素排虫时间较迟，约24-48小时，排出虫体多数尚能活动。"}]},{"ID":"20240613131734-yz38hie","Type":"NodeParagraph","Properties":{"id":"20240613131734-yz38hie","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"2.对呼吸中枢的抑制作用：在大白鼠上记录膈神经放电和膈肌肌电，观察川楝素对呼吸的作用，结果表明，大剂量川楝素（2mg/只，静脉注射或肌肉注射）引起的呼吸衰竭，主要是由于它对中枢的抑制作用。延脑呼吸中枢部位直接给川楝素（0.01-0.15mg/只）的实验支持上述结论。中枢兴奋药尼可刹米对川楝素引起的呼吸抑制有轻微的对抗作用。川楝素对清醒家兔皮层自发电活动未见明显的影响。"}]},{"ID":"20240613131734-kqyw72g","Type":"NodeParagraph","Properties":{"id":"20240613131734-kqyw72g","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"3.抗肉毒中毒的动物的作用：川楝素对致死量肉毒中毒的小鼠，攻毒后6小时内给药治疗，其存活率可达80%以上；对肉毒中毒猴子，攻毒后24小时治疗，可治愈半数以上；对C型肉毒中毒亦有保护作用；与抗毒血清合用，可明显降低抗毒血清用量。以楝素能在神经一肌肉接头处对抗肉毒的阻遏作用。"}]},{"ID":"20240613131734-vns8c72","Type":"NodeParagraph","Properties":{"id":"20240613131734-vns8c72","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"毒性"},{"Type":"NodeText","Data":"小鼠腹腔注射、静脉注射、皮下注射、口服给予川楝素的半数致死量分别为13.8±1.2、14.6±0.9、14.3±1.5和244.2±44.0mg/kg。静脉注射和皮下注射的化疗指数分别为4.2和4.5。大鼠皮下注射和家兔静脉注射的半数致死量分别为9.8mg/kg和4.2mg/kg。小鼠的累积性毒性：半数致死量为18.7mg/kg，累积系数K＝1.13。猴的亚急性毒性试验表明，变化最明显的是SGPT，其次是肌无力。SGPT升高的最低剂量是0.0025m/kg×4，比猴静脉注射治疗的显效剂量（0.5m/kg×4）小6倍。川楝素在肝脏的含量比其它组织高，肝脏病理形态学的变化，也比其它脏器明显。"}]},{"ID":"20240613131734-dttasw2","Type":"NodeParagraph","Properties":{"id":"20240613131734-dttasw2","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"同属植物苦楝有毒，曾有小孩食入而中毒致死的报告。中毒症状为恶心、呕吐、下泻、呼吸困难及心悸等。犬口服后很快引起呕吐，故不易中毒。牛、马亦可中毒；而猪则最敏感，服200g半小时即中毒，2-3小时即可死亡；主要症状为中枢抑制、昏迷，解剖时除见有胃、小肠的炎症及扩张外，尚有肝、肾组织充血，脂肪变性，肺中有多量血液，显着紫绀等。成熟核果的毒性较未成熟者大。毒性成分可能是毒性蛋白。"}]},{"ID":"20240613131734-3qdz2rj","Type":"NodeParagraph","Properties":{"id":"20240613131734-3qdz2rj","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鉴别"},{"Type":"NodeText","Data":"理化鉴别 取本品粉末1g，加乙醚5ml，浸泡过夜，滤过。取滤液1ml，置蒸发皿中，挥散后，残渣加0.125%对二甲氨基苯甲醛硫酸（50%V/V）溶液6滴，呈紫红色。（检查三萜类）"}]},{"ID":"20240613131734-bzdswhg","Type":"NodeParagraph","Properties":{"id":"20240613131734-bzdswhg","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炮制"},{"Type":"NodeText","Data":"川楝子：拣去杂质，洗净，烘干，轧碎或劈成两半。炒川楝子：将轧碎去核的川楝肉，用麸皮拌炒至深黄色为度，取出放凉。《雷公炮炙论》：（楝实）采得后晒干，酒拌浸令湿，蒸，待上皮软，剥去皮，取肉去核，勿单用其核，槌碎，用浆水煮一伏时用。如使肉即不使核，使核即不使肉。"}]},{"ID":"20240613131734-veylgwy","Type":"NodeParagraph","Properties":{"id":"20240613131734-veylgwy","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"苦、寒；有小毒"}]},{"ID":"20240613131734-ftl1gzw","Type":"NodeParagraph","Properties":{"id":"20240613131734-ftl1gzw","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"归经"},{"Type":"NodeText","Data":"归肝、小肠、膀胱经"}]},{"ID":"20240613131734-pp40k1n","Type":"NodeParagraph","Properties":{"id":"20240613131734-pp40k1n","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"疏肝泄热；行气止痛；杀虫。主脘腹胁肋疼痛；疝气疼痛；虫积腹痛；头癣"}]},{"ID":"20240613131734-dr67mrf","Type":"NodeParagraph","Properties":{"id":"20240613131734-dr67mrf","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服：煎汤，3-10g；或入丸、散。外用：适量，研末调涂。行气止痛炒用，杀虫生用。"}]},{"ID":"20240613131734-3czbcug","Type":"NodeParagraph","Properties":{"id":"20240613131734-3czbcug","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"脾胃虚寒者忌服。《纲目》：茴香为之使。"}]},{"ID":"20240613131734-7zw8fjq","Type":"NodeParagraph","Properties":{"id":"20240613131734-7zw8fjq","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"各家论述"},{"Type":"NodeText","Data":"1.《纲目》：楝实，导小肠膀胱之热，因引心胞相火下行，故心腹痛及疝气为要药。"}]},{"ID":"20240613131734-xqk51l1","Type":"NodeParagraph","Properties":{"id":"20240613131734-xqk51l1","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：楝实，主温疾伤寒，大热烦狂者，邪在阳明也，苦寒能散阳明之邪热，则诸证自除。膀胱为州都之官，小肠为受盛之官，二经热结，则小便不利，此药味苦气寒，走二经而导热结，则水道利矣。"}]},{"ID":"20240613131734-lnctkm0","Type":"NodeParagraph","Properties":{"id":"20240613131734-lnctkm0","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：川楝，苦寒性降，能导湿热下走渗道，人但知其有治疝之功，而不知其荡热止痛之用。《本经》主温疾烦狂，取以引火毒下泄，而烦乱自除。其杀三虫利水道，总取以苦化热之义。古方金铃子散，治心包火郁作痛，即妇人产后血结心疼，亦宜用之。以金铃子能降火逆，延胡索能散结血，功胜失笑散，而无腥秽伤中之患。昔人以川楝为疝气腹痛、杀虫利水专药，然多有用之不效者。不知川楝所主，乃囊肿茎强木痛湿热之疝，非痛引入腹、厥逆呕涎之寒疝所宜。此言虽迥出前辈，然犹未达至治之奥。夫疝瘕皆由寒束热邪，每多掣引作痛，必需川楝之苦寒，兼茴香之辛热，以解错综之邪，更须察其痛之从下而上引者，随手辄应，设痛之从上而下注者，法当辛温散结，苦寒良非所宜，诸痛皆尔，不独疝瘕为然。"}]},{"ID":"20240613131734-8orozhj","Type":"NodeParagraph","Properties":{"id":"20240613131734-8orozhj","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"4.《本经》：主温疾、伤寒大热烦狂，杀三虫疥疡，利小便水道。"}]},{"ID":"20240613131734-ry2vwk4","Type":"NodeParagraph","Properties":{"id":"20240613131734-ry2vwk4","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"5.《药性论》：主人中大热，狂，失心躁闷，作汤浴。"}]},{"ID":"20240613131734-g8vfivt","Type":"NodeParagraph","Properties":{"id":"20240613131734-g8vfivt","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"6.《珍珠囊》：主上下部腹痛，心暴痛。"}]},{"ID":"20240613131734-snstpr6","Type":"NodeParagraph","Properties":{"id":"20240613131734-snstpr6","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"7.《纲目》：治诸疝、虫、痔。"}]},{"ID":"20240613131734-suey10t","Type":"NodeParagraph","Properties":{"id":"20240613131734-suey10t","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"8.《医林纂要》：泻心火，坚肾水，清肺金，清肝火。核：治疝，去痼冷。"}]},{"ID":"20240613131734-nhnjqzs","Type":"NodeParagraph","Properties":{"id":"20240613131734-nhnjqzs","updated":"20240613131734"},"Children":[{"Type":"NodeText","Data":"9.《本草求原》：治淋病茎痛引胁，遗精，积聚，诸逆冲上，溲下血，头痛，牙宣出血，杀虫。"}]},{"ID":"20240613131734-gspikgc","Type":"NodeParagraph","Properties":{"id":"20240613131734-gspikgc","updated":"20240613131734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《中华本草》"}]},{"ID":"20240613131735-xep8z4y","Type":"NodeThematicBreak","Properties":{"id":"20240613131735-xep8z4y"}},{"ID":"20240613131736-5gat4l9","Type":"NodeParagraph","Properties":{"id":"20240613131736-5gat4l9"}}]}