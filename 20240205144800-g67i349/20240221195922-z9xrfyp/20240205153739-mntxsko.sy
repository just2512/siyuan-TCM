:"吴茱萸 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/吴茱萸 11-20240821090627-ptx36hd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 586px;\" parent-style=\"width: 596px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821092103-psp7yd0","Type":"NodeParagraph","Properties":{"id":"20240821092103-psp7yd0","updated":"20240821093143"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 761px;","style":"width: 751px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"吴茱萸 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/吴茱萸 15-20240821092103-4hegnau.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 751px;\" parent-style=\"width: 761px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"吴茱萸 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/吴茱萸 18-20240821093143-125u7aq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 422px;\" parent-style=\"width: 432px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821085552-bxqkqb6","Type":"NodeParagraph","Properties":{"id":"20240821085552-bxqkqb6","updated":"20240821093123"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 562px;","style":"width: 552px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"吴茱萸 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/吴茱萸 6-20240821090256-bszyfdy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 552px;\" parent-style=\"width: 562px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 630px;","style":"width: 620px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"吴茱萸"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/吴茱萸-20240821085552-4jy9o19.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 620px;\" parent-style=\"width: 630px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821090856-j5cfq8g","Type":"NodeParagraph","Properties":{"id":"20240821090856-j5cfq8g","updated":"20240821090930"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：入药的吴茱萸要在未成熟之前采收，成熟的吴茱萸一般用作调料；"}]},{"ID":"20240612090752-l0iuh4w","Type":"NodeThematicBreak","Properties":{"id":"20240612090752-l0iuh4w"}},{"ID":"20240612090815-aqteirw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090815-aqteirw","updated":"20240612090819"},"Children":[{"Type":"NodeText","Data":"吴茱萸《神农本草经》"}]},{"ID":"20240612090815-rab3dd9","Type":"NodeParagraph","Properties":{"id":"20240612090815-rab3dd9","updated":"20240612090815"},"Children":[{"Type":"NodeText","Data":"（《御览》引：无吴字，是）"}]},{"ID":"20240612090815-87mw7sb","Type":"NodeParagraph","Properties":{"id":"20240612090815-87mw7sb","updated":"20240612090815"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240612090815-pcy727q","Type":"NodeParagraph","Properties":{"id":"20240612090815-pcy727q","updated":"20240612090815"},"Children":[{"Type":"NodeText","Data":"主温中，下气，止痛，咳逆，寒热，除湿血痹，逐风邪，开凑（旧作腠，《御览》作涛，是）理根杀三虫。一名藙。生山谷。"}]},{"ID":"20240612090815-5v7anjf","Type":"NodeParagraph","Properties":{"id":"20240612090815-5v7anjf","updated":"20240612090815"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生冤句，九月九日采，阴干。"}]},{"ID":"20240612090815-0d796qz","Type":"NodeParagraph","Properties":{"id":"20240612090815-0d796qz","updated":"20240612090815"},"Children":[{"Type":"NodeText","Data":"案《说文》云：茱，茱萸，属，萸，茱萸也。煎茱萸，汉律，会稽献藙一斗。"}]},{"ID":"20240612090815-l9guky7","Type":"NodeParagraph","Properties":{"id":"20240612090815-l9guky7","updated":"20240612090815"},"Children":[{"Type":"NodeText","Data":"《广雅》云：（木尻），榝，档，樾，茱萸也。三苍云：莍，茱萸也。（《御览》）《尔雅》云：椒、榝，丑莍.郭璞云：茱萸子，聚生成房貌，今江东亦呼榝，似茱萸而小，赤色。礼记云：三牲用藙。郑云：藙煎茱萸也。汉律会稽献焉，《尔雅》谓之榝.《范子计然》云：茱萸，出三辅。陶宏景云：礼记名藙而作俗中呼为藙子，当是不识藙字似杂字，仍以相传。"}]},{"ID":"20240612091044-wepi96b","Type":"NodeThematicBreak","Properties":{"id":"20240612091044-wepi96b"}},{"ID":"20240612091045-kfwy6zy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091045-kfwy6zy","updated":"20240612091050"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草蒙筌》"}]},{"ID":"20240612091045-p2ychoc","Type":"NodeParagraph","Properties":{"id":"20240612091045-p2ychoc","updated":"20240612091045"},"Children":[{"Type":"NodeText","Data":"味辛、苦，气温、大热。气味俱浓，可升可降，阳中阴也。有小毒。所产吴地独妙，故加吴字为名。重阳采收，依法精制。汤泡苦汁七次，烘干杵碎才煎。畏紫白石英，恶丹参硝石。用蓼实为使，入肺脾肾经。主咽嗌寒气，噎塞不通。散胸膈冷气，窒塞不利。"}]},{"ID":"20240612091045-l61f2cb","Type":"NodeParagraph","Properties":{"id":"20240612091045-l61f2cb","updated":"20240612091045"},"Children":[{"Type":"NodeText","Data":"驱脾胃停寒，脐腹成阵绞痛。逐膀胱受湿，阴囊作疝剜疼。开腠理，解风邪。止呕逆，除霍乱。仍顺折肝木之性，治吞吐酸水如神。厥阴头疼，引经必用。气猛不宜多食，令人目瞪口开。若久服之，亦损元气。"}]},{"ID":"20240612091045-10c0dc0","Type":"NodeParagraph","Properties":{"id":"20240612091045-10c0dc0","updated":"20240612091045"},"Children":[{"Type":"NodeText","Data":"肠虚泄者，尤忌沾唇，为速下气故尔。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"寸白三虫，煎服即出；衔口立通。并择向在东南，取之方获效验。"}]},{"ID":"20240612091057-3nxdm61","Type":"NodeThematicBreak","Properties":{"id":"20240612091057-3nxdm61"}},{"ID":"20240612091058-pzuq94x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091058-pzuq94x","updated":"20240612091103"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草从新》"}]},{"ID":"20240612091058-d8exzeb","Type":"NodeParagraph","Properties":{"id":"20240612091058-d8exzeb","updated":"20240612091058"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣散风寒、燥湿疏肝、下气．"}]},{"ID":"20240612091058-um65bzf","Type":"NodeParagraph","Properties":{"id":"20240612091058-um65bzf","updated":"20240612091058"},"Children":[{"Type":"NodeText","Data":"辛苦大热．有小毒．疏肝燥脾．温中下气．除湿解郁．去痰杀虫．开腠理．逐风寒．治厥阴头痛．阴毒腹痛．（痛在少腹．）呕逆吞酸．（俗名醋心、亦有吐酸者、宜降火清痰、用吴茱作向导、蔡中丞苦痰饮、十日一发、头痛背寒、呕酸不食、得一方名吴仙丹、吴茱汤泡七次、与茯苓等分、蜜丸、服之而愈．）痞满噎膈．食积泻痢．血痹阴疝．奔豚症瘕．痔疾肠风．香港脚水肿．口舌生疮．（为末、醋调、贴足心、过夜便愈、能引热下行．）冲脉为病．气逆里急．（宜此主之．）性虽热而能引热下行．（段成式酉阳杂俎、言椒性善下、吴茱性上、似不尽然、宗 曰∶此物下气甚速、东垣曰∶浊阴不降、厥气上逆、膈塞胀满、非吴茱不可治也．）利大肠壅气．下产后余血．损气动火．昏目发疮．病非寒滞有湿者勿用．即有寒湿者．亦宜酌量少用．开口陈久者良．滚汤泡去苦烈汁．止呕黄连水炒．治疝盐水炒．治血醋炒．恶丹参、硝石．畏紫石英．"}]},{"ID":"20240612091035-9ht4whf","Type":"NodeThematicBreak","Properties":{"id":"20240612091035-9ht4whf"}},{"ID":"20240612091036-dunnyxf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091036-dunnyxf","updated":"20240612091040"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草经解》"}]},{"ID":"20240612091036-qso96dv","Type":"NodeParagraph","Properties":{"id":"20240612091036-qso96dv","updated":"20240612091036"},"Children":[{"Type":"NodeText","Data":"气温．味辛．有小毒．主温中下气．止痛．除湿血痹．逐风邪．开腠理．咳逆寒热．（泡焙用）"}]},{"ID":"20240612091036-ygxegr0","Type":"NodeParagraph","Properties":{"id":"20240612091036-ygxegr0","updated":"20240612091036"},"Children":[{"Type":"NodeText","Data":"吴萸气温．禀天春和之木气．入足厥阴肝经．味辛有小毒．得地西方燥烈之金味．入手太阴肺经．气味俱升．阳也．中者脾也．太阴经也．肺主气．亦太阴也．气温则肺令下行．而太阴亦暖．所以温中下气也．寒邪客于胸腹．则真气不通而痛矣．辛温则流行和散．所以止痛也．辛温暖肺．肺气通行．则水道通调．故又除湿．血泣则成痹．肝藏血．血温则活．故主血痹．辛温为阳．则能发散．故逐风邪．肺主皮毛而司腠理．辛温疏散．腠理自开．形寒饮冷则伤肺．肺伤则气不下降．而火反上逆．咳逆寒热之症生焉．吴萸辛温暖肺．肺气下降．而寒热咳逆之症自平也．"}]},{"ID":"20240612091036-8aldisq","Type":"NodeParagraph","Properties":{"id":"20240612091036-8aldisq","updated":"20240612091036"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612091036-n3bmn4s","Type":"NodeParagraph","Properties":{"id":"20240612091036-n3bmn4s","updated":"20240612091036"},"Children":[{"Type":"NodeText","Data":"吴萸同人参、生姜、大枣．名吴萸汤．治呕涎头痛．同陈皮、附子．治肾气上哕．同川连、白芍丸．治痢．同炮姜末汤服一钱．治食已吞酸．同肉桂、炮姜丸．名和中丸．治寒腹胀．"}]},{"ID":"20240612091023-h7yc2xi","Type":"NodeThematicBreak","Properties":{"id":"20240612091023-h7yc2xi"}},{"ID":"20240612091025-fgf72w2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091025-fgf72w2","updated":"20240612091030"},"Children":[{"Type":"NodeText","Data":"吴茱萸《神农本草经读》"}]},{"ID":"20240612091025-qll7o25","Type":"NodeParagraph","Properties":{"id":"20240612091025-qll7o25","updated":"20240612091025"},"Children":[{"Type":"NodeText","Data":"气味辛、温，有小毒。主温中，下气，止痛，又除湿血痹，逐风邪，开腠理，咳逆，寒热。（泡一次用）陈修园曰∶吴萸气温，禀春气而入肝。味辛有小毒，得金味而入肺。气温能祛寒，而大辛之味，又能俾肺令之独行而无所旁掣；故中寒可温，气逆可下，胸腹诸痛可止；皆肺令下行，坐镇而无余事。仲景取治阳明食谷欲呕症，及干呕吐涎沫症，从《本经》而会悟于言外之旨也。肺喜温而恶寒，一得吴萸之大温大辛，则水道通调而湿去。肝藏血，血寒则滞而成痹，一得吴萸之大辛大温，则血活而痹除。风邪伤人，则腠理闭，而为寒热咳逆诸症，吴萸大辛大温，开而逐之，则咳逆寒热诸证俱平矣。然犹有疑者，仲景用药悉遵《本经》，而“少阴病吐利，手足逆冷，烦燥欲死者，吴茱萸汤主之”二十字，与《本经》不符。而不知少阴之脏，皆本阳明水谷以资生，而复交于中土。若阴阳之气不归中土，则上吐而不利；水火之气不归中土，则下燥而上烦；中土之气内绝，则四肢逆冷而过肘膝，法在不治。仲景取吴茱萸大辛大温之威烈，佐人参之冲和，以安中气，姜、枣之和胃，以行四末；专求阳明，是得绝处逢生之妙。张隐庵、叶天士之解俱浅。"}]},{"ID":"20240612090821-mim969n","Type":"NodeThematicBreak","Properties":{"id":"20240612090821-mim969n"}},{"ID":"20240612091015-yuzocwl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091015-yuzocwl","updated":"20240612091019"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草经集注》"}]},{"ID":"20240612091015-zkax6ff","Type":"NodeParagraph","Properties":{"id":"20240612091015-zkax6ff","updated":"20240612091015"},"Children":[{"Type":"NodeText","Data":"味辛，温、大热，有小毒。主温中下气，止痛，咳逆，寒热，除湿血痹，逐风邪，开腠理。去淡冷，腹内绞痛，诸冷、实不消，中恶，心腹痛，逆气，利五脏。根∶杀三虫。"}]},{"ID":"20240612091015-4lgs2pm","Type":"NodeParagraph","Properties":{"id":"20240612091015-4lgs2pm","updated":"20240612091015"},"Children":[{"Type":"NodeText","Data":"根白皮∶杀蛲虫，治喉痹咳逆，止泄注，食不消，女子经产余血。治白癣。一名 。生上谷川谷及宛朐。九月九日采，阴干。（蓼实为之使，恶丹参、硝石、白垩，畏紫石英。）"}]},{"ID":"20240612091015-64q0u8d","Type":"NodeParagraph","Properties":{"id":"20240612091015-64q0u8d","updated":"20240612091015"},"Children":[{"Type":"NodeText","Data":"此即今食茱萸。《礼记》亦名 ，而世中呼为 子，当是不识 字， 字似 字，仍以相其根南行、东行者为胜。道家去三尸方亦用之。"}]},{"ID":"20240612090612-xes9lkp","Type":"NodeThematicBreak","Properties":{"id":"20240612090612-xes9lkp"}},{"ID":"20240612090759-2d8cvrp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090759-2d8cvrp","updated":"20240612090807"},"Children":[{"Type":"NodeText","Data":"吴茱萸《证类本草》"}]},{"ID":"20240612090759-8oqwfiv","Type":"NodeParagraph","Properties":{"id":"20240612090759-8oqwfiv","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"味辛，温、大热，有小毒。主温中下气，止痛，咳逆寒热，除湿血痹，逐风邪，开腠理，去痰冷，腹内绞痛，诸冷实不消，中恶，心腹痛，逆气，利五脏。"}]},{"ID":"20240612090759-74zpiha","Type":"NodeParagraph","Properties":{"id":"20240612090759-74zpiha","updated":"20240612090759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"杀三虫。根白皮杀蛲虫，治喉痹，咳逆，止泄注，食不消，女子经产余血，疗白癣。一名KT 。生上谷川谷及冤句。九月九日采，阴干。（蓼实为之使，恶丹参、硝石、白垩，畏紫石英。）"}]},{"ID":"20240612090759-t05qhni","Type":"NodeParagraph","Properties":{"id":"20240612090759-t05qhni","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶《礼记》名 ，而俗中呼为KT （音杀）子。当是不识， 字似KT 字，仍以相传。其根南行、东行者为胜。道家去三尸方亦用之。唐本注云∶《尔雅·释木》云∶椒KT丑， 。陆氏《草木疏》云∶椒KT 属亦有KT 名，陶误也。"}]},{"ID":"20240612090759-uvng4bk","Type":"NodeParagraph","Properties":{"id":"20240612090759-uvng4bk","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按药性论吴茱萸，味苦、辛，大热，有毒。能主心腹疾，积冷，心下结气疰，心痛，治霍乱转筋，胃中冷气，吐泻腹痛不可胜忍者可愈，疗遍身 痹，冷食不消，利大肠拥气。削皮能疗漆疮，主中恶，腹中刺痛，下痢不禁，治寸白虫。博雅云∶ KT 越椒，茱萸也。 （音考）孟诜云∶茱萸，主心痛，下气，除呕逆，脏冷。又皮止齿痛。又患风瘙痒痛者。取茱萸一升，清酒五升，和煮，取一升半去滓，以汁暖洗。中贼风口偏不能语者。取茱萸一升，清酒一升，和煮四、五沸。冷服之半升，日三服，得少汗瘥。谨按杀鬼疰气。又开目者不堪食。又鱼骨在人腹中刺痛。煮一盏汁服之止。又骨在肉中不出者，嚼封之，骨当烂出。香港脚冲心，可和生姜汁饮之，甚良。日华子云∶健脾，通关节，治霍乱，泻痢，消痰，破症癖，逐风，治腹痛，肾气，香港脚，水肿，下产后余血。又云茱萸叶，热，无毒。治霍乱，下气，止心腹痛，冷气。内外肾钓痛，盐研 ，神验。干即又浸复 ，霍乱脚筋，和艾以醋汤拌 ，妙也。陈藏器云∶ 子根浓煮浸痔，有验。烧末服亦主痔病。又《尔雅》云∶栎实，也。其子房生为 。又赤爪草一名羊 ，一名鼠查球。此乃名同耳。 似小楂而赤，人食之。生高原。"}]},{"ID":"20240612090759-b5peadx","Type":"NodeParagraph","Properties":{"id":"20240612090759-b5peadx","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"图经曰∶吴茱萸，生上谷川谷及冤句，今处处有之，江浙、蜀汉尤多。木高丈余，皮青绿色。叶似椿而阔浓，紫色。三月开花红紫色。七月、八月结实似椒子，嫩时微黄，至成熟则深紫。九月九日采，阴干。《风土记》曰∶俗尚九月九日谓为上九，茱萸到此日，气烈熟色赤，可折其房以插头，云辟恶气御冬。又《续齐谐记》曰∶汝南桓景，随费长房学。长房谓曰∶九月九日汝家有灾厄，宜令急去家，各作绛囊盛茱萸以系臂上，登高饮菊花酒，此祸可消。景如言，举家登高山，夕还见鸡、犬、牛、羊一时暴死。长房闻之曰∶此代之矣。故世人每至此日，登高饮酒，戴茱萸囊，由此耳。世传茱萸气好上，言其冲膈，不可为服食之药也。"}]},{"ID":"20240612090759-kxs4t7z","Type":"NodeParagraph","Properties":{"id":"20240612090759-kxs4t7z","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"以水五升，煎取三升。每服七合，日三，干呕吐涎沫而头痛者亦主之。又其南行枝，主大小便卒关格不通。取之断度如手第二指中节，含之立下。出姚僧垣方。根亦入药用。《删繁方》疗脾劳热，有白虫在脾中为病，令人好呕者。取东行茱萸根大者一尺，大麻子八升，桔皮二两，凡三物 咀，以酒一斗浸一宿，微火上薄暖之，三下绞去滓。平旦空腹服一升，取尽，虫便下出，或死或半烂，或下黄汁。凡作药法，禁声，勿语道作药，虫便下验。"}]},{"ID":"20240612090759-vh2r788","Type":"NodeParagraph","Properties":{"id":"20240612090759-vh2r788","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，先去叶、核并杂物了，用大盆一口，使盐水洗一百转，自然无涎，晒干，任入丸散中用。修事十两用盐二两，研作末，投东流水四斗中，分作一百度洗，别有大效。"}]},{"ID":"20240612090759-yhvj6ce","Type":"NodeParagraph","Properties":{"id":"20240612090759-yhvj6ce","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"若用醋煮，即先沸醋三十余沸，后入茱萸，特醋尽，晒干。每用十两，使醋一溢为度。食疗∶微温。主痢，止泻，浓肠胃。肥健人不宜多食。圣惠方∶治阴毒伤寒，四肢逆冷，宜熨。茱萸一升，酒和匀湿，绢袋二只盛，蒸令极热，熨脚心，候气通畅，匀暖即停熨，累用验。外台秘要∶集验熨症法∶茱萸三升碎之，以酒和煮熟，布裹熨症上。冷更炒，更番用之。症移走，逐熨之，候消乃止也。又方∶治痈疽发背及发乳房。茱萸一升，捣之，以苦酒和，贴痈上。又方∶阴下湿痒。茱萸一升，水三升，煮三沸去滓，洗，痒瘥。千金方治寸白虫。茱萸根洗去土四两，切，以水、酒各一升，渍一宿。平旦分再服。凡茱萸皆用细根，东北阴者良。"}]},{"ID":"20240612090759-u8m5c74","Type":"NodeParagraph","Properties":{"id":"20240612090759-u8m5c74","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"若稍大如指以上者，皆不任用。又方∶治心腹内外痛。茱萸一升，酒三升，煎取半升。空心顿服之。千金翼∶产后虚羸盗汗时啬啬恶寒。茱萸一鸡子大，以酒三升，渍半日，煮服。又方∶主大人、小儿风疹。茱萸一升，酒五升，煮取一升，帛染拭之。又方∶主头风。沐头∶茱萸二升，水五升，煮取三升，以绵染拭发根，良。肘后方治中风不能语。豉、茱萸各一升，水五升，煮取二升，稍稍服之。又方∶治肠痔、大便常血，下部痒痛如虫咬者。掘地作坑烧令赤，酒沃中捣茱萸二升纳中，乘热板开小孔，以下部榻上，冷乃下，不过三、四度即瘥。"}]},{"ID":"20240612090759-wh4to4i","Type":"NodeParagraph","Properties":{"id":"20240612090759-wh4to4i","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"孙真人备急方赤痢，脐下痛。茱萸一合，黑豆汤吞之效。经验方治脾元气发歇痛不可忍者。"}]},{"ID":"20240612090759-5g8bm17","Type":"NodeParagraph","Properties":{"id":"20240612090759-5g8bm17","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"茱萸一两，桃仁一两，和炒令茱萸焦黑后，去茱萸，取桃仁去皮尖，研细，葱白三茎，煨熟，以酒浸，温分三服。经验后方补水气药。赤茱萸二两，米醋煮烂，细研为膏，丸如梧桐子大，椒汤下七丸，空心服。兵部手集∶治醋心，每醋气上攻如酽醋。茱萸一合，水三盏，煎七分，顿服。纵浓亦须强服，近有人，心如蜇破，服此方后，二十年不发。又方∶治中风腹痛，或子肠脱出。茱萸三升，酒五升，煎取二升，分温三服。又方∶小儿火灼疮。一名瘭浆疮，一名火烂疮。用酒煎茱萸拭上。杨氏产乳∶疗中恶心痛。吴茱萸五合，以酒三升，煮三沸，分三服。"}]},{"ID":"20240612090759-qs0xpth","Type":"NodeParagraph","Properties":{"id":"20240612090759-qs0xpth","updated":"20240612090759"},"Children":[{"Type":"NodeText","Data":"衍义曰∶吴茱萸，须深汤中浸去苦烈汁，凡六、七过，始可用。今文与注及注中药法皆不言，亦漏落也。此物下气最速，肠虚人服之愈甚。"}]},{"ID":"20240612090735-wx8wwue","Type":"NodeThematicBreak","Properties":{"id":"20240612090735-wx8wwue"}},{"ID":"20240612090746-79yh6n5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090746-79yh6n5","updated":"20240612090750"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草备要》"}]},{"ID":"20240612090746-5pf06jl","Type":"NodeParagraph","Properties":{"id":"20240612090746-5pf06jl","updated":"20240612090746"},"Children":[{"Type":"NodeText","Data":"燥，去风寒湿，宣，下气开郁"}]},{"ID":"20240612090746-7wkk0ui","Type":"NodeParagraph","Properties":{"id":"20240612090746-7wkk0ui","updated":"20240612090746"},"Children":[{"Type":"NodeText","Data":"辛苦大热，有小毒。入足太阴（脾）血分，少阴、厥阴（肾、肝）气分（其气燥，故专入肝而旁及脾、肾）。润肝燥脾，温中下气，除湿解郁，去痰杀虫，开腠理，逐风寒。"}]},{"ID":"20240612090746-99d7ixr","Type":"NodeParagraph","Properties":{"id":"20240612090746-99d7ixr","updated":"20240612090746"},"Children":[{"Type":"NodeText","Data":"治厥阴头痛（仲景用吴茱萸汤），阴毒腹痛（痛在小腹），呕逆吞酸（俗名醋心。亦有吐酸者，宜降火清痰，用吴萸作响导。蔡中丞苦痰饮，率十日一发，头痛背寒，呕酸不食。得一方，茯苓、吴萸汤泡七次，等分，蜜丸，名吴仙丹。前、后痰方无此者），痞满噎膈（胃冷）。食积泻痢，血痹阴疝，痔疾肠风，香港脚水肿，口舌生疮（为末，醋调贴足心，过夜便愈，能引热下行），冲脉为病，气逆里急（宜此主之）。性虽热，而能引热下行（段成式言∶椒性善下，吴萸性上，似不尽然。寇宗 曰∶此物下气甚速。东垣曰∶浊阴不降，厥气上逆，膈塞胀满，非吴萸不可治也。昂按∶吴萸辛热，故性上。气味俱浓，故善降），利大肠壅气（故治肠风痔痢），下产后余血（故产后必用之）。然走气动火，昏目发疮，血虚有火者禁用。"}]},{"ID":"20240612090746-28fugu6","Type":"NodeParagraph","Properties":{"id":"20240612090746-28fugu6","updated":"20240612090746"},"Children":[{"Type":"NodeText","Data":"陈者良。泡去苦烈汁用（须泡数次）。止呕，黄连水炒。治疝，盐水炒。治血，醋炒。恶丹参、硝石。"}]},{"ID":"20240612090735-j0w52ea","Type":"NodeThematicBreak","Properties":{"id":"20240612090735-j0w52ea"}},{"ID":"20240612090736-lsudmoa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090736-lsudmoa","updated":"20240612090740"},"Children":[{"Type":"NodeText","Data":"吴茱萸《医学入门》"}]},{"ID":"20240612090736-k3c45wx","Type":"NodeParagraph","Properties":{"id":"20240612090736-k3c45wx","updated":"20240612090736"},"Children":[{"Type":"NodeText","Data":"吴茱萸辛热毒小，治心腹冷痛如绞，疝痹肠风香港脚攻，霍乱咳逆咽膈饱，食萸性同疗水浮，颗粒差大力却少。"}]},{"ID":"20240612090736-4ukv1hp","Type":"NodeParagraph","Properties":{"id":"20240612090736-4ukv1hp","updated":"20240612090736"},"Children":[{"Type":"NodeText","Data":"出吴地。可升可降，阳也。震坤合见，其色青绿，气味俱浓。入足三阴经。疗心腹冷气，冷痰，冷食，癖，心腹绞痛难忍，中恶及鱼骨入腹刺痛，亦效。又下焦寒湿、疝痛、寒气，不可缺也。逐风邪，开腠理，除湿滞血冷，遍身痿痹，腰脚软弱。利大肠壅气，肠风痔疾，杀肠中三虫。香港脚冲心，单用和生姜汁饮之，下气最速。止霍乱转筋，胸满，吞酸吐酸，泻痢。又寒邪所膈，气不得上下，食则口开目瞪，久则寒中胀满者，立效。东垣云∶咽嗌寒气，噎寒而不通，胸中冷气闭塞而不利，一切咳逆寒热或厥冷并验。盖此药性好上冲胸膈，下则开胃浓肠。兼治产后余血。虚羸盗汗，或子肠脱出。凡阳衰虚冷者最宜。但多服亦散元气，肠虚者尤不可单服。凡使，汤浸去苦汁六七遍，然后用盐水或黄连水炒。蓼实为使。恶丹参、硝石、白垩。畏紫石英。"}]},{"ID":"20240612090736-86jdp9l","Type":"NodeParagraph","Properties":{"id":"20240612090736-86jdp9l","updated":"20240612090736"},"Children":[{"Type":"NodeText","Data":"东行根白皮，杀三虫，寸白、蛔虫。治喉痹、咳逆、泄注下痢、食不消、女子经产余血，兼治白癣。南行枝，主大小便卒关格不通，取断如手第二指中节长，含之即下。食茱萸，处处有之，比吴产者颗差大，经久色黄皮黑，辛热，无毒。疗水肿甚佳，功同吴萸，但力少劣耳。多服冲眼脱发，六七月食之，伤气发疮。"}]},{"ID":"20240612091206-3bifnnq","Type":"NodeThematicBreak","Properties":{"id":"20240612091206-3bifnnq"}},{"ID":"20240612091209-6vqoed4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091209-6vqoed4","updated":"20240612091213"},"Children":[{"Type":"NodeText","Data":"吴茱萸《长沙药解》"}]},{"ID":"20240612091209-7otfypq","Type":"NodeParagraph","Properties":{"id":"20240612091209-7otfypq","updated":"20240612091209"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛温。主温中，下气，止痛，咳逆，寒热，除湿血痹，逐风邪，开腠理，根杀三虫。一名藙。生山谷。"}]},{"ID":"20240612091209-j5lmcuq","Type":"NodeParagraph","Properties":{"id":"20240612091209-j5lmcuq","updated":"20240612091209"},"Children":[{"Type":"NodeText","Data":"味辛、苦，性温，入足阳明胃、足太阴脾、足厥阴肝经。温中泻湿，开郁破凝，降浊阴而止呕吐，升清阳而断泄利。"}]},{"ID":"20240612091209-zf6s9hy","Type":"NodeParagraph","Properties":{"id":"20240612091209-zf6s9hy","updated":"20240612091209"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"吴茱萸汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"吴茱萸一升，人参三两，生姜六两，大枣十二枚。"},{"Type":"NodeText","Data":"治阳明伤寒，食谷欲呕者。胃气顺降，则纳而不呕，胃气逆升，则呕而不纳。人参、大枣，培土而补中，吴茱萸、生姜，温胃而降逆也。治厥阴病，干呕，吐涎沫，头痛者。以土虚木郁，中气被贼，胃逆不降，浊气上冲，是以头痛干呕。湿气凝瘀，是以常吐涎沫。人参、大枣，培土而补中，茱萸、生姜，降逆而疏木也。治少阴病，吐利，手足厥冷，烦躁欲死者。以寒水侮土，脾陷胃逆，则吐利兼作。中气亏败，四肢失温，则手足厥冷。坎阳离根，散越无归，则烦躁欲死。人参、大枣，培土而补中，茱萸、生姜，降逆而升陷也。《金匮》治呕而胸满者。以中虚胃逆，浊气冲塞，故呕而胸满。人参、大枣，培土而补中，茱萸、生姜，降逆而泻满也。"}]},{"ID":"20240612091209-qps7ayc","Type":"NodeParagraph","Properties":{"id":"20240612091209-qps7ayc","updated":"20240612091209"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当归四逆加吴茱萸生姜汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"当归、芍药、桂枝、通草各三两，细辛、甘草各二两，大枣十五枚，吴茱萸一升，生姜半斤。水六升，清酒六升，合煮，分三服。"},{"Type":"NodeText","Data":"治厥阴病，手足厥冷，脉细欲绝，内有久寒者。以土主四肢，而手足之温暖，经脉之充畅者，赖厥阴乙木之力。以乙木性温，藏营血而孕君火，灌经络而主肢节也。积寒内瘀，肝血冷涩，不能四运，故肢寒而脉细。当归四逆补营血而通经脉，茱萸、生姜，温寒凝而行阴滞也。"}]},{"ID":"20240612091209-p7lju3g","Type":"NodeParagraph","Properties":{"id":"20240612091209-p7lju3g","updated":"20240612091209"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"温经汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"当归、阿胶、芍药、川芎、桂枝、丹皮、人参、甘草、干姜各二两，半夏、麦冬各一升，吴茱萸三两。水一斗，煮三升，分温三服。亦主妇人少腹寒，久不受胎。兼崩中去血，或月水来过多，或至期不来。"},{"Type":"NodeText","Data":"治妇人带下，下利不止，暮即发热，腹满里急，掌热口干。以曾半产，瘀血在腹，阻隔清阳升达之路，肝脾郁陷，故腹满里急。风木疏泄，故带下泄利。君火上逆，故手掌烦热，唇口干燥。暮而阳气不藏，是以发热。归、阿、芍药，养血而清风，丹、桂、?芎，破瘀而疏木，半夏、麦冬，降逆而润燥，甘草、人参，补中而培土，茱萸、干姜，暖肝而温经也。"}]},{"ID":"20240612091209-ukgvu42","Type":"NodeParagraph","Properties":{"id":"20240612091209-ukgvu42","updated":"20240612091209"},"Children":[{"Type":"NodeText","Data":"吴茱萸辛燥之性，泻湿驱寒，温中行滞，降胃逆而止呕吐，升脾陷而除泄利，泻胸膈痞满，消脚膝肿痛，化寒痰冷饮，去嗳腐吞酸，逐经脉关节一切冷痹，平心腹胸首各种寒痛，熨胁腹诸癥，杀脏腑诸虫，医霍乱转筋，疗疝气痛坠。"}]},{"ID":"20240612091209-mqh8nn5","Type":"NodeParagraph","Properties":{"id":"20240612091209-mqh8nn5","updated":"20240612091209"},"Children":[{"Type":"NodeText","Data":"热水洗数次用。"}]},{"ID":"20240612091304-vl9ep2g","Type":"NodeThematicBreak","Properties":{"id":"20240612091304-vl9ep2g"}},{"ID":"20240612091305-0rafqpl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091305-0rafqpl","updated":"20240612091309"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草衍义》"}]},{"ID":"20240612091305-igd8o3y","Type":"NodeParagraph","Properties":{"id":"20240612091305-igd8o3y","updated":"20240612091305"},"Children":[{"Type":"NodeText","Data":"须深汤中浸去苦烈汁，凡六七过，始可用。今文与注及注中药法皆不言，亦漏落也。此物下气最速，肠虚人服之愈甚。"}]},{"ID":"20240612091314-g9d7mqh","Type":"NodeThematicBreak","Properties":{"id":"20240612091314-g9d7mqh"}},{"ID":"20240612091315-u4dv4sh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091315-u4dv4sh","updated":"20240612091319"},"Children":[{"Type":"NodeText","Data":"吴茱萸《汤液本草》"}]},{"ID":"20240612091315-4s5qw3e","Type":"NodeParagraph","Properties":{"id":"20240612091315-4s5qw3e","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"气热，味辛、苦，气味俱浓，阳中阴也。辛温大热。有小毒。"}]},{"ID":"20240612091315-ir3bnx8","Type":"NodeParagraph","Properties":{"id":"20240612091315-ir3bnx8","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"入足太阴经、少《象》云∶食则令人口开目瞪，寒邪所隔，气不得上下。此病不已，令人寒中，腹满膨胀，下利寒气，诸药不可代也。洗去苦味，日干，杵碎用。"}]},{"ID":"20240612091315-sc3sxng","Type":"NodeParagraph","Properties":{"id":"20240612091315-sc3sxng","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"《心》云∶去胸中逆气。不宜多用，辛热恐损元气。"}]},{"ID":"20240612091315-ehrr1b8","Type":"NodeParagraph","Properties":{"id":"20240612091315-ehrr1b8","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"《珍》云∶温中下气，温胃。"}]},{"ID":"20240612091315-jc6ctwn","Type":"NodeParagraph","Properties":{"id":"20240612091315-jc6ctwn","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主温中下气，止痛，咳逆寒热，除湿、血痹；逐风邪，开腠理，去痰冷，腹内绞痛，诸冷实不消，中恶，心腹痛，逆气；利五脏。入足太阴、少阴、厥阴，震坤合见，其色绿。"}]},{"ID":"20240612091315-fyfhazg","Type":"NodeParagraph","Properties":{"id":"20240612091315-fyfhazg","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"仲景云∶吴茱萸汤，当归四逆汤，大温脾汤，及脾胃药，皆用此也。"}]},{"ID":"20240612091315-33kodq5","Type":"NodeParagraph","Properties":{"id":"20240612091315-33kodq5","updated":"20240612091315"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶此物下气最速，肠虚人服之愈甚。蓼实为之使。恶丹参、硝石、白垩。畏紫石英。"}]},{"ID":"20240612091254-id3mg6p","Type":"NodeThematicBreak","Properties":{"id":"20240612091254-id3mg6p"}},{"ID":"20240612091255-60mcm2z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091255-60mcm2z","updated":"20240612091300"},"Children":[{"Type":"NodeText","Data":"吴茱萸《得配本草》"}]},{"ID":"20240612091255-efz8o0u","Type":"NodeParagraph","Properties":{"id":"20240612091255-efz8o0u","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"蓼实为之使。畏紫石英。恶丹参、硝石、白垩。"}]},{"ID":"20240612091255-ogr8zce","Type":"NodeParagraph","Properties":{"id":"20240612091255-ogr8zce","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"辛、苦、热。有毒。入足厥阴经血分，兼足太阴、少阴经气分。疏肝燥脾，温中下气，开郁化滞。除阴湿，逐风寒。"}]},{"ID":"20240612091255-opnyp5a","Type":"NodeParagraph","Properties":{"id":"20240612091255-opnyp5a","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"治一切厥气上逆，厥阴头痛，呕逆吞酸，痞满咽塞，喉舌生疮，肠风泻痢，香港脚水肿，疝气阴毒，心腹诸痛，虫 疰忤，及产后余血。得硫黄、大蒜，研匀涂腹，治小儿肾缩。（初生受寒所致，仍以蛇床子烧烟熏之。）得茯苓，治痰饮。得盐水，暖膀胱，治脾泄。（他药虽热不能分解清浊。）得干姜，治干呕及吞酸。（因火而酸勿用。）"}]},{"ID":"20240612091255-r9xq14y","Type":"NodeParagraph","Properties":{"id":"20240612091255-r9xq14y","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"配橘皮、附子，治肾气上哕。配川连，治下痢水泄。醋调贴足心，治喉舌生疮。（性虽热而能引热下行。）"}]},{"ID":"20240612091255-z1gzmcr","Type":"NodeParagraph","Properties":{"id":"20240612091255-z1gzmcr","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"陈久者良。闭口者有毒。拣净，并去梗，泡去苦汁，晒干炒用。止呕，以黄连水炒。治疝，盐水炒。治血，醋炒。"}]},{"ID":"20240612091255-m5ebg1s","Type":"NodeParagraph","Properties":{"id":"20240612091255-m5ebg1s","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"散寒，酒炒。生嚼数粒，擦痘疮口噤。多用伤神损元气，动火昏目，发疮咽痛。病非寒滞有湿者勿用。即有寒湿者，亦宜酌量少用。下气最速，阳虚者禁用。"}]},{"ID":"20240612091255-k8degf9","Type":"NodeParagraph","Properties":{"id":"20240612091255-k8degf9","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"怪症∶寒热不止，数日，四肢坚如石，击之似钟磬声，而形体日渐瘦削，此肝气结也。"}]},{"ID":"20240612091255-5c55sxd","Type":"NodeParagraph","Properties":{"id":"20240612091255-5c55sxd","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"合木香等分，疏其肝气自愈。"}]},{"ID":"20240612091255-qpzrsb4","Type":"NodeParagraph","Properties":{"id":"20240612091255-qpzrsb4","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"吴茱萸得东方震气，直入厥阴，招其垂绝不升之阳，以达上焦。仲景于少阴症手足厥冷，烦躁欲死者，用吴茱萸汤重固元阳于厥阴之中，良有以也。王又原曰∶少阴厥阴，俱有烦躁。"}]},{"ID":"20240612091255-licpd4m","Type":"NodeParagraph","Properties":{"id":"20240612091255-licpd4m","updated":"20240612091255"},"Children":[{"Type":"NodeText","Data":"少阴之躁在水，由龙火不归，姜、附得以回阳。厥阴之躁在木，乃雷火上逆，用姜、附则重其震烈矣。吴萸、姜、附，性俱大热，而主治不同。错用之，反伤元气，元阳即旋消散，更何药之可救。"}]},{"ID":"20240612091243-fhn2x0d","Type":"NodeThematicBreak","Properties":{"id":"20240612091243-fhn2x0d"}},{"ID":"20240612091244-ii7156s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091244-ii7156s","updated":"20240612091249"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草求真》"}]},{"ID":"20240612091244-ujg0rcq","Type":"NodeParagraph","Properties":{"id":"20240612091244-ujg0rcq","updated":"20240612091244"},"Children":[{"Type":"NodeText","Data":"（味）逐肝寒气上逆"}]},{"ID":"20240612091244-itr8c9z","Type":"NodeParagraph","Properties":{"id":"20240612091244-itr8c9z","updated":"20240612091244"},"Children":[{"Type":"NodeText","Data":"吴茱萸（专入肝。兼入脾胃肾膀胱）。辛苦燥热。微毒。专入厥阴（肝）气分。除胀。东垣云。浊阴不降。厥气上逆。甚而胀满。非吴茱萸不可治也。多用损人元气。故吞酸吐酸等症俱用。（绣按吞吐酸水。河间丹溪单指属热。景岳专指属寒。斯症寒热俱有。在医于病所见。兼症与脉。及平昔脏气偏纯。审实明辨可耳。不可专祖一家治法。）至如咽喉口舌生疮。以茱萸末醋调。贴两足心。一夜便愈者。以热下行也。兼入脾胃以除胸中寒冷。又脾经血分湿痹。令其表里宣通。而无拒闭之患矣！又兼入肾而治膀胱受湿。阴囊作疝。久滑冷泻。阴寒小腹作疼。暨香港脚水肿。并口舌生疮。除蛊杀虫。（诸症皆作阴寒论。）要皆气味辛燥所致。但走气动火。久服令人目昏发疮。（以温肝经燥血故。）血虚有火者尤忌。陈者良。泡去苦烈汁用。止呕黄连水炒。治疝盐水炒。治血醋炒。恶丹参硝石。"}]},{"ID":"20240612091232-kdp4s5u","Type":"NodeThematicBreak","Properties":{"id":"20240612091232-kdp4s5u"}},{"ID":"20240612091233-k2dk3y5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091233-k2dk3y5","updated":"20240612091237"},"Children":[{"Type":"NodeText","Data":"吴茱萸《冯氏锦囊秘录》"}]},{"ID":"20240612091233-3dryh9z","Type":"NodeParagraph","Properties":{"id":"20240612091233-3dryh9z","updated":"20240612091233"},"Children":[{"Type":"NodeText","Data":"禀火气以生，故味辛、苦，大热，有小毒。入足阳明、太阴、足少阴、厥阴四经。"}]},{"ID":"20240612091233-b9yka80","Type":"NodeParagraph","Properties":{"id":"20240612091233-b9yka80","updated":"20240612091233"},"Children":[{"Type":"NodeText","Data":"一切阴寒并治。"}]},{"ID":"20240612091233-wyu6n5u","Type":"NodeParagraph","Properties":{"id":"20240612091233-wyu6n5u","updated":"20240612091233"},"Children":[{"Type":"NodeText","Data":"吴茱萸，大温，散胸中脾胃寒冷，膀胱受湿，阴囊作疝，久滑冷泻，阴寒小腹作疼，肝经气分，脾经血分，然性燥急，阴虚火盛者，大非所宜。"}]},{"ID":"20240612091233-49z9bjy","Type":"NodeParagraph","Properties":{"id":"20240612091233-49z9bjy","updated":"20240612091233"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 宜择小者去梗，以沸汤浸去苦汁六七次，晒干于瓦上慢火炒用，凡痘饮冷伤胃，呕逆不止者宜之，士材曰∶燥肠胃而止久滑之泻，散阴寒而攻心腹之疼，祛冷胀为独得，疏肝气有偏长，疝疼香港脚相宜，开郁杀虫至效。"}]},{"ID":"20240612091233-rn51dik","Type":"NodeParagraph","Properties":{"id":"20240612091233-rn51dik","updated":"20240612091233"},"Children":[{"Type":"NodeText","Data":"按∶吴茱萸辛散燥热，专入厥阴居多，其脾肾旁及者也。然下气最速，肠虚人服之愈甚。东垣云∶浊阴不降，厥阴上逆，甚而胀满，非茱萸不可治也。多用损元气，至如咽喉口舌生疮，以茱萸末醋调，贴两足心，一夜便愈者，引热下行也。性极燥极急，非大寒者不可轻投，虚泄者必君参术方用，亦须少少投之，不尔损人。段成式曰∶椒气好下，茱气善上，故食茱萸，有冲膈冲眼脱发咽痛动火发疮之害。"}]},{"ID":"20240612091219-ijnh8wq","Type":"NodeThematicBreak","Properties":{"id":"20240612091219-ijnh8wq"}},{"ID":"20240612091220-ro0n5vl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091220-ro0n5vl","updated":"20240612091224"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草崇原》"}]},{"ID":"20240612091220-edwf9xk","Type":"NodeParagraph","Properties":{"id":"20240612091220-edwf9xk","updated":"20240612091220"},"Children":[{"Type":"NodeText","Data":"气味辛温，有小毒。主治温中下气，止痛，除湿血痹，逐风邪，开腠理，咳逆寒热。"}]},{"ID":"20240612091220-kqxgt4m","Type":"NodeParagraph","Properties":{"id":"20240612091220-kqxgt4m","updated":"20240612091220"},"Children":[{"Type":"NodeText","Data":"（吴茱萸所在有之，江浙、蜀汉尤多。木高丈余，叶似椿而阔浓，紫色，三月开红紫细花，七八月结实累累成簇，似椒子而无核，嫩时微黄，熟则深紫，多生吴地，故名吴茱萸。九月九日采，阴干，陈久者良，滚水泡一二次，去其毒瓦斯用之。）"}]},{"ID":"20240612091220-ax13t45","Type":"NodeParagraph","Properties":{"id":"20240612091220-ax13t45","updated":"20240612091220"},"Children":[{"Type":"NodeText","Data":"山茱萸、吴茱萸咸禀木火之气。禀火气，故主温中。禀木气，故主下气。中焦温而逆气下，则痛自止矣。湿血痹者，湿伤肌腠，致充肤热肉之血凝泣为痹。少阳炎热之气，行于肌腠，肝主冲任之血，淡渗皮肤，则湿血痹可除矣。又曰∶逐风邪者，言湿痹可除，而风邪亦可逐也。气味辛温，故开腠理。腠理开，则肺病之咳逆，皮肤之寒热皆治矣。"}]},{"ID":"20240612091154-7cga8v5","Type":"NodeThematicBreak","Properties":{"id":"20240612091154-7cga8v5"}},{"ID":"20240612091155-ek8ek0f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091155-ek8ek0f","updated":"20240612091159"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草思辨录》"}]},{"ID":"20240612091155-7ii7c94","Type":"NodeParagraph","Properties":{"id":"20240612091155-7ii7c94","updated":"20240612091155"},"Children":[{"Type":"NodeText","Data":"吴茱萸树高丈余，皮青绿色，实结梢头，其气燥，故得木气多而用在于肝。叶紫花紫实紫，紫乃水火相乱之色。实熟于秋季，气味苦辛而温，性且烈，是于水火相乱之中，操转旋拨反之权，故能入肝伸阳戢阴而辟寒邪。味辛则升，苦则降；辛能散，苦能坚；亦升亦降，亦散亦坚；故上不至极上，下不至极下，第为辟肝中之寒邪而已。"}]},{"ID":"20240612091155-pav6usk","Type":"NodeParagraph","Properties":{"id":"20240612091155-pav6usk","updated":"20240612091155"},"Children":[{"Type":"NodeText","Data":"呕吐有寒有热，不因少阳干胃，即属厥阴干胃。少阳干胃，则如心烦喜呕与呕而发热皆是；厥阴干胃，则如呕而胸满、与干呕吐涎沫、头痛皆是。仲圣小柴胡汤、吴茱萸汤分主甚明。虽然有呕吐主以吴茱萸汤，而曰阳明病少阴病者，人必谓于厥阴无与矣，而不知实厥阴病之见于阳明少阴也。何以言之？食谷欲呕者，肝受寒邪，上攻其胃。不食谷则肝气犹舒，食谷则肝不能容而欲呕。与胃虚之有胃反迥殊，故非吴茱萸汤不治。夫肝邪上攻则胃病，为木乘土。下迫则肾病，为子传母。迨子传母，则吐利交作而不止一吐矣。少阴自病，下利已耳，未必兼吐；吐而利矣，未必兼逆冷烦躁；吐利而且手足逆冷烦躁欲死，非肝邪盛极而何。"}]},{"ID":"20240612091155-3gq7icm","Type":"NodeParagraph","Properties":{"id":"20240612091155-3gq7icm","updated":"20240612091155"},"Children":[{"Type":"NodeText","Data":"此愚既以吴茱萸为肝药。夫血藏于肝，温肝自当温血；而不知吴茱萸能散血中之气寒，非能温血中之血寒也。厥阴病至于吐利、手足逆冷、烦躁欲死，若是血病，何得无当归。当归四逆汤脉细欲绝，血寒之证也，何以反无吴茱萸，及知有久寒而后加之。即其非胃药肾药亦有可证者，在阳明乃两阳合明，寒不易受，仲圣言胃中虚冷者不一，无用吴茱萸之方。纵云吴茱萸兼治胃寒，夫岂不闻干呕吐涎沫头痛之厥阴病非吴茱萸不治乎。吴茱萸既为肝寒要药，以移治胃寒肝不寒之病，宁能无误。故仲圣恐人误用，又申之曰得汤反剧者属上焦。然则治上焦之药何在？半夏干姜散，正治干呕吐逆吐涎沫之胃寒也。他如甘草泻心汤、黄连汤，中有干姜，亦所以治胃寒。愚于此又悟干姜吴茱萸，与黄连黄芩为对待矣。本经黄连主肠 腹痛，黄芩主肠 不主腹痛。故小柴胡汤腹痛去黄芩，而黄连汤腹痛则用黄连，同一寒药，不能通用如是。岂有同一热药，可漫无区别。愚不以吴茱萸为肾药者，盖亦以别有肾药，与吴茱萸分疆而治者也。温肾者为附子，温脾者为干姜。太阴藏寒曰宜四逆辈，以四逆汤非温脾之正方也，温脾正方为理中丸。理中丸固有干姜无附子，而四逆汤治肾有附子又有干姜，则又何也？盖肾寒必上侮其脾，干姜在脾为中权，在肾为前茅，故姜附不可缺一，吴茱萸岂其比乎。夫肾脏者真阳所寓，有扶阳以抑阴，无辟阴以伤阳。吴茱萸得厕名于少阴者，非能治肾寒也，治肝寒之流及于肾者也。就是数者反复核之，尚何疑吴茱萸之非血药、非胃药、非肾药哉。"}]},{"ID":"20240612091155-fz43x8k","Type":"NodeParagraph","Properties":{"id":"20240612091155-fz43x8k","updated":"20240612091155"},"Children":[{"Type":"NodeText","Data":"温经汤有瘀血在少腹，而以吴茱萸为君，非以其能行瘀也。妇人年五十所而病非新得，宜缓图不宜峻攻。故不用下瘀血汤抵当汤，而以桂枝芍药丹皮三味行瘀。即以三味协参草芎归胶麦姜夏，补中调气，和血濡燥。为之绸缪者，已无微不至矣。更何需苦温辛烈之吴茱萸哉。不知妇人之病，多因虚积冷结气，瘀血在少腹不去，其为有久寒可知。冲任之血，肝实主之。肝中积结之气，非吴茱萸讵能辟去。此实是证之枢纽，曰温经者，纪其实也。"}]},{"ID":"20240612091155-5b3oed6","Type":"NodeParagraph","Properties":{"id":"20240612091155-5b3oed6","updated":"20240612091155"},"Children":[{"Type":"NodeText","Data":"吴茱萸上不至极上，下不至极下。然吴茱萸汤之厥阴头痛，温经汤之瘀血在少腹，何非极上极下，要皆为辟肝寒之效所及，非能径抵头与少腹也。由是推之，吴茱萸之用，亦綦广矣。胃主降，脾主升，脾之所以升，实得风木制化之益，故肝病者脾必病，吴茱萸能入肝驱邪，化阴凝为阳和，脾何能不温，腹痛腹胀何能不治。其性苦过于辛，降多而升少，肝主疏泄，肝平则气自下，此所以又利大肠壅气治滞下也。"}]},{"ID":"20240612091155-wqypero","Type":"NodeParagraph","Properties":{"id":"20240612091155-wqypero","updated":"20240612091155"},"Children":[{"Type":"NodeText","Data":"抑有用之为反佐者，古方左金丸，治肝脏火实左胁作痛，似非吴茱萸热药所宜。顾其方黄连多于吴茱萸五倍，肝实非吴茱萸不泄，连多茱少，则不至助热，且足以解郁滞之热，肝脾两获其益。故腹痛用之，亦每有神验。活法在人，未可为胶柱鼓瑟者道也。"}]},{"ID":"20240612091142-t9fhzdm","Type":"NodeThematicBreak","Properties":{"id":"20240612091142-t9fhzdm"}},{"ID":"20240612091143-st39nj5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091143-st39nj5","updated":"20240612091147"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草新编》"}]},{"ID":"20240612091143-atuowkn","Type":"NodeParagraph","Properties":{"id":"20240612091143-atuowkn","updated":"20240612091143"},"Children":[{"Type":"NodeText","Data":"吴茱萸，味辛、苦，气温，大热，可升可降，阳中阴也，有小毒。入肝、脾、肾之经。"}]},{"ID":"20240612091143-qlbqq3a","Type":"NodeParagraph","Properties":{"id":"20240612091143-qlbqq3a","updated":"20240612091143"},"Children":[{"Type":"NodeText","Data":"主咽塞气不通，散气膈冷气窒塞，驱脾胃停寒，脐腹成阵绞痛，逐膀胱受湿，阴囊作疝剜痛，开腠理，解风邪，止呕逆，除霍乱。因顺折肝木之性，治吞吐酸水如神。厥阴头疼，引经必用。气猛，不宜多食，令人目瞪口开。久服亦损元气，肠虚泄者尤忌。可逆用之以祛寒，复可顺用之以解热。大约祛寒可以多用，而解热难以多投也。"}]},{"ID":"20240612091143-ic5xpcl","Type":"NodeParagraph","Properties":{"id":"20240612091143-ic5xpcl","updated":"20240612091143"},"Children":[{"Type":"NodeText","Data":"按∶吴萸入四神丸中，以治肾泄，非用之以祛寒耶。然而，四神丸中用吴茱萸者，非尽去寒也，亦借其性燥以去湿耳。夫肾恶燥，而泻久则肾正苦湿也。吴茱萸正喜其燥，以投肾之欢，入诸肾脏之逐其水而外走于膀胱，不走于大肠也。"}]},{"ID":"20240612091143-4aiskwb","Type":"NodeParagraph","Properties":{"id":"20240612091143-4aiskwb","updated":"20240612091143"},"Children":[{"Type":"NodeText","Data":"或疑吴茱萸性热祛寒，恐不可用之以解热。不知从治之道，宜顺而不宜逆。逆其性，致有相格之忧；顺其性，始有相投之庆也。"}]},{"ID":"20240612090612-aor3v6u","Type":"NodeThematicBreak","Properties":{"id":"20240612090612-aor3v6u"}},{"ID":"20240612090724-iyzq9mx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090724-iyzq9mx","updated":"20240612090729"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草便读》"}]},{"ID":"20240612090724-wrks06b","Type":"NodeParagraph","Properties":{"id":"20240612090724-wrks06b","updated":"20240612090724"},"Children":[{"Type":"NodeText","Data":"散厥阴之寒．辛苦疏肝降冷浊．燥脾家之湿．芳香治呕愈寒疼．故疝瘕香港脚相宜．而郁结饮邪亦效．吞酸胸满．能导以下行． 癖奔豚．可用其温散．（吴茱萸辛苦而温．芳香而燥．本为肝之主药．而兼入脾胃者．以脾喜香燥．胃喜降下也．其性下气最速．极能宣散郁结．故治肝气郁滞．寒浊下踞．以致腹痛疝瘕等疾．或病邪下行极而上．乃为呕吐吞酸胸满诸病．均可治之．即其辛苦香燥之性．概可想见其功．然则治肝治胃以及中下寒湿滞浊．无不相宜耳．）"}]},{"ID":"20240612091130-j9ta3ni","Type":"NodeThematicBreak","Properties":{"id":"20240612091130-j9ta3ni"}},{"ID":"20240612091133-s1gjeqc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091133-s1gjeqc","updated":"20240612091137"},"Children":[{"Type":"NodeText","Data":"吴茱萸《顾松园医镜》"}]},{"ID":"20240612091133-bkhfp1y","Type":"NodeParagraph","Properties":{"id":"20240612091133-bkhfp1y","updated":"20240612091133"},"Children":[{"Type":"NodeText","Data":"〔辛苦热，有小毒，入脾、胃、肝三经。开口者勿用，盐汤泡透焙干。〕燥肠胃而止久滑之泻，〔故四神丸用以治脾肾虚寒之滑泻。〕故阴寒而治心腹之疼。〔属火热者，不可误投。〕祛冷胀为独得，〔浊阴不降，胸中气逆满塞，宜用此苦热，以泄其逆气，非他药可代。〕疏肝气有偏长，〔独入厥阴有功。〕疝疼香港脚相宜，〔属寒湿者宜之，若因湿热者勿用。〕开郁杀虫至效，〔辛热走散开发，故开郁化滞多功，辛辣故杀虫。〕治吞酸必用，〔湿郁则热，热郁则酸，酸为肝味，故责之肝火。左金丸中，引黄连入肝，而去其湿热，此从治之义。〕祛痰冷如神。〔寒痰冷冻饮饮料停积，以致气逆咳吐，胸膈如有冷物上塞，饮热汤稍下者，用之如神，以其有温中下气之能也。〕凡病非寒滞者大忌。"}]},{"ID":"20240612090856-ia6t4wm","Type":"NodeThematicBreak","Properties":{"id":"20240612090856-ia6t4wm"}},{"ID":"20240612090857-86evq8f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090857-86evq8f","updated":"20240612090925"},"Children":[{"Type":"NodeText","Data":"吴茱萸《本草述钩元》"}]},{"ID":"20240612090857-qi2klgs","Type":"NodeParagraph","Properties":{"id":"20240612090857-qi2klgs","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"一种粒大，一种粒小，小者入药，其色青绿。"}]},{"ID":"20240612090857-8sg25ct","Type":"NodeParagraph","Properties":{"id":"20240612090857-8sg25ct","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"苦辛大热，有小毒。气味俱厚，浮而沉，阳中阴也。入足太阴经血分，少阴厥阴经气分。"}]},{"ID":"20240612090857-c1e3ji8","Type":"NodeParagraph","Properties":{"id":"20240612090857-c1e3ji8","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"吴萸辛散燥热，入厥阴居多，脾肾其旁及也。（士材）"}]},{"ID":"20240612090857-ug4bgvz","Type":"NodeParagraph","Properties":{"id":"20240612090857-ug4bgvz","updated":"20240612090927"},"Children":[{"Type":"NodeText","Data":"诸本草温中下气，润肝燥脾，开郁气。治吞酸，疗痞满塞胸，咽膈不利，去痰冷逆气，饮食不消，胃冷，吐泻腹痛，霍乱转筋。除湿血痹，疗遍身㿏痹刺痛，利五脏，通关节，及大肠壅气，治脚气冲逆，厥阴痰涎头痛，阴毒腹痛，疝气血痢。"}]},{"ID":"20240612090857-sktt12t","Type":"NodeParagraph","Properties":{"id":"20240612090857-sktt12t","updated":"20240612090930"},"Children":[{"Type":"NodeText","Data":"方书治胀满积聚呕吐，鼻证，心痛胃脘痛发热喘齿，水肿痰饮，反胃噎，咳嗽血，着痹谵妄不能食，嘈杂大便不通小便数，痘疹余毒，耳证虫。"}]},{"ID":"20240612090857-ot631rp","Type":"NodeParagraph","Properties":{"id":"20240612090857-ot631rp","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"吴萸禀火气以生，故其味苦辛，其气湿热，气味俱厚，阳也，入足阳明太阴，兼入足少阴厥阴经。（仲淳）按《经》言土木水参居为脾肝肾，皆在膈下，其气脉相近而相和也。缪氏谓入足阳明太阴，兼入足少阴厥阴经，良然。"}]},{"ID":"20240612090857-qv7g64j","Type":"NodeParagraph","Properties":{"id":"20240612090857-qv7g64j","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"浊阴不降，厥气上逆，咽膈不通，甚则令人口开目瞪，阴寒隔塞，气不得上下。此病不已，令人寒中腹满，臌胀下利，宜于吴萸之苦热泄其逆气，用之如神，诸药不可代也。不宜多用，恐损元气。（东垣）"}]},{"ID":"20240612090857-gfef4xo","Type":"NodeParagraph","Properties":{"id":"20240612090857-gfef4xo","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"冲脉为病，逆气里急，宜此主之。（好古）"}]},{"ID":"20240612090857-i3vfxne","Type":"NodeParagraph","Properties":{"id":"20240612090857-i3vfxne","updated":"20240612090932"},"Children":[{"Type":"NodeText","Data":"震坤合见，其色绿，故仲景治厥阴病及温脾胃，皆用此。（又）"}]},{"ID":"20240612090857-ghh5kzz","Type":"NodeParagraph","Properties":{"id":"20240612090857-ghh5kzz","updated":"20240612090934"},"Children":[{"Type":"NodeText","Data":"痰饮十日一发，头疼背寒，呕吐酸汁，即数日伏枕不食，每食饱或阴晴节变率同。吴仙丹：用吴萸汤泡七次，茯苓等分，为末，炼蜜丸梧子大。熟水每服五十丸，不再作。遇饮食过多，腹满，服五七十丸，便已，少顷小便作茱萸气，酒饮皆随小水而去。"}]},{"ID":"20240612090857-1xz2zpf","Type":"NodeParagraph","Properties":{"id":"20240612090857-1xz2zpf","updated":"20240612090937"},"Children":[{"Type":"NodeText","Data":"肾气上哕，自腹中起，上筑于咽喉，逆气连属而不能出，或至数十声，上下不得喘息。此由寒伤胃脘，肾虚气逆，上乘于胃，与气相并，宜服此方。如不止，灸期门、关元、肾俞穴。用吴萸醋炒热，橘皮、附子各一两为末，面糊丸梧子大。每姜汤下七十丸。"}]},{"ID":"20240612090857-w810p2l","Type":"NodeParagraph","Properties":{"id":"20240612090857-w810p2l","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"冷气腹痛，吴萸二钱擂烂，以酒一钟调之，用香油一杯，入锅煎热，倾茱酒入锅煎一滚，取服立止。"}]},{"ID":"20240612090857-n0cq52o","Type":"NodeParagraph","Properties":{"id":"20240612090857-n0cq52o","updated":"20240612090940"},"Children":[{"Type":"NodeText","Data":"脾元气痛，发歇不可忍。用吴萸一两，桃仁一两，和炒茱焦，去茱，取桃仁，去皮尖，研细，葱白三茎煨熟，酒浸温服。"}]},{"ID":"20240612090857-f7v3h8f","Type":"NodeParagraph","Properties":{"id":"20240612090857-f7v3h8f","updated":"20240612090941"},"Children":[{"Type":"NodeText","Data":"脏寒泄泻，倦怠减食。吴萸汤泡过炒，猪脏半条，去脂洗净，装满扎定，文火煮熟，捣丸梧子大。每服五十丸，米饮下，日二服。"}]},{"ID":"20240612090857-5m11k1q","Type":"NodeParagraph","Properties":{"id":"20240612090857-5m11k1q","updated":"20240612090944"},"Children":[{"Type":"NodeText","Data":"多年脾泄，老人多此，谓之水土同化。吴萸三钱泡过，入水煮汁，入盐少许，通口服。盖吴萸能暖膀胱，水道既清，大肠自固，他药虽热，不能分解清浊也。"}]},{"ID":"20240612090857-s5kahne","Type":"NodeParagraph","Properties":{"id":"20240612090857-s5kahne","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"醋心上攻甚，用吴萸一合，水三盏，煎七分服。有人心如蜇破，服此久不发。"}]},{"ID":"20240612090857-l1qr3wf","Type":"NodeParagraph","Properties":{"id":"20240612090857-l1qr3wf","updated":"20240612090946"},"Children":[{"Type":"NodeText","Data":"食已吞酸，胃气虚冷。吴萸汤泡七次焙干，炮姜等分，为末。汤服一钱。此二证正治虚寒而吞酸者也。"}]},{"ID":"20240612090857-3qqqucm","Type":"NodeParagraph","Properties":{"id":"20240612090857-3qqqucm","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"腹中癥块，吴萸三升捣和酒煮，熟布裹熨症上，冷再炒热，更番熨之，癥移走，逐熨之，消乃止，此外治法。"}]},{"ID":"20240612090857-ji54mru","Type":"NodeParagraph","Properties":{"id":"20240612090857-ji54mru","updated":"20240612090949"},"Children":[{"Type":"NodeText","Data":"〔论〕吴萸震坤合见，其色青绿，木皮亦绿，是木为土用者也。三月开花红紫色，本春木之气，酝酿于长夏火土。至秋结实，告成于九月而气乃烈，举春温夏热之气，尽归秋燥之辛以宣之。其味则由苦而辛，辛后复有苦，木昌于火而归于金，即就金而致其火之用，以畅厥阴风木之气。故下泄浊阴，为所必须。夫苦归于辛而火气上宣，辛复纳于苦而火气下达，所以辛热之味多上行，而此能下泄，火金之气最盛，则下行最速也。夫厥阴之所宣者，本于至阴肾，厥阴之达其气以为用地者，用于太阴脾。此味所主，本于厥阴，大都畅水中之覆阳，降土中之滞阴，非寻常下气者比也。"}]},{"ID":"20240612090857-1l3rq0l","Type":"NodeParagraph","Properties":{"id":"20240612090857-1l3rq0l","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"其治要不越于气血，然治气在血之先，所治之证，不越于湿寒热，然寒在湿之先，而热在湿之后，是所谓知其要者，一言而终也。"}]},{"ID":"20240612090857-jt7sccf","Type":"NodeParagraph","Properties":{"id":"20240612090857-jt7sccf","updated":"20240617115457"},"Children":[{"Type":"NodeText","Data":"《本经》首言温中下气，继以除湿血痹。夫气之不下，正海藏所谓痞满塞胸，咽膈不通，由浊阴反居清阳之位，阴不得阳以生化也。温中则气下，所谓温中，即日华子起阳健脾之谓也。阳起而脾健，则阴得阳以化，阳即和阴以行，即是便可除湿，而血不病于痹矣。试摘其主治较多之证以悉之，如甄权云利大肠壅气，即方书胀满，用沉香交泰（此证阴结于上，不能化以下行，故痞满而便燥。方中君大黄以除湿热，而厚朴为臣，其佐之者或健脾，或降气，或行湿而助之渗利，或和血而助化血痹。皆治阴之不降而胸胀，阳之不升而肠燥，以成交泰之功。）及导气（此与交泰丸不同，一降阴气而行湿之义多，一补阳气而通格之义胜。虽同是便秘，但阴降则阳升，阳升而佐以行气，则湿化，阳盛则阴降，阴降而佐以通利，则格消。二者胥用吴萸和他味以奏功。）二丸，以治上胀而下秘也。如海藏云：润肝燥脾。即胀满之用木香顺气汤，以治浊气在上而能下者。（此汤以升柴为君，臣以甘辛大热者消散中寒，辛苦大温者通顺滞气，而调和营卫滋养中气之味次之。）又云两胁刺痛，脉弦而细，正血滞于中土之脾而不能润肝，以致脾患于湿。若血不滞则肝自润，而脾自燥，此即下气而除湿血痹之义也。如濒湖所云吞酸，即方书湿热之治，有吐酸吞酸者，投咽醋丸，用黄连为君，苍芩陈茱为辅也。其湿热滞气甚者，投参茱丸，用六一散为君，吴萸为佐，合服也。至治虚寒之吞酸，有醋心上攻，止用浓醋煎吴萸汤顿服者。有食已吞酸，将吴萸、炮姜等分末服者。盖是证有湿热寒湿之殊，惟此味下气除湿，为其主要如寒湿之治，治其因寒而成湿，湿在寒之后也。湿热之治，治其因湿而化热，热在湿之后也。又此味之治泄泻，亦有湿热寒湿之殊。其因湿化热者，热在湿之后，故用黄连燥之清之，更以此味行中土之滞，俾湿先化而奏功。至于寒湿泄泻，类由于元阳虚，正《经》所谓中气之湿也，必如吴萸之温中下气，乃能偕诸味以回元阳于无何有之乡尔。再如疝证，亦有湿热寒湿之治。其寒类从外受，不专责于元阳之虚也，因寒而阳不得化，阳不化而郁于寒中，是为寒化湿，而湿因化热。故丹溪论治，惟宜于通，或疏散，或分利，或针灸，皆通其由外而受之邪也。第外邪固属病因，实则病于肾中寒水之化不行，致风木郁于所生之中。而小腹及外肾，凡肾肝部分，见于病者不爽，此所云湿热，不止于因寒而化湿，复因湿而化热也。盖有原本于真阳不足，即不能化阴，而阴随化为湿者。（正如酷暑蒸湿，即伤人身之真阳，是不必因寒化湿之的据。况于人身元气，有原禀于不足者乎。）惟用此味导阴以达阳，则湿自化而热自行。又脚气一证，更有寒湿风湿湿热之因，求其本而责之，总归于阴不升而阳不降耳。盖足为三阴所起之地，即为三阳所归之地，三阴有不足，不能上而召阴，则三阳无所归。不能下而和阴，阴下壅而阳上淫，壅者壅于极下之足，故统名脚气也。第泻与疝，多因于阴邪之有余，而脚气还病于真阴之不足，阴不足故阳不归。如吴萸之用，似能下阳气以归阴，即能和阴气以起阳，所谓治其本也。知责其本，则如寒湿风湿湿热之标，随其所胜以投剂，仍归之治本以奏效矣。其次治在积聚，惟吴萸本温中而下气，由气下而除湿血痹，故五积中独肺脾二积倚之。以肺主气，而脾为胃行气于阴阳也。肺积在右胁下，病于气所从出之道，然由气而病于血痹，则肝亦随肺以同病。故息奔汤有桂心与他味等分，可见气不病于血，不能成积也。又如脾积之痞气丸，用白术、砂仁、姜、乌、椒、桂以治虚寒矣。乃更有连芩为诸药之君者，为积块已坚，气郁已久，化湿化热，块日益大。责其本在寒，治其标在湿热，再以厚朴散结，吴萸下壅，茵陈导湿，而合芩泽以渗之。是其不专主清热者，不犹是不以热先湿之义乎。又有龟甲丸治痞气，当胃脘结聚如杯，积久不散者，以鳖甲为君，（用其阴气之专以行湿而化热）大黄为臣，（除湿热）更用附子行湿，木香升降诸气，而吴萸佐之。另有破结散瘀者，总因湿热属血分病，而脾土主湿化，此丸亦犹是治湿为先，不外于下气除血痹之义尔。其次治呕吐证，有丁香吴萸汤以治寒，又有咽醋参萸等丸以治湿热。（湿热甚者用茱为导，上可治吞酸，下可治自利。盖君六一而臣吴萸，正令其不与湿热相拒以致用也。）至于霍乱，则有吴茱萸汤，治冒暑伏热，腹痛作泻，或冒寒忍饥，伤胃吐泻，甚则头旋眼晕，转筋逆冷。其处方只吴萸、木瓜、食盐三味也。又木瓜汤治吐泻转筋扰闷，只木瓜、吴萸、茴香、甘草四味也。更有木瓜散，但以生姜易茴香去甘草而已。数方虽以木瓜为主，而非吴萸不足以助之。其次治心痛脘痛有九痛丸，是因虚寒而疏越其滞气者。又扶阳助胃汤，是驱寒而补其中土之虚者。又草豆蔻丸，是主客寒犯胃，即热亦可用者，此其用吴萸之义易明也。又其次则治痹三方，一肠痹，二脾痹。诸痹因风寒湿邪闭其正气，以故患于不仁。第痹在肠，是六腑受病，其治疏利而兼以补。痹在脾，是五脏受病，其治补益而入以行。如吴萸者，或腑或脏，行气畅血，皆不可少，概不越于下气除湿血痹之义也。以上第摘夫主治较多之证以悉之，而余证可以类推。总之，兹味之用，全取其气。古人于九月九日插佩，岂非以火土之气，至此尽为金用，有如是其烈也欤？化原本于火土，而致用乃畅于三秋之金。洁古、海藏所以谓为阳中阴，惟为阳中之阴，故能分解清浊。《经》云：阴阳如一者死。所谓清浊者即阴阳之二气也，阴阳合而分，分而合，兹物得其元机乃如此，是不惟诸破决剂莫之与同。即诸补益味，亦难齐其运化之功矣，明者其善用之。"}]},{"ID":"20240612090857-z31fsuo","Type":"NodeParagraph","Properties":{"id":"20240612090857-z31fsuo","updated":"20240612090954"},"Children":[{"Type":"NodeText","Data":"缪氏云：阳厥似阴，手足虽逆冷，而口多渴喜饮水，大小便秘结，小便或通亦赤涩短少，此火极似水，当与桂附干姜之类同忌。呕吐吞酸属胃火者，不宜用。咳逆上气，非冷痰宿水所致，不宜用。腹痛属血虚有火者，不宜用。赤白下痢，非酒食生冷停滞积垢者，不宜用。小肠疝气，非骤感寒邪，及初发一二次者，不宜用。霍乱转筋由于脾胃虚弱冒暑所致，而非寒湿生冷干犯肠胃者，不宜用。一切阴虚之证，及五脏六腑有热无寒之人，法所咸忌。"}]},{"ID":"20240612090857-z9mbxhn","Type":"NodeParagraph","Properties":{"id":"20240612090857-z9mbxhn","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"〔修治〕滚汤浸去苦烈汁七次，焙用。"}]},{"ID":"20240612090857-nqvr8jz","Type":"NodeParagraph","Properties":{"id":"20240612090857-nqvr8jz","updated":"20240612090957"},"Children":[{"Type":"NodeText","Data":"●食茱萸　本与吴萸一类二种，但取吴地者入药，名吴萸耳。食萸颗粒差大，一名欓子，经久色黄皮黑。"}]},{"ID":"20240612090857-37v5cvt","Type":"NodeParagraph","Properties":{"id":"20240612090857-37v5cvt","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"气味苦辛，大热，有小毒。"}]},{"ID":"20240612090857-1jwx3tg","Type":"NodeParagraph","Properties":{"id":"20240612090857-1jwx3tg","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"主治同吴萸，功力少劣，去暴冷腹痛食不消，并治冷痢。"}]},{"ID":"20240612090857-6ixkdeg","Type":"NodeParagraph","Properties":{"id":"20240612090857-6ixkdeg","updated":"20240612090857"},"Children":[{"Type":"NodeText","Data":"一女子于秋深病腹中气痛甚，止多服食茱萸茶而愈。"}]},{"ID":"20240612090857-pw4abbh","Type":"NodeParagraph","Properties":{"id":"20240612090857-pw4abbh","updated":"20240612090959"},"Children":[{"Type":"NodeText","Data":"老人真阳虚，遇寒湿司气，风木郁于下而不得畅，至秋冬时，小腹痛绵绵不止。用食茱萸二钱，乌药一钱，酒香附加醋炒一钱，合煎，倍加清酒，煮一时。于大饥时服之，顿愈。"}]},{"ID":"20240612091113-dy1p47p","Type":"NodeThematicBreak","Properties":{"id":"20240612091113-dy1p47p"}},{"ID":"20240612091115-544gj7j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091115-544gj7j","updated":"20240612091121"},"Children":[{"Type":"NodeText","Data":"吴茱萸《中药学》"}]},{"ID":"20240612091115-zdfhgt8","Type":"NodeParagraph","Properties":{"id":"20240612091115-zdfhgt8","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【药用】本品为云香科植物吴茱萸的未成熟果实。"}]},{"ID":"20240612091115-ywjn15i","Type":"NodeParagraph","Properties":{"id":"20240612091115-ywjn15i","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，大热。有小毒。入肝、胃、脾、肾经。"}]},{"ID":"20240612091115-dk92ogz","Type":"NodeParagraph","Properties":{"id":"20240612091115-dk92ogz","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【功效】温中止痛，降逆止呕，杀虫。"}]},{"ID":"20240612091115-dson5pi","Type":"NodeParagraph","Properties":{"id":"20240612091115-dson5pi","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于脘腹冷痛，痛，疝痛，脚气疼痛，以及经行腹痛等症。"}]},{"ID":"20240612091115-dwi719o","Type":"NodeParagraph","Properties":{"id":"20240612091115-dwi719o","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"吴茱萸温散开郁、疏肝暖脾，善解厥阴肝经的郁滞，而有行气止痛的良效。其治胃腹冷痛，可配温中散寒的淡干姜或行气止痛的广木香；治寒疝少腹痛，可配理气止痛的台乌药、小茴香及川楝子；治脚气疼痛，可配舒肝活络的木瓜。由于本品祛寒、止痛之功甚佳，故在临床上又常配合桂枝、当归、川芎等品，治妇女少腹冷痛、经行后期。还可配伍补骨脂、肉豆蔻、五味子，治脾肾虚寒、腹痛泄泻。"}]},{"ID":"20240612091115-n95qsne","Type":"NodeParagraph","Properties":{"id":"20240612091115-n95qsne","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"2.用于肝胃不和、呕吐涎沫等症。"}]},{"ID":"20240612091115-3a3zaoz","Type":"NodeParagraph","Properties":{"id":"20240612091115-3a3zaoz","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"本品能疏肝理气，又有降逆止呕之功，故可用治肝胃不和而致呕吐涎沫，可配生姜、黄连等同用。"}]},{"ID":"20240612091115-aljjfav","Type":"NodeParagraph","Properties":{"id":"20240612091115-aljjfav","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"此外，根据近人经验，治蛲虫病，可用淡吴萸三钱，加水煎取汁，第一天晚上服头汁，第二天晚上服二汁，连服三至五剂。"}]},{"ID":"20240612091115-fqyd5x3","Type":"NodeParagraph","Properties":{"id":"20240612091115-fqyd5x3","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【处方用名】吴萸、淡吴萸（每斤吴茱萸用甘草一两煎汁浸泡，泡至吴茱萸开裂为度，晒干用。辛烈之性稍减。）"}]},{"ID":"20240612091115-0x49glj","Type":"NodeParagraph","Properties":{"id":"20240612091115-0x49glj","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】五分至一钱五分，煎服。"}]},{"ID":"20240612091115-om2esc1","Type":"NodeParagraph","Properties":{"id":"20240612091115-om2esc1","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【按语】1.吴茱萸辛苦大热，不但能温中散寒、降逆止呕，且能疏肝解郁、行气止痛。根据临床体会，以止痛与止呕两种功效为最佳。凡肝气郁滞所致的痛、头痛，肝胃失调所致的胃痛、呕吐，吴萸是常用的药品。"}]},{"ID":"20240612091115-4rbqhyw","Type":"NodeParagraph","Properties":{"id":"20240612091115-4rbqhyw","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"2.吴萸是厥阴肝经的主药，其性虽属大热，但在肝气郁滞的情况下，如有热象，亦可配合寒凉药同用，如左金丸，即以本品辅助黄连，治肝火痛、呕吐吞酸；又如戊己丸，用本品配伍黄连、白芍，治下痢腹痛。"}]},{"ID":"20240612091115-ka2frkc","Type":"NodeParagraph","Properties":{"id":"20240612091115-ka2frkc","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"3.本品温中散寒的功效，与干姜相似，故寒郁中焦，脘腹冷痛，吴萸、干姜，每常同用。但干姜尚能温上焦，可温肺化饮；吴萸还能温下焦，暖厥阴以治寒疝，助肾阳而治寒泻，这是两药功用不同之点。"}]},{"ID":"20240612091115-rm8khd9","Type":"NodeParagraph","Properties":{"id":"20240612091115-rm8khd9","updated":"20240612091115"},"Children":[{"Type":"NodeText","Data":"【方剂举例】吴茱萸汤《伤寒论》：吴茱萸、人参、大枣、生姜。治呕而腹满，或干呕吐涎沫，头痛脘痛，吞酸嘈杂，吞不红，无热象者。"}]},{"ID":"20240612090536-pdxhl1w","Type":"NodeThematicBreak","Properties":{"id":"20240612090536-pdxhl1w"}},{"ID":"20240612090546-q01qdwi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090546-q01qdwi","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"《中国药典》：吴茱萸"}]},{"ID":"20240612090546-4zpst7g","Type":"NodeParagraph","Properties":{"id":"20240612090546-4zpst7g","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612090546-wh2ivmo","Type":"NodeParagraph","Properties":{"id":"20240612090546-wh2ivmo","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" Wú Zhū Yú"}]},{"ID":"20240612090546-a6v226f","Type":"NodeParagraph","Properties":{"id":"20240612090546-a6v226f","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612090546-tv2cf02","Type":"NodeParagraph","Properties":{"id":"20240612090546-tv2cf02","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 吴萸、茶辣、辣子、臭辣子、吴椒、臭泡子"}]},{"ID":"20240612090546-nx0bhwm","Type":"NodeParagraph","Properties":{"id":"20240612090546-nx0bhwm","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612090546-prcvlom","Type":"NodeParagraph","Properties":{"id":"20240612090546-prcvlom","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" FRUCTUS EVODIAE"}]},{"ID":"20240612090546-e6qb1g7","Type":"NodeParagraph","Properties":{"id":"20240612090546-e6qb1g7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612090546-cvsxivu","Type":"NodeParagraph","Properties":{"id":"20240612090546-cvsxivu","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 本品为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"吴茱萸"},{"Type":"NodeText","Data":"Evodia rutaecarpa（Juss.）Benth.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石虎"},{"Type":"NodeText","Data":"Evodia rutaecarpa（Juss.）Benth. var. officinalis （Dode）Huang 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"疏毛吴茱萸"},{"Type":"NodeText","Data":"Evodia rutaecarpa （Juss.）Benth. var. bodinieri （Dode）Huang的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"近成熟果实"},{"Type":"NodeText","Data":"。8～11月果实尚未开裂时，剪下果枝，晒干或低温干燥，除去枝、叶、果梗等杂质。"}]},{"ID":"20240612090546-lt7u8pm","Type":"NodeParagraph","Properties":{"id":"20240612090546-lt7u8pm","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612090546-dlqr7ha","Type":"NodeParagraph","Properties":{"id":"20240612090546-dlqr7ha","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 本品呈球形或略呈五角状扁球形，直径2～5mm。表面暗黄绿色至褐色，粗糙，有多数点状突起或凹下的油点。顶端有五角星状的裂隙，基部残留被有黄色茸毛的果梗。质硬而脆，横切面可见子房5室，每室有淡黄色种子1粒。气芳香浓郁，味辛辣而苦。"}]},{"ID":"20240612090546-e7npqmi","Type":"NodeParagraph","Properties":{"id":"20240612090546-e7npqmi","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612090546-1fn8ekv","Type":"NodeParagraph","Properties":{"id":"20240612090546-1fn8ekv","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240612090546-hbhrjvr","Type":"NodeParagraph","Properties":{"id":"20240612090546-hbhrjvr","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612090546-gli7s93","Type":"NodeParagraph","Properties":{"id":"20240612090546-gli7s93","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"吴茱萸"},{"Type":"NodeText","Data":"：除去杂质。"}]},{"ID":"20240612090546-grpxu1f","Type":"NodeParagraph","Properties":{"id":"20240612090546-grpxu1f","updated":"20240612090546"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"制吴茱萸"},{"Type":"NodeText","Data":"：取甘草捣碎，加适量水，煎汤，去渣，加入净吴茱萸，闷润吸尽后，炒至微干，取出，晒干。每100kg吴茱萸，用甘草6kg 。"}]},{"ID":"20240612090546-s3czegl","Type":"NodeParagraph","Properties":{"id":"20240612090546-s3czegl","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612090546-2wc96c0","Type":"NodeParagraph","Properties":{"id":"20240612090546-2wc96c0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末褐色。非腺毛 2～6 细胞，长 140～350 μm，壁疣明显，有的胞腔内含棕黄色至棕红色物。腺毛头部 7～14细胞，椭圆形，常含黄棕色内含物；柄 2～5 细胞。草酸钙簇晶较多，直径10～25μm；偶有方晶。石细胞类圆形或长方形，直径35～70μm，胞腔大。油室碎片有时可见，淡黄色。"}]},{"ID":"20240612090546-ba3w30h","Type":"NodeParagraph","Properties":{"id":"20240612090546-ba3w30h","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.5g，加盐酸溶液（1→100）10ml，用力振摇数分钟，滤过。取滤液2ml ，加碘化汞钾试液 1滴，振摇后，生成黄白色沉淀；另取滤液 1ml，缓缓加入对二甲氨基苯甲醛试液 2ml，置水浴上加热，两液接界处生成红褐色环。"}]},{"ID":"20240612090546-l6ra1ds","Type":"NodeParagraph","Properties":{"id":"20240612090546-l6ra1ds","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240612090546-14r8ha8","Type":"NodeParagraph","Properties":{"id":"20240612090546-14r8ha8","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240612090546-jiou6z2","Type":"NodeParagraph","Properties":{"id":"20240612090546-jiou6z2","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；乙腈-水-四氢呋喃-乙酸（51：48：1：0.1）为流动相；检测波长为225nm。理论板数按吴茱萸胺峰计算应不低于7000。"}]},{"ID":"20240612090546-piwlfs5","Type":"NodeParagraph","Properties":{"id":"20240612090546-piwlfs5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取吴茱萸胺、吴茱萸次碱对照品适量，加甲醇分别制成每1ml各含0.1mg的溶液，即得。"}]},{"ID":"20240612090546-c179jop","Type":"NodeParagraph","Properties":{"id":"20240612090546-c179jop","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品粉末（过三号筛）约0.13g，精密称定，加入甲醇80ml,加热回流50分钟，放冷，滤过，滤液回收甲醇至适量，转移至10ml量瓶中，加甲醇至刻度，摇匀，即得。"}]},{"ID":"20240612090546-w9sys1u","Type":"NodeParagraph","Properties":{"id":"20240612090546-w9sys1u","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取上述两种对照品溶液与供试品溶液各5μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240612090546-t0wmmy4","Type":"NodeParagraph","Properties":{"id":"20240612090546-t0wmmy4","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"本品含吴茱萸胺（C19H17N3O）和吴茱萸次碱（C18H13N3O）的总量不得少于0.20％。"}]},{"ID":"20240612090546-fa0gexw","Type":"NodeParagraph","Properties":{"id":"20240612090546-fa0gexw","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612090546-px4dj1p","Type":"NodeParagraph","Properties":{"id":"20240612090546-px4dj1p","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 归肝、脾、胃、肾经。"}]},{"ID":"20240612090546-lepskkb","Type":"NodeParagraph","Properties":{"id":"20240612090546-lepskkb","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612090546-1anzdji","Type":"NodeParagraph","Properties":{"id":"20240612090546-1anzdji","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 辛、苦，热；有小毒。"}]},{"ID":"20240612090546-t7amg6m","Type":"NodeParagraph","Properties":{"id":"20240612090546-t7amg6m","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612090546-qvyesu5","Type":"NodeParagraph","Properties":{"id":"20240612090546-qvyesu5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 散寒止痛，降逆止呕，助阳止泻。用于厥阴头痛，寒疝腹痛，寒湿脚气，经行腹痛，脘腹胀痛，呕吐吞酸，五更泄泻，外治口疮；高血压。"}]},{"ID":"20240612090546-6llgtfa","Type":"NodeParagraph","Properties":{"id":"20240612090546-6llgtfa","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612090546-egr8d1d","Type":"NodeParagraph","Properties":{"id":"20240612090546-egr8d1d","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 1.5～4.5g；外用适量。"}]},{"ID":"20240612090546-lsg1hwr","Type":"NodeParagraph","Properties":{"id":"20240612090546-lsg1hwr","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612090546-c3soum7","Type":"NodeParagraph","Properties":{"id":"20240612090546-c3soum7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612090546-zsza9my","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090546-zsza9my","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：吴茱萸"}]},{"ID":"20240612090546-50iv4tl","Type":"NodeParagraph","Properties":{"id":"20240612090546-50iv4tl","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612090546-iis172r","Type":"NodeParagraph","Properties":{"id":"20240612090546-iis172r","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" Wú Zhū Yú"}]},{"ID":"20240612090546-20bpzs6","Type":"NodeParagraph","Properties":{"id":"20240612090546-20bpzs6","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612090546-yv90bnl","Type":"NodeParagraph","Properties":{"id":"20240612090546-yv90bnl","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 吴萸（《草木便方》），左力（《南宁市蓟物志》）。"}]},{"ID":"20240612090546-8xlk6uu","Type":"NodeParagraph","Properties":{"id":"20240612090546-8xlk6uu","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612090546-8sdpnes","Type":"NodeParagraph","Properties":{"id":"20240612090546-8sdpnes","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612090546-dtadf7c","Type":"NodeParagraph","Properties":{"id":"20240612090546-dtadf7c","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612090546-14syag2","Type":"NodeParagraph","Properties":{"id":"20240612090546-14syag2","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"吴茱萸"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未成熟果实"},{"Type":"NodeText","Data":"。8～10月，果实呈茶绿色而心皮尚未分离时采收。摘下晒干，除去杂质。如遇阴雨，用微火炕干。"}]},{"ID":"20240612090546-4arrhqn","Type":"NodeParagraph","Properties":{"id":"20240612090546-4arrhqn","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"除上述品种外，尚有同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石虎"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"毛脉吴茱萸"},{"Type":"NodeText","Data":"等的未成熟果实，亦同等使用。"}]},{"ID":"20240612090546-cca3d2s","Type":"NodeParagraph","Properties":{"id":"20240612090546-cca3d2s","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612090546-8q8jk46","Type":"NodeParagraph","Properties":{"id":"20240612090546-8q8jk46","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 野生于山地、路旁或疏林下。分布于长扛流域及华南一带和陕西等地。主产贵州、广西、湖南、云南、陕西、浙江、四川等地。"}]},{"ID":"20240612090546-wozles5","Type":"NodeParagraph","Properties":{"id":"20240612090546-wozles5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612090546-7kvso5p","Type":"NodeParagraph","Properties":{"id":"20240612090546-7kvso5p","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 吴茱萸，又名：辣子、臭辣子树、气辣子、曲药子、茶辣。"}]},{"ID":"20240612090546-zuq4tje","Type":"NodeParagraph","Properties":{"id":"20240612090546-zuq4tje","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"常绿灌木或小乔木，高2.5～5米。幼枝、叶轴、小叶柄均密被黄褐色长柔毛。单数羽状复叶，对生；小叶2～4对，椭圆形至卵形，长5～15厘米，宽2.5～6厘米，先端短尖，急尖，少有渐尖，基部楔形至圆形，全缘，罕有不明显的圆锯齿，两面均密被淡黄色长柔毛，厚纸质或纸质，有油点。花单性，雌雄异株，聚伞花序，偶成圆锥状，顶生；花轴基部有苞片2枚，上部的苞片鳞片状；花小，黄白色.萼片5，广卵形，外侧密披淡黄色短柔毛；花瓣5，长圆形，内侧密被白色长柔毛；雄花有雄蕊5枚，长于花瓣，花药基着，椭圆形，花丝被毛，退化子房略成三棱形，被毛，先端4～5裂；雌花较大，具退化雄蕊5枚，鳞片状，子房上位，圆球形，心皮通常5枚，花柱粗短，柱头头状，蒴果扁球形，长约3毫米，直径约6毫米，熟时紫红色，表面有腺点，每心皮有种子1枚，卵圆形，黑色，有光泽。花期6～8月。果期9～10月。"}]},{"ID":"20240612090546-5cgfltg","Type":"NodeParagraph","Properties":{"id":"20240612090546-5cgfltg","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"本植物的根（吴茱萸根）、叶（吴茱萸叶）亦供药用，各详专条。"}]},{"ID":"20240612090546-szf2xrc","Type":"NodeParagraph","Properties":{"id":"20240612090546-szf2xrc","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612090546-yig8lqj","Type":"NodeParagraph","Properties":{"id":"20240612090546-yig8lqj","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 干燥果实呈五棱状扁球形，直径2～5毫米，高约1.5～3毫米。表面绿色或绿褐色，粗糙，有细皱纹及鬃眼（油室）；顶平，中间有凹窝及5条裂缝，有时在裂缝中央有突起的柱头残存，基部有花萼及果柄，果柄方圆形，长3毫米，棕绿色，密布毛茸。横切面，子房5室，每室有淡黄色种子1～2枚。种子富油性，质坚易碎。香气浓烈，味苦微辛辣。以色绿、饱满者为佳。"}]},{"ID":"20240612090546-2beq5gi","Type":"NodeParagraph","Properties":{"id":"20240612090546-2beq5gi","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612090546-qznspo0","Type":"NodeParagraph","Properties":{"id":"20240612090546-qznspo0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 吴茱萸果实含挥发油为吴茱萸烯、罗勒烯、吴茱萸内酯、吴茱萸内酯醇等。还含吴茱萸酸。又含生物碱：吴茱萸碱、吴茱萸次碱、吴茱萸因碱、羟基吴茱萸碱、吴茱萸卡品碱。吴茱萸碱用盐酸乙醇处理即转化为异吴茱萸碱。还含两种中性不含氮物质：吴茱萸啶酮和吴茱萸精。又含吴茱萸苦素。"}]},{"ID":"20240612090546-yyexz6b","Type":"NodeParagraph","Properties":{"id":"20240612090546-yyexz6b","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"石虎果实含吴茱萸内酯、吴茱萸碱、吴茱萸次碱、羟基吴茱萸碱。尚含不饱和的酮，暂称石虎甲素、挥发油、花色甙和甾体化合物。"}]},{"ID":"20240612090546-oalh83i","Type":"NodeParagraph","Properties":{"id":"20240612090546-oalh83i","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612090546-d6f66yc","Type":"NodeParagraph","Properties":{"id":"20240612090546-d6f66yc","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" ①驱蛔作用"}]},{"ID":"20240612090546-181itd9","Type":"NodeParagraph","Properties":{"id":"20240612090546-181itd9","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"吴茱萸醇提物在体外对猪蛔虫有较显著作用；对蚯蚓、水蛭亦有效。"}]},{"ID":"20240612090546-zy9nkxo","Type":"NodeParagraph","Properties":{"id":"20240612090546-zy9nkxo","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②抗菌作用"}]},{"ID":"20240612090546-tcvzpbk","Type":"NodeParagraph","Properties":{"id":"20240612090546-tcvzpbk","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"吴茱萸煎剂（100％）对霍乱弧菌有较强抑制效力（琼脂挖沟平板法）。10％水浸剂在试管内对絮状表皮癣菌有抑制作用；1：3水浸剂对奥杜盎氏小芽胞癣菌等11种皮肤真菌有不同程度的抑制。"}]},{"ID":"20240612090546-99ajzto","Type":"NodeParagraph","Properties":{"id":"20240612090546-99ajzto","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"③中枢作用"}]},{"ID":"20240612090546-ndm7w6n","Type":"NodeParagraph","Properties":{"id":"20240612090546-ndm7w6n","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"大量吴茱萸对中枢有兴奋作用，并可引起视力障碍、错觉等。日本产吴茱萸醇提物有镇痛作用，用兔齿髓电刺激法证明，10％醇提物静脉注射0.1～0.5毫升／公斤有镇痛作用。静注0.2毫升，镇痛效力和安替匹林或氨基比林（各用1％2毫升）大致相等。而在寒冷时，比此二药为强。0.1％异吴茱萸碱盐酸盐0.1～0.5毫升／公斤，对家兔亦有镇痛作用；1～2毫升／公斤可使兔体温轻度升高。单用10％吴茱萸属植物醇提物0.5～2.0毫升，也能使兔体温上升。从另一种吴茱萸属植物Evodia xanthoxyloides F.Muell提出生物碱，其盐酸盐对小鼠有镇静催眠作用，但可使大鼠体温下降，还能对抗樟脑等对大鼠或小鼠所致的惊厥作用。"}]},{"ID":"20240612090546-xzttu4j","Type":"NodeParagraph","Properties":{"id":"20240612090546-xzttu4j","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240612090546-oioleb2","Type":"NodeParagraph","Properties":{"id":"20240612090546-oioleb2","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"吴茱萸属植物10％醇提物，给兔注射0.5～1.0毫升，血压有短暂而轻微的升高，呼吸轻度兴奋，增加颈动脉血流量。0.1％异吴茱萸碱盐酸盐0.2～0.5毫升／公斤静注，兔血压无显著变化，呼吸略增大；用0.02～0.1％对离体蛙心作用不明显，蛙下肢血管灌流，一般也不明显，先有扩张后收缩；对离体兔肠，初有短暂兴奋，后麻痹；对离体兔子宫，开始有兴奋作用。Evoxine毒性低，对小鼠的半数致死量，皮下注射为705毫克／公斤，静脉注射为135毫克／公斤。吴茱萸的成分，如吴茱萸内酯、吴茱萸碱、吴茱萸次碱、异吴茱萸碱有相似的镇痛、升高体温、轻度影响呼吸与血压的作用。吴茱萸次碱的分解产物芸香碱有较强的子宫收缩作用。吴茱萸因碱在小鼠有抗ColumbiaSK病毒作用。"}]},{"ID":"20240612090546-0hmw4r9","Type":"NodeParagraph","Properties":{"id":"20240612090546-0hmw4r9","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"从E.xanthoxyJoides中所得之生物碱，与茵芋碱相似，能增强肾上腺素的作用，提高脊髓反射的兴奋性，松弛小肠平滑肌，提高横纹肌张力，在若干方面与麻黄碱之作用相似。"}]},{"ID":"20240612090546-mbjd4wv","Type":"NodeParagraph","Properties":{"id":"20240612090546-mbjd4wv","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612090546-8ia1ff4","Type":"NodeParagraph","Properties":{"id":"20240612090546-8ia1ff4","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 炙吴茱萸：取甘草煎汤，去渣取汤，加入净吴茱萸，浸泡至汤液吸干为度，微火焙干。（每吴茱萸100斤，用甘草6斤4两）"}]},{"ID":"20240612090546-ep7xfde","Type":"NodeParagraph","Properties":{"id":"20240612090546-ep7xfde","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"①《本草通玄》：\"吴茱萸，咸汤浸去烈汁，焙干水。\""}]},{"ID":"20240612090546-9jx5w9k","Type":"NodeParagraph","Properties":{"id":"20240612090546-9jx5w9k","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"吴茱萸陈者良，泡去苦烈汁用。止呕黄连水炒，治疝盐水炒，治血醋炒。\""}]},{"ID":"20240612090546-q6cxl6z","Type":"NodeParagraph","Properties":{"id":"20240612090546-q6cxl6z","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612090546-kpazn9t","Type":"NodeParagraph","Properties":{"id":"20240612090546-kpazn9t","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 入肝、胃经。"}]},{"ID":"20240612090546-e99dbq1","Type":"NodeParagraph","Properties":{"id":"20240612090546-e99dbq1","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足太阴、少阴、厥阴经。\""}]},{"ID":"20240612090546-ipaw9mx","Type":"NodeParagraph","Properties":{"id":"20240612090546-ipaw9mx","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肝、脾、胃、大肠、肾经。\""}]},{"ID":"20240612090546-fp52661","Type":"NodeParagraph","Properties":{"id":"20240612090546-fp52661","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612090546-9jysrzb","Type":"NodeParagraph","Properties":{"id":"20240612090546-9jysrzb","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 辛苦，温，有毒。"}]},{"ID":"20240612090546-5r958um","Type":"NodeParagraph","Properties":{"id":"20240612090546-5r958um","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240612090546-2pax9ct","Type":"NodeParagraph","Properties":{"id":"20240612090546-2pax9ct","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"大热，有小毒。\""}]},{"ID":"20240612090546-jnhaq1p","Type":"NodeParagraph","Properties":{"id":"20240612090546-jnhaq1p","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦辛，大热，有毒。\""}]},{"ID":"20240612090546-0z98vh0","Type":"NodeParagraph","Properties":{"id":"20240612090546-0z98vh0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612090546-extt8a4","Type":"NodeParagraph","Properties":{"id":"20240612090546-extt8a4","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 阴虚火旺者忌服。"}]},{"ID":"20240612090546-jl9idn0","Type":"NodeParagraph","Properties":{"id":"20240612090546-jl9idn0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"蓼实为之使。恶丹参、消石、白垩，畏紫石英。\""}]},{"ID":"20240612090546-y7w7243","Type":"NodeParagraph","Properties":{"id":"20240612090546-y7w7243","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"肠虚泄者尤忌。\""}]},{"ID":"20240612090546-ltcer9c","Type":"NodeParagraph","Properties":{"id":"20240612090546-ltcer9c","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"走气，动火，昏目，发疮。\""}]},{"ID":"20240612090546-h6qitmm","Type":"NodeParagraph","Properties":{"id":"20240612090546-h6qitmm","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"呕吐吞酸属胃火者不宜用；咳逆上气，非风寒外邪及冷痰宿水所致者不宜用；腹痛属血虚有火者不宜用；赤白下痢，因暑邪入于肠胃，而非酒食生冷、停滞积垢者不宜用；小肠疝气，非骤感寒邪及初发一、二次者不宜用；霍乱转筋，由于脾胃虚弱冒暑所致，而非寒湿生冷于犯肠胃者不宜用；一切阴虚之证及五脏六腑有热无寒之人，法所咸忌。\""}]},{"ID":"20240612090546-q2djvlc","Type":"NodeParagraph","Properties":{"id":"20240612090546-q2djvlc","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612090546-nljn22u","Type":"NodeParagraph","Properties":{"id":"20240612090546-nljn22u","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 温中，止痛，理气，燥湿，治呕逆吞酸，厥阴头痛，脏寒吐泻，脘腹胀痛，经行腹痛，五更泄泻，高血压症，脚气，疝气，口疮溃疡，齿痛，湿疹，黄水疮。"}]},{"ID":"20240612090546-nivqa8x","Type":"NodeParagraph","Properties":{"id":"20240612090546-nivqa8x","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主温中下气，止痛，咳逆寒热，除湿血痹，逐风邪，开腠理。\""}]},{"ID":"20240612090546-rjcg8kr","Type":"NodeParagraph","Properties":{"id":"20240612090546-rjcg8kr","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主痰冷，腹内绞痛，诸冷实不消，中恶，心腹痛，逆气，利五脏。\""}]},{"ID":"20240612090546-6k8c7t1","Type":"NodeParagraph","Properties":{"id":"20240612090546-6k8c7t1","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主心腹疾，积冷，心下结气，疰心痛；治霍乱转筋，胃中冷气，吐泻腹痛不可胜忍者；疗遍身顽痹，冷食不消，利大肠拥气。\""}]},{"ID":"20240612090546-020tpkz","Type":"NodeParagraph","Properties":{"id":"20240612090546-020tpkz","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"杀恶虫毒，牙齿虫匿。\""}]},{"ID":"20240612090546-4z3be6g","Type":"NodeParagraph","Properties":{"id":"20240612090546-4z3be6g","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"健脾通关节。治腹痛，肾气，脚气，水肿，下产后余血。\""}]},{"ID":"20240612090546-5wp5x0e","Type":"NodeParagraph","Properties":{"id":"20240612090546-5wp5x0e","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑥王好古：\"治痞满塞胸，咽膈不通，润肝燥脾。\""}]},{"ID":"20240612090546-60vfm71","Type":"NodeParagraph","Properties":{"id":"20240612090546-60vfm71","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"开郁化滞。治吞酸，蹶阴痰涎头痛，阴毒腹痛，疝气，血痢，喉舌口疮。\""}]},{"ID":"20240612090546-h2mijhb","Type":"NodeParagraph","Properties":{"id":"20240612090546-h2mijhb","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612090546-2bjwkmu","Type":"NodeParagraph","Properties":{"id":"20240612090546-2bjwkmu","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～2钱；或入丸、散。外用：蒸热熨，研末调敷或煎水洗。"}]},{"ID":"20240612090546-9nstm3q","Type":"NodeParagraph","Properties":{"id":"20240612090546-9nstm3q","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612090546-unibi5e","Type":"NodeParagraph","Properties":{"id":"20240612090546-unibi5e","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" ①治肾气上哕，肾气自腹中起上筑于咽喉，逆气连属而不能吐，或至数十声，上下不得喘息：吴茱萸（醋炒）、橘皮、附子（去皮）各一两。为末，面糊丸，梧子大。每姜汤下七十丸。（《仁存堂经验方》）"}]},{"ID":"20240612090546-cwuxl55","Type":"NodeParagraph","Properties":{"id":"20240612090546-cwuxl55","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②治醋心，每醋气上攻如酽醋：茱萸一合。水三盏，煎七分，顿服。纵浓，亦须强服。（《兵部手祭方》）"}]},{"ID":"20240612090546-ga416xv","Type":"NodeParagraph","Properties":{"id":"20240612090546-ga416xv","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"③治食已吞酸，胃气虚冷者：吴茱萸（汤泡七次，焙）、干姜（炮）等分。为末，汤服一钱。（《圣惠方》）"}]},{"ID":"20240612090546-hm9y9z5","Type":"NodeParagraph","Properties":{"id":"20240612090546-hm9y9z5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"④治肝火：黄连六两，吴茱萸一两或半两。上为末，水丸或蒸饼丸。白汤下五十丸。（《丹溪心法》左金丸，一名回令丸）"}]},{"ID":"20240612090546-i16z1px","Type":"NodeParagraph","Properties":{"id":"20240612090546-i16z1px","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑤治呕而胸满，及干呕吐涎沫，头痛者：吴茱萸一升，人参三两，生姜六两，大枣十二枚。上四味，以水五升，煮取三升，温服七合，日三服。（《金匮要略》吴茱萸汤）"}]},{"ID":"20240612090546-gpef5c5","Type":"NodeParagraph","Properties":{"id":"20240612090546-gpef5c5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑥治头风：吴茱萸三升。水五升，煮取三升，以绵拭发。根。（《干金翼方》）"}]},{"ID":"20240612090546-7hk3kd2","Type":"NodeParagraph","Properties":{"id":"20240612090546-7hk3kd2","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑦治痰饮头疼背寒，呕吐酸汁，数日伏枕不食，十日一发：吴茱萸（汤泡七次）、茯苓筹分。为末，炼蜜丸悟子大。每热水下五十丸，（《朱氏集验方》）"}]},{"ID":"20240612090546-ujw3c3l","Type":"NodeParagraph","Properties":{"id":"20240612090546-ujw3c3l","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑧治多年脾泄，老人多此，谓之水土同化：吴茱萸三钱。泡过，煎汁，入盐少许，通口服，盖茱萸能暖膀胱，水道既清，大肠自固，他药虽热，不能分解清浊也。（《仁存堂经验方》）"}]},{"ID":"20240612090546-4crg23p","Type":"NodeParagraph","Properties":{"id":"20240612090546-4crg23p","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑨治脾受湿气，泄利不止，米谷迟化，脐腹刺痛；小儿有疳气下痢，亦能治之：黄连（去须）、吴茱萸（去梗，炒）、白芍药各五两。上为细末，面糊为丸，如梧桐子大。每服二十丸，浓煎米饮下，空心日三服。（《局方》戊己丸）"}]},{"ID":"20240612090546-6xyheot","Type":"NodeParagraph","Properties":{"id":"20240612090546-6xyheot","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑩治脚气入腹，困闷欲死，腹胀：吴茱萸六升，木瓜两颗（切）。上二味，以水一斗三升，煮取三升，分三服，相去如人行十里久，进一服，或吐、或汗、或利、或大热闷，即瘥。（《千金方》苏长史茱萸汤）"}]},{"ID":"20240612090546-9qkn8tn","Type":"NodeParagraph","Properties":{"id":"20240612090546-9qkn8tn","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑾治脚气疼痛，如人感风湿流注，脚足痛不可忍，筋脉浮肿，宜服之：槟榔七枚，陈皮（去白）、木瓜各一两，吴茱萸、紫苏叶各三钱，桔梗（去芦）、生姜（和皮）各半两。上细切，水煎，次日五更，分作三、五服，只是冷服。冬天略温服亦得。（《证治准绳》鸡鸣散）"}]},{"ID":"20240612090546-bbjn7cc","Type":"NodeParagraph","Properties":{"id":"20240612090546-bbjn7cc","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑿治远年近日小肠疝气，偏坠搐疼，脐下撮痛，以致闷乱，及外肾肿硬，日渐滋长，阴间湿痒成疮：吴茱萸（去枝梗）一斤（四两用酒浸，四两用醋浸，四两用汤浸，四两用童子小便浸，各浸一宿，同焙干），泽泻（去灰土）二两。上为细末，酒煮面糊丸如梧桐子大。每服五十丸，空心食前盐汤或酒吞下。（《局方》夺命丹）"}]},{"ID":"20240612090546-nmlbg9e","Type":"NodeParagraph","Properties":{"id":"20240612090546-nmlbg9e","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒀治小儿肾缩（乃初生受寒所致）：吴茱萸、硫黄各半两。同大蒜研涂其腹，仍以蛇床子烟熏之。（《圣惠方》）"}]},{"ID":"20240612090546-2dsr89k","Type":"NodeParagraph","Properties":{"id":"20240612090546-2dsr89k","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒁治口疮口疳：茱萸末，醋调涂足心。亦治咽喉作痛。（《濒湖集简方》）"}]},{"ID":"20240612090546-hml26vh","Type":"NodeParagraph","Properties":{"id":"20240612090546-hml26vh","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒂治牙齿疼痛：茱萸煎酒含漱之。（《食疗本草》）"}]},{"ID":"20240612090546-pcv0c21","Type":"NodeParagraph","Properties":{"id":"20240612090546-pcv0c21","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒃治湿疹：炒吴茱萸一两，乌贼骨七钱，硫黄二钱。共研细末备用。湿疹患处渗出液多者撒干粉；无渗出液者用蓖麻油或猪板油化开调抹，隔日一次，上药后用纱布包扎。（《全展选编·皮肤科》）"}]},{"ID":"20240612090546-ptvt1xm","Type":"NodeParagraph","Properties":{"id":"20240612090546-ptvt1xm","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒄治阴下湿痒生疮：吴茱萸一升，水三升，煮三、五沸，去滓，以洗疮。诸疮亦治之。（《古今录验方》）"}]},{"ID":"20240612090546-oipi9qs","Type":"NodeParagraph","Properties":{"id":"20240612090546-oipi9qs","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒅中风（口角偏斜，不能语言）。用茱萸一升、姜豉三升、清酒五程式，合煎开数次，冷后每服半升。一天服三次。微汗即愈。"}]},{"ID":"20240612090546-ixdfhek","Type":"NodeParagraph","Properties":{"id":"20240612090546-ixdfhek","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒆全身发痒。用茱萸一升，加酒五升，煮成一升半，乘温擦洗，痒即停止。"}]},{"ID":"20240612090546-jihamsu","Type":"NodeParagraph","Properties":{"id":"20240612090546-jihamsu","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⒇冬月感寒。用吴茱萸五钱煎汤服，以出汗为度。"}]},{"ID":"20240612090546-orfbmxg","Type":"NodeParagraph","Properties":{"id":"20240612090546-orfbmxg","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（21）呕吐、胸满、头痛。用茱萸一升、枣二十枚、生姜一两、人参一两，加水五升煎成三升，每服七合，一天服二次，此方名\"吴茱萸汤\"。"}]},{"ID":"20240612090546-b59tvm7","Type":"NodeParagraph","Properties":{"id":"20240612090546-b59tvm7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（22）心腹冷痛。用吴茱萸五合，加酒三升煮开，分三次服。"}]},{"ID":"20240612090546-wvxlsmn","Type":"NodeParagraph","Properties":{"id":"20240612090546-wvxlsmn","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（23）小肠疝气（偏坠疼痛，睾丸肿硬，阴部湿痒）。用吴茱萸（去梗）一斤，分作四份。四两泡酒，四两泡醋，四两泡开水，四两泡童便。经一夜后，都取出焙干，加泽泻二两，共研为末，以酒和粉调成丸子，如梧子大。每服五十丸，空心服，盐汤或酒送下。此方名\"夺命丹\"，亦名\"星斗丸\"。"}]},{"ID":"20240612090546-qthlvpt","Type":"NodeParagraph","Properties":{"id":"20240612090546-qthlvpt","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（24）妇女阴寒，久不受孕。用吴茱萸、川椒各一升，共研为末，加炼蜜做丸子，如弹子大。裹棉肉纳入阴道中，令子宫开即可受孕。"}]},{"ID":"20240612090546-w2gk092","Type":"NodeParagraph","Properties":{"id":"20240612090546-w2gk092","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（25）胃气虚冷，口吐酸水。用吴茱萸在开水中泡七次，取出焙干，加干姜（炮），等分为末。每服一钱，热汤送下。"}]},{"ID":"20240612090546-bus6w5i","Type":"NodeParagraph","Properties":{"id":"20240612090546-bus6w5i","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（26）转筋入腹。用茱萸（炒）二两，加酒二碗，煎成一碗，分二次服。得泻即愈。"}]},{"ID":"20240612090546-qs014vb","Type":"NodeParagraph","Properties":{"id":"20240612090546-qs014vb","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（27）老人多年水泄。用吴茱萸三钱，泡过，取出，加水煎嗔，放一点盐后服下。"}]},{"ID":"20240612090546-89brdt3","Type":"NodeParagraph","Properties":{"id":"20240612090546-89brdt3","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（28）赤白痢（脾胃受湿，下痢腹痛，米谷不化）。用吴茱萸、黄连、白芍药各一两，同炒为末，加蒸饼做成丸子，如梧子大。每服二、三十丸，米汤送下。此方名\"戊己丸\"。又方：用川黄连二峡谷、吴茱萸二两（汤沁七次），同炒香，分别研为末，各与粟米饭做成丸子，如梧子大，收存备用。每服三十丸。赤痢，以甘草汤送服黄连丸；白痢，以干姜汤送服茱萸丸；赤白痢，两丸各用十五粒，米汤送下。此方名\"变通丸\"。又方：用吴茱萸二两、黄连二两，同炒香，各自为末。以百草霜二两，加饭同黄连做成丸子；以白芍药末二两，加饭同茱萸做成丸子，各如梧子大，收存备用。每服五十丸。赤痢，以乌梅汤送服连霜丸；白痢，以米汤送服茱芍丸；赤白痢，两种药丸各服二十五粒。此方名\"二色丸\"。"}]},{"ID":"20240612090546-508lz7v","Type":"NodeParagraph","Properties":{"id":"20240612090546-508lz7v","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（29）腹中积块。用茱萸一升捣烂，和酒同煮，取出包软布中熨积块处，冷则炒热再熨。块如移动，熨也移动，直至积块消除。"}]},{"ID":"20240612090546-39cjm61","Type":"NodeParagraph","Properties":{"id":"20240612090546-39cjm61","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（30）牙齿疼痛。用茱萸煎酒含漱。"}]},{"ID":"20240612090546-2u8h8yp","Type":"NodeParagraph","Properties":{"id":"20240612090546-2u8h8yp","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（31）老小风疹。用茱萸煎酒涂搽。"}]},{"ID":"20240612090546-qglh5w1","Type":"NodeParagraph","Properties":{"id":"20240612090546-qglh5w1","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（32）痈疽发背。用吴茱萸一升捣为末，加苦酒调涂布上贴患处。"}]},{"ID":"20240612090546-1m67sbt","Type":"NodeParagraph","Properties":{"id":"20240612090546-1m67sbt","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"（33）寒热怪病（发寒发热不止，几天后四肢坚硬如石，敲起来发铜器声，日渐瘦弱）。用茱萸、木香等分，煎激发服。"}]},{"ID":"20240612090546-2n4im0x","Type":"NodeParagraph","Properties":{"id":"20240612090546-2n4im0x","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612090546-nud1rix","Type":"NodeParagraph","Properties":{"id":"20240612090546-nud1rix","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" ①治疗高血压病"}]},{"ID":"20240612090546-7afokly","Type":"NodeParagraph","Properties":{"id":"20240612090546-7afokly","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"将吴茱萸研末，每次取0.6～1两，用醋调敷两足心（最好睡前敷，用布包裹）。一般敷12～24小时后血压即开始下降，自觉症状减轻。轻症敷1次，重的敷2～3次即显示降压效果。"}]},{"ID":"20240612090546-vrccwkp","Type":"NodeParagraph","Properties":{"id":"20240612090546-vrccwkp","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"②治疗消化不良"}]},{"ID":"20240612090546-7m4vvk4","Type":"NodeParagraph","Properties":{"id":"20240612090546-7m4vvk4","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"取吴萸粉2.5～3克，用食醋5～6毫升调成糊状，加温至40℃左右，摊于2层方纱布上（约0.5厘米厚），将4周折起；贴于脐部，用胶布固定。12小时更换1次。经治20例，痊愈18例，好转1例，无效1例。初步观察，本法有调节胃肠功能、温里去寒、止痛及帮助消化等作用。对胃畅功能紊乱所致的腹泻效果较好，对细菌感染所致的腹泻配合应用抗菌素可产生协同作用。"}]},{"ID":"20240612090546-vm6p2sr","Type":"NodeParagraph","Properties":{"id":"20240612090546-vm6p2sr","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"③治疗湿疹、神经性皮炎"}]},{"ID":"20240612090546-bh1kngx","Type":"NodeParagraph","Properties":{"id":"20240612090546-bh1kngx","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"吴茱萸研末，用凡士林调成30％（甲种）和20％（乙种）两种软膏；再取30％吴茱萸软膏和等量氧化锌软膏调匀，配成复方吴茱萸软膏（丙种）。对亚急性和一般慢性湿疹，及阴囊湿疹在亚急性期或早期者，采用乙种软膏；对多年慢性阴囊湿疹则采用甲种软膏；婴儿湿疹采用丙种软膏。局部搽药，每日2次。对神经性皮炎先搽甲种软膏，再配合热电吹风，每日1次，每次20分钟，然后用比皮损略大的胶布块贴牢。据82例湿疹和神经性皮炎的观察，对湿疹初期及亚急性湿疹疗效较好，治愈时间员短者3天；对一般慢性湿疹，治愈时间最短者10天；对多年呈苔藓样变的慢性湿疹无效；婴儿湿疹11例，除两例无效外，余均在7～15天内临床治愈；阴囊湿疹初期效果明显，患病多年近于苔藓样变者无效；神经性皮炎19例，均为轻型及限局性患者，配合热电吹风比单纯涂药者疗效显著。又有用10％吴茱萸糊膏局部涂抹后，再以艾熏20分钟，治疗限局性神经性皮炎14例；结果治愈4例，显著进步7例，好转3例。治愈病例一般治疗4～6次。此法止痒效果显著。"}]},{"ID":"20240612090546-y15wr4b","Type":"NodeParagraph","Properties":{"id":"20240612090546-y15wr4b","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"④治疗黄水疮"}]},{"ID":"20240612090546-m3rj81j","Type":"NodeParagraph","Properties":{"id":"20240612090546-m3rj81j","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"将吴茱萸研粉用凡士林调制成10％软膏，局部涂擦，每日1～2次。擦药前先用温水洗净患处：治疗12例，一般4～6次即愈。"}]},{"ID":"20240612090546-3l0fysn","Type":"NodeParagraph","Properties":{"id":"20240612090546-3l0fysn","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"⑤治疗口腔溃疡"}]},{"ID":"20240612090546-niil95n","Type":"NodeParagraph","Properties":{"id":"20240612090546-niil95n","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"将吴茱萸捣碎，过筛，取细末加适量好醋调成糊状，涂在纱布上，敷于双侧涌泉穴，24小时后取下。用量：1岁以下用0.5～2钱，1～5岁用2～3钱，6～15岁用3～4钱，15岁以上用4～5钱。治疗256例，有247例治愈。一般敷药1次即有效。"}]},{"ID":"20240612090546-u7tac1a","Type":"NodeParagraph","Properties":{"id":"20240612090546-u7tac1a","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612090546-b490l8j","Type":"NodeParagraph","Properties":{"id":"20240612090546-b490l8j","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 吴茱萸的功效是温中、散寒、下气、开郁。近年来临床实际上践，亦用本品治蛲虫病。临床实践学认为吴茱萸有明显的止痛、止呕作用。"}]},{"ID":"20240612090546-lrvwlnx","Type":"NodeParagraph","Properties":{"id":"20240612090546-lrvwlnx","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612090546-9o35kuo","Type":"NodeParagraph","Properties":{"id":"20240612090546-9o35kuo","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612090546-y5ilddx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612090546-y5ilddx","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"《中华本草》：吴茱萸"}]},{"ID":"20240612090546-9jub2s6","Type":"NodeParagraph","Properties":{"id":"20240612090546-9jub2s6","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612090546-xhy5ibs","Type":"NodeParagraph","Properties":{"id":"20240612090546-xhy5ibs","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" Wú Zhū Yú"}]},{"ID":"20240612090546-4crau2i","Type":"NodeParagraph","Properties":{"id":"20240612090546-4crau2i","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612090546-ebe42w9","Type":"NodeParagraph","Properties":{"id":"20240612090546-ebe42w9","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 食茱萸吴萸、茶辣、漆辣子、优辣子、曲药子、气辣子。"}]},{"ID":"20240612090546-hl6cfap","Type":"NodeParagraph","Properties":{"id":"20240612090546-hl6cfap","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612090546-jnf248o","Type":"NodeParagraph","Properties":{"id":"20240612090546-jnf248o","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" Medcinal Evodia Fruit, Fruit of Medicinal Evodia"}]},{"ID":"20240612090546-2fqrhao","Type":"NodeParagraph","Properties":{"id":"20240612090546-2fqrhao","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612090546-dlzkvp0","Type":"NodeParagraph","Properties":{"id":"20240612090546-dlzkvp0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612090546-z4jlryg","Type":"NodeParagraph","Properties":{"id":"20240612090546-z4jlryg","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612090546-g62d68k","Type":"NodeParagraph","Properties":{"id":"20240612090546-g62d68k","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芸香科植物吴茱萸、石虎及毛脉吴茱萸未成熟的果实。"}]},{"ID":"20240612090546-bmiades","Type":"NodeParagraph","Properties":{"id":"20240612090546-bmiades","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Evodia rutaecarpa （Juss.）Benth.2.Evodia rutaecarpa （Juss.）Benth.var.officinalis （Dode）Huang3.Evodia rutaecarpa （Juss.）Benth.var.bodinieri （Dode）Huang"}]},{"ID":"20240612090546-dtk61cm","Type":"NodeParagraph","Properties":{"id":"20240612090546-dtk61cm","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后3年，早熟品种7月上旬，晚熟品种8月上旬，待果实呈茶绿色而心皮未分离时采收，在露水未干前采摘整串果穗，切勿摘断果枝，晒干，用手揉搓，使果柄脱落，扬净。如遇雨天，用微火抗干。"}]},{"ID":"20240612090546-xlb0c7n","Type":"NodeParagraph","Properties":{"id":"20240612090546-xlb0c7n","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612090546-pxj12e9","Type":"NodeParagraph","Properties":{"id":"20240612090546-pxj12e9","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生长于低海拔向阳的疏林下或林缘旷地。"}]},{"ID":"20240612090546-dpwc3ei","Type":"NodeParagraph","Properties":{"id":"20240612090546-dpwc3ei","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.生于山坡草丛中。"}]},{"ID":"20240612090546-62ojoks","Type":"NodeParagraph","Properties":{"id":"20240612090546-62ojoks","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"3.生于村边路旁、山坡草丛中。"}]},{"ID":"20240612090546-vqi7668","Type":"NodeParagraph","Properties":{"id":"20240612090546-vqi7668","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于陕西、甘肃、安徽、浙江、福建、台湾、湖北、湖南、广东、广西、四川、贵州、云南。"}]},{"ID":"20240612090546-o5pc51z","Type":"NodeParagraph","Properties":{"id":"20240612090546-o5pc51z","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.分布于浙江、江西、湖北、湖南、广西、四川、贵州。"}]},{"ID":"20240612090546-64noyw9","Type":"NodeParagraph","Properties":{"id":"20240612090546-64noyw9","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"3.分布于江西、湖南、广东、广西及贵州。"}]},{"ID":"20240612090546-qatbhwq","Type":"NodeParagraph","Properties":{"id":"20240612090546-qatbhwq","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612090546-28aoz3c","Type":"NodeParagraph","Properties":{"id":"20240612090546-28aoz3c","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 1.树皮青灰褐色，幼枝紫褐色，有细小圆形的皮孔；幼技、叶轴及花轴均被锈色绒毛。奇数羽状复叶对生，连叶柄长20-40cm；叶柄长4-8cm，小叶柄长2-5mm；小叶5-9，椭圆形至卵形，长5.5-15cm，宽3-7cm，先端骤狭成短尖，基部楔形至广楔形或圆形，全缘或有不明显的钝锯齿，侧脉不明显，两面均被淡黄褐色长柔毛，脉上尤多，有明显的油点，厚纸质或纸质。雌雄异株，聚伞圆锥花序，顶生；花轴粗壮，密被黄褐色长柔毛，花轴基部有小叶片状的狭小对生苞片2枚；萼片5，广卵形，长约1-2mm，被短柔毛；花瓣5，白色，长圆形，长4-6mm；雄花具5雄蕊，插生在极小的花盘上，花药基着，椭圆形，花丝粗短，被毛，退化子房先端4-5裂；雌花的花瓣较雄花瓣大，退化雄蕊鳞片状，子房上位，长圆形，心皮5，花后增宽成扁圆形，有粗大的腺点，花柱粗短，柱头先端4-5钱裂。果实扁球形，成熟时裂开成5个果瓣，呈蓇葖果状，紫红色，表面有粗大油腺点，每分果有种子1个，黑色，有光泽。花期6-8月，果期9-10月。"}]},{"ID":"20240612090546-qz0i06t","Type":"NodeParagraph","Properties":{"id":"20240612090546-qz0i06t","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.石虎 本变种与正种很相似。区别点为变种具有特殊的刺激性气味。小叶3-11，叶片较狭，长圆形至狭披针形，先端渐尖或长渐尖，各小叶片相距较疏远，侧脉较明显，全缘，两面密被长柔毛，脉上最密，油腺粗大。花序轴常被淡黄色或无色的长柔毛。成熟果序不及正种密集。种子带蓝黑色。花期7-8月，果期9-10月。"}]},{"ID":"20240612090546-ga9kigr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612090546-ga9kigr","updated":"20240612090546"},"Children":[{"ID":"20240612090546-9h6dxjm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240612090546-9h6dxjm","updated":"20240612090546"},"Children":[{"ID":"20240612090546-plxcgbh","Type":"NodeParagraph","Properties":{"id":"20240612090546-plxcgbh","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"毛脉吴茱萸 与上种相似。小枝被黄锈色或丝光质的疏长毛。叶轴被长柔毛；小叶5-11，叶形变化较大，长圆形、披针形、卵状披针形，上表面中脉略被疏短毛，下面脉上被短柔毛，侧脉清晰，油腺点小。花期7-8月，果期9-10月。"}]}]}]},{"ID":"20240612090546-5yb0tqt","Type":"NodeParagraph","Properties":{"id":"20240612090546-5yb0tqt","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612090546-3jy0d1q","Type":"NodeParagraph","Properties":{"id":"20240612090546-3jy0d1q","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，不耐寒冷、干燥。以选阳光充足、土层深厚、疏松肥沃、排水良好的砂质壤上和腐殖质壤土栽培为宜；低洼积水地不宜栽培。"}]},{"ID":"20240612090546-zgy3yd0","Type":"NodeParagraph","Properties":{"id":"20240612090546-zgy3yd0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、分株、扦插繁殖。种子繁殖：取树势健壮、结果多的植株，待果实成熟后来收，明干，切忌日晒，否则易使种子失去发芽力。春播，于3月下旬-4月上旬，用条插法，按行距15-20cm开条沟，深3-5cm，将种子均匀播入，薄覆细土，盖草一层，浇水保湿。现因繁殖速度慢，放生产上已少用。分株繁殖：12月下旬，可在母株旁距0.6m处，将侧根的表上刨开，露出较粗的侧根，每隔7cm左右砍一伤口，再覆土，施粪肥。春季伤口处长出幼苗，待幼苗长大后，即可与母株分离。扦插繁殖：枝插法，11-12月或1-2月植株萌芽前，剪取1-2年生健壮枝条为插穗，长20-25cm，具3-4个芽，两端剪成斜面，扦插手苗床，露出地面5-10cm，覆草一层，注意浇水，遮荫。扦插后约1-2个月生根。第2年苗高30cm移栽。根插法，选树龄4-6年，于2月上旬前后，选较粗壮的侧根，截成15-18cm的小段作插穗，按行株距15cm×15cm开穴，每穴斜插一段，覆土，浇水。育苗第二年就可移栽，定植移栽时间3-4月或11-12月，按行珠距（1.5-2）m ×（1.5-2）m开穴，穴径60cm，深45cm，施入腐熟厩肥，幼苗根部蘸黄泥浆后栽种，覆土，压实，浇水。"}]},{"ID":"20240612090546-gfc3wxd","Type":"NodeParagraph","Properties":{"id":"20240612090546-gfc3wxd","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"田间管理 每年需中耕除草，结合施追肥2-3次，早春萌芽前追施人粪尿，孕蕾前再施1次。开花后增施磷、钾肥，可防止落果，促进种子饱满成熟。整枝修剪，幼龄树离地面80cm处打顶，促使形成一定的树冠；成年树要剪除重叠枝、下垂枝、枯枝、病虫枝、老弱枝。修剪工作可在落叶后进行。并要培土保暖防冻。移栽后幼龄树行间可套种花生、薯类、大豆或除虫菊等。"}]},{"ID":"20240612090546-wi7npp0","Type":"NodeParagraph","Properties":{"id":"20240612090546-wi7npp0","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有煤烟病，5-6月杀死传染病源，可喷1：1：200信的波尔多液。锈病，5月中旬发病时喷波美0.2-0.3度石流合剂或25％粉锈宁100倍液。还有树脂病等为害。虫害有褐天牛，7-10月为害，幼虫蛀人树干，蛀食木质部，可用人工捕捉。橘风蝶，3月幼虫咬食芽、嫩叶或咬成缺刻与孔洞，可喷Bt乳剂300倍液。另有蚜虫、红蜡介壳虫等为害。"}]},{"ID":"20240612090546-t3gbkto","Type":"NodeParagraph","Properties":{"id":"20240612090546-t3gbkto","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612090546-dkjfzv3","Type":"NodeParagraph","Properties":{"id":"20240612090546-dkjfzv3","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实类球形或略呈五角状扁球形，直径2-5mm。表面暗绿黄色至褐色，粗糙，有多数点状突起或凹下油点。顶端有五角星状的裂隙，基部有花萼及果柄，被有黄色茸毛。质硬而脆。气芳香浓郁，味辛辣而苦。以饱满、色绿、香气浓郁者为佳。"}]},{"ID":"20240612090546-c27tew9","Type":"NodeParagraph","Properties":{"id":"20240612090546-c27tew9","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果实横切面：类圆形，中央分为5室。外果皮表皮细胞1列，类圆形，排列整齐，大多含橙皮甙结晶；可见多数气孔和少数非腺毛及非腺毛脱落后的疤痕。中果皮较厚，散有纤维束和多数大型油室，直径120-180μm，薄壁细胞含草酸钙簇晶，近内果皮尤密，簇晶直径12-16μm。内果皮4-5列薄壁细胞，长方形，切向排列，较中果皮细胞小。果实每室内有1粒种子，类三角形，种皮石细胞呈栅栏状排列，壁较厚，种皮内全为胚乳组织。"}]},{"ID":"20240612090546-xm5b53a","Type":"NodeParagraph","Properties":{"id":"20240612090546-xm5b53a","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"粉末特征：褐色。①非腺毛1-9细胞，长62-350μm，壁疣明显，有的胞腔含棕黄色至棕红色物。②腺毛头部7-14或更多细胞，椭圆形，常含黄棕色内含物；柄1-5细胞。③草酸钙簇晶直径10-25μm，偶有方晶。④果柄石细胞类圆形或长方形，直径35-70μm，胞腔大。⑤油室碎片有时可见，淡黄色。⑥橙皮甙结晶扇形或圆形，有放射状纹理。"}]},{"ID":"20240612090546-id6ruid","Type":"NodeParagraph","Properties":{"id":"20240612090546-id6ruid","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612090546-fdmo3o2","Type":"NodeParagraph","Properties":{"id":"20240612090546-fdmo3o2","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 种子含顺式-5，8-十四碳二烯酸（cis-5，8-tetradecadienic acid）。果实的挥发油中含吴茱萸烯（evodene），吴茱萸内酯醇（evodol），柠檬苦素（limonin）。果实中含吴茱萸碱（evodiamine），吴茱萸次碱（rutaecarpine），吴茱萸卡品碱（evo-carpine），羟基吴茱萸碱（hydroxyevodiamine），吴茱萸因碱（wuchuyine），罗勒烯（ocimene），吴茱萸啶酮（evodione），吴茱萸精（evogin），吴茱萸苦素（rutaevin），7-羧基吴茱萸碱（7-car-boxyevodiamine），二氢吴茱萸次碱（dihydrorutaecarpine），14-甲酸吴茱萸次碱（14-formyl rutaecarpine），1-甲基-2-壬基-4（1H）-喹诺酮[1-methyl-2-nonyl-4（1H）-quinolone]，N，N-二甲基-5-甲氧基色胺（N，N-dimethyl-5-methoxytryptamine），N-甲基邻氨基苯甲酸胺（N-methylanthranoylamide），辛弗林（synephrine），去氢吴茱萸碱 （dehydroevodiamine），吴茱萸酰胺（evodiamide），去甲基吴茱萸酰胺[N-（2-methylaminobenzoyl）tryptamine]，6a-乙酸氧基-5-表柠檬苦素（6a-acetoxy-5-epi-limonin），6β-乙酰氧基-5-表柠檬苦素（6β-acetoxy-5-ePi-limonin），黄柏酮（obacunone），罗旦梅交酯（jangomolide），吴茱萸苦素乙酸酯（rutaevine acetate），臭辣树交酯A（graucin A），12a-羟基柠檬苦素（12a-hydroxylimonin），12a-羟基吴茱萸内酯醇（12a-hydroxyevodol），1-甲基-2[（Z）-6-十一碳烯]-4（1H）-喹诺酮｛1-methyl-2[（Z）-6-undecenyl]-4（1H）-quinolone｝，1-甲基-2-[（Z）-10-十五碳烯]-4（1H）-喹诺酮｛1-methyl-2-[（Z）-10-pentadecenyl]－4（1H）-quinolone｝，1-甲基-2-[（Z）-6-十五碳烯]－4（1H）-喹诺酮｛1-methyl-2-[（Z）-6-pentadecenyl]－4（1H）-quinolone｝，1-甲基-2-[（6Z，9Z）-6，9-十五碳二烯]-4（1H）一喹诺酮｛1-methyl-2-[（6Z，9Z）-6，9-pentadecadienyl]－4（1H）－quinolone｝，1-甲基-2-[（4Z 7Z）－4，7-十三碳二烯]-4（1H）-喹诺酮｛1-methyl-2-[（4Z，7Z）-4，7-tridecadienyl]-4（1H）-quinolone｝，吴茱萸果酰胺Ⅰ（goshuyuamide Ⅰ），吴茱萸果酰胺Ⅱ（goshuyuamide Ⅱ）。此外，果实中还含天冬氨酸（aspartic acid），色氨酸（tryptophan），苏氨酸（threonine），丝氨酸（serine），及胱氨酸（cystine）等十八种氨基酸。"}]},{"ID":"20240612090546-3dz8m0k","Type":"NodeParagraph","Properties":{"id":"20240612090546-3dz8m0k","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"石虎果实含吴茱萸内酯（evodin）又称柠檬苦素（limonin），吴茱萸碱，吴茱萸次碱，羟基吴茱萸碱，石虎甲素（Shih-Hu A），吴茱萸卡品碱，二氢吴茱萸卡品碱（dihydroevocarpine），1-甲基-2-十一烷基-4（1H）-喹诺酮[1-methyl-2-undecyl-4（1H）-quinolone）]，1甲基-2-[（Z）-6-十一烯基]-4（1H）-喹诺酮｛1-methyl-2-[（Z）-6-undecenyl]-4（1H）-quinolone｝。"}]},{"ID":"20240612090546-bul852r","Type":"NodeParagraph","Properties":{"id":"20240612090546-bul852r","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612090546-s7gehvh","Type":"NodeParagraph","Properties":{"id":"20240612090546-s7gehvh","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 1.对心血管系统的作用：。"}]},{"ID":"20240612090546-6m7gywz","Type":"NodeParagraph","Properties":{"id":"20240612090546-6m7gywz","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.1.强心作用：。"}]},{"ID":"20240612090546-tn6mxz6","Type":"NodeParagraph","Properties":{"id":"20240612090546-tn6mxz6","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.1.1.另8只离体蟾蜍心，同一心脏用吴茱萸汤与异丙肾上腺素交叉给予。提示吴茱萸汤强心作用剂量小，持续时间长，无异丙肾上腺素加快心率的作用，故可能无增加心肌氧耗之弊。"}]},{"ID":"20240612090546-r9usjyk","Type":"NodeParagraph","Properties":{"id":"20240612090546-r9usjyk","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.1.2.大耳白兔3只，体重1.75±0.09kg，性别不拘。麻醉后，开胸，用蛙心夹夹住心尖部，连接机械电换能器，以二道生理仪记录心脏收缩曲线。耳缘静脉给吴茱萸汤0.3g／kg，观察30分钟，然后静脉注射2%戊巴比妥适量，待心肌收缩力明显减弱后，再给吴茱萸汤，观察30分钟。可见吴茱萸汤显着增强在体兔心收缩力，给药后30分钟仍未恢复至药前水平。"}]},{"ID":"20240612090546-j16g6bp","Type":"NodeParagraph","Properties":{"id":"20240612090546-j16g6bp","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.2.升压作用：。"}]},{"ID":"20240612090546-r06zpi5","Type":"NodeParagraph","Properties":{"id":"20240612090546-r06zpi5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.2.1.狗3只，麻醉后以插入式血压计显示左股动脉血压，右股静脉给吴茱萸汤0.2g／kg。给药前血压为13.29±5.71（kPa，X±SD，下同），给药后血压上升，最高峰为24.36±5.60，差值为10.79±1.24（P＜0.01）；最低峰为11.07±5.41，差值为2.20±0.73（P＜0.05）。升压维持368±635；恢复后有轻度下降，维持565±95s。"}]},{"ID":"20240612090546-lrhfbnd","Type":"NodeParagraph","Properties":{"id":"20240612090546-lrhfbnd","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.2.2.大鼠9只，以水银检压法观察右股静脉给1.04g／kg吴茱萸汤注射液对血压的影响，同时以心电图机描记心率。又以3只大鼠，观察0.04mg／kg肾上腺素对血压的影响，结果吴茱萸汤有升压作用，给药前后对比差异极显着（P＜0.001），又取大鼠6只，分为两组。一组预先给心得安1.8mg／kg，另一组预先给酚妥拉明3.0mg／kg，5分钟后再给吴茱萸汤注射液1.04g／kg。结果吴茱萸汤升高血压作用能因酚妥拉明前处理而取消；后降压作用能被心得安阻断。以上结果表明，吴茱萸汤升压作用迅速，升压伴有心率缓慢。α、β受体阻断实验表明，吴茱萸黄汤有显着的α兴奋作用和较弱的β-兴奋作用，为α、β受体混合兴奋剂。由于吴茱萸汤中含人参量较大，因此这些实验并不能完全说明吴茱萸对心血管的药理作用。"}]},{"ID":"20240612090546-uhp5d8y","Type":"NodeParagraph","Properties":{"id":"20240612090546-uhp5d8y","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"1.3.对家兔球结膜微循环的影响。"}]},{"ID":"20240612090546-5osk8k6","Type":"NodeParagraph","Properties":{"id":"20240612090546-5osk8k6","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"大白兔11只，麻醉后侧卧位固定在保温手术台上，以微循环显微镜放大80倍，冷光源下观察球结膜微循环。耳缘静脉缓缓推注生理盐水0.3ml／kg，5分钟后推注吴茱萸汤注射液0.3g／kg，观察并测取给药前后微动脉内径、毛细血管网交点数，记录微血流态，红细胞聚集情况的动态变化。给药后，微血流速度迅速增快；部分微血流态改善，粒流变成线粒流，线粒流变成线流。"}]},{"ID":"20240612090546-a8ser2n","Type":"NodeParagraph","Properties":{"id":"20240612090546-a8ser2n","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.对消化系统的作用：。"}]},{"ID":"20240612090546-oc30qdc","Type":"NodeParagraph","Properties":{"id":"20240612090546-oc30qdc","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.1.抗胃溃疡作用：。"}]},{"ID":"20240612090546-rkgxk91","Type":"NodeParagraph","Properties":{"id":"20240612090546-rkgxk91","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.1.1.对水浸应激性溃疡的影响：取雌雄小鼠50只，体重21.2±1.2g，均分为5组，禁食1夜，分别灌胃吴茱萸水煎剂、甲氰咪呱和自来水后，装入特制的应激盒内，并浸在20-23℃水中，使水位达到小鼠颈部。8小时后处死小鼠，取胃，镜检点状损害，计算出血点数作为溃疡指数。口服2g／kg的50%甲醇提取物，具有抗大鼠水浸应激生溃疡作用，抑制率达66.6%。"}]},{"ID":"20240612090546-kgwsf85","Type":"NodeParagraph","Properties":{"id":"20240612090546-kgwsf85","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.1.2.对消炎痛和乙醇引起溃疡的影响:取雌雄小鼠50只，体重23.4±1.9g，均分为5组，禁食24小时后分别灌胃吴茱萸水煎剂、呋喃唑酮和自来水。30分钟后腹腔注射消炎痛10mg／kg，l小时后再灌胃50%乙醇0.2ml／只，再过l小时处死取胃，镜检条状损害，测量其总长度（mm）为溃疡指数。吴茱萸10和20g／kg都显着抑制消炎痛加乙醇引起的溃疡形成。"}]},{"ID":"20240612090546-par564q","Type":"NodeParagraph","Properties":{"id":"20240612090546-par564q","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.1.3.对盐酸性胃溃疡的影响:雌雄大鼠40只，体重176±21g，均分为4组，禁食24小时后分别灌服吴茱萸内提物、甲氰咪呱和自来水，l小时后灌胃0.6N盐酸1ml／只，再过l小时处死取胃，镜检条状损害，测量其总长度（mm）为溃疡指数，结果见表8，吴茱萸5和10g／kg都显着抑制盐酸溃疡形成。"}]},{"ID":"20240612090546-wjpz2uf","Type":"NodeParagraph","Properties":{"id":"20240612090546-wjpz2uf","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.1.4.对结扎幽门性溃疡的影响：雌雄大鼠20只，体重145±16g，均分2组，禁食24小时后，乙醚麻醉结扎幽门并分别在十二指肠注射吴茱萸水煎剂和自来水，缝合腹壁后19小时处死取胃，镜检前胃部溃疡，分级计算指数，结果见表8D。提示吴茱萸10g／kg仅能抑制溃疡形成倾向。"}]},{"ID":"20240612090546-h5vna9r","Type":"NodeParagraph","Properties":{"id":"20240612090546-h5vna9r","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.2.对胃液分泌的影响：将体重240-300g的雄性大白鼠20只随机分为两组。禁食24小时（自由饮水）后，给药组按10g／kg体重皮下注射吴茱萸汤注射液。共2次，其中间隔l小时。对照组同法给等积生理盐水。末次给后30分钟，将动物麻醉，结扎幽门后缝合腹壁。术后禁食禁水。5h后处死动物收集全部胃液，测其量与pH值，并测定游离酸和总酸度。结果表明吴茱萸汤可减少大鼠胃液分泌量，并可降低胃液酸度。"}]},{"ID":"20240612090546-efy4buh","Type":"NodeParagraph","Properties":{"id":"20240612090546-efy4buh","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.对胃肠运动的影响：。"}]},{"ID":"20240612090546-7mw60yg","Type":"NodeParagraph","Properties":{"id":"20240612090546-7mw60yg","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.1.提高胃残留率:体重18-22g健康小白鼠21只，随机分2组，按张氏等介绍的方法，以胃中酚红残留率作为排室指标，排空越快，胃中残留越少，结果表明吴茱萸汤能非常明显地提高胃残留率。"}]},{"ID":"20240612090546-qyioofc","Type":"NodeParagraph","Properties":{"id":"20240612090546-qyioofc","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.2.抑制离体胃条运动:制备离体胃条标本，台氏液保养，用离体器官测定仪记录胃条运动的曲线变化。按给药前后自身对照比较。结果当保养液中单味吴茱萸的浓度达5×l0(-3)g/ml，吴茱萸汤浓度达1×10(-2)g/ml时，对胃条的自发性活动均表现为抑制，即张力和收缩幅度均下降，用保养液洗后能恢复活动。单味党参、大枣、生姜对胃条的自发性活动影响不明显，对由氯化乙酰胆碱引起的胃条痉挛性收缩，单味吴茱萸和吴茱萸汤均有明显对抗作用，表现为张力和收缩幅度下降，频率减少。"}]},{"ID":"20240612090546-rqcwwa7","Type":"NodeParagraph","Properties":{"id":"20240612090546-rqcwwa7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.3.对多种药物引起的离体小肠活动的影响:家兔1.5kg左右，豚鼠250g左右，按温血动物离体肠管实验法制备及实验，记录自发收缩活动，待平稳后给予拟被对抗的药物（烟碱、毒扁豆碱、乙酰胆碱、酚妥拉明、利血平、氯化钠和组胺），待记录的收缩活动稳定后，每隔3分钟给予吴茱萸煎剂1次，共3次（除了对抗乙酰胆碱和组胺是采用单一剂量外），使营养液中呈现3个中药累积浓度，每次给中药后记录3分钟肠管活动变化。表明吴茱萸随剂量增加而逐渐显示对7种药物性离体小肠活动的抑制。"}]},{"ID":"20240612090546-t4fnza6","Type":"NodeParagraph","Properties":{"id":"20240612090546-t4fnza6","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.4.止呕作用:健康家鸽30只，雌雄不拘，体重300-400g，随机分为3组，每组10只。实验组分别给吴茱萸及吴茱萸汤水煎剂，对照组给自来水，均按等容积灌胃给药。给药后l小时，每鸽灌胃2%硫酸铜1ml／100g体重。记录每鸽出现第一次呕吐的时间（呕吐潜伏期）及给硫酸铜后1小时内呕吐的次数（呕吐频率）。结果吴茱萸汤能显着减少家鸽呕吐频率，并有延长形成呕吐所需时间的趋势。单味吴茱萸亦有一定止呕作用，但统计不显着。"}]},{"ID":"20240612090546-wrlfnem","Type":"NodeParagraph","Properties":{"id":"20240612090546-wrlfnem","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.5.止泻作用:。"}]},{"ID":"20240612090546-18vgc5e","Type":"NodeParagraph","Properties":{"id":"20240612090546-18vgc5e","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.5.1.对蓖麻油引起的小鼠腹泻的影响雌雄小鼠36只，体重20.7±2.6g，均分为3组，分别灌胃吴茱萸水煎剂和自来水，30分钟后灌肠蓖麻油0.15ml／只，记录腹泻次数。实验过程禁食禁水。可见吴茱萸10g和20g／kg都减少蓖麻油引起的腹泻次数，且随着剂量增大作用持续时间延长，但作用产生缓慢。"}]},{"ID":"20240612090546-dbjbu2d","Type":"NodeParagraph","Properties":{"id":"20240612090546-dbjbu2d","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.3.5.2.对番泻叶引起小鼠腹泻的影响雌雄小鼠30只，体重19.2±1.8g，均分为3组，分别灌肠吴茱萸水煎剂和自来水，30分钟灌肠番泻叶0.4g／只，观察腹泻次数，共8小时。可见吴茱萸对抗番泻叶引起的腹泻作用随剂量增大而提高，作用产生虽缓慢，但持续时间较长。"}]},{"ID":"20240612090546-4lbg2ik","Type":"NodeParagraph","Properties":{"id":"20240612090546-4lbg2ik","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"3.对晚期失血性休克的影响：大耳白兔22只，性别不拘，体重1.75±0.25kg，仿Wiggers贮血瓶法复制晚期失血性休克兔模型。于全血回输后开始从耳缘静脉点滴给药。治疗组给吴茱萸汤注射液（生理盐水稀释至0.5g／ml）10ml/kg；4滴／min，3小时滴完；对照组给等量生理盐水，观察3小时、6小时生存率，平均动脉血压、心率和尿量。结果与生理盐水对照，吴茱萸汤迅速而显着升高休克兔血压，并延缓后期血压的下降，对心率影响不明显。治疗组给药后3小时生存率为11／11有显着性（P＜0.05），高于对照组的6／11；6h生存率为7／11，亦有显着性（P＜0.05）高于对照组1/11。失血后兔尿量非常明显的减少，与对照组比较，吴茱萸汤显着增加尿量。给药后，治疗组呼吸、心跳从微弱变清晰，肢体抖动；对照组兔的呼吸、心率仍微弱，肢体僵卧。"}]},{"ID":"20240612090546-bb3rpth","Type":"NodeParagraph","Properties":{"id":"20240612090546-bb3rpth","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"4.对血栓形成及凝血功能的作用：Wister大鼠60只，雌雄各半，体重185±25g，随机分6组，对照组给等容积的生理盐水；吴茱萸水提物组，按LD50的1／5、1／10、10-20g/kg灌胃给药，另二组为附子水提物组。给药后1小时，测定血栓形成时间，并取血测定生化项目。肝素组，静脉注射l00u/kg，用上法测定。结果吴茱萸水提物在20g／kg剂量时，血栓形成时间明显延长；在10g／kg剂量时，白陶土部分凝血活酶时间（KPTT）有不同程度延长，20g/kg剂量时，KPTT、VF明显延长。其他指标无明显变化。"}]},{"ID":"20240612090546-nvxw2nr","Type":"NodeParagraph","Properties":{"id":"20240612090546-nvxw2nr","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"5.保肝作用：对CCl4诱发急性肝损害大鼠SGPT和SGOT的影响雌雄大鼠36只，体重222±25g，均分4组，每天分别灌胃l次吴茱萸水煎剂和自来水，连续5天，末次给药后1小时，除自来水对照组外，其余各组均腹腔注射四氯化碳（CCl4）0.3ml／kg，并禁食16小时后在乌拉坦麻醉下颈动脉取血测定SGPT及SGOT。可见吴茱萸5和10g／kg都能对抗CCl4升高SGPT作用，其中5g／kg组不能对抗CCl4升高SGOT作用。"}]},{"ID":"20240612090546-uqslug5","Type":"NodeParagraph","Properties":{"id":"20240612090546-uqslug5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"6.其它作用：给小鼠灌胃20g/kg吴茱萸水煎剂，能显着减少酒石酸锑钾引起的扭体反应次数和延长热板刺激的痛反应潜伏期。有人报道吴茱萸的甲醇和水提取物都具有5-羟色胺受体亲和力，间接提示去氢吴茱萸碱可能是5-羟色胺受体激动剂。另据报道，吴茱萸果实的乙醇提取物对中国仓鼠肺细胞（V-79）有显着作用。从该植物中分离的细胞毒素为黄色粉末。用V-79细胞所作的细胞毒试验中，只有此种黄色粉末显示明显的活性。在进一步的用肿瘤细胞、人鼻咽癌（KB）和鼠淋巴细胞、白血病细胞（P388），所作的细胞毒试验中，也只有此种黄色粉末显示活性。它们的IC50值分别为：V-79为0.19mg／ml；KB为0.98mg／ml；P388为0.43mg／ml。此外，吴茱萸果实中吴茱萸碱有抗缺氧作用。"}]},{"ID":"20240612090546-0yhm797","Type":"NodeParagraph","Properties":{"id":"20240612090546-0yhm797","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612090546-fr20i6c","Type":"NodeParagraph","Properties":{"id":"20240612090546-fr20i6c","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 炙吴茱萸：取甘草煎汤，去渣取汤，加入净吴茱萸，浸泡至汤液吸干为度，微火焙干。（每吴茱萸100斤，用甘草6斤4两）。"}]},{"ID":"20240612090546-ysz0wi1","Type":"NodeParagraph","Properties":{"id":"20240612090546-ysz0wi1","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612090546-7av00qu","Type":"NodeParagraph","Properties":{"id":"20240612090546-7av00qu","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末0.5g，加盐酸溶液（l→100）10ml，用力振摇数分钟，滤过。①取滤液2ml，加碘化汞钾试液1滴，振摇后，生成黄白色沉淀。（检查生物碱）②另取滤波1ml，缓缓加入对二甲氨基苯甲醛试液2ml，置水浴上加热，两液接界处生成红褐色环状带。（检查吲哚类生物碱）商品规格分大粒统货和小粒统货。大粒统货：呈五棱扁球形，表面黑褐色，顶部五瓣多裂口，香气浓郁。小粒统货：呈圆球形，裂瓣不明显，表面绿色或灰绿色，香气较淡。"}]},{"ID":"20240612090546-57e2r2v","Type":"NodeParagraph","Properties":{"id":"20240612090546-57e2r2v","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612090546-pg5bxp2","Type":"NodeParagraph","Properties":{"id":"20240612090546-pg5bxp2","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 肝；胃；脾；大肠；肾经"}]},{"ID":"20240612090546-8ay29wa","Type":"NodeParagraph","Properties":{"id":"20240612090546-8ay29wa","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612090546-m5n0hfu","Type":"NodeParagraph","Properties":{"id":"20240612090546-m5n0hfu","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 辛；苦；热；小毒"}]},{"ID":"20240612090546-07xzsaj","Type":"NodeParagraph","Properties":{"id":"20240612090546-07xzsaj","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612090546-6vlyiyd","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612090546-6vlyiyd","updated":"20240612090546"},"Children":[{"ID":"20240612090546-xvrdugk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612090546-xvrdugk","updated":"20240612090546"},"Children":[{"ID":"20240612090546-dyzop8a","Type":"NodeParagraph","Properties":{"id":"20240612090546-dyzop8a","updated":"20240612090546"}}]}]},{"ID":"20240612090546-lfnigo3","Type":"NodeParagraph","Properties":{"id":"20240612090546-lfnigo3","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.《本草蒙筌》：肠虚泄者尤忌。"}]},{"ID":"20240612090546-5n8dyw5","Type":"NodeParagraph","Properties":{"id":"20240612090546-5n8dyw5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：走气，动火，昏目，发疮。"}]},{"ID":"20240612090546-ewk3117","Type":"NodeParagraph","Properties":{"id":"20240612090546-ewk3117","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：呕吐吞酸属胃火者不宜用；咳逆上气，非风寒外邪及冷痰宿水所致者不宜用；腹痛属血虚有火者不宜用；赤白下痢，因暑邪入于肠胃，而非酒食生冷、停滞积垢者不宜用；小肠疝气，非骤感寒邪及初发一、二次者不宜用；霍乱转筋，由于脾胃虚弱冒暑所致，而非寒湿生冷干犯肠胃者不宜用；一切阴虚之证及五脏六腑有热无寒之人，法所咸忌。"}]},{"ID":"20240612090546-5a4hyrf","Type":"NodeParagraph","Properties":{"id":"20240612090546-5a4hyrf","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612090546-py90tsw","Type":"NodeParagraph","Properties":{"id":"20240612090546-py90tsw","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 散寒止痛；疏肝下气；温中燥湿。主脘腹冷痛；厥阴头痛；疝痛；脚气肿痛；呕吐吞酸，寒湿泄泻"}]},{"ID":"20240612090546-a7vej4x","Type":"NodeParagraph","Properties":{"id":"20240612090546-a7vej4x","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612090546-zslb22j","Type":"NodeParagraph","Properties":{"id":"20240612090546-zslb22j","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5-5g；或入丸、散。外用：适量，研末调敷，或煎水洗。"}]},{"ID":"20240612090546-58j6bp7","Type":"NodeParagraph","Properties":{"id":"20240612090546-58j6bp7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612090546-a7hjmkv","Type":"NodeParagraph","Properties":{"id":"20240612090546-a7hjmkv","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：吴茱萸下气最速，肠虚人服之愈甚。"}]},{"ID":"20240612090546-6ajdv0k","Type":"NodeParagraph","Properties":{"id":"20240612090546-6ajdv0k","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"2.《医学启源》：《主治秘诀》云，（吴茱萸）气浮而味降，其用有四：去胸中寒一也；止心痛二也；感寒腹痛三也；消宿酒，为白豆蔻之佐四也。"}]},{"ID":"20240612090546-4jiflqz","Type":"NodeParagraph","Properties":{"id":"20240612090546-4jiflqz","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"3.王好古：冲脉为病，逆气里急，宜以（吴茱萸）主之。故仲景吴茱萸汤、当归四逆汤方治厥阴病温脾胃，皆用此也。"}]},{"ID":"20240612090546-conkdcm","Type":"NodeParagraph","Properties":{"id":"20240612090546-conkdcm","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"4.《本草纲目》：茱萸，辛热能散能温，苦热能燥能坚，故所治之证，皆取其散寒温中，燥湿解郁之功而已。咽喉口舌生疮者，以茱萸末醋调，贴两足心，移夜便愈。其性虽热，而能引热下行，盖亦从治之义，而谓茱萸之性上行不下行者，似不然也。有人治小儿痘疮口噤者，啮茱萸一、二粒抹之即开，亦取其辛散耳。"}]},{"ID":"20240612090546-r19gwxo","Type":"NodeParagraph","Properties":{"id":"20240612090546-r19gwxo","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"5.《本草经疏》：凡脾胃之气，喜温而恶寒，寒则中气不能运化，或为冷实不消，或为腹内绞痛，或寒痰停积，以致气逆发咳，五脏不利。吴茱萸，辛温暖脾胃而散寒邪，则中自温、气自下，而诸证悉除。其主除湿血痹、逐风邪者，盖以风寒湿之邪，多从脾胃而入，脾胃主肌肉，为邪所侵，则腠理闭密，而寒热诸痹所从来矣，辛温走散开发，故能使风寒湿之邪，从腠理而出。中恶腹痛，亦邪恶之气干犯脾胃所致，入脾散邪，则腹痛自止矣。"}]},{"ID":"20240612090546-prkudi7","Type":"NodeParagraph","Properties":{"id":"20240612090546-prkudi7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"6.《本草汇言》：吴茱萸，开郁化滞，逐冷降气之药也。方龙潭曰，凡患小腹、少腹阴寒之病，或呕逆恶心而吞酸吐酸，或关格痰聚而隔食隔气，或脾胃停寒而泄泻自利，或肝脾郁结而胀满逆食，或疝瘕弦气而攻引小腹，或脚气冲心而呕哕酸苦，是皆肝脾肾经之证也，吴茱萸皆可治之。"}]},{"ID":"20240612090546-mbsyepr","Type":"NodeParagraph","Properties":{"id":"20240612090546-mbsyepr","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"7.《本经逢原》：茱萸善上，故服茱萸者，有冲膈冲眼、脱发咽痛、动火发疮之害。其治暴注下重、呕逆吞酸、肝脾火逆之证，必兼苦寒以降之，如左金丸治肝火痰运嘈杂最效。"}]},{"ID":"20240612090546-1eh1i1r","Type":"NodeParagraph","Properties":{"id":"20240612090546-1eh1i1r","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"8.《本草便读》：吴茱萸，辛苦而温，芳香而燥，本为肝之主药，而兼入脾胃者，以脾喜香燥，胃喜降下也。其性下气最速，极能宣散郁结，故治肝气郁滞，寒浊下踞，以致腹痛疝瘕等疾，或病邪下行极而上，乃为呕吐吞酸胸满诸病，均可治之。即其辛苦香燥之性，概可想见其功。然则治肝治胃以及中下寒湿滞浊，无不相宜耳。"}]},{"ID":"20240612090546-d714qj5","Type":"NodeParagraph","Properties":{"id":"20240612090546-d714qj5","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"9.《神农本草经》：主温中下气，止痛，咳逆寒热，除湿血痹，逐风邪，开腠理。"}]},{"ID":"20240612090546-k79jq33","Type":"NodeParagraph","Properties":{"id":"20240612090546-k79jq33","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"10.《名医别录》：主痰冷，腹内绞痛，诸冷实不消，中恶，心腹痛，逆气，利五脏。"}]},{"ID":"20240612090546-o33nvi7","Type":"NodeParagraph","Properties":{"id":"20240612090546-o33nvi7","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"11.《药性论》：主心腹疾，积冷，心下结气，疰心痛；治霍乱转筋，胃中冷气，吐泻腹痛不可胜忍者；疗遍身顽痹，冷食不消，利大肠拥气。"}]},{"ID":"20240612090546-gojkvkn","Type":"NodeParagraph","Properties":{"id":"20240612090546-gojkvkn","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"12.《本草拾遗》：杀恶虫毒，牙齿虫蛀。"}]},{"ID":"20240612090546-0iu1ix4","Type":"NodeParagraph","Properties":{"id":"20240612090546-0iu1ix4","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"13.《日华子本草》：健脾通关节。治腹痛，肾气，脚气，水肿，下产后余血。"}]},{"ID":"20240612090546-28clasz","Type":"NodeParagraph","Properties":{"id":"20240612090546-28clasz","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"14.王好古：治痞满塞胸，咽膈不通，润肝燥脾。"}]},{"ID":"20240612090546-ksoz6hl","Type":"NodeParagraph","Properties":{"id":"20240612090546-ksoz6hl","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"15.《本草纲目》：开郁化滞。治吞酸，厥阴痰涎头痛，阴毒腹痛，疝气，血痢，喉舌口疮。"}]},{"ID":"20240612090546-s43jpt6","Type":"NodeParagraph","Properties":{"id":"20240612090546-s43jpt6","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612090546-v1looyg","Type":"NodeParagraph","Properties":{"id":"20240612090546-v1looyg","updated":"20240612090546"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612090547-2nu7t7x","Type":"NodeThematicBreak","Properties":{"id":"20240612090547-2nu7t7x"}},{"ID":"20240612090548-4rg8u5p","Type":"NodeParagraph","Properties":{"id":"20240612090548-4rg8u5p"}}]}