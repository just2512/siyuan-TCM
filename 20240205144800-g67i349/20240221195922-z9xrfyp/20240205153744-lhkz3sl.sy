"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽泻 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽泻 12-20240802162943-u8haxrb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 773px;\" parent-style=\"width: 783px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 434px;","style":"width: 424px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽泻 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽泻 11-20240802162839-x45nivu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 424px;\" parent-style=\"width: 434px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240802163716-4rhl8fz","Type":"NodeParagraph","Properties":{"id":"20240802163716-4rhl8fz","updated":"20240802163746"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 587px;","style":"width: 577px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽泻 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽泻 17-20240802163716-i3mttqd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 577px;\" parent-style=\"width: 587px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 710px;","style":"width: 700px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽泻 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽泻 14-20240802163118-1gn8m2v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 700px;\" parent-style=\"width: 710px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616101151-i44ezdy","Type":"NodeThematicBreak","Properties":{"id":"20240616101151-i44ezdy"}},{"ID":"20240616101218-o6f6neg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101218-o6f6neg","updated":"20240616101222"},"Children":[{"Type":"NodeText","Data":"泽泻《神农本草经》"}]},{"ID":"20240616101218-ccuqaft","Type":"NodeParagraph","Properties":{"id":"20240616101218-ccuqaft","updated":"20240616101218"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240616101218-4ifqkq4","Type":"NodeParagraph","Properties":{"id":"20240616101218-4ifqkq4","updated":"20240616101218"},"Children":[{"Type":"NodeText","Data":"主风寒湿痹，乳难消水，养五脏，益气力，肥健。久服耳目聪明，不饥，延年轻身，面生光，能行水上。一名水泻，一名芒芋，一名鹄泻。生池泽。"}]},{"ID":"20240616101218-8xgwl31","Type":"NodeParagraph","Properties":{"id":"20240616101218-8xgwl31","updated":"20240616101218"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汝南，五六八月采根，阴干。"}]},{"ID":"20240616101218-xra7eci","Type":"NodeParagraph","Properties":{"id":"20240616101218-xra7eci","updated":"20240616101218"},"Children":[{"Type":"NodeText","Data":"案《说文》云：水写也；《尔雅》云：蕍舄；郭璞云：今泽舄，又，牛肤；郭璞云，《毛诗》《传》云：水舄也，如续断，寸寸有节，拔之可复《毛诗》云，言采其藚，《传》云，藚，水舄也；陆玑云：今泽舄也，其叶如车前草大，其味亦相似，徐州广陵人食之。"}]},{"ID":"20240616101601-n8p22fa","Type":"NodeThematicBreak","Properties":{"id":"20240616101601-n8p22fa"}},{"ID":"20240616101602-6ai9d7z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101602-6ai9d7z","updated":"20240616101606"},"Children":[{"Type":"NodeText","Data":"泽泻《长沙药解》"}]},{"ID":"20240616101602-db0s8av","Type":"NodeParagraph","Properties":{"id":"20240616101602-db0s8av","updated":"20240616101602"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味甘寒。主风寒湿痹，乳难消水，养五脏，益气力，肥健。久服耳目聪明，不饥，延年轻身，面生光，能行水上。一名水泻，一名芒芋，一名鹄泻。生池泽。"}]},{"ID":"20240616101602-3lay01s","Type":"NodeParagraph","Properties":{"id":"20240616101602-3lay01s","updated":"20240616101602"},"Children":[{"Type":"NodeText","Data":"味咸，微寒，入足少阴肾、足太阳膀胱经。燥土泻湿，利水通淋，除饮家之眩冒，疗湿病之燥渴，气鼓水胀皆灵，膈噎反胃俱效。"}]},{"ID":"20240616101602-6x283zq","Type":"NodeParagraph","Properties":{"id":"20240616101602-6x283zq","updated":"20240616101602"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽泻汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"泽泻五两，白术二两。"},{"Type":"NodeText","Data":"治心下有支饮，其人苦冒眩者。以饮在心下，阻隔阳气下降之路。阳不根阴，升浮旋转，故神气昏冒而眩晕。此缘土湿不能制水，故支饮上泛。泽泻泻其水，白术燥其土也。"}]},{"ID":"20240616101602-wmgebba","Type":"NodeParagraph","Properties":{"id":"20240616101602-wmgebba","updated":"20240616101602"},"Children":[{"Type":"NodeText","Data":"泽泻咸寒渗利，走水府而开闭癃，较之二苓淡渗，更为迅速。五苓、八味、茯苓、泽泻、当归、芍药诸方皆用之，取其下达之速，善决水窦，以泻土湿也。"}]},{"ID":"20240616101633-qlx2uvb","Type":"NodeThematicBreak","Properties":{"id":"20240616101633-qlx2uvb"}},{"ID":"20240616101634-8ow6qb5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101634-8ow6qb5","updated":"20240616101638"},"Children":[{"Type":"NodeText","Data":"泽泻《本草分经》"}]},{"ID":"20240616101634-jua48mt","Type":"NodeParagraph","Properties":{"id":"20240616101634-jua48mt","updated":"20240616101634"},"Children":[{"Type":"NodeText","Data":"甘咸微寒，泻膀胱及肾经火邪，利小便，功专利湿行水，治一切湿热之病，湿热除则清气上行，故又止头旋，能损目。"}]},{"ID":"20240616101729-94vzp47","Type":"NodeThematicBreak","Properties":{"id":"20240616101729-94vzp47"}},{"ID":"20240616101730-nm35mew","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101730-nm35mew","updated":"20240616101741"},"Children":[{"Type":"NodeText","Data":"泽泻《本草经集注》"}]},{"ID":"20240616101730-1ion2ls","Type":"NodeParagraph","Properties":{"id":"20240616101730-1ion2ls","updated":"20240616101730"},"Children":[{"Type":"NodeText","Data":"味甘、咸，寒，无毒。主治风寒湿痹，乳难，消水，养五脏，益气力，肥健。补虚损五劳，除五脏痞满，起阴气，止泄精、消渴、淋沥，逐膀胱三焦停水。久服耳目聪明，不饥，延年，轻身，面生光，能行水上。扁鹊云∶多服病患眼。一名水泻，一名及泻，一名芒芋，一名鹄泻。生汝南池泽。五月、六月、八月采根，阴干。畏海蛤、文蛤。叶，味咸，无毒。"}]},{"ID":"20240616101730-sjc45o1","Type":"NodeParagraph","Properties":{"id":"20240616101730-sjc45o1","updated":"20240616101730"},"Children":[{"Type":"NodeText","Data":"主大风，乳汁不出，产难，强阴气。久服轻身。五月采。实，味甘，无毒。主风痹，消渴，益肾气，强阴，补不足，除邪湿。久服面生光，令人无子。九月采。"}]},{"ID":"20240616101730-341stmb","Type":"NodeParagraph","Properties":{"id":"20240616101730-341stmb","updated":"20240616101730"},"Children":[{"Type":"NodeText","Data":"汝南郡属豫州。今近道亦有，不堪用。惟用汉中、南郑、青、代，形大而长，尾间必有两歧为好。此物易朽蠹，常须密藏之。叶狭长，丛生诸浅水中。《仙经》服食断谷皆用之。"}]},{"ID":"20240616101730-mtm5ohk","Type":"NodeParagraph","Properties":{"id":"20240616101730-mtm5ohk","updated":"20240616101730"},"Children":[{"Type":"NodeText","Data":"亦云身轻，能步行水上。"}]},{"ID":"20240616101718-nnbmk3r","Type":"NodeThematicBreak","Properties":{"id":"20240616101718-nnbmk3r"}},{"ID":"20240616101719-sb87cvn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101719-sb87cvn","updated":"20240616101724"},"Children":[{"Type":"NodeText","Data":"泽泻《医学入门》"}]},{"ID":"20240616101719-vvsgvf0","Type":"NodeParagraph","Properties":{"id":"20240616101719-vvsgvf0","updated":"20240616101719"},"Children":[{"Type":"NodeText","Data":"泽泻甘咸泻水浮，止渴泄善通淋溲，治痞除痹肾风疥，下乳催亦可求。"}]},{"ID":"20240616101719-izi1s92","Type":"NodeParagraph","Properties":{"id":"20240616101719-izi1s92","updated":"20240616101719"},"Children":[{"Type":"NodeText","Data":"生汝南池泽，性能泻水。气寒，无毒。沉而降，阳中阴也。入足太阳、少阴经。逐三焦膀胱停水留垢，伐肾邪水，分利小水之捷药也。故曰∶水病湿肿灵丹，小便淋涩仙药。止烦渴、泻痢，除五脏痞满，风寒湿痹，肾脏风疮，通血脉，下乳难，催生，补女人血海，令有子，皆湿热凝滞病也。扁鹊云∶多服令人眼病。丹溪云∶眼中有水属膀胱，渗利太过则水涸而火上盛，故眼病也。仲景八味丸用之，亦不过接引桂、附归肾耳。诸书云∶止阴汗，生新水，补虚损，补阴不足，止泄精，为正剂，非也。凡淋渴，水肿，肾虚所致者亦不可用。形大而长，尾有两歧者佳。去芦酒浸一宿，日干。畏海蛤、文蛤。叶，主大风，乳汁不出，产难，强阴气。实，主风痹，消渴，除邪湿，益肾强阴，久服令无子。"}]},{"ID":"20240616101708-s0xouet","Type":"NodeThematicBreak","Properties":{"id":"20240616101708-s0xouet"}},{"ID":"20240616101709-l017p4g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101709-l017p4g","updated":"20240616101713"},"Children":[{"Type":"NodeText","Data":"泽泻《本草经解》"}]},{"ID":"20240616101709-8acj6n5","Type":"NodeParagraph","Properties":{"id":"20240616101709-8acj6n5","updated":"20240616101709"},"Children":[{"Type":"NodeText","Data":"气寒．味甘．无毒．主风寒湿痹．乳难．养五脏．益气力．肥健．消水．久服耳目聪明．不饥．延年轻身．面生光．能行水上．泽泻气寒．禀天冬寒之水气．入足太阳寒水膀胱经．味甘无毒．得地中正之土味．入足太阴脾经．气降味和．阴也．其主风寒湿痹者．风寒湿三者合而成痹．痹则血闭而肌肉麻木也．泽泻味甘益脾．脾湿去．则血行而肌肉活．痹症瘳矣．其主乳难者．脾统血．血不化．乳所以难也．味甘益脾．脾湿行则血运而乳通也．其主养五脏益气力肥健者．盖五脏藏阴者也．而脾为之原．脾主肌肉而性恶湿．泽泻泻湿．湿去则脾健．脾乃后天之本．所以肌肉长而气力益．阴血充而五脏得所养也．其消水者．入膀胱气寒下泄也．久服耳目聪明．不饥．延年轻身者．肾与膀胱为表里．膀胱水道通．则肾之精道固．精足则气充．肾开窍于耳．所以耳聪．水之精为目瞳子．所以明目．肾者胃之关．关门固所以不饥．肾气纳．所以延年轻身也．其言面生光能行水上者．脾为湿土．湿则重．燥则轻．轻则能行水上．脾统血．血充则面有光彩也．盖表其利水有固肾之功．燥湿有健脾之效也．"}]},{"ID":"20240616101709-v74geu3","Type":"NodeParagraph","Properties":{"id":"20240616101709-v74geu3","updated":"20240616101709"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616101709-02vlzfc","Type":"NodeParagraph","Properties":{"id":"20240616101709-02vlzfc","updated":"20240616101709"},"Children":[{"Type":"NodeText","Data":"泽泻同白茯、白术、猪苓、肉桂．名五苓散．治湿热．同山药、山萸、白茯、丹皮、生地、北味．名都气汤．补肾真阴．及小儿行语迟．同白茯、建兰叶、猪苓．治饮痰咳嗽．"}]},{"ID":"20240616101657-ifemxkf","Type":"NodeThematicBreak","Properties":{"id":"20240616101657-ifemxkf"}},{"ID":"20240616101658-isxz79g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101658-isxz79g","updated":"20240616101703"},"Children":[{"Type":"NodeText","Data":"泽泻《本草备要》"}]},{"ID":"20240616101658-mpinyd5","Type":"NodeParagraph","Properties":{"id":"20240616101658-mpinyd5","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"通，利水，泻膀胱火"}]},{"ID":"20240616101658-ilknpbw","Type":"NodeParagraph","Properties":{"id":"20240616101658-ilknpbw","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"甘淡微咸。入膀胱，利小便，泻肾经之火邪，功专利湿行水。"}]},{"ID":"20240616101658-qn2l3gl","Type":"NodeParagraph","Properties":{"id":"20240616101658-qn2l3gl","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"治消渴痰饮，呕吐泻痢，肿胀水痞，香港脚疝痛，淋沥阴汗（阴间有汗），尿血泄精（既利水而又止泄精，何也？此乃湿热为病。不为虚滑者言也，虚滑则当用补涩之药），湿热之病。"}]},{"ID":"20240616101658-o5ftn7h","Type":"NodeParagraph","Properties":{"id":"20240616101658-o5ftn7h","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"湿热既除，则清气上行。又能养五脏，益气力，起阴气，补虚损，止头旋，有聪耳、明目之功（脾胃有湿热，则头重耳鸣目昏。渗去其湿，则热亦随去，土乃得令，而精气上行。"}]},{"ID":"20240616101658-lyow8pq","Type":"NodeParagraph","Properties":{"id":"20240616101658-lyow8pq","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"故《本经》列之上品，云聪耳明目，而六味丸用之，今人多以昏目疑之）。多服昏目（小便过利，而肾水虚故也。眼中有水，属膀胱，过利则水涸而火生。张仲景八味丸用泽泻，寇宗谓其接引桂附入肾经。李时珍曰∶非接引也，乃取其泻膀胱之邪气也。古人用补药，必兼泻邪，邪去则补药得力，一阖一辟，此乃玄妙。后人不知此理，专一于补，必致偏胜之患矣。"}]},{"ID":"20240616101658-g6tgd2r","Type":"NodeParagraph","Properties":{"id":"20240616101658-g6tgd2r","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"王履曰∶地黄、山茱、茯苓、丹皮，皆肾经药，桂、附右肾命门之药，何待接引乎？钱仲阳谓∶肾为真水，有补无泻。或云脾虚肾旺，故泻肾扶脾，不知肾之真水不可泻，泻其伏留之邪耳！脾喜燥，肾恶燥，故兼补为难。易老云∶去脬中留垢，以其微咸能泻伏水故也。昂按∶六味丸有熟地之温，丹皮之凉，山药之涩，茯苓之渗，山茱之收，泽泻之泻。补肾而兼补脾，有补而必有泻，相和相济，以成平补之功，乃平淡之神奇，所以为古今不易之良方也。即有加减，或加紫河车一具，或五味、麦冬、杜仲、牛膝之类，不过一二味，极三四味而止。今人或疑泽泻之泻而减之，多拣本草补药，恣意加入，有补无泻。且客倍于主，责成不专，而六味之功，且退处于虚位，失制方配合之本旨矣，此近世庸师之误也）。"}]},{"ID":"20240616101658-8qt05b8","Type":"NodeParagraph","Properties":{"id":"20240616101658-8qt05b8","updated":"20240616101658"},"Children":[{"Type":"NodeText","Data":"盐水拌，或酒浸用。忌铁。"}]},{"ID":"20240616101646-kypoqwl","Type":"NodeThematicBreak","Properties":{"id":"20240616101646-kypoqwl"}},{"ID":"20240616101647-ikuorh5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101647-ikuorh5","updated":"20240616101652"},"Children":[{"Type":"NodeText","Data":"泽泻《雷公炮制药性解》"}]},{"ID":"20240616101647-rqe6aix","Type":"NodeParagraph","Properties":{"id":"20240616101647-rqe6aix","updated":"20240616101647"},"Children":[{"Type":"NodeText","Data":"味甘咸，性寒无毒，入膀胱肾三焦小肠四经。主去胞垢，退阴汗，治小便淋涩仙药，疗水病湿肿灵丹。畏海蛤，文蛤，色白者佳。"}]},{"ID":"20240616101647-emyq7da","Type":"NodeParagraph","Properties":{"id":"20240616101647-emyq7da","updated":"20240616101647"},"Children":[{"Type":"NodeText","Data":"按∶泽泻下降为阴，专主渗泄，宜入膀胱诸经，其行水之功，过于猪苓。《衍义》曰∶小便既多，肾气焉得复实。扁鹊曰；多服病患眼。《药性》曰∶令人面光无子，乃本草称其补虚明目治泄精消渴，《珍囊》注其生新水止虚烦，恐无是理。即六味丸中用之，以其渗去脾湿，退命门火为向导尔。又《药性赋》云∶补阴不足，盖以补阴之功不足也。后世不察，谓其可以补阴分之不足，大失本旨。"}]},{"ID":"20240616101647-z4qvmqn","Type":"NodeParagraph","Properties":{"id":"20240616101647-z4qvmqn","updated":"20240616101647"},"Children":[{"Type":"NodeText","Data":"扁鹊云∶多服病患眼，一名水泻，一名及泻，一名芒芋，一名鹄泻。生汝南汝泽，五月八月，采根阴干。实味，甘无毒，主风痹消渴，益肾气。强阴补不足，除邪湿，久服面生光，令人无子，九月采。"}]},{"ID":"20240616101647-codd9e7","Type":"NodeParagraph","Properties":{"id":"20240616101647-codd9e7","updated":"20240616101647"},"Children":[{"Type":"NodeText","Data":"雷公云∶不拘多少，细锉，酒浸一宿，漉出曝干任用也。叶味咸无毒，主大风，乳汁不出，产难，强阴气，五月采。"}]},{"ID":"20240616101616-yiuxx3i","Type":"NodeThematicBreak","Properties":{"id":"20240616101616-yiuxx3i"}},{"ID":"20240616101617-tj5ao8v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101617-tj5ao8v","updated":"20240616101627"},"Children":[{"Type":"NodeText","Data":"泽泻《本草新编》"}]},{"ID":"20240616101617-tvamfyq","Type":"NodeParagraph","Properties":{"id":"20240616101617-tvamfyq","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"泽泻，味甘、酸、微咸，气寒，沉而降，阴中微阳，无毒。入太阳、少阳足经，能入肾。"}]},{"ID":"20240616101617-6e9ykz5","Type":"NodeParagraph","Properties":{"id":"20240616101617-6e9ykz5","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"长于利水，去阴汗，利小便如神，除湿去渴之仙丹也。"}]},{"ID":"20240616101617-k70ss9o","Type":"NodeParagraph","Properties":{"id":"20240616101617-k70ss9o","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或问泽泻，既是利水消湿之物，宜乎水去湿干，津液自少，胡为反能止渴？岂知泽泻不独利水消湿，原善滋阴。如肾中有水湿之气，乃所食水谷不化精而化火，此火非命门之真火，乃湿热之邪火。邪火不去，则真火不生，真火不生，乃真水不生也。泽泻善泻肾中邪火，泻邪火，即所以补真水也。苟非补肾火，六味丸中，仲景夫子何以用泽泻耶？夫肾有补无泻，泽泻补肾，非泻肾，断断无差。不然，何以泻水而口不渴，非泻邪水耶？所以生真水之明验乎。所以五苓散利膀胱，而津液自润也。"}]},{"ID":"20240616101617-otiz65j","Type":"NodeParagraph","Properties":{"id":"20240616101617-otiz65j","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或曰泽泻泻中有补，敬闻命矣，然所泻者水而非火，吾子之谓是泻火，不亦异乎？盖泻火而不泻水，是有说焉。膀胱者，太阳之腑也，原属火，不属水。膀胱之水不能下通，本于寒者少，由于热者多。盖膀胱无火乃水闭，有火又水闭也。泽泻用之于五苓散中，虽泻水，实泻火也，因其为泻火之味，所以用之出奇。不然，二苓、白术泻水有余，又何必借重泽泻乎。"}]},{"ID":"20240616101617-gqyalk2","Type":"NodeParagraph","Properties":{"id":"20240616101617-gqyalk2","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"此泻火之确有至理，人未之思耳。"}]},{"ID":"20240616101617-puegz63","Type":"NodeParagraph","Properties":{"id":"20240616101617-puegz63","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或问泽泻利多补少，而子必曰补，想因仲景张公用之于六味丸中，故曰泽泻利中有补。"}]},{"ID":"20240616101617-cbumza6","Type":"NodeParagraph","Properties":{"id":"20240616101617-cbumza6","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"不独六味丸中为然，即五苓散中用之，何独不然，凡小便不利之人，未有口不渴者，一利小便而口渴解。五苓散，利小便也。利小便口渴解者，口中生津液也。五苓利小便之水，去则无水以润口，宜其渴矣，乃不渴，而反生津液，非利中有补之明验乎？且小便之所以不利者，以膀胱之有邪火。膀胱有火，乃热干津液而口渴。泽泻在五苓散中，逐邪火而存真水，火去乃水自升，水升乃津液自润，津液润，而灌注于肾宫。谁谓泽泻有泻而无补乎。"}]},{"ID":"20240616101617-egiuyvh","Type":"NodeParagraph","Properties":{"id":"20240616101617-egiuyvh","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或问泽泻用于六味丸中，乃泻中有补，不识用于八味丸中何意？曰∶有深意也。夫肾中无火，故用八味地黄丸，于水中补火也。然而火性炎上，不用药以引其下行，乃龙雷之火未必不随火而沸腾。而用下行之药，但有泻无补，又恐补火，而火仍随水而下泄，又复徒然。使下行，但有补无泻，又恐补火，而火不随水而下泄，乃补火大旺，必有强阳不倒之虞。妙在泽泻性既利水，而泻中又复有补，引火下行，泻火之有余，而不损火之不足，辅桂、附以成其既济之功，谁谓仲景公用泽泻于八味丸中，竟漫无妙义哉。"}]},{"ID":"20240616101617-97017zf","Type":"NodeParagraph","Properties":{"id":"20240616101617-97017zf","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或问泽泻举世皆以为泻，先生独言泻中有补，且各尽宣其异义，不识八味、六味、五苓之外，更有何说以广鄙见乎？夫泽泻之义，于三方可悟其微，三方最未尽其妙。泽泻不特泻火之有余，而且泻水之有余；不特不损火之不足，而且不损水之不足。此泻中有补，前文尽宣。"}]},{"ID":"20240616101617-cb9f0po","Type":"NodeParagraph","Properties":{"id":"20240616101617-cb9f0po","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"然而，功不止此。泽泻更能入于水之中，以补火之不足；入于火之中，以泻水之有余。虚寒之人，夜多遗溺，此火之不足也，势必用益智仁、山茱萸、五味子之类，补以收涩其遗矣。"}]},{"ID":"20240616101617-r9crfon","Type":"NodeParagraph","Properties":{"id":"20240616101617-r9crfon","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"然徒用酸收之味，不加咸甘之品于其中，乃愈涩而愈遗，泽泻正咸甘之味也。入于益智、山茱萸、五味子之内，遗溺顿痊。若非利中补火，不更助其遗乎？虚热之人，口必大渴，此水之不足也，势必用元参、生地黄、沙参、地骨皮、甘菊之类泻火，滋润其渴矣。然徒用苦寒之味，不加甘咸之品于其中，乃愈止而愈渴。泽泻正甘咸之味也，入之于元参、生地、沙参、地骨皮、菊花之内，口渴自愈。若非利中补水，不益增其渴乎？此泽泻之微义又如此矣。"}]},{"ID":"20240616101617-vsiaqo3","Type":"NodeParagraph","Properties":{"id":"20240616101617-vsiaqo3","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或疑泽泻有功有过，但言其功，而不言其过，恐非持论之平。不知泽泻利水，单用乃有功有过，共用乃少过多功。盖单用可以泻水盛之人，不可以泻水虚之子，泻水盛乃有功，泻水虚乃有过也。共用宜于补剂，不宜于攻剂，补虚乃多功，攻实乃少过也。有过有功，是人之不善用也，与泽泻何过哉。"}]},{"ID":"20240616101617-znssdmb","Type":"NodeParagraph","Properties":{"id":"20240616101617-znssdmb","updated":"20240616101617"},"Children":[{"Type":"NodeText","Data":"或问扁鹊公云多服泽泻，病患服是泽泻，过于利水，非补阴之药矣？此非扁鹊公之言，乃后人记而传之者也。泽泻用之六味、八味诸肾药中，但补而无泻，多服、久服，正得大益，又安能损目哉。惟肾气乏绝，阳衰流精，肾气不固，精滑目痛，不可单服泽泻，以虚其虚，若入于群补肾药中，又正无害也。"}]},{"ID":"20240616101549-g6fu572","Type":"NodeThematicBreak","Properties":{"id":"20240616101549-g6fu572"}},{"ID":"20240616101550-hvffg6x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101550-hvffg6x","updated":"20240616101554"},"Children":[{"Type":"NodeText","Data":"泽泻《本草衍义》"}]},{"ID":"20240616101550-uj6ji2i","Type":"NodeParagraph","Properties":{"id":"20240616101550-uj6ji2i","updated":"20240616101550"},"Children":[{"Type":"NodeText","Data":"泽泻，其功尤长于行水。张仲景曰∶水搐渴烦，小便不利，或吐或泻，五苓散主之。"}]},{"ID":"20240616101550-jg0ynch","Type":"NodeParagraph","Properties":{"id":"20240616101550-jg0ynch","updated":"20240616101550"},"Children":[{"Type":"NodeText","Data":"方用泽泻，故知其用长于行水。《本经》又引扁鹊云“多服，病患眼”，诚为行去其水。张仲景八味丸用之者，亦不过引接桂、附等归就肾经，别无他意。凡服泽泻散人，未有不小便多者。小便既多，肾气焉得复实？今人止泄精，多不敢用。"}]},{"ID":"20240616101537-kkztr29","Type":"NodeThematicBreak","Properties":{"id":"20240616101537-kkztr29"}},{"ID":"20240616101538-69c3db7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101538-69c3db7","updated":"20240616101543"},"Children":[{"Type":"NodeText","Data":"泽泻《名医别录》"}]},{"ID":"20240616101538-tz98ro1","Type":"NodeParagraph","Properties":{"id":"20240616101538-tz98ro1","updated":"20240616101538"},"Children":[{"Type":"NodeText","Data":"味咸，无毒．主补虚损、五劳，除五脏痞满，起阴气，止泄精、消渴、淋沥，逐膀焦停水．扁鹊云∶“多服病患眼．”一名及泻．生汝南．五月、六月、八月采根，阴干海蛤、文蛤．）"}]},{"ID":"20240616101241-mlchv7u","Type":"NodeThematicBreak","Properties":{"id":"20240616101241-mlchv7u"}},{"ID":"20240616101242-s4qkfej","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101242-s4qkfej","updated":"20240616101246"},"Children":[{"Type":"NodeText","Data":"泽泻《新修本草》"}]},{"ID":"20240616101242-nok1c2j","Type":"NodeParagraph","Properties":{"id":"20240616101242-nok1c2j","updated":"20240616101242"},"Children":[{"Type":"NodeText","Data":"味甘、咸，寒，无毒。主风寒湿痹，乳难，消水，养五脏，益气力，肥健。补虚损五劳，除泄精、消渴、淋沥，逐膀胱三焦停水。久服耳目聪明，不饥，延年，轻身，面生光，能行水上。扁鹊云∶多服病患眼。一名水泻，一名及泻，一名芒芋，一名鹄泻。生汝南池泽。五月、六月、八月采根，阴干。畏海蛤文蛤。叶，味咸，无毒。主大风，乳汁不出，产难，强阴气，久服轻身。五月采。实，味甘，无毒。主风痹、消渴，益肾气，强阴，补不足，除邪湿。久服面生光，令人无子。九月采。"}]},{"ID":"20240616101242-gyrbo6a","Type":"NodeParagraph","Properties":{"id":"20240616101242-gyrbo6a","updated":"20240616101242"},"Children":[{"Type":"NodeText","Data":"汝南郡属豫州。今近道亦有，不堪用。惟用汉中、南郑、青弋，形大而长，尾间必有两歧为好。此物易朽蠹，常须密藏之。叶狭长，丛生诸浅水中。《仙经》服食断谷皆用之。亦云身轻，能步行水上。"}]},{"ID":"20240616101242-jd6z9yl","Type":"NodeParagraph","Properties":{"id":"20240616101242-jd6z9yl","updated":"20240616101242"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240616101242-ssos5er","Type":"NodeParagraph","Properties":{"id":"20240616101242-ssos5er","updated":"20240616101242"},"Children":[{"Type":"NodeText","Data":"今汝南不复采用，惟以泾州、华州者为善也。"}]},{"ID":"20240616101433-c7phpb5","Type":"NodeThematicBreak","Properties":{"id":"20240616101433-c7phpb5"}},{"ID":"20240616101434-c7xj8f6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101434-c7xj8f6","updated":"20240616101439"},"Children":[{"Type":"NodeText","Data":"泽泻《神农本草经读》"}]},{"ID":"20240616101434-nwsqmeq","Type":"NodeParagraph","Properties":{"id":"20240616101434-nwsqmeq","updated":"20240616101434"},"Children":[{"Type":"NodeText","Data":"气味甘、寒，无毒。主风寒湿痹，乳难，养五脏，益气力，肥健，消水。久服耳目聪明，不饥，延年，轻身，面生光，能行水上。"}]},{"ID":"20240616101434-70dxnvx","Type":"NodeParagraph","Properties":{"id":"20240616101434-70dxnvx","updated":"20240616101508"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶泽泻气寒，水之气也；味甘无毒，土之味也。生于水而上升，能启水阴之气上滋中土也。其主风、寒、湿痹者，三气以湿为主，此能启水气上行而复下，其痹即从水气而化矣。其主乳难者，能滋水精于中土而为汁也。其主“养五脏，益气力，肥健”等句，以五脏主藏阴，而脾为五脏之原，一得水精之气则能灌溉四旁，俾五脏循环而受益，不特肥健消水不饥，见本脏之功；而肺得水精之气而气益，肾得水精之气而耳聪，且形得水精之气而全体轻，色得水精之气而面生光辉，一生得水精之气而延年，所以然者，久服之功。能行在下之水而使之园，一茎直上，无下行之性，故其功效如此。今人以盐水拌炒，则反掣其肘矣。"}]},{"ID":"20240616101524-p07o8jx","Type":"NodeThematicBreak","Properties":{"id":"20240616101524-p07o8jx"}},{"ID":"20240616101526-8iidsio","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101526-8iidsio","updated":"20240616101532"},"Children":[{"Type":"NodeText","Data":"泽泻《增广和剂局方药性总论》"}]},{"ID":"20240616101526-2tf1equ","Type":"NodeParagraph","Properties":{"id":"20240616101526-2tf1equ","updated":"20240616101526"},"Children":[{"Type":"NodeText","Data":"味甘咸，寒，无毒。主风寒湿痹，乳难，消水，养五脏，益气力，肥健，补虚损五劳除五脏痞满，起阴气，止泄精，消渴，淋沥，逐膀胱、三焦停水。叶∶味咸，无毒。主大乳汁不出，产难，强阴气。实∶味甘，无毒。主风痹，消渴，益肾气，强阴，补不足，气。《药性论》云，味苦。能主肾虚精自出，治五淋，利膀胱热，宣通水道。日华子云五劳七伤，主头旋，耳虚鸣，筋骨挛缩，通小肠，止遗沥，尿血，催生，难产，补女人令人有子。叶∶壮水脏，下乳，通血脉。畏∶海蛤、文蛤。"}]},{"ID":"20240616101514-moe65r8","Type":"NodeThematicBreak","Properties":{"id":"20240616101514-moe65r8"}},{"ID":"20240616101515-8wk0ulk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101515-8wk0ulk","updated":"20240616101519"},"Children":[{"Type":"NodeText","Data":"泽泻《本草纲目》"}]},{"ID":"20240616101515-7k5afed","Type":"NodeParagraph","Properties":{"id":"20240616101515-7k5afed","updated":"20240616101515"},"Children":[{"Type":"NodeText","Data":"「释名」水泻、鹄泻、及泻、渝、芒芋、禹孙。"}]},{"ID":"20240616101515-epf71j1","Type":"NodeParagraph","Properties":{"id":"20240616101515-epf71j1","updated":"20240616101515"},"Children":[{"Type":"NodeText","Data":"「气味」（根）甘、寒、无毒。"}]},{"ID":"20240616101515-7s1y4wt","Type":"NodeParagraph","Properties":{"id":"20240616101515-7s1y4wt","updated":"20240616101515"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616101515-5b2tygk","Type":"NodeParagraph","Properties":{"id":"20240616101515-5b2tygk","updated":"20240616101515"},"Children":[{"Type":"NodeText","Data":"1、水湿肿胀。用白术、泽泻各一两，做成丸子。每服三钱，茯苓汤送下。"}]},{"ID":"20240616101515-cyy5yqk","Type":"NodeParagraph","Properties":{"id":"20240616101515-cyy5yqk","updated":"20240616101515"},"Children":[{"Type":"NodeText","Data":"2、暑天吐泻（头晕，渴饮，小便不利）。用泽泻、白术，白茯苓各三钱，加水一碗、姜五片、类灯心十根，煎至八成，温服。"}]},{"ID":"20240616101446-mnphvt4","Type":"NodeThematicBreak","Properties":{"id":"20240616101446-mnphvt4"}},{"ID":"20240616101448-fqvoacz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101448-fqvoacz","updated":"20240616101456"},"Children":[{"Type":"NodeText","Data":"泽泻《神农本草经百种录》"}]},{"ID":"20240616101448-r5wvczf","Type":"NodeParagraph","Properties":{"id":"20240616101448-r5wvczf","updated":"20240616101448"},"Children":[{"Type":"NodeText","Data":"味甘寒。主风寒湿痹，凡挟水气之疾，皆能除之。乳难，乳亦水，利故能通乳也。"}]},{"ID":"20240616101448-60n4fgi","Type":"NodeParagraph","Properties":{"id":"20240616101448-60n4fgi","updated":"20240616101448"},"Children":[{"Type":"NodeText","Data":"消水，使水归于膀胱。养五脏，益气力，水气除则脏安而气生也。肥健。脾恶湿，脾气燥，则肌肉充而肥健也。久服，耳目聪明，不饥，延年轻身，面生光，皆涤水除湿之功。能行水上。水气尽，则身轻而入水不没矣。"}]},{"ID":"20240616101448-tt8a6q6","Type":"NodeParagraph","Properties":{"id":"20240616101448-tt8a6q6","updated":"20240616101448"},"Children":[{"Type":"NodeText","Data":"泽泻乃通利脾胃之药，以其淡渗能利土中之水，水去则土燥而气充，脾恶湿故也。但气湿必自膀胱而出，泽泻能下达膀胱，故又为膀胱之药。"}]},{"ID":"20240616101448-3bfbq3u","Type":"NodeParagraph","Properties":{"id":"20240616101448-3bfbq3u","updated":"20240616101448"},"Children":[{"Type":"NodeText","Data":"味苦温。主咳逆，气滞之咳。伤中，补不足，心主荣，荣气顺则中焦自足。除邪气，利九窍，辛香疏达，则能辟秽通窍也。益智慧，耳目聪明，不忘，强志，心气通则精足神全矣。倍力。心气盛则脾气亦强，而力生也。久服，轻身不老。气和之效。"}]},{"ID":"20240616101448-f8yi7ld","Type":"NodeParagraph","Properties":{"id":"20240616101448-f8yi7ld","updated":"20240616101448"},"Children":[{"Type":"NodeText","Data":"远志气味苦辛，而芳香清烈，无微不达，故为心家气分之药。心火能生脾土，心气盛，则脾气亦和，故又能益中焦之气也。"}]},{"ID":"20240616101345-8fgdzkn","Type":"NodeThematicBreak","Properties":{"id":"20240616101345-8fgdzkn"}},{"ID":"20240616101346-d6nlril","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101346-d6nlril","updated":"20240616101352"},"Children":[{"Type":"NodeText","Data":"泽泻《本草便读》"}]},{"ID":"20240616101346-m0wcfwk","Type":"NodeParagraph","Properties":{"id":"20240616101346-m0wcfwk","updated":"20240616101346"},"Children":[{"Type":"NodeText","Data":"咸寒入肾．治相火之阳邪．甘淡通淋．渗膀胱之湿热．（泽泻甘淡咸寒．入肾与膀胱导下焦水湿垢浊．自然湿热除．相火降．邪去则正受益．故补肾药中．每每相兼用之．非泽泻真有补性也．不过一于利水而已．）"}]},{"ID":"20240616101422-3cwwm1i","Type":"NodeThematicBreak","Properties":{"id":"20240616101422-3cwwm1i"}},{"ID":"20240616101424-fq6vmae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101424-fq6vmae","updated":"20240616101428"},"Children":[{"Type":"NodeText","Data":"泽泻《要药分剂》"}]},{"ID":"20240616101424-ds6bzna","Type":"NodeParagraph","Properties":{"id":"20240616101424-ds6bzna","updated":"20240616101424"},"Children":[{"Type":"NodeText","Data":"味甘咸。性寒。无毒。禀地之燥气。天之冬气以生。降也。阴也。一云。阴中微阳也。"}]},{"ID":"20240616101424-a2ztwvo","Type":"NodeParagraph","Properties":{"id":"20240616101424-a2ztwvo","updated":"20240616101424"},"Children":[{"Type":"NodeText","Data":"【主治】主风寒湿痹。乳难消水。（本经）补虚损五劳。除五脏痞满。起阴气。止泄精消渴淋补女垢。心【归经】入肾膀胱二经。为渗湿利窍之品。（兼泻剂除湿圣药利水泻火）【前论】寇氏曰。多服昏人眼。以行去其水也。凡服泽泻散。未有不尿多者。尿既多。"}]},{"ID":"20240616101424-6xitu5h","Type":"NodeParagraph","Properties":{"id":"20240616101424-6xitu5h","updated":"20240616101424"},"Children":[{"Type":"NodeText","Data":"肾气丸用鳌按、六味丸温与凉配。涩与渗配。收与泻配。去一味。便有偏缺之弊。故凡后人加增之剂【禁忌】经疏曰。凡病患无湿无饮而阴虚。及肾气乏绝。阳衰精自流出。肾气不固。精滑目【炮制】纲目曰。凡使。盐水拌。或酒浸。晒干用。"}]},{"ID":"20240616101408-k2156o5","Type":"NodeThematicBreak","Properties":{"id":"20240616101408-k2156o5"}},{"ID":"20240616101409-5tzdr10","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101409-5tzdr10","updated":"20240616101413"},"Children":[{"Type":"NodeText","Data":"泽泻《本草求真》"}]},{"ID":"20240616101409-7w6omr9","Type":"NodeParagraph","Properties":{"id":"20240616101409-7w6omr9","updated":"20240616101409"},"Children":[{"Type":"NodeText","Data":"（水草）泻膀胱气分湿热"}]},{"ID":"20240616101409-71c3c63","Type":"NodeParagraph","Properties":{"id":"20240616101409-71c3c63","updated":"20240616101409"},"Children":[{"Type":"NodeText","Data":"泽泻（专入膀胱肾）。甘淡微寒。能入膀胱气分。以泻肾经火邪。功专利水除湿。故五苓散用又治水蓄烦渴小便不利。或吐或泻。五苓散主之。方用泽泻。故知长于行水。）八味丸用此以泻肾经湿火。（时珍曰。地黄丸用茯苓泽泻者。乃取其泻膀胱之邪气。非接引也。古人用补药。必兼泻邪。邪去则补药得力。一辟一阖。此乃玄妙。后人不知此理。专一于补。所以久服必有偏胜之害矣。汪昂曰。六味丸有熟地之温。丹皮之凉。山药之涩。茯苓之渗。山茱之收。泽泻之泻。补肾而兼补脾。有补而必有泻。相和相济。以成之功。乃平淡之神奇。所以为古今不易之良方也。即有加减。或加紫河车一具。或五味麦冬杜仲牛膝之类。不过一二味。极三四味而止。今人或疑泽泻之泻而减之。多拣本草补药。恣意加入。有补无泻。且客倍于主。责成不专。而六味之功。反退处于虚位。失制方之本意矣。此近世庸师之误也。）"}]},{"ID":"20240616101409-5immghq","Type":"NodeParagraph","Properties":{"id":"20240616101409-5immghq","updated":"20240616101409"},"Children":[{"Type":"NodeText","Data":"俾其补不偏胜。则补始无碍耳。岂曰泽泻补阴。功同于地黄之列哉？第其湿热不除。则病症莫测。故有消渴呕吐。痰饮肿胀。香港脚阴汗。尿血泄精种种等症。（病症皆因湿热为害。）用此甘淡微咸以为渗泄。（精泄安可渗利。因于湿热而成。不得不渗利耳。）则浊气既降。而清气上行。（故有耳聪目明之功。）所谓一除而百病与之俱除也。但小便过利。则肾水愈虚。而目必昏。（易老云。泻伏水。去留垢。故明目。小便利。肾气虚。故目昏。）此一定之理耳。盐水炒。或酒拌。忌铁。"}]},{"ID":"20240616101356-5s9suv8","Type":"NodeThematicBreak","Properties":{"id":"20240616101356-5s9suv8"}},{"ID":"20240616101358-tyi3jw5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101358-tyi3jw5","updated":"20240616101402"},"Children":[{"Type":"NodeText","Data":"泽泻《本经逢原》"}]},{"ID":"20240616101358-l8mara2","Type":"NodeParagraph","Properties":{"id":"20240616101358-l8mara2","updated":"20240616101358"},"Children":[{"Type":"NodeText","Data":"甘咸微寒，无毒。白者良。利小便生用，入补剂盐酒炒。油者伐胃伤脾，不可用。"}]},{"ID":"20240616101358-gp5485m","Type":"NodeParagraph","Properties":{"id":"20240616101358-gp5485m","updated":"20240616101358"},"Children":[{"Type":"NodeText","Data":"《本经》主风寒湿痹乳难，养五脏，益气力，肥健消水；久服耳目聪明，不饥延年。"}]},{"ID":"20240616101358-t372q8p","Type":"NodeParagraph","Properties":{"id":"20240616101358-t372q8p","updated":"20240616101358"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"泽泻甘咸沉降，阴中之阳，入足太阳气分。《素问》治酒风身热汗出，用泽泻、生术、麋衔，以其利膀胱湿热也。《金匮》治支饮冒眩，用泽泻汤，以逐心下痰气也。治水蓄烦渴，小便不利，或吐，或泻，用五苓散，以泄太阳邪热也，其功长于行水。《本经》主风寒湿痹，言风寒湿邪着不得去，则为肿胀，为癃闭，用此疏利水道，则诸证自除。盖邪干空窍，则为乳难，为水闭。泽泻性专利窍，窍利则邪热自通，内无热郁则脏气安和，而形体肥健矣。所以素多湿热之人，久服耳目聪明，然亦不可过用。若水道过利则肾气虚。故扁鹊云，多服病患眼。今人治泄精多不敢用，盖为肾与膀胱虚寒而失闭藏之令，得泽泻降之，而精愈滑矣。当知肾虚精滑，虚阳上乘而目时赤者，诚为禁剂。若湿热上盛而目肿，相火妄动而精泄，得泽泻清之，则目肿退而精自藏矣，何禁之有。仲景八味丸用之者，乃取以泻膀胱之邪，非接引也。古人用补药，必兼泻邪，邪去则补药得力矣。"}]},{"ID":"20240616101335-m0u1ypx","Type":"NodeThematicBreak","Properties":{"id":"20240616101335-m0u1ypx"}},{"ID":"20240616101336-dcj3w20","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101336-dcj3w20","updated":"20240616101341"},"Children":[{"Type":"NodeText","Data":"泽泻《汤液本草》"}]},{"ID":"20240616101336-go92okx","Type":"NodeParagraph","Properties":{"id":"20240616101336-go92okx","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"气平，味甘。甘、咸、寒，味浓，阴也，降也，阴中微阳。"}]},{"ID":"20240616101336-66x4tb3","Type":"NodeParagraph","Properties":{"id":"20240616101336-66x4tb3","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"入足太阳经、少阴经。"}]},{"ID":"20240616101336-3at1fja","Type":"NodeParagraph","Properties":{"id":"20240616101336-3at1fja","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"《象》云∶除湿之圣药。治小便淋沥，去阴间汗。无此疾，服之令人目盲。"}]},{"ID":"20240616101336-0q6zdut","Type":"NodeParagraph","Properties":{"id":"20240616101336-0q6zdut","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"《心》云∶去旧水，养新水。寒水气，须用。"}]},{"ID":"20240616101336-1b4umo4","Type":"NodeParagraph","Properties":{"id":"20240616101336-1b4umo4","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"《珍》云∶渗泻止渴。"}]},{"ID":"20240616101336-jrzle12","Type":"NodeParagraph","Properties":{"id":"20240616101336-jrzle12","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"《本草》云∶治风寒湿痹，乳难，消水，养五脏，益气力，肥健。补虚损五劳，除五脏痞满，起阴气，止泄精，消渴淋沥，逐膀胱三焦停水。"}]},{"ID":"20240616101336-p6ldjz4","Type":"NodeParagraph","Properties":{"id":"20240616101336-p6ldjz4","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"扁鹊云∶多服病患眼。"}]},{"ID":"20240616101336-vj0orf5","Type":"NodeParagraph","Properties":{"id":"20240616101336-vj0orf5","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶其功尤长于行水。"}]},{"ID":"20240616101336-jgps5g5","Type":"NodeParagraph","Properties":{"id":"20240616101336-jgps5g5","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"仲景云∶水畜烦渴，小便不利，或吐或泻，五苓散主之。方用泽泻，故知其用长于行水。《本经》又引扁鹊云∶多服病患眼。诚为行去其水故也。仲景八味丸用之者，亦不过接引桂、附等归就肾经，别无他意。凡服泽泻散人，未有不小便多者，小便既多，肾气焉得复实。今人止泄精，多不敢用。"}]},{"ID":"20240616101336-id9y1tv","Type":"NodeParagraph","Properties":{"id":"20240616101336-id9y1tv","updated":"20240616101336"},"Children":[{"Type":"NodeText","Data":"《本经》云∶久服明目；扁鹊谓∶多服昏目，何也？易老云∶去胞中留垢，以其味咸能泄伏水，故去留垢，即胞中陈积物也。入足太阳、少阴，仲景治太阳中风入里，渴者，五苓散主之。"}]},{"ID":"20240616101323-9uyged5","Type":"NodeThematicBreak","Properties":{"id":"20240616101323-9uyged5"}},{"ID":"20240616101324-qgcgdmc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101324-qgcgdmc","updated":"20240616101329"},"Children":[{"Type":"NodeText","Data":"泽泻《珍珠囊补遗药性赋》"}]},{"ID":"20240616101324-r64w5pw","Type":"NodeParagraph","Properties":{"id":"20240616101324-r64w5pw","updated":"20240616101324"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"君"}]},{"ID":"20240616101324-dbl9nrp","Type":"NodeParagraph","Properties":{"id":"20240616101324-dbl9nrp","updated":"20240616101324"},"Children":[{"Type":"NodeText","Data":"泽泻，味甘咸性寒无毒。降也，阳中之阴也。其用有四∶去胞垢而生新水；退阴汗而止虚烦；主小便淋涩为仙药；疗水病湿肿为灵丹。"}]},{"ID":"20240616101312-lsbva6g","Type":"NodeThematicBreak","Properties":{"id":"20240616101312-lsbva6g"}},{"ID":"20240616101313-cqexqox","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101313-cqexqox","updated":"20240616101319"},"Children":[{"Type":"NodeText","Data":"泽泻《本草经解》"}]},{"ID":"20240616101313-o45vcbt","Type":"NodeParagraph","Properties":{"id":"20240616101313-o45vcbt","updated":"20240616101313"},"Children":[{"Type":"NodeText","Data":"纲目称其行水泻肾．仲景地黄丸用茯苓泽泻者．取其泻膀胱之邪气．古人用补药必兼泻邪．邪去则补药得力．后世不知此理．一意用补．故久服有偏胜之患．是泽泻但长于利水．未可专任．扁鹊云．多服病患眼．盖小便利．肾气虚．故昏目也．本草久服云云．扬之太过．用者审之．"}]},{"ID":"20240616101302-xlw6w8t","Type":"NodeThematicBreak","Properties":{"id":"20240616101302-xlw6w8t"}},{"ID":"20240616101303-hkzt7xl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101303-hkzt7xl","updated":"20240616101308"},"Children":[{"Type":"NodeText","Data":"泽泻《顾松园医镜》"}]},{"ID":"20240616101303-w35pro1","Type":"NodeParagraph","Properties":{"id":"20240616101303-w35pro1","updated":"20240616101303"},"Children":[{"Type":"NodeText","Data":"〔甘咸微寒，入肾、膀胱二经，去皮酒浸焙。〕利小便，治淋沥。〔有宣通水道之功。"}]},{"ID":"20240616101303-7uffo5e","Type":"NodeParagraph","Properties":{"id":"20240616101303-7uffo5e","updated":"20240616101303"},"Children":[{"Type":"NodeText","Data":"〕泻心下水痞，祛脬中留垢。〔以其能逐三焦、膀胱停水故也。〕渗湿热，行痰饮，泄泻水肿痹症均求，头旋香港脚疝疼咸疗。〔皆利水除湿之效。时珍云∶脾胃有湿热，则头重旋转，目昏耳鸣，渗去其湿，则热除而土气得令，清气上行，则天气明爽。故本经言，服之耳目聪明。若久服则降令太过，清气不升，且小便既多，肾阴潜耗，故扁鹊言其多服昏目。地黄丸用泽泻者，古人用补，必兼泻邪，去邪则补剂得力，专一于补，必致偏胜之害也。仲淳云∶入六味丸中，除阴虚病有湿热者者。其说甚通〕。"}]},{"ID":"20240616101303-3r4r7ud","Type":"NodeParagraph","Properties":{"id":"20240616101303-3r4r7ud","updated":"20240616101303"},"Children":[{"Type":"NodeText","Data":"性善逐水，病患无湿无饮者勿用。肾虚精滑，虚寒泄泻等候，皆忌。"}]},{"ID":"20240616101251-bty06o1","Type":"NodeThematicBreak","Properties":{"id":"20240616101251-bty06o1"}},{"ID":"20240616101252-hk76vn7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101252-hk76vn7","updated":"20240616101256"},"Children":[{"Type":"NodeText","Data":"泽泻《冯氏锦囊秘录》"}]},{"ID":"20240616101252-s3zra9u","Type":"NodeParagraph","Properties":{"id":"20240616101252-s3zra9u","updated":"20240616101252"},"Children":[{"Type":"NodeText","Data":"禀地之燥气，天之冬气以生，故味甘咸寒无毒。脾胃利水药中宜生用，滋阴，利水药中宜盐水拌炒用，八味温补药中宜盐酒拌炒用。"}]},{"ID":"20240616101252-2k1yryh","Type":"NodeParagraph","Properties":{"id":"20240616101252-2k1yryh","updated":"20240616101252"},"Children":[{"Type":"NodeText","Data":"泽泻，去阴汗，大利小便，泻伏水，微养新水，尿血泄精泻痢肿胀，除湿止渴圣药，通淋利水仙丹。五苓散用取其行湿，八味丸用引入肾经。久服轻身，多服昏目。地黄补肾药中，必兼泽泻，泻肾者，却泻肾中湿火，则补药得力，故古人凡用补药，必兼泻邪，此开合之妙。若有补无泻，即有偏胜之害，惟在脱虚之症，则峻补之力，毋容一少缓也。扁鹊云∶多服病患眼，以其利水泻肾也。故病患无湿、肾虚精滑、目虚不明者禁用。"}]},{"ID":"20240616101252-x1jjjni","Type":"NodeParagraph","Properties":{"id":"20240616101252-x1jjjni","updated":"20240616101252"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 主补阴滋血，逐膀胱三焦停水。凡痘疮小便赤涩者用之。"}]},{"ID":"20240616101227-ihym122","Type":"NodeThematicBreak","Properties":{"id":"20240616101227-ihym122"}},{"ID":"20240616101229-q6pt02d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101229-q6pt02d","updated":"20240616101235"},"Children":[{"Type":"NodeText","Data":"泽泻《证类本草》"}]},{"ID":"20240616101229-900w8nf","Type":"NodeParagraph","Properties":{"id":"20240616101229-900w8nf","updated":"20240616101229"},"Children":[{"Type":"NodeText","Data":"味甘、咸，寒，无毒。主风寒湿痹，乳难，消水，养五脏，益气力，肥健，补虚损五劳，除五脏痞满，起阴气，止泄精、消渴、淋沥，逐膀胱三焦停水。久服耳目聪明，不饥，延年，轻身，面生光，能行水上。扁鹊云∶多服病患眼。一名水泻，一名及泻，一名芒芋，一名鹄泻。生汝南池泽。五月、六月、八月采根，阴干。（畏海蛤、文蛤。）"}]},{"ID":"20240616101229-cvp8i7n","Type":"NodeParagraph","Properties":{"id":"20240616101229-cvp8i7n","updated":"20240616101229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"味咸，无毒。主大风，乳汁不出，产难，强阴气。久服轻身。五月采。"}]},{"ID":"20240616101229-olcs1k0","Type":"NodeParagraph","Properties":{"id":"20240616101229-olcs1k0","updated":"20240616101229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"味甘，无毒。主风痹、消渴，益肾气，强阴，补不足，除邪湿。久服面生光，令人无子陶隐居云∶汝南郡属豫州。今近道亦有，不堪用，唯用汉中、南郑、青弋，形大而长，尾间必有两歧为好。此物易朽蠹，常须密藏之。叶狭长，丛生诸浅水中。《仙经》服食断谷皆用之。亦云身轻，能步行水上。唐本注云∶今汝南不复采用，唯以泾州、华州者为善也。臣禹锡等谨按尔雅云∶ ， 。疏云∶ ，一名 ，即药草泽泻也。药性论云∶泽泻，君，味。能主肾虚精自出，治五淋，利膀胱热，宣通水道。日华子云∶治五劳七伤，主头旋，耳虚鸣，筋骨挛缩，通小肠，止遗沥，尿血，催生，难产，补女人血海，令人有子。叶壮水脏，下乳，通血脉。"}]},{"ID":"20240616101229-8j0ys1s","Type":"NodeParagraph","Properties":{"id":"20240616101229-8j0ys1s","updated":"20240616101229"},"Children":[{"Type":"NodeText","Data":"图经曰∶泽泻，生汝南池泽，今山东、河、陕、江、淮亦有之，以汉中者为佳。春生苗，多在浅水中，叶似牛舌草，独茎而长。秋时开白花，作丛似谷精草。五月、六月、八月采根，阴干。今人秋末采，曝干用。此物极易朽蠹，常须密藏之。汉中出者，形大而长，尾间有两歧最佳。《尔雅》谓之 （羊朱切），一名 （与舄同，私夕切）。《素问》身热解堕，汗出如浴恶风少气，名曰酒风。治之以泽泻、术各十分，麋衔五分，合以二指撮，为后饭。后饭者，饭后药先，谓之后饭。张仲景治杂病，心下有支饮，苦冒，泽泻汤主之。泽泻五两，术二两，水二升，煎取半升，分温再服。治伤寒有大、小泽泻汤，五苓散辈。皆用泽泻，行利停水为最要。深师治支饮，亦同用泽泻、术，但煮法小别。先以水二升煮二物，取一升，又以水一升煮泽泻，取五合，合此二汁，为再服。病甚欲眩者，服之必瘥。仙方亦单服泽泻一物，捣筛，取末，水调，日分服六两，百日体轻，久而健行。"}]},{"ID":"20240616101229-0vt91ab","Type":"NodeParagraph","Properties":{"id":"20240616101229-0vt91ab","updated":"20240616101229"},"Children":[{"Type":"NodeText","Data":"雷公曰∶不计多少，细锉酒浸一宿，漉出，曝干，任用也。经验方∶常服泽泻，皂荚水煮烂，焙干为末，炼蜜为丸如桐子大。空尽以温酒下十五丸至二十丸，甚妙。治肾脏风，生疮尤良。"}]},{"ID":"20240616101229-43agoi3","Type":"NodeParagraph","Properties":{"id":"20240616101229-43agoi3","updated":"20240616101229"},"Children":[{"Type":"NodeText","Data":"衍义曰∶泽泻，其功尤长于行水。张仲景曰∶水搐渴烦，小便不利，或吐或泻，五苓散主之。方用泽泻，故知其用长于行水。《本经》又引扁鹊云，多服病患眼，诚为行去其水。张仲景八味丸用之者，亦不过引接桂、附等归就肾经，别无他意。凡服泽泻散人，未有不小便多者，小便既多，肾气焉得复实？今人止泄精，多不敢用。"}]},{"ID":"20240616101151-ky8vxma","Type":"NodeThematicBreak","Properties":{"id":"20240616101151-ky8vxma"}},{"ID":"20240616101204-19veikk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101204-19veikk","updated":"20240616101209"},"Children":[{"Type":"NodeText","Data":"泽泻《本草蒙筌》"}]},{"ID":"20240616101204-inrfil7","Type":"NodeParagraph","Properties":{"id":"20240616101204-inrfil7","updated":"20240616101204"},"Children":[{"Type":"NodeText","Data":"味甘、酸，气寒。气味俱浓，沉而降，阴也，阴中微阳。无毒。淮北虽生，不可入药。汉中所出，方可拯 。盖因形大而长，尾有两歧为异耳。但易蛀朽，须密收藏。制宗雷公，酒浸曝用。畏海蛤、文蛤二药，入太阳、少阳足经。君五苓散中，因其功长于行湿；佐八味丸内，引桂附等归就肾经。去阴汗大利小便，泻伏水微养新水。故经云∶除湿止渴圣药，通淋利水仙丹。久服轻身，多服昏目。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"状水脏，通血脉，行乳汁催生；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"主风痹，除湿邪，强阴气益肾。服久无子，惟面生光。"}]},{"ID":"20240616101204-lz3v3yg","Type":"NodeParagraph","Properties":{"id":"20240616101204-lz3v3yg","updated":"20240616101204"},"Children":[{"Type":"NodeText","Data":"（谟）按∶泽泻多服虽则昏目，暴服亦能明目。其义何也？盖味咸能泻伏水，则胞中留久陈积之物由之而去也。泻伏水，去留垢，故明目；小便利，肾气虚，故昏目。二者不可不知。"}]},{"ID":"20240616101152-tg7qe6m","Type":"NodeThematicBreak","Properties":{"id":"20240616101152-tg7qe6m"}},{"ID":"20240616101153-tjg11s0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101153-tjg11s0","updated":"20240616101158"},"Children":[{"Type":"NodeText","Data":"泽泻《本草图经》"}]},{"ID":"20240616101153-l5bes29","Type":"NodeParagraph","Properties":{"id":"20240616101153-l5bes29","updated":"20240616101155"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"泽泻"},{"Type":"NodeText","Data":"，生汝南池泽，今山东、河陕、江淮亦有之，以汉中者为佳。春生苗，多在浅水中。叶似牛舌草，独茎而长；秋时开白花，作丛，似谷精草。五月、六月、八月采根，阴干。今人秋末采，曝干用。此物极易朽蠹，常须密藏之。汉中出者，形大而长，尾间有两岐最佳。《尔雅》谓之 （羊朱切），一名 （与舄同，私夕切）。《素问》∶身热解堕，汗出如浴，恶风少气，名曰酒风。治之以泽泻、术各十分，麋衔五分，合以二指撮，为后饭。后饭者，饭后药先，谓之后饭。张仲景治杂病心下有支饮，苦冒，泽泻汤主之。泽泻五两，术二两，水二升，煎取半升，分温再服。治伤寒有大、小泽泻汤，五苓散辈，皆用泽泻，行利停水为最要。深师治支饮，亦同用泽泻、术，但煮法小别。先以水二升，煮二物，取一升。又以水一升，煮泽泻，取五合，合此二汁，分为再服。病甚欲眩者，服之必瘥。仙方亦单服泽泻一物，捣筛，取末，水调，日分服六两，百日体轻，久而健行。"}]},{"ID":"20240616101754-bkw8uy5","Type":"NodeThematicBreak","Properties":{"id":"20240616101754-bkw8uy5"}},{"ID":"20240616101755-hf5nyey","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616101755-hf5nyey","updated":"20240616101801"},"Children":[{"Type":"NodeText","Data":"泽泻《中药学》"}]},{"ID":"20240616101755-8nv0er7","Type":"NodeParagraph","Properties":{"id":"20240616101755-8nv0er7","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【药用】泽泻科沼泽植物泽泻Alismaorientalis（Sam.）Juzep的块茎。"}]},{"ID":"20240616101755-alwccx2","Type":"NodeParagraph","Properties":{"id":"20240616101755-alwccx2","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，寒。归肾、膀胱经。"}]},{"ID":"20240616101755-211mxhf","Type":"NodeParagraph","Properties":{"id":"20240616101755-211mxhf","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【功效】利水渗湿，泄热。"}]},{"ID":"20240616101755-yhlvrlo","Type":"NodeParagraph","Properties":{"id":"20240616101755-yhlvrlo","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于小便不利，水肿，泄泻，淋浊，带下，痰饮停聚等症。"}]},{"ID":"20240616101755-p0rb791","Type":"NodeParagraph","Properties":{"id":"20240616101755-p0rb791","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"泽泻甘淡渗湿，利水作用与茯苓相似，亦为利水渗湿常用之品，且药性寒凉，能泄肾与膀胱之热，故对水湿偏热者，尤为适宜。治小便不利、水肿、淋浊、带下等症，常与茯苓、猪苓、车前子等配伍；治泄泻及痰饮所致的眩晕，可与白朮配伍。"}]},{"ID":"20240616101755-s6asknr","Type":"NodeParagraph","Properties":{"id":"20240616101755-s6asknr","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"此外，本引用于肾阴不足、虚火亢盛，配地黄、山茱萸等同用，有泻泄相火作用。"}]},{"ID":"20240616101755-euxw2di","Type":"NodeParagraph","Properties":{"id":"20240616101755-euxw2di","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【处方用名】泽泻、建泽泻、福泽泻（洗净，晒干，切片用）、炒泽泻（炒用，多用于利水止泻）"}]},{"ID":"20240616101755-f8xdj1d","Type":"NodeParagraph","Properties":{"id":"20240616101755-f8xdj1d","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240616101755-qsi82ni","Type":"NodeParagraph","Properties":{"id":"20240616101755-qsi82ni","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【按语】泽泻性味甘寒，入肾、膀胱，功专利水道、渗水湿，为治疗水湿为患的常用要药。且性属寒凉，有除热之能，既能用治湿热之症，复可配合应用以泄肾经之相火。"}]},{"ID":"20240616101755-8muhu76","Type":"NodeParagraph","Properties":{"id":"20240616101755-8muhu76","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"前人认为泽泻“利水而不伤阴”甚而有“补阴不足”之说，实皆根于六味丸而来。惟泽泻利水力佳，实有伤阴之可能，更无补阴之效用，张景岳谓：「补阴不利水，利水不补阴」可资参考，故临床应尚须注意。茯苓与泽泻均能利水渗湿，作用广泛，故往往配伍应用。然茯苓能泻能补，兼有健脾宁心之效，而泽泻性偏于寒，泻而无补，专用于渗利水道。"}]},{"ID":"20240616101755-qtqk00g","Type":"NodeParagraph","Properties":{"id":"20240616101755-qtqk00g","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【方剂举例】泽泻汤（《金匮要略》）：泽泻、白朮。治心下有支饮，其人苦眩冒者；亦治水泻小便短少者。"}]},{"ID":"20240616101755-cov51i4","Type":"NodeParagraph","Properties":{"id":"20240616101755-cov51i4","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本草衍义》：「其供尤长于行水。」"}]},{"ID":"20240616101755-em11ugu","Type":"NodeParagraph","Properties":{"id":"20240616101755-em11ugu","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"《本草汇言》：「利水之主药。利水，人皆知之矣；丹溪又谓能利膀胱、包络之火，膀胱包络有火，病癃闭结胀者，火泻则水行，行水则火降矣，水火二义，并行不悖。」"}]},{"ID":"20240616101755-s6swtni","Type":"NodeParagraph","Properties":{"id":"20240616101755-s6swtni","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"《本草通玄》：「相火妄动而遗泄者，得泽泻清之而精自藏气虚下陷而精滑者，得泽泻降之而精愈滑矣。」"}]},{"ID":"20240616101755-ixd0lye","Type":"NodeParagraph","Properties":{"id":"20240616101755-ixd0lye","updated":"20240616101755"},"Children":[{"Type":"NodeText","Data":"《药品化义》：「除湿热，通淋浊，分消痞满，透三焦蓄热停水，此为利水第一良品。」"}]},{"ID":"20240607105902-1f3e87x","Type":"NodeThematicBreak","Properties":{"id":"20240607105902-1f3e87x"}},{"ID":"20240607105902-mbjzwp8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105902-mbjzwp8","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"《中国药典》：泽泻"}]},{"ID":"20240607105902-z8djess","Type":"NodeParagraph","Properties":{"id":"20240607105902-z8djess","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105902-w688wid","Type":"NodeParagraph","Properties":{"id":"20240607105902-w688wid","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" Zé Xiè"}]},{"ID":"20240607105902-dw6h18y","Type":"NodeParagraph","Properties":{"id":"20240607105902-dw6h18y","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105902-1xm6u3w","Type":"NodeParagraph","Properties":{"id":"20240607105902-1xm6u3w","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 水泽、如意花、车苦菜、天鹅蛋、天秃、一枝花"}]},{"ID":"20240607105902-kte9b5x","Type":"NodeParagraph","Properties":{"id":"20240607105902-kte9b5x","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607105902-4m57i8p","Type":"NodeParagraph","Properties":{"id":"20240607105902-4m57i8p","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" RHIZOMA ALISMATIS"}]},{"ID":"20240607105902-0ceifay","Type":"NodeParagraph","Properties":{"id":"20240607105902-0ceifay","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105902-245h5hd","Type":"NodeParagraph","Properties":{"id":"20240607105902-245h5hd","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 本品为泽泻科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽泻"},{"Type":"NodeText","Data":"Alisma orientalis （Sam.）Juzep.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。冬季茎叶开始枯萎时采挖，洗净，干燥，除去须根及粗皮。"}]},{"ID":"20240607105902-j1yzewf","Type":"NodeParagraph","Properties":{"id":"20240607105902-j1yzewf","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607105902-pxcqays","Type":"NodeParagraph","Properties":{"id":"20240607105902-pxcqays","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 本品呈类球形、椭圆形或卵圆形，长2～7cm，直径2～6cm。表面黄白色或淡黄棕色，有不规则的横向环状浅沟纹及多数细小突起的须根痕，底部有的有瘤状芽痕。质坚实，断面黄白色，粉性，有多数细孔。气微，味微苦。"}]},{"ID":"20240607105902-xx8f681","Type":"NodeParagraph","Properties":{"id":"20240607105902-xx8f681","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607105902-xnahc7v","Type":"NodeParagraph","Properties":{"id":"20240607105902-xnahc7v","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240607105902-y6dnq7x","Type":"NodeParagraph","Properties":{"id":"20240607105902-y6dnq7x","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105902-uallqql","Type":"NodeParagraph","Properties":{"id":"20240607105902-uallqql","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽泻"},{"Type":"NodeText","Data":"：除去杂质，稍浸，润透，切厚片，干燥。"}]},{"ID":"20240607105902-wx3j43k","Type":"NodeParagraph","Properties":{"id":"20240607105902-wx3j43k","updated":"20240607105902"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"盐泽泻"},{"Type":"NodeText","Data":"：取泽泻片，照盐水炙法（附录Ⅱ D）炒干（每100斤加盐2斤半用开水化开）。"}]},{"ID":"20240607105902-ym6z667","Type":"NodeParagraph","Properties":{"id":"20240607105902-ym6z667","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607105902-xniae6t","Type":"NodeParagraph","Properties":{"id":"20240607105902-xniae6t","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 本品粉末淡黄棕色。淀粉粒甚多，单粒长卵形、类球形或椭圆形，直径3～14μm，脐点人字状、短缝状或三叉状；复粒由2～3分粒组成。薄壁细胞类圆形，具多数椭圆形纹孔，集成纹孔群。内皮层细胞垂周壁波状弯曲，较厚，木化，有稀疏细孔沟。油室大多破碎，完整者类圆形，直径54～110μm，分泌细胞中有时可见油滴。"}]},{"ID":"20240607105902-hmlak1v","Type":"NodeParagraph","Properties":{"id":"20240607105902-hmlak1v","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607105902-tukxtn4","Type":"NodeParagraph","Properties":{"id":"20240607105902-tukxtn4","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 归肾、膀胱经。"}]},{"ID":"20240607105902-013rhgk","Type":"NodeParagraph","Properties":{"id":"20240607105902-013rhgk","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105902-6x0puh0","Type":"NodeParagraph","Properties":{"id":"20240607105902-6x0puh0","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240607105902-36xdot5","Type":"NodeParagraph","Properties":{"id":"20240607105902-36xdot5","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105902-l5m367m","Type":"NodeParagraph","Properties":{"id":"20240607105902-l5m367m","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 利小便，清湿热。用于小便不利，水肿胀满，泄泻尿少，痰饮眩晕，热淋涩痛；高血脂。"}]},{"ID":"20240607105902-yfqro2w","Type":"NodeParagraph","Properties":{"id":"20240607105902-yfqro2w","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607105902-bxtmb0t","Type":"NodeParagraph","Properties":{"id":"20240607105902-bxtmb0t","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 6～9g。"}]},{"ID":"20240607105902-8a178eo","Type":"NodeParagraph","Properties":{"id":"20240607105902-8a178eo","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607105902-vc9mgzd","Type":"NodeParagraph","Properties":{"id":"20240607105902-vc9mgzd","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" （1）治小便不利、水肿、淋浊、带下等症，常与茯苓、猪苓、车前子等配伍；治泄泻及痰饮所致的眩晕，可与白朮配伍。此外，本引用于肾阴不足、虚火亢盛，配地黄、山茱萸等同用，有泻泄相火作用。泽泻利水力佳，实有伤阴之可能，更无补阴之效用，张景岳谓：「补阴不利水，利水不补阴」可资参考，故临床应尚须注意。"}]},{"ID":"20240607105902-0w3v7qm","Type":"NodeParagraph","Properties":{"id":"20240607105902-0w3v7qm","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105902-q4w56hf","Type":"NodeParagraph","Properties":{"id":"20240607105902-q4w56hf","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607105902-4tesf4f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105902-4tesf4f","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：泽泻"}]},{"ID":"20240607105902-1l4c6kl","Type":"NodeParagraph","Properties":{"id":"20240607105902-1l4c6kl","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105902-q19vd9w","Type":"NodeParagraph","Properties":{"id":"20240607105902-q19vd9w","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" Zé Xiè"}]},{"ID":"20240607105902-dre4yxi","Type":"NodeParagraph","Properties":{"id":"20240607105902-dre4yxi","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105902-92rcu22","Type":"NodeParagraph","Properties":{"id":"20240607105902-92rcu22","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 水泻、芒芋、鹄泻（《本经》），泽芝（《典术》），及泻（《别录》），天鹅蛋、天秃（《药材资料汇编》）。"}]},{"ID":"20240607105902-kkpj0wb","Type":"NodeParagraph","Properties":{"id":"20240607105902-kkpj0wb","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607105902-h3a69ay","Type":"NodeParagraph","Properties":{"id":"20240607105902-h3a69ay","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607105902-vn3tbf4","Type":"NodeParagraph","Properties":{"id":"20240607105902-vn3tbf4","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105902-zh5doy4","Type":"NodeParagraph","Properties":{"id":"20240607105902-zh5doy4","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 为泽泻科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽泻"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。冬季叶子枯萎时，采挖块茎，除去茎叶及须根，洗净，用微火烘干，再撞去须根及粗皮。"}]},{"ID":"20240607105902-pa5gwgn","Type":"NodeParagraph","Properties":{"id":"20240607105902-pa5gwgn","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607105902-jwuj9ma","Type":"NodeParagraph","Properties":{"id":"20240607105902-jwuj9ma","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 生于沼泽边缘。分布黑龙江、吉林、辽宁、河北、河南、山东、江苏，浙江、福建、江西，四川、贵州、云南、新疆等地。四川、福建有大面积的栽培。"}]},{"ID":"20240607105902-2aqioi6","Type":"NodeParagraph","Properties":{"id":"20240607105902-2aqioi6","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607105902-w0aii9c","Type":"NodeParagraph","Properties":{"id":"20240607105902-w0aii9c","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 泽泻，又名：荬（《诗经》），蕍、茑、牛唇（《尔雅》），水涾菜（《救荒本草》），水泽、耳泽。"}]},{"ID":"20240607105902-4l4igjc","Type":"NodeParagraph","Properties":{"id":"20240607105902-4l4igjc","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"多年生沼泽植物，高50～100厘米。地下有块茎，球形，直径可达4.5厘米，外皮褐色，密生多数须根。叶根生；叶柄长5～54厘米，叶鞘宽5～20毫米；叶片椭圆形至卵形，长5～18厘米，宽2～10厘米，先端急尖或短尖，基部广楔形，圆形或稍心形，全缘，两面均光滑无毛，叶脉6-7条。花茎由叶丛中生出，总花梗通常5～7，轮生，集成大形的轮生状圆锥花序；小花梗长短不等，伞状排列；苞片披针形至线形，尖锐；萼片3，绿色，广卵形，长2～3毫米，宽1.5毫米；花瓣3，白色，倒卵形，较萼短；雄蕊6；雌蕊多数，离生，子房倒卵形，侧扁，花柱侧生。瘦果多数，扁平，倒卵形，长1.5～2毫米，宽约1毫米，褐色。花期6～8月。果期7～9月。"}]},{"ID":"20240607105902-vr3qdye","Type":"NodeParagraph","Properties":{"id":"20240607105902-vr3qdye","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"本植物的叶（泽泻叶）、果实（泽泻实）亦供药用，各详专条。"}]},{"ID":"20240607105902-5tsv2b9","Type":"NodeParagraph","Properties":{"id":"20240607105902-5tsv2b9","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607105902-dyugam0","Type":"NodeParagraph","Properties":{"id":"20240607105902-dyugam0","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 干燥块茎类圆球形、长圆球形或倒卵形，长约4～7厘米，直径约3～5厘米；表面黄白色，未去尽粗皮者呈淡棕色；有不规则的横向环状凹陷，并散有无数突起的须根痕迹，在底部尤密；质坚实，破折面黄白色，带颗粒性。气微香，味微苦。以个大、质坚、色黄白、粉性足者为佳。"}]},{"ID":"20240607105902-9922ovc","Type":"NodeParagraph","Properties":{"id":"20240607105902-9922ovc","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"主产福建、四川、江西，此外贵州、云南等地亦产。商品中以福建、江西产者称\"建泽泻\"，个大，圆形而光滑；四川、云南、贵州产者称\"川泽泻\"，个较小，皮较粗糙。一般认为建泽泻品质较佳。"}]},{"ID":"20240607105902-c01ybt7","Type":"NodeParagraph","Properties":{"id":"20240607105902-c01ybt7","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607105902-e48ov43","Type":"NodeParagraph","Properties":{"id":"20240607105902-e48ov43","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240607105902-5wd3j8h","Type":"NodeParagraph","Properties":{"id":"20240607105902-5wd3j8h","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607105902-w3j93ft","Type":"NodeParagraph","Properties":{"id":"20240607105902-w3j93ft","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 块茎中分出五种三萜类化合物：泽泻醇A、泽泻醇B，乙酸泽泻醇A酯、乙酸泽泻醇B酯和表泽泻醇A；另含挥发油（内含糠醛）、小量生物碱、天门冬素、一种植物甾醇、一种植物甾醇甙、脂肪酸（棕榈酸、硬脂酸、油酸、亚油酸）；还含树脂、蛋白质和多量淀粉（23％）。"}]},{"ID":"20240607105902-ig622z3","Type":"NodeParagraph","Properties":{"id":"20240607105902-ig622z3","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607105902-kn4sbe1","Type":"NodeParagraph","Properties":{"id":"20240607105902-kn4sbe1","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" ①利尿作用"}]},{"ID":"20240607105902-0nz4mpu","Type":"NodeParagraph","Properties":{"id":"20240607105902-0nz4mpu","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"在大白鼠的利尿实验中，不同产季和不同药用部位的泽泻具有不同的效果。冬季产的正品泽泻利尿效力最大，春泽泻效力稍差，冬季产的泽泻须稍有作用，泽泻草根（种不活的苗）及春季产的泽泻须则均无利尿作用。不同的炮炙方法，其利尿效果亦不同。生泽泻，酒炙、麸炙泽泻均有一定的利尿作用，而盐泽泻则无作用；但在五苓散（泽泻、茯苓、白术、桂枝以4：3：3：2配伍）中，无论用生泽泻或盐泽泻，均表现有利尿作用。健康人口服泽泻煎剂可使尿量、钠、尿素排出增加，家兔口服效果极弱，但以泽泻流浸膏腹腔注射则有利尿作用。泽泻含钾达147.5毫克％，用于切除肾上腺的大白鼠，可显著增加尿钾排出，可见泽泻的利尿作用与其含大量钾盐有关。以硝酸钠注射于家兔皮下引起人工肾炎，泽泻可降低血中滞留的尿素及胆甾醇。"}]},{"ID":"20240607105902-cavcs9g","Type":"NodeParagraph","Properties":{"id":"20240607105902-cavcs9g","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②对脂质代谢的影响"}]},{"ID":"20240607105902-zcb4ovr","Type":"NodeParagraph","Properties":{"id":"20240607105902-zcb4ovr","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"泽泻近缘品种Alisma plantago L.中的成分T（1.1.1.1），对大白鼠低蛋白饮食引起的脂肪肝有治疗作用，其作用与胆碱、卵磷脂相当，但根据用药后血清及肝中脂质的分析，则与胆碱及卵磷脂还有所不同。腹腔注射能减轻大鼠口服棉子油引起的脂血症，对大鼠用四氯化碳引起的肝损害，有预防及治疗的效果，并能轻度降低家兔实验性动脉粥样硬化的血胆甾醇，缓和病变的发展。"}]},{"ID":"20240607105902-cbgivxg","Type":"NodeParagraph","Properties":{"id":"20240607105902-cbgivxg","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240607105902-nwbkpol","Type":"NodeParagraph","Properties":{"id":"20240607105902-nwbkpol","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"麻醉犬静脉注射泽泻浸膏可以降压家兔皮下注射浸膏6克／公斤有轻度降血糖作用，但皮下注射煎剂5克／公斤无此作用。泽泻在试管内能抑制结核杆菌的生长。"}]},{"ID":"20240607105902-ltlq5wb","Type":"NodeParagraph","Properties":{"id":"20240607105902-ltlq5wb","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105902-wc61qgl","Type":"NodeParagraph","Properties":{"id":"20240607105902-wc61qgl","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 泽泻：拣去杂质，大小分档，用水浸泡，至八成透捞出，晒晾，闷润至内外湿度均匀，切片，晒干。盐泽泻：取泽泻片，用盐水喷洒拌匀，稍闷润，置锅内用文火微炒至表面略现黄色取出，晾干。（每泽泻片100斤，用盐二斤八荫，加适量开水化开澄清）"}]},{"ID":"20240607105902-whh8ysb","Type":"NodeParagraph","Properties":{"id":"20240607105902-whh8ysb","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"细锉，酒浸一宿，漉出，暴干任用。\""}]},{"ID":"20240607105902-aoxq20q","Type":"NodeParagraph","Properties":{"id":"20240607105902-aoxq20q","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607105902-tk4w109","Type":"NodeParagraph","Properties":{"id":"20240607105902-tk4w109","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 入肾、膀胱经。"}]},{"ID":"20240607105902-66k7qsi","Type":"NodeParagraph","Properties":{"id":"20240607105902-66k7qsi","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阳、少阴经。\""}]},{"ID":"20240607105902-5dyns1d","Type":"NodeParagraph","Properties":{"id":"20240607105902-5dyns1d","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②《本草衍义补L遗》：\"入足太阳、少阴经。\""}]},{"ID":"20240607105902-a6114jw","Type":"NodeParagraph","Properties":{"id":"20240607105902-a6114jw","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入膀胱、肾、三焦、小肠四经。\""}]},{"ID":"20240607105902-bb1to2i","Type":"NodeParagraph","Properties":{"id":"20240607105902-bb1to2i","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"④《本草经巯》：\"入肾、脾。\""}]},{"ID":"20240607105902-0lyet21","Type":"NodeParagraph","Properties":{"id":"20240607105902-0lyet21","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105902-kq03vqs","Type":"NodeParagraph","Properties":{"id":"20240607105902-kq03vqs","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240607105902-o58ri7e","Type":"NodeParagraph","Properties":{"id":"20240607105902-o58ri7e","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，寒。\""}]},{"ID":"20240607105902-kd07wvk","Type":"NodeParagraph","Properties":{"id":"20240607105902-kd07wvk","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"咸，无毒。\""}]},{"ID":"20240607105902-aaeb2c2","Type":"NodeParagraph","Properties":{"id":"20240607105902-aaeb2c2","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑨《药性论》：\"味苦。\""}]},{"ID":"20240607105902-95xymj5","Type":"NodeParagraph","Properties":{"id":"20240607105902-95xymj5","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"气平，味甘。\""}]},{"ID":"20240607105902-7zbfh75","Type":"NodeParagraph","Properties":{"id":"20240607105902-7zbfh75","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑤《本草蒙筌》：\"甘酸，气寒。\""}]},{"ID":"20240607105902-l8eoyiz","Type":"NodeParagraph","Properties":{"id":"20240607105902-l8eoyiz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607105902-cyk48op","Type":"NodeParagraph","Properties":{"id":"20240607105902-cyk48op","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 肾虚精滑者忌服。"}]},{"ID":"20240607105902-tch409i","Type":"NodeParagraph","Properties":{"id":"20240607105902-tch409i","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"畏海蛤、文蛤。\""}]},{"ID":"20240607105902-mff1ncc","Type":"NodeParagraph","Properties":{"id":"20240607105902-mff1ncc","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"扁鹊云，多服病人眼。\""}]},{"ID":"20240607105902-htknydw","Type":"NodeParagraph","Properties":{"id":"20240607105902-htknydw","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑤《医学入门》：\"凡淋、渴，水肿，肾虚所致者，不可用。\""}]},{"ID":"20240607105902-carp7uh","Type":"NodeParagraph","Properties":{"id":"20240607105902-carp7uh","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"病人无湿无饮而阴虚，及肾气乏绝，阳衰精自流出，肾气不固精滑，目痛，虚寒作泄等侯，法咸忌之。\""}]},{"ID":"20240607105902-s2xjuj1","Type":"NodeParagraph","Properties":{"id":"20240607105902-s2xjuj1","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105902-14wuxse","Type":"NodeParagraph","Properties":{"id":"20240607105902-14wuxse","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 利水，渗湿，泄热。治小便不利，水肿胀满，呕吐，泻痢，痰饮，脚气，淋病，尿血。"}]},{"ID":"20240607105902-07b0o53","Type":"NodeParagraph","Properties":{"id":"20240607105902-07b0o53","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"（1）利水渗湿：用于水湿内停之尿少、水肿、泻痢及湿热淋浊等证。治胃内停水常配白术。治尿道涩痛、小便不利常配木通、茯苓。"}]},{"ID":"20240607105902-cw2a2uj","Type":"NodeParagraph","Properties":{"id":"20240607105902-cw2a2uj","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"（2）清泻肾火：用于阴虚火旺诸证。"}]},{"ID":"20240607105902-tha57fk","Type":"NodeParagraph","Properties":{"id":"20240607105902-tha57fk","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主风寒湿痹，乳难，消水，养五脏，益气力，肥健。\""}]},{"ID":"20240607105902-nzqhpne","Type":"NodeParagraph","Properties":{"id":"20240607105902-nzqhpne","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"补虚损五劳，除五脏痞满，起阴气，止泄精、消渴、淋沥，逐膀胱、三焦停水。\""}]},{"ID":"20240607105902-1q4tpj6","Type":"NodeParagraph","Properties":{"id":"20240607105902-1q4tpj6","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主肾虚精自出，治五淋，利膀胱热，直通水道。\""}]},{"ID":"20240607105902-iesmd60","Type":"NodeParagraph","Properties":{"id":"20240607105902-iesmd60","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治五劳七伤，主头旋、耳虚鸣，筋骨挛缩，通小肠，止遗沥、尿血。’"}]},{"ID":"20240607105902-jbgc3sk","Type":"NodeParagraph","Properties":{"id":"20240607105902-jbgc3sk","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑤《医学启源》：\"治小便淋沥，去阴间汗。《主治秘诀》云，去旧水，养新水，利小便，消水肿，渗泄止渴。\""}]},{"ID":"20240607105902-9aror7h","Type":"NodeParagraph","Properties":{"id":"20240607105902-9aror7h","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑥李杲：\"去脬中留垢、心下水痞。\""}]},{"ID":"20240607105902-udrcop3","Type":"NodeParagraph","Properties":{"id":"20240607105902-udrcop3","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"渗湿热，行痰饮，止呕吐、泻痢，疝痛，脚气。\""}]},{"ID":"20240607105902-53m3epd","Type":"NodeParagraph","Properties":{"id":"20240607105902-53m3epd","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607105902-c08jhww","Type":"NodeParagraph","Properties":{"id":"20240607105902-c08jhww","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；或入丸、散。"}]},{"ID":"20240607105902-hzhdhir","Type":"NodeParagraph","Properties":{"id":"20240607105902-hzhdhir","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607105902-b07r84y","Type":"NodeParagraph","Properties":{"id":"20240607105902-b07r84y","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" ①治臌胀水肿：白术、泽泻各半两。上为细末，煎服三钱，茯苓汤调下，或丸亦可，服三十丸。（《素问病机保命集》白术散）"}]},{"ID":"20240607105902-0h1kgdk","Type":"NodeParagraph","Properties":{"id":"20240607105902-0h1kgdk","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②治心下有支饮，其人苦冒眩：泽泻五两，白术二两。上二味，以水二升，煮取一升，分温服。（《金匮要略》泽泻汤）"}]},{"ID":"20240607105902-qtb88so","Type":"NodeParagraph","Properties":{"id":"20240607105902-qtb88so","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"③治冒暑霍乱，小便不利，头晕引饮：泽泻、白术、白茯苓各三钱。水-盏，姜五片，灯心十茎，煎八分，温服。（《纲目》三白散）"}]},{"ID":"20240607105902-zzy5xj5","Type":"NodeParagraph","Properties":{"id":"20240607105902-zzy5xj5","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"④治妊娠遍身浮肿，上气喘急，大便不通，小便赤涩：泽泻，桑白皮（炒）、槟榔、赤茯苓各五分。姜水煎服。（《妇人良方》泽泻散）"}]},{"ID":"20240607105902-wkoyb5h","Type":"NodeParagraph","Properties":{"id":"20240607105902-wkoyb5h","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑤治湿热黄疸，面目身黄：茵陈、泽泻各一两，滑石三钱。水煎服。（《千金方》）"}]},{"ID":"20240607105902-fvymmsb","Type":"NodeParagraph","Properties":{"id":"20240607105902-fvymmsb","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑥治寒湿脚气，有寒热者：泽泻、木瓜、柴胡、苍术、猪苓，木通、萆薢各五钱。水煎服。（《外科正宗》）"}]},{"ID":"20240607105902-2fumume","Type":"NodeParagraph","Properties":{"id":"20240607105902-2fumume","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑦治小儿齁蛤，膈上壅热，涎潮：泽泻一分，蝉衣（全者）二十一个，黄明胶（手掌大一片，炙令焦）。上为细末.每服一钱，温米汤调下，日进二服，未愈再服。（《宣明论方》，泽泻散）"}]},{"ID":"20240607105902-3ae5cpm","Type":"NodeParagraph","Properties":{"id":"20240607105902-3ae5cpm","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑧治酒风，身热解惰，汗出如浴，恶风少气：泽泻、术各十分，麋衔五分。合，以三指撮，为后饭。（《素问》）"}]},{"ID":"20240607105902-jwwj4vc","Type":"NodeParagraph","Properties":{"id":"20240607105902-jwwj4vc","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑨治风虚多汗，恶风寒颤：泽泻、防风（去皮）、牡蛎（煅赤）、苍术（米泔浸，去皮，炒）各一两，桂（去租皮）三分。上五味，捣罗为细散。每服二钱匕，温粥饮调下，不计时。（《圣济总录》泽泻散）"}]},{"ID":"20240607105902-eei0r96","Type":"NodeParagraph","Properties":{"id":"20240607105902-eei0r96","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑩治肾脏风生疮：泽泻、皂荚，水煮烂，焙干为末，炼蜜为丸，如桐子大。空心，以温酒下十五丸至二十丸。（《经验方》）"}]},{"ID":"20240607105902-m6btqjx","Type":"NodeParagraph","Properties":{"id":"20240607105902-m6btqjx","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑾治虚劳膀胱气滞，腰中重，小便淋：泽泻一两，牡丹三分，桂心三分，甘草三分（炙微赤，锉），榆白皮三分（锉），白术三分，赤茯苓一两，木通一两（锉）。上药粗捣罗为散。每服三钱，以水一中盏，煎至六分，去滓，食前温服。（《圣惠方》泽泻散）"}]},{"ID":"20240607105902-melni8p","Type":"NodeParagraph","Properties":{"id":"20240607105902-melni8p","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑿治五种腰痛：泽泻半两，桂（去粗皮）三分，白术、白茯苓（去黑皮）、甘草（炙，锉）各一两，牛膝（酒浸，切，焙）、干姜（炮）各半两，杜仲（去粗皮，锉，炒）三分。上八味，粗捣筛。每服三钱匕，水一盏，煎至七分，去滓，空心、日午，夜卧温服。（《圣济总录》泽泻汤）"}]},{"ID":"20240607105902-u26kjzo","Type":"NodeParagraph","Properties":{"id":"20240607105902-u26kjzo","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⒀水湿肿胀。用白术、泽泻各一两，共三工业区末，或做成丸子。每服三钱，茯苓汤送下。"}]},{"ID":"20240607105902-a6lamko","Type":"NodeParagraph","Properties":{"id":"20240607105902-a6lamko","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⒁暑天吐泻（头晕，渴饮，小便不利）。用泽泻、白术，白茯苓各三钱，加水一碗、姜五片、类灯心十根，煎至八成，温服。"}]},{"ID":"20240607105902-rp2qdza","Type":"NodeParagraph","Properties":{"id":"20240607105902-rp2qdza","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607105902-wmc58z5","Type":"NodeParagraph","Properties":{"id":"20240607105902-wmc58z5","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽泻叶"},{"Type":"NodeText","Data":"治风疾、难产，乳汁不出等症；泽泻实治风痹消渴，益肾气，除邪湿。"}]},{"ID":"20240607105902-r8t4puq","Type":"NodeParagraph","Properties":{"id":"20240607105902-r8t4puq","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607105902-8if55x5","Type":"NodeParagraph","Properties":{"id":"20240607105902-8if55x5","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义》：\"泽泻，其功尤长于行水。张仲景曰，水蓄渴烦，小便不利，或吐或泻，五苓散主之。方用泽泻，故知其用长于行水。《本经》又引扁鹊云，多服病人眼涩，诚为行去其水。张仲景八味丸用之者，亦不过引接桂、附等归就肾经，别无他意。凡服泽泻散人，未有不小便多者；小便既多，肾气焉得复实?今人止泄精，多不敢用。\""}]},{"ID":"20240607105902-ewajb87","Type":"NodeParagraph","Properties":{"id":"20240607105902-ewajb87","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"②《医经溯洄集》：\"张仲景八味丸用泽泻，寇宗爽《本草衍义》云，不过接引桂、附等归就肾经，别无他意。愚谓地黄、山茱萸、白茯苓、牡丹皮皆肾经之药，固不待泽泻之接引而后至也，附子乃右肾命门之药，官桂能补下焦相火不足，亦不待乎泽泻之接引而后至矣。唯干山药虽独入手太阴经，然其功亦能强阴，且手太阴为足少阴之上原，原既有滋，流岂无益，且泽泻虽咸以泻肾，乃泻肾邪，非泻肾之本也，故五苓散用泽泻者，讵非泻肾邪乎?白茯苓亦伐肾邪，即所以补正耳。是则八味丸之用泽泻者非他，盖取其泻肾邪，养五脏，益气力，起阴气，补虚损之功。\""}]},{"ID":"20240607105902-0k0uh82","Type":"NodeParagraph","Properties":{"id":"20240607105902-0k0uh82","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"③《本草蒙筌》：\"泽泻，多服虽则目昏，暴服亦能明目，其义何也?盖泻伏水，去留垢，故明目；小便利，肾气虚，故目昏。二者不可不知。\""}]},{"ID":"20240607105902-l0hl1lz","Type":"NodeParagraph","Properties":{"id":"20240607105902-l0hl1lz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"泽泻，气平，味甘而淡，淡能渗泄，气味俱薄，所以利水而泄下。脾胃有湿热，则头重而目昏耳鸣，泽泻渗去其湿，则热亦随去，而土气得令，消气上行，天气明爽，故泽泻有养五脏、益气力、治头旋，聪明耳目之功，若久服则降令太过，清气不升，真阴潜耗，安得不目昏耶?仲景地黄丸，用茯苓、泽泻者，乃取其泻膀胱之邪气，非引接也，古人用补药，必兼泻邪，邪去则补药得力，一辟一阖，此乃玄妙，后世不知此理，专一于补，所以久服必至偏胜之害也。\"\"神农书列泽泻于上品，复云久服轻身、面生光，陶、苏皆以为信然，愚窃疑之。泽泻行水泻肾，久服且不可，又安有此神功耶，其谬可知。\""}]},{"ID":"20240607105902-v8ub5j1","Type":"NodeParagraph","Properties":{"id":"20240607105902-v8ub5j1","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑤《本草汇言》：\"方龙潭云，泽泻有固肾治水之功，然与猪苓又有不同者。盖猪苓利水，能分泄表间之邪；泽泻利水，能宣通内脏之湿。\"\"泽泻，利水之主药。利水，人皆知之矣；丹溪又谓能利膀胱、包络之火，膀胱包络有火，病癃闭结胀者。火泻则水行，行水则火降矣，水火二义，并行不悖。\""}]},{"ID":"20240607105902-rdkbtj4","Type":"NodeParagraph","Properties":{"id":"20240607105902-rdkbtj4","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑥《本草通玄》：\"《别录》称其止遗泄，而寇氏谓泄精者不敢用，抑何相刺谬也?盖相火妄动而遗泄者，得泽泻清之而精自藏，气虚下陷而精滑者，得泽泻降之而精愈滑矣。\""}]},{"ID":"20240607105902-swwxau3","Type":"NodeParagraph","Properties":{"id":"20240607105902-swwxau3","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑦《药品化义》：\"凡属泻病，小水必短数，以此（泽泻）清润肺气，通调水道，下输膀胱，主治水泻湿泻，使大便得实，则脾气自健也。因能利水道，令邪水去，则真水得养，故消渴能止。又能除湿热，通淋沥，分消痞满，透三焦蓄热停水，此为利水第一良品。若小便不通而口渴者，热在上焦气分，宜用泽泻、茯苓以清肺气，滋水之上源也。如口不渴者，热在下焦血分，则用知母、黄柏，以泻膀胱，滋水之下源也。须分别而用。\""}]},{"ID":"20240607105902-rvapadz","Type":"NodeParagraph","Properties":{"id":"20240607105902-rvapadz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"⑧《本草正义》：\"泽泻，最善渗泄水道，专能通行小便。《本经》气味虽曰甘寒，兼以其生长水泽，因谓之寒，其实轻淡无味，甘于何有?此药功用，惟在淡则能通，《本经》称其治风寒湿痹，亦以轻能入络，淡能导湿耳，云治风寒，殊非其任。其能治乳难者，当以娩后无乳者言，此能通络渗泄，则可下乳汁。非产乳百病之通用品。…其兼能滑痰化饮者，痰饮亦积水停湿为病，惟其滑利，故可消痰。总之，渗泄滑泻之药，必无补养之理，《本经》养五脏，益气力云云，已属溢美太过，而甄权竟谓可治肾虚精自出，大明且谓补女人血海，令人有子，洁古亦谓入肾经，去旧水，养新水。皆非药理之真。\""}]},{"ID":"20240607105902-cxmn2ju","Type":"NodeParagraph","Properties":{"id":"20240607105902-cxmn2ju","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105902-imgnp35","Type":"NodeParagraph","Properties":{"id":"20240607105902-imgnp35","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607105902-gw2m5dw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105902-gw2m5dw","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"《中华本草》：泽泻"}]},{"ID":"20240607105902-d9ha7ww","Type":"NodeParagraph","Properties":{"id":"20240607105902-d9ha7ww","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105902-mhcah47","Type":"NodeParagraph","Properties":{"id":"20240607105902-mhcah47","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" Zé Xiè"}]},{"ID":"20240607105902-y3l603e","Type":"NodeParagraph","Properties":{"id":"20240607105902-y3l603e","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105902-dc6g388","Type":"NodeParagraph","Properties":{"id":"20240607105902-dc6g388","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 水泻、芒芋、鹄泻、泽芝、及泻、天鹅蛋、天秃、禹孙"}]},{"ID":"20240607105902-inryuyg","Type":"NodeParagraph","Properties":{"id":"20240607105902-inryuyg","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607105902-gjv1zvq","Type":"NodeParagraph","Properties":{"id":"20240607105902-gjv1zvq","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" Oriental Waterplantain Rhizome, Rhizome of Oriental Waterplantain"}]},{"ID":"20240607105902-pjznah8","Type":"NodeParagraph","Properties":{"id":"20240607105902-pjznah8","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607105902-52d27r0","Type":"NodeParagraph","Properties":{"id":"20240607105902-52d27r0","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240607105902-yzqrj0w","Type":"NodeParagraph","Properties":{"id":"20240607105902-yzqrj0w","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105902-amhlhf0","Type":"NodeParagraph","Properties":{"id":"20240607105902-amhlhf0","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 药材基源：为泽泻科植物泽泻的块茎。"}]},{"ID":"20240607105902-25h6oiq","Type":"NodeParagraph","Properties":{"id":"20240607105902-25h6oiq","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Alisma orientale (Sam.) Juz. [A. plantago-aquatica L. var. orientale Sam.]"}]},{"ID":"20240607105902-4t2camp","Type":"NodeParagraph","Properties":{"id":"20240607105902-4t2camp","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"采收和储藏：地移栽当年12月下旬，大部分叶片枯黄时收获，挖出块茎，除去泥土、茎叶，留下中心小叶，以免干燥时流出黑汁液，用无烟煤火炕干，趁热放在筐内，撞掉须根和粗皮。"}]},{"ID":"20240607105902-7likdhf","Type":"NodeParagraph","Properties":{"id":"20240607105902-7likdhf","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607105902-4nwi14b","Type":"NodeParagraph","Properties":{"id":"20240607105902-4nwi14b","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于沼泽边缘或栽培。"}]},{"ID":"20240607105902-397kkly","Type":"NodeParagraph","Properties":{"id":"20240607105902-397kkly","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华东、西南及河北、新疆、河南等地。"}]},{"ID":"20240607105902-mkhkbd3","Type":"NodeParagraph","Properties":{"id":"20240607105902-mkhkbd3","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607105902-c3qrv3p","Type":"NodeParagraph","Properties":{"id":"20240607105902-c3qrv3p","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 泽泻，多年生沼生植物，高50-100cm。地下有块茎，球形，直径可达4.5cm， 外皮褐色，密生多数须根。叶根生；叶柄长达50cm，基部扩延成中鞘状，宽5-20mm ;叶片宽椭圆形至卵形，长5-18cm ，宽2-10cm，先端急尖或短尖，基部广楔形、圆形或稍心形，全缘，两面光滑；叶脉5-7条。花茎由叶丛中抽出，长10-100cm，花序通常有3-5轮分枝，分枝下有披针形或线形苞片，轮生的分枝常 再分枝，组成圆锥状复伞形花序，小花梗长短不等；小苞片披针形至线形，尖锐；萼片3，广卵形，绿色或稍带紫色，长2-3mm，宿存；花瓣倒卵形，膜质，较萼片小，白色，脱落；雄蕊6；雌蕊多数，离生；子房倒卵形，侧扁，花柱侧生。瘦果多数，扁平，倒卵形，长1.5-2mm，宽约1mm，背部有两 浅沟，褐色，花柱宿存。花期6-8月，果期7-9月。"}]},{"ID":"20240607105902-xdv7lt8","Type":"NodeParagraph","Properties":{"id":"20240607105902-xdv7lt8","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607105902-tl7kc82","Type":"NodeParagraph","Properties":{"id":"20240607105902-tl7kc82","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润的气候，幼苗喜荫蔽，成株喜阳光，怕寒冷，在海拔800m以下地区，一般都可栽培。宜选阳光充足，腐殖质丰富，而稍带粘性的土壤，同时有可靠水源的水田栽培，前作为稻或中稻，质地过砂或土温低的冷浸田不宜种植。"}]},{"ID":"20240607105902-5yfzqlu","Type":"NodeParagraph","Properties":{"id":"20240607105902-5yfzqlu","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。先培育种子，再育苗移栽。种子培育是将经过选择的种株挖出，用分芽繁殖或块茎繁殖另行栽培，收得成熟种子。播种前将种子用清水浸泡24-48h，晾干水气，与草木灰拌合。播放期 ，四川在6月中旬-7月上旬，福建在7月上旬，江西在7月下旬，撒播，5d左右，大部分萌芽。一般育苗1hm2，可栽种25hm2左右。移栽期一般在8月，选17-20cm的秋苗，按行株距（30-33）cm ×（24-27）cm ， 每穴栽苗一株，苗入泥中3-4cm.田间管理 移栽后，3-5d内应及时检查，如有缺株，应重新补苗，整个生长期中，中耕除草3-4次，与施肥结合进行，用人畜粪水，也可用厩肥与尿素拌合施用。施用前先排水，施后中耕除草，隔1-2d后灌水。宜浅水灌溉，不同阶段，掌握不同的灌水深度。移栽后灌水深2-3cm ，生长旺盛期灌水深3-5cm，在块茎膨大时期应减水田，使田内呈“花花水面”。11月上旬逐渐排干。9月中旬逐渐抽出花苔和侧芽，须及进摘除。"}]},{"ID":"20240607105902-godl9r7","Type":"NodeParagraph","Properties":{"id":"20240607105902-godl9r7","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"病虫害防治：病害有白斑病，为害叶片，可于播种前用40%甲醛80倍液浸种5min，洗 净晾干后播种粉1000倍液，每7-10d1次，连喷2-3次。虫害有莲缢管蚜为害叶柄、嫩茎，可用化学药剂喷杀。银蚊夜蛾幼虫咬食叶片，用90%敌百虫1000倍液喷杀。"}]},{"ID":"20240607105902-9vdgcd0","Type":"NodeParagraph","Properties":{"id":"20240607105902-9vdgcd0","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607105902-3p1i9k9","Type":"NodeParagraph","Properties":{"id":"20240607105902-3p1i9k9","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 块茎类球形、椭圆形或卵圆形、长2-7cm，直径2-6cm。表面黄白色或淡黄棕色，有不规则的横向环状浅沟纹及多数细小突起的须根痕，底部有的有瘤状芽痕。质坚实，断面黄白色，粉性，有多数细孔。气微，味微苦。以块大、黄白色、光滑、质充实、粉性足者为佳。"}]},{"ID":"20240607105902-lzhml1r","Type":"NodeParagraph","Properties":{"id":"20240607105902-lzhml1r","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"显微鉴别 块茎横切面：外皮大多已除去，有残留的皮层通气组织，细胞间隙甚大，内侧可见1列内皮层细胞，壁增厚，木化，有纹孔。中柱通气组织中散有周木型维管束和淡黄色的油室。薄壁细胞含有淀粉粒。"}]},{"ID":"20240607105902-mxixxnv","Type":"NodeParagraph","Properties":{"id":"20240607105902-mxixxnv","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡黄棕色。①淀粉粒甚多，单粒长卵形、球形或椭圆形，直径3-14μm ，脐点人字块、短缝状或三叉状；复粒由2-3分粒组成。②薄壁细胞多角形，具多数椭圆形纹孔，集成纹孔群。③内皮层细胞垂周壁弯曲，较厚，木化，有稀疏细孔沟。④油室大多破碎，完整者类圆形，直径54-110μm，分泌细胞中有时可见油滴。"}]},{"ID":"20240607105902-z36of04","Type":"NodeParagraph","Properties":{"id":"20240607105902-z36of04","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"品质标志 《中华人民共和国药典》1995年版规定：本品总灰分不得过5.0%，酸不溶性灰分不得过0.5%。"}]},{"ID":"20240607105902-0i5bpzg","Type":"NodeParagraph","Properties":{"id":"20240607105902-0i5bpzg","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"商品规格 根据主产地福建、四川，分为建泽泻和川泽泻等。建泽泻分三等，一等每1kg32个以内；二等每1kg56以内；三等每1kg56个以外，间有双花、轻微焦枯，但不超过10%。"}]},{"ID":"20240607105902-1alb57m","Type":"NodeParagraph","Properties":{"id":"20240607105902-1alb57m","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"川泽泻分二等，一等每1kg50个以内；二等每1kg50个以外，最小直径不小于2cm，间有少量焦枯、碎块，但不超过10%。"}]},{"ID":"20240607105902-yvbnusp","Type":"NodeParagraph","Properties":{"id":"20240607105902-yvbnusp","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"出口商品建泽演以个头大小分为5-80头；川泽泻按个头分一、二级；江西泽泻按个头分为四级。"}]},{"ID":"20240607105902-2q8bvp4","Type":"NodeParagraph","Properties":{"id":"20240607105902-2q8bvp4","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607105902-8svk4q3","Type":"NodeParagraph","Properties":{"id":"20240607105902-8svk4q3","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 毒性T（1．1．1．1）对小白鼠静脉注射的半数致死量为780mg/kg，腹腔注射为1270mg/kg，口服为4000mg/kg。按0.1%及1%浓度混于饮食中，饲大鼠2个半月，体重、内脏重量、肝脂肪量均无明显改变。泽泻含有刺激性物质内服可引起胃肠炎，贴于皮肤引起发泡，其叶可作为皮肤发红剂。羊吃此植物无害，而牛可引起中毒，表现血尿。 泽泻甲醇提取物小鼠静脉注射和腹腔注射的半数致死量分别为0.98和1.27g/kg。口服4.0g/kg。按1%比例拌于饲料中喂大鼠75天，未见明显毒性。以泽泻醇浸剂100mg/kg小鼠腹腔注射，观察72小时，无一死亡。以泽泻浸膏粉1g和2g/kg（相当临床用量的20和40倍）拌于饲料中喂大鼠，共3月，动物一般健康状况良好，体重增长，血清谷一丙转氨酶活性及血红蛋白量均与对照组无显着差异，但病理检查发现肝细胞和肾近曲小管细胞有不同程度的浊肿和变性，给药组比对照组明显，大剂量组比小剂量组明显，提水可能与给药有关，但心脏组织未见明显变化。"}]},{"ID":"20240607105902-tzvu9rq","Type":"NodeParagraph","Properties":{"id":"20240607105902-tzvu9rq","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607105902-jcd4xtx","Type":"NodeParagraph","Properties":{"id":"20240607105902-jcd4xtx","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 块茎含泻醇（alisol）A、B、C、泽泻醇A单乙酸酯（alisol A monoacetate），泽泻醇B单乙酸酯（alisol B monoacetate），泽泻醇C单乙酸醋（alisol C monoacetate）表泽泻醇（epialisol）A，泽泻薁醇（alismol），泽泻薁醇氧化物（alismoxide），16β-甲氧基泽泻醇B单乙酸酯（16β-methocyal-isol B monoacetate），16β-羟基泽泻醇B单乙酸酯 （16β-hydroxyal-isol B monoacetate），谷甾醇-3-O-硬脂酰基 -β-D-吡喃葡萄糖甙（sitosterol-3-O-steroyl-β-D-glucopyranoside）。还含胆碱（cho-line），糖和钾、钙、镁等元素。"}]},{"ID":"20240607105902-xn6sbxz","Type":"NodeParagraph","Properties":{"id":"20240607105902-xn6sbxz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607105902-6t5uukm","Type":"NodeParagraph","Properties":{"id":"20240607105902-6t5uukm","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 1.降血脂作用：泽泻的脂溶性部份对实验性高胆固醇血症家兔有明显的降胆固醇作用和抗动脉粥样硬化作用，由其中分离得的泽泻醇A、B及泽泻醇A、B、C的乙酸酯，除泽泻醇B外，都有显着的降胆固醇作用。以0.1%的含量加入实验性高脂血症大鼠的饲料中，可使血胆固醇下降50%以上，其中以泽泻醇A－24－乙酸酯作用最强。泽泻的乙醇提取物、乙醇浸膏的乙酸乙酯提取物等，对实验性高胆固醇血症家兔和大鼠都有降血脂作用。乙酸乙酯提取物和其不溶于醋酸一水中的残留部分作用最强。醋酸乙酯提取物每日口服1g/kg，对饲以普通饲料的正常大鼠亦有明显的降胆固醇作用。用同位表标记法证明，泽泻醇A有抑制小鼠小肠酯化胆固醇的能力，并可使胆固醇在大鼠小肠内的吸收率降低34%，但不影响亚油酸的吸收。"}]},{"ID":"20240607105902-xtwqkdg","Type":"NodeParagraph","Properties":{"id":"20240607105902-xtwqkdg","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"2.对肝脏的保护作用：泽泻醇A乙酸酯、泽泻醇B乙酸酯和泽泻醇C乙酸酯可保护因四氯化碳中毒的小鼠肝脏，其中以泽泻醇C乙酸酯效果最好。"}]},{"ID":"20240607105902-hfvpvy6","Type":"NodeParagraph","Properties":{"id":"20240607105902-hfvpvy6","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的作用：泽泻浸膏给犬和家兔静脉注射，有轻度降压作用，并持续约30分钟左右。泽泻摩醇对各种实验动物有轻度降压作用，其降压作用并不明显影响血浆肾素和ACE活性或醛固酮水平。泽泻醇提物在体外对肾上腺素引起的兔离体主动脉条件收缩有缓慢的松弛作用。泽泻摩醇可抑制由血管紧张素引起的家兔主动脉条的收缩，其收缩作用具有剂量依赖性。泽泻摩醇用离体心脏灌流技术可见减少心输出量和心率以及左心室压力，但可增加冠脉流量。"}]},{"ID":"20240607105902-mrtc0ga","Type":"NodeParagraph","Properties":{"id":"20240607105902-mrtc0ga","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"4.利尿作用：用盐水负载的小鼠或大鼠做利尿实验，小鼠皮下注射泽泻醇A乙酸酯100mg/kg能增加尿液中K+的分泌量，但口服同样剂量则无效。大鼠口服泽泻醇A乙酸酯或泽泻醇B 30mg/kg剂量时，明显增加Na+的分泌量，与对照组比较P\u003c0.05和P\u003c0.01。"}]},{"ID":"20240607105902-h2pz04v","Type":"NodeParagraph","Properties":{"id":"20240607105902-h2pz04v","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105902-hn6jwe1","Type":"NodeParagraph","Properties":{"id":"20240607105902-hn6jwe1","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 除去茎叶及须根，洗净，用微火烘干，再撞去须根及粗皮。"}]},{"ID":"20240607105902-wbr4d3a","Type":"NodeParagraph","Properties":{"id":"20240607105902-wbr4d3a","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"1.泽泻：拣去杂质，大小分档，用水浸泡，至八成透捞出，晒晾，闷润至内外湿度均匀，切片，晒干。"}]},{"ID":"20240607105902-6ybl8gz","Type":"NodeParagraph","Properties":{"id":"20240607105902-6ybl8gz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"2.麸制：取麸皮，撒入锅内，待起烟时，加入泽泻片，拌炒至黄色，取出，筛去麸皮，放凉。每泽泻片100kg，用麸皮10kg。"}]},{"ID":"20240607105902-ikkilfr","Type":"NodeParagraph","Properties":{"id":"20240607105902-ikkilfr","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"3.盐麸制：取泽泻片，用盐匀润湿，晒干，再加入蜜制麸皮，按麸炒制法炮制，每泽泻500kg，用盐6kg；用麦麸60kg。水适量。"}]},{"ID":"20240607105902-tgwiwgx","Type":"NodeParagraph","Properties":{"id":"20240607105902-tgwiwgx","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"4.酒制：在100度热锅中加泽泻片，翻炒数次，用酒喷匀，炒干，取出放冷即可。每泽泻100kg，用酒5kg。"}]},{"ID":"20240607105902-xfsmnti","Type":"NodeParagraph","Properties":{"id":"20240607105902-xfsmnti","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"5.盐泽泻：取泽泻片，用盐水喷洒拌匀，稍闷润，置锅内用文火微炒至表面略现黄色取出，晾干。（每泽泻片100斤，用盐二斤八两，加适量开水化开澄清）《雷公炮炙论》：细锉，酒浸一宿，漉出，暴干任用。"}]},{"ID":"20240607105902-c9jd2o3","Type":"NodeParagraph","Properties":{"id":"20240607105902-c9jd2o3","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607105902-rm0krhx","Type":"NodeParagraph","Properties":{"id":"20240607105902-rm0krhx","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 归肾；膀胱经"}]},{"ID":"20240607105902-gq43t2z","Type":"NodeParagraph","Properties":{"id":"20240607105902-gq43t2z","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105902-22p5ry8","Type":"NodeParagraph","Properties":{"id":"20240607105902-22p5ry8","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 味甘；淡；性寒"}]},{"ID":"20240607105902-20ubebg","Type":"NodeParagraph","Properties":{"id":"20240607105902-20ubebg","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607105902-lgi6uul","Type":"NodeParagraph","Properties":{"id":"20240607105902-lgi6uul","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 肾虚精滑无湿热者禁服。"}]},{"ID":"20240607105902-2ly9p5z","Type":"NodeParagraph","Properties":{"id":"20240607105902-2ly9p5z","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105902-3zfe7td","Type":"NodeParagraph","Properties":{"id":"20240607105902-3zfe7td","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 利水渗湿；泄热通淋。主小便不利；热淋涩痛；水肿胀满；泄泻；痰饮眩晕；遗精"}]},{"ID":"20240607105902-ash2b1y","Type":"NodeParagraph","Properties":{"id":"20240607105902-ash2b1y","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607105902-4efyidn","Type":"NodeParagraph","Properties":{"id":"20240607105902-4efyidn","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-12g；或入丸、散。"}]},{"ID":"20240607105902-a5l74ej","Type":"NodeParagraph","Properties":{"id":"20240607105902-a5l74ej","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607105902-9602obe","Type":"NodeParagraph","Properties":{"id":"20240607105902-9602obe","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 泽泻汤《金匮要略》；泽泻汤《圣济总录》；三白散《本草纲目》；泽泻散《妇人良方》；泽泻散《宣明论方》"}]},{"ID":"20240607105902-8ue7zgs","Type":"NodeParagraph","Properties":{"id":"20240607105902-8ue7zgs","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607105902-si377nl","Type":"NodeParagraph","Properties":{"id":"20240607105902-si377nl","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》；泽泻，其功尤长于行水。 张仲景曰，水蓄渴烦，小便不利，或吐或泻，五苓散主之。方 用泽泻，故知其用长于行水。《本经》又引扁鹊云，多服病人眼涩，诚为行去其水。张仲景八味丸用之者，亦不过引接桂、附等归就肾经，别无他意。凡服泽泻散人，未有不小便多者；小便既多，肾气焉得复实？今人止泄精，多不敢用。"}]},{"ID":"20240607105902-t6bvyie","Type":"NodeParagraph","Properties":{"id":"20240607105902-t6bvyie","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"2.《医经溯洄集》：张仲景八味丸用泽泻，寇宗奭《本草衍义》云，不过接引桂、附等归就肾经，别无他意。愚谓地黄、山茱萸、白茯苓、牡丹皮皆肾经之药，固不待泽泻之接引而后至也。附子乃右肾命门之药，官桂能补下焦相火不足，亦不待乎泽泻之接引而后至矣。唯干山药虽独入手太阴经，然其功亦能强阴，且手太阴为足少阴之上原，原既有滋，流岂无益？且泽泻虽咸似泻肾，乃泻肾邪，非泻肾之本也，故五苓散用泽泻者，讵非泻肾邪乎？白茯苓亦伐肾邪，即所以补正耳。是则八味丸之用泽泻者非他，盖取其泻肾邪，养五脏，益气力，起阴气，补虚损之功。"}]},{"ID":"20240607105902-glj039j","Type":"NodeParagraph","Properties":{"id":"20240607105902-glj039j","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"3.《本草蒙筌》：泽泻，多服虽则目昏，暴服亦能明目，其义何也？盖泻伏水，去留垢，故明目；小便利，肾气虚，故目昏。二者不可不知。"}]},{"ID":"20240607105902-43f1oqe","Type":"NodeParagraph","Properties":{"id":"20240607105902-43f1oqe","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：泽泻，气平，味甘而淡，淡能渗泄，气味俱薄，所以利水而泄下。脾胃有湿热，则头重而目昏耳鸣，泽泻渗去其湿，则热亦随去，而土气得令，清气上行，天气明爽，故泽泻有养五脏、益气力、治头旋，聪明耳目之功，若久服则降令太过，清气不升，真阴潜耗，安得不目昏耶？仲景地黄丸，用茯苓、泽泻者，乃取其泻膀胱之邪气，非引接也，古人用补药，必兼泻邪，邪去则补药得力，一辟一阖，此乃玄妙，后世不知此理，专一于补，所以久服必至偏胜之害也。神农书列泽泻于上品，复云久服轻身、面生光，陶、苏皆以为信然，愚窃疑之。泽泻行水泻肾，久服且不可，又安有此神功耶，其谬可知。"}]},{"ID":"20240607105902-ab4cg4i","Type":"NodeParagraph","Properties":{"id":"20240607105902-ab4cg4i","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"5.《本草汇言》：方龙潭云，泽泻有固肾治水之功，然与猪苓又有不同者，盖猪苓利水，能分泄表间之邪；泽泻利水，能宣通内脏之湿。泽泻，利水之主药。利水，人皆知之矣：丹溪又谓能利膀胱、包络之火，膀胱包络有火，病癃闭结胀者，火泻则水行，行水则火降矣，水火二义，并行不悖。"}]},{"ID":"20240607105902-12zsksw","Type":"NodeParagraph","Properties":{"id":"20240607105902-12zsksw","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"6.《本草通玄》：《别录》称其止遗泄，而寇氏谓泄精者不敢用，抑何相刺谬也？盖相火妄动而遗泄者，得泽泻清之而精自藏，气虚下陷而精滑者，得泽泻降之而精愈滑矣。"}]},{"ID":"20240607105902-3gj7xtp","Type":"NodeParagraph","Properties":{"id":"20240607105902-3gj7xtp","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"7.《药品化义》：凡属泻病，小水必短数，以此（泽泻）清润肺气，通调水道，下输膀胱，主治水泻湿泻，使大便得实，则脾气自健也。因能利水道，令邪水去，则真水得养，故消渴能止。又能除湿热，通淋沥，分消痞满，透三焦蓄热停水，此为利水第一良品。"}]},{"ID":"20240607105902-1vp4utx","Type":"NodeParagraph","Properties":{"id":"20240607105902-1vp4utx","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"8.《本草正义》：泽泻，最善渗泄水道，专能通行小便。《本经》气味虽曰甘寒，兼以其生长水泽，因谓之寒，其实轻淡无味，甘于何有？此药功用，惟在淡则能通，《本经》称其治风寒湿痹，亦以轻能入络，淡能导湿耳，云治风寒，殊非其任。其能治乳难者，当以娩后无乳者言，此能通络渗泄，则可下乳汁，非产乳百病之通用品。其兼能滑痰化饮者，痰饮亦积水停湿为病，惟其滑利，故可消痰。总之，渗泄滑泻之药，必无补养之理。《本经》养五脏，益气力云云，已属溢美太过，而甄权竟谓可治肾虚精自出，大明且谓补女人血海，令人有子，洁古亦谓入肾经，去旧水，养新水。皆非药理之真。"}]},{"ID":"20240607105902-5636ygo","Type":"NodeParagraph","Properties":{"id":"20240607105902-5636ygo","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"9.《本经》：主风寒湿痹，乳难，消水，养五脏，益气力，肥健。"}]},{"ID":"20240607105902-l4mpww9","Type":"NodeParagraph","Properties":{"id":"20240607105902-l4mpww9","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"10.《别录》：补虚损五劳，除五脏痞满，起阴气，止泄精、消渴、淋沥，逐膀胱、三焦停水。"}]},{"ID":"20240607105902-bgqrrhh","Type":"NodeParagraph","Properties":{"id":"20240607105902-bgqrrhh","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"11.《药性论》：主肾虚精自出，治五淋，利膀胱热，宣通水道。"}]},{"ID":"20240607105902-acct8j8","Type":"NodeParagraph","Properties":{"id":"20240607105902-acct8j8","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：治五劳七伤，主头旋、耳虚鸣，筋骨孪缩，通小肠，止遗沥、尿血。"}]},{"ID":"20240607105902-kdktpsz","Type":"NodeParagraph","Properties":{"id":"20240607105902-kdktpsz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"13.《医学启源》：治小便淋沥，去阴间汗。《主治秘诀》云， 去旧水，养新水，利小便，消水肿，渗泄止渴。"}]},{"ID":"20240607105902-v2n9rau","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607105902-v2n9rau","updated":"20240607105902"},"Children":[{"ID":"20240607105902-djadqi7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTQu","Num":14},"Properties":{"id":"20240607105902-djadqi7","updated":"20240607105902"},"Children":[{"ID":"20240607105902-pnyj6uv","Type":"NodeParagraph","Properties":{"id":"20240607105902-pnyj6uv","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"李杲：去脬中留垢、心下水痞。"}]}]}]},{"ID":"20240607105902-e9p0unz","Type":"NodeParagraph","Properties":{"id":"20240607105902-e9p0unz","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"15.《纲目》：渗湿热，行痰饮，止呕吐、泻痢，疝痛，脚气。"}]},{"ID":"20240607105902-05vvgvf","Type":"NodeParagraph","Properties":{"id":"20240607105902-05vvgvf","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105902-g9rqrce","Type":"NodeParagraph","Properties":{"id":"20240607105902-g9rqrce","updated":"20240607105902"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607105905-t5ff0m6","Type":"NodeThematicBreak","Properties":{"id":"20240607105905-t5ff0m6"}},{"ID":"20240607105906-4kpcs3s","Type":"NodeParagraph","Properties":{"id":"20240607105906-4kpcs3s"}}]}