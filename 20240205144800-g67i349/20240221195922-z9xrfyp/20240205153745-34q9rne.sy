"Properties":{"parent-style":"width: 518px;","style":"width: 508px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茵陈"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茵陈-20240805150305-658jp27.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 508px;\" parent-style=\"width: 518px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805154814-ct6n899","Type":"NodeParagraph","Properties":{"id":"20240805154814-ct6n899","updated":"20240805155904"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茵陈 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茵陈 4-20240805154814-r05sg9e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 339px;","style":"width: 329px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茵陈 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茵陈 5-20240805155904-lrd5vtn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 329px;\" parent-style=\"width: 339px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 351px;","style":"width: 341px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茵陈 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茵陈 6-20240805155946-wc3ds8u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 341px;\" parent-style=\"width: 351px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805153749-b4s4l4s","Type":"NodeParagraph","Properties":{"id":"20240805153749-b4s4l4s","updated":"20240807175654"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茵陈 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茵陈 1-20240805154309-dznnkfl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"茵陈 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/茵陈 2-20240805154350-uhwf05w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805142947-i8b8cup","Type":"NodeParagraph","Properties":{"id":"20240805142947-i8b8cup","updated":"20240805160259"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：真正的茵陈极苦；茵陈蒿的叶子颜色较深；"}]},{"ID":"20240805154642-tzk7j7s","Type":"NodeParagraph","Properties":{"id":"20240805154642-tzk7j7s","updated":"20240822171948"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：关于白蒿跟茵陈网络说法不一，有说白蒿跟茵陈是同一株植物（取自‘三月茵陈四月蒿，五月六月当柴烧’的顺口溜），也有说白蒿跟茵陈不是同一株植物，说法是真正的茵陈是开黄色花朵；目前觉得抖音创作者“"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"嵩山采药人"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"”说法，与神农本草经的性味记载较为匹配，故该茵陈取图为‘"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"黄花茵陈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"’"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"（实际请以个人临床经验为准）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，以下附上视频；如需对比白蒿，点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240504154555-ncxboqq","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"045白蒿"}]},{"ID":"20240805150122-nknbqei","Type":"NodeVideo","Data":"\u003cvideo controls=\"controls\" src=\"assets/茵陈蒿纠正-20240805150107-3p0q5w7.mp4\" data-src=\"assets/茵陈蒿纠正-20240805150107-3p0q5w7.mp4\"\u003e\u003c/video\u003e","Properties":{"id":"20240805150122-nknbqei","updated":"20240805150122"}},{"ID":"20240616170846-yt14jtu","Type":"NodeThematicBreak","Properties":{"id":"20240616170846-yt14jtu"}},{"ID":"20240616170917-5y1wmpm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170917-5y1wmpm","updated":"20240616170921"},"Children":[{"Type":"NodeText","Data":"茵陈《神农本草经》"}]},{"ID":"20240616170917-gklsr28","Type":"NodeParagraph","Properties":{"id":"20240616170917-gklsr28","updated":"20240616170917"},"Children":[{"Type":"NodeText","Data":"（《御览》作茵蒿）"}]},{"ID":"20240616170917-kgo47sw","Type":"NodeParagraph","Properties":{"id":"20240616170917-kgo47sw","updated":"20240616170917"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240616170917-be4a2o1","Type":"NodeParagraph","Properties":{"id":"20240616170917-be4a2o1","updated":"20240616170917"},"Children":[{"Type":"NodeText","Data":"主风湿寒热，邪气，热结黄疸。久服轻身，益气耐老（《御览》作能老）。生邱陵阪岸上。"}]},{"ID":"20240616170917-1l9t2ad","Type":"NodeParagraph","Properties":{"id":"20240616170917-1l9t2ad","updated":"20240616170917"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：因尘，神农岐伯雷公苦无毒，黄帝辛无毒，生田中，叶如蓝，十一月采（《御览》）。"}]},{"ID":"20240616170917-bon8go0","Type":"NodeParagraph","Properties":{"id":"20240616170917-bon8go0","updated":"20240616170917"},"Children":[{"Type":"NodeText","Data":"《名医》曰：白兔食之仙，生太山，五月及立秋采，阴干。"}]},{"ID":"20240616170917-zklx01w","Type":"NodeParagraph","Properties":{"id":"20240616170917-zklx01w","updated":"20240616170917"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：因尘，马先也；陶宏景云：仙经云，白蒿，白兔食之仙，而今茵陈乃云此，恐非耳；陈藏器云：茵陈，经冬不死，因旧苗而生，故名茵陈，后加蒿字也，据此，知旧作茵陈篙，非；又按《广雅》云：马先，疑即马新蒿，亦白蒿之类。"}]},{"ID":"20240616170933-oocbzt6","Type":"NodeThematicBreak","Properties":{"id":"20240616170933-oocbzt6"}},{"ID":"20240616170935-2195rkr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170935-2195rkr","updated":"20240616170941"},"Children":[{"Type":"NodeText","Data":"茵陈《本草从新》"}]},{"ID":"20240616170935-iewdi7o","Type":"NodeParagraph","Properties":{"id":"20240616170935-iewdi7o","updated":"20240616170935"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、利湿热、治诸黄．"}]},{"ID":"20240616170935-mh8wiei","Type":"NodeParagraph","Properties":{"id":"20240616170935-mh8wiei","updated":"20240616170935"},"Children":[{"Type":"NodeText","Data":"苦燥湿，寒胜热．入足太阳经．（膀胱．）发汗利水．以泄太阴、阳明之湿热．（脾、胃．）"}]},{"ID":"20240616170935-3d7bw80","Type":"NodeParagraph","Properties":{"id":"20240616170935-3d7bw80","updated":"20240616170935"},"Children":[{"Type":"NodeText","Data":"为治黄胆之君药．（脾胃有湿热则发黄、黄者脾之色、身如橘色、汗如 汁而色明者热多、熏黄而色暗者湿多、须五苓之类、佐助成功．）又治伤寒时疾．狂热瘴疟．头痛头旋．女人瘕疝．（皆湿热为病．）按黄胆须分阴黄、阳黄．阳黄宜茵陈．阴黄宜温补．若用茵陈．多致不救．"}]},{"ID":"20240616170949-sw1ver5","Type":"NodeThematicBreak","Properties":{"id":"20240616170949-sw1ver5"}},{"ID":"20240616170950-t4p94xp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170950-t4p94xp","updated":"20240616170958"},"Children":[{"Type":"NodeText","Data":"茵陈《神农本草经赞》"}]},{"ID":"20240616170950-62dr76f","Type":"NodeParagraph","Properties":{"id":"20240616170950-62dr76f","updated":"20240616170950"},"Children":[{"Type":"NodeText","Data":"味苦平。主风湿寒热。邪气热结黄胆。久服轻身。益气耐老。生邱陵阪岸上。"}]},{"ID":"20240616170950-r08q68w","Type":"NodeParagraph","Properties":{"id":"20240616170950-r08q68w","updated":"20240616170950"},"Children":[{"Type":"NodeText","Data":"生生不息。陈陈相因。冬藏根蛰。春度萌伸。叶觅八角。饼荐三晨。蠲黄湿。耳食仙。"}]},{"ID":"20240616170950-z9ar26c","Type":"NodeParagraph","Properties":{"id":"20240616170950-z9ar26c","updated":"20240616170950"},"Children":[{"Type":"NodeText","Data":"易。生生之谓易。礼。流而不息。汉书志。陈陈相因。陈藏器曰。此虽蒿类。经冬不死。"}]},{"ID":"20240616170950-7bc92bt","Type":"NodeParagraph","Properties":{"id":"20240616170950-7bc92bt","updated":"20240616170950"},"Children":[{"Type":"NodeText","Data":"更因旧苗而生。故名茵陈。雷论。凡使须用叶有八角者。李时珍曰。淮扬人二月三日采茵陈苗和粉作饼食之。史记年表。此与以耳食无异。名医曰。白兔食之仙。"}]},{"ID":"20240616170847-in6rfgz","Type":"NodeThematicBreak","Properties":{"id":"20240616170847-in6rfgz"}},{"ID":"20240616170909-3airmzp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170909-3airmzp","updated":"20240616170912"},"Children":[{"Type":"NodeText","Data":"茵陈《本草备要》"}]},{"ID":"20240616170909-sgrs1sn","Type":"NodeParagraph","Properties":{"id":"20240616170909-sgrs1sn","updated":"20240616170909"},"Children":[{"Type":"NodeText","Data":"通，利湿热，治诸黄"}]},{"ID":"20240616170909-t8amrc6","Type":"NodeParagraph","Properties":{"id":"20240616170909-t8amrc6","updated":"20240616170909"},"Children":[{"Type":"NodeText","Data":"苦燥湿，寒胜热。入足太阳（膀胱）经。发汗利水，以泄太阴、阳明（脾、胃）之湿热。"}]},{"ID":"20240616170909-36ucya2","Type":"NodeParagraph","Properties":{"id":"20240616170909-36ucya2","updated":"20240616170909"},"Children":[{"Type":"NodeText","Data":"为治黄胆之君药（脾胃有湿热则发黄，黄者，脾之色也。热甚者，身如桔色，汗如柏汁。亦有寒湿发黄、身熏黄而色暗。大抵治以茵陈为主，阳黄加大黄、栀子，阴黄加附子、干姜，各随寒热治之）。又治伤寒时疾，狂热瘴疟，头痛头旋，女人瘕疝（皆湿热为病）。"}]},{"ID":"20240616170847-pgbbfku","Type":"NodeThematicBreak","Properties":{"id":"20240616170847-pgbbfku"}},{"ID":"20240616170859-pg3a2v3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170859-pg3a2v3","updated":"20240616170904"},"Children":[{"Type":"NodeText","Data":"茵陈《本草求真》"}]},{"ID":"20240616170859-7gk2acb","Type":"NodeParagraph","Properties":{"id":"20240616170859-7gk2acb","updated":"20240616170859"},"Children":[{"Type":"NodeText","Data":"（隰草）治太阳阳明湿热"}]},{"ID":"20240616170859-q0e5juu","Type":"NodeParagraph","Properties":{"id":"20240616170859-q0e5juu","updated":"20240616170859"},"Children":[{"Type":"NodeText","Data":"茵陈（专入膀胱胃）。味苦微寒。诸书皆言湿热伏于阳明。（胃）用此以入太阳膀胱发汗利水。俾太阳阳明湿热之邪。尽得于药而解矣！且治伤寒时疾狂热。瘴疟头痛头旋。女人疝瘕。亦是湿热为病。但黄原有阴阳寒热之分。阳黄者由热蕴于脾土。如苗值于大旱。则苗必燥而黄。是苗因燥而黄者也。太涝则苗必湿而黄。是苗因湿而黄者也。热为阳。寒为阴。故黄亦以阴阳分之。（阳黄身如橘色。汗如柏汁。寒黄黄而色晦。当细辨别。）是以仲景立有茵陈蒿汤栀子柏皮汤麻黄连翘赤小豆汤。以治阳黄之症。又立茵陈附子汤。以治阴黄之症。茵陈治黄通剂。在人审其所因而酌治耳。若蓄血发黄。则治不在茵陈之列。以茵陈本属气分药也。于血则不能治矣。茵陈本有二种。叶细而青蒿者可用。若生子如铃。则为山茵陈矣。专于杀虫。及治口疮。"}]},{"ID":"20240616171107-mtgiffe","Type":"NodeThematicBreak","Properties":{"id":"20240616171107-mtgiffe"}},{"ID":"20240616171108-2lm6ve7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171108-2lm6ve7","updated":"20240616171112"},"Children":[{"Type":"NodeText","Data":"茵陈《本草新编》"}]},{"ID":"20240616171108-0jdnqbp","Type":"NodeParagraph","Properties":{"id":"20240616171108-0jdnqbp","updated":"20240616171108"},"Children":[{"Type":"NodeText","Data":"茵陈，味苦、辛，气微寒，阴中微阳，无毒。入足太阳、少阳之经。专治瘅症发黄，非黄症，断不可用。果是真黄病，可用之为君。但黄症又不同，有阴黄、阳黄，有热黄、寒黄、燥黄，有血黄、气黄之殊，不可不辨。世人一见发黄，全不分别，俱用茵陈，无引经之品，共相佐使，所以有效有不效也，谨细陈之。阴黄之病，其湿不甚，黄色又不深，下体黄，上身不黄者也，夜间反觉不安，小便反涩，日间小便反利，转觉安宁。治法宜用茵陈为君，佐之茯苓、泽泻、薏苡仁之类，或加之五苓散又妙。茵陈可用至三钱至五钱，不可越五钱之外，连服数剂，黄可尽退也。阳黄之病，其湿又不太甚，但黄色如金，上身眼目尽黄，而下体乃不黄者是也，日间小便艰涩，或痛或不痛，夜则安然自利。治法宜用茵陈为君，而佐之升麻、桔梗、茯苓、天花粉，麻黄、黄芩之类，数服即愈，茵陈必须多加五、六钱也。热黄之病，口必大渴，然多饮反觉不快，一身上下俱黄，眼目反觉色淡，小便时急数疼痛，其溺必如黄汗，盖热结膀胱而不得出耳。法又用茵陈为君，大约必须五钱为止，佐之龙胆草、炒栀子、芍药、茯苓、猪苓、泽泻之类，则火热泻而黄又愈也，寒黄之病，一见水，则大吐不已，畏寒怕冷，腹中时痛，手按之始安，一身上下又黄，眼目自白，小便清长，夜间尤利，盖寒结于膀胱，命门无火以通，则水气流入于脾，而脾又寒虚，乃渗走于皮毛而为黄，其黄色必如秋葵之色者也。虽又用茵陈为君，但只可用至一钱，切戒多用，必须佐之白术、茯苓、山药、芡实、薏仁，少用附子数分以温补其命门之火，不须十剂，则全愈矣。湿黄之病，全是水湿之气也，虽黄症俱是水湿，而湿黄之水湿更甚，一身上下、眼目、手足尽黄，俱身必浮肿，按之如泥，又用茵陈四五钱，加入升麻、甘遂、牵牛、车前、泽泻之类，少升其气，使水尽从大、小便出，一剂水湿减去大半，而黄尽退矣，断不可服三剂。盖牵牛、甘遂性悍，多服恐伤人元气耳。燥黄之病，全非水湿，其外现之症，不过胸前之皮肉少黄，而一身上下、眼目不黄，此肺金燥极，黄发于胸前，乃假象也。然既已发黄，茵陈又不可全然不用，可用七、八分，加入麦冬、栀子、芍药、陈皮、天门冬、元参、天花粉、白芥子之类，久服自愈，肺经不燥，而胸黄自除也。血黄之症，上下一身、眼目俱黄，身必花热，胸必烦闷，腹必疼痛，此血瘀于腹中胸下，故变为发黄，伤寒症中，最多此病，论理可遵仲景夫子之方，照症分治。而余又酌定一方，以便世之采用。茵陈为君，加丹皮、牛膝、当归、栀子、川芎、大黄之品，一服而疼痛烦闷除，其黄必渐愈。苟或服药，仍然闷痛，必须加入水蛭一钱，其瘀血始解，发黄尽退也。气黄之病，身不发热，又无饱闷烦燥之状，但头面发黄如淡金之色，饮食知味少，若行动，便觉气怯不能动履，小便不数，大便反燥，然又不结，此气虚不能运此水湿之气，以成黄病者也。可用茵陈一二钱，加入人参、白术、黄 、茯苓、车前子，大剂煎饮，自然气旺，黄色全消矣。居言至此，虽不敢谓黄症治法全备，然分病既清，用药无误，要不能越此范围。愿人之临症之时，细察而分治之可耳或问子论黄病，实发天地之奇，黄病岂尽于此乎？曰∶更有一种，身不黄，足反黄，此湿热壅闭于中焦，乃脾胃之虚，不能化水也。又用茵陈加白术、茯苓、陈皮、甘草、白芥子、枳壳、槟榔、白芍之类治之，则水渐利而黄渐去。倘身黄，而手足反不黄者，乃不治之症也。"}]},{"ID":"20240616171118-azchxdz","Type":"NodeThematicBreak","Properties":{"id":"20240616171118-azchxdz"}},{"ID":"20240616170849-dqlbg6d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170849-dqlbg6d","updated":"20240616170855"},"Children":[{"Type":"NodeText","Data":"茵陈《本草撮要》"}]},{"ID":"20240616170849-ro0f9k1","Type":"NodeParagraph","Properties":{"id":"20240616170849-ro0f9k1","updated":"20240616170849"},"Children":[{"Type":"NodeText","Data":"味苦．入足太阳阳明太阴经．功专去风湿寒热．得山栀疗热黄．得附子治阴黄．得车前治眼目湿热赤肿．凡湿热为病．推为上品．浸酒服．可以去湿．"}]},{"ID":"20240607130735-jfww4ko","Type":"NodeThematicBreak","Properties":{"id":"20240607130735-jfww4ko"}},{"ID":"20240607130737-b7sy6bt","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607130737-b7sy6bt","updated":"20240607130748"},"Children":[{"Type":"NodeText","Data":"茵陈《本草便读》"}]},{"ID":"20240607130737-dr4543f","Type":"NodeParagraph","Properties":{"id":"20240607130737-dr4543f","updated":"20240607130737"},"Children":[{"Type":"NodeText","Data":"下通水道．治湿热之黄瘅．上入阳明．味苦寒而无毒．兼能达表．专主分消．（茵陈．此草似青蒿而不香．叶背色白．经冬不死．至春则更因旧苗而生新苗．故有因陈之名．性味苦寒．能升能降．功专发汗利水．为治湿病黄瘅之要药．然苦寒中亦兼有微辛微香．其形质性味．与青蒿相似．但青蒿不能治湿．此则治湿为长．一切表里湿热．皆可治之．惟虚寒黄瘅小便自利者当禁之．）"}]},{"ID":"20240616171047-e85endc","Type":"NodeThematicBreak","Properties":{"id":"20240616171047-e85endc"}},{"ID":"20240616171048-viq5jxz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171048-viq5jxz","updated":"20240616171054"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《新修本草》"}]},{"ID":"20240616171048-xwrwdf8","Type":"NodeParagraph","Properties":{"id":"20240616171048-xwrwdf8","updated":"20240616171048"},"Children":[{"Type":"NodeText","Data":"味苦，平、微寒，无毒。主风湿，寒热，邪气，热结，黄胆。通身发黄，小便不利，除头热，去伏瘕。久服轻身益气耐老，面白悦长年。白兔食之，仙。生太山及丘陵坡岸上。五月及立秋采，阴干。"}]},{"ID":"20240616171048-lccpu3x","Type":"NodeParagraph","Properties":{"id":"20240616171048-lccpu3x","updated":"20240616171048"},"Children":[{"Type":"NodeText","Data":"今处处有，似蓬蒿而叶紧细。茎，冬不死，春又生。惟入疗黄胆用。《仙经》云∶白蒿，白兔食之，仙。而今茵陈乃云此，恐是误尔。"}]},{"ID":"20240616171037-4hb1xgb","Type":"NodeThematicBreak","Properties":{"id":"20240616171037-4hb1xgb"}},{"ID":"20240616171038-10qxh0x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171038-10qxh0x","updated":"20240616171043"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《汤液本草》"}]},{"ID":"20240616171038-h2n7w1b","Type":"NodeParagraph","Properties":{"id":"20240616171038-h2n7w1b","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"气微寒，味苦、平，阴中微阳。无毒。"}]},{"ID":"20240616171038-dnqf10w","Type":"NodeParagraph","Properties":{"id":"20240616171038-dnqf10w","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"入足太阳经。"}]},{"ID":"20240616171038-ddx1deq","Type":"NodeParagraph","Properties":{"id":"20240616171038-ddx1deq","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"《象》云∶除烦热，主风湿热邪结于内。去枝、梗，用叶。"}]},{"ID":"20240616171038-b9qtrwx","Type":"NodeParagraph","Properties":{"id":"20240616171038-b9qtrwx","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主风湿寒热，邪气热结，黄胆，通身发黄，小便不利，除头热，去伏瘕。"}]},{"ID":"20240616171038-7ls6glq","Type":"NodeParagraph","Properties":{"id":"20240616171038-7ls6glq","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"入足太阳。"}]},{"ID":"20240616171038-mlntexc","Type":"NodeParagraph","Properties":{"id":"20240616171038-mlntexc","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"仲景茵陈栀子大黄汤，治湿热也。栀子柏皮汤，治燥热也。如苗涝则湿黄，苗旱则燥黄，湿则泻之，燥则润之可也。此二药治阳黄也。韩祗和、李思训治阴黄，茵陈附子汤，大抵以茵陈为君主，佐以大黄、附子，各随其寒热。"}]},{"ID":"20240616171038-kn48ygb","Type":"NodeParagraph","Properties":{"id":"20240616171038-kn48ygb","updated":"20240616171038"},"Children":[{"Type":"NodeText","Data":"《珍》云∶治伤寒发黄。"}]},{"ID":"20240616171027-y9zxld2","Type":"NodeThematicBreak","Properties":{"id":"20240616171027-y9zxld2"}},{"ID":"20240616171028-uq7ylbg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171028-uq7ylbg","updated":"20240616171033"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《神农本草经读》"}]},{"ID":"20240616171028-18vz8rq","Type":"NodeParagraph","Properties":{"id":"20240616171028-18vz8rq","updated":"20240616171028"},"Children":[{"Type":"NodeText","Data":"气味苦、平、微寒，无毒。主风（湿寒）热邪气，热结黄胆。久服轻身，益气，耐老，面白悦，长年。白兔食成仙。"}]},{"ID":"20240616171028-4e0a9y8","Type":"NodeParagraph","Properties":{"id":"20240616171028-4e0a9y8","updated":"20240616171028"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶《经》云∶春三月，此为发陈。茵陈因旧苗而春生，盖因冬令寒水之气，而具阳春生发之机。主治风湿寒热邪气，得生阳之气，则外邪自散也。结热黄胆，得水寒之气，则内热自除也。久服则生阳上升，故轻身益气耐老。因陈而生新，故面白悦、长年。兔乃纯阴之物，喜食阳春之气，故白兔食之成仙。"}]},{"ID":"20240616171016-nitwi8j","Type":"NodeThematicBreak","Properties":{"id":"20240616171016-nitwi8j"}},{"ID":"20240616171018-stzfcn2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171018-stzfcn2","updated":"20240616171023"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《本草简要方》"}]},{"ID":"20240616171018-3leb6ar","Type":"NodeParagraph","Properties":{"id":"20240616171018-3leb6ar","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"主治。利湿。通小便。疗黄胆。关节不通。"}]},{"ID":"20240616171018-dcbv0fq","Type":"NodeParagraph","Properties":{"id":"20240616171018-dcbv0fq","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"茵陈五苓散。茵陈一钱。五苓散五分和匀。食前服方寸匕。日三次。治黄胆。又方。茵陈五钱。五苓散一两。车前子一钱。木通柴胡各一钱五分。分为二服。水一碗。加灯草五十茎。煎至八分。去滓食前服。滓再煎服。至小便清利为度。治伤寒湿热发为黄胆。小便黑赤。"}]},{"ID":"20240616171018-mfkxvqx","Type":"NodeParagraph","Properties":{"id":"20240616171018-mfkxvqx","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"烦渴发热。伤酒成疸。加干葛二钱。"}]},{"ID":"20240616171018-od7j4jz","Type":"NodeParagraph","Properties":{"id":"20240616171018-od7j4jz","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"茵陈附子干姜汤。茵陈一钱二分。附子（泡去皮）三钱。干姜（炮）二钱。草豆蔻（煨）一钱。"}]},{"ID":"20240616171018-h0k209l","Type":"NodeParagraph","Properties":{"id":"20240616171018-h0k209l","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"白术四分。枳实（麸炒）半夏泽泻各五钱。白茯苓橘红各三分。加生姜五片。水煎服。治阴黄。"}]},{"ID":"20240616171018-nal229t","Type":"NodeParagraph","Properties":{"id":"20240616171018-nal229t","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"脉沉细。"}]},{"ID":"20240616171018-0o49o7x","Type":"NodeParagraph","Properties":{"id":"20240616171018-0o49o7x","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"茵陈散。茵陈连翘半夏荆芥穗麻黄升麻黄芩丹皮射干羌活独活薄荷僵蚕各二钱五分。大黄（炮）二钱。细辛牵牛头末一两。研末。每服三钱。水一盏。煎开下药略搅。急倾出。"}]},{"ID":"20240616171018-6wkx45s","Type":"NodeParagraph","Properties":{"id":"20240616171018-6wkx45s","updated":"20240616171018"},"Children":[{"Type":"NodeText","Data":"食后连滓服。治齿痛龈肿。及骨槽风热。"}]},{"ID":"20240616171158-3ukaj44","Type":"NodeThematicBreak","Properties":{"id":"20240616171158-3ukaj44"}},{"ID":"20240616171200-xtrji8j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171200-xtrji8j","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《增广和剂局方药性总论》"}]},{"ID":"20240616171200-48ne9s2","Type":"NodeParagraph","Properties":{"id":"20240616171200-48ne9s2","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"味苦，平，微寒，无毒。主风湿寒热邪气，热结，黄胆，通身发黄，小便不利，除去伏瘕。《药性论》云∶使。味苦辛，治眼目。日华子云∶治天行时疾，热狂，头痛疼，瘴疟，女人症瘕，并闪损。一云∶山茵陈疗脑痛，解伤寒发汗，行肢节滞气，化治劳倦。家茵陈亦能解肌，下膈，去烦。"}]},{"ID":"20240616171200-imkejdn","Type":"NodeThematicBreak","Properties":{"id":"20240616171200-imkejdn","updated":"20240616171200"}},{"ID":"20240616171200-dd5xbyt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171200-dd5xbyt","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《本草纲目》"}]},{"ID":"20240616171200-emv29qz","Type":"NodeParagraph","Properties":{"id":"20240616171200-emv29qz","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"「气味」（茎、叶）苦、平、微寒、无毒。"}]},{"ID":"20240616171200-p705kmg","Type":"NodeParagraph","Properties":{"id":"20240616171200-p705kmg","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616171200-y2q8813","Type":"NodeParagraph","Properties":{"id":"20240616171200-y2q8813","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"1、大热黄疸。用茵陈切细煮汤服。生食亦可，亦治伤寒头痛、风热痒疟，利小便。此方名“茵陈羹”。"}]},{"ID":"20240616171200-upzxss9","Type":"NodeParagraph","Properties":{"id":"20240616171200-upzxss9","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"2、遍身风痒。用茵陈煮浓汤洗浴即愈。"}]},{"ID":"20240616171200-h94e35q","Type":"NodeParagraph","Properties":{"id":"20240616171200-h94e35q","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"3、疬疡风病（按：此病是身上出现斑块，白色成片）。用茵陈蒿两把，加水一斗五程序，煮成七升，先以皂荚汤洗，再以茵陈汤洗。隔一天洗一次。"}]},{"ID":"20240616171200-rykd1u3","Type":"NodeParagraph","Properties":{"id":"20240616171200-rykd1u3","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"4、风疾挛急（按：指手足不能自由伸缩）。用茵陈蒿一斤、秫米一石、面三斤，和匀照常法酿酒，每日饮服。"}]},{"ID":"20240616171200-pqpj6fz","Type":"NodeParagraph","Properties":{"id":"20240616171200-pqpj6fz","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"5、遍身典疸，用茵陈蒿一把，同生姜一块捣烂，每日擦胸前和四肢。"}]},{"ID":"20240616171200-77zn2ew","Type":"NodeParagraph","Properties":{"id":"20240616171200-77zn2ew","updated":"20240616171200"},"Children":[{"Type":"NodeText","Data":"6、眼热红肿。用茵陈蒿、车前子等分，煎汤，以细茶调服数次。"}]},{"ID":"20240616171208-gljk5x3","Type":"NodeThematicBreak","Properties":{"id":"20240616171208-gljk5x3"}},{"ID":"20240616171209-8y5wj2x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171209-8y5wj2x","updated":"20240616171216"},"Children":[{"Type":"NodeText","Data":"茵陈蒿《本草择要纲目》"}]},{"ID":"20240616171209-keoxovd","Type":"NodeParagraph","Properties":{"id":"20240616171209-keoxovd","updated":"20240616171209"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616171209-da91s2c","Type":"NodeParagraph","Properties":{"id":"20240616171209-da91s2c","updated":"20240616171209"},"Children":[{"Type":"NodeText","Data":"苦平微寒无毒．阴中微阳．入足太阳经又入足阳明经．"}]},{"ID":"20240616171209-x7qg06l","Type":"NodeParagraph","Properties":{"id":"20240616171209-x7qg06l","updated":"20240616171209"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616171209-1d2svaw","Type":"NodeParagraph","Properties":{"id":"20240616171209-1d2svaw","updated":"20240616171209"},"Children":[{"Type":"NodeText","Data":"风湿结热．通关节．去伏瘕．通身发黄成疸．小便不利．故茵陈栀子大黄汤治湿黄．栀子柏皮汤治燥黄．为阳黄之要药．茵陈附子汤治阴黄．为阴分之通剂．各随寒热而君主之也．"}]},{"ID":"20240607130652-dbuao6d","Type":"NodeThematicBreak","Properties":{"id":"20240607130652-dbuao6d"}},{"ID":"20240607130702-hn8fjyp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130702-hn8fjyp","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"《中国药典》：茵陈"}]},{"ID":"20240607130702-7ut33z1","Type":"NodeParagraph","Properties":{"id":"20240607130702-7ut33z1","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130702-3pb0r1v","Type":"NodeParagraph","Properties":{"id":"20240607130702-3pb0r1v","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" Yīn Chén"}]},{"ID":"20240607130702-o6dbmp5","Type":"NodeParagraph","Properties":{"id":"20240607130702-o6dbmp5","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130702-327j3fx","Type":"NodeParagraph","Properties":{"id":"20240607130702-327j3fx","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 绵茵陈、茵陈蒿、白蒿、绒蒿、猴子毛"}]},{"ID":"20240607130702-tcfzkm1","Type":"NodeParagraph","Properties":{"id":"20240607130702-tcfzkm1","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607130702-1wtpj5s","Type":"NodeParagraph","Properties":{"id":"20240607130702-1wtpj5s","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" HERBA ARTEMISIAE SCOPARIAE"}]},{"ID":"20240607130702-tgu7rif","Type":"NodeParagraph","Properties":{"id":"20240607130702-tgu7rif","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130702-cjfusg5","Type":"NodeParagraph","Properties":{"id":"20240607130702-cjfusg5","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滨蒿"},{"Type":"NodeText","Data":"Artemisia scoparia Waldst. et Kit. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茵陈蒿"},{"Type":"NodeText","Data":"Artemisia capillaris Thunb.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地上部分"},{"Type":"NodeText","Data":"。春季幼苗高 6～10cm时采收或秋季花蕾长成时采割，除去杂质及老茎，晒干。春季采收的习称“绵茵陈”，秋季采割的称“茵陈蒿”。"}]},{"ID":"20240607130702-4irj294","Type":"NodeParagraph","Properties":{"id":"20240607130702-4irj294","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607130702-injbp5h","Type":"NodeParagraph","Properties":{"id":"20240607130702-injbp5h","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 绵茵陈：多卷曲成团状，灰白色或灰绿色，全体密被白色茸毛，绵软如绒。茎细小，长1。5～2。5cm，直径0。1～0。2cm，除去表面白色茸毛后可见明显纵纹；质脆，易折断。叶具柄；展平后叶片呈一至三回羽状分裂，叶片长1～3cm，宽约1cm；小裂片卵形或稍呈倒披针形、条形，先端尖锐。气清香，味微苦。"}]},{"ID":"20240607130702-mu1elxa","Type":"NodeParagraph","Properties":{"id":"20240607130702-mu1elxa","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"茵陈蒿：茎呈圆柱形，多分枝，长30～100cm，直径2～8mm；表面淡紫色或紫色，有纵条纹，被短柔毛；体轻，质脆，断面类白色。叶密集，或多脱落；下部叶二至三回羽状深裂，裂片条形或细条形，两面密被白色柔毛；茎生叶一至二回羽状全裂，基部抱茎，裂片细丝状；头状花序卵形，多数集成圆锥状，长1。2～1。5mm，直径1～1。2mm，有短梗；总苞片3～4层，卵形，苞片3裂；外层雌花6～10个，可多达15个，内层两性花2～10个。瘦果长圆形，黄棕色。气芳香，味微苦。"}]},{"ID":"20240607130702-z776jkr","Type":"NodeParagraph","Properties":{"id":"20240607130702-z776jkr","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607130702-xy2pmll","Type":"NodeParagraph","Properties":{"id":"20240607130702-xy2pmll","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防潮。"}]},{"ID":"20240607130702-jlnnx5n","Type":"NodeParagraph","Properties":{"id":"20240607130702-jlnnx5n","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607130702-8ws7kkm","Type":"NodeParagraph","Properties":{"id":"20240607130702-8ws7kkm","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 除去残根及杂质，搓碎或切碎。绵茵陈筛去灰屑。"}]},{"ID":"20240607130702-958a7jx","Type":"NodeParagraph","Properties":{"id":"20240607130702-958a7jx","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607130702-1b79whk","Type":"NodeParagraph","Properties":{"id":"20240607130702-1b79whk","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、肝、胆经。"}]},{"ID":"20240607130702-f4hji4n","Type":"NodeParagraph","Properties":{"id":"20240607130702-f4hji4n","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130702-u2eqdgt","Type":"NodeParagraph","Properties":{"id":"20240607130702-u2eqdgt","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 苦、辛，微寒。"}]},{"ID":"20240607130702-p36vrkc","Type":"NodeParagraph","Properties":{"id":"20240607130702-p36vrkc","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130702-h4t163k","Type":"NodeParagraph","Properties":{"id":"20240607130702-h4t163k","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 清湿热，退黄疸。用于黄疸尿少，湿疮瘙痒；传染性黄疸型肝炎。"}]},{"ID":"20240607130702-cmqqw38","Type":"NodeParagraph","Properties":{"id":"20240607130702-cmqqw38","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607130702-pc7buax","Type":"NodeParagraph","Properties":{"id":"20240607130702-pc7buax","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 6～15g。外用适量，煎汤熏洗。"}]},{"ID":"20240607130702-5sz2fqa","Type":"NodeParagraph","Properties":{"id":"20240607130702-5sz2fqa","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607130702-hrnh098","Type":"NodeParagraph","Properties":{"id":"20240607130702-hrnh098","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" （1）用于湿热熏蒸而发生黄疸的病症，可单用一味，大剂量煎汤内服；亦可配合大黄、栀子等同用。若小便不利显著者，又可与泽泻、猪苓等配伍。本品退黄疸之效甚佳，故除用于湿热黄疸之外，对于因受寒湿或素体阳虚发生的阴黄病症，也可应用。但须配合温中祛寒之品如附子、干姜等药同用，以奏除阴寒而退黄疸的作用。"}]},{"ID":"20240607130702-xboybne","Type":"NodeParagraph","Properties":{"id":"20240607130702-xboybne","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130702-mc7flr6","Type":"NodeParagraph","Properties":{"id":"20240607130702-mc7flr6","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607130702-o10yyup","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130702-o10yyup","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：茵陈"}]},{"ID":"20240607130702-5r6tdi6","Type":"NodeParagraph","Properties":{"id":"20240607130702-5r6tdi6","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130702-4bk7qq8","Type":"NodeParagraph","Properties":{"id":"20240607130702-4bk7qq8","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" Yīn Chén"}]},{"ID":"20240607130702-hgwfmss","Type":"NodeParagraph","Properties":{"id":"20240607130702-hgwfmss","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130702-evcgnhv","Type":"NodeParagraph","Properties":{"id":"20240607130702-evcgnhv","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 绵茵陈、白蒿、绒蒿、松毛艾"}]},{"ID":"20240607130702-msanpvg","Type":"NodeParagraph","Properties":{"id":"20240607130702-msanpvg","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607130702-l2qga78","Type":"NodeParagraph","Properties":{"id":"20240607130702-l2qga78","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" Herba Artemisiae Scopariae"}]},{"ID":"20240607130702-zyp310a","Type":"NodeParagraph","Properties":{"id":"20240607130702-zyp310a","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130702-6vb7y98","Type":"NodeParagraph","Properties":{"id":"20240607130702-6vb7y98","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茵陈蒿"},{"Type":"NodeText","Data":"Artemisia capillaris Thunb.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼苗"},{"Type":"NodeText","Data":"。春季幼苗高6～10cm时采收，除去老茎及杂质，晒干。"}]},{"ID":"20240607130702-qqh785y","Type":"NodeParagraph","Properties":{"id":"20240607130702-qqh785y","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607130702-37052im","Type":"NodeParagraph","Properties":{"id":"20240607130702-37052im","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 生于山坡、路边。全国各地均有分布。"}]},{"ID":"20240607130702-q7jmkbu","Type":"NodeParagraph","Properties":{"id":"20240607130702-q7jmkbu","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607130702-pxjo2yc","Type":"NodeParagraph","Properties":{"id":"20240607130702-pxjo2yc","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 多年生草本或半灌木状。茎直立，高0.5～1m，基部木质化，表面黄棕色，具纵条纹，多分枝；幼时全体有褐色丝状毛，成长后近无毛。叶1～3回羽头深裂，下部裂片较宽短，常被短绢毛；中部叶裂片细长如发，宽约1mm；上部叶羽头分裂，3裂或不裂，近无毛。头状花序小而多，密集成复总状；总苞片3～4层，无毛，外层卵形，内层椭圆形，中央绿色，边缘膜质；花黄色，管状，外层花3～5，雌性，能育，内层花两性5～7，不育。瘦果长圆形，长约0.8mm，无毛。花期9～10月，果期10～12月。"}]},{"ID":"20240607130702-8l4kqux","Type":"NodeParagraph","Properties":{"id":"20240607130702-8l4kqux","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607130702-1akt3s4","Type":"NodeParagraph","Properties":{"id":"20240607130702-1akt3s4","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 含6，7-二甲基七叶树内酯（6，7-dimethylsculetin）及挥发油，油中主要为a-蒎烯、茵陈二炔酮（capillin）茵陈烯块（capillene）、茵陈醇（capillanol）、茵陈色原酮（capillarisin）、氯原酸等。"}]},{"ID":"20240607130702-k46hxqs","Type":"NodeParagraph","Properties":{"id":"20240607130702-k46hxqs","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130702-6mgsr2f","Type":"NodeParagraph","Properties":{"id":"20240607130702-6mgsr2f","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 性微寒，味辛、苦。"}]},{"ID":"20240607130702-s004a97","Type":"NodeParagraph","Properties":{"id":"20240607130702-s004a97","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130702-kwclbv7","Type":"NodeParagraph","Properties":{"id":"20240607130702-kwclbv7","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 清湿热，退黄疸。"}]},{"ID":"20240607130702-lyy00lq","Type":"NodeParagraph","Properties":{"id":"20240607130702-lyy00lq","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607130702-0v89zdj","Type":"NodeParagraph","Properties":{"id":"20240607130702-0v89zdj","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滨蒿"},{"Type":"NodeText","Data":"Artemisia scoparia Wadldst.et Kit. 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼苗"},{"Type":"NodeText","Data":"同作茵陈入药。"}]},{"ID":"20240607130702-soxr59m","Type":"NodeParagraph","Properties":{"id":"20240607130702-soxr59m","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130702-3o2oi2o","Type":"NodeParagraph","Properties":{"id":"20240607130702-3o2oi2o","updated":"20240607130702"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607130703-hf8fc4z","Type":"NodeThematicBreak","Properties":{"id":"20240607130703-hf8fc4z"}},{"ID":"20240607130704-kfhbay2","Type":"NodeParagraph","Properties":{"id":"20240607130704-kfhbay2"}}]}