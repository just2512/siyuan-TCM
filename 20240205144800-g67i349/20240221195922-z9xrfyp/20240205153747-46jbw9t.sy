eText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"翟麦 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/翟麦 4-20240814091016-fanbp2w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"翟麦 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/翟麦 5-20240814091059-edgo0oj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814092314-p1m8yya","Type":"NodeParagraph","Properties":{"id":"20240814092314-p1m8yya","updated":"20240814092819"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 665px;","style":"width: 655px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"翟麦 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/翟麦 12-20240814092314-1znl4mo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 655px;\" parent-style=\"width: 665px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"翟麦 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/翟麦 11-20240814092131-9u85375.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814091155-6gemvdg","Type":"NodeParagraph","Properties":{"id":"20240814091155-6gemvdg","updated":"20240814092832"},"Children":[{"Type":"NodeText","Data":"​"}]},{"ID":"20240814091832-04k8ssy","Type":"NodeParagraph","Properties":{"id":"20240814091832-04k8ssy","updated":"20240814092503"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 434px;","style":"width: 424px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"翟麦 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/翟麦 10-20240814092048-y2p058q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 424px;\" parent-style=\"width: 434px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 563px;","style":"width: 553px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240814092503-sfh8j7b.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 553px;\" parent-style=\"width: 563px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814091633-q7a2wyw","Type":"NodeParagraph","Properties":{"id":"20240814091633-q7a2wyw","updated":"20240814091643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：瞿麦孕妇禁用；"}]},{"ID":"20240611142534-4pqvmt2","Type":"NodeThematicBreak","Properties":{"id":"20240611142534-4pqvmt2"}},{"ID":"20240611142547-gnyrrbf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142547-gnyrrbf","updated":"20240611142552"},"Children":[{"Type":"NodeText","Data":"瞿麦《本经逢原》"}]},{"ID":"20240611142547-4y4mw69","Type":"NodeParagraph","Properties":{"id":"20240611142547-4y4mw69","updated":"20240611142547"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"家种者曰洛阳"}]},{"ID":"20240611142547-oec4xhp","Type":"NodeParagraph","Properties":{"id":"20240611142547-oec4xhp","updated":"20240611142547"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。"}]},{"ID":"20240611142547-zb2u1cd","Type":"NodeParagraph","Properties":{"id":"20240611142547-zb2u1cd","updated":"20240611142547"},"Children":[{"Type":"NodeText","Data":"《本经》主关格、诸癃结，小便不通，出刺，决痈肿，明目去翳，破胎堕子，下闭血。"}]},{"ID":"20240611142547-30o9jma","Type":"NodeParagraph","Properties":{"id":"20240611142547-30o9jma","updated":"20240611142547"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"瞿麦利小便为君主之用。故《本经》专主关格、诸癃结、小便不通。《金匮》方治小便不利，有水气，其人苦渴者，用栝蒌瞿麦丸。古方通心经利小肠为最要药。若心经虽有热而小肠虚者，服之则心热未退，而小肠别作病矣，以其降泄太过也。《本经》又言出刺，取鲜者捣涂竹木刺也。破胎堕子下闭血，皆利窍所致。故妊娠产后小水不利，及脾虚水肿禁用，以性专泄气也。"}]},{"ID":"20240611142534-ul4owm1","Type":"NodeThematicBreak","Properties":{"id":"20240611142534-ul4owm1"}},{"ID":"20240611142535-gr7akpo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142535-gr7akpo","updated":"20240611142540"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草备要》"}]},{"ID":"20240611142535-jg4wpj3","Type":"NodeParagraph","Properties":{"id":"20240611142535-jg4wpj3","updated":"20240611142535"},"Children":[{"Type":"NodeText","Data":"通，利水，破血"}]},{"ID":"20240611142535-an5rbs7","Type":"NodeParagraph","Properties":{"id":"20240611142535-an5rbs7","updated":"20240611142535"},"Children":[{"Type":"NodeText","Data":"苦寒。降心火，利小肠，逐膀胱邪热，为治淋要药（故八正散用之。五淋大抵皆属湿热，热淋宜八正及山栀、滑石之类；血淋宜小蓟、牛膝；膏肾虚淋宜补肾，不可独泻；老人气虚者，宜参、术兼木通、山栀；亦有痰滞中焦作淋者，宜行痰兼通利药，最忌发汗，汗之必便血）。破血利窍，决痈消肿，明目去翳，通经堕胎。性利善下，虚者慎用（寇宗 曰∶心经虽有热，而小肠虚者服之，则心热未清，而小肠别作病矣）。"}]},{"ID":"20240611142535-sfnbziq","Type":"NodeParagraph","Properties":{"id":"20240611142535-sfnbziq","updated":"20240611142535"},"Children":[{"Type":"NodeText","Data":"花大如钱，红白斑斓，色甚斌媚，俗呼洛阳花。用蕊、壳。丹皮为使。恶螵蛸（产后淋当去血，瞿麦、蒲黄皆为要药）。"}]},{"ID":"20240611142513-i0fvvi9","Type":"NodeThematicBreak","Properties":{"id":"20240611142513-i0fvvi9"}},{"ID":"20240611142526-tl1rsh6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142526-tl1rsh6","updated":"20240611142529"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草从新》"}]},{"ID":"20240611142526-cj4byq4","Type":"NodeParagraph","Properties":{"id":"20240611142526-cj4byq4","updated":"20240611142526"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、利水破血．"}]},{"ID":"20240611142526-fmdg801","Type":"NodeParagraph","Properties":{"id":"20240611142526-fmdg801","updated":"20240611142526"},"Children":[{"Type":"NodeText","Data":"苦寒．降心火．利小肠．逐膀胱邪热．为治淋要药．（若产后淋、宜与蒲黄同用、五淋大抵皆属湿热、热淋、宜八正及山栀滑石之类、血淋、宜小蓟牛膝膏、肾虚淋、宜补肾、不可独泻、老人气虚者、宜参术兼木通山栀、亦有痰滞中焦作淋者、宜行痰兼通利药、不可发汗、汗之必便血．）破血利窍．决痈消肿．明目去翳．通经堕胎．（性利善下．）小肠虚者忌服．"}]},{"ID":"20240611142526-pbqb87s","Type":"NodeParagraph","Properties":{"id":"20240611142526-pbqb87s","updated":"20240611142526"},"Children":[{"Type":"NodeText","Data":"恐心热未除．而小肠复病矣．当求其属以衰之．花大如钱．红白斑斓．色甚妩媚．俗呼洛阳花．用蕊壳．丹皮为使．恶螵蛸．（竹木入肉、瞿麦为末、水服方寸匕、或煮汁、日饮三次．）"}]},{"ID":"20240611142513-2ywftug","Type":"NodeThematicBreak","Properties":{"id":"20240611142513-2ywftug"}},{"ID":"20240611142514-qijid5o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142514-qijid5o","updated":"20240611142519"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草乘雅半偈》"}]},{"ID":"20240611142514-490qtb0","Type":"NodeParagraph","Properties":{"id":"20240611142514-490qtb0","updated":"20240611142514"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240611142514-jgymxj8","Type":"NodeParagraph","Properties":{"id":"20240611142514-jgymxj8","updated":"20240611142514"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，无毒。"}]},{"ID":"20240611142514-8n5k6s9","Type":"NodeParagraph","Properties":{"id":"20240611142514-8n5k6s9","updated":"20240611142514"},"Children":[{"Type":"NodeText","Data":"【主治】主关格，诸癃结，小便不通，出刺，决痈肿，明目，去翳，破胎堕子，下闭血。"}]},{"ID":"20240611142514-7ad0wpc","Type":"NodeParagraph","Properties":{"id":"20240611142514-7ad0wpc","updated":"20240611142514"},"Children":[{"Type":"NodeText","Data":"【核】曰∶瞿麦，即洛阳花萼，云石竹，及剪秋罗者谬矣。所在有之。茎细有节，高一、二尺，叶似石竹，又似地肤，稍巅开花，有红、紫、粉、蓝、斑烂数色，结实如燕麦，内子紫黑而扁，只用萼壳，不用茎叶，一时同使，令人气噎，及小便不禁也。修事，以苦竹沥浸一伏时，取出晒干用。 草、牡丹为之使。恶螵蛸。伏丹砂。"}]},{"ID":"20240611142514-adl5te1","Type":"NodeParagraph","Properties":{"id":"20240611142514-adl5te1","updated":"20240611142514"},"Children":[{"Type":"NodeText","Data":"【 】曰∶瞿，戟属。四矛为瞿。又四达为瞿。亦鹰隼之视为瞿也。麦者，实囊形相似尔。主明目去翳者，取鹰隼之能视；去刺决痈肿，破胎堕子者，取戈矛之四出；治关格诸癃结，小便失利，不闭血者，取四达之通瞿，通因塞用，急方之通剂也。但气味苦寒，设非火热为本因，反成箪瓢之 耳。"}]},{"ID":"20240611142501-w0eh7zu","Type":"NodeThematicBreak","Properties":{"id":"20240611142501-w0eh7zu"}},{"ID":"20240611142502-rf2ujhp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142502-rf2ujhp","updated":"20240611142507"},"Children":[{"Type":"NodeText","Data":"瞿麦《新修本草》"}]},{"ID":"20240611142502-fkgfhpy","Type":"NodeParagraph","Properties":{"id":"20240611142502-fkgfhpy","updated":"20240611142502"},"Children":[{"Type":"NodeText","Data":"味苦、辛，寒，无毒。主关格诸癃结，小便不通，出刺，决痈肿，明目去翳，破胎堕子，下闭血。养肾气，逐膀胱邪逆，止霍乱，长毛发。一名巨句麦，一名大菊，一名大兰。生太山川谷。立秋采实，阴干。"}]},{"ID":"20240611142502-uwh28s5","Type":"NodeParagraph","Properties":{"id":"20240611142502-uwh28s5","updated":"20240611142502"},"Children":[{"Type":"NodeText","Data":"草、牡丹为之使，恶桑螵蛸。 茎生细叶，花红紫赤可爱，合子叶刈取之。子颇似麦，故一种微大，花边有叉丫，未知何者是？今市人皆用小者；复一种，叶甚赤。案《经》云采实，实中子至细，燥熟便脱尽，今市人惟合茎叶用，而实正空壳，无复子尔。"}]},{"ID":"20240611142309-u1vtqmn","Type":"NodeThematicBreak","Properties":{"id":"20240611142309-u1vtqmn"}},{"ID":"20240611142451-rcjb2m8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142451-rcjb2m8","updated":"20240611142457"},"Children":[{"Type":"NodeText","Data":"瞿麦散《备急千金要方》"}]},{"ID":"20240611142451-4hh9jax","Type":"NodeParagraph","Properties":{"id":"20240611142451-4hh9jax","updated":"20240611142451"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"治痈排脓止痛，利小便方"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611142451-o6j7308","Type":"NodeParagraph","Properties":{"id":"20240611142451-o6j7308","updated":"20240611142451"},"Children":[{"Type":"NodeText","Data":"瞿麦（一两） 芍药 桂心 赤小豆（酒浸熬） 麦门冬 川芎 黄 当归 白蔹（各二两）"}]},{"ID":"20240611142451-jjgb48i","Type":"NodeParagraph","Properties":{"id":"20240611142451-jjgb48i","updated":"20240611142451"},"Children":[{"Type":"NodeText","Data":"上九味为末，先食，酒下方寸匕，日三。"}]},{"ID":"20240611142451-h9hddmx","Type":"NodeParagraph","Properties":{"id":"20240611142451-h9hddmx","updated":"20240611142451"},"Children":[{"Type":"NodeText","Data":"（《翼方》有细辛、苡仁、白芷，不用桂心、麦门冬、白蔹，治诸痈溃及未溃疮中疼痛，脓血不绝而不可忍者）。"}]},{"ID":"20240611142426-ebwpu1r","Type":"NodeThematicBreak","Properties":{"id":"20240611142426-ebwpu1r"}},{"ID":"20240611142439-8hm10y1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142439-8hm10y1","updated":"20240611142444"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草图经》"}]},{"ID":"20240611142439-1jzgtyr","Type":"NodeParagraph","Properties":{"id":"20240611142439-1jzgtyr","updated":"20240611142446"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"瞿麦"},{"Type":"NodeText","Data":"，生泰山川谷，今处处有之。苗高一尺以来，叶尖小青色；根紫黑色，形如细蔓菁；花红紫赤色，亦似映山红，二月至五月开；七月结实作穗，子颇似麦，故以名之。立秋后合子、叶收采，阴干用。河阳河中府出者，苗可用。淮甸出者根细，村民取作刷帚。《尔雅》谓之大菊，《广雅》谓之茈萎是也。古今方通心经，利小肠为最要。张仲景治小便不利，有水气，栝蒌瞿麦丸主之。栝蒌根二两，大附子一个，茯苓、山芋各三两，瞿麦一分，五物杵末，蜜丸如梧子大。一服三丸，日三。未知，益至七、八丸。以小便利，腹中温为知也。"}]},{"ID":"20240611142426-20nb8ei","Type":"NodeThematicBreak","Properties":{"id":"20240611142426-20nb8ei"}},{"ID":"20240611142427-6xqnllj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142427-6xqnllj","updated":"20240611142431"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草求真》"}]},{"ID":"20240611142427-iijnkcn","Type":"NodeParagraph","Properties":{"id":"20240611142427-iijnkcn","updated":"20240611142427"},"Children":[{"Type":"NodeText","Data":"（隰草）大泻心热利水"}]},{"ID":"20240611142427-6rhsigp","Type":"NodeParagraph","Properties":{"id":"20240611142427-6rhsigp","updated":"20240611142427"},"Children":[{"Type":"NodeText","Data":"瞿麦（专入心。兼入小肠）。味苦性寒。功专泻心利水。故书载利小便。决肿痈。去癃闭。拔肉刺。下胎产。除目翳。然其气禀纯阳。必其小肠气浓。服此疏泄之味。病始克除。（淋症有虚有实。如淋果属热致。其茎痛不可忍。手按热如火烁。血出鲜红不黯。淋出如沙如石。脐下妨闷。烦燥热渴。六脉沉数有力。洵为属热。如其茎中不痛。痛喜手按。或于溺后搀痛。稍久则止。或登厕小便涩痛。大便牵痛。面色萎黄。饮食少思。语言懒怯。六脉虚浮无力。是为属虚。）若使小肠素虚。经云。心属有热。不惟其热不除。则虚而益虚。必致变生他症矣！妊娠产后小便不利。及脾虚水肿。均并禁焉。恶螵蛸。"}]},{"ID":"20240611142417-6d4tsbt","Type":"NodeThematicBreak","Properties":{"id":"20240611142417-6d4tsbt"}},{"ID":"20240611142418-rwnwv60","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142418-rwnwv60","updated":"20240611142422"},"Children":[{"Type":"NodeText","Data":"瞿麦《得配本草》"}]},{"ID":"20240611142418-mefsi6l","Type":"NodeParagraph","Properties":{"id":"20240611142418-mefsi6l","updated":"20240611142418"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名石竹"}]},{"ID":"20240611142418-6kbo4hj","Type":"NodeParagraph","Properties":{"id":"20240611142418-6kbo4hj","updated":"20240611142418"},"Children":[{"Type":"NodeText","Data":"牡丹、蓑草为之使。恶螵蛸。伏丹砂。"}]},{"ID":"20240611142418-wvpyc58","Type":"NodeParagraph","Properties":{"id":"20240611142418-wvpyc58","updated":"20240611142418"},"Children":[{"Type":"NodeText","Data":"苦，寒。入足太阳，兼手少阴经。破血热之郁结，决上焦之痈肿。利小便，去目翳。得蒲黄，治产后淋。配蒌仁、鸡子，治便秘。配葱白、栀子，治热结淋血。煎浓汁服之，下子死腹中。"}]},{"ID":"20240611142418-a9la8z1","Type":"NodeParagraph","Properties":{"id":"20240611142418-a9la8z1","updated":"20240611142418"},"Children":[{"Type":"NodeText","Data":"只用蕊壳，不用茎、叶，若同用令人气噎、小便不禁。以 竹沥浸漉晒用。小肠虚者禁用。"}]},{"ID":"20240611142349-v0f0l9n","Type":"NodeThematicBreak","Properties":{"id":"20240611142349-v0f0l9n"}},{"ID":"20240611142407-kotmj20","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142407-kotmj20","updated":"20240611142413"},"Children":[{"Type":"NodeText","Data":"瞿麦《名医别录》"}]},{"ID":"20240611142407-kiak2os","Type":"NodeParagraph","Properties":{"id":"20240611142407-kiak2os","updated":"20240611142407"},"Children":[{"Type":"NodeText","Data":"味辛，无毒．主养肾气，逐膀胱邪逆，止霍乱，长毛发．一名大菊，一名大兰．生太山．立秋采实，阴干．（ 草、牡丹为之使，恶桑螵蛸．）"}]},{"ID":"20240611142407-2iu6j6w","Type":"NodeParagraph","Properties":{"id":"20240611142407-2iu6j6w","updated":"20240611142407"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶瞿麦，味苦，寒．主关格诸癃结，小便不通，出刺，决痈肿，明目去翳，破胎堕子，下闭血．一名巨句麦．生川谷．"}]},{"ID":"20240611142350-dbrsobb","Type":"NodeThematicBreak","Properties":{"id":"20240611142350-dbrsobb"}},{"ID":"20240611142351-54k5am4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142351-54k5am4","updated":"20240611142357"},"Children":[{"Type":"NodeText","Data":"瞿麦《千金翼方》"}]},{"ID":"20240611142351-hy9pgz9","Type":"NodeParagraph","Properties":{"id":"20240611142351-hy9pgz9","updated":"20240611142351"},"Children":[{"Type":"NodeText","Data":"味苦辛，寒，无毒。主关格诸癃结，小便不通，出刺，决痈肿，明目去翳，破胎堕子，下闭血。养肾气，逐膀胱邪逆，止霍乱，长毛发。一名巨句麦，一名大菊，一名犬兰。生太山川谷，立秋采实，阴干。"}]},{"ID":"20240611142318-fqyru0m","Type":"NodeThematicBreak","Properties":{"id":"20240611142318-fqyru0m"}},{"ID":"20240611142342-dbxcf6m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142342-dbxcf6m","updated":"20240611142346"},"Children":[{"Type":"NodeText","Data":"瞿麦《要药分剂》"}]},{"ID":"20240611142342-5hj1tmc","Type":"NodeParagraph","Properties":{"id":"20240611142342-5hj1tmc","updated":"20240611142342"},"Children":[{"Type":"NodeText","Data":"味苦辛。性寒。无毒。禀阴寒之气而生。降也。阴也。丹皮为使。恶螵蛸。伏丹砂。"}]},{"ID":"20240611142342-za8z6sq","Type":"NodeParagraph","Properties":{"id":"20240611142342-za8z6sq","updated":"20240611142342"},"Children":[{"Type":"NodeText","Data":"【主治】主关结诸癃结。小便不通。出刺。决痈肿。明目去翳。破胎堕子。下闭血。养肾气【归经】入小肠心二经。为利水破血之品。（逐膀胱热邪治淋必须之药降心火利小肠）【前论】王执中曰。五淋大抵皆属湿热。热淋用八正散。加山栀、滑石之类。血淋。宜小蓟牛中焦作【禁忌】经疏曰。瞿麦性猛利。善下逐。凡肾气虚。小肠无大热。胎前产后。一切虚人患小【炮制】雷公曰。凡使。只用蕊壳。不用茎叶。若同使。即空心。令人气噎。小便不禁也。"}]},{"ID":"20240611142328-pw36nqt","Type":"NodeThematicBreak","Properties":{"id":"20240611142328-pw36nqt"}},{"ID":"20240611142329-qiwg83v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142329-qiwg83v","updated":"20240611142336"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草便读》"}]},{"ID":"20240611142329-v6luho2","Type":"NodeParagraph","Properties":{"id":"20240611142329-v6luho2","updated":"20240611142329"},"Children":[{"Type":"NodeText","Data":"苦寒达膀胱以分消．功专利水．下降通小肠之闭结．力可行瘀．导浊须求．治淋有力．（瞿麦色黑．能入心肝小肠膀胱血分．苦寒之性．破血利窍．足以尽之．在用者领会耳．瞿麦之性下降．逐血颇猛．若小肠膀胱无血热闭结．以及胎产虚人．皆当禁之．）"}]},{"ID":"20240611142319-0lhj5mn","Type":"NodeThematicBreak","Properties":{"id":"20240611142319-0lhj5mn"}},{"ID":"20240611142320-w3zrqa0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142320-w3zrqa0","updated":"20240611142323"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草分经》"}]},{"ID":"20240611142320-2q335ro","Type":"NodeParagraph","Properties":{"id":"20240611142320-2q335ro","updated":"20240611142320"},"Children":[{"Type":"NodeText","Data":"苦寒而性善下，降心火利小肠，逐膀胱邪热，破血利窍，决痈明目，通经治淋。"}]},{"ID":"20240611142309-xn9l8dm","Type":"NodeThematicBreak","Properties":{"id":"20240611142309-xn9l8dm"}},{"ID":"20240611142310-tcoyz1t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142310-tcoyz1t","updated":"20240611142314"},"Children":[{"Type":"NodeText","Data":"瞿麦《汤液本草》"}]},{"ID":"20240611142310-ghvimc3","Type":"NodeParagraph","Properties":{"id":"20240611142310-ghvimc3","updated":"20240611142310"},"Children":[{"Type":"NodeText","Data":"气寒，味苦、辛，阳中微阴也。"}]},{"ID":"20240611142310-rib5pi2","Type":"NodeParagraph","Properties":{"id":"20240611142310-rib5pi2","updated":"20240611142310"},"Children":[{"Type":"NodeText","Data":"《象》云∶主关格诸癃结，小便不通；治痈肿，排脓，明目去翳，破胎下闭血，逐膀胱邪热。用穗。"}]},{"ID":"20240611142310-5t0gy2p","Type":"NodeParagraph","Properties":{"id":"20240611142310-5t0gy2p","updated":"20240611142310"},"Children":[{"Type":"NodeText","Data":"《珍》云∶利小便，为君主之用。"}]},{"ID":"20240611142310-hpo6nlh","Type":"NodeParagraph","Properties":{"id":"20240611142310-hpo6nlh","updated":"20240611142310"},"Children":[{"Type":"NodeText","Data":"《本草》云∶出刺，决痈肿，明目去翳；破胎堕子，下闭血；养肾气，逐膀胱邪逆；止霍乱，长毛发。"}]},{"ID":"20240611142249-7wmt78o","Type":"NodeThematicBreak","Properties":{"id":"20240611142249-7wmt78o"}},{"ID":"20240611142300-vm4wqbi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142300-vm4wqbi","updated":"20240611142305"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草衍义》"}]},{"ID":"20240611142300-bza0lur","Type":"NodeParagraph","Properties":{"id":"20240611142300-bza0lur","updated":"20240611142300"},"Children":[{"Type":"NodeText","Data":"八政散用瞿麦，今人为至要药。若心经虽有热而小肠虚者服之，则心热未退，而小肠别作病矣。料其意者，不过为心与小肠为传送，故用此入小肠药。按经，瞿麦并不治心热。"}]},{"ID":"20240611142300-mp9u49b","Type":"NodeParagraph","Properties":{"id":"20240611142300-mp9u49b","updated":"20240611142300"},"Children":[{"Type":"NodeText","Data":"若心无大热，则当只治其心。若或制之不尽，须当求其属以衰之。用八政散者，其意如此。"}]},{"ID":"20240611142249-efua154","Type":"NodeThematicBreak","Properties":{"id":"20240611142249-efua154"}},{"ID":"20240611142250-cvz4msi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142250-cvz4msi","updated":"20240611142255"},"Children":[{"Type":"NodeText","Data":"瞿麦《本草择要纲目》"}]},{"ID":"20240611142250-z2fhhc4","Type":"NodeParagraph","Properties":{"id":"20240611142250-z2fhhc4","updated":"20240611142250"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611142250-x0umqkx","Type":"NodeParagraph","Properties":{"id":"20240611142250-x0umqkx","updated":"20240611142250"},"Children":[{"Type":"NodeText","Data":"苦寒无毒．阳中之阴也．"}]},{"ID":"20240611142250-a74d95i","Type":"NodeParagraph","Properties":{"id":"20240611142250-a74d95i","updated":"20240611142250"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611142250-wgdxjse","Type":"NodeParagraph","Properties":{"id":"20240611142250-wgdxjse","updated":"20240611142250"},"Children":[{"Type":"NodeText","Data":"关格诸癃结．小便不通．逐膀胱邪逆．主五淋月经不通．"}]},{"ID":"20240611142116-wln7eoo","Type":"NodeThematicBreak","Properties":{"id":"20240611142116-wln7eoo"}},{"ID":"20240611142129-9uxt3ec","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142129-9uxt3ec","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"《中国药典》：瞿麦"}]},{"ID":"20240611142129-woot2c1","Type":"NodeParagraph","Properties":{"id":"20240611142129-woot2c1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611142129-y1591m1","Type":"NodeParagraph","Properties":{"id":"20240611142129-y1591m1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" Qú Mài"}]},{"ID":"20240611142129-ipkqkxe","Type":"NodeParagraph","Properties":{"id":"20240611142129-ipkqkxe","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611142129-tysejl5","Type":"NodeParagraph","Properties":{"id":"20240611142129-tysejl5","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 石竹子花、十样景花、洛阳花"}]},{"ID":"20240611142129-t1veh0e","Type":"NodeParagraph","Properties":{"id":"20240611142129-t1veh0e","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611142129-nvqf9sb","Type":"NodeParagraph","Properties":{"id":"20240611142129-nvqf9sb","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" HERBA DIANTHI"}]},{"ID":"20240611142129-zl6zqnv","Type":"NodeParagraph","Properties":{"id":"20240611142129-zl6zqnv","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611142129-kjpl367","Type":"NodeParagraph","Properties":{"id":"20240611142129-kjpl367","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 本品为石竹科石竹属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"瞿麦"},{"Type":"NodeText","Data":"Dianthus superbus L. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石竹"},{"Type":"NodeText","Data":"Dianthus chinensis L.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地上部分"},{"Type":"NodeText","Data":"。夏、秋二季花果期采割，除去杂质，干燥。"}]},{"ID":"20240611142129-bpin51n","Type":"NodeParagraph","Properties":{"id":"20240611142129-bpin51n","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611142129-xmm01di","Type":"NodeParagraph","Properties":{"id":"20240611142129-xmm01di","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 瞿麦：茎圆柱形，上部有分枝，长30～60cm；表面淡绿色或黄绿色，光滑无毛，节明显，略膨大，断面中空。叶对生，多皱缩，展平叶片呈条形至条状披针形。枝端具花及果实，花萼筒状，长2.7～3.7cm；苞片4～6，宽卵形，长约为萼筒的1/4；花瓣棕紫色或棕黄色，卷曲，先端深裂成丝状。蒴果长筒形，与宿萼等长。种子细小，多数。无臭，味淡。"}]},{"ID":"20240611142129-w3ru4em","Type":"NodeParagraph","Properties":{"id":"20240611142129-w3ru4em","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"石竹：萼筒长1.4～1.8cm，苞片长约为萼筒的1/2；花瓣先端浅齿裂。"}]},{"ID":"20240611142129-i23k5vl","Type":"NodeParagraph","Properties":{"id":"20240611142129-i23k5vl","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611142129-g0qdt8v","Type":"NodeParagraph","Properties":{"id":"20240611142129-g0qdt8v","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240611142129-hym3a5p","Type":"NodeParagraph","Properties":{"id":"20240611142129-hym3a5p","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611142129-bin103r","Type":"NodeParagraph","Properties":{"id":"20240611142129-bin103r","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，稍润，切段，干燥。"}]},{"ID":"20240611142129-zw6acpr","Type":"NodeParagraph","Properties":{"id":"20240611142129-zw6acpr","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611142129-1rie5wv","Type":"NodeParagraph","Properties":{"id":"20240611142129-1rie5wv","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 取本品粉末0。5g，加水10ml，加热10分钟，趁热滤过，放冷。取滤液 2ml，置具塞试管中，用力振摇 1分钟，产生持久性泡沫，10分钟内不消失。"}]},{"ID":"20240611142129-qwl5l9w","Type":"NodeParagraph","Properties":{"id":"20240611142129-qwl5l9w","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611142129-aiwzs6l","Type":"NodeParagraph","Properties":{"id":"20240611142129-aiwzs6l","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 归心、小肠经。"}]},{"ID":"20240611142129-0n03o28","Type":"NodeParagraph","Properties":{"id":"20240611142129-0n03o28","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611142129-z1a23kc","Type":"NodeParagraph","Properties":{"id":"20240611142129-z1a23kc","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611142129-6zgzhzd","Type":"NodeParagraph","Properties":{"id":"20240611142129-6zgzhzd","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611142129-8gd0glj","Type":"NodeParagraph","Properties":{"id":"20240611142129-8gd0glj","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240611142129-86qns6f","Type":"NodeParagraph","Properties":{"id":"20240611142129-86qns6f","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611142129-0wxxdef","Type":"NodeParagraph","Properties":{"id":"20240611142129-0wxxdef","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 利尿通淋，破血通经。用于热淋，血淋，石淋，小便不通，淋沥涩痛，月经闭止。"}]},{"ID":"20240611142129-82fuhqc","Type":"NodeParagraph","Properties":{"id":"20240611142129-82fuhqc","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611142129-s7a2w48","Type":"NodeParagraph","Properties":{"id":"20240611142129-s7a2w48","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611142129-9bgx05k","Type":"NodeParagraph","Properties":{"id":"20240611142129-9bgx05k","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611142129-98p9ke7","Type":"NodeParagraph","Properties":{"id":"20240611142129-98p9ke7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" （1）用于小便淋沥涩痛等症，常与滑石、车前子、萹蓄等同用。此外，本品尚有活血通经的作用，可用于瘀滞经闭。"}]},{"ID":"20240611142129-li47i2f","Type":"NodeParagraph","Properties":{"id":"20240611142129-li47i2f","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611142129-mv0bbj2","Type":"NodeParagraph","Properties":{"id":"20240611142129-mv0bbj2","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611142129-hd8f6hm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142129-hd8f6hm","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：瞿麦"}]},{"ID":"20240611142129-mbbowkk","Type":"NodeParagraph","Properties":{"id":"20240611142129-mbbowkk","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611142129-ekfeu6l","Type":"NodeParagraph","Properties":{"id":"20240611142129-ekfeu6l","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" Qú Mài"}]},{"ID":"20240611142129-vl8qzqh","Type":"NodeParagraph","Properties":{"id":"20240611142129-vl8qzqh","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611142129-frnkql1","Type":"NodeParagraph","Properties":{"id":"20240611142129-frnkql1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 巨句麦（《本经》），大兰（《别录》），山瞿麦（《千金方》），南天竺草（《圣济总录》），剪绒花（《医林纂要》），竹节草（《山东中药》）。"}]},{"ID":"20240611142129-tmjcpyi","Type":"NodeParagraph","Properties":{"id":"20240611142129-tmjcpyi","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611142129-ncoz9vt","Type":"NodeParagraph","Properties":{"id":"20240611142129-ncoz9vt","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611142129-gsscocp","Type":"NodeParagraph","Properties":{"id":"20240611142129-gsscocp","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611142129-qo7dw5o","Type":"NodeParagraph","Properties":{"id":"20240611142129-qo7dw5o","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 为石竹科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"瞿麦"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石竹"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带花全草"},{"Type":"NodeText","Data":"。夏、秋均可采收，一般在花未开放前采取。栽培者每年可收割2～3次，割取全株，除去杂草、泥土，晒干。"}]},{"ID":"20240611142129-wq5e9b4","Type":"NodeParagraph","Properties":{"id":"20240611142129-wq5e9b4","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611142129-4krlf3x","Type":"NodeParagraph","Properties":{"id":"20240611142129-4krlf3x","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 主产河北、河南、辽宁、湖北、江苏。此外，湖南、浙江、山西、陕西、安徽、甘肃、青海、新疆、福建、云南、广西等地均产。"}]},{"ID":"20240611142129-8o5dw9l","Type":"NodeParagraph","Properties":{"id":"20240611142129-8o5dw9l","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611142129-8hczdi6","Type":"NodeParagraph","Properties":{"id":"20240611142129-8hczdi6","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" ①瞿麦，又名：大菊、蘧麦（《尔雅》），地面（《齐民要术》），红花瞿麦、野麦、木碟花、剪刀花、十样景。"}]},{"ID":"20240611142129-8c3kksy","Type":"NodeParagraph","Properties":{"id":"20240611142129-8c3kksy","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"多年生草本，高达1米。茎丛生，直立，无毛，上部2歧分枝，节明显。叶互生，线形或线状披针形，长1.5～9厘米，宽1～4毫米，先端渐尖，基部成短鞘状包茎，全缘，两面均无毛。花单生或数朵集成稀疏垃式分枝的圆锥花序；花梗长达4厘米；小苞片4～6，排成2～3轮；花萼圆筒形，长达4厘米，先端5裂，裂片披针形，边缘膜质，有细毛；花瓣5，淡红色、白色或淡紫红色，先端深裂成细线条，基部有须毛；雄蕊10；子房上位，1室，花柱2，细长。蒴果长圆形，包在宿存的萼内。花期8～9月。果期9～11月。"}]},{"ID":"20240611142129-7k2jl1p","Type":"NodeParagraph","Properties":{"id":"20240611142129-7k2jl1p","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"生于山坡或林下。全国大部分地区有分布。"}]},{"ID":"20240611142129-st4m4w7","Type":"NodeParagraph","Properties":{"id":"20240611142129-st4m4w7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②石竹（《杜工部集》），又名：鹅毛石竹、绣竹（《洛阳花木记》），洛阳花（《纲目》），石柱花。"}]},{"ID":"20240611142129-u0txmgp","Type":"NodeParagraph","Properties":{"id":"20240611142129-u0txmgp","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"外形与上种相似，主要区别为苞片卵形，叶状，开张，长为萼筒的1/2，先端尾状渐尖；萼筒长2～2.5厘米，裂片阔披针形；花瓣通常紫红色，先端浅裂成锯齿状。花期4～6月。果期6～8月。"}]},{"ID":"20240611142129-acgcic6","Type":"NodeParagraph","Properties":{"id":"20240611142129-acgcic6","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"庭园多有栽培。全国大部分地区有分布。"}]},{"ID":"20240611142129-jtujyym","Type":"NodeParagraph","Properties":{"id":"20240611142129-jtujyym","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611142129-482ak5x","Type":"NodeParagraph","Properties":{"id":"20240611142129-482ak5x","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" ①瞿麦"}]},{"ID":"20240611142129-xcww5v7","Type":"NodeParagraph","Properties":{"id":"20240611142129-xcww5v7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"为植物瞿麦的干燥全草，长30余厘米，茎直立，淡绿至黄绿色，光滑无毛，节部稍膨大。叶多数完整，对生，线形或线状披针形。花全长约3～4厘米，有淡黄色膜质的宿萼，萼筒长约为全花的3/4；萼下小苞片淡黄色，约为萼简的1/4。花冠先端深裂成细线条，淡红或淡紫色。有时可见到蒴果，长圆形，外表皱缩，顶端开裂，种子褐色、扁平。茎中空，质脆易断。气微，味微甜。"}]},{"ID":"20240611142129-di7phjm","Type":"NodeParagraph","Properties":{"id":"20240611142129-di7phjm","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②石竹瞿麦"}]},{"ID":"20240611142129-nzgbf4u","Type":"NodeParagraph","Properties":{"id":"20240611142129-nzgbf4u","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"为植物石竹的干燥全草。与瞿麦相似，惟花全长约3厘米，萼筒长约为全花的1/2，萼下小苞片约为萼筒的1/2，花冠先端浅裂呈锯齿状，棕紫色或棕黄色。"}]},{"ID":"20240611142129-i05aofy","Type":"NodeParagraph","Properties":{"id":"20240611142129-i05aofy","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"以上两种药材均以青绿色、干燥、无杂草、无根及花未开放者为佳。"}]},{"ID":"20240611142129-dm00g0u","Type":"NodeParagraph","Properties":{"id":"20240611142129-dm00g0u","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611142129-0eofd7b","Type":"NodeParagraph","Properties":{"id":"20240611142129-0eofd7b","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 瞿麦鲜草含水分77.3％，粗蛋白质2.62％，无氮浸出物13.18％，粗纤维4.95％，粗灰分11.09％，磷酸0.13％。还含维生素A类物质，其含量按维生素A计算为0.3333％。此外尚含少量生物碱。"}]},{"ID":"20240611142129-t4gdidc","Type":"NodeParagraph","Properties":{"id":"20240611142129-t4gdidc","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"石竹花含丁香油酚、苯乙醇、苯甲酸苄酯、水杨酸苄酯、水杨酸甲酯等。全草含皂甙、糖类、维生素。根含皂甙。"}]},{"ID":"20240611142129-7vdr4oe","Type":"NodeParagraph","Properties":{"id":"20240611142129-7vdr4oe","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611142129-j9zjn6t","Type":"NodeParagraph","Properties":{"id":"20240611142129-j9zjn6t","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" ①利尿作用"}]},{"ID":"20240611142129-6a86ojv","Type":"NodeParagraph","Properties":{"id":"20240611142129-6a86ojv","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"瞿麦对家兔、麻醉和不麻醉犬都有一定的利尿作用，瞿麦穗煎剂2克/公斤灌胃，可使盐水潴留的家兔在6小时内尿量增加到156.6％，氯化物增加到268.2％，瞿麦茎穗煎剂的利尿作用与纯穗相似但稍弱，瞿麦煎剂使麻醉犬尿量增加1～2.5倍，不麻醉犬尿量增加5～8倍，瞿麦对钾排泄的影响大于钠，瞿麦中含钾量为500毫克％，其利尿排钾可能与此有关。"}]},{"ID":"20240611142129-okeyt6g","Type":"NodeParagraph","Properties":{"id":"20240611142129-okeyt6g","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②对肠管的作用"}]},{"ID":"20240611142129-401olly","Type":"NodeParagraph","Properties":{"id":"20240611142129-401olly","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"在离体兔肠、麻醉犬在位肠管、狗慢性肠瘘的实验中观察到：瞿麦煎剂对肠管有显着的兴奋作用，离体兔肠主要表现在紧张度上升，麻醉犬在位肠管及狗慢性肠瘘则表现为肠蠕动增强，而张力并无太大的影响。瞿麦穗较茎穗作用稍强。苯海拉明、罂粟碱能拮抗此作用。"}]},{"ID":"20240611142129-fbyrowi","Type":"NodeParagraph","Properties":{"id":"20240611142129-fbyrowi","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③对心血管的影响"}]},{"ID":"20240611142129-7dzls59","Type":"NodeParagraph","Properties":{"id":"20240611142129-7dzls59","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"瞿麦对离体蛙心、兔心有很强的抑制作用，瞿麦穗煎剂对麻醉犬有降压作用，这可能由于心脏抑制所引起。"}]},{"ID":"20240611142129-47dxpdr","Type":"NodeParagraph","Properties":{"id":"20240611142129-47dxpdr","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"④对血吸虫的影响"}]},{"ID":"20240611142129-2akdqhe","Type":"NodeParagraph","Properties":{"id":"20240611142129-2akdqhe","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"10％瞿麦煎剂在试管内8～12分钟能杀死血吸虫虫体；100％的煎液4毫升给感染过血吸虫的家兔，每天1次，连续四周，虽病兔都先后死亡，但与对照组相比，发现余虫率减低，体重减轻缓慢，肝脏变化好转。亦有报告，瞿麦体外无杀灭血吸虫作用，体内试验用其最大耐受量或1/2的半数致死量，对感染血吸虫轻重不同的小白鼠无降低死亡率及杀灭成虫的作用。"}]},{"ID":"20240611142129-0jiwar9","Type":"NodeParagraph","Properties":{"id":"20240611142129-0jiwar9","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611142129-mxsa0b0","Type":"NodeParagraph","Properties":{"id":"20240611142129-mxsa0b0","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去残根，洗净，焖润，切段，晒干。"}]},{"ID":"20240611142129-082r7os","Type":"NodeParagraph","Properties":{"id":"20240611142129-082r7os","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使，先以竹沥浸一伏时，漉出晒干用。\""}]},{"ID":"20240611142129-n2yyi00","Type":"NodeParagraph","Properties":{"id":"20240611142129-n2yyi00","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611142129-kpquhyt","Type":"NodeParagraph","Properties":{"id":"20240611142129-kpquhyt","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 入心、肾、小肠、膀胱经。"}]},{"ID":"20240611142129-05oyajg","Type":"NodeParagraph","Properties":{"id":"20240611142129-05oyajg","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"①《本草图经》：\"通心经。\""}]},{"ID":"20240611142129-xy48rn5","Type":"NodeParagraph","Properties":{"id":"20240611142129-xy48rn5","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手少阴、太阳二经。\""}]},{"ID":"20240611142129-65s9qy7","Type":"NodeParagraph","Properties":{"id":"20240611142129-65s9qy7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③《长沙药解》：\"入足厥阴肝、足太阳膀胱经。\""}]},{"ID":"20240611142129-pv3z0y5","Type":"NodeParagraph","Properties":{"id":"20240611142129-pv3z0y5","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入心、脾、肾三经。\""}]},{"ID":"20240611142129-bwr34bo","Type":"NodeParagraph","Properties":{"id":"20240611142129-bwr34bo","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611142129-ke310e1","Type":"NodeParagraph","Properties":{"id":"20240611142129-ke310e1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611142129-loe6pzw","Type":"NodeParagraph","Properties":{"id":"20240611142129-loe6pzw","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苫，寒。\""}]},{"ID":"20240611142129-d3mrcoi","Type":"NodeParagraph","Properties":{"id":"20240611142129-d3mrcoi","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛，无毒。\""}]},{"ID":"20240611142129-bvgw4em","Type":"NodeParagraph","Properties":{"id":"20240611142129-bvgw4em","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味苦，微寒。\""}]},{"ID":"20240611142129-bmf9i39","Type":"NodeParagraph","Properties":{"id":"20240611142129-bmf9i39","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611142129-z703cjp","Type":"NodeParagraph","Properties":{"id":"20240611142129-z703cjp","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 脾、肾气虚及孕妇忌服。"}]},{"ID":"20240611142129-8maooz8","Type":"NodeParagraph","Properties":{"id":"20240611142129-8maooz8","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"蓑草、牡丹为之使。恶桑螵蛸。\""}]},{"ID":"20240611142129-yckjfuu","Type":"NodeParagraph","Properties":{"id":"20240611142129-yckjfuu","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②《品汇精要》：\"妊娠不可服。\""}]},{"ID":"20240611142129-c1l4scr","Type":"NodeParagraph","Properties":{"id":"20240611142129-c1l4scr","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"凡肾气虚，小肠无大热者忌之；胎前产后一切虚人，患小水不利，法并禁用；水肿蛊胀，脾虚者不得施。\""}]},{"ID":"20240611142129-x0224i3","Type":"NodeParagraph","Properties":{"id":"20240611142129-x0224i3","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611142129-ob9ephd","Type":"NodeParagraph","Properties":{"id":"20240611142129-ob9ephd","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 清热利水，破血通经。治小便不通，淋病，水肿，经闭，痈肿，目赤障翳，浸淫疮毒。"}]},{"ID":"20240611142129-ft2b6n1","Type":"NodeParagraph","Properties":{"id":"20240611142129-ft2b6n1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主关格诸癃结，小便不通，出刺，决痈肿，明目去翳，破胎堕子，下闭血。\""}]},{"ID":"20240611142129-e4tdoom","Type":"NodeParagraph","Properties":{"id":"20240611142129-e4tdoom","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"养肾气，逐膀胱邪逆，止霍乱，长毛发。\""}]},{"ID":"20240611142129-vh58gvf","Type":"NodeParagraph","Properties":{"id":"20240611142129-vh58gvf","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主五淋。\""}]},{"ID":"20240611142129-z3ufmc8","Type":"NodeParagraph","Properties":{"id":"20240611142129-z3ufmc8","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"叶：治痔漏并泻血，小儿蛔虫，眼目肿痛，捣敷治浸淫疮并妇人阴疮。子：催生，治月经不通，破血块，排脓。\""}]},{"ID":"20240611142129-jlfuwtl","Type":"NodeParagraph","Properties":{"id":"20240611142129-jlfuwtl","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"⑤《本草图经》：\"利小肠为最要。\""}]},{"ID":"20240611142129-f6mop6n","Type":"NodeParagraph","Properties":{"id":"20240611142129-f6mop6n","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"⑥《现代实用中药》：\"治水肿，尿热涩痛，血淋。\""}]},{"ID":"20240611142129-8xtceia","Type":"NodeParagraph","Properties":{"id":"20240611142129-8xtceia","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611142129-9rz6qu3","Type":"NodeParagraph","Properties":{"id":"20240611142129-9rz6qu3","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240611142129-6a7h7zl","Type":"NodeParagraph","Properties":{"id":"20240611142129-6a7h7zl","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611142129-pv8bhc7","Type":"NodeParagraph","Properties":{"id":"20240611142129-pv8bhc7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" ①治小便赤涩，或癃闭不通，及热淋血淋：瞿麦、萹蓄、车前子、滑石、山栀子仁、甘草（炙）、木通、大黄（面裹煨，去面切焙）各一斤。上为散。每服二钱，水一盏，入灯心，煎至七分，去渣，食后临卧温服。小儿量力少少与之。（《局方》八正散）"}]},{"ID":"20240611142129-tjv4edk","Type":"NodeParagraph","Properties":{"id":"20240611142129-tjv4edk","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②治小便不利者，有水气，其人苦渴：栝蒌根二两，茯苓、薯蓣各三两，附子一枚（炮），瞿麦一两。上五味，末之，炼蜜丸梧子大；饮服三丸，日三服，不知，增至七、八丸，以小便利，腹中温为知。（《金匮要略》栝蒌瞿麦丸）"}]},{"ID":"20240611142129-mt8ka60","Type":"NodeParagraph","Properties":{"id":"20240611142129-mt8ka60","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③治下焦结热，小便黄赤，淋闭疼痛，或有血出，及大小便俱出血者：山栀子（去皮，炒）半两，瞿麦穗一两，甘草（炙）三分。上为末。每服五钱至七钱，水一碗，入连须葱根七个，灯心五十茎，生姜五、七片，同煎至七分，时时温服。（《局方》立效散）"}]},{"ID":"20240611142129-hde9o85","Type":"NodeParagraph","Properties":{"id":"20240611142129-hde9o85","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"④治鱼脐毒疮肿：瞿麦，和生油熟捣涂之。（《崔氏纂要方》）"}]},{"ID":"20240611142129-xssh2q1","Type":"NodeParagraph","Properties":{"id":"20240611142129-xssh2q1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"⑤治血妄行，九窍皆出，服药不住者：南天竺草（生瞿麦）拇指大一把（锉），大枣（去核）五枚，生姜一块（如拇指大），灯草如小指大一把，山栀子三十枚（去皮），甘草（炙）半两。上六味锉，入瓷器中，水一大碗，煮至半碗，去滓服。（《圣济总录》南天竺饮）"}]},{"ID":"20240611142129-rs1753g","Type":"NodeParagraph","Properties":{"id":"20240611142129-rs1753g","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"⑥治目赤肿痛，浸淫等疮：瞿麦炒黄为末，以鹅涎调涂眦头，或捣汁涂之。（《圣惠方》）"}]},{"ID":"20240611142129-wyvndmb","Type":"NodeParagraph","Properties":{"id":"20240611142129-wyvndmb","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611142129-wi4dbuf","Type":"NodeParagraph","Properties":{"id":"20240611142129-wi4dbuf","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"近古方家治产难，有石竹花汤；治九孔出血，有南天竺散，皆取其破血利窍也。\""}]},{"ID":"20240611142129-5fj9i7r","Type":"NodeParagraph","Properties":{"id":"20240611142129-5fj9i7r","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"瞿麦，苦辛能破血，阴寒而降，能通利下窍而行小便，故主关格诸癃结小便不通因于小肠热甚者。寒能散热，辛能散结，故决痈肿。除湿热，故明目去翳。辛寒破血，故破胎堕子而下闭血也。去肾家热，故云养肾气。逐膀胱邪逆者，亦泄湿热故也。湿热客中焦，则清浊不分而为霍乱，通利湿热，则霍乱自解矣。\""}]},{"ID":"20240611142129-7tw4ox1","Type":"NodeParagraph","Properties":{"id":"20240611142129-7tw4ox1","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"瞿麦，性滑利，能通小便，降阴火，除五淋，利血脉。兼凉药亦消眼目肿痛；兼血药则能通经破血下胎。凡下焦湿热疼痛诸病，皆可用之。\""}]},{"ID":"20240611142129-m61kj75","Type":"NodeParagraph","Properties":{"id":"20240611142129-m61kj75","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"④《本草正义》：\"瞿麦，其性阴寒，泄降利水，除导湿退热外，无他用。《本经》渭其明目去翳，《别录》谓其养肾，则邪热清而真阴复，非通利之品果能养阴也。出刺、决壅、堕胎，其力猛矣。《别录》又称其主霍乱，则湿热内阻，清浊不分者，以为分泄遂湿之用，非主阴寒之霍乱也。《日华》谓其主五淋，月经不通；景岳谓合凉药亦消眼目肿痛，合血药则通经破血下胎，宣导下焦湿热；石顽谓利小便之君药；《日华》又谓其叶主痔漏泻血，捣敷肿毒浸淫疮，无一非清热利导之用，然必实有实热壅滞者为宜。寇宗爽谓专通小肠，着心经有热而小肠虚者勿用，辨别最为清澈。石顽亦谓妊娠产后小便不利及脾虚水肿者禁用。按，又有老人虚人气化不利而为癃闭溲少等症，亦非湿热蕴积，治宜宣化气分，五苓、入正，徒耗津液，皆为禁药。\""}]},{"ID":"20240611142129-7x9hb3y","Type":"NodeParagraph","Properties":{"id":"20240611142129-7x9hb3y","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611142129-r9kqszw","Type":"NodeParagraph","Properties":{"id":"20240611142129-r9kqszw","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 东北地区除以上两种外，尚有以其他石竹科植物如东北石竹、丝叶石竹、兴安石竹等的全草，作瞿麦使用。宁夏地区尚有以东方石竹作瞿麦使用。"}]},{"ID":"20240611142129-0io6mpw","Type":"NodeParagraph","Properties":{"id":"20240611142129-0io6mpw","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611142129-3s7iwi8","Type":"NodeParagraph","Properties":{"id":"20240611142129-3s7iwi8","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611142129-3icou5j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142129-3icou5j","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"《中华本草》：瞿麦"}]},{"ID":"20240611142129-7xuj5do","Type":"NodeParagraph","Properties":{"id":"20240611142129-7xuj5do","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611142129-bz9brd4","Type":"NodeParagraph","Properties":{"id":"20240611142129-bz9brd4","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" Qú Mài"}]},{"ID":"20240611142129-rc1o2mw","Type":"NodeParagraph","Properties":{"id":"20240611142129-rc1o2mw","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611142129-ursalrn","Type":"NodeParagraph","Properties":{"id":"20240611142129-ursalrn","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 巨句麦、大兰、山瞿麦、瞿麦穗、南天竺草、麦句姜、剪绒花、龙须、四时美、圣茏草子"}]},{"ID":"20240611142129-s6gwyn0","Type":"NodeParagraph","Properties":{"id":"20240611142129-s6gwyn0","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611142129-s9iyog0","Type":"NodeParagraph","Properties":{"id":"20240611142129-s9iyog0","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 1.《雷公炮炙论》：瞿麦只用蕊壳，不用茎叶．若一时使，即中心令人气咽，小便不禁。"}]},{"ID":"20240611142129-ta26ujx","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611142129-ta26ujx","updated":"20240611142129"},"Children":[{"ID":"20240611142129-0k0lsan","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240611142129-0k0lsan","updated":"20240611142129"},"Children":[{"ID":"20240611142129-hq0m950","Type":"NodeParagraph","Properties":{"id":"20240611142129-hq0m950","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"陶弘景：瞿麦今出近道。一茎生细叶，花红紫赤可爱，合子叶别取之。子颇似麦，故名瞿麦。此类乃两种，一种微大，花边有叉丫，未知何者是，今市入皆用小者；复一种叶广(茎)相似而有毛，花晚而甚赤。按《经》云，采实中子至细，燥熟便脱尽。今市人惟合茎叶用，而实正空壳，无复子尔。"}]}]}]},{"ID":"20240611142129-xop0j4n","Type":"NodeParagraph","Properties":{"id":"20240611142129-xop0j4n","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：瞿麦，今处处有之，"}]},{"ID":"20240611142129-lcrggi0","Type":"NodeParagraph","Properties":{"id":"20240611142129-lcrggi0","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611142129-ofgo48x","Type":"NodeParagraph","Properties":{"id":"20240611142129-ofgo48x","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 药材基源：为石竹科植物瞿麦和石竹的地上部分。"}]},{"ID":"20240611142129-q6lqsia","Type":"NodeParagraph","Properties":{"id":"20240611142129-q6lqsia","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：l．Dianthus superbus L．2．Dianthus chinensis L."}]},{"ID":"20240611142129-f2hkkzx","Type":"NodeParagraph","Properties":{"id":"20240611142129-f2hkkzx","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋花果期割取全草，除去杂草和泥土，切段或不切段，晒干。"}]},{"ID":"20240611142129-1vvakjt","Type":"NodeParagraph","Properties":{"id":"20240611142129-1vvakjt","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611142129-adicgxs","Type":"NodeParagraph","Properties":{"id":"20240611142129-adicgxs","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡、草地、路旁或林下。"}]},{"ID":"20240611142129-cgz7bng","Type":"NodeParagraph","Properties":{"id":"20240611142129-cgz7bng","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"2.生于海拔1000m以下的山坡草丛中。"}]},{"ID":"20240611142129-q07n892","Type":"NodeParagraph","Properties":{"id":"20240611142129-q07n892","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"资源分布：1.全国大部分地区有分布。"}]},{"ID":"20240611142129-htd4ybr","Type":"NodeParagraph","Properties":{"id":"20240611142129-htd4ybr","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"2.全国大部分地区均有分布。庭园亦有栽培。"}]},{"ID":"20240611142129-cv6dlrc","Type":"NodeParagraph","Properties":{"id":"20240611142129-cv6dlrc","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611142129-ofewlo6","Type":"NodeParagraph","Properties":{"id":"20240611142129-ofewlo6","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 1.多年生草本，高达1m。茎丛生，直立，无毛，上部二歧分枝，节明显。叶对生，线形或线状披针形，长1.5-9cm，宽1－4mm，先端渐尖，基部成短鞘状包茎，全缘，两面均无毛。两性花；花单生或数朵集成稀疏歧式分枝的圆锥花序；花梗长达4cm；小苞片4-6，排成2-3轮；花萼圆筒形，淡紫红色，长达4cm，先端5裂，裂片披针形，边缘膜质，有细毛；花瓣5，淡红色、白色或淡紫红色，先端深裂成细线状，基部有长爪；雄蕊10；子房上位，1室，花柱2，细长。蒴果长圆形，与宿萼近等长。种子黑色。花期8-9月，果期9-11月。"}]},{"ID":"20240611142129-3aoer2g","Type":"NodeParagraph","Properties":{"id":"20240611142129-3aoer2g","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"2.与上种相似，主要区别为：苞片卵形、叶状披针形，开张，长为萼筒的1／2，先端尾状渐尖；萼筒长2-2.5cm，裂片宽披针形；花瓣通常紫红色，喉部有斑纹和疏生须毛，先端浅裂成锯齿状。花期4-8月，果期5-9月。"}]},{"ID":"20240611142129-8vstlu6","Type":"NodeParagraph","Properties":{"id":"20240611142129-8vstlu6","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611142129-scv0395","Type":"NodeParagraph","Properties":{"id":"20240611142129-scv0395","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 生物学特性 耐寒，喜潮湿，忌干旱。土壤以砂质壤上或粘壤上最好。"}]},{"ID":"20240611142129-p5cg96l","Type":"NodeParagraph","Properties":{"id":"20240611142129-p5cg96l","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子和分株繁殖。种子繁殖：4～5月播种，开浅沟条播，沟距15～21 cm，沟深1．5- 3．Ocm，将种子均匀撒于沟内，覆土0．6～0．9cm，稍镇压，立即浇水。每1hm2播种量15-22．5kg。分株繁殖：在3～4月，将根挖出，分成5～6株1墩，随分随栽，按行距24～30cm开沟，沟深6cm，每隔6～10cm栽1墩，覆土将根周围压实，浇水。"}]},{"ID":"20240611142129-mzlz1g2","Type":"NodeParagraph","Properties":{"id":"20240611142129-mzlz1g2","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"田间管理 中耕除草全年可进行5～6次，苗高6-10cm可进行浅耕，以后每逢浇水或施肥时，均进行中耕除草。"}]},{"ID":"20240611142129-pg36oap","Type":"NodeParagraph","Properties":{"id":"20240611142129-pg36oap","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有黑粉病，可采用轮作，留无病种子作种．拔除病株．以防蔓延。根腐病，可选地势高燥地块或高畦种植，雨季注意开沟排水和在病株周围撒草木灰。"}]},{"ID":"20240611142129-u8mi11v","Type":"NodeParagraph","Properties":{"id":"20240611142129-u8mi11v","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611142129-3ues2f8","Type":"NodeParagraph","Properties":{"id":"20240611142129-3ues2f8","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）瞿麦 茎圆柱形，长30-60cm，节部膨大；表面淡绿色或黄绿色，略有光泽，无毛。叶多皱缩，对生，黄绿色，展平后叶片长条披针形，长2-7cm，宽1-4mm；叶尖稍反卷，基部短鞘状抱茎。花棕紫色或棕黄色，长3-4cm，单生或数朵簇生；具宿萼，萼筒长2．5-3．5cm，约为全花的3／4；萼下有小苞片，长约为萼筒的1／4，先端急尖或渐尖，外表有规则的纵纹；花瓣先端深裂呈流苏状。茎质硬脆，折断面中空。气无，味甘。"}]},{"ID":"20240611142129-nswt9ms","Type":"NodeParagraph","Properties":{"id":"20240611142129-nswt9ms","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"（ 2）石竹 茎直立，圆形，有分枝，长30-50cm；完整叶条状披针形，长2-9cm，宽2-7mm；萼筒长1-2cm，约为全花的1／2；萼下有数枚小苞片，长约为萼筒的1／2，先端尾状渐尖，覆瓦状排列；有时可见皱缩的花瓣，棕紫色或棕黄色，先端浅裂呈锯齿状。茎质硬脆，折断面中空。气弱，味微甜。"}]},{"ID":"20240611142129-mo1udsf","Type":"NodeParagraph","Properties":{"id":"20240611142129-mo1udsf","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"均以色青绿，花未开放者为佳。"}]},{"ID":"20240611142129-qo8qse9","Type":"NodeParagraph","Properties":{"id":"20240611142129-qo8qse9","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：（1）瞿麦 黄绿色或黄棕色。①纤维维多成束，直径10-25（-38）μm，孔沟不明显，胞腔狭窄。有的纤维外侧的细胞含草酸钙簇晶，形成晶纤维。②草酸钙簇晶较多，直径7-85μm。③非腺毛有两种。一种1-3细胞，壁薄，直径5-12μm；另一种棍棒状，1-2细胞，先端钝圆，直径10－13μm，表面有角质短条状纹理。④叶上表皮细胞表面现类多角形，垂周壁连珠状增厚，表面有稀疏的角质条纹。气孔直轴式，也有不定式。⑤花粉粒圆球形，直径31-75μm，具散孔，孔数10-17，表面有网状雕纹。⑤茎髓部厚壁细胞类长方形，直径37-93mm，壁厚3-8μm，微木化，孔沟稀疏。"}]},{"ID":"20240611142129-bjsd14c","Type":"NodeParagraph","Properties":{"id":"20240611142129-bjsd14c","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"（2）石竹 黄绿色。①纤维多成束，直径8-22μm，孔沟不明显，胞腔线形。有的外侧细胞中含草酸钙簇晶，形成晶纤维。"}]},{"ID":"20240611142129-rqrit6g","Type":"NodeParagraph","Properties":{"id":"20240611142129-rqrit6g","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"②草酸钙簇晶较多，直径（5-）8- 75μm。③非腺毛1-11个细胞，长可达300μm，直径7-33μm，有的胞腔内含黄棕色物质。"}]},{"ID":"20240611142129-sfehj46","Type":"NodeParagraph","Properties":{"id":"20240611142129-sfehj46","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"④花粉粒圆球形，直径27-53μm，具散孔，孔数9-12（-14），表面有网状雕纹。"}]},{"ID":"20240611142129-5a36dx8","Type":"NodeParagraph","Properties":{"id":"20240611142129-5a36dx8","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"理化鉴另（l）取本品粉末0．5g，加水10ml，水浴温热约15min，趁热滤过，滤液置试管中，用力振摇，产生持久性泡沫，10min内不消失。（检查皂甙）（2）薄层色谱 取本品5g，70t浸2h,滤过，滤液用正丁醇萃取，蒸干正丁醇后，刮取瓶壁上白色物溶于稀乙醇，为供试液。以蒎立醇为对照品制成对照品溶液。吸取二溶液点于硅胶G高效板上，氯仿-甲醇-水（6．5：3：0．5）展开后，碘熏1h，供试品色谱中与对照品色谱相应处，均显棕色斑点，溴甲酚紫硼酸盐缓冲液显色，黄色背景上有黄斑，次日见蓝色背景有黄色斑点。"}]},{"ID":"20240611142129-bdjme92","Type":"NodeParagraph","Properties":{"id":"20240611142129-bdjme92","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611142129-8x0yrae","Type":"NodeParagraph","Properties":{"id":"20240611142129-8x0yrae","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 1．瞿麦的带花全草含有一些黄酮类化合物如花色甙（anthocyanin）等[1,2].2．石竹的带花全草含具抗癌治性的花色甙和黄酮类化合物[3，4]。还含2个三萜皂甙：石竹皂甙（dianchinenoside）A、B［5］，1个吡喃酮甙：瞿麦吡喃酮甙（dianthoside）[6]。花含丁香油酚（eugenol），苯乙醇（phenylethyl alcohol），苯甲酸卡酯（benzyl ben-zoate），水杨酸甲酯（methyl salicylate），水杨酸卡酯（benzyl sancy-late）[7]。"}]},{"ID":"20240611142129-samk4vr","Type":"NodeParagraph","Properties":{"id":"20240611142129-samk4vr","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"此外，同属植物变色石竹的带花全草主含黄酮类化合物：金圣草素-6-顺式-α-D-吡喃葡萄糖甙（chrysoeriol－6－syn－α－D－glucopy-ranoside），金圣草素-6- 反式-α-D-吡喃葡萄糖甙（chrysoerol－6-anti-α-D-glucopyranoside）[8]。长萼石竹的带花全草土含具有镇痛和抗肝损伤活性的三萜类：瞿麦皂甙（dianoside）A、B、C、D、E、F、G、 H、I，赤豆皂甙IV（azukisaponin IV）[9-12]。还含3, 4～二羟基-5-甲基-二氢吡喃（3，4-dihydroxy-5-methyldihydropyran），4-羟基-5-甲基-二氢吡喃-3－O-β-D-葡萄糖甙（4－hydroxy-3-methyldhydropyran-3-O-β-D-glucoside)[13]。"}]},{"ID":"20240611142129-9aa09gw","Type":"NodeParagraph","Properties":{"id":"20240611142129-9aa09gw","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611142129-r1a32mp","Type":"NodeParagraph","Properties":{"id":"20240611142129-r1a32mp","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 1.利尿作用 瞿麦对家兔、麻醉和不麻醉犬都有一定的利尿作用，瞿麦穗煎剂2g/kg灌胃，可使盐水潴留的家兔在6小时内尿量增加到156.6%，氯化物增加到268.2%，瞿麦茎穗煎剂的利尿作用与纯穗相似但稍弱，瞿麦煎剂使麻醉犬尿量增加1-2.5倍，不麻醉犬尿最增加5-8倍，瞿麦对钾排泄的影响大干钠，瞿麦中含钾量为500mg%，其利尿排钾可能与此有关。"}]},{"ID":"20240611142129-m26zvke","Type":"NodeParagraph","Properties":{"id":"20240611142129-m26zvke","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"2.对肠管的作用 在离体兔肠、麻醉犬在位肠管、狗慢性肠瘘的实验中观察到：瞿麦煎剂对肠管有显着的兴奋作用，离体兔肠主要表现在紧张度上升，麻醉犬在位肠管及狗慢性肠瘘则表现为肠蠕动增强，而张力并无太大的影响。瞿麦穗较茎穗作用稍强。苯海拉明、罂粟碱能拮抗此作用。"}]},{"ID":"20240611142129-zfi61yz","Type":"NodeParagraph","Properties":{"id":"20240611142129-zfi61yz","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"3.对心血管的影响 瞿麦对离体蛙心、兔心有很强的抑制作用，瞿麦穗煎剂对麻醉犬有降压作用，这可能由于心脏抑制所引起。"}]},{"ID":"20240611142129-c7jccx2","Type":"NodeParagraph","Properties":{"id":"20240611142129-c7jccx2","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"4.对血吸虫的影响 10%瞿麦煎剂在试管内8-12分钟能杀死血吸虫虫体；100%的煎液4ml给感染过血吸虫的家兔，每天1次，连续四周，虽病兔都先后死亡，但与对照组相比，发现余虫率减低，体重减轻缓慢，肝脏变化好转。亦有报告，瞿麦体外无杀灭血吸虫作用，体内试验用其最大耐受量或 1/2的半数致死量，对感染血吸虫轻重不同的小白鼠无降低死亡率及杀灭成虫的作用。"}]},{"ID":"20240611142129-kndrg09","Type":"NodeParagraph","Properties":{"id":"20240611142129-kndrg09","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611142129-gx7perv","Type":"NodeParagraph","Properties":{"id":"20240611142129-gx7perv","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去残根，洗净，焖润，切段，晒干。《雷公炮炙论》：凡使，先以堇竹沥浸一伏时，漉出晒干用。"}]},{"ID":"20240611142129-9b9beq8","Type":"NodeParagraph","Properties":{"id":"20240611142129-9b9beq8","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611142129-bfhvgs5","Type":"NodeParagraph","Properties":{"id":"20240611142129-bfhvgs5","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 本品粗粉0.5g，加生理盐水10ml，温浸20分钟，取滤液5ml置试管中，加塞，用力振摇1分钟，产生持久性泡沫，10分钟内不消失。(检查皂甙)"}]},{"ID":"20240611142129-s2ndv1i","Type":"NodeParagraph","Properties":{"id":"20240611142129-s2ndv1i","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611142129-kboktdm","Type":"NodeParagraph","Properties":{"id":"20240611142129-kboktdm","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 心；肝；小肠；膀胱经"}]},{"ID":"20240611142129-xlns0ak","Type":"NodeParagraph","Properties":{"id":"20240611142129-xlns0ak","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611142129-oggr69e","Type":"NodeParagraph","Properties":{"id":"20240611142129-oggr69e","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 苦；性寒"}]},{"ID":"20240611142129-paopbqs","Type":"NodeParagraph","Properties":{"id":"20240611142129-paopbqs","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611142129-msqg73m","Type":"NodeParagraph","Properties":{"id":"20240611142129-msqg73m","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 脾、肾气虚及孕妇忌服。"}]},{"ID":"20240611142129-3vkqpet","Type":"NodeParagraph","Properties":{"id":"20240611142129-3vkqpet","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：蓑草、牡丹为之使。恶桑螵蛸。"}]},{"ID":"20240611142129-ji9c4pt","Type":"NodeParagraph","Properties":{"id":"20240611142129-ji9c4pt","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"2.《品汇精要》：妊娠不可服。"}]},{"ID":"20240611142129-wgvhnyz","Type":"NodeParagraph","Properties":{"id":"20240611142129-wgvhnyz","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：凡肾气虚，小肠无大热者忌之；胎前产后一切虚人，患小水不利，法并禁用；水肿蛊胀，脾虚者不得施。"}]},{"ID":"20240611142129-82gtu9j","Type":"NodeParagraph","Properties":{"id":"20240611142129-82gtu9j","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611142129-tql2zvf","Type":"NodeParagraph","Properties":{"id":"20240611142129-tql2zvf","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 利小便；清湿热；活血通经。主小便不通；热淋；血淋；石淋；闭经；目赤肿痛；痈肿疮毒；湿疮瘙痒"}]},{"ID":"20240611142129-f4zw66e","Type":"NodeParagraph","Properties":{"id":"20240611142129-f4zw66e","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611142129-vknh9q6","Type":"NodeParagraph","Properties":{"id":"20240611142129-vknh9q6","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～10g；或入九、散。外用：适量，煎汤洗；或研末撒。"}]},{"ID":"20240611142129-0nn2ep7","Type":"NodeParagraph","Properties":{"id":"20240611142129-0nn2ep7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611142129-sxbnme5","Type":"NodeParagraph","Properties":{"id":"20240611142129-sxbnme5","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" ①治小便赤涩，或癃闭不通，及热淋血淋： 瞿麦、篇蓄、车前子、滑石、山栀子仁、甘草(炙)、木通、大黄(面裹煨，去面切焙)各一斤。上为散。每服二钱，水一盏，入灯心，煎至七分，玄渣，食后临卧温服。小儿量力少少与之。(《局方》八正散)②治小便不利者，有水气，其入苦渴：括萎根二两，茯苓、薯蓣各三两，附干一枚(炮)，瞿麦一两。上五味，末之，炼蜜丸梧子大。饮服三丸，日三服，不知，增至七、八丸，以小便利、腹中温为知。(《金匮要略》栝蒌瞿麦丸)③治下焦结热，小便黄赤，淋闭疼痛，或有血出，及大小便俱出血者：山栀子(去皮，炒)半两，瞿麦穗一两，甘草(炙)三分。上为末。每服五钱至七钱，水一碗，八连须葱根七个，灯心五十茎，生姜五、七片，同煎至七分，时时温服。(《局方》立效散)④治鱼脐毒疮肿：瞿麦，和生油熟捣涂之。(《崔氏纂要方》)⑤治血妄行，九窍皆出，服药不住者：南天竺草(生瞿麦)拇指大一把(锉)，大枣(去核)五枚，生姜一块(如拇指大)，灯草如小指大一把，山栀于三十枚(去皮)，甘草(炙)半两。上六味锉，入瓷器中，水一大碗，煮至半碗，去滓服。(《圣济总录》南天竺饮)⑥治目赤肿痛，浸淫等疮：瞿麦炒黄为末，以鹅涎调涂眦头，或捣汁涂之。(《圣惠方》)"}]},{"ID":"20240611142129-x699hbf","Type":"NodeParagraph","Properties":{"id":"20240611142129-x699hbf","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611142129-l30ut1q","Type":"NodeParagraph","Properties":{"id":"20240611142129-l30ut1q","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：近古方家治产难，有石竹花汤；治九孔出血，有南天竺散，皆取其破血利窍也。"}]},{"ID":"20240611142129-kuqrtzy","Type":"NodeParagraph","Properties":{"id":"20240611142129-kuqrtzy","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：瞿麦，苦李能破血，阴寒而降，能通利下窍而行小便，故主关格请癃结小便不通因于小肠热甚者。寒能散热，辛能散结，故决痈肿。除湿热，故明目去翳。辛寒破血，故破胎堕子而下闭血也。去肾家热，故云养肾气。逐膀脱邪逆者，亦泄湿热故也。湿热客中焦，则清浊不分而为为霍乱，通利湿热，则霍乱自解矣。"}]},{"ID":"20240611142129-uuzlfb7","Type":"NodeParagraph","Properties":{"id":"20240611142129-uuzlfb7","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：瞿麦，性滑利，能通小便，降阴火，除五淋，利血脉。兼凉药亦消眼目肿痛；兼血药则能通经破血下胎。凡下焦湿热疼痛诸病，皆可用之。"}]},{"ID":"20240611142129-pu0cel4","Type":"NodeParagraph","Properties":{"id":"20240611142129-pu0cel4","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：瞿麦，其性阴寒，泄降利水，除导湿退热外，无他用。《本经》谓其阴日去翳，《别录》谓其养肾，则邪热情而真阴复，非通利之品果能养阴也。出刺、决壅、堕胎，其力猛矣。《别录》又称其主霍乱，则湿热内阻，渭浊不分者，以为分泄逐湿之用，非主阴寒之霍乱也。《日华》谓其主五淋，月经不通；景岳谓合凉药亦消眼目肿痛，合血药则通经被血下胎，宣导下焦湿热；石顽谓利小便之君药；《日华》又谓其叶主痔漏泻血，捣敷肿毒浸淫疮，无一非清热利导之用，然必实有实热壅滞者为宜。寇宗谓专通小肠，若心经有热而小肠虚者勿用，辨别最为清澈。石顽亦谓妊娠产后小便不利及脾虚水肿者禁用。按，又有老人虚人气化不利而为癃闭溲少等症，亦非湿热蕴积，治宜宣化气分，五苓、八正，徒耗津液，皆为禁药。"}]},{"ID":"20240611142129-zmrp2lw","Type":"NodeParagraph","Properties":{"id":"20240611142129-zmrp2lw","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主关格诸癃结，小便不通，出刺，决痈肿，明目去翳，被胎堕子，下闭血。"}]},{"ID":"20240611142129-56m3u8d","Type":"NodeParagraph","Properties":{"id":"20240611142129-56m3u8d","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"6.《别录》：养肾气，逐膀脱邪逆，止霍乱，长毛发。"}]},{"ID":"20240611142129-globmqa","Type":"NodeParagraph","Properties":{"id":"20240611142129-globmqa","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：主五淋。"}]},{"ID":"20240611142129-p6p3d0e","Type":"NodeParagraph","Properties":{"id":"20240611142129-p6p3d0e","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：叶：治痔漏并泻血，小儿蛔虫，眼目肿痛，捣敷治浸淫疮并妇人阴疮。子：催生，治月经不通，破血块，排脓。"}]},{"ID":"20240611142129-p8e1q5q","Type":"NodeParagraph","Properties":{"id":"20240611142129-p8e1q5q","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"9.《本草图经》：利小肠为最要。"}]},{"ID":"20240611142129-tpj1aw6","Type":"NodeParagraph","Properties":{"id":"20240611142129-tpj1aw6","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"10.《现代实用中药》：治水肿，尿热涩痛，血淋。"}]},{"ID":"20240611142129-4k43j4s","Type":"NodeParagraph","Properties":{"id":"20240611142129-4k43j4s","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611142129-gdykawl","Type":"NodeParagraph","Properties":{"id":"20240611142129-gdykawl","updated":"20240611142129"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611142131-mz0nfng","Type":"NodeThematicBreak","Properties":{"id":"20240611142131-mz0nfng"}},{"ID":"20240611142132-wlfj57u","Type":"NodeParagraph","Properties":{"id":"20240611142132-wlfj57u"}}]}