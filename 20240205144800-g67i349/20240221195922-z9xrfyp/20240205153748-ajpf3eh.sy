kText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705114233-xv4ipr4.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 365px;\" parent-style=\"width: 375px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 276px;","style":"width: 266px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705114248-4v99d72.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 266px;\" parent-style=\"width: 276px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240705114019-nvt7n00","Type":"NodeParagraph","Properties":{"id":"20240705114019-nvt7n00","updated":"20240705114611"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 476px;","style":"width: 466px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五叶木通4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五叶木通4-20240705114005-m14xvym.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 466px;\" parent-style=\"width: 476px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 476px;","style":"width: 466px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"三叶木通2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/三叶木通2-20240705113119-mvavb43.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 466px;\" parent-style=\"width: 476px;\"}"},{"Type":"NodeText","Data":"​​​​​"}]},{"ID":"20240705113603-pb394zd","Type":"NodeParagraph","Properties":{"id":"20240705113603-pb394zd","updated":"20240705113849"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 379px;","style":"width: 369px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶木通"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶木通-20240705113309-rw779or.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 369px;\" parent-style=\"width: 379px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 645px;","style":"width: 635px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶木通3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶木通3-20240705113841-6sx13uz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 635px;\" parent-style=\"width: 645px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240705113801-ppnlh7v","Type":"NodeParagraph","Properties":{"id":"20240705113801-ppnlh7v","updated":"20240705113847"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 745px;","style":"width: 735px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705113603-f030cv6.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 735px;\" parent-style=\"width: 745px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶木通4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶木通4-20240705113801-nufg2ln.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240705113435-39w11dx","Type":"NodeParagraph","Properties":{"id":"20240705113435-39w11dx","updated":"20240705114449"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 584px;","style":"width: 574px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木通花4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木通花4-20240705114449-0q29fmw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 574px;\" parent-style=\"width: 584px;\"}"},{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 515px;","style":"width: 505px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"七叶木通花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/七叶木通花-20240705113435-ea9xgxi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 505px;\" parent-style=\"width: 515px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705114408-01ktwuh","Type":"NodeParagraph","Properties":{"id":"20240705114408-01ktwuh","updated":"20240705114410"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 601px;","style":"width: 591px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705114349-aknoyyk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 591px;\" parent-style=\"width: 601px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 549px;","style":"width: 539px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木通花3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木通花3-20240705114408-yunq7ll.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 539px;\" parent-style=\"width: 549px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240705113519-w4as6nl","Type":"NodeParagraph","Properties":{"id":"20240705113519-w4as6nl","updated":"20240705114158"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 335px;","style":"width: 325px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705114156-opvlvq9.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 325px;\" parent-style=\"width: 335px;\"}"},{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240705114134-96s8l75.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240705114710-8svqn2q","Type":"NodeParagraph","Properties":{"id":"20240705114710-8svqn2q","updated":"20240828153503"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：该篇整理较乱，网络上木通品类较多且权威资料较少。"}]},{"ID":"20240614124427-fbn8lts","Type":"NodeThematicBreak","Properties":{"id":"20240614124427-fbn8lts"}},{"ID":"20240614124440-znw8sho","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124440-znw8sho","updated":"20240614124444"},"Children":[{"Type":"NodeText","Data":"木通《本经逢原》"}]},{"ID":"20240614124440-aicp6qg","Type":"NodeParagraph","Properties":{"id":"20240614124440-aicp6qg","updated":"20240614124440"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原名通草"}]},{"ID":"20240614124440-2qrpnrm","Type":"NodeParagraph","Properties":{"id":"20240614124440-2qrpnrm","updated":"20240614124440"},"Children":[{"Type":"NodeText","Data":"平淡，无毒。色淡黄细香者佳。"}]},{"ID":"20240614124440-lm1raml","Type":"NodeParagraph","Properties":{"id":"20240614124440-lm1raml","updated":"20240614124440"},"Children":[{"Type":"NodeText","Data":"《本经》除脾胃寒热，通利九窍血脉关节，令人不忘，去恶虫。"}]},{"ID":"20240614124440-sjqvwic","Type":"NodeParagraph","Properties":{"id":"20240614124440-sjqvwic","updated":"20240614124440"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"木通， 根也，入手足太阳、手少阴、厥阴。泻气分湿热，防己泻血分湿热。"}]},{"ID":"20240614124440-acj3jx7","Type":"NodeParagraph","Properties":{"id":"20240614124440-acj3jx7","updated":"20240614124440"},"Children":[{"Type":"NodeText","Data":"脾胃不和则水道不利，乃致郁，为寒热，为肿胀，为淋秘，为痹瘅，俱宜木通淡渗之剂，分利阴阳，则水行火降，脾胃和，而心肾平矣。《本经》除脾胃寒热者，以其通利湿热也。曰通利九窍、血脉、关节者，以其味淡渗也。曰令人不忘及去恶虫者，窍利则神识清，湿散则恶虫去。以其通达九窍，行十二经，故又能催生下乳，散痈肿结热。惟胃虚肾冷，及伤寒大便结燥，表虚多汗者禁服。恐重伤津液耗散胃汁也。时珍曰，木通上能通心清肺达九窍，下能泄湿祛热，岂止利小便而已哉。盖能泄丙丁则肺不受邪。能通水道，水源即清，而诸经之湿热皆从小便泄去，故导赤散用之。"}]},{"ID":"20240614124427-zh4wg5l","Type":"NodeThematicBreak","Properties":{"id":"20240614124427-zh4wg5l"}},{"ID":"20240614124429-3jjmn28","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124429-3jjmn28","updated":"20240614124435"},"Children":[{"Type":"NodeText","Data":"木通《本草新编》"}]},{"ID":"20240614124429-czg3ruy","Type":"NodeParagraph","Properties":{"id":"20240614124429-czg3ruy","updated":"20240614124429"},"Children":[{"Type":"NodeText","Data":"木通，即葡萄根也。味苦涩，气微寒。入膀胱。逐水气，利小便。亦佐使之药，不可不用，而又不可多用。多用泄人元气。"}]},{"ID":"20240614124429-lmc6a8g","Type":"NodeParagraph","Properties":{"id":"20240614124429-lmc6a8g","updated":"20240614124429"},"Children":[{"Type":"NodeText","Data":"或疑木通利水，去滞气，亦有益之品，何先生谓是泄人元气？曰∶木通利水，何异于猪苓，但嫌其苦寒损胃，非若淡泻之无害也。胃气既伤，元气必耗，故用之为佐使，则有功无过。"}]},{"ID":"20240614124429-7287wvc","Type":"NodeParagraph","Properties":{"id":"20240614124429-7287wvc","updated":"20240614124429"},"Children":[{"Type":"NodeText","Data":"倘多用之为君，则过于祛逐，元气必随水而走，安得不耗哉。"}]},{"ID":"20240614124523-3jhayc3","Type":"NodeThematicBreak","Properties":{"id":"20240614124523-3jhayc3"}},{"ID":"20240614124524-u47j486","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124524-u47j486","updated":"20240614124529"},"Children":[{"Type":"NodeText","Data":"木通《本草崇原》"}]},{"ID":"20240614124524-2ykyhvr","Type":"NodeParagraph","Properties":{"id":"20240614124524-2ykyhvr","updated":"20240614124524"},"Children":[{"Type":"NodeText","Data":"气味辛平，无毒。主除脾胃寒热，通利九窍血脉关节，令人不忘，去恶虫。"}]},{"ID":"20240614124524-vghwtx4","Type":"NodeParagraph","Properties":{"id":"20240614124524-vghwtx4","updated":"20240614124524"},"Children":[{"Type":"NodeText","Data":"（木通《本经》名通草，茎中有细孔，吹之两头皆通，故名通草。除士良撰《食性本草》改为木通，今药中复有所谓通草，乃是古之通脱木也，与此不同。始出石城山谷及山阳，今泽潞、汉中、江淮、湖南州郡皆有，绕树藤生，伤之有白汁出，一枝五叶，茎色黄白，干有小大，伤水则黑，黑者勿用。）"}]},{"ID":"20240614124524-b04os3g","Type":"NodeParagraph","Properties":{"id":"20240614124524-b04os3g","updated":"20240614124524"},"Children":[{"Type":"NodeText","Data":"木通藤蔓空通，其色黄白，气味辛平，禀土金相生之气化，而通关利窍之药也。禀土气，故除脾胃之寒热。藤蔓空通，故通利九窍、血脉、关节。血脉通而关窍利，则令人不忘。禀金气，故去恶虫。"}]},{"ID":"20240614124524-v1mpfha","Type":"NodeParagraph","Properties":{"id":"20240614124524-v1mpfha","updated":"20240614124524"},"Children":[{"Type":"NodeText","Data":"防己、木通皆属空通蔓草。防己取用在下之根，则其性自下而上，从内而外。木通取用在上之茎，则其性自上而下，自外而内，此根升梢降，一定不易之理。后人用之，主利小便，须知小便不利，亦必上而后下，外而后内也。"}]},{"ID":"20240614124356-0571u35","Type":"NodeThematicBreak","Properties":{"id":"20240614124356-0571u35"}},{"ID":"20240614124409-rkn54p9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124409-rkn54p9","updated":"20240614124417"},"Children":[{"Type":"NodeText","Data":"木通《本草择要纲目》"}]},{"ID":"20240614124409-d3o6djv","Type":"NodeParagraph","Properties":{"id":"20240614124409-d3o6djv","updated":"20240614124409"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240614124409-aql4pdg","Type":"NodeParagraph","Properties":{"id":"20240614124409-aql4pdg","updated":"20240614124409"},"Children":[{"Type":"NodeText","Data":"辛平无毒．降也．为阳中之阴．手厥阴心包络手足太阳小肠膀胱之药．上能通心清肺．治头痛．利九窍．下能泄湿热．利小便．通大肠．疗遍身拘痛．及下乳通经．故古方导赤散用之．实泻南补北．扶西抑东之意也．"}]},{"ID":"20240614124356-r19a8n4","Type":"NodeThematicBreak","Properties":{"id":"20240614124356-r19a8n4"}},{"ID":"20240614124358-mo87iev","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124358-mo87iev","updated":"20240614124404"},"Children":[{"Type":"NodeText","Data":"木通《本草便读》"}]},{"ID":"20240614124358-qn9jzf5","Type":"NodeParagraph","Properties":{"id":"20240614124358-qn9jzf5","updated":"20240614124358"},"Children":[{"Type":"NodeText","Data":"入心且及小肠．通淋利窍．导湿下行水道．味苦性寒．涤热行瘀．源流无阻．催生下乳．关节皆通．（木通．苦寒之品．能入心与小肠．清湿热．利九窍．能宣通上下气血．其所以治淋治乳者．无非清心宣窍之功．以肺无热逼．则气化之源清而淋浊愈．胃为气血之海．气血宣通．则乳病愈耳．然性极苦寒．不可浪投．木通藤属绕树而生．吹之上下皆通．性虽苦．却能宣通关节．或痛或肿等证．皆可治之．不独降利之功而已也．）"}]},{"ID":"20240614124132-dnmwwk1","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-dnmwwk1"}},{"ID":"20240614124347-c5plvdo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124347-c5plvdo","updated":"20240614124351"},"Children":[{"Type":"NodeText","Data":"木通《得配本草》"}]},{"ID":"20240614124347-crikq1o","Type":"NodeParagraph","Properties":{"id":"20240614124347-crikq1o","updated":"20240614124347"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"古名通草"}]},{"ID":"20240614124347-4rxzhkb","Type":"NodeParagraph","Properties":{"id":"20240614124347-4rxzhkb","updated":"20240614124347"},"Children":[{"Type":"NodeText","Data":"苦、淡、平。入手厥阴、手足太阳经气分。泄三焦之邪热，而归小肠。通九窍之血脉，而利关节。治水肿浮大，疗君火上炎，催生下乳，退喉痹，去脾疸，理鼻 ，开耳聋，散痈肿。"}]},{"ID":"20240614124347-6p6pqar","Type":"NodeParagraph","Properties":{"id":"20240614124347-6p6pqar","updated":"20240614124347"},"Children":[{"Type":"NodeText","Data":"配生地黄、炙甘草、竹叶，治心热尿赤。"}]},{"ID":"20240614124347-t2glmh3","Type":"NodeParagraph","Properties":{"id":"20240614124347-t2glmh3","updated":"20240614124347"},"Children":[{"Type":"NodeText","Data":"肾气虚，心气弱，汗不彻，口舌燥，孕妇，皆禁用。此药昔所不用，以其大泄心肾之气。"}]},{"ID":"20240614124347-rs1hdoe","Type":"NodeParagraph","Properties":{"id":"20240614124347-rs1hdoe","updated":"20240614124347"},"Children":[{"Type":"NodeText","Data":"素染虚症，或病久气血两亏者，用之元气衰脱，多无救药。"}]},{"ID":"20240614124132-jw2n2sl","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-jw2n2sl"}},{"ID":"20240614124335-tli2hc7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124335-tli2hc7","updated":"20240614124341"},"Children":[{"Type":"NodeText","Data":"木通《神农本草经读》"}]},{"ID":"20240614124335-lpipnxy","Type":"NodeParagraph","Properties":{"id":"20240614124335-lpipnxy","updated":"20240614124335"},"Children":[{"Type":"NodeText","Data":"气味辛、平，无毒。主除脾胃寒热，通利九窍，血脉，关节，令人不忘，去恶虫。（木通，《本经》名通草。陈士良撰《食性本草》，改为木通。今复有所谓通草，即古之通脱木也，与此不同。）张隐庵曰∶木通藤蔓空通，其色黄白，气味辛平，禀土金相生之气化，而为通关利窍之药也。禀土气，故除脾胃之寒热。藤蔓空通，故通利九窍、血脉、关节。血脉通而关窍利，则令人不忘。禀金气，故去恶虫。"}]},{"ID":"20240614124335-s1x1y7n","Type":"NodeParagraph","Properties":{"id":"20240614124335-s1x1y7n","updated":"20240614124335"},"Children":[{"Type":"NodeText","Data":"防己、木通，皆属空通蔓草。防己取用在下之根，则其性自下而上，从内而外；木通取用在须知小便之利，亦必上而后下，外而后内也。"}]},{"ID":"20240614124132-17b9w9a","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-17b9w9a"}},{"ID":"20240614124326-5hmonra","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124326-5hmonra","updated":"20240614124330"},"Children":[{"Type":"NodeText","Data":"木通《本草求真》"}]},{"ID":"20240614124326-mlpatue","Type":"NodeParagraph","Properties":{"id":"20240614124326-mlpatue","updated":"20240614124326"},"Children":[{"Type":"NodeText","Data":"（蔓草）泻心经小肠湿热"}]},{"ID":"20240614124326-364ej2o","Type":"NodeParagraph","Properties":{"id":"20240614124326-364ej2o","updated":"20240614124326"},"Children":[{"Type":"NodeText","Data":"木通（专入心。兼入小肠。古名通草。今之通草。即古所名通脱木）。甘淡轻虚。据书开载治效甚多。然究不外清火通窍利水数端而已。缘人一身上下。外无风寒暑湿六淫郁而为热。内无火气熏蒸。则水道顺畅。一身安养。上自咽喉以迄心胸。下自大腹以迄二便。而无膈结不通之弊矣。东垣曰。凡人肺受热邪。津液气化之源绝。（肺为水源。）则泉水断流。（源绝则流断。）膀胱受湿热癃闭约束。则小便不通。（湿热为害。）朱二允曰。火在上则口燥眼赤鼻干。在中则心烦呕哕。在下则淋闭足肿。木通藤细有孔。两头皆通。体轻质浮。味淡气渗。能泻君火。火退则小便自利。（心与小肠相表里。）便利。则诸经火邪皆从心水而下降矣。是以行经下乳。（火不内亢则经调乳通。）破血除蒸。（热除则血破。血破则蒸除。）止烦住痛。（心热清则烦除痛止。）排脓生肌。（心热除则气血得养而肌肉生。）开关利节。（心窍通则经络流行。故关节亦通。）并凡因于湿热而成者。无不借此以为开导。此虽类泽泻同为渗利。但君火动则宜木通。相火动则宜泽泻也。惟神气亏损。汗多外出。及虚弱孕妇者切忌。以性通利故耳。"}]},{"ID":"20240614124132-owad2bt","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-owad2bt"}},{"ID":"20240614124315-6m55357","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124315-6m55357","updated":"20240614124319"},"Children":[{"Type":"NodeText","Data":"木通《本草分经》"}]},{"ID":"20240614124315-2kaygau","Type":"NodeParagraph","Properties":{"id":"20240614124315-2kaygau","updated":"20240614124315"},"Children":[{"Type":"NodeText","Data":"辛甘淡平，上通心包下通大小肠膀胱，降心火而因清肺热，导诸湿热由小便出，兼通大便，利九窍血脉关节，治上中下三焦火症及脾热好眠。"}]},{"ID":"20240614124132-1dr52vw","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-1dr52vw"}},{"ID":"20240614124305-647l8iu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124305-647l8iu","updated":"20240614124310"},"Children":[{"Type":"NodeText","Data":"木通《本草经解》"}]},{"ID":"20240614124305-8ki65zb","Type":"NodeParagraph","Properties":{"id":"20240614124305-8ki65zb","updated":"20240614124305"},"Children":[{"Type":"NodeText","Data":"气平．味辛．无毒．主除脾胃寒热．通利九窍血脉关节．令人不忘．去恶虫．木通气平．禀天秋平之金气．味辛无毒．得地西方之金味．专入手太阴肺经．气降味苦．阴也．其除脾胃寒热者．盖饮入于胃．游溢精气．上输于脾．脾气散精．上归于肺．肺气通调水道．乃下输膀胱．如水道不通．则饮留于脾胃而发寒热矣．木通入肺．以通水道．故除脾胃寒热也．九窍者．耳目鼻各二．口大小便各一也．木通气平则利．味辛则通．所以通利九窍血脉关节也．其令人不忘者．心藏神而属火．水道通则心火有制．神清多记忆也．湿热不除．则化生恶虫．水道通．则湿热有去路．故恶虫不生也．"}]},{"ID":"20240614124305-w2r5974","Type":"NodeParagraph","Properties":{"id":"20240614124305-w2r5974","updated":"20240614124305"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614124305-frx8si5","Type":"NodeParagraph","Properties":{"id":"20240614124305-frx8si5","updated":"20240614124305"},"Children":[{"Type":"NodeText","Data":"木通同生地、炙草、竹叶．治心热便赤．同白茯、泽泻、车前、猪苓、灯心．治癃闭．同牛膝、生地、天冬、麦冬、五味、黄柏、甘草．治尿血．同生地、甘草、赤茯、竹叶．名导赤散．泻小肠之火．"}]},{"ID":"20240614124132-fmv24v4","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-fmv24v4"}},{"ID":"20240614124257-e53kugx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124257-e53kugx","updated":"20240614124300"},"Children":[{"Type":"NodeText","Data":"木通《要药分剂》"}]},{"ID":"20240614124257-24ibltt","Type":"NodeParagraph","Properties":{"id":"20240614124257-24ibltt","updated":"20240614124257"},"Children":[{"Type":"NodeText","Data":"古名通草。味甘辛。性平。无毒。禀清秋之气。兼得土之甘淡以生。降也。阳中阴也。"}]},{"ID":"20240614124257-2zzdp3n","Type":"NodeParagraph","Properties":{"id":"20240614124257-2zzdp3n","updated":"20240614124257"},"Children":[{"Type":"NodeText","Data":"【主治】主去恶虫。除脾胃寒热。通利九窍血脉关节。令人不忘。疗脾疸。常欲眠。心烦哕三虫治【归经】入心肾膀胱小肠四经。为通利之品。（兼轻剂除烦退热行水下乳止痛排脓）【前论】李杲曰。通草甘淡。能助肺气下降。利小便。专泻气滞也。肺受热邪。津液气化之源绝。则寒水断流。膀胱受湿热癃闭约缩。小便不通。宜此治之。凡气味相同者。茯苓、泽功源。"}]},{"ID":"20240614124257-hu3mkrs","Type":"NodeParagraph","Properties":{"id":"20240614124257-hu3mkrs","updated":"20240614124257"},"Children":[{"Type":"NodeText","Data":"燥也。"}]},{"ID":"20240614124257-ycps13v","Type":"NodeParagraph","Properties":{"id":"20240614124257-ycps13v","updated":"20240614124257"},"Children":[{"Type":"NodeText","Data":"于小肠。"}]},{"ID":"20240614124257-i58jmaw","Type":"NodeParagraph","Properties":{"id":"20240614124257-i58jmaw","updated":"20240614124257"},"Children":[{"Type":"NodeText","Data":"皆是伏热鳌按、木通有细孔。直通两头。故能通窍。每节有二三枝。枝头有五叶。其子垂梢际。"}]},{"ID":"20240614124257-knzyz7l","Type":"NodeParagraph","Properties":{"id":"20240614124257-knzyz7l","updated":"20240614124257"},"Children":[{"Type":"NodeText","Data":"核黑食是【禁忌】经疏曰。凡精滑不梦自遗。及阳虚气弱。内无湿热者。均忌。妊娠尤忌。"}]},{"ID":"20240614124132-1dq90u3","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-1dq90u3"}},{"ID":"20240614124241-t6vw7dj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124241-t6vw7dj","updated":"20240614124250"},"Children":[{"Type":"NodeText","Data":"木通《玉楸药解》"}]},{"ID":"20240614124241-xhx0oak","Type":"NodeParagraph","Properties":{"id":"20240614124241-xhx0oak","updated":"20240614124241"},"Children":[{"Type":"NodeText","Data":"味辛，气平，入足太阳膀胱经。通经利水，渗湿清热。"}]},{"ID":"20240614124241-gyjsm74","Type":"NodeParagraph","Properties":{"id":"20240614124241-gyjsm74","updated":"20240614124241"},"Children":[{"Type":"NodeText","Data":"木通孔窍玲珑，通利窍隧，利水开癃，渗泻膀胱湿热。庸工利水方中，率多用之，而绝不得效。本草诸家，未参验耳。"}]},{"ID":"20240614124132-df9i25v","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-df9i25v"}},{"ID":"20240614124152-xfwktat","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124152-xfwktat","updated":"20240614124158"},"Children":[{"Type":"NodeText","Data":"木通《中药学》"}]},{"ID":"20240614124152-zk1zas3","Type":"NodeParagraph","Properties":{"id":"20240614124152-zk1zas3","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【药用】马兜铃科藤本植物东北马兜铃AristoloehiamanshuriensisKom.的藤茎。"}]},{"ID":"20240614124152-el2hugo","Type":"NodeParagraph","Properties":{"id":"20240614124152-el2hugo","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【性味】苦，寒。归心、脾、小肠、膀胱经。"}]},{"ID":"20240614124152-tjadieh","Type":"NodeParagraph","Properties":{"id":"20240614124152-tjadieh","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【功效】清热利水通淋，清泄心火，通乳，利痹。"}]},{"ID":"20240614124152-psuhx70","Type":"NodeParagraph","Properties":{"id":"20240614124152-psuhx70","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于小便不利，淋沥涩痛，水肿，脚气等症"}]},{"ID":"20240614124152-2g7gs1k","Type":"NodeParagraph","Properties":{"id":"20240614124152-2g7gs1k","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"木通寒能清热，苦能泄降，功能利水通淋，为治湿热下注、淋沥涩痛要药，常与车前子、滑石等同用。且利尿力强，对小便不利、水肿、脚气等症也常恃为要药，可配其它利水消肿药如桑白皮、猪苓等同用。"}]},{"ID":"20240614124152-m55lrc5","Type":"NodeParagraph","Properties":{"id":"20240614124152-m55lrc5","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"2.用于心烦不眠，口舌生疮"}]},{"ID":"20240614124152-c9jgqm6","Type":"NodeParagraph","Properties":{"id":"20240614124152-c9jgqm6","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"木通性味苦寒，能入心经，且能利通小便，导热下行而降心火，故可用于心火上炎、心烦尿赤、口舌生疮等症，常与生地、竹叶、甘草同用。"}]},{"ID":"20240614124152-sgo0a4q","Type":"NodeParagraph","Properties":{"id":"20240614124152-sgo0a4q","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"3.用于乳汁稀少"}]},{"ID":"20240614124152-0vto3vk","Type":"NodeParagraph","Properties":{"id":"20240614124152-0vto3vk","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"木通又能通利血脉而下乳汁，故可用于产后乳汁稀少，常与王不流行、穿山甲等配伍；或与猪蹄同煮服用。"}]},{"ID":"20240614124152-k1thej4","Type":"NodeParagraph","Properties":{"id":"20240614124152-k1thej4","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"4.用于湿热痹痛"}]},{"ID":"20240614124152-y9skpox","Type":"NodeParagraph","Properties":{"id":"20240614124152-y9skpox","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"木通又能通利渗湿，以治湿热痹痛、关节不利之症，常与薏苡仁、桑枝、忍冬藤等配伍应用。"}]},{"ID":"20240614124152-n8rs8bn","Type":"NodeParagraph","Properties":{"id":"20240614124152-n8rs8bn","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【处方用名】木通、关木通、潼木通（晒干，切片用）"}]},{"ID":"20240614124152-wxknbyd","Type":"NodeParagraph","Properties":{"id":"20240614124152-wxknbyd","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服"}]},{"ID":"20240614124152-b9v3oax","Type":"NodeParagraph","Properties":{"id":"20240614124152-b9v3oax","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【按语】1.木通味甚苦而性寒，功能通泄为其要领。既能清热利水，以治小便不利、湿热淋痛，又能清心除烦，以治心火上炎，心烦口疮。其性通利，故又为治痹痛而下乳汁之要药。"}]},{"ID":"20240614124152-o3a96rq","Type":"NodeParagraph","Properties":{"id":"20240614124152-o3a96rq","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"2.车前子、滑石与木通均为清热利水通淋常用要药，临床常配合应用。车前子能治泄泻，又为肺肝二经之品，功能祛痰、明目；滑石亦能治泄泻，且有清解暑热、清热收湿作用；木通则善能利痹、下乳，且入心经，可治心火上炎之症。"}]},{"ID":"20240614124152-gfkimn4","Type":"NodeParagraph","Properties":{"id":"20240614124152-gfkimn4","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"3.木通与通草，虽都是通利降水的药品，但木通味苦，以利水泄热见长；通草味淡，以淡渗利湿为胜。《本草纲目》载云：「有细细孔，两头皆通，故名通草，即今所谓木通也，今之通草，乃古之通脱木也。」可见古今名称有所更易，应于区别。"}]},{"ID":"20240614124152-rfwkl06","Type":"NodeParagraph","Properties":{"id":"20240614124152-rfwkl06","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"4.据现代文献报导，有用大量木通（60g）煎汤服用后引起急性肾功能衰竭者，故在临床应用时不宜大量使用。孕妇慎用。"}]},{"ID":"20240614124152-nkhhfql","Type":"NodeParagraph","Properties":{"id":"20240614124152-nkhhfql","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"【方剂举例】1.木通散（《证治准绳》）：木通、猪苓、赤苓、桑白皮、紫苏、槟榔。治湿脚气，遍身浮肿，喘促烦闷，小便不利。"}]},{"ID":"20240614124152-a7ny67u","Type":"NodeParagraph","Properties":{"id":"20240614124152-a7ny67u","updated":"20240614124152"},"Children":[{"Type":"NodeText","Data":"2.导赤散（《小儿药证直诀》）：木通、生地、甘草梢、竹叶。治心经有热，口舌生疮，小便短赤等。"}]},{"ID":"20240614124132-v643iih","Type":"NodeThematicBreak","Properties":{"id":"20240614124132-v643iih"}},{"ID":"20240614124139-9m41cdc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124139-9m41cdc","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：木通"}]},{"ID":"20240614124139-5z3gxuo","Type":"NodeParagraph","Properties":{"id":"20240614124139-5z3gxuo","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614124139-kbtn222","Type":"NodeParagraph","Properties":{"id":"20240614124139-kbtn222","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" Mù Tōnɡ"}]},{"ID":"20240614124139-wndbey2","Type":"NodeParagraph","Properties":{"id":"20240614124139-wndbey2","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614124139-lw41hnf","Type":"NodeParagraph","Properties":{"id":"20240614124139-lw41hnf","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 通草、附支（《本经》），丁翁（《吴普本草》），丁父（《广雅》），葍藤（《本草经集注》），王翁、万年、万年藤（《药性论》），燕蕧、乌蕧（《唐本草》）。"}]},{"ID":"20240614124139-bfh20bi","Type":"NodeParagraph","Properties":{"id":"20240614124139-bfh20bi","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614124139-9rk4tjq","Type":"NodeParagraph","Properties":{"id":"20240614124139-9rk4tjq","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 《药性论》"}]},{"ID":"20240614124139-xnbxj1e","Type":"NodeParagraph","Properties":{"id":"20240614124139-xnbxj1e","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614124139-69qhejj","Type":"NodeParagraph","Properties":{"id":"20240614124139-69qhejj","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 为木通科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白木通"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三叶木通"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木通"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木质茎"},{"Type":"NodeText","Data":"。9月采收，截取茎部，刮去外皮，阴干。"}]},{"ID":"20240614124139-50twvqf","Type":"NodeParagraph","Properties":{"id":"20240614124139-50twvqf","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614124139-31dimw7","Type":"NodeParagraph","Properties":{"id":"20240614124139-31dimw7","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" ①白木通，又名：八月瓜藤、地海参。"}]},{"ID":"20240614124139-dknpew8","Type":"NodeParagraph","Properties":{"id":"20240614124139-dknpew8","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"落叶或半常绿缠绕灌木，高6～10米，全体无毛。掌状复叶；小叶3枚，卵形或卵状矩圆形，长3～7厘米，宽2～4厘米，先端圆形，中央凹陷，基部圆形或稍呈心脏形至阔楔形，全缘或微波状，二面均淡绿色。花雌雄同株，总状花序腋生，长约15厘米，总花梗细长；花紫色微红或淡紫色；雌花1～3朵生于花序下部，苞片线形，花被3，椭圆形，顶端圆，退化雄蕊6枚，雌蕊3～6枚，柱头头状；雄花具细小苞片，花被3，倒卵形，顶端稍凹，雄蕊6枚，花丝三角形，退化雌蕊3或4枚.蓇葖状浆果，椭圆形或长圆筒形，长8～13厘米，宽约4厘米，成熟时紫色。种子矩圆形，暗红色。花期3～4月。果期10～11月。"}]},{"ID":"20240614124139-q2s1kdu","Type":"NodeParagraph","Properties":{"id":"20240614124139-q2s1kdu","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"野生于山坡荒地半阴处。分布江苏、浙江、江西、广西、广东、湖南、湖北、山西、陕西、四川、贵州、云南等地。"}]},{"ID":"20240614124139-ayooat7","Type":"NodeParagraph","Properties":{"id":"20240614124139-ayooat7","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"本植物的根（木通根）、果实（八月札）、种子（预知子）亦供药用，各详专条。"}]},{"ID":"20240614124139-mzfsyuc","Type":"NodeParagraph","Properties":{"id":"20240614124139-mzfsyuc","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"②三叶木通，参见\"八月札\"条。"}]},{"ID":"20240614124139-amdmhuu","Type":"NodeParagraph","Properties":{"id":"20240614124139-amdmhuu","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"③木通，参见\"八月札\"条。"}]},{"ID":"20240614124139-i1uoian","Type":"NodeParagraph","Properties":{"id":"20240614124139-i1uoian","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614124139-7epryfg","Type":"NodeParagraph","Properties":{"id":"20240614124139-7epryfg","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 白木通的干燥木质茎呈圆柱形而弯曲，长30～60厘米，直径1.2～2厘米。表面灰褐色，外皮极粗糙而有许多不规则裂纹，节不明显，仅可见侧枝断痕。质坚硬，难折断，断面显纤维性，皮部较厚，黄褐色，木部黄白色，密布细孔洞的导管，夹有灰黄色放射状花纹。中央具小形的髓。气微弱，味苦而涩。以条匀，内色黄者为佳。"}]},{"ID":"20240614124139-webhp31","Type":"NodeParagraph","Properties":{"id":"20240614124139-webhp31","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"产四川、湖北、湖南、广西等地。"}]},{"ID":"20240614124139-l01jlbx","Type":"NodeParagraph","Properties":{"id":"20240614124139-l01jlbx","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"目前所用的木通药材，主要有关木通、川木通、淮通和白木通四类，其中使用最广的关木通为马兜铃科木通马兜铃的木质茎（详\"关木通\"条）；其次为川木通，为毛茛科小木通、绣球藤等的木质茎（详\"川木通\"条）；淮通为马兜铃科大叶马兜铃、淮通马兜铃的木质茎（详\"淮通\"及\"朱砂莲\"条）；白木通则仅在少数地区自产自销。而历代本草所记载的木通则为木通科木通，目前很少见用。"}]},{"ID":"20240614124139-76nro14","Type":"NodeParagraph","Properties":{"id":"20240614124139-76nro14","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614124139-j0pb7vc","Type":"NodeParagraph","Properties":{"id":"20240614124139-j0pb7vc","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 茎含豆甾醇等。根含皂甙，小解得齐墩果酸及葡萄糖、鼠李糖。"}]},{"ID":"20240614124139-5kuy9gx","Type":"NodeParagraph","Properties":{"id":"20240614124139-5kuy9gx","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614124139-v5nkuau","Type":"NodeParagraph","Properties":{"id":"20240614124139-v5nkuau","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 用水稍浸泡，闷润至透，切片，晾干。"}]},{"ID":"20240614124139-s0giw1n","Type":"NodeParagraph","Properties":{"id":"20240614124139-s0giw1n","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614124139-sda5hz4","Type":"NodeParagraph","Properties":{"id":"20240614124139-sda5hz4","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 入心、小肠、膀胱经。"}]},{"ID":"20240614124139-54hwegv","Type":"NodeParagraph","Properties":{"id":"20240614124139-54hwegv","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"手厥阴心包络，手足太阳小肠、膀胱。\""}]},{"ID":"20240614124139-3w601dw","Type":"NodeParagraph","Properties":{"id":"20240614124139-3w601dw","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"②《木草汇言》：\"入手少阴、足太阳经。\""}]},{"ID":"20240614124139-v6zw3rw","Type":"NodeParagraph","Properties":{"id":"20240614124139-v6zw3rw","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入睥、心、小肠、膀胱四经。\""}]},{"ID":"20240614124139-6agfvdq","Type":"NodeParagraph","Properties":{"id":"20240614124139-6agfvdq","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"④《本草经解》：\"入手太阴肺经。\""}]},{"ID":"20240614124139-1avz3zo","Type":"NodeParagraph","Properties":{"id":"20240614124139-1avz3zo","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑤《要药分剂》：\"入心、肾、膀胱、小肠四经。\""}]},{"ID":"20240614124139-xc80cgm","Type":"NodeParagraph","Properties":{"id":"20240614124139-xc80cgm","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614124139-gwk8gpq","Type":"NodeParagraph","Properties":{"id":"20240614124139-gwk8gpq","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 苦，凉。"}]},{"ID":"20240614124139-w87825e","Type":"NodeParagraph","Properties":{"id":"20240614124139-w87825e","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240614124139-mw1dknw","Type":"NodeParagraph","Properties":{"id":"20240614124139-mw1dknw","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"雷公：苦。\""}]},{"ID":"20240614124139-euhxy3r","Type":"NodeParagraph","Properties":{"id":"20240614124139-euhxy3r","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"甘，无毒。\""}]},{"ID":"20240614124139-ye7m3jv","Type":"NodeParagraph","Properties":{"id":"20240614124139-ye7m3jv","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"微寒。\""}]},{"ID":"20240614124139-dwahxby","Type":"NodeParagraph","Properties":{"id":"20240614124139-dwahxby","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑤《海药本草》：\"温平。\""}]},{"ID":"20240614124139-5cxvc3k","Type":"NodeParagraph","Properties":{"id":"20240614124139-5cxvc3k","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614124139-iw60k8v","Type":"NodeParagraph","Properties":{"id":"20240614124139-iw60k8v","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 内无湿热，津亏，气弱，精滑，溲频及孕妇忌服。"}]},{"ID":"20240614124139-a9b71nh","Type":"NodeParagraph","Properties":{"id":"20240614124139-a9b71nh","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"凡精滑不梦自遗及阳虚气弱，内无湿热者禁用。妊娠忌之。\""}]},{"ID":"20240614124139-rormx7b","Type":"NodeParagraph","Properties":{"id":"20240614124139-rormx7b","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"肾气虚，心气弱，汗不彻，口舌燥、皆禁用。\""}]},{"ID":"20240614124139-guesns3","Type":"NodeParagraph","Properties":{"id":"20240614124139-guesns3","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614124139-3rcczit","Type":"NodeParagraph","Properties":{"id":"20240614124139-3rcczit","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 泻火行水，通利血脉。治小便赤涩，淋浊，水肿，胸中烦热，喉痹咽痛，遍身拘痛，妇女经闭，乳汁不通。"}]},{"ID":"20240614124139-1vxhqvg","Type":"NodeParagraph","Properties":{"id":"20240614124139-1vxhqvg","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主去恶虫，除脾胃寒热，通利九窍血脉关节，令人不忘。\""}]},{"ID":"20240614124139-aczoer6","Type":"NodeParagraph","Properties":{"id":"20240614124139-aczoer6","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"止自汗。\""}]},{"ID":"20240614124139-q1bbidn","Type":"NodeParagraph","Properties":{"id":"20240614124139-q1bbidn","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"疗脾疸常欲眠，心烦哕，出音声，疗耳聋，散痈肿诸结不消，及金疮、恶疮、鼠瘘、踒折、鼻息肉，堕胎，去三虫。\""}]},{"ID":"20240614124139-ogf9bv9","Type":"NodeParagraph","Properties":{"id":"20240614124139-ogf9bv9","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"主治五淋，利小便，开关格。治人多睡，主水肿浮大，除烦热。\""}]},{"ID":"20240614124139-lqjddvf","Type":"NodeParagraph","Properties":{"id":"20240614124139-lqjddvf","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"煮饮之，通妇人血气，又除寒热不通之气，消鼠瘘、金疮、踒折，煮汁酿酒妙。\""}]},{"ID":"20240614124139-4ssfq4s","Type":"NodeParagraph","Properties":{"id":"20240614124139-4ssfq4s","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑥《本草拾遗》：\"利大小便，令人心宽下气。\""}]},{"ID":"20240614124139-ofsqceh","Type":"NodeParagraph","Properties":{"id":"20240614124139-ofsqceh","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑦《海药本草》：\"主诸瘘疮；喉咙痛及喉痹，并宜煎服之，磨亦得，急即含之。\""}]},{"ID":"20240614124139-ye9gepw","Type":"NodeParagraph","Properties":{"id":"20240614124139-ye9gepw","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑧《食性本草》：\"主理风热淋疾，小便效急疼，小腹虚满，宜煎汤并葱食之有效。\""}]},{"ID":"20240614124139-mf9j3xl","Type":"NodeParagraph","Properties":{"id":"20240614124139-mf9j3xl","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑨《日华子本草》：\"安心除烦，止渴退热。治健忘，明耳目，治鼻塞；通小肠，下水，破积聚血块，排脓，治疮疖，止痛，催生下胞，女人血闭，月候不匀，天行时疾，头痛目眩，羸劣乳结，及下乳。\""}]},{"ID":"20240614124139-h9jezxa","Type":"NodeParagraph","Properties":{"id":"20240614124139-h9jezxa","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑩《安徽药材》：\"治脚气浮肿。\""}]},{"ID":"20240614124139-hy7btf0","Type":"NodeParagraph","Properties":{"id":"20240614124139-hy7btf0","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614124139-k4rwcii","Type":"NodeParagraph","Properties":{"id":"20240614124139-k4rwcii","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱；或入丸、散。"}]},{"ID":"20240614124139-1kvyzvh","Type":"NodeParagraph","Properties":{"id":"20240614124139-1kvyzvh","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614124139-j2umawn","Type":"NodeParagraph","Properties":{"id":"20240614124139-j2umawn","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" ①治小儿心热（小肠有火，便亦淋痛，面赤狂躁，口糜舌疮，咬牙口渴）：生地黄、甘草（生）、木通各等分。上同为末，每服三钱，水一盏，入竹叶同煎至五分，食后温服。（《小儿药证直诀》导赤散）"}]},{"ID":"20240614124139-6wuuut3","Type":"NodeParagraph","Properties":{"id":"20240614124139-6wuuut3","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"②治尿血：木通、牛膝、生地黄、天门冬、麦门冬、五味子、黄柏、甘草。同煎服。（《本草经疏》）"}]},{"ID":"20240614124139-2puxco3","Type":"NodeParagraph","Properties":{"id":"20240614124139-2puxco3","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"③治水气，小便涩，身体虚肿：乌臼皮二两，木通一两（锉），槟榔一两。上件药，捣细罗为散，每服不计时候，以粥饮下二钱。（《圣惠方》）"}]},{"ID":"20240614124139-ddy6vh7","Type":"NodeParagraph","Properties":{"id":"20240614124139-ddy6vh7","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"④治涌水、肠鸣腹大：木通（锉）三两，桑根白皮（锉，炒）、石韦（去毛）、赤茯苓（去黑皮）、防己、泽泻各一两半，大腹（炮）四枚。上七味，粗捣筛，每服三钱匕，水一盏半，煎至一盏，去滓，食前温服，如入行五里再服。（《圣济总录》通草饮）"}]},{"ID":"20240614124139-1cr7w8t","Type":"NodeParagraph","Properties":{"id":"20240614124139-1cr7w8t","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑤治喉痹，心胸气闷，咽喉妨塞不通：本通二两（锉），赤茯苓二两，羚羊角屑一两半，川升麻一两半，马蔺根一两，川大黄一两半（锉碎，微炒），川芒硝二两，前胡二两（去芦头），桑根白皮二两（锉）。上件药，捣粗罗为散，每服三钱，以水一中盏，煎至六分，去滓，不计时候温服。（《圣惠方》木通散）"}]},{"ID":"20240614124139-k20d69f","Type":"NodeParagraph","Properties":{"id":"20240614124139-k20d69f","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑥治妇人经闭及月事不调：木通、牛膝、生地黄、延胡索。同煎服。（《本草经疏》）"}]},{"ID":"20240614124139-ooi3lxv","Type":"NodeParagraph","Properties":{"id":"20240614124139-ooi3lxv","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"⑦治产后乳汁不下：木通、钟乳各一两，漏芦（去芦头）二两，栝楼根，甘草各一两。上五味，捣锉如麻豆大，每服三钱匕，水一盏半，黍米一撮同煎，候米熟去滓，温服，不拘时。（《圣济总录》木通汤）"}]},{"ID":"20240614124139-6y2hjnl","Type":"NodeParagraph","Properties":{"id":"20240614124139-6y2hjnl","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614124139-p2201ei","Type":"NodeParagraph","Properties":{"id":"20240614124139-p2201ei","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614124139-dhh2jy9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614124139-dhh2jy9","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"《中华本草》：木通"}]},{"ID":"20240614124139-91o4qin","Type":"NodeParagraph","Properties":{"id":"20240614124139-91o4qin","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614124139-cdf2rcn","Type":"NodeParagraph","Properties":{"id":"20240614124139-cdf2rcn","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" Mù Tōnɡ"}]},{"ID":"20240614124139-aql9o6d","Type":"NodeParagraph","Properties":{"id":"20240614124139-aql9o6d","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614124139-fbbf8ob","Type":"NodeParagraph","Properties":{"id":"20240614124139-fbbf8ob","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 通草、附支、丁翁、丁父、葍藤、王翁、万年、万年藤、燕蕧、乌蕧、活血藤。"}]},{"ID":"20240614124139-8xwotwo","Type":"NodeParagraph","Properties":{"id":"20240614124139-8xwotwo","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614124139-5y47cya","Type":"NodeParagraph","Properties":{"id":"20240614124139-5y47cya","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" Akebia Stem"}]},{"ID":"20240614124139-4eeeu1w","Type":"NodeParagraph","Properties":{"id":"20240614124139-4eeeu1w","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614124139-x6jmxp2","Type":"NodeParagraph","Properties":{"id":"20240614124139-x6jmxp2","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》。"}]},{"ID":"20240614124139-fgjz0l9","Type":"NodeParagraph","Properties":{"id":"20240614124139-fgjz0l9","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：通草，今出近道，绕树藤生，汁白，茎有细孔，两头皆通，含一头吹之，则气出彼头者良。或云即葍藤茎。"}]},{"ID":"20240614124139-px9f1q1","Type":"NodeParagraph","Properties":{"id":"20240614124139-px9f1q1","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：通草，大者径三寸，每节有二、三枝，枝头有五叶，其子长三、四寸，核黑瓤白，食之甘美。南人谓燕覆，或名乌覆，今言葍藤，葍覆声相近尔。"}]},{"ID":"20240614124139-9tdr8lx","Type":"NodeParagraph","Properties":{"id":"20240614124139-9tdr8lx","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：通草，生石城山谷及山阳，今泽潞、汉中、江淮、湖南州郡亦有之。生作藤蔓，大如指，其茎干"}]},{"ID":"20240614124139-4fcc3zl","Type":"NodeParagraph","Properties":{"id":"20240614124139-4fcc3zl","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614124139-eo0fagk","Type":"NodeParagraph","Properties":{"id":"20240614124139-eo0fagk","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 药材基源：为木通科植物木通、三叶木通或白木通的滕茎。"}]},{"ID":"20240614124139-o6370qz","Type":"NodeParagraph","Properties":{"id":"20240614124139-o6370qz","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Akebia quinata (Thunb.)Decne.2.Akebia trifoliata (Thunb.)Koidz.［Clematistrifoliata Thunb.］3.Akebia trifoliata(Thunb.)Koidz.var.australis(Diels)Rehd.Trifoliata (Thunb.) Koidz.var. Australis (Diels) Rehd., Akebia trifoliata (Thunb.) Koidz., Akebia quinata (Thunb.) Decne."}]},{"ID":"20240614124139-nlub9b1","Type":"NodeParagraph","Properties":{"id":"20240614124139-nlub9b1","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"采收和储藏：藤茎在移植后5-6年开始结果，在秋季割取部分老藤，晒干或烘干。"}]},{"ID":"20240614124139-4z327t9","Type":"NodeParagraph","Properties":{"id":"20240614124139-4z327t9","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614124139-u1lkxn3","Type":"NodeParagraph","Properties":{"id":"20240614124139-u1lkxn3","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山坡、山沟、溪旁等处的乔木与灌木林中。"}]},{"ID":"20240614124139-sz6igf3","Type":"NodeParagraph","Properties":{"id":"20240614124139-sz6igf3","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于陕西、山东、江苏、安微、江西、河南、湖北、湖南、广东、四川、贵州等地。"}]},{"ID":"20240614124139-qys6oxr","Type":"NodeParagraph","Properties":{"id":"20240614124139-qys6oxr","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"2.分布于河北、陕西、山西、甘肃、山东、河南、和长江流域各地。"}]},{"ID":"20240614124139-a83unv1","Type":"NodeParagraph","Properties":{"id":"20240614124139-a83unv1","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"3.分布于西南及山西、陕西、江苏、浙江、江西、河南、湖北、湖南、广东等地。"}]},{"ID":"20240614124139-vilwfql","Type":"NodeParagraph","Properties":{"id":"20240614124139-vilwfql","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614124139-yyvf4ua","Type":"NodeParagraph","Properties":{"id":"20240614124139-yyvf4ua","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 1.木通 落叶木质缠绕灌本，长3-15cn，全株无毛。幼枝灰绿色，有纵纹。掌状复叶，小叶片5，倒卵形或椭圆形，长3-6cm，先端圆常微凹至具一细短尖，基部圆形或楔形，全缘。短总状花序腋生，花单性，雌雄同株；花序基部着生1-2朵雌花，上部着生密而较细的雄花；花补3片；雄花具雄蕊6个；雌花较大，有离生雌蕊2-13。果肉质，浆果状，长椭圆形，或略呈肾形，两端圆，长约8cm，直径2-3cm，熟后紫色，柔软，沿腹缝线开裂。种子多数，长卵而稍扁，黑色或黑褐色。花期4-5月，果熟期8月。"}]},{"ID":"20240614124139-nt0i5gv","Type":"NodeParagraph","Properties":{"id":"20240614124139-nt0i5gv","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"2.三叶木通 与前种相近。主要区别点：叶为三出复叶；小叶卵圆形、宽卵圆形或长卵形，长宽变化很大，先端钝圆、微凹或具短尖，基部圆形或楔形，有时微呈心形，边缘浅裂或呈波装，侧脉5-6对。"}]},{"ID":"20240614124139-2gtk7hj","Type":"NodeParagraph","Properties":{"id":"20240614124139-2gtk7hj","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"3.白木通 本变种形态与三叶木通相近，但小叶全缘，质地较厚。"}]},{"ID":"20240614124139-hmwdpfq","Type":"NodeParagraph","Properties":{"id":"20240614124139-hmwdpfq","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240614124139-5iag8cs","Type":"NodeParagraph","Properties":{"id":"20240614124139-5iag8cs","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 生物学特点 喜凉爽湿润的环境，常生于半阴处的林中。土壤以富含腐殖质或土层深厚的冲积土为好。可在林国栽培。"}]},{"ID":"20240614124139-rs61pie","Type":"NodeParagraph","Properties":{"id":"20240614124139-rs61pie","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"栽培技术 种子或压条繁殖。种子繁殖：新采收的种子立即与湿沙混合贮藏于室外，第2年2-3月播种。在整好的地上，按沟距30cm左右开沟，深约5-10cm，播幅约10cm，施人畜粪水，盖草木灰，盖土2cm。幼苗出齐后肥1次。同时用茎蔓时匀苗，每隔10cm留苗1株，追人畜粪水1次。同时用带枝的小枝的小竹子插入行中，以供茎蔓攀援。培育两年的苗即可移栽。移栽在2-3月茎蔓末发芽时进和行。在选好的土地上，按行1-1.5cm栽植，每穴栽苗1株，盖土压紧，浇水，并把茎藤附近的攀援物上。压条繁殖：在2-3月，把两年以上的老藤埋到土里，节外即可生根发芽，长成新株。第2年2-3月，挖出剪成单株移栽，移栽方法与种子繁殖相同。"}]},{"ID":"20240614124139-l7hnweh","Type":"NodeParagraph","Properties":{"id":"20240614124139-l7hnweh","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"田间管理 移栽后3-4年中，每年夏冬季松土，追肥1次。夏季可用人畜粪水，冬可施用农家肥，结合松土，同时把新藤理附到攀援物土。"}]},{"ID":"20240614124139-x8078ro","Type":"NodeParagraph","Properties":{"id":"20240614124139-x8078ro","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614124139-iof2g5v","Type":"NodeParagraph","Properties":{"id":"20240614124139-iof2g5v","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 性状鉴定 （1）木通藤茎圆柱形，稍扭曲，直径0.2-0.5cm。表面灰棕色，有光泽，有浅的纵纹，皮孔圆形或横向长圆形，突起，直径约1mm；有枝。质坚脆，较易折断，横断面较平整，皮部薄易剥离，木部灰白色，导管孔排列紧密而无规则，射线细，不明显，中央髓圆形，明显。气微，味淡而微辛。"}]},{"ID":"20240614124139-p46g7dt","Type":"NodeParagraph","Properties":{"id":"20240614124139-p46g7dt","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"（2）三叶木通藤茎圆柱形，扭曲，直径0.2-1.5cm。表面灰色、灰棕色或暗棕色，颜色不均匀，极粗糙，有许多不规则纵裂纹及横裂纹，有时附生灰绿色苔藓，皮孔圆形或横向长圆形，突起，棕色，不明显，直径1-2mm；有枝痕。皮部易与木部剥离，去皮处表面棕黄色，射线处有深棕色纵沟。质坚韧，难折断，断面木部黄白色，导管孔细密，排列不规则，射线浅棕色，髓圆形而大。气微，珠微苦涩。"}]},{"ID":"20240614124139-f5fkqlb","Type":"NodeParagraph","Properties":{"id":"20240614124139-f5fkqlb","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"（3）白木通藤茎直径5-8mm。表面黄棕色或暗棕色，有不规则纵沟纹；有枝痕。质坚韧，难折断，断面木部淡黄色，导管细密，排列不规则，射线约13条，浅黄色放射状，髓类圆形。气微，味徽苦。"}]},{"ID":"20240614124139-b4pafiv","Type":"NodeParagraph","Properties":{"id":"20240614124139-b4pafiv","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"显微鉴别藤茎横切面：（1）木通木栓细胞数列，常含有褐色内含物；栓内层细胞含草酸钙小棱晶，含晶细胞壁不规则加厚，弱木化。皮层细胞6-10列，有的亦含数个小梭晶。中柱鞘由含晶纤维束与含晶石细胞群交替排列成连续的浅波浪形环带。维管束16-26个。韧皮部细胞薄壁性。束内形成层明显。"}]},{"ID":"20240614124139-grs7akz","Type":"NodeParagraph","Properties":{"id":"20240614124139-grs7akz","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"木质部导管散孔型。射线明显，其外侧有l-3列含晶石细胞与中柱鞘含晶石细胞相连接；形成层内侧射线细胞壁加厚、木化，具明显单纹孔。髓周细胞圆形，壁厚、木化，有圆形单纹孔，常含1至数个棱晶，中央有少量薄壁细胞，壁不木化。（图5）（2）三叶木通与五叶木通极相似，主要区别为木柱细胞无褐色内含物；中柱鞘含晶纤维束与含晶石细胞群交替排列成连续的环带，但含晶石细胞群仅存在于与射线相对处；维管束（19-）27-31个。"}]},{"ID":"20240614124139-pl4d8ar","Type":"NodeParagraph","Properties":{"id":"20240614124139-pl4d8ar","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"（3）白木通与五叶木通相似，主要区别为中柱鞘与三叶木通相似，含晶石细胞群仅存在于射线外侧；射线中径向排列的含晶石细胞多不与中柱鞘含晶石细胞群相连；维管束约13个。"}]},{"ID":"20240614124139-8063663","Type":"NodeParagraph","Properties":{"id":"20240614124139-8063663","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614124139-6dqhw15","Type":"NodeParagraph","Properties":{"id":"20240614124139-6dqhw15","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 木通藤茎含白桦脂醇（betulin），齐墩果酸（oleanolic acid），常春藤皂甙元（hederagein），木通皂甙(akeboside)Sta、Stb、Stc、Std、Stg1、Stg2、Sth、Stj、Stk、。此外，尚含豆甾醇(stigmasterol)，β-谷甾醇（β-sitosterol），胡萝卜甙（daucosterol），肌醇（inositol），蔗糖及钾盐。花中含有矢车菊素-3-木糖基-葡萄糖甙(cyanidin-3-xyloglucoside)，矢车菊素-3-对香豆酰基-葡萄糖甙（cyanidin-p-coumaroyl-glucoside），矢车菊素-3-对-香豆酰基-木糖基-葡萄糖甙（cyanidin-3-p-coumaroylxylo-glucoside）等。木通的植物细胞经组织培养后分得木通种酸（quinatic acid），3β-羟基-30-降齐墩果-12，20（29）-二烯-28-酸［3β-hydroxy-30-norolean-12，20（29）-dien-28-oicacid］，3-表-30降齐墩果-12，20（29）-二烯-28-酸［3-epi-30-norolean-12,20(29)-dien-28-oic acid］，3β-羟基-29(或30)醛基-12-齐墩果烯-28-酸［3β-hydroxy-29(or 30)-al-olean-12-en-28-oicacid］，桦叶菊萜酸（mesembryanthemoidigenic acid），30-降常春藤皂甙元-3-葡萄糖基阿拉伯糖甙［30-norhed-eragenin-3-O-β-gluco(1→3)-a-L-arabinopyranoside］，30-降常春藤皂甙元-3-木糖基阿拉伯糖甙［30-norhederagenin-3-O-β-D-xylo(1→2)-a-L-arabinopyranoside］,30-降齐墩果酸-3-木糖基阿拉伯糖甙［30-noroleanolic acid 3-O-β-D-xyl(1→2)-a-L-arabinopyr-anoside］，3-表松叶菊萜酸（3-eip-mesembryanthemoidigenicacid），3-乙酰-3-表松叶菊萜酸（3-O-acetyl-mesembryanthe-moidigenic acid），3-乙酰基松叶菊萜酸（3-O-acetyl-mesembryan-themoidigenic acid），3-O-乙酰基3-表-30-三对节萜（3-O-acetyl-3-epi-serratagenic acid），3-乙酰基-30-三对节萜酸（3-O-acetyl ser-ratagenic acid）及齐墩果酮酸（oleanonic acid）。"}]},{"ID":"20240614124139-kjq6ogm","Type":"NodeParagraph","Properties":{"id":"20240614124139-kjq6ogm","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240614124139-fodbqag","Type":"NodeParagraph","Properties":{"id":"20240614124139-fodbqag","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 1.利尿作用：家兔在严密控制进水量的情况下，每日灌服酊剂（用时蒸去酒精加水稀释过滤）0.5g/kg，连服五天，有非常显着的利尿作用，灰分则无利尿作用，说明其利尿主要不是由于钾盐，而是其他的有效成分。家兔口服或静脉注射煎剂，亦出现利尿作用。"}]},{"ID":"20240614124139-hrf6ufk","Type":"NodeParagraph","Properties":{"id":"20240614124139-hrf6ufk","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用：据初步体外试验结果，木通水浸剂或煎剂对多种致病真菌有不同程度的抑制作用。同属植物AkebialongeracemosaMatsum（产我国台湾省及日本）中提得的皂甙，对大鼠、小鼠有利尿作用；对大鼠的实验性关节炎也有某些抑制作用，它能延长环己巴比妥钠引起的小鼠睡眠时间，有一定的镇痛作用。低浓度对家兔离体肠管和心房无明显作用，高浓度则使肠管收缩，心房抑制。对离体兔耳血管有收缩作用，口服毒性很小，注射给药则有一定毒性。"}]},{"ID":"20240614124139-qa9a22d","Type":"NodeParagraph","Properties":{"id":"20240614124139-qa9a22d","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240614124139-68iurhn","Type":"NodeParagraph","Properties":{"id":"20240614124139-68iurhn","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 用水稍浸泡，闷润至透，切片，晾干。"}]},{"ID":"20240614124139-00b2w96","Type":"NodeParagraph","Properties":{"id":"20240614124139-00b2w96","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614124139-2ow4euf","Type":"NodeParagraph","Properties":{"id":"20240614124139-2ow4euf","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 理化鉴别（1）取本品粗粉1g，加水10ml，煮沸2-3min，趁热滤过，取滤液置试管中，用力振摇，产生持久性泡沫，加热后泡沫不消失。（检查皂甙）（2）溶血试验取2％去纤维红细胞生理盐水混悬液1滴，放在载玻片上，加盖玻片后，在显微镜下观察红细胞的形状，然后在盖玻片一侧加1滴样品生理盐水浸液（l：3），在盖玻片的另一端用滤纸吸引液体，使检波逐渐渗入盖玻片下，与红细胞接触处迅速发生溶血。（检查皂式）（3）本品水提取液蒸干，加1-2ml醋酐溶解，再加浓硫-醋酐试剂。颜色由黄转为红色、紫色、蓝色。（检查皂式）"}]},{"ID":"20240614124139-rnqyqgd","Type":"NodeParagraph","Properties":{"id":"20240614124139-rnqyqgd","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614124139-kpm4pw7","Type":"NodeParagraph","Properties":{"id":"20240614124139-kpm4pw7","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 心；脾；肾；小肠；膀胱经"}]},{"ID":"20240614124139-lto8jy5","Type":"NodeParagraph","Properties":{"id":"20240614124139-lto8jy5","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614124139-s7bjm7l","Type":"NodeParagraph","Properties":{"id":"20240614124139-s7bjm7l","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 苦；性寒"}]},{"ID":"20240614124139-ukic3m1","Type":"NodeParagraph","Properties":{"id":"20240614124139-ukic3m1","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614124139-wyea5te","Type":"NodeParagraph","Properties":{"id":"20240614124139-wyea5te","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 内无湿热，津亏，气弱，精滑，溲频及孕妇忌服。"}]},{"ID":"20240614124139-q5lih34","Type":"NodeParagraph","Properties":{"id":"20240614124139-q5lih34","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：凡精滑不梦自遗及阳虚气弱，内无湿热者禁用。妊娠忌之。"}]},{"ID":"20240614124139-dui133m","Type":"NodeParagraph","Properties":{"id":"20240614124139-dui133m","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"2.《得配本草》：肾气虚，心气弱，汗不彻，口舌燥，皆禁用。"}]},{"ID":"20240614124139-y5a3hsx","Type":"NodeParagraph","Properties":{"id":"20240614124139-y5a3hsx","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614124139-1k2ne3n","Type":"NodeParagraph","Properties":{"id":"20240614124139-1k2ne3n","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 清热利尿；活血通脉。主小便赤赤；淋浊；水肿；胸中烦热；喉喉疼痛；口舌生疮；风湿痹痛；乳汁不通；经闭；痛经"}]},{"ID":"20240614124139-ciegtxu","Type":"NodeParagraph","Properties":{"id":"20240614124139-ciegtxu","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614124139-14ptuc7","Type":"NodeParagraph","Properties":{"id":"20240614124139-14ptuc7","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g；或入丸、散。"}]},{"ID":"20240614124139-5czr1i6","Type":"NodeParagraph","Properties":{"id":"20240614124139-5czr1i6","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614124139-6mgos9a","Type":"NodeParagraph","Properties":{"id":"20240614124139-6mgos9a","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 1.李杲：《本草》十剂，通可去滞，通草、防已之属是也。夫防己大苦寒，能泻血中湿热之滞，又通大便、通草甘淡，利小便，专泻气滞也。肺受热邪，津液气化之原绝，则寒水断流，膀胱受湿热，癃闭约缩，小便不通，宜此治之。其症胸中烦热，口燥舌干，咽干大渴引饮，小便淋沥或闭塞不通，胫酸脚热，并宜通草主之。凡气味与之同者，茯苓、泽泻、灯草、猪苓、琥珀、翟麦、车前子之类，皆可以渗湿利小便，泄其滞气也。木通下行，泄小肠火，利小便，与琥珀同功，无他药可比。"}]},{"ID":"20240614124139-eu6ny44","Type":"NodeParagraph","Properties":{"id":"20240614124139-eu6ny44","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：木通，上能通心清肺，治头痛，利九窍，下能泄湿热，利小便，通大肠，治遍身拘痛。《本经》及《别录》皆不言及利小便治淋之功，甄权、日华子辈始发扬之，盖其能泄心与小肠之火，则肺不受邪，能通水道，水源既清，则津液自化，而诸经之湿与热，皆由小便泄去，故古方导赤散用之。杨仁斋《直指方》言人遍身胸腹隐热，疼痛拘急，足冷，皆是伏热伤血，血属于心，宜木通以通心窍，则经络流行也。"}]},{"ID":"20240614124139-rocu060","Type":"NodeParagraph","Properties":{"id":"20240614124139-rocu060","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"3.《雷公炮制药性解》：木通利便，专泻小肠，宜疗五淋等症。其惊悸等症，虽属心经，而心与小肠相为表里，故并治之。脾疸喜睡，此脾之病，皆湿所酿也，利小肠而湿不去乎？瘟疫之来，感天地不正之气，今受盛之官行而邪不能容，亦宜疗矣。"}]},{"ID":"20240614124139-gc3trs4","Type":"NodeParagraph","Properties":{"id":"20240614124139-gc3trs4","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：木通，《本经》主除脾胃寒热者，以其通气利湿热也。其曰通利九窍血脉关节，以其味淡渗而气芬芳也。令人不忘者，心主记，心家之热去，则心清而不忘矣。疗脾疸常欲眠，心烦哕者，脾家湿热壅盛则成疸，心脾之热不清，则昏昏欲眠而心烦哕，音声出于肺，肺家之湿热去，则肺金之气清而音声出矣。治耳聋者，泄肾家之湿火也。"}]},{"ID":"20240614124139-55nw6nv","Type":"NodeParagraph","Properties":{"id":"20240614124139-55nw6nv","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"5.李中梓：木通，功用虽多，不出宣通气血四字。"}]},{"ID":"20240614124139-7e73ha0","Type":"NodeParagraph","Properties":{"id":"20240614124139-7e73ha0","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"6.《本草汇言》：木通，利九窍，除郁热，导小肠，治淋浊，定惊癎狂越，为心与小肠要剂。所以治惊之剂，多用木通，惊由心气郁故也，心郁既通，则小便自利，而惊癎狂越之病亦安矣。"}]},{"ID":"20240614124139-z51m86b","Type":"NodeParagraph","Properties":{"id":"20240614124139-z51m86b","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"7.《药品化义》：木通，导脾胃积热下行，主治火泻、热泻，盖为利小肠火郁，行膀胱水闭，使水火分，则脾气自实也。且心移热于小肠而脏病由腑结，腑通则脏安。凡为惊病，由心气郁及嗜卧心烦者，以此直彻下行。古人立方，心火为邪，用木通导赤，肺火为邪，用桑皮泻白，良有深意也。"}]},{"ID":"20240614124139-sq6heca","Type":"NodeParagraph","Properties":{"id":"20240614124139-sq6heca","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"8.《本草述》：木通主治，类知为利水，而《本经》所云通利九窍血脉关节，殊未深究也。盖胃中水谷之清气上注于肺，而手太阴清中之浊者仍归于胃。试取《本经》首言除脾胃寒热，次乃及于通利九窍血脉关节，则知木通于肺胃之交，真有为之承接脉络、使其气化通而血化利者。使胃上注而肺下降，如所谓和调五脏、洒陈六腑者，以能助其功，使清气之营，入肺而流贯于诸经，即上下九窍无不通焉，是则利水与通利九窍血脉关节，原非二义矣。"}]},{"ID":"20240614124139-hnri2z5","Type":"NodeParagraph","Properties":{"id":"20240614124139-hnri2z5","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"9.《本草新编》：木通、逐水气、利小便，亦佐使之药，不可不用，而又不可多用，多用则泄人元气。或疑木通利水去滞气，亦有益之品，而谓泄人元气何也？夫木通利水，功何异于猪苓，但嫌其苦寒损胃，非若淡泻之无害也，胃气既伤，元气必耗，故用之为佐使则有功无过，倘多用之为君，则过于祛逐，元气必随水而走，安得不耗哉？10.《本草备要》：朱二允曰，火在上则口燥、眼赤、鼻干，在中则心烦、呕哕、浮肿，在下则淋、秘、足肿、必借（木通）甘平之性，泻诸经之火，火退则小便自利，便利则诸经火邪皆从小水而下降矣。君火宜木通，相火宜泽泻，利水虽同，所用各别。"}]},{"ID":"20240614124139-29prp94","Type":"NodeParagraph","Properties":{"id":"20240614124139-29prp94","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"11.《本经》：主去恶虫，除脾胃寒热，通利九窍血脉关节，令人不忘。"}]},{"ID":"20240614124139-27htni4","Type":"NodeParagraph","Properties":{"id":"20240614124139-27htni4","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"12.《吴普本草》：止自汗。"}]},{"ID":"20240614124139-s7j32zt","Type":"NodeParagraph","Properties":{"id":"20240614124139-s7j32zt","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"13.《别录》：疗脾疸常欲眠，心烦哕，出音声，疗耳聋，散痈肿诸结不消，及金疮、恶疮、鼠痿、踒折、齆鼻息肉，堕胎，去三虫。"}]},{"ID":"20240614124139-npmrqrz","Type":"NodeParagraph","Properties":{"id":"20240614124139-npmrqrz","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"14.《药性论》：主治五淋，利小便，开关格，治人多睡，主水肿浮大，除烦热。"}]},{"ID":"20240614124139-ylh4yag","Type":"NodeParagraph","Properties":{"id":"20240614124139-ylh4yag","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"15.《食疗本草》：煮饮之，通妇人血气，又除寒热不通之气，消鼠痿、金疮、踒折，煮汁酿酒妙。"}]},{"ID":"20240614124139-rrup2uh","Type":"NodeParagraph","Properties":{"id":"20240614124139-rrup2uh","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"16.《本草拾遗》：利大小便，令人心宽下气。"}]},{"ID":"20240614124139-v12al8z","Type":"NodeParagraph","Properties":{"id":"20240614124139-v12al8z","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"17.《海药本草》：主诸痿疮；喉咙痛及喉痹，并宜煎服之，磨亦得，急即含之。"}]},{"ID":"20240614124139-fq90phf","Type":"NodeParagraph","Properties":{"id":"20240614124139-fq90phf","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"18.《食性本草》：主理风热淋疾，小便数急疼，小腹虚满，宜煎汤并葱食之有效。"}]},{"ID":"20240614124139-li58wwy","Type":"NodeParagraph","Properties":{"id":"20240614124139-li58wwy","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"19.《日华子本草》：安心除烦，止渴退热，治健忘，明耳周，治鼻塞，通小肠，下水，破积聚血块，排脓，治疮疖，止痛，催生下胞，女人血闭，月候不匀，天行时疾，头痛目眩，赢劣乳结，及下乳。"}]},{"ID":"20240614124139-oz9qlsg","Type":"NodeParagraph","Properties":{"id":"20240614124139-oz9qlsg","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"20.《安徽药材》：治脚气浮肿。"}]},{"ID":"20240614124139-mof7wqu","Type":"NodeParagraph","Properties":{"id":"20240614124139-mof7wqu","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614124139-fhuekmi","Type":"NodeParagraph","Properties":{"id":"20240614124139-fhuekmi","updated":"20240614124139"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614124140-6gvwy37","Type":"NodeThematicBreak","Properties":{"id":"20240614124140-6gvwy37"}},{"ID":"20240614124141-46lpbad","Type":"NodeParagraph","Properties":{"id":"20240614124141-46lpbad"}}]}