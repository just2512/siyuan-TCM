ticBreak","Properties":{"id":"20240611163241-r99d8ah","updated":"20240611163241"}},{"ID":"20240611163241-fws74m5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163241-fws74m5","updated":"20240611163241"},"Children":[{"Type":"NodeText","Data":"萆薢《神农本草经》"}]},{"ID":"20240611163241-hbi4yi9","Type":"NodeParagraph","Properties":{"id":"20240611163241-hbi4yi9","updated":"20240611163241"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240611163241-mrjx8e3","Type":"NodeParagraph","Properties":{"id":"20240611163241-mrjx8e3","updated":"20240611163241"},"Children":[{"Type":"NodeText","Data":"主腰背痛，强骨节，风寒湿，周痹，恶创不瘳，热气。生山谷。"}]},{"ID":"20240611163241-6xihe6i","Type":"NodeParagraph","Properties":{"id":"20240611163241-6xihe6i","updated":"20240611163241"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名赤节，生真定，八月采根曝干。"}]},{"ID":"20240611163241-2crp7rz","Type":"NodeParagraph","Properties":{"id":"20240611163241-2crp7rz","updated":"20240611163241"},"Children":[{"Type":"NodeText","Data":"案《博物志》云：苃葜与萆薢相乱。"}]},{"ID":"20240611163300-24srpaa","Type":"NodeThematicBreak","Properties":{"id":"20240611163300-24srpaa"}},{"ID":"20240611163301-jepzcau","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163301-jepzcau","updated":"20240611163306"},"Children":[{"Type":"NodeText","Data":"萆薢《药笼小品》"}]},{"ID":"20240611163301-iovwlq5","Type":"NodeParagraph","Properties":{"id":"20240611163301-iovwlq5","updated":"20240611163301"},"Children":[{"Type":"NodeText","Data":"甘苦，入胃肝。"}]},{"ID":"20240611163301-4c3luz8","Type":"NodeParagraph","Properties":{"id":"20240611163301-4c3luz8","updated":"20240611163301"},"Children":[{"Type":"NodeText","Data":"祛风湿，治风寒湿痹，茎痛遗浊。"}]},{"ID":"20240611163301-tm4173t","Type":"NodeParagraph","Properties":{"id":"20240611163301-tm4173t","updated":"20240611163301"},"Children":[{"Type":"NodeText","Data":"肾虚无湿者禁。"}]},{"ID":"20240611163301-cuaw2ug","Type":"NodeParagraph","Properties":{"id":"20240611163301-cuaw2ug","updated":"20240611163301"},"Children":[{"Type":"NodeText","Data":"有黄白二种，白者良。"}]},{"ID":"20240611163250-ee2cnmi","Type":"NodeThematicBreak","Properties":{"id":"20240611163250-ee2cnmi"}},{"ID":"20240611163251-jup5off","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163251-jup5off","updated":"20240611163255"},"Children":[{"Type":"NodeText","Data":"萆薢《玉楸药解》"}]},{"ID":"20240611163251-78efqbc","Type":"NodeParagraph","Properties":{"id":"20240611163251-78efqbc","updated":"20240611163251"},"Children":[{"Type":"NodeText","Data":"味苦，气平，入足太阳膀胱经。泻水去湿，壮骨舒筋。"}]},{"ID":"20240611163251-70j66ug","Type":"NodeParagraph","Properties":{"id":"20240611163251-70j66ug","updated":"20240611163251"},"Children":[{"Type":"NodeText","Data":"萆薢疏泻水道，驱经络关节之湿，治手足痿痹瘫痪、小便白浊频数诸证。并医恶疮痔瘘。"}]},{"ID":"20240611162933-6gxstmw","Type":"NodeThematicBreak","Properties":{"id":"20240611162933-6gxstmw"}},{"ID":"20240611163152-zgtr0jn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163152-zgtr0jn","updated":"20240611163202"},"Children":[{"Type":"NodeText","Data":"萆薢《本草述钩元》"}]},{"ID":"20240611163208-7npmrrq","Type":"NodeParagraph","Properties":{"id":"20240611163208-7npmrrq","updated":"20240611163210"},"Children":[{"Type":"NodeText","Data":"出川中。蔓生，叶似菝葜而大。茎有刺者，其根实，其色黄白，三指许大，长硬而多节。雷公所以云竹木也。今人皆以土茯苓为萆薢，讵知茎叶根苗皆不同，误矣。"}]},{"ID":"20240611163152-vuereat","Type":"NodeParagraph","Properties":{"id":"20240611163152-vuereat","updated":"20240611163152"},"Children":[{"Type":"NodeText","Data":"川萆薢形体，壮大突兀，坚而多节。（菝葜根亦至坚，但多尖刺。）切开白莹带粉。（其色红者，菝葜根也。）其味苦平。（不若菝葜根之苦涩）用者切宜辨之。"}]},{"ID":"20240611163152-8kf5p7u","Type":"NodeParagraph","Properties":{"id":"20240611163152-8kf5p7u","updated":"20240611163152"},"Children":[{"Type":"NodeText","Data":"味苦气平，阴中之阳。入足厥阴少阴。"}]},{"ID":"20240611163152-bbhiyec","Type":"NodeParagraph","Properties":{"id":"20240611163152-bbhiyec","updated":"20240611163212"},"Children":[{"Type":"NodeText","Data":"薏苡仁为之使。"}]},{"ID":"20240611163152-jhofozz","Type":"NodeParagraph","Properties":{"id":"20240611163152-jhofozz","updated":"20240611163214"},"Children":[{"Type":"NodeText","Data":"补肝虚，主腰脊痛强，寒湿周痹，冷风㿏痹。腰脚瘫缓不遂，老人五缓关节老血，骨节风。（即痛风。风属阳病。《经》云：阳病发于阴，正坐阳虚而阴不化也。）并治阴痿失溺，白浊茎中痛，及久冷肾间有膀胱宿水。补水脏，坚筋骨，益精明目。（诸本草）"}]},{"ID":"20240611163152-2js6nhg","Type":"NodeParagraph","Properties":{"id":"20240611163152-2js6nhg","updated":"20240611163216"},"Children":[{"Type":"NodeText","Data":"方书治中风虚劳恶寒喘，痛痹着痹挛痿，脚气鹤膝风。不能食，消瘅，小便数，赤白浊疝。"}]},{"ID":"20240611163152-u4rnmdv","Type":"NodeParagraph","Properties":{"id":"20240611163152-u4rnmdv","updated":"20240611163152"},"Children":[{"Type":"NodeText","Data":"得火土之气，而兼禀乎天之阳气。所治诸证，无非湿热流入下焦，客于肝肾所致。更疗下元虚冷，湿邪为病。（仲淳）"}]},{"ID":"20240611163152-g4i794e","Type":"NodeParagraph","Properties":{"id":"20240611163152-g4i794e","updated":"20240611163218"},"Children":[{"Type":"NodeText","Data":"《炮炙论·序》云：囊皱漩多，夜煎竹木。竹木萆薢也。漩多白浊，皆是湿气下流。《杨倓家藏方》：治真元不足，下焦虚寒，小便频数，白浊如膏。有萆薢分清饮，正此意也。（濒湖）得骨碎补、牛膝、木瓜、薏仁、黄柏、续断、杜仲、石斛、生地、狗脊。治腰脊痛强，骨节风。加白术、菖蒲、茯苓。治周痹。"}]},{"ID":"20240611163152-rvwthip","Type":"NodeParagraph","Properties":{"id":"20240611163152-rvwthip","updated":"20240611163221"},"Children":[{"Type":"NodeText","Data":"同莲子、茯苓、车前、木通、泽泻、牛膝、黄柏、甘草。可分清除湿。"}]},{"ID":"20240611163152-u0m2zk9","Type":"NodeParagraph","Properties":{"id":"20240611163152-u0m2zk9","updated":"20240617115517"},"Children":[{"Type":"NodeText","Data":"护命方。（杨子建）凡小便频数，不计度数，便时茎中痛不可忍者。（与淋证涩而痛者不同）此证必先大腑不通，水液只就小肠，大腑愈加干竭，甚则浑身热，心躁。其本因贪酒色，积有热毒腐物瘀血乘虚流入于小肠，故便时作痛。不饮酒者，必平生过食辛热荤腻之物，又因色伤而然。宜用萆薢一两，水浸少时，同盐半两炒。去盐为末，每服二、三钱，水一盏，煎八分。和渣服，使水道转入大肠。仍以葱汤频洗谷道，令气得通，则溺数及痛自减也。"}]},{"ID":"20240611163152-xeeuxaf","Type":"NodeParagraph","Properties":{"id":"20240611163152-xeeuxaf","updated":"20240611163226"},"Children":[{"Type":"NodeText","Data":"〔论〕萆薢据《本经》、《别录》、甄权所主治，类不越外之寒湿，与内之虚冷为因，而所患多居下焦。《第简方书》：有属阴气不足，而亦用萆薢以合所宜之药者。（如痿症之金刚丸、牛膝丸。挛症之续断丹，腰痛之虎骨散是也。）夫阴气与阳气有异，故投剂不能滚同，何以统用萆薢。且有阴血虚甚而阳僭于上，是与阳虚之证分道而驰矣。乃如中风之天麻丸、愈风丹，虽大补其阴血，与补阳悬殊，而卒亦需夫萆薢之用，其故安在？盖此味专主足三阴（肝脾肾），为足三阳（胆胃膀胱）之化原。似能化阴以导阳，而转其生化之枢者。如阳虚则阴必实，补阳者借其能化阴，而导阳以达固为的剂。至于阴气之不足，不能遽投补阳也，亦惟大益阴气耳。补阴气而不借其化阴者以导于阳，则阴气不畅。更如大补阴血之剂，不有此化阴导阳者，则骤补之阴血，毋乃与亢阳相扞格，故亦须之以转其机也。（如天麻丸、愈风丹，大补阴血。而一则少入附子，一则少佐肉桂。皆欲其通经活血，俾阴之不格于阳耳。即此以推，则有阳虚而微兼阴虚，如消痹之苁蓉丸。有阳虚而兼阴虚有滞，如挛症之防风散。有阴气虚而并元阳亦虚，如痿症之煨肾丸。更有阴气阴血俱不足而兼事补益，如脚气之十全丹。皆可以化阴导阳之义求之也。）至于消瘅之白茯苓丸，清胃热与益肾阴并投。又如赤白浊之小温金散，益心肾之阳而清虚中之热。皆须此味。岂非阴阳转化之微，不徒在寒，而并及于热乎？夫萆薢固足三阴药，海藏只云补肝虚，何也？盖肾为至阴，脾为太阴，而肝则阴中之少阳。《经》所谓一阴为独使者，固化阴导阳之枢机也。兹物或禀阴中之阳，能使风木之化得达，木火之用有地。故海藏遂谓其补肝虚乎。（本草所主诸症，皆属阳虚而阴不化。其受病在血分，其本固责于木火之不达也。）肝之下合于任，上会于督者，不谓兹物能助其气化也。世医知萆薢能分清浊，而不知其即此化阴导阳之功。以阴化则清升，而便数可止。阳导则浊降，而茎痛可除。护命方治溺数茎痛，所以一味独用耳。"}]},{"ID":"20240611163152-792g0bb","Type":"NodeParagraph","Properties":{"id":"20240611163152-792g0bb","updated":"20240611163152"},"Children":[{"Type":"NodeText","Data":"下部无湿，阴虚火炽者不宜服。（仲淳）"}]},{"ID":"20240611163152-2ibhvql","Type":"NodeParagraph","Properties":{"id":"20240611163152-2ibhvql","updated":"20240611163152"},"Children":[{"Type":"NodeText","Data":"〔修治〕其根细长浅白而虚软者佳。酒浸一宿，焙干用。"}]},{"ID":"20240611162933-yb8tmpc","Type":"NodeThematicBreak","Properties":{"id":"20240611162933-yb8tmpc"}},{"ID":"20240611163116-j0kanha","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163116-j0kanha","updated":"20240611163122"},"Children":[{"Type":"NodeText","Data":"萆薢《本草分经》"}]},{"ID":"20240611163116-81h1mpu","Type":"NodeParagraph","Properties":{"id":"20240611163116-81h1mpu","updated":"20240611163116"},"Children":[{"Type":"NodeText","Data":"甘苦平，入肝胃，祛风去湿，以固下焦，坚筋骨，凡阳明湿热流入下焦者，此能去浊厘清，有黄白二种，白者良，名粉萆 。"}]},{"ID":"20240611162933-un3axss","Type":"NodeThematicBreak","Properties":{"id":"20240611162933-un3axss"}},{"ID":"20240611162952-sx7gmew","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162952-sx7gmew","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：萆薢"}]},{"ID":"20240611162952-5ol4fg1","Type":"NodeParagraph","Properties":{"id":"20240611162952-5ol4fg1","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162952-86mbr3g","Type":"NodeParagraph","Properties":{"id":"20240611162952-86mbr3g","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" Bì Xiè"}]},{"ID":"20240611162952-xiuyhvq","Type":"NodeParagraph","Properties":{"id":"20240611162952-xiuyhvq","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162952-t8po7rj","Type":"NodeParagraph","Properties":{"id":"20240611162952-t8po7rj","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 百枝（《吴普本草》），竹木（《雷公炮炙论》），赤节（《别录》），白菝葜（《日华子本草》），粉萆薢（《本草从新》），金刚、硬饭团（《植物名实图考长编》），山田薯、土薯蓣（《泉州本草》），麻甲头（《广东中医》5（11）：500，1960）。"}]},{"ID":"20240611162952-tvqlhwe","Type":"NodeParagraph","Properties":{"id":"20240611162952-tvqlhwe","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611162952-f6fkqdy","Type":"NodeParagraph","Properties":{"id":"20240611162952-f6fkqdy","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611162952-wbinjzn","Type":"NodeParagraph","Properties":{"id":"20240611162952-wbinjzn","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162952-rtn2krq","Type":"NodeParagraph","Properties":{"id":"20240611162952-rtn2krq","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 为薯蓣科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉背薯蓣"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叉蕊薯蓣"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山萆薢"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"纤细薯蓣"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。春、秋均可采挖。挖出后洗净除去须根，切片晒干。"}]},{"ID":"20240611162952-5bhayhb","Type":"NodeParagraph","Properties":{"id":"20240611162952-5bhayhb","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611162952-f9z5g7h","Type":"NodeParagraph","Properties":{"id":"20240611162952-f9z5g7h","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" ①粉背薯蓣，又名：黄萆薢、黄山姜、土黄连、黄薯。"}]},{"ID":"20240611162952-shoj1n1","Type":"NodeParagraph","Properties":{"id":"20240611162952-shoj1n1","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"多年生缠绕藤本。根茎横生，近于地面，竹节状。叶互生，三角状心形，或卵状披针形，顶端渐尖，边缘波状，叶片干后近乎黑色，下面常盖有白色粉状物。花单性，雌雄异株，雄花序穗状，单生成2～3枝簇生于叶腋，花序基部的花通常2～3朵集在一起，至花序的顶端通常单生；雄花雄蕊3，开放后药隔变宽，退化雄蕊3，有时存在，常与发育3雄蕊互生；雌花序穗状，单生，很少双生，雌花花被6，子房下位，退化雄蕊呈花丝状，柱头3裂。蒴果成熟后反曲下垂，翅宽超过长度或近于等长，表面栗褐色，成熟后顶端开裂。种子四周围以薄膜状的翅，通常两两迭生，着生于每室的中央。花期5～8月。果期6～10月。"}]},{"ID":"20240611162952-d63mjfv","Type":"NodeParagraph","Properties":{"id":"20240611162952-d63mjfv","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"分布安徽、浙江、江西、福建等地。"}]},{"ID":"20240611162952-on4ogem","Type":"NodeParagraph","Properties":{"id":"20240611162952-on4ogem","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②叉蕊薯蓣，又名：蛇头草。"}]},{"ID":"20240611162952-4npg67m","Type":"NodeParagraph","Properties":{"id":"20240611162952-4npg67m","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"多年生缠绕藤本。根茎横生，竹节状。茎纤细，左旋。单叶互生，三角状心形或卵状披针形，先端渐尖，基部心形或近截形，边缘波状，叶面干后黑色，很少呈灰褐色，下面灰褐色；叶柄短于叶片。花单性，雌雄异株；雄花序穗状，单生或2～3枝簇生于叶腋；雄花花被碟形，先端6裂，裂片长卵圆形，黄色，雄蕊3，药卵形，开放后药隔变宽，常为花药的1～2倍，呈短叉状，退化雄蕊3；雌花序穗状，单生，很少双生；雌花花被6，卵圆形，退化雄蕊丝状，子房下位，长圆柱形，柱头3裂。蒴果，翅顶端稍宽大，表面栗褐色。种子扁卵圆形，栗壳色，具翅。花期5～8月。果期6～10月。"}]},{"ID":"20240611162952-kganny0","Type":"NodeParagraph","Properties":{"id":"20240611162952-kganny0","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"生于山坡疏林下或林缘。分布福建、台湾、四川、云南、贵州等地。"}]},{"ID":"20240611162952-fjrciyu","Type":"NodeParagraph","Properties":{"id":"20240611162952-fjrciyu","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③山萆薢"}]},{"ID":"20240611162952-6opr2ip","Type":"NodeParagraph","Properties":{"id":"20240611162952-6opr2ip","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"多年生草质缠绕藤本。根茎横生，类圆柱形，作不规则分歧。茎纤细，高很少超过2米，有纵沟。叶互生，心形至三角状心形，先端渐尖，基部心形，全缘，有时呈浅波状，基出脉7～9条；叶柄长于叶片。花单性，雌雄异株；雄花序为总状或圆锥花序，1至数个腋生；雄花有柄，有苞片及小苞片各1，花被片6，长圆形，其中3片较宽，雄蕊6；雌花序穗状或圆锥状，单生，很少复生。蒴果，翅顶端稍宽，表面栗褐色；种子着生于每室中央的基部。种子扁平，卵形，上端翅宽于种子1倍以上。花期6～8月。果期8～10月。"}]},{"ID":"20240611162952-swl3jkj","Type":"NodeParagraph","Properties":{"id":"20240611162952-swl3jkj","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"多生于疏林或竹林下，沿山沟潮湿处。分布长江以南各地。"}]},{"ID":"20240611162952-fmqjwtz","Type":"NodeParagraph","Properties":{"id":"20240611162952-fmqjwtz","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"④纤细薯蓣，又名：白萆薢、铁菱刚、白姜、白薯、白连。"}]},{"ID":"20240611162952-ttwg1tw","Type":"NodeParagraph","Properties":{"id":"20240611162952-ttwg1tw","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"多年生缠绕藤本。根茎横生，竹节状。茎左旋，长圆柱形。叶互生，基部叶有时3～4片轮生；叶片卵状心形，先端渐尖，基部心形，全缘或呈微波状，边缘有明显的啮齿，叶脉通常7条，很少为9条；叶柄与叶片近于等长。雄花序穗状，单生于叶腋；雄花单生，无柄，苞片卵形，小苞片披针形，花被碟形，裂片6，长圆形，雄蕊3，药隔宽约为花药的1/2，不发育雄蕊3，退化为棍棒状；雌花序穗状，单生；花被裂片6，披针形，退化雄蕊6，子房下位，柱头3分叉。蒴果具3翅，翅半月形，长约2.8厘米，宽约1.3厘米，顶端近于平截或微凹，表面栗褐色，成熟时顶端开裂；种子每室2枚，具膜状的翅。花期5～8月。果期6～10月。"}]},{"ID":"20240611162952-hkllc5l","Type":"NodeParagraph","Properties":{"id":"20240611162952-hkllc5l","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"多生于山坡疏林下、较阴湿山谷中。分布浙江、江西、安徽。"}]},{"ID":"20240611162952-a42l9rz","Type":"NodeParagraph","Properties":{"id":"20240611162952-a42l9rz","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162952-dx0r1nt","Type":"NodeParagraph","Properties":{"id":"20240611162952-dx0r1nt","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" ①粉萆薢"}]},{"ID":"20240611162952-82o94g8","Type":"NodeParagraph","Properties":{"id":"20240611162952-82o94g8","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"为植物粉背薯蓣或山萆薢等的干燥根茎。切片厚约1～3毫米，边缘不整齐或有棕黑色的外皮；切片表面黄白色，平坦细腻，有粉性及不规则的黄色筋脉花纹，对光照视，极为显着。质坚实有弹性，易折断。无臭，味甘淡。以身干、色黄白、片大而薄、有弹性、整齐不碎者佳。"}]},{"ID":"20240611162952-yabwbgm","Type":"NodeParagraph","Properties":{"id":"20240611162952-yabwbgm","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"主产于浙江。广东、广西亦产。"}]},{"ID":"20240611162952-3x48wvv","Type":"NodeParagraph","Properties":{"id":"20240611162952-3x48wvv","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②棉萆薢"}]},{"ID":"20240611162952-csn7a82","Type":"NodeParagraph","Properties":{"id":"20240611162952-csn7a82","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"为植物纤细薯蓣或叉蕊薯蓣等的干燥根茎。商品多为纵向或斜切圆片，大小不等，厚约2～3毫米。外皮灰黄色较厚，周边多卷曲。切片表面浅黄白色，粗糙有筋脉。质柔软，易折断。无臭，味微苦。以身干、色白、片子厚薄均匀者佳。"}]},{"ID":"20240611162952-oj4ouvb","Type":"NodeParagraph","Properties":{"id":"20240611162952-oj4ouvb","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"主产于浙江、湖北等地。"}]},{"ID":"20240611162952-bh3rm8k","Type":"NodeParagraph","Properties":{"id":"20240611162952-bh3rm8k","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611162952-ozv910o","Type":"NodeParagraph","Properties":{"id":"20240611162952-ozv910o","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 山萆薢根茎主含薯蓣皂甙，尚含纤细薯蓣甙、薯蓣皂素毒甙A（以上皂甙的甙元都是薯蓣皂甙元），山萆薢皂甙、约诺皂甙、托克皂甙元-1-葡萄糖甙等皂甙。薯蓣皂素毒甙是山萆薢中的杀虫成分。从根茎中分离得到的甙元有：薯蓣皂甙元，含量1.2％（江苏产）、2.1％（浙江产）、1.35％（江苏宜兴产）；托克皂甙元，含量0.06％（江苏产）、0.09％（浙江产）、0.32％（江苏宜兴产）；雅姆皂甙元，含量0.04％（扛苏产）、0.10％（浙江产）；约诺皂甙元；考盖皂甙元和衣盖皂甙元。另还分离出少量25-异-螺甾-3，5-二烯，可能是水解时薯蓣皂甙元的脱水产物。地上部分分离出约诺皂甙元、托克皂甙元、考盖皂甙元。地上部分除种子外，各部都含相当量的游离的约诺皂甙元和托克皂甙元。地下部分有痕迹的游离的薯蓣皂甙元，其他都成皂甙。种子中含托克皂甙元，其甙元几乎全成为皂甙存在。雌花中分离出薯蓣皂甙元、约诺皂甙元、托克皂甙元和衣盖皂甙元。雄花中分离得到薯蓣皂甙元、约诺皂甙元、托克皂甙元和考盖皂甙元。"}]},{"ID":"20240611162952-k89i20x","Type":"NodeParagraph","Properties":{"id":"20240611162952-k89i20x","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"纤细薯蓣根茎含纤细薯蓣甙和薯蓣皂甙。浙江产的根茎含薯蓣皂甙元1.03％。"}]},{"ID":"20240611162952-u99au9z","Type":"NodeParagraph","Properties":{"id":"20240611162952-u99au9z","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"叉蕊薯蓣根茎含薯蓣皂甙元和少量雅姆皂甙元。昆明西山产的根茎含薯蓣皂甙元2.2％、淀粉20.59％、粗蛋白质14.35％、鞣质1.3％，粗纤维素11.6％。"}]},{"ID":"20240611162952-2a00qp1","Type":"NodeParagraph","Properties":{"id":"20240611162952-2a00qp1","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"薯蓣皂甙元可作为合成皮质酮的原料。"}]},{"ID":"20240611162952-fjuqnwk","Type":"NodeParagraph","Properties":{"id":"20240611162952-fjuqnwk","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611162952-fctqgat","Type":"NodeParagraph","Properties":{"id":"20240611162952-fctqgat","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 山萆薢根茎中所含之薯蓣皂甙或薯蓣皂素毒甙有杀昆虫作用。薯蓣皂甙、克拉塞林甙还有抗真菌作用。"}]},{"ID":"20240611162952-dqieze5","Type":"NodeParagraph","Properties":{"id":"20240611162952-dqieze5","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"苏联产同属植物高加索薯蓣对兔的实验性动脉粥样硬化有治疗作用。其皂甙有拟胆碱样作用，能扩张末梢血管、降低血压、增强胃肠平滑肌的运动，并能升高血糖，对抗小鼠的化学性惊厥，以及提高大鼠胃肠等各种组织的通透性。"}]},{"ID":"20240611162952-03kvkle","Type":"NodeParagraph","Properties":{"id":"20240611162952-03kvkle","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162952-6ppropj","Type":"NodeParagraph","Properties":{"id":"20240611162952-6ppropj","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 入肝、胃、膀胱经。"}]},{"ID":"20240611162952-wpirb2d","Type":"NodeParagraph","Properties":{"id":"20240611162952-wpirb2d","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入肝、脾、膀胱经。\""}]},{"ID":"20240611162952-e5hd82d","Type":"NodeParagraph","Properties":{"id":"20240611162952-e5hd82d","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"入足阳明、厥阴经。\""}]},{"ID":"20240611162952-mqtf0we","Type":"NodeParagraph","Properties":{"id":"20240611162952-mqtf0we","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入脾、肾、膀胱三经。\""}]},{"ID":"20240611162952-pjf5jzb","Type":"NodeParagraph","Properties":{"id":"20240611162952-pjf5jzb","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162952-1s5dpj5","Type":"NodeParagraph","Properties":{"id":"20240611162952-1s5dpj5","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240611162952-7892ejp","Type":"NodeParagraph","Properties":{"id":"20240611162952-7892ejp","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，平。\""}]},{"ID":"20240611162952-sqgq5wl","Type":"NodeParagraph","Properties":{"id":"20240611162952-sqgq5wl","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240611162952-3vu28q7","Type":"NodeParagraph","Properties":{"id":"20240611162952-3vu28q7","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"性微温，味微酸。\""}]},{"ID":"20240611162952-776h251","Type":"NodeParagraph","Properties":{"id":"20240611162952-776h251","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611162952-rb9blg5","Type":"NodeParagraph","Properties":{"id":"20240611162952-rb9blg5","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 肾虚阴亏者忌服。"}]},{"ID":"20240611162952-s8895xd","Type":"NodeParagraph","Properties":{"id":"20240611162952-s8895xd","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"薏苡仁为之使。畏葵根、大黄、柴胡牡蛎、前胡。\""}]},{"ID":"20240611162952-64agl06","Type":"NodeParagraph","Properties":{"id":"20240611162952-64agl06","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"下部无湿，阴虚火炽，以致溺有余沥，茎中痛，及肾虚腰痛，并不宜服。\""}]},{"ID":"20240611162952-3j0dcjo","Type":"NodeParagraph","Properties":{"id":"20240611162952-3j0dcjo","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③《本草备要》：\"忌茗、醋。\""}]},{"ID":"20240611162952-thcg5v5","Type":"NodeParagraph","Properties":{"id":"20240611162952-thcg5v5","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"阴虚精滑及元气下陷不能摄精，小便频数，大便引急者，误用病必转剧。\""}]},{"ID":"20240611162952-vagtib0","Type":"NodeParagraph","Properties":{"id":"20240611162952-vagtib0","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162952-lz29q2u","Type":"NodeParagraph","Properties":{"id":"20240611162952-lz29q2u","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 祛风，利湿。治风湿顽痹，腰膝疼痛，小便不利，淋浊，遗精，湿热疮毒。"}]},{"ID":"20240611162952-fq918zp","Type":"NodeParagraph","Properties":{"id":"20240611162952-fq918zp","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主腰背痛，强骨节，风寒湿周痹，恶疮不瘳，热气。\""}]},{"ID":"20240611162952-o7ewmvn","Type":"NodeParagraph","Properties":{"id":"20240611162952-o7ewmvn","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"伤中恚怒。阴痿失溺，关节者血，老人五缓。\""}]},{"ID":"20240611162952-k9i1u37","Type":"NodeParagraph","Properties":{"id":"20240611162952-k9i1u37","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治冷风顽痹，腰脚不遂，手足惊掣，主男子臂腰痛久冷，是肾间有膀胱宿水。\""}]},{"ID":"20240611162952-srqd90y","Type":"NodeParagraph","Properties":{"id":"20240611162952-srqd90y","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治瘫缓软风，头旋痫疾，补水藏，坚筋骨，益精明目，中风失音。\""}]},{"ID":"20240611162952-ym2jxnl","Type":"NodeParagraph","Properties":{"id":"20240611162952-ym2jxnl","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑤王好古：\"补肝虚。\""}]},{"ID":"20240611162952-h99f8ay","Type":"NodeParagraph","Properties":{"id":"20240611162952-h99f8ay","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"治风寒，温经络，腰膝疼，遍身顽麻，利膀胱水道，赤白便浊。\""}]},{"ID":"20240611162952-hbdrj1l","Type":"NodeParagraph","Properties":{"id":"20240611162952-hbdrj1l","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"治白浊，茎中痛，痔瘙坏疮。\""}]},{"ID":"20240611162952-agifisp","Type":"NodeParagraph","Properties":{"id":"20240611162952-agifisp","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162952-n1ngcg9","Type":"NodeParagraph","Properties":{"id":"20240611162952-n1ngcg9","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；或入丸、散。"}]},{"ID":"20240611162952-hvyv7fz","Type":"NodeParagraph","Properties":{"id":"20240611162952-hvyv7fz","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611162952-39oxoda","Type":"NodeParagraph","Properties":{"id":"20240611162952-39oxoda","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" ①治真元不足，下焦虚寒，小便白浊，频数无度，漩面如油，光彩不定，漩脚澄下，旋如膏糊；或小便频数，虽不白浊，亦能治疗：益智仁、川萆薢、石菖蒲、乌药各等分。为细末。每服三钱，水一盏半，入盐一捻，同煎至七分，温服，食前。（《杨氏家藏方》萆薢分清散）"}]},{"ID":"20240611162952-qcgc6r1","Type":"NodeParagraph","Properties":{"id":"20240611162952-qcgc6r1","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②治小便频数：川萆薢（洗）为细末，酒和为丸如柄子大。每服七十丸，空心、食前，盐汤、盐酒任下。（《济生方》萆薢丸）"}]},{"ID":"20240611162952-y87i73w","Type":"NodeParagraph","Properties":{"id":"20240611162952-y87i73w","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③治小肠虚冷，小便频数：牛膝（酒浸，切，焙），续断、芎藭各半两，萆薢二两。上四味，捣罗为末，炼蜜和丸如梧桐子大。空心盐汤下四十丸；或作汤，入盐煎服亦得。（《圣济总录》牛膝丸）"}]},{"ID":"20240611162952-8sn3nqp","Type":"NodeParagraph","Properties":{"id":"20240611162952-8sn3nqp","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"④治小便；昆浊：鲜萆薢根头刮去皮须，每次二两，水煎服。（《泉州本草》）"}]},{"ID":"20240611162952-z9sf7e0","Type":"NodeParagraph","Properties":{"id":"20240611162952-z9sf7e0","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑤治阴痿失溺：萆薢二钱，附子一钱五分。合煎汤内服。（《泉州本草》）"}]},{"ID":"20240611162952-bdlf1y2","Type":"NodeParagraph","Properties":{"id":"20240611162952-bdlf1y2","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑥治腰痛，脚气：破故纸（生）、续断，木瓜干、牛膝（酒浸）、杜仲（去皮锉，姜制炒断丝）各一两，萆薢二两。上为末，蜜丸如梧子大。每服五十丸，盐汤、盐酒任下。（《三因方》立安丸）"}]},{"ID":"20240611162952-egcevde","Type":"NodeParagraph","Properties":{"id":"20240611162952-egcevde","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑦治小肠气及腰痛：萆薢、杜仲（酥炒去丝）、葫芦巴（生脂麻炒）、破故纸（炒）、小茴香（盐水浸一宿）各一两，胡桃仁（汤去皮）二两。各为末，和丸如梧桐子大。每服三五十丸，空心盐酒送下，或盐汤亦可。（《瑞竹堂经验方》喝起丸）"}]},{"ID":"20240611162952-66mww5i","Type":"NodeParagraph","Properties":{"id":"20240611162952-66mww5i","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑧治脚气肿痛，不能动履，不论寒热虚实，久病暴发皆可：萆薢五钱，黄柏、苍术、牛膝、本瓜、猪苓、泽泻、槟梅各二钱。水二大碗，煎一碗。每日食前服一剂。（《本草切要》）"}]},{"ID":"20240611162952-r8h9l0x","Type":"NodeParagraph","Properties":{"id":"20240611162952-r8h9l0x","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑨治丈夫腰脚痹、缓急，行履不稳者：萆薢二十四分，杜仲八分。捣筛。每旦，温酒和服三钱匕，增至五钱匕。禁食牛肉。（《广利方》）"}]},{"ID":"20240611162952-rednqp7","Type":"NodeParagraph","Properties":{"id":"20240611162952-rednqp7","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑩沧风寒湿痹，腰骨强痛：干萆薢根，每次五钱，猪脊骨半斤合炖服。（《泉州本草》）"}]},{"ID":"20240611162952-nbit379","Type":"NodeParagraph","Properties":{"id":"20240611162952-nbit379","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑾治肠风，痔漏：萆薢、贯仲等分。捣罗为末。每服二钱，温酒调下，空心，食前服。（孙用和）"}]},{"ID":"20240611162952-s7l3wcr","Type":"NodeParagraph","Properties":{"id":"20240611162952-s7l3wcr","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611162952-nli2pu5","Type":"NodeParagraph","Properties":{"id":"20240611162952-nli2pu5","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"萆薢，足阳明、厥阴经药也。厥阴主筋属风，阳明主肉属湿，萆薢之功，长于去风湿，所以能治缓弱顽痹、遗浊、恶疮诸病之属风湿者。萆薢、菝葜、土茯苓，三物形虽不同，而主治之功不相远，岂亦一类数种乎?雷敦《炮炙论》序云：囊皱漩多，夜煎竹木。竹木，萆薢也。漩多白浊，皆是湿气下流，萆薢能治阳明之湿而固下焦，故能去浊分清。《杨仪家藏方》治真元不足，下焦虚寒，小便频数，白浊如膏，有萆薢分清饮，正此意也。又杨于建《万全护命方》云：凡人小便频数不计度数。便茎内痛不可忍者。此疾必先大腑秘热不通，水液只就小肠，大腑愈加乾竭，甚则浑身热，心躁思凉水，如此即重症也。此疾本因贪酒色，积有热毒，腐物瘀血之类，随虚水入于小肠，故便时作痛也。不饮酒者，必平生过食辛热荤腻之物，又因色伤而然，此乃小便频数而痛，与淋证涩而痛者不同也。宜用萆薢一两，水浸少时，以盐半两同炒，去盐为末，每服二钱，用水一盏，煎八分，和滓服之，使水道转入大肠，仍以葱汤频洗谷道，令气得通，则小便数及痛自减也。\""}]},{"ID":"20240611162952-wcrbrw3","Type":"NodeParagraph","Properties":{"id":"20240611162952-wcrbrw3","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"萆薢，胃与肝药也。搜风去湿，补肾强筋，主白浊茎中痛，阴痿失溺，恶疮。入肝搜风，故能理风与筋之病。入胃祛湿，故能理浊与疮之病。古人或称其摄溺之功，或称其逐水之效，何两说相悬耶?不知闭蛰封藏之本在肾，气强旺则收摄，而妄水亦无容藏之地，且善清胃家湿热，故能去浊分清也。杨氏萆薢分清饮，正合此意。\""}]},{"ID":"20240611162952-is3wzt4","Type":"NodeParagraph","Properties":{"id":"20240611162952-is3wzt4","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"萆薢，性味淡薄，长于渗湿，带苦亦能降下，主治风寒湿痹，男子白浊，茎中作痛，女人白带，病由胃中浊气下流所致，以此入胃驱湿，其症自愈。又治疮痒恶厉，湿郁肌腠，营卫不得宣行，致筋脉拘挛，手足不便，以此渗脾湿，能令血脉调和也。\""}]},{"ID":"20240611162952-2l6foi9","Type":"NodeParagraph","Properties":{"id":"20240611162952-2l6foi9","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"④《本草思辨录》：\"风寒湿之在腰背骨节而痛强者，阴不化也，以萆薢达之而阴化。风寒湿之为阴痿、为失溺、为老人五缓者，阳不伸也，以萆薢导之而阳伸。后世以萆藓为分清浊之剂，亦由阴化阳伸而后清升浊降。即止小便数、除茎中痛，均不出是义耳。化阴非能益阴，伸阳非能助阳。盖萆薢者，所以驱风寒湿也。\""}]},{"ID":"20240611162952-4y448ch","Type":"NodeParagraph","Properties":{"id":"20240611162952-4y448ch","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"萆薢，性能流通脉络而科筋骨，入药用根，则沉坠下降，故主治下焦。虽微苦能泄，而质轻气清，色味皆淡，则清热理湿，多入气分，少入血分。《本经》主腰背痛，乃肾有湿热，浊气不去，而腰膂为之疼痛，非肾虚无湿之腰痛，所可浑同施治。强骨节者，宣通百脉，湿浊去而正气自强，非能补益以助其强固，此药理之至易辨者。杨氏有萆薢分清饮，专治湿热淋浊，正是此意，惟方中有益智仁，温而且涩，性正相反，不能并列，殊有误会。濒湖《纲目》谓萆薢能治阳明之湿，而固下焦，故能去浊分清，立说甚允。然又谓杨氏此方，治真元不足，下焦虚寒，小便频数云云，则与萆薢性情，两相背谬。《本经》又主风寒湿周痹，颐谓惟湿热痹著，最为合宜，若曰风寒，必非此苦泄淡渗者，所能幸效。又治恶疮不瘳热气者，岂非为湿与热蒸之主药乎?《别录》谓主伤中，亦惟脾为湿困者宜之，决非补中之药。又治恚怒，颇不可解。又谓阴萎失溺，则湿热闭结者，亦有萎躄不仁、溲溺不利之症，必非可以起虚痿。又谓治老人五缓，关节老血，则语太浮泛，且与萆薢真性，不相符合，何可轻信。不谓缪仲淳因此二语，竟谓此物为补益下元之要药，又谓甘入脾而益血，以渗泄利湿之效用，而说到补阴上去，不如石顽《逢原》，谓古人或称摄精，或称利水，何其两说相悬，不知湿浊去而肾无邪热之扰，肾气自能收摄，颇能窥见玄奥也。甄权谓主冷气顽痹、腰脚瘫缓不遂、男子肾腰痛、久冷。按此即周痹阴萎之症，然惟湿热为患。乃宜此药，甄氏冷气久冷之说大误。甄又谓治肾间有湿，膀胱宿水，是也。而今本濒湖《纲目》引此二句，脱一湿宇，乃作肾间有膀胱宿水，遂令人无从索解，王好古谓补肝虚，亦不可训。尤奇者莫如《日华本草》，竟谓补水脏，坚筋骨，益精明目，头旋痫疾，中风失音云云。\""}]},{"ID":"20240611162952-ojk8wbl","Type":"NodeParagraph","Properties":{"id":"20240611162952-ojk8wbl","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611162952-f6b8x7j","Type":"NodeParagraph","Properties":{"id":"20240611162952-f6b8x7j","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"福州薯蓣"},{"Type":"NodeText","Data":"的根茎，亦作"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"棉萆薢"},{"Type":"NodeText","Data":"入药，产于福建。"}]},{"ID":"20240611162952-cnpk3eq","Type":"NodeParagraph","Properties":{"id":"20240611162952-cnpk3eq","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"另有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红萆薢"},{"Type":"NodeText","Data":"为百合科菝葜属植物无刺菝葜和土茯苓等的根茎，在云南、四川等地亦作萆薢使用。另详\"红萆薢\"条。"}]},{"ID":"20240611162952-v7oct41","Type":"NodeParagraph","Properties":{"id":"20240611162952-v7oct41","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162952-651z5n4","Type":"NodeParagraph","Properties":{"id":"20240611162952-651z5n4","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611162952-5x1g7sj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162952-5x1g7sj","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"《中华本草》：萆薢"}]},{"ID":"20240611162952-k2dwdcq","Type":"NodeParagraph","Properties":{"id":"20240611162952-k2dwdcq","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162952-i68q83f","Type":"NodeParagraph","Properties":{"id":"20240611162952-i68q83f","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" Bì Xiè"}]},{"ID":"20240611162952-3n7fsi2","Type":"NodeParagraph","Properties":{"id":"20240611162952-3n7fsi2","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162952-pc9eve7","Type":"NodeParagraph","Properties":{"id":"20240611162952-pc9eve7","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 百枝、竹木、赤节、白菝葜、川萆薢、粉萆薢、山田薯、土薯蓣、麻甲头"}]},{"ID":"20240611162952-rm3g2hc","Type":"NodeParagraph","Properties":{"id":"20240611162952-rm3g2hc","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611162952-rpycvoc","Type":"NodeParagraph","Properties":{"id":"20240611162952-rpycvoc","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" Sevenlobed Yam Rhizome， Foochow Yam Rhizome， Mountain Yam Rhizome， Hypoglaucous Collett Yam Rhizome"}]},{"ID":"20240611162952-4kzq2h9","Type":"NodeParagraph","Properties":{"id":"20240611162952-4kzq2h9","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611162952-2fptj74","Type":"NodeParagraph","Properties":{"id":"20240611162952-2fptj74","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611162952-7qn9wo7","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611162952-7qn9wo7","updated":"20240611162952"},"Children":[{"ID":"20240611162952-i3t624s","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611162952-i3t624s","updated":"20240611162952"},"Children":[{"ID":"20240611162952-ymwqwim","Type":"NodeParagraph","Properties":{"id":"20240611162952-ymwqwim","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"陶弘景：萆薢，今处处有。亦似菝葜而小异，很大，不甚有角，节色小浅。"}]}]}]},{"ID":"20240611162952-sbawpqy","Type":"NodeParagraph","Properties":{"id":"20240611162952-sbawpqy","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：此药（萆薢）有二种、茎有刺者根白实，无刺看根虚软，内软者为胜。 似薯颓，蔓生。"}]},{"ID":"20240611162952-b2jl9or","Type":"NodeParagraph","Properties":{"id":"20240611162952-b2jl9or","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：萆薢，今河。陕、京东、荆、蜀诸郡有之。根黄白色，多节，三指许大。苗叶俱青，作蔓生，叶作三叉，似山芋，又似绿豆叶。花有黄、红、白数种。亦有无花结白子者。春秋采根，暴干。今成德"}]},{"ID":"20240611162952-bpzvbcz","Type":"NodeParagraph","Properties":{"id":"20240611162952-bpzvbcz","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162952-62vsa3c","Type":"NodeParagraph","Properties":{"id":"20240611162952-62vsa3c","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 药材基源：为薯蓣科植物粉背薯蓣的根茎。"}]},{"ID":"20240611162952-ou0k21j","Type":"NodeParagraph","Properties":{"id":"20240611162952-ou0k21j","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dioscorea collettii Hook.f. var. hypoglauca(Palibin)Péi et Ting."}]},{"ID":"20240611162952-ee7j7bu","Type":"NodeParagraph","Properties":{"id":"20240611162952-ee7j7bu","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬二季挖取根茎，除去须根，去净泥土，切片晒干。"}]},{"ID":"20240611162952-z7x53cx","Type":"NodeParagraph","Properties":{"id":"20240611162952-z7x53cx","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611162952-156nvwu","Type":"NodeParagraph","Properties":{"id":"20240611162952-156nvwu","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔200-1300m的山腰陡坡、山谷缓坡或水沟边阴处的混交林边缘或疏林下。"}]},{"ID":"20240611162952-uy92d2v","Type":"NodeParagraph","Properties":{"id":"20240611162952-uy92d2v","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于河南、安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西等地。"}]},{"ID":"20240611162952-ayf2pef","Type":"NodeParagraph","Properties":{"id":"20240611162952-ayf2pef","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611162952-akbayea","Type":"NodeParagraph","Properties":{"id":"20240611162952-akbayea","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 粉背薯蓣 多年生缠绕草质藤本。根茎横生，姜块状，断面姜黄色，表面生有许多须根。茎左旋，无毛，有时密被黄色柔毛。单叶互生；叶片三角状心形或卵状披针形，先端渐尖，边缘波状或近全缘，下面灰白色，沿叶脉及叶缘被黄白色硬毛，有些植株叶片边缘呈半透明干膜质，干后黑色。雌雄异株。雄花序单生或2-3个簇生于叶腋；雄花无梗，在花序基部由2-3剁簇生，至顶部常单生；苞片卵状披针形，小苞片卵形；花被碟形，先端6裂，裂片黄色，干后黑色；雄蕊3枚，着生于花被管上，花丝较短，花开放后药隔变宽，约为花药的一半，呈短叉状，退化雄蕊有时花丝状，与3个发育雄蕊互生。雌花序穗状；花全部单生，子房下位，柱头3裂，退化雄蕊呈丝状体。蒴果有3翅，两端平截，先端与基部通常等宽，成熟后反曲下垂；种子2颗，着生于中轴中部，成熟时四周有薄膜状翅。花期5-8月，果期6-10月。"}]},{"ID":"20240611162952-j51x616","Type":"NodeParagraph","Properties":{"id":"20240611162952-j51x616","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162952-ld38er6","Type":"NodeParagraph","Properties":{"id":"20240611162952-ld38er6","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎呈竹节状，类圆柱形，有分枝，表面皱缩，常残留有茎枯萎疤痕及未除尽的细长须根。商品多为不规则的薄片，大小不一，厚约0.5mm，边缘不整齐，有的有棕黑色或灰棕色的外皮。切面黄白色或淡灰棕色，平坦，细腻，有粉性及不规则的黄色筋脉花纹（维管束），对光照视，极为显着。质松，易折断。气微，味基、微辛。以片大而薄、切面黄白色者为佳。 显微鉴别 根茎横切面：外层为多列木栓化细胞。皮层较薄，近木栓层的细胞壁木质化，有明显的壁孔，皮层中有粘液细胞，长68-82μm，直径约54μm，内含草酸钙针晶束。中柱散有外韧型维管束。本品薄壁细胞含淀粉粒。"}]},{"ID":"20240611162952-0mh3bti","Type":"NodeParagraph","Properties":{"id":"20240611162952-0mh3bti","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611162952-8azgya1","Type":"NodeParagraph","Properties":{"id":"20240611162952-8azgya1","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 粉背薯蓣的根茎得到9个甾类成分：薯蓣皂甙元（diosgenin），雅姆皂甙元（yamogenin），△3.5-脱氧替告皂甙元（△3.5-deoxytigogenin），△3.5-脱氧新替告皂甙元（△3.5deoxyneotigogenin），薯蓣皂甙元棕榈酸酯（diosgenin palmitate），β-谷甾醇（β-sitosterol）和另1对差向异构体：薯蓣皂甙元乙酸酯（diosgenin acetate）与雅姆皂甙元乙酸酯（yamogenin acetate）；还得到2个甾甙：粉背薯蓣皂甙A（hypoglaucine A），原粉背薯蓣皂甙A（protohypoglaucine A）。 根茎含粉背薯蓣皂甙（hypoglaucine） A，原粉背薯蓣皂甙（protohypoglaucine）A，纤细薯蓣皂甙（gracillin），原纤细薯蓣皂甙（progracillin）。"}]},{"ID":"20240611162952-2dgps7p","Type":"NodeParagraph","Properties":{"id":"20240611162952-2dgps7p","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611162952-h9z7vmj","Type":"NodeParagraph","Properties":{"id":"20240611162952-h9z7vmj","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 1.山萆薢根茎中所含之薯蓣皂甙或薯蓣皂素毒甙有杀昆虫作用。薯蓣皂甙、克拉塞林甙还有杭真菌作用(如须癣毛菌 Trichophyton mentagrophytes)。苏联产同属植物高加索薯蓣Dioscorea caucasica对兔的实验性动脉粥样硬化有治疗作用。其皂甙有拟胆碱样作用，能扩张末梢血管、降低血压、增强胃肠平滑肌的运动，并能升高血糖，对抗小鼠的化学性惊厥，以及提高大鼠胃肠等各种组织的通透性。"}]},{"ID":"20240611162952-2lloxue","Type":"NodeParagraph","Properties":{"id":"20240611162952-2lloxue","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"2.绵萆薢总皂甙可降低血清胆固醇。以高胆固醇（l%）饲料饲养60天龄雄鹌鹑，60天后对照组和绵萆薢总皂甙组血清胆固醇浓度分别为1265±360mg%、1185±167mg%，主动脉粥样硬化斑块发生率分别为58.3%和8.3%，说明绵萆总皂甙在不影响血清胆固醇浓度情况下具有显着降低动脉粥样硬化斑块发生率的作用。"}]},{"ID":"20240611162952-h3u1f8v","Type":"NodeParagraph","Properties":{"id":"20240611162952-h3u1f8v","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611162952-hcji5m1","Type":"NodeParagraph","Properties":{"id":"20240611162952-hcji5m1","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 1.本品温水提取液置于具塞试管中，振摇1分钟，产生大量泡沫，放置10分钟，泡沫没有明显的消失。（检查皂甙）2.本品温水提取液加入2%红血球混悬液数滴，放置后血液逐渐被溶解使提取液呈红色透明。"}]},{"ID":"20240611162952-xhc22t3","Type":"NodeParagraph","Properties":{"id":"20240611162952-xhc22t3","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"3.薄层层析：本品粉末加2mol/L盐酸水解，残渣用水洗至中性，烘干后加石油醚回流提取，回收石油醚，残渣用氯仿溶解，点于硅胶板上，氯仿-丙酮（93:7）展开，3%磷钼酸醇液喷雾显色，以薯蓣皂甙元为对照品，样品液色谱在与对照溶液色谱的相应位置上，有相同的蓝色斑点。"}]},{"ID":"20240611162952-i27feqa","Type":"NodeParagraph","Properties":{"id":"20240611162952-i27feqa","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162952-ao1zgx6","Type":"NodeParagraph","Properties":{"id":"20240611162952-ao1zgx6","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 肝；胃；膀胱经"}]},{"ID":"20240611162952-pfeu6wo","Type":"NodeParagraph","Properties":{"id":"20240611162952-pfeu6wo","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162952-zmi9xrf","Type":"NodeParagraph","Properties":{"id":"20240611162952-zmi9xrf","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 苦；平"}]},{"ID":"20240611162952-k7e5y5k","Type":"NodeParagraph","Properties":{"id":"20240611162952-k7e5y5k","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611162952-5sf4x1x","Type":"NodeParagraph","Properties":{"id":"20240611162952-5sf4x1x","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 肾虚阴亏者忌服。"}]},{"ID":"20240611162952-mnffea0","Type":"NodeParagraph","Properties":{"id":"20240611162952-mnffea0","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：下部无湿，阴虚火炽，以致溺有余沥，茎中痛，及肾虚腰痛，并不宜服。"}]},{"ID":"20240611162952-tei8qwv","Type":"NodeParagraph","Properties":{"id":"20240611162952-tei8qwv","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：阴虚精滑及元气下陷不能摄精，小便频数，大便引急者，误用病必转剧。"}]},{"ID":"20240611162952-r5cpg4m","Type":"NodeParagraph","Properties":{"id":"20240611162952-r5cpg4m","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162952-isecci5","Type":"NodeParagraph","Properties":{"id":"20240611162952-isecci5","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 祛风湿；利湿浊。主膏淋；白浊；带下；疮疡；湿疹；风湿痹痛"}]},{"ID":"20240611162952-8zwka90","Type":"NodeParagraph","Properties":{"id":"20240611162952-8zwka90","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162952-1gpn7sm","Type":"NodeParagraph","Properties":{"id":"20240611162952-1gpn7sm","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g；或入丸、散。"}]},{"ID":"20240611162952-ren6if8","Type":"NodeParagraph","Properties":{"id":"20240611162952-ren6if8","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611162952-e6ufmyy","Type":"NodeParagraph","Properties":{"id":"20240611162952-e6ufmyy","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" ①治真元不足，下焦虚寒月、便白浊，频数无度，被面如油，光彩不定，漩脚澄下，旋如膏糊；或小便频数，虽不白浊，亦能治疗： 益智仁、川萆薢、石菖蒲、乌药各等分。为细末。每服三钱，水一盏半，入盐一捻，同煎至七分，温服，食前。(《杨氏家藏方》萆薢分清散)②治小便频数： 川萆薢(洗)为细末，酒和为丸如桐子大。每服七十丸，空心、食前，盐汤、盐酒任下。(《济生方》萆薢丸)③治小肠虚冷，小便频数： 牛膝(酒浸，切，焙)、续断、芎藭各半两，萆薢二两。上四味，捣罗为末，炼蜜和丸如梧桐子大。空心盐汤下四十丸；或作汤，入盐煎服亦得。(《圣济总录》牛膝丸)④治小便混浊： 鲜萆薢根头刮去皮须，每次二两，水煎服。(《泉州本草》)⑤治阴痿失溺： 萆薢二钱，附子一钱五分。合煎汤内服。(《泉州本草》)⑥治腰痛，脚气：破故纸(生)、续断、木瓜干、牛膝(酒浸)、杜仲(去皮锉，姜制炒断丝)各一两，萆薢二两。上为末， 蜜丸如梧子大。每服五十丸，盐汤、盐酒任下。(《三因方》立安丸)⑦治小肠气及腰痛： 萆薢、杜仲(酥炒去丝)、葫芦巴(生脂麻炒)、破故纸(炒)、小茴香(盐水浸一宿)各一两，胡桃仁(汤去皮)二两。各为末，和丸如梧桐子大。每服三五十丸，空心盐酒送下，或盐汤亦可。(《瑞竹堂经验方》喝起丸)⑧治脚气肿痛，不能动履，不论寒热虚实，久病暴发皆可：萆薢五钱，黄柏、苍术、牛膝、木瓜、猪苓、泽泻、槟榔各二钱。水二大碗，煎一碗。每日食前服一剂。(《本草切要》)⑨治丈夫腰脚痹、缓急，行履不稳者： 萆薢二十四分，杜仲八分。捣筛。每旦，温酒和服三钱巴，增至五钱匕。禁食牛肉。 (《广利方》)⑩治风寒湿痹，腰骨强痛： 干萆薢根，每次五钱，猪脊骨半斤合炖服。(《泉州本草》)11.治肠风，痔漏： 萆薢、贯仲等分。捣罗为末。每服二钱，温酒调下，空心，食前服。(孙用和)"}]},{"ID":"20240611162952-ocdnzvn","Type":"NodeParagraph","Properties":{"id":"20240611162952-ocdnzvn","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611162952-fnioqpl","Type":"NodeParagraph","Properties":{"id":"20240611162952-fnioqpl","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：萆薢，足阳明、厥阴经药也。厥阴主筋属风，阳明主肉属湿，萆薢之功，长于去风湿，所以能治缓弱顽痹、遗浊、恶疮诸病之属风湿者。萆薢、菝葜、土茯苓，三物形虽不同，而主治之功不相远，岂亦一类数种乎雷敩《炮炙论》序云： 囊皱漩多，夜煎竹木。竹木，萆薢也。液多白浊，皆是湿气下流，草葱能治阳明之湿而固下焦，故能去浊分清。《杨倓家藏方》治真元不足，下焦虚寒，小便频数，白浊如膏，有萆薢分清钦，正此意也。又杨子建《万全护命方》云：凡人小便额数不计度数，便茎内痛不可忍者。此疾必先大腑秘热不通，水液只就小肠，大腑愈加乾竭，甚则浑身热，心躁思凉水，如此即重症也：此疾本因贪酒色）积有热毒，腐物瘀血之类，随虚水入于小肠，故便时作痛也。不饮酒者）必平生过食辛热荤腻之物，又因色伤而然，此乃小便频数而痛，与淋证涩而痛者不同也。宜用萆薢一两，水浸少时，以盐半两同炒，去盐为未，每服二钱，用水一盏，煎八分，和滓服之，使水道转入大肠，仍以葱汤频洗谷道，令气得通，则小便数及痛自减也。"}]},{"ID":"20240611162952-6ryw8nl","Type":"NodeParagraph","Properties":{"id":"20240611162952-6ryw8nl","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"2.《本草通玄》：草薛，胃与肝药也，搜风去湿，补肾强筋，主白浊茎中痛，阴痿失溺，恶疮。人肝搜风，故能理凤与筋之病。人胃法湿，故能理浊与疮之病。古人或称其摄溺之功，或称其逐水之效，何两说根悬那不知闭蛰封藏之本在肾，气强旺则收摄，而妄水亦无容藏之地，且善清胃家湿：热，故能去浊分清也〕杨氏萆薢分清饮，正合此意。"}]},{"ID":"20240611162952-wm8t0eg","Type":"NodeParagraph","Properties":{"id":"20240611162952-wm8t0eg","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"3.《药品化义》：萆薢，性味淡薄，长于渗湿，带苦亦能降丁，主治风寒湿痹，男子白浊，茎中作痛，女人白带，病由胃中浊气下流所致，以此人胃驱湿，其症自愈。又治疮痒恶厉，湿郁肌胰，营卫不得宣行，致筋脉拘挛，手足不便，以此渗脾湿，能令血脉调和也。"}]},{"ID":"20240611162952-9im21zn","Type":"NodeParagraph","Properties":{"id":"20240611162952-9im21zn","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"4.《本草思辨录》：风寒湿之在腰背骨节而痛强者，阴不化也，以萆薢达之而阴化。风寒湿之为阴凄。为失溺、为老、人五缓者，阳不仲也，以萆薢导之而阳伸。后世以草蔽为分清浊之剂，亦由阴化阳伸而后清升浊降。即止小便数。除茎中痛，均不出是义耳。化阴非能益阴，伸阳非能助阳。盖草豫者，所以驱风寒湿也。"}]},{"ID":"20240611162952-161annz","Type":"NodeParagraph","Properties":{"id":"20240611162952-161annz","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：萆薢，性能流通脉络而利筋骨，人药用根，则沉坠下降，故主治下焦。。虽微苦能泄，而质轻气清，色味皆淡，则清热理湿，多人气分，少人血分。《本经》主腰背痛，乃肾有湿热，浊气不去，而腰霄为之疼痛，非肾虚无湿之腰痛，所可浑同施治。强骨节者，宣通百脉；湿浊去而正气自强，非能补益以助其强固，此药理之至易辨者。杨氏有萆薢分清饮，专治湿热淋浊，正是此意，惟方中有益智仁，温而且涩，性正相反，不能并列，殊有误会。濒湖《纲目》谓萆薢能治阳明之湿：而固下焦，故能去浊分清，立说甚允。然又谓杨氏此方，治真元不足，下焦虚寒，小便频数云云，则与萆薢性情，两相背谬。《本经》又主风寒湿周痹，颐谓惟湿热痹着，最为合宜，若曰风寒，必非此苦泄淡渗者，所能幸效。又治恶疮不瘳热气者，岂非为湿与热蒸之主药乎《别录》谓主伤中，亦惟脾为湿困者宜之，决非补中之药。又洽恚怒，颇不可解。又谓阴萎失溺，则湿热闭结者）亦有萎臂不仁、溲溺不利之症，必非可以起虚痿。又谓治老人五缓，关节老血，则语太浮泛，且与萆薢真性，不相符合，何可轻信。不谓缪仲淳因此二语，竟谓此物为补益下元之要药，又谓甘入脾而益血，以渗泄利湿之效用，而说到补阴上去，不如石顽《逢原》，渭古人或称摄精；或称利水，何其两说相悬，不知湿浊去而肾无邪热之扰，肾气自能收摄，颇能窥见玄奥也。甄权谓主冷气顽痹、腰脚瘫缓不遂、男子肾腰痛、久冷。按此即周痹阴萎之症，然惟湿热为患。乃宜此药，甄氏冷气久冷之说大误。甄又谓治肾间有湿，膀肌宿水，是也。而今本濒湖《纲目》引此二句，脱一湿字，乃作肾间有膀胱宿水，遂令人无从索解。王好古谓补肝虚，亦不可训。尤奇者莫如《日华本草、竟谓补水脏，坚筋骨，益精明目，头旋目疾，中风失音云云。"}]},{"ID":"20240611162952-twahnd0","Type":"NodeParagraph","Properties":{"id":"20240611162952-twahnd0","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"6.《本经》：主腰背痛，强骨节，风寒湿周痹，恶疮不瘳，热气。"}]},{"ID":"20240611162952-smkuhu2","Type":"NodeParagraph","Properties":{"id":"20240611162952-smkuhu2","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"7.《别录》：伤中恚怒，阴痿失溺，关节老血，老人五缓。"}]},{"ID":"20240611162952-xuxs37f","Type":"NodeParagraph","Properties":{"id":"20240611162952-xuxs37f","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：治冷风顽痹，腰脚不逐，手足惊掣，主男子腰痛久冷，是肾间有膀胱宿水。"}]},{"ID":"20240611162952-e5l9nqr","Type":"NodeParagraph","Properties":{"id":"20240611162952-e5l9nqr","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"9.《日华子本草》：治瘫缓软风，头旋目疾，补水藏，坚筋骨，益精明目，中风失音。"}]},{"ID":"20240611162952-39prwmc","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611162952-39prwmc","updated":"20240611162952"},"Children":[{"ID":"20240611162952-szll4ke","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTAu","Num":10},"Properties":{"id":"20240611162952-szll4ke","updated":"20240611162952"},"Children":[{"ID":"20240611162952-qd7wsfc","Type":"NodeParagraph","Properties":{"id":"20240611162952-qd7wsfc","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"王好古：补肝虚。"}]}]}]},{"ID":"20240611162952-ah9s16n","Type":"NodeParagraph","Properties":{"id":"20240611162952-ah9s16n","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"11.《滇南本草》：治风寒，温经络，腰膝疼，遍身顽麻，利膀脱水道，赤白便浊。"}]},{"ID":"20240611162952-j82vhlf","Type":"NodeParagraph","Properties":{"id":"20240611162952-j82vhlf","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"12.《纲目》：治白浊，茎中痛，痔瘘环疮。"}]},{"ID":"20240611162952-ap9bm2b","Type":"NodeParagraph","Properties":{"id":"20240611162952-ap9bm2b","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162952-nmq5i2s","Type":"NodeParagraph","Properties":{"id":"20240611162952-nmq5i2s","updated":"20240611162952"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611162954-o5djg5v","Type":"NodeThematicBreak","Properties":{"id":"20240611162954-o5djg5v"}},{"ID":"20240611163321-7dnff6u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163321-7dnff6u","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：红萆薢"}]},{"ID":"20240611163321-eoiuiwl","Type":"NodeParagraph","Properties":{"id":"20240611163321-eoiuiwl","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611163321-uz18rco","Type":"NodeParagraph","Properties":{"id":"20240611163321-uz18rco","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" Hónɡ Bì Xiè"}]},{"ID":"20240611163321-98yoyyo","Type":"NodeParagraph","Properties":{"id":"20240611163321-98yoyyo","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611163321-e6hwunz","Type":"NodeParagraph","Properties":{"id":"20240611163321-e6hwunz","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 小萆薢、小红萆薢、打不死、花花藤、花萆薢、滇江萆薢"}]},{"ID":"20240611163321-xwz1bea","Type":"NodeParagraph","Properties":{"id":"20240611163321-xwz1bea","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611163321-j5vxer0","Type":"NodeParagraph","Properties":{"id":"20240611163321-j5vxer0","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 百合科菝葜属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无刺菝葜"},{"Type":"NodeText","Data":"Smilax mairei Levl.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根状茎"},{"Type":"NodeText","Data":"入药。全年可采，洗净切片，晒干。"}]},{"ID":"20240611163321-n94dbzw","Type":"NodeParagraph","Properties":{"id":"20240611163321-n94dbzw","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611163321-b4ppkhn","Type":"NodeParagraph","Properties":{"id":"20240611163321-b4ppkhn","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 甘、微苦，平。"}]},{"ID":"20240611163321-wmip620","Type":"NodeParagraph","Properties":{"id":"20240611163321-wmip620","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611163321-4qlwe47","Type":"NodeParagraph","Properties":{"id":"20240611163321-4qlwe47","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 祛风除湿，调经，利尿。用于风湿性关节炎，泌尿系感染，肾炎水肿，慢性胃炎，月经不调。"}]},{"ID":"20240611163321-pyzu853","Type":"NodeParagraph","Properties":{"id":"20240611163321-pyzu853","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611163321-40cyk4f","Type":"NodeParagraph","Properties":{"id":"20240611163321-40cyk4f","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 0.5～1两。"}]},{"ID":"20240611163321-agzvlf3","Type":"NodeParagraph","Properties":{"id":"20240611163321-agzvlf3","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611163321-fcto5mf","Type":"NodeParagraph","Properties":{"id":"20240611163321-fcto5mf","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611163321-ecr9fkw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163321-ecr9fkw","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：红萆薢"}]},{"ID":"20240611163321-tyyzfth","Type":"NodeParagraph","Properties":{"id":"20240611163321-tyyzfth","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611163321-r0toqf3","Type":"NodeParagraph","Properties":{"id":"20240611163321-r0toqf3","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" Hónɡ Bì Xiè"}]},{"ID":"20240611163321-wa3bslb","Type":"NodeParagraph","Properties":{"id":"20240611163321-wa3bslb","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611163321-n9j1xdg","Type":"NodeParagraph","Properties":{"id":"20240611163321-n9j1xdg","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 川萆薢（《中药材手册》）。"}]},{"ID":"20240611163321-6v32vve","Type":"NodeParagraph","Properties":{"id":"20240611163321-6v32vve","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611163321-s7d5ze6","Type":"NodeParagraph","Properties":{"id":"20240611163321-s7d5ze6","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《中药材手册》"}]},{"ID":"20240611163321-kmxv2x9","Type":"NodeParagraph","Properties":{"id":"20240611163321-kmxv2x9","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611163321-hee3f1u","Type":"NodeParagraph","Properties":{"id":"20240611163321-hee3f1u","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"土茯苓"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉菝葜"},{"Type":"NodeText","Data":"等多种同属植物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。全年可采，切片晒干。"}]},{"ID":"20240611163321-defs95g","Type":"NodeParagraph","Properties":{"id":"20240611163321-defs95g","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611163321-8pb3i28","Type":"NodeParagraph","Properties":{"id":"20240611163321-8pb3i28","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 主产四川。"}]},{"ID":"20240611163321-a5oqcyh","Type":"NodeParagraph","Properties":{"id":"20240611163321-a5oqcyh","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611163321-cqhcrql","Type":"NodeParagraph","Properties":{"id":"20240611163321-cqhcrql","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 完整的块茎较粗大，重者可达数斤。外表多丁刺和疙瘩，表面粗糙，呈枯棕色微带红。商品多为不规则的片状，边缘粗糙，带有坚硬的突起细根或根痕。切片表面棕褐色，内心黄色、红棕色或褐红色微带萦。质坚韧，含有黄色的粗纤维，不易折断，断后不具粉质。气味微弱。以色红黄者为佳。"}]},{"ID":"20240611163321-7ujmh8i","Type":"NodeParagraph","Properties":{"id":"20240611163321-7ujmh8i","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611163321-k1yd3lx","Type":"NodeParagraph","Properties":{"id":"20240611163321-k1yd3lx","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《四川中药志》：\"入肝、胃、肾三经。\""}]},{"ID":"20240611163321-79wq4f5","Type":"NodeParagraph","Properties":{"id":"20240611163321-79wq4f5","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611163321-hi79uiw","Type":"NodeParagraph","Properties":{"id":"20240611163321-hi79uiw","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" ①《四川中药志》：\"苦，平，无毒。\""}]},{"ID":"20240611163321-ndasrzb","Type":"NodeParagraph","Properties":{"id":"20240611163321-ndasrzb","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"②《云南中草药选》：\"甘淡，平。\""}]},{"ID":"20240611163321-nt55svk","Type":"NodeParagraph","Properties":{"id":"20240611163321-nt55svk","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611163321-1nfb0p8","Type":"NodeParagraph","Properties":{"id":"20240611163321-1nfb0p8","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《四川中药志》：\"阴虚火旺，肾虚遗精，多尿及腰痛者忌用。\""}]},{"ID":"20240611163321-hurkeqq","Type":"NodeParagraph","Properties":{"id":"20240611163321-hurkeqq","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611163321-fv7063c","Type":"NodeParagraph","Properties":{"id":"20240611163321-fv7063c","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" ①《四川中药志》：\"祛风湿，分清浊，利关节，解疮毒。治风湿痛，腰膝痹痛。小便淋浊及梅毒恶疮。\""}]},{"ID":"20240611163321-diixudz","Type":"NodeParagraph","Properties":{"id":"20240611163321-diixudz","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"②《云南中草药选》：\"祛风除湿，通淋，利水，消炎，解毒。治风湿性关节炎，泌尿系感染，慢性胃炎，月经不调，疮疖。\""}]},{"ID":"20240611163321-0o8eyj8","Type":"NodeParagraph","Properties":{"id":"20240611163321-0o8eyj8","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611163321-w9zj49x","Type":"NodeParagraph","Properties":{"id":"20240611163321-w9zj49x","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱。"}]},{"ID":"20240611163321-h5st6jk","Type":"NodeParagraph","Properties":{"id":"20240611163321-h5st6jk","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611163321-j9hh2i4","Type":"NodeParagraph","Properties":{"id":"20240611163321-j9hh2i4","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 云南所产的红萆薢为同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无刺菝葜"},{"Type":"NodeText","Data":"的块根。块根木质坚实，结节状，外表褐色，内面红色。"}]},{"ID":"20240611163321-5s6siv8","Type":"NodeParagraph","Properties":{"id":"20240611163321-5s6siv8","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611163321-0yotsbs","Type":"NodeParagraph","Properties":{"id":"20240611163321-0yotsbs","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611163321-8uloi5z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163321-8uloi5z","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"《中华本草》：红萆薢"}]},{"ID":"20240611163321-wl34qji","Type":"NodeParagraph","Properties":{"id":"20240611163321-wl34qji","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611163321-ab6ip8c","Type":"NodeParagraph","Properties":{"id":"20240611163321-ab6ip8c","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" Hónɡ Bì Xiè"}]},{"ID":"20240611163321-vsk8ylj","Type":"NodeParagraph","Properties":{"id":"20240611163321-vsk8ylj","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611163321-5mgyvw6","Type":"NodeParagraph","Properties":{"id":"20240611163321-5mgyvw6","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 滇红萆薢、土茯苓、小萆薢、打不死、土茯苓、花花藤、花萆薢"}]},{"ID":"20240611163321-1bh0ulv","Type":"NodeParagraph","Properties":{"id":"20240611163321-1bh0ulv","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611163321-gchl8s2","Type":"NodeParagraph","Properties":{"id":"20240611163321-gchl8s2","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" rhizome of Glabrous Greenbrier， rhizome of Dullcolor Greenbrier， rhizome of Maire Greenbrier， rhizome of Bluebead Greenbrier"}]},{"ID":"20240611163321-v6ibk6w","Type":"NodeParagraph","Properties":{"id":"20240611163321-v6ibk6w","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611163321-s47tvow","Type":"NodeParagraph","Properties":{"id":"20240611163321-s47tvow","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 出自《中药材手册》。"}]},{"ID":"20240611163321-m1spobl","Type":"NodeParagraph","Properties":{"id":"20240611163321-m1spobl","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611163321-wagkst8","Type":"NodeParagraph","Properties":{"id":"20240611163321-wagkst8","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物无刺菝葜的根茎。"}]},{"ID":"20240611163321-g7l4luj","Type":"NodeParagraph","Properties":{"id":"20240611163321-g7l4luj","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Smilax mairei Levl."}]},{"ID":"20240611163321-jnyqbku","Type":"NodeParagraph","Properties":{"id":"20240611163321-jnyqbku","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，洗净，切片晒干。"}]},{"ID":"20240611163321-towc11a","Type":"NodeParagraph","Properties":{"id":"20240611163321-towc11a","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611163321-6oczihx","Type":"NodeParagraph","Properties":{"id":"20240611163321-6oczihx","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1000-3000m的林下、灌丛中或山谷沟边。"}]},{"ID":"20240611163321-tv553aq","Type":"NodeParagraph","Properties":{"id":"20240611163321-tv553aq","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及西藏等地。"}]},{"ID":"20240611163321-lovycmm","Type":"NodeParagraph","Properties":{"id":"20240611163321-lovycmm","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611163321-wza5goe","Type":"NodeParagraph","Properties":{"id":"20240611163321-wza5goe","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 无刺菝葜 攀援灌木。茎与枝条平滑或稍粗糙，无刺。叶互生；叶柄长0.5-1.5cm，约占全和长的1/2-2/3，具狭鞘，脱落点位于近顶端，一般有卷须；叶片纸质或薄革质，卵形、长圆状卵形或三角状披针形，长3.5-9cm，宽1-5cm，先端急尖并具尖凸，基部钝或浅心形，下面苍白色，干后一般暗绿色。伞形花序腋生；总花梗多少扁平，一般短于叶柄；花序托膨大，连同多枚宿存小苞片多少呈莲座状；花单性，雌雄异株；花被片6，淡绿色或红色；雄花外花被片长2-2.5mm，宽约1mm，内花被片稍狭而短，雄蕊6；雌花与雄花大小相似，具6枚退化雄蕊，子房3室，柱头3裂。浆果球形，5-7mm，熟时蓝黑色。花期5-6月，果期12月。"}]},{"ID":"20240611163321-x0eii83","Type":"NodeParagraph","Properties":{"id":"20240611163321-x0eii83","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611163321-0yo5vb8","Type":"NodeParagraph","Properties":{"id":"20240611163321-0yo5vb8","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 苦；甘；平"}]},{"ID":"20240611163321-f1iddo6","Type":"NodeParagraph","Properties":{"id":"20240611163321-f1iddo6","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611163321-jb48p49","Type":"NodeParagraph","Properties":{"id":"20240611163321-jb48p49","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《四川中药志》：阴虚火旺，肾虚遗精，多尿及腰痛者忌用。"}]},{"ID":"20240611163321-mssr6fq","Type":"NodeParagraph","Properties":{"id":"20240611163321-mssr6fq","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611163321-vjkoqqw","Type":"NodeParagraph","Properties":{"id":"20240611163321-vjkoqqw","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 祛风除湿；利水通淋；解疮毒。主风湿痹痛；水肿；小便淋浊；疮疖肿毒"}]},{"ID":"20240611163321-p2havjn","Type":"NodeParagraph","Properties":{"id":"20240611163321-p2havjn","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611163321-f1trtpv","Type":"NodeParagraph","Properties":{"id":"20240611163321-f1trtpv","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g。"}]},{"ID":"20240611163321-gtr9q49","Type":"NodeParagraph","Properties":{"id":"20240611163321-gtr9q49","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611163321-twzhgnw","Type":"NodeParagraph","Properties":{"id":"20240611163321-twzhgnw","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 1.《四川中药志》：祛风湿，分清浊，利关节，解疮毒。治风湿痛，腰膝痹痛，小便淋浊及梅毒恶疮。"}]},{"ID":"20240611163321-b3zlsiz","Type":"NodeParagraph","Properties":{"id":"20240611163321-b3zlsiz","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"2.《云南中草药选》：祛风除湿，通淋，利水，消炎，解毒。治风湿性关节炎，泌尿系感染，慢性胃炎，月经不调，疮疖。"}]},{"ID":"20240611163321-3wiudyw","Type":"NodeParagraph","Properties":{"id":"20240611163321-3wiudyw","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611163321-t38oote","Type":"NodeParagraph","Properties":{"id":"20240611163321-t38oote","updated":"20240611163321"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611163322-mvv5z2e","Type":"NodeThematicBreak","Properties":{"id":"20240611163322-mvv5z2e"}},{"ID":"20240611163349-mn2jyjs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163349-mn2jyjs","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"《中国药典》：绵萆薢"}]},{"ID":"20240611163349-hutkqvd","Type":"NodeParagraph","Properties":{"id":"20240611163349-hutkqvd","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611163349-yngxty2","Type":"NodeParagraph","Properties":{"id":"20240611163349-yngxty2","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" Mián Bì Xiè"}]},{"ID":"20240611163349-ohpmeho","Type":"NodeParagraph","Properties":{"id":"20240611163349-ohpmeho","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611163349-odf5woy","Type":"NodeParagraph","Properties":{"id":"20240611163349-odf5woy","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" RHIZOMA DIOSCOREAE SEPTEMLOBAE"}]},{"ID":"20240611163349-kohvqsq","Type":"NodeParagraph","Properties":{"id":"20240611163349-kohvqsq","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611163349-zextpi5","Type":"NodeParagraph","Properties":{"id":"20240611163349-zextpi5","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 本品为薯蓣科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"绵萆薢"},{"Type":"NodeText","Data":"Dioscorea septemloba Thunb.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"福州薯蓣"},{"Type":"NodeText","Data":"Dioscorea futschauensis Uline ex R. kunth 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。秋、冬二季采挖，除去须根，洗净，切片，晒干。"}]},{"ID":"20240611163349-31gnk4u","Type":"NodeParagraph","Properties":{"id":"20240611163349-31gnk4u","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611163349-n2iw00h","Type":"NodeParagraph","Properties":{"id":"20240611163349-n2iw00h","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 本品为不规则的斜切片，边缘不整齐，大小不一，厚2～5mm。外皮黄棕色至黄褐色，有稀疏的须根残基，呈圆锥状凸起。切面灰白色至浅灰棕色，黄棕色点状维管束散在。质疏松，略呈海绵状。气微，味微苦。"}]},{"ID":"20240611163349-mhudv7c","Type":"NodeParagraph","Properties":{"id":"20240611163349-mhudv7c","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611163349-9dhpm2k","Type":"NodeParagraph","Properties":{"id":"20240611163349-9dhpm2k","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240611163349-ovfvgoe","Type":"NodeParagraph","Properties":{"id":"20240611163349-ovfvgoe","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611163349-egsexzd","Type":"NodeParagraph","Properties":{"id":"20240611163349-egsexzd","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 本品粉末淡黄棕色。淀粉粒众多，单粒卵圆形、椭圆形、类圆形、类三角形或不规则形，有的一端尖突，有的呈瘤状，直径10～70μm，脐点裂缝状，人字状、点状、层纹大多不明显。草酸钙针晶多成束，长90～210μm。薄壁细胞多角形，椭圆形或长方形，壁略增厚，纹孔明显。木栓细胞棕黄色，多角形，壁平直。"}]},{"ID":"20240611163349-1utmcb5","Type":"NodeParagraph","Properties":{"id":"20240611163349-1utmcb5","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611163349-1glrbg4","Type":"NodeParagraph","Properties":{"id":"20240611163349-1glrbg4","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 归肾、胃经。"}]},{"ID":"20240611163349-m839p5f","Type":"NodeParagraph","Properties":{"id":"20240611163349-m839p5f","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611163349-aw0adf9","Type":"NodeParagraph","Properties":{"id":"20240611163349-aw0adf9","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240611163349-thvr77f","Type":"NodeParagraph","Properties":{"id":"20240611163349-thvr77f","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611163349-ci5tzch","Type":"NodeParagraph","Properties":{"id":"20240611163349-ci5tzch","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 利湿去浊，祛风通痹。用于淋病白浊，白带过多，湿热疮毒，腰膝痹痛。"}]},{"ID":"20240611163349-r4px2fa","Type":"NodeParagraph","Properties":{"id":"20240611163349-r4px2fa","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611163349-i9wccu6","Type":"NodeParagraph","Properties":{"id":"20240611163349-i9wccu6","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611163349-uuzvd1p","Type":"NodeParagraph","Properties":{"id":"20240611163349-uuzvd1p","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611163349-e8vkivq","Type":"NodeParagraph","Properties":{"id":"20240611163349-e8vkivq","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611163349-msae07i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163349-msae07i","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：绵萆薢"}]},{"ID":"20240611163349-4g1okcg","Type":"NodeParagraph","Properties":{"id":"20240611163349-4g1okcg","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611163349-fqjr5mg","Type":"NodeParagraph","Properties":{"id":"20240611163349-fqjr5mg","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" Mián Bì Xiè"}]},{"ID":"20240611163349-h140q8d","Type":"NodeParagraph","Properties":{"id":"20240611163349-h140q8d","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611163349-00op8lh","Type":"NodeParagraph","Properties":{"id":"20240611163349-00op8lh","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 大萆薢、萆薢"}]},{"ID":"20240611163349-5t7e9t4","Type":"NodeParagraph","Properties":{"id":"20240611163349-5t7e9t4","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611163349-5qnijoj","Type":"NodeParagraph","Properties":{"id":"20240611163349-5qnijoj","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" Rhizoma Dioscoreae Septemlobae"}]},{"ID":"20240611163349-0ysatud","Type":"NodeParagraph","Properties":{"id":"20240611163349-0ysatud","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611163349-qb4vw7r","Type":"NodeParagraph","Properties":{"id":"20240611163349-qb4vw7r","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 为薯蓣科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"绵萆解"},{"Type":"NodeText","Data":"Dioscorea septemloba Thunb.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。秋、冬季采挖，除去须根，洗净，切片晒干。"}]},{"ID":"20240611163349-iyzy6xd","Type":"NodeParagraph","Properties":{"id":"20240611163349-iyzy6xd","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611163349-2ggx8l9","Type":"NodeParagraph","Properties":{"id":"20240611163349-2ggx8l9","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 生于山地疏林或灌丛中。主产浙江、福建、江西。"}]},{"ID":"20240611163349-f4w6o12","Type":"NodeParagraph","Properties":{"id":"20240611163349-f4w6o12","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611163349-crsk9ty","Type":"NodeParagraph","Properties":{"id":"20240611163349-crsk9ty","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 多年生缠绕草质藤本。茎左旋，圆柱形。单叶互生，叶形变异较大，有时一株从基部至顶部全为三角状心形，全缘或微波状，上面被白色粗毛，有时基部为掌状心形，边缘5～9深裂，中裂或浅裂，至顶部为三角状心形，不裂，叶脉多数和为9，叶干后不变黑。雄花序为圆锥花序，雌花序为下垂圆锥花序。蒴果宽倒卵形，翅长1.3～1.5cm，宽2～2.5cm，干后棕褐色。花期6～8月，果期7～10月。"}]},{"ID":"20240611163349-nqxdqwl","Type":"NodeParagraph","Properties":{"id":"20240611163349-nqxdqwl","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611163349-e7xnyde","Type":"NodeParagraph","Properties":{"id":"20240611163349-e7xnyde","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 含薯蓣皂甙（dioscin）、纤细薯蓣皂甙（gracillin），另含有原薯蓣皂甙（protodioscin）、原纤细薯蓣皂甙（protogracillin, kikubasaponin）及甲基原纤细薯蓣皂甙。"}]},{"ID":"20240611163349-qa81y08","Type":"NodeParagraph","Properties":{"id":"20240611163349-qa81y08","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611163349-syu83ow","Type":"NodeParagraph","Properties":{"id":"20240611163349-syu83ow","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 性平、味苦。"}]},{"ID":"20240611163349-qr5f8eh","Type":"NodeParagraph","Properties":{"id":"20240611163349-qr5f8eh","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611163349-kv81a1t","Type":"NodeParagraph","Properties":{"id":"20240611163349-kv81a1t","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 利湿去浊，祛风通痹。"}]},{"ID":"20240611163349-bhm7gin","Type":"NodeParagraph","Properties":{"id":"20240611163349-bhm7gin","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611163349-usbzx3k","Type":"NodeParagraph","Properties":{"id":"20240611163349-usbzx3k","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"福州薯蓣"},{"Type":"NodeText","Data":"D.futschauensis Vline的根茎同作绵萆薢入药。"}]},{"ID":"20240611163349-p0bxqlv","Type":"NodeParagraph","Properties":{"id":"20240611163349-p0bxqlv","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611163349-18dvkke","Type":"NodeParagraph","Properties":{"id":"20240611163349-18dvkke","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611163349-fxjfzms","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611163349-fxjfzms","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"《中华本草》：绵萆薢"}]},{"ID":"20240611163349-eqvyzww","Type":"NodeParagraph","Properties":{"id":"20240611163349-eqvyzww","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611163349-vq2y1gy","Type":"NodeParagraph","Properties":{"id":"20240611163349-vq2y1gy","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" Mián Bì Xiè"}]},{"ID":"20240611163349-qv524vy","Type":"NodeParagraph","Properties":{"id":"20240611163349-qv524vy","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611163349-t73cd6t","Type":"NodeParagraph","Properties":{"id":"20240611163349-t73cd6t","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 畚箕斗、山畚箕、山薯、狗粪棵、大萆薢"}]},{"ID":"20240611163349-9yw4o3w","Type":"NodeParagraph","Properties":{"id":"20240611163349-9yw4o3w","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611163349-3ym1r45","Type":"NodeParagraph","Properties":{"id":"20240611163349-3ym1r45","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" Severlobed Yam"}]},{"ID":"20240611163349-6b2hggv","Type":"NodeParagraph","Properties":{"id":"20240611163349-6b2hggv","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611163349-2xz8wsg","Type":"NodeParagraph","Properties":{"id":"20240611163349-2xz8wsg","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 药材基源：为薯蓣科植物绵萆薢或福州薯蓣的根茎。"}]},{"ID":"20240611163349-c792ecr","Type":"NodeParagraph","Properties":{"id":"20240611163349-c792ecr","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Dioscorea septemloba J.Q.Xi,M.Mizuno et W.L.Zhao. 2.Dioscorea futschuensis Uline ex R.Knuth"}]},{"ID":"20240611163349-4tu1p5t","Type":"NodeParagraph","Properties":{"id":"20240611163349-4tu1p5t","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬一季采挖，除去须根，洗净，切片，晒干。置通风干燥处。"}]},{"ID":"20240611163349-7xcanpl","Type":"NodeParagraph","Properties":{"id":"20240611163349-7xcanpl","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611163349-7m2109m","Type":"NodeParagraph","Properties":{"id":"20240611163349-7m2109m","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.绵萆薢生于海拔450-700m的山坡路旁疏林下或灌丛中。"}]},{"ID":"20240611163349-6nje2ir","Type":"NodeParagraph","Properties":{"id":"20240611163349-6nje2ir","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"资源分布：1.绵萆薢 分布于浙江、江西、福建、湖北、湖南、广东、江西。"}]},{"ID":"20240611163349-4awgz57","Type":"NodeParagraph","Properties":{"id":"20240611163349-4awgz57","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611163349-wkko94x","Type":"NodeParagraph","Properties":{"id":"20240611163349-wkko94x","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 1.绵萆薢 多年生缠绕草质藤本。根茎横生，分枝，粗大，直径2-5cm，干后质地疏松，海棉状，外皮灰黄色，生多数细长须根。茎左旋，圆柱形。单叶互生；叶片稍革质，形态变化较大，基部叶掌状深心形，上部叶片卵形，边缘波状或全缘，下面网脉明显，两面疏被白硬毛。雄花序腋生，总状，雄花有梗，与花被共长4-5mm；花被新鲜时橙黄色，干后褐色；雄蕊6，有时仅3枚发育。蒴果成熟时反曲下垂，翅近半圆形，先端微凹，基部圆形，长1.5-1.8cm，宽约1.2cm。种子扁卵圆形，直径4-5mm，四周围有薄膜状翅。花期6-7月，果期7-10月。 2.福州薯蓣 多年生缠绕草质藤本。根茎横走，不规则长圆柱形，外皮黄褐色。茎左旋。单叶互生；叶片稍革质，形状变化较大，基部叶掌状深心形，不等，7浅裂，上部叶片卵状三角形。边缘波状或近全缘，下面网脉明显，两毛疏被白硬毛。雄花序腋生，总状，雄花有梗，与花冠共长4-5mm；花冠新鲜时橙黄色，干后褐色；雄蕊6，有时仅3枚发育。蒴果成熟时反曲下垂，翅近半圆形，先端凹，端基部圆形，长1.5-1.8cm，宽1-1.2cm。种子扁卵圆形，直径4-5mm，四周围有薄膜状翅。花期6-7月，果期7-10月。"}]},{"ID":"20240611163349-9oldmam","Type":"NodeParagraph","Properties":{"id":"20240611163349-9oldmam","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611163349-82xc8oh","Type":"NodeParagraph","Properties":{"id":"20240611163349-82xc8oh","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" （1）绵革薢 根茎多为纵切或 切的圆片，大小不等，厚2-5mm；外皮黄棕色，较厚，周边多卷曲，切面浅黄白色，粗糙。有黄棕色点状维管束散在。质疏松，略呈海棉状。气微，味微苦辛。 （2）福州薯蓣 根茎呈不规则长圆柱形，长6-16cm，直径1-4．5cm。表面凹凸不平，黄褐色，具不规则皱缩钩纹及分散瘤状突起的茎痕。质坚硬，难折断。商品多切成薄片，厚2-3mm，断面灰白色或黄白色，粉性，散有点状维管束。质较疏松，略呈海绵状。气微，味微苦辛。"}]},{"ID":"20240611163349-vz1r1yp","Type":"NodeParagraph","Properties":{"id":"20240611163349-vz1r1yp","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根茎横切面：（1）绵革薢 外层为数列木栓细胞。皮层中散有粘液细胞，长 100-140μm，直径约 100μm，内含草酸钙针晶束，维管束散在，外韧型，皮层和中柱的薄壁细胞间有明显的间隙，细胞中含淀粉粒，圆形或卵圆形，长17-25μm，脐点点状。 （2）福州薯蓣 与绵萆薢相似。唯木栓细胞层下方的皮层细胞木质化，具壁孔。淀粉粒较大，长径40-58μm，短径17-27μm，脐点横裂缝状。 粉末特征：淡黄棕色。淀粉粒多，单粒卵圆形、椭圆形。类圆形、类三角形或不规则形，有的一端尖，有的圣瘤状，直径 10-70μm，脐点裂缝状、人字状、点状，层纹大多不明显。草酸钙针晶多成束，长90-210μm。薄壁细胞多角形，椭圆形或长方形，壁略增厚，纹孔明显。木柱细胞棕黄色，多角形，壁平直。"}]},{"ID":"20240611163349-p2wh61q","Type":"NodeParagraph","Properties":{"id":"20240611163349-p2wh61q","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611163349-m5c77ov","Type":"NodeParagraph","Properties":{"id":"20240611163349-m5c77ov","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 福州薯蓣根茎含甾体皂甙，白花延龄草甙（trillin），薯蓣皂甙（dioscin），纤细薯蓣皂甙（gracillin）。从其酸水解物中分离得到：薯蓣皂甙元（diosgenin），β-谷甾醇（β-sitosterol），薯蓣皂甙元棕榈酸酯（diosgenin palmitate），△3.5-脱氧替告皂甙元（△3.5-deoxytigogenin）。"}]},{"ID":"20240611163349-1vhn7se","Type":"NodeParagraph","Properties":{"id":"20240611163349-1vhn7se","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611163349-i6b76m3","Type":"NodeParagraph","Properties":{"id":"20240611163349-i6b76m3","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 理化鉴别（1）取粉末2g，加水30ml，水溶加热10min，滤过。取滤液2ml置具塞试管中，振摇1min。产生大量的蜂窝状泡沫，放置10min，泡沫未有明显的消失。（检查皂式）（2）取上述滤液，加入2%红细胞混悬液5-10滴，放置数分钟，血细胞逐渐被溶解而使溶液呈淡红色透明状。（检查皂甙）。"}]},{"ID":"20240611163349-ixbx1nc","Type":"NodeParagraph","Properties":{"id":"20240611163349-ixbx1nc","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末2g，加80%乙醇加热浸提，滤过。滤液蒸去乙醇，放冷，残渣溶于少量醋酸中，加醋酐和浓硫酸，应显紫红色。（检查皂式） （4）薄层色谱 取本品粉末1g，2mol/L盐酸约10ml，加热水解4h，滤过。残渣用水洗至中性，60℃真空干燥2h，加石油醚（60-90℃）回流提取4h，提取液蒸干后加氯仿2ml溶解作供试液；另取薯蓣皂甙元和25一异螺甾-3.5-二烯对照品加氯仿制成每1ml含lmg作对照。各取10μl点于同一硅胶－10%CMC板上，用氯仿－丙酮（93：7）展开，喷雾3%磷钼酸醇试液，加热显色。供试品色谱在与对照品色谱相应的位置上显相同的蓝色斑点。"}]},{"ID":"20240611163349-1xjnfde","Type":"NodeParagraph","Properties":{"id":"20240611163349-1xjnfde","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611163349-bt8ad02","Type":"NodeParagraph","Properties":{"id":"20240611163349-bt8ad02","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 苦；辛；平"}]},{"ID":"20240611163349-nrls6z3","Type":"NodeParagraph","Properties":{"id":"20240611163349-nrls6z3","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611163349-84o7tii","Type":"NodeParagraph","Properties":{"id":"20240611163349-84o7tii","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 祛风湿；利湿浊；消肿毒。主风湿痹痛；腰膝酸痛；小便混浊；淋沥；白带"}]},{"ID":"20240611163349-3kgema0","Type":"NodeParagraph","Properties":{"id":"20240611163349-3kgema0","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611163349-y5s9j0i","Type":"NodeParagraph","Properties":{"id":"20240611163349-y5s9j0i","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-20g；或浸酒；或入丸=散。外用：适量，鲜品捣敷。"}]},{"ID":"20240611163349-10t4tsm","Type":"NodeParagraph","Properties":{"id":"20240611163349-10t4tsm","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611163349-n7mrej0","Type":"NodeParagraph","Properties":{"id":"20240611163349-n7mrej0","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 用于淋病白浊，白带过多，湿热疮毒，腰膝痹痛。"}]},{"ID":"20240611163349-snsw9sm","Type":"NodeParagraph","Properties":{"id":"20240611163349-snsw9sm","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611163349-kma9991","Type":"NodeParagraph","Properties":{"id":"20240611163349-kma9991","updated":"20240611163349"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611163350-zvwx7kb","Type":"NodeThematicBreak","Properties":{"id":"20240611163350-zvwx7kb"}},{"ID":"20240611163352-geotnrr","Type":"NodeParagraph","Properties":{"id":"20240611163352-geotnrr"}}]}