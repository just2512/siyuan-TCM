0821102553-vb4c76a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 667px;\" parent-style=\"width: 677px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821102626-ygfrpyv","Type":"NodeParagraph","Properties":{"id":"20240821102626-ygfrpyv","updated":"20240821102755"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 586px;","style":"width: 576px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"厚朴 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/厚朴 12-20240821102755-idqaeqi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 576px;\" parent-style=\"width: 586px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 643px;","style":"width: 633px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"厚朴 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/厚朴 4-20240821102211-395ij6z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821101943-jys4ole","Type":"NodeParagraph","Properties":{"id":"20240821101943-jys4ole","updated":"20240821102902"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 552px;","style":"width: 542px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"厚朴 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/厚朴 13-20240821102902-kosx4r2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 542px;\" parent-style=\"width: 552px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 551px;","style":"width: 541px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"厚朴树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/厚朴树-20240626093928-6sukubf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 541px;\" parent-style=\"width: 551px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612094333-bpjoxmu","Type":"NodeParagraph","Properties":{"id":"20240612094333-bpjoxmu","updated":"20240821104421"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"注：以上取图搜罗于网络，实际真正的厚朴难以考证；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240612094447-r2hmggp","Type":"NodeThematicBreak","Properties":{"id":"20240612094447-r2hmggp"}},{"ID":"20240612094944-w10brxv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094944-w10brxv","updated":"20240612094944"},"Children":[{"Type":"NodeText","Data":"厚朴《神农本草经》"}]},{"ID":"20240612094944-uexy3gx","Type":"NodeParagraph","Properties":{"id":"20240612094944-uexy3gx","updated":"20240612094944"},"Children":[{"Type":"NodeText","Data":"味苦温。"}]},{"ID":"20240612094944-nzixhyd","Type":"NodeParagraph","Properties":{"id":"20240612094944-nzixhyd","updated":"20240612094944"},"Children":[{"Type":"NodeText","Data":"主中风，伤寒，头痛，寒热，惊悸气，血痹，死肌，去三虫。"}]},{"ID":"20240612094944-s5eobw5","Type":"NodeParagraph","Properties":{"id":"20240612094944-s5eobw5","updated":"20240612094944"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：厚朴，神农岐伯雷公苦无毒，李氏小温。（《御览》引云，一名厚皮，生交址）"}]},{"ID":"20240612094944-rhdgsl3","Type":"NodeParagraph","Properties":{"id":"20240612094944-rhdgsl3","updated":"20240612094944"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名厚皮，一名赤朴，其树名榛，其子名逐，生交址冤句，九月十月采皮。阴干。"}]},{"ID":"20240612094944-uhv6uv7","Type":"NodeParagraph","Properties":{"id":"20240612094944-uhv6uv7","updated":"20240612094944"},"Children":[{"Type":"NodeText","Data":"案《说文》云：朴，木皮也，榛木也。《广雅》云：重皮，厚朴也。《范子计然》云：厚朴出宏农，按今俗以榛为亲，不知是厚朴，《说文》榛栗，字作亲。"}]},{"ID":"20240612094802-ytt8htk","Type":"NodeThematicBreak","Properties":{"id":"20240612094802-ytt8htk"}},{"ID":"20240612094924-ldjtgcq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094924-ldjtgcq","updated":"20240612094933"},"Children":[{"Type":"NodeText","Data":"厚朴《神农本草经读》"}]},{"ID":"20240612094924-vbf4pwp","Type":"NodeParagraph","Properties":{"id":"20240612094924-vbf4pwp","updated":"20240612094924"},"Children":[{"Type":"NodeText","Data":"气味苦、温，无毒。主中风，伤寒，头痛，寒热，惊悸，气血痹，死肌，去三虫。（生用则解肌而达表，炙香则运土而助脾。）"}]},{"ID":"20240612094924-4u7olhk","Type":"NodeParagraph","Properties":{"id":"20240612094924-4u7olhk","updated":"20240612094924"},"Children":[{"Type":"NodeText","Data":"陈修园曰：厚朴气温，禀木气而入肝；味苦无毒，得火味而入心。然气味厚而主降，降则温而专于散，苦而专于泄，故所主皆为实症。中风有便溺阻隔症；伤寒有下之微喘症，有发汗后腹胀满症，大便硬症；头痛有浊气上冲症，俱宜主以厚朴也。至于温能散寒，苦能泄热，能散能泄，则可以解气逆之惊悸。能散则气行，能泄则血行，故可以治气血痹及死肌也。三虫本湿气所化，厚朴能散而泄之，则三虫可去也。宽胀下气，经无明文，仲景因其气味苦温而取用之，得《本经》言外之旨也。"}]},{"ID":"20240612094802-geeugws","Type":"NodeThematicBreak","Properties":{"id":"20240612094802-geeugws"}},{"ID":"20240612094911-j889q35","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094911-j889q35","updated":"20240612094918"},"Children":[{"Type":"NodeText","Data":"厚朴《本草崇原》"}]},{"ID":"20240612094911-hxi7j9r","Type":"NodeParagraph","Properties":{"id":"20240612094911-hxi7j9r","updated":"20240612094911"},"Children":[{"Type":"NodeText","Data":"气味苦温，无毒。主治中风，伤寒，头痛寒热，惊悸，气血痹，死肌，去三虫。"}]},{"ID":"20240612094911-lyzkgfn","Type":"NodeParagraph","Properties":{"id":"20240612094911-lyzkgfn","updated":"20240612094911"},"Children":[{"Type":"NodeText","Data":"（厚朴取其木质朴而皮厚以命名，一名烈朴，又名赤朴，谓其性辛烈而色紫赤也。洛阳、陕西、江淮、河南、川蜀山谷中，往往有之，近以建平、宜都及梓州、龙州者为上。木高三四丈，径一二尺，肉皮极厚，以色紫油润者为佳，春生叶如槲叶，四季不凋，五六月开红花，结实如冬青子，生青熟赤，实中有核，其味甘美。厚朴之实，别名逐折。《别录》云：主疗鼠瘘，明目，益气。）"}]},{"ID":"20240612094911-jatm999","Type":"NodeParagraph","Properties":{"id":"20240612094911-jatm999","updated":"20240612094911"},"Children":[{"Type":"NodeText","Data":"厚朴气味苦温，色赤性烈，花实咸红，冬不落叶，肉厚色紫，盖禀少阳木火之精，而通会于肌腠者也。主治中风伤寒头痛寒热者，谓能解肌而发散也。助木火之精气，故能定肝心之惊悸也。气血痹者，津液随三焦出气以温肌肉，肝主冲任之血，充肤热肉，痹则气血不和于肌腠。厚朴气温色紫，能解气血之痹而活死肌也。去三虫者，三焦火气内虚，则生虫。厚朴得少阳之火化，而三虫自去矣。"}]},{"ID":"20240612094911-pocjupp","Type":"NodeParagraph","Properties":{"id":"20240612094911-pocjupp","updated":"20240612094911"},"Children":[{"Type":"NodeText","Data":"愚按：厚朴色赤性烈，生用则解肌而达表，禀木火之气也。炙香则运土而助脾，木生火而火生土也。《金匮》方中厚朴大黄汤，用厚朴一尺，取象乎脾也。"}]},{"ID":"20240612094803-941yfhh","Type":"NodeThematicBreak","Properties":{"id":"20240612094803-941yfhh"}},{"ID":"20240612094856-gnxdgwq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094856-gnxdgwq","updated":"20240612094904"},"Children":[{"Type":"NodeText","Data":"厚朴《汤液本草》"}]},{"ID":"20240612094856-tiya5ru","Type":"NodeParagraph","Properties":{"id":"20240612094856-tiya5ru","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"气温。味辛。阳中之阴。苦而辛。无毒。"}]},{"ID":"20240612094856-dt4084f","Type":"NodeParagraph","Properties":{"id":"20240612094856-dt4084f","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"《象》云：能治腹胀，若虚弱，虽腹胀皆斟酌用之。寒胀是大热药中兼用。结者散之神药，误用脱人元气，切禁之。紫色者佳，去皮，姜汁制，微炒。"}]},{"ID":"20240612094856-h81fsfx","Type":"NodeParagraph","Properties":{"id":"20240612094856-h81fsfx","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"《珍》云：去腹胀，厚肠胃。"}]},{"ID":"20240612094856-sr6c0ag","Type":"NodeParagraph","Properties":{"id":"20240612094856-sr6c0ag","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"《心》云：味厚阴也，专去腹胀满，去邪气。"}]},{"ID":"20240612094856-5dp84zw","Type":"NodeParagraph","Properties":{"id":"20240612094856-5dp84zw","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"本草云：主中风伤寒头痛，寒热，惊悸，气血痹，死肌，去三虫，温中益气，消痰下气，疗霍乱及腹痛胀满，胃中冷逆，胸中呕不止，泄痢，淋露，除惊，去留热，心烦满，厚肠胃。"}]},{"ID":"20240612094856-9oze1ii","Type":"NodeParagraph","Properties":{"id":"20240612094856-9oze1ii","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"《本经》云：治中风伤寒头痛，温中益气，消痰下气，厚肠胃，去腹胀满，果泄气乎？果益气乎？若与枳实、大黄同用，则能泄实满，《本经》谓消痰下气者是也；若与橘皮、苍术同用，则能除湿满，《本经》谓温中益气者是也。与解利药同用，则治伤寒头痛；与痢药同用，则厚肠胃。大抵苦温，用苦则泄，用温则补。"}]},{"ID":"20240612094856-uar5kan","Type":"NodeParagraph","Properties":{"id":"20240612094856-uar5kan","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"《衍义》云：平胃散中用之最调中，至今盛行，既能温脾胃，又能走冷气。"}]},{"ID":"20240612094856-6nhgo18","Type":"NodeParagraph","Properties":{"id":"20240612094856-6nhgo18","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"海藏云：加减随证，如五积散治疗同。"}]},{"ID":"20240612094856-7mhaolh","Type":"NodeParagraph","Properties":{"id":"20240612094856-7mhaolh","updated":"20240612094856"},"Children":[{"Type":"NodeText","Data":"本草又云：干姜为使，恶泽泻、寒水石、硝石。"}]},{"ID":"20240612094448-0r4m243","Type":"NodeThematicBreak","Properties":{"id":"20240612094448-0r4m243"}},{"ID":"20240612094753-l06c6p7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094753-l06c6p7","updated":"20240612094753"},"Children":[{"Type":"NodeText","Data":"厚朴《本草经解》"}]},{"ID":"20240612094753-0yvss36","Type":"NodeParagraph","Properties":{"id":"20240612094753-0yvss36","updated":"20240612094753"},"Children":[{"Type":"NodeText","Data":"气温味苦，无毒。主中风伤寒头痛，寒热惊悸，血痹死肌，去三虫。（姜汁炒。）"}]},{"ID":"20240612094753-lsaodcq","Type":"NodeParagraph","Properties":{"id":"20240612094753-lsaodcq","updated":"20240612094753"},"Children":[{"Type":"NodeText","Data":"厚朴气温，禀天春升之木气，入足厥阴肝经；味苦无毒，得地南方之火味，入手少阴心经。气味升多于降，阳也。《难经》云：伤寒有五，中风、伤寒、湿温、热病、温病是也。中风伤寒者，中风症也，风气通肝，肝脉与督脉会于巅，风为阳邪而伤上，所以头痛；其主之者，厚朴入肝温散也。寒热惊悸者，病寒热而惊悸也，心虚则悸，肝虚则惊；厚朴气温可以达肝，味苦可以清心也。肝藏血，心主血，血凝泣则成痹；苦可以泄，温可以行，故主血痹。死肌者，亦血泣而皮毛不仁麻木也；苦泄温行，故亦主之。三虫湿所化也，味苦燥湿，可以杀虫，所以去虫也。"}]},{"ID":"20240612094753-shvvhwo","Type":"NodeParagraph","Properties":{"id":"20240612094753-shvvhwo","updated":"20240612094753"},"Children":[{"Type":"NodeText","Data":"制方：厚朴同槟榔、木香、川莲、滑石、陈皮、甘草，治痢初起。同白术、人参、白茯、白芍，治腹胀。同生姜、陈皮、藿香、砂仁、半夏，治胃寒呕逆。"}]},{"ID":"20240612094531-hy1kewe","Type":"NodeThematicBreak","Properties":{"id":"20240612094531-hy1kewe"}},{"ID":"20240612094641-8ra8lsp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094641-8ra8lsp","updated":"20240612094648"},"Children":[{"Type":"NodeText","Data":"厚朴《本经逢原》"}]},{"ID":"20240612094641-w77no24","Type":"NodeParagraph","Properties":{"id":"20240612094641-w77no24","updated":"20240612094641"},"Children":[{"Type":"NodeText","Data":"苦、辛，温，小毒。紫厚者佳，姜汁炒用。忌黑豆。宜用滚水泡数次切之，不可久浸气滃，有伤脾气。"}]},{"ID":"20240612094641-ukx4ntk","Type":"NodeParagraph","Properties":{"id":"20240612094641-ukx4ntk","updated":"20240612094641"},"Children":[{"Type":"NodeText","Data":"《本经》主中风伤寒，头痛寒热，惊悸逆气，血痹死肌，去三虫。"}]},{"ID":"20240612094641-ugsgq5v","Type":"NodeParagraph","Properties":{"id":"20240612094641-ugsgq5v","updated":"20240612094641"},"Children":[{"Type":"NodeText","Data":"〔发明〕厚朴苦温，先升后降，为阴中之阳药，故能破血中气滞。《本经》中风伤寒、头痛寒热者，风寒外伤于阳分也；其治惊悸逆气、血痹死肌者，寒湿入伤于腠理也。湿热内著于肠胃而生三虫，此药辛能散结，苦能燥湿，温能祛虫，故悉主之，消风散用之，深得《本经》之义。今世但知厚朴为温中散滞之药，而治肠胃湿满寒胀，温中下气，消痰止吐。平胃散用以治腹胀者，味辛能散滞气也，若气实人误服参、芪，胀闷作喘，宜此泻之。与枳实、大黄同用能泻实满，所谓消痰下气也；与苍术、橘皮同用能泻湿满，所谓温中益气也。然行气峻猛，虚者勿服；气温即止，不可久服。"}]},{"ID":"20240612094531-zbyff4a","Type":"NodeThematicBreak","Properties":{"id":"20240612094531-zbyff4a"}},{"ID":"20240612094532-teh672h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094532-teh672h","updated":"20240612094539"},"Children":[{"Type":"NodeText","Data":"厚朴《本草求真》"}]},{"ID":"20240612094532-aipw1lb","Type":"NodeParagraph","Properties":{"id":"20240612094532-aipw1lb","updated":"20240612094532"},"Children":[{"Type":"NodeText","Data":"（乔木）"}]},{"ID":"20240612094532-ozv8zi9","Type":"NodeParagraph","Properties":{"id":"20240612094532-ozv8zi9","updated":"20240612094532"},"Children":[{"Type":"NodeText","Data":"厚朴（专入脾胃）辛苦。书言同枳实、大黄，即承气汤，则于实满能泻。同苍术、橘皮，即平胃散，则于湿满能除。同解利药，则于伤寒头痛可治。同泻痢药，则于肠胃能厚。大抵气辛则散，故于湿满则宜。味苦则降，故于实满则下。（经曰：太阴所至为中满。又曰：诸湿肿满，皆属于脾。诸胀腹大，皆属于热。又曰：清气在下，则生飧泄。浊气在上，则生䐜胀。治宜察其腹满而痛者属实，腹满不痛者属虚。腹满不减，按之愈痛者，属实。腹满时减，按之不痛者，属虚。腹满而见散漫不实，兼有倦怠嗳气饱闷等症，则为胃气有亏。腹满而见光亮不暗，按则汩汩有声，及无燥渴等症，则为水邪内结。腹满而见大便不坚，时结时溏，溏则稍减，结则渐加，小便清利，甚则浑白如泔，其脉缓大而滞气日益甚，则为气虚不摄。但腹满属热者少，而属寒者多。今人治胀，非属牵牛、商陆利水通道，即属厚朴、枳实破气通结，殊为可惜。）今人不解，误以书载厚朴温中益气，及厚肠胃数语，不论虚实辄投，讵知实则于气有益，虚则于气无损乎？实则肠胃可厚，虚则肠胃不薄乎？（震亨曰：习以成俗，皆谓之补。哀哉！）至云破血杀虫，亦是气行而血自通，味苦而虫则杀之意。凡书表药功能，总是由药气味勘出，非是别药著治以自逞其意见也。朴即榛树皮，以肉厚紫色者良。去粗皮，姜汁炒用（即干姜为使意），恶泽泻、硝石、寒水石，忌豆，犯之动气。"}]},{"ID":"20240612094448-f5be1vu","Type":"NodeThematicBreak","Properties":{"id":"20240612094448-f5be1vu"}},{"ID":"20240612094449-lc4mw51","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094449-lc4mw51","updated":"20240612094457"},"Children":[{"Type":"NodeText","Data":"厚朴《本草衍义》"}]},{"ID":"20240612094449-h14l3bp","Type":"NodeParagraph","Properties":{"id":"20240612094449-h14l3bp","updated":"20240612094449"},"Children":[{"Type":"NodeText","Data":"今西京伊阳县及商州亦有，但薄而色淡，不如梓州者厚而紫色有油。味苦，不以姜制，则棘人喉舌。平胃散中用，最调中。至今此药盛行，既能温脾胃气，又能走冷气，为世所须也。"}]},{"ID":"20240612094333-16bm2io","Type":"NodeThematicBreak","Properties":{"id":"20240612094333-16bm2io"}},{"ID":"20240612094334-tg34499","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094334-tg34499","updated":"20240612094353"},"Children":[{"Type":"NodeText","Data":"厚朴《本草述钩元》"}]},{"ID":"20240612094334-heu79yy","Type":"NodeParagraph","Properties":{"id":"20240612094334-heu79yy","updated":"20240612094334"},"Children":[{"Type":"NodeText","Data":"以建平宜都及梓州、龙州者为上。木皮鳞皱，肉厚色紫多液者，入药最良。"}]},{"ID":"20240612094334-81ycjdw","Type":"NodeParagraph","Properties":{"id":"20240612094334-81ycjdw","updated":"20240612094334"},"Children":[{"Type":"NodeText","Data":"●皮"}]},{"ID":"20240612094334-21afnqx","Type":"NodeParagraph","Properties":{"id":"20240612094334-21afnqx","updated":"20240612094334"},"Children":[{"Type":"NodeText","Data":"味苦辛微甘，气大温，气味俱厚。其体重浊，阳中之阴，降也。入足太阴手足阳明经。"}]},{"ID":"20240612094334-qyk17mo","Type":"NodeParagraph","Properties":{"id":"20240612094334-qyk17mo","updated":"20240612094338"},"Children":[{"Type":"NodeText","Data":"主治温中散结气，除胀满，（因其辛以提滞气）疏胃湿滞。治胃中冷逆呕吐，及腹疼泄利，疗寒湿霍乱。化水谷，止吐酸水，除冷积，更同他药治湿热诸证及下痢。性宜有毒，以其得阳气之正，故无毒。（仲淳）　厚朴平胃除腹胀，若元气虚弱，虽胀，宜斟酌用之，误服脱人元气。惟寒胀大热药中兼用，乃结者散之之神药也。（洁古）　气实人误服参芪，胀闷作喘，宜此泻之。（丹溪）　与枳实、大黄同用，则泻实满，苦能下气也。与陈皮、苍术同用，则除湿满，温能益气也。与解利药同用则治伤寒头痛。与治痢药同用则厚肠胃。（海藏）　厚朴辛热苦温之药，辛能散结，苦能燥湿，温热能祛风寒。所主诸证，何莫非肠胃气逆壅滞，及痰饮留结，饮食生冷所致。至于益气厚肠胃，盖指邪气去正气自益，积滞消肠胃自厚之意，非消散之外，复有补益之功也。（仲淳）　同陈皮、枳壳、麦芽、山楂、草果、砂仁、矾红，治伤食腹胀。同苍术、黄连、橘皮、甘草、葛根、白术，治湿热作泻。同槟榔、木香、黄连、滑石、橘皮、白芍、甘草，治滞下初起。同白术、人参、白芍、茯苓，消腹胀。佐生姜、陈皮、藿香、砂仁、半夏，止胃寒呕吐。同三棱、蓬术、槟榔、人参、青皮，治积年冷癖坚块。有患肠风下血，大便时鲜血四射，淋漓不止，年久面色痿黄，腰痛腿酸，四肢无力，阳事痿弱，缘下血投苦寒剂经年，故致病剧也。先制煎方服之，后照方倍加为两，作丸服效。姜朴五钱，神曲一钱，土炒白术一钱，炒麦芽一钱，北五味一钱焙研，加陈黄米四十九粒，水二碗，煎八分。空心服。凡肠风下血者，多系脾胃虚寒，不能摄血，服之皆效。虽酒客湿热下注放血者，服之亦效。按厚朴佐参、术诸补剂，化补中之滞以消胀，其义固然，兹方乃用以为君，白术止助其健运，五味稍敛其耗散，又有消导之味，而取效于下血，可以思其用矣。"}]},{"ID":"20240612094334-vh890hu","Type":"NodeParagraph","Properties":{"id":"20240612094334-vh890hu","updated":"20240617115450"},"Children":[{"Type":"NodeText","Data":"〔论〕草木之四时不凋者，或得于纯阴，或得于纯阳。厚朴气味苦辛，色性赤烈，纯阳之木也。其苦味应于花赤而皮紫，是味归于形，其形色紫赤应于气之温，是形归乎气。不可想其纯阳而能散结之用欤？　（天地之气，至夏而阳盛阴衰，在气化应然，原非偏至之戾气也。厚朴所谓纯阳，即禀乎此气，其能散元气者，亦如夏时之宣泄已极，非谓其辛热太甚也。）夫苦能下泄，苦从乎温，则不下泄而温散。卢氏所云从内而外，以司夏出横偏之令者。若苦合于寒，则直下泄，如枳壳辈是已。夫气之生化在中土，此味苦中觉有微甘，所以直归中土而散结气。苦味从温，所以能就气分而散之。凡病乎寒湿之邪者，实为的对。其病乎湿热者，有苦寒以清热燥湿，而假此苦温以散其结，亦罔不奏功。至先哲首以除胀满为言，惟虚而无邪之胀满，不宜混用。若寒湿实邪，固其正治，即湿热为病，如厚味积热及外感郁热者，亦实胀也。苦寒药中，可假厚朴以除之。或中气虚而患湿热，则必审虚与实，孰多孰少，更审乎时之久暂，以定攻补之多少，此味又未可去也。如苦寒除邪之味多，而健脾者少，用此散湿热之结，恐苦寒直攻，不能径散也。又如苦甘健脾之味多，而除热者少，用此化补益之骤，恐苦甘径补，不能直受也。（湿热不宜纯甘，虚而有湿热者，宜于苦甘。）　即此推之他证，凡可投厚朴者，悉如斯矣。厚朴始尝味苦，苦中微甘，最后有辛，意非辛也，乃苦温之余烈，俗所云麻味也。故以姜制之，犹制半夏之义耳。然则厚朴从苦温以散结，不若枳壳从苦寒以泄滞矣。夫气以温热为升为补，而苦甚者，乃从升补中以散之，以寒凉为降为泄，而苦甚者，乃从降泄中以导之。故厚朴之治，宜于寒，或宜于湿。而枳壳之治，宜于热，或宜于燥。当各从其所对以投之。如施厚朴于燥热之结，犹可借从治以奏功，若施枳壳于寒湿，是气本下而复降之，不惟无益而有害矣，"}]},{"ID":"20240612094334-ce4f7iu","Type":"NodeParagraph","Properties":{"id":"20240612094334-ce4f7iu","updated":"20240612094334"},"Children":[{"Type":"NodeText","Data":"缪氏云：性味散而不收，略无补益。凡病气虚不能归元，血槁不能润降，（膈证等）老人、娠妇及产后，咸忌。"}]},{"ID":"20240612094334-dfqoczj","Type":"NodeParagraph","Properties":{"id":"20240612094334-dfqoczj","updated":"20240612094334"},"Children":[{"Type":"NodeText","Data":"〔修治〕去粗皮，用姜汁拌浸，仍用姜渣同炒，以姜渣黑色为度。"}]},{"ID":"20240612094307-ffppni4","Type":"NodeThematicBreak","Properties":{"id":"20240612094307-ffppni4"}},{"ID":"20240612094308-q6jv9o9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094308-q6jv9o9","updated":"20240612094315"},"Children":[{"Type":"NodeText","Data":"厚朴《本草备要》"}]},{"ID":"20240612094308-sq7zbri","Type":"NodeParagraph","Properties":{"id":"20240612094308-sq7zbri","updated":"20240612094308"},"Children":[{"Type":"NodeText","Data":"厚朴（泻，下气，散满。）"}]},{"ID":"20240612094308-pchdw9j","Type":"NodeParagraph","Properties":{"id":"20240612094308-pchdw9j","updated":"20240612094308"},"Children":[{"Type":"NodeText","Data":"苦降能泻实满，辛温能散湿满。（王好古曰：《别录》言：厚朴温中益气，消痰下气，果泄气乎?益气乎?盖与枳实、大黄同用，则泻实满，所谓消痰下气是也；与橘皮、苍术同用，则除湿满，所谓温中益气是也；与解利药同用，则治伤寒头痛；与泻利药同用，则厚肠胃。大抵味苦性温，用苦则泻，用温则补也。●同大黄、枳实，即承气汤；同橘皮、苍术，即平胃散。●按：胀满证多不同，消补贵得其宜，气虚宜补气，血虚宜补血，食积宜消导，痰滞宜行痰，挟热宜清热，湿盛宜利湿，寒郁者散寒，怒郁者行气，蓄血者消瘀，不宜专用行散药。亦有服参、芪而胀反甚者，以挟食、挟血、挟热、挟寒，不可概作脾虚气弱治也。）入足太阴、阳明（脾、胃）。平胃调中，（佐苍术为平胃散，平湿土之太过，以致于中和。）消痰化食，厚肠胃，行结水，破宿血，杀脏虫。"}]},{"ID":"20240612094308-y9wucwn","Type":"NodeParagraph","Properties":{"id":"20240612094308-y9wucwn","updated":"20240612094308"},"Children":[{"Type":"NodeText","Data":"治反胃呕逆，喘咳泻痢，冷痛霍乱。"}]},{"ID":"20240612094308-ijvfoxb","Type":"NodeParagraph","Properties":{"id":"20240612094308-ijvfoxb","updated":"20240612094308"},"Children":[{"Type":"NodeText","Data":"误服脱人元气，孕妇忌之。"}]},{"ID":"20240612094308-kvb0i43","Type":"NodeParagraph","Properties":{"id":"20240612094308-kvb0i43","updated":"20240612094308"},"Children":[{"Type":"NodeText","Data":"榛树皮也，肉厚紫润者良。去粗皮，姜汁炙，或醋炒用。"}]},{"ID":"20240612094308-672st5u","Type":"NodeParagraph","Properties":{"id":"20240612094308-672st5u","updated":"20240612094308"},"Children":[{"Type":"NodeText","Data":"干姜为使，恶泽泻、硝石。忌豆，犯之动气。"}]},{"ID":"20240612094248-5bi3bhx","Type":"NodeThematicBreak","Properties":{"id":"20240612094248-5bi3bhx"}},{"ID":"20240612094249-70emm2l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094249-70emm2l","updated":"20240612094257"},"Children":[{"Type":"NodeText","Data":"厚朴《神农本草经赞》"}]},{"ID":"20240612094249-fx6h79o","Type":"NodeParagraph","Properties":{"id":"20240612094249-fx6h79o","updated":"20240612094249"},"Children":[{"Type":"NodeText","Data":"味苦温，主中风伤寒头痛，寒热惊悸，气血痹死肌，去三虫。"}]},{"ID":"20240612094249-zta3ai3","Type":"NodeParagraph","Properties":{"id":"20240612094249-zta3ai3","updated":"20240612094249"},"Children":[{"Type":"NodeText","Data":"不残纯朴，龙梓储珍，半出黄槲，层蔽苍榛，白凝肤厚，紫透鳞皴，从容典职，佐助姜辛。"}]},{"ID":"20240612094249-iqux8nl","Type":"NodeParagraph","Properties":{"id":"20240612094249-iqux8nl","updated":"20240612094249"},"Children":[{"Type":"NodeText","Data":"庄子：纯朴不残。苏颂曰：厚朴以龙州梓州为上，叶如槲叶，鳞皴而厚。张衡文：远国储珍。郝经诗：半出黄槲岘。名医曰：一名榛。李白诗：苍榛蔽层邱。李时珍曰：肤白肉紫。释无可诗：枝干怪鳞皴。纪异录：卢端制既怀厚朴之才，宜典从容之职。日华子曰：凡入药须用姜汁炙浸。"}]},{"ID":"20240612093140-4seqdu1","Type":"NodeThematicBreak","Properties":{"id":"20240612093140-4seqdu1"}},{"ID":"20240612094029-uzxquyz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612094029-uzxquyz","updated":"20240612094038"},"Children":[{"Type":"NodeText","Data":"厚朴《本草崇原》"}]},{"ID":"20240612094029-bk8dqnt","Type":"NodeParagraph","Properties":{"id":"20240612094029-bk8dqnt","updated":"20240612094029"},"Children":[{"Type":"NodeText","Data":"气味苦温，无毒。主治中风，伤寒，头痛寒热，惊悸，气血痹，死肌，去三虫。"}]},{"ID":"20240612094029-p8a68yj","Type":"NodeParagraph","Properties":{"id":"20240612094029-p8a68yj","updated":"20240612094029"},"Children":[{"Type":"NodeText","Data":"（厚朴取其木质朴而皮厚以命名，一名烈朴，又名赤朴，谓其性辛烈而色紫赤也。洛阳、陕西、江淮、河南、川蜀山谷中，往往有之，近以建平、宜都及梓州、龙州者为上。木高三四丈，径一二尺，肉皮极厚，以色紫油润者为佳，春生叶如槲叶，四季不凋，五六月开红花，结实如冬青子，生青熟赤，实中有核，其味甘美。厚朴之实，别名逐折。《别录》云：主疗鼠瘘，明目，益气。）"}]},{"ID":"20240612094029-76qh7nt","Type":"NodeParagraph","Properties":{"id":"20240612094029-76qh7nt","updated":"20240612094029"},"Children":[{"Type":"NodeText","Data":"厚朴气味苦温，色赤性烈，花实咸红，冬不落叶，肉厚色紫，盖禀少阳木火之精，而通会于肌腠者也。主治中风伤寒头痛寒热者，谓能解肌而发散也。助木火之精气，故能定肝心之惊悸也。气血痹者，津液随三焦出气以温肌肉，肝主冲任之血，充肤热肉，痹则气血不和于肌腠。厚朴气温色紫，能解气血之痹而活死肌也。去三虫者，三焦火气内虚，则生虫。厚朴得少阳之火化，而三虫自去矣。"}]},{"ID":"20240612094029-tyzwse0","Type":"NodeParagraph","Properties":{"id":"20240612094029-tyzwse0","updated":"20240612094029"},"Children":[{"Type":"NodeText","Data":"愚按：厚朴色赤性烈，生用则解肌而达表，禀木火之气也。炙香则运土而助脾，木生火而火生土也。《金匮》方中厚朴大黄汤，用厚朴一尺，取象乎脾也。"}]},{"ID":"20240612093219-4fzx491","Type":"NodeThematicBreak","Properties":{"id":"20240612093219-4fzx491"}},{"ID":"20240612093954-37pu7ws","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093954-37pu7ws","updated":"20240612094001"},"Children":[{"Type":"NodeText","Data":"厚朴《长沙药解》"}]},{"ID":"20240612093954-35qo1l3","Type":"NodeParagraph","Properties":{"id":"20240612093954-35qo1l3","updated":"20240612093954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦温。主中风，伤寒，头痛，寒热，惊悸气，血痹，死肌，去三虫。"}]},{"ID":"20240612093954-5fs3r50","Type":"NodeParagraph","Properties":{"id":"20240612093954-5fs3r50","updated":"20240612093954"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微温，入足阳明胃经。降冲逆而止嗽，破壅阻而定喘，善止疼痛，最消胀满。"}]},{"ID":"20240612093954-u9zxpun","Type":"NodeParagraph","Properties":{"id":"20240612093954-u9zxpun","updated":"20240612093954"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝加厚朴杏子汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桂枝、芍药、生姜各三两，甘草、厚朴各二两，大枣十二枚，杏仁五十枚。"},{"Type":"NodeText","Data":"治太阳伤寒，下后微喘者。下后中虚胃逆，肺金莫降，是以发喘。姜、甘、大枣，和中而补土，桂枝、芍药，疏木而泻热，厚朴、杏仁，降逆而止喘也。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"《伤寒》：喘家作桂枝汤加厚朴杏子仁。"}]},{"ID":"20240612093954-2hwkjwb","Type":"NodeParagraph","Properties":{"id":"20240612093954-2hwkjwb","updated":"20240612093954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"朴姜甘夏人参汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"厚朴一斤，生姜半斤，甘草二两，半夏半升，人参一两。"},{"Type":"NodeText","Data":"治伤寒汗后，腹胀满者。汗后中虚胃逆，浊阴冲塞，是以胀满。人参、甘草，补中而培土，朴、半、生姜，泻满而消胀也。"}]},{"ID":"20240612093954-grpsmfu","Type":"NodeParagraph","Properties":{"id":"20240612093954-grpsmfu","updated":"20240612093954"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴大黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"厚朴一尺，枳实四枚，大黄六两。"},{"Type":"NodeText","Data":"此即小承气汤，而分两不同。治支饮胸满者。以饮居心下，肺胃郁阻，是以胸满。大黄破结而逐饮，枳、朴泻满而降逆也。"}]},{"ID":"20240612093954-2jai3b9","Type":"NodeParagraph","Properties":{"id":"20240612093954-2jai3b9","updated":"20240612093954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴三物汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"厚朴八两，枳实五枚，大黄四两。此亦小承气汤，而分量不同。二方皆君厚朴。"},{"Type":"NodeText","Data":"治腹满而便闭者。以滞气抟结，闭塞不通。枳、朴行滞而止痛，大黄破结而开塞闭也。"}]},{"ID":"20240612093954-8r795fi","Type":"NodeParagraph","Properties":{"id":"20240612093954-8r795fi","updated":"20240612093954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴七物汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"厚朴半斤，枳实五枚，大黄二两，桂枝二两，甘草三两，生姜五两，大枣十枚。"},{"Type":"NodeText","Data":"治腹满痛，发热，脉浮而数，饮食如故者。以外感风邪，经腑皆郁，经气不泄，故发热脉数。腑气不通，故腹满而痛。甘、枣、桂、姜，达郁而解外，枳、朴、大黄，泻满而攻里也。"}]},{"ID":"20240612093954-0trxdd3","Type":"NodeParagraph","Properties":{"id":"20240612093954-0trxdd3","updated":"20240612093954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴麻黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"厚朴五两，小麦一升，麻黄四两，石膏如鸡子大，杏仁半升，干姜二两，半夏半升，细辛二两，五味半升。"},{"Type":"NodeText","Data":"治咳而脉浮者。以中脘不运，皮毛不合，肺胃郁阻，浊气莫泄。麻黄发表而散寒，小麦、石膏，清肺而润燥，朴、杏、半夏、姜、辛、五味，降逆而止咳也。"}]},{"ID":"20240612093954-xrpguu3","Type":"NodeParagraph","Properties":{"id":"20240612093954-xrpguu3","updated":"20240612093954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大小承气汤"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏厚朴汤"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在半夏。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳实薤白桂枝汤"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在枳实。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"王不留行散"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在王不留行。"},{"Type":"NodeText","Data":"皆用之，以其降浊而行滞也。"}]},{"ID":"20240612093954-ymgc45a","Type":"NodeParagraph","Properties":{"id":"20240612093954-ymgc45a","updated":"20240612093954"},"Children":[{"Type":"NodeText","Data":"厚朴苦辛下气，善破壅塞而消胀满，下冲逆而定喘嗽，疏通郁迫，和解疼痛，除反胃呕吐，疗肠滑泄利，消宿食停水，调泄秽吞酸，止肠胃雷鸣，平霍乱转筋，下冲消滞物也。"}]},{"ID":"20240612093954-ile59lb","Type":"NodeParagraph","Properties":{"id":"20240612093954-ile59lb","updated":"20240612093954"},"Children":[{"Type":"NodeText","Data":"去皮，姜汁炒。"}]},{"ID":"20240612093219-60uqy65","Type":"NodeThematicBreak","Properties":{"id":"20240612093219-60uqy65"}},{"ID":"20240612093945-4ilgnti","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093945-4ilgnti","updated":"20240612093950"},"Children":[{"Type":"NodeText","Data":"厚朴《本草纲目》"}]},{"ID":"20240612093945-k2hlhib","Type":"NodeParagraph","Properties":{"id":"20240612093945-k2hlhib","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"「释名」烈朴、赤朴、厚皮。树名榛，子名逐折。"}]},{"ID":"20240612093945-q4f4hws","Type":"NodeParagraph","Properties":{"id":"20240612093945-q4f4hws","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"「气味」苦、温、无毒。"}]},{"ID":"20240612093945-6mqraue","Type":"NodeParagraph","Properties":{"id":"20240612093945-6mqraue","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612093945-2q6x3qv","Type":"NodeParagraph","Properties":{"id":"20240612093945-2q6x3qv","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"1、脾胃虚损。用厚朴（去皮，切片）、生姜（连皮，切片）二斤，在水五升中同煮干，去姜，焙朴，再以干姜四两、甘草二两，同厚朴一起，在水五升中煮干，去甘草，焙闰、朴为末加枣肉、生姜同煮熟，去姜，把枣内、药末捣匀做成丸子，如梧子大。每服五十丸，米汤送下。方中再加熟附子亦可。此方名“厚朴煎丸”。"}]},{"ID":"20240612093945-kaxoglb","Type":"NodeParagraph","Properties":{"id":"20240612093945-kaxoglb","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"2、痰呕逆。饮食不下。用厚朴一两、姜汁炙黄，研为末，每服二匙，米汤调下。"}]},{"ID":"20240612093945-jdmi4c1","Type":"NodeParagraph","Properties":{"id":"20240612093945-jdmi4c1","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"3、腹前胀满。用厚朴（制）半斤，甘草、大黄各三两，枣十枚，大枳实五枚，桂二两，生姜五两，加水一培，煎成四升，温服八合。一天服三次，呕吐者再加半夏五合。此名“厚朴七物汤”。"}]},{"ID":"20240612093945-8xt1x04","Type":"NodeParagraph","Properties":{"id":"20240612093945-8xt1x04","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"4、气胀心闷，饮食不下，久患不愈。用厚朴以姜汁炙焦后研为末。每服二匙，陈米汤调下，一天服三次。"}]},{"ID":"20240612093945-gyo9ln2","Type":"NodeParagraph","Properties":{"id":"20240612093945-gyo9ln2","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"5、反胃、下泻。治方同上。"}]},{"ID":"20240612093945-8poew11","Type":"NodeParagraph","Properties":{"id":"20240612093945-8poew11","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"6、霍乱腹痛。用厚朴（炙）四两、桂心二两、枳实五枚、生姜二两，加水六升，煎取二升，分三次服下。此方名“厚朴汤”。"}]},{"ID":"20240612093945-a70e5j3","Type":"NodeParagraph","Properties":{"id":"20240612093945-a70e5j3","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"7、久痢。用厚朴三两、黄连三两，加水三升，煎成一升，空心细细服下。"}]},{"ID":"20240612093945-ek7qbuz","Type":"NodeParagraph","Properties":{"id":"20240612093945-ek7qbuz","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"8、大肠干结。用厚朴（生研）、猪脏（煮熟捣烂）和成丸子，如梧子大。每服三十丸，姜水送下。"}]},{"ID":"20240612093945-ezb7efb","Type":"NodeParagraph","Properties":{"id":"20240612093945-ezb7efb","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"9、尿浑浊。用厚朴（姜汁炙）一两、白茯苓一钱，加水、酒各一碗，煎成一碗，温服。"}]},{"ID":"20240612093945-xurs315","Type":"NodeParagraph","Properties":{"id":"20240612093945-xurs315","updated":"20240612093945"},"Children":[{"Type":"NodeText","Data":"10、月经不通。有厚朴三两（炙过，切细），加水三升，煎成一升，分二次空心服下。三、四剂之后，即见特效。方中如桃仁、红花亦可。"}]},{"ID":"20240612093140-g3kkklq","Type":"NodeThematicBreak","Properties":{"id":"20240612093140-g3kkklq"}},{"ID":"20240612093212-qrqe6dl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093212-qrqe6dl","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"《中国药典》：厚朴"}]},{"ID":"20240612093212-rx5x7ux","Type":"NodeParagraph","Properties":{"id":"20240612093212-rx5x7ux","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612093212-a62fs1p","Type":"NodeParagraph","Properties":{"id":"20240612093212-a62fs1p","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" Hòu Pò"}]},{"ID":"20240612093212-d02vfva","Type":"NodeParagraph","Properties":{"id":"20240612093212-d02vfva","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612093212-3nxvur1","Type":"NodeParagraph","Properties":{"id":"20240612093212-3nxvur1","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 川朴、紫油厚朴"}]},{"ID":"20240612093212-g36fhhj","Type":"NodeParagraph","Properties":{"id":"20240612093212-g36fhhj","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612093212-hg07kgx","Type":"NodeParagraph","Properties":{"id":"20240612093212-hg07kgx","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" CORTEX MAGNOLIAE OFFICINALIS"}]},{"ID":"20240612093212-f9bnfij","Type":"NodeParagraph","Properties":{"id":"20240612093212-f9bnfij","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612093212-omy6ss1","Type":"NodeParagraph","Properties":{"id":"20240612093212-omy6ss1","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 本品为木兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴"},{"Type":"NodeText","Data":"Magnolia officinalis Rehd. et Wils.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"凹叶厚朴"},{"Type":"NodeText","Data":"Magnolia officinalis Rehd. et Wils. var. biloba Rehd. et Wils.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干皮"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枝皮"},{"Type":"NodeText","Data":"。4～6月剥取，根皮及枝皮直接阴干；干皮置沸水中微煮后，堆置阴湿处，“发汗”至内表面变紫褐色或棕褐色时，蒸软，取出，卷成筒状，干燥。"}]},{"ID":"20240612093212-dcz4cui","Type":"NodeParagraph","Properties":{"id":"20240612093212-dcz4cui","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612093212-jbu88et","Type":"NodeParagraph","Properties":{"id":"20240612093212-jbu88et","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 干皮：呈卷筒状或双卷筒状，长30～35cm，厚0。2～0。7cm，习称“筒朴”；近根部的干皮一端展开如喇叭口，长13～25cm，厚0。3～0。8cm，习称“靴筒朴”。外表面灰棕色或灰褐色，粗糙，有时呈鳞片状，较易剥落，有明显椭圆形皮孔和纵皱纹，刮去粗皮者显黄棕色。内表面紫棕色或深紫褐色，较平滑，具细密纵纹，划之显油痕。质坚硬，不易折断，断面颗粒性，外层灰棕色，内层紫褐色或棕色，有油性，有的可见多数小亮星。气香，味辛辣、微苦。"}]},{"ID":"20240612093212-6osskk5","Type":"NodeParagraph","Properties":{"id":"20240612093212-6osskk5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"根皮（根朴）：呈单筒状或不规则块片；有的弯曲似鸡肠，习称“鸡肠朴”。质硬，较易折断，断面纤维性。"}]},{"ID":"20240612093212-ev4taad","Type":"NodeParagraph","Properties":{"id":"20240612093212-ev4taad","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"枝皮（枝朴）：呈单筒状，长10～20cm，厚0。1～0。2cm。质脆，易折断，断面纤维性。"}]},{"ID":"20240612093212-g12nslc","Type":"NodeParagraph","Properties":{"id":"20240612093212-g12nslc","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612093212-i311ebb","Type":"NodeParagraph","Properties":{"id":"20240612093212-i311ebb","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240612093212-m9x94k3","Type":"NodeParagraph","Properties":{"id":"20240612093212-m9x94k3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612093212-7wgmgu7","Type":"NodeParagraph","Properties":{"id":"20240612093212-7wgmgu7","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴"},{"Type":"NodeText","Data":"：刮去粗皮，洗净，润透，切丝，晒干。本品为弯曲丝条状，断面纤维性，外表面黄棕色，内表深紫褐色。"}]},{"ID":"20240612093212-z8ej4mf","Type":"NodeParagraph","Properties":{"id":"20240612093212-z8ej4mf","updated":"20240612093212"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姜厚朴"},{"Type":"NodeText","Data":"：取厚朴丝，照姜汁炙法（附录Ⅱ D）炒干。本品为弯曲丝条状，断面纤维性，呈紫褐色。"}]},{"ID":"20240612093212-w99qfee","Type":"NodeParagraph","Properties":{"id":"20240612093212-w99qfee","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612093212-m2gcx8v","Type":"NodeParagraph","Properties":{"id":"20240612093212-m2gcx8v","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：木栓层为10余列细胞；有的可见落皮层。皮层外侧有石细胞环带，内侧散有多数油细胞及石细胞群。韧皮部射线宽1～3列细胞；纤维多数个成束；亦有油细胞散在。粉末棕色。纤维甚多，直径15～32μm ，壁甚厚，有的呈波浪形或一边呈锯齿状，木化，孔沟不明显。石细胞类方形、椭圆形，卵圆形或不规则分枝状，直径11～65μm，有时可见层纹。油细胞椭圆形或类圆形，直径50～85μm ，含黄棕色油状物。"}]},{"ID":"20240612093212-px24equ","Type":"NodeParagraph","Properties":{"id":"20240612093212-px24equ","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末0。5g，加甲醇5ml ，密塞，振摇30分钟，滤过，滤液作为供试品溶液，另取厚朴酚与和厚朴酚对照品，加甲醇制成每1ml 各含 1mg的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一硅胶Ｇ薄层板上，以苯－甲醇（27:1）为展开剂，展开，取出，晾干，喷以 1％香草醛硫酸溶液，在100℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240612093212-8b4jqbg","Type":"NodeParagraph","Properties":{"id":"20240612093212-8b4jqbg","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612093212-aemo2b3","Type":"NodeParagraph","Properties":{"id":"20240612093212-aemo2b3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、肺、大肠经。"}]},{"ID":"20240612093212-1li4q7y","Type":"NodeParagraph","Properties":{"id":"20240612093212-1li4q7y","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612093212-4elb0e5","Type":"NodeParagraph","Properties":{"id":"20240612093212-4elb0e5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 苦、辛，温。"}]},{"ID":"20240612093212-trmg4a6","Type":"NodeParagraph","Properties":{"id":"20240612093212-trmg4a6","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612093212-edxx1jj","Type":"NodeParagraph","Properties":{"id":"20240612093212-edxx1jj","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 燥湿消痰，下气除满。用于湿滞伤中，脘痞吐泻，食积气滞，腹胀便秘，痰饮喘咳。"}]},{"ID":"20240612093212-pruqmw3","Type":"NodeParagraph","Properties":{"id":"20240612093212-pruqmw3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612093212-gfzh32v","Type":"NodeParagraph","Properties":{"id":"20240612093212-gfzh32v","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240612093212-htfdkww","Type":"NodeParagraph","Properties":{"id":"20240612093212-htfdkww","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612093212-8psv5hq","Type":"NodeParagraph","Properties":{"id":"20240612093212-8psv5hq","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" （1）常与苍朮、陈皮等配合用于湿困脾胃、脘腹致胀满等症。对气滞胸腹胀痛，可配木香、枳壳同用；便秘腹胀，可配大黄、枳实同用；治痰气互结梅核气，可配苏叶、半夏等同用。用于痰湿内蕴、胸闷喘咳，常与苏子、半夏，或麻黄、杏仁等同用。"}]},{"ID":"20240612093212-j3x0f0g","Type":"NodeParagraph","Properties":{"id":"20240612093212-j3x0f0g","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612093212-56hurqs","Type":"NodeParagraph","Properties":{"id":"20240612093212-56hurqs","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612093212-ea97hrn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093212-ea97hrn","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：厚朴"}]},{"ID":"20240612093212-sjvj77l","Type":"NodeParagraph","Properties":{"id":"20240612093212-sjvj77l","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612093212-coezvof","Type":"NodeParagraph","Properties":{"id":"20240612093212-coezvof","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" Hòu Pò"}]},{"ID":"20240612093212-0zbkhu3","Type":"NodeParagraph","Properties":{"id":"20240612093212-0zbkhu3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612093212-5w8mmht","Type":"NodeParagraph","Properties":{"id":"20240612093212-5w8mmht","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 厚皮（《吴普本草》），重皮（《广雅》），赤朴（《别录》），烈朴（《日华子本草》）。"}]},{"ID":"20240612093212-yun7wa0","Type":"NodeParagraph","Properties":{"id":"20240612093212-yun7wa0","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612093212-wyquo9v","Type":"NodeParagraph","Properties":{"id":"20240612093212-wyquo9v","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612093212-zeq1bcv","Type":"NodeParagraph","Properties":{"id":"20240612093212-zeq1bcv","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612093212-cclpqhe","Type":"NodeParagraph","Properties":{"id":"20240612093212-cclpqhe","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 为木兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"凹叶厚朴"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。立夏至夏至间剥取生长20年以上的植株的干皮或根皮（须先将外表粗皮刮去），阴干；再堆放于土坑内，在一定的温度和湿度下使之发汗，取出晒干，再蒸熟使变软，卷成筒状，阴干。细小的根皮，只须除净泥土，适当切断，阴干即可。"}]},{"ID":"20240612093212-kajb93y","Type":"NodeParagraph","Properties":{"id":"20240612093212-kajb93y","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612093212-audw81i","Type":"NodeParagraph","Properties":{"id":"20240612093212-audw81i","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" ①厚朴"}]},{"ID":"20240612093212-u1y4q6q","Type":"NodeParagraph","Properties":{"id":"20240612093212-u1y4q6q","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高5～15米。树皮紫褐色。小枝幼时有细毛，老时无毛，冬芽粗大，圆锥状，芽鳞密被淡黄褐色绒毛。叶互生，椭圆状倒卵形，长35～45厘米，阔12～20厘米，先端圆而有短急尖头，稀钝，基部渐狭成楔形，有时圆形，全缘，上面淡黄绿色，无毛，幼叶下面有密生灰色毛，者叶呈白粉状，侧脉上密生长毛；叶柄长3～4厘米。花与叶同时开放，单生枝顶，杯状，白色，芳香，直径15厘米；花梗粗短，长2～3.5厘米，密生丝状白毛；萼片与花瓣共9～12，或更多，肉质，几等长；萼片长圆状倒卵形，淡绿白色，常带紫红色；花瓣匙形，白色；雄蕊多数，螺旋状排列；雌蕊心皮多数，分离，子房长圆形。聚合果长椭圆状卵形，长9～12厘米，直径5～6.5厘米，心皮排列紧密，成熟时木质，顶端有弯尖头。种子三角状倒卵形，外种皮红色。花期4～5月。果期9～10月。"}]},{"ID":"20240612093212-nf49odt","Type":"NodeParagraph","Properties":{"id":"20240612093212-nf49odt","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"分布浙江、广西、江西、湖南、湖北、四川、贵州、云南、陕西、甘肃等地。"}]},{"ID":"20240612093212-4hmeb06","Type":"NodeParagraph","Properties":{"id":"20240612093212-4hmeb06","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②凹叶厚朴，又名:庐山厚朴。"}]},{"ID":"20240612093212-1yfqfw4","Type":"NodeParagraph","Properties":{"id":"20240612093212-1yfqfw4","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"与上种的主要不同点，在叶片先端凹陷成2钝圆浅裂片，裂深2～3.5厘米。"}]},{"ID":"20240612093212-57ef69n","Type":"NodeParagraph","Properties":{"id":"20240612093212-57ef69n","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"分布浙江、江西、安徽、广西等地。"}]},{"ID":"20240612093212-rp5o77u","Type":"NodeParagraph","Properties":{"id":"20240612093212-rp5o77u","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612093212-vxk76x4","Type":"NodeParagraph","Properties":{"id":"20240612093212-vxk76x4","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 商品由于采皮的部位、加工及形状的不同，种类很多，主要有筒朴、靴角朴、根朴、枝朴四类。"}]},{"ID":"20240612093212-77n7gng","Type":"NodeParagraph","Properties":{"id":"20240612093212-77n7gng","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"①筒朴"}]},{"ID":"20240612093212-rbpwg1v","Type":"NodeParagraph","Properties":{"id":"20240612093212-rbpwg1v","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"为主干的干皮，经加工后卷成双卷筒状，形似\"如意\"，故又称为\"如意卷厚朴\"或\"如意朴\"。长15～45厘米，厚2～5毫米。表面呈淡棕色至深棕色，较薄的皮，表面裂纹少，有纵纹，可见圆形纵裂皮孔；较厚者，表面粗糙，栓皮鳞状，易剥落。内表面紫棕色，平滑，有细致的纵走纹理，以指甲划之显油纹。质较润而坚硬，不易折断，断面外侧呈灰棕色纤维性，内侧为紫棕色颗粒状，油润性。气芳香，味微辛，咀嚼之少残渣。"}]},{"ID":"20240612093212-ggtqapn","Type":"NodeParagraph","Properties":{"id":"20240612093212-ggtqapn","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②靴角朴"}]},{"ID":"20240612093212-nr5af43","Type":"NodeParagraph","Properties":{"id":"20240612093212-nr5af43","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"为靠近根部的干皮，经加工后其形如靴，故名。全长约30～40厘米，厚约3～10毫米。外皮粗糙，灰棕色或灰褐色，栓皮易剥落。上端为单卷筒状，基部展开成喇叭口形，有纵裂纹及横皱纹呈凹沟状。因厚薄不匀而形成紫棕色和灰黄色相间的花纹，并有刀刮痕。内面为深紫色或深红色，有直条纹，下部有凹下的横沟，与外皮的横皱纹相对，以指甲划之，可见油纹。质润而稍坚，但易折断。断面紫棕色，颗粒状。气辛香，味苦而辣，咀嚼无残渣。"}]},{"ID":"20240612093212-cqrur8h","Type":"NodeParagraph","Properties":{"id":"20240612093212-cqrur8h","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③根朴"}]},{"ID":"20240612093212-ybd9zu8","Type":"NodeParagraph","Properties":{"id":"20240612093212-ybd9zu8","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"为根皮经加工后卷成单或双卷，多劈破，形弯曲如鸡肠，故又名\"鸡肠朴\"。长15～45厘米，直径0.5～2厘米，厚约1～3毫米。表面粗糙，灰棕色，有横裂纹及纵皱纹，劈破处有纤维状物露出，内表面深紫棕色，有显著的纵纹及枝根痕。质韧，难折断，断面纤维性，油润。气味与干皮同，但咀嚼后遗留的残渣较多。"}]},{"ID":"20240612093212-060gmxo","Type":"NodeParagraph","Properties":{"id":"20240612093212-060gmxo","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"④枝朴"}]},{"ID":"20240612093212-ng5imbw","Type":"NodeParagraph","Properties":{"id":"20240612093212-ng5imbw","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"为粗枝上剥下的皮，呈单卷状，长10～20厘米，厚1～2毫米。表面稍粗糙，灰褐色，有纵皱纹及斑痕，有时可见大型孔洞。内表面深紫棕色，平滑，有深直条纹，质脆，易折断。断面纤维性。气味与干皮同，咀嚼后残渣较多。"}]},{"ID":"20240612093212-z7p71za","Type":"NodeParagraph","Properties":{"id":"20240612093212-z7p71za","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"以上各种厚朴，断面均有点状闪光性结晶。以皮粗肉细，内色深紫、油性大、香味浓、味苦辛微甜、咀嚼无残渣者为佳。"}]},{"ID":"20240612093212-as14zu9","Type":"NodeParagraph","Properties":{"id":"20240612093212-as14zu9","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"主产四川、湖北、浙江、贵州、湖南。以四川、湖北所产质量最佳，称紫油厚朴；浙江所产称温朴，质量亦好。此外，福建、江西、广西、甘肃、陕西等地亦产。"}]},{"ID":"20240612093212-aj0wmtu","Type":"NodeParagraph","Properties":{"id":"20240612093212-aj0wmtu","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612093212-muzsjom","Type":"NodeParagraph","Properties":{"id":"20240612093212-muzsjom","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 厚朴树皮含厚朴酚、四氢厚朴酚、异厚朴酚、和朴酚、挥发油；另含木兰箭毒碱。"}]},{"ID":"20240612093212-olytula","Type":"NodeParagraph","Properties":{"id":"20240612093212-olytula","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"凹叶厚朴树皮含挥发油约1％。油含β--桉叶醇、厚朴酚、四氢厚朴酚及异厚朴酚。此外，尚含生物碱约0.07％、皂甙约0.45％。"}]},{"ID":"20240612093212-q3tyixk","Type":"NodeParagraph","Properties":{"id":"20240612093212-q3tyixk","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612093212-fdeh9zz","Type":"NodeParagraph","Properties":{"id":"20240612093212-fdeh9zz","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" ①抗菌作用"}]},{"ID":"20240612093212-v9p3ikn","Type":"NodeParagraph","Properties":{"id":"20240612093212-v9p3ikn","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"厚朴煎剂在试管中，对肺炎球菌、白喉杆菌、溶血性链球菌、枯草杆菌、志贺氏及施氏痢疾杆菌、金黄色葡萄球菌等有抑菌作用，其效力较黄连粉低5～10倍，但也有报告在体外对金黄色葡萄球菌之效力大于黄连者；在豚鼠体内对炭疽杆菌有某些抗菌作用；对若干皮肤真菌在体外有抑制作用；对实验性病毒性肝炎也有改善肝脏实质病变的作用。其醇浸剂（1:3000～1:300）在体外对结核杆菌也有某些抑制作用。"}]},{"ID":"20240612093212-n46w4e8","Type":"NodeParagraph","Properties":{"id":"20240612093212-n46w4e8","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240612093212-jtos520","Type":"NodeParagraph","Properties":{"id":"20240612093212-jtos520","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"厚朴煎剂对小鼠及豚鼠的离体肠管，小剂量出现兴奋，大剂量则为抑制，对豚鼠支气管平滑肌亦有兴奋作用。静脉注射（0.05克／公斤），可引起兔，猫的血压暂时下降，对离体蟾蜍心脏有抑制作用。此外，它还可能有箭毒样作用，动物死亡时表现垂头、四肢麻痹，麻痹作用可被士的宁对抗。煎剂对小鼠的半数致死量，腹腔注射时为6.12±0.038克/公斤，皮下注射为51克/公斤；猫的最小致死量，静脉注射平均为4.25±1.5克/公斤，口服时毒性很小。表示肠胃道吸收不完全。"}]},{"ID":"20240612093212-ruyszk5","Type":"NodeParagraph","Properties":{"id":"20240612093212-ruyszk5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612093212-b6op5m6","Type":"NodeParagraph","Properties":{"id":"20240612093212-b6op5m6","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 厚朴:用水浸泡捞出，润透后刮去粗皮，洗净，切丝，晾干。姜厚朴:取生姜切片煎汤，加净厚朴，与姜汤共煮透，待汤吸尽，取出，及时切片，晾干。（每厚朴100斤，用生姜10斤）"}]},{"ID":"20240612093212-31ne3ig","Type":"NodeParagraph","Properties":{"id":"20240612093212-31ne3ig","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》:\"凡使厚朴，要用紫色味辛为好。或丸散，便去粗皮，用酥炙过。每修一斤，用酥四两，炙了细锉用；若汤饮中使，用自然姜汁八两炙，一升为度。\""}]},{"ID":"20240612093212-hhs39my","Type":"NodeParagraph","Properties":{"id":"20240612093212-hhs39my","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612093212-mt4cmmk","Type":"NodeParagraph","Properties":{"id":"20240612093212-mt4cmmk","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 入脾、胃、大肠经。"}]},{"ID":"20240612093212-5q4szuj","Type":"NodeParagraph","Properties":{"id":"20240612093212-5q4szuj","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》:\"入脾、胃二经。\""}]},{"ID":"20240612093212-icsqils","Type":"NodeParagraph","Properties":{"id":"20240612093212-icsqils","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》:\"入足太阴，手足阳明经。\""}]},{"ID":"20240612093212-p22wns7","Type":"NodeParagraph","Properties":{"id":"20240612093212-p22wns7","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③《本草经解》:\"入足厥阴肝经、手少阴心经。\""}]},{"ID":"20240612093212-9yb88lg","Type":"NodeParagraph","Properties":{"id":"20240612093212-9yb88lg","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612093212-7rd5y62","Type":"NodeParagraph","Properties":{"id":"20240612093212-7rd5y62","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 苦辛，温。"}]},{"ID":"20240612093212-v290psh","Type":"NodeParagraph","Properties":{"id":"20240612093212-v290psh","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"味苦，温。\""}]},{"ID":"20240612093212-44kgu3i","Type":"NodeParagraph","Properties":{"id":"20240612093212-44kgu3i","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"大温，无毒。\""}]},{"ID":"20240612093212-qujpb9t","Type":"NodeParagraph","Properties":{"id":"20240612093212-qujpb9t","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③《药性论》:\"味苦辛，太热。\""}]},{"ID":"20240612093212-ubtudbr","Type":"NodeParagraph","Properties":{"id":"20240612093212-ubtudbr","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612093212-qt78nl0","Type":"NodeParagraph","Properties":{"id":"20240612093212-qt78nl0","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240612093212-hg5tilq","Type":"NodeParagraph","Properties":{"id":"20240612093212-hg5tilq","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》:\"干姜为之使。恶泽泻、寒水石、消石。\""}]},{"ID":"20240612093212-0zn4rr5","Type":"NodeParagraph","Properties":{"id":"20240612093212-0zn4rr5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②《药性论》:\"忌豆，食之者动气。\""}]},{"ID":"20240612093212-x0wlgd2","Type":"NodeParagraph","Properties":{"id":"20240612093212-x0wlgd2","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》:\"妊娠不可服。\""}]},{"ID":"20240612093212-1bazyqa","Type":"NodeParagraph","Properties":{"id":"20240612093212-1bazyqa","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》:\"凡呕吐不因寒痰冷积，而由于胃虚火气炎上；腹痛因于血虚脾阴不足，而非停滞所致；泄泻因于火热暴注，而非积寒伤冷；腹满因于中气不足、气不归元，而非气实壅滞；中风由于阴虚火炎、猝致僵仆，而非西北真中寒邪；伤寒发热头疼，而无痞塞胀满之候；小儿吐泻乳食，将成慢惊；大人气虚血槁，见发膈证；老人脾虚不能运化，偶有停积；妊妇恶阻，水谷不入；娠妇胎升眩晕；娠妇伤食停冷；娠妇腹痛泻利；娠妇伤寒伤风；产后血虚腹痛；产后中满作喘；产后泄泻反胃，以上诸证，法所咸忌。\""}]},{"ID":"20240612093212-mc28v77","Type":"NodeParagraph","Properties":{"id":"20240612093212-mc28v77","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612093212-o3izm0b","Type":"NodeParagraph","Properties":{"id":"20240612093212-o3izm0b","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 温中，下气，燥湿，消痰。治胸腹痞满胀痛，反胃，呕吐，宿食不消，痰饮喘咳，寒湿泻痢。"}]},{"ID":"20240612093212-gstthxa","Type":"NodeParagraph","Properties":{"id":"20240612093212-gstthxa","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"主中风伤寒，头痛，寒热惊悸，气血痹，死肌，去三虫。\""}]},{"ID":"20240612093212-uxpe78o","Type":"NodeParagraph","Properties":{"id":"20240612093212-uxpe78o","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"温中益气，消痰下气。疗霍乱及腹痛胀满，胃中冷逆及胸中呕不止，泄痢淋露，除惊，去留热心烦满，厚肠胃。\""}]},{"ID":"20240612093212-c21yjwa","Type":"NodeParagraph","Properties":{"id":"20240612093212-c21yjwa","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③《药性论》:\"主疗积年冷气，腹内雷鸣，虚吼，宿食不消，除痰饮，去结水，破宿血，消化水谷，止痛。大温胃气，呕吐酸水。主心腹满，病人虚而尿白。\""}]},{"ID":"20240612093212-dpwx2a3","Type":"NodeParagraph","Properties":{"id":"20240612093212-dpwx2a3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》:\"健脾。主反胃，霍乱转筋，冷热气，泻膀胱，泄五藏一切气，妇人产前产后腹藏不安。调关节，杀腹藏虫，明耳目。\""}]},{"ID":"20240612093212-tjxi0nt","Type":"NodeParagraph","Properties":{"id":"20240612093212-tjxi0nt","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑤王好古:\"主肺气胀满，膨而喘咳。\""}]},{"ID":"20240612093212-m7b7req","Type":"NodeParagraph","Properties":{"id":"20240612093212-m7b7req","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑥《本草正》:\"温降，散滞，除寒湿泻痢。\""}]},{"ID":"20240612093212-qgj0bmq","Type":"NodeParagraph","Properties":{"id":"20240612093212-qgj0bmq","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612093212-ne4nmor","Type":"NodeParagraph","Properties":{"id":"20240612093212-ne4nmor","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 内服:煎汤，1～3钱；或入丸、散。"}]},{"ID":"20240612093212-hpgyxkw","Type":"NodeParagraph","Properties":{"id":"20240612093212-hpgyxkw","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612093212-5b1kjh1","Type":"NodeParagraph","Properties":{"id":"20240612093212-5b1kjh1","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" ①治腹满痛大便闭者:厚朴八两，大黄四两，枳实五枚。上三味，以水一斗二升，先煮二味，取五升，内大黄煮取三升。温服一升，以利为度。（《金匮要略》厚朴三物汤）"}]},{"ID":"20240612093212-3dinpin","Type":"NodeParagraph","Properties":{"id":"20240612093212-3dinpin","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②治久患气胀心闷，饮食不得，因食不调。冷热相击，致令心腹胀满:厚朴火上炙令干，又蘸姜汁炙，直待焦黑为度，捣筛如面。以陈米饮调下二钱匕，日三服。亦治反胃，止泻。（《斗门方》）"}]},{"ID":"20240612093212-um3a0g2","Type":"NodeParagraph","Properties":{"id":"20240612093212-um3a0g2","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③治脾胃气不和，不思饮食:厚朴（去粗皮，姜汁涂，炙令香净）二两半，甘草（炙）一两半，苍术（米泔水浸二日，刮去皮）四两，陈皮（去白）二两半。上四味，为末。每服一钱，水一盏，入生姜、枣子同煎七分，去滓温服，空心服之。或杵细末，蜜为丸，如梧桐子大。每服十丸，盐汤嚼下，空心服。（《博济方》平胃散）"}]},{"ID":"20240612093212-rlskojx","Type":"NodeParagraph","Properties":{"id":"20240612093212-rlskojx","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"④治因喜怒悲思忧恐惊之气，痰涎郁结，状如破絮，或如梅核，在咽喉之间，咯不出，咽不下，或中脘痞满，气不舒快，或痰涎壅盛，上气喘急，或因痰饮中结，呕逆恶心:紫苏叶二两，厚朴三两，茯苓四两，半夏五两。上细切。每服四钱，水盏半，生姜七片，枣一个，煎至六分，去滓，热服，不拘时候。（《易简方》四七汤即《金匮要略》半夏厚朴汤）"}]},{"ID":"20240612093212-xffyw2j","Type":"NodeParagraph","Properties":{"id":"20240612093212-xffyw2j","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑤治虫积:厚朴、槟榔各二钱，乌梅二个。水煎服。（《保赤全书》）"}]},{"ID":"20240612093212-0moafme","Type":"NodeParagraph","Properties":{"id":"20240612093212-0moafme","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑥治中寒洞泄:干姜、厚朴等分。上为末，蜜丸梧子大。任下三十丸。（《鲍氏小儿方》）"}]},{"ID":"20240612093212-uqunmwf","Type":"NodeParagraph","Properties":{"id":"20240612093212-uqunmwf","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑦治水谷痢久不瘥:厚朴三两，黄连三两。锉，水三升，煎取一升。空心细服。（《梅师集验方》）"}]},{"ID":"20240612093212-t79a5uv","Type":"NodeParagraph","Properties":{"id":"20240612093212-t79a5uv","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612093212-cnsp6hi","Type":"NodeParagraph","Properties":{"id":"20240612093212-cnsp6hi","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" ①治疗阿米巴痢疾"}]},{"ID":"20240612093212-ljval0a","Type":"NodeParagraph","Properties":{"id":"20240612093212-ljval0a","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"据46例观察，用药3～9天后，有43例获愈，2例进步，1例无效。治愈者绝大多数在3天左右临床症状即基本消失。平均腹痛消失时间为3.8天，大便成形、粘液血便消失为2.7天，大便次数恢复正常为3.2天，里急后重消失为3天，大便镜检恢复正常为4.5天。但对阿米巴原虫是否有杀灭作用，尚待证实。治后有2例复发，仍以原法治愈。用法:将川厚朴制成煎剂内服，每次20毫升（相当于生药2钱），每日2次。对脱水及中毒症状严重者应酌情补液及维持电解质平衡。副作用:少数患者有轻微耳鸣及便秘，不影响治疗。"}]},{"ID":"20240612093212-41h7etx","Type":"NodeParagraph","Properties":{"id":"20240612093212-41h7etx","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②用于制止针麻下全子宫切除术的鼓肠现象"}]},{"ID":"20240612093212-cw4s8sl","Type":"NodeParagraph","Properties":{"id":"20240612093212-cw4s8sl","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"试用厚朴粉于术前12小时1次吞服，体重50公开以下者5～7.5克，50公斤以上者7.5～10克。按此剂量用于36例手术，结果仅1例在手术过程中肠曲鼓出，使手术无法进行而改用硬膜外麻醉，其余在切开腹膜后肠曲不鼓，少数轻度鼓起，但轻轻一推即可将肠曲推上。术后一般在24～36小时间有肛门排气现象出现，自诉无其他不适。"}]},{"ID":"20240612093212-8jy8klv","Type":"NodeParagraph","Properties":{"id":"20240612093212-8jy8klv","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612093212-yzfdi63","Type":"NodeParagraph","Properties":{"id":"20240612093212-yzfdi63","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" ①李杲:\"厚朴，苦能下气，故泄实满；温能益气，故能散湿满。\""}]},{"ID":"20240612093212-sech89g","Type":"NodeParagraph","Properties":{"id":"20240612093212-sech89g","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"②《汤液本草》:\"《本经》云厚朴治中风、伤寒头痛，温中益气，消痰下气，厚肠胃，去腹胀满。果泄气乎?果益气乎?若与枳实、大黄同用，则能泄实满，《本经》谓消痰下气者是也。若与橘皮、苍术同用，则能除湿满，《本经》谓温中益气者是也。与解利药同用，则治伤寒头痛。与治痢药同用，则厚肠胃。大抵苦温，用苦则泄，用温则补。\""}]},{"ID":"20240612093212-jt4dr7d","Type":"NodeParagraph","Properties":{"id":"20240612093212-jt4dr7d","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"③朱震亨:\"厚朴，气药也。温而能散，消胃中之实也。\"\"厚朴能治腹胀，因其味辛以提其气。\""}]},{"ID":"20240612093212-uqcp80r","Type":"NodeParagraph","Properties":{"id":"20240612093212-uqcp80r","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》:\"厚朴，主中风、伤寒头痛、寒热，气血痹死肌者，盖以风寒外邪，伤于阳分，则为寒热头痛；风寒湿入腠理，则气血凝涩而成痹，甚则肌肉不仁，此药辛能散结，苦能燥湿，温热能祛风寒，故悉主之也。《别录》又主温中、消痰、下气，疗霍乱，及腹痛胀满，胃中冷逆，胸中呕不止，泄痢心烦满者，何莫非肠胃气逆壅滞，及痰饮留结，饮食生冷所致?得此下泄开通，温热暖肾，则诸证不求其止而止矣。至于淋露，虽属下焦为病，然多因胃家湿热下流；三虫亦肠胃湿热所生，苦能燥湿杀虫，故亦主之也。《本经》又主惊悸，及《别录》除惊去留热者，皆非其所宜。惊悸属心虚，于脾胃绝无相干，气味大温之药，又岂能去留热哉。至益气厚肠胃，盖亦指邪气去正气自益之谓，积滞消肠胃自厚之意耳，非消散之外，复有补益之功也，用者详之。\"\"厚朴气味辛温，性复大热，其功长于泄结散满，温暖脾胃。一切饮食停积，气壅暴胀，与夫冷气、逆气、积年冷气入腹，肠鸣，虚吼，痰饮吐沫，胃冷呕逆，腹痛泄泻及脾胃壮实之人，偶感风寒，气实人误服参、耆致成喘胀，诚为要药。然而性专消导，散而不收，略无补益之功。\""}]},{"ID":"20240612093212-uh1bvjb","Type":"NodeParagraph","Properties":{"id":"20240612093212-uh1bvjb","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑤《本草汇言》:\"厚朴，宽中化滞，平胃气之药也，凡气滞于中，郁而不散，食积于胃，羁而不行，或湿郁积而不去，湿痰聚而不清，用厚朴之温可以燥湿，辛可以清痰，苦可以下气也。故前古主中风、伤寒头痛寒热，呕逆泻利，虫积痞积，或肺气胀满，痰涎喘嗽，或胃气壅滞，水谷不行，用此消食化痰，去湿散胀，平土、金二脏，以致于中和也。\"\"沈孔庭云:厚朴辛苦温燥，入脾胃二经，散滞调中，推为首剂。然配他药，无往不可，与枳实、大黄同用，则泄实满，故大柴胡汤用之:与陈皮、苍术同用，则除湿满，故平胃散用之；与人参、白术、麦蘖同用，则治虚满，故调中汤用之；又同半夏、胆星，能燥湿清痰；同甘草、白术，能和中健胃；同枳壳、莱卜子能下气宽肠:同紫苏、前胡能发散风寒；同山查、枳实能疏气消食；同吴萸、肉桂能行湿燥阴，实有理气行气之功。但气之盛者，用无不验，气之弱者，宜少用之。\""}]},{"ID":"20240612093212-6d9svww","Type":"NodeParagraph","Properties":{"id":"20240612093212-6d9svww","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑥《本草经读》:\"厚朴，气味厚而主降，降则温而专于散，苦而专于泄，故所主皆为实症。中风有便溺阻隔症，伤寒有下之微喘症，有发汗后腹胀满症，大便鞭症，头痛有浊气上冲症，俱宜主以厚朴也。至于温能散寒，苦能泄热，能散能泄，则可以解气逆之惊悸。能散则气行，能泄则血行，故可以治气血痹及死肌也。宽胀下气，《经》无明文，仲景因其气味苦温而取用之，得《本经》言外之旨也。\""}]},{"ID":"20240612093212-ytuqcnt","Type":"NodeParagraph","Properties":{"id":"20240612093212-ytuqcnt","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"⑦《医学衷中参西录》:\"厚朴，治胃气上逆，恶心呕哕，胃气郁结胀满疼痛，为温中下气之要药。为其性温味又兼辛，其力不但下行，又能上升外达，故《本经）谓其主中风、伤寒头痛，《金匮》厚朴麻黄汤用治咳而脉浮。与橘、夏并用，善除湿满；与姜、术并用，善开寒痰凝结；与硝、黄并用，善通大便燥结；与乌药并用，善治小便因寒白浊。味之辛者，又能入肺以治外感咳逆；且能入肝，平肝之横恣，以愈胁下掀疼。……兼入血分，甄权谓其破宿血，古方治月闭亦有单用之者。诸家多谓其误服能脱元气，独叶香岩谓多用则破气，少用则通阳，诚为确当之论。\""}]},{"ID":"20240612093212-rphccni","Type":"NodeParagraph","Properties":{"id":"20240612093212-rphccni","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612093212-qsq6osi","Type":"NodeParagraph","Properties":{"id":"20240612093212-qsq6osi","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612093212-w0785em","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093212-w0785em","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"《中华本草》：厚朴"}]},{"ID":"20240612093212-vy92tbp","Type":"NodeParagraph","Properties":{"id":"20240612093212-vy92tbp","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612093212-yqcdrxc","Type":"NodeParagraph","Properties":{"id":"20240612093212-yqcdrxc","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" Hòu Pò"}]},{"ID":"20240612093212-ebzrbwp","Type":"NodeParagraph","Properties":{"id":"20240612093212-ebzrbwp","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612093212-rxjmmfq","Type":"NodeParagraph","Properties":{"id":"20240612093212-rxjmmfq","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 厚皮、重皮、赤朴、烈朴、川朴、紫油厚朴"}]},{"ID":"20240612093212-icoekvu","Type":"NodeParagraph","Properties":{"id":"20240612093212-icoekvu","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612093212-2kkrwq9","Type":"NodeParagraph","Properties":{"id":"20240612093212-2kkrwq9","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240612093212-fyymqab","Type":"NodeParagraph","Properties":{"id":"20240612093212-fyymqab","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612093212-6a836xa","Type":"NodeParagraph","Properties":{"id":"20240612093212-6a836xa","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 药材基源：为木兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"厚朴"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"庐山厚朴"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枝皮"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612093212-ykolwtw","Type":"NodeParagraph","Properties":{"id":"20240612093212-ykolwtw","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Magnolia officinalis Rehd.et Wils．2．Magnolia officinalis Rehd.et Wils．Var．BilobaRehd．Et Wils．［M．Biloba（Rehd．Et Wils．） Cheng」"}]},{"ID":"20240612093212-gxxafpw","Type":"NodeParagraph","Properties":{"id":"20240612093212-gxxafpw","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植20年以上即可砍树剥皮，宜在4～8月生长盛期进行。根皮和枝皮直接阴干或卷筒后干燥，称根朴和枝朴；于皮可环剥或条剥后，卷筒置沸水中烫软后，埋置阴湿处发汗。待皮内侧或横断面都变成紫褐色或棕褐色，并现油润或光泽时，将每段树皮卷成双筒，用竹蔑扎紧，削齐两端，曝晒干燥即成。"}]},{"ID":"20240612093212-n5b02la","Type":"NodeParagraph","Properties":{"id":"20240612093212-n5b02la","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612093212-m4z8dux","Type":"NodeParagraph","Properties":{"id":"20240612093212-m4z8dux","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.喜生于温凉湿润气候和排水良好的酸性土壤。"}]},{"ID":"20240612093212-84hu2po","Type":"NodeParagraph","Properties":{"id":"20240612093212-84hu2po","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.生于山坡山麓及路旁溪边的杂木林中。"}]},{"ID":"20240612093212-umvfo45","Type":"NodeParagraph","Properties":{"id":"20240612093212-umvfo45","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于陕西、甘肃、浙江、江西、湖北、湖南、四川、贵州等地。现在有些地区已多栽培。"}]},{"ID":"20240612093212-jsil7pe","Type":"NodeParagraph","Properties":{"id":"20240612093212-jsil7pe","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.分布于安徽、浙江、江西、福建、湖南。现已有栽培。"}]},{"ID":"20240612093212-73d28hu","Type":"NodeParagraph","Properties":{"id":"20240612093212-73d28hu","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612093212-y98d5yi","Type":"NodeParagraph","Properties":{"id":"20240612093212-y98d5yi","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 1.落叶乔木，高5-15m。树皮紫褐色，小枝粗壮，淡黄色或灰黄色。冬芽粗大，圆锥形，芽鳞被浅黄色绒毛。叶柄粗壮，长2.5-4cm，托叶痕长约为叶柄的2/3。叶近革质，大形，叶片7-9集生枝顶，长圆状倒卵形，长22-46cm,宽15-24cm，先端短尖或钝圆，基部渐狭成楔形，上面绿色，无毛，下面发绿色，被灰色柔毛。花单生，芳香，直径10-15cm，花被9-12或更多，外轮3片绿色，盛开时向外反卷，内两轮白色，倒卵状匙形；雄蕊多数，长2-3cm，花丝红色；雌蕊多数，分离。聚合果长圆形，长9-15cm，（艹骨）（廿突）果具2-3mm的喙。种子三角状倒卵形，外种皮红色。花期4-5月，果期9-10月。"}]},{"ID":"20240612093212-yzpfboa","Type":"NodeParagraph","Properties":{"id":"20240612093212-yzpfboa","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.本种与厚朴十分相似，主要区别是，本种叶先端凹缺成2个钝圆的浅裂片。聚合果基部较窄。花期4-5月，果期9-10月。"}]},{"ID":"20240612093212-d3kpuuk","Type":"NodeParagraph","Properties":{"id":"20240612093212-d3kpuuk","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612093212-n2dex1t","Type":"NodeParagraph","Properties":{"id":"20240612093212-n2dex1t","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 1．厚朴 生物学特性 喜温和湿润气候，怕炎热，能耐寒。幼苗怕强光，成年树宜向阳。以选疏松肥沃，富含腐殖质，呈中性或微酸性粉砂质壤土栽培为宜。山地黄壤、黄红壤也可栽种。"}]},{"ID":"20240612093212-v0wd3qk","Type":"NodeParagraph","Properties":{"id":"20240612093212-v0wd3qk","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、压条和扦插繁殖。种子繁殖：在9-10月或10～11月采收成熟果实，即可播种，或用湿砂贮藏至春季播种。播种前应浸种48h后，用砂搓去蜡质层。条播为主，行距30cm×33cm，按粒距3～6cm，将种子播于沟内，并覆土盖草。每1hm2用种量150～225kg。苗期要经常除草，每年追肥1-2次，多雨季节要防积水，并搭棚遮荫。压条繁殖：在11月上旬或2月选择生长10年以上成年树的苗蘖，横割断蘖茎一半，向切口相反方向弯曲使茎纵裂，在裂缝中夹一小石块，培土覆盖。次年生多数根后割下定植。扦插繁殖：2月选茎粗1cm的1～2年生枝条，剪成长约20cm的插条，扦插于苗床中培育。繁殖的幼苗，均于2～3月或10～11月落叶后定植，按株行距3mX4m或3mX3m开穴，每穴栽苗1株。"}]},{"ID":"20240612093212-31ubtdb","Type":"NodeParagraph","Properties":{"id":"20240612093212-31ubtdb","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"田间管理 幼树每年中耕除草2次。林地郁闭后一般仅冬季中耕除草、培土1次。结合中耕除草进行追肥，可施人畜粪肥、厩肥、堆肥等。"}]},{"ID":"20240612093212-1wma0q1","Type":"NodeParagraph","Properties":{"id":"20240612093212-1wma0q1","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有叶枯病，喷1：1：100波尔多液防治；根腐病、立枯病，可拔除病株，病穴用石灰消毒，还可喷50％托布津1000信液防治。虫害有褐天牛，可捕杀成虫。"}]},{"ID":"20240612093212-5g2s8zt","Type":"NodeParagraph","Properties":{"id":"20240612093212-5g2s8zt","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2．庐山厚朴 性喜温暖，耐炎热能力比厚朴强，生长也较快，又能耐寒。土壤以疏松肥沃，富含腐殖质较多，呈中性或微酸性粉砂质壤上为宜。种子繁殖为主，也可压条、扦插繁殖。余同“厚朴”。"}]},{"ID":"20240612093212-710v6h0","Type":"NodeParagraph","Properties":{"id":"20240612093212-710v6h0","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612093212-st1uk0z","Type":"NodeParagraph","Properties":{"id":"20240612093212-st1uk0z","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 干皮呈卷筒状或双卷筒状，长30-35cm，厚2-7mm，习称“筒朴”；近根部的干皮一端展开如喇叭口，习称“靴筒朴”。外表面灰棕色或灰褐色，粗糙，栓皮呈鳞片状，较易剥落，有明显的椭圆形皮孔和纵皱纹，刮去栓皮者显黄棕色；内表面紫棕色或深紫褐色，具细密纵纹，划之显油痕。质坚硬，不易折断。断面颗粒性，外层灰棕色，内层紫褐色或棕色，有油性，有的可见多数小亮星。气香，味辛辣，微苦。"}]},{"ID":"20240612093212-a3tqymi","Type":"NodeParagraph","Properties":{"id":"20240612093212-a3tqymi","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"根皮（根朴）为主根及支根的皮，厚3-5mm，形状不一，有卷筒状、片块状、羊耳状等；细小很皮形弯曲如鸡肠，习称“鸡肠朴”。外表面灰黄色或灰褐色色。质稍坚硬，较易折断，断面纤维性。枝皮（枝朴）呈单筒状，长10-20cm，厚1-2mm。外表面灰褐色，内表面黄棕色。质脆，易折断，断面纤维性。"}]},{"ID":"20240612093212-1utnlnd","Type":"NodeParagraph","Properties":{"id":"20240612093212-1utnlnd","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"均以皮厚、肉细、油性大，断面紫棕色、有小亮星、气味浓厚者为佳。"}]},{"ID":"20240612093212-wijzki5","Type":"NodeParagraph","Properties":{"id":"20240612093212-wijzki5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"显微鉴别 树皮横切面：木栓层为10余列木柱细胞，有时可见落皮层。皮层外侧有石细胞环带，内侧散有石细胞群及多数油细胞，油细胞切向延长，长约至140μm，有的石细胞呈分枝状；纤维束稀少。韧皮部占绝大部分，韧皮射线宽1-3列细胞，向外渐变宽；纤维束众多，略切向断续排列成层；壁极厚；油细胞颇多，单个散在或2-5个相连。本品薄壁细胞含黄棕色物、淀粉粒（多糊化），并有少数草酸钙小方晶。"}]},{"ID":"20240612093212-x4oh9c6","Type":"NodeParagraph","Properties":{"id":"20240612093212-x4oh9c6","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"枝皮横切面：韧皮部外侧具大型纤维束（多达400多个细胞），即中柱鞘纤维束。"}]},{"ID":"20240612093212-cmc7evv","Type":"NodeParagraph","Properties":{"id":"20240612093212-cmc7evv","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"粉末特征：粉末棕色。（1）厚朴①石细胞甚多，呈长圆形、类方形者直径11-40μm，呈不规则分枝状者长约220μm，有的分枝短而钝圆，有的分枝长而锐尖。②纤维众多，平直，直径15-32μm，壁极厚，木化，纹孔沟不明显。③油细胞椭圆形或类圆形，直径64-80μm，壁木化，腔内含黄棕色油滴状物。此外，有筛管分子、木栓细胞及草酸钙小方晶。"}]},{"ID":"20240612093212-y2sn4l8","Type":"NodeParagraph","Properties":{"id":"20240612093212-y2sn4l8","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（2）庐山厚朴 分枝状石细胞长约至326μm，纤维边缘作锯齿状者较易见；油细胞较少见，直径约至100μm。"}]},{"ID":"20240612093212-7d6tmqq","Type":"NodeParagraph","Properties":{"id":"20240612093212-7d6tmqq","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粗粉3g，加氯仿30ml，回流30min，滤过。滤液供试：①取氯仿液5ml置试管中，在荧光灯下顶面观显紫色，侧面观上面黄绿色，下面棕色；②取氯仿液15ml，蒸去氯仿，残渣加95％乙醇10ml溶解，滤过，分别取滤液各1ml，加5％三氯化铁甲醇溶液（1：1）1滴，显蓝黑色（厚朴酚的酞羟基反应）；加Millon试剂1滴，显棕色沉淀（同上反应）；加间苯三酚盐酸溶液5滴，显红色沉淀（厚朴酚的烯丙基反应）。"}]},{"ID":"20240612093212-9gx410c","Type":"NodeParagraph","Properties":{"id":"20240612093212-9gx410c","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（2）薄层色谱 取本品粉末0．5g，加甲醇5ml，密塞，振摇30min，滤过。滤液作为供试品溶液。另取厚朴酚与和厚朴酚对照品，加甲醇制成每1ml各含1mg的混合溶液，作为对照品溶液。取上述两种溶液各5μl，分别点样于同一硅胶G板上,以苯-甲醇（27：1）展开15cm，取出，晾干，喷10％香草醛硫酸试液，在100℃烘约10min，供试品色谱中，在与对照品色谱相应的位置上显相同颜色的斑点。"}]},{"ID":"20240612093212-bby2rd8","Type":"NodeParagraph","Properties":{"id":"20240612093212-bby2rd8","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"品质标志《中华人民共和国药典》1995年版规定：本品按干燥品计算，含厚朴酚、和厚朴酚的总量不得少于3．0％。"}]},{"ID":"20240612093212-do53oh1","Type":"NodeParagraph","Properties":{"id":"20240612093212-do53oh1","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"商品规格（1）温朴筒朴卷成单筒或双筒，两端平齐。表面灰棕色或灰褐色，有纵皱纹，内面深紫色或紫棕色，平滑。质坚硬，断面外侧灰褐色，内侧紫棕色，颗粒状。一、二、三等筒长40cm，重分别为800g以上，500g以上，200g以上；四等为不符合以上规格者，以及碎片、枝林。"}]},{"ID":"20240612093212-5ub0za6","Type":"NodeParagraph","Properties":{"id":"20240612093212-5ub0za6","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（2）川朴筒朴 卷成单筒或双筒状，两端平齐。表面黄棕色，有细密纵纹，内面紫棕色，平滑，划之显油痕。断面外侧黄棕色，内面紧棕色，显油润，纤维少。一、二等简长40-43cm，重分别为500g以上，200g以上；三等筒40cm，重不少于100g;四等为不符合以上规格者，以及碎片、枝朴。"}]},{"ID":"20240612093212-p15yt41","Type":"NodeParagraph","Properties":{"id":"20240612093212-p15yt41","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（3）蔸朴（靴筒朴）为靠近根部的干皮和根皮，似靴形，上端呈筒状，下端喇叭状。表面粗糙，灰棕色或灰褐色，内面深紫色，显油润。断面紫棕色，颗粒状，纤维不明显。一、二、三等块长70cm以上，重分别为12000g以上，2000g以上，500g以上。"}]},{"ID":"20240612093212-q3jkfp2","Type":"NodeParagraph","Properties":{"id":"20240612093212-q3jkfp2","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（4）耳朴 为靠近根部的干皮，块片状或半卷形，多似耳状。表面灰棕色或灰褐色，内面淡紫色。断面紫棕色，显油润，纤维性少。大小不一。"}]},{"ID":"20240612093212-6heniks","Type":"NodeParagraph","Properties":{"id":"20240612093212-6heniks","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"（5）根朴 卷筒状长条。表面土黄色或灰褐色。内面深紫色。质韧，断面油润。一等条长70cm，重400g以上，无木心、须根；二等长短不分，重400g以下。"}]},{"ID":"20240612093212-g604acl","Type":"NodeParagraph","Properties":{"id":"20240612093212-g604acl","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612093212-7ydaobt","Type":"NodeParagraph","Properties":{"id":"20240612093212-7ydaobt","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 1．厚朴 树皮含木脂体类化合物：厚朴酚（magnolol），和厚朴酚（honokiol），和厚朴新酚（obovatol），6’-O-甲基和厚朴酚（6’－O-methylhonokiol），厚朴醛（magnaldehyde）B、C,厚朴木脂体（magnolignan）A、B、C、D、E及台湾檫木醛（randainal）；单萜木脂体类化合物：辣薄荷基厚朴酚（piperitylmagnolol),双辣薄荷基厚朴酚（dipiperitylmagnolol），辣薄荷基和厚朴酚（piperitylhonokiol）及龙胞基厚朴酚（bornylmagnolol）；降木脂体类化合物：台湾檫木酚（randiol），厚朴三酚（magnatriol）B,厚朴醛D、E；双木脂体类化合物：厚朴木脂体F、G、H及I［1］；生物碱：木兰箭毒碱（magnocurarine）和柳叶木兰碱（salicifoline）[2]；挥发油:含30多种成分，主要的有β-桉叶醇（β-eudesmol）17．4％，荜澄茄醇（cadinol）14．6％，愈创（艹奥）醇（guaiol）8．7％，对-聚伞花素（p-cymene）7．8％，1，4-桉叶素（1，4-cineol）5．6％，丁香烯（caryophel-lene）5．0％，芳樟醇（linalool）4．6％，α-松油烯（α-terpineol）4．5％,α-葎草烯（α-humulene）3．9％，4-松油烯醇（4－terpinenol）3．4％，蓝桉醇（globulol）3．1％及α-柠檬烯（α-limonene）3．0％[3]等。还含芥子醛（sinapicaldehyde），丁香树脂酚（syringaresinol），丁香树脂酚-4’－O-β-D-吡喃葡萄糖甙（syringaresinol-4′-O-β-D-glucopyra-noside）及1-(4-羟基-3-甲氧基苯基）-2-〔4-（ω-羟丙基）-2-甲氧基苯氧基]-1，3-丙二醇"}]},{"ID":"20240612093212-tcid9d7","Type":"NodeParagraph","Properties":{"id":"20240612093212-tcid9d7","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612093212-lntqchm","Type":"NodeParagraph","Properties":{"id":"20240612093212-lntqchm","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用 厚朴的乙醚和甲醇提取物对致龋菌变形链球菌(Streptococusmatuans)有强抗菌作用，其抗菌活性成分确定为厚朴酚与和厚朴酚。两者对变形链球菌的最低抑菌浓度(MIC)为6.3μg /ml，其抗菌作用(对变形链球菌)比黄连素更强。厚朴的初提成分厚朴碱与厚朴挥发油饱和水溶液对金黄色葡萄球菌、八叠球菌和枯草杆菌有一定的抑菌作用。厚朴对肺炎双球菌和痢疾杆菌也有抗菌活性。"}]},{"ID":"20240612093212-2az9k04","Type":"NodeParagraph","Properties":{"id":"20240612093212-2az9k04","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.对消化道作用 厚朴碱在0.1-1ml(10mg/ml)范围内使离体兔十二指肠张力逐渐升高，至1.5ml时，肌张力逐渐抑制，频率减慢，至2.5ml时肠肌收缩活动完全停止。厚朴醇提物抗大鼠Hcl-乙醇溃疡作用大鼠体重200g，给药组口服厚朴50%乙醇提取物，同时设对照组，给药l小时后，给予Hcl-乙醇15%甲醇，l小时后处死动物。以粘膜部发生的溃疡长度(mm)合计值作为溃疡指数，与对照组比较。结果给药组对胃粘膜溃疡呈显着抑制作用，其活性成分之一确定为和厚朴酚与厚朴酚。采用水浸刺激法造成大鼠的应激性急性胃溃疡，用胃内灌流法测定大鼠胃液分泌，测定在人工胃液灌流条件下应激负荷大鼠的胃出血，结果表明厚朴酚具有防止应激性胃功能障碍的作用。"}]},{"ID":"20240612093212-65jgerw","Type":"NodeParagraph","Properties":{"id":"20240612093212-65jgerw","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"3．血小板聚集的抑制作用：厚朴酚与和厚朴酚抑制胶原和花生四烯酸诱导的兔富血小板血浆的聚集和ATP释放，洗过的血小板聚集比富血小板血浆的聚集更明显被抑制。全血的聚集较少被这两个抑制剂影响。厚朴酚与和厚朴酚在各种情况下抑制血栓烷B2形成，由花生四烯酸或胶原引起的细胞内Ca升高也被两者抑制。厚朴酚与和厚朴酚的抗血小板作用是由于对血栓烷B2和细胞内Ca流动的抑制。"}]},{"ID":"20240612093212-fp925xb","Type":"NodeParagraph","Properties":{"id":"20240612093212-fp925xb","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"4．对中枢神经系统作用： 厚朴碱对横纹肌有松弛作用。 静脉注射使兔垂头剂量为13.8mg/kg，用同剂量反复给于家兔静注，其肌松作用并不减弱，提示无快速耐受现象。在大鼠的膈神经-膈肌标本试验中，30%厚朴碱可使膈肌收缩幅度减小40%左右，当浓度增高至40%时，膈肌收缩幅度几近停止状态。小鸡静脉注射厚朴碱40mg/kg以上时，呈弛缓性瘫痪，其作用与静脉注射筒箭毒碱(0.5mg/只)相似，表明厚朴碱可能属于非去极化型的肌肉松弛剂。本品所含的厚朴酚和异厚朴酚具有中枢性肌肉松弛作用。较大剂量时，可使小鼠的翻正反谢消失。在小鸡脊髓反谢试验中，厚朴酚和异厚朴酚腹腔注射均能明显抑制伸肌反射，此作用可被大剂量士的宁所拮抗，认为它们属于非箭毒样的肌松剂且其作用比美乃新(Mephenesin)力强，表明厚朴酚与异厚朴酚具有特殊而持久的肌肉松弛活性。在青蛙身上厚朴酚通过腹侧脊髓动脉时，仅使前根反谢电位徐徐下降，而后根电位几乎无影响。厚朴酚与脊髓抑制性传导物质 GABA及兴奋性传导物质的前体谷氨酸之间的相互作用表明，厚朴酚能显着地抑制谷氨酸的作用，而对GABA无作用。表明厚朴酚在脊髓中通过与递质的相互作用而发挥其作用，且特异性很高，具有独特的作用机理。小鼠分别腹腔注射及口服厚朴乙醚提取物，通过金属网悬垂法很易检出握力降低；通过鸡雏交叉性伸展反射检出有抑制脊髓反射的作用，表明有中枢性肌松作用。厚朴乙醚提取物对于由士的宁、印防己毒素、戊四唑等药物诱发的痉挛有强烈的抑制作用。厚朴乙醚提取物对自发脑电波显示比较缓和的慢波化作用，特别是在皮层电图中看到梭形波出现。在刺激脑干网状结构或丘脑下前部的觉醒反应中刺激阈值上升，表明对脑干网状激活系统及丘脑下部激活系统有抑制作用。厚朴酚与和厚朴酚还对脊髓反射有强烈的抑制作用。兔垂头实验兔3只，自耳静脉慢慢推注厚朴生物碱的碘甲烷化合物的生理盐水溶液(40mg/ml)，发生兔垂头反应即停，平均垂头剂量力330mg/kg。推注到1/3剂量时出现大量流涎，静脉注射甲基硫酸新斯的明注射液可对抗该反应，与肌松剂锡生藤碱药理作用有近似之处。"}]},{"ID":"20240612093212-i47mupw","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612093212-i47mupw","updated":"20240612093212"},"Children":[{"ID":"20240612093212-9wlm9le","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20240612093212-9wlm9le","updated":"20240612093212"},"Children":[{"ID":"20240612093212-ubrlld2","Type":"NodeParagraph","Properties":{"id":"20240612093212-ubrlld2","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"降血压作用：猫(体重2.1-2.7kg)l只，静脉注射厚朴碱3mg/kg，血压下降约20mmHg，持续约10分钟。"}]}]},{"ID":"20240612093212-fdget7v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240612093212-fdget7v","updated":"20240612093212"},"Children":[{"ID":"20240612093212-jojcysf","Type":"NodeParagraph","Properties":{"id":"20240612093212-jojcysf","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"冰片基厚朴酚有抗变态反应作用。"}]}]}]},{"ID":"20240612093212-zygq8io","Type":"NodeParagraph","Properties":{"id":"20240612093212-zygq8io","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"7．厚朴甲醇提取物和厚朴酚对体内二期致癌试验引起的小鼠皮肤肿瘤有明显的抑制作用。"}]},{"ID":"20240612093212-vg3xugq","Type":"NodeParagraph","Properties":{"id":"20240612093212-vg3xugq","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612093212-askc4go","Type":"NodeParagraph","Properties":{"id":"20240612093212-askc4go","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 厚朴：用水浸泡捞出，润透后刮去粗皮，洗净，切丝，晾干。姜厚朴：取生姜切片煎汤，加净厚朴，与姜汤共煮透，待汤吸尽，取出，及时切片，晾干。(每厚朴100斤，用生姜10斤)《雷公炮炙论》：凡使厚朴，要用紫色味辛为好，或丸散，便去粗皮，用酥炙过。每修一斤，用酥四两，炙了细锉用；若汤饮中使，用自然姜汁八两炙，一升为度。"}]},{"ID":"20240612093212-s7jzkjo","Type":"NodeParagraph","Properties":{"id":"20240612093212-s7jzkjo","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612093212-g8pt9oc","Type":"NodeParagraph","Properties":{"id":"20240612093212-g8pt9oc","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 1.取本品粗粉3g， 加氯仿30ml， 回流半小时，滤过，滤液供作以下试验：1.1.取氯仿液5ml置试管中，在荧光灯下顶面观现紫色，侧面观上面黄绿色，下面棕色。"}]},{"ID":"20240612093212-i9wh5j5","Type":"NodeParagraph","Properties":{"id":"20240612093212-i9wh5j5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"1.2.取氯仿液15ml，蒸去氯仿，残渣加95%乙醇10ml溶解，滤过，分别取滤液各1ml，加5%三氯化铁甲醇水溶液(1：1)滴，现蓝黑色(厚朴酚的酚羟基反应)；加Millon试剂1滴，现棕色沉淀(同上反应)；加间苯三酚盐酸溶液5滴，现红色沉淀(厚朴酚的烯丙基反应)。"}]},{"ID":"20240612093212-ej3e672","Type":"NodeParagraph","Properties":{"id":"20240612093212-ej3e672","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.薄层层析：取粉末0.5，加甲醇5ml，振摇30分钟，滤过，滤液供试。另取厚朴酚及和厚朴酚对照品，加甲醇溶解，制成每毫升各含1mg的混合液作对照。取上述两种溶液各5μl，分别点于同一硅胶G板上，以苯-甲醇(27：1)展开15cm，取出，晾干，喷雾1%香草醛硫酸试液，100℃烘约10分钟，供试品色谱在与对照品色谱相应的位置上显相同色斑。"}]},{"ID":"20240612093212-k7trudf","Type":"NodeParagraph","Properties":{"id":"20240612093212-k7trudf","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612093212-ap6vql3","Type":"NodeParagraph","Properties":{"id":"20240612093212-ap6vql3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 脾；胃；大肠经"}]},{"ID":"20240612093212-i8362jy","Type":"NodeParagraph","Properties":{"id":"20240612093212-i8362jy","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612093212-4frfa9x","Type":"NodeParagraph","Properties":{"id":"20240612093212-4frfa9x","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 苦；辛；性温"}]},{"ID":"20240612093212-a3n3h35","Type":"NodeParagraph","Properties":{"id":"20240612093212-a3n3h35","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612093212-gtf6p6p","Type":"NodeParagraph","Properties":{"id":"20240612093212-gtf6p6p","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240612093212-e6n5tt2","Type":"NodeParagraph","Properties":{"id":"20240612093212-e6n5tt2","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：干姜为之使。恶泽泻、寒水石、消石。"}]},{"ID":"20240612093212-k4a2sa3","Type":"NodeParagraph","Properties":{"id":"20240612093212-k4a2sa3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：忌豆，食之者动气。"}]},{"ID":"20240612093212-jhpes6a","Type":"NodeParagraph","Properties":{"id":"20240612093212-jhpes6a","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"3.《品汇精要》：妊娠不可服。"}]},{"ID":"20240612093212-bvkue54","Type":"NodeParagraph","Properties":{"id":"20240612093212-bvkue54","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：凡呕吐不因寒痰冷积，而由于胃虚火气炎上；腹痛因子血虚脾阴不足，而非停滞所致；泄泻因于火热暴注，而非积寒伤冷；腹满因于中气不足、气不归元，而非气实壅滞；中风由于阴虚火炎、猝致僵仆，而非西北真中寒邪；伤寒发热头疼，而无痞塞胀满之候；小儿吐泻乳食，将成慢惊；大人气虚血槁，见发膈证；老人脾虚不能运化，偶有停积；妊妇恶阻，水谷不入；娠妇胎升眩晕、娠妇伤食停冷；娠妇腹痛泻利；娠妇伤寒伤风；产后血虚腹痛；产后中满作喘；产后泄泻反胃，以上诸证，法所咸忌。"}]},{"ID":"20240612093212-vsdpnmr","Type":"NodeParagraph","Properties":{"id":"20240612093212-vsdpnmr","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612093212-38aaiiz","Type":"NodeParagraph","Properties":{"id":"20240612093212-38aaiiz","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 行气消积；燥湿除满；降逆平喘。主食积气滞；腹胀便秘；湿阻中焦，脘痞吐泻；痰壅气逆；胸满喘咳"}]},{"ID":"20240612093212-73x0jvb","Type":"NodeParagraph","Properties":{"id":"20240612093212-73x0jvb","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612093212-zf5qpl6","Type":"NodeParagraph","Properties":{"id":"20240612093212-zf5qpl6","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。"}]},{"ID":"20240612093212-7tit8s4","Type":"NodeParagraph","Properties":{"id":"20240612093212-7tit8s4","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612093212-7vtr9sm","Type":"NodeParagraph","Properties":{"id":"20240612093212-7vtr9sm","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" ①治腹满痛大便闭者：厚朴八两，大黄四两，枳实五枚。上三味，以水一斗二升，先煮二味，取五升，内大黄煮取三升。温服一升，以利为度。(《金匮要略》厚朴三物汤)②治久患气胀心闷，饮食不得，因食不调，冷热相击，致令心腹胀满：厚朴火上炙令干，又蘸姜汁炙，直待焦黑为度，捣筛如面。以陈米饮调下二钱匕，日三服。亦治反胃，止泻。(《斗门方》)③治脾胃气不和，不思饮食：厚朴(去粗皮，姜汁涂，炙令香净)二两半，甘草(炙)一两半，苍术(米泔水浸二日，刮去皮)四两，陈皮(去白)二两半，上四味，为末。每服一钱，水一盏，入生姜、枣子同煎七分，去滓温服，空心服之。或杵细末，蜜为丸，如梧桐子大。每服十丸，盐汤嚼下，空心服。(《博济方》平胃散)④治因喜怒悲思忧恐惊之气，痰涎郁结，状如破絮，或如梅核，在咽喉之间，咯不出，咽不下，或中脘痞满，气不舒快，或痰涎壅盛，上气喘急，或因痰饮中结，呕逆恶心：紫苏叶二两，厚朴三两，茯苓四两，半夏五两。上细切。每服四钱，水盏半，生姜七片，枣一个，煎至六分，去滓，热服，不拘时候，(《易简方》四七汤即《金匮要略》半夏厚朴汤)⑤治虫积：厚朴、槟榔各二钱，乌梅二个。水煎服。(《保赤全书》)⑥治中寒洞泄：干姜、厚朴等分。上为末，蜜丸梧子大。任下三十丸。(《鲍氏小儿方》)⑦治水谷痢久不瘥：厚朴三两，黄连三两。锉，水三升，煎取一升。空心细服。(《梅师集验方》)"}]},{"ID":"20240612093212-wcasr7g","Type":"NodeParagraph","Properties":{"id":"20240612093212-wcasr7g","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612093212-kmamcj3","Type":"NodeParagraph","Properties":{"id":"20240612093212-kmamcj3","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 1.治疗阿米巴痢疾： 据46例观察，用药3-9天后，有43例获愈，2例进步，1例无效。治愈者绝大多数在3天左右临床症状即基本消失。平均腹痛消失时间为3.8天，大便成形、粘液血便消失为2.7天，大便次数恢复正常为3.2天，里急后重消失为3天，大便镜检恢复正常为4.5天。但对阿米巴原虫是否有杀灭作用，尚待证实。治后有2例复发，仍以原法治愈。用法：将川厚朴制成煎剂内服，每次20ml(相当于生药2钱)，每日2次，对脱水及中毒症状严重者应酌情补液及维持电解质平衡，副作用：少数患者有轻微耳鸣及便秘，不影响治疗。"}]},{"ID":"20240612093212-fsajrpv","Type":"NodeParagraph","Properties":{"id":"20240612093212-fsajrpv","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.用于制止针麻下全子宫切除术的鼓肠现象： 试用厚朴粉于术前12小时1次吞服，体重50kg以下者5-7.5g，50kg以上者7.5-10g。按此剂量用于36例手术，结果仅1例在手术过程中肠曲鼓出，使手术无法进行而改用硬膜外麻醉，其余在切开腹膜后肠曲不鼓，少数轻度鼓起，但轻轻一推即可将肠曲推上。术后一般在24-36小时间有肛门排气现象出现，自诉无其他不适。"}]},{"ID":"20240612093212-e0fau87","Type":"NodeParagraph","Properties":{"id":"20240612093212-e0fau87","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612093212-wn8xpo7","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612093212-wn8xpo7","updated":"20240612093212"},"Children":[{"ID":"20240612093212-04taa8e","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612093212-04taa8e","updated":"20240612093212"},"Children":[{"ID":"20240612093212-8odn49r","Type":"NodeParagraph","Properties":{"id":"20240612093212-8odn49r","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"李杲：厚朴，苦能下气，故泄实满；温能益气，故能散湿满。"}]}]}]},{"ID":"20240612093212-rpi2td1","Type":"NodeParagraph","Properties":{"id":"20240612093212-rpi2td1","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"2.《汤液本草》：《本经》云厚朴治中风、伤寒头痛，温中益气，消痰下气，厚肠胃，去腹胀满。果泄气乎？果益气乎？若与枳实、大黄同用，则能泄实满，《本经》谓消痰下气者是也。若与橘皮、苍术同用，则能除湿满，《本经》谓温中益气者是也。与解利药同用，则治伤寒头痛。与治痢药同用，则厚肠胃。大抵若温，用苦则泄，用温则补。"}]},{"ID":"20240612093212-9drglw1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612093212-9drglw1","updated":"20240612093212"},"Children":[{"ID":"20240612093212-4j6mjxr","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240612093212-4j6mjxr","updated":"20240612093212"},"Children":[{"ID":"20240612093212-0djmapr","Type":"NodeParagraph","Properties":{"id":"20240612093212-0djmapr","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"朱震亨：厚朴，气药也。温而能散，消胃中之实也。厚朴能治腹胀，因其味辛以提其气。"}]}]}]},{"ID":"20240612093212-16fce5l","Type":"NodeParagraph","Properties":{"id":"20240612093212-16fce5l","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：厚朴，主中风、伤寒头痛、寒热，气血痹死肌者，盖以风寒外邪，伤于阳分，则为寒热头痛；风寒湿入腠理，则气血凝涩而成痹，甚则肌肉不仁，此药辛能散结，苦能澡湿，温热能祛风寒，故悉主之也。《别录》又主温中、消痰、下气，疗霍乱，及腹痛胀满，胃中冷逆，胸中呕不止，泄痢心烦满者，何莫非肠胃气逆壅滞，及痰饮留结，饮食生冷所致？得此下泄开通，温热暖肾，则诸证不求其止而止矣。至于淋露，虽属下焦为病，然多因胃家湿热下流；三虫亦肠胃湿热所生，苦能燥湿杀虫，故亦主之也。《本经》又主惊悸，及《别录》除惊去留热者，皆非其所宜。惊悸属心虚，于脾胃绝无相干，气味大温之药，又岂能去留热哉，至益气厚肠胃，盖亦指邪气去正气自益之谓，积滞消肠胃自厚之意耳，非消散之外，复有补益之功也，用者详之。厚朴气味辛温，性复大热，其功长于泄结散满，温暖脾胃，一切饮食停积，气壅暴胀，与夫冷气、逆气、积年冷气入腹，肠鸣，虚吼，痰饮吐沫，胃冷呕逆，腹痛泄泻及脾胃壮实之人，偶感风寒，气实人误服参、耆致成喘胀，诚为要药。然而性专消导，散而不收，略无补益之功。"}]},{"ID":"20240612093212-2r2n3i0","Type":"NodeParagraph","Properties":{"id":"20240612093212-2r2n3i0","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"5.《本草汇言》：厚朴，宽中化滞，平胃气之药也。凡气滞于中，郁而不散，食积于胃，羁而不行，或湿郁积而不去，湿痰聚而不清，用厚朴之温可以燥湿，辛可以清痰，苦可以下气也。故前古主中风、伤寒头痛寒热，呕逆泻利，虫积痞积，或肺气胀满，痰涎喘嗽，或胃气壅滞，水谷不行，用此消食化痰，去湿散胀，平土、金二脏，以致于中和也。"}]},{"ID":"20240612093212-dn293ou","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612093212-dn293ou","updated":"20240612093212"},"Children":[{"ID":"20240612093212-933uut3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240612093212-933uut3","updated":"20240612093212"},"Children":[{"ID":"20240612093212-v2o1eki","Type":"NodeParagraph","Properties":{"id":"20240612093212-v2o1eki","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"沈孔庭云：厚朴辛苦温燥，入脾胃二经，散滞调中，推力首剂。然配他药，无往不可，与枳实、大黄同用，则泄实满，故大柴胡汤用之；与陈皮、苍术同用，则除湿满，故平胃散用之；与人参、白术、麦蘖同用，则治虚满，故调中汤用之；又同半夏、胆星，能燥湿清痰；同甘草、白术，能和中健胃；同枳壳、莱卜子能下气宽肠；同紫苏、前胡能发散风寒；同山查、枳实能疏气消食；同吴萸、肉桂能行湿燥阴，实有理气行气之功。但气之盛者，用无不验，气之弱者，宜少用之。"}]}]}]},{"ID":"20240612093212-v3366rl","Type":"NodeParagraph","Properties":{"id":"20240612093212-v3366rl","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"7.《本草经读》：厚朴，气味厚而主降，降则温而专于散，苦而专于泄，故所主皆为实症。中风有便溺阻隔症，伤寒有下之微喘症，有发汗后腹胀满症，大便鞕症，头痛有浊气上冲症，俱宜主以厚朴也。至于温能散寒，苦能泄热，能散能泄，则可以解气逆之惊悸。能散则气行，能泄则血行，故可以治气血痹及死肌也。宽胀下气，《经》无明文，仲景因其气味苦温而取用之，得《本经》言外之旨也。"}]},{"ID":"20240612093212-uka31hj","Type":"NodeParagraph","Properties":{"id":"20240612093212-uka31hj","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"8.《医学衷中参西录》：厚朴，治胃气上逆，恶心呕哕，胃气郁结胀满疼痛，为温中下气之要药。为其性温味又兼辛，其力不但下行，又能上升外达，故《本经》谓其主中风、伤寒头痛，《金匮》厚朴麻黄汤用治咳而脉浮。与橘、夏并用，善除湿满；与姜、术并用，善开寒痰凝结；与硝、黄并用，善通大便燥结；与乌药并用，善治小便因寒白浊。味之辛者，又能入肺以治外感咳逆；且能入肝，平肝之横恣，以愈胁下掀疼。兼入血分，甄权谓其破宿血，古方治月闭亦有单用立者。诸家多谓其误服能脱元气，独叶香岩谓多用则破气，少用则通阳，诚为确当之论。"}]},{"ID":"20240612093212-l810hwh","Type":"NodeParagraph","Properties":{"id":"20240612093212-l810hwh","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"9.《本经》：主中风伤寒，头痛，寒热惊悸，气血痹，死肌，去三虫。"}]},{"ID":"20240612093212-pgxcnfs","Type":"NodeParagraph","Properties":{"id":"20240612093212-pgxcnfs","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"10.《别录》：温中益气，消痰下气。疗霍乱及腹痛胀满，胃中冷逆及胸中呕不止，泄痢淋露，除惊，去留热心烦满，厚肠胃。"}]},{"ID":"20240612093212-k8gib5s","Type":"NodeParagraph","Properties":{"id":"20240612093212-k8gib5s","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"11.《药性论》：主疗积年冷气，腹内雷鸣，虚吼，宿食不消，除痰饮，去结水，破宿血，消化水谷，止痛。大温胃气，呕吐酸水。主心腹满，病人虚而尿白。"}]},{"ID":"20240612093212-5waxopy","Type":"NodeParagraph","Properties":{"id":"20240612093212-5waxopy","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：健脾。主反胃，霍乱转筋，冷热气，泻膀胱，泄五藏一切气。妇人产前产后腹藏不安。调关节，杀腹藏虫，阴耳目。"}]},{"ID":"20240612093212-245fkpc","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612093212-245fkpc","updated":"20240612093212"},"Children":[{"ID":"20240612093212-2qprukp","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTMu","Num":13},"Properties":{"id":"20240612093212-2qprukp","updated":"20240612093212"},"Children":[{"ID":"20240612093212-5klarkd","Type":"NodeParagraph","Properties":{"id":"20240612093212-5klarkd","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"王好古：主肺气胀满，膨而喘咳。"}]}]}]},{"ID":"20240612093212-g2t467v","Type":"NodeParagraph","Properties":{"id":"20240612093212-g2t467v","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"14.《本草正》：温降，散滞，除寒湿泻痢。"}]},{"ID":"20240612093212-8v5d9t5","Type":"NodeParagraph","Properties":{"id":"20240612093212-8v5d9t5","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612093212-88f7g7a","Type":"NodeParagraph","Properties":{"id":"20240612093212-88f7g7a","updated":"20240612093212"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612093213-ykzue5r","Type":"NodeThematicBreak","Properties":{"id":"20240612093213-ykzue5r"}},{"ID":"20240612093214-8t6c7qu","Type":"NodeParagraph","Properties":{"id":"20240612093214-8t6c7qu"}}]}