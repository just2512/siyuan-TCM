Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 6-20240809140051-u2swqwy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 265px;\" parent-style=\"width: 275px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 436px;","style":"width: 426px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 9-20240809140458-wm384ci.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 426px;\" parent-style=\"width: 436px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮3-20240620160829-qcxrl1m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240617105313-ggw9a4t","Type":"NodeParagraph","Properties":{"id":"20240617105313-ggw9a4t","updated":"20240620160526"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：五加皮是五加植物的干燥根皮。"}]},{"ID":"20240617105347-gi52tx0","Type":"NodeThematicBreak","Properties":{"id":"20240617105347-gi52tx0"}},{"ID":"20240617105419-v05fh7k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105419-v05fh7k","updated":"20240617105422"},"Children":[{"Type":"NodeText","Data":"五加皮《神农本草经》"}]},{"ID":"20240617105419-mg4a5hn","Type":"NodeParagraph","Properties":{"id":"20240617105419-mg4a5hn","updated":"20240617105419"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240617105419-psy15ki","Type":"NodeParagraph","Properties":{"id":"20240617105419-psy15ki","updated":"20240617105419"},"Children":[{"Type":"NodeText","Data":"主心腹疝气，腹痛，益气疗躄，小儿不能行，疸创阴蚀。一名豺漆。"}]},{"ID":"20240617105419-xhetm3c","Type":"NodeParagraph","Properties":{"id":"20240617105419-xhetm3c","updated":"20240617105419"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名豺节，生汉中及冤句，五月十月采茎，十月采根，阴干。"}]},{"ID":"20240617105419-snzpnz1","Type":"NodeParagraph","Properties":{"id":"20240617105419-snzpnz1","updated":"20240617105419"},"Children":[{"Type":"NodeText","Data":"案《大观本草》，引东华真人煮石经云：舜常登苍梧山曰，厥金玉之香草，朕那偃息正道，此乃五加也。鲁定公母，单服五加酒，以致不死。"}]},{"ID":"20240617105719-jl9nv6i","Type":"NodeThematicBreak","Properties":{"id":"20240617105719-jl9nv6i"}},{"ID":"20240617105720-xhq8xk2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105720-xhq8xk2","updated":"20240617105726"},"Children":[{"Type":"NodeText","Data":"五加皮《新修本草》"}]},{"ID":"20240617105720-f99syzm","Type":"NodeParagraph","Properties":{"id":"20240617105720-f99syzm","updated":"20240617105720"},"Children":[{"Type":"NodeText","Data":"味辛、苦，温、微寒，无毒。主心腹疝气，腹痛，益气，疗 小儿不能行，疽疮，阴蚀。"}]},{"ID":"20240617105720-m4kupe1","Type":"NodeParagraph","Properties":{"id":"20240617105720-m4kupe1","updated":"20240617105720"},"Children":[{"Type":"NodeText","Data":"男余沥，女人阴痒及腰脊痛，两脚疼痹风弱，五缓虚羸。补中益精，坚筋骨，强志意。久服轻身耐老。一名豺漆，一名豺节。五叶者良。生汉中及宛朐。五月、七月采茎，十月采根，阴干。"}]},{"ID":"20240617105720-qhab7mv","Type":"NodeParagraph","Properties":{"id":"20240617105720-qhab7mv","updated":"20240617105720"},"Children":[{"Type":"NodeText","Data":"远志为之使，畏蛇脱皮、玄参。今近道处处有，东间弥多，四叶者亦好，煮根茎酿酒，至益人，道家用此作灰，亦以煮石与地榆，并有秘法。加字或作家字者也。"}]},{"ID":"20240617105504-xi9aj6k","Type":"NodeThematicBreak","Properties":{"id":"20240617105504-xi9aj6k"}},{"ID":"20240617105506-mk81hiz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105506-mk81hiz","updated":"20240617105510"},"Children":[{"Type":"NodeText","Data":"五加皮《神农本草经赞》"}]},{"ID":"20240617105506-gq5tfhc","Type":"NodeParagraph","Properties":{"id":"20240617105506-gq5tfhc","updated":"20240617105506"},"Children":[{"Type":"NodeText","Data":"味辛温。主心腹疝气腹痛。益气疗。小儿不能行。疽创阴蚀。一名豺漆。"}]},{"ID":"20240617105506-rx3qf7g","Type":"NodeParagraph","Properties":{"id":"20240617105506-rx3qf7g","updated":"20240617105506"},"Children":[{"Type":"NodeText","Data":"数符天地。五叶交加。麂篱疏密。豺节杈丫。文章作酒。金玉满车。煮盐加豉。固寿无涯。"}]},{"ID":"20240617105506-qvmxlac","Type":"NodeParagraph","Properties":{"id":"20240617105506-qvmxlac","updated":"20240617105506"},"Children":[{"Type":"NodeText","Data":"易。天数五。地数五。李时珍曰。五叶交加者良。苏颂曰。今江淮吴中。往往以为藩篱。"}]},{"ID":"20240617105506-jlzkfrx","Type":"NodeParagraph","Properties":{"id":"20240617105506-jlzkfrx","updated":"20240617105506"},"Children":[{"Type":"NodeText","Data":"陆游诗。疏疏麂眼篱。名医曰。一名豺节。杜甫赋。突杈丫而皆折。巴蜀异物志。名文章草。"}]},{"ID":"20240617105506-o3i8zng","Type":"NodeParagraph","Properties":{"id":"20240617105506-o3i8zng","updated":"20240617105506"},"Children":[{"Type":"NodeText","Data":"赞曰。文章作酒。能成其味。煮石经。孟绰子董士固相与言曰。愿得五加一把。不用金玉满车。唐慎微曰。金盐五加也。玉豉地榆也。煮石而饵长生之药。耿诗。山固寿无涯。"}]},{"ID":"20240617105429-ip0uuq2","Type":"NodeThematicBreak","Properties":{"id":"20240617105429-ip0uuq2"}},{"ID":"20240617105430-elpjttt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105430-elpjttt","updated":"20240617105435"},"Children":[{"Type":"NodeText","Data":"五加皮《本草思辨录》"}]},{"ID":"20240617105430-cag1mqo","Type":"NodeParagraph","Properties":{"id":"20240617105430-cag1mqo","updated":"20240617105430"},"Children":[{"Type":"NodeText","Data":"五加皮茎柔皮脆，用在于根，宜下焦风湿之缓证。若风湿搏于肌表，则非其所司。古方多浸心疝少腹有形为寒，肺热生痿 为热，本经并主之。刘潜江云∶肾肝气虚，故病于湿。"}]},{"ID":"20240617105430-d1f4iu4","Type":"NodeParagraph","Properties":{"id":"20240617105430-d1f4iu4","updated":"20240617105430"},"Children":[{"Type":"NodeText","Data":"湿者阴之淫气也，阴淫则阳不化而为风；风者阳之淫气也，阳淫则阴愈不化而更病于湿。至病湿，固已阴锢阳、阳蚀阴而成湿热矣。按此论甚精。五加皮辛苦而温，惟善化湿耳。化其阴淫之湿，即驱其阳淫之风。风去则热已，湿去则寒除。即别录之疗囊湿、阴痒、小便余沥、腰脚痛痹、风弱、五缓，皆可以是揆之。邹氏以本经之益气，别录之坚筋骨强志意，为身半以上事。实则肾肝受治之益，不必析之为两事也。"}]},{"ID":"20240617105454-8b049zb","Type":"NodeThematicBreak","Properties":{"id":"20240617105454-8b049zb"}},{"ID":"20240617105455-fc73yzb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105455-fc73yzb","updated":"20240617105500"},"Children":[{"Type":"NodeText","Data":"五加皮《增广和剂局方药性总论》"}]},{"ID":"20240617105455-9zh3bnm","Type":"NodeParagraph","Properties":{"id":"20240617105455-9zh3bnm","updated":"20240617105455"},"Children":[{"Type":"NodeText","Data":"味辛苦，温，微寒，无毒。主心腹疝气腹痛，益气疗 ，小儿不能行，疽疮阴蚀，阳痿，囊下湿，女人阴痒及腰脊痛，两脚疼痹风弱，五缓虚羸，补中，益精，坚筋骨，意。《药性论》云∶破逐恶风血，四肢不遂，贼风伤人，软脚， 腰，主多年瘀血在皮治痹湿内不足，主虚羸。日华子云∶明目，下气，治中风骨节挛急，补五劳七伤。叶∶治皮肤风。可作蔬食。远志为之使。畏∶蛇皮、玄参。"}]},{"ID":"20240617105445-a69oi3p","Type":"NodeThematicBreak","Properties":{"id":"20240617105445-a69oi3p"}},{"ID":"20240617105446-hgcxid7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105446-hgcxid7","updated":"20240617105450"},"Children":[{"Type":"NodeText","Data":"五加皮《本草简要方》"}]},{"ID":"20240617105446-ermpwqp","Type":"NodeParagraph","Properties":{"id":"20240617105446-ermpwqp","updated":"20240617105446"},"Children":[{"Type":"NodeText","Data":"主治。祛风。除湿。活血。益精。化痰。补中。强腰膝。壮筋骨逐瘀血。治五劳。七伤。"}]},{"ID":"20240617105446-mw55ghv","Type":"NodeParagraph","Properties":{"id":"20240617105446-mw55ghv","updated":"20240617105446"},"Children":[{"Type":"NodeText","Data":"虚羸。五缓。中风。湿痹。疝气。阴痿。脚软。妇人阴痒。阴蚀。小儿脚弱。皮肤风湿。五加皮丸。五加皮四两。续断（炒）杜仲各二两五钱。川芎独活各三两。狗脊萆芍药诃子肉各四两。研末。蜜丸梧子大。每服四十丸。空腹温酒下。日三次。治妊娠腰痛不可忍。又方。"}]},{"ID":"20240617105446-qe51m1l","Type":"NodeParagraph","Properties":{"id":"20240617105446-qe51m1l","updated":"20240617105446"},"Children":[{"Type":"NodeText","Data":"五加皮远志各四两。酒浸晒干研末。酒糊丸。每服四五十丸。空腹温酒下。治肿湿。五加皮酒。五加皮熟地丹参杜仲（炙）蛇床子干姜各三两。地骨皮二两。天冬一两。钟乳四两。"}]},{"ID":"20240617105446-1ztmdyk","Type":"NodeParagraph","Properties":{"id":"20240617105446-1ztmdyk","updated":"20240617105446"},"Children":[{"Type":"NodeText","Data":"细锉。生绢袋盛。酒一斗五升。渍二宿后滤清。加冰糖一斤八两。每服一大杯。空腹下。治肾气虚寒。小便余沥。妇人阴冷癖瘦。腰膝时痛。及瘫痪拘挛等症。五加皮散。五加皮不拘多少。研末。每服一钱匕。温酒调下。日二夜一服。治水毒溪毒。状如伤寒。又方。五加皮油松节木瓜各等分。研末。每服二三钱。温酒调下。治筋缓。"}]},{"ID":"20240617105347-9vjuev3","Type":"NodeThematicBreak","Properties":{"id":"20240617105347-9vjuev3"}},{"ID":"20240617105409-eh20m2w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105409-eh20m2w","updated":"20240617105414"},"Children":[{"Type":"NodeText","Data":"五加皮《冯氏锦囊秘录》"}]},{"ID":"20240617105409-48yka8c","Type":"NodeParagraph","Properties":{"id":"20240617105409-48yka8c","updated":"20240617105409"},"Children":[{"Type":"NodeText","Data":"在天得少阳之气，为五车星之精；在地得火金之味，故其味辛微苦、微温、无毒。"}]},{"ID":"20240617105409-f5uwkf8","Type":"NodeParagraph","Properties":{"id":"20240617105409-f5uwkf8","updated":"20240617105409"},"Children":[{"Type":"NodeText","Data":"入足少阴、厥阴经，所主风寒湿邪及二经所受之病也。五脏自寒，则筋骨自坚，精气日益而中，自补也。轻身耐老，皆补肝肾之功欤。昔人云∶“宁得一把五加皮，不用金银满车；宁得一斤地榆，安用明月宝珠。”又昔鲁定公母，单服五加酒，以致不死。又东华真人煮石法，用玉豉金盐五豉地俞也，金盐玉加也，世为仙经所须，其能轻身耐老，又可知矣。"}]},{"ID":"20240617105409-g75r4y3","Type":"NodeParagraph","Properties":{"id":"20240617105409-g75r4y3","updated":"20240617105409"},"Children":[{"Type":"NodeText","Data":"五加皮，逐多年瘀血，在皮筋中，驱常痛风痹缠脾，膝里风弱，五缓痿 ，腰脊疼痛虚凝，心腹疝气腹痛，风寒湿邪，并祛小儿骨软行迟，下部恶疮脓癞，坚筋骨，健步，强志意，益精，去女人阴痒难当，扶男子阳痿不举，小便遗沥可止，阴蚀疽疮能除，轻身延年，长生不老，真仙经药也。采叶当疏食，散风疹于一身，根茎煎酒，尝却风痹于四末，肝肾筋骨之要药。辛顺气而化痰，苦坚肾而益精，温祛风而胜湿，逐皮肤之瘀血，疗筋骨之拘挛。茎青节白，花赤皮黄，根黑上应五车星之精，故曰“宁得一把五加，不用金玉满车”，然肝肾真阴不足者，必兼滋补味药用之。"}]},{"ID":"20240617105347-9ntlgpj","Type":"NodeThematicBreak","Properties":{"id":"20240617105347-9ntlgpj"}},{"ID":"20240617105358-fmo8fjx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105358-fmo8fjx","updated":"20240617105404"},"Children":[{"Type":"NodeText","Data":"五加皮《本草便读》"}]},{"ID":"20240617105358-ebt1jwm","Type":"NodeParagraph","Properties":{"id":"20240617105358-ebt1jwm","updated":"20240617105358"},"Children":[{"Type":"NodeText","Data":"治下焦痹湿风寒．苦辛兼备．强腰膝虚羸痿 ．肝肾咸温．（五加皮其树一枝五叶．有交加之象．故名．辛苦温无毒．入肝肾．祛散下焦风寒湿痹．腰膝疼痛．香港脚痿弱等证．邪去则肝肾强．筋骨利．故能益精补虚．此物虽无纯补之功．亦无损正之害．是以有久服轻身之说也．如肝肾虚．下部无风寒湿邪而有火者勿用．）"}]},{"ID":"20240617105347-cdkkwi2","Type":"NodeThematicBreak","Properties":{"id":"20240617105347-cdkkwi2"}},{"ID":"20240617105348-sg0m7e6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105348-sg0m7e6","updated":"20240617105353"},"Children":[{"Type":"NodeText","Data":"五加皮《本草求真》"}]},{"ID":"20240617105348-zah4axs","Type":"NodeParagraph","Properties":{"id":"20240617105348-zah4axs","updated":"20240617105348"},"Children":[{"Type":"NodeText","Data":"（灌木）除风寒湿香港脚"}]},{"ID":"20240617105348-st4ii6w","Type":"NodeParagraph","Properties":{"id":"20240617105348-st4ii6w","updated":"20240617105348"},"Children":[{"Type":"NodeText","Data":"五加皮（专入肝肾）。今人仅知此能理香港脚。而不知其香港脚之病。因于气寒湿三气而成。风胜则筋骨为之拘挛。湿胜则筋脉为之缓纵。男子阴痿囊湿。女子阴痒虫生。小儿脚软寒湿。则血脉为之凝滞。筋骨为之疼痛。而脚因尔莫行。服此辛苦而温。辛则气顺而化痰。苦则坚骨（骨属肾）而益精。温则祛风（肝主风）而胜湿。凡肌肤之瘀血。筋骨之风邪。靡不因此而治。盖湿去则骨壮。风去则筋强。而脚安有不理者乎？但此虽属理脚之剂。仍不免有疏泄之虞。须于此内参以滋补之药。则用之历久而不变矣。勿谓有五加之说。遂信竟为理脚圣药。而置金玉满车于不问也。（昔孟绰子董士固相与言云。宁得一把五加。不用金玉满车。宁得一斤地榆。不用明月宝珠。时珍曰。五加治风湿痿痹。壮筋骨。其功良深。仙家所述虽若过情。盖奖辞多溢。亦常理耳！）茎青节白。骨硬皮黄根黑。芬香五叶者佳。远志为使。恶玄参。"}]},{"ID":"20240617105611-lhuqvgk","Type":"NodeThematicBreak","Properties":{"id":"20240617105611-lhuqvgk"}},{"ID":"20240617105612-gng49qs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105612-gng49qs","updated":"20240617105616"},"Children":[{"Type":"NodeText","Data":"五加皮《雷公炮制药性解》"}]},{"ID":"20240617105612-dkia4gv","Type":"NodeParagraph","Properties":{"id":"20240617105612-dkia4gv","updated":"20240617105612"},"Children":[{"Type":"NodeText","Data":"味辛苦，性温无毒，入肺肾二经。主心腹腰膝痛，疝气，骨节拘挛多年，瘀血在皮肤，阴痿囊湿，小儿脚软，女子阴痒阴蚀，补劳伤，坚节骨，益志气、添精髓，久服延年。"}]},{"ID":"20240617105612-zb53f5s","Type":"NodeParagraph","Properties":{"id":"20240617105612-zb53f5s","updated":"20240617105612"},"Children":[{"Type":"NodeText","Data":"远志为使，畏蛇皮，玄参。"}]},{"ID":"20240617105612-hv29t48","Type":"NodeParagraph","Properties":{"id":"20240617105612-hv29t48","updated":"20240617105612"},"Children":[{"Type":"NodeText","Data":"按∶五加皮辛能泻肺，苦能坚肾，宜并入之，心腹等件，何非两经之证，而有不治者耶？昔人，延年之说，此其征矣。"}]},{"ID":"20240617105612-mrdiudn","Type":"NodeParagraph","Properties":{"id":"20240617105612-mrdiudn","updated":"20240617105627"},"Children":[{"Type":"NodeText","Data":"雷公云∶今五加皮其树本是白，秋树其上有叶如蒲叶者，其三叶花是雄，五叶花是雌，剥皮阴干。阳人使阴，阴人使阳。"}]},{"ID":"20240617105549-wvtt2hd","Type":"NodeThematicBreak","Properties":{"id":"20240617105549-wvtt2hd"}},{"ID":"20240617105551-mu06opl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105551-mu06opl","updated":"20240617105556"},"Children":[{"Type":"NodeText","Data":"五加皮《证类本草》"}]},{"ID":"20240617105551-rtnbdar","Type":"NodeParagraph","Properties":{"id":"20240617105551-rtnbdar","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"味辛、苦，温、微寒，无毒。主心腹疝气，腹痛，益气，疗 ，小儿不能行，疽疮阴蚀，男子阴痿，囊下湿，小便余沥，女人阴痒及腰脊痛，两脚疼痹风弱，五缓虚羸，补中益精，坚筋骨，强志意。久服轻身耐老。一名豺漆，一名豺节。五叶者良。生汉中及冤句。五月、七月采茎，十月采根，阴干。（远志为之使，畏蛇皮、玄参。）"}]},{"ID":"20240617105551-30gield","Type":"NodeParagraph","Properties":{"id":"20240617105551-30gield","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今近道处处有，东间弥多。四叶者亦好。煮根茎酿酒，主益人。道家用此作灰，亦以煮石，与地榆并有秘法。臣禹锡等谨按蜀本图经云∶树生小丛，赤蔓，茎间有刺，五叶生枝端，根若荆根，皮黄黑，肉白骨硬。今所在有之。药性论云∶五加皮有小毒。能破逐恶风血，四肢不遂，贼风伤人，软脚 （公对切）腰，主多年瘀血在皮肌，治痹湿，内不足，主虚羸，小儿三岁不能行，用此便行走。日华子云∶明目，下气，治中风，骨节挛急，补五劳七伤。叶治皮肤风，可作菜蔬食。"}]},{"ID":"20240617105551-p0k7mpf","Type":"NodeParagraph","Properties":{"id":"20240617105551-p0k7mpf","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"图经曰∶五加皮，生汉中及冤句，今江淮、湖南州郡皆有之。春生苗，茎、叶俱青，作丛。赤茎又似藤蔓，高三、五尺，上有黑刺。叶生五叉作簇者良。四叶、三叶者最多，为次。"}]},{"ID":"20240617105551-0luwylb","Type":"NodeParagraph","Properties":{"id":"20240617105551-0luwylb","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"每一叶下生一刺。三、四月开白花，结细青子，至六月渐黑色。根若荆根，皮黄黑，肉白，骨坚硬。五月、七月采茎，十月采根，阴干用。蕲州人呼为木骨。一说今所用乃有数种。京师、北地者，大片类秦皮、黄柏辈，平直如板而色白，绝无气味，疗风痛颇效，余不入用。"}]},{"ID":"20240617105551-nf2d7kj","Type":"NodeParagraph","Properties":{"id":"20240617105551-nf2d7kj","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"吴中乃剥野椿根为五加皮，柔韧而无味，殊为乖失。今江淮间所生乃为真者，类地骨，轻脆芬香是也。其苗茎有刺类蔷薇，长者至丈余。叶五出，如桃花，香气如橄榄。春时结实，如豆粒而扁，春青，得霜乃紫黑。吴中亦多，俗名为追风使，亦曰刺通。剥取酒渍以疗风，乃不知其为五加皮也。江淮、吴中往往以为藩篱，正似蔷薇、金樱辈，一如上所说，但北间多不知用此种耳。亦可以酿酒，饮之治风痹、四肢挛急。"}]},{"ID":"20240617105551-fk0ovut","Type":"NodeParagraph","Properties":{"id":"20240617105551-fk0ovut","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"陈藏器序∶五加皮花者，治眼臃人，捣末酒调服，自正。雷公曰∶今五加皮，其树本是白楸树。其上有叶如蒲叶者，其叶三花是雄，五叶花是雌。剥皮阴干。阳人使阴，阴人使阳。"}]},{"ID":"20240617105551-04e521r","Type":"NodeParagraph","Properties":{"id":"20240617105551-04e521r","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"外台秘要∶治服诸药石后，或热噤多向冷地卧，又不得食诸热面、酒等方五加皮二两，以水四升，煮取二升半，候石发之时便服，未定更服。杨氏产乳∶疗灶丹，从两脚赤如火烧。五加叶、根烧作灰五两，取 铁家槽中水，和涂之。东华真人煮石经∶舜常登苍梧山，曰∶厥金玉之香草，朕用偃息正道，此乃五加也。又异名曰金盐。昔西域真人王屋山人王常言∶何以得长久？"}]},{"ID":"20240617105551-nwmpm6c","Type":"NodeParagraph","Properties":{"id":"20240617105551-nwmpm6c","updated":"20240617105551"},"Children":[{"Type":"NodeText","Data":"地榆皆是煮石而饵得长生之药也。昔尹公度闻孟绰子、董士固共相与言曰∶宁得一把五加，不用金玉满车。宁得一斤地榆，安用明月宝珠。鲁定公母单服五加酒，以致不死，临隐去佯托死，时人自莫之梧耳。张子声、杨建始、王叔才、于世彦等，皆服此酒而房室不绝，得寿三百年，有验亦然也。大王君谓五加云盖天有五车之星精也。金应五湖，人应五德，位应五方，物应五车。故青精入茎，则有东方之液；白气入节，则有西方之津；赤气入华，则有南方之光；精入根，则有北方之饴；黄烟入皮，则有戊己之灵。五神镇生，相转育成。用之者真仙，服之者反婴也。"}]},{"ID":"20240617105313-54qgkwj","Type":"NodeThematicBreak","Properties":{"id":"20240617105313-54qgkwj"}},{"ID":"20240617105338-vvr791m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105338-vvr791m","updated":"20240617105342"},"Children":[{"Type":"NodeText","Data":"五加皮《本草撮要》"}]},{"ID":"20240617105338-fchisng","Type":"NodeParagraph","Properties":{"id":"20240617105338-fchisng","updated":"20240617105338"},"Children":[{"Type":"NodeText","Data":"味辛．入足厥阴少阴经．功专壮筋骨．除风湿．得地骨皮治虚劳．得丹皮、当归治妇人血风．下部无风寒湿邪而有火．及肝肾虚而有火者勿服．远志为使．恶元参．叶作蔬食．去皮肤风湿．"}]},{"ID":"20240617105539-iawv6ac","Type":"NodeThematicBreak","Properties":{"id":"20240617105539-iawv6ac"}},{"ID":"20240617105540-auj7t90","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105540-auj7t90","updated":"20240617105543"},"Children":[{"Type":"NodeText","Data":"五加皮《医学入门》"}]},{"ID":"20240617105540-nchvdva","Type":"NodeParagraph","Properties":{"id":"20240617105540-nchvdva","updated":"20240617105540"},"Children":[{"Type":"NodeText","Data":"五加皮苦辛温寒，风痹蜷急步履难，疽疮瘀血肌皮滞，心腹疝痛阴不干。"}]},{"ID":"20240617105540-kgpmkze","Type":"NodeParagraph","Properties":{"id":"20240617105540-kgpmkze","updated":"20240617105540"},"Children":[{"Type":"NodeText","Data":"上应五车星精而生，故叶生五出者佳。无毒。主风痹四肢挛急，腰脊而脚疼痛缓弱，小儿三五岁不能行尤验。治疽疮阴蚀，及多年瘀血在皮肌，心腹疝气痛，男子阴痿囊下湿，妇人阴痒。酿酒久服补中益精，坚筋骨，强志意，延年不老，仙经药也。远志为使，恶蛇蜕、玄参。"}]},{"ID":"20240617105313-ggws6jf","Type":"NodeThematicBreak","Properties":{"id":"20240617105313-ggws6jf"}},{"ID":"20240617105328-544whn6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105328-544whn6","updated":"20240617105331"},"Children":[{"Type":"NodeText","Data":"五加皮《药性切用》"}]},{"ID":"20240617105328-p4klkbr","Type":"NodeParagraph","Properties":{"id":"20240617105328-p4klkbr","updated":"20240617105328"},"Children":[{"Type":"NodeText","Data":"辛苦性温，入肝肾而祛风理湿，壮骨强筋，为损伤及风痹专药。酒炒用。"}]},{"ID":"20240617105313-mrif3q2","Type":"NodeThematicBreak","Properties":{"id":"20240617105313-mrif3q2"}},{"ID":"20240617105315-jga6v58","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105315-jga6v58","updated":"20240617105319"},"Children":[{"Type":"NodeText","Data":"五加皮《千金翼方》"}]},{"ID":"20240617105315-fu2rzet","Type":"NodeParagraph","Properties":{"id":"20240617105315-fu2rzet","updated":"20240617105315"},"Children":[{"Type":"NodeText","Data":"味辛苦，温，微寒，无毒。主心腹疝气，腹痛，益气，疗 ，小儿不能行，疽疮，阴蚀，男子阴痿，囊下湿，小便余沥，女子阴痒及腰脊痛，两脚疼痹风弱，五缓虚羸，补中益精，坚筋骨，强志意。久服轻身耐老。一名豺漆，一名豺节，五叶者良。生汉中及冤句，五月七月采茎，十月采根，阴干。"}]},{"ID":"20240617105315-aj3mn1o","Type":"NodeParagraph","Properties":{"id":"20240617105315-aj3mn1o","updated":"20240617105315"},"Children":[{"Type":"NodeText","Data":"沉香、熏陆香、鸡舌香、藿香、詹糖香、枫香∶并微温，悉疗风水毒肿，去恶气，熏陆、詹糖去伏尸；鸡舌、藿香疗霍乱心痛；枫香疗风瘾疹痒毒。"}]},{"ID":"20240607144152-7bm6pdt","Type":"NodeThematicBreak","Properties":{"id":"20240607144152-7bm6pdt"}},{"ID":"20240607144154-kyziqyc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144154-kyziqyc","updated":"20240607144158"},"Children":[{"Type":"NodeText","Data":"五加皮《玉楸药解》"}]},{"ID":"20240607144154-soa6571","Type":"NodeParagraph","Properties":{"id":"20240607144154-soa6571","updated":"20240607144154"},"Children":[{"Type":"NodeText","Data":"味辛，微温，入足厥阴肝经。逐湿开痹，起痿伸挛。"}]},{"ID":"20240607144154-dto1yol","Type":"NodeParagraph","Properties":{"id":"20240607144154-dto1yol","updated":"20240607144154"},"Children":[{"Type":"NodeText","Data":"五加皮通关泻湿，壮骨强筋，治腰痛膝软、足痿筋拘、男子阳痿囊湿、女子阴痒阴蚀、下部诸证。"}]},{"ID":"20240607144121-u23v6bn","Type":"NodeThematicBreak","Properties":{"id":"20240607144121-u23v6bn"}},{"ID":"20240607144129-r2pswus","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144129-r2pswus","updated":"20240607144146"},"Children":[{"Type":"NodeText","Data":"五加皮《本草图经》"}]},{"ID":"20240607144107-30no31u","Type":"NodeParagraph","Properties":{"id":"20240607144107-30no31u","updated":"20240607144142"},"Children":[{"Type":"NodeText","Data":"五加皮，生汉中及冤句，今江淮、湖南州郡皆有之。春生苗，茎、叶俱青，作丛，赤茎，又似藤蔓，高三、五尺，上有黑刺；叶生五义作簇者良，四叶、三叶者最多，为次；每一叶下生一刺；三、四月开白花；结细青子，至六月渐黑色；根若荆根，皮黄黑，肉白，骨坚硬。五月、七月采茎，十月采根，阴干用。蕲州人呼为木骨。一说今所用乃有数种∶京师、北地者，大片类秦皮、黄柏辈，平直如板而色白，绝无气味，疗风痛颇效，余不入用；吴中乃剥野椿根为五加皮，柔韧而无味，殊为乖失；今江淮间所生，乃为真者，类地骨，轻脆芳香是也。其苗茎有刺类蔷薇，长者至丈余；叶五出如桃花，香气如橄榄；春时结实如豆粒而扁，春青，得霜乃紫黑。吴中亦多，俗名为追风使，亦曰刺通。剥取酒渍以疗风，乃不知其为五加皮也。江淮、吴中往往以为藩蓠，正似蔷薇、金樱草，一如上所说。但北间多不知用此种耳。亦可以酿酒，饮之治风痹四肢挛急。"}]},{"ID":"20240607144107-al7oy37","Type":"NodeThematicBreak","Properties":{"id":"20240607144107-al7oy37"}},{"ID":"20240607144113-el44ee3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144113-el44ee3","updated":"20240607144118"},"Children":[{"Type":"NodeText","Data":"五加皮《要药分剂》"}]},{"ID":"20240607144113-zov69tf","Type":"NodeParagraph","Properties":{"id":"20240607144113-zov69tf","updated":"20240607144113"},"Children":[{"Type":"NodeText","Data":"味辛苦。性温。无毒。在天得少阳之气。为五车星之精。在地得火金之味而生。降阴也。远志为使。恶元参、蛇皮。"}]},{"ID":"20240607144113-onux7mr","Type":"NodeParagraph","Properties":{"id":"20240607144113-onux7mr","updated":"20240607144113"},"Children":[{"Type":"NodeText","Data":"【主治】主心腹疝气腹痛。益气。疗。小儿三岁不能行。疽疮阴蚀。（本经）男子阴痿。"}]},{"ID":"20240607144113-mdtqmlf","Type":"NodeParagraph","Properties":{"id":"20240607144113-mdtqmlf","updated":"20240607144113"},"Children":[{"Type":"NodeText","Data":"囊强权）治中风骨节挛急。补五劳七伤。（大明）酿酒治风痹。四肢挛急。（苏颂）【归经】入肝肾二经。为祛风湿壮筋骨之品。（兼补剂）【前论】元素曰。肾得其养。则妄水去而骨壮。肝得其养。则邪风去而筋强。汪机曰。"}]},{"ID":"20240607144113-7fnwoh9","Type":"NodeParagraph","Properties":{"id":"20240607144113-7fnwoh9","updated":"20240607144113"},"Children":[{"Type":"NodeText","Data":"风家精。"}]},{"ID":"20240607144113-zgsswr4","Type":"NodeParagraph","Properties":{"id":"20240607144113-zgsswr4","updated":"20240607144113"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。下部无寒湿邪而有火。及肝肾虚而有火。均忌。"}]},{"ID":"20240607144049-3a5r78z","Type":"NodeThematicBreak","Properties":{"id":"20240607144049-3a5r78z"}},{"ID":"20240607144058-mrw8jm8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144058-mrw8jm8","updated":"20240607144104"},"Children":[{"Type":"NodeText","Data":"五加皮《本草新编》"}]},{"ID":"20240607144058-vmi9xms","Type":"NodeParagraph","Properties":{"id":"20240607144058-vmi9xms","updated":"20240607144058"},"Children":[{"Type":"NodeText","Data":"五加皮，味辛而苦，气温而寒，无毒。近人多取而酿酒，谓其有利益也，甚则夸大其辞，分青、黄、赤、白、黑，配五行立论，服三年可作神仙，真无稽之谈也。此物止利风湿，善消瘀血则真。若言其扶阳起痿，止小便遗沥，去妇人阴痒，绝无一验。而举世宗之，牢不可破，亦从前着书者之误也。余故辨之，使世人毋再惑耳。"}]},{"ID":"20240607144058-puhirru","Type":"NodeParagraph","Properties":{"id":"20240607144058-puhirru","updated":"20240607144058"},"Children":[{"Type":"NodeText","Data":"或问五加皮，举世皆以为补，先生独言非补，世人饮此酒未见有损，何也？曰∶有其功则言功，有其弊而言弊。五加皮，实有损无益之药，而举世宗之，余所以大声疾呼也。此酒江淮之间最多，然饮之而未见损者，亦有其故。盖江淮地势卑湿，服五加皮之酒以去湿，似乎得宜。若非江淮污下之所，而地处高燥，则燥以益燥，吾日见其损，而不见其益矣。"}]},{"ID":"20240607144058-t9m7jqy","Type":"NodeParagraph","Properties":{"id":"20240607144058-t9m7jqy","updated":"20240607144058"},"Children":[{"Type":"NodeText","Data":"或问东华真人煮石法用五加皮，世为仙经所需。而昔年鲁定公母单服五加皮，以致不死，岂皆不可信耶？曰∶此皆造酒附会之辞也。五加皮实止除湿，而不能延年，欲藉其轻身耐老，此余之所不敢信也。"}]},{"ID":"20240607144024-jnh4rvl","Type":"NodeThematicBreak","Properties":{"id":"20240607144024-jnh4rvl"}},{"ID":"20240607144042-ymngyhj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144042-ymngyhj","updated":"20240607144048"},"Children":[{"Type":"NodeText","Data":"五加皮《本草从新》"}]},{"ID":"20240607144042-sy5r2yx","Type":"NodeParagraph","Properties":{"id":"20240607144042-sy5r2yx","updated":"20240607144042"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、祛风湿、补壮筋骨．"}]},{"ID":"20240607144042-xtytgcs","Type":"NodeParagraph","Properties":{"id":"20240607144042-xtytgcs","updated":"20240607144042"},"Children":[{"Type":"NodeText","Data":"辛顺气而化痰．苦坚骨而益精．温祛风而胜湿．逐皮肤之瘀血．疗筋骨之拘挛．（肾得其养则痰水去而骨壮、肝得其养则邪风去而筋强．）治虚羸五缓．（五脏筋脉缓纵．）阴痿囊湿．女子阴痒．小儿脚弱．明目缩便．愈疮疗疝．酿酒尤良．（王纶曰∶风病饮酒、能生痰火、惟五加浸酒益人．）下部无风寒湿邪而有火．及肝肾虚而有火者．勿服．茎青．节白．花赤．皮黄．根黑．上应五车之精．故名．芬香五叶者佳．远志为使．恶元参．叶（作蔬食、去皮肤风湿．）"}]},{"ID":"20240607144024-es2txv9","Type":"NodeThematicBreak","Properties":{"id":"20240607144024-es2txv9"}},{"ID":"20240607144025-lmttavz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144025-lmttavz","updated":"20240607144033"},"Children":[{"Type":"NodeText","Data":"五加皮《本草备要》"}]},{"ID":"20240607144025-2rm8vbi","Type":"NodeParagraph","Properties":{"id":"20240607144025-2rm8vbi","updated":"20240607144025"},"Children":[{"Type":"NodeText","Data":"宣，去风湿，补，壮筋骨"}]},{"ID":"20240607144025-fhfke97","Type":"NodeParagraph","Properties":{"id":"20240607144025-fhfke97","updated":"20240607144025"},"Children":[{"Type":"NodeText","Data":"辛顺气而化痰，苦坚骨而益精，温祛风而胜湿。逐肌肤之瘀血，疗筋骨之拘挛（肾得其养，则妄水去而骨壮；肝得其养，则邪风去而筋强）。"}]},{"ID":"20240607144025-6k7n3t0","Type":"NodeParagraph","Properties":{"id":"20240607144025-6k7n3t0","updated":"20240607144025"},"Children":[{"Type":"NodeText","Data":"治五缓虚羸（五脏筋脉缓纵。《千金方》补云∶五月五日采茎，七月七日采叶，九月九日采根，合为末，治五劳）阴痿囊湿，女子阴痒（湿生虫），小儿脚弱，明目愈疮。酿酒尤良（王纶曰∶风病饮酒，能生痰火，惟五加浸酒益人）。"}]},{"ID":"20240607144025-uqeza1b","Type":"NodeParagraph","Properties":{"id":"20240607144025-uqeza1b","updated":"20240607144025"},"Children":[{"Type":"NodeText","Data":"茎青，节白，花赤，皮黄，根黑，上应五车之精。芬香、五叶者佳。远志为使。恶玄参。"}]},{"ID":"20240607143938-xdk0kca","Type":"NodeThematicBreak","Properties":{"id":"20240607143938-xdk0kca"}},{"ID":"20240607143945-dcp48wg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143945-dcp48wg","updated":"20240607143952"},"Children":[{"Type":"NodeText","Data":"五加皮《本草蒙筌》"}]},{"ID":"20240607143945-v8kfr48","Type":"NodeParagraph","Properties":{"id":"20240607143945-v8kfr48","updated":"20240607143945"},"Children":[{"Type":"NodeText","Data":"味辛、苦，气温、微寒。无毒。山泽多生，随处俱有。藤蔓类木，高并人肩。五叶操作为良，三叶四叶略次。凡使入药，采根取皮。畏蛇蜕人参，宜远志为使。堪用酿酒，任研为丸。逐多年瘀血在皮筋中，驱常痛风痹缠脚膝里。坚筋骨健步，强志意益精。去女人阴痒难当，扶男子阳痿不举。小便遗沥可止，阴蚀疽疮能除。轻身延年，长生不老，真仙经药也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"采作蔬食，散风疹于一身；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"煎酒尝，治风瘫于四末。"}]},{"ID":"20240607143945-lj6faot","Type":"NodeParagraph","Properties":{"id":"20240607143945-lj6faot","updated":"20240607143945"},"Children":[{"Type":"NodeText","Data":"（谟）按∶五加之名据义甚大，盖天有五车之星精也。青精入茎，则有东方之液；白气入节，则有西方之津；赤气入花，则有南方之光；玄精入根，则有北方之饴；黄烟入皮，则有戊巳之灵。五神镇生，相转育成。服一年者，貌如童稚。服三年者，可作神仙。故鲁定公母单服此酒，以致不死。张子声等皆服，得生二十余子，享寿三百多年。昔人尝云∶宁得一把五加，不用金玉满车。宁得一斤地榆，不用明目宝珠。信非长生之药致是称乎。"}]},{"ID":"20240607143840-h7ymxsd","Type":"NodeThematicBreak","Properties":{"id":"20240607143840-h7ymxsd"}},{"ID":"20240607143931-arhamtg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143931-arhamtg","updated":"20240607143936"},"Children":[{"Type":"NodeText","Data":"五加皮《本草乘雅半偈》"}]},{"ID":"20240607143931-93gx9s5","Type":"NodeParagraph","Properties":{"id":"20240607143931-93gx9s5","updated":"20240607143931"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240607143931-i068a6h","Type":"NodeParagraph","Properties":{"id":"20240607143931-i068a6h","updated":"20240607143931"},"Children":[{"Type":"NodeText","Data":"【气味】辛温，无毒。"}]},{"ID":"20240607143931-89z2kyu","Type":"NodeParagraph","Properties":{"id":"20240607143931-89z2kyu","updated":"20240607143931"},"Children":[{"Type":"NodeText","Data":"【主治】主治心腹疝气，腹痛，益气，疗 ，小儿三岁不能行，疽疮阴蚀。"}]},{"ID":"20240607143931-q2jws1h","Type":"NodeParagraph","Properties":{"id":"20240607143931-q2jws1h","updated":"20240607143931"},"Children":[{"Type":"NodeText","Data":"【核】曰∶五加生汉中及冤句，江淮、湖南州郡，汴京、北地皆有之。宿根再发，春苗丛生。茎类藤葛，高六七尺或丈余，枝茎交加，间有刺，因名白刺。每叶五枚，或三枚、五枚者佳，三枚者亦可用。若三相参，五相伍，三五相参而变化生，故四枚者不堪用。叶类蔷薇，边有锯齿。四月花白子青，六月子转黑，得霜则红紫相间，文彩陆离，因名文章草。十月采根，皮黄黑，肉白色，内骨坚劲，因名本骨。南地者根类枸杞木皮，阔浓轻脆，芬芳袭人，入药造酒最良。盖木命在皮，草 而言皮者，五加专精之在根皮也。北地者类秦木、柏木，树皮平直如板，其色白，无气味，疗风痛，余无所用。王君云∶五加者，五车星精也。"}]},{"ID":"20240607143931-ds799wt","Type":"NodeParagraph","Properties":{"id":"20240607143931-ds799wt","updated":"20240607143931"},"Children":[{"Type":"NodeText","Data":"盖水应五湖，人应五德，位应五方，物应五车。故青精入茎，则有东方之液；白气入节，则有西方之津；赤气入华，则有南方之光；玄精入根，则有北方之粘；黄烟入皮，则有戊己之灵。五神镇生，相转育成。饵之者真仙，服之者反婴。因名金铅金液、神丹，副名也。铅讹盐谬矣。"}]},{"ID":"20240607143931-vzuczkc","Type":"NodeParagraph","Properties":{"id":"20240607143931-vzuczkc","updated":"20240607143931"},"Children":[{"Type":"NodeText","Data":"【 】曰∶五从二，从 ，象 天两地间，互阳交阴中，之为五。盖天数五，地数五，五位相得而各有合者，之为加。诚五行星精之所化，引重致远，以济不通，何患 不疗，小儿三岁不能行，筋不转，脉不摇，赋形功行为名也。固入五脏，偏驻又在厥阴之肝，肝藏筋膜之气也。是得辅厥阴肝体，行厥阴肝用，除厥阴肝眚，其功特着。一名五嘉，合柏酿酒，酉佳美。行酒势，走血脉，通关津，达四街，彻九窍，布二百六十五节，开八万四千毛孔，迅速疾行，无出其右者。至若追风作使，辟寒惩暄，易热 为清凉地，攘濡湿致高洁界，此其专务。"}]},{"ID":"20240617105521-9aeq8zi","Type":"NodeThematicBreak","Properties":{"id":"20240617105521-9aeq8zi"}},{"ID":"20240617105522-or173zh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105522-or173zh","updated":"20240617105527"},"Children":[{"Type":"NodeText","Data":"五加皮《本草述钩元》"}]},{"ID":"20240617105522-ndhcgob","Type":"NodeParagraph","Properties":{"id":"20240617105522-ndhcgob","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"北方沙地者木类。南方坚地者草类。生江淮者根类。地骨皮最良。轻脆芬香。苗茎有刺类蔷薇。长者丈余。叶五出。香气如橄榄。春时结实。如豆粒而扁。青色。得霜紫黑。"}]},{"ID":"20240617105522-h5e1mz2","Type":"NodeParagraph","Properties":{"id":"20240617105522-h5e1mz2","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"俗名追风。使以渍酒疗风。不知其为真五加皮也。用根皮同茎。"}]},{"ID":"20240617105522-ejkaqc0","Type":"NodeParagraph","Properties":{"id":"20240617105522-ejkaqc0","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"味辛苦。气温。气味俱浓。沉而阴也。入足少阴厥阴经。远志为之使。恶元参蛇皮。"}]},{"ID":"20240617105522-m7l1jpi","Type":"NodeParagraph","Properties":{"id":"20240617105522-m7l1jpi","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"同人参用。则无力。（然种子方有同用者）主治腰膝疼痹。疗痿五缓虚羸。（湿气浸淫留中。则筋脉缓纵。虚羸气乏。）风痹四肢挛急。破逐恶风血。及多年瘀血在皮肌。治痹湿内不足。补中益气。坚筋骨。强志意。并治男子阴痿。囊下湿。小便余沥。又主疽疮阴蚀。五加皮得天少阳之气。为五车星之精。又得地火金之气。故气味辛温。所主诸证。皆因风寒湿邪。伤于肝肾二经。而湿气为最。经云。伤于湿者。下先受之。又云。地之湿气感则害人皮肉筋脉。肝肾居下而主筋骨。故风寒湿之邪。多自二经先受。此药辛能散风。温能除寒。苦能燥湿。二脏得其气。诸证悉瘳。（仲淳）轻身（风湿去也）耐老。（肝肾补也）世为仙经所须。（又）风病饮酒。能生痰火。惟五加一味浸之。日饮数杯。最有益。诸浸酒药。惟五加与酒相合味美。（王纶）得牛膝木瓜黄柏生地麦冬薏仁石斛虎胫骨山药。治湿热痿痹。"}]},{"ID":"20240617105522-5fof941","Type":"NodeParagraph","Properties":{"id":"20240617105522-5fof941","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"腰以下不能行动。同二术二活防风萆薏仁石菖蒲白蒺藜甘菊白藓皮石斛。治风寒湿成痹。"}]},{"ID":"20240617105522-s0cm6ci","Type":"NodeParagraph","Properties":{"id":"20240617105522-s0cm6ci","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"一味酿酒饮之。治风痹四肢拘挛。同续断杜仲牛膝山萸巴戟故纸。治肾虚寒湿客之腰痛。"}]},{"ID":"20240617105522-esiierm","Type":"NodeParagraph","Properties":{"id":"20240617105522-esiierm","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"同苍术黄柏黄连翘石菖蒲薏仁银花鳖虱胡麻木瓜土茯苓。治下部湿疮不愈。兼治脓窠疮如神。同黄柏菖蒲蛇床子为末。敷囊湿神效。如作汤沐。加荆芥苦参防风。虚劳不足。五加皮枸杞根白皮。各一斗。水一石五斗。煮汁七斗。分取四斗。浸曲一斗。以三斗拌饭。如常酿酒法。待熟任饮。妇人血风劳。憔悴困倦。喘满虚烦。吸吸少气。发热多汗。口干舌涩。不思饮食。服油煎散。五加皮丹皮赤芍当归各一两。为末。每一钱。水一盏。取青钱一文蘸油入药。煎七分温服。常服。男妇香港脚。骨节皮肤肿湿疼痛。五加皮远志肉各四两。酒浸。春秋三日。夏二日。冬四日。晒干为末。即以浸酒为糊丸。梧子大。每服四五十丸。空心。温酒下。药酒坏。别用酒为糊。按远志为五加皮之使。其为肾剂益明。"}]},{"ID":"20240617105522-dq2vf8p","Type":"NodeParagraph","Properties":{"id":"20240617105522-dq2vf8p","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"〔论〕五加皮治风湿痿痹。（本经言。别录言两脚痹疼风弱。权言软脚。皆痿也。"}]},{"ID":"20240617105522-svr489b","Type":"NodeParagraph","Properties":{"id":"20240617105522-svr489b","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"痹者。即甄氏所言恶风血。瘀血。痹湿内不足也。）夫湿伤肾。肾不能养肝。肝自生风。遂成风湿。其本病于痹湿内不足。而血脉凝滞。其标见于筋伤。不能束骨。而为风弱软脚。然则五加乃疗湿之化风。非疗风病。经曰。风从阳受之。湿从阴受之。其本固区以别矣。此味初辛次苦。苦胜于辛。辛居先而即随苦以直下。故入肝散风。入肾燥湿。而皆以气之温者和之。人惟肾肝气虚。故病于湿。湿者阴之淫气也。阴淫则阳不化而为风。风者阳之淫气也。"}]},{"ID":"20240617105522-f5v7r7d","Type":"NodeParagraph","Properties":{"id":"20240617105522-f5v7r7d","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"阳淫则阴愈不化而病于湿。至更病于湿。则阴锢阳。阳蚀阴。而成湿热。如疽疮阴蚀。及骨节挛急是也。夫既曰缓弱。又曰挛急者。因湿郁为热。热伤血而不能养筋。故为挛急也。五加皮以辛苦温。散其阳实之淫气。即行其窒滞不化之阴气。是治风也。实由湿而治之。祛风本于宣湿。逐湿又即以清热。所以热痹（如防风丸）冷痹（如巴戟天汤）皆用之。别录言其益气坚筋骨强志意者。固以元阳得畅。真阴能化。而生化之源不竭也。岂得与他味之宣风除湿者例论乎哉。或曰。此味所疗者湿化风。宜曰湿风。乃曰风湿。何也。夫肝司风木。而藏血。而主筋。而主经络。透关节者也。今一切所见之证。皆见于风木。故以风冠湿而言风。"}]},{"ID":"20240617105522-6nqgyoj","Type":"NodeParagraph","Properties":{"id":"20240617105522-6nqgyoj","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"又即不能离湿也。若但以为驱风之味。则梦梦矣。"}]},{"ID":"20240617105522-fhnvw8t","Type":"NodeParagraph","Properties":{"id":"20240617105522-fhnvw8t","updated":"20240617105522"},"Children":[{"Type":"NodeText","Data":"下部无风寒湿邪而有火者。不宜用。肝肾虚而有火者。亦忌。（仲淳）〔辨治〕北地生者。微黑而硬。南土者。微白而软。大类桑白皮。用南五加皮。剥去骨。阴干酒洗。通行周身。或用姜汁制。"}]},{"ID":"20240607143841-hv6ppd4","Type":"NodeThematicBreak","Properties":{"id":"20240607143841-hv6ppd4"}},{"ID":"20240607143852-7n9tuqk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143852-7n9tuqk","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"《中国药典》：五加皮"}]},{"ID":"20240607143852-vx2ratv","Type":"NodeParagraph","Properties":{"id":"20240607143852-vx2ratv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607143852-nzov3va","Type":"NodeParagraph","Properties":{"id":"20240607143852-nzov3va","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" Wǔ Jiā Pí"}]},{"ID":"20240607143852-y9kuafh","Type":"NodeParagraph","Properties":{"id":"20240607143852-y9kuafh","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607143852-1y0rmiz","Type":"NodeParagraph","Properties":{"id":"20240607143852-1y0rmiz","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 南五加皮、刺五加、刺五甲"}]},{"ID":"20240607143852-rkw9kjc","Type":"NodeParagraph","Properties":{"id":"20240607143852-rkw9kjc","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607143852-4wnaot5","Type":"NodeParagraph","Properties":{"id":"20240607143852-4wnaot5","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" CORTEX ACANTHOPANACIS"}]},{"ID":"20240607143852-ytlqpce","Type":"NodeParagraph","Properties":{"id":"20240607143852-ytlqpce","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607143852-34pm7tx","Type":"NodeParagraph","Properties":{"id":"20240607143852-34pm7tx","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 本品为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"细柱五加"},{"Type":"NodeText","Data":"Acanthopanax gracilistylus W.W. Smith的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。夏、秋二季采挖根部，洗净，剥取根皮，晒干。"}]},{"ID":"20240607143852-el2wqfr","Type":"NodeParagraph","Properties":{"id":"20240607143852-el2wqfr","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607143852-30jvvip","Type":"NodeParagraph","Properties":{"id":"20240607143852-30jvvip","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 本品呈不规则卷筒状，长5～15cm，直径0.4～1.4cm厚约0.2cm。外表面灰褐色，有稍扭曲的纵皱纹及横长皮孔；内表面淡黄色或灰黄色，有细纵纹。体轻，质脆，易折断，断面不整齐，灰白色。气微香，味微辣而苦。"}]},{"ID":"20240607143852-uk97ipu","Type":"NodeParagraph","Properties":{"id":"20240607143852-uk97ipu","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607143852-n8nr4sb","Type":"NodeParagraph","Properties":{"id":"20240607143852-n8nr4sb","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防霉，防蛀。"}]},{"ID":"20240607143852-ylkwkjb","Type":"NodeParagraph","Properties":{"id":"20240607143852-ylkwkjb","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607143852-7t9ojj6","Type":"NodeParagraph","Properties":{"id":"20240607143852-7t9ojj6","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240607143852-u7w964t","Type":"NodeParagraph","Properties":{"id":"20240607143852-u7w964t","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607143852-od4zyvv","Type":"NodeParagraph","Properties":{"id":"20240607143852-od4zyvv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 本品横切面：木栓层为数列细胞。皮层窄，有少数分泌道散在。韧皮部宽广，外侧有裂隙，射线宽 1～5 列细胞；分泌道较多，周围分泌细胞 4～11个。薄壁细胞含草酸钙簇晶及细小淀粉粒。"}]},{"ID":"20240607143852-4gtsi2h","Type":"NodeParagraph","Properties":{"id":"20240607143852-4gtsi2h","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"粉末灰白色。草酸钙簇晶直径 8～64μｍ，有时含晶细胞连接，簇晶排列成行。木栓细胞长方形或多角形，壁薄；老根皮的木栓细胞有时壁不均匀增厚，有少数纹孔。分泌道碎片含无色或淡黄色分泌物。淀粉粒甚多，单粒多角形或类球形，直径2～8μm；复粒由2至数十分粒组成。"}]},{"ID":"20240607143852-jepk6d9","Type":"NodeParagraph","Properties":{"id":"20240607143852-jepk6d9","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607143852-o3qbbuk","Type":"NodeParagraph","Properties":{"id":"20240607143852-o3qbbuk","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607143852-5kii6s3","Type":"NodeParagraph","Properties":{"id":"20240607143852-5kii6s3","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607143852-g7bhlr2","Type":"NodeParagraph","Properties":{"id":"20240607143852-g7bhlr2","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 辛、苦，温。"}]},{"ID":"20240607143852-r3jdlfd","Type":"NodeParagraph","Properties":{"id":"20240607143852-r3jdlfd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607143852-2f40wag","Type":"NodeParagraph","Properties":{"id":"20240607143852-2f40wag","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 祛风湿，补肝肾，强筋骨。用于风湿痹痛，筋骨痿软，小儿行迟，体虚乏力，水肿，脚气。"}]},{"ID":"20240607143852-apn8hfw","Type":"NodeParagraph","Properties":{"id":"20240607143852-apn8hfw","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607143852-g2umbwp","Type":"NodeParagraph","Properties":{"id":"20240607143852-g2umbwp","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 4.5～9g。"}]},{"ID":"20240607143852-lzmbuvy","Type":"NodeParagraph","Properties":{"id":"20240607143852-lzmbuvy","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607143852-nteaman","Type":"NodeParagraph","Properties":{"id":"20240607143852-nteaman","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 用于风湿痹痛、筋骨拘挛、腰膝酸痛等症，对肝肾不足有风湿者最为适用，可单用浸酒服，也可与羌活、秦艽、威灵仙等配伍应用。治肝肾不足所致腰膝酸疼、下肢痿弱以及小儿行迟等症，在临床应用上常与牛膝、木瓜、续断等药同用。治水肿、小便不利，常配合茯苓皮、大腹皮、生姜皮、地骨等药同用。"}]},{"ID":"20240607143852-jml5nmr","Type":"NodeParagraph","Properties":{"id":"20240607143852-jml5nmr","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607143852-kc8b1h0","Type":"NodeParagraph","Properties":{"id":"20240607143852-kc8b1h0","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607143852-8t7hf33","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143852-8t7hf33","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：五加皮"}]},{"ID":"20240607143852-wo93j8a","Type":"NodeParagraph","Properties":{"id":"20240607143852-wo93j8a","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607143852-q0h80i2","Type":"NodeParagraph","Properties":{"id":"20240607143852-q0h80i2","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" Wǔ Jiā Pí"}]},{"ID":"20240607143852-ftqofem","Type":"NodeParagraph","Properties":{"id":"20240607143852-ftqofem","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607143852-4ugqrxp","Type":"NodeParagraph","Properties":{"id":"20240607143852-4ugqrxp","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 南五加皮（《科学的民间药草》）。"}]},{"ID":"20240607143852-h8bbl7t","Type":"NodeParagraph","Properties":{"id":"20240607143852-h8bbl7t","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607143852-x3uqhmk","Type":"NodeParagraph","Properties":{"id":"20240607143852-x3uqhmk","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607143852-dk29kns","Type":"NodeParagraph","Properties":{"id":"20240607143852-dk29kns","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607143852-j8940gp","Type":"NodeParagraph","Properties":{"id":"20240607143852-j8940gp","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"五加"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无梗五加、刺五加、糙叶五加、轮伞五加"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。夏、秋采挖，剥取根皮，晒干。"}]},{"ID":"20240607143852-rf5ha2q","Type":"NodeParagraph","Properties":{"id":"20240607143852-rf5ha2q","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607143852-jcvcsaz","Type":"NodeParagraph","Properties":{"id":"20240607143852-jcvcsaz","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 主产湖北、河南、安徽、陕西、四川、江苏、广西、浙江等地亦产。"}]},{"ID":"20240607143852-lxuzbno","Type":"NodeParagraph","Properties":{"id":"20240607143852-lxuzbno","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607143852-ysblf4c","Type":"NodeParagraph","Properties":{"id":"20240607143852-ysblf4c","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" ①五加（《本经》），又名：豺漆（《本经》），文章草（《巴蜀异物志》），五花（《雷公炮炙论》），豺节（《别录》），木骨、追风使、刺通（《本草图经》），白刺（《纲目》），茨五甲（《草木便方》），白竻树、五叶路刺、细柱五加、老虎獠、五花眉、水面油、白芦刺、五加花、鸡脚风。"}]},{"ID":"20240607143852-0g04jkg","Type":"NodeParagraph","Properties":{"id":"20240607143852-0g04jkg","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高2～3米。茎直立或攀援，分枝无刺或有外曲刺，刺通常单生于叶柄的基部。叶互生或数叶簇生于短枝上；叶柄长4～9厘米，光滑或疏生有小刺；掌状复叶，小叶5枚，少有3或4枚，顶端1枚较大，两侧小叶渐次较小，倒卵形至卵状披针形或近菱形，长3～8厘米，宽1.5～4厘米，先端尖或渐尖，基部楔形，边缘具锯齿，两面光滑或仅沿脉上有锈色绒毛；小叶无柄。伞形花序，单生于叶腋或短枝末梢，花序柄长1～3厘米，果时伸长；花多数，黄绿色，直径约2厘米，花柄柔细，光滑，长6～10毫米；萼5齿裂，裂片三角形，直立或平展；花瓣5片，着生于肉质花盘的周围，卵状三角形，顶端尖，开放后反卷；雄蕊5；子房下位，2室，花柱2枚，分离，柱头圆头状。浆果状核果近球形，侧向压扁，直径约5毫米，熟时紫黑色，近中央有纵脉3条。种子2粒，细小，半圆形而扁，淡褐色。花期5～7月。果期7～10月。"}]},{"ID":"20240607143852-lsa18mv","Type":"NodeParagraph","Properties":{"id":"20240607143852-lsa18mv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"生长于山坡上或丛林间。分布陕西、河南、山东、安徽、江苏、浙江、江西、湖北、湖南、四川、云南、贵州、广西、广东等地。"}]},{"ID":"20240607143852-3ky8sak","Type":"NodeParagraph","Properties":{"id":"20240607143852-3ky8sak","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"本植物的叶（五加叶）亦供药用，另详专条。"}]},{"ID":"20240607143852-mjgc5vq","Type":"NodeParagraph","Properties":{"id":"20240607143852-mjgc5vq","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"②无梗五加"}]},{"ID":"20240607143852-eb0hkai","Type":"NodeParagraph","Properties":{"id":"20240607143852-eb0hkai","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"灌木，高至4米。枝上有锥形的硬刺或无刺。掌状复叶，小叶3～5枚，矩圆状倒卵形或倒卵形至矩圆状倒披针形，长3～8厘米，有不规则锯齿，几无毛；叶柄长3～6厘米。花暗紫色，几无柄，成密生球形头状花序生于有细毛的短梗上，通常数个生于小枝顶端。果黑色，阔椭圆形，长10～14毫米。花期8月。果期9月。"}]},{"ID":"20240607143852-dac341l","Type":"NodeParagraph","Properties":{"id":"20240607143852-dac341l","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"生于山地林下，林缘。分布东北、华北等地。"}]},{"ID":"20240607143852-0etqjag","Type":"NodeParagraph","Properties":{"id":"20240607143852-0etqjag","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"③刺五加"}]},{"ID":"20240607143852-uvibto0","Type":"NodeParagraph","Properties":{"id":"20240607143852-uvibto0","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"灌木，高1米许。小枝密生细刺毛或刺。掌状复叶，小叶3～5枚，椭圆状倒卵形至矩圆形，长6～12厘米，有双重锐锯齿，上面散生毛，下面幼时沿叶脉有带褐色细毛。伞形花序球形；花紫黄色；花梗长1～2厘米。果近球形，径约8毫米。花期7月。果期10月。"}]},{"ID":"20240607143852-fd7j2ss","Type":"NodeParagraph","Properties":{"id":"20240607143852-fd7j2ss","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"生于山地林下、林边。分布辽宁、吉林、黑龙扛、河北、山西等地。"}]},{"ID":"20240607143852-en606ev","Type":"NodeParagraph","Properties":{"id":"20240607143852-en606ev","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"④糙叶五加"}]},{"ID":"20240607143852-3sogdqr","Type":"NodeParagraph","Properties":{"id":"20240607143852-3sogdqr","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"灌木，高至3米.小枝细时有粗糙细毛，后变为黄灰色，渐脱落，有粗壮微反曲刺。掌状复叶，小叶5枚，几无柄，倒卵形或长椭圆形，长3～6厘米，有细锯齿，上面粗糙，下面有细毛；叶柄长4～7厘米，粗糙。伞形花序数个生枝顶，总梗长1～3厘米，有毛；花梗长8～15毫米，微有毛或无毛。花期8月。果期10月。"}]},{"ID":"20240607143852-chb6mzb","Type":"NodeParagraph","Properties":{"id":"20240607143852-chb6mzb","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"分布河北、河南、陕西、甘肃、四川、湖南、湖北、浙江、安徽等地。"}]},{"ID":"20240607143852-prs27mt","Type":"NodeParagraph","Properties":{"id":"20240607143852-prs27mt","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑤轮伞五加"}]},{"ID":"20240607143852-uozeweo","Type":"NodeParagraph","Properties":{"id":"20240607143852-uozeweo","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"灌木，高2～3米。枝棕褐色，枝和叶柄基部有小倒刺。叶互生或簇生于短枝上；掌状复叶，小叶3～5片，倒卵形或卵状披针形，边缘有锯齿，齿端有小刺毛，基部楔形或斜形，叶脉上有刺毛，主脉于下面稍突起。伞形花序腋生或顶生，多成轮状排列；花小，多数；花瓣5，黄绿色。果近球形，熟时紫黑色；内有种子2粒。"}]},{"ID":"20240607143852-v0qezs9","Type":"NodeParagraph","Properties":{"id":"20240607143852-v0qezs9","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"多生于山坡丛林间。分布西藏等地。"}]},{"ID":"20240607143852-sof7duf","Type":"NodeParagraph","Properties":{"id":"20240607143852-sof7duf","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607143852-n65g0h8","Type":"NodeParagraph","Properties":{"id":"20240607143852-n65g0h8","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 干燥根皮呈卷筒状，单卷或双卷，长7～10厘米，筒径约6毫米，厚约1～2毫米。夕表面灰褐色，有横向皮孔及纵皱，内表面淡黄色或淡黄棕色。质脆，易折断，断面不整齐；淡灰黄色。气微香，味微苦涩。以粗长、皮厚、气香、无木心者为佳。"}]},{"ID":"20240607143852-zu8qhdv","Type":"NodeParagraph","Properties":{"id":"20240607143852-zu8qhdv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607143852-usrfbbl","Type":"NodeParagraph","Properties":{"id":"20240607143852-usrfbbl","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，用水洗净，稍润后切片，干燥。"}]},{"ID":"20240607143852-e7bz2gb","Type":"NodeParagraph","Properties":{"id":"20240607143852-e7bz2gb","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"《本草述钩元》：\"五加皮，剥去骨，阴干酒洗，或用姜汁制。\""}]},{"ID":"20240607143852-x6k1xa4","Type":"NodeParagraph","Properties":{"id":"20240607143852-x6k1xa4","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607143852-jzxuj6m","Type":"NodeParagraph","Properties":{"id":"20240607143852-jzxuj6m","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607143852-syv8g0o","Type":"NodeParagraph","Properties":{"id":"20240607143852-syv8g0o","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肺、肾二经。\""}]},{"ID":"20240607143852-yt4e2sp","Type":"NodeParagraph","Properties":{"id":"20240607143852-yt4e2sp","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足少阴、厥阴经。\""}]},{"ID":"20240607143852-213obr9","Type":"NodeParagraph","Properties":{"id":"20240607143852-213obr9","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607143852-vm70mnz","Type":"NodeParagraph","Properties":{"id":"20240607143852-vm70mnz","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240607143852-ujpm58y","Type":"NodeParagraph","Properties":{"id":"20240607143852-ujpm58y","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240607143852-9fyl0p4","Type":"NodeParagraph","Properties":{"id":"20240607143852-9fyl0p4","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，微寒，无毒。\""}]},{"ID":"20240607143852-52zrlyv","Type":"NodeParagraph","Properties":{"id":"20240607143852-52zrlyv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"有小毒。\""}]},{"ID":"20240607143852-vonyvd8","Type":"NodeParagraph","Properties":{"id":"20240607143852-vonyvd8","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"苦微辛，寒。\""}]},{"ID":"20240607143852-qe3xq07","Type":"NodeParagraph","Properties":{"id":"20240607143852-qe3xq07","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑤《四川中药志》：\"性温，味甘，无毒。\""}]},{"ID":"20240607143852-fnrco3g","Type":"NodeParagraph","Properties":{"id":"20240607143852-fnrco3g","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607143852-4kldkuc","Type":"NodeParagraph","Properties":{"id":"20240607143852-4kldkuc","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 阴虚火旺者慎服。"}]},{"ID":"20240607143852-sajnwnd","Type":"NodeParagraph","Properties":{"id":"20240607143852-sajnwnd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"远志为使。畏蛇皮、玄参。\""}]},{"ID":"20240607143852-kkfjn8m","Type":"NodeParagraph","Properties":{"id":"20240607143852-kkfjn8m","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"下部无风寒湿邪而有火者不宜用，肝肾虚而有火者亦忌之。\""}]},{"ID":"20240607143852-er7vlwm","Type":"NodeParagraph","Properties":{"id":"20240607143852-er7vlwm","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"肺气虚、水不足二者禁用。\""}]},{"ID":"20240607143852-0p0dkbf","Type":"NodeParagraph","Properties":{"id":"20240607143852-0p0dkbf","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607143852-8nvr4qd","Type":"NodeParagraph","Properties":{"id":"20240607143852-8nvr4qd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 祛风湿，壮筋骨，活血去瘀。治风寒湿痹，筋骨挛急，腰痛，阳痿，脚弱，小儿行迟，水肿，脚气，疮疽肿毒，跌打劳伤。"}]},{"ID":"20240607143852-hhrlts7","Type":"NodeParagraph","Properties":{"id":"20240607143852-hhrlts7","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹疝气，腹痛，益气疗躄，小儿不能行，疽疮阴蚀。\""}]},{"ID":"20240607143852-4tls61h","Type":"NodeParagraph","Properties":{"id":"20240607143852-4tls61h","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗男子阴痿，囊下湿，小便余沥，女人阴痒及腰脊痛，两脚疼痹风弱，五缓虚羸，补中益精，坚筋骨，强志意。\""}]},{"ID":"20240607143852-04rc4cg","Type":"NodeParagraph","Properties":{"id":"20240607143852-04rc4cg","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能破逐恶风血，四肢不遂，贼风伤人，软脚，臀腰，主多年瘀血在皮肌，治痹湿内不足，主虚羸，小儿三岁不能行。\""}]},{"ID":"20240607143852-yprimxo","Type":"NodeParagraph","Properties":{"id":"20240607143852-yprimxo","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"明目，下气，治中风骨节挛急，补五劳七伤。\""}]},{"ID":"20240607143852-b7x310e","Type":"NodeParagraph","Properties":{"id":"20240607143852-b7x310e","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑤《纲目））：\"治风湿痿痹，壮筋骨。\""}]},{"ID":"20240607143852-3os7h7w","Type":"NodeParagraph","Properties":{"id":"20240607143852-3os7h7w","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"化痰除湿，养肾益精，去风消水，理脚气腰痛，治疮疥诸毒。\""}]},{"ID":"20240607143852-stwju2o","Type":"NodeParagraph","Properties":{"id":"20240607143852-stwju2o","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑦《陕西中草药》：\"活血消肿。治风湿关节痛，阴囊湿疹，跌打损伤，水肿，小便不利。\"’"}]},{"ID":"20240607143852-tvtp54l","Type":"NodeParagraph","Properties":{"id":"20240607143852-tvtp54l","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑧《云南中草药》：\"治跌打损伤，骨折，疮毒，疟疾。\""}]},{"ID":"20240607143852-8xcx9tf","Type":"NodeParagraph","Properties":{"id":"20240607143852-8xcx9tf","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607143852-6do59zx","Type":"NodeParagraph","Properties":{"id":"20240607143852-6do59zx","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；浸酒或入丸、散。外用：捣敷。"}]},{"ID":"20240607143852-44yowc5","Type":"NodeParagraph","Properties":{"id":"20240607143852-44yowc5","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607143852-57zpvlu","Type":"NodeParagraph","Properties":{"id":"20240607143852-57zpvlu","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" ①治男子妇人脚气，骨节皮肤肿湿疼痛，进饮食，行有力，不忘事：五加皮四两（酒浸），远志（去心）四两（酒浸令透，易为剥皮）。上曝干，为末，春秋冬用浸药酒为糊，夏则用酒为糊，丸如梧桐子大。每服四、五十丸，空心温酒送下。（《瑞竹堂经验方》五加皮丸）"}]},{"ID":"20240607143852-6x6px4a","Type":"NodeParagraph","Properties":{"id":"20240607143852-6x6px4a","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"②治一切风湿痿痹，壮筋骨，填精髓：五加皮，洗刮去骨，煎汁和曲米酿成饮之；或切碎袋盛，浸酒煮饮，或加当归、牛膝、地榆诸药。（《纲目》五加皮酒）"}]},{"ID":"20240607143852-go85bfo","Type":"NodeParagraph","Properties":{"id":"20240607143852-go85bfo","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"③治腰痛：五加皮、杜仲（炒）。上等分，为末，酒糊丸，如梧桐子大。每服三十丸，温酒下。（《卫生家宝方》五加皮散）"}]},{"ID":"20240607143852-qgcx0yf","Type":"NodeParagraph","Properties":{"id":"20240607143852-qgcx0yf","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"④治鹤膝风：五加皮八两，当归五两，牛膝四两，无灰酒一斗。煮三炷香，日二服，以醺为度。（《外科大成》五加皮酒）"}]},{"ID":"20240607143852-4mnzgmf","Type":"NodeParagraph","Properties":{"id":"20240607143852-4mnzgmf","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑤治四、五岁不能行：真五加皮、川牛膝（酒浸二日）、木瓜（干）各等分。上为末，每服二钱，空心米汤调下，一日二服，服后再用好酒半盏与儿饮之，仍量儿大小。（《保婴撮要》五加皮散）"}]},{"ID":"20240607143852-ha1w9u6","Type":"NodeParagraph","Properties":{"id":"20240607143852-ha1w9u6","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑥治虚劳不足：五加皮、枸杞根皮各一斗。上二味细切，以水一石五斗，煮取汁七斗，分取四斗，浸麴一斗，余三斗用拌饭，下米多少，如常酿法，熟压取服之，多少任性。（《千金方》五加酒）"}]},{"ID":"20240607143852-m3tblv6","Type":"NodeParagraph","Properties":{"id":"20240607143852-m3tblv6","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑦治妇人血风劳，形容憔悴，肢节困倦，喘满虚烦，吸吸少气，发热汗多，口干舌涩，不思饮食：五加皮、牡丹皮、赤芍药、当归（去芦）各一两。上为末，每服一钱，水一盏，将青铜钱一文，蘸油入药，煎七分，温服，日三服。（《局方》油煎散）"}]},{"ID":"20240607143852-ss3oz2m","Type":"NodeParagraph","Properties":{"id":"20240607143852-ss3oz2m","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑧治损骨：小鸡一只，约重五、六两（连毛），同五加皮一两，捣为糊，搦在伤处，一炷香时，解下后，用山栀三钱，五加皮四钱，酒一碗，煎成膏贴之，再以大瓦松煎酒服之。（梅氏《验方新编》）"}]},{"ID":"20240607143852-lu1osok","Type":"NodeParagraph","Properties":{"id":"20240607143852-lu1osok","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607143852-t2k8e0p","Type":"NodeParagraph","Properties":{"id":"20240607143852-t2k8e0p","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 此外，五加科下列同属植物的茎皮或根皮，在少数地区亦作五加皮使用：①红毛五加的茎皮，使用于四川，参见\"红毛五加皮\"条。②白竻的根皮，使用于西南地区民间，参见\"刺三甲\"条。③乔木五加的根皮，使用于西藏地区。④蜀五加和藤五加的根皮，使用于陕西等地。"}]},{"ID":"20240607143852-06hbwp8","Type":"NodeParagraph","Properties":{"id":"20240607143852-06hbwp8","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"考诸《本草》记载，五加皮当以上述五加科植物五加的根皮为正。但市场上使用较广者，为萝藦科植物杠柳的根皮，商品习称\"香加皮\"或\"北五加皮\"。其性状不同，应予区。参见\"香加皮\"条。"}]},{"ID":"20240607143852-u5lw40t","Type":"NodeParagraph","Properties":{"id":"20240607143852-u5lw40t","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607143852-bw30oq9","Type":"NodeParagraph","Properties":{"id":"20240607143852-bw30oq9","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607143852-ejghimy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143852-ejghimy","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"《中华本草》：五加皮"}]},{"ID":"20240607143852-ijlp23z","Type":"NodeParagraph","Properties":{"id":"20240607143852-ijlp23z","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607143852-jb3ywud","Type":"NodeParagraph","Properties":{"id":"20240607143852-jb3ywud","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" Wǔ Jiā Pí"}]},{"ID":"20240607143852-vr04x6r","Type":"NodeParagraph","Properties":{"id":"20240607143852-vr04x6r","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607143852-zi9rjxa","Type":"NodeParagraph","Properties":{"id":"20240607143852-zi9rjxa","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 南五加皮、五谷皮、红五加皮"}]},{"ID":"20240607143852-f9ls7fq","Type":"NodeParagraph","Properties":{"id":"20240607143852-f9ls7fq","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607143852-pmakikh","Type":"NodeParagraph","Properties":{"id":"20240607143852-pmakikh","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" Sessileflower Acanthopanax Bark, Slenderstyle Acanthopanax Bark, Manyprickle Acanto Panax Root, Root-bark of Sessileflower Acanthopanax"}]},{"ID":"20240607143852-qrk05bd","Type":"NodeParagraph","Properties":{"id":"20240607143852-qrk05bd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607143852-robydhz","Type":"NodeParagraph","Properties":{"id":"20240607143852-robydhz","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607143852-9kxudko","Type":"NodeParagraph","Properties":{"id":"20240607143852-9kxudko","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：五加皮，今江、淮、湖南州郡皆有之。春生苗，茎叶俱青，作丛，赤茎，又似藤蔓，高三、五尺，上有黑刺，叶生五叉，作簇者良。四叶、三叶者最多，为次。每一叶下生一刺。三、四月开白花，结细青子，至六月渐黑色。根若荆根，皮黄黑，肉白，骨坚硬。五月、七月采茎，十月采根，阴干用。蕲州人呼为木骨。一说乃有数种，京师、北地者，大片，类秦皮、黄柏辈，平直如板而色白，绝无气味，"}]},{"ID":"20240607143852-4lxguyg","Type":"NodeParagraph","Properties":{"id":"20240607143852-4lxguyg","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607143852-zl76e6l","Type":"NodeParagraph","Properties":{"id":"20240607143852-zl76e6l","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 药材基源：为五加科植物细柱五加和无梗五加的根皮。"}]},{"ID":"20240607143852-sedouj0","Type":"NodeParagraph","Properties":{"id":"20240607143852-sedouj0","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Acanthopanax gracilistylus W. W. Smith2.Acanthopanax sessiliflorus (Rupr. Et Maxim.) Seem."}]},{"ID":"20240607143852-0yqs1rl","Type":"NodeParagraph","Properties":{"id":"20240607143852-0yqs1rl","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后3-4年于夏、秋两季采收，挖取根部，除掉须根，刮皮，抽去木心，晒干或炕干。"}]},{"ID":"20240607143852-gm1fxvx","Type":"NodeParagraph","Properties":{"id":"20240607143852-gm1fxvx","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607143852-xvdql28","Type":"NodeParagraph","Properties":{"id":"20240607143852-xvdql28","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 生态环境：1。生地海拔200-1600m的灌木丛林、林缘、山坡路帝和村落中。"}]},{"ID":"20240607143852-aq3vl8v","Type":"NodeParagraph","Properties":{"id":"20240607143852-aq3vl8v","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"2。生于海拔200-1600m的森林或灌丛中。"}]},{"ID":"20240607143852-26jp4fp","Type":"NodeParagraph","Properties":{"id":"20240607143852-26jp4fp","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于中南、西南及山西、陕西、江苏、安徽、浙江、江西、福建等地。"}]},{"ID":"20240607143852-jmzudhe","Type":"NodeParagraph","Properties":{"id":"20240607143852-jmzudhe","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"2.分布于东北、华北、陕西等地。"}]},{"ID":"20240607143852-4m8hzat","Type":"NodeParagraph","Properties":{"id":"20240607143852-4m8hzat","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607143852-jjzexpi","Type":"NodeParagraph","Properties":{"id":"20240607143852-jjzexpi","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 1.细柱五加 灌木，有时蔓生状，高2-3m。枝灰棕以，无刺或在叶柄基部单生扁平的刺。叶为掌状复叶，在长枝上互生，在短枝上簇生；叶柄长3-8cm，常有细刺；小叶5，稀为3或4，中央一片最大，倒卵形至倒披针形，长3-8cm，宽1-3.5cm，先端尖或短渐尖，基部楔形，两面无毛，或沿脉上疏生刚毛，下面脉腋间有淡棕色簇毛，边缘有细锯齿。伞形花序腋生或单生于短枝顶端，直径约2cm；总花梗长1-2cm；花梗长6-10mm；萼5齿裂；花黄绿色，花瓣5，长圆状卵形，先端尖，开放时反郑；雄蕊5，花丝细长；子房2室，花柱2，分离或基部合生，柱头圆状状。核果浆果状，扁球形，直径5-6mm，成熟时黑色，宿存花柱反曲。种子2粒，细小，淡褐色。花期4-7月，果期7-10月。"}]},{"ID":"20240607143852-ohxrrcr","Type":"NodeParagraph","Properties":{"id":"20240607143852-ohxrrcr","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"2.无梗五加 灌木或小乔木，高2-5m。树皮暗灰色或黑色，有纵裂纹，枝无刺或疏生粗壮刺，平直或弯曲。掌状复叶；柄长3-10cm，无刺或有散生的小刺。小叶3-5，倒卵形或长圆状倒卵形至长圆状披针形，稀为椭圆形，长8-18cm，宽3-7cm，先端渐尖，基部楔形，上面深绿色，下面浅绿色，叶脉及边缘均有刚毛，边端渐尖，基部楔形，上面深绿以，下面浅绿色，叶脉及边缘均有刚毛，边缘有不整齐锯齿。数个至10个头状药序组成圆锥花序，总花梗长5-30mm，必生短柔毛；萼绿色，密生白色绒毛，具5小齿；花深紫色或近于黑褐以，花瓣5，放形，长不及2mm，外面褐短柔毛，以后毛脱落；雄蕊5，长于花瓣；子房2室，花柱全部合生成柱状，仅柱头裂片离生。核果浆果状，卵椭圆形，成熟时黑色，具宿存花柱。花期6-8月，果期8-9月。"}]},{"ID":"20240607143852-exbpug9","Type":"NodeParagraph","Properties":{"id":"20240607143852-exbpug9","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607143852-92tq3hy","Type":"NodeParagraph","Properties":{"id":"20240607143852-92tq3hy","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温和湿润气候，耐荫蔽、耐寒。宜选向阳较潮湿的山坡、丘陵、洒边、土层深厚肥沃，排水良好，稍带酸性的冲积土或砂质壤土栽培。不宜在砾质土、粘质土或沙土上种植。"}]},{"ID":"20240607143852-nptzcq4","Type":"NodeParagraph","Properties":{"id":"20240607143852-nptzcq4","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子和扦插繁殖。种子繁殖：春、秋季均可播种，但以秋播各子萌发率高。秋播在10月或11月，春播在3月下旬至4月上旬。条播，行距33cm开沟，将种子均匀撒入，覆土约1cm稍加镇压，浇水，保持湿润，5月上旬出苗。培育1-2年移栽。扦插繁殖：在6-8月剪取枝条（南方多在春秋季扦插）。截成10-15cm长，插入砂土中，保持适当温度约15-20d可生根成活，于秋季或第2年春季定植。移栽按行株距各60cm开穴，每穴栽苗1株，填细土压紧、浇水。"}]},{"ID":"20240607143852-azozio4","Type":"NodeParagraph","Properties":{"id":"20240607143852-azozio4","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"田间管理 每年中耕除草、追肥2-3次，第1次在成活返青后，第2次在6月下旬，均施入畜粪水；第3次在冬季落叶后，开沟施入堆肥或厩肥，施后盖土。"}]},{"ID":"20240607143852-5exixvk","Type":"NodeParagraph","Properties":{"id":"20240607143852-5exixvk","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"病虫害防治 蚜虫5-7月发生，为定嫩梢及叶片，可用40%乐果乳油800-1500倍液防治。"}]},{"ID":"20240607143852-av568w0","Type":"NodeParagraph","Properties":{"id":"20240607143852-av568w0","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607143852-37j68z5","Type":"NodeParagraph","Properties":{"id":"20240607143852-37j68z5","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 ⑴细柱五加 根皮呈不规则又郑或单郑筒状，有的呈块片状，长4-15cm，直径0.5-1.5cm，厚1-4mm。外表面灰棕色或灰褐色，有不规则裂纹或纵皱纹及横长皮孔；内表面共同白色或灰黄色，有细纵纹。体轻，质脆，断面不整齐，灰白色或灰黄色。气微香，味微辣而苦。"}]},{"ID":"20240607143852-w4nx91w","Type":"NodeParagraph","Properties":{"id":"20240607143852-w4nx91w","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"以皮厚、气香、断面灰白色为佳。"}]},{"ID":"20240607143852-6vx68sk","Type":"NodeParagraph","Properties":{"id":"20240607143852-6vx68sk","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"⑵无梗五加 根皮圆柱形或切成不规则块片。皮厚0.5-1mm。外表面灰褐色棕褐以，有纵向皱纹，皮孔色略浅，横向明显隆起。茎皮暗灰色或灰黑色；嫩茎上有刺，呈扁锥形，多数剥落，皮孔点状或径向椭圆形。气微香，味淡。"}]},{"ID":"20240607143852-0qbxfes","Type":"NodeParagraph","Properties":{"id":"20240607143852-0qbxfes","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"显微鉴别 （1）细柱五加 根皮横切面：木栓层7-14列。皮层细胞2-4列，散有树脂道。韧皮部射线宽1-8列细胞，韧皮部的树脂道，排列成3-5（-8）环层，树脂道呈椭圆形或条椭圆形，长径60-225（-420）μm，直径14-24μm，周围分泌细胞4-5个，扁长方形，内含淡黄色分泌物，靠内侧的树脂道多为类圆形，直径14-20μm。皮层和韧皮部薄壁细胞含草酸钙簇晶上径12-60μm，棱角粗大，少数锐尖，射线细胞中簇晶较小，常数个或十数个径向排列成行。薄壁细胞含淀粉粒，单粒椭圆形或类球形，直径8-14μm。较老根皮中有韧皮纤维，长240-600μm，胞腔窄，孔汉明显。（2）无梗五加 根皮横切面：木栓层12-20列。皮层3-4列。韧皮射线宽1-3列细胞，波状弯曲，细胞壁具网状纹理，韧皮部树脂道较多，椭圆形或类圆形，长径40-116μm，直径32-50μm周围分泌细胞4-8个。薄壁细胞中簇晶直径8-20（-40）μm韧皮部偶见单个或2-7个成束的纤维散在。纤维长220-600μm，直径20-50μm，孔沟明显。"}]},{"ID":"20240607143852-blsqrga","Type":"NodeParagraph","Properties":{"id":"20240607143852-blsqrga","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"茎皮横切面：木栓层厚20-25列，有的木栓细胞壁增厚显层纹。厚角细胞5-6列。韧皮部有纤维束，断续散在于射线间，纤维长600-1500（-2000）μm，树脂道较少，多分布于纤维束外侧，薄壁细胞中簇晶较根皮少。"}]},{"ID":"20240607143852-6iv6i60","Type":"NodeParagraph","Properties":{"id":"20240607143852-6iv6i60","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607143852-x1e8ehi","Type":"NodeParagraph","Properties":{"id":"20240607143852-x1e8ehi","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 急性毒性：小鼠20±2g，雌雄各半，分成若干组，每组10只，按1：5等比灌胃南五加Ⅰ或南五加Ⅱ1次，待用药浓度都提高到相当生药480g/kg时，观察3天，动物均无死亡。亚急性毒性：选用健康未成年大鼠（90g左右，雌雄兼有）和成年家兔（（1.5kg左右，雌雄兼有），每天灌胃南五加Ⅰ或南五加Ⅱ，连续30天，大鼠60、6g/kg；家兔12、12g/kg（均按生药量），结果：血象、肝、肾功能及主要内脏的形态学检查及动物体重等均没有发现明显的异常,南五加萜酸小鼠半数致死量静脉注射为200mg±18mg/kg。南五加总皂甙给小鼠灌胃20g/kg，1小时后小鼠活动减少，于给药后2小时，小鼠活动正常，观察48h无异常。"}]},{"ID":"20240607143852-7845cjw","Type":"NodeParagraph","Properties":{"id":"20240607143852-7845cjw","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"小鼠皮下注射刺五加甙E的半数致死量为4.75g/kg。刺五加总黄酮的半数致死量为89.8mg/kg。刺五加提取物的半数致死量在10-30g/kg。刺五加根、茎、叶各部分水提取物对小鼠的平均致死量为14.5g。大鼠口服刺五加甙（10mg/kg/天），连续2mo，检查它们血和尿的化合物及器官的重量，动物没有显示出明显的毒性反应。长期服用刺五加毒性甚小，且不影响入睡与正常睡眠。连续服用刺五加提取物6mo除能延长平均寿命外，未发现胚胎毒性或致畸作用。小白鼠1次腹腔注射未脱脂制剂半数致死量为13g/kg，其半数致死量的1/3即能产生抗炎作用，因此，无梗五加的毒性并不大。毒性低，对正常生理功能干扰小。如刺五加总甙的毒性即很低，其半数致死量为4.75g/kg（小鼠皮下注射）。"}]},{"ID":"20240607143852-hi9hdk6","Type":"NodeParagraph","Properties":{"id":"20240607143852-hi9hdk6","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"毒性：刺五加总甙对小鼠的半数致死量为4.75g/kg。100%煎剂用平板纸片法，对金黄色葡萄球菌、绿脓杆菌有抑制作用。"}]},{"ID":"20240607143852-cez8417","Type":"NodeParagraph","Properties":{"id":"20240607143852-cez8417","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607143852-h15libz","Type":"NodeParagraph","Properties":{"id":"20240607143852-h15libz","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 细柱五加根皮含丁香甙（syringin)，刺五加甙（eleutheroside)B1，即是异春皮定-α-D-葡萄糖甙（isofraxidin-α-D-glucoside)，右旋芝麻素（sesamin)，16α-羟基-（-）-贝壳松-19-酸[16α-hydroxy-(-)-kauran-19-oic acid)[2],β-谷甾醇（β-sitosterol)，β-谷甾醇葡萄糖甙（β-sitosterol glucoside)，硬脂酸（stearc acid)[1][1]，棕榈酸（palmitic acid)，亚麻酸（linolenic acid)及维生素A、B1等[3]。还包含挥发渍，内有4-甲基水杨醛（4-methyl salicylaldehyde)等成分[3]。"}]},{"ID":"20240607143852-vn50hkd","Type":"NodeParagraph","Properties":{"id":"20240607143852-vn50hkd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"无梗五加 根及根皮含左旋芝麻素、左旋洒维宁（savinin)[4]，还含无梗五加甙（acanthoside)A、B、C、D、K2、K3[5-7]，其中甙A和甙C的结构尚不清楚，甙B和甙D分别是丁香树脂酚（syrinaresinol)的单葡萄糖甙和双葡萄糖甙，它们都属于木脂体类，甙K2和甙K3则都属于三萜类。又含β-谷甾醇，胡萝卜甙（daucosterin(即是β-谷甾醇葡萄糖甙，豆甾醇（stig-masterol)，莱油甾醇（campesterol)[7，8]，水深性多糖和碱性多糖[9]，强心甙及微量挥发油[10]。"}]},{"ID":"20240607143852-ogo97ww","Type":"NodeParagraph","Properties":{"id":"20240607143852-ogo97ww","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607143852-fi95uze","Type":"NodeParagraph","Properties":{"id":"20240607143852-fi95uze","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 一、刺五加药理作用：1.对中枢神经系统的作用：刺五加对中枢神经的兴奋和抑制过程均有影响，单独1次给药显示出中枢神经系统的刺激作用，连续给药则显示出强壮作用。刺五加不仅改善兴奋过程，而且也加强抑制过程，使抑制趋于集中，使分化更完全，增加大脑皮层的内抑制过程。它的兴奋作用原理不同于苯丙胺类的化合物，不仅毒性低，而且不扰乱正常的睡眠，刺五加对神经系统的兴奋或抑制与用药时神经系统的功能状态和剂量大小颇有关系。"}]},{"ID":"20240607143852-toonz6p","Type":"NodeParagraph","Properties":{"id":"20240607143852-toonz6p","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"1.1.兴奋作用：在兔的脑电图上显示出刺五加提取物能削弱水合氯醛、巴比妥及氯丙嗪的抑制作用，并对中枢神经系统有人参样明显的兴奋作用。刺五加提取物还可缩短乙醚的麻醉过程和提高乙醚或水合氯醛麻醉结束后的兴奋性。"}]},{"ID":"20240607143852-hnr8b1n","Type":"NodeParagraph","Properties":{"id":"20240607143852-hnr8b1n","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"1.2.抑制作用：刺五加提取物对中枢神经系统有镇静作用。能延长己烯醛麻醉时间，降低己烯醛麻醉后的兴奋性。"}]},{"ID":"20240607143852-xyuypjn","Type":"NodeParagraph","Properties":{"id":"20240607143852-xyuypjn","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"1.3.抗惊厥作用：在部分实验中，在动物死之前的数分钟注射饱和氯化钠固定，会提高伸肌挛缩的程度；如在动物固定前1小时先给刺五加，则中毒鼠的痉挛状态明显减少。"}]},{"ID":"20240607143852-zuelta7","Type":"NodeParagraph","Properties":{"id":"20240607143852-zuelta7","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"2.抗疲劳作用：刺五加根的提取物和甙类均有抗疲劳作用。甙的作用较相提取物为强，较人参提取物及人参甙为强。腹腔注射刺五加醇浸膏水溶液20g/kg，平均延长小鼠游泳时间1/4。刺五加茎皮水提物500mg/kg及其丁香树脂酚-二-o-B-D-葡萄糖甙50mg/kg均能显着延长大鼠负荷游泳时间。以小鼠爬绳试验测定刺五加根在不同生长时期的生理活性，显示：5月份1g干根为79SUA33/g（兴奋作用单位），7月份活性明显下降，到8月份落叶前可达到最大值116SUA33/g。刺五加叶也显示类似变化（SUA33：实验动物与对照动物比较，延缓衰竭时33%的剂量为1个SUA33）。刺五加根和叶的提取物分别可提高大鼠活动能量25%和70%。"}]},{"ID":"20240607143852-ertwiti","Type":"NodeParagraph","Properties":{"id":"20240607143852-ertwiti","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"3.抗癌作用：刺五加根的提取物和总甙对动物实验性的移植瘤、药物诱发瘤、癌的转移和小鼠自发白血病都有一定的抑制作用，还能减轻抗癌药物的毒性。在大鼠、小鼠身上接种肉瘤180及肉瘤256瘤种，刺五加对肉瘤的生长有一个较弱的抑制作用（4-28%）。刺五加提取物可降低小鼠移植艾氏腹水癌的阳性率和缩小癌的病灶，提高噻替派对移植和发展的艾氏腹水癌的作用。不能改变大鼠接种瓦克氏腹水肉瘤的移植阳性率，但能缩小肺上的病灶。能使小鼠接种LID-1及其他一些癌的移植阳性率减少，能抑制由尿烷引起的肺腺瘤,减少6一MTU引起的甲状腺癌和由吲哚引起的小鼠骨髓性白血病。降低小鼠自发乳腺癌及自发白血病的形成过程。服用环磷酰胺后的小鼠，再服用刺五加提取物可提高动物的生存时间和存活率。但当与环磷酰胺同时给接种肉瘤180的小鼠服用时，刺五加则对环磷酰胺的毒性和抗癌作用均无影响。刺五加还可抑制小鼠SSK肉瘤和大鼠瓦克瘤的扩散。减少氢化可的松在小鼠接种艾氏腹水癌后的血源性扩散作用。能降低大鼠瓦克氏瘤和小鼠肉瘤180对环磷酰胺、乙基巴比妥的毒性作用的敏感性。能使患白血病的小鼠服甲乙基巴比妥的半数致死量从30mg/kg提高到46mg/kg，并能降低由乙基巴比妥和环磷酰胺在实验动物身上引起的慢性中毒症状，如动物的体重、胸腺、肾上腺的重量及白细胞和嗜酸细胞数等方面均有改善。"}]},{"ID":"20240607143852-sni475y","Type":"NodeParagraph","Properties":{"id":"20240607143852-sni475y","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"4.适应原样的作用：4.1.刺五加能增加机体的非特异性抵抗力刺五加对各种有害刺激因素，如物理的（寒冷、灼热、过重或失重、过度运动或强迫性不动、离心及放射）、化学的（各种化学物质）、生物的不良影响，均能增加机体的抵抗能力。刺五加能增加动物抵抗放射的能力，对一次急性X线照射或多次慢性照射，均有抗放射作用。如长期照射（总剂量1620-7000r），刺五加可延长大白鼠生命二倍，并能改善血相。与抗菌素一起使用可延长被照射60天（总剂量3000r）的大鼠的生命三倍。对红细胞遭受放射样作用物质侵害时有保护作用，可作为放射损伤的预防和治疗药。刺五加注射液可促进经一次总量为4GY的60Co射线照射，造成造血系统放射损伤后小鼠的细胞结构的恢复。刺五加能拮抗罗布毒素C的抑制免疫的作用。对蜱媒脑炎有特殊的抗病毒免疫力。刺五加还可减少青蛙因注入洋地黄毒甙引起的死亡数，提高机体对磷酸三甲苯酚酯和士的宁的解毒能力。刺五加提取物能增加毛细血管在低气压下的防御能力，和降低人体由于冷和血液中血红蛋白的含量而引起的发病频率。刺五加花果醇提物、挥发油，刺五加总黄酮均有耐缺氧作用少量服用刺五加根浸液对高温劳动者的主要系统的新陈代谢过程和劳动能力有良好的影响，而增大剂量则体温升高、排汗量、肺活量和二氧化碳呼出量均增大，氧消耗升高，肾上腺皮质的糖皮质激素和雄性激素都能相对地和绝对地上升。并能提高机体对温度变化（高温、冷冻）的适应力。每天服刺五加流浸膏1ml/kg，可提高母鸡产蛋率2.2倍。"}]},{"ID":"20240607143852-jp6c8cv","Type":"NodeParagraph","Properties":{"id":"20240607143852-jp6c8cv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"4.2.刺五加能调节病理过程，使其趋于正常化能使因化学因素、生物因素引起的红细胞、白细胞的增多和减少恢复正常。如由硝酸钴引起的红细胞增多及苯肼引起的红细胞降低，刺五加均能使之恢复正常。在麻醉猫实验中，刺五加使降低的血压很快回到正常。刺五加甙则有降压作用。刺五加能调节内分泌功能紊乱。既能阻止促肾上腺皮质激素引起的肾上腺增生，又可减少由可的松引起的萎缩。既可防止甲状腺素引起的甲状腺肥大，又可防止甲基硫尿嘧啶引起的甲状腺萎缩。既能使食物性及肾上腺性的高血糖症的血糖降低到正常，也可使胰岛素引起的低血糖症的血糖增加。能降低由四氧嘧啶引起的大鼠糖尿病的尿糖量及防止大鼠体重下降，并对此糖尿病的发展有截阻作用。能阻止相应的内分泌重量的变化，但不影响它们的分解代谢作用。刺五加能改变机体应激反应警戒期的病理过程，防止在此过程中的肾上腺增生，胆甾醇含量降低，胸腺缩小及胃出血情况减少。抗警戒期作用以刺五加甙E为最强，刺五加甙B1较弱，而刺五加甙C则无作用。刺五加还能产生应激反应的抵抗期，大鼠在此期间除肾上腺肥大，胆甾醇含量、脾脏和动物外观均正常，体重甚至比没有游泳的大鼠增长还快一些。在应激反应的衰竭期中刺五加可阻止肾上腺缩小，胆甾醇降低，胸腺、脾脏、肝脏、肾脏及心脏的重量相对降低。"}]},{"ID":"20240607143852-xzeetzs","Type":"NodeParagraph","Properties":{"id":"20240607143852-xzeetzs","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"5.抗衰老作用：刺五加喂饲22月龄大鼠2月后，红细胞脂质过氧化物降低17.75、Na+，K+-ATP酶活性升高17.42%，提示有一定抗衰老作用。"}]},{"ID":"20240607143852-crzkkrv","Type":"NodeParagraph","Properties":{"id":"20240607143852-crzkkrv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"6.对心血管系统的作用：麻醉猫皮下或者静脉注射刺五加提取物能扩张脑血管改善大脑的供血量。刺五加甙只有在大剂量时才能看到此作用。此外，结扎颈动脉或脑动脉引起的犬的急性贫血后，马上给药（1mg/（kg.天），皮下），连续2周，可缓和上述原因引起的贫血、降低的血压和降低的血红蛋白、红细胞数，以及改善所伴随的疾病和代偿性局部贫血的心电图。刺五加提取物及其基叶的乙醇提取液对血小板聚集有很强的抑制作用。刺五加浸膏还有抗心律失常作用，使正常窦律时间增加，使异常动作电位显着减少。刺五加提取物能减弱家兔心肌缺血组织损害，促进表面细胞的再生和心肌梗塞区域的恢复。"}]},{"ID":"20240607143852-77o3ijm","Type":"NodeParagraph","Properties":{"id":"20240607143852-77o3ijm","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"7.抗菌消炎作用：刺五加对切除肾上腺的小鼠，在夏、秋和冬季可减轻热性发炎性水肿，在春季稍有消炎作用。对切除肾上腺的大鼠，在冬天和春天能阻止甲醛性关节炎症的发展。能减轻生理盐水和15%蛋白溶液引起的炎症。用李司忒氏菌感染的小鼠和兔注射刺五加提取物后，第一个小时是降低了动物对感染的抵抗力，随后明显地提高了对感染的抵抗力，所以认为它有提高机体肠道杆菌的能力。"}]},{"ID":"20240607143852-oqwnb2e","Type":"NodeParagraph","Properties":{"id":"20240607143852-oqwnb2e","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"8.对内分泌系统的作用：给静止和游泳15分钟后的大鼠服用刺五加未见明显增加肾上腺素及血液中的可的松类激素的含量。但在5小时游泳后，则明显地增加可的松的含量。有报道给药后对肾上腺内部组织没有明显改变，而对肾上腺的嗜铬组织有直接显着的作用。刺五加根提取物及刺五加甙均有促性腺作用。雄性幼鼠服用根提取物和叶中分离到的总甙或者刺五加甙B、B1和E，均增加了体重以及精囊与前列腺重量和RNA含量。甙在去势雄性动物身上有预防精囊和前列腺的萎缩作用，对雌性小鼠有明显的促雌性激素作用，而且促进小鼠性早熟和体重增加。服用刺五加提取物后母鸡产蛋量可提高20.4%，蛋的重量提高24%，并增加输卵管中总氮量和蛋白质，这种母鸡的蛋孵出的小鸡提高了氮和蛋白质的新陈代谢。刺五加叶的制剂能防止兔子进食氧化的葵花籽油所造成的性机能降低，精子的浓度和活动能力降低以及减少雌兔的自然流产和死亡。防止由于氧化脂肪引起的少毛发和口周坏死以及肝、心脏的病理变化，而维生素E很少有此作用。"}]},{"ID":"20240607143852-5jd4ywr","Type":"NodeParagraph","Properties":{"id":"20240607143852-5jd4ywr","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"9.免疫增强作用：刺五加多糖（PES.）及其甙B（紫丁香甙）、D和E（两种构型的紫丁香树脂酚甙）均能明显提高细胞产生诱生干扰素的能力，对S801和S7811白血病细胞系的促诱生能力以PES（纯品）最佳，PES及其甙B、D、E次之。Op刺五加（50g/kg）对皮下注射环磷酰胺引起的白血球减少症有保护作用，对苯引起的小鼠和兔的白血球减少症亦有显着的预防作用。腹腔注射刺五加注射液可抑制环磷酰胺所致的白细胞减少。刺五加多糖对B细胞功能重建有较好的效果，并可减轻环磷酰胺引起的白细胞减少，明显增强小鼠脾分泌IgM和IgG的溶血空斑试验和小鼠对牛血清蛋白诱导的迟发型超敏反应性。刺五加能增强网状内皮系统的吞噬能力、腹腔巨噬细胞的吞噬能力，提高玫瑰花结的百分率1.2-1.8倍。刺五加多糖能明显增加CTL杀伤靶细胞的活性，促进ConA刺激的小鼠脾细胞分泌白细胞介素-210.其它作用：刺五加能提高人的嗜酸细胞、a-球蛋白的血浆浓度、血红细胞的数目和血中碱储量。刺五加多糖对CCl4与硫化乙酰胺所致鼠肝脏中毒有明显改善，并能促进机体抗感染的能力，对结核菌感染有一定的抵御作用还有抗利尿作用。"}]},{"ID":"20240607143852-r0yukyc","Type":"NodeParagraph","Properties":{"id":"20240607143852-r0yukyc","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"二、无梗五加的药理作用：1.抗炎作用：辽宁产无梗五加的根皮，用乙醇提取之未脱脂制剂及脱脂制剂，对大白鼠的蛋清性及甲醛性关节炎均表现抑制作用，连续5天皮下注射未脱脂制剂0.75g/kg/日的抑制蛋清性肿胀作用，与连续5天肌肉注射考的松7.5mg/kg/日的抑制作用相似。未脱脂制剂分别由皮下或腹腔注射于切除肾上腺的大白鼠，对蛋清性肿胀无抑制作用，因此短梗五加的抗炎作用与肾上腺有密切关系。此外短梗五加亦能降低家兔的血管通透性。"}]},{"ID":"20240607143852-jtjmzu9","Type":"NodeParagraph","Properties":{"id":"20240607143852-jtjmzu9","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"2.镇痛、解热作用：小白鼠腹腔注射上述这2种制剂，均表现镇痛作用，与吗啡相比作用较缓和，但在家兔实验无解热作用。"}]},{"ID":"20240607143852-0oyjqa0","Type":"NodeParagraph","Properties":{"id":"20240607143852-0oyjqa0","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"3.对心血管的影响：未脱脂制剂对离体蟾蜍心脏有明显的抑制作用，于蟾蜍在位心则使心率减慢，脱脂制剂对离体心脏使频率减少，对在位心脏则仅使幅度减少。二种制剂均能使麻醉兔血压下降。"}]},{"ID":"20240607143852-aqpvv0u","Type":"NodeParagraph","Properties":{"id":"20240607143852-aqpvv0u","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"4.其他作用：两种制剂对家兔离体肠管及子宫均有兴奋作用，受孕子宫更敏感。对正常家兔的脑电图有轻度的激活作用，如以小鼠活动作指标，五加皮甙的兴奋作用较其流浸膏强40-140倍。能削弱水合氯醛、巴比妥及氯丙嗪的抑制作用,增强大脑皮层的内抑制过程；在急性试验中，仅引起轻度的血压降低；总之，在增强机体非特异性抵抗力的剂量，不引起正常功能的显着变化。但在机体抵抗力下降或遇额外负担而有特殊需要时，却能增加体力或智力工作的效能。与苯丙胺类药物不同，不但毒性较低，而且不引起兴奋，不扰乱正常的睡眠。适应原的作用原理可能与改变一般应激反应的过程有关，刺五加可阻止应激反应警戒期所特有的解剖及生化学改变，如肾上腺增生，胆甾醇含量降低、胸腺缩小及胃出血等。此种抗警戒期作用，以刺五加甙E为最强，而刺五加甙B1则较弱，而刺五加甙C则几无作用，故作用与一定的化学结构有关。刺五加也能阻止动物在应激反应衰竭期中所出现的肾上腺、胸腺、脾、肝及肾等的重量降低。这些动物实验说明，适应原的作用与应激反应不同，其作用完全是向着对机体有利的方向进行的，应激反应是一种非特异性反应，机体有许多器官与系统参与；同样，适应原也具有多方面的作用，它既影响神经系统、心血管系统，又影响其他许多生理指标。适应原的作用原理正在进一步研究，现已有些试验证明，它对细胞及对蛋白质、核酸生物合成过程有某些影响。如刺五加可刺激某些原虫、细菌和酵母细胞的生长繁殖，对红细胞遭受放射样作用物质侵害时有保护作用，它还有抗氧化剂的作用，刺激免疫体的形成等；在一定条件下，对大鼠有降血糖作用。"}]},{"ID":"20240607143852-ufav213","Type":"NodeParagraph","Properties":{"id":"20240607143852-ufav213","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607143852-4tctqaf","Type":"NodeParagraph","Properties":{"id":"20240607143852-4tctqaf","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，用水洗净，稍润后切片，干燥。炒制：取原药材，用微火炒至变色。酒制：将五加皮片与黄酒拌匀，闷润至酒尽时，取出，晾干，每五加皮500g，用黄酒60g，亦可用酒洗。《本草述钩元》：五加皮，剥去骨，阴干酒洗，或用姜汁制。"}]},{"ID":"20240607143852-12oe3jm","Type":"NodeParagraph","Properties":{"id":"20240607143852-12oe3jm","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607143852-kg27ge2","Type":"NodeParagraph","Properties":{"id":"20240607143852-kg27ge2","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱：（1）取本品0.5g，加氯仿10ml，超声波振荡30min，取1ml，供点样用。另取β-谷甾醇、异贝壳杉烯酸d-芝麻素作对照品。分别点要于硅胶G板上，以甲苯-已醇已酯-丙酮（3.5：0.5：0.5)展开，10%硫酸喷雾，吹热气流显色，供试液以谱在与对照品以谱相应位置显相同颜色的斑点。（2）取本品0.5g，包滤纸内，加70%已醇液10ml，浸泡过夜，热水中超声波振荡30min，溶液浓缩至干，再加甲醇1ml溶解，供点样用。另取刺五加甙D、紫丁香甙（或B）、胡萝卜甙（或A）国对照品，以氯仿-甲醇-（6：3：1下层液）展开，10%硫酸喷雾，吹热气流显色，供试液色谱在与对照品色色谱相应位置，应显相同颜色斑点。"}]},{"ID":"20240607143852-ajom7o5","Type":"NodeParagraph","Properties":{"id":"20240607143852-ajom7o5","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607143852-lhtypl3","Type":"NodeParagraph","Properties":{"id":"20240607143852-lhtypl3","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 归肝；肾经"}]},{"ID":"20240607143852-mxkqpff","Type":"NodeParagraph","Properties":{"id":"20240607143852-mxkqpff","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607143852-3g80kz0","Type":"NodeParagraph","Properties":{"id":"20240607143852-3g80kz0","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；微甘；性温"}]},{"ID":"20240607143852-74xtmyd","Type":"NodeParagraph","Properties":{"id":"20240607143852-74xtmyd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607143852-q0qct8k","Type":"NodeParagraph","Properties":{"id":"20240607143852-q0qct8k","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 阴虚火旺者慎服。"}]},{"ID":"20240607143852-v2abbkg","Type":"NodeParagraph","Properties":{"id":"20240607143852-v2abbkg","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607143852-t4iznc5","Type":"NodeParagraph","Properties":{"id":"20240607143852-t4iznc5","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 祛风湿；补肝肾；强筋骨；活血脉。主风寒湿痹；腰膝疼痛；筋骨痿软；小数点儿行迟；体虚赢弱；跌打损伤；骨折；水肿；脚气；阴下湿痒"}]},{"ID":"20240607143852-k66rrtv","Type":"NodeParagraph","Properties":{"id":"20240607143852-k66rrtv","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607143852-to7qwse","Type":"NodeParagraph","Properties":{"id":"20240607143852-to7qwse","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g，鲜品加倍；浸酒或入丸、散。外用：适量，煎水熏洗或为末敷。"}]},{"ID":"20240607143852-kdaw5hb","Type":"NodeParagraph","Properties":{"id":"20240607143852-kdaw5hb","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607143852-2ggbqtw","Type":"NodeParagraph","Properties":{"id":"20240607143852-2ggbqtw","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 1.五加酒(《备急千金要方》)：用治产后癖瘦。2.油煎散(《太平惠民和剂局方》)，治妇人血风劳，形容憔悴，肢体困倦，喘满虚烦，呼吸少气，发热汗多，口干舌涩，不思饮食。3.五加皮汤(《三因极一病症方论》)，主治肾劳虚寒，恐虑失志，伤精损髓，嘘吸短气，遗泄白浊，小便赤黄，阴下湿痒，腰脊如折，颜色枯悴。4.五皮散(《太平惠民和剂局方》)。5.五加皮丸(《瑞竹堂经验方》)，主治男子妇人脚气，骨节皮肤肿湿疼痛。"}]},{"ID":"20240607143852-w45xwwj","Type":"NodeParagraph","Properties":{"id":"20240607143852-w45xwwj","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607143852-eewbu71","Type":"NodeParagraph","Properties":{"id":"20240607143852-eewbu71","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主心腹疝气，腹痛，益气疗蹩，小儿不能行，疽疮阴蚀。"}]},{"ID":"20240607143852-aphtihu","Type":"NodeParagraph","Properties":{"id":"20240607143852-aphtihu","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：五加皮，观《本经》所主诸证，皆因风寒湿邪伤于（足少阴、厥阴）二经之故，而湿气尤为最也。《经》云，伤于湿者，下先受之。又云，地之湿气，感则害人皮肉筋脉。肝肾居下而主筋骨，故风寒湿之邪，多自二经先受，此药辛能散风，温能除寒，苦能燥湿，二脏得其气而诸证悉瘳矣。又湿气浸淫，则五脏筋脉缓纵；湿气留中，则虚赢气乏。湿邪既去，则中焦治而筋骨自坚，气日益而中自补也。其主益精强志者，肾藏精与志也。"}]},{"ID":"20240607143852-jpv94ls","Type":"NodeParagraph","Properties":{"id":"20240607143852-jpv94ls","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"3.《别录》：疗男子阴痿，囊下湿，小便余沥，女人阴痒及腰脊痛，两脚疼痹风弱，五缓虚赢，补中益精，坚筋骨，强志意。"}]},{"ID":"20240607143852-osss3sd","Type":"NodeParagraph","Properties":{"id":"20240607143852-osss3sd","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：能破逐恶风血，四肢不遂，贼风伤人，软脚，暨腰，主多年瘀血在皮肌，治痹湿内不足，主虚赢，小儿三岁不能行。"}]},{"ID":"20240607143852-vina496","Type":"NodeParagraph","Properties":{"id":"20240607143852-vina496","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：明目，下气，治中风骨节挛急，补五劳七伤。"}]},{"ID":"20240607143852-ez077hw","Type":"NodeParagraph","Properties":{"id":"20240607143852-ez077hw","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：治风湿痿痹，壮筋骨。"}]},{"ID":"20240607143852-23dgchq","Type":"NodeParagraph","Properties":{"id":"20240607143852-23dgchq","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"7.《本草再新》：化痰除湿，养肾益精，去风消水，理脚气腰痛，治疮疥诸毒。"}]},{"ID":"20240607143852-oh9n1kg","Type":"NodeParagraph","Properties":{"id":"20240607143852-oh9n1kg","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"8.《陕西中草药》：活血消肿，治风湿关节痛，阴囊湿疹，跌打损伤，水肿，小便不利。"}]},{"ID":"20240607143852-ode559z","Type":"NodeParagraph","Properties":{"id":"20240607143852-ode559z","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"9.《云南中草药》：治跌打损伤，骨折，疮毒，疟疾。"}]},{"ID":"20240607143852-mcg08u2","Type":"NodeParagraph","Properties":{"id":"20240607143852-mcg08u2","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"10.《药性类明》：两脚疼痹，风湿也。五加皮苦泄辛散，能治风湿。《药性论》言其破逐恶风血。破逐恶风血，即治痹之义也。丹溪治风湿脚痛加减法云，痛甚加五加皮。可见其逐恶血之功大也。"}]},{"ID":"20240607143852-qd4mhb5","Type":"NodeParagraph","Properties":{"id":"20240607143852-qd4mhb5","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"11.《本草求真》：五加皮，脚气之病，因于风寒湿三气而成，风胜则筋骨为之拘挛。湿胜则筋脉为之缓纵，男子阴痿囊湿，女子阴痒虫生，小儿脚软。寒胜则血脉为之凝滞，筋骨为之疼痛，而脚因尔莫行。服此辛苦而温，辛则气顺而化痰，苦则坚骨而益精，温则祛风而胜湿，凡肌肤之瘀血，筋骨之风邪，靡不因此而治。盖湿去则骨壮，风去则筋强，而脚安有不理者乎。但此虽属理脚之剂，仍不免有疏泄之虞，须于此内参以滋补之药，则用之历久而不变矣。"}]},{"ID":"20240607143852-1tck6q8","Type":"NodeParagraph","Properties":{"id":"20240607143852-1tck6q8","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"12.《本草思辨录》：五加皮，宜下焦风湿之缓证。若风湿搏于肌表，则非其所司。古方多浸酒酿酒，及酒调末服之，以行药势。心疝少腹有形为寒，肺热生痿躄为热，《本经》并主之。五加皮辛苦而温，惟善化湿耳。化其阴淫之湿，即驱其阳淫之风。风去则热已，湿去则寒除。即《别录》之疗囊湿、阴痒、小便余沥、腰脚痛痹、风弱、五缓，皆可以是揆之。"}]},{"ID":"20240607143852-pce5x15","Type":"NodeParagraph","Properties":{"id":"20240607143852-pce5x15","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607143852-8v67j99","Type":"NodeParagraph","Properties":{"id":"20240607143852-8v67j99","updated":"20240607143852"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607143853-x16oqe1","Type":"NodeThematicBreak","Properties":{"id":"20240607143853-x16oqe1"}},{"ID":"20240607143854-r67i4qg","Type":"NodeParagraph","Properties":{"id":"20240607143854-r67i4qg"}}]}