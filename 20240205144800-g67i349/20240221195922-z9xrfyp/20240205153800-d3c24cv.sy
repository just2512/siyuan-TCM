{"ID":"20240205153800-d3c24cv","Spec":"2","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153800-d3c24cv","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153800-d3c24cv\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206135456-syls7f2\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607143854-r67i4qg\u0026quot;,\u0026quot;scrollTop\u0026quot;:1600,\u0026quot;focusId\u0026quot;:\u0026quot;20240620160430-7b8gw6l\u0026quot;,\u0026quot;focusStart\u0026quot;:5,\u0026quot;focusEnd\u0026quot;:6\u0026#125;","title":"103五加皮","type":"doc","updated":"20240809145035"},"Children":[{"ID":"20240710101256-jhqnouz","Type":"NodeParagraph","Properties":{"id":"20240710101256-jhqnouz","updated":"20240710101300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"细柱五加"}]},{"ID":"20240206135456-syls7f2","Type":"NodeParagraph","Properties":{"id":"20240206135456-syls7f2","updated":"20240206135504"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于湖北、河南、安徽、四川等地区。\n【性状】\t本品呈不规则卷筒状。外表面灰揭色，有稍扭曲的纵皱纹和横长皮孔样斑痕；内表皮淡黄色或灰黄色，有细纵纹。体轻，质脆，易折断，断面不整齐，灰白色，气微香，味微辣而苦。\n【性味】\t辛、苦，温。\n【功效】\t祛风除湿，补益肝肾，强筋壮骨，利水消肿。用于风湿痹病，筋骨痿软，小儿行迟，体虚乏力，水肿，脚气。"}]},{"ID":"20240206135457-26pv8hh","Type":"NodeParagraph","Properties":{"id":"20240206135457-26pv8hh","updated":"20240206135457"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206135457-csmt5j0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205160951-2i99gzq","Type":"NodeParagraph","Properties":{"id":"20240205160951-2i99gzq","updated":"20240205160951"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮-20240205160951-81pjar2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620160320-s0beira","Type":"NodeParagraph","Properties":{"id":"20240620160320-s0beira","updated":"20240809134454"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 361px;","style":"width: 351px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"细柱五加 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/细柱五加 5-20240710101405-7j6l0iw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 351px;\" parent-style=\"width: 361px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 440px;","style":"width: 430px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 1-20240809134452-pabkkke.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 430px;\" parent-style=\"width: 440px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809140526-t5k17im","Type":"NodeParagraph","Properties":{"id":"20240809140526-t5k17im","updated":"20240809141531"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 629px;","style":"width: 619px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 7-20240809140211-izpc5kt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 619px;\" parent-style=\"width: 629px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 561px;","style":"width: 551px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 10-20240809141531-p687mmd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 551px;\" parent-style=\"width: 561px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809142500-lvg854j","Type":"NodeParagraph","Properties":{"id":"20240809142500-lvg854j","updated":"20240809142500"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 394px;","style":"width: 384px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 3-20240809135409-kaqzmoy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 384px;\" parent-style=\"width: 394px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 318px;","style":"width: 308px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 4-20240809135606-y3gpp11.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 308px;\" parent-style=\"width: 318px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 429px;","style":"width: 419px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五加皮 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五加皮 5-20240809135736-j9hwivc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKram