deCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 290px;\" parent-style=\"width: 300px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 302px;","style":"width: 292px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑寄生 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑寄生 10-20240811092034-bcczdt8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 292px;\" parent-style=\"width: 302px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 332px;","style":"width: 322px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑寄生 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑寄生 11-20240811092130-mm6ygi5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 322px;\" parent-style=\"width: 332px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 313px;","style":"width: 303px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"桑寄生 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/桑寄生 12-20240811092230-wfthb1m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 303px;\" parent-style=\"width: 313px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240617110905-5wgx15q","Type":"NodeParagraph","Properties":{"id":"20240617110905-5wgx15q","updated":"20240809172049"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：桑寄生就是寄生在桑树上的一种寄生类植物，寄生位置呈瘤状。点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240206102751-ifaikpu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"桑椹（桑葚）"}]},{"ID":"20240809172432-cwcw2vv","Type":"NodeParagraph","Properties":{"id":"20240809172432-cwcw2vv","updated":"20240809172551"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：桑寄生要用寄生在桑树上的；"}]},{"ID":"20240617110905-pdp0spo","Type":"NodeThematicBreak","Properties":{"id":"20240617110905-pdp0spo"}},{"ID":"20240617110917-wuiu404","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110917-wuiu404","updated":"20240617110921"},"Children":[{"Type":"NodeText","Data":"桑上寄生《神农本草经》"}]},{"ID":"20240617110917-6qmjcxa","Type":"NodeParagraph","Properties":{"id":"20240617110917-6qmjcxa","updated":"20240617110917"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240617110917-o2jfh67","Type":"NodeParagraph","Properties":{"id":"20240617110917-o2jfh67","updated":"20240617110917"},"Children":[{"Type":"NodeText","Data":"主腰痛，小儿背强，痈肿，安胎，充肌肤，坚发齿，长须眉，其实明目，轻身通神。一名寄屑，一名寓木，一名宛童。生川谷。"}]},{"ID":"20240617110917-ygtw69v","Type":"NodeParagraph","Properties":{"id":"20240617110917-ygtw69v","updated":"20240617110917"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名茑，生宏农桑树上，三月三日，采茎，阴干。"}]},{"ID":"20240617110917-bw1yktj","Type":"NodeParagraph","Properties":{"id":"20240617110917-bw1yktj","updated":"20240617110917"},"Children":[{"Type":"NodeText","Data":"案《说文》云：茑，寄生也；诗曰：茑与女萝，或作樢；《广雅》云：宛童，寄生樢也，又寄屏，寄生也；《中山经》云：龙山上多寓木；郭璞云：寄生也；《尔雅》云：寓木宛童；郭璞云：寄生树一名茑；《毛诗》云：茑与女萝；《传》云：茑，寄生山也；陆玑云：茑，一名寄生，叶似当卢，子如覆盆子，赤黑甜美。"}]},{"ID":"20240617110906-eutvqfx","Type":"NodeThematicBreak","Properties":{"id":"20240617110906-eutvqfx"}},{"ID":"20240617110907-sn7ljb7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110907-sn7ljb7","updated":"20240617110911"},"Children":[{"Type":"NodeText","Data":"桑上寄生《神农本草经赞》"}]},{"ID":"20240617110907-ig1760w","Type":"NodeParagraph","Properties":{"id":"20240617110907-ig1760w","updated":"20240617110907"},"Children":[{"Type":"NodeText","Data":"味苦平。主腰痛。小儿背强痈肿。安胎充肌肤。坚发齿。长须眉。其实明目轻身。通神。一名寄屑。一名寓木。一名宛童。生山谷。"}]},{"ID":"20240617110907-qpie6o4","Type":"NodeParagraph","Properties":{"id":"20240617110907-qpie6o4","updated":"20240617110907"},"Children":[{"Type":"NodeText","Data":"瞻彼菀柔。夤缘苞系。共气分形。缘根附蒂。柳紫稽疑。苕青殊裔。豆实香稠。苍梧酒剂。"}]},{"ID":"20240617110907-af7ge4t","Type":"NodeParagraph","Properties":{"id":"20240617110907-af7ge4t","updated":"20240617110907"},"Children":[{"Type":"NodeText","Data":"诗。菀彼桑柔。唐书传赞。萝茑夤缘。易。系于苞桑。梁元帝书。分形共气。梅尧臣赋。"}]},{"ID":"20240617110907-ttibkbn","Type":"NodeParagraph","Properties":{"id":"20240617110907-ttibkbn","updated":"20240617110907"},"Children":[{"Type":"NodeText","Data":"缘根兮附蒂。群芳谱。柳寄生亦紫藤。书。七稽疑。诗。苕之华。其叶青青。魏志纪。包举殊裔。"}]},{"ID":"20240617110907-yck9la2","Type":"NodeParagraph","Properties":{"id":"20240617110907-yck9la2","updated":"20240617110907"},"Children":[{"Type":"NodeText","Data":"苏颂曰。结子黄绿色。如小豆。汁稠者良。浔梧杂佩。桑寄生酒。出梧州。张正见诗。浮蚁擅苍梧。谓此。"}]},{"ID":"20240607150010-9lyjzzj","Type":"NodeThematicBreak","Properties":{"id":"20240607150010-9lyjzzj"}},{"ID":"20240617110854-1nulg3m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110854-1nulg3m","updated":"20240617110900"},"Children":[{"Type":"NodeText","Data":"桑上寄生《新修本草》"}]},{"ID":"20240617110854-appu3fo","Type":"NodeParagraph","Properties":{"id":"20240617110854-appu3fo","updated":"20240617110854"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主腰痛，小儿背强，痈肿，安胎，充肌肤，坚发齿，长须眉。主金创，去痹，女子崩中，内伤不足，产后余疾，下乳汁。其实明目，轻身通神。一名寄屑，一名寓木，一名宛童，一名葛，生弘农川谷桑树上。三月三日采茎、叶、阴干。"}]},{"ID":"20240617110854-0iuttmr","Type":"NodeParagraph","Properties":{"id":"20240617110854-0iuttmr","updated":"20240617110854"},"Children":[{"Type":"NodeText","Data":"桑上者，名桑上寄生耳。诗人云∶施于松上，方家亦有用杨上、枫上者，则各随其树名之，形类犹是一般，但根津所因处为异。法生树枝间，寄根在枝节之内，叶圆青赤，浓泽易折，旁四月华白，五月实赤，大如小豆。今处处皆有，以出彭城为胜。俗人呼皆为续断用之。案《本经》续断别在上品药，所主疗不同，岂只是一物，市人使混乱无复能甄识之者。服食方云是桑 ，与此说又为不同耳。"}]},{"ID":"20240617110854-irwf7z7","Type":"NodeParagraph","Properties":{"id":"20240617110854-irwf7z7","updated":"20240617110854"},"Children":[{"Type":"NodeText","Data":"〔谨案〕寄生槲、榉柳、水杨、枫等树上，子黄，大如小枣子，唯虢州有桑上者。子汁甚粘，核大如小豆，叶无阴阳，如细柳叶而浓肌，茎粗短，江南人相承用为续断，殊不相关。且寄生实，九月始熟而黄，今称五月实赤，大如小豆，此是陶未见之。"}]},{"ID":"20240617110930-ra5an3n","Type":"NodeThematicBreak","Properties":{"id":"20240617110930-ra5an3n"}},{"ID":"20240617110931-6d92hds","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110931-6d92hds","updated":"20240617110935"},"Children":[{"Type":"NodeText","Data":"桑上寄生《本草崇原》"}]},{"ID":"20240617110931-dukj7j1","Type":"NodeParagraph","Properties":{"id":"20240617110931-dukj7j1","updated":"20240617110931"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主腰痛，小儿背强痈肿，充肌肤，坚发齿，长须眉，安胎。"}]},{"ID":"20240617110931-frl48cm","Type":"NodeParagraph","Properties":{"id":"20240617110931-frl48cm","updated":"20240617110931"},"Children":[{"Type":"NodeText","Data":"（桑寄生始出弘农川谷及近海州邑海外之境，其地暖而不蚕。桑无剪伐之苦，气浓力充，故枝节间有小木生焉，是为桑上寄生，寄生之叶如橘而浓软。寄生之茎，如槐而肥脆。四月开黄白花，五月结黄赤实，大如小豆，有汁稠粘，断茎视之色深黄者良。寄生木枫槲榉柳水杨等树上皆有之。须桑上生者可用。世俗多以寄生他树者伪充，不知气性不同，用之非徒无益，而反有害。一种黄寄生，形如石斛，一种如柴，不黄色者，皆伪也。）"}]},{"ID":"20240617110931-x75b9yj","Type":"NodeParagraph","Properties":{"id":"20240617110931-x75b9yj","updated":"20240617110931"},"Children":[{"Type":"NodeText","Data":"寄生感桑气而寄生枝节间，生长无时，不假土力，夺天地造化之神功。主治腰痛者，腰乃肾之外候，男子以藏精，女子以系胞。寄生得桑精之气，虚系而生，故治腰痛。小儿肾形未足，似无腰痛之证，应有背强痈肿之疾。寄生治腰痛，则小儿背强痈肿，亦能治之。充肌肤，精气外达也。坚发齿，精气内足也。精气外达而充肌肤，则须眉亦长。精气内足而坚发齿，则胎亦安。盖肌肤者，皮肉之余。齿者，骨之余。发与须眉者，血之余。胎者，身之余。以余气寄生之物，而治余气之病，同类相感如此。"}]},{"ID":"20240607150039-byxdb6m","Type":"NodeThematicBreak","Properties":{"id":"20240607150039-byxdb6m"}},{"ID":"20240607150044-pdvjzsw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150044-pdvjzsw","updated":"20240607150048"},"Children":[{"Type":"NodeText","Data":"桑上寄生《神农本草经读》"}]},{"ID":"20240607150044-2r452f8","Type":"NodeParagraph","Properties":{"id":"20240607150044-2r452f8","updated":"20240607150044"},"Children":[{"Type":"NodeText","Data":"气味苦、平，无毒。主腰痛，小儿背强，痈肿。充肌肤，坚发齿，长须眉，安胎。"}]},{"ID":"20240607150044-ccw3dop","Type":"NodeParagraph","Properties":{"id":"20240607150044-ccw3dop","updated":"20240607150044"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶寄生感桑气而寄生枝节间，生长无时，不假土力，夺天地造化之神效，故能资养血脉于空虚之地，而取效倍于他药也。主治腰痛者，腰乃肾之外候，男子以藏精，女子以系胞；寄生得桑精之气，虚系而生，故治腰痛。小儿肾形未足，似无腰痛之证，应有背强痈肿之疾，寄生治腰痛，则小儿背强痈肿亦能治之。充肌肤，精气外达也；坚发齿，精气内足也。精气外达而充肌肤，则须眉亦长；精气内足而坚发齿，则胎亦安。盖肌肤者，皮肉之余；齿者，骨之余；发与须眉者，血之余；胎者，身之余；以余气寄生之物，而治余气之病，同类相感如此。"}]},{"ID":"20240607150010-syhht7o","Type":"NodeThematicBreak","Properties":{"id":"20240607150010-syhht7o"}},{"ID":"20240607150031-5yayjih","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150031-5yayjih","updated":"20240607150037"},"Children":[{"Type":"NodeText","Data":"桑上寄生《本草纲目》"}]},{"ID":"20240607150031-b9ezvwq","Type":"NodeParagraph","Properties":{"id":"20240607150031-b9ezvwq","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"「释名」寄屑、寓木、宛童、鸢。"}]},{"ID":"20240607150031-ten33se","Type":"NodeParagraph","Properties":{"id":"20240607150031-ten33se","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、无毒。"}]},{"ID":"20240607150031-abhc6lr","Type":"NodeParagraph","Properties":{"id":"20240607150031-abhc6lr","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240607150031-n6nyo25","Type":"NodeParagraph","Properties":{"id":"20240607150031-n6nyo25","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"1、膈气。用生桑寄生捣汁一碗服"}]},{"ID":"20240607150031-wcclp2r","Type":"NodeParagraph","Properties":{"id":"20240607150031-wcclp2r","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"2、胎动腹痛。用桑寄生一两半、阿胶（炒）半两、艾叶半两，加水一碗半，煎成一碗，去渣温服。去艾叶亦可。"}]},{"ID":"20240607150031-19m4e9u","Type":"NodeParagraph","Properties":{"id":"20240607150031-19m4e9u","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"3、毒痢脓血。脉搏弱。用桑寄生二两，防风、川芎各二钱半、炙甘草三钱，共研为末。加水一碗，煎至八成。连渣服下。"}]},{"ID":"20240607150031-5vbq0pq","Type":"NodeParagraph","Properties":{"id":"20240607150031-5vbq0pq","updated":"20240607150031"},"Children":[{"Type":"NodeText","Data":"4、下血后元所虚乏、腰膝无力。用桑寄生为末。每服一钱，开水冲下。"}]},{"ID":"20240617110703-xwvb9rp","Type":"NodeThematicBreak","Properties":{"id":"20240617110703-xwvb9rp"}},{"ID":"20240617110704-ehzthcp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110704-ehzthcp","updated":"20240617110709"},"Children":[{"Type":"NodeText","Data":"桑上寄生《本草经集注》"}]},{"ID":"20240617110704-e2sqoji","Type":"NodeParagraph","Properties":{"id":"20240617110704-e2sqoji","updated":"20240617110704"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主治腰痛，小儿背强，痈肿，安胎，充肌肤，坚发齿，长须眉。"}]},{"ID":"20240617110704-1tiqwu0","Type":"NodeParagraph","Properties":{"id":"20240617110704-1tiqwu0","updated":"20240617110704"},"Children":[{"Type":"NodeText","Data":"主金创，去痹，女子崩中，内伤不足，产后余疾，下乳汁。其实∶明目，轻身，通神。一名寄屑，一名寓木，一名宛童，一名茑，生弘农川谷桑树上。三月三日采茎、叶，阴干。"}]},{"ID":"20240617110704-xew6c2n","Type":"NodeParagraph","Properties":{"id":"20240617110704-xew6c2n","updated":"20240617110704"},"Children":[{"Type":"NodeText","Data":"桑上者，名桑上寄生尔。诗人云∶施于松上。方家亦有用杨上、枫上者，则各随其树名之，形类犹是一般，但根津所因处为异。法生树枝间，寄根在枝节之内，叶圆青赤，浓泽易折，傍自生枝节。冬夏生，四月花白，五月实赤，大如小豆。今处处皆有，以出彭城为胜。"}]},{"ID":"20240617110704-4e3atmu","Type":"NodeParagraph","Properties":{"id":"20240617110704-4e3atmu","updated":"20240617110704"},"Children":[{"Type":"NodeText","Data":"世人呼皆为续断用之。案《本经》续断别在中品药，所主治不同，岂只是一物，市人使混乱无复能甄识之者。服食方云是桑 ，与此说又为不同尔。"}]},{"ID":"20240617110953-vpr1uhv","Type":"NodeThematicBreak","Properties":{"id":"20240617110953-vpr1uhv"}},{"ID":"20240617110954-jj2qfpy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110954-jj2qfpy","updated":"20240617111001"},"Children":[{"Type":"NodeText","Data":"桑上寄生《证类本草》"}]},{"ID":"20240617110954-83lm9rs","Type":"NodeParagraph","Properties":{"id":"20240617110954-83lm9rs","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主腰痛，小儿背强（巨两切），痈肿，安胎，充肌肤，坚发齿，长须眉，主金疮，去痹，女子崩中，内伤不足，产后余疾，下乳汁。其实明目，轻身通神。一名寄屑。一名寓木，一名宛童，一名茑（音鸟又音吊）。生弘农川谷桑树上。三月三日采茎、叶，阴干。"}]},{"ID":"20240617110954-5olxa6i","Type":"NodeParagraph","Properties":{"id":"20240617110954-5olxa6i","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶桑上者，名桑上寄生尔。诗人云∶施（音异）于松上，方家亦有用杨上、枫上者，则各随其树名之，形类犹是一般，但根津所因处为异，法生树枝间，寄根在皮节之内。"}]},{"ID":"20240617110954-dk84j78","Type":"NodeParagraph","Properties":{"id":"20240617110954-dk84j78","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"叶圆青赤，浓泽易折。旁自生枝节。冬夏生，四月花白。五月实赤，大如小豆。今处处皆有，以出彭城为胜。俗呼为续断用之，按《本经》续断别在上品药，主疗不同，岂只是一物，市人混杂无识者。服食方是桑 ，与此又不同。唐本注云∶此多生槲、榉、柳、水杨、枫等树上。子黄，大如小枣子。唯虢州有桑上者，子汁甚粘，核大似小豆，叶无阴阳，如细柳叶而浓。晚茎粗短。江南人相承用为续断，殊不相关。且寄生实九月始熟而黄。今称五月实赤，大如小豆，盖陶未见也。臣禹锡等谨按蜀本注云∶按诸树多有寄生，茎、叶并相似，云是乌鸟食一物，子、粪落树上，感气而生。叶如桔而浓软，茎如槐而肥脆。今处处有，方家唯须桑上者。然非自采，即难以别。可断茎而视之，以色深黄者为验。《图经》叶似龙胆而浓阔。"}]},{"ID":"20240617110954-ro2l82e","Type":"NodeParagraph","Properties":{"id":"20240617110954-ro2l82e","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"茎短似鸡脚，作树形。三月、四月花，黄赤色。六月、七月结子，黄绿色，如小豆，以汁稠粘者良也。药性论云∶桑寄生，臣。能令胎牢固，主怀妊漏血不止。日华子云∶助筋骨，益血脉。采人多在榉树上收，呼为桑寄生。在桑上者极少，纵有，形与榉树上者亦不同，次即枫树上，力同榉树上者，黄色。七月、八月采。"}]},{"ID":"20240617110954-amzgd2g","Type":"NodeParagraph","Properties":{"id":"20240617110954-amzgd2g","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"图经曰∶桑寄生，出弘农山谷桑上，今处处有之。云是乌鸟食物，子落枝节间，感气而生。叶似桔而浓软，茎似槐枝而肥脆。三、四月生花，黄白色。六月、七月结实，黄色，如小豆大。三月三日采茎，叶阴干。凡槲、榉、柳、水杨、枫等上，皆有寄生，唯桑上者堪用。"}]},{"ID":"20240617110954-1ccdhhy","Type":"NodeParagraph","Properties":{"id":"20240617110954-1ccdhhy","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"然殊难辨别、医家非自采不敢用。或云断其茎而视之，其色深黄并实中有汁稠粘者为真。谨按《尔雅》∶寓木，宛童。郭璞云∶寄生一名茑。《诗· 弁》云∶茑与女萝。陆机疏云∶叶似当卢，子如覆盆，赤黑，甜美。而中品有松萝条，即女萝也。《诗》所谓茑与女萝，施于松上是也。旧云生熊耳川谷松上。五月采，阴干。古方入吐膈药。今医家鲜用，亦不复采之。"}]},{"ID":"20240617110954-s2lcdq8","Type":"NodeParagraph","Properties":{"id":"20240617110954-s2lcdq8","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"但附于此。"}]},{"ID":"20240617110954-zd9pyn7","Type":"NodeParagraph","Properties":{"id":"20240617110954-zd9pyn7","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，在树上自然生独枝树是也。采得后，用铜刀和根、枝、茎细锉，阴干了任用。勿令见火。"}]},{"ID":"20240617110954-d1ybcah","Type":"NodeParagraph","Properties":{"id":"20240617110954-d1ybcah","updated":"20240617110954"},"Children":[{"Type":"NodeText","Data":"衍义曰∶桑寄生，新旧书云∶今处处有之。从官南北，实处处难得。岂岁岁窠斫摘践之，苦而不能生邪？抑方宜不同也？若以为鸟食物子落枝节间，感气而生，则麦当生麦，谷当生谷，不当但生此一物也。又有于柔滑细枝上生者，如何得子落枝节间？由是言之，自是感造化之气，别是一物。古人当日唯取桑上者，实假其气耳。又云∶今医家鲜用，此极误矣。今医家非不用也。第以难得真桑上者。尝得真桑寄生，下咽必验如神。向承乏吴山，有求药于诸邑者，乃通令人搜摘，卒不可得，遂以实告，甚不药。盖不敢以伪药罔人。邻邑有人，伪以他木寄生送之，服之逾月而死，哀哉！"}]},{"ID":"20240607150011-qth1wrp","Type":"NodeThematicBreak","Properties":{"id":"20240607150011-qth1wrp"}},{"ID":"20240607150019-rq7mo1z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150019-rq7mo1z","updated":"20240607150024"},"Children":[{"Type":"NodeText","Data":"桑寄生《本经逢原》"}]},{"ID":"20240607150019-qevi9ay","Type":"NodeParagraph","Properties":{"id":"20240607150019-qevi9ay","updated":"20240607150019"},"Children":[{"Type":"NodeText","Data":"苦甘平无毒。"}]},{"ID":"20240607150019-ga20u1g","Type":"NodeParagraph","Properties":{"id":"20240607150019-ga20u1g","updated":"20240607150019"},"Children":[{"Type":"NodeText","Data":"《本经》主腰痛，小儿背强，痈肿，充饥肤，坚发齿，长须眉，安胎。"}]},{"ID":"20240607150019-7w40mo2","Type":"NodeParagraph","Properties":{"id":"20240607150019-7w40mo2","updated":"20240607150019"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"寄生得桑之余气而生，性专祛风、逐湿、通调血脉。故《本经》取治妇人腰痛、小儿背强等病，血脉通调而肌肤眉发皆受其荫，即有痈肿，亦得消散矣。古圣触物取象，以其寓形榕木，与子受母气无异，故为安胎圣药。《别录》言去女子崩中产后余疾，亦是去风除湿益血补阴之验。惟西蜀、南粤不经饲蚕之地始有，故真者绝少，今世皆榕树枝赝充，慎勿误用，其真者绝不易得。故古方此味之下有云，如无以续断代之，于此可以想象其功用也。"}]},{"ID":"20240607145959-yixxh4g","Type":"NodeThematicBreak","Properties":{"id":"20240607145959-yixxh4g"}},{"ID":"20240607150005-yo5i4jy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150005-yo5i4jy","updated":"20240607150009"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草择要纲目》"}]},{"ID":"20240607150005-9oc4gdu","Type":"NodeParagraph","Properties":{"id":"20240607150005-9oc4gdu","updated":"20240607150005"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240607150005-qdv42wq","Type":"NodeParagraph","Properties":{"id":"20240607150005-qdv42wq","updated":"20240607150005"},"Children":[{"Type":"NodeText","Data":"苦平无毒．"}]},{"ID":"20240607150005-0bph7go","Type":"NodeParagraph","Properties":{"id":"20240607150005-0bph7go","updated":"20240607150005"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240607150005-41lfoc4","Type":"NodeParagraph","Properties":{"id":"20240607150005-41lfoc4","updated":"20240607150005"},"Children":[{"Type":"NodeText","Data":"腰痛小儿背强痈肿．去女子崩中不足．安胎及产后余疾．下乳汁．助筋骨．益血脉．"}]},{"ID":"20240607145939-tf9hded","Type":"NodeThematicBreak","Properties":{"id":"20240607145939-tf9hded"}},{"ID":"20240607145953-o80pedt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145953-o80pedt","updated":"20240607145957"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草图经》"}]},{"ID":"20240607145953-q3bwjh6","Type":"NodeParagraph","Properties":{"id":"20240607145953-q3bwjh6","updated":"20240607145953"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桑寄生（图缺）"},{"Type":"NodeText","Data":"，出弘农山谷桑上，今处处有之。云是乌鸟食物，子落枝节间，感气而生。叶似橘而浓软，茎似槐枝而肥脆；三、四月生花，黄白色；六月、七月结实，黄色如小豆大。三月三日采茎叶，阴干。凡槲、榉、柳、水杨、枫等上，皆有寄生，惟桑上者堪用。然殊难辨别。"}]},{"ID":"20240607145953-qh6gh6h","Type":"NodeParagraph","Properties":{"id":"20240607145953-qh6gh6h","updated":"20240607145953"},"Children":[{"Type":"NodeText","Data":"医家非自采不敢用。或云断其茎而视之，其色深黄，并实中有汁稠粘者为真。谨按《尔雅》∶寓木、宛童。郭璞云∶寄生，一名茑。《诗· 弁》云∶茑与女萝。陆机疏云∶叶似当卢子如覆盆，赤黑甜美。而中品有松萝条，即女萝也。《诗》所谓茑与女萝，施于松上，是也。"}]},{"ID":"20240607145953-7ro5j04","Type":"NodeParagraph","Properties":{"id":"20240607145953-7ro5j04","updated":"20240607145953"},"Children":[{"Type":"NodeText","Data":"旧云生熊耳川谷松上，五月采，阴干。古方入吐膈药。今医家鲜用，亦不复采之。但附于此。"}]},{"ID":"20240607145940-6j5yffj","Type":"NodeThematicBreak","Properties":{"id":"20240607145940-6j5yffj"}},{"ID":"20240607145941-lcmn5na","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145941-lcmn5na","updated":"20240607145946"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草衍义》"}]},{"ID":"20240607145941-4t35px4","Type":"NodeParagraph","Properties":{"id":"20240607145941-4t35px4","updated":"20240607145941"},"Children":[{"Type":"NodeText","Data":"新旧书云∶今处处有之。从宦南北，实处处难得，岂岁岁窠斫摘践之苦，而不能生邪？抑方宜不同也？若以为鸟食物子落枝节间，感气而生，则麦当生麦，谷当生谷，不当但生此一物也。又有于柔滑细枝上生者，如何得子落枝节间？由是言之，自是感造化之气，别是一物。古人当日惟取桑上者，实假其气耳。又云今医家鲜用，此极误矣。今医家非不用也，第以难得真桑上者。尝得真桑寄生，下咽必验如神。向承乏吴山，有求药于诸邑者，乃遍令人搜摘，卒不可得，遂以实告，甚不乐。盖不敢以伪药罔人。邻邑有人伪以他木寄生送之，服之逾月而死。哀哉！"}]},{"ID":"20240607145913-q5t01t5","Type":"NodeThematicBreak","Properties":{"id":"20240607145913-q5t01t5"}},{"ID":"20240607145920-t6qfa53","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145920-t6qfa53","updated":"20240607145932"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草便读》"}]},{"ID":"20240607145922-49g0cx5","Type":"NodeParagraph","Properties":{"id":"20240607145922-49g0cx5","updated":"20240607145928"},"Children":[{"Type":"NodeText","Data":"壮骨强筋．补肝肾虚羸．苦甘平润．和营通络．治痹风痛着．关节舒和．且其养血疏风．得附大桑之余气．又可安胎治产．都因寓木以生成．（桑寄生即桑树上所附之藤．然种类不一．总以桑树上者为佳．甘苦性平．凡藤类像筋．故入肝又及于肾者．乙葵同源也．以其得桑之余气．故能治风兼治湿者．风能胜湿也．统治筋骨间风寒湿痹．此物祛邪之力有余．补养之功不足．所云补虚羸．益血脉者．亦邪除则正受益耳．）"}]},{"ID":"20240607145902-m6va022","Type":"NodeThematicBreak","Properties":{"id":"20240607145902-m6va022"}},{"ID":"20240607145905-93udl1d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145905-93udl1d","updated":"20240607145912"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草易读》"}]},{"ID":"20240607145905-ix780k9","Type":"NodeParagraph","Properties":{"id":"20240607145905-ix780k9","updated":"20240607145905"},"Children":[{"Type":"NodeText","Data":"益血安胎，止崩下乳。平痈肿而治金疮，强筋骨而疗腰痛。"}]},{"ID":"20240607145849-ehl1i2k","Type":"NodeThematicBreak","Properties":{"id":"20240607145849-ehl1i2k"}},{"ID":"20240607145855-qigwhn1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145855-qigwhn1","updated":"20240607145901"},"Children":[{"Type":"NodeText","Data":"桑寄生《医学入门》"}]},{"ID":"20240607145855-8a7tz92","Type":"NodeParagraph","Properties":{"id":"20240607145855-8a7tz92","updated":"20240607145855"},"Children":[{"Type":"NodeText","Data":"桑寄生平苦苦味，主腰背强祛风废，痈肿金疮皆可疗，下乳止崩安胎坠。"}]},{"ID":"20240607145855-kyeuf7t","Type":"NodeParagraph","Properties":{"id":"20240607145855-kyeuf7t","updated":"20240607145855"},"Children":[{"Type":"NodeText","Data":"近海地暖，不蚕桑木气浓，枝叶上自然生出，非因鸟食子落而生也。无毒。主背腰腿脚遍身骨节疼痛，祛风痹顽麻废疾，痈肿金疮皆疗。又治妇人崩中不止，胎前漏血，产后乳难，小儿背强，实明目轻身通神。"}]},{"ID":"20240607145855-2pkx1e6","Type":"NodeParagraph","Properties":{"id":"20240607145855-2pkx1e6","updated":"20240607145855"},"Children":[{"Type":"NodeText","Data":"深黄色并实中有汁稠粘者真。忌火忌铁。误服他木寄生杀人。"}]},{"ID":"20240607145855-mjgi09n","Type":"NodeParagraph","Properties":{"id":"20240607145855-mjgi09n","updated":"20240607145855"},"Children":[{"Type":"NodeText","Data":"以上清热润燥药。"}]},{"ID":"20240607145833-9x7u5j1","Type":"NodeThematicBreak","Properties":{"id":"20240607145833-9x7u5j1"}},{"ID":"20240607145840-7e4shj6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145840-7e4shj6","updated":"20240607145844"},"Children":[{"Type":"NodeText","Data":"桑寄生《玉楸药解》"}]},{"ID":"20240607145840-mbux2ug","Type":"NodeParagraph","Properties":{"id":"20240607145840-mbux2ug","updated":"20240607145840"},"Children":[{"Type":"NodeText","Data":"味苦，气平，入足少阴肾、足厥阴肝经。壮骨荣筋，止血通乳。"}]},{"ID":"20240607145840-w3t2uf6","Type":"NodeParagraph","Properties":{"id":"20240607145840-w3t2uf6","updated":"20240607145840"},"Children":[{"Type":"NodeText","Data":"桑寄生通达经络，驱逐湿痹，治腰痛背强，筋痿骨弱，血崩乳闭胎动，腹痛痢疾，金疮痈疽，坚发齿，长眉须。"}]},{"ID":"20240607145527-ly2ihxt","Type":"NodeThematicBreak","Properties":{"id":"20240607145527-ly2ihxt"}},{"ID":"20240607145825-t3pll0y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145825-t3pll0y","updated":"20240607145831"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草求真》"}]},{"ID":"20240607145825-qbka127","Type":"NodeParagraph","Properties":{"id":"20240607145825-qbka127","updated":"20240607145825"},"Children":[{"Type":"NodeText","Data":"（寓木）补肝肾除风湿强筋骨"}]},{"ID":"20240607145825-0df5o1k","Type":"NodeParagraph","Properties":{"id":"20240607145825-0df5o1k","updated":"20240607145825"},"Children":[{"Type":"NodeText","Data":"桑寄生（专入肝肾）。感桑精气而生。味苦而甘。性平而和。不寒不热。号为补肾补血要剂。缘肾主骨发。主血。苦入肾。肾得补则筋骨有力。不致痿痹而酸痛矣。甘补血。血得补则发受其灌荫。而不枯脱落矣。故凡内而腰痛筋骨笃疾胎堕。外而金疮肌肤风湿。何一不借此以为主治乎？第出桑树生者真。（须自采。或连桑叶者乃可用。）和茎叶细锉阴干。忌火。服则其效如神。若杂树所出。性气不同。恐反有害。"}]},{"ID":"20240607145745-iqxwo6o","Type":"NodeThematicBreak","Properties":{"id":"20240607145745-iqxwo6o"}},{"ID":"20240607145808-xv5d55c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145808-xv5d55c","updated":"20240607145818"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草备要》"}]},{"ID":"20240607145808-jmhs6vp","Type":"NodeParagraph","Properties":{"id":"20240607145808-jmhs6vp","updated":"20240607145808"},"Children":[{"Type":"NodeText","Data":"补筋骨，散风湿"}]},{"ID":"20240607145808-j4ndo7w","Type":"NodeParagraph","Properties":{"id":"20240607145808-j4ndo7w","updated":"20240607145808"},"Children":[{"Type":"NodeText","Data":"苦坚肾，助筋骨而固齿、长发（齿者骨之余，发者血之余）。甘益血，止崩漏而下乳、安胎（三症皆由血虚）。外科散疮疡，追风湿。"}]},{"ID":"20240607145808-vc0rlgs","Type":"NodeParagraph","Properties":{"id":"20240607145808-vc0rlgs","updated":"20240607145808"},"Children":[{"Type":"NodeText","Data":"他树多寄生，以桑上采者为真，杂树恐反有害。茎、叶并用。忌火。"}]},{"ID":"20240607145746-d5z8xx4","Type":"NodeThematicBreak","Properties":{"id":"20240607145746-d5z8xx4"}},{"ID":"20240607145753-o1kn6zr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145753-o1kn6zr","updated":"20240607145800"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草述钩元》"}]},{"ID":"20240607145753-g9hlfft","Type":"NodeParagraph","Properties":{"id":"20240607145753-g9hlfft","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"此是乌鸟食一物子。粪落树上。感气而生。诸树多有寄生。茎叶并相似。但须桑上者。方合用。非自采即难以别。可断茎视之。色深黄者为验。（保升）近海州邑及海外境土。"}]},{"ID":"20240607145753-saxu1j1","Type":"NodeParagraph","Properties":{"id":"20240607145753-saxu1j1","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"其地暖而不蚕。桑无采捋之苦。气浓意浓。自然生出。何尝节间可容他子耶。（丹溪）气味苦甘平。益血脉。助筋骨。治腰痛。（是血脉虚衰不能通行者）主妊娠漏血不止。"}]},{"ID":"20240607145753-xqt2l0n","Type":"NodeParagraph","Properties":{"id":"20240607145753-xqt2l0n","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"令胎牢固。愈崩中内伤不足。产后余疾。小儿背强痈肿。疗腰背腿脚遍身骨节疼痛。祛风痹顽麻。本草桑叶桑枝皆能治血。寄生得其气。故能益血脉。（类明）本于桑而抽其精英。功用。比桑尤胜。所治诸证。皆由血虚有热致然。此药性能益血。兼能祛湿。（仲淳）凡风湿作痛之证。古方用独活寄生汤。盖以主病者为君。二味俱能去风。胜湿也。若辨认未明。以杂木寄生为桑寄生。又用土当归假代川独活。两性俱燥。耗卫败营。无益有损。近茭山。吴氏。辨认独活。原本羌活一种。以节密轻虚者为羌。节疏重实者为独。川续断与桑寄生气味略异。主治颇同。不得寄生。即加续断。便名。羌活续断汤。使医者不泥于专名。病家勿误于伪药。其意殊善。（嘉谟）同枸杞当归牛膝续断地黄胡麻首乌。治血虚手臂骨节疼痛。胎动腹痛。桑寄生一两半。阿胶炒半两。艾叶半两。水煎温服。或去艾叶。以其热也。毒痢脓血。六脉微小。并无寒热。宜以桑寄生二两。芎防各三钱半。炙甘草三铢。为散。每用二钱。"}]},{"ID":"20240607145753-vibz14z","Type":"NodeParagraph","Properties":{"id":"20240607145753-vibz14z","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"水煎八分。和渣服。下血止后。但觉丹田元气虚泛。腰膝沉重少力。桑寄生为末。每用一钱。"}]},{"ID":"20240607145753-l5su8bd","Type":"NodeParagraph","Properties":{"id":"20240607145753-l5su8bd","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"非时白汤点服。小便频数。猝然溲血不止。并不疼痛。此缘心中机谋积恶。奸险嫉妒。多积忿气。伤损肝心。又因色伤。小肠气虚。其血乘虚妄行故也。宜用桑寄生一两。熟地茯苓各半两。人参川芎独活蒲黄各二钱半。甘松沉香各八分四厘。为细末。每用三钱匕。水一盏。"}]},{"ID":"20240607145753-9fzmin9","Type":"NodeParagraph","Properties":{"id":"20240607145753-9fzmin9","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"煎一二沸。便倾出。去渣。不时服。服后其血已安。惟觉丹田元气之虚。腰膝沉困少力。宜再取桑寄生细末一二钱。非时点服补之。"}]},{"ID":"20240607145753-t63nm0b","Type":"NodeParagraph","Properties":{"id":"20240607145753-t63nm0b","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"〔论〕桑之气味甘寒。其所寄生之物。何以功用尤胜。盖热能伤血。寒能泣血。此之转化为寄生者。即以其转化为优。而功懋于血脉。诚如缪氏所云。不寒不热。可以疗虚也。至于血热之治。殊未然。但可以言桑耳。"}]},{"ID":"20240607145753-mkqwr1h","Type":"NodeParagraph","Properties":{"id":"20240607145753-mkqwr1h","updated":"20240607145753"},"Children":[{"Type":"NodeText","Data":"不得真者不用。寇氏言有误服他木寄生。其人逾月而毙者。慎之。忌火忌铁。"}]},{"ID":"20240607145603-4ktglnb","Type":"NodeThematicBreak","Properties":{"id":"20240607145603-4ktglnb"}},{"ID":"20240607145738-nn5bt49","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145738-nn5bt49","updated":"20240607145744"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草分经》"}]},{"ID":"20240607145738-ws4tmy8","Type":"NodeParagraph","Properties":{"id":"20240607145738-ws4tmy8","updated":"20240607145738"},"Children":[{"Type":"NodeText","Data":"苦甘，坚肾和血，舒筋络散风湿。"}]},{"ID":"20240607145723-zdopjsf","Type":"NodeThematicBreak","Properties":{"id":"20240607145723-zdopjsf"}},{"ID":"20240607145728-zzhihem","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145728-zzhihem","updated":"20240607145733"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草撮要》"}]},{"ID":"20240607145728-4ljth3j","Type":"NodeParagraph","Properties":{"id":"20240607145728-4ljth3j","updated":"20240607145728"},"Children":[{"Type":"NodeText","Data":"味甘苦．入足少阴经．功专坚肾．助筋骨．固齿长发．益血止崩．下乳安胎．和血除痹．外科散疮疡．追风湿．得阿胶、艾叶治胎动腹痛．以之捣汁服．治膈气．忌火．"}]},{"ID":"20240607145640-qgx9zpc","Type":"NodeThematicBreak","Properties":{"id":"20240607145640-qgx9zpc"}},{"ID":"20240607145714-1b0lapx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145714-1b0lapx","updated":"20240607145721"},"Children":[{"Type":"NodeText","Data":"桑寄生《本草从新》"}]},{"ID":"20240607145714-nucvbrf","Type":"NodeParagraph","Properties":{"id":"20240607145714-nucvbrf","updated":"20240607145714"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补筋骨、散风湿．"}]},{"ID":"20240607145714-1rpqubx","Type":"NodeParagraph","Properties":{"id":"20240607145714-1rpqubx","updated":"20240607145714"},"Children":[{"Type":"NodeText","Data":"苦坚肾．助筋骨而固齿长发．甘益血．止崩漏而下乳安胎．舒筋络而利关节．和血脉而除痹痛．外科散疮疡．追风湿．海外深山地暖．不蚕桑．无采捋之苦．气化浓密．自然生出．有言鸟衔他子．遗树而生者非也．他树多寄生．恐反有害．茎叶并用．忌火．（胎动腹痛、桑寄生两半、阿胶、艾叶各半两、水盏半、煎一盏、去滓温服、或去艾叶、又治膈气、生桑寄生、捣汁一盏服之．）以上寓木类．"}]},{"ID":"20240607145603-u3a1ex4","Type":"NodeThematicBreak","Properties":{"id":"20240607145603-u3a1ex4"}},{"ID":"20240607145628-ky3zdgc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145628-ky3zdgc","updated":"20240607145638"},"Children":[{"Type":"NodeText","Data":"桑寄生《中药学》"}]},{"ID":"20240607145628-p4wuwg3","Type":"NodeParagraph","Properties":{"id":"20240607145628-p4wuwg3","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为桑寄生科植物槲寄生的枝茎。（桑寄生、柿寄生也供药用）"}]},{"ID":"20240607145628-r0qn2y4","Type":"NodeParagraph","Properties":{"id":"20240607145628-r0qn2y4","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，平。入肝、肾经。"}]},{"ID":"20240607145628-36r9mki","Type":"NodeParagraph","Properties":{"id":"20240607145628-36r9mki","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【功效】补肝肾，除风湿，强筋骨，安胎。"}]},{"ID":"20240607145628-7mbaqpu","Type":"NodeParagraph","Properties":{"id":"20240607145628-7mbaqpu","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于风湿腰痛，关节不利，筋骨酸痛等症。"}]},{"ID":"20240607145628-3wfqjc4","Type":"NodeParagraph","Properties":{"id":"20240607145628-3wfqjc4","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"本品既能袪风湿，又能补肝肾、强筋骨，对风湿腰痛、筋骨酸痛属于肝肾不足者，常与独活、牛膝等药配伍应用。"}]},{"ID":"20240607145628-h7sd1w5","Type":"NodeParagraph","Properties":{"id":"20240607145628-h7sd1w5","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"2.用于妇人怀孕胎漏、胎动不安等症。"}]},{"ID":"20240607145628-6jmhcew","Type":"NodeParagraph","Properties":{"id":"20240607145628-6jmhcew","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"本品有补肝肾而兼养血安胎的功效，用于妇人胎漏、胎动不安，常与续断、阿胶等配伍。"}]},{"ID":"20240607145628-jiiytk5","Type":"NodeParagraph","Properties":{"id":"20240607145628-jiiytk5","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"此外，本品又有降压作用，近年来临床上常用于高血压。"}]},{"ID":"20240607145628-puqo620","Type":"NodeParagraph","Properties":{"id":"20240607145628-puqo620","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【处方用名】桑寄生（洗净，晒干，切碎用）。"}]},{"ID":"20240607145628-rxh7bn1","Type":"NodeParagraph","Properties":{"id":"20240607145628-rxh7bn1","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240607145628-27ihmak","Type":"NodeParagraph","Properties":{"id":"20240607145628-27ihmak","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【方剂举例】寿胎丸《衷中参西录》：菟丝子、桑寄生、续断、阿胶。主治滑胎。"}]},{"ID":"20240607145628-9hgyv66","Type":"NodeParagraph","Properties":{"id":"20240607145628-9hgyv66","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主腰痛，小儿背强，痈肿，充肌肤，坚发齿，长须眉，安胎。」"}]},{"ID":"20240607145628-28sulxy","Type":"NodeParagraph","Properties":{"id":"20240607145628-28sulxy","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"《别录》：「去女子崩中，内伤不足，产后余疾，下乳汁，主金疮，去痹。」"}]},{"ID":"20240607145628-3yozn72","Type":"NodeParagraph","Properties":{"id":"20240607145628-3yozn72","updated":"20240607145628"},"Children":[{"Type":"NodeText","Data":"《药性本草》：「主怀妊漏血不止，令胎牢固。」"}]},{"ID":"20240607145527-sxym6pv","Type":"NodeThematicBreak","Properties":{"id":"20240607145527-sxym6pv"}},{"ID":"20240607145554-181h0w6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145554-181h0w6","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"《中国药典》：桑寄生"}]},{"ID":"20240607145554-ev8d0uj","Type":"NodeParagraph","Properties":{"id":"20240607145554-ev8d0uj","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607145554-3qlcsj0","Type":"NodeParagraph","Properties":{"id":"20240607145554-3qlcsj0","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" Sānɡ Jì Shēnɡ"}]},{"ID":"20240607145554-f0suwio","Type":"NodeParagraph","Properties":{"id":"20240607145554-f0suwio","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607145554-nt1ewjp","Type":"NodeParagraph","Properties":{"id":"20240607145554-nt1ewjp","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 寄生、桑上寄生"}]},{"ID":"20240607145554-1qoj7oq","Type":"NodeParagraph","Properties":{"id":"20240607145554-1qoj7oq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607145554-wu1yw00","Type":"NodeParagraph","Properties":{"id":"20240607145554-wu1yw00","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" HERBA TAXILLI"}]},{"ID":"20240607145554-tkdywv4","Type":"NodeParagraph","Properties":{"id":"20240607145554-tkdywv4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607145554-fcgpyr4","Type":"NodeParagraph","Properties":{"id":"20240607145554-fcgpyr4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 本品为桑寄生科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桑寄生"},{"Type":"NodeText","Data":"Taxillus chinensis （DC.）Danser 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带叶茎枝"},{"Type":"NodeText","Data":"。冬季至次春采割，除去粗茎，切段，干燥，或蒸后干燥。"}]},{"ID":"20240607145554-xotee3a","Type":"NodeParagraph","Properties":{"id":"20240607145554-xotee3a","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607145554-ikofke8","Type":"NodeParagraph","Properties":{"id":"20240607145554-ikofke8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 本品茎枝呈圆柱形，长3～4cm，直径0。2～1cm；表面红褐色或灰褐色，细纵纹，并有多数细小凸起的棕色皮孔，嫩枝有的可见棕褐色茸毛；质坚硬，断面不整齐，皮部红棕色，木部色较浅。叶多卷曲，具短柄；叶片展平后呈卵形或椭圆形，长3～8cm，宽2～5cm；表面黄褐色，幼叶被细茸毛，先端钝圆，基部圆形或宽楔形，全缘；革质。无臭，味涩。"}]},{"ID":"20240607145554-xmecco2","Type":"NodeParagraph","Properties":{"id":"20240607145554-xmecco2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607145554-4ov5f3u","Type":"NodeParagraph","Properties":{"id":"20240607145554-4ov5f3u","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240607145554-s9gb6bf","Type":"NodeParagraph","Properties":{"id":"20240607145554-s9gb6bf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607145554-dpbplsw","Type":"NodeParagraph","Properties":{"id":"20240607145554-dpbplsw","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 除去杂质，略洗，润透，切厚片，干燥。"}]},{"ID":"20240607145554-4vrtvei","Type":"NodeParagraph","Properties":{"id":"20240607145554-4vrtvei","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607145554-mvpebo8","Type":"NodeParagraph","Properties":{"id":"20240607145554-mvpebo8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" （1）本品茎横切面：表皮细胞有时残存。木栓层为10余列细胞，有的含棕色物。皮层窄，老茎有石细胞群，薄壁细胞含棕色物。中柱鞘部位有石细胞群及纤维束，断续环列。韧皮部甚窄，射线散有石细胞。束内形成层明显。木质部射线宽1～4列细胞，近髓部也可见石细胞；导管单个散列或2～3个相聚。髓部有石细胞群，薄壁细胞含棕色物。有的石细胞含草酸钙方晶或棕色物。粉末淡黄棕色。石细胞类方形、类圆形，偶有分枝，有的壁三面厚，一面薄，含草酸钙方晶。纤维成束，直径约17μm 。具缘纹孔、网纹及螺纹导管多见。星状毛分枝碎片少见。"}]},{"ID":"20240607145554-rcsvqpk","Type":"NodeParagraph","Properties":{"id":"20240607145554-rcsvqpk","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末5g，加甲醇－水（1:1）60ml ，加热回流1 小时，趁热滤过，滤液浓缩至约20ml后，加水10ml，再加稀硫酸约0。5ml，煮沸回流1 小时后，用醋酸乙酯振摇提取2次，每次30ml，合并醋酸乙酯液，浓缩至约1ml，作为供试品溶液。另取槲皮素对照品，加醋酸乙酯制成每1ml 含0。5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各10μl，分别点于同一用 0。5％氢氧化钠溶液制备的硅胶Ｇ薄层板上，以甲苯（水饱和）－甲酸乙酯－甲酸（5:4:1）为展开剂，展开，取出，晾干，喷以5％三氯化铝乙醇溶液，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240607145554-xdmxpyx","Type":"NodeParagraph","Properties":{"id":"20240607145554-xdmxpyx","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607145554-2dx56fv","Type":"NodeParagraph","Properties":{"id":"20240607145554-2dx56fv","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607145554-3j65ck3","Type":"NodeParagraph","Properties":{"id":"20240607145554-3j65ck3","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607145554-6ykk1ew","Type":"NodeParagraph","Properties":{"id":"20240607145554-6ykk1ew","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 苦、甘，平。"}]},{"ID":"20240607145554-uan8y6j","Type":"NodeParagraph","Properties":{"id":"20240607145554-uan8y6j","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607145554-0vcibho","Type":"NodeParagraph","Properties":{"id":"20240607145554-0vcibho","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强筋骨，祛风湿，安胎元。用于风湿痹痛，腰膝酸软，筋骨无力，崩漏经多，妊娠漏血，胎动不安；高血压。"}]},{"ID":"20240607145554-yyvu6a9","Type":"NodeParagraph","Properties":{"id":"20240607145554-yyvu6a9","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607145554-8fwap8k","Type":"NodeParagraph","Properties":{"id":"20240607145554-8fwap8k","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240607145554-3cba3ro","Type":"NodeParagraph","Properties":{"id":"20240607145554-3cba3ro","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607145554-d0b35bz","Type":"NodeParagraph","Properties":{"id":"20240607145554-d0b35bz","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" （1）对风湿痹痛、肝肾不足、腰膝酸痛最为适宜，常与独活、牛膝等配伍应用。对老人体虚、妇女经多带下而肝肾不足、腰膝疼痛、筋骨无力者亦每与杜仲、续断等配伍应用。用于肝肾虚亏、冲任不固所致胎漏下血、胎动不安，常与续断、菟丝子、阿胶等配伍。此外，本品又有降压作用，近年来临床上常用于高血压。"}]},{"ID":"20240607145554-at8sc8n","Type":"NodeParagraph","Properties":{"id":"20240607145554-at8sc8n","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607145554-6fbxmab","Type":"NodeParagraph","Properties":{"id":"20240607145554-6fbxmab","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607145554-rjdv8gm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145554-rjdv8gm","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：桑寄生"}]},{"ID":"20240607145554-3wd7ugg","Type":"NodeParagraph","Properties":{"id":"20240607145554-3wd7ugg","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607145554-ba8jjxc","Type":"NodeParagraph","Properties":{"id":"20240607145554-ba8jjxc","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" Sānɡ Jì Shēnɡ"}]},{"ID":"20240607145554-mqdi2pt","Type":"NodeParagraph","Properties":{"id":"20240607145554-mqdi2pt","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607145554-vebuh01","Type":"NodeParagraph","Properties":{"id":"20240607145554-vebuh01","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 茑（《诗经》），寓木、宛童（《尔雅》），桑上寄生、寄屑（《本经》），寄生树（《尔雄》郭璞注），寄生草（《滇南本草》），茑木（《纲目》），冰粉树、蠹心宝（《滇南本草》整理本）。"}]},{"ID":"20240607145554-nul7r4q","Type":"NodeParagraph","Properties":{"id":"20240607145554-nul7r4q","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607145554-h3c8336","Type":"NodeParagraph","Properties":{"id":"20240607145554-h3c8336","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 《雷公炮炙论》"}]},{"ID":"20240607145554-uykxl90","Type":"NodeParagraph","Properties":{"id":"20240607145554-uykxl90","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607145554-5tjbqri","Type":"NodeParagraph","Properties":{"id":"20240607145554-5tjbqri","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 为桑寄生科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"槲寄生、桑寄生"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"毛叶桑寄生"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枝叶"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607145554-cq6mxzr","Type":"NodeParagraph","Properties":{"id":"20240607145554-cq6mxzr","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"①槲寄生"}]},{"ID":"20240607145554-5k895lq","Type":"NodeParagraph","Properties":{"id":"20240607145554-5k895lq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"一般在冬季采收（河南、湖南则在3～8月采），用刀割下，除去粗枝，阴干或晒干，扎成小把或用沸水捞过（使不变色），晒干。"}]},{"ID":"20240607145554-lzxn8je","Type":"NodeParagraph","Properties":{"id":"20240607145554-lzxn8je","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②桑寄生及毛叶桑寄生"}]},{"ID":"20240607145554-xtcegl8","Type":"NodeParagraph","Properties":{"id":"20240607145554-xtcegl8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"一般在夏季砍下枝条，晒干。"}]},{"ID":"20240607145554-solig25","Type":"NodeParagraph","Properties":{"id":"20240607145554-solig25","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607145554-b57d8so","Type":"NodeParagraph","Properties":{"id":"20240607145554-b57d8so","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①槲寄生"}]},{"ID":"20240607145554-zzj49o8","Type":"NodeParagraph","Properties":{"id":"20240607145554-zzj49o8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"常绿小灌木，高30～60厘米。茎枝圆柱状，黄绿色或绿色，略带肉质，2～3叉状分枝，分枝处膨大成节，节间长5～10厘米。叶对生，生于枝端节上，无叶柄，叶片肥厚呈肉质，黄绿色，椭圆状披针形或倒披针形，长3～7厘米，宽7～15毫米，先端钝圆，基部楔形，全缘，有光泽；主脉5出，中间3条显着。花单性，雌雄异株，生于枝端2叶的中间，米黄色或近于肉色，无花梗；雄花3～5朵；苞片杯形，长约2毫米；花被钟形，先端4裂，质厚；雄蕊4，花药多室，无花丝；雌花1～3朵，花被钟形，与子房合生，先端4裂，长约1毫米；子房下位，1室，无花柱，柱头头状。浆果团球形，半透明，直径6～7毫米，热时黄色或橙红色，果皮有粘胶质。种子1枚，侧扁状。花期4～5月。果期9～11月。"}]},{"ID":"20240607145554-npmlryb","Type":"NodeParagraph","Properties":{"id":"20240607145554-npmlryb","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"常寄生于榆、桦、柳、枫、杨等树上。分布黑龙江、吉林、辽宁、内蒙古、河北、河南、山东、安徽、江苏、浙江、湖北、湖南、江西、福建、四川、山西、陕西、甘肃、青海、云南等地。"}]},{"ID":"20240607145554-bgei1cf","Type":"NodeParagraph","Properties":{"id":"20240607145554-bgei1cf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"尚有两种槲寄生的变型植物，亦同等入药：㈠黄果槲寄生，果实橙黄色。㈡红果槲寄生，果实橙红色，此外，还有白果槲寄生，在广西亦称槲寄生。"}]},{"ID":"20240607145554-2hs1swp","Type":"NodeParagraph","Properties":{"id":"20240607145554-2hs1swp","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②桑寄生，又名：桃木寄生、沙梨寄生、枇杷寄生、油茶寄生。"}]},{"ID":"20240607145554-4uo94mw","Type":"NodeParagraph","Properties":{"id":"20240607145554-4uo94mw","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"常绿小灌木。老枝无毛，具凸起的灰黄色皮孔，小枝稍被暗灰色短毛。单叶互生或近对生，革质，卵圆形或长卵形。长3～7厘米，宽2～5厘米，先端钝圆，基部圆形或阔楔形，全缘，叶脉稀疏而不明显；叶柄长1～1.5厘米，光滑，或幼时被极短的星状毛。花两性，1～3朵，形成腋生的聚伞花序，总花梗长4～10毫米，被红褐色星状毛；小花梗较短；小苞片1枚，卵形，极小；花萼近球形，与子房合生，外被红褐色的星状毛；花管狭管状，长2～2.5厘米，顶端4裂，裂片紫红色，柔弱，稍弯曲，外被红褐色星状毛；雄蕊4；雌蕊1，花柱细长，柱头扁头状，子房下位，球形。浆果椭圆形，有小疣状突起。花期8～10月。果期9～10月。"}]},{"ID":"20240607145554-7jj76zq","Type":"NodeParagraph","Properties":{"id":"20240607145554-7jj76zq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"常寄生于桑科、茶科、山毛榉科、芸香科、蔷薇科、豆科等29科50余种植物上。分布福建、台湾、广东、广西、云南、贵州、四川、江西等地。"}]},{"ID":"20240607145554-t1qjync","Type":"NodeParagraph","Properties":{"id":"20240607145554-t1qjync","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"同属植物小叶桑寄生与上种近似，叶常对生，先端钝；花具长1～2毫米的花柄；每花序有花2～5朵生于单一的总花梗上。"}]},{"ID":"20240607145554-3306jhn","Type":"NodeParagraph","Properties":{"id":"20240607145554-3306jhn","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③毛叶桑寄生，又名：柿寄生、樟寄生。"}]},{"ID":"20240607145554-7rb4op2","Type":"NodeParagraph","Properties":{"id":"20240607145554-7rb4op2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"形态与桑寄生相似，但小枝和叶下面密被红棕色星状短柔毛；叶片椭圆形或卵形；花冠裂片向外反折；浆果被毛。"}]},{"ID":"20240607145554-zmmrm2d","Type":"NodeParagraph","Properties":{"id":"20240607145554-zmmrm2d","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"常寄生于桑、樟、油茶、沙梨、酸枣、龙眼等树上。分布长江流域以南各地。"}]},{"ID":"20240607145554-6zsw8jw","Type":"NodeParagraph","Properties":{"id":"20240607145554-6zsw8jw","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607145554-k9ry0xo","Type":"NodeParagraph","Properties":{"id":"20240607145554-k9ry0xo","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①槲寄生"}]},{"ID":"20240607145554-utnqjio","Type":"NodeParagraph","Properties":{"id":"20240607145554-utnqjio","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"又名：北寄生、柳寄生。干燥的枝茎呈圆柱形，无叶或枝捎带叶，长约30厘米，直径0.3～1厘米。表面黄棕色或灰棕色，有明显的纵皱纹，茎有节，节间长约3～5厘米，往往由节生出2～3个分枝。质轻而脆，易折断。断面不平坦，纤维呈放射状，并有粉状物散出。叶对生于枝端，极易脱落，叶片长卵形，稍厚而有光泽，似革质而略柔，黄棕色，皱纹明显；叶脉3条。气微，味略苦。以条匀、枝嫩、色黄绿、带叶、整齐不碎者为佳。"}]},{"ID":"20240607145554-rbk0f5o","Type":"NodeParagraph","Properties":{"id":"20240607145554-rbk0f5o","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"主产河北、辽宁、吉林、安徽、内蒙古、湖南、浙江、河南等地。此外，黑龙江、山西、四川、江西、陕西、福建、湖北、江苏、青海等地亦产。"}]},{"ID":"20240607145554-6pimb1d","Type":"NodeParagraph","Properties":{"id":"20240607145554-6pimb1d","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②桑寄生"}]},{"ID":"20240607145554-bnbhe6k","Type":"NodeParagraph","Properties":{"id":"20240607145554-bnbhe6k","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"又名：广寄生。茎枝呈圆柱形，长30厘米以上，直径0.5～1厘米，具分枝或枝痕。表面灰褐色或红褐色，有多数细小的浅色皮孔，嫩枝上或带有棕色细毛及叶。叶长椭圆形，对生或互生，易脱落，似革质，质坚硬，断面不平坦。气无，味淡。以外皮棕褐色、条匀、叶多、附有桑树干皮者为佳。"}]},{"ID":"20240607145554-s540g99","Type":"NodeParagraph","Properties":{"id":"20240607145554-s540g99","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"主产广东、广西等地。此外，云南、贵州、四川、江西等地亦产。"}]},{"ID":"20240607145554-rm4vvpc","Type":"NodeParagraph","Properties":{"id":"20240607145554-rm4vvpc","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③柿寄生"}]},{"ID":"20240607145554-xmjrl5o","Type":"NodeParagraph","Properties":{"id":"20240607145554-xmjrl5o","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"为毛叶桑寄生的干燥枝叶，茎枝圆柱形，下部粗0.5～1厘米，分枝尾梢仅2～3毫米；外表棕褐色微带紫红，有多数细小的浅色皮孔，吸枝有不规则细纵纹。叶片椭圆形，下面黄褐色，革质而脆，多数脱落而仅留叶痕。偶有干枯的花果。质坚硬，断面黄白色。气无，味涩。以枝细，外皮棕褐色者为佳。"}]},{"ID":"20240607145554-z2gsjk8","Type":"NodeParagraph","Properties":{"id":"20240607145554-z2gsjk8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"产于陕西、四川、云南、湖南、福建等地。"}]},{"ID":"20240607145554-9g6brkg","Type":"NodeParagraph","Properties":{"id":"20240607145554-9g6brkg","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607145554-qmxv3qf","Type":"NodeParagraph","Properties":{"id":"20240607145554-qmxv3qf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 萹蓄甙对小鼠腹腔注射，半数致死量为1.173克/公斤，毒性很小，小鼠中毒后，由于阵挛性惊厥，致呼吸停止而死。"}]},{"ID":"20240607145554-sxm2xei","Type":"NodeParagraph","Properties":{"id":"20240607145554-sxm2xei","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607145554-3szmret","Type":"NodeParagraph","Properties":{"id":"20240607145554-3szmret","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 槲寄生茎、叶含齐墩果酸，β-香树脂醇，内消旋肌醇，黄酮类化合物，尚分离出蛇麻脂醇，β-谷甾醇及一黄酮甙。"}]},{"ID":"20240607145554-evl5r6v","Type":"NodeParagraph","Properties":{"id":"20240607145554-evl5r6v","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"桑寄生带叶茎枝含槲皮素及萹蓄甙。"}]},{"ID":"20240607145554-7vcgg47","Type":"NodeParagraph","Properties":{"id":"20240607145554-7vcgg47","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607145554-pdkzs82","Type":"NodeParagraph","Properties":{"id":"20240607145554-pdkzs82","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①槲寄生：降压作用：黄果槲寄生新鲜叶的醇提取物（用时转溶于生理盐水中）1毫升（生药0.83克）/公斤给麻醉兔、犬静脉注射.可使血压下降，与白果槲寄生的作用相同。其茎和叶的浸剂同样有降压作用，如与山楂、大蒜、臭梧桐合用，其降压作用大为增强，作用时间也有所延长。白果槲寄生据称有强心、降压作用，强心成分为Viscotoxin，有洋地黄样作用。红果槲寄生中含齐墩果酸，可能是引起强心、利尿作用的成分。至于降压作用是如何引起则未经解决，对其粗制剂之降压原理，一般多认为是槲寄生兴奋了循环系统的内感受器，通过迷走神经传入纤维抑制了血管运动中枢，而产生降压作用。切断迷走神经之动物，即不再引起降压；而阿托品化后之动物，则仅能消除其使心率减慢之作用（可能为其中某些胆碱样物质所引起），而不能消除其降压作用。槲寄生可能由于其寄生的宿主以及药物制备的方法不同，使其作用有所差异。大量尚可引起呕吐，下泻，乃至死亡。临床上白果槲寄生叶浸剂（2月间收集的叶较好）或其他部分的酊剂对初期高血压病人有效，能改善自觉症状，但降压作用不显著，应用需持续1个月以上，对晚期高血压无效。"}]},{"ID":"20240607145554-4ak8p9u","Type":"NodeParagraph","Properties":{"id":"20240607145554-4ak8p9u","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②桑寄生：㈠利尿作用"}]},{"ID":"20240607145554-gdo6fzh","Type":"NodeParagraph","Properties":{"id":"20240607145554-gdo6fzh","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"麻酢犬以萹蓄甙即广寄生甙0.5毫克/公斤静脉注射，可引起利尿作用，增加剂量时作用更显著。在慢性大鼠试验中，无论口服或注射，34毫克/公斤即开始有显著的利尿作用。其作用强度虽不及氨茶碱，但其毒性仅为氨茶碱的1/4，故其治疗宽度较大。"}]},{"ID":"20240607145554-ngck2eu","Type":"NodeParagraph","Properties":{"id":"20240607145554-ngck2eu","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"㈡降压作用"}]},{"ID":"20240607145554-svlv26y","Type":"NodeParagraph","Properties":{"id":"20240607145554-svlv26y","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"萹蓄甙对麻醉犬虽有降压作用，但持续很短，且易产生急速耐受性。据初步试验，在正常搏动和颤动的离体豚鼠心脏标本上，桑寄生（冲剂）均有舒张冠状血管的作用，并能对抗脑垂体后叶素，对心肌收缩力则为先抑制后增加。"}]},{"ID":"20240607145554-r64yfq2","Type":"NodeParagraph","Properties":{"id":"20240607145554-r64yfq2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"㈢抗病毒作用"}]},{"ID":"20240607145554-sx4r2de","Type":"NodeParagraph","Properties":{"id":"20240607145554-sx4r2de","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"桑寄生煎剂在体外（猴肾单层上皮细胞组织培养）对脊髓灰质炎病毒和其他肠道病毒有显著的抑制作用，脊髓灰质炎病毒与药物直接接触一小时内，即被抑制，可能是直接灭活作用。"}]},{"ID":"20240607145554-sjnfwhv","Type":"NodeParagraph","Properties":{"id":"20240607145554-sjnfwhv","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③柿寄生：㈠降压作用"}]},{"ID":"20240607145554-7zslu30","Type":"NodeParagraph","Properties":{"id":"20240607145554-7zslu30","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"其茎、叶混合酊剂0.1～0.25克（生药）/公斤静脉注射或0.4～0.5克/公斤口服，均有降压作用，维持时间亦较长（1～2小时），重复给药，并无急速耐受现象，切断迷走神经或注射阿托品只能减弱而不能完全消除其降压作用，对肾上腺素无拮抗或增强作用，降压与窦神经无关，对正常离体兔耳血管无直接扩张作用，而对胆甾醇性血管硬化的离体兔耳血管有明显的直接扩张作用。其降压作用据认为可能是中枢性或反射性的。"}]},{"ID":"20240607145554-04ou4wl","Type":"NodeParagraph","Properties":{"id":"20240607145554-04ou4wl","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"㈡镇静作用"}]},{"ID":"20240607145554-suc42ad","Type":"NodeParagraph","Properties":{"id":"20240607145554-suc42ad","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"小鼠腹腔注射柿寄生酊剂2克/公斤能抑制由咖啡因所引起的运动性兴奋，和延长五甲烯四氮唑引起的小鼠死亡时间。"}]},{"ID":"20240607145554-vls7vqq","Type":"NodeParagraph","Properties":{"id":"20240607145554-vls7vqq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"㈢其他作用"}]},{"ID":"20240607145554-vsvhj5m","Type":"NodeParagraph","Properties":{"id":"20240607145554-vsvhj5m","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"柿寄生对麻醉犬的肠蠕动无明显影响，能降低离体兔肠的张力，但不影响其节律收缩。对兔离体未孕子宫无影响，仅在极高浓度时有短暂的收缩增强。小鼠1次腹腔注射柿寄生，其半数致死量为11.24克/公斤。"}]},{"ID":"20240607145554-4vqz4u4","Type":"NodeParagraph","Properties":{"id":"20240607145554-4vqz4u4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607145554-wrmqhyq","Type":"NodeParagraph","Properties":{"id":"20240607145554-wrmqhyq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 原药用水洗净，润透，切段，晒干。生用或酒炒用。"}]},{"ID":"20240607145554-xitqc4u","Type":"NodeParagraph","Properties":{"id":"20240607145554-xitqc4u","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607145554-94yo5gq","Type":"NodeParagraph","Properties":{"id":"20240607145554-94yo5gq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607145554-3xv9dfc","Type":"NodeParagraph","Properties":{"id":"20240607145554-3xv9dfc","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入足厥阴经。\""}]},{"ID":"20240607145554-y2hhd5x","Type":"NodeParagraph","Properties":{"id":"20240607145554-y2hhd5x","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入肝、肾。\""}]},{"ID":"20240607145554-b2t7d1w","Type":"NodeParagraph","Properties":{"id":"20240607145554-b2t7d1w","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入心、肾二经。\""}]},{"ID":"20240607145554-vomgfok","Type":"NodeParagraph","Properties":{"id":"20240607145554-vomgfok","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607145554-218j5s2","Type":"NodeParagraph","Properties":{"id":"20240607145554-218j5s2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 苦甘，平。"}]},{"ID":"20240607145554-6a9hs1o","Type":"NodeParagraph","Properties":{"id":"20240607145554-6a9hs1o","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，平。\""}]},{"ID":"20240607145554-9nuyipy","Type":"NodeParagraph","Properties":{"id":"20240607145554-9nuyipy","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240607145554-qofvu0i","Type":"NodeParagraph","Properties":{"id":"20240607145554-qofvu0i","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"性微温，味苦甘。\""}]},{"ID":"20240607145554-uxrk07y","Type":"NodeParagraph","Properties":{"id":"20240607145554-uxrk07y","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607145554-6gu5d90","Type":"NodeParagraph","Properties":{"id":"20240607145554-6gu5d90","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强筋骨，除风湿，通经络，益血，安胎。治腰膝酸痛，筋骨痿弱，偏枯，脚气，风寒湿痹，胎漏血崩，产后乳汁不下。"}]},{"ID":"20240607145554-br1gkc8","Type":"NodeParagraph","Properties":{"id":"20240607145554-br1gkc8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主腰痛，小儿背强，痈肿，安胎，充肌肤，坚发、齿，长须眉。\""}]},{"ID":"20240607145554-ciwreok","Type":"NodeParagraph","Properties":{"id":"20240607145554-ciwreok","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主金疮，去痹，女子崩中，内伤不足，产后余疾，下乳汁。\""}]},{"ID":"20240607145554-y6h2lt4","Type":"NodeParagraph","Properties":{"id":"20240607145554-y6h2lt4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能令胎牢固，主怀妊漏血不止。\""}]},{"ID":"20240607145554-t2vtxky","Type":"NodeParagraph","Properties":{"id":"20240607145554-t2vtxky","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"助筋骨，益血脉。\""}]},{"ID":"20240607145554-f65v9yp","Type":"NodeParagraph","Properties":{"id":"20240607145554-f65v9yp","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"生槐树者，主治大肠下血、肠风带血、痔漏。生桑树者，治筋骨疼痛，走筋络，风寒湿痹。生花椒树者，治脾胃寒冷，呕吐恶心翻胃；又用治梅疮毒，妇人下元虚寒或崩漏。\""}]},{"ID":"20240607145554-umhny1a","Type":"NodeParagraph","Properties":{"id":"20240607145554-umhny1a","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑥《本草蒙筌》：\"散疮疡，追风湿，却背强腰痛。\""}]},{"ID":"20240607145554-8h3q2oz","Type":"NodeParagraph","Properties":{"id":"20240607145554-8h3q2oz","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑦《生草药性备要》：\"消热，滋补，追风。\"\"养血散热，作茶饮，舒筋活络。\""}]},{"ID":"20240607145554-3qtkqiy","Type":"NodeParagraph","Properties":{"id":"20240607145554-3qtkqiy","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑧《玉楸药解》：\"治痢疾。\""}]},{"ID":"20240607145554-f8znyn7","Type":"NodeParagraph","Properties":{"id":"20240607145554-f8znyn7","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑨《医林纂要》：\"坚肾泻火。\""}]},{"ID":"20240607145554-f42dkby","Type":"NodeParagraph","Properties":{"id":"20240607145554-f42dkby","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"补气温中，治阴虚，壮阳道，利骨节，通经水，补血和血，安胎定痛。\""}]},{"ID":"20240607145554-pmcat6b","Type":"NodeParagraph","Properties":{"id":"20240607145554-pmcat6b","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑾《药材学》：\"治动脉硬化性高血压。\""}]},{"ID":"20240607145554-k9gcqus","Type":"NodeParagraph","Properties":{"id":"20240607145554-k9gcqus","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑿《辽宁经济植物志》：\"治郁血性肾炎，月经困难，咯血，瘰疬，心脏诸病及早期肺病。\""}]},{"ID":"20240607145554-7l176w6","Type":"NodeParagraph","Properties":{"id":"20240607145554-7l176w6","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⒀《湖南药物志》：\"治肝风昏眩，四肢麻木，酸痛，内伤咳嗽，小儿抽搐。\""}]},{"ID":"20240607145554-qax94og","Type":"NodeParagraph","Properties":{"id":"20240607145554-qax94og","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⒁《广西药植名录》：\"除风湿，消肿，清热，祛痰，顺气，止咳。治痢疾，疮疥，吐血，子宫脱垂。\""}]},{"ID":"20240607145554-je45q9z","Type":"NodeParagraph","Properties":{"id":"20240607145554-je45q9z","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607145554-5x51hy1","Type":"NodeParagraph","Properties":{"id":"20240607145554-5x51hy1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～6钱；入散剂、浸酒或捣汁服。"}]},{"ID":"20240607145554-t5hxsny","Type":"NodeParagraph","Properties":{"id":"20240607145554-t5hxsny","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607145554-qomxsm7","Type":"NodeParagraph","Properties":{"id":"20240607145554-qomxsm7","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①治腰背痛，肾气虚弱，卧冷湿地当风所得：独活三两，寄生、杜仲、牛膝、细辛、秦艽、茯苓、桂心、防风、芎藭、人参、甘草、当归、芍药、干地黄各二两。上十五味细锉，以水一斗，煮取三升。分三服。温身勿冷也。（《千金方》独活寄生汤）"}]},{"ID":"20240607145554-90w84ao","Type":"NodeParagraph","Properties":{"id":"20240607145554-90w84ao","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②治妊娠眙动不安，心腹刺痛：桑寄生一两半，艾叶半两（微炒），阿胶一两（捣碎，炒令黄燥）。上药，锉，以水一大盏半，煎至一盏，去滓。食前分温三服。（《圣惠方》）"}]},{"ID":"20240607145554-w5m18bi","Type":"NodeParagraph","Properties":{"id":"20240607145554-w5m18bi","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③治下血止后，但觉丹田元气虚乏，腰膝沉重少力：桑寄生，为末。海服一钱，非时白汤点服，（《杨氏护命方》）"}]},{"ID":"20240607145554-acc81k1","Type":"NodeParagraph","Properties":{"id":"20240607145554-acc81k1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"④治毒痢脓血，六脉微小，并无寒热：桑寄生二两，防风、大芎二钱半，炙甘草三钱。为末。每服二钱，水一盏，煎八分，和滓服。（《杨氏护命方》）"}]},{"ID":"20240607145554-ytxi791","Type":"NodeParagraph","Properties":{"id":"20240607145554-ytxi791","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"⑤治膈气：生桑寄生捣汁一盏。服之。（《濒湖集简方》）"}]},{"ID":"20240607145554-b2401cx","Type":"NodeParagraph","Properties":{"id":"20240607145554-b2401cx","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607145554-d6ge2kb","Type":"NodeParagraph","Properties":{"id":"20240607145554-d6ge2kb","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①桑寄生：㈠治疗冠心病心绞痛"}]},{"ID":"20240607145554-65db0cf","Type":"NodeParagraph","Properties":{"id":"20240607145554-65db0cf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"将桑寄生制成冲剂，每包相当于生药1.3两。日服2次，每次0.5包，少数病例每次1包。观察64例，疗程4周至5个月不等。治疗期间，有高血压者继续服降压药，原用复方硝酸甘油者，仍继续服用。结果心绞痛症状改善的有效率为76％,其中显效（心绞痛程度减轻二级）率占24％；心电图改善有效率为44％，显效者占25％。另报道，桑寄生对降低胆甾醇亦有一定作用。"}]},{"ID":"20240607145554-690shf9","Type":"NodeParagraph","Properties":{"id":"20240607145554-690shf9","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"㈡治疗冻伤"}]},{"ID":"20240607145554-neepoa9","Type":"NodeParagraph","Properties":{"id":"20240607145554-neepoa9","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"取桑寄生1斤，加蒸馏水10斤，煮沸3分钟，过滤，滤液用文火熬制成膏。Ⅰ度冻伤用桑寄生膏2.5克，加入蒸馏水35毫升，酒精8毫升，白陶土4.5克，混合后涂敷患处（不能用于溃疡面）；Ⅱ、Ⅲ度冻伤用桑寄生膏3克，加入甘油10克，单软膏35克，锌氧粉2克，调匀敷于局部。药物配制时须按处方顺序。"}]},{"ID":"20240607145554-nka8kna","Type":"NodeParagraph","Properties":{"id":"20240607145554-nka8kna","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②柿寄生：治疗精神分裂症"}]},{"ID":"20240607145554-6wmtmc0","Type":"NodeParagraph","Properties":{"id":"20240607145554-6wmtmc0","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"取干柿寄生茎2份、叶1份，加水浸煮2次，合并煎液过滤，浓缩成50％煎剂供口服；或用干柿寄生茎2份、叶1份，加工制成注射液（每毫升相当于生药4克），供肌肉注射。煎剂和注射液1次给药量相当于生药0.5～1.5克公斤体重，有关治疗步骤，药物显效时间，疗程及疗程间隙时间，药物剂量的掌握等，均与马桑相同（可参见\"马桑\"条）。临床观察255例（其中104例合并其他方法治疗），痊愈（疗效标准同马桑，下同）73例，显著好转54例，好转55问，无效68例。总有效率73.4％，痊愈率30.6％。其中单独用柿寄生制剂治疗的151例的疗效为：痊愈40例，显著好转31例，好转29例，无效51例。表明治疗本病具有肯定效果，而与原有治疗精神分裂症的一些方法配合，更可进一步促进疗效的提高。治疗中检查肝功能，在140例中32例有明显改变，但未出现黄疸、肝区疼痛等急性中毒性肝炎表现，而少数病例有厌食及肝肿大。尿捡少数病例有少量红、白细胞及微量蛋白，几天后自行恢复。治程中有8例出现期外收缩，历时很短；3例出现窦性心动过缓。"}]},{"ID":"20240607145554-hcqlt7i","Type":"NodeParagraph","Properties":{"id":"20240607145554-hcqlt7i","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607145554-lvvqhsg","Type":"NodeParagraph","Properties":{"id":"20240607145554-lvvqhsg","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①《本草蒙筌》：\"凡风湿作痛之症，古方每用独活寄生汤煎调。川续断与桑寄生气味略异，主治颇同，不得寄生，即加续断。\""}]},{"ID":"20240607145554-e6gisjq","Type":"NodeParagraph","Properties":{"id":"20240607145554-e6gisjq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"桑寄生，其味苦甘，其气平和，不寒不热，固应无毒。详其主治，一本于桑，抽其精英，故功用比桑尤胜。腰痛及小儿背强，皆血不足之候，痈肿多由于营气热。肌肤不充，由于血虚。齿者，骨之余也，发者，血之余也，益血则发华，肾气足则齿坚而发眉长。血盛则胎自安。女子崩中及内伤不足，皆血虚内热之故。产后余疾，皆由血分，乳汁不下，亦由血虚。金疮则全伤于血。上来种种疾病，莫不悉由血虚有热所发，此药性能益血，故并主之也。兼能祛湿，故亦疗痹。\""}]},{"ID":"20240607145554-mw99apg","Type":"NodeParagraph","Properties":{"id":"20240607145554-mw99apg","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"寄生得桑之余气而生，性专祛风逐湿，通调血脉，故《本经》取治妇人腰痛，小儿背强等病，血脉通调而肌肤眉须皆受其荫，即有痈肿，亦得消散矣。\""}]},{"ID":"20240607145554-zl62zis","Type":"NodeParagraph","Properties":{"id":"20240607145554-zl62zis","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"④《本草求真》：\"桑寄生，号为补肾补血要剂。缘肾主骨，发主血，苦入肾，肾得补则筋骨有力，不致痿痹而酸痛矣。甘补血，血得补则发受其灌荫而不枯脱落矣。故凡内而腰痛、筋骨笃疾、胎堕，外而金疮、肌肤风湿，何一不惜此以为主治乎。\""}]},{"ID":"20240607145554-gl8bqvk","Type":"NodeParagraph","Properties":{"id":"20240607145554-gl8bqvk","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607145554-2fsmjqk","Type":"NodeParagraph","Properties":{"id":"20240607145554-2fsmjqk","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" １、用于风湿痹痛、腰膝酸痛等。桑寄生能祛风湿，舒筋络，治疗风湿痹痛；而尤长于补肝肾，强筋骨。故肝肾不足，腰膝酸痛者尤为适宜。常与此独活、牛膝、杜仲、当归等同用，如独活寄生汤。"}]},{"ID":"20240607145554-bdmxf9p","Type":"NodeParagraph","Properties":{"id":"20240607145554-bdmxf9p","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"２、用于胎漏下血、胎动不安。本品补肝肾，养血而安胎，可治肝肾虚损，冲任不固之胎漏、胎动不安，常与艾叶、阿胶、杜仲、川续断等配伍。"}]},{"ID":"20240607145554-spqnw1y","Type":"NodeParagraph","Properties":{"id":"20240607145554-spqnw1y","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607145554-1w4xfmp","Type":"NodeParagraph","Properties":{"id":"20240607145554-1w4xfmp","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607145554-05x6gvf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145554-05x6gvf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"《中华本草》：桑寄生"}]},{"ID":"20240607145554-98l5gyt","Type":"NodeParagraph","Properties":{"id":"20240607145554-98l5gyt","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607145554-o3rpfr2","Type":"NodeParagraph","Properties":{"id":"20240607145554-o3rpfr2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" Sānɡ Jì Shēnɡ"}]},{"ID":"20240607145554-uda96pq","Type":"NodeParagraph","Properties":{"id":"20240607145554-uda96pq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607145554-r3h3duf","Type":"NodeParagraph","Properties":{"id":"20240607145554-r3h3duf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 茑、寓木、宛童、桑上寄生、寄屑、寄生树、茑木"}]},{"ID":"20240607145554-tpvwlc9","Type":"NodeParagraph","Properties":{"id":"20240607145554-tpvwlc9","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607145554-55ttwoz","Type":"NodeParagraph","Properties":{"id":"20240607145554-55ttwoz","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：桑寄生实，明目。"}]},{"ID":"20240607145554-x7j9kzg","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607145554-x7j9kzg","updated":"20240607145554"},"Children":[{"ID":"20240607145554-jedr0y8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240607145554-jedr0y8","updated":"20240607145554"},"Children":[{"ID":"20240607145554-py4jdk3","Type":"NodeParagraph","Properties":{"id":"20240607145554-py4jdk3","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"陶弘景：桑上者名桑上寄生尔。诗人云，施于松上翅方家亦有用杨上、枫上者，则各随其树名之，形类犹是-般但根津所因处为异。"}]}]}]},{"ID":"20240607145554-ogk54ts","Type":"NodeParagraph","Properties":{"id":"20240607145554-ogk54ts","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：桑上寄生，寄生槲、榉、柳、水杨、枫等树上，子黄、大如小枣子。惟虢州有桑上者，子汁甚粘，核大似小豆。叶无阴阳，如细柳叶，厚肌。茎粗短。"}]},{"ID":"20240607145554-6agm4o7","Type":"NodeParagraph","Properties":{"id":"20240607145554-6agm4o7","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.《蜀本草》：诸树多有寄生，茎叶并相似。叶如桶而厚，软茎如槐而肥脆。"}]},{"ID":"20240607145554-fzmc5c5","Type":"NodeParagraph","Properties":{"id":"20240607145554-fzmc5c5","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607145554-hn2npkj","Type":"NodeParagraph","Properties":{"id":"20240607145554-hn2npkj","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 药材基源：为桑寄生科植物桑寄生、四川寄生、红花寄生、毛叶钝果寄生的枝叶。"}]},{"ID":"20240607145554-grplzdo","Type":"NodeParagraph","Properties":{"id":"20240607145554-grplzdo","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Taxillus chinensis（DC．）Danser[Loranthus chinensis Dc.]2.Taxillus sutchuenensis(Lecomte)Danser[Lo-ranthus sutchuenensis Lecomte]3.Scurrula parasitica L.[Loranthus scurrula L.;L.parasiticus(L.)Merr.]"}]},{"ID":"20240607145554-pcef4o6","Type":"NodeParagraph","Properties":{"id":"20240607145554-pcef4o6","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"采收和储藏：冬季至次春季采割，除去粗茎，切段干燥，或蒸后干燥。"}]},{"ID":"20240607145554-iy2c3eu","Type":"NodeParagraph","Properties":{"id":"20240607145554-iy2c3eu","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607145554-xqadx5l","Type":"NodeParagraph","Properties":{"id":"20240607145554-xqadx5l","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔20-400m的平原或低山常绿阔叶林中，寄生于桑树、桃树、李树、龙眼、荔枝、杨桃、油茶、油桐、橡胶树、榕树、木棉、马尾松或水松等多种植物上。"}]},{"ID":"20240607145554-jwqhhv5","Type":"NodeParagraph","Properties":{"id":"20240607145554-jwqhhv5","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.生于海拔500-1900m的山地阔叶林中，寄生于桑树、梨树、李树、梅树、油茶、厚皮香、漆树、核桃或栎属、柯属、水青冈属、桦属、楱属等植物上。"}]},{"ID":"20240607145554-zdds4vq","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607145554-zdds4vq","updated":"20240607145554"},"Children":[{"ID":"20240607145554-hfugyxl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240607145554-hfugyxl","updated":"20240607145554"},"Children":[{"ID":"20240607145554-713xa8j","Type":"NodeParagraph","Properties":{"id":"20240607145554-713xa8j","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"生于海拔20-1000（-2800）m的沿海平原或山地常绿阔叶林中，寄生于袖树、橘树、柠檬、黄皮、桃树、梨树或山茶科、大戟科、夹竹桃科、榆科、无患子科或马桑等植物上，稀寄生于云南油杉、干香柏上。"}]}]}]},{"ID":"20240607145554-sjz2yz4","Type":"NodeParagraph","Properties":{"id":"20240607145554-sjz2yz4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.生于海拔300-1300m的山地、丘陵或河谷盆地阔叶林中，寄生于桑树、油茶、樟树或栎属、柳属植物上。"}]},{"ID":"20240607145554-ojfwgji","Type":"NodeParagraph","Properties":{"id":"20240607145554-ojfwgji","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于福建、广东、广西等地。"}]},{"ID":"20240607145554-2hjz2y1","Type":"NodeParagraph","Properties":{"id":"20240607145554-2hjz2y1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.分布于中南、西南及山西、陕西、甘肃、浙江、江西、福建、台湾等地。"}]},{"ID":"20240607145554-s3lkqxy","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607145554-s3lkqxy","updated":"20240607145554"},"Children":[{"ID":"20240607145554-7reqgop","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240607145554-7reqgop","updated":"20240607145554"},"Children":[{"ID":"20240607145554-8gmw1ah","Type":"NodeParagraph","Properties":{"id":"20240607145554-8gmw1ah","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"分布于西南及江西、福建、台湾、湖南、广东、广西等地。"}]}]}]},{"ID":"20240607145554-xv856xl","Type":"NodeParagraph","Properties":{"id":"20240607145554-xv856xl","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.分布于西南及陕西、江西、福建、台湾、湖北、湖南、广西等地。"}]},{"ID":"20240607145554-x3jlg9c","Type":"NodeParagraph","Properties":{"id":"20240607145554-x3jlg9c","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607145554-hhir55k","Type":"NodeParagraph","Properties":{"id":"20240607145554-hhir55k","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 1.灌木，高0.5-1m。嫩枝、叶密被锈色星状毛，有时具疏生叠生星状毛，后变无毛；小枝灰褐色，具细小皮孔。叶对生或近对生；叶柄长8-10mm；叶片厚纸质，卵形至长卵形，长2. 5-6cm，宽1.5-4cm，先端圆钝，基部楔形或阔楔形；侧脉3-4对，略明显。伞形花序，1-2个腋生或生于小枝已落叶腋部，具花l-4朵，通常2朵，花序和花被星状毛，总花梗长2-4mm；花梗长6-7mm；苞片鳞片状；花褐色；花托椭圆形或卵球形；副萼环状；花冠花蕾时管状，长2.5-2.7cm，稍弯，下半部膨胀，顶端卵球形，裂片4，匙形，反折；花丝比花药短2/3，药室具横隔；花盘杯状；花柱线形，柱头头状。浆果椭圆状或近球形，果皮密生小瘤体，被疏毛，成熟果浅黄色，长达1cm，果皮变平滑。花、果期4月至翌年1月。"}]},{"ID":"20240607145554-j1o1op6","Type":"NodeParagraph","Properties":{"id":"20240607145554-j1o1op6","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.本种与桑寄生的区别为：嫩叶、枝密被褐色或红褐色星状毛，小枝黑色。总状花序密集呈伞形；花红色；柱头圆锥状。浆果黄绿色，果皮具颗粒状体，被疏毛。花期6-8月。"}]},{"ID":"20240607145554-zoau0xc","Type":"NodeParagraph","Properties":{"id":"20240607145554-zoau0xc","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3.1.灌木，高0.5-lm。嫩枝、叶密被锈色星状毛，稍后毛全脱落变无毛；小枝灰褐色，具皮孔。叶对生或近对生，厚纸质；叶柄长5-6mm；叶片卵形至长卵形，长5-8cm，宽2-4cm，先端钝，基部阔楔形；侧脉5-6对，两面均明显。总状花序，1-2(-3)腋生或生于小枝已落叶腋部，各部分均被褐色毛，花序梗和花序轴共长2-3mm，具花3-5(-6)朵，花红色，密集；花梗长2-3mm；苞片三角形；花托陀螺状，长2-2.5mm；副萼环状，全缘；花冠花蕾时管状，长2-2.5cm，稍弯，下半部膨胀，顶部椭圆状，开花时顶部4裂，裂片披针形，长5-8mm，反折；花柱线状，柱头头状。浆果梨形，长约10mm，直径约3mm，下半部骤狭呈长柄状，红黄色，果皮平滑。花、果期10月至翌年1月。"}]},{"ID":"20240607145554-fg6s9q0","Type":"NodeParagraph","Properties":{"id":"20240607145554-fg6s9q0","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.与前三种的区别在于：成长叶下面被灰黄色、黄褐色或褐色绒毛，嫩枝、叶、花序和花均密被叠生星状毛或星状毛。总状花序；花2-5朵密集呈伞形；花冠长1.2-1.8cm，红黄色。浆果椭圆形，两端圆钝，淡黄色，果皮粗糙，具疏生星状毛。花期8-11月，果期翌年4-5月。"}]},{"ID":"20240607145554-hg8zvk2","Type":"NodeParagraph","Properties":{"id":"20240607145554-hg8zvk2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607145554-kaa67re","Type":"NodeParagraph","Properties":{"id":"20240607145554-kaa67re","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 (1)桑寄生 带叶茎枝圆柱形，有分枝，长30-40cm，粗枝直径0．5-1cm，细枝或枝梢直径2-3mm。表面粗糙，嫩枝顶端被有锈色毛绒，红褐色或灰褐色，有多数圆点状、黄褐色或灰黄色皮孔和纵向细皱纹，粗枝表面红褐色或灰褐色，有突起的枝痕和叶痕。质坚脆，易折断，断面不平坦，皮部薄，深棕褐色，易与木部分离；木部宽阔，几占茎的大部，淡红棕色；髓射线明显，放射状；髓部小形，色稍深。叶易脱落，仅少数残留茎上，叶片常卷缩、破碎，完整者卵圆形至长卵形，长3-6cm，宽2.5-4cm，先端钝圆，基部圆形成宽楔形，茶褐色或黄褐色，全缘，侧脉3-4对，略明显，幼叶有锈色绒毛，近革质而脆，易破碎；叶柄长0.5-1cm。花、果常脱落；花蕾管状，稍弯，顶部卵圆形，被锈色绒毛；浆果长间形，红褐色，密生小瘤体。气微，味淡、微涩以枝细、质嫩。红褐色、叶多者为佳。"}]},{"ID":"20240607145554-08wxcst","Type":"NodeParagraph","Properties":{"id":"20240607145554-08wxcst","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（2）四川寄生 带叶茎技圆柱形，有分枝，长30-50cm，粗枝直径约1cm，细枝和枝梢2-3mm。表面粗糙，黑褐色或灰褐色，有纵向细皱纹、裂纹和点状的黄褐色皮孔；小枝及枝梢上密被黄褐色或红褐色绒毛。质坚硬，易折断，断面不平坦，皮部薄，棕褐色，易与木部分离；木部宽阔，几占茎的大部，黄褐色或黄白色；髓射线明显；髓部色稍深。叶多数已脱落，叶片大多破碎或卷缩，完整叶片长椭圆形、长卵形或卵形，长5-8cm,宽3-4.5cm，先端钝圆，基部圆形成宽楔形，茶褐色或黄褐色，全缘，侧脉3-4对，略明显，幼叶有锈色绒毛，近革质而脆，易破碎；叶柄长0.5-1cm。花、果常脱落；花蕾管状，稍弯，顶部卵圆形，被锈色绒毛；浆果长间形，红褐色，密生小瘤体。气微，味淡、微涩以枝细、质嫩。红褐色、叶多者为佳。"}]},{"ID":"20240607145554-cajw1x1","Type":"NodeParagraph","Properties":{"id":"20240607145554-cajw1x1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（2）四川寄生 带叶茎技圆柱形，有分枝，长30-50cm，粗枝直径约1cm，细枝和枝梢2-3mm。表面粗糙，黑褐色或灰褐色，有纵向细皱纹、裂纹和点状的黄褐色皮孔；小枝及枝梢上密被黄褐色或红褐色绒毛。质坚硬，易折断，断面不平坦，皮部薄，棕褐色，易与木部分离；木部宽阔，几占茎的大部，黄褐色或黄白色；髓射线明显；髓部色稍深。叶多数已脱落，叶片大多破碎或卷缩，完整叶片长椭圆形、长卵形或卵形，长5-8cm,宽3-4.5cm，先端钝圆，基部圆形成宽楔形，茶褐色或黄褐色，全缘，侧脉3-4对，略明显，幼叶有锈色绒毛，近革质而脆，易破碎；叶柄长0.5-1cm。花、果常脱落；花蕾管状，稍弯，顶部卵圆形，被锈色绒毛；浆果长间形，红褐色，密生小瘤体。气微，味淡、微涩。"}]},{"ID":"20240607145554-evgrgut","Type":"NodeParagraph","Properties":{"id":"20240607145554-evgrgut","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"以枝细、质嫩。红褐色、叶多者为佳。"}]},{"ID":"20240607145554-utp7z8z","Type":"NodeParagraph","Properties":{"id":"20240607145554-utp7z8z","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（2）四川寄生 带叶茎技圆柱形，有分枝，长30-50cm，粗枝直径约1cm，细枝和枝梢2-3mm。表面粗糙，黑褐色或灰褐色，有纵向细皱纹、裂纹和点状的黄褐色皮孔；小枝及枝梢上密被黄褐色或红褐色绒毛。质坚硬，易折断，断面不平坦，皮部薄，棕褐色，易与木部分离；木部宽阔，几占茎的大部，黄褐色或黄白色；髓射线明显；髓部色稍深。叶多数已脱落，叶片大多破碎或卷缩，完整叶片长椭圆形、长卵形或卵形，长5-8cm,宽3-4.5cm，先端钝，基部圆形，上面光滑，茶褐色或黄褐色，稀为绿褐色，下面密被黄褐色至红褐色毡毛，或淡褐色至灰白色毡毛（变种），全缘，叶脉羽状，侧脉4-5对，上面略明显，革质而脆，易破碎；叶柄长约0．5-1cm，或已脱落，密被黄褐色至红褐色绒毛。偶有未脱落的花及果实；花蕾管状，稍弯，下半部膨胀，顶部狭长圆形，先端急尖；浆果长圆形，果皮具颗粒状小突起。气微，味淡而涩。"}]},{"ID":"20240607145554-hj19ca1","Type":"NodeParagraph","Properties":{"id":"20240607145554-hj19ca1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"以外层黑褐色、条匀、叶多者为佳。"}]},{"ID":"20240607145554-mw8iiby","Type":"NodeParagraph","Properties":{"id":"20240607145554-mw8iiby","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（3）红花寄生见“红花寄生”条。"}]},{"ID":"20240607145554-ncg13x7","Type":"NodeParagraph","Properties":{"id":"20240607145554-ncg13x7","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：（1）桑寄生 表皮细胞残存，外被黄色用质层，内含黑棕色物。木柱层由13-15列木栓细胞组成，外侧的6-9列排列整齐、紧密，细胞长17-28μm，宽4-7μm，称为断续排列成环，纤维细胞多角形，壁厚，胞腔狭小；在纤维束的邻近和韧皮射线外侧，常有单个或成群石细胞，与中柱鞘纤维同样构成断续排列的环，石细胞常含有草酸钙方晶。韧皮部略呈半月形，细胞多破碎。形成层排列成环。木质部占整个茎的大部，导管多2-3（-5）个成群，直径30-51μm，木射线宽l-2（-4）列细胞，内含黑棕色物，射线内间或也有石细胞分布。髓部约占茎横切面的1／3，薄壁细胞含有黑棕色物，其间散在的单个石细胞或石细胞群，含有草酸钙方晶。"}]},{"ID":"20240607145554-965wi07","Type":"NodeParagraph","Properties":{"id":"20240607145554-965wi07","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（2）四川寄生 木栓层为6-12列的木栓细胞，内含棕色物；有时可见皮孔。皮层约占茎的1／6，薄壁细胞常含棕色物。"}]},{"ID":"20240607145554-hqw4pza","Type":"NodeParagraph","Properties":{"id":"20240607145554-hqw4pza","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"中柱鞘纤维断续排列成环。韧皮部甚窄狭，多呈半月形。形成层不明显。木质部约占茎的1／2；导管2-5个成群，稀单个散在，周围为木纤维及木薄壁细胞；木射线宽2-6列细胞。髓部细胞壁较厚，微木化，纹孔明显，内含团块状棕色物。皮层、射线和髓部均有石细胞群散在，并常含草酸钙方晶。"}]},{"ID":"20240607145554-9mlszl7","Type":"NodeParagraph","Properties":{"id":"20240607145554-9mlszl7","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（3）红花寄生参见“红花寄生”条。"}]},{"ID":"20240607145554-qrgb8as","Type":"NodeParagraph","Properties":{"id":"20240607145554-qrgb8as","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"叶横切面：（1）桑寄生 上、下表皮均具气孔，细胞小，类长方形。上表皮下具1列下皮细胞；上面栅栏组织3-4列细胞，细胞较长；下面栅栏组织2-3列细胞，细胞类方形，排列整齐、紧密；中间为海绵组织，排列疏松，内含较多的圆形草酸钙小簇晶，并有草酸钙小方晶散在，偶见石细胞。主脉上面隆起，下面突出，维管束3个，外韧形，上下两侧均有纤维束；薄壁细胞间有较多的含草酸钙方晶的石细胞群。"}]},{"ID":"20240607145554-uu4b994","Type":"NodeParagraph","Properties":{"id":"20240607145554-uu4b994","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"（2）四川寄生 上表皮细胞细小，类圆形，下表皮被多数星状毛；叶肉组织中散有分枝石细胞群，栅栏组织4-5列细胞，海绵组织排列较紧密；主脉上面隆起，下面突出，维管束3个，外韧型，中柱鞘纤维发达，薄壁细胞中有大量含草酸钙方晶的石细胞群（3） 带叶茎枝圆柱形，多分枝，长3-5cm，直径约lcm，细枝和枝梢直径2-3mm。表面粗糙，老枝红褐色或深褐色；小枝及枝梢赭红色，幼枝有的有棕褐色星状毛；表面有众多点状和黄褐色或灰褐色横向皮孔，以及不规则、粗而密的纵纹。质坚脆，易折断，断面不平坦，皮部菲薄，赭褐色，易与木部分离，木部宽阔，淡黄色或土黄色，有放射状纹理，髓部深黄色。叶对生或近对生，易脱落；叶片多破碎，卷缩；完整者卵形至长卵形，长5-8cm，宽2-4cm，黄褐色或茶褐色，侧脉明显，两面均光滑无毛，全缘，厚纸质而脆，嫩叶有的有棕褐色星状毛；叶柄长约5mm，有的有未脱落的花果，花蕾管状，顶部长圆形，急尖，开放时，先端4裂，裂片反折，可见雄蕊4枚及花柱；果梨形，顶端钝圆，下半部渐狭呈长柄状。气清香，味微涩而苦。"}]},{"ID":"20240607145554-rqtk4on","Type":"NodeParagraph","Properties":{"id":"20240607145554-rqtk4on","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"粉末特征：桑寄生 淡黄棕色。①石细胞类方形或类圆形，偶有分枝，细胞壁有的三面厚，一面薄，含有草酸钙方晶。②纤维成束，直径约17μm。③具缘纹孔，网纹及螺纹导管多见。偶见叠生星状毛或其碎片。"}]},{"ID":"20240607145554-vya69c2","Type":"NodeParagraph","Properties":{"id":"20240607145554-vya69c2","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粗粉10g，加8O％乙醇50ml，加热回流30min，滤过，滤液置水浴上蒸干，残渣加热水10ml使溶解，滤过，滤液加乙醚振摇提取4次，每次15ml,弃去乙醚层，取下层水溶液加醋酸铅饱和溶液至沉淀完全，滤过，滤液加乙醇10ml，加硫酸钠饱和溶液脱铅，滤过，滤液加氯仿振摇提取3次，每次15ml，合并氯仿液，置水浴上浓缩至1ml。取浓缩液点于滤纸上，干后，滴加碱性3，5-二硝基苯甲酸溶液（取二硝基苯甲酸试液与氢氧化钠试液各1ml，混合），不得显紫红色。"}]},{"ID":"20240607145554-q97ykl1","Type":"NodeParagraph","Properties":{"id":"20240607145554-q97ykl1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607145554-v3unic0","Type":"NodeParagraph","Properties":{"id":"20240607145554-v3unic0","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 毒性 萹蓄甙对小鼠腹腔注射，半数致死量为1.173g/kg，毒性很小，小鼠中毒后，由于阵挛性惊厥，致呼吸停止而死。桑寄生煎剂小鼠腹腔注射的半数致死量为11.24g/kg。"}]},{"ID":"20240607145554-sr1hut4","Type":"NodeParagraph","Properties":{"id":"20240607145554-sr1hut4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607145554-27yb0be","Type":"NodeParagraph","Properties":{"id":"20240607145554-27yb0be","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 四川桑寄生叶中含黄酮类化合物：槲皮素（quercetin），槲皮甙（quercitrin），(艹扁)(艹畜)(avicularin）及少量的右旋儿茶酚（catechol）[1].（2）薄层色谱 取本品粉末5g，加甲醇-水（l：1）60ml，加热回流1h，趁热滤过，滤液浓缩至约20ml，加水10ml稀释，再加稀硫酸约0．5ml，煮沸回流1h后，用醋酸乙酯振摇提取2次，每次30ml，合并醋酸乙酯液，浓缩至约1ml，作为供试品溶液。另取槲皮素对照品，加醋酸乙酯溶解，制成每1ml含0．5mg的溶液，作为对照品溶液。吸取上述两种溶液各10μl，分别点于同一用0．5％氢氧化钠制成的硅胶G薄层板上，以甲苯（水饱和)-甲酸乙酯-甲酸（5：4：1）展开，取出，晾干，喷干，喷以5%三氯化铝乙醇溶液，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240607145554-36qed6f","Type":"NodeParagraph","Properties":{"id":"20240607145554-36qed6f","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607145554-rt59ee1","Type":"NodeParagraph","Properties":{"id":"20240607145554-rt59ee1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 槲寄生 对循环和心肌作用的实验研究：1. 对离体心脏的作用： 按Iangendorff的方法，用洛氏液，在80mm水柱和35-37℃灌流离体心脏，用222-400g豚鼠(雄雌均有)，40只豚鼠分成四组，即槲寄生组(每1ml含2g生药的注射剂)、垂体后叶素组、垂体后叶素十槲寄生组和槲寄生灌注颤动离体心脏组。两套 灌流管，分别用作灌注洛氏液和不同试验药液。药物稀释于洛氏液中，以杠杆描记心搏幅度表示心缩力。记录心搏率和收集每分钟冠脉流出液。给药前和给药时各连续收集5分钟，取平均每分钟值比较药效。结果相当0.25g生药的槲寄生稀释到100ml洛氏液，可显着增加正常搏动离体心脏的冠脉流量，平均增加97%，这一浓度基本上不影响心搏率。 1.2．对制备的大白鼠心肺标本的作用： 按一般常规的研究心功能变化的方法，采用大白鼠心肺制备标本进行实验。结果在两个剂量组中，即20ml血源中注入相当1g和0.4g生药的槲寄生注射液。结果用药后在外周阻力不变的条件下，每分钟心输出量基本不变，血压也保持稳定。两组均减慢心率，从而增加每搏心输出量。用药后对心率和每搏输出量的作用，1分钟时最明显，此后作用逐步减弱。两个剂量组的作用类似，大剂量组作用略强。"}]},{"ID":"20240607145554-d63n53u","Type":"NodeParagraph","Properties":{"id":"20240607145554-d63n53u","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3．对犬冠脉流量及主动脉流量的影响： 用平均体重12.1kg的犬5只，麻醉后开胸剥离左冠状动脉回旋支及主动脉弓升支基部剥离脂肪组织，放置MF-26型电磁流量计探头。同时记录左回旋支及主动脉流量，观察槲寄生注射剂对冠脉循环和体循环的影响。药物按12.5mg总黄酮/Kg体重，用电子恒速灌注泵由股静脉注射以25mg/分钟速度注入。结果槲寄生明显降低动脉压，减慢心率。在停药后1分钟时明显增加冠脉流量(从左旋支看，维持时间短暂，5分钟后就逐步回到用药前水平。且对每分和每博输出量有增加的趋势，至停药后25分钟达到顶点。"}]},{"ID":"20240607145554-bub6tob","Type":"NodeParagraph","Properties":{"id":"20240607145554-bub6tob","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4．对冠脉动力及心肌耗氧量的影响： 犬6只(4， 2)，平均体重11.8kg。麻醉后开胸行人工呼吸，经有心耳作冠状窦插管，以10mg/kg体重全身肝素化，按KaBepNHa M B装 置测定冠状窦流量。同时从冠状窦和一侧股动脉取血，并立即用测氧仪测定血氧分压，按有关公式计算。用电子恒速灌注泵由股静脉注射适当补液；给药。槲寄生按25mg总黄酮/分钟注入，总量为20mg/kg体重。结果给药后冠脉流量有增加的趋势，但无显着性意义。冠脉阻力下降，至给药后15分钟时下降更显着。槲寄生给药后，能降低心肌耗氧量和心肌氧利用率。但明显降低的时间短暂。"}]},{"ID":"20240607145554-w0712a0","Type":"NodeParagraph","Properties":{"id":"20240607145554-w0712a0","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.抗心律失常作用：2.1．对大鼠静脉注射垂体后叶素注射液所致心律失常的预防作用： 大鼠体重190-300g，腹腔注射戊巴比妥钠45mg/kg麻醉后，取仰卧位用针状电极插入四肢皮下、记录心电图Ⅱ导程。分离股静脉注射并插管供注射药物用。用药组预先注射槲寄生注射液1ml/kg(每1ml含生药 2g，相当含槲寄生总黄酮10mg)，45秒后记录心电图。记录毕即注射垂体后叶素1单位/kg，并连续描记心电图1分钟，以后在2、3、5、10、15、20和30分钟时分别进行记录。对照组用等量生理盐水代替后叶素注射液。注射脑垂体后叶素后，心电图先呈T波高尖，ST段抬高等心脏缺血表现，继之出现各种心律不齐，主要为室性早搏，其次为窦性心律不齐和心动过缓，少数可见房室传导阻滞、窦性停搏等现象。这些异常大多出现于注射后1分钟。槲寄生注射液对这些心电图变化有明显预防作用。主要表现为心电图异常变化程度减轻、异常节律维持。"}]},{"ID":"20240607145554-8auvu10","Type":"NodeParagraph","Properties":{"id":"20240607145554-8auvu10","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.2．对豚鼠恒速滴注哇巴因引起心律失常的拮抗作用： 豚鼠麻醉后分离时静脉并插管供滴注药物用。对照组将1ml哇巴因稀释成20ml，每1ml含哇巴因25μg进行滴注。给药组在上述溶液中加槲寄生注射液6ml(每1ml 含生药6g)。滴注用电子微量泵进行，记录滴注开始后各种心律失常出现时间，然后根据豚鼠体重和滴速计算产生心律失常所需的哇巴因剂量。 在出现室性早搏前，两组豚鼠均先出现窦性心律不齐、窦性心律过缓、PR间期延长、房室传导阻滞等心电图变化。槲寄生和哇巴因同时滴注后，哇巴因引起室颤及致死的剂量有增加趋势，但未达统计显着水平，若加大槲寄生剂量，可能对哇巴因所致心律失常会有较明显的拮抗作用。"}]},{"ID":"20240607145554-7g4atbi","Type":"NodeParagraph","Properties":{"id":"20240607145554-7g4atbi","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.3．对大鼠静脉注射乌头碱或氯化钙诱发心律失常的影响： 实验结果表明槲寄生注射液对乌头碱或氯化钙诱发的心律失常无预防作用，甚至可能加剧两药引起的心律失常。"}]},{"ID":"20240607145554-qh3tczi","Type":"NodeParagraph","Properties":{"id":"20240607145554-qh3tczi","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3.防治急性心肌梗塞：3.1.改善心肌氧耗的实验观察家兔28只，体重2.596±0.363kg。分假手术对照组、单纯冠状动脉结扎组和槲寄生防治组，除组间对照外，同时在自身心脏各取A、B两区作自身对照。槲寄生防治组每兔用2ml槲寄生注射液。心肌耗氧量采用氧电极测氧法。结果在8只正常未经结扎的假手术对照组的A区，虽经开胸，穿针引线但未予结扎。其A区(拟梗塞区)的氧耗值为62.813±6.205mm HgO2，而B区(正常对照区)为67.125±5.580mm HgO2二者经统计分析无显着差异(P＞0.05)。在12只梗塞组家兔中，A区(梗塞区)一经结扎后，其氧耗值远远高于B。"}]},{"ID":"20240607145554-y2f3xxv","Type":"NodeParagraph","Properties":{"id":"20240607145554-y2f3xxv","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3.2．对豚鼠恒速滴注哇巴因引起心律失常的拮抗作用： 豚鼠麻醉后分离时静脉并插管供滴注药物用。对照组将1ml哇巴因稀释成20ml，每1ml含哇巴因25μg进行滴注。给药组 在上述溶液中加槲寄生注射液6ml(每1ml 含生药6g)。滴注用电子微量泵进行，记录滴注开始后各种心律失常出现时间，然后根据豚鼠体重和滴速计算产生心律失常所需的哇巴因 剂量。在出现室性早搏前，两组豚鼠均先出现窦性心律不齐、窦性心律过缓、PR间期延长、房室传导阻滞等心电图变化。槲寄生和哇巴因同时滴注后，哇巴因引起室颤及致死的剂量有增加趋势，但未达统计显着水平，若加大槲寄生剂量，可能对哇巴因所致心律失常会有较明显的拮抗作用。"}]},{"ID":"20240607145554-gxsjd0i","Type":"NodeParagraph","Properties":{"id":"20240607145554-gxsjd0i","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3.3．对大鼠静脉注射乌头碱或氯化钙诱发心律失常的影响： 实验结果表明槲寄生注射液对乌头碱或氯化钙诱发的心律失常无预防作用，甚至可能加剧两药引起的心律失常。"}]},{"ID":"20240607145554-6hue876","Type":"NodeParagraph","Properties":{"id":"20240607145554-6hue876","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.抑制血小板聚集作用：4.1．对ADP、胶原、凝血酶和花生四烯酸钠盐(AA一Na)诱导血小板聚集的影响： 槲寄生注射液(上海中药一厂生产)，每毫升含总甙10mg(相当于2g生药)。对照药用乙酰水杨酸和丹参注射液(南京中药厂生产)。动物采用大耳白兔，实验结果表明，药物管内分别加入槲寄生(以总甙计)1.6、3.2和6.4mg/ml 时，对ADP、凝血酶和AA一Na诱导的血小板聚集均呈明显的抑制作用，槲寄生3.2和6.4mg/ml时对胶原诱导的血小板聚集亦有明显的作用。上述 的效果与乙酰水杨酸(8mg/ml)和丹参注射液(以生药计：250mg/ml)相仿。"}]},{"ID":"20240607145554-myhzws1","Type":"NodeParagraph","Properties":{"id":"20240607145554-myhzws1","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.2．对血小板内cAMP、cGMP水平的影响： 槲寄生(总甙10mg/ml PRP)能显着升高血小板内cAMP水平，同时降低血小板内cGMP水4.3．对血小板前列腺素代谢产物TXA2(Thromboxane A2)和MDA(Malondialdehyde) 的影响： 槲寄生可显着减弱TXA2样物质引起的兔主动脉条收缩幅度，抑制收缩率达36.14%。因此槲寄生具有抑制血小板TXA2样物质生物合成的作用。体内注射槲寄生总甙4mg/kg能显着抑制AA一Na转化代谢后产生的MDA，MDA含量减少时光密度值明显下降，作用强度与乙酰水杨酸相似。"}]},{"ID":"20240607145554-k7t0sac","Type":"NodeParagraph","Properties":{"id":"20240607145554-k7t0sac","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"5．对缺血心肌中环核苷酸含量的影响：缺血心肌中cAMP的增高是心律失常产生的原因，为此，降低缺血心肌中的cAMP或阻断其作用的有害环节，便可能对抗心律失常，减轻心肌缺血的程度，cAMP的作用还受到cGMP的影响，cAMP/cGMP比值对心肌细胞功能的调节具有重要意义。槲寄生注射液每支2ml(50mg)、氚标记环核苷酸、3H一cAMP(37 ci/mmol)，3H一cGMP(15ci/mmol)、大白鼠体重377±83.9g，cAMP和cGMP的测定参照改良Gilman放射性蛋白竞争结合法。"}]},{"ID":"20240607145554-kiqiat0","Type":"NodeParagraph","Properties":{"id":"20240607145554-kiqiat0","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"结果：5.1．大白鼠心肌组织的正常值：左室cAMP的含量为1.33±0.41(pmol/ml 湿组织、M±SE，以下数值的单位同此)。右室为0.94±0.19，左室心肌cGMP的含量为0.11±0.02，右室为0.12±0.02，与文献报道的大鼠心肌cAMP含量0.9-2.7cGMP含量0.04-0.24 相近。"}]},{"ID":"20240607145554-p6iyt93","Type":"NodeParagraph","Properties":{"id":"20240607145554-p6iyt93","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"5.2．心肌梗塞实验：5.2.1.cAMP的变化：各组实验于15分钟、1小时、5小时测得的缺血和非缺血心肌中cAMP的含量如表10。心肌梗塞组缺血1小心肌中cAMP的含量较非缺血心肌及对照组假设缺血心肌显着增高(P＜0.05)，而在15分钟和5小时各组比较无显着差异(P＞0.05)，应用槲寄生后，所有各组心肌组织中cAMP含量均降低或呈降低倾向。其中以缺血1小时心肌cAMP含量降低尤为明显(P＜0.05)。心肌梗塞缺血1小时心肌cGMP含量较对照组假设缺血1小时心肌有增高倾向(0.05＜P＜ 0.1)，P接近0.05，在15分钟和5小时两时刻上比较，心肌梗塞与对照组各心肌组织eGMP含量无显着差异。应用槲寄生后，1小时和5小时非缺血心肌(NMIH)cGMP含量较心肌梗塞非缺血心肌(NMI)呈降低倾向(0.05＜P＜0.1)。"}]},{"ID":"20240607145554-4fd8z8v","Type":"NodeParagraph","Properties":{"id":"20240607145554-4fd8z8v","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"5.2.2.cAMP/cGMP比率的变化：各组实验于15分钟、1小时和5小时求得的缺血和非缺血心肌中cAMP/cGMP的比心肌梗塞组缺血1小时心肌中cAMP/cGMP比值较非缺血心肌(NMI)显着增高，较对照组假设缺血心肌(MIS)有增高倾向(0.05＜P＜0.1)。而在15分钟和5小时各间比较无显着差异。56各组心肌cAMP/cGMP比值一般较15分钟和l小时的各组值稍高。应用槲寄生后，缺血区心肌l小时 cAMP/cGMP比值较心肌梗塞组缺血l小时心肌组的cAMP/cGMP比值有降低倾向(0.05＜P＜0.1)。"}]},{"ID":"20240607145554-w8njwp9","Type":"NodeParagraph","Properties":{"id":"20240607145554-w8njwp9","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"6.对实验性高血压逆转后脑啡呔含量的影响：实验用Wistar纯种大鼠，体重150-250g，置恒温环境，普通饲料喂养。麻醉后切除左肾，每只大鼠每周二次皮下注射 DOCA(醋酸脱氧皮质酮)5mg，同时饮1%食盐溶液。采用尾容积法于每周固定时间测大鼠清醒状态下收缩压(SBP)一次。6周末时如SBP高于自身手术前水平20mmHg，且SBP＞120mmHg者确定为高血压大鼠。"}]},{"ID":"20240607145554-i3i472c","Type":"NodeParagraph","Properties":{"id":"20240607145554-i3i472c","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"然后将高血压大鼠随机分为：6.1.DOCA盐6周组，n=10，6周末断头处死。"}]},{"ID":"20240607145554-34j7179","Type":"NodeParagraph","Properties":{"id":"20240607145554-34j7179","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"6.2.DOCA盐12周组，n=8，继续皮下注射 DO- CA与饮盐水。"}]},{"ID":"20240607145554-r701yoy","Type":"NodeParagraph","Properties":{"id":"20240607145554-r701yoy","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"6.3.逆转对照组，n=8，停止皮下注射 DOCA与饮盐水。"}]},{"ID":"20240607145554-6vjgp3a","Type":"NodeParagraph","Properties":{"id":"20240607145554-6vjgp3a","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"6.4.逆转槲寄生组，n=9，停止皮下注射 DOCA与饮盐水。每天用槲寄生浓缩煎液(5g生药/只)灌胃。6.2.，6.（4.）组在12周末时断头处死。另取同月龄大鼠不进行任何处理，分别于6周和12周(n=8)断头处死，作为正常组。 处死后，取脑置于煮沸生理盐水中加热4分钟左右，按自然界线分离出脑干、纹状体与下丘脑，称重，制备脑组织匀浆。用放射免疫方法测定上述脑区的甲脑啡肽(MEK)和亮脑啡肽(LEK)含量，以pg/mg脑组织湿重表示之。数据统计以X±SD表示，用方差分析(F值)和t测验比较显着性差异。结果：正常大鼠6周与12周时SBP分别是93.4±15.2、105.4±14.9mmHg。切除左肾的大鼠，在皮下注射DOCA与饮盐水后3-4周血压迅速上升。6周末时SBP为 155.4/21.7mmHg。逆转对照组与逆转槲寄生组在停止皮下注射 DOCA与饮1嗡?wk内血压 均明显下降。逆转槲寄生组12周小时SBP为107±17.5mmHg，回复到正常组水平，逆转对照组血压虽然也下降，但12周时SBP 124.9±13.4mmHg，仍显着高于正常组(t=2.88， P＜O.05) 各组大鼠不同脑区MEK和LEK含量见表13。结果表明正常大鼠MEK与LEK在脑干、纹状体与下丘脑部位含量略有不同，纹状体与下丘脑啡肽含量较高，脑干则较低。正常 6周与12周比较，脑啡肽含量无显着变化(P＞0.05)，提示脑啡肽在正常时是一种含量相对较恒定的中枢神经介质。在DOCA盐性高血压大鼠，脑干与纹状体的EK，无论是MEK 或LEK都有显着升高(P＜0.01)，相反地下丘脑MEK显着降低(P＜0.01)，这种改变在12周比6周更为明显。实验发现在逆转对照组，各脑区MEK与LEK含量仍维持这种升高或降低状态，然而，在逆转槲寄生组，各脑区MEK与LEK均全部恢复正常水平。显示槲寄生对DOCA盐高血压大鼠中枢脑啡肽异常改变的双向调节作用。"}]},{"ID":"20240607145554-kq2gx5t","Type":"NodeParagraph","Properties":{"id":"20240607145554-kq2gx5t","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"7.对免疫作用的影响： 含有植物凝集素的槲寄生提取物和胸腺提取物等混合，可用于肿瘤治疗中，作为促进细胞分裂免疫刺激剂以控制和调整免疫系统。"}]},{"ID":"20240607145554-j9ri0b6","Type":"NodeParagraph","Properties":{"id":"20240607145554-j9ri0b6","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607145554-jqu8w7j","Type":"NodeParagraph","Properties":{"id":"20240607145554-jqu8w7j","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 原药用水洗净，润透，切段，晒干。生用或酒炒用。"}]},{"ID":"20240607145554-a8z0gkl","Type":"NodeParagraph","Properties":{"id":"20240607145554-a8z0gkl","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607145554-93urji4","Type":"NodeParagraph","Properties":{"id":"20240607145554-93urji4","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240607145554-2n8f63j","Type":"NodeParagraph","Properties":{"id":"20240607145554-2n8f63j","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607145554-98ozqi3","Type":"NodeParagraph","Properties":{"id":"20240607145554-98ozqi3","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 苦；甘；性平"}]},{"ID":"20240607145554-funlzca","Type":"NodeParagraph","Properties":{"id":"20240607145554-funlzca","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607145554-h5d0b4l","Type":"NodeParagraph","Properties":{"id":"20240607145554-h5d0b4l","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 补肝肾；强筋骨；祛风湿；安胎。主腰膝酸痛；筋骨痿弱；肢体偏枯；风湿痹痛；头错目眩；胎动不安，崩漏下血"}]},{"ID":"20240607145554-muagx8i","Type":"NodeParagraph","Properties":{"id":"20240607145554-muagx8i","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607145554-5swciiy","Type":"NodeParagraph","Properties":{"id":"20240607145554-5swciiy","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g；或入丸、散；或浸酒；或捣汁服。外用：适量，捣烂外敷。"}]},{"ID":"20240607145554-dmu70a7","Type":"NodeParagraph","Properties":{"id":"20240607145554-dmu70a7","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607145554-4ufz07i","Type":"NodeParagraph","Properties":{"id":"20240607145554-4ufz07i","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" ①治腰背痛，肾气虚弱，卧冷湿地当风所得： 独活三两，寄生、杜仲、牛膝、细辛、秦艽、茯苓、桂心、防风、芎穷、人参、甘草、当归、芍药、干地黄各二两。上十五味细挫，以水一斗，煮取三升。分三服。温身勿冷也。(《干金方》独活寄生汤)②治妊娠胎动不安心腹刺痛： 桑寄生一两半，艾叶半两(微炒)，阿胶一两(捣碎，炒令黄燥)。上药，挫，以水一大盏半，煎至一盏，去滓。食前分温三服。(《圣惠方》)③治下血止后，但觉丹田元气虚乏，腰膝沉重少力： 桑寄生，为末。每服一钱，非时白汤点服。(《杨氏护命方》)④治毒痢脓血，六脉微小，并无寒热： 桑寄生二两，防风、大草二钱半，炙甘草三钱。为末。每服二钱，水一盏，煎八分，和滓服。(《杨氏护命方》)⑤治漏气： 生桑寄生捣汁一盏。服之。(《濒湖集简方》)"}]},{"ID":"20240607145554-bbwye3p","Type":"NodeParagraph","Properties":{"id":"20240607145554-bbwye3p","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607145554-lxdbgbw","Type":"NodeParagraph","Properties":{"id":"20240607145554-lxdbgbw","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 1.桑寄生：1.1.治疗冠心病心绞痛： 将桑寄生制成冲剂，每包相当于生药1.3两。日服2次，每次0.5包，少数病例每次l包。观察54例，疗程4周至5个月不等。治疗期间，有高血压者继续服降压药，原用复方硝酸甘油者，仍继续服用。结果心绞痛症状改善的有效率为76绍，其中显效(心绞痛程度减轻二级)率占2吐露；心电图改善有效率为县攻谣，显效者占25%。另报道，桑寄生对降低胆图醇亦有一定作用。"}]},{"ID":"20240607145554-jz1porf","Type":"NodeParagraph","Properties":{"id":"20240607145554-jz1porf","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"1.2.治疗冻伤： 取桑寄生1斤，加蒸馏水10斤，煮沸3分钟，过滤，滤液用文火熬制成膏。l度冻伤用桑寄生膏2.5g，加入蒸馏水35ml，酒精8ml，白陶土4.5g，混合后涂敷患处(不能用于溃疡面)；H、m度冻伤用桑寄生膏3g，加入甘油10g，单软膏35g，锌氧粉2g，调匀敷于局部。药物配制时须摈处方顺序购，。"}]},{"ID":"20240607145554-km76e8e","Type":"NodeParagraph","Properties":{"id":"20240607145554-km76e8e","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.柿寄生：治疗精神分裂症： 取干柿寄生茎2份、叶1份，加水浸煮2次，合并煎液过滤，浓缩成50形煎剂供口服；或用干柿寄生茎2份、叶 l份，加工制成注射液(每毫升相当于生药4g)，供肌肉注射。煎剂和注射液1次给药量相当于生药0．5-1．5g/kg体重。有关治疗步骤，药物显效时间，疗程及疗程间隙时间，药物剂量的掌握等，均与马桑相同(可参见马桑条)。临床观察2酗例(其中10天例合并其他方法治疗)，痊愈(疗效标准同马桑，下同)78例，显着好转5天例，好转55例，无效68例。总有效率73.4%，痊愈串30.6%。其中单独用柿寄生制剂治疗的151例的疗效为： 痊愈40例，显着好转91例，好转29例，无效51例。表明治疗本病具有肯定效果，而与原有治疗精神分裂症的一些方法配合，更可进一步促进疗效的提高。治疗中检查肝功能，在140例中32例有明显改变，但未出现黄痘、肝区疼痛等急性中毒性肝炎表现，而少数病例有厌食及肝肿大。尿检少数病例有少量红、自细胞及微量蛋白，几天后自行恢复。治程中有8例出现期外收缩，历时很短；3例出现实性心动过缓。"}]},{"ID":"20240607145554-znj8twh","Type":"NodeParagraph","Properties":{"id":"20240607145554-znj8twh","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607145554-3mmt93p","Type":"NodeParagraph","Properties":{"id":"20240607145554-3mmt93p","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 1.《本草蒙答》：凡风湿作痛之症，古方每用独活寄生汤煎调。川续断与桑寄生气味略异，主治颇同，不得寄生，即加续断。"}]},{"ID":"20240607145554-eno90yx","Type":"NodeParagraph","Properties":{"id":"20240607145554-eno90yx","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：桑寄生，其味苦甘，其气平和，不寒不热，固应无毒。详其主治，一本于桑，抽其精英，故功用比桑尤胜。腰痛及小儿背强，皆血不足之候，痈肿多由于营气热。肌肤不充，由于血虚。齿者，骨之余也，发者，血之余也，益血则发华，肾气足则齿坚而发眉长。血盛则胎自安。女子崩中及内伤不足，皆血虚内热之故。产后余疾，皆由血分，乳汁不下，亦由血虚。金疮则全伤于血。上来种种疾病，莫不悉由血虚有热所发，此药性能益血，故并主之也。兼能核湿，故亦疗痹。"}]},{"ID":"20240607145554-fsu5kzp","Type":"NodeParagraph","Properties":{"id":"20240607145554-fsu5kzp","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：寄生得桑之余气而生，性专祛风逐湿，通调血脉，故《本经》取治妇人腰痛，小儿背强等病，血脉通调而肌肤眉须皆受其荫，即有痈肿，亦得消散矣。"}]},{"ID":"20240607145554-aexlzb8","Type":"NodeParagraph","Properties":{"id":"20240607145554-aexlzb8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：桑寄生，号为补肾补血要剂。缘肾主骨，发主血，苦人肾，肾得补则筋骨有力，不致屡痔而酸感矣。甘补血，血得补则发受其灌荫而不桔脱落矣。故凡内而腰痛、筋骨笃疾、胎堕，外而金疮、肌肤风湿，何一不借此以为主治乎。"}]},{"ID":"20240607145554-6zi786p","Type":"NodeParagraph","Properties":{"id":"20240607145554-6zi786p","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主腰痛，小儿背强，痈肿，安胎，充肌肤，坚发、齿，长须眉。"}]},{"ID":"20240607145554-izy5ovm","Type":"NodeParagraph","Properties":{"id":"20240607145554-izy5ovm","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"6.《别录》：主金疮，去痹，女子崩中．内伤不足，产后余疾，下乳计。"}]},{"ID":"20240607145554-hretb7i","Type":"NodeParagraph","Properties":{"id":"20240607145554-hretb7i","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：能令胎牢固，主怀妊漏血不止。"}]},{"ID":"20240607145554-dado9k8","Type":"NodeParagraph","Properties":{"id":"20240607145554-dado9k8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：助筋骨，益血脉。"}]},{"ID":"20240607145554-b4al9k8","Type":"NodeParagraph","Properties":{"id":"20240607145554-b4al9k8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"9.《滇南本草》：生槐树者，主治大肠下血、肠风带血、痔漏。生桑树者，治筋骨疼痛，走筋络，风寒湿瘦。生花椒树者，治脾胃寒冷，呕吐恶心翻胃；又用治梅疮毒，妇人下元虚寒或崩漏。"}]},{"ID":"20240607145554-8qnammz","Type":"NodeParagraph","Properties":{"id":"20240607145554-8qnammz","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"10.《本草蒙签》：散疮疡，追风湿，却背强腰痛。"}]},{"ID":"20240607145554-l8jyn3p","Type":"NodeParagraph","Properties":{"id":"20240607145554-l8jyn3p","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"11.《生草药性备要》：消热，滋补，追风。养血散热，作茶饮，舒筋活络。"}]},{"ID":"20240607145554-rjcu8gq","Type":"NodeParagraph","Properties":{"id":"20240607145554-rjcu8gq","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"12.《玉揪药解》：治痢疾。"}]},{"ID":"20240607145554-dpmldx8","Type":"NodeParagraph","Properties":{"id":"20240607145554-dpmldx8","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"13.《医林纂要》：坚肾泻火。"}]},{"ID":"20240607145554-11tdmj3","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607145554-11tdmj3","updated":"20240607145554"},"Children":[{"ID":"20240607145554-062vuy0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTQu","Num":14},"Properties":{"id":"20240607145554-062vuy0","updated":"20240607145554"},"Children":[{"ID":"20240607145554-mepz5en","Type":"NodeParagraph","Properties":{"id":"20240607145554-mepz5en","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"《本草再新》：补气温中，治阴虚，壮阳道，利骨节，通经水，补血和血，安胎定痛。"}]}]}]},{"ID":"20240607145554-oy7uglm","Type":"NodeParagraph","Properties":{"id":"20240607145554-oy7uglm","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"15.《药材学》：治动脉硬化性高血压。"}]},{"ID":"20240607145554-5w3y57y","Type":"NodeParagraph","Properties":{"id":"20240607145554-5w3y57y","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"16.《辽宁经济植物志》：治郁血性肾炎，月经困难，咯血，瘰疬，心脏诸病及早期肺病。"}]},{"ID":"20240607145554-7vma1hm","Type":"NodeParagraph","Properties":{"id":"20240607145554-7vma1hm","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"17.《湖南药物志》：治肝风昏眩，四肢麻木，酸痛，内伤咳嗽，小儿抽搐。"}]},{"ID":"20240607145554-orphp0h","Type":"NodeParagraph","Properties":{"id":"20240607145554-orphp0h","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"18.《广西药植名录》：除风湿，消肿，清热，祛痰，顺气，止咳。治痢疾，疮疥，吐血，子宫脱垂。"}]},{"ID":"20240607145554-hc8qqms","Type":"NodeParagraph","Properties":{"id":"20240607145554-hc8qqms","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607145554-y504tig","Type":"NodeParagraph","Properties":{"id":"20240607145554-y504tig","updated":"20240607145554"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607145556-rb4i5yd","Type":"NodeThematicBreak","Properties":{"id":"20240607145556-rb4i5yd"}},{"ID":"20240607145557-5ortaiz","Type":"NodeParagraph","Properties":{"id":"20240607145557-5ortaiz"}}]}