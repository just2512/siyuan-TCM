cket"},{"Type":"NodeLinkText","Data":"秦艽 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/秦艽 1-20240814104404-zko1ijs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 751px;\" parent-style=\"width: 761px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 292px;","style":"width: 282px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"秦艽 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/秦艽 19-20240814114718-gn6mo0l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 282px;\" parent-style=\"width: 292px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611143354-3hf0to9","Type":"NodeThematicBreak","Properties":{"id":"20240611143354-3hf0to9"}},{"ID":"20240611143541-nwww8ae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143541-nwww8ae","updated":"20240611143552"},"Children":[{"Type":"NodeText","Data":"秦艽《神农本草经》"}]},{"ID":"20240611143541-sfyuhh2","Type":"NodeParagraph","Properties":{"id":"20240611143541-sfyuhh2","updated":"20240611143541"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240611143541-air48ft","Type":"NodeParagraph","Properties":{"id":"20240611143541-air48ft","updated":"20240611143541"},"Children":[{"Type":"NodeText","Data":"主寒热邪气，寒湿，风痹，肢节痛，下水，利小便。生山谷。"}]},{"ID":"20240611143541-3jjz3j5","Type":"NodeParagraph","Properties":{"id":"20240611143541-3jjz3j5","updated":"20240611143541"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生飞乌山，二月八月，采根，暴干。"}]},{"ID":"20240611143541-oynse7d","Type":"NodeParagraph","Properties":{"id":"20240611143541-oynse7d","updated":"20240611143541"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上艹下卉）草之相（上艹下丩）者，玉篇作（上艹下丩），居包切。云秦艽，药艽同。萧炳云：本经名秦瓜，然则今本经名，亦有《名医》改之者。"}]},{"ID":"20240611143530-t3rlusj","Type":"NodeThematicBreak","Properties":{"id":"20240611143530-t3rlusj"}},{"ID":"20240611143531-dknqkj5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143531-dknqkj5","updated":"20240611143535"},"Children":[{"Type":"NodeText","Data":"秦艽《新修本草》"}]},{"ID":"20240611143531-dygyqlg","Type":"NodeParagraph","Properties":{"id":"20240611143531-dygyqlg","updated":"20240611143531"},"Children":[{"Type":"NodeText","Data":"味苦、辛，平、微温，无毒。主寒热邪气，寒湿风痹，肢节痛，下水，利小便。疗风无问久新，通身挛急。生飞乌山谷。二月、八月采根，曝干。"}]},{"ID":"20240611143531-jmljv92","Type":"NodeParagraph","Properties":{"id":"20240611143531-jmljv92","updated":"20240611143531"},"Children":[{"Type":"NodeText","Data":"菖蒲为之使。 飞乌或者地名，今出甘松、龙洞、蚕陵，长大黄白色为佳。根皆作罗文相交，中多衔土，用之熟破除去。方家多作秦胶字，与独活疗风常用，道家不须尔。"}]},{"ID":"20240611143531-yks2myg","Type":"NodeParagraph","Properties":{"id":"20240611143531-yks2myg","updated":"20240611143531"},"Children":[{"Type":"NodeText","Data":"〔谨案〕今良。本作札，或作纠，作胶；正作艽也。"}]},{"ID":"20240611143520-k6hfd97","Type":"NodeThematicBreak","Properties":{"id":"20240611143520-k6hfd97"}},{"ID":"20240611143521-2s4c9e2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143521-2s4c9e2","updated":"20240611143525"},"Children":[{"Type":"NodeText","Data":"秦艽《本草分经》"}]},{"ID":"20240611143521-fuyl7s9","Type":"NodeParagraph","Properties":{"id":"20240611143521-fuyl7s9","updated":"20240611143521"},"Children":[{"Type":"NodeText","Data":"苦辛，祛湿散风活血，去肠胃湿热，疏肝胆滞气，治一切湿胜风淫之症。"}]},{"ID":"20240611143354-w1jmifz","Type":"NodeThematicBreak","Properties":{"id":"20240611143354-w1jmifz"}},{"ID":"20240611143510-ew43y1t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143510-ew43y1t","updated":"20240611143515"},"Children":[{"Type":"NodeText","Data":"秦艽《本草撮要》"}]},{"ID":"20240611143510-pjlcb3r","Type":"NodeParagraph","Properties":{"id":"20240611143510-pjlcb3r","updated":"20240611143510"},"Children":[{"Type":"NodeText","Data":"味苦辛．入手足阳明兼入肝胆．功专去风湿挛痹．得独活、桂心治产后中风．得柴胡、甘草治劳热．得薄荷、甘草治小儿骨蒸潮热．食减瘦弱．独用治齿下龈痛．以牛乳点服．并治黄胆烦渴便赤．菖蒲为使．畏牛乳．为末涂口疮不合．"}]},{"ID":"20240611143501-31xdbrl","Type":"NodeThematicBreak","Properties":{"id":"20240611143501-31xdbrl"}},{"ID":"20240611143502-3w4iw8x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143502-3w4iw8x","updated":"20240611143506"},"Children":[{"Type":"NodeText","Data":"秦艽《本草害利》"}]},{"ID":"20240611143502-awbe47r","Type":"NodeParagraph","Properties":{"id":"20240611143502-awbe47r","updated":"20240611143502"},"Children":[{"Type":"NodeText","Data":"〔害〕泄散疏利之品，凡下部虚寒，小便不禁，大便滑者勿服。"}]},{"ID":"20240611143502-2pl098t","Type":"NodeParagraph","Properties":{"id":"20240611143502-2pl098t","updated":"20240611143502"},"Children":[{"Type":"NodeText","Data":"〔利〕苦寒平，入胃、肝、胆、大小肠五经。祛风活络，养血舒筋，退热退黄，利湿通淋。"}]},{"ID":"20240611143502-75yn8rn","Type":"NodeParagraph","Properties":{"id":"20240611143502-75yn8rn","updated":"20240611143502"},"Children":[{"Type":"NodeText","Data":"〔修治〕二八月采根，曝干用，形作罗纹相交，长大白左纹者良。"}]},{"ID":"20240611143445-6mr3djo","Type":"NodeThematicBreak","Properties":{"id":"20240611143445-6mr3djo"}},{"ID":"20240611143446-ljypzw4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143446-ljypzw4","updated":"20240611143454"},"Children":[{"Type":"NodeText","Data":"秦艽《得配本草》"}]},{"ID":"20240611143446-upmxyur","Type":"NodeParagraph","Properties":{"id":"20240611143446-upmxyur","updated":"20240611143446"},"Children":[{"Type":"NodeText","Data":"菖蒲为之使。畏牛乳。"}]},{"ID":"20240611143446-rgz8ou3","Type":"NodeParagraph","Properties":{"id":"20240611143446-rgz8ou3","updated":"20240611143446"},"Children":[{"Type":"NodeText","Data":"辛、苦、温。入手足阳明经气分，去风湿寒痹，疗黄胆酒毒，舒筋养血。（皆祛湿之功。）"}]},{"ID":"20240611143446-4s15onn","Type":"NodeParagraph","Properties":{"id":"20240611143446-4s15onn","updated":"20240611143446"},"Children":[{"Type":"NodeText","Data":"得肉桂，治产后中风。得牛乳，治伤寒烦渴，及发背初起，并治五种黄胆。（一种误食鼠粪作黄，多涕痰，目有赤脉，憔悴面赤恶心者是也。）配阿胶、艾，治胎动不安。佐柴胡，治风湿骨蒸。（风入骨，故热。）"}]},{"ID":"20240611143446-mttwy5l","Type":"NodeParagraph","Properties":{"id":"20240611143446-mttwy5l","updated":"20240611143446"},"Children":[{"Type":"NodeText","Data":"左纹者良，右纹者发香港脚。以布刷去黄白毛，童便浸一宿，炒干用。"}]},{"ID":"20240611143446-a456u9t","Type":"NodeParagraph","Properties":{"id":"20240611143446-a456u9t","updated":"20240611143446"},"Children":[{"Type":"NodeText","Data":"肾虚便多，血虚筋痛，二者禁用。"}]},{"ID":"20240611143434-bap4jpw","Type":"NodeThematicBreak","Properties":{"id":"20240611143434-bap4jpw"}},{"ID":"20240611143435-9z7v6d8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143435-9z7v6d8","updated":"20240611143440"},"Children":[{"Type":"NodeText","Data":"秦艽《冯氏锦囊秘录》"}]},{"ID":"20240611143435-2em9n6n","Type":"NodeParagraph","Properties":{"id":"20240611143435-2em9n6n","updated":"20240611143435"},"Children":[{"Type":"NodeText","Data":"感秋金之气，故味苦、辛、平、微温，无毒。入手足阳明经。苦能泄，辛能散，微温能通利，故主寒热邪气，寒温风痹肢节痛，下水利小便。性能祛风除湿，无问久新及通身挛急，能燥湿，散热结肠风，泻血养血荣筋之要药。"}]},{"ID":"20240611143435-18j9pxd","Type":"NodeParagraph","Properties":{"id":"20240611143435-18j9pxd","updated":"20240611143435"},"Children":[{"Type":"NodeText","Data":"秦艽，养血舒筋，除风痹，肢节俱通，通便利水，散黄胆遍体如金，除头风，解酒毒，止肠风下血，去骨蒸传尸，其性养血祛风，入胃而除湿热，故挛急痹症者风也。黄疸便涩者，湿热也。为风药之润剂，但下部虚寒人，小便不禁者勿服。"}]},{"ID":"20240611143435-8g4tts3","Type":"NodeParagraph","Properties":{"id":"20240611143435-8g4tts3","updated":"20240611143435"},"Children":[{"Type":"NodeText","Data":"按∶秦艽，风药中之润剂，散药中之补剂，故养血有功，中风多用之者，取祛风活络，养血舒筋，盖治风先治血，血行风自灭耳。"}]},{"ID":"20240611143418-4pw5mj2","Type":"NodeThematicBreak","Properties":{"id":"20240611143418-4pw5mj2"}},{"ID":"20240611143420-3yh8hx0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143420-3yh8hx0","updated":"20240611143429"},"Children":[{"Type":"NodeText","Data":"秦艽《本草图经》"}]},{"ID":"20240611143420-zg2y5ss","Type":"NodeParagraph","Properties":{"id":"20240611143420-zg2y5ss","updated":"20240611143424"},"Children":[{"Type":"NodeText","Data":"秦艽，生飞乌山谷，今河陕州军多有之。根土黄色，而相交纠，长一尺以来，粗细不等；枝秆高五、六寸。叶婆娑，连茎梗俱青色，如莴苣叶；六月中开花紫色，似葛花，当月结子。"}]},{"ID":"20240611143420-7dzj7yu","Type":"NodeParagraph","Properties":{"id":"20240611143420-7dzj7yu","updated":"20240611143420"},"Children":[{"Type":"NodeText","Data":"每于春秋采根，阴干。《正元广利方》∶疗黄，心烦热，口干，皮肉皆黄。以秦艽十二分，牛乳一大升，同煮，取七合，去滓，分温再服，瘥。此方出于许仁则。又崔元亮《集验方》；凡发背疑似者，须便服秦艽牛乳煎，当得快利三五行，即瘥。法并同此。又治黄方，用秦艽一大两，细锉，作两贴子，以上好酒一升，每贴半升，酒绞，取汁，去滓，空腹分两服，或利便止就中，好酒人易治。凡黄有数种∶伤酒曰酒黄；夜食，误食鼠粪亦作黄；因劳发黄多痰涕，目有赤脉，日益憔悴，或面赤、恶心者是。元亮用之，及治人皆得力，极效。秦艽须用新好罗文者。"}]},{"ID":"20240611143354-dh6a2ew","Type":"NodeThematicBreak","Properties":{"id":"20240611143354-dh6a2ew"}},{"ID":"20240611143410-k2xnkdp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143410-k2xnkdp","updated":"20240611143414"},"Children":[{"Type":"NodeText","Data":"秦艽《本草求真》"}]},{"ID":"20240611143410-noo6t92","Type":"NodeParagraph","Properties":{"id":"20240611143410-noo6t92","updated":"20240611143410"},"Children":[{"Type":"NodeText","Data":"（山草）除肠胃湿热兼除肝胆风邪止痹除痛"}]},{"ID":"20240611143410-1zktb1w","Type":"NodeParagraph","Properties":{"id":"20240611143410-1zktb1w","updated":"20240611143410"},"Children":[{"Type":"NodeText","Data":"秦艽（专入肠胃。兼入肝胆。）苦多于辛。性平微温。凡人感冒风寒与湿。则身体酸痛。肢节烦疼。拘挛不遂。如风胜则为行痹。（痹兼三气皆有。兹止就其胜者而言。）寒胜则为痛痹。湿胜则为着痹。痹在于骨则体重。痹在于脉则血涩。痹在于筋则拘挛。痹在于肉则不仁。痹在于皮则肤寒。至于手足酸疼。寒热俱有。则为阳明之湿。潮热骨蒸。则为阳明之热。推而疸黄便涩。肠风泻血。口噤牙痛。（上龈属胃。下龈属大肠。秦艽能除风湿牙痛。）亦何莫不由阳明湿热与风所成。用此苦多于辛。以燥阳明湿邪。辛兼以苦。以除肝胆风热。实为祛风除湿之剂。（风除则润。故秦艽为风药中润剂。湿去则补。故秦艽为散药中补剂。圣惠方治急痨烦热。身体酸疼。用秦艽柴胡一两。甘草五钱。为末。每服三钱。白汤调下。治小儿骨蒸潮热。减食瘦弱。用秦艽炙甘草各一两。每用一二钱。水煎服之。加薄荷叶五钱。）然久痛虚羸。血气失养。下体虚寒。酸疼枯瘦。小便利者。咸非所宜。形作罗纹相交。长大黄白。左纹者良。右纹勿用。菖蒲为使。畏牛乳。"}]},{"ID":"20240611143230-xz3ix8j","Type":"NodeThematicBreak","Properties":{"id":"20240611143230-xz3ix8j"}},{"ID":"20240611143400-vzbuw64","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143400-vzbuw64","updated":"20240611143404"},"Children":[{"Type":"NodeText","Data":"秦艽《汤液本草》"}]},{"ID":"20240611143400-jk4wath","Type":"NodeParagraph","Properties":{"id":"20240611143400-jk4wath","updated":"20240611143400"},"Children":[{"Type":"NodeText","Data":"气微温，味苦、辛，阴中微阳。"}]},{"ID":"20240611143400-829vfze","Type":"NodeParagraph","Properties":{"id":"20240611143400-829vfze","updated":"20240611143400"},"Children":[{"Type":"NodeText","Data":"手阳明经药。"}]},{"ID":"20240611143400-mgso5bz","Type":"NodeParagraph","Properties":{"id":"20240611143400-mgso5bz","updated":"20240611143400"},"Children":[{"Type":"NodeText","Data":"《象》云∶主寒热邪气，风湿痹，下水，利小便。治黄病骨蒸。治口禁及肠风泻血。"}]},{"ID":"20240611143400-p7sjfsf","Type":"NodeParagraph","Properties":{"id":"20240611143400-p7sjfsf","updated":"20240611143400"},"Children":[{"Type":"NodeText","Data":"去芦用。"}]},{"ID":"20240611143400-zicw3hp","Type":"NodeParagraph","Properties":{"id":"20240611143400-zicw3hp","updated":"20240611143400"},"Children":[{"Type":"NodeText","Data":"《珍》云∶去手阳明经下牙痛，口疮毒，去本经风湿。"}]},{"ID":"20240611143400-vdw7jf6","Type":"NodeParagraph","Properties":{"id":"20240611143400-vdw7jf6","updated":"20240611143400"},"Children":[{"Type":"NodeText","Data":"《本草》云∶菖蒲为之使。"}]},{"ID":"20240611143247-i44cjqj","Type":"NodeThematicBreak","Properties":{"id":"20240611143247-i44cjqj"}},{"ID":"20240611143345-aa523d3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143345-aa523d3","updated":"20240611143352"},"Children":[{"Type":"NodeText","Data":"秦艽《本经逢原》"}]},{"ID":"20240611143345-sonpjae","Type":"NodeParagraph","Properties":{"id":"20240611143345-sonpjae","updated":"20240611143345"},"Children":[{"Type":"NodeText","Data":"苦平微温，无毒。雷公云，左文列为秦，治湿病。右文列为艽，治香港脚。今药肆多右文者，慎勿混合。"}]},{"ID":"20240611143345-41qyf8n","Type":"NodeParagraph","Properties":{"id":"20240611143345-41qyf8n","updated":"20240611143345"},"Children":[{"Type":"NodeText","Data":"《本经》主寒热邪气，寒湿风痹，肢节痛，下水，利小便。"}]},{"ID":"20240611143345-5nrwrwc","Type":"NodeParagraph","Properties":{"id":"20240611143345-5nrwrwc","updated":"20240611143345"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"秦艽阴中微阳，可升可降，入手足阳明，以其去湿也，兼入肝胆，以其治风也。"}]},{"ID":"20240611143345-f5ochnl","Type":"NodeParagraph","Properties":{"id":"20240611143345-f5ochnl","updated":"20240611143345"},"Children":[{"Type":"NodeText","Data":"故手足不遂，黄瘅酒毒及妇人带疾，须之阳明有湿，则身体酸痛，肢节烦疼及挛急不遂，有热则日晡潮热，用以祛风胜湿则愈。凡痛有寒热或浮肿者，多挟客邪，用此以祛风利湿方为合剂，故《本经》治寒热邪气，寒湿风痹，肢节痛等证。若久痛虚羸，血气不能营养肢体而痛，及下体虚寒，痛酸枯瘦等病，而小便清利者，咸非秦艽所宜。今庸师喜用秦艽，且不辨左文、右文，凡遇痛证，动辄用之，失其旨矣。"}]},{"ID":"20240611143332-w8ld536","Type":"NodeThematicBreak","Properties":{"id":"20240611143332-w8ld536"}},{"ID":"20240611143333-jzkmuh4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143333-jzkmuh4","updated":"20240611143340"},"Children":[{"Type":"NodeText","Data":"秦艽《本草备要》"}]},{"ID":"20240611143333-uela4zu","Type":"NodeParagraph","Properties":{"id":"20240611143333-uela4zu","updated":"20240611143333"},"Children":[{"Type":"NodeText","Data":"宣，去寒湿"}]},{"ID":"20240611143333-as4myyv","Type":"NodeParagraph","Properties":{"id":"20240611143333-as4myyv","updated":"20240611143333"},"Children":[{"Type":"NodeText","Data":"苦燥湿，辛散风。去肠胃之热，益肝胆之气，养血荣筋（风药中润剂，散药中补剂）。"}]},{"ID":"20240611143333-aipp5fl","Type":"NodeParagraph","Properties":{"id":"20240611143333-aipp5fl","updated":"20240611143333"},"Children":[{"Type":"NodeText","Data":"治风寒湿痹（经曰∶风寒湿三气杂至，合而为痹。风胜为行痹，寒胜为痛痹，湿胜为着痹。痹在于骨则体重，在脉则血涩，在筋则拘挛，在肉则不仁，在皮则寒），通身挛急，（血不荣筋），虚劳骨蒸（时珍曰∶手足阳阴经药，兼入肝胆。阳明有湿，则手足酸痛寒热，有热则日晡潮热骨蒸。《圣惠方》治急劳烦热，秦艽、柴胡各一两，甘草五钱，为末，每服三钱。治小儿骨蒸潮热食减瘦弱，秦艽、炙甘草各一两，每服一二钱，钱乙加薄荷五钱），疸黄酒毒，肠风泻血，口噤牙痛（齿下龈属手阳明大肠经。张洁古曰∶秦艽能去下牙痛，及本经风湿）。湿胜风淫之证，利大小便（牛乳点服，兼治黄胆，烦渴便赤）。"}]},{"ID":"20240611143333-qhfeit5","Type":"NodeParagraph","Properties":{"id":"20240611143333-qhfeit5","updated":"20240611143333"},"Children":[{"Type":"NodeText","Data":"形作罗纹相交，长大黄白左纹者良。菖蒲为使，畏牛乳。"}]},{"ID":"20240611143247-ny67cg0","Type":"NodeThematicBreak","Properties":{"id":"20240611143247-ny67cg0"}},{"ID":"20240611143313-liqbo22","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143313-liqbo22","updated":"20240611143317"},"Children":[{"Type":"NodeText","Data":"秦艽《本草经解》"}]},{"ID":"20240611143313-z9b8hmk","Type":"NodeParagraph","Properties":{"id":"20240611143313-z9b8hmk","updated":"20240611143313"},"Children":[{"Type":"NodeText","Data":"气平．味苦．无毒．主寒热邪气．寒湿风痹．肢节痛．下水利小便．（便浸晒）"}]},{"ID":"20240611143313-9fs0ru6","Type":"NodeParagraph","Properties":{"id":"20240611143313-9fs0ru6","updated":"20240611143313"},"Children":[{"Type":"NodeText","Data":"秦艽气平．禀天秋降之金气．入手太阴肺经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．皮毛属肺．外感之邪气．从皮毛而入者．或寒或热．感则肺先受邪．秦艽入肺．味苦能泄．所以主之．风寒湿三者合而成痹．痹则血涩不行矣．味苦入心．心生血．苦能散结．血行痹自愈也．肢节痛．湿流关节而痛也．秦艽气平降肺．肺气行则水道通．水道通则湿下逐矣．其下水利小便者．皆通水道之功也．左文者良．"}]},{"ID":"20240611143313-y44kf1c","Type":"NodeParagraph","Properties":{"id":"20240611143313-y44kf1c","updated":"20240611143313"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611143313-k0sqq6e","Type":"NodeParagraph","Properties":{"id":"20240611143313-k0sqq6e","updated":"20240611143313"},"Children":[{"Type":"NodeText","Data":"秦艽酒煎．治黄胆．专一两．治小便难腹满．同柴胡、甘草．治急劳烦热．同干葛、茵陈、五味、川莲、扁豆、木通、苡仁．治酒疸．同苡仁、木瓜、五加皮、黄柏、苍术、牛膝．治下部湿热作痛．及湿疮．"}]},{"ID":"20240611143301-zwwpw1p","Type":"NodeThematicBreak","Properties":{"id":"20240611143301-zwwpw1p"}},{"ID":"20240611143303-sqjueeo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143303-sqjueeo","updated":"20240611143307"},"Children":[{"Type":"NodeText","Data":"秦艽《本草崇原》"}]},{"ID":"20240611143303-hdym614","Type":"NodeParagraph","Properties":{"id":"20240611143303-hdym614","updated":"20240611143303"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主治寒热邪气，寒湿风痹，肢节痛，下水，利小便。"}]},{"ID":"20240611143303-flh8bdm","Type":"NodeParagraph","Properties":{"id":"20240611143303-flh8bdm","updated":"20240611143303"},"Children":[{"Type":"NodeText","Data":"（秦艽出秦中，今泾州、 州、岐州、河陕诸郡皆有。其根土黄色，作罗纹交纠左右旋转。李时珍曰∶以左纹者良，今市肆中或左或右，俱不辨矣。）"}]},{"ID":"20240611143303-m3d0zov","Type":"NodeParagraph","Properties":{"id":"20240611143303-m3d0zov","updated":"20240611143303"},"Children":[{"Type":"NodeText","Data":"秦艽气味苦平，色如黄土，罗纹交纠，左右旋转，禀天地阴阳交感之气，盖天气左旋右转，地气右旋左转，左右者，阴阳之道路。主治寒热邪气者，地气从内以出外，阴气外交于阳，而寒热邪气自散矣。治寒湿风痹，肢节痛者，天气从外以入内，阳气内交于阴，则寒湿风三邪，合而成痹，以致肢节痛者，可愈也。地气营运则水下，天气营运则小便利。"}]},{"ID":"20240611143248-awsi65k","Type":"NodeThematicBreak","Properties":{"id":"20240611143248-awsi65k"}},{"ID":"20240611143249-j7nhig1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143249-j7nhig1","updated":"20240611143256"},"Children":[{"Type":"NodeText","Data":"秦艽《本草述钩元》"}]},{"ID":"20240611143249-gse8y3j","Type":"NodeParagraph","Properties":{"id":"20240611143249-gse8y3j","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"产于秦中。根长尺余。粗细不等。土黄色而相交纠。故名。春秋采根。阴干用。右列者不堪入药。令人发香港脚病也。气微温。味苦平兼辛。阴中微阳。可升可降。降多于升。入手足阳明经。菖蒲为之使。本经主寒热邪气。寒湿风痹。肢节痛。下水利小便。疗风无问久新。通身挛急。除阳明风湿及热。手足不遂。口噤。养血荣筋。益胆气。泄热。除虚劳发热骨蒸。酒疸黄胆。肠风泻血。（诸本草）入手足阳明兼入肝胆。故手足不遂。黄胆烦渴之病须之。取其去阳明之湿热。阳明有湿则身体酸疼烦热。有热则日晡潮热骨蒸。所以圣惠方俱用艽。（濒湖）胸中热结。宜前胡。经络热结。宜秦艽。（阆风）人身直者为经。横者为络。"}]},{"ID":"20240611143249-om5e6qo","Type":"NodeParagraph","Properties":{"id":"20240611143249-om5e6qo","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"络之下注者为孙。肌腠之邪多从孙入。次薄于络。复溜于经。渐传腑脏。秦艽罗纹错综如织。"}]},{"ID":"20240611143249-fwruizd","Type":"NodeParagraph","Properties":{"id":"20240611143249-fwruizd","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"象形。从治法也。（复）根有罗纹左旋者入药。盖天道左旋。而人生气从之。邪气伤人。逆乎天道。以致内闭九窍。外壅肌肉。卫气散解。是以本经用治寒热邪气。或风寒湿痹。致骨节水道反从地道右旋者。别录诸家。用治转胞口噤。目暗耳鸣。即九窍内闭也。痈疽黄胆。"}]},{"ID":"20240611143249-4hga00w","Type":"NodeParagraph","Properties":{"id":"20240611143249-4hga00w","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"传尸骨蒸。即肌肉外壅也。手足不遂。通身挛急。即卫气散解也。（之颐）奏艽为风药中润剂。散药中补剂。故养血有功。而中风恒用之。同干葛黄连茵陈五味扁豆木香苜蓿。治酒疸。"}]},{"ID":"20240611143249-d6g4gpq","Type":"NodeParagraph","Properties":{"id":"20240611143249-d6g4gpq","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"同薏仁附方急劳烦热。身体酸疼。用秦艽柴胡各一两。甘草五钱。为细末。每服三钱。白汤送下。小儿骨蒸潮热。减食瘦弱。用秦艽炙甘草各一两。每用一二钱。水煎服之。钱乙加薄荷五钱。上二方俱用甘草。俾合之化血。而前有柴胡。后加薄荷。不离风木以行湿土之用。"}]},{"ID":"20240611143249-rf1tohv","Type":"NodeParagraph","Properties":{"id":"20240611143249-rf1tohv","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"相助为理也。黄胆皮肤眼睛如金色。小便赤。取秦艽五两。牛乳三升。煮取一升。去渣。纳芒硝一两。分作三服。此孙真人方。秦艽恶牛乳。然治黄胆又同用之。须参。小便艰难。或转胞腹满闷。不急疗杀人。用秦艽加冬葵子等分。为末。酒服一匙。"}]},{"ID":"20240611143249-7ji6rcc","Type":"NodeParagraph","Properties":{"id":"20240611143249-7ji6rcc","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"〔论〕秦艽罗纹错综如织。象形以治经络之病者也。夫三阴经自下而上。所以达阳。"}]},{"ID":"20240611143249-x0rip9e","Type":"NodeParagraph","Properties":{"id":"20240611143249-x0rip9e","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"三阳经自上而下。所以达阴。艽本微温之气。其味苦优而辛逊之。苦先而辛继之。是自下而上也。然温气出自地。辛味根于苦。升已而降。自返其始。则又是自上而下也。出地之风。"}]},{"ID":"20240611143249-7a25l8z","Type":"NodeParagraph","Properties":{"id":"20240611143249-7a25l8z","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"能举阴以升。而还能合阴以降。则天地气达。而三阴三阳之经。无或壅遏以为病矣。夫肢节痛似为湿病。通身挛急是为风病。而独以风剂名此味。正谓风虚则天气不达于上而病于湿。"}]},{"ID":"20240611143249-smbqssd","Type":"NodeParagraph","Properties":{"id":"20240611143249-smbqssd","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"风淫则地气不达于下而病于风。总藉出地之风化。以一升一降转旋之。所以纹贵左旋者。以人身之阳（离阴则无阳）自左而升。升者谓天。（肝居左。主人身血分。故阳之升者。必由于左。）升已而降。降者谓地。阴降而阳随之。俱返其所自始也。使不本于天气之左旋以为东升。乌能俾阳之不离于阴者。遂得右旋以降。且返其所始而转旋不息乎。抑所谓错综如织。"}]},{"ID":"20240611143249-heo6zw1","Type":"NodeParagraph","Properties":{"id":"20240611143249-heo6zw1","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"象形以治经络之病者。经云。阴气从足上行至头。（阴升）而下行循臂至指端。阳气从手上行至头。而下行至足。（阳降）盖阴本下降。而阴之升者。乃随阳以升。阳本上升。而阳之降者。乃和阴以降。就此而推错综微义。则知人身经络有阳之顺而升。乃得阴之逆而上。有阴之顺而降。乃得阳之逆而下。是阴阳之分者。顺不俱顺。逆不俱逆。而阴阳之合者。逆者不得不从乎顺。顺者不得不从乎逆。造化元机。付于人身者如此。而是物错综之形。适有合焉。不尽如诸风剂。但以生升为功也。至于兹味治病。本草独以风湿为言。因风湿固即阴阳之正气所化。（人身惟是水火二气。而水火之体物不遗者土也。内经太阴阳明之异。曰。阳者天气也。阴者地气也。夫天包地外。而地气贯于天之中。地有经水。犹人有经脉。故此风湿二气。为阴阳之最先流通于经络以为生之本者。）亦即阴阳之戾气所病。（阳受风气。阴受湿气。此阴阳之戾气为病于经络者。）举其最切者言之。即可以包诸证之所用矣。或谓艽治足阳明风热。如头风口噤。其有湿则为身体酸疼烦热。有热则为日晡潮热骨蒸。又湿热如黄疸酒疸。以及手阳明所患。如下牙痛肠风泻血等证。是亦关于经络乎。岂知人身气血。惟责化原于中土。而中土必资于活络之风化。以土木交相为用。而互相为病也。如风热病于肝。"}]},{"ID":"20240611143249-5hgubau","Type":"NodeParagraph","Properties":{"id":"20240611143249-5hgubau","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"自刑于胃土。湿热病于胃。亦自及于肝。而还乘于胃土。故胃土借此味最切。（其治风木湿土合病。有养血活络之功。缘血生于胃。纳于肝也。）此味当与柴胡殊用。而并有功于胃。"}]},{"ID":"20240611143249-47kp6vi","Type":"NodeParagraph","Properties":{"id":"20240611143249-47kp6vi","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"况乎手阳明本于足阳明以下行。尤为乙庚之合者哉。彼夫肠风泻血为病。乃肝之经络不能纳血。而风淫于肠胃。使血溢于所合之腑耳。然则胃为气血所生之地。而风木尤为生化之本。"}]},{"ID":"20240611143249-orb1cv6","Type":"NodeParagraph","Properties":{"id":"20240611143249-orb1cv6","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"此其一征矣。"}]},{"ID":"20240611143249-lybozhr","Type":"NodeParagraph","Properties":{"id":"20240611143249-lybozhr","updated":"20240611143249"},"Children":[{"Type":"NodeText","Data":"〔修治〕拭去黄白毛。水洗。去土用。"}]},{"ID":"20240611143230-mz0hg4l","Type":"NodeThematicBreak","Properties":{"id":"20240611143230-mz0hg4l"}},{"ID":"20240611143231-rcenv0h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143231-rcenv0h","updated":"20240611143239"},"Children":[{"Type":"NodeText","Data":"秦艽《本草便读》"}]},{"ID":"20240611143231-s8o78uw","Type":"NodeParagraph","Properties":{"id":"20240611143231-s8o78uw","updated":"20240611143231"},"Children":[{"Type":"NodeText","Data":"养血祛风．和营利水．疏肌解表．苦平略带微辛．散热润肠．入肝又能达胃．湿胜风淫之证．赖以搜除．筋痹骨痿诸邪．仗其宣利．（秦艽出秦中．其根如罗纹相交．故名之．味苦而辛．性平质润．虽有养血之能．毕竟散邪之品．然风邪在表宜用．解表者又非其所长．只可于营血中搜除风寒湿三气痹闭之邪耳．又按秦艽苦胜于辛．全无甘味．苦能泄．辛能散．故本经称其能散风逐湿．然散风湿之药多燥．此独偏润．故又为风药中润剂．观其质润．罗纹相交．即知其祛风逐湿中．而能和营血行经络矣．）"}]},{"ID":"20240611143112-9a28l67","Type":"NodeThematicBreak","Properties":{"id":"20240611143112-9a28l67"}},{"ID":"20240611143223-5b0rp4n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143223-5b0rp4n","updated":"20240611143223"},"Children":[{"Type":"NodeText","Data":"秦艽"}]},{"ID":"20240611143223-bz7vuyh","Type":"NodeParagraph","Properties":{"id":"20240611143223-bz7vuyh","updated":"20240611143223"},"Children":[{"Type":"NodeText","Data":"味苦，气平，入足厥阴肝经。发宣经络，驱除风湿，治中风瘫痪、湿家筋挛骨痛、黄疸之证。"}]},{"ID":"20240611143112-0sb1ny2","Type":"NodeThematicBreak","Properties":{"id":"20240611143112-0sb1ny2"}},{"ID":"20240611143113-fp3179q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143113-fp3179q","updated":"20240611143127"},"Children":[{"Type":"NodeText","Data":"秦艽《中药学》"}]},{"ID":"20240611143113-ijap8jp","Type":"NodeParagraph","Properties":{"id":"20240611143113-ijap8jp","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【药用】龙胆科草本植物秦艽GentianamacrophyllaPall.麻黄秦艽G.straminea Maxim.粗茎秦艽G.CrassicaulisDuthieexBurk.或小秦艽G.dahurica Fish.的根。"}]},{"ID":"20240611143113-xzljz8n","Type":"NodeParagraph","Properties":{"id":"20240611143113-xzljz8n","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、辛，平。归胃、肝、胆经。"}]},{"ID":"20240611143113-98acf7p","Type":"NodeParagraph","Properties":{"id":"20240611143113-98acf7p","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【功效】祛除风湿，退黄胆，除虚热。"}]},{"ID":"20240611143113-q6x43or","Type":"NodeParagraph","Properties":{"id":"20240611143113-q6x43or","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于风湿痹痛。"}]},{"ID":"20240611143113-40mutg3","Type":"NodeParagraph","Properties":{"id":"20240611143113-40mutg3","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"秦艽功能祛风湿、舒筋络，常用于风湿痹痛、关节拘挛、手足不遂等症。本品药性润而不燥，无论寒湿、湿热、痹证新久，皆可应用。在配伍方面常与防风、羌活、独活、桑枝等同用。此外，本品还常与祛风解表药同用，治疗表证枝体酸痛之症。"}]},{"ID":"20240611143113-2vplsm2","Type":"NodeParagraph","Properties":{"id":"20240611143113-2vplsm2","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"2.用于湿热黄疸。"}]},{"ID":"20240611143113-eoc39ok","Type":"NodeParagraph","Properties":{"id":"20240611143113-eoc39ok","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"秦艽功能化湿退黄，故可治疗湿热黄疸，常与茵陈、茯苓、泽泻等配伍。"}]},{"ID":"20240611143113-el2350s","Type":"NodeParagraph","Properties":{"id":"20240611143113-el2350s","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"3.用于骨蒸潮热。"}]},{"ID":"20240611143113-13mdlb3","Type":"NodeParagraph","Properties":{"id":"20240611143113-13mdlb3","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"本品又能退除虚热，治疗骨蒸潮热，常与鳖甲、知母、地骨皮等配伍．"}]},{"ID":"20240611143113-e6mzwff","Type":"NodeParagraph","Properties":{"id":"20240611143113-e6mzwff","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【处方用名】秦艽、西秦艽、左秦艽（洗净，晒干，切片用）"}]},{"ID":"20240611143113-4anj8wh","Type":"NodeParagraph","Properties":{"id":"20240611143113-4anj8wh","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240611143113-b4whud2","Type":"NodeParagraph","Properties":{"id":"20240611143113-b4whud2","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【按语】1.秦艽味辛能散，祛风止痛，能治风湿痹痛，及外邪肢体酸痛，味苦能泄，清除虚热，能治骨蒸潮热以及小儿疳热诸症。虽为辛散之药，而性平质润，乃风中润剂也。"}]},{"ID":"20240611143113-7xvp873","Type":"NodeParagraph","Properties":{"id":"20240611143113-7xvp873","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"2.秦艽诸家本草有谓其有清湿热、退黄疸之能，现临床应用之并不多见，似可存之以供研究者。"}]},{"ID":"20240611143113-nv7ctcd","Type":"NodeParagraph","Properties":{"id":"20240611143113-nv7ctcd","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【方剂举例】大秦艽汤（《活法机要》）：秦艽、生地、石膏、羌活、防风、白芷、细辛、黄芩、当归、白芍、川芎、熟地、白朮、茯苓、甘草、独活。治风湿痹痛，手足不仁。"}]},{"ID":"20240611143113-qdp8454","Type":"NodeParagraph","Properties":{"id":"20240611143113-qdp8454","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"秦艽鳖甲汤（《卫生宝鉴》）：秦艽、鳖甲、柴胡、地骨皮、当归、知母、青蒿、乌梅。治骨蒸壮热、肌肉消瘦、舌红颊赤、气粗、盗汗。"}]},{"ID":"20240611143113-eo92b7n","Type":"NodeParagraph","Properties":{"id":"20240611143113-eo92b7n","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《神农本草经》：「主寒热邪气，寒湿风痹，肢节痛，下水，小便利。」"}]},{"ID":"20240611143113-e9p01py","Type":"NodeParagraph","Properties":{"id":"20240611143113-e9p01py","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"《名医别录》：「疗风，无问久新；通身挛急。」"}]},{"ID":"20240611143113-cmnc8jd","Type":"NodeParagraph","Properties":{"id":"20240611143113-cmnc8jd","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"《药性论》：「利大小便，瘥五种黄病，解酒毒，去头风。」"}]},{"ID":"20240611143113-qjafd0o","Type":"NodeParagraph","Properties":{"id":"20240611143113-qjafd0o","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"《日华子本草》：「主骨蒸，治疳及时气。」"}]},{"ID":"20240611143113-mtgz5dz","Type":"NodeParagraph","Properties":{"id":"20240611143113-mtgz5dz","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「秦艽，手足不遂，黄疸，烦渴之病须之，取其去阳明之湿热也。阳明有湿，则身体酸痛烦热，有热则日晡潮热骨蒸。」"}]},{"ID":"20240611143113-h5g94ah","Type":"NodeParagraph","Properties":{"id":"20240611143113-h5g94ah","updated":"20240611143113"},"Children":[{"Type":"NodeText","Data":"《本草征要》：「治风先治血，血行则风自灭，故疗风无论新久。入胃袪湿热，故小便利而黄疸愈也。」"}]},{"ID":"20240611143037-1jfy8wc","Type":"NodeThematicBreak","Properties":{"id":"20240611143037-1jfy8wc"}},{"ID":"20240611143045-zs8ogvk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143045-zs8ogvk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"《中国药典》：秦艽"}]},{"ID":"20240611143045-9t26qly","Type":"NodeParagraph","Properties":{"id":"20240611143045-9t26qly","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611143045-0kz9385","Type":"NodeParagraph","Properties":{"id":"20240611143045-0kz9385","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" Qín Jiāo"}]},{"ID":"20240611143045-8dub8kt","Type":"NodeParagraph","Properties":{"id":"20240611143045-8dub8kt","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611143045-wlwhv4w","Type":"NodeParagraph","Properties":{"id":"20240611143045-wlwhv4w","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 麻花艽、小秦艽、大艽、西大艽、左扭、左拧、西秦艽、左秦艽、萝卜艽、辫子艽"}]},{"ID":"20240611143045-mwknc0l","Type":"NodeParagraph","Properties":{"id":"20240611143045-mwknc0l","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611143045-rsqxwxe","Type":"NodeParagraph","Properties":{"id":"20240611143045-rsqxwxe","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" RADIX GENTIANAE MACROPHYLLAE"}]},{"ID":"20240611143045-nbtjte4","Type":"NodeParagraph","Properties":{"id":"20240611143045-nbtjte4","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611143045-lcfcttk","Type":"NodeParagraph","Properties":{"id":"20240611143045-lcfcttk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 本品为龙胆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"秦艽"},{"Type":"NodeText","Data":"Gentiana macrophylla Pall. 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麻花秦艽"},{"Type":"NodeText","Data":"Gentiana straminea Maxim. 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粗茎秦艽"},{"Type":"NodeText","Data":"Gentiana crassicaulis Duthie ex Burk.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小秦艽"},{"Type":"NodeText","Data":"Gentiana dahurica Fisch. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。前三种按性状不同分别习称“秦艽”和“麻花艽”，后一种习称“小秦艽”。春、秋二季采挖，除去泥沙；秦艽及麻花艽晒软，堆置“发汗”至表面呈红黄色或灰黄色时，摊开晒干，或不经“发汗”直接晒干；小秦艽趁鲜时搓去黑皮，晒干。"}]},{"ID":"20240611143045-z817bxw","Type":"NodeParagraph","Properties":{"id":"20240611143045-z817bxw","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611143045-d3u1sqr","Type":"NodeParagraph","Properties":{"id":"20240611143045-d3u1sqr","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦艽：呈类圆柱形，上粗下细，扭曲不直，长10～30cm，直径1～3cm。表面黄棕色或灰黄色，有纵向或扭曲的纵皱纹，顶端有残存茎基及纤维状叶鞘。质硬而脆，易折断，断面略显油性，皮部黄色或棕黄色，木部黄色。气特异，味苦、微涩。"}]},{"ID":"20240611143045-x7g4msm","Type":"NodeParagraph","Properties":{"id":"20240611143045-x7g4msm","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"麻花艽：呈类圆锥形，多由数个小根纠聚而膨大，直径可达7cm。表面棕褐色，粗糙，有裂隙呈网状孔纹。质松脆，易折断，断面多呈枯朽状。"}]},{"ID":"20240611143045-llzrdnk","Type":"NodeParagraph","Properties":{"id":"20240611143045-llzrdnk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"小秦艽：呈类圆锥形或类圆柱形，长8～15cm，直径0。2～1cm。表面棕黄色。主根通常1个，残存的茎基有纤维状叶鞘，下部多分枝。断面黄白色。"}]},{"ID":"20240611143045-th7u1rg","Type":"NodeParagraph","Properties":{"id":"20240611143045-th7u1rg","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611143045-hyc5z37","Type":"NodeParagraph","Properties":{"id":"20240611143045-hyc5z37","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 置通风干燥。"}]},{"ID":"20240611143045-4umug77","Type":"NodeParagraph","Properties":{"id":"20240611143045-4umug77","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611143045-fkofy8x","Type":"NodeParagraph","Properties":{"id":"20240611143045-fkofy8x","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240611143045-yag9kdf","Type":"NodeParagraph","Properties":{"id":"20240611143045-yag9kdf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611143045-bfrhaw9","Type":"NodeParagraph","Properties":{"id":"20240611143045-bfrhaw9","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" （1）取本品粗粉2g，加氯仿－甲醇－浓氨试液（75:25:5）混合液30ml，浸泡2 小时，滤过，滤液置水浴上浓缩至约1ml，加1mol/L盐酸溶液2ml，继续蒸去氯仿，放冷，滤过。取滤液分置二支试管中，一管加碘化汞钾试液，即生成淡黄白色沉淀；另一管加碘化铋钾试液，即生成棕红色沉淀。"}]},{"ID":"20240611143045-q0j541e","Type":"NodeParagraph","Properties":{"id":"20240611143045-q0j541e","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"（2）取本品横断面，置紫外光灯（365nm）下观察，显黄白色或金黄色荧光。"}]},{"ID":"20240611143045-6w6b7fp","Type":"NodeParagraph","Properties":{"id":"20240611143045-6w6b7fp","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240611143045-eb0jq9x","Type":"NodeParagraph","Properties":{"id":"20240611143045-eb0jq9x","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240611143045-eqi1afi","Type":"NodeParagraph","Properties":{"id":"20240611143045-eqi1afi","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；甲醇-水（1：4）为流动相；检测波长为254nm。理论板数按龙胆苦苷峰计算应不低于3000。"}]},{"ID":"20240611143045-gpfbhbx","Type":"NodeParagraph","Properties":{"id":"20240611143045-gpfbhbx","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取龙胆苦苷对照品适量，加甲醇制成每1ml含0。5mg的溶液，即得。"}]},{"ID":"20240611143045-y2wy94k","Type":"NodeParagraph","Properties":{"id":"20240611143045-y2wy94k","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品粉末（过三号筛）约0。5g〔同时另取本品测定水分（附录Ⅸ H第一法）〕，精密称定，加甲醇20ml，加热回流30分钟，放冷，滤过，滤液减压回收至干，残渣用适量甲醇溶解，滤过，转移至50ml量瓶中，加甲醇至刻度，摇匀，精密量取1ml，置5ml量瓶中，加甲醇至刻度，摇匀，即得。"}]},{"ID":"20240611143045-pvbr1ed","Type":"NodeParagraph","Properties":{"id":"20240611143045-pvbr1ed","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取对照品溶液与供试品溶液各10μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240611143045-3xk3xgu","Type":"NodeParagraph","Properties":{"id":"20240611143045-3xk3xgu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含龙胆苦苷（C16H20O9）不得少于2。0％。"}]},{"ID":"20240611143045-c185iav","Type":"NodeParagraph","Properties":{"id":"20240611143045-c185iav","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611143045-ip80ue5","Type":"NodeParagraph","Properties":{"id":"20240611143045-ip80ue5","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 归胃、肝、胆经。"}]},{"ID":"20240611143045-30qlmgt","Type":"NodeParagraph","Properties":{"id":"20240611143045-30qlmgt","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611143045-nq7ruyt","Type":"NodeParagraph","Properties":{"id":"20240611143045-nq7ruyt","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 辛、苦，平。"}]},{"ID":"20240611143045-djn97iz","Type":"NodeParagraph","Properties":{"id":"20240611143045-djn97iz","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611143045-5vlihc7","Type":"NodeParagraph","Properties":{"id":"20240611143045-5vlihc7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 祛风湿，清湿热，止痹痛。用于风湿痹痛，筋脉拘挛，骨节酸痛，日晡潮热，小儿疳积发热。"}]},{"ID":"20240611143045-bcvja8x","Type":"NodeParagraph","Properties":{"id":"20240611143045-bcvja8x","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611143045-khfzvf9","Type":"NodeParagraph","Properties":{"id":"20240611143045-khfzvf9","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240611143045-j31fg1q","Type":"NodeParagraph","Properties":{"id":"20240611143045-j31fg1q","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611143045-jkq6shf","Type":"NodeParagraph","Properties":{"id":"20240611143045-jkq6shf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" （1）药性润而不燥，无论寒湿、湿热、痹证新久，皆可应用。在配伍方面常与防风、羌活、独活、桑枝等同用。此外，本品还常与祛风解表药同用，治疗表证枝体酸痛之症。治疗湿热黄疸，常与茵陈、茯苓、泽泻等配伍。治疗骨蒸潮热，常与鳖甲、知母、地骨皮等配伍．"}]},{"ID":"20240611143045-bb8gaa5","Type":"NodeParagraph","Properties":{"id":"20240611143045-bb8gaa5","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611143045-krk7r36","Type":"NodeParagraph","Properties":{"id":"20240611143045-krk7r36","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611143045-xjesj32","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143045-xjesj32","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：秦艽"}]},{"ID":"20240611143045-6hbicm5","Type":"NodeParagraph","Properties":{"id":"20240611143045-6hbicm5","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611143045-q4cz3ef","Type":"NodeParagraph","Properties":{"id":"20240611143045-q4cz3ef","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" Qín Jiāo"}]},{"ID":"20240611143045-ut1rkz9","Type":"NodeParagraph","Properties":{"id":"20240611143045-ut1rkz9","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611143045-6uv7s4k","Type":"NodeParagraph","Properties":{"id":"20240611143045-6uv7s4k","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦胶（《本草经集注》），秦纠（《唐本草》），秦爪（《四声本草》），左秦艽（《张聿青医案》），大艽、左宁根（《青海药材》），左扭（《河北药材》）。"}]},{"ID":"20240611143045-ymjvpgt","Type":"NodeParagraph","Properties":{"id":"20240611143045-ymjvpgt","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611143045-ny4wmt1","Type":"NodeParagraph","Properties":{"id":"20240611143045-ny4wmt1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611143045-hgqb283","Type":"NodeParagraph","Properties":{"id":"20240611143045-hgqb283","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611143045-fr29bpy","Type":"NodeParagraph","Properties":{"id":"20240611143045-fr29bpy","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 为龙胆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大叶龙胆、粗茎龙胆"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"西藏龙胆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋采挖，挖取后，除去茎叶、须根及泥土，晒干，或堆晒至颜色成红黄色或灰黄色时，再摊开晒干。"}]},{"ID":"20240611143045-6m2uw7g","Type":"NodeParagraph","Properties":{"id":"20240611143045-6m2uw7g","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611143045-4y7wlyl","Type":"NodeParagraph","Properties":{"id":"20240611143045-4y7wlyl","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①大叶龙胆，又名：大叶秦艽。"}]},{"ID":"20240611143045-d3rw294","Type":"NodeParagraph","Properties":{"id":"20240611143045-d3rw294","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"多年生草本，高40～60厘米。根强直。茎直立或斜上，圆柱形，光滑无毛，基部有许多纤维状残叶。叶披针形或长圆状披针形，在茎基部者较大，长达30厘米，宽3～4厘米，先端尖，全缘，叶脉3～5条；茎生叶3～4对，稍小，对生，基部连合。花生于上部叶腋，成轮状丛生，萼膜质，长约6毫米，先端有3～5个不等长的短齿；花冠筒状，深蓝紫色，长约2厘米，先端5裂，裂片卵圆形，先端急尖，裂片间有5褶状副冠片；雄蕊5，着生于花冠管中部；子房长圆状，无柄，花柱甚短，柱头2裂。蒴果长圆形。种子椭圆形，褐色，有光泽。花期7～8月。果期9～10月。"}]},{"ID":"20240611143045-6iwj2qa","Type":"NodeParagraph","Properties":{"id":"20240611143045-6iwj2qa","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"生于草地及湿坡上。分布黑龙江、辽宁、内蒙古、河北、山西、陕西、河南、宁夏、甘肃、青海、新疆及四川等地。"}]},{"ID":"20240611143045-odw89f9","Type":"NodeParagraph","Properties":{"id":"20240611143045-odw89f9","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②粗茎龙胆，又名：粗茎秦艽。"}]},{"ID":"20240611143045-8f1iujx","Type":"NodeParagraph","Properties":{"id":"20240611143045-8f1iujx","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"多年生草本。与上种相似，但根较粗长；茎顶端的叶卵形或狭卵形，与茎中部的叶大小相似；花萼无齿，一侧开裂，佛焰苞状；花较密集，花冠裂片先端微尖。"}]},{"ID":"20240611143045-dl35mvr","Type":"NodeParagraph","Properties":{"id":"20240611143045-dl35mvr","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"分布四川、云南、西藏等地。"}]},{"ID":"20240611143045-1ih1f6x","Type":"NodeParagraph","Properties":{"id":"20240611143045-1ih1f6x","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③西藏龙胆"}]},{"ID":"20240611143045-gligra1","Type":"NodeParagraph","Properties":{"id":"20240611143045-gligra1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"多年生草本。外形与上二种相似，茎顶端的叶近卵形，与茎中部的叶大小几相等；花萼具5～6个短齿，一侧开裂；花冠黄色。果实无柄。"}]},{"ID":"20240611143045-m8ph05l","Type":"NodeParagraph","Properties":{"id":"20240611143045-m8ph05l","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"分布西藏、四川、云南等地。"}]},{"ID":"20240611143045-5mmlfsu","Type":"NodeParagraph","Properties":{"id":"20240611143045-5mmlfsu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611143045-ntafuzu","Type":"NodeParagraph","Properties":{"id":"20240611143045-ntafuzu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①鸡腿艽"}]},{"ID":"20240611143045-pliaohj","Type":"NodeParagraph","Properties":{"id":"20240611143045-pliaohj","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"为植物大叶龙胆的干燥根。略呈圆锥形，上粗下细，长10～20厘米，上部直径1.5～4厘米。表面棕黄色或灰黄色，根头部由一个单生或数个合生而成，顶端残存茎基部并附有黄色纤雌状残叶，中部多具螺旋状扭曲的皱纹及须根痕，下部或有分枝。质松脆，易折断，断面不平坦，显油性，外层黄白色或棕黄色，中心木质部黄色。气特殊，味苦而涩。以粗大、肉厚、色棕黄者为佳。"}]},{"ID":"20240611143045-u91ivny","Type":"NodeParagraph","Properties":{"id":"20240611143045-u91ivny","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"主产甘肃、陕西、山西、内蒙古等地。"}]},{"ID":"20240611143045-p4yr8rb","Type":"NodeParagraph","Properties":{"id":"20240611143045-p4yr8rb","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②罗卜艽"}]},{"ID":"20240611143045-vnbemwe","Type":"NodeParagraph","Properties":{"id":"20240611143045-vnbemwe","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"为植物粗茎龙胆或西藏龙胆的干燥根。形如鸡腿艽而较长，微扭曲。"}]},{"ID":"20240611143045-kkz44mr","Type":"NodeParagraph","Properties":{"id":"20240611143045-kkz44mr","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"主产四川、云南、西藏。"}]},{"ID":"20240611143045-396lvly","Type":"NodeParagraph","Properties":{"id":"20240611143045-396lvly","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"商品秦艽，除上述主要品种外，尚有麻花艽和小秦艽。麻花艽主要为龙胆科植物麻花艽的根，较粗大，常数个交错缠绕，呈辫子、状或扭曲呈麻花状；质轻而疏松，内部常有腐朽的空心。产四川、青海、甘肃等地。"}]},{"ID":"20240611143045-rsei53f","Type":"NodeParagraph","Properties":{"id":"20240611143045-rsei53f","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"小秦艽为达乌里龙胆、北方龙胆、狭翅龙胆、天山龙胆及管花龙胆等的根。形细长而小，多分歧；质稍疏松，脆而易断。产河北、山西、内蒙古、陕西、青海、新疆等地。"}]},{"ID":"20240611143045-ppqm4v6","Type":"NodeParagraph","Properties":{"id":"20240611143045-ppqm4v6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611143045-dvrmzsh","Type":"NodeParagraph","Properties":{"id":"20240611143045-dvrmzsh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦艽碱甲对小鼠的半数致死量为：口服480毫克/公斤；腹腔注射350毫克/公斤；静脉注射250～300毫克/公斤。4例风湿性关节炎病人口服200毫克，每天3次，共4～13天，先后引起严重恶心、呕吐等；仅连服13日之1例，关节红肿、疼痛于第5日消失，余均无效，故认为此碱在初步临床应用中尚不够理想，且多副作用，尚待进一步改进。"}]},{"ID":"20240611143045-barpznl","Type":"NodeParagraph","Properties":{"id":"20240611143045-barpznl","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611143045-mu0m47a","Type":"NodeParagraph","Properties":{"id":"20240611143045-mu0m47a","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 置通风干燥。"}]},{"ID":"20240611143045-mrds818","Type":"NodeParagraph","Properties":{"id":"20240611143045-mrds818","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611143045-k4r282h","Type":"NodeParagraph","Properties":{"id":"20240611143045-k4r282h","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 大叶龙胆的根，分离出三种生物碱：龙胆宁碱、龙胆次碱及秦艽碱丙；还含有挥发油及糖类。"}]},{"ID":"20240611143045-26flvir","Type":"NodeParagraph","Properties":{"id":"20240611143045-26flvir","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"西藏龙胆的根含生物碱0.2％，其中有龙胆宁碱和欧龙胆碱。"}]},{"ID":"20240611143045-otpbtvz","Type":"NodeParagraph","Properties":{"id":"20240611143045-otpbtvz","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"天山龙胆的花和茎含生物碱0.22％，其中有龙胆宁碱、天山龙胆碱和龙胆黄碱。根含生物碱0.4％，其中有龙胆宁碱。"}]},{"ID":"20240611143045-v5cye2s","Type":"NodeParagraph","Properties":{"id":"20240611143045-v5cye2s","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611143045-iz92cr8","Type":"NodeParagraph","Properties":{"id":"20240611143045-iz92cr8","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①抗炎作用"}]},{"ID":"20240611143045-wcpgpy8","Type":"NodeParagraph","Properties":{"id":"20240611143045-wcpgpy8","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"秦艽碱甲能减轻大鼠的甲醛性\"关节炎\"，腹腔注射（90毫克/公斤）的效果与水杨酸钠200毫克/公斤相当。对大鼠蛋清性\"关节炎\"亦有作用，如预先注射氯喹或秦艽中性乙醇浸剂、水杨酸钠、皮质酮都能减轻关节肿胀的程度，并加速其消退。秦艽碱甲与氯喹、皮质酮及秦艽中性乙醇浸剂相似，但较水杨酸略强。在抗炎作用原理方面，认为秦艽碱甲是通过兴奋肾上腺皮质而实现的，因切除肾上腺后，秦艽即无抗炎作用；同时也证明了它确能使大鼠肾上腺内维生素C含量降低，而切除垂体后，即失去此种作用，故知其与促成质素尚有所不同，并不能直接兴奋肾上腺皮质。对用巴比妥麻醉的大鼠，秦艽碱甲亦无降低肾上腺内维生素C含量的作用，故知秦艽的抗炎作用是通过神经系统以激动垂体，促使肾上腺皮质激素分泌增加而实现的。秦艽碱甲的双氢化物（侧链上无双键）无消炎作用，由此可见双键的存在是药理作用必要的一环。"}]},{"ID":"20240611143045-p82d4qv","Type":"NodeParagraph","Properties":{"id":"20240611143045-p82d4qv","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"秦艽碱甲对豚鼠的组织胺性休克及大鼠的蛋清性过敏性休克均有显著的保护作用，它还能明显降低大鼠的毛细血管的通透性。"}]},{"ID":"20240611143045-j8lbvl7","Type":"NodeParagraph","Properties":{"id":"20240611143045-j8lbvl7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②对中枢神经系统的作用"}]},{"ID":"20240611143045-yx9zumn","Type":"NodeParagraph","Properties":{"id":"20240611143045-yx9zumn","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"秦艽碱甲小剂量对小鼠，大鼠的中枢神经系统有镇静作用，较大剂量则有中枢兴奋作用，最后导致麻痹而死亡。它本身无催眠作用，却能增强戊巴比妥的催眠-麻醉作用。较小剂量能抑制狗肠瘘因灌注氯化低汞所引起的反射性肠液分泌，即抑制了狗的神经系统。"}]},{"ID":"20240611143045-o6vr53j","Type":"NodeParagraph","Properties":{"id":"20240611143045-o6vr53j","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"秦艽碱甲对大鼠有一定的镇痛作用，但较短暂；对小鼠（热板法）亦有一定的镇痛作用，如与延胡索、草乌等并用，可使作用增强。"}]},{"ID":"20240611143045-v2fzuln","Type":"NodeParagraph","Properties":{"id":"20240611143045-v2fzuln","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③对循环系统的作用"}]},{"ID":"20240611143045-322td3a","Type":"NodeParagraph","Properties":{"id":"20240611143045-322td3a","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"大叶龙胆的水及醇浸出液有降低麻醉动物血压的作用。秦艽碱甲能降低豚鼠血压，对麻醉犬、兔亦具降压作用，但持续较短，且使心率减慢；阿托品及切断迷走神经不能阻断此种作用。此碱对离体蛙心亦表现抑制作用，因此降压作用可能即系心脏抑制所致。"}]},{"ID":"20240611143045-pmqxey0","Type":"NodeParagraph","Properties":{"id":"20240611143045-pmqxey0","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"④对血糖的影响"}]},{"ID":"20240611143045-p5r6iih","Type":"NodeParagraph","Properties":{"id":"20240611143045-p5r6iih","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"给大鼠腹腔注射秦艽碱甲150～250毫克/公斤，半小时后即可使血糖显著增高，维持约3小时。对小鼠亦有同样作用。同时肝糖元有显著降低；切除肾上脓或用阻断肾上腺素的药物（双苄氯乙胺）后，即失去此种作用，故升高血糖作用可能是通过肾上腺素的释放所致。"}]},{"ID":"20240611143045-971pgvg","Type":"NodeParagraph","Properties":{"id":"20240611143045-971pgvg","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑤抗菌作用"}]},{"ID":"20240611143045-l0ow77f","Type":"NodeParagraph","Properties":{"id":"20240611143045-l0ow77f","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"秦艽（品种未详）乙醇浸液在体外对炭疽杆菌、葡萄球菌、伤寒杆菌、肺炎杆菌、痢疾杆菌、霍乱弧菌均有抑制作用。其水浸剂（1：3）在试管内对某些常见皮肤真菌也有不同程度的抑制作用。"}]},{"ID":"20240611143045-xa48apc","Type":"NodeParagraph","Properties":{"id":"20240611143045-xa48apc","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611143045-i3lae78","Type":"NodeParagraph","Properties":{"id":"20240611143045-i3lae78","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦艽：拣去杂质，除去芦头，稍浸，润透切片，晒干。炒秦艽：取秦艽片入锅内，以文火炒至表面微有焦斑，取出放凉。"}]},{"ID":"20240611143045-7zvt2c1","Type":"NodeParagraph","Properties":{"id":"20240611143045-7zvt2c1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611143045-blyicrb","Type":"NodeParagraph","Properties":{"id":"20240611143045-blyicrb","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 入肝、胃、胆经。"}]},{"ID":"20240611143045-ys48mgv","Type":"NodeParagraph","Properties":{"id":"20240611143045-ys48mgv","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"手阳明经。\""}]},{"ID":"20240611143045-99pt7ot","Type":"NodeParagraph","Properties":{"id":"20240611143045-99pt7ot","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"入手太阳经。\""}]},{"ID":"20240611143045-1rhl9hf","Type":"NodeParagraph","Properties":{"id":"20240611143045-1rhl9hf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"手、足阳明经，兼入肝、胆。\""}]},{"ID":"20240611143045-m42zizf","Type":"NodeParagraph","Properties":{"id":"20240611143045-m42zizf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611143045-tlr528u","Type":"NodeParagraph","Properties":{"id":"20240611143045-tlr528u","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 苦辛，平。"}]},{"ID":"20240611143045-qu42dvs","Type":"NodeParagraph","Properties":{"id":"20240611143045-qu42dvs","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，平。\""}]},{"ID":"20240611143045-t33ynrm","Type":"NodeParagraph","Properties":{"id":"20240611143045-t33ynrm","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛，微温，无毒。\""}]},{"ID":"20240611143045-ej2oyh7","Type":"NodeParagraph","Properties":{"id":"20240611143045-ej2oyh7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611143045-sa8gia2","Type":"NodeParagraph","Properties":{"id":"20240611143045-sa8gia2","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 久痛虚羸，溲多、便滑者忌服。"}]},{"ID":"20240611143045-7golm1c","Type":"NodeParagraph","Properties":{"id":"20240611143045-7golm1c","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"菖蒲为之使。\""}]},{"ID":"20240611143045-87hsj24","Type":"NodeParagraph","Properties":{"id":"20240611143045-87hsj24","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"畏牛乳。\""}]},{"ID":"20240611143045-ypn3ra7","Type":"NodeParagraph","Properties":{"id":"20240611143045-ypn3ra7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"下部虚寒人，及小便不禁者勿服。\""}]},{"ID":"20240611143045-aoh51nk","Type":"NodeParagraph","Properties":{"id":"20240611143045-aoh51nk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》：\"凡病阴虚血燥，精竭髓衰之证，非配大剂滋养药不可。\""}]},{"ID":"20240611143045-9zel405","Type":"NodeParagraph","Properties":{"id":"20240611143045-9zel405","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑤《本草从新》：\"大便滑者忌用。\""}]},{"ID":"20240611143045-fl1d88s","Type":"NodeParagraph","Properties":{"id":"20240611143045-fl1d88s","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611143045-px5svdj","Type":"NodeParagraph","Properties":{"id":"20240611143045-px5svdj","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 祛风除湿，和血舒筋，清热利尿。治风湿痹痛，筋骨拘挛，黄疸，便血，骨蒸潮热，小儿疳热，小便不利。"}]},{"ID":"20240611143045-ikno3sh","Type":"NodeParagraph","Properties":{"id":"20240611143045-ikno3sh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热邪气，寒湿风痹，肢节痛，下水，利小便。\""}]},{"ID":"20240611143045-v1g8te6","Type":"NodeParagraph","Properties":{"id":"20240611143045-v1g8te6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗风，无问久新；通身挛急。\""}]},{"ID":"20240611143045-881abqh","Type":"NodeParagraph","Properties":{"id":"20240611143045-881abqh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"利大小便，瘥五种黄病，解酒毒，去头风。\""}]},{"ID":"20240611143045-7t7xyi3","Type":"NodeParagraph","Properties":{"id":"20240611143045-7t7xyi3","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"④《四声本草》：\"疗酒黄，黄疸。\""}]},{"ID":"20240611143045-44mqzsu","Type":"NodeParagraph","Properties":{"id":"20240611143045-44mqzsu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"主骨蒸，治疳及时气。\""}]},{"ID":"20240611143045-fncxtx6","Type":"NodeParagraph","Properties":{"id":"20240611143045-fncxtx6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"去阳明经风湿痹，仍治口疮毒。\""}]},{"ID":"20240611143045-th0e0a7","Type":"NodeParagraph","Properties":{"id":"20240611143045-th0e0a7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑦《医学启源》：\"治口噤，肠风泻血。《主治秘要》云，养血荣筋，中风手足不遂者用之。去手足阳明下牙痛，以去本经风湿。\""}]},{"ID":"20240611143045-wp978lf","Type":"NodeParagraph","Properties":{"id":"20240611143045-wp978lf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑧王好古：\"泄热，益胆气。\""}]},{"ID":"20240611143045-c32mpr4","Type":"NodeParagraph","Properties":{"id":"20240611143045-c32mpr4","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑨《纲目》：\"治胃热，虚劳发热。\""}]},{"ID":"20240611143045-25n13a5","Type":"NodeParagraph","Properties":{"id":"20240611143045-25n13a5","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑩《本草正》：\"解温疫热毒，骨蒸发热，潮热烦渴及妇人胎热，小儿疳热瘦弱。\""}]},{"ID":"20240611143045-x7iz0x9","Type":"NodeParagraph","Properties":{"id":"20240611143045-x7iz0x9","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611143045-9lg2soq","Type":"NodeParagraph","Properties":{"id":"20240611143045-9lg2soq","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；浸酒或入丸、散。外用：研末撒。"}]},{"ID":"20240611143045-9vb58d7","Type":"NodeParagraph","Properties":{"id":"20240611143045-9vb58d7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611143045-1r1ktag","Type":"NodeParagraph","Properties":{"id":"20240611143045-1r1ktag","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①治中风手足阳明经，口眼歪斜，恶风恶寒，四肢拘急：升麻、葛根、甘草（炙）、芍药、人参各半两，秦艽、白芷、防风、桂枝各三钱。上细切。每服一两，水二盏，连须葱白三茎，长二寸，煎至一盏，去滓，稍热服，食后。服药毕，避风寒处卧，得微汗出则止。（《卫生宝鉴》秦艽升麻汤）"}]},{"ID":"20240611143045-b7909dk","Type":"NodeParagraph","Properties":{"id":"20240611143045-b7909dk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②治背痛连胸：秦艽一钱五分，天麻、羌活、陈皮、当归、川芎各一钱，炙甘草五分，生姜三片，桑枝三钱（酒炒）。水煎服。（《医学心悟》秦艽天麻汤）"}]},{"ID":"20240611143045-5z94zz1","Type":"NodeParagraph","Properties":{"id":"20240611143045-5z94zz1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③治风中经络而痛：羌活一钱五分，当归二钱，川芎一钱，熟地三钱，秦艽、白芍（酒炒）、独活各一钱五分。（《不知医必要》秦艽汤）"}]},{"ID":"20240611143045-4rs7d8y","Type":"NodeParagraph","Properties":{"id":"20240611143045-4rs7d8y","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"④治黄：秦艽一大两。细锉，作两贴子，以上好酒一升，每贴半升，酒绞取汁，去滓。空腹分两服，或利便止。（《海上集验方》）"}]},{"ID":"20240611143045-kkyisi5","Type":"NodeParagraph","Properties":{"id":"20240611143045-kkyisi5","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑤治黄疸，皮肤眼睛如金黄色，小便赤：秦艽五两，牛乳三升。煮取一升，去滓。内芒硝一两服。（孙思邈）"}]},{"ID":"20240611143045-pid6fj3","Type":"NodeParagraph","Properties":{"id":"20240611143045-pid6fj3","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑥治虚劳潮热，咳嗽，盗汗不止：秦艽（去苗、土）、柴胡（去苗）、知母、甘草（锉、炙）各一两。上四味，粗捣筛。每服三钱匕，水一盏，煎至六分，去滓，温服，不计时候。（《圣济总录》秦艽汤）"}]},{"ID":"20240611143045-zzmk5l6","Type":"NodeParagraph","Properties":{"id":"20240611143045-zzmk5l6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑦治骨蒸壮热，肌肉消瘦，唇红，颊赤，气粗，四肢困倦，夜有盗汗：柴胡、鳖甲（去裙，酥炙，用九肋者）、地骨皮各一两，秦艽、当归、知母各五钱。上六味，为粗末。每服五钱，水一盏，青蒿五叶，乌梅一个，煎至七分，去滓温服，空心、临卧，各一服。（《卫生宝鉴》秦艽鳖甲散）"}]},{"ID":"20240611143045-19eekr7","Type":"NodeParagraph","Properties":{"id":"20240611143045-19eekr7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑧治消渴，除烦躁：秦艽二两（去苗），甘草三分（炙微赤，锉）。上件药，捣筛为散。每服四钱，以水一中盏，入生姜半分，煎至六分，去滓，不计时候温服。（《圣惠方》）"}]},{"ID":"20240611143045-zxlzipm","Type":"NodeParagraph","Properties":{"id":"20240611143045-zxlzipm","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑨治小便艰难，胀满闷：秦艽一两（去苗）。以水一大盏，煎取七分，去滓，食前分作二服。（《圣惠方》）"}]},{"ID":"20240611143045-wygcmwn","Type":"NodeParagraph","Properties":{"id":"20240611143045-wygcmwn","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑩治疮口不合：秦艽为末掺之。（《仁斋直指方》）"}]},{"ID":"20240611143045-nezvltj","Type":"NodeParagraph","Properties":{"id":"20240611143045-nezvltj","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑾治发背疑似者：秦艽，牛乳煎，当得快利三、五行。（《海上集验方》）"}]},{"ID":"20240611143045-3chtybf","Type":"NodeParagraph","Properties":{"id":"20240611143045-3chtybf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑿黄疸。用秦艽半两，浸酒半升中，空腹饮酒。有酒量的人服后易见效。又方：秦艽三两，牛乳一升，煮成七合，作两次服下。"}]},{"ID":"20240611143045-h8p0jnx","Type":"NodeParagraph","Properties":{"id":"20240611143045-h8p0jnx","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑿暴泻、大渴、大饮。用秦艽二两、灸甘草半两，每服三钱，水煎服。"}]},{"ID":"20240611143045-u34v6cs","Type":"NodeParagraph","Properties":{"id":"20240611143045-u34v6cs","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⒀伤寒烦渴。用秦艽一两，在牛乳一碗中煎到六成，作两次服。"}]},{"ID":"20240611143045-l6e283j","Type":"NodeParagraph","Properties":{"id":"20240611143045-l6e283j","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⒁急劳烦热（身体酸疼，骨蒸潮热）。用秦艽、柴胡各一两，甘草五钱，研细。每服三钱，开水调下。"}]},{"ID":"20240611143045-4hvqpf1","Type":"NodeParagraph","Properties":{"id":"20240611143045-4hvqpf1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⒂小儿骨蒸潮热，减食瘦弱。用秦艽、灸甘草各一两，每服一至二钱，水煎服。"}]},{"ID":"20240611143045-b6cdina","Type":"NodeParagraph","Properties":{"id":"20240611143045-b6cdina","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⒃小便艰难。用秦艽一两，水一碗，煎至六分，分两次服。又方：秦艽、冬葵子，等分为末，每服一小匙，酒送下。"}]},{"ID":"20240611143045-hsb4ewq","Type":"NodeParagraph","Properties":{"id":"20240611143045-hsb4ewq","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⒄胎动不安。用秦艽、灸甘草、炒鹿角胶各半两，共研为末，每服三钱，又水一大碗、糯米五十粒煎服。又方：秦艽、阿胶（炒）、艾叶，等分为末，每服三钱，以水一大碗、糯米五十粒煎服。"}]},{"ID":"20240611143045-uoo2h88","Type":"NodeParagraph","Properties":{"id":"20240611143045-uoo2h88","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⒅一切疮口不合。用秦艽研末敷上。"}]},{"ID":"20240611143045-zooap44","Type":"NodeParagraph","Properties":{"id":"20240611143045-zooap44","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611143045-hj9dh9d","Type":"NodeParagraph","Properties":{"id":"20240611143045-hj9dh9d","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①治疗关节痛、头痛、牙痛等"}]},{"ID":"20240611143045-mw9zfxz","Type":"NodeParagraph","Properties":{"id":"20240611143045-mw9zfxz","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"取秦艽100克，或秦艽、白芷各50克，加入普鲁卡因1克，制成注射液100毫升，分装、灭菌备用。肌肉注射每次2毫升。曾应用2000多人次，对风寒引起的周身疼痛，以及多年风湿性腰腿痛均有止痛效果。"}]},{"ID":"20240611143045-zvf58fi","Type":"NodeParagraph","Properties":{"id":"20240611143045-zvf58fi","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②治疗流行性脑脊髓膜炎"}]},{"ID":"20240611143045-47kgwvy","Type":"NodeParagraph","Properties":{"id":"20240611143045-47kgwvy","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"将秦艽制成注射液，每毫升约含生药0.625克，每次2～5毫升，每日4～6次，肌肉注射。试治21例，经用药3～7天均获痊愈，无1例发生后遗症。"}]},{"ID":"20240611143045-8wnct1s","Type":"NodeParagraph","Properties":{"id":"20240611143045-8wnct1s","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"此外，以秦艽为主，结合辨证施治加用其他药物，治疗小儿急性黄疸型传染性肝炎20例，获得较好疗效。"}]},{"ID":"20240611143045-6iqyvsu","Type":"NodeParagraph","Properties":{"id":"20240611143045-6iqyvsu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611143045-701bcch","Type":"NodeParagraph","Properties":{"id":"20240611143045-701bcch","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"秦艽，手足不遂，黄疸，烦渴之病须之，取其去阳明之湿热也。阳明有湿，则身体酸疼烦热，有热则日哺潮热骨蒸。\""}]},{"ID":"20240611143045-3a1lx9g","Type":"NodeParagraph","Properties":{"id":"20240611143045-3a1lx9g","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"秦艽，苦能泄，辛能散，微温能通利，故主寒热邪气，寒湿风痹，肢节痛，下水，利小便。性能祛风除湿，故《别录》疗风无问久新，及通身挛急。能燥湿散热结，故《日华子》治骨蒸及疳热；甄权治酒疸解酒毒；元素除阳明风湿，及手足不遂，肠风泻血，养血荣筋；好古泄热，益胆气。咸以其除湿散结，清肠胃之功也。\""}]},{"ID":"20240611143045-wqzrtcu","Type":"NodeParagraph","Properties":{"id":"20240611143045-wqzrtcu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"③《本草征要》：\"秦艽，长于养血，故能退热舒筋。治风先治血，血行风自灭，故疗风无问新久。入胃祛湿热，故小便利而黄疸愈也。\""}]},{"ID":"20240611143045-oej0i9t","Type":"NodeParagraph","Properties":{"id":"20240611143045-oej0i9t","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"秦艽，入手足阳明，以其去湿也；兼入肝胆，以其治风也。故手足不遂，黄瘅酒毒，及妇人带疾须之。……凡痛有寒热，或浮肿者，多挟客邪，用此以祛风利湿，方为合剂。故《本经》治寒热邪气，寒湿风痹，肢体痛等证。若久痛虚羸，血气不能营养肢体而痛，及下体虚寒，疼酸枯瘦等病，而小便清利者，咸非秦艽所宜。\""}]},{"ID":"20240611143045-9yg2wla","Type":"NodeParagraph","Properties":{"id":"20240611143045-9yg2wla","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"秦艽，《本经》谓之苦平，而《别录》加以辛及微温，以其主治风寒湿痹，必有温通性质也，然其味本苦，其功用亦治风热，而能通利二便，已非温药本色。后人且以治胃热黄疸烦渴等症，其非温性，更是彰明较著。考《本经》、《别录》主治，功在舒筋通络，流利骨节，惟治痹痛挛急之证，盖与防风、羌、独同类之品。甄权之治头风，即祛风也；惟又称其利大小便，亦与《本经》下水利小便之旨相合。盖秦艽既能外行于关节，亦能内达于下焦，故宣通诸府，引导湿热，直走二阴而出，昔人每谓秦艽为风家润药，其意指此。因之而并及肠风下血，张石顽且谓其治带，皆以湿热有余，泄积滞言之，非统治诸虚不振之下血带下也。又就其导湿去热而引伸之，则治胃热，泄内热，而黄疸酒毒，牙痛口疮，温疫热毒，及妇人怀胎蕴热，小儿疳热烦渴等症，皆胃家湿热，而秦艽又能逋治之矣。约而言之，外通经隧，内导二便，是其真宰，而通络之功，又在理湿之上。要之皆是从湿阻热结一面着想，而气虚血弱之症，皆非其治，仍与防风、羌、独等味异曲同工耳。\""}]},{"ID":"20240611143045-bey9ifp","Type":"NodeParagraph","Properties":{"id":"20240611143045-bey9ifp","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611143045-y5vo56m","Type":"NodeParagraph","Properties":{"id":"20240611143045-y5vo56m","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" （1）祛风湿：用于全身性风湿痛，常配羌活、防风。"}]},{"ID":"20240611143045-ti4t440","Type":"NodeParagraph","Properties":{"id":"20240611143045-ti4t440","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"（2）退虚热：用于阴虚发热，常配鳖甲、地骨皮。"}]},{"ID":"20240611143045-9gslw94","Type":"NodeParagraph","Properties":{"id":"20240611143045-9gslw94","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"1、用于风湿痹痛、周身或关节拘挛，及手足不遂等。秦艽能祛风湿，舒筋络。风湿痹证无问新久、或偏寒偏热，均可配伍应用。本品性微寒，兼能清热，痹证见发热、关节红肿等热象者尤为适宜。一般偏热者，可配防已、知母、忍冬藤等；属寒者，配羌、独活、桂枝、附子等。对于中风手足不遂者，亦适用本品。"}]},{"ID":"20240611143045-klcvenp","Type":"NodeParagraph","Properties":{"id":"20240611143045-klcvenp","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2、用于骨蒸潮热。本品清虚热，为治疗阴骨蒸潮热的常用药。可与青蒿、鳖甲、知母、地骨皮等配伍，如秦艽鳖甲散。此外，本品尚能利湿退黄。治疗湿热黄疸，可与茵陈、栀子等配伍。"}]},{"ID":"20240611143045-o0twh9q","Type":"NodeParagraph","Properties":{"id":"20240611143045-o0twh9q","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611143045-tkuu6f0","Type":"NodeParagraph","Properties":{"id":"20240611143045-tkuu6f0","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611143045-roayg6j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143045-roayg6j","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"《中华本草》：秦艽"}]},{"ID":"20240611143045-mi29q50","Type":"NodeParagraph","Properties":{"id":"20240611143045-mi29q50","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611143045-qoslyyv","Type":"NodeParagraph","Properties":{"id":"20240611143045-qoslyyv","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" Qín Jiāo"}]},{"ID":"20240611143045-o3ewior","Type":"NodeParagraph","Properties":{"id":"20240611143045-o3ewior","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611143045-3kv4suh","Type":"NodeParagraph","Properties":{"id":"20240611143045-3kv4suh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦胶、秦札、秦纠、秦爪、左秦艽、大艽、左宁根、左扭、西大艽、西秦艽、萝卜艽、瓣子艽、鸡腿艽、山大艽、曲双"}]},{"ID":"20240611143045-07em7yj","Type":"NodeParagraph","Properties":{"id":"20240611143045-07em7yj","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611143045-h1n31t1","Type":"NodeParagraph","Properties":{"id":"20240611143045-h1n31t1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240611143045-q0nbj99","Type":"NodeParagraph","Properties":{"id":"20240611143045-q0nbj99","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611143045-0ee7ylk","Type":"NodeParagraph","Properties":{"id":"20240611143045-0ee7ylk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 药材基源：为龙胆科植物秦艽、粗茎秦艽、麻花艽、达乌里秦艽的根。"}]},{"ID":"20240611143045-0exsrae","Type":"NodeParagraph","Properties":{"id":"20240611143045-0exsrae","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Gentiana macrophylla Pall.2．Gentiana crassicaulis Duthie ex Burk．3．Gentiana straminea Maxim.4．Gentiana dahurica Fisch."}]},{"ID":"20240611143045-i4g4gpv","Type":"NodeParagraph","Properties":{"id":"20240611143045-i4g4gpv","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"采收和储藏：播种后3～5年采收。春、秋季均可采挖，但以秋季质量较好。挖出后去掉茎叶，晒至柔软时，堆成堆，使自然发热，至根内部变成肉红色时，晒干。也可在挖根后，直接晒干。达乌里秦艽挖根后，洗去泥沙，搓去黑皮，晒干。"}]},{"ID":"20240611143045-gd2pm8c","Type":"NodeParagraph","Properties":{"id":"20240611143045-gd2pm8c","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611143045-kz2h5rr","Type":"NodeParagraph","Properties":{"id":"20240611143045-kz2h5rr","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔400-2400m的山区草地、溪旁两侧、路边坡地、灌丛中。"}]},{"ID":"20240611143045-zld8qmb","Type":"NodeParagraph","Properties":{"id":"20240611143045-zld8qmb","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.生于海拔2100-4500m的高山草甸、山坡草地、灌丛及林缘。"}]},{"ID":"20240611143045-mjqhtni","Type":"NodeParagraph","Properties":{"id":"20240611143045-mjqhtni","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3.生于海拔2000-5000m的高山、草地和溪边。"}]},{"ID":"20240611143045-g8rguqk","Type":"NodeParagraph","Properties":{"id":"20240611143045-g8rguqk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4.生于海拔800-4500m的田埂、路旁、河滩沙地、向阳山坡及干草原等地。"}]},{"ID":"20240611143045-yvw57ov","Type":"NodeParagraph","Properties":{"id":"20240611143045-yvw57ov","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华北、西北及四川。"}]},{"ID":"20240611143045-26hrwlf","Type":"NodeParagraph","Properties":{"id":"20240611143045-26hrwlf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.分布于甘肃、青海、四川、贵州、云南、西藏。"}]},{"ID":"20240611143045-is4m6dh","Type":"NodeParagraph","Properties":{"id":"20240611143045-is4m6dh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3.分布于宁夏、甘肃、青海、湖北、四川、西藏。"}]},{"ID":"20240611143045-jwqkidq","Type":"NodeParagraph","Properties":{"id":"20240611143045-jwqkidq","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4.分布于东北、华北、西北及四川等地。"}]},{"ID":"20240611143045-a31wa3k","Type":"NodeParagraph","Properties":{"id":"20240611143045-a31wa3k","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611143045-w37710a","Type":"NodeParagraph","Properties":{"id":"20240611143045-w37710a","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 1.多年生草本，高20-60cm。主根粗长，圆柱形，上租下细，扭曲不直，有少数分枝，中部多呈罗纹状；根茎部有许多纤维状残存叶基。茎直立或斜生，圆柱形，无毛。基生叶多丛生，无柄，叶片披针形或长圆披针形，长达40cm，宽3-5cm，先端尖，全缘，主脉5条；茎生叶3-4对，对生，较小，基部连合。花多集成顶生及茎上部腋生的轮伞花序；花萼管一侧裂开过半，萼齿浅；花冠管状，深蓝紫色，长约2cm，先端5裂，裂片间有5片短小褶片；雄蕊5，着生于花冠管中部；子房长圆形，无柄。蒴果长圆形或椭圆形。种子椭圆形，无翅，褐色，有光泽。花期7-9月，果期8-10月。"}]},{"ID":"20240611143045-t89n09t","Type":"NodeParagraph","Properties":{"id":"20240611143045-t89n09t","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.多年生草本，高20-40cm。茎根粗大，大部或全部分裂为小根，相互缠绕呈右旋扭结一起。根茎部有许多纤维状残存叶基，茎直立或斜上，圆柱形，无毛。基生叶多丛生，叶片较大，窄椭圆形或椭圆状披针形，长达40cm，宽4-5cm，先端稍尖，全缘，主脉5条纵贯叶片；茎生叶对生，较小。花茎粗壮而短，稍倾斜，花多数，无花梗，在茎顶簇生呈头状，稀腋生作轮状；花萼管仅于顶端一侧开裂，萼齿极浅或无；花管壶状，长2-2.2cm，黄色或蓝紫色，长约3cm，裂片先端微尖，内部有斑点；雄蕊5；子房长圆形，有柄。蒴果内藏，长圆形，无柄。花期6-9月，果期9-10月。"}]},{"ID":"20240611143045-81nvdzu","Type":"NodeParagraph","Properties":{"id":"20240611143045-81nvdzu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3.多年生草本，高10-20cm。主根粗壮，圆锥形。基生叶多丛生，无柄，叶片较大，披针形，先端尖，全缘，主脉5条，叶背面的主脉宽阔，隆起；茎生叶对生，较小。花较少成聚伞花序，有长梗；花萼筒黄绿色，膜质，一侧开裂，萼齿2-5，等长；花冠管状，黄色，漏斗形，喉部具多数绿色斑点，先端5裂，裂片卵圆形；雄蕊5，着生于花冠管中下部；子房上位，1室，有2个侧膜胎座。蒴果，开裂为2个果瓣，椭圆状披针形，柄长7-12mm。种子褐色，有光泽，狭长圆形。花期7-9月，果期8-10月。"}]},{"ID":"20240611143045-m2dvhry","Type":"NodeParagraph","Properties":{"id":"20240611143045-m2dvhry","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4.多年生草本，高10-25cm。根单一或稍分枝，向左扭转,细长圆柱形，直径不及1cm。基生叶丛生，基部有许多纤维状残存叶基；叶片长窄披针形，无柄；茎生叶较小，对生，无柄，线状披针形至线形，长2-5cm，宽2-4mm，全缘。花常较多或1-3朵，顶生，成轮伞花序；花萼管部通常不开裂，稀一侧浅裂；裂片5，不整齐，线形，先端渐尖；花冠深蓝色；雄蕊5，花丝线状钻形；子房长圆形，无柄，花柱线形，柱头2裂。蒴果椭圆形，与花冠几等长。种子淡褐色，有光泽。花期7-8月。果期9-10月。"}]},{"ID":"20240611143045-ioqyr02","Type":"NodeParagraph","Properties":{"id":"20240611143045-ioqyr02","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611143045-zmjf7d4","Type":"NodeParagraph","Properties":{"id":"20240611143045-zmjf7d4","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽、湿润气候，耐寒。宜土层深厚、肥沃、富含腐殖质的壤土栽培。"}]},{"ID":"20240611143045-zeqjqux","Type":"NodeParagraph","Properties":{"id":"20240611143045-zeqjqux","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。选生长3年以上的老株采种，晾干。早春撒播或条播，播幅3cm，深1cm，沟距25cm，每1hm2用种7．5～10．5kg。"}]},{"ID":"20240611143045-hx9mq7n","Type":"NodeParagraph","Properties":{"id":"20240611143045-hx9mq7n","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"田间管理 长出2～3片真叶时，匀苗，每隔10cm留壮苗1株，随即施肥1次。以后，每年春季出苗时及6月份各中耕除草、施肥1次。"}]},{"ID":"20240611143045-qhsybq8","Type":"NodeParagraph","Properties":{"id":"20240611143045-qhsybq8","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有叶斑病，可用代森锌或波尔多液防治。"}]},{"ID":"20240611143045-wc9sdxo","Type":"NodeParagraph","Properties":{"id":"20240611143045-wc9sdxo","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611143045-nseiamp","Type":"NodeParagraph","Properties":{"id":"20240611143045-nseiamp","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 1．秦艽 根略呈圆锥形，上粗下细，长7-30cm，直径1-3cm。表面灰黄色或棕黄色，有纵向或扭曲的纵沟。根头部常膨大，多由数个根茎合着，残存的茎基上有短纤维状叶基维管束，质坚脆，易折断，断面皮部黄色或棕黄色，木部黄色。气特殊，味苦而涩。"}]},{"ID":"20240611143045-za52suu","Type":"NodeParagraph","Properties":{"id":"20240611143045-za52suu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2．粗茎秦艽 根略呈圆柱形，较粗大，多不分枝，很少互相扭绕，长12-20cm，直径1-3．5cm。表面黄棕色或暗棕色，有纵向扭转的皱纹；根头有淡黄色叶柄残基及纤维状的叶基维管束。味苦、涩。"}]},{"ID":"20240611143045-ix6ehsd","Type":"NodeParagraph","Properties":{"id":"20240611143045-ix6ehsd","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3．麻花艽 根略呈圆锥形，长8-18cm，直径1-3cm；主根下部多分枝或多数相互分离后又连合，略成网状或麻花状，故习称麻花艽。质松脆，易折断，断面多呈枯朽状。"}]},{"ID":"20240611143045-km373k4","Type":"NodeParagraph","Properties":{"id":"20240611143045-km373k4","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4．达乌里秦艽 根略呈长纺锤形或圆柱形，长8-20cm，直径2-9mm。表面棕黄色或棕褐色，有纵向或扭曲的沟纹，已去外皮者表面黄色。根头较细，单一，偶有二分叉，表面有横向纹理，顶端残存茎基及短纤维状叶鞘。主根通常1个或分成数枝。质松脆，易折断，断面黄白色。气微，味苦、涩。"}]},{"ID":"20240611143045-letpmhu","Type":"NodeParagraph","Properties":{"id":"20240611143045-letpmhu","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"以质实、色棕黄、气味浓厚者为佳。"}]},{"ID":"20240611143045-yz5tmph","Type":"NodeParagraph","Properties":{"id":"20240611143045-yz5tmph","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：（1）秦艽 粉末黄棕色。①栓化细胞表面观类多角形、类长方形或不规则形，直径20-166μm，长至198μm，壁薄，略弯曲，平周壁有横向微细纹理，胞腔内含油滴状物，每个细胞不规则分割成2-12个小细胞，分隔壁隐约可见，稍不均匀增厚。②草酸钙针晶散在于薄壁细胞中，长9-17μm。另有少数结晶呈细梭状、颗粒状、杆状或片状。③内皮层细胞（根须）巨大，无色或淡黄色。完整者表面观类长方形或扁方形，长（纵向）85-542μm，直径（横向）18-153μm，壁薄，侧壁细波状弯曲，端壁较平直，平周壁现纤细的横向线状纹理，每个大细胞纵隔成2-10个栅状小细胞，小细胞又横隔为2-5个，有的分隔不明显。④螺纹及网纹导管，直径8-67μm。"}]},{"ID":"20240611143045-ayc1u8p","Type":"NodeParagraph","Properties":{"id":"20240611143045-ayc1u8p","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"（2）麻花艽 粉末棕褐色。①厚壁网纹细胞梭形、类三角形或长条形，末端稍大、钝圆或平截，有的一端呈侧钩状，直径20-65μm，长20-240μm，壁稍厚，木化，网孔长裂缝状，疏密不一，大多纵向，也有斜向或稍扭曲。②草酸钙针晶细小，散在于薄壁细胞中，长3-7μm。③栓化细胞表面观长梭形、类方形、类长方形，直径18-81μm，长至198μm，壁薄，每个细胞横隔成2-8个小细胞。有的细胞纵隔成2个小细胞，小细胞再横隔为2-5个。④内皮层细胞（根须）淡黄绿色或几无色，长条形，两端平截或稍倾斜，直径11-20μm，长约至198μm，壁三边增厚，一边薄，厚约至7μm，孔沟较稀疏。"}]},{"ID":"20240611143045-lkwqds0","Type":"NodeParagraph","Properties":{"id":"20240611143045-lkwqds0","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"（3）达乌里秦艽 粉末黄棕色。①厚壁网纹细胞数个毗连或单个散在，常与栓化细胞上下连结，淡黄色或淡绿黄色，呈类梭形、类三角形、类长方形，直径20-66μm，长64-216μm，壁螺状或网状增厚，木化，有的螺状增厚，壁斜向交错扭结，网孔呈纵或斜裂缝状、不规则的类长圆形、细小椭圆形，或纹孔偶见。"}]},{"ID":"20240611143045-psy6pge","Type":"NodeParagraph","Properties":{"id":"20240611143045-psy6pge","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"②草酸钙结晶微小，针状或杆状，长约至10μm，也有呈微细粒状。③栓化细胞表面观呈类梭形或长方形，直径20-63μm，长至180μm，壁薄，略弯曲，每个细胞横隔成2-8个小细胞。有的细胞纵隔成2个小细胞，小细胞再横隔为2-4个。④内皮层细胞（根须）淡黄绿色或几无色，呈长条形，两端平截或稍倾斜，直径11-25μm，长约至315μm，壁三边增厚，一边薄，厚约至11μm，孔沟外口呈疣状突起，表面观呈细小双圈状。有的横隔成2个小细胞。"}]},{"ID":"20240611143045-fy8rrat","Type":"NodeParagraph","Properties":{"id":"20240611143045-fy8rrat","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粗粉2g，加氯仿-甲醇-浓氨试液（7：25：5）混合液30ml，浸泡2h，滤过。滤液置水浴上浓缩至约1ml，加1mol/L盐酸液2ml，继续蒸去氯仿，放冷，滤过。取滤液分置2支试管中，一管加碘化汞钾试液，即生成淡黄白色沉淀；另一管加碘化铋钾试液，即生成棕红色沉淀。（检查生物碱）（2）取本品横切面，置紫外光灯（365nm）下观察，显黄白色或金黄色荧光。"}]},{"ID":"20240611143045-9bspbyj","Type":"NodeParagraph","Properties":{"id":"20240611143045-9bspbyj","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"商品规格（1）秦艽 主根粗大似鸡腿、萝卜、牛尾状。质坚脆。断面棕红色或棕黄色，中心土黄色。一等：表面灰黄色或棕色，芦下直径1．2cm以上。二等：表面灰黄色或黄棕色，芦下直径0．6-1.2cm。"}]},{"ID":"20240611143045-f8kdvbn","Type":"NodeParagraph","Properties":{"id":"20240611143045-f8kdvbn","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"（2）麻花艽 统货。大小不分，芦下直径不小于0．3cm。"}]},{"ID":"20240611143045-3htvxcq","Type":"NodeParagraph","Properties":{"id":"20240611143045-3htvxcq","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"（3）达马里秦艽 一等：条长20cm以下，芦下直径1cm以上。二等：长短大小不分，芦下直径0．3cm以上。"}]},{"ID":"20240611143045-sk942qf","Type":"NodeParagraph","Properties":{"id":"20240611143045-sk942qf","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611143045-b9h3xhe","Type":"NodeParagraph","Properties":{"id":"20240611143045-b9h3xhe","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦艽碱甲对小鼠的半数致死量为：口服480mg/kg；腹腔注射350mg/kg；静脉注射250-300mg/kg。4例风湿性关节炎病人口服lO0mg，每天3次，共4-13天，先后引起严重恶心、呕吐等；仅连服13日之l例，关节红肿、疼痛于第5日消失，余均无效，故认为此碱在初步临床应用中尚不够理想，且多副作用，尚待进一步改进。"}]},{"ID":"20240611143045-e6ufy91","Type":"NodeParagraph","Properties":{"id":"20240611143045-e6ufy91","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"秦艽碱甲对小鼠的半数致死量为：口服480mg/kg，腹腔注射350mg/kg 静脉注射250-300mg/kg。亚急性毒性试验：分别以50，90，1200mg/kg的剂量给大鼠腹腔注射，每日1次连续14天，各组动物外观无改变，病理切片发现肾小球及肾小管内均有蛋白出现，部分动物有肺水肿现象胜。龙胆碱对小鼠的半数致死量，灌胃为480mg/kg，腹腔注射为350mg/kg。"}]},{"ID":"20240611143045-n6w2ul6","Type":"NodeParagraph","Properties":{"id":"20240611143045-n6w2ul6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611143045-2aww42b","Type":"NodeParagraph","Properties":{"id":"20240611143045-2aww42b","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 1．秦艽 根含秦艽碱甲即是龙胆碱（gentian－ine）[1]，秦艽碱乙即是龙胆次碱（gentianidine）[2]，秦艽碱丙（gentianal）[3]，龙胆苦甙（gentiopicroside）[4]，当药苦甙（swertia－marin）[5]。另有报道，秦艽根主含龙胆苦甙，在提取分离时，龙胆苦甙与氨水作用转化为龙胆碱和秦艽碱丙等生物碱[4，6]。近有报道，秦艽根含龙胆苦甙，褐煤酸（montanic acid），褐煤酸甲酯（methyl montanate），栎瘿酸（roburic acid），α-香树脂醇（α-amyrin）,β-谷甾醇（β-sitosterol）,β-谷甾醇-β-D-葡萄糖甙（β-sitos-terol-β-D-glucoside）［7］。"}]},{"ID":"20240611143045-pf0lm6t","Type":"NodeParagraph","Properties":{"id":"20240611143045-pf0lm6t","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2．粗茎秦艽 根含龙胆苦甙，当药甙（sweroside），当药苦甙[5]，龙胆碱，秦艽碱丙[8]。"}]},{"ID":"20240611143045-vk1sxki","Type":"NodeParagraph","Properties":{"id":"20240611143045-vk1sxki","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3．麻花艽 根含龙胆苦甙，当药甙，当药苦甙[5]，龙胆碱，秦艽碱丙[8]。"}]},{"ID":"20240611143045-zur7xl8","Type":"NodeParagraph","Properties":{"id":"20240611143045-zur7xl8","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4．达乌里秦艽 根含龙胆苦甙[4，5]，当药苦甙［5］，龙胆碱，秦艽碱丙[8]。"}]},{"ID":"20240611143045-xygmvd1","Type":"NodeParagraph","Properties":{"id":"20240611143045-xygmvd1","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"此外，天山秦艽根含龙胆碱[9]；西藏秦艽根含龙胆碱。欧龙胆碱（gentialutine），异欧龙胆碱（isogentialutine），西藏龙胆碱（gentiatibetine）[10-13]；管花秦艽根含龙胆碱，秦艽碱丙[8]。"}]},{"ID":"20240611143045-r7954i6","Type":"NodeParagraph","Properties":{"id":"20240611143045-r7954i6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611143045-jkxq3wq","Type":"NodeParagraph","Properties":{"id":"20240611143045-jkxq3wq","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 1.抗炎作用 秦艽碱甲能减轻大鼠的甲醛性关节炎，并加速肿胀的消退，每日腹腔注射90mg/kg，连续 10天可使脚肿基本恢复正常，其效果与水杨酸钠200mg/kg相当，如预先注射秦艽碱甲，对大鼠蛋清性脚肿也有减轻和消肿作用，其作用强度与氯喹、皮质酮及秦艽中性乙醇浸剂相似，而比水杨酸钠略强，秦艽碱甲的抗炎作用原理是通过兴奋肾上腺皮质而实现的，但它与促皮质素又有所不同，它不是直接兴奋肾上腺皮质，而是通过神经系统以激动垂体，促使肾上腺皮质激素分泌增加而实现其抗炎作用。值得注意的是，秦艽碱甲的双氢化合物(侧链上的双键被氢饱和)无消炎作用，可知双键的存在是抗炎的必要条件。此外，秦艽碱甲还能明显降低因注射蛋清而引起的毛细血管通透性的增高。"}]},{"ID":"20240611143045-am8g3fa","Type":"NodeParagraph","Properties":{"id":"20240611143045-am8g3fa","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.对中枢系统的作用 秦艽碱甲小剂量时对大鼠和小鼠有镇静作用，还能增强戊巴比妥钠的催眠作用，但较大剂量时则有中枢兴奋作用，最后导致麻痹而死亡。较小剂量注射给药时，能抑制狗肠痿因灌注氯化亚汞所引起的反射性肠液分泌，即抑制了狗的神经系统，这种抑制作用随着剂量的增大而加强。光热刺激法实验表明，秦艽碱甲能提高大鼠的痛阈，但作用短暂，40分钟后作用消失。用热板法实验，秦艽碱甲对小鼠有镇痛作用。"}]},{"ID":"20240611143045-mr7paa2","Type":"NodeParagraph","Properties":{"id":"20240611143045-mr7paa2","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的作用 秦艽碱甲能降低豚鼠血压，对麻醉犬、兔也有明显而矩暂的降低血压作用，时时使心率减慢，无快速耐受现象。静脉注射阿托品和切断两侧迷走神经均不能阻断其降低作用，加之对离体蛙心有抑制作用，减慢心率并伴有心舒张不全和心输出量减少，证明其降压作用与迷走神经无关，可能是直接抑制心脏的结果。"}]},{"ID":"20240611143045-tic2z06","Type":"NodeParagraph","Properties":{"id":"20240611143045-tic2z06","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4.对血糖的影响 秦艽碱甲对大鼠和小鼠均有升高血糖的作用。在升高血糖的同时，肝糖原明显降低。其作用随剂量加大而增强。由于切除肾上腺或使用阻断肾上腺素的药物(双苯氯乙胺)后，此种作用消失，故升高血糖作用的原理是是通过肾上腺的释放所致。"}]},{"ID":"20240611143045-6fi6w6b","Type":"NodeParagraph","Properties":{"id":"20240611143045-6fi6w6b","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"5.抗过敏性休克和抗组胺作用 秦艽碱甲能明显减轻豚鼠因组胺喷雾引起的哮喘及抽搐，对于兔的蛋清性过敏性休克也有显着的保护作用，还能明显降低大鼠的毛细血管通透性。"}]},{"ID":"20240611143045-f4dw0xm","Type":"NodeParagraph","Properties":{"id":"20240611143045-f4dw0xm","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"6.对平滑肌的作用 秦艽碱甲对麻醉犬回肠运动无明显影响，对离体豚鼠回肠运动也无任何影响，但能拮抗组胺和乙酰胆碱引起的肠管收缩，1：5，000几乎能完全拮抗组胺的作用，对乙酰胆碱的拮抗作用相对较弱。"}]},{"ID":"20240611143045-k2c9m8p","Type":"NodeParagraph","Properties":{"id":"20240611143045-k2c9m8p","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"7.其它作用 龙胆苦甙对疟原虫有抑杀作用。犬人工胃痿试验证明龙胆苦甙能促进胃液及游离盐酸分泌增加。"}]},{"ID":"20240611143045-oyy04an","Type":"NodeParagraph","Properties":{"id":"20240611143045-oyy04an","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611143045-230dvr6","Type":"NodeParagraph","Properties":{"id":"20240611143045-230dvr6","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 秦艽：拣去杂质，除去芦头，稍浸，润透切片，晒干。炒秦艽：取秦艽片入锅内，以文火炒至表面微有焦斑，取出放凉。"}]},{"ID":"20240611143045-6brpqll","Type":"NodeParagraph","Properties":{"id":"20240611143045-6brpqll","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611143045-4ll4j2y","Type":"NodeParagraph","Properties":{"id":"20240611143045-4ll4j2y","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 胃；肝；胆经"}]},{"ID":"20240611143045-2qr9nk3","Type":"NodeParagraph","Properties":{"id":"20240611143045-2qr9nk3","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611143045-hob57vb","Type":"NodeParagraph","Properties":{"id":"20240611143045-hob57vb","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 苦；辛；微寒"}]},{"ID":"20240611143045-vph1odh","Type":"NodeParagraph","Properties":{"id":"20240611143045-vph1odh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611143045-5y7t5dh","Type":"NodeParagraph","Properties":{"id":"20240611143045-5y7t5dh","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 久痛虚羸，溲多、便滑者忌服。"}]},{"ID":"20240611143045-cvh8wab","Type":"NodeParagraph","Properties":{"id":"20240611143045-cvh8wab","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：下部虚寒人，及小便不禁者勿服。"}]},{"ID":"20240611143045-2yz5zcq","Type":"NodeParagraph","Properties":{"id":"20240611143045-2yz5zcq","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：凡病阴虚血燥，精竭髓衰之证，非配大剂滋养药不可。"}]},{"ID":"20240611143045-45j8ho7","Type":"NodeParagraph","Properties":{"id":"20240611143045-45j8ho7","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：大便滑者忌用。"}]},{"ID":"20240611143045-9ktg5qg","Type":"NodeParagraph","Properties":{"id":"20240611143045-9ktg5qg","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611143045-yp3ymgc","Type":"NodeParagraph","Properties":{"id":"20240611143045-yp3ymgc","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 祛风湿；舒筋络；清虚热；利湿退黄。主风湿痹通痛；筋骨拘挛；手足不遂；骨蒸潮热；小儿疳热；湿热黄疸"}]},{"ID":"20240611143045-hie7nel","Type":"NodeParagraph","Properties":{"id":"20240611143045-hie7nel","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611143045-5hocayx","Type":"NodeParagraph","Properties":{"id":"20240611143045-5hocayx","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g；或浸酒；或入丸、散。外用：适量，研末撒。"}]},{"ID":"20240611143045-2q0g0al","Type":"NodeParagraph","Properties":{"id":"20240611143045-2q0g0al","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611143045-rhv8e64","Type":"NodeParagraph","Properties":{"id":"20240611143045-rhv8e64","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" ①治中风手足阳明经，口眼喎斜，恶风恶寒，四肢拘急：升麻、葛根、甘草(炙)、芍药、人参各半两，秦艽、白芷、防风、桂枝各三钱。上细切。每服一两，水二盏，连须葱白三茎，长二寸，煎至一盏，去滓，稍热服，食后。服药毕，避风寒处卧，得微汗出则止。(《卫生宝鉴》秦艽升麻汤)②治背痛连胸：秦艽一钱五分，天麻、羌活、陈皮、当归、川芎各一钱，炙甘草五分，生姜三片，桑枝三钱(酒炒)。水煎服。(《医学心悟》秦艽天麻汤)③治风中经络而痛：羌活一钱五分，当归二钱，川芎一钱，熟地三钱，秦艽、白芍(酒炒)、独活各一钱五分。(《不知医必要》秦艽汤)④治黄：秦艽一大两。细锉，作两贴子，以上好酒一升，每贴半升，酒绞取汁，去滓。空腹分两服，或利便止。(《海上集验方》)⑤治黄疸，皮肤眼睛如金黄色，小便赤：秦艽五两，牛乳三升。煮取一升，去滓。内芒硝一两服。(孙思邈)⑥治虚劳潮热，咳嗽，盗汗不止：秦艽(去苗、土)、柴胡(去苗)、知母、甘草(锉、炙)各一两。上四味，粗捣筛。每服三钱匕，水一盏，煎至六分，去滓，温服，不计时候。(《圣济总录》秦艽汤)⑦治骨蒸壮热，肌肉消瘦，唇红，颊赤，气粗，四肢困倦，夜有盗汗：柴胡、鳖甲(去裙，酥炙，用九肋者)、地骨皮各一两，秦艽、当归、知母各五钱。上六味，为粗末。每服五钱，水一盏，青蒿五叶，乌梅一个，煎至七分，去滓温服，空心、临卧，各一服。(《卫生宝鉴》秦艽鳖甲散)⑧治消渴，除烦躁：秦艽二两(去苗)，甘草三分(炙微赤，锉)。上件药，捣筛为散。每服四钱，以水一中盏，入生姜半分，煎至六分，去滓，不计时候温服。(《圣惠方》)⑨治小便艰难，胀满闷：秦艽一两(去苗)。以水一大盏，煎取七分，去滓，食前分作二服。(《圣惠方》)⑩治疮口不合：秦艽为末掺之。(《仁斋直指方》)11.治发背疑似者：秦艽，牛乳煎，当得快利三、五行。(《海上集验方》)"}]},{"ID":"20240611143045-fi75of3","Type":"NodeParagraph","Properties":{"id":"20240611143045-fi75of3","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611143045-m6u3scy","Type":"NodeParagraph","Properties":{"id":"20240611143045-m6u3scy","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 1.治疗关节痛、头痛、牙痛等取秦艽10Og，或秦艽、白芷各50g，加入普鲁卡因lg，制成注射液100ml，分装、灭菌备用。肌肉注射每次2ml。曾应用2000多人次，对风寒引起的周身疼痛，以及多年风湿性腰腿痛均有止痛效果。"}]},{"ID":"20240611143045-dqga62e","Type":"NodeParagraph","Properties":{"id":"20240611143045-dqga62e","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.治疗流行性脑脊髓膜炎：将秦艽制成注射液，每毫升约含生药0.625g，每次2-5ml，每日4-6次，肌肉注射。试治21例，经用药3-7天均获痊愈，无l例发生后遗症。此外，以秦艽为主，结合辨证施治加用其他药物，治疗小儿急性黄疸型传染性肝炎20例，获得较好疗效。"}]},{"ID":"20240611143045-h3fqouv","Type":"NodeParagraph","Properties":{"id":"20240611143045-h3fqouv","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611143045-eh3qosx","Type":"NodeParagraph","Properties":{"id":"20240611143045-eh3qosx","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：秦艽，手足不遂，黄疸，烦渴之病须之，取其去阳明之湿热也。阳明有湿，则身体酸疼烦热，有热则日晡潮热骨蒸。"}]},{"ID":"20240611143045-rwc3whr","Type":"NodeParagraph","Properties":{"id":"20240611143045-rwc3whr","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：秦艽，苦能泄，辛能散，微温能通利，故主寒热邪气，寒湿风痹，肢节痛，下水，利小便。性能祛风除湿，故《别录》疗风无问久新，及通身挛急。能燥湿散热结，故《日华子》治骨蒸及疳热；甄权治酒疸解酒毒；元素除阳明风湿，及手足不遂，肠风泻血，养血荣筋；好古泄热，益胆气。咸以其除湿散结，清肠胃之功也。"}]},{"ID":"20240611143045-tamxsbk","Type":"NodeParagraph","Properties":{"id":"20240611143045-tamxsbk","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"3.《本草征要》：秦艽，长于养血，故能退热舒筋。治风先治血，血行风自灭，故疗风无问新久。入胃祛湿热，故小便利而黄疸愈也。"}]},{"ID":"20240611143045-xs2eu9b","Type":"NodeParagraph","Properties":{"id":"20240611143045-xs2eu9b","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"4.《本经逢原》：秦艽，入手足阳明，以其去湿也；兼入肝胆，以其治风也。故手足不遂，黄瘅酒毒，及妇人带疾须之。凡痛有寒热，或浮肿者，多挟客邪，用此以祛风利湿，方为合剂。故《本经》治寒热邪气，寒湿风痹，肢体痛等证。若久痛虚羸，血气不能营养肢体而痛，及下体虚寒，疼酸枯瘦等病，而小便清利者，咸非秦艽所宜。"}]},{"ID":"20240611143045-77971j0","Type":"NodeParagraph","Properties":{"id":"20240611143045-77971j0","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：秦艽，《本经》谓之苦平，而《别录》加以辛及微温，以其主治风寒湿痹，必有温通性质也，然其味本苦，其功用亦治风热，而能通利二便，已非温药本色。后人且以治胃热黄疸烦渴等症，其非温性，更是彰明较着。考《本经》、《别录》主治，功在舒筋通络，流利骨节，惟治痹痛挛急之证，盖与防风、羌、独同类之品。甄极之治头风，即祛风也；惟又称其利大小便，亦与《本经》下水利小便之旨相合。盖秦艽既能外行于关节，亦能内达于下焦，故宣通诸府，引导湿热，直走二阴而出，昔人每谓秦艽为风家润药，其意指此。因之而并及肠风下血，张石顽且谓其治带，皆以湿热有余，泄积滞言之，非统治诸虚不摄之下血带下也。又就其导湿去热而引伸之，则治胃热， 泄内热，而黄疸酒毒，牙痛口疮，温疫热毒，及妇人怀胎蕴热，小儿疳热烦渴等症，皆胃家湿热，而秦艽又能通治之矣。约而言之，外通经隧，内导二便，是其真宰，而通络之功，又在理湿之上。要之皆是从湿阻热结一面着想，而气虚血弱之症，皆非其治，仍与防风、羌、独等味异曲同工耳。"}]},{"ID":"20240611143045-iei8eu0","Type":"NodeParagraph","Properties":{"id":"20240611143045-iei8eu0","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611143045-iuxgt37","Type":"NodeParagraph","Properties":{"id":"20240611143045-iuxgt37","updated":"20240611143045"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611143046-ddq1y80","Type":"NodeThematicBreak","Properties":{"id":"20240611143046-ddq1y80"}},{"ID":"20240611143047-yl3h65x","Type":"NodeParagraph","Properties":{"id":"20240611143047-yl3h65x"}}]}