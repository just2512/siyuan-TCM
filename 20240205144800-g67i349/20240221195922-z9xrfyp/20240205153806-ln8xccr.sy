},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"防己 (29)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/防己 29-20240820151132-os5xx3g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"防己 (30)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/防己 30-20240820151252-pde7wcp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611171337-t7e022o","Type":"NodeThematicBreak","Properties":{"id":"20240611171337-t7e022o"}},{"ID":"20240611171348-sst7r6b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171348-sst7r6b","updated":"20240611171353"},"Children":[{"Type":"NodeText","Data":"防己《神农本草经》"}]},{"ID":"20240611171348-ofu0qus","Type":"NodeParagraph","Properties":{"id":"20240611171348-ofu0qus","updated":"20240611171348"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240611171348-tvqqhfy","Type":"NodeParagraph","Properties":{"id":"20240611171348-tvqqhfy","updated":"20240611171348"},"Children":[{"Type":"NodeText","Data":"主风寒温疟热气诸痈，除邪，利大小便。一名解离（《御览》作石解引云：通凑理，利九窍，《大观本》，六字黑）。生川谷。"}]},{"ID":"20240611171348-6ipqfx6","Type":"NodeParagraph","Properties":{"id":"20240611171348-6ipqfx6","updated":"20240611171348"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：木防己，一名解离，一名解燕，神农辛，黄帝岐伯桐君苦无毒，李氏大寒，如艿，茎蔓延，如艽，白根外黄似桔梗，内黑又如车辐解，二月八月十月，采根。（《御览》）"}]},{"ID":"20240611171348-iuduwk6","Type":"NodeParagraph","Properties":{"id":"20240611171348-iuduwk6","updated":"20240611171348"},"Children":[{"Type":"NodeText","Data":"《名医》曰，生汉中，二月八月，采根阴干。"}]},{"ID":"20240611171348-v3llcfk","Type":"NodeParagraph","Properties":{"id":"20240611171348-v3llcfk","updated":"20240611171348"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：防已出汉中旬阳。"}]},{"ID":"20240611171408-2vko07w","Type":"NodeThematicBreak","Properties":{"id":"20240611171408-2vko07w"}},{"ID":"20240611171409-hvndpvt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171409-hvndpvt","updated":"20240611171415"},"Children":[{"Type":"NodeText","Data":"防己《神农本草经读》"}]},{"ID":"20240611171409-1v3j798","Type":"NodeParagraph","Properties":{"id":"20240611171409-1v3j798","updated":"20240611171409"},"Children":[{"Type":"NodeText","Data":"气味辛、平，无毒。主风寒温疟，热气诸痫，除邪，利大小便。"}]},{"ID":"20240611171409-ctw3mfg","Type":"NodeParagraph","Properties":{"id":"20240611171409-ctw3mfg","updated":"20240611171409"},"Children":[{"Type":"NodeText","Data":"【述】防己气平，禀金之气；味辛无毒，得金之味入手太阴肺经。风寒温疟者，感风寒而患，但热不寒之疟也。热气诸痫者，心有热而患牛、马、猪、羊、鸡、诸痫也。温热皆为阳邪，痫疟皆属风木，防己可以统治之。除邪者，又申言可除以上之邪气也。然肺为水之上源，又与大肠相为表里，防己之辛平调肺气，则二便利矣。"}]},{"ID":"20240611171409-iybbzcd","Type":"NodeParagraph","Properties":{"id":"20240611171409-iybbzcd","updated":"20240611171409"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶《经》云∶水道不行则形消气索，是水有随气而营运于肤表者，有水火上下之相济者，如气滞而水不行则为水病、痰病矣。防己生于汉中者，破之纹如车辐，茎藤空通，主通气行水，以防己土之制，故有防己之名。《金匮》方治水病有防己黄汤、防己茯苓汤；治痰病有木防己汤、防己加茯苓芒硝汤；《千金方》治遗尿、小便涩，有三物木防己汤；盖气运于上，而水能就下也。而李东垣有云∶防己乃下焦血分之药，病在上焦气分者禁用。又云∶如险健之人，幸灾乐祸首为乱阶，若善用之亦可敌凶突险。此瞑眩之药，故圣人存而不废。噫！如此议论，不知从何处参出？夫气化而后水行，防己乃行气利水之品，反云上焦气分不可用，何不通之甚乎？防己能营运去病，是运中有补。《本经》列于中品之前，奚为存而不废？缘其富而贪名，无格物实学，每为臆说，使后人遵之如格言，畏之若毒药，非古人之罪乎？李时珍乃谓千古而下，惟东垣一人误矣。嗟嗟！安得伊芳歧重出世，更将经旨复重宣也。"}]},{"ID":"20240611171545-eiu37xu","Type":"NodeThematicBreak","Properties":{"id":"20240611171545-eiu37xu"}},{"ID":"20240611171546-ra8upho","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171546-ra8upho","updated":"20240611171551"},"Children":[{"Type":"NodeText","Data":"防己《神农本草经赞》"}]},{"ID":"20240611171546-nl27k9g","Type":"NodeParagraph","Properties":{"id":"20240611171546-nl27k9g","updated":"20240611171546"},"Children":[{"Type":"NodeText","Data":"味辛平。主风寒温疟。热气。诸痫。除邪。利大小便。一名解离。生川谷。"}]},{"ID":"20240611171546-il0vtzs","Type":"NodeParagraph","Properties":{"id":"20240611171546-il0vtzs","updated":"20240611171546"},"Children":[{"Type":"NodeText","Data":"如葛延缘。水驱风障。辐解文分。茎通气壮。险健思防。敌仇善将。丁足腥闻。木强弗尚。"}]},{"ID":"20240611171546-h890vtq","Type":"NodeParagraph","Properties":{"id":"20240611171546-h890vtq","updated":"20240611171546"},"Children":[{"Type":"NodeText","Data":"李当之曰。其根如葛蔓延。陈藏器曰。治风用木防己。治水用汉防己。苏颂曰。破之文作车辐解。茎甚嫩。折其茎。一头吹之。气从中贯。如木通然。"}]},{"ID":"20240611171546-brfl84n","Type":"NodeParagraph","Properties":{"id":"20240611171546-brfl84n","updated":"20240611171546"},"Children":[{"Type":"NodeText","Data":"李杲曰。防己如险健之人。首为乱阶。若善用之。亦可御敌。易。君子以思患而豫防之。"}]},{"ID":"20240611171546-qhuhpqk","Type":"NodeParagraph","Properties":{"id":"20240611171546-qhuhpqk","updated":"20240611171546"},"Children":[{"Type":"NodeText","Data":"黄庭坚诗。不战者善将。雷论。凡使。勿用黄腥皮皱有丁足者。书。腥闻在上。陶弘景曰。黑点木强者不佳。"}]},{"ID":"20240611171530-3jedbzy","Type":"NodeThematicBreak","Properties":{"id":"20240611171530-3jedbzy"}},{"ID":"20240611171532-03qo6uj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171532-03qo6uj","updated":"20240611171536"},"Children":[{"Type":"NodeText","Data":"防己《本草求真》"}]},{"ID":"20240611171532-0gud0z0","Type":"NodeParagraph","Properties":{"id":"20240611171532-0gud0z0","updated":"20240611171532"},"Children":[{"Type":"NodeText","Data":"（蔓草）除湿利水泻下焦湿热"}]},{"ID":"20240611171532-tkk6rjf","Type":"NodeParagraph","Properties":{"id":"20240611171532-tkk6rjf","updated":"20240611171532"},"Children":[{"Type":"NodeText","Data":"防己（专入膀胱）。辛苦大寒。性险而健。善走下行。长于除湿通窍利道。能泻下焦血分湿热。及疗风水要药。（杲曰。本草十剂云。通可去滞。通草防己之属是也。夫防己大苦寒。能泻血中湿热。通其滞塞。亦能泻大便。补阴泻阳。比之于人。则险而健者也。幸灾乐祸。能首为乱阶。然善用之。亦可敌凶穴险。）故凡木湿喘嗽。热气诸痫。温疟香港脚。水肿风肿。痈肿恶疮。及湿热流入十二经。以致二阴不通者。皆可用此调治。若属香港脚肿痛。（湿则肿。热则痛。）如湿则加苍术薏苡木瓜。热加黄芩黄柏。风加羌活萆 。痰加竹沥南星。痛加香附木香。血虚加四物。大便秘加桃仁红花。小便秘加牛膝泽泻。痛连臂加桂枝威灵仙。痛连胁加胆草。随症通活。斯为善矣！但此气味苦寒。药力猛迅。若非下焦血分实热实湿。（木通甘淡。泻气分湿热。防己苦寒。泻血分湿热。）及非二便果不通利。妄用此药投治。其失匪轻。不可不知。此虽有类黄柏地肤子。但黄柏之泻膀胱湿热。则并入肾泻火。味苦而不辛。此则辛苦兼见。性险而健。故于风水香港脚等症兼理。地肤子之泻膀胱湿热。味苦而甘。力稍逊于黄柏。此则健险异常。有辛无甘。而为乱阶之首也。其一泻热与湿。而气味治功。各别如此。己有二种。曰汉曰木。治风须用木防己。治水须用汉防己。汉已根大而虚。通心有花纹。色黄。木己黑点黄腥木强。酒洗用。恶细辛。畏萆 。"}]},{"ID":"20240611171519-1usvu1t","Type":"NodeThematicBreak","Properties":{"id":"20240611171519-1usvu1t"}},{"ID":"20240611171520-qh0xn7t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171520-qh0xn7t","updated":"20240611171525"},"Children":[{"Type":"NodeText","Data":"防己《本草思辨录》"}]},{"ID":"20240611171520-qomqux1","Type":"NodeParagraph","Properties":{"id":"20240611171520-qomqux1","updated":"20240611171520"},"Children":[{"Type":"NodeText","Data":"防己之根，外白内黄，有黑纹如车辐解，气味辛平，故治由肾以抵脾肺风湿之 。肺主皮毛，将毋从皮毛而散乎？然车能环转不能外溢，故防己绝不发汗而第直泄于小便。如金匮己椒苈黄丸（义见大黄），千金三物木防己汤可按也。"}]},{"ID":"20240611171520-oj14c6y","Type":"NodeParagraph","Properties":{"id":"20240611171520-oj14c6y","updated":"20240611171520"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶防己是疗风水要药。水与饮皆湿类也，故防己黄 汤治风湿，防己茯苓汤治水，木防己汤治饮，名虽有三，理无少异。惟风水二字，诚有不得而析者，风阳邪而风从外入，令人振寒，风寒初受，即宜汗解，防己非其责也。内伏之风，若内无阴邪，亦未能独存，故水饮湿悉其所因依，水饮湿去，则风与俱去。如此之风，方可治以防己。然苓术不能而防己独能之者，以黑纹如车辐解，正有风水相随之妙致也。"}]},{"ID":"20240611171520-0ba0azv","Type":"NodeParagraph","Properties":{"id":"20240611171520-0ba0azv","updated":"20240611171520"},"Children":[{"Type":"NodeText","Data":"或云∶防己地黄汤，治病如狂状妄行，独语不休，无寒热，其脉浮，岂亦有水饮湿也，而顾以防己治耶？曰∶此仲圣别出手眼之方，未可与他并论者也。赵氏谓血虚从邪，邪并于阳而然。按本篇固以脉浮为血虚，素问阴不胜其阳则脉流薄疾并乃狂，固可为如狂之据，此注允矣。而不言邪为何邪。徐氏则谓风邪并入于心，心火炽盛，故如狂妄行，独语不休，较赵注为明晰矣。而于是方用药之所以然，则皆未发出。窃细玩之，四物酒渍取汁，自非阳邪表邪不尔。生地黄独多，自非补血凉血不尔。有表邪而用桂枝防风，可知是外入之风邪。以生地黄偶桂枝防风，可知治不以汗解。不以汗解而有酒行药势以搜之，则邪不至或遗。四物取生汁而地黄取蒸汁，则阴阳得以分理，既所以退阳而安阴矣。然而风无出路，则风仍不息。"}]},{"ID":"20240611171520-r4wecy3","Type":"NodeParagraph","Properties":{"id":"20240611171520-r4wecy3","updated":"20240611171520"},"Children":[{"Type":"NodeText","Data":"阴不复位，则阴仍羁阳。欲并者而使之分，仲圣所以有取于防己也。夫防己者，走表而亦下行者也。操运转之技，则表间之风自随之得息。具返本之能，则被扰之阴亦因之得静。或谓防己治风湿不治风燥，不知风药中用地黄至数倍，则风亦转燥为润，正与防己相宜，可谓以人巧夺天工矣。"}]},{"ID":"20240611171502-b0k1jae","Type":"NodeThematicBreak","Properties":{"id":"20240611171502-b0k1jae"}},{"ID":"20240611171503-xk1bxz8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171503-xk1bxz8","updated":"20240611171514"},"Children":[{"Type":"NodeText","Data":"防己《本草便读》"}]},{"ID":"20240611171503-2lhiwel","Type":"NodeParagraph","Properties":{"id":"20240611171503-2lhiwel","updated":"20240611171503"},"Children":[{"Type":"NodeText","Data":"辛可散．苦可行．气寒之品．热可蠲．湿可导．性下之功．汉入下焦．行膀胱之血分．木宣经络．疏风水于皮中．（防己出汉中．木防己即是其苗．味皆辛苦而寒．其根为之汉防己．入下焦泻膀胱血分湿热．木防己偏于治上治风．故凡属水支饮等证．皆用之．大抵防己为瞑眩之药．闻其气则颇恶．下咽则使人身心烦乱．饮食减少．若善用之．能拨乱反正．可防己而御敌．故取此名也．虚人禁之．）"}]},{"ID":"20240611171447-8jria7k","Type":"NodeThematicBreak","Properties":{"id":"20240611171447-8jria7k"}},{"ID":"20240611171448-fjwbaa5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171448-fjwbaa5","updated":"20240611171455"},"Children":[{"Type":"NodeText","Data":"防己《冯氏锦囊秘录》"}]},{"ID":"20240611171448-7hezhl8","Type":"NodeParagraph","Properties":{"id":"20240611171448-7hezhl8","updated":"20240611171448"},"Children":[{"Type":"NodeText","Data":"得土中阳气，兼感平秋之燥气以生，故味辛苦，性寒，无毒，为下部血分去湿热实症之要药。若饮食劳倦，阴虚内热，胃虚肾虚，胎前产后，热在上焦气分，切勿用此阴小险见之药，以为乱阶。"}]},{"ID":"20240611171448-jw3ilxz","Type":"NodeParagraph","Properties":{"id":"20240611171448-jw3ilxz","updated":"20240611171448"},"Children":[{"Type":"NodeText","Data":"防己，汉者主水气，名载君行；木者理风邪，职佥使列。故治腰已下至足湿热肿痛香港脚，及利大小二便。退膀胱积热，消痈散肿，则非汉不能成功。若疗肺气喘嗽，膈间支满，并除中风挛急，风寒湿疟热邪，此又全仗木者。总通十二经，散湿热仙药也。然苦辛大寒，犹人险而健者也。可以治有余，不可以治不足。若虚症，必须佐以参苓二术为当耳。"}]},{"ID":"20240611171448-ipvesah","Type":"NodeParagraph","Properties":{"id":"20240611171448-ipvesah","updated":"20240611171448"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 痘疹陷伏，因于湿热者，可酒洗浸，晒干用。"}]},{"ID":"20240611171434-68oue5l","Type":"NodeThematicBreak","Properties":{"id":"20240611171434-68oue5l"}},{"ID":"20240611171436-hh6wc1u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171436-hh6wc1u","updated":"20240611171441"},"Children":[{"Type":"NodeText","Data":"防己《增广和剂局方药性总论》"}]},{"ID":"20240611171436-y52rup7","Type":"NodeParagraph","Properties":{"id":"20240611171436-y52rup7","updated":"20240611171436"},"Children":[{"Type":"NodeText","Data":"味辛苦，平、温，无毒。主风寒温疟、热气诸痫，除邪，利大小便，疗水肿、风肿，膀胱热，伤寒寒热邪气，中风手脚挛急，止泄，散痈肿，恶结，诸蜗疥癣虫疮，通腠理，九窍。《药性论》云∶汉防己，君。味苦，有小毒。能治湿风口眼 斜、手足疼，散留痰，主肺气嗽喘。木防己∶使。畏∶女菀、卤咸，味辛苦。治男子肢节中风，毒风不语，主散结气，痈肿，温疟，风水肿，治膀胱。殷孽为之使。杀∶雄黄毒。恶∶细辛。畏∶萆 。"}]},{"ID":"20240611171421-tva2y63","Type":"NodeThematicBreak","Properties":{"id":"20240611171421-tva2y63"}},{"ID":"20240611171422-xzh765x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171422-xzh765x","updated":"20240611171427"},"Children":[{"Type":"NodeText","Data":"防己《顾松园医镜》"}]},{"ID":"20240611171422-shtxf9f","Type":"NodeParagraph","Properties":{"id":"20240611171422-shtxf9f","updated":"20240611171422"},"Children":[{"Type":"NodeText","Data":"〔辛苦寒，入膀胱经。〕祛下焦湿热，〔专泻下焦血中湿热，上焦禁用。〕治香港脚肿痛。〔香港脚之疾，因湿热壅遏，喜通而恶塞，故用汉防己以通滞塞，且其性又能利大小便。〕防己分木汉二种。木者专风，汉者专水。"}]},{"ID":"20240611171422-t1i8oqn","Type":"NodeParagraph","Properties":{"id":"20240611171422-t1i8oqn","updated":"20240611171422"},"Children":[{"Type":"NodeText","Data":"大苦大寒，其性猛悍。善用之。亦可敌凶突险，此瞑眩之药也。服之令人身心烦闷，饮食减少，惟下焦湿热壅遏，及香港脚病，非此不效；须与米仁、石斛、茯苓、木瓜、萆 之属同用则可。"}]},{"ID":"20240611171357-cb26o6s","Type":"NodeThematicBreak","Properties":{"id":"20240611171357-cb26o6s"}},{"ID":"20240611171358-fga3ygv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171358-fga3ygv","updated":"20240611171403"},"Children":[{"Type":"NodeText","Data":"防己《药性切用》"}]},{"ID":"20240611171358-fnf8x8d","Type":"NodeParagraph","Properties":{"id":"20240611171358-fnf8x8d","updated":"20240611171358"},"Children":[{"Type":"NodeText","Data":"大辛苦寒，入足太阴，兼行十二经，泻下焦血分湿热。《十剂》曰∶通可去滞，通草防己之属。但通草甘淡，泻气分湿热；防己苦寒，泻血分湿热。一类有二种，治湿用汉防治风用木防己，为风湿香港脚专药。干香港脚，属阴虚无湿者忌。"}]},{"ID":"20240611171337-dmaqdps","Type":"NodeThematicBreak","Properties":{"id":"20240611171337-dmaqdps"}},{"ID":"20240611171338-kvtkgc3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171338-kvtkgc3","updated":"20240611171342"},"Children":[{"Type":"NodeText","Data":"防己《本草分经》"}]},{"ID":"20240611171338-50xaqul","Type":"NodeParagraph","Properties":{"id":"20240611171338-50xaqul","updated":"20240611171338"},"Children":[{"Type":"NodeText","Data":"大辛苦寒，入膀胱，去火邪，能行十二经，通腠理利九窍，泻下焦血分湿热，疗风行水，降气下痰。性险而健，惟湿热壅遏及香港脚病凡下焦湿热致二阴不通者用此治之。有二种，汉防己治水用，木防己治风用。"}]},{"ID":"20240611171313-ys8u4je","Type":"NodeThematicBreak","Properties":{"id":"20240611171313-ys8u4je"}},{"ID":"20240611171327-04yfgu7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171327-04yfgu7","updated":"20240611171332"},"Children":[{"Type":"NodeText","Data":"防己《千金翼方》"}]},{"ID":"20240611171327-m2cpgww","Type":"NodeParagraph","Properties":{"id":"20240611171327-m2cpgww","updated":"20240611171327"},"Children":[{"Type":"NodeText","Data":"味辛苦，平，温，无毒。主风寒，温疟，热气，诸痫，除邪，利大小便。疗水肿去膀胱热，伤寒，寒热邪气，中风手脚挛急，止泻，散痈肿恶结，诸蜗疥癣虫疮，通腠理，利九窍。一名解离，文如车辐理解者良。生汉中川谷，二月八月采根，阴干。"}]},{"ID":"20240611171313-5jg16sh","Type":"NodeThematicBreak","Properties":{"id":"20240611171313-5jg16sh"}},{"ID":"20240611171314-qjbv1go","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171314-qjbv1go","updated":"20240611171318"},"Children":[{"Type":"NodeText","Data":"防己《本草从新》"}]},{"ID":"20240611171314-56u3582","Type":"NodeParagraph","Properties":{"id":"20240611171314-56u3582","updated":"20240611171314"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、行水、泻下焦血分湿热．"}]},{"ID":"20240611171314-ihugv1k","Type":"NodeParagraph","Properties":{"id":"20240611171314-ihugv1k","updated":"20240611171314"},"Children":[{"Type":"NodeText","Data":"大辛苦寒．太阳经药．（膀胱．）能行十二经．通腠理．利九窍．泻下焦血分湿热．为疗风水之要药．（十剂曰∶通可去滞、通草防己之属是也、古之通草、即今之木通是、徐之才亦以行水者为通、与燥剂无以别矣、木通甘淡、泻气分湿热、防己苦寒、泻血分湿热．）主治膀胱火邪．热气诸痫．（降气下痰．）湿疟香港脚．（足伤寒湿为香港脚、寒湿郁而为热、湿则肿、热则痛、防己为主药、湿加苡仁苍术木瓜木通、热加知己、风加羌活萆 、痰加竹沥南星、四物、大便闭加桃仁红花、小便闭加牛膝泽泻、痛连臂加桂枝威灵仙、痛连胁加龙胆草、又有足跟痛者、属肾虚、不与香港脚同论．）水肿风肿．痈肿恶疮．性险而健．阴虚及湿热在上焦气分者禁用．（东垣云∶防己大苦大寒、泻血中湿热、亦瞑眩之药也、服之使人身心烦乱、饮食减少、唯湿热壅遏、及香港脚病、凡下焦湿热、致二阴不通者、非此不效、若虚人用防己、其害有三、谷食己亏、复泄大便、重亡其血、一也；渴在上焦气分、而防己泻下焦血分、二也；伤寒邪传肺经气分、湿热而小便黄赤、禁用血药、三也．）"}]},{"ID":"20240611171314-hqf3j12","Type":"NodeParagraph","Properties":{"id":"20240611171314-hqf3j12","updated":"20240611171314"},"Children":[{"Type":"NodeText","Data":"出汉中．根大而虚．通心有花纹．色黄．名汉防己．黑点黄腥木强者．名木防己．不佳．（藏器曰∶治风用木防己、治水用汉防己．）酒洗．恶细辛．畏萆 、女菀、咸卤．（防己煎汁服、能解雄黄毒．）"}]},{"ID":"20240611171231-q0t65rm","Type":"NodeThematicBreak","Properties":{"id":"20240611171231-q0t65rm"}},{"ID":"20240611171259-q0jwfqs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171259-q0jwfqs","updated":"20240611171308"},"Children":[{"Type":"NodeText","Data":"防己《要药分剂》"}]},{"ID":"20240611171259-qsaer3n","Type":"NodeParagraph","Properties":{"id":"20240611171259-qsaer3n","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"味辛苦。性寒。无毒。得土中阳气。兼感秋之燥气以生。降也。阳中阴也。恶细辛。"}]},{"ID":"20240611171259-bww9zde","Type":"NodeParagraph","Properties":{"id":"20240611171259-bww9zde","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"畏萆、女寇、卤碱。伏硝石。"}]},{"ID":"20240611171259-a66v9ca","Type":"NodeParagraph","Properties":{"id":"20240611171259-a66v9ca","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"【主治】〔汉防己〕主风寒温疟。热气诸痫。除邪。利大小便。（本经）疗水肿风肿。去膀胱斜。"}]},{"ID":"20240611171259-y1pu08i","Type":"NodeParagraph","Properties":{"id":"20240611171259-y1pu08i","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"十二经。"}]},{"ID":"20240611171259-a3amboc","Type":"NodeParagraph","Properties":{"id":"20240611171259-a3amboc","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"语。散结【归经】入膀胱经。为祛风行水之品。（太阳经主药疗风水要药通行十二经泻下焦血分湿热）【前论】藏器曰。出汉中。根大而虚。通心有花纹。色黄者名汉防己。生他处。青白而软。"}]},{"ID":"20240611171259-y1urt8v","Type":"NodeParagraph","Properties":{"id":"20240611171259-y1urt8v","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"焦湿经药也。东垣除膀胱积热。非此不可。真行经之仙药。无可代之者。若夫饮食劳倦。阴虚生内热。元气谷食已亏。以防己泄大便。则重亡其血。此不可用一也。如大渴引饮。是热在上焦气分。"}]},{"ID":"20240611171259-wmdrrje","Type":"NodeParagraph","Properties":{"id":"20240611171259-wmdrrje","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"宜渗泄。而防己乃下焦血分药。此不可用二也。外伤风寒。邪传肺经气分。湿热而小便黄赤。乃至不通。此上焦气病。禁用血药。此不可用三也。"}]},{"ID":"20240611171259-x6qsdz0","Type":"NodeParagraph","Properties":{"id":"20240611171259-x6qsdz0","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"流入十二经致二阴不通者。然后审用之。好古曰。木分湿热。仲淳曰。凡使防己于下部湿热药中。亦必以石斛、苡仁等补益之药为佐。而以防己为使。乃无己为主药。又有足跟痛者。属肾虚。不与香港脚同论【禁忌】经疏曰。凡胃虚阴虚。自汗盗汗。口苦舌干。肾虚小水不利。及产前后血虚。"}]},{"ID":"20240611171259-5vvvw7z","Type":"NodeParagraph","Properties":{"id":"20240611171259-5vvvw7z","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"虽有下焦湿热。均忌。"}]},{"ID":"20240611171259-3b1o8i4","Type":"NodeParagraph","Properties":{"id":"20240611171259-3b1o8i4","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"【炮制】时珍曰。凡使。去皮。锉。酒洗。晒干用。"}]},{"ID":"20240611171259-uj448m8","Type":"NodeParagraph","Properties":{"id":"20240611171259-uj448m8","updated":"20240611171259"},"Children":[{"Type":"NodeText","Data":"以上通剂草部"}]},{"ID":"20240611171231-94jh9eq","Type":"NodeThematicBreak","Properties":{"id":"20240611171231-94jh9eq"}},{"ID":"20240611171248-7a4795s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171248-7a4795s","updated":"20240611171252"},"Children":[{"Type":"NodeText","Data":"防己《医学入门》"}]},{"ID":"20240611171248-0zjixrn","Type":"NodeParagraph","Properties":{"id":"20240611171248-0zjixrn","updated":"20240611171248"},"Children":[{"Type":"NodeText","Data":"防己苦辛气亦平，善治腰脚肿且疼，风湿热寒邪可利，疟喘疮痈用亦灵。"}]},{"ID":"20240611171248-ziz8ovo","Type":"NodeParagraph","Properties":{"id":"20240611171248-ziz8ovo","updated":"20240611171248"},"Children":[{"Type":"NodeText","Data":"已，止也，防止足疾也。无毒。沉也，阳中之阴也，太阳本经药，通行一十二经。主腰以下至足血分湿热肿疼香港脚，中风手足挛急，诸痫，伤寒，寒热邪气，通腠理，利九窍。膀胱有热、二便不利者最宜。风湿头汗身重便难者必用之。又治风寒温疟及水肿风肿，肺气喘嗽，膈间支满，肺痿咯血多痰，杀痈肿疥癣虫疮。"}]},{"ID":"20240611171248-vc5vsbz","Type":"NodeParagraph","Properties":{"id":"20240611171248-vc5vsbz","updated":"20240611171248"},"Children":[{"Type":"NodeText","Data":"出汉中，纹如车辐，黄实而香者胜；出华州，青白虚软者名木防己，次之。但汉主水气，木主风气，古方亦通用之。酒洗去皮，治肺生用。雷公以车前根同蒸，去车前用。殷孽为使，恶细辛，畏萆 、女菀、卤咸，杀雄黄毒。"}]},{"ID":"20240611171231-dhypzcq","Type":"NodeThematicBreak","Properties":{"id":"20240611171231-dhypzcq"}},{"ID":"20240611171232-lpkmai3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171232-lpkmai3","updated":"20240611171238"},"Children":[{"Type":"NodeText","Data":"防己《本草崇原》"}]},{"ID":"20240611171232-dzyercz","Type":"NodeParagraph","Properties":{"id":"20240611171232-dzyercz","updated":"20240611171232"},"Children":[{"Type":"NodeText","Data":"气味辛平，无毒。主治风寒温疟热气，诸痫，除邪，利大小便。"}]},{"ID":"20240611171232-e2bnhah","Type":"NodeParagraph","Properties":{"id":"20240611171232-e2bnhah","updated":"20240611171232"},"Children":[{"Type":"NodeText","Data":"（防己《本经》名解离，以生汉中者为佳，故名汉防己。江南诸处皆有，总属一种，因地土同，致形有大小，而内之花纹皆如车辐。所谓木防己者，谓其茎梗如木，无论汉中他处皆名木防己，即通草，名木通之义非。出汉中者，名汉防己，他处者，名木防己也。上古诸方，皆云木防己汤，是木防己，乃其本名，生汉中佳，故后人又有汉防己之称，其茎蔓延如葛，折其茎一头吹之，气从中贯，俨如木通，其根外白内黄，破之黑纹四布，故名解离。）"}]},{"ID":"20240611171232-c8zdlml","Type":"NodeParagraph","Properties":{"id":"20240611171232-c8zdlml","updated":"20240611171232"},"Children":[{"Type":"NodeText","Data":"防己气味辛平，色白纹黑，禀金水相生之气化。其茎如木，木能防土，己者土也，故有防己之名。主治风寒温疟热气者，风寒之邪，藏于肾脏，发为先热后寒之温疟。温疟者，热气有余之疟也。《经》云∶温疟者，先热后寒，得之冬中于风寒，此病藏于肾。防己启在下之水精而输转于外，故治风寒温疟热气也。诸痫除邪者，心包受邪，发为牛马猪羊鸡诸痫之证。"}]},{"ID":"20240611171232-wypojdw","Type":"NodeParagraph","Properties":{"id":"20240611171232-wypojdw","updated":"20240611171232"},"Children":[{"Type":"NodeText","Data":"防己中空藤蔓，能通在内之经脉，而外达于络脉，故治诸痫除邪也。利大小便者，土得木而达，木防其土，土气疏通，则二便自利矣。"}]},{"ID":"20240611171232-lepequ6","Type":"NodeParagraph","Properties":{"id":"20240611171232-lepequ6","updated":"20240611171232"},"Children":[{"Type":"NodeText","Data":"愚按∶防己气味辛平，茎空藤蔓，根纹如车辐，能启在下之水精而上升，通在内之经脉而外达，故《金匮要略》云∶膈间支饮，其人喘满，心下痞坚，面色黧黑者，其脉沉紧，得之数十日，医吐下之，不愈，木防己汤主之。又云∶风水脉浮身重，汗出恶风者，防己黄 汤主之。皮水为病，四肢肿，水气在皮肤中，四肢聂聂动者，防己茯苓汤主之。《千金方》治遗尿小便涩，三物木防己汤主之。而李东垣有云∶防己乃下焦血分之药，病在上焦气分者，禁用。试观《金匮》诸方所治之证，果在气分乎？血分乎？抑在上焦乎？下焦乎？盖防己乃行气通上之药，其性功与乌药、木通相类，而后人乃以防己为下部药，不知何据。东垣又云∶防己大苦寒，能泻血中湿热，比之于人，则险而健者也，幸灾乐祸，能为乱阶，然善用之，亦可敌凶突险，此瞑眩之药也。故圣人存而不废噫。神农以中品之药为臣，主通调血气，祛邪治病，无毒有毒，斟酌其宜，随病而用。如防己既列中品，且属无毒，以之治病，有行气清热之功。险健为乱之说，竟不知从何处得来，使后人遵之如格言，畏之若毒药，非先圣之罪人乎。东垣立言，多属臆说，盖其人富而贪名，又无格物实学。李时珍乃谓千古而下，唯东垣一人，误矣。嗟嗟，安得伊芳耆再治世，更将经旨复重宣。"}]},{"ID":"20240611171143-uc6w1xj","Type":"NodeThematicBreak","Properties":{"id":"20240611171143-uc6w1xj"}},{"ID":"20240611171219-3emqcwu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171219-3emqcwu","updated":"20240611171223"},"Children":[{"Type":"NodeText","Data":"防己《名医别录》"}]},{"ID":"20240611171219-pecfrgg","Type":"NodeParagraph","Properties":{"id":"20240611171219-pecfrgg","updated":"20240611171219"},"Children":[{"Type":"NodeText","Data":"味苦，温，无毒．主治水肿，风肿，去膀胱热，伤寒，寒热邪气，中风，手脚挛急，泄，散痈肿、恶结，诸蜗疥癣，虫疮，通腠理，利九窍．文如车辐理解者良．生汉中．二八月采根，阴干．殷KT 为之使，杀雄黄毒，恶细辛，畏萆 ．"}]},{"ID":"20240611171219-b67numz","Type":"NodeParagraph","Properties":{"id":"20240611171219-b67numz","updated":"20240611171219"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶防己，味辛平．主风寒，温疟热气诸痫，除邪，利大小便，一名解离．生川谷．"}]},{"ID":"20240611171144-e8nbpat","Type":"NodeThematicBreak","Properties":{"id":"20240611171144-e8nbpat"}},{"ID":"20240611171208-gmj4zel","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171208-gmj4zel","updated":"20240611171212"},"Children":[{"Type":"NodeText","Data":"防己《本草述钩元》"}]},{"ID":"20240611171208-kmj5d1k","Type":"NodeParagraph","Properties":{"id":"20240611171208-kmj5d1k","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"黔产不及汉中者良。故称汉防己。其茎如葛蔓延。茎根甚嫩。折一头吹之。气从中贯采其根用。剖开须作车辐解。而木强者不取也。汉防己。是根破之纹。作车辐解。黄实馨木防己。是苗上有丁足子。青白虚软。（嘉谟）气味大苦辛寒。性燥而不淳。善走下行。阴也。泄也。入足太阳经。防己阳中之阴药也。"}]},{"ID":"20240611171208-bymg1ct","Type":"NodeParagraph","Properties":{"id":"20240611171208-bymg1ct","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"（脚拘己凶突热壅塞气已亏分湿热致二阴不通者。"}]},{"ID":"20240611171208-aphst6q","Type":"NodeParagraph","Properties":{"id":"20240611171208-aphst6q","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"如肺痿咯血之类防己于下部湿热药乃无瞑眩之患。"}]},{"ID":"20240611171208-3y019yo","Type":"NodeParagraph","Properties":{"id":"20240611171208-3y019yo","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"主之。防己黄风水恶风汗出。"}]},{"ID":"20240611171208-27poodw","Type":"NodeParagraph","Properties":{"id":"20240611171208-27poodw","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"甘草半两。锉散痛加芍药。风湿卫。防术胜食。"}]},{"ID":"20240611171208-cdsrzoj","Type":"NodeParagraph","Properties":{"id":"20240611171208-cdsrzoj","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"一钱。极验。"}]},{"ID":"20240611171208-s7p9p4v","Type":"NodeParagraph","Properties":{"id":"20240611171208-s7p9p4v","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"〔论〕防己为除下焦湿热要剂。何以能通十二经。以其为足太阳本经药。经固曰巨阳者。"}]},{"ID":"20240611171208-0rgaglw","Type":"NodeParagraph","Properties":{"id":"20240611171208-0rgaglw","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"诸盖病亦可治之为病其义之。"}]},{"ID":"20240611171208-az01gem","Type":"NodeParagraph","Properties":{"id":"20240611171208-az01gem","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"气郁足肿一证。概以为湿热下溜耳。即是湿热概以为血分病耳。又不过曰气郁化湿。湿郁化热耳下输后天也。血海之上。乃有丹田。气充于血也。血生于气。则胃气之虚与胃阳之亢者。便气海。使肺气下降入心而生血矣。不能生血。则以冲任之气。不得胃气以行血海之化而达于足也血困于湿。其热者阴气微也。湿热虽属血分之病。"}]},{"ID":"20240611171208-y60n7o0","Type":"NodeParagraph","Properties":{"id":"20240611171208-y60n7o0","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"乃先哲又谓胃气下陷者。盖天气下为雨。则地气上升焉。（其举阴以上升者。乃阴中之阳。正谓元气上升。（不能举阴以升。由冲任不得阳以化也。）化以荣于周身。乃举身半以下为肿或痛矣。是其必裕肾肝之阴以举阳。或益阳。或清其并阳之热或升而举之。岂漫从事于祛除湿热。更加防己辈阳以升。然后阳中含阴以降。此篇论病。乃先从是病机之本也。其有肝肾阳微。阴不得化。而湿热只因于下者。又当从肝肾为本。第不能舍后天生化之胃耳。"}]},{"ID":"20240611171208-m5mhbs3","Type":"NodeParagraph","Properties":{"id":"20240611171208-m5mhbs3","updated":"20240611171208"},"Children":[{"Type":"NodeText","Data":"缪氏。防己性悍气猛。走窜决防。大苦大寒。能伤胃。凡胃虚阴虚肾虚小水不利。及胎前产〔辨治〕凡使。勿用木条色黄而腥皮皱上有丁足子。惟要心有花纹黄色者。去皮锉。酒洗。"}]},{"ID":"20240611171144-87kdskc","Type":"NodeThematicBreak","Properties":{"id":"20240611171144-87kdskc"}},{"ID":"20240611171157-ulx9cus","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171157-ulx9cus","updated":"20240611171202"},"Children":[{"Type":"NodeText","Data":"防己《本经逢原》"}]},{"ID":"20240611171157-x22ty9b","Type":"NodeParagraph","Properties":{"id":"20240611171157-x22ty9b","updated":"20240611171157"},"Children":[{"Type":"NodeText","Data":"辛苦寒，有毒。"}]},{"ID":"20240611171157-8db4zsj","Type":"NodeParagraph","Properties":{"id":"20240611171157-8db4zsj","updated":"20240611171157"},"Children":[{"Type":"NodeText","Data":"《本经》主风寒温疟，热气诸病，除邪，利大小便。"}]},{"ID":"20240611171157-1ztixm5","Type":"NodeParagraph","Properties":{"id":"20240611171157-1ztixm5","updated":"20240611171157"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"防己辛寒纯阴，主下焦血分之病，性劣不纯，善走下行，长于除湿，以辛能走散。兼之气悍，故主风寒温疟，热气诸病，除邪，利大小便，此《千金》主治也。《别录》疗水肿，膀胱热；通腠理，利九窍，皆除湿之功也。弘景曰，防己是疗风水要药。汉防己是根，入膀胱去身半以下湿热。木防己是苗，走阳 ，治中风挛急风痹湿热。《金匮》防己黄汤，防己地黄汤、木防己汤、五物防己汤，皆治痰饮湿热之要药。而《千金》治遗尿、小便涩，有三物木防己汤。水肿亦有三物木防己汤，总取其通行经脉之力也。能泻血中湿热，通经络中滞塞。壮健之类用之，不得其宜，下喉令人心烦、饮食减少。至于去湿热肿痛，下注香港脚，膀胱积热，诚通行十二经之仙药也。如饮食劳倦，阴虚内热，以防己泄大便则重亡其血，其不可用一也。大渴引饮，及久病津液不行，上焦湿热等证，防己乃下焦血药，其不可用二也。外感邪传肺经，气分湿热而小便黄赤，此上焦气病，其不可用三也。大抵上焦湿热皆不可用，即下焦湿热又当审其二便不通利者，方可用之。"}]},{"ID":"20240611171025-vl2c7ws","Type":"NodeThematicBreak","Properties":{"id":"20240611171025-vl2c7ws"}},{"ID":"20240611171141-u1lorxo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171141-u1lorxo","updated":"20240611171149"},"Children":[{"Type":"NodeText","Data":"防己《长沙药解》"}]},{"ID":"20240611171141-68f5h0o","Type":"NodeParagraph","Properties":{"id":"20240611171141-68f5h0o","updated":"20240611171141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛平。主风寒温疟热气诸痈，除邪，利大小便。一名解离。生川谷。"}]},{"ID":"20240611171141-qchwt87","Type":"NodeParagraph","Properties":{"id":"20240611171141-qchwt87","updated":"20240611171141"},"Children":[{"Type":"NodeText","Data":"味苦、辛，性寒，入足太阴脾、足太阳膀胱经。泻经络之湿邪，逐脏腑之水气。"}]},{"ID":"20240611171141-77zah6m","Type":"NodeParagraph","Properties":{"id":"20240611171141-77zah6m","updated":"20240611171141"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防己黄芪汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"防己一两，黄芪一两，甘草五钱，白术七钱五分，生姜四两，大枣三枚。服后当如虫行皮中，从腰以下如冰，上下绕被，温令微汗，差。"},{"Type":"NodeText","Data":"治风湿脉浮身重，汗出恶风。以汗出当风，开其皮毛，汗液郁遏，不得外泄，浸淫经络，是谓风湿。病在经络，是以脉浮。湿性沉着，是以身重。风性疏泄，是以汗出恶风。术、甘燥土而补中，黄芪益卫以发表，防己泻腠理之湿邪也。"}]},{"ID":"20240611171141-3frof7k","Type":"NodeParagraph","Properties":{"id":"20240611171141-3frof7k","updated":"20240611171141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防己茯苓汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"防己三两，茯苓六两，黄芪三两，桂枝三两，甘草二两。"},{"Type":"NodeText","Data":"治皮水为病，四肢肿者。水在皮肤，是谓皮水。四肢秉气于脾胃，缘土旺于四季也，水邪侮土，不能行气于四肢，故四肢做肿，聂聂动摇。甘草补土，黄芪、桂枝，宣营卫之郁，防己、茯苓，泻皮肤之水也。"}]},{"ID":"20240611171141-5ulbat0","Type":"NodeParagraph","Properties":{"id":"20240611171141-5ulbat0","updated":"20240611171141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"己椒苈黄丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"防己一两，椒目一两，葶苈一两，大黄一两。蜜丸，如梧子大，食前服一丸，日三服。"},{"Type":"NodeText","Data":"治肠间有水气，腹满，口舌干燥者。水在肠间，阻遏中气，升降不行，是以腹满。防己、椒目，泻湿而行水，葶苈、大黄，浚流而决壅也。"}]},{"ID":"20240611171141-azh0bvw","Type":"NodeParagraph","Properties":{"id":"20240611171141-azh0bvw","updated":"20240611171141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木防己汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"木防己三两，石膏如鸡子大，人参四两，桂枝二两。"},{"Type":"NodeText","Data":"治膈间支饮，其人喘满，心下痞坚。面色黧黑，脉沉紧者。以土湿胃逆，不能行水，故饮停于胸膈。胃逆而阻胆经之降路，故心下痞坚。胃逆而阻肺气之降路，故胸中喘满。人参、桂枝，补中而疏木，防己、石膏，泻水而清金也。"}]},{"ID":"20240611171141-whqkzul","Type":"NodeParagraph","Properties":{"id":"20240611171141-whqkzul","updated":"20240611171141"},"Children":[{"Type":"NodeText","Data":"汉防己泻经络之湿淫，木防己泻脏腑之水邪。凡痰饮内停，湿邪外郁，皮肤黑黄，膀胱热涩，手足挛急，关节肿痛之证，悉宜防己。"}]},{"ID":"20240611171025-nnawf3d","Type":"NodeThematicBreak","Properties":{"id":"20240611171025-nnawf3d"}},{"ID":"20240611171034-w1demcy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171034-w1demcy","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"《中国药典》：防己"}]},{"ID":"20240611171034-htw0xen","Type":"NodeParagraph","Properties":{"id":"20240611171034-htw0xen","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611171034-0cwcwhm","Type":"NodeParagraph","Properties":{"id":"20240611171034-0cwcwhm","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" Fánɡ Jǐ"}]},{"ID":"20240611171034-mof470x","Type":"NodeParagraph","Properties":{"id":"20240611171034-mof470x","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611171034-njsyfwq","Type":"NodeParagraph","Properties":{"id":"20240611171034-njsyfwq","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 粉防己、粉寸己、汉防己、土防己[浙江]、石蟾蜍、蟾蜍薯、倒地拱、白木香、猪大肠"}]},{"ID":"20240611171034-wybiiim","Type":"NodeParagraph","Properties":{"id":"20240611171034-wybiiim","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611171034-0iietiy","Type":"NodeParagraph","Properties":{"id":"20240611171034-0iietiy","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" RADIX STEPHANIAE TETRANDRAE"}]},{"ID":"20240611171034-5s9e9xv","Type":"NodeParagraph","Properties":{"id":"20240611171034-5s9e9xv","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611171034-58em482","Type":"NodeParagraph","Properties":{"id":"20240611171034-58em482","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 本品为防己科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉防己"},{"Type":"NodeText","Data":"Stephania tetrandra S. Moore的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干燥根"},{"Type":"NodeText","Data":"。秋季采挖，洗净，除去粗皮，晒至半干，切段，个大者再纵切，干燥。"}]},{"ID":"20240611171034-to3vuso","Type":"NodeParagraph","Properties":{"id":"20240611171034-to3vuso","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611171034-qc2ftf9","Type":"NodeParagraph","Properties":{"id":"20240611171034-qc2ftf9","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 本品呈不规则圆柱形、半圆柱形或块状，多弯曲，长5～10cm。直径1～5cm。表面淡灰黄色，在弯曲处常有深陷横沟而成结节状的瘤块样。体重，质坚实，断面平坦，灰白色，富粉性，有排列较稀疏的放射状纹理。气微，味苦。"}]},{"ID":"20240611171034-gsmstaj","Type":"NodeParagraph","Properties":{"id":"20240611171034-gsmstaj","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611171034-srvz8vr","Type":"NodeParagraph","Properties":{"id":"20240611171034-srvz8vr","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防霉，防蛀。"}]},{"ID":"20240611171034-z2lsz0i","Type":"NodeParagraph","Properties":{"id":"20240611171034-z2lsz0i","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611171034-a4xyhwf","Type":"NodeParagraph","Properties":{"id":"20240611171034-a4xyhwf","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防已片"},{"Type":"NodeText","Data":"：除去杂质，稍浸，洗净，润透，切厚片，干燥。本品为类圆形或破碎的厚片，周边色较深，切面灰白色，粉性，有稀疏的放射状纹理。气微，味苦。"}]},{"ID":"20240611171034-bnat8bj","Type":"NodeParagraph","Properties":{"id":"20240611171034-bnat8bj","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611171034-1ol7svs","Type":"NodeParagraph","Properties":{"id":"20240611171034-1ol7svs","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：木栓层有时残存。皮层散有石细胞群，常切向排列。韧皮部较宽。形成层成环。木质部占大部分，射线较宽；导管稀少，呈放射状排列；导管旁有木纤维。薄壁细胞充满淀粉粒，并可见细小杆状草酸钙结晶。"}]},{"ID":"20240611171034-4bkbb85","Type":"NodeParagraph","Properties":{"id":"20240611171034-4bkbb85","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末约2g，加0。5mol/L硫酸溶液20ml，加热10分钟，滤过，滤液加氨试液调节pH值至9 ，移置分液漏斗中，加苯25ml，振摇提取，分取苯液5ml，置瓷蒸发皿中，蒸干，残渣加钼硫酸试液数滴，即显紫色，渐变绿色至污绿色，放置，色渐加深。"}]},{"ID":"20240611171034-euokevl","Type":"NodeParagraph","Properties":{"id":"20240611171034-euokevl","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"（3） 取本品粉末1g，加乙醇15ml，加热回流 1小时，放冷，滤过，滤液蒸干，残渣加乙醇 5ml使溶解，作为供试品溶液。另取粉防己碱与防己诺林碱对照品，加氯仿制成每1ml各含1mg的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试，吸取上述两种溶液各5μl，分别点于同一硅胶Ｇ薄层板上，以氯仿－丙酮－甲醇 （6:1:1）为展开剂，展开，取出，晾干，喷以稀碘化铋钾试液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611171034-p6vcam1","Type":"NodeParagraph","Properties":{"id":"20240611171034-p6vcam1","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611171034-9je8e4y","Type":"NodeParagraph","Properties":{"id":"20240611171034-9je8e4y","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 归膀胱、肺经。"}]},{"ID":"20240611171034-1ozha39","Type":"NodeParagraph","Properties":{"id":"20240611171034-1ozha39","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611171034-925t0ri","Type":"NodeParagraph","Properties":{"id":"20240611171034-925t0ri","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611171034-3ol0h0n","Type":"NodeParagraph","Properties":{"id":"20240611171034-3ol0h0n","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611171034-jot017l","Type":"NodeParagraph","Properties":{"id":"20240611171034-jot017l","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 利水消肿，祛风止痛。用于水肿脚气，小便不利，湿疹疮毒，风湿痹痛；高血压。"}]},{"ID":"20240611171034-sqg1txb","Type":"NodeParagraph","Properties":{"id":"20240611171034-sqg1txb","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611171034-3w4xigm","Type":"NodeParagraph","Properties":{"id":"20240611171034-3w4xigm","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 4。5～9g。"}]},{"ID":"20240611171034-lc7hhws","Type":"NodeParagraph","Properties":{"id":"20240611171034-lc7hhws","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611171034-en4c7ob","Type":"NodeParagraph","Properties":{"id":"20240611171034-en4c7ob","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" （1）防己自古以来分为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"汉防己"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木防己"},{"Type":"NodeText","Data":"两大类，一般习惯所称的汉防己实际上是防己科的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉防己"},{"Type":"NodeText","Data":"，而不是马兜铃科的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"汉中防己"},{"Type":"NodeText","Data":"Aristolochia heterophylla Hemsl.，商品木防己则为马兜铃科的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"广防己"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"汉中防己"},{"Type":"NodeText","Data":"，有时也包括防己科的木防己。现时中医应用防己的经验是：汉防己偏于利湿走里，可利小便以消肿；木防己偏于祛风而走外，用于祛风湿以止痛。"}]},{"ID":"20240611171034-u6plpis","Type":"NodeParagraph","Properties":{"id":"20240611171034-u6plpis","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"（2）用于风湿痹痛，多配伍薏苡仁、滑石、蜇砂等清热除湿之品。对寒湿痹痛，须用温经止痛的肉桂、附子等药同用。用于水肿、小便不利等症，可与椒目、葶苈子、大枣等配伍同用，若属虚证，常与黄耆、茯苓、白朮等配伍。"}]},{"ID":"20240611171034-o2irjnk","Type":"NodeParagraph","Properties":{"id":"20240611171034-o2irjnk","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611171034-zjobpr5","Type":"NodeParagraph","Properties":{"id":"20240611171034-zjobpr5","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611171034-q1w188t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611171034-q1w188t","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：防己"}]},{"ID":"20240611171034-4hxa1p1","Type":"NodeParagraph","Properties":{"id":"20240611171034-4hxa1p1","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611171034-tlb0okh","Type":"NodeParagraph","Properties":{"id":"20240611171034-tlb0okh","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" Fánɡ Jǐ"}]},{"ID":"20240611171034-8hg1nnt","Type":"NodeParagraph","Properties":{"id":"20240611171034-8hg1nnt","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611171034-vr4hq6z","Type":"NodeParagraph","Properties":{"id":"20240611171034-vr4hq6z","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 解离（《本经》），载君行（《本草蒙筌》），石解（《纲目》）。"}]},{"ID":"20240611171034-16rs5gx","Type":"NodeParagraph","Properties":{"id":"20240611171034-16rs5gx","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611171034-sza9k48","Type":"NodeParagraph","Properties":{"id":"20240611171034-sza9k48","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611171034-0noo8el","Type":"NodeParagraph","Properties":{"id":"20240611171034-0noo8el","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611171034-t5i25kr","Type":"NodeParagraph","Properties":{"id":"20240611171034-t5i25kr","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 为防己科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉防己"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木防己"},{"Type":"NodeText","Data":"及马兜铃科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"广防己"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异叶马兜铃"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋季采挖，洗净或刮去栓皮，切成长段，粗根纵剖为2～4瓣，晒干。异叶马兜铃根则在春、秋采挖。"}]},{"ID":"20240611171034-y7243ug","Type":"NodeParagraph","Properties":{"id":"20240611171034-y7243ug","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611171034-mrm8nbj","Type":"NodeParagraph","Properties":{"id":"20240611171034-mrm8nbj","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" ①粉防己，又名：石蟾蜍、山乌龟、汉防己、倒地拱、金丝吊鳖、白木香。"}]},{"ID":"20240611171034-gqwxdng","Type":"NodeParagraph","Properties":{"id":"20240611171034-gqwxdng","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"多年生缠绕藤本。根圆柱状，有时呈块状，外皮淡棕色或棕褐色。茎柔韧，圆柱形，有时稍扭曲，长达2.5～4米，具细条纹，枝光滑无毛，基部梢带红色。叶互生，质薄较柔，叶柄盾状着生，长与叶片相等；叶片外形近圆形，有3～5角，长4～6厘米，宽4.5～6厘米，先端锐尖，基部截形或稍心形，全缘，两面均被短柔毛，上面绿色，下面灰绿色。花小，蛑雄异株，为头状的聚伞花序，花梗长约0.5～1厘米；雄花花萼4，肉质，三角状，基部楔形，外面被毛，花瓣4，略呈半圆形，边缘微向内弯，具爪，雄蕊4，花药近圆形；雌花的花萼、花瓣与雄花同数，无退化雄蕊，心皮1，花柱3枚。核果球形，熟时红色，直径3～5毫米。花期4～5月。果期5～6月。"}]},{"ID":"20240611171034-970jn93","Type":"NodeParagraph","Properties":{"id":"20240611171034-970jn93","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"生于山野丘陵地、草丛或矮林边缘。分布浙江、安徽、江西、福建、广东、广西等地。"}]},{"ID":"20240611171034-bq4d45y","Type":"NodeParagraph","Properties":{"id":"20240611171034-bq4d45y","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②广防己，又名：防己马兜铃。"}]},{"ID":"20240611171034-ygxd7aq","Type":"NodeParagraph","Properties":{"id":"20240611171034-ygxd7aq","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"多年生攀援蘑本，长达3～4米。根部粗大，圆柱形，栓皮发达。茎细长少分枝，灰褐色或棕黑色，密生褐色绒毛。叶互生；叶柄长1～4厘米，密生褐色绒毛；叶片长圆形或卵状长圆形，长3～17厘米，宽2～6厘米，先端渐尖或钝，基部心形或圆形，全缘，幼时两面均被灰白色绒毛，后渐脱落，老时质稍厚，主脉3条，基出。花单生于叶腋，花梗长约1～2厘米，被棕色短毛，花被筒状，长约5厘米，紫色，上有黄色小斑点，舷部不分裂，平展，中部收缩成管状，略弯曲，外面被毛；雄蕊6，附于柱头裂片的外面，组成合蕊柱，花丝几无或甚短；柱头3裂。蒴果，种子多数。花期5～6月。果期7～8月。"}]},{"ID":"20240611171034-p1ea1v5","Type":"NodeParagraph","Properties":{"id":"20240611171034-p1ea1v5","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"生于荒山的山坡灌丛或疏林中。分布广东、广西等地。"}]},{"ID":"20240611171034-dw5mmnl","Type":"NodeParagraph","Properties":{"id":"20240611171034-dw5mmnl","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③木防己，又名：青藤香（《阳春县志》），小青藤、白山番薯、青檀香、青风藤、小葛藤。"}]},{"ID":"20240611171034-10mqy0x","Type":"NodeParagraph","Properties":{"id":"20240611171034-10mqy0x","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"缠绕性落叶藤本。根圆柱形。茎木质化，长达3米左右，小枝密被灰白色细柔毛。叶互生；叶柄长1～3厘米；叶片广卵形，有时3浅裂，长3～14厘米，宽2～9厘米，先端锐尖至钝圆，有短尖头，全缘或微波状，基部微心形至近截形；两面有灰褐色柔毛。花小，黄白色，雌雄异株，聚伞状圆锥花序腋生；雄花萼片6，2轮，卵形至广卵形；花瓣6，卵状披针形，先端2裂，基部两侧呈耳状；雄蕊6，药短，近球形；雌花的萼片、花瓣与雄花相似，有退化雄蕊6，心皮6，分离。核果近球形，直径5～8毫米，熟时蓝黑色，被白粉，内有1枚马蹄状种子。花期7～8月。果斯9～10月。"}]},{"ID":"20240611171034-89vli1r","Type":"NodeParagraph","Properties":{"id":"20240611171034-89vli1r","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"生于山坡、低地、丘陵地及路旁。分布河北、河南、陕西、山东、江苏、浙江、安徽、江西、湖北、四川、贵州、广东及福建等地。"}]},{"ID":"20240611171034-f4xuep6","Type":"NodeParagraph","Properties":{"id":"20240611171034-f4xuep6","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"本植物的茎叶（青檀香）亦供药用，另详专条。"}]},{"ID":"20240611171034-qj43fnu","Type":"NodeParagraph","Properties":{"id":"20240611171034-qj43fnu","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"④异叶马兜铃，又名：汉中防已。"}]},{"ID":"20240611171034-nrw19rj","Type":"NodeParagraph","Properties":{"id":"20240611171034-nrw19rj","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"攀援性半灌木，嫩枝密生黄褐色茸毛。叶互生，宽卵形，长4～20厘米，宽3～12厘米，基部心形，全缘，幼叶两面被柔毛，老后下面沿脉有毛；叶柄长2～10厘米，被黄褐色茸毛。花单生叶腋；花梗长2～6厘米，近中部着生一枚圆形苞片，被柔毛；花被长4～6厘米，密生短柔毛，筒部呈\"U\"字形弯曲，顶端3裂，裂片圆三角形，上面带紫色；雄蕊6，花药贴生于花柱体周围；子房下位，6室。蒴果黑褐色，长椭圆形，长3～7厘米，自基部开裂为6瓣，具多数种子。"}]},{"ID":"20240611171034-tcmhmah","Type":"NodeParagraph","Properties":{"id":"20240611171034-tcmhmah","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"生山坡灌丛中。分布西南及陕西、甘肃、湖南、湖北等地。"}]},{"ID":"20240611171034-0umqdr2","Type":"NodeParagraph","Properties":{"id":"20240611171034-0umqdr2","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611171034-awy2dkv","Type":"NodeParagraph","Properties":{"id":"20240611171034-awy2dkv","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" ①粉防己的干燥根呈圆柱形或半圆柱形或块状，多少弯曲，弯曲处有横沟而呈结节状的瘤块样，长10～15厘米，直径1～3厘米。未刮去栓皮者表面灰棕色，粗糙而多细皱，多数可见明显横向突起的皮孔，已刮除栓皮者，表面灰白色，较平滑，可见深色的横沟纹。切开面浅棕白色，粉质，维管束浅棕色，呈弯曲的横曲纹或皱纹。横断面平坦，有明显的浅棕色，呈弯曲的横曲纹或皱纹。质重而坚脆，易折断。气无，味苦。以去净栓皮，干燥，粗细均匀，质重，粉性大，纤维少者为仕。"}]},{"ID":"20240611171034-848wo2q","Type":"NodeParagraph","Properties":{"id":"20240611171034-848wo2q","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"主产浙江、安徽、江西、湖北等地。集散于汉口，故名汉防已。"}]},{"ID":"20240611171034-g1edlh3","Type":"NodeParagraph","Properties":{"id":"20240611171034-g1edlh3","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②广防己的干燥根呈圆柱形或半圆柱形，体稍弯曲，弯曲处有深横沟，长8～15厘米，直径1.5～4.5厘米。未刮栓皮者，表面棕色，粗糙，且多纵皱纹；有的只刮掉部分栓皮，露出灰黄色的皮层；栓皮全部刮掉者，表面灰黄色，较光滑。切开面灰白色或浅棕黄色，缺乏粉质，可见纵向及横向或弯曲排列的维管束，顺着维管束的方向，易呈刺片状剥下。质坚硬，不易折断。横断面可见细而较密的放射状纹。气微香，味微苦而涩。以块大、粗细均匀、质重者为佳。"}]},{"ID":"20240611171034-pbvh6vt","Type":"NodeParagraph","Properties":{"id":"20240611171034-pbvh6vt","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"产广东、广西等地。"}]},{"ID":"20240611171034-sumvu33","Type":"NodeParagraph","Properties":{"id":"20240611171034-sumvu33","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③木防己的干燥根呈圆柱形，屈曲不直。长约15厘米，直径1～2.5厘米。表面黑褐色，有深陷而扭曲的沟纹，可见横长的皮孔状物及除去支根的痕迹。质较坚硬，呈木质性，不易折断。断面黄白色，无粉质，皮部极薄，木部几全部木化，可见放射状狭窄的导管群穿过。气无，味微苦。"}]},{"ID":"20240611171034-nnhlwy6","Type":"NodeParagraph","Properties":{"id":"20240611171034-nnhlwy6","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"产于河南、陕西等地。部分地区仅草药中使用，参见\"黑皮青木香\"条。"}]},{"ID":"20240611171034-36whz0a","Type":"NodeParagraph","Properties":{"id":"20240611171034-36whz0a","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"④汉中防己为异叶马兜铃的根，呈圆柱形而弯曲。长8～15厘米，直径2～3厘米。通常均已除去外皮而呈浅棕黄色，残留的栓皮呈灰褐色，较平坦。质坚实，不易折断。断面黄白色，粉性，皮部较厚，木部可见放射状的导管群，导管群在中央方向多联合成1束，向外方2歧或3歧分叉。气微香，味苦。"}]},{"ID":"20240611171034-v21p1gq","Type":"NodeParagraph","Properties":{"id":"20240611171034-v21p1gq","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"产于陕西、甘肃、四川、贵州。"}]},{"ID":"20240611171034-5fg63e2","Type":"NodeParagraph","Properties":{"id":"20240611171034-5fg63e2","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611171034-7mnlhm5","Type":"NodeParagraph","Properties":{"id":"20240611171034-7mnlhm5","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" ①粉防己根含生物碱约1.2％，其中有汉防己碱、防己醇灵碱、一种酚性生物碱、门尼新碱、门尼定，以及轮环藤酚碱等。"}]},{"ID":"20240611171034-qa5figx","Type":"NodeParagraph","Properties":{"id":"20240611171034-qa5figx","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"粉防己的生物碱，曾有种种异名，汉防己碱曾名汉防已甲素，防己醇灵碱即去甲汉防己碱，亦曾名汉防己乙素，酚性生物碱即汉防己丙素。门尼新碱原称木防己素甲，门尼定原称木防己素乙，分别为汉防己碱和去甲汉防己碱的异构物。"}]},{"ID":"20240611171034-7b6cedy","Type":"NodeParagraph","Properties":{"id":"20240611171034-7b6cedy","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"粉防已根尚含黄酮甙、酚类、有机酸、挥发油等。"}]},{"ID":"20240611171034-jkymejr","Type":"NodeParagraph","Properties":{"id":"20240611171034-jkymejr","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②木防己根含木防已碱、异木防己碱、木兰花碱、木防己胺、木防己宾碱、甲门尼萨任碱、去甲门尼萨任碱等多种生物碱"}]},{"ID":"20240611171034-isu80w0","Type":"NodeParagraph","Properties":{"id":"20240611171034-isu80w0","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611171034-4u3x45z","Type":"NodeParagraph","Properties":{"id":"20240611171034-4u3x45z","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" ①粉防己：㈠镇痛作用"}]},{"ID":"20240611171034-upvlrqh","Type":"NodeParagraph","Properties":{"id":"20240611171034-upvlrqh","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"用小鼠热板法测得汉防己总碱及汉防己甲素、乙素、丙素均有镇痛作用。总碱的作用最强，其有效剂量为50毫克／公斤，半数致死量则为241～251毫克／公斤。汉防己丙素镇痛作用较甲素、乙素为强，但毒性亦较大，故无实用价值。用电刺激小鼠尾巴法也证明，甲素、乙素以及汉防己流浸膏或煎荆皆具有一定的镇痛作用，甲素的作用强于乙素，其有效剂量大于吗啡的10～20倍。如以吗啡的镇痛效力为100时，则汉防己总碱约为13，延胡索总碱约为40，当后二者合用时，镇痛效力不但不增加，反而减弱。抗组织胺药物苯海拉明却可显著增强甲素及乙素的镇痛作用，而不影响其毒性。有报告超过一定剂量，汉防己的镇痛作用反而减弱甚至消失，这可能是由于较大剂量的甲素能兴奋中枢神经系统，因而削弱了镇痛作用。而国外报道，甲素对小鼠需100～250毫克／公斤方可升高痛阈7～10％。临床上30毫克口服或皮下注射，镇痛作用不显著。"}]},{"ID":"20240611171034-e9pt1nq","Type":"NodeParagraph","Properties":{"id":"20240611171034-e9pt1nq","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"㈡消炎及抗过敏作用"}]},{"ID":"20240611171034-dc0ccww","Type":"NodeParagraph","Properties":{"id":"20240611171034-dc0ccww","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"汉防己甲素、乙素对大鼠甲醛性关节炎均有一定的消炎作用；甲素的作用强于乙素。在这方面，甲素的作用与考的松相似，强于水杨酸钠，弱于保泰松。在切除肾上腺后，作用消失。它可使大鼠肾上腺中维生素C含量降低，末梢血液中的嗜酸性细胞减少；在切除脑下垂体后7天再给甲素，仍有此作用，故为直接作用于肾上腺。对正常大鼠连续给甲素7天，则肾上腺中维生素C含量即不降低，二侧肾上腺也无肥大现象，尿中17-羟类甾醇的排出量亦不增加，说明它兴奋肾上腺皮质的作用是非特异性的。汉防己甲素对家兔的实验性耳壳烧伤也有抗炎作用；在大鼠皮肤台盼蓝试验中，能降低血管通透性。对用全蛋清所引起的家兔过敏性休克，能明显的降低严重休克症状的发生率，但对死亡率则无明显影响，对豚鼠组织胺休克，并无作用。另可抑制免疫性溶血。也有报告，它和抗原性物质一样，能激活淋巴结，增加浆母细胞及浆细胞的核糖核酸的重量及浓度，并引起此等细胞之增多。由于它有轻度镇痛、消炎以及解热、抗过敏性休克等作用，故应属于解热镇痛剂。"}]},{"ID":"20240611171034-bo5hnbg","Type":"NodeParagraph","Properties":{"id":"20240611171034-bo5hnbg","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"㈢对循环系统的作用"}]},{"ID":"20240611171034-frjknz6","Type":"NodeParagraph","Properties":{"id":"20240611171034-frjknz6","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"在麻醉猫身上，汉防己甲素有显著的降压作用，3～6毫克／公斤可使血压下降50～65％达1小时以上。静脉、肌肉注射或口服均有作用。降压时心收缩力仅有短暂的削弱，心率及传导无显着变化。在离体及连神经兔耳标本上，皆可见到血管的扩张，较罂粟碱强而持久。能加强和延长乙酰胆碱的降压作用，抑制或减弱压迫颈总动脉引起的升压反应。阿托品可部分取消甲素的降压作用。对停跳心脏，亦能明显增加冠脉流量。对豚鼠、"}]},{"ID":"20240611171034-llvrcgz","Type":"NodeParagraph","Properties":{"id":"20240611171034-llvrcgz","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"㈣对横纹肌的作用"}]},{"ID":"20240611171034-i5rqzuc","Type":"NodeParagraph","Properties":{"id":"20240611171034-i5rqzuc","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"汉防己甲素及其若干同类物有松弛横纹肌的作用。"}]},{"ID":"20240611171034-paup454","Type":"NodeParagraph","Properties":{"id":"20240611171034-paup454","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"㈤对平滑肌的作用"}]},{"ID":"20240611171034-e4supo7","Type":"NodeParagraph","Properties":{"id":"20240611171034-e4supo7","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"早年报告，汉防己甲素能抑制兔离体小肠秘豚鼠或兔的子宫平滑肌。实际上，此与剂量有关。对离体兔肠是先兴奋而后抑制，较大剂量可部分抑制由毛果芸香碱，氯化钡引起的痉挛性牧缩。对兔离体及在位子宫作用并不显著。对豚鼠、猫的支气管平滑肌引起收缩，此乃由于组织胺的释放所引起。丙素能使离体兔、豚鼠小肠及在体兔肠平滑肌张力增加，收缩振幅减小。"}]},{"ID":"20240611171034-fi4me9v","Type":"NodeParagraph","Properties":{"id":"20240611171034-fi4me9v","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"㈥抗菌、抗原虫、抗肿瘤作用"}]},{"ID":"20240611171034-d9lrhl9","Type":"NodeParagraph","Properties":{"id":"20240611171034-d9lrhl9","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"汉防己在试管中有某些抗菌（痢疾杆菌）、抗真菌作用，但品种未经鉴定，浓度也比较高。汉防己甲素在体外及体内（小鼠盲肠法）均有抑制或杀灭溶组织阿米巴的作用，其强度为依米丁的1／22，但超过小檗碱.甲素在1：4000时，在体外可杀癌细胞，30～50毫克／公斤腹腔注射或100毫克／公斤皮下注射（半数致死量为950毫克／公斤），可抑制小鼠艾氏腹水癌细胞及大鼠腹水肝癌细胞。"}]},{"ID":"20240611171034-o2sgcz4","Type":"NodeParagraph","Properties":{"id":"20240611171034-o2sgcz4","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"㈦其他作用"}]},{"ID":"20240611171034-3mioenj","Type":"NodeParagraph","Properties":{"id":"20240611171034-3mioenj","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"汉防己碱对犬呈催眠作用，与阿朴吗啡无拮抗作用；使家兔中性白细胞显著增加，淋巴细胞则减少。木防己素甲、乙和汉防己碱都能使鸽呕吐。汉防己丙素有兴奋中枢神经系统的作用，小剂量可致呼吸兴奋，反射亢进；中毒剂量则使小鼠发生阵挛性惊厥，死于呼吸衰竭，苯巴比妥有拮抗作用，对注射大肠杆菌肉汤而发热的大鼠，有解热作用；不引起动物呕吐。"}]},{"ID":"20240611171034-weu0mpg","Type":"NodeParagraph","Properties":{"id":"20240611171034-weu0mpg","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②木防己：木防己碱对发热家兔有降温作用，能使兔血压下降，血管收缩；麻痹蛙的心肌及骨胳肌。小量增强小肠，子宫的收缩，大量则麻痹之。对家兔氮代谢无明显影响，可增进犬的淋巴形成；能麻痹草履虫。对破伤风、白喉、肉毒杆菌的外毒素以及河豚毒素对小鼠的致死作用有某些保护作用。对家兔的最小致死量，静脉注射为0.05克／公斤，皮下注射为0.15克／公斤。对蛙、小鼠皮下注射的最小致死量为0.5～1.0克／公斤，可引起动物运动麻痹及偶而惊厥，死于呼吸衰竭。"}]},{"ID":"20240611171034-4mgnni3","Type":"NodeParagraph","Properties":{"id":"20240611171034-4mgnni3","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"非生物碱成分木防己甲素50毫克／公斤或乙素200毫克／公斤，对大鼠无退热作用（大肠杆菌肉汤注射引起之发热）。用小鼠热板法，证明甲素、乙素并无镇痛作用。甲素静脉注射对小鼠的半数致死量为76毫克／公斤，乙素毒性很低。广玉兰碱之作用参见\"青木香\"条。"}]},{"ID":"20240611171034-0kz61id","Type":"NodeParagraph","Properties":{"id":"20240611171034-0kz61id","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611171034-w0h4rul","Type":"NodeParagraph","Properties":{"id":"20240611171034-w0h4rul","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 原药用水洗净，捞出润透，切片，晒干。"}]},{"ID":"20240611171034-4qqas6g","Type":"NodeParagraph","Properties":{"id":"20240611171034-4qqas6g","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"夫使防己，要心花文黄色者，细锉，又锉车前草根相对同蒸半日后，出、晒，去车前草根，细锉用之。\""}]},{"ID":"20240611171034-ushsad6","Type":"NodeParagraph","Properties":{"id":"20240611171034-ushsad6","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"今人多去皮，锉，酒洗晒干用。\""}]},{"ID":"20240611171034-kfakhig","Type":"NodeParagraph","Properties":{"id":"20240611171034-kfakhig","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611171034-oo96vai","Type":"NodeParagraph","Properties":{"id":"20240611171034-oo96vai","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 入膀胱、脾、肾经。"}]},{"ID":"20240611171034-505amx7","Type":"NodeParagraph","Properties":{"id":"20240611171034-505amx7","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"①《本草通玄》：\"入太阳。\""}]},{"ID":"20240611171034-iw6qblg","Type":"NodeParagraph","Properties":{"id":"20240611171034-iw6qblg","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入肾。\""}]},{"ID":"20240611171034-0zmeym1","Type":"NodeParagraph","Properties":{"id":"20240611171034-0zmeym1","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、脾、肾三经。\""}]},{"ID":"20240611171034-eo8g63a","Type":"NodeParagraph","Properties":{"id":"20240611171034-eo8g63a","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611171034-h59ujzs","Type":"NodeParagraph","Properties":{"id":"20240611171034-h59ujzs","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611171034-pmejk42","Type":"NodeParagraph","Properties":{"id":"20240611171034-pmejk42","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240611171034-2avxwtb","Type":"NodeParagraph","Properties":{"id":"20240611171034-2avxwtb","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"汉防己：味苦，有小毒。木防己：味苦辛。\""}]},{"ID":"20240611171034-eklhb9c","Type":"NodeParagraph","Properties":{"id":"20240611171034-eklhb9c","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"气寒，味大苦。\""}]},{"ID":"20240611171034-e66c4e0","Type":"NodeParagraph","Properties":{"id":"20240611171034-e66c4e0","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611171034-7u3jl1o","Type":"NodeParagraph","Properties":{"id":"20240611171034-7u3jl1o","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 阴虚而无湿热者慎服。"}]},{"ID":"20240611171034-clz7ro5","Type":"NodeParagraph","Properties":{"id":"20240611171034-clz7ro5","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"殷孽为之使。恶细辛。畏萆薢。杀雄黄毒。\""}]},{"ID":"20240611171034-xsesl9k","Type":"NodeParagraph","Properties":{"id":"20240611171034-xsesl9k","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"木防己：畏女菀、卤咸。\""}]},{"ID":"20240611171034-hoojdq6","Type":"NodeParagraph","Properties":{"id":"20240611171034-hoojdq6","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③李杲：\"上焦湿热者，不可用。\""}]},{"ID":"20240611171034-k1a1tv9","Type":"NodeParagraph","Properties":{"id":"20240611171034-k1a1tv9","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"凡胃虚阴虚，自汗盗汗，口苦舌干，肾虚小水不利，及胎前产后血虚，虽有下焦置热，均忌。\""}]},{"ID":"20240611171034-8t646d7","Type":"NodeParagraph","Properties":{"id":"20240611171034-8t646d7","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑤《得配本草》：\"气分风热，小便不通，禁用。\""}]},{"ID":"20240611171034-oi3gjr5","Type":"NodeParagraph","Properties":{"id":"20240611171034-oi3gjr5","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611171034-7fb1gc8","Type":"NodeParagraph","Properties":{"id":"20240611171034-7fb1gc8","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 行水，泻下焦湿热。治水肿臌胀，湿热脚气，手足挛痛，癣疥疮肿。"}]},{"ID":"20240611171034-fttfszt","Type":"NodeParagraph","Properties":{"id":"20240611171034-fttfszt","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主风寒温疟，热气诸痫。除邪，利大小便。\""}]},{"ID":"20240611171034-6wjs5fw","Type":"NodeParagraph","Properties":{"id":"20240611171034-6wjs5fw","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗水肿、风肿，去膀胱热，伤寒寒热邪气，中风手脚挛急，止泄，散痈肿恶结，（治）诸瘑疥癣虫疮，通腠理，利九窍。\""}]},{"ID":"20240611171034-xgw7c6m","Type":"NodeParagraph","Properties":{"id":"20240611171034-xgw7c6m","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③《药性沦》：\"汉防己：治湿风口面歪斜，手足疼，散留痰，主肺气嗽喘。木防己：治男子肢节中风毒风不语，主散结气痈肿，温疟，风水肿，治膀胱。\""}]},{"ID":"20240611171034-k3jgd6i","Type":"NodeParagraph","Properties":{"id":"20240611171034-k3jgd6i","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"疗胸中（《本草发挥》引’胸中’作’腰’）以下至足湿热肿盛、脚气，去留热。\""}]},{"ID":"20240611171034-5ct3gny","Type":"NodeParagraph","Properties":{"id":"20240611171034-5ct3gny","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑤《医林纂要》：\"泻心，坚肾，燥脾湿，功专行水决渎，以达于下。\""}]},{"ID":"20240611171034-syqml3j","Type":"NodeParagraph","Properties":{"id":"20240611171034-syqml3j","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"利湿，除风，解火，破血。治膀胱水肿，健脾胃，化痰。\""}]},{"ID":"20240611171034-wn8luhv","Type":"NodeParagraph","Properties":{"id":"20240611171034-wn8luhv","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611171034-dgmyho4","Type":"NodeParagraph","Properties":{"id":"20240611171034-dgmyho4","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240611171034-esjivvt","Type":"NodeParagraph","Properties":{"id":"20240611171034-esjivvt","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611171034-9l8rk4y","Type":"NodeParagraph","Properties":{"id":"20240611171034-9l8rk4y","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" ①治皮水为病，四肢肿，水气在皮肤中，四肢聂聂动者：防已三两，黄芪三两，桂枝三两，茯苓六两，甘草二两。上五味，以水六升，煮取二升，分温三服。（防己茯苓汤）"}]},{"ID":"20240611171034-2a31y32","Type":"NodeParagraph","Properties":{"id":"20240611171034-2a31y32","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"②治风水脉浮，身重汗出恶风者：防己一两，甘草半两（炒），白术七钱半，黄芪一两一分（去芦）。上锉麻豆大，每抄五钱匕，生姜四片，大枣一枚，水盏半，煎八分，去滓。温服，良久再服。服后当如虫行皮中，从腰下如冰，后坐被上，又以一被绕腰下，温令微汗。（防己黄芪汤）"}]},{"ID":"20240611171034-1ad79kk","Type":"NodeParagraph","Properties":{"id":"20240611171034-1ad79kk","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"③治膈间支饮，其人喘满，心下痞坚，面色黧黑，其脉沉紧，得之数十日，医吐下之不愈：木防己三两，石膏十二枚（鸡子大），桂枝二两，人参四两。上四味，以水六升，煮取二升，分温再服。（木防己汤，①方以下出《金匮要略》）"}]},{"ID":"20240611171034-p866zer","Type":"NodeParagraph","Properties":{"id":"20240611171034-p866zer","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"④治膀胱水蓄胀满，几成水肿：汉防己二钱，车前、韭菜子、泽泻各三钱。水煎服。（《本草切要》）"}]},{"ID":"20240611171034-peche9g","Type":"NodeParagraph","Properties":{"id":"20240611171034-peche9g","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑤治水臌胀：汉防己一两，生姜五钱。同炒，随入水煎服，半饥时饮之。（《本草汇言》）"}]},{"ID":"20240611171034-71bcbxs","Type":"NodeParagraph","Properties":{"id":"20240611171034-71bcbxs","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑥治脚气肿痛：汉防己、木瓜、牛膝各三钱，桂枝五分，枳壳一钱。水煎服。（《本草切要》）"}]},{"ID":"20240611171034-mkstb08","Type":"NodeParagraph","Properties":{"id":"20240611171034-mkstb08","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑦治肺痿喘嗽：汉防己为细末。每服三钱，浆水一盏，同煎至七分，和滓温服之。（《儒门事亲》）"}]},{"ID":"20240611171034-gz9h087","Type":"NodeParagraph","Properties":{"id":"20240611171034-gz9h087","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑧治肺痿咯血多痰者：汉防己、葶苈等分。为末。糯米饮，每服一钱。（《古今录验方》）"}]},{"ID":"20240611171034-auvoieh","Type":"NodeParagraph","Properties":{"id":"20240611171034-auvoieh","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑨治遍身虫癣瘑疥：汉防己三两，当归、黄芪各二两，金银花一两。煮酒饮之。（《本草切要》）"}]},{"ID":"20240611171034-cjll9be","Type":"NodeParagraph","Properties":{"id":"20240611171034-cjll9be","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"⑩治遗尿，小便涩：防己、葵子、防风各一两。上三味，以水五升，煮取二升半，分三服，散服亦佳。（《千金方》）"}]},{"ID":"20240611171034-mnrthq4","Type":"NodeParagraph","Properties":{"id":"20240611171034-mnrthq4","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611171034-wd3mr5c","Type":"NodeParagraph","Properties":{"id":"20240611171034-wd3mr5c","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 治疗高血压病:从汉防己中提出的生物碱-汉防己甲素，具有降压作用。一般用片剂口服，每日120毫克，3次分服；血压过高者，增至每日180毫克。据110例Ⅱ期及Ⅲ期患者观察，经用药2～7个月后，显效13例，有效26例，一般疗效24例，无效47例，总有效率为55％。亦可采用注射剂行静脉注射，每次120毫克，每日2次；据200余例使用结果，疗效较口服片剂明显，作用较快，且无突然大幅度下降之反应，故为治疗高血压急症有效而稳妥之制剂。"}]},{"ID":"20240611171034-ascki9v","Type":"NodeParagraph","Properties":{"id":"20240611171034-ascki9v","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611171034-v9jaffo","Type":"NodeParagraph","Properties":{"id":"20240611171034-v9jaffo","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 防己药材较为复杂，主要分粉防己和木防己两类。木防己药材包括广防己和汉中防已，有时也包括防己科的木防己。其中汉中防己，即《唐本草》所说\"出汉中者\"。此外，个别地区尚有以防己科植物青藤（参见\"青风藤\"条）、蝙蝠葛（参见\"蝙蝠葛根\"条）和马兜铃科植物淮通马兜铃（参见\"淮通\"条）、大叶马兜铃（参见\"朱砂莲\"条）等的根部作防己使用。"}]},{"ID":"20240611171034-s011gqm","Type":"NodeParagraph","Properties":{"id":"20240611171034-s011gqm","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611171034-3izufh9","Type":"NodeParagraph","Properties":{"id":"20240611171034-3izufh9","updated":"20240611171034"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611171035-xe1cv80","Type":"NodeThematicBreak","Properties":{"id":"20240611171035-xe1cv80"}},{"ID":"20240611171036-fzcikbb","Type":"NodeParagraph","Properties":{"id":"20240611171036-fzcikbb"}}]}