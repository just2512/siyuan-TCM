-20240826131805-p31yg5t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 309px;\" parent-style=\"width: 319px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 320px;","style":"width: 310px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫花 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫花 10-20240826131916-m97eed2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 310px;\" parent-style=\"width: 320px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 333px;","style":"width: 323px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫花 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫花 11-20240826132032-lgqed8w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 323px;\" parent-style=\"width: 333px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826130423-e208jjv","Type":"NodeParagraph","Properties":{"id":"20240826130423-e208jjv","updated":"20240826132200"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 344px;","style":"width: 334px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫花7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫花7-20240702105455-w3c1jxg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 334px;\" parent-style=\"width: 344px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 384px;","style":"width: 374px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫花 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫花 12-20240826132155-sfe0lu9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 374px;\" parent-style=\"width: 384px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 521px;","style":"width: 511px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芫花 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芫花 8-20240826131144-huidg1i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 511px;\" parent-style=\"width: 521px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613123839-fuxxj42","Type":"NodeThematicBreak","Properties":{"id":"20240613123839-fuxxj42"}},{"ID":"20240613124615-04aj1u0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124615-04aj1u0","updated":"20240613124619"},"Children":[{"Type":"NodeText","Data":"芫花《本草备要》"}]},{"ID":"20240613124615-093v9yf","Type":"NodeParagraph","Properties":{"id":"20240613124615-093v9yf","updated":"20240613124615"},"Children":[{"Type":"NodeText","Data":"大通，行水"}]},{"ID":"20240613124615-lcajekz","Type":"NodeParagraph","Properties":{"id":"20240613124615-lcajekz","updated":"20240613124615"},"Children":[{"Type":"NodeText","Data":"苦寒有毒。去水饮痰癖。"}]},{"ID":"20240613124615-d78o2bj","Type":"NodeParagraph","Properties":{"id":"20240613124615-d78o2bj","updated":"20240613124615"},"Children":[{"Type":"NodeText","Data":"疗五水在五脏、皮肤，胀满喘急，痛引胸胁，咳嗽瘴疟（五水者，风水、皮水、正水、石水、黄汗也。水积胸中，坚满如石，名石水。汗如柏汁，名黄汗，久不愈必致痈脓。时珍曰∶仲景治伤寒太阳证，表未解，心下有水而咳，干呕发热，或喘或利者，小青龙汤主之。"}]},{"ID":"20240613124615-o5n7zsq","Type":"NodeParagraph","Properties":{"id":"20240613124615-o5n7zsq","updated":"20240613124615"},"Children":[{"Type":"NodeText","Data":"表已解，有时头痛，汗出恶寒，心下有水，干呕，痛引两胁，或喘或嗽者，十枣汤主之。盖青龙散表邪，使水从汗出，《内经》所谓开鬼门也；十枣逐里邪，使水从两便出，《内经》所谓洁净府、去陈 法也。十枣汤∶芫花、甘遂、大戟等分，枣十枚）。"}]},{"ID":"20240613124615-93teja3","Type":"NodeParagraph","Properties":{"id":"20240613124615-93teja3","updated":"20240613124615"},"Children":[{"Type":"NodeText","Data":"叶似柳，二月开花紫碧色，叶生花落。陈久者良。醋煮过，水浸曝用。根疗疥，可毒鱼。反甘草（斗讼者，取叶擦皮肤，辄作赤肿，假伤以诬人）。"}]},{"ID":"20240613123839-41k939m","Type":"NodeThematicBreak","Properties":{"id":"20240613123839-41k939m"}},{"ID":"20240613124602-q5q9v5o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124602-q5q9v5o","updated":"20240613124607"},"Children":[{"Type":"NodeText","Data":"芫花《得配本草》"}]},{"ID":"20240613124602-l0m5cre","Type":"NodeParagraph","Properties":{"id":"20240613124602-l0m5cre","updated":"20240613124602"},"Children":[{"Type":"NodeText","Data":"得醋良。决明为之使。反甘草。"}]},{"ID":"20240613124602-42rpb0v","Type":"NodeParagraph","Properties":{"id":"20240613124602-42rpb0v","updated":"20240613124602"},"Children":[{"Type":"NodeText","Data":"辛、苦，温。有毒。入手太阴经。逐水饮痰癖，从至高之分，而直达下焦。治五水在五脏，皮肤胀满，喘急咳嗽，胸胁腰痛。并疗风痹瘴疟，亦可毒鱼。（五水者，风水、皮水、正水、石水、黄汗也。）得朱砂，蜜丸枣汤下，治久疟结癖。配椒目，等分烧末水服，治酒疸、尿黄，心懊痛，足胫满。配大枣、芒硝，治水肿支饮。青布浸汁覆胸，治天行烦乱。捣汁浸线一夜，可击落痔疮。数年陈久者良。以醋煮十余沸，去醋，水浸一宿，晒干用，则毒灭，或以醋炒者次之。少用取效甚捷，多用损人真元。虚者误服，必致夭折。"}]},{"ID":"20240613124058-lpg7i8g","Type":"NodeThematicBreak","Properties":{"id":"20240613124058-lpg7i8g"}},{"ID":"20240613124552-u16azk8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124552-u16azk8","updated":"20240613124556"},"Children":[{"Type":"NodeText","Data":"芫花《本经逢原》"}]},{"ID":"20240613124552-e96sim7","Type":"NodeParagraph","Properties":{"id":"20240613124552-e96sim7","updated":"20240613124552"},"Children":[{"Type":"NodeText","Data":"苦辛温，有毒。陈者良。水浸一宿晒干，醋炒以去其毒。弘景曰∶用者微熬，不可近眼，反甘草。"}]},{"ID":"20240613124552-dngucy1","Type":"NodeParagraph","Properties":{"id":"20240613124552-dngucy1","updated":"20240613124552"},"Children":[{"Type":"NodeText","Data":"《本经》主咳逆上气，喉鸣咽肿短气，蛊毒鬼疟，疝瘕痈肿，杀虫鱼。"}]},{"ID":"20240613124552-9r6lu3l","Type":"NodeParagraph","Properties":{"id":"20240613124552-9r6lu3l","updated":"20240613124552"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"芫花消痰饮水肿，故《本经》治咳逆，咽肿疝瘕痈毒，皆是痰湿内壅之象。仲景治伤寒表不解，心下有水气，干呕发热而咳，或喘，或利者，小青龙汤主之。若表已解，有时头痛汗出恶寒，心下有水气，干呕痛引两胁，或喘或咳者，十枣汤主之。盖小青龙汤驱逐表邪，使水气从毛窍而出，《内经》开鬼门法也。十枣汤驱逐里邪，使水气从大小便而泄，《内经》洁净府、去菀陈法也。芫花、大戟、甘遂之性，逐水泻湿，能直达水饮窠囊隐僻处，取效甚捷，不可过剂，泄人真元。"}]},{"ID":"20240613124059-oknk6mc","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-oknk6mc"}},{"ID":"20240613124540-tht70f3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124540-tht70f3","updated":"20240613124544"},"Children":[{"Type":"NodeText","Data":"芫花《本草撮要》"}]},{"ID":"20240613124540-q5wr3jx","Type":"NodeParagraph","Properties":{"id":"20240613124540-q5wr3jx","updated":"20240613124540"},"Children":[{"Type":"NodeText","Data":"味辛温．入足太阳经．功专泄水．治心腹胀满．水气寒痰．得大戟、甘遂为赘瘤焦法．得大黄、甘草、大枣、芒硝治水肿支饮．陈久者良．醋煮过．水浸曝用．根疗疥子毒鱼．反甘草．讼者取叶擦皮肤辄作赤肿假伤以诬人．虚者服必夭折．惟十枣汤用之为君药．"}]},{"ID":"20240613124059-v6a9jdt","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-v6a9jdt"}},{"ID":"20240613124530-s3c547u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124530-s3c547u","updated":"20240613124535"},"Children":[{"Type":"NodeText","Data":"芫花《药征》"}]},{"ID":"20240613124530-rel4wnk","Type":"NodeParagraph","Properties":{"id":"20240613124530-rel4wnk","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"主逐水也。旁治咳掣痛。"}]},{"ID":"20240613124530-mv0tzeb","Type":"NodeParagraph","Properties":{"id":"20240613124530-mv0tzeb","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240613124530-qtcz680","Type":"NodeParagraph","Properties":{"id":"20240613124530-qtcz680","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"十枣汤证曰∶引胁下痛。又曰∶咳。"}]},{"ID":"20240613124530-f3q32t2","Type":"NodeParagraph","Properties":{"id":"20240613124530-f3q32t2","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"张仲景氏用芫花，莫过于十枣汤也。为则试服芫花一味，必大泻水。则其逐水也明矣。"}]},{"ID":"20240613124530-mmny7sh","Type":"NodeParagraph","Properties":{"id":"20240613124530-mmny7sh","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"【辨误】"}]},{"ID":"20240613124530-9by75cr","Type":"NodeParagraph","Properties":{"id":"20240613124530-9by75cr","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"本草芫花条。慎微曰∶《三国志》云∶魏初平中，有青牛先生常服芫花，年百余岁，常如五六十。时珍曰∶芫花乃下品毒物，岂堪久服，此方外迂怪之言，不足信也。为则曰∶方外迂怪之说，固无论于疾医之道也。下品毒物，岂堪久服，时珍过矣！时珍过矣！有病毒而毒药以攻之，岂不堪久服邪？学人勿眩焉。"}]},{"ID":"20240613124530-qy1i3z1","Type":"NodeParagraph","Properties":{"id":"20240613124530-qy1i3z1","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240613124530-9fjvaue","Type":"NodeParagraph","Properties":{"id":"20240613124530-9fjvaue","updated":"20240613124530"},"Children":[{"Type":"NodeText","Data":"芫花 汉产为良。本邦亦出焉。本邦所产，今之所鬻者，颇多伪也，不可不正矣。本邦俗称志计武志，是真芫花也。"}]},{"ID":"20240613124425-vb3cdap","Type":"NodeThematicBreak","Properties":{"id":"20240613124425-vb3cdap"}},{"ID":"20240613124517-54g4ts2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124517-54g4ts2","updated":"20240613124522"},"Children":[{"Type":"NodeText","Data":"芫花《本草择要纲目》"}]},{"ID":"20240613124517-39tlu0j","Type":"NodeParagraph","Properties":{"id":"20240613124517-39tlu0j","updated":"20240613124517"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240613124517-414n59h","Type":"NodeParagraph","Properties":{"id":"20240613124517-414n59h","updated":"20240613124517"},"Children":[{"Type":"NodeText","Data":"苦温有大毒．"}]},{"ID":"20240613124517-rhhg33i","Type":"NodeParagraph","Properties":{"id":"20240613124517-rhhg33i","updated":"20240613124517"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240613124517-dajw9o7","Type":"NodeParagraph","Properties":{"id":"20240613124517-dajw9o7","updated":"20240613124517"},"Children":[{"Type":"NodeText","Data":"凡人饮有五．症由内啜水浆．外受湿气．郁蓄而为留饮．流于肺则为支饮．令人喘咳寒热．吐沫背寒．流于肝则为悬饮．令人咳唾痛引缺盆两胁．流于心下则为伏饮．令人胸满呕吐．寒热眩晕．流于肠胃则为痰饮．令人腹鸣吐水．胸胁支满．或作泄泻．忽肥忽瘦．流于经络则为溢饮．令人沉重注痛．或作水气腑肿．芫花之性．逐水泄湿．能直达水饮窠囊隐僻之处．经所谓开鬼门洁净府之法也．但其性甚猛捷．不可轻用损人真元也．"}]},{"ID":"20240613124425-9tu7mi4","Type":"NodeThematicBreak","Properties":{"id":"20240613124425-9tu7mi4"}},{"ID":"20240613124456-c32l1sm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124456-c32l1sm","updated":"20240613124500"},"Children":[{"Type":"NodeText","Data":"芫花《本草述钩元》"}]},{"ID":"20240613124456-ugvmenm","Type":"NodeParagraph","Properties":{"id":"20240613124456-ugvmenm","updated":"20240613124456"},"Children":[{"Type":"NodeText","Data":"在处有之。茎干不全类木。亦非草本。高二三尺。正二月旧枝抽苗作花。有紫赤黄白种。三月花落尽。叶乃生。似柳而青。渐浓则转黑。根皮黄。似桑根。三月采花。必于叶生时。叶生花落。即不堪用。五月采叶。八九月采根。据图经。荛花恐即芫花。说详纲味辛苦。气微温。有小毒。内搜肠胃。外达毛孔。决明为之使。反甘草。主咳逆上气。"}]},{"ID":"20240613124456-n8lfvni","Type":"NodeParagraph","Properties":{"id":"20240613124456-n8lfvni","updated":"20240613124456"},"Children":[{"Type":"NodeText","Data":"在五花开鬼内于流令徐通〔论〕芫花春月生苗。其花随吐。尽春而落。全禀风木之气。以致其用于水气。本经首主辛温气所不而气海藏云。水者肺脾肾三经所主。有脏腑十二经部分。上而头。中而四肢。下而腰脚。外而皮方可用。"}]},{"ID":"20240613124456-ybn3zcf","Type":"NodeParagraph","Properties":{"id":"20240613124456-ybn3zcf","updated":"20240613124456"},"Children":[{"Type":"NodeText","Data":"〔修治〕留数年陈久者良。用时以好醋煮十数沸。去醋。水浸一宿。晒干。如是则毒减。"}]},{"ID":"20240613124425-3b83973","Type":"NodeThematicBreak","Properties":{"id":"20240613124425-3b83973"}},{"ID":"20240613124438-6bxt1eo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124438-6bxt1eo","updated":"20240613124450"},"Children":[{"Type":"NodeText","Data":"芫花《冯氏锦囊秘录》"}]},{"ID":"20240613124438-pd0lm7e","Type":"NodeParagraph","Properties":{"id":"20240613124438-pd0lm7e","updated":"20240613124438"},"Children":[{"Type":"NodeText","Data":"味苦，温，有毒。入脾。肺、肾三经。性反甘草，同大戟、甘遂，能直达水饮窠囊隐癖之处。然毒性至紧，外达皮毛，内泄肠胃，取效极捷，虚人误用，用多至夭折。"}]},{"ID":"20240613124438-f6ksh85","Type":"NodeParagraph","Properties":{"id":"20240613124438-f6ksh85","updated":"20240613124438"},"Children":[{"Type":"NodeText","Data":"芫花，有小毒，反甘草。散皮肤水肿发浮，消胸膈痰冰，善唾咳逆上气，能止咽肿，短气可安。驱疝瘕痈疽，除鬼疟虫毒，汁渍丝线系痔易落，久服不易，令人虚损。"}]},{"ID":"20240613124438-z90h03w","Type":"NodeParagraph","Properties":{"id":"20240613124438-z90h03w","updated":"20240613124438"},"Children":[{"Type":"NodeText","Data":"根名蜀桑尤毒，止可毒鱼敷疥。"}]},{"ID":"20240613124426-0qtkzaf","Type":"NodeThematicBreak","Properties":{"id":"20240613124426-0qtkzaf"}},{"ID":"20240613124427-fkmjuia","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124427-fkmjuia","updated":"20240613124432"},"Children":[{"Type":"NodeText","Data":"芫花《本草简要方》"}]},{"ID":"20240613124427-rihfxvp","Type":"NodeParagraph","Properties":{"id":"20240613124427-rihfxvp","updated":"20240613124427"},"Children":[{"Type":"NodeText","Data":"主治。咳逆上气。喘急。寒痰水饮。咽肿。牙痛。心腹胀满。四肢挛急恶疮痈疽。芫花丸。芫花（醋炒）一两。牛膝野狼牙根桔梗（炒黄）藜芦（炒）槟榔各一两五钱。巴豆（炒黑）十粒研末。醋煮米糊和丸赤豆大。每服二三丸。加至五七丸。食前生姜汤下。治饮癖酒瘕。常服化痰消坚杀虫。芫花散。芫花（醋炒）吴茱萸秦艽白僵蚕柴胡川乌巴戟研末。温酒调下。治妇人鬼胎。形如抱瓮。"}]},{"ID":"20240613124427-jfvtvzm","Type":"NodeParagraph","Properties":{"id":"20240613124427-jfvtvzm","updated":"20240613124427"},"Children":[{"Type":"NodeText","Data":"凝雪汤。芫花一斤。水三升煎取一升半。渍故布上薄胸间。不过再三。薄热则除。治天行毒病七八日热积胸中烦乱欲死。芫根膏。芫根一两。黑豆三合。猪牙皂角五梃。醋一斗。"}]},{"ID":"20240613124427-cfst4o7","Type":"NodeParagraph","Properties":{"id":"20240613124427-cfst4o7","updated":"20240613124427"},"Children":[{"Type":"NodeText","Data":"先浸釜中三日。以火煎二升去滓。再入铛中煎至一升。加白矾（细研）三两搅匀。去火成膏。"}]},{"ID":"20240613124427-n0kqn81","Type":"NodeParagraph","Properties":{"id":"20240613124427-n0kqn81","updated":"20240613124427"},"Children":[{"Type":"NodeText","Data":"摊帛贴。日二易。治鱼脐疔。"}]},{"ID":"20240613124245-qfuwjko","Type":"NodeThematicBreak","Properties":{"id":"20240613124245-qfuwjko"}},{"ID":"20240613124416-utccwa3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124416-utccwa3","updated":"20240613124420"},"Children":[{"Type":"NodeText","Data":"芫花《本草从新》"}]},{"ID":"20240613124416-x7vi34d","Type":"NodeParagraph","Properties":{"id":"20240613124416-x7vi34d","updated":"20240613124416"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大通、行水．"}]},{"ID":"20240613124416-y349qf8","Type":"NodeParagraph","Properties":{"id":"20240613124416-y349qf8","updated":"20240613124416"},"Children":[{"Type":"NodeText","Data":"苦温．去水饮痰癖．疗五水在五脏，皮肤胀满，喘急痛引胸胁，咳嗽瘴疟．（五水者、风水、皮水、正水、石水、黄汗也、水积胞中、坚满如石、名石水、汗如柏汁、名黄汗、久不愈必伤寒太阳证、表未解、心下有水而咳、干呕发热、或喘或利者、小青龙汤主之、表已解、有时头痛、出汗恶寒、心下有水、干呕、痛引两胁、或喘或咳者、十枣汤主之、盖青龙散表邪、使水从汗出、内经所谓开鬼门也、十枣逐里邪、使水从二便出、内经所谓洁净府、去陈 法也、十枣汤、芫花、甘遂、大戟等分、枣十枚．）毒性至紧．取效最捷．稍涉虚者服之．多致夭折．叶似柳．二月开花紫碧色．叶生花落．陈久者良．好醋煮过．晒干．反甘草．根疗疥．"}]},{"ID":"20240613124245-kv4wiah","Type":"NodeThematicBreak","Properties":{"id":"20240613124245-kv4wiah"}},{"ID":"20240613124405-rqiqmnw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124405-rqiqmnw","updated":"20240613124409"},"Children":[{"Type":"NodeText","Data":"芫花《汤液本草》"}]},{"ID":"20240613124405-iwxf6tq","Type":"NodeParagraph","Properties":{"id":"20240613124405-iwxf6tq","updated":"20240613124405"},"Children":[{"Type":"NodeText","Data":"气温，味辛、苦。有小毒。"}]},{"ID":"20240613124405-edgoizt","Type":"NodeParagraph","Properties":{"id":"20240613124405-edgoizt","updated":"20240613124405"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主咳逆上气，喉鸣喘急，咽肿短气，蛊毒鬼疟，痈肿疝瘕。杀虫鱼。消胸中痰水，喜（声去）唾，水肿，五水在五脏、皮肤及腰痛。下寒毒、肉毒。久服令人虚。仲景治太阳中风，胁下痛，呕逆者，可攻，十枣汤主之。"}]},{"ID":"20240613124405-1b8wi3l","Type":"NodeParagraph","Properties":{"id":"20240613124405-1b8wi3l","updated":"20240613124405"},"Children":[{"Type":"NodeText","Data":"《液》云∶胡洽治痰癖饮，加以大黄、甘草，五物同煎。以相反主之，欲其大吐也。"}]},{"ID":"20240613124405-lq4ftev","Type":"NodeParagraph","Properties":{"id":"20240613124405-lq4ftev","updated":"20240613124405"},"Children":[{"Type":"NodeText","Data":"治之大略，水者，肺、肾、胃三经所主，有五脏、六腑、十二经之部分，上而头，中而四肢，下而腰脐，外而皮毛，中而肌肉，内而筋骨。脉有尺寸之殊，浮沉之异，不可轻泻药，当知病在何经何脏，误用则害深。然大意泄湿，内云五物者，即甘遂、大戟、芫花、大黄、甘草也。"}]},{"ID":"20240613124246-v51vavh","Type":"NodeThematicBreak","Properties":{"id":"20240613124246-v51vavh"}},{"ID":"20240613124355-b65njz6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124355-b65njz6","updated":"20240613124359"},"Children":[{"Type":"NodeText","Data":"芫花《本草崇原》"}]},{"ID":"20240613124355-54gue5o","Type":"NodeParagraph","Properties":{"id":"20240613124355-54gue5o","updated":"20240613124355"},"Children":[{"Type":"NodeText","Data":"气味辛温，有小毒。主治咳逆上气，喉鸣喘，咽肿，短气，蛊毒鬼疟，疝瘕痈肿，杀虫鱼。"}]},{"ID":"20240613124355-bqv91xr","Type":"NodeParagraph","Properties":{"id":"20240613124355-bqv91xr","updated":"20240613124355"},"Children":[{"Type":"NodeText","Data":"（芫花《本经》名去水，言其功也。《别录》名毒鱼，言其性也。根名黄大戟，言其似也。"}]},{"ID":"20240613124355-3fan651","Type":"NodeParagraph","Properties":{"id":"20240613124355-3fan651","updated":"20240613124355"},"Children":[{"Type":"NodeText","Data":"俗人因其气恶，又名头痛花。近道处处有之。春生苗，茎紫色，长一二尺，叶色青，浓则黑。二月开花，有紫、赤、黄、碧、白数种，根色黄白如桑根，小人争斗者，取其叶挪擦皮肤，辄作赤肿，如被伤以诬人。和盐擦卵，能染其壳，若赭色。）"}]},{"ID":"20240613124355-ask576e","Type":"NodeParagraph","Properties":{"id":"20240613124355-ask576e","updated":"20240613124355"},"Children":[{"Type":"NodeText","Data":"草木根 之在下者，性欲上行，花实之在上者，性复下降，此物理之自然也。芫花气味辛温，花开赤白，禀金火之气化，主行心肺之气下降，故治咳逆上气，喉鸣而喘，以及咽肿而短气。禀火气，故治虫毒鬼疟。禀金气，故治疝瘕痈肿。辛温有毒，故杀虫鱼。"}]},{"ID":"20240613124246-0jfjy5i","Type":"NodeThematicBreak","Properties":{"id":"20240613124246-0jfjy5i"}},{"ID":"20240613124344-9yzbnrh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124344-9yzbnrh","updated":"20240613124349"},"Children":[{"Type":"NodeText","Data":"芫花《本草经集注》"}]},{"ID":"20240613124344-bac9ohv","Type":"NodeParagraph","Properties":{"id":"20240613124344-bac9ohv","updated":"20240613124344"},"Children":[{"Type":"NodeText","Data":"味辛、苦，温、微温，有小毒。主治咳逆上气，喉鸣喘，咽肿，短气，蛊毒。鬼疟，疝瘕，痈肿，杀虫鱼，消胸中痰水，喜唾，水肿，五水在五脏皮肤，及腰痛，下寒毒、肉毒。"}]},{"ID":"20240613124344-a7k003c","Type":"NodeParagraph","Properties":{"id":"20240613124344-a7k003c","updated":"20240613124344"},"Children":[{"Type":"NodeText","Data":"久服令人虚。一名去水，一名毒鱼，一名杜芫。其根名蜀桑根，治疥疮，可用毒鱼。生淮源川谷。三月三日采花，阴干。决明子为之使，反甘草。"}]},{"ID":"20240613124344-wsuzrqp","Type":"NodeParagraph","Properties":{"id":"20240613124344-wsuzrqp","updated":"20240613124344"},"Children":[{"Type":"NodeText","Data":"近道处处有，用之微熬，不可近眼。"}]},{"ID":"20240613124246-lssu5xm","Type":"NodeThematicBreak","Properties":{"id":"20240613124246-lssu5xm"}},{"ID":"20240613124331-uf2hf53","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124331-uf2hf53","updated":"20240613124338"},"Children":[{"Type":"NodeText","Data":"芫花《要药分剂》"}]},{"ID":"20240613124331-da1eoed","Type":"NodeParagraph","Properties":{"id":"20240613124331-da1eoed","updated":"20240613124331"},"Children":[{"Type":"NodeText","Data":"味苦。性温。有大毒。决明为使。反甘草。"}]},{"ID":"20240613124331-3dwezxa","Type":"NodeParagraph","Properties":{"id":"20240613124331-3dwezxa","updated":"20240613124331"},"Children":[{"Type":"NodeText","Data":"【主治】主咳逆上气。瘴疟。（本经）主消胸中痰水。喜唾。水肿。五水在五脏皮肤。"}]},{"ID":"20240613124331-8may9j8","Type":"NodeParagraph","Properties":{"id":"20240613124331-8may9j8","updated":"20240613124331"},"Children":[{"Type":"NodeText","Data":"及腰痛痹。一【归经】入肺脾肾三经。为行水之品。（专去水饮痰癖）【前论】士瀛曰。破癖须用芫花。行水后即便养胃可也。时珍曰。饮有五。皆由内啜水浆。"}]},{"ID":"20240613124331-mq8fk8l","Type":"NodeParagraph","Properties":{"id":"20240613124331-mq8fk8l","updated":"20240613124334"},"Children":[{"Type":"NodeText","Data":"可徐【炮制】纲目曰。凡使。取陈久者醋煮十数沸。去醋。水浸一宿。晒干。则毒减。醋炒者次。"}]},{"ID":"20240613124246-v7zw8fe","Type":"NodeThematicBreak","Properties":{"id":"20240613124246-v7zw8fe"}},{"ID":"20240613124308-a2qbenz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124308-a2qbenz","updated":"20240613124314"},"Children":[{"Type":"NodeText","Data":"芫花《本草便读》"}]},{"ID":"20240613124308-3291h4c","Type":"NodeParagraph","Properties":{"id":"20240613124308-3291h4c","updated":"20240613124308"},"Children":[{"Type":"NodeText","Data":"入肺脾而兼肾．窠囊水饮立蠲除．导上下以通肠．留伏湿痰顿解化．散瘀消肿．味苦而辛．治癖杀虫．性温有毒．（芫花味苦辛．色黄赤．性温有毒．入脾肺肾三经血分．专泻上下水邪．以其为花也．故能泻而兼散．非比商陆之沉降．不能破血．且性之寒温亦异耳．然有毒之品．不可轻投．）"}]},{"ID":"20240613124246-fmrazkc","Type":"NodeThematicBreak","Properties":{"id":"20240613124246-fmrazkc"}},{"ID":"20240613124258-gkxaakm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124258-gkxaakm","updated":"20240613124302"},"Children":[{"Type":"NodeText","Data":"芫花《长沙药解》"}]},{"ID":"20240613124258-0z5gaq0","Type":"NodeParagraph","Properties":{"id":"20240613124258-0z5gaq0","updated":"20240613124258"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛温。主咳逆上气，喉鸣，喘咽肿，短气，蛊毒，鬼疟，疝瘕，痈肿，杀虫鱼。一名去水。生川谷。"}]},{"ID":"20240613124258-loxtul8","Type":"NodeParagraph","Properties":{"id":"20240613124258-loxtul8","updated":"20240613124258"},"Children":[{"Type":"NodeText","Data":"味苦、辛，入足太阳膀胱经。性专泻水，力能止利。"}]},{"ID":"20240613124258-rp5rel2","Type":"NodeParagraph","Properties":{"id":"20240613124258-rp5rel2","updated":"20240613124258"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小青龙汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在麻黄。"},{"Type":"NodeText","Data":"治太阳伤寒，心下有水气。若微利者，去麻黄，加芫花如鸡子大，熬令赤色。水旺土湿则利作，芫花泻水而止利也。"}]},{"ID":"20240613124258-zzm7mab","Type":"NodeParagraph","Properties":{"id":"20240613124258-zzm7mab","updated":"20240613124258"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"十枣汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大枣。"},{"Type":"NodeText","Data":"用之治心胁痞痛，下利呕逆者，治悬饮内痛，脉沉而弦者，以其破壅塞而泻饮也。"}]},{"ID":"20240613124258-3w1g83z","Type":"NodeParagraph","Properties":{"id":"20240613124258-3w1g83z","updated":"20240613124258"},"Children":[{"Type":"NodeText","Data":"芫花破气泻水，逐饮涤痰，止喘嗽而化疝瘕，消痈肿而平疮疥，善杀虫鱼，妙枯瘤痔，牙痛、头秃之病，皆有奇功。"}]},{"ID":"20240613124246-iyu4zwv","Type":"NodeThematicBreak","Properties":{"id":"20240613124246-iyu4zwv"}},{"ID":"20240613124247-qg0hxvj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124247-qg0hxvj","updated":"20240613124252"},"Children":[{"Type":"NodeText","Data":"芫花《本草蒙筌》"}]},{"ID":"20240613124247-iz1n2e1","Type":"NodeParagraph","Properties":{"id":"20240613124247-iz1n2e1","updated":"20240613124247"},"Children":[{"Type":"NodeText","Data":"味辛、苦，气温。有小毒。川谷甚多，远近俱有。茎紫花白，一二尺长。密开花盈旧枝茎，如紫梢作穗；未出叶采嫩苞蕊，向晴日曝干。花落叶生，不堪用也。得之煮醋数沸，洒出渍水一宵。复曝干收，才免毒害。反甘草，使决明。散皮肤水肿发浮，消胸膈痰沫善唾。咳逆上气能止，咽肿短气可安。驱疝瘕痈疽，除蛊毒鬼疟。令人虚损，久服不宜。汁渍线丝，系痔易落。 根采尤毒，乃名"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜀桑"},{"Type":"NodeText","Data":"。捣烂堪毒鱼，研末能敷疥。"}]},{"ID":"20240613124247-l5yg1kc","Type":"NodeParagraph","Properties":{"id":"20240613124247-l5yg1kc","updated":"20240613124247"},"Children":[{"Type":"NodeText","Data":"（谟）按∶芫花泻湿利水为要。夫水者，脾、胃、肾三经所主，有五脏六腑十二经之部分。上而头目，中而四肢，下而腰膝。外而皮毛，中而肌肉，内而筋骨。脉有寸、关、尺之殊，诊有浮、中、沉之异。必当审其病在何经何脏，乃可用之。倘若误投，为害非浅。"}]},{"ID":"20240613124059-oooe7jk","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-oooe7jk"}},{"ID":"20240613124229-5ep0cjp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124229-5ep0cjp","updated":"20240613124237"},"Children":[{"Type":"NodeText","Data":"芫花《医学入门》"}]},{"ID":"20240613124229-58mhqc2","Type":"NodeParagraph","Properties":{"id":"20240613124229-58mhqc2","updated":"20240613124229"},"Children":[{"Type":"NodeText","Data":"芫花苦寒消水肿，咳逆喉鸣痰气壅，心腹腰脚胀且疼，破积杀虫拔毛孔。"}]},{"ID":"20240613124229-c0dq65l","Type":"NodeParagraph","Properties":{"id":"20240613124229-c0dq65l","updated":"20240613124229"},"Children":[{"Type":"NodeText","Data":"芫，元也，始也。元气始动而花开，处处有之，生坡涧傍，二月开紫花作穗。有毒。主利五水在五脏，皮肤肿胀，咳逆上气；喉鸣或肿，喘嗽，消胸中痰水喜唾，治心腹及腰脚膨胀作痛，破积聚气块疝瘕，杀虫鱼肉毒。一切恶疮痈肿，风痹蜷挛，皆能通利血脉而愈。又治金疮疥癣，生肌止血，宜烧灰用。兼治蛊毒鬼疟，内搜肠胃，外达毛孔。《快捷方式》云∶须知此物力如山，体实者久服则虚，虚者禁用。醋炒不可近眼。决明为使。反甘草。根，主疗疥疮，可毒鱼。一方，取入土根洗净，捣汁入银器内煎膏，以丝线于膏内度过，如痔 有头者，将此线系之，候落时以纸捻入膏药于窍内除根。未落不得使水，系瘤亦效。"}]},{"ID":"20240613124059-6dpsjfz","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-6dpsjfz"}},{"ID":"20240613124211-xan5f9s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124211-xan5f9s","updated":"20240613124220"},"Children":[{"Type":"NodeText","Data":"芫花《增广和剂局方药性总论》"}]},{"ID":"20240613124211-815b02p","Type":"NodeParagraph","Properties":{"id":"20240613124211-815b02p","updated":"20240613124211"},"Children":[{"Type":"NodeText","Data":"味辛苦，温、微温，有小毒。主咳逆上气，喉鸣喘，咽肿短气，蛊毒鬼疟，疝瘕痈肿杀虫鱼，消胸中痰水，喜唾，水肿，五水在五脏、皮肤及腰痛，下寒毒，肉毒。根∶疗疥疮，可用毒鱼。《药性论》云∶使。能治心腹胀满，去水气，利五脏，寒痰，涕唾如胶，主通利血脉，治恶疮，风痹湿，一切毒风，四肢挛急不能行步，能泻水肿胀满。日华子云∶疗嗽，瘴疟。所在有。决明为之使。反∶甘草。"}]},{"ID":"20240613124059-a83mjxw","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-a83mjxw"}},{"ID":"20240613124128-7bvr01z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124128-7bvr01z","updated":"20240613124151"},"Children":[{"Type":"NodeText","Data":"芫花《证类本草》"}]},{"ID":"20240613124128-hvp53ox","Type":"NodeParagraph","Properties":{"id":"20240613124128-hvp53ox","updated":"20240613124128"},"Children":[{"Type":"NodeText","Data":"味辛、苦，温、微温，有小毒。主咳逆上气，喉鸣喘，咽肿，短气，蛊毒，鬼疟，疝瘕，痈肿，杀虫鱼，消胸中痰水，喜（音戏）唾，水肿，五水在五脏皮肤及腰痛，下寒毒肉毒。久服令人虚。一名去水，一名毒鱼，一名杜芫。其根名蜀桑根，疗疥疮。可用毒鱼。生淮源川谷。三月日采花，阴干。（决明为之使，反甘草。）"}]},{"ID":"20240613124128-mwrn0tu","Type":"NodeParagraph","Properties":{"id":"20240613124128-mwrn0tu","updated":"20240613124128"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处有，用之微熬，不可近眼。臣禹锡等谨按蜀本图经云∶苗高二、三尺，叶似白前及柳叶，根皮黄似桑根。正月、二月花发，紫碧色，叶未生时收，晒干。三月即叶生花落，不堪用也。药性论云∶芫花，使，有大毒。能治心腹胀满，去水气，利五脏，寒痰涕唾如胶者，主通利血脉，治恶疮，风痹湿，一切毒风，如肢挛急，不能行步，能泻水肿胀满。日华子云∶疗嗽，瘴疟。所在有，小树子在陂涧旁，三月中盛花，浅紫色。"}]},{"ID":"20240613124128-4vq9nmd","Type":"NodeParagraph","Properties":{"id":"20240613124128-4vq9nmd","updated":"20240613124128"},"Children":[{"Type":"NodeText","Data":"图经曰∶芫花，生淮源川谷，今在处有之。宿根旧枝茎紫，长一、二尺。根入土深三、五寸，白色，似榆根。春生苗、叶，小而尖，似杨柳枝叶。二月开紫花，颇似紫荆而作穗，又似藤花而细。三月三日采，阴干。其花须未成蕊，蒂细小，未生叶时收之。叶生花落，即不堪用。《吴普本草》云∶芫花一名败华，一名儿草，一名黄大戟。二月生叶，加浓则黑。华有紫、赤、白者。三月实落尽，叶乃生是也。而今绛州出者花黄，谓之黄芫花。汉·太仓公淳于意治临淄女子薄吾蛲（音饶）瘕。蛲瘕为病，腹大，上肤黄粗，循之戚戚然，意饮以芫花一撮，即出蛲可数升，病遂愈。张仲景治太阳中风，吐下呕逆者，可攻，十枣汤主之。芫花（熬）"}]},{"ID":"20240613124128-4jdxexf","Type":"NodeParagraph","Properties":{"id":"20240613124128-4jdxexf","updated":"20240613124128"},"Children":[{"Type":"NodeText","Data":"、甘遂、大戟三物等分，停各筛末。取大枣十枚，水一升半，煮取八合，去渣，纳诸药。强人一钱匕，赢人半匕，温服之。不下，明旦更加半匕，下后藤粥自养，病悬饮者亦主之。胡洽治水肿及支饮、 饮。加大黄、甘草并煎，五物各一两，枣十枚同煮，如法。一方∶又加芒硝一两，汤成下之。又《千金方》死。起人死 方∶取芫花一斤，以水吴普又云∶芫花根，一名赤芫根。神农∶辛。雷公；苦，有毒。生邯郸。八月、九月采，阴干。久服令人泄，右方∶亦入药用。《古今录验》疗暴中冷，伤寒，鼻塞喘嗽，喉中 塞，失音声者。"}]},{"ID":"20240613124128-wgntz72","Type":"NodeParagraph","Properties":{"id":"20240613124128-wgntz72","updated":"20240613124128"},"Children":[{"Type":"NodeText","Data":"裹。舂芫花根令飞杨，入其七孔中。当眼泪出，口鼻皆罗刺毕毕耳。勿住，令芫根尽则止。病必于此瘥。"}]},{"ID":"20240613124128-5q8kqh7","Type":"NodeParagraph","Properties":{"id":"20240613124128-5q8kqh7","updated":"20240613124128"},"Children":[{"Type":"NodeText","Data":"经验方∶治痔 有头方∶用芫花入土根不限多少，以净水洗却，入木臼捣，用少许水绞取汁，于银、铜器内慢火煎成膏，将丝线于膏内度过系痔，系时微痛，候心躁落时，以纸拈子入膏药于窍内，永除根本，未落，不得使水。三国志魏初平中，有青牛先生常服芫花，年如五、六十，人或亲识之，谓其已百余岁矣。"}]},{"ID":"20240613124059-fyvycwt","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-fyvycwt"}},{"ID":"20240613124112-9yvub4n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124112-9yvub4n","updated":"20240613124117"},"Children":[{"Type":"NodeText","Data":"芫花《药性切用》"}]},{"ID":"20240613124112-ga7j8ue","Type":"NodeParagraph","Properties":{"id":"20240613124112-ga7j8ue","updated":"20240613124112"},"Children":[{"Type":"NodeText","Data":"性味苦温，通行水饮、痰癖。醋炒用。毒性至紧，取效甚捷。稍涉虚者忌。"}]},{"ID":"20240613124059-50j3xm7","Type":"NodeThematicBreak","Properties":{"id":"20240613124059-50j3xm7"}},{"ID":"20240613124101-thn0fat","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124101-thn0fat","updated":"20240613124108"},"Children":[{"Type":"NodeText","Data":"芫花《本草图经》"}]},{"ID":"20240613124101-9i08cga","Type":"NodeParagraph","Properties":{"id":"20240613124101-9i08cga","updated":"20240613124103"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"芫花"},{"Type":"NodeText","Data":"，生淮源川谷，今在处有之。宿根旧枝茎紫，长一、二尺。根入土深三、五寸，白色，似榆根；春生苗叶，小而尖，似杨柳枝叶；二月开紫花，颇似紫荆而作穗，又似藤花而细。"}]},{"ID":"20240613124101-p6ewk5y","Type":"NodeParagraph","Properties":{"id":"20240613124101-p6ewk5y","updated":"20240613124101"},"Children":[{"Type":"NodeText","Data":"三月三日采，阴干。其花须未成蕊，蒂细小，未生叶时收之。叶生花落，即不堪用。《吴普本草》云∶芫花，一名败华，一名儿草，一名黄大戟。二月生叶，加浓则黑。华有紫、赤、白者。三月实落尽，叶乃生是也。而今绛州出者，花黄谓之黄芫花。汉太仓公淳于意，治临淄女子薄吾蛲（音饶）瘕。蛲瘕为病，腹大，上肤黄粗，循之戚戚然。意饮以芫花一撮，即出蛲可数升，病遂愈。张仲景治太阳中风，吐下呕逆者，可攻十枣汤主之。芫花熬、甘遂、大戟三物等分，停各筛末，取大枣十枚，水一升半，煮取八合，去滓，内诸药，强人一钱匕，羸人半钱匕，温服之。不下，明旦更加半匕，下后糜粥自养。病悬饮者，亦主之。胡洽治水肿及支饮、 饮，加大黄、甘草，并前五物各一两，枣十枚，同煮如法。一方又加芒硝一两，汤成下之。又《千金方》凝雪汤，疗天行毒病七、八日，热积聚胸中，烦乱欲死。起人死方，取芫花一斤，以水三升，煮取一升半，渍故布薄胸上，不过再三薄，热则除，当温四肢，护厥逆也。吴普又云∶芫花根，一名赤芫根。神农∶辛，雷公∶苦，有毒。生邯郸，八月、九月采，阴干。久服令人泄。古方亦入药用。《古今录验》∶疗暴中冷，伤寒鼻塞，喘嗽喉中哑塞，失音声者。取芫花根一虎口，切，曝干。令病患以荐自萦就裹。舂芫花根令飞扬，入其七孔内，当眼泪出，口鼻皆罗 毕毕耳，勿住，令芫根尽则止。病必于此瘥。"}]},{"ID":"20240613123839-brseqz2","Type":"NodeThematicBreak","Properties":{"id":"20240613123839-brseqz2"}},{"ID":"20240613124031-tl2un0g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124031-tl2un0g","updated":"20240613124040"},"Children":[{"Type":"NodeText","Data":"芫花《本草求真》"}]},{"ID":"20240613124031-gepo1bk","Type":"NodeParagraph","Properties":{"id":"20240613124031-gepo1bk","updated":"20240613124031"},"Children":[{"Type":"NodeText","Data":"（毒草）大通里外水道"}]},{"ID":"20240613124031-s9i9rwa","Type":"NodeParagraph","Properties":{"id":"20240613124031-s9i9rwa","updated":"20240613124031"},"Children":[{"Type":"NodeText","Data":"芫花（专入脾肺肾）。味辛而苦。气温有毒。亦反甘草。主治颇与大戟甘遂。皆能达水饮窠囊隐僻之处。然此味苦而辛。苦则内泄。辛则外搜。故凡水隐痰癖。皮肤胀满。喘急痛引胸胁。咳嗽胀疟。里外水闭。危迫殆甚者。用此毒性至紧。无不立应。（饮有痰饮悬饮溢饮支饮伏饮之异。李时珍云。夫饮有五。皆出内啜水浆。外受湿气。郁蓄而为留饮。流于胸则为支饮。令人喘咳寒热。吐沫背寒。流于肺则为悬饮。令人咳唾痛引缺盆两胁。流于心下则为伏饮。令人胸满呕吐寒热眩晕。流于肠胃则为痰饮。令人腹鸣吐水。胸胁支满。或作泄泻。忽肥忽瘦。流于经络则为溢饮。令人沉重注痛。或作水气跗踵。又水有风水皮水正水黄汗之别。如水积胞中坚满如石。则为石水。汗如柏汁炙黄。名曰黄汗。久而不愈。则为痈脓。又水在肺则咳。在胃则呕。在头则眩。在心则悸。在背则冷。在胁则胀。）不似甘遂苦寒。止泄经隧水湿。大戟苦寒。止泄脏腑水湿。荛花与此气味虽属相同。而性较此多寒之有异耳！此虽取效甚捷。误用多致夭折。不可不慎。根名蜀桑。止可敷疮毒鱼。及捣汁浸线。系落痔疮。他不宜用。叶似柳。花紫碧色。叶生花落。陈久者良。醋煮过。水浸暴用。反甘草。（叶可擦肤赤肿作伤。）"}]},{"ID":"20240613123839-gvduax2","Type":"NodeThematicBreak","Properties":{"id":"20240613123839-gvduax2"}},{"ID":"20240613123903-9rwbi9m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123903-9rwbi9m","updated":"20240613124046"},"Children":[{"Type":"NodeText","Data":"芫花《本草纲目》"}]},{"ID":"20240613123903-gu3dbui","Type":"NodeParagraph","Properties":{"id":"20240613123903-gu3dbui","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"「释名」杜芫、赤芫、去水、毒鱼、头痛花、儿草、败华。根名黄大戟、蜀桑。"}]},{"ID":"20240613123903-o7rvcmk","Type":"NodeParagraph","Properties":{"id":"20240613123903-o7rvcmk","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"「气味」（花、根）辛、温、有小毒。"}]},{"ID":"20240613123903-gv90yes","Type":"NodeParagraph","Properties":{"id":"20240613123903-gv90yes","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613123903-ni7i811","Type":"NodeParagraph","Properties":{"id":"20240613123903-ni7i811","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"1、突发咳嗽。用芫花一升，加水三升煮汁一升，以枣十四枚，放入汁中煮干，一天吃五枚，必愈。"}]},{"ID":"20240613123903-1jgkyc5","Type":"NodeParagraph","Properties":{"id":"20240613123903-1jgkyc5","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"2、咳嗽有痰。用芫花一两（炒），加水一升，煮开四次，去渣，再加入白糖半斤。每服约一个枣子大的量。忌食酸咸物。"}]},{"ID":"20240613123903-fbotqke","Type":"NodeParagraph","Properties":{"id":"20240613123903-fbotqke","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"3、干呕胁痛（伤寒有时头痛，心下痞满，痛引两胁，干呕短气，汗出而不恶寒）。用芫花（熬过）、甘遂、大戟，等分为末。以大枣十枚、水一升半，煮成八合后，去渣纳药。体壮者服一钱，弱者半钱，清晨服下。能下泻则病除，否则次晨再服药。此方名“十枣汤”。"}]},{"ID":"20240613123903-f6optd8","Type":"NodeParagraph","Properties":{"id":"20240613123903-f6optd8","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"4、水肿。用上方（十枣汤）加大黄、甘草五物各一两，大枣十枚，同煮，如上法服。另方：药中再加硭硝一两。"}]},{"ID":"20240613123903-u7fwboj","Type":"NodeParagraph","Properties":{"id":"20240613123903-u7fwboj","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"5、久疟，腹胁坚痛。用芫花（炒）二两，朱砂五钱，共研为末，加蜜做成丸子，如梧子大。每服十丸，枣汤送下。"}]},{"ID":"20240613123903-02rxwb2","Type":"NodeParagraph","Properties":{"id":"20240613123903-02rxwb2","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"6、水盅胀满。用芫花、枳壳等分，先以醋把芫花煮烂，再加枳壳煮烂，一起捣匀做丸子，如梧子大。每服三十丸，白汤送下。"}]},{"ID":"20240613123903-vco7ljs","Type":"NodeParagraph","Properties":{"id":"20240613123903-vco7ljs","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"7、子宫结块，月经不通。用芫花根三两，锉细，炒黄，研为末。每服一钱，桃仁煎汤调下。泻下恶物即愈。"}]},{"ID":"20240613123903-as7tauu","Type":"NodeParagraph","Properties":{"id":"20240613123903-as7tauu","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"8、牙痛难忍，诸药不效。用芫花末擦牙令热。痛定后，以温水漱口。"}]},{"ID":"20240613123903-e57glx8","Type":"NodeParagraph","Properties":{"id":"20240613123903-e57glx8","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"9、痈肿初起。用芫花末和胶涂搽。"}]},{"ID":"20240613123903-ztgek1l","Type":"NodeParagraph","Properties":{"id":"20240613123903-ztgek1l","updated":"20240613123903"},"Children":[{"Type":"NodeText","Data":"10、痔疮。用芫根一把，捣烂，慢火煎成膏，将丝线于膏内度过，以线系痔，当有微痛的感觉。等痔疮干落后，即以纸捻蘸膏纳入肛门中，可以便痔疮断根。另方：只捣汁浸线一夜即用，不必熬膏。"}]},{"ID":"20240613123839-bligjqh","Type":"NodeThematicBreak","Properties":{"id":"20240613123839-bligjqh"}},{"ID":"20240613123851-j2d5y35","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123851-j2d5y35","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"《中国药典》：芫花"}]},{"ID":"20240613123851-fu05cgp","Type":"NodeParagraph","Properties":{"id":"20240613123851-fu05cgp","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613123851-wa5wvdz","Type":"NodeParagraph","Properties":{"id":"20240613123851-wa5wvdz","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" Yuán Huā"}]},{"ID":"20240613123851-wrrmqpq","Type":"NodeParagraph","Properties":{"id":"20240613123851-wrrmqpq","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613123851-5xagoju","Type":"NodeParagraph","Properties":{"id":"20240613123851-5xagoju","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 南芫花、芫花条、药鱼草、莞花、头痛花、闷头花、老鼠花、癞头花、金腰带、浮胀草[根皮]"}]},{"ID":"20240613123851-l9gpbfg","Type":"NodeParagraph","Properties":{"id":"20240613123851-l9gpbfg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613123851-1mf0pqj","Type":"NodeParagraph","Properties":{"id":"20240613123851-1mf0pqj","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" FLOS GENKWA"}]},{"ID":"20240613123851-2ea2uto","Type":"NodeParagraph","Properties":{"id":"20240613123851-2ea2uto","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613123851-wy7hpkm","Type":"NodeParagraph","Properties":{"id":"20240613123851-wy7hpkm","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 本品为瑞香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芫花"},{"Type":"NodeText","Data":"Daphne genkwa Sieb. et Zucc.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花蕾"},{"Type":"NodeText","Data":"，其根白皮（二层皮）也供药用。春季花未开放时采收，除去杂质，干燥。"}]},{"ID":"20240613123851-9ody1bd","Type":"NodeParagraph","Properties":{"id":"20240613123851-9ody1bd","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613123851-vgrd1sh","Type":"NodeParagraph","Properties":{"id":"20240613123851-vgrd1sh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 本品常3～7朵簇生于短花轴上，基部有苞片1～2片，多脱落为单朵。单朵呈棒槌状，多弯曲，长1～1。7cm，直径约1。5mm；花被筒表面淡紫色或灰绿色，密被短柔毛，先端4裂，裂片淡紫色或黄棕色。质软。气微，味甘、微辛。"}]},{"ID":"20240613123851-yludn1f","Type":"NodeParagraph","Properties":{"id":"20240613123851-yludn1f","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613123851-hw1xb3w","Type":"NodeParagraph","Properties":{"id":"20240613123851-hw1xb3w","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防霉，防蛀。"}]},{"ID":"20240613123851-kcj1z6v","Type":"NodeParagraph","Properties":{"id":"20240613123851-kcj1z6v","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613123851-y9om3sv","Type":"NodeParagraph","Properties":{"id":"20240613123851-y9om3sv","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芫花"},{"Type":"NodeText","Data":"：除去杂质。"}]},{"ID":"20240613123851-xj5jiqw","Type":"NodeParagraph","Properties":{"id":"20240613123851-xj5jiqw","updated":"20240613123851"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"醋芫花"},{"Type":"NodeText","Data":"：取净芫花，照醋炙法（附录Ⅱ D）炒至醋吸尽。每100kg芫花，用醋30kg。"}]},{"ID":"20240613123851-xj312rh","Type":"NodeParagraph","Properties":{"id":"20240613123851-xj312rh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613123851-042n8id","Type":"NodeParagraph","Properties":{"id":"20240613123851-042n8id","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" （1）本品表面观：花粉粒黄色，类球形，直径23～45μm，表面有较明显的网状雕纹。花被下表面有非腺毛，单细胞，多弯曲，长88～780μm，直径15～23μm，壁较厚，微具疣状突起。"}]},{"ID":"20240613123851-t6wsxix","Type":"NodeParagraph","Properties":{"id":"20240613123851-t6wsxix","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加石油醚（30～60℃）20ml，超声处理30分钟，滤过，滤液蒸干，残渣加乙醇1ml使溶解，作为供试品溶液。另取芫花对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一硅胶G薄层板上，以苯-醋酸乙酯（10:1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同的天蓝色荧光斑点。"}]},{"ID":"20240613123851-s8wdlp0","Type":"NodeParagraph","Properties":{"id":"20240613123851-s8wdlp0","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613123851-w436xo4","Type":"NodeParagraph","Properties":{"id":"20240613123851-w436xo4","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 归肺、脾、肾经。"}]},{"ID":"20240613123851-rg8ffui","Type":"NodeParagraph","Properties":{"id":"20240613123851-rg8ffui","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613123851-utwxcy0","Type":"NodeParagraph","Properties":{"id":"20240613123851-utwxcy0","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 花：苦、辛，寒；有毒。"}]},{"ID":"20240613123851-3rfyzzm","Type":"NodeParagraph","Properties":{"id":"20240613123851-3rfyzzm","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"根皮：辛、苦，平。有毒"}]},{"ID":"20240613123851-e9kfcer","Type":"NodeParagraph","Properties":{"id":"20240613123851-e9kfcer","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613123851-9va2gxn","Type":"NodeParagraph","Properties":{"id":"20240613123851-9va2gxn","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 孕妇禁用；不宜与甘草同用。"}]},{"ID":"20240613123851-fferpzq","Type":"NodeParagraph","Properties":{"id":"20240613123851-fferpzq","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613123851-xg7562c","Type":"NodeParagraph","Properties":{"id":"20240613123851-xg7562c","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 花：泻水逐饮，解毒杀虫。用于水肿胀满，胸腹积水，痰饮积聚，气逆喘咳，二便不利；外治疥癣秃疮，冻疮。"}]},{"ID":"20240613123851-6x8xy0d","Type":"NodeParagraph","Properties":{"id":"20240613123851-6x8xy0d","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"根皮：消肿解毒，活血止痛。用于急性乳腺炎，痈疖肿毒，淋巴结结核，腹水，风湿痛，牙痛，跌打损伤。"}]},{"ID":"20240613123851-t6mvmo9","Type":"NodeParagraph","Properties":{"id":"20240613123851-t6mvmo9","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613123851-7w1pyiy","Type":"NodeParagraph","Properties":{"id":"20240613123851-7w1pyiy","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.5～3g。醋芫花研末吞服，一次0.6～0.9g，一日1次。外用适量。"}]},{"ID":"20240613123851-miyffbo","Type":"NodeParagraph","Properties":{"id":"20240613123851-miyffbo","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613123851-cprxpe8","Type":"NodeParagraph","Properties":{"id":"20240613123851-cprxpe8","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" （1）用醋炒芫花配合雄黄，研末内服，治虫积腹痛；以芫花研末，用猪油拌和，外涂治头癣。"}]},{"ID":"20240613123851-2skedqh","Type":"NodeParagraph","Properties":{"id":"20240613123851-2skedqh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613123851-q2k85z2","Type":"NodeParagraph","Properties":{"id":"20240613123851-q2k85z2","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613123851-ouc5gqy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123851-ouc5gqy","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：芫花"}]},{"ID":"20240613123851-8jy09bg","Type":"NodeParagraph","Properties":{"id":"20240613123851-8jy09bg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613123851-gbvtdf1","Type":"NodeParagraph","Properties":{"id":"20240613123851-gbvtdf1","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" Yuán Huā"}]},{"ID":"20240613123851-vzh52iy","Type":"NodeParagraph","Properties":{"id":"20240613123851-vzh52iy","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613123851-8sjx3ix","Type":"NodeParagraph","Properties":{"id":"20240613123851-8sjx3ix","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 芫（《山海经》），去水（《本经》），败花、赤芫、儿草（《吴普本草》），毒鱼、杜芫（《别录》），头痛花（《纲目》），闷头花、老鼠花（《东还纪程》），闹鱼花（《中国树木分类学》），棉花条、大米花（《江苏植药志》），芫条花、野丁香花（《山东中药》），九龙花、浮胀草、地棉花（《湖南药物志》），银腰带、小叶金腰带（《江西草药》）。"}]},{"ID":"20240613123851-24ac09z","Type":"NodeParagraph","Properties":{"id":"20240613123851-24ac09z","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613123851-735e3sx","Type":"NodeParagraph","Properties":{"id":"20240613123851-735e3sx","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613123851-yznm1x1","Type":"NodeParagraph","Properties":{"id":"20240613123851-yznm1x1","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613123851-qtiyaqt","Type":"NodeParagraph","Properties":{"id":"20240613123851-qtiyaqt","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 为瑞香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芫花"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花蕾"},{"Type":"NodeText","Data":"。春季花未开放前采摘，拣去杂质，晒干或烘干。"}]},{"ID":"20240613123851-9mpxvjg","Type":"NodeParagraph","Properties":{"id":"20240613123851-9mpxvjg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613123851-8c1ko7s","Type":"NodeParagraph","Properties":{"id":"20240613123851-8c1ko7s","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 生于路旁、山坡，或栽培于庭园。分布福建、浙江、江苏、安徽、湖北、湖南、四川、山东、河南、河北、陕西等地。产安徽、江苏、浙江、四川、山东、福建、湖北等地。"}]},{"ID":"20240613123851-jphjnrh","Type":"NodeParagraph","Properties":{"id":"20240613123851-jphjnrh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613123851-hzswzja","Type":"NodeParagraph","Properties":{"id":"20240613123851-hzswzja","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 落叶灌木，高可达1米。茎细长而直立，幼时有绢状短柔毛。叶通常对生，偶为互生，椭圆形至长椭圆形，长3～5.5厘米，宽5～20厘米，略为革质，全绿，先端尖，幼时两面疏生绢状细柔毛，脉上较密，老时上面渐脱落；叶柄短，密布短柔毛。花先叶开放，淡紫色，通常出于枝顶叶腋，3～7朵簇生；花酶性，无花瓣；萼圆筒状而细，长约1厘米，密被绢状短柔毛，先端4裂，裂片卵形，长不及1厘米；雄蕊8，2轮，着生于萼筒上，不具花丝；雌蕊1，子房上位，1室，花柱极短或缺乏，柱头头状。核果革质，白色。种子1粒，黑色。花期2～4月。果期5月。"}]},{"ID":"20240613123851-rr6cujy","Type":"NodeParagraph","Properties":{"id":"20240613123851-rr6cujy","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"本植物的根（芫花根）亦供药用，另详专条。"}]},{"ID":"20240613123851-a16i6xh","Type":"NodeParagraph","Properties":{"id":"20240613123851-a16i6xh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613123851-mxowwjt","Type":"NodeParagraph","Properties":{"id":"20240613123851-mxowwjt","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 干燥花蕾呈弯曲或稍压扁的棒锤状，长约1厘米，直径约0.3厘米，常单朵或3～7朵成簇。上端稍膨大，裂为4片，淡黄棕色，下端较细，灰棕色，密布白色绒毛。花心较硬，呈紫红色。全花质软。气微香，久嗅能致头痛，味微甘。嚼之有辣感。以花蕾多而整齐。淡紫色者为佳。"}]},{"ID":"20240613123851-6w413x0","Type":"NodeParagraph","Properties":{"id":"20240613123851-6w413x0","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613123851-o6z7twu","Type":"NodeParagraph","Properties":{"id":"20240613123851-o6z7twu","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 芫花含芫花素、羟基芫花素、芹菜素及谷甾醇；另含苯甲酸及刺激性油状物。"}]},{"ID":"20240613123851-cthdbrk","Type":"NodeParagraph","Properties":{"id":"20240613123851-cthdbrk","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613123851-yzqokze","Type":"NodeParagraph","Properties":{"id":"20240613123851-yzqokze","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 芫花：拣净杂质，筛去泥土。醋芫花：取净芫花，加醋拌匀，润透，置锅内用文火炒至醋吸尽，呈微黄色，取出，晾干。（每芫花100斤，用醋25斤）"}]},{"ID":"20240613123851-hv130qr","Type":"NodeParagraph","Properties":{"id":"20240613123851-hv130qr","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"芫花，用之微熬，不可近眼。\""}]},{"ID":"20240613123851-qsv0qot","Type":"NodeParagraph","Properties":{"id":"20240613123851-qsv0qot","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"芫花留数年陈久者良。用时以好醋煮十数沸，去醋，以水浸一宿，晒干用，则毒灭也，或以醋炒者次之。\""}]},{"ID":"20240613123851-8jx5kue","Type":"NodeParagraph","Properties":{"id":"20240613123851-8jx5kue","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613123851-cookpcs","Type":"NodeParagraph","Properties":{"id":"20240613123851-cookpcs","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 入肺、脾经。"}]},{"ID":"20240613123851-qwaadix","Type":"NodeParagraph","Properties":{"id":"20240613123851-qwaadix","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"①《长沙药解》：\"入足太阳膀胱经。\""}]},{"ID":"20240613123851-vrnsomi","Type":"NodeParagraph","Properties":{"id":"20240613123851-vrnsomi","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"入手太阴经。\""}]},{"ID":"20240613123851-q2x47gg","Type":"NodeParagraph","Properties":{"id":"20240613123851-q2x47gg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入脾，肺、肾。\""}]},{"ID":"20240613123851-23wqpfh","Type":"NodeParagraph","Properties":{"id":"20240613123851-23wqpfh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613123851-13htgm4","Type":"NodeParagraph","Properties":{"id":"20240613123851-13htgm4","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 辛苦，温，有毒。"}]},{"ID":"20240613123851-27qz65t","Type":"NodeParagraph","Properties":{"id":"20240613123851-27qz65t","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240613123851-hjp0q4m","Type":"NodeParagraph","Properties":{"id":"20240613123851-hjp0q4m","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，微温，有小毒。\""}]},{"ID":"20240613123851-e18d4qh","Type":"NodeParagraph","Properties":{"id":"20240613123851-e18d4qh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"有大毒。\""}]},{"ID":"20240613123851-1r7y0ts","Type":"NodeParagraph","Properties":{"id":"20240613123851-1r7y0ts","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613123851-buwyavj","Type":"NodeParagraph","Properties":{"id":"20240613123851-buwyavj","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 体质虚弱及孕妇禁服。"}]},{"ID":"20240613123851-yhfqbic","Type":"NodeParagraph","Properties":{"id":"20240613123851-yhfqbic","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"《本草经集注》：\"决明为主使。反甘草。\""}]},{"ID":"20240613123851-py3nf4p","Type":"NodeParagraph","Properties":{"id":"20240613123851-py3nf4p","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613123851-dd3hhc5","Type":"NodeParagraph","Properties":{"id":"20240613123851-dd3hhc5","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 逐水，涤痰。治痰饮癖积，喘咳，水肿，胁痛，心腹症结胀满，食物中毒，疟母，痈肿。"}]},{"ID":"20240613123851-k9mt6rj","Type":"NodeParagraph","Properties":{"id":"20240613123851-k9mt6rj","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主咳逆上气，喉鸣喘，咽肿短气，鬼疟，疝瘕，痈肿。\""}]},{"ID":"20240613123851-y42lqjx","Type":"NodeParagraph","Properties":{"id":"20240613123851-y42lqjx","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"消胸中痰水，喜唾，水肿，五水在五藏皮肤及腰痛，下寒毒、肉毒。\""}]},{"ID":"20240613123851-0ju8u0l","Type":"NodeParagraph","Properties":{"id":"20240613123851-0ju8u0l","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治心腹胀满，去水气，利五脏寒痰，涕唾如胶者。主通利血脉，治恶疮风痹湿，一切毒风，四肢挛急，不能行步，能泻水肿胀满。\""}]},{"ID":"20240613123851-iic9i5z","Type":"NodeParagraph","Properties":{"id":"20240613123851-iic9i5z","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"疗嗽，瘅疟。\""}]},{"ID":"20240613123851-lt9j655","Type":"NodeParagraph","Properties":{"id":"20240613123851-lt9j655","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"治水饮痰辩，胁下痛。\""}]},{"ID":"20240613123851-kgmfxj5","Type":"NodeParagraph","Properties":{"id":"20240613123851-kgmfxj5","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑥《本草原始》：\"煎汁渍丝线，系痔易落，（并能）系瘤。\""}]},{"ID":"20240613123851-l4wczop","Type":"NodeParagraph","Properties":{"id":"20240613123851-l4wczop","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613123851-lbucgpg","Type":"NodeParagraph","Properties":{"id":"20240613123851-lbucgpg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1钱；或入丸、散。外用：研末调敷或煎水含漱。"}]},{"ID":"20240613123851-vpf8sro","Type":"NodeParagraph","Properties":{"id":"20240613123851-vpf8sro","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613123851-2fnrc5u","Type":"NodeParagraph","Properties":{"id":"20240613123851-2fnrc5u","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" ①治太阳中风，下利呕逆，表解，其人絷絷汗出，发作有时，头痛，心下痞鞕满，引胁下痛，干呕短气，汗出不恶寒者：芫花（熬），甘遂、大戟。上三味，等分，各别捣为散，以水一升半，先煮大枣肥者十枚，取八合，去滓，内药末，强人飘一钱匕。羸人服半钱，温服之，平旦服。若下少病不除者，明日更服，加半钱，得快下利后，糜粥自养。（《伤寒论》十枣汤）"}]},{"ID":"20240613123851-8z4zp46","Type":"NodeParagraph","Properties":{"id":"20240613123851-8z4zp46","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"②治卒得咳嗽：芫花一升。水三升，煮取一升，去滓，以枣十四枚，煎令汁尽，一日一食之，三日讫。（《补缺肘后方》）"}]},{"ID":"20240613123851-vcp26ju","Type":"NodeParagraph","Properties":{"id":"20240613123851-vcp26ju","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"③治水病通身微肿，腹大，食饮不消：芫花（微炒），甘遂（微炒），大黄（锉碎、醋炒拌干）、葶苈（炒令紫色）各一两，巴豆（去心，皮，麸炒，研出油尽）四十枚。上五味，捣罗为末，炼蜜为丸，如小豆大，每服，饮下三丸，不知，稍增至五丸，以知为度。（《圣济总录》小消化丸）"}]},{"ID":"20240613123851-chx0h8a","Type":"NodeParagraph","Properties":{"id":"20240613123851-chx0h8a","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"④治蛊胀：枫壳、芫花各等分。上用酽醋浸芫花透，将醋再煮枳壳烂，擂芫花末，和为丸，如梧桐子大。每服数丸，温白汤送下。（《普济方》枳壳丸）"}]},{"ID":"20240613123851-zs3v2e2","Type":"NodeParagraph","Properties":{"id":"20240613123851-zs3v2e2","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑤治时行毒病七、八日，热积聚胸中，烦乱欲死：芫花一升，以水三升，煮取一升半，渍故布薄胸上。不过三薄，热即除，当温暖四肢护厥逆也。（《千金方》凝雪汤）"}]},{"ID":"20240613123851-rzthps3","Type":"NodeParagraph","Properties":{"id":"20240613123851-rzthps3","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑥治疟母弥年，经吐、汗、下，荣卫亏损，邪气伏藏胁间，结为癥癖，腹胁坚痛：芫花（炒），朱砂（研）各等分。为末，炼蜜丸，如小豆。每服十丸，浓煎枣汤下，下后即与养胃汤。（《仁斋直指方》消癖丸）"}]},{"ID":"20240613123851-vmum64j","Type":"NodeParagraph","Properties":{"id":"20240613123851-vmum64j","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑦治痈：尧花为末，胶和如粥敷之。（《千金方》）"}]},{"ID":"20240613123851-0woplzh","Type":"NodeParagraph","Properties":{"id":"20240613123851-0woplzh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑧治急性乳腺炎，兼治深部脓肿：芫花二钱至一两，鸡蛋三至五个。二味同煮，蛋熟后剥去壳，刺数小洞放入再煮，至蛋发黑为度，吃蛋喝汤，每天一至二次，每次一至二个。服后有头昏、恶心者，可吃蛋不喝汤。如反应甚者，以菖蒲煎服解之。孕妇忌服。勿与甘草同服。（《江苏省中草药新医疗法展览资料选编》）"}]},{"ID":"20240613123851-yjafl6r","Type":"NodeParagraph","Properties":{"id":"20240613123851-yjafl6r","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑨治白秃头疮：芫花末，猪脂和涂之。（《集效方》）"}]},{"ID":"20240613123851-3pkhzsn","Type":"NodeParagraph","Properties":{"id":"20240613123851-3pkhzsn","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑩治牙痛，诸药不效者：芫花碾为末，擦痛处令热。（《魏氏家藏方》芫花散）"}]},{"ID":"20240613123851-5ddht79","Type":"NodeParagraph","Properties":{"id":"20240613123851-5ddht79","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑾治小瘤：先用甘草煎膏，笔蘸妆瘤傍四围，干后复妆，凡三次，然后以药：大戟、芫花、甘草（等分），上为末，米醋调，别笔妆敷其中，不得近著甘草处。次日缩小，又以甘草膏壮小晕三次，中间仍用大戟、芫花、甘草如前法，自然焦缩。（《世医得效方》）"}]},{"ID":"20240613123851-z8yzyiw","Type":"NodeParagraph","Properties":{"id":"20240613123851-z8yzyiw","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑿治心痛有虫：芫花一两（蜡炒），雄黄一钱。为末，每服一字，温醋汤下。（《乾坤生意》）"}]},{"ID":"20240613123851-36l597z","Type":"NodeParagraph","Properties":{"id":"20240613123851-36l597z","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒀治诸般气痛：芫花（醋煮）半两，延胡索（炒）一两半。为末，每服一钱。疟疾，乌梅汤下；妇人血气痛，当归酒下；诸气痛，香附汤下；小肠气痛，茴香汤下。（《仁存堂经验方》）"}]},{"ID":"20240613123851-i32nusf","Type":"NodeParagraph","Properties":{"id":"20240613123851-i32nusf","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⑷治酒疸，心懊痛，足胫满，小便黄，饮酒发赤斑黄黑，由大醉当风入水所致：芫花、椒目等分。烧末，服半钱，日一两遍。（《补块肘后方》）"}]},{"ID":"20240613123851-o0rb2oo","Type":"NodeParagraph","Properties":{"id":"20240613123851-o0rb2oo","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒂治一切菌毒：芫花生研，新汲水服一钱，以利为度。（《世医得效方》）"}]},{"ID":"20240613123851-r757ogl","Type":"NodeParagraph","Properties":{"id":"20240613123851-r757ogl","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒃治妇人积年血气癥块结痛：芫花一两（醋拌炒令干），当归一两（锉，微炒），桂心一两，上药，捣罗为末，以软饭和丸，如梧桐子大。每服，食前以热酒下十丸。（《圣惠方》）"}]},{"ID":"20240613123851-trfjw04","Type":"NodeParagraph","Properties":{"id":"20240613123851-trfjw04","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒄突发咳嗽。用芫花一升，加水三升煮汁一升，以枣十四枚，放入汁中煮干，一天吃五枚，必愈。"}]},{"ID":"20240613123851-rf4hi5j","Type":"NodeParagraph","Properties":{"id":"20240613123851-rf4hi5j","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒅咳嗽有痰。用芫花一两（炒），加水一升，煮开四次，去渣，再加入白糖半斤。每服约一个枣子大的量。忌食酸咸物。"}]},{"ID":"20240613123851-3up1qdk","Type":"NodeParagraph","Properties":{"id":"20240613123851-3up1qdk","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒆干呕胁痛（伤寒有时头痛，心下痞满，痛引两胁，干呕短气，汗出而不恶寒）。用芫花（熬过）、甘遂、大戟，等分为末。以大枣十枚、水一升半，煮成八合后，去渣纳药。体壮者服一钱，弱者半钱，清晨服下。能下泻则病除，否则次晨再服药。此方名\"十枣汤\"。"}]},{"ID":"20240613123851-0t3184g","Type":"NodeParagraph","Properties":{"id":"20240613123851-0t3184g","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"⒇水肿。用上方（十枣汤）加大黄、甘草五物各一两，大枣十枚，同煮，如法服。另方：药中再加硭硝一两。"}]},{"ID":"20240613123851-xv5oq26","Type":"NodeParagraph","Properties":{"id":"20240613123851-xv5oq26","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（21）久疟，腹胁坚痛。用芫花（炒）二两，朱砂五钱，共研为末，加蜜做成丸子，如梧子大。每服十丸，枣汤送下。"}]},{"ID":"20240613123851-dtppipd","Type":"NodeParagraph","Properties":{"id":"20240613123851-dtppipd","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（22）水盅胀满。用芫花、枳壳等分，先以醋把芫花煮烂，再加可枳壳煮烂，一起捣匀做丸子，如梧子大。每服三十丸，白汤送下。"}]},{"ID":"20240613123851-wzzhecn","Type":"NodeParagraph","Properties":{"id":"20240613123851-wzzhecn","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（23）子宫结块，月经不通。用芫花根三两，锉细，炒黄，研为末。每服一钱，桃仁煎汤调下。泻下恶物即愈。"}]},{"ID":"20240613123851-px3o9oj","Type":"NodeParagraph","Properties":{"id":"20240613123851-px3o9oj","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（24）牙痛难忍，诸药不效。用芫花末擦牙令热。痛定后，以温水漱口。"}]},{"ID":"20240613123851-0kwls8f","Type":"NodeParagraph","Properties":{"id":"20240613123851-0kwls8f","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（25）痈肿初起。用芫花末和胶涂搽。"}]},{"ID":"20240613123851-3viurwn","Type":"NodeParagraph","Properties":{"id":"20240613123851-3viurwn","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"（26）痔疮。用芫根一把，捣烂，慢火煎成膏，将丝线于膏内度过，以线系痔，当有微痛的感觉。等痔疮干落后，即以纸捻蘸膏纳入肛门中，可以便痔疮断根。另方：只捣汁浸线一夜即用，不必熬膏。"}]},{"ID":"20240613123851-46jsksp","Type":"NodeParagraph","Properties":{"id":"20240613123851-46jsksp","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613123851-w21az2b","Type":"NodeParagraph","Properties":{"id":"20240613123851-w21az2b","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" ①治疗传染性肝炎"}]},{"ID":"20240613123851-s1mc6xm","Type":"NodeParagraph","Properties":{"id":"20240613123851-s1mc6xm","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"初步观察，黄芫花对急、慢性肝炎有促使谷丙转氨酶值趋于正常和自觉症状改善的作用，特别对转氨晦持续不降的病例，用药一定时间后可获得改善。但对其它肝功能指标的改变并不突出。制剂与用法：㈠水浸膏片（每片含干浸膏0.35克），成人每服5片，每日3次。㈡脱脂醇浸膏片（含量同上），成人每次2片，日服3次。㈢黄芫花酮片（每片含黄酮50毫克），每次2片，日服3次。"}]},{"ID":"20240613123851-j286ahl","Type":"NodeParagraph","Properties":{"id":"20240613123851-j286ahl","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"②治疗精神病"}]},{"ID":"20240613123851-aupdoqk","Type":"NodeParagraph","Properties":{"id":"20240613123851-aupdoqk","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"取黄芫花花蕾及叶晒干研粉，过筛备用。成人每天2～4克，连服3～7天。治疗精神分裂症、躁抑症、神经官能症、癫痫等计153例，结果痊愈71例（46.5％），好转46例（30.1％）。一般连服3～7天即可见效。如不见效，休息几天，再服一疗程。其主要作用能使兴奋型病人安静，抑郁型病人情绪活跃，忧虑型病人有所缓解。又报道每日用黄芫花粉4～10克，饭前顿服，治疗精神病152倒，有效率达73％。副作用有不同程度的胃部灼痛和腹泻。体弱者偶有虚脱现象。凡发热、体弱、消化道疾患、孕妇均忌服。"}]},{"ID":"20240613123851-zx894pi","Type":"NodeParagraph","Properties":{"id":"20240613123851-zx894pi","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613123851-4gpyq3r","Type":"NodeParagraph","Properties":{"id":"20240613123851-4gpyq3r","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 除上述品种外，尚有黄芫花，为同科植物河朔芫花的干燥花蕾。与芜花相似而略小，长约0.3～1厘米。表面灰绿色或灰黄色，有白色细绒毛。产于山西、陕西、甘肃、内蒙古等地，亦同等使用。"}]},{"ID":"20240613123851-vd8h023","Type":"NodeParagraph","Properties":{"id":"20240613123851-vd8h023","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613123851-khyapoh","Type":"NodeParagraph","Properties":{"id":"20240613123851-khyapoh","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613123851-cheucg7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123851-cheucg7","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"《中华本草》：芫花"}]},{"ID":"20240613123851-d0004gy","Type":"NodeParagraph","Properties":{"id":"20240613123851-d0004gy","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613123851-ahzdbrv","Type":"NodeParagraph","Properties":{"id":"20240613123851-ahzdbrv","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" Yuán Huā"}]},{"ID":"20240613123851-tdutq0m","Type":"NodeParagraph","Properties":{"id":"20240613123851-tdutq0m","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613123851-d0q8zm3","Type":"NodeParagraph","Properties":{"id":"20240613123851-d0q8zm3","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 芫、去水、赤芫、败花、毒鱼、杜芫、头痛花、闷头花、老鼠花、闹鱼花、棉花条、大米花、芫条花、地棉花、九龙花、芫花条、癞头花、南芫花、毒老鼠花、紫金花。"}]},{"ID":"20240613123851-iez5yjr","Type":"NodeParagraph","Properties":{"id":"20240613123851-iez5yjr","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613123851-encivh4","Type":"NodeParagraph","Properties":{"id":"20240613123851-encivh4","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" Lilac Daphne Flower Bud，Flower bud of Lilac Daphne"}]},{"ID":"20240613123851-god23eb","Type":"NodeParagraph","Properties":{"id":"20240613123851-god23eb","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613123851-kr61uzs","Type":"NodeParagraph","Properties":{"id":"20240613123851-kr61uzs","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613123851-fal6u7l","Type":"NodeParagraph","Properties":{"id":"20240613123851-fal6u7l","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613123851-4qovtwt","Type":"NodeParagraph","Properties":{"id":"20240613123851-4qovtwt","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 药材基源：为瑞香科植物芫花的花蕾。"}]},{"ID":"20240613123851-hfv5bwr","Type":"NodeParagraph","Properties":{"id":"20240613123851-hfv5bwr","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Daphne genkwa Sieb.et Zucc."}]},{"ID":"20240613123851-a4kyobg","Type":"NodeParagraph","Properties":{"id":"20240613123851-a4kyobg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春季花未开放前采摘，拣去杂质，晒干或烘干。"}]},{"ID":"20240613123851-hibl78n","Type":"NodeParagraph","Properties":{"id":"20240613123851-hibl78n","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613123851-eitydnl","Type":"NodeParagraph","Properties":{"id":"20240613123851-eitydnl","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于路旁、山坡或栽培于庭园。"}]},{"ID":"20240613123851-evk8kge","Type":"NodeParagraph","Properties":{"id":"20240613123851-evk8kge","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东及河北、陕西、河南、湖北、湖南、四川、贵州等地。"}]},{"ID":"20240613123851-ahg2rxe","Type":"NodeParagraph","Properties":{"id":"20240613123851-ahg2rxe","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613123851-qsfli04","Type":"NodeParagraph","Properties":{"id":"20240613123851-qsfli04","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 芫花 直立落叶灌木，高达1m。根长者可达10cm，主根直径0.6-1.5cm，有分歧，外表黄棕色至黄褐色；根皮富韧性。茎直径至1cm，暗棕色；枝细长，褐紫色，幼时密生绢状短柔毛。叶对生，间或互生；有短柄，长约1mm，被短柔毛；叶片椭圆形至长椭圆形，长2.5-5cm，宽0.8-2cm，稍带革质，先端尖，全缘，幼时叶之两面流生绢状短柔毛，以脉上为密，老则渐脱。花淡紫色，腋生，先叶开放，通常3-7朵生叶腋间短梗上，以枝端为多；花两性，无花瓣；花被管细长，长约1cm，密被绢状短柔毛，先端4裂，裂片卵形，长不及1cm；雄蕊8，2轮，着生于花被管上，不具花丝；雌蕊1，子房上位，1室，花柱极短或缺如，柱头头状。核果革质，白色。种子1颗，黑色。花期3-4月，果期5月。"}]},{"ID":"20240613123851-mmhkj55","Type":"NodeParagraph","Properties":{"id":"20240613123851-mmhkj55","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613123851-oa5wdgs","Type":"NodeParagraph","Properties":{"id":"20240613123851-oa5wdgs","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 生物学特性 宜温暖的气候，性耐旱怕涝，以肥沃疏松的砂质土壤栽培为宜。"}]},{"ID":"20240613123851-50b6ktr","Type":"NodeParagraph","Properties":{"id":"20240613123851-50b6ktr","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖或分株繁殖。种子繁殖：播种期10月下旬至11月上旬，按行距30cm开条沟，将种子均匀播下，覆土压实，至明春发芽。出苗后注意间苗除草，每年追肥2-3次，经2-3年移栽。分株繁殖：早春3月间，挖取老根，分株按行株距30cm×40cm开穴，每穴栽种1株，覆土压实。"}]},{"ID":"20240613123851-51q7hhm","Type":"NodeParagraph","Properties":{"id":"20240613123851-51q7hhm","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"田间管理 每年要中耕除草3-4次。春、秋两季各追肥1次，春季追肥要早，秋季追肥结合壅根。夏、冬两季可分别间种玉米和蔬菜。"}]},{"ID":"20240613123851-x1iohrx","Type":"NodeParagraph","Properties":{"id":"20240613123851-x1iohrx","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613123851-57mnsnf","Type":"NodeParagraph","Properties":{"id":"20240613123851-57mnsnf","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 花蕾呈棒槌状，稍压扁，多数弯曲，长1-1.7cm，直径约1.5mm；常3-7朵簇生于一短柄上，基部有1-2片密被黄色绒毛的苞片。花被筒表面淡紫色或灰绿色，密被白色短柔毛，先端4裂，裂片卵形。质软。气微，味微辛。以花淡紫色或灰紫色、无杂质者为佳。"}]},{"ID":"20240613123851-kzn50qw","Type":"NodeParagraph","Properties":{"id":"20240613123851-kzn50qw","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"显微鉴别 ①花被下表面有单细胞非腺毛，多弯曲，长90-780μm，直径15-25μm，壁较厚，稍具疣状突起。②花粉粒类球形，黄色，直径25-45μm，表面有网状雕纹。"}]},{"ID":"20240613123851-aogfmxe","Type":"NodeParagraph","Properties":{"id":"20240613123851-aogfmxe","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613123851-3s5dvt6","Type":"NodeParagraph","Properties":{"id":"20240613123851-3s5dvt6","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.毒性：芫花煎剂小鼠腹腔注射LD20为5.5±0.36g/kg；芫花与醋制芜花醇浸剂，小鼠腹腔注射LD50分别为1.0g/kg和7.07g/kg，而其水浸剂的LD50分别为8.30kg/kg与17.78kg/kg。芫花煎剂大鼠腹腔注射的LD50为9.25g／kg。醋制或苯制芫花醇水提取液，小鼠灌胃的LD50为8.48±1.18g／kg与14.05±2.03g／kg。芫花与醋制芫花的醇浸剂，小鼠腹腔注射的LD50分别为1.0g/kg与7.07g／kg，而其水浸剂的LD50分别为8.30g／kg与17.78g／kg，说明醋制能降低生芫花的毒性。芫花萜乳剂与醇剂给小鼠腹腔注射的LD50分别为1.8与1.9mg／kg。芫花萜醇剂给孕猴每日腹腔注射20-100μg/kg，连续10天，可见主要脏器有明显病变，因弥漫性和血管内凝血死亡。宫腔注射、皮下注射或静脉注射芫花萜可使动物产生发热现象，可能由于胎盘内的芫花萜引起的严重化学炎症，或因流产时强烈宫缩将羊水挤入母体血液循环引起的反应所致。肾上腺皮质激素对发热有明显预防与治疗作用。阿司匹林也可防止出现发热反应。兔亚急性毒性实验结果表明，用醋制或苯制混悬液0.25与0.5g／kg，连续灌胃28天未见明显毒性，芫花萜乳剂0.2-0.8mg对猴羊膜腔给药也无明显影响。动物实验表明，芫花与甘草合用，其利尿、泻下作用受抑制，且毒性增强，提示两药不宜合用。但另一研究表明炙芫花单用或与甘草合用对小毒均未出现毒性反应及死亡。另有研究报道了芫花炮制及其相反药物配伍的毒性作用和诱变试验。"}]},{"ID":"20240613123851-r3j3t28","Type":"NodeParagraph","Properties":{"id":"20240613123851-r3j3t28","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"2.炮制对毒性的影响：取健康雌性小鼠（18-21g）50只，随机分为5组，每组10只，腹腔注射药剂，观察72小时动物死亡数。可见LD50醋炙品比生品提高一倍，说明芫花醋炙起到了降低毒性作用。"}]},{"ID":"20240613123851-4g6mdqt","Type":"NodeParagraph","Properties":{"id":"20240613123851-4g6mdqt","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"3.相反药物配伍对毒性的影响：杨致礼报道选健康小白鼠568只（体重28-36g），健康家兔301只（体重1.5-2.5kg）。均于实验前进行健康观察7天。平均体温38.94±0.46-39.73±0.22℃，球虫卵囊检查粪便潜血。精神、饮食欲、粪便均正常，实验的全部小白鼠、家兔雌雄搭配，经预实验后随机分为单味组、配伍组与对照组（见表10），实验结果，小鼠灌胃芫花水浸煎剂（浸泡24小时后煎煮浓缩，每1ml相当于生药1g，下同）及煎剂（未经浸泡煎煮二遍后过滤浓缩，每1ml相当于生药2g）。连续观察精神、饮食欲、粪便72小时，未明异常。小鼠灌胃芫花十甘草等量配伍同煎剂，连续观察72小时也无反应，家兔灌胃芫花水浸煎剂后分别在5、24、28小时观察，体温、精神、饮食欲、粪便均正常。与健康对照组相比无明显变化。用芫花水浸煎剂及芫花加甘草等量配伍同煎剂给小鼠腹腔注射，配伍组比单味组毒性强。"}]},{"ID":"20240613123851-ilexqtq","Type":"NodeParagraph","Properties":{"id":"20240613123851-ilexqtq","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"4.诱变试验：选用芫花、甘遂、大戟、甘草等药配伍成C、L、T、G丸，应用鼠伤寒沙门氏菌加哺乳动物肝微粒体酶检测系统，以及杜草杆菌重组修复试验对该丸进行了诱变性测试，结果无论加不加S9活化系统（由多氯联苯诱导的SD大鼠肝匀浆S9加辅助液组成，每9ml辅助液加1mlS9组成S9混合液。每100ml辅助液含NADP300mg、G-6-Pl06mg、磷酸盐缓冲液50ml、蒸馏水48ml，盐溶液2ml），C、L、T、G丸均不能诱发TA93和TA98株（需组氨酸的鼠伤寒沙门氏菌突变株（his-s）的回复突变，有理由认为液药对Ames法TA93及TA900株不表现诱变活性。另外，无论加不加S9活化系统，低浓度时受试物对枯草杆菌具有修复功能的H17和重组修复缺陷的衍生株M45均无抑菌作用，高浓度下有弱的抑制，但对M45和H17作用相等。可以认为：C、L、T、G丸无DNA损伤作用。"}]},{"ID":"20240613123851-lnmh7en","Type":"NodeParagraph","Properties":{"id":"20240613123851-lnmh7en","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613123851-a0f37z3","Type":"NodeParagraph","Properties":{"id":"20240613123851-a0f37z3","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 花与花蕾含二萜原酸酯类化合物：花含芫花酯甲（yuanhuacin），芫花酯乙（yuanhuadin），芫花酯丙（yuanhuafin），芫花瑞香宁（genkwadaphnin）即12-苯甲酰氧基瑞香毒素（12-benzoxydaphnetoxin）；花蕾含芫花酯丁（yuanhuatin），芫花酯戊（yuanhuapin）。黄酮类化合物：芫花素（genkwanin），3’-羟基芫花素（3-hydroxygenkwanin）即木犀草素-7-甲醇（luteolin-7-methylether），芫根甙（yuankanin），芹菜素（apigenin），木犀草素（luteolin），茸毛椴甙（tilirosid）即山柰酚-3-O-β-D-（6〃-对香豆酰）吡喃葡萄糖甙[kaempferol-3-O-β-D-（6〃-pcoumaroyl）glucopyranoside]。"}]},{"ID":"20240613123851-fwzjs6v","Type":"NodeParagraph","Properties":{"id":"20240613123851-fwzjs6v","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"花挥发油中含大量脂肪酸，棕榈酸（palmitic aicd）、油酸（ole-ic acid）和亚油酸（linoleic acid）含量较高，约占总油量的60％；尚含正二十四烷（n-tetracosane），正十五烷（n-pentadecane），正十二醛（n-dodecanal），十一醛（undecanal），苯甲醛（benzaldehyde），a-呋喃甲醛（a-furaldehyde），苯乙醇（phenylethanol），1-辛烯-3-醇（1-octene-3-ol），葎草烯（humulene），丙酸牻牛儿醇酯（geraniolpropionate）和橙花醇戊酸酯（nerol pentanoate）等。"}]},{"ID":"20240613123851-li4bhpv","Type":"NodeParagraph","Properties":{"id":"20240613123851-li4bhpv","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613123851-idbpijx","Type":"NodeParagraph","Properties":{"id":"20240613123851-idbpijx","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.利尿作用：吕向华报道，大鼠灌胃l0g／kg的芫花煎剂组与对照组相比，排尿与排钠率有明显增加，排钾量相近。剂量为20g／kg时，排尿、排钠率及排钾量均有显着增加，但2.5或5g／kg则无效。另据报道给麻醉犬静脉注射50%的芫花煎剂0.4-1.0g／kg，可使尿量增加一倍以上，约维持20分钟。用3%氯化钠液腹腔注射形成腹水的大鼠灌胃10g／kg的芫花煎剂或醇浸剂，均有利尿作用。"}]},{"ID":"20240613123851-v2453c8","Type":"NodeParagraph","Properties":{"id":"20240613123851-v2453c8","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"2.镇咳、祛痰作用：氨水喷雾法引咳实验结果表明，小鼠灌胃1.25g／kg醋制芫花与苯制芫花的醇水提取液，或0.625g/kg羟基芫花素均有止咳作用。酚红排泄实验表明，小鼠灌胃5g／kg醋制芫花与苯制芫花醇水提取液或0.625g/kg羟基芫花素，均有一定祛痰作用，其祛痰机理可能与治疗后炎症减轻、痰液粘滞度降低有关。"}]},{"ID":"20240613123851-znl8j7j","Type":"NodeParagraph","Properties":{"id":"20240613123851-znl8j7j","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"3.对中枢神经系统的作用：据肖庆慈等报道，选用体重15-25g昆明小白鼠90只，雌雄皆有，随机分组，每组10只，共分9组，按表4中所列剂量灌胃给药，采用YsD-4药理生理实验多用仪，电刺激箱进行测记，观察不同时间里引起小白鼠尖叫时的电压数（mv）。结果见表4。表明小白鼠口服20g／kg单味甘草或炙芫花煎剂后有一定镇痛作用。且炙芫花伏于甘草。合用后与同剂量之单味煎剂比较，镇痛作用优于甘草、次于炙芫花。另据魏成武等报道芫花乙醇提取物腹腔注射500mg／kg（折合成生药，下同）在热板法、酒石酸锑钾扭体法及电击法中，对小鼠都有明显镇痛作用，并且吗啡受体拮抗剂纳洛酮能阻断其镇痛作用。在小鼠转棒实验中，腹腔注射l000mg／kg的芫花乙醇提取物显示明显镇静作用，在抗士的宁或苯甲酸钠咖啡因惊厥实验中，有明显抗惊厥作用，抗土的宁惊厥作用较强；此外，芫花还能明显增强异戊巴比妥钠对犬的麻醉作用。"}]},{"ID":"20240613123851-awjy7ak","Type":"NodeParagraph","Properties":{"id":"20240613123851-awjy7ak","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"4.对消化系统的作用：。"}]},{"ID":"20240613123851-xm4ao5i","Type":"NodeParagraph","Properties":{"id":"20240613123851-xm4ao5i","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"4.1.对动物离体肠段的影响:取约2kg重的健康成年家兔数只，雌雄皆有，急性处死后取出空肠，常规处理，保存于台氏（Tyrode）液中备用，实验共分20组进行，结果表明，药物在高浓度时，炙芫花对肠段的兴奋作用优于甘草，低浓度时则甘草伏于芫花。卞如濂亦报道:1.8mg（生药）／ml生芫花与醋制芫花的50%水煎剂、水浸剂及醇浸剂均有兴奋离体兔回肠的作用，能使肠蠕动增加，张力提高、加大剂量则呈现抑制作用。生芫花与醋制芫花醇浸剂对兔能轻度致泻，对犬除轻度致泻外，尚有致吐作用，对小鼠则无此作用。另据报道1%芫花之刺激性油状物，可使大鼠离体十二指肠呈强直收缩，对兔离体十二指肠则先兴奋后抑制，10%醋制与10%苯制芫花（用苯除去油状物后配成），均有类似作用。"}]},{"ID":"20240613123851-f5ffm4u","Type":"NodeParagraph","Properties":{"id":"20240613123851-f5ffm4u","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"4.2.对大白鼠肠蠕动的作用:用大白鼠全肠推进法，取大白鼠随机分为3组，绝食24h后，口服灌胃生芫花和醋炙芫花药剂（按40g／kg给药），同时给5%炭末，l小时后处理大鼠。设对照组观察，生及醋炙芫花组的炭末推进长度，测出大白鼠的小肠全长（mm），求出推进率（各组以10只计）。表明芫花生品与醋炙品对大白鼠肠蠕动有轻度兴奋作用，使肠蠕动加快，生芫花组炭末染色长度较对照组平均增加6.4%；醋炙芫花组与对照组比较平均增加9.7%；说明芫花醋炙后，对肠蠕动作用较生品强。"}]},{"ID":"20240613123851-yg196b2","Type":"NodeParagraph","Properties":{"id":"20240613123851-yg196b2","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"5.抗生育作用：芫花萜与雌二醇合用，对大鼠离体子宫有协同作用，对子宫颈的作用弱于子宫体，且与雌二醇无协同作用。兔宫颈注射100μg/kg芫花萜，引起强烈宫缩。犬静脉注射芫花素有相同作用。孕猴宫腔内给药也能引起流产。且局部给药作用加强，静脉注射反应慢或不明显。致流产原因，从芫花萜引产下来的胎盘和胎儿的病理检查结果可见，退变的绒毛蜕膜组织血栓形成、红细胞破坏、胎盘绒毛膜板下有大量中性多形核白细胞集聚，系药物注入后引起炎症细胞浸润之故；胎儿各器官的血管明显扩张瘀血）组织水肿、出血，细胞肿胀等病理改变系药物对局部组织的直接作用；蜕膜细胞退变坏死，以及胶带的炎性细胞浸润和水肿，可能是内源性前列腺素的分泌释放增多，致子宫平滑肌细胞收缩增强，而达到引产的目的。从细胞超微结构功能看，给药后可引起蜕膜与胎盘明显变性坏死，使溶酶体破坏释放大量磷酸脂酶A，导致继续保持分泌功能的蜕膜中粗面内质网加速合成与释放前列腺素。实验证明引产孕妇羊水内，随着前列腺素含量增加，伴有产程开始，刺激子宫平滑肌收缩引起流产。由此进一步说明芫花萜引产机理中，内源性前列腺素起着重要作用。在引产中可观察到HCG（缄毛膜促性腺激素）、雌二醇与雌三醇皆下降，说明药物对胎盘组织有一定损害，孕激素水平下降，有利于宫缩发动，可能是引起流产的辅因。另一项研究表明，芫花萜（20μg/ml）对鼠胚脱氧核糖核酸（DNA）合成有一定抑制作用。以3H一芫花萜注射于孕兔羊膜腔，48小时内羊水、胎盘与胎儿放射性为最强，母血与内脏器官放射性甚弱，尿中72小时排泄量仅为注入量的9.1%，可见临床上宫腔给药引产比较安全。"}]},{"ID":"20240613123851-jv5o6ae","Type":"NodeParagraph","Properties":{"id":"20240613123851-jv5o6ae","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"6.对黄嘌呤氧化酶（XO）的抑制作用：1983年Noro，Tacataka等在从生药和植物药中寻找XO抑制剂时，发现芫花的花和芽对XO具有强的抑制作用，并从中分离出芫花素、芹菜素、3-羟基芫花素和木犀草素四种对XO有抑制作用的成分，它们的抑制活性IC50分别为7×10（-5）M、7.4×10（-7）M、10-5M和5.9×10（-7）M。芹菜素和木犀草素是XO的最强抑制剂。这些黄酮类化合物在该试验条件下对单胺氧化酶未表现有强的抑制活性。"}]},{"ID":"20240613123851-2k2w2a1","Type":"NodeParagraph","Properties":{"id":"20240613123851-2k2w2a1","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"7.抗白血病作用：Hall IH和Noro T等分别从芫花花部的甲醇提取物中分离得到两种强力抗P-388淋巴细胞性白血病的二萜化合物-芫花瑞香宁和芫花酯甲。两者在体内低剂量（0.8mg／kg）时，即显强力抑制活性，其T／C值分别为175%和151%。研究还表明，芫花瑞香宁与芫花酯甲均可抑制P-388癌细胞核酸与蛋白质的合成，对前者的抑制作用，系在DNA聚合酶与嘌呤合成中的磷酸核糖氨基转移酶，肌苷酸脱氢酶及二氢叶酸还原酶；对后者系在延伸步骤中阻抑与干扰肽基转移酶的反应。"}]},{"ID":"20240613123851-6zn5pay","Type":"NodeParagraph","Properties":{"id":"20240613123851-6zn5pay","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"8.抗菌作用：体外试验1：50浓度的醋制芫花及苯制芫花醇水提取液对肺炎球菌、溶血链球菌、流行性感冒杆菌均有抑制作用。芫花水浸液（1：4）在试管内对许兰氏杆菌、奥杜盎氏小孢子菌、星形奴卡氏菌等皮肤真菌均有不同程度的抑制作用。而芫花素无抗菌作用。"}]},{"ID":"20240613123851-rqgf190","Type":"NodeParagraph","Properties":{"id":"20240613123851-rqgf190","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"9.其它作用：芫花甲醇提取物对cAMP磷酸二酯酶（PDE）具有抑制活性，并从中分离得到3种化合物，其中一种为强抑制PDE活性成分，初步鉴定为芹菜素二葡萄糖甙（Apigenin diglycoside）。免股四头肌刺激实验表明，5mg、0.5ml芫花萜醇液有严重局部刺激反应。"}]},{"ID":"20240613123851-emwon5c","Type":"NodeParagraph","Properties":{"id":"20240613123851-emwon5c","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.此外，芫花叶和芫花根尚有下列药理作用：。"}]},{"ID":"20240613123851-j3lys6v","Type":"NodeParagraph","Properties":{"id":"20240613123851-j3lys6v","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.1对心血管系统的作用：。"}]},{"ID":"20240613123851-01iw5qz","Type":"NodeParagraph","Properties":{"id":"20240613123851-01iw5qz","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.1.1.对豚鼠离体心脏的作用：取豚鼠8只，重350-600g，处死后迅速取出心脏，按Langendorff氏法用37℃，恒温通氧的任洛氏液以高度70cm的恒压灌流心脏。约经15分钟待心脏活动和流量稳定后在灌流液中加入芫花叶提取液浓度达到0.6g／100ml（生药含量，下同），观察冠脉流量及心率变化。结果表明芫花叶有明显的增加冠脉流量的作用，但心率变化不明显。"}]},{"ID":"20240613123851-rgog5jw","Type":"NodeParagraph","Properties":{"id":"20240613123851-rgog5jw","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.1.2.对离体蛙心的影响：按斯氏（Straub）离体蛙心灌流法制备离体蛙心，实验动物为滇蛙每组五个蛙心，共分20组进行实验，取平均值作曲线并比较，可见0.31-5%的芫花煎剂高浓度时对离体蛙心的收缩力及频率呈现明显的抑制作用，低浓度时抑制作用较弱或不明显。"}]},{"ID":"20240613123851-78tp9nv","Type":"NodeParagraph","Properties":{"id":"20240613123851-78tp9nv","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.1.3.对小鼠急性缺氧耐受力的影响选用体重20-28g的健康小鼠30只，按性别和体重分为2组，每只小鼠皮下注射异丙肾上腺素10mg／kg，给药组同时腹腔注射芫花叶0.05g／kg，对照组则注射相同容量的生理盐水。30分钟后分别选择性别相同，体重相近的给药鼠和对照鼠各1只，组成配对置于内有10g钠石灰的密闭器中，观察得给药组小鼠的平均存活时间炒877.9±33.0秒，对照组小鼠的存活时间为715±32.3秒。T值测验两组有非常显着的差异（P＜0.01)。"}]},{"ID":"20240613123851-1yi1iy7","Type":"NodeParagraph","Properties":{"id":"20240613123851-1yi1iy7","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.1.4.对冠脉结扎猫血清磷酸肌酸激酶（CPK）的影响猫体重2.0-3.8kg，雌雄皆用，以戊巴比妥纳腹腔麻醉后背位固定，气管接人工呼吸器，并用水银检压计记录左颈动脉血压。开胸，暴露心脏，在左冠状动脉前降支下离冠脉起源12-14mm处穿一丝线，待血压稳定后结扎前降支。给药组猫在结扎冠脉后，立即通过股静脉注射注入芫花叶注射液0.75g／kg，并在以后5小时内用恒流泵以0.375g/kg/h的速度补充，对照组给予同体积的生理盐水。在冠脉结扎前5分钟及结扎后5小时内，每h从左颈总动脉取血1ml，测定血清磷酸肌酸激酶（CPK）活性，考虑到手术造成的骨骼肌损伤可造成血清CPK活性的提高，另外再设空白组，此组猫仅在左冠状动脉前降支下穿一丝线，不作结扎，股静脉注射给予相同体积的生理盐水，其它所有手术过程均与上述两组相同，首次取血在穿线前5分钟，以后取血间隔时间也与上述两组相同。经测定三组猫在5小时内血清CPK活性均较冠脉结扎前或心肌穿线前有所增强，但程度不同，其中对照组猫的CPK活性增强最为明显。由于对照组与空白组的所有手术过程相同，因此这两组间的差异可被看作是结扎冠脉引起的，向对照组和给药组均为结扎冠脉动物，所以后两组间的差异是由药物引起的。"}]},{"ID":"20240613123851-f32w33m","Type":"NodeParagraph","Properties":{"id":"20240613123851-f32w33m","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.1.5.对麻醉猫的急性降压作用和对心率的影响麻醉猫6只，重2.0-2.0kg，股静脉注射芫花叶注射液1g／kg约1分钟后，血压由116.2±7mmHg迅速下降至65.8±6.1mmHg，下降43.5±3.O%，降压作用维持2分钟左右，其中2只猫在剪断双侧迷走神经后再次注射，其降压作用未见明显影响。另猫3只静脉注射阿托品lmg／kg后，再注射芫花叶，其降压作用略见减弱，据此分析降压机制可能主要不是通过迷走神经。10分钟内猫心率变化不明显，心律也未见异常。"}]},{"ID":"20240613123851-uzuh8ms","Type":"NodeParagraph","Properties":{"id":"20240613123851-uzuh8ms","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.2.冠状动脉扩张作用：十万分之一的芫根乙素水溶液离体肠鼠心脏灌流，具明显扩张作用，效价略低于二甲氧基甲基呋喃色原酮（khellin）。"}]},{"ID":"20240613123851-87p8apo","Type":"NodeParagraph","Properties":{"id":"20240613123851-87p8apo","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.3.毒鱼作用：芫根乙素十万分之一的水溶液可使金鱼30分钟内致死，似khellin类呋喃色原酮的毒鱼作用。"}]},{"ID":"20240613123851-u3hh5z2","Type":"NodeParagraph","Properties":{"id":"20240613123851-u3hh5z2","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613123851-y83hs2d","Type":"NodeParagraph","Properties":{"id":"20240613123851-y83hs2d","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.芫花：拣净杂质，筛去泥土。"}]},{"ID":"20240613123851-jenpby9","Type":"NodeParagraph","Properties":{"id":"20240613123851-jenpby9","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"2.醋芫花：取净芫花，加醋拌匀，润透，置锅内用文火炒至醋吸尽，呈微黄色，取出，晾干。（每芫花100斤，用醋25斤）。"}]},{"ID":"20240613123851-5awjs6y","Type":"NodeParagraph","Properties":{"id":"20240613123851-5awjs6y","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613123851-9n2rmnv","Type":"NodeParagraph","Properties":{"id":"20240613123851-9n2rmnv","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末1g，加乙醇10ml，加热回流1h，滤过。滤液供下列实验：（1）取滤液1滴，点于滤纸上，加1％三氯化铁溶液1滴，显污绿色。（检查酚类）（2）取滤液2ml，加镁粉少量与盐酸1滴，必要时置水浴上稍加热，即显红色。（检查黄酮类）"}]},{"ID":"20240613123851-kwnc8yg","Type":"NodeParagraph","Properties":{"id":"20240613123851-kwnc8yg","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613123851-m7i4zb1","Type":"NodeParagraph","Properties":{"id":"20240613123851-m7i4zb1","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 肺；脾；肾；膀胱经"}]},{"ID":"20240613123851-ooo7ung","Type":"NodeParagraph","Properties":{"id":"20240613123851-ooo7ung","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613123851-8um1sdd","Type":"NodeParagraph","Properties":{"id":"20240613123851-8um1sdd","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 辛；苦；性温；有毒"}]},{"ID":"20240613123851-9oru309","Type":"NodeParagraph","Properties":{"id":"20240613123851-9oru309","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613123851-mzfsbl7","Type":"NodeParagraph","Properties":{"id":"20240613123851-mzfsbl7","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.体质虚弱及孕妇禁服。"}]},{"ID":"20240613123851-wm6wgnx","Type":"NodeParagraph","Properties":{"id":"20240613123851-wm6wgnx","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：决明为之使。反甘草。"}]},{"ID":"20240613123851-95sxn05","Type":"NodeParagraph","Properties":{"id":"20240613123851-95sxn05","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613123851-zd18oqr","Type":"NodeParagraph","Properties":{"id":"20240613123851-zd18oqr","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 泻水逐饮；祛痰止咳；解毒杀虫。主水肿；膨胀；痰饮胸水；喘咳；痈疖疮癣"}]},{"ID":"20240613123851-4ugn0aw","Type":"NodeParagraph","Properties":{"id":"20240613123851-4ugn0aw","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613123851-vbach7n","Type":"NodeParagraph","Properties":{"id":"20240613123851-vbach7n","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5-3g；研末服0.6-1g，每日1次。外用：研末调敷或煎水洗。"}]},{"ID":"20240613123851-psw6xq2","Type":"NodeParagraph","Properties":{"id":"20240613123851-psw6xq2","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613123851-83yuyth","Type":"NodeParagraph","Properties":{"id":"20240613123851-83yuyth","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.芫花丸(《太平圣惠方》)。2.芫花丸(《普济本事方》)，治积聚停饮，痰水生虫，久则成反胃，及变为胃痈。3.十枣汤(《伤寒论》)，功能攻逐水饮，治太阳中风，下利呃逆，其人絷絷汗出，发作有时，头痛，心下痞硬满，引肋下痛，干呕短气，汗出不恶寒，表解里未和者，乃悬饮咳唾，胸胁引痛。4.取癖丸(《婴童百问》)，治小儿痞块大痛。5.姜黄散(《证治准绳·女科》)，治妇人血脏久冷，腹胀疼痛，小便浓白如泔。6.小消化丸(《圣济总录》)，治水病通身微肿，腹大，食饮不消。"}]},{"ID":"20240613123851-xw04u9u","Type":"NodeParagraph","Properties":{"id":"20240613123851-xw04u9u","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613123851-e9jl1ln","Type":"NodeParagraph","Properties":{"id":"20240613123851-e9jl1ln","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主咳逆上气，喉鸣喘，咽肿短气，鬼疟，疝瘕，痈肿。"}]},{"ID":"20240613123851-19onh8v","Type":"NodeParagraph","Properties":{"id":"20240613123851-19onh8v","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：消胸中痰水，喜唾，水肿，五水在五藏皮肤及腰痛，下寒毒、肉毒。"}]},{"ID":"20240613123851-t1l28e9","Type":"NodeParagraph","Properties":{"id":"20240613123851-t1l28e9","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：治心腹胀满，去水气，利五脏寒痰，涕唾如胶者。主通利血脉，治恶疮风痹湿，一切毒风，四肢挛急，不能行步，能泻水肿胀满。"}]},{"ID":"20240613123851-cohcsk5","Type":"NodeParagraph","Properties":{"id":"20240613123851-cohcsk5","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：疗嗽、瘴疟。"}]},{"ID":"20240613123851-572d2ze","Type":"NodeParagraph","Properties":{"id":"20240613123851-572d2ze","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"5.《本草纲目》：治水饮痰澼，胁下痛。"}]},{"ID":"20240613123851-o4qx27m","Type":"NodeParagraph","Properties":{"id":"20240613123851-o4qx27m","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"6.《本草原始》：煎汁渍丝线，系痔易落，（并能）系瘤。"}]},{"ID":"20240613123851-5h6hnua","Type":"NodeParagraph","Properties":{"id":"20240613123851-5h6hnua","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"7.《汤液本草》：胡洽治痰癖、饮癖，用芫花、甘遂、大戟，加以大黄、甘草，五物同煎，以相反主之，欲其大吐也。治之大略，水者，肺、肾、胃三经所主，有五脏、六腑、十二经之部分，上而头，中而四肢，下而腰齐，外而皮毛，中而肌肉，内而筋骨，脉有尺寸之殊，浮沉之异，不可轻泻，当知病在何经、何脏，误用则害深，然大意泄湿。"}]},{"ID":"20240613123851-bdhcyz6","Type":"NodeParagraph","Properties":{"id":"20240613123851-bdhcyz6","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"8.《本草纲目》：张仲景治伤寒太阳证，表不解，心下有水气，干呕发热而咳，或喘或利者，小青龙汤主之；若表已解，有时头痛出汗恶寒，心下有水气，干呕痛引两胁，或喘或咳者，十枣汤主之。盖小青龙治未发散表邪，使水气自毛窍而出，乃《内经》所谓开鬼门法也；十枣汤驱逐里邪，使水气自大小便而泄，乃《内经》所谓洁净府，去陈?法也。芫花、甘遂、大戟之性，逐水泄湿，能直达水饮窠囊隐僻之处，但可徐徐用之，取效甚捷，不可过剂，泄人真元也。陈言《三因方》以十枣汤药为末，用枣肉和丸，以治水气喘急浮肿之证，盖善变通者也。杨士瀛《直指方》云，破癖须用芫花，行水后便养胃可也。"}]},{"ID":"20240613123851-1w2jdrl","Type":"NodeParagraph","Properties":{"id":"20240613123851-1w2jdrl","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"9.《本草述》：芫花所治，在《本经》首言其主咳逆上气，喉鸣喘，咽肿短气，是其用在上焦以及中焦也。观《本经》于甘遂、大戟，俱云苦寒，而兹物独言辛温，唯其气温，故不独去水气，并治寒毒寒痰。（此味）与大戟仿佛以致其用，但苦寒、辛温，不惟上下区分，即恐决逐与开散，似犹未可一视。第举言其能虚人元气，以水乃气所化，而气布于上焦也，是亦不可不致慎矣。"}]},{"ID":"20240613123851-22hlgg1","Type":"NodeParagraph","Properties":{"id":"20240613123851-22hlgg1","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"10.《本经逢原》：芫花，消痰饮水肿，故《本经》治咳逆咽肿，疝瘕痈毒，皆是痰湿内壅之象。"}]},{"ID":"20240613123851-p5qaqkm","Type":"NodeParagraph","Properties":{"id":"20240613123851-p5qaqkm","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"11.《本草求真》：芫花主治颇与大戟、甘遂（同），皆能达水饮窠囊隐僻之处，然此味苦而辛，苦则内泄，辛则外搜，故凡水饮痰癖，皮肤胀满，喘急痛引胸胁，咳嗽，瘴疟，里外水闭，危迫殆甚者，用此，毒性至紧，无不立应。不似甘遂苦寒，止泄经隧水湿；大戟苦寒，止泄脏腑水湿；荛花与此气味虽属相同，而性较此多寒之有异耳。"}]},{"ID":"20240613123851-uqshk7w","Type":"NodeParagraph","Properties":{"id":"20240613123851-uqshk7w","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"12.张寿颐：芫花气味，《本经》虽称辛温，然所主诸病，皆湿热痰水为虐。功用专在破泄积水，而非可以治脾肾虚寒之水肿，则辛虽能散，必非温燥之药，故《别录》改作微温。据吴普谓神农、黄帝：有毒；扁鹊、歧伯：苦；李氏：大寒云云，似以李氏当之之说为允。《本经》主咳逆上气，喉鸣及喘而短气，皆水饮停积上焦，气壅逆行，闭塞不降之症；咽肿亦热毒实痰，窒滞清窍，此等苦泄攻通猛将，均为湿热实闭，斩关夺门，冲锋陷阵，一击必中之利器，非为虚人设法可知。鬼疟，实即古之所谓瘴疟，故治宜泄导热毒，亦非其他诸疟之所可混投者也。疝瘕亦指湿热蕴结之一症，不可以概一切之疝气瘕聚。痈肿，则固专指阳发实热之疡患矣。《别录》谓消痰水、水肿，及五种水气之在五脏者，固皆以实证立论，仍是《本经》之义。喜唾乃饮积胸中，水气上溢，而口多涎沫耳。皮肤腰痛，亦指水气泛滥之一症。惟寒毒二字，当有讹误，此乃寒泄之药，非其所主，岂浅者以《本经》气味有温之一说，而姑妄言之耶？总之，《名医别录》虽集成于贞白居士之手，然六朝以降，传写屡经，亦难保无妄人羼杂之句，是当衡之以理，而必不可一味盲从者。肉毒是肉食之毒，食物得毒，固必泄之而毒始解。"}]},{"ID":"20240613123851-xrr7mwi","Type":"NodeParagraph","Properties":{"id":"20240613123851-xrr7mwi","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613123851-oiyqd96","Type":"NodeParagraph","Properties":{"id":"20240613123851-oiyqd96","updated":"20240613123851"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613123853-yvgvofo","Type":"NodeThematicBreak","Properties":{"id":"20240613123853-yvgvofo"}},{"ID":"20240613123854-a44q4el","Type":"NodeParagraph","Properties":{"id":"20240613123854-a44q4el"}}]}