42","updated":"20240826165813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240826155629-njj4ix6.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 274px;","style":"width: 264px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240826155701-lec0o1y.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 264px;\" parent-style=\"width: 274px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826155613-top15pi","Type":"NodeParagraph","Properties":{"id":"20240826155613-top15pi","updated":"20240826162634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为郁李（花萼筒则是陀螺状、果实直径小、叶柄较长）"}]},{"ID":"20240826155625-gfgsh87","Type":"NodeParagraph","Properties":{"id":"20240826155625-gfgsh87","updated":"20240826155654"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240826155625-kq77d8b.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240826155638-aucwtkz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 506px;","style":"width: 496px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240826155654-x7hlnsz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 496px;\" parent-style=\"width: 506px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826165341-8285fjl","Type":"NodeParagraph","Properties":{"id":"20240826165341-8285fjl","updated":"20240827100024"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为欧李（个人认为欧李果实量大且密集，是否有郁李的药效存疑，如作为伪品确实在经济效益上是第一选择）"}]},{"ID":"20240826165359-v6iob5o","Type":"NodeParagraph","Properties":{"id":"20240826165359-v6iob5o","updated":"20240826165704"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 257px;","style":"width: 247px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"欧李"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/欧李-20240826165359-71agrc8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 247px;\" parent-style=\"width: 257px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 653px;","style":"width: 643px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"欧李 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/欧李 1-20240826165418-vglev22.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 643px;\" parent-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 363px;","style":"width: 353px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"欧李 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/欧李 2-20240826165704-vzd1cq5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 353px;\" parent-style=\"width: 363px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826165345-rzt6gwy","Type":"NodeParagraph","Properties":{"id":"20240826165345-rzt6gwy","updated":"20240826165345"}},{"ID":"20240826153508-50ue93j","Type":"NodeParagraph","Properties":{"id":"20240826153508-50ue93j","updated":"20240827100750"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：郁李、欧李、麦李三者相似，注意甄别；（"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"百科定义——郁李仁：来源于蔷薇科植物，包括郁李、欧李、榆叶梅、长梗扁桃等的种仁；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"该定义存疑，请以实际疗效为准，该篇主要取图植物为‘郁李’；）"}]},{"ID":"20240826155421-h46h7h2","Type":"NodeParagraph","Properties":{"id":"20240826155421-h46h7h2","updated":"20240826164537"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：麦李、郁李区别"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"（二注、三注出处不同，这里不作合并，独立开来）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240826155441-34yurxu","Type":"NodeParagraph","Properties":{"id":"20240826155441-34yurxu","updated":"20240826162634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1、叶不同：麦李的叶柄较短，长1.5～3毫米；叶片先端渐尖，最宽处在中部；叶之侧脉较少，4～5对；郁李的叶柄较长，5～10毫米；叶片先端渐尖，具尾状尖，最宽处在中部以下；叶之侧脉较多，5～8对。但麦李和郁李都是花叶同发的植物，花期的麦李或郁李其叶片还处于幼嫩时期，不易辨识。"}]},{"ID":"20240826155441-ud76pg5","Type":"NodeParagraph","Properties":{"id":"20240826155441-ud76pg5","updated":"20240826162634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2、果实不同：麦李的果实直径较大，1～1.2厘米；郁李的果实直径较小，约1厘米。以果实辨认需要等至果期。"}]},{"ID":"20240826155441-2gbvra4","Type":"NodeParagraph","Properties":{"id":"20240826155441-2gbvra4","updated":"20240826155447"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3、花不同：麦李的花朵非常密集，郁李的花朵稍微疏松。以花区别二者的关键是看花萼筒的形状，麦李的花萼筒为钟状，而郁李的花萼筒则是陀螺状。"}]},{"ID":"20240826164243-wnpa77r","Type":"NodeParagraph","Properties":{"id":"20240826164243-wnpa77r","updated":"20240826164535"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：欧李、麦李、郁李区别"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"（二注、三注出处不同，这里不作合并，独立开来）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240826164243-nrsogbz","Type":"NodeParagraph","Properties":{"id":"20240826164243-nrsogbz","updated":"20240826164304"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1.欧李，欧李的株高约1.5米，欧李小枝幼时密生柔毛。欧李的叶子倒卵形或椭圆形，欧李叶片中部以上最宽（郁李叶中部以下最宽），欧李的叶缘锯齿细钝。欧李的花白色或粉红色，与叶同放；花柱光滑无毛。果近球形，鲜红色，较郁李大，直径1.5厘米左右。欧李多产我国北部，山东省也有分布。"}]},{"ID":"20240826164243-p0qhyp5","Type":"NodeParagraph","Properties":{"id":"20240826164243-p0qhyp5","updated":"20240826164307"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.麦李，麦李植株高约1.5米，麦李的小枝光滑无毛或有很少柔毛。麦李的叶片卵状椭圆形，麦李同郁李一样其最宽处在叶片中部以下，但其形状比郁李稍狭长，锯齿细钝。花白色或粉红色，也有重瓣品种。麦李同欧李的区别，除叶片形态外，主要在于麦李的花柱光滑，或在甚部有长毛。"}]},{"ID":"20240826164243-0sktv4n","Type":"NodeParagraph","Properties":{"id":"20240826164243-0sktv4n","updated":"20240826164306"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3.郁李落叶灌木，高1-1.5米。枝纤细，灰褐色，幼时黄棕色，光滑无毛。叶互生；叶柄长2-3毫米，被疏柔毛；托叶2枚，条形，边缘具腺齿，早落；叶片卵形或宽卵形，少有披针状卵形，长3-7厘米，宽1.5-2.5厘米，先端长尾状，基部圆形，边缘有锐重锯齿，上面深绿色，无毛，下面淡绿色，脉上无毛或有稀疏柔毛。花先叶开放或花叶同开，2-3朵簇生，花梗长5-12毫米，有棱，无毛；花直径约1.5厘米；萼筒陀螺形，长宽近相等，无毛，萼片椭圆形，比萼筒略长，先端圆钝，边有细齿；花瓣白色或粉红色，倒卵状椭圆形；雄蕊多数，离生，花药圆形或略呈方形，花丝不等长；雌蕊1，子房长圆形，1室，花柱与雄蕊近等长，无毛。核果近球形，无沟，直径约1厘米，深红色，直径约1厘米，光滑而有光泽；核表面光滑。花期5月，果期7-8月。"}]},{"ID":"20240826164833-303w0mu","Type":"NodeParagraph","Properties":{"id":"20240826164833-303w0mu","updated":"20240826170013"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"欧李虽然有个欧字，实际上为中国原生植物"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，据说跟欧阳修有关，这里不展开讨论；市面上麦李仁、欧李仁常与郁李仁混用，效果未知；"}]},{"ID":"20240826155938-y2u7pel","Type":"NodeParagraph","Properties":{"id":"20240826155938-y2u7pel","updated":"20240826165930"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"五注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"该篇存疑（郁李、麦李、欧李较为相似，以上取图未必完全正确，如有错误烦请指正）；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240613132327-kswraki","Type":"NodeThematicBreak","Properties":{"id":"20240613132327-kswraki","updated":"20240826162634"}},{"ID":"20240613132404-lrp3nui","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132404-lrp3nui","updated":"20240613132408"},"Children":[{"Type":"NodeText","Data":"郁李仁《神农本草经》"}]},{"ID":"20240613132404-vby6og9","Type":"NodeParagraph","Properties":{"id":"20240613132404-vby6og9","updated":"20240613132404"},"Children":[{"Type":"NodeText","Data":"味酸平。"}]},{"ID":"20240613132404-ja8u5xl","Type":"NodeParagraph","Properties":{"id":"20240613132404-ja8u5xl","updated":"20240613132404"},"Children":[{"Type":"NodeText","Data":"主大腹水肿，面目四肢浮肿、利小便水道。根，主齿龈肿，龋齿。一名爵李。生坚齿川谷。"}]},{"ID":"20240613132404-kpobz45","Type":"NodeParagraph","Properties":{"id":"20240613132404-kpobz45","updated":"20240613132404"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：郁李，一名雀李，一名车下李，一名棣（《御览》）。"}]},{"ID":"20240613132404-ib62xiq","Type":"NodeParagraph","Properties":{"id":"20240613132404-ib62xiq","updated":"20240613132404"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名车下李，一名棣，生高山及邱陵上，五月六月采根。"}]},{"ID":"20240613132404-fuafcm1","Type":"NodeParagraph","Properties":{"id":"20240613132404-fuafcm1","updated":"20240613132404"},"Children":[{"Type":"NodeText","Data":"案《说文》云：棣，白棣也。《广雅》云：山李，雀其也。《尔雅》云：常棣，棣。"}]},{"ID":"20240613132404-wd8ujee","Type":"NodeParagraph","Properties":{"id":"20240613132404-wd8ujee","updated":"20240613132404"},"Children":[{"Type":"NodeText","Data":"郭璞云：今关西有棣树，子如樱桃可食。《毛诗》云：六月食郁。《传》云：郁，棣属。刘稹《毛诗》义问云：其树高五六尺，其实大如李，正赤，食之甜。又诗云：常棣之华。《传》云：常棣，棣也。陆玑云：奥李。一名雀李，一曰车下李，所在山中皆有其花，或白或赤，六月中熟大，子如李子可食。沈括补笔谈云：晋宫阁铭曰：华林园中有车下李，三百一十四株，薁李一株。"}]},{"ID":"20240613132426-qehwqks","Type":"NodeThematicBreak","Properties":{"id":"20240613132426-qehwqks"}},{"ID":"20240613132442-w0pv9qw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132442-w0pv9qw","updated":"20240613132447"},"Children":[{"Type":"NodeText","Data":"郁李仁《千金翼方》"}]},{"ID":"20240613132442-goxlg72","Type":"NodeParagraph","Properties":{"id":"20240613132442-goxlg72","updated":"20240613132442"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主大腹水肿，面目四肢浮肿，利小便水道。根∶主齿龈肿，龋齿坚齿，去白虫。一名爵李，一名车下李，一名棣。生高山川谷及丘陵上，五月六月采根。"}]},{"ID":"20240613132442-i3by7hi","Type":"NodeThematicBreak","Properties":{"id":"20240613132442-i3by7hi"}},{"ID":"20240613132427-5yxeqst","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132427-5yxeqst","updated":"20240613132433"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草图经》"}]},{"ID":"20240613132427-2e2o6yz","Type":"NodeParagraph","Properties":{"id":"20240613132427-2e2o6yz","updated":"20240613132435"},"Children":[{"Type":"NodeText","Data":"郁李仁，《本经》不载所出州土，但云生高山川谷及丘陵上，今处处有之。木高五、六尽，枝条、花叶，皆若李，惟子小若樱桃，赤色，而味甘、酸，核随子熟，六月采根并实，取核中仁用。陆机《草木疏》云∶唐棣，即奥李也，一名雀梅，亦曰车下李，所在山中皆有，其华或白或赤，六月中成实，如李子可食。今近京人家园圃植一种，枝茎作长条，花极繁密而多叶，亦谓之郁李，不堪入药用。韦宙《独行方》∶疗香港脚浮肿，心腹满，大小便不通，气急喘息者。以郁李仁十二分，捣碎，水研，取汁。薏苡仁捣碎如粟米，取三合，以汁煮米作粥，空腹食之佳。《必效方》∶疗癖。取车下李仁，微汤退去及并仁者，与干面相拌，捣之为饼。如犹干和淡水，如常搜面作饼，大小一如病患掌。为二饼，微炙使黄，勿令至熟。"}]},{"ID":"20240613132427-l20nsln","Type":"NodeParagraph","Properties":{"id":"20240613132427-l20nsln","updated":"20240613132427"},"Children":[{"Type":"NodeText","Data":"空腹食一枚，当快利。如不利，更食一枚，或饮热粥汁，以利为度。若至午后痢不止，即以醋饭止之。利后当虚，病未尽者，量力一、二日更进一服，以病尽为限。小儿亦以意量之。"}]},{"ID":"20240613132427-ait1n79","Type":"NodeParagraph","Properties":{"id":"20240613132427-ait1n79","updated":"20240613132427"},"Children":[{"Type":"NodeText","Data":"不得食酪及牛、马肉等。无不效。但病重者，李仁与面相半；轻者以意减之。病减之后，服者亦任量力，累试神验。"}]},{"ID":"20240613132415-4jz87x4","Type":"NodeThematicBreak","Properties":{"id":"20240613132415-4jz87x4"}},{"ID":"20240613132416-0rgzeul","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132416-0rgzeul","updated":"20240613132420"},"Children":[{"Type":"NodeText","Data":"郁李仁《医学入门》"}]},{"ID":"20240613132416-g0le1yg","Type":"NodeParagraph","Properties":{"id":"20240613132416-g0le1yg","updated":"20240613132416"},"Children":[{"Type":"NodeText","Data":"郁李仁味苦酸平，破血润燥二便行，消肿攻癖通关格，根主牙风肿且疼。"}]},{"ID":"20240613132416-5kd0sai","Type":"NodeParagraph","Properties":{"id":"20240613132416-5kd0sai","updated":"20240613132416"},"Children":[{"Type":"NodeText","Data":"郁，盛貌，即《诗》所谓棠棣之花，李木之子也。无毒。阴中阳也。破血，润燥，滑大肠，利小便、水道，泄五脏、膀胱急痛，宣腰跨冷脓，主大腹水肿、面目四肢浮肿，消宿食，下气，破癖气，治卒心痛及肠中结气、关格不通。凡使，汤浸去皮尖，生蜜浸一宿，研如膏用，根，凉。主风虫牙、龋齿、齿龈肿痛，去白虫，浓煎含之。"}]},{"ID":"20240613132327-kw1wmbk","Type":"NodeThematicBreak","Properties":{"id":"20240613132327-kw1wmbk"}},{"ID":"20240613132355-ltdl2gx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132355-ltdl2gx","updated":"20240613132359"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草述钩元》"}]},{"ID":"20240613132355-17xf8e8","Type":"NodeParagraph","Properties":{"id":"20240613132355-17xf8e8","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"即尔雅棠棣。山野处处有之。树高五六尺。叶花及树。并似大李。惟子小若樱桃。熟时赤色。甘酸而香。有少涩味也。"}]},{"ID":"20240613132355-hhv6gaq","Type":"NodeParagraph","Properties":{"id":"20240613132355-hhv6gaq","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"味酸辛苦。气平。性润而降。阴中之阳。脾经气分药。更入手阳明太阳经。主治化血润燥。泻结气。破癖气。治大肠气结燥。涩滞不通。泄五脏膀胱急痛。腰胯冷脓。下气利水道。并主大腹水肿。四肢面目浮肿。"}]},{"ID":"20240613132355-0ppx1y0","Type":"NodeParagraph","Properties":{"id":"20240613132355-0ppx1y0","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"附案一妇因悸而病。既愈。目张不得瞑。钱仲阳令煮郁李酒饮之。使醉而愈。盖因目系内连肝胆。恐则气结。胆横不下。郁李能去结。随酒入胆。结去胆下。则目能瞑矣。同当归地黄麻仁桃仁麦冬生蜜肉苁蓉。治大便燥结不通。甚者加大黄。"}]},{"ID":"20240613132355-09ta73l","Type":"NodeParagraph","Properties":{"id":"20240613132355-09ta73l","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"〔论〕郁李仁之利水。本于散结气。夫水乃气所化。气属阳主动。动者能使之结。则属于阴矣。气之元固起于阴中之阳。气之结即由于阳中之阴。一散其结。而阳斯化。水斯行。"}]},{"ID":"20240613132355-y0uzh14","Type":"NodeParagraph","Properties":{"id":"20240613132355-y0uzh14","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"故洁古谓为脾经气分药。而本经用治大腹水肿面目四肢浮肿者也。夫脾乘出地之阳而上行。"}]},{"ID":"20240613132355-ug90ui6","Type":"NodeParagraph","Properties":{"id":"20240613132355-ug90ui6","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"布中气以统血。故五脏皆有阴气。而脾为之枢。郁李仁主疗。大抵皆脾气之所周。然则洁古破血之说。不等于他味。即所云润燥。亦由其宣阴结以化血。以血结则气燥。血化则营卫和而燥者润也。且其散结之功。宁独奏之行水哉。举七情之结以伤阴。遂以塞阳者。当可类推之以为治矣。（观钱氏用治目不得瞑可见）缪氏言性专降下。善导大肠燥结。利周身水气。"}]},{"ID":"20240613132355-xqq92a7","Type":"NodeParagraph","Properties":{"id":"20240613132355-xqq92a7","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"然下后多令人津液亏损。燥结愈甚。乃治标救急之药。津液不足者。慎勿轻用。"}]},{"ID":"20240613132355-7f8fm91","Type":"NodeParagraph","Properties":{"id":"20240613132355-7f8fm91","updated":"20240613132355"},"Children":[{"Type":"NodeText","Data":"〔修治〕先以汤浸。去皮尖。再用生蜜浸一宿。漉出阴干。研如膏用。"}]},{"ID":"20240613132327-ugk4buf","Type":"NodeThematicBreak","Properties":{"id":"20240613132327-ugk4buf"}},{"ID":"20240613132338-6ozf97o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132338-6ozf97o","updated":"20240613132347"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草新编》"}]},{"ID":"20240613132338-f04gfxq","Type":"NodeParagraph","Properties":{"id":"20240613132338-f04gfxq","updated":"20240613132338"},"Children":[{"Type":"NodeText","Data":"郁李仁，味酸、苦，气平，降也，阴中阳也，无毒。入肝、胆二经，去头风之痛。又入脾，止鼻渊之涕。消浮肿，利小便，通关格，破血润燥，又其余枝。虽非当施之品，实为解急之需也。"}]},{"ID":"20240613132338-n13g63y","Type":"NodeParagraph","Properties":{"id":"20240613132338-n13g63y","updated":"20240613132338"},"Children":[{"Type":"NodeText","Data":"关格之症，最难开关，郁李仁善入肝，以调逆气，故能通达上下，不可不备也。"}]},{"ID":"20240613132327-ne8c156","Type":"NodeThematicBreak","Properties":{"id":"20240613132327-ne8c156"}},{"ID":"20240613132328-perjach","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132328-perjach","updated":"20240613132333"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草乘雅半偈》"}]},{"ID":"20240613132328-fyycmph","Type":"NodeParagraph","Properties":{"id":"20240613132328-fyycmph","updated":"20240613132328"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613132328-c2yic2e","Type":"NodeParagraph","Properties":{"id":"20240613132328-c2yic2e","updated":"20240613132328"},"Children":[{"Type":"NodeText","Data":"【气味】酸平，无毒。"}]},{"ID":"20240613132328-8daivep","Type":"NodeParagraph","Properties":{"id":"20240613132328-8daivep","updated":"20240613132328"},"Children":[{"Type":"NodeText","Data":"【主治】主大腹水肿，头面、四肢浮肿，利小便水道。"}]},{"ID":"20240613132328-e30rxao","Type":"NodeParagraph","Properties":{"id":"20240613132328-e30rxao","updated":"20240613132328"},"Children":[{"Type":"NodeText","Data":"【核】曰∶郁李，即棠埭。诗云∶唐埭、尝埭。山海经作 。所在有之，树高六七尺，花叶枝干并似李，惟子小若樱桃，味甘酸，臭香而少涩。一种赤郁李，叶如刺榆，其子正赤而小，五月始熟，关西、天水、陇西多有之。汴洛一种，枝茎作长条，花极繁密而多叶，亦谓之郁李，不堪入药也。修事，汤浸去皮尖，用生蜜浸一宿，取出阴干，研如膏用。"}]},{"ID":"20240613132328-pqqq9vp","Type":"NodeParagraph","Properties":{"id":"20240613132328-pqqq9vp","updated":"20240613132328"},"Children":[{"Type":"NodeText","Data":"【 】曰∶郁李花极繁，文之盛者似之。其香颇浓，故芬芳之气，通称馥郁也。凡木之花，既开不阖，此独不然。诗云∶唐埭之花，偏其反而，反而从阖也；又尝埭之花，鄂不，鄂萼，不附也，萼附相承，最相亲尔，故又曰彼尔维何。维尝之花，其义见矣。诗疏云∶唐埭， 李也，一名雀梅，一名夫移，又云车下李，其叶或赤或白，六月中熟，大如李子。花品序云∶雒阳人不甚惜，谓之果子花，大略俗情以少贵，不足较也。"}]},{"ID":"20240613132328-aj5rw1l","Type":"NodeParagraph","Properties":{"id":"20240613132328-aj5rw1l","updated":"20240613132328"},"Children":[{"Type":"NodeText","Data":"郁李味酸气平，其花反而后阖，此阖用仍开，呈开仍阖之象也。当入厥阴肝，盖肝主疏泄前后阴，如失疏泄，则阖用之开机废，以致水肿大腹，及面目四肢浮肿。郁李功利水道小便，使阖用呈开，则疏泄仍如令矣。"}]},{"ID":"20240613132121-qgiuamt","Type":"NodeThematicBreak","Properties":{"id":"20240613132121-qgiuamt"}},{"ID":"20240613132317-lf0io2q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132317-lf0io2q","updated":"20240613132321"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草备要》"}]},{"ID":"20240613132317-icj23ga","Type":"NodeParagraph","Properties":{"id":"20240613132317-icj23ga","updated":"20240613132317"},"Children":[{"Type":"NodeText","Data":"润燥，泻气，破血"}]},{"ID":"20240613132317-bwgjp8k","Type":"NodeParagraph","Properties":{"id":"20240613132317-bwgjp8k","updated":"20240613132317"},"Children":[{"Type":"NodeText","Data":"辛苦而甘。入脾经气分。性降下气行水，破血润燥。"}]},{"ID":"20240613132317-gsi4ocz","Type":"NodeParagraph","Properties":{"id":"20240613132317-gsi4ocz","updated":"20240613132317"},"Children":[{"Type":"NodeText","Data":"治水肿癃急，大肠气滞，关格不通。用酒能入胆，治悸、目张不眠（一妇因大恐而病，愈后目张不瞑。钱乙曰∶目系内连肝胆，恐则气结，胆横不下。郁李润能散结，随酒入胆，结去胆下，而目瞑矣）。然治标之剂，多服渗人津液。"}]},{"ID":"20240613132317-vgd637y","Type":"NodeParagraph","Properties":{"id":"20240613132317-vgd637y","updated":"20240613132317"},"Children":[{"Type":"NodeText","Data":"去皮、尖，蜜浸研。"}]},{"ID":"20240613132501-ddah0b8","Type":"NodeThematicBreak","Properties":{"id":"20240613132501-ddah0b8"}},{"ID":"20240613132502-04e10vx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132502-04e10vx","updated":"20240613132508"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草从新》"}]},{"ID":"20240613132502-ydywcdt","Type":"NodeParagraph","Properties":{"id":"20240613132502-ydywcdt","updated":"20240613132502"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻气、破血润燥．"}]},{"ID":"20240613132502-1swtm43","Type":"NodeParagraph","Properties":{"id":"20240613132502-1swtm43","updated":"20240613132502"},"Children":[{"Type":"NodeText","Data":"辛苦甘平．性降．下气行水．破血润燥．治水肿癃急．大肠气滞．关格不通．用酒．能入胆治悸．目张不瞑．（一妇因大恐而病、愈后目张不瞑、钱乙曰∶目系内连肝胆、恐则气结、胆横不下、郁李润能散结、随酒入胆、结去胆下、而目瞑矣．）下后令人津液亏损．燥结愈甚．乃治标救急之药．津液不足者．慎勿轻投．汤浸．去皮尖．蜜浸．研如膏．"}]},{"ID":"20240613132121-1ehr6jl","Type":"NodeThematicBreak","Properties":{"id":"20240613132121-1ehr6jl"}},{"ID":"20240613132258-il3ldzb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132258-il3ldzb","updated":"20240613132302"},"Children":[{"Type":"NodeText","Data":"郁李仁《要药分剂》"}]},{"ID":"20240613132258-631ppf4","Type":"NodeParagraph","Properties":{"id":"20240613132258-631ppf4","updated":"20240613132258"},"Children":[{"Type":"NodeText","Data":"味苦辛酸。性平。无毒。得金气而兼木气以生。降也。阴也。"}]},{"ID":"20240613132258-pjmsk9c","Type":"NodeParagraph","Properties":{"id":"20240613132258-pjmsk9c","updated":"20240613132258"},"Children":[{"Type":"NodeText","Data":"【主治】主大腹水肿。面目四肢浮肿。利小便水道。（本经）肠中结气。关格不通。（甄权）十九粒因悸。目【归经】入脾大小肠三经。为润燥泄气破血之品。（脾经气分药）【前论】陈承曰。郁李仁性专下降。善导大肠燥结。利周身水气。然下后多令人津液亏损。"}]},{"ID":"20240613132258-q84gfpo","Type":"NodeParagraph","Properties":{"id":"20240613132258-q84gfpo","updated":"20240613132258"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。津液不足者。忌。"}]},{"ID":"20240613132601-48omloh","Type":"NodeThematicBreak","Properties":{"id":"20240613132601-48omloh"}},{"ID":"20240613132602-ulnicvf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132602-ulnicvf","updated":"20240613132609"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草便读》"}]},{"ID":"20240613132602-pn6jlv8","Type":"NodeParagraph","Properties":{"id":"20240613132602-pn6jlv8","updated":"20240613132602"},"Children":[{"Type":"NodeText","Data":"顺气搜风．燥结立开津易耗．通肠导水．肿浮顿退胀全消．辛苦甘酸．平和润降．（郁李仁辛苦微甘微酸．性平．专主润降．通大肠．润燥结．导一切水闭风闭气闭等证．但降利之性太过．恐结去而津耗耳．）"}]},{"ID":"20240613132633-pn6hzo6","Type":"NodeThematicBreak","Properties":{"id":"20240613132633-pn6hzo6"}},{"ID":"20240613132635-ka34ntg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132635-ka34ntg","updated":"20240613132639"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草简要方》"}]},{"ID":"20240613132635-zchyean","Type":"NodeParagraph","Properties":{"id":"20240613132635-zchyean","updated":"20240613132635"},"Children":[{"Type":"NodeText","Data":"主治。润燥。行水。消宿食。破癖气。肠中结气燥涩不通。大腹水肿。四肢面目浮肿。"}]},{"ID":"20240613132635-bsvmydo","Type":"NodeParagraph","Properties":{"id":"20240613132635-bsvmydo","updated":"20240613132635"},"Children":[{"Type":"NodeText","Data":"五脏膀胱急痛。郁李仁丸。郁李仁大黄（酒浸炒）各一两。滑石五钱。先研郁李仁成膏。"}]},{"ID":"20240613132635-ymamvdj","Type":"NodeParagraph","Properties":{"id":"20240613132635-ymamvdj","updated":"20240613132635"},"Children":[{"Type":"NodeText","Data":"和大黄滑石末为丸。黍米大。治小儿初生二便不通。及惊热痰实。每服二三丸。以利为度。"}]},{"ID":"20240613132623-ohw7v7s","Type":"NodeThematicBreak","Properties":{"id":"20240613132623-ohw7v7s"}},{"ID":"20240613132624-sxl64a3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132624-sxl64a3","updated":"20240613132628"},"Children":[{"Type":"NodeText","Data":"郁李仁《增广和剂局方药性总论》"}]},{"ID":"20240613132624-xyxxo5u","Type":"NodeParagraph","Properties":{"id":"20240613132624-xyxxo5u","updated":"20240613132624"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主大腹水肿，面目四肢浮肿，利小便水道。根∶主齿龈肿，龋齿齿，去白虫。《药性论》云∶臣。治肠中结气，关格不通。根，治齿痛，宣结气，破结日华子云∶通泄五脏、膀胱急痛，宣腰胯冷脓，消宿食，下气。又云∶根凉，无毒。"}]},{"ID":"20240613132624-p79bhdl","Type":"NodeParagraph","Properties":{"id":"20240613132624-p79bhdl","updated":"20240613132624"},"Children":[{"Type":"NodeText","Data":"热发，作汤浴。风 牙，浓煎含之。"}]},{"ID":"20240613132614-rc498q8","Type":"NodeThematicBreak","Properties":{"id":"20240613132614-rc498q8"}},{"ID":"20240613132615-y252lx0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132615-y252lx0","updated":"20240613132619"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草分经》"}]},{"ID":"20240613132615-q0g8anf","Type":"NodeParagraph","Properties":{"id":"20240613132615-q0g8anf","updated":"20240613132615"},"Children":[{"Type":"NodeText","Data":"辛苦甘平性降，下气行水，补血润燥，得酒则入胆，去皮尖，治标之品，津液不足者慎用。"}]},{"ID":"20240613132552-to3pv0p","Type":"NodeThematicBreak","Properties":{"id":"20240613132552-to3pv0p"}},{"ID":"20240613132553-1essok7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132553-1essok7","updated":"20240613132557"},"Children":[{"Type":"NodeText","Data":"郁李仁《本经逢原》"}]},{"ID":"20240613132553-nmmh8pn","Type":"NodeParagraph","Properties":{"id":"20240613132553-nmmh8pn","updated":"20240613132553"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即棠棣，一名雀李"}]},{"ID":"20240613132553-ep0e8ko","Type":"NodeParagraph","Properties":{"id":"20240613132553-ep0e8ko","updated":"20240613132553"},"Children":[{"Type":"NodeText","Data":"仁辛苦平无毒。汤浸去皮及双仁者，研如膏，勿去油，忌牛马肉及诸酪。"}]},{"ID":"20240613132553-qsyyl39","Type":"NodeParagraph","Properties":{"id":"20240613132553-qsyyl39","updated":"20240613132553"},"Children":[{"Type":"NodeText","Data":"《本经》主大腹水气，面目、四肢浮肿，利小便水道。"}]},{"ID":"20240613132553-b8mrhqm","Type":"NodeParagraph","Properties":{"id":"20240613132553-b8mrhqm","updated":"20240613132553"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"郁李仁性润而降，为大便风秘专药。《本经》治大腹水气，面目、四肢浮肿，取其润下之意。利小便水道者，水气从之下趋也，搜风顺气丸用之。虽有润燥之功，而下后令人津液亏损，燥结愈甚。老人津液不足而燥结者戒之。根治风虫牙痛，浓煎含漱，冷即吐去更含，勿咽汁，以其能降泄也。"}]},{"ID":"20240613132541-6so8g5u","Type":"NodeThematicBreak","Properties":{"id":"20240613132541-6so8g5u"}},{"ID":"20240613132543-6mblqvx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132543-6mblqvx","updated":"20240613132547"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草害利》"}]},{"ID":"20240613132543-6qfx2mp","Type":"NodeParagraph","Properties":{"id":"20240613132543-6qfx2mp","updated":"20240613132543"},"Children":[{"Type":"NodeText","Data":"〔害〕性专下降，善导大肠燥结，利周身水气。然下后令人津液亏损，燥结愈甚，乃治标急救之药。津液不足者，慎勿轻投。"}]},{"ID":"20240613132543-32ueoru","Type":"NodeParagraph","Properties":{"id":"20240613132543-32ueoru","updated":"20240613132543"},"Children":[{"Type":"NodeText","Data":"〔利〕味苦甘、辛平，入脾、大肠二经。润燥行水，下气破血，得酒入胆，治不寐。"}]},{"ID":"20240613132543-uvla65i","Type":"NodeParagraph","Properties":{"id":"20240613132543-uvla65i","updated":"20240613132543"},"Children":[{"Type":"NodeText","Data":"〔修治〕五月采核，捣碎取仁，先以汤浸去皮尖，用生蜜浸一宿，漉出阴干，研如膏用。"}]},{"ID":"20240613132532-zhjd244","Type":"NodeThematicBreak","Properties":{"id":"20240613132532-zhjd244"}},{"ID":"20240613132533-dtwn1g2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132533-dtwn1g2","updated":"20240613132537"},"Children":[{"Type":"NodeText","Data":"郁李仁《汤液本草》"}]},{"ID":"20240613132533-vsv6v45","Type":"NodeParagraph","Properties":{"id":"20240613132533-vsv6v45","updated":"20240613132533"},"Children":[{"Type":"NodeText","Data":"味苦、辛，阴中之阳。辛、苦，阴也。"}]},{"ID":"20240613132533-2967hu7","Type":"NodeParagraph","Properties":{"id":"20240613132533-2967hu7","updated":"20240613132533"},"Children":[{"Type":"NodeText","Data":"《珍》云∶破血润燥。"}]},{"ID":"20240613132533-bkiec8x","Type":"NodeParagraph","Properties":{"id":"20240613132533-bkiec8x","updated":"20240613132533"},"Children":[{"Type":"NodeText","Data":"《本草》云∶郁李根主齿龈肿，龋齿；坚齿，去毒虫。"}]},{"ID":"20240613132533-0lwrq3l","Type":"NodeParagraph","Properties":{"id":"20240613132533-0lwrq3l","updated":"20240613132533"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶根，治齿痛，宣结气，破积聚。"}]},{"ID":"20240613132533-6gqf1g4","Type":"NodeParagraph","Properties":{"id":"20240613132533-6gqf1g4","updated":"20240613132533"},"Children":[{"Type":"NodeText","Data":"《日华子》云∶根，凉，无毒，治小儿发热，作汤浴。风 牙，浓煎含之。"}]},{"ID":"20240613132523-n4lx8t0","Type":"NodeThematicBreak","Properties":{"id":"20240613132523-n4lx8t0"}},{"ID":"20240613132524-kdc43yk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132524-kdc43yk","updated":"20240613132528"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草衍义》"}]},{"ID":"20240613132524-kxk6ras","Type":"NodeParagraph","Properties":{"id":"20240613132524-kxk6ras","updated":"20240613132524"},"Children":[{"Type":"NodeText","Data":"其子如御李子，至红熟堪啖，微涩。其仁，汤去皮，研极烂，入生龙脑，点赤目。"}]},{"ID":"20240613132524-lzzbwz5","Type":"NodeParagraph","Properties":{"id":"20240613132524-lzzbwz5","updated":"20240613132524"},"Children":[{"Type":"NodeText","Data":"陕西甚多，根煎汤，渫风 牙。"}]},{"ID":"20240613132514-abkvroo","Type":"NodeThematicBreak","Properties":{"id":"20240613132514-abkvroo"}},{"ID":"20240613132515-e70zgtx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132515-e70zgtx","updated":"20240613132519"},"Children":[{"Type":"NodeText","Data":"郁李仁《冯氏锦囊秘录》"}]},{"ID":"20240613132515-27filpk","Type":"NodeParagraph","Properties":{"id":"20240613132515-27filpk","updated":"20240613132515"},"Children":[{"Type":"NodeText","Data":"得木气而兼金化，故味辛、苦，性润而善降下，阴也。碎复选仁用。入足太阴、手阳明、太阳经，为宣结消肿、破血利水、润燥之药，乃治标救急之方。倘燥结由于津液不足者勿服。"}]},{"ID":"20240613132515-0k4500a","Type":"NodeParagraph","Properties":{"id":"20240613132515-0k4500a","updated":"20240613132515"},"Children":[{"Type":"NodeText","Data":"郁李仁，消浮肿肌表，竟利小便，宣结气肠，中立通关格，破血润燥，亦易成功，润达幽门关格，有转输之妙，宣通水府肿胀，无壅遏之嗟。"}]},{"ID":"20240613132121-dchs7ea","Type":"NodeThematicBreak","Properties":{"id":"20240613132121-dchs7ea"}},{"ID":"20240613132246-tim2co3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132246-tim2co3","updated":"20240613132254"},"Children":[{"Type":"NodeText","Data":"郁李仁《本草择要纲目》"}]},{"ID":"20240613132246-eas7yxz","Type":"NodeParagraph","Properties":{"id":"20240613132246-eas7yxz","updated":"20240613132246"},"Children":[{"Type":"NodeText","Data":"（先以汤浸去皮尖用．生蜜浸一宿．漉出阴干．研如膏用之．）"}]},{"ID":"20240613132246-d5rjnwr","Type":"NodeParagraph","Properties":{"id":"20240613132246-d5rjnwr","updated":"20240613132246"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240613132246-vrcoeb2","Type":"NodeParagraph","Properties":{"id":"20240613132246-vrcoeb2","updated":"20240613132246"},"Children":[{"Type":"NodeText","Data":"酸平无毒．阴中之阳．脾经气分药也．"}]},{"ID":"20240613132246-gpqoxr1","Type":"NodeParagraph","Properties":{"id":"20240613132246-gpqoxr1","updated":"20240613132246"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240613132246-h1uj3dx","Type":"NodeParagraph","Properties":{"id":"20240613132246-h1uj3dx","updated":"20240613132246"},"Children":[{"Type":"NodeText","Data":"大腹水肿．面目四肢浮肿．利小便水道．肠中结气．关格不通．泄五脏膀胱急痛．宣腰胯冷脓．消宿食．下气破癖气．下四肢水．酒服四十九粒．能泻结气．破血润燥．专治大肠气滞燥涩不通．研和龙脑点赤眼．盖郁李仁又甘苦而润．其性降．故能下气利水．"}]},{"ID":"20240613132121-u5rzomr","Type":"NodeThematicBreak","Properties":{"id":"20240613132121-u5rzomr"}},{"ID":"20240613132130-lujlwlt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132130-lujlwlt","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"《中国药典》：郁李仁"}]},{"ID":"20240613132130-wfaxmn1","Type":"NodeParagraph","Properties":{"id":"20240613132130-wfaxmn1","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613132130-n4tq30d","Type":"NodeParagraph","Properties":{"id":"20240613132130-n4tq30d","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" Yù Lǐ Rén"}]},{"ID":"20240613132130-bnvrcny","Type":"NodeParagraph","Properties":{"id":"20240613132130-bnvrcny","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613132130-mdf0bsk","Type":"NodeParagraph","Properties":{"id":"20240613132130-mdf0bsk","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 小李仁、大李仁"}]},{"ID":"20240613132130-vg9hjp3","Type":"NodeParagraph","Properties":{"id":"20240613132130-vg9hjp3","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613132130-lene2ud","Type":"NodeParagraph","Properties":{"id":"20240613132130-lene2ud","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" SEMEN PRUNI"}]},{"ID":"20240613132130-sme95w4","Type":"NodeParagraph","Properties":{"id":"20240613132130-sme95w4","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613132130-7cpzm00","Type":"NodeParagraph","Properties":{"id":"20240613132130-7cpzm00","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 本品为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"欧李"},{"Type":"NodeText","Data":"（酸丁、小李红）Prunus humilis Bunge.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"郁李"},{"Type":"NodeText","Data":"（赤李子）Prunus japonica Thunb.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长柄扁桃"},{"Type":"NodeText","Data":"Prunus pedunculata Maxim.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种子"},{"Type":"NodeText","Data":"。前二种习称“小李仁”，后一种习称“大李仁”。夏、秋二季采收成熟果实，除去果肉及核壳，取出种子，干燥。"}]},{"ID":"20240613132130-u5zub5r","Type":"NodeParagraph","Properties":{"id":"20240613132130-u5zub5r","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613132130-9mlim6a","Type":"NodeParagraph","Properties":{"id":"20240613132130-9mlim6a","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 小李仁：呈卵形，长5～8mm，直径3～5mm。表面黄白色或浅棕色，一端尖，另端钝圆。尖端一侧有线形种脐，圆端中央有深色合点，自合点处向上具多条纵向维管束脉纹。种皮薄，子叶2，乳白色，富油性。气微，味微苦。"}]},{"ID":"20240613132130-68wcp1h","Type":"NodeParagraph","Properties":{"id":"20240613132130-68wcp1h","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"大李仁：长6～10mm，直径5～7mm，表面黄棕色。"}]},{"ID":"20240613132130-zyssv46","Type":"NodeParagraph","Properties":{"id":"20240613132130-zyssv46","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613132130-ix3lbty","Type":"NodeParagraph","Properties":{"id":"20240613132130-ix3lbty","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防蛀。"}]},{"ID":"20240613132130-pdbuokv","Type":"NodeParagraph","Properties":{"id":"20240613132130-pdbuokv","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613132130-cq6o7dr","Type":"NodeParagraph","Properties":{"id":"20240613132130-cq6o7dr","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 除去杂质。用时捣碎。"}]},{"ID":"20240613132130-86yj3ef","Type":"NodeParagraph","Properties":{"id":"20240613132130-86yj3ef","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613132130-zz0z0zv","Type":"NodeParagraph","Properties":{"id":"20240613132130-zz0z0zv","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 取本品粉末0.5g，置具塞试管中，加5％硫酸溶液3ml，充分混合。试管中悬挂一条三硝基苯酚试纸（勿使滤纸条与溶液接触），塞紧，将试管置40～50℃水浴中，10分钟后试纸条由黄色变为红色。"}]},{"ID":"20240613132130-u8p903j","Type":"NodeParagraph","Properties":{"id":"20240613132130-u8p903j","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240613132130-jne8aac","Type":"NodeParagraph","Properties":{"id":"20240613132130-jne8aac","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 取本品粗粉约20g，精密称定，置凯氏烧瓶中，加水150ml，立即密塞，静置2小时，连接冷凝管，通水蒸气蒸馏，馏出液导入水10ml与氨试液2ml的吸收液中，接收瓶置冰浴中冷却，至馏出液达200ml时停止蒸馏。馏出液中加碘化钾试液2ml，立即用硝酸银滴定液（0。1mol/L）缓缓滴定，至溶液显出的黄白色浑浊不消失。每1ml硝酸银滴定液（0。1mol/L）相当于91。48mg的苦杏仁苷（C20H27NO11）。"}]},{"ID":"20240613132130-6emy2or","Type":"NodeParagraph","Properties":{"id":"20240613132130-6emy2or","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"本品含苦杏仁苷（C20H27NO11）不得少于1。5％。"}]},{"ID":"20240613132130-y47zhlz","Type":"NodeParagraph","Properties":{"id":"20240613132130-y47zhlz","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613132130-mdncpdb","Type":"NodeParagraph","Properties":{"id":"20240613132130-mdncpdb","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 归脾、大肠、小肠经。"}]},{"ID":"20240613132130-mcsfw9u","Type":"NodeParagraph","Properties":{"id":"20240613132130-mcsfw9u","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613132130-tphj8ja","Type":"NodeParagraph","Properties":{"id":"20240613132130-tphj8ja","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 辛、苦、甘，平。"}]},{"ID":"20240613132130-k6mwsiy","Type":"NodeParagraph","Properties":{"id":"20240613132130-k6mwsiy","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613132130-7dgyd5p","Type":"NodeParagraph","Properties":{"id":"20240613132130-7dgyd5p","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240613132130-vvyvyyd","Type":"NodeParagraph","Properties":{"id":"20240613132130-vvyvyyd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613132130-fmsv8xj","Type":"NodeParagraph","Properties":{"id":"20240613132130-fmsv8xj","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 润燥滑肠，下气，利水。用于津枯肠燥，食积气滞，腹胀便秘，水肿，脚气，小便不利。"}]},{"ID":"20240613132130-8yfud5r","Type":"NodeParagraph","Properties":{"id":"20240613132130-8yfud5r","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613132130-v582s5w","Type":"NodeParagraph","Properties":{"id":"20240613132130-v582s5w","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 6～9g。"}]},{"ID":"20240613132130-htcunal","Type":"NodeParagraph","Properties":{"id":"20240613132130-htcunal","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613132130-jlykte3","Type":"NodeParagraph","Properties":{"id":"20240613132130-jlykte3","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" （1）用于肠燥便秘。常配合火麻仁、瓜蒌仁同用。对水肿腹满、二便不利者，常用以配生苡仁、冬瓜皮等同用。"}]},{"ID":"20240613132130-p6rcf37","Type":"NodeParagraph","Properties":{"id":"20240613132130-p6rcf37","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613132130-u4ywpqw","Type":"NodeParagraph","Properties":{"id":"20240613132130-u4ywpqw","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613132130-bi9ix48","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132130-bi9ix48","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：郁李仁"}]},{"ID":"20240613132130-7aqy7rb","Type":"NodeParagraph","Properties":{"id":"20240613132130-7aqy7rb","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613132130-9sc3j5s","Type":"NodeParagraph","Properties":{"id":"20240613132130-9sc3j5s","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" Yù Lǐ Rén"}]},{"ID":"20240613132130-8cpxam5","Type":"NodeParagraph","Properties":{"id":"20240613132130-8cpxam5","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613132130-u5rf1sd","Type":"NodeParagraph","Properties":{"id":"20240613132130-u5rf1sd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 郁子（《医心方》），郁里仁（《珍珠囊》），李仁肉（《药材学》）。"}]},{"ID":"20240613132130-z0nxmh4","Type":"NodeParagraph","Properties":{"id":"20240613132130-z0nxmh4","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613132130-89xoc9c","Type":"NodeParagraph","Properties":{"id":"20240613132130-89xoc9c","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613132130-re5zuwa","Type":"NodeParagraph","Properties":{"id":"20240613132130-re5zuwa","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613132130-lcpgol5","Type":"NodeParagraph","Properties":{"id":"20240613132130-lcpgol5","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"郁李、欧李"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长梗郁李"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。秋季果实成熟时采摘，除去果肉，取核，再去壳，取出种仁。"}]},{"ID":"20240613132130-vk62rq8","Type":"NodeParagraph","Properties":{"id":"20240613132130-vk62rq8","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613132130-7juowdu","Type":"NodeParagraph","Properties":{"id":"20240613132130-7juowdu","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 主产辽宁、河北、内蒙古等地。"}]},{"ID":"20240613132130-mkvbwvf","Type":"NodeParagraph","Properties":{"id":"20240613132130-mkvbwvf","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613132130-ucndksr","Type":"NodeParagraph","Properties":{"id":"20240613132130-ucndksr","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" ①郁李（《本经》），又名：英梅（《尔雅》），爵李（《本经》），白橡（《说文》），雀李、车下李（《吴普本草》），山李、爵梅（《广雅》），样藜（《滇南本草》），千金藤（《医学正传》），秧李、穿心梅（《植物名实图考长编》），侧李。"}]},{"ID":"20240613132130-x40yin1","Type":"NodeParagraph","Properties":{"id":"20240613132130-x40yin1","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高1～1.5米。树皮灰褐色，有不规则的纵条纹；幼枝黄棕色，光滑。叶互生；叶柄长2～3毫米，被短柔毛；托叶2枚，线形，呈篦状分裂，早落；叶片通常为长卵形或卵圆形，罕为卵状披针形，长5～6厘米，宽2.5～3厘米，先端渐尖，基部圆形，边缘具不整齐之重锯齿，背面沿主脉具短柔毛。花先叶开放，2～3朵簇生；花梗长2～5毫米，有棱，散生白色短柔毛，基部为数枚茶褐色的鳞片包围，鳞片长圆形，密被锈色绒毛，有细齿；花萼5，基部成浅萼筒，先端锐尖，边缘疏生乳突状锯齿，网脉明显；花瓣5，浅红色或近白色，具浅褐色网纹，斜长圆形，边缘疏生浅齿；雄蕊多数，花药圆形或略呈方形，花丝不等长；雌蕊1，子房长圆形，1室，花柱被柔毛。核果近圆球形，暗红色。花期5月。果期6月。"}]},{"ID":"20240613132130-qvo6aa0","Type":"NodeParagraph","Properties":{"id":"20240613132130-qvo6aa0","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"生长在向阳山坡、路旁或小灌木丛中。分布辽宁、内蒙古、河北、河南、山西、山东、江苏、浙江、福建、湖北、广东等地。"}]},{"ID":"20240613132130-nvyxwfo","Type":"NodeParagraph","Properties":{"id":"20240613132130-nvyxwfo","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"本植物的根（郁李根）亦供药用，另详专条。"}]},{"ID":"20240613132130-y3vx77s","Type":"NodeParagraph","Properties":{"id":"20240613132130-y3vx77s","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②欧李（《异域录》），又名：酸丁（《热河志》），乌拉柰、欧梨。"}]},{"ID":"20240613132130-offvc8w","Type":"NodeParagraph","Properties":{"id":"20240613132130-offvc8w","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高1～1.5米。多分枝，小枝被柔毛。叶互生；叶柄长约2毫米；叶片长圆形或椭圆状披针形，长1.5～5厘米，宽约2厘米，先端尖或短渐尖，基部楔形，边缘有浅细锯齿，两面均光滑，间或在叶背面沿主脉散生短柔毛。花与叶同时开放，单生或2朵并生；花梗长6～8毫米，光滑；花萼5；花瓣5，白色或稍近粉红色，上具较深的同色网纹，长倒卵形至倒卵形；雄蕊多数，花药长圆形至宽线形，花丝不等长；雌蕊1，子房1室，花柱无毛。核果球形。成熟时鲜红色，有光泽。花期4～5月。果期5～6月。"}]},{"ID":"20240613132130-q7js82m","Type":"NodeParagraph","Properties":{"id":"20240613132130-q7js82m","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"生长于向阳山坡上。分布辽宁、吉林、黑龙江、内蒙古、山东、河南、河北等地。"}]},{"ID":"20240613132130-flzydui","Type":"NodeParagraph","Properties":{"id":"20240613132130-flzydui","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"③长梗郁李"}]},{"ID":"20240613132130-awtxlva","Type":"NodeParagraph","Properties":{"id":"20240613132130-awtxlva","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"形态与郁李相似，主要不同点为花梗较长，长达1.5厘米以上。"}]},{"ID":"20240613132130-ssijt4x","Type":"NodeParagraph","Properties":{"id":"20240613132130-ssijt4x","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"分布黑龙江、辽宁、吉林、内蒙古等地。"}]},{"ID":"20240613132130-jdlqcop","Type":"NodeParagraph","Properties":{"id":"20240613132130-jdlqcop","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613132130-qz4e0hj","Type":"NodeParagraph","Properties":{"id":"20240613132130-qz4e0hj","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 干燥的成热种子，略呈长卵形，长5～7毫米，中部直径3～5毫米。表面黄白色、黄棕色或深棕色，由基部向上，具纵向脉纹。顶端锐尖，基部钝曲，中间有圆脐。种皮薄，易剥落，种仁两瓣，白色，带油性。气微，味微苦。以颗粒饱满、淡黄白色、整齐不碎、不出油、无核壳者为佳。"}]},{"ID":"20240613132130-li39xp3","Type":"NodeParagraph","Properties":{"id":"20240613132130-li39xp3","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613132130-pmajlv4","Type":"NodeParagraph","Properties":{"id":"20240613132130-pmajlv4","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 郁李种子含苦杏仁甙、脂肪油58.3～74.2％、挥发性有机酸、粗蛋白质、纤维素、淀粉、油酸。又含皂甙0.96％及植物甾醇、维生素B1，茎皮含鞣质6.3％、纤维素24.94％。叶含维生素C-7.30毫克％。"}]},{"ID":"20240613132130-bh35bie","Type":"NodeParagraph","Properties":{"id":"20240613132130-bh35bie","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"欧李果实含果糖5.2％。截形榆叶梅含氢氰酸，花含维生素C-125.7毫克％。"}]},{"ID":"20240613132130-dhgicag","Type":"NodeParagraph","Properties":{"id":"20240613132130-dhgicag","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613132130-jggi7l9","Type":"NodeParagraph","Properties":{"id":"20240613132130-jggi7l9","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 筛去泥屑，淘净，拣净杂质和碎壳，晒干，用时捣碎。"}]},{"ID":"20240613132130-b7zlyie","Type":"NodeParagraph","Properties":{"id":"20240613132130-b7zlyie","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡采得（郁李仁），先汤浸，然，削上尖，去皮令净，用生蜜浸一宿，漉出阴干，研如膏用。\""}]},{"ID":"20240613132130-0ibd998","Type":"NodeParagraph","Properties":{"id":"20240613132130-0ibd998","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613132130-pvu3vaa","Type":"NodeParagraph","Properties":{"id":"20240613132130-pvu3vaa","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 入脾、大小肠经。"}]},{"ID":"20240613132130-2m2zcp0","Type":"NodeParagraph","Properties":{"id":"20240613132130-2m2zcp0","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"①张元素：\"入脾经气分。\""}]},{"ID":"20240613132130-hlrrenn","Type":"NodeParagraph","Properties":{"id":"20240613132130-hlrrenn","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入大肠经。\""}]},{"ID":"20240613132130-lu37frb","Type":"NodeParagraph","Properties":{"id":"20240613132130-lu37frb","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足太阴、手阳明、手太阳经。\""}]},{"ID":"20240613132130-dzwpq59","Type":"NodeParagraph","Properties":{"id":"20240613132130-dzwpq59","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"④《本草新编》：\"入肝、胆二经。\""}]},{"ID":"20240613132130-7xgot4w","Type":"NodeParagraph","Properties":{"id":"20240613132130-7xgot4w","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613132130-3xk9k4w","Type":"NodeParagraph","Properties":{"id":"20240613132130-3xk9k4w","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 辛苦甘，平。"}]},{"ID":"20240613132130-pa6qp4t","Type":"NodeParagraph","Properties":{"id":"20240613132130-pa6qp4t","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味酸，平。\""}]},{"ID":"20240613132130-squb4kp","Type":"NodeParagraph","Properties":{"id":"20240613132130-squb4kp","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613132130-958w17v","Type":"NodeParagraph","Properties":{"id":"20240613132130-958w17v","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦辛。\""}]},{"ID":"20240613132130-vj7e8eo","Type":"NodeParagraph","Properties":{"id":"20240613132130-vj7e8eo","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"④《蜀本草》：\"甘酸。\""}]},{"ID":"20240613132130-le5ltcm","Type":"NodeParagraph","Properties":{"id":"20240613132130-le5ltcm","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613132130-ap0hegr","Type":"NodeParagraph","Properties":{"id":"20240613132130-ap0hegr","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 阴虚液亏及孕妇慎服。"}]},{"ID":"20240613132130-euebnx8","Type":"NodeParagraph","Properties":{"id":"20240613132130-euebnx8","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"津液不足者，慎勿轻用。\""}]},{"ID":"20240613132130-maowsag","Type":"NodeParagraph","Properties":{"id":"20240613132130-maowsag","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"大便不实者禁用。\""}]},{"ID":"20240613132130-dywgrng","Type":"NodeParagraph","Properties":{"id":"20240613132130-dywgrng","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613132130-9d4a0ii","Type":"NodeParagraph","Properties":{"id":"20240613132130-9d4a0ii","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 润燥，滑肠，下气，利水。治大肠气滞，燥涩不通，小便不利，大腹水肿，四肢浮肿，脚气。"}]},{"ID":"20240613132130-vcl4qzk","Type":"NodeParagraph","Properties":{"id":"20240613132130-vcl4qzk","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主大腹水肿，面目、四肢浮肿，利小便水道。\""}]},{"ID":"20240613132130-vs8dyag","Type":"NodeParagraph","Properties":{"id":"20240613132130-vs8dyag","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"治肠中结气，关格不通。\""}]},{"ID":"20240613132130-2dbe93v","Type":"NodeParagraph","Properties":{"id":"20240613132130-2dbe93v","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"③《食疗本草》：\"破癖气，下四肢水。\""}]},{"ID":"20240613132130-c32d2jr","Type":"NodeParagraph","Properties":{"id":"20240613132130-c32d2jr","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"通泄五脏，膀胱急痛，宣腰胯冷脓，消宿食，下气。\""}]},{"ID":"20240613132130-7w292am","Type":"NodeParagraph","Properties":{"id":"20240613132130-7w292am","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑤《珍珠囊》：\"破血润燥。\""}]},{"ID":"20240613132130-rz1zi4v","Type":"NodeParagraph","Properties":{"id":"20240613132130-rz1zi4v","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑥李杲：\"专治大肠气滞，燥涩不通。\""}]},{"ID":"20240613132130-ms8ofg1","Type":"NodeParagraph","Properties":{"id":"20240613132130-ms8ofg1","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑦《本草再新》：\"行水下气，破血消肿，通关节，治眼长翳。\""}]},{"ID":"20240613132130-00xbb0b","Type":"NodeParagraph","Properties":{"id":"20240613132130-00xbb0b","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613132130-alxt3a3","Type":"NodeParagraph","Properties":{"id":"20240613132130-alxt3a3","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。"}]},{"ID":"20240613132130-qe8nhd6","Type":"NodeParagraph","Properties":{"id":"20240613132130-qe8nhd6","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613132130-t6riwsa","Type":"NodeParagraph","Properties":{"id":"20240613132130-t6riwsa","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" ①治风热气秘：郁李仁（去皮、尖，炒）、陈橘皮（去白，酒一盏煮干）、京三棱【炮制】各一两。上三味，捣罗为散。每服三钱匕，空心煎熟水调下。（《圣济总录》郁李仁散）"}]},{"ID":"20240613132130-fc50fts","Type":"NodeParagraph","Properties":{"id":"20240613132130-fc50fts","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②治产后肠胃燥热，大便秘涩：郁李仁（研如膏）、朴硝（研）各一两，当归（切、焙）、生干地黄（焙）各二两。上四味，将二味粗捣筛，与别研者二味和匀。每服三钱匕，水一盏，煎至七分，去滓温服，未通更服。（《圣济总录》郁李仁饮）"}]},{"ID":"20240613132130-7haaz5s","Type":"NodeParagraph","Properties":{"id":"20240613132130-7haaz5s","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"③治肿满小便不利：陈皮、郁李仁、槟榔，茯苓、白术各一两，甘遂五钱。上为末，每服二钱，姜枣汤下。（《世医得效方》郁李仁散）"}]},{"ID":"20240613132130-9ym19oh","Type":"NodeParagraph","Properties":{"id":"20240613132130-9ym19oh","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"④治脚气肿满喘促，大小便涩：郁李仁半两（去皮研），粳米三合，蜜一合，生姜汁一蚬壳。上先煮粥临欲熟，入三味搅令匀，更煮令熟，空心食之。（《圣惠方》郁李仁粥）"}]},{"ID":"20240613132130-2ngr1ti","Type":"NodeParagraph","Properties":{"id":"20240613132130-2ngr1ti","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑤治水肿胸满气急：郁李仁（炒）、桑根白皮（炙锉），赤小豆（炒）各三两，陈橘皮（汤浸去白，炒）二两，紫苏一两半，茅根（切）四两。上六味，粗捣筛。每服五钱匕，水三盎，煎至一盏，去渣温服。（《圣济总录》郁李仁汤）"}]},{"ID":"20240613132130-oki0lv8","Type":"NodeParagraph","Properties":{"id":"20240613132130-oki0lv8","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑥治血分、气血壅涩，腹胁胀闷，四肢浮肿，坐卧气促：郁李仁、牵牛子各一两，槟榔、干地黄各三分，桂、木香、青橘皮、延胡索各半两。上为细末，食前温酒调下二钱。（《鸡蜂普济方》郁李仁散）"}]},{"ID":"20240613132130-8kweh4s","Type":"NodeParagraph","Properties":{"id":"20240613132130-8kweh4s","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑦治卒心痛：郁李仁三七枚，烂嚼，以新汲水下之，饮温汤尤妙；须臾痛止，却煎薄荷盐汤热呷之。（姚和众）"}]},{"ID":"20240613132130-4tk4gyi","Type":"NodeParagraph","Properties":{"id":"20240613132130-4tk4gyi","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑧治积年上气，咳嗽不得卧：郁李仁一两。用水一升，研如杏酪，去滓，煮令无辛气，次下酥一枣许，同煮热，放温顿服之。（《圣济总录》郁李仁煎）"}]},{"ID":"20240613132130-fivsxdc","Type":"NodeParagraph","Properties":{"id":"20240613132130-fivsxdc","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"⑨治血汗：郁李仁研细，每服一钱匕，研鹅梨汁调下。（《圣济总录》如圣散）"}]},{"ID":"20240613132130-gud1405","Type":"NodeParagraph","Properties":{"id":"20240613132130-gud1405","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613132130-0h85knj","Type":"NodeParagraph","Properties":{"id":"20240613132130-0h85knj","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"郁李仁甘苦而润，其性降，故能下气利水。按《宋史·钱乙传》云，一乳妇因悸而病，既愈，目张不得瞑。乙曰，煮郁李酒饮之使醉，即愈。所以然者，目系内连肝胆，恐则气结，……郁李去结，随酒入胆，结去……，目则能瞑矣。此盖得肯綮之妙者也。\""}]},{"ID":"20240613132130-qo13btn","Type":"NodeParagraph","Properties":{"id":"20240613132130-qo13btn","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"郁李仁，主大腹水肿，面目四肢浮肿者，《经》曰，诸湿肿满，皆属脾土，又曰，诸腹胀大，皆属于热。脾虚而湿热客之，则小肠不利，水气泛溢于面目四肢，辛苦能润热结，降下善导癃闭，小便利则水气悉从之而出矣。\"\"郁李仁，性专降下，善导大肠爆结，利周身水气，然而下后多令人津液亏损，燥结愈甚，乃治标救急之药。\""}]},{"ID":"20240613132130-4uld5z4","Type":"NodeParagraph","Properties":{"id":"20240613132130-4uld5z4","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"③《本革新编》：\"郁李仁，入肝、胆二经，去头风之痛。又入肺，止鼻渊之流涕。消浮肿，利小便，通关格，破血润燥，又其余技。虽非常施之品，实为解急之需。关膈之症，最难开关，郁李仁善入肝，以调逆气，故能达上下，不可不备也。\""}]},{"ID":"20240613132130-mk2gfmk","Type":"NodeParagraph","Properties":{"id":"20240613132130-mk2gfmk","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"④《木草求真》：\"郁李仁，世人多合胡麻同用，以为润燥通便之需，然胡麻功止润燥、暖中、活血，非若郁仁性润，其味辛甘与苦，而能人脾下气，行水破血之剂也。故凡水肿癃急便闭，关格不通，得此体润则滑，味辛则散，味苦则降，与胡麻实异，而又可以相须为用。\""}]},{"ID":"20240613132130-tqz6csx","Type":"NodeParagraph","Properties":{"id":"20240613132130-tqz6csx","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613132130-z0ai53v","Type":"NodeParagraph","Properties":{"id":"20240613132130-z0ai53v","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 上述品种，商品习称\"小李仁\"。另外，在甘肃、内蒙古、河北、山东、辽宁等少数地区，还产一种\"大李仁\"，亦作郁李仁使用。大李仁为蔷薇科植物山樱桃（参见\"山樱桃’条）或截形榆叶梅干燥的成熟种子，外形较大，长径6～10毫米，短径5～7毫米，表面黄棕色，余与小李仁同。"}]},{"ID":"20240613132130-62stsib","Type":"NodeParagraph","Properties":{"id":"20240613132130-62stsib","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613132130-p233e3r","Type":"NodeParagraph","Properties":{"id":"20240613132130-p233e3r","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613132130-b6ij1e8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613132130-b6ij1e8","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"《中华本草》：郁李仁"}]},{"ID":"20240613132130-2coethx","Type":"NodeParagraph","Properties":{"id":"20240613132130-2coethx","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613132130-zeenjla","Type":"NodeParagraph","Properties":{"id":"20240613132130-zeenjla","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" Yù Lǐ Rén"}]},{"ID":"20240613132130-x7c05d8","Type":"NodeParagraph","Properties":{"id":"20240613132130-x7c05d8","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613132130-u461xtd","Type":"NodeParagraph","Properties":{"id":"20240613132130-u461xtd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 郁子、郁里仁、李仁肉、郁李、英梅、爵李、白棣、雀李、车下李、山李、爵梅、样藜、千金藤、秧李、穿心梅、侧李、欧李、酸丁、乌拉柰、欧梨。"}]},{"ID":"20240613132130-7f9xaeh","Type":"NodeParagraph","Properties":{"id":"20240613132130-7f9xaeh","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613132130-oizchna","Type":"NodeParagraph","Properties":{"id":"20240613132130-oizchna","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" Chinese Dwarf Cherry Seed Dwarf Flowering Cherry Seed Longstalk Peach Seed, Seed of Chinese Dwarf Cherry, Seed of Bunge Cherry,Seed of Dwarf Flowering Cherry, Seed of Chinese Bushcherry, Seed of Down"}]},{"ID":"20240613132130-wusce60","Type":"NodeParagraph","Properties":{"id":"20240613132130-wusce60","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613132130-qk8g2qc","Type":"NodeParagraph","Properties":{"id":"20240613132130-qk8g2qc","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》.。"}]},{"ID":"20240613132130-u12a58a","Type":"NodeParagraph","Properties":{"id":"20240613132130-u12a58a","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613132130-x006mzr","Type":"NodeParagraph","Properties":{"id":"20240613132130-x006mzr","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物郁李、欧李、榆叶梅、长梗扁桃等的种仁。"}]},{"ID":"20240613132130-akpy4w1","Type":"NodeParagraph","Properties":{"id":"20240613132130-akpy4w1","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Cerasus japonica(Thunb.)Lois[Prunus japonica Thunb.]2.Cerasus humilis(Bge.)Sok.[Prunus humilis Bge.]3.Amygdalus triloba(Lindl.)Ricder[Prunus triloba Lindl.]4.Amygdalus pedunculata Pall.[Prunus pedunculata(Pall.)Maxin.]"}]},{"ID":"20240613132130-rxmbg9f","Type":"NodeParagraph","Properties":{"id":"20240613132130-rxmbg9f","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5月中旬至6月初当果实呈鲜红色后采收。"}]},{"ID":"20240613132130-l7kps2y","Type":"NodeParagraph","Properties":{"id":"20240613132130-l7kps2y","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613132130-863qd42","Type":"NodeParagraph","Properties":{"id":"20240613132130-863qd42","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.郁李生长在向阳山坡、路旁或小灌木丛中。"}]},{"ID":"20240613132130-4iarmfc","Type":"NodeParagraph","Properties":{"id":"20240613132130-4iarmfc","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.欧李生于海拔100-1800m的向阳山坡沙地，山地灌丛中或庭园栽培。"}]},{"ID":"20240613132130-kmtmc2v","Type":"NodeParagraph","Properties":{"id":"20240613132130-kmtmc2v","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"3.生于山坡、沟旁灌木林中或林缘。"}]},{"ID":"20240613132130-a6a3xel","Type":"NodeParagraph","Properties":{"id":"20240613132130-a6a3xel","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.生于向阳坡地及草原。"}]},{"ID":"20240613132130-vqxdsbd","Type":"NodeParagraph","Properties":{"id":"20240613132130-vqxdsbd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"资源分布：1.郁李分布于东北及河北、山东、浙江等地。"}]},{"ID":"20240613132130-p8blzcd","Type":"NodeParagraph","Properties":{"id":"20240613132130-p8blzcd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.欧李分布于东北及内蒙古、河北、山东、河南等地。"}]},{"ID":"20240613132130-2nq3grf","Type":"NodeParagraph","Properties":{"id":"20240613132130-2nq3grf","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"3.榆叶梅分布于东北、华北及陕西、甘肃、山东、江苏、浙江、江西等地。"}]},{"ID":"20240613132130-tle1g4l","Type":"NodeParagraph","Properties":{"id":"20240613132130-tle1g4l","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.分布于内蒙古、宁夏。"}]},{"ID":"20240613132130-hds11tv","Type":"NodeParagraph","Properties":{"id":"20240613132130-hds11tv","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613132130-kll8wt3","Type":"NodeParagraph","Properties":{"id":"20240613132130-kll8wt3","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 1.郁李，落叶灌木，高1-1.5m。树皮灰褐色，有不规则的纵条纹；幼枝黄棕色，光滑。叶互生；叶柄长2-3mm，被短柔毛；托叶2枚，线形，早落；叶片通常为长卵形或卵圆形，稀为卵状披针形，长3-7cm，宽1.5-2.5cm，先端渐尖，基部圆形，边缘缺刻状尖锐重锯齿，上面深绿色，无毛，下面淡绿色，脉上无毛或有稀疏柔毛。花先叶开放或花叶同开，1-3朵簇生，花梗长5-10mm，有棱；萼筒陀螺形，长宽近相等，无毛，萼片椭圆形；雄蕊约1cm；核表面光滑。花期5月，果期7-8月。"}]},{"ID":"20240613132130-zmve0l3","Type":"NodeParagraph","Properties":{"id":"20240613132130-zmve0l3","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.欧李，落叶灌木，高0.4-1.5m。小枝灰褐色或棕色，被短柔毛。叶互生；叶柄长2-4mm，无毛或被疏稀柔毛；托叶线形，长5-6mm，边缘有腺体；叶片倒卵状长椭圆形或倒卵状披针形，长2.5-5cm，宽1-2cm，中部以上最宽，先端急尖或短渐尖，基部楔形，边缘有单细锯齿或重锯齿，上面深绿色，下面淡绿色，无毛或被稀疏柔毛。花与叶同时开放，单生或2-3朵簇生；花梗长5-10mm，被疏稀短柔毛；萼筒长宽相等，外面被稀疏柔毛，萼片三角卵圆形，先端急尖或圆钝；花瓣白色或粉红色，长圆形或倒卵形；雄蕊30-50；花柱与雄蕊近等长，无毛。核果成熟后近球形，红色或紫红色，直径1.5-1.8cm；核表面除背部两侧外无梭纹。花期4-5月。果期6-10月。"}]},{"ID":"20240613132130-gzh7s64","Type":"NodeParagraph","Properties":{"id":"20240613132130-gzh7s64","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"3.榆叶梅 落叶灌木，稀小乔木，高2-3m。幼枝无毛或微被短柔毛。叶互生；叶柄长5-10mm，被短柔毛；叶片宽椭圆形至倒卵形，长2-6cm，宽1.5-3cm，先端短渐尖，常3裂，基部宽楔形，上面被疏柔毛或无毛，下面被短柔毛，边缘具粗锯齿或重锯齿。花1-2朵，腋生，先于叶开放，直径2-3cm；花梗长4-8mm；萼筒宽钟形，无毛或幼时微被毛；萼片5，卵形，长6-10mm先端圆钝，有时微凹；雄蕊25-30，短于花瓣；子房密被短柔毛，花柱稍长于雄蕊。果实近球形，直径1-1.8cm，先端具小尖头，红色，外被短柔毛；果肉薄，成熟时开裂；核近球形，具厚硬壳，两侧几不压扁，先端圆钝，表面具不整齐的网纹。花期4-5月，果期5-7月。"}]},{"ID":"20240613132130-dollzjh","Type":"NodeParagraph","Properties":{"id":"20240613132130-dollzjh","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.长梗扁桃 本种与上种形态相似，但灌木较矮小，高仅1-2m；叶片先端常不分裂，边缘具不整齐粗锯齿；核宽卵形，先端具小突尖头，表面平滑或稍有皱纹。花期5月，果期7-8月。"}]},{"ID":"20240613132130-a8arfzd","Type":"NodeParagraph","Properties":{"id":"20240613132130-a8arfzd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613132130-qv3jiev","Type":"NodeParagraph","Properties":{"id":"20240613132130-qv3jiev","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 1.生物学特性 性喜光对气候条件要求不严，在冬季-15℃下能自然越冬；夏季40℃时，若水分充足，也有安全度过高温。耐旱，喜湿润，忌涝。对土壤适应性较强，砂质壤土、粘质、黄土均可，因吸收根系分布较浅，故以保水保肥力较强的粘质壤土为佳。"}]},{"ID":"20240613132130-4h91pjo","Type":"NodeParagraph","Properties":{"id":"20240613132130-4h91pjo","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子或分株繁殖。种子繁殖：春播在2月下旬至3月中下旬，秋播在9月至12月中旬。以秋播为好，播后，可借助冬季低温，使核壳破裂，利于发芽，并减少层积手续。播种时，在整好的苗床上，按15cm开沟，深4-5cm，每隔5cm点播1粒种子，播种量每1hm2 75-150kg，播后覆盖细土，厚为种子直径的3-4倍，保持土壤湿润。苗高6cm时，按行距15cm，株距10cm间苗。当年冬前或翌年春皆可移栽。分株繁殖：掘取母株，于春季将根蘖分开，每一株可分苗3-5株，然后按行距1.2m、株距1m开穴栽种，栽后填土、压实、浇水，保持土壤湿润。"}]},{"ID":"20240613132130-6iwlcg7","Type":"NodeParagraph","Properties":{"id":"20240613132130-6iwlcg7","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"田间管理：幼草生长期间，注意中耕除草，并在5月中旬、7月上旬和9月下旬，在中耕后施用稀薄烘水1次。成年树在生长周期中，中耕除草2次，分别在5月下旬和11月进行，中耕除草宜浅不宜深，以免损伤土壤表层的吸收根系，每年在花芽将萌芽时、采果后、落叶各追施1次人粪尿或磷钾肥。"}]},{"ID":"20240613132130-0kkrk61","Type":"NodeParagraph","Properties":{"id":"20240613132130-0kkrk61","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有缩叶病，防治须以波美5度石硫合剂在萌芽展叶前喷施1次，秋季落叶后喷30-50倍硫酸铜液1次，翌年早春再喷波美5度石硫合剂1次，喷药后，如仍有少数病叶出现，应及时摘除，集中烧毁。虫害有梨小食心虫为害。防治应及时修剪受害虫梢，去除落地虫果。此外，在建立郁李园时，应可能远离桃、李、梨等果园。"}]},{"ID":"20240613132130-fx1ezjq","Type":"NodeParagraph","Properties":{"id":"20240613132130-fx1ezjq","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613132130-gq370gt","Type":"NodeParagraph","Properties":{"id":"20240613132130-gq370gt","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 1.郁李仁 种子卵形或圆球形，长约7mm，直径约5mm。种皮淡黄白色至浅棕色。先端尖，基部钝圆。尖端处有一线形种脐，合点处深棕色，直径约1mm，自合处散出多条棕色维管束脉纹。种脊明显。种皮薄，温水浸泡后，种皮脱落，内面贴有白色半透明的残余胚乳；子叶2片，乳白色，富油质。气微，味微苦。"}]},{"ID":"20240613132130-gpt3pxt","Type":"NodeParagraph","Properties":{"id":"20240613132130-gpt3pxt","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.欧李仁 种子卵形至长卵形，少数圆球形，长6-7mm，直径3-4mm。种皮黄棕色。合点深棕色，直径约0.7mm。.3.榆叶梅仁 种子圆锥形，长7-8mm，直径约6mm。种皮红棕色，具皱纹。合点深棕色，直径约2mm。"}]},{"ID":"20240613132130-n5n1lo9","Type":"NodeParagraph","Properties":{"id":"20240613132130-n5n1lo9","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.长梗扁桃形 种子圆锥形，长8-9mm，直径约6mm。种皮红棕色，具皱纹。合点深棕色，直径约2mm。"}]},{"ID":"20240613132130-0al4fli","Type":"NodeParagraph","Properties":{"id":"20240613132130-0al4fli","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"显微鉴定 1.郁李仁 种皮表面观：种子中部种皮表皮细胞圆形、长多角形、椭圆形直径54-137μm，具细胞间隙；石细胞单个散在或2-3个相连，类圆形、长圆形，直径32-98μm，侧壁边缘略呈波浪状弯曲，均匀增厚，约5.5μm，侧壁孔沟较稀疏，形成大小不整齐的齿状壁，底壁纹孔不明显。近尖端处石细胞排列较紧密，椭圆形、类圆形、多角形、长多角形，直径25-51μm，侧壁厚6-16μm，孔沟较密，有的可见纹孔。合点处表皮细胞多角形，直径18-31μm；石细胞较小，单个散在或2-6个聚集，多角形、类圆形，直径12-41μm，侧壁厚约5.5μm，孔沟明显，胞腔类多角形、椭圆形。种子中部横切面：内胚乳细胞约11层。"}]},{"ID":"20240613132130-zd91c1z","Type":"NodeParagraph","Properties":{"id":"20240613132130-zd91c1z","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.欧李仁 种皮表面观：种子中部种皮表皮细胞类长方形、椭圆形，直径44-138μm，细胞间隙细小；石细胞单个散在或2-4个相连，椭圆形、圆形、长卵圆形，长28-100(-119)μm，宽30-57μm，焦距上调可见到石细胞上部形成环状圈，层纹明显，焦距下调，可见侧壁，厚4-8μm，孔沟较稀疏，分布不均匀，形成大小不整齐的齿状壁，底壁近无纹。近尖端处石细胞排列较紧密，多角形、类多角形、类圆形、类长圆形、类三角形，有的一端狭尖，长38-62μm，宽31-49μm，侧壁厚7-13μm，孔沟较密，有的可见纹孔。合点处表皮细胞较小，多角形，直径18-31μm；石细胞较小，单个散在或2-4个聚集，分布均匀，多角形、类圆形，直径20-35μm，侧壁厚5-7(-10)μm，孔沟多不明显，纹孔近无，有的胞腔较小，圆形、椭圆形。种子中部及尖端处种皮薄壁细胞中多含草酸钙簇晶。"}]},{"ID":"20240613132130-crl40dx","Type":"NodeParagraph","Properties":{"id":"20240613132130-crl40dx","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"3.榆叶梅仁 种皮表面观：种子中部种皮细胞长多角形、长圆形，直径44-117μm，具细胞间隙，较小；石细胞单个散在或2-8个相连，有的多至25个，圆形、椭圆形，长57-94μm，宽31-63μm，侧壁厚3-7μm，孔沟较密，较宽，形成大小不整齐的齿状壁，底壁纹孔较少。近顺端处石细胞多个相连，类长方形、多角形、长椭圆形、三角形，长至57μm，宽至25μm，侧壁厚4-12μm，孔沟较稀疏，种皮薄壁细胞中偶见草酸钙簇晶。合点处表皮细胞较大，类多角形，直径至51μm；石细胞，单个或2-6个相连，排列较疏松，类多角形、类圆形，直径11-44μm，侧壁厚约6μm，孔沟明显。"}]},{"ID":"20240613132130-hvvb0g6","Type":"NodeParagraph","Properties":{"id":"20240613132130-hvvb0g6","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.长柄扁桃仁 种子中部表皮石细胞类圆形、长圆形，直径50-125μm，具细胞间隙；石细胞单个散在或2-6个相连，圆形、长圆形，直径31-68μm，侧壁厚约7μm，孔沟较细密，形成整齐的齿状壁，底壁纹孔较少。近尖端处石细胞排列较紧密，类长方形、椭圆形、类圆形、类三角形，长32-75μm，宽25-50μm，侧壁均匀增厚，约10μm，孔沟深而密，成整齐的齿状缺刻。合点处表皮细胞较大，类长方形、类圆形，长31-65μm，宽约31μm，石细胞2-8个相连，排列较疏松，类圆形，直径18-38μm，侧壁厚约8μm，孔沟明显，胞腔较小，多角形、圆形。种子中部及尖端处种皮薄壁细胞中多含草酸钙簇晶。"}]},{"ID":"20240613132130-ros2xnl","Type":"NodeParagraph","Properties":{"id":"20240613132130-ros2xnl","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613132130-giu2y0w","Type":"NodeParagraph","Properties":{"id":"20240613132130-giu2y0w","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 1.郁李 种子含苦杏仁甙(amygdalin)1.82%，并检测出郁李仁甙(prunuside)A、B，还分离到2种蛋白质成分IR-A和IR-B，具有抗炎镇痛药理活性。新鲜果实含蔷薇甙(multiflonin)A、B，即是郁李仁甙A、B，熊果酸(ursolic acid)香草酸(vanillic acid)，原儿茶酸(protocatechuic acid)，阿福豆甙(afzelin)山柰甙(kaempferitrin)，野蔷薇甙(multinoside)A。"}]},{"ID":"20240613132130-xhxgm50","Type":"NodeParagraph","Properties":{"id":"20240613132130-xhxgm50","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.欧李 种子含苦杏仁甙2.25%，并检测出郁李仁甙A、B。"}]},{"ID":"20240613132130-ma8go1p","Type":"NodeParagraph","Properties":{"id":"20240613132130-ma8go1p","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"3.长梗郁李 种子含苦杏仁甙2.30%，并检测出郁李仁甙A、B。"}]},{"ID":"20240613132130-5xda3qi","Type":"NodeParagraph","Properties":{"id":"20240613132130-5xda3qi","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.毛叶欧李 种子含苦杏仁甙2.30%，定性检出郁李仁甙A、B。"}]},{"ID":"20240613132130-hf59z60","Type":"NodeParagraph","Properties":{"id":"20240613132130-hf59z60","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613132130-zap7u4n","Type":"NodeParagraph","Properties":{"id":"20240613132130-zap7u4n","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 1.泻下作用 郁李仁所含的郁李仁甙对实验有强烈泻下作用。其泻下作用机制类似番泻甙，均属大肠性泻剂。但亦有证明，郁李仁水提取物及其脂肪油给小鼠灌胃有极显着的促进小肠运动作用。郁李仁种子的50%水煎剂能明显缩短燥结型便密模型小鼠排便时间，排便次数明显增加。"}]},{"ID":"20240613132130-xfsb40z","Type":"NodeParagraph","Properties":{"id":"20240613132130-xfsb40z","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.抗炎镇痛作用 从郁李仁中提取的蛋白成分IR-A和IR-B静脉给药有抗炎和镇痛作用。对角叉菜胶性足跖肿胀，IR-A的抑制作用ED/50为14.8mg/kg；IR-B为0.7mg/kg。此外，小鼠扭体法表明IR-A和IR-B在5mg/kg静脉注射时都具有明显镇痛作用。IR-A和IR-B从郁李仁中提取的得率分别为3%和0.4%。"}]},{"ID":"20240613132130-5hdksnr","Type":"NodeParagraph","Properties":{"id":"20240613132130-5hdksnr","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613132130-awv0mi7","Type":"NodeParagraph","Properties":{"id":"20240613132130-awv0mi7","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 筛去泥屑，淘净，拣净杂质和碎壳，晒干，用时捣碎；凡采得（郁李仁），先汤浸，然，削上尖，去皮令净，用生蜜浸一宿，漉出阴干，研如膏用。"}]},{"ID":"20240613132130-a2z8kvd","Type":"NodeParagraph","Properties":{"id":"20240613132130-a2z8kvd","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613132130-5jd81ao","Type":"NodeParagraph","Properties":{"id":"20240613132130-5jd81ao","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 1.薄层色谱 取样品粉末，加甲醇制成0.3g/ml溶液，于45℃水浴中温浸30min后离心，上清液供点样，以苦杏仁甙、郁李仁甙A、郁李仁B为对照品。分别点样于同一硅胶G薄层板上，先以氯仿-甲醇-甲酸(2:1:0.4)展开，展距9cm，挥发干溶剂后，二次以氯仿-甲醇（20：1）展开，展距18cm，挥干溶剂，以碘蒸气显色，供试液色谱在与对照品色谱相应位置上显相同的色斑。"}]},{"ID":"20240613132130-irza6ui","Type":"NodeParagraph","Properties":{"id":"20240613132130-irza6ui","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.取本品数粒，捣碎，立即置小试管中，加水少量润湿，试管中悬挂苦味酸试纸后密塞，置50℃温水浴中约5-10min，试纸显砖红色。（检查氢氰酸）"}]},{"ID":"20240613132130-3hm9qkh","Type":"NodeParagraph","Properties":{"id":"20240613132130-3hm9qkh","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613132130-bpve30d","Type":"NodeParagraph","Properties":{"id":"20240613132130-bpve30d","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 脾；肝；胆；大肠；小肠经"}]},{"ID":"20240613132130-pnnarvc","Type":"NodeParagraph","Properties":{"id":"20240613132130-pnnarvc","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613132130-599k4xa","Type":"NodeParagraph","Properties":{"id":"20240613132130-599k4xa","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 辛；苦甘；平；无毒"}]},{"ID":"20240613132130-idfrzah","Type":"NodeParagraph","Properties":{"id":"20240613132130-idfrzah","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613132130-0pht7xg","Type":"NodeParagraph","Properties":{"id":"20240613132130-0pht7xg","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 阴虚液亏及孕妇慎服。忌牛、马肉。"}]},{"ID":"20240613132130-eimt6sy","Type":"NodeParagraph","Properties":{"id":"20240613132130-eimt6sy","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613132130-85j13d5","Type":"NodeParagraph","Properties":{"id":"20240613132130-85j13d5","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 润燥滑肠；下气利水。主大肠气滞；燥涩不通；小便不利；大腹水肿；四肢浮肿；脚气"}]},{"ID":"20240613132130-iy8vnc4","Type":"NodeParagraph","Properties":{"id":"20240613132130-iy8vnc4","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613132130-d5tie76","Type":"NodeParagraph","Properties":{"id":"20240613132130-d5tie76","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。"}]},{"ID":"20240613132130-813ud2s","Type":"NodeParagraph","Properties":{"id":"20240613132130-813ud2s","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613132130-n5q1ujm","Type":"NodeParagraph","Properties":{"id":"20240613132130-n5q1ujm","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 1.《本草纲目》：郁李仁甘苦而润，其性降，故能下气利水。按《宋史·钱乙传》云，一乳妇因悸而病，既愈，目张不得瞑。乙曰，煮郁李酒饮之使醉，即愈。所以然者，目系内连肝胆，恐则气结，郁李去结，随酒入胆，结去，目则能瞑矣。此盖得肯綮之妙者也。"}]},{"ID":"20240613132130-siq86a8","Type":"NodeParagraph","Properties":{"id":"20240613132130-siq86a8","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：郁李仁，主大腹水肿，面目四肢浮肿者，《经》曰，诸湿肿满，皆属脾土，又曰，诸腹胀大，皆属于热。脾虚而湿热客之，则小肠不利，水气泛溢于面目四肢，辛苦能润热结，降下善导癃闭，小便利则水气悉从之而出矣。郁李仁，性专降下，善导大肠燥结，利周身水气，然而下后多令人津液亏损，燥结愈甚，乃治标救急之药。"}]},{"ID":"20240613132130-epshhzo","Type":"NodeParagraph","Properties":{"id":"20240613132130-epshhzo","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"3.《本草新编》：郁李仁，入肝、胆二经，去头风之痛。又入肺，止鼻渊之流涕。消浮肿，利小便，通关格，破血润燥，又其余技。虽非常施之品，实为解急之需。关膈之症，最难开关，郁李仁善入肝，以调逆气，故能达上下，不可不备也。"}]},{"ID":"20240613132130-euxkcug","Type":"NodeParagraph","Properties":{"id":"20240613132130-euxkcug","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"4.本草求真：郁仁李，世人多合胡麻同用，以为润燥通便之需，然胡麻功止润燥、暖中、活血，非若郁仁性润，其味辛甘与苦，而能入脾下气，行气破血之剂也。故凡水肿癃急便闭，关格不通，得此体润则滑，味辛则散，味苦则降，与胡麻实异，而又可以相须为用。"}]},{"ID":"20240613132130-juhkmi1","Type":"NodeParagraph","Properties":{"id":"20240613132130-juhkmi1","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"5.《神农本草经》：主大腹水肿，面目、四肢浮肿，利小便水道。"}]},{"ID":"20240613132130-n7j3t2a","Type":"NodeParagraph","Properties":{"id":"20240613132130-n7j3t2a","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"6.《药性论》：治肠中结气，关格不通。"}]},{"ID":"20240613132130-vb6r3kp","Type":"NodeParagraph","Properties":{"id":"20240613132130-vb6r3kp","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"7.《食疗本草》：破癖气，下四肢水。"}]},{"ID":"20240613132130-feqaxiv","Type":"NodeParagraph","Properties":{"id":"20240613132130-feqaxiv","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：通泄五脏，膀胱急痛，宣腰胯冷脓，消宿食，下气。"}]},{"ID":"20240613132130-8i3mo8n","Type":"NodeParagraph","Properties":{"id":"20240613132130-8i3mo8n","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"9.《珍珠囊》：破血润燥。"}]},{"ID":"20240613132130-n60nxsk","Type":"NodeParagraph","Properties":{"id":"20240613132130-n60nxsk","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"10.李杲：专治大肠气滞，燥涩不通。"}]},{"ID":"20240613132130-ccemknk","Type":"NodeParagraph","Properties":{"id":"20240613132130-ccemknk","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"11.《本草再新》：行水下气，破血消肿，通关节，治眼长翳。"}]},{"ID":"20240613132130-3e9edfi","Type":"NodeParagraph","Properties":{"id":"20240613132130-3e9edfi","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613132130-a8v51no","Type":"NodeParagraph","Properties":{"id":"20240613132130-a8v51no","updated":"20240613132130"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613132132-pfyd2rh","Type":"NodeThematicBreak","Properties":{"id":"20240613132132-pfyd2rh"}},{"ID":"20240613132133-qow26e5","Type":"NodeParagraph","Properties":{"id":"20240613132133-qow26e5"}}]}