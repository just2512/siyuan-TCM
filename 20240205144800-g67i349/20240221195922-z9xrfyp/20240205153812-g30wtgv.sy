0628170017-wdi684w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629100811-x59a0h2","Type":"NodeParagraph","Properties":{"id":"20240629100811-x59a0h2","updated":"20240823113235"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：大戟之毒可用菖蒲解；（"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"红大戟取图不确定是否正确，如错误烦请联系修正"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"——"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"部分图片取图于抖音创作者‘戟缘’"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"）"}]},{"ID":"20240629132211-475ktcv","Type":"NodeParagraph","Properties":{"id":"20240629132211-475ktcv","updated":"20240629134757"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"甘遂、泽漆、大戟"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三者极为相似；统称为猫眼三兄弟，也就是我们所说的猫眼草。可以通过叶片区分，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"泽漆"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶片是倒卵形或者匙形的，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"甘遂"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"的叶片是狭叶披针形或线状披针形，叶片先端钝，无柄或有的有短柄，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"大戟"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"的叶片是长椭圆形的，叶片先端尖，基部近平截。另外泽漆是一年生的草本植物，甘遂和大戟则是多年生的。如下视频。"}]},{"ID":"20240629134639-2qzr1wo","Type":"NodeVideo","Data":"\u003cvideo controls=\"controls\" src=\"assets/甘遂、泽漆、大戟区别-20240629134624-72vhd1p.mp4\" data-src=\"assets/甘遂、泽漆、大戟区别-20240629134624-72vhd1p.mp4\"\u003e\u003c/video\u003e","Properties":{"id":"20240629134639-2qzr1wo","updated":"20240629134639"}},{"ID":"20240629144333-h5ivi55","Type":"NodeParagraph","Properties":{"id":"20240629144333-h5ivi55","updated":"20240629145913"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"三注：关于甘遂、大戟之间的外观上区别取图苦查许久也无结果，矛盾观念较多，不敢断定，如取图不正确的，烦请联系修正并提供证据，谢谢。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240613094523-t21uiv4","Type":"NodeThematicBreak","Properties":{"id":"20240613094523-t21uiv4"}},{"ID":"20240613094607-kp5dr25","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094607-kp5dr25","updated":"20240613094614"},"Children":[{"Type":"NodeText","Data":"大戟《神农本草经》"}]},{"ID":"20240613094607-yl2wqa3","Type":"NodeParagraph","Properties":{"id":"20240613094607-yl2wqa3","updated":"20240613094607"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613094607-yjqpc9o","Type":"NodeParagraph","Properties":{"id":"20240613094607-yjqpc9o","updated":"20240613094607"},"Children":[{"Type":"NodeText","Data":"主蛊毒，十二水肿，满，急痛，积聚，中风，皮肤疼痛，吐逆。一名印巨（案此无生川泽三字者，古或与泽漆为一条）。"}]},{"ID":"20240613094607-ue35px9","Type":"NodeParagraph","Properties":{"id":"20240613094607-ue35px9","updated":"20240613094607"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生常山，十二月采根，阴干。"}]},{"ID":"20240613094607-u1dslfl","Type":"NodeParagraph","Properties":{"id":"20240613094607-u1dslfl","updated":"20240613094607"},"Children":[{"Type":"NodeText","Data":"案《尔雅》云：荞，卬巨。郭璞云：今药草大戟也。《淮南子》缪称训云：大戟去水。"}]},{"ID":"20240613094523-69n9nk3","Type":"NodeThematicBreak","Properties":{"id":"20240613094523-69n9nk3"}},{"ID":"20240613094556-ed0802z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094556-ed0802z","updated":"20240613094603"},"Children":[{"Type":"NodeText","Data":"大戟《本草求真》"}]},{"ID":"20240613094556-y75cpp9","Type":"NodeParagraph","Properties":{"id":"20240613094556-y75cpp9","updated":"20240613094556"},"Children":[{"Type":"NodeText","Data":"（毒草）大泻脏腑水湿"}]},{"ID":"20240613094556-5w2nw1b","Type":"NodeParagraph","Properties":{"id":"20240613094556-5w2nw1b","updated":"20240613094556"},"Children":[{"Type":"NodeText","Data":"大戟（专入肺肾。旁行经络。）气味苦寒。性秉纯阳。峻利居首。上泻肺气。下泄肾水。兼因味辛。旁行经脉。无处不到。浸水色绿。又入肝胆。故书皆载能治十二水毒。蛊结腹满急痛等症。（好古曰。大戟与甘遂同为泄水之药。湿胜者苦燥除之也。）李时珍云。凡痰涎为物。随气升降。无处不到。入于心则迷窍而癫痫。入于肺则窍塞而成咳唾稠粘。喘急背冷。入于肝则留伏蓄聚。而成胁痛干呕。寒热往来。入于经络则麻痹疼痛。入于筋骨则颈项胸背腰胁手足牵引隐痛。三因并以控涎丹主之。盖有大戟能泄脏腑之水湿。甘遂能行经隧之水湿。白芥子能散皮里膜外之痰气。要必实症实热实脉。方可以用。（非实莫用。）否则泻肺伤肾。害人不浅。（李时珍曰。愚按百祥惟用大戟一味。百祥独泻腑。正实则泻其子也。肾邪实而泻其肝也。洁古老人治痘变黑归肾症。用宣风散代百祥膏。亦是泻子之意。盖毒胜火炽则水益涸。风挟火势则土受亏。故津血内竭不能化脓而成青黑干陷之症。泻其风火之毒。所以救肾扶脾也。）若中其毒者。惟菖蒲可解。杭产色紫者良。北产色白者不堪入药。水浆煮。去骨用。得大枣则不损脾。畏菖蒲。反甘草。苗名泽漆。亦行水道。主治略同。"}]},{"ID":"20240613094748-drjt1ad","Type":"NodeThematicBreak","Properties":{"id":"20240613094748-drjt1ad"}},{"ID":"20240613094749-rseiofu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094749-rseiofu","updated":"20240613094753"},"Children":[{"Type":"NodeText","Data":"大戟《本草撮要》"}]},{"ID":"20240613094749-y08qz03","Type":"NodeParagraph","Properties":{"id":"20240613094749-y08qz03","updated":"20240613094749"},"Children":[{"Type":"NodeText","Data":"味苦寒．入足太阳经．功专治十二种水．得甘遂、白芥子疗水气胀满．得干姜治水肿喘急．通经堕胎．误服损真气．白者伤人．浆水煮去骨．得大枣良．畏菖蒲．反甘草．"}]},{"ID":"20240613094738-2th1fyf","Type":"NodeThematicBreak","Properties":{"id":"20240613094738-2th1fyf"}},{"ID":"20240613094739-irdtevh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094739-irdtevh","updated":"20240613094743"},"Children":[{"Type":"NodeText","Data":"大戟《药征》"}]},{"ID":"20240613094739-bjlrouf","Type":"NodeParagraph","Properties":{"id":"20240613094739-bjlrouf","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"主利水也，旁治掣痛咳烦。"}]},{"ID":"20240613094739-mf6rbif","Type":"NodeParagraph","Properties":{"id":"20240613094739-mf6rbif","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240613094739-zx4ie8d","Type":"NodeParagraph","Properties":{"id":"20240613094739-zx4ie8d","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"十枣汤证曰∶引胁下痛。又曰∶咳烦。"}]},{"ID":"20240613094739-mtq43l0","Type":"NodeParagraph","Properties":{"id":"20240613094739-mtq43l0","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240613094739-ww1mxil","Type":"NodeParagraph","Properties":{"id":"20240613094739-ww1mxil","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"淮南子曰∶大戟去水。"}]},{"ID":"20240613094739-z50bpyu","Type":"NodeParagraph","Properties":{"id":"20240613094739-z50bpyu","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240613094739-a2mb8ve","Type":"NodeParagraph","Properties":{"id":"20240613094739-a2mb8ve","updated":"20240613094739"},"Children":[{"Type":"NodeText","Data":"大戟 汉产有两品，绵大戟为良也，本邦之产，其效较劣。"}]},{"ID":"20240613094728-l26g225","Type":"NodeThematicBreak","Properties":{"id":"20240613094728-l26g225"}},{"ID":"20240613094729-7eh3bka","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094729-7eh3bka","updated":"20240613094734"},"Children":[{"Type":"NodeText","Data":"大戟《本草便读》"}]},{"ID":"20240613094729-824hh7v","Type":"NodeParagraph","Properties":{"id":"20240613094729-824hh7v","updated":"20240613094729"},"Children":[{"Type":"NodeText","Data":"通肠涤脏．味辛苦而沉寒．导水行瘀．入肝脾而达肾．亦能发汗．且可消痈．泽漆乃是其苗．阴毒之功类戟．（大戟禀天地阴毒之气．其根色紫黑带黄．味辛苦而寒．服之戟人咽喉．入肝脾肾三经血分．功专泻水散结．通达脏腑．且能行瘀消肿．发汗治风．有毒而能攻毒．故又能治蛊毒疫毒等证．泽漆即大戟苗．性味功用．与大戟相同．似乎苗叶之功．长于治上．故金匮有治咳而脉沉者．泽漆汤主之之一法也．）"}]},{"ID":"20240613094717-udfl7xc","Type":"NodeThematicBreak","Properties":{"id":"20240613094717-udfl7xc"}},{"ID":"20240613094718-gwxys7b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094718-gwxys7b","updated":"20240613094723"},"Children":[{"Type":"NodeText","Data":"大戟《长沙药解》"}]},{"ID":"20240613094718-9qgktlk","Type":"NodeParagraph","Properties":{"id":"20240613094718-9qgktlk","updated":"20240613094718"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主蛊毒，十二水肿，满，急痛，积聚，中风，皮肤疼痛，吐逆。一名印钜。"}]},{"ID":"20240613094718-gqo29w6","Type":"NodeParagraph","Properties":{"id":"20240613094718-gqo29w6","updated":"20240613094718"},"Children":[{"Type":"NodeText","Data":"味苦，性寒，入足太阳膀胱经。泻水饮之停留，通经脉之瘀涩。"}]},{"ID":"20240613094718-lap50ct","Type":"NodeParagraph","Properties":{"id":"20240613094718-lap50ct","updated":"20240613094718"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"十枣汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大枣。"},{"Type":"NodeText","Data":"用之治心胁痞痛，下利呕逆者，治悬饮内痛，脉沉而弦者，以其破结而驱饮也。"}]},{"ID":"20240613094718-bwl04vx","Type":"NodeParagraph","Properties":{"id":"20240613094718-bwl04vx","updated":"20240613094718"},"Children":[{"Type":"NodeText","Data":"大戟破气泻水，兼化老血癥瘀，通经脉结闭，散颈腋痈肿，洗脚气肿痛之病，胥有捷效。"}]},{"ID":"20240613094704-gcg65tq","Type":"NodeThematicBreak","Properties":{"id":"20240613094704-gcg65tq"}},{"ID":"20240613094705-2vhnyk1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094705-2vhnyk1","updated":"20240613094711"},"Children":[{"Type":"NodeText","Data":"大戟《本草简要方》"}]},{"ID":"20240613094705-ivqb61v","Type":"NodeParagraph","Properties":{"id":"20240613094705-ivqb61v","updated":"20240613094705"},"Children":[{"Type":"NodeText","Data":"主治泻脏腑水湿发汗。利大小便。下恶血痞块。除蛊毒通月经堕胎。控涎丸。紫大戟甘遂白芥子（微炒）各一两。研末。姜汁打面糊丸梧子大。每服七丸至二十丸。若取利可服五六十丸。治痰涎留胸膈上下。变为诸病。或颈项胸背腰胁手足胯髀隐痛不可忍。筋骨牵引钓痛走易及皮肤麻痹。似乎瘫痪。又治头痛不可举。或咳唾喘息。或痰迷心窍。大戟散。大戟当归橘皮各一两。水二升煎取七合服。治不问年月浅深水肿。服后下水二三斗。勿惊怪。至重不过再服。忌毒食一年。大戟膏。红芽大戟整枝。温茶洗净。去心嚼融敷。嚼时药汁不可吞下。治一切恶疮疔毒阴疽。"}]},{"ID":"20240613094649-s8f7bfv","Type":"NodeThematicBreak","Properties":{"id":"20240613094649-s8f7bfv"}},{"ID":"20240613094650-ojysy39","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094650-ojysy39","updated":"20240613094659"},"Children":[{"Type":"NodeText","Data":"大戟《本草图经》"}]},{"ID":"20240613094650-kyp0jsz","Type":"NodeParagraph","Properties":{"id":"20240613094650-kyp0jsz","updated":"20240613094653"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大戟"},{"Type":"NodeText","Data":"，泽漆根也。生常山，今近道多有之。春生红芽，渐长作丛，高一尺以来；叶似初生杨柳小团；三月、四月开黄紫花；团圆似杏花，又似芜荑；根似细苦参，皮黄黑，肉黄白色；秋冬采根，阴干。淮甸出者茎圆，高三、四尺，花黄，叶至心亦如百合苗。江南生者叶似芍药。医家用治隐疹风及风毒脚肿，并煮水热淋，日再三，便愈。李绛《兵部手集方》∶疗水病无问年月深浅，虽复脉恶亦主之。大戟、当归、橘皮各一大两，切，以水二大升，煮取七合，顿服。利水二、三斗，勿怪。至重，不过再服，便瘥。"}]},{"ID":"20240613094650-7dsfvx4","Type":"NodeParagraph","Properties":{"id":"20240613094650-7dsfvx4","updated":"20240613094650"},"Children":[{"Type":"NodeText","Data":"禁毒食一年。水下后，更服，永不作。此方出张尚客。"}]},{"ID":"20240613094637-vg922ua","Type":"NodeThematicBreak","Properties":{"id":"20240613094637-vg922ua"}},{"ID":"20240613094638-4q5ysnm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094638-4q5ysnm","updated":"20240613094642"},"Children":[{"Type":"NodeText","Data":"大戟《汤液本草》"}]},{"ID":"20240613094638-sc26ujz","Type":"NodeParagraph","Properties":{"id":"20240613094638-sc26ujz","updated":"20240613094638"},"Children":[{"Type":"NodeText","Data":"气大寒，味苦、甘，阴中微阳。有小毒。"}]},{"ID":"20240613094638-uz8lx1z","Type":"NodeParagraph","Properties":{"id":"20240613094638-uz8lx1z","updated":"20240613094638"},"Children":[{"Type":"NodeText","Data":"《本草》云∶治蛊毒，十二水，腹满急痛，积聚，中风，皮肤疼痛，吐逆，颈腋痈肿，头疼，发汗，利大小肠。此泽漆根也。"}]},{"ID":"20240613094638-4d8b423","Type":"NodeParagraph","Properties":{"id":"20240613094638-4d8b423","updated":"20240613094638"},"Children":[{"Type":"NodeText","Data":"《液》云∶与甘遂同为泄水之药，湿胜者苦燥除之。反甘草。与芫花、黄药子等分，水糊为丸，桐子大，每服十丸，伤风、伤寒，葱白汤下；伤食，陈皮汤下。或十五丸，微加至止，亦可。芫花别有条，海藏，十枣汤同用。"}]},{"ID":"20240613094638-gen5zhe","Type":"NodeParagraph","Properties":{"id":"20240613094638-gen5zhe","updated":"20240613094638"},"Children":[{"Type":"NodeText","Data":"《珍》云∶泻肺，损真气。"}]},{"ID":"20240613094624-16nn8rp","Type":"NodeThematicBreak","Properties":{"id":"20240613094624-16nn8rp"}},{"ID":"20240613094626-wlx56nx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094626-wlx56nx","updated":"20240613094632"},"Children":[{"Type":"NodeText","Data":"大戟《得配本草》"}]},{"ID":"20240613094626-kpraa2i","Type":"NodeParagraph","Properties":{"id":"20240613094626-kpraa2i","updated":"20240613094626"},"Children":[{"Type":"NodeText","Data":"得枣良。小豆为之使。畏菖蒲、芦苇、鼠屎。恶薯蓣。反甘草。（菖蒲解之。）"}]},{"ID":"20240613094626-iee7pnw","Type":"NodeParagraph","Properties":{"id":"20240613094626-iee7pnw","updated":"20240613094626"},"Children":[{"Type":"NodeText","Data":"苦，寒，有毒。入三阴、足太阳经。泻内外上下之水溢。驱虫毒，破症结，逐血瘀，除痰饮。配干姜为散，治水肿喘急。煮大枣，治水肿。（去戟取枣食之。）"}]},{"ID":"20240613094626-gumnhor","Type":"NodeParagraph","Properties":{"id":"20240613094626-gumnhor","updated":"20240613094626"},"Children":[{"Type":"NodeText","Data":"泔水浸洗，再用浆水煮干，去骨用。宜采正根用。若误用旁附，则冷泻不禁，即煎荠汤解之。妄用杀人。"}]},{"ID":"20240613094833-17ak5ol","Type":"NodeThematicBreak","Properties":{"id":"20240613094833-17ak5ol"}},{"ID":"20240613094834-3rt9fq0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094834-3rt9fq0","updated":"20240613094843"},"Children":[{"Type":"NodeText","Data":"大戟《本经逢原》"}]},{"ID":"20240613094834-2nwi90t","Type":"NodeParagraph","Properties":{"id":"20240613094834-2nwi90t","updated":"20240613094834"},"Children":[{"Type":"NodeText","Data":"苦、辛，大寒，有毒，反甘草。入药惟用正根，误服傍株，令人冷泻。枣煮则不损脾，乘软去骨用。"}]},{"ID":"20240613094834-50wn4o9","Type":"NodeParagraph","Properties":{"id":"20240613094834-50wn4o9","updated":"20240613094834"},"Children":[{"Type":"NodeText","Data":"《本经》主蛊毒，十二水，腹满急痛，积聚，中风皮肤疼痛，吐逆。"}]},{"ID":"20240613094834-73ogcjl","Type":"NodeParagraph","Properties":{"id":"20240613094834-73ogcjl","updated":"20240613094834"},"Children":[{"Type":"NodeText","Data":"〔发明〕大戟性禀阴毒，峻利首推，苦寒下走肾阴，辛散上泻肺气，兼横行经脉。故《本经》专治蛊毒、十二水、腹满急痛等证，皆浊阴填塞所致，然惟暴胀为宜；云中风者，是指风水肤胀而言，否则传写之误耳，夫大戟、甘遂之苦以泄水者，肾所主也。痰涎之为物，随气升降，无处不到，入于心，则迷窍而成癫痫、妄言妄见；入于肺，则塞窍而成咳唾稠粘、喘急背冷；入于肝，则留伏蓄聚而成胁痛干呕、寒热往来；入于经络，则麻痹疼痛；入于筋骨，则颈项胸背腰胁手足牵引隐痛，《三因方》并以控涎丹主之。大戟能泻脏腑之水湿，甘遂能行经隧之水湿，白芥子能散皮里膜外之痰气，惟善用者能收奇功也。痘疮变黑归肾，枣变百祥丸用大戟制枣，去戟用枣以泻肝邪，非泻肾也，实则泻其子，因肾邪实而泻其肝也。仲景云：心下痞满，引胁下痛，干呕短气者，十枣汤主之。其中亦有大戟。夫干呕胁痛，岂非肝胆之病乎，百祥丸之泻肝明矣。至玉枢丹同续随子、山慈菇等解蛊毒药，则又不独肝胆矣。其脾胃肝肾虚寒，阴水泛滥，犯之立毙，不可不审。"}]},{"ID":"20240613094523-40v8fer","Type":"NodeThematicBreak","Properties":{"id":"20240613094523-40v8fer"}},{"ID":"20240613094546-ojrdepg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094546-ojrdepg","updated":"20240613094552"},"Children":[{"Type":"NodeText","Data":"大戟《本草经集注》"}]},{"ID":"20240613094546-t6iy2s1","Type":"NodeParagraph","Properties":{"id":"20240613094546-t6iy2s1","updated":"20240613094546"},"Children":[{"Type":"NodeText","Data":"味苦、甘，寒，大寒，有小毒。主治蛊毒，十二水，腹满急痛，积聚，中风，皮肤疼痛，吐逆。颈腋痈肿，头痛，发汗，利大小肠。一名邛巨。生常山。十二月采根，阴干。（反甘草，畏菖蒲、芦草、鼠屎。）"}]},{"ID":"20240613094546-zx8akhf","Type":"NodeParagraph","Properties":{"id":"20240613094546-zx8akhf","updated":"20240613094546"},"Children":[{"Type":"NodeText","Data":"近道处处有，至猥贱也。"}]},{"ID":"20240613094523-ouyznvy","Type":"NodeThematicBreak","Properties":{"id":"20240613094523-ouyznvy"}},{"ID":"20240613094530-7odhxc6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094530-7odhxc6","updated":"20240613094536"},"Children":[{"Type":"NodeText","Data":"大戟《名医别录》"}]},{"ID":"20240613094530-0nku1qw","Type":"NodeParagraph","Properties":{"id":"20240613094530-0nku1qw","updated":"20240613094530"},"Children":[{"Type":"NodeText","Data":"味甘，大寒，有小毒．主治颈腋痈肿，头痛，发汗，利大小肠．生常山．十二月采根阴干．（反甘草．）"}]},{"ID":"20240613094530-1i3n30h","Type":"NodeParagraph","Properties":{"id":"20240613094530-1i3n30h","updated":"20240613094530"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶大戟，味苦，寒．主蛊毒，十二水，肿满急痛积聚，中风皮肤疼痛，吐逆．一名邛鉅．"}]},{"ID":"20240613094235-3q7nhlw","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-3q7nhlw"}},{"ID":"20240613094515-mvb9ime","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094515-mvb9ime","updated":"20240613094519"},"Children":[{"Type":"NodeText","Data":"大戟《医学入门》"}]},{"ID":"20240613094515-wc2rfk4","Type":"NodeParagraph","Properties":{"id":"20240613094515-wc2rfk4","updated":"20240613094515"},"Children":[{"Type":"NodeText","Data":"大戟苦甘寒有毒，消十二肿宽胸腹，破癖逐瘀通经孕，祛风散肿辟瘟疫。"}]},{"ID":"20240613094515-ggeq0s9","Type":"NodeParagraph","Properties":{"id":"20240613094515-ggeq0s9","updated":"20240613094515"},"Children":[{"Type":"NodeText","Data":"枝茎似戟，处处有之。春生红芽，叶似初生杨柳，根似苦参。秋冬采根。大寒。阴中微阳。主利大小肠，消十二水肿，胸腹胀满急痛，破 结癖块，下恶血，通月水，堕胎孕，治中风，皮肤瘾疹疼痛，吐逆，颈腋痈肿及天行黄病，温疟，蛊毒，头疼便秘。此药能汗且下之。珍云∶泻肺损真气，与甘遂同为驱逐剂耳。细锉蒸或微炒。赤小豆为使。恶山药，畏芦草、鼠屎，反芫花、海藻，毒用菖蒲解之。泽漆，即大戟苗，生川泽，采时叶有白叶如漆。味苦辛，微寒，无毒。主皮肤热，大腹水气，四肢面目浮肿，利大小肠，止疟，止咳，消痰，杀蛊毒。端午日采，日干。赤小豆为使，恶山药。"}]},{"ID":"20240613094235-wa7tj2m","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-wa7tj2m"}},{"ID":"20240613094503-4kapn3m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094503-4kapn3m","updated":"20240613094509"},"Children":[{"Type":"NodeText","Data":"大戟《证类本草》"}]},{"ID":"20240613094503-8jfp0j7","Type":"NodeParagraph","Properties":{"id":"20240613094503-8jfp0j7","updated":"20240613094503"},"Children":[{"Type":"NodeText","Data":"味苦、甘，寒、大寒，有小毒。主蛊毒，十二水，腹满急痛积聚，中风皮肤疼痛，吐逆，颈腋痈肿，头痛，发汗，利大小肠。一名邛鉅。生常山。十二月采根，阴干。（反甘草。）"}]},{"ID":"20240613094503-b33uyg3","Type":"NodeParagraph","Properties":{"id":"20240613094503-b33uyg3","updated":"20240613094503"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处皆有。至猥贱也。臣禹锡等谨按唐本云∶畏菖蒲、芦草、鼠尿。蜀本图经云∶苗似甘遂高硕，叶有白汁，花黄。根似细苦参，皮黄黑，肉黄白。五月采苗，二月、八月采根用。尔雅云∶荞，邛鉅。注云∶今本草大戟也。药性论云∶大戟，使。反芫花、海藻，毒用菖蒲解之。味苦、辛，有大毒。破新陈，下恶血癖块，腹内雷鸣，通月水，善治瘀血，能堕胎孕。日华子云∶小豆为之使，恶薯蓣。泻毒药，泄天行黄病温疟，破症结。"}]},{"ID":"20240613094503-ss7qbdh","Type":"NodeParagraph","Properties":{"id":"20240613094503-ss7qbdh","updated":"20240613094503"},"Children":[{"Type":"NodeText","Data":"图经曰∶大戟，泽漆根也。生常山，今近道多有之。春生红芽，渐长作丛，高一尺以来。"}]},{"ID":"20240613094503-tanejma","Type":"NodeParagraph","Properties":{"id":"20240613094503-tanejma","updated":"20240613094503"},"Children":[{"Type":"NodeText","Data":"叶似初生杨柳小团。三月、四月开黄紫花，团圆似杏花，又似芜荑。根似细苦参，皮黄黑，肉黄白色，秋冬采根，阴干。淮甸出者茎圆，高三、四尺，花黄，叶至心亦如百合苗。江南生者叶似芍药。医家用治隐疹风，及风毒脚肿，并煮水热淋，日再三便愈。李绛《兵部手集方》∶疗水病，无问年月深浅，虽复脉恶亦主之。大戟、当归、橘皮各一大两切，以水二大升，煮取七合，顿服。利水二、三斗，勿怪。至重，不过再服便瘥。禁毒食一年，水下后更服，永不作。此方出张尚客。"}]},{"ID":"20240613094503-96x2n2m","Type":"NodeParagraph","Properties":{"id":"20240613094503-96x2n2m","updated":"20240613094503"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用附生者，若服冷泄气不禁，即煎荠 子汤解。夫采得后，于槐砧上细锉，与细锉海芋叶拌蒸，从巳至申，去芋叶，晒干用之。太上八帝玄变经大戟必泻。"}]},{"ID":"20240613094235-corsq50","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-corsq50"}},{"ID":"20240613094454-3pyn7mc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094454-3pyn7mc","updated":"20240613094457"},"Children":[{"Type":"NodeText","Data":"大戟《本草纲目》"}]},{"ID":"20240613094454-3y1g1gg","Type":"NodeParagraph","Properties":{"id":"20240613094454-3y1g1gg","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"「释名」邛巨、下马仙。"}]},{"ID":"20240613094454-7f3ruph","Type":"NodeParagraph","Properties":{"id":"20240613094454-7f3ruph","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、有小毒。"}]},{"ID":"20240613094454-goafwh8","Type":"NodeParagraph","Properties":{"id":"20240613094454-goafwh8","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613094454-6ecvozi","Type":"NodeParagraph","Properties":{"id":"20240613094454-6ecvozi","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"1、水肿喘包。用大戟（炒）二两、干姜（炮）半两，共研为末，每服三钱，姜汤送下。以大小便通畅为度。"}]},{"ID":"20240613094454-bh2vngk","Type":"NodeParagraph","Properties":{"id":"20240613094454-bh2vngk","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"2、水病肿满。用大戟、当归、橘皮各一两，切碎，加水二升，煮取七俣，一次服下，病重者，再服一次可愈。病愈后，一年之内须慎饮食，不吃刺激性大的东西。"}]},{"ID":"20240613094454-07bhrqn","Type":"NodeParagraph","Properties":{"id":"20240613094454-07bhrqn","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"3、水肿腹大（或遍身浮肿）。用枣一半，放锅内，上面盖着大戟的根、苗，不加盖煮熟，随时取枣吃下，枣尽病愈。又方：大戟、白牵牛、木香，等分为末。每取一钱，纳入剖开的猪肾中，用湿纸包好煨熟，空心吃下。"}]},{"ID":"20240613094454-51cbbcr","Type":"NodeParagraph","Properties":{"id":"20240613094454-51cbbcr","updated":"20240613094454"},"Children":[{"Type":"NodeText","Data":"4、牙痛。把大戟放口中齿痛处，咬定。止痛效果好。"}]},{"ID":"20240613094235-ege9hc3","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-ege9hc3"}},{"ID":"20240613094444-gpcmn00","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094444-gpcmn00","updated":"20240613094448"},"Children":[{"Type":"NodeText","Data":"大戟《本草备要》"}]},{"ID":"20240613094444-fo98wmr","Type":"NodeParagraph","Properties":{"id":"20240613094444-fo98wmr","updated":"20240613094444"},"Children":[{"Type":"NodeText","Data":"大泻，通脏腑水湿"}]},{"ID":"20240613094444-rriynvx","Type":"NodeParagraph","Properties":{"id":"20240613094444-rriynvx","updated":"20240613094444"},"Children":[{"Type":"NodeText","Data":"苦寒有毒。能泻脏腑水湿，行血发汗，利大小便。"}]},{"ID":"20240613094444-fz6e61e","Type":"NodeParagraph","Properties":{"id":"20240613094444-fz6e61e","updated":"20240613094444"},"Children":[{"Type":"NodeText","Data":"治十二种水，腹满急痛，积聚症瘕，颈腋痈肿，风毒脚肿，通经堕胎。误服损真气（时珍曰∶痰涎为物，随气升降，无处不到。入心则迷，成癫痫；入肺则塞窍，为咳喘背冷；入肝则胁痛干呕，寒热往来；入经络则麻痹疼痛；入筋骨则牵引隐痛；入皮肉则瘰 痈肿。陈无择并以控涎丹主之，殊有奇效，此乃治痰之本。痰之本，水也，湿也，得气与火。则结为痰。大戟能泄脏腑水湿，甘遂能行经络水湿，白芥子能散皮里膜外痰气，惟善用者能收奇功也。又曰∶钱仲阳谓肾为真水，有补无泻。复云痘症变黑归肾者，用百祥膏下之，非泻肾也，泻其腑，则脏自不实。腑者，膀胱也。百祥惟大戟一味，能行膀腕之水故也。窍谓非独泻腑，乃肾邪实而泻肝也。实则泻其子，大戟浸水青绿，肝胆之色也。痘症毒盛火炽，则水益涸，风挟火势，则土受亏，故津液内竭，不能化脓，而成黑陷之证，泻其风火之毒，所以救肾扶脾也。昂按∶泻心乃所以补心，泻肾即所以救肾，邪热退，则真阴复矣。《机要》用大戟一两，枣三枚，同煮焙干，去戟，用枣丸服，名枣变百祥丸）。"}]},{"ID":"20240613094444-dib8iiv","Type":"NodeParagraph","Properties":{"id":"20240613094444-dib8iiv","updated":"20240613094444"},"Children":[{"Type":"NodeText","Data":"杭产紫者为上，北产白者伤人。浆水煮，去骨用。得大枣则不损脾。畏菖蒲。反甘草。"}]},{"ID":"20240613094235-g5w887u","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-g5w887u"}},{"ID":"20240613094431-w90qvdj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094431-w90qvdj","updated":"20240613094438"},"Children":[{"Type":"NodeText","Data":"大戟《本草崇原》"}]},{"ID":"20240613094431-ax2tyg3","Type":"NodeParagraph","Properties":{"id":"20240613094431-ax2tyg3","updated":"20240613094431"},"Children":[{"Type":"NodeText","Data":"气味苦寒，有小毒。主治蛊毒，十二水，腹满急痛，积聚，中风皮肤疼痛，吐逆。"}]},{"ID":"20240613094431-isr7tsx","Type":"NodeParagraph","Properties":{"id":"20240613094431-isr7tsx","updated":"20240613094431"},"Children":[{"Type":"NodeText","Data":"（大戟始出常山，今近道皆有之，多生平泽，春生红芽，渐长丛高，茎直中空，叶长狭如柳，折之有白汁，三四月开黄紫花，根皮有紫色，有黄白色，浸于水中，水色青绿。杭州紫大戟为上，江南土大戟次之，北方绵大戟根皮柔韧于如绵而色白，甚峻利能伤人。）"}]},{"ID":"20240613094431-gcllsff","Type":"NodeParagraph","Properties":{"id":"20240613094431-gcllsff","updated":"20240613094431"},"Children":[{"Type":"NodeText","Data":"大戟生于西北，茎有白汁，味苦气寒，皮浸水中，其色青绿，乃禀金水木相生之气化。"}]},{"ID":"20240613094431-34bpxtl","Type":"NodeParagraph","Properties":{"id":"20240613094431-34bpxtl","updated":"20240613094431"},"Children":[{"Type":"NodeText","Data":"水能生木，则木气营运，故主治蛊毒。治蛊毒者，土得木而达也。金能生水，则水气营运，故主治十二水。十二经脉环绕一身，十二水者，一身水气不行而肿也。腹满急痛，积聚，言蛊毒之病，则腹满急痛，内有积聚，大戟能治之。中风皮肤疼痛，言十二水之病，则身中于风而皮肤疼痛，大戟亦能治之。吐逆者，腹满急痛，积聚，则土气不和。中风皮肤疼痛，则肌表不通，皆致吐逆，而大戟皆能治之也。"}]},{"ID":"20240613094235-uhb5s2u","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-uhb5s2u"}},{"ID":"20240613094420-ejnbsiy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094420-ejnbsiy","updated":"20240613094425"},"Children":[{"Type":"NodeText","Data":"大戟《新修本草》"}]},{"ID":"20240613094420-hvi9gdy","Type":"NodeParagraph","Properties":{"id":"20240613094420-hvi9gdy","updated":"20240613094420"},"Children":[{"Type":"NodeText","Data":"味苦、甘，寒、大寒，有小毒。主蛊毒，十二水，腹满急痛，积聚，中风，皮肤疼痛，吐汗，利大小肠。一名邛巨。生常山。十二月采根，阴干。"}]},{"ID":"20240613094420-1lkfusp","Type":"NodeParagraph","Properties":{"id":"20240613094420-1lkfusp","updated":"20240613094420"},"Children":[{"Type":"NodeText","Data":"反甘草，畏菖蒲、芦草、鼠屎。近道处处有，至猥贱也。"}]},{"ID":"20240613094257-ft4v8c5","Type":"NodeThematicBreak","Properties":{"id":"20240613094257-ft4v8c5"}},{"ID":"20240613094409-nco2a49","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094409-nco2a49","updated":"20240613094415"},"Children":[{"Type":"NodeText","Data":"大戟《本草择要纲目》"}]},{"ID":"20240613094409-v6kcojd","Type":"NodeParagraph","Properties":{"id":"20240613094409-v6kcojd","updated":"20240613094409"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240613094409-7n6uu28","Type":"NodeParagraph","Properties":{"id":"20240613094409-7n6uu28","updated":"20240613094409"},"Children":[{"Type":"NodeText","Data":"苦寒有小毒．阴中之微阳也．"}]},{"ID":"20240613094409-buitw2c","Type":"NodeParagraph","Properties":{"id":"20240613094409-buitw2c","updated":"20240613094409"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240613094409-afm5aez","Type":"NodeParagraph","Properties":{"id":"20240613094409-afm5aez","updated":"20240613094409"},"Children":[{"Type":"NodeText","Data":"蛊毒十二水．腹满急痛．破症结．并甘遂同为泄水之重剂．盖水湿也．得气与火．则凝滞而为痰为涎为涕为癖．故入心迷窍则成癫痫妄言妄见．入肺塞窍则成咳唾稠粘喘息背冷．入肝而留伏蓄聚则成胁痛干呕寒热往来．入经络则麻痹疼痛．入筋骨则颈项胸背腰胁手足牵引．三因方并以控涎丹主之．总以大戟能泄脏腑之水湿．善用之可奏奇功也．又钱氏谓肾为真水．有补无泻．而复云痘疮变黑归肾一症．乃用百祥膏下之以泻肾者也．盖非泻肾．是泻其腑而脏自不实也．然其性苦寒有毒．最损真气．须认症确审．方可言用．"}]},{"ID":"20240613094257-r8h9yd8","Type":"NodeThematicBreak","Properties":{"id":"20240613094257-r8h9yd8"}},{"ID":"20240613094304-cbfz46s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094304-cbfz46s","updated":"20240613094318"},"Children":[{"Type":"NodeText","Data":"大戟《中药学》"}]},{"ID":"20240613094304-tayy3bq","Type":"NodeParagraph","Properties":{"id":"20240613094304-tayy3bq","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【药用】本品为茜草科植物红芽大戟、或大戟科植物京大戟的根。"}]},{"ID":"20240613094304-t1k92n1","Type":"NodeParagraph","Properties":{"id":"20240613094304-t1k92n1","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒。有毒。入肺、脾、肾经。"}]},{"ID":"20240613094304-h39153e","Type":"NodeParagraph","Properties":{"id":"20240613094304-h39153e","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【功效】泻水逐饮，消肿散结。"}]},{"ID":"20240613094304-vigbwfl","Type":"NodeParagraph","Properties":{"id":"20240613094304-vigbwfl","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于水肿腹水，留饮胸痛等症。"}]},{"ID":"20240613094304-wvsaqdb","Type":"NodeParagraph","Properties":{"id":"20240613094304-wvsaqdb","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"大戟攻水逐饮的功效，与甘遂相似，故可用于胸水、腹水、水肿喘满等症，多与甘遂、芫花等同用。"}]},{"ID":"20240613094304-h1ajgih","Type":"NodeParagraph","Properties":{"id":"20240613094304-h1ajgih","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"2.用于疮痈肿痛及痧胀等症。"}]},{"ID":"20240613094304-skfn5ry","Type":"NodeParagraph","Properties":{"id":"20240613094304-skfn5ry","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"本品外用能消肿散结，内服能攻泻而通结滞。如常用成方玉枢丹，即是红芽大戟配伍千金子、山慈菇、五倍子、雄黄、麝香等品而成，外涂用于消疮肿，内服治痧胀、腹痛、胸脘烦闷、呕吐泄泻等症。"}]},{"ID":"20240613094304-1x3e50d","Type":"NodeParagraph","Properties":{"id":"20240613094304-1x3e50d","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【处方用名】大戟、红芽大戟（洗净，晒干，切片用）"}]},{"ID":"20240613094304-wr31ufo","Type":"NodeParagraph","Properties":{"id":"20240613094304-wr31ufo","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】五分至一钱五分，煎服。研末吞服，每次三分，每天一次。孕妇忌服。"}]},{"ID":"20240613094304-j5gb1s3","Type":"NodeParagraph","Properties":{"id":"20240613094304-j5gb1s3","updated":"20240613094304"},"Children":[{"Type":"NodeText","Data":"【方剂举例】大戟散《活法机要》：大戟、木香、牵牛子、猪腰子。治水肿、腹大如鼓。"}]},{"ID":"20240613094235-hd9moou","Type":"NodeThematicBreak","Properties":{"id":"20240613094235-hd9moou"}},{"ID":"20240613094246-mkdsqhh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094246-mkdsqhh","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：大戟"}]},{"ID":"20240613094246-kywzpcz","Type":"NodeParagraph","Properties":{"id":"20240613094246-kywzpcz","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613094246-4nsuf62","Type":"NodeParagraph","Properties":{"id":"20240613094246-4nsuf62","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" Dà Jǐ"}]},{"ID":"20240613094246-2inj0fw","Type":"NodeParagraph","Properties":{"id":"20240613094246-2inj0fw","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613094246-nloa4cl","Type":"NodeParagraph","Properties":{"id":"20240613094246-nloa4cl","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 下马仙（《纲目》）"}]},{"ID":"20240613094246-gngykzf","Type":"NodeParagraph","Properties":{"id":"20240613094246-gngykzf","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613094246-ua5ll2l","Type":"NodeParagraph","Properties":{"id":"20240613094246-ua5ll2l","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613094246-9dem3c7","Type":"NodeParagraph","Properties":{"id":"20240613094246-9dem3c7","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613094246-y9sak4s","Type":"NodeParagraph","Properties":{"id":"20240613094246-y9sak4s","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 为大戟科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大戟"},{"Type":"NodeText","Data":"或茜草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红芽大戟"},{"Type":"NodeText","Data":"的根。春季未发芽前，或秋季茎叶枯萎时采挖，除去残茎及须根，洗净晒干。"}]},{"ID":"20240613094246-9rhqghl","Type":"NodeParagraph","Properties":{"id":"20240613094246-9rhqghl","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613094246-t739yjz","Type":"NodeParagraph","Properties":{"id":"20240613094246-t739yjz","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" ①大戟，又名：荞（《尔雅》），邛巨（《本经，），龙虎草、九头狮子草、京大戟，将军草、臌胀草、天平一枝香、迫水龙、大猫儿眼、黄花大戟、黄芽大戟、千层塔、搜山虎、穿山虎、一盘棋。"}]},{"ID":"20240613094246-zuah4ww","Type":"NodeParagraph","Properties":{"id":"20240613094246-zuah4ww","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～80厘米，全株含有白色乳汁。根细长，圆锥状。茎直立，上部分枝，表面被白色短柔毛。单叶互生；几无柄；长圆形或披针形，长3～6厘米，宽6～12毫米，全缘，下面稍被白粉。杯状聚伞花序，通常5枝，排列成复伞形；基部有叶状苞片5；每枝再作2至数回分枝，分枝处着生近圆形的苞叶4或2，对生；雌、雄花均无花被，花序基部苞叶近肾形；萼状总苞内有雄花多数，每花仅有雄蕊1，花丝细柱形；花序中央有雌花1，仅有雌蕊1，子房圆形，花柱3，顶端分又，伸出总苞外并常下垂。蒴果三棱状球形，表面具疣状凸起物。种子卵圆形，表面光滑，灰褐色。花期4～5月。果期6～7月。"}]},{"ID":"20240613094246-oevnffy","Type":"NodeParagraph","Properties":{"id":"20240613094246-oevnffy","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"生于路旁、山坡、荒地及较阴湿的树林下。分布东北、华东地区及河北、河南、湖南、湖北，四川、广东、广西等地。"}]},{"ID":"20240613094246-qxsjf4y","Type":"NodeParagraph","Properties":{"id":"20240613094246-qxsjf4y","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②红芽大戟（《小儿药证直诀》）"}]},{"ID":"20240613094246-y765nwv","Type":"NodeParagraph","Properties":{"id":"20240613094246-y765nwv","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"多年生草本，高0.3～1米。块根通常2～3个，纺锤形，红褐色残棕褐色，直径0.5～2厘米。茎直立，分枝少或不分枝，小枝具2行小绒毛；托叶通常4枚，与叶柄合生，呈刚毛状。叶对生；有短柄或几无柄；叶片长椭圆形成线状披针形，长2～10厘米，宽0.5～3厘米，先端窄或短渐尖，基部楔形，全缘，上面被疏柔毛，下面被短茸毛，，尤以脉上为多。顶生聚伞花序；花两性，淡紫红色或有时白色，无柄；花萼4齿裂；花冠筒状漏斗形，长2～3毫米，喉部密被长毛，先端4裂；雄蕊4，花丝线形，长约1毫米，花药长圆形，黄色；子房下位，2室，花柱细长，柱头2裂。果实卵形或椭圆形，有4～8棱。种子2枚，具有肥厚的珠柄。花期8～9月.果期10～11月。"}]},{"ID":"20240613094246-wjp3qim","Type":"NodeParagraph","Properties":{"id":"20240613094246-wjp3qim","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"生于低山坡草丛中的半阳地。分布福建，广东、广西、贵州、云南、西藏等地。"}]},{"ID":"20240613094246-g9yjdkx","Type":"NodeParagraph","Properties":{"id":"20240613094246-g9yjdkx","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613094246-k275lzk","Type":"NodeParagraph","Properties":{"id":"20240613094246-k275lzk","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" ①京大戟"}]},{"ID":"20240613094246-jtcn46e","Type":"NodeParagraph","Properties":{"id":"20240613094246-jtcn46e","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"为植物大戟的干燥根。呈圆柱形或圆锥形，长16～20厘米，直径可达4厘米，表面灰棕色至深棕色，粗糙而具侧根，顶端多膨大，上有许多圆形的地上茎痕，向下渐细，有纵直沟纹及横生皮孔与支根痕。质坚硬，不易折断，折断面纤维性，类白色至灰棕色。气无，味苦涩。以根条均匀，肥嫩、质软无须者为佳。"}]},{"ID":"20240613094246-40gtvq2","Type":"NodeParagraph","Properties":{"id":"20240613094246-40gtvq2","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"主产江苏。此外，四川、江西、广西等地亦产。"}]},{"ID":"20240613094246-i4j1xgf","Type":"NodeParagraph","Properties":{"id":"20240613094246-i4j1xgf","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②红大戟"}]},{"ID":"20240613094246-4gfbarc","Type":"NodeParagraph","Properties":{"id":"20240613094246-4gfbarc","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"为植物红芽大戟的干燥根。又名：红毛大戟、红芽戟、南大戟。呈长圆锥形至纺锤形，多不分歧，偶有分歧者，长6～8～14厘米，直径O.6～1厘米。表面灰棕色至红棕色；多扭转的皱纹，有时可见横生皮孔及支根残基或支根痕；顶端有地上茎痕。质坚脆，易折断，断面不平坦，呈红褐色至棕黄色。气微，味辣刺喉。以条大，肥壮，色紫红、坚实无须根者为佳。"}]},{"ID":"20240613094246-jhgpvpi","Type":"NodeParagraph","Properties":{"id":"20240613094246-jhgpvpi","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"主产广西、广东、云南、贵州等地。"}]},{"ID":"20240613094246-0wqc494","Type":"NodeParagraph","Properties":{"id":"20240613094246-0wqc494","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"此外，大戟科植物准噶尔大戟的根，在新疆亦作大戟使用。"}]},{"ID":"20240613094246-ul6kycm","Type":"NodeParagraph","Properties":{"id":"20240613094246-ul6kycm","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613094246-vaj76qz","Type":"NodeParagraph","Properties":{"id":"20240613094246-vaj76qz","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 大戟：拣去杂质，用水洗净，润透，切段或切片，晒干。醋大戟：取大戟段或片，加醋浸拌，置锅内用文火煮至醋尽，再炒至微干，取出，晒干。（大戟100斤，用醋30～60斤）"}]},{"ID":"20240613094246-jxhjmso","Type":"NodeParagraph","Properties":{"id":"20240613094246-jxhjmso","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"采得大戟于槐砧上细锉，与海芋叶拌蒸，从巳至申，去芋叶，晒干用之。\""}]},{"ID":"20240613094246-p1lk1kj","Type":"NodeParagraph","Properties":{"id":"20240613094246-p1lk1kj","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"凡采得大戟以浆水煮软，去骨晒干用。海芋叶麻而有毒，恐不可用也。\""}]},{"ID":"20240613094246-mitipzu","Type":"NodeParagraph","Properties":{"id":"20240613094246-mitipzu","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"大戟用枣同煮软，去骨，晒干。\""}]},{"ID":"20240613094246-8kyx8oa","Type":"NodeParagraph","Properties":{"id":"20240613094246-8kyx8oa","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613094246-kdqb06u","Type":"NodeParagraph","Properties":{"id":"20240613094246-kdqb06u","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 入肺、脾、肾经。"}]},{"ID":"20240613094246-2en4s4m","Type":"NodeParagraph","Properties":{"id":"20240613094246-2en4s4m","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"入肾、肝。\""}]},{"ID":"20240613094246-ssbhaxj","Type":"NodeParagraph","Properties":{"id":"20240613094246-ssbhaxj","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"入肝、膀胱。\""}]},{"ID":"20240613094246-pptfpkn","Type":"NodeParagraph","Properties":{"id":"20240613094246-pptfpkn","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"入三阴，足太阳经。\""}]},{"ID":"20240613094246-9ntjyiu","Type":"NodeParagraph","Properties":{"id":"20240613094246-9ntjyiu","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613094246-gc8bxxk","Type":"NodeParagraph","Properties":{"id":"20240613094246-gc8bxxk","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒，有毒。"}]},{"ID":"20240613094246-8afteho","Type":"NodeParagraph","Properties":{"id":"20240613094246-8afteho","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240613094246-rf19y1w","Type":"NodeParagraph","Properties":{"id":"20240613094246-rf19y1w","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，大寒，有小毒。\""}]},{"ID":"20240613094246-yram0m3","Type":"NodeParagraph","Properties":{"id":"20240613094246-yram0m3","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦辛，有大毒。\""}]},{"ID":"20240613094246-1exvp1n","Type":"NodeParagraph","Properties":{"id":"20240613094246-1exvp1n","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613094246-9woljpl","Type":"NodeParagraph","Properties":{"id":"20240613094246-9woljpl","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 患虚寒阴水及孕妇忌服。体弱者慎用。"}]},{"ID":"20240613094246-sdh3hih","Type":"NodeParagraph","Properties":{"id":"20240613094246-sdh3hih","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"反甘草。\""}]},{"ID":"20240613094246-y7zfaqd","Type":"NodeParagraph","Properties":{"id":"20240613094246-y7zfaqd","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"反芫花、海藻。毒，用菖蒲解之。\""}]},{"ID":"20240613094246-y0hbrnb","Type":"NodeParagraph","Properties":{"id":"20240613094246-y0hbrnb","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"畏菖蒲、芦草、鼠屎。\""}]},{"ID":"20240613094246-mmyowbh","Type":"NodeParagraph","Properties":{"id":"20240613094246-mmyowbh","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"小豆为之使。恶薯蓣。\""}]},{"ID":"20240613094246-p5hea46","Type":"NodeParagraph","Properties":{"id":"20240613094246-p5hea46","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"得枣则不损脾。\""}]},{"ID":"20240613094246-yf36cpl","Type":"NodeParagraph","Properties":{"id":"20240613094246-yf36cpl","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑥《本经逢原》：\"脾胃肝肾虚寒，阴水泛滥，犯之立毙，不可不审。\""}]},{"ID":"20240613094246-7282oe0","Type":"NodeParagraph","Properties":{"id":"20240613094246-7282oe0","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613094246-nxz9i7c","Type":"NodeParagraph","Properties":{"id":"20240613094246-nxz9i7c","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 泻水沈，利二便。治水肿，水臌，痰饮，瘰疬，痈疽肿毒。"}]},{"ID":"20240613094246-s01s9lp","Type":"NodeParagraph","Properties":{"id":"20240613094246-s01s9lp","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主十二水，腹满急痛，积聚，中风皮肤疼厢，吐逆。\""}]},{"ID":"20240613094246-w6wmes4","Type":"NodeParagraph","Properties":{"id":"20240613094246-w6wmes4","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主颈腋痈肿，头痛，发汗，利大小肠。\""}]},{"ID":"20240613094246-wubdsz4","Type":"NodeParagraph","Properties":{"id":"20240613094246-wubdsz4","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"下恶血癖块，腹内雷鸣，通月水，善治瘀血，能堕胎孕。\""}]},{"ID":"20240613094246-cm6vfd6","Type":"NodeParagraph","Properties":{"id":"20240613094246-cm6vfd6","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"泻毒药，泄天行黄病、温疟，破症瘕。\""}]},{"ID":"20240613094246-baodq4g","Type":"NodeParagraph","Properties":{"id":"20240613094246-baodq4g","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑤《本草图经》：\"治隐疹风及风毒脚肿。\""}]},{"ID":"20240613094246-x62opeb","Type":"NodeParagraph","Properties":{"id":"20240613094246-x62opeb","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"泻肺。\""}]},{"ID":"20240613094246-j02t9rw","Type":"NodeParagraph","Properties":{"id":"20240613094246-j02t9rw","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑦《本草正》：\"性峻利，善逐水邪痰涎，泻湿热胀满。\""}]},{"ID":"20240613094246-d31uy4g","Type":"NodeParagraph","Properties":{"id":"20240613094246-d31uy4g","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑧《药征》：\"主利水，旁治掣痛，咳烦。\""}]},{"ID":"20240613094246-scmw22x","Type":"NodeParagraph","Properties":{"id":"20240613094246-scmw22x","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑨《现代实用中药》：\"用于壮实体质之腹水，全身水肿。胸肋膜积水等。\""}]},{"ID":"20240613094246-qg3lqa4","Type":"NodeParagraph","Properties":{"id":"20240613094246-qg3lqa4","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑩《浙江民间常用草药》：\"杀虫。\""}]},{"ID":"20240613094246-7zbv9hm","Type":"NodeParagraph","Properties":{"id":"20240613094246-7zbv9hm","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613094246-esb1szy","Type":"NodeParagraph","Properties":{"id":"20240613094246-esb1szy","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1钱；或入丸、散。外用；煎水熏洗。"}]},{"ID":"20240613094246-icayl3q","Type":"NodeParagraph","Properties":{"id":"20240613094246-icayl3q","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613094246-8e49gl7","Type":"NodeParagraph","Properties":{"id":"20240613094246-8e49gl7","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" ①治水肿：枣一斗，锅内入水，上有四指，用大戟并根苗盖之遍，盆合之，煮熟为度，去大戟不用，旋旋吃，无时。（《活法机要》）"}]},{"ID":"20240613094246-e6qen7y","Type":"NodeParagraph","Properties":{"id":"20240613094246-e6qen7y","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②治通身肿满喘息，小便涩：大戟（去皮，细切，微妙）二两，干姜（炮）半两。上二味捣罗为散，每服三钱匕，用生姜汤调下，良久，糯米饮投之，以大小便利为度。（《圣济总录》大戟散）"}]},{"ID":"20240613094246-f7jwxfj","Type":"NodeParagraph","Properties":{"id":"20240613094246-f7jwxfj","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"③治水气肿胀：大戟一两、广木香半两。为末，五更酒服一钱半，取下碧水，后以粥补之。忌咸物。（《纲目》）"}]},{"ID":"20240613094246-mwgd756","Type":"NodeParagraph","Properties":{"id":"20240613094246-mwgd756","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"④治太阳中风，下利呕逆，表解里未和。其人漐漐汗出，发作有时，头痛，心下痞粳满，引胁下痛，干呕，短气，汗出不恶寒：芫花（熬）、甘遂、大戟。上三味等分，各别捣为散，以水一升半，先煮大枣肥者十枚，取八合，去滓，纳药末，强人服一钱匕，羸人服半钱，温服之，平旦服。若下少病不除者，明日更服，加半钱，得快下利后，糜粥自养。（《伤寒论》十枣汤）"}]},{"ID":"20240613094246-3aekn0u","Type":"NodeParagraph","Properties":{"id":"20240613094246-3aekn0u","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑤治腹水胀满，二便不通：大戟三分，牵牛子一钱五分，红枣五个。水煎服。（《新疆中草药手册》）"}]},{"ID":"20240613094246-60h6u8e","Type":"NodeParagraph","Properties":{"id":"20240613094246-60h6u8e","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑥治忽患胸背、手脚、颈项、腰胯隐痛不可忍，连筋骨牵引钓痛，坐卧不宁，时时走易不定：甘遂（去心）、紫大戟（去皮）、白芥子（真者）各等分。上为末，煮糊丸如梧子大。食后临卧，淡姜汤或熟水下五、七丸至十丸，如痰猛气实，加丸数不妨。（《三因方》控涎丹）"}]},{"ID":"20240613094246-em6e1y7","Type":"NodeParagraph","Properties":{"id":"20240613094246-em6e1y7","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑦治黄疸小水不通：大戟一两，茵陈二两。水浸空心服。（《本草汇言》）"}]},{"ID":"20240613094246-72yplpr","Type":"NodeParagraph","Properties":{"id":"20240613094246-72yplpr","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑧治温疟寒热腹胀：大戟五钱，柴胡、姜制半夏三钱，广皮一钱，生姜三片。水二大碗，煎七分服。（《方脉正宗》）"}]},{"ID":"20240613094246-t1n63bg","Type":"NodeParagraph","Properties":{"id":"20240613094246-t1n63bg","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑨治晚期血吸虫病：京大戟鲜根洗净，晒干，研粉，每日服三分，于早饭后一小时用开水一次吞服，连续一至二次为一疗程，总剂量约四至五克。同时每日在肿大肝脾处用艾温灸三十分钟和内服丹参合剂（丹参五钱，马鞭草五钱）以助肝脾缩小。在治疗期间必须禁忌食盐。（《浙江民间常用草药》）"}]},{"ID":"20240613094246-jdttw5j","Type":"NodeParagraph","Properties":{"id":"20240613094246-jdttw5j","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑩治淋巴结结核：大戟二两，鸡蛋七个。将药和鸡蛋共放砂锅内，水煮三小时，将蛋取出，每早，去壳食鸡蛋一个。七天为一疗程。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240613094246-0ugqv7c","Type":"NodeParagraph","Properties":{"id":"20240613094246-0ugqv7c","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑾治扁桃体炎：红芽大戟五分至一钱，含服。（《中草药新医疗法处方集》）"}]},{"ID":"20240613094246-4v9g9wf","Type":"NodeParagraph","Properties":{"id":"20240613094246-4v9g9wf","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⑿治牙齿摇痛：大戟咬于痛处。（《生生编》）"}]},{"ID":"20240613094246-m985z6m","Type":"NodeParagraph","Properties":{"id":"20240613094246-m985z6m","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"⒀治颈项腋间痈疽：大戟三两（浸酒炒，晒干），当归、于白术各二两。共为末；生半夏（姜水炒）为末，打糊丸如梧桐子大。每服二钱，食后白汤下。（《本草汇言》）"}]},{"ID":"20240613094246-vahcf49","Type":"NodeParagraph","Properties":{"id":"20240613094246-vahcf49","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613094246-xb8ulsc","Type":"NodeParagraph","Properties":{"id":"20240613094246-xb8ulsc","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" ①治疗急慢性肾炎水肿"}]},{"ID":"20240613094246-5rs0mzy","Type":"NodeParagraph","Properties":{"id":"20240613094246-5rs0mzy","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"大戟根洗净，刮去粗皮，切片，每斤以食盐3钱，加水适量拌匀，吸入后晒干或烘干呈淡黄色，研成细末装入胶囊。日服2次，每次1.5～2分，隔日1次，空腹温开水送下，6～9次为一疗程。共观察60余例，均有显着的消肿作用，一般经治6～7天后水肿即完全消失。患者服药后有不同程度的恶心、呕吐、腹泻。其泻下作用常在服药后2～4小时最为剧烈；如症状严重，可进食水果或冷糖开水，反应即可减轻。服药期间用低盐饮食，禁食生冷、辛辣、鱼及猪头肉等发物.禁用于孕妇、心力衰竭、食道静脉曲张及体弱者。"}]},{"ID":"20240613094246-mouc7kw","Type":"NodeParagraph","Properties":{"id":"20240613094246-mouc7kw","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"②治疗晚期血吸虫病腹水或其他肝硬变腹水"}]},{"ID":"20240613094246-8e8rs3c","Type":"NodeParagraph","Properties":{"id":"20240613094246-8e8rs3c","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"大戟鲜根洗净晒干磨粉，用小火焙成咖啡色，装入胶囊，成人每次0.6～O.9克，隔日或隔2日服药1次，7～8次后停药1星期，以后视病情再服.若腹水巳退，可选用人参养荣丸等调理。曾试治20例，经服药5～36次不等，显效（腹水消失，健康改善，体力基本恢复）9例，好转（腹水显著减少，全身情况改善）9例，无效2例。治程中主要反应为腹泻、恶心、呕吐及腹痛等，经数小时后可自行消失；但亦有人观察到，一般服粉剂0.6克时药物反应都能耐受，如超过1.8克时，则反应增重，有恶寒、震颤、头昏、烦躁、口干，有时呈极度恐惧感。反应可持续2～6小时，如及时处理即可缓解。禁忌证同前。"}]},{"ID":"20240613094246-r8hv8ju","Type":"NodeParagraph","Properties":{"id":"20240613094246-r8hv8ju","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613094246-yh2l9iv","Type":"NodeParagraph","Properties":{"id":"20240613094246-yh2l9iv","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 历代《本草》所载大戟，品种亦不止一种，但大多数是大戟科大戟属植物。如《蜀本草》中所述的大戟，《本草图经》的\"滁州大戟\"、\"并州大戟\"以及《植物名实图考》中的\"大戟\"所述的形态都和大戟科大戟近似。此外，《本草图经》中的\"河中府大戟\"，似为豆科植物；《纲目》所称的\"北方绵大戟\"，似即今之绵大戟（参见\"狼毒\"条）；至于茜草科的红芽大戟，《本草》中未见收载，但为目前大戟药材中使用最广的一种。"}]},{"ID":"20240613094246-0po7678","Type":"NodeParagraph","Properties":{"id":"20240613094246-0po7678","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613094246-myfhw7n","Type":"NodeParagraph","Properties":{"id":"20240613094246-myfhw7n","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613094246-0wao45o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094246-0wao45o","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"《中华本草》：大戟"}]},{"ID":"20240613094246-1pxehc6","Type":"NodeParagraph","Properties":{"id":"20240613094246-1pxehc6","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613094246-rby326b","Type":"NodeParagraph","Properties":{"id":"20240613094246-rby326b","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" Dà Jǐ"}]},{"ID":"20240613094246-rwgxqy0","Type":"NodeParagraph","Properties":{"id":"20240613094246-rwgxqy0","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613094246-uqwvfg3","Type":"NodeParagraph","Properties":{"id":"20240613094246-uqwvfg3","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 邛巨、红芽大戟、紫大戟、下马仙、京大戟。"}]},{"ID":"20240613094246-u6hy70d","Type":"NodeParagraph","Properties":{"id":"20240613094246-u6hy70d","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613094246-pkizetw","Type":"NodeParagraph","Properties":{"id":"20240613094246-pkizetw","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" Knoxia Root, Peking Euphorbia Root"}]},{"ID":"20240613094246-qmhdqz0","Type":"NodeParagraph","Properties":{"id":"20240613094246-qmhdqz0","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613094246-iyf2c4g","Type":"NodeParagraph","Properties":{"id":"20240613094246-iyf2c4g","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613094246-8hug1tv","Type":"NodeParagraph","Properties":{"id":"20240613094246-8hug1tv","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613094246-ncvb6wb","Type":"NodeParagraph","Properties":{"id":"20240613094246-ncvb6wb","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 药材基源：为大戟科植物大戟的根。"}]},{"ID":"20240613094246-c3spxjy","Type":"NodeParagraph","Properties":{"id":"20240613094246-c3spxjy","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Euphorbia pekinensis Rupr."}]},{"ID":"20240613094246-089kd1b","Type":"NodeParagraph","Properties":{"id":"20240613094246-089kd1b","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季地上部分枯萎后至早春萌芽前，挖掘地或切片晒干或烘干。"}]},{"ID":"20240613094246-kvsuvgo","Type":"NodeParagraph","Properties":{"id":"20240613094246-kvsuvgo","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613094246-8n6ivwr","Type":"NodeParagraph","Properties":{"id":"20240613094246-8n6ivwr","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山坡、路旁、荒地、草丛、林缘及疏林下。"}]},{"ID":"20240613094246-z5wmxf1","Type":"NodeParagraph","Properties":{"id":"20240613094246-z5wmxf1","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国除新疆、广东、海南、广西、云南、西藏外各地。"}]},{"ID":"20240613094246-01wt984","Type":"NodeParagraph","Properties":{"id":"20240613094246-01wt984","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613094246-59yc2ox","Type":"NodeParagraph","Properties":{"id":"20240613094246-59yc2ox","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 大戟 多年生草本，高30-90cm。全株含白色乳汁。根粗壮，圆锥形，有侧根。茎自上部分枝，表面被白色短柔毛。单叶互生；几无柄；叶片狭长圆状披针形，长3-8cm，宽6-12mm，先端钝或尖，基部渐狭，全缘，具明显中脉，上面无毛，下面在中脉上有毛。杯状聚伞花序顶生或腋生，顶生者通常5枝，排列成复伞形；基都有叶状苞片5；每枝再作2至数回分枝，分技处着生近圆形的苞叶4或2，对生；腋生者伞梗单生；苞叶卵状长圆形，先端尖；杯状聚伞花序的总苞钟形或陀螺形，4-5裂，腺体4-5，长圆形，肉质肥厚，内面基部有毛，两腺体之间有膜质长圆形附属物；雌雄花均无花被；雄花多数，花丝基部较花梗稍粗壮，两者之间有关节，花药球形，横裂；雌花1；花柱先端2裂。蒴果三棱状球形，密被刺疣。种子卵形，光滑。花期6-9月，果期7-10月。"}]},{"ID":"20240613094246-u0620ex","Type":"NodeParagraph","Properties":{"id":"20240613094246-u0620ex","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613094246-kg3nl5r","Type":"NodeParagraph","Properties":{"id":"20240613094246-kg3nl5r","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，耐旱、耐寒喜潮湿。对土壤要求不严，以土层深厚、疏松肥沃、排水良好的砂质壤上或粘质壤上栽培为好。"}]},{"ID":"20240613094246-ks7jhfp","Type":"NodeParagraph","Properties":{"id":"20240613094246-ks7jhfp","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、分根繁殖，育苗移栽法。种子繁殖：4月上旬育苗，撒播或条播，将种子均匀播下，覆薄细土，稍加镇压，浇水，保持床土湿润。约经2-3星期出苗。苗高12-15cm时移移。选阴天，将订地浇透水，挖幼苗，按行株距30cm×25cm开穴，穴深12cm，每穴栽种1株，覆土压实，浇水。1hm2用种量7.5kg。分根繁殖：秋季桔叶后或早春萌芽前，挖掘根部，进行分根，每根带有2-3个芽，按行株距30cm×25cm开穴栽种。"}]},{"ID":"20240613094246-mophral","Type":"NodeParagraph","Properties":{"id":"20240613094246-mophral","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"田间管理 幼苗定植后，如有缺株，应及时补栽，并施1次稀人粪尿。现蕾时要及时摘蕾，再施1次粪肥或饼肥。每隔半月需松土除草。"}]},{"ID":"20240613094246-dkjnnho","Type":"NodeParagraph","Properties":{"id":"20240613094246-dkjnnho","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613094246-oea1n8d","Type":"NodeParagraph","Properties":{"id":"20240613094246-oea1n8d","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根呈不规则长圆锥形，略弯曲，常有分枝，长10-20cm，直径0.5-2cm，近根头部偶有膨大至4cm；根头常见茎的残基及芽痕。表面灰棕色或棕褐色，粗糙，具纵直沟纹及横向皮孔，支根少而扭曲。质坚硬，不易折断，断面类棕黄色或类白色，纤维性。气微，味微苦、涩。以条粗、断面色白者为佳。"}]},{"ID":"20240613094246-s3y7oze","Type":"NodeParagraph","Properties":{"id":"20240613094246-s3y7oze","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613094246-0goms13","Type":"NodeParagraph","Properties":{"id":"20240613094246-0goms13","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 取京大戟2000g，均分为4份，每份加醋50、150、250、350ml拌匀、浸透，炒至醋液吸尽，再取出晾干，即分别得10%、30%、50%、70%的醋制京大戟。上述4种醋制京大戟及未炮制的生品京大戟，分别取相同量，每种浸以10倍体积水，浸透后煎2次，每次15min，滤取滤液，浓缩至每1ml含原生药8g。"}]},{"ID":"20240613094246-gwo8rqu","Type":"NodeParagraph","Properties":{"id":"20240613094246-gwo8rqu","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613094246-xlk98sc","Type":"NodeParagraph","Properties":{"id":"20240613094246-xlk98sc","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 根含三萜类成分大戟酮（euphorbon），生物碱，大戟色素体（euphorbia）A、B、C等。另含树胶、树脂。新鲜叶含维生素C 110mg%-112mg%。"}]},{"ID":"20240613094246-dtmcz52","Type":"NodeParagraph","Properties":{"id":"20240613094246-dtmcz52","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613094246-tz03dmu","Type":"NodeParagraph","Properties":{"id":"20240613094246-tz03dmu","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 1.致泻：对离体回肠的作用 各种京大戟生、制品煎剂对离体回肠均有兴奋作用，肠蠕动增加，肠平滑肌张力提高。并随着炮制醋液浓度的提高，收缩强度似有加强趋势，其中50%、70%浓度兴奋作用特别明显。本品能刺激肠管，引起肠蠕动增加，产生泻下作用。京大戟根乙醚抽出物有致泻作用，热水抽出物对猫有剧泻作用。"}]},{"ID":"20240613094246-7l82oxi","Type":"NodeParagraph","Properties":{"id":"20240613094246-7l82oxi","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"2.对平滑肌作用：提取物能扩张末稍血管，兴奋妊娠离体子宫。"}]},{"ID":"20240613094246-x04k5q2","Type":"NodeParagraph","Properties":{"id":"20240613094246-x04k5q2","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"3.抗菌作用 东北的大戟（Euphorbiasp.）鲜叶汁在试管内对金黄色葡萄球菌及绿脓杆菌有抑制作用，但除去鞣质后，抗菌作用即消失,制剂保存数天或加热亦可使抗菌作用减少甚至丧失。实验表明,本品对金黄色葡萄球菌及绿脓杆菌均有抑制作用。"}]},{"ID":"20240613094246-afrvna1","Type":"NodeParagraph","Properties":{"id":"20240613094246-afrvna1","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"4.利尿作用 以生红大戟水煎浓缩液（80g/kg），喂饲小白鼠，2-3小时后，其尿量明显增加。"}]},{"ID":"20240613094246-25k97s0","Type":"NodeParagraph","Properties":{"id":"20240613094246-25k97s0","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"5.大戟与甘草合并用药的影响：据我国历代本草书籍之记载，大戟与甘草配伍是禁忌的，属十八反之列。动物试验证明，小鼠腹腔注射大戟、甘草混合后的乙醇浸出液，其半数致死量要比单独应用大戟时小数倍，可见两者配伍时大戟的毒性增加了，而且配伍的甘草愈多，毒性也愈大。如将大戟与甘草分别酒浸，而在给药时方混合投予者，其毒性比共浸者为小，但仍比单用大戟时毒性大。小鼠口服大戟及甘草的煎剂亦获得相似的结果。大戟、甘草均用50%乙醇浸剂给小鼠腹腔注射，甘草的LD50为12.4±0.7g/kg,大戟为30.0±5.5g/kg,大戟加甘草合用毒性增加。大戟煎剂腹腔注射对小鼠的LD50为4.69±0.021g/kg,大戟加甘草(1:1)腹腔注射LD50为5.02±0.025g/kg,毒性未见增加。"}]},{"ID":"20240613094246-mprl4lu","Type":"NodeParagraph","Properties":{"id":"20240613094246-mprl4lu","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"大鼠腹腔注射氯化钠溶液造成实验性腹水，口服大戟煎剂或酒精浸液，都有利尿作用，如与甘草合用，其利尿和泻下作用受到明显抑制，甘草的用量比例愈大，其相反作用也愈强。因此，从治疗腹水的角度来看，两者合用是不适宜的。另有报道，用小鼠死亡作指标，认为大戟（品种未鉴定）与甘草煎剂并无相反作用。但所用剂量大小，试验鼠全部未死，还需进一步试验。"}]},{"ID":"20240613094246-sfyyhf9","Type":"NodeParagraph","Properties":{"id":"20240613094246-sfyyhf9","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"40%大戟煎剂0.5ml灌胃，无论大戟单用或与甘草合用，对小鼠泻下作用无明显差异。"}]},{"ID":"20240613094246-ynyb2io","Type":"NodeParagraph","Properties":{"id":"20240613094246-ynyb2io","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"离体小肠实验：0.01%-1%的甘草煎剂对兔离体小肠的影响是高浓度时呈现抑制作用，但随药液浓度之降低，抑制作用也渐减弱，并渐呈现略兴奋的作用；炙京大戟煎剂高浓度时收缩振幅变化不明显或略降，低浓度时渐升，张力均降低；合用后，与同剂量的单味煎剂比较，高浓度时，抑制作用多有加强，当浓度渐低时，差异不显着或略有抑制，且甘草之量大于京大戟时，尤为显着。"}]},{"ID":"20240613094246-jfsvrtq","Type":"NodeParagraph","Properties":{"id":"20240613094246-jfsvrtq","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"镇痛作用 采用YSD一4药理生理实验多用仪，电刺激箱进行测记。小鼠ig甘草或京大戟煎剂后，有一定镇痛作用，且量越大越显着，而京大戟又优于甘草。合用后，与同剂量之单味煎剂比较，当二药等量时，镇痛作用次于单味煎剂；当甘草的量大于京大戟时，镇痛作用优于单味煎剂，并与用量有关，小剂量优于大剂量。"}]},{"ID":"20240613094246-k0246m4","Type":"NodeParagraph","Properties":{"id":"20240613094246-k0246m4","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"对离体蛙心作用 离体蛙心实验：按斯氏Strdub离体蛙心灌流法制备离体蛙心，每组5个蛙心，共分20组进行实验，取平均值作曲线并比较，0.31-5%的甘草及炙京大戟煎剂对离体蛙心的影响是高浓度时呈现明显的抑制作用，低浓度时，作用较弱或不明显；合用后，与同剂量的单味组比较，抑制作用多有不同程度的增强，且浓度越高越显着，而0.63%的不明显。"}]},{"ID":"20240613094246-lfuvzmt","Type":"NodeParagraph","Properties":{"id":"20240613094246-lfuvzmt","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"6.其他作用 根皮70%乙醇提取液注射于动物，血压轻微上升，肾容积显着缩小，无论剂量大小，利尿作用均不显着。健康成人服煎剂亦无明显利尿作用。提取物对末梢血管有扩张作用，能抑制肾上腺素的升压作用。同属植物京大戟日本变种EuphorbiapekinensisRupr.var.JaponensisMak.水浸液对家兔、豚鼠的离体及在位子宫呈收缩作用。黑海大戟EuphorbiaponticaProkh水浸剂、酊剂及用植物细粉做成的油膏，对于皮肤都有明显刺激，长期应用可引起发红、烧的感、小泡乃至脱皮。面部皮肤更加敏感。浸剂刺激性较弱。新加仑制剂注射于蛙或猫可使心跳停止于收缩期。可能含有强心甙。"}]},{"ID":"20240613094246-t5m6jho","Type":"NodeParagraph","Properties":{"id":"20240613094246-t5m6jho","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"中国药材学："}]},{"ID":"20240613094246-s3ovwdv","Type":"NodeParagraph","Properties":{"id":"20240613094246-s3ovwdv","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613094246-uhb4jym","Type":"NodeParagraph","Properties":{"id":"20240613094246-uhb4jym","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，用水洗净，润透，切段或切片，晒干。醋大戟：取大戟段或片，加醋浸拌，置锅内用文火煮至醋尽，再炒至微干，取出，晒干。（大戟100斤，用醋30-50斤）《雷公炮炙论》：采得大戟于槐砧上细锉，与海芋叶拌蒸，从已至申，去芋叶，晒干用之。《纲目》：凡采得大戟以浆水煮软，去骨晒干用，海芋叶麻而有毒，恐不可用也。《本草通玄》：大戟用枣同煮软，去骨，晒干。"}]},{"ID":"20240613094246-9imr6e6","Type":"NodeParagraph","Properties":{"id":"20240613094246-9imr6e6","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613094246-2gpmupq","Type":"NodeParagraph","Properties":{"id":"20240613094246-2gpmupq","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 将根切成薄片，加冰醋酸与浓硫酸各1滴，在扩大镜下观察，可见乳汁管中所含乳汁显红色。"}]},{"ID":"20240613094246-f5zvhyn","Type":"NodeParagraph","Properties":{"id":"20240613094246-f5zvhyn","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613094246-e4zr8cc","Type":"NodeParagraph","Properties":{"id":"20240613094246-e4zr8cc","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 肺；脾；肝；肾；膀胱经"}]},{"ID":"20240613094246-mshkzjs","Type":"NodeParagraph","Properties":{"id":"20240613094246-mshkzjs","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613094246-glurdi0","Type":"NodeParagraph","Properties":{"id":"20240613094246-glurdi0","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性寒；有毒"}]},{"ID":"20240613094246-xpeqyt4","Type":"NodeParagraph","Properties":{"id":"20240613094246-xpeqyt4","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613094246-qv79nw2","Type":"NodeParagraph","Properties":{"id":"20240613094246-qv79nw2","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 患虚寒阴水及孕妇忌服。体弱者慎用。"}]},{"ID":"20240613094246-q8hif02","Type":"NodeParagraph","Properties":{"id":"20240613094246-q8hif02","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613094246-re8mb21","Type":"NodeParagraph","Properties":{"id":"20240613094246-re8mb21","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 泻水逐饮；消肿散结。主水肿；胸腹积水；痰饮积聚；二便不利；痈肿；瘰疬"}]},{"ID":"20240613094246-azbgqys","Type":"NodeParagraph","Properties":{"id":"20240613094246-azbgqys","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613094246-hpes8yd","Type":"NodeParagraph","Properties":{"id":"20240613094246-hpes8yd","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5-3g；或入丸、散。外用：适量，研末或熬膏敷；或煎水熏洗。"}]},{"ID":"20240613094246-x21dma4","Type":"NodeParagraph","Properties":{"id":"20240613094246-x21dma4","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613094246-0df68c9","Type":"NodeParagraph","Properties":{"id":"20240613094246-0df68c9","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：大戟，其根辛苦，戟人咽喉，故名。杭州紫大戟为上，江南土大戟次之。北地绵大戟，色白，其根皮柔韧如绵，甚峻利，能伤人，弱者服之，或至吐血，不可不知。.....控涎丹，乃治痰之本。痰之本，水也，湿也，得气与火，则凝滞而为痰、为饮、为涎、为涕、为癖。大戟能泄脏腑之水湿，甘遂能行经隧之水湿，白芥子能散皮里膜外之痰气，惟善用者能收奇功也。"}]},{"ID":"20240613094246-2el6i3o","Type":"NodeParagraph","Properties":{"id":"20240613094246-2el6i3o","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：大戟，苦寒下泄，故能逐诸有余之水。苦辛甘寒，故散颈腋痈肿。又：大戟，阴寒善走而下泄，洁古谓其损真气，故凡水肿不由于受湿停水，而由于脾虚，土坚则水清，土虚则水泛滥，实脾则能制水，此必然之数也。今不补脾而复用疏泄追逐之药，是重虚其虚也，宜详辨而深戒之。惟留饮、伏饮停滞中焦及元气壮实人患水湿，乃可一暂施耳。"}]},{"ID":"20240613094246-cf2l89k","Type":"NodeParagraph","Properties":{"id":"20240613094246-cf2l89k","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：大戟，性禀阴毒，峻利首推，苦寒下走肾阴，辛散上泻肺气，兼横行经脉，故《本经》专治十二水，腹满急痛等证，皆浊阴填塞所致，然惟暴胀为宜，云中风者，是指风水肤胀而言，否则传写之误耳。"}]},{"ID":"20240613094246-rcwd4yr","Type":"NodeParagraph","Properties":{"id":"20240613094246-rcwd4yr","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"4.张寿颐：大戟，《本经》谓主十二水腹满急痛积聚。盖谓十二经之水湿积聚，以致外肿内满，而为急痛耳。然苟非体充邪实者、亦不可概投。'中风皮肤疼痛'六字，当作一句读，盖指风湿热之袭于肌腠者，则辛能疏散，而苦寒又专泄降，是以治之，非泛言外受之风寒，石顽谓指风水肤胀，亦颇有理。吐逆，是指水饮停于上焦，而不能下泄以致上逆者，此以辛苦泄破，通达下降，是以主之。《别录》主颈腋痈肿，皆痰饮凝络之症治。头痛，亦指饮邪凝聚，水气上凌者而言。发汗，则驱除水湿之溢于肤腠者耳。利大小便，固通泄攻破之专职矣。"}]},{"ID":"20240613094246-frhpvr7","Type":"NodeParagraph","Properties":{"id":"20240613094246-frhpvr7","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主十二水，腹满急痛，积聚，中风皮肤疼痛，吐逆。"}]},{"ID":"20240613094246-nbg3hfe","Type":"NodeParagraph","Properties":{"id":"20240613094246-nbg3hfe","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"6.《别录》：主颈腋痈肿，头痛，发汗，利大小肠。"}]},{"ID":"20240613094246-60a90cv","Type":"NodeParagraph","Properties":{"id":"20240613094246-60a90cv","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：下恶血癖块、腹内雷鸣，通月水，善治瘀血，能堕胎孕。"}]},{"ID":"20240613094246-aaxws7x","Type":"NodeParagraph","Properties":{"id":"20240613094246-aaxws7x","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：泻毒药，泄天行黄病、温疟，破症瘕。"}]},{"ID":"20240613094246-0kzw8zn","Type":"NodeParagraph","Properties":{"id":"20240613094246-0kzw8zn","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"9.《本草图经》：大戟，春生红芽，渐长作丛、高一尺以来；叶似初生杨柳，小团；三月、四月开黄紫花，团圆似杏花，又似芜荑；根似细苦参，皮黄黑，肉黄白色；秋冬采根，阴干。淮甸出者，茎圆，高三、四尺，花黄，叶至心亦如百合苗。江南生者，叶似芍药。......治隐疹风及风毒脚肿。"}]},{"ID":"20240613094246-bvv05u7","Type":"NodeParagraph","Properties":{"id":"20240613094246-bvv05u7","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"10.《医学启源》：泻肺。"}]},{"ID":"20240613094246-d6y7de9","Type":"NodeParagraph","Properties":{"id":"20240613094246-d6y7de9","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"11.《本草正》：性峻利，善逐水邪痰涎，泻湿热胀满。"}]},{"ID":"20240613094246-3wayoi5","Type":"NodeParagraph","Properties":{"id":"20240613094246-3wayoi5","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"12.《药证》主利水，旁治掣痛，咳烦。"}]},{"ID":"20240613094246-g2xzqwv","Type":"NodeParagraph","Properties":{"id":"20240613094246-g2xzqwv","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"13.《现代实用中药》：用于壮实体质之腹水、全身水肿、胸肋膜积水等。"}]},{"ID":"20240613094246-sc2t9u9","Type":"NodeParagraph","Properties":{"id":"20240613094246-sc2t9u9","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"14.《浙江民间常用草药》：杀虫。"}]},{"ID":"20240613094246-lcoiqvf","Type":"NodeParagraph","Properties":{"id":"20240613094246-lcoiqvf","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613094246-mjjz0na","Type":"NodeParagraph","Properties":{"id":"20240613094246-mjjz0na","updated":"20240613094246"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613094248-ig4jh6m","Type":"NodeThematicBreak","Properties":{"id":"20240613094248-ig4jh6m"}},{"ID":"20240613094249-fytt4m4","Type":"NodeParagraph","Properties":{"id":"20240613094249-fytt4m4"}}]}