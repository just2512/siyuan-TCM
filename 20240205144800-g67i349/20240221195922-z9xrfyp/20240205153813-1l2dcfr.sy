":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"火麻仁1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/火麻仁1-20240621134216-ia22ix4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 493px;\" parent-style=\"width: 503px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812161756-z6urrfp","Type":"NodeParagraph","Properties":{"id":"20240812161756-z6urrfp","updated":"20240812162339"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 691px;","style":"width: 681px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"火麻仁2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/火麻仁2-20240621134442-pgwz57q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 681px;\" parent-style=\"width: 691px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 393px;","style":"width: 383px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621134303-f91vn21.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 383px;\" parent-style=\"width: 393px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162358-ew3orbg","Type":"NodeParagraph","Properties":{"id":"20240812162358-ew3orbg","updated":"20240812162535"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"火麻仁4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/火麻仁4-20240621134758-is0exio.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 624px;","style":"width: 614px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大麻 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大麻 1-20240812162535-7yxny5l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 614px;\" parent-style=\"width: 624px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812140214-tueplfd","Type":"NodeParagraph","Properties":{"id":"20240812140214-tueplfd","updated":"20240812140214"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 642px;","style":"width: 632px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"火麻仁 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/火麻仁 2-20240812140214-2fjzqc1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 632px;\" parent-style=\"width: 642px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611104424-z14tsjo","Type":"NodeParagraph","Properties":{"id":"20240611104424-z14tsjo","updated":"20240812162640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：麻子仁，即大麻的种子，大麻也分很多种，据说印度大麻才有致幻成分；"}]},{"ID":"20240611104849-kiyutxc","Type":"NodeThematicBreak","Properties":{"id":"20240611104849-kiyutxc"}},{"ID":"20240611104850-md6ri2z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104850-md6ri2z","updated":"20240611104854"},"Children":[{"Type":"NodeText","Data":"大麻仁《要药分剂》"}]},{"ID":"20240611104850-1xdjvvv","Type":"NodeParagraph","Properties":{"id":"20240611104850-1xdjvvv","updated":"20240611104850"},"Children":[{"Type":"NodeText","Data":"俗作火麻仁。味甘。性平。无毒。得土气以生。畏牡蛎、白薇、茯苓。"}]},{"ID":"20240611104850-pjdxmfu","Type":"NodeParagraph","Properties":{"id":"20240611104850-pjdxmfu","updated":"20240611104850"},"Children":[{"Type":"NodeText","Data":"【主治】主补虚劳。润五脏。疏风气。治大肠风热结涩。利小便。疗热淋。通利大小便。"}]},{"ID":"20240611104850-q9z1ekr","Type":"NodeParagraph","Properties":{"id":"20240611104850-q9z1ekr","updated":"20240611104850"},"Children":[{"Type":"NodeText","Data":"（又木【归经】入脾胃大肠三经。为滑利之品。"}]},{"ID":"20240611104850-6nt8r3k","Type":"NodeParagraph","Properties":{"id":"20240611104850-6nt8r3k","updated":"20240611104850"},"Children":[{"Type":"NodeText","Data":"【前论】甄权曰。汗多胃热便难三者。皆燥而亡津液。汗出愈多。则津枯而大便愈燥。"}]},{"ID":"20240611104957-oajsg7f","Type":"NodeThematicBreak","Properties":{"id":"20240611104957-oajsg7f"}},{"ID":"20240611104958-73vmros","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104958-73vmros","updated":"20240611105002"},"Children":[{"Type":"NodeText","Data":"火麻仁《本草害利》"}]},{"ID":"20240611104958-l57quxj","Type":"NodeParagraph","Properties":{"id":"20240611104958-l57quxj","updated":"20240611104958"},"Children":[{"Type":"NodeText","Data":"〔害〕多食损血脉，滑精气，痿阳事。妇人多食，即发带疾，以其滑利下行，走而不守也。"}]},{"ID":"20240611104958-zdjk3q0","Type":"NodeParagraph","Properties":{"id":"20240611104958-zdjk3q0","updated":"20240611104958"},"Children":[{"Type":"NodeText","Data":"肠滑者尤忌。"}]},{"ID":"20240611104958-7z961wo","Type":"NodeParagraph","Properties":{"id":"20240611104958-7z961wo","updated":"20240611104958"},"Children":[{"Type":"NodeText","Data":"〔利〕甘平，入脾胃，润五脏，通大肠，滑利下行，走而不守，宣风利关节，催生疗难产。"}]},{"ID":"20240611104958-cr1yvvf","Type":"NodeParagraph","Properties":{"id":"20240611104958-cr1yvvf","updated":"20240611104958"},"Children":[{"Type":"NodeText","Data":"〔修治〕七月七日采，良。九月采入土者损人，极难去壳。裹沸汤中待冷，悬井中一夜，晒干就新瓦上，去壳用。"}]},{"ID":"20240611104958-xxz0vy7","Type":"NodeParagraph","Properties":{"id":"20240611104958-xxz0vy7","updated":"20240611104958"},"Children":[{"Type":"NodeText","Data":"麻仁一物，询之药肆所备，每每误用，须分别书之。润燥通肠闭，催生，则用火麻仁，即大麻仁。如滋阴养肝，则用黑芝麻。又一种四方棱而小者，名巨胜子，味苦，平肝明目。又一种大胡麻，名胡麻仁，一名壁虱胡麻，一名亚麻，能祛风湿、疮癣、疥癞。又小胡麻，一名三角胡麻，即茺蔚子，一名益母子，通经活血，平肝祛风。用者宜审。"}]},{"ID":"20240611105008-mlpjuzl","Type":"NodeThematicBreak","Properties":{"id":"20240611105008-mlpjuzl"}},{"ID":"20240611105010-54pua7x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611105010-54pua7x","updated":"20240611105014"},"Children":[{"Type":"NodeText","Data":"火麻仁《本草求真》"}]},{"ID":"20240611105010-9c063lm","Type":"NodeParagraph","Properties":{"id":"20240611105010-9c063lm","updated":"20240611105010"},"Children":[{"Type":"NodeText","Data":"（麻麦稻）润燥滑肠"}]},{"ID":"20240611105010-62au5pr","Type":"NodeParagraph","Properties":{"id":"20240611105010-62au5pr","updated":"20240611105010"},"Children":[{"Type":"NodeText","Data":"火麻仁（专入脾胃大肠）。即今作布火麻之麻所产之子也。与胡麻之麻绝不相似。味甘性平。按书皆载缓脾利肠润燥。如伤寒阳明胃热。汗多便闭。治多用此。盖以胃府燥结。非此不解。（汪昂曰。胃热汗多便难。三者皆燥也。汗出愈多。则津枯而大便愈燥。仲景治脾约有麻仁丸。成无己曰。脾欲缓。急食甘以缓之。麻仁之甘以缓脾润燥。张子和曰。诸燥皆三阳病。）更能止渴通乳。及妇人难产。老人血虚。产后便秘最宜。（弘景曰。麻子中仁合丸药。并酿酒大善。但性滑利。许学士云。产后汗多则大便秘。难于用药。惟麻子粥最稳。不惟产后可服。凡老人诸虚风秘。皆得力也。）至云初服作泻。其说固是。久服能令肥健。有补中益气之功。亦是燥除血补而气自益之意。若云宽能益气。则又滋人岐惑矣！但性生走熟守。（生用破血利小便。捣汁治产难胎衣不下。熟用治崩中不止。）入药微炒研用。入丸汤泡去壳。取帛包煮。沸汤中浸。至冷出之。垂井中一夜。勿着水。次日日中曝干。 出壳。簸扬取仁。畏茯苓白薇牡蛎。"}]},{"ID":"20240611104944-2tzp3sp","Type":"NodeThematicBreak","Properties":{"id":"20240611104944-2tzp3sp"}},{"ID":"20240611104946-utn0ejo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104946-utn0ejo","updated":"20240611104951"},"Children":[{"Type":"NodeText","Data":"火麻仁《中药学》"}]},{"ID":"20240611104946-oroitua","Type":"NodeParagraph","Properties":{"id":"20240611104946-oroitua","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【药用】本品为大麻科植物大麻的果实。"}]},{"ID":"20240611104946-d4iynw2","Type":"NodeParagraph","Properties":{"id":"20240611104946-d4iynw2","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，平。入脾、胃、大肠经。"}]},{"ID":"20240611104946-42ryb46","Type":"NodeParagraph","Properties":{"id":"20240611104946-42ryb46","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【功效】润肠通便。"}]},{"ID":"20240611104946-mv0ujyo","Type":"NodeParagraph","Properties":{"id":"20240611104946-mv0ujyo","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于肠燥便秘、老人及产后便秘。"}]},{"ID":"20240611104946-4evxr9u","Type":"NodeParagraph","Properties":{"id":"20240611104946-4evxr9u","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"火麻仁体润多汁，为甘性平，功能润燥滑肠，兼有滋养补虚作用，临床上常用于体质较为虚弱、津血枯少的肠燥便秘，可配合柏子仁、瓜蒌仁、郁李仁、等同用。"}]},{"ID":"20240611104946-fhlv2e8","Type":"NodeParagraph","Properties":{"id":"20240611104946-fhlv2e8","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【处方用名】大麻仁、火麻仁（打碎用）"}]},{"ID":"20240611104946-ag3xtg9","Type":"NodeParagraph","Properties":{"id":"20240611104946-ag3xtg9","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240611104946-hayerqv","Type":"NodeParagraph","Properties":{"id":"20240611104946-hayerqv","updated":"20240611104946"},"Children":[{"Type":"NodeText","Data":"【方剂举例】麻子仁丸《伤寒论》：大麻仁、大黄、枳实、芍药、杏仁、厚朴。治肠胃燥热，大便秘结。"}]},{"ID":"20240611104931-4qno4x5","Type":"NodeThematicBreak","Properties":{"id":"20240611104931-4qno4x5","updated":"20240611104931"}},{"ID":"20240611104931-m49qrtp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104931-m49qrtp","updated":"20240611104931"},"Children":[{"Type":"NodeText","Data":"大麻仁《本草思辨录》"}]},{"ID":"20240611104931-hy9brlw","Type":"NodeParagraph","Properties":{"id":"20240611104931-hy9brlw","updated":"20240611104931"},"Children":[{"Type":"NodeText","Data":"仲圣麻仁丸证，是脾受胃强之累而约而不舒，于是脾不散精于肺，肺之降令亦失，肺与脾胃俱困而便何能下。麻仁甘平滑利，柔中有刚，能入脾滋其阴津，化其燥气。但脾至于约，其中之坚结可知。麻仁能扩之不能破之，芍药乃脾家破血中之气药，合施之而脾其庶几不约矣乎。夫脾约由于胃强，治脾焉得不兼治胃，胃不独降，有资于肺，肺亦焉得罔顾，故又佐以大黄枳朴攻胃，杏仁抑肺。病由胃生而以脾约标名者，以此为太阳阳明非正阳阳明也。兼太阳故小便数，小便数故大便难。治法以起脾阴化燥气为主，燥气除而太阳不治自愈，故麻仁为要药。治阳明府病非承气不可，故取小承气之大黄枳朴而复减少其数也。"}]},{"ID":"20240611104931-8bt31en","Type":"NodeParagraph","Properties":{"id":"20240611104931-8bt31en","updated":"20240611104931"},"Children":[{"Type":"NodeText","Data":"复脉汤用之，则佐姜桂以通阳，佐胶地麦冬以益阴，与后世取汁煮粥以治风治淋，总取乎润燥抉壅，柔中有刚也。"}]},{"ID":"20240611104806-wyryxq5","Type":"NodeThematicBreak","Properties":{"id":"20240611104806-wyryxq5"}},{"ID":"20240611104827-10u1w9z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104827-10u1w9z","updated":"20240611104832"},"Children":[{"Type":"NodeText","Data":"大麻仁《本草崇原》"}]},{"ID":"20240611104827-lu6hfnc","Type":"NodeParagraph","Properties":{"id":"20240611104827-lu6hfnc","updated":"20240611104827"},"Children":[{"Type":"NodeText","Data":"气味甘平，无毒。主补中、益气。久服肥健，不老神仙。"}]},{"ID":"20240611104827-kzq1em4","Type":"NodeParagraph","Properties":{"id":"20240611104827-kzq1em4","updated":"20240611104827"},"Children":[{"Type":"NodeText","Data":"（大麻即火麻，俗名黄麻。始出泰山川谷，今处处种之，其利颇饶。叶狭茎长，五六月开细黄花成穗，随结子可取油。《齐民要术》曰∶麻有雌雄，于放花时拔出雄者，若未花先拔，则不结子。）"}]},{"ID":"20240611104827-lcddpyg","Type":"NodeParagraph","Properties":{"id":"20240611104827-lcddpyg","updated":"20240611104827"},"Children":[{"Type":"NodeText","Data":"大麻放花结实于五六月之交，乃阳明太阴主气之时。《经》云∶阳明者，午也。五月盛阳之阴也。又，长夏属太阴主气，夫太阴、阳明，雌雄相合，麻仁禀太阴、阳明之气，故气味甘平。主补中者，补中土也。益气者，益脾胃之气也。夫脾胃气和则两土相为资益，阳明燥土得太阴湿气以相资，太阴湿土得阳明燥气以相益，故久服肥健，不老神仙。"}]},{"ID":"20240611104806-0bk5pc9","Type":"NodeThematicBreak","Properties":{"id":"20240611104806-0bk5pc9"}},{"ID":"20240611104817-m8pu0di","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104817-m8pu0di","updated":"20240611104821"},"Children":[{"Type":"NodeText","Data":"大麻仁《本草备要》"}]},{"ID":"20240611104817-9h6mzeo","Type":"NodeParagraph","Properties":{"id":"20240611104817-9h6mzeo","updated":"20240611104817"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大麻，即作布之麻，俗作火麻"}]},{"ID":"20240611104817-cz198zq","Type":"NodeParagraph","Properties":{"id":"20240611104817-cz198zq","updated":"20240611104817"},"Children":[{"Type":"NodeText","Data":"润燥滑肠"}]},{"ID":"20240611104817-zloifs3","Type":"NodeParagraph","Properties":{"id":"20240611104817-zloifs3","updated":"20240611104817"},"Children":[{"Type":"NodeText","Data":"甘平滑利。脾、胃、大肠之药，缓脾润燥。治阳明病、胃热汗多而便难（三者皆燥也，汗出愈多，则津枯而大便愈燥。张仲景治脾约有麻仁丸。成无己曰∶脾欲缓，急食甘以缓之，麻仁之甘，以缓脾润燥。张子和曰∶诸燥皆三阳病），破积血，利小便，通乳催生。又木谷也，亦能治风。极难去壳，帛裹置沸汤，待冷，悬井中一夜，晒干，就新瓦上 去壳，捣用。畏茯芩、白薇、牡蛎。"}]},{"ID":"20240611104806-t7ikssv","Type":"NodeThematicBreak","Properties":{"id":"20240611104806-t7ikssv"}},{"ID":"20240611104807-9zkudh4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104807-9zkudh4","updated":"20240611104811"},"Children":[{"Type":"NodeText","Data":"大麻仁《得配本草》"}]},{"ID":"20240611104807-babhyje","Type":"NodeParagraph","Properties":{"id":"20240611104807-babhyje","updated":"20240611104807"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名火麻"}]},{"ID":"20240611104807-a70ou8x","Type":"NodeParagraph","Properties":{"id":"20240611104807-a70ou8x","updated":"20240611104807"},"Children":[{"Type":"NodeText","Data":"畏茯苓、牡蛎、白薇。"}]},{"ID":"20240611104807-pfk4hoo","Type":"NodeParagraph","Properties":{"id":"20240611104807-pfk4hoo","updated":"20240611104807"},"Children":[{"Type":"NodeText","Data":"甘，平。滑利。入足太阴，兼手阳明经血分。理女子经脉，治汗多胃燥，除里结后重，去皮肤顽痹，能催生下乳。合苏子研汁煮粥，治虚风便秘。同紫菀、杏仁煎服，治大便不利。（肺气润，便自利。）以葱、椒、盐豉入麻仁粥食之，治风水腹大，腰脐重痛。"}]},{"ID":"20240611104807-flw47i2","Type":"NodeParagraph","Properties":{"id":"20240611104807-flw47i2","updated":"20240611104807"},"Children":[{"Type":"NodeText","Data":"去壳研用。多食滑精痿阳发带疾。"}]},{"ID":"20240611104807-zksb6ti","Type":"NodeParagraph","Properties":{"id":"20240611104807-zksb6ti","updated":"20240611104807"},"Children":[{"Type":"NodeText","Data":"怪症∶肠头出寸许，痛苦非常，干则自落，又出又落，名截肠。宜于初起麻油浸之，食大麻仁汁数升而愈。"}]},{"ID":"20240611104728-k1ukfs4","Type":"NodeThematicBreak","Properties":{"id":"20240611104728-k1ukfs4"}},{"ID":"20240611104753-y28u7bp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104753-y28u7bp","updated":"20240611104759"},"Children":[{"Type":"NodeText","Data":"麻子仁《本经逢原》"}]},{"ID":"20240611104753-vg4h7mo","Type":"NodeParagraph","Properties":{"id":"20240611104753-vg4h7mo","updated":"20240611104753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即麻子蒉"}]},{"ID":"20240611104753-o4l5ocd","Type":"NodeParagraph","Properties":{"id":"20240611104753-o4l5ocd","updated":"20240611104753"},"Children":[{"Type":"NodeText","Data":"甘平，无毒。入药微炒研用，入丸汤泡去壳，取帛包煮沸汤中浸至冷出之，垂井中一夜，勿着水，次日日中曝干， 去壳，簸扬取仁。"}]},{"ID":"20240611104753-q9ilv2y","Type":"NodeParagraph","Properties":{"id":"20240611104753-q9ilv2y","updated":"20240611104753"},"Children":[{"Type":"NodeText","Data":"《本经》实名麻仁，补中益气，久服肥健不老神仙。花名麻勃，治一百二十种恶风，黑色，遍身苦痒，逐诸风恶血，女人经候不通。"}]},{"ID":"20240611104753-8jjf6fa","Type":"NodeParagraph","Properties":{"id":"20240611104753-8jjf6fa","updated":"20240611104753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"麻仁入手阳明、足太阴，其性滋润。初服能令作泻，若久服之能令肥健，有补中益气之功。脏腑结燥者宜之。仲景治阳明病汗多胃热便难，脾约丸用之，取润脾土枯燥也。"}]},{"ID":"20240611104753-qitbxv3","Type":"NodeParagraph","Properties":{"id":"20240611104753-qitbxv3","updated":"20240611104753"},"Children":[{"Type":"NodeText","Data":"《日华》止消渴，通乳汁，主催生难产，及老人血虚，产后便秘宜之。麻勃治身中伏风，同优钵罗花为麻药，砭痈肿不知痛。叶绞汁，服五合下蛔虫，捣烂敷蝎毒俱效。黄麻破血利小便。麻根捣汁治产难衣胞不下，煮服治崩中不止，生走而熟守也，并治热淋下血不止。根叶并治挝打瘀血，心腹满痛，捣汁服之皆效。陈黄麻烧灰，酒服方寸匕，散内伤瘀血。"}]},{"ID":"20240611104728-khd372u","Type":"NodeThematicBreak","Properties":{"id":"20240611104728-khd372u"}},{"ID":"20240611104730-chs04jv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104730-chs04jv","updated":"20240611104734"},"Children":[{"Type":"NodeText","Data":"麻仁《本草分经》"}]},{"ID":"20240611104730-hvkk14y","Type":"NodeParagraph","Properties":{"id":"20240611104730-hvkk14y","updated":"20240611104730"},"Children":[{"Type":"NodeText","Data":"甘平滑利，缓脾润燥滑肠，治胃热便难，去壳用。"}]},{"ID":"20240611104549-dikkjw3","Type":"NodeThematicBreak","Properties":{"id":"20240611104549-dikkjw3"}},{"ID":"20240611104616-8hcknsr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104616-8hcknsr","updated":"20240611104621"},"Children":[{"Type":"NodeText","Data":"麻仁《汤液本草》"}]},{"ID":"20240611104616-ujtw7r8","Type":"NodeParagraph","Properties":{"id":"20240611104616-ujtw7r8","updated":"20240611104616"},"Children":[{"Type":"NodeText","Data":"味甘、平。无毒。"}]},{"ID":"20240611104616-us00ek6","Type":"NodeParagraph","Properties":{"id":"20240611104616-us00ek6","updated":"20240611104616"},"Children":[{"Type":"NodeText","Data":"入足太阴经，手阳明经。"}]},{"ID":"20240611104616-a8jpgeu","Type":"NodeParagraph","Properties":{"id":"20240611104616-a8jpgeu","updated":"20240611104616"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主补中益气，中风汗出，逐水，利小便，破积血，复血脉，乳妇产后余疾。长发，可为沐药。久服肥健不老。"}]},{"ID":"20240611104616-yb30blk","Type":"NodeParagraph","Properties":{"id":"20240611104616-yb30blk","updated":"20240611104616"},"Children":[{"Type":"NodeText","Data":"《液》云∶入足太阴、手阳明。汗多、冒热、便难，三者皆燥湿而亡津液，故曰脾约。"}]},{"ID":"20240611104616-967sboj","Type":"NodeParagraph","Properties":{"id":"20240611104616-967sboj","updated":"20240611104616"},"Children":[{"Type":"NodeText","Data":"约者，约束之义，《内经》谓∶燥者润之，故仲景以麻仁润足太阴之燥及通肠也。"}]},{"ID":"20240611104550-52rd5vu","Type":"NodeThematicBreak","Properties":{"id":"20240611104550-52rd5vu"}},{"ID":"20240611104551-zw1o4lj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104551-zw1o4lj","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"《中国药典》：火麻仁"}]},{"ID":"20240611104551-v71orx6","Type":"NodeParagraph","Properties":{"id":"20240611104551-v71orx6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611104551-ik6506q","Type":"NodeParagraph","Properties":{"id":"20240611104551-ik6506q","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" Huǒ Má Rén"}]},{"ID":"20240611104551-qzwm97b","Type":"NodeParagraph","Properties":{"id":"20240611104551-qzwm97b","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611104551-vcwdjjw","Type":"NodeParagraph","Properties":{"id":"20240611104551-vcwdjjw","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 大麻仁、火麻、线麻子"}]},{"ID":"20240611104551-nmji76d","Type":"NodeParagraph","Properties":{"id":"20240611104551-nmji76d","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611104551-tlcjef7","Type":"NodeParagraph","Properties":{"id":"20240611104551-tlcjef7","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" FRUCTUS CANNABIS"}]},{"ID":"20240611104551-jaguz58","Type":"NodeParagraph","Properties":{"id":"20240611104551-jaguz58","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611104551-fuv6d2w","Type":"NodeParagraph","Properties":{"id":"20240611104551-fuv6d2w","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 本品为桑科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大麻"},{"Type":"NodeText","Data":"Cannabis sativa L.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。秋季果实成熟时采收，除去杂质，晒干。"}]},{"ID":"20240611104551-rlbrnm2","Type":"NodeParagraph","Properties":{"id":"20240611104551-rlbrnm2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611104551-skvinrp","Type":"NodeParagraph","Properties":{"id":"20240611104551-skvinrp","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高1～3米。茎粗壮直立，有纵沟，密生短柔毛，掌状复叶互生或下部对生。夏季开花，排列成长而疏散的圆锥花序，顶生或腋生。瘦果扁卵圆形，灰褐色，有细网状纹，为宿存的黄褐色苞片包裹。"}]},{"ID":"20240611104551-8lud0ne","Type":"NodeParagraph","Properties":{"id":"20240611104551-8lud0ne","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611104551-pz2l7lr","Type":"NodeParagraph","Properties":{"id":"20240611104551-pz2l7lr","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 本品呈卵圆形，长4～5。5mm，直径2。5～4mm。表面灰绿色或灰黄色，有微细的白色或棕色网纹，两边有棱，顶端略尖，基部有1圆形果梗痕。果皮薄而脆，易破碎。种皮绿色，子叶2，乳白色，富油性。气微，味淡。"}]},{"ID":"20240611104551-zqzxxn6","Type":"NodeParagraph","Properties":{"id":"20240611104551-zqzxxn6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611104551-g2xy706","Type":"NodeParagraph","Properties":{"id":"20240611104551-g2xy706","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防热，防蛀。"}]},{"ID":"20240611104551-bogeowt","Type":"NodeParagraph","Properties":{"id":"20240611104551-bogeowt","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611104551-qo1uo42","Type":"NodeParagraph","Properties":{"id":"20240611104551-qo1uo42","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"火麻仁"},{"Type":"NodeText","Data":"：除去杂质及果皮。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒火麻仁："},{"Type":"NodeText","Data":"取净火麻仁，照清炒法（附录Ⅱ D）炒至微黄色、有香气。"}]},{"ID":"20240611104551-d8m0kc2","Type":"NodeParagraph","Properties":{"id":"20240611104551-d8m0kc2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611104551-a9h3kns","Type":"NodeParagraph","Properties":{"id":"20240611104551-a9h3kns","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 取本品粉末2g，加乙醚50ml，加热回流1小时，滤过，药渣再加乙醚20ml洗涤，弃去乙醚液，药渣加甲醇30ml，加热回流1小时，滤过，滤液蒸干，残渣加甲醇2ml使溶解，作为供试品溶液。另取火麻仁对照药材2g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一硅胶G薄层板上，以甲苯-醋酸乙酯-甲酸（15：1：0。3）为展开剂，展开，取出，晾干，喷以1％香草醛乙醇溶液-硫酸（1：1）混合液，在105℃加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611104551-wsyx5zj","Type":"NodeParagraph","Properties":{"id":"20240611104551-wsyx5zj","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611104551-o4qjmv9","Type":"NodeParagraph","Properties":{"id":"20240611104551-o4qjmv9","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、大肠经。"}]},{"ID":"20240611104551-o9vglnr","Type":"NodeParagraph","Properties":{"id":"20240611104551-o9vglnr","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611104551-ykn4ysw","Type":"NodeParagraph","Properties":{"id":"20240611104551-ykn4ysw","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240611104551-68sh7xz","Type":"NodeParagraph","Properties":{"id":"20240611104551-68sh7xz","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611104551-n9ol2fy","Type":"NodeParagraph","Properties":{"id":"20240611104551-n9ol2fy","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 润肠通便。用于血虚津亏，肠燥便秘。"}]},{"ID":"20240611104551-l2443l7","Type":"NodeParagraph","Properties":{"id":"20240611104551-l2443l7","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611104551-st8agne","Type":"NodeParagraph","Properties":{"id":"20240611104551-st8agne","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611104551-umkmaqr","Type":"NodeParagraph","Properties":{"id":"20240611104551-umkmaqr","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611104551-ddpq3fb","Type":"NodeParagraph","Properties":{"id":"20240611104551-ddpq3fb","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" （1）常用于体质较为虚弱、津血枯少的肠燥便秘，可配合柏子仁、瓜蒌仁、郁李仁、等同用。"}]},{"ID":"20240611104551-3vogitk","Type":"NodeParagraph","Properties":{"id":"20240611104551-3vogitk","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611104551-gbokc7a","Type":"NodeParagraph","Properties":{"id":"20240611104551-gbokc7a","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611104551-yhcev5v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104551-yhcev5v","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：火麻仁"}]},{"ID":"20240611104551-t51krth","Type":"NodeParagraph","Properties":{"id":"20240611104551-t51krth","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611104551-s79p36l","Type":"NodeParagraph","Properties":{"id":"20240611104551-s79p36l","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" Huǒ Má Rén"}]},{"ID":"20240611104551-h1dkocs","Type":"NodeParagraph","Properties":{"id":"20240611104551-h1dkocs","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611104551-oq0exhp","Type":"NodeParagraph","Properties":{"id":"20240611104551-oq0exhp","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 麻子（《本经》），麻子仁（《伤寒论》），大麻子（《本草经集注》），大麻仁（《药性论》），白麻子（《千金·食治》），冬麻子（《食医心镜》），火麻子（《本草新编》）。"}]},{"ID":"20240611104551-tt7fp4p","Type":"NodeParagraph","Properties":{"id":"20240611104551-tt7fp4p","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611104551-qrdmc5l","Type":"NodeParagraph","Properties":{"id":"20240611104551-qrdmc5l","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 《日用本草》"}]},{"ID":"20240611104551-tf45v6e","Type":"NodeParagraph","Properties":{"id":"20240611104551-tf45v6e","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611104551-6ej4o3d","Type":"NodeParagraph","Properties":{"id":"20240611104551-6ej4o3d","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 为桑科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大麻"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种仁"},{"Type":"NodeText","Data":"。秋、冬果实成热时，割取全株，晒干，打下果实，除去杂质。"}]},{"ID":"20240611104551-fevel0n","Type":"NodeParagraph","Properties":{"id":"20240611104551-fevel0n","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611104551-6n3wmu3","Type":"NodeParagraph","Properties":{"id":"20240611104551-6n3wmu3","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 全国各地均有栽培。产黑龙江、辽宁、吉林、四川、甘肃、云南、江苏、浙江等地。"}]},{"ID":"20240611104551-2ttcuj3","Type":"NodeParagraph","Properties":{"id":"20240611104551-2ttcuj3","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611104551-mmnjvvz","Type":"NodeParagraph","Properties":{"id":"20240611104551-mmnjvvz","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 大麻（《本草经集注》），又名：麻（《诗经》），汉麻（《事物纪原》），火麻（《日用本草》），山丝苗（《救荒本草》），黄麻（《纲目》）。"}]},{"ID":"20240611104551-yyaf68q","Type":"NodeParagraph","Properties":{"id":"20240611104551-yyaf68q","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"一年生草本，高1～3米。茎直立，分枝，表面有纵沟，密被短柔毛。掌状复叶互生，茎下部的叶对生；小叶3～11，披针形至线状披针形，先端长尖，基部楔形，边缘有粗锯齿，上面深绿色，粗糙，下面密被灰白色毡毛；柄长4～14厘米，有短绵毛。花单性，雌雄异株；雄花呈疏生的圆锥花序，黄绿色，花被5，长卵形，覆瓦状排列，雄蕊5，花丝细长；雌花丛生于叶腋，绿色，每朵花外被1卵形苞片，花被1，膜质，雌蕊1，子房圆球状，花柱分为2枝。瘦果扁卵形，长4～5毫米。有细网纹，外围包以黄褐色的苞片。花、果期因产地不同而异，华东花期5～6月，果期6～7月；华北花期6～7月，果期8～9月。"}]},{"ID":"20240611104551-7vsqn60","Type":"NodeParagraph","Properties":{"id":"20240611104551-7vsqn60","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611104551-c5e5f0s","Type":"NodeParagraph","Properties":{"id":"20240611104551-c5e5f0s","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 干燥果实呈扁卵圆形，长4～5毫米，直径3～4毫米。表面光滑，灰绿色或灰黄色，有微细的白色、棕色或黑色花纹，两侧各有1条浅色棱线。一端钝尖，另端有一果柄脱落的圆形凹点。外果皮菲薄，内果皮坚脆。绿色种皮常粘附在内果皮上，不易分离。胚乳灰白色，菲薄；子叶两片，肥厚，富油性。气微，味淡。以色黄、无皮壳、饱满者佳。"}]},{"ID":"20240611104551-30eb9r8","Type":"NodeParagraph","Properties":{"id":"20240611104551-30eb9r8","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611104551-ke0fll3","Type":"NodeParagraph","Properties":{"id":"20240611104551-ke0fll3","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 误食一定数量之火麻仁（炒熟者），可发生中毒"}]},{"ID":"20240611104551-y045pwb","Type":"NodeParagraph","Properties":{"id":"20240611104551-y045pwb","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"据报道，大多在食火麻仁后1～2小时内发病，最长12小时，中毒程度之轻重与进食量的多少成正比。临床症状表现为恶心，呕吐、腹泻、四肢发麻、烦躁不安、精神错乱、手舞足蹈、脉搏增速、瞳孔散大、昏睡以致昏迷。解救方法：经洗胃、补液及一般对症治疗，均在1～2天内症状先后消失而愈，无1例死亡。"}]},{"ID":"20240611104551-dngv9m7","Type":"NodeParagraph","Properties":{"id":"20240611104551-dngv9m7","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611104551-l2779b0","Type":"NodeParagraph","Properties":{"id":"20240611104551-l2779b0","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 种子含胡芦巴碱、异亮氨酸甜菜碱、麻仁球朊酶、亚麻酸、亚油酸等。"}]},{"ID":"20240611104551-9612zes","Type":"NodeParagraph","Properties":{"id":"20240611104551-9612zes","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611104551-oglj9ya","Type":"NodeParagraph","Properties":{"id":"20240611104551-oglj9ya","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 拣去杂质及残留外壳，取净仁。"}]},{"ID":"20240611104551-styhb0g","Type":"NodeParagraph","Properties":{"id":"20240611104551-styhb0g","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611104551-67ep802","Type":"NodeParagraph","Properties":{"id":"20240611104551-67ep802","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 入脾、胃、大肠经。"}]},{"ID":"20240611104551-ufp03ps","Type":"NodeParagraph","Properties":{"id":"20240611104551-ufp03ps","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足大阴、手阳明经。\""}]},{"ID":"20240611104551-h8kna0c","Type":"NodeParagraph","Properties":{"id":"20240611104551-h8kna0c","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入肺、大肠二经。\""}]},{"ID":"20240611104551-h528vep","Type":"NodeParagraph","Properties":{"id":"20240611104551-h528vep","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入脾、胃、大肠。\""}]},{"ID":"20240611104551-epbflla","Type":"NodeParagraph","Properties":{"id":"20240611104551-epbflla","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611104551-rpcauzl","Type":"NodeParagraph","Properties":{"id":"20240611104551-rpcauzl","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240611104551-og5y4cr","Type":"NodeParagraph","Properties":{"id":"20240611104551-og5y4cr","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240611104551-jviw4l2","Type":"NodeParagraph","Properties":{"id":"20240611104551-jviw4l2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、岐伯：辛；雷公、扁鹊：无毒。\""}]},{"ID":"20240611104551-h5iecvj","Type":"NodeParagraph","Properties":{"id":"20240611104551-h5iecvj","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"寒。\""}]},{"ID":"20240611104551-fmwngvv","Type":"NodeParagraph","Properties":{"id":"20240611104551-fmwngvv","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"④《食疗本草》：\"微寒。\""}]},{"ID":"20240611104551-dxc5kii","Type":"NodeParagraph","Properties":{"id":"20240611104551-dxc5kii","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611104551-27abzp6","Type":"NodeParagraph","Properties":{"id":"20240611104551-27abzp6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"畏牡蛎、白薇，恶茯苓。\""}]},{"ID":"20240611104551-1nljucv","Type":"NodeParagraph","Properties":{"id":"20240611104551-1nljucv","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"②《食性本草》：\"多食损血脉，滑精气，妇人多食发带疾。\""}]},{"ID":"20240611104551-cb835bq","Type":"NodeParagraph","Properties":{"id":"20240611104551-cb835bq","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"肠滑者尤忌。\""}]},{"ID":"20240611104551-i63tfuf","Type":"NodeParagraph","Properties":{"id":"20240611104551-i63tfuf","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611104551-f99clfo","Type":"NodeParagraph","Properties":{"id":"20240611104551-f99clfo","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 润燥，滑肠，通淋，活血。治肠燥便秘，消渴，热淋，风痹，痢疾。月经不调，疥疮，癣癞。"}]},{"ID":"20240611104551-gxj2fom","Type":"NodeParagraph","Properties":{"id":"20240611104551-gxj2fom","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"补中益气。\""}]},{"ID":"20240611104551-hug8h9j","Type":"NodeParagraph","Properties":{"id":"20240611104551-hug8h9j","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主中风汗出，逐水，利小便，破积血，复血脉，乳妇产后余疾。\""}]},{"ID":"20240611104551-o81nzpg","Type":"NodeParagraph","Properties":{"id":"20240611104551-o81nzpg","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治大肠风热结湿及热淋。\""}]},{"ID":"20240611104551-ndsque1","Type":"NodeParagraph","Properties":{"id":"20240611104551-ndsque1","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"主五劳。\""}]},{"ID":"20240611104551-7zxdn70","Type":"NodeParagraph","Properties":{"id":"20240611104551-7zxdn70","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"取汁煮粥，去五脏风、润肺。治关节不通、发落，通血脉。\""}]},{"ID":"20240611104551-hm4u0v8","Type":"NodeParagraph","Properties":{"id":"20240611104551-hm4u0v8","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑥《本草拾遗》：\"下气，利小便，去风痹皮顽，炒令香捣碎，小便浸取汁服；妇人倒产吞二七枚。\""}]},{"ID":"20240611104551-v3qfugs","Type":"NodeParagraph","Properties":{"id":"20240611104551-v3qfugs","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑦《日华子本草》：\"补虚劳，长肌肉，下乳，止消渴，催生。治横逆产。\""}]},{"ID":"20240611104551-knazflx","Type":"NodeParagraph","Properties":{"id":"20240611104551-knazflx","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"利女人经脉，调大肠下痢；涂诸疮癞，杀虫；取汁煮粥食，止呕逆。\""}]},{"ID":"20240611104551-yyr7raa","Type":"NodeParagraph","Properties":{"id":"20240611104551-yyr7raa","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑨《分类草药性》：\"治跌打损伤，去瘀血，生新血。\""}]},{"ID":"20240611104551-f7gq8sb","Type":"NodeParagraph","Properties":{"id":"20240611104551-f7gq8sb","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611104551-585e33y","Type":"NodeParagraph","Properties":{"id":"20240611104551-585e33y","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～6钱；或入丸、散。外用：捣敷或榨油涂。"}]},{"ID":"20240611104551-ko46cwq","Type":"NodeParagraph","Properties":{"id":"20240611104551-ko46cwq","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611104551-k7lhsyd","Type":"NodeParagraph","Properties":{"id":"20240611104551-k7lhsyd","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" ①治伤寒趺阳脉浮而涩，浮则胃气强，涩则小便数，浮涩相搏，大便则硬，其脾为约：麻于仁二升，芍药半斤，枳实半斤（炙），大黄一斤（去皮），厚朴一尺（炙，去皮），杏仁一升（去皮，炙、熬，别作脂）。上六味，蜜和丸，如梧桐子大。饮服十丸，日三服，渐加，以知为度。（《伤寒沦》麻子仁丸）"}]},{"ID":"20240611104551-kudr146","Type":"NodeParagraph","Properties":{"id":"20240611104551-kudr146","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"②治大便不通：研麻子，以米杂为粥食之。（《肘后方》）"}]},{"ID":"20240611104551-2kf4rp3","Type":"NodeParagraph","Properties":{"id":"20240611104551-2kf4rp3","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"③治虚劳，下焦虚热，骨节烦疼，肌肉急，小便不利，大便数少，吸吸口燥少气：大麻仁五合，研，水二升，煮去半分，服。（《外台》）"}]},{"ID":"20240611104551-vq1mbxu","Type":"NodeParagraph","Properties":{"id":"20240611104551-vq1mbxu","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"④治产后郁冒多汗，便秘：紫苏子、大麻仁各半合，净洗，研极细，用水再研，取汁一盏，分二次煮粥喂之。此粥不惟产后可服，大抵老人、诸虚人风秘，皆得力。（《本事方》麻子苏子粥）"}]},{"ID":"20240611104551-rsv6bmg","Type":"NodeParagraph","Properties":{"id":"20240611104551-rsv6bmg","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑤治大渴，日食数斗，小便赤涩者：麻子一升，水三升，煮三、四沸，取汁饮之。（《肘后方》）"}]},{"ID":"20240611104551-pf2825m","Type":"NodeParagraph","Properties":{"id":"20240611104551-pf2825m","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"③治五淋，小便赤少，茎中疼痛：冬麻子一升，杵研，滤取汁二升，和米三合，煮粥，着葱、椒及熟煮，空心服之。（《食医心镜》）"}]},{"ID":"20240611104551-qym75id","Type":"NodeParagraph","Properties":{"id":"20240611104551-qym75id","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑦治脚气肿渴：大麻子熬令香，和水研，取-大升，别以三大升水煮一大升赤小豆，取一升汁，即纳麻汁，更煎三、五拂，渴即饮之，冷热任取，饥时啖豆亦佳。（《外台》）"}]},{"ID":"20240611104551-8u7kaci","Type":"NodeParagraph","Properties":{"id":"20240611104551-8u7kaci","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑧治风水腹大，脐腰重痛，不可转动：冬麻子半升，碎，水研滤取汁，米二合，以麻子汁煮作稀粥，着葱、椒、姜、豉，空心食之。（《食医心镜》）"}]},{"ID":"20240611104551-vpbsl74","Type":"NodeParagraph","Properties":{"id":"20240611104551-vpbsl74","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑨治骨髓风毒疼痛，不可运动者：大麻仁水中浸取沉者一大升，漉出曝干，炒，待香热，即入木臼捣极细如白粉，平分为十帖。每用一帖，取无灰酒一大瓷汤碗研麻粉，旋滤取白酒，直令麻粉尽，余壳即去之，都合酒一处，煎取一半，待冷热得所，空腹顿服，日服一帖。（《箧中方》大麻仁酒）"}]},{"ID":"20240611104551-y4jgch1","Type":"NodeParagraph","Properties":{"id":"20240611104551-y4jgch1","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑩治白痢：麻子汁，煮取绿豆，空腹饱服。（孟诜《必效方》）"}]},{"ID":"20240611104551-uijm9ph","Type":"NodeParagraph","Properties":{"id":"20240611104551-uijm9ph","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑾治小儿赤白痢，体弱不堪，困重者：麻子一合，炒令香熟，末服一钱匕，蜜、浆水和服。（《子母秘录》）"}]},{"ID":"20240611104551-dr4076n","Type":"NodeParagraph","Properties":{"id":"20240611104551-dr4076n","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⑿治妇人月水不利，或至两三月、半年、一年不通者：桃仁二升，麻孑仁二升，合捣，酒一斗，渍一宿，服一升，日三夜一。（《肘后方》）"}]},{"ID":"20240611104551-gb985nk","Type":"NodeParagraph","Properties":{"id":"20240611104551-gb985nk","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒀治产后血不去：麻子五升，捣，以酒一斗渍一宿，明旦去滓，温服一升，先食服，不瘥，夜服一升。忌房事一月，将养如初产法。（《千金方》麻子酒）"}]},{"ID":"20240611104551-y6yg2j2","Type":"NodeParagraph","Properties":{"id":"20240611104551-y6yg2j2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒁治妊娠损动后腹痛：冬麻子一升，杵碎熬，以水二斗，煮取汁，热沸，分为三、四服。（《食医心镜》）"}]},{"ID":"20240611104551-2ugqrdg","Type":"NodeParagraph","Properties":{"id":"20240611104551-2ugqrdg","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒂治寸白由：吴茱萸细根一把（熟捣），大麻子三升（熬，捣末）。上二味，以水三升和搦取汁，旦顿服之，至巳时，与好食令饱，须臾虫出，不瘥，明且更合服之，不瘥，三日服。（《千金方》）"}]},{"ID":"20240611104551-y9itqhg","Type":"NodeParagraph","Properties":{"id":"20240611104551-y9itqhg","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒃治呕逆：麻仁三合，熬，捣，以水研取汁，着少盐吃。（《近效方》）"}]},{"ID":"20240611104551-k091sp2","Type":"NodeParagraph","Properties":{"id":"20240611104551-k091sp2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒄治小儿头面疮疥：麻子五升末之，以水和绞取汁，与蜜和敷之。（《千金方》）"}]},{"ID":"20240611104551-uj8chiz","Type":"NodeParagraph","Properties":{"id":"20240611104551-uj8chiz","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒅治小儿疳疮：捣麻子敷之，日六、七度。（《子母秘录》）"}]},{"ID":"20240611104551-6jfn02x","Type":"NodeParagraph","Properties":{"id":"20240611104551-6jfn02x","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒆治金疮腹中瘀血：大麻子三升，大葱白二十枚。各捣令熟，著九升水，煮取一升半，顿服之。若血出不尽，腹中有脓血，更合服，当吐脓血耳。（二物汤）"}]},{"ID":"20240611104551-opx0cre","Type":"NodeParagraph","Properties":{"id":"20240611104551-opx0cre","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"⒇治瘭疽着手足肩背，忽发累累如赤豆，剥之汁出者：麻子熬作末，摩上良。"}]},{"ID":"20240611104551-76bxoza","Type":"NodeParagraph","Properties":{"id":"20240611104551-76bxoza","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"（21）治赤流肿丹毒：捣大麻子水和敷之。（⒆方以下出《千金方》）"}]},{"ID":"20240611104551-5nnociy","Type":"NodeParagraph","Properties":{"id":"20240611104551-5nnociy","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"（22）治汤火伤：火麻仁、黄柏、黄栀子，共研末，调猪脂涂。（《四川中药志》）"}]},{"ID":"20240611104551-9g0phb5","Type":"NodeParagraph","Properties":{"id":"20240611104551-9g0phb5","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"（23）治聘耳，脓水不止：麻子一合，花臙脂一分。都研为末，满耳塞药，以绵轻拥。（《圣惠方》）"}]},{"ID":"20240611104551-6qw8j66","Type":"NodeParagraph","Properties":{"id":"20240611104551-6qw8j66","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611104551-skkpk6q","Type":"NodeParagraph","Properties":{"id":"20240611104551-skkpk6q","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 大麻的雌花枝和果穗亦入药，能镇痛、麻酸、致幻、有成瘾性。"}]},{"ID":"20240611104551-3sunxj5","Type":"NodeParagraph","Properties":{"id":"20240611104551-3sunxj5","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611104551-tjduoc2","Type":"NodeParagraph","Properties":{"id":"20240611104551-tjduoc2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611104551-y5gq52l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104551-y5gq52l","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"《中华本草》：火麻仁"}]},{"ID":"20240611104551-bmod51c","Type":"NodeParagraph","Properties":{"id":"20240611104551-bmod51c","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611104551-i3azw8f","Type":"NodeParagraph","Properties":{"id":"20240611104551-i3azw8f","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" Huǒ Má Rén"}]},{"ID":"20240611104551-mtekyzd","Type":"NodeParagraph","Properties":{"id":"20240611104551-mtekyzd","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611104551-xcdu4qj","Type":"NodeParagraph","Properties":{"id":"20240611104551-xcdu4qj","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" （艹肥）、麻子、麻于仁、麻仁、大麻子、大麻仁、冬麻子火麻子、线麻子、黄麻仁"}]},{"ID":"20240611104551-w3yz25u","Type":"NodeParagraph","Properties":{"id":"20240611104551-w3yz25u","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611104551-9ayy42u","Type":"NodeParagraph","Properties":{"id":"20240611104551-9ayy42u","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 出自1.《日用本草》。"}]},{"ID":"20240611104551-eytdgp5","Type":"NodeParagraph","Properties":{"id":"20240611104551-eytdgp5","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"2.《神农本草经》。"}]},{"ID":"20240611104551-0jdicam","Type":"NodeParagraph","Properties":{"id":"20240611104551-0jdicam","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611104551-mhxawqo","Type":"NodeParagraph","Properties":{"id":"20240611104551-mhxawqo","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 药材基源：为桑科植物大麻的种仁。"}]},{"ID":"20240611104551-4nfavq6","Type":"NodeParagraph","Properties":{"id":"20240611104551-4nfavq6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cannabis sativa L．"}]},{"ID":"20240611104551-3zi9ua6","Type":"NodeParagraph","Properties":{"id":"20240611104551-3zi9ua6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"采收和储藏：10～11月果实大部分成熟时，割取果株，晒干，脱粒，扬净。"}]},{"ID":"20240611104551-qs8o7yw","Type":"NodeParagraph","Properties":{"id":"20240611104551-qs8o7yw","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611104551-hz92xln","Type":"NodeParagraph","Properties":{"id":"20240611104551-hz92xln","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 生态环境：我国各地均有栽培，也有半野生。"}]},{"ID":"20240611104551-mcxfj99","Type":"NodeParagraph","Properties":{"id":"20240611104551-mcxfj99","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华东、中南等地。"}]},{"ID":"20240611104551-6l3zvuz","Type":"NodeParagraph","Properties":{"id":"20240611104551-6l3zvuz","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611104551-hmqzusk","Type":"NodeParagraph","Properties":{"id":"20240611104551-hmqzusk","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高l-3m。茎直立，表面有纵沟，密被短柔毛，皮层富纤维，基部木质化。掌状叶互生或下部对生，全裂，裂片3-11枚，披针形至条状披针形，两端渐尖，边缘具粗锯齿，上面深绿色，有粗毛，下面密被灰白色毡毛；叶柄长4-15cm，被短绵毛；托叶小，离生，披针形。花单性，雌雄异株；雄花序为疏散的圆锥花序，顶生或腋生；雄花具花被片5，雄蕊5，花丝细长，花药大；雌花簇生于叶腋，绿黄色，每朵花外面有一卵形苞片，花被小膜质，雌蕊1；于房圆球形，花柱呈二歧。瘦果卵圆形，长4-5mm，质硬，灰褐色，有细网状纹，为宿存的黄褐色苞片所包裹。花期 5- 6月，果期 7一 8月。"}]},{"ID":"20240611104551-bzezfhg","Type":"NodeParagraph","Properties":{"id":"20240611104551-bzezfhg","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611104551-00zrzbd","Type":"NodeParagraph","Properties":{"id":"20240611104551-00zrzbd","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，幼苗期能耐-5-－3℃霜冻，生长适宜温度为19～23℃。对土壤要求不严，以土层深厚、疏松肥沃、排水良好的砂质壤土或粘质壤土栽培为宜。"}]},{"ID":"20240611104551-7xrajpa","Type":"NodeParagraph","Properties":{"id":"20240611104551-7xrajpa","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。选生长健壮、结实多的雌株割下果枝，晒干，脱粒，备用。春季3-4月播种。穴播：按行株距30cm X 30cm开穴，每穴播种子10粒左右；条播：按行株距45cmX 60cm开沟，将种手均匀播入，覆土，盖草木灰一层。每1hm2用种子15kg左右。播后7～10d出苗。"}]},{"ID":"20240611104551-peweaws","Type":"NodeParagraph","Properties":{"id":"20240611104551-peweaws","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高6～10cm时需间苗、定苗。每穴留苗3～4株。生长期间松土、除草2～3次，幼苗期直浅锄，后期可深锄，并结合培土。施肥可追施人粪尿或硫酸铵肥，后期增施过磷酸钙、草木灰。花序形成时要除去大部雄株。"}]},{"ID":"20240611104551-zqwfte3","Type":"NodeParagraph","Properties":{"id":"20240611104551-zqwfte3","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有菌核病，用65％代森锌可湿性粉剂600倍液喷射；霜霉病用多菌灵防治：还有立枯病、斑点病等为害。"}]},{"ID":"20240611104551-tzcyfrs","Type":"NodeParagraph","Properties":{"id":"20240611104551-tzcyfrs","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611104551-x3pq5gu","Type":"NodeParagraph","Properties":{"id":"20240611104551-x3pq5gu","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实呈扁卵圆形，长3-5mm，宽3-4mm。表面灰褐色或灰绿色，有细微的白色或棕色网纹，顶端略尖，基部有圆形的果柄痕，两侧有棱，果皮薄而脆，易破碎。种皮暗绿色，胚弯曲，被菲薄胚乳。子叶与胚根等长，乳白色。富油性。气微，味淡，嚼后稍有麻千舌感。"}]},{"ID":"20240611104551-1t8q3xo","Type":"NodeParagraph","Properties":{"id":"20240611104551-1t8q3xo","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"以粒大、种仁饱满者为佳。"}]},{"ID":"20240611104551-pbpsc7t","Type":"NodeParagraph","Properties":{"id":"20240611104551-pbpsc7t","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：深棕色。①外果皮石细胞多成片，淡黄色。表面观呈不规则多角形，垂周壁深波状弯曲，有的分枝呈星状，直径13-54μm，壁厚3-11μm，长约90μn，外平周壁稍有纹理，层纹清晰，纹孔细密，胞腔大，有的含棕黄色物。断面观呈长方形，细胞界限不明显。②网状果皮细胞成片，黄棕色。细胞小，直径6-10μm，壁薄，波状弯曲。③内果皮石细胞成片，黄棕色或淡黄色。顶面观呈类圆形或类多角形，胞间层细波状弯曲，垂周壁甚厚，孔沟细密，与胞间层相连，胞腔明显。断面观呈栅状，长70-215μm，宽约至52d3μm，胞间层不规则弯曲，径向壁厚，近内壁渐薄，细胞界限不甚明显。④草酸钙簇晶多存在于皱缩的果皮薄壁细胞中，直径4-13μm。⑤种皮表皮细胞黄色或黄棕色，细胞界限不甚明显，壁薄，有类圆形间隙。⑥子叶细胞无色黄色，含脂肪油滴。"}]},{"ID":"20240611104551-x6cssgu","Type":"NodeParagraph","Properties":{"id":"20240611104551-x6cssgu","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611104551-kuxl388","Type":"NodeParagraph","Properties":{"id":"20240611104551-kuxl388","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 种子含胡芦巴碱（TCMLIBigonelline），L－右旋异亮氨酸三甲铵乙内酯[L（d）-isoleucine betaine]。含脂肪油约30%，其中亚油酸（linoleic acid）59.7%-62.9%，亚麻酸（linolenic acid）14.7%-17.4%，油酸（oleic acid）8.4%-14.8%，还含玉蜀黍嘌呤（zeatin）。"}]},{"ID":"20240611104551-hdpiype","Type":"NodeParagraph","Properties":{"id":"20240611104551-hdpiype","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611104551-mcxwzdm","Type":"NodeParagraph","Properties":{"id":"20240611104551-mcxwzdm","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 1.对心血管系统的作用 大麻仁酊剂去酒精作成乳剂应用，麻醉猫十二指肠内给2g／kg，半小时后血压开始缓缓下降，2小时后约降至原水平一半左右，心率及呼吸未见显着变化。正常大鼠灌服2及10g/kg，血压亦有显着降低。高血压患者服5-6周，血压亦可降低，且无不良反应。国产火麻仁品种与印度产的相同，生理效用也相仿。"}]},{"ID":"20240611104551-itvbg0g","Type":"NodeParagraph","Properties":{"id":"20240611104551-itvbg0g","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"2.致泻 火麻仁能刺激肠粘膜，使分泌增加，蠕动加快，并减少大肠吸收水分，故有泻下作用。麻仁胶囊4、8g/kg和麻仁丸4g/kg灌胃，观察12小时，对小鼠均有通便作用，前者作用较强；麻仁胶囊(1：1，1：0.5)、麻仁丸(1：1)各0.1ml注入蟾蜍小肠段，90分钟的观察，均有增加肠内容物的作用。"}]},{"ID":"20240611104551-scerznb","Type":"NodeParagraph","Properties":{"id":"20240611104551-scerznb","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"3.对血清胆固醇的影响 实验取成年大白鼠20只，体重190-240g，雌雄各半，每组10只，雌雄各半，根据体重及血清胆固醇浓度分为随机对照组及实验组，对照组饲以高脂饲料，实验组在高脂饲料中加火麻仁干样品10%。结果表明，火麻仁有明显阻止大鼠血清胆固醇升高的作用，在实验期内，4星期的血清胆固醇水平比较稳定，第3、4星期显着低于对照组(P\u003c0.05)。"}]},{"ID":"20240611104551-c1qohkf","Type":"NodeParagraph","Properties":{"id":"20240611104551-c1qohkf","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611104551-ltw3b5d","Type":"NodeParagraph","Properties":{"id":"20240611104551-ltw3b5d","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 拣去杂质及残留外壳，取净仁。"}]},{"ID":"20240611104551-0agfjih","Type":"NodeParagraph","Properties":{"id":"20240611104551-0agfjih","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611104551-foidzal","Type":"NodeParagraph","Properties":{"id":"20240611104551-foidzal","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 脾；胃；大肠经"}]},{"ID":"20240611104551-aqcgknm","Type":"NodeParagraph","Properties":{"id":"20240611104551-aqcgknm","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611104551-6tvcpes","Type":"NodeParagraph","Properties":{"id":"20240611104551-6tvcpes","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 甘；性平"}]},{"ID":"20240611104551-4oox51o","Type":"NodeParagraph","Properties":{"id":"20240611104551-4oox51o","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611104551-mrrhxpx","Type":"NodeParagraph","Properties":{"id":"20240611104551-mrrhxpx","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 1.《本草经集注》：畏牡蛎、白薇，恶茯苓。"}]},{"ID":"20240611104551-kr7ef64","Type":"NodeParagraph","Properties":{"id":"20240611104551-kr7ef64","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"2.《食性本草》：多食损血脉，滑精气，妇人多食发带疾。"}]},{"ID":"20240611104551-lghlyb2","Type":"NodeParagraph","Properties":{"id":"20240611104551-lghlyb2","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：肠滑者尤忌。"}]},{"ID":"20240611104551-pppsn7q","Type":"NodeParagraph","Properties":{"id":"20240611104551-pppsn7q","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611104551-ed2p1hw","Type":"NodeParagraph","Properties":{"id":"20240611104551-ed2p1hw","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 润燥滑肠；利水通淋；活血。主肠燥便秘；风痹；消渴；风水；热淋；痢疾；月经不调；疮癣；丹毒"}]},{"ID":"20240611104551-7sy1n7v","Type":"NodeParagraph","Properties":{"id":"20240611104551-7sy1n7v","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611104551-oktg1b6","Type":"NodeParagraph","Properties":{"id":"20240611104551-oktg1b6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15；或入丸，散。外用：适量，捣敷；或煎水洗。"}]},{"ID":"20240611104551-7yzx1vk","Type":"NodeParagraph","Properties":{"id":"20240611104551-7yzx1vk","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611104551-f14n6gq","Type":"NodeParagraph","Properties":{"id":"20240611104551-f14n6gq","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 麻子仁丸《伤寒论》：润肠泄热；润肠丸《脾胃论》：润肠通便、活血祛风；黄芪汤《金匮翼》：益气润肠；润肠丸《沈氏尊生书》：血虚便秘"}]},{"ID":"20240611104551-vq3o8e9","Type":"NodeParagraph","Properties":{"id":"20240611104551-vq3o8e9","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611104551-a1mp444","Type":"NodeParagraph","Properties":{"id":"20240611104551-a1mp444","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 1.《伤寒明理论》：《内经》曰，脾欲缓，急食甘以缓之。麻仁、杏仁润物也。《本草》曰，润可去枯。脾胃干燥，必以甘润之物为之主。"}]},{"ID":"20240611104551-bcn5gop","Type":"NodeParagraph","Properties":{"id":"20240611104551-bcn5gop","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：麻子，性最滑利。甘能补中，中得补则气自益，甘能益血，血脉复则积血破，乳妇产后余疾皆除矣。风并于卫，则卫实而荣虚，荣者，血也、阴也。《经》曰，阴弱者汗自出。麻仁益血补阴，使荣卫调和，风邪去而汗自止也。逐水利小便者，滑利下行，引水气从小便而出也。"}]},{"ID":"20240611104551-99s9evm","Type":"NodeParagraph","Properties":{"id":"20240611104551-99s9evm","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"3.《药品化义》：麻仁，能润肠，体润能去燥，专利大肠气结便闭。凡老年血液枯燥，产后气血不顺，病后元气未复，或禀弱不能运行皆治。大肠闭结不通，不宜推荡，亦不容久闭，以此同紫菀、杏仁润其肺气，滋其大肠，则便自利矣。"}]},{"ID":"20240611104551-kimz38g","Type":"NodeParagraph","Properties":{"id":"20240611104551-kimz38g","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"4.《本草述》：麻子仁，非血药而有化血之液，不益气而有行气之用，故于大肠之风燥最宜。麻仁之所疗者风，然属血中之风，非漫治风也，而其所以疗风者，以其脂润而除燥，盖由于至阳而宣至阴之化，非泛泛以脂润为功也。"}]},{"ID":"20240611104551-hxo1haj","Type":"NodeParagraph","Properties":{"id":"20240611104551-hxo1haj","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"5.《本草思辨录》：仲景麻仁丸证，是脾受胃强之累而约而不舒。于是脾不散精于肺，肺之降令亦失，肺与脾胃俱困而便何能下。麻仁甘平滑利，柔中有刚，能入脾滋其阴津，化其燥气。但脾至于约，其中之坚结可知，麻仁能扩之不能破之，芍药乃脾家破血中之气药，合施之而脾其庶几不约矣乎。夫脾约由于胃强，治脾焉得不兼治胃，胃不独降，有资于肺，肺亦焉得不顾，故又佐以大黄、枳、朴攻胃，杏仁抑肺，病由胃生，而以脾约标名者，以此为太阳阳明非正阳阳明也。兼太阳故小便数，小便数故大便难，治法以起脾阴化燥气为主。燥气除而太阳不治自愈，故麻仁为要药。"}]},{"ID":"20240611104551-n6o6ukd","Type":"NodeParagraph","Properties":{"id":"20240611104551-n6o6ukd","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"6.《本经》：补中益气。"}]},{"ID":"20240611104551-iswbiwp","Type":"NodeParagraph","Properties":{"id":"20240611104551-iswbiwp","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"7.《别录》：主中风汗出，逐水，利小便，破积血，复血脉，乳妇产后余疾。"}]},{"ID":"20240611104551-8wvgwmt","Type":"NodeParagraph","Properties":{"id":"20240611104551-8wvgwmt","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：治大肠风热结涩及热淋。"}]},{"ID":"20240611104551-6gda1mb","Type":"NodeParagraph","Properties":{"id":"20240611104551-6gda1mb","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"9.《唐本草》：主五劳。"}]},{"ID":"20240611104551-j1l3ogp","Type":"NodeParagraph","Properties":{"id":"20240611104551-j1l3ogp","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"10.《食疗本草》：取汁煮粥，去五脏风、润肺。治关节不通、发落，通血脉。"}]},{"ID":"20240611104551-zbeg6m6","Type":"NodeParagraph","Properties":{"id":"20240611104551-zbeg6m6","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"11.《本草拾遗》：下气，利小便，去风痹皮顽，炒令香捣碎，小便浸取汁服；妇人倒产吞二七枚。"}]},{"ID":"20240611104551-axf3w43","Type":"NodeParagraph","Properties":{"id":"20240611104551-axf3w43","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：补虚劳，长肌肉，下乳，止消渴，催生。治横逆产。"}]},{"ID":"20240611104551-wx4tb03","Type":"NodeParagraph","Properties":{"id":"20240611104551-wx4tb03","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"13.《纲目》：利女人经脉，调大肠下痢；涂诸疮癞，杀虫；取汁煮粥食，止呕逆。"}]},{"ID":"20240611104551-ixn6z2a","Type":"NodeParagraph","Properties":{"id":"20240611104551-ixn6z2a","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"14.《分类草药性》：治跌打损伤，去瘀血，生新血。"}]},{"ID":"20240611104551-smpt4vm","Type":"NodeParagraph","Properties":{"id":"20240611104551-smpt4vm","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611104551-q87ki3e","Type":"NodeParagraph","Properties":{"id":"20240611104551-q87ki3e","updated":"20240611104551"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611104424-acikgfk","Type":"NodeThematicBreak","Properties":{"id":"20240611104424-acikgfk"}},{"ID":"20240611104442-n4y7r8t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104442-n4y7r8t","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：麻蕡"}]},{"ID":"20240611104442-tfi41eu","Type":"NodeParagraph","Properties":{"id":"20240611104442-tfi41eu","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611104442-0bv4gw8","Type":"NodeParagraph","Properties":{"id":"20240611104442-0bv4gw8","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" Má Fén"}]},{"ID":"20240611104442-til77ho","Type":"NodeParagraph","Properties":{"id":"20240611104442-til77ho","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611104442-4x0nrz3","Type":"NodeParagraph","Properties":{"id":"20240611104442-4x0nrz3","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 麻勃（《本经》），麻蓝、青羊、青葛（《吴普本草》）。"}]},{"ID":"20240611104442-04qxy6x","Type":"NodeParagraph","Properties":{"id":"20240611104442-04qxy6x","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611104442-auizdaz","Type":"NodeParagraph","Properties":{"id":"20240611104442-auizdaz","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611104442-vz8n8z1","Type":"NodeParagraph","Properties":{"id":"20240611104442-vz8n8z1","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611104442-s99dk3r","Type":"NodeParagraph","Properties":{"id":"20240611104442-s99dk3r","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 为桑科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大麻"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼嫩果穗"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611104442-jkxosi3","Type":"NodeParagraph","Properties":{"id":"20240611104442-jkxosi3","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611104442-jil1nyg","Type":"NodeParagraph","Properties":{"id":"20240611104442-jil1nyg","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 辛，平，有毒。"}]},{"ID":"20240611104442-jicntek","Type":"NodeParagraph","Properties":{"id":"20240611104442-jicntek","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240611104442-w1y4xxx","Type":"NodeParagraph","Properties":{"id":"20240611104442-w1y4xxx","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"甘微辛，平。\""}]},{"ID":"20240611104442-benil7q","Type":"NodeParagraph","Properties":{"id":"20240611104442-benil7q","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"③《广西中药志》：\"味辛，性温，有毒。\""}]},{"ID":"20240611104442-6oz748e","Type":"NodeParagraph","Properties":{"id":"20240611104442-6oz748e","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611104442-0r2dgfd","Type":"NodeParagraph","Properties":{"id":"20240611104442-0r2dgfd","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 体虚及孕妇忌服。"}]},{"ID":"20240611104442-qhsirnd","Type":"NodeParagraph","Properties":{"id":"20240611104442-qhsirnd","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"多食令人狂走。\""}]},{"ID":"20240611104442-2jsdj1b","Type":"NodeParagraph","Properties":{"id":"20240611104442-2jsdj1b","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"畏牡蛎、白薇。恶茯苓。\""}]},{"ID":"20240611104442-ty543a5","Type":"NodeParagraph","Properties":{"id":"20240611104442-ty543a5","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611104442-knb0ehu","Type":"NodeParagraph","Properties":{"id":"20240611104442-knb0ehu","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 祛风，止痛，镇痉。治痛风，痹证，癫狂，失眠，咳喘。"}]},{"ID":"20240611104442-eezm3ny","Type":"NodeParagraph","Properties":{"id":"20240611104442-eezm3ny","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五劳七伤，利五脏，下血寒气。\""}]},{"ID":"20240611104442-8zanytp","Type":"NodeParagraph","Properties":{"id":"20240611104442-8zanytp","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"破积，止痹，散脓。\""}]},{"ID":"20240611104442-n4755kt","Type":"NodeParagraph","Properties":{"id":"20240611104442-n4755kt","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"治身中伏风；同优钵罗花为麻药，砭痈肿不知痛。\""}]},{"ID":"20240611104442-iq6dyea","Type":"NodeParagraph","Properties":{"id":"20240611104442-iq6dyea","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"和胃，润命门，祛风，利大肠，破瘀，通乳，下胎。\""}]},{"ID":"20240611104442-cw8quwl","Type":"NodeParagraph","Properties":{"id":"20240611104442-cw8quwl","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"⑤《药物图考》：\"主贫血干嗽，安抚神经，止抽搐，痛风，痹症，安眠，调经破瘀，子宫不复原，卵腺痛，癫狂，花痴，肤痒。\""}]},{"ID":"20240611104442-1g4z76b","Type":"NodeParagraph","Properties":{"id":"20240611104442-1g4z76b","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"⑥李承祜《生药学》：\"治躁狂，癔病，痉挛性咳嗽，喘息，神经痛。\""}]},{"ID":"20240611104442-3mbqcur","Type":"NodeParagraph","Properties":{"id":"20240611104442-3mbqcur","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611104442-uqrm97d","Type":"NodeParagraph","Properties":{"id":"20240611104442-uqrm97d","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2分。外用：捣敷。"}]},{"ID":"20240611104442-g7qi1zk","Type":"NodeParagraph","Properties":{"id":"20240611104442-g7qi1zk","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611104442-kme6u7o","Type":"NodeParagraph","Properties":{"id":"20240611104442-kme6u7o","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 《药物图考》：\"麻蕡有毒，臭气甚浓，入口嚼尝，先时无味，后则微辛而麻。《本经》主五劳七伤，利五脏，下血，其活血之功用可知矣。于贫血症当酌加黄芪（肺结核症禁黄芪）、当归、铁剂等药；若兼干嗽宜去黄芪，加润肺之药；若偏枯痛风痹症，须与乌头、马钱子等药并施；如头痛宜佐芎藭、蔓荆子、羌活之类；若疗癫狂、花痴，须加莨菪等药；调经宜与当归、木香、羌活并用；肤痒宜佐蛇床子、石膏、大黄、虾蟆草、芥穗等药。\"\"此药常服致瘾。\""}]},{"ID":"20240611104442-4q66565","Type":"NodeParagraph","Properties":{"id":"20240611104442-4q66565","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611104442-02ndw5y","Type":"NodeParagraph","Properties":{"id":"20240611104442-02ndw5y","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611104442-m4xas6k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611104442-m4xas6k","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"《中华本草》：麻蕡"}]},{"ID":"20240611104442-mtnxvgl","Type":"NodeParagraph","Properties":{"id":"20240611104442-mtnxvgl","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611104442-uf6iize","Type":"NodeParagraph","Properties":{"id":"20240611104442-uf6iize","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" Má Fén"}]},{"ID":"20240611104442-8aye0ie","Type":"NodeParagraph","Properties":{"id":"20240611104442-8aye0ie","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611104442-lcmcc3s","Type":"NodeParagraph","Properties":{"id":"20240611104442-lcmcc3s","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" （台木）实、麻勃、麻蓝、青羊、青葛"}]},{"ID":"20240611104442-ngrfwji","Type":"NodeParagraph","Properties":{"id":"20240611104442-ngrfwji","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611104442-2rex9x1","Type":"NodeParagraph","Properties":{"id":"20240611104442-2rex9x1","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611104442-ussit72","Type":"NodeParagraph","Properties":{"id":"20240611104442-ussit72","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"1.《本草图经》：陶隐居以麻蕡为牡麻,牡麻则无实；苏恭以为责即实,非花也。按《本经》麻责主七伤,利五脏,多食令人狂走,观古今方书用麻子所治亦尔。又麻化非所食之物,如苏之沦似当矣。然朱字云,麻蕡味辛,麻子味甘,此又似二物。又古方亦有用麻花者,云味苦,主诸风及女经不利,以蔗虫为使,然则蕡也、子也。花也,其物平。"}]},{"ID":"20240611104442-sm9h82t","Type":"NodeParagraph","Properties":{"id":"20240611104442-sm9h82t","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"2.《药物图考》：麻贡,即雌麻之花也,由贡结实,即为麻子"}]},{"ID":"20240611104442-vqvfn1p","Type":"NodeParagraph","Properties":{"id":"20240611104442-vqvfn1p","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611104442-2wpabl0","Type":"NodeParagraph","Properties":{"id":"20240611104442-2wpabl0","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 药材基源：为桑科植物大麻的雌花序及幼嫩果序。"}]},{"ID":"20240611104442-skkphl8","Type":"NodeParagraph","Properties":{"id":"20240611104442-skkphl8","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cannabis sativa L."}]},{"ID":"20240611104442-jt9brte","Type":"NodeParagraph","Properties":{"id":"20240611104442-jt9brte","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季采收，鲜用或晒干。"}]},{"ID":"20240611104442-2ntz07k","Type":"NodeParagraph","Properties":{"id":"20240611104442-2ntz07k","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611104442-24l1duk","Type":"NodeParagraph","Properties":{"id":"20240611104442-24l1duk","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 生态环境：我国各地均有栽培，也有野生。"}]},{"ID":"20240611104442-xkc2sdq","Type":"NodeParagraph","Properties":{"id":"20240611104442-xkc2sdq","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华东、中南等地。"}]},{"ID":"20240611104442-z3pf4do","Type":"NodeParagraph","Properties":{"id":"20240611104442-z3pf4do","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611104442-wz44d2d","Type":"NodeParagraph","Properties":{"id":"20240611104442-wz44d2d","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高l-3m。茎直立，表面有纵沟，密被短柔毛，皮层富纤维，基部木质化。掌状叶互生或下部对生，全裂，裂片3-11枚，披针形至条状披针形，两端渐尖，边缘具粗锯齿，上面深绿色，有粗毛，下面密被灰白色毡毛；叶柄长4-15cm，被短绵毛；托叶小，离生，披针形。花单性，雌雄异株；雄花序为疏散的圆锥花序，顶生或腋生；雄花具花被片5，雄蕊5，花丝细长，花药大；雌花簇生于叶腋，绿黄色，每朵花外面有一卵形苞片，花被小膜质，雌蕊1；于房圆球形，花柱呈二歧。瘦果卵圆形，长4-5mm，质硬，灰褐色，有细网状纹，为宿存的黄褐色苞片所包裹。花期 5- 6月，果期 7一 8月。"}]},{"ID":"20240611104442-7cqc7p3","Type":"NodeParagraph","Properties":{"id":"20240611104442-7cqc7p3","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611104442-makvdpo","Type":"NodeParagraph","Properties":{"id":"20240611104442-makvdpo","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 含△1-四氢大麻酚（△1-tetrahydrocanna-binol），大麻色烯（cannabichromene），大麻萜酚（cannabigerol）[1]，大麻环酚（cannabicyvclol），△9-6α，10α-反-四氢大麻酚（△9-6α，10α-trans-tetahydrocannabinol）[2]，大麻酚酸（cannabinolic acid），△1-四氢大麻酚酸（△1-tetrahydrocannabinolic acid）B[3]，大麻萜酚酸（cannbigerolic acid），六氢次大麻呋酚酸（cannabidiolic acid）[4],次大麻酚（cannabidivarinic acid），大麻二酚酸（cannabidiolic acid）[4]，次大麻酚（cannabivarin），四氢次大麻酚（tetrahydrocan-nabivarn）[5]，次大麻色烯（cannabivarichromene）[6]，大麻二吡喃环烷（cannabicitran）[7]，大麻香豆酮（cannabicoumaronone）[8]，四氢二羟基大麻酚大麻二酚羧酸酯（tetrahydrocannabitriolcannabidiolcarboxylic acid ester）[9]；还含有7-羟基-5-甲氧基-1，2-二氢化茚-1-螺环六烷（7-hydroxy-5-甲氧基-1，2-二氢化茚-1-螺环六烷（7-hydroxy-5-methoxyindan-1-spiro-cy-clohexane），5，7-二羟基-1，2-二氢化茚-1-螺一环六烷（5，7-dihydroxyindan-1-spirocyclohe-xane）[10]，3，5，4′-三羟基联苄（3，5，4′-trihydroxybibe-nzyl）[11]."}]},{"ID":"20240611104442-vo7hdd4","Type":"NodeParagraph","Properties":{"id":"20240611104442-vo7hdd4","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611104442-oixaxu9","Type":"NodeParagraph","Properties":{"id":"20240611104442-oixaxu9","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 辛；性平；有毒"}]},{"ID":"20240611104442-36fcls1","Type":"NodeParagraph","Properties":{"id":"20240611104442-36fcls1","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611104442-sw70ghj","Type":"NodeParagraph","Properties":{"id":"20240611104442-sw70ghj","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 体虚及孕妇忌服。"}]},{"ID":"20240611104442-7xs5b0q","Type":"NodeParagraph","Properties":{"id":"20240611104442-7xs5b0q","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611104442-t7l1kyt","Type":"NodeParagraph","Properties":{"id":"20240611104442-t7l1kyt","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 祛风镇痛；定惊安神。。主痛风；痹证；癫狂；失眠；咳喘"}]},{"ID":"20240611104442-5q4ia3t","Type":"NodeParagraph","Properties":{"id":"20240611104442-5q4ia3t","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611104442-7opz646","Type":"NodeParagraph","Properties":{"id":"20240611104442-7opz646","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤,0.3-0.6g。外用：适量，捣敷。"}]},{"ID":"20240611104442-x81f9cg","Type":"NodeParagraph","Properties":{"id":"20240611104442-x81f9cg","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611104442-qxcxz3a","Type":"NodeParagraph","Properties":{"id":"20240611104442-qxcxz3a","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 1.《药物图考》：麻蕡有毒,臭气甚浓,人口嚼尝,先时无味,后则微辛而麻。《本经》主五劳七伤,利五脏,下血,其活血之功用可知矣。于贫血症当酌加黄芪(肺结核症禁黄芪)、当归、铁剂等药；若兼干嗽宜去黄蔑,加润肺之药；若偏枯痛风痹症,须与乌头、马钱子等药并施；如头痛宜佐芎藭、蔓荆子、羌活之类；若疗癫狂、花痴,须加茛菪等药：调经宜与当归、木香、羌活并用；肤痒宜佐蛇床子、石膏。大黄、虾螟草、芥穗等药。此药常服致瘾。"}]},{"ID":"20240611104442-52ufd26","Type":"NodeParagraph","Properties":{"id":"20240611104442-52ufd26","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"2.《本经》：主五劳七伤,利五脏,下血寒气。"}]},{"ID":"20240611104442-za1vhsc","Type":"NodeParagraph","Properties":{"id":"20240611104442-za1vhsc","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"3.《别录》：破积,止痹,散脓。"}]},{"ID":"20240611104442-x2dq1jc","Type":"NodeParagraph","Properties":{"id":"20240611104442-x2dq1jc","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：治身中伏风；同优钵罗花为麻药,砭痈肿不知痛。"}]},{"ID":"20240611104442-nciun5n","Type":"NodeParagraph","Properties":{"id":"20240611104442-nciun5n","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"4.《医林纂要》：和胃,润命门,祛风,利大肠,破瘀,通乳,下胎。"}]},{"ID":"20240611104442-7v4097v","Type":"NodeParagraph","Properties":{"id":"20240611104442-7v4097v","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"5.《药物图考》：主贫血于嗽,安抚神经,止抽搐,痛风,痹症,安眠,调经破瘀,子宫不复原,卵腺痛,癫狂,花痴,肤痒。"}]},{"ID":"20240611104442-3oc71yg","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611104442-3oc71yg","updated":"20240611104442"},"Children":[{"ID":"20240611104442-bjh2iu2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240611104442-bjh2iu2","updated":"20240611104442"},"Children":[{"ID":"20240611104442-1pfwmjl","Type":"NodeParagraph","Properties":{"id":"20240611104442-1pfwmjl","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"李承祜《生药学》：治躁狂,宿病,痉挛性咳嗽,喘息,神经痛。"}]}]}]},{"ID":"20240611104442-1bj3khg","Type":"NodeParagraph","Properties":{"id":"20240611104442-1bj3khg","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611104442-kuc8na2","Type":"NodeParagraph","Properties":{"id":"20240611104442-kuc8na2","updated":"20240611104442"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611104443-vh7534l","Type":"NodeThematicBreak","Properties":{"id":"20240611104443-vh7534l"}},{"ID":"20240611104445-r9i88mv","Type":"NodeParagraph","Properties":{"id":"20240611104445-r9i88mv"}}]}