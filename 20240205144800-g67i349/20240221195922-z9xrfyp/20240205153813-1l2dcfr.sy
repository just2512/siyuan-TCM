{"ID":"20240205153813-1l2dcfr","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153813-1l2dcfr","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153813-1l2dcfr\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206100441-hbhmil0\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611104551-67ep802\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240621140829-9oh99hm\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"137麻蕡（麻仁、麻子仁、火麻仁、大麻）","type":"doc","updated":"20240812162640"},"Children":[{"ID":"20240206100441-hbhmil0","Type":"NodeParagraph","Properties":{"id":"20240206100441-hbhmil0","updated":"20240206100445"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"火麻仁"}]},{"ID":"20240206100455-a90j52f","Type":"NodeParagraph","Properties":{"id":"20240206100455-a90j52f","updated":"20240206100458"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产黑龙江、辽宁、吉林、四川、甘肃、云南、江苏、浙江等地。\n【性状】\t本品呈卵圆形，长45.5mm，直径2.54mm。表面灰绿色或灰黄色，有微细的白色或棕色网纹，两边有棱，顶端略尖，基部有1圆形果梗痕。果皮薄而脆，易破碎。种皮绿色，子叶2，乳白色，富油性。气微，味淡。\n【性味】\t甘，平。\n【功效】\t润肠通便。用于血虚津亏，肠燥便秘。"}]},{"ID":"20240206100449-ajcsi06","Type":"NodeParagraph","Properties":{"id":"20240206100449-ajcsi06","updated":"20240812132020"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206100449-uqr6n2n.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621140829-9oh99hm","Type":"NodeParagraph","Properties":{"id":"20240621140829-9oh99hm","updated":"20240812131901"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206094145-88kcscm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240205160511-z4d51he","Type":"NodeParagraph","Properties":{"id":"20240205160511-z4d51he","updated":"20240812132034"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"火麻仁"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/火麻仁-20240205160511-h8k0dfp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812132459-55m31ba","Type":"NodeParagraph","Properties":{"id":"20240812132459-55m31ba","updated":"20240812133226"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 342px;","style":"width: 332px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麻蕡"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麻蕡-20240812132459-zi8kyta.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 332px;\" parent-style=\"width: 342px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 360px;","style":"width: 350px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麻蕡 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麻蕡 1-20240812132608-v3tapzs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 350px;\" parent-style=\"width: 360px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812133309-tz3rlm0","Type":"NodeParagraph","Properties":{"id":"20240812133309-tz3rlm0","updated":"20240812161703"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeIma