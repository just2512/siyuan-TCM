,"Properties":{"parent-style":"width: 618px;","style":"width: 608px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大黄 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大黄 8-20240822112505-1xg3dpg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 608px;\" parent-style=\"width: 618px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822112615-7965xxc","Type":"NodeParagraph","Properties":{"id":"20240822112615-7965xxc","updated":"20240822112808"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 653px;","style":"width: 643px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大黄 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大黄 9-20240822112615-q9sdp9a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 643px;\" parent-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 578px;","style":"width: 568px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大黄 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大黄 11-20240822112808-1yl4dvj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 568px;\" parent-style=\"width: 578px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822112831-j8eytqu","Type":"NodeParagraph","Properties":{"id":"20240822112831-j8eytqu","updated":"20240822112831"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 813px;","style":"width: 803px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大黄 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大黄 4-20240822112029-hooqqb5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 803px;\" parent-style=\"width: 813px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 362px;","style":"width: 352px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大黄 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大黄 3-20240822111925-20b2ico.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 352px;\" parent-style=\"width: 362px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822113144-9nbegt4","Type":"NodeParagraph","Properties":{"id":"20240822113144-9nbegt4","updated":"20240822113153"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图未按品种分类；"}]},{"ID":"20240612171504-o4un0ba","Type":"NodeThematicBreak","Properties":{"id":"20240612171504-o4un0ba"}},{"ID":"20240612171741-klib2b8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171741-klib2b8","updated":"20240612171745"},"Children":[{"Type":"NodeText","Data":"大黄《神农本草经》"}]},{"ID":"20240612171741-g2ikd4n","Type":"NodeParagraph","Properties":{"id":"20240612171741-g2ikd4n","updated":"20240612171741"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240612171741-npjk34q","Type":"NodeParagraph","Properties":{"id":"20240612171741-npjk34q","updated":"20240612171741"},"Children":[{"Type":"NodeText","Data":"主下淤血，血闭，寒热，破症瘕积聚，留饮，宿食，荡涤肠胃，推陈致新，通利水杀（《御览》，此下有道字），调中化食，安和五脏。生山谷。"}]},{"ID":"20240612171741-4el0yz7","Type":"NodeParagraph","Properties":{"id":"20240612171741-4el0yz7","updated":"20240612171741"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：大黄一名黄良，一名火参，一名肤如，神农雷公苦有毒，扁鹊苦无毒，李氏小寒，为中将军，或生蜀郡，北部，或陇西，二月花生，生黄赤叶，四四相当，黄茎高三尺许，三月华黄，五月实黑，三月采根，根有黄汁，切，阴干。（《御览》）"}]},{"ID":"20240612171741-3l82e8z","Type":"NodeParagraph","Properties":{"id":"20240612171741-3l82e8z","updated":"20240612171741"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名黄良，生河西及陇西，二月八月采根，火干。"}]},{"ID":"20240612171741-ppi18uz","Type":"NodeParagraph","Properties":{"id":"20240612171741-ppi18uz","updated":"20240612171741"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：黄良大黄也。"}]},{"ID":"20240612171752-1fc7kqb","Type":"NodeThematicBreak","Properties":{"id":"20240612171752-1fc7kqb"}},{"ID":"20240612171753-k2w1sct","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171753-k2w1sct","updated":"20240612171757"},"Children":[{"Type":"NodeText","Data":"大黄《本草备要》"}]},{"ID":"20240612171753-pt5lyaz","Type":"NodeParagraph","Properties":{"id":"20240612171753-pt5lyaz","updated":"20240612171753"},"Children":[{"Type":"NodeText","Data":"大泻血分湿热，下有形积滞"}]},{"ID":"20240612171753-ahnbz5b","Type":"NodeParagraph","Properties":{"id":"20240612171753-ahnbz5b","updated":"20240612171753"},"Children":[{"Type":"NodeText","Data":"大苦大寒。入足太阴（脾），手足阳明、厥阴（大肠、胃、心包、肝）血分。其性浮而不沉，其用走而不守。若酒浸，亦能引至高之分（仲景太阳门调胃承气汤，大黄注曰酒浸；阳明门大承气汤，大黄注曰酒洗；少阳阳明小承气汤，大黄不用酒制，皆有分别。东垣曰∶邪气在上，非酒不至。若用生者，则遗至高之邪热。病愈后，或目赤、喉痹、头痛、膈上热疾生也）。用以荡涤肠胃，下燥结而除瘀热。"}]},{"ID":"20240612171753-9qpflsp","Type":"NodeParagraph","Properties":{"id":"20240612171753-9qpflsp","updated":"20240612171753"},"Children":[{"Type":"NodeText","Data":"治伤寒时疾，发热谵语（大肠有燥粪，故谵语，宜下之。谵，音占），温热瘴疟，下痢赤白，腹痛里急，黄胆水肿，症瘕积聚（积久成形谓之积，属阴；聚散无常谓之聚，属阳。"}]},{"ID":"20240612171753-caa3x7m","Type":"NodeParagraph","Properties":{"id":"20240612171753-caa3x7m","updated":"20240612171753"},"Children":[{"Type":"NodeText","Data":"积多是血或食或痰，聚多是气），留饮宿食，心腹痞满，二便不通（皆土郁，夺之），吐血衄血，血闭血枯，损伤积血，一切实热，血中伏火。行水除痰，蚀脓消肿，能推陈致新。然伤元气而耗阴血（下多亡阴），若病在气分，胃虚、血弱人禁用（病在气分而用之，是为诛伐无过。东垣曰∶能推陈致新，如定祸乱以致太平，所以有将军之号。时珍曰∶仲景泻心汤，治心气不足吐衄血者，用大黄。黄连、黄芩，乃泻心包、肝、脾、胃四经血中之伏火也。又治心下痞满按之软者，用大黄、黄连泻心汤，亦泻脾胃之湿热，非泻心也。病发于阴，而反下之，则痞满。乃寒伤营血，邪结上焦，胃之上脘当心，故曰泻心。经曰∶太阴所至，为痞满。又曰∶浊气在上，则生 胀是已。病发于阳，而反下之，则结胸。乃热邪陷入血分，亦在上脘，故大陷胸汤、丸皆用大黄，亦泻脾胃血分之邪，而降其浊气也。若结胸在气分，只用小陷胸汤；痞满在气分，只用半夏泻心汤。或问心气不足而吐衄，何以不补心而反泻心？"}]},{"ID":"20240612171753-ewa6anr","Type":"NodeParagraph","Properties":{"id":"20240612171753-ewa6anr","updated":"20240612171753"},"Children":[{"Type":"NodeText","Data":"丹溪曰∶少阴不足，亢阳无辅，致阴血妄行，故用大黄泻其亢甚之火。又心本不足，肝、肺各受火邪而病作，故用黄芩救肺、黄连救肝。肺者阴之主，肝者心之母，血之合也，肺、肝火退，则血归经而自安矣。寇宗 曰∶以苦泄其热，就以苦补其心，盖一举而两得之。李士材曰∶古人用大黄治虚劳吐衄，意甚深微。盖浊阴不降，则清阳不生，瘀血不去，则新血不生也）。"}]},{"ID":"20240612171753-wf9sq73","Type":"NodeParagraph","Properties":{"id":"20240612171753-wf9sq73","updated":"20240612171753"},"Children":[{"Type":"NodeText","Data":"川产锦纹者良。有酒浸、酒蒸、生、熟之不同。生用更峻。黄芩为使（欲取通利者，不得骤进谷食，大黄得谷食，便不能通利耳。《夷坚志》∶汤，火伤者，捣生大黄，醋调敷，止痛无瘢）。"}]},{"ID":"20240612171516-ru45i2i","Type":"NodeThematicBreak","Properties":{"id":"20240612171516-ru45i2i"}},{"ID":"20240612171712-grl2s0a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171712-grl2s0a","updated":"20240612171716"},"Children":[{"Type":"NodeText","Data":"大黄《本草衍义》"}]},{"ID":"20240612171712-b3y2ojm","Type":"NodeParagraph","Properties":{"id":"20240612171712-b3y2ojm","updated":"20240612171712"},"Children":[{"Type":"NodeText","Data":"大黄损益，前书已具。仲景治心气不足、吐血、衄血。泻心汤用大黄、黄芩、黄连。"}]},{"ID":"20240612171712-hbxqio5","Type":"NodeParagraph","Properties":{"id":"20240612171712-hbxqio5","updated":"20240612171712"},"Children":[{"Type":"NodeText","Data":"或曰∶心气既不足矣，而不用补心汤，更用泻心汤，何也？答曰∶若心气独不足，则不当须吐衄也。此乃邪热，因不足而客之，故吐衄。以苦泄其热，就以苦补其心，盖两全之。有是证者，用之无不效。量虚实用药。"}]},{"ID":"20240612171607-r9u766m","Type":"NodeThematicBreak","Properties":{"id":"20240612171607-r9u766m"}},{"ID":"20240612171649-yuupykf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171649-yuupykf","updated":"20240612171656"},"Children":[{"Type":"NodeText","Data":"大黄《长沙药解》"}]},{"ID":"20240612171649-wmdc9x9","Type":"NodeParagraph","Properties":{"id":"20240612171649-wmdc9x9","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主下淤血，血闭，寒热，破癥瘕积聚，留饮，宿食，荡涤肠胃，推陈致新，通利水杀，调中化食，安和五脏。生山谷。"}]},{"ID":"20240612171649-xgzlqbd","Type":"NodeParagraph","Properties":{"id":"20240612171649-xgzlqbd","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"味苦，性寒，入足阳明胃、足太阴脾、足厥阴肝经。泻热行瘀，决壅开塞，下阳明治燥结，除太阴之湿蒸，通经脉而破癥瘕，消痈疽而排脓血。"}]},{"ID":"20240612171649-zoj32jy","Type":"NodeParagraph","Properties":{"id":"20240612171649-zoj32jy","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大承气汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄四两，芒硝三两，枳实五枚，厚朴半斤。"},{"Type":"NodeText","Data":"治阳明病，胃热便难。以表病失解，郁其胃阳。阳莫盛于阳明，阳明戊土，从燥金化气，阳旺土燥，肠窍结涩，腑热莫宣，故谵语潮热，手足汗流。胃气壅遏，不得下泄，故脐腹满痛。大黄、芒硝，破结而泻热，厚朴、枳实，降逆而消滞也。"}]},{"ID":"20240612171649-wxtr8f2","Type":"NodeParagraph","Properties":{"id":"20240612171649-wxtr8f2","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小承气汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄四两，厚朴二两，枳实三枚。"},{"Type":"NodeText","Data":"治阳明病，腑热方作。大黄泻其燥热，朴、枳开其郁滞也。"}]},{"ID":"20240612171649-fcy4eou","Type":"NodeParagraph","Properties":{"id":"20240612171649-fcy4eou","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大陷胸汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄六两，芒硝一斤，甘遂一钱。水六升，煮大黄，取二升，去渣，入芒硝，煎化，入甘遂末，分服。"},{"Type":"NodeText","Data":"治太阳中风，下早而为结胸。以腑热未实，下之太早，伤其中气。戊土不降，里阴上逆，皮毛未泄，表阳亦陷，阴阳拒隔，结于胸中。寒热逼蒸，化生水气，硬满疼痛，烦躁懊憹。硝、黄泻其郁热，甘遂排其水饮也。"}]},{"ID":"20240612171649-ss2cgnp","Type":"NodeParagraph","Properties":{"id":"20240612171649-ss2cgnp","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大陷胸丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄半斤，芒硝半斤，葶苈半斤，杏仁半升。共末之，入芒硝，研如脂。丸如弹子大，取一枚，甘遂末一钱，白蜜二合，水二升，煮一升，温顿服之。一宿乃下。不下更服。"},{"Type":"NodeText","Data":"治结胸项强，状如柔痉。以湿热熏冲，上连颈项。大黄、芒硝，破结而泻热，杏仁、葶苈、甘遂，降逆而泻水也。"}]},{"ID":"20240612171649-sg90961","Type":"NodeParagraph","Properties":{"id":"20240612171649-sg90961","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄黄连泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄二两，黄连一两。麻沸汤一升渍之，去渣，分温服。"},{"Type":"NodeText","Data":"治伤寒下后复汗，心下痞硬，以汗下伤其中气，阳亡土败，胃气上逆，阻碍胆经降路，结于心下，痞塞硬满。相火既隔，君火亦升，大黄泻戊土而清热，黄连泻心火而除烦也。"}]},{"ID":"20240612171649-aikzxx4","Type":"NodeParagraph","Properties":{"id":"20240612171649-aikzxx4","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝加大黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"桂枝三两，甘草二两，生姜三两，大枣十二枚，芍药六两，大黄一两。"},{"Type":"NodeText","Data":"治太阳病，医反下之，因而腹满实痛，属太阴者。以太阳表病，误下而伤脾气，脾陷木遏，郁生风热，侵克己土，胀满而成实痛。桂枝和中而解表，芍药滋乙木而清风，大黄泻己土而消满也。"}]},{"ID":"20240612171649-fh5w5e2","Type":"NodeParagraph","Properties":{"id":"20240612171649-fh5w5e2","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄硝石汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄、硝石、黄柏各四两，栀子十五枚，水煎，顿服。"},{"Type":"NodeText","Data":"治黄疸腹满，自汗，小便不利而赤。以黄家湿淫经络，皮毛莫启，是以发黄。今汗孔外泄，水道里郁，表和里实，湿不在经络而在脏腑。法当用下，大黄、黄柏，泻其瘀热，硝石、栀子，清其湿热也。"}]},{"ID":"20240612171649-bxrdbb3","Type":"NodeParagraph","Properties":{"id":"20240612171649-bxrdbb3","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苓甘五味姜辛半杏加大黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"茯苓四两，甘草三两，五味半升，干姜三两，细辛三两，半夏半升，杏仁半升，大黄三两。"},{"Type":"NodeText","Data":"治痰饮，水去呕止，肿消痹愈，而面热如醉者。痰饮服半夏而水去，服杏仁而肿消，若面热如醉，是胃热逆冲，上熏其面。缘足之三阳，自头走足，阳明行身之前，自面而下，加大黄以泻阳明之热也。"}]},{"ID":"20240612171649-fmo0sbm","Type":"NodeParagraph","Properties":{"id":"20240612171649-fmo0sbm","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄附子汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄三两，细辛二两，附子三枚。炮用。"},{"Type":"NodeText","Data":"治胁下偏痛，发热，其脉紧弦。以脾土寒湿，郁其肝气，风木抑遏，故胁痛而发热，脉弦而且紧。宜以温药下其结寒，辛、附温寒而破瘀，大黄下积而开结也。"}]},{"ID":"20240612171649-q3n352v","Type":"NodeParagraph","Properties":{"id":"20240612171649-q3n352v","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄甘草汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄一两，甘草一两。"},{"Type":"NodeText","Data":"治食已即吐者。以土弱胃逆，浊气痞塞，郁生上热，故水谷不下。大黄破其痞塞，甘草培土补中，缓其下行之急也。"}]},{"ID":"20240612171649-duhtwdz","Type":"NodeParagraph","Properties":{"id":"20240612171649-duhtwdz","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"抵挡汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄三两，桃仁、水蛭、虻虫各三十枚。水煎，分三服。"},{"Type":"NodeText","Data":"治伤寒六七日后，表证犹在，脉微而沉，热在下焦，其人发狂，小腹硬满，小便自利者。以表病失解，经热莫达，内传膀胱之腑，血室瘀蒸，是以发狂。宜先解其表寒而后下其瘀血，桃、蛭、虻虫，破其瘀血，大黄泻其郁蒸也。"}]},{"ID":"20240612171649-mzox416","Type":"NodeParagraph","Properties":{"id":"20240612171649-mzox416","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄（庶/虫）虫丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄十分，甘草三两，杏仁一升，芍药四两，干地黄十两，桃仁一升，干漆一两，虻虫一升，水蛭百枚，蛴螬半升，（庶/虫）虫半升，黄芩三两。蜜丸，小豆大。酒饮服五丸，日三服。"},{"Type":"NodeText","Data":"治五劳"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"义详《素问·宣明五气篇》中。"},{"Type":"NodeText","Data":"七伤，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"义详《金匮·血痹虚劳》。"},{"Type":"NodeText","Data":"羸瘦腹满，内有干血，肌肤甲错，两目黯黑。以中气劳伤，己土湿陷，风木抑遏，贼伤脾气。脾气堙郁，不能腐热水谷，化生肌肉，故羸瘦而腹满。肝藏血而窍于目，肝气抑遏，营血凝涩，无以荣华皮腠，故肌肤甲错而两目黯黑。甘草培土而缓中，杏仁行滞而泻满，桃仁、干漆、虻虫、水蛭、蛴螬、（庶/虫）虫，破郁而消癥，芍药、地黄，清风木而滋营血，黄芩、大黄、泻相火而下结块也。"}]},{"ID":"20240612171649-hk3zbx8","Type":"NodeParagraph","Properties":{"id":"20240612171649-hk3zbx8","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"下瘀血汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄三两，桃仁二十枚，（庶/虫）虫二十枚。炼蜜为四丸，酒一升，煮一丸。取八合，顿服之。瘀血下如豚肝。亦主经水不利。"},{"Type":"NodeText","Data":"治产后腹痛，中有瘀血，着于脐下者。以瘀血在腹，木郁为痛。桃仁、（庶/虫）虫，破其瘀血，大黄下其癥块也。"}]},{"ID":"20240612171649-5p7uyfv","Type":"NodeParagraph","Properties":{"id":"20240612171649-5p7uyfv","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄甘遂汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄二两，甘遂二两，阿胶二两。煮一升，顿服之，其血当下。"},{"Type":"NodeText","Data":"治产后水与血结在血室，小腹胀满，小便微难而不渴者。以水寒湿旺，乙木抑遏，水瘀血结，不得通达，故腹胀满，便难而不渴。阿胶清风而润木，大黄、甘遂，下瘀血而行积水也。"}]},{"ID":"20240612171649-pwnn1px","Type":"NodeParagraph","Properties":{"id":"20240612171649-pwnn1px","updated":"20240612171649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄牡丹皮汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"大黄四两，芒硝四合，瓜子半升，桃仁五十枚，牡丹皮一两。煎一升，入芒硝，煎化，顿服之。有脓当下，无脓下血。"},{"Type":"NodeText","Data":"治肠痈，少腹肿痞，按之痛如淋，小便调，自汗出，时时发热，复恶寒，脓已成，其脉洪数者。以湿寒隔碍，气血不行，臃肿而为痈疽。营卫郁遏，外寒内热，郁热淫蒸，故肉腐为脓。脓之未成，气血壅塞，则脉见迟紧，脓成结消，气血通达，故见洪数。未脓可下，脓成宜排。丹皮、桃仁、瓜子，排决其脓血，大黄、芒硝，寒泻其燔蒸也。"}]},{"ID":"20240612171649-popffej","Type":"NodeParagraph","Properties":{"id":"20240612171649-popffej","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"大黄苦寒迅利，泻热开瘀，决壅塞而通结闭，扫腐败而荡郁陈。一切宿食留饮，老血积痰，得之即下，心痞腹胀，胃结肠阻，饮之即通。湿热瘀蒸，非此不除，关窍梗塞，非此不开。荡涤肠胃之力，莫与为比，下痢家之停滞甚捷。"}]},{"ID":"20240612171649-52kowsq","Type":"NodeParagraph","Properties":{"id":"20240612171649-52kowsq","updated":"20240612171649"},"Children":[{"Type":"NodeText","Data":"酒浸用。"}]},{"ID":"20240612171607-fdiy0li","Type":"NodeThematicBreak","Properties":{"id":"20240612171607-fdiy0li"}},{"ID":"20240612171631-a9wv1jv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171631-a9wv1jv","updated":"20240612171642"},"Children":[{"Type":"NodeText","Data":"大黄《证类本草》"}]},{"ID":"20240612171631-on7turo","Type":"NodeParagraph","Properties":{"id":"20240612171631-on7turo","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"味苦，寒、大寒。无毒。主下瘀血，血闭，寒热，破症瘕积聚，留饮宿食，荡涤肠胃，推陈致新，通利水谷，调中化食，安和五脏，平胃下气，除痰实，肠间结热，心腹胀满，女子寒血闭胀，小腹痛，诸老血留结。一名黄良。生河西山谷及陇西。二月、八月采根，火干。（得芍药、黄芩、牡蛎、细辛、茯芩疗惊恚怒，心下悸气。得硝石、紫石英、桃仁疗女子血闭。黄芩为之使，无所畏。）"}]},{"ID":"20240612171631-7hcxjbm","Type":"NodeParagraph","Properties":{"id":"20240612171631-7hcxjbm","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今采益州北部汶山及西山者，虽非河西、陇西，好者犹为紫地锦色，味甚苦涩，色至浓黑。西川阴干者胜。北部日干，亦有火干者，皮小焦不如，而耐蛀堪久。此药至劲利，粗者便不中服，最为俗方所重。道家时用以去痰疾，非养性所须也。将军之号，当取其骏快矣。唐本注云∶大黄，性湿润而易坏蛀，火干乃佳。二月、八月日不烈，恐不时燥，即不堪矣。叶、子、茎并似羊蹄，但粗长而浓。其根细者亦似宿羊蹄，大者乃如碗，长二尺。作时烧石使热，横寸截，着石上爆之，一日微燥，乃绳穿眼之，至干为佳。幽、并已此渐细，气力不如蜀中者。今出宕州、凉州、西羌、蜀地皆有。其茎味酸，堪生啖。亦以解热，多食不利人。陶称蜀地者不及陇西，误矣。今按∶陈藏器本草云∶大黄，用之当分别其力。若取和浓深沉，能攻病者，可用蜀中似牛舌片紧硬者。若取泻泄骏快，推陈去热，当取河西锦纹者。凡有蒸、有生、有熟，不得一概用之。臣禹锡等谨按蜀本云∶叶似蓖麻。根如大芋。旁生细根如牛蒡，小者亦似羊蹄。又云《图经》云∶高六、七尺，茎脆。药性论云∶蜀大黄，使，去寒热，忌冷水，味苦、甘。消食，炼五脏，通女子经候，利水肿，能破痰实，冷热，结聚宿食，利大小肠，贴热毒肿，主小儿寒热时疾，烦热蚀浓，破留血。日华子云∶通宣一切气，调血脉，利关节，泄壅滞水气，四肢冷热不调，温瘴热疾，利大小便。并敷一切疮疖痈毒。廓州马蹄峡中者次。"}]},{"ID":"20240612171631-ayshx8v","Type":"NodeParagraph","Properties":{"id":"20240612171631-ayshx8v","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"图经曰∶大黄，生河西山谷及陇西，今蜀川、河东、陕西州郡皆有之，以蜀川锦文者佳。"}]},{"ID":"20240612171631-efht7uh","Type":"NodeParagraph","Properties":{"id":"20240612171631-efht7uh","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"其次秦陇来者，谓之土蕃大黄。正月内生青叶，似蓖麻，大者如扇。根如芋，大者如碗，长一、二尺。旁生细根如牛蒡，小者亦如芋。四月开黄花，亦有青红似荞麦花者。茎青紫色，形如竹。二月、八月采根，去黑皮，火干。江淮出者曰土大黄，二月开花结细实。又鼎州出一种羊蹄大黄，疗疥瘙甚效。初生苗叶如羊蹄，累年长大，即叶似商陆而狭尖。四月内于押条上出穗，五、七茎相合，花、叶同色。结实如荞麦而轻小，五月熟即黄色，亦呼为金荞麦。"}]},{"ID":"20240612171631-xu4r0dl","Type":"NodeParagraph","Properties":{"id":"20240612171631-xu4r0dl","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"三月采苗，五月收实，并阴干。九月采根，破之亦有锦文，日干之。亦呼为土大黄。凡收大黄之法，苏恭云∶作时烧石使热，横寸截，着石上爆之，一日微燥，乃绳穿眼之至干。今土蕃大黄，往往作横片，曾经火爆。蜀大黄乃作紧片如牛舌形，谓之牛舌大黄。二者用之皆等。《本经》称∶大黄推陈致新，其效最神。故古方下积滞多用之。张仲景治伤寒，用处尤多。"}]},{"ID":"20240612171631-g5fzqq8","Type":"NodeParagraph","Properties":{"id":"20240612171631-g5fzqq8","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"又有三物备急丸。司空裴秀为散，用疗心腹诸疾，卒暴百病。其方用大黄、干姜、巴豆各一两，须精新好者，捣筛，蜜和，更捣一千杵，丸如小豆，服三丸，老小斟量之。为散不及丸也。若中恶客忤，心腹胀满，卒痛如锥刀刺痛，气急口噤，停尸卒死者，以暖水若酒服之。"}]},{"ID":"20240612171631-55eng1m","Type":"NodeParagraph","Properties":{"id":"20240612171631-55eng1m","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"若不下，捧头起灌令下喉，须臾瘥。未知，更与三丸，腹当鸣转，即吐下，便愈。若口已噤，亦须折齿灌之，药入喉即瘥。崔知悌疗小儿无辜闪癖，瘰 ，或头干黄耸，或乍痢乍瘥，诸状多者，皆大黄煎主之。大黄九两，锦文新实者，若微朽即不中用，削去苍皮乃秤，捣筛为散。以上好米醋三升和之，置铜碗中，于大铛中浮汤上，炭火煮之，火不用猛，又以竹木篦搅药候任丸乃停，于小瓷器中贮。儿年三岁一服七丸，如梧子，日再服，当以下青赤脓为度。若不下脓，或下脓少者，稍稍加丸。下脓若多，丸又须减。病重者或七、八剂方尽根本。大人、小儿，以意量之。此药唯下脓宿结，不令儿利。须禁食毒物。食乳者、乳母亦同忌法。崔元亮《海上方》∶治腰脚冷风气。"}]},{"ID":"20240612171631-qxlb8wp","Type":"NodeParagraph","Properties":{"id":"20240612171631-qxlb8wp","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"以大黄二大两，切如棋子，和少酥炒令酥，尽入药中，切不得令黄焦则无力，捣筛为末，每日空腹以水大三合，入生姜两片如钱，煎十余沸去姜，取大黄末两钱，别置碗子中，以姜汤调之，空腹顿服。如有余姜汤，徐徐呷之令尽，当下冷脓及恶物等，病即瘥止。古人用毒药攻病，必随人之虚实而处置，非一切而用也。姚僧垣初仕，梁武帝因发热欲服大黄。僧垣曰∶大黄乃是快药，至尊年高，不可轻用。帝弗从，几至委顿。元帝常有心腹疾，诸医咸谓宜用平药，可渐宣通。僧垣曰∶脉洪而实，此有宿妨，非用大黄无差理。帝从而遂愈。以此言之，今医用一毒药而攻众病，其偶中病，便谓此方之神奇；其差误，乃不言用药之失，如此者众矣，可不戒哉？"}]},{"ID":"20240612171631-vjg8wpy","Type":"NodeParagraph","Properties":{"id":"20240612171631-vjg8wpy","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"唐本云∶叶似蓖麻，根如大芋，旁生细根如牛蒡。《图经》云∶高六、七尺，茎脆味酸，醒酒未至亥．，如此蒸七度。晒干，却洒薄蜜水再蒸一伏时，其大黄擘如乌膏样。于日中晒干用之为妙。"}]},{"ID":"20240612171631-woad939","Type":"NodeParagraph","Properties":{"id":"20240612171631-woad939","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治时气发豌豆疮。用川大黄半两微炒，以水一大盏煎至七分，去滓，分为二服。又方∶热病狂语及诸黄。用川大黄五两锉炒微赤，捣为散，用腊月雪水五升煎如膏，每服不计时候，冷水调下半匙。外台秘要∶疗癖方∶大黄十两，杵筛，醋三升，和匀，白蜜两匙煎，堪丸如梧桐子大。一服三十丸，生姜汤吞下以利为度，小者减之。千金方∶治产后恶血冲心，或胎衣不下，腹中血块等。用锦纹大黄一两，杵罗为末，用头醋半升同熬成膏，丸如梧桐子大。患者用温醋七分盏化五丸，服之，良久下。亦治马坠内损。千金翼治妇人血癖痛。大黄三两捣筛，以酒二升，煮十沸，顿服。经验后方∶解风热疏积热风壅，消食，化气导血，大解壅滞。大黄四两，牵牛子四两，半生半熟，为末，炼蜜丸如梧子大。每服茶下一十丸，如要微动，吃十五丸。冬月中最宜服，并不搜搅人。梅师方∶治卒外肾偏肿疼痛。大黄末和醋涂之，干即易之。斗门方治腰痛。用大黄半两，更入生姜半两，同切如小豆大，于铛内炒令黄色，投水两碗，至五更初顿服，天明取下。腰间恶血物用盆器盛如鸡肝样，即痛止。简要济众∶治吐血。川大黄一两，捣罗为散。每服一钱。以生地黄汁一合，水半盏煎三、五沸，无时服。广利方∶治骨节热，积渐黄瘦。大黄四分，以童子小便五大合，煎取四合，去滓，空腹分为两服，如人行四、五里再服。伤寒类要∶疗急黄病。"}]},{"ID":"20240612171631-l7abz01","Type":"NodeParagraph","Properties":{"id":"20240612171631-l7abz01","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"大黄粗切二两，水三升半渍一宿，平旦煎绞汁一升半，纳芒硝二两绞服。须臾当快利。姚和众治小儿脑热常闭目。大黄一分粗锉，以水三合浸一宿，一岁儿每日与半合，服余者涂顶上，干即更涂。别说云谨按大黄收采时，皆以火烧石爆干。欲速货卖，更无生者，用之不须更多炮炙，少蒸煮之类也。"}]},{"ID":"20240612171631-5q236uj","Type":"NodeParagraph","Properties":{"id":"20240612171631-5q236uj","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"衍义曰∶大黄，损益，前书已具。仲景治心气不足，吐血、衄血。泻心汤用大黄、黄芩、黄连。"}]},{"ID":"20240612171631-vke3q6v","Type":"NodeParagraph","Properties":{"id":"20240612171631-vke3q6v","updated":"20240612171631"},"Children":[{"Type":"NodeText","Data":"当须吐衄也。此乃邪热，因不足而客之，故吐衄。以苦泄其热，就以若补其心，盖两全之。有是证者用之无不效。最虚实用药。"}]},{"ID":"20240612171607-mxpexco","Type":"NodeThematicBreak","Properties":{"id":"20240612171607-mxpexco"}},{"ID":"20240612171609-7it7dgs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171609-7it7dgs","updated":"20240612171612"},"Children":[{"Type":"NodeText","Data":"大黄《本草思辨录》"}]},{"ID":"20240612171609-olexb8o","Type":"NodeParagraph","Properties":{"id":"20240612171609-olexb8o","updated":"20240612171609"},"Children":[{"Type":"NodeText","Data":"邹氏以大黄黄中通理，状如锦纹，质色深紫，为火贯土中，极服卢芷园行火用一语。窃思卢氏论素问承制生化之义固精，但浅学不易领悟。夫大黄火贯土中，或当能扶脾阳矣，然此其质耳。味则大苦，气则大寒，且于黄色中贯赤纹，则于脾中血分锢土之火，自当之辄息，锢土之火息，而心君生土之火，岂有不因之而行其用，此所以行君令戡祸乱拓土地而有将军之号也。"}]},{"ID":"20240612171609-w9ryltj","Type":"NodeParagraph","Properties":{"id":"20240612171609-w9ryltj","updated":"20240612171609"},"Children":[{"Type":"NodeText","Data":"大黄色黄臭香，性与土比，故用于脾胃病极合。其能行火用上下表里咸到，则人多忽之，然有一言可以蔽之者，曰荡实涤热而已。热与实兼者，如大小承气汤下燥屎，大陷胸汤丸治结胸，抵当汤丸下瘀血，大黄附子汤治胁下偏痛；其但热不实者，如苓甘五味加姜辛半杏大黄汤治面热如醉，茵陈蒿汤治谷疸，泻心汤治心气不足；此二者之显有区别者。推是以求，则如鳖甲煎丸治症瘕，大黄 虫丸治虚劳羸瘦，大黄牡丹汤治肠痈，大黄黄连泻心汤治气痞，非热实而同于热实，亦惟假荡涤之性功，扩神奇之妙用。而仲圣制剂之道，抑更有进者焉。己椒苈黄丸，曰肠间有水气。水者虚软之物，大黄能荡实不能捣虚，且泻水已有己椒葶苈，更益以大黄何为？或谓泄血闭而下热，或谓从大便而分消，皆意为揣摩，未足征信。独近人唐容川云∶三焦者，决渎之官，水道出焉。三焦即膈膜油网，水从胃中四面微窍渗入油网，从油网入膀胱。若水走肠间则为停水，水停而不行于三焦，则水不化气而津不生，是以口舌干燥。治法宜将未入肠间之水，引之走三焦故道；既停肠间之水，从肠间而下夺。此据西医油网之说，征以内经三焦，核之是证是方，无不吻合，实胜旧解。盖防己纹如车辐，内黄外白，有从脾肺斡旋三焦水道之能；椒目温肾以蒸发其脾阳，除腹满而利水，犹肾气丸之有附桂，如是而三焦之故道可复矣。肠间之水，将遂施大黄以下夺乎，抑未也？夫大肠者糟粕所居，大肠有水，下即与糟粕俱下，虽非燥屎，大黄固与有责；特其所司全在肠胃，力不及肺。肺合大肠，非肺出治节，不能使水食俱下。葶苈为从肺至脾之药（本邹氏疏证），利水道兼破积聚，故加之以辅大黄之不逮。且椒得大黄，庶寒温相济，而肠胃之疾，亦必火用行而后夫大黄之为物有定，而用大黄之法无定。不得仲圣之法，则大黄不得尽其才而负大黄实多，否则为大黄所误而大黄之被诬亦多。素问至真要大论，论制方之法甚备。而其间缓急奇偶，复极之气味浓薄、制小、制大、数少、数多，参伍而错综之，实有无穷之用。仲圣则正本此旨以制方，而不容以一端测焉。大黄气味俱浓，本峻下之物，因其峻下而微变其性以用之，则如大承气抵当汤之大黄酒洗酒浸，以兼除太阳余邪也；大黄黄连泻心汤之大黄，以麻沸汤渍之而不煮，欲其留恋心下也；大黄附子汤大黄与附子并用，则变寒下为温下；茵陈蒿汤大黄与茵陈栀子并用，则不走大便而走小便；大黄用法之不同也如是。更以方剂言之，尤氏谓小承气无芒硝而但有枳朴，下趋之势缓，故曰小。不知小承气虽有枳朴无芒硝，而枳朴分两亦较大承气甚少，此制之大小，即承气大小所由名，岂在芒硝有无之别。且芒硝并不专取其下趋，调胃承气芒硝与甘草并用，则能调胃，大陷胸芒硝与甘遂并用，则能陷胸；大承气芒硝只三合，而调胃承气大陷胸转用至半升一升；调胃陷胸有芒硝，而抵当汤丸转无芒硝；芒硝之功，不专在下趋亦明矣。柯韵伯谓药之生者，气锐而先行，熟者气纯而和缓，故大承气以芒硝专化燥屎，大黄继通地道，而后枳朴除其痞满。邹氏韪之，其实似是而非也。芒硝之不取乎速下，上已言之。夫多煮者味浓，少煮者味薄；味浓则下之早，味薄则下之迟。枳朴先煮，欲其径下；消黄则兼资以涤热，非故操之不可。故大黄后纳，芒硝只一两沸。小承气所以同煮者，枳朴既少，又无芒硝。且大承气以水一斗煮枳朴取五升，纳大黄后尚取二升；小承气则仅水四升煮取一升二合，大黄虽与枳朴同煮，力亦不浓，何必再分先后。邹氏谓大陷胸汤用甘遂芒硝之锐，犹恐其暂通复闭，故大黄先煮，使当善后之任。置全方配合之道不讲，而但于先后煮讨消息。不知芒硝甘遂，专治胸间热结水结，故芒硝只一两沸，甘遂内末而不煮；大黄本肠胃药，用以为消遂前驱，故先煮之。邹氏又谓茵陈蒿汤，大黄栀子为前茅，茵陈为后劲。不知茵陈发扬芳郁，禀太阳寒水之气，善解肌表之湿热，欲其驱邪由小便而去，必得多煮以浓其力。与桂枝利小便非多用不可，正复相同。大黄只二两而又后煮，则与茵陈走肌表之气相浃，且能促之使下也。茵陈栀子皆走小便，大黄自亦不走大便矣。"}]},{"ID":"20240612171516-9vl31hl","Type":"NodeThematicBreak","Properties":{"id":"20240612171516-9vl31hl"}},{"ID":"20240612171531-na2vqcu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171531-na2vqcu","updated":"20240612171535"},"Children":[{"Type":"NodeText","Data":"大黄《本草从新》"}]},{"ID":"20240612171531-q4w0t86","Type":"NodeParagraph","Properties":{"id":"20240612171531-q4w0t86","updated":"20240612171531"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大泻血分、实热、下有形积滞．"}]},{"ID":"20240612171531-sxb6tye","Type":"NodeParagraph","Properties":{"id":"20240612171531-sxb6tye","updated":"20240612171531"},"Children":[{"Type":"NodeText","Data":"大苦大寒．入足太阴（脾）、手足阳明、厥阴（大肠、胃、心包、肝．）血分．其性沉而不浮．"}]},{"ID":"20240612171531-9tue0i9","Type":"NodeParagraph","Properties":{"id":"20240612171531-9tue0i9","updated":"20240612171531"},"Children":[{"Type":"NodeText","Data":"其用走而不守．若酒浸．亦能引至至高之分．（仲景太阳门调胃承气汤、大黄注曰∶酒浸、阳明门大承气汤、大黄注曰∶酒洗、少阳阳明小承气汤、大黄不用酒制、皆有分别、东垣曰、邪气在上、非酒不至、若用生者、则遗至高之邪热、病愈后、或目赤喉痹、头肿、膈上热疾生也．）用以荡涤肠胃．下燥结而除瘀热．治伤寒时疾．发热谵语．（大肠有燥粪、故谵语、宜下之．）温热瘴疟．下痢赤白．腹痛里急．黄胆水肿．症瘕积聚．（积久成形谓之积、属阴、聚散无常谓之聚、属阳、积多是血、或食或痰、聚多是气．）留饮宿食．心腹痞满．二便不通．（皆土郁夺之．）吐血、衄血、血闭．损伤积血．一切实热．血中伏火．行水除痰．"}]},{"ID":"20240612171531-eu2yg0b","Type":"NodeParagraph","Properties":{"id":"20240612171531-eu2yg0b","updated":"20240612171531"},"Children":[{"Type":"NodeText","Data":"蚀脓消肿．能推陈致新．（东垣曰∶如定祸乱以致太平、所以有将军之名、时珍曰∶仲景泻心汤、治心气不足、吐衄血者、用大黄黄连黄芩、乃泻心包肝脾胃四经血中之伏火也、又治心下痞满、按之软者、用大黄黄连泻心汤、亦泻脾胃之湿热、非泻心也、病发于阴而反下之、则痞满、乃寒伤营血、邪结上焦、胃之上脘当心、故曰泻心、经曰∶太阴所至为痞满、又曰∶浊气在上、则生 胀是已、病发于阳而反下之、则结胸、乃热邪陷入血分、亦在上脘、故大陷胸汤丸皆用大黄、亦泻脾胃血分之邪、而降其浊气也、若结胸在气分、则用小陷胸汤泻心汤、或问心气不足而吐衄、何以不补心而反泻心、丹溪曰∶少阴不足、亢阳无辅、致阴血妄行、故用大黄泻其亢盛之火、又心本不足、肺肝各受火邪而病作、故用黄芩清肺、黄连清肝、肺者阴之主、肝者心之母、血之合也、肺肝火退、则血归经而自安矣、宗 曰∶以苦泄其热、就以苦补其心、盖一举而两得之、士材曰∶古人用大黄、治虚劳吐衄、意甚深微、盖浊阴不降、则清阳不升、瘀血不去、则新血不生也．）峻利猛烈．长驱直捣．苟非血分热结．六脉沉实者．切勿轻与推荡．（病在气分而用之、是为诛伐无过浸、酒蒸、生、熟之不同．生用更峻．（欲取通利者、不得骤进谷食、大黄得谷食、便不能通利、洪迈夷坚志云∶汤火伤者、捣生大黄调敷、止痛无瘢．）黄芩为使．（梅师方、男子偏坠作痛、大黄末、醋和涂之、干则易．自半夏至大黄、皆常毒之品．）"}]},{"ID":"20240612171516-6ra9xrw","Type":"NodeThematicBreak","Properties":{"id":"20240612171516-6ra9xrw"}},{"ID":"20240612171518-61jjb3o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171518-61jjb3o","updated":"20240612171524"},"Children":[{"Type":"NodeText","Data":"大黄《神农本草经百种录》"}]},{"ID":"20240612171518-vwft4tr","Type":"NodeParagraph","Properties":{"id":"20240612171518-vwft4tr","updated":"20240612171518"},"Children":[{"Type":"NodeText","Data":"味苦寒。主下瘀血，血闭除血中热结之滞。寒热，血中积滞之寒热。破症瘕积聚，凡腹中邪气之积，无不除之。留饮宿食，荡涤肠胃，推陈致新，凡腹中饮食之积，无不除之。"}]},{"ID":"20240612171518-gky28d9","Type":"NodeParagraph","Properties":{"id":"20240612171518-gky28d9","updated":"20240612171518"},"Children":[{"Type":"NodeText","Data":"通利水谷，调中化食，助肠胃运化之力。安和五脏。邪积既去，则正气自和。"}]},{"ID":"20240612171518-e2awk64","Type":"NodeParagraph","Properties":{"id":"20240612171518-e2awk64","updated":"20240612171518"},"Children":[{"Type":"NodeText","Data":"大黄色正黄而气香，得土之正气正色，故专主脾胃之疾。凡香者，无不燥而上升。大黄极滋润达下，故能入肠胃之中，攻涤其凝结之邪，而使之下降，乃驱逐停滞之良药也。"}]},{"ID":"20240612171504-ah8di2j","Type":"NodeThematicBreak","Properties":{"id":"20240612171504-ah8di2j"}},{"ID":"20240612171505-dkypbiy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171505-dkypbiy","updated":"20240612171510"},"Children":[{"Type":"NodeText","Data":"大黄《吴普本草》"}]},{"ID":"20240612171505-zcqnk7c","Type":"NodeParagraph","Properties":{"id":"20240612171505-zcqnk7c","updated":"20240612171505"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十二"}]},{"ID":"20240612171505-vaxd4ve","Type":"NodeParagraph","Properties":{"id":"20240612171505-vaxd4ve","updated":"20240612171505"},"Children":[{"Type":"NodeText","Data":"一名黄良，一名火参，一名肤如。神农、雷公∶苦，有毒。扁鹊∶苦，无毒。李氏∶小寒。为中将军，或生蜀郡北部，或陇西。二月卷生，生黄赤叶，四四相当，黄茎，高三尺许，三月华黄，五月实黑，三月采根，根有黄汁，切阴干。"}]},{"ID":"20240612171726-nr4qiab","Type":"NodeThematicBreak","Properties":{"id":"20240612171726-nr4qiab"}},{"ID":"20240612171728-rjg8ei7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171728-rjg8ei7","updated":"20240612171732"},"Children":[{"Type":"NodeText","Data":"大黄《中药炮制》"}]},{"ID":"20240612171728-xyzsjnw","Type":"NodeParagraph","Properties":{"id":"20240612171728-xyzsjnw","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『来源』本品为蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌叶大黄"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"唐古特大黄"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药用大黄"},{"Type":"NodeText","Data":"的干燥根茎及根茎。"}]},{"ID":"20240612171728-25xlbz2","Type":"NodeParagraph","Properties":{"id":"20240612171728-25xlbz2","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『常用名』庄黄、绵纹、香结、生军、熟军。"}]},{"ID":"20240612171728-ezfd20u","Type":"NodeParagraph","Properties":{"id":"20240612171728-ezfd20u","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『产地』青海、甘肃、四川、湖北等地。"}]},{"ID":"20240612171728-2j3ip2l","Type":"NodeParagraph","Properties":{"id":"20240612171728-2j3ip2l","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『采收季节』立冬前后采挖。"}]},{"ID":"20240612171728-pauj00g","Type":"NodeParagraph","Properties":{"id":"20240612171728-pauj00g","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『炮制方法』先将灰尘洗净，放木桶或盆内，每斤原药用清水4～6两浸润，分二次下，经常上下翻动，如有硬者，再洒上水，润透取出，切直片2厘厚晾干，不宜曝晒。若取其降低寒性，则用酒渍法，每斤原药用酒3两，制法同上。若取其走行小肠膀胱及湿热隆闭，则用蒸法，每斤药用酒3两，酒入药内渍润，每天翻动，待酒吸干取出，放蒸笼内用武火蒸4小时，熄灭、闷12小时，取出晾干，然后将锅内的水浓缩，拌入大黄内吸尽，取出切片晾干。也可用酒炒法，每斤药片用黄酒3两，酒入药内润片刻，投入锅内拌炒至焦黄色，此法清热利小便。还有用醋制大黄，制法同上。大黄炭，取生大黄片置锅内，武火炒至表面呈炭黑色：内心棕黄色为度。用作止泻2～3克较好，剂量不宜大。"}]},{"ID":"20240612171728-5an8hc9","Type":"NodeParagraph","Properties":{"id":"20240612171728-5an8hc9","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『用量』6～12克。"}]},{"ID":"20240612171728-5b8lqn2","Type":"NodeParagraph","Properties":{"id":"20240612171728-5b8lqn2","updated":"20240612171728"},"Children":[{"Type":"NodeText","Data":"『贮存』装箱内闭盖，防霉及虫蛀。"}]},{"ID":"20240612171149-i29k833","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-i29k833"}},{"ID":"20240612171455-p7u2b3c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171455-p7u2b3c","updated":"20240612171458"},"Children":[{"Type":"NodeText","Data":"大黄《神农本草经读》"}]},{"ID":"20240612171455-ns3q9h7","Type":"NodeParagraph","Properties":{"id":"20240612171455-ns3q9h7","updated":"20240612171455"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主下淤血、血闭，寒热，破症瘕积聚、留饮宿食，荡涤肠胃，推陈致新，通利水谷，调中化食，安和五脏。"}]},{"ID":"20240612171455-ea1zg00","Type":"NodeParagraph","Properties":{"id":"20240612171455-ea1zg00","updated":"20240612171455"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶大黄色正黄而臭香，得土之正气正色，故专主脾胃之病；其气味苦寒，故主下泄凡血淤而闭，则为寒热；腹中结块，有形可征曰症，可聚可散曰瘕；五脏为积，六腑为聚，以及留饮宿食，得大黄攻下，皆能已之。自“荡涤肠胃”下五句，是申明大黄之效。末一句是总结上四句，又大申大黄之奇效也。意谓人只知大黄荡涤肠胃，功在推陈，抑知推陈即所以致新乎？人知大黄通利水谷，功在化食，抑知化食即所以调中乎？且五脏皆禀气于胃，胃得大黄运化之力而安和，而五脏亦得安和矣，此《本经》所以有黄良之名也。（有生用者，有用清酒洗者。）"}]},{"ID":"20240612171408-70cyupi","Type":"NodeThematicBreak","Properties":{"id":"20240612171408-70cyupi"}},{"ID":"20240612171439-84pju7f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171439-84pju7f","updated":"20240612171448"},"Children":[{"Type":"NodeText","Data":"大黄《本草纲目》"}]},{"ID":"20240612171439-phi77ge","Type":"NodeParagraph","Properties":{"id":"20240612171439-phi77ge","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"「释名」黄良、将军、火参、肤如。"}]},{"ID":"20240612171439-eqmpze0","Type":"NodeParagraph","Properties":{"id":"20240612171439-eqmpze0","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240612171439-wovvrzi","Type":"NodeParagraph","Properties":{"id":"20240612171439-wovvrzi","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612171439-58zpiim","Type":"NodeParagraph","Properties":{"id":"20240612171439-58zpiim","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"1、吐血、鼻血（心气不足）。用大黄二两，黄连、黄芩各一两，加水三升，煮成一升，热服。下泻即验。"}]},{"ID":"20240612171439-ji39136","Type":"NodeParagraph","Properties":{"id":"20240612171439-ji39136","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"2、伤寒痞满（心下满而不痛）。用大黄二两、黄连一两，泡入麻沸汤中。过一会，绞渣取汁，分二次温服。此方名大黄黄连泻心汤。"}]},{"ID":"20240612171439-bnd77uv","Type":"NodeParagraph","Properties":{"id":"20240612171439-bnd77uv","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"3、热病兼说胡话。用大黄五两，锉细，炒到微红，加水煎成膏子，每服半匙，冷水送下，此方亦治伤寒发黄。"}]},{"ID":"20240612171439-iygmypv","Type":"NodeParagraph","Properties":{"id":"20240612171439-iygmypv","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"4、腰脚风痛。用大黄二两，切成小块，加少许酥油炒干，不能炒焦。捣烂筛过。每服二钱，空心服，煮开过多次的姜汤送下。泻出冷脓恶物，痛即止。"}]},{"ID":"20240612171439-ee4xeui","Type":"NodeParagraph","Properties":{"id":"20240612171439-ee4xeui","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"5、风热积壅。用大黄四两、牵牛子（半炒）四两、共研为末，加炼蜜做成丸了，如梧子大。每服十丸，白开水送下。如要微泻，每服可加十至二十丸。又方：基本上和上主栅，但不用炼蜜而用皂荚熬膏代替，称为坠痰丸或“全真丸”，又名“保安丸”。"}]},{"ID":"20240612171439-vsyxbsz","Type":"NodeParagraph","Properties":{"id":"20240612171439-vsyxbsz","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"6、痰为面病（但水泻及胎前产后的痰病不可服用）。用大黄（酒浸，蒸熟。切晒）八两，生黄芩八两，沉香半两，共研为末，加青礞石（二两）和焰硝（二两）一起封固、煅红、研细的药末二两，以水和各药成丸，如梧子大。常服一、二十丸，小病五、六十丸，缓病七、八十丸，急病一百二十丸，温水送下后，好静卧勿动，让药起作用。第二天，先下糟粕，次下痰涎。如未下，可再次服药，此方名“滚痰丸”。"}]},{"ID":"20240612171439-p6j7xew","Type":"NodeParagraph","Properties":{"id":"20240612171439-p6j7xew","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"7、腹中痞块。用大黄十两，研为末，加醋三升、蜜两匙，和匀，煎成丸了，如梧子大。生前了三十丸，生姜汤关定。能吐泻即验。又方：陈石灰半斤，瓦器上炒至极热，等稍冷后，加大黄末（炒热）一两、桂心末（略炒）半两，以醋调成膏，摊在布上贴患处。又方：大黄二两、朴硝一两，共研为末，以大蒜同捣成膏贴患处。加放阿魏一两，更好。"}]},{"ID":"20240612171439-g2l2ohx","Type":"NodeParagraph","Properties":{"id":"20240612171439-g2l2ohx","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"8、脾癖疳积。用大黄末三两，加醋熬成膏，倒在瓦上日晒夜露三天；再加硫磺一两（以形如琥珀者为好）、宫粉一两，一起研匀。十岁以下小孩，每服半钱，大人每服一钱半，米汤送下。忌生冷鱼肉，只吃白粥半月。如一服不愈，半月之后再服。"}]},{"ID":"20240612171439-28wwkf9","Type":"NodeParagraph","Properties":{"id":"20240612171439-28wwkf9","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"9、小儿诸热。用大黄（煨熟）、黄芩各一两，共研为末，加炼蜜做在成丸子，如麻子大。每服五至十丸，蜜汤送下。亦可加黄连，称为“三黄丸”。"}]},{"ID":"20240612171439-8uq5065","Type":"NodeParagraph","Properties":{"id":"20240612171439-8uq5065","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"10、骨蒸积热，渐渐黄瘦。用大黄四分、加童便五六合，煎取四合，去渣服汁，分二次服。"}]},{"ID":"20240612171439-mm7u1u2","Type":"NodeParagraph","Properties":{"id":"20240612171439-mm7u1u2","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"11、赤白浊淋。用大黄研末，每次取六分，放入破了顶的鸡蛋中，搅匀，蒸熟，空心吃下。三次见效。"}]},{"ID":"20240612171439-hhgmrsz","Type":"NodeParagraph","Properties":{"id":"20240612171439-hhgmrsz","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"12、大便秘结。用大黄末一两、牵牛头末半两，和匀，每服三钱。用厥次序心烦现象者，酒送下，无此现象者，蜜汤送下。"}]},{"ID":"20240612171439-trlmar3","Type":"NodeParagraph","Properties":{"id":"20240612171439-trlmar3","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"13、热痢，里急后重。用大黄一两，浸酒中半日，取出煎服。"}]},{"ID":"20240612171439-2w9b5fl","Type":"NodeParagraph","Properties":{"id":"20240612171439-2w9b5fl","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"14、伤寒并热霍乱（涎流吐逆，不能言语，牙齿动摇，喘气闷绝）。用大黄、人参各半两，加水二碗，煎成一碗，热服即安。"}]},{"ID":"20240612171439-7u6g5m4","Type":"NodeParagraph","Properties":{"id":"20240612171439-7u6g5m4","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"15、食后即吐。用大黄一两、甘草二钱半，加水一升，煮成半升，温服。"}]},{"ID":"20240612171439-6t1r8iy","Type":"NodeParagraph","Properties":{"id":"20240612171439-6t1r8iy","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"16、产后血块。用大黄末一两，加头醋半升，熬膏做成丸子，如梧子大。每服五丸，温醋化下。"}]},{"ID":"20240612171439-o75yb8j","Type":"NodeParagraph","Properties":{"id":"20240612171439-o75yb8j","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"17、男子疝气偏坠。用大黄末调醋涂患处，药干即换。"}]},{"ID":"20240612171439-awi7hd0","Type":"NodeParagraph","Properties":{"id":"20240612171439-awi7hd0","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"18、头眼昏眩。用酒炒大黄，研为末，清茶送服二钱。"}]},{"ID":"20240612171439-y7o7ve4","Type":"NodeParagraph","Properties":{"id":"20240612171439-y7o7ve4","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"19、风热牙痛。用大内烧存性，研为末，早晚擦牙。"}]},{"ID":"20240612171439-qum1wi2","Type":"NodeParagraph","Properties":{"id":"20240612171439-qum1wi2","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"20、口腔糜烂。用大黄、枯矾，等分为末，擦牙，吐涎。"}]},{"ID":"20240612171439-sb05ke1","Type":"NodeParagraph","Properties":{"id":"20240612171439-sb05ke1","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"21、鼻内生疮。用生大黄、杏仁捣匀，加猪油调涂。又方：用生大黄、黄连各一钱，麝香少许，共研为末，加重油调涂。"}]},{"ID":"20240612171439-866uqd3","Type":"NodeParagraph","Properties":{"id":"20240612171439-866uqd3","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"22、损伤瘀血（从高处跌下或木石压伤，痛不可忍）。用大黄（酒蒸）一两、杏仁（去皮）三、七粒，共研细，加酒一碗，煎成六分，鸡鸣时服。至晚间有瘀血排下为验。"}]},{"ID":"20240612171439-06cfvuj","Type":"NodeParagraph","Properties":{"id":"20240612171439-06cfvuj","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"23、冻疮。用水调大黄末涂搽。"}]},{"ID":"20240612171439-04mx935","Type":"NodeParagraph","Properties":{"id":"20240612171439-04mx935","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"24、汤火伤。用大黄生研，调蜜涂搽，不惟止痛，而且灭瘢。"}]},{"ID":"20240612171439-mflg3yx","Type":"NodeParagraph","Properties":{"id":"20240612171439-mflg3yx","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"25、蠼螋咬疮。用大黄研末敷上。"}]},{"ID":"20240612171439-3bue5zu","Type":"NodeParagraph","Properties":{"id":"20240612171439-3bue5zu","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"26、肿毒初起。用大黄、五倍子、黄蘖，等分为末，新汲水调匀涂患处。每天四至五次。"}]},{"ID":"20240612171439-o556tlb","Type":"NodeParagraph","Properties":{"id":"20240612171439-o556tlb","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"27、痈肿热痛。用大黄研末，加醋调匀涂患处。药干即换。"}]},{"ID":"20240612171439-ckmfm7z","Type":"NodeParagraph","Properties":{"id":"20240612171439-ckmfm7z","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"28、乳痈。用大黄、粉草各一两，共研为末，加好酒熬成膏，摊布块上贴疮。同时，取药末一匙，温酒送服。次日有恶物排出。此方名“金黄散”。"}]},{"ID":"20240612171439-u32ylu4","Type":"NodeParagraph","Properties":{"id":"20240612171439-u32ylu4","updated":"20240612171439"},"Children":[{"Type":"NodeText","Data":"29、大风癞疮。用大黄（煨）一两、皂荚两刺一两，共研为末。每服一匙，空心服，温酒送下。排出恶物如鱼脑状或乱发状，再雄黄花蛇药（“通天再造散”）"}]},{"ID":"20240612171408-us46qs1","Type":"NodeThematicBreak","Properties":{"id":"20240612171408-us46qs1"}},{"ID":"20240612171421-y8klqew","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171421-y8klqew","updated":"20240612171427"},"Children":[{"Type":"NodeText","Data":"大黄《医学入门》"}]},{"ID":"20240612171421-evly8lt","Type":"NodeParagraph","Properties":{"id":"20240612171421-evly8lt","updated":"20240612171421"},"Children":[{"Type":"NodeText","Data":"大黄大寒苦善泄，不问痰 瘕积热，阳明燥结胀难禁，上走胸顶假舟楫。"}]},{"ID":"20240612171421-wbbsc2l","Type":"NodeParagraph","Properties":{"id":"20240612171421-wbbsc2l","updated":"20240612171421"},"Children":[{"Type":"NodeText","Data":"色黄大块锦纹者佳。无毒。味极浓，性走不守，阴中之阴，降也，入手足阳明经。主除痰实，下瘀血血闭寒热，破 瘕积聚宿食浓味。一切积热，伤寒热入里深，土郁大便燥结，肚腹胀满，服之推陈致新，安和五脏，如戡祸乱以致太平，故有将军之号。丹溪曰∶生用则通肠胃壅热，熟用则解诸疮毒，泻心火。又云∶仲景治心气不足吐衄用大黄、黄芩、黄连，名曰泻心汤。《衍义》谓邪热因心气不足而客之，故吐衄，以苦泄其热，以苦补其心，两全之。然心之阴气不足而阳火亢甚，肝肺各受其火而病作，故芩、连救肝肺，大黄泻亢火，而血自归经，非既泻心而又补之谓也。《液》云∶酒浸入太阳，酒洗入阳明，余经不用酒。盖酒浸良久，稍薄其味，而藉酒上升巅顶至高之分，太阳经也。酒洗亦不至峻下，故承气汤俱用酒浸，惟小承气生用。是酒亦大黄之舟楫，不独桔梗能载而浮至胸中，去湿热结热也。古有生用者，热去而患赤眼，河间谓其所用大黄未经酒制，而上热不去也。杂用量人虚实，或生，或面包煨熟，或酒浸蒸熟。黄芩为使，无所畏。所芍药、黄芩、牡蛎、细辛、茯苓疗惊恚怒心下悸气，得消石、紫石英、桃仁疗女子血闭。"}]},{"ID":"20240612171409-xim6smj","Type":"NodeThematicBreak","Properties":{"id":"20240612171409-xim6smj"}},{"ID":"20240612171410-btsoshx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171410-btsoshx","updated":"20240612171414"},"Children":[{"Type":"NodeText","Data":"大黄《本草求真》"}]},{"ID":"20240612171410-9aqnooo","Type":"NodeParagraph","Properties":{"id":"20240612171410-9aqnooo","updated":"20240612171410"},"Children":[{"Type":"NodeText","Data":"（毒草）入胃下热攻滞"}]},{"ID":"20240612171410-l2te87j","Type":"NodeParagraph","Properties":{"id":"20240612171410-l2te87j","updated":"20240612171410"},"Children":[{"Type":"NodeText","Data":"大黄（专入脾胃）。大苦大寒。性沉不降。用走不守。专入阳明胃府大肠。大泻阳邪内结。宿食不消。（三承气汤皆有大黄内入。仲景治伤寒邪由太阳而入阳明之府者。则用调胃承气。取其内有甘草之缓。不令有伤胃府之意也。治邪由阳明之经直入阳明之府者。则用大承气。取其中有枳实之急。得以破气气之壅也。治邪由少阳之经而入阳明之府者。则用小承气。取其中无芒硝之咸。致令泄下以伤其胃也。）故凡伤寒邪入胃府。而见日晡潮热。（阳明旺于申酉．）谵语斑狂。便秘硬痛手不可近。（喜按属虚。拒按属实。）乃瘟热瘴疟。下痢赤白。腹痛里急。黄胆水肿。积聚留饮宿食。心腹痞满。二便不通。与热结血分。一切症瘕血燥。血秘实热等症。用此皆能推陈致新。定乱致治。故昔人云有将军之号。（成无己曰。热淫所胜。以苦泄之。大黄之苦。以荡涤瘀热。下燥结而泄胃强。）然苦则伤气。寒则伤胃。下则亡阴。故必邪热实结。宿食不下。用之得宜。（宗 曰。有是证者。用之无不效。惟在量其虚实而已。颂曰。梁武帝因发热。欲服大黄。姚僧垣曰。大黄乃是劫药。至尊年高。不可轻用。帝勿从。几至委顿。梁元帝常有心腹疾。诸医咸谓宜用平药。可渐宣通。僧垣曰。脉洪而实。此有宿妨。非用大黄。无瘥理。帝从之遂愈。今医用一毒药而攻众病。偶中便谓之神。不中不语用药之失。可不戒哉！）若使病在上脘。虽或宿食不消。及见发热。只须枳实黄连以消痞热。宿食自通。若误用大黄推荡不下。反致热结不消。为害不浅。（时珍曰。大黄病在五经血分者宜用之。若在气分用之。是谓诛伐无过。泻心汤有大黄。治心气不足吐血衄血者。乃真心之气不足。而心包肝脾胃之邪火有余也。虽曰泻心。实泻四经血中之伏火也。又仲景治心下痞满按之软者。用大黄黄连泻心汤主之。此亦泻脾胃之湿热。非泻心也。病发于阴而反下之。则作痞满。乃寒伤营血。邪气乘虚结于上焦。胃之上脘在于心。故曰泻心。实泻脾也。素问云。太阴所致为痞满。又曰。浊气在上。则生 胀是也。病发于阳而反下之。则成结胸。乃热邪陷入血分。亦在上脘分野。仲景大陷胸汤丸皆用大黄。亦泻脾胃血分之邪。而降其浊气也。若结胸在气分。则只用小陷胸汤。痞满在气分。则用半夏泻心汤足矣。或曰。心气不足而吐衄。何以不用补心而反泻心。震亨曰。心阴不足。肺与肝俱各受火而病作。故黄芩救肺。黄连救肝。肺者阴之主。肝者心之母。血之合也。肝肺之火既退。则阴复其旧矣！仲景伤寒论云。太阳病外症未解。不可下。脉浮大。不可下。恶寒。不可下。呕多有阳明症。不可下。阳明病不能食。攻其热必呕。阳明病应汗。反下之。此为大逆。太阳阳明合病。喘而胸满。不可下。少阴病。阳虚尺脉弱者。不可下。脉数。不可下。恶水者。不可下。头痛目黄者。不可下。虚家不可下。阳微不可下。诸四逆厥者不可下。）况先辈立药治病。原有成则。如大黄芒硝。则泻肠胃之燥热。牵牛甘遂。则泻肠胃之湿热。巴豆硫黄。则泻胃之寒结也。虽其所通则一。而性实有不同。当为分视。至于老人虚秘。腹胀少食。妇人血枯。阴虚寒热。脾气痞积。肾虚动气。及阴疽色白不起等症。不可妄用。以取虚虚之祸。川产锦纹者良。生用峻。熟用纯。忌进谷食。（得谷食。不能通利。）黄芩为使。"}]},{"ID":"20240612171149-a4kba26","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-a4kba26"}},{"ID":"20240612171349-wzna156","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171349-wzna156","updated":"20240612171357"},"Children":[{"Type":"NodeText","Data":"大黄《药鉴》"}]},{"ID":"20240612171349-8dru39z","Type":"NodeParagraph","Properties":{"id":"20240612171349-8dru39z","updated":"20240612171349"},"Children":[{"Type":"NodeText","Data":"气寒味苦，气味俱浓，无毒，沉也，阴中阴也。属水与火，入手足阳明经，酒浸入太阳，酒洗入阳明。通闭结灵丹，驱邪实效方。与桃仁同用，则导瘀血。与枳壳同用，则除积气。"}]},{"ID":"20240612171349-mlrjf2z","Type":"NodeParagraph","Properties":{"id":"20240612171349-mlrjf2z","updated":"20240612171349"},"Children":[{"Type":"NodeText","Data":"入痰火药，更能滚痰。入消食药，即能推陈。生用则通肠胃壅结热，熟用则治诸毒疮疡，久不收口。盖以诸毒疮疡，皆属心火，大黄熟用，则能泻心火，且宣气消肿，而除结热之在上者。其性沉而不浮，其用走而不守，有推陈致新之功，有斩关夺将之能，故名之曰将军。仲景用之以心气不足而吐衄者，名泻心汤，正是因肾经不足，而本经之阳，亢甚无辅，以至血妄行飞越，故用大黄泄去亢甚之火，使之和平，则血归经，而自安矣。夫心之阴气不足，非一日矣，肺与肝俱各受火邪而病作，故芩救肺、连救肝，肺者阴之主，肝者心之母，血之舍也，肝肺之火既退，宜其阴血自复矣。衍义不明说，而曰邪热因不足而客之，何以明仲景之意，开后人之盲也。大都寒能冷肠胃，苦能泄实热，必须肠胃有实邪者，方可用之。"}]},{"ID":"20240612171149-y0vqs7g","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-y0vqs7g"}},{"ID":"20240612171339-29jen4f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171339-29jen4f","updated":"20240612171343"},"Children":[{"Type":"NodeText","Data":"大黄《新修本草》"}]},{"ID":"20240612171339-2853fsw","Type":"NodeParagraph","Properties":{"id":"20240612171339-2853fsw","updated":"20240612171339"},"Children":[{"Type":"NodeText","Data":"将军，味苦，寒、大寒，无毒。主下瘀血，血闭，寒热，破症瘕积聚，留饮宿食，荡涤肠胃，推陈致新，通利水谷，调中化食，安和五脏。平胃下气，除痰实，肠间结热，心腹胀满，女子痛，诸老血留结。一名黄良。"}]},{"ID":"20240612171339-kheqpz9","Type":"NodeParagraph","Properties":{"id":"20240612171339-kheqpz9","updated":"20240612171339"},"Children":[{"Type":"NodeText","Data":"生河西山谷及陇西。二月、八月采根，火干。"}]},{"ID":"20240612171339-rk4xql3","Type":"NodeParagraph","Properties":{"id":"20240612171339-rk4xql3","updated":"20240612171339"},"Children":[{"Type":"NodeText","Data":"得芍药、黄芩、牡蛎、细辛、茯苓疗惊恚怒，心下悸气。得硝石、紫石英、桃仁疗女子血闭。黄芩为之使。今采益州北部汶山及西山者，虽非河西、陇西，好者犹作紫地锦色，味甚苦涩，色至浓黑。西川阴干者胜。北部晒干，亦有火干者，皮小焦不如，而耐蛀堪久。此药至劲利，粗者便不中服，最为俗方所重。道家时用以去痰疾，非养性所须也。将军之号，当取其骏快矣。"}]},{"ID":"20240612171339-8qeh0g4","Type":"NodeParagraph","Properties":{"id":"20240612171339-8qeh0g4","updated":"20240612171339"},"Children":[{"Type":"NodeText","Data":"〔谨案〕大黄性湿润，而易壤蛀，火干乃佳。二月、八月日不烈，恐不时燥，即不堪矣。叶、子、茎并似羊蹄，但粗长而浓，其根细者，亦似宿羊蹄，大者乃如碗，长二尺。作时烧石使热，横寸截着石上爆之，一日微燥，乃绳穿晾之，至干为佳。幽、并以北渐细，气力不如蜀中者。今出宕州、凉州、西羌、蜀地皆有。其茎味酸，堪生啖，亦以解热，多食不利人。陶称蜀地者不及陇西，误矣。"}]},{"ID":"20240612171149-5z7ilhv","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-5z7ilhv"}},{"ID":"20240612171325-chmwi4g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171325-chmwi4g","updated":"20240612171333"},"Children":[{"Type":"NodeText","Data":"大黄《本草图经》"}]},{"ID":"20240612171325-syeotb3","Type":"NodeParagraph","Properties":{"id":"20240612171325-syeotb3","updated":"20240612171330"},"Children":[{"Type":"NodeText","Data":"大黄，生河西山谷及陇西，今蜀川、河东、陕西州郡皆有之，以蜀川锦文者佳。其次秦陇来者，谓之土蕃大黄。正月内生青叶，似蓖麻，大者如扇；根如芋，大者如碗，长一、二尺，旁生细根如牛蒡，小者亦如芋；四月开黄花，亦有青红似荞麦花者；茎青紫色，形如竹。二、八月采根，去黑皮，火干。江淮出者曰土大黄，二月开黄花，结细实。又鼎州出一种羊蹄大黄，疗疥瘙甚效。初生苗叶如羊蹄，累年长大，即叶似商陆而狭尖；四月内于抽条上出穗，五、七茎相合，花叶同色；结实如荞麦而轻小，五月熟即黄色，亦呼为金荞麦。三月采苗，五月收实，并阴干；九月采根，破之亦有锦文。日干之，亦呼为土大黄。凡收大黄之法。"}]},{"ID":"20240612171325-g1fd309","Type":"NodeParagraph","Properties":{"id":"20240612171325-g1fd309","updated":"20240612171325"},"Children":[{"Type":"NodeText","Data":"苏恭云∶作时烧石使热，横寸截着石上 之，一日微燥，乃绳穿眼之至干。今土蕃大黄，往往作横片，曾经火 。蜀大黄乃作紧片，如牛舌形，谓之牛舌大黄。二者用之皆等。《本经》称大黄推陈致新，其效最神，故古方下积滞多用之，张仲景治伤寒用处尤多。又有三物备急丸，司空裴秀为散用，疗心腹诸疾卒暴百病，其方用大黄、干姜、巴豆各一两，须精新好者，捣筛，蜜和，更捣一千杵，丸如小豆，服三丸。老小斟量之。为散不及丸也。若中恶客忤，心腹胀满，卒痛如锥刀刺痛，气急口噤，停尸卒死者，以暖水若酒服之。若不下，捧头起，灌令下喉，须臾瘥。未知更与三丸，腹当鸣转，即吐下便愈。若口已噤，亦须折齿灌之，药入喉即瘥。崔知悌疗小儿无辜闪癖，瘰疠，或头干黄耸，或乍痢乍差，诸状多者，皆大黄煎主之。大黄九两，锦文新实者，若微朽即不中用，削去苍皮，乃秤，捣筛为散，以上好米醋三升和之，置铜碗中，于大铛中浮汤上，炭火煮之，火不用猛，又以竹木篦搅药，候任丸，乃停。于小瓷器中贮。儿年三岁，一服七丸如梧子，日再服，常以下青赤脓为度。若不下脓，或下脓少者，稍稍加丸。下脓若多，丸又须减。病重者，或至七、八剂方尽根本。大人、小儿以意量之。此药惟下脓宿结，不令儿利，须禁食毒物。食乳者，乳母亦同忌法。崔元亮《海上方》∶治腰脚冷风气，以大黄二大两，切如棋子，和少酥炒，令酥尽入药中，切不得令黄焦，则无力，捣筛为末，每日空腹，以水三大合，入生姜两片如钱，煎十余沸，去姜，取大黄末两钱，别置碗子中，以姜汤调之，空腹顿服。如有余姜汤，徐徐呷之，令尽，当下冷脓及恶物等，病即瘥止。古人用毒药攻病，必随人之虚实而处置，非一切而用也。姚僧垣初仕梁，武帝因发热欲服大黄。僧垣曰∶大黄乃是快药。至尊年高，不可轻用。帝弗从，几至委顿。元帝常有心腹疾。诸医咸谓宜用平药，可渐宣通。僧垣曰∶脉洪而实，此有宿妨，非用大黄无差理，帝从而遂愈。以此言之，今医用一毒药而攻众病，其偶中病，便谓此方之神奇；其有差误，乃不言用药之失，如此者众矣，可不戒哉？"}]},{"ID":"20240612171149-erbi4w7","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-erbi4w7"}},{"ID":"20240612171314-yr6b2fk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171314-yr6b2fk","updated":"20240612171319"},"Children":[{"Type":"NodeText","Data":"大黄《本草新编》"}]},{"ID":"20240612171314-3q3irm3","Type":"NodeParagraph","Properties":{"id":"20240612171314-3q3irm3","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"大黄，味苦，气大寒，阴中之阴，降也，无毒。入胃与大肠。然有佐使，各经皆达也。"}]},{"ID":"20240612171314-qn5um4e","Type":"NodeParagraph","Properties":{"id":"20240612171314-qn5um4e","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"其性甚速，走而不守，善荡涤积滞，调中化食，通利水谷，推陈致新，导瘀血，滚痰涎，破症结，散坚聚，止疼痛，败痈疽热毒，消肿胀，俱各如神。欲其上升，须加酒制；欲其下行，须入芒硝；欲其速驰，生用为佳；欲其平调，熟煎尤妙。欲其少留，用甘草能缓也。此药有勇往直前之迅利，有推坚荡积之神功，真定安奠乱之品，祛邪救死之剂也。但用之必须看症甚清，而后下药甚效，否则，杀人于眉睫也。夫大黄乃君主之药，故号将军。然而将军无参赞之贤，不剿抚并用，亦勇而不仁。所以，承气汤中，必加人参、当归以助之，其他用大黄者，未有不益之补气、补血之味也。然而，补气之药未可重加，而补血之药断宜大用。盖肠胃燥结，而后瘀滞不行，徒用大黄以祛除，而肠中干涸，无水以通舟楫。大黄虽勇，岂能荡陆地之舟哉。故凡有闭结，必须多用补剂，使之生血以出陈，败瘀以致新也。至于补气之药，似乎可止，不知血必得气而易生，况大黄以祛除，未免损伤肠胃之气。吾先用参、 以补之，气既不伤，且助大黄之力，易于推送，邪去而正又不伤，不必已下之后，再去挽回矣。"}]},{"ID":"20240612171314-vqx0lay","Type":"NodeParagraph","Properties":{"id":"20240612171314-vqx0lay","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"但气药可以少用者，恐过助其气，以固肠胃，则大黄有掣肘之虞。然而虚弱气怯之人，当大黄必用之时，万不可执可用之说，减去参、 ，又虞有气脱之虑。总之，补气者，防其气脱；补血者，防其亡阴。要在临症察之，而不便先为悬度之也。"}]},{"ID":"20240612171314-jrxmdej","Type":"NodeParagraph","Properties":{"id":"20240612171314-jrxmdej","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或疑邪盛者宜泻，或用大黄至五六钱不泻者，又奈之何？噫！用大黄又不可拘泥也。邪轻者，少用犹须防其更变；邪重者，多用亦宜豫为图后，总以制之得宜，何忧重用乎。然而少则徐加，多则难以收拾。故邪重者，不妨由少以增多，断不可嫌少而骤多也。"}]},{"ID":"20240612171314-1ur90b7","Type":"NodeParagraph","Properties":{"id":"20240612171314-1ur90b7","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或问大黄用之于承气汤中，少若差错，下喉立亡，何利而用之乎？夫承气汤，乃夺命之药也。不善用之，夺命变为丧命矣。非大黄之过也。且子亦知大黄之功乎。当少腹之硬痛也，求生不得，求死不能，一用大黄泻之，苦楚之境，忽易为快乐之场，不特腹中安然，而身躯手足疼痛解热冤，其功之大为何如乎。倘用芒硝、浓朴、枳实，而不用大黄，虽亦能逐邪荡硬，然必不能如是之功速而效神也。可疑其无利而不用乎。"}]},{"ID":"20240612171314-pe99chx","Type":"NodeParagraph","Properties":{"id":"20240612171314-pe99chx","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或疑大黄功多而过亦多，予终不敢信为夺命之药而轻用之也。夫用大黄治至急之症也，缓症可以迟用，而急症断不宜迟。逍遥观望，因循谨慎，而杀人者正多。凡邪入下焦，而上焦喘满、中焦痞闷者，断宜速下。倘手按之痛甚而不可按者，急下无疑，庶几可以夺命。否则，气逆而死矣。胡可虑其亡阴之过，而不收其救阳之功哉。"}]},{"ID":"20240612171314-19rje8f","Type":"NodeParagraph","Properties":{"id":"20240612171314-19rje8f","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或曰用大黄误下，往往致不可救，可罔顾其亡阴，单收其救阳之功乎？曰∶亡阴之祸，乃误下之过，非宜下之过也。宜下而不下，与不宜下而下，过正相同。倘虑误下，难于垂援，先预防而用补剂，或投而为佐使，自无误下之愆。即误下，而亦无难急之祸，亦何至有亡阴之失哉。"}]},{"ID":"20240612171314-s17ront","Type":"NodeParagraph","Properties":{"id":"20240612171314-s17ront","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或疑大黄亦斩关夺门之将，何以又不宜用人参？大黄亦何尝不宜人参哉，第古人用人参于大黄中者绝少。盖用大黄之症，多是下行而不上行。上行之症，邪多裹迁之不定；下行之症，邪有趋散之无忧。用大黄以逐邪，所以止加当归以助其势，而不用人参以防其机也。"}]},{"ID":"20240612171314-rzwdt2m","Type":"NodeParagraph","Properties":{"id":"20240612171314-rzwdt2m","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或疑大黄逐瘀，而气弱之人，往往随下而辄亡，独不可用人参以扶其气乎？曰∶吾前言大黄未尝不宜人参者，正言气弱之人也。邪在于大肠之中，结燥屎而作痛，非大黄之猛利，何以迅逐其邪，而兼去其燥屎乎，倘其人为虚弱之人，似宜和解为得。然而邪已下趋大肠，和其中焦，而下焦更为急迫，其痛必甚，势必下之为快。然而下之，而气亦随下而俱脱也。苟不用人参以急补其气，则气脱又何救乎。然而与其下之气脱，而后救之以人参，何不先用人参于大黄之中，未下而先防其脱乎。况人参、大黄同用，则人参助大黄以奏功，大黄亦得人参而缓力，但去其燥屎之邪，而不崩其虚弱之气，是两用之而得宜也。"}]},{"ID":"20240612171314-cglzc0a","Type":"NodeParagraph","Properties":{"id":"20240612171314-cglzc0a","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或又问人参用于大黄之中，万一补住其邪，而燥屎不得下，不因用人参而误乎？夫大黄走而不守，人参安得而留之乎。况邪又不在上、中二焦，而在下焦之大肠。邪在大肠，原宜直下，用大黄者，不过顺以推之，而非逆以提之也。顺推而用人参，又安得变顺而转为逆乎。故人参用之于大黄之中，万无补住其邪之祸者也。"}]},{"ID":"20240612171314-d0jpihd","Type":"NodeParagraph","Properties":{"id":"20240612171314-d0jpihd","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或疑虚人不可用攻，古人有先服人参，后服大黄者，可乎？不可乎？此亦权宜之法，而不可为训也。愚意不若人参、大黄同用为佳。先服大黄，恐气脱而不及救；先服人参、恐邪壅而不能攻。惟同用于一时，自然相制相宜，大黄无过攻之虞，而人参无过补之失也。"}]},{"ID":"20240612171314-ry4ab34","Type":"NodeParagraph","Properties":{"id":"20240612171314-ry4ab34","updated":"20240612171314"},"Children":[{"Type":"NodeText","Data":"或问大黄性猛，过于迅速，似乎熟用尚非所宜，何以古人不尚熟而尚生乎？夫人黄过煮，则气味全散，攻毒不勇，攻邪不急，有用而化为无用矣。大黄之妙，全在生用为佳。将群药煎成，再投大黄，略煎一沸即服，功速而效大，正取其迅速之气而用之也。不可畏其猛烈，过煎煮以去其峻利也。"}]},{"ID":"20240612171149-9fmvtak","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-9fmvtak"}},{"ID":"20240612171248-v8ct3sf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171248-v8ct3sf","updated":"20240612171305"},"Children":[{"Type":"NodeText","Data":"大黄《本经逢原》"}]},{"ID":"20240612171248-rw29yn0","Type":"NodeParagraph","Properties":{"id":"20240612171248-rw29yn0","updated":"20240612171248"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名黄良，一名将军"}]},{"ID":"20240612171248-upfldbg","Type":"NodeParagraph","Properties":{"id":"20240612171248-upfldbg","updated":"20240612171248"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。产川中者色如锦纹而润者良。若峻用攻下生用。邪气在上，必用酒浸上引而驱热下行。破瘀血韭汁制。虚劳吐血，内有瘀积，韭汁拌炒黑用之。大肠风秘燥结，皂荚、绿矾酒制。又尿桶中浸过，能散瘀血兼行渗道。妊娠产后慎勿轻用。实热内结，势不可缓，酒蒸用之。凡服大黄，下药须与谷气相远，得谷气则不行矣。"}]},{"ID":"20240612171248-wbooy0v","Type":"NodeParagraph","Properties":{"id":"20240612171248-wbooy0v","updated":"20240612171248"},"Children":[{"Type":"NodeText","Data":"《本经》下瘀血，血闭，寒热，破症瘕积聚，留饮宿食，荡涤肠胃，推陈致新，通利水谷，调中化食，安和五脏。"}]},{"ID":"20240612171248-5iz1ix3","Type":"NodeParagraph","Properties":{"id":"20240612171248-5iz1ix3","updated":"20240612171248"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"大黄气味俱浓，沉降纯阴，乃脾胃太肠肝与三焦血分之药。凡病在五经血分者宜之。若在气分者用之，是诛伐无过矣。其功专于行瘀血，导血闭，通积滞，破症瘕，消实热，泻痞满，润燥结，敷肿毒，总赖推陈致新之功。《本经》与元素皆谓去留饮宿食者，以宿食留滞中宫，久而发热，故用苦寒化热，宿食亦乘势而下。后世不察，以为大黄概能消食，谬矣。盖胃性喜温恶湿，温之则宿食融化，寒之则坚滞不消，以其能荡涤肠胃，食积得以推荡，然后谷气通利，中气调畅，饮食输化，五脏安和矣。若食在上脘，虽经发热，只须枳实、黄连以消痞热，宿食自通。若误用大黄推荡不下，反致结滞不消，为害不浅。如泻心汤治心气不足，吐血衄血者，乃包络肝脾之邪火有余也，虽曰泻心，实泻四经血中伏火也。仲景治心下痞满，按之濡者，用大黄黄连泻心汤，此亦泻脾胃之湿热，非泻心也。若心下痞而复恶寒汗出者，其人阳气本虚，加附子以温散之。病发于阴，而反下之，因作痞乃痰实与邪气乘虚结于心下，故曰泻心，实泻脾也。病发于阳而反下之，则成结胸，以阳邪陷入阴分而结于膈上。仲景大陷胸汤丸，皆用大黄、芒硝以泻血分之邪，而降其浊气也。若结胸在气分，则用小陷胸汤。痞满在气分，则用半夏泻心汤矣。若病本阳邪或兼停食而攻发太过，正气消乏，实结不解，拟欲攻之，而正气不能行其药力，则加人参于桃核承气汤中，以助硝黄之势。如陶氏黄龙汤之制，乃先辈之成则也。盖大黄、芒硝泻肠胃之燥热，牵牛、甘遂泻肠胃之湿热，巴豆、硫黄泻肠胃之寒结。各有定例。至于老人血枯便秘、气虚便难，脾虚腹胀少食，妇人血枯经闭，阴虚寒热，脾气痞积，肾虚动气，及阴疽色白不起等证，不可妄用，以取虚虚之祸。"}]},{"ID":"20240612171149-xe8zyyq","Type":"NodeThematicBreak","Properties":{"id":"20240612171149-xe8zyyq"}},{"ID":"20240612171151-lpf5uja","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171151-lpf5uja","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"《中国药典》：大黄"}]},{"ID":"20240612171151-kmt3gml","Type":"NodeParagraph","Properties":{"id":"20240612171151-kmt3gml","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612171151-crwo6we","Type":"NodeParagraph","Properties":{"id":"20240612171151-crwo6we","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" Dài Huánɡ"}]},{"ID":"20240612171151-yd5ryy8","Type":"NodeParagraph","Properties":{"id":"20240612171151-yd5ryy8","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612171151-t42qknb","Type":"NodeParagraph","Properties":{"id":"20240612171151-t42qknb","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" RADIX ET RHIZOMA RHEI"}]},{"ID":"20240612171151-hbnp6dp","Type":"NodeParagraph","Properties":{"id":"20240612171151-hbnp6dp","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612171151-6zztb6t","Type":"NodeParagraph","Properties":{"id":"20240612171151-6zztb6t","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 本品为蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌叶大黄"},{"Type":"NodeText","Data":"Rheum palmatum L。、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"唐古特大黄"},{"Type":"NodeText","Data":"Rheum tanguticum Maxim。 ex Balf。或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药用大黄"},{"Type":"NodeText","Data":"Rheum officinale Baill。的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。秋末茎叶枯萎或次春发芽前采挖，除去细根，刮去外皮，切瓣或段，绳穿成串干燥或直接干燥。"}]},{"ID":"20240612171151-khm8fy1","Type":"NodeParagraph","Properties":{"id":"20240612171151-khm8fy1","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612171151-7mc6rs6","Type":"NodeParagraph","Properties":{"id":"20240612171151-7mc6rs6","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 本品呈类圆柱形、圆锥形、卵圆形或不规则块状，长3～17cm，直径3～10cm。除尽外皮者表面黄棕色至红棕色，有的可见类白色网状纹理及星点（异型维管束）散在，残留的外皮棕褐色，多具绳孔及粗皱纹。质坚实，有的中心稍松软，断面淡红棕色或黄棕色，显颗粒性；根茎髓部宽广，有星点环列或散在；根木部发达，具放射状纹理，形成层环明显，无星点。气清香，味苦而微涩，嚼之粘牙，有砂粒感。"}]},{"ID":"20240612171151-b5406eu","Type":"NodeParagraph","Properties":{"id":"20240612171151-b5406eu","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612171151-8gume2j","Type":"NodeParagraph","Properties":{"id":"20240612171151-8gume2j","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240612171151-5d3f20q","Type":"NodeParagraph","Properties":{"id":"20240612171151-5d3f20q","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612171151-b8anihd","Type":"NodeParagraph","Properties":{"id":"20240612171151-b8anihd","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 大黄 除去杂质，洗净，润透，切厚片或块，晾干。"}]},{"ID":"20240612171151-zet0cyu","Type":"NodeParagraph","Properties":{"id":"20240612171151-zet0cyu","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"酒大黄 取净大黄片，照酒炙法（附录Ⅱ D）炒干。"}]},{"ID":"20240612171151-5ef9bwx","Type":"NodeParagraph","Properties":{"id":"20240612171151-5ef9bwx","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"熟大黄 取净大黄块，照酒炖或酒蒸法（附录Ⅱ D）炖或蒸至内外均呈黑色。"}]},{"ID":"20240612171151-thfrwbt","Type":"NodeParagraph","Properties":{"id":"20240612171151-thfrwbt","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"大黄炭 取净大黄片，照炒炭法（附录Ⅱ D）炒至表面焦黑色、内部焦褐色。"}]},{"ID":"20240612171151-ghtjqlo","Type":"NodeParagraph","Properties":{"id":"20240612171151-ghtjqlo","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612171151-acrtb4b","Type":"NodeParagraph","Properties":{"id":"20240612171151-acrtb4b","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：根木栓层及皮层大多已除去。韧皮部筛管群明显；薄壁组织发达。形成层成环。木质部射线较密，宽2～4列细胞，内含棕色物；导管非木化，常1至数个相聚，稀疏排列。薄壁细胞含草酸钙簇晶，并含多数淀粉粒。"}]},{"ID":"20240612171151-crtz3ed","Type":"NodeParagraph","Properties":{"id":"20240612171151-crtz3ed","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"根茎髓部宽广，其中常见黏液腔，内有红棕色物；异型维管束散在，形成层成环，木质部位于形成层外方，韧皮部位于形成层内方，射线呈星状射出。"}]},{"ID":"20240612171151-spss9ob","Type":"NodeParagraph","Properties":{"id":"20240612171151-spss9ob","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"粉末黄棕色。草酸钙簇晶直径20～160μm，有的至190μm。具缘纹孔、网纹、螺纹及环纹导管非木化。淀粉粒甚多，单粒类球形或多角形，直径3～45μm，脐点星状；复粒由2～8分粒组。"}]},{"ID":"20240612171151-tivpsst","Type":"NodeParagraph","Properties":{"id":"20240612171151-tivpsst","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末少量，进行微量升华，可见菱状针晶或羽状结晶。"}]},{"ID":"20240612171151-c8ancku","Type":"NodeParagraph","Properties":{"id":"20240612171151-c8ancku","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"（3） 取本品粉末0。1g，加甲醇20ml浸渍1小时，滤过，取滤液5ml，蒸干，加水10ml使溶解，再加盐酸1ml，置水浴上加热30分钟，立即冷却，用乙醚分2次提取，每次20ml，合并乙醚液，蒸干，残渣加氯仿1ml使溶解，作为供试品溶液。另取大黄对照药材0。1g，同法制成对照药材溶液。再取大黄酸对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述三种溶液各4μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｈ薄层板上，以石油醚（30～60℃）-甲酸乙酯-甲酸（15:5:1）的上层溶液为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同的五个橙黄色荧光主斑点；在与对照品色谱相应的位置上，显相同的橙黄色荧光斑点，置氨蒸气中熏后，日光下检视，斑点变为红色。"}]},{"ID":"20240612171151-t2koi50","Type":"NodeParagraph","Properties":{"id":"20240612171151-t2koi50","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240612171151-6g77bu3","Type":"NodeParagraph","Properties":{"id":"20240612171151-6g77bu3","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法(附录Ⅵ D)测定。"}]},{"ID":"20240612171151-8cjgy4i","Type":"NodeParagraph","Properties":{"id":"20240612171151-8cjgy4i","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；甲醇-0.1％磷酸溶液(85:15)为流动相；检测波长为254nm。理论板数按大黄素峰计算应不低于1500。"}]},{"ID":"20240612171151-asuznd7","Type":"NodeParagraph","Properties":{"id":"20240612171151-asuznd7","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取大黄素、大黄酚对照品各5mg，分别置50ml量瓶中,用甲醇溶解并稀释至刻度，摇匀；分别精密量取大黄素溶液1ml、大黄酚溶液2ml，分别置25ml量瓶中，加甲醇至刻度，摇匀，即得(大黄素每1ml中含4μg、大黄酚每1ml中含8μg)。"}]},{"ID":"20240612171151-p4vi6f3","Type":"NodeParagraph","Properties":{"id":"20240612171151-p4vi6f3","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品粉末(过四号筛)约0.1g[同时另取本品粉末测定水分(附录ⅨH 第二法)]，精密称定，置50ml锥形瓶中，精密加甲醇25ml，称定重量，加热回流30分钟，放冷，再称定重量，用甲醇补足减失的重量，摇匀，滤过，精密量取续滤5ml，置50ml圆底烧瓶中，挥去甲醇，加2.5mol/L硫酸溶液10ml，超声处理5分钟，再加氯仿10ml，加热回流1小时，冷却，移置分液漏斗中，用少量氯仿洗涤容器，并入分液漏斗中，分取氯仿层，酸液用氯仿提取2次，每次约8ml，合并氯仿液，以无水硫酸钠脱水，氯仿液移至100ml锥形瓶中，挥去氯仿，残渣精密加甲醇10ml，称定重量，置水浴中微热溶解残渣，放冷后，再称定重量，用甲醇补足减失的重量，摇匀，滤过，取续滤液，即得。"}]},{"ID":"20240612171151-xqu919f","Type":"NodeParagraph","Properties":{"id":"20240612171151-xqu919f","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取上述两种对照品溶液与供试品溶液各5μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240612171151-tp8dd6b","Type":"NodeParagraph","Properties":{"id":"20240612171151-tp8dd6b","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含大黄素(C15H10O5)和大黄酚(C15H10O4)的总量不得少于0.05％。"}]},{"ID":"20240612171151-oe5te66","Type":"NodeParagraph","Properties":{"id":"20240612171151-oe5te66","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612171151-5tkbniq","Type":"NodeParagraph","Properties":{"id":"20240612171151-5tkbniq","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、大肠、肝、心包经。"}]},{"ID":"20240612171151-oghlotf","Type":"NodeParagraph","Properties":{"id":"20240612171151-oghlotf","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612171151-zzmi297","Type":"NodeParagraph","Properties":{"id":"20240612171151-zzmi297","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612171151-6m50eqc","Type":"NodeParagraph","Properties":{"id":"20240612171151-6m50eqc","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612171151-mzfl31t","Type":"NodeParagraph","Properties":{"id":"20240612171151-mzfl31t","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240612171151-0rwen9f","Type":"NodeParagraph","Properties":{"id":"20240612171151-0rwen9f","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612171151-9m47hnn","Type":"NodeParagraph","Properties":{"id":"20240612171151-9m47hnn","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 泻热通肠，凉血解毒，逐瘀通经。用于实热便秘，积滞腹痛，泻痢不爽，湿热黄疸，血热吐衄，目赤，咽肿，肠痈腹痛，痈肿疔疮，瘀血经闭，跌打损伤，外治水火烫伤；上消化道出血。酒大黄善清上焦血分热毒。用于目赤咽肿，齿龈肿痛。熟大黄泻下力缓，泻火解毒。用于火毒疮疡。大黄炭凉血化瘀止血。用于血热有瘀出血症。"}]},{"ID":"20240612171151-bf7mjus","Type":"NodeParagraph","Properties":{"id":"20240612171151-bf7mjus","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612171151-w806snw","Type":"NodeParagraph","Properties":{"id":"20240612171151-w806snw","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 3～30g，用于泻下不宜久煎。外用适量，研末调敷患处。"}]},{"ID":"20240612171151-69lch2l","Type":"NodeParagraph","Properties":{"id":"20240612171151-69lch2l","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"制剂"}]},{"ID":"20240612171151-mo7fc45","Type":"NodeParagraph","Properties":{"id":"20240612171151-mo7fc45","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 大黄流浸膏"}]},{"ID":"20240612171151-4k7gjgv","Type":"NodeParagraph","Properties":{"id":"20240612171151-4k7gjgv","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612171151-1xlp4m7","Type":"NodeParagraph","Properties":{"id":"20240612171151-1xlp4m7","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612171151-lg06rf0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171151-lg06rf0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：大黄"}]},{"ID":"20240612171151-jaeomcb","Type":"NodeParagraph","Properties":{"id":"20240612171151-jaeomcb","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612171151-vzji3al","Type":"NodeParagraph","Properties":{"id":"20240612171151-vzji3al","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" Dài Huánɡ"}]},{"ID":"20240612171151-hgub9br","Type":"NodeParagraph","Properties":{"id":"20240612171151-hgub9br","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612171151-nqg4ekl","Type":"NodeParagraph","Properties":{"id":"20240612171151-nqg4ekl","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 黄良、火参、肤如（《吴普本草》），将军（李当之《药录》），锦纹大黄（《千金方》），川军（《中药材手册》），峻（藏名）。"}]},{"ID":"20240612171151-bv1ahmr","Type":"NodeParagraph","Properties":{"id":"20240612171151-bv1ahmr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612171151-duegmd2","Type":"NodeParagraph","Properties":{"id":"20240612171151-duegmd2","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612171151-62l8uey","Type":"NodeParagraph","Properties":{"id":"20240612171151-62l8uey","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612171151-9jrijza","Type":"NodeParagraph","Properties":{"id":"20240612171151-9jrijza","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 为蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌叶大黄"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"唐古特大黄"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"药用大黄"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。 9～10月间选择生长3年以上的植株，挖取根茎，切除茎叶、支根，刮去粗皮及顶芽，风干、烘干或切片晒干。"}]},{"ID":"20240612171151-s9t9x29","Type":"NodeParagraph","Properties":{"id":"20240612171151-s9t9x29","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612171151-dchqg0q","Type":"NodeParagraph","Properties":{"id":"20240612171151-dchqg0q","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" ①掌叶大黄，又名：葵叶大黄、北大黄、天水大黄。"}]},{"ID":"20240612171151-c3w0nwr","Type":"NodeParagraph","Properties":{"id":"20240612171151-c3w0nwr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"多年生高大草本。根粗壮。茎直立，高2米左右，光滑无毛，中空。根生叶大，有肉质粗壮的长柄，约与叶片等长；叶片宽心形或近圆形，径达40厘米以上，3～7掌状深裂，裂片全缘或有齿，或浅裂，基部略呈心形，有3～7条主脉，上面无毛或稀具小乳突，下面被白毛，多分布于叶脉及叶缘；茎生叶较小，互生；叶鞘大，淡褐色，膜质。圆锥花序大形，分枝弯曲，开展，被短毛；花小，数朵成簇，互生于枝上，幼时呈紫红色；花梗细，长3～4毫米，中部以下具1关节；花被6，2轮，内轮稍大，椭圆形，长约1.6毫米；雄蕊9，花药稍外露；子房上位，三角形，花柱3，向下弯曲，柱头头状，稍凹，呈\"V\"字形。瘦果三角形，有翅，长9～10毫米，宽7～8毫米，顶端微凹，基部略呈心形，棕色。花期6～7月。果期7～8月。"}]},{"ID":"20240612171151-a8ejr9z","Type":"NodeParagraph","Properties":{"id":"20240612171151-a8ejr9z","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"生于山地林缘半阴湿的地方。分布四川、甘肃、青海、西藏等地。"}]},{"ID":"20240612171151-5zudwjb","Type":"NodeParagraph","Properties":{"id":"20240612171151-5zudwjb","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②唐古特大黄，又名：鸡爪大黄。"}]},{"ID":"20240612171151-5d9pt49","Type":"NodeParagraph","Properties":{"id":"20240612171151-5d9pt49","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"多年生高大草本，高2米左右，与上种相似。茎无毛或有毛。根生叶略呈圆形或宽心形，直径40～70厘米，3～7掌状深裂，裂片狭长，常再作羽状浅裂，先端锐尖，基部心形；茎生叶较小，柄亦较短。圆锥花序大形，幼时多呈浓紫色，亦有绿白色者，分枝紧密，小枝挺直向上；花小，具较长花梗；花被6，2轮；雄蕊一般9枚；子房三角形，花柱3。瘦果三角形，有翅，顶端圆或微凹，基部心形。花期6～7月。果期7～9月。"}]},{"ID":"20240612171151-nw0tcez","Type":"NodeParagraph","Properties":{"id":"20240612171151-nw0tcez","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"生于山地林缘较阴湿的地方。分布青海、甘肃、四川。西藏等地。"}]},{"ID":"20240612171151-3bfgjnq","Type":"NodeParagraph","Properties":{"id":"20240612171151-3bfgjnq","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③药用大黄，又名：南大黄。"}]},{"ID":"20240612171151-hp0mz8h","Type":"NodeParagraph","Properties":{"id":"20240612171151-hp0mz8h","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"多年生高大草本，高1.5米左右。茎直立，疏被短柔毛，节处较密。根生叶有长柄，叶片圆形至卵圆形，直径40～70厘米，掌状浅裂，或仅有缺刻及粗锯齿，先端锐尖，基部心形，主脉通常5条，基出，上面无毛，或近州’脉处具稀疏，的小乳突，下面被毛，多分布于叶脉及叶缘；茎生叶较小，柄亦短；叶鞘简状，疏被短毛，分裂至基部。圆锥花序，大形，分枝开展，花小，径3～4毫米，4～10朵成簇；花被6，淡绿色或黄白色，2轮，内轮者长圆形，长约2毫米，先端圆，边缘不甚整齐，外轮者稍短小；雄蕊9，不外露；子房三角形，花拄3。瘦果三角形，有翅，长约8～10毫米，宽约6～9毫米，顶端下凹，红色。花果期6～7月。"}]},{"ID":"20240612171151-1u984xg","Type":"NodeParagraph","Properties":{"id":"20240612171151-1u984xg","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"多生长于排水良好的山地。分布湖北、四川、云南、贵州等地。"}]},{"ID":"20240612171151-vawqwn7","Type":"NodeParagraph","Properties":{"id":"20240612171151-vawqwn7","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612171151-v6pl8c0","Type":"NodeParagraph","Properties":{"id":"20240612171151-v6pl8c0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" ①北大黄"}]},{"ID":"20240612171151-oftyp7g","Type":"NodeParagraph","Properties":{"id":"20240612171151-oftyp7g","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"为掌叶大黄及唐古特大黄的干燥根茎。商品有两类：㈠西宁大黄：多加工成圆锥形或腰鼓形，俗称\"蛋吉\"，长约6～17厘米，直径约3～10厘米；外皮巳除去或有少量残留，外表黄棕色或红棕色，可见到类白色菱形的网状纹理，俗称\"锦纹\"（系由灰白色薄壁组织与棕红色射线交错而成），有时可见菊花状螺旋形\"星点\"，一端常有绳孔。质地坚硬，横断面黄棕色，显颗粒性（习称高粱碴），微有油性，近外围有时可见暗色形成层及半径放射向的橘红色射线，髓部中有紫褐色星点，紧密排列成圈环状，并有黄色至棕红色的弯曲线纹，亦称\"锦纹\"。气特殊，味苦而微涩。主产于青海同仁、同德等地。此外，尚有凉州大黄、河州大黄和岷县大黄，亦皆属西宁大黄一类。其中凉州大黄又名凉黄、狗头大黄，因其整个的形有如狗头，顶端平圆；下部渐细而钝圆，品质亦佳，产于甘肃武威、永登等地。㈡铨水大黄"}]},{"ID":"20240612171151-mcylp9h","Type":"NodeParagraph","Properties":{"id":"20240612171151-mcylp9h","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"一般为长形，切成段块，个大形圆者常纵剖成片，质地较松，内色较西宁大黄淡，锦纹不甚明显，断面星点亦排成圈环状，其它与西宁大黄相似。主产于甘肃铨水、西礼等地。属于铨水大黄型的商品，尚有文县大黄、清水大黄、庄浪大黄等数种，产于甘肃文县，成县、清水等地。"}]},{"ID":"20240612171151-p12ot09","Type":"NodeParagraph","Properties":{"id":"20240612171151-p12ot09","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②南大黄"}]},{"ID":"20240612171151-qxqs2s6","Type":"NodeParagraph","Properties":{"id":"20240612171151-qxqs2s6","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"又名：四川大黄、马蹄大黄。为药用大黄的干燥根茎。多横切成段，一端稍大，形如马蹄，少数亦呈圆锥形或腰鼓形，长约6～12厘米，直径约5～8厘米，栓皮已除去，表面黄棕色或黄色，有微弯曲的棕色线纹（锦纹）。横断面黄褐色，多空隙，星点较大，排列不规则，质较疏松，富纤维性。气味较弱。商品有雅黄、南川大黄等，主产于四川阿坝藏族自治州、甘孜藏族自治州、凉山彝族自治州及雅安、南川等地。此外，陕西、湖北、贵州、云南、西藏等地亦产。"}]},{"ID":"20240612171151-0yvz2q3","Type":"NodeParagraph","Properties":{"id":"20240612171151-0yvz2q3","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"以上各种大黄，均以外表黄棕色、锦纹及星点明显、体重、质坚实、有油性、气清香、味苦而不涩、嚼之发粘者为佳。"}]},{"ID":"20240612171151-fioqhjd","Type":"NodeParagraph","Properties":{"id":"20240612171151-fioqhjd","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612171151-ln6dak9","Type":"NodeParagraph","Properties":{"id":"20240612171151-ln6dak9","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 生大黄（又名：生军）：原药拣净杂质，大小分档，焖润至内外湿度均匀，切片或切成小块，晒干。酒大黄：取大黄片用黄酒均匀喷淋，微焖，置锅内用文火微炒，取出晾干（大黄片100斤用黄酒14斤）。熟大黄（又名：熟军，制军）：取切成小块的生大黄，用黄酒拌匀，放蒸笼内蒸制，或置罐内密封，坐水锅中，隔水蒸透，取出晒干（大黄块100斤用黄酒30～50斤）。亦有按上法反复蒸制2～3次者。大黄炭：取大黄片置锅内，用武火炒至外面呈焦褐色（存性），略喷清水，取山晒干。"}]},{"ID":"20240612171151-2x5dtg1","Type":"NodeParagraph","Properties":{"id":"20240612171151-2x5dtg1","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使大黄，锉蒸，从未至亥，如此蒸七度，晒干。却洒薄蜜水，再蒸一伏时，其大黄劈如乌膏样，于日中晒干用之。\""}]},{"ID":"20240612171151-x855oe1","Type":"NodeParagraph","Properties":{"id":"20240612171151-x855oe1","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612171151-7yfpc2u","Type":"NodeParagraph","Properties":{"id":"20240612171151-7yfpc2u","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 入胃、大肠、肝经。"}]},{"ID":"20240612171151-zm83o2c","Type":"NodeParagraph","Properties":{"id":"20240612171151-zm83o2c","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手、足阳明经。\""}]},{"ID":"20240612171151-v94gopk","Type":"NodeParagraph","Properties":{"id":"20240612171151-v94gopk","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"足太阴，手、足阳明，手、足厥阴五经血分药。\""}]},{"ID":"20240612171151-202s0w3","Type":"NodeParagraph","Properties":{"id":"20240612171151-202s0w3","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入手太阳小肠经、手少阴心经。手少阳三焦经，兼入足阳明胃经、手阳明大肠经。\""}]},{"ID":"20240612171151-k5wezrf","Type":"NodeParagraph","Properties":{"id":"20240612171151-k5wezrf","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612171151-lyauxmz","Type":"NodeParagraph","Properties":{"id":"20240612171151-lyauxmz","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 苦，寒."}]},{"ID":"20240612171151-izui3hj","Type":"NodeParagraph","Properties":{"id":"20240612171151-izui3hj","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240612171151-rhz0vwa","Type":"NodeParagraph","Properties":{"id":"20240612171151-rhz0vwa","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、雷公：苦，有毒。扁鹊：苦，无毒。李氏：小寒。\""}]},{"ID":"20240612171151-lzwn8ik","Type":"NodeParagraph","Properties":{"id":"20240612171151-lzwn8ik","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"大寒，无毒。\""}]},{"ID":"20240612171151-dppzhhy","Type":"NodeParagraph","Properties":{"id":"20240612171151-dppzhhy","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"味苦甘。\""}]},{"ID":"20240612171151-9emv50n","Type":"NodeParagraph","Properties":{"id":"20240612171151-9emv50n","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612171151-bph1yfn","Type":"NodeParagraph","Properties":{"id":"20240612171151-bph1yfn","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 凡表证未罢，血虚气弱，脾胃虚寒，无实热、积滞、瘀结，以及胎前、产后，均应慎服。"}]},{"ID":"20240612171151-alqp0fv","Type":"NodeParagraph","Properties":{"id":"20240612171151-alqp0fv","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"①《本草经集庄》：\"黄芩为之使。\""}]},{"ID":"20240612171151-s21a6c1","Type":"NodeParagraph","Properties":{"id":"20240612171151-s21a6c1","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"忌冷水。恶干漆。\""}]},{"ID":"20240612171151-g72zhwk","Type":"NodeParagraph","Properties":{"id":"20240612171151-g72zhwk","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"凡血闭由于血枯，而不由于热积；寒热由于阴虚，而不由于瘀血；症瘕由于脾胃虚弱，而不由于积滞停留；便秘由于血少肠燥，而不由于热结不通；心腹胀满由于脾虚中气不运，而不由于饮食停滞；女子少腹痛由于厥阴血虚，而不由于经阻老血瘀结；吐、衄血由于阴虚火起于下，炎烁乎上，血热妄行，溢出上窍，而不由于血分实热；偏坠由于肾虚，湿邪乘虚客之而成，而不由于湿热实邪所犯；乳痈肿毒由于盱家气逆，郁郁不舒，以致营气不从，逆于肉里，乃生痈肿，而不由于膏粱之变，足生大疔，血分积热所发，法咸忌之，以其损伤胃气故耳。\""}]},{"ID":"20240612171151-d41syw0","Type":"NodeParagraph","Properties":{"id":"20240612171151-d41syw0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》：\"凡病在气分，及胃寒血虚，并妊娠产后，及久病年高之人，并勿轻用大黄。\""}]},{"ID":"20240612171151-shivzi1","Type":"NodeParagraph","Properties":{"id":"20240612171151-shivzi1","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑤《本经逢原》：\"肾虚动气及阴疽色白不起等证，不可妄用。\""}]},{"ID":"20240612171151-l1v6xy4","Type":"NodeParagraph","Properties":{"id":"20240612171151-l1v6xy4","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612171151-0543z9b","Type":"NodeParagraph","Properties":{"id":"20240612171151-0543z9b","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 泻热毒，破积滞，行瘀血。治实热便秘，谵语发托，食积痞满，痢疾初起，里急后重，瘀停经闭，症瘕积聚，时行热疫，暴眼赤痛，吐血，衄血，阳黄，水肿，淋浊，溲亦，痈疡肿毒，疔疮，汤火伤。"}]},{"ID":"20240612171151-q8duvdg","Type":"NodeParagraph","Properties":{"id":"20240612171151-q8duvdg","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"泻热通肠，凉血解毒，逐瘀通经。用于实热便秘、积滞腹痛、泻痢不爽、湿热黄疸。"}]},{"ID":"20240612171151-hmdc6mz","Type":"NodeParagraph","Properties":{"id":"20240612171151-hmdc6mz","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"下瘀血，血闭，寒热，破症瘕积聚，留饮宿食，荡涤肠胃，推陈致新，通利水谷（’水谷’一作’水谷道’），调中化食，安和五脏。\""}]},{"ID":"20240612171151-3708yms","Type":"NodeParagraph","Properties":{"id":"20240612171151-3708yms","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"平胃，下气，除痰实，肠间结热，心腹胀满，女子寒血闭胀，小腹痛，诸老血留结。\""}]},{"ID":"20240612171151-owcws16","Type":"NodeParagraph","Properties":{"id":"20240612171151-owcws16","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主寒热，消食，炼五脏，通女子经候，利水肿，破痰实，冷热积聚，宿食，利大小肠，贴热毒肿，主小儿寒热时疾，烦热，蚀脓，破留血。\""}]},{"ID":"20240612171151-zk69t2g","Type":"NodeParagraph","Properties":{"id":"20240612171151-zk69t2g","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"通宣一切气，调血脉，利关节，泄塑滞、水气，四肢冷热不调，温瘴热痰，利大小便，并敷-切疮疖痈毒。\""}]},{"ID":"20240612171151-89k11pj","Type":"NodeParagraph","Properties":{"id":"20240612171151-89k11pj","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"主治下痢亦白，里急腹痛，小便淋沥，实热燥结，潮热谵语，黄疸，诸火疮。\""}]},{"ID":"20240612171151-dgo6goo","Type":"NodeParagraph","Properties":{"id":"20240612171151-dgo6goo","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612171151-hi8t2yl","Type":"NodeParagraph","Properties":{"id":"20240612171151-hi8t2yl","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤（用于泻下，不宜久煎），1～4钱；或入丸、散。外用：研末，水或醋调敷。"}]},{"ID":"20240612171151-llcdp8l","Type":"NodeParagraph","Properties":{"id":"20240612171151-llcdp8l","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612171151-hqys06v","Type":"NodeParagraph","Properties":{"id":"20240612171151-hqys06v","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" ①治伤寒阳明腑证，阳邪入里，肠中有燥屎，腹满痛，谵语，潮热，手足濈然汗出，不恶寒，痞满燥实全见者，，以此汤下之：大黄（酒洗）四两，厚朴（炙，去皮）半斤，枳实（炙）五枚，芒硝三合。上四味，以水一斗，先煮二物，取二升，去滓，纳大黄，更煮取二升，去滓，纳芒硝，更上微火一两沸，分温再服，得下，余勿服。（《伤寒论》大承气汤）"}]},{"ID":"20240612171151-1ns3si7","Type":"NodeParagraph","Properties":{"id":"20240612171151-1ns3si7","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②治大便秘结：大黄二两，牵牛头末五钱。上为细末，每服三钱。有厥冷，用酒调三钱，无厥冷而手足烦热者，蜜汤调下，食后微利为度。（《素问病机保命集》大黄牵牛丸）"}]},{"ID":"20240612171151-opq9joj","Type":"NodeParagraph","Properties":{"id":"20240612171151-opq9joj","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③治热病狂语及诸黄：川大黄五两（锉碎，微炒）。捣细罗为散，用腊月雪水五升，煎如膏，每服不计时侯，以冷水调半匙服之。（《圣惠方》雪煎方）"}]},{"ID":"20240612171151-jwgwqsz","Type":"NodeParagraph","Properties":{"id":"20240612171151-jwgwqsz","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"④治泄痢久不愈，脓血稠粘，里急后重，日夜无度，久不愈者：大黄一两，细锉，好酒二大盏，同浸半日许，再同煎至一盏半，去大黄不用，将酒分为二服，顿服之，痢止。一服如未止，再服，以利为度，服芍药汤和之，痢止，再服黄芩汤和之，以彻其毒也。（《素问病机保命集》大黄汤）"}]},{"ID":"20240612171151-orwtxz5","Type":"NodeParagraph","Properties":{"id":"20240612171151-orwtxz5","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑤治妇人经血不通，赤白带下，崩漏不止，肠风下血，五淋，产后积血，癥瘕腹痛，男子五劳七伤，小儿骨蒸潮热等证，其效甚速：锦纹大黄一斤，分作四份；一份用童尿一碗，食盐二钱，浸一日，切晒；一份用醇酒一碗，浸一日，切晒，再以巴豆仁三十五粒同炒，豆黄，去豆不用；一份用红花四两，泡水一碗，浸一日，切晒；一份用当归四两，入淡醋一碗，同浸一日，去归，切晒。为末，炼蜜丸梧子大，每服五十丸，空心温酒下，取下恶物为验。未下再服。（《医林集要》无极丸）"}]},{"ID":"20240612171151-pwpn3sv","Type":"NodeParagraph","Properties":{"id":"20240612171151-pwpn3sv","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑥治产后恶血冲心，或胎衣不下，腹中血块等：锦纹大黄一两，杵罗为末，用头醋半升，同熬成膏，丸如梧桐子大，用温醋化五丸服之，良久下。亦治马坠内损。（《千金方》）"}]},{"ID":"20240612171151-1teym9h","Type":"NodeParagraph","Properties":{"id":"20240612171151-1teym9h","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑦治久患腹内积聚，大小便不通，气上抢心，腹中胀满，逆害饮食：大黄、芍药各二两。上二味末之，蜜丸，服如梧桐子四丸，日三，不知，可加至六、七丸，以知为度。（《千金方》神明度命丸）"}]},{"ID":"20240612171151-fw60h26","Type":"NodeParagraph","Properties":{"id":"20240612171151-fw60h26","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑧治大人小儿脾癖，并有疳者：锦纹大黄三两，为极细末，陈醋两大碗，砂锅内文武火熬成膏，倾在新砖瓦上，日晒夜露三朝夜，将上药起下，再研为细末；后用硫黄一两，官粉一两，将前项大黄末一两，三味再研为细末。十岁以下小儿，每服可重半钱，食后临卧米饮汤调服。此药忌生硬冷荤鱼鸡鹅一切发物。服药之后，服半月白米软粥。如一服不愈时，半月之后再服。（《昔济方》于金散）"}]},{"ID":"20240612171151-w2vphgw","Type":"NodeParagraph","Properties":{"id":"20240612171151-w2vphgw","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑨去五脏湿热秽浊。治饮食停滞，胸脘胀痛，头晕口干，二便秘结：大黄十斤，切作小块，用泔水，浸透，以侧柏叶铺甑，入大黄，蒸过晒干，以好酒十斤浸之，再蒸收晒干。另用桑叶、桃叶、槐叶、大麦、黑豆、绿豆各一斤，每味煎汁蒸收，每蒸一次，仍用侧柏叶铺甑蒸过晒干，再蒸再晒。制后再用半夏、厚朴、陈皮、白术、香附、车前各一斤，每味煎汁蒸收如上法，蒸过晒干，再用好酒十斤，制透，炼蜜丸如梧子大，每服一、二钱，或为散亦可。（《银海指南》清宁丸）"}]},{"ID":"20240612171151-0u6emvj","Type":"NodeParagraph","Properties":{"id":"20240612171151-0u6emvj","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑩治时行头痛壮热一二日：桂心、甘草、大黄各二两，麻黄四两。上四味，治下筛，患者以生热汤浴讫，以暖水服方寸匕，日三，覆取汗，或利便瘥。丁强人服二方寸匕。（《千金方》水解散）"}]},{"ID":"20240612171151-me9zwe0","Type":"NodeParagraph","Properties":{"id":"20240612171151-me9zwe0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑾治眼暴热痛，眦头肿起：大黄（锉，炒）、枳壳（去瓤，麸炒）、芍药各三两，山栀子仁、黄芩（去黑心）各二两。上五味粗捣筛，每服五钱匕，水一盏半，煎至七分，去滓，食后临卧服。（《圣济总录》大黄汤）"}]},{"ID":"20240612171151-73t89x4","Type":"NodeParagraph","Properties":{"id":"20240612171151-73t89x4","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑿治心气不足，吐血衄血：大黄二两，黄连、黄芩各一两。上三味，以水三升，煮取一升，顿服之。（《金匮要略》泻心汤）"}]},{"ID":"20240612171151-kul9y5t","Type":"NodeParagraph","Properties":{"id":"20240612171151-kul9y5t","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒀治虚劳吐血：生地黄汁半升，川大黄末一方寸匕。上二味，温地黄汁一沸，纳人黄（末）搅之，空腹顿服，日三，瘥。（《千金方》）"}]},{"ID":"20240612171151-v8cwap0","Type":"NodeParagraph","Properties":{"id":"20240612171151-v8cwap0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒁治肠痈，少腹肿痞，按之即痛如淋，小便自调，时时发热，自汗出，复恶寒。其脉迟紧者，脓未成，可下之，当有血；脉洪数者，脓已成，不可下也：大黄四两，牡丹一两，桃仁五个个，瓜子半升，芒硝三合。上五味，以水六升，煮取一升，去滓，纳芒硝，再煮沸，顿服之，有脓当下，如无脓当下血。（《金匮要略》大黄牡丹汤）"}]},{"ID":"20240612171151-0k6p2qn","Type":"NodeParagraph","Properties":{"id":"20240612171151-0k6p2qn","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒂治肺壅，鼻中生疮，肿痛：㈠川大黄一分（生用），黄连一分（去须），麝香一钱（细研）。上药，捣细罗为散，研入麝香令匀，以生油旋调，涂于鼻中。㈠杏仁一分（汤浸，去皮、尖，研为膏），川大黄一分（生为末）。上药相和令匀，以猪脂调涂鼻中。（《圣惠方》）"}]},{"ID":"20240612171151-f51bvme","Type":"NodeParagraph","Properties":{"id":"20240612171151-f51bvme","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒃治奶痈：川大黄、粉草各一两。上为细末，以好酒熬成膏，倾在盏中放冷，摊纸上贴痛处，仰面卧至五更。贴时先用温酒调（服）一大匙，明日取下恶物，相度强弱用药，羸弱不宜服。（《妇人良方》金黄散）"}]},{"ID":"20240612171151-wfn2ug6","Type":"NodeParagraph","Properties":{"id":"20240612171151-wfn2ug6","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒄治痈肿振焮不可触：大黄捣筛，以苦酒和贴肿上，燥易，不过三，即瘥减不复作，脓自消除。（《补缺肘后方》）"}]},{"ID":"20240612171151-6q8hp6p","Type":"NodeParagraph","Properties":{"id":"20240612171151-6q8hp6p","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒅治口疮糜烂：大黄、枯矾等分。为末以擦之，吐涎。（《圣惠方》）"}]},{"ID":"20240612171151-jq8zt9m","Type":"NodeParagraph","Properties":{"id":"20240612171151-jq8zt9m","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒆诒火丹赤肿遍身：大黄磨水频刷之。（《救急方》）"}]},{"ID":"20240612171151-h5gkbb9","Type":"NodeParagraph","Properties":{"id":"20240612171151-h5gkbb9","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⒇治冻疮皮肤破烂，痛不可忍：川大黄为末，新汲水调，搽冻破疮上。（《卫生宝鉴》如神散）"}]},{"ID":"20240612171151-ygy6gog","Type":"NodeParagraph","Properties":{"id":"20240612171151-ygy6gog","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"（21）治汤火灼伤：庄浪大黄（生研），蜜调涂之，不唯止痛，又且灭瘢。（《夷坚志》）"}]},{"ID":"20240612171151-cifar00","Type":"NodeParagraph","Properties":{"id":"20240612171151-cifar00","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"（22）治从高坠下，及木石所压，凡是伤损，瘀血凝积，气绝欲死，并久积瘀血，烦躁疼痛，叫呼不得及折伤等：大黄一两（酒蒸），杏仁三七粒（去皮、尖）.上研细，酒一碗，煎至六分，去滓，鸡鸣时服，次日取下瘀血即愈。若便觉气绝不能言，取药不及，急擘开口，以热小便灌之。（《三因方》鸡鸣散）"}]},{"ID":"20240612171151-l2ovsxt","Type":"NodeParagraph","Properties":{"id":"20240612171151-l2ovsxt","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"（23）治打仆伤痕，瘀血滚注，或作潮热者：大黄末、姜汁调涂。一夜，黑者紫，二夜，紫者白也。（《濒湖集简方》）"}]},{"ID":"20240612171151-oxzpj19","Type":"NodeParagraph","Properties":{"id":"20240612171151-oxzpj19","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612171151-zf0ns80","Type":"NodeParagraph","Properties":{"id":"20240612171151-zf0ns80","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" ①用于血小板减少症及止血"}]},{"ID":"20240612171151-7aa798z","Type":"NodeParagraph","Properties":{"id":"20240612171151-7aa798z","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用酒洗大黄10克，甘油5毫升，苯甲醇2毫升，制成注射液100毫升。每次2毫升，肌肉注射。对血小板减少症每日1次，手术后止血用每日2次。亦有用生大黄9钱，石灰1两，文火炒拌，直至石灰呈灰粉红色时取出，加入明矾（每100克石灰加入明矾0.6克）共研细粉。将此粉16克加水至100毫升，振荡后沉淀过滤。用时取棉球浸药水压迫出血处。经应用于500余人次外伤出血，证明止血效果良好，未见不良反应及副作用。此外，对晚期血吸虫病食道静脉破裂出血患者，用大黄炭1.6克，白芍炭1.6克，加葡萄糖粉（或细白糖）30克共研细末，小量分次干吞（于1天内吞完）。治疗10例，均达到止血效果。一般平均在7～8天能起床活动.服用该药后可见恶心消失、胃部舒适、大便逐渐恢复正常，并无迅速腹水蓄积后遗症出现。"}]},{"ID":"20240612171151-ap439rr","Type":"NodeParagraph","Properties":{"id":"20240612171151-ap439rr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"②治疗口腔炎、口唇溃疡及毛囊炎等"}]},{"ID":"20240612171151-po7h1ap","Type":"NodeParagraph","Properties":{"id":"20240612171151-po7h1ap","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用生大黄3～8钱，煎取150～500毫升（每剂最多使用2天），供漱口、湿热敷及洗涤用，每天4～6次。治疗前先清洗局部，除净分泌物。本法对于一般金黄色葡萄球菌感染的口腔炎、口唇溃疡、皮肤毛囊炎及头部疖肿等炎性疾患均有效，局部培养金黄色葡萄球菌的转阴日数亦比较迅速。"}]},{"ID":"20240612171151-wgqiuaq","Type":"NodeParagraph","Properties":{"id":"20240612171151-wgqiuaq","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"③治疗烫伤"}]},{"ID":"20240612171151-qi2p5zr","Type":"NodeParagraph","Properties":{"id":"20240612171151-qi2p5zr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"先取陈石灰10斤除净杂质，过筛，投入锅内用文火炒松，再投人大黄片5斤，共同拌炒，俟石灰炒至带桃红色、大黄炒至灰黑色时，即出锅筛去石灰；将大黄摊开冷却后研成细粉备用。用时先以生理盐水清洗创面，而后撒布大黄粉。如有水泡应刺破；拨开表皮，排净泡液后再撒药粉。如仅见局部红肿，则可用麻油或桐油将大黄粉调成糊状涂患处。换药时如发现伤处溃烂，应拭去脓液、脓痴后再撒药粉。在夏季可行暴露疗法。共治疗415例，均获显著效果，且疗程短，无副作用，愈后无疤痕。"}]},{"ID":"20240612171151-un6cdz6","Type":"NodeParagraph","Properties":{"id":"20240612171151-un6cdz6","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"④治疗臁疮（下肢溃疡）"}]},{"ID":"20240612171151-rbndy9l","Type":"NodeParagraph","Properties":{"id":"20240612171151-rbndy9l","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用生大黄5～7钱，研成极细粉末；另取甘草捶碎，去净纤维，取细粉约为大黄的1／5量，共研极细。先用温开水洗净疮面，揩干后均匀撤布药粉，再用\"千层\"（又名千张或百页，为纯黄豆制成品，以薄而韧者为良）覆盖包好。如有渗液外流，可听其自然，第2天再洗。每日换药1次。轻者换药3～6次，重者8～9次，即可新生肉芽。此时不可再洗，药粉可少用或不用，但\"千层\"必需每日一换。当结痂牢固时会发生痒感，不可揭去痂盖，隔5～7日或7日以上，痴盖自然脱落。治疗12例均愈，其中1例病程达13年，经用药粉6日，贴\"千层\"20余日，便结痴而愈。"}]},{"ID":"20240612171151-oo0pgf8","Type":"NodeParagraph","Properties":{"id":"20240612171151-oo0pgf8","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑤治疗小儿蛔虫性肠梗阻"}]},{"ID":"20240612171151-b6wm428","Type":"NodeParagraph","Properties":{"id":"20240612171151-b6wm428","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用大黄粉蜜合剂（生大黄粉5钱，炒至微黄的米粉3钱，蜂蜜2两，加适量温开水调匀），每小时服1次，每次约1汤匙，全剂分12次服完；至排出蛔虫为止。经治6例均排出蛔虫，症状解除而愈。排虫最多者达60余条。排虫后均无持续腹泻现象。"}]},{"ID":"20240612171151-7ktlbmh","Type":"NodeParagraph","Properties":{"id":"20240612171151-7ktlbmh","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"⑥治疗肠胀气"}]},{"ID":"20240612171151-swdlulb","Type":"NodeParagraph","Properties":{"id":"20240612171151-swdlulb","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用大黄1两研成细末，加适量醋调成糊状，敷于两侧涌泉穴上，每次二小时，必要时可敷2～3次。临床观察6例，一般敷药后一小时即出现肠腔蠕动感和肛门排气现象，自觉腹胀减轻，有肠鸣音。"}]},{"ID":"20240612171151-pf9r44e","Type":"NodeParagraph","Properties":{"id":"20240612171151-pf9r44e","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612171151-fryyiw0","Type":"NodeParagraph","Properties":{"id":"20240612171151-fryyiw0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 另有一种山大黄为同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"波叶大黄"},{"Type":"NodeText","Data":"的根茎及根，又称苦大黄。常呈不规则圆柱形，外表红褐色而黄，无横纹，质坚而轻，断面无星点，无锦纹，有细密而直的红棕色射线。气不香，味苦而涩。质次。服后有腹痛感。"}]},{"ID":"20240612171151-l1f54r3","Type":"NodeParagraph","Properties":{"id":"20240612171151-l1f54r3","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612171151-o7kzgpo","Type":"NodeParagraph","Properties":{"id":"20240612171151-o7kzgpo","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612171151-3u6ppjl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171151-3u6ppjl","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"《中华本草》：大黄"}]},{"ID":"20240612171151-teno90p","Type":"NodeParagraph","Properties":{"id":"20240612171151-teno90p","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612171151-4z2lr3j","Type":"NodeParagraph","Properties":{"id":"20240612171151-4z2lr3j","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" Dài Huánɡ"}]},{"ID":"20240612171151-nmvndsr","Type":"NodeParagraph","Properties":{"id":"20240612171151-nmvndsr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612171151-vv77t1x","Type":"NodeParagraph","Properties":{"id":"20240612171151-vv77t1x","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 将军、黄良、火参、肤如、蜀大黄、锦纹大黄、牛舌大黄、锦纹、生军、川军"}]},{"ID":"20240612171151-nf4bihx","Type":"NodeParagraph","Properties":{"id":"20240612171151-nf4bihx","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612171151-movzoaq","Type":"NodeParagraph","Properties":{"id":"20240612171151-movzoaq","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 药材基源："}]},{"ID":"20240612171151-b0qc4ix","Type":"NodeParagraph","Properties":{"id":"20240612171151-b0qc4ix","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Rheum palmatum L．2．Rheum palmatum L. var． tanguticumMaxim．Ex Rngel．［R．Tanguticum Maxim．Ex Balf．］3．Rheum officinale Baill．Radix et Rhizoma Rhei"}]},{"ID":"20240612171151-mq9s0hg","Type":"NodeParagraph","Properties":{"id":"20240612171151-mq9s0hg","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612171151-267i295","Type":"NodeParagraph","Properties":{"id":"20240612171151-267i295","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 胃；大肠；肝；脾经"}]},{"ID":"20240612171151-rsomg97","Type":"NodeParagraph","Properties":{"id":"20240612171151-rsomg97","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612171151-pl0p6kk","Type":"NodeParagraph","Properties":{"id":"20240612171151-pl0p6kk","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612171151-omv3am4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171151-omv3am4","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：大黄"}]},{"ID":"20240612171151-wjzofgr","Type":"NodeParagraph","Properties":{"id":"20240612171151-wjzofgr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612171151-1ba858n","Type":"NodeParagraph","Properties":{"id":"20240612171151-1ba858n","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" Dài Huánɡ"}]},{"ID":"20240612171151-qbbsx8k","Type":"NodeParagraph","Properties":{"id":"20240612171151-qbbsx8k","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612171151-3ups4ys","Type":"NodeParagraph","Properties":{"id":"20240612171151-3ups4ys","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 香大黄、马蹄黄、将军、生军"}]},{"ID":"20240612171151-earm1ck","Type":"NodeParagraph","Properties":{"id":"20240612171151-earm1ck","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612171151-c1voiod","Type":"NodeParagraph","Properties":{"id":"20240612171151-c1voiod","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 为蓼科大黄属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌叶大黄"},{"Type":"NodeText","Data":"Rheum palmatum L.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄"},{"Type":"NodeText","Data":"R. officinale Baill.，或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鸡爪大黄"},{"Type":"NodeText","Data":"R. tanguticum Maxim. et Regel以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根状茎"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240612171151-4b0ygd8","Type":"NodeParagraph","Properties":{"id":"20240612171151-4b0ygd8","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612171151-rcu3tmz","Type":"NodeParagraph","Properties":{"id":"20240612171151-rcu3tmz","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 1、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"掌叶大黄"},{"Type":"NodeText","Data":"多年生草本，高达2米。地下有粗壮的肉质根及根状茎。茎粗壮，中空，绿色，平滑，无毛，有不甚明显的纵纹。单叶互生；具粗壮长柄，柄上密生白色短刺毛；基生叶叶片圆形或卵圆形，长宽近相等，达35厘米，掌状5～7深裂，裂片矩圆形或宽披针形，先端尖，边缘有大的尖裂齿，叶上面疏生乳头状小突起和白色短刺毛，下面有白色柔毛，以脉上为多，并疏生黑色腺点，叶基部心形；茎生叶较小，有短柄；托叶鞘大，筒状，绿色，有纵纹，密生白色短柔毛。秋季开淡黄白色花，大圆锥花序顶生；花梗纤细，中下部有关节；花被6裂，长约1.5毫米，排为2轮；雄蕊9个。瘦果矩卵圆形，有3棱，沿棱生翅，翅边缘半透明，顶端稍凹陷，基部呈心形。"}]},{"ID":"20240612171151-vpjr350","Type":"NodeParagraph","Properties":{"id":"20240612171151-vpjr350","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"生于高寒山区、土壤湿润的草坡上，华北有栽培。分布于甘肃、青海、宁夏、四川及西藏等省区。"}]},{"ID":"20240612171151-hgpcsbl","Type":"NodeParagraph","Properties":{"id":"20240612171151-hgpcsbl","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"2、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄"},{"Type":"NodeText","Data":"与上种不同之处在于本种基生叶为5浅裂，边缘有粗锯齿；托叶鞘膜质，比较透明，上有短毛。花淡黄绿色，翅果边缘不透明。"}]},{"ID":"20240612171151-2k65d05","Type":"NodeParagraph","Properties":{"id":"20240612171151-2k65d05","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"生于大山草坡上与土壤肥厚、阳光充足的地方。分布于陕西、湖北、四川和云南等省区。"}]},{"ID":"20240612171151-nadjzxo","Type":"NodeParagraph","Properties":{"id":"20240612171151-nadjzxo","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"3、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鸡爪大黄"},{"Type":"NodeText","Data":"与前两种相似，唯本种的叶裂极深，裂片常再二回深裂，裂片窄长。花序分枝紧密，向上直立，紧贴于茎。"}]},{"ID":"20240612171151-bxxay8y","Type":"NodeParagraph","Properties":{"id":"20240612171151-bxxay8y","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"生于山地灌木林下或林缘较阴湿地方。分布于甘肃、青海、四川及西藏等省区。"}]},{"ID":"20240612171151-vutj2lu","Type":"NodeParagraph","Properties":{"id":"20240612171151-vutj2lu","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612171151-ja475t5","Type":"NodeParagraph","Properties":{"id":"20240612171151-ja475t5","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 喜凉爽气候，耐严寒。因其颇喜阳光，故应选阳光充足、土层深厚的砂质壤土及石灰质壤土地区栽培。种子繁殖，在南部地区，最好秋播。春播越早越好，播前将种子放18～20℃水中，浸6～8小时，取出用湿布覆盖，每天需翻动和用水冲1～2次，当有1～2%出芽时，立即穴播，行、株距2.5×2尺，穴深1寸，每穴播种5～8粒，覆土5、6分，为了预防地下害虫为害，每亩可施6%六六六粉3斤。"}]},{"ID":"20240612171151-m7pwuzw","Type":"NodeParagraph","Properties":{"id":"20240612171151-m7pwuzw","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612171151-moh3qhl","Type":"NodeParagraph","Properties":{"id":"20240612171151-moh3qhl","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 掌叶大黄、大黄及鸡爪大黄的根状茎和根中含有蒽醌类化合物约3%，包括游离和结合状态的大黄酚（chrysophanol）、大黄酸（rhein）、芦荟大黄素（aloe-emodin）、大黄素（emodin）、蜈蚣苔素（parietin，C"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"22"},{"Type":"NodeText","Data":"H"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"22"},{"Type":"NodeText","Data":"O"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"10"},{"Type":"NodeText","Data":"）、大黄素甲醚（emodinmonomethyl ether），其主要的泻下成分为结合性大黄酸蒽酮-番泻甙A. B. C（sennoside A. B. C）其中番泻甙A（sennoside A）为主要有效成分。此外，尚含鞣质约5%以及游离没食子酸、桂皮酸及其脂类等。叶含槲皮甙，惟掌叶大黄的叶以金丝桃甙（hyperoside）含量最多。"}]},{"ID":"20240612171151-ejbzcaw","Type":"NodeParagraph","Properties":{"id":"20240612171151-ejbzcaw","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612171151-4k6uheh","Type":"NodeParagraph","Properties":{"id":"20240612171151-4k6uheh","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 1、掌叶大黄及鸡爪大黄泻下的有效成分是结合状态的大黄酸和类似物。本品因含鞣质及没食子酸等，又具收敛作用，故大剂量使用大黄时先泻后便秘。若煎药时间过长，则蒽醌类化合物及结核性大黄酸和其类似物破坏较多，鞣酸等成分大量煎出，故仅有致便秘作用，而无泻下作用。"}]},{"ID":"20240612171151-j7sobpm","Type":"NodeParagraph","Properties":{"id":"20240612171151-j7sobpm","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"2、有增加血小板、促进血液凝固等止血作用。"}]},{"ID":"20240612171151-zq1olpr","Type":"NodeParagraph","Properties":{"id":"20240612171151-zq1olpr","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"3、本品可促进胆汁等消化液分泌，有利胆、排石和增进消化作用。"}]},{"ID":"20240612171151-ku1814j","Type":"NodeParagraph","Properties":{"id":"20240612171151-ku1814j","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"4、大黄酊剂、浸剂经家兔试验有降压作用，其中以酊剂效果较好。"}]},{"ID":"20240612171151-dgzzbf5","Type":"NodeParagraph","Properties":{"id":"20240612171151-dgzzbf5","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"5、大黄素对抗乙酰胆碱引起的小鼠离体肠痉挛作用强于对抗豚鼠气管痉挛的作用。"}]},{"ID":"20240612171151-03mntnw","Type":"NodeParagraph","Properties":{"id":"20240612171151-03mntnw","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"6、本品有降低血清高胆固醇的作用。"}]},{"ID":"20240612171151-wa4k6nh","Type":"NodeParagraph","Properties":{"id":"20240612171151-wa4k6nh","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"7、掌叶大黄及大黄酸、大黄素均有利尿作用，以大黄酸作用最强。"}]},{"ID":"20240612171151-8762nwh","Type":"NodeParagraph","Properties":{"id":"20240612171151-8762nwh","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"8、抑菌试验：大黄的抗菌作用强，抗菌谱广，其有效成分已证明为蒽醌衍生物，其中以大黄酸、大黄素和芦荟大黄素的抗菌作用最好。大黄酸和大黄素对金黄色葡萄球菌的最低抑菌浓度分别为15微克/毫升及10微克/毫升。此外对痢疾杆菌、伤寒杆菌、霍乱弧菌、大肠杆菌、绿脓杆菌、葡萄球菌、链球菌、肺炎双球菌、白喉杆菌、炭疽杆菌及皮肤真菌等均有抗菌作用。"}]},{"ID":"20240612171151-nxiiudz","Type":"NodeParagraph","Properties":{"id":"20240612171151-nxiiudz","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612171151-jdc17fb","Type":"NodeParagraph","Properties":{"id":"20240612171151-jdc17fb","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 1、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒大黄"},{"Type":"NodeText","Data":"将大黄片用黄酒喷洒拌匀，微润后放锅内稍炒，取出晾干（每100斤用黄酒10斤）。"}]},{"ID":"20240612171151-m11d4ta","Type":"NodeParagraph","Properties":{"id":"20240612171151-m11d4ta","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"2、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄炭"},{"Type":"NodeText","Data":"将大黄片放锅内，炒至外面黑棕色，"}]},{"ID":"20240612171151-zmfv067","Type":"NodeParagraph","Properties":{"id":"20240612171151-zmfv067","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"3、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"熟大黄"},{"Type":"NodeText","Data":"①将大黄块用黄酒拌匀，放罐内或其他容器内，封严，置于加水的锅中，蒸至酒被吸尽，取出晾干（每100斤用黄酒30～50斤）。②将大黄切成小方块放罐内或其他容器内，封严，置于加水的锅中蒸透，取出晾干或烘干。"}]},{"ID":"20240612171151-lnzn25k","Type":"NodeParagraph","Properties":{"id":"20240612171151-lnzn25k","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612171151-1sqqx5l","Type":"NodeParagraph","Properties":{"id":"20240612171151-1sqqx5l","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612171151-1o43gmh","Type":"NodeParagraph","Properties":{"id":"20240612171151-1o43gmh","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612171151-tjlqvpt","Type":"NodeParagraph","Properties":{"id":"20240612171151-tjlqvpt","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 泻实热，破积滞，行瘀血。主治：实热便秘，食积停滞，腹痛，急性阑尾炎，急性传染性肝炎，血瘀经闭，牙痛，衄血，急性结膜炎；外用治烧烫伤，化脓性皮肤病，痈肿疮疡。"}]},{"ID":"20240612171151-q9z5loa","Type":"NodeParagraph","Properties":{"id":"20240612171151-q9z5loa","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612171151-0z6r0o0","Type":"NodeParagraph","Properties":{"id":"20240612171151-0z6r0o0","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 1～4钱；外用适量。"}]},{"ID":"20240612171151-o7y06z9","Type":"NodeParagraph","Properties":{"id":"20240612171151-o7y06z9","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612171151-vng7cz1","Type":"NodeParagraph","Properties":{"id":"20240612171151-vng7cz1","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 1、便秘：①大黄2钱，火麻仁5钱，水煎服。用于一般便秘。②酒大黄1.5两，桃仁6钱，木香、炒枳实、柴胡各5钱，甘草4钱，共研细末，为蜜丸，早晚各服2钱。用于习惯性便秘。"}]},{"ID":"20240612171151-amzs61q","Type":"NodeParagraph","Properties":{"id":"20240612171151-amzs61q","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"2、实热便秘，食积停滞：大黄、厚朴各3钱，枳实2钱，水煎；另加芒硝2钱冲服。"}]},{"ID":"20240612171151-rx86gor","Type":"NodeParagraph","Properties":{"id":"20240612171151-rx86gor","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"3、急性阑尾炎：大黄4钱，丹皮、元明粉各3钱（元明粉分2次冲服），冬瓜子、桃仁各5钱。每日1剂，水煎分2次服。"}]},{"ID":"20240612171151-mzm7cup","Type":"NodeParagraph","Properties":{"id":"20240612171151-mzm7cup","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"4、急性机械性、粘连性及蛔虫性肠梗阻，气胀较重者：大黄（后下）、赤芍各5钱，炒莱菔子、厚朴各1两，枳壳、桃仁各3钱，芒硝（冲服）3～5钱。水煎服。"}]},{"ID":"20240612171151-nhi1tas","Type":"NodeParagraph","Properties":{"id":"20240612171151-nhi1tas","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"5、疳积：大黄、芒硝、栀子、杏仁、桃仁各2钱。共研细粉，加面粉适量与鸡蛋1个，共捣烂成糊状，敷于脐部，24小时后除去，局部呈紫青色即可。"}]},{"ID":"20240612171151-oadeq4d","Type":"NodeParagraph","Properties":{"id":"20240612171151-oadeq4d","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"6、神经性皮炎，脂溢性皮炎，过敏性皮炎：大黄、栀子、白芷各2钱，黄连、滑石、苍术、青黛、石膏各1斤，甘草3.5斤，姜黄2.5斤，骨碎补1.5斤。上药除青黛外，共研细粉与青黛混匀备用。取药粉适量，调麻油摊于纱布上敷患处，每日2～3次。"}]},{"ID":"20240612171151-ru4nap5","Type":"NodeParagraph","Properties":{"id":"20240612171151-ru4nap5","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"7、脓胞疮：大黄、黄连各3钱，黄柏1钱，煅石膏2钱，共研细末，香油调搽患处。"}]},{"ID":"20240612171151-s6x98mn","Type":"NodeParagraph","Properties":{"id":"20240612171151-s6x98mn","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"8、牙痛：生大黄2两，用75%酒精或好酒浸泡1个月，过滤备用。以棉球蘸药液放于牙痛处，5分钟后，吐掉棉球，每日2次。"}]},{"ID":"20240612171151-3ag2bot","Type":"NodeParagraph","Properties":{"id":"20240612171151-3ag2bot","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"9、烧伤：大黄5斤，陈石灰7斤。先将石灰炒热后，再放入大黄，炒至石灰变桃红色，大黄变黑灰色时，筛去石灰，将大黄晾凉，研成细粉，撒在伤面；如只红肿，可将大黄粉调麻油或桐油外涂。冷天注意保温。"}]},{"ID":"20240612171151-2sjzc7y","Type":"NodeParagraph","Properties":{"id":"20240612171151-2sjzc7y","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"制法"}]},{"ID":"20240612171151-ybk69wb","Type":"NodeParagraph","Properties":{"id":"20240612171151-ybk69wb","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 栽培2～3年后，与野生品一样，在秋末冬初叶枯萎时，挖去地下部分，除去粗皮，切片晒干或烘干备用。"}]},{"ID":"20240612171151-tvy8lxx","Type":"NodeParagraph","Properties":{"id":"20240612171151-tvy8lxx","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612171151-918hima","Type":"NodeParagraph","Properties":{"id":"20240612171151-918hima","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"新疆大黄"},{"Type":"NodeText","Data":"Rheum wittrockii Lundstr.叶片圆形，先端尖，边缘有细缺刻。分布于新疆。在当地也作大黄入药。"}]},{"ID":"20240612171151-hje6bu5","Type":"NodeParagraph","Properties":{"id":"20240612171151-hje6bu5","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612171151-alsnexu","Type":"NodeParagraph","Properties":{"id":"20240612171151-alsnexu","updated":"20240612171151"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612171152-u9wlehu","Type":"NodeThematicBreak","Properties":{"id":"20240612171152-u9wlehu"}},{"ID":"20240612171153-iyerab5","Type":"NodeParagraph","Properties":{"id":"20240612171153-iyerab5"}}]}