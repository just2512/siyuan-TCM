: style=\"width: 718px;\" parent-style=\"width: 728px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 492px;","style":"width: 482px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"巴豆 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/巴豆 2-20240826132744-zs5hzfi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 482px;\" parent-style=\"width: 492px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702110058-uk1atcq","Type":"NodeParagraph","Properties":{"id":"20240702110058-uk1atcq","updated":"20240826134532"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 608px;","style":"width: 598px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"巴豆1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/巴豆1-20240702110115-7ob5168.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 598px;\" parent-style=\"width: 608px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"巴豆 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/巴豆 3-20240826132843-zp53ser.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826143030-cqbf4b2","Type":"NodeParagraph","Properties":{"id":"20240826143030-cqbf4b2","updated":"20240826143039"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 532px;","style":"width: 522px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"巴豆 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/巴豆 17-20240826143030-7bu4wi4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 522px;\" parent-style=\"width: 532px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 498px;","style":"width: 488px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"巴豆 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/巴豆 15-20240826142711-lvxme2z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 488px;\" parent-style=\"width: 498px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613125308-tenx84l","Type":"NodeThematicBreak","Properties":{"id":"20240613125308-tenx84l"}},{"ID":"20240613125413-b8065jc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125413-b8065jc","updated":"20240613125419"},"Children":[{"Type":"NodeText","Data":"巴豆《神农本草经》"}]},{"ID":"20240613125413-jic8o7h","Type":"NodeParagraph","Properties":{"id":"20240613125413-jic8o7h","updated":"20240613125413"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240613125413-bot185p","Type":"NodeParagraph","Properties":{"id":"20240613125413-bot185p","updated":"20240613125413"},"Children":[{"Type":"NodeText","Data":"主伤寒，温疟，寒热，破症瘕结聚，坚积，留饮，淡癖，大腹水张，荡练五藏六府，开通闭塞，利水谷道，去恶内，除鬼毒蛊注邪物（《御览》作鬼毒邪注），杀虫鱼，一名巴叔（旧作椒，《御览》作菽），生川谷。"}]},{"ID":"20240613125413-0s3wvcr","Type":"NodeParagraph","Properties":{"id":"20240613125413-0s3wvcr","updated":"20240613125413"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：巴豆，一名巴菽，神农岐伯桐君辛有毒，黄帝甘有毒，李氏主温热寒，叶如大豆，八月采（《御览》）。"}]},{"ID":"20240613125413-82pj9l2","Type":"NodeParagraph","Properties":{"id":"20240613125413-82pj9l2","updated":"20240613125413"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生巴郡，八月采，阴干，用之，去心皮。"}]},{"ID":"20240613125413-aalqqc4","Type":"NodeParagraph","Properties":{"id":"20240613125413-aalqqc4","updated":"20240613125413"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：巴菽，巴豆也。《列仙传》云：元俗饵巴豆。《淮南子》说林训云：鱼食巴菽而死，人食之而肥。"}]},{"ID":"20240613125426-km6g353","Type":"NodeThematicBreak","Properties":{"id":"20240613125426-km6g353"}},{"ID":"20240613125427-46elqui","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125427-46elqui","updated":"20240613125431"},"Children":[{"Type":"NodeText","Data":"巴豆《新修本草》"}]},{"ID":"20240613125427-hevj7yj","Type":"NodeParagraph","Properties":{"id":"20240613125427-hevj7yj","updated":"20240613125427"},"Children":[{"Type":"NodeText","Data":"味辛，温、生温、熟寒，有大毒。主伤寒，温疟，寒热，破症瘕，结坚积聚，留饮痰 ，大腹水胀，荡练五脏六腑，开通闭塞，利水谷道，去恶肉，除鬼蛊毒疰、邪物，杀虫鱼。疗女子月闭，烂胎，金创，脓血，不利丈夫阴，杀斑蝥毒。"}]},{"ID":"20240613125427-b9z91yg","Type":"NodeParagraph","Properties":{"id":"20240613125427-b9z91yg","updated":"20240613125427"},"Children":[{"Type":"NodeText","Data":"可炼饵之，益血脉，令人色好，变化与鬼神通。一名巴椒。生巴郡山谷。八月采实，阴干之，用去心皮。"}]},{"ID":"20240613125427-idttpjd","Type":"NodeParagraph","Properties":{"id":"20240613125427-idttpjd","updated":"20240613125427"},"Children":[{"Type":"NodeText","Data":"芫花为之使，恶 草，畏大黄、黄连、藜芦。出巴郡，似大豆，最能利人，新者佳。用之皆去心皮乃称，又熬令黄黑，别捣如膏，乃合和丸散耳。道方亦有炼饵法，服之乃言神仙。人吞一枚，便欲死，而鼠食之，三年重卅斤，物性乃有相耐如此耳。"}]},{"ID":"20240613125427-1pcqc6z","Type":"NodeParagraph","Properties":{"id":"20240613125427-1pcqc6z","updated":"20240613125427"},"Children":[{"Type":"NodeText","Data":"〔谨案〕树高丈余，叶似樱桃叶，头微尖，十二月叶渐凋，至四月落尽，五月叶渐生，七月花，八月结实，九月成，十月采其子，三枚共蒂，各有壳裹。出眉州、嘉州者良。"}]},{"ID":"20240613125438-biof2up","Type":"NodeThematicBreak","Properties":{"id":"20240613125438-biof2up"}},{"ID":"20240613125440-rwlyrfz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125440-rwlyrfz","updated":"20240613125446"},"Children":[{"Type":"NodeText","Data":"巴豆《本草从新》"}]},{"ID":"20240613125440-p09ayj8","Type":"NodeParagraph","Properties":{"id":"20240613125440-p09ayj8","updated":"20240613125440"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、大燥大泻．"}]},{"ID":"20240613125440-4f69o9u","Type":"NodeParagraph","Properties":{"id":"20240613125440-4f69o9u","updated":"20240613125440"},"Children":[{"Type":"NodeText","Data":"辛而大热大毒．开窍宣滞．去脏腑沉寒．最为斩关夺门之将．（大黄巴豆、同为峻下之剂、但大黄性寒、腑病多热者宜之、巴豆性热、腑病多寒者宜之、故仲景治伤寒传里多热者、多用大黄、东垣治五积属脏者、多用巴豆．）破痰癖血瘕．气痞食积．生冷硬物所伤．"}]},{"ID":"20240613125440-eg4vz80","Type":"NodeParagraph","Properties":{"id":"20240613125440-eg4vz80","updated":"20240613125440"},"Children":[{"Type":"NodeText","Data":"大腹水肿泻痢．（时珍曰∶一妇年六十、溏泻五载、投生冷油腻肉食、即作痛、服升涩药、泻反甚、脉沉而滑、此乃脾胃久伤、积食凝滞、法当以热下之、用蜡匮巴豆丸五十粒、服二日、不利而愈、自是每用治泻痢、愈者近百人．）惊痫口 ．耳聋牙疼喉痹．（缠喉急痹、缓治则死、用解毒丸、雄黄一两、郁金一钱、巴豆十四粒、去皮油为丸、每服五分、津咽下、雄黄破结气、郁金散恶血、巴豆下稠涎、然系厉剂、不可轻用、或用纸拈蘸巴豆油、然火刺喉、或捣巴豆绵裹、随左右纳鼻、吐出恶涎紫血、即宽、鼻虽少生疮、无碍．）杀虫．通经烂胎．油作纸拈．然火吹息．"}]},{"ID":"20240613125440-aojqcc8","Type":"NodeParagraph","Properties":{"id":"20240613125440-aojqcc8","updated":"20240613125440"},"Children":[{"Type":"NodeText","Data":"或熏鼻．或刺喉．能出恶涎恶血．治中风中恶．痰厥气厥．喉痹不通．一切急病．元素曰．不可轻用．郁滞虽开．真阴随损．以少许着肌肤．即起泡．况肠胃柔薄之质．无论下后耗损真阴．即脏腑被其熏灼．能无溃烂之患耶．万不得已．"}]},{"ID":"20240613125440-tqm9xka","Type":"NodeParagraph","Properties":{"id":"20240613125440-tqm9xka","updated":"20240613125440"},"Children":[{"Type":"NodeText","Data":"亦须炒熟去或用壳用仁用油．生用炒用．醋煮．烧存性用．（好古曰∶去心皮膜油、生用、为急治水谷道路之剂、炒去烟、令紫黑用、为缓治消坚磨积之剂、可以通肠、可以止泻也．）去油名巴豆霜．芫花为使．畏大黄、黄连、凉水．（中其毒者、以此解之、或黑豆绿豆汁、亦佳．）得火良．（疣痣黑子、巴豆一钱、锻石拌过、人信一钱、糯米五分、炒研点之．）根皮、治痈疽发背．脑疽鬓疽．（掘取洗捣、敷患处、留头、妙不可言．收根阴干、临时水捣、亦可．）"}]},{"ID":"20240613125308-8osxg6y","Type":"NodeThematicBreak","Properties":{"id":"20240613125308-8osxg6y"}},{"ID":"20240613125354-rq00i5c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125354-rq00i5c","updated":"20240613125405"},"Children":[{"Type":"NodeText","Data":"巴豆《证类本草》"}]},{"ID":"20240613125354-tpzm5zn","Type":"NodeParagraph","Properties":{"id":"20240613125354-tpzm5zn","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"味辛，温，生温熟寒，有大毒。主伤寒温疟寒热，破症瘕结聚坚积，留饮痰癖，大腹水胀，荡练五脏六腑，开通闭塞，利水谷道，去恶肉，除鬼毒蛊疰邪物，杀虫鱼，疗女子月闭，烂胎，金疮脓血，不利丈夫阴，杀斑蝥毒。可练饵之，益血脉，令人色好，变化与鬼神通。一名巴椒。生巴郡川谷。八月采，阴干。用之去心、皮。（芫花为之使，恶 草，畏大黄、黄连、藜芦。）"}]},{"ID":"20240613125354-3xum5s7","Type":"NodeParagraph","Properties":{"id":"20240613125354-3xum5s7","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶出巴郡。似大豆，最能泻人，新者佳，用之皆去心皮，乃秤。又熬令黄黑，别捣如膏，乃和丸散尔。道方∶亦有练饵法服之乃言神仙。人吞一枚便欲死。而鼠食之，三年重三十斤，物性乃有相耐如此尔。唐本注云∶树高丈余。叶似樱桃叶，头微赤，十二月叶渐凋，至四月落尽，五月叶渐生，七月花，八月结实，九月成，十月采。其子三枚共蒂，各有壳裹。出眉州、嘉州者良。今按 陈藏器本草云∶巴豆，主症癖 气，痞满，腹内积聚，冷气血块，宿食不消，痰饮吐水。取青黑大者，每日空腹服一枚，去壳，勿令白膜破，乃作两片（并四边不得有缺损）吞之，以饮压令下。少间腹内热如火，痢出恶物。虽痢不虚，若久服亦不痢。白膜破者弃之。生南方。树大如围，极高，不啻一丈也。臣禹锡等谨按药性论云∶巴豆，使。中其毒，用黄连汁、大豆汁解之。忌芦笋、酱、豉、冷水，得火良。杀斑蝥、蛇虺毒。能主破心腹聚结气，治十种水肿，痿痹，大腹，能落胎。日华子云∶通宣一切病，泄壅滞，除风补劳，健脾开胃，消痰破血，排脓消肿毒，杀腹脏虫，治恶疮息肉及疥癞疔肿。"}]},{"ID":"20240613125354-xm2mdqf","Type":"NodeParagraph","Properties":{"id":"20240613125354-xm2mdqf","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"凡合丸散，炒不如去心膜煮五度，换水各煮一沸。"}]},{"ID":"20240613125354-8meyano","Type":"NodeParagraph","Properties":{"id":"20240613125354-8meyano","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"图经曰∶巴豆，出巴郡川谷。今嘉、眉、戎州皆有之。木高一、二丈。叶如樱桃而浓大，初生青，后渐黄赤，至十二月叶渐凋，二月复渐生，至四月旧叶落尽，新叶齐生，即花发成穗，微黄色。五、六月结实作房，生青，至八月熟而黄，类白豆蔻，渐渐自落，即收之。一房共有三瓣，一瓣有实一粒，一房共实三粒也。戎州出者，壳上有纵纹，隐起如线，一道至两、三道。彼土人呼为金线巴豆，最为上等，它处亦稀有。"}]},{"ID":"20240613125354-ehv8s79","Type":"NodeParagraph","Properties":{"id":"20240613125354-ehv8s79","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使巴之与豆及刚子，须在仔细认，勿误用，杀人。巴颗小紧实，色黄；豆即颗有三棱，色黑；若刚子，颗小似枣核，两头尖。巴与豆即用，刚子勿使。凡修事巴豆，敲碎，以麻油并酒等可煮巴豆了，研膏后用。每修事一两，以酒、麻油各七合。尽为度。圣惠方∶治中风口 。巴豆七枚，去皮烂研。 左涂右手心， 右涂左手心，仍以暖水一盏，安向手心，须臾即便正，洗去药并频抽掣中指。又方∶治牙疼。用巴豆一粒，煨至黄熟，去壳，用蒜一瓣，切一头，作盖，剜去中心，可安巴豆在内，以盖子合之。用绵裹，随患处左右塞耳中。外台秘要∶文仲方，主唯腹大动摇水声，皮肤黑，名曰水蛊。巴豆九十枚（去心、皮，熬令黄），杏仁六十枚（去皮、尖，熬令黄），二味捣丸如小豆大。水下一丸，以利为度。勿饮酒。千金方∶主大人、小儿风瘙瘾疹，心迷闷方∶巴豆二两，槌破，以水七升，煮取三升，以帛染拭之。又方∶治寒癖宿食，久饮不消，大便秘。巴豆仁一升，清酒五升，煮三日三夜，研令大熟，合酒微火煎之，丸如胡豆大。每服一丸，水下。欲吐者，服二丸。又方∶治喉痹，已死有余气者。巴豆去皮，针线穿，咽入喉中，牵出。千金翼∶治小儿身肿，并手足肿兼瘾疹。巴豆五十枚去皮、心，以水二升，煎取一升，用绵于汤中随手拭之。经验方∶郑獬侍御传治气痢。巴豆一两，去皮、心，熬细研，取熟猪肝和丸。空心米饮下，量力加减服之。牛肝尤佳。如食素人，以蒸饼丸服。又方∶治耳卒聋。巴豆一粒，蜡裹，针刺令通透用，塞耳中。又方∶治箭镞入骨不可拔。取巴豆微熬，与蜣螂同研，涂所伤处，斯须痛定，微痒忍之，待极痒不可忍，便撼动箭镞，即拔之，立出。夏候郸云∶初在润州得方，箭镞出后，速以生肌膏敷之。说者云兼治疮。郸得方，后至洪州，旅舍主人妻患背疮呻吟，郸遽用此方∶试之，愈。胜金治喉闭，缠喉风。巴豆两粒，纸紧角可通得入鼻，用刀子切断两头，壳子将针穿作孔子，纳鼻中，久即瘥。十全方∶治疥疮。"}]},{"ID":"20240613125354-sg8jm1r","Type":"NodeParagraph","Properties":{"id":"20240613125354-sg8jm1r","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"巴豆十粒，火炮过黄色，去皮膜，右顺手研如面，入酥少许，腻粉少许，同研匀，爪破，以竹篦子点药，不得落眼里及外肾上。如熏KT 着外肾，以黄丹涂，甚妙。初虞方∶治药毒秘效。巴豆（去皮，不出油）、马牙硝等分，合研成膏。"}]},{"ID":"20240613125354-6usafjk","Type":"NodeParagraph","Properties":{"id":"20240613125354-6usafjk","updated":"20240613125354"},"Children":[{"Type":"NodeText","Data":"冷水化一弹子许，服瘥。贾相公∶进过牛经，牛有卒疫，动头打肋者。以巴豆两个，去皮捣末，生油二两，淡浆水灌之瘥。"}]},{"ID":"20240613125308-20tbx5n","Type":"NodeThematicBreak","Properties":{"id":"20240613125308-20tbx5n"}},{"ID":"20240613125341-00ktff6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125341-00ktff6","updated":"20240613125347"},"Children":[{"Type":"NodeText","Data":"巴豆《吴普本草》"}]},{"ID":"20240613125341-nnbs32u","Type":"NodeParagraph","Properties":{"id":"20240613125341-nnbs32u","updated":"20240613125341"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十三"}]},{"ID":"20240613125341-7sjufn4","Type":"NodeParagraph","Properties":{"id":"20240613125341-7sjufn4","updated":"20240613125341"},"Children":[{"Type":"NodeText","Data":"一名巴菽。神农、岐伯、桐君∶辛，有毒。黄帝∶甘，有毒。李氏∶生温熟寒。叶如大豆。八月采。"}]},{"ID":"20240613125308-hxz7tsn","Type":"NodeThematicBreak","Properties":{"id":"20240613125308-hxz7tsn"}},{"ID":"20240613125328-vhjdkzh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125328-vhjdkzh","updated":"20240613125333"},"Children":[{"Type":"NodeText","Data":"巴豆《得配本草》"}]},{"ID":"20240613125328-l7jmg6e","Type":"NodeParagraph","Properties":{"id":"20240613125328-l7jmg6e","updated":"20240613125328"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名刚子"}]},{"ID":"20240613125328-v45tsjh","Type":"NodeParagraph","Properties":{"id":"20240613125328-v45tsjh","updated":"20240613125328"},"Children":[{"Type":"NodeText","Data":"得火良。芫花为之使。畏大黄、藜芦、黄连、芦笋、酱豉、豆汁、冷水。"}]},{"ID":"20240613125328-ihbmiv9","Type":"NodeParagraph","Properties":{"id":"20240613125328-ihbmiv9","updated":"20240613125328"},"Children":[{"Type":"NodeText","Data":"恶蓑草、牵牛。"}]},{"ID":"20240613125328-zjzt49w","Type":"NodeParagraph","Properties":{"id":"20240613125328-zjzt49w","updated":"20240613125328"},"Children":[{"Type":"NodeText","Data":"辛，热，有毒。刚猛之性，走气溃坚。荡涤肠胃之积滞，驱除脏腑之阴霾，片刻间靡不奏效。得杏仁，治积滞泄痢。"}]},{"ID":"20240613125328-jdpcn28","Type":"NodeParagraph","Properties":{"id":"20240613125328-jdpcn28","updated":"20240613125328"},"Children":[{"Type":"NodeText","Data":"得硼砂、杏仁、牙皂，水丸服，治痰哮。燃灯吹灭，以烟熏鼻，治不去膜伤胃，不去心伤肾。炒熟，令烟尽至黑色，去油极尽用。用之不当，脏腑溃烂。"}]},{"ID":"20240613125328-zn6qn8g","Type":"NodeParagraph","Properties":{"id":"20240613125328-zn6qn8g","updated":"20240613125328"},"Children":[{"Type":"NodeText","Data":"中其毒，绿豆汁解之。"}]},{"ID":"20240613125308-xdkib2t","Type":"NodeThematicBreak","Properties":{"id":"20240613125308-xdkib2t"}},{"ID":"20240613125317-wz6yglj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125317-wz6yglj","updated":"20240613125321"},"Children":[{"Type":"NodeText","Data":"巴豆《本草求真》"}]},{"ID":"20240613125317-sdo30fz","Type":"NodeParagraph","Properties":{"id":"20240613125317-sdo30fz","updated":"20240613125317"},"Children":[{"Type":"NodeText","Data":"（乔木）祛脏腑沉寒通大便寒结"}]},{"ID":"20240613125317-u5kokvk","Type":"NodeParagraph","Properties":{"id":"20240613125317-u5kokvk","updated":"20240613125317"},"Children":[{"Type":"NodeText","Data":"巴豆（专入肠胃）。辛热大毒。据书所载生猛熟缓。可升可降。能行能止。开窍宣滞。去脏腑沉寒。为斩关夺命之将。夫既能宣滞通窍。则药能降能行。何书又言能升能止耶？此数字不无令人少疑。究之书之所言降者。因有沉寒痼冷。积聚于脏。深入不毛。故欲去不能。不去不得。非无辛热迅利斩关直入。扫除阴霾。推陈致新。亦安能荡涤而如斯哉？是即书之所谓能降能行者耳。至有久病溏泄。服升提涩药而泻反甚。脉滑而沉。是明脾胃久伤冷积凝气所致。法当用以热下。则寒去利止。而脉始得上升。是即所谓能升能止者是也。（时珍曰。一妇年六十余。溏泄五载。犯生冷油腻肉食即作痛。服升涩药泻反甚。脉沉而滑。此乃脾胃久伤积冷凝滞。法当以热下之。用蜡匮巴豆丸五十粒。服一二日不利而愈。自是每用治泄痢。愈者近百人耳。）夫医理玄远。变化靡尽。在人引伸触类。毋为书执。则用药不岐。即如大黄？亦属开闭通便之品。然惟腑病多热者最宜。若以脏病多寒而用大黄通利。不亦自相悖谬乎。（故仲景治伤寒传里多热者。多用大黄。东垣治五积属脏者。多用巴豆。与大黄同服。反不泻人。）故曰。误用有推墙倒壁之虞。善用有戡乱调中之妙。元素曰。世以治酒病膈气。而以巴豆辛热。通开肠胃郁热。（巴豆禀火烈之气。）第郁结虽通。血液随亡。其阴亏损伤。寒结胸膈。小儿疳积。用之不死亦危。奈何庸人畏大黄而不畏巴豆。以其性热剂小耳。试以少许轻擦皮肤。须臾发泡。况下肠胃。能无溃灼熏烂之患乎？即有急症。不得已而用之。（汪昂曰。缠喉急痹。缓治则死。用丸。雄黄一两。郁金一钱。巴豆十四粒去皮油。为丸。每用五分。津咽下。雄黄破结气。郁金破恶气。巴豆下稠涎。然系厉剂。不可轻用。或用纸捻蘸巴豆油。燃火刺喉。或捣巴豆绵裹。随左右纳鼻中。吐出恶涎紫血即宽。）压去其油。取霜少许入药可也。（时珍曰。巴豆紧小者为雌。有棱及两头尖者是雄。雄者更峻耳。用之得宜。皆有功力。不去膜则伤胃。不去心则作呕。）或用壳用仁用油。生用炒用。醋煮烧存性用。研去油。名巴霜。芫花为使。畏大黄黄连凉水。（中其毒者。以此解之。或黑豆绿豆汁亦佳。）得火良。"}]},{"ID":"20240613124856-0ndzub2","Type":"NodeThematicBreak","Properties":{"id":"20240613124856-0ndzub2"}},{"ID":"20240613125300-cjp8nyt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125300-cjp8nyt","updated":"20240613125306"},"Children":[{"Type":"NodeText","Data":"巴豆《顾松园医镜》"}]},{"ID":"20240613125300-7w8vwco","Type":"NodeParagraph","Properties":{"id":"20240613125300-7w8vwco","updated":"20240613125300"},"Children":[{"Type":"NodeText","Data":"〔辛热，大毒，反牵牛。炒熟去油，只用厘许，不可过分。〕诸般积滞，〔痰食虫血是也。〕立皆荡涤；脏腑气血，悉被侵伤。辛热大毒，迅速下泻之厉药。明矾〔三钱煎溶，入豆七粒。〕同，〔去豆研，用少许。〕吹喉痹，出热涎，立开如神。"}]},{"ID":"20240613125300-ps6vkdw","Type":"NodeParagraph","Properties":{"id":"20240613125300-ps6vkdw","updated":"20240613125300"},"Children":[{"Type":"NodeText","Data":"禀火烈之气，以少许着肌，顷刻发泡，况肠胃柔质岂能堪此乎！慎勿用。火能灼物，故主烂胎，孕妇大忌。"}]},{"ID":"20240613125228-el6c70r","Type":"NodeThematicBreak","Properties":{"id":"20240613125228-el6c70r"}},{"ID":"20240613125252-vl1s0ok","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125252-vl1s0ok","updated":"20240613125256"},"Children":[{"Type":"NodeText","Data":"巴豆《汤液本草》"}]},{"ID":"20240613125252-yfnxnoo","Type":"NodeParagraph","Properties":{"id":"20240613125252-yfnxnoo","updated":"20240613125252"},"Children":[{"Type":"NodeText","Data":"气温，味辛，生温、熟寒。有大毒。"}]},{"ID":"20240613125252-3tv6lv6","Type":"NodeParagraph","Properties":{"id":"20240613125252-3tv6lv6","updated":"20240613125252"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主伤寒，温疟寒热。破症瘕结聚，坚积，留饮痰癖，大腹水胀。荡涤五脏六腑，开通闭塞。利水谷道，去恶肉，除鬼毒蛊疰邪物，杀虫鱼。疗女子月闭，烂胎，金疮脓血不利，丈夫阴 。杀斑蝥毒，健脾开胃。"}]},{"ID":"20240613125252-ms0qeb6","Type":"NodeParagraph","Properties":{"id":"20240613125252-ms0qeb6","updated":"20240613125252"},"Children":[{"Type":"NodeText","Data":"易老云∶斩关夺门之将，大宜详悉，不可轻用。"}]},{"ID":"20240613125252-n3ipmwh","Type":"NodeParagraph","Properties":{"id":"20240613125252-n3ipmwh","updated":"20240613125252"},"Children":[{"Type":"NodeText","Data":"《雷公》云∶得火则良，若急治为水谷道路之剂，去皮心膜油，生用。若缓治，为消坚磨积之剂，炒烟去，令紫黑，研用。可以通肠，可以止泄，世所不知也。仲景治百病客忤，备急圆主之。巴豆、杏仁例，及加减寒热佐使，五色并余例，并见《元戎》。"}]},{"ID":"20240613125252-uv12wk8","Type":"NodeParagraph","Properties":{"id":"20240613125252-uv12wk8","updated":"20240613125252"},"Children":[{"Type":"NodeText","Data":"《珍》云∶去胃中寒湿。"}]},{"ID":"20240613125228-wbl0g4k","Type":"NodeThematicBreak","Properties":{"id":"20240613125228-wbl0g4k"}},{"ID":"20240613125241-slpxe97","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125241-slpxe97","updated":"20240613125246"},"Children":[{"Type":"NodeText","Data":"巴豆《本草分经》"}]},{"ID":"20240613125241-5wk5v38","Type":"NodeParagraph","Properties":{"id":"20240613125241-5wk5v38","updated":"20240613125241"},"Children":[{"Type":"NodeText","Data":"辛大热大毒，峻下开窍宣滞，去脏腑沉寒积滞，治喉痹急症。生用急治，炒黑缓治，去油名巴豆霜，大黄、黄连、凉水、黑豆、绿豆汁能解其毒。"}]},{"ID":"20240613125228-rvcq591","Type":"NodeThematicBreak","Properties":{"id":"20240613125228-rvcq591"}},{"ID":"20240613125229-b5b1hhh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125229-b5b1hhh","updated":"20240613125234"},"Children":[{"Type":"NodeText","Data":"巴豆《神农本草经赞》"}]},{"ID":"20240613125229-m5ns2tq","Type":"NodeParagraph","Properties":{"id":"20240613125229-m5ns2tq","updated":"20240613125229"},"Children":[{"Type":"NodeText","Data":"味辛温。主伤寒温疟寒热。破症瘕结聚坚积。留饮痰癖。大腹水胀。荡练五脏六腑。"}]},{"ID":"20240613125229-ns4xmgp","Type":"NodeParagraph","Properties":{"id":"20240613125229-ns4xmgp","updated":"20240613125229"},"Children":[{"Type":"NodeText","Data":"开通闭塞。利水谷道。去恶内。除鬼毒蛊注邪物。杀虫鱼。一名巴叔。生川谷。"}]},{"ID":"20240613125229-8ngqlfe","Type":"NodeParagraph","Properties":{"id":"20240613125229-8ngqlfe","updated":"20240613125229"},"Children":[{"Type":"NodeText","Data":"如菽如豆。蜀栈凌云。棱尖雄辨。细紧雌分。房开双瓣。线起纵纹。疗牛肥鼠。物性偏欣。"}]},{"ID":"20240613125229-qvp10uj","Type":"NodeParagraph","Properties":{"id":"20240613125229-qvp10uj","updated":"20240613125229"},"Children":[{"Type":"NodeText","Data":"李时珍曰。此物出巴蜀。形如菽豆故名。有棱及两头尖者是雄。紧小者是雌。用之得宜。"}]},{"ID":"20240613125229-2ii8661","Type":"NodeParagraph","Properties":{"id":"20240613125229-2ii8661","updated":"20240613125229"},"Children":[{"Type":"NodeText","Data":"皆有功效。苏颂曰。木高一二丈。五六月结实作房。一房有二瓣。或一子或三子。戎州出者壳上有纵纹。隐起如线一道至二三道。牛经。巴豆研油灌之。疗牛疫。陶弘景曰。鼠食之肥。"}]},{"ID":"20240613125229-2gqh37w","Type":"NodeParagraph","Properties":{"id":"20240613125229-2gqh37w","updated":"20240613125229"},"Children":[{"Type":"NodeText","Data":"物性相耐如此。"}]},{"ID":"20240613125116-e41ukz4","Type":"NodeThematicBreak","Properties":{"id":"20240613125116-e41ukz4"}},{"ID":"20240613125215-i22wpaj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125215-i22wpaj","updated":"20240613125222"},"Children":[{"Type":"NodeText","Data":"巴豆《本草崇原》"}]},{"ID":"20240613125215-hhigb94","Type":"NodeParagraph","Properties":{"id":"20240613125215-hhigb94","updated":"20240613125215"},"Children":[{"Type":"NodeText","Data":"气味辛温，有毒。主治伤寒温疟寒热，破症瘕结聚，坚积留饮，痰 ，大腹，荡练五脏六腑，开通闭塞，利水谷道，去恶肉，除鬼毒蛊疰邪物，杀虫鱼。"}]},{"ID":"20240613125215-e4oswkw","Type":"NodeParagraph","Properties":{"id":"20240613125215-e4oswkw","updated":"20240613125215"},"Children":[{"Type":"NodeText","Data":"（巴豆出巴郡川谷，今嘉州、眉州、戎州皆有之。木高一二丈，叶似樱桃而浓大，初生青色，后渐黄赤，至十二月叶渐凋，二月复渐生，四月旧叶落尽，新叶齐生，即花发成穗，微黄色，五六月结实作房青色，七八月成熟而黄，类白豆蔻，渐渐自落乃收之，一窠有三子，子为金线巴豆，最为上品。）"}]},{"ID":"20240613125215-0657a34","Type":"NodeParagraph","Properties":{"id":"20240613125215-0657a34","updated":"20240613125215"},"Children":[{"Type":"NodeText","Data":"巴豆生于巴蜀，气味辛温，花实黄赤，大热有毒。其性剽悍，主治伤寒温疟寒热者，辛以散之，从经脉而外出于肌表也。破症瘕结聚，坚积留饮，痰 ，大腹者，温以行之，从中土而下泄于肠胃也。用之合宜，有斩关夺门之功，故荡练五脏六腑，开通闭塞，闭塞开通，则水谷二道自利矣。其性 悍，故去恶肉。气合阳明，故除鬼毒蛊疰邪物，杀虫鱼。《经》云∶两火合并是为阳明。巴豆味极辛，性大温，具两火之性，气合阳明，故其主治如此。"}]},{"ID":"20240613125215-9kb0f1d","Type":"NodeParagraph","Properties":{"id":"20240613125215-9kb0f1d","updated":"20240613125215"},"Children":[{"Type":"NodeText","Data":"愚按∶凡服巴霜，即从胸胁大热，达于四肢，出于皮毛，然后复从肠胃而出。《伤寒论》有白散方，治伤寒寒实结胸用此。古人称为斩关夺门之将，用之若当，真瞑眩瘳疾之药，用之不当，非徒无益而反害矣。"}]},{"ID":"20240613125116-st44juy","Type":"NodeThematicBreak","Properties":{"id":"20240613125116-st44juy"}},{"ID":"20240613125202-1sah6ra","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125202-1sah6ra","updated":"20240613125208"},"Children":[{"Type":"NodeText","Data":"巴豆《医学入门》"}]},{"ID":"20240613125202-xp0aqvv","Type":"NodeParagraph","Properties":{"id":"20240613125202-xp0aqvv","updated":"20240613125202"},"Children":[{"Type":"NodeText","Data":"巴豆大毒味辛热，主荡胃中寒积结，气血痰食水癖消，更通月水排脓血。"}]},{"ID":"20240613125202-vb8vorn","Type":"NodeParagraph","Properties":{"id":"20240613125202-vb8vorn","updated":"20240613125202"},"Children":[{"Type":"NodeText","Data":"出巴蜀，形如豆。一种刚子颗小似枣核两头尖者，能杀人。本草云∶生温熟寒。其实热，毒药也。"}]},{"ID":"20240613125202-7ag0mix","Type":"NodeParagraph","Properties":{"id":"20240613125202-7ag0mix","updated":"20240613125202"},"Children":[{"Type":"NodeText","Data":"惟急治通水谷道，生用去心膜，纸挹去油；缓治消坚磨积，水煮五次，或炒烟尽色黑研用。可以通肠，可以止泻，世所不知，此雷公说也。主荡涤胃中寒积， 瘕， 癖，冷气血块，痰癖，宿食，留饮，水肿，宣一切壅滞闭塞，气痢积疟，女子月闭，烂胎，惟伤寒热闭忌用。兼去恶内，排脓消肿，除鬼毒蛊疰，杀虫鱼、斑蝥、蛇虺毒。东垣云∶斩关夺门之剂。不可轻用，误中其毒，以黄连、大豆汁解之，芫花为使，恶 草，畏大黄、黄连、藜芦。忌芦笋、酱豉、冷水，得火良。古枳巴丸∶大枳壳两个去瓤，每个入巴豆一粒在内，线扎，置砂锅内，以醋浸一宿，煮干为末，湿纸蘸药敷根上，痔去，即用生肌散；如日久顽漏，用津液调敷，败肉自去。"}]},{"ID":"20240613125202-3hh4v39","Type":"NodeParagraph","Properties":{"id":"20240613125202-3hh4v39","updated":"20240613125202"},"Children":[{"Type":"NodeText","Data":"或去巴豆，醋糊为丸，梧子大，每十五丸茶清下，治痔漏下血痒痛。"}]},{"ID":"20240613125202-x5xtnyu","Type":"NodeParagraph","Properties":{"id":"20240613125202-x5xtnyu","updated":"20240613125202"},"Children":[{"Type":"NodeText","Data":"以上治中焦寒药。"}]},{"ID":"20240613125116-hjmkeiq","Type":"NodeThematicBreak","Properties":{"id":"20240613125116-hjmkeiq"}},{"ID":"20240613125146-i6yq3in","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125146-i6yq3in","updated":"20240613125153"},"Children":[{"Type":"NodeText","Data":"巴豆《本草纲目》"}]},{"ID":"20240613125146-lo6onvq","Type":"NodeParagraph","Properties":{"id":"20240613125146-lo6onvq","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"「释名」名巴菽、刚子、老阳子。"}]},{"ID":"20240613125146-ebwvcff","Type":"NodeParagraph","Properties":{"id":"20240613125146-ebwvcff","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"「气味」辛、温、有毒。"}]},{"ID":"20240613125146-s5xohcw","Type":"NodeParagraph","Properties":{"id":"20240613125146-s5xohcw","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613125146-m4lit1f","Type":"NodeParagraph","Properties":{"id":"20240613125146-m4lit1f","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"1、一切积滞。用巴豆一两、蛤粉二两、黄蘖三两，共研为末，调水做成丸子，如绿豆大。每服五丸，水送下。"}]},{"ID":"20240613125146-1xypnub","Type":"NodeParagraph","Properties":{"id":"20240613125146-1xypnub","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"2、宿食不化，大便闭塞。用巴豆仁一升、清酒五升，同煮三日三夜，研烂，合酒微火煎至能团成丸子，做丸如豌豆大。每服一丸，水送下。想呕吐者服二丸。"}]},{"ID":"20240613125146-x26qntu","Type":"NodeParagraph","Properties":{"id":"20240613125146-x26qntu","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"3、水蛊大腹，皮肤色黑。用巴豆九十枚（去皮、心，炙黄）、杏仁六十枚（去皮、类，炙黄），共捣丸如小豆大。每服一丸，水送下，以泻为度。"}]},{"ID":"20240613125146-8sv39fs","Type":"NodeParagraph","Properties":{"id":"20240613125146-8sv39fs","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"4、心痛腹胀，大便不通。用巴豆二枚（去皮、心，炙黄）、杏仁二枚，棉包捶碎，以热水一合，泡取白汁取下。"}]},{"ID":"20240613125146-rgx8zql","Type":"NodeParagraph","Properties":{"id":"20240613125146-rgx8zql","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"5、食疟、积疟，用巴豆（去皮、心）二钱，皂荚（去皮、子）六钱，捣烂和成丸子，如绿豆大。每服一丸，冷汤送下。"}]},{"ID":"20240613125146-ozykuwa","Type":"NodeParagraph","Properties":{"id":"20240613125146-ozykuwa","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"6、滞泄痢，腹痛里急。用杏仁（去皮、尖）、巴豆（去皮、心）各四十九个，同烧存性，研成泥，溶蜡和成丸，绿豆大。每服二、三丸，煎大黄汤送下。隔日一服。在本方中加百草霜三钱亦可。"}]},{"ID":"20240613125146-mrmyqku","Type":"NodeParagraph","Properties":{"id":"20240613125146-mrmyqku","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"7、气痢赤白。用巴豆一两，去皮心，炒过，研为末，加熟猪肝和成丸子，如绿豆大。空心服，米汤送下三、四丸。"}]},{"ID":"20240613125146-3b8rk9h","Type":"NodeParagraph","Properties":{"id":"20240613125146-3b8rk9h","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"8、泻血不止。用巴豆一个，去皮，放入事先开了小孔的鸡蛋中，纸包好，煨熟。去豆吃蛋，病即止。体虚的病人分作二次服。甚效。"}]},{"ID":"20240613125146-1f3mtnw","Type":"NodeParagraph","Properties":{"id":"20240613125146-1f3mtnw","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"9、夏月水泻不止。用巴豆一粒烧存性，黄蜡和成一丸，水送服。"}]},{"ID":"20240613125146-a0j4zuu","Type":"NodeParagraph","Properties":{"id":"20240613125146-a0j4zuu","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"10、小儿吐泻。用巴豆一粒烧存性，黄蜡豆大一块，熔滴水中，一起捣匀做成丸子，如黍米大。每服五至七丸，莲子灯心汤送下。"}]},{"ID":"20240613125146-g8wnup5","Type":"NodeParagraph","Properties":{"id":"20240613125146-g8wnup5","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"11、干霍乱（心腹胀痛，吐泻不出）。用巴豆一枚，去皮心，热水研服，能吐泻好见效。"}]},{"ID":"20240613125146-wrn72ab","Type":"NodeParagraph","Properties":{"id":"20240613125146-wrn72ab","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"12、寒痰气喘。用青桔皮一片，包巴豆一粒，麻子线捆好，烧存性，研为末，加清汁和酒一杯，慢慢饮服。有特效。"}]},{"ID":"20240613125146-cf4ww03","Type":"NodeParagraph","Properties":{"id":"20240613125146-cf4ww03","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"13、舌上出血。用巴豆一枚、乱发一团（如鸡蛋大），烧存性，研为末，酒冲服。"}]},{"ID":"20240613125146-5vp9kfk","Type":"NodeParagraph","Properties":{"id":"20240613125146-5vp9kfk","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"14、中风口歪。用巴豆七枚，去皮，研烂，左歪涂右手心，右不止涂左手心，再以热水一杯放在涂药的手上，不久，口即复原，然后把药洗去。"}]},{"ID":"20240613125146-bxsy0a5","Type":"NodeParagraph","Properties":{"id":"20240613125146-bxsy0a5","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"15、小儿口疮，不能吃乳。用巴豆一一粒，连油研烂，加黄花菜丹少许，剃去小儿囟门头发，把药敷贴好，待四边起小水泡，即用温水洗去，再以菖蒲汤洗过，便不会长成疮。"}]},{"ID":"20240613125146-zrsdv8i","Type":"NodeParagraph","Properties":{"id":"20240613125146-zrsdv8i","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"16、风瘙隐疹，心下迷悄，用巴豆五十粒，去皮，加水七升，煮成二升，取汁搽患处。"}]},{"ID":"20240613125146-3gssskc","Type":"NodeParagraph","Properties":{"id":"20240613125146-3gssskc","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"17、疥疮。用巴豆十粒，炮黄花菜，去皮心，研为末，加酥和腻粉少许，把疮抓破搽上。注意本剂不得近目及肾囊。如必须在这些部位搽药，须先用黄丹涂过。"}]},{"ID":"20240613125146-y4p98cp","Type":"NodeParagraph","Properties":{"id":"20240613125146-y4p98cp","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"18、荷钱癣。用巴豆仁三个，连油捣成泥，包薄布内搽患处。每天搽一、二次，几日即愈。"}]},{"ID":"20240613125146-udqm7j2","Type":"NodeParagraph","Properties":{"id":"20240613125146-udqm7j2","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"19、一切恶疮。用巴豆三十粒，麻油煎黑，去豆，以油调硫磺、轻粉末，频涂疮上，有。"}]},{"ID":"20240613125146-ij4q9aa","Type":"NodeParagraph","Properties":{"id":"20240613125146-ij4q9aa","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"20、痈疽恶内。用巴豆仁炒焦，研成膏药点痛和，可以解毒；涂瘀肉上，腐处自消。方中加少许乳香亦可，此方名“乌金膏”。"}]},{"ID":"20240613125146-39gb1im","Type":"NodeParagraph","Properties":{"id":"20240613125146-39gb1im","updated":"20240613125146"},"Children":[{"Type":"NodeText","Data":"21、疣痣。和巴豆一钱（石灰炒过）、砒一钱、糯米（炒）五分，共研为末，点患处。"}]},{"ID":"20240613125116-kogl41f","Type":"NodeThematicBreak","Properties":{"id":"20240613125116-kogl41f"}},{"ID":"20240613125132-ebeusm0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125132-ebeusm0","updated":"20240613125139"},"Children":[{"Type":"NodeText","Data":"巴豆《名医别录》"}]},{"ID":"20240613125132-whf9mw1","Type":"NodeParagraph","Properties":{"id":"20240613125132-whf9mw1","updated":"20240613125132"},"Children":[{"Type":"NodeText","Data":"生温熟寒，有大毒．主治女子月闭，烂胎，金创脓血，不利丈夫阴，杀斑蝥毒．可练之，益血脉，令人色好，变化与鬼神通．生巴郡．八月采实，阴干，用之去心皮．（芫花之使，恶 草，畏大黄、黄连、藜芦．）"}]},{"ID":"20240613125132-2p73w3w","Type":"NodeParagraph","Properties":{"id":"20240613125132-2p73w3w","updated":"20240613125132"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶巴豆，味辛，温．主伤寒温疟寒热，破症瘕结聚坚积，留饮痰癖，大腹水胀，荡练五脏六生川谷．"}]},{"ID":"20240613125116-gafktyl","Type":"NodeThematicBreak","Properties":{"id":"20240613125116-gafktyl"}},{"ID":"20240613125118-6ceyizc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125118-6ceyizc","updated":"20240613125123"},"Children":[{"Type":"NodeText","Data":"巴豆《本草备要》"}]},{"ID":"20240613125118-zp68tw4","Type":"NodeParagraph","Properties":{"id":"20240613125118-zp68tw4","updated":"20240613125118"},"Children":[{"Type":"NodeText","Data":"大燥，大泻"}]},{"ID":"20240613125118-cablo53","Type":"NodeParagraph","Properties":{"id":"20240613125118-cablo53","updated":"20240613125118"},"Children":[{"Type":"NodeText","Data":"辛热有大毒。生猛而熟少缓。可升可降，能止能行，开窍宣滞，去脏腑沉寒，最为斩关夺门之将。破痰癖血瘕，气痞食积，生冷硬物所伤，大腹水肿，泻痢惊痫，口 耳聋，牙痛喉痹（缠喉急痹，缓治则死。用解毒丸，雄黄一两，郁金一钱，巴豆十四粒，去皮油，为丸。每服五分，津咽下。雄黄破结气，郁金散恶血，巴豆下稠涎，然系厉剂，不可轻用。或用纸拈蘸巴豆油，燃火刺喉；或捣巴豆，绵裹，随左、右纳鼻中，吐出恶涎，紫血即宽。鼻虽小，生疮无碍）。其毒性又能解毒、杀虫，疗疮疡、蛇蝎诸毒。峻用大可劫病，微用亦可和中。通经烂胎（巴豆禀火烈之气，烂人肌肉。试以少许擦皮肤，即发一泡，况肠胃耶，不可轻用。王好古曰∶去心、皮膜、油，生用，为急治水谷道路之剂。炒去烟、令紫黑用。为缓治消坚磨积之剂。可以通畅，可以止泻，世所不知也。时珍曰∶一妇年六十余，溏泻五载，犯生冷油腻肉食，即作痛，服升涩药，泻反甚，脉沉而滑，此乃脾胃久伤，积冷凝滞。法当以热下之。用腊匮巴豆丸五十粒，服二日，不利而愈。自是每用治泻痢，愈者近百人）。一名刚子（雷 曰∶紧小、色黄者为巴，三棱、色黑者为豆，小而两头尖者为刚子。刚子杀人。时珍曰∶此说殊乖。盖紧小者为雌，有棱及两头尖者是雄，雄者更峻耳。用之得宜，皆有功力。不去膜则伤胃，不去心则作呕。《藏器》法连白膜服）。或用谷、用仁、用油、生用、炒用、醋煮烧存性用。研去油，名巴豆霜。芫花为使。畏大黄、黄连、凉水（中其毒者，以此解之，或黑豆、绿豆汁亦佳）。得火良。"}]},{"ID":"20240613125118-199qt7j","Type":"NodeParagraph","Properties":{"id":"20240613125118-199qt7j","updated":"20240613125118"},"Children":[{"Type":"NodeText","Data":"巴豆油作纸拈燃火，吹息，或熏鼻，或刺喉，能行恶涎恶血。治中风中恶，痰厥气厥，喉痹不通，一切急病（大黄、巴豆，同为峻下之剂。但大黄性寒，腑病多热者宜之。巴豆性热，脏病多寒者宜之。故仲景治伤寒传里多热者，多用大黄；东垣治五积属脏者，多用巴豆。与大黄同服，反不泻人）。"}]},{"ID":"20240613124856-ehf1ioa","Type":"NodeThematicBreak","Properties":{"id":"20240613124856-ehf1ioa"}},{"ID":"20240613125105-ngwntn8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125105-ngwntn8","updated":"20240613125110"},"Children":[{"Type":"NodeText","Data":"巴豆《增广和剂局方药性总论》"}]},{"ID":"20240613125105-21l65sf","Type":"NodeParagraph","Properties":{"id":"20240613125105-21l65sf","updated":"20240613125105"},"Children":[{"Type":"NodeText","Data":"味辛，温、生温熟寒，有大毒。主伤温疟寒热，破症瘕结聚坚积，留饮痰癖，大腹水荡练五脏六腑，开通闭塞，利水谷道，去恶肉，除鬼毒蛊疰邪物，杀虫鱼，疗女子月闭胎，金疮脓血，不利丈夫阴，杀斑蝥毒。《药性论》云∶使。中其毒，用黄连汁、大豆之。忌∶芦笋、酱豉、冷水。得∶火，良。杀斑蝥、蛇虺毒。能主破心腹积聚，结气，种水肿，痿痹，大腹，能落胎。日华子云∶通宣一切病，泄壅滞，除风，补劳，健脾开消痰，破血排脓，消肿毒，杀腹脏虫，治恶疮，息肉及疥癞，疗肿。芫花为使。恶∶畏∶大黄、黄连、藜芦。"}]},{"ID":"20240613124856-xn0p7um","Type":"NodeThematicBreak","Properties":{"id":"20240613124856-xn0p7um"}},{"ID":"20240613125053-lnev49f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125053-lnev49f","updated":"20240613125058"},"Children":[{"Type":"NodeText","Data":"巴豆《冯氏锦囊秘录》"}]},{"ID":"20240613125053-fcbdk55","Type":"NodeParagraph","Properties":{"id":"20240613125053-fcbdk55","updated":"20240613125053"},"Children":[{"Type":"NodeText","Data":"生于盛夏六阳之令而成，秋金之月，故味辛，气温，得火烈刚猛之气，其性有大毒，一云∶生温熟寒。恐熟亦不甚寒也。入手足阳明经，此药禀火性之急速，兼辛温之走散，故能入肠胃而荡涤一切有形积滞之物，祛暑湿温疟之邪，然性热大毒，必损真阴，故曰不利丈夫阴，但云又能止泻。《别录》又云“∶炼饵之，能益血脉。”恐未确也。宜去心及膜火焙研细去油用。"}]},{"ID":"20240613125053-ngc2rxt","Type":"NodeParagraph","Properties":{"id":"20240613125053-ngc2rxt","updated":"20240613125053"},"Children":[{"Type":"NodeText","Data":"巴豆一名巴椒。反牵牛，破 瘕结聚，留饮痰癖，大腹水胀，温疟寒热，荡涤脏腑，开通闭塞，除鬼毒蛊疰，杀虫，疗女人月闭烂胎，有荡涤攻击之能，诚斩关夺门之将。凡资治病，缓急宜分，急攻为通利水谷之方，去尽皮心膜油，生用，缓治为消磨坚积之剂，炒令黄黑烟尽熟加。生熟缓紧略殊，然耗津伤元则一。丹溪云，能去胃中寒积，无寒积者忌之，总宜慎用。与大黄同为攻下，但大黄性寒，走血分，腑病多热者宜之，巴豆性热，走气分，脏病多寒者宜之。士材曰∶荡五脏，涤六腑，几于煎肠刮胃，攻坚积，破痰癖，直可斩关夺门，气血与食，一攻而殆尽，痰虫及水，倾倒而无遗，胎见立堕，疗毒旋抽，然郁滞虽开，真阴髓损，以少许着肌肤，须臾发泡，况肠胃脏腑柔薄之质，被其熏灼，能无溃烂之患耶！万不得已，须炒熟去油，入少许即止，不得多用。"}]},{"ID":"20240613124856-grimtcv","Type":"NodeThematicBreak","Properties":{"id":"20240613124856-grimtcv"}},{"ID":"20240613125042-0i87lq1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125042-0i87lq1","updated":"20240613125048"},"Children":[{"Type":"NodeText","Data":"巴豆《本经逢原》"}]},{"ID":"20240613125042-5qpy3fx","Type":"NodeParagraph","Properties":{"id":"20240613125042-5qpy3fx","updated":"20240613125042"},"Children":[{"Type":"NodeText","Data":"辛热，大毒。去壳及心炒紫黑，或烧存性，或研烂纸包压去油，取霜，各随方制。"}]},{"ID":"20240613125042-w8of1d4","Type":"NodeParagraph","Properties":{"id":"20240613125042-w8of1d4","updated":"20240613125042"},"Children":[{"Type":"NodeText","Data":"《本经》主伤寒湿疟寒热，破症瘕结聚，坚积留饮，痰癖大腹，荡练五脏六腑，开通闭塞，利水谷道，去恶肉，除鬼毒蛊疰邪物，杀虫鱼。"}]},{"ID":"20240613125042-lcw9wng","Type":"NodeParagraph","Properties":{"id":"20240613125042-lcw9wng","updated":"20240613125042"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"巴豆辛热，能荡练五脏六腑，不特破症瘕结聚之坚积，并可治伤寒湿疟之寒热，如仲景治寒实结胸用白散，深得《本经》之旨。世本作温疟，当是湿疟，亥豕之谬也。其性峻利，有破血排脓、攻痰逐水之力，宜随证轻重而施。生用则峻攻，熟用则温利，去油用霜则推陈致新，随证之缓急而施反正之治。峻用则有戡乱却病之功，少用亦有抚绥调中之妙。可以通肠，可以止泻，此发千古之秘也。一老妇人，久病溏泄，遍服调脾升提止涩诸药，则泻反甚，脉沉而滑，此脾胃久伤、冷积凝滞所致。法当以热下之则寒去利止，自后每用以治泄痢结聚诸病，多有不泻而病痊者，妙在得宜耳。苟用不当则犯损阴之戒矣。按∶巴豆、大黄同为攻下之剂，但大黄性寒，腑病多热者宜之；巴豆性热，脏病多寒者宜之。其壳烧灰存性，能止泻痢亦却病之效也。孕妇禁用，以力能堕胎也。元素曰，巴豆乃斩关夺门之将，不可轻用。世以治酒病膈气，以其辛热能开通肠胃郁热耳，第郁结虽通，血液随亡，其阴亏损。伤寒结胸，小儿疳积用之，不死亦危。奈何庸人畏大黄而不畏巴豆，以其性热剂小耳，试以少许轻擦完肤，须臾发泡，况下肠胃能无熏灼溃烂之患乎。即有急证不得已而用之，压去其油取霜少许入药可也。"}]},{"ID":"20240613124856-1y0unxt","Type":"NodeThematicBreak","Properties":{"id":"20240613124856-1y0unxt"}},{"ID":"20240613125028-y564dq6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613125028-y564dq6","updated":"20240613125036"},"Children":[{"Type":"NodeText","Data":"巴豆《本草述钩元》"}]},{"ID":"20240613125028-nipxkmt","Type":"NodeParagraph","Properties":{"id":"20240613125028-nipxkmt","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"出巴蜀。（嘉州眉州戎州皆有）而形如豆。故名。有雌雄。紧小者是雌。有棱及两头尖者是雄。雄者峻利。名刚子。（亦书江子）雌者稍缓。（濒湖）出戎州者。壳上有纵纹。隐起味辛。气热。有大毒。生猛熟缓。能吐（不去心则呕）能下。浮中得沉。升中得降。"}]},{"ID":"20240613125028-glfljqz","Type":"NodeParagraph","Properties":{"id":"20240613125028-glfljqz","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"气薄味浓。阳中阴也。入手足阳明经。芫花为之使。畏大黄（同用泻反缓）黄连芦笋菰笋酱豉冷水。反牵牛。主治导气消积。（胃中无寒积者。弗用。）去脏腑停寒。心腹痛冷。气血凝。症瘕结聚。坚积留饮。痰癖。惊痫。大腹水肿。治生冷硬物所伤。及一切病泄壅滞。"}]},{"ID":"20240613125028-qrls013","Type":"NodeParagraph","Properties":{"id":"20240613125028-qrls013","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"荡练五脏六腑。开通闭塞。利水谷道。疗喉痹耳聋。去恶肉。通女子月闭烂胎。不利丈夫阴。"}]},{"ID":"20240613125028-d5aiu2f","Type":"NodeParagraph","Properties":{"id":"20240613125028-d5aiu2f","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"若急治为水谷道路之剂。去皮心膜油生用。若缓治为消坚磨积之剂。炒去烟令紫黑用。可以通肠。亦可以止泻。世所不知。（好古）巴豆得老阳气化。其性大刚过急。入腹如火。（洁古谓为斩关夺门之将）但可对待阴寒太过。已成坚凝闭塞之象。而阳火消沮。竟如死灰不燃者。下顺水性。热助火气。一用两得之矣。若木土金水不及。纵有可下之证。用之则木愈抑而胀。土愈陷而废。金愈燥而炎。水愈涸而结矣。（卢不远）万物合太阳火气而生者。皆有毒。巴豆生于盛夏六阳之令。而成于秋金之月。禀火性之急速。及坚金之刚猛。故性有大毒。仲景三物白汤。治寒结胸懊满闷身无热者。巴豆一分。去皮心熬黑用。桔梗三分。"}]},{"ID":"20240613125028-nmq6wqq","Type":"NodeParagraph","Properties":{"id":"20240613125028-nmq6wqq","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"贝母三分。二味为末。内巴豆。臼中杵之。白汤和服。强人半钱。弱者减之。病在膈上。必吐。在膈下。必利。不利。进热粥一杯。利过不止。进冷粥一杯。耳猝聋闭。巴豆一粒。纸裹。针刺孔通气。塞之取效。痈疽溃后。腐肉不落。巴豆一味。炒至烟尽。存性。研膏敷上。"}]},{"ID":"20240613125028-ybg1iyl","Type":"NodeParagraph","Properties":{"id":"20240613125028-ybg1iyl","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"即拔毒去瘀生新。急喉痹。同白矾枯过。去巴豆。单用矾。研细。吹入喉。流出热毒涎。"}]},{"ID":"20240613125028-vvnhbef","Type":"NodeParagraph","Properties":{"id":"20240613125028-vvnhbef","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"喉即宽。二便不通。巴豆连油黄连各半两。捣作饼子。先滴葱盐汁在脐内。安饼子上。灸二七壮。取利为度。寒痰气喘。青橘皮一片。展开。入刚子一个。麻扎定。火上烧存性。"}]},{"ID":"20240613125028-4nhvxfm","Type":"NodeParagraph","Properties":{"id":"20240613125028-4nhvxfm","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"研末。姜汁和。酒一杯呷服。寒癖。宿食不消。大便闭塞。巴豆仁一升。清酒五升。煮三日夜。研熟。合酒微火煎。令可丸如豌豆大。每服一丸。水下。欲吐者二丸。积滞泻痢。"}]},{"ID":"20240613125028-9bquamz","Type":"NodeParagraph","Properties":{"id":"20240613125028-9bquamz","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"腹痛里急。杏仁去皮尖。巴豆去皮心。各四十九个。同烧存性。研泥溶蜡和丸绿豆大。每服二三丸。煎大黄汤下。间日一服。一加百草霜三钱。"}]},{"ID":"20240613125028-3xlkgcr","Type":"NodeParagraph","Properties":{"id":"20240613125028-3xlkgcr","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"附案一老妇饮病。溏泄五年。肉食油物生冷犯之即作痛。服调脾升提止涩诸药。入腹则泻反甚。脉沉而滑。此乃脾胃久伤冷积凝滞所致。法当以热下之。则寒去利止。遂用蜡匮巴豆丸药五十丸与服。二日大便不通。不利。其泻遂愈。凡用巴豆治泄痢积滞诸病恒有不泻而病去者。此药病相对。配合得宜尔。苟用所不当用。则犯轻用损阴之戒矣。一女子值暑月夜甚凉。患心痛。从右肋下起至心前歧骨陷处。并两乳下复连腰背两膀。俱骨缝胀痛。惟右肋并心疼独甚。时作呕恶。初疑凉夜寒邪郁遏。气不流畅所致。用散寒行气药。不效。又疑寒气郁滞。中有郁火。于前剂加散郁火药。亦不效。服加味煮黄丸。乃顿愈。姜黄三钱五分。雄黄三分。去油巴霜八分。去油净。共为细末。醋糊丸黍米大。虚者七丸。实者十一丸。"}]},{"ID":"20240613125028-mmcrrgr","Type":"NodeParagraph","Properties":{"id":"20240613125028-mmcrrgr","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"姜汤送下。按经云。邪气盛则实。惟此辛热之剂。可以导之。前所用药。虽亦散寒。不能及病也。用姜黄乳香者。寒能伤血故耳。"}]},{"ID":"20240613125028-02lqsij","Type":"NodeParagraph","Properties":{"id":"20240613125028-02lqsij","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"〔论〕巴豆树植于西土。其叶在仲夏时新旧相代。而开花成穗即于斯时。结实作房亦踵其后。盖禀地气之金。而受天气之火极其精专者。其实成熟至七八月渐落。此金化于火。"}]},{"ID":"20240613125028-5eggice","Type":"NodeParagraph","Properties":{"id":"20240613125028-5eggice","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"火终于金。专受炎火之气。而绝不受寒水之气者。夫金独受火气。而子气之水绝无与焉。所以偏至之性。洵当有毒也。燥万物者莫如火。故能溃烂有形。损真阴而竭津液。且火气之精专者。独为金用。金司降令。又从于最烈之火。故为斩关夺门之将也。其生用者。存金而去火之毒。可以利水谷道而不伤脏腑。炒用者。从火而制金之锐。可以磨坚结积而不致暴厉。"}]},{"ID":"20240613125028-wpm3st9","Type":"NodeParagraph","Properties":{"id":"20240613125028-wpm3st9","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"本经所云荡练五脏六腑。盖生用合于荡。炒用合于练矣。金化于火。直司降令以透下焦。皆其由阳入阴以神老阳之用。仲淳所谓阳中阴入手足阳明者。庶其近之。惟本至阳以破结阴。"}]},{"ID":"20240613125028-1w6p4c3","Type":"NodeParagraph","Properties":{"id":"20240613125028-1w6p4c3","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"非一切寒滞积久闭塞。固非其对待之治也。"}]},{"ID":"20240613125028-o8ojxga","Type":"NodeParagraph","Properties":{"id":"20240613125028-o8ojxga","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"此药沾人肌肉。无不灼烂。试以少许擦肤。须臾泡出。况肠胃柔嫩。下咽则徐徐而走。"}]},{"ID":"20240613125028-4gq8gmf","Type":"NodeParagraph","Properties":{"id":"20240613125028-4gq8gmf","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"能无溃烂之患耶。又何待下后而耗损真阴耶。不得已急证。欲借其开通道路。亦须炒熟压令油净。入分许即止。不得多用。（仲淳）〔修治〕不去膜则伤胃。不去心则作呕。以沉香水浸。则能升能降。与大黄同用。泻人反缓。为其性相畏也。凡修事。敲碎去油净。用白绢袋包。甘草水煮。焙干。或研膏用。"}]},{"ID":"20240613125028-oe0q9rm","Type":"NodeParagraph","Properties":{"id":"20240613125028-oe0q9rm","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"日华子言。凡入丸散炒用。不如去心膜。换水煮五度各一沸。按巴豆之火毒。所畏者水也。今去心膜换水煮。亦止于缓火毒尔。要知炒去烟。止可以去金之暴气。而火性尚存。金之所畏者火。而巴豆又喜火也。治法宜中的为妙。有用仁者。用壳者。用油者。有生用者。"}]},{"ID":"20240613125028-r86vh26","Type":"NodeParagraph","Properties":{"id":"20240613125028-r86vh26","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"麸"}]},{"ID":"20240613125028-lk4vgn2","Type":"NodeParagraph","Properties":{"id":"20240613125028-lk4vgn2","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"巴豆油"}]},{"ID":"20240613125028-9e7j59a","Type":"NodeParagraph","Properties":{"id":"20240613125028-9e7j59a","updated":"20240613125028"},"Children":[{"Type":"NodeText","Data":"治中风痰厥气厥中恶喉痹。一切急病。咽喉不通。牙关紧闭。以巴豆研烂。绵纸包。压取油。作然点灯。吹灭熏鼻中。或用热烟刺入喉内。即时出涎或恶血。便苏。又舌上无故出血。以熏舌之上下。自止。"}]},{"ID":"20240613124856-1h4tm6n","Type":"NodeThematicBreak","Properties":{"id":"20240613124856-1h4tm6n"}},{"ID":"20240613124907-zzyqbua","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124907-zzyqbua","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"《中国药典》：巴豆"}]},{"ID":"20240613124907-p6gnptl","Type":"NodeParagraph","Properties":{"id":"20240613124907-p6gnptl","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613124907-k4aeeu5","Type":"NodeParagraph","Properties":{"id":"20240613124907-k4aeeu5","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" Bā Dòu"}]},{"ID":"20240613124907-b3iqqqk","Type":"NodeParagraph","Properties":{"id":"20240613124907-b3iqqqk","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613124907-wilj8vh","Type":"NodeParagraph","Properties":{"id":"20240613124907-wilj8vh","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 双眼龙、大叶双眼龙、江子、猛子树、八百力、芒子"}]},{"ID":"20240613124907-gf5gk2q","Type":"NodeParagraph","Properties":{"id":"20240613124907-gf5gk2q","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613124907-gzj26i0","Type":"NodeParagraph","Properties":{"id":"20240613124907-gzj26i0","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" FRUCTUS CROTONIS"}]},{"ID":"20240613124907-k3p0y40","Type":"NodeParagraph","Properties":{"id":"20240613124907-k3p0y40","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613124907-sunzc0b","Type":"NodeParagraph","Properties":{"id":"20240613124907-sunzc0b","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 本品为大戟科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"巴豆"},{"Type":"NodeText","Data":"Croton tiglium L。的干燥成熟"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"，根及叶亦供药用。秋季果实成熟时采收，堆置2～3天，摊开，干燥。根、叶全年可采，根切片，叶晒干备用。"}]},{"ID":"20240613124907-8g8fumx","Type":"NodeParagraph","Properties":{"id":"20240613124907-8g8fumx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613124907-kvhcmio","Type":"NodeParagraph","Properties":{"id":"20240613124907-kvhcmio","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 本品呈卵圆形，一般具三棱，长1.8～2.2cm，直径1.4～2cm。表面灰黄色或稍深，粗糙，有纵线6条，顶端平截，基部有果梗痕。破开果壳，可见3室，每室含种子1粒。种子呈略扁的椭圆形，长1.2～1.5cm，直径0.7～0.9cm，表面棕色或灰棕色，一端有小点状的种脐及种阜的疤痕，另端有微凹的合点，其间有隆起的种脊；外种皮薄而脆，内种皮呈白色薄膜；种仁黄白色，油质。无臭，味辛辣。"}]},{"ID":"20240613124907-xnfvypx","Type":"NodeParagraph","Properties":{"id":"20240613124907-xnfvypx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613124907-r2ytxce","Type":"NodeParagraph","Properties":{"id":"20240613124907-r2ytxce","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240613124907-vnxwc5p","Type":"NodeParagraph","Properties":{"id":"20240613124907-vnxwc5p","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613124907-p3d2p16","Type":"NodeParagraph","Properties":{"id":"20240613124907-p3d2p16","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 生巴豆：去皮取净仁。"}]},{"ID":"20240613124907-3ak8lkp","Type":"NodeParagraph","Properties":{"id":"20240613124907-3ak8lkp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613124907-qx3omi7","Type":"NodeParagraph","Properties":{"id":"20240613124907-qx3omi7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 取本品约0.5g，研碎，加乙醚10ml，浸泡 2小时，并时时振摇，滤过，滤液置试管中挥干，加盐酸羟胺饱和的甲醇溶液0.5ml 及麝香草酚酞指示液 1滴，再加氢氧化钾饱和的甲醇溶液至显蓝色后，再多加4滴，加热至沸腾，冷却，加稀盐酸调节pH值至2～3，加三氯化铁试液3 滴及氯仿1ml，振摇，上层溶液显紫红色。"}]},{"ID":"20240613124907-jh3e515","Type":"NodeParagraph","Properties":{"id":"20240613124907-jh3e515","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613124907-nvckzjm","Type":"NodeParagraph","Properties":{"id":"20240613124907-nvckzjm","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 种子：归胃、大肠经。"}]},{"ID":"20240613124907-bme8wv9","Type":"NodeParagraph","Properties":{"id":"20240613124907-bme8wv9","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613124907-5euo8o2","Type":"NodeParagraph","Properties":{"id":"20240613124907-5euo8o2","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 种子：辛，热；有大毒。根、叶：辛、温。有毒。"}]},{"ID":"20240613124907-n8w56dp","Type":"NodeParagraph","Properties":{"id":"20240613124907-n8w56dp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613124907-6nbz6wx","Type":"NodeParagraph","Properties":{"id":"20240613124907-6nbz6wx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 孕妇禁用；不宜与牵牛子同用。"}]},{"ID":"20240613124907-jp14m0p","Type":"NodeParagraph","Properties":{"id":"20240613124907-jp14m0p","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613124907-rkes4is","Type":"NodeParagraph","Properties":{"id":"20240613124907-rkes4is","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 种子：泻下祛积，逐水消肿。用于寒积停滞，胸腹胀满；外用蚀疱。用于恶疮疥癣，疣痣，白喉，疟疾，肠梗阻。根：温中散寒，祛风活络。用于风湿性关节炎，跌打肿痛，毒蛇咬伤。叶：外用治冻疮，并可杀孑孓、蝇蛆。"}]},{"ID":"20240613124907-bxlc1m8","Type":"NodeParagraph","Properties":{"id":"20240613124907-bxlc1m8","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613124907-xzjza4g","Type":"NodeParagraph","Properties":{"id":"20240613124907-xzjza4g","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 种子：0.5～1分，内服去种皮榨去油，配入丸、散剂；外用适量，研末涂患处，或捣烂以纱布包擦患处。根：1～3钱。叶外用适量，煎水洗患处。"}]},{"ID":"20240613124907-rs3nqfk","Type":"NodeParagraph","Properties":{"id":"20240613124907-rs3nqfk","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613124907-tp77dyq","Type":"NodeParagraph","Properties":{"id":"20240613124907-tp77dyq","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613124907-e0yzfj7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124907-e0yzfj7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：巴豆"}]},{"ID":"20240613124907-eviv7ub","Type":"NodeParagraph","Properties":{"id":"20240613124907-eviv7ub","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613124907-77t0qou","Type":"NodeParagraph","Properties":{"id":"20240613124907-77t0qou","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" Bā Dòu"}]},{"ID":"20240613124907-ncbr9pc","Type":"NodeParagraph","Properties":{"id":"20240613124907-ncbr9pc","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613124907-i63lwcx","Type":"NodeParagraph","Properties":{"id":"20240613124907-i63lwcx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 巴菽（《本经》），刚子（《雷公炮炙论》），江子（《瑞竹堂经验方》），老阳子（《纲目》），双眼龙（《岭南采药录》），猛子仁（《中国药植志》），巴果（《中药形性经验鉴别法》），巴米（《药材资料汇编》），双眼虾、红子仁、豆贡（《南宁市药物志》），毒鱼子、銮豆、贡仔（《中药志》），八百力（《广西中药志》），大叶双眼龙、巴仁、芒子（广州部队《常用中草药手册》）。"}]},{"ID":"20240613124907-k07615z","Type":"NodeParagraph","Properties":{"id":"20240613124907-k07615z","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613124907-722qf98","Type":"NodeParagraph","Properties":{"id":"20240613124907-722qf98","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613124907-nl1k4uy","Type":"NodeParagraph","Properties":{"id":"20240613124907-nl1k4uy","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613124907-efipwgy","Type":"NodeParagraph","Properties":{"id":"20240613124907-efipwgy","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 为大戟科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"巴豆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。8～9月果实成熟时采收，晒干后，除去果壳，收集种子，晒干。"}]},{"ID":"20240613124907-ynmzta6","Type":"NodeParagraph","Properties":{"id":"20240613124907-ynmzta6","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613124907-5avmfkj","Type":"NodeParagraph","Properties":{"id":"20240613124907-5avmfkj","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 多为栽培植物；野生于山谷、溪边、旷野，有时亦见于密林中。分布四川、湖南、湖北、云南、贵州、广西、广东、福建、台湾、浙江、江苏。"}]},{"ID":"20240613124907-coghteh","Type":"NodeParagraph","Properties":{"id":"20240613124907-coghteh","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613124907-wnmvdaz","Type":"NodeParagraph","Properties":{"id":"20240613124907-wnmvdaz","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 常绿乔木，高6～10米。幼枝绿色，被稀疏星状柔毛或几无毛；二年生枝灰绿色，有不明显黄色细纵裂纹。叶互生；叶柄长2～6厘米；叶片卵形或长圆状卵形，长5～13厘米，宽2.5～6厘米，先端渐尖，基部圆形或阔楔形，近叶柄处有2腺体，叶缘有疏浅锯齿，两面均有稀疏星状毛，主脉3出；托叶早落。花单性，雌雄同株；总状花序顶生，上部着生雄花，下部着生雌花，亦有全为雄花者；花梗细而短，有星状毛；雄花绿色，较小，花萼5裂，疏生细微的星状毛，萼片卵形，花瓣5，反卷，内面密生细的绵状毛，雄蕊15～20,着生于花盘边缘上，花盘盘状；雌花花萼5裂，无花瓣，子房圆形，3室，密被短粗的星状毛，花柱3枚，细长，每枚再2深裂。蒴果长圆形至倒卵形，有3钝角。种子长卵形，3枚，淡黄褐色。花期3～5月。果期6～7月。"}]},{"ID":"20240613124907-wg5ekbq","Type":"NodeParagraph","Properties":{"id":"20240613124907-wg5ekbq","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613124907-f7eznxf","Type":"NodeParagraph","Properties":{"id":"20240613124907-f7eznxf","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 干燥种子呈椭圆形或卵形，略扁，长约1～1.5厦米，直径约6～9毫米，厚约4～7毫米，表面灰棕色至棕色，平滑而少光泽。种阜在种脐的-端，为一细小突起，易脱落。合点在另一端，合点与种阜间有种脊，为一略隆起的纵棱线。横断面略呈方形，种皮薄而坚脆，剥去后，可见种仁，外包膜状银白色的外胚乳。内胚乳肥厚，淡黄色，油质。中央有菲薄的子叶2枚。胚根细小，朝向种阜的一端。气无，味微涩，而后有持久辛辣感。以个大、饱满、种仁色白者佳。粒较空、种仁泛油变色者质次。"}]},{"ID":"20240613124907-ku1lfo0","Type":"NodeParagraph","Properties":{"id":"20240613124907-ku1lfo0","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"主产四川、广西、云南、贵州。以四川产量最大，质量较佳。此外，广东、福建等地亦产。"}]},{"ID":"20240613124907-h59aftd","Type":"NodeParagraph","Properties":{"id":"20240613124907-h59aftd","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613124907-kq671ma","Type":"NodeParagraph","Properties":{"id":"20240613124907-kq671ma","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 含巴豆油，其中有油酸、亚油酸、巴豆油酸、顺芷酸等的甘油酯；尚含巴豆甙。"}]},{"ID":"20240613124907-xn9c4hm","Type":"NodeParagraph","Properties":{"id":"20240613124907-xn9c4hm","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613124907-iixk39k","Type":"NodeParagraph","Properties":{"id":"20240613124907-iixk39k","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 巴豆仁：拣净杂质，用粘稠的米汤或面汤浸拌，置日光下曝晒或烘裂，搓去皮，簸取净仁。巴豆霜：取净巴豆仁，碾碎，用多层吸油纸包裹，加热微炕，压榨去油，每隔2天取出复研和换纸1次，如上法压榨六、七次至油尽为度，取出，碾细，过筛。"}]},{"ID":"20240613124907-czg8xo6","Type":"NodeParagraph","Properties":{"id":"20240613124907-czg8xo6","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"《霍公炮炙论》：\"凡修事巴豆，敲碎，以麻油并酒等煮巴豆了，研膏后用。每修事一两，以酒、麻油各七合，尽为度。\""}]},{"ID":"20240613124907-dg1db6f","Type":"NodeParagraph","Properties":{"id":"20240613124907-dg1db6f","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613124907-aurcvn7","Type":"NodeParagraph","Properties":{"id":"20240613124907-aurcvn7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 入胃、大肠经。"}]},{"ID":"20240613124907-8r9m12k","Type":"NodeParagraph","Properties":{"id":"20240613124907-8r9m12k","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾、胃、大肠三经。\""}]},{"ID":"20240613124907-vtpf5yy","Type":"NodeParagraph","Properties":{"id":"20240613124907-vtpf5yy","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肝、肾二经。\""}]},{"ID":"20240613124907-l0e19fx","Type":"NodeParagraph","Properties":{"id":"20240613124907-l0e19fx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613124907-u6puc3w","Type":"NodeParagraph","Properties":{"id":"20240613124907-u6puc3w","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 辛，热，有毒。"}]},{"ID":"20240613124907-rflg1ll","Type":"NodeParagraph","Properties":{"id":"20240613124907-rflg1ll","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240613124907-hbxz5in","Type":"NodeParagraph","Properties":{"id":"20240613124907-hbxz5in","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、歧伯、桐君：辛，有毒。黄帝：甘，有毒。\""}]},{"ID":"20240613124907-79adlcw","Type":"NodeParagraph","Properties":{"id":"20240613124907-79adlcw","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"性热，味苦。\""}]},{"ID":"20240613124907-7w6zx4g","Type":"NodeParagraph","Properties":{"id":"20240613124907-7w6zx4g","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"辛咸，热，毒。\""}]},{"ID":"20240613124907-xybip2c","Type":"NodeParagraph","Properties":{"id":"20240613124907-xybip2c","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613124907-q3tpyhf","Type":"NodeParagraph","Properties":{"id":"20240613124907-q3tpyhf","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 无寒实积滞、孕妇及体弱者忌服。"}]},{"ID":"20240613124907-q5jkqto","Type":"NodeParagraph","Properties":{"id":"20240613124907-q5jkqto","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"芫花为之使。恶蘘草。畏大黄、黄连、藜芦。\""}]},{"ID":"20240613124907-a0xizwr","Type":"NodeParagraph","Properties":{"id":"20240613124907-a0xizwr","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"②《药对》：\"畏芦笋、菰笋、酱鼓、冷水。得火良。与牵牛相反。\""}]},{"ID":"20240613124907-jeqx20x","Type":"NodeParagraph","Properties":{"id":"20240613124907-jeqx20x","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能落胎。\""}]},{"ID":"20240613124907-w06dgzl","Type":"NodeParagraph","Properties":{"id":"20240613124907-w06dgzl","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"④《本草衍义补遗》：\"无寒积者忌之。\""}]},{"ID":"20240613124907-xcdd7hn","Type":"NodeParagraph","Properties":{"id":"20240613124907-xcdd7hn","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613124907-0r8a0gi","Type":"NodeParagraph","Properties":{"id":"20240613124907-0r8a0gi","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 泻寒积，通关窍，逐痰，行水，杀虫。治冷积凝滞，胸腹胀满急痛，血瘕，痰癖，泻痢，水肿，外用治喉风，喉痹，恶疮疥癣。"}]},{"ID":"20240613124907-4wljp2o","Type":"NodeParagraph","Properties":{"id":"20240613124907-4wljp2o","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤寒温疟寒热，破症瘕结聚坚积，留饮痰癖，大腹水肿。荡练五脏六腑，开通闭塞，利水谷道。去恶肉。\""}]},{"ID":"20240613124907-n6ajqg3","Type":"NodeParagraph","Properties":{"id":"20240613124907-n6ajqg3","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗女子月闭，烂胎，金疮脓血不利，丈夫阴颓，杀斑螫毒。\""}]},{"ID":"20240613124907-4h4xd67","Type":"NodeParagraph","Properties":{"id":"20240613124907-4h4xd67","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主破心腹积聚结气，治十种水肿，痿痹，大腹。\""}]},{"ID":"20240613124907-xi50o3v","Type":"NodeParagraph","Properties":{"id":"20240613124907-xi50o3v","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"主症癖，痃气，痞满，腹内积聚，冷气血块，宿食不消，痰饮吐水。’"}]},{"ID":"20240613124907-idscdtz","Type":"NodeParagraph","Properties":{"id":"20240613124907-idscdtz","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"通宣一切病，泄壅滞，除风补劳，健脾开胃，消痰破血，排脓消肿毒，杀腹藏虫。治恶疮息肉及疥癞疔肿。\""}]},{"ID":"20240613124907-axb5wra","Type":"NodeParagraph","Properties":{"id":"20240613124907-axb5wra","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"导气消积，去脏腑停寒，消化寒凉及生冷硬物所伤，去胃中寒湿。\""}]},{"ID":"20240613124907-o85ijf8","Type":"NodeParagraph","Properties":{"id":"20240613124907-o85ijf8","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑦《汤液本草》：\"可以通肠，可以止泄。\""}]},{"ID":"20240613124907-37cn6ow","Type":"NodeParagraph","Properties":{"id":"20240613124907-37cn6ow","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"治泻痢，惊痫，心腹痛，疝气，风歪，耳聋，喉痹，牙痛，通利关窍。\""}]},{"ID":"20240613124907-9ash4km","Type":"NodeParagraph","Properties":{"id":"20240613124907-9ash4km","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613124907-8y1xjza","Type":"NodeParagraph","Properties":{"id":"20240613124907-8y1xjza","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散，0.5～1分（用巴豆霜）。外用：绵裹塞耳鼻，捣膏涂或以绢包擦患处。"}]},{"ID":"20240613124907-jobbbok","Type":"NodeParagraph","Properties":{"id":"20240613124907-jobbbok","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613124907-xwu4k2a","Type":"NodeParagraph","Properties":{"id":"20240613124907-xwu4k2a","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" ①治寒实结胸，无热症者：桔梗三分，巴豆一分（去心皮，熬黑，研如脂），贝母三分。三味为散，以白饮和服，强人半钱匕，羸者减之。病在膈上必吐，在膈下必利。不利，进热粥一杯，利过不止，进冷粥一杯。（《伤寒论》白散）"}]},{"ID":"20240613124907-8fe0dy4","Type":"NodeParagraph","Properties":{"id":"20240613124907-8fe0dy4","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑤治心腹诸卒暴百病，若中恶客忤，心腹胀满，卒痛如锥刺，气急口噤，停尸卒死者：大黄一两，干姜一两，巴豆一两（去皮心，熬，外研如脂）。上药各须精新，先捣大黄、干姜为末，研巴豆纳中，合治一千杵，用为散，蜜和丸亦佳。以暖水若酒服大豆许三、四丸，或不下，捧头起，灌令下咽，须臾当瘥；如未瘥，更与三丸，当腹中鸣，即吐下便瘗；若口噤，亦须折齿灌之。（《金匮要略）三物备急丸）"}]},{"ID":"20240613124907-kq5toeg","Type":"NodeParagraph","Properties":{"id":"20240613124907-kq5toeg","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑥治寒癖宿食，久饮不消，大便秘：巴豆仁一升，清酒五升。煮三日三夜，研，令大热，合酒微火煎之，丸如胡豆大，每服一丸，水下，欲吐者服二丸。（《千金方》）"}]},{"ID":"20240613124907-6csls1b","Type":"NodeParagraph","Properties":{"id":"20240613124907-6csls1b","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"④治痞结癥瘕：巴豆肉五粒（纸裹打去油），红曲三两（炒），小麦麸皮一两（炒）。俱研为细末，总和为丸，如黍米大，每空心服十丸，白汤下。（《海上方》）"}]},{"ID":"20240613124907-4hnkrq1","Type":"NodeParagraph","Properties":{"id":"20240613124907-4hnkrq1","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑤治阴毒伤寒心结，按之极痛，大小便秘，但出气稍暖者：巴豆十粒，研，入面一钱，捻作饼，安脐内，以小艾炷灸五壮。气达即通。（《仁斋直指方》）"}]},{"ID":"20240613124907-3g9jrzx","Type":"NodeParagraph","Properties":{"id":"20240613124907-3g9jrzx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑥治小儿L痰喘：巴豆一粒，杵烂，绵裹塞鼻，痰即自下。（《古今医鉴》）"}]},{"ID":"20240613124907-ixrmwd7","Type":"NodeParagraph","Properties":{"id":"20240613124907-ixrmwd7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑦治寒痰气喘：青橘皮一片，展开，入刚子一个，麻扎定，火上烧存性，研末，姜汁和酒一钟，呷服。（《医说》）"}]},{"ID":"20240613124907-8qp137s","Type":"NodeParagraph","Properties":{"id":"20240613124907-8qp137s","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑧治夏月水泻不止：大巴豆一粒（去壳）。上以针刺定，灯上烧存性，研细，化蜡和作一丸，水下，食前服。（《世医得效方，针头丸）"}]},{"ID":"20240613124907-6zzk44x","Type":"NodeParagraph","Properties":{"id":"20240613124907-6zzk44x","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑨治气痢：巴豆一两，去皮心，熬，细研，取热猪肝和丸，空心米饮下，量力加减服之。牛肝尤佳。或以蒸饼丸服。（《经验方》）"}]},{"ID":"20240613124907-zsvs8y1","Type":"NodeParagraph","Properties":{"id":"20240613124907-zsvs8y1","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑩治小儿下痢赤白：巴豆（煨熟，去油）一钱，百草霜二钱（研末），飞罗面煮糊丸，黍米大，量人用之。赤用甘草汤，白用米汤，赤白用姜汤下。（《全幼心鉴》）"}]},{"ID":"20240613124907-u05xm79","Type":"NodeParagraph","Properties":{"id":"20240613124907-u05xm79","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑴治伏暑伤冷，冷热不调，霍乱吐利，口干烦渴：巴豆大者二十五枚（去皮膜，研取油尽，如粉），黄丹（炒，研，罗过）取一两一分。上同研匀，用黄蜡熔作汁，为丸如梧桐子大，每服五丸，以水浸少顷，别以新汲水吞下，不拘时候。（《局方》水浸丹）"}]},{"ID":"20240613124907-yr79l9w","Type":"NodeParagraph","Properties":{"id":"20240613124907-yr79l9w","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑿治腹大动摇水声，皮肤黑，名曰水臌：巴豆九十枚（去皮心），杏仁六十枚（去皮尖）。并熬令黄，捣和之，服如小豆大一枚，以水下为度，勿饮酒。（《补缺肘后方》）"}]},{"ID":"20240613124907-z1n7o85","Type":"NodeParagraph","Properties":{"id":"20240613124907-z1n7o85","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒀治肝硬化腹水：巴豆霜一钱；轻粉五分。放于四、五层纱布上，贴在肚脐上，表面再盖二层纱布。经一至二小时后感到刺痒时即可取下，待水泻。若不泻则再敷。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240613124907-r0g8l5n","Type":"NodeParagraph","Properties":{"id":"20240613124907-r0g8l5n","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒁治喉痹：白矾二两（捣碎），巴豆半两（略捶破）。同于铫器内炒，侯矾枯，去巴豆不用，碾矾为细末，遇病以水调灌，或干吹入咽喉中。（《百一选方》）"}]},{"ID":"20240613124907-u8qpfqq","Type":"NodeParagraph","Properties":{"id":"20240613124907-u8qpfqq","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒂治白喉：巴豆仁、朱砂等分，各研成细末，混和，每用3～5分，置膏药上，贴于眉间的上方（勿使药末掉入眼中）。约经8～12小时，局部皮肤发生大小不等的水泡时，便可揭去膏药，擦掉药末，涂上1％龙胆紫液，以防感染。（《江苏中医》（11）：23，1959巴豆朱砂膏）"}]},{"ID":"20240613124907-axto31g","Type":"NodeParagraph","Properties":{"id":"20240613124907-axto31g","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒃治耳卒聋：巴豆一粒，蜡裹，针刺令通透，用塞耳中。（《经验方》）"}]},{"ID":"20240613124907-5546208","Type":"NodeParagraph","Properties":{"id":"20240613124907-5546208","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒄治风虫牙痛：㈠巴豆一粒，研，绵裹咬之。㈡针刺巴豆，灯上烧令烟出，熏痛处。（《经验方》）"}]},{"ID":"20240613124907-gwxctt9","Type":"NodeParagraph","Properties":{"id":"20240613124907-gwxctt9","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒅治一切恶疮：巴豆三十粒，麻油煎黑，去豆，以油调雄黄、轻粉末，频涂取效。（《普济方》）"}]},{"ID":"20240613124907-uc3lzfa","Type":"NodeParagraph","Properties":{"id":"20240613124907-uc3lzfa","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒆治一切疮毒及腐化瘀肉：巴豆去壳，炒焦，研膏，点肿处则解毒，涂瘀肉则自腐化。（《痈疽神秘验方》乌金膏）"}]},{"ID":"20240613124907-cyae118","Type":"NodeParagraph","Properties":{"id":"20240613124907-cyae118","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⒇治荷钱癣疮：巴豆仁三个，连油杵泥，以生绢包擦，日一、二次。（《秘传经验方》）"}]},{"ID":"20240613124907-2yylt4p","Type":"NodeParagraph","Properties":{"id":"20240613124907-2yylt4p","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613124907-upv0uxp","Type":"NodeParagraph","Properties":{"id":"20240613124907-upv0uxp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" ①防治白喉"}]},{"ID":"20240613124907-tezs32p","Type":"NodeParagraph","Properties":{"id":"20240613124907-tezs32p","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"对白喉密切接触者，病人家属、白喉恢复期患者、健康带菌者，以及轻症白喉病例，均可采用巴豆泥局部贴敷的方法加以防治。方法：将除去内外壳的生巴豆仁0.5克在消毒乳钵中研成泥状（或加朱砂0.5克共研），挑取绿豆大的膏点，置于约1.5厘米平方的胶布上。贴于两眉间印堂穴，或颈部扶突穴，经6～8小时（最长12小时）揭去，可见局部出现一小水泡，即用消毒针尖刺破，以消毒棉球拭干渗液，再涂龙胆紫液。对白喉密切接触者及病人家属，贴巴豆朱砂膏后，经对照观察，能降低发病率；对白喉恢复期患者或健康带菌者，用巴豆泥外敷后，可使90％以上病例于8～24小时内带菌现象消失；对轻症白喉可配合青霉素及其他对症治疗。"}]},{"ID":"20240613124907-1z9sede","Type":"NodeParagraph","Properties":{"id":"20240613124907-1z9sede","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"②治疗喉梗阻"}]},{"ID":"20240613124907-cs35gqk","Type":"NodeParagraph","Properties":{"id":"20240613124907-cs35gqk","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"因白喉及麻疹后喉炎引起的喉梗阻，可用生熟巴豆散约0.5～O.7分，用喷粉器吹入咽部，观察2～3小时，如无呕吐、腹泻或呕吐腹泻次数不多，而梗阻症状尚未明显好转的，可再行第2、3次喷咽，1天内喷咽不超过3次，必要时可连续喷2～3天。如呕吐腹泻较着者，应立即停止。对体质虚弱、心力衰竭及并发心肌炎病变者慎用。多敷病例在喷咽后半小时至3～4小时，可见吸气性陷没、呼吸促迫及喘鸣等症状明显好转，数小时至1～2天内梗阻解除。治疗过程中应同时使用白喉抗毒素及磺胺类、抗菌素。对气管下位梗阻无效。呕吐泄泻为常见反应，但梗阻症状多在腹泻咸呕吐后得到明显改善。生熟巴豆散系用3粒生、4粒熟的巴豆研末去油制成。制法：取七倍数的巴豆若干粒去壳去衣，将其中4／7炒至黄色，与其余3／7的生巴豆共研成粉末。把它夹在数层能吸收油分的纸内，用力挤压去油，再换纸用温热熨斗在纸上熨压，去净残留油分，然后再研成细末备用。"}]},{"ID":"20240613124907-q52ksd7","Type":"NodeParagraph","Properties":{"id":"20240613124907-q52ksd7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"③治疗支气管哮喘及哮喘性支气管炎"}]},{"ID":"20240613124907-z22njjf","Type":"NodeParagraph","Properties":{"id":"20240613124907-z22njjf","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"取苹果1只洗净，用小刀挖1个三角形小洞，另用巴豆仁1粒放入小洞，仍将苹果盖严，隔汤蒸30～60分钟。放凉，取出巴豆仁，吃苹果，喝苹果汤。成人每日吃1个，重症早晚各吃1个，夜间喘息者临睡前吃。8岁以下小儿酌减。可连续服用数周。服后具有止喘、祛痰作用；个别病例可能出现轻微腹泻。"}]},{"ID":"20240613124907-4pacfs3","Type":"NodeParagraph","Properties":{"id":"20240613124907-4pacfs3","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"④治疗急、慢性肠炎及慢性痢疾"}]},{"ID":"20240613124907-5bzxhwm","Type":"NodeParagraph","Properties":{"id":"20240613124907-5bzxhwm","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"取巴豆适量去内外壳，取仁，不去油，放入铜（或铁）勺中置炭火上炒焦，至巴豆内外黑透为度，待冷，秤准2钱，研成泥状备用。另将蜂蜡2钱溶化，与巴豆泥搅拌均匀，候稍冷，搓条制丸，约制成80丸，每丸重0.15克，内含巴豆O.075克。成人每次0.6克（4丸），日服3次，空腹时服用；8～15岁，每服2丸；5～7岁，每服1丸；1～4岁，每服半丸；6个月以上，每服1／3丸；6个月以下，每服1／4丸；未满1月婴儿忌服。服后未见腹痛、腹泻、呕吐等副作用。凡兼有发热及其他合并症者忌服。经治疗急性腹胃13例，慢性腹泻4例，慢性下痢4例，均治愈。本药对体虚老人的慢性泄泻亦有效。"}]},{"ID":"20240613124907-q16nmsw","Type":"NodeParagraph","Properties":{"id":"20240613124907-q16nmsw","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑤治疗急性阑尾炎"}]},{"ID":"20240613124907-m70khw3","Type":"NodeParagraph","Properties":{"id":"20240613124907-m70khw3","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"将巴豆、朱砂各0.5～1.5克研细混匀，置6x6厘米大小的膏药或胶布上，贴于阑尾穴，外用绷带固定。24～36小时检查所贴部位，皮肤应发红或起小水泡，若无此现象，可重新更换新药。共治疗99例，其中急性单纯性阑尾炎17例，伴有不同程度的并发症者82例。最少的贴1次，最多的贴3次。效果：治愈85例，无效14例（仍用手术治疗）。"}]},{"ID":"20240613124907-otiq4ll","Type":"NodeParagraph","Properties":{"id":"20240613124907-otiq4ll","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"⑥治疗神经性皮炎"}]},{"ID":"20240613124907-3w2kwb2","Type":"NodeParagraph","Properties":{"id":"20240613124907-3w2kwb2","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"取巴豆去壳1两，雄黄1钱，磨碎后用3～4层纱布包裹，每天擦患处3～4次，每次1～2分钟，直至痒感消失，皮损消退为止。"}]},{"ID":"20240613124907-102yvez","Type":"NodeParagraph","Properties":{"id":"20240613124907-102yvez","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613124907-xy5c6c7","Type":"NodeParagraph","Properties":{"id":"20240613124907-xy5c6c7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 本植物的根（巴豆树根）、叶（巴豆叶）、种皮（巴豆壳）以及种仁之脂肪油（巴豆油）亦供药用，各详专条。"}]},{"ID":"20240613124907-dk89wns","Type":"NodeParagraph","Properties":{"id":"20240613124907-dk89wns","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613124907-67c6lpt","Type":"NodeParagraph","Properties":{"id":"20240613124907-67c6lpt","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613124907-cnn7x4c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613124907-cnn7x4c","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"《中华本草》：巴豆"}]},{"ID":"20240613124907-rp8vdmi","Type":"NodeParagraph","Properties":{"id":"20240613124907-rp8vdmi","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613124907-h3rikws","Type":"NodeParagraph","Properties":{"id":"20240613124907-h3rikws","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" Bā Dòu"}]},{"ID":"20240613124907-awtgvn1","Type":"NodeParagraph","Properties":{"id":"20240613124907-awtgvn1","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613124907-uhrwcp6","Type":"NodeParagraph","Properties":{"id":"20240613124907-uhrwcp6","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 巴菽、刚子、江子、老阳子、双眼龙、猛子仁、巴果、双眼虾、红子仁、巴贡、巴米、毒鱼子、銮豆、贡仔、八百力、巴仁、芒子、药子仁、芦麻子、腊盘子、大风子、泻果。"}]},{"ID":"20240613124907-j9kxxek","Type":"NodeParagraph","Properties":{"id":"20240613124907-j9kxxek","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613124907-wd8z63c","Type":"NodeParagraph","Properties":{"id":"20240613124907-wd8z63c","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" croton，croton seed，croton tiglium，fructus crotonis，purging croton，Semen Crotonis"}]},{"ID":"20240613124907-vqkkg3i","Type":"NodeParagraph","Properties":{"id":"20240613124907-vqkkg3i","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613124907-7dt9lik","Type":"NodeParagraph","Properties":{"id":"20240613124907-7dt9lik","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 出自《本草纲目》。"}]},{"ID":"20240613124907-1w8if28","Type":"NodeParagraph","Properties":{"id":"20240613124907-1w8if28","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613124907-7skud6b","Type":"NodeParagraph","Properties":{"id":"20240613124907-7skud6b","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 药材基源：为大戟科植物巴豆的种子。"}]},{"ID":"20240613124907-60vww1u","Type":"NodeParagraph","Properties":{"id":"20240613124907-60vww1u","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Croton tiglium L."}]},{"ID":"20240613124907-7mpdc9v","Type":"NodeParagraph","Properties":{"id":"20240613124907-7mpdc9v","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种5-6年始结果，8-11月果实成熟，可分批采收，除去残枝落叶，摊放2-3d，晒干或烘干，去果壳，将种子扬净。"}]},{"ID":"20240613124907-awiq2ft","Type":"NodeParagraph","Properties":{"id":"20240613124907-awiq2ft","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613124907-4rgv9jp","Type":"NodeParagraph","Properties":{"id":"20240613124907-4rgv9jp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山野、丘陵地，房屋附近常见栽培。"}]},{"ID":"20240613124907-yb12csj","Type":"NodeParagraph","Properties":{"id":"20240613124907-yb12csj","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及福建、湖北、湖南、广东、广西等地。"}]},{"ID":"20240613124907-apv8y0n","Type":"NodeParagraph","Properties":{"id":"20240613124907-apv8y0n","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613124907-malgko9","Type":"NodeParagraph","Properties":{"id":"20240613124907-malgko9","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 巴豆 灌木或小乔木，高2-10m。幼枝绿色，被稀疏星状毛，老枝无毛。单叶互生；叶柄长2-6cm；托叶线形，长2-4mm，早落；叶膜质卵形至长圆状卵形，长5-15cm，宽2.5-8cm，先端渐尖或长渐尖，基部圆形或阔楔形，近叶柄处有2枚无柄的杯状腺体，叶缘有疏浅锯齿，齿尖常具小腺体，幼时两面均有稀疏星状毛，后变无毛或在下面被极少数星状毛，干时呈淡黄色。总状花序顶生，长5-14cm，有时达观20cm，上部着生雄花，下部着生雌花，也有全为雄花而无雌花的；苞片钻状，长约2mm；雄花花梗细而短，长3-4mm，有星状毛；雄花绿色，较小；花萼5深裂，先端疏生星状毛，裂片卵形，长约2mm；花瓣5，长圆形，与花萼几等大，反卷，内面和边缘生细绵毛；雄蕊15-20，着生花盘边缘，花丝上部被柔毛，花药干时呈黑色；花盘盘状，边缘有浅缺刻；无退化子房；雌花花梗较粗，长2-3mm；花萼5深裂，裂片长圆形，外被星状毛，长约2.5mm；无花瓣；子房倒卵形，密被粗短的星状毛，3室，每室1胚珠，花柱3，每个2深裂。蒴果倒卵形至长圆形，有3钝角，长约2cm，近无毛或被稀疏星状毛，种子3颗，长卵形，背面稍凸，淡黄褐色，长约是1cm，宽6-7mm。花期3-10月，果期7-11月。"}]},{"ID":"20240613124907-k7yuv8w","Type":"NodeParagraph","Properties":{"id":"20240613124907-k7yuv8w","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613124907-36rrjce","Type":"NodeParagraph","Properties":{"id":"20240613124907-36rrjce","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，不耐寒，怕霜冻。喜阳光，在气温17-19℃、年雨量1000mm、全年日照1000h、无霜期300d以上的地区适宜栽培，当温度低于3℃时幼苗叶全部枯死。以阳光充足、土层深厚、疏松肥沃、排水良好的砂质壤上栽培为宜。"}]},{"ID":"20240613124907-1qrfwiw","Type":"NodeParagraph","Properties":{"id":"20240613124907-1qrfwiw","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖，直播或育苗移栽。直播：一般8-9月采收伏子留种。高湿地区随采随播，低温地区在翌年2月播种。播前剥去果壳，按行株距3m×3m开穴，穴深3cm，每穴播4-5粒，覆土3-4cm。育苗移栽法：按行距25cm开沟，沟深3cm，播种后覆土，浇水。1hm2用种量180-225kg。苗期需松土除草2-3次，遇旱浇水，苗高15-20cm时施稀人畜粪水。霜降前包草防冻，苗高60-100cm，3-4月移栽，按行珠距3m×3m开穴，穴径30cm，深30cm，每穴栽种1株，覆土压实，浇水。"}]},{"ID":"20240613124907-k1rq6i9","Type":"NodeParagraph","Properties":{"id":"20240613124907-k1rq6i9","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"田间管理 植株在封行前可与小麦、甘薯、蔬菜间作，封行后可在行间栽种阴性植物。生长期要经常浇水，保持土壤湿润，并注意除草，春、夏季各追肥1次。"}]},{"ID":"20240613124907-zh0y7j6","Type":"NodeParagraph","Properties":{"id":"20240613124907-zh0y7j6","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"病虫害防治 尺蠖可用90％晶体敌百虫800倍液喷杀。"}]},{"ID":"20240613124907-9h3ski8","Type":"NodeParagraph","Properties":{"id":"20240613124907-9h3ski8","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613124907-pjvhsuw","Type":"NodeParagraph","Properties":{"id":"20240613124907-pjvhsuw","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品呈卵圆形，一般具3棱，长1.8-2.2cm，直径1.4-2cm。表面灰黄色或稍深，粗糙，有纵线6条，顶端平截，基部有果梗痕。剖开果壳，可见3室，每室含种子1粒。种子椭圆形，略扁，长1.2-1.5cm，直径7-9mm；表面棕色或灰棕色，一端有小点状的种脐及种阜的疤痕，另端有微凹的合点，其间有隆起的种脊；外种皮薄而脆，内种皮呈白色薄膜；种仁黄白色，油质。无臭，味辛辣。以个大、饱满、种仁色黄白者为佳。"}]},{"ID":"20240613124907-lqpy2da","Type":"NodeParagraph","Properties":{"id":"20240613124907-lqpy2da","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果实及种子横切面：外果皮1列表皮细胞，有气孔及厚壁性多细胞的星状毛；中果皮外侧为10余列薄壁细胞，石细胞单个散在或成群，维管束周围细胞有时含草酸钙方晶或簇晶，中部有4-6列纤维状石细胞，呈带状环列，内侧有6-8列径向延长的长圆形薄壁细胞，壁孔少；内果皮为3-5层纤维状厚壁细胞交迭排列。种皮表皮细胞为1列径向延长的长方形细胞，径向壁呈不规则锯齿状弯曲；其下为1列厚壁性栅状细胞，胞腔线形，外端略膨大；向内为数层切向延长的不规则形薄壁细胞，其间散有螺纹导管；内表皮细胞颓废状。胚乳细胞类圆形，充满糊粉粒和脂肪油滴，另含草酸钙簇晶。子叶细胞多角形。"}]},{"ID":"20240613124907-7d5zin6","Type":"NodeParagraph","Properties":{"id":"20240613124907-7d5zin6","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"粉末特征：浅黄棕色。①厚壁性多细胞星状毛，直径129-210-525μm，由6-15个厚壁性细胞排列呈放射状，细胞层纹明层，胞腔线形，近基部略膨大，并具孔沟，基部细胞5-8个，胞壁厚。②石细胞类圆形、长方形或纤维状，壁孔、层纹均明显，类圆形石细胞直径25-63μm，长方形及纤维状石细胞长约77μm，宽17-45μm。③种皮细胞碎片表面现多角形，内含黄棕色物质。④栅状细胞棕红色，长约225μm，直径约21μm，壁厚，胞腔线形，一端略膨大。⑤纤维状厚壁细胞类图形，内含多数糊粉粒和脂肪油滴及草酸钙簇晶。"}]},{"ID":"20240613124907-ibtcklo","Type":"NodeParagraph","Properties":{"id":"20240613124907-ibtcklo","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613124907-28ewxxf","Type":"NodeParagraph","Properties":{"id":"20240613124907-28ewxxf","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 毒性：以巴豆液喂饲小鼠、兔、山羊、鸭、鹅等动物皆无反应；黄牛食之过量，则易发生腹泻、食欲不振及疲乏等，但不致中毒死亡。对青蛙亦属无害，但对鱼、虾、田螺及蚯蚓等，则有毒杀作用。小鼠皮肤长期与巴豆油接触，可致乳头状瘤及癌。长期与巴豆种子提取物、巴豆树脂接触，可促使二甲基苯骈蒽引起乳头状瘤及癌。小鼠每周服1次巴豆油共30周可引起前胃部乳头状瘤及癌，亦可促使二甲基苯骈蒽引起前胃部乳头状瘤及癌。亦有云小鼠皮肤局部应用乌拉坦及巴豆油亦可致皮肤乳头状瘤，但巴豆油本身无致癌作用。所含巴豆毒蛋白系原浆毒，能溶解红细胞，并使局部细胞坏死，引起发赤、起泡和炎症。巴豆8-16粒给狗灌胃可死；人服巴豆油1g，亦有中毒至死的报道。人服巴豆油20滴可致死。巴豆毒素兔皮下注射的LD50为50-80mg，巴豆油酸大鼠口服的LD50为1g/kg；豚鼠皮下注射的LD50为600mg/kg。巴豆油注射在豚鼠的腭及悬雍部可引起蛋白尿和血尿。"}]},{"ID":"20240613124907-l82e2pp","Type":"NodeParagraph","Properties":{"id":"20240613124907-l82e2pp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613124907-h0374kr","Type":"NodeParagraph","Properties":{"id":"20240613124907-h0374kr","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 种子含巴豆油34％- 57％，蛋白质约18％。"}]},{"ID":"20240613124907-7a1wo9q","Type":"NodeParagraph","Properties":{"id":"20240613124907-7a1wo9q","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"巴豆油中含巴豆油酸（crotonic acid），巴豆酸（tiglic acid），由棕榈酸、硬脂酸、油酸、巴豆油酸、巴豆酸等组成的甘油酯，巴豆醇（phorbol）及16种巴豆醇双酯化合物，即巴豆醇-12-十四烷酸酯-13-乙酸酯（phorbol-12-myristate-13-acetate），巴旦醇-12-癸酸酯-13-乙酸酯（phorbol-12-caprate-13-acetate），巴豆醇-12-月桂酸酯-13-乙酸酯（phorbol-12-laurate-13-acetate），巴豆醇-12-棕榈酸酯-13-乙酸酯（phorbol-12-palmitate-13-acetate），巴豆醇-12-a-甲基丁酸酯-13-月桂酸酯（phorbol-12-a-methylbutyrate-13-laurate），巴豆醇-12-a-甲基丁酸酯-13-癸酸酯（phorbol-12-a-methyl-butyrate-13-caprate），巴豆醇-12-乙酸酯-13-月桂酸酯（phorbol-12-acetate-13-laurate）， 巴豆醇-12-乙酸酯-13-癸酸酯（phorbol-12-acetate-13-caprate），巴豆醇-12-巴豆酸酯-13-癸酸酯（phorbol-12-tiglate-13-caprate），巴豆醇-12-巴豆酸酯-13-辛烯酸酯（phorbol-12-tiglate-13-caprylenate），巴豆醇-12-a-甲基丁酸酯-13-辛烯酸酯（phorbol-12-a-methylbutyrate-13-caprylnate），巴豆醇-12-巴豆酸酯-13-月桂酸酯（phorbol-12-tiglate-13-laurate），巴豆醇-12-巴豆酸酯-13-丁酸酯（phorbol-12-tiglate-13-butyrate），巴豆醇-12-丁酸酯-13-月桂酸酯（phorbol-12-butyrate-13-laurate），巴豆醇-12-苯甲酸酯-13-苯甲酸酯（phorbol-12-benzoate-13-benzoate），巴豆醇-4-甲氧基-12-十四烷酸酯-13-乙酸酯（phorbol-4-methoxy-12-myris-tate-13-acetate）和4-去氧-4a-巴豆醇（4-deoxy-4a-phorbol）的三酯化合物等。种仁还含一种毒性球蛋白你巴豆毒素（crotin），从中分离得到巴豆毒素Ⅰ、Ⅱ（crotin Ⅰ、Ⅱ），其相对分子质量分别为40KD和15KD等电点分别为8.0和6.7，另含辅致癌剂C-3（cocarcinogen C-3），巴豆甙（crotonoside），巴豆生物碱异鸟嘌呤（isoguanine），β-谷甾醇（β-sitosterol），氨基酸及酶等。"}]},{"ID":"20240613124907-525r3cf","Type":"NodeParagraph","Properties":{"id":"20240613124907-525r3cf","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613124907-ykfqylc","Type":"NodeParagraph","Properties":{"id":"20240613124907-ykfqylc","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 1.对皮肤粘膜的刺激作用：巴豆油是最剧烈的泻药，口服半滴至1滴即能产生口腔及胃粘膜的烧灼感及呕吐，在1/2-3小时内即有多次大量水泻，伴有剧烈腹痛和里急后重，产生严重口腔刺激症状及胃肠炎症状。外用巴豆油对皮肤有刺激作用，引起发红，可发展为脓疱甚至坏死；用橄榄油稀释后可用作刺激剂，但较危险。小鼠注射流行性乙型脑炎病毒的同天、前1天或前2天，1次皮下注射5%巴豆油，与单独注射病毒的对照组比较，死亡率降低并且生存时间延长，其效果可能是通过神经系统产生的，也可能是直接影响病毒毒性。"}]},{"ID":"20240613124907-rks7dk7","Type":"NodeParagraph","Properties":{"id":"20240613124907-rks7dk7","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"2.对消化道的作用：2.1.巴豆对不同便秘小鼠的排便效果：取小鼠复制成实热型、燥结型及寒结型及脾胃虚寒型便秘模型，分别给予巴豆煎液，并以未造型对照，实验结果表明，巴豆能使脾胃虚寒型便秘小鼠的排便时间明显延长，与对照组相比有显着差异（P\u003c0.05）。"}]},{"ID":"20240613124907-hna4y06","Type":"NodeParagraph","Properties":{"id":"20240613124907-hna4y06","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"2.2.对胃肠消化道及胆汁、胰液分泌的影响：所含巴豆油及树脂，口服后在肠内与碱性液作用，析出巴豆油酸和巴豆醇双酯类化合物，能剧烈刺激肠壁，引起强烈蠕动而致峻泻。巴豆煎剂对离体兔肠肌具有明显的兴奋作用，并不被阿托品所拮抗。巴豆油乳对兔及犬肠亦表现兴奋作用，而大剂量则表现抑制作用，且不被乙酰胆碱，毛果芸香碱或氯化钡所解除，故巴豆油系直接作用于肠肌。此外巴豆油酸给动物灌胃可促进肠蠕动，使肠粘膜出血，甚至引起肠坏疽。胆痿兔实验表明，巴豆水剂能增加胆汁和胰液的分泌。"}]},{"ID":"20240613124907-uhs2igp","Type":"NodeParagraph","Properties":{"id":"20240613124907-uhs2igp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"3.对循环系统和呼吸系统的作用：3.1.在动物离体但联有神经的后肢和肠实验中观察到，巴豆油能通过对化学感受器的作用，反射性升高血压。"}]},{"ID":"20240613124907-w4lg9tp","Type":"NodeParagraph","Properties":{"id":"20240613124907-w4lg9tp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"3.2.巴豆毒蛋白能溶解兔、猬、猪、蛇、鸡的红细胞。对牛、羊、猪、蛙血细胞有凝集作用。巴豆油中的活性成分PMA（Phorbol myristate aceTCMLIBate）可使血小板中环磷鸟苷（cGMP）浓度增加，是一种有力的血小板凝集剂。"}]},{"ID":"20240613124907-lo3t9zf","Type":"NodeParagraph","Properties":{"id":"20240613124907-lo3t9zf","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"3.3.巴豆油乳剂给兔静脉注射能引起呼吸商（RQ）轻度增加，血中二氧化碳浓度稍有降低；若皮下注射可加快呼吸频率，降低呼吸交换量。虽然血红蛋白增加，但仍轻度降低动脉血氧含量。"}]},{"ID":"20240613124907-3x2fby8","Type":"NodeParagraph","Properties":{"id":"20240613124907-3x2fby8","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"4.抗病原生物的作用：巴豆煎剂对流感杆菌、绿脓杆菌、金黄色葡萄球菌及白喉杆菌均有一定的抗菌作用，巴豆油制剂能降低感染流行性乙型脑炎的小鼠死亡率并延长存活时间。"}]},{"ID":"20240613124907-8fpimxq","Type":"NodeParagraph","Properties":{"id":"20240613124907-8fpimxq","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"5.镇痛作用：大鼠压尾法，小鼠热板法及苯酮扭体试验表明，巴豆油口服，皮下注射或腹腔注射能提高痛阈50-70%，其镇痛机理可能与巴豆油的局部刺激有关。"}]},{"ID":"20240613124907-brvfyjg","Type":"NodeParagraph","Properties":{"id":"20240613124907-brvfyjg","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"6.抗肿瘤及促肿瘤发生作用：巴豆提取物对小鼠肉瘤S180实体型和S180腹水型，小鼠宫颈癌U14实体型和U14腹水型，以及艾氏腹水癌皆有明显的抑制作用，巴豆注射液在试管内有杀瘤细胞作用。巴豆醇二酯对小鼠淋巴细胞性白血病P388有一定的抑制作用。巴豆油乳剂作大鼠移植性皮肤癌内注射，能引起瘤体退化，并延缓皮肤癌的发展。因而认为巴豆中含有抗癌活性物质。另一方面，有促使肿瘤发生的作用：巴豆油及巴豆醇可促进致癌物质产生肿瘤。巴豆油虽无致癌作用，但与乌拉坦同用可引起皮肤乳头状瘤。巴豆油及其成分十四烷酰巴豆酯(teTCMLIBadecaoyl phorbol)的乙酸盐可致小鼠皮肤增生，巴豆醇酯C能改变小鼠胚胎纤维母细胞膜的结构和通透性，这些变化都可能与促使肿瘤发生有关。巴豆油和牛的丙种球蛋白抗原一起给豚鼠注射，能抑制抗体的生成，并延迟对抗原的过敏反应，巴豆醇免疫抑制作用比巴豆油更强，此种免疫抑制作用亦可能是促使肿瘤产生的原因之一。也有人认为，促使肿瘤的发生可能与巴豆醇酯抑制细胞分化，能使鸟氨酸脱羧酶种纤维蛋白溶酶原活化剂升高等有着密切的关系。"}]},{"ID":"20240613124907-6n89xc5","Type":"NodeParagraph","Properties":{"id":"20240613124907-6n89xc5","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"7.其它作用：巴豆有杀灭钉螺的作用，以种仁效力最强，内壳次之，外壳则无效。巴豆的丙酮提取物对金鱼毒性很大，巴豆盐水浸出液可用于清除家鱼塘内的野鱼（放养家鱼之前），但效果不及生石灰。家兔静脉注射巴豆水剂可使胆汁及胰液分泌增加，对有输尿管痿的兔并无利尿作用，对离体兔子宫有轻度抑制作用。巴豆油能使大鼠与皮肤局部释放组织胺及引起肾上腺皮质激素分泌增加，巴豆毒蛋白能抑制蛋白质的合成。"}]},{"ID":"20240613124907-ckvvh5a","Type":"NodeParagraph","Properties":{"id":"20240613124907-ckvvh5a","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613124907-k57exti","Type":"NodeParagraph","Properties":{"id":"20240613124907-k57exti","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 巴豆仁：拣净杂质，用粘稠的米汤或面汤浸拌，置日光下曝晒或烘裂，搓去皮，簸取净仁。巴豆霜：取净巴豆仁，碾碎，用多层吸油纸包裹，加热微炕，压榨去油，每隔2天取出复研和换纸1次，如上法压榨六、七次至油尽为度，取出，碾细，过筛。将巴豆敲碎，每两巴豆以麻油并酒等各七合煮，研膏后用。"}]},{"ID":"20240613124907-8myl4dq","Type":"NodeParagraph","Properties":{"id":"20240613124907-8myl4dq","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613124907-dkwy23j","Type":"NodeParagraph","Properties":{"id":"20240613124907-dkwy23j","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末0.5g，研碎，加乙醚10ml，浸泡2h并时时振摇，滤过。滤液量试管中挥干后，加盐酸羟胺的甲醇饱和溶液0.5ml及香草酚酞指示液1滴，再加氢氧化钾饱和的甲醇溶液至显蓝色后，再多加4滴，加热至沸腾，冷却，加稀盐酸调节pH至2-3，加三氯化铁试液3滴及氯仿1ml，振摇，下层溶液显紫红色。（检查脂类）"}]},{"ID":"20240613124907-pl4jdgp","Type":"NodeParagraph","Properties":{"id":"20240613124907-pl4jdgp","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613124907-9ky8wcn","Type":"NodeParagraph","Properties":{"id":"20240613124907-9ky8wcn","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 胃；肺；脾；肝；肾；大肠经"}]},{"ID":"20240613124907-89lpnue","Type":"NodeParagraph","Properties":{"id":"20240613124907-89lpnue","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613124907-ral5cz0","Type":"NodeParagraph","Properties":{"id":"20240613124907-ral5cz0","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 辛；热；大毒"}]},{"ID":"20240613124907-bc8i60b","Type":"NodeParagraph","Properties":{"id":"20240613124907-bc8i60b","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613124907-5fxvprw","Type":"NodeParagraph","Properties":{"id":"20240613124907-5fxvprw","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 无寒实积滞、孕妇及体弱者忌服。"}]},{"ID":"20240613124907-mjz2bdx","Type":"NodeParagraph","Properties":{"id":"20240613124907-mjz2bdx","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613124907-s1jj4m6","Type":"NodeParagraph","Properties":{"id":"20240613124907-s1jj4m6","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 泻下寒积；逐水退肿；祛痰利咽；蚀疮杀虫。主寒邪食积所致的胸腹胀满急痛；大便不通；泄泻痢疾；水肿腹大；痰饮喘满；喉风喉痹；痈疽；恶疮疥癣"}]},{"ID":"20240613124907-pycelpr","Type":"NodeParagraph","Properties":{"id":"20240613124907-pycelpr","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613124907-jm70h36","Type":"NodeParagraph","Properties":{"id":"20240613124907-jm70h36","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 内服：巴豆霜入丸、散，0.1-0.3g。外用：适量，捣膏涂；或以纱包擦患处。"}]},{"ID":"20240613124907-0e88ulm","Type":"NodeParagraph","Properties":{"id":"20240613124907-0e88ulm","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613124907-9wlmm1d","Type":"NodeParagraph","Properties":{"id":"20240613124907-9wlmm1d","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 三物备急丸《金匮要略》：心腹胀满；三物白散《伤寒论》：寒实结胸；水浸丹《局方》；九痛丸《金匮要略》：九种心痛；针头丸《世医得效方》：水泻不止；"}]},{"ID":"20240613124907-3oq4n3n","Type":"NodeParagraph","Properties":{"id":"20240613124907-3oq4n3n","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613124907-v444l6r","Type":"NodeParagraph","Properties":{"id":"20240613124907-v444l6r","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 1.《汤液本草》：巴豆，若急治为水谷道路之剂，去皮心膜油，生用；若缓治为消坚磨积之剂，炒去烟令紫黑，研用。可以通肠，可以止泄，世所不知也。"}]},{"ID":"20240613124907-xgre98e","Type":"NodeParagraph","Properties":{"id":"20240613124907-xgre98e","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：巴豆，生猛熟缓，能吐能下，能止能行，是可升可降药也。盖此物不去膜则伤胃，不去心则作呕，以沉香水浸则能升能降，与大黄同用泻人反缓，为其性相畏也。巴豆，峻用则有劫病之功，微用亦有调中之妙。王海藏言其可以通肠，可以止泻，此发千古之秘也。一老妇年六十余，病溏泄已五年，肉食油物生冷，犯之即作痛，服调脾、升提、止涩诸药，入腹则泄反甚。延余诊之，脉沉而滑，此乃脾胃久伤，冷积凝滞所致。王太仆所谓大寒凝内，久利溏泄，愈而复发，绵历年岁者，法当以热下之，则寒去利止。遂用蜡匮巴豆丸药五十丸与服，二日大便不通，亦不利，其泄遂愈。自是每用治泄痢积滞诸病，皆不泻而病愈者近百人，妙在配合得宜，药病相对耳。苟用所不当用，则犯轻用损阴之戒矣。"}]},{"ID":"20240613124907-3fhqfgz","Type":"NodeParagraph","Properties":{"id":"20240613124907-3fhqfgz","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：巴豆，推荡脏腑，开通闭塞之药也。左氏曰，此剂味甚辛敛，气甚热烈，性甚刚猛，攻关拔固，功过牵、黄，摧滞逐实，力浮硝、戟，追逐一切有形留着、久顽不逊之疾，如留饮痰癖、死血败脓、休息结痢、寒痰哮喘，及一切生冷、鱼、面、油腻、水果、积聚、虫积，或水肿大腹、寒疝、死胎、痞结、症瘕诸证，下咽即行。苟非气壮力强之人，不可轻用。张氏曰，如不审而妄用，耗却天真，使人津液枯竭，胸热口燥，留毒不去，他病转生，则巴豆之危害昭昭矣，然而更有未尽者，此药禀火烈之气，沾人肌肉，无不灼烂，试以少许轻擦完好之肤，须臾即发一泡，必至肿烂成疮，况肠胃柔脆之质，下咽则徐徐而走，且无论下后耗损天真，而府脏被其熏灼，能免无溃烂之患耶？凡一概汤、散、丸剂，切勿轻投，即有万不得已之急证，欲借其辛烈攻冲，开通道路之力，必须煮熟，压令油净，入厘许即止，不得多用。"}]},{"ID":"20240613124907-vymcmub","Type":"NodeParagraph","Properties":{"id":"20240613124907-vymcmub","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"4.《本草通玄》：巴豆，禀阳刚雄猛之性，有斩关夺门之功，气血未衰，积邪坚固者，诚有神功，老羸衰弱之人，轻妄投之，祸不旋踵。巴豆、大黄，同为攻下之剂，但大黄性冷，腑病多热者宜之；巴豆性热，脏病多寒者宜之。故仲景治伤寒传里恶热者，多用大黄，东垣治五积属脏者，多用巴豆，世俗未明此义，往往以大黄为王道之药，以巴豆为劫霸之剂，不亦谬乎？5.《本经逢原》：巴豆，能荡练五脏六腑，不特破症瘕结聚之坚积，并可治伤寒湿疟之寒热，如仲景之治寒实结胸用白散，深得《本经》之旨。世本作温疟，当是湿疟，亥豕之谬也。其性峻利，有破血排脓、攻痰逐水之力，宜随证轻重而施，生用则峻攻，熟用则温利，去油用霜，则推陈致新，随证之缓急，而施反正之治。"}]},{"ID":"20240613124907-1muuzty","Type":"NodeParagraph","Properties":{"id":"20240613124907-1muuzty","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"6.《本经》：主伤寒温疟寒热，破症瘕结聚坚积，留饮痰癖，大腹水肿。荡练五脏六腑，开通闭塞，利水谷道。去恶肉。"}]},{"ID":"20240613124907-77fqojh","Type":"NodeParagraph","Properties":{"id":"20240613124907-77fqojh","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"7.《别录》：疗女子月闭，烂胎，金疮脓血不利，丈夫阴tui，杀斑螫毒。"}]},{"ID":"20240613124907-so22y7b","Type":"NodeParagraph","Properties":{"id":"20240613124907-so22y7b","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：主破心腹积聚结气，治十种水肿，痿痹，大腹。"}]},{"ID":"20240613124907-qqdvchy","Type":"NodeParagraph","Properties":{"id":"20240613124907-qqdvchy","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"9.《本草拾遗》：主症癖，痃气，痞满，腹内积聚，冷气血块，宿食不消，痰饮吐水。"}]},{"ID":"20240613124907-f0sji8e","Type":"NodeParagraph","Properties":{"id":"20240613124907-f0sji8e","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"10.《日华子本草》：通宣一切病，泄壅滞，除风补劳，健脾开胃，消痰破血，排脓消肿毒，杀腹藏虫。治恶疮息肉及疥癞疔肿。"}]},{"ID":"20240613124907-iluzisw","Type":"NodeParagraph","Properties":{"id":"20240613124907-iluzisw","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"11.《医学启源》：导气消积，去脏腑停寒，消化寒凉及生冷硬物所伤，去胃中寒湿。"}]},{"ID":"20240613124907-wm1739l","Type":"NodeParagraph","Properties":{"id":"20240613124907-wm1739l","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"12.《汤液本草》：可以通肠，可以止泄。"}]},{"ID":"20240613124907-7tpuicj","Type":"NodeParagraph","Properties":{"id":"20240613124907-7tpuicj","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"13.《纲目》：治泻痢，惊痫，心腹痛，疝气，风wai，耳聋，喉痹，牙痛，通利关窍。"}]},{"ID":"20240613124907-32pjut1","Type":"NodeParagraph","Properties":{"id":"20240613124907-32pjut1","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613124907-73xqh3p","Type":"NodeParagraph","Properties":{"id":"20240613124907-73xqh3p","updated":"20240613124907"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613124908-xqjrj7b","Type":"NodeThematicBreak","Properties":{"id":"20240613124908-xqjrj7b"}},{"ID":"20240613124909-erpdmxn","Type":"NodeParagraph","Properties":{"id":"20240613124909-erpdmxn"}}]}