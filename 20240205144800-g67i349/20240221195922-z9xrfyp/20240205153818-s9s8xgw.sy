:"width: 1231px;","style":"width: 1221px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫草 9-20240815103603-s12lfiq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1221px;\" parent-style=\"width: 1231px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240815103653-rait3xf","Type":"NodeParagraph","Properties":{"id":"20240815103653-rait3xf","updated":"20240815103701"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图未按品种分类；"}]},{"ID":"20240611154818-4s3yu1x","Type":"NodeThematicBreak","Properties":{"id":"20240611154818-4s3yu1x"}},{"ID":"20240611154839-6wnjxv0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154839-6wnjxv0","updated":"20240611154843"},"Children":[{"Type":"NodeText","Data":"紫草《神农本草经》"}]},{"ID":"20240611154839-84rjjd3","Type":"NodeParagraph","Properties":{"id":"20240611154839-84rjjd3","updated":"20240611154839"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240611154839-249ebte","Type":"NodeParagraph","Properties":{"id":"20240611154839-249ebte","updated":"20240611154839"},"Children":[{"Type":"NodeText","Data":"主心腹邪气五疸，补中益气，利九窍，通水道。一名紫丹，一名紫芙（《御览》引云：一名地血，《大观本》，无文）。生山谷。"}]},{"ID":"20240611154839-i5f2j3v","Type":"NodeParagraph","Properties":{"id":"20240611154839-i5f2j3v","updated":"20240611154839"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：紫草节赤，二月花。（《御览》）"}]},{"ID":"20240611154839-29awdn0","Type":"NodeParagraph","Properties":{"id":"20240611154839-29awdn0","updated":"20240611154839"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生砀山及楚地，三月采根，阴干。"}]},{"ID":"20240611154839-9l18lea","Type":"NodeParagraph","Properties":{"id":"20240611154839-9l18lea","updated":"20240611154839"},"Children":[{"Type":"NodeText","Data":"案《说文》云：茈，草也，藐，茈草也，草也，可以染留黄。《广雅》云：茈，草也。《山海经》云：劳山多茈草。郭璞云：一名紫，中染紫也。《尔雅》云：藐，茈草。郭璞云：可以染紫。"}]},{"ID":"20240611154902-0rgbe9h","Type":"NodeThematicBreak","Properties":{"id":"20240611154902-0rgbe9h"}},{"ID":"20240611154903-xxwiojg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154903-xxwiojg","updated":"20240611154907"},"Children":[{"Type":"NodeText","Data":"紫草《本草从新》"}]},{"ID":"20240611154903-gauitwk","Type":"NodeParagraph","Properties":{"id":"20240611154903-gauitwk","updated":"20240611154903"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻血热、滑肠．"}]},{"ID":"20240611154903-xmbuo3x","Type":"NodeParagraph","Properties":{"id":"20240611154903-xmbuo3x","updated":"20240611154903"},"Children":[{"Type":"NodeText","Data":"甘咸气寒．入厥阴血分．（心包、肝．）凉血活血．利九窍．通二便．（咸寒性滑．）治心腹邪气．（即热也．）及痘疮血热毒盛．二便闭涩者．（血热则毒闭、得紫草凉之、则血行而毒出、曾世荣活幼心书云∶紫草性寒、小儿脾实者可用、脾虚者能作泻、古方惟用茸、取其初得阳气、以类触类、用发痘疮、今人不达此理、一概用之、误矣．）便滑者勿用．去头须．酒洗．"}]},{"ID":"20240611155005-q2vibr2","Type":"NodeThematicBreak","Properties":{"id":"20240611155005-q2vibr2"}},{"ID":"20240611155006-97uvz72","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155006-97uvz72","updated":"20240611155010"},"Children":[{"Type":"NodeText","Data":"紫草《神农本草经赞》"}]},{"ID":"20240611155006-nvc2akx","Type":"NodeParagraph","Properties":{"id":"20240611155006-nvc2akx","updated":"20240611155006"},"Children":[{"Type":"NodeText","Data":"味苦寒。主心腹邪气。五疸。补中益气。利九窍。通水道。一名紫丹。一名紫芙。生山谷。"}]},{"ID":"20240611155006-c9v7rkr","Type":"NodeParagraph","Properties":{"id":"20240611155006-c9v7rkr","updated":"20240611155006"},"Children":[{"Type":"NodeText","Data":"黄白青沙。紫根密拥。利野兴锄。春耕分垄。色耀花前。坚凭石重。几见雅衔。兰香嘉种。"}]},{"ID":"20240611155006-o3zwqiw","Type":"NodeParagraph","Properties":{"id":"20240611155006-o3zwqiw","updated":"20240611155006"},"Children":[{"Type":"NodeText","Data":"群芳谱。紫草宜黄白软良之地。及青沙地。秋耕深细。至春又转耕之。逐垄下子。李时珍曰。此草花紫根紫。未花时采根。色鲜明。以石压扁曝干。呼为雅衔草。苏恭曰。苗似兰香。"}]},{"ID":"20240611154947-a5q89ne","Type":"NodeThematicBreak","Properties":{"id":"20240611154947-a5q89ne"}},{"ID":"20240611154948-pjd4izk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154948-pjd4izk","updated":"20240611154952"},"Children":[{"Type":"NodeText","Data":"紫草《本草求真》"}]},{"ID":"20240611154948-qbehrhb","Type":"NodeParagraph","Properties":{"id":"20240611154948-qbehrhb","updated":"20240611154948"},"Children":[{"Type":"NodeText","Data":"（山草）入心包肝解毒"}]},{"ID":"20240611154948-x0kdjn1","Type":"NodeParagraph","Properties":{"id":"20240611154948-x0kdjn1","updated":"20240611154948"},"Children":[{"Type":"NodeText","Data":"紫草（专入心包肝）。甘咸气寒。色紫质滑。专入厥阴血分。血凉则九窍通。二便利。故凡血热毒闭。而见心腹急痛。水肿不消。五疸 癣恶疮。及痘疮血热毒盛。二便闭涩者。治当用此。俾血得寒而凉。得咸而降。得滑而通。得紫而入。血凉毒消。而二便因以解矣！（活幼书云。紫草性寒。小儿脾实者可用。脾虚者反能作泻。）奈世误以为宣发之药。不论毒闭与否辄用。殊失用药意义矣！泻者忌服。茸得阳气之早。用宜取茸为正。酒洗用。（紫草去头须。本经云。能补中益气。似非。）"}]},{"ID":"20240611154932-0r9y1g5","Type":"NodeThematicBreak","Properties":{"id":"20240611154932-0r9y1g5"}},{"ID":"20240611154933-7h4499n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154933-7h4499n","updated":"20240611154938"},"Children":[{"Type":"NodeText","Data":"紫草《本经逢原》"}]},{"ID":"20240611154933-8hv0qn5","Type":"NodeParagraph","Properties":{"id":"20240611154933-8hv0qn5","updated":"20240611154933"},"Children":[{"Type":"NodeText","Data":"甘咸寒，无毒。色深紫而脆者良。淡紫质坚者曰紫梗，不入药。"}]},{"ID":"20240611154933-lo4ec5c","Type":"NodeParagraph","Properties":{"id":"20240611154933-lo4ec5c","updated":"20240611154933"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹邪气，五疳，补中益气，利九窍。"}]},{"ID":"20240611154933-3qjumbh","Type":"NodeParagraph","Properties":{"id":"20240611154933-3qjumbh","updated":"20240611154933"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"紫草入心包络及肝经血分，其功专于凉血活血，利大小肠，故痘疹欲出未出，血热毒盛，大便闭涩，色干枯，而毒不得越者宜之。已出而紫黑便闭者亦可用。盖紫草凉血，血凉则毒出。世俗误以为宣发之药，非也。若已出而色红活者不宜，或白陷，及大小便利者忌之。《本经》言，治心腹邪气五瘅者，乃活血利窍之义。发痘即活血利窍之大端也。言补中益气者，营血和，则中气受益矣。"}]},{"ID":"20240611154913-9mccdgi","Type":"NodeThematicBreak","Properties":{"id":"20240611154913-9mccdgi"}},{"ID":"20240611154914-hi8bih1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154914-hi8bih1","updated":"20240611154927"},"Children":[{"Type":"NodeText","Data":"紫草《本草便读》"}]},{"ID":"20240611154914-6spbjv1","Type":"NodeParagraph","Properties":{"id":"20240611154914-6spbjv1","updated":"20240611154914"},"Children":[{"Type":"NodeText","Data":"透肌凉血．甘寒咸滑相兼．宣窍通肠．包络肝经并入．若或痘疮热结．清心下导于二肠．即使毒滞瘀凝．解里外松夫肌表．（紫草味甘咸而寒．入手足厥阴血分．凉血活血．通水道．利大肠．性极寒滑．故痘疹不出．由于血热便闭者．宜之．阳虚便溏者．不可浪投．紫草三月下子．九月子熟．有藤色紫取苗用．即紫草茸也．故又能松肌解表．）"}]},{"ID":"20240611154848-qnuyg3o","Type":"NodeThematicBreak","Properties":{"id":"20240611154848-qnuyg3o"}},{"ID":"20240611154849-oxadf3x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154849-oxadf3x","updated":"20240611154853"},"Children":[{"Type":"NodeText","Data":"紫草《神农本草经百种录》"}]},{"ID":"20240611154849-syz5qv7","Type":"NodeParagraph","Properties":{"id":"20240611154849-syz5qv7","updated":"20240611154849"},"Children":[{"Type":"NodeText","Data":"味苦寒。主心腹邪气，去心腹热邪。五疸，湿热在血中。补中益气，荣家之热清，则中焦和利。利九窍，诸窍不为邪热所闭。通水道。心气通于小肠。"}]},{"ID":"20240611154849-et0dqrt","Type":"NodeParagraph","Properties":{"id":"20240611154849-et0dqrt","updated":"20240611154849"},"Children":[{"Type":"NodeText","Data":"紫草色紫而走心，心主血，又其性寒，故能治血家之热。"}]},{"ID":"20240611154819-tbz2qhv","Type":"NodeThematicBreak","Properties":{"id":"20240611154819-tbz2qhv"}},{"ID":"20240611154830-kw1g3cp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154830-kw1g3cp","updated":"20240611154834"},"Children":[{"Type":"NodeText","Data":"紫草《得配本草》"}]},{"ID":"20240611154830-nc5okuw","Type":"NodeParagraph","Properties":{"id":"20240611154830-nc5okuw","updated":"20240611154830"},"Children":[{"Type":"NodeText","Data":"苦，寒。入手足厥阴经血分。主血中郁热，去心腹邪气。利二便，解黄胆，消肿胀，托痘疹，化紫斑，利九窍，通脉络，达皮毛。配木香，治痘毒血热。配栝蒌仁，治痈疽便秘。配蓝叶、黄连、木香，治火黄身热。（身有赤黑点者不可治。）去根髭，取嫩茸，以甘草水浸炒用。"}]},{"ID":"20240611154830-qkad09s","Type":"NodeParagraph","Properties":{"id":"20240611154830-qkad09s","updated":"20240611154830"},"Children":[{"Type":"NodeText","Data":"血热者生用。脾虚者酒净焙，或同糯米炒用。脾气虚、便滑者，禁用。"}]},{"ID":"20240611154819-pg1x2ms","Type":"NodeThematicBreak","Properties":{"id":"20240611154819-pg1x2ms"}},{"ID":"20240611154820-rmbd94f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154820-rmbd94f","updated":"20240611154825"},"Children":[{"Type":"NodeText","Data":"紫草《本草纲目》"}]},{"ID":"20240611154820-l2r0c0h","Type":"NodeParagraph","Properties":{"id":"20240611154820-l2r0c0h","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"「释名」紫丹、紫夭、此戾、藐、地血、鸦衔草。"}]},{"ID":"20240611154820-ktmqk86","Type":"NodeParagraph","Properties":{"id":"20240611154820-ktmqk86","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240611154820-lfzdwrb","Type":"NodeParagraph","Properties":{"id":"20240611154820-lfzdwrb","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611154820-dfqdkkd","Type":"NodeParagraph","Properties":{"id":"20240611154820-dfqdkkd","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"1、婴童疹痘（将出未出、色赤便闭者可用本方，如痘已出而红活、大便利者则忌用）。用紫草二两，锉碎，泡在百沸汤一碗中，盖严勿使漏气。汤温后，服半合。改用煎服亦可。"}]},{"ID":"20240611154820-9ulzam6","Type":"NodeParagraph","Properties":{"id":"20240611154820-9ulzam6","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"2、痈疽便闭。用紫草、栝楼子等分，水煎服。"}]},{"ID":"20240611154820-553nk5n","Type":"NodeParagraph","Properties":{"id":"20240611154820-553nk5n","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"3、小便淋。用紫草一两，用成散剂，每服二钱，饭前服。井华水送下。"}]},{"ID":"20240611154820-ersu4hj","Type":"NodeParagraph","Properties":{"id":"20240611154820-ersu4hj","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"4、产后淋沥不净。治法同上。"}]},{"ID":"20240611154820-qkilbra","Type":"NodeParagraph","Properties":{"id":"20240611154820-qkilbra","updated":"20240611154820"},"Children":[{"Type":"NodeText","Data":"5、恶虫咬伤。用紫草煎油涂搽。"}]},{"ID":"20240611154740-hze3wrx","Type":"NodeThematicBreak","Properties":{"id":"20240611154740-hze3wrx"}},{"ID":"20240611154752-tmog4hh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154752-tmog4hh","updated":"20240611154805"},"Children":[{"Type":"NodeText","Data":"紫草《药鉴》"}]},{"ID":"20240611154752-cl283id","Type":"NodeParagraph","Properties":{"id":"20240611154752-cl283id","updated":"20240611154752"},"Children":[{"Type":"NodeText","Data":"气寒，味苦，无毒。其色紫，故能行血。其味苦，故能通窍利水。其气寒，故能治肿毒痈疽。与大力子同用，善快痘疮未发。与淫羊藿同用，能起痘疮已快。攻血泡，佐以红花。"}]},{"ID":"20240611154752-vx4o47y","Type":"NodeParagraph","Properties":{"id":"20240611154752-vx4o47y","updated":"20240611154752"},"Children":[{"Type":"NodeText","Data":"消水泡，并以茯苓。同川芎赤芍入青葙子，能医眼目之赤障。用翘连荆防兼皂荚刺，善消痈疽之红肿。大都血家药也，无问麻痘症，无论痈疽病，无问男女杂症，但见血紫血热，及热毒深者，俱宜用之。但泻痢则忌。糯米监制无妨。"}]},{"ID":"20240611154740-uotpooi","Type":"NodeThematicBreak","Properties":{"id":"20240611154740-uotpooi"}},{"ID":"20240611154741-3iaex17","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154741-3iaex17","updated":"20240611154747"},"Children":[{"Type":"NodeText","Data":"紫草《证类本草》"}]},{"ID":"20240611154741-7wxehd3","Type":"NodeParagraph","Properties":{"id":"20240611154741-7wxehd3","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主心腹邪气，五疸，补中益气，利九窍，通水道，疗腹肿胀满痛。"}]},{"ID":"20240611154741-vlf31xr","Type":"NodeParagraph","Properties":{"id":"20240611154741-vlf31xr","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"以合膏，疗小儿疮及面 （侧加切）。一名紫丹，一名紫 （衰老反）。生砀山山谷及楚地。"}]},{"ID":"20240611154741-kmh7qh7","Type":"NodeParagraph","Properties":{"id":"20240611154741-kmh7qh7","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"三月采根，阴干。陶隐居云∶今出襄阳，多从南阳、新野来。彼人种之，即是今染紫者，方药家都不复用。《博物志》云∶平氏阳山紫草特好。魏国以染色，殊黑。比年东山亦种，色小浅于北者。唐本注云∶紫草，所在皆有。《尔雅》云∶一名藐。苗似兰香，茎赤节青，花紫白色，而实白。臣禹锡等谨按广雅云∶紫草，一名茈 。药性论云∶紫草亦可单用。味甘，平。能治恶疮 癣。"}]},{"ID":"20240611154741-0stwv0m","Type":"NodeParagraph","Properties":{"id":"20240611154741-0stwv0m","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"图经曰∶紫草，生砀山山谷及楚地，今处处有之，人家园圃中或种莳，其根所以染紫也。"}]},{"ID":"20240611154741-7uzwbzy","Type":"NodeParagraph","Properties":{"id":"20240611154741-7uzwbzy","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"《尔雅》谓之藐，《广雅》谓之茈 。苗似兰香，茎赤节青。二月有花，紫白色，秋实白，三月采根，阴干。古方稀见使。今医家多用治伤寒时疾，发疮疹不出者，以此作药，使其发出。"}]},{"ID":"20240611154741-2h682x6","Type":"NodeParagraph","Properties":{"id":"20240611154741-2h682x6","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"韦宙《独行方》∶治豌豆疮，煮紫草汤饮。后人相承用之，其效尤速。"}]},{"ID":"20240611154741-yt6tw2e","Type":"NodeParagraph","Properties":{"id":"20240611154741-yt6tw2e","updated":"20240611154741"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，须用蜡水蒸之，待水干，取去头并两畔髭，细锉用。每修事紫草一斤，用蜡三两，于铛中熔，熔尽，便投蜡水作汤用。圣惠方∶治恶虫咬人，用紫草油涂之。又方∶治卒小便淋沥痛。用紫草一两，捣罗为散，每于食前，以井花水调下二钱匕。《产宝》治淋涩。《产后》同。经验后方∶治婴儿童子患疹豆疾。用紫草二两细锉，以百沸汤一大盏泡，便以物合定，勿令气漏，放如人体温，量儿大小，服半合至一合，服此疮虽出，亦当轻减。"}]},{"ID":"20240611154554-ezrnsva","Type":"NodeThematicBreak","Properties":{"id":"20240611154554-ezrnsva"}},{"ID":"20240611154717-lfe2yh0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154717-lfe2yh0","updated":"20240611154723"},"Children":[{"Type":"NodeText","Data":"紫草《本草崇原》"}]},{"ID":"20240611154717-4cod50u","Type":"NodeParagraph","Properties":{"id":"20240611154717-4cod50u","updated":"20240611154717"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治心腹邪气，五疳，补中，益气，利九窍。"}]},{"ID":"20240611154717-hsmnpgv","Type":"NodeParagraph","Properties":{"id":"20240611154717-hsmnpgv","updated":"20240611154717"},"Children":[{"Type":"NodeText","Data":"（紫草出砀山山谷及襄阳、南阳、新野所在皆有，人家或种之。苗似兰香，赤茎青节，二月开花紫白色，结实白色，春祉前后采根阴干，其根头有白毛如茸，根身紫色，可以染紫。）"}]},{"ID":"20240611154717-r9d57of","Type":"NodeParagraph","Properties":{"id":"20240611154717-r9d57of","updated":"20240611154717"},"Children":[{"Type":"NodeText","Data":"紫乃苍赤之间色，紫草色紫，得火气也。苗似兰香，得土气也。火土相生，能资中焦之精汁，而调和其上下，故气味苦寒，主治心腹之邪气。疳者，干也，津液干枯也。五疳者，惊疳、食疳、气疳、筋疳、骨疳也。紫草禀火土之气，滋益三焦，故治小儿之五疳。补中者，补中土也。益气者，益三焦之气也。九窍为水注之气，补中土而益三焦，则如雾如沤如渎，水气环复，故利九窍。"}]},{"ID":"20240611154554-urrnm43","Type":"NodeThematicBreak","Properties":{"id":"20240611154554-urrnm43"}},{"ID":"20240611154659-543b0rj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154659-543b0rj","updated":"20240611154709"},"Children":[{"Type":"NodeText","Data":"紫草《玉楸药解》"}]},{"ID":"20240611154659-t1p5475","Type":"NodeParagraph","Properties":{"id":"20240611154659-t1p5475","updated":"20240611154659"},"Children":[{"Type":"NodeText","Data":"味苦，气寒，入足厥阴肝经。清肝凉血，泻火伐阳。"}]},{"ID":"20240611154659-5z8swu7","Type":"NodeParagraph","Properties":{"id":"20240611154659-5z8swu7","updated":"20240611154659"},"Children":[{"Type":"NodeText","Data":"紫草疏利，凉血活瘀，寒胃滑肠。痘色红紫之证，缘营闭卫虚，不能外达。庸工以为血瘀，用紫草治之，百治百死。今古不悟，可恶！"}]},{"ID":"20240611154554-d9h5mh2","Type":"NodeThematicBreak","Properties":{"id":"20240611154554-d9h5mh2"}},{"ID":"20240611154555-xyip4u7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154555-xyip4u7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"《中国药典》：紫草"}]},{"ID":"20240611154555-o534vml","Type":"NodeParagraph","Properties":{"id":"20240611154555-o534vml","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611154555-ekxp683","Type":"NodeParagraph","Properties":{"id":"20240611154555-ekxp683","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" Zǐ Cǎo"}]},{"ID":"20240611154555-mdvz7ti","Type":"NodeParagraph","Properties":{"id":"20240611154555-mdvz7ti","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611154555-zz54hv8","Type":"NodeParagraph","Properties":{"id":"20240611154555-zz54hv8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 硬紫草、软紫草"}]},{"ID":"20240611154555-40mzjxm","Type":"NodeParagraph","Properties":{"id":"20240611154555-40mzjxm","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611154555-asmwa0a","Type":"NodeParagraph","Properties":{"id":"20240611154555-asmwa0a","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" RADIX ARNEBIAE/RADIX LITHOSPERMI"}]},{"ID":"20240611154555-ust31yk","Type":"NodeParagraph","Properties":{"id":"20240611154555-ust31yk","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611154555-cpi1syv","Type":"NodeParagraph","Properties":{"id":"20240611154555-cpi1syv","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 本品为紫草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"新疆紫草"},{"Type":"NodeText","Data":"Arnebia euchroma （Royle）Johnst. 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫草"},{"Type":"NodeText","Data":"Lithospermum erythrorhizon Sieb. et Zucc. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内蒙紫草"},{"Type":"NodeText","Data":"Arnebia guttata Bunge 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去泥沙，干燥。"}]},{"ID":"20240611154555-gih2lwp","Type":"NodeParagraph","Properties":{"id":"20240611154555-gih2lwp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611154555-vrtmezl","Type":"NodeParagraph","Properties":{"id":"20240611154555-vrtmezl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 新疆紫草（软紫草）：呈不规则的长圆柱形，多扭曲，长7～20cm，直径1～2.5cm。表面紫红色或紫褐色，皮部疏松，呈条形片状，常10余层重叠，易剥落。顶端有的可见分歧的茎残基。体轻，质松软，易折断，断面不整齐，木部较小，黄白色或黄色。气特异，味微苦、涩。"}]},{"ID":"20240611154555-4408shb","Type":"NodeParagraph","Properties":{"id":"20240611154555-4408shb","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草（硬紫草）：呈圆锥形，扭曲，有分枝，长7～14cm,直径1～2cm。表面紫红色或紫黑色，粗糙有纵纹，皮部薄，易剥落。质硬而脆，易折断，断面皮部深紫色，木部较大，灰黄色。"}]},{"ID":"20240611154555-zb3l2uw","Type":"NodeParagraph","Properties":{"id":"20240611154555-zb3l2uw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"内蒙紫草：呈圆锥形或圆柱形，扭曲，长6～20cm，直径0.5～4cm。根头部略粗大，顶端有残茎1或多个，被短硬毛。表面紫红色或暗紫色，皮部略薄，常数层相叠，易剥离。质硬而脆，易折断，断面较整齐，皮部紫红色，木部较小，黄白色。气特异，味涩。"}]},{"ID":"20240611154555-fd56fuu","Type":"NodeParagraph","Properties":{"id":"20240611154555-fd56fuu","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611154555-yvcrert","Type":"NodeParagraph","Properties":{"id":"20240611154555-yvcrert","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240611154555-etysuq4","Type":"NodeParagraph","Properties":{"id":"20240611154555-etysuq4","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611154555-jkt3dtm","Type":"NodeParagraph","Properties":{"id":"20240611154555-jkt3dtm","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"新疆紫草"},{"Type":"NodeText","Data":"：除去杂质，切厚片或段；紫草、内蒙紫草除去杂质，洗净，润透，切薄片，干燥。"}]},{"ID":"20240611154555-unyjk5i","Type":"NodeParagraph","Properties":{"id":"20240611154555-unyjk5i","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"新疆紫草切片（软紫草）为不规则的圆柱形切片或条形片状，直径1～2.5cm。紫红色或紫褐色。皮部深紫色。圆柱形切片，木部较小，黄白色或黄色。"}]},{"ID":"20240611154555-zz7va7m","Type":"NodeParagraph","Properties":{"id":"20240611154555-zz7va7m","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草切片（硬紫草）为不规则的圆柱形切片，直径1～2cm。紫红色或紫黑色。皮部深紫色。质硬，木部较大，灰黄色。"}]},{"ID":"20240611154555-81wsw3h","Type":"NodeParagraph","Properties":{"id":"20240611154555-81wsw3h","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"照上述[含量测定]项下的方法测定，本品含羟基萘醌总色素以左旋紫草素（C16H16O5）计，不得少于0.90％。"}]},{"ID":"20240611154555-kekt86j","Type":"NodeParagraph","Properties":{"id":"20240611154555-kekt86j","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611154555-ln2kcdm","Type":"NodeParagraph","Properties":{"id":"20240611154555-ln2kcdm","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" （1）取本品粉末0.5g，置试管中，将试管底部加热，生成红色气体，并于试管壁凝结成红褐色油滴。"}]},{"ID":"20240611154555-srzoip0","Type":"NodeParagraph","Properties":{"id":"20240611154555-srzoip0","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.5g，加乙醇5ml ，浸渍1 小时，滤过，残渣用乙醇2ml 洗涤，洗涤液加入滤液中，浓缩至约1ml ，作为供试品溶液。另取左旋紫草素对照品，加乙醇制成每1ml 含0.5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各4μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以甲苯－醋酸乙酯－甲酸（5:1:0.1）为展开剂，展开，取出，晾干。供试品色谱中，在与对照品色谱相应的位置上，显相同的紫红色斑点；再喷以10％氢氧化钾甲醇溶液，斑点变为蓝色。"}]},{"ID":"20240611154555-dpko76o","Type":"NodeParagraph","Properties":{"id":"20240611154555-dpko76o","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240611154555-s4q3ifl","Type":"NodeParagraph","Properties":{"id":"20240611154555-s4q3ifl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 取本品适量，于50℃干燥3 小时，粉碎（过三号筛）精密称取约0.5g，置100ml 量瓶中，加乙醇至刻度，4 小时内时时振摇，滤过，精密量取续滤液5ml， 置25ml量瓶中，加乙醇至刻度，摇匀。照分光亮度法（附录Ⅴ B），在516nm 的波长处测定吸收度，按左旋紫草素（C16H16O5）的吸收系数（Ｅ1％ 1cm）为242 计算，即得。"}]},{"ID":"20240611154555-ip8erme","Type":"NodeParagraph","Properties":{"id":"20240611154555-ip8erme","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"本品含羟基萘醌总色素以左旋紫草素（Ｃ16Ｈ16Ｏ5 ）计，不得少于0.80％。"}]},{"ID":"20240611154555-e0ksujv","Type":"NodeParagraph","Properties":{"id":"20240611154555-e0ksujv","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611154555-sdvy05l","Type":"NodeParagraph","Properties":{"id":"20240611154555-sdvy05l","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 归心、肝经。"}]},{"ID":"20240611154555-9u2glx3","Type":"NodeParagraph","Properties":{"id":"20240611154555-9u2glx3","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611154555-ekmq6bp","Type":"NodeParagraph","Properties":{"id":"20240611154555-ekmq6bp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 甘、咸，寒。"}]},{"ID":"20240611154555-oxa7ls1","Type":"NodeParagraph","Properties":{"id":"20240611154555-oxa7ls1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611154555-bwt8ryu","Type":"NodeParagraph","Properties":{"id":"20240611154555-bwt8ryu","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 凉血，活血，解毒透疹。用于血热毒盛，斑疹紫黑，麻疹不透，疮疡，湿疹，水火烫伤。"}]},{"ID":"20240611154555-o02c7tj","Type":"NodeParagraph","Properties":{"id":"20240611154555-o02c7tj","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611154555-tjiz974","Type":"NodeParagraph","Properties":{"id":"20240611154555-tjiz974","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 5～9g。外用适量，熬膏或用植物油浸泡涂擦。"}]},{"ID":"20240611154555-7dsradw","Type":"NodeParagraph","Properties":{"id":"20240611154555-7dsradw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611154555-zsz8csp","Type":"NodeParagraph","Properties":{"id":"20240611154555-zsz8csp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" （1）本品性寒，有清热凉血、解毒、透疹之功，故对血热毒盛，麻疹、斑疹透发不畅等症，可与蝉衣、牛蒡子、连翘、荆芥等配伍应用；如疹出而色甚深，呈紫暗色而不红活者，这也是血热毒盛的症候，须以凉血解毒药如丹皮、赤芍、银花、连窍等同用。此外，试用本品预防麻疹，可减轻麻疹症状或减少麻疹发病率。"}]},{"ID":"20240611154555-ojxqmm9","Type":"NodeParagraph","Properties":{"id":"20240611154555-ojxqmm9","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611154555-llenncs","Type":"NodeParagraph","Properties":{"id":"20240611154555-llenncs","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611154555-lgoo33d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154555-lgoo33d","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：紫草"}]},{"ID":"20240611154555-byeo0db","Type":"NodeParagraph","Properties":{"id":"20240611154555-byeo0db","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611154555-qjbm1ez","Type":"NodeParagraph","Properties":{"id":"20240611154555-qjbm1ez","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" Zǐ Cǎo"}]},{"ID":"20240611154555-kb70es1","Type":"NodeParagraph","Properties":{"id":"20240611154555-kb70es1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611154555-v98myl0","Type":"NodeParagraph","Properties":{"id":"20240611154555-v98myl0","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 藐、茈草（《尔雅》），紫丹、紫苭（《本经》），地血（《吴普本草》），茈蔰（《广雅》），紫草茸（《小儿药证直诀》），鸦衔草（《纲目》），紫草根（《现代实用中药》），山紫草（《江苏植药志》），红石根（《辽宁经济植物志》）。"}]},{"ID":"20240611154555-ma4bwvr","Type":"NodeParagraph","Properties":{"id":"20240611154555-ma4bwvr","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611154555-oshc2aa","Type":"NodeParagraph","Properties":{"id":"20240611154555-oshc2aa","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611154555-dy7dt8f","Type":"NodeParagraph","Properties":{"id":"20240611154555-dy7dt8f","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611154555-xj38x42","Type":"NodeParagraph","Properties":{"id":"20240611154555-xj38x42","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 为紫草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫草、新藏假紫草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滇紫草"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。4～5月或9～10月间挖根，除去残茎及泥土（勿用水洗，以防退色），晒干或微火烘干。"}]},{"ID":"20240611154555-bn7tszg","Type":"NodeParagraph","Properties":{"id":"20240611154555-bn7tszg","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611154555-ctuzhhg","Type":"NodeParagraph","Properties":{"id":"20240611154555-ctuzhhg","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①紫草"}]},{"ID":"20240611154555-4jo8j33","Type":"NodeParagraph","Properties":{"id":"20240611154555-4jo8j33","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"多年生草本，高达90厘米。根直立，圆柱形，略弯曲，常分歧，外皮暗红紫色。茎直立，单一或上部分歧，全株被粗硬毛。叶互生，无柄；叶片长圆状披针形，长约6厘米，宽约1.3厘米，先端尖，基部楔形，全缘，两面被糙伏毛。聚伞花序总状，顶生；花两性；苞片叶状，两面具粗毛；花萼短筒状，5深裂，裂片狭渐尖；花冠白色，花冠管短，先端5裂，喉部具有5个鳞片状附肢，基部具有毛状物；雄蕊5，着生于花冠管中部，花丝短或无；子房上位，4深裂，花柱线形，柱头球状，浅裂。小坚果直立，卵圆形，淡褐色。种子4枚，卵圆形。花期5～6月，果期7～8月。"}]},{"ID":"20240611154555-1c4yee7","Type":"NodeParagraph","Properties":{"id":"20240611154555-1c4yee7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"生于山野草丛中、山地阳坡及山谷。分布黑龙江、吉林、辽宁、河北、河南、安徽、广西、贵州、江苏等地。"}]},{"ID":"20240611154555-a1z8m5r","Type":"NodeParagraph","Properties":{"id":"20240611154555-a1z8m5r","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②新藏假紫草"}]},{"ID":"20240611154555-2cvi9rf","Type":"NodeParagraph","Properties":{"id":"20240611154555-2cvi9rf","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"多年生草本，高25～35厘米，全株被白粗硬毛。根直生，略呈圆锥形，支根常数个扭转在一起。茎直立，单一或基部两歧，被长硬毛。根生叶丛生，无柄，叶片线状披针形，长约13厘米，先端急尖，基部渐狭，全缘，黄绿褐色；茎生叶互生，较短小，无柄。蝎尾状聚伞花序密集于茎顶，花两性；苞片线状披针形，具硬毛；花萼短筒状，裂片5狭窄叶状，与花冠等长或超出；花冠长筒形，紫色或淡紫色，长达1.5厘米，裂片5，椭圆形，外侧略被白毛，喉部与基部光滑；雄蕊5，花丝短或无；子房上位，花柱纤细，柱头球形，2深裂。小坚果阔卵形，淡褐色。花期6～7月，果期8～9月。"}]},{"ID":"20240611154555-72m05y3","Type":"NodeParagraph","Properties":{"id":"20240611154555-72m05y3","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"生长于高山野草丛中或向阳坡地。分布新疆、西藏、甘肃等地。"}]},{"ID":"20240611154555-j63jwyi","Type":"NodeParagraph","Properties":{"id":"20240611154555-j63jwyi","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③滇紫草"}]},{"ID":"20240611154555-07zcj8m","Type":"NodeParagraph","Properties":{"id":"20240611154555-07zcj8m","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60～80厘米。根直立，圆柱形，质坚硬，外皮暗红紫色。茎单一，直立，无柄；基生叶狭长椭圆形至披针形，长约20厘米，宽约2.6厘米，先端渐尖，基部楔形，全缘，表面被糙伏毛，叶背中脉被长硬毛；上部叶渐小，披针形。蝎尾状聚伞花序呈圆锥形；花两性；萼筒几全裂，裂片线形至披针形；花冠筒状，红色，长约1.4厘米，先端5浅裂，裂片呈三角形，反卷；雄蕊5，花药5个相连包围花柱，基部楔形，花丝短，被白色柔毛；子房上位，深4裂，花柱露于花冠之外。小坚果卵形，淡褐色。花期初夏。"}]},{"ID":"20240611154555-2jcjna4","Type":"NodeParagraph","Properties":{"id":"20240611154555-2jcjna4","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"生于向阳山坡草丛中。分布云南及西藏、四川、贵州。"}]},{"ID":"20240611154555-5ksd0iv","Type":"NodeParagraph","Properties":{"id":"20240611154555-5ksd0iv","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611154555-k93g4fe","Type":"NodeParagraph","Properties":{"id":"20240611154555-k93g4fe","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①硬紫草"}]},{"ID":"20240611154555-rhci3ty","Type":"NodeParagraph","Properties":{"id":"20240611154555-rhci3ty","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"为紫草的干燥根，呈扭曲的圆柱形或略呈纺锤形，长约7～15厘米，直径约0.7～2厘米，根头部具茎残基，常有侧根。表面暗紫色，粗糙，有纵沟，皮部薄，稍有鳞片。质硬而轻脆，易折断，断面片状，皮部深紫色，与木部之间有裂隙或呈小圆孔状，木部较明显，黄白色。气特殊，味微甘而酸。"}]},{"ID":"20240611154555-l9wmvup","Type":"NodeParagraph","Properties":{"id":"20240611154555-l9wmvup","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"主产东北、湖北、湖南等地。"}]},{"ID":"20240611154555-2gyxods","Type":"NodeParagraph","Properties":{"id":"20240611154555-2gyxods","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②软紫草"}]},{"ID":"20240611154555-e3s7blw","Type":"NodeParagraph","Properties":{"id":"20240611154555-e3s7blw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"为新藏假紫草的根，呈不规则圆柱形，略扭曲，长约7～20厘米，直径约1～2.5厘米。表面暗紫色。顶端有茎基。皮部极疏松，成条状的鳞片，常十几层重重相迭，易剥落成不整齐的条状碎片。质松软而轻，易折断，断面成片状，木部不明显，黄白色，成环状，中心有暗紫色的大形髓。气特殊，味微酸。"}]},{"ID":"20240611154555-8hk3690","Type":"NodeParagraph","Properties":{"id":"20240611154555-8hk3690","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"主产新疆。"}]},{"ID":"20240611154555-n40tj5k","Type":"NodeParagraph","Properties":{"id":"20240611154555-n40tj5k","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③滇紫草"}]},{"ID":"20240611154555-x6xdm7p","Type":"NodeParagraph","Properties":{"id":"20240611154555-x6xdm7p","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"为滇紫草的根除去外皮的木部，亦称硬紫草，圆柱形，长约15厘米，直径1～2厘米。下部长分歧。表面紫褐色，被暗紫色粉末，具扭曲的纵皱。质坚硬，不易折断，断面颗粒状，木部黄白色而稍紫，髓部紫色。气微弱，味微酸。滇紫草皮：为滇紫皮的根皮，呈不规则的碎片，长约0.5～5厘米，宽约0.5～2厘米，常数层相迭。表面紫褐色、内面平滑。质脆易断。气弱，味淡。"}]},{"ID":"20240611154555-b3b90zp","Type":"NodeParagraph","Properties":{"id":"20240611154555-b3b90zp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"主产云南。"}]},{"ID":"20240611154555-3yg7ii9","Type":"NodeParagraph","Properties":{"id":"20240611154555-3yg7ii9","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"此外尚有：①天山紫草，与新藏假紫草近似，植株较矮小，聚伞花序呈簇生状。分布新疆。②帕米尔假紫草，根较粗大，茎多分枝；叶线状披针形；花冠长筒状，黄色，喉部有紫斑。分布新疆昆仑山。③假紫草，又名：内蒙紫草。高9～22厘米。茎单一或多枝。叶片披针形或倒披针形，长1～1.5厘米，宽0.2～0.6厘米。总状花序，花冠黄色，裂片具紫斑。分布内蒙古、甘肃、新疆。④长花滇紫草，与滇紫草近似而矮小，高15～30厘米。花冠约3厘米。分布西藏。上述植物的根均作紫草入药。"}]},{"ID":"20240611154555-p138x0t","Type":"NodeParagraph","Properties":{"id":"20240611154555-p138x0t","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611154555-r5y0uq4","Type":"NodeParagraph","Properties":{"id":"20240611154555-r5y0uq4","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 以云南紫草糖浆5～15克/公斤喂饲小鼠2个月，一般食欲与活动正常，体重改变不明显，病理解剖除垂体、卵巢、子宫重量减轻外，其他如甲状腺、肾上腺的重量均无改变，在显微镜下检查所有组织，均未观察到组织上的病理改变。30％新疆紫草喂饲小鼠，1周内体重减轻30％左右，15天内有40％死亡；用根粉5克/公斤给家兔灌胃，3天后尿色深紫，尿中出现蛋白和红细胞，并有腹泻，停药两天后症状消失。"}]},{"ID":"20240611154555-4p62bv3","Type":"NodeParagraph","Properties":{"id":"20240611154555-4p62bv3","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611154555-buii7gj","Type":"NodeParagraph","Properties":{"id":"20240611154555-buii7gj","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 紫草根含乙酰紫草醌、异丁酰紫草醌、β，β-二甲基丙烯紫草醌、β-羟基异戊酰紫草醌、3，4-二甲基戊烯-3-酰基紫草醌。"}]},{"ID":"20240611154555-nzgzt1s","Type":"NodeParagraph","Properties":{"id":"20240611154555-nzgzt1s","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"新藏假紫草根含β-羟基异戊酰紫草醌、3，4-二甲基戊烯-3-酰基紫草醌。"}]},{"ID":"20240611154555-383lm4i","Type":"NodeParagraph","Properties":{"id":"20240611154555-383lm4i","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611154555-i8sjc9e","Type":"NodeParagraph","Properties":{"id":"20240611154555-i8sjc9e","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①避孕作用"}]},{"ID":"20240611154555-tweu0g8","Type":"NodeParagraph","Properties":{"id":"20240611154555-tweu0g8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草根（日产）乙醇提取液100毫克/100克、30％紫草根粉末混合食喂饲动物均可抑制大鼠动情期，根中提出的色素则无效。云南产紫草50％的糖浆剂，给予小白鼠口服1个月，能明显抑制其动情期，停药2个月后可恢复；并能抑制小鼠盛誉率。正常小鼠连续口服紫草两个月，卵巢明显减轻，子宫及垂体则轻微减轻，但对其他内分泌腺如甲状腺、肾上腺的重量无明显影响。油剂对去卵巢的小白鼠，阴道涂片未出现角化细胞，子宫重量亦不增加，说明无雌激素样作用。欧产紫草叶的提取物能抑制垂体前叶分泌促甲状腺激素及促性腺激素的分泌，此影响不在干扰激素的合成，而是影响其释放。新藏假紫草、广西紫草、紫草根（品种均未注明）口服降低小白鼠的生育率，并有明显抗垂体促性腺激素及抗绒毛促性激素的作用，而紫草醌则明显无效。国外所产路边紫草50％的醇浸出掖，能降低小白鼠的生育率，使正常小白鼠的动情间期延长，如再注射雌酮或促性激素仍可引起动情期；对未成熟的雄性或雌性小鼠，可引起性器官、胸腺、垂体重量减轻，生长发育延缓，此有效成分大部分在花、种子、叶、根中。其作用原理为抑制了脑下垂体促性腺激素的形成，特别是抑制了黄体生成素，也可能是它使上述激素直接失去活性，即所谓\"灭能\"的作用。"}]},{"ID":"20240611154555-p72vk6x","Type":"NodeParagraph","Properties":{"id":"20240611154555-p72vk6x","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②抗菌、抗炎作用"}]},{"ID":"20240611154555-tpqlakw","Type":"NodeParagraph","Properties":{"id":"20240611154555-tpqlakw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草对京科68-1病毒试管内有抑制作用，对金黄色葡萄球菌、灵杆菌亦能抑制。前苏联产紫草的酊剂对化脓菌、大肠杆菌有抑制作用。并能加速上皮生长以及治疗烧伤。日本产紫草根的乙醚或水提取物口服或局部应用能抑制毛细血管通透性（大鼠皮内色素渗出法）；口服提取物100毫升/公斤对角叉菜胶引起的大鼠后肢浮肿与布他酮有同样的抑制效力，紫草醌及乙酰紫草醌亦有同样的抗炎作用。局部应用可促进创伤愈合。紫草根与当归制成之紫云膏比单味药效果好。紫草水煎剂对小白鼠结核病有一定疗效。但对豚鼠无效。用平皿法试验能抑制多种真菌。紫草膏可用于颜面癣。"}]},{"ID":"20240611154555-uccvaky","Type":"NodeParagraph","Properties":{"id":"20240611154555-uccvaky","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③对循环系统的影响"}]},{"ID":"20240611154555-55tpzcx","Type":"NodeParagraph","Properties":{"id":"20240611154555-55tpzcx","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"新疆软紫草（太原市购得，品种未确定）煎剂对健康家兔及蟾蜍之离体或整体心脏，皆有明显的兴奋作用，此作用与煎剂中含钙有关。在全身麻醉下静脉或肌肉注射此煎剂，能使近半数动物（兔、犬、猫）血压急剧下降，甚至死亡，但不麻醉或口服者无此严重反应。对蟾蜍内脏血管及兔后肢、离体兔耳灌流皆无影响。"}]},{"ID":"20240611154555-edzbhsi","Type":"NodeParagraph","Properties":{"id":"20240611154555-edzbhsi","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"④抗肿瘤作用"}]},{"ID":"20240611154555-b6bqj2y","Type":"NodeParagraph","Properties":{"id":"20240611154555-b6bqj2y","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"据报道，紫草根对绒毛膜上皮癌及恶性葡萄胎有一定的疗效。用美蓝试管法初筛，紫草根对急性淋巴细胞白血病有极轻度的抑制作用。紫草可减少（鼠）自发性乳癌的发病率。"}]},{"ID":"20240611154555-4uf31u8","Type":"NodeParagraph","Properties":{"id":"20240611154555-4uf31u8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑤其他作用"}]},{"ID":"20240611154555-zgxvdiv","Type":"NodeParagraph","Properties":{"id":"20240611154555-zgxvdiv","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"新疆软紫草煎剂对兔有缓和的解热作用，对家兔离体子宫及小肠平滑肌有不恒定的兴奋作用，口服煎剂能加强小肠的紧张性与收缩，静脉注射则无此反应。紫草叶提取物可使兔血糖下降，增加豚鼠肠管张力，对大鼠无利尿作用。"}]},{"ID":"20240611154555-6ju7bin","Type":"NodeParagraph","Properties":{"id":"20240611154555-6ju7bin","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611154555-bsxrmbp","Type":"NodeParagraph","Properties":{"id":"20240611154555-bsxrmbp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 硬紫草：洗净，润透，切片，晒干。软紫草：拣去杂质，去苗，剪断。"}]},{"ID":"20240611154555-ymnpb25","Type":"NodeParagraph","Properties":{"id":"20240611154555-ymnpb25","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使（紫草），每一斤用蜡二两，溶水拌蒸之，待水干，取去头并两畔髭，细锉用。\""}]},{"ID":"20240611154555-09ozecs","Type":"NodeParagraph","Properties":{"id":"20240611154555-09ozecs","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611154555-xdakaou","Type":"NodeParagraph","Properties":{"id":"20240611154555-xdakaou","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 入心包络、肝经。"}]},{"ID":"20240611154555-o80d86b","Type":"NodeParagraph","Properties":{"id":"20240611154555-o80d86b","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入心包络、肝经血分。\""}]},{"ID":"20240611154555-brw7bag","Type":"NodeParagraph","Properties":{"id":"20240611154555-brw7bag","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②《雷公炮炙论》：\"入心、小肠二经。\""}]},{"ID":"20240611154555-d6iko26","Type":"NodeParagraph","Properties":{"id":"20240611154555-d6iko26","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足少阴、厥阴。\""}]},{"ID":"20240611154555-jrvoxzm","Type":"NodeParagraph","Properties":{"id":"20240611154555-jrvoxzm","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611154555-w8j9dzh","Type":"NodeParagraph","Properties":{"id":"20240611154555-w8j9dzh","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611154555-k0rhari","Type":"NodeParagraph","Properties":{"id":"20240611154555-k0rhari","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，寒。\""}]},{"ID":"20240611154555-rrb89hs","Type":"NodeParagraph","Properties":{"id":"20240611154555-rrb89hs","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611154555-cc3fg4t","Type":"NodeParagraph","Properties":{"id":"20240611154555-cc3fg4t","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"甘，平。\""}]},{"ID":"20240611154555-k175w98","Type":"NodeParagraph","Properties":{"id":"20240611154555-k175w98","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"甘咸，寒。\""}]},{"ID":"20240611154555-iwvq4jz","Type":"NodeParagraph","Properties":{"id":"20240611154555-iwvq4jz","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611154555-f1onh0s","Type":"NodeParagraph","Properties":{"id":"20240611154555-f1onh0s","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 胃肠虚弱、大便滑泄者慎服。"}]},{"ID":"20240611154555-edjyo1t","Type":"NodeParagraph","Properties":{"id":"20240611154555-edjyo1t","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"《本草经疏》：\"痘疮家气虚脾胃弱、泄泻不思食、小便清利者，俱禁食。\""}]},{"ID":"20240611154555-wkwobqg","Type":"NodeParagraph","Properties":{"id":"20240611154555-wkwobqg","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611154555-dzlk0ir","Type":"NodeParagraph","Properties":{"id":"20240611154555-dzlk0ir","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 凉血，活血，清热，解毒。治温热斑疹，湿热黄疸，紫癜，吐、衄、尿血，淋浊，热结便秘，烧伤，湿疹，丹毒，痈疡。"}]},{"ID":"20240611154555-md4dbpd","Type":"NodeParagraph","Properties":{"id":"20240611154555-md4dbpd","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹邪气，五疸，补中益气，利九窍，通水道。\""}]},{"ID":"20240611154555-lfo9bxf","Type":"NodeParagraph","Properties":{"id":"20240611154555-lfo9bxf","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗腹肿胀满痛。以合膏，疗小儿疮及面齄。\""}]},{"ID":"20240611154555-9prmdyx","Type":"NodeParagraph","Properties":{"id":"20240611154555-9prmdyx","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治恶疮、瘑癣。\""}]},{"ID":"20240611154555-6wjhq8t","Type":"NodeParagraph","Properties":{"id":"20240611154555-6wjhq8t","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"④《本草图经》：\"治伤寒时疾，发疮疹不出者，以此作药，使其发出。\""}]},{"ID":"20240611154555-flhkms7","Type":"NodeParagraph","Properties":{"id":"20240611154555-flhkms7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"治斑疹、痘毒，活血凉血，利大肠。\""}]},{"ID":"20240611154555-kwh3681","Type":"NodeParagraph","Properties":{"id":"20240611154555-kwh3681","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑥《医林纂要》：\"补心，舒肝，散瘀，活血。\""}]},{"ID":"20240611154555-t4uihyi","Type":"NodeParagraph","Properties":{"id":"20240611154555-t4uihyi","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑦《吉林中草药》：\"治便秘，尿血。\""}]},{"ID":"20240611154555-18wvlft","Type":"NodeParagraph","Properties":{"id":"20240611154555-18wvlft","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑧《陕西中草药》：\"治汤火伤，皮炎，湿疹，尿路感染。\""}]},{"ID":"20240611154555-kto54qn","Type":"NodeParagraph","Properties":{"id":"20240611154555-kto54qn","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611154555-1s1eq99","Type":"NodeParagraph","Properties":{"id":"20240611154555-1s1eq99","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入散剂。外用：熬膏涂。"}]},{"ID":"20240611154555-9qtterx","Type":"NodeParagraph","Properties":{"id":"20240611154555-9qtterx","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611154555-f05prf8","Type":"NodeParagraph","Properties":{"id":"20240611154555-f05prf8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①发斑疹：钩藤钩子、紫草茸各等分。上为细末，每服一字或五分、一钱，温酒调下，无时。（《小儿药证直诀》紫草散）"}]},{"ID":"20240611154555-hetydq7","Type":"NodeParagraph","Properties":{"id":"20240611154555-hetydq7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②治疮疹才初出，便急与服之，令毒减轻可：紫草（去粗梗）二两，陈橘皮（去白，焙干）一两。上为末，每服一大钱，水一盏，入葱白二寸，煎至六分，去渣温服，无时。乳儿与乳母兼服之，断乳令自服。（《小儿卫生总微论方》紫草如圣汤）"}]},{"ID":"20240611154555-lln2qfz","Type":"NodeParagraph","Properties":{"id":"20240611154555-lln2qfz","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③预防麻疹：紫草三钱，甘草一钱。水煎，日服二次。（《吉林中草药》）"}]},{"ID":"20240611154555-u94th1l","Type":"NodeParagraph","Properties":{"id":"20240611154555-u94th1l","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"④治过敏性紫癜：紫草五钱，蝉蜕二钱，当归四钱，竹叶三钱，西河柳三钱，牛蒡子三钱，黄柏三钱，知母三钱，苦参三钱。水煎服。（新疆中草药手册》）"}]},{"ID":"20240611154555-4kqtj7n","Type":"NodeParagraph","Properties":{"id":"20240611154555-4kqtj7n","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑤治血小板减少性紫癜：紫草二钱，海螵蛸五钱，茜草二钱。水煎服。（《新疆中草药手册》）"}]},{"ID":"20240611154555-mvxbrc7","Type":"NodeParagraph","Properties":{"id":"20240611154555-mvxbrc7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑥治热疮：紫草茸、黄连、黄柏、漏芦各半两，赤小豆、绿豆粉各一合。上药捣细，入麻油为膏，日三敷，常服黄连阿胶丸清心。（《仁斋直指方》紫草膏）"}]},{"ID":"20240611154555-zwbouf1","Type":"NodeParagraph","Properties":{"id":"20240611154555-zwbouf1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑦治小儿胎毒，疥癣，两眉生疮，或延及遍身瘙痒，或脓水淋沥，经年不愈：紫草、白芷各二钱，归身五钱，甘草一钱，麻油二两。同熬，白芷色黄为度，滤清，加白蜡、轻粉各二钱，取膏涂之。（《疡医大全》紫草膏）"}]},{"ID":"20240611154555-2cf64z6","Type":"NodeParagraph","Properties":{"id":"20240611154555-2cf64z6","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑧治火烫，发泡腐烂：紫草一钱，当归五钱，麻油四两。上三味，同熬药枯，滤清去渣，将油再熬，加黄蜡五钱，熔化，倾入碗内，顿冷，涂之。（《幼科金针》紫草润肌膏）"}]},{"ID":"20240611154555-ofgdswk","Type":"NodeParagraph","Properties":{"id":"20240611154555-ofgdswk","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑨治痈疽便闭：紫草、栝楼等分。新水煎服。（《仁斋直指方》）"}]},{"ID":"20240611154555-tf6zb9z","Type":"NodeParagraph","Properties":{"id":"20240611154555-tf6zb9z","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑩治小便卒淋：紫草一两。为散，每食前用井华水服二钱。（《千金翼方》）"}]},{"ID":"20240611154555-vlqa5nb","Type":"NodeParagraph","Properties":{"id":"20240611154555-vlqa5nb","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑾治血淋：紫草、连翘、车前子各等分，水煎服。（《证治准绳》）"}]},{"ID":"20240611154555-tgxie4t","Type":"NodeParagraph","Properties":{"id":"20240611154555-tgxie4t","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑿治吐血衄血不大凶，亦不尽止，起居如故，软食如常，一岁之间，或发二、三次，或发五、六次，久必成痨：紫草、怀生地各四两，白果肉百个，茯苓、麦门冬各三两。煎膏，炼蜜收，每早、晚各服十余匙，白汤下。（《方脉正宗》）"}]},{"ID":"20240611154555-5nv2v91","Type":"NodeParagraph","Properties":{"id":"20240611154555-5nv2v91","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⒀治五疸热黄：紫草三钱，茵陈草一两。水煎服。（《本草切要》）"}]},{"ID":"20240611154555-fqh50fc","Type":"NodeParagraph","Properties":{"id":"20240611154555-fqh50fc","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⒁治赤游丹毒，红晕如云头：用小锋刀或磁碗锋画去毒血，紫草五钱，鼠粘子一两。研细，水煎服。（《本草汇言》）"}]},{"ID":"20240611154555-1ykbf7q","Type":"NodeParagraph","Properties":{"id":"20240611154555-1ykbf7q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⒂治小儿白秃：紫草煎汁涂之。（《圣惠方》）"}]},{"ID":"20240611154555-ajkjinh","Type":"NodeParagraph","Properties":{"id":"20240611154555-ajkjinh","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⒃治豌豆疮，面齄，恶疮，瘑癣：紫草煎油涂之。（《医学入门》）"}]},{"ID":"20240611154555-no4llg4","Type":"NodeParagraph","Properties":{"id":"20240611154555-no4llg4","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⒄治恶虫咬：油浸紫草涂之。（《圣惠方》）"}]},{"ID":"20240611154555-r93oy2q","Type":"NodeParagraph","Properties":{"id":"20240611154555-r93oy2q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611154555-9bioi2q","Type":"NodeParagraph","Properties":{"id":"20240611154555-9bioi2q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①治疗急慢性肝炎"}]},{"ID":"20240611154555-dfvc28v","Type":"NodeParagraph","Properties":{"id":"20240611154555-dfvc28v","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"用从紫草根中提取的紫草红（素）干燥粉末为溶质，以氢氧化钠为溶剂，制成0.2％紫草注射液。肌肉注射，每日1～2次，每次2毫升。计观察黄疸型传染性肝炎13例，均治愈；急性无黄疸型传染性肝炎157例，治愈139例，显效14例，好转2例，无效13例。此外，尚治疗肝硬化4例，亦取得一定疗效。"}]},{"ID":"20240611154555-paudfjc","Type":"NodeParagraph","Properties":{"id":"20240611154555-paudfjc","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②治疗肺结核合并血小板减少性紫癜"}]},{"ID":"20240611154555-chqn3e2","Type":"NodeParagraph","Properties":{"id":"20240611154555-chqn3e2","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"曾报告1例，经一般中西综合治疗效果不显，改用大量紫草后获得效果。第1日用1两，服后鼻衄即减；第2日加至2两，鼻衄完全停止；连用五剂，血小板计数增至170000/立方毫米，全身紫斑消退，病情转危为安。服药后有腹泻反应，但患者并无不适感。"}]},{"ID":"20240611154555-yzxf50r","Type":"NodeParagraph","Properties":{"id":"20240611154555-yzxf50r","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③治疗恶性葡萄胎并发子宫绒毛膜上皮癌"}]},{"ID":"20240611154555-c0ga20r","Type":"NodeParagraph","Properties":{"id":"20240611154555-c0ga20r","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"曾报告1例，手术后X线摄片发现肺部有转移病灶，经1个月观察，转移病灶渐见扩大，临床症状也日见加重。采用紫草根1两，每日煎服1剂，10天为一疗程。经四个疗程，临床症状大为减轻，X线复查病灶大部分消失。继续服紫草根1个月，临床症状全部消失，小便妊娠反应阴性。"}]},{"ID":"20240611154555-4z1yf8a","Type":"NodeParagraph","Properties":{"id":"20240611154555-4z1yf8a","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"④治疗婴儿皮炎、外阴湿疹、阴道炎及子宫颈炎"}]},{"ID":"20240611154555-f1zfuyl","Type":"NodeParagraph","Properties":{"id":"20240611154555-f1zfuyl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"采用2％、10％、20％、40％紫草菜油浸剂，或用紫草乙醚提出物配成1％菜油制剂，局部应用。㈠试治婴儿臀部皮炎100例，用药后无1例发生糜烂情况。㈡妇女尿生殖瘘病人，因经常漏尿而造成阴部的湿疹、糜烂、溃疡以及各种原因所致的阴道溢液增多，涂紫草油后3～5天左右即可见效。曾治疗28例，痊愈24例。㈢用于阴道炎，一般在涂药后4～6天可以治愈，而且复发率很低。曾治疗234例，治愈率77.7％。㈣子宫颈炎如合并盆腔炎或重度糜烂、充血，并有脓性分泌物者，易引起流血、感染及盆腔炎急性发作，可采用紫草油涂抹。根据病情轻重，连续1～3周，可使充血及脓性分泌物消失，直至痊愈。治疗182例，痊愈96例。紫草油的浓度愈高，效果愈好，增加浓度并无任何副作用。紫草油似无抑菌作用，其临床疗效的原理，需进一步研究。"}]},{"ID":"20240611154555-8rsd4fs","Type":"NodeParagraph","Properties":{"id":"20240611154555-8rsd4fs","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑤治疗扁平疣及阴屑病"}]},{"ID":"20240611154555-687op9o","Type":"NodeParagraph","Properties":{"id":"20240611154555-687op9o","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"用紫草的提取物紫草醌制成0.1％注射液，肌肉注射每次2毫升；少数银屑病患者用0.05％紫草醌注射液行静脉注射，每次10毫升。均每日1次。扁平疣23例，经治7～10次后，痊愈（自觉症状消失，皮疹全部或绝大部分消退）10例，显效（症状减轻，皮疹明显变小变平或红斑变淡，鳞屑变薄）10例，无效（注射10次以上皮疹未见改善）3例。银屑病肌注治疗29例，经10～20次治后治愈5例，显效15例，无效9例；静注治疗7例，经10次后治愈3例，显效1例，无效3例。初步观察，对扁平疣效果确实，疗程明显缩短，且复发率低。而银屑病以进行期病变疗效较好。缺点为注射局部疼痛。另曾有用紫草根20克加二甲基亚砜100毫升，浸泡3～4天后取液涂抹局部，每天1～2次；治疗扁平疣20余例，一般经1～2周即见扁平疣脱落或平复。"}]},{"ID":"20240611154555-cgur3yn","Type":"NodeParagraph","Properties":{"id":"20240611154555-cgur3yn","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑥治疗玫瑰糠疹"}]},{"ID":"20240611154555-4p19mtp","Type":"NodeParagraph","Properties":{"id":"20240611154555-4p19mtp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"用紫草0.5～1两（小儿2～5钱），每日煎服1剂，10日为一疗程。经一定间歇后可继续服用几个疗程。治疗70例，痊愈37例，进步25例，无效8例。平均服药9天，最多不超过2个月。"}]},{"ID":"20240611154555-88iaepw","Type":"NodeParagraph","Properties":{"id":"20240611154555-88iaepw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑦关于预防麻疹"}]},{"ID":"20240611154555-f2enu6h","Type":"NodeParagraph","Properties":{"id":"20240611154555-f2enu6h","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草根预防麻疹，各地曾广泛试用，但用法不尽相同，效果亦不一致。㈠用紫草根煎剂、水剂及复方紫草根煎剂（紫草根、白术、木香）3种剂型口服。主药紫草根的用量是：6个月至1岁6分，1岁以上至2岁8分，2岁以上每增加1岁递增2分。以上均为1日量，分3次服，连服4天。共观察6个月至8岁有麻疹接触史的散居儿童968人，发病者94人，占9.72％，3种剂型的效果无大差别。认为紫草根对预防麻疹的保护率为90.2％。㈡用33％紫草根糖浆，6个月至1岁每次10毫升，2～3岁20毫升，4～6岁30毫升。每隔日服2次，共服3次，计6次。曾对110个农村散居易感小儿，发给糖浆预防，结果3例出疹，预防保护率97.3％。另有用上述方法对农村散居易感小儿685人进行预防观察，其结果，服药后发病率由服药前的11.3％逐步下降为1.1％。凡未患过麻疹的小儿服药后绝大多数均获得免疫，对潜伏期或前驱期患者，服用后均缩短了病期，同时麻疹发出也快。㈢紫草根1岁以下用1.5钱，2～8岁用2钱，9～12岁用2.5钱，加水100毫升，煮沸3分钟，1天内分服，仅服1天。共观察散居儿童1480例，其中1350例平均观察2周均未见出疹，其他130例发疹者的临床症状亦较轻。㈣用1:1的紫草茸、紫草皮和紫草根糖浆，1岁以内每次1毫升，2～3岁2毫升，4～6岁3毫升，均日服3次，连服4天 。观察4个月至16岁城市散居儿童1607例，结果以紫草根的效果最好，发病率为8.58％；紫草茸较差，发病率为15％；紫草皮无明显预防作用，服药后并有白细胞降低现象。㈤用33％紫草根溶液，每次15毫升，日服2次，每周连服2天。于流行期间在6个托儿所，给2～6岁未患过麻疹的小儿133名作预防服药。结果服药后发病者112名，发病率占84.2％，其中并发肺炎者13名。㈥用紫草根2份，甘草1份，共制成粉剂。6个月以上0.6克，2岁以上1克，4岁以上1.5克5～7岁2.5克。均日服3次，连服3天。于流行季节选择6个月至7岁的易感小儿471人（服药组258人，对照组213人）进行观察，结果服药组的发病率并未降低，对麻疹潜伏期、前驱期、并发症以及病情的轻重均无影响。㈦对16个发生麻疹流行而用紫草作预防的集体儿童机构进行了调查。其中未患过麻疹的接触者（6个月至6岁）有499人，在这些接触者中服紫草根液的有310人，注射胎盘球蛋白的有61人，注射成人血的有63人，另65人未接受任何预防保护措施。结果发病总数为488人，占97.7％。服紫草根的310人中除1名5岁半及1名6个月的婴儿外，全部发病，发病时潜伏期未见延长，病情亦不见减轻，与未接受预防组无明显差别。服紫草根液的接触者，合并肺炎及支气管炎的人数与未接受预防组亦无明显差别。服紫草根液的迟早（与病人接触后）与发病轻重无明显关系，即使与病人第1次接触前即开始进行预防性服药，亦不能防止发病或减轻病情。㈧用100％紫草根煎剂和复方紫草根煎剂（紫草根3份，银花2份，甘草1份），根据剂量大小不同，分为3组。第1组每公斤体重用紫草根0.4克，第2组每公斤体重0.8克，第3组为复方煎剂组，紫草根用量亦为每公斤0.8克；均每日1剂，分3次服，连服3日。共观察359人（年龄在5岁以内者占85％），其中预防组152人，曾与麻疹病人接"}]},{"ID":"20240611154555-h9b4b4n","Type":"NodeParagraph","Properties":{"id":"20240611154555-h9b4b4n","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"触者30名，结果发病者26名；对照组207人，与麻疹患者接触过者48名，发病47名。在发病的26名儿童中，有19名是在接触后4日内服紫草根的，说明即使在潜伏期早期服紫草根也未能预防麻疹。3组不同剂型及剂量，其发病率差别不大，并不能显示剂量与剂型对发病率有何影响。在应用紫草根作为预防剂之后，病程并无明显缩短，同时也有并发肺炎的病例。"}]},{"ID":"20240611154555-6p2o21o","Type":"NodeParagraph","Properties":{"id":"20240611154555-6p2o21o","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611154555-x8omzis","Type":"NodeParagraph","Properties":{"id":"20240611154555-x8omzis","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"紫草，其功长于凉血活血，利大小肠。故痘疹欲出未出，血热毒盛，大便闭涩者宜用之，已出而紫黑便闭者亦可用。若已出而红活，及白陷大便利者，切宜忌之。故杨士瀛《直指方》云，紫草治痘，能导大便，使发出亦轻，得木香、白术佐之，尤为有益。又曾世荣《活幼心书》云，紫草性寒，小儿脾气实者犹可用，脾气虚者反能作泻。古方惟用茸，取其初得阳气，以类触类，所以用发痘疮，今人不达此理，一概用之，非矣。\""}]},{"ID":"20240611154555-j6e67e1","Type":"NodeParagraph","Properties":{"id":"20240611154555-j6e67e1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"紫草为凉血之要药，故主心腹邪热之气。五疸者，湿热在脾胃所成，去湿除热利窍，其疸自愈。邪热在内，能损中气，邪热散即能补中益气矣。苦寒性滑，故利九窍而通水道也。腹肿胀满痛者，湿热解而从小便出，则前症自除也。合膏药疗小儿痘疮及面齄，皆凉血之效也。\""}]},{"ID":"20240611154555-u3lkbki","Type":"NodeParagraph","Properties":{"id":"20240611154555-u3lkbki","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"③《本草求原》：\"紫草，痘疹隐隐，欲出未出，色赤干枯，及已出而便闭、色紫黑者宜之，痘夹黑疔亦宜。若痘已齐布红活，二便通调，则改用紫草茸，...，于血热未清，用以活血而寓升发之义也。若红活，二便滑，及白陷者，忌之。至灰滞而便滑，则又宜虫部之紫草茸，宜参观之。\""}]},{"ID":"20240611154555-srqpgwl","Type":"NodeParagraph","Properties":{"id":"20240611154555-srqpgwl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"④《本草崇原集说》：\"时法每以紫草配为凉剂，解痘毒，率多寒中变证。惟士宗先用桂枝汤化太阳之气，气化则毒不留。又有桂枝汤加金银花、紫草等法。\""}]},{"ID":"20240611154555-cu6ru9q","Type":"NodeParagraph","Properties":{"id":"20240611154555-cu6ru9q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"紫草，气味苦寒，而色紫入血，故清理血分之热。古以治脏腑之热结，后人则专治痘疡，而兼疗癍疹，皆凉血清热之正旨。杨仁斋以治痈疡之便闭，则凡外疡家血分实热者，皆可用之。且一切血热妄行之实火病，及血痢、血痔、溲血、淋血之气壮邪实者，皆在应用之例。而今人仅以为痘家专药，治血热病者，治外疡者，皆不知有此，疏矣。\""}]},{"ID":"20240611154555-wgbf7pw","Type":"NodeParagraph","Properties":{"id":"20240611154555-wgbf7pw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611154555-4s27t6z","Type":"NodeParagraph","Properties":{"id":"20240611154555-4s27t6z","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611154555-fkqtpdb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611154555-fkqtpdb","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"《中华本草》：紫草"}]},{"ID":"20240611154555-z049cv1","Type":"NodeParagraph","Properties":{"id":"20240611154555-z049cv1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611154555-0d7fcoo","Type":"NodeParagraph","Properties":{"id":"20240611154555-0d7fcoo","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" Zǐ Cǎo"}]},{"ID":"20240611154555-vkayg5x","Type":"NodeParagraph","Properties":{"id":"20240611154555-vkayg5x","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611154555-5lawd9g","Type":"NodeParagraph","Properties":{"id":"20240611154555-5lawd9g","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 藐、茈草、紫丹、紫芺、地血、紫草茸、鸦衔草、紫草根、 山紫草、红石根、野紫草、野麻灯、大紫草、红紫草、紫根、紫草根子、红条紫草"}]},{"ID":"20240611154555-b370so4","Type":"NodeParagraph","Properties":{"id":"20240611154555-b370so4","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611154555-7pytww6","Type":"NodeParagraph","Properties":{"id":"20240611154555-7pytww6","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" Root of Sinkiang Arnebia，Root of Redroot Gromwell，Sinkiang Arnebia Root Redroot Gromwell Root， Root of Paniculate Onosma"}]},{"ID":"20240611154555-e0w6pow","Type":"NodeParagraph","Properties":{"id":"20240611154555-e0w6pow","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611154555-n70m9m7","Type":"NodeParagraph","Properties":{"id":"20240611154555-n70m9m7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611154555-9rx9gov","Type":"NodeParagraph","Properties":{"id":"20240611154555-9rx9gov","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：紫草所在皆有。苗似兰香，茎赤，节青，花紫白色而实白。"}]},{"ID":"20240611154555-oovtk4x","Type":"NodeParagraph","Properties":{"id":"20240611154555-oovtk4x","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：紫草今处处有之。占方稀见使，今医家都用治伤寒时疾，发疮疹不出者，以此作药使其发出。韦宙《独行方》治豌豆疮，煮紫草汤饮，后人相承用之，其效尤速。"}]},{"ID":"20240611154555-ym78nzw","Type":"NodeParagraph","Properties":{"id":"20240611154555-ym78nzw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611154555-rgst49n","Type":"NodeParagraph","Properties":{"id":"20240611154555-rgst49n","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 药材基源：为紫草科植物紫草、新藏假紫草或滇紫草的根。"}]},{"ID":"20240611154555-rgab6x2","Type":"NodeParagraph","Properties":{"id":"20240611154555-rgab6x2","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Arnebia euchroma (Royle) Johnst.[Lithospermum euchroma Royle]2.Lithospermum eryhrorhizon Sieb.et Zuce.[L.officinale l.subsp.erythrorhizon(Zieb.et Zucc.) Hand.-Mazz.]3.Arnebia guttata Bunge[A.thomsonii C.B.Clarke]"}]},{"ID":"20240611154555-shc605b","Type":"NodeParagraph","Properties":{"id":"20240611154555-shc605b","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋季采挖，除去泥沙，晒干。"}]},{"ID":"20240611154555-vu7cjzf","Type":"NodeParagraph","Properties":{"id":"20240611154555-vu7cjzf","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611154555-uokcck8","Type":"NodeParagraph","Properties":{"id":"20240611154555-uokcck8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔2500-4200m的砾石山坡、草地及草甸处。"}]},{"ID":"20240611154555-gc8uyd7","Type":"NodeParagraph","Properties":{"id":"20240611154555-gc8uyd7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.生于向阳山坡草地、灌丛或林缘。"}]},{"ID":"20240611154555-i6bmqqr","Type":"NodeParagraph","Properties":{"id":"20240611154555-i6bmqqr","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.生于荒漠草原、戈壁、向阳石质山坡、湖滨砾石砂地。"}]},{"ID":"20240611154555-77b5lim","Type":"NodeParagraph","Properties":{"id":"20240611154555-77b5lim","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于新疆、甘肃及西藏西部。"}]},{"ID":"20240611154555-fqxtqvp","Type":"NodeParagraph","Properties":{"id":"20240611154555-fqxtqvp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.分布于东北地区及河北、河南、山西、陕西、宁夏、甘肃、青海、山东、江苏、安徽、江西、湖北、湖南、广西、四川、贵州等地。"}]},{"ID":"20240611154555-j4u6j1p","Type":"NodeParagraph","Properties":{"id":"20240611154555-j4u6j1p","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.分布于内蒙古、河北北部、宁夏、甘肃西部、新疆、西藏。"}]},{"ID":"20240611154555-rxjzmb7","Type":"NodeParagraph","Properties":{"id":"20240611154555-rxjzmb7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611154555-ord8qoj","Type":"NodeParagraph","Properties":{"id":"20240611154555-ord8qoj","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 1.软紫草 多年生草本，高15-40cm。全株被白色或淡黄色长硬毛。根粗壮。略呈圆锥形，根部常与数个侧根扭卷在一起，外皮暗红紫色。茎直立，单一或基部分成两歧，基部有残存叶基形成的茎鞘。基生叶丛生，线状披针形或线形，长5-20cm，宽5-15cm，先端短渐尖，基部无鞘状；无叶柄。镰状聚伞花序密集于茎上叶腋，长2-6cm；花两性，苞片叶状，披针形，具硬毛；花萼短简状，5裂，裂片狭条形，两面均密生淡黄色硬毛；花冠简状钟形，紫色或淡紫色，长1-.5cm ,裂片椭圆形，开展；外侧略被白毛，喉部与基部光滑，无附属物；雄蕊5，花丝短或无，关睡于花冠简中部或喉部；子房4深裂，花柱纤细，先端浅2裂，柱头2，倒卵形。小坚果宽卵形，褐色，长3.5mm，宽约3mm。有粗网纹和少数疣突起。花期6-7月，果期8-9月。"}]},{"ID":"20240611154555-ulgjw1q","Type":"NodeParagraph","Properties":{"id":"20240611154555-ulgjw1q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.紫草 多年生草本，高50-90cm 。根粗大，肥厚，圆锥形，略弯曲，常分枝，不分枝，或上部有分枝，全株密密被白色粗硬毛。单叶互生；无柄；叶片长圆状披针形至卵状披针形，长3-8cm，宽5-17mm，先端渐尖，基部楔形，全缘，两面均被糙伏毛。聚伞花序总状，顶生或腋生；花小，两性；苞片披针形或狭卵形，长达3cm，两面有粗毛；花萼5深裂近基部，裂片线形，长约4mm；花冠白色，简状，长6-8cm，先端5裂，裂片宽卵形，开展喉部附属物半球形，先端微凹；雄蕊5，着生于花冠简中部稍上，花丝长约0.4mm，着生花冠简中部，花药长1-1.2mm，子房深4裂，花柱线形，长2-2.5mm，柱头球状，2浅裂。小坚果卵球形，长约3mm，灰白色或淡黄褐色，平滑，有光泽。种子4颗。花期6-8月，果期8-9月。"}]},{"ID":"20240611154555-foatwzf","Type":"NodeParagraph","Properties":{"id":"20240611154555-foatwzf","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.黄花软紫草 多年生草本，高10-35cm。根圆锥形或圆柱形，稍扭曲，外皮紫褐色，常呈片状剥离。茎直立，通常由基部分枝，2-4条，有时1条，直立，密被开展的长硬毛和短伏毛。叶无柄，互生，椭圆形、长卵状披针形或匙状线形，长1.5-5.5cm，宽3-11mm，先端尖或钝，基部渐狭下延，全缘或有微缺刻，两面密生具基盘的白色长硬毛。镰状聚伞花序，长3-10cm；花多数，密集；苞片线状披针形；花萼短钟状，5裂，裂片线状披针形，长6-10mm；花冠鲜黄色，简状钟形，细长，长约1.8mm；子房4裂，花柱丝状，稍超过花冠简之半，先端2裂，柱头球形。小坚果4，三角状卵形，长2-3mm，淡黄褐色，有小疣状突起。花期6-8月，果期8-10月。"}]},{"ID":"20240611154555-93upcfl","Type":"NodeParagraph","Properties":{"id":"20240611154555-93upcfl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611154555-540w5b8","Type":"NodeParagraph","Properties":{"id":"20240611154555-540w5b8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：紫草耐寒，忌高温，怕水浸。土壤以石灰质壤、砂质壤土、粘壤土为佳。"}]},{"ID":"20240611154555-1e5lyzo","Type":"NodeParagraph","Properties":{"id":"20240611154555-1e5lyzo","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.整地：将士地深翻耙平后，开小沟，沟距20-30cm。沟内施以粪肥或绿肥。"}]},{"ID":"20240611154555-dd0m9e3","Type":"NodeParagraph","Properties":{"id":"20240611154555-dd0m9e3","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.种植：3.1.育苗法： 4月上旬播种，先在苗床浇水，待水渗下后撒播种子，覆土1cm余，经常保持潮湿，15-22天出苗。 苗高6-10cm时，移植于大田，行距30cm，株距10-15cm，稍压后浇水。"}]},{"ID":"20240611154555-i6mthpf","Type":"NodeParagraph","Properties":{"id":"20240611154555-i6mthpf","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.2.直播法： 清明前后播种，条播，按行距30cm开浅沟，将种子均匀播入，播后进行镇压。苗高6cm左右时间苗，株距10-15cm。"}]},{"ID":"20240611154555-12qu057","Type":"NodeParagraph","Properties":{"id":"20240611154555-12qu057","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.田间管理：幼苗期防止高温及阳光直射，注意浇水，除草，松土。雨季应及时排水。苗高20-25cm时，每亩施过磷酸钙20-25斤，施后覆士、浇水。"}]},{"ID":"20240611154555-7w2tj42","Type":"NodeParagraph","Properties":{"id":"20240611154555-7w2tj42","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611154555-61g3dir","Type":"NodeParagraph","Properties":{"id":"20240611154555-61g3dir","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）软紫草 根呈不规则的长圆柱形，多扭曲，长7-20cm，直径1-2.5cm。表面紫红色或紫褐色，皮部疏松，呈条形片状，常10余层重叠，易剥落。顶端有的可见分歧的茎残基。体软，质松软，易折断，断面不整齐，木部较小，黄色或黄白色。气特异，咋做苦、涩。"}]},{"ID":"20240611154555-5dr9sw2","Type":"NodeParagraph","Properties":{"id":"20240611154555-5dr9sw2","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"（2）硬紫草 根呈圆锥形，扭曲，有分枝，长7-14cm，直径1-2cm。表面紫红色或紫黑色，粗糙有纵纹，皮部薄，易剥落。质硬而脆，易折断，断面皮部深紫色，木部较大，灰黄色。气特异，味酸、甜。"}]},{"ID":"20240611154555-2arlkor","Type":"NodeParagraph","Properties":{"id":"20240611154555-2arlkor","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"（3）黄花软紫草 根呈圆锥形或圆柱形，扭曲，长6-20cm，直径0.5-4cm。根头部略粗大，顶端有1或多个残茎，被短硬毛。表面紫红色或暗紫色，皮部略薄，常数层相叠，易剥离。质硬而脆，易折断，断面较整齐，皮部紫红色，木部较小，黄白色。气特异，味涩。"}]},{"ID":"20240611154555-rtnef86","Type":"NodeParagraph","Properties":{"id":"20240611154555-rtnef86","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"以条粗长、肥大、色紫、皮厚、木心小者为佳。"}]},{"ID":"20240611154555-tseju1y","Type":"NodeParagraph","Properties":{"id":"20240611154555-tseju1y","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：（1）软紫草 深紫红色。①非腺毛单细胞多碎断，直径13-56μm，基部扩大呈喇叭状，可至185μm，壁厚5-13μm，非木化，常有纵细条纹，有的胞腔含有紫红色物。②检化细胞充满紫红色色素物，常凝集成条状、团块状，遇水合氯醛液色素物逐渐溶解，细胞显棕色；表面观多角形或圆多角形，壁厚薄不一，木柱化。③薄壁细胞大多充满紫红色色素物，经水合氯醒液透化后，细胞显棕色或棕黄色，细胞界限不清楚；偶见无色薄壁细胞，直径约15μm。④网纹及具缘纹孔导管直径7-111μm。（2）硬紫草 紫红色。 ①检化细胞充满紫红色色素物，表面观类多角形或长多角形，壁薄或稍厚，有的呈连珠状。②薄壁细胞极皱缩，有的壁稍厚，具单纹孔，少数细胞中含紫红色色素。③纤维管胞梭形或细长，直径9-29μm，壁厚1-4μm，有的具缘纹孔纵裂成行，纹孔口斜裂缝状或交成人字状、十字状，常超出纹孔线。④具缘纹孔、网纹及螺纹导管直径9-72μm。"}]},{"ID":"20240611154555-dzimdcq","Type":"NodeParagraph","Properties":{"id":"20240611154555-dzimdcq","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611154555-3b3rnny","Type":"NodeParagraph","Properties":{"id":"20240611154555-3b3rnny","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 以云南紫草糖浆5-15g／kg喂饲小鼠2个月，一般食欲与活动正常，体重改变不明显，病理解剖除垂体、卵巢、子宫重量减轻外，其他如甲状腺、肾上腺的重量均无改变，在显微镜下检查所有组织，均未观察到组织上的病理改变。30%新疆紫草药饵喂词小鼠，1周内体重减轻30%左右，15天内有40%死亡；用根粉5g／kg给家兔灌胃，3天后尿色深紫，尿中出现蛋白和红细胞，并有腹泻，停药2天后症状消失。紫草醚提取物腹腔注射，对小鼠的半数致死量为40mg/kg。紫草素及乙酰紫草素腹腔注射对小鼠的半数致死量分别为20mg/kg及41mg/kg。乙酰紫草素腹腔注射对小鼠的半数致死量为22.75±1.02mg/kg。 小白鼠食用30%新疆紫草药饵，l周内体重减轻3%左右，15天内有40%死亡。用其粉剂5g／kg给家兔灌胃，3天后尿色深紫，尿中出现蛋白及红细胞，并有腹泻，停药2天后，症状可消失，新疆紫草乙醇提取物(含紫草素约56%)对正常凝血机制无明显影响，给小白鼠灌胃2g/kg未见任何毒性，静脉注射的半数致死量为1.30±0.03mg／kg。硬紫草乙醇提取物给小白鼠静脉注射的半数致死量在500mg／10g体重以上，乙醇紫草素给小白鼠腹腔注射的半数致死量为22.75±1.02mg／kg，慢性毒性实验，给小白鼠口服紫草糖浆5-15ml/kg，供2月，食欲，活动均正常，体重无明显变化。"}]},{"ID":"20240611154555-6tho3vc","Type":"NodeParagraph","Properties":{"id":"20240611154555-6tho3vc","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611154555-kmfj1g2","Type":"NodeParagraph","Properties":{"id":"20240611154555-kmfj1g2","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 1.2.3."}]},{"ID":"20240611154555-y5l40fw","Type":"NodeParagraph","Properties":{"id":"20240611154555-y5l40fw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611154555-kwlcr0y","Type":"NodeParagraph","Properties":{"id":"20240611154555-kwlcr0y","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 1.抗病原微生物：紫草对京科68-1病毒在体外有抑制作用，紫草素在鸡胚中能抑制流感病毒，在组织培养中能延缓脊髓灰质炎病毒的致细胞病变作用，紫草对乙型肝炎抗原(HBsAg)有抑制免疫反应作用，对HAA免疫沉淀线有抑制作用；紫草对金黄色葡萄球菌、大肠杆菌、伤寒杆菌、痢疾杆菌和绿脓杆菌有抑制作用，生药与水为1：1的煎剂，对上述菌类以新疆紫草抑菌能力最强，紫草较差；紫草的10%的生理盐水浸液对絮状表皮癣菌、羊毛状小芽胞癣菌等真菌有抑制作用，煮沸后则失去抗菌力。紫草水煎液对小白鼠结核病有一定疗效。"}]},{"ID":"20240611154555-2nof8nk","Type":"NodeParagraph","Properties":{"id":"20240611154555-2nof8nk","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草的乙醚、乙醇或水提取物，紫草素、乙酰紫草素等口服或局部用药，均能抑制毛细血管通透性的亢进(包括由组织胺、菠萝蛋白酶、缓激肽和抗大白鼠血清、兔血清引起者)，亦能抑制由角叉菜胶、抗大白鼠血清、兔血清、甲醛和热刺激等引起动物的局部浮肿或甲醛引起的小白鼠腹膜炎。以及抑制皮下棉球肉芽肿增生，表明对炎症急性渗出期的血管通透性亢进，渗出和水肿及增殖期炎症均有拮抗作用。切除动物肾上腺仍有抗炎作用。紫草提取物或其色素成分制备的软膏局部用药，对肉芽组织的增殖有促进作用，可明显加速创伤愈合。"}]},{"ID":"20240611154555-qo2qkhx","Type":"NodeParagraph","Properties":{"id":"20240611154555-qo2qkhx","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"紫草煎剂口服对家兔实验性发热有缓和的解热作用，其提取物及色素成分也有轻度解热作用。紫草多糖有抗疱疹病毒地方株的作用，用100mg／ml的紫草多糖维持液对HSV-I病毒进行敏感性实验，其抑病毒指数为3-5。"}]},{"ID":"20240611154555-pvesnch","Type":"NodeParagraph","Properties":{"id":"20240611154555-pvesnch","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.对消化道平滑肌的影响：家兔口服紫草煎液能增强小肠内紧张性或使其收缩，此作用能与紫草利大肠、滑肠的功效有关，热毒疮疹、斑毒有便秘者常用之，另一方面，紫草素、乙酰紫草素在浓度高于10-4g/ml时，可使肠管弛缓，并有拮抗乙酰胆碱、组胺、血管紧张素及氯化钡等肠管收缩物质的作用，这些作用并非通过植物神经系统或相应的受体生效，而是色素成分刺激的直接结果，此作用有可能缓解胃肠道平滑肌的痉孪疼痛，中医常用紫草治血痢，除与其抗炎、抗菌等作用有关外，也可能与解痉作用有关，上述两种不同的影响与药物的剂型、动物或器官的机能状态及其他原因有何关系，尚待研究。"}]},{"ID":"20240611154555-7wk3myj","Type":"NodeParagraph","Properties":{"id":"20240611154555-7wk3myj","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.对血凝的影响：腹腔注射给予紫草色素成分(紫草素、乙酰紫草素)不影响血液凝固时间，但可阻止肝素的抗凝血作用。这种作用可拮抗凝血抑制因子，促进静脉瘤等的血栓形成。"}]},{"ID":"20240611154555-2ktv6pb","Type":"NodeParagraph","Properties":{"id":"20240611154555-2ktv6pb","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.抗肿瘤作用：紫草提取物(B，B-二甲基内烯酰紫草素、B，B-二甲基丙酰紫草素、乙酰紫草素和B-乙酰氧基异成酰紫草素)部分，在浓度为0.25mg／ml培养液条件下，对Hela细胞DNA合成后期(G2期)有一定抑制作用，使之推迟进入分裂，导致分裂指数下降，开始4小时分裂指数下降70%。但对该细胞摄取3H-胸腺嘧啶核苷无抑制作用，故对DNA合成无影响；对分裂中期有类似秋水仙素的作用，但作用较缓和，故紫草除影响细胞G2期外，还可能干拢了其他环节。"}]},{"ID":"20240611154555-yo30ce7","Type":"NodeParagraph","Properties":{"id":"20240611154555-yo30ce7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"经进一步实验证明，这部分提取物对EAC、U14、S180、S39、W256等有较明显的抑制作用。用紫草进行动物实验，当剂量为每天5-10mg／kg 时，可完全抑制腹水型肉瘤180细胞的生长；每天10mg／kg时，可延长带瘤小鼠寿命92.5%；剂量过大可中毒死亡，剂量过小(每天lmg／kg)则无效。紫草烷能减少(鼠)自发性乳癌发病率。"}]},{"ID":"20240611154555-v6xlhci","Type":"NodeParagraph","Properties":{"id":"20240611154555-v6xlhci","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"5.避孕作用：草根(日本产)乙醇提取液及紫草根为末混合喂饲动物，均可抑制大鼠动情期，根中提取的色素成分则无效。给小白鼠灌胃50%国产紫草糖浆或10%紫草药饵，有明显抑制动情周期及生育力的效果，停药后，动情周期及生育力均恢复。以幼鼠子宫重量改变为指标的生物检定实验证明，小鼠口服紫草后有明显的抗垂体促性腺激素及抗绒毛膜促性腺激素的作用，作用强度方面，广西产紫草胜于新疆产紫草，正常小鼠口服紫草糖浆2.5g(生药)／(kg.天)共 2月，子宫、卵巢重量均减轻，卵巢重量减轻尤为明显。小白鼠口服10%紫草药饵5g/kg体重，48天后解剖，发现卵巢中卵泡减少，输卵管上皮有小空泡及脂肪变性。"}]},{"ID":"20240611154555-exab2fp","Type":"NodeParagraph","Properties":{"id":"20240611154555-exab2fp","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"6.对循环系统的作用：新疆产紫草对健康家兔在体心脏及蟾蜍的离体心脏，皆有明显兴奋作用；被药物抑制后的离体心脏，亦有此反应。此作用可能与其所含钙盐有关。有报道谓紫草煎剂对心脏的作用，小量兴奋，大量则抑制，最后停止于舒张期，对蟾蜍内脏血管，后肢血管以及离体兔耳血管灌流量无明显影响。全身麻醉下，静脉注射或肌内注射紫草煎液，能使兔、猫、犬等实验动物半数出现血压急剧下降，甚至死亡，但对未麻醉的动物注射或口服则无明显作用。"}]},{"ID":"20240611154555-tvvxy5k","Type":"NodeParagraph","Properties":{"id":"20240611154555-tvvxy5k","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"7.降血糖作用：从硬紫草中得到的紫草多糖A，B，C(Lithopermana)(A，B，C)，当给予100mg／kg剂量时，腹腔注射，对正常小鼠的血糖下降率(%)分别为64、83、55，其中多糖B、C可维持24小时对四氧嘧啶诱发高血糖小鼠，只有多糖A在给药7小时后降糖率达51。"}]},{"ID":"20240611154555-ed6bwkg","Type":"NodeParagraph","Properties":{"id":"20240611154555-ed6bwkg","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611154555-heqfay1","Type":"NodeParagraph","Properties":{"id":"20240611154555-heqfay1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 硬紫草：洗净，润透，切片，晒干。软紫草： 拣去杂质，去苗，剪断。《雷公炮炙论》：凡使(紫草)，每一斤用蜡二两，溶水拌蒸之，待水干，取去头并两畔髭，细锉用。"}]},{"ID":"20240611154555-qe1b16k","Type":"NodeParagraph","Properties":{"id":"20240611154555-qe1b16k","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611154555-ddjngwu","Type":"NodeParagraph","Properties":{"id":"20240611154555-ddjngwu","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末0.5g加乙醇5ml，浸渍1h,滤过。残渣用乙醇2ml洗涤，洗涤液加入滤液中，浓缩至约lml，作供试品溶液。另取左旋紫草素的乙醇溶液作对照溶液。分别吸取 上述溶液，点样子同一硅胶G－CMC薄层板上，以甲苯-醋酸乙酯-甲酸（5：1：0.1）展开，取出，晾干。供试品色谱中，在与对照 品色谱相应的位置上，显相同的紫红色斑点；再喷以10％氢氧 化钾甲醇溶液，斑点变为蓝色。品质标志《中华人民共和国药典》1995年版规定：本品含羟基茶醌总色素以左旋紫草素（C16 H16 O5）计算，不得少于0.880％。"}]},{"ID":"20240611154555-5fgha2k","Type":"NodeParagraph","Properties":{"id":"20240611154555-5fgha2k","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611154555-tfx4snj","Type":"NodeParagraph","Properties":{"id":"20240611154555-tfx4snj","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 心；肝"}]},{"ID":"20240611154555-mm4z9mt","Type":"NodeParagraph","Properties":{"id":"20240611154555-mm4z9mt","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611154555-t5040ie","Type":"NodeParagraph","Properties":{"id":"20240611154555-t5040ie","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 苦；寒"}]},{"ID":"20240611154555-2nrsap1","Type":"NodeParagraph","Properties":{"id":"20240611154555-2nrsap1","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611154555-z35flmz","Type":"NodeParagraph","Properties":{"id":"20240611154555-z35flmz","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 胃肠虚弱、大便滑泄者慎服。《本草经疏》：痘疮家气虚脾胃弱、泄泻不思食、小便清利者，俱禁用。"}]},{"ID":"20240611154555-3fkbc0r","Type":"NodeParagraph","Properties":{"id":"20240611154555-3fkbc0r","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611154555-43z2cjk","Type":"NodeParagraph","Properties":{"id":"20240611154555-43z2cjk","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 凉血；活血；透疹；解毒。主斑疹；麻疹；吐血；衄血；尿血；紫癜；黄疸；痈疽；烫伤"}]},{"ID":"20240611154555-vlmnxam","Type":"NodeParagraph","Properties":{"id":"20240611154555-vlmnxam","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611154555-68mmnew","Type":"NodeParagraph","Properties":{"id":"20240611154555-68mmnew","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g：或入散剂。外用：适量，熬膏或制油涂。"}]},{"ID":"20240611154555-y7yp64u","Type":"NodeParagraph","Properties":{"id":"20240611154555-y7yp64u","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611154555-0jct6xa","Type":"NodeParagraph","Properties":{"id":"20240611154555-0jct6xa","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" ①发斑疹： 钩藤钩子、紫草茸各等分。上为细末，每服一字或五分、一钱，温酒调下，无时。(《小儿药证直诀》紫草散)②治疮疹才初出，便急与服之，令减毒轻可： 紫草(去粗梗)二两，陈橘皮(去白，焙干)一两。上为末，每服一大钱，水一盏，入葱白二寸，煎至六分，去渣温服，无时。乳儿与乳母兼服之，断乳令自服。(《小儿卫生总微论方》紫草如圣汤)③预防麻疹： 紫草三钱，甘草一钱。水煎，日服二次。(《吉林中草药》)④治过敏性紫癜： 紫草五钱，蝉蜕二钱，当归四钱，竹叶三钱，西河柳三钱，牛蒡子三钱，黄柏三钱，知母二钱，苦参三钱。水煎服。 (《新疆中草药手册》)⑤治血小板减少性紫癜： 紫草二钱，海螵蛸五钱，茜草二钱。水煎服。 (《新疆中草药手册》)⑥治热疮： 紫草茸、黄连、黄柏、漏芦各半两，赤小豆、绿豆粉各一合。上药捣细，入麻油为膏，日三敷，常服黄连阿胶丸清心。 (《仁斋直指方》紫草膏)⑦治小儿胎毒，疥癣，两眉生疮，或延及遍身瘙痒，或脓水淋沥，经年不愈： 紫草、白芷各二钱，归身五钱，甘草一钱，麻油二两。同熬，白芷色黄为度，滤清，加白蜡、轻粉各二钱，取膏涂之。(《疡医大全》紫茸膏)⑧治火烫，发泡腐烂： 紫草一钱，当归五钱，麻油四两。上三味，同熬药枯，滤清去渣，将油再熬，加黄蜡五钱，熔化，倾入碗内，顿冷，涂之。 (《幼科金针》紫草润肌膏)⑨治痈疽便闭： 紫草、栝楼等分。新水煎服。 (《仁斋直指方》)⑩治小便卒淋： 紫草一两。为散，每食前用井华水服二钱。(《千金翼方》)(11)治血淋： 紫草、连翘、车前子各等分。水煎服。 (《证治准绳》)(12)治吐血衄血不大凶，亦不尽止，起居如故，饮食如常，一岁之间，或发二、三次，或发五、六次，久必成劳： 紫草、怀生地各四两，白果肉百个，茯苓、麦门冬各三两。煎膏，炼蜜收，每早、晚各服十余匙，白汤下。(《方脉正宗》)(13)治五疸热黄： 紫草三钱，茵陈草一两。水煎服。 (《本草切要》)(14)治赤游丹毒，红晕如云头： 用小锋刀或磁碗锋画去毒血，紫草五钱，鼠粘子一两。研细，水煎服。 (《本草汇言》)(15)治小儿白秃： 紫草煎汁涂之。 (《圣惠方》)(16)治豌豆疮，恶疮，癣： 紫草煎油涂之。(《医学入门》)(17)治恶虫咬： 油浸紫草涂之。 (《圣惠方》)"}]},{"ID":"20240611154555-46ezykl","Type":"NodeParagraph","Properties":{"id":"20240611154555-46ezykl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611154555-8rct1bz","Type":"NodeParagraph","Properties":{"id":"20240611154555-8rct1bz","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 1.治疗急慢性肝炎：用从紫草根中提取的紫草红(素)干燥粉末为熔质，以氢氧化钠溶液为溶剂，制成0.2%紫草注射液。肌肉注射，每日1-2次，每次2ml。计观察黄疸型传染性肝炎13例，均治愈；急性无黄痘型传染性肝炎157例，治愈139例，显效6例，好转12例；慢性肝炎 113例，治愈84例，显效 14例，好转2例，无效13例。此外，尚治疗肝硬化4例，亦取得一定疗效。"}]},{"ID":"20240611154555-ci3ib30","Type":"NodeParagraph","Properties":{"id":"20240611154555-ci3ib30","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.治疗肺结核合并血小板减少性紫癜：曾报告 1例，经一般中西综合治疗效果不显，改用大量紫草后获得效果。第1日用 1两，服后鼻衄即减；第2日加至2两，鼻衄完全停止；连用5剂，血小板计数增至170000／mm3，全身紫斑消退，病情转危为安。服药后有腹泻反应，但患者并无不适感。"}]},{"ID":"20240611154555-55q8bu6","Type":"NodeParagraph","Properties":{"id":"20240611154555-55q8bu6","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.治疗恶性葡萄胎并发子宫绒毛膜上皮癌：曾报告 1例，手术后X线摄片发现肺部有转移病灶，经 1个月观察，转移病灶渐见扩大，临床症状也日见加重。采用紫草根 1两，每日煎服 1剂，10天为一疗程。经四个疗程，临床症状大为减轻， X线复查病灶大部分消失。继续服紫草根 1个月，临床症状全部消失，小便妊娠反应阴性。"}]},{"ID":"20240611154555-j7687f8","Type":"NodeParagraph","Properties":{"id":"20240611154555-j7687f8","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.治疗婴儿皮炎、外阴湿疹、阴道炎及子宫颈炎：采用2%、10%、20%、40%紫草菜油浸剂，或用紫草乙醚提出物配成 1%菜油制剂，局部应用。"}]},{"ID":"20240611154555-ms19ei6","Type":"NodeParagraph","Properties":{"id":"20240611154555-ms19ei6","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.1.试治婴儿臀部皮炎100例，用药后无1例发生糜烂情况。"}]},{"ID":"20240611154555-y9gdbm4","Type":"NodeParagraph","Properties":{"id":"20240611154555-y9gdbm4","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.2.妇女尿生殖瘘病人，因经常漏尿而造成阴部的湿疹、糜烂、溃疡以及各种原因所致的阴道溢液加多，涂紫草油后3-5天左右即可见效。曾治疗28例，痊愈24例。"}]},{"ID":"20240611154555-2tjex6q","Type":"NodeParagraph","Properties":{"id":"20240611154555-2tjex6q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.3.用于阴道炎，一般在涂药后4-6天可以治愈，而且复发率很低。曾治疗234例，治愈率77.7%。"}]},{"ID":"20240611154555-icij10q","Type":"NodeParagraph","Properties":{"id":"20240611154555-icij10q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.4.子宫颈炎如并有盆腔炎或重度糜烂、充血，并有脓性分泌物者，易引起流血、感染及盆腔炎急性发作，可采用紫草油涂抹。根据病情轻重，连续1-3周，可使充血及脓性分泌物消失，直至痊愈。治疗182例，痊愈96例。紫草油的浓度愈高，效果愈好，增加浓度并无任何副作用。紫草油似无抑菌作用，其临床疗效的原理，需进一步研究。"}]},{"ID":"20240611154555-45kmgzd","Type":"NodeParagraph","Properties":{"id":"20240611154555-45kmgzd","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"5.治疗青年扁平疣及银屑病：用紫草的提取物紫草醌制成0.1%注射液，肌肉注射每次2ml；少数银屑病患者用0.05%紫草醌注射液行静脉注射，每次10ml。均每日1次。青年扁平疣23例，经治7-10次后，痊愈(自觉症状消失，皮疹全部或绝大部分消退)10例，效(症状减轻，皮疹明显变小变平或红斑变淡，鳞屑变薄)10例，无效(注射10次以上皮疹未见改善)3例。银屑病肌注治疗29例，经10-20次治后，治愈5例，显效15例，无效9例；静注治疗7例，经10次后治愈3例，显效 1例，无效3例。初步观察，对扁平疣效果确实，疗程明显缩短，且复发率低。而银屑病以进行期病变疗效较好。缺点为注射局部疼痛。 另曾有用紫草根20g加二甲基亚砜100ml，浸泡3-4天后取药液涂抹局部，每天 1-2次；治疗扁平疣20余例，一般经 1-2周即见扁平疣脱落或平复。"}]},{"ID":"20240611154555-eo9gyzr","Type":"NodeParagraph","Properties":{"id":"20240611154555-eo9gyzr","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"6.治疗玫瑰糠疹：用紫草0.5-1两(小儿2-5钱)，每日煎服 1剂，10日为一疗程。经一定间歇后可继续服用几个疗程。治疗70例，痊愈37例，进步25例，无效8例。平均服药9天，最多不超过2个月。"}]},{"ID":"20240611154555-zelrjqz","Type":"NodeParagraph","Properties":{"id":"20240611154555-zelrjqz","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"7.关于预防麻疹：紫草根预防麻疹，各地曾广泛试用，但用法不尽相同，效果亦很不一致。"}]},{"ID":"20240611154555-3ij8r0p","Type":"NodeParagraph","Properties":{"id":"20240611154555-3ij8r0p","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.用紫草根煎剂、丸剂及复方紫草根煎剂(紫草根、白术、木香)3种剂型口服。"}]},{"ID":"20240611154555-bnnmfzv","Type":"NodeParagraph","Properties":{"id":"20240611154555-bnnmfzv","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"主药紫草根的用量是：8.1. 6个月至1岁6分， 1岁以上至2岁8分，2岁以上每增加 1岁递增2分。 以上均为1日量，分3次服，连服4天。共观察6个月至8岁有麻疹接触史的散居小儿968人，发病者94人，占9.72%。3种剂型的效果无大差别。认为紫草根对预防麻疹的保护率为90.2%。"}]},{"ID":"20240611154555-z3a2k64","Type":"NodeParagraph","Properties":{"id":"20240611154555-z3a2k64","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.2.用33%紫草根糖浆，6个月至 1岁每次10ml，2-3岁20ml，4-6岁30ml。每隔日服2次，共服3日，计6次。曾对110个农村散居易感小儿，发给本糖浆预防，结果3例出疹，预防保护率为97.3%。另有用上述方法对农村散居易感小儿685人进行预防观察，其结果，服药后发病率由服药前的11.3%逐步下降为1.1%。凡未患过麻疹的小儿服药后绝大多数均获得免疫，对潜伏期或前驱期患者，服用后均缩短了病期，同时麻疹发出也快。"}]},{"ID":"20240611154555-252p133","Type":"NodeParagraph","Properties":{"id":"20240611154555-252p133","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.3.紫草根 1岁以下用1.5钱，2-8岁用2钱，9-12岁用2.5钱，加水100ml，煮沸3分钟，1天内分服，仅服1天。共观察散居儿童1480例，其中135O例平均观察2周均未见发疹，其他130例发疹者的临床症状亦较轻。"}]},{"ID":"20240611154555-qgrnp6z","Type":"NodeParagraph","Properties":{"id":"20240611154555-qgrnp6z","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.4.用1∶1的紫草茸、紫草皮和紫草根糖浆；1岁以内每次1ml，2-3岁2ml，4-6岁3ml，均日服3次，连服4天。观察4个月至16岁城市散居小儿1607人，结果以紫草根的效果最好，发病率为8.58%；紫草茸较差，发病串为15%；紫草皮无明显预防作用，服药后并有白细胞降低现象。"}]},{"ID":"20240611154555-f9jgbja","Type":"NodeParagraph","Properties":{"id":"20240611154555-f9jgbja","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.5.用33%紫草根溶液，每次15ml，日服2次，每周连服2天。于流行期间在6个托儿所，给2-6岁未患过麻疹的小儿133名作预防服药。结果服药后发病看112名，发病率占84.2%，其中并发肺炎者13名。"}]},{"ID":"20240611154555-jj9zne2","Type":"NodeParagraph","Properties":{"id":"20240611154555-jj9zne2","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.6.用紫草根2份，甘草 1份，共制成粉剂。6个月以上0.6g，2岁以上 1g，4岁以上1.5g，5-7岁2.5g。均日服3次，连服3天。于流行季节选择6个月至7岁的易感小儿471人(服药组258人，对照组213人)进行观察，结果服药组的发病率并末降低，对麻疹潜伏期、前驱期、并发症以及病情的轻重均无影响。"}]},{"ID":"20240611154555-9ol244q","Type":"NodeParagraph","Properties":{"id":"20240611154555-9ol244q","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.7.对6个发生麻疹流行而用紫草根作预防的集体儿童机构进行了调查。其中未患过麻疹的接触者(6个月至6岁)有499人，在这些接触者中服紫草根液的有310人，注射胎盘球蛋白的有61人，注射成人血的有63人，另65人未接受任何预防保护措施。结果发病总数为488人，占97%。服紫草根的310人中除 1名51/2月及 1名6个月的婴儿外，全部发病，发病时潜伏期未见延长，病情亦不见减轻，与未接受预防组无明显差别。服紫草根液的接触者，合并肺炎及支气管炎的人数与未接受预防组亦无显着差别。服紫草根液的迟早(与病人接触后)与发病轻重无明显关系，即使与病人第1次接触前即开始进行预防性服药，亦不能防止发病或减轻病情。"}]},{"ID":"20240611154555-trg0cds","Type":"NodeParagraph","Properties":{"id":"20240611154555-trg0cds","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"9.用100%紫草根煎剂和复方紫草根煎剂(紫草根3份，银花2份，甘草 1份)，根据剂量大小不同，分为3组。第1组每公斤体重用紫草根0.4g，第2组每公斤体重0.8g，第3组为复方煎剂组，紫草根用量亦为每公斤体重0.8g；均每日 1剂，分3次服，连服3日。共观察359人(年龄在5岁以内者占85%)，其中预防组152人，曾与麻疹病人接触者30名，结果发病看26名；对照组207人，与麻疹患者接触过者48名，发病47名。在发病的26名儿童中，有19名是在接触后4日内服紫草根的，说明即使在潜伏期早期服紫草根也未能预防麻疹。3组不同剂型及剂量，其发病率差别不大，并不能显示剂量与剂型对发病率有何影响。在应用紫草根作为预防剂之后，病程并无明显缩短，同时也有并发肺炎的病例。"}]},{"ID":"20240611154555-emh75ag","Type":"NodeParagraph","Properties":{"id":"20240611154555-emh75ag","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611154555-ahyw57d","Type":"NodeParagraph","Properties":{"id":"20240611154555-ahyw57d","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：紫草，其功长于凉血活血，利大小肠。故痘疹欲出未出，血热毒盛，大便闭涩者宜用之，已出而紫黑便切者亦可用。若已出而红活，及白陷大便利者，切宜忌之。故杨士瀛《直指方》云，紫草治痘，能导大便，使发出亦轻，得木香、白术佐之，尤为有益。又曾世荣《活幼心书》云，紫草性寒，小儿脾气实者犹可用，脾气虚者反能作泻。古方惟用茸，取其初得阳气，以类触类，所以用发痘疮，今人不达此理，一概用之，非矣。"}]},{"ID":"20240611154555-ck5qrxw","Type":"NodeParagraph","Properties":{"id":"20240611154555-ck5qrxw","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：紫草为凉血之要药，故主心腹邪热之气。五疸者，湿热在脾胃所成，去湿除热利窍，其疸自愈。邪热在内，能损中气，邪热散即能补中益气矣。苦寒性滑，故利九窍而通利水道也。腹肿胀满痛者，湿热瘀滞于脾胃，则中焦受邪而为是病，湿热解而从小便出，则前证自除也。合膏药疗小儿痘疮及面，皆凉血之效也。"}]},{"ID":"20240611154555-6dc26j7","Type":"NodeParagraph","Properties":{"id":"20240611154555-6dc26j7","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"3.《本草求原》：紫草，痘疹隐隐，欲出未出，色赤干桔，及已出而便闭、色紫黑者宜之，痘夹黑疔亦宜。若痘已齐布红活，二便通调，则改用紫草茸，，于血热未清，用以活血而寓升发之义也。若红活，二便滑，及白陷者，忌之。至灰滞而便滑，则又宜虫部之紫草茸，宜参观之。"}]},{"ID":"20240611154555-dqg640x","Type":"NodeParagraph","Properties":{"id":"20240611154555-dqg640x","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"4.《本草崇原集说》：时法每以紫草配为凉剂，解痘毒，率多寒中变证。惟士宗先用桂枝汤化太阳之气，气化则毒不留。又有桂枝汤加金银花、紫草等法。"}]},{"ID":"20240611154555-kqigdcb","Type":"NodeParagraph","Properties":{"id":"20240611154555-kqigdcb","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：紫草，气味苦寒，而色紫入血，故清理血分之热。古以治脏腑之热结，后人则专治痘疡，而兼疗癍疹，皆凉血清热之正旨。杨仁斋以治痈疡之便闭，则凡外疡家血分实热看，皆可用之。且一切血热妄行之实火病，及血痢、血痔、溲血、淋血之气壮邪实者，皆在应用之例。而今人仅以为痘家专药，治血热病者，治外疡者， 皆不知有此，疏矣。"}]},{"ID":"20240611154555-tvmccwz","Type":"NodeParagraph","Properties":{"id":"20240611154555-tvmccwz","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"6.《本经》：主心腹邪气，五疸，补中益气，利九窍，通水道。"}]},{"ID":"20240611154555-ve8fgsv","Type":"NodeParagraph","Properties":{"id":"20240611154555-ve8fgsv","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"7.《别录》：疗腹肿胀满痛。以合膏，疗小儿疮。"}]},{"ID":"20240611154555-00ipvjg","Type":"NodeParagraph","Properties":{"id":"20240611154555-00ipvjg","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：治恶疮、癣。"}]},{"ID":"20240611154555-s5ujtzl","Type":"NodeParagraph","Properties":{"id":"20240611154555-s5ujtzl","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"9.《本草图经》：治伤寒时疾，发疮疹不出者，以此作药使其发出。"}]},{"ID":"20240611154555-j4nwi7o","Type":"NodeParagraph","Properties":{"id":"20240611154555-j4nwi7o","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"10.《纲目》：治斑疹、痘毒，活血凉血，利大肠。"}]},{"ID":"20240611154555-1gvq280","Type":"NodeParagraph","Properties":{"id":"20240611154555-1gvq280","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"11.《医林纂要》：补心，缓肝，散瘀，活血。"}]},{"ID":"20240611154555-0iagykm","Type":"NodeParagraph","Properties":{"id":"20240611154555-0iagykm","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"12.《吉林中草药》：治便秘，尿血。"}]},{"ID":"20240611154555-e51cb6n","Type":"NodeParagraph","Properties":{"id":"20240611154555-e51cb6n","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"13.《陕西中草药》：治汤火伤，皮炎，湿疹，尿路感染。"}]},{"ID":"20240611154555-9laqbzy","Type":"NodeParagraph","Properties":{"id":"20240611154555-9laqbzy","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611154555-7k235c9","Type":"NodeParagraph","Properties":{"id":"20240611154555-7k235c9","updated":"20240611154555"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611154557-70io4a2","Type":"NodeThematicBreak","Properties":{"id":"20240611154557-70io4a2"}},{"ID":"20240611154559-t8a19tp","Type":"NodeParagraph","Properties":{"id":"20240611154559-t8a19tp"}}]}