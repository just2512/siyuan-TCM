{"ID":"20240205153818-s9s8xgw","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153818-s9s8xgw","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153818-s9s8xgw\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206093734-0cbphj4\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611154559-t8a19tp\u0026quot;,\u0026quot;scrollTop\u0026quot;:492,\u0026quot;focusId\u0026quot;:\u0026quot;20240625085244-3vm2s4f\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"180紫草","type":"doc","updated":"20240815103701"},"Children":[{"ID":"20240206093734-0cbphj4","Type":"NodeParagraph","Properties":{"id":"20240206093734-0cbphj4","updated":"20240206093742"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产东北地区、内蒙古等地。\n【性状】\t硬紫草：根呈圆锥形，扭曲，有分枝，长714cm，直径12cm。表面紫红色或紫黑色，粗糙有纵纹，皮部薄，易剥落。质硬而脆，易折断，断面皮部深紫色，木部较大，灰黄色。气特异，味酸、甜。\n软紫草：根呈不规则的长圆柱形，多扭曲，长720cm，直径12.5cm。表面紫红色或紫褐色，皮部疏松，呈条形片状，常10余层重叠，易剥落。顶端有的可见分歧的茎残基。体软，质松软，易折断，断面不整齐，木部较小，黄色或黄白色。气特异，咋做苦、涩。\n内蒙紫草：皮部略薄，常数层相叠，易剥离，质硬而脆，断面较整齐，木部较小。\n【性味】\t甘、咸、微酸，寒。\n【功效】\t凉血，活血，解毒透疹。用于血热毒盛、斑疹紫黑、麻疹不透、疮疡、湿疹、水火烫伤。清热凉血，用于麻疹，热病癍疹，湿疹，尿血，血淋，血痢，疮疡，丹毒，烧伤，热结便秘。"}]},{"ID":"20240206093735-qb4x4m3","Type":"NodeParagraph","Properties":{"id":"20240206093735-qb4x4m3","updated":"20240206093735"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206093735-ujjj4we.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205160346-lkwliuy","Type":"NodeParagraph","Properties":{"id":"20240205160346-lkwliuy","updated":"20240205160346"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫草-20240205160346-f2v7p9e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240625083605-jho59to","Type":"NodeParagraph","Properties":{"id":"20240625083605-jho59to","updated":"20240815092324"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240625083602-iqlz0gj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 446px;","style":"width: 436px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240625083425-7hzxdv2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 436px;\" parent-style=\"width: 446px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240625083709-to1ql94.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240815092618-tn45tyc","Type":"NodeParagraph","Properties":{"id":"20240815092618-tn45tyc","updated":"20240815102603"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Prop