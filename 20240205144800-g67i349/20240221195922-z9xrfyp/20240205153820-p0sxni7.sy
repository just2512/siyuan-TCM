583px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栀子 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栀子 12-20240821100414-x855gg4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 583px;\" parent-style=\"width: 593px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821100513-1kdd40w","Type":"NodeParagraph","Properties":{"id":"20240821100513-1kdd40w","updated":"20240821100513"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1185px;","style":"width: 1175px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栀子 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栀子 13-20240821100513-bbqxgxe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1175px;\" parent-style=\"width: 1185px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821095502-v8qclur","Type":"NodeParagraph","Properties":{"id":"20240821095502-v8qclur","updated":"20240821095502"}},{"ID":"20240821095502-bsjspw2","Type":"NodeParagraph","Properties":{"id":"20240821095502-bsjspw2","updated":"20240821095922"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"下图为栽培品种，重瓣栀子（观赏品种）"}]},{"ID":"20240821095510-qj1wr8m","Type":"NodeParagraph","Properties":{"id":"20240821095510-qj1wr8m","updated":"20240821095740"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栀子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栀子-20240821093335-2lv3e0m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 320px;","style":"width: 310px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栀子 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栀子 8-20240821095713-8v0apfi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 310px;\" parent-style=\"width: 320px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 360px;","style":"width: 350px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栀子 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栀子 9-20240821095740-4vm8gmk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 350px;\" parent-style=\"width: 360px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821095906-67lo7mq","Type":"NodeParagraph","Properties":{"id":"20240821095906-67lo7mq","updated":"20240821100020"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 683px;","style":"width: 673px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626084556-g4j64bq.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 673px;\" parent-style=\"width: 683px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 493px;","style":"width: 483px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栀子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栀子 10-20240821095906-zuxuz22.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 483px;\" parent-style=\"width: 493px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821093948-4omo0m4","Type":"NodeParagraph","Properties":{"id":"20240821093948-4omo0m4","updated":"20240821095933"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：有些栀子开的花是重瓣的，是园艺栽培出来的观赏花，药用还是尽量用原种栀子；"}]},{"ID":"20240612091731-ho2mphp","Type":"NodeThematicBreak","Properties":{"id":"20240612091731-ho2mphp"}},{"ID":"20240612091806-rc607yv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091806-rc607yv","updated":"20240612091810"},"Children":[{"Type":"NodeText","Data":"栀子《本草分经》"}]},{"ID":"20240612091806-zrat1ia","Type":"NodeParagraph","Properties":{"id":"20240612091806-zrat1ia","updated":"20240612091806"},"Children":[{"Type":"NodeText","Data":"苦寒入心，泻心肺之邪热，使之下行由小便出，解三焦郁火，最清胃脘之血，内热用仁，表热用皮。"}]},{"ID":"20240612091731-9y9c1dc","Type":"NodeThematicBreak","Properties":{"id":"20240612091731-9y9c1dc"}},{"ID":"20240612091755-pqouiig","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091755-pqouiig","updated":"20240612091758"},"Children":[{"Type":"NodeText","Data":"栀子《千金翼方》"}]},{"ID":"20240612091755-ejtm3cy","Type":"NodeParagraph","Properties":{"id":"20240612091755-ejtm3cy","updated":"20240612091755"},"Children":[{"Type":"NodeText","Data":"味苦，寒，大寒，无毒。主五内邪气，胃中热气，面赤酒 鼻，白癞赤癞疮疡。疗目热赤痛，胸心大小肠大热。心中烦闷，胃中热。一名木丹，一名越桃。生南阳川谷，九月采实，曝干。"}]},{"ID":"20240612091854-sskmytk","Type":"NodeThematicBreak","Properties":{"id":"20240612091854-sskmytk"}},{"ID":"20240612091855-l6prvz4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091855-l6prvz4","updated":"20240612091859"},"Children":[{"Type":"NodeText","Data":"栀子《本草备要》"}]},{"ID":"20240612091855-2d3qatp","Type":"NodeParagraph","Properties":{"id":"20240612091855-2d3qatp","updated":"20240612091855"},"Children":[{"Type":"NodeText","Data":"泻心、肺、三焦之火"}]},{"ID":"20240612091855-g2opjia","Type":"NodeParagraph","Properties":{"id":"20240612091855-g2opjia","updated":"20240612091855"},"Children":[{"Type":"NodeText","Data":"苦寒。轻飘象肺，色赤入心，泻心、肺之邪热，使之屈曲下行，从小便出（海藏曰∶或用为利小便药，非利小便，乃肺清则化行，而膀胱津液之府，得此气化而出也），而三焦之郁火以解，热厥（厥有寒、热二证）心痛以平（丹溪曰∶治心痛，当分新久。若初起因寒、因食，宜当温散。久则郁而成热，若用温剂，不助痛添病乎？古方多用栀子为君，热药为之响导，则邪易伏。此病虽日久，不食不死，若痛止恣食，病必再作也），吐衄、血淋、血痢之病以息（最清胃脘之血。炒黑末服，吹鼻治衄。《本草汇》曰∶治实火之血，顺气为先，气行则血自归经；治虚火之血，养正为先，气壮则自能摄血。丹溪曰∶治血不可单行、单止，亦不可纯用寒药。气逆为火，顺气即是降火）。治心烦懊 不眠（仲景用栀子豉汤。王好古曰∶烦者气也，燥者血也，故用栀子治肺烦，香豉治肾燥。亦用作吐药，以邪在上焦，吐之邪散，经所谓其高者因而越之也。按∶栀豉汤，吐虚烦客热；瓜蒂散，吐痰食宿寒），五黄（古方多用栀子、茵陈）五淋，亡血津枯，口渴目赤，紫癜白癞， 疮疡（皮腠，肺所主故也）。"}]},{"ID":"20240612091855-8ph87lw","Type":"NodeParagraph","Properties":{"id":"20240612091855-8ph87lw","updated":"20240612091855"},"Children":[{"Type":"NodeText","Data":"生用泻火，炒黑止血，姜汁炒止烦呕。内热用仁，表热用皮。"}]},{"ID":"20240612091904-ipjv6qd","Type":"NodeThematicBreak","Properties":{"id":"20240612091904-ipjv6qd"}},{"ID":"20240612091905-1onuk3y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091905-1onuk3y","updated":"20240612091909"},"Children":[{"Type":"NodeText","Data":"栀子《本经逢原》"}]},{"ID":"20240612091905-m385qsu","Type":"NodeParagraph","Properties":{"id":"20240612091905-m385qsu","updated":"20240612091905"},"Children":[{"Type":"NodeText","Data":"苦寒无毒。入吐剂取肥栀生用，入降火药以建栀、姜汁炒黑用。"}]},{"ID":"20240612091905-stwlf6d","Type":"NodeParagraph","Properties":{"id":"20240612091905-stwlf6d","updated":"20240612091905"},"Children":[{"Type":"NodeText","Data":"《本经》主五内邪气，胃中热气，面赤酒 ， 鼻白癞，赤癞疮疡。"}]},{"ID":"20240612091905-e5cy5kn","Type":"NodeParagraph","Properties":{"id":"20240612091905-e5cy5kn","updated":"20240612091905"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"栀子仁体性轻浮，专除心肺客热。《本经》治五内邪气，胃中热气等病，不独除心肺客热也。其去赤癞白癞疮疡者，诸痛痒疮，皆属心火也。炮黑则专泻三焦之火及痞块中火，最清胃脘之血，屈曲下行能降火，从小便中泄去。仲景治伤寒发汗吐下后虚烦不得眠，心中懊 ，栀子豉汤主之。因其虚故不用大黄，即亡血亡津。内生虚热，非此不去也。治身黄发热，用栀子柏皮汤。身黄腹满小便不利，用茵陈栀子大黄汤，取其利大小便，而蠲湿热也。古方治心痛恒用栀子，此为火气上逆，气不得下者设也，今人泥丹溪之说，不分寒热通用，虚寒何以堪之？大苦大寒能损伐胃气，不无减食泄泻之虞。故仲景云，病患旧有微溏者不可与之。世人每用治血，不知血寒则凝，反为败证。治实火之吐血顺气为先，气行则血自归经。治虚火之吐血养正为主，气壮则自能摄血，此治疗之大法，不可少违者也。"}]},{"ID":"20240612091841-0er8ijc","Type":"NodeThematicBreak","Properties":{"id":"20240612091841-0er8ijc"}},{"ID":"20240612091842-n8suovz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091842-n8suovz","updated":"20240612091849"},"Children":[{"Type":"NodeText","Data":"栀子《汤液本草》"}]},{"ID":"20240612091842-5vvi6c9","Type":"NodeParagraph","Properties":{"id":"20240612091842-5vvi6c9","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"气寒，味微苦。味苦，性大寒，味薄，阴中阳也。无毒。入手太阴经。"}]},{"ID":"20240612091842-v4l0nlz","Type":"NodeParagraph","Properties":{"id":"20240612091842-v4l0nlz","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"《象》云∶治心烦，懊 而不得眠，心神颠倒欲绝，血滞，小便不利。杵细用。"}]},{"ID":"20240612091842-h2vsomi","Type":"NodeParagraph","Properties":{"id":"20240612091842-h2vsomi","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"《心》云∶去心中客热，除烦躁，与豉同用。"}]},{"ID":"20240612091842-brmlic4","Type":"NodeParagraph","Properties":{"id":"20240612091842-brmlic4","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"《珍》云∶止渴，去心懊 烦躁。"}]},{"ID":"20240612091842-t833fvp","Type":"NodeParagraph","Properties":{"id":"20240612091842-t833fvp","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主五内邪气，胃中热气，面赤，酒 渣鼻，白癞、赤癞，疮疡。疗目热赤痛，胸心大小肠大热，心中烦闷，胃中热气。仲景用栀子治烦，胸为至高之分也。故易老云∶轻浮而象肺也，色赤而象火，故能泻肺中之火。《本草》不言吐，仲景用此为吐药。栀子本非吐药，为邪气在上，拒而不纳，故令上吐，邪因得以出。经曰∶其高者因而越之，此之谓也。或用栀子利小便，实非利小便，清肺也。肺气清而化，膀胱为津液之府，小便得此气化而出也。《本经》谓治大小肠热，辛与庚合，又与丙合，又能泄戊，其先入中州故也。入手太阴。栀子豉汤治烦躁，烦者，气也，躁者，血也。气主肺，血主肾。故用栀子，以治肺烦；用香豉，以治肾躁。躁者，懊 不得眠也。少气、虚满者，加甘草；若哕呕者，加生姜、橘皮。下后，腹满而烦，栀子浓朴枳实汤；下后，身热微烦，栀子甘草干姜汤。栀子大而长者，染色，不堪入药。皮薄而圆，七棱至九棱者，名山栀子，所谓越桃者是也。"}]},{"ID":"20240612091842-s1k9r75","Type":"NodeParagraph","Properties":{"id":"20240612091842-s1k9r75","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶仲景治伤寒，发汗吐下后，虚烦不得眠。若剧者，必反复颠倒，心中懊，以栀子豉汤治虚烦。故不用大黄，以有寒毒故也。栀子虽寒无毒，治胃中热气。既亡血，亡津液，脏腑无润养，内生虚热，非此不可除。又，治心经留热，小便赤涩，去皮山栀子（火煨），大黄、连翘、甘草（炙）等分，末之。水煎三钱匕，服之者无不效。"}]},{"ID":"20240612091842-65hky2x","Type":"NodeParagraph","Properties":{"id":"20240612091842-65hky2x","updated":"20240612091842"},"Children":[{"Type":"NodeText","Data":"仲景《伤寒论》及古今诸名医，治发黄皆用栀子、茵陈、香豉、甘草四物，等分，作汤饮之。又治大病起，劳复，皆用栀子、鼠矢等汤，并利小便而愈。其方极多，不可悉载。用仁，去心胸中热，用皮，去肌表热。"}]},{"ID":"20240612091824-gpgfcy6","Type":"NodeThematicBreak","Properties":{"id":"20240612091824-gpgfcy6"}},{"ID":"20240612091825-e57v222","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091825-e57v222","updated":"20240612091835"},"Children":[{"Type":"NodeText","Data":"栀子《证类本草》"}]},{"ID":"20240612091825-2glne6e","Type":"NodeParagraph","Properties":{"id":"20240612091825-2glne6e","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"味苦，寒、大寒，无毒。主五内邪气，胃中热气，面赤酒 ，渣鼻白癞，赤癞疮疡，疗目热赤痛，胸心大小肠大热，心中烦闷，胃中热气。一名木丹，一名越桃。生南阳川谷。九月采实，曝干。"}]},{"ID":"20240612091825-bayew0o","Type":"NodeParagraph","Properties":{"id":"20240612091825-bayew0o","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶解玉支毒。处处有。亦两、三种小异，以七棱者为良。经霜乃取之，今皆入染用于药甚稀。玉支，即羊踯躅也。臣禹锡等谨按药性论云∶山栀子，杀 虫毒。去热毒风，利五淋，主中恶，通小便，解五种黄病，明目，治时疾，除热及消渴口干，目赤肿病。"}]},{"ID":"20240612091825-mjcpdz5","Type":"NodeParagraph","Properties":{"id":"20240612091825-mjcpdz5","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"图经曰∶栀子，生南阳川谷，今南方及西蜀州郡皆有之。木高七、八尺。叶似李而浓硬，又似樗蒲子。二、三月生白花，花皆六出，甚芬香，俗说即西域詹匐也。夏秋结实如诃子状。"}]},{"ID":"20240612091825-hrjiyn2","Type":"NodeParagraph","Properties":{"id":"20240612091825-hrjiyn2","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"生青熟黄，中仁深红。九月采实，曝干。南方人竞种以售利。《货殖传》云∶卮茜千石，亦比千乘之家，言获利之博也。此亦有两、三种，入药者山栀子，方书所谓越桃也。皮薄而圆小，刻房七棱至九棱为佳。其大而长者，乃作染色。又谓之伏尸栀子，不堪入药用。张仲景《伤寒论》及古今诸名医治发黄，皆用栀子、茵陈、香豉、甘草等四物作汤饮。又治大病起劳复，皆用栀子、鼠矢等汤，并小利而愈。其方极多，不可悉载。栀子亦疗血痢挟毒热下者。"}]},{"ID":"20240612091825-yhu5yn6","Type":"NodeParagraph","Properties":{"id":"20240612091825-yhu5yn6","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"葛末服立愈。时行重病后劳发，水煮十枚饮汁，温卧彻汗乃愈。挟食加大黄别煮汁临熟纳之合饮，微利遂瘥。"}]},{"ID":"20240612091825-vw4p5ao","Type":"NodeParagraph","Properties":{"id":"20240612091825-vw4p5ao","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用颗大者，号曰伏尸栀子，无力。须要如雀脑，并须长有九路赤色者上。凡使，先去皮、须了，取仁，以甘草水浸一宿，漉出焙干，捣筛如赤金末用。食疗∶主喑哑，紫癜风，黄胆，积热心躁。又方∶治下鲜血。栀子仁烧灰，水和一钱匕，服之，量其大小多少服之。千金方∶治火疮未起。栀子仁灰，麻油和封，浓乃佳。已成疮，烧白糖灰粉之燥，即瘥。"}]},{"ID":"20240612091825-2tcjcoo","Type":"NodeParagraph","Properties":{"id":"20240612091825-2tcjcoo","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"肘后方∶治霍乱，心腹胀痛，烦满短气，未得吐下，若转筋。烧栀子二七枚研末，熟水调服。"}]},{"ID":"20240612091825-9ln4f3r","Type":"NodeParagraph","Properties":{"id":"20240612091825-9ln4f3r","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"梅师方∶治火丹毒，捣和水调敷之。又方∶治热毒下血，或因食物发动，以三十枚擘，水三升，煎取一升，去滓服。又方∶治热病新瘥，早起及多食后发。以十枚，水三升，煎取一升，去滓。温服。卧令微汗，若食不消，加大黄三两。又方∶治伤寒瘥后交接发动，因欲死，眼不开，不能语。栀子三十枚，水三升，煎取一升，服。又方∶治 犬咬。栀子皮烧末，石硫黄等分，同研为末，敷疮上，日三、二敷之，瘥。博济方治冷热气不和，不思饮食，或腹痛 剌。山栀子、川乌头等分，生捣为末，以酒糊丸如梧子大。每服十五丸，炒生姜汤下。"}]},{"ID":"20240612091825-dc2sris","Type":"NodeParagraph","Properties":{"id":"20240612091825-dc2sris","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"如小腹气痛。炒茴香、葱、酒任下二十丸。兵部手集∶治头痛不可忍，是多风痰所致。栀子末和蜜浓敷舌上，吐即止。胜金方∶治妇人临产痢。不限多少烧灰，细末。空心熟水调一匙头，甚者不过五服。孙尚药∶治伤寒下痢后更烦，按之心下KT 者，虚烦也。栀子十四枚，擘，豉四合，上二味以水四升，煎栀子取二升半，内豉更煎取一升，去滓，分再服，得吐余勿服，呕有痈脓者脓者不可服，呕脓尽乃愈。古今录验∶秦王散胃疸食多喜饮，栀子实主之。"}]},{"ID":"20240612091825-cyw2kxg","Type":"NodeParagraph","Properties":{"id":"20240612091825-cyw2kxg","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"丹房镜源栀子柔金。"}]},{"ID":"20240612091825-h0jjtoi","Type":"NodeParagraph","Properties":{"id":"20240612091825-h0jjtoi","updated":"20240612091825"},"Children":[{"Type":"NodeText","Data":"衍义曰∶栀子，仲景治发汗吐下后，虚烦不得眠。若剧者，必反复颠倒，心中懊 ，栀子豉汤治之。虚，故不用大黄，有寒毒故也。栀子虽寒无毒，治胃中热气，既亡血、亡津液，腑脏无润养，内生虚热，非此物不可去，张仲景《伤寒论》已着。又治心经留热，小便赤涩，去皮山栀子火炮、大黄、连翘、甘草炙，等分末之，水煎三、二钱匕，服之无不效。"}]},{"ID":"20240612091731-9pdd3v9","Type":"NodeThematicBreak","Properties":{"id":"20240612091731-9pdd3v9"}},{"ID":"20240612091744-egvghdh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091744-egvghdh","updated":"20240612091750"},"Children":[{"Type":"NodeText","Data":"栀子《本草求真》"}]},{"ID":"20240612091744-gjee7du","Type":"NodeParagraph","Properties":{"id":"20240612091744-gjee7du","updated":"20240612091744"},"Children":[{"Type":"NodeText","Data":"（灌木）治心肺热邪曲屈下行"}]},{"ID":"20240612091744-1foumi6","Type":"NodeParagraph","Properties":{"id":"20240612091744-1foumi6","updated":"20240612091744"},"Children":[{"Type":"NodeText","Data":"栀子（专入心肺）。味苦大寒。轻飘象肺。色赤入心。书言能泻心肺热邪。使之屈曲下从小便而出。（肺清则气化行。而膀胱津液。亦得由气化而化。故曰能利小便。究之皆泻肺心药耳。）而三焦之郁火以解。热厥心痛以平。（心痛因热。治当用此。但丹溪谓心痛久则郁而成热。此止就其大势论耳。若使痛喜手按。及痛喜饮热汤。其痛虽久。岂可以作热治乎？仍当以脏之阴阳及今所见之兼症兼脉。以分病之是寒是热。药之宜温宜凉。则得之矣。不可以痛久成热为泥。）吐衄血淋血痢之病以息。（栀子止治热郁之血耳。若经寒而血不归。不可妄用。本草汇曰。治实火之血。顺气为先。气行则血自归经。治虚火之血。养正为先。气壮则能自摄血。绣窃见今医士。不论寒热虚实。但见病血。即作热治。妄用栀连芩柏。殊为可惜。）"}]},{"ID":"20240612091744-0xkune7","Type":"NodeParagraph","Properties":{"id":"20240612091744-0xkune7","updated":"20240612091744"},"Children":[{"Type":"NodeText","Data":"且能治心烦懊。五黄五淋。亡血津枯。口噤目赤风疮等症。此数语业已道其大要矣。然更就其轻清以推。则浮而上者其治亦上。故能治心肺之火。而凡在上而见消渴烦燥。懊 不眠。头痛目赤肿痛等症。得此以除。（烦属气。燥属血。仲景栀子豉汤用栀子以治肺烦。用香豉以治肾燥。又用栀子作吐药。以散在膈之邪。即经所谓高者因而越之是也。故栀豉汤吐虚烦客热。瓜蒂散吐痰食宿食。）就其味苦而论。则苦而下者。其治亦下。故能泻肝肾膀胱之火。而凡在下而见淋闭便结。疸黄疝气。吐衄血痢。损伤血瘀等症。得此以泄。（易简方治衄血不止。用山栀子烧灰吹之。屡效。普济方治小便不通。用栀子仁十四个。独蒜头一个。食盐少许。捣贴脐及囊。良久即通。怪症奇方治吃饭直出。用栀子二十四个。微炒去皮。水煎服。食疗本草治下痢鲜血。用栀子仁烧灰。水服一钱匙。绣按此惟实邪实热则宜耳。）惟其气浮。故仲景用此以吐上焦之痰滞。惟其味苦能降。故丹溪用此以降内郁之邪耳！但治上宜生。治下宜炒宜黑。虽其上下皆入。而究则由自肺达下。故能旁及而皆治者也。此惟实邪实热则宜。若使并非实热。概为通用。恐不免有损食泄泻之虞矣。生用。炒黑止血。姜汁炒止烦呕。内热用仁。表热用皮。"}]},{"ID":"20240612091731-s17wj7x","Type":"NodeThematicBreak","Properties":{"id":"20240612091731-s17wj7x"}},{"ID":"20240612091732-uews3im","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091732-uews3im","updated":"20240612091737"},"Children":[{"Type":"NodeText","Data":"栀子《神农本草经读》"}]},{"ID":"20240612091732-z4bighq","Type":"NodeParagraph","Properties":{"id":"20240612091732-z4bighq","updated":"20240612091732"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主五内邪气，胃中热气，面赤，酒鼻，白癞，赤癞，疮疡。"}]},{"ID":"20240612091732-lojrurb","Type":"NodeParagraph","Properties":{"id":"20240612091732-lojrurb","updated":"20240612091732"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶栀子气寒，禀水气而入肾；味苦，得火味而入心。五内邪气，五脏受热邪之气也。胃中热气，胃经热烦懊不眠也。心之华在面，赤则心火盛也。鼻属肺，酒鼻，金受火克而色赤也。白癞为湿，赤癞为热，疮疡为心火。栀子下禀寒水之精，上结君火之实，能起水阴之气上滋，复导火热之气下行，故统主之。以上诸症，唯生用之，气味尚存，若炒黑则为死灰，无用之物矣。仲景栀子豉汤用之者，取其交媾水火、调和心肾之功；加香豉以引其吐，非栀子能涌吐也。俗本谓翻子生用则吐，炒黑则不吐，何其陋欤？按∶仲景云∶旧有微溏者，勿用。"}]},{"ID":"20240612091607-prn6l37","Type":"NodeThematicBreak","Properties":{"id":"20240612091607-prn6l37"}},{"ID":"20240612091619-m50vnqa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091619-m50vnqa","updated":"20240612091631"},"Children":[{"Type":"NodeText","Data":"栀子《本草纲目》"}]},{"ID":"20240612091619-jnk5o5o","Type":"NodeParagraph","Properties":{"id":"20240612091619-jnk5o5o","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"「释名」木丹、越桃、鲜支。"}]},{"ID":"20240612091619-cnphg8l","Type":"NodeParagraph","Properties":{"id":"20240612091619-cnphg8l","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"「气味」苦、寒、无毒。"}]},{"ID":"20240612091619-lpej6hj","Type":"NodeParagraph","Properties":{"id":"20240612091619-lpej6hj","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612091619-8ekmo6n","Type":"NodeParagraph","Properties":{"id":"20240612091619-8ekmo6n","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"1、鼻血。用山栀子烧灰吹入鼻中。屡试皆效。"}]},{"ID":"20240612091619-1ueroec","Type":"NodeParagraph","Properties":{"id":"20240612091619-1ueroec","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"2、小便不通。用栀子仁十四个、独头蒜一个、盐少许，俣捣烂贴脐上及阴囊，过一会即通。"}]},{"ID":"20240612091619-c1exzt9","Type":"NodeParagraph","Properties":{"id":"20240612091619-c1exzt9","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"3、血淋涩痛。用生栀子不、滑石等分，葱汤送服。"}]},{"ID":"20240612091619-kqliwhc","Type":"NodeParagraph","Properties":{"id":"20240612091619-kqliwhc","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"4、下泻鲜血。用栀子仁烧灰，水送服一匙。"}]},{"ID":"20240612091619-hpoyzfd","Type":"NodeParagraph","Properties":{"id":"20240612091619-hpoyzfd","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"5、热毒血痢。用栀子十四枚，去皮，捣为末，加蜜做成丸子，如梧子大。每服三丸，一天服三次，疗效显着。亦可用水煎服。"}]},{"ID":"20240612091619-zrmyf41","Type":"NodeParagraph","Properties":{"id":"20240612091619-zrmyf41","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"6、临产下简。用栀子烧过。研为末，米汤送服三钱。若上焦热，则连壳用。"}]},{"ID":"20240612091619-5rmllrx","Type":"NodeParagraph","Properties":{"id":"20240612091619-5rmllrx","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"7、热水肿。用栀子烧过，研为末，米汤送服三钱。若上焦热。则连壳用。"}]},{"ID":"20240612091619-7r8bdqp","Type":"NodeParagraph","Properties":{"id":"20240612091619-7r8bdqp","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"8、霍乱转筋，心腹胀满，吐泻不得。用栀子十几枚，烧过，研为末，熟酒送服。"}]},{"ID":"20240612091619-bdctaij","Type":"NodeParagraph","Properties":{"id":"20240612091619-bdctaij","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"9、胃脘火痛。用大栀子七枚（或九枚）炒焦，加水一碗，煎至七成，加入生姜汁饮下，痛立止。如此病是复发，还要加服玄明粉一钱，才能止痛。"}]},{"ID":"20240612091619-89xgeyj","Type":"NodeParagraph","Properties":{"id":"20240612091619-89xgeyj","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"10、热病食劳复（按：指热病之后因饮食不慎或房事不慎而使旧病复发）。用栀子三十枚，加水三升，煎取一升服下。须出微汗为好。"}]},{"ID":"20240612091619-c8lijiw","Type":"NodeParagraph","Properties":{"id":"20240612091619-c8lijiw","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"11、小儿狂躁（蓄热在下，身热狂躁，昏迷不食）。用栀子仁七枚、豆豉五钱，加水一碗，煎至七成服下，或吐或不吐，均有效。"}]},{"ID":"20240612091619-1yf5j1h","Type":"NodeParagraph","Properties":{"id":"20240612091619-1yf5j1h","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"12、眼来肠秘。用山栀子七个，钻孔煨熟，加水一程式，煎至半升，去渣，放入大黄三钱，温服。"}]},{"ID":"20240612091619-3c6q94v","Type":"NodeParagraph","Properties":{"id":"20240612091619-3c6q94v","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"13、风痰头痛。用栀子末和蜜浓敷舌上，得吐即止痛。"}]},{"ID":"20240612091619-sv2tbrq","Type":"NodeParagraph","Properties":{"id":"20240612091619-sv2tbrq","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"14、火焰丹毒。用栀子捣烂和水涂搽。"}]},{"ID":"20240612091619-24122s1","Type":"NodeParagraph","Properties":{"id":"20240612091619-24122s1","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"15、眉中练癣。用栀子烧过，研为末，调油敷涂。"}]},{"ID":"20240612091619-6cx6qwo","Type":"NodeParagraph","Properties":{"id":"20240612091619-6cx6qwo","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"16、伤折肿痛。用栀子、白面同捣烂，敷涂痛处，甚效。"}]},{"ID":"20240612091619-o0f81zx","Type":"NodeParagraph","Properties":{"id":"20240612091619-o0f81zx","updated":"20240612091619"},"Children":[{"Type":"NodeText","Data":"17、汤烫火烧。用栀子末和鸡蛋清调浓敷涂。"}]},{"ID":"20240612091715-7i6x69e","Type":"NodeThematicBreak","Properties":{"id":"20240612091715-7i6x69e"}},{"ID":"20240612091716-p3ddv3q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091716-p3ddv3q","updated":"20240612091723"},"Children":[{"Type":"NodeText","Data":"栀子《新修本草》"}]},{"ID":"20240612091716-bx23uxv","Type":"NodeParagraph","Properties":{"id":"20240612091716-bx23uxv","updated":"20240612091716"},"Children":[{"Type":"NodeText","Data":"味苦，寒、大寒，无毒。主五内邪气，胃中热气，面赤酒 鼻，白癞、赤癞，疮阳川谷。九月采实，曝干。"}]},{"ID":"20240612091716-mn1ovym","Type":"NodeParagraph","Properties":{"id":"20240612091716-mn1ovym","updated":"20240612091716"},"Children":[{"Type":"NodeText","Data":"解玉支毒。处处有，亦两三种小异，以七道者为良。经霜乃取之。今皆入染用，于药甚希。玉支即踯躅 也。"}]},{"ID":"20240612091702-8r0ro0k","Type":"NodeThematicBreak","Properties":{"id":"20240612091702-8r0ro0k"}},{"ID":"20240612091704-a2n1z3l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091704-a2n1z3l","updated":"20240612091709"},"Children":[{"Type":"NodeText","Data":"栀子《本草述钩元》"}]},{"ID":"20240612091704-1rq9ho7","Type":"NodeParagraph","Properties":{"id":"20240612091704-1rq9ho7","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"春荣秋瘁。入夏开花。白瓣黄蕊。随即结实。薄皮细仁。色深红。霜后收之。"}]},{"ID":"20240612091704-dkrbb5i","Type":"NodeParagraph","Properties":{"id":"20240612091704-dkrbb5i","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"苦寒。气薄味浓。轻清上行。气浮而味降。阳中阴也。入手太阴肺经血分。更入手少阴足阳明经。留皮泻肺火。去皮泻心火。主除五内邪气。胃中热气。去心中客热。烦躁懊。治热厥心痛头痛。解热郁。散结气热毒风。疗五种黄病。清胃脘血。及吐衄下血尿血。"}]},{"ID":"20240612091704-qbgaanw","Type":"NodeParagraph","Properties":{"id":"20240612091704-qbgaanw","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"散肝热血郁。并脐下血滞而小便不利。利五淋。治疝气汤火伤。除上焦虚热。疗风热。（洁古）治心经留热。小便赤涩。（宗）泻三焦之火。及痞块中火邪。最清胃脘之血。其性屈曲下行。能降火从小便中泄去。（丹溪）按痞块中火邪。乃郁也。由于气不行。而血随以凝也。用栀仁去皮。姜汁拌炒。假辛味冲折郁火。不为无功。立斋每合丹皮以清肝。凡心痛稍久。不宜温散。反助火邪。古方多用栀子以导热。药则邪易伏而病易退。（丹溪）伤寒发汗吐下后。虚烦不得眠。若剧者。必反复颠倒。心中懊。栀子豉汤主之。（仲景）凡亡血亡津液。脏腑无润养。内生虚热。非兹物不可去。（宗）栀豉治烦躁。烦者气也。"}]},{"ID":"20240612091704-36ne5oa","Type":"NodeParagraph","Properties":{"id":"20240612091704-36ne5oa","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"躁者血也。肺主气。肾主血。故用栀子以治肺烦。用香豉以治肾躁。（海藏）古今治发黄。"}]},{"ID":"20240612091704-f1vjyyc","Type":"NodeParagraph","Properties":{"id":"20240612091704-f1vjyyc","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"皆用栀豉茵陈甘草作汤饮。治大病后劳复。皆用栀子鼠矢等汤。利小便而愈。（颂）得故纸。能滋阴降火。清上固下。性虽寒而带补。（门）五脏诸气益少阴血。用栀子炒黑研末。"}]},{"ID":"20240612091704-54cstp1","Type":"NodeParagraph","Properties":{"id":"20240612091704-54cstp1","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"生姜同煎。饮之甚捷。（丹溪）用童便炒黑。能益少阴经血而治阴火。（门）同连翘麦冬灯心竹叶黄连甘草。能泻心经有余之火。加赤苓木通滑石泽泻。泻小肠火。同茵陈滑石车前子秦艽黄连连钱草苜蓿。治酒热发黄。胃脘火痛。大山栀子七枚或九枚。炒焦。水一盏。"}]},{"ID":"20240612091704-q4osqpx","Type":"NodeParagraph","Properties":{"id":"20240612091704-q4osqpx","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"煎七分。入生姜汁。饮之立止。复发者。必不效。用元明粉一钱服。立止。"}]},{"ID":"20240612091704-sfkqym3","Type":"NodeParagraph","Properties":{"id":"20240612091704-sfkqym3","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"〔论〕栀子味苦气寒。苦寒合则宜就下。但味浓而气薄。味从乎气者也。其气升浮。"}]},{"ID":"20240612091704-ypgo1e8","Type":"NodeParagraph","Properties":{"id":"20240612091704-ypgo1e8","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"故入手太阴肺及手少阴心。夫心肺合而上焦营诸阳。阳中有阴矣。栀子以苦寒气味。华实于大火之候。华色白者。金脏之气也。子色深赤者。火脏之血也。是非阳中有阴乎。（乘大火之候。吐花而结实。正效其金水之用于火者。心固火主。然离中有坎。所以主血。更得金为火妻。以孕水子。所以生血而气化愈清。）人身心肺为阳。阳中原有阴。其阳盛以伤阴者。"}]},{"ID":"20240612091704-uij87h7","Type":"NodeParagraph","Properties":{"id":"20240612091704-uij87h7","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"气伤而血随伤。血伤则热益郁。气益结。如他味止能清气。不能凉血。或即凉血。而不由清气以致之。犹未得如心肺合而营诸阳之义也。栀仁由寒气之轻清以至主气之肺。即有苦味之涌泄以至主血之心。心肺之热既清。则阳中有阴。而胃热自除矣。其治五种黄病。及亡血亡精劳复等证。皆不离胃之阴气而言。大抵上焦之阳。易伤其阴。阴不降。则阳益炽于上。此味除热。从气分入血。使阳中阴降。阴降而阳随之。故胃热散。即此便能清胃脘血。热炽而血污。热除则血清。又何血证之不能治乎。其治热厥心痛及头痛者。阴降而阳随也。其屈曲降火从小便出者。气化而血和也。其散肝热血郁者。由肺胃以及之也。其治疝者。即解郁热。"}]},{"ID":"20240612091704-dpemlck","Type":"NodeParagraph","Properties":{"id":"20240612091704-dpemlck","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"散结气。并入肝而效其用也。其治大小肠大热者。胃与大小肠相上下。况又为心肺二经之合也。（由上而及下。故云能泻三焦之火。）总之。他味降火。类多直折其阳。此独从阳中之阴以除热。使阴从阳和。故能透经脉。入密理。以纾其阳化。而尽其由上及下之用。所以破痞块中火。而又曰屈曲下行。非如他昧之降折。昔人遂并称其寒而能补也。但不可施于气虚之人耳。"}]},{"ID":"20240612091704-o71ek09","Type":"NodeParagraph","Properties":{"id":"20240612091704-o71ek09","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"缪氏。禀至苦大寒之气。损胃而伤血。凡脾胃虚弱。及血虚发热者。忌之。凡诸血证用之。"}]},{"ID":"20240612091704-siue888","Type":"NodeParagraph","Properties":{"id":"20240612091704-siue888","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"〔辨治〕长而大者。止用染色。不堪入药。皮薄而圆。七棱至九棱者。名山栀子。（即越桃也）胃热病在上者。带皮用。（丹溪）大率治上中焦病。连皮。或生或炒用。下焦病。"}]},{"ID":"20240612091704-um6bvj7","Type":"NodeParagraph","Properties":{"id":"20240612091704-um6bvj7","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"去皮。洗去黄浆。炒用。治血病及开郁止痛。并炒黑用。去心肝血热。酒炒黑用。殊效。"}]},{"ID":"20240612091704-ewfm22p","Type":"NodeParagraph","Properties":{"id":"20240612091704-ewfm22p","updated":"20240612091704"},"Children":[{"Type":"NodeText","Data":"不用皮。"}]},{"ID":"20240612091650-va8luc8","Type":"NodeThematicBreak","Properties":{"id":"20240612091650-va8luc8"}},{"ID":"20240612091651-gii1pit","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091651-gii1pit","updated":"20240612091656"},"Children":[{"Type":"NodeText","Data":"栀子《本草择要纲目》"}]},{"ID":"20240612091651-cp115h0","Type":"NodeParagraph","Properties":{"id":"20240612091651-cp115h0","updated":"20240612091651"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612091651-oq4gcxx","Type":"NodeParagraph","Properties":{"id":"20240612091651-oq4gcxx","updated":"20240612091651"},"Children":[{"Type":"NodeText","Data":"苦寒无毒．轻清上行．阳中阴也．入手太阴肺经．"}]},{"ID":"20240612091651-szl127i","Type":"NodeParagraph","Properties":{"id":"20240612091651-szl127i","updated":"20240612091651"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240612091651-6nihflt","Type":"NodeParagraph","Properties":{"id":"20240612091651-6nihflt","updated":"20240612091651"},"Children":[{"Type":"NodeText","Data":"五内邪气．胃中热气．心中烦闷．除时疾热利五淋．通小便．治心烦懊 不得眠．泻三焦火．清胃脘血．治热厥心痛．解热郁．行结气．祛肝胆屈曲之火使之下行．凡心痛稍久．若温散之．反助火邪．栀子泻三焦之火．清胃脘之血．使邪易伏而病易退也．然本草不言栀子能吐．而仲景用为吐药何也．盖栀子本非吐药．因邪气在上拒格而不纳食．令上吐则邪因以出．所谓高者越之也．又栀子非利小便之药．而本草言能通利小便者何也．盖膀胱津液之府．气化则能出焉．栀子能导肺邪．肺清则化行．乃辛与庚合．又与丙合．又能泄戊先入中州故也．故仲景治伤寒发汗吐下后虚烦不得眠若剧者．又反复颠倒心中懊 ．以栀子豉汤治之．因其虚．故不用大黄之寒而有毒．反用栀子之虽寒而无毒者．乃祛胃中之热气也．"}]},{"ID":"20240612091607-oytk37r","Type":"NodeThematicBreak","Properties":{"id":"20240612091607-oytk37r"}},{"ID":"20240612091603-lnnketo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091603-lnnketo","updated":"20240612091645"},"Children":[{"Type":"NodeText","Data":"栀子《医学入门》"}]},{"ID":"20240612091603-x3h4wom","Type":"NodeParagraph","Properties":{"id":"20240612091603-x3h4wom","updated":"20240612091603"},"Children":[{"Type":"NodeText","Data":"栀子苦寒泻肺火，更除胃热心烦 ，目赤鼻衄身发黄，止痢通淋消癞颗。"}]},{"ID":"20240612091603-ddo7ywk","Type":"NodeParagraph","Properties":{"id":"20240612091603-ddo7ywk","updated":"20240612091603"},"Children":[{"Type":"NodeText","Data":"形似酒栀。味薄。无毒。阴中阳也，入手太阴经。易老云∶轻浮而象肺，色赤而象火，故泻肺中之火。"}]},{"ID":"20240612091603-w3bfg40","Type":"NodeParagraph","Properties":{"id":"20240612091603-w3bfg40","updated":"20240612091603"},"Children":[{"Type":"NodeText","Data":"又除胃热呕哕发黄，及亡血亡津、中干内热。仲景治伤寒心下懊 、癫狂不得眠，用此吐之。因邪盛拒而不纳，吐则邪得以出，其实栀子非吐药，惟治心中烦闷耳。兼治风痰头眩，目赤面赤，鼻衄鼻 ，止痢通淋，白癞赤癞诸疮疡，亦泻肺心火耳。本经谓解大小肠热，肺清而气自顺化。治发黄者，亦除胃湿热耳。近有治阴火用童便炒黑，谓其能益少阴经血；得故纸能滋阴降火，清上固下，性虽寒而带补。《衍义》曰∶屈曲下行，降火开郁，能治块中之火。东垣云∶治脐下血滞结而不得小便。又曰∶凉心肾。是药乃上中下美剂，要之皆泻肺火，调肺气，滋肺源耳。紧小七棱者良。用仁去心胸热，用皮云肌表热，寻常生用。虚火童便炒七次至黑色。"}]},{"ID":"20240612091431-26nlteh","Type":"NodeThematicBreak","Properties":{"id":"20240612091431-26nlteh"}},{"ID":"20240612091439-knmml72","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091439-knmml72","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"《中国药典》：栀子"}]},{"ID":"20240612091439-cecn3fu","Type":"NodeParagraph","Properties":{"id":"20240612091439-cecn3fu","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612091439-i8k9c3p","Type":"NodeParagraph","Properties":{"id":"20240612091439-i8k9c3p","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" Zhī Zi"}]},{"ID":"20240612091439-d805666","Type":"NodeParagraph","Properties":{"id":"20240612091439-d805666","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612091439-0x9usl5","Type":"NodeParagraph","Properties":{"id":"20240612091439-0x9usl5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 黄栀子、黄果树、山栀子、红枝子"}]},{"ID":"20240612091439-te5m1ce","Type":"NodeParagraph","Properties":{"id":"20240612091439-te5m1ce","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612091439-1161100","Type":"NodeParagraph","Properties":{"id":"20240612091439-1161100","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" FRUCTUS GARDENIAE"}]},{"ID":"20240612091439-pwgourm","Type":"NodeParagraph","Properties":{"id":"20240612091439-pwgourm","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612091439-4abvvtd","Type":"NodeParagraph","Properties":{"id":"20240612091439-4abvvtd","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 本品为茜草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栀子"},{"Type":"NodeText","Data":"Gardenia jasminoides Ellis的干燥成熟"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"，其"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"也可入药。9～11 月果实成熟呈红黄色时采收，除去果梗及杂质，蒸至上汽或置沸水中略烫，取出，干燥。根夏秋采挖，洗净晒干。"}]},{"ID":"20240612091439-tlgerse","Type":"NodeParagraph","Properties":{"id":"20240612091439-tlgerse","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612091439-7s40kzq","Type":"NodeParagraph","Properties":{"id":"20240612091439-7s40kzq","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 本品呈长卵圆形或椭圆形，长1.5～3.5cm，直径1～1.5cm。表面红黄色或棕红色，具6条翅状纵棱，棱间常有1条明显的纵脉纹，并有分枝。顶端残存萼片，基部稍尖，有残留果梗。果皮薄而脆，略有光泽；内表面色较浅，有光泽，具2～3条隆起的假隔膜。种子多数，扁卵圆形，集结成团，深红色或红黄色，表面密具细小疣状突起。气微，味微酸而苦。"}]},{"ID":"20240612091439-odonxt0","Type":"NodeParagraph","Properties":{"id":"20240612091439-odonxt0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612091439-8y8ghzy","Type":"NodeParagraph","Properties":{"id":"20240612091439-8y8ghzy","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240612091439-ht6xasg","Type":"NodeParagraph","Properties":{"id":"20240612091439-ht6xasg","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612091439-lh0ecuc","Type":"NodeParagraph","Properties":{"id":"20240612091439-lh0ecuc","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栀子"},{"Type":"NodeText","Data":"：除去杂质，碾碎。"}]},{"ID":"20240612091439-dwn631w","Type":"NodeParagraph","Properties":{"id":"20240612091439-dwn631w","updated":"20240612091439"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒栀子"},{"Type":"NodeText","Data":"：取净栀子，照清炒法（附录Ⅱ D）炒至黄褐色。"}]},{"ID":"20240612091439-5mug1gv","Type":"NodeParagraph","Properties":{"id":"20240612091439-5mug1gv","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612091439-430bgte","Type":"NodeParagraph","Properties":{"id":"20240612091439-430bgte","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末红棕色。果皮石细胞类长方形；果皮纤维细长，梭形，直径约10μｍ，长约至 110μｍ，常交错、斜向镶嵌状排列； 含晶石细胞类圆形或多角形，直径17～31μｍ，壁厚，胞腔内含草酸钙方晶，直径约8μm。种皮石细胞黄色或淡棕色，长多角形、长方形或形状不规则，直径60～112μm，长至230μm，壁厚，纹孔甚大，胞腔棕红色。草酸钙簇晶直径19～34μｍ。"}]},{"ID":"20240612091439-vki0klg","Type":"NodeParagraph","Properties":{"id":"20240612091439-vki0klg","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.2g，加水5ml,置水浴中加热3 分钟，滤过。取滤液5 滴，置蒸发皿中，蒸干，加硫酸1 滴，即显蓝绿色，迅速变为褐色，继转为紫褐色。"}]},{"ID":"20240612091439-49ksj63","Type":"NodeParagraph","Properties":{"id":"20240612091439-49ksj63","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加75％乙醇10ml，置温水浴中浸 2小时，滤过，滤液作为供试品溶液。另取栀子苷对照品，加乙醇制成每1ml含4mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各 5μl，分别点于同一硅胶Ｇ薄层板上，以醋酸乙酯－丙酮－甲酸－水（5:5:1:1）为展开剂，展开，取出，晾干，喷以硫酸乙醇（5→10）溶液，在110℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240612091439-at9oupn","Type":"NodeParagraph","Properties":{"id":"20240612091439-at9oupn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240612091439-a73513k","Type":"NodeParagraph","Properties":{"id":"20240612091439-a73513k","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240612091439-v643gp8","Type":"NodeParagraph","Properties":{"id":"20240612091439-v643gp8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；乙腈-水（15:85）为流动相；检测波长为238nm。理论板数按栀子苷峰计算应不低于1500。"}]},{"ID":"20240612091439-haa410o","Type":"NodeParagraph","Properties":{"id":"20240612091439-haa410o","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"对照品溶液的制备 精密称取栀子苷对照品适量，加甲醇制成每1ml含30μg的溶液，即得。"}]},{"ID":"20240612091439-dklnhw5","Type":"NodeParagraph","Properties":{"id":"20240612091439-dklnhw5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品粉末0.1g[同时另取本品粉末测定水分（附录Ⅸ H 第一法）]，精密称定，置具塞锥形瓶中，精密加入甲醇25ml，密塞，称定重量，超声处理20分钟，放冷，再称定重量，用甲醇补足减失的重量，摇匀，滤过，精密量取续滤液10ml，置25ml量瓶中，加甲醇至刻度，摇匀，即得。"}]},{"ID":"20240612091439-4okf3ll","Type":"NodeParagraph","Properties":{"id":"20240612091439-4okf3ll","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取对照品溶液与供试品溶液各10μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240612091439-v8wd4h0","Type":"NodeParagraph","Properties":{"id":"20240612091439-v8wd4h0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含栀子苷（C17H24O10）不得少于1.8％。"}]},{"ID":"20240612091439-psiqhvr","Type":"NodeParagraph","Properties":{"id":"20240612091439-psiqhvr","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612091439-n4tul00","Type":"NodeParagraph","Properties":{"id":"20240612091439-n4tul00","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 归心、肺、三焦经。"}]},{"ID":"20240612091439-21w7c5f","Type":"NodeParagraph","Properties":{"id":"20240612091439-21w7c5f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612091439-3hoywyf","Type":"NodeParagraph","Properties":{"id":"20240612091439-3hoywyf","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612091439-9ulhb8g","Type":"NodeParagraph","Properties":{"id":"20240612091439-9ulhb8g","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612091439-vqth55p","Type":"NodeParagraph","Properties":{"id":"20240612091439-vqth55p","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 果实：泻火除烦，清热利尿，凉血解毒。用于热病心烦，黄疸尿赤，血淋涩痛，血热吐衄，目赤肿痛，火毒疮疡；外治扭挫伤痛。"}]},{"ID":"20240612091439-m4mgrln","Type":"NodeParagraph","Properties":{"id":"20240612091439-m4mgrln","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"根：泻火解毒，清热利湿，凉血散瘀。用于传染性肝炎，跌打损伤，风火牙痛。"}]},{"ID":"20240612091439-l7taj55","Type":"NodeParagraph","Properties":{"id":"20240612091439-l7taj55","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612091439-zhy67a5","Type":"NodeParagraph","Properties":{"id":"20240612091439-zhy67a5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 6～9g。外用生品适量，研末调敷。根1～2两。"}]},{"ID":"20240612091439-xjcajng","Type":"NodeParagraph","Properties":{"id":"20240612091439-xjcajng","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612091439-bt453fe","Type":"NodeParagraph","Properties":{"id":"20240612091439-bt453fe","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" （1）用于热病发热，心烦不宁等症。栀子善能泻火泄热而除烦。在外感热病的气分症初期，见有发热、胸闷、心烦等症，可用栀子配合豆豉，以透邪泄热、除烦解郁。如属一切实热火症而见高热烦燥、神昏谵语等症，可用本品配黄连等泻火而清邪热。"}]},{"ID":"20240612091439-55ntq9z","Type":"NodeParagraph","Properties":{"id":"20240612091439-55ntq9z","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（2）用于热毒、实火引起的吐血、鼻衄、尿血、目赤肿痛和疮疡肿毒等症。山栀又有凉血止血、清热解毒的作用，用治血热妄行，常与生地、侧柏叶、丹皮等配伍；治目赤肿痛，可与菊花、石决明等配伍；治疮疡肿毒，可与黄连、银花、连翘等同用。"}]},{"ID":"20240612091439-ja61g2h","Type":"NodeParagraph","Properties":{"id":"20240612091439-ja61g2h","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（3）本品又能泄热利湿，可用于湿热郁颉所致的黄疸、面目皮肤发黄、疲倦、饮食减少等症，常与黄柏、茵陈蒿等同用。又用生栀子研末，与面粉、黄酒调服，有消肿活络的作用，可用于跌仆损伤、扭挫伤、皮肤青肿疼痛等症，为民间常用的“吊筋药”，尤其适用于四肢关节附近的肌肉、肌腱损伤。"}]},{"ID":"20240612091439-64j23xd","Type":"NodeParagraph","Properties":{"id":"20240612091439-64j23xd","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（4）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栀子"},{"Type":"NodeText","Data":"，一名山栀，轻清上行，能泻肺火，去肌表热，在外感热病、表里有热之际，能起双解的作用；本品苦寒泄降，又能泄三焦火，凉血清心热，可用于热病心烦；血热妄行及热淋尿血等症。故山栀既能清气分热，又能清血分热。至于泄热利湿，可用治黄疸，也是它的特长。本品配黄芩，能泻肺火；再加淡豆豉，能双解表里之热，配以黄芩，能泻三焦火、清心热；配以生地、丹皮，能凉血止血，治血热妄行、吐衄尿血；配以黄柏、茵陈，能清热利湿，治湿热黄疸。过去在临床应用方面有山栀皮去肌表热、山栀仁清心热的用法，现在上海地区已予简化，均用整个栀子，不再分栀皮、栀仁。"}]},{"ID":"20240612091439-1cko0q8","Type":"NodeParagraph","Properties":{"id":"20240612091439-1cko0q8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612091439-ztwt4ug","Type":"NodeParagraph","Properties":{"id":"20240612091439-ztwt4ug","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612091439-u3m88z0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091439-u3m88z0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：栀子"}]},{"ID":"20240612091439-2gxfr2s","Type":"NodeParagraph","Properties":{"id":"20240612091439-2gxfr2s","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612091439-b81bmx5","Type":"NodeParagraph","Properties":{"id":"20240612091439-b81bmx5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" Zhī Zi"}]},{"ID":"20240612091439-q0hitm1","Type":"NodeParagraph","Properties":{"id":"20240612091439-q0hitm1","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612091439-cflrx4r","Type":"NodeParagraph","Properties":{"id":"20240612091439-cflrx4r","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 木丹（《本经》），鲜支（《上林赋》），卮子（《汉书》孟康注），支子（《本草经集注》），越桃（《别录》），山栀子（《药性论》），枝子（《唐本草》），小卮子（《本草原始》），黄鸡子（《广西中药志》），黄荑子（《闽东本草》），黄栀子（《江苏药材志》）。"}]},{"ID":"20240612091439-eimgzm0","Type":"NodeParagraph","Properties":{"id":"20240612091439-eimgzm0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612091439-lhf96fs","Type":"NodeParagraph","Properties":{"id":"20240612091439-lhf96fs","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612091439-q9vqjc4","Type":"NodeParagraph","Properties":{"id":"20240612091439-q9vqjc4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612091439-yylzy7x","Type":"NodeParagraph","Properties":{"id":"20240612091439-yylzy7x","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 为茜草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山栀"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。10月间果实成熟果皮虽黄色时采摘，除去果柄及杂质，晒干或烘干。亦可将果实放入沸水（略加明矾）中烫，或放入蒸笼内蒸半小时，取出，晒干。"}]},{"ID":"20240612091439-oh8pko4","Type":"NodeParagraph","Properties":{"id":"20240612091439-oh8pko4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612091439-3kvswtv","Type":"NodeParagraph","Properties":{"id":"20240612091439-3kvswtv","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 常生于低山温暖的疏林中或荒坡、沟旁、路边。分布江苏、浙江、安徽、江西、广东、广西、云南、贵州、四川、湖北、福建、台湾等地。主产浙江、江西、湖南、福建；此外，四川、湖北、云南、贵州、江苏、安徽、广东、广西、河南等地亦产。"}]},{"ID":"20240612091439-qo51whx","Type":"NodeParagraph","Properties":{"id":"20240612091439-qo51whx","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612091439-feih4w0","Type":"NodeParagraph","Properties":{"id":"20240612091439-feih4w0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 山栀（《药性论》），又名：林兰（《谢康乐集》）。"}]},{"ID":"20240612091439-z70axz8","Type":"NodeParagraph","Properties":{"id":"20240612091439-z70axz8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"常绿灌木，高0.5～2米，幼枝有细毛。叶对生或三叶轮生，革质，长圆状披针形或卵状披针形，长7～14厘米，宽2～5厘米，先端渐尖或短渐尖，全缘，两面光滑，基部楔形；有短柄；托叶膜质，基部合成一鞘。花单生于枝端或叶腋，大形，白色，极香；花梗极短，常有棱；萼管卵形或倒卵形，上部膨大，先端5～6裂，裂片线形或线状披针形；花冠旋卷，高脚杯状，花冠管狭圆柱形，长约3毫米，裂片5或更多，倒卵状长圆形；雄蕊6，着生花冠喉部，花丝极短或缺，花药线形；子房下位1室，花柱厚，柱头棒状。果倒卵形或长椭圆形，有翅状纵梭5～8条，长2.5～4.5厘米，黄色，果顶端有宿存花萼。花期5～7月。果期8～11月。"}]},{"ID":"20240612091439-ghm4vlg","Type":"NodeParagraph","Properties":{"id":"20240612091439-ghm4vlg","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"本植物的根（栀子花根）、叶（桅子叶）、花（栀子花）亦供药用，各详专条。"}]},{"ID":"20240612091439-1fpelt4","Type":"NodeParagraph","Properties":{"id":"20240612091439-1fpelt4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612091439-9giq936","Type":"NodeParagraph","Properties":{"id":"20240612091439-9giq936","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 干燥果实长椭圆形或椭圆形，长1～4.5厘米，粗0.6～2厘米。表面深红色或红黄色，具有5～8条纵棱。顶端残存萼片，另一端稍尖，有果柄痕。果皮薄而脆，内表面红黄色，有光泽，具2～3条隆起的假隔膜，内有多数种子，粘结成团。种子扁圆形，深红色或红黄色，密具细小疣状突起。浸入水中，可使水染成鲜黄色。气微，味淡微酸。以个小、完整、仁饱满、内外色红者为佳。个大、外皮棕黄色、仁较瘪、色红黄者质次。"}]},{"ID":"20240612091439-d8wefia","Type":"NodeParagraph","Properties":{"id":"20240612091439-d8wefia","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612091439-flruy7n","Type":"NodeParagraph","Properties":{"id":"20240612091439-flruy7n","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 小鼠急性腹腔注射半数致死量为27.45克/公斤，皮下注射为31.79克/公斤，与镇静有效量比较，安全指数较小。"}]},{"ID":"20240612091439-1rofcjk","Type":"NodeParagraph","Properties":{"id":"20240612091439-1rofcjk","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612091439-99nep3m","Type":"NodeParagraph","Properties":{"id":"20240612091439-99nep3m","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 含黄酮类栀子素、果胶、鞣质、藏红花素、藏红花酸、D-甘露醇、廿九烷、β-谷甾醇。另含多种具环臭蚁醛结构的甙：栀子甙、去羟栀子甙泊素-1-葡萄糖甙，格尼泊素-1-β-D-龙胆二糖甙及小量的山栀甙。"}]},{"ID":"20240612091439-r6afwrw","Type":"NodeParagraph","Properties":{"id":"20240612091439-r6afwrw","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612091439-ibp6e77","Type":"NodeParagraph","Properties":{"id":"20240612091439-ibp6e77","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" ①利胆作用"}]},{"ID":"20240612091439-t1g6za7","Type":"NodeParagraph","Properties":{"id":"20240612091439-t1g6za7","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"栀子水提取液及醇提取液给予家兔口服，对输胆管导出的胆汁量及固形成分无影响，但有人用同样制剂注射于家兔，15～30分钟胆汁分泌开始增加，持续1小时以上。给兔静脉注射藏红花素和藏红花酸钠后，胆汁分泌量增加。栀子水煎剂或冲服剂给人口服后作胆囊拍片，证明服药后20及40分钟胆囊有明显的收缩作用。家兔总输胆管结扎后，口服栀子水提取液则血中胆红素减少，用药愈多，减少愈显着（如结扎后每隔24小时口服1次，则结果甚为明显），尤其连续服用适量药物以后结扎，所得效果最佳，醇提取液亦具有相同的作用，但较水提取液作用稍弱。桅子醇提取液注射于家兔，2小时血中胆红素较对照组稍增加，6小时后较对照组低，24～48小时后明显减少，藏红花素及藏红花酸钠亦有同样作用。在总胆管结扎的家兔，注射醇提取液，24小时末梢淋巴液中胆红素减少 ，藏红花素及藏红花酸钠亦有同样作用。栀子可用于胆道炎症引起的黄疸。"}]},{"ID":"20240612091439-ry6r7l7","Type":"NodeParagraph","Properties":{"id":"20240612091439-ry6r7l7","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②镇静、降压作用"}]},{"ID":"20240612091439-6e2d7gc","Type":"NodeParagraph","Properties":{"id":"20240612091439-6e2d7gc","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"小白鼠皮下注射栀子流浸膏，使自发活动减少闭目、低头、肌肉松弛，并能对抗戊四氮的惊厥，而不能对抗士的宁的惊厥，但能减少其死亡率，以流浸膏灰分作对照则未见以上作用。也有用以消除失眠及过度疲劳者。栀子煎剂和醇提取液对麻醉或不麻醉猫、大白鼠和兔，不论口服或腹腔注射，均有持久性降压作用，挣脉住射降压迅速而维持时间短，其降压部位似在延脑副交感中枢。"}]},{"ID":"20240612091439-qjwbune","Type":"NodeParagraph","Properties":{"id":"20240612091439-qjwbune","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③抗微生物作用"}]},{"ID":"20240612091439-35x2nkm","Type":"NodeParagraph","Properties":{"id":"20240612091439-35x2nkm","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"栀子水漫液在试臂内对许兰氏黄癣菌，腹股沟表皮癣菌、红色表皮癣菌等多种真菌有抑制作用，其水煎剂15毫克/毫升能杀死钩端螺旋体，在体外，栀子煎剂能使血吸虫停止活动，煎剂对细菌生长无抑制作用。"}]},{"ID":"20240612091439-b24m63w","Type":"NodeParagraph","Properties":{"id":"20240612091439-b24m63w","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240612091439-uuih7jo","Type":"NodeParagraph","Properties":{"id":"20240612091439-uuih7jo","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"栀子醇提取液对家兔及大白鼠离体肠管平滑肌，低浓度兴奋，高浓度抑制。去羟栀子甙对小鼠有泻下作用，其提取物制成油膏，可加速软组织的愈合。"}]},{"ID":"20240612091439-qiat8qc","Type":"NodeParagraph","Properties":{"id":"20240612091439-qiat8qc","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612091439-oe4gb8b","Type":"NodeParagraph","Properties":{"id":"20240612091439-oe4gb8b","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 生栀子：筛去灰屑，拣去杂质，碾碎过筛；或剪去两端。山栀仁：取净栀子，用剪刀从中间对剖开，剥去外皮取仁。山桅皮：即生栀子剥下的外果皮。炒栀子：取碾碎的栀子，置锅内用文火炒至金黄色，取出，放凉。焦栀子：取碾碎的栀子，置锅内用武火炒至焦糊色，取出，放凉。栀子炭：取碾碎的栀子，置锅内用武火炒至黑褐色，但须存性，取出，放凉。"}]},{"ID":"20240612091439-axx1c3f","Type":"NodeParagraph","Properties":{"id":"20240612091439-axx1c3f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使栀子，先去皮须了，取人，以甘草水浸一宿，漉出焙干，捣筛如赤金末用。\""}]},{"ID":"20240612091439-shvv7aq","Type":"NodeParagraph","Properties":{"id":"20240612091439-shvv7aq","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612091439-qn03jk4","Type":"NodeParagraph","Properties":{"id":"20240612091439-qn03jk4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 入心、肝、肺、胃经。"}]},{"ID":"20240612091439-1ohhi57","Type":"NodeParagraph","Properties":{"id":"20240612091439-1ohhi57","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴经。\""}]},{"ID":"20240612091439-ugzcv1c","Type":"NodeParagraph","Properties":{"id":"20240612091439-ugzcv1c","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、肺、大小肠、胃、膀胱六经。\""}]},{"ID":"20240612091439-27cicc3","Type":"NodeParagraph","Properties":{"id":"20240612091439-27cicc3","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入肺、胃、肝、胆、三焦、胞络六经。\""}]},{"ID":"20240612091439-gk69czj","Type":"NodeParagraph","Properties":{"id":"20240612091439-gk69czj","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612091439-yiiky6e","Type":"NodeParagraph","Properties":{"id":"20240612091439-yiiky6e","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612091439-wetihdq","Type":"NodeParagraph","Properties":{"id":"20240612091439-wetihdq","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240612091439-x9zj98b","Type":"NodeParagraph","Properties":{"id":"20240612091439-x9zj98b","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"大寒，无毒。\""}]},{"ID":"20240612091439-j4u3iu1","Type":"NodeParagraph","Properties":{"id":"20240612091439-j4u3iu1","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③《医林纂要》：\"苦酸，寒。\""}]},{"ID":"20240612091439-nkhggu5","Type":"NodeParagraph","Properties":{"id":"20240612091439-nkhggu5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612091439-7aed7p5","Type":"NodeParagraph","Properties":{"id":"20240612091439-7aed7p5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 脾虚便溏者忌服。"}]},{"ID":"20240612091439-ob8ern7","Type":"NodeParagraph","Properties":{"id":"20240612091439-ob8ern7","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"吐血衄血，非阳火暴发者忌之。\""}]},{"ID":"20240612091439-08xzzwi","Type":"NodeParagraph","Properties":{"id":"20240612091439-08xzzwi","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"邪在表，虚火上升，二者禁用。\""}]},{"ID":"20240612091439-ptiwad0","Type":"NodeParagraph","Properties":{"id":"20240612091439-ptiwad0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612091439-oh6gf78","Type":"NodeParagraph","Properties":{"id":"20240612091439-oh6gf78","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 清热，泻火，凉血。治热病虚烦不眠，黄疸，淋病，消渴，目赤，咽痛，吐血，衄血，血痢，尿血，热毒疮疡，扭伤肿痛。"}]},{"ID":"20240612091439-ec2u003","Type":"NodeParagraph","Properties":{"id":"20240612091439-ec2u003","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五内邪气，胃中热气，面赤，酒疱皶鼻，白癞，赤癞，疮疡。\""}]},{"ID":"20240612091439-mwx7md0","Type":"NodeParagraph","Properties":{"id":"20240612091439-mwx7md0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"解踯躅毒。\""}]},{"ID":"20240612091439-2siex70","Type":"NodeParagraph","Properties":{"id":"20240612091439-2siex70","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"疗目热亦痛，胸心、大小肠大热，心中烦闷，胃中热气。\""}]},{"ID":"20240612091439-1tm9hy0","Type":"NodeParagraph","Properties":{"id":"20240612091439-1tm9hy0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"杀蟅虫毒，去热毒风，利五淋，主中恶，通小便，解五种黄病，明目，治时疾除热及消渴口干，目赤肿痛。\""}]},{"ID":"20240612091439-3mjm0ie","Type":"NodeParagraph","Properties":{"id":"20240612091439-3mjm0ie","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"主瘖哑，紫癜风，黄疸积热心躁。\""}]},{"ID":"20240612091439-b5zkho8","Type":"NodeParagraph","Properties":{"id":"20240612091439-b5zkho8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"疗心经客热，除烦躁，去上焦虚热，治风。\""}]},{"ID":"20240612091439-3tm9g1b","Type":"NodeParagraph","Properties":{"id":"20240612091439-3tm9g1b","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑦《药类法象》：\"治心烦懊憹而不得眠，心神颠倒欲绝，血滞而小便不利。\""}]},{"ID":"20240612091439-se4445a","Type":"NodeParagraph","Properties":{"id":"20240612091439-se4445a","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑧朱震亨：\"泻三焦火，清胃脘血，治热厥心痛，解热郁，行结气。\""}]},{"ID":"20240612091439-c9rclza","Type":"NodeParagraph","Properties":{"id":"20240612091439-c9rclza","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"治吐血、衄血、血痢、下血、血淋，损伤瘀血，及伤寒劳复，热厥头痛，疝气，汤火伤。\""}]},{"ID":"20240612091439-svrfvmn","Type":"NodeParagraph","Properties":{"id":"20240612091439-svrfvmn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑩《本草备要》：\"生用泻火，炒黑止血，姜汁炒治烦呕，内热用仁，表热用皮。\""}]},{"ID":"20240612091439-2mhmbef","Type":"NodeParagraph","Properties":{"id":"20240612091439-2mhmbef","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑾广州部队《常用中草药手册》：\"清热解毒，凉血泻火。治黄疸型肝炎，蚕豆黄，感冒高热，菌痢，肾炎水肿，鼻衄，口舌生疮，乳腺炎，疮疡肿毒。\""}]},{"ID":"20240612091439-bchly1q","Type":"NodeParagraph","Properties":{"id":"20240612091439-bchly1q","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612091439-pcbqy8i","Type":"NodeParagraph","Properties":{"id":"20240612091439-pcbqy8i","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240612091439-286i547","Type":"NodeParagraph","Properties":{"id":"20240612091439-286i547","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612091439-2hv4h2r","Type":"NodeParagraph","Properties":{"id":"20240612091439-2hv4h2r","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" ①治伤寒发汗、吐。下后，虚烦不得眠，心中懊憹：栀子十四个（剖），香豉四合（绵裹）。上二味，以水四升，先煮柜子得二升半，纳豉，煮取一升半，去滓，分为二服。温进一服，得吐者止后服。（《伤寒论》栀子豉汤）"}]},{"ID":"20240612091439-6s2tkwp","Type":"NodeParagraph","Properties":{"id":"20240612091439-6s2tkwp","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②治伤寒大病瘥后劳复者：枳实三枚（炙），栀子十四个（剖），豉一升（绵裹）。上三味，以清浆水七升，空煮取四升，内枳实、栀子，煮取二升，下豉，更煮五、六沸，去滓，温分再服，覆令微似汗。若有宿食者，内大黄如博棋子五、六枚。（《伤寒论》枳实栀子豉汤）"}]},{"ID":"20240612091439-je3lk9a","Type":"NodeParagraph","Properties":{"id":"20240612091439-je3lk9a","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③治伤寒身黄发热：肥栀子十五个（剖），甘草一两（炙），黄柏二两。上三味，以水四升，煮取一升半，去滓，分温再服。（《伤寒论》栀子柏皮汤）"}]},{"ID":"20240612091439-yekh27m","Type":"NodeParagraph","Properties":{"id":"20240612091439-yekh27m","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"④治湿热黄疸：山栀四钱，鸡骨草、田基黄各一两。水煎，日分三次服。（《广西中草药》）"}]},{"ID":"20240612091439-swwd0mn","Type":"NodeParagraph","Properties":{"id":"20240612091439-swwd0mn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑤治尿淋，血淋：鲜栀子二两，冰糖一两。煎服。（《闽东本草》）"}]},{"ID":"20240612091439-lo64jui","Type":"NodeParagraph","Properties":{"id":"20240612091439-lo64jui","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑥治小便不通：栀子仁二七枚，盐花少许，独颗蒜一枚。上捣烂，摊纸花上贴脐，或涂阴囊上，良久即通。（《普济方》）"}]},{"ID":"20240612091439-g3kkjsr","Type":"NodeParagraph","Properties":{"id":"20240612091439-g3kkjsr","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑦治急性胃肠炎，腹痛，上吐下泻：山栀三钱，盘柱南五味（紫金皮）根五钱，青木香二钱。上药炒黑存性，加蜂蜜五钱。水煎，分二次服。（《单方验方调查资料选编》）"}]},{"ID":"20240612091439-qyyn2o9","Type":"NodeParagraph","Properties":{"id":"20240612091439-qyyn2o9","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑧治口疮、咽喉中塞痛，食不得：大青四两，山栀子、黄柏各一两，白蜜半斤。上切，以水三升，煎取一升，去滓，下蜜更煎一两沸，含之。（《普济方》栀子汤）"}]},{"ID":"20240612091439-ie52ugq","Type":"NodeParagraph","Properties":{"id":"20240612091439-ie52ugq","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑨治目赤：取山栀七枚，钻透，入煻灰火煨熟，以水一升半，煎至八合，去滓，人大黄末三钱匕，搅匀，食后旋旋温服。（《圣济总录》栀子汤）"}]},{"ID":"20240612091439-r17ldiy","Type":"NodeParagraph","Properties":{"id":"20240612091439-r17ldiy","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑩治胃脘火痛，大山栀子七枚或九枚，炒焦，水一盏，煎七分，入生姜汁饮之。（《丹溪纂要》）"}]},{"ID":"20240612091439-dl3f4tc","Type":"NodeParagraph","Properties":{"id":"20240612091439-dl3f4tc","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑾治鼻中衄血：山栀子烧灰吹之。（《简易方论》）"}]},{"ID":"20240612091439-ftjmo5s","Type":"NodeParagraph","Properties":{"id":"20240612091439-ftjmo5s","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑿治肺风鼻赤酒齄：老山栀为末，黄蜡等分溶和。为丸弹子大。空心茶、酒嚼下。忌酒、炙煿。（《本事方》）"}]},{"ID":"20240612091439-6n0aims","Type":"NodeParagraph","Properties":{"id":"20240612091439-6n0aims","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒀治赤白痢并血痢：山栀子仁四七枚。锉，以浆水一升半，煎至五合，去滓。空心食前分温二服。（《圣济总录》栀子仁汤）"}]},{"ID":"20240612091439-1v7tr5d","Type":"NodeParagraph","Properties":{"id":"20240612091439-1v7tr5d","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒁治热水肿：山栀子五钱，木香一钱半，白术二钱半。细切，水煎服。（《丹溪心法》）"}]},{"ID":"20240612091439-t6o1pqw","Type":"NodeParagraph","Properties":{"id":"20240612091439-t6o1pqw","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒂治妇人子肿湿多：炒山栀子一合。为末，米饮吞下，或丸服。（《丹溪心法》）"}]},{"ID":"20240612091439-iyrwtw2","Type":"NodeParagraph","Properties":{"id":"20240612091439-iyrwtw2","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒃治折伤肿痛：栀子、白面同捣，涂之。（《濒湖集简方》）"}]},{"ID":"20240612091439-0qqjt0f","Type":"NodeParagraph","Properties":{"id":"20240612091439-0qqjt0f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒄治火丹毒：栀子，捣和水调敷之。（《梅师集验方》）"}]},{"ID":"20240612091439-gq9dgau","Type":"NodeParagraph","Properties":{"id":"20240612091439-gq9dgau","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒅治火疮未起：栀子仁灰，麻油和封，惟厚为佳。（《千金方》）"}]},{"ID":"20240612091439-egno25w","Type":"NodeParagraph","Properties":{"id":"20240612091439-egno25w","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒆治疮疡肿痛：山栀、蒲公英，银花各四钱。水煎，日分三次服。另取生银花藤适量，捣烂，敷患处。（《广西中草药》）"}]},{"ID":"20240612091439-14df54l","Type":"NodeParagraph","Properties":{"id":"20240612091439-14df54l","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⒇治烧伤：栀子末和鸡子清浓扫之。（《救急方》）"}]},{"ID":"20240612091439-3i06u2f","Type":"NodeParagraph","Properties":{"id":"20240612091439-3i06u2f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（21）血淋涩痛。用生栀子末、滑石等分，葱汤送服。"}]},{"ID":"20240612091439-d3hibvq","Type":"NodeParagraph","Properties":{"id":"20240612091439-d3hibvq","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（22）下泻鲜血。用栀子仁烧灰，水送服一匙。"}]},{"ID":"20240612091439-q33gylh","Type":"NodeParagraph","Properties":{"id":"20240612091439-q33gylh","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（23）热毒血痢。用栀子十四枚，去皮，捣为末，加蜜做成丸子，如梧子大。每服三丸，一天服三次，疗效显著。亦可用水煎服。"}]},{"ID":"20240612091439-sdtxheu","Type":"NodeParagraph","Properties":{"id":"20240612091439-sdtxheu","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（24）临产下简。用栀子烧过。研为末，米汤送服三钱。若上焦热，则连壳用。"}]},{"ID":"20240612091439-gglml0f","Type":"NodeParagraph","Properties":{"id":"20240612091439-gglml0f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（25）霍乱转筋，心腹胀满，吐泻不得。用栀子十几枚，烧过，研为末，熟酒送服。"}]},{"ID":"20240612091439-2ikny21","Type":"NodeParagraph","Properties":{"id":"20240612091439-2ikny21","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（26）热病食劳复（按：指热病之后因饮食不慎或房事不慎而使旧病复发）。用栀子三十枚，加水三升，煎取一升服下。须出微汗为好。"}]},{"ID":"20240612091439-tdavxtr","Type":"NodeParagraph","Properties":{"id":"20240612091439-tdavxtr","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（27）小儿狂躁（蓄热在下，身热狂躁，昏迷不食）。用栀子仁七枚、豆豉五钱，加水一碗，煎至七成服下，或吐或不吐，均有效。"}]},{"ID":"20240612091439-pg27o9m","Type":"NodeParagraph","Properties":{"id":"20240612091439-pg27o9m","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（28）眼来肠秘。用山栀子七个，钻孔煨熟，加水一程式，煎至半升，去渣，放入大黄不三钱，温服。"}]},{"ID":"20240612091439-db9jz38","Type":"NodeParagraph","Properties":{"id":"20240612091439-db9jz38","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（29）风痰头痛。用栀子末和蜜浓敷舌上，得吐即止痛。"}]},{"ID":"20240612091439-g88zqu2","Type":"NodeParagraph","Properties":{"id":"20240612091439-g88zqu2","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（30）火焰丹毒。用栀子捣烂和水涂搽。"}]},{"ID":"20240612091439-gkwpg47","Type":"NodeParagraph","Properties":{"id":"20240612091439-gkwpg47","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"（31）眉中练癣。用栀子烧过，研为末，调油敷涂。"}]},{"ID":"20240612091439-pqwsqpz","Type":"NodeParagraph","Properties":{"id":"20240612091439-pqwsqpz","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612091439-4k9h7zx","Type":"NodeParagraph","Properties":{"id":"20240612091439-4k9h7zx","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" ①治疗急性黄疸型肝炎"}]},{"ID":"20240612091439-r42qvsk","Type":"NodeParagraph","Properties":{"id":"20240612091439-r42qvsk","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"取山栀制成10％及50％两种煎剂，每天3次饭后服用。一部分病人用10％煎剂每次10毫升，以后逐渐递增至50毫升；另一部分病人用50％煎剂，每次10～15毫升。共治19例，7例痊愈，10例接近痊愈。住院9～63天不等，平均30.3天。"}]},{"ID":"20240612091439-uedzg3h","Type":"NodeParagraph","Properties":{"id":"20240612091439-uedzg3h","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②治疗扭挫伤"}]},{"ID":"20240612091439-ye3uz0j","Type":"NodeParagraph","Properties":{"id":"20240612091439-ye3uz0j","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"将山栀子捣碎，研成粗粉，以温水调成糊状，加入少许酒精，包敷伤处。一般3～5天更换1次，如肿胀明显可隔天更换1次。骨折者不宜使用，脱臼者应先整复后再用。如有肢体麻痹，应配合理疗及针灸治疗。治疗407例，24小时内疼痛消失者328例；48小时内消失者66例；72小时内消失者13例。疼痛平均消失时间为30小时。肿胀消退时间平均为2.5天；血肿吸收时间平均为7.8天；功能恢复时间平均为5.1天。或用黄栀子、明乳香加适量黄酒，搅拌后放锅内蒸成糊膏状，待微温时敷于患部，厚度以1～1.5厘米为宜。用时先在局部涂凡士林1层，然后再敷药，上盖油纸，绷带包扎。间隔2～3天换药。治疗56例，除2例疗效不佳外，54例均治愈。亦可用黄栀子粉2两，面粉1两，鸡蛋1个，烧酒适量，调成糊状敷于局部，待药干后更换新药。一般在敷药2次后即见效果。"}]},{"ID":"20240612091439-0zsopr4","Type":"NodeParagraph","Properties":{"id":"20240612091439-0zsopr4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③用于止血"}]},{"ID":"20240612091439-gdfgdvq","Type":"NodeParagraph","Properties":{"id":"20240612091439-gdfgdvq","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"取黄栀子粉100克，以20％明肢液调成膏状，烘干碾成100号细粉，再加适量苯甲酸，高压消毒备用。对一般上消化道出血每次服3～6克，每日3次。亦可用作局部止血剂。"}]},{"ID":"20240612091439-u2rtrbd","Type":"NodeParagraph","Properties":{"id":"20240612091439-u2rtrbd","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612091439-x2noche","Type":"NodeParagraph","Properties":{"id":"20240612091439-x2noche","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义》：\"仲景治（伤寒）发汗吐下后，虚烦不得眠；若剧者，必反复颠倒，心中懊憹，栀子豉汤治之。虚故不用大黄，有寒毒故也。栀子虽寒无毒，治胃中热气，既亡血、亡津液，腑脏无润养，内生虚热，非此物不可去。又治心经留热，小便亦涩，用去皮山栀子、火煨大黄、连翘、甘草（炙），等分，末之，水煎三钱服，无不利也。\""}]},{"ID":"20240612091439-v9i2xgn","Type":"NodeParagraph","Properties":{"id":"20240612091439-v9i2xgn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"②《丹溪心法》：\"山栀子仁，大能降火，从小便泄去。其性能屈曲下降，入所不知。亦治痞块中火邪。\"\"大凡心膈之痛，须分新久。若明知身受寒气、口吃寒物而得病者，于初得之时，当与温散或温利之药。若曰病得之稍久则成郁，久郁则蒸热，热久必生火。《原病式》中备言之矣，着欲行温散温利，宁无助火添病耶！古方中多以山栀子为热药之向导，则邪易伏、病易退、正易复而病安。\""}]},{"ID":"20240612091439-6j991v2","Type":"NodeParagraph","Properties":{"id":"20240612091439-6j991v2","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"③《汤液本草》：\"或用栀子利小便，实非利小便，清肺也，肺气清而化，膀胱为津液之府，小便得此气化而出也。栀子豉汤治烦躁，烦者气也，躁者血也，气主肺，血主肾，故用栀子以治肺烦，用香豉以治肾躁。躁者，懊憹不得眠也。\""}]},{"ID":"20240612091439-fyovfz3","Type":"NodeParagraph","Properties":{"id":"20240612091439-fyovfz3","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"栀子，清少阴之热，则五内邪气自去，胃中热气亦除。面赤酒疱齄鼻者，肺热之候也，肺主清肃，酒热客之，即见是证，于开窍之所延及于面也，肺得苦寒之气，则酒热自除而面鼻赤色皆退矣。其主赤白癞疮疡者，即诸痛痒疮疡皆属心火之谓。疗目赤热痛，及胸、心、大小肠大热，心中烦闷者，总除心、肺二经之火热也。此药味苦气寒，泻一切有余之火，故能主如上诸证。\"\"栀子禀至苦大寒之气，苦寒损胃而伤血，凡脾胃虚弱者忌之，血虚发热者忌之。性能泻有余之火，心肺无邪热者不宜用；小便不通，由于膀胱虚无气以化，而非热结小肠者不宜用；疮疡因气血虚，不能收敛，则为久冷败疮，非温暖补益之剂则不愈，此所谓既溃之后，一毫寒药不可用是也。世人又以治诸血证，不知血得热则行，得寒则凝，瘀血凝结于中，则反致寒热，或发热劳嗽，饮食减少，为难疗之病，凡治吐血法，当以顺气为先，盖血随气而行，气降则火降，火降则血自归经。不求其止而止矣。此治疗之要法，不可违也。\""}]},{"ID":"20240612091439-7iemqmn","Type":"NodeParagraph","Properties":{"id":"20240612091439-7iemqmn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"栀子，若用佐使，治有不同：加茵陈除湿热疸黄，加豆豉除心火烦躁，加厚朴、枳实可除烦满，加生姜、陈皮可除呕哕，同元胡破热滞瘀血腹痛。\""}]},{"ID":"20240612091439-zslewbf","Type":"NodeParagraph","Properties":{"id":"20240612091439-zslewbf","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑥《本草通玄》：\"仲景多用栀子茵陈，取其利小便而蠲湿热也。古方治心痛，每用栀子，此为火气上逆，不得下降者设也。（若）泥丹溪之说，不分寒热，通用栀子，属寒者何以堪之。\""}]},{"ID":"20240612091439-x87imh8","Type":"NodeParagraph","Properties":{"id":"20240612091439-x87imh8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑦《本草崇原》：\"言栀子生用则吐，炒黑则不吐，且以栀子豉汤为吐剂，愚每用生栀子及栀子豉汤，并未曾吐。\""}]},{"ID":"20240612091439-lvj1g8h","Type":"NodeParagraph","Properties":{"id":"20240612091439-lvj1g8h","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑧《得配本草》：\"山栀，得滑石治血淋溺闭，得良姜治寒热腹痛，得柏皮治身热发黄，配连翘治心经留热（心热则赤淋），佐柴胡、白芍治肝胆郁火，使生地、丹皮治吐衄不止。\"\"上焦、中焦连壳，下焦去壳，洗去黄浆炒用，泻火生用，止血炒黑，内热用仁，表热用皮，淋症童便炒，退虚火盐水炒，劫心胃火痛姜汁炒，热痛乌药拌炒，清胃血蒲黄炒。\"\"山栀、丹皮、白芍、龙胆，皆泻肝家之火，其中却自有别，盖肝喜散，遏之则劲，宜用栀子以清其气，气清火亦清，肝得辛为补，丹皮之辛，从其性以醒之，是即为补，肝受补，气展而火亦平，肝气过散，宜白芍制之，平其性即所以泻其火，使之不得自逞，火盛肝气必实，龙胆苦以泄其气，寒以制其火，故非实，胆草不用，如不审其究竟而混投之，是伐其生生之气，即使火气悉除，而人已惫矣。\""}]},{"ID":"20240612091439-5ba3see","Type":"NodeParagraph","Properties":{"id":"20240612091439-5ba3see","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"⑨《本草思辨录》：\"栀子，其治在心、肝、胃者多，在肺者少。苦寒涤热，而所涤为瘀郁之热，非浮散之热，亦非坚结之热。能解郁不能攻坚，亦不能平逆，故阳明之腹满有燥屎，肺病之表热咳逆，皆非其所司。独取其秉肃降之气以敷条达之用，善治心烦与黄疸耳。心烦或懊憹或结痛，黄疸或寒热不食或腹满便赤，皆郁也。心烦心下濡者为虚，胸中室者为实。实与虚皆汗吐下后余邪留踞，皆宜吐去其邪。栀子解郁而性终下行，何以能吐?协以香豉，则一升一降，邪不任受则吐。黄疸之瘀热在表，其本在胃，栀子入胃涤热下行，更以走表利便之茵陈辅之，则瘀消热解而疸以愈。然则栀子于肺无与乎?仲圣云：凡用栀子汤病人旧微溏者不可与服之。肺与大肠相表里，服栀子则益其大肠之寒，此可为秉金气之一证。至治肝则古方不可胜举，总不离乎解郁火。凡肝郁则火生，胆火外扬，肝火内伏，栀子解郁火，故不治胆而治肝，古方如泻青丸、凉肝汤、越鞠丸、加味逍遥散之用栀子皆是。凉膈散有栀子，以治心也。泻黄散有栀子，以治胃也。而泻白散不遴入，则以肺中气热而不涉血者，栀子不与也。《本经》主胃中热气，朱丹溪谓最清胃脘之血，究栀子之治，气血皆有而血分为多，然不能逐瘀血与丹皮、桃仁分功；其解血中之郁热，只在上中焦而不在下焦；亦不入足太阳与手、足少阳；不入足太阳，故不利小便。茵陈蒿汤所以必先煮茵陈，许学士之治酒齄鼻，朱丹溪之治热厥心痛，《集简方》之敷折伤肿痛，皆属血中郁热。其余之治，悉可类推。\""}]},{"ID":"20240612091439-ozldaf2","Type":"NodeParagraph","Properties":{"id":"20240612091439-ozldaf2","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612091439-lp11nal","Type":"NodeParagraph","Properties":{"id":"20240612091439-lp11nal","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612091439-ha4zsy3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091439-ha4zsy3","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"《中华本草》：栀子"}]},{"ID":"20240612091439-aftku40","Type":"NodeParagraph","Properties":{"id":"20240612091439-aftku40","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612091439-c7kmupy","Type":"NodeParagraph","Properties":{"id":"20240612091439-c7kmupy","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" Zhī Zi"}]},{"ID":"20240612091439-he2ak75","Type":"NodeParagraph","Properties":{"id":"20240612091439-he2ak75","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612091439-zx6dcq7","Type":"NodeParagraph","Properties":{"id":"20240612091439-zx6dcq7","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 木丹、鲜支、卮子、 支子、越桃、山栀子、枝子、小卮子、黄鸡子、 黄荑子、黄栀子、黄栀、山黄栀、山栀"}]},{"ID":"20240612091439-uwsia03","Type":"NodeParagraph","Properties":{"id":"20240612091439-uwsia03","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612091439-3xc61si","Type":"NodeParagraph","Properties":{"id":"20240612091439-3xc61si","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" Cape Jasmine Fruit， Fruit of Cape Jasmine"}]},{"ID":"20240612091439-0105z2a","Type":"NodeParagraph","Properties":{"id":"20240612091439-0105z2a","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612091439-8d350b0","Type":"NodeParagraph","Properties":{"id":"20240612091439-8d350b0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 出自《本草图经》：栀子，今南方及西蜀州郡皆有之。木高七、八尺，叶似李而厚硬，又似樗蒲子，二、三月生白花，花皆六出，甚芬芳，俗说即西域詹匐也。夏、秋结实如诃子状，生青熟黄，中人深红，九月采实暴干。此亦有两、三种，入药者山栀子，方书所谓越挑也。皮薄而圆小，刻房七棱至九棱者为佳。其大而长者，乃作染色，又谓之伏尸栀子，不堪入药用。"}]},{"ID":"20240612091439-rp91s31","Type":"NodeParagraph","Properties":{"id":"20240612091439-rp91s31","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612091439-25j9t33","Type":"NodeParagraph","Properties":{"id":"20240612091439-25j9t33","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 药材基源：为双子叶植物药茜草科植物山栀的果实。"}]},{"ID":"20240612091439-tr6irss","Type":"NodeParagraph","Properties":{"id":"20240612091439-tr6irss","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Gardenia jasminoides Ellis"}]},{"ID":"20240612091439-otvn73i","Type":"NodeParagraph","Properties":{"id":"20240612091439-otvn73i","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"采收和储藏：于10月中、下旬，当果皮由绿色转为黄绿色时采收，除去果柄杂物，置蒸笼内微蒸或放入明矾水中微煮，取出晒干或烘干。亦可直接将果实晒干或烘干。"}]},{"ID":"20240612091439-or9j620","Type":"NodeParagraph","Properties":{"id":"20240612091439-or9j620","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612091439-2r86v51","Type":"NodeParagraph","Properties":{"id":"20240612091439-2r86v51","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于丘陵山地或山坡灌林中。"}]},{"ID":"20240612091439-jnpuz3l","Type":"NodeParagraph","Properties":{"id":"20240612091439-jnpuz3l","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于中南、西南及江苏、安微、浙江、江西、福建、台湾等地。"}]},{"ID":"20240612091439-9pqrv3x","Type":"NodeParagraph","Properties":{"id":"20240612091439-9pqrv3x","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612091439-0yg4ugp","Type":"NodeParagraph","Properties":{"id":"20240612091439-0yg4ugp","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 山栀 常绿灌木，高1-2m。小枝绿色，幼时被毛，后近无毛。单叶对生，衡三叶轮生，叶柄短；托叶两片，生于叶柄内侧；叶片革质，椭圆形、阔倒披针形或倒卵形，长6-14cm，宽2-7cm，先端急尖或渐尖，基部楔形，全缘，上面光泽，仅下面脉腋内簇生短毛；侧脉羽状。花大，极芳香，顶生或腋生，具短梗；萼绿色，长2-3cm，裂片5-7，线状披针形，通常比萼简稍长；花冠高脚碟状，白色，后变乳黄色，基部合生成简，上部6-7裂，旋转排列，先端圆；雄蕊与花冠裂片同数，着生于花冠喉部，花丝极短，花药线形，纵裂，2室；雌官司1，子房下位，1室。果实深黄色，倒卵形或长椭圆形，长2-4cm，有5-9条翅状纵棱，先端有条状宿存之萼。种子多数，鲜黄色，扁椭圆形。花期5-7月，果期8-11月。"}]},{"ID":"20240612091439-0b5u2o3","Type":"NodeParagraph","Properties":{"id":"20240612091439-0b5u2o3","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612091439-vpu3ebl","Type":"NodeParagraph","Properties":{"id":"20240612091439-vpu3ebl","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：喜温暖湿润的气候，以排水良好、肥沃疏松而较湿润的砂质壤土或粘质壤土为佳。"}]},{"ID":"20240612091439-sf1uykz","Type":"NodeParagraph","Properties":{"id":"20240612091439-sf1uykz","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"2.整地： 育苗地，先深耕33cm左右，除去石砾及草根，再行造畦，畦高17cm，宽1.3m。打碎土块，耙平，每亩施基肥2000kg。然后按行距27cm，挖宽7cm、深3cm的横沟，以待播种。"}]},{"ID":"20240612091439-sn9kyt5","Type":"NodeParagraph","Properties":{"id":"20240612091439-sn9kyt5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"3.种植：3.1.种子繁殖：播种期分春播和秋播，以春播为好。在2月上旬至2月下旬(立春至雨水)。选取饱满、色深红的果实，挖出种子，于水中搓散，捞取下沉的种子，晾去水份；随即与细土或草木灰拌匀，条播于畦沟内，盖以细土，再覆盖稻草；发芽后除去稻草，经常除草，如苗过密，应陆续匀苗，保持株距10-13cm。幼苗培育1-2年，高30余厘米，即可定植。"}]},{"ID":"20240612091439-nrn4udn","Type":"NodeParagraph","Properties":{"id":"20240612091439-nrn4udn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"3.2.扦插繁殖：扦插期秋季9月下旬至1O月下旬，春季2月中下旬。剪取生长2-3年的枝条，摈节剪成长17-20cm的插穗。插时稍微倾斜，上端留一节露出地面。约一年后即可移植。"}]},{"ID":"20240612091439-nfkp9w4","Type":"NodeParagraph","Properties":{"id":"20240612091439-nfkp9w4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"3.3.定植：2-3月间定植，按株距1.2-2m，作好直径50cm，深30cm的穴，并用堆肥10kg与细土拌匀作基肥。每穴栽苗1株。"}]},{"ID":"20240612091439-1cwxps1","Type":"NodeParagraph","Properties":{"id":"20240612091439-1cwxps1","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"4.田间管理：幼苗期须经常除草、浇水，保持苗床湿润，施肥以淡人粪尿为佳。定植后，在初春与夏季各除草、松土、施肥1次，并适当壅土。"}]},{"ID":"20240612091439-o4fmgio","Type":"NodeParagraph","Properties":{"id":"20240612091439-o4fmgio","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612091439-8cnl3oi","Type":"NodeParagraph","Properties":{"id":"20240612091439-8cnl3oi","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 性状鉴定： 果实倒卵形、椭圆形或长椭圆形，长1.4-3.5cm，直径0.8-1.8cm。表面红棕色或红黄色，微有光泽，有翅状纵棱6-8条，每二翅棱间有纵脉1条，先端有暗黄绿色残存宿萼，先端有6-8条长形裂片，裂片长1-2.5cm，宽2-3mm，多碎断，果实基部收缩成果柄状，末端有圆形果柄痕。果皮薄而脆，内表面鲜黄色或红黄色。有光泽，具隆起的假隔膜2-3条。折断面鲜黄色，种子多数，扁椭圆形或扁矩圆形，聚成球状团块，棕红色，表面有细而密的凹入小点；胚乳角质；胚长形，具心形子叶2片。气微，味微酸苦。以皮薄、饱满、色红黄者为佳。"}]},{"ID":"20240612091439-3fhhvdo","Type":"NodeParagraph","Properties":{"id":"20240612091439-3fhhvdo","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果实中部横切面：圆形，纵棱处显着凸起。外果皮为1列长方形细胞民，外壁增厚并被角质层；中果皮外侧有2-4列厚角细胞，向内为薄壁细胞，含黄色色素，少数较韧型维管束稀疏分布，较大的维管束四周具木化的纤维束，并有石细胞夹杂其间；内果皮为2-3列石细胞，近方形，长方形或多角形，壁厚，孔沟清晰，有的胞腔内可见草酸钙方晶，偶有含簇晶的薄壁细胞镶嵌其中。种子横切面，扁圆形，一侧略凸，外种皮为1列石细胞，近方形，内壁及侧壁显着增厚，胞腔含棕红色或黄色色素，内种皮为颓废薄壁细胞。胚乳细胞多角形，中央为2枚扁平的子叶，细胞内均充满糊粉粒。"}]},{"ID":"20240612091439-ncviqrd","Type":"NodeParagraph","Properties":{"id":"20240612091439-ncviqrd","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612091439-8o49yz8","Type":"NodeParagraph","Properties":{"id":"20240612091439-8o49yz8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 栀子醇渗漉浓缩液(300%)1次给药，腹腔注射和灌胃小鼠的半数致死量分别为17.1g/kg和107.48/kg。栀子甙(Geniposide)和栀子水提物对小鼠的急性毒性很低，前者口服、腹腔注射、静脉注射给药的半数致死量为3g/kg。水提物腹腔注射给药的半数致死量为 5g/kg。京尼平(Genipin)l次给药观察72小时，其口服、腹腔注射、静脉注射对小鼠的 半数致死量 分别为 237、190 与153mg/kg。栀子乙醇提取物小鼠灌胃的半数致死量为107.4g/kg，腹腔注射为 27.45g/kg。栀子乙醇提取物10g/kg 灌胃，连续4天，使小鼠环己烯巴比妥钠睡眠时间延长，肝脏呈灰绿色，乙醇提取物4g/kg 或去羟栀子甙 250mg/kg 灌胃，连续4天，可使大鼠肝微粒体 P-450含量和对硝基苯甲醚脱甲基酶活性降低，肝呈灰绿色。栀子骨髓微核试验、Ames试验和睾丸染色体畸变试验表明，栀子无致突变，致畸效应。"}]},{"ID":"20240612091439-htjl1x1","Type":"NodeParagraph","Properties":{"id":"20240612091439-htjl1x1","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612091439-dh0lgx5","Type":"NodeParagraph","Properties":{"id":"20240612091439-dh0lgx5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 果实含环烯醚萜类成分：栀子甙(gardenoside)，都桷子甙(geniposide)，都桷子素龙胆双糖甙(genipin-1-gentiobioside)，山栀甙(shanzhiside)，栀子酮甙(gardo-side)，鸡屎藤次甙甲酯(scandoside methyl ester)，都桷子甙酸(geniposidic acid)，去乙酰基车叶草甙酸(deacetyl asperulosidic acid)，去乙酰车叶草甙酸甲酯(methyl deacetyl asperulosidate)，10-乙酰基都桷子甙(10-acetylgeniposide) 6〃-对香豆酰基都桷子素龙胆双糖甙( 6〃-p-coumaroyl genipin gentiobio-side)。又含酸类成分：绿原酸(chlorogenic acid)，3，4-二-O-咖啡酰其奎宁酸(3，-4-di-O-caffeoyl quinic acid)，3-O-咖啡酰基-4-O-芥子酰基奎宁酸(3-O-caffeoyl-4-O-sinapoyl quinic acid)，3，5-二-O-咖啡酰基-4-O-(3-羟基-3甲基)戊二酰基奎宁酸[3，5-di-O-caffeoyl-4-O-(3-hydroxy-3-methyl)glutaroyl quinic acid]，3，4-二咖啡酰基-5-(3-羟基-3-甲基戊二酰基)奎宁酸[3，4-dicaffeovl-5-(3-hydroxy-3-methyl glutaroyl)quinic acid]，藏红花酸(cro-cetin)，藏红花素(crocin)，熊果酸(ursolic acid)，藏红花素葡萄糖甙(crocin glucoside)等。还含黄酮类成分：芸香甙(rutin)以及D-甘露醇(D-mannitol)，β-谷甾醇(β-sitosterol)，胆碱(choline)，二十九烷(nonacosane)，叶黄素(xanthophyll)等。"}]},{"ID":"20240612091439-o3zf3fz","Type":"NodeParagraph","Properties":{"id":"20240612091439-o3zf3fz","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"果皮及种子中也含栀子甙、都桷子甙、都桷子甙酸、都桷子素龙胆双糖甙。"}]},{"ID":"20240612091439-6kni1tx","Type":"NodeParagraph","Properties":{"id":"20240612091439-6kni1tx","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"花含三萜成分：栀子花酸(gradenlic acid)A、B和栀子酸(gardenic acid)叶含栀子甙，都桷子甙，栀子醛(cerbinal)，二氢茉莉酮酸甲酯(methyl dihydrojasmonate)，乙酸苄檬(limonene)，芳樟醇(linalool)等。"}]},{"ID":"20240612091439-50wajwb","Type":"NodeParagraph","Properties":{"id":"20240612091439-50wajwb","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"根茎含D-甘露醇，齐墩果酸(oleanolic acid)，豆甾醇(sing-masterol)"}]},{"ID":"20240612091439-nsof4gf","Type":"NodeParagraph","Properties":{"id":"20240612091439-nsof4gf","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612091439-1zme6m2","Type":"NodeParagraph","Properties":{"id":"20240612091439-1zme6m2","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 1.对肝脏功能的影响：1.1．对肝脏功能的作用：用SD大白鼠分为4组；A组为对照组；B组为正常动物，用2g生药提取物灌胃；C组为结扎总胆管，引起高胆红素血症的动物；D组为高胆红素血症动物，并用2g生药的栀子提取物灌胃。实验测定肝脏Y蛋白、Z蛋白、BSP清除率、胆红素及有关酶的测定。"}]},{"ID":"20240612091439-9tsl8rl","Type":"NodeParagraph","Properties":{"id":"20240612091439-9tsl8rl","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"实验结果表明：1.1.1.栀子提取物对动物血清和肝匀浆内碱性磷酸酶的活力并无影响。结扎总胆管引起碱性磷酶酶活力增加将近2倍。但栀子提取物对升高了的酶活力并无作用。"}]},{"ID":"20240612091439-uobo2zp","Type":"NodeParagraph","Properties":{"id":"20240612091439-uobo2zp","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.2.栀子提取物对大白鼠血清和肝内乳酸脱氢酶活力的影响极小，4组动物酶活力的波动均在正常范围之内。"}]},{"ID":"20240612091439-bmue938","Type":"NodeParagraph","Properties":{"id":"20240612091439-bmue938","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.3.栀子提取物对正常动物血清GOT无影响。结扎总胆管后，血清GOT增加7倍，栀子提取物可显着降低升高了的酶达40%。肝内GOT较稳定，4组动物均无明显改变。"}]},{"ID":"20240612091439-l3lh633","Type":"NodeParagraph","Properties":{"id":"20240612091439-l3lh633","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.4.栀子提取物对正常动物的酶活力无影响，但能使结扎总胆管动物升高了的酶活力恢复正常，可认为栀子提取物并不增加UDP一GT的活力。"}]},{"ID":"20240612091439-yabz70c","Type":"NodeParagraph","Properties":{"id":"20240612091439-yabz70c","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.5.测定肝脏二磷酸脲苷－葡萄糖脱氢酶表明，结扎总胆管可以降低酶活力，栀子提取物能增加正常动物酶活力，同时也能使降低了的酶活力升高。"}]},{"ID":"20240612091439-eprutte","Type":"NodeParagraph","Properties":{"id":"20240612091439-eprutte","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.6.栀子提取物能增加正常动物的Y蛋白、Z蛋白的量，但不能使由于结扎总胆管而减少的Y蛋白、Z蛋白量增加。表明栀子抗胆红素血症作用与Y蛋白、Z蛋白关系不大。"}]},{"ID":"20240612091439-p7vbt6c","Type":"NodeParagraph","Properties":{"id":"20240612091439-p7vbt6c","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.7.动物给药后静脉注射BSP(2g/100g体重)，测定血液中及胆汁中的BSP清除率，发现到达峰值时间均有相应的延长，表明BSP从肝内排出的过程受到阻滞。"}]},{"ID":"20240612091439-jq0cqpo","Type":"NodeParagraph","Properties":{"id":"20240612091439-jq0cqpo","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.1.8.栀子能降低血清胆红素含量，但与葡萄糖醛酰转移酶无关。因此可以认为栀子提取物对肝细胞无毒性作用，栀子提取物可降低动物血清胆红素水平，但其退黄机制较为复杂，它不增加UDP－GT的活力，也不增加肝内的Y蛋白和之蛋白，也不像茵陈蒿那样，增加胆汁的分沁量。"}]},{"ID":"20240612091439-fqwdh9p","Type":"NodeParagraph","Properties":{"id":"20240612091439-fqwdh9p","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.2.肝脏的保护作用：1.2.1.ICR大鼠预先(24或48小时以前)给于栀子提取物，可防止因半乳糖胺引起的暴发性肝炎。"}]},{"ID":"20240612091439-xtjeoll","Type":"NodeParagraph","Properties":{"id":"20240612091439-xtjeoll","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.2.2.实验大鼠给于异硫氰酸a-萘酯50mg/kg，可使大鼠血清胆红素和血清碱性磷酸酯酶和丙氨酸氨基转移酶升高，如每日给于栀子粗提物(1.5g/kg，口服，3天)可使因异硫氰酸a-萘酯中毒大鼠的血清胆红素、丙氨酸氨基转移酶和碱性磷酸酶下降。栀子中提取的成分栀子甙同样有此作用。"}]},{"ID":"20240612091439-1jypihz","Type":"NodeParagraph","Properties":{"id":"20240612091439-1jypihz","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.2.3.对肝脏的影响： 大鼠灌胃藏红花素50mg/kg 8天对肝脏功能无影响，但可引起急性肝脏变色。如服用高剂量100mg/kg 2周则可引起肝损害和黑变，但低剂量10mg/kg 40天并不产生上述情况，上述的肝损害和黑变是完全可逆的。因此藏红花素即使很高剂量对大鼠肝脏的毒性极小，在人服用时不可能达到如此高的剂量，所以藏红花素作为食品着色剂是十分安全的。"}]},{"ID":"20240612091439-123cr0f","Type":"NodeParagraph","Properties":{"id":"20240612091439-123cr0f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"2.对胆汁分泌的影响：大鼠、兔实验证明，栀子具利胆作用。其醇提物和栀子甙、藏红花素等均能使胆汁分泌量增加。大鼠口服、静脉注射或十二指肠内给于栀子甙25mg/kg引起胆汁分泌增加，以十二指肠内给药最为显着，几与去氢胆酸钠的效价相当。"}]},{"ID":"20240612091439-86r2rvo","Type":"NodeParagraph","Properties":{"id":"20240612091439-86r2rvo","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"3.对胃液分泌及胃肠运动的影响：十二指肠给予栀子甙25mg/kg，能使幽门结扎大鼠胃液分泌减少，总酸度下降，pH值升高，作用相当于硫酸阿托品的1/5-1/10。静脉注射栀子甙和其甙元(Genipin)，剂量分别为 100mg/kg与25mg/kg，能抑制大鼠自发性胃蠕动和匹罗卡品(Pilocarpine)诱发的胃收缩，但作用短暂。低浓度(1 ：25，000)栀子醇提取物能兴奋大鼠、兔小肠运动，高浓度(1 ：1，000)则抑制。小鼠和豚鼠离体回肠试验表明栀子甙有较弱的抗乙酰胆碱和抗组胺作用。"}]},{"ID":"20240612091439-7a4dur4","Type":"NodeParagraph","Properties":{"id":"20240612091439-7a4dur4","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"4.促进胰腺分泌作用：杨稚珍等用胆胰插管研究栀子及其不同提取物对大鼠胆胰流量及胰酶活性的影响，结果显示，栀子及其几种提取物有明显的利胰、利胆及降胰酶效应。京尼平甙有最显着的降低胰淀粉酶作用，而其酶解产物京尼平的增加胰胆流量作用最强，持续时间较短。裴德恺的研究认为栀子促进胰腺分泌作用可能与保持胰细胞膜的结构、功能直接有关，从而从细胞水平上论证了栀子治疗胰腺炎的药效基础。初步观察亦发现栀子有使膜脂的过氧化产物减少作用。"}]},{"ID":"20240612091439-jkr4tr6","Type":"NodeParagraph","Properties":{"id":"20240612091439-jkr4tr6","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"5.对中枢神经系统的作用：小鼠腹腔注射栀子醇提取物(栀子果实粉碎后以乙醇渗漉，渗漉液在50℃减压浓缩去醇，制成300%浓缩液)5.69g/kg，能减少小鼠自发活动(踏板法)，与对照组相比较P＜0.01，且与环己比妥钠(静脉注射，50mg/kg)有协同作用，能延长睡眠时间近12倍。但如用药组小鼠灌胃 35g/kg栀子醇渗漉液，然后分别在1、2、3小时，静脉注射环己烯巴比妥钠50mg/kg，记录翻正反射消失时间，结果只有于2小时给药的栀子组能显着延长环己烯巴比妥钠睡眠时间(P＜0.05)。但栀子对苯丙胺诱发活动无对抗作用。小鼠腹腔注射栀子醇提物5.69g/kg，体温可平均降低3℃，大鼠腹腔注射200mg/kg体温下降可持续7小时以上。"}]},{"ID":"20240612091439-mdt6fsg","Type":"NodeParagraph","Properties":{"id":"20240612091439-mdt6fsg","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"6.对心血管系统的作用：栀子煎剂和醇提物对麻醉或不麻醉猫、兔、大鼠，不论口服，腹腔注射或静脉注射给药均有降压作用，其降压作用对肾上腺素升压作用及阻断颈动脉血流的加压反射均元影响。也没有加强乙酰胆碱的降压作用。给予抗组胺药如苯海拉明，对栀子的降血压作用无影响。其降压作用不是由于释放组胺所引起。静脉注射普鲁卡因也不改变栀子的降血压效果，说明其降血压作用与传入神经纤维无关。对神经节无阻断作用。当切断两侧迷走神经后，栀子的降血压作用显着减弱或完全消失，阿托品也可取消其降血压作用。故认为栀子的降血压作用部位在中枢，栀子降血压效应主要是加强了延脑副交感中枢紧张度所致。亦有报道栀子对外周阻力影响不大，离体鼠心灌流实验表明，栀子提取物能降低心肌收缩力。麻醉犬、鼠静脉注射栀子提取物500mg/kg引起的血压下降是由于心收缩容积及心输出量下降。Im 藏红花酸(藏红花素的水解产物)0.01mg/kg，能减少喂饲胆固醇兔动脉硬化的发生率。大鼠静脉注射大剂量1g/kg 的栀子甲醇提取物时，心电图可呈现心肌损伤及房室传导阻滞。但麻醉兔静脉注射栀子甙30mg/kg，对血压、心率和乙电图都无明显影响。栀子果实的热水提取物能刺激体外培养牛主动脉内皮细胞的增殖，从而使血管内膜得以修复。"}]},{"ID":"20240612091439-igrx0sh","Type":"NodeParagraph","Properties":{"id":"20240612091439-igrx0sh","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"7.抑菌作用：栀子煎剂对白喉杆菌、金黄色葡萄球菌、伤寒杆菌有抑制作用，对多种皮肤真菌也有不同程度的抑制作用。"}]},{"ID":"20240612091439-jqvu077","Type":"NodeParagraph","Properties":{"id":"20240612091439-jqvu077","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"8.致泻作用：去乙酰车叶草甙酸甲酯有泻下作用，小鼠的半数有效量为 0.53g/kg，服用6小时后开始腹泻。羟异栀子甙亦有导泻作用，小鼠口服的半数有效量为 1.2g/kg，服后3小时开始作用。栀子甙的导泻作用半数有效量为 300mg/kg，服药后3小时起作用。栀子甙酸的导泻作用半数有效量 ＞800mg/kg。"}]},{"ID":"20240612091439-34j3ia7","Type":"NodeParagraph","Properties":{"id":"20240612091439-34j3ia7","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.镇痛作用：栀子甙及其水解产物京尼平对腹腔注射醋酸引起的小鼠扭体运动有抑制作用。"}]},{"ID":"20240612091439-kjsemqy","Type":"NodeParagraph","Properties":{"id":"20240612091439-kjsemqy","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"10.抗炎及治疗软组织损伤的作用：栀子以乙醇回流提取，在40℃以下减压浓缩至粘稠膏状(G1)；将乙醇回流提取后的药渣，用水渗漉，渗漉液水浴蒸干(G2)；将G1部分以甲醇溶解加硅藻土拌匀，以不同有机溶剂洗脱，分别回收溶剂得石油醚部分(G3)，氯仿部分(G4)，乙酸乙酯部分(G5)，甲醇部分(G6)。"}]},{"ID":"20240612091439-r7q378x","Type":"NodeParagraph","Properties":{"id":"20240612091439-r7q378x","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"然后以栀子甙(C-A)，氢化可的松软膏(H-U)，氢化可的松注射剂(H-I)，外伤止痛膏(H-E)作为对照。观察栀子各分离部位对软组织损伤动物模型的治疗作用和抗炎作用。结果如下：9.1．栀子各分离部分对软组织损伤模型的治疗作用：9.1.1.栀子对小鼠软组织损伤模型的实验治疗： 小鼠由特制的软组织打击器制成模型，然后分别涂药，每日1次，连续4次，5天后处死，按外表观察，分5组评分，同时进行组织切片观察，分4级评分。栀子中G2、G3、G4对小鼠软组织损伤无治疗作用，G5和G6具较好的治疗作用。经4次敷药，从外表观察已基本治愈，无出血、瘀血灶。组织学观察，只见轻度肌纤维肿胀及少量点状出血灶，而外伤止痛膏对软组织损伤无明显治疗作用。"}]},{"ID":"20240612091439-2xc4ase","Type":"NodeParagraph","Properties":{"id":"20240612091439-2xc4ase","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.1.2.G5、G6对家兔软组织损伤的实验治疗方法与1类似。实验表明，G5、G6对家兔软组织损伤同样有明显的治疗效果，敷药1小时后，家兔恢复正常活动，出血、瘀血灶明显好转。敷药4天后，外表已无明显的出血和瘀血灶。5天后处死动物组织学观察，见肌纤维轻度肿胀，部分组织内有点状出血和瘀血灶。实验进一步证明外伤止痛膏对出血和瘀血性组织损伤无明显效果。"}]},{"ID":"20240612091439-mm66m22","Type":"NodeParagraph","Properties":{"id":"20240612091439-mm66m22","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.2．栀子各分离部位的抗炎作用：9.2.1.对小鼠急性耳肿胀的作用：栀子G1、G5、G6对二甲苯致小鼠耳壳肿胀均有明显作用，抑制率分别达42.1%、62.4%、69.0%。与氢化可的松软膏相比较无显着差异(P＞0.05)。"}]},{"ID":"20240612091439-baxpyzs","Type":"NodeParagraph","Properties":{"id":"20240612091439-baxpyzs","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.2.2.栀子G5、G6对甲醛致大鼠亚急性足跖肿胀的作用：栀子G5、G6部分对甲醛致大鼠亚急性足跖肿胀具有明显的抑制作用，涂药后24小时，G5、G6对足跖肿胀的抑制率分别达28.7%、46.3%，涂药后48小时更为明显，达47.4%、53.5%。"}]},{"ID":"20240612091439-z3fag5c","Type":"NodeParagraph","Properties":{"id":"20240612091439-z3fag5c","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.2.3.C-A对小鼠急性耳肿胀的作用：桅子C-A对二甲苯致小鼠耳肿胀以及巴豆油致小鼠耳肿胀均有明显的作用(P＜0.01)，抑制率分别达65.0%、77.3%。"}]},{"ID":"20240612091439-d89xhf8","Type":"NodeParagraph","Properties":{"id":"20240612091439-d89xhf8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.2.4.栀子甙(A)对幼鼠器官重量的影响：腹腔注射200mg/kg的栀子甙(A)对幼鼠免疫器官无影响，同时对WBC计数也无影响，而氢化可的松对胸腺、脾脏均有萎缩作用。"}]},{"ID":"20240612091439-hxzhno8","Type":"NodeParagraph","Properties":{"id":"20240612091439-hxzhno8","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612091439-h1a2815","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612091439-h1a2815","updated":"20240612091439"},"Children":[{"ID":"20240612091439-ysaomn6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612091439-ysaomn6","updated":"20240612091439"},"Children":[{"ID":"20240612091439-omcuiag","Type":"NodeParagraph","Properties":{"id":"20240612091439-omcuiag","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"生栀子：筛去灰屑，拣去杂质，碾碎过筛；或剪去两端。"}]}]},{"ID":"20240612091439-f4bl3q2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240612091439-f4bl3q2","updated":"20240612091439"},"Children":[{"ID":"20240612091439-2ke23kz","Type":"NodeParagraph","Properties":{"id":"20240612091439-2ke23kz","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"山栀仁：取净栀子，用剪刀从中间对剖开，剥去外皮取仁。"}]}]},{"ID":"20240612091439-fcxoqlj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240612091439-fcxoqlj","updated":"20240612091439"},"Children":[{"ID":"20240612091439-qr2d36t","Type":"NodeParagraph","Properties":{"id":"20240612091439-qr2d36t","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"山栀皮：即生栀子剥下的外果皮。"}]}]},{"ID":"20240612091439-hon8pdz","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240612091439-hon8pdz","updated":"20240612091439"},"Children":[{"ID":"20240612091439-a7k4o9j","Type":"NodeParagraph","Properties":{"id":"20240612091439-a7k4o9j","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"炒栀子：取碾碎的栀子，置锅内用文火炒至金黄色，取出，放凉。"}]}]},{"ID":"20240612091439-k7vbs2w","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20240612091439-k7vbs2w","updated":"20240612091439"},"Children":[{"ID":"20240612091439-ggwapvv","Type":"NodeParagraph","Properties":{"id":"20240612091439-ggwapvv","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"焦栀子：取碾碎的栀子，置锅内用武火炒至焦糊色，取出，放凉。"}]}]},{"ID":"20240612091439-kg2d7fy","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240612091439-kg2d7fy","updated":"20240612091439"},"Children":[{"ID":"20240612091439-6ylj7hp","Type":"NodeParagraph","Properties":{"id":"20240612091439-6ylj7hp","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"栀子炭：取碾碎的栀子，置锅内用武火炒至黑褐色，但须存性，取出，放凉。"}]}]}]},{"ID":"20240612091439-88m8bjj","Type":"NodeParagraph","Properties":{"id":"20240612091439-88m8bjj","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"7.《雷公炮炙论》：凡使栀子，先去皮须了，取人，以甘草水浸一宿，漉出焙干，捣筛如赤金末用。"}]},{"ID":"20240612091439-g5t9azn","Type":"NodeParagraph","Properties":{"id":"20240612091439-g5t9azn","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612091439-nvbrd2u","Type":"NodeParagraph","Properties":{"id":"20240612091439-nvbrd2u","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末2g，加水5ml，置水浴中加热3min，滤过。取滤液5滴，置瓷蒸发皿中，烘干后，加硫酸1滴，即显蓝绿色，迅速变为黑褐色，继转为紫褐色。（检查藏红花素）（2）本品1%热水浸出液，滤过。取滤液10ml，置有塞量简中，加乙醚5ml，振摇，水层呈鲜黄色，醚液无色。（检查藏红花素）商品规格格 按栀子果实成熟的程度分为一、二等。一等：果实长圆形或椭圆形，饱满。表面橙红色、红黄色、淡红色、淡黄色，具纵棱，顶端有宿存萼片。皮薄，革质。略有光泽。破开后种子聚集成团状。气微味微酸而苦。二等：较瘦小。表面橙黄色、暗棕色或带青色，间有怪形果或破碎，余同一等。"}]},{"ID":"20240612091439-ter0l17","Type":"NodeParagraph","Properties":{"id":"20240612091439-ter0l17","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612091439-zz3g9au","Type":"NodeParagraph","Properties":{"id":"20240612091439-zz3g9au","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 心；肝；肺；胃；三焦经"}]},{"ID":"20240612091439-nnvssd0","Type":"NodeParagraph","Properties":{"id":"20240612091439-nnvssd0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612091439-igfuwce","Type":"NodeParagraph","Properties":{"id":"20240612091439-igfuwce","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 苦；寒"}]},{"ID":"20240612091439-r1lz19x","Type":"NodeParagraph","Properties":{"id":"20240612091439-r1lz19x","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612091439-z5r6f1c","Type":"NodeParagraph","Properties":{"id":"20240612091439-z5r6f1c","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 脾虚便溏者忌服。"}]},{"ID":"20240612091439-32ssk6b","Type":"NodeParagraph","Properties":{"id":"20240612091439-32ssk6b","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"1.《本草汇言》：吐血衄血，非阳火暴发者忌之。"}]},{"ID":"20240612091439-69dcehd","Type":"NodeParagraph","Properties":{"id":"20240612091439-69dcehd","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"2.《得配本草》：邪在表，虚火上升，二者禁用。"}]},{"ID":"20240612091439-nw8i8ix","Type":"NodeParagraph","Properties":{"id":"20240612091439-nw8i8ix","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612091439-8h6ax05","Type":"NodeParagraph","Properties":{"id":"20240612091439-8h6ax05","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 泻火除烦；清热利湿；凉血解毒。主热病心烦；肝火目赤；头痛；湿热黄疳；淋证；叶血衄血；血痢尿血；口舌生疮；疮疡肿毒；扭伤肿痛"}]},{"ID":"20240612091439-fkvi24f","Type":"NodeParagraph","Properties":{"id":"20240612091439-fkvi24f","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612091439-8dkjwcg","Type":"NodeParagraph","Properties":{"id":"20240612091439-8dkjwcg","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g；或入丸、散。外用：适量，研未掺或调敷。"}]},{"ID":"20240612091439-9qb5u5z","Type":"NodeParagraph","Properties":{"id":"20240612091439-9qb5u5z","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612091439-br2hkg0","Type":"NodeParagraph","Properties":{"id":"20240612091439-br2hkg0","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" ①治伤寒发汗、吐、下后，虚烦不得眠，心中懊NONG： 栀子十四个(剖)，香豉四合(绵裹)。上二昧， 以水四升，先煮栀子得二升半，纳豉，煮取一升半，去滓，分为二服。温进一服，得吐者止后服。(《伤寒论》栀子豉汤)②治伤寒大病瘥后劳复者： 枳实三枚(炙)，栀子十四个(剖)，豉一升(绵裹)。上三味，以清浆水七升，空煮取四升．内枳实、栀子，煮取二升，下豉，更煮五、六沸，去滓，温分再服，覆令微似汗。若有宿食者，内大黄如博棋子五、六枚。(《伤寒论》枳实栀子豉汤)③治伤寒身黄发热： 肥栀子十五个(剖)，甘草一两(炙)，黄柏二两。上三味，以水四升，煮取一升半，去滓，分温再服。(《伤寒论》栀子柏皮汤)④治湿热黄疸： 山栀四钱，鸡骨草、田基黄各一两。水煎，日分三次服。(《广西中草药》)⑤治尿淋，血淋， 鲜栀子二两，冰糖一两。煎服。(《闽东本草》)⑥治小便不通：栀子仁二七枚，盐花少许，独颗蒜一枚。上捣烂，摊纸花上贴脐，或涂阴囊上，良久即通。(《普济方》)⑦治急性胃肠炎，腹痛，上吐下泻： 山栀三钱，盘柱南五味(紫金皮)根五钱，青木香二钱。上药炒黑存性，加蜂蜜五钱。水煎，分二次服。(《单方验方调查资料选编》)⑧治口疮、咽喉中塞痛，食不得： 大青四两，山栀子、黄柏各一两，白蜜半斤。上切，以水三升，煎取一升，去滓，下蜜更煎一两沸，含之。(《普济方》栀子汤)⑨治目赤：取山栀七枚，钻透，入煻灰火煨熟，以水一升半，煎至八合，去滓，入大黄末三钱匕，搅匀，食后旋旋温服。(《圣济总录》栀子汤)⑩治胃脘火痛，大山栀子七枚或九枚，炒焦，水一盏，煎七分，入生姜汁饮之。(《丹溪纂要》)11.治鼻中衄血： 山栀子烧灰吹之。(《简易方论》)12.治肺风鼻赤酒： 老山栀为末， 黄蜡等分溶和。为丸弹子大。空心茶、酒嚼下。忌酒、炙煿。(《本事方》)13.治赤白痢并血痢： 山栀子仁四七枚。锉， 以浆水一升半，煎至五合，去滓。空心食前分温二服。(《圣济总录》栀子仁汤)14.治热水肿： 山栀子五钱，木香一钱半，白术二钱半。细切，水煎服。(《丹溪心法》)15.治妇人子肿湿多： 炒山栀子一合。为末，米饮吞下，或丸服。(《丹溪心法》)16.治折伤肿痛： 栀子、白面同捣，涂之。 (《濒湖集简方》)17.治火丹毒： 栀子，捣和水调敷之。(《梅师集验方》)18.治火疮未起： 栀子仁灰，麻油和封，惟厚为佳。(《千金方》)19.治疮疡肿痛： 山栀、蒲公英、银花各四钱。水煎，日分三次服。另取生银花藤适量， 捣烂，敷患处。(《广西中草药》)20、治烧伤： 栀子末和鸡子清浓扫之。 (《救急方》)"}]},{"ID":"20240612091439-sgsdixm","Type":"NodeParagraph","Properties":{"id":"20240612091439-sgsdixm","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612091439-h3o8zf9","Type":"NodeParagraph","Properties":{"id":"20240612091439-h3o8zf9","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" .1.治疗急性黄疸型肝炎： 取山栀制成10%及50%两种煎剂，每天3次饭后服用。一部分病人用10%煎剂每次10ml，以后逐渐递增至5Oml；另一部分病人用50%煎剂，每次10-15ml。共治19例，7例痊愈，10例接近痊愈。住院9-63天不等，平均30.3天。"}]},{"ID":"20240612091439-r12h4gu","Type":"NodeParagraph","Properties":{"id":"20240612091439-r12h4gu","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"2.治疗扭挫伤：将山栀子捣碎，研成极粉，以温水调成糊状，加入少许酒精，包敷伤处。一般3-5天更换1次，如肿胀明显可隔天更换1次。骨折者不宜使用，脱臼者应先整复后再用。如有肢体麻痹，应配合理疗及针灸治疗。治序407例，24小时内疼痛消失者328例；48小时内消失者66例；72小时内消失者13例。疼痛平均消失时间为30小时。肿胀消退时间平均为2.5天；血肿吸收时间平均为7.8天；功能恢复时间平均为5.1天。或用黄栀子、明乳香加适量黄酒，搅拌后放锅内蒸成糊膏状，待微温时敷于患部，厚度以 1-1.5cm为宜。用时先在局部涂凡士林1层，然后再敷药，上盖油纸，绷带包扎。间隔2-3天换药。治疗56例，除2例疗效不佳外，54例均治愈。亦可用黄栀子粉2两，面粉4两，鸡蛋1个，烧酒适量，调成糊状敷于局部，待药干后更换新药。一般在敷药2次后即见效果。"}]},{"ID":"20240612091439-iwb2tdj","Type":"NodeParagraph","Properties":{"id":"20240612091439-iwb2tdj","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"3.用于止血：取黄栀子粉100g，以20%明胶液调成膏状，烘干碾成100号细粉，再加适量苯甲酸，高压消毒备用。对一般上消化道出血每次服3-6g，每日3次。亦可用作局部止血剂。"}]},{"ID":"20240612091439-h473tl5","Type":"NodeParagraph","Properties":{"id":"20240612091439-h473tl5","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612091439-1nnt8xf","Type":"NodeParagraph","Properties":{"id":"20240612091439-1nnt8xf","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 1．《本草衍义》：仲景治(伤寒)发汗吐下后，虚烦不得眠；若剧者，必反复颠倒，心中懊NONG，栀子豉汤治之。虚故不用大黄，有寒毒故也。栀子虽寒无毒，治胃中热气，既亡血、亡津液，腑脏无润养，内生虚热，非此物不可去。又治心经留热，小便赤涩，用去皮山栀子、火煨大黄、连翘、甘草(炙)，等分，末之，水煎三钱服，无不利也。"}]},{"ID":"20240612091439-9zpvz9r","Type":"NodeParagraph","Properties":{"id":"20240612091439-9zpvz9r","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"2．《丹溪心法》：山栀子仁，大能降火，从小便泄去。其性能屈曲下降，人所不知。亦治痞块中火邪。大凡心隔之痛，须分新久。若明知身受寒气、口吃寒物而得病者，于初得之时，当与温散或温利之药。若曰病得之稍久则成郁，久郁则蒸热，热久必生火，《原病式》中备言之矣，若欲行温散温利，宁无助火添病耶！ 古方中多以山栀子为热药之向导，则邪易伏、病易退、正易复而病安。"}]},{"ID":"20240612091439-dfyfc7e","Type":"NodeParagraph","Properties":{"id":"20240612091439-dfyfc7e","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"3．《汤液本草》：或用栀子利小便，实非利小便，清肺也，肺气清而化，膀胱为津液之府，小便得此气化而出也。栀子豉汤治烦躁，烦者气也，躁者血也，气主肺，血主肾，故用栀子以治肺烦，用香豉以治肾躁。躁者，懊NONG不得眠也。"}]},{"ID":"20240612091439-qfowfgs","Type":"NodeParagraph","Properties":{"id":"20240612091439-qfowfgs","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"4．《本草经疏》：栀子，清少阴之热，则五内邪气自去，胃中热气亦除。面赤酒疱皶鼻者，肺热之候也，肺主清肃，酒热客之，即见是证，于开窍之所延及于面也，肺得苦寒之气，则酒热自除而面鼻赤色皆退矣。其主赤白癞疮疡者，即诸痛痒疮疡皆属心火之谓。疗目赤热痛，及胸、心、大小肠大热，心中烦闷者，总除心、肺二经之火热也。此药味苦气寒，泻一切有余之火，故能主如上诸证。栀子禀至苦大寒之气，苦寒损胃而伤血，凡脾胃虚弱者忌之，血虚发热者忌之。性能泻有余之火，心肺无邪热者不宜用；小便不通，由于膀胱虚无气以化，而非热结小肠者不宜用；疮疡因气血虚，不能收敛，则为久冷败疮，非温暖补益之剂则不愈，此所谓既溃之后，一毫寒药不可用是也。世人又以治诸血证，不知血得热则行，得寒则凝，瘀血凝结于中，则反致寒热，或发热劳嗽，饮食减少，为难疗之病，凡治吐血法，当以顺气为先，盖血随气而行，气降则火降，火降则血自归经。不求其止而止矣。此治疗之要按，不可违也。"}]},{"ID":"20240612091439-sdvy4bb","Type":"NodeParagraph","Properties":{"id":"20240612091439-sdvy4bb","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"5．《本草正》：栀子，若用佐使，治有不同：加茵陈除湿热疸黄，加豆豉除心火烦躁，加厚补、枳实可除烦满，加生姜、陈皮可除呕哕，同元胡破热滞瘀血腹痛。"}]},{"ID":"20240612091439-jan5kx2","Type":"NodeParagraph","Properties":{"id":"20240612091439-jan5kx2","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"6．《本草通玄》：仲景多用栀子茵陈，取其利小便而蠲湿热也。古方治心痛，每用栀子，此为火气上逆，不得下降者设也。(若)泥丹溪之说，不分寒热，通用栀子，属寒者何以堪之。"}]},{"ID":"20240612091439-xouy6up","Type":"NodeParagraph","Properties":{"id":"20240612091439-xouy6up","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"7．《本草崇原》：言栀子生用则吐，炒黑则不吐，且以栀子豉汤为吐剂，愚每用生栀子及栀子豉汤，并未曾吐。"}]},{"ID":"20240612091439-fds26dt","Type":"NodeParagraph","Properties":{"id":"20240612091439-fds26dt","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"8．《得配本草》：“山栀，得滑石治血淋溺闭，得良姜治寒热腹痛，得柏皮治身热发黄，配连翘治心经留热(心热则赤淋)，佐柴胡、白芍治肝胆郁火，使生地、丹皮治吐衄不止。上焦、中焦连壳，下焦去壳，洗去黄浆炒用，泻火生用，止血炒黑，内热用仁，表热用皮，淋症童便炒，退虚火盐水炒，劫心胃火痛姜汁炒，热痛乌药拌炒，清胃血蒲黄炒。山栀、丹皮、白芍、龙胆，皆泻肝家之火，其中却自有别，盖肝喜散，遏之则劲，宜用栀子以清其气，气清火亦清，肝得辛为补，丹皮之李，从其性以醒之，是即为补，肝受补，气展而火亦平，肝气过散，宜白芍制之，平其性即所以泻其火，使之不得自逞，火盛肝气必实，龙胆苦以泄其气，寒以制其火，故非实，胆草不用，如不审其究竟而混投之，是伐其生生之气，即使火气悉除，而人已惫矣。"}]},{"ID":"20240612091439-c4a98pl","Type":"NodeParagraph","Properties":{"id":"20240612091439-c4a98pl","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"9.《本草思辨录》：栀子，其治在心、肝、胃者多，在肺者少。苦寒涤热，而所涤为瘀郁之热，非浮散之热，亦非坚结之热。能解郁不能攻坚，亦不能平逆，故阳明之腹满有燥屎，肺病之表热咳逆，皆非其所司。独取其秉肃降之气以敷条达之用，善治心烦与黄疸耳。心烦或懊或结痛，黄疸或寒热不食或腹满便赤，皆郁也。心烦心下濡者为虚，胸中窒者为实。实与虚皆汗吐下后余邪留踞，皆宜吐去其邪。栀子解郁而性终下行，何以能吐?协以香豉，则一升一降，邪不田受则吐。黄疸之瘀热在表，其本在胃，栀子入胃涤热下行，更以走表利便之茵陈辅之，则瘀消热解而疸以愈。然则振子于肺无与乎仲圣云：凡用栀子汤病人旧微溏者不可与服之。肺与大肠相表里，服据于则益其大肠之寒，此可为秉金气之一证。至治肝则古方不可胜举，总不离乎解郁火。凡肝郁则火生，胆火外扬，肝火内优，栀子解郁火，故不治胆而治肝，古方如泻青丸、凉肝汤、越鞠丸、加味逍遥散之用栀子皆是。凉膈散有栀子，以治心也。泻黄散有栀子，以治胃也。而泻白散不遴入，则以肺中气热而不涉血者，栀子不与也。《本经》主胃中热气，朱丹溪谓最清胃脘之血，究栀子之治，气血皆有而血分为多，然不能逐瘀血与丹皮、桃仁分功；其解血中之郁热，只在上中焦而不在下焦；亦不入足太阳与手、足少阳；不入足太阳，故不利小便。茵陈蒿汤所以必先煮茵陈，许学士之治酒皶鼻，朱丹溪之治热厥心痛，《集简方》之敷折伤肿痛，皆属血中郁热。其余之治，悉可类推。"}]},{"ID":"20240612091439-wy5qeon","Type":"NodeParagraph","Properties":{"id":"20240612091439-wy5qeon","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612091439-yjvbv7t","Type":"NodeParagraph","Properties":{"id":"20240612091439-yjvbv7t","updated":"20240612091439"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612091440-y5pkt9f","Type":"NodeThematicBreak","Properties":{"id":"20240612091440-y5pkt9f"}},{"ID":"20240612091441-6emug8v","Type":"NodeParagraph","Properties":{"id":"20240612091441-6emug8v"}}]}