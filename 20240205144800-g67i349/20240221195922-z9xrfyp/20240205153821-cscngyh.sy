":"20240814151414-2y3k0vq","Type":"NodeParagraph","Properties":{"id":"20240814151414-2y3k0vq","updated":"20240814152551"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 676px;","style":"width: 666px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 12-20240814150222-hndk2at.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 666px;\" parent-style=\"width: 676px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 287px;","style":"width: 277px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 18-20240814151210-fe2g7u5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 277px;\" parent-style=\"width: 287px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 243px;","style":"width: 233px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 20-20240814152551-q2lyqd8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 233px;\" parent-style=\"width: 243px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814145243-xl47anm","Type":"NodeParagraph","Properties":{"id":"20240814145243-xl47anm","updated":"20240814151324"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 257px;","style":"width: 247px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 8-20240814145242-24yevdz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 247px;\" parent-style=\"width: 257px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 257px;","style":"width: 247px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 13-20240814150310-7ugmafg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 247px;\" parent-style=\"width: 257px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 731px;","style":"width: 721px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 19-20240814151324-5j1nz1y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 721px;\" parent-style=\"width: 731px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814155518-6wh0pi0","Type":"NodeParagraph","Properties":{"id":"20240814155518-6wh0pi0","updated":"20240814155604"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (22)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 22-20240814155518-1t2lj27.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (23)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 23-20240814155604-4xtcatr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814145844-7wzjrqx","Type":"NodeParagraph","Properties":{"id":"20240814145844-7wzjrqx","updated":"20240814151041"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 17-20240814151034-ipkpydm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知母 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/知母 5-20240814144927-1vkkquz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611144645-7566xzv","Type":"NodeThematicBreak","Properties":{"id":"20240611144645-7566xzv"}},{"ID":"20240611144729-ft0oafa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144729-ft0oafa","updated":"20240611144736"},"Children":[{"Type":"NodeText","Data":"知母《本草撮要》"}]},{"ID":"20240611144729-ctuscd5","Type":"NodeParagraph","Properties":{"id":"20240611144729-ctuscd5","updated":"20240611144729"},"Children":[{"Type":"NodeText","Data":"味苦．入手太阴足阳明经．功专治消渴烦热．得麦冬清肺止渴．得地黄滋肾润燥．得人参治妊娠子烦．蓐劳骨蒸．久疟下痢．然苦寒伤胃滑肠．多服令人泻．得酒良．上行酒浸．下行盐水拌．忌铁．"}]},{"ID":"20240611144659-zlpdquk","Type":"NodeThematicBreak","Properties":{"id":"20240611144659-zlpdquk"}},{"ID":"20240611144720-yniua2e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144720-yniua2e","updated":"20240611144724"},"Children":[{"Type":"NodeText","Data":"知母《得配本草》"}]},{"ID":"20240611144720-wl85ewk","Type":"NodeParagraph","Properties":{"id":"20240611144720-wl85ewk","updated":"20240611144720"},"Children":[{"Type":"NodeText","Data":"得黄柏及酒良。伏硼砂、盐。"}]},{"ID":"20240611144720-rm22ryc","Type":"NodeParagraph","Properties":{"id":"20240611144720-rm22ryc","updated":"20240611144720"},"Children":[{"Type":"NodeText","Data":"辛，苦，寒。入足少阴、手太阴经气分。泻肾火，除骨蒸，退邪热，滋化源。疗初痢腰痛，治久疟酷热，消痰定嗽，止渴除烦。得人参，治子烦。得地黄，润肾燥。得莱菔子、杏仁，治久嗽气急。配麦冬，清肺火。"}]},{"ID":"20240611144720-5qx1ll0","Type":"NodeParagraph","Properties":{"id":"20240611144720-5qx1ll0","updated":"20240611144720"},"Children":[{"Type":"NodeText","Data":"拣肥润里白者，去毛，铜刀切片。犯铁器，损肾。欲上行，酒拌焙燥。欲下行，盐水润焙。"}]},{"ID":"20240611144720-2zban3v","Type":"NodeParagraph","Properties":{"id":"20240611144720-2zban3v","updated":"20240611144720"},"Children":[{"Type":"NodeText","Data":"肠胃滑泄，虚损发热，二者禁用。"}]},{"ID":"20240611144720-94xmld8","Type":"NodeParagraph","Properties":{"id":"20240611144720-94xmld8","updated":"20240611144720"},"Children":[{"Type":"NodeText","Data":"邪热伏于肺中，不能生水，膀胱绝其化源，秘塞不通，用知母清金，而泉源滋长，此所以有知母补阴之谓。若真水不足，膀胱失气化之司，速当补肾，使阴气行而阳自化，便自通也。"}]},{"ID":"20240611144720-x22hrib","Type":"NodeParagraph","Properties":{"id":"20240611144720-x22hrib","updated":"20240611144720"},"Children":[{"Type":"NodeText","Data":"知母苦寒，大伤肾水，尤宜禁用。"}]},{"ID":"20240611144659-bxufjtu","Type":"NodeThematicBreak","Properties":{"id":"20240611144659-bxufjtu"}},{"ID":"20240611144711-hguakfr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144711-hguakfr","updated":"20240611144715"},"Children":[{"Type":"NodeText","Data":"知母《本草害利》"}]},{"ID":"20240611144711-r9iy3cw","Type":"NodeParagraph","Properties":{"id":"20240611144711-r9iy3cw","updated":"20240611144711"},"Children":[{"Type":"NodeText","Data":"〔害〕伤胃滑肠，令人作泻，凡阳痿及易举易泄，脾弱，饮食不消化，胃虚不思食，肾虚溏泄等症，法并禁用。士材云∶苦寒肃杀，非长养万物者也。世以其滋阴，用治虚损，则如水益深矣。"}]},{"ID":"20240611144711-yi35lj2","Type":"NodeParagraph","Properties":{"id":"20240611144711-yi35lj2","updated":"20240611144711"},"Children":[{"Type":"NodeText","Data":"〔利〕辛苦寒滑，清肺热，泻肾火之有余，入二经气分。润肾燥滋阴，消痰定嗽，止渴除烦，兼能安胎，利二便，消肿，为凉脾胃大肠之品。知母须，其根也，力薄而苦寒性减。"}]},{"ID":"20240611144711-0r2ekju","Type":"NodeParagraph","Properties":{"id":"20240611144711-0r2ekju","updated":"20240611144711"},"Children":[{"Type":"NodeText","Data":"〔修治〕二八月采根，凡用拣肥润里白者，去毛切，得酒良。上行酒浸焙干，下行盐水拌焙。忌铁。"}]},{"ID":"20240611144659-vb93c03","Type":"NodeThematicBreak","Properties":{"id":"20240611144659-vb93c03"}},{"ID":"20240611144701-7jagbu4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144701-7jagbu4","updated":"20240611144705"},"Children":[{"Type":"NodeText","Data":"知母《汤液本草》"}]},{"ID":"20240611144701-bjnf9jp","Type":"NodeParagraph","Properties":{"id":"20240611144701-bjnf9jp","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"气寒，味大辛。苦寒，味浓，阴也，降也。苦，阴中微阳。无毒。"}]},{"ID":"20240611144701-gcqm0vj","Type":"NodeParagraph","Properties":{"id":"20240611144701-gcqm0vj","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"入足阳明经，手太阴、肾经本药。"}]},{"ID":"20240611144701-0k7ufvv","Type":"NodeParagraph","Properties":{"id":"20240611144701-0k7ufvv","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"《象》云∶泻足阳明经火热，补益肾水膀胱之寒。去皮用。"}]},{"ID":"20240611144701-83qiol0","Type":"NodeParagraph","Properties":{"id":"20240611144701-83qiol0","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"《心》云∶泻肾中火，苦寒，凉心去热。"}]},{"ID":"20240611144701-tbqv6np","Type":"NodeParagraph","Properties":{"id":"20240611144701-tbqv6np","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"《珍》云∶凉肾，肾经本药，上颈行经，皆须用酒炒。"}]},{"ID":"20240611144701-wli93bg","Type":"NodeParagraph","Properties":{"id":"20240611144701-wli93bg","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主消渴热中，除邪气，肢体浮肿，下水，补不足，益气，疗伤寒，久疟烦热，胁下邪气，膈中恶，及风汗内疸。多服，令人泄。"}]},{"ID":"20240611144701-vivo1ej","Type":"NodeParagraph","Properties":{"id":"20240611144701-vivo1ej","updated":"20240611144701"},"Children":[{"Type":"NodeText","Data":"东垣云∶入足阳明、手太阴，味苦，寒润。治有汗骨蒸，肾经气劳，泻心。仲景用此为白虎汤，治不得眠者，烦躁也。烦者，肺也；躁者，肾也。以石膏为君主，佐以知母之苦寒，以清肾之源。缓以甘草、粳米之甘，而使不速下也。经云∶胸中有寒者，瓜蒂散吐之。又云∶表热里寒者，白虎汤主之。瓜蒂、知母味皆苦寒，而治胸中寒及里寒，何也？答曰∶成无己注云∶即伤寒寒邪之毒为热病也。读者要逆识之，如《论语》言∶乱臣十人，书言唯以乱民，其能而乱四方。乱，皆治也，乃治乱者也，故云乱民，乱四方也。仲景所言“寒”之一字，举其初而言之，热病在其中矣。若以“寒”为寒冷之寒，无复用苦寒之剂。兼言白虎证“脉尺寸俱长”，则热可知矣。"}]},{"ID":"20240611144646-2prnvs2","Type":"NodeThematicBreak","Properties":{"id":"20240611144646-2prnvs2"}},{"ID":"20240611144647-g3jyykv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144647-g3jyykv","updated":"20240611144653"},"Children":[{"Type":"NodeText","Data":"知母《神农本草经赞》"}]},{"ID":"20240611144647-ktenwru","Type":"NodeParagraph","Properties":{"id":"20240611144647-ktenwru","updated":"20240611144647"},"Children":[{"Type":"NodeText","Data":"味苦寒。主消渴热中。除邪气。肢体浮肿。下水补不足益气。一名母。一名连母。"}]},{"ID":"20240611144647-hteakyg","Type":"NodeParagraph","Properties":{"id":"20240611144647-hteakyg","updated":"20240611144647"},"Children":[{"Type":"NodeText","Data":"一名野蓼。一名地参。一名水参。一名水浚。一名货母。一名母。生川谷。"}]},{"ID":"20240611144647-73mvk75","Type":"NodeParagraph","Properties":{"id":"20240611144647-73mvk75","updated":"20240611144647"},"Children":[{"Type":"NodeText","Data":"宿根分系。厥状虻。呼聆众母。踵接群儿。蒸收火定。热濯阴滋。槐砧适性。镔铁相违。"}]},{"ID":"20240611144647-fwwfkz3","Type":"NodeParagraph","Properties":{"id":"20240611144647-fwwfkz3","updated":"20240611144647"},"Children":[{"Type":"NodeText","Data":"李时珍曰。宿根之旁生子根。如虻之状。礼。子产犹众人之母也。名医曰。一名儿草。"}]},{"ID":"20240611144647-0rzyfcu","Type":"NodeParagraph","Properties":{"id":"20240611144647-0rzyfcu","updated":"20240611144647"},"Children":[{"Type":"NodeText","Data":"又名儿踵草。李杲曰。其用有四疗。有汗之骨蒸。泻无根之肾火。止虚劳之热。滋化源之阴。"}]},{"ID":"20240611144647-1ij9w7t","Type":"NodeParagraph","Properties":{"id":"20240611144647-1ij9w7t","updated":"20240611144647"},"Children":[{"Type":"NodeText","Data":"雷论。凡使于槐砧挫细。勿犯铁器。"}]},{"ID":"20240611144622-dexkhzk","Type":"NodeThematicBreak","Properties":{"id":"20240611144622-dexkhzk"}},{"ID":"20240611144636-i9s9q6q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144636-i9s9q6q","updated":"20240611144640"},"Children":[{"Type":"NodeText","Data":"知母《长沙药解》"}]},{"ID":"20240611144636-ehh6rx0","Type":"NodeParagraph","Properties":{"id":"20240611144636-ehh6rx0","updated":"20240611144636"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主消渴，热中，除邪气，肢体浮肿，下水，补不足，益气。"}]},{"ID":"20240611144636-q1gqvxf","Type":"NodeParagraph","Properties":{"id":"20240611144636-q1gqvxf","updated":"20240611144636"},"Children":[{"Type":"NodeText","Data":"味苦，气寒，入手太阴肺、足太阳膀胱经。清金泻热，止渴除烦。"}]},{"ID":"20240611144636-ihd5syv","Type":"NodeParagraph","Properties":{"id":"20240611144636-ihd5syv","updated":"20240611144636"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白虎汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在石膏。"},{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酸枣仁汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在枣仁。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝芍药知母汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在桂枝。"},{"Type":"NodeText","Data":"并用之，以其清金而泻火，润燥而除烦也。"}]},{"ID":"20240611144636-it7r7s2","Type":"NodeParagraph","Properties":{"id":"20240611144636-it7r7s2","updated":"20240611144636"},"Children":[{"Type":"NodeText","Data":"知母苦寒之性，专清心肺而除烦躁，仲景用之，以泻上焦之热也。甚败脾胃而泻大肠，火衰土湿，大便不实者忌之。后世庸工，以此通治内伤诸病，滋水灭火，误人性命，至今未绝。其诸主治，泻大肠，清膀胱。"}]},{"ID":"20240611144622-89ksvbl","Type":"NodeThematicBreak","Properties":{"id":"20240611144622-89ksvbl"}},{"ID":"20240611144623-53akdnx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144623-53akdnx","updated":"20240611144629"},"Children":[{"Type":"NodeText","Data":"知母《本草备要》"}]},{"ID":"20240611144623-9nyyvtb","Type":"NodeParagraph","Properties":{"id":"20240611144623-9nyyvtb","updated":"20240611144623"},"Children":[{"Type":"NodeText","Data":"泻火补水，润燥滑肠"}]},{"ID":"20240611144623-d1perz3","Type":"NodeParagraph","Properties":{"id":"20240611144623-d1perz3","updated":"20240611144623"},"Children":[{"Type":"NodeText","Data":"辛苦寒滑。上清肺金而泻火（泻胃热、膀胱邪热、肾命相火），下润肾燥而滋阴，入二经气分（黄柏入二经血分，故二药必相须而行）。消痰定嗽，止渴安胎（莫非清火之用）。"}]},{"ID":"20240611144623-v147tcw","Type":"NodeParagraph","Properties":{"id":"20240611144623-v147tcw","updated":"20240611144623"},"Children":[{"Type":"NodeText","Data":"治伤寒烦热，蓐劳（产劳）骨蒸（退有汗之骨蒸），燥渴虚烦，久疟下痢（治嗽者，清肺火也。治渴者，清胃热也。退骨蒸者，泻肾火也），利二便，消浮肿（小便利则肿消。东垣曰∶热在上焦气分，结秘而渴，乃肺中伏热，不能生水，膀胱绝其化源。宜用渗湿之药，泻火清金，滋水之化源。热在下焦血分，便闭而不渴，乃真水不足，膀胱干涸，无阴则阳无以化。宜用黄柏、知母大苦寒之药，滋肾与膀胱之阴。而阳自化，小便自通。丹溪曰∶小便不通，有热有湿，有气结于下，宜清、宜燥、宜升。又有隔二隔三之治∶如肺不燥，但膀胱热，宜泻膀胱，此正治；如因肺热不能生水，则清肺，此隔二之治；如因脾湿不运而精不上升，故肺不能生水，则燥胃健脾，此隔三之治。泻膀胱，黄柏、知母之类；清肺，车前、茯苓之类；燥脾，二术之类。昂按∶凡病皆有隔二隔三之治，不独便闭也）。然苦寒伤胃而滑肠，多服令人泻（李士材曰∶苦寒肃杀，非长养万物者也。世以其滋阴，施之虚损之人，则如水益深矣，特表出以为戒）。"}]},{"ID":"20240611144623-4z58887","Type":"NodeParagraph","Properties":{"id":"20240611144623-4z58887","updated":"20240611144623"},"Children":[{"Type":"NodeText","Data":"得酒良。上行酒浸，下行盐水拌。忌铁。"}]},{"ID":"20240611144533-ro2ftj6","Type":"NodeThematicBreak","Properties":{"id":"20240611144533-ro2ftj6"}},{"ID":"20240611144535-d8fbvnw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144535-d8fbvnw","updated":"20240611144542"},"Children":[{"Type":"NodeText","Data":"知母《本经逢原》"}]},{"ID":"20240611144535-rwosk8z","Type":"NodeParagraph","Properties":{"id":"20240611144535-rwosk8z","updated":"20240611144535"},"Children":[{"Type":"NodeText","Data":"苦平寒，无毒。肥白者良。盐、酒炒用。"}]},{"ID":"20240611144535-4bpg8xi","Type":"NodeParagraph","Properties":{"id":"20240611144535-4bpg8xi","updated":"20240611144535"},"Children":[{"Type":"NodeText","Data":"《本经》主消渴热中除邪气，肢体浮肿下水，补不足益气。"}]},{"ID":"20240611144535-ll7ebvm","Type":"NodeParagraph","Properties":{"id":"20240611144535-ll7ebvm","updated":"20240611144613"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明 "},{"Type":"NodeText","Data":"知母沉降入足少阴气分，及足阳明，手足太阴，能泻有余相火，理消渴烦蒸。仲景白虎汤、酸枣汤皆用之，下则润肾燥而滋阴，上则清肺热而除烦。但外感表证未除、泻痢燥渴忌之，脾胃虚热人误服，令人作泻减食，故虚损大忌。近世误为滋阴上剂、劳瘵神丹，因而夭枉者多矣。《本经》言除邪气，肢体浮肿，是指湿热水气而言。故下文云，下水补不足，益气，乃湿热相火有余，烁灼精气之候，故用此清热养阴，邪热去则正气复矣。"}]},{"ID":"20240611144134-iimtoxo","Type":"NodeThematicBreak","Properties":{"id":"20240611144134-iimtoxo"}},{"ID":"20240611144523-4qer6dv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144523-4qer6dv","updated":"20240611144526"},"Children":[{"Type":"NodeText","Data":"知母《冯氏锦囊秘录》"}]},{"ID":"20240611144523-p4lp42l","Type":"NodeParagraph","Properties":{"id":"20240611144523-p4lp42l","updated":"20240611144523"},"Children":[{"Type":"NodeText","Data":"禀天地至阴之气，故味苦微甘，气寒而无毒，入手太阴、足少阴经。入清热药用宜生。入滋肾药用宜盐酒拌炒。"}]},{"ID":"20240611144523-a78l4pz","Type":"NodeParagraph","Properties":{"id":"20240611144523-a78l4pz","updated":"20240611144523"},"Children":[{"Type":"NodeText","Data":"知母，补肾水，泻无根火邪，消浮肿，为利小便佐使。初痢脐下痛者能却，久疟烦热甚者堪除。治有汗骨蒸热痨，疗往来传尸疰病。润燥解渴，止渴消痰，上清肺金而泻火，下润肾燥而滋阴，为三经气分药，久服不宜，令人作泻。"}]},{"ID":"20240611144523-4dnl7js","Type":"NodeParagraph","Properties":{"id":"20240611144523-4dnl7js","updated":"20240611144523"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 治痘阴火上潮，诸热不退，口渴好饮冷水，泻气分中之火。然疹家多用治痘，惟宜于痘后养阴退阳。"}]},{"ID":"20240611144523-4ieniyo","Type":"NodeParagraph","Properties":{"id":"20240611144523-4ieniyo","updated":"20240611144523"},"Children":[{"Type":"NodeText","Data":"按∶知母，泻肾经有余之火，惟狂阳亢甚者宜之。若肾虚而泻之，则愈虚而虚火愈甚，况寒能伤胃，润能滑肠，其害人也隐而深，譬诸小人，阴柔巽顺，深受其祸，莫觉其非也。"}]},{"ID":"20240611144244-fvngpgp","Type":"NodeThematicBreak","Properties":{"id":"20240611144244-fvngpgp"}},{"ID":"20240611144508-dh8cz6b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144508-dh8cz6b","updated":"20240611144515"},"Children":[{"Type":"NodeText","Data":"知母《本草便读》"}]},{"ID":"20240611144508-0sltui2","Type":"NodeParagraph","Properties":{"id":"20240611144508-0sltui2","updated":"20240611144508"},"Children":[{"Type":"NodeText","Data":"退肾脏有余之阳．能壮水清金．甘苦微辛质浓滑．清阳明独胜之热．治风消燥咳．沉阴且降气纯寒．（知母味苦．微带辛甘．气寒质润．气味俱浓．沉也阴也．故能入足少阴肾经．清有余之相火．以其色白味甘．故又能清肺火．除胃热．然阴寒润滑之品．过用则有妨脾胃耳．按知母须肺胃肾三经火盛阴亏之证．或热中消渴者．乃可用之．不可但知滋阴之功．而忘其损阳之害也．）"}]},{"ID":"20240611144245-4y4hocc","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-4y4hocc"}},{"ID":"20240611144500-52vgzt1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144500-52vgzt1","updated":"20240611144504"},"Children":[{"Type":"NodeText","Data":"知母《本草求真》"}]},{"ID":"20240611144500-mf87jk2","Type":"NodeParagraph","Properties":{"id":"20240611144500-mf87jk2","updated":"20240611144500"},"Children":[{"Type":"NodeText","Data":"（山草）治肺久伏热邪以清化"}]},{"ID":"20240611144500-k7dvl98","Type":"NodeParagraph","Properties":{"id":"20240611144500-k7dvl98","updated":"20240611144500"},"Children":[{"Type":"NodeText","Data":"知母（专入肺。兼入肾）。辛苦微滑。能佐黄柏以治膀胱热邪。缘人水肿癃闭。本有属血属气之分。肺伏热邪。不能生水。膀胱绝其化源。便秘而渴。此当清肺以利水者也。热结膀胱。真阴干涸。阳无以化。便秘不渴。此当清膀胱以导湿者也。黄柏气味纯寒。虽能下行以除膀胱湿热。但肺金不肃。则化源无滋。又安能上达于肺而得气分俱肃乎？知母味辛而苦。沉中有浮。降中有升。既能下佐黄柏以泄肾水。复能上行以润心肺。（汪昂曰。黄柏入二经血分。故二药必相须而行。）俾气清肺肃。而湿热得解。是以昔人有云。黄柏无知母。犹水母之无虾。诚以见其金水同源。子母一义。不可或离之义。（震亨曰。小便不通。有热有湿有气结于下。宜清宜燥宜升。又有隔二隔三之治。如肺不燥但膀胱热。宜泻膀胱。此正治。如因肺热不能生水。则清肺。此隔二之治。如因脾湿不运而津不上升。故肺不能生水。则燥胃健脾。此隔三之治。泻膀胱黄柏知母之类。清肺车前茯苓之类。燥脾二术之类。）故书皆言用此在上则能清肺止渴。却头痛。润心肺。解虚烦喘嗽。吐血衄血。去喉中腥臭。在中则能退胃火。平消瘅。在下则能利小水。润大肠。去膀胱肝肾湿热。腰脚肿痛。并治痨瘵内热。阴火热淋崩渴等症。若谓力能补阴。则大谬矣。（补阴惟地黄为首。）景岳谓此性最沉寒。本无生气。用以清火则可。（的解）用以补阴。则何补之有。第其阴柔巽顺。似乎有德。犹之小人在朝。国家元气受其剥削。而有阴移而莫之觉者。是不可不见之真而辨之早也。读此可为妄用知母黄柏一箴。得酒良。上行酒浸。下行盐水拌。忌铁。"}]},{"ID":"20240611144245-etkelcl","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-etkelcl"}},{"ID":"20240611144450-yhd06i8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144450-yhd06i8","updated":"20240611144455"},"Children":[{"Type":"NodeText","Data":"知母《千金翼方》"}]},{"ID":"20240611144450-las3uox","Type":"NodeParagraph","Properties":{"id":"20240611144450-las3uox","updated":"20240611144450"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴热中，除邪气，肢体浮肿，下水，补不足，益气，疗伤寒久疟，烦热，胁下邪气，膈中恶，及风汗内疸，多服令人泻。一名 母，一名连母，一名野蓼，一名地参，一名水参，一名水浚，一名货母，一名 母，一名女雷，一名女理，一名儿草，一名鹿列，一名韭逢，一名儿踵草，一名东根，一名水须，一名沉燔，一名 。生河内川谷，二月八月采根，曝干。"}]},{"ID":"20240611144245-mdmtrb2","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-mdmtrb2"}},{"ID":"20240611144441-0innx49","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144441-0innx49","updated":"20240611144445"},"Children":[{"Type":"NodeText","Data":"知母《本草经解》"}]},{"ID":"20240611144441-a1bw6zf","Type":"NodeParagraph","Properties":{"id":"20240611144441-a1bw6zf","updated":"20240611144441"},"Children":[{"Type":"NodeText","Data":"气寒．味苦．无毒．主消渴热中．除邪气．肢体浮肿．下水．补不足．益气．（去毛盐水炒）"}]},{"ID":"20240611144441-2t9pib0","Type":"NodeParagraph","Properties":{"id":"20240611144441-2t9pib0","updated":"20240611144441"},"Children":[{"Type":"NodeText","Data":"知母气寒．禀天冬寒之水气．入足少阴肾经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．肾属水．心属火．水不制火．火烁津液．则病消渴．火熏五内．则病热中．其苦之者．苦清心火．寒滋肾水也．除邪气者．苦寒之味．能除燥火之邪气也．热胜则浮．火胜则肿．苦能清火．寒能退热．故主肢体浮肿也．肾者水藏．其性恶燥．燥则开合不利．而水反蓄矣．知母寒滑．滑利关门而水自下也．补不足者．苦寒补寒水之不足也．益气者．苦寒益五脏之阴气也．"}]},{"ID":"20240611144441-2w9bkrh","Type":"NodeParagraph","Properties":{"id":"20240611144441-2w9bkrh","updated":"20240611144441"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611144441-bsyrn1f","Type":"NodeParagraph","Properties":{"id":"20240611144441-bsyrn1f","updated":"20240611144441"},"Children":[{"Type":"NodeText","Data":"知母同麦冬、石膏、贝母、陈皮、鳖甲、青蒿、牛膝．治久疟烦渴．同桂枝、白芍、甘草、饴糖．治脾虚胃热．多食而烦．同牛膝、生地、白芍、甘草、桂枝、桑枝．治手足牵引．夜卧不安．同白芍、花粉、甘草、桂枝．治柔痉．惊呼不安卧．同黄柏、车前、木通、天冬、甘草．治强阳不痿．"}]},{"ID":"20240611144245-mk7runr","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-mk7runr"}},{"ID":"20240611144428-gaiate8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144428-gaiate8","updated":"20240611144434"},"Children":[{"Type":"NodeText","Data":"知母《证类本草》"}]},{"ID":"20240611144428-158l4ka","Type":"NodeParagraph","Properties":{"id":"20240611144428-158l4ka","updated":"20240611144428"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴热中，除邪气，肢体浮肿，下水，补不足，益气，疗伤寒，久疟，烦热，胁下邪气，膈中恶及风汗、内疸。多服令人泄。一名 （音歧）母，一名连母，一名野蓼，一名地参，一名水参，一名水浚，一名货母，一名 （音匙，又音提）母，一名女雷，一名女理，一名儿草，一名鹿列，一名韭逢，一名儿踵草，一名东根，一名水须，一名沉燔，一名 （杜含切），臣禹锡等谨按唐本一名昌支。生河内川谷。二月、八月采根，曝干。"}]},{"ID":"20240611144428-otqq8g9","Type":"NodeParagraph","Properties":{"id":"20240611144428-otqq8g9","updated":"20240611144428"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出彭城。形似菖蒲而柔润，叶至难死。掘出随生，须枯燥乃止。甚疗熟结，亦主疟热烦也。臣禹锡等谨按尔雅云∶ ， 藩。释曰∶知母也，一名 ，一名 藩。郭云∶生山上，叶如韭。范子云∶提母出三辅，黄白者善。吴氏云∶知母，神农、桐君∶无毒，补不足，益气。药性论云∶知母，君，性平。主治心烦躁闷，骨热劳往来，生产后蓐劳，肾气劳，憎寒虚损，患人虚而口干，加而用之。日华子云∶味苦、甘。治热劳，传尸疰病，通小肠，消痰止嗽，润心肺，补虚乏，安心，止惊悸。"}]},{"ID":"20240611144428-fc80syk","Type":"NodeParagraph","Properties":{"id":"20240611144428-fc80syk","updated":"20240611144428"},"Children":[{"Type":"NodeText","Data":"图经曰∶知母，生河内川谷，今濒河诸郡及解州、滁州亦有之。根黄色，似菖蒲而柔润。"}]},{"ID":"20240611144428-855gubt","Type":"NodeParagraph","Properties":{"id":"20240611144428-855gubt","updated":"20240611144428"},"Children":[{"Type":"NodeText","Data":"叶至难死，掘出随生，须燥乃止。四月开青花如韭花，八月结实。二月、八月采根曝干用。《尔雅》谓之 （徙南切），又谓之KT （直林切）藩是也。《肘后方》用此一物治溪毒大胜。"}]},{"ID":"20240611144428-ebwal3m","Type":"NodeParagraph","Properties":{"id":"20240611144428-ebwal3m","updated":"20240611144428"},"Children":[{"Type":"NodeText","Data":"其法∶连根、叶捣作散服之。亦可投水捣绞汁，饮一、二升。夏月出行，多取此屑自随。欲入水，先取少许投水上流，便无畏。兼辟射工，亦可和水作汤浴之，甚佳。"}]},{"ID":"20240611144428-cx1wb9l","Type":"NodeParagraph","Properties":{"id":"20240611144428-cx1wb9l","updated":"20240611144428"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，先于砧上细锉，焙干，木臼杵捣，勿令犯铁器。圣惠方∶治妊娠月未足似欲产，腹中痛。用知母二两末，蜜丸如梧桐子大，不计时候，粥饮下二十丸。《杨氏产乳》同。"}]},{"ID":"20240611144245-9eq5xkj","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-9eq5xkj"}},{"ID":"20240611144413-uvoe9b1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144413-uvoe9b1","updated":"20240611144418"},"Children":[{"Type":"NodeText","Data":"知母《医学入门》"}]},{"ID":"20240611144413-ccpms5g","Type":"NodeParagraph","Properties":{"id":"20240611144413-ccpms5g","updated":"20240611144413"},"Children":[{"Type":"NodeText","Data":"知母苦寒润心肺，补肾泻火更清胃，劳蒸渴嗽止疟斑，兼利小肠消肿溃。"}]},{"ID":"20240611144413-09h7w7u","Type":"NodeParagraph","Properties":{"id":"20240611144413-09h7w7u","updated":"20240611144413"},"Children":[{"Type":"NodeText","Data":"补阴药用之，以其能知血之母也。无毒。沉而降，阴中阴也。入足阳明、手太阴，足少阴本药。润心肺，滋化源，止惊悸，下气消痰。泻肾火、胃火之圣药。内伤虚劳，阳盛有汗，骨蒸热劳，往来传尸疰病，消渴口干，咳嗽，伤寒，久疟，烦热发斑皆治。兼通小肠，除邪气，肢体浮肿及胁膈中恶，风汗内疸，妊娠腹痛，产后蓐劳，辟射工溪毒。经云∶多服令人泄。凡肺中寒嗽，肾气虚脱，无火症而尺脉微弱者禁用。去皮，补药盐水或蜜水蒸，或炒，上行酒炒。忌铁器。"}]},{"ID":"20240611144245-rk4l8fh","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-rk4l8fh"}},{"ID":"20240611144344-98ntjxc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144344-98ntjxc","updated":"20240611144344"},"Children":[{"Type":"NodeText","Data":"知母"}]},{"ID":"20240611144344-8oivcoe","Type":"NodeParagraph","Properties":{"id":"20240611144344-8oivcoe","updated":"20240611144344"},"Children":[{"Type":"NodeText","Data":"无毒．主治伤寒久疟烦热，胁下邪气，膈中恶，及风汗内疸．多服令人泄．一名女雷一名女理，一名儿草，一名鹿列，一名韭逢，一名儿踵草，一名东根，一名水须，一名沈燔，一名 ．生河内．二月、八月采根，曝干．"}]},{"ID":"20240611144344-u1lelra","Type":"NodeParagraph","Properties":{"id":"20240611144344-u1lelra","updated":"20240611144405"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶知母，味苦，寒．主消渴热中，除邪气，肢体浮肿，下水，补不足，益气．一名[]母，一名[]母．生川谷．"}]},{"ID":"20240611144245-l9abrg8","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-l9abrg8"}},{"ID":"20240611144330-mwxbhdu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144330-mwxbhdu","updated":"20240611144334"},"Children":[{"Type":"NodeText","Data":"知母《神农本草经读》"}]},{"ID":"20240611144330-fd73h55","Type":"NodeParagraph","Properties":{"id":"20240611144330-fd73h55","updated":"20240611144330"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主消渴热中，除邪气，肢体浮肿，下水，补不足，益气。"}]},{"ID":"20240611144330-e0yrujs","Type":"NodeParagraph","Properties":{"id":"20240611144330-e0yrujs","updated":"20240611144330"},"Children":[{"Type":"NodeText","Data":"叶天士曰∶知母气寒，禀水气而入肾；味苦无毒，得火味而入心。肾属水，心属火，水不制火，火烁津液，则病消渴；火熏五内，则病热中；其主之者，苦清心火，寒滋肾水也。除邪气者，苦寒之气味能除燥火之邪气也。热胜则浮，火胜则肿；苦者清火，寒能退热，故主肢体浮肿也。肿者水脏，其性恶燥，燥则开合不利而水反蓄矣。知母寒滑，滑利关门而水自下也。补不足者，苦寒补寒水之不足也。益气者，苦寒益五脏之阴气也。"}]},{"ID":"20240611144330-86jsedr","Type":"NodeParagraph","Properties":{"id":"20240611144330-86jsedr","updated":"20240611144330"},"Children":[{"Type":"NodeText","Data":"愚按∶《金匮》有桂枝芍药知母汤，治肢节疼痛、身体羸、脚肿如脱，可知长沙诸方，皆从《本经》来也。"}]},{"ID":"20240611144245-oxmlp6u","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-oxmlp6u"}},{"ID":"20240611144316-s4yehf5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144316-s4yehf5","updated":"20240611144324"},"Children":[{"Type":"NodeText","Data":"知母《本草述钩元》"}]},{"ID":"20240611144316-l3ipkxb","Type":"NodeParagraph","Properties":{"id":"20240611144316-l3ipkxb","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"形似菖蒲而柔润。叶至难死。掘出复生。须枯燥乃止。（即此可知为至阴之味）二八月采根。曝干用。"}]},{"ID":"20240611144316-jqe2hyz","Type":"NodeParagraph","Properties":{"id":"20240611144316-jqe2hyz","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"根气寒味甘。大苦兼辛。气味俱浓。沉而降。阴也。又云。阴中微阳。肾经本叶。入足阳明手太阴经气分。本经主消渴热中。除邪热。肢体浮肿下水。补不足益气。诸本草泻膀胱热。肾之邪火有余。滋肾阴。除肺热。疗肾虚火炎肺嗽。或心烦躁闷。并治足阳明火热。伤寒久疟。烦热及骨。热劳往来。肾气劳损。憎寒虚烦。又安胎。止子烦。并产后蓐劳。久服泄。方书治喘淋口病。中风伤暑。发热呕吐。头痛腰痛。小便不通。伤燥热厥。呃逆嗖血。"}]},{"ID":"20240611144316-mfrdmab","Type":"NodeParagraph","Properties":{"id":"20240611144316-mfrdmab","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"身体痛痹。痿厥香港脚。螈烦悸。盗汗不得卧。怠惰嗜卧不能食。遗精诸证。知母禀天一水德。体用具备。故主濡润燥渴。对待热中。其润下水道者。缘水得母气。母气之脏真高于肺。"}]},{"ID":"20240611144316-84akr32","Type":"NodeParagraph","Properties":{"id":"20240611144316-84akr32","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"以行营卫阴阳。乃能游溢通调转输决渍耳。（之颐）知母其用有四。泻无根之肾火。疗有汗之骨蒸。止虚劳之热。滋化源之阴。仲景用入白虎。治不得眠者。烦躁也。烦出于肺。躁出于肾。故君以石膏。佐以知母。清肾之源。缓以粳甘。使不速下也。凡病小便闭塞而渴者。"}]},{"ID":"20240611144316-gn21c10","Type":"NodeParagraph","Properties":{"id":"20240611144316-gn21c10","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"热在上焦气分。宜清肺中伏热。用气味俱薄之药以滋化源。若热在下焦血分而不渴者。宜滋真水。使阴气行而阳自化。用黄柏知母是也。（东垣）知母下润肾燥而滋阴。上清肺金而泻火。乃二经气分药。黄柏则是肾经血分药。故二药必相须而行。（濒湖）与茯苓同用。清下焦热。与黄芩同用。清上焦热。（希周）入白虎汤。解伤寒阳明证。口渴头疼。烦热。鼻干不得眠。加竹叶麦冬。名竹叶石膏汤。治阳明经前证。大渴饮引头疼欲破。因作劳而得者。"}]},{"ID":"20240611144316-0hpbvkl","Type":"NodeParagraph","Properties":{"id":"20240611144316-0hpbvkl","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"加人参。名人参白虎汤。汗后烦热不解。亦用之。同麦冬石膏贝母橘红鳖甲青蒿牛膝。治久疟烦热而渴。同贝母天冬麦冬沙参甘草桑白皮枇杷叶五味子百部。治阴虚咳嗽。同黄柏车前木通附方久近痰嗽。自胸膈下塞停饮。至于脏腑。用知母贝母各一两。为末。巴豆三十枚。"}]},{"ID":"20240611144316-ka0vjne","Type":"NodeParagraph","Properties":{"id":"20240611144316-ka0vjne","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"去油。研匀。每服一字。用姜三片。二面蘸药。细嚼咽下。便睡。次早必泻一行。其嗽立止。"}]},{"ID":"20240611144316-lj392b9","Type":"NodeParagraph","Properties":{"id":"20240611144316-lj392b9","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"壮人乃用之。（一方不用巴豆）久嗽气急。知母去毛切五钱。隔纸炒。杏仁五钱。姜水泡去皮尖焙。以水一钟半。煎一钟。食远温服。次以萝卜子杏仁。等分为末。米糊丸。服五十丸。"}]},{"ID":"20240611144316-mqcs4um","Type":"NodeParagraph","Properties":{"id":"20240611144316-mqcs4um","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"姜汤下。以绝命根。"}]},{"ID":"20240611144316-yv1lcwn","Type":"NodeParagraph","Properties":{"id":"20240611144316-yv1lcwn","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"〔论〕知母苦寒相合。固为肾剂。第其味甘而苦。苦复兼辛。虽苦居其胜。然以甘始而以辛终。不谓之入肺胃气分不可也。（四月花则气畅于火。八月实则气孕于金。）本经谓其补不足益气。乃从除邪气肢体浮肿下水来。厥有深旨。经曰。三焦者中渎之府。水道出焉。属膀胱。是孤之府也。是六腑之所与合者。夫三焦相火。本气之元。乃属膀胱而行水化。膀胱固属肾也。经又云。二阴至肺。其气归膀胱。外连脾胃合之。所谓饮入于胃。游溢输脾。脾气散精。上归于肺。通调水道。下输膀胱。水精四布。五经并行。不即可明于除邪气肢体浮肿之义乎。盖水化即气化也。兹味之功。由胃肺合而致其苦寒之用于上。即由肺胃合而达其苦寒之化于下。故能泻膀胱热及肾之相火有余者。本经即下水以明其补不足益气。正以由阳滋阴。即由阴存阳。与所言阴虚则无气。无气则死之旨合也。至如火炎肺嗽。消渴热中。心烦躁闷。肾气劳损。热劳（患人虚而口干者加用之）骨蒸等病。皆因清热以致其益气之功。"}]},{"ID":"20240611144316-itene23","Type":"NodeParagraph","Properties":{"id":"20240611144316-itene23","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"不止于以寒对热而已。又伤寒久疟。有伤于后天气血。以累及先天。必借此金水滋生之味。"}]},{"ID":"20240611144316-i5b6bb0","Type":"NodeParagraph","Properties":{"id":"20240611144316-i5b6bb0","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"乃可胜邪热而还真阴。盖天一真阴。实后天生气之元。经所云益气者此耳。但苦寒性味。用者当审所宜。勿致反损中土生气。而绝阴化于阳之本也。"}]},{"ID":"20240611144316-rkhuxp1","Type":"NodeParagraph","Properties":{"id":"20240611144316-rkhuxp1","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"缪氏曰。阳痿及易举易痿。脾弱不消。胃虚不纳。肾虚溏泄等证。法并禁用。"}]},{"ID":"20240611144316-dwqgwgk","Type":"NodeParagraph","Properties":{"id":"20240611144316-dwqgwgk","updated":"20240611144316"},"Children":[{"Type":"NodeText","Data":"〔修治〕拣肥润裹白者。去毛切。上行用酒浸焙干。下行则盐水润焙。勿犯铁器。"}]},{"ID":"20240611144245-8ao7mcf","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-8ao7mcf"}},{"ID":"20240611144300-76be5jc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144300-76be5jc","updated":"20240611144304"},"Children":[{"Type":"NodeText","Data":"知母《要药分剂》"}]},{"ID":"20240611144300-0zvppzv","Type":"NodeParagraph","Properties":{"id":"20240611144300-0zvppzv","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"味苦。性寒。无毒。禀天地至阴之气而生。降也。阴也。得黄柏及酒良。伏盐、硼砂。忌铁器。"}]},{"ID":"20240611144300-5z5ondj","Type":"NodeParagraph","Properties":{"id":"20240611144300-5z5ondj","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"【主治】主消渴热中。除邪气。肢体浮肿。下水。补不足。益气。（本经）疗伤寒久疟烦热。"}]},{"ID":"20240611144300-74gi03e","Type":"NodeParagraph","Properties":{"id":"20240611144300-74gi03e","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"蓐劳。"}]},{"ID":"20240611144300-ktumwjv","Type":"NodeParagraph","Properties":{"id":"20240611144300-ktumwjv","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"凉心清肺金。"}]},{"ID":"20240611144300-aftiyff","Type":"NodeParagraph","Properties":{"id":"20240611144300-aftiyff","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"【归经】入肺肾二经。为泻火滋水之品。（兼补剂滑剂肺肾气分药专泻肾家有余之火）【前论】东垣曰。凡热在上焦气分。便秘而渴。乃肺中伏热。不能生水。膀胱绝其化源。"}]},{"ID":"20240611144300-6crkuqo","Type":"NodeParagraph","Properties":{"id":"20240611144300-6crkuqo","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"宜用淡渗之品。泻火清金。滋水之化源。热在下焦涸。无阴则阳无以化知母入肺肾气分。"}]},{"ID":"20240611144300-8uphgrq","Type":"NodeParagraph","Properties":{"id":"20240611144300-8uphgrq","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。阳痿。及易举易痿。泄泻。脾弱饮食不消化。胃虚不思食。肾虚溏泄。"}]},{"ID":"20240611144300-merqm1c","Type":"NodeParagraph","Properties":{"id":"20240611144300-merqm1c","updated":"20240611144300"},"Children":[{"Type":"NodeText","Data":"均【炮制】时珍曰。凡使。欲引经上行。酒浸焙。欲下行。盐水润焙。"}]},{"ID":"20240611144245-t0t7hew","Type":"NodeThematicBreak","Properties":{"id":"20240611144245-t0t7hew"}},{"ID":"20240611144247-g80r0mj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144247-g80r0mj","updated":"20240611144252"},"Children":[{"Type":"NodeText","Data":"知母《本草新编》"}]},{"ID":"20240611144247-ttnymm2","Type":"NodeParagraph","Properties":{"id":"20240611144247-ttnymm2","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"知母，味苦、辛，气大寒，沉而降，阴也，无毒。入足少阴、阳明，又入手太阴。最善泻胃、肾二经之火，解渴止热，亦治久疟。此物只可暂用，而不可久服。丹溪加入六味丸中，亦教人暂服，以泻肾中浮游之火，非教人长服也。近世竟加知母、黄柏，谓是退阴虚火热之圣方，令人经年长用，以致脾胃虚寒，不能饮食，成痨成瘵者，不知几千万人矣。幸薛立斋、赵养葵论知母过寒，切戒久食，实见到之语，有功于世。总之，此物暂用，以泻胃中之火，实可夺命；久用，以补肾中之水，亦能促命。谓知母竟可杀人，固非立论之纯，谓知母全可活人，亦非持说之正也。"}]},{"ID":"20240611144247-s13vf4b","Type":"NodeParagraph","Properties":{"id":"20240611144247-s13vf4b","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"或问知母泻肾，肾有补而无泻，不可用知母，宜也。若用之以泻胃，似可常用，何吾子亦谓只可暂用乎？曰∶胃火又何可常泻也，五脏六腑皆仰藉于胃，胃气存则生，胃气亡则死。胃中火盛，恐其消烁津液，用石膏、知母以救胃，非泻胃也。然而石膏过于峻削，知母过于寒凉，胃火虽救，而胃土必伤，故亦宜暂用以解氛，断不宜常用以损气也。（〔批〕胃为肾之关门，胃与肾，俱不可用石膏久泻其火，胃寒则肾亦寒也。）"}]},{"ID":"20240611144247-h1758od","Type":"NodeParagraph","Properties":{"id":"20240611144247-h1758od","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"或问知母古人皆言是补肾滋阴妙药，吾子乃言是泻火之味，此余所以疑也。不知母疑也。"}]},{"ID":"20240611144247-ee3werr","Type":"NodeParagraph","Properties":{"id":"20240611144247-ee3werr","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"天下味温者能益人，未闻苦寒者而亦益也。知母苦而大寒，其无益于脾胃，又何必辨。惟是既无益于脾胃，何以泻胃中之火，能夺命于须臾乎。似乎泻即补之之义也。然而暂用何以相宜，久用何以甚恶？是泻火只可言救肾。而终不可言补肾也。（〔批〕用知母以救肾，非用知母以补肾，分别独妙。）"}]},{"ID":"20240611144247-61ywr8r","Type":"NodeParagraph","Properties":{"id":"20240611144247-61ywr8r","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"或问知母性过寒凉，久服损胃，何不改用他药以救胃，而白虎汤中必用知母，以佐石膏之横，不以寒济寒乎？嗟乎。何问之善也。夫白虎汤，乃治胃火之初起，单用石膏以救胃，犹恐不胜，故又加知母，以止其肾中之火，使胃火之不增焰也。若胃火已炽之后与将衰之时，知母原不必加入之也。或去知母，而易之天冬、元参之味，亦未为不可也。"}]},{"ID":"20240611144247-czdspcl","Type":"NodeParagraph","Properties":{"id":"20240611144247-czdspcl","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"或问知母、黄柏用之于六味丸中，朱丹溪之意以治阴虚火动也，是岂无见者乎？嗟乎。"}]},{"ID":"20240611144247-9fevljs","Type":"NodeParagraph","Properties":{"id":"20240611144247-9fevljs","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"阴虚火动，六味汤治之足矣，何必又用知母、黄柏以泻火乎。夫火之有余，因水之不足也，补其水，则火自息矣。丹溪徒知阴虚火动之义，而加入二味，使后人胶执而专用之，或致丧亡，非所以救天下也。"}]},{"ID":"20240611144247-1i47au3","Type":"NodeParagraph","Properties":{"id":"20240611144247-1i47au3","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"或问知母既不宜轻用，何不竟删去之，乃既称其功，又辟其过耶？嗟乎。吾言因丹溪而发，岂谓知母之等于鸠毒哉。盖知母止可用之以泻胃火之有余，而不可用之以泻肾火之不足，故泻胃火则救人，而泻肾火则杀人也。丹溪止主泻肾，而不主泻胃，此生死之大关，不可不辨也。"}]},{"ID":"20240611144247-wyggx3q","Type":"NodeParagraph","Properties":{"id":"20240611144247-wyggx3q","updated":"20240611144247"},"Children":[{"Type":"NodeText","Data":"或问李时珍发明知母是气分之药，黄柏是血分之药。黄柏入肾，而不入肺；知母下润肾，而上清肺金，二药必相须而行，譬之虾之不能离水母也。是黄柏、知母，必须同用为佳，而吾子谓二药不可共用，得毋时珍非欤？曰∶时珍殆读书而执者也。不知黄柏未尝不入气分，而知母未尝不入血分也。黄柏清肾中之火，亦能清肺中之火；知母泻肾中之热，而亦泻胃中之热。胃为多气多血之腑，岂止入于气分，而不入于血分耶？是二药不必兼用，不可即此而悟哉"}]},{"ID":"20240611144134-70wwo3d","Type":"NodeThematicBreak","Properties":{"id":"20240611144134-70wwo3d"}},{"ID":"20240611144143-wr9vizw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144143-wr9vizw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"《中国药典》：知母"}]},{"ID":"20240611144143-kadq0ps","Type":"NodeParagraph","Properties":{"id":"20240611144143-kadq0ps","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611144143-gds2i6r","Type":"NodeParagraph","Properties":{"id":"20240611144143-gds2i6r","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" Zhī Mǔ"}]},{"ID":"20240611144143-ys6ebaf","Type":"NodeParagraph","Properties":{"id":"20240611144143-ys6ebaf","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611144143-j3xnk13","Type":"NodeParagraph","Properties":{"id":"20240611144143-j3xnk13","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 蒜辫子草、羊胡子根、地参"}]},{"ID":"20240611144143-pt4b83t","Type":"NodeParagraph","Properties":{"id":"20240611144143-pt4b83t","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611144143-038n4rj","Type":"NodeParagraph","Properties":{"id":"20240611144143-038n4rj","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" RHIZOMA ANEMARRHENAE"}]},{"ID":"20240611144143-d73uzg0","Type":"NodeParagraph","Properties":{"id":"20240611144143-d73uzg0","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611144143-i0zubwn","Type":"NodeParagraph","Properties":{"id":"20240611144143-i0zubwn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 本品为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"知母"},{"Type":"NodeText","Data":"Anemarrhena asphodeloides Bunge.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去须根及泥沙，晒干，习称“毛知母”；或除去外皮，晒干。"}]},{"ID":"20240611144143-l7x1a4p","Type":"NodeParagraph","Properties":{"id":"20240611144143-l7x1a4p","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611144143-bbjlhdy","Type":"NodeParagraph","Properties":{"id":"20240611144143-bbjlhdy","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 本品呈长条状，微弯曲，略扁，偶有分枝，长3～15cm,直径0.8～1.5cm，一端有浅黄色的茎叶残痕。表面黄棕色至棕色，上面有一凹沟，具紧密排列的环状节，节上密生黄棕色的残存叶基，由两侧向根茎上方生长；下面隆起而略皱缩，并有凹陷或突起的点状根痕。质硬，易折断，断面黄白色。气微，味微甜、略苦，嚼之带黏性。"}]},{"ID":"20240611144143-ho3hkpw","Type":"NodeParagraph","Properties":{"id":"20240611144143-ho3hkpw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611144143-m1ajayb","Type":"NodeParagraph","Properties":{"id":"20240611144143-m1ajayb","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮。"}]},{"ID":"20240611144143-mjne6pc","Type":"NodeParagraph","Properties":{"id":"20240611144143-mjne6pc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611144143-713nmhb","Type":"NodeParagraph","Properties":{"id":"20240611144143-713nmhb","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"知母"},{"Type":"NodeText","Data":"：除去杂质，洗净，润透，切厚片，干燥，去毛屑。"}]},{"ID":"20240611144143-xkaxxyt","Type":"NodeParagraph","Properties":{"id":"20240611144143-xkaxxyt","updated":"20240611144143"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"盐知母"},{"Type":"NodeText","Data":"：取知母片，照盐水炙法（附录Ⅱ D）炒干（每100斤加盐2斤半用开水化开）。本品照上述[含量测定]项下的方法测定，含菝葜皂苷元（C27H44O3）不得少于 0.90％。"}]},{"ID":"20240611144143-75c8q8g","Type":"NodeParagraph","Properties":{"id":"20240611144143-75c8q8g","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611144143-yu46ti3","Type":"NodeParagraph","Properties":{"id":"20240611144143-yu46ti3","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" （1）取本品粉末2g，加乙醇10ml，振摇后放置20分钟，吸取上清液1ml,蒸干，残渣加硫酸1 滴，初显黄色，继变红色、紫堇色，最后显棕色。"}]},{"ID":"20240611144143-b9pjr0x","Type":"NodeParagraph","Properties":{"id":"20240611144143-b9pjr0x","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加乙醇20ml，加热回流40分钟，取上清液10ml，加盐酸1ml,加热回流1 小时后浓缩至约5ml ，加水10ml，用苯20ml振摇提取，提取液蒸干，残渣加苯2ml使溶解，作为供试品溶液。另取菝葜皂苷元对照品，加苯制成每1ml 含5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各7μl，分别点于同一硅胶Ｇ薄层板上，以苯－丙酮（9:1）为展开剂，展开，取出，晾干，喷以8％ 香草醛无水乙醇溶液与硫酸溶液（7→10）的混合液（0.5:5），在100℃ 加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611144143-bo82ijf","Type":"NodeParagraph","Properties":{"id":"20240611144143-bo82ijf","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240611144143-sdkk06g","Type":"NodeParagraph","Properties":{"id":"20240611144143-sdkk06g","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 取本品粉末（过三号筛）约1g[同时另取本品粉末测定水分（附录ⅨH第一法）]，精密称定，置锥形瓶中，精密加乙醇25ml，称定重量，浸泡过夜，超声处理40分钟，放冷，再称定重量，用乙醇补足减失的重量，摇匀，滤过，精密量取续滤液10ml，加盐酸1ml,置水浴上用蒸气缓慢回流1 小时，放冷，倾入小烧杯中，边振摇边滴加40％氢氧化钠溶液至中性（溶液颜色由橙黄突变为橙红），用乙醇洗涤容器，洗液并入烧杯中。用乙醇移至50ml量瓶中，并稀释至刻度，摇匀，滤过，精密量取续滤液10ml置蒸发皿中，蒸干，残渣用苯溶解，转移至2ml 量瓶中，并稀释至刻度，摇匀，作为供试品溶液。另取菝葜皂苷元对照品适量，精密称定，加苯制成每 1ml含0.5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，精密吸取供试品溶液4μl、对照品溶液2μl与6μl，分别交叉点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以苯－丙酮（9:1） 为展开剂，展至7cm,取出，晾干，再用同一展开剂进行二次展开，取出，晾干，喷以显色剂［甲液： 取水25ml，缓慢加硫酸50ml，放冷后，再加乙醇25ml，摇匀；乙液： 8％ 香草醛无水乙醇溶液。用时将甲液5份与乙液1份混合］后，在70℃加热7～10"}]},{"ID":"20240611144143-v04tb7k","Type":"NodeParagraph","Properties":{"id":"20240611144143-v04tb7k","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"分钟，至斑点显色清晰，取出，在薄层板上覆盖同样大小的玻璃板，周围用胶布固定，照薄层色谱法（附录Ⅵ B薄层扫描法）进行扫描，波长λS=443nm,测量供试品吸收度积分值与对照品吸收度积分值，计算，即得。"}]},{"ID":"20240611144143-ieot1nk","Type":"NodeParagraph","Properties":{"id":"20240611144143-ieot1nk","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"本品按干燥品计算，含菝葜皂苷元（C27H44O3）不得少于1.0％ 。"}]},{"ID":"20240611144143-q0op57w","Type":"NodeParagraph","Properties":{"id":"20240611144143-q0op57w","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611144143-dc3vkdx","Type":"NodeParagraph","Properties":{"id":"20240611144143-dc3vkdx","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 归肺、胃、肾经。"}]},{"ID":"20240611144143-tx61pai","Type":"NodeParagraph","Properties":{"id":"20240611144143-tx61pai","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611144143-0vocolw","Type":"NodeParagraph","Properties":{"id":"20240611144143-0vocolw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 苦、甘，寒。"}]},{"ID":"20240611144143-mjlry6g","Type":"NodeParagraph","Properties":{"id":"20240611144143-mjlry6g","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611144143-4j0mihr","Type":"NodeParagraph","Properties":{"id":"20240611144143-4j0mihr","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 脾虚便溏者不宜。"}]},{"ID":"20240611144143-evh7u5l","Type":"NodeParagraph","Properties":{"id":"20240611144143-evh7u5l","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611144143-75igere","Type":"NodeParagraph","Properties":{"id":"20240611144143-75igere","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 清热泻火，生津润燥。用于外感热病，高热烦渴，肺热燥咳，骨蒸潮热，内热消渴，肠燥便秘。"}]},{"ID":"20240611144143-nkqwl1t","Type":"NodeParagraph","Properties":{"id":"20240611144143-nkqwl1t","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611144143-4pcngwn","Type":"NodeParagraph","Properties":{"id":"20240611144143-4pcngwn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240611144143-6gcttom","Type":"NodeParagraph","Properties":{"id":"20240611144143-6gcttom","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611144143-38x0u2v","Type":"NodeParagraph","Properties":{"id":"20240611144143-38x0u2v","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" （1）用于温热病、高热烦燥、口渴、脉洪大等肺胃实热之症及肺热喘咳、痰黄而稠。知母苦寒，上能清肺热，中能清胃火，故适用于肺胃有实热的病症。本品常和石膏同用，可以增强石膏的清热泻火作用。"}]},{"ID":"20240611144143-o8cytdy","Type":"NodeParagraph","Properties":{"id":"20240611144143-o8cytdy","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"（2）用于阴虚发热、虚劳咳嗽及消渴等症。知母能泻肺火而滋肾，故不仅能清实热，且可清虚热。在临床上多与黄柏同用，配入滋阴药中，如知柏地黄丸，治阴虚火旺、潮热骨蒸等症。又本品配养阴润肺药如沙参、麦冬、川贝等品，可用于肺虚燥咳；配清热生津药如天花粉、麦冬、粉葛根等品，可用治消渴。"}]},{"ID":"20240611144143-wwcw6y6","Type":"NodeParagraph","Properties":{"id":"20240611144143-wwcw6y6","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"（3）知母性味苦寒而不燥，上能清肺，中能凉胃，下能泻肾火。配以黄芩，则泻肺火；配石膏，则清胃热；配黄柏，则泻肾火。知母既能清实热，又可退虚热，但它滋阴生津的功效较弱，用于阴虚内热、肺虚燥咳及消渴等症，须与滋阴药配伍，始能发挥它的作用。本品能润燥滑肠，故脾虚便溏者不宜使用。"}]},{"ID":"20240611144143-mghlfld","Type":"NodeParagraph","Properties":{"id":"20240611144143-mghlfld","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611144143-vebrksi","Type":"NodeParagraph","Properties":{"id":"20240611144143-vebrksi","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611144143-bv85nud","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144143-bv85nud","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：知母"}]},{"ID":"20240611144143-ep6lip9","Type":"NodeParagraph","Properties":{"id":"20240611144143-ep6lip9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611144143-jaqcd6h","Type":"NodeParagraph","Properties":{"id":"20240611144143-jaqcd6h","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" Zhī Mǔ"}]},{"ID":"20240611144143-mdk11jx","Type":"NodeParagraph","Properties":{"id":"20240611144143-mdk11jx","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611144143-2vw9qip","Type":"NodeParagraph","Properties":{"id":"20240611144143-2vw9qip","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 蚔母、连母、野蓼、地参、水参、水浚、货母、蝭母（《本经》），芪母（《广雅》），提母（《范子计然》），女雷、女理、儿草、鹿列、韭逢、儿踵草、东根、水须、苦心（《别录》），昌支（（唐本草》），穿地龙（《山东中药》）。"}]},{"ID":"20240611144143-quxt1n8","Type":"NodeParagraph","Properties":{"id":"20240611144143-quxt1n8","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611144143-fhjkw1z","Type":"NodeParagraph","Properties":{"id":"20240611144143-fhjkw1z","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611144143-dpthm0k","Type":"NodeParagraph","Properties":{"id":"20240611144143-dpthm0k","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611144143-mjhbddb","Type":"NodeParagraph","Properties":{"id":"20240611144143-mjhbddb","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"知母"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋均可采挖，以秋季采者较佳。栽培三年后开始收获。挖出根茎，除去茎苗及须根，保留黄绒毛和浅黄色的叶痕及茎痕晒干者，为\"毛知母\"；鲜时剥去栓皮晒干者为\"光知母\"。"}]},{"ID":"20240611144143-jamhmfw","Type":"NodeParagraph","Properties":{"id":"20240611144143-jamhmfw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611144143-rksy8nw","Type":"NodeParagraph","Properties":{"id":"20240611144143-rksy8nw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 生于向阳干燥的丘陵地及固定的砂丘上。分布黑龙江、吉林、辽宁、内蒙古、河北、河南、山东、陕西、甘肃等地。"}]},{"ID":"20240611144143-uxms8dt","Type":"NodeParagraph","Properties":{"id":"20240611144143-uxms8dt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611144143-60dwi9s","Type":"NodeParagraph","Properties":{"id":"20240611144143-60dwi9s","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 知母，又名：荨，莐藩（《尔雅》），大芦水、兔子油草、蒜瓣子草，羊胡子草、马马草。"}]},{"ID":"20240611144143-wt0guik","Type":"NodeParagraph","Properties":{"id":"20240611144143-wt0guik","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"多年生草本，全株无毛。根状茎横生于地面，其上有许多黄褐色纤维，下生多数粗而长的须根。叶基生，丛出；线形，长15～70厘米，宽3～6毫米，质稍硬，基部扩大成鞘状。花茎直立，高50～100厘米，上生鳞片状小苞叶，穗状花序稀疏而狭长，花常2～3朵簇生，无花梗或有很短的花梗，长约3毫米，花梗顶端具关节；花绿色或紫堇色；花被片6，宿存，排成2轮，长圆形，长7～8毫米，有3条淡紫色纵脉；雄蕊3，比花被片为短，贴生于内轮花被片的中部，花丝很短，具丁字药；子房近圆形，3室，花柱长2毫米。蒴果长卵形，长10～15毫米，成熟时沿腹缝上方开裂，每室含种子1～2粒。种子三棱形，两端尖，黑色。花期5～6月。果期8～9月。"}]},{"ID":"20240611144143-qa3cf7y","Type":"NodeParagraph","Properties":{"id":"20240611144143-qa3cf7y","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611144143-by4vqtr","Type":"NodeParagraph","Properties":{"id":"20240611144143-by4vqtr","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" ①毛知母为带皮的干燥根茎，呈扁圆柱形，微弯曲，一端较粗，一端较细，偶有2～3分歧，长3～17厘米，直径0.8～2厘米。根头部有浅黄色的叶痕及茎痕残留，俗称\"金包头\"；上面中央有一道下陷的纵沟，具紧密排列的环状节，节上密生金黄色扁平的绒毛，由两侧向根茎上方集中；另一面较皱缩，并有多数凹陷或突起的小圆点状根痕，黄绒毛少或无。质硬，易折断，断面黄白色，平坦。无臭，味甘而苦，带粘性。以肥大、质硬、表面被金黄色绒毛、断面黄白色者为佳。瘦长、形扁、外毛灰黑、内色暗者为质次。"}]},{"ID":"20240611144143-1ytut7o","Type":"NodeParagraph","Properties":{"id":"20240611144143-1ytut7o","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②光知母"}]},{"ID":"20240611144143-3buux1b","Type":"NodeParagraph","Properties":{"id":"20240611144143-3buux1b","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"又名：知母肉。为去皮的干燥根茎。较毛知母瘦小，长约3～13厘米，直径约1厘米。表面黄白色或淡黄棕色，有扭曲的纵沟，一侧可见多数不规则散在的小形根痕。质硬，易折断，断面白色或黄白色，有的显筋脉点，水浸后有粘液。气味同毛知母。以肥大、滋润、质硬、色黄白、嚼之发粘者为佳。"}]},{"ID":"20240611144143-h6o4cji","Type":"NodeParagraph","Properties":{"id":"20240611144143-h6o4cji","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"主产河北、山西。此外，河南、内蒙古、甘肃、陕西以及东北等地亦产。以河北易县所产品质最佳，称\"西陵知母\"。西南及中南都销毛知母；华北，东北销光知母。"}]},{"ID":"20240611144143-s3wra3y","Type":"NodeParagraph","Properties":{"id":"20240611144143-s3wra3y","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611144143-1znvtgf","Type":"NodeParagraph","Properties":{"id":"20240611144143-1znvtgf","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮。"}]},{"ID":"20240611144143-exee2k5","Type":"NodeParagraph","Properties":{"id":"20240611144143-exee2k5","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611144143-zua03n0","Type":"NodeParagraph","Properties":{"id":"20240611144143-zua03n0","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 主含皂甙。根茎含总皂甙约6％，从中检出6种皂甙，分别称为知母皂甙A-Ⅰ，A-Ⅱ，A-Ⅲ、A-Ⅳ、B-Ⅰ和B-Ⅱ，其中知母皂甙A-Ⅲ是萨尔萨皂甙元与知母双糖结合而成的双糖甙，知母皂甙A-Ⅰ是萨尔萨皂甙元β-D-吡喃半乳糖甙。知母根茎中的皂甙元主要是萨尔萨皂甙元，干根中的含量约0.5％，此外还有吗尔考皂甙元、新芰脱皂甙元。以前从知母根茎中分出的皂甙曾称为知母宁，推测是吗尔考皂甙、知母皂甙A-Ⅲ、A-Ⅳ、B等的混合物。根茎尚含多量的还原糖和粘液质、鞣酸、脂肪油等，又每克含尼克酸188微克。尼克酰胺12微克。另含芒果甙0.5％。"}]},{"ID":"20240611144143-whrp49e","Type":"NodeParagraph","Properties":{"id":"20240611144143-whrp49e","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"地上部分含芒果甙和异芒果甙。叶含芒果甙约0.7％。花含皂甙，水解后得熔点为246～248℃的甙元C27H42O4。"}]},{"ID":"20240611144143-4k4tva5","Type":"NodeParagraph","Properties":{"id":"20240611144143-4k4tva5","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611144143-oz2unhc","Type":"NodeParagraph","Properties":{"id":"20240611144143-oz2unhc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" ①抗菌作用"}]},{"ID":"20240611144143-ltvloud","Type":"NodeParagraph","Properties":{"id":"20240611144143-ltvloud","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"知母煎剂在琼脂平板上对葡萄球菌、伤寒杆菌有较强的抑制作用，对痢疾杆菌、副伤寒杆菌、大肠杆菌、枯草杆菌、霍乱弧菌也有抑制作用，在沙伯氏培养基上，对某些常见的致病性皮肤癣菌也有些抑菌作用。乙醚浸膏及在此浸膏中经丙酮处理所得之粗结晶对在普、拜二氏培养基上的H37RV人型结核杆菌亚种有较强的抑制作用，前者的最低有效浓度为1：64000（无血清）或1：16000（加血清）；后者则为1：16000～1：8000，前人所得之皂甙无此作用。在对小鼠实验性结核的治疗上，用含2.5％知母粉的饲料喂食后，对肺部结核病灶有抑制作用，但小鼠的死亡率与对照组差异不大；如提高到5％，则肺结核指数（反映肺脏大体病变的情况）可接近异烟胼，但死亡率却较对照组更高，可能是药物本身毒性较大之故。在对豚鼠的实验性结核的治疗中，知母显示有治疗效果，肺部病变较对照组减轻1/2左右。"}]},{"ID":"20240611144143-qr3ocf8","Type":"NodeParagraph","Properties":{"id":"20240611144143-qr3ocf8","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②解热作用"}]},{"ID":"20240611144143-309g5m9","Type":"NodeParagraph","Properties":{"id":"20240611144143-309g5m9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"浸膏2毫升／公斤（1毫升相当生药2克），与大肠杆菌（0.03％）2.3毫升，同时注射于家兔皮下，或先注射大肠杆菌，隔15分钟后再注入浸膏，体温均不升高，故认为有解热作用。"}]},{"ID":"20240611144143-s4wnpd8","Type":"NodeParagraph","Properties":{"id":"20240611144143-s4wnpd8","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240611144143-2itcnc9","Type":"NodeParagraph","Properties":{"id":"20240611144143-2itcnc9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"浸膏给家兔静脉注射，小剂量（0.5毫升浸膏中性原液）时对呼吸及血压均无影响，中等量（1～3毫升）能抑制呼吸，血压亦轻微下降，大量（7毫升）则呼吸停止、血压下降，导致死亡。浸膏液（0.001～1％）对在位蟾蜍心脏，低浓度无显著影响，中等剂量抑制，大量则麻痹心脏。对妊娠家兔离体子宫无显著影响。"}]},{"ID":"20240611144143-jfz4l9a","Type":"NodeParagraph","Properties":{"id":"20240611144143-jfz4l9a","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"知母干浸膏（6克/公斤）给正常家兔注射后，未见对血糖有何影响，醇提取物可引起暂时性的血糖升高。有人报告水提取物，给兔口服200毫克/公斤，能引起血糖下降，特别是对四氧嘧啶性糖尿病兔，作用更显著。对正常大鼠，知母不能增进葡萄糖之氧化，虽可促进横膈、脂肪组织对葡萄糖的摄取，并使横膈中糖元含量轻度增加，但肝糖元含量却有所降低。对实验性（四氧嘧啶）糖尿病的小鼠，知母水性提取物100～150毫克/公斤静脉注射，可降低血糖，尿中酮体减少，死亡率较对照组轻。"}]},{"ID":"20240611144143-a1mvme3","Type":"NodeParagraph","Properties":{"id":"20240611144143-a1mvme3","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611144143-h569dnx","Type":"NodeParagraph","Properties":{"id":"20240611144143-h569dnx","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 知母：拣净杂质，用水撞洗，捞出，润软，切片晒干。盐知母：取知母片置锅中用文火微炒，喷淋盐水，炒干取出，放凉。（每知母片100斤，用盐2斤8两加适量开水化开澄清）"}]},{"ID":"20240611144143-fvqotzq","Type":"NodeParagraph","Properties":{"id":"20240611144143-fvqotzq","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使知母，先于槐砧上细锉，焙干，木臼杵捣，勿令犯铁器。\""}]},{"ID":"20240611144143-u4foo39","Type":"NodeParagraph","Properties":{"id":"20240611144143-u4foo39","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"凡用知母拣肥润里白者，去毛切，引经上行则用酒浸焙干，下行则用盐水润焙。\""}]},{"ID":"20240611144143-5ihzf5r","Type":"NodeParagraph","Properties":{"id":"20240611144143-5ihzf5r","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611144143-xavvo57","Type":"NodeParagraph","Properties":{"id":"20240611144143-xavvo57","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 入肺、胃、肾经。"}]},{"ID":"20240611144143-vec2c0h","Type":"NodeParagraph","Properties":{"id":"20240611144143-vec2c0h","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"肾经。\""}]},{"ID":"20240611144143-tnpa9vu","Type":"NodeParagraph","Properties":{"id":"20240611144143-tnpa9vu","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②《汤液本草》：\"入足阳明经、手太阴经。\""}]},{"ID":"20240611144143-2jsmiur","Type":"NodeParagraph","Properties":{"id":"20240611144143-2jsmiur","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入足少阴肾经、手少阴心经。\""}]},{"ID":"20240611144143-x5bzlct","Type":"NodeParagraph","Properties":{"id":"20240611144143-x5bzlct","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611144143-6z8yx2v","Type":"NodeParagraph","Properties":{"id":"20240611144143-6z8yx2v","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611144143-p6b6lbx","Type":"NodeParagraph","Properties":{"id":"20240611144143-p6b6lbx","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240611144143-bs9plea","Type":"NodeParagraph","Properties":{"id":"20240611144143-bs9plea","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"性平。\""}]},{"ID":"20240611144143-gfovmmz","Type":"NodeParagraph","Properties":{"id":"20240611144143-gfovmmz","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"味苦甘。\""}]},{"ID":"20240611144143-rvx8qc7","Type":"NodeParagraph","Properties":{"id":"20240611144143-rvx8qc7","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"味微苦略辛。\""}]},{"ID":"20240611144143-o9cnuz9","Type":"NodeParagraph","Properties":{"id":"20240611144143-o9cnuz9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611144143-jcv7p6c","Type":"NodeParagraph","Properties":{"id":"20240611144143-jcv7p6c","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒，大便溏泄者忌服。"}]},{"ID":"20240611144143-b1zurag","Type":"NodeParagraph","Properties":{"id":"20240611144143-b1zurag","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"多服令人泄。\""}]},{"ID":"20240611144143-cqap52c","Type":"NodeParagraph","Properties":{"id":"20240611144143-cqap52c","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②《医学入门》：\"凡肺中寒嗽，肾气虚脱，无火症而尺脉微弱者禁用。\""}]},{"ID":"20240611144143-3kfd3zm","Type":"NodeParagraph","Properties":{"id":"20240611144143-3kfd3zm","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"阳痿及易举易痿，泄泻脾弱，饮食不消化，胃虚不思食，肾虚溏泄等证，法并禁用。\""}]},{"ID":"20240611144143-jmrnnd4","Type":"NodeParagraph","Properties":{"id":"20240611144143-jmrnnd4","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"④《本经逢原》：\"外感表证未除、泻痢燥渴忌之。脾胃虚热人误服，令人作泻减食，故虚损大忌。\""}]},{"ID":"20240611144143-1r15fdr","Type":"NodeParagraph","Properties":{"id":"20240611144143-1r15fdr","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611144143-abycfdp","Type":"NodeParagraph","Properties":{"id":"20240611144143-abycfdp","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 滋阴降火，润燥滑肠。治烦热消渴，骨蒸劳热，肺热咳嗽，大便燥结，小便不利。"}]},{"ID":"20240611144143-aij0zwe","Type":"NodeParagraph","Properties":{"id":"20240611144143-aij0zwe","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"用于温热病，邪热亢盛、壮热、烦渴、脉洪大等肺胃实热证。知母有清热泻火除烦的作用。与石膏配伍有协同之效，如白虎汤。"}]},{"ID":"20240611144143-9bwxqc9","Type":"NodeParagraph","Properties":{"id":"20240611144143-9bwxqc9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"用于肺热咳嗽或阴虚燥咳、痰稠等证。本品有清泻肺火，滋阴润肺之效，常与贝母同用以清肺化痰止咳，即二母散。"}]},{"ID":"20240611144143-4dpyrk0","Type":"NodeParagraph","Properties":{"id":"20240611144143-4dpyrk0","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"用于阴虚火旺，肺肾亏所致的骨节蒸潮热、盗汗、心烦等症。知母有滋阴降火的作用。常同黄柏相须为用，配入养阴药中，如知柏地黄丸。"}]},{"ID":"20240611144143-hvkbfrc","Type":"NodeParagraph","Properties":{"id":"20240611144143-hvkbfrc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"可用于阴虚消渴，症见口渴、饮多、尿多者。本品有滋阴润澡、生津止渴功效。同天花粉、五味子等配合使用可增强疗效，如玉液汤。"}]},{"ID":"20240611144143-b6dbvtn","Type":"NodeParagraph","Properties":{"id":"20240611144143-b6dbvtn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"清热泻火：用于高热烦渴，常配生石膏；用于肺热咳嗽，常配贝母。"}]},{"ID":"20240611144143-u6e23cu","Type":"NodeParagraph","Properties":{"id":"20240611144143-u6e23cu","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"滋阴降火：用于阴虚之发热、盗汗，常配黄柏、地黄。"}]},{"ID":"20240611144143-symv6l8","Type":"NodeParagraph","Properties":{"id":"20240611144143-symv6l8","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主消渴热中，除邪气肢体浮肿，下水，补不足，益气。\""}]},{"ID":"20240611144143-qv4x5x4","Type":"NodeParagraph","Properties":{"id":"20240611144143-qv4x5x4","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗伤寒久疟烦热，胁下邪气，膈中恶及风汗内疸。\""}]},{"ID":"20240611144143-lnshuo1","Type":"NodeParagraph","Properties":{"id":"20240611144143-lnshuo1","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"甚疗热结，亦主疟热烦。\""}]},{"ID":"20240611144143-ryisalc","Type":"NodeParagraph","Properties":{"id":"20240611144143-ryisalc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"主治心烦躁闷，骨热劳往来，生产后蓐劳，肾气劳，憎寒虚损，患人虚而口干，加而用之。\""}]},{"ID":"20240611144143-vqetybt","Type":"NodeParagraph","Properties":{"id":"20240611144143-vqetybt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"通小肠，消痰止嗽，润心肺，补虚乏，安心止惊悸。\""}]},{"ID":"20240611144143-60kffgn","Type":"NodeParagraph","Properties":{"id":"20240611144143-60kffgn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑥张元素：\"凉心去热，治阳明火热，泻膀胱肾经火，热厥头痛，下痢腰痛，喉中腥臭。\""}]},{"ID":"20240611144143-18hprkd","Type":"NodeParagraph","Properties":{"id":"20240611144143-18hprkd","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑦王好古：\"泻肺火，滋肾水，治命门相火有余。\""}]},{"ID":"20240611144143-2u20vef","Type":"NodeParagraph","Properties":{"id":"20240611144143-2u20vef","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"安胎，止子烦，辟射工溪毒。\""}]},{"ID":"20240611144143-c2aqekt","Type":"NodeParagraph","Properties":{"id":"20240611144143-c2aqekt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑨《本草求原》：\"治嗽血，喘，淋，口病，尿血，呃逆，盗汗，遗精，痹痿，瘈疭。\""}]},{"ID":"20240611144143-xe6xv6h","Type":"NodeParagraph","Properties":{"id":"20240611144143-xe6xv6h","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611144143-oxhs8y6","Type":"NodeParagraph","Properties":{"id":"20240611144143-oxhs8y6","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～5钱；或入丸、散。"}]},{"ID":"20240611144143-rqhth7k","Type":"NodeParagraph","Properties":{"id":"20240611144143-rqhth7k","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611144143-c3moi6c","Type":"NodeParagraph","Properties":{"id":"20240611144143-c3moi6c","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" ①治伤寒邪热内盛，齿牙干燥，烦渴引饮，目昧唇焦：知母五钱，石膏三钱，麦门冬二钱，甘草一钱，人参八钱。水煎服。（《伤寒蕴要》）"}]},{"ID":"20240611144143-9mazafz","Type":"NodeParagraph","Properties":{"id":"20240611144143-9mazafz","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②治温疟壮热，不能食：知母、鳖甲（炙），地骨皮各三两，常山二两，竹叶（切）一升，石膏四两（碎）。上六味切，以水七升，煮取二升五合，去滓，分三服。忌蒜、猪肉、苋菜、生葱、生菜。（《延年方》知母鳖甲汤）"}]},{"ID":"20240611144143-wfmb2zh","Type":"NodeParagraph","Properties":{"id":"20240611144143-wfmb2zh","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③治火冲眩晕，暴发倒仆，昏不知人，甚则遗尿不觉，少顷汗出而轻，仍如平人，右关脉细敷，脾阴不足者：知母、黄柏、黄芪、当归身。水煎服。（《症因脉治》知柏补血汤）"}]},{"ID":"20240611144143-43ki5pt","Type":"NodeParagraph","Properties":{"id":"20240611144143-43ki5pt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"④治消渴：生山药一两，生黄芪五钱，知母六钱，生鸡内金（捣细）二钱，葛根钱半，五味子三钱，天花粉三钱。水煎服。（《医学衷中参西录》玉液汤）"}]},{"ID":"20240611144143-ibxxoxt","Type":"NodeParagraph","Properties":{"id":"20240611144143-ibxxoxt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑤治气虚劳伤，面黄肌瘦，气怯神离，动作倦怠，上半日咳嗽烦热，下午身凉气爽，脉数有热者：知母三钱，黄柏三钱，人参二钱，麦冬五钱，广皮一钱，甘草五分。水煎服。（《症因脉治》知柏参冬饮）"}]},{"ID":"20240611144143-i9asep5","Type":"NodeParagraph","Properties":{"id":"20240611144143-i9asep5","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑥治肺劳实热，面目苦肿，咳嗽喘急，烦热颊赤，骨节多痛，乍寒乍热：知母、贝母（去心膜）、杏仁（去皮尖，炒）、甜葶苈（略炒）、半夏（汤泡七次）、秦艽（去芦）、橘红各一两，甘草（炙）半两。上细切，每服四钱，水-盏半，姜五片，煎至八分，去滓温服，不拘时候。（《济生方》二母汤）"}]},{"ID":"20240611144143-ymje1o7","Type":"NodeParagraph","Properties":{"id":"20240611144143-ymje1o7","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑦治肺家受燥，咳嗽气逆：知母、石膏、桔梗、甘草、地骨皮。水煎服。（《症因脉治》知母甘桔汤）"}]},{"ID":"20240611144143-gyh2e8g","Type":"NodeParagraph","Properties":{"id":"20240611144143-gyh2e8g","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑧治妊娠子烦，因服药致胎气不安，烦不得卧者：知母一两，洗焙为末，枣肉丸弹子大。每服一丸，人参汤下。医者不识此病，作虚烦治，反损胎气。（《产乳集验方》）"}]},{"ID":"20240611144143-pzrdpvt","Type":"NodeParagraph","Properties":{"id":"20240611144143-pzrdpvt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑨痰嗽。用知母、贝母各一两，研细：巴豆三十枚，去油，研匀。每夜，切生姜三片，二面蘸上药末，放在口里细嚼咽下，随即睡觉。次日必泻，痰嗽渐止。体弱者，不用巴豆。"}]},{"ID":"20240611144143-sdvz66b","Type":"NodeParagraph","Properties":{"id":"20240611144143-sdvz66b","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑩久嗽气急。用知母五钱（去毛切片，隔纸炒过）、杏仁五钱（姜水泡，去皮尖，焙过），同煎服。另以萝卜子、杏仁，等分为末，加米糊做成丸子。每服五十丸，姜汤送下，以绝病根。"}]},{"ID":"20240611144143-eg9sa0w","Type":"NodeParagraph","Properties":{"id":"20240611144143-eg9sa0w","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑾妊娠不足月，腹痛欲产。用知母二两，研细，和蜜做成丸子，如梧子大。每服二十丸，米粥送下。"}]},{"ID":"20240611144143-y110jf6","Type":"NodeParagraph","Properties":{"id":"20240611144143-y110jf6","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑿紫癜风疾。用醋磨知母涂搽。"}]},{"ID":"20240611144143-znjjuxb","Type":"NodeParagraph","Properties":{"id":"20240611144143-znjjuxb","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⒀甲疽。用知母，烧存性，研末敷患处。"}]},{"ID":"20240611144143-562m20u","Type":"NodeParagraph","Properties":{"id":"20240611144143-562m20u","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611144143-y78rsbr","Type":"NodeParagraph","Properties":{"id":"20240611144143-y78rsbr","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" ①李杲：\"知母，其用有四：泻无根之肾火，疗有汗之骨蒸，止虚劳之热，滋化源之阴。仲景用此入白虎汤治不得眠者，烦躁也。烦出于肺，躁出于肾，君以石膏，佐以知母之苦寒，以清肾之源，缓以甘草、粳米，使不速下也。又凡病小便闷塞而渴者，热在上焦气分，肺中伏热，不能生水，膀胱绝其化源，宜用气薄味薄淡渗之药，以泻肺火，清肺金而滋水之化源。若热在下焦血分而不渴者，乃真水不足，膀胱干涸，乃无阴则阳无以化，法当用黄柏、知母大苦大寒之药，以补肾与膀胱，使阴气行而阳自化，小便自通。\""}]},{"ID":"20240611144143-7c7a7kg","Type":"NodeParagraph","Properties":{"id":"20240611144143-7c7a7kg","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"知母苦寒，气味俱厚，沉而下降，为肾经本药。兼能清肺者，为其肃清龙雷，勿使僭上，则手太阴无销烁之虞也。泻有余之相火，理消渴之烦蒸，凡止咳安胎，莫非清火之用。多服令人泄泻，亦令人减食，此惟实火燔灼者，方可暂用。若施之于虚损之人，如水益深矣。盖苦寒之味，行天地肃杀之令，非长养万物者也。\""}]},{"ID":"20240611144143-89dmsuv","Type":"NodeParagraph","Properties":{"id":"20240611144143-89dmsuv","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"古书言知母佐黄柏滋阴降火，有金水相生之义。盖谓黄柏能制膀胱，命门阴中之火，知母能消肺金，制肾水化源之火，去火可以保阴，是即所谓滋阴也。故洁古、东垣皆以为滋阴降火之要药。继自丹溪而后，则皆用以为补阴，诚大谬矣。夫知母以沉寒之性，本无生气，用以清火则可，用以补阴，则何补之有?\""}]},{"ID":"20240611144143-ds6mq8o","Type":"NodeParagraph","Properties":{"id":"20240611144143-ds6mq8o","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"④《重庆堂随笔）：\"知母，清肺胃气分之热，则津液不耗而阴自潜滋暗长矣。然仲圣云，胃气生热，其阳则绝。盖胃热太盛，则阴不足以和阳，津液渐干，而成枯燥不能杀谷之病，其阳则绝者，即津液涸竭也，清其热，俾阳不绝，则救津液之药，虽谓之补阳也可。乃后人以为寒凉之品，非胃家所喜，谆谆戒勿轻用，辄从事于香燥温补之药者何哉！\""}]},{"ID":"20240611144143-mm7wjt5","Type":"NodeParagraph","Properties":{"id":"20240611144143-mm7wjt5","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑤《本经疏证》：\"知母能益阴清热止渴，人所共知，其能下水，则以古人用者甚罕，后学多不明其故。……《千金》、《外台》两书用知母治水气各一方。《千金》曰，有人患水肿腹大，其坚如石，四肢细，少劳苦足胫即肿，少饮食便气急，此终身之疾，服利下药不瘥者，宜服此药，微除风湿，利小便，消水谷，岁久服之，乃可得力，瘥后可常服.其所用药，则加知母于五苓散中，更增鬼箭羽、丹参、独活、秦艽、海藻也。《外台》曰，《古今录验》泽漆汤，疗寒热当风，饮多暴肿，身如吹，脉浮数者。其所用药，则泽泻、知母、海藻、茯苓、丹参、秦艽、防己、猪苓、大黄、通草、木香也。其曰，除风湿，利小便，曰疗寒热当风，饮多暴肿。可见《本经）所著下水之效，见于除肢体浮肿，而知母所治之肢体浮肿，乃邪气肢体浮肿，非泛常肢体浮肿比矣。正以寒热外盛，邪火内著，渴而引饮，火气不能化水，水遂泛滥四射，治以知母，是泄其火，使不作渴引饮，水遂无继，蓄者旋消，由此言之，仍是治渴，非治水也。于此，见凡肿在一处，他处反消瘦者，多是邪气勾留，水火相阻之候，不特《千金方》水肿腹大四肢细，即《金匮要略》中桂枝芍药知母汤，治身体尪羸，脚肿如脱，亦其一也。《金匮方》邪气水火交阻于下，《千金方》邪气水火交阻于中，阻于下者，非发散不为功，阻于中者，非渗利何由泄，此《千金方》所以用五苓散，《金匮方》所以用麻黄、附子、防风，然其本质均为水火交阻，故共用桂、术、知母则同也，桂、术治水之阻，知母治火之阻，于此遂可见矣。\""}]},{"ID":"20240611144143-4bsydjz","Type":"NodeParagraph","Properties":{"id":"20240611144143-4bsydjz","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑥《医学衷中参西录》：\"知母原不甚寒，亦不甚苦，尝以之与黄芪等分并用，则分毫不觉凉热，其性非大寒可知。又以知母一两加甘草二钱煮饮之，即甘胜于苦，其味非大苦可知。寒、苦皆非甚大，而又多液，是以能滋阴也。有谓知母但能退热，不能滋阴者，犹浅之平视知母也。是以愚治热实脉数之证，必用知母，若用黄芪补气之方，恐共有热不受者，亦恒辅以知母。\""}]},{"ID":"20240611144143-zl1klwk","Type":"NodeParagraph","Properties":{"id":"20240611144143-zl1klwk","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑦《本草正义》：\"知母寒润，止治实火，泻肺以泄壅热，肺痈燥咳宜之，而虚热咳嗽大忌。清胃以救津液，消中瘅热宜之，而脾气不旺亦忌。通膀胱水道，疗淋浊初起之结热，伐相火之邪，主强阳不痿之标剂。热病之在阳明，烦渴大汗，脉洪里热，佐石膏以扫炎熇；疟证之在太阴，湿浊熏蒸，汗多热甚，佐草果以泄脾热。统详主治，不外实热有余四字之范围。\""}]},{"ID":"20240611144143-aqw6a84","Type":"NodeParagraph","Properties":{"id":"20240611144143-aqw6a84","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611144143-hsf0s2p","Type":"NodeParagraph","Properties":{"id":"20240611144143-hsf0s2p","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611144143-hl1kdia","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144143-hl1kdia","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"《中华本草》：知母"}]},{"ID":"20240611144143-0jj41b0","Type":"NodeParagraph","Properties":{"id":"20240611144143-0jj41b0","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611144143-3prufpt","Type":"NodeParagraph","Properties":{"id":"20240611144143-3prufpt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" Zhī Mǔ"}]},{"ID":"20240611144143-x92imze","Type":"NodeParagraph","Properties":{"id":"20240611144143-x92imze","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611144143-jl63xh8","Type":"NodeParagraph","Properties":{"id":"20240611144143-jl63xh8","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 蚳母、连母、野蓼、地参、水参、水浚、货母、蝭母、芪母、提母、（艹是）母、女雷、女理、鹿列、韭逢、儿踵草、东根、苦心、儿草、水须、昌支、蒜瓣子草、兔子油草、山韭菜、羊胡子根、穿地龙、虾草、马马草、淮知母"}]},{"ID":"20240611144143-0xpauyt","Type":"NodeParagraph","Properties":{"id":"20240611144143-0xpauyt","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611144143-f9pgsw6","Type":"NodeParagraph","Properties":{"id":"20240611144143-f9pgsw6","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" Common Anemarrhena Rhizome， Rhizome of Common Anemarrhena"}]},{"ID":"20240611144143-qyi6oft","Type":"NodeParagraph","Properties":{"id":"20240611144143-qyi6oft","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611144143-gqikzip","Type":"NodeParagraph","Properties":{"id":"20240611144143-gqikzip","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611144143-la34oew","Type":"NodeParagraph","Properties":{"id":"20240611144143-la34oew","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611144143-4qhyfsi","Type":"NodeParagraph","Properties":{"id":"20240611144143-4qhyfsi","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物知母的根茎。"}]},{"ID":"20240611144143-vgl7hy2","Type":"NodeParagraph","Properties":{"id":"20240611144143-vgl7hy2","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Anemarrhena asphodeloides Bunge"}]},{"ID":"20240611144143-wn2gqae","Type":"NodeParagraph","Properties":{"id":"20240611144143-wn2gqae","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋两季采挖，除去枯叶和须根，抖掉泥土，晒干或烘干为“毛知母”。趁鲜剥去外皮，晒干为“知母肉”。"}]},{"ID":"20240611144143-yk0a1so","Type":"NodeParagraph","Properties":{"id":"20240611144143-yk0a1so","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611144143-mcs8ttw","Type":"NodeParagraph","Properties":{"id":"20240611144143-mcs8ttw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于向阳干燥的山坡、丘陵草丛或草原地带，常成群生长。"}]},{"ID":"20240611144143-mpi9s1q","Type":"NodeParagraph","Properties":{"id":"20240611144143-mpi9s1q","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北及陕西、宁夏、甘肃、山东、江苏等地。在新疆、安徽、江西、河南等地有引种栽培。"}]},{"ID":"20240611144143-4nzc1iv","Type":"NodeParagraph","Properties":{"id":"20240611144143-4nzc1iv","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611144143-ayp0uwg","Type":"NodeParagraph","Properties":{"id":"20240611144143-ayp0uwg","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 知母，多年生草本。全株无毛。根茎横生，粗壮，密被许多黄褐色纤维状残叶基，下面生有多数肉质须根。叶基生，丛出，线形，长20-70cm，宽3-7mm，上面绿色，下面深绿色，无毛，质稍硬，叶基部扩大包着根茎。花葶直立，不分枝，高50-120cm，下部具披针形退化叶，上部疏生鳞片状小苞片；花2-6朵成一簇，散生在花葶上部呈总状花序，长20-40cm；花黄白色，干后略带比色，多于夜间开放，具短梗；花被片6，基部稍连合，2轮排列，长圆形，长5-8mm，宽1-1.5mm，先端稍内折，边缘较薄，具3条淡绿色纵脉纹；发育雄蕊3，着生于内轮花被片近中部，花药黄色，退化雄蕊3，着生于外轮花被片近基部，不具花药；雌蕊1，子房长卵形，3室，花柱短，柱头1。蒴果卵圆形，长10-15mm，直径5-7mm，成熟时沿腹缝线上方开裂为3裂片，每裂片内能常具1颗种子。种子长卵形，具3棱，一端尖，长8-12mm，黑色。花期5-8月。果期7-9月。"}]},{"ID":"20240611144143-qu4h1to","Type":"NodeParagraph","Properties":{"id":"20240611144143-qu4h1to","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611144143-39fb473","Type":"NodeParagraph","Properties":{"id":"20240611144143-39fb473","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，耐寒，耐干旱。适应性很强，对土壤要求不严，以土质疏松、肥沃、排水良好的腐殖质壤土和砂质壤土栽培为宜，在阴坡地、粘土及低洼地生长不良，且根茎易腐烂。"}]},{"ID":"20240611144143-45dg261","Type":"NodeParagraph","Properties":{"id":"20240611144143-45dg261","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子和分株繁殖：选3年以上生的植株采集成熟种子，置30-40℃温水中浸泡24h，捞出稍晾干后，即可进行秋播。秋播在封冻前，春播在4月。条播，行距10-25cm，开1.5cm深的浅沟，将种子幸均匀撒入沟内，覆土1.5cm，保持湿润，20d左右出苗。苗出齐后间苗，按株距7-10cm定苗。每1hm2播种量7.5-10.5kg。分株繁殖：早春或晚秋，将根茎挖出，切成3-6cm长段，每段带1-2个芽，按行距25-30cm开沟，株距10-15cm栽种，覆土5cm镇压。"}]},{"ID":"20240611144143-1r3udyq","Type":"NodeParagraph","Properties":{"id":"20240611144143-1r3udyq","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"田间管理 每年除草松土2-3次，雨季过后秋末培土，天旱要及时浇水，除留种上应剪除花薹，促进根茎生长，提高产量。每年4-8月，每1hm2应分次追施尿素300kg，氯化钾195kg，秋末冬初应施复合固体化肥（氮：磷：钾=5：5：5）495kg，可溶性磷肥99kg。"}]},{"ID":"20240611144143-nwvthof","Type":"NodeParagraph","Properties":{"id":"20240611144143-nwvthof","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"病虫害防治 蛴螬为害，幼早咬断苗或咀食根茎，可浇施50%马拉松乳剂800-1000倍液，或茶籽饼6倍液。"}]},{"ID":"20240611144143-ska78gr","Type":"NodeParagraph","Properties":{"id":"20240611144143-ska78gr","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611144143-lfb7t1u","Type":"NodeParagraph","Properties":{"id":"20240611144143-lfb7t1u","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 ⑴毛知母 根茎扁圆长条状，微弯曲，偶有分枝，长3-15cm，直径0.8-1.5cm。一端有浅黄色的茎叶残痕，习称“金包头“。表面黄棕色至棕色，上面有一凹沟，具紧密排列的环状节，节上密生黄棕以的残存叶基，下面略凸起，有纵皱纹及凹点状根痕或须根痕及残茎。质坚硬，易折断。断面黄白色，颗粒状。气微，味微甜、略苦，嚼之带粘性。"}]},{"ID":"20240611144143-9sv53r6","Type":"NodeParagraph","Properties":{"id":"20240611144143-9sv53r6","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"⑵知母肉 外皮大部分已除去表面黄白色，有的残留少数毛须状叶茎及凹点状根痕。"}]},{"ID":"20240611144143-0uompv4","Type":"NodeParagraph","Properties":{"id":"20240611144143-0uompv4","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"以条粗、质硬、断面色白黄者为佳。"}]},{"ID":"20240611144143-l77vgim","Type":"NodeParagraph","Properties":{"id":"20240611144143-l77vgim","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：米黄色。①粘液细胞较多，含草酸钙晶束。完整的粘液细胞呈类圆形、椭圆形、长圆形或梭形，直径56-160μm，长约至340μm。②草酸钙针昌成束散在，针晶长36-110μm，有的直径约至7μm，碎断后状如小方晶。③纤维（叶基）直径8-14μm，壁稍厚，木化，纹孔稀疏，有的成人字形，胞腔宽大。④具缘纹孔、网纹及螺纹导管，直径14-24μm。⑤木栓细胞表面观形状不一，壁薄，常多层上下重叠。⑥木化厚壁细胞（鳞叶）类长方形、长多角形或延长作短纤维状，直径16-48μm，长约至112μm，壁厚5-8μm，孔沟较密，胞腔内含棕黄色物。"}]},{"ID":"20240611144143-l8xvszw","Type":"NodeParagraph","Properties":{"id":"20240611144143-l8xvszw","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"商品规格 商品中因加工方法不同，有毛知母主知母肉之分。出口商品分3种：大知母（盖王），长12cm以上。中知母（顶王），长9-12cm。小知母，长6-9cm。"}]},{"ID":"20240611144143-8zlsazn","Type":"NodeParagraph","Properties":{"id":"20240611144143-8zlsazn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611144143-t8otcjh","Type":"NodeParagraph","Properties":{"id":"20240611144143-t8otcjh","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 根茎含知母皂甙（timosaponin）A-Ⅰ、A-Ⅱ、A-Ⅲ、A-Ⅳ、B-Ⅰ、B-Ⅱ，知母皂甙A-Ⅱ、A-Ⅳ结构尚不明，知母皂甙A-Ⅲ即是知母皂甙（zhimrsaponin）A，又是知母皂甙（anemarsaponin）A1，知母皂甙B-Ⅱ即是原知母皂甙A-Ⅲ（prototimosaponinA-Ⅲ），还含知母皂甙（amemarsaponin）A2即马尔考皂甙元-3-O-β-D-吡喃葡萄糖基（1→2）-β-D-吡喃半乳糖甙B〔marlogenin-3-O-β-D-glucopyranosy（1→2）-β-D-galactopyranosideB〕，去半乳糖替告皂甙（desgalactotigonin），F-芰脱皂甙（F-gitonin），伪原知母皂甙A-Ⅲ（pseudoprototimosaponinA-Ⅲ），异菝葜皂甙（smilageninoside）。有学者认为知母皂甙B-I（timosaponinB-I）可能是在抽提成分操作过程中产生的人工矫作物。"}]},{"ID":"20240611144143-5pvapnc","Type":"NodeParagraph","Properties":{"id":"20240611144143-5pvapnc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"根茎另含知母多糖（anemaran）A、B、C、D，顺-扁柏树脂酚（cis-hinokiresinol），单甲基-顺-扁柏树脂酚（monomethyl-cis-hinokiresinol），氧化-顺-扁柏树脂酚（oxy-cis-himokiresinol），2，6，4'-三羟基-4-甲氧基二苯甲酮（2，6，4'-trihydroxy-4-methoxy benzophenone），对-羟苯基巴豆油酸（p-hydroxyphenyl crotonic acid），二十五烷酸乙烯脂（pentacosyl vinyl ester），β-谷甾醇（β-sitosterol），杧果甙（mangiferin），烟酸188ug/g（nicotinic acid），烟酰胺12ug/g（nicotinamide）及泛酸16ug/g（pantothenic acid）。"}]},{"ID":"20240611144143-afoocrl","Type":"NodeParagraph","Properties":{"id":"20240611144143-afoocrl","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611144143-bg9ebnl","Type":"NodeParagraph","Properties":{"id":"20240611144143-bg9ebnl","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 1.抗病原微生物作用：知母在体外对痢疾杆菌、伤寒杆菌、副伤寒杆菌、霍乱弧菌、大肠杆菌、变形杆菌、绿脓杆菌等革兰氏阴性菌及葡萄球菌、溶血性链球菌、肺炎双球菌、百日咳杆菌等革兰氏阳性菌均有较强抗菌作用。用含2.5%知母粉的饲料喂饲实验性结核病小鼠，能使其肺部结核病灶减轻。知母对某些常见的致病性皮肤癣菌如许兰氏癣菌及其蒙古变种、共心性毛癣菌、堇色毛癣菌、红色毛癣菌、絮状表皮癣菌、铁锈色毛癣菌、足跖毛癣菌、趾间毛癣菌和犬小芽胞菌等在沙伯弱氏培养基上表现较强的抗菌作用。从知母中提得的一种水溶性皂甙，对结核杆菌，尤其对白色念珠菌有较强的抑制作用，另一种黄酮结晶，亦有抑制结核杆菌作用。"}]},{"ID":"20240611144143-4iye6bn","Type":"NodeParagraph","Properties":{"id":"20240611144143-4iye6bn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"2.抑制Na（+），K（+）-ATP酶活性：体外实验证明，知母皂甙元（菝葜皂甙元）是Na+-K+-ATP酶抑制剂，它对提纯的兔肾Na（+），K（+）-ATP酶有极明显的抑制作用，其活性同专一性Na（+），K（+）-ATP酶抑制剂乌本甙相比，两者在2×10(-5)mol／L时抑制程度相近。以甲状腺素速诱导小鼠肝脏Na（+），K+）-ATP酶增量，知母皂甙和皂甙元可使这些小鼠肝脏切片的过高耗氧率抑制到接近正常小鼠的水平；对正常小鼠肝切片的耗氧率虽有降低趋势，但无统计意义。大鼠整体实验也表明，知母皂甙元25mg／只灌胃可抑制因同时灌胃甲状腺素引起的肝、肾和小肠粘膜中Na（+），K（+）-ATP酶活性升高。"}]},{"ID":"20240611144143-k643dq4","Type":"NodeParagraph","Properties":{"id":"20240611144143-k643dq4","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"3.对交感-肾上腺功能的影响：以50%知母水煎剂给大鼠灌胃，每日4ml，连续3周，可使肾上腺内多巴胺-β-羟化酶活性明显降低，提示儿茶酚胺合成减少，与此同时，肾上腺重量较生理盐水对照组明显减轻，心率逐周降低，至第3周明显低于给药前。此外，按人体常用剂量5倍给家兔灌胃，连续5天，对正常动物血浆皮质酮水平未见明显影响，但可拮抗外源性皮质激素制剂地塞米松引起的反馈性血浆皮质酮水平降低。进一步研究证明，其机理之一是知母抑制了肝脏对皮质醇的分解代谢。"}]},{"ID":"20240611144143-d7dcbt6","Type":"NodeParagraph","Properties":{"id":"20240611144143-d7dcbt6","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"4.降血糖作用：以知母200mg／kg水制浸膏给正常家兔灌胃，血糖可下降达18-30%，持续6小时以上；以知母每天500mg／kg生药的水制浸膏给四氧嘧啶糖尿病家兔灌胃，连续4天，也出现明显的降血糖作用，并可减轻胰岛萎缩。给四氧嘧啶糖尿病小鼠腹腔注射知母水浸膏150mg／kg（生药量）也见血糖明显下降。知母并可促进大鼠横膈和脂肪组织摄取葡萄糖，并使横膈内糖元含量增加，但肝内糖元量却减少，尿中酮体含量减少。从知母根茎中分得的知母聚糖A、B、C、D有降血糖作用，其中B的活性最强。"}]},{"ID":"20240611144143-e4d9n34","Type":"NodeParagraph","Properties":{"id":"20240611144143-e4d9n34","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"5.解热作用：对知母是否具有解热作用的报导不一。有报导知母对大肠杆菌引起的发热家兔有解热作用，但也有报导白虎汤在去掉石膏后的知母、甘草煎剂灌胃给药对实验性发热家兔未见明显退热作用。知母根茎中的皂甙具有明显降低由甲状腺素造成的耗氧率增高及抑制Na（+），K（+）-ATP酸活性的作用，其中总皂甙对Na（+），K（+）-ATP酶的抑制率达59.8%，其半琥珀酸衍生物抑制率为89.8%，故认为与清热泻火的功效有关。"}]},{"ID":"20240611144143-0mgp7c7","Type":"NodeParagraph","Properties":{"id":"20240611144143-0mgp7c7","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"6.抗肿瘤作用：知母皂甙对人肝癌移植裸大鼠有抑制肿瘤生长作用，使生存期延长，但统计无显着差异。另对治疗皮肤鳞癌、宫颈癌等有较好疗效且无副作用。"}]},{"ID":"20240611144143-iywhgj2","Type":"NodeParagraph","Properties":{"id":"20240611144143-iywhgj2","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"7.其它作用：知母果甙有明显的利胆作用和抑制血小板聚集作用。知母中的烟酸有维持皮肤与神经健康及促进消化道功能的作用。知母提取物对逆转录酶和各种脱氧核糖核酸聚合酶活性有抑制作用。知母菝葜皂甙元和知母水煎剂均能明显降低高甲状腺激素状态小鼠脑β受体RT值，但对亲和力无影响，还能显着改善该状态小鼠的体重下降。"}]},{"ID":"20240611144143-pkg57ux","Type":"NodeParagraph","Properties":{"id":"20240611144143-pkg57ux","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611144143-3k3mhy3","Type":"NodeParagraph","Properties":{"id":"20240611144143-3k3mhy3","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 知母：拣净杂质，用水撞洗，捞出，润软，切片晒干。盐知母：取知母片置锅中用文火微炒，喷淋盐水，炒干取出，放凉。（每知母片100斤，用盐2斤8两加适量开水化开澄清）；先于槐砧上细锉，焙干，木臼杵捣，勿令犯铁器；拣肥润里白者，去毛切，引经上行则用酒浸焙干，下行则用盐水润焙。"}]},{"ID":"20240611144143-iccofpq","Type":"NodeParagraph","Properties":{"id":"20240611144143-iccofpq","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611144143-0z0nr96","Type":"NodeParagraph","Properties":{"id":"20240611144143-0z0nr96","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" ⑴取本品粉末0.5g，置试管中，加水5ml，用力振摇 1min，发生持久性泡沫，放置10min不消失。（检查皂甙）⑵取本品粉末2g，加乙醇10ml，振摇后放置20min，吸取上清液1ml，蒸干，残渣加硫酸1滴，初显黄色，继变红色、紫堇色、棕色。（检查甾体化合物）⑶薄层色谱 取本品粉末2g，加乙醇20ml，加热回流40min，取上清液10ml，加盐酸1ml，加热回流1h后浓缩至约5ml，加水10ml，用苯20ml提取，提取液蒸干，残渣加苯2ml使溶解，作为供试液。另取菝葜皂甙元，加苯制成每1ml含5mg的溶液，作对照液。吸取上述两种溶液各7μl，分别点于同一硅胶G薄层板上，以苯-丙酮（9：1）展开，取出，晾干，喷以8%香草醛的无水乙醇溶液与硫酸溶液（7→10）的混合液（0.5：5），于100℃烘约5min。供试液谱在与对照液色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611144143-rsvereu","Type":"NodeParagraph","Properties":{"id":"20240611144143-rsvereu","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611144143-krbznxe","Type":"NodeParagraph","Properties":{"id":"20240611144143-krbznxe","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 肺；胃；肾经"}]},{"ID":"20240611144143-048stvb","Type":"NodeParagraph","Properties":{"id":"20240611144143-048stvb","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611144143-ity3yt8","Type":"NodeParagraph","Properties":{"id":"20240611144143-ity3yt8","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒"}]},{"ID":"20240611144143-0zkfemh","Type":"NodeParagraph","Properties":{"id":"20240611144143-0zkfemh","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611144143-er3gi9f","Type":"NodeParagraph","Properties":{"id":"20240611144143-er3gi9f","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒，大便溏泄者忌服。《别录》：多服令人泄。《医学入门》：凡肺中寒嗽，肾气虚脱，无火症而尺脉微弱者禁用。《本草经疏》：阳痿及易举易痿，泄泻脾弱，饮食不消化，胃虚不思食，肾虚溏泄等证，法并禁用。《本经逢原》：外感表证未除、泻痢燥渴忌之。脾胃虚热人误服，令人作泻减食，故虚损大忌。"}]},{"ID":"20240611144143-fi76uzf","Type":"NodeParagraph","Properties":{"id":"20240611144143-fi76uzf","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611144143-gwwzat2","Type":"NodeParagraph","Properties":{"id":"20240611144143-gwwzat2","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 清热泻火；滋阴润燥；止渴除烦。主温热病；高热烦渴；咳嗽气喘；燥咳；便秘；骨蒸潮热；虚烦不眠；消渴淋浊"}]},{"ID":"20240611144143-amwm0pa","Type":"NodeParagraph","Properties":{"id":"20240611144143-amwm0pa","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611144143-wfnb35a","Type":"NodeParagraph","Properties":{"id":"20240611144143-wfnb35a","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-12g，或入丸、散。清热泻火，滋阴润燥宜生用；入肾降火滋阴宜盐水炒。"}]},{"ID":"20240611144143-kci30yv","Type":"NodeParagraph","Properties":{"id":"20240611144143-kci30yv","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611144143-s5fo44s","Type":"NodeParagraph","Properties":{"id":"20240611144143-s5fo44s","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 白虎汤《伤寒论》；白虎加人参汤《伤寒论》；白虎加桂枝汤《金匮要略》"}]},{"ID":"20240611144143-vitid9m","Type":"NodeParagraph","Properties":{"id":"20240611144143-vitid9m","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611144143-hfa4u1n","Type":"NodeParagraph","Properties":{"id":"20240611144143-hfa4u1n","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主消渴热中，除邪气肢体浮肿，下水，补不足，益气。"}]},{"ID":"20240611144143-b5x1o0o","Type":"NodeParagraph","Properties":{"id":"20240611144143-b5x1o0o","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：疗伤寒久疟烦热，胁下邪气，膈中恶及风汗内疸。"}]},{"ID":"20240611144143-wve18oa","Type":"NodeParagraph","Properties":{"id":"20240611144143-wve18oa","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：甚疗热结，亦主疟热烦。"}]},{"ID":"20240611144143-1o8kxmb","Type":"NodeParagraph","Properties":{"id":"20240611144143-1o8kxmb","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：主治心烦躁闷，骨热劳往来，生产后蓐劳，肾气劳，憎寒虚损，患人虚而口干，加而用之。"}]},{"ID":"20240611144143-kjwqoj2","Type":"NodeParagraph","Properties":{"id":"20240611144143-kjwqoj2","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：通小肠，消痰止嗽，润心肺，补虚乏，安心止惊悸。"}]},{"ID":"20240611144143-0ipcky7","Type":"NodeParagraph","Properties":{"id":"20240611144143-0ipcky7","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"6.张元素：凉心去热，治阳明火热，泻膀胱肾经火，热厥头痛，下痢腰痛，喉中腥臭。"}]},{"ID":"20240611144143-8yj44jn","Type":"NodeParagraph","Properties":{"id":"20240611144143-8yj44jn","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"7.王好古：泻肺火，滋肾水，治命门相火有余。"}]},{"ID":"20240611144143-1m3156y","Type":"NodeParagraph","Properties":{"id":"20240611144143-1m3156y","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"8.《本草纲目》：安胎，止子烦，辟射工溪毒。"}]},{"ID":"20240611144143-0047fi9","Type":"NodeParagraph","Properties":{"id":"20240611144143-0047fi9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"9.《本草求原》：治嗽血，喘，淋，口病，尿血，呢逆，盗汗，遗精，痹痿，瘛苁。"}]},{"ID":"20240611144143-d9fl4cg","Type":"NodeParagraph","Properties":{"id":"20240611144143-d9fl4cg","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"10.《医学启源》：知母，《主治秘要》云作利小便之佐使，肾中本药。上头、引经皆酒炒。刮去毛，里白者佳。"}]},{"ID":"20240611144143-vxsbc7e","Type":"NodeParagraph","Properties":{"id":"20240611144143-vxsbc7e","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"11.李杲：知母，其用有四：泻无根之肾火，疗有汗之骨蒸，止虚劳之热，滋化源之阴。仲景用此入白虎汤治不得眠者，烦躁也。烦出于肺，躁出于肾，君以石膏，佐以知母之苦寒，以清肾之源，缓以甘草、粳米，使不速下也。又凡病小便闭塞而渴者，热在上焦气分，肺中伏热，不能生水，膀胱绝其化源，宜用气薄味薄淡渗之药，以泻肺火、清肺金而滋水之化源。若热在下焦血分而不渴者，乃真水不足，膀胱干涸，乃无阴则阳无以化，法当用黄柏、知母大苦大寒之药，以补肾与膀胱，使阴气行而阳自化，小便自通。"}]},{"ID":"20240611144143-c2fw97n","Type":"NodeParagraph","Properties":{"id":"20240611144143-c2fw97n","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"12.《本草纲目》：肾苦燥，宜食辛以润之；肺苦逆，宜食苦以泻之。知母之辛苦寒凉，下则润肾燥而滋阴，上则清肺金泻火，乃二经气分药也；黄柏则是肾经血分药，故二药必相须而行，昔人譬之虾与水母，必相依附。"}]},{"ID":"20240611144143-u6s8n8t","Type":"NodeParagraph","Properties":{"id":"20240611144143-u6s8n8t","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"13.《本草通玄》：知母苦寒，气味俱厚，沉而下降，为肾经本药。兼能清肺者，为其肃清龙雷，勿使僭上，则手太阴无销烁之虞也。泻有余之相火，理消渴之烦蒸，凡止咳安胎，莫非清火之用。多服令人泄泻，亦令人减食，此惟实火燔灼者，方可暂用。若施之于虚损之人，如水益深矣。盖苦寒之味，行天地肃杀之令，非长养万物者也。"}]},{"ID":"20240611144143-fanpmag","Type":"NodeParagraph","Properties":{"id":"20240611144143-fanpmag","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"14.《本草正》：古书言知母佐黄柏滋阴降火，有金水相生之义。盖谓黄柏能制膀胱、命门阴中之火，知母能消肺金，制肾水化源之火，去火可以保阴，是即所谓滋阴也。故洁古、东垣皆以为滋阴降火之要药。继自丹溪而后，则皆用以为补阴，诚大谬矣。夫知母以沉寒之性，本无生气，用以清火则可，用以补阴，则何补之有？。"}]},{"ID":"20240611144143-xntny6b","Type":"NodeParagraph","Properties":{"id":"20240611144143-xntny6b","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"15.《药品化义》：知母与黄柏并用，非为降火，实能助水；与贝母同行，非为清痰，专为滋阴。"}]},{"ID":"20240611144143-90ogb6p","Type":"NodeParagraph","Properties":{"id":"20240611144143-90ogb6p","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"16.《本草新编》：黄柏未尝不入气分，而知母未尝不入血分也。黄柏清肾中之火，亦能清肺中之火，知母泻肾中之热，而亦泻胃中之热，胃为多气多血之腑，岂止入于气分，而不入于血分耶？是二药不必兼用。"}]},{"ID":"20240611144143-6nbbov9","Type":"NodeParagraph","Properties":{"id":"20240611144143-6nbbov9","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"17.《本经逢原》：知母，《本经》言除邪气肢体浮肿，是指湿热水气而言。故下文云下水，补不足，益气，乃湿热相火有余，烁灼精气之候，故用此清热养阴，邪热去则正气复矣。"}]},{"ID":"20240611144143-kpkt0uc","Type":"NodeParagraph","Properties":{"id":"20240611144143-kpkt0uc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"18.《重庆堂随笔》：知母，清肺胃气分之热，则津液不耗而阴自潜滋暗长矣。然仲圣云，胃气生热，其阳则绝。盖胃热太盛，则阴不足以和阳，津液渐干，而成枯燥不能杀谷之病，其阳则绝者，即津液涸竭也，清其热，俾阳不绝，则救津液之药，虽谓之补阳也可。乃后人以为寒凉之品，非胃家所喜，谆谆戒勿轻用，辄从事于香燥温补之药者何哉！。"}]},{"ID":"20240611144143-4y2injj","Type":"NodeParagraph","Properties":{"id":"20240611144143-4y2injj","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"19.《本经疏证》：知母能益阴清热止渴，人所共知，其能下水，则以古人用者甚罕，后学多不明其故。《千金》、外台》两书用知母治水气各一方。《千金》曰，有人患水肿腹大，其坚如石，四肢细，少劳苦足胫即肿，少饮食便气急，此终身之疾，服利下药不瘥者，宜服此药，微除风湿，利小便，消水谷，岁久服之，乃可得力，瘥后可常服。其所用药，则加知母于五苓散中，更增鬼箭羽、丹参、独活、秦艽、海藻也。《外台》曰，《古今录验》泽漆汤，疗寒热当风，饮多暴肿，身如吹，脉浮数者。其所用药，则泽泻、知母、海藻、茯苓、丹参、秦艽、防己、猪苓、大黄、通草、木香也。其曰，除风湿，利小便，曰疗寒热当风，饮多暴肿。可见《本经》所着下水之效，见于除肢体浮肿，而知母所治之肢体浮肿，乃邪气肢体浮肿，非泛常肢体浮肿比矣。正以寒热外盛，邪火内着，渴而引饮，火气不能化水，水遂泛滥四射，治以知母，是泄其火，使不作渴引饮，水遂无继，蓄者旋消，由此言之，仍是治渴，非治水也。于此，见凡肿在一处，他处反消瘦者，多是邪气勾留，水火相阻之候，不特《千金方》水肿腹大四肢细，即《金匮要略》中桂枝芍药知母汤，脚肿如脱，亦其一也。《金匮方》邪气水火交阻于下，《千金方》邪气水火交阻于中，阻于下者，非发散不为功，阻于中者，非渗利何由泄，此《千金方》所以用五苓散，《金匮方》所以用麻黄、附子、防风，然其本质均为水火交阻，故其用桂、术、知母则同也，桂、术治水之阻，知母治火之阻，于此遂可见矣。"}]},{"ID":"20240611144143-nedd5eh","Type":"NodeParagraph","Properties":{"id":"20240611144143-nedd5eh","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"20.、《医学衷中参西录》：知母原不甚寒，亦不甚苦，尝以之与黄芪等分并用，则分毫不觉凉热，其性非大寒可知。又以知母一两加甘草二钱煮饮之，即甘胜于苦，其味非大苦可知。寒、苦皆非甚大，而又多液，是以能滋阴也。有谓知母但能退热，不能滋阴者，犹浅之乎视知母也。是以愚治热实脉数之证，必用知母，若用黄芪补气之方，恐其有热不受者，亦恒辅以知母。"}]},{"ID":"20240611144143-9z8ws04","Type":"NodeParagraph","Properties":{"id":"20240611144143-9z8ws04","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"21.《本草正义》：知母寒润，止治实火，泻肺以泄壅热，肺痈燥咳宜之，而虚热咳嗽大忌。清胃以救津液，消中瘅热宜之，而脾气不旺亦忌。通膀胱水道，疗淋浊初起之结热，伐相火之邪，主强阳不痿之标剂。热病之在阳明，烦渴大汗，脉洪里热，佐石膏以扫炎症；疟证之在太阴，湿浊熏蒸，汗多热甚，佐草果以泄脾热。统详主治，不外实热有余四字之范围。"}]},{"ID":"20240611144143-hgeyew5","Type":"NodeParagraph","Properties":{"id":"20240611144143-hgeyew5","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611144143-30dvetc","Type":"NodeParagraph","Properties":{"id":"20240611144143-30dvetc","updated":"20240611144143"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611144144-7xkh0db","Type":"NodeThematicBreak","Properties":{"id":"20240611144144-7xkh0db"}},{"ID":"20240611144145-bklmbi4","Type":"NodeParagraph","Properties":{"id":"20240611144145-bklmbi4"}}]}