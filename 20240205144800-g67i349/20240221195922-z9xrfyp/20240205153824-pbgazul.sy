40814101934-ldw4f7n","Type":"NodeParagraph","Properties":{"id":"20240814101934-ldw4f7n","updated":"20240814101942"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 825px;","style":"width: 815px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玄参 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玄参 25-20240814101922-48ruqkk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 815px;\" parent-style=\"width: 825px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 469px;","style":"width: 459px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玄参 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玄参 19-20240814101206-3u886u6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 459px;\" parent-style=\"width: 469px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814101827-88iqjg9","Type":"NodeParagraph","Properties":{"id":"20240814101827-88iqjg9","updated":"20240814102215"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 657px;","style":"width: 647px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玄参 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玄参 24-20240814101827-g60utof.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 647px;\" parent-style=\"width: 657px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 629px;","style":"width: 619px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"玄参 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/玄参 1-20240814093115-wyywv78.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 619px;\" parent-style=\"width: 629px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611142739-u9x7u80","Type":"NodeThematicBreak","Properties":{"id":"20240611142739-u9x7u80"}},{"ID":"20240611143012-wvh1qwa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143012-wvh1qwa","updated":"20240611143022"},"Children":[{"Type":"NodeText","Data":"玄参《证类本草》"}]},{"ID":"20240611143012-qc83yyj","Type":"NodeParagraph","Properties":{"id":"20240611143012-qc83yyj","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"味苦、咸，微寒，无毒。主腹中寒热积聚，女子产乳余疾，补肾气，令人目明，主暴中风，伤寒身热，支满狂邪，忽忽不知人，温疟洒洒，血瘕，下寒血，除胸中气，下水，止烦渴，散颈下核，痈肿，心腹痛，坚症，定五脏。久服补虚，明目，强阴益精。一名重台，一名玄台，一名鹿肠，一名正马，一名咸，一名端。生河间川谷及冤句。三月、四月采根，曝干。（恶黄 、干姜、大枣、山茱萸，反藜芦。）"}]},{"ID":"20240611143012-dd1ll61","Type":"NodeParagraph","Properties":{"id":"20240611143012-dd1ll61","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出近道，处处有。茎似人参而长大。根甚黑，亦微香，道家时用，亦以合香。"}]},{"ID":"20240611143012-mc9smi4","Type":"NodeParagraph","Properties":{"id":"20240611143012-mc9smi4","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"唐本注云∶玄参根苗并臭，茎亦不似人参，陶云道家亦以合香，未见其理也。今注详此药，茎方大，高四、五尺，紫赤色而有细毛。叶如掌大而尖长。根生青白，干即紫黑，新者润腻，合香用之。俗呼为馥草，酒渍饮之，疗诸毒鼠 。陶云似人参茎，唐本注言根苗并臭，盖未深识尔。臣禹锡等谨按药性论云∶玄参，使，一名逐马，味苦。能治暴结热，主热风头痛，伤寒劳复，散瘤瘿瘰疠。日华子云∶治头风，热毒游风，补虚劳损，心惊烦躁劣乏，骨蒸传尸邪气，止健忘，消肿毒。"}]},{"ID":"20240611143012-4p2t33q","Type":"NodeParagraph","Properties":{"id":"20240611143012-4p2t33q","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"图经曰∶玄参，生河间及冤句，今处处有之。二月生苗。叶似脂麻，又如槐柳。细茎青紫色。"}]},{"ID":"20240611143012-m8umx25","Type":"NodeParagraph","Properties":{"id":"20240611143012-m8umx25","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"七月开花青碧色。八月结子黑色。亦有白花，茎方大，紫赤色而有细毛，有节若竹者，高五、六尺。叶如掌大而尖长如锯齿。其根尖长，生青白。干即紫黑，新者润腻。一根可生五、七枚，三月、八月、九月采曝干。或云蒸过日干。"}]},{"ID":"20240611143012-kut7tj8","Type":"NodeParagraph","Properties":{"id":"20240611143012-kut7tj8","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶道家时用合香。今人有传其法酒瓶中，投白蜜渍，令瓶七、八分，紧封系头，安釜中，煮不住火，一伏时止火，候冷破瓶取出，再捣熟，如干，更用熟蜜和，瓷器盛，阴埋地中，旋取，使入龙脑搜，亦可以熏衣。"}]},{"ID":"20240611143012-sasz321","Type":"NodeParagraph","Properties":{"id":"20240611143012-sasz321","updated":"20240611143012"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡采得后，须用蒲草重重相隔，入甑蒸两伏时后，出干晒。使用时，勿令犯铜，饵之后噎人喉，丧人目，拣去蒲草尽了，用之。经验方∶治患劳人烧香法∶用玄参一斤，甘松六两，为末，炼蜜一斤和匀，入瓷瓶内封闭，地中埋窨十日取出。更用灰末六两，更炼蜜六两，和令匀，入瓶内封，更窨五日取出。烧令其鼻中常闻其香，疾自愈。广利方治瘰 ，经年久不瘥。生玄参捣碎敷上，日二易之。"}]},{"ID":"20240611142937-3qeacob","Type":"NodeThematicBreak","Properties":{"id":"20240611142937-3qeacob"}},{"ID":"20240611143002-fy35gjv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143002-fy35gjv","updated":"20240611143007"},"Children":[{"Type":"NodeText","Data":"玄参《本草蒙筌》"}]},{"ID":"20240611143002-5r4cliw","Type":"NodeParagraph","Properties":{"id":"20240611143002-5r4cliw","updated":"20240611143002"},"Children":[{"Type":"NodeText","Data":"味苦、咸，气微寒。无毒。春生深谷，茎方叶似芝麻；（又如槐柳细长。）秋取旁根，（正根勿用。）初白干旋紫黑。鼻闻微臭，咀片忌铜。误犯饵之，噎喉丧目。古人深戒，吴载医通。（郡《韩氏医通》。）恶耆枣姜茱，（黄耆、大枣、生姜、山茱。）反藜芦一味。可为君药，惟走肾经。强阴益精，补肾明目。治伤寒身热支满，忽忽如不知人。疗温疟寒热往来，洒洒时常发颤。除女人产乳余疾，驱男子骨蒸传尸。逐肠内血瘕坚症，散颈下痰核痈肿。盖此乃枢机之剂，管领诸气，上下整肃而不致浊。治空中氤氲之气，散无根浮游之火，惟此为最也。"}]},{"ID":"20240611142938-4zc78iv","Type":"NodeThematicBreak","Properties":{"id":"20240611142938-4zc78iv"}},{"ID":"20240611142949-bbc71c6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142949-bbc71c6","updated":"20240611142957"},"Children":[{"Type":"NodeText","Data":"玄参《增广和剂局方药性总论》"}]},{"ID":"20240611142949-seqqfl4","Type":"NodeParagraph","Properties":{"id":"20240611142949-seqqfl4","updated":"20240611142949"},"Children":[{"Type":"NodeText","Data":"味苦咸，微寒，无毒。主腹中寒热积聚，女子产乳余疾，补肾气，令人目明。主暴中伤寒，身热支满狂邪，温疟，血瘕，下寒血，除胸中气，下水，止烦渴，散颈下核，痈肿心腹痛，坚症。《药性论》云∶使。能治暴结热，主热风头痛，伤寒复劳，散瘤瘿瘰 。日恶∶黄 、干姜、大枣、山茱萸。反∶藜芦。"}]},{"ID":"20240611142938-vu4v3q4","Type":"NodeThematicBreak","Properties":{"id":"20240611142938-vu4v3q4"}},{"ID":"20240611142939-uvatxar","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142939-uvatxar","updated":"20240611142943"},"Children":[{"Type":"NodeText","Data":"玄参《吴普本草》"}]},{"ID":"20240611142939-d5y0iz9","Type":"NodeParagraph","Properties":{"id":"20240611142939-d5y0iz9","updated":"20240611142939"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十一"}]},{"ID":"20240611142939-rfoy1gd","Type":"NodeParagraph","Properties":{"id":"20240611142939-rfoy1gd","updated":"20240611142939"},"Children":[{"Type":"NodeText","Data":"一名鬼藏，一名正马，一名重台，一名鹿肠，一名端，一名玄台。神农、桐君、黄帝、雷公、扁鹊∶苦，无毒。岐伯∶咸。李氏∶寒。或生冤句山阳。二月生，叶如梅毛，四四相值，以芍药，黑茎，茎方，高四、五尺，华赤，生枝间，四月实黑。"}]},{"ID":"20240611142800-h5lhcy4","Type":"NodeThematicBreak","Properties":{"id":"20240611142800-h5lhcy4"}},{"ID":"20240611142927-geycyks","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142927-geycyks","updated":"20240611142931"},"Children":[{"Type":"NodeText","Data":"玄参《汤液本草》"}]},{"ID":"20240611142927-3k66as7","Type":"NodeParagraph","Properties":{"id":"20240611142927-3k66as7","updated":"20240611142927"},"Children":[{"Type":"NodeText","Data":"气微寒，味苦、咸。无毒。"}]},{"ID":"20240611142927-sc46dqt","Type":"NodeParagraph","Properties":{"id":"20240611142927-sc46dqt","updated":"20240611142927"},"Children":[{"Type":"NodeText","Data":"《象》云∶足少阴肾经之君药也，治本经须用。"}]},{"ID":"20240611142927-wfs3si8","Type":"NodeParagraph","Properties":{"id":"20240611142927-wfs3si8","updated":"20240611142927"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主腹中寒热积聚，女子产乳余疾，补肾气，令人目明。主暴中风伤寒，身热支满，狂邪，忽忽不知人，温疟洒洒，血瘕，下寒血，除胸中气，下水，止烦渴。"}]},{"ID":"20240611142927-hps4eqt","Type":"NodeParagraph","Properties":{"id":"20240611142927-hps4eqt","updated":"20240611142927"},"Children":[{"Type":"NodeText","Data":"易老云∶玄参乃枢机之剂，管领诸气，上下整肃而不浊，风药中多用之。故《活人书》治伤寒阳毒，玄参升麻汤，治汗下吐后毒不散，则知为整肃枢机之剂。以此论之，治空中氤氲之气，无根之火，以玄参为圣药。"}]},{"ID":"20240611142826-0yd0i1d","Type":"NodeThematicBreak","Properties":{"id":"20240611142826-0yd0i1d"}},{"ID":"20240611142919-rcgccg3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142919-rcgccg3","updated":"20240611142922"},"Children":[{"Type":"NodeText","Data":"玄参《本经逢原》"}]},{"ID":"20240611142919-p36jt9s","Type":"NodeParagraph","Properties":{"id":"20240611142919-p36jt9s","updated":"20240611142919"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名黑参"}]},{"ID":"20240611142919-jj9j6uo","Type":"NodeParagraph","Properties":{"id":"20240611142919-jj9j6uo","updated":"20240611142919"},"Children":[{"Type":"NodeText","Data":"苦微寒，无毒。反藜芦。"}]},{"ID":"20240611142919-1ykdudy","Type":"NodeParagraph","Properties":{"id":"20240611142919-1ykdudy","updated":"20240611142919"},"Children":[{"Type":"NodeText","Data":"《本经》主腹中寒热积聚，女子产乳余疾，补肾气，令人明目。"}]},{"ID":"20240611142919-pllqdkk","Type":"NodeParagraph","Properties":{"id":"20240611142919-pllqdkk","updated":"20240611142919"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"黑参入足少阴肾经，主肾水受伤，真阴失守，孤阳无根，亢而僭逆，咽喉肿痛之专药。又治伤寒阳毒，汗下不解，发斑咽痛，心下懊 ，烦不得眠，心神颠倒欲绝者俱用。"}]},{"ID":"20240611142919-jkj3q4x","Type":"NodeParagraph","Properties":{"id":"20240611142919-jkj3q4x","updated":"20240611142919"},"Children":[{"Type":"NodeText","Data":"玄参专清上焦氤氲之气、无根之火。《本经》治腹中寒热积聚，女子产乳余疾，并可清有形热滞，故消瘰 结核。治目赤肿痛，《本经》又云，补肾气，令人明目，不特治暴赤肿痛。"}]},{"ID":"20240611142919-uj5zulo","Type":"NodeParagraph","Properties":{"id":"20240611142919-uj5zulo","updated":"20240611142919"},"Children":[{"Type":"NodeText","Data":"总皆散清火之验也。但其性寒滑，脾虚泄泻者禁用。"}]},{"ID":"20240611142826-va7mhwp","Type":"NodeThematicBreak","Properties":{"id":"20240611142826-va7mhwp"}},{"ID":"20240611142905-vbx20x4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142905-vbx20x4","updated":"20240611142912"},"Children":[{"Type":"NodeText","Data":"玄参《顾松园医镜》"}]},{"ID":"20240611142905-dwl118g","Type":"NodeParagraph","Properties":{"id":"20240611142905-dwl118g","updated":"20240611142905"},"Children":[{"Type":"NodeText","Data":"〔苦咸微寒，入肾经。反藜芦，忌铜器。蒸晒。〕补肾益精，退热明目，理虚劳骨蒸，〔壮水之效。〕解伤寒斑毒。〔散火之功。〕止烦渴，利咽喉，〔俱滋阴降火之力。〕能散瘰 ，可消肿毒。〔寒能解热，咸能软坚。〕色黑味咸。益阴除热，乃肾经君药也。《活人书》治伤寒汗下后，毒不散及心下懊 ，烦不得眠，心神颠倒欲绝者，俱用玄参，治胸中氤氲之气，无根之火，此为圣药。"}]},{"ID":"20240611142905-uq3pfyy","Type":"NodeParagraph","Properties":{"id":"20240611142905-uq3pfyy","updated":"20240611142905"},"Children":[{"Type":"NodeText","Data":"性寒而滑，脾虚泄泻者忌之。"}]},{"ID":"20240611142840-vkx1lw7","Type":"NodeThematicBreak","Properties":{"id":"20240611142840-vkx1lw7"}},{"ID":"20240611142851-texlpn1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142851-texlpn1","updated":"20240611142856"},"Children":[{"Type":"NodeText","Data":"玄参《本草求真》"}]},{"ID":"20240611142851-il8jt2u","Type":"NodeParagraph","Properties":{"id":"20240611142851-il8jt2u","updated":"20240611142851"},"Children":[{"Type":"NodeText","Data":"（山草）制肾浮游之火攻于咽喉"}]},{"ID":"20240611142851-7o2rolo","Type":"NodeParagraph","Properties":{"id":"20240611142851-7o2rolo","updated":"20240611142851"},"Children":[{"Type":"NodeText","Data":"玄参（专入肾）。苦咸微寒。色黑入肾。书虽载能壮水。以制浮游无根之火。攻于咽喉。（肾脉贯肝膈。入肺中。循喉咙。系舌本。凡肾水虚损。相火上炎者。多有喉痹咽肿咳嗽吐血等症。）谓其肾水受伤。真阴失守。孤阳无根。发为火病。得此色黑性润。微寒以为节制。则阳得阴归。而咽喉不致肿痛而莫已也。然此只可暂治。以熄其火。非若地黄性禀纯阴。力能壮水。以制阳光。即书有言服此玄参。可以益精明目。消痰除嗽。及治一切骨蒸传尸发斑。（发斑有阴有阳。此止就阳毒言耳。）懊 烦渴。瘰 痈疽等症。皆是从其浮游火熄起见而言。病无不治。非真真阴亏损。必借此以为之壮。（玄参其性微寒。故止可以折火。不能以滋阴。）若使病非火起。则服此寒滑之味。不更使病转剧乎！是以书载脾虚泄泻。服此黑参．为大忌耳。蒸过焙用。勿犯铁器。恶黄 山茱姜枣。反藜芦。"}]},{"ID":"20240611142840-onfjevh","Type":"NodeThematicBreak","Properties":{"id":"20240611142840-onfjevh"}},{"ID":"20240611142841-hnevk3f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142841-hnevk3f","updated":"20240611142846"},"Children":[{"Type":"NodeText","Data":"玄参《冯氏锦囊秘录》"}]},{"ID":"20240611142841-pjq98vp","Type":"NodeParagraph","Properties":{"id":"20240611142841-pjq98vp","updated":"20240611142841"},"Children":[{"Type":"NodeText","Data":"正禀北方水气，兼得春阳之和，故味苦咸，微寒，无毒。忌铜器。如入丸药，宜蒸过晒干，瓦器中焙燥。"}]},{"ID":"20240611142841-v3kcxcq","Type":"NodeParagraph","Properties":{"id":"20240611142841-v3kcxcq","updated":"20240611142841"},"Children":[{"Type":"NodeText","Data":"玄参，治骨蒸，散浮游之火，滋阴补肾，清利咽喉，消痰住嗽，兼能明目。治伤寒身热支满，忽忽如不知人；疗温疟寒热往来，洒洒时常发颤。女人产乳余疾，男子骨蒸传尸，逐肠内血瘕坚 ，散颈下痰核痈肿，管领上下，诸气整肃而不致浊，散空中氤氲之气，肾经无根之火，惟此为最也。然暂治有余之火则可，若欲固本滋水，则重地黄，而不及此也。至如血少目昏，停饮寒热，血虚腹痛，脾虚泄泻，并忌之。"}]},{"ID":"20240611142841-1nc53ip","Type":"NodeParagraph","Properties":{"id":"20240611142841-1nc53ip","updated":"20240611142841"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 初起热毒盛者，用以清利咽喉，并忌一切热毒痈肿，颈中痰热，咽喉肿痛，及痘后余毒并宜。但肾经痘禁用，脾虚者忌投。"}]},{"ID":"20240611142841-9xtuyin","Type":"NodeParagraph","Properties":{"id":"20240611142841-9xtuyin","updated":"20240611142841"},"Children":[{"Type":"NodeText","Data":"按∶玄参色黑味咸，故走肾经，故人多用以治上焦火症者，正谓水不胜火，亢而僭上，壮水之主以制阳光。然性本寒滑，须蒸晒稍减寒性，亦不可久用也。泄泻者禁之。"}]},{"ID":"20240611142826-1y95bnk","Type":"NodeThematicBreak","Properties":{"id":"20240611142826-1y95bnk"}},{"ID":"20240611142827-mk4sljy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142827-mk4sljy","updated":"20240611142831"},"Children":[{"Type":"NodeText","Data":"玄参《千金翼方》"}]},{"ID":"20240611142827-frlnl81","Type":"NodeParagraph","Properties":{"id":"20240611142827-frlnl81","updated":"20240611142827"},"Children":[{"Type":"NodeText","Data":"味苦咸，微寒，无毒。主腹中寒热，积聚，女子产乳余疾，补肾气，令人目明。主暴中风伤寒，身热支满，狂邪忽忽不知人，温疟洒洒，血瘕，下寒血，除胸中气，下水，止烦渴，散颈下核，痈肿，心腹痛，坚症，定五脏。久服补虚明目，强阴益精。一名重台，一名玄台，一名鹿肠，一名正马，一名咸，一名端。生河间川谷及冤句，三月四月采根，曝干。"}]},{"ID":"20240611142800-lm9fcaw","Type":"NodeThematicBreak","Properties":{"id":"20240611142800-lm9fcaw"}},{"ID":"20240611142801-lit2967","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142801-lit2967","updated":"20240611142820"},"Children":[{"Type":"NodeText","Data":"玄参《神农本草经百种录》"}]},{"ID":"20240611142801-ck381or","Type":"NodeParagraph","Properties":{"id":"20240611142801-ck381or","updated":"20240611142801"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主腹中寒热，积聚，皆火气凝结之疾。女子产乳余疾，产后血亏，冲脉之火易动。清血中之火，则诸疾平矣。补肾气，令人目明。除阴分之火，则头目清明矣。"}]},{"ID":"20240611142801-c1jeesz","Type":"NodeParagraph","Properties":{"id":"20240611142801-c1jeesz","updated":"20240611142801"},"Children":[{"Type":"NodeText","Data":"玄参色黑属肾而性寒，故能除肾家浮游上升之火。但肾火有阳有阴，阳火发于气分，火盛则伤气。《内经》所谓壮火食气是也。阴火发于血分，火盛则伤血。《内经》所谓诸寒之而热者，取之阴是也。产后血脱则阴衰，而火无所制，又不可以寒凉折之；气血未宁，又不能纳峻补之剂。惟玄参宁火而带微补，用之最为的当也。"}]},{"ID":"20240611142739-iich133","Type":"NodeThematicBreak","Properties":{"id":"20240611142739-iich133"}},{"ID":"20240611142752-qkvi0ei","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142752-qkvi0ei","updated":"20240611142755"},"Children":[{"Type":"NodeText","Data":"玄参《新修本草》"}]},{"ID":"20240611142752-13fx4zl","Type":"NodeParagraph","Properties":{"id":"20240611142752-13fx4zl","updated":"20240611142752"},"Children":[{"Type":"NodeText","Data":"味苦、咸、微寒，无毒。主腹中寒热积聚，女子产乳余疾，补肾气，令人目明。疗暴中风伤寒，身热支满，狂邪忽忽不知人，温疟洒洒，血瘕，下寒血，除胸中气，下水，止烦渴，散坚症，定五脏。久服补虚，明目，强阴，益精。一名重台，一名玄台，一名鹿肠，一名正马，一名咸，一名端。生河间川谷及宛朐。三月、四月采根，曝干。"}]},{"ID":"20240611142752-a7sglkx","Type":"NodeParagraph","Properties":{"id":"20240611142752-a7sglkx","updated":"20240611142752"},"Children":[{"Type":"NodeText","Data":"恶黄 、干姜、大枣、山茱萸，反藜芦。 今出近道，处处有。茎似人参而长大。根甚黑，亦微香，道家时用，亦以合香。"}]},{"ID":"20240611142752-q3wfm10","Type":"NodeParagraph","Properties":{"id":"20240611142752-q3wfm10","updated":"20240611142752"},"Children":[{"Type":"NodeText","Data":"〔谨案〕玄参根苗并臭，茎亦不似人参。陶云道家亦以合香，未见其理也。"}]},{"ID":"20240611142739-mwsfwdw","Type":"NodeThematicBreak","Properties":{"id":"20240611142739-mwsfwdw"}},{"ID":"20240611142740-s2imlp5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142740-s2imlp5","updated":"20240611142746"},"Children":[{"Type":"NodeText","Data":"玄参《本草纲目》"}]},{"ID":"20240611142740-xm02wkv","Type":"NodeParagraph","Properties":{"id":"20240611142740-xm02wkv","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"「释名」亦名黑参、玄台、重台、鹿肠、正马、逐马、馥草、野脂麻、鬼藏。"}]},{"ID":"20240611142740-iu8nfiq","Type":"NodeParagraph","Properties":{"id":"20240611142740-iu8nfiq","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、微寒、无毒。"}]},{"ID":"20240611142740-wghsypt","Type":"NodeParagraph","Properties":{"id":"20240611142740-wghsypt","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611142740-zfwy2yd","Type":"NodeParagraph","Properties":{"id":"20240611142740-zfwy2yd","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"1、诸毒鼠瘘（颈部淋巴结核）。用玄参泡酒，每天饮食少许。"}]},{"ID":"20240611142740-sgscuqn","Type":"NodeParagraph","Properties":{"id":"20240611142740-sgscuqn","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"2、年久瘰疬。用生玄参捣烂敷患处。一天换药二次。"}]},{"ID":"20240611142740-uu95dwy","Type":"NodeParagraph","Properties":{"id":"20240611142740-uu95dwy","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"3、用玄参研为末，取淘米水煮的猪肝，每日蘸药末吃。"}]},{"ID":"20240611142740-o6rzt29","Type":"NodeParagraph","Properties":{"id":"20240611142740-o6rzt29","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"4、发斑咽痛。用玄参、升麻、甘草各半两、加水三碗，煎成一碗半，温服。"}]},{"ID":"20240611142740-lueauao","Type":"NodeParagraph","Properties":{"id":"20240611142740-lueauao","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"5、急喉痹风。用玄参、鼠粘子（半生半炒）各一两，共研为末，新汲水一碗调服，立愈。"}]},{"ID":"20240611142740-i1d6m99","Type":"NodeParagraph","Properties":{"id":"20240611142740-i1d6m99","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"6、鼻中生疮。用玄参末涂搽，或把玄参在水中泡软后塞入鼻中。"}]},{"ID":"20240611142740-73m5t16","Type":"NodeParagraph","Properties":{"id":"20240611142740-73m5t16","updated":"20240611142740"},"Children":[{"Type":"NodeText","Data":"7、小肠疝气。用玄参炒过，做成丸子。每服一钱半，空心服，酒送下。出汗即为有效。"}]},{"ID":"20240611142716-78cyfqc","Type":"NodeThematicBreak","Properties":{"id":"20240611142716-78cyfqc"}},{"ID":"20240611142728-bmi7z2a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142728-bmi7z2a","updated":"20240611142732"},"Children":[{"Type":"NodeText","Data":"玄参《本草经集注》"}]},{"ID":"20240611142728-ywrep55","Type":"NodeParagraph","Properties":{"id":"20240611142728-ywrep55","updated":"20240611142728"},"Children":[{"Type":"NodeText","Data":"味苦，咸，微寒，无毒。主治腹中寒热积聚，女子产乳余疾，补肾气，令人目明。治中风伤寒，身热支满，狂邪忽忽不知人，温疟洒洒，血瘕，下寒血，除胸中气，下水，止烦渴，散颈下核，痈肿，心腹痛，坚症，定五脏。久服补虚，明目，强阴，益精。一名重台，一名玄台，一名鹿肠，一名正马，一名咸，一名端。生河间川谷及冤句。三月、四月采根，曝干。（恶黄 、干姜、大枣、山茱萸，反藜芦。）"}]},{"ID":"20240611142728-90bwn4j","Type":"NodeParagraph","Properties":{"id":"20240611142728-90bwn4j","updated":"20240611142728"},"Children":[{"Type":"NodeText","Data":"今出近道，处处有。茎似人参而长大。根甚黑，亦微香，道家时用，亦以合香。"}]},{"ID":"20240611142717-25o5teo","Type":"NodeThematicBreak","Properties":{"id":"20240611142717-25o5teo"}},{"ID":"20240611142718-4dvnftd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142718-4dvnftd","updated":"20240611142722"},"Children":[{"Type":"NodeText","Data":"玄参《医学入门》"}]},{"ID":"20240611142718-lfrkds1","Type":"NodeParagraph","Properties":{"id":"20240611142718-lfrkds1","updated":"20240611142718"},"Children":[{"Type":"NodeText","Data":"玄参咸苦气微寒，清神气泻无根火，风寒身热疟昏狂，肾伤腹块颈核瘰。"}]},{"ID":"20240611142718-82bam1x","Type":"NodeParagraph","Properties":{"id":"20240611142718-82bam1x","updated":"20240611142718"},"Children":[{"Type":"NodeText","Data":"黑参也。无毒。易老云∶枢机之剂，常领诸气上下整肃而不浊，治空中氤氲之气，三焦无根之火，肾伤必用之，本经君药也。治暴中风寒，身热支满，狂邪忽忽不知人。温疟洒洒，胸中多气，烦渴火肿者，皆浊气为之也。补内伤肾气，明目强阴益精，乃敷尸颈上有核，腹中有块，骨蒸惊悸健忘，一切痈肿瘰 ，头风喉痹，热毒游风，皆痰火聚为之也。又治妇人产后余疾，血 血瘕，名曰圣药宜哉！水洗蒲叶隔蒸，或酒蒸亦好。"}]},{"ID":"20240611142718-swvtn4z","Type":"NodeParagraph","Properties":{"id":"20240611142718-swvtn4z","updated":"20240611142718"},"Children":[{"Type":"NodeText","Data":"恶干姜、黄 、大枣、山茱萸，反藜芦，极忌铜铁。"}]},{"ID":"20240611142604-imvasdb","Type":"NodeThematicBreak","Properties":{"id":"20240611142604-imvasdb"}},{"ID":"20240611142619-qqzz9u0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142619-qqzz9u0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：玄参"}]},{"ID":"20240611142619-x2llh14","Type":"NodeParagraph","Properties":{"id":"20240611142619-x2llh14","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611142619-z82jqcg","Type":"NodeParagraph","Properties":{"id":"20240611142619-z82jqcg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" Xuán Shēn"}]},{"ID":"20240611142619-uqquoa2","Type":"NodeParagraph","Properties":{"id":"20240611142619-uqquoa2","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611142619-9dw12xn","Type":"NodeParagraph","Properties":{"id":"20240611142619-9dw12xn","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 元参、乌元参、黑参"}]},{"ID":"20240611142619-8onafo8","Type":"NodeParagraph","Properties":{"id":"20240611142619-8onafo8","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611142619-cxdm8dq","Type":"NodeParagraph","Properties":{"id":"20240611142619-cxdm8dq","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" RADIX SCROPHULARIAE"}]},{"ID":"20240611142619-w2dvwfl","Type":"NodeParagraph","Properties":{"id":"20240611142619-w2dvwfl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611142619-olq5qz1","Type":"NodeParagraph","Properties":{"id":"20240611142619-olq5qz1","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 本品为玄参科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玄参"},{"Type":"NodeText","Data":"Scrophularia ningpoensis Hemsl.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。冬季茎叶枯萎时采挖。除去根茎、幼芽、须根及泥沙，晒或烘至半干，堆放3 ～6 天，反复数次至干燥。"}]},{"ID":"20240611142619-q1gu2i3","Type":"NodeParagraph","Properties":{"id":"20240611142619-q1gu2i3","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611142619-irwzhpx","Type":"NodeParagraph","Properties":{"id":"20240611142619-irwzhpx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 本品呈类圆柱形，中间略粗或上粗下细，有的微弯曲，长6～20cm，直径1～3cm。表面灰黄色或灰褐色，有不规则的纵沟、横向皮孔及稀疏的横裂纹和须根痕。质坚实，不易折断，断面黑色，微有光泽。气特异似焦糖，味甘、微苦。"}]},{"ID":"20240611142619-r1n9fzl","Type":"NodeParagraph","Properties":{"id":"20240611142619-r1n9fzl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611142619-5fad9gf","Type":"NodeParagraph","Properties":{"id":"20240611142619-5fad9gf","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防霉，防蛀。"}]},{"ID":"20240611142619-hgmhr7x","Type":"NodeParagraph","Properties":{"id":"20240611142619-hgmhr7x","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611142619-kbcl7xd","Type":"NodeParagraph","Properties":{"id":"20240611142619-kbcl7xd","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 除去残留根茎及杂质，洗净，润透，切薄片，干燥；或微泡，蒸透，稍晾，切薄片，干燥。"}]},{"ID":"20240611142619-o0bgrti","Type":"NodeParagraph","Properties":{"id":"20240611142619-o0bgrti","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611142619-grm4qbl","Type":"NodeParagraph","Properties":{"id":"20240611142619-grm4qbl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：皮层较宽，石细胞单个散在或2～5个成群，多角形、类圆形或类方形，壁较厚，层纹明显；韧皮射线多裂隙。形成层成环。木质部射线宽广,亦多裂隙；导管少数，类多角形，直径约至113μm，伴有木纤维。薄壁细胞含核状物。"}]},{"ID":"20240611142619-s0h6pxv","Type":"NodeParagraph","Properties":{"id":"20240611142619-s0h6pxv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加水饱和的正丁醇20ml，超声处理30分钟，滤过，滤液蒸干,残渣加甲醇2ml使溶解，作为供试品溶液。另取玄参对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一硅胶G薄层板上，以正丁醇-冰醋酸-水（7：1：2）为展开剂，展开，取出，晾干，喷以香草醛硫酸试液，105℃加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同的两个红色主斑点。"}]},{"ID":"20240611142619-hkkl4pe","Type":"NodeParagraph","Properties":{"id":"20240611142619-hkkl4pe","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611142619-o155j97","Type":"NodeParagraph","Properties":{"id":"20240611142619-o155j97","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 归肺、胃、肾经。"}]},{"ID":"20240611142619-qprch7j","Type":"NodeParagraph","Properties":{"id":"20240611142619-qprch7j","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611142619-dijgq3s","Type":"NodeParagraph","Properties":{"id":"20240611142619-dijgq3s","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 甘、苦、咸，微寒。"}]},{"ID":"20240611142619-aixcxlx","Type":"NodeParagraph","Properties":{"id":"20240611142619-aixcxlx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611142619-hx9txhc","Type":"NodeParagraph","Properties":{"id":"20240611142619-hx9txhc","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 不宜与藜芦同用。"}]},{"ID":"20240611142619-0z0ow1l","Type":"NodeParagraph","Properties":{"id":"20240611142619-0z0ow1l","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611142619-uhf6ecw","Type":"NodeParagraph","Properties":{"id":"20240611142619-uhf6ecw","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 凉血滋阴，泻火解毒。用于热病伤阴，舌绛烦渴，温毒发斑，津伤便秘，骨蒸劳嗽，目赤，咽痛，瘰疠，白喉，痈肿疮毒。"}]},{"ID":"20240611142619-jy3o2dx","Type":"NodeParagraph","Properties":{"id":"20240611142619-jy3o2dx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611142619-ibkeuph","Type":"NodeParagraph","Properties":{"id":"20240611142619-ibkeuph","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611142619-v6qe182","Type":"NodeParagraph","Properties":{"id":"20240611142619-v6qe182","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611142619-ifiyndz","Type":"NodeParagraph","Properties":{"id":"20240611142619-ifiyndz","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" （1）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"北玄参"},{"Type":"NodeText","Data":"Scrophularia buergeriana Miq.[S. oldhami Oliv.]分布于东北、华北与华东地区。根与玄参功效相同。"}]},{"ID":"20240611142619-se3f1zv","Type":"NodeParagraph","Properties":{"id":"20240611142619-se3f1zv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"（2）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玄参"},{"Type":"NodeText","Data":"为咸寒之品，质润多液，功能滋阴降火、解毒、利胭。配鲜生地、丹皮、赤芍等，则清热凉血；配大生地、麦冬等，则滋阴增液；配牛蒡子、板蓝根等，则解毒利咽；配大生地、石决明、密蒙花、蝉蜕等，则明目退翳；配牡蛎、贝母、夏枯草等，则散结消瘰；配银花、当归、甘草，则解毒消肿。"}]},{"ID":"20240611142619-mj6uuge","Type":"NodeParagraph","Properties":{"id":"20240611142619-mj6uuge","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"（3）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玄参"},{"Type":"NodeText","Data":"滋养肾阴的功效，与地黄相近，故两药常配合同用。但玄参苦泄滑肠而通便，泻火解毒而利咽，临床应用范围较为广泛，一般不作长服的滋补之剂；地黄则功专补肾养阴，可作为久用的滋阴药品。"}]},{"ID":"20240611142619-1s9ly1q","Type":"NodeParagraph","Properties":{"id":"20240611142619-1s9ly1q","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611142619-9ki2zpi","Type":"NodeParagraph","Properties":{"id":"20240611142619-9ki2zpi","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611142619-9r7tc19","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142619-9r7tc19","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：玄参"}]},{"ID":"20240611142619-5perf32","Type":"NodeParagraph","Properties":{"id":"20240611142619-5perf32","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611142619-l83lj86","Type":"NodeParagraph","Properties":{"id":"20240611142619-l83lj86","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" Xuán Shēn"}]},{"ID":"20240611142619-4961m4n","Type":"NodeParagraph","Properties":{"id":"20240611142619-4961m4n","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611142619-vsy42gg","Type":"NodeParagraph","Properties":{"id":"20240611142619-vsy42gg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 重台（《本经》），鬼藏、正马、鹿肠、端、玄台（《吴普本草》），咸（《别录》），逐马（《药性论》），馥草（《开宝本草》），黑参（《孙天仁集效方》），野脂麻（《纲目》），元参（《本草通玄》）。"}]},{"ID":"20240611142619-ztisuez","Type":"NodeParagraph","Properties":{"id":"20240611142619-ztisuez","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611142619-xfwr8kj","Type":"NodeParagraph","Properties":{"id":"20240611142619-xfwr8kj","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611142619-tl6mdhj","Type":"NodeParagraph","Properties":{"id":"20240611142619-tl6mdhj","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611142619-u333yod","Type":"NodeParagraph","Properties":{"id":"20240611142619-u333yod","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 为玄参科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玄参"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。立冬前后采挖，除去茎、叶、须根，刷净泥沙，曝晒5～6天，并经常翻动，每晚须加盖稻草防冻（受冻则空心），晒至半干时，堆积2～3天，使内部变黑，再行日晒，并反复堆、晒，直至完全干燥。阴雨天可采取烘干法。本品易反潮，应贮于通风干燥处，防止生霉和虫蛀。"}]},{"ID":"20240611142619-zqghej8","Type":"NodeParagraph","Properties":{"id":"20240611142619-zqghej8","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611142619-uy9dd89","Type":"NodeParagraph","Properties":{"id":"20240611142619-uy9dd89","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 生长在山坡林下。分布安徽、江苏、浙江、福建、江西、湖南、湖北、贵州、陕西等地。浙江有大量栽培，其他各地也有栽培。主产浙江、四川、湖北。此外，贵州、湖南、江西等地亦产。以浙江产量大，质量好。"}]},{"ID":"20240611142619-zpety0j","Type":"NodeParagraph","Properties":{"id":"20240611142619-zpety0j","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611142619-cnlyfyl","Type":"NodeParagraph","Properties":{"id":"20240611142619-cnlyfyl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高60～120厘米。根圆柱形，长5～12厘米，直径1.5～3厘米，下部常分叉，外皮灰黄褐色。茎直立，四枝形，光滑或有腺状柔毛。叶对生；叶柄长0.5～2厘米；叶片卵形或卵状椭圆形，长7～20厘米，宽3.5～12厘米，先端渐尖，基部圆形或近截形，边缘具钝锯齿，下面有稀疏散生的细毛。聚伞花序疏散开展，呈圆锥状；花梗氏1～3匣米，花序和花梗都有明显的腺毛；萼片5裂，卵圆形，先端钝，外面有腺状细毛；花冠暗紫色，管部斜壶状，长约8毫米，有5裂片，上面2裂较长而大，侧面2裂片次之，下面裂片最小；雄蕊4，2强，另有1枚退化的雄蕊，呈鳞片状，贴生在花冠管上；花盘明显；子房上位，2室，花柱细长。蒴果卵圆形，先端短尖，深绿或暗绿色，长约8毫米，萼宿存。花期7～8月。果期8～9月。"}]},{"ID":"20240611142619-nhvehui","Type":"NodeParagraph","Properties":{"id":"20240611142619-nhvehui","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611142619-yyfbl3z","Type":"NodeParagraph","Properties":{"id":"20240611142619-yyfbl3z","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 干燥根圆柱形，有的弯曲似羊角。中部肥满，两头略细。长约10～20厘米，中部直径约1.5～3厘米。表面灰黄色或棕褐色，有顺纹及抽沟，间有横向裂隙（皮孔）及须根痕。顶端有芦头均已修齐，下部钝尖。质坚实，不易折断。断面乌黑色，微有光泽，无裂隙。无臭或微有焦糊气，味甘，微苦咸，嚼之柔润。以支条肥大、皮细、质坚、芦头修净、肉色乌黑者为佳。支条小、皮粗糙、带芦头者质次。"}]},{"ID":"20240611142619-6ai34pk","Type":"NodeParagraph","Properties":{"id":"20240611142619-6ai34pk","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611142619-3f0i5u5","Type":"NodeParagraph","Properties":{"id":"20240611142619-3f0i5u5","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 含生物碱、糖类、甾醇、氨基酸、脂肪酸、微量挥发油、胡萝卜素等。"}]},{"ID":"20240611142619-8xlfgn0","Type":"NodeParagraph","Properties":{"id":"20240611142619-8xlfgn0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611142619-wng6a12","Type":"NodeParagraph","Properties":{"id":"20240611142619-wng6a12","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 北玄参的药理作用："}]},{"ID":"20240611142619-tmln12w","Type":"NodeParagraph","Properties":{"id":"20240611142619-tmln12w","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"①降压作用"}]},{"ID":"20240611142619-louygtb","Type":"NodeParagraph","Properties":{"id":"20240611142619-louygtb","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"流浸膏对麻醉兔静脉注射，小量能使血压先略有上升，继则下降；大量则仅使血压下降。水浸剂、乙醇水浸液及煎剂，对麻醉犬、猫、兔有显着的降压作用；健康犬及\"肾型高血比\"犬，口服煎剂2克／公斤，每日二次，均表现降压作用，对后者的效力较前者更显着，减少剂量时，作用出现刚延缓。在蟾蜍心脏灌流时，流浸膏小量可呈现强心作用，剂量加大则呈中毒现象，对蟾蜍下肢血管有扩张作用。"}]},{"ID":"20240611142619-wkjty6t","Type":"NodeParagraph","Properties":{"id":"20240611142619-wkjty6t","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240611142619-k5hmco4","Type":"NodeParagraph","Properties":{"id":"20240611142619-k5hmco4","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"流浸膏对正常家兔皮下注射（5克／公斤），可使血糖略有降低。从其根中提出的p-Mcthoxycinnamic_acid对伤寒疫苗发热的家兔，有解热作用。浸剂在体外，有抗真菌作用。因含皂甙，故有显著的溶血作用，并能引起局部刺激。"}]},{"ID":"20240611142619-lxtx9p2","Type":"NodeParagraph","Properties":{"id":"20240611142619-lxtx9p2","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"此外，同属植物S.grosslwimi中所含的总黄酮甙元有降低动物血压、减少毛细血管通透性、利胆等作用。S.nodosa有镇静、降压、强心、扩张血管，并有某些抗惊厥的作用。"}]},{"ID":"20240611142619-w1c3lgs","Type":"NodeParagraph","Properties":{"id":"20240611142619-w1c3lgs","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611142619-pwgn3li","Type":"NodeParagraph","Properties":{"id":"20240611142619-pwgn3li","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去芦头，洗净润透，切片，晾干。或洗净略泡，置笼屉内蒸透，取出晾6～7成干。焖润至内外均呈黑色，切片，再晾干。"}]},{"ID":"20240611142619-smuyyub","Type":"NodeParagraph","Properties":{"id":"20240611142619-smuyyub","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡采得玄参后，须用蒲草重重相隔，入甑蒸两伏时后出，晒干，拣去蒲草用之。\""}]},{"ID":"20240611142619-dmflx1f","Type":"NodeParagraph","Properties":{"id":"20240611142619-dmflx1f","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611142619-4ro3dxs","Type":"NodeParagraph","Properties":{"id":"20240611142619-4ro3dxs","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 入肺、肾经。"}]},{"ID":"20240611142619-9hpzqft","Type":"NodeParagraph","Properties":{"id":"20240611142619-9hpzqft","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"①《药类法象》：\"足少阴肾经。\""}]},{"ID":"20240611142619-yir2y8b","Type":"NodeParagraph","Properties":{"id":"20240611142619-yir2y8b","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、肺、肾三经。\""}]},{"ID":"20240611142619-2dqfry7","Type":"NodeParagraph","Properties":{"id":"20240611142619-2dqfry7","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入脾、肾、胃三经。\""}]},{"ID":"20240611142619-i4osqih","Type":"NodeParagraph","Properties":{"id":"20240611142619-i4osqih","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611142619-hjj3yul","Type":"NodeParagraph","Properties":{"id":"20240611142619-hjj3yul","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 苦咸，凉。"}]},{"ID":"20240611142619-7d56qu0","Type":"NodeParagraph","Properties":{"id":"20240611142619-7d56qu0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，微寒。\""}]},{"ID":"20240611142619-rnjhr47","Type":"NodeParagraph","Properties":{"id":"20240611142619-rnjhr47","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、桐君、雷公、扁鹊：苦，无毒。岐伯：咸。李氏：寒。\""}]},{"ID":"20240611142619-512mlh2","Type":"NodeParagraph","Properties":{"id":"20240611142619-512mlh2","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"味微苦微咸略甘，性凉。\""}]},{"ID":"20240611142619-djsbr9p","Type":"NodeParagraph","Properties":{"id":"20240611142619-djsbr9p","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611142619-7619gj0","Type":"NodeParagraph","Properties":{"id":"20240611142619-7619gj0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 脾胃有湿及脾虚便溏者忌服。"}]},{"ID":"20240611142619-nfq4il4","Type":"NodeParagraph","Properties":{"id":"20240611142619-nfq4il4","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"使用时勿令犯铜，饵之噎人喉，丧人目。\""}]},{"ID":"20240611142619-mal2l2z","Type":"NodeParagraph","Properties":{"id":"20240611142619-mal2l2z","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"恶黄耆、干姜、火枣、山茱萸。反黎芦。\""}]},{"ID":"20240611142619-onarhdz","Type":"NodeParagraph","Properties":{"id":"20240611142619-onarhdz","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"血少目昏，停饮寒热，支满，血虚腹痛，髀虚泄泻，并不宜服。\""}]},{"ID":"20240611142619-zflzx1v","Type":"NodeParagraph","Properties":{"id":"20240611142619-zflzx1v","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"虚寒则忌。\""}]},{"ID":"20240611142619-v2ye23w","Type":"NodeParagraph","Properties":{"id":"20240611142619-v2ye23w","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611142619-58lhxxc","Type":"NodeParagraph","Properties":{"id":"20240611142619-58lhxxc","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 滋阴，降火，除烦，解毒。治热病伤阴，舌绎烦渴，发斑，骨蒸劳热，夜寐不宁，自汗盗汗，津伤便秘，吐血衄血，咽喉肿痛，痈肿，瘰疬，温毒发斑、目赤、白喉、疮毒。"}]},{"ID":"20240611142619-jmemnfh","Type":"NodeParagraph","Properties":{"id":"20240611142619-jmemnfh","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主腹中寒热积聚，女子产乳余疾，补肾气，令人明目。\""}]},{"ID":"20240611142619-cx1rc7l","Type":"NodeParagraph","Properties":{"id":"20240611142619-cx1rc7l","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主暴中风，伤寒身热，支满狂邪，忽忽不知人，温疟洒洒，血瘕下寒血，除胸中气，下水，止烦渴，散颈下核、痈肿、心腹痛、坚症，定五藏。\""}]},{"ID":"20240611142619-xit84xj","Type":"NodeParagraph","Properties":{"id":"20240611142619-xit84xj","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能治暴结热，主热风头痛，伤寒劳复，散瘤瘿瘰疬。\""}]},{"ID":"20240611142619-48c7vak","Type":"NodeParagraph","Properties":{"id":"20240611142619-48c7vak","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治头风热毒游风，补虚劳损，心惊烦躁，劣乏骨蒸，传尸邪气，止健忘，消肿毒。\""}]},{"ID":"20240611142619-aztzkpr","Type":"NodeParagraph","Properties":{"id":"20240611142619-aztzkpr","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑤《医学启源》：\"治心懊憹烦而不得眠，心神颠倒欲绝，血滞小便不利。\""}]},{"ID":"20240611142619-g9tzjor","Type":"NodeParagraph","Properties":{"id":"20240611142619-g9tzjor","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑥《品汇精要》：\"消咽喉之肿，泻无根之火。\""}]},{"ID":"20240611142619-bry3c17","Type":"NodeParagraph","Properties":{"id":"20240611142619-bry3c17","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"滋阴降火，解斑毒，利咽喉，通小便血滞。\""}]},{"ID":"20240611142619-57z1wqe","Type":"NodeParagraph","Properties":{"id":"20240611142619-57z1wqe","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑧《本草正义》：\"疗胸膈心肺热邪，清膀胱肝肾热结。疗风热之咽痛，泄肝阳之目赤，止自汗盗汗，治吐血衄血。\""}]},{"ID":"20240611142619-o4vbs7s","Type":"NodeParagraph","Properties":{"id":"20240611142619-o4vbs7s","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611142619-hmqveej","Type":"NodeParagraph","Properties":{"id":"20240611142619-hmqveej","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；或入丸，散。外用：捣敷或研末调敷。"}]},{"ID":"20240611142619-wpglre1","Type":"NodeParagraph","Properties":{"id":"20240611142619-wpglre1","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611142619-5izv8mj","Type":"NodeParagraph","Properties":{"id":"20240611142619-5izv8mj","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" ①治伤寒发汗吐下后，毒气不散，表虚里实，热发于外，故身斑如锦文，甚则烦躁谵语，兼治喉闭肿痛：玄参、升麻、甘草（炙）各半两。上锉如麻豆大，每服抄五钱匕，以水一盏半，煎至七分，去滓服。（《类证活人书》玄参升麻汤）"}]},{"ID":"20240611142619-zfp93gw","Type":"NodeParagraph","Properties":{"id":"20240611142619-zfp93gw","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"②治三焦积热：玄参、黄连、大黄各一两。为末，炼蜜丸梧子大。每服三、四十丸，白汤下。小儿丸粟米大。（《丹溪心法》）"}]},{"ID":"20240611142619-626hz4j","Type":"NodeParagraph","Properties":{"id":"20240611142619-626hz4j","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"③治阳明温病，无上焦证，数日不大便，当下之，若其人阴素虚，不可行承气者：玄参一两，麦冬（连心）八钱。水八杯，煮取三杯，口干则与饮令尽。不便，再作服。（《温病条辨》增液汤）"}]},{"ID":"20240611142619-pg8ixv4","Type":"NodeParagraph","Properties":{"id":"20240611142619-pg8ixv4","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"④治伤寒上焦虚，毒气热壅塞，咽喉连舌肿痛：玄参、射干、黄药各一两。上药捣筛为末，每服五钱，以水一大盏，煎至五分，去滓，不拘时温服。（《圣惠方》玄参散）"}]},{"ID":"20240611142619-0l5eplk","Type":"NodeParagraph","Properties":{"id":"20240611142619-0l5eplk","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑤治急喉痹风，不拘大人小儿：玄参、鼠粘子（半生半炒）各一两。为末，新汲水服一盏。（《圣惠方》）"}]},{"ID":"20240611142619-gges3lv","Type":"NodeParagraph","Properties":{"id":"20240611142619-gges3lv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑥治瘰疬初起：元参（蒸）、牡蛎（醋煅，研）、贝母（去心，蒸）各四两。共为末，炼蜜为丸。每服三钱，开水下，日二服。（《医学心悟》消瘰丸）"}]},{"ID":"20240611142619-8i1l3y0","Type":"NodeParagraph","Properties":{"id":"20240611142619-8i1l3y0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑦解诸热，消疮毒：玄参、生地黄各一两，大黄五钱（煨）。上为末，炼蜜丸，灯心、淡竹叶汤下，或入砂糖少许亦可。（《补要袖珍小儿方论》）"}]},{"ID":"20240611142619-zrzz9x0","Type":"NodeParagraph","Properties":{"id":"20240611142619-zrzz9x0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"⑧治赤脉贯瞳：玄参为末，以米泔煮猪肝，日日蘸食之。（《济急仙方》）"}]},{"ID":"20240611142619-ic1texn","Type":"NodeParagraph","Properties":{"id":"20240611142619-ic1texn","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611142619-8qt44hx","Type":"NodeParagraph","Properties":{"id":"20240611142619-8qt44hx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 此外，在我国北方地区尚有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"北玄参"},{"Type":"NodeText","Data":"的根也常作玄参应用。其区别特征在花序紧缩成穗状；花冠黄绿色；叶较窄。喜生于湿润土壤中。分布东北、华北、西北等地。"}]},{"ID":"20240611142619-puczkrx","Type":"NodeParagraph","Properties":{"id":"20240611142619-puczkrx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611142619-m226gry","Type":"NodeParagraph","Properties":{"id":"20240611142619-m226gry","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611142619-b3mjzla","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611142619-b3mjzla","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"《中华本草》：玄参"}]},{"ID":"20240611142619-rdnj9q2","Type":"NodeParagraph","Properties":{"id":"20240611142619-rdnj9q2","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611142619-pal2tlx","Type":"NodeParagraph","Properties":{"id":"20240611142619-pal2tlx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" Xuán Shēn"}]},{"ID":"20240611142619-tvinaw8","Type":"NodeParagraph","Properties":{"id":"20240611142619-tvinaw8","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611142619-tfs3vbg","Type":"NodeParagraph","Properties":{"id":"20240611142619-tfs3vbg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 重台、正马、玄台、鹿肠、鬼藏、端、咸、逐马、馥草、黑参、野脂麻、元参、山当归、水萝卜"}]},{"ID":"20240611142619-5vs3fx9","Type":"NodeParagraph","Properties":{"id":"20240611142619-5vs3fx9","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611142619-h9frqkv","Type":"NodeParagraph","Properties":{"id":"20240611142619-h9frqkv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" Figwort Root"}]},{"ID":"20240611142619-9j6y85p","Type":"NodeParagraph","Properties":{"id":"20240611142619-9j6y85p","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611142619-divja0f","Type":"NodeParagraph","Properties":{"id":"20240611142619-divja0f","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240611142619-yk30r37","Type":"NodeParagraph","Properties":{"id":"20240611142619-yk30r37","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611142619-8bb7lbs","Type":"NodeParagraph","Properties":{"id":"20240611142619-8bb7lbs","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 药材基源：为玄参科植物玄参及北玄参的根。"}]},{"ID":"20240611142619-g4dmoa1","Type":"NodeParagraph","Properties":{"id":"20240611142619-g4dmoa1","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Scrophularia ningpoensis Hemsl.2.Scrophularia buergeriana Miq. [S. oldhami Oliv.]"}]},{"ID":"20240611142619-fsumpzw","Type":"NodeParagraph","Properties":{"id":"20240611142619-fsumpzw","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种1年，在10-11月当茎叶枯萎时收获。挖起全株，摘下块根晒或炕到半干时，堆积盖草压实，经反复堆晒待块根内部变黑，再晒（炕）至全干。"}]},{"ID":"20240611142619-fjcypa0","Type":"NodeParagraph","Properties":{"id":"20240611142619-fjcypa0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611142619-j6sxs1g","Type":"NodeParagraph","Properties":{"id":"20240611142619-j6sxs1g","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于坡林下。"}]},{"ID":"20240611142619-fec7jpl","Type":"NodeParagraph","Properties":{"id":"20240611142619-fec7jpl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.喜生于湿润土壤中。"}]},{"ID":"20240611142619-g6z976z","Type":"NodeParagraph","Properties":{"id":"20240611142619-g6z976z","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于河北、山西、陕西、江苏、安徽、浙江、江西、福建、河南、湖北、湖南、广东、四川、贵州。南方各地均有栽培。"}]},{"ID":"20240611142619-r96j96w","Type":"NodeParagraph","Properties":{"id":"20240611142619-r96j96w","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.分布于东北、华北及山东、江苏、河南。"}]},{"ID":"20240611142619-mbzosc1","Type":"NodeParagraph","Properties":{"id":"20240611142619-mbzosc1","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611142619-1ruealg","Type":"NodeParagraph","Properties":{"id":"20240611142619-1ruealg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 1.玄参 多年生草本，高60-120cm。根肥大，近圆柱形，下部常分枝，皮灰黄或灰褐色。茎直立，四棱形，有沟纹，光滑或有腺状柔毛。下部叶对生，上部叶有时互生，均具柄；叶片卵形或卵状椭圆形，长7-20cm，宽3.5-12cm，先端渐尖，基部圆形成近截形，边缘具细锯齿，无毛背面脉上有毛。聚伞花序疏散形展，呈圆锥形；花梗长1-3cm，花序轴和花梗均被腺毛；萼5裂，裂片卵圆形，先端钝，边缘膜质；花冠暗紫色，管部斜壶状，长约8mm，先端5裂，不等大；雄蕊4，二强，另有一退化雄蕊，呈鳞片状，贴生于花冠管上；子房约8mm，深绿色或暗绿色，萼宿存。花期7-8月，果期8-9月。"}]},{"ID":"20240611142619-exf9ch6","Type":"NodeParagraph","Properties":{"id":"20240611142619-exf9ch6","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.北玄参 本种与上种极相似，其主要区别：根呈圆柱形，有纵皱纹，表面灰褐色，有细根及细根痕。叶较小，叶片卵形至长卵形，长5-12cm，宽2-5cm。聚伞花序紧缩成穗状，小聚伞花天酒地序无总花梗，或有长达5mm。聚伞花序紧缩成穗状，小聚伞花序无总花裂片卵形，花冠黄绿色。蒴果卵形，长约6mm。"}]},{"ID":"20240611142619-a13dgj7","Type":"NodeParagraph","Properties":{"id":"20240611142619-a13dgj7","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611142619-oiry635","Type":"NodeParagraph","Properties":{"id":"20240611142619-oiry635","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温和湿润气候，耐寒、耐旱、怕涝。茎叶能经受轻霜。适应性较强，在平原、丘陵及低山坡均可栽培，对土壤要求不严，但以土层深厚、疏松、肥沃、排水良好的砂质壤土栽培为宜。忌连作。可与禾本科植物轮作。"}]},{"ID":"20240611142619-u1ro3gx","Type":"NodeParagraph","Properties":{"id":"20240611142619-u1ro3gx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"栽培技术 用子芽、种子、分株、扦插等繁殖。生产上一般采用子芽繁殖。在玄参收获时，选择无病、健壮、白色、长3-4cm的子芽，从芦头上下留作繁殖材料。南方采用冬种，于12月中、下旬至翌年1月上、中旬栽种。按行距40-50cm，株距34-40cm开穴，穴深8-10cm，每穴放子芽1个，芽向上。北方以春种为主，于2月下旬至4月上旬栽种，方法与冬种相同。"}]},{"ID":"20240611142619-xmvghuy","Type":"NodeParagraph","Properties":{"id":"20240611142619-xmvghuy","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期中，从4-6月时行中耕除草3-4次。除施足基肥外，在6月中旬再追肥、培土，防止倒伏。干旱时须灌溉，使土壤湿润；多雨积水应及时排水。南方在开花期要将顶部花序摘除，促进根产膨大。病虫害防治 病害有斑枯病，可清洁田地，实行轮作，增施磷钾肥。发病初期用1：1：100波尔多液喷洒3-4次，进行防治。白绢病，可实行轮作，拔除病株、病空用石灰水消毒，选用抗病和无病子芽，用哈茨木霜进生物防治。虫害有棉红蜘蛛，在发病初期喷波美0.2-0.3度石硫合剂防治。蜗牛可人工捕杀，或喷洒1%石灰水。"}]},{"ID":"20240611142619-4j5moeb","Type":"NodeParagraph","Properties":{"id":"20240611142619-4j5moeb","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611142619-8iz81zv","Type":"NodeParagraph","Properties":{"id":"20240611142619-8iz81zv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）玄参 根类圆柱形，中部略粗，或上粗下细，有的微弯似羊角状，长6-20cm，直径1-3cm。表面灰黄色或棕褐色，有明显纵沟或横向皮孔，偶有短的细根或细根痕。质坚实，难折断，断面略平坦，乌黑色，微有光泽。有焦糖气，味甘微苦。以水浸泡，水呈墨黑色。"}]},{"ID":"20240611142619-fr4acsg","Type":"NodeParagraph","Properties":{"id":"20240611142619-fr4acsg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"（2）北玄参 根圆柱形，有纵皱纹，表面灰褐色，有细根及细根痕。"}]},{"ID":"20240611142619-539jhhl","Type":"NodeParagraph","Properties":{"id":"20240611142619-539jhhl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"以条粗壮、质坚实、断面色黑者为佳。"}]},{"ID":"20240611142619-m6qgfae","Type":"NodeParagraph","Properties":{"id":"20240611142619-m6qgfae","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：（1）玄参 后生皮层微微栓化，皮层细胞切向延长，长方形或类圆形，石细胞单个散在，或3-5个成群。韧皮射线多裂隙。导管呈断续放射状排列，中央有少数导管，并有薄壁细胞。"}]},{"ID":"20240611142619-9zx87ey","Type":"NodeParagraph","Properties":{"id":"20240611142619-9zx87ey","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"（2）北玄参 皮层无石细胞。"}]},{"ID":"20240611142619-rqb31ys","Type":"NodeParagraph","Properties":{"id":"20240611142619-rqb31ys","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"粉末特征：玄参灰棕色。①石细胞大多散在或2-5成群，长方形，类方形，类圆形，三角形梭形或不规则形，直径22-94μm（-128），壁厚5-26μm，有的孔沟分叉，胞腔较大。②薄壁组织碎片甚多，细胞内含核状物。③木纤维细长，壁微木化。④可见网纹与孔纹导管。"}]},{"ID":"20240611142619-2lmdr90","Type":"NodeParagraph","Properties":{"id":"20240611142619-2lmdr90","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611142619-tztftv0","Type":"NodeParagraph","Properties":{"id":"20240611142619-tztftv0","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 5grossheimi中分离的总黄酮甙元，毒性低，小鼠急性LD50po为555mg/kg，ip为323mg/kg。"}]},{"ID":"20240611142619-80uejrm","Type":"NodeParagraph","Properties":{"id":"20240611142619-80uejrm","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611142619-8lcdqbr","Type":"NodeParagraph","Properties":{"id":"20240611142619-8lcdqbr","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 1.玄参 根含环烯醚萜类化合物：哈帕甙（harpahide)，玄参甙（harpagoside)[1]，桃叶珊瑚甙（aucubin)，6-O-甲基梓醇（6-O-methylcatalpol）[2]，2-（3-羟基-4-甲氧基苯基）乙基1-O-[α-L-阿拉伯糖基（1→6）]-[阿魏酰基（1→4）]-α-L-鼠李糖基（1→3）-β-D-葡萄糖甙（1→6）]-[阿魏酰基（1→4）]-α-L-鼠李糖基（1→3）-β-D-葡萄糖甙"}]},{"ID":"20240611142619-kbgia4b","Type":"NodeParagraph","Properties":{"id":"20240611142619-kbgia4b","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611142619-b6sqtap","Type":"NodeParagraph","Properties":{"id":"20240611142619-b6sqtap","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 1.对心血管系统的作用本品水浸液、醇浸液和煎剂对麻醉犬、猫、兔等多种动物可引起血压下降。Po玄参煎剂2g/kg，每日2次，对肾性高血压犬的降压作用较健康犬更为明显。本品所含的天门冬酰胺iv可引起动物血压下降，外周血管扩张，心收缩力增强，心率变慢和尿量增加。玄参乙醇提取物能明显增加离体兔心冠脉流量，增加小鼠心肌86铷摄取量，对垂体后叶素所致家兔实验性心肌缺血有保护作用、还能增强小鼠耐缺氧能力，对麻醉猫有一定降压作用。此外，玄参还能增加离体兔耳灌流量，对氯化钾和肾上腺素所致兔主动脉血管痉挛有一定的缓解作用。"}]},{"ID":"20240611142619-ywuzi3c","Type":"NodeParagraph","Properties":{"id":"20240611142619-ywuzi3c","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.中枢抑制作用本品浸剂对小鼠有镇静、抗惊作用。"}]},{"ID":"20240611142619-c8ti180","Type":"NodeParagraph","Properties":{"id":"20240611142619-c8ti180","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"3.抗菌作用50%煎剂用平板稀释法，对金黄色葡萄球菌有抑制作用。玄参叶鲜法用平板打洞法，对绿脓杆菌有抑制作用。浸剂用试管稀释法，1：160对须癣毛菌、羊毛状小孢子菌有抑制作用。"}]},{"ID":"20240611142619-0csg9gx","Type":"NodeParagraph","Properties":{"id":"20240611142619-0csg9gx","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"4.其他作用本品对多种致病性及非致病性真菌具有抑制作用。浸膏对家兔有轻微的降血糖作用。"}]},{"ID":"20240611142619-x3nxndl","Type":"NodeParagraph","Properties":{"id":"20240611142619-x3nxndl","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611142619-syi33zg","Type":"NodeParagraph","Properties":{"id":"20240611142619-syi33zg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 1.拣净杂质，除去芦头，洗净润透，切片，晾干。或洗净略泡，置笼屉内蒸透，取出晾6-7成干，焖润至内外均呈黑色，切片，再晾干。"}]},{"ID":"20240611142619-vok9u63","Type":"NodeParagraph","Properties":{"id":"20240611142619-vok9u63","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮炙论》:凡采得玄参后，须用蒲草重重相隔，入甑蒸两伏时后出，晒干，拣去蒲草用之。"}]},{"ID":"20240611142619-r9luov1","Type":"NodeParagraph","Properties":{"id":"20240611142619-r9luov1","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611142619-1y4srno","Type":"NodeParagraph","Properties":{"id":"20240611142619-1y4srno","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末50g（40目），用甲醇在沙氏提取器中回流3b，回收甲醇，残留提取物回蒸馏水100ml溶解，用正丁醇提取3次，每次50ml，减压回收正丁醇，提取物用乙醚洗涤3次，每次5ml，残留物用因酮容解，通过活性炭柱层析，用丙酮洗脱，洗脱液加Godin试剂（1%香草醛的乙醇溶液和3%高氯酸水溶液，临用时等量混合）呈红紫色。或取间苯三酚试剂和盐酸各1滴，置发皿中，加上述丙酮溶液1滴；呈蓝绿色。（检查五烯醚萜甙）商品规格 以浙江产者为优，有细皮玄参和粗皮玄参两种，各分为三等。一等：每千克36支以内，支头均匀，无芦头、空泡。二等；每千克72支以内，余同一等。三等；每千克72支以外，个头最小在5g以上，间有破块。"}]},{"ID":"20240611142619-euu5dz6","Type":"NodeParagraph","Properties":{"id":"20240611142619-euu5dz6","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611142619-7sen8g2","Type":"NodeParagraph","Properties":{"id":"20240611142619-7sen8g2","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 归肺；胃；肾经"}]},{"ID":"20240611142619-uqk5asv","Type":"NodeParagraph","Properties":{"id":"20240611142619-uqk5asv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611142619-6kz5m3c","Type":"NodeParagraph","Properties":{"id":"20240611142619-6kz5m3c","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 味甘；苦；咸；性微寒"}]},{"ID":"20240611142619-xavr2jv","Type":"NodeParagraph","Properties":{"id":"20240611142619-xavr2jv","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611142619-tqrucm5","Type":"NodeParagraph","Properties":{"id":"20240611142619-tqrucm5","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 脾胃有湿及脾虚便溏者忌服。"}]},{"ID":"20240611142619-os1ygn4","Type":"NodeParagraph","Properties":{"id":"20240611142619-os1ygn4","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：使用时勿令犯铜，饵之噎人喉，丧人目。"}]},{"ID":"20240611142619-v3ohyjt","Type":"NodeParagraph","Properties":{"id":"20240611142619-v3ohyjt","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：恶黄耆、干姜、大枣、山茱萸。反黎芦。"}]},{"ID":"20240611142619-o2ahxls","Type":"NodeParagraph","Properties":{"id":"20240611142619-o2ahxls","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：血少目昏，停饮寒热，支满，血虚腹痛，脾虚泄泻，并不宜服。"}]},{"ID":"20240611142619-oiqxzqp","Type":"NodeParagraph","Properties":{"id":"20240611142619-oiqxzqp","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"4.《医林纂要》：虚寒则忌。"}]},{"ID":"20240611142619-qr4ioks","Type":"NodeParagraph","Properties":{"id":"20240611142619-qr4ioks","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611142619-dq5yi6n","Type":"NodeParagraph","Properties":{"id":"20240611142619-dq5yi6n","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 清热凉血；滋阴降火；解毒散结。主温热病热和营血；身热；烦渴；舌绛；发斑；骨蒸劳嗽；虚烦不寤；津伤便秘；目涩昏花；咽喉喉肿痛；瘰疬痰核；痈疽疮毒"}]},{"ID":"20240611142619-x2jq4yg","Type":"NodeParagraph","Properties":{"id":"20240611142619-x2jq4yg","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611142619-p6q22bj","Type":"NodeParagraph","Properties":{"id":"20240611142619-p6q22bj","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g；或入丸、散。外用：适量，捣敷或研末调敷。"}]},{"ID":"20240611142619-ayqh6os","Type":"NodeParagraph","Properties":{"id":"20240611142619-ayqh6os","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611142619-zne5s5e","Type":"NodeParagraph","Properties":{"id":"20240611142619-zne5s5e","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 1.张元素：玄参，乃枢机之剂，管领诸气上下，肃清而不浊，风药中多用之。故《活人书》玄参升麻汤，治汗下吐后毒不散，则知为肃清枢机之剂。以此论之，治空中氤氲之气，无根之火，以玄参为圣药。"}]},{"ID":"20240611142619-ylkhprc","Type":"NodeParagraph","Properties":{"id":"20240611142619-ylkhprc","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：肾水受伤，真阴失守，孤阳无根，发为火病，法宜壮水以制火，故玄参与地黄同功。其消瘰疬亦是散火，刘守真言结核是火病。"}]},{"ID":"20240611142619-ptjj0ka","Type":"NodeParagraph","Properties":{"id":"20240611142619-ptjj0ka","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：玄参，此物味苦而甘，苦能清火，甘能滋阴，以其味甘，故降性亦缓。《本草》言其惟入肾经，而不知其尤走肺脏，故能退无根浮游之火，散周身痰结热痈。"}]},{"ID":"20240611142619-pcyrbgy","Type":"NodeParagraph","Properties":{"id":"20240611142619-pcyrbgy","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：戴人谓肾本寒，虚则热。如纵欲耗精，真阴亏损，致虚火上炎，以玄参滋阴抑火。凡头疼、热毒、耳鸣、咽痛、喉风、瘰疬、伤寒阳毒、心下懊憹，皆无根浮游之火为患，此有清上澈下之功。凡治肾虚，大有分别，肾之经虚则寒而湿，宜温补之；肾之脏虚则热而燥，宜凉补之；独此凉润滋肾，功胜知、柏，特为肾脏君药。"}]},{"ID":"20240611142619-gz1mc3k","Type":"NodeParagraph","Properties":{"id":"20240611142619-gz1mc3k","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"5.《玉楸药解》：玄参，清金补水，凡疮疡热痛，胸膈燥渴，溲便红涩，膀胱癃闭之证俱善。清肺与陈皮、杏仁同服，利水合茯苓、泽泻同服。"}]},{"ID":"20240611142619-yqyelmf","Type":"NodeParagraph","Properties":{"id":"20240611142619-yqyelmf","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"6.《本草正义》：玄参，禀至阴之性，专主热病，味苦则泄降下行，故能治脏腑热结等证。味又辛而微咸，故直走血分而通血瘀。亦能外行于经隧，而消散热结之痈肿。寒而不峻，润而不腻，性情与知、柏、生地近似，而较为和缓，流弊差轻。玄参赋禀阴寒，能退邪热，而究非滋益之品。《别录》所称补虚益精等辞，已觉言之过甚，乃《日华》竟称其补劳损，而景岳直谓其甘能滋阴，濒湖且谓与地黄同功，俗医遂用之于阴虚劳怯，则无根之火岂宜迎头直折，速其熄灭？且当时并不显见其害，甚且浮游之火受其遏抑，而咳呛等证，亦或少少见瘥，昧者方且归功于滋阴降火，而不知一线生阳，已渐消灭，从此不可救疗矣。此阴柔之害，与肆用知、柏者相等，则滋阴二字误之也。疗胸膈心肺热邪，清膀胱肝肾热结。疗风热之咽痛，泄肝阳之目赤，止自汗盗汗，治吐血衄血。"}]},{"ID":"20240611142619-n0uz8hr","Type":"NodeParagraph","Properties":{"id":"20240611142619-n0uz8hr","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"7.《医学衷中参西录》：玄参，味甘微苦，性凉多液，原为清补肾经之药。又能入肺以清肺家烁热，解毒消火，最宜于肺病结核，肺热咳嗽。《本经》谓其治产乳余疾，因其性凉而不寒，又善滋阴，且兼有补性，故产后血虚生热及产后寒温诸症，热入阳明者，用之最宜。愚生平治产后外感实热，其重者用白虎加人参汤，以玄参代方中知母，其轻者用拙拟滋阴清胃汤（玄参两半，当归三钱，生杭芍四钱，茅根三钱，甘草钱半）亦可治愈。诚以产后忌用凉药，而既有外感实热，又不得不以凉药清之，惟石膏与玄参，《本经》皆明载治产乳，故敢放胆用之。然石膏又必加人参以铺之，又不敢与知母并用。至滋阴清胃汤中重用玄参，亦必以四物汤中归、芍辅之，此所谓小心放胆并行不悖也。《本经》又谓玄参能明目，诚以肝窍于目，玄参能益水以滋肝木，故能明目。且目之所以能视者，在瞳子中神水充足，神水固肾之精华外现者也，以玄参与柏实、枸杞并用，以治肝肾虚而生热，视物不了了者，恒有捷效也。又外感大热已退，其人真阴亏损，舌干无津，胃液消耗，口苦懒食者，愚恒用玄参两许，加潞党参二、三钱，连服数剂自愈。《本经》：主腹中寒热积聚，女子产乳余疾，补肾气，令人明目。"}]},{"ID":"20240611142619-6c0cxgu","Type":"NodeParagraph","Properties":{"id":"20240611142619-6c0cxgu","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"8.《别录》：生暴中风，伤寒身热，支满狂邪，忽忽不知人，温疟洒洒，血瘕下寒血，除胸中气，下水，止烦渴，散颈下核、痈肿、心腹痛、坚症，定五藏。"}]},{"ID":"20240611142619-t5635ff","Type":"NodeParagraph","Properties":{"id":"20240611142619-t5635ff","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：能治暴结热，主热风头痛，伤寒劳复，散瘤瘿瘰疬。"}]},{"ID":"20240611142619-gjubeup","Type":"NodeParagraph","Properties":{"id":"20240611142619-gjubeup","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"10.《日华子本草》：治头风热毒游风，补虚劳损，心惊烦躁，劣乏骨蒸，传尸邪气，止健忘，消肿毒。"}]},{"ID":"20240611142619-7t9uwou","Type":"NodeParagraph","Properties":{"id":"20240611142619-7t9uwou","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"11.《医学启源》：治心懊憹烦而不得眠，心神颠倒欲绝，血滞小便不利。"}]},{"ID":"20240611142619-v1rtsjs","Type":"NodeParagraph","Properties":{"id":"20240611142619-v1rtsjs","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"12.《品汇精要》：消咽喉之肿，泻无根之火。"}]},{"ID":"20240611142619-olfz9th","Type":"NodeParagraph","Properties":{"id":"20240611142619-olfz9th","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"13.《纲目》：滋阴降火，解斑毒，利咽喉，通小便血滞。"}]},{"ID":"20240611142619-ucuii60","Type":"NodeParagraph","Properties":{"id":"20240611142619-ucuii60","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611142619-qxvbk9w","Type":"NodeParagraph","Properties":{"id":"20240611142619-qxvbk9w","updated":"20240611142619"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611142621-cnmeibr","Type":"NodeThematicBreak","Properties":{"id":"20240611142621-cnmeibr"}},{"ID":"20240611142622-8902fwl","Type":"NodeParagraph","Properties":{"id":"20240611142622-8902fwl"}}]}