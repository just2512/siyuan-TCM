ssets/夏枯草9-20240702102917-adjpyr2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 773px;\" parent-style=\"width: 783px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 336px;","style":"width: 326px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草 5-20240826125338-gftude4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 326px;\" parent-style=\"width: 336px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826125907-7wxrlss","Type":"NodeParagraph","Properties":{"id":"20240826125907-7wxrlss","updated":"20240826125907"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 503px;","style":"width: 493px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草 3-20240826125133-h0ct8s2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 493px;\" parent-style=\"width: 503px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 358px;","style":"width: 348px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草 4-20240826125252-ny2srf1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 348px;\" parent-style=\"width: 358px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 399px;","style":"width: 389px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草2-20240619172618-lykpg2j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 389px;\" parent-style=\"width: 399px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613120000-8e31roj","Type":"NodeThematicBreak","Properties":{"id":"20240613120000-8e31roj"}},{"ID":"20240613123532-lbfruyr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123532-lbfruyr","updated":"20240613123536"},"Children":[{"Type":"NodeText","Data":"夏枯草《神农本草经》"}]},{"ID":"20240613123532-x2foi2o","Type":"NodeParagraph","Properties":{"id":"20240613123532-x2foi2o","updated":"20240613123532"},"Children":[{"Type":"NodeText","Data":"味苦辛、寒。"}]},{"ID":"20240613123532-91vqa9j","Type":"NodeParagraph","Properties":{"id":"20240613123532-91vqa9j","updated":"20240613123532"},"Children":[{"Type":"NodeText","Data":"热瘰疬，鼠瘘，头创，破症，散瘿，结气，脚肿，湿痹，轻身。一名夕句，一名乃东。生川谷。"}]},{"ID":"20240613123532-sr6ehiq","Type":"NodeParagraph","Properties":{"id":"20240613123532-sr6ehiq","updated":"20240613123532"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名燕面，生蜀郡，四月采。"}]},{"ID":"20240613120000-ye8j65k","Type":"NodeThematicBreak","Properties":{"id":"20240613120000-ye8j65k"}},{"ID":"20240613123521-hzzc69n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123521-hzzc69n","updated":"20240613123526"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草经解》"}]},{"ID":"20240613123521-rbknj8u","Type":"NodeParagraph","Properties":{"id":"20240613123521-rbknj8u","updated":"20240613123521"},"Children":[{"Type":"NodeText","Data":"气寒．味苦辛．无毒．主寒热．瘰 鼠 ．头疮破症．散瘿结气．脚肿湿痹．轻身．夏枯草气寒．禀天冬寒之水气．入足太阳膀胱寒水经．味苦辛无毒．得地火金之味．入手少阴心经、手太阴肺经．遇火令而枯．禀金水之气独全．水制火．金平木．故专主少阳相火．风木胆经之症．气味轻清．少阳也．太阳主表．表邪外入．则太阳有病．而恶寒发热矣．其主之者．味辛可以散表寒．味苦可以清热也．瘰 鼠 ．皆少阳胆经风热之毒．夏枯草禀金水之气味．所以专入少阳．解风热之毒也．头乃太阳行经之地．膀胱湿热则生头疮．其主之者．气寒清热．味苦燥湿也．积聚而有形可征谓之症．乃湿热结气也．味辛可以散结．味苦可以燥湿热．所以主之也．瘿亦少阳之症．其主之者．以夏枯草专治少阳之症．而辛散之功也．湿邪伤下．脚肿湿痹．无非湿也．苦能燥湿．所以主之．且入肺与膀胱．而有祛湿之力．湿胜则身重．既有祛湿之功．所以能轻身也．"}]},{"ID":"20240613123521-5n3q6h0","Type":"NodeParagraph","Properties":{"id":"20240613123521-5n3q6h0","updated":"20240613123521"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240613123521-xhht12o","Type":"NodeParagraph","Properties":{"id":"20240613123521-xhht12o","updated":"20240613123521"},"Children":[{"Type":"NodeText","Data":"夏枯草末．治血崩不止．及赤白带下．夏枯草可代柴胡升发．可代甘菊清肝．同白茯、白术、黄柏．治湿热．同连翘、金银花、贝母、元参、薄荷、花粉、紫背天葵、甘草．治瘰 有功效．用数两煎汤．煮甘菊紫花地丁、金银花、连翘、白芨、白蔹、甘草、生地、白芷、半枝莲．消一切肿毒甚神．"}]},{"ID":"20240613120000-k5kf856","Type":"NodeThematicBreak","Properties":{"id":"20240613120000-k5kf856"}},{"ID":"20240613123509-aoay60k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123509-aoay60k","updated":"20240613123515"},"Children":[{"Type":"NodeText","Data":"夏枯草《证类本草》"}]},{"ID":"20240613123509-rmtkoe9","Type":"NodeParagraph","Properties":{"id":"20240613123509-rmtkoe9","updated":"20240613123509"},"Children":[{"Type":"NodeText","Data":"味苦、辛，寒、无毒。主寒热，瘰 ，鼠 ，头疮，破症，散瘿结气，脚肿湿痹，轻身。一名夕句，一名乃东。一名燕面。生蜀郡川谷。四月采。（土瓜为之使。）"}]},{"ID":"20240613123509-u2r2won","Type":"NodeParagraph","Properties":{"id":"20240613123509-u2r2won","updated":"20240613123509"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此草生平泽。叶似旋复，首春即生，四月穗出，其花紫白似丹参花，五月便枯。"}]},{"ID":"20240613123509-jm05ab7","Type":"NodeParagraph","Properties":{"id":"20240613123509-jm05ab7","updated":"20240613123509"},"Children":[{"Type":"NodeText","Data":"图经曰∶夏枯草，生蜀郡川谷，今河东、淮、浙州郡亦有之。冬至后生，叶似旋复。三月、四月开花，作穗紫白色，似丹参花，结子亦作穗。至五月枯，四月采。"}]},{"ID":"20240613123509-z0whe2e","Type":"NodeParagraph","Properties":{"id":"20240613123509-z0whe2e","updated":"20240613123509"},"Children":[{"Type":"NodeText","Data":"简要济众治肝虚目睛疼，冷泪不止，筋脉痛及眼羞明怕日。补肝散∶夏枯草半两，香附子一两，共为末。每服一钱，腊茶调下。无时候服。"}]},{"ID":"20240613123509-xb6dt6j","Type":"NodeParagraph","Properties":{"id":"20240613123509-xb6dt6j","updated":"20240613123509"},"Children":[{"Type":"NodeText","Data":"衍义曰∶夏枯草，今又谓之郁臭。自秋便生，经冬不瘁。春开白花，中夏结子，遂枯。"}]},{"ID":"20240613123509-6amjtc4","Type":"NodeParagraph","Properties":{"id":"20240613123509-6amjtc4","updated":"20240613123509"},"Children":[{"Type":"NodeText","Data":"古方九烧灰，合紧面药。初生嫩时，作菜食之，须浸洗，淘去苦水，治瘰 鼠漏。"}]},{"ID":"20240613123548-ojru525","Type":"NodeThematicBreak","Properties":{"id":"20240613123548-ojru525"}},{"ID":"20240613123549-ja2vuss","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123549-ja2vuss","updated":"20240613123554"},"Children":[{"Type":"NodeText","Data":"夏枯草《医学入门》"}]},{"ID":"20240613123549-n5yu9q1","Type":"NodeParagraph","Properties":{"id":"20240613123549-n5yu9q1","updated":"20240613123549"},"Children":[{"Type":"NodeText","Data":"夏枯草味苦辛寒，鼠 头疮瘿结团，明目破 除香港脚，能消湿痹又滋肝。"}]},{"ID":"20240613123549-4pveqmc","Type":"NodeParagraph","Properties":{"id":"20240613123549-4pveqmc","updated":"20240613123549"},"Children":[{"Type":"NodeText","Data":"月令云∶靡草死，得金气而生，至夏火盛而死，火克金之义也。无毒，主寒热鼠 、瘰 、头疮，散瘿结气，破 瘕，除香港脚湿痹。兼治肝虚睛疼、冷泪羞明，入香附子一倍为末，茶清下一钱，效。丹溪云∶有补养血脉之功，久服轻身长年。四月采，阴干。王瓜为使。"}]},{"ID":"20240613123601-9vhgx38","Type":"NodeThematicBreak","Properties":{"id":"20240613123601-9vhgx38"}},{"ID":"20240613123602-4qv0qqq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123602-4qv0qqq","updated":"20240613123606"},"Children":[{"Type":"NodeText","Data":"夏枯草《神农本草经读》"}]},{"ID":"20240613123602-xbcn4es","Type":"NodeParagraph","Properties":{"id":"20240613123602-xbcn4es","updated":"20240613123602"},"Children":[{"Type":"NodeText","Data":"气味苦、辛，寒。主寒热，瘰，鼠，头疮，破症，散瘿，结气，脚肿，湿痹，轻身。"}]},{"ID":"20240613123623-i9ztcir","Type":"NodeThematicBreak","Properties":{"id":"20240613123623-i9ztcir"}},{"ID":"20240613123624-wr0wq85","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123624-wr0wq85","updated":"20240613123630"},"Children":[{"Type":"NodeText","Data":"夏枯草《千金翼方》"}]},{"ID":"20240613123624-2x48ifo","Type":"NodeParagraph","Properties":{"id":"20240613123624-2x48ifo","updated":"20240613123624"},"Children":[{"Type":"NodeText","Data":"味苦辛，寒，无毒。主寒热瘰 ，鼠 ，头疮，破症，散瘿结气，脚肿湿痹，轻身。一名夕句，一名乃东，一名燕面。生蜀郡川谷，四月采。"}]},{"ID":"20240613123635-xz3od09","Type":"NodeThematicBreak","Properties":{"id":"20240613123635-xz3od09"}},{"ID":"20240613123636-t37hgme","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123636-t37hgme","updated":"20240613123641"},"Children":[{"Type":"NodeText","Data":"夏枯草《药性切用》"}]},{"ID":"20240613123636-lej75zi","Type":"NodeParagraph","Properties":{"id":"20240613123636-lej75zi","updated":"20240613123636"},"Children":[{"Type":"NodeText","Data":"辛苦微寒，入厥阴而缓肝解热，散结消瘿。久服，亦能伤胃。"}]},{"ID":"20240613123647-hn25zxy","Type":"NodeThematicBreak","Properties":{"id":"20240613123647-hn25zxy"}},{"ID":"20240613123648-db1lj1t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123648-db1lj1t","updated":"20240613123654"},"Children":[{"Type":"NodeText","Data":"夏枯草《玉楸药解》"}]},{"ID":"20240613123648-1wzqt5m","Type":"NodeParagraph","Properties":{"id":"20240613123648-1wzqt5m","updated":"20240613123648"},"Children":[{"Type":"NodeText","Data":"味苦，辛，气寒，入足厥阴肝、足少阳胆经。凉营泻热，散肿消坚，治瘰疬瘿瘤、扑伤、血崩带下、白点汗斑诸证。"}]},{"ID":"20240613123648-8b038b8","Type":"NodeParagraph","Properties":{"id":"20240613123648-8b038b8","updated":"20240613123648"},"Children":[{"Type":"NodeText","Data":"鲜者熬膏佳。"}]},{"ID":"20240613123748-xk9nhqt","Type":"NodeThematicBreak","Properties":{"id":"20240613123748-xk9nhqt"}},{"ID":"20240613123749-51g2o9z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123749-51g2o9z","updated":"20240613123756"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草求真》"}]},{"ID":"20240613123749-4juubfh","Type":"NodeParagraph","Properties":{"id":"20240613123749-4juubfh","updated":"20240613123749"},"Children":[{"Type":"NodeText","Data":"（隰草）散阴中结热"}]},{"ID":"20240613123749-o485e2w","Type":"NodeParagraph","Properties":{"id":"20240613123749-o485e2w","updated":"20240613123749"},"Children":[{"Type":"NodeText","Data":"夏枯草（专入肝）。辛苦微寒。按书所论治功。多言散结解热。能治一切瘿 湿痹。目珠夜痛等症。似得以寒清热之义矣。（汪昂曰。按目珠属阳。故书痛点苦寒药则效。黑珠属阴。故夜痛点苦寒药反剧。时珍曰。一男子至夜。目珠疼连眉棱骨痛及头半边肿痛。用黄连膏点之反甚。诸药不效。灸厥阴少阳。疼随止。半日又作。月余。以夏枯草二两。香附二两。甘草四钱。为末。每服一钱半。茶清调服。下咽则疼减半。至四五服。良愈矣！）何书又言气禀纯阳。及补肝血。得毋自相矛盾乎？讵知气虽寒而味则辛。凡结得辛则散。其气虽寒犹温。故云能以补血也！是以一切热郁肝经等症。得此治无不效。以其得藉解散之力耳。若属内火。治不宜用。又药何以枯名。以其冬生而夏枯也。茎叶同用。"}]},{"ID":"20240613123814-979t7p4","Type":"NodeThematicBreak","Properties":{"id":"20240613123814-979t7p4"}},{"ID":"20240613123815-zv15fu7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123815-zv15fu7","updated":"20240613123820"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草纲目》"}]},{"ID":"20240613123815-8lvi68h","Type":"NodeParagraph","Properties":{"id":"20240613123815-8lvi68h","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"「释名」夕句、乃东、燕面、铁色草。"}]},{"ID":"20240613123815-ulqaf43","Type":"NodeParagraph","Properties":{"id":"20240613123815-ulqaf43","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"「气味」（茎、叶）苦、辛、寒、无毒。"}]},{"ID":"20240613123815-9wpztt4","Type":"NodeParagraph","Properties":{"id":"20240613123815-9wpztt4","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613123815-arzzo24","Type":"NodeParagraph","Properties":{"id":"20240613123815-arzzo24","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"1、肝虚目痛（冷泪不止，羞明畏日）。用夏枯草半两、香附子一两，共研为末。每服一钱，茶汤调下。"}]},{"ID":"20240613123815-cmg4q74","Type":"NodeParagraph","Properties":{"id":"20240613123815-cmg4q74","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"2、赤白带下。夏枯草开花时，采来阴干，研为末。每服二钱，饭前服，米汤送下。"}]},{"ID":"20240613123815-nd7b6oy","Type":"NodeParagraph","Properties":{"id":"20240613123815-nd7b6oy","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"3、血崩。用夏枯草研为末，每服一小匙，米汤调下。"}]},{"ID":"20240613123815-4r4cfcg","Type":"NodeParagraph","Properties":{"id":"20240613123815-4r4cfcg","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"4、产后血晕，心气欲绝，用夏枯草捣烂，绞汁服一碗，极效。"}]},{"ID":"20240613123815-1dnkmp4","Type":"NodeParagraph","Properties":{"id":"20240613123815-1dnkmp4","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"5、打伤、刀伤。把夏枯草在口中嚼碎后敷在伤处。"}]},{"ID":"20240613123815-dckvrwc","Type":"NodeParagraph","Properties":{"id":"20240613123815-dckvrwc","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"6、汗斑白点。用夏枯草煎成浓汁，每天洗患处。"}]},{"ID":"20240613123815-lby2eok","Type":"NodeParagraph","Properties":{"id":"20240613123815-lby2eok","updated":"20240613123815"},"Children":[{"Type":"NodeText","Data":"7、瘰疬（不论已溃未溃，或日久成漏）。用夏枯草六两，加水两杯，煎至七成，吃完饭过一段时间以后温服。体虚者，可用夏枯草煎汁熬膏服，并以膏涂患处。兼服十全大补汤加香附、贝母、远志更好。"}]},{"ID":"20240613123802-37jg245","Type":"NodeThematicBreak","Properties":{"id":"20240613123802-37jg245"}},{"ID":"20240613123804-fuleukw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123804-fuleukw","updated":"20240613123809"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草简要方》"}]},{"ID":"20240613123804-eyb45te","Type":"NodeParagraph","Properties":{"id":"20240613123804-eyb45te","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"主治。散热。清血。缓肝火。舒肝郁目痛。脚肿乳痈乳岩。瘰。"}]},{"ID":"20240613123804-4a6x4fa","Type":"NodeParagraph","Properties":{"id":"20240613123804-4a6x4fa","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"夏枯草散。夏枯草花一两。香附（童便浸）二两。炙草三钱。研末。每服四钱。茶下。"}]},{"ID":"20240613123804-15ite8o","Type":"NodeParagraph","Properties":{"id":"20240613123804-15ite8o","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"日三次。治肝虚目痛。入夜尤甚。痛久血伤。加当归六钱。白芍四钱。生地一两。黄二两。"}]},{"ID":"20240613123804-epph5ke","Type":"NodeParagraph","Properties":{"id":"20240613123804-epph5ke","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"每服五钱。清茶一撮煎服。"}]},{"ID":"20240613123804-kq6nd7f","Type":"NodeParagraph","Properties":{"id":"20240613123804-kq6nd7f","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"夏枯草汤。夏枯草六两。水二钟。煎至七分。去滓食后服。治瘰马刀已溃未溃。或日久成漏。虚甚者煎浓汁服。并涂患处。兼十全大补汤。加香附贝母远志。（附）十全大补汤。"}]},{"ID":"20240613123804-aeu67ji","Type":"NodeParagraph","Properties":{"id":"20240613123804-aeu67ji","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"人参熟地（酒洗焙蒸）黄（盐水拌炒）各一钱五分。白术（炒）当归（酒拌）白芍（炒）肉桂各一钱。川芎白茯苓炙草各八分。每服三四钱。加生姜三片。大枣三枚。水煎服。"}]},{"ID":"20240613123804-3ce1wgd","Type":"NodeParagraph","Properties":{"id":"20240613123804-3ce1wgd","updated":"20240613123804"},"Children":[{"Type":"NodeText","Data":"夏枯草膏。夏枯草一斤半。当归白芍（酒炒）黑参乌药浙贝僵蚕各五钱。昆布桔梗陈皮抚芎甘草各三钱。香附（酒炒）一两。红花二钱。入砂锅内水煎浓汁滤去滓。复慢火熬浓。加白蜜八两。熬成膏。每服一二匙。滚水冲服。兼贴患处。治瘰坚硬。忌鱼腥。"}]},{"ID":"20240613123737-9gfjt5f","Type":"NodeThematicBreak","Properties":{"id":"20240613123737-9gfjt5f"}},{"ID":"20240613123738-vw1pgd7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123738-vw1pgd7","updated":"20240613123742"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草思辨录》"}]},{"ID":"20240613123738-rga5r4h","Type":"NodeParagraph","Properties":{"id":"20240613123738-rga5r4h","updated":"20240613123738"},"Children":[{"Type":"NodeText","Data":"夏枯草或谓禀纯阳之气，或谓禀纯阴之性。以刘潜江阴在下能生阳，阳在上能化阴之说衡之，似乎刘说为长。但人身之阴阳，犹天地之阴阳，刘所谓阴在下阳在上者，自指阴始生阳极盛而言，阳之生阴之化，亦必指夏枯草而言。不知一阴生于下而草枯矣，何阳生之有。"}]},{"ID":"20240613123738-ll03ze9","Type":"NodeParagraph","Properties":{"id":"20240613123738-ll03ze9","updated":"20240613123738"},"Children":[{"Type":"NodeText","Data":"一阴生于下而草枯，其所感者在下之阴，非在上之阳，又何得谓阳在上而化阴。其理似精非精，仍不得据此为准。窃谓夏枯草生于一阳始生之时，当为阴退阳进、阴中透阳之物。迨交夏至，阴进而上，则阳退而下，此草透阳之生意亦即至此而尽，恶得不枯。娄全善因其治目珠夜痛，点苦寒药不效之证，遂反揣之以为禀纯阳之气。夫目珠夜痛，为阴中阳结之证。夏枯草若气禀纯阳，其于阴中之阳，必锄 而难入；惟其为阴中透阳之物，以治阴中阳结之证，乃得如饥食渴饮，适偿其欲。就是思之，尚有毫厘未合否耶。至洄溪谓性禀纯阴，故一交盛阳，阴气将尽，即成熟枯槁。竟以夏至阴生之时，为阴气之将尽，疏失至此，尤令人不解矣。"}]},{"ID":"20240613123726-2gv8e6z","Type":"NodeThematicBreak","Properties":{"id":"20240613123726-2gv8e6z"}},{"ID":"20240613123727-5eqyka4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123727-5eqyka4","updated":"20240613123731"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草衍义》"}]},{"ID":"20240613123727-95mbdia","Type":"NodeParagraph","Properties":{"id":"20240613123727-95mbdia","updated":"20240613123727"},"Children":[{"Type":"NodeText","Data":"今又谓之郁臭。自秋便生，经冬不瘁。春开白花，中夏结子，遂枯。古方九烧灰，合紧面药。初生嫩时作菜食之，须浸洗，淘去苦水，治瘰 鼠漏。"}]},{"ID":"20240613123716-xrehag3","Type":"NodeThematicBreak","Properties":{"id":"20240613123716-xrehag3"}},{"ID":"20240613123717-9w2xmkf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123717-9w2xmkf","updated":"20240613123722"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草择要纲目》"}]},{"ID":"20240613123717-7wwjpwx","Type":"NodeParagraph","Properties":{"id":"20240613123717-7wwjpwx","updated":"20240613123717"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240613123717-mldyf2u","Type":"NodeParagraph","Properties":{"id":"20240613123717-mldyf2u","updated":"20240613123717"},"Children":[{"Type":"NodeText","Data":"苦辛寒无毒．补养厥阴血脉之药．"}]},{"ID":"20240613123717-j3p7lxf","Type":"NodeParagraph","Properties":{"id":"20240613123717-j3p7lxf","updated":"20240613123717"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240613123717-f1qjyao","Type":"NodeParagraph","Properties":{"id":"20240613123717-f1qjyao","updated":"20240613123717"},"Children":[{"Type":"NodeText","Data":"寒热瘰 ．鼠 头疮．破症瘕．散瘿结气．脚肿湿痹．取其能解内热缓肝火也．"}]},{"ID":"20240613123659-qyfxz6t","Type":"NodeThematicBreak","Properties":{"id":"20240613123659-qyfxz6t"}},{"ID":"20240613123701-c6jiqu3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123701-c6jiqu3","updated":"20240613123712"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草图经》"}]},{"ID":"20240613123701-u9x7rbf","Type":"NodeParagraph","Properties":{"id":"20240613123701-u9x7rbf","updated":"20240613123707"},"Children":[{"Type":"NodeText","Data":"夏枯草，生蜀郡川谷，今河东、淮、浙州郡亦有之。冬至后生，叶似旋复；三月、四月开花，作穗紫白色，似丹参花；结子亦作穗，至五月枯。四月采。"}]},{"ID":"20240613123611-ottcsbq","Type":"NodeThematicBreak","Properties":{"id":"20240613123611-ottcsbq"}},{"ID":"20240613123613-ozym5mc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123613-ozym5mc","updated":"20240613123618"},"Children":[{"Type":"NodeText","Data":"夏枯草《得配本草》"}]},{"ID":"20240613123613-rnv8vh2","Type":"NodeParagraph","Properties":{"id":"20240613123613-rnv8vh2","updated":"20240613123613"},"Children":[{"Type":"NodeText","Data":"土瓜为之使。伏汞砂。"}]},{"ID":"20240613123613-as8t0g9","Type":"NodeParagraph","Properties":{"id":"20240613123613-as8t0g9","updated":"20240613123613"},"Children":[{"Type":"NodeText","Data":"微辛、微苦，气寒。入足厥阴经气分。解阴中郁结之热，通血脉凝滞之气。合香附、贝母，治头疮瘰 。调茶清、香附、甘草，治目珠热痛。"}]},{"ID":"20240613123613-3r7z8ft","Type":"NodeParagraph","Properties":{"id":"20240613123613-3r7z8ft","updated":"20240613123613"},"Children":[{"Type":"NodeText","Data":"土瓜水浸，焙燥用。治目痛，沙糖水浸，焙干用。气虚者禁用。"}]},{"ID":"20240613123116-dcyukdo","Type":"NodeThematicBreak","Properties":{"id":"20240613123116-dcyukdo"}},{"ID":"20240613123456-bbvmwme","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123456-bbvmwme","updated":"20240613123502"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草述钩元》"}]},{"ID":"20240613123456-zch2kri","Type":"NodeParagraph","Properties":{"id":"20240613123456-zch2kri","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"生平泽。三四月茎端作穗。长一二寸。穗中开淡紫花。结子亦作穗。五月便枯。宜四月收采。寇氏误为茺蔚。不知茺蔚有臭味。而夏枯绝无。且夏枯先枯而无子。茺蔚后枯而有子。"}]},{"ID":"20240613123456-k61h46o","Type":"NodeParagraph","Properties":{"id":"20240613123456-k61h46o","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"明是两物。（丹溪）"}]},{"ID":"20240613123456-ne0jfyp","Type":"NodeParagraph","Properties":{"id":"20240613123456-ne0jfyp","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"茎叶"}]},{"ID":"20240613123456-l9o1dxq","Type":"NodeParagraph","Properties":{"id":"20240613123456-l9o1dxq","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"味苦辛气寒。入足厥阴少阳经。土瓜（即王瓜）为之使。主治寒热瘰鼠。破症散瘿结气。疗头疮喉肿。脚肿湿痹。补肝明目。有补养厥阴血脉之功。其退寒热。惟虚者可使。"}]},{"ID":"20240613123456-zb2akdk","Type":"NodeParagraph","Properties":{"id":"20240613123456-zb2akdk","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"（丹溪）治目珠疼至夜则甚者极效。或用苦寒药点之反甚者尤效。夫夜与寒皆阴。此草禀纯阳之气而遇阴以化。补养厥阴血脉。故如神取效也。（全善）冬至生。夏至枯。具三阳之正体。寒水之正化。故从内达外。自下彻上。以去寒热气结。及合湿成痹也。得连翘贝母元参薄荷忍冬藤栝蒌根紫背天葵蓖麻仁甘草。治一切瘰有效。得蒲公英。治一切乳痈乳岩。单取数两。水煮浓汁。入生甘菊紫地丁忍冬藤连翘白芨白蔹甘草生地白芷半枝莲。消一切痈疽肿毒。止痛有神。肝虚目睛疼。冷泪不止。血脉痛。羞明怕日。夏枯草五钱。香附一两为末。"}]},{"ID":"20240613123456-7la4ufu","Type":"NodeParagraph","Properties":{"id":"20240613123456-7la4ufu","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"每服一钱。茶调下。时疫喉肿盛行。捣烂渍水。去渣。少加酒服。已病者速愈。未病者不染。诚退肿要药也。血崩不止。夏枯草为末。每服方寸匕。米饮调下。产后血晕。心气欲绝者。夏枯草捣绞汁。服一大盏妙。瘰马刀。不问溃与未溃。或日久。或成漏。用夏枯草六两。水二钟。煎七分。食远温服。虚甚者。煎汁熬膏服。并涂患处。兼以十全汤加香附贝母远志尤善。此味生血。乃治瘰之圣药也。"}]},{"ID":"20240613123456-ivagcnz","Type":"NodeParagraph","Properties":{"id":"20240613123456-ivagcnz","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"〔论〕夏枯草以冬至后发生。夏至后枯瘁。其气寒。其味苦辛。谓为阳是也。谓为纯阳则犹未尽也。卢子由云。具三阳之正体。寒水之正化。庶几近之而未晰其微也。盖阳在下。"}]},{"ID":"20240613123456-2c73qcy","Type":"NodeParagraph","Properties":{"id":"20240613123456-2c73qcy","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"由阴而生。在上即由阴而化。阴在上。由阳而生。在下即由阳而化。夏枯草本于阴。遇阳之生以生。迨饱历阳气。以至阳极遇阴生遂枯者。非恶阴也。阳极将尽。径趋阴以化也。如人身所病。阳盛而不得阴以化。则气结。而血亦结。此味于瘰鼠。症结气。破之有专功。"}]},{"ID":"20240613123456-cdje3na","Type":"NodeParagraph","Properties":{"id":"20240613123456-cdje3na","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"可以思其微矣。夫阳遇阴化。则目珠痛之治。如他苦寒品味独非阴乎。何以点之反甚。而夏枯草何以独别。盖此味一物。具有阴遇阳生。阳遇阴化之妙。更妙于阳气趋阴以化。气得化而即能化血。不等于以阴制阳者。反不能化血也。治失血后不寐。经言卫气不得入于阴。宜用半夏汤。以半夏得一阴之气而枯。犹是生于阳成于阴者。但其性燥。不宜于血证。代以夏枯草饮之。其卧立至。绎此岂非阳得阴以化。故阳入阴中而俾卧至乎。又兹物遇阴而枯。枯者告成之会。故曰成于阴。讵知阳之化于阴也。正以成其阳。有阴以成其阳。而阳之用不穷。"}]},{"ID":"20240613123456-6cn19tm","Type":"NodeParagraph","Properties":{"id":"20240613123456-6cn19tm","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"故楼氏谓目珠痛之治。不以阴而以阳也。阳得化于阴。则气化而后血化。诸方用以补肝明目。并治血晕血崩。须识此义。"}]},{"ID":"20240613123456-ngb3ymn","Type":"NodeParagraph","Properties":{"id":"20240613123456-ngb3ymn","updated":"20240613123456"},"Children":[{"Type":"NodeText","Data":"〔修治〕用叶茎。其味苦辛。苦胜于辛。但茎之苦辛不及叶。似宜多用叶。"}]},{"ID":"20240613123117-h30fli8","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-h30fli8"}},{"ID":"20240613123443-n71fze4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123443-n71fze4","updated":"20240613123449"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草备要》"}]},{"ID":"20240613123443-a7l31yj","Type":"NodeParagraph","Properties":{"id":"20240613123443-a7l31yj","updated":"20240613123443"},"Children":[{"Type":"NodeText","Data":"补阳，散结，消瘿"}]},{"ID":"20240613123443-fz1nmi4","Type":"NodeParagraph","Properties":{"id":"20240613123443-fz1nmi4","updated":"20240613123443"},"Children":[{"Type":"NodeText","Data":"辛苦微寒，气禀纯阳。补肝血，缓肝火，解内热，散结气。"}]},{"ID":"20240613123443-y8jtsd8","Type":"NodeParagraph","Properties":{"id":"20240613123443-y8jtsd8","updated":"20240613123443"},"Children":[{"Type":"NodeText","Data":"治瘿 湿痹，目珠夜痛（楼全善曰∶目珠连目本，即目系也。夜痛及点苦寒药更甚者，夜与寒皆阴也，夏枯气禀纯阳；补厥阴血脉，故治此如神，以阳和阴也。按目白珠属阳，故昼痛，点苦寒药则效；黑珠属阴，故夜痛，点苦寒药反剧）。"}]},{"ID":"20240613123443-u22qc9f","Type":"NodeParagraph","Properties":{"id":"20240613123443-u22qc9f","updated":"20240613123443"},"Children":[{"Type":"NodeText","Data":"冬至生，夏至枯，故名，用茎叶。"}]},{"ID":"20240613123117-5coib06","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-5coib06"}},{"ID":"20240613123429-2hoy1fr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123429-2hoy1fr","updated":"20240613123436"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草新编》"}]},{"ID":"20240613123429-gcw8n2k","Type":"NodeParagraph","Properties":{"id":"20240613123429-gcw8n2k","updated":"20240613123429"},"Children":[{"Type":"NodeText","Data":"夏枯草，味苦，气温。曰寒者，误。入肺、脾、心三经。专散痰核鼠疮，尤通心气，头目之火可祛，胸膈之痞可降。世人弃而不收，谁知为药笼中必需之物乎。夫肺气为邪所壅，则清肃之令不行，而痰即结于胸膈之间而不得散。倘早用夏枯草，同二陈汤煎服，何至痰核之生。心火炎上，则头目肿痛，而痰即结于胸膈而成痞。早用夏枯草，入于芩、连、天花粉之内，何至头痛目肿乎。盖夏枯草直入心经，以通其气，而芩、连、花粉之类，得以解炎上之火也。尤妙心火一平，引火下生脾土，则脾气健旺，而痰更消亡，鼠疮从何而生乎，《本草》只言其破症坚、消寒热、祛湿痹，尚未深知夏枯草也。"}]},{"ID":"20240613123429-lfru1yl","Type":"NodeParagraph","Properties":{"id":"20240613123429-lfru1yl","updated":"20240613123429"},"Children":[{"Type":"NodeText","Data":"或问夏枯草，近人亦知用之，但不能入之汤剂之内也，今欲用之，不知多寡宜若何耳？"}]},{"ID":"20240613123429-c3e0unc","Type":"NodeParagraph","Properties":{"id":"20240613123429-c3e0unc","updated":"20240613123429"},"Children":[{"Type":"NodeText","Data":"夫夏枯草，阴药也，阴药宜多用以出奇，而不可少用以待变也。"}]},{"ID":"20240613123117-f58xj7a","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-f58xj7a"}},{"ID":"20240613123418-52yfpa7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123418-52yfpa7","updated":"20240613123422"},"Children":[{"Type":"NodeText","Data":"夏枯草《新修本草》"}]},{"ID":"20240613123418-3hqybi0","Type":"NodeParagraph","Properties":{"id":"20240613123418-3hqybi0","updated":"20240613123418"},"Children":[{"Type":"NodeText","Data":"味苦、辛，寒，无毒。主寒热、瘰 、鼠 、头疮，破症，散瘿结气，脚肿湿痹，轻身。"}]},{"ID":"20240613123418-99ukuj4","Type":"NodeParagraph","Properties":{"id":"20240613123418-99ukuj4","updated":"20240613123418"},"Children":[{"Type":"NodeText","Data":"一名夕句，一名乃东，一名燕面。生蜀郡川谷，四月采。"}]},{"ID":"20240613123418-mp7e694","Type":"NodeParagraph","Properties":{"id":"20240613123418-mp7e694","updated":"20240613123418"},"Children":[{"Type":"NodeText","Data":"土瓜为之使，〔谨案〕此草，生平泽，叶似旋复，首春即生，四月穗出，其花紫白似丹参花，五月便枯。处处有之。"}]},{"ID":"20240613123117-rh9jop1","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-rh9jop1"}},{"ID":"20240613123406-voqf1k8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123406-voqf1k8","updated":"20240613123412"},"Children":[{"Type":"NodeText","Data":"夏枯草《神农本草经百种录》"}]},{"ID":"20240613123406-sqew607","Type":"NodeParagraph","Properties":{"id":"20240613123406-sqew607","updated":"20240613123406"},"Children":[{"Type":"NodeText","Data":"味苦辛寒。主寒热，瘰 ，鼠 头疮，火气所发。破症散瘿结气，火气所结。嘴肿湿痹，湿热之在下者。轻身。湿火退则身健也。"}]},{"ID":"20240613123406-do500s3","Type":"NodeParagraph","Properties":{"id":"20240613123406-do500s3","updated":"20240613123406"},"Children":[{"Type":"NodeText","Data":"此以物禀之气候为治，又一义也。凡物皆生于春，长于夏，惟此草至夏而枯。盖其性禀纯阴，得少阳之气勃然兴发，一交盛阳，阴气将尽，即成熟枯槁。故凡盛阳留结之病，用此为治，亦即枯灭，此天地感应之妙理也。凡药之以时候荣枯为治者，俱可类推。"}]},{"ID":"20240613123117-sjx9fpd","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-sjx9fpd"}},{"ID":"20240613123356-mllivq7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123356-mllivq7","updated":"20240613123401"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草便读》"}]},{"ID":"20240613123356-3wvf3g5","Type":"NodeParagraph","Properties":{"id":"20240613123356-3wvf3g5","updated":"20240613123356"},"Children":[{"Type":"NodeText","Data":"虽禀纯阳之气．味仍辛苦而寒．独走厥阴．能解肝家郁火．功专散结．堪医瘰 疮疡．（此草冬至后生叶．至春而花．一到夏至即枯．故名．然各家皆言其苦寒．散结气．治瘰．惟朱丹溪言其能有补养厥阴血脉之功．想此草得春气最多．或可为助耳．观此草得阳气而生．得阴气而死．似乎禀纯阳之性．故虽属阴寒．而阴中仍含阳气．且皆取用其花．有春木发陈条达之意．虽苦寒而不遏耳．）"}]},{"ID":"20240613123117-7v74ga9","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-7v74ga9"}},{"ID":"20240613123347-p5bhpgq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123347-p5bhpgq","updated":"20240613123351"},"Children":[{"Type":"NodeText","Data":"夏枯草《神农本草经赞》"}]},{"ID":"20240613123347-4x0cpx2","Type":"NodeParagraph","Properties":{"id":"20240613123347-4x0cpx2","updated":"20240613123347"},"Children":[{"Type":"NodeText","Data":"味苦辛寒。主瘰。鼠。头疮。破症散瘿。结气脚肿。湿痹轻身。一名夕句。一名乃东。生川谷。"}]},{"ID":"20240613123347-2626jq7","Type":"NodeParagraph","Properties":{"id":"20240613123347-2626jq7","updated":"20240613123347"},"Children":[{"Type":"NodeText","Data":"方茎对节。铁色非污。三冬孳茂。九夏摧枯。理通阳复。气感阴徂。臭郁茺蔚。荣悴潜符。"}]},{"ID":"20240613123347-a67023y","Type":"NodeParagraph","Properties":{"id":"20240613123347-a67023y","updated":"20240613123347"},"Children":[{"Type":"NodeText","Data":"李时珍曰。其茎微方。叶对节生。一名铁色草。苏恭曰。冬至后生叶。三四月开花作穗。"}]},{"ID":"20240613123347-1ydvfm3","Type":"NodeParagraph","Properties":{"id":"20240613123347-1ydvfm3","updated":"20240613123347"},"Children":[{"Type":"NodeText","Data":"五月便枯。梁元帝纂要。冬曰三冬。夏曰九夏。晋书志。阳气生而孳茂。柳宗元牒。力易摧枯。胡震亨曰。此草禀纯阳之气。得阴气则枯。臭郁草即茺蔚也。两物俱入夏即枯。夏枯先枯而无子。臭郁后枯而结子。五灯会元。潜符蜜证。"}]},{"ID":"20240613123117-ogrz661","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-ogrz661"}},{"ID":"20240613123328-ohhijqo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123328-ohhijqo","updated":"20240613123338"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草从新》"}]},{"ID":"20240613123328-p39alt4","Type":"NodeParagraph","Properties":{"id":"20240613123328-p39alt4","updated":"20240613123328"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"散结、消瘿、明目．"}]},{"ID":"20240613123328-y5iq442","Type":"NodeParagraph","Properties":{"id":"20240613123328-y5iq442","updated":"20240613123328"},"Children":[{"Type":"NodeText","Data":"辛苦微寒．缓肝火．解内热．散结气．治瘰 鼠 ．瘿瘤症坚．乳痈乳岩．目珠夜痛．"}]},{"ID":"20240613123117-fwr3ice","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-fwr3ice"}},{"ID":"20240613123308-wyaxfdk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123308-wyaxfdk","updated":"20240613123314"},"Children":[{"Type":"NodeText","Data":"夏枯草《本草分经》"}]},{"ID":"20240613123308-v7k453n","Type":"NodeParagraph","Properties":{"id":"20240613123308-v7k453n","updated":"20240613123308"},"Children":[{"Type":"NodeText","Data":"辛苦微寒，散肝经之郁火，解内热散结气消瘿，治目珠夜痛，久服伤胃。"}]},{"ID":"20240613123117-4npn0j8","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-4npn0j8"}},{"ID":"20240613123255-1i3fcsa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123255-1i3fcsa","updated":"20240613123300"},"Children":[{"Type":"NodeText","Data":"夏枯草《本经逢原》"}]},{"ID":"20240613123255-ge26buu","Type":"NodeParagraph","Properties":{"id":"20240613123255-ge26buu","updated":"20240613123255"},"Children":[{"Type":"NodeText","Data":"苦辛温，无毒。"}]},{"ID":"20240613123255-ys4lotw","Type":"NodeParagraph","Properties":{"id":"20240613123255-ys4lotw","updated":"20240613123255"},"Children":[{"Type":"NodeText","Data":"《本经》主寒热瘰 ，鼠 ，头疮，破症散瘿结气，脚肿湿痹，轻身。"}]},{"ID":"20240613123255-utz8uot","Type":"NodeParagraph","Properties":{"id":"20240613123255-utz8uot","updated":"20240613123255"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"夏枯草，《本经》专治寒热瘰 ，有补养厥阴血脉之功。以辛能散结，苦能除热，而症结瘿气散矣。言轻身者，脚肿湿痹愈，而无重着之患也。佐以香附、甘草，治目珠疼夜甚者，以其禀纯阳之气，而散阴中结滞之热也。又能解内热，缓肝火，从治之法，并治痘后余毒，及肝热目赤者效。久服亦防伤胃，以善走厥阴助肝木之气耳。"}]},{"ID":"20240613123117-em6jqt5","Type":"NodeThematicBreak","Properties":{"id":"20240613123117-em6jqt5"}},{"ID":"20240613123118-s56mf1w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123118-s56mf1w","updated":"20240613123154"},"Children":[{"Type":"NodeText","Data":"夏枯草《中药学》"}]},{"ID":"20240613123118-5y7wiif","Type":"NodeParagraph","Properties":{"id":"20240613123118-5y7wiif","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【药用】本品文唇形科植物夏枯草的花序及果穗。"}]},{"ID":"20240613123118-gbkn2ni","Type":"NodeParagraph","Properties":{"id":"20240613123118-gbkn2ni","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，寒。入肝、胆经。"}]},{"ID":"20240613123118-4dwn6zc","Type":"NodeParagraph","Properties":{"id":"20240613123118-4dwn6zc","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【功效】清肝火，散郁结。"}]},{"ID":"20240613123118-vyy6494","Type":"NodeParagraph","Properties":{"id":"20240613123118-vyy6494","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肝火上炎、目赤肿痛、目珠疼痛；头痛、晕眩等症。"}]},{"ID":"20240613123118-rgv8hca","Type":"NodeParagraph","Properties":{"id":"20240613123118-rgv8hca","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"夏枯草能清泄肝火，为治肝火上炎所致的目赤、头痛、头晕的要药，常配菊花、石决明等同用；如肝虚目珠疼痛，至夜尤剧，可与当归、白芍等配合应用。"}]},{"ID":"20240613123118-7zttdr8","Type":"NodeParagraph","Properties":{"id":"20240613123118-7zttdr8","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"2.用于瘰历痰核"}]},{"ID":"20240613123118-n6ggs7e","Type":"NodeParagraph","Properties":{"id":"20240613123118-n6ggs7e","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"瘰历痰核，多由肝气郁结，久而化火，痰火结郁而成。夏枯草能清肝火、散郁结，为治疗瘰历结核属于痰火者一味常用药物，长期服用有一定效果，临床常配合玄参、贝母、连翘、牡蛎、昆布等同用。"}]},{"ID":"20240613123118-hdgwfoh","Type":"NodeParagraph","Properties":{"id":"20240613123118-hdgwfoh","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【处方用名】夏枯草（晒干用）"}]},{"ID":"20240613123118-w45stm4","Type":"NodeParagraph","Properties":{"id":"20240613123118-w45stm4","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240613123118-w950pfm","Type":"NodeParagraph","Properties":{"id":"20240613123118-w950pfm","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【按语】1.夏枯草为清肝火、散郁结的要药，它所主治的大多是肝经的病症。"}]},{"ID":"20240613123118-ak8t4t1","Type":"NodeParagraph","Properties":{"id":"20240613123118-ak8t4t1","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"2.本品配以菊花、决明子，可清肝明目，治目赤肿痛、配以石决明、钩藤，可平降肝阳，治头痛、头晕；配以玄参、贝母、牡蛎等品，可软坚散结，治瘰历结核。"}]},{"ID":"20240613123118-4ynnmnk","Type":"NodeParagraph","Properties":{"id":"20240613123118-4ynnmnk","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"3.近年来临床上又用于肿瘤。"}]},{"ID":"20240613123118-vyvij6v","Type":"NodeParagraph","Properties":{"id":"20240613123118-vyvij6v","updated":"20240613123118"},"Children":[{"Type":"NodeText","Data":"【方剂举例】夏枯草膏《医宗金鉴》：夏枯草、当归、白芍、玄参、乌药、浙贝、僵蚕、昆布、陈皮、桔梗、抚芎、甘草、香附、红花。治肝燥血旺，瘰历坚硬。"}]},{"ID":"20240613120000-x7fva0m","Type":"NodeThematicBreak","Properties":{"id":"20240613120000-x7fva0m"}},{"ID":"20240613123102-lgs36l5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123102-lgs36l5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"《中国药典》：夏枯草"}]},{"ID":"20240613123102-enqyzm1","Type":"NodeParagraph","Properties":{"id":"20240613123102-enqyzm1","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613123102-qb4l9mp","Type":"NodeParagraph","Properties":{"id":"20240613123102-qb4l9mp","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" Xià Kū Cǎo"}]},{"ID":"20240613123102-g3xxjpv","Type":"NodeParagraph","Properties":{"id":"20240613123102-g3xxjpv","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613123102-xwx8s7q","Type":"NodeParagraph","Properties":{"id":"20240613123102-xwx8s7q","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 棒槌草、铁色草、大头花、夏枯头"}]},{"ID":"20240613123102-vg2wb0n","Type":"NodeParagraph","Properties":{"id":"20240613123102-vg2wb0n","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613123102-iezrwjc","Type":"NodeParagraph","Properties":{"id":"20240613123102-iezrwjc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" SPICA PRUNELLAE"}]},{"ID":"20240613123102-1row8e7","Type":"NodeParagraph","Properties":{"id":"20240613123102-1row8e7","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613123102-8znzo41","Type":"NodeParagraph","Properties":{"id":"20240613123102-8znzo41","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 本品为唇形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"夏枯草"},{"Type":"NodeText","Data":"Prunella vulgaris L. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果穗"},{"Type":"NodeText","Data":"。夏季果穗呈棕红色时采收，除去杂质，晒干。"}]},{"ID":"20240613123102-483du4m","Type":"NodeParagraph","Properties":{"id":"20240613123102-483du4m","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613123102-w273g8b","Type":"NodeParagraph","Properties":{"id":"20240613123102-w273g8b","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 本品呈棒状，略扁，长1.5～8cm，直径0.8～1.5cm,淡棕色至棕红色。全穗由数轮至10数轮宿萼与苞片组成，每轮有对生苞片2片，呈扇形，先端尖尾状，脉纹明显，外表面有白毛。每一苞片内有花3朵，花冠多已脱落，宿萼二唇形，内有小坚果4枚，卵圆形，棕色，尖端有白色突起。体轻。气微，味淡。"}]},{"ID":"20240613123102-jcn0xk2","Type":"NodeParagraph","Properties":{"id":"20240613123102-jcn0xk2","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613123102-w7u9xm5","Type":"NodeParagraph","Properties":{"id":"20240613123102-w7u9xm5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240613123102-7uu2zs0","Type":"NodeParagraph","Properties":{"id":"20240613123102-7uu2zs0","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613123102-ksemxnu","Type":"NodeParagraph","Properties":{"id":"20240613123102-ksemxnu","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" （1）取本品粉末1g，加乙醇15ml，加热回流1 小时，滤过。取滤液1ml,置蒸发皿中，蒸干，残渣加醋酐1 滴使溶解，再加硫酸微量，即显紫色，后变暗绿色。"}]},{"ID":"20240613123102-o9j00ws","Type":"NodeParagraph","Properties":{"id":"20240613123102-o9j00ws","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（2）取[鉴别]（1）项下的滤液点于滤纸上，喷洒0.9％ 三氯化铁溶液与0.6％ 铁氰化钾溶液的等容混合液，即显蓝色斑点。"}]},{"ID":"20240613123102-75du2bl","Type":"NodeParagraph","Properties":{"id":"20240613123102-75du2bl","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醇20ml，加热回流1 小时，滤过，滤液蒸干，用石油醚（30～60℃）浸泡2 次，每次15ml（约2 分钟），倾去石油醚液，残渣加乙醇1ml 使溶解，作为供试品溶液。另取熊果酸对照品，加乙醇制成每1ml 含1mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一硅胶Ｇ薄层板上，以环己烷－氯仿－醋酸乙酯－冰醋酸（20:5:8:0.5）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，100℃ 加热至斑点显色清晰，分别置日光及紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，分别显相同颜色的斑点或荧光斑点。"}]},{"ID":"20240613123102-qlzzj1n","Type":"NodeParagraph","Properties":{"id":"20240613123102-qlzzj1n","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613123102-6s7s2z9","Type":"NodeParagraph","Properties":{"id":"20240613123102-6s7s2z9","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 归肝、胆经。"}]},{"ID":"20240613123102-6nyairi","Type":"NodeParagraph","Properties":{"id":"20240613123102-6nyairi","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613123102-vlsmn36","Type":"NodeParagraph","Properties":{"id":"20240613123102-vlsmn36","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 辛、苦，寒。"}]},{"ID":"20240613123102-48apu66","Type":"NodeParagraph","Properties":{"id":"20240613123102-48apu66","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613123102-apz0ja8","Type":"NodeParagraph","Properties":{"id":"20240613123102-apz0ja8","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 清火，明目，散结，消肿。用于目赤肿痛，目珠夜痛，头痛眩晕，瘰疬，瘿瘤，乳痈肿痛；甲状腺肿大，淋巴结结核，乳腺增生，高血压。"}]},{"ID":"20240613123102-oez5lao","Type":"NodeParagraph","Properties":{"id":"20240613123102-oez5lao","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613123102-p3z9tmj","Type":"NodeParagraph","Properties":{"id":"20240613123102-p3z9tmj","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240613123102-hk5r5m8","Type":"NodeParagraph","Properties":{"id":"20240613123102-hk5r5m8","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613123102-0uqfc2b","Type":"NodeParagraph","Properties":{"id":"20240613123102-0uqfc2b","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" （1）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粗毛夏枯草"},{"Type":"NodeText","Data":"Prunella hispida Benth，云南、西藏也作夏枯草入药。"}]},{"ID":"20240613123102-cm6hjep","Type":"NodeParagraph","Properties":{"id":"20240613123102-cm6hjep","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（2）用于肝火上炎、目赤肿痛、目珠疼痛；头痛、晕眩等症。夏枯草能清泄肝火，为治肝火上炎所致的目赤、头痛、头晕的要药，常配菊花、石决明等同用；如肝虚目珠疼痛，至夜尤剧，可与当归、白芍等配合应用。"}]},{"ID":"20240613123102-voefbkj","Type":"NodeParagraph","Properties":{"id":"20240613123102-voefbkj","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（3）用于瘰历痰核。瘰历痰核，多由肝气郁结，久而化火，痰火结郁而成。夏枯草能清肝火、散郁结，为治疗瘰历结核属于痰火者一味常用药物，长期服用有一定效果，临床常配合玄参、贝母、连翘、牡蛎、昆布等同用。"}]},{"ID":"20240613123102-h9wqgmh","Type":"NodeParagraph","Properties":{"id":"20240613123102-h9wqgmh","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"夏枯草为清肝火、散郁结的要药，它所主治的大多是肝经的病症。本品配以菊花、决明子，可清肝明目，治目赤肿痛、配以石决明、钩藤，可平降肝阳，治头痛、头晕；配以玄参、贝母、牡蛎等品，可软坚散结，治瘰历结核。近年来临床上又用于肿瘤。"}]},{"ID":"20240613123102-aq9zsui","Type":"NodeParagraph","Properties":{"id":"20240613123102-aq9zsui","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613123102-4jtuqj7","Type":"NodeParagraph","Properties":{"id":"20240613123102-4jtuqj7","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613123102-2awxbsm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123102-2awxbsm","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：夏枯草"}]},{"ID":"20240613123102-qt8lq6r","Type":"NodeParagraph","Properties":{"id":"20240613123102-qt8lq6r","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613123102-cyfxhs5","Type":"NodeParagraph","Properties":{"id":"20240613123102-cyfxhs5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" Xià Kū Cǎo"}]},{"ID":"20240613123102-7mkcis5","Type":"NodeParagraph","Properties":{"id":"20240613123102-7mkcis5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613123102-mv7i6av","Type":"NodeParagraph","Properties":{"id":"20240613123102-mv7i6av","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 夕句、乃东（《本经》），燕面（《别录》），麦穗夏枯草、麦夏枯、铁线夏枯（《滇南本草》），铁色草（《纲目》），棒柱头花（《中国药植志》），大头花（《浙江中药手册》），灯笼头、羊肠菜、榔头草（《江苏植药志》），白花草（《河北药材》），胀饱草（《山东中药》），棒槌草（《中药志》），干叶叶（《陕西中药志》），锣锤草、东风、牛枯草、地枯牛、广谷草（《湖南药物志》），六月干、棒头柱（《闽东本草》）。"}]},{"ID":"20240613123102-0yvor2k","Type":"NodeParagraph","Properties":{"id":"20240613123102-0yvor2k","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613123102-kid4pjd","Type":"NodeParagraph","Properties":{"id":"20240613123102-kid4pjd","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613123102-kh9q7cb","Type":"NodeParagraph","Properties":{"id":"20240613123102-kh9q7cb","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613123102-2zlptlz","Type":"NodeParagraph","Properties":{"id":"20240613123102-2zlptlz","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 为唇形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"夏枯草"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果穗"},{"Type":"NodeText","Data":"。夏季当果穗半枯时噪下，晒干。"}]},{"ID":"20240613123102-ewkjl22","Type":"NodeParagraph","Properties":{"id":"20240613123102-ewkjl22","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613123102-zwl8wlu","Type":"NodeParagraph","Properties":{"id":"20240613123102-zwl8wlu","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 生于荒地、路旁及山坡草丛中。全国大部地区均有分布。"}]},{"ID":"20240613123102-c0axzjv","Type":"NodeParagraph","Properties":{"id":"20240613123102-c0axzjv","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613123102-2ndj8u1","Type":"NodeParagraph","Properties":{"id":"20240613123102-2ndj8u1","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 多年生草本。茎方形，基部匍匐，高约30厘米，全株密生细毛。叶对生；近基部的叶有柄，上部叶无柄；叶片椭圆状披针形，全缘，或略有锯齿。轮伞花序顶生，呈穗状；苞片肾形，基部截形或略呈心脏形，顶端突成长尾状渐尖形，背面有粗毛；花萼唇形，前方有粗毛，后方光滑，上唇长椭圆形，3裂，两侧扩展成半披针形，下唇2裂，裂片三角形，先端渐尖；花冠紫色或白色，唇形，下部管状，上唇作风帽状，2裂，下唇平展，3裂；雄蕊4，2强，花丝顶端分叉，其中一端着生花药；子房4裂，花柱丝状。小坚果褐色，长椭圆形，具3棱。花期5～6月。果期6～7月。"}]},{"ID":"20240613123102-3wfz4m5","Type":"NodeParagraph","Properties":{"id":"20240613123102-3wfz4m5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613123102-yeq1vdg","Type":"NodeParagraph","Properties":{"id":"20240613123102-yeq1vdg","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 干燥果穗呈长圆柱形或宝塔形，长2.5～6.5厘米，直径1～1.5厘米，棕色或淡紫褐色，宿萼数轮至十数轮，作覆瓦状排列，每轮有5～6个具短柄的宿萼，下方对生苞片2枚。苞片肾形，淡黄褐色，纵脉明显，基部楔形，先端尖尾状，背面生白色粗毛，宿萼唇形，上唇宽广，先端微3裂，下唇2裂，裂片尖三角形，外面有租毛。花冠及雄蕊都已脱落。宿萼内有小坚果4枚，棕色，有光泽。体轻质脆，微有清香气，味淡。以色紫褐、穗大者为佳。"}]},{"ID":"20240613123102-rc84jf0","Type":"NodeParagraph","Properties":{"id":"20240613123102-rc84jf0","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"主产于江苏、安徽、浙江、河南等地，其他各省亦产。"}]},{"ID":"20240613123102-qt21w5s","Type":"NodeParagraph","Properties":{"id":"20240613123102-qt21w5s","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613123102-p85adyv","Type":"NodeParagraph","Properties":{"id":"20240613123102-p85adyv","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 全草含三萜皂甙，其甙元是齐墩果酸，尚含游离的齐墩果酸、熊果酸、芸香甙、金丝桃甙、顺-咖啡酸、反-咖啡酸、维生素B1、维生素C、维生素K、胡萝卜素、树脂、苦味质、鞣质、挥发油、生物碱、水溶性盐类（约3.5％，其中约63％是氯化钾）等。"}]},{"ID":"20240613123102-5eq85el","Type":"NodeParagraph","Properties":{"id":"20240613123102-5eq85el","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"花穗含飞燕草素和矢车菊素的花色甙、d-樟脑、d-小茴香酮、熊果酸。"}]},{"ID":"20240613123102-wn8am92","Type":"NodeParagraph","Properties":{"id":"20240613123102-wn8am92","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613123102-64td7ui","Type":"NodeParagraph","Properties":{"id":"20240613123102-64td7ui","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" ①降压作用"}]},{"ID":"20240613123102-7qpqxp2","Type":"NodeParagraph","Properties":{"id":"20240613123102-7qpqxp2","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"夏枯草的水浸出液、乙醇-水浸出液和30％乙醇浸出液，对麻醉动物有降低血压作用。煎剂（100毫克/公斤）注射于麻醉犬，可产生显着持久的降压作用，但易产生急速耐受；如给带有皮桥的犬服夏枯草。每日2次，每次2克/公斤，也可使血压有所下降；对肾性高血压犬，连续服药2周后，血压有中等程度之降低，停药后又恢复至原初水平。夏枯草茎、叶、穗及全草均有降压作用，穗之作用较弱。切断迷走神经后，夏枯草的降压作用显着减弱。对在位及离体兔心、离体蟾蜍心脏，均见有兴奋现象，均认为降压非由于对心脏的抑制所引起。在蟾蜍下肢灌流中，煎剂有扩张血管的作用。在用夏枯草的总无枫盐的用量与煎剂相当时，未出现明显的降压作用，其用量相当于煎剂一倍以上时，降压程度仅及煎剂的1/4～1/6；灌胃给药，虽降压作用出现较迟，但持续却较久，故认为夏枯草的降压与其中所含的无机盐无关。近年来有人对上述试验作了重复验证，测得夏枯草茎、叶的酊剂（30％醇）中含钾量即相当高，约83毫当量/毫升，穗中含量较少；口服对正常麻醉犬未出现明显降压作用；煎剂在除去其中无机盐后，降压作用即甚微，即夏枯草静脉注射，对麻醉动物的降压作用，不能排除其中所含的无机盐（主要是钾）的因素，故其降压成分及降压原理均有待研究。"}]},{"ID":"20240613123102-zmkeekr","Type":"NodeParagraph","Properties":{"id":"20240613123102-zmkeekr","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②抗菌作用"}]},{"ID":"20240613123102-s16qacw","Type":"NodeParagraph","Properties":{"id":"20240613123102-s16qacw","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"据体外初步试验，夏枯草煎剂对痢疾杆菌、伤寒杆菌、霍乱弧菌、大肠杆菌、变形杆菌、绿脓杆菌和葡萄球菌、链球菌有抑制作用，抗菌谱亦较广。其水浸剂（1：4）在试管内对某些常见的致病性皮肤真菌也有些抑制作用。对小鼠的实验性结核病，夏枯草可使肺部病变有所减轻。"}]},{"ID":"20240613123102-45w46el","Type":"NodeParagraph","Properties":{"id":"20240613123102-45w46el","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240613123102-jb4vsx1","Type":"NodeParagraph","Properties":{"id":"20240613123102-jb4vsx1","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"夏枯草煎剂（1：50～1：200）可使家兔离体子宫出现强直收缩。对离体兔肠，高浓度能增强蠕动。曾报告夏枯草煎剂能抑制小鼠S-160肿瘤及艾氏腹水癌的生长，但死亡率反较不给药组更高，故实为其毒性作用。"}]},{"ID":"20240613123102-dfgcufz","Type":"NodeParagraph","Properties":{"id":"20240613123102-dfgcufz","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613123102-b6yueqz","Type":"NodeParagraph","Properties":{"id":"20240613123102-b6yueqz","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 入肝、胆经。"}]},{"ID":"20240613123102-241x9s9","Type":"NodeParagraph","Properties":{"id":"20240613123102-241x9s9","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入肝。\""}]},{"ID":"20240613123102-n0txgsa","Type":"NodeParagraph","Properties":{"id":"20240613123102-n0txgsa","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足厥阴、少阳经。\""}]},{"ID":"20240613123102-0x6qn0p","Type":"NodeParagraph","Properties":{"id":"20240613123102-0x6qn0p","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613123102-8pf98yt","Type":"NodeParagraph","Properties":{"id":"20240613123102-8pf98yt","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒。"}]},{"ID":"20240613123102-ceho7gw","Type":"NodeParagraph","Properties":{"id":"20240613123102-ceho7gw","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦辛，寒。\""}]},{"ID":"20240613123102-zmulkx0","Type":"NodeParagraph","Properties":{"id":"20240613123102-zmulkx0","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613123102-rnzw9vy","Type":"NodeParagraph","Properties":{"id":"20240613123102-rnzw9vy","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味微苦，微辛。\""}]},{"ID":"20240613123102-iutp9eq","Type":"NodeParagraph","Properties":{"id":"20240613123102-iutp9eq","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613123102-rb4t6c5","Type":"NodeParagraph","Properties":{"id":"20240613123102-rb4t6c5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 脾胃虚弱者慎服。"}]},{"ID":"20240613123102-l07bdl1","Type":"NodeParagraph","Properties":{"id":"20240613123102-l07bdl1","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"土瓜为之使。\""}]},{"ID":"20240613123102-winmb0k","Type":"NodeParagraph","Properties":{"id":"20240613123102-winmb0k","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"气虚者禁用。\""}]},{"ID":"20240613123102-fn7gz39","Type":"NodeParagraph","Properties":{"id":"20240613123102-fn7gz39","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613123102-mlkpclt","Type":"NodeParagraph","Properties":{"id":"20240613123102-mlkpclt","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 清肝，散结。治瘰疬，瘿瘤，乳痈，乳癌，目珠夜痛，羞明流泪，头目眩晕，口眼歪斜，筋骨疼痛，肺结核，急性黄疸型传染性肝炎，血崩，带下。"}]},{"ID":"20240613123102-x2ptvdd","Type":"NodeParagraph","Properties":{"id":"20240613123102-x2ptvdd","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（1）清肝明目：用于肝热目赤肿痛，及肝阳上亢之头痛、目眩（如高血压病），可配苦丁茶、野菊花。"}]},{"ID":"20240613123102-nk4da2g","Type":"NodeParagraph","Properties":{"id":"20240613123102-nk4da2g","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（2）清热散结：用于乳腺炎、腮腺炎，可配柴胡、赤芍、浙贝母。用于瘰疬（如淋巴腺结核）、瘿瘤（如单纯性甲状腺肿大），常配牡蛎、浙贝母。"}]},{"ID":"20240613123102-bhaxiy7","Type":"NodeParagraph","Properties":{"id":"20240613123102-bhaxiy7","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热、瘰疬、鼠瘘、头疮，破症，散瘿结气，脚肿湿痹。\""}]},{"ID":"20240613123102-ittmo4f","Type":"NodeParagraph","Properties":{"id":"20240613123102-ittmo4f","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②《本草衍义补遗》：\"补养血脉。\""}]},{"ID":"20240613123102-vjpkpn3","Type":"NodeParagraph","Properties":{"id":"20240613123102-vjpkpn3","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"祛肝风，行经络，治口眼歪斜。行肝气，开肝郁，止筋骨疼痛、目珠痛，散瘰窃、周身结核。\""}]},{"ID":"20240613123102-nuz8f8d","Type":"NodeParagraph","Properties":{"id":"20240613123102-nuz8f8d","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"④《生草药性备要》：\"去痰消脓，治瘰疬，清上补下，去眼膜，止痛。\""}]},{"ID":"20240613123102-mz7p66g","Type":"NodeParagraph","Properties":{"id":"20240613123102-mz7p66g","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑤《本草从新》：\"治瘰疬、鼠瘘、瘿瘤、癥坚、乳痈、乳岩。\""}]},{"ID":"20240613123102-4bsufoc","Type":"NodeParagraph","Properties":{"id":"20240613123102-4bsufoc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑥《科学的民间药草》：\"有利尿杀菌作用。煎剂可洗创口，治化脓性外症，洗涤阴道，治阴户及子宫粘膜炎。\""}]},{"ID":"20240613123102-14urk2m","Type":"NodeParagraph","Properties":{"id":"20240613123102-14urk2m","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑦《现代实用中药》：\"为利尿药，对淋病、子宫病有效；并能治高血压，能使血压下降。\""}]},{"ID":"20240613123102-q4lud6g","Type":"NodeParagraph","Properties":{"id":"20240613123102-q4lud6g","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613123102-yyiw89f","Type":"NodeParagraph","Properties":{"id":"20240613123102-yyiw89f","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～5钱；熬膏或入丸、散。外用：煎水洗或捣敷。"}]},{"ID":"20240613123102-r2017m3","Type":"NodeParagraph","Properties":{"id":"20240613123102-r2017m3","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613123102-0twhntf","Type":"NodeParagraph","Properties":{"id":"20240613123102-0twhntf","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" ①治瘰疬马刀，不问已溃未溃，或日久成漏：夏枯草六两，水二钟，煎至七分，去滓，食远服。虚甚当煎浓膏服，并涂患处，多服益善。（《摄生众妙方》夏枯草汤）"}]},{"ID":"20240613123102-dbroxrn","Type":"NodeParagraph","Properties":{"id":"20240613123102-dbroxrn","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②治乳痈初起：夏枯草、蒲公英各等分。酒煎服，或作丸亦可。（《本草汇言》）"}]},{"ID":"20240613123102-pmzd7a6","Type":"NodeParagraph","Properties":{"id":"20240613123102-pmzd7a6","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"③治肝虚目睛疼，冷泪不止，筋脉痛，及眼羞明怕日：夏枯草半两，香附子一两，共为末。每服一钱，腊茶调下，无时。（《简要济众方》补肝散）"}]},{"ID":"20240613123102-mwa35vw","Type":"NodeParagraph","Properties":{"id":"20240613123102-mwa35vw","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"④治血崩不止：夏枯草为末。每服方寸匕，米饮调下。（《圣惠方》）"}]},{"ID":"20240613123102-z5611kv","Type":"NodeParagraph","Properties":{"id":"20240613123102-z5611kv","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑤治赤白带下：夏枯草花，开时采，阴干为末。每服二钱，食前米饮下。（《纲目》）"}]},{"ID":"20240613123102-0axq8w4","Type":"NodeParagraph","Properties":{"id":"20240613123102-0axq8w4","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑥治产后血晕，心气欲绝者：夏枯草捣绞汁，服一盏。（《纲目》）"}]},{"ID":"20240613123102-a3bb3v5","Type":"NodeParagraph","Properties":{"id":"20240613123102-a3bb3v5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑦治口眼歪斜：夏枯草一钱，胆南星五分，防风一钱，钓钩藤一钱。水煎，点水酒临卧时服。（《滇南本草》）"}]},{"ID":"20240613123102-0cqwrdm","Type":"NodeParagraph","Properties":{"id":"20240613123102-0cqwrdm","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑧治头目眩晕：夏枯草（鲜）二两，冰糖五钱。开水冲炖，饭后服。（《闽东本草》）"}]},{"ID":"20240613123102-o474xsp","Type":"NodeParagraph","Properties":{"id":"20240613123102-o474xsp","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑨治羊痫风、高血压：夏枯草（鲜）三两，冬蜜一两。开水冲炖服。（《闽东本草》）"}]},{"ID":"20240613123102-745b8b2","Type":"NodeParagraph","Properties":{"id":"20240613123102-745b8b2","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑩预防麻疹：夏枯草五钱至二两。水煎服，一日一剂，连服三天。（徐州《单方验方新医疗法选编》）"}]},{"ID":"20240613123102-ivqexoz","Type":"NodeParagraph","Properties":{"id":"20240613123102-ivqexoz","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑾治小儿菌痢：二岁以下，夏枯草一两，半枝莲五钱；二至六岁，夏枯草、半枝莲各一两；六至十二岁，夏枯草、半枝莲各一两半。水煎服。（《全展选编·传染病》）"}]},{"ID":"20240613123102-su45l0t","Type":"NodeParagraph","Properties":{"id":"20240613123102-su45l0t","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑿治急性扁桃体炎，咽喉疼痛：鲜夏枯草全草二至三两。水煎服。（《草医草药简便验方汇编》）"}]},{"ID":"20240613123102-a9mqwo2","Type":"NodeParagraph","Properties":{"id":"20240613123102-a9mqwo2","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⒀治扑伤金疮：夏枯草捣烂，罯上。（《卫生易简方》）"}]},{"ID":"20240613123102-5cl46cw","Type":"NodeParagraph","Properties":{"id":"20240613123102-5cl46cw","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⒁打伤、刀伤。把夏枯草在口中嚼碎后敷在伤处。"}]},{"ID":"20240613123102-n3oa459","Type":"NodeParagraph","Properties":{"id":"20240613123102-n3oa459","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⒂汗斑白点。用夏枯草煎成浓汁，每天洗患处。"}]},{"ID":"20240613123102-7tzg73t","Type":"NodeParagraph","Properties":{"id":"20240613123102-7tzg73t","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613123102-4pak7fo","Type":"NodeParagraph","Properties":{"id":"20240613123102-4pak7fo","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" ①治疗肺结核"}]},{"ID":"20240613123102-xwmc7b5","Type":"NodeParagraph","Properties":{"id":"20240613123102-xwmc7b5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"对浸润型、慢性纤维空洞型、血型播散型肺结核，均有一定疗效。取夏枯草2两，水煎分2～3次口服；或用夏枯草20斤加水煎至5000毫升时，加红糖2市斤收膏，早晚各服1次，每次8～15毫升，1个月为一疗程。服药后咳嗽、胸痛、咯痰、发烧、咯血等症状均见消失或减轻，病灶亦见不同程度的吸收好转。对肺结核咯血者，可用夏枯草1两，以黄酒2两加水适量浸泡，然后蒸至无酒味时过滤，成人每次20～40毫升，日服3～4次，有止血效果。"}]},{"ID":"20240613123102-gf9qzx7","Type":"NodeParagraph","Properties":{"id":"20240613123102-gf9qzx7","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②治疗渗出性胸膜炎"}]},{"ID":"20240613123102-orktdtz","Type":"NodeParagraph","Properties":{"id":"20240613123102-orktdtz","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"用夏枯草1斤，加水2000毫升，煎至1000～1200毫升，每次口服30～50毫升，日服3次，必要时配合其他对症治疗，但不加抗痨药物。治疗9例渗出性胸膜炎患者，除2例好转自动出院外，余均痊愈。平均住院35.6天，退热7.7天，积液吸收24.7天。"}]},{"ID":"20240613123102-56slo7r","Type":"NodeParagraph","Properties":{"id":"20240613123102-56slo7r","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"③治疗细菌性痢疾"}]},{"ID":"20240613123102-nu2mx0h","Type":"NodeParagraph","Properties":{"id":"20240613123102-nu2mx0h","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"取夏枯草2两，水浸10小时，文火煎2小时左右，每日4次分服，7日为一疗程。或取夏枯草干枯花穗制成100％流浸膏，小儿每岁每次1～2毫升，成人每次20～30毫升，日服2～3次。服药后平均3天退热；里急后重及大便次数平均4～6天消失或转为正常；腹痛及粘膜病变消失较慢，平均10天.服药期未发现副作用。"}]},{"ID":"20240613123102-93i336j","Type":"NodeParagraph","Properties":{"id":"20240613123102-93i336j","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"④治疗急性黄疸型传染性肝炎"}]},{"ID":"20240613123102-2f7o91g","Type":"NodeParagraph","Properties":{"id":"20240613123102-2f7o91g","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"以夏枯草为主治疗本病75例，其中62例达临床治愈标准。剂量及用法：每日用夏枯草2两，大枣l两，加水1500毫升，文火煨煎，捣枣成泥，煎取300毫升，去渣，3次分服。重症病例可酌增剂量。或每日用夏枯草2两，瘦肉2两（剔除脂肪），各加水1200毫升，分别煎煮一小时余，再将两者合并，用文火煨至300毫升，去渣，3次分服。一般均以30天为一疗程，必要时可停药2～3日后给第二疗程。治疗期间，可给维生素B、C及少量葡萄糖作为辅助治疗。患者的临床自觉症状消失或改善时间为2～14天；肝脾退缩时间为10～65天；黄疸消退时间为3～21天；各种絮状浊度试验的阴转时间为7～71天。治疗过程中未发现毒性作用。"}]},{"ID":"20240613123102-l8cmpeo","Type":"NodeParagraph","Properties":{"id":"20240613123102-l8cmpeo","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613123102-5yywdj2","Type":"NodeParagraph","Properties":{"id":"20240613123102-5yywdj2","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" ①朱震亨：\"《本草》言夏枯草大治瘰疬散结气。有补养厥阴血脉之功，而不言及。观其退寒热，虚者可使，若实者以行散之药佐之。外以艾灸，亦渐取效。\""}]},{"ID":"20240613123102-b04hm93","Type":"NodeParagraph","Properties":{"id":"20240613123102-b04hm93","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"黎居士《易简方》，夏枯草治目疼，用沙糖水浸一夜用，取其能解内热，缓肝火也.楼全善云，夏枯草治目珠疼至夜则甚者，神效，或用苦寒药点之反甚者，亦神效。盖目珠连目本，肝系也，属厥阴之经。夜甚及点苦寒药反甚者，夜与寒亦阴故也。夏枯禀纯阳之气，补厥阴血脉，故治此如神，以阳治阴也。\""}]},{"ID":"20240613123102-tj1mt4d","Type":"NodeParagraph","Properties":{"id":"20240613123102-tj1mt4d","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"夏枯草，补养厥阴血脉，又能疏通结气。目痛、瘰疬皆系肝症，故建神功。然久用亦防伤胃，与参、术同行，方可久服无弊。\""}]},{"ID":"20240613123102-jpnmsks","Type":"NodeParagraph","Properties":{"id":"20240613123102-jpnmsks","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"④《本草求真》：\"夏枯草，辛苦微寒。按书所论治功，多言散结解热，能愈一切瘰疬湿痹，目珠夜痛等症，似得以寒清热之义矣。何书又言气禀纯阳，及补肝血，得毋自相矛盾平?讵知气虽寒而味则辛，凡结得辛则散，其气虽寒犹温，故云能以补血也。是以一切热郁肝经等证，得此治无不效，以其得藉解散之功耳。若属内火，治不宜用。\""}]},{"ID":"20240613123102-o5jidj1","Type":"NodeParagraph","Properties":{"id":"20240613123102-o5jidj1","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑤《重庆堂随笔》：\"夏枯草，微辛而甘，故散结之中，兼有和阳养阴之功，失血后不寐者服之即寐，其性可见矣。陈久者其味尤甘，入药为胜。\""}]},{"ID":"20240613123102-3ybxysv","Type":"NodeParagraph","Properties":{"id":"20240613123102-3ybxysv","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"⑥《本草正义》：\"夏枯草之性，《本经》本言苦辛，并无寒字，孙氏问经堂本可证。而自《千金》以后，皆加一寒字于辛字之下，然此草夏至自枯，故得此名。丹溪谓其禀纯阳之气，得阴气而即死，观其主瘰疬，破癥散结，脚肿湿痹，皆以宣通泄化见长，必具有温和之气，方能消释坚凝，疏通窒滞，不当有寒凉之作用。石顽《逢原》改为苦辛温，自有至理，苦能泄降，辛能疏化，温能流通，善于宣泄肝胆木火之郁窒，而顺利气血之运行。凡凝痰结气，风寒痹着，皆其专职。\""}]},{"ID":"20240613123102-izbdwnj","Type":"NodeParagraph","Properties":{"id":"20240613123102-izbdwnj","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613123102-2khtojm","Type":"NodeParagraph","Properties":{"id":"20240613123102-2khtojm","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 西藏、云南尚以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"刚毛夏枯草"},{"Type":"NodeText","Data":"的花穗及果穗同等入药。"}]},{"ID":"20240613123102-lz4zjex","Type":"NodeParagraph","Properties":{"id":"20240613123102-lz4zjex","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613123102-7yas8lc","Type":"NodeParagraph","Properties":{"id":"20240613123102-7yas8lc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613123102-fgq4hkb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613123102-fgq4hkb","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"《中华本草》：夏枯草"}]},{"ID":"20240613123102-b78s84s","Type":"NodeParagraph","Properties":{"id":"20240613123102-b78s84s","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613123102-o07e421","Type":"NodeParagraph","Properties":{"id":"20240613123102-o07e421","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" Xià Kū Cǎo"}]},{"ID":"20240613123102-obdh8d8","Type":"NodeParagraph","Properties":{"id":"20240613123102-obdh8d8","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613123102-1ntpd34","Type":"NodeParagraph","Properties":{"id":"20240613123102-1ntpd34","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 夕句、乃东、燕面、麦夏枯、铁色草、棒柱头花、灯笼头、棒槌草、锣锤草、牛牯草、广谷草、棒头柱、六月干、夏枯头、大头花、灯笼草、古牛草、牛佤头、丝线吊铜钟"}]},{"ID":"20240613123102-h6me11u","Type":"NodeParagraph","Properties":{"id":"20240613123102-h6me11u","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613123102-p3xv8jb","Type":"NodeParagraph","Properties":{"id":"20240613123102-p3xv8jb","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" Fruit-spike of Common Selfheal, Common Selfheal Fruit- Spike"}]},{"ID":"20240613123102-yrtevfz","Type":"NodeParagraph","Properties":{"id":"20240613123102-yrtevfz","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613123102-9fiatqh","Type":"NodeParagraph","Properties":{"id":"20240613123102-9fiatqh","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240613123102-s8kh8eu","Type":"NodeParagraph","Properties":{"id":"20240613123102-s8kh8eu","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613123102-b6g04ni","Type":"NodeParagraph","Properties":{"id":"20240613123102-b6g04ni","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 药材基源：为唇形科植物夏枯草或长冠夏枯草的果穗。"}]},{"ID":"20240613123102-325hjm9","Type":"NodeParagraph","Properties":{"id":"20240613123102-325hjm9","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Prunella vulgaris L.2.Prunella asttica Nakai [P.uulgaris L.subsp. Asdiatica (Nakai) Hara]"}]},{"ID":"20240613123102-aaihsht","Type":"NodeParagraph","Properties":{"id":"20240613123102-aaihsht","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏枯草在每年5-6月，当花穗变成棕褐色时，选晴天，割起全草，捆成小把，或剪下花穗，晒干或鲜用。"}]},{"ID":"20240613123102-nv6fe85","Type":"NodeParagraph","Properties":{"id":"20240613123102-nv6fe85","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613123102-w5gknlj","Type":"NodeParagraph","Properties":{"id":"20240613123102-w5gknlj","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于荒地、路旁及山坡草丛中。"}]},{"ID":"20240613123102-lmr13g7","Type":"NodeParagraph","Properties":{"id":"20240613123102-lmr13g7","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北及山西、山东、灌输、浙江、安徽、江西等地。"}]},{"ID":"20240613123102-lq6vxzm","Type":"NodeParagraph","Properties":{"id":"20240613123102-lq6vxzm","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613123102-2rw9ieq","Type":"NodeParagraph","Properties":{"id":"20240613123102-2rw9ieq","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 多年生草本，茎高15-30cm。有匍匐地上的根状茎，在节上生须根。茎上升，下部伏地，自基部多分枝，钝四棱形，具浅槽，紫红色，被稀疏的糙毛或近无毛。叶对生，具柄；叶柄长0.7-2.5cm，自下部向上渐变短；叶片卵状长圆形或圆形，大小不等，长1.5-6am，宽0.7-2.5cm，先端钝，基部圆形、截形至宽楔形，下延至叶柄成狭隘翅，边缘不明显的波状齿或几近全缘。轮伞花序密集排列成顶生长2-4cm的假穗状花序，花期时较短，随后逐渐伸长；苞片肾形或横椭圆形，具骤尖头；花萼钟状，长达10mm，二唇形，上唇扁平，先端截平，有3个不明显的短齿，中齿宽大，下唇2裂，裂片披针形，果时花萼由于下唇2齿斜伸耐闭合；花冠紫、蓝紫或红紫色，长约13mm，略超出于萼，长绝不达萼长之2倍，下唇中裂片宽大，边缘具流苏状小裂片；雄蕊4，二强，花丝先端2裂，1裂片能育具花药，花药2室，室极叉开；子房无毛。小坚果黄褐色，长圆状卵形，长1.8mm，微具沟纹。花期4-6月，果期6-8月mm。"}]},{"ID":"20240613123102-23hpx24","Type":"NodeParagraph","Properties":{"id":"20240613123102-23hpx24","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"与夏枯草极相似，其不同点在于：植株较粗壮，花冠明显超出于萼很多，长约为萼长的2倍，达18-21mm。"}]},{"ID":"20240613123102-rwcgw0q","Type":"NodeParagraph","Properties":{"id":"20240613123102-rwcgw0q","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613123102-z6xzg41","Type":"NodeParagraph","Properties":{"id":"20240613123102-z6xzg41","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温和湿润气候，耐寒。对土壤要求不严，介以排水良好的砂质壤土栽培为宜，土壤粘重或低湿地不宜栽培。"}]},{"ID":"20240613123102-8g7n5uw","Type":"NodeParagraph","Properties":{"id":"20240613123102-8g7n5uw","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"栽培技术 种子繁残。7-8月播种，条播作1.3m，宽的畦，按行距27cm开横沟，深约6cm，播幅10cm，每1hm2用种量7500g。穴播，按行株距各23-27cm，开浅穴，每1hm2量4500g。"}]},{"ID":"20240613123102-cca8l7i","Type":"NodeParagraph","Properties":{"id":"20240613123102-cca8l7i","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"田间管理 当年出苗后，在10-11月除草、追肥1次，以人畜粪肥为主。每2年3月，再中耕除草、追肥1次。由于夏枯草收割后，老蔸又可再发，故在收获后，应中耕除草、追肥1次，冬季和第3年春季各再进行1次，又可收获，但栽种3-4年后，应抵达地另种。"}]},{"ID":"20240613123102-a2gdoj0","Type":"NodeParagraph","Properties":{"id":"20240613123102-a2gdoj0","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613123102-f7r9fbx","Type":"NodeParagraph","Properties":{"id":"20240613123102-f7r9fbx","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 性状鉴定：干燥果穗呈长圆柱形或宝塔形，长2.5-6.5cm，直径 1-1.5cm，棕色或淡紫褐色。宿萼数轮至十数轮，作覆瓦状排列，每轮有5-6个具短柄的宿萼，下方对生苞片2枚。苞片肾形，淡黄褐色，纵脉明显，基部楔形，先端尖尾状，背面生白色粗毛。宿萼唇形，上唇宽广，先端微3裂，下唇2裂，裂片尖三角形，外面有粗毛。花冠及雄蕊都已脱落。宿萼内有小坚果4枚，棕色，有光泽。体轻质脆，微有清香气，味淡。以色紫褐、穗大者为佳。"}]},{"ID":"20240613123102-tc3r3ie","Type":"NodeParagraph","Properties":{"id":"20240613123102-tc3r3ie","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"（2）长冠夏枯草 本品与夏枯草相亿，但花冠较长，18-221mm。"}]},{"ID":"20240613123102-dn2j8fd","Type":"NodeParagraph","Properties":{"id":"20240613123102-dn2j8fd","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：夏枯草 深棕色。①突破存花萼异形细胞，表面观细胞延长，垂周壁深波状弯曲，直径31-57μm，长约至121μm，非木化，有稀疏细小纹也，胞腔含淡黄色或黄棕色物。②非腺毛多碎断，完整者1-14细胞，单细胞者多见，呈三角锥形，长16-54μm，多细胞者常者常有1个或几个细胞缢缩，长约至2075μm，表面具细小疣状突起，有的胞腔内含黄色物。③苞片或萼片腺毛头部1-2细胞，单细胞者一边延长成钩状，胞腔内充满黄色分泌物；柄部1-2细胞。④腺鳞头部类圆形，4细胞，内含黄色分泌物。⑤中果皮石细胞表面观呈类长方形或类方形，垂壁波状弯曲，壁厚5-13μm，胞腔星状分枝，有的含黄色物。⑥果皮薄壁细胞，表面观呈类多角形，内含草酸钙砂晶。⑦种皮细胞表面观类长多角形，壁具细密弧形条网状增厚。⑧苞片表皮表面观细胞呈类多角形，垂周壁稍弯曲，表面有细密角质条纹，有的细胞含黄色或黄棕色物，表面质纹理不明显；气孔直轴式。此外，子叶细胞中含有脂肪油滴。"}]},{"ID":"20240613123102-9366pe7","Type":"NodeParagraph","Properties":{"id":"20240613123102-9366pe7","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613123102-lcj5q4s","Type":"NodeParagraph","Properties":{"id":"20240613123102-lcj5q4s","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 果穗含熊果酸（ursolic acid)[1，2]，齐墩果酸（oleanolic acid)，熊果酸及齐墩果酸为主要甙元的皂甙，胡萝卜甙（daucosterol)，β-香树脂醇（β-mayrin）和它的二十四烷酸（tetra-cosanic acid)、二十产烷酸（hexacosanic acid)，二十八烷酸（octa-cosanic acid)及三十烷酸（triacontanic acid)的酯[2]。"}]},{"ID":"20240613123102-hfcnsxi","Type":"NodeParagraph","Properties":{"id":"20240613123102-hfcnsxi","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"全草含具抗人免疫缺陷病毒（HIV）的酸性多粮夏枯草多糖（prunellin)[3]，还含齐墩果酸，熊果酸，齐墩果酸为甙元的皂甙[4]，芸香甙（rutin)，金丝桃甙（hyperoside)，咖啡酸（caffeic acid)[5]，维生素（vitamins)C、D，D胡萝卜素（carotene)，鞣质（tan-nin)，和物感（alkaloids)[6]及挥发油，其中含左旋樟脑（camphor)，右旋小茴香酮（fenchone)[7]。"}]},{"ID":"20240613123102-h0i6lro","Type":"NodeParagraph","Properties":{"id":"20240613123102-h0i6lro","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"地上部分含香豆精类化合物（coumarins)：伞形花内酯（um-bellifrone)，东犀草素（luteolin)，马栗树皮素（esculetin)[8]，黄酮类化合物：木犀草素（luteolin)，合模荭草素（homoorientin)又称异荭草素（isoorientin)，木犀草素-7-O-葡萄糖甙（cinaro-side)[9]，芸香甙，金比值桃甙，异槲皮甙（isoquercitrin)[10]。"}]},{"ID":"20240613123102-geesv9p","Type":"NodeParagraph","Properties":{"id":"20240613123102-geesv9p","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"花序含飞燕草素（delphinidin)和矢车菊素（cynidin)的糖甙[5]，报春花素-3，5-二葡萄糖甙（hirsutidin-，5-diglucoside)，槲皮素（quercitin)，山柰酚（kaempferol)[11]及挥发油，其中含右旋樟脑及石旋小茴香酮[7]。"}]},{"ID":"20240613123102-khd9yi5","Type":"NodeParagraph","Properties":{"id":"20240613123102-khd9yi5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"叶含多种脂肪酸：油酸（oleic acid)，亚麻酸（linolenic acid)，肉豆蔻酸（myristic acid)，棕榈酸（palmitic acid)，硬脂酸（steraric acid)及月挂酸（lauric acid)[12]。"}]},{"ID":"20240613123102-eryk27m","Type":"NodeParagraph","Properties":{"id":"20240613123102-eryk27m","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613123102-mtqiu9w","Type":"NodeParagraph","Properties":{"id":"20240613123102-mtqiu9w","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 1.降压作用：本品水浸出液、乙醇一水浸出液及30%乙醇浸出液，对麻醉动物有降压作用。犬静脉注射夏枯草煎剂100mg/kg，有明显降压作用，但易产生快速耐受现象，羊静脉注射l-1.5g的降压作用与犬相似，慢性带皮桥犬，每日2次，每次2g/kg 灌胃，亦有降压作用。肾型高血压犬，服药2周也有一定的降压作用，但停药后恢复原水平，亦有认为其降压作用与本品所含的无机盐有密切关系。"}]},{"ID":"20240613123102-dznf7fq","Type":"NodeParagraph","Properties":{"id":"20240613123102-dznf7fq","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"2.对免疫功能的影响：用本品注射剂皮下注射可使动物胸腺、脾脏明显萎缩，肾上腺明显增大；腹腔注射可使血浆皮质醇水平明显升高。病理检查可见胸腺皮质明显变薄，淋巴细胞变稀疏，脾脏可以见白髓较小，淋巴细胞较稀疏且与红髓分界模糊，还能使肾上腺皮质束状带细胞增大，血窦扩张。表明本品可能是一种免疫抑制剂，因而对某些由于免疫过程引起的病理损伤可能具有潜在的治疗意义。在长期、大量服用本品对防止机体免疫功能受到抑制。"}]},{"ID":"20240613123102-f11lf5v","Type":"NodeParagraph","Properties":{"id":"20240613123102-f11lf5v","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"3.降血糖作用：从夏枯草中提取的一种未鉴的化合物（暂名降糖素）。以降糖素50mg/kg皮下注射 给于小鼠，可明显抑制由四氧嘧啶损害所引起的小鼠血糖升高（P＜0.001）。其最低有效量为15mg/kg（小鼠）。作用强度为100mg降糖素相当于22.6u胰岛素。"}]},{"ID":"20240613123102-zb5ptka","Type":"NodeParagraph","Properties":{"id":"20240613123102-zb5ptka","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"4.抗菌、抗病毒作用：体外试验表明，本品煎剂对痢疾杆菌、伤寒杆菌、霍乱弧菌、大肠杆菌、变形杆菌、葡萄球菌及人型结核菌均有不同程度的抑制作用。其醇浸液在琼脂培养基上对绿脓杆菌有抑制作用。水浸液（1 ：4）在试管内对某些常见皮肤病致病真菌有不同程度的抑制作用。本品提取物体外有抗I型单纯疱疹病毒的作用。"}]},{"ID":"20240613123102-45zl7xn","Type":"NodeParagraph","Properties":{"id":"20240613123102-45zl7xn","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613123102-qvtw07k","Type":"NodeParagraph","Properties":{"id":"20240613123102-qvtw07k","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末1g，加乙醇15ml，加热回流1h，滤过。取滤液1ml，置蒸发皿内在水浴上蒸干，残潭加醋酐1滴使溶解，再加硫酸微量，显紫红色，后变暗绿色。（检查熊果酸）（2）取上述滤液少量，点于滤纸上，喷酒0.9%三氯化铁溶液与0.6%铁氰化钾溶液的等容混合液，即显蓝色斑点。（检查鞣质）（3）薄层色谱 取本品粉末10g，加水煎煮，水煎液加盐酸调至Ph2.0-3.0，以乙醚萃取，回收乙醚，残潭加乙醇0.2ml溶解，作供试品溶液。另取熊果酸乙醇为对照品溶液，分别点于同一硅胶G-CMC板上，以苯-乙酸乙酯（8：2）展开，取出，晾干，喷以醋酐-浓硫酸试液（1：1）显色，供度品色谱在与对照品色谱相联系应的位置上，显相同颜色的斑点。"}]},{"ID":"20240613123102-77twcxi","Type":"NodeParagraph","Properties":{"id":"20240613123102-77twcxi","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613123102-z4omb4p","Type":"NodeParagraph","Properties":{"id":"20240613123102-z4omb4p","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 归肝；胆经"}]},{"ID":"20240613123102-oeml52r","Type":"NodeParagraph","Properties":{"id":"20240613123102-oeml52r","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613123102-108jz5e","Type":"NodeParagraph","Properties":{"id":"20240613123102-108jz5e","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性寒"}]},{"ID":"20240613123102-cw2savf","Type":"NodeParagraph","Properties":{"id":"20240613123102-cw2savf","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613123102-uijusbg","Type":"NodeParagraph","Properties":{"id":"20240613123102-uijusbg","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 脾胃虚弱者慎服。"}]},{"ID":"20240613123102-c75rha0","Type":"NodeParagraph","Properties":{"id":"20240613123102-c75rha0","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：土瓜为之使。"}]},{"ID":"20240613123102-8f3owhc","Type":"NodeParagraph","Properties":{"id":"20240613123102-8f3owhc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"2.《得配本草》：气虚者禁用。"}]},{"ID":"20240613123102-c6apla5","Type":"NodeParagraph","Properties":{"id":"20240613123102-c6apla5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613123102-26jxbs6","Type":"NodeParagraph","Properties":{"id":"20240613123102-26jxbs6","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 清肝明目；散结解毒。主目亦羞明；目珠疼痛；头痛眩晕；耳鸣；瘰疬；瘿瘤；乳痈；痄腮；痈疖肿毒；急、慢性肝炎；高血压病"}]},{"ID":"20240613123102-so3xo41","Type":"NodeParagraph","Properties":{"id":"20240613123102-so3xo41","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613123102-h1v91nc","Type":"NodeParagraph","Properties":{"id":"20240613123102-h1v91nc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g，大剂量可用至30g；熬膏或入丸、散。久用：适量，煎水洗或捣敷。"}]},{"ID":"20240613123102-qi0e0s6","Type":"NodeParagraph","Properties":{"id":"20240613123102-qi0e0s6","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613123102-d03i10v","Type":"NodeParagraph","Properties":{"id":"20240613123102-d03i10v","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" ①治瘰疬马刀，不问已溃未溃，或日久成漏：夏枯草六两。水二钟，煎至七分，去滓，食远服。虚甚当煎浓膏服，并涂患处，多服益善。(《摄生众妙方》夏枯草汤)②治乳痈初起：夏枯草、蒲公英各等分。酒煎服，或作丸亦可。(《本草汇言》)③治肝虚目睛疼，冷泪不止，筋脉痛，及眼羞明怕日：夏枯草半两，香附子一两。共为末。每服一钱，腊茶调下，无时。(《简要济众方》补肝散)④治血崩不止：夏枯草为末。每服方寸匕，米饮调下。(《圣惠方》)⑤治赤白带下：夏枯草花，开时采，阴干为末。每服二钱，食前米饮下。(《纲目》)⑥治产后血晕，心气欲绝者：夏枯草捣绞汁，服一盏。(《纲目》)⑦治口眼歪斜：夏枯草一钱，胆南星五分，防风一钱，钓钩藤一钱。水煎，点水酒临卧时服。(《滇南本草》)⑧治头目眩晕：夏枯草(鲜)二两，冰糖五钱。开水冲炖，饭后服。(《闽东本草》)⑨治羊癎风、高血压：夏枯草(鲜)三两，冬蜜一两。开水冲炖服。(《闽东本草》)⑩预防麻疹：夏枯草五钱至二两。水煎服，一日一剂，连服三天。(徐州《单方验方新医疗法选编》)11.治小儿菌痢：一岁以下，夏枯草一两，半枝莲五钱；二至六岁，夏枯草、半枝莲各一两；六至十二岁，夏枯草、半枝莲各一两半。水煎服。(《全展选编·传染病》)12.治急性扁桃体炎，咽喉疼痛：鲜夏枯草全草二至三两。水煎服。(《草医草药简便验方汇编》)13.治扑伤金疮：夏枯草捣烂，罯上。(《卫生易简方》)"}]},{"ID":"20240613123102-rpoh0ta","Type":"NodeParagraph","Properties":{"id":"20240613123102-rpoh0ta","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613123102-mj1gjpi","Type":"NodeParagraph","Properties":{"id":"20240613123102-mj1gjpi","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 1.治疗肺结核：对浸润型、慢性纤维空洞型、血型播散型肺结核，均有一定疗效。取夏桔草2两，水煎分2-3次口服；或用夏枯草20斤加水煎至5000ml时，加红糖2市斤收膏，早晚各服1次，每次8-15ml， 1个月为一疗程。服药后咳嗽、胸痛、咯痰、发烧、咯血等症状均见消失或减轻，病灶亦见不同程度的吸收好转。对肺结核咯血者，可用夏枯草1两，以黄酒2两加水适量浸泡，然后蒸至无酒味时过滤，成人每次20-40ml，日服3-4次，有止血效果。"}]},{"ID":"20240613123102-yj3034q","Type":"NodeParagraph","Properties":{"id":"20240613123102-yj3034q","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"2.治疗渗出性胸膜炎：用夏枯草1斤，加水2000ml，煎至1000-1200ml，每次口服30-50ml，日服3次。必要时配合其他对症治疗，但不加抗痨药物。治疗9例渗出性胸膜炎患者，除2例好转自动出院外，余均痊愈。平均住院35.6天，退热7.7天，积液吸收24.7天。"}]},{"ID":"20240613123102-p0fr72d","Type":"NodeParagraph","Properties":{"id":"20240613123102-p0fr72d","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"3.治疗细菌性痢疾：取夏枯草2两，水浸10小时，文火煎2小时左右，每日4次分服，7日为一疗程。或取夏枯草干枯花穗制成100%流浸膏，小儿每岁每次1-2ml，成人每次20-30ml，日服2-3次。服药后平均3天退热；里急后重及大便次数平均4-6天消失或转为正常；腹痛及粘膜病变消失较慢，平均10天。服药期未发现副作用。"}]},{"ID":"20240613123102-8dm1rqs","Type":"NodeParagraph","Properties":{"id":"20240613123102-8dm1rqs","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"4.治疗急性黄疸型传染性肝炎：以夏枯草为主治疗本病75例，其中62例达临床治愈标准。剂量及用法：每日用夏枯草2两，大枣 1两，加水1500ml，文火煨煎，捣枣成泥，煎取300ml，去渣，3次分服。重症病例可酌增剂量。或每日用夏枯草2两，瘦肉2两(剔除脂肪)，各加水1200ml，分别煎煮一小时余，再将两者合并，用文火煨至300ml，去渣，3次分服。一般均以30天为一疗程，必要时可停药2-3日后给第二疗程。治疗期间，可给维生素 B、 C及少量葡萄糖作为辅助治疗。患者的临床自觉症状消失或改善时间为2-14天；肝脾退缩时间为10-65天；黄疸消退时间为3-31天；各种絮状浊度试验的阴转时间为7-71天。治疗过程中未发现毒性作用。"}]},{"ID":"20240613123102-gtfjszc","Type":"NodeParagraph","Properties":{"id":"20240613123102-gtfjszc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613123102-mbulkrr","Type":"NodeParagraph","Properties":{"id":"20240613123102-mbulkrr","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：补养血脉。"}]},{"ID":"20240613123102-otoqdv3","Type":"NodeParagraph","Properties":{"id":"20240613123102-otoqdv3","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"2.《滇南本草》：祛肝风，行经络。治口眼歪斜，行肝气，开肝郁，止筋骨疼痛，目珠痛，散瘰疬，周身结核。"}]},{"ID":"20240613123102-76ksu2l","Type":"NodeParagraph","Properties":{"id":"20240613123102-76ksu2l","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"3.《生草药性备要》：去痰消脓。治瘰疬，清上补下，去眼膜，止痛。"}]},{"ID":"20240613123102-a32zfbd","Type":"NodeParagraph","Properties":{"id":"20240613123102-a32zfbd","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"4.《本经》：主寒热、瘰疬、鼠瘘、头疮，破症，散瘿结气，脚肿湿痹。"}]},{"ID":"20240613123102-m955vdh","Type":"NodeParagraph","Properties":{"id":"20240613123102-m955vdh","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"5.《本草从新》：治瘰疬、鼠瘘、瘿瘤、症坚、乳痈、乳岩。"}]},{"ID":"20240613123102-pyy2btm","Type":"NodeParagraph","Properties":{"id":"20240613123102-pyy2btm","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"6.《科学的民间药草》：有利尿杀菌作用。煎剂可洗创口，治化脓性外症。洗涤阴道，治阴户及子宫粘膜炎。"}]},{"ID":"20240613123102-4jh2psq","Type":"NodeParagraph","Properties":{"id":"20240613123102-4jh2psq","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"7.《现代实用中药》：为利尿药。对淋病、子宫病有效；并能治高血压，能使血压下降。"}]},{"ID":"20240613123102-aygyqz8","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613123102-aygyqz8","updated":"20240613123102"},"Children":[{"ID":"20240613123102-u7cofpl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OC4=","Num":8},"Properties":{"id":"20240613123102-u7cofpl","updated":"20240613123102"},"Children":[{"ID":"20240613123102-hppsnkk","Type":"NodeParagraph","Properties":{"id":"20240613123102-hppsnkk","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"朱震亨：《本草》言夏枯草大治瘰疬散结气。有补养厥阴血脉之功，而不言及。观其退寒热，虚者可使，若实者以行散之药佐之。外以艾灸，亦渐取效。"}]}]}]},{"ID":"20240613123102-a3g8geu","Type":"NodeParagraph","Properties":{"id":"20240613123102-a3g8geu","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"9.《纲目》：黎居士《易简方》，夏枯草治目疼，用沙糖水浸一夜用，取其能解内热，缓肝火也。楼全善云，夏枯草治目珠疼至夜则甚者，神效，或用苦寒药点之反甚者，亦神效。盖目珠连目本，肝系也，属厥阴之经。夜甚及点苦寒药反甚者，夜与寒亦阴故也。夏枯禀纯阳之气，补厥阴血脉，故治此如神，以阳治阴也。"}]},{"ID":"20240613123102-wa3gson","Type":"NodeParagraph","Properties":{"id":"20240613123102-wa3gson","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"10.《本草通玄》：夏枯草，补养厥阴血脉，又能疏通结气。目痛、瘰疬皆系肝症，故建神功。然久用亦防伤胃，与参、术同行，方可久服无弊。"}]},{"ID":"20240613123102-vgg9neh","Type":"NodeParagraph","Properties":{"id":"20240613123102-vgg9neh","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"11.《本草求真》：夏枯草，辛苦微寒。按书所论治功，多言散结解热，能愈一切瘿疬湿痹，目珠夜痛等症，似得以寒清热之义矣。何书又言气禀纯阳，及补肝血，得毋自相矛盾乎?讵知气虽寒而味则辛，凡结得辛则散，其气虽寒犹温，故云能以补血也。是以一切热郁肝经等证，得此治无不效，以其得藉解散之功耳。若属内火；治不宜用。"}]},{"ID":"20240613123102-x3dikln","Type":"NodeParagraph","Properties":{"id":"20240613123102-x3dikln","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"12．《重庆堂随笔》：夏枯草，微辛而甘，故散结之中，兼有和阳养阴之功，失血后不寐者服之即寐，其性可见矣。陈久者其味尤甘，入药为胜。"}]},{"ID":"20240613123102-v6e82p5","Type":"NodeParagraph","Properties":{"id":"20240613123102-v6e82p5","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"13．《本草正义》：夏枯草之性，《本经》本言苦辛，并无寒字，孙氏问经堂本可证。而自《千金》以后，皆加一寒字于辛字之下，然此草夏至自枯，故得此名。丹溪谓其禀纯阳之气，得阴气而即死，观其主瘰疬，破症散结，脚肿湿痹，皆以宣通泄化见长，必具有温和之气，方能消释坚凝，疏通窒滞，不当有寒凉之作用。石顽《逢原》改为苦辛温，自有至理，苦能泄降，辛能疏化，温能流通，善于宣泄肝胆木火之郁窒，而顺利气血之运行。凡凝痰结气，风寒痹着，皆其专职。"}]},{"ID":"20240613123102-1twchnc","Type":"NodeParagraph","Properties":{"id":"20240613123102-1twchnc","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613123102-dfhc2xa","Type":"NodeParagraph","Properties":{"id":"20240613123102-dfhc2xa","updated":"20240613123102"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613123104-luwkkyi","Type":"NodeThematicBreak","Properties":{"id":"20240613123104-luwkkyi"}},{"ID":"20240613123105-pdtkczx","Type":"NodeParagraph","Properties":{"id":"20240613123105-pdtkczx"}}]}