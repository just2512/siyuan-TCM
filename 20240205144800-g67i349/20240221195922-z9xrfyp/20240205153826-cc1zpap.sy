{"ID":"20240205153826-cc1zpap","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153826-cc1zpap","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153826-cc1zpap\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206112707-vd20ufp\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613123105-pdtkczx\u0026quot;,\u0026quot;scrollTop\u0026quot;:3200,\u0026quot;focusId\u0026quot;:\u0026quot;20240702102734-igw0aif\u0026quot;,\u0026quot;focusStart\u0026quot;:5,\u0026quot;focusEnd\u0026quot;:5\u0026#125;","title":"311夏枯草","type":"doc","updated":"20240826125907"},"Children":[{"ID":"20240206112707-vd20ufp","Type":"NodeParagraph","Properties":{"id":"20240206112707-vd20ufp","updated":"20240206112714"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于江苏、安徽、河南等地。\n【性状】\t该品呈棒状，略扁，长1.58cm，直径0.81.5cm，淡棕色至棕红色。全穗由数轮至10数轮宿萼与苞片组成，每轮有对生苞片2 片，呈扇形，先端尖尾状，脉纹明显，外表面有白毛。每一苞片内有花3 朵，花冠多已脱落，宿萼二唇形，内有小坚果4枚，卵圆形，棕色，尖端有白色突起。体轻质脆，微有清香气，味淡。\n【性味】\t辛、苦，寒。\n【功效】\t清火明目，散结消肿。治目赤肿痛、头痛、瘰疬、瘿瘤、乳痈肿痛。"}]},{"ID":"20240206112707-pu62xc5","Type":"NodeParagraph","Properties":{"id":"20240206112707-pu62xc5","updated":"20240206112707"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206112707-v577hku.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205160114-js9kk1m","Type":"NodeParagraph","Properties":{"id":"20240205160114-js9kk1m","updated":"20240205160114"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草-20240205160114-0cr0wch.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826124657-fgxf25s","Type":"NodeParagraph","Properties":{"id":"20240826124657-fgxf25s","updated":"20240826124657"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 405px;","style":"width: 395px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草-20240826124657-b64zhzc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 395px;\" parent-style=\"width: 405px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 379px;","style":"width: 369px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草1-20240702102424-bdvoaze.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 369px;\" parent-style=\"width: 379px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 397px;","style":"width: 387px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/夏枯草2-20240702102433-ddc83id.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 387px;\" parent-style=\"width: 397px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826124848-4sjrvqv","Type":"NodeParagraph","Properties":{"id":"20240826124848-4sjrvqv","updated":"20240826130019"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 473px;","style":"width: 463px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"夏枯草7"