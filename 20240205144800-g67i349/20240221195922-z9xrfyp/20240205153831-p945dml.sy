Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240618105022-l5nmbfe.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 610px;","style":"width: 600px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄2-20240618112754-0vig0i6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 600px;\" parent-style=\"width: 610px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240618112746-zse790y","Type":"NodeParagraph","Properties":{"id":"20240618112746-zse790y","updated":"20240801142337"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 560px;","style":"width: 550px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄1-20240618112746-rqn9rqy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 550px;\" parent-style=\"width: 560px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 571px;","style":"width: 561px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄 2-20240801142337-5k4mgfc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 561px;\" parent-style=\"width: 571px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717171038-t58riv5","Type":"NodeParagraph","Properties":{"id":"20240717171038-t58riv5","updated":"20240801142702"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 662px;","style":"width: 652px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄 1-20240717171037-9hi0gr7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 652px;\" parent-style=\"width: 662px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 589px;","style":"width: 579px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄 3-20240801142701-wdyb4tl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 579px;\" parent-style=\"width: 589px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731131023-79t6jfj","Type":"NodeParagraph","Properties":{"id":"20240731131023-79t6jfj","updated":"20240801142309"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 603px;","style":"width: 593px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄-20240731131023-6szbec9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 593px;\" parent-style=\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 536px;","style":"width: 526px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄 1-20240801142309-6f32g0l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 526px;\" parent-style=\"width: 536px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619171906-zex30x6","Type":"NodeParagraph","Properties":{"id":"20240619171906-zex30x6","updated":"20240717170903"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 568px;","style":"width: 558px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄7-20240619171906-s5mvr01.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 558px;\" parent-style=\"width: 568px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 569px;","style":"width: 559px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"地黄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/地黄-20240717170835-099sqmj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 559px;\" parent-style=\"width: 569px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616082358-hvg815v","Type":"NodeThematicBreak","Properties":{"id":"20240616082358-hvg815v"}},{"ID":"20240616083622-30znx8e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083622-30znx8e","updated":"20240616083649"},"Children":[{"Type":"NodeText","Data":"干地黄《神农本草经》"}]},{"ID":"20240616083622-jfjkb06","Type":"NodeParagraph","Properties":{"id":"20240616083622-jfjkb06","updated":"20240616083622"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240616083622-d65dvoh","Type":"NodeParagraph","Properties":{"id":"20240616083622-d65dvoh","updated":"20240616083622"},"Children":[{"Type":"NodeText","Data":"主折跌绝筋，伤中，逐血痹，填骨髓，长肌肉，作汤，除寒热积聚，除痹，生者尤良。久服，轻身不老。一名地髓，生川泽。"}]},{"ID":"20240616083622-3yjg55c","Type":"NodeParagraph","Properties":{"id":"20240616083622-3yjg55c","updated":"20240616083622"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名苄，一名芑，生咸阳，黄土地者佳，二月八日采根阴干。"}]},{"ID":"20240616083622-3ludnkq","Type":"NodeParagraph","Properties":{"id":"20240616083622-3ludnkq","updated":"20240616083622"},"Children":[{"Type":"NodeText","Data":"案《说文》云：苄，地黄也，礼曰钘毛牛藿，羊苄，豕徽；《广雅》云：地髓，地黄也；《尔雅》云：苄，地黄；郭璞云：一名地髓，江东呼苄；《列仙传》云：吕尚服地髓。"}]},{"ID":"20240616082358-42agtp4","Type":"NodeThematicBreak","Properties":{"id":"20240616082358-42agtp4"}},{"ID":"20240616082436-wjf5ptm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082436-wjf5ptm","updated":"20240616082441"},"Children":[{"Type":"NodeText","Data":"干地黄《神农本草经百种录》"}]},{"ID":"20240616082436-ljgjihb","Type":"NodeParagraph","Properties":{"id":"20240616082436-ljgjihb","updated":"20240616082436"},"Children":[{"Type":"NodeText","Data":"味甘寒。主折跌绝筋，伤中，逐血痹，行血之功。填骨髓，血足能化精，而色黑归肾也。长肌肉。脾统血，血充则肌肉亦满矣。作汤，除寒热积聚，血充足则邪气散，血流动则凝滞消。除痹。血和利则经脉畅。生者尤良。血贵流行，不贵滋腻，故中古以前用熟地者甚少。久服，轻身不老。补血之功。"}]},{"ID":"20240616082436-ixl44ja","Type":"NodeParagraph","Properties":{"id":"20240616082436-ixl44ja","updated":"20240616082436"},"Children":[{"Type":"NodeText","Data":"地黄色与质皆类血，故入人身则专于补血。血补则阴气得和，而无枯燥拘牵之疾矣。古方只有干地黄、生地黄，从无用熟地黄者。熟地黄乃唐以后制法，以之加入温补肾经中药颇为得宜。若于汤剂及养血、凉血等方甚属不合。盖地黄专取其性凉而滑利流通，熟则腻滞不凉全失其本性矣。又仲景《伤寒》一百十三方，惟复脉用地黄。盖伤寒之病，邪从外入，最忌滋滞。即使用补，必兼疏拓之性者，方可入剂。否则邪气向里，必有遗害。今人一见所现之证，稍涉虚象，便以六味汤为常用之品，杀人如麻，可胜长叹。"}]},{"ID":"20240616082358-fgt5e6t","Type":"NodeThematicBreak","Properties":{"id":"20240616082358-fgt5e6t"}},{"ID":"20240616082359-9pwwryb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082359-9pwwryb","updated":"20240616082404"},"Children":[{"Type":"NodeText","Data":"干地黄《证类本草》"}]},{"ID":"20240616082359-kmn3mzq","Type":"NodeParagraph","Properties":{"id":"20240616082359-kmn3mzq","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"味甘、苦，寒，无毒。主折跌绝筋，伤中，逐血痹，填骨髓，长肌肉。作汤除寒热，积聚，除痹。主男子五劳七伤，女子伤中，胞漏，下血，破恶血，溺血，利大小肠，去胃中宿食，饱力断绝，补五脏内伤不足，通血脉，益气力，利耳目。生者尤良。"}]},{"ID":"20240616082359-0iicuum","Type":"NodeParagraph","Properties":{"id":"20240616082359-0iicuum","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"生地黄 大寒。主妇人崩中血不止及产后血上薄心闷绝，伤身胎动下血，胎不落，堕坠折，瘀血，留血，衄鼻，吐血，皆捣饮之。久服轻身不老。一名地髓，一名 ，一名芑。生咸阳川泽黄土地者佳。二月、八月采根，阴干。（得麦门冬、清酒良，恶贝母，畏芜荑。）"}]},{"ID":"20240616082359-3hducve","Type":"NodeParagraph","Properties":{"id":"20240616082359-3hducve","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶咸阳，即长安也。生渭城者乃有子实，实如小麦，淮南七精散用之。中间以彭城干地黄最好，次历阳，今用江宁板桥者为胜。作干者有法，捣汁和蒸，殊用工意。而此直云阴干，色味乃不相似，更恐以蒸为失乎？大贵时乃取牛膝、萎蕤作之，人不能别。《仙经》亦服食，要用其华；又善生根，亦主耳暴聋、重听。干者粘湿，作丸散用，须烈日曝之，既燥则斤两大减，一斤才得十两散尔，用之宜加量也。今按陈藏器本草云∶干地黄，《本经》不言生干及蒸干。方家所用二物别，蒸干即温补，生干则平宣，当根据此以用之。臣禹锡等谨按尔雅云∶ ，地黄。注云∶一名地髓，江东呼 （音怙）。药性论云∶干地黄，君。能补虚损，温中下气，通血脉。久服变白延年。治产后腹痛，主吐血不止。又云∶生地黄，忌三白，味甘，平，无毒。解诸热，破血，通利月水闭绝。不利水道，捣敷心腹，能消瘀血。病患虚而多热，加而用之。萧炳云∶干、生二种，皆黑须发良药。日华子云∶干地黄，助心胆气，安魂定魄，治惊悸劳劣，心肺损，吐血鼻衄，妇人崩中血晕，肋筋骨，长志。日干者平，火干者温，功用同前。又云∶生者水浸验，浮者名天黄，半浮半沉者名人黄，沉者名地黄，沉有力佳，半沉者次，浮者劣。煎忌铁器。"}]},{"ID":"20240616082359-utj7c04","Type":"NodeParagraph","Properties":{"id":"20240616082359-utj7c04","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"图经曰∶地黄，生咸阳川泽黄土地者佳，今处处有之，以同州为上，二月生叶，布地便出似车前，药上有皱纹而不光。高者及尺余，低者三、四寸。其花似油麻花而红紫色，亦有黄花者。其实作房如连翘，子甚细而沙褐色。根如人手指，通黄色，粗细长短不常。二月、八月采根，蒸三、二日，令烂，曝干，谓之熟地黄。阴干者是生地黄。种之甚易，根入土即生。"}]},{"ID":"20240616082359-pbxotiu","Type":"NodeParagraph","Properties":{"id":"20240616082359-pbxotiu","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"一说∶古称种地黄宜黄土，今不然，大宜肥壤虚地，则根大而多汁。其法∶以苇席圆编如车轮，径丈余，以壤土实苇席中为坛。坛上又以苇席实土为一级，比下坛径减一尺。如此数级如浮屠也。乃以地黄根节多者寸断之，莳坛上，层层令满，逐日以水灌之，令茂盛。至春秋分时，自上层取之，根皆长大而不断折，不被 伤故也。得根曝干之。熟干地黄最上出同州，光润而甘美。南方不复识，但以生地黄草烟熏使干黑，洗之煤尽仍白也。今干之法，取肥地黄三、二十斤净洗，更以拣去细根及根节瘦短者，亦得二、三十斤，捣绞取汁，投银、铜器中，下肥地黄浸漉令浃，饭上蒸三、四过，时时浸漉转蒸讫，又曝使汁尽。其地黄当光黑如漆，味甘如饴糖，须瓷器内收之，以其脂柔喜曝润也。又医家欲辨精粗，初采得以水浸，有浮者名天黄，不堪用；半沉者名人黄，为次；其沉者名地黄，最佳也。神仙方∶服食地黄，采取根净洗，捣绞取汁，煎令小稠，纳白蜜更煎，令可丸。晨朝酒送三十丸如梧子，日三．亦入青州枣肉同丸。又煎膏入干根末丸服。又四月采其实，阴干筛末，水服钱匕，其效皆等。其花名地髓花。延年方有单服二法。又，治伤折金疮，为最要之药。《肘后方∶》疗折，四肢骨破碎及筋伤蹉跌，烂捣生地黄熬之，裹所伤处，以竹简编夹之遍，急缚勿令转动，一日一夕，可以十易，则瘥。崔元亮《海上方》∶治一切心痛，无问新久，以生地黄一味，随人所食多少，捣绞取汁，搜面作 ，或冷淘食。良久当利，出虫长一尺许，头似壁宫，后不复患矣。昔有人患此病，三年不瘥，深以为恨，临终戒其家人，吾死后，当剖去病本，果得虫。置于竹节中，每所食皆饲之，因食地黄 ，亦与之，随即坏烂，由此得方，刘禹锡《传信方》亦纪其事云∶正元十年，通事舍人崔抗女患心痛垂气绝，遂作地黄冷淘食之，便吐一物，可方一寸以来，如蛤蟆状，无目、足等，微似有口，盖为此物所食，自此遂愈，食冷淘不用着盐。"}]},{"ID":"20240616082359-1msyufk","Type":"NodeParagraph","Properties":{"id":"20240616082359-1msyufk","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"雷公云∶采生地黄去白皮，瓷锅上柳木甑蒸之，摊令气歇，拌酒再蒸，又出令干。勿令犯铜铁器，令人肾消并白髭发，男损荣，女损卫也。食疗地黄，微寒。以少蜜煎，或浸食之，或煎汤，或入酒饮，并妙。生则寒，主齿痛，唾血，折伤。叶可以羹。外台秘要∶张文仲治骨蒸方∶生地黄一升，捣取汁，三度捣绞汁尽，分再服。若利即减之，以身体凉为度。千金方∶治牙齿根欲动脱。生地黄细锉，绵裹着齿上咂之，渍齿根，日三、四，并咽之。十日，大佳。"}]},{"ID":"20240616082359-cyis0x5","Type":"NodeParagraph","Properties":{"id":"20240616082359-cyis0x5","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"肘后方∶治耳中常鸣。生地黄截塞耳，数易之，以瘥为度。一云以纸裹微灰火中煨之用，良。"}]},{"ID":"20240616082359-28rmimy","Type":"NodeParagraph","Properties":{"id":"20240616082359-28rmimy","updated":"20240616082359"},"Children":[{"Type":"NodeText","Data":"百一方∶妊娠漏胎。生地黄汁一升，渍酒四合，煮三、五沸服之，不止又服。又方∶治 犬咬人，捣地黄汁饮之并涂疮口，百度止。梅师方∶治堕损筋骨，蹉跌骨碎破。捣生地黄熨热，裹三日夜，数易。若血聚，以针决之。又方∶治吐血神效方∶生地黄汁一升二合，白胶香二两，以瓷器盛入甑蒸，令胶消服。又方∶治乳痈。捣生地黄汁敷之，热即易之，无不见效也。食医心镜∶主劳瘦骨蒸，日晚寒热，咳嗽唾血。生地黄汁二合煮白粥，临熟入地黄汁搅令匀，空心食之。博济方治一切痈肿未破，疼痛，令内消。以生地黄杵如泥，随肿大小，摊于布上，掺木香末于中，又再摊地黄一重，贴于肿上，不过三、五度。孙兆方∶治鼻衄及膈上盛热。干地黄、龙脑、薄荷等分为末，冷水调下。子母秘录小儿患蛊毒痢。生地黄汁一升二合，分三、四服，立效。产宝∶妊娠下血如月信，通恐胎漏方∶干地黄、干姜等分为末，用酒调方寸匕。抱朴子∶楚文子服地黄八年，夜视有光，手上车弩。淮南子云∶地黄主属骨。"}]},{"ID":"20240616082414-acu4i66","Type":"NodeParagraph","Properties":{"id":"20240616082414-acu4i66","updated":"20240616082429"},"Children":[{"Type":"NodeText","Data":"衍义曰∶地黄，叶如甘露子，花如脂麻花，但有细斑点，北人谓之牛奶子。花、茎有微细短白毛。《经》只言干、生二种，不言熟者。如血虚劳热，产后虚热，老人中虚燥热，须地黄者，生与生干，常虑太寒，如此之类，故后世改用熟者。蒸曝之法∶以细碎者洗出，研取汁，将粗地黄蒸出曝干，投汁中，浸三、二时，又曝，再蒸，如此再过为胜，亦不必多。此等与干、生二种，功治殊别。陶但云捣汁和蒸，殊用工意，不显其法，不注治疗，故须悉言耳。"}]},{"ID":"20240616081812-f5nw5qw","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-f5nw5qw"}},{"ID":"20240616082225-hqgmvd6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082225-hqgmvd6","updated":"20240616082229"},"Children":[{"Type":"NodeText","Data":"生地黄《医学入门》"}]},{"ID":"20240616082225-42uq9ud","Type":"NodeParagraph","Properties":{"id":"20240616082225-42uq9ud","updated":"20240616082225"},"Children":[{"Type":"NodeText","Data":"生地黄寒甘苦味，滋肾凉心清肺胃，调脾养肝润二肠，妇人崩漏胎产治。"}]},{"ID":"20240616082225-hdh8xbb","Type":"NodeParagraph","Properties":{"id":"20240616082225-hdh8xbb","updated":"20240616082225"},"Children":[{"Type":"NodeText","Data":"水试浮者为天黄，半沉者为人黄，俱不用，沉重者为地黄，最胜。无毒。沉而降，阴也。入手太阳、少阴，足少阴本药也。滋肾水，真阴不足，劳瘦骨蒸，日晡寒热，唾血，耳鸣，凉心火血热，五心潮烦，惊悸。"}]},{"ID":"20240616082225-peaxil1","Type":"NodeParagraph","Properties":{"id":"20240616082225-peaxil1","updated":"20240616082225"},"Children":[{"Type":"NodeText","Data":"清肺热咳嗽，鼻衄，泻脾胃湿热，吐血，牙痛欲脱。丹溪云∶生地较之熟地更宣通不滞。劳倦伤脾者，以实脾药中用二三分，以固脾气，使脾家永不受邪，盖湿热去而脾胃自固。所以本草曰∶除寒热积聚，去胃中宿食，养肝血，益胆气。主折伤绝筋伤中，逐血痹，明眼目，利大小二肠，治便血溺血。老人津枯便燥者必用之。女子崩中血不止，胎动胎漏，产后血上泊心闷绝。大抵补五脏，通血脉，益气力，虚而多热加而用之。多用恐倒脾胃，中虚寒者禁用。生采者大寒，日干者微寒，火干者微温。脉洪实热者，生采捣汁服之；脉虚血热者，用姜汁拌炒，免致泥膈痰。得门冬、清酒良，恶贝母，畏芜荑。若犯铜铁器，令消肾白发，男伤荣，女损卫。又合萝卜食，则能耗诸血。"}]},{"ID":"20240616082047-onkyjyj","Type":"NodeThematicBreak","Properties":{"id":"20240616082047-onkyjyj"}},{"ID":"20240616082215-ne0i21e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082215-ne0i21e","updated":"20240616082219"},"Children":[{"Type":"NodeText","Data":"生地黄《汤液本草》"}]},{"ID":"20240616082215-vsl8oar","Type":"NodeParagraph","Properties":{"id":"20240616082215-vsl8oar","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"气寒，味苦，阴中之阳。甘、苦，大寒。无毒。"}]},{"ID":"20240616082215-zzyzbbq","Type":"NodeParagraph","Properties":{"id":"20240616082215-zzyzbbq","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"入手太阳经、少阴经之剂。"}]},{"ID":"20240616082215-9cm2g6i","Type":"NodeParagraph","Properties":{"id":"20240616082215-9cm2g6i","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"《象》云∶凉血补血，补肾水真阴不足。此药大寒，宜斟酌用之，恐损胃气。"}]},{"ID":"20240616082215-lf9acfl","Type":"NodeParagraph","Properties":{"id":"20240616082215-lf9acfl","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"《珍》云∶生血凉血。"}]},{"ID":"20240616082215-u4y4o8n","Type":"NodeParagraph","Properties":{"id":"20240616082215-u4y4o8n","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主妇人崩中血不止，及产后血上薄心闷绝，伤身胎动下血，胎不落，堕坠折，瘀血留血，衄鼻吐血，皆捣饮之。"}]},{"ID":"20240616082215-uuv80wx","Type":"NodeParagraph","Properties":{"id":"20240616082215-uuv80wx","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"《液》云∶手少阴，又为手太阳之剂，故钱氏泻丙与木通同用，以导赤也。诸经之血热与他药相随，亦能治之，溺血便血亦治之，入四散例。"}]},{"ID":"20240616082215-z5otkcn","Type":"NodeParagraph","Properties":{"id":"20240616082215-z5otkcn","updated":"20240616082215"},"Children":[{"Type":"NodeText","Data":"《心》云∶苦甘，阴中微阳，酒浸上行、外行。生血，凉血去热。恶贝母，畏芜荑。"}]},{"ID":"20240616082048-lm5ajvt","Type":"NodeThematicBreak","Properties":{"id":"20240616082048-lm5ajvt"}},{"ID":"20240616082132-6j89jkd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082132-6j89jkd","updated":"20240616082136"},"Children":[{"Type":"NodeText","Data":"生地黄《本经逢原》"}]},{"ID":"20240616082132-mr79w6d","Type":"NodeParagraph","Properties":{"id":"20240616082132-mr79w6d","updated":"20240616082201"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名地髓，又名苄"},{"Type":"NodeTextMark","TextMarkType":"em strong","TextMarkTextContent":","},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 音户"}]},{"ID":"20240616082132-tjb4vbl","Type":"NodeParagraph","Properties":{"id":"20240616082132-tjb4vbl","updated":"20240616082132"},"Children":[{"Type":"NodeText","Data":"甘苦寒，无毒。禁犯铁，忌莱菔、诸血。"}]},{"ID":"20240616082132-v6aqviw","Type":"NodeParagraph","Properties":{"id":"20240616082132-v6aqviw","updated":"20240616082132"},"Children":[{"Type":"NodeText","Data":"采得鲜者即用为生地黄，炙焙干收者为干地黄，以法制过者为熟地黄。"}]},{"ID":"20240616082132-y7yoxb7","Type":"NodeParagraph","Properties":{"id":"20240616082132-y7yoxb7","updated":"20240616082132"},"Children":[{"Type":"NodeText","Data":"《本经》主伤中，逐血痹，填骨髓，长肌肉，作汤除寒热积聚，疗折跌伤筋，久服轻身不老。生者尤良。"}]},{"ID":"20240616082132-sg5vpjm","Type":"NodeParagraph","Properties":{"id":"20240616082132-sg5vpjm","updated":"20240616082132"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"生地黄性禀至阴，功专散血，入手足少阴、厥阴，兼行足太阴、手太阳。钱仲阳导赤散与木通同用，泻丙丁之火。《别录》治妇人崩中血不止，及产后血上薄心，胎动下血，鼻衄吐血，皆捣汁饮之，以其能散血消瘀解烦也。其治跌扑损伤，面目青肿，以生地黄捣烂罨之即消。此即《本经》治伤中血痹、折跌筋伤等证之义。盖肝藏血而主筋，肝无留滞则营血调，而伤中自愈，筋无邪着则三气通，而血痹自除。作汤除寒热积聚者，血和则结散，而诸证平矣。其曰填骨髓、长肌肉者，邪无着而形神自复也。昔人治心痛，以生地黄汁作冷淘，食之取吐，不吐则利出长虫，如辟宫而安，此即《本经》除寒热积聚之验。其于服食方中用之，取以辅助诸药，辟除三虫，使从幽门化出也。因思《千金》灵飞散中生地黄急不可得鲜者，咸取干者应用，乃知《本经》末后续出生者尤良一语，见古圣之苦心，无所不用其极也。愚按∶生地黄与干地黄功用不同，岂可混论。按∶徐之才《别录》云∶生地黄乃新掘之鲜者，为散血之专药。观《本经》主治皆指鲜者而言，只缘诸家《本草》从未明言，且产处辽远，药肆仅有干者，鲜者绝不可得，是不能无混用之失。曷知干地黄既经炙焙，力能止血，安有伤中血痹，折跌筋伤等治乎。至于伤中日久，积聚内形，寒热外显，并宜鲜者作汤统领他药，共襄破宿生新之功。设混用干者则瘀伤愈结，安望其有髓充肉长之绩乎。予尝综览诸方，凡药之未经火者，性皆行散，已经炙焙，性皆守中，不独地黄为然也。"}]},{"ID":"20240616082048-h5i3p39","Type":"NodeThematicBreak","Properties":{"id":"20240616082048-h5i3p39"}},{"ID":"20240616082122-riqpxku","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082122-riqpxku","updated":"20240616082126"},"Children":[{"Type":"NodeText","Data":"生地黄《本草求真》"}]},{"ID":"20240616082122-0akjom9","Type":"NodeParagraph","Properties":{"id":"20240616082122-0akjom9","updated":"20240616082122"},"Children":[{"Type":"NodeText","Data":"（隰草）解热"}]},{"ID":"20240616082122-91xlyph","Type":"NodeParagraph","Properties":{"id":"20240616082122-91xlyph","updated":"20240616082122"},"Children":[{"Type":"NodeText","Data":"生地黄（专入心肝肾。兼入小肠）。性未蒸焙。掘起即用。甘苦大寒。故书皆载其性鲜补。但入手少阴心足少阴肾足厥阴肝。并足太阴脾手太阳小肠。力专清热。消瘀。（钱仲阳导赤散。生地与木通同用。能泻丙丁之火。别录治妇人崩中血不止。及产后血上薄心。胎动下血。鼻衄吐血。皆捣汁饮之。）故凡吐血咯血。衄血畜血溺血。崩中带下。审其症果因于热成者。无不用此调治。（血出于鼻。是由清道。血出于口。是出浊道。血出于咳于衄。是由于肺。血见于呕。是出于肝。血见于吐。是出于胃。血由痰涎而带。是出于脾。血见于咯。是出于心。血见于唾。是出于肾。血由耳出。其名曰 。血由鼻出。其名曰衄。血由肌肤而出。其名曰血汗。血由口鼻俱出。其名曰大衄。皆当详其虚实以治。）并或伤寒阳强。痘症毒盛血燥。与折跌伤筋而见血瘀血痹之症者。无不采其同入。以为活血生新之用。第书有言服此长肉生肌。止是热除血活以后长养之语。久服轻身不老。止是病去身安力健之词。未可因此认为辟谷成仙属实也。若使血因寒滞。而犹用以生地。不更使寒益甚。而血愈出不返乎！掘生肥大者。洗净捣汁以饮。或用酒制。以免伤胃。忌铁。"}]},{"ID":"20240616082048-s3hx6wi","Type":"NodeThematicBreak","Properties":{"id":"20240616082048-s3hx6wi"}},{"ID":"20240616082100-h3oxbhk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082100-h3oxbhk","updated":"20240616082106"},"Children":[{"Type":"NodeText","Data":"生地黄《药鉴》"}]},{"ID":"20240616082100-plblx6p","Type":"NodeParagraph","Properties":{"id":"20240616082100-plblx6p","updated":"20240616082100"},"Children":[{"Type":"NodeText","Data":"气寒，味甘苦，无毒，气薄味浓，沉也，阴中阳也。性虽大寒，较熟地则犹宣通而不泥膈，故能凉心火之血热，泻脾土之湿热，止鼻中之衄热，除五心之烦热。其或虚而生热者，不可多用，以性大寒故也。惟劳倦伤脾热者当用，以脾经大络之血损也。女人崩中血不止，产后血上攻心，胎动下血，老人津液枯绝，大肠燥结不润者，皆当用之。又实脾药中用二三分，以固脾气，使脾家永不受邪，但不可多用，以大寒恐倒脾气也。或用姜汁炒，或用醇酒洗，或用砂仁酒浸，皆制其寒性，免泥滞也。忌铁器。痘家血热之症，宜用之以凉血解毒，便滑者禁用。"}]},{"ID":"20240616082048-kk1tkle","Type":"NodeThematicBreak","Properties":{"id":"20240616082048-kk1tkle"}},{"ID":"20240616082050-zg3d1lb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082050-zg3d1lb","updated":"20240616082054"},"Children":[{"Type":"NodeText","Data":"生地黄《本草备要》"}]},{"ID":"20240616082050-o8jm5y2","Type":"NodeParagraph","Properties":{"id":"20240616082050-o8jm5y2","updated":"20240616082050"},"Children":[{"Type":"NodeText","Data":"大泻火"}]},{"ID":"20240616082050-o01dcoo","Type":"NodeParagraph","Properties":{"id":"20240616082050-o01dcoo","updated":"20240616082050"},"Children":[{"Type":"NodeText","Data":"甘苦大寒，入心肾。泻丙火（小肠为丙火，心与小肠相表里，导赤散与木通同用），清燥金（胃、大肠火），消瘀通经，平诸血逆。治吐衄崩中（唾血者，血随唾出；咯血者，随痰咯出，或带血丝，出肾经及肺经。自两胁逆上吐出者，属肝经。衄血者，血溢于脑，从鼻而出；咳血者，咳出痰内有血，并属肺经。吐出呕出成盆成碗者，属胃经。经漏不止曰崩，血热则妄行，宜以此凉之。虚人忌用，用于干地黄可也），伤寒阳强，痘症大热（痘症用之甚多，本草未载）。多服损胃。"}]},{"ID":"20240616082050-1pz80jh","Type":"NodeParagraph","Properties":{"id":"20240616082050-1pz80jh","updated":"20240616082050"},"Children":[{"Type":"NodeText","Data":"生掘鲜者，捣汁饮之，或用酒制，则不伤胃。生则寒，干则凉，热则温（故分为三条，以便施用）。"}]},{"ID":"20240616081812-wafr5i2","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-wafr5i2"}},{"ID":"20240616082037-3ta2gaa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082037-3ta2gaa","updated":"20240616082042"},"Children":[{"Type":"NodeText","Data":"地黄《本草纲目》"}]},{"ID":"20240616082037-fvt933t","Type":"NodeParagraph","Properties":{"id":"20240616082037-fvt933t","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"「释名」亦名（音户）、芑（音起）、地髓。"}]},{"ID":"20240616082037-y7npdig","Type":"NodeParagraph","Properties":{"id":"20240616082037-y7npdig","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"「气味」（生地黄）甘、寒、无毒。（熟地黄）甘、微苦、微温、无毒。"}]},{"ID":"20240616082037-5c4mogu","Type":"NodeParagraph","Properties":{"id":"20240616082037-5c4mogu","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616082037-vppc9ip","Type":"NodeParagraph","Properties":{"id":"20240616082037-vppc9ip","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"1、吐血唾血，补虚、除热，去痈疖。用生地黄不拘多少，三捣三压，取全部液汁，装瓦器中，盖严，在热水中熬浓，去渣再煎成糖稀状，做成丸子，如弹子大。每服一丸，温酒送下。一天服二次。此方名“地黄煎”。"}]},{"ID":"20240616082037-hsofe4i","Type":"NodeParagraph","Properties":{"id":"20240616082037-hsofe4i","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"2、利血生精。用地黄（切）二合，与米同煮，熟后以酥二合、蜜一合同炒香放入，再煮熟食下。此方名“地黄粥”。"}]},{"ID":"20240616082037-m821lw6","Type":"NodeParagraph","Properties":{"id":"20240616082037-m821lw6","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"3、明目补肾。用生、熟地黄各二两，川椒红一两，共研为末，加蜜和成丸子，如梧子大。每服三十丸，空心服，盐汤送下。"}]},{"ID":"20240616082037-12hp3zg","Type":"NodeParagraph","Properties":{"id":"20240616082037-12hp3zg","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"4、虚损（或大病后，或积劳后，四休沉滞，骨肉酸痛，呼吸力少，或小腹拘急，咽干唇燥，饮食无味，多卧少起）。用生地黄二斤，面一斤，捣烂炒干炒末。每服一匙，空心服，酒送下。一天服三次。"}]},{"ID":"20240616082037-jg7jz3z","Type":"NodeParagraph","Properties":{"id":"20240616082037-jg7jz3z","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"5、病后虚汗（口干心躁）。用熟地黄五两，加水三碗煎成一碗半，分三次服，一天服完。"}]},{"ID":"20240616082037-rwysxen","Type":"NodeParagraph","Properties":{"id":"20240616082037-rwysxen","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"6、咳嗽唾血，痈疽劳瘵。用生地黄汁十六斤、人参末一斤半、白茯苓末三斤、白沙蜜十斤，拌匀，小火熬三昼夜，成膏。每服一匙，开水或酒送下。此方名“玉膏”。"}]},{"ID":"20240616082037-lozfcmo","Type":"NodeParagraph","Properties":{"id":"20240616082037-lozfcmo","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"7、吐血便血。用地黄汁六合，铜器煮开，加牛皮胶一两，等化尽后再加姜汁半杯。分三次服完。"}]},{"ID":"20240616082037-epv6k53","Type":"NodeParagraph","Properties":{"id":"20240616082037-epv6k53","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"8、小便带血、吐血、耳鼻出血。用生地黄汁半升、生姜汁半合、蜜一合，调匀服。"}]},{"ID":"20240616082037-yw54kp2","Type":"NodeParagraph","Properties":{"id":"20240616082037-yw54kp2","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"9、月经不止。用生地黄汁一碗，加酒一碗煎服。一天服两次。"}]},{"ID":"20240616082037-sv99521","Type":"NodeParagraph","Properties":{"id":"20240616082037-sv99521","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"10、月经不调，久不受孕。用熟地黄半斤、当归二两、黄连一两，在酒中泡一夜，取出焙干研细为末，加炼蜜做成丸子，如梧子大。每服七十丸，米汤或温酒送下。;11、妊娠漏胎，下血不止。用生地黄汁一升，泡在酒四合中，煮开几次后服下，不止再服。又方：用生地黄为末，酒冲服一匙，昼夜各服一次。又方：用生地黄、熟地黄，等分为末。每服半两，空心服，白术、枳壳煎汤调下，每日服二次。此方名“二黄丸”。"}]},{"ID":"20240616082037-puwx34x","Type":"NodeParagraph","Properties":{"id":"20240616082037-puwx34x","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"12、妊娠胎动。用生地黄捣汁，煎开，加鸡蛋白一枚，搅匀服下。"}]},{"ID":"20240616082037-3w22q2d","Type":"NodeParagraph","Properties":{"id":"20240616082037-3w22q2d","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"13、产生血痛（腹中有硬块作痛）。有熟地黄一斤、陈生姜半斤，同炒干为末。每服二钱，温酒调下。此方名“黑神散”。"}]},{"ID":"20240616082037-3akxvc0","Type":"NodeParagraph","Properties":{"id":"20240616082037-3akxvc0","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"14、产后中风。用生地黄五两，捣出汁，生姜五两，也捣成汁。以生地黄渣浸姜汁中，生姜渣浸生地黄汁中，过一夜。次日取两药炒黄，焙干，研细。每服一匙，酒送下。"}]},{"ID":"20240616082037-gs13n2m","Type":"NodeParagraph","Properties":{"id":"20240616082037-gs13n2m","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"15、胞衣不出。用生地黄汁一升，苦酒三合，调匀温服。"}]},{"ID":"20240616082037-iqugz9y","Type":"NodeParagraph","Properties":{"id":"20240616082037-iqugz9y","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"16、热闷昏迷。用生地黄汁一碗灌下。如大渴饮水不止，则用生地黄根、生薄荷叶等分捣烂，榨取汗，加麝香不许，冷水调服。觉心下顿凉，即不再服药。"}]},{"ID":"20240616082037-9t7yp2f","Type":"NodeParagraph","Properties":{"id":"20240616082037-9t7yp2f","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"17、疔肿乳痈。用生地黄捣烂敷患处，药变热，即须更换。"}]},{"ID":"20240616082037-9zibmz1","Type":"NodeParagraph","Properties":{"id":"20240616082037-9zibmz1","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"18、跌打损伤，瘀血在腹。用生地黄汁三升，加酒一升半，共四升半煮成二升半，分三次服完。"}]},{"ID":"20240616082037-91thuxs","Type":"NodeParagraph","Properties":{"id":"20240616082037-91thuxs","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"19、眼睛红痛。用生地黄、黑豆各二两，捣成膏，临卧时先以盐汤洗眼，再以药膏涂盖在眼皮上。次日晨，用水把药膏浸湿、洗掉。"}]},{"ID":"20240616082037-zf38p76","Type":"NodeParagraph","Properties":{"id":"20240616082037-zf38p76","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"20、牙疳脓血。用生地黄一斤、盐二合，共捣成团，外用面裹住，投火中烧焦，剥出面壳，药中加麝香一分，研匀，贴患处。"}]},{"ID":"20240616082037-157lyk2","Type":"NodeParagraph","Properties":{"id":"20240616082037-157lyk2","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"21、牙齿动摇。用棉裹生地黄放口中细嚼，令药汁作用于齿根，最后将汁涸下。"}]},{"ID":"20240616082037-z4l1kd1","Type":"NodeParagraph","Properties":{"id":"20240616082037-z4l1kd1","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"22、耳中常鸣。用生地黄一截塞耳中，一天换几次。生地黄煨熟塞耳更好。"}]},{"ID":"20240616082037-z48l8m0","Type":"NodeParagraph","Properties":{"id":"20240616082037-z48l8m0","updated":"20240616082037"},"Children":[{"Type":"NodeText","Data":"23、犬咬伤。用地黄捣汁涂伤处。"}]},{"ID":"20240616081812-1snqyb3","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-1snqyb3"}},{"ID":"20240616082027-g4ce16p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082027-g4ce16p","updated":"20240616082031"},"Children":[{"Type":"NodeText","Data":"地黄《神农本草经读》"}]},{"ID":"20240616082027-3i8jgg1","Type":"NodeParagraph","Properties":{"id":"20240616082027-3i8jgg1","updated":"20240616082027"},"Children":[{"Type":"NodeText","Data":"气味甘、寒，无毒。主折跌绝筋，伤中，逐血痹，填骨髓，长肌肉。作汤除寒热积聚，除痹。生者尤良。久服轻身不老。"}]},{"ID":"20240616082027-x28x8d7","Type":"NodeParagraph","Properties":{"id":"20240616082027-x28x8d7","updated":"20240616082027"},"Children":[{"Type":"NodeText","Data":"（参叶天士）地黄气寒，入足少阴肾经。味甘无毒，入足太阴脾经。气味重浊，阴也；阴者，中之守也；伤中者，守中真阴伤也。地黄甘寒，补中焦之精汁，所以主之。血痹者，血虚闭而不运也。地黄味甘以滋脾血，气寒以益肾气，气血行而闭者开矣。肾主骨，益肾则水足而润脾则土滋而肌肉丰也。作汤除寒热积聚者，汤者荡也，或寒或热之积聚，汤能荡之也。盖味甘可以缓急，性滑可以去着也。又曰∶除痹者，言不但逐血痹，更除皮肌筋骨之痹也。除皮肉筋骨之痹，则折跌绝筋亦可疗矣。久服轻身不老，以先后二天交换，元气与谷气俱纳也。生者尤良，谓其本性俱在也。"}]},{"ID":"20240616082027-sjxbbth","Type":"NodeParagraph","Properties":{"id":"20240616082027-sjxbbth","updated":"20240616082027"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶地黄，《本经》名地髓，《尔雅》名，又名芑。唐以后几蒸几晒为熟地黄，苦味尽除，入于温补肾经丸剂，颇为相宜；若入汤剂及养血凉血等方，甚属不合。盖地黄专取其性凉而滑利流通，熟则腻滞不凉，全失其本性矣。徐灵胎辨之甚详，无如若辈竟执迷不悟也。"}]},{"ID":"20240616082027-1g4pvsf","Type":"NodeParagraph","Properties":{"id":"20240616082027-1g4pvsf","updated":"20240616082027"},"Children":[{"Type":"NodeText","Data":"又曰∶百病之极，穷必及肾。及肾，危证也。有大承气汤之急下法，有桃花汤之温固法，有四逆汤、白通汤之回阳法，有猪苓汤、黄连鸡子黄汤之救阴法，有真武汤之行水法，有附子汤之温补法，皆所以救其危也。张景岳自创邪说，以百病之生，俱从肾治。误以《神农本经》上品服食之地黄，认为治病之药。（《内经》云∶五谷为养，五果为助，五菜为充，毒药攻邪。神农所列上品，多服食之品，即五谷、五果、五菜之类也，玩“久服”二字可见。圣人药到病瘳，何以云久服？凡攻邪以去病，多取毒药。）滋润胶粘，反引邪气敛存于少阴而无出路，以后虽服姜、附不热，服芩、连不寒，服参、术不补，服硝、黄不下，其故何哉？盖以熟地黄之胶粘善着。女人有孕服四物汤为主，随证加入攻破之药而不伤，以四物汤中之熟地黄能护胎也。知其护胎之功，便可悟其护邪之害。胶粘之性最善着物，如油入面，一着遂不能去也。凡遇有邪而误用此药者，百药不效。病家不咎其用熟地黄之害，反以为曾用熟地黄而犹不效者，定为败症，岂非景岳之造其孽哉？"}]},{"ID":"20240616081812-3l7zy8e","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-3l7zy8e"}},{"ID":"20240616082016-bds38s4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082016-bds38s4","updated":"20240616082022"},"Children":[{"Type":"NodeText","Data":"地黄《长沙药解》"}]},{"ID":"20240616082016-vtn5bpz","Type":"NodeParagraph","Properties":{"id":"20240616082016-vtn5bpz","updated":"20240616082016"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】干地黄。味甘寒。主折跌绝筋，伤中，逐血痹，填骨髓，长肌肉，作汤，除寒热积聚，除痹，生者尤良。久服，轻身不老。一名地髓，生川泽。"}]},{"ID":"20240616082016-0awsla8","Type":"NodeParagraph","Properties":{"id":"20240616082016-0awsla8","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"味甘、微苦，入足太阴脾、足厥阴肝经。凉血滋肝，清风润木，疗厥阴之消渴，调经脉之结代。滋风木而断疏泄，血脱甚良，泽燥金而开约闭，便坚亦效。"}]},{"ID":"20240616082016-bq6eyr2","Type":"NodeParagraph","Properties":{"id":"20240616082016-bq6eyr2","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾气丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"干地黄八两，山茱萸四两，薯蓣四两，茯苓三两，泽泻三两，牡丹皮三两，桂枝一两，附子一两。"},{"Type":"NodeText","Data":"治虚劳腰痛，小腹拘急，小便不利，及妇人转胞，不得小便，及短气有微饮，及男子消渴，小便反多。以木主疏泄，水寒土湿，乙木郁陷，不能上达，故腰痛而腹急。疏泄之令不行，故小便不利。土木郁塞，下无透窍，故胞系壅阻而转移。水饮停留，上无降路，故气道格碍而短促。木以疏泄为性，郁而莫泄，激怒而生风燥，津液伤耗，则病消渴。风木之性，泄而不藏，风盛而土湿，不能遏闭，泄之太过，故小便反多。久而精溺注倾，津液无余，则枯槁而死。燥在乙木，湿在己土，而寒在癸水。乙木之燥，病之标也，癸水之寒，病之本也，是当温补肾气，以拔病本。附子补肾气之寒，薯、萸敛肾精之泄，苓、泽渗己土之湿，地黄润乙木之燥，桂枝达肝气之郁，丹皮行肝血之滞。"}]},{"ID":"20240616082016-oudwzcj","Type":"NodeParagraph","Properties":{"id":"20240616082016-oudwzcj","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"盖木愈郁而风愈旺，风旺而疏泄之性愈烈，泄之不通，则小便不利，泄而失藏，则小便反多，标异而本同，总缘于土湿而水寒，生意之弗遂也。水温土燥，郁散风清，则木气发达，通塞适中，而小便调矣。"}]},{"ID":"20240616082016-wh63xqu","Type":"NodeParagraph","Properties":{"id":"20240616082016-wh63xqu","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"肾气者，坎中之阳，《难经》所谓肾间动气，生气之根，呼吸之门也。方以肾气为名，则君附子而不君地黄。地黄者，淮阴之兵，多多益善，而究非主将也。"}]},{"ID":"20240616082016-m65s8ez","Type":"NodeParagraph","Properties":{"id":"20240616082016-m65s8ez","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"仲景于地黄，无作君之方，无特加之法。肾气丸用之治消渴淋癃，君附子以温肾气，地黄滋风木之枯燥也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在薯蓣。"},{"Type":"NodeText","Data":"用之治虚劳风气，君薯蓣以敛肾精，地、胶、归、芍，清风木之疏泄也。《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炙甘草汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在甘草。"},{"Type":"NodeText","Data":"用之治经脉结代，君以甘草以补中气，地、胶、麻仁，滋经脉之燥涩也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄（庶/虫）虫丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治劳伤干血，君大黄、（庶/虫）虫以破积，地黄、芍药，润经脉之枯燥也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄土汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在黄土。"},{"Type":"NodeText","Data":"用之治便后下血，君黄土以收血脱，地黄、阿胶，清风木之疏泄也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胶艾汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在阿胶。"},{"Type":"NodeText","Data":"用之治胎阻下血，君胶、艾以回血漏，地黄、归、芍，清风木之疏泄也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合地黄汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在百合。"},{"Type":"NodeText","Data":"用之治百合初病，君百合以清肺热，地黄泄脏腑之瘀浊也。"}]},{"ID":"20240616082016-vja4pr4","Type":"NodeParagraph","Properties":{"id":"20240616082016-vja4pr4","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"地黄滋润寒凉，最滑大便，火旺土燥者宜之。伤寒阳明病，腑燥便结，多服地黄浓汁，滋胃滑肠，胜用承气。鲜者尤捷，故百合地黄汤以之泻脏腑瘀浊，其力几同大黄。温疫、疹病之家，营郁内热，大用生地，壮其里阴，继以表药发之，使血热外达，皮肤斑生，亦为要物。血热不得透泄，以致经络郁热，而生痂癞，是为癞风，用生地于表散之中，清经热以达皮毛，亦为良品。水旺土湿者，切不可服！"}]},{"ID":"20240616082016-m69oe4p","Type":"NodeParagraph","Properties":{"id":"20240616082016-m69oe4p","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"凡人木病则燥，土病则湿，而木之病燥，究因土湿。滋木之燥，势必益土之湿，土湿愈增，则木燥愈甚，木益枯而土益败，则人死矣。地黄甚益于风木，甚不宜于湿土。阳旺土燥则不病，病者皆阴旺而土湿者也。"}]},{"ID":"20240616082016-rvgujf1","Type":"NodeParagraph","Properties":{"id":"20240616082016-rvgujf1","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"外感阳明之中，燥湿相半，三阴全是湿寒。内伤杂病，水寒土湿者，十之八九，土木俱燥者，不多见也。脾约之人，大便结燥，粪若羊矢，反胃噎膈，皆有此证。是胃湿而肠燥，非真燥证也。衄家，惟阳明伤寒，卫郁莫泄，逆循上窍，冲逼营血，以致鼻流，于表汗之中，加生地凉营之味，使之顺达皮毛，乃为相宜。至于内伤吐衄，悉缘土湿，更非燥证，以及种种外热烦蒸，无非土湿阳飞，火奔水泛，久服地黄，无有不死。"}]},{"ID":"20240616082016-5gyb50l","Type":"NodeParagraph","Properties":{"id":"20240616082016-5gyb50l","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"盖丁癸同宫，戊己并行，人之衰也，火渐消而水渐长。燥日减而湿日增，阳不胜阴，自然之理。阳旺则壮，阴旺则病，阳纯则仙，阴纯则鬼，抑阴扶阳，不易之道。但至理幽玄，非上智不解，后世庸工，以下愚之资，而谈上智之业，无知妄作，遂开补阴滋水之派。群儿冒昧，翕习成风，著作流传，遍于寰海。使抱病之家，死于地黄者十九，念之可为痛心也！"}]},{"ID":"20240616082016-q4flkcm","Type":"NodeParagraph","Properties":{"id":"20240616082016-q4flkcm","updated":"20240616082016"},"Children":[{"Type":"NodeText","Data":"晒干，生用。仲景方中生地，是用鲜者取汁。熟地之制，庸工妄作，不足用也。"}]},{"ID":"20240616081812-qgkm5nn","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-qgkm5nn"}},{"ID":"20240616082002-avhx3gt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082002-avhx3gt","updated":"20240616082010"},"Children":[{"Type":"NodeText","Data":"地黄《本草便读》"}]},{"ID":"20240616082002-rykj2c6","Type":"NodeParagraph","Properties":{"id":"20240616082002-rykj2c6","updated":"20240616082002"},"Children":[{"Type":"NodeText","Data":"生者甘寒入肾．凉血补阴．熟则温浓培元．填精益髓．细生地．柔细和营．在外证可以养阴不腻．鲜生地．新鲜散血．虽壮水实则清胃偏长．（地黄出怀庆者佳．今河南河内等处皆种之．其根长四五寸．外赤内黄．得土之正气．状如胡萝卜之形．晒之则干而黑．今之所用生地黄．已得丙火 炼．其寒性已退．养阴益血之功．不寒不腻．洵为上品．细者即旁生小枝．功虽相似．而无腻滞之性．有流动之机．故一切痘疹疮疡皆用之．生地未经蒸晒．即今之所为鲜生地．色黄味甘性寒．专入脾胃．散血清热．凡热邪内干营分．胃阴告竭者．颇属相宜．熟地即生地蒸晒极熟．色黑如漆．味如甘饴．寒转为温．自能独入肾家．填精补血．为培助下元之首药．如脾虚有湿者．不宜用耳．）"}]},{"ID":"20240616081812-v8imeap","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-v8imeap"}},{"ID":"20240616081951-42xy3c6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616081951-42xy3c6","updated":"20240616081957"},"Children":[{"Type":"NodeText","Data":"地黄《本草图经》"}]},{"ID":"20240616081951-nf2jki0","Type":"NodeParagraph","Properties":{"id":"20240616081951-nf2jki0","updated":"20240616081954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"地黄"},{"Type":"NodeText","Data":"，生咸阳川泽，黄土地者佳，今处处有之，以同州为上。二月生叶，布地便出，似车前，叶上有皱纹而不光，高者及尺余，低者三、四寸，其花似油麻花而红紫色，亦有黄花者，其实作房如连翘，子甚细而沙褐色，根如人手指，通黄色，粗细长短不常。二月、八月采根，蒸三、二日令烂，曝干，谓之熟地黄。阴干者，是生地黄。种之甚易，根入土即生。一说∶古称种地黄宜黄土。今不然，大宜肥壤虚地，则根大而多汁。其法以苇席圆编如车轮，径丈余，以壤土实苇席中为坛，坛上又以苇席实土为一级，比下坛径减一尺。如此数级，如浮屠也。乃以地黄根节多者寸断之，莳坛上，层层令满，逐日以水灌之，令茂盛。至春秋分时，自上层取之，根皆长大而不断折，不被 伤故也。得根曝干之。熟干地黄最上。出同州，光润而甘美。南方不复识。但以生地黄草烟熏使干黑，洗之煤尽，仍白也。今干之法∶取肥地黄三、二十斤，净洗，更以拣去细根及根节瘦短者，亦得二、三十斤，捣绞取汁，投银铜器中，下肥地黄浸漉令浃，饭上蒸三、四过，时时浸漉转蒸讫，又曝使汁尽，其地黄当光黑如漆，味甘如饴糖，须瓷器内收之，以其脂柔喜暴润也。又医家欲辨精粗，初采得以水浸。有浮者名天黄，不堪用；半沉者名人黄，为次；其沉者名地黄，最佳也。神仙方服食地黄，采取根，净洗，捣绞取汁，煎令小稠，内白蜜更煎，令可丸。晨朝酒送三十丸如梧子，日三。亦入青州枣肉同丸。又煎膏入干根末丸服。又四月采其实，阴干，筛末，水服钱匕，其效皆等。其花名地髓花。延年方有单服二法。又治伤折金疮为最要之药。《肘后方》∶疗 折四肢骨破碎及筋伤蹉跌，烂捣生地黄熬之，裹所伤处，以竹简编夹之，遍急缚勿令转动，一日一夕，可以十易，则瘥。崔元亮《海上方》∶治一切心痛，无问新久，以生地黄一味，随人所食多少，捣绞取汁，搜面作 ，或冷淘食，良久当利出虫长一尺许，头似壁宫，后不复患矣。昔有人患此病，三年不瘥，深以为恨，临终戒其家人，吾死后，当剖去病本，果得虫，置于竹节中，每所食，皆饲之，因食地黄 ，亦与之，随即坏烂，由此得方。刘禹锡《传信方》∶亦记其事云∶贞元十年，通事舍人崔抗女，患心痛垂气绝，遂作地黄冷淘食之，便吐一物，可方一寸以来，如虾蟆状，无目、足等，微似有口，盖为此物所食，自此遂愈。"}]},{"ID":"20240616081812-46m7b41","Type":"NodeThematicBreak","Properties":{"id":"20240616081812-46m7b41"}},{"ID":"20240616081938-1dfmlzn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616081938-1dfmlzn","updated":"20240616081942"},"Children":[{"Type":"NodeText","Data":"地黄《本草衍义》"}]},{"ID":"20240616081938-08r1fjy","Type":"NodeParagraph","Properties":{"id":"20240616081938-08r1fjy","updated":"20240616081938"},"Children":[{"Type":"NodeText","Data":"叶如甘露子，花如脂麻花，但有细斑点，北人谓之牛奶子。花、茎有微细短白毛。经只言干生二种，不言熟者。如血虚劳热，产后虚热，老人中虚燥热，须地黄者，生与生干常虑大寒，如此之类，故后世改用熟者。蒸曝之法∶以细碎者洗出，研取汁，将粗地黄蒸出曝干，投汁中，浸三二时，又曝，再蒸，如此再过为胜，亦不必多。此等与干生二种，功治殊别。陶但云捣汁和蒸殊用工，意不显其法，不注治疗，故须悉言耳。"}]},{"ID":"20240616082805-508no70","Type":"NodeThematicBreak","Properties":{"id":"20240616082805-508no70"}},{"ID":"20240616082806-3a2l181","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082806-3a2l181","updated":"20240616082812"},"Children":[{"Type":"NodeText","Data":"熟地黄《雷公炮制药性解》"}]},{"ID":"20240616082806-jg32qta","Type":"NodeParagraph","Properties":{"id":"20240616082806-jg32qta","updated":"20240616082806"},"Children":[{"Type":"NodeText","Data":"味甘苦，性温无毒，入心肝肾三经。活血气，封填骨髓；滋肾水，补益真阴。伤寒后胫股疼痛，新产后脐腹难禁。利耳目，乌须发，治五劳七伤，能安魂定魄。使忌畏恶，俱同生地，性尤泥滞，姜酒浸用。"}]},{"ID":"20240616082806-uxe8han","Type":"NodeParagraph","Properties":{"id":"20240616082806-uxe8han","updated":"20240616082806"},"Children":[{"Type":"NodeText","Data":"按∶熟地黄为补血之剂，而心与肝，藏血生血者也，故能入焉。其色黑，其性沉阴重浊，经必受其益，而劳伤惊悸，并可痊矣。"}]},{"ID":"20240616082806-962ookl","Type":"NodeParagraph","Properties":{"id":"20240616082806-962ookl","updated":"20240616082806"},"Children":[{"Type":"NodeText","Data":"雷公云∶采得生地黄，去白皮，磁锅上柳木甑蒸之，摊令气歇，拌酒，再蒸，又出令干，勿令犯铜铁，令人肾消，并白发，男损营，女损卫也。"}]},{"ID":"20240616082830-x3j9ojw","Type":"NodeThematicBreak","Properties":{"id":"20240616082830-x3j9ojw"}},{"ID":"20240616082831-d1pk3ju","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082831-d1pk3ju","updated":"20240616082835"},"Children":[{"Type":"NodeText","Data":"熟地黄《顾松园医镜》"}]},{"ID":"20240616082831-ulbnig2","Type":"NodeParagraph","Properties":{"id":"20240616082831-ulbnig2","updated":"20240616082831"},"Children":[{"Type":"NodeText","Data":"〔酒拌，九蒸九晒。〕滋肾水，封填骨髓，利血补脉，益真阴，治久病余胫股酸痛。〔阴伤之咎。〕新产后脐腹急疼，〔血败之故。〕补肾益阴之要药。熟者稍温，其功更溥。血热者宜生用，血衰者宜熟用。生地能生精血，天冬引入所生之处，熟地能补精血。麦冬引入所补之处。"}]},{"ID":"20240616082831-zsvnfmu","Type":"NodeParagraph","Properties":{"id":"20240616082831-zsvnfmu","updated":"20240616082831"},"Children":[{"Type":"NodeText","Data":"生地性寒而润，胃虚泻多，均在禁例。熟者性滞，若痰多气郁之人，能窒碍胸膈，当酌用。"}]},{"ID":"20240616082839-xn0pcd6","Type":"NodeThematicBreak","Properties":{"id":"20240616082839-xn0pcd6"}},{"ID":"20240616082841-0b6z5zi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082841-0b6z5zi","updated":"20240616082845"},"Children":[{"Type":"NodeText","Data":"熟地黄《炮炙全书》"}]},{"ID":"20240616082841-9um2ucd","Type":"NodeParagraph","Properties":{"id":"20240616082841-9um2ucd","updated":"20240616082841"},"Children":[{"Type":"NodeText","Data":"甘、苦，微温，用砂锅、柳甑衬以荷叶，将生地黄酒润，用缩砂仁粗末拌蒸，盖覆文武火蒸半日，干以手擘之有声地黄掘出洗净，肥大沉水者正，堪简用宜用新根，其宿根当年朽腐，虽肥大而生气将尽之物不宜入药，之有伤也，后皆能沉水，但鲜时有曝之，一碾即末矣。"}]},{"ID":"20240616082849-hkucuve","Type":"NodeThematicBreak","Properties":{"id":"20240616082849-hkucuve"}},{"ID":"20240616082851-gd6fl52","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082851-gd6fl52","updated":"20240616082856"},"Children":[{"Type":"NodeText","Data":"熟地黄《要药分剂》"}]},{"ID":"20240616082851-gthc4b6","Type":"NodeParagraph","Properties":{"id":"20240616082851-gthc4b6","updated":"20240616082851"},"Children":[{"Type":"NodeText","Data":"味甘。微苦。性微温。无毒。降也。阴中阳也。忌莱菔、葱、蒜、诸血。得当归、丹皮。和血止血。滋阴补髓。"}]},{"ID":"20240616082851-7qii5vx","Type":"NodeParagraph","Properties":{"id":"20240616082851-7qii5vx","updated":"20240616082851"},"Children":[{"Type":"NodeText","Data":"【主治】主补五脏内伤不足。通血脉。填骨髓。利耳目。黑须发。生精养血。男子五劳七伤坐而欲【归经】入心肝肾三经。为滋阴养血之品。（补血上剂滋肾水补真阴填骨髓生精血）"}]},{"ID":"20240616083005-w9cvyjq","Type":"NodeThematicBreak","Properties":{"id":"20240616083005-w9cvyjq"}},{"ID":"20240616083006-llgfsum","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083006-llgfsum","updated":"20240616083010"},"Children":[{"Type":"NodeText","Data":"熟地黄《药性切用》"}]},{"ID":"20240616083006-5spnilo","Type":"NodeParagraph","Properties":{"id":"20240616083006-5spnilo","updated":"20240616083006"},"Children":[{"Type":"NodeText","Data":"微甘微温，入足三阴经，滋肾水，封填骨髓，养血液，补益真阴，为补阴壮水之专阴虚无热最宜之。但性能腻膈，痰多气郁之人宜酌用。亦有熟砂仁末拌炒松用者。修制铁器。"}]},{"ID":"20240616082922-aenht7w","Type":"NodeThematicBreak","Properties":{"id":"20240616082922-aenht7w"}},{"ID":"20240616082923-adn3m7y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082923-adn3m7y","updated":"20240616082929"},"Children":[{"Type":"NodeText","Data":"熟地黄《珍珠囊补遗药性赋》"}]},{"ID":"20240616082923-kfa22ia","Type":"NodeParagraph","Properties":{"id":"20240616082923-kfa22ia","updated":"20240616082923"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"君 恶贝母畏芜荑忌铁器犯之令人肾消亦忌食莱菔令人发白"}]},{"ID":"20240616082923-cgml6n8","Type":"NodeParagraph","Properties":{"id":"20240616082923-cgml6n8","updated":"20240616082923"},"Children":[{"Type":"NodeText","Data":"熟地黄，味甘苦性温无毒。沉也，阴也。其用有四∶活血气，封填骨髓；滋肾水，补益真阴；伤寒后腰骨最痛；新产后脐腹难禁。"}]},{"ID":"20240616082913-0ou88dc","Type":"NodeThematicBreak","Properties":{"id":"20240616082913-0ou88dc"}},{"ID":"20240616082914-nqeagkx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082914-nqeagkx","updated":"20240616082918"},"Children":[{"Type":"NodeText","Data":"熟地黄《本经逢原》"}]},{"ID":"20240616082914-cwsqhak","Type":"NodeParagraph","Properties":{"id":"20240616082914-cwsqhak","updated":"20240616082914"},"Children":[{"Type":"NodeText","Data":"甘温，无毒。制地黄法，择取原株重六七钱者，以好酒浸，入缩砂仁末拌，木甑瓦锅九蒸九晒，得太阳真火入剂，方始得力。盖地黄性泥，得砂仁之香窜，而通调五脏冲和之气，归宿丹田也。"}]},{"ID":"20240616082914-um83rit","Type":"NodeParagraph","Properties":{"id":"20240616082914-um83rit","updated":"20240616082914"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"熟地黄假火力蒸晒，转苦为甘，为阴中之阳，故能补肾中元气。必须蒸晒多次，得太阳真火，确有坎离交济之妙用；若但煮熟，不加蒸曝，虽服奚益。好古曰∶生地黄治心热，手心热，益肾水，凉心血，其脉洪实者宜之。若脉虚者，则宜熟地黄。钱氏六味丸以之为君，天一所生之源也。若命门真火素弱者，必须崔氏八味丸，得桂、附共襄之力，方得阴阳兼济之功。汤液四物汤以之为主，乙癸同源之治也，其功专于填骨髓，长肌肉，生精血，补五脏内伤不足，通血脉，利耳目，黑须发，男子五劳七伤，女子伤中胞漏下血，经候不调，胎产百病，滋肾水真阴，疗脐腹急痛，病后胫股酸痛，坐而欲起，目 如无所见。盖脐下痛属肾藏精伤，胫股酸痛系下元不足，目 如无所见乃水亏不能鉴物，皆肾所主之病，非熟地黄不除。今人治目翳内障，往往用六味丸配磁朱丸服，良非所宜。地黄禁铁，磁为铁之母，安得不忌。予尝用当归代地黄，借其辛温以助 发之势。火盛则用芍药代山茱萸，借其酸寒以收耗散之阴，药虽异而功不殊也。愚按∶地黄本手少阴经药，功专清热散血，非经蒸曝不能入足少阴经，得水火既济之功，转苦成甘，变紫为黑，故直入肾脏填补真阴，兼培黄庭后土，土浓戴物，诸脏皆受其荫，是以崔氏八味、钱氏六味为培养真阴真阳之总司。后人借此各随所禀之偏而为增减，无往非受其益。如阴气不固则加鳔胶、蒺藜。阳气不充则加鹿茸、河车。中气不舒则加沉香、缩砂。下气不吸则加牛膝、车前。上气不津则加门冬、五味。肝气内盛则减萸倍泽。精气下脱则减泽倍萸。各得补偏救弊之妙用。其阴火旺者加知柏于六味方中，此与鸩酒止渴无异。他如四物汤中之芎、归，即六味丸中山萸之义。十全大补中之 、桂则八味丸中桂、附之义，方得阴阳相济之妙用。须知八味、十全平调血气，且汤液性味易过，地黄与参并用略无妨碍。六味丸中切不可杂一味中焦药，如人参、白术、甘草之类，咸非所宜。昔人有以六味丸加参而服，下咽少顷辄作迷迷不爽；或令增麦冬、五味功力倍常，深得金水相生之妙用，非专工药性者之可与讨论也。"}]},{"ID":"20240616082818-df0o8nb","Type":"NodeThematicBreak","Properties":{"id":"20240616082818-df0o8nb"}},{"ID":"20240616082819-pg0r29c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082819-pg0r29c","updated":"20240616082824"},"Children":[{"Type":"NodeText","Data":"熟地黄《本草求真》"}]},{"ID":"20240616082819-0q8mut1","Type":"NodeParagraph","Properties":{"id":"20240616082819-0q8mut1","updated":"20240616082819"},"Children":[{"Type":"NodeText","Data":"（隰草）能滋肾"}]},{"ID":"20240616082819-ktrk9ht","Type":"NodeParagraph","Properties":{"id":"20240616082819-ktrk9ht","updated":"20240616082819"},"Children":[{"Type":"NodeText","Data":"熟地黄（专入肾。兼入肝）。甘而微温。味浓气薄。专补肾脏真水。兼培黄庭后土。土浓载物。诸脏皆受其荫。故又曰能补五脏之真阴。熟地功力甚巨。在景岳谓其真阴亏损。有为发热、为头痛、为焦渴、为喉痹、为嗽痰、为喘气。或脾肾寒逆为呕吐。（亦有不宜用地黄者。）"}]},{"ID":"20240616082819-8nspq69","Type":"NodeParagraph","Properties":{"id":"20240616082819-8nspq69","updated":"20240616082819"},"Children":[{"Type":"NodeText","Data":"或虚火载血于口鼻。或水泛于皮肤。或阴虚而泄利。阳浮而狂躁。或阴脱而仆地。阴虚而神散者。非熟地之守不足以聚之。（守以制散。）阴虚而火升者。非熟地之重不足以降之。（重以制升。）阴虚而燥动者。非熟地之静不足以镇之。（静以制动。）阴虚而刚急者。非熟地之甘不足以缓之。（缓以制急。）阴虚而水邪上沸者。舍熟地何以自制。（水以引水。）舍熟地何以归元。阴虚而精血俱损脂膏残薄者。舍熟地何以浓肠胃。（浓以滋薄。）且犹有最玄最妙者。则熟地兼散剂能发汗。以汗化于血。（阴以化阳。）而无阴不作汗也。熟地兼湿剂能回阳。以阳生于下。（引阳归阴。）而无阴不回也。然而阳性速。故人参少用亦可成功。阴性缓。熟地非多难以奏效。而今人有畏其滞腻者。则崔氏何以用于肾气丸而治痰浮。（痰本于肾。）有畏其滑泄者。则仲景何以用于八味丸而医肾泄。（泄因肾气不固。故谓肾泄。）有谓阳能生阴阴不能生阳者。则阴阳之理原自互根。（无阴则阳无以化。）彼此相须。缺一不可。无阳则阴无以生。无阴则阳无以化。《内经》曰。精化为气。得非阴亦生阳乎？景岳尚论熟地。最为明确。独中所论脾胃寒逆为呕。可用地黄以治。是亦千虑之一失耳。夫既脾胃虚寒。则脾与胃已受寒累。正宜用以辛热以为扫除。如太阳既至。坚冰自解。乃复坠以霜雪。投以阴剂。不更使寒滋甚乎？余读景岳全书。见其所论。语语透辟。字字箴规。可为法守。独于所论地黄有宜脾肾虚寒。尚有未及。虽曰熟地性温。寒从温散。然寒至上逆为呕。则寒已甚。岂有熟地之温而可令寒外散乎？但或阳胜阴微。阳藉阴化。偶有感冒。用此杂于温散之中。或有见效。若真纯阴无火。厥气上逆而呕。则此又为深忌。至于制用地黄。宜用好酒砂仁末同入。久蒸久曝。使其转苦为甘。变紫为黑。方能直入肾经耳。（汪昂云。地黄性寒。得酒与火与日则温。性滞得砂仁则利气。且能引入丹田。六味丸用之为君。尺脉弱者加桂附。所谓益火之原以消阴翳也。尺脉旺者加知柏。所谓壮水之主以制阳光也。）出怀庆。肥大者佳。"}]},{"ID":"20240616082753-q2uwfon","Type":"NodeThematicBreak","Properties":{"id":"20240616082753-q2uwfon"}},{"ID":"20240616082754-4z6furf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082754-4z6furf","updated":"20240616082757"},"Children":[{"Type":"NodeText","Data":"熟地黄《得配本草》"}]},{"ID":"20240616082754-6zoagjj","Type":"NodeParagraph","Properties":{"id":"20240616082754-6zoagjj","updated":"20240616082754"},"Children":[{"Type":"NodeText","Data":"畏、恶、忌与生地同。"}]},{"ID":"20240616082754-yn0wsbi","Type":"NodeParagraph","Properties":{"id":"20240616082754-yn0wsbi","updated":"20240616082754"},"Children":[{"Type":"NodeText","Data":"甘、微温，微苦。入手足少阴、厥阴经血分。补真阴，填骨髓。凡阴虚火炎，水泛为痰，津枯无汗，烦躁不宁，耳目聋 ，神气散失，脂膏残薄，小水不利，大便不实，痿痹不仁，宿滞不化，真阳不回等症，非此不疗。得乌梅，引入骨髓。得砂仁，纳气归阴。得炒干姜，治产后血块。得丹皮，滋阴凉血。使玄参，消阴火。合当归，治胎痛。加牛膝，治胫股腹痛。"}]},{"ID":"20240616082754-ptpoiof","Type":"NodeParagraph","Properties":{"id":"20240616082754-ptpoiof","updated":"20240616082754"},"Children":[{"Type":"NodeText","Data":"（血不足也。）和牡蛎，消阴火之痰。痰多，姜汁炒。行血，酒炒。润肠，人乳炒。纳气、理气，砂仁炒。降火，童便煮。"}]},{"ID":"20240616082754-zuv8nhh","Type":"NodeParagraph","Properties":{"id":"20240616082754-zuv8nhh","updated":"20240616082754"},"Children":[{"Type":"NodeText","Data":"摄精，金樱子汁煮。补脾胃，炒炭存性。如煮熟未经蒸晒九次，寒凉之性未除，只算得心经凉剂，损胃阳，伤胃气，不可妄用。若阴虚火动者，半生半熟之品，适得其宜。熟地味甘而滞，甘为脾之所悦，虽滋肾实大益于土。经云∶味过于甘，肾气为土所掩，而不上交于心，心亦不得下交于肾，肾气不冲而独沉，是有权而无衡也。人之忽然死者，正惟生气不交，而独绝于内故尔。宜用辛凉者为之使，甘合辛而发散，则内气常通，心肾交结，自无喘满之患。且肾气动而不滞，精升而化气，金气亦从水中生矣。肺气亦归于肾，补敛之剂，何妨略加理气之味一二分，或五六分，俾补剂更为有力也。"}]},{"ID":"20240616082718-6vw4jqq","Type":"NodeThematicBreak","Properties":{"id":"20240616082718-6vw4jqq"}},{"ID":"20240616082719-escitbz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082719-escitbz","updated":"20240616082723"},"Children":[{"Type":"NodeText","Data":"熟地黄《本草从新》"}]},{"ID":"20240616082719-rwr4ii1","Type":"NodeParagraph","Properties":{"id":"20240616082719-rwr4ii1","updated":"20240616082719"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"平补肝肾、养血滋阴．"}]},{"ID":"20240616082719-tlhuxh8","Type":"NodeParagraph","Properties":{"id":"20240616082719-tlhuxh8","updated":"20240616082719"},"Children":[{"Type":"NodeText","Data":"甘而微温．入足三阴经．滋肾水．封填骨髓．利血脉．补益真阴．聪耳明目．（耳为肾窍、目为肝窍、目得血而能视、耳得血而能听．）黑发乌须．又能补脾阴．止久泻．（经云∶肾司二便、久泻多属肾虚、且下多亡阴、自宜补肾、不可专责脾也．）治劳伤风痹．阴亏发热．"}]},{"ID":"20240616082719-jv0v6fd","Type":"NodeParagraph","Properties":{"id":"20240616082719-jv0v6fd","updated":"20240616082719"},"Children":[{"Type":"NodeText","Data":"干咳痰嗽．（咳嗽阴亏者、地黄丸为要药、亦能除痰、丹溪曰∶久病阴火上升、津液生痰不生血、宜补血以制相火、其痰自除、喻嘉言曰∶凡咳嗽渐至气高汗渍、不补其下、但清其上、必至气脱卒亡、医之罪也．）气短喘促．（熟地一两、归身三钱、炙甘草一钱、名贞元饮、治气短似喘、呼吸急促、提不能升、咽不能降、气道噎塞、势极垂危者、常人但知气急、其病在上、而不知元海无根、肝肾亏损、此子午不交、气脱证也、尤惟妇人血海常亏者、最多此证、宜以此饮济之缓之、傥庸众不知、妄云痰逆气滞、用牛黄苏合、及青陈枳壳破气等剂、则速其危．）胃中空虚觉馁．痘证血虚无脓．病后胫股酸痛．产后脐腹急疼．（丹溪曰∶产前当清热养血为主、产后宜大补气血、虽有杂证、从末治之．）感证阴亏．无汗便闭．（阴气外溢则得汗、阴血下润则便通．）诸种动血．一切肝肾阴亏．虚损百病．为壮水之主药．"}]},{"ID":"20240616082719-o17t40n","Type":"NodeParagraph","Properties":{"id":"20240616082719-o17t40n","updated":"20240616082719"},"Children":[{"Type":"NodeText","Data":"气郁之人．能窒碍胸膈．用宜斟酌．（郭佩兰本草汇曰∶丹溪云∶气病无害也、不知血药属阴、其性凝滞、胃虚气弱之人、过服归地等剂、必致痞闷食减、病安能愈耶、景岳全书曰∶地黄产于中州沃土之乡、得土气之最浓者也、其色黄、土之色也、其味甘、土之味也、而谓非脾胃中州之药、吾不信也、但脾胃喜温而恶寒、生干地黄性寒、自非脾胃所喜、蒸晒极熟、则甘温正与脾胃相宜耳、殊不知熟地黄乃阴滞不行之药、大为脾胃之病所不宜也．）作熟地黄法．拣取肥地黄沉水者数十斤．洗去沙土．略晒干．别以拣下瘦小者数十斤．捣绞取汁．投石器中．浸漉令浃．入柳木甑．放瓦锅上蒸一日．晒几日．令极干．又蒸又晒．如是九次．锅内傥有淋下地黄余汁．亦必拌晒．使汁尽而干．其地黄光黑如漆．味甘如饴．须瓷器收之．以其脂柔喜润也．（按地黄取其纯阴静重、近时多拌以好酒及砂仁末而蒸晒之、是反以散动香燥、乱其性矣、其法甚为不善、有用姜汁拌炒者、尤不合法．今市中惟以一煮而售、害有不可胜言者、盖禀北方纯阴至寒之性、非太阳与烈火频频交炼则不温、所以固本膏、虽经日煎熬、必生熟各半而用之、设以生地一煮、便作熟地投用归肾、右归、七味、八味等剂中、则寒凉之性未除、心肾之经各别、以心经寒凉之药为君主、以肾经温暖之药为臣佐、岂徒无益、反引寒性下损真阳、微虚者、暂堪抵受、大虚挟寒者、气立孤危、制治乖方、而为害甚烈、斯其最也．市医尝将熟地枸杞等炒作炭用、是甘润养阴之品、变而为苦燥伤阴之物、非徒无益、而又害之矣．）"}]},{"ID":"20240616082707-4041w6o","Type":"NodeThematicBreak","Properties":{"id":"20240616082707-4041w6o"}},{"ID":"20240616082708-h6y01y2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082708-h6y01y2","updated":"20240616082713"},"Children":[{"Type":"NodeText","Data":"熟地黄《本草备要》"}]},{"ID":"20240616082708-pq3zper","Type":"NodeParagraph","Properties":{"id":"20240616082708-pq3zper","updated":"20240616082708"},"Children":[{"Type":"NodeText","Data":"平补肝肾，养血滋阴"}]},{"ID":"20240616082708-por8sh1","Type":"NodeParagraph","Properties":{"id":"20240616082708-por8sh1","updated":"20240616082708"},"Children":[{"Type":"NodeText","Data":"甘而微温。入手足少阴、厥阴经。滋肾水，补真阴，填骨髓，生精血，聪耳明目（耳为肾窍，目为肝窍。目得血而能视。耳得血而能聪），黑发乌髭。治劳伤风痹，胎产百病，为补血之上剂（丹溪曰∶产前当清热养血为主，产后宜大补气血为主，虽有杂证，从未治之。"}]},{"ID":"20240616082708-sgi3sfi","Type":"NodeParagraph","Properties":{"id":"20240616082708-sgi3sfi","updated":"20240616082708"},"Children":[{"Type":"NodeText","Data":"昂按∶丹溪产后大补气血一语，诚至当不易之论。后人不善用之，多有风寒未解，瘀血未尽，妄施峻补，反致大害者，不可不察。王硕云∶男子多阴虚，宜熟地；女子多血热，宜生地）。"}]},{"ID":"20240616082708-qaurymf","Type":"NodeParagraph","Properties":{"id":"20240616082708-qaurymf","updated":"20240616082708"},"Children":[{"Type":"NodeText","Data":"以好酒拌砂仁末，浸蒸晒九次用（地黄性寒，得酒与火与日则温。性泥，得砂仁则和气，且能引入丹田。六味丸用之为君，尺脉弱者加桂、附，所谓益火之原，以消阴翳也。尺脉旺者加知、柏，所谓壮水之主，以制阳光也）。"}]},{"ID":"20240616082655-zhpfjvj","Type":"NodeThematicBreak","Properties":{"id":"20240616082655-zhpfjvj"}},{"ID":"20240616082657-fjapv4e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082657-fjapv4e","updated":"20240616082701"},"Children":[{"Type":"NodeText","Data":"熟地黄《本草择要纲目》"}]},{"ID":"20240616082657-w1wh5ax","Type":"NodeParagraph","Properties":{"id":"20240616082657-w1wh5ax","updated":"20240616082657"},"Children":[{"Type":"NodeText","Data":"（即生干地黄择其沉实者．以陈酒煮小地黄汁．将地黄复入汁内．九蒸九晒．令其脂体柔润者是也．）"}]},{"ID":"20240616082657-25tcknd","Type":"NodeParagraph","Properties":{"id":"20240616082657-25tcknd","updated":"20240616082657"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616082657-mr9dtyw","Type":"NodeParagraph","Properties":{"id":"20240616082657-mr9dtyw","updated":"20240616082657"},"Children":[{"Type":"NodeText","Data":"甘微苦微温．阴中之阳．沉也．入手足少阴厥阴之经．"}]},{"ID":"20240616082657-0e1dbt1","Type":"NodeParagraph","Properties":{"id":"20240616082657-0e1dbt1","updated":"20240616082657"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616082657-cql033i","Type":"NodeParagraph","Properties":{"id":"20240616082657-cql033i","updated":"20240616082657"},"Children":[{"Type":"NodeText","Data":"益肾水真阴．和产后血气．去脐腹急痛．养阴退阳．壮水之源．仲景六味丸以之为诸药之首．天一所生之源也．汤液四物汤治藏血之脏以之为君者．癸乙同归一治也．又曰生地黄能生精血．用天门冬可引入所生之处．熟地黄能补精血．用麦门冬可引入所补之处．"}]},{"ID":"20240616082657-z5cj0lq","Type":"NodeParagraph","Properties":{"id":"20240616082657-z5cj0lq","updated":"20240616082657"},"Children":[{"Type":"NodeText","Data":"【忌】（萝卜 葱 诸血 蒜）"}]},{"ID":"20240616082642-u31ysfi","Type":"NodeThematicBreak","Properties":{"id":"20240616082642-u31ysfi"}},{"ID":"20240616082643-fvj01dz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082643-fvj01dz","updated":"20240616082647"},"Children":[{"Type":"NodeText","Data":"熟地黄《本草易读》"}]},{"ID":"20240616082643-jyey4we","Type":"NodeParagraph","Properties":{"id":"20240616082643-jyey4we","updated":"20240616082643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒洗良。忌莱菔、葱、蒜、诸血。"}]},{"ID":"20240616082643-30pfxpk","Type":"NodeParagraph","Properties":{"id":"20240616082643-30pfxpk","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"甘，平，无毒。入手足少阴、厥阴。滋肾益阴，填髓生精，黑须乌发，聪耳明目。经候胎产取肥地黄洗净，以拣下瘦短者捣绞汁，投石器浸漉，甑上蒸数次，光黑如漆也。近时造法，砂仁末在内，拌匀，入柳木甑内，蒸晒数次。今布中惟以酒煮熟耳。"}]},{"ID":"20240616082643-dnmrk67","Type":"NodeParagraph","Properties":{"id":"20240616082643-dnmrk67","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"咳而唾血，劳瘦骨蒸，生地末，煮粥食。（验方第一。）"}]},{"ID":"20240616082643-o78m4tm","Type":"NodeParagraph","Properties":{"id":"20240616082643-o78m4tm","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"吐血咳嗽，每酒下熟地末一钱。（第二。）"}]},{"ID":"20240616082643-tf82bz3","Type":"NodeParagraph","Properties":{"id":"20240616082643-tf82bz3","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"鼻血不已，生地同薄荷，末服。（第三。）"}]},{"ID":"20240616082643-4cwqa8b","Type":"NodeParagraph","Properties":{"id":"20240616082643-4cwqa8b","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"肠风下血，生地同五味子，蜜丸服。（第四。）"}]},{"ID":"20240616082643-7elrruz","Type":"NodeParagraph","Properties":{"id":"20240616082643-7elrruz","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"疔肿乳痈，生地捣敷，热另易之。（第五。）"}]},{"ID":"20240616082643-r5ajeye","Type":"NodeParagraph","Properties":{"id":"20240616082643-r5ajeye","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"一切痈疽，未破疼痛，生地杵泥摊在上，掺木香末于中，又摊生地泥一重，贴之，三五次即内消。（第六。）"}]},{"ID":"20240616082643-s8g5kvy","Type":"NodeParagraph","Properties":{"id":"20240616082643-s8g5kvy","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"打扑损伤，未破痛疾。同上（第七。）"}]},{"ID":"20240616082643-lq8bydo","Type":"NodeParagraph","Properties":{"id":"20240616082643-lq8bydo","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"物伤睛突，生地泥绵包敷之。（第八。）"}]},{"ID":"20240616082643-zgmrges","Type":"NodeParagraph","Properties":{"id":"20240616082643-zgmrges","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"目暴赤痛，生地、黑豆杵膏罨之。（第九。）"}]},{"ID":"20240616082643-db228vb","Type":"NodeParagraph","Properties":{"id":"20240616082643-db228vb","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"血热牙痛，切生地咬之。（第十。）"}]},{"ID":"20240616082643-cmryp9j","Type":"NodeParagraph","Properties":{"id":"20240616082643-cmryp9j","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"牙动欲脱，生地绵包咂之，令汁渍根且咽之。（十一。）"}]},{"ID":"20240616082643-gazqoot","Type":"NodeParagraph","Properties":{"id":"20240616082643-gazqoot","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"耳中常鸣，生地塞之，数易。（十二。）"}]},{"ID":"20240616082643-lj6seg6","Type":"NodeParagraph","Properties":{"id":"20240616082643-lj6seg6","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"竹木入肉，生地杵烂敷之。（十三。）"}]},{"ID":"20240616082643-nugj5aj","Type":"NodeParagraph","Properties":{"id":"20240616082643-nugj5aj","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"骨蒸劳热，生地或膏或蜜丸。（十四。）"}]},{"ID":"20240616082643-4e7fn5b","Type":"NodeParagraph","Properties":{"id":"20240616082643-4e7fn5b","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"睛被物伤，珠胀痛肿。外敷，捣烂生地膏。内服川芎、生地、羚羊角、大黄、赤芍、枳壳、木香。（十五。）"}]},{"ID":"20240616082643-t1vy8a0","Type":"NodeParagraph","Properties":{"id":"20240616082643-t1vy8a0","updated":"20240616082643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾气丸"},{"Type":"NodeText","Data":"干地黄 山茱萸肉 茯苓 泽泻 丹皮 肉桂 附子治虚腰痛，小腹拘急，小便不利。又治妇人转胞，不得小便，短气。又治男子消渴尿多。"}]},{"ID":"20240616082643-ryhtnbm","Type":"NodeParagraph","Properties":{"id":"20240616082643-ryhtnbm","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"（"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"琼玉膏"},{"Type":"NodeText","Data":"生地（十六分） 参末（一分） 茯苓末（三分）"}]},{"ID":"20240616082643-z5pwipd","Type":"NodeParagraph","Properties":{"id":"20240616082643-z5pwipd","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"入瓶内封固，安锅中煮三日，取出，浸井底一日，再煮。每用白汤下，或酒下。治虚劳干咳血症。（第二。）"}]},{"ID":"20240616082643-bwu9yub","Type":"NodeParagraph","Properties":{"id":"20240616082643-bwu9yub","updated":"20240616082643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"六味地黄丸"},{"Type":"NodeText","Data":"熟地 山药 茱萸肉 泽泻 茯苓 丹皮治肾阴不足，发热作渴，小便淋闭，气壅痰嗽，头目眩晕，目花耳聋，咽干吞痛，齿牙不固血虚发热，失音等症。（第三。）"}]},{"ID":"20240616082643-ojhdqvw","Type":"NodeParagraph","Properties":{"id":"20240616082643-ojhdqvw","updated":"20240616082643"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"八味地黄丸"},{"Type":"NodeText","Data":"六味原方加桂、附。"}]},{"ID":"20240616082643-13l1zhu","Type":"NodeParagraph","Properties":{"id":"20240616082643-13l1zhu","updated":"20240616082643"},"Children":[{"Type":"NodeText","Data":"蜜丸。治虚劳腰痛，少腹拘急，小便不利。又治妇人烦热不卧，转胞不溺。（第四。）"}]},{"ID":"20240616082629-od2qzi1","Type":"NodeThematicBreak","Properties":{"id":"20240616082629-od2qzi1"}},{"ID":"20240616082630-m1utg7d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082630-m1utg7d","updated":"20240616082634"},"Children":[{"Type":"NodeText","Data":"熟地黄《医学入门》"}]},{"ID":"20240616082630-ij5e4fz","Type":"NodeParagraph","Properties":{"id":"20240616082630-ij5e4fz","updated":"20240616082630"},"Children":[{"Type":"NodeText","Data":"熟地黄甘苦温平，补血填髓滋肾精，疗伤寒后腰股痛，除新产罢腹脐疼。"}]},{"ID":"20240616082630-zm6ronj","Type":"NodeParagraph","Properties":{"id":"20240616082630-zm6ronj","updated":"20240616082630"},"Children":[{"Type":"NodeText","Data":"无毒。沉而降，阴也。入手足少阴、厥阴经。东垣云∶熟地黄补血，且疗虚损。又曰∶活血气，填骨髓，滋肾水，补真阴，治伤寒后血衰、腰股酸疼，除新产后血虚脐痛难禁。丹溪云∶下元血衰者须用之，尺脉微者，佐以桂、附则填精补髓；尺脉旺者，佐以知、柏则滋阴降火。独用则泥膈，故中满痰盛者慎用。余治与生地悉同。"}]},{"ID":"20240616082630-k03dipn","Type":"NodeParagraph","Properties":{"id":"20240616082630-k03dipn","updated":"20240616082630"},"Children":[{"Type":"NodeText","Data":"盖本经只言干生二种，后世改用熟者，生寒熟滞，中寒有痞易泄者全禁。怀庆者佳。水洗，用生地捣汁九蒸九晒，或酒或姜汁俱好。畏忌同生地。"}]},{"ID":"20240616082501-l06o176","Type":"NodeThematicBreak","Properties":{"id":"20240616082501-l06o176"}},{"ID":"20240616082502-asbsvzt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082502-asbsvzt","updated":"20240616082508"},"Children":[{"Type":"NodeText","Data":"熟地黄《汤液本草》"}]},{"ID":"20240616082502-fyszqxm","Type":"NodeParagraph","Properties":{"id":"20240616082502-fyszqxm","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"气寒，味苦，阴中之阳。甘，微苦，味浓气薄，阴中阳也。无毒。"}]},{"ID":"20240616082502-hcbxsa0","Type":"NodeParagraph","Properties":{"id":"20240616082502-hcbxsa0","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"入手足少阴《象》云∶酒洒，蒸如乌金，假酒力则微温，大补，血衰者须用之。善黑须发。忌萝卜。"}]},{"ID":"20240616082502-we2ldd5","Type":"NodeParagraph","Properties":{"id":"20240616082502-we2ldd5","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"《珍》云∶若治外、治上，酒制。"}]},{"ID":"20240616082502-rc2ykrd","Type":"NodeParagraph","Properties":{"id":"20240616082502-rc2ykrd","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"《心》云∶生则性大寒而凉血，熟则性寒而消肾。"}]},{"ID":"20240616082502-08gl6tm","Type":"NodeParagraph","Properties":{"id":"20240616082502-08gl6tm","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主折跌、绝筋、伤中，逐血痹，填骨髓，长肌肉。作汤，除寒热积聚，除痹；主男子五劳七伤，女子伤中、胞漏下血；破恶血，溺血。利大小肠，去胃中宿食，饱力断绝，补五脏内伤不足；通血脉，益气力，利耳目。生者，尤良。得清酒、麦门冬，尤良。"}]},{"ID":"20240616082502-7avabg9","Type":"NodeParagraph","Properties":{"id":"20240616082502-7avabg9","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"恶贝母。畏芜荑。"}]},{"ID":"20240616082502-9em3hyy","Type":"NodeParagraph","Properties":{"id":"20240616082502-9em3hyy","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"东垣云∶生地黄，治手足心热，及心热。入手足少阴、手足厥阴，能益肾水而治血，脉洪实者，宜此；若脉虚，则宜熟地黄。地黄假火力蒸九数，故能补肾中元气。仲景制八味丸，以熟地黄为诸药之首，天一所生之源也。汤液四物以治藏血之脏，亦以干熟地黄为君者，癸乙同归一治也。蒸捣不可犯铁，若犯铁，令人消肾。"}]},{"ID":"20240616082502-mbmwt7u","Type":"NodeParagraph","Properties":{"id":"20240616082502-mbmwt7u","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶蒸干即温补，生干即平宣。"}]},{"ID":"20240616082502-txpob3r","Type":"NodeParagraph","Properties":{"id":"20240616082502-txpob3r","updated":"20240616082502"},"Children":[{"Type":"NodeText","Data":"《机要》云∶熟地黄，脐下发痛者，肾经也，非地黄不能除。补肾益阴之剂，二宜丸加当归为补髓。"}]},{"ID":"20240616082547-jz87phn","Type":"NodeThematicBreak","Properties":{"id":"20240616082547-jz87phn"}},{"ID":"20240616082548-711wq84","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616082548-711wq84","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"熟地黄《中药学》"}]},{"ID":"20240616082548-pawjxaq","Type":"NodeParagraph","Properties":{"id":"20240616082548-pawjxaq","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为玄参科植物地黄经蒸制后的块状根"}]},{"ID":"20240616082548-9pmm6jf","Type":"NodeParagraph","Properties":{"id":"20240616082548-9pmm6jf","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，微温。人心、肝、肾经。"}]},{"ID":"20240616082548-kseap9z","Type":"NodeParagraph","Properties":{"id":"20240616082548-kseap9z","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【功效】补血，滋阴。"}]},{"ID":"20240616082548-flv7fih","Type":"NodeParagraph","Properties":{"id":"20240616082548-flv7fih","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于血虚萎黄、眩晕、心悸、失眠及月经不调、崩漏等症。"}]},{"ID":"20240616082548-qwu2xpq","Type":"NodeParagraph","Properties":{"id":"20240616082548-qwu2xpq","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"熟地能补血滋阴而养肝益肾，凡血虚阴亏、肝肾不足所致的眩晕，均可应用。补血常与当归、白芍等同用；补肝肾常与山茱萸等同用。此外，如配党参、酸枣仁、茯苓等品，可用于心悸、失眠；配当归、白芍、川芍、香附等药，可用治月经不调；配阿胶、当归、白芍等，可用于崩漏。"}]},{"ID":"20240616082548-n13bypo","Type":"NodeParagraph","Properties":{"id":"20240616082548-n13bypo","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"2.用于肾阴不足，骨蒸潮热，盗汗，遗精及消渴等症。"}]},{"ID":"20240616082548-35o3smw","Type":"NodeParagraph","Properties":{"id":"20240616082548-35o3smw","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"本品滋肾益阴，适用于肾阴不足所引起的各种病症，常与山茱萸、丹皮等配伍应用；如属阴虚火旺、骨蒸潮热等症，可与龟板、知母、黄柏等同用。"}]},{"ID":"20240616082548-lrwnjt7","Type":"NodeParagraph","Properties":{"id":"20240616082548-lrwnjt7","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【处方用名】熟地、大熟地（蒸制用）。熟地炭（熟地炒焦后应用，主要用于止血）。砂仁拌熟地（用砂仁拌用，主要减少其滋腻碍胃之性）。"}]},{"ID":"20240616082548-guuc5us","Type":"NodeParagraph","Properties":{"id":"20240616082548-guuc5us","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至一两，煎服。"}]},{"ID":"20240616082548-ryykmiy","Type":"NodeParagraph","Properties":{"id":"20240616082548-ryykmiy","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【按语】1.地黄一物，在临床应用上根据加工情况不同，有下列三种，新鲜的叫鲜生地，古称生地黄，现市上所用大都是如手指粗的未长大者；长大而晒干者叫生地，古称干地黄；用生地加工蒸熟后叫熟地黄，简称熟地。鲜生地长于清热凉血；生地长于凉血滋阴；熟地则专用于滋养，能补血滋阴。熟地黄与山萸肉、肉苁蓉、枸杞子、菟丝子等都是平补的药品，熟无论肾阴亏虚或肾阳不足，都可配用；但本品补益肝肾的功效较好，而且还有补血作用。"}]},{"ID":"20240616082548-cck0i23","Type":"NodeParagraph","Properties":{"id":"20240616082548-cck0i23","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"2.本品性滋腻，易于助湿碍胃，故脾胃虚弱、湿阻胸闷、食少便溏者不宜应用；如果血虚、肝肾不足等症而有脾胃运化不良，应用熟地时可与理气健胃的药品如陈皮、砂仁等配伍同用，能减少它滋腻碍胃之性。"}]},{"ID":"20240616082548-daylpxy","Type":"NodeParagraph","Properties":{"id":"20240616082548-daylpxy","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【方剂举例】四物汤《和剂局方》：熟地黄、当归、川芎、白芍。治血虚萎黄，月经不调。"}]},{"ID":"20240616082548-8wbjucd","Type":"NodeParagraph","Properties":{"id":"20240616082548-8wbjucd","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"六味地黄丸《小儿药证直诀》：地黄，山茱萸、山药，茯苓，泽泻，丹皮。治肾阴不足，虚火上炎，腰膝疫软，头目眩晕等。"}]},{"ID":"20240616082548-klib919","Type":"NodeParagraph","Properties":{"id":"20240616082548-klib919","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《珍珠囊》：「主补血气，滋肾水，益真阴。」"}]},{"ID":"20240616082548-06qx15r","Type":"NodeParagraph","Properties":{"id":"20240616082548-06qx15r","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「填骨髓，长肌肉，生精血，补五脏内伤不足，通血脉，利耳目，黑须发」"}]},{"ID":"20240616082548-2e4n3wo","Type":"NodeParagraph","Properties":{"id":"20240616082548-2e4n3wo","updated":"20240616082548"},"Children":[{"Type":"NodeText","Data":"《本草正》：「阴虚而神散者，非熟地……不足以聚之；阴虚而火升者，非熟地……不足以降之；阴虚而躁动者，非熟地……不足以镇之；阴虚而刚急者，非熟地……不足以缓之。」"}]},{"ID":"20240607094856-uhd81am","Type":"NodeThematicBreak","Properties":{"id":"20240607094856-uhd81am"}},{"ID":"20240607094857-imofzfr","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607094857-imofzfr","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"地黄"}]},{"ID":"20240607094857-argh2u9","Type":"NodeParagraph","Properties":{"id":"20240607094857-argh2u9","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607094857-nxerv7n","Type":"NodeParagraph","Properties":{"id":"20240607094857-nxerv7n","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" Dì Huánɡ"}]},{"ID":"20240607094857-t3rqlit","Type":"NodeParagraph","Properties":{"id":"20240607094857-t3rqlit","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607094857-3rd5rnw","Type":"NodeParagraph","Properties":{"id":"20240607094857-3rd5rnw","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 地黄、野地黄、酒壶花、山烟根"}]},{"ID":"20240607094857-d15wp6d","Type":"NodeParagraph","Properties":{"id":"20240607094857-d15wp6d","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607094857-oi1fqxo","Type":"NodeParagraph","Properties":{"id":"20240607094857-oi1fqxo","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" RADIX REHMANNIAE"}]},{"ID":"20240607094857-j3xlwvn","Type":"NodeParagraph","Properties":{"id":"20240607094857-j3xlwvn","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094857-j2zi0vs","Type":"NodeParagraph","Properties":{"id":"20240607094857-j2zi0vs","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 本品为玄参科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地黄"},{"Type":"NodeText","Data":"Rehmannia glutinosa Libosch. 的新鲜或干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。秋季采挖，除去芦头、须根及泥沙，鲜用；或将地黄缓缓烘焙至约八成干。前者习称“鲜地黄”，后者习称“生地黄”。"}]},{"ID":"20240607094857-j77c53g","Type":"NodeParagraph","Properties":{"id":"20240607094857-j77c53g","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094857-vix60dg","Type":"NodeParagraph","Properties":{"id":"20240607094857-vix60dg","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 鲜地黄：呈纺锤形或条状，长8～24cm，直径2～9cm。外皮薄，表面浅红黄色，具弯曲的纵皱纹、芽痕、横长皮孔及不规则疤痕。肉质，易断，断面皮部淡黄白色，可见橘红色油点，木部黄白色，导管呈放射状排列。气微，味微甜、微苦。"}]},{"ID":"20240607094857-qrshuw9","Type":"NodeParagraph","Properties":{"id":"20240607094857-qrshuw9","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"生地黄：多呈不规则的团块状或长圆形，中间膨大，两端稍细，有的细小，长条状，稍扁而扭曲，长6～12cm，直径3～6cm。表面棕黑色或棕灰色，极皱缩，具不规则的横曲纹。体重，质较软而韧，不易折断，断面棕黑色或乌黑色，有光泽，具黏性。无臭，味微甜。"}]},{"ID":"20240607094857-344napp","Type":"NodeParagraph","Properties":{"id":"20240607094857-344napp","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607094857-77wutsb","Type":"NodeParagraph","Properties":{"id":"20240607094857-77wutsb","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 鲜地黄埋在砂土中，防冻；生地黄置通风干燥处，防霉、防蛀。"}]},{"ID":"20240607094857-6am8r3b","Type":"NodeParagraph","Properties":{"id":"20240607094857-6am8r3b","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607094857-rljfctv","Type":"NodeParagraph","Properties":{"id":"20240607094857-rljfctv","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：木栓细胞数列。皮层薄壁细胞排列疏松；散有较多分泌细胞，含橘黄色油滴；偶有石细胞。韧皮部较宽，分泌细胞较少。形成层成环。木质部射线宽广；导管稀疏，排列成放射状。生地黄粉末深棕色。木栓细胞淡棕色，断面观类长方形，排列整齐。薄壁细胞类圆形，内含类圆形细胞核。分泌细胞形状与一般薄壁细胞相似，内含橙黄色或橙红色油滴状物。具缘纹孔及网纹导管直径约至92μm。"}]},{"ID":"20240607094857-xv2dyeg","Type":"NodeParagraph","Properties":{"id":"20240607094857-xv2dyeg","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加甲醇20ml，加热回流1 小时，放冷，滤过，滤液回收甲醇至5ml,作为供试品溶液。另取梓醇对照品加甲醇制成每1ml含0.5mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一硅胶Ｇ薄层板上，以氯仿－甲醇－水（14:6:1）为展开剂，展开，取出，晾干，喷以茴香醛试液，105℃ 加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607094857-fu035o4","Type":"NodeParagraph","Properties":{"id":"20240607094857-fu035o4","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094857-9rfkkav","Type":"NodeParagraph","Properties":{"id":"20240607094857-9rfkkav","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 归心、肝、肾经。"}]},{"ID":"20240607094857-z0n8xsh","Type":"NodeParagraph","Properties":{"id":"20240607094857-z0n8xsh","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094857-ctqwphm","Type":"NodeParagraph","Properties":{"id":"20240607094857-ctqwphm","updated":"20240607094924"},"Children":[{"Type":"NodeText","Data":"鲜地黄：甘、苦，寒。"}]},{"ID":"20240607094857-3a5wcyt","Type":"NodeParagraph","Properties":{"id":"20240607094857-3a5wcyt","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"生地黄：甘，寒。"}]},{"ID":"20240607094857-92mhe8t","Type":"NodeParagraph","Properties":{"id":"20240607094857-92mhe8t","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094857-p5l231f","Type":"NodeParagraph","Properties":{"id":"20240607094857-p5l231f","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 鲜地黄：清热生津，凉血，止血。用于热病伤阴，舌绛烦渴，发斑发疹，吐血，衄血，咽喉肿痛。"}]},{"ID":"20240607094857-gr281zn","Type":"NodeParagraph","Properties":{"id":"20240607094857-gr281zn","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"生地黄：清热凉血，养阴，生津。用于热病舌绛烦渴，阴虚内热，骨蒸劳热，内热消渴，吐血，衄血，发斑发疹。"}]},{"ID":"20240607094857-m5h6dwr","Type":"NodeParagraph","Properties":{"id":"20240607094857-m5h6dwr","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094857-utg8w46","Type":"NodeParagraph","Properties":{"id":"20240607094857-utg8w46","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 鲜地黄：12～30g。生地黄：9～15g。"}]},{"ID":"20240607094857-awbitqi","Type":"NodeParagraph","Properties":{"id":"20240607094857-awbitqi","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094857-ie2p59s","Type":"NodeParagraph","Properties":{"id":"20240607094857-ie2p59s","updated":"20240607094857"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607094858-eizba2d","Type":"NodeThematicBreak","Properties":{"id":"20240607094858-eizba2d"}},{"ID":"20240616082451-w9r036r","Type":"NodeParagraph","Properties":{"id":"20240616082451-w9r036r"}}]}