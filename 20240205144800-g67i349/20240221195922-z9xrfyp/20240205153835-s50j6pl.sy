[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根 6-20240710145956-mh0hc9n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 606px;\" parent-style=\"width: 616px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 605px;","style":"width: 595px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根 5-20240710145931-4pkrb9g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 595px;\" parent-style=\"width: 605px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710150956-8t7mf7u","Type":"NodeParagraph","Properties":{"id":"20240710150956-8t7mf7u","updated":"20240710150956"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 636px;","style":"width: 626px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根 12-20240710150825-pcelmzv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 626px;\" parent-style=\"width: 636px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 626px;","style":"width: 616px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根 10-20240710150545-mh3j5je.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 616px;\" parent-style=\"width: 626px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710150956-x8brw9y","Type":"NodeParagraph","Properties":{"id":"20240710150956-x8brw9y","updated":"20240710150956"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 792px;","style":"width: 782px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根 1-20240710145743-ca4k8qz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 782px;\" parent-style=\"width: 792px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 448px;","style":"width: 438px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根-20240710145705-oariak7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 438px;\" parent-style=\"width: 448px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616122741-h2pmng3","Type":"NodeParagraph","Properties":{"id":"20240616122741-h2pmng3","updated":"20240710151200"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"注：青黛就是由板蓝根的叶茎加工而成"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240616122741-mg1lzxj","Type":"NodeThematicBreak","Properties":{"id":"20240616122741-mg1lzxj"}},{"ID":"20240616122823-hehgxk5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122823-hehgxk5","updated":"20240616122828"},"Children":[{"Type":"NodeText","Data":"蓝实《神农本草经》"}]},{"ID":"20240616122823-1bay53z","Type":"NodeParagraph","Properties":{"id":"20240616122823-1bay53z","updated":"20240616122823"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240616122823-a0aytso","Type":"NodeParagraph","Properties":{"id":"20240616122823-a0aytso","updated":"20240616122823"},"Children":[{"Type":"NodeText","Data":"主解诸毒，杀蛊蚑，注鬼，螫毒。久服，头不白，轻身。生平泽。"}]},{"ID":"20240616122823-aqi2483","Type":"NodeParagraph","Properties":{"id":"20240616122823-aqi2483","updated":"20240616122823"},"Children":[{"Type":"NodeText","Data":"《名医》曰：其茎叶可以染青，生河内。"}]},{"ID":"20240616122823-owbh3qn","Type":"NodeParagraph","Properties":{"id":"20240616122823-owbh3qn","updated":"20240616122823"},"Children":[{"Type":"NodeText","Data":"案《说文》云：葴马蓝也，蓝，染青草也；《尔雅》云：葴，马蓝；郭璞云：今大叶冬蓝也，《周礼》掌染草；郑注云：染草，蓝茜，象斗之属，《夏小正》五月启灌蓝；《毛诗》云：终朝采蓝，《笺》云，蓝，染草也。"}]},{"ID":"20240616122834-46meurh","Type":"NodeThematicBreak","Properties":{"id":"20240616122834-46meurh"}},{"ID":"20240616122835-k3jkdqn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122835-k3jkdqn","updated":"20240616122839"},"Children":[{"Type":"NodeText","Data":"蓝实《千金翼方》"}]},{"ID":"20240616122835-93h6lth","Type":"NodeParagraph","Properties":{"id":"20240616122835-93h6lth","updated":"20240616122835"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主解诸毒，杀蛊 疰鬼螫毒。久服头不白，轻身。其叶汁∶杀百药毒，解野狼毒、射罔毒。其茎叶可以染青。生河内平泽。"}]},{"ID":"20240616122855-kn9tr5q","Type":"NodeThematicBreak","Properties":{"id":"20240616122855-kn9tr5q"}},{"ID":"20240616122857-j0aazwt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122857-j0aazwt","updated":"20240616122900"},"Children":[{"Type":"NodeText","Data":"蓝实《本草衍义》"}]},{"ID":"20240616122857-ns0ehmj","Type":"NodeParagraph","Properties":{"id":"20240616122857-ns0ehmj","updated":"20240616122857"},"Children":[{"Type":"NodeText","Data":"即大蓝实也，谓之蓼蓝非是，《尔雅》所说是。解诸药等毒，不可阙也。实与叶两用。《注》不解实只解蓝叶，为未尽。经所说尽矣。蓝一本而有数色──刮竹、青绿、云碧、青蓝、黄，岂非青出于蓝而青于蓝者也。生叶汁解药毒，此即大叶蓝，又非蓼蓝也。蓼蓝，即堪揉汁，染翠碧。花成长穗，细小，浅红色。"}]},{"ID":"20240616122954-uy0npr2","Type":"NodeThematicBreak","Properties":{"id":"20240616122954-uy0npr2"}},{"ID":"20240616122955-9gy4iyt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122955-9gy4iyt","updated":"20240616123000"},"Children":[{"Type":"NodeText","Data":"蓝实《本草乘雅半偈》"}]},{"ID":"20240616122955-xp5h2zv","Type":"NodeParagraph","Properties":{"id":"20240616122955-xp5h2zv","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240616122955-uxrdsw6","Type":"NodeParagraph","Properties":{"id":"20240616122955-uxrdsw6","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，无毒。"}]},{"ID":"20240616122955-ntmlpu1","Type":"NodeParagraph","Properties":{"id":"20240616122955-ntmlpu1","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"【主治】主解诸毒，杀蛊 疰鬼螫毒。久服头不白，轻身。"}]},{"ID":"20240616122955-6ewq4kn","Type":"NodeParagraph","Properties":{"id":"20240616122955-6ewq4kn","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"【核】曰∶生河内平泽处。亦有蔬圃作畦子种者。凡五种，唯蓝实专取蓼蓝。蓼蓝，叶如蓼，三月生苗，五月开花成穗，淡红色，花实皆如蓼，岁可三刈，故先王仲夏，令民无刈蓝以染。郑玄云∶恐伤长养之气也。一种松蓝，叶如白菘。一种马蓝，叶如苦 ，即郭璞所谓大叶冬蓝，俗称板蓝者是也。花实并如蓼蓝，唯苗叶别异。一种吴蓝，长茎如蒿而花白，吴人种之；一种木蓝，长茎如决明，高者三四尺，分枝布叶，叶如槐叶，七月开淡红花，结角长寸许，累累如小豆角，子如马蹄决明而微小，迥与诸蓝不同，而作淀则一也。别有一种甘蓝，可作蔬食。而蓝淀者，掘地埋缸，以蓝水浸一宿，入锻石频搅万余下，澄清去水，则色青成淀。亦可干收，用染青碧，其搅掠浮沫，掠出阴干者，谓之靛花，即市卖之青黛也。此属锻石造作而成，慎勿轻用。世人以其色青，为入肝清解之药，谬甚矣。真青黛出波斯国，既不可得，不如用蓝实，或蓝叶，或自然汁之无间杂者良。"}]},{"ID":"20240616122955-1dx9ql2","Type":"NodeParagraph","Properties":{"id":"20240616122955-1dx9ql2","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"博议云∶蓝实久服头不白，盖春气在头，用其色以助春气之生，自然益头并及发矣。肝主色，自入为青，则凡病变于色者，极为允当。如痘，如丹，如斑，如血，如五色痢，如目赤目黄，如五脏热，先见颜与颊者，力可巽入乎肝。克制乎脾，为平热之轻剂也。观斑蜘蛛、应声虫、噎膈虫三案，亦奇异矣。每见种蓝人，日日扫虫，不扫即尽食之，此生虫之物，反杀虫者何？正巽以入之之义耳。盖人饮食之随气机变化，如大火聚，投之自无 类。蓝入胃，是虫之食也，则虫自翕聚，蓝随气机变化，而虫亦随之，一入气机，便无回避。慎哉顺境之好，当着眼也。"}]},{"ID":"20240616122955-r3bx7vx","Type":"NodeParagraph","Properties":{"id":"20240616122955-r3bx7vx","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"【 】曰∶蓝者生也，象万物生时之色也。酿之成淀，色成胜母，青出蓝而青于蓝者也。"}]},{"ID":"20240616122955-1kuvqi1","Type":"NodeParagraph","Properties":{"id":"20240616122955-1kuvqi1","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"肝主色，肝色青，当入肝。为肝之的药，亦可为肝之肾药，以多汁而气寒也；亦可为肝之心药，以味苦而性通彻也。以色以味，及性与气，咸得东南巽木之作用，而能洁齐万物者也。"}]},{"ID":"20240616122955-u13276y","Type":"NodeParagraph","Properties":{"id":"20240616122955-u13276y","updated":"20240616122955"},"Children":[{"Type":"NodeText","Data":"四时可植，一岁三刈，则生阳偏胜，而周甲唯春，故蓝从监，监者，监观四方者也。虫 疰鬼，皆杀厉所钟，死阴不洁之属，蓝能巽以入之，而与物为春，则杀厉之气齐洁，暖然似春仁之青出矣。久服则肝荣，肝荣则发华，动摇舒转，皆得所欲。蓝靛、青黛，总属分身，不若蓝实之包含，真无尽藏也。"}]},{"ID":"20240616122955-knjtwkt","Type":"NodeParagraph","Properties":{"id":"20240616122955-knjtwkt","updated":"20240616123019"},"Children":[{"Type":"NodeText","Data":"巽主入其性情也。洁齐万物，其功力也。洁可作 ，亦可作涤除清洗之洁，凡湿秽则虫生则净尽耳。"}]},{"ID":"20240616123031-tzdbhwn","Type":"NodeThematicBreak","Properties":{"id":"20240616123031-tzdbhwn"}},{"ID":"20240616123032-mbbdi1o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123032-mbbdi1o","updated":"20240616123038"},"Children":[{"Type":"NodeText","Data":"蓝实《本草蒙筌》"}]},{"ID":"20240616123032-oqspb6u","Type":"NodeParagraph","Properties":{"id":"20240616123032-oqspb6u","updated":"20240616123032"},"Children":[{"Type":"NodeText","Data":"味苦、甘，气寒。无毒。闽赣（闽系福建，赣属江西。）甚多，近道亦有。所产须分数种，（木蓝、马蓝、菘蓝、吴蓝俱不入药。）入药惟用蓼蓝。认状的真，与蓼无异。人家园圃，亦每种栽。秋采实曝干，微研碎煎服。杀虫蚑疰鬼恶毒，驱五脏六腑热烦。益心力，填骨髓。补虚聪耳目，利关节通窍。久服勿厌，黑发轻身。茎叶可作靛染青，生捣堪绞汁顿饮。散热风赤肿，愈疔毒金疮。和麝香点诸虫咬伤，单饮下追鳖瘕胀痛。中百药毒总解，生诸恶疮并驱。《衍义》云；蓝属水有木，能使散败之血分诸经络，故确诸毒而得效之速焉。又治小儿壮热成疳，更疗妇人产后血晕。消赤眼暴发，止吐衄时来。天行瘟疫热狂，并宜急取煎服。丹溪普济消毒饮中加板蓝根者，即此是也。造成青靛，亦入医方，火疹火丹，涂之即退。　又染瓮上浮沫（即靛花，）虽名青黛非真。真者出波斯国间，（真青黛形状与靛花不同类。）路远罕有；此却因功效相类，（《本经》注云：靛花主治与青黛同功。）特假为名。旋收曝干，色甚紫碧。市家多取干靛充卖，殊不知靛枯黑重实。花娇嫩轻浮，不可不细择尔。以水飞净灰脚，合丸制散随宜。治小儿发热惊痫，调小儿疳蚀消瘦。泻肝止暴注，下毒杀恶虫。收五脏郁火有功，清上膈痰火最效。驱时疫头痛，敛伤寒赤斑。水调服之，应如桴鼓。染成青布，堪剪烧灰，外科方中，亦每单用。敷恶疮经年不愈，贴炙疮出血难差。"}]},{"ID":"20240616123032-dsuxuox","Type":"NodeParagraph","Properties":{"id":"20240616123032-dsuxuox","updated":"20240616123032"},"Children":[{"Type":"NodeText","Data":"（谟）按：靛花虽非青黛，然治小儿疳蚀消瘦发热，屡有奇功。古传歌括一章，附后令人便览。歌曰：小儿杂病变成疳，不问强羸女与男。腹内时时如下痢，青黄赤白一般般。眼涩面黄鼻孔赤，谷道开张不欲看。烦热毛焦兼口渴，皮肤枯槁四肢瘫。唇焦呕逆不乳哺，壮热增寒卧不安。此方便是青黛散，取效犹如服圣丹。"}]},{"ID":"20240616122905-16lzl1c","Type":"NodeThematicBreak","Properties":{"id":"20240616122905-16lzl1c"}},{"ID":"20240616122906-z6qp520","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122906-z6qp520","updated":"20240616122910"},"Children":[{"Type":"NodeText","Data":"蓝实《新修本草》"}]},{"ID":"20240616122906-56c45tv","Type":"NodeParagraph","Properties":{"id":"20240616122906-56c45tv","updated":"20240616122906"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主解诸毒，杀蛊 疰鬼螫毒，久服头不白，轻身。其叶汁，杀百药毒，解野狼毒、射罔毒。其茎叶，可以染青。生河内平泽。"}]},{"ID":"20240616122906-dnb2eyu","Type":"NodeParagraph","Properties":{"id":"20240616122906-dnb2eyu","updated":"20240616122906"},"Children":[{"Type":"NodeText","Data":"此即今染 碧所用者。至解毒，人卒不能得生蓝汁，乃浣 布汁以解之，亦善。以汁涂五心又止烦闷。尖叶者为胜，甚疗蜂螫毒。"}]},{"ID":"20240616122906-eozy3dp","Type":"NodeParagraph","Properties":{"id":"20240616122906-eozy3dp","updated":"20240616122906"},"Children":[{"Type":"NodeText","Data":"〔谨案〕蓝实，有三种∶一种围径二寸许，浓三、四分，出岭南，云疗毒肿，太常名此草为木蓝子，如陶所引乃是菘蓝，其汁抨（普更切）为淀者辛者。此草汁疗热毒，诸蓝非比，且二种蓝，今并堪染，菘蓝为淀，惟堪染青；其蓼蓝不堪为淀，惟作碧色尔。"}]},{"ID":"20240616122916-d4k5q83","Type":"NodeThematicBreak","Properties":{"id":"20240616122916-d4k5q83"}},{"ID":"20240616122917-dc185vz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122917-dc185vz","updated":"20240616122926"},"Children":[{"Type":"NodeText","Data":"蓝实《本草图经》"}]},{"ID":"20240616122917-2lacn4m","Type":"NodeParagraph","Properties":{"id":"20240616122917-2lacn4m","updated":"20240616122922"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蓝实"},{"Type":"NodeText","Data":"，生河内平泽，今处处有之。人家蔬圃中作畦种莳，三月、四月生苗，高三、二尺许；叶似水蓼，花红白色；实亦若蓼子而大，黑色。五月、六月采实。按蓝有数种，有木蓝，出岭南，不入药；有菘蓝，可以为淀者，亦名马蓝，《尔雅》所谓∶“ ，马蓝”是也；有蓼蓝，但可染碧，而不堪作淀，即医方所用者也。又福州有一种马蓝，四时俱有，叶类苦益菜，土人连根采之，焙，捣下筛，酒服钱匕，治妇人败血，甚佳。又江宁有一种吴蓝，二、三月内生，如蒿状，叶青，花白。性寒，去热解毒，止吐血。此二种虽不类，而俱有蓝名。又陈留，此境人皆以种蓝染绀为业。蓝田弥望，黍稷不殖。至今近京种蓝特盛。云蓝汁治虫豸伤咬。刘禹锡《传信方》着其法云∶取大蓝汁一碗，入雄黄、麝香二物，随意看多少，细研，投蓝汁中，以点咬处，若是毒者，即并细服其汁，神异之极也。昔张荐员外，在剑南为张延赏判官，忽被斑蜘蛛咬项上，一宿，咬处有二道赤色，细如箸，绕项上，从胸前下至心，经两宿，头面肿疼，如数升碗大，肚渐肿，几至不救。张相素重荐，因出家财五百千，并荐家财又数百千，募能疗者。忽一人应召，云可治。张相初甚不信，欲验其方，遂令目前合药。其人云∶不惜方，当疗人性命耳，遂取大蓝汁一瓷碗，取蜘蛛投之蓝汁，良久，方出得汁中，甚困不能动。又别捣蓝汁，加麝香末，更取蜘蛛投之，至汁而死。又更取蓝汁、麝香，复加雄黄和之，更取一蜘蛛投汁中，随化为水。张相及诸人甚异之，遂令点于咬处。两日内，悉平愈。但咬处作小疮痂落如旧。又中品着青黛条云从胡国来，及太原、庐陵、南康等染淀，亦堪傅热毒等。染瓮上池沫，紫碧色者，同青黛功。"}]},{"ID":"20240616122846-ge04w7f","Type":"NodeThematicBreak","Properties":{"id":"20240616122846-ge04w7f"}},{"ID":"20240616122847-ihs1ev6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122847-ihs1ev6","updated":"20240616122851"},"Children":[{"Type":"NodeText","Data":"蓝实《医学入门》"}]},{"ID":"20240616122847-csd8q6d","Type":"NodeParagraph","Properties":{"id":"20240616122847-csd8q6d","updated":"20240616122847"},"Children":[{"Type":"NodeText","Data":"蓝实甘寒苦杀 ，解毒解结最适宜，叶主热狂并吐血，解毒杀虫更出奇。"}]},{"ID":"20240616122847-x8wuk1v","Type":"NodeParagraph","Properties":{"id":"20240616122847-x8wuk1v","updated":"20240616122847"},"Children":[{"Type":"NodeText","Data":"蓝字从监，月令仲夏无刈蓝，以伤生长之气；实，子也。无毒。主小儿 病鬼疰，解经络中结气及败血。"}]},{"ID":"20240616122847-gtzdwgw","Type":"NodeParagraph","Properties":{"id":"20240616122847-gtzdwgw","updated":"20240616122847"},"Children":[{"Type":"NodeText","Data":"叶汁，主天行热狂烦躁，吐血衄血，赤眼及小儿壮热、疳热、丹热，游风热肿疔肿头秃，一切热毒。解诸药毒，箭毒，金疮血闷，产后血晕。杀鳖瘕虫蛇伤，蜘蛛蜂螫毒，捣汁一碗，入雄黄、麝香少许，点咬处，或细服之。"}]},{"ID":"20240616122847-h96j0i7","Type":"NodeParagraph","Properties":{"id":"20240616122847-h96j0i7","updated":"20240616122847"},"Children":[{"Type":"NodeText","Data":"又治噎病不下食有虫者，单服其汁，虫化为水。真青布烧灰，敷恶疮经年不瘥，灸疮出血，令不中风。"}]},{"ID":"20240616122741-sa5j5ty","Type":"NodeThematicBreak","Properties":{"id":"20240616122741-sa5j5ty"}},{"ID":"20240616122813-cpwsovs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122813-cpwsovs","updated":"20240616122817"},"Children":[{"Type":"NodeText","Data":"蓝实《本经逢原》"}]},{"ID":"20240616122813-h52p4s3","Type":"NodeParagraph","Properties":{"id":"20240616122813-h52p4s3","updated":"20240616122813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大青、小青"}]},{"ID":"20240616122813-xcod3g8","Type":"NodeParagraph","Properties":{"id":"20240616122813-xcod3g8","updated":"20240616122813"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。有二种，大者曰大青，苗高如蓼。小者曰小青，叶光如景天。（向编在麻后，今并此。）"}]},{"ID":"20240616122813-r85sm5d","Type":"NodeParagraph","Properties":{"id":"20240616122813-r85sm5d","updated":"20240616122813"},"Children":[{"Type":"NodeText","Data":"《本经》解诸毒，杀蛊 疰鬼螫毒。"}]},{"ID":"20240616122813-fitfxm9","Type":"NodeParagraph","Properties":{"id":"20240616122813-fitfxm9","updated":"20240616122813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"《本经》取用蓝实，乃大青之子，是即所谓蓼蓝也。性禀至阴，其味苦寒，故能入肝。《本经》取治蛊疰诸毒，专于清解温热诸邪也，阳毒发斑咽痛必用之药。而茎叶性味不异，主治皆同。《日华子》治天行热狂，疔肿风疹。朱肱治发斑咽痛，有犀角大青汤、大青四物汤，皆取其叶，以治温热毒盛发斑之药，非正伤寒药也。盖大青泻肝胆之实火，正以祛心胃之邪热，所以小儿疳热、丹毒为要药。小青捣敷肿疖甚效，治血痢腹痛，杀百药毒，解野狼毒、射罔、斑蝥、砒石等毒。《千金》以蓝叶捣汁治腹中鳖瘕。夏子益《奇疾方》用板蓝汁治腹内应声虫。陈实功以蓝同贝母捣敷人面疮，皆取苦寒以散蕴结之热毒也。蓝淀以蓝浸地坑一宿，入锻石搅，澄去水为淀，其解诸毒，敷热疮之用则一；而杀虫之功更效，虫为下膈非此不除。今人以染缸水治噎膈，皆取其杀虫也。"}]},{"ID":"20240616122741-fj4fh3d","Type":"NodeThematicBreak","Properties":{"id":"20240616122741-fj4fh3d"}},{"ID":"20240616122804-sszh8do","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122804-sszh8do","updated":"20240616122808"},"Children":[{"Type":"NodeText","Data":"蓝实《冯氏锦囊秘录》"}]},{"ID":"20240616122804-xbatkgl","Type":"NodeParagraph","Properties":{"id":"20240616122804-xbatkgl","updated":"20240616122804"},"Children":[{"Type":"NodeText","Data":"禀天地至阴之精，其味苦、咸寒而无毒。故能去热除疳。一云∶兼甘、平，无毒。以其得土气之浓，盖诸毒遇土即解，故可善解诸毒。"}]},{"ID":"20240616122804-2ej1qo9","Type":"NodeParagraph","Properties":{"id":"20240616122804-2ej1qo9","updated":"20240616122804"},"Children":[{"Type":"NodeText","Data":"蓝实余蓝俱不入药，入药惟用蓼蓝。秋采实，晒干微研碎，煎服。杀虫疰疫鬼恶毒，驱五脏六腑热烦，益心力，填骨髓补虚，聪耳目，利关节，通窍。但虚寒人及久泻者，并腹中觉冷者忌之。茎叶可作靛染青，生捣绞汁饮，散风热赤肿，愈疔肿金疮，追鳖瘕胀痛，百药毒总解，诸恶疮并驱。《衍义》云∶蓝实水有木。能使散败之血分诸经络，故解毒最效。又治小儿壮热成疳，妇人产后血晕，消赤眼暴发，止吐衄时来，天行温疫热狂，并宜急取煎服。丹溪普济消毒饮中，加板兰根者，即此是也。其靛花名为青黛，宜合丸散。小儿疳热，消 泻肝下毒，杀虫，收五脏郁火，消上膈痰火并妙，更驱时疫头痛，敛伤寒赤斑。一切疳病，面黄鼻赤，毛焦唇焦，口舌生疮，皮肤枯槁，壮热等症，神奏奇功。虽凉而不伤脾胃，故疳痢疳痨并臻神效。"}]},{"ID":"20240616122741-nq2ccvs","Type":"NodeThematicBreak","Properties":{"id":"20240616122741-nq2ccvs"}},{"ID":"20240616122743-vn2ki3f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616122743-vn2ki3f","updated":"20240616122748"},"Children":[{"Type":"NodeText","Data":"蓝实《证类本草》"}]},{"ID":"20240616122743-a5n74pt","Type":"NodeParagraph","Properties":{"id":"20240616122743-a5n74pt","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主解诸毒，杀虫 ，（音其，小儿鬼也。）疰鬼，螫毒。久服头不白，轻身。其叶汁，杀百药毒，解野狼毒、射罔毒。其茎叶，可以染青。生河内平泽。"}]},{"ID":"20240616122743-ojz23sj","Type":"NodeParagraph","Properties":{"id":"20240616122743-ojz23sj","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此即今染 （音禁）碧所用者。至解毒，人卒不能得生蓝汁，乃浣 布汁以解之亦善。以汁涂五心，又止烦闷。尖叶者为胜，甚疗蜂螫毒。唐本注云∶蓝实有三种∶一种围径二寸许，浓三、四分。出岭南，云疗肿毒，太常名此草为木蓝子，如陶所引，乃是菘蓝，其汁抨（普更切）为淀（音殿）者。按《经》所用，乃是蓼蓝实也，其苗似蓼，而味不辛者。"}]},{"ID":"20240616122743-28y1myn","Type":"NodeParagraph","Properties":{"id":"20240616122743-28y1myn","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"此草汁疗热毒，诸蓝非比，且二种蓝，今并堪染，菘蓝为淀，唯堪染青。其蓼蓝不堪为淀，唯作碧色尔。臣禹锡等谨按蜀本图经云∶叶似水蓼，花红白色，子若蓼子而大，黑色。今所在下湿地有，人皆种之。尔雅云∶ ，马蓝。注∶今大叶冬蓝也。疏∶今为淀者是也。药性论云∶蓝实，君，味甘。能填骨髓，明耳目，利五脏，调六腑，利关节，治经络中结气，使人健，少睡，益心力。蓝汁止心烦躁，解蛊毒。日华子云∶吴蓝，味苦、甘，冷，无毒。治天行热狂，疔疮游风，热毒肿毒，风疹，除烦止渴，杀疳，解毒药、毒箭，金疮，血闷，虫蛇伤，毒刺，鼻洪，吐血，排脓，寒热头痛，赤眼，产后血晕，解金石药毒，解野狼毒、射罔毒，小儿壮热，热疳。陈藏器云∶苏云菘蓝造淀。按淀多是槐蓝。蓼蓝作者，入药胜槐蓝。淀寒。"}]},{"ID":"20240616122743-b6c0w6f","Type":"NodeParagraph","Properties":{"id":"20240616122743-b6c0w6f","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"敷热疮，解诸毒。滓，敷小儿秃疮。热肿初作，上沫堪染如青黛解毒。小儿丹热，和水服之。蓝有数种，蓼蓝最堪入药，甘蓝，北人食之，去热黄也。又云青布，味咸，寒。主解诸物毒，天行烦毒，小儿寒热，丹毒，并水渍取汁饮。烧作黑灰，敷恶疮，经年不瘥者，及灸疮止血，令不中风水。和蜡熏恶疮，入水不烂，熏嗽杀虫，熏虎野狼咬疮，出水毒。又于器中烧令烟出，以器口熏人中风水恶露等疮，行下得恶汁知痛痒，瘥。又入诸膏药，疗疔肿，狐刺等恶疮，又浸汁和生姜煮服，止霍乱。真者入用，假者不中。"}]},{"ID":"20240616122743-4q2lo3v","Type":"NodeParagraph","Properties":{"id":"20240616122743-4q2lo3v","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"图经曰∶蓝实，生河内平泽，今处处有之。人家蔬圃中作畦种莳，三月、四月生苗，高三、二尺许，叶似水蓼，花红白色，实亦若蓼子而大，黑色，五月、六月采实。按蓝有数种∶有木蓝，出岭南，不入药；有菘蓝，可以为淀者，亦名马蓝，《尔雅》所谓 ，马蓝是也；有蓼蓝，但可染碧，而不堪作淀，即医方所用者也。又福州有一种马蓝，四时俱有，叶类苦益菜，土人连根采之，焙，捣下筛，酒服钱匕，治妇人败血甚佳。又江宁有一种吴蓝，二、三月内生，如蒿状，叶青花白，性寒，去热解毒，止吐血。此二种虽不类，而俱有蓝名。又古方多用吴蓝者，或恐是此，故并附之。后汉·赵歧作《蓝赋》，其序云∶余就医偃师，道经陈留，此境人皆以种蓝染绀为业。蓝田弥望，黍稷不殖。至今近京种蓝特盛，云蓝汁治虫豸伤咬。刘禹锡《传信方》着其法云∶取大蓝汁一碗，入雄黄、麝香二物，随意看多少，细研，投蓝汁中，以点咬处，若是毒者，即并细服其汁，神异之极也。昔张荐员外在剑南为张廷赏判官，忽被斑蜘蛛咬项上，一宿，咬处有二道赤色，细如箸，绕项上，从胸前下至心；经两宿，头面肿疼如数升碗大，肚渐肿，几至不救。张相素重荐，因出家财五百千，并荐家财又数百千，募能疗者。忽一人应召，云可治。张相初甚不信，欲验其方，遂令目前合药。其人云∶不惜方，当疗人性命耳。遂取大蓝汁一瓷碗，取蜘蛛投之蓝汁，良久，方出得汁中，甚困不能动。又别捣蓝汁，加麝香末，更取蜘蛛投之，至汁而死。又更取蓝汁、麝香，复加雄黄和之，更取一蜘蛛投汁中，随化为水。张相及诸人甚异之，遂令点于咬处。两日内悉平愈。"}]},{"ID":"20240616122743-wiv3kwr","Type":"NodeParagraph","Properties":{"id":"20240616122743-wiv3kwr","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"但咬处作小疮痂落如旧。又中品着青黛条云∶从胡国来，及太原、庐陵、南康等染淀，亦堪敷热毒等。染瓮上池沫，紫碧色者，同青黛功。"}]},{"ID":"20240616122743-bf0itx3","Type":"NodeParagraph","Properties":{"id":"20240616122743-bf0itx3","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治时气热毒，心神烦躁。用蓝淀半大匙，以新汲水一盏服。又方∶治小儿中蛊下血欲死。捣青蓝汁，频频服半合。千金方∶治唇上生疮，连年不瘥。以八月蓝叶一斤，捣取汁洗，不过三日瘥。又方∶治自缢死，以蓝汁灌之。又极须安定其心，徐缓解，慎勿割断绳，抱取心下犹温者，刺鸡冠血滴着口中，即活也，男雌女雄。又方∶熊伤人疮，烧青布熏疮口毒出，仍煮葛根，令浓汁以洗疮，日十度。并捣葛根为散，煮葛根汁服方寸匕，日五服，瘥。又方∶治鳖症。蓝叶一斤，捣以水三升，绞取汁，服一升，日二。千金翼∶治急疳蚀鼻口，数日欲死。取蓝淀敷之令遍，日十度，夜四度，瘥。肘后方∶治人身体重，小腹急热上冲胸，头重不能举，眼中生 ，膝胫拘急欲死。取蓝一把，水五升，鼠屎两头尖者二七枚。煮取二升，尽服之，温覆取汗。葛氏方∶新被毒箭。捣蓝青绞汁饮，并敷疮上。如无蓝，可渍青布绞汁饮之，亦以治疮中。又方∶中水毒。捣蓝青汁，以少水和，敷头面身上令匝。又方∶服药过剂烦闷及中毒烦闷欲死，捣蓝取汁服数升。无蓝，浣清绢取汁饮亦佳。又方∶食杏仁中毒，蓝子汁解之。梅师方∶治虎伤人疮。取青布紧卷作缠，烧头纳竹筒中，射疮口，令烟熏入疮中，佳。又方∶治上气咳嗽，呷呀息气，喉中作声，唾粘。以蓝实叶水浸良久，捣绞取汁一升，空腹频服。须臾以杏仁研取汁，煮粥食之。一、两日将息，根据前法更服，吐痰尽方瘥。子母秘录治小儿赤痢。捣青蓝汁二升，分四服。又方∶治小儿丹，蓝淀敷，热即易。广五行记永徽中，绛州僧病噎不下食。告弟子，吾死之后，便可开吾胸喉，视有何物，言终而卒。弟子依言而开视，胸中得一物，形似鱼而有两头，遍体是肉鳞。弟子致器中，跳跃不止。戏以诸味，皆随化尽。时夏中蓝盛作淀，有一僧以淀致器中，此虫遂绕器中走，须臾化为水矣。"}]},{"ID":"20240616122743-c88lkd0","Type":"NodeParagraph","Properties":{"id":"20240616122743-c88lkd0","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"衍义曰∶蓝实，即大蓝实也。谓之蓼蓝非是，《尔雅》所说是。解诸药等毒，不可阙也。"}]},{"ID":"20240616122743-j8y6c0b","Type":"NodeParagraph","Properties":{"id":"20240616122743-j8y6c0b","updated":"20240616122743"},"Children":[{"Type":"NodeText","Data":"实与叶两用，注不解实，只解蓝叶为未尽。《经》所说尽矣。蓝一本而有数色，刮竹青、绿云、碧青、蓝黄，岂非青出于蓝而青于蓝者也。生叶汁解药毒。此即大叶蓝，又非蓼蓝也。蓼蓝即堪揉汁染翠碧，花成长穗，细小，浅红色。"}]},{"ID":"20240616123153-yk4i4m6","Type":"NodeThematicBreak","Properties":{"id":"20240616123153-yk4i4m6"}},{"ID":"20240616123154-n6nk609","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123154-n6nk609","updated":"20240616123158"},"Children":[{"Type":"NodeText","Data":"青黛《本草害利》"}]},{"ID":"20240616123154-vlb5vk7","Type":"NodeParagraph","Properties":{"id":"20240616123154-vlb5vk7","updated":"20240616123154"},"Children":[{"Type":"NodeText","Data":"〔害〕性凉，中寒者勿使，即阴虚有热者，亦不宜用。解毒治火，固其所长，古方多有用于诸血证者。使非血分实热而病，由于阴虚内热，阳无所附，火空上炎，发为吐衄咯血唾血等证，用之非宜，愈增其病，宜详辨之。"}]},{"ID":"20240616123154-4v2xhor","Type":"NodeParagraph","Properties":{"id":"20240616123154-4v2xhor","updated":"20240616123154"},"Children":[{"Type":"NodeText","Data":"〔利〕咸寒清肝火，解郁结，治中下焦蓄蕴风热，吐血，理幼稚惊疳，敷热毒恶肿。染靛功同。"}]},{"ID":"20240616123154-xmkz8mn","Type":"NodeParagraph","Properties":{"id":"20240616123154-xmkz8mn","updated":"20240616123154"},"Children":[{"Type":"NodeText","Data":"〔修治〕真者从波斯国来，不可得也。今用干靛花，取娇碧者，每斤淘取一两亦佳，内多石灰，故须淘净。"}]},{"ID":"20240616123202-74o99wp","Type":"NodeThematicBreak","Properties":{"id":"20240616123202-74o99wp"}},{"ID":"20240616123203-8rflj4r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123203-8rflj4r","updated":"20240616123207"},"Children":[{"Type":"NodeText","Data":"青黛《本草撮要》"}]},{"ID":"20240616123203-eabrstn","Type":"NodeParagraph","Properties":{"id":"20240616123203-eabrstn","updated":"20240616123203"},"Children":[{"Type":"NodeText","Data":"味咸寒．入足厥阴经．功专泻肝．散五脏郁火．解中下焦蓄蕴风热．治伤寒发斑．得杏仁、柿饼治咯血．得硼砂、冰片名青黛散．吹喉痛．"}]},{"ID":"20240616123212-pj0urwt","Type":"NodeThematicBreak","Properties":{"id":"20240616123212-pj0urwt"}},{"ID":"20240616123213-ma50hjq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123213-ma50hjq","updated":"20240616123218"},"Children":[{"Type":"NodeText","Data":"青黛《本草衍义》"}]},{"ID":"20240616123213-8k5ms8o","Type":"NodeParagraph","Properties":{"id":"20240616123213-8k5ms8o","updated":"20240616123213"},"Children":[{"Type":"NodeText","Data":"青黛乃蓝为之。有一妇人患脐下腹上、下连二阴遍满生湿疮，状如马瓜疮，他处并无，热痒而痛，大小便涩，出黄汁，食亦减，身面微肿。医作恶疮治，用鳗鲡鱼、松脂、黄丹之类。药涂上，疮愈热，痛愈甚。治不对，故如此。问之，此人嗜酒，贪啖，喜鱼蟹发风等物。令急用温水洗拭去膏药，寻以马齿苋四两，烂研细，入青黛一两，再研匀，涂疮上，即时热减，痛痒皆去。仍服八政散，日三服，分败客热。每涂药，得一时久。药已干燥，又再涂新湿药。凡如此，及日减三分之一，五日减三分之二，自此二十日愈。既愈而问曰∶此疮何缘至此？曰∶中、下焦蓄风热毒瓦斯，若不出，当作肠痈内痔，仍常须禁酒及发风物。然不能禁酒，后果然患内痔。"}]},{"ID":"20240616123257-udtc54h","Type":"NodeThematicBreak","Properties":{"id":"20240616123257-udtc54h"}},{"ID":"20240616123258-vjur66y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123258-vjur66y","updated":"20240616123306"},"Children":[{"Type":"NodeText","Data":"青黛《增广和剂局方药性总论》"}]},{"ID":"20240616123258-alnap38","Type":"NodeParagraph","Properties":{"id":"20240616123258-alnap38","updated":"20240616123258"},"Children":[{"Type":"NodeText","Data":"味咸，寒，无毒。主解诸药毒，小儿诸热，惊痫发热，天行头痛寒热，并水研服。亦敷热疮，恶肿，金疮，下血，蛇犬等毒。《药性论》云∶君。味甘，平。能解小儿疳热消杀虫。又治发豌豆疮。杀∶恶虫物化为水。"}]},{"ID":"20240616123420-wvl4iiz","Type":"NodeThematicBreak","Properties":{"id":"20240616123420-wvl4iiz"}},{"ID":"20240616123421-qxwt72u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123421-qxwt72u","updated":"20240616123425"},"Children":[{"Type":"NodeText","Data":"青黛《医学入门》"}]},{"ID":"20240616123421-o5tkt0f","Type":"NodeParagraph","Properties":{"id":"20240616123421-o5tkt0f","updated":"20240616123421"},"Children":[{"Type":"NodeText","Data":"青黛甘咸性气寒，收五脏火尤泻肝，消食解毒消疮肿，能治儿疳病百般。"}]},{"ID":"20240616123421-z0jsvtd","Type":"NodeParagraph","Properties":{"id":"20240616123421-z0jsvtd","updated":"20240616123421"},"Children":[{"Type":"NodeText","Data":"青色，古用以画眉，故曰黛，即靛花也。无毒。能收五脏郁火，尤泻肝火，消食积，解诸药毒。摩敷热疮恶肿、金疮下血、蛇犬等咬，小儿惊痫，发热毛焦，鼻干皮枯，面黄肢瘦，腹胀泻痢，百般疳证，效。"}]},{"ID":"20240616123348-jsd129a","Type":"NodeThematicBreak","Properties":{"id":"20240616123348-jsd129a"}},{"ID":"20240616123349-tnvnyjn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123349-tnvnyjn","updated":"20240616123353"},"Children":[{"Type":"NodeText","Data":"青黛《本草便读》"}]},{"ID":"20240616123349-of1cnhq","Type":"NodeParagraph","Properties":{"id":"20240616123349-of1cnhq","updated":"20240616123349"},"Children":[{"Type":"NodeText","Data":"清肝火之结邪．丹毒虫疮．青贝克汉姆寒归血分．治儿疳之郁热．斑疹瘟疫．轻浮凉苦到金家．（青黛即靛青之沫．和锻石粉为之．无灰者绝少．大抵其功用与靛叶相近．虽色青入肝．而轻浮咸寒之性．功用概可想见．故清火解毒．杀虫治疮．即可为青黛赞之．青黛本专入肝．治血分郁火．以其轻浮上达．故又能入肺胃．降瘀热．治温疫斑疹．咽喉口舌等疾．如阴虚之火．及大便不实．脾胃不足者．勿用．）"}]},{"ID":"20240616123401-zngvj1s","Type":"NodeThematicBreak","Properties":{"id":"20240616123401-zngvj1s"}},{"ID":"20240616123402-n7rh1q4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123402-n7rh1q4","updated":"20240616123412"},"Children":[{"Type":"NodeText","Data":"青黛《本草纲目》"}]},{"ID":"20240616123402-x0w4rk2","Type":"NodeParagraph","Properties":{"id":"20240616123402-x0w4rk2","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"「释名」靛花、青蛤粉。"}]},{"ID":"20240616123402-hsghklg","Type":"NodeParagraph","Properties":{"id":"20240616123402-hsghklg","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"「气味」咸、寒、无毒。"}]},{"ID":"20240616123402-ibn7amh","Type":"NodeParagraph","Properties":{"id":"20240616123402-ibn7amh","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616123402-k1kzn70","Type":"NodeParagraph","Properties":{"id":"20240616123402-k1kzn70","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"1、肺热咯血。用青黛一两、杏仁（以牡晟粉炒过）一两，一起研匀，加黄蜡化和做成三十个饼子，称为“青饼子”。每服一饼，以干柿半个夹定，外用湿纸裹好，煨香嚼吃，米粥送下。一天吃三次。"}]},{"ID":"20240616123402-r8as0je","Type":"NodeParagraph","Properties":{"id":"20240616123402-r8as0je","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"2、小儿疳痢。随小儿年龄大小，取适量青黛以水研匀服下，有效。《宫气方》说：“孩儿杂病变成疳，不问强羸女与男。烦热毛鼻口燥，皮肤枯槁四肢瘫，腹中时时更下痢，青黄赤白一般般。眼涩面黄鼻孔赤，谷道开张不可看，此方便是“青黛散”，孩儿面病服这安。”"}]},{"ID":"20240616123402-i2t2vjn","Type":"NodeParagraph","Properties":{"id":"20240616123402-i2t2vjn","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"3、烂眼。用青黛、黄连泡水洗。"}]},{"ID":"20240616123402-vd6waia","Type":"NodeParagraph","Properties":{"id":"20240616123402-vd6waia","updated":"20240616123402"},"Children":[{"Type":"NodeText","Data":"4、瘰疬未穿。用青黛、马齿苋同捣烂，每日敷患处。"}]},{"ID":"20240616123335-g20cuki","Type":"NodeThematicBreak","Properties":{"id":"20240616123335-g20cuki"}},{"ID":"20240616123336-98x45ti","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123336-98x45ti","updated":"20240616123341"},"Children":[{"Type":"NodeText","Data":"青黛《药鉴》"}]},{"ID":"20240616123336-l4hx60u","Type":"NodeParagraph","Properties":{"id":"20240616123336-l4hx60u","updated":"20240616123336"},"Children":[{"Type":"NodeText","Data":"气寒，味苦甘，无毒。驱时疫头痛，敛伤寒赤斑。能收五脏之郁火，能消膈上之热痰。"}]},{"ID":"20240616123336-9i00tcb","Type":"NodeParagraph","Properties":{"id":"20240616123336-9i00tcb","updated":"20240616123336"},"Children":[{"Type":"NodeText","Data":"泻肝火，止惊痫。消食积，杀诸恶虫尽化为水。又治小儿疳痢羸瘦，毛焦烦热。歌曰，烦热毛焦口鼻干，皮肤枯槁四肢摊。腹中时时更下痢，青白赤黄一般般。眼涩面黄鼻孔赤，谷道开张不欲看。忽然泻下成疳积，又且浓溶一团团。唇焦呕吐不乳哺，壮热增寒卧不安。此方便是青黛散，取效犹如服圣丹。"}]},{"ID":"20240616123325-tmfw4qz","Type":"NodeThematicBreak","Properties":{"id":"20240616123325-tmfw4qz"}},{"ID":"20240616123326-c9x0p9p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123326-c9x0p9p","updated":"20240616123330"},"Children":[{"Type":"NodeText","Data":"青黛《本草求真》"}]},{"ID":"20240616123326-qskarll","Type":"NodeParagraph","Properties":{"id":"20240616123326-qskarll","updated":"20240616123326"},"Children":[{"Type":"NodeText","Data":"（隰草）大泻肝经郁火"}]},{"ID":"20240616123326-g4sy695","Type":"NodeParagraph","Properties":{"id":"20240616123326-g4sy695","updated":"20240616123326"},"Children":[{"Type":"NodeText","Data":"青黛（专入肝）。系蓝靛浮沫。搅澄。掠出取干而成。味咸性寒。色青。大泻肝经实火。及散肝经火郁。（衍义曰。一妇患脐腹二阴。遍生湿疮。热痒而痛。出黄汗。二便涩。用鳗鲡松脂黄丹之类涂之。热痛愈甚。其妇嗜酒。喜食鱼虾发风之物。乃用马齿苋四两。研烂。入青黛一两。和涂。热痛皆去。仍服八正散而愈。此中下焦蓄蕴风热毒瓦斯。若不出。当作肠风内痔。妇不能禁酒物。果仍发痔。）故凡小儿风热惊痫。疳毒丹热痈疮。蛇犬等毒。金疮血出。噎膈虫食。并天行头痛。瘟疫热毒发斑。吐血咯血痢血等症。或应作丸为衣。或用为末干渗。或同水调敷。或入汤同服。或作饼子投治。（如圣饼子治咯血。用青黛同杏仁研置柿饼中煨食。）皆取苦寒之性。以散风郁燥结之义。即云功与蓝等。而止血拔毒之功。与治膈化蛊之力。似较蓝而更胜也。和溺白 冰片。吹口疳最妙。取娇碧者。水飞净锻石用。蓝靛兼有锻石。敷疮杀虫最奇。蛊属下膈。非此不除。蓝叶与茎。即名大青。大泻肝胆实火。以祛心胃热毒。故于时疾阳毒发斑喉痹等症最利。（斑由里实表虚而得。故斑得以透肌。斑如疹子者其热轻。斑如锦纹者其热重。斑如紫黑者其热重而胃烂也。古治赤斑烦疼。有犀角大青汤。）蓝子止能解毒除疳。故于鬼疫蛊毒之症最妙。"}]},{"ID":"20240616123310-365ylld","Type":"NodeThematicBreak","Properties":{"id":"20240616123310-365ylld"}},{"ID":"20240616123311-2rlmgm9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123311-2rlmgm9","updated":"20240616123316"},"Children":[{"Type":"NodeText","Data":"青黛《本草新编》"}]},{"ID":"20240616123311-bgiaxq9","Type":"NodeParagraph","Properties":{"id":"20240616123311-bgiaxq9","updated":"20240616123311"},"Children":[{"Type":"NodeText","Data":"青黛，即靛之干者。《本草》辨其出波斯国者，始真转误矣。味苦，气寒，无毒。杀虫除热，能消赤肿疔毒，兼疗金疮，余无功效。他书盛称之，皆不足信也。惟喉痹之症，倘系实火，可以内外兼治，而《本草》各书反不言及。大约此物，止可为佐使者也。惟杀虫可以多用，只消一味，用至一两，研末，加入神曲三钱、使君子三钱，同为丸，一日服尽，虫尽死矣。（〔批〕青黛杀虫方神效，试之屡验。）他病不必多用。盖青黛气寒，能败胃气，久服，则饮食不能消也。"}]},{"ID":"20240616123311-5xv32p0","Type":"NodeParagraph","Properties":{"id":"20240616123311-5xv32p0","updated":"20240616123311"},"Children":[{"Type":"NodeText","Data":"或问青黛微物，先生亦慎用之，毋乃太过乎？嗟乎。用药一味之失，便杀一人，况发明《本草》，而可轻言之乎。故物虽至微，不敢忽也。"}]},{"ID":"20240616123311-k67g03a","Type":"NodeParagraph","Properties":{"id":"20240616123311-k67g03a","updated":"20240616123311"},"Children":[{"Type":"NodeText","Data":"或问青黛物虽至微，仲景公用以治发斑之伤寒，何子未之言及？曰∶吾前言赤肿，即发斑之别名，非满身肿起为赤肿也。青黛至微，而能化斑者，以其善凉肺金之气。肺主皮毛，皮肤之发斑，正肺之火也。然而发斑，又不止肺火，必挟胃火而同行，青黛又能清胃火，仲景公所以一物而两用之，退肺、胃之火，自易解皮肤之斑矣。"}]},{"ID":"20240616123242-q5mvvzv","Type":"NodeThematicBreak","Properties":{"id":"20240616123242-q5mvvzv"}},{"ID":"20240616123244-vwhmp83","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123244-vwhmp83","updated":"20240616123249"},"Children":[{"Type":"NodeText","Data":"青黛《本草从新》"}]},{"ID":"20240616123244-0kuh1yt","Type":"NodeParagraph","Properties":{"id":"20240616123244-0kuh1yt","updated":"20240616123244"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻肝、散郁火．"}]},{"ID":"20240616123244-fjcpkb9","Type":"NodeParagraph","Properties":{"id":"20240616123244-fjcpkb9","updated":"20240616123244"},"Children":[{"Type":"NodeText","Data":"咸寒．色青泻肝．散五脏郁火．解中下焦蓄蕴风热．（衍义曰∶一妇患脐腹二阴遍生湿疮、热痒而痛、出黄汁、二便涩、用鳗鲡、松脂、黄丹之类涂之、热痛愈甚、其妇嗜酒、喜食鱼虾发风之物、乃用马齿苋四两、研烂、青黛一两、和涂、热痛皆去、仍服八正散而愈、此中下焦蓄蕴风热、毒瓦斯若不出、当病肠风内痔、妇不能禁酒物、果发痔．）治伤寒发斑．血痢咯血．（合杏仁研、置柿饼中煨食、名圣饼子、治咯血．）小儿惊痫疳热．丹热．敷痈疮蛇犬毒．性凉．中寒者勿使．即阴虚而有热者．亦不宜用．真者从波斯国来．不可得也．今用干靛两．亦佳．（内多锻石、故须淘净．）"}]},{"ID":"20240616123232-px0ol5p","Type":"NodeThematicBreak","Properties":{"id":"20240616123232-px0ol5p"}},{"ID":"20240616123233-zm3qz1o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123233-zm3qz1o","updated":"20240616123237"},"Children":[{"Type":"NodeText","Data":"青黛《本草备要》"}]},{"ID":"20240616123233-hnpna3b","Type":"NodeParagraph","Properties":{"id":"20240616123233-hnpna3b","updated":"20240616123233"},"Children":[{"Type":"NodeText","Data":"泻肝，散郁火"}]},{"ID":"20240616123233-bb3u51j","Type":"NodeParagraph","Properties":{"id":"20240616123233-bb3u51j","updated":"20240616123233"},"Children":[{"Type":"NodeText","Data":"咸寒，色青泻肝。散五脏郁火，解中、下焦蓄蕴风热（《衍义》曰∶一妇患脐、腹、二阴遍生湿疮，热痒而痛，出黄汁，二便涩。用鳗鲡、松脂、黄丹之类涂之，热痛愈甚。其妇嗜酒，喜食鱼、虾发风之物。乃用马齿苋四两研烂，入青黛一两和涂，热痛皆去，仍服八正散而愈。此中、下焦蓄蕴风热。毒瓦斯若不出，当作肠风、内痔。妇不能禁酒物，果仍发痔）"}]},{"ID":"20240616123233-mx36shh","Type":"NodeParagraph","Properties":{"id":"20240616123233-mx36shh","updated":"20240616123233"},"Children":[{"Type":"NodeText","Data":"。"}]},{"ID":"20240616123233-jgkywhq","Type":"NodeParagraph","Properties":{"id":"20240616123233-jgkywhq","updated":"20240616123233"},"Children":[{"Type":"NodeText","Data":"治伤寒发斑，吐咯血痢（阴虚火炎者忌用。合杏仁研，置柿饼中煨食，名圣饼子，治咯血）。小儿惊痫，疳热丹热，敷痈疮、蛇犬毒。"}]},{"ID":"20240616123233-08ptinj","Type":"NodeParagraph","Properties":{"id":"20240616123233-08ptinj","updated":"20240616123233"},"Children":[{"Type":"NodeText","Data":"即靛花。取娇碧者，水飞净用（内多锻石，故须淘净）。"}]},{"ID":"20240616123222-6k3g01q","Type":"NodeThematicBreak","Properties":{"id":"20240616123222-6k3g01q"}},{"ID":"20240616123223-dpco2ny","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123223-dpco2ny","updated":"20240616123227"},"Children":[{"Type":"NodeText","Data":"青黛《得配本草》"}]},{"ID":"20240616123223-2o0rlxe","Type":"NodeParagraph","Properties":{"id":"20240616123223-2o0rlxe","updated":"20240616123223"},"Children":[{"Type":"NodeText","Data":"咸，寒。入足厥阴、太阴经血分。除郁火，解热毒。杀小儿疳虫，散时疫赤斑，消膈痰，止血痢。配川连，洗风热眼。佐蒲黄，治重舌胀。冷水调服，治内热吐血。入四物汤，治产后发狂。入马齿苋，捣敷瘰 未穿。合黄柏末，掺耳疳出汁。"}]},{"ID":"20240616123223-w5w3ri3","Type":"NodeParagraph","Properties":{"id":"20240616123223-w5w3ri3","updated":"20240616123223"},"Children":[{"Type":"NodeText","Data":"水飞净用。阴虚火炎者禁用。"}]},{"ID":"20240616123455-gxed8v6","Type":"NodeThematicBreak","Properties":{"id":"20240616123455-gxed8v6"}},{"ID":"20240616123456-l8cljyo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616123456-l8cljyo","updated":"20240616123500"},"Children":[{"Type":"NodeText","Data":"青黛《本草述钩元》"}]},{"ID":"20240616123535-m3slsps","Type":"NodeParagraph","Properties":{"id":"20240616123535-m3slsps","updated":"20240616123537"},"Children":[{"Type":"NodeText","Data":"波斯青黛，是外国蓝靛花。既不可得，则中国靛花亦可用。（濒湖）　真青黛形状，与靛花不同类。今因其罕有，而靛花功效亦同，特假为名。旋收曝干，色甚紫碧。市家多取干靛充卖，顾干靛枯黑重实，靛花娇嫩轻浮，亦殊易别。（《仙制药性》）"}]},{"ID":"20240616123533-45fot4d","Type":"NodeParagraph","Properties":{"id":"20240616123533-45fot4d","updated":"20240616123539"},"Children":[{"Type":"NodeText","Data":"味咸甘平，气寒。专治小儿疳蚀羸瘦，发热疳痢，杀疳虫，并小儿丹毒，解诸热惊痫。能收五脏郁火，解热毒，泻肝消食积。（丹溪）　大略主治肝热，及解肺胃热。（嵩）　方书治中风头风胁痛，阳毒发斑，瘛疭颤振眩晕，咳血久嗽，呕吐舌衄，鼻口唇齿舌咽喉诸治甚多，下及㿗疝。一妇人脐腹上下，连二阴，遍生湿疮，状如马瓜疮，痒而痛，出黄汁，他处并无。大小便涩，食亦减，身面微肿。医作恶疮治，用鳗鲡鱼、松脂、黄丹之药涂之，热痛甚。询知其人嗜酒，喜食鱼蟹发风等物。急令洗去其药，以马齿苋四两，杵烂，入青黛一两，研匀涂之。即时热减，痛痒皆去。仍以八正散日三服之，分败客热。药干即上，如此渐减，二十日愈。此盖中下焦蓄风热毒气也，若不出，当作肠痈内痔。仍须禁酒色发风等物。（宗奭）　禀水土阴寒之气以生，又得土气之厚，故性味咸寒甘平而专解热毒。（仲淳）　心口热痛，姜汁调一钱服之。肺热咯血。青黛一两，杏仁用牡蛎粉炒过一两，研匀，黄蜡化和，作三十饼。每服一饼，以干柿半个夹定，湿纸裹，煨香嚼食，粥饮送下，日三服。"}]},{"ID":"20240616123533-svyqpwk","Type":"NodeParagraph","Properties":{"id":"20240616123533-svyqpwk","updated":"20240617115328"},"Children":[{"Type":"NodeText","Data":"〔论〕草木之茎叶无弗青者，而兹物独显诸用。由蓝从春夏之交生苗，即以五六月结实，大得乎长养之气，而生阳偏胜。（月令仲夏无刈蓝，恐伤长养之气也。）故其自入为青之用，显于设色，是大布生阳之化，犹所谓履端于始也。甄氏谓其通关节，治经络结气，丹溪谓其能收五脏郁火，皆在乎此。夫关节通，经络结气散，则五脏之郁火亦散，是以散为收，收即云收雾卷之收也。盖是物取精于水，长养于火，以毕达其木之用。木之用达，则水火合和之气毕达。举五脏之郁为火者，皆由此而达之矣。其治疗虽及五脏，然具肝之体，达肝之用。而用之所及，大都肺胃为多。至所谓收郁火，非收火邪之郁结也，乃肝不得司其气化，而真阳为邪所并耳。用此以大布生阳之气，则肝之真气得，而郁者若失矣。所以不曰散，而曰收也。阅古方中风头风之治，或同于寒剂，或同于温剂，以其能在达生阳之气，而不在散火邪之郁，故寒温咸宜。且丹溪又谓青黛能消食积，若其性大寒，何以消食积耶？然则绝无与于火热乎？曰：肝气之郁，需次即能化火。但青黛之所主者，在火之先耳。其为达肝之郁气，不等于香附、青皮之疏泄，以能大布生阳之气以行也。何以为解毒的剂？曰：正气流行，则邪气自然涣释也。何以于身半以上天气之治较多？曰：此正生阳之气化上达于天之征也。抑何以杀虫最效？曰：凡物莫不以气相感、气相制。诸虫生于风木，而化于湿土，多由死阴以滞血。此味以生阳之气，达其用于土，能使败血分归经络，则何风眚之不除，而诸虫之不化为水乎？　又按蓝靛由石炭合成者，其拔毒杀虫之功，殊胜于蓝。至于解内热之毒，不如直用蓝汁与板蓝根为得。昔有头上被斑蜘蛛咬，越宿后，毒处赤色二道，细如箸，绕项上，从胸前下至心经。两宿头面肿大而疼，肚腹渐肿，几至不救。乃取蓝汁一碗，投蜘蛛至汁而死。又取蓝汁加麝香、雄黄，更投一蛛，随化为水。因取其汁点于咬处，两日而平。是杀虫有征矣。"}]},{"ID":"20240616123533-4t5ovah","Type":"NodeParagraph","Properties":{"id":"20240616123533-4t5ovah","updated":"20240616123544"},"Children":[{"Type":"NodeText","Data":"青黛治血分实热，若吐衄咯唾，由于阴虚阳越，火空上炎而发者，此味便非中的之剂，临证审之。（仲淳）按血证所因不同，此味惟收五脏之郁火尔。"}]},{"ID":"20240616123533-i57jdya","Type":"NodeParagraph","Properties":{"id":"20240616123533-i57jdya","updated":"20240616123547"},"Children":[{"Type":"NodeText","Data":"〔修治〕但取淀桶中浮起者，晒干，用时水飞去脚。缘中有石灰，宜飞净服饵也。若外敷，则靛亦可用，并其脚不去亦可。"}]},{"ID":"20240607113937-zzyxa1n","Type":"NodeThematicBreak","Properties":{"id":"20240607113937-zzyxa1n"}},{"ID":"20240607114125-pngwokp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114125-pngwokp","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"《中国药典》：青黛"}]},{"ID":"20240607114125-z7uahb4","Type":"NodeParagraph","Properties":{"id":"20240607114125-z7uahb4","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114125-2vszd5z","Type":"NodeParagraph","Properties":{"id":"20240607114125-2vszd5z","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Dài"}]},{"ID":"20240607114125-4wc4uzj","Type":"NodeParagraph","Properties":{"id":"20240607114125-4wc4uzj","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114125-fckjswo","Type":"NodeParagraph","Properties":{"id":"20240607114125-fckjswo","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 靛、靛花、靛沫、蓝靛"}]},{"ID":"20240607114125-961qg0w","Type":"NodeParagraph","Properties":{"id":"20240607114125-961qg0w","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607114125-bp91edh","Type":"NodeParagraph","Properties":{"id":"20240607114125-bp91edh","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" INDIGO NATURALIS"}]},{"ID":"20240607114125-205jq4y","Type":"NodeParagraph","Properties":{"id":"20240607114125-205jq4y","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114125-6cfoxpy","Type":"NodeParagraph","Properties":{"id":"20240607114125-6cfoxpy","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 本品为爵床科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"马蓝"},{"Type":"NodeText","Data":"Baphicacanthus cusia （Nees）Bremek.、蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蓼蓝"},{"Type":"NodeText","Data":"Polygonum tinctorium Ait.或十字花科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菘蓝"},{"Type":"NodeText","Data":"Isatis indigotica Fort.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶或茎叶经加工制得的干燥粉末或团块"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607114125-2v949b8","Type":"NodeParagraph","Properties":{"id":"20240607114125-2v949b8","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607114125-0rs0e0m","Type":"NodeParagraph","Properties":{"id":"20240607114125-0rs0e0m","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 本品为深蓝色的粉末，体轻，易飞扬；或呈不规则多孔性的团块，用手搓捻即成细末。微有草腥气，味淡。"}]},{"ID":"20240607114125-if274x5","Type":"NodeParagraph","Properties":{"id":"20240607114125-if274x5","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607114125-nr28efp","Type":"NodeParagraph","Properties":{"id":"20240607114125-nr28efp","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240607114125-fzodons","Type":"NodeParagraph","Properties":{"id":"20240607114125-fzodons","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607114125-kvmz0ks","Type":"NodeParagraph","Properties":{"id":"20240607114125-kvmz0ks","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" （1）取本品少量，用微火灼烧，有紫红色的烟雾发生。"}]},{"ID":"20240607114125-b4199cr","Type":"NodeParagraph","Properties":{"id":"20240607114125-b4199cr","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"（2）取本品少量，滴加硝酸，产生气泡并显棕红色或黄棕色。"}]},{"ID":"20240607114125-q3z8pes","Type":"NodeParagraph","Properties":{"id":"20240607114125-q3z8pes","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"（3）取本品50mg，加氯仿 5ml充分搅拌，滤过，作为供试品溶液。另取靛蓝和靛玉红对照品，加氯仿制成每 1ml各含1mg 的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各 5～10μl，分别点于同一硅胶Ｇ薄层板上，以苯－氯仿－丙酮（5:4:1）为展开剂，展开，取出，晾干。供试品色谱中，在与对照品色谱相应的位置上，显相同的蓝色和浅紫红色的斑点。"}]},{"ID":"20240607114125-c7fn4l7","Type":"NodeParagraph","Properties":{"id":"20240607114125-c7fn4l7","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240607114125-3mns37v","Type":"NodeParagraph","Properties":{"id":"20240607114125-3mns37v","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 对照品溶液的制备 取靛蓝对照品20mg，精密称定，置锥形瓶中，缓缓加入硫酸15ml，用玻棒轻轻搅匀，置80℃水浴中磺化 1小时，随时搅拌，取出，冷却。将溶液缓缓移入盛有适量水的200ml 量瓶中，用水洗涤容器及残渣，洗液并入量瓶中，加水至刻度，摇匀，滤过，精密量取续滤液 5ml，置50ml量瓶中，加水至刻度，摇匀，即得（每 1ml中含靛蓝10μg）。"}]},{"ID":"20240607114125-cuawic0","Type":"NodeParagraph","Properties":{"id":"20240607114125-cuawic0","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"标准曲线的制备 精密量取对照品溶液1.0ml 、2.0ml 、3.0ml 、4.0ml 和5.0ml ，分别置10ml量瓶中，加水至刻度，摇匀。照分光亮度法（附录Ⅴ B），在610nm 的波长处测定吸收度，以吸收度为纵坐标，浓度为横坐标，绘制标准曲线。"}]},{"ID":"20240607114125-rln5t1l","Type":"NodeParagraph","Properties":{"id":"20240607114125-rln5t1l","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"测定法 取本品细粉约0.4g，精密称定，照对照品溶液的制备项下的方法，自“置锥形瓶中”起，至“精密吸取续滤液 5ml”，置 50ml 或100ml 量瓶（使吸收度在0.20～0.45之间）中，加水至刻度，摇匀，在610nm 的波长处测定吸收度，从标准曲线上读出供试品溶液中靛蓝的重量（μg），计算，即得。"}]},{"ID":"20240607114125-47ln12v","Type":"NodeParagraph","Properties":{"id":"20240607114125-47ln12v","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"本品含靛蓝（C16H10N2O2）不得少于 2.0％。"}]},{"ID":"20240607114125-y360s98","Type":"NodeParagraph","Properties":{"id":"20240607114125-y360s98","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114125-kydffq9","Type":"NodeParagraph","Properties":{"id":"20240607114125-kydffq9","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 归肝经。"}]},{"ID":"20240607114125-amatzew","Type":"NodeParagraph","Properties":{"id":"20240607114125-amatzew","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114125-lacf4a2","Type":"NodeParagraph","Properties":{"id":"20240607114125-lacf4a2","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 咸，寒。"}]},{"ID":"20240607114125-mni2ajo","Type":"NodeParagraph","Properties":{"id":"20240607114125-mni2ajo","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114125-s9aowol","Type":"NodeParagraph","Properties":{"id":"20240607114125-s9aowol","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 清热解毒，凉血，定惊。用于温毒发斑，血热吐衄，胸痛咳血，口疮，痄腮，喉痹，小儿惊痫。"}]},{"ID":"20240607114125-jt7tbnt","Type":"NodeParagraph","Properties":{"id":"20240607114125-jt7tbnt","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114125-5fue0rd","Type":"NodeParagraph","Properties":{"id":"20240607114125-5fue0rd","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 1.5～3g，宜入丸散用。外用适量。"}]},{"ID":"20240607114125-dcvdq6z","Type":"NodeParagraph","Properties":{"id":"20240607114125-dcvdq6z","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114125-sfndyah","Type":"NodeParagraph","Properties":{"id":"20240607114125-sfndyah","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607114125-s7cyzmx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114125-s7cyzmx","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：青黛"}]},{"ID":"20240607114125-ghrdpzc","Type":"NodeParagraph","Properties":{"id":"20240607114125-ghrdpzc","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114125-mrs1ix7","Type":"NodeParagraph","Properties":{"id":"20240607114125-mrs1ix7","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Dài"}]},{"ID":"20240607114125-vathbqv","Type":"NodeParagraph","Properties":{"id":"20240607114125-vathbqv","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114125-25295op","Type":"NodeParagraph","Properties":{"id":"20240607114125-25295op","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 靛花（《简便单方》），青蛤粉（《纲目》），青缸花（《外科正宗》），蓝露，淀花（《手板发蒙》），靛沫花（《中药形性经验鉴别法》）。"}]},{"ID":"20240607114125-4zw5oou","Type":"NodeParagraph","Properties":{"id":"20240607114125-4zw5oou","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607114125-cucxaju","Type":"NodeParagraph","Properties":{"id":"20240607114125-cucxaju","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 《药性录》"}]},{"ID":"20240607114125-52t3ldj","Type":"NodeParagraph","Properties":{"id":"20240607114125-52t3ldj","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114125-hy3abt7","Type":"NodeParagraph","Properties":{"id":"20240607114125-hy3abt7","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 为爵床科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"马蓝"},{"Type":"NodeText","Data":"、豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木蓝"},{"Type":"NodeText","Data":"、十字花科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菘蓝"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"草大青"},{"Type":"NodeText","Data":"或蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蓼蓝叶中的干燥色素"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607114125-euj6ojk","Type":"NodeParagraph","Properties":{"id":"20240607114125-euj6ojk","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607114125-ilndqzn","Type":"NodeParagraph","Properties":{"id":"20240607114125-ilndqzn","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 植物形态详\"木蓝\"、\"板蓝根\"、\"蓝实\"各条。"}]},{"ID":"20240607114125-3opd1m4","Type":"NodeParagraph","Properties":{"id":"20240607114125-3opd1m4","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607114125-bkcn18y","Type":"NodeParagraph","Properties":{"id":"20240607114125-bkcn18y","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 本品为极细的粉末，灰蓝色或深蓝色，质轻，易飞扬，可粘手粘纸。具草腥气，味微酸。以体轻、粉细，能浮于水面，燃烧时生紫红色火焰者为佳。如质重坚实，呈团块状，有白色小点，置水中有颗粒状下沉者品质为次。"}]},{"ID":"20240607114125-n62gvi6","Type":"NodeParagraph","Properties":{"id":"20240607114125-n62gvi6","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"主产于福建、云南、江苏、安徽等地。此外，江西、河南、四川等地亦产。福建所产的品质最佳，称建青黛。"}]},{"ID":"20240607114125-5c01rdc","Type":"NodeParagraph","Properties":{"id":"20240607114125-5c01rdc","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607114125-7zhfz0q","Type":"NodeParagraph","Properties":{"id":"20240607114125-7zhfz0q","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 青黛（木蓝）醇浸液（0.5克／毫升）在体外对炭疽杆菌、肺炎杆菌、志贺氏痢疾杆菌、霍乱弧菌、金黄色和白色葡萄球菌皆有抑制作用。但亦有报告对伤寒杆菌、霍乱弧菌、葡萄球菌和结核杆菌等无抑制作用；可能因药物提取方法不同之故。"}]},{"ID":"20240607114125-na2t68s","Type":"NodeParagraph","Properties":{"id":"20240607114125-na2t68s","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607114125-t80729a","Type":"NodeParagraph","Properties":{"id":"20240607114125-t80729a","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 青黛：拣去杂质，过罗。飞青黛：筛去杂质，置乳钵内，加适量清水，混和研细，复注入清水，轻轻搅动，使细粉悬浮，倾入另一容器中，待沉淀后，倒去清水，然后将沉淀之粉末，倾倒于铺上白纸的筛内，晒干，研细。"}]},{"ID":"20240607114125-kj4qqgd","Type":"NodeParagraph","Properties":{"id":"20240607114125-kj4qqgd","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114125-jx4rtg4","Type":"NodeParagraph","Properties":{"id":"20240607114125-jx4rtg4","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 入肝、肺、胃经。"}]},{"ID":"20240607114125-dm400i0","Type":"NodeParagraph","Properties":{"id":"20240607114125-dm400i0","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肝、脾二经。\""}]},{"ID":"20240607114125-8w9f8yi","Type":"NodeParagraph","Properties":{"id":"20240607114125-8w9f8yi","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"专入肝。\""}]},{"ID":"20240607114125-a8wi7bv","Type":"NodeParagraph","Properties":{"id":"20240607114125-a8wi7bv","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"③《本草便读》：\"入肝，又能入肺、胃。\""}]},{"ID":"20240607114125-pw656es","Type":"NodeParagraph","Properties":{"id":"20240607114125-pw656es","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114125-1ji1n0f","Type":"NodeParagraph","Properties":{"id":"20240607114125-1ji1n0f","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 咸，寒。"}]},{"ID":"20240607114125-h9pg99q","Type":"NodeParagraph","Properties":{"id":"20240607114125-h9pg99q","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味甘，平。\""}]},{"ID":"20240607114125-2yght7v","Type":"NodeParagraph","Properties":{"id":"20240607114125-2yght7v","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"②《开宝本草》：\"味咸，寒，无毒。\""}]},{"ID":"20240607114125-nvxxd4w","Type":"NodeParagraph","Properties":{"id":"20240607114125-nvxxd4w","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"③《医林纂要》：\"辛咸。\""}]},{"ID":"20240607114125-opi74u3","Type":"NodeParagraph","Properties":{"id":"20240607114125-opi74u3","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"味苦，性寒，无毒。\""}]},{"ID":"20240607114125-qmp88xq","Type":"NodeParagraph","Properties":{"id":"20240607114125-qmp88xq","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607114125-k74i5x9","Type":"NodeParagraph","Properties":{"id":"20240607114125-k74i5x9","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 《本草从新》：\"中寒者勿使。\""}]},{"ID":"20240607114125-hcz3uvg","Type":"NodeParagraph","Properties":{"id":"20240607114125-hcz3uvg","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114125-nkqb33s","Type":"NodeParagraph","Properties":{"id":"20240607114125-nkqb33s","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 清热，凉血，解毒。治温病热盛，斑疹，吐血、咯血，小儿惊痫，疮肿，丹毒，蛇虫咬伤。"}]},{"ID":"20240607114125-yker3iw","Type":"NodeParagraph","Properties":{"id":"20240607114125-yker3iw","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"解小儿疳热、消瘦，杀虫。\""}]},{"ID":"20240607114125-lfwyyt1","Type":"NodeParagraph","Properties":{"id":"20240607114125-lfwyyt1","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"解毒。小儿丹热，和水服之。\""}]},{"ID":"20240607114125-euamyz3","Type":"NodeParagraph","Properties":{"id":"20240607114125-euamyz3","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》：\"主解诸药毒，小儿诸热，惊痫发热，天行头痛寒热，煎水研服之。亦摩敷热疮、恶肿、金疮、下血、蛇犬等毒。\""}]},{"ID":"20240607114125-3wyps95","Type":"NodeParagraph","Properties":{"id":"20240607114125-3wyps95","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"④《本草蒙筌》：\"泻肝，止暴注，消上膈痰火，驱时疫头痛，敛伤寒亦斑，水调服之。\""}]},{"ID":"20240607114125-mocvtbn","Type":"NodeParagraph","Properties":{"id":"20240607114125-mocvtbn","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"去热烦，吐血，咯血，斑疮，阴疮，杀恶虫。\""}]},{"ID":"20240607114125-on1tm26","Type":"NodeParagraph","Properties":{"id":"20240607114125-on1tm26","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑥《本草述》：\"治中风、头风、胁痛、瘈疭、颤振、眩晕、咳嗽、久嗽、呕吐、舌衄、咳嗽血，颓疝。\""}]},{"ID":"20240607114125-xzkkwey","Type":"NodeParagraph","Properties":{"id":"20240607114125-xzkkwey","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑦《本经逢原》：\"治温毒发斑及产后热痢下重。\""}]},{"ID":"20240607114125-dqkiyda","Type":"NodeParagraph","Properties":{"id":"20240607114125-dqkiyda","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑧《要药分剂》：\"除热解毒，兼能凉血。\""}]},{"ID":"20240607114125-pz0ziyr","Type":"NodeParagraph","Properties":{"id":"20240607114125-pz0ziyr","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑨《岭南采药录》：\"可涂疮及痄腮。又治眼热有膜及吐血，内服之。\""}]},{"ID":"20240607114125-a8wvjz9","Type":"NodeParagraph","Properties":{"id":"20240607114125-a8wvjz9","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114125-z6lg7zy","Type":"NodeParagraph","Properties":{"id":"20240607114125-z6lg7zy","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5～8分，或入丸、散。外用：干撒或调敷。"}]},{"ID":"20240607114125-9htq3uz","Type":"NodeParagraph","Properties":{"id":"20240607114125-9htq3uz","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607114125-y1pp7c3","Type":"NodeParagraph","Properties":{"id":"20240607114125-y1pp7c3","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" ①治伤寒赤斑：青黛二钱。水研服。（《类证活人书》）"}]},{"ID":"20240607114125-i22oy7g","Type":"NodeParagraph","Properties":{"id":"20240607114125-i22oy7g","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"②治妊娠伤寒，热郁阳明，热极而发紫黑斑，脉洪数者，若不急治，胎殒在即：真青黛钱半，鲜生地二两（捣汁），生石膏八钱，升麻六分，黄芩二钱，焦栀子三钱，葱头三枚。水煎服。（《重订通俗伤寒论》青黛石膏汤）"}]},{"ID":"20240607114125-cmbrmow","Type":"NodeParagraph","Properties":{"id":"20240607114125-cmbrmow","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"③治吐血不止：青黛二钱，新水调下。（《端效方》青金散）"}]},{"ID":"20240607114125-uxjsr8c","Type":"NodeParagraph","Properties":{"id":"20240607114125-uxjsr8c","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"④治咯血：青黛一钱，杏仁四十粒（去皮、尖，以黄明蜡煎黄色，取出研细）。上二件再同研匀，却以所煎蜡少许，熔开和之，捏作钱大饼子。每服，用干柿一个，中破开，入药一饼，合定，以湿纸裹，慢火煨熟，取出，以糯米粥嚼下。（《中藏经》圣饼子）"}]},{"ID":"20240607114125-m9unsou","Type":"NodeParagraph","Properties":{"id":"20240607114125-m9unsou","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑤治咳嗽吐痰，面鼻发红者：青黛（水飞极细，晒干再研用）四钱，蛤粉三钱。二味炼蜜为丸，如指头大。临卧噙三丸。（《医学从众录》青黛蛤粉丸）"}]},{"ID":"20240607114125-ozns5tk","Type":"NodeParagraph","Properties":{"id":"20240607114125-ozns5tk","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑥治肺经咳嗽有热痰者：青黛、海石、瓜蒌仁、川贝母。（《症因脉治》青黛海石丸）"}]},{"ID":"20240607114125-cw8w008","Type":"NodeParagraph","Properties":{"id":"20240607114125-cw8w008","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑦治小儿惊痫：青黛，量大小，水研服之。（《生生编》）"}]},{"ID":"20240607114125-dt4vjyi","Type":"NodeParagraph","Properties":{"id":"20240607114125-dt4vjyi","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑧治产后发狂：四物汤加青黛。水煎服。（《摘元方》）"}]},{"ID":"20240607114125-4wb3uwc","Type":"NodeParagraph","Properties":{"id":"20240607114125-4wb3uwc","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑨治胃脘痛，病久成郁，郁则成热：青黛，以姜汁入汤调服。（《医学正传》）"}]},{"ID":"20240607114125-cy8qnwj","Type":"NodeParagraph","Properties":{"id":"20240607114125-cy8qnwj","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑩治口舌生疮：青黛一钱，细辛一分，黄柏一分（锉），地骨皮一分，密陀僧一分。上件药，捣细罗为散。每取少许，贴于疮上。有涎即吐之。（《圣惠方》）"}]},{"ID":"20240607114125-tcg3md5","Type":"NodeParagraph","Properties":{"id":"20240607114125-tcg3md5","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑾治一切热毒，脓窝疮：青黛一两，寒水石一两（煅过，苏为度）。上为细末，用香油调搽。（《普济方》青金散）"}]},{"ID":"20240607114125-t988x2c","Type":"NodeParagraph","Properties":{"id":"20240607114125-t988x2c","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⑿治天泡疮：青黛适量，鲜丝瓜叶捣汁调敷患处。加少许菜油调和亦可。（《验方选集》）"}]},{"ID":"20240607114125-j98lgqg","Type":"NodeParagraph","Properties":{"id":"20240607114125-j98lgqg","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⒀治小儿湿癣浸淫疮：白胶香二两（研），蛤粉半两，青黛二钱半。上研匀为细末，干掺疮上。（《田氏保婴集》青金散）"}]},{"ID":"20240607114125-mroxj2n","Type":"NodeParagraph","Properties":{"id":"20240607114125-mroxj2n","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⒁治瘰疬未穿：靛花、马齿苋同捣，日日涂敷。（《简便单方》）"}]},{"ID":"20240607114125-ncmnuxd","Type":"NodeParagraph","Properties":{"id":"20240607114125-ncmnuxd","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⒂治耳疳出汁：青黛、黄柏末。干搽。（《谈埜翁试验方》）"}]},{"ID":"20240607114125-0sf6vgd","Type":"NodeParagraph","Properties":{"id":"20240607114125-0sf6vgd","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⒃治烂弦风眼：青黛、黄连。泡汤日洗。（《明目经验方》）"}]},{"ID":"20240607114125-pz11fkm","Type":"NodeParagraph","Properties":{"id":"20240607114125-pz11fkm","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"⒄治诸毒虫伤：青黛、雄黄等分。研末，新汲水服二钱。（《古今录验方》）"}]},{"ID":"20240607114125-0l20vbb","Type":"NodeParagraph","Properties":{"id":"20240607114125-0l20vbb","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607114125-me5wcsh","Type":"NodeParagraph","Properties":{"id":"20240607114125-me5wcsh","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 治疗鼻衄：用鼻钳扩大鼻前孔，查明出血部位，然后用消毒棉球蘸青黛粉塞入鼻腔，压迫出血点。上药时，应嘱患者暂停吸气，以防青黛吸入引起咳嗽。治疗20例，13例用药1次、4例用药2次、2例用药3次（另加针刺），鼻衄停止；1例无效。"}]},{"ID":"20240607114125-wkoi8fo","Type":"NodeParagraph","Properties":{"id":"20240607114125-wkoi8fo","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607114125-1p186w1","Type":"NodeParagraph","Properties":{"id":"20240607114125-1p186w1","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"青黛，解毒除热，固其所长，古方多有用之于诸血证者，使非血分实热，而病生于阴虚内热，阳无所附，火气因虚上炎，发为吐衄咯唾等证，用之非宜。血得寒则凝，凝则寒热交作，胸膈或痛，愈增其病矣。\""}]},{"ID":"20240607114125-vt8l9yd","Type":"NodeParagraph","Properties":{"id":"20240607114125-vt8l9yd","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"青黛，泻肝胆，散郁火，治温毒发斑及产后热痢下重，《千金》蓝青丸用之，天行寒热头痛，水研服之。与蓝同类，而止血拔毒杀虫之功，似胜于蓝。又治噎膈之疾，取其化虫之力也。和溺白垽、冰片，吹口疳最效。\""}]},{"ID":"20240607114125-hn3s0g9","Type":"NodeParagraph","Properties":{"id":"20240607114125-hn3s0g9","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"青黛，大泻肝经实火及散肝经火郁。故凡小儿风热惊痫，疳毒，丹热痈疮，蛇犬等毒，金疮血出，噎膈蛊食，并天行头痛，瘟疫热毒，发斑、吐血、咯血、痢血等症，或应作丸为衣。或用为末干掺，或用水调敷，或入汤同服，或作饼子投治，皆取苦寒之性，以散风郁燥结之义。\""}]},{"ID":"20240607114125-4q4m7ns","Type":"NodeParagraph","Properties":{"id":"20240607114125-4q4m7ns","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"制法"}]},{"ID":"20240607114125-dcatoy3","Type":"NodeParagraph","Properties":{"id":"20240607114125-dcatoy3","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 夏、秋采收茎叶，置缸内，用清水浸2～3昼夜，至叶烂脱枝时，捞去枝条，每10斤叶加入石灰1斤，充分搅拌。至浸液成紫红色时，捞取液面泡沫，晒干，即为青黛，质量最好。当泡沫减少时，可沉淀2～3小时，除去上面的澄清液，将沉淀物筛去碎渣，再行搅拌，又可产生泡沫。将泡沫捞出晒干，仍为青黛，但质量较次。"}]},{"ID":"20240607114125-pbemcsa","Type":"NodeParagraph","Properties":{"id":"20240607114125-pbemcsa","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114125-dymf16p","Type":"NodeParagraph","Properties":{"id":"20240607114125-dymf16p","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607114125-ky8i1r8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114125-ky8i1r8","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"《中华本草》：青黛"}]},{"ID":"20240607114125-fy6vzw2","Type":"NodeParagraph","Properties":{"id":"20240607114125-fy6vzw2","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114125-vhip4wv","Type":"NodeParagraph","Properties":{"id":"20240607114125-vhip4wv","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Dài"}]},{"ID":"20240607114125-g7xwk3i","Type":"NodeParagraph","Properties":{"id":"20240607114125-g7xwk3i","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114125-xijof0h","Type":"NodeParagraph","Properties":{"id":"20240607114125-xijof0h","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 靛花、青蛤粉、青缸花、蓝露、淀花、靛沫花"}]},{"ID":"20240607114125-1uzsldv","Type":"NodeParagraph","Properties":{"id":"20240607114125-1uzsldv","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607114125-gk51bfa","Type":"NodeParagraph","Properties":{"id":"20240607114125-gk51bfa","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" Natural Indigo，Common Baphicacanthus Rhizome and Root"}]},{"ID":"20240607114125-dp9n05q","Type":"NodeParagraph","Properties":{"id":"20240607114125-dp9n05q","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607114125-8lvfqa4","Type":"NodeParagraph","Properties":{"id":"20240607114125-8lvfqa4","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》。"}]},{"ID":"20240607114125-jhdley8","Type":"NodeParagraph","Properties":{"id":"20240607114125-jhdley8","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114125-01nay9x","Type":"NodeParagraph","Properties":{"id":"20240607114125-01nay9x","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 药材基源：为爵应酬科植物马蓝、蓼科植物蓼蓝、豆科植物木蓝、十字花科植物菘蓝的叶或茎叶经加工制得的干燥粉末或团块。"}]},{"ID":"20240607114125-6hajm54","Type":"NodeParagraph","Properties":{"id":"20240607114125-6hajm54","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Baphicacanthus cusia (Nees) Bremek. [Goldfussia cusia Nees;Strobilanthes cusia (Nees)O. Kuntze]2.Polygonum tinctorium Ait.3.Indigofera tinctoria L.4.Isatis indigotica Fort."}]},{"ID":"20240607114125-img7qf5","Type":"NodeParagraph","Properties":{"id":"20240607114125-img7qf5","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季采收茎叶，置缸中，加清水浸2-3d，至叶腐烂、茎脱皮时，将茎枝捞出，加入石灰（每100kg加石灰8-10kg），充分搅拌，至浸液由深绿色转为紫红色时，捞出液面泡沫，于烈日下晒干，即得。"}]},{"ID":"20240607114125-k6ilo6m","Type":"NodeParagraph","Properties":{"id":"20240607114125-k6ilo6m","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607114125-qqzsumu","Type":"NodeParagraph","Properties":{"id":"20240607114125-qqzsumu","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山地、林缘潮湿的地方，野生或栽培。"}]},{"ID":"20240607114125-xm8lvuz","Type":"NodeParagraph","Properties":{"id":"20240607114125-xm8lvuz","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.野生于旷野或水沟边。多为栽培或为半野生状态。"}]},{"ID":"20240607114125-jtqtu0r","Type":"NodeParagraph","Properties":{"id":"20240607114125-jtqtu0r","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"3.野生于山坡草丛中，南方各地时有栽培。"}]},{"ID":"20240607114125-m7vv2fl","Type":"NodeParagraph","Properties":{"id":"20240607114125-m7vv2fl","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于江苏、浙江、福建、湖北、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240607114125-bj9d1t3","Type":"NodeParagraph","Properties":{"id":"20240607114125-bj9d1t3","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.分布于辽宁、河北、陕西、山东等地。现东北至广东均有野生或少有种植。"}]},{"ID":"20240607114125-6sgpys7","Type":"NodeParagraph","Properties":{"id":"20240607114125-6sgpys7","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"3.分布于华东及台湾、湖北、湖南、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240607114125-qr6yeew","Type":"NodeParagraph","Properties":{"id":"20240607114125-qr6yeew","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607114125-v1of7rs","Type":"NodeParagraph","Properties":{"id":"20240607114125-v1of7rs","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 1.马蓝 多年生草本，高30-70cm。干时茎叶呈蓝色或黑绿色。根茎粗壮，断面呈蓝色。地上茎基部稍木质化，略带方形，稍分枝，节膨大，幼时被褐色微毛。叶对生；叶柄长1-4cm；叶片倒卵状椭圆形或卵状椭圆形，长6-15cm，宽4-8cm；先端急尖，微钝头，基部渐狭细，边缘有浅锯齿或波状齿或全缘，上面无毛，有稠密狭细的钟乳线条，下面幼时脉上稍生褐色微软毛，侧脉5-6对。花无梗，成疏生的穗状花序，顶生或腋生；苞片叶状，狭倒卵形，早落；花萼裂片5，条形，长1-1.4cm，通常一片较大，呈匙形，无毛；花冠漏斗状，淡紫色，长4.5-5.5cm，5裂近相等，长6-7mm，先端微凹；雄蕊4，2强，花粉椭圆形，有带条，带条上具两条波形的脊；子房上位，花柱细长。蒴果为稍狭的匙形，长1.5-2cm。种子4颗，有微毛。花期6-10月，果期7-11月。"}]},{"ID":"20240607114125-tm86blu","Type":"NodeParagraph","Properties":{"id":"20240607114125-tm86blu","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.蓼蓝 一年生草本，高50-80cm。茎圆柱形，分枝或不分枝，无毛，具明显的节。单叶互生；叶柄长5-10mm；基部有鞘状膜质托叶，淡褐色，先端截形，边缘长睫毛；叶片卵形或卵状披针形，长3-8cm，宽1.5-5.5cm，先端钝，基部圆形或楔形，全缘，有缘毛，干后两面均蓝绿色。穗状花序顶生或腋生，排列紧密；苞片钟形，近革质，有睫毛；花小，红色，花被5裂，裂片倒卵形，淡红色；雄蕊6-8；雌蕊1，花柱不伸出，柱头3叉。瘦果椭圆状三棱形或两凸形，有光泽，包于宿存花被内。花期7-9月，果期8-10月。"}]},{"ID":"20240607114125-mparvmw","Type":"NodeParagraph","Properties":{"id":"20240607114125-mparvmw","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"3.木蓝 小灌木，高50-80cm，罕更高。茎直立，小枝被银白色短毛。叶互生；奇数羽状复叶，长2.5-5cm，小叶对生；托叶小，锥形；小叶9-13，叶片卵状长圆形或倒卵状椭圆形，长1-2cm，宽0.5-1.5cm，先端钝圆，有小尖，基部楔形，全缘，两面被丁字毛，叶干时常带蓝色。总状花序疏松，通常腋生，远较叶为短，有花约20朵；萼钟形，被银白色毛，上部5齿裂；花冠蝶形，红黄色，长约4mm，旗瓣宽卵形至长圆形，外面有毛，翼瓣卵圆形，微与龙骨瓣相连，龙骨瓣匙形，爪上有距；雄蕊10，两体；子房无柄，花柱短，内弯，柱头头状。荚果线状圆柱形，直或稍弯，长约2cm，棕黑色，无毛。种子长圆形状圆柱形，直或稍弯，长约2cm，棕黑色，无毛。种子长圆形，5-12颗，种子长约1.5mm。花期5-6月，果期7-8月4.蓼蓝：（靛青叶、蓝靛叶、靛叶）一年本草、高50-80cm，茎直立，单一分枝，有棱和明显的节，带红紫色，几无毛。单叶互生，有柄；托叶鞘圆筒状，具长睫毛；叶片卵形至宽椭圆形，长3-8cm，宽2-5cm，先端圆钝，基部近圆形或平截，全绿，无毛或沿脉补短毛，蓝绿色，干后变暗蓝色。夏季开淡红色小花，穗状花序顶生或腋生。花密集，苞片膜质，具纤毛，花被5；卵形；、雄蕊6-8个，短天花被。瘦果宽卵形，三棱，棕色，有光泽，包于宿存的膜质花被内。"}]},{"ID":"20240607114125-s5nb6fr","Type":"NodeParagraph","Properties":{"id":"20240607114125-s5nb6fr","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607114125-zbl2wv1","Type":"NodeParagraph","Properties":{"id":"20240607114125-zbl2wv1","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品为深蓝色的粉末，体轻，易飞扬；或呈不规则多孔性的团块，用手搓捻即成细末。薇有草腥气，味淡。"}]},{"ID":"20240607114125-jfef5z3","Type":"NodeParagraph","Properties":{"id":"20240607114125-jfef5z3","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607114125-i6m40tq","Type":"NodeParagraph","Properties":{"id":"20240607114125-i6m40tq","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 1.急性毒性：小鼠一次灌胃靛蓝32g/kg，靛玉红25g/kg，均不引起动物死亡，而靛蓝和靛玉红一次腹腔注射的LD50分别为2.20±0.23g/kg和1.11±0.14g/kg。小鼠腹腔注射的LD50为1.1-2.0g／kg。小鼠灌胃5g／kg，连续5天，观察1周，结果未见动物发生死亡和出现明显毒性反应。"}]},{"ID":"20240607114125-hm2abf4","Type":"NodeParagraph","Properties":{"id":"20240607114125-hm2abf4","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.亚急性毒性：大鼠灌胃靛玉红每日500g/kg，连续一个月未见体重、血象；骨髓象、肝功能、心电图改变。毒性：靛玉红腹腔注射对小鼠的LD50为1310±140mg/kg。靛玉红200mg/kg灌胃，连续1个月，可使大鼠肝细胞肿胀变性，核及核仁肥大，灌胃给药连续6个月，肝细胞出现肿胀、溶解性环死及萎缩变性。长时间给药，对小鼠、大鼠、豚鼠正常造血细胞生成均无明显影响。给犬分别灌胃靛玉红20、100、200mg／kg，连续6个月，结果小剂量组的食欲和生长情况与对照组相似，而大、中剂量组服药后动物出现食欲减少、腹泻、便血以及SGPT升高和灶性肝细胞坏死等反应。但3个剂量组的血象、骨髓象都未见明显抑制，对肾功能、心电图也无影响。"}]},{"ID":"20240607114125-rt0kdog","Type":"NodeParagraph","Properties":{"id":"20240607114125-rt0kdog","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607114125-tzv38mx","Type":"NodeParagraph","Properties":{"id":"20240607114125-tzv38mx","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 从马蓝制得的青黛中分得：靛玉红（isdirubin），靛蓝（indigo），异靛蓝（isoindigo）[1，2]。"}]},{"ID":"20240607114125-531w6ym","Type":"NodeParagraph","Properties":{"id":"20240607114125-531w6ym","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"从蓼蓝制得的青黛中分得靛玉红，靛蓝，N-苯基-2-荼胺（N-phenyl-2-naphthylamine），β-谷甾醇（β-sitosterol），虫漆蜡醇（lac-cerol）[1]，靛甙（indican），松蓝甙（isatan）B，色氨酮（tryptan-thren），青黛酮（qigdainone）[3]。"}]},{"ID":"20240607114125-smt7m7q","Type":"NodeParagraph","Properties":{"id":"20240607114125-smt7m7q","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"从木蓝制得的青黛中分昨：靛玉红[4]。"}]},{"ID":"20240607114125-p957d81","Type":"NodeParagraph","Properties":{"id":"20240607114125-p957d81","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"从菘蓝制得的青黛中分得：靛玉红，靛蓝，色氨酮，青黛酮，靛红（isatin），正二十九烷（n-nonacosane）[5]。"}]},{"ID":"20240607114125-rlmfakl","Type":"NodeParagraph","Properties":{"id":"20240607114125-rlmfakl","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607114125-zguaymf","Type":"NodeParagraph","Properties":{"id":"20240607114125-zguaymf","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 1.抗肿瘤：青黛成分靛玉红200mg/kg腹腔注射或皮下注射，连续7天，对大鼠癌W256实体瘤有抑制，100mg/kg腹腔注射对小鼠肉瘤-180（S180）有抑制作用。靛玉红50mg/kg灌胃，连续10天，对小鼠Lewis肺癌有抑制作用。靛玉红治疗慢性粒细胞白血病，使骨髓白细胞急骤减少，电镜观察有大量变性坏死细胞，而且均属幼稚粒细胞，都是以肿胀、溶解性坏死方式时进行的，细胞质、细胞核都有明显破坏。靛玉红200mg/kg腹腔注射连续3-5天，对（3H-TdR）掺入大鼠W256瘤组织脱氧核糖酸（DNA）的抑制率为46%，但不抑制3H-尿嘧啶核苷（3H-UR）掺入瘤组织的核糖核酸（RNA）和3H-苯丙氨酸掺入瘤组织的蛋白质。体外试验，靛玉红在低于3×10(-6)mol/L浓度，对大鼠W256、小鼠艾氏腹水癌（EAC）及小鼠肝癌（HepA）均能抑制3H-TdR的掺入癌细胞，而对再生肝细胞抑制作用很小，对小鼠淋巴细胞白血病（L1210）细胞的核酸和蛋白质合成均无影响。靛玉红4μg/ml浓度对TdR掺入人慢性粒细胞白血病（慢粒）细胞有抑制作用，对急粒TdR的掺入抑制更强，说明靛玉红对DNA合成更活跃的增殖细胞具有更大的抑制和杀灭作用，但对TdR掺入幼稚淋巴细胞无抑制作用。"}]},{"ID":"20240607114125-sy9hceh","Type":"NodeParagraph","Properties":{"id":"20240607114125-sy9hceh","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.对白血病细胞的作用：药理研究初步表明，靛玉红有破坏白血病细胞的作用。从超微结构形态来看，在靛玉红作用下，变性坏死的细胞多呈肿胀、溶解性坏死。实验中发现靛玉红能增强动物的单核巨噬系统的吞噬能力。单核巨噬系统在机体免疫反应中起一定的作用，故靛玉红的抗癌作用可能与提高机体免疫能力有关。"}]},{"ID":"20240607114125-sjc4x7c","Type":"NodeParagraph","Properties":{"id":"20240607114125-sjc4x7c","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"3.抑菌作用：色胺酮经抗真菌试验，为抗皮肤病真菌的活性成分，对羊毛状小孢子菌、断发癣、石膏样小孢子菌、紫色癣菌、石膏样癣菌、红色癣菌、絮状表皮癣菌等均有较强的抑制作用，其最小抑菌浓度为5μg/ml。"}]},{"ID":"20240607114125-pazkkef","Type":"NodeParagraph","Properties":{"id":"20240607114125-pazkkef","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607114125-s5m9nzo","Type":"NodeParagraph","Properties":{"id":"20240607114125-s5m9nzo","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 1.青黛：拣去杂质，过罗。"}]},{"ID":"20240607114125-a46bg46","Type":"NodeParagraph","Properties":{"id":"20240607114125-a46bg46","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.飞青黛：筛去杂质，置乳钵内，加适量清水，混和研细，复注入清水，轻轻搅动，使细粉悬浮，倾入另一容器中，待沉淀后，倒去清水，然后将沉淀之粉末，倾倒于铺上白纸的筛内，晒干，研细。"}]},{"ID":"20240607114125-hphmqpw","Type":"NodeParagraph","Properties":{"id":"20240607114125-hphmqpw","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607114125-kb177yy","Type":"NodeParagraph","Properties":{"id":"20240607114125-kb177yy","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品少量，用微火灼烧，有紫红色的烟雾发生。"}]},{"ID":"20240607114125-mveo8h9","Type":"NodeParagraph","Properties":{"id":"20240607114125-mveo8h9","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"（2）取本品少量，滴加硝酸，产生气泡并显棕红色或黄棕色。"}]},{"ID":"20240607114125-gsevi38","Type":"NodeParagraph","Properties":{"id":"20240607114125-gsevi38","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"（3）薄层色谱 取本品50mg，加氯仿5ml充分搅拌，滤过，作供试液。另取靛蓝及靛玉红对照品，加氯仿制成每1ml各含1mg的混合溶液，作对照品溶液。吸取上述两种溶液各5-10μl，分别点于同一硅胶G薄层板上，以来苯-氯仿-丙酮（5：4：1）展开，取出，晾干。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607114125-qt1oa3d","Type":"NodeParagraph","Properties":{"id":"20240607114125-qt1oa3d","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114125-iya9nz0","Type":"NodeParagraph","Properties":{"id":"20240607114125-iya9nz0","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 归肝；肺；胃经"}]},{"ID":"20240607114125-5m499ev","Type":"NodeParagraph","Properties":{"id":"20240607114125-5m499ev","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114125-ny791qd","Type":"NodeParagraph","Properties":{"id":"20240607114125-ny791qd","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 味咸；性寒"}]},{"ID":"20240607114125-mpst6ti","Type":"NodeParagraph","Properties":{"id":"20240607114125-mpst6ti","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607114125-7tz9wz7","Type":"NodeParagraph","Properties":{"id":"20240607114125-7tz9wz7","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 《本草从新》：中寒者勿使。"}]},{"ID":"20240607114125-nhf6270","Type":"NodeParagraph","Properties":{"id":"20240607114125-nhf6270","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114125-msimh0f","Type":"NodeParagraph","Properties":{"id":"20240607114125-msimh0f","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 清热解毒；凉血止血；清肝泻火。主温病热毒斑疹；血热吐血；衄血；咯血；肝热惊痫；肝火犯肺咳嗽；咽喉肿痛；丹毒；痄；疮肿；蛇虫咬伤"}]},{"ID":"20240607114125-xpc06pz","Type":"NodeParagraph","Properties":{"id":"20240607114125-xpc06pz","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114125-7dapkyg","Type":"NodeParagraph","Properties":{"id":"20240607114125-7dapkyg","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 内服：研末，1.5-6g；或入丸剂。外用：适量，干撒或调敷。"}]},{"ID":"20240607114125-u2fduww","Type":"NodeParagraph","Properties":{"id":"20240607114125-u2fduww","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607114125-scjjkgz","Type":"NodeParagraph","Properties":{"id":"20240607114125-scjjkgz","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 1.《药性论》：解小儿疳热、消瘦，杀虫。"}]},{"ID":"20240607114125-ylzi0ig","Type":"NodeParagraph","Properties":{"id":"20240607114125-ylzi0ig","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：解毒。小儿丹热，和水服之。"}]},{"ID":"20240607114125-xzuvn8v","Type":"NodeParagraph","Properties":{"id":"20240607114125-xzuvn8v","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"3.《开宝本草》：主解诸药毒，小儿诸热，惊厥发热，天行头痛寒热，煎水研服之。亦摩敷热疮、恶肿、金疮、下血、蛇犬等毒。"}]},{"ID":"20240607114125-q8zi334","Type":"NodeParagraph","Properties":{"id":"20240607114125-q8zi334","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"4.《本草蒙筌》：泻肝，止暴注，消膈上痰水，驱时疫头痛，敛伤寒赤斑，水调服之。"}]},{"ID":"20240607114125-ax1h0gl","Type":"NodeParagraph","Properties":{"id":"20240607114125-ax1h0gl","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"5.《本草纲目》：去热烦，吐血，咯血，斑疮，阴疮，杀恶虫。"}]},{"ID":"20240607114125-l1xkyn6","Type":"NodeParagraph","Properties":{"id":"20240607114125-l1xkyn6","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"6.《本草述》：治中风、头风、胁痛、瘛、颤振、眩晕、咳嗽、久嗽、呕吐、舌衄、咳嗽血，寒疝。"}]},{"ID":"20240607114125-3n2lh70","Type":"NodeParagraph","Properties":{"id":"20240607114125-3n2lh70","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"7.《本经逢原》：治温毒发斑及产后热痢下重。"}]},{"ID":"20240607114125-1olq9r7","Type":"NodeParagraph","Properties":{"id":"20240607114125-1olq9r7","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"8.《要药分剂》：除热解毒，兼能凉血。"}]},{"ID":"20240607114125-j53gwq6","Type":"NodeParagraph","Properties":{"id":"20240607114125-j53gwq6","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"9.《岭南采药录》：可涂疮及痄腮。又治眼热有膜及吐血，内服之。"}]},{"ID":"20240607114125-wepzf1p","Type":"NodeParagraph","Properties":{"id":"20240607114125-wepzf1p","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"10.《开宝本草》：青黛，从波斯国来，及太原并庐陵、南康等染淀，亦堪敷热恶肿、蛇虺螫毒。染瓮上池沫紫碧色者，用之同青黛功。"}]},{"ID":"20240607114125-g8sbex9","Type":"NodeParagraph","Properties":{"id":"20240607114125-g8sbex9","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"11.《本草衍义》：青黛，乃蓝为之。有一妇人患脐下腹上，下连二阴，遍满生湿疮，状如马瓜疮，他处并无，热痒而痛，大小便涩，出黄汁，食亦减，身面微肿，医作恶疮治，用鳗鱼、松脂、黄丹之类。药涂上，疮愈热，痛愈甚。治不对，故如此。问之，此人嗜酒，贪啖，喜鱼蟹发风等物。急令用温水洗，拭去膏药。寻以马齿苋四两，烂研细；入青黛一两，再研匀，涂疮上，即时热减，痛痒皆去。仍服八正散，日三服，分散客热，每涂药，得一时久，药已干燥，又再涂新湿药。凡如此二日，减三分之一，五日减三分之二，自此二十日愈。既愈而问曰：此疮何缘至此？曰：中、下焦蓄风热，毒气若不出，当作肠痈内痔。仍常须禁酒及发风物。然不能禁酒，后果然患内痔。"}]},{"ID":"20240607114125-s7by0qq","Type":"NodeParagraph","Properties":{"id":"20240607114125-s7by0qq","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114125-8nknw74","Type":"NodeParagraph","Properties":{"id":"20240607114125-8nknw74","updated":"20240607114125"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607114126-lf89anv","Type":"NodeThematicBreak","Properties":{"id":"20240607114126-lf89anv"}},{"ID":"20240607114127-0gecy5i","Type":"NodeParagraph","Properties":{"id":"20240607114127-0gecy5i"}}]}