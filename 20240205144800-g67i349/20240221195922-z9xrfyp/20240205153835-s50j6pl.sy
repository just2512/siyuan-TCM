t-style=\"width: 347px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710150035-o27zz7l","Type":"NodeParagraph","Properties":{"id":"20240710150035-o27zz7l","updated":"20240710150038"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"南板蓝根"}]},{"ID":"20240710150956-2mpus4i","Type":"NodeParagraph","Properties":{"id":"20240710150956-2mpus4i","updated":"20240710150956"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产四川、福建、两广地区。\n【性状】\t根茎及根全长1030cm，根茎长510cm。根茎圆柱形，多弯曲，有时分叉，直径2"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":"6mm；上部常具短地上茎，有进分枝。表面灰褐色，节膨大，节处着生细长而略弯曲的根，表面有细皱纹。茎及根茎质脆，易折断，断面不平坦，略纤维状，中央有髓，较大，外皮易脱落。根质稍柔韧。气弱，味淡。\n【性味】\t苦，寒。\n【功效】\t清热解毒；凉血消肿。主治温毒发斑；高热头痛；大头瘟疫；丹毒；痄腮；病毒性肝炎；流行性感冒；肺炎；疮肿；疱疹。"}]},{"ID":"20240710150956-rxza32o","Type":"NodeParagraph","Properties":{"id":"20240710150956-rxza32o","updated":"20240710150956"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206091122-0081rto.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710150956-3epy0fb","Type":"NodeParagraph","Properties":{"id":"20240710150956-3epy0fb","updated":"20240710150956"}},{"ID":"20240710150956-hx093xm","Type":"NodeParagraph","Properties":{"id":"20240710150956-hx093xm","updated":"20240710150956"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 735px;","style":"width: 725px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南板蓝根 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南板蓝根 9-20240710150406-jivhiai.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 7