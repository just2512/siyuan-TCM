.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 620px;\" parent-style=\"width: 630px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821105210-9mgmunp","Type":"NodeParagraph","Properties":{"id":"20240821105210-9mgmunp","updated":"20240821110406"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白蜡树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白蜡树 1-20240821105210-0xgt72u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白蜡树 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白蜡树 2-20240821105232-wghivp9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626095226-yjj6xdb","Type":"NodeParagraph","Properties":{"id":"20240626095226-yjj6xdb","updated":"20240821110409"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 557px;","style":"width: 547px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白蜡树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白蜡树-20240626095253-idlom5d.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 547px;\" parent-style=\"width: 557px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白蜡树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白蜡树-20240821105121-9fkwrda.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612095057-6l84twt","Type":"NodeParagraph","Properties":{"id":"20240612095057-6l84twt","updated":"20240821110327"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为木犀科植物苦枥白蜡树、白蜡树、尖叶白蜡树或宿柱白蜡树的干燥枝皮或干皮；以上取图主要为白蜡树；"}]},{"ID":"20240821110256-9iitq7l","Type":"NodeParagraph","Properties":{"id":"20240821110256-9iitq7l","updated":"20240821110323"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：白蜡树雌雄异株，雄树不开花不结果，雌树开花结翅果；"}]},{"ID":"20240612095058-4xbpdws","Type":"NodeThematicBreak","Properties":{"id":"20240612095058-4xbpdws"}},{"ID":"20240612095322-buri7z7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095322-buri7z7","updated":"20240612095326"},"Children":[{"Type":"NodeText","Data":"秦皮《神农本草经》"}]},{"ID":"20240612095322-aryea2f","Type":"NodeParagraph","Properties":{"id":"20240612095322-aryea2f","updated":"20240612095322"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240612095322-xata4og","Type":"NodeParagraph","Properties":{"id":"20240612095322-xata4og","updated":"20240612095322"},"Children":[{"Type":"NodeText","Data":"主风寒湿痹，洗洗，寒气，除热，目中青翳白膜。久服，头不白，轻身。生川谷。"}]},{"ID":"20240612095322-kiaq0wn","Type":"NodeParagraph","Properties":{"id":"20240612095322-kiaq0wn","updated":"20240612095322"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：岑皮，一名秦皮，神农雷公黄帝岐伯酸无毒，李氏小寒，或生冤句水边，二月八日采。（《御览》）"}]},{"ID":"20240612095322-77fatx7","Type":"NodeParagraph","Properties":{"id":"20240612095322-77fatx7","updated":"20240612095322"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名岑皮，一名石檀，生庐江及冤句，二月八月采皮，阴干。"}]},{"ID":"20240612095322-74qvnie","Type":"NodeParagraph","Properties":{"id":"20240612095322-74qvnie","updated":"20240612095322"},"Children":[{"Type":"NodeText","Data":"案《说文》云：梣、青皮木，或作（左木右上宀下帚）。《淮南子》倜真训云：梣木，色青翳。高诱云：梣木，苦历木也，生于山，剥取其皮，以水浸之，正青，用洗眼，愈人目中肤翳。据《吴普》云：岑皮，名秦皮，本经作秦皮者，后人以俗称改之，当为岑皮。"}]},{"ID":"20240612095346-4z15fqb","Type":"NodeThematicBreak","Properties":{"id":"20240612095346-4z15fqb"}},{"ID":"20240612095347-hjkjv5c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095347-hjkjv5c","updated":"20240612095351"},"Children":[{"Type":"NodeText","Data":"秦皮《本草纲目》"}]},{"ID":"20240612095347-x0s8tax","Type":"NodeParagraph","Properties":{"id":"20240612095347-x0s8tax","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"「释名」石檀、盆桂，苦树、苦枥。"}]},{"ID":"20240612095347-x7w8c18","Type":"NodeParagraph","Properties":{"id":"20240612095347-x7w8c18","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"「气味」（皮）苦、微寒、无毒。"}]},{"ID":"20240612095347-db65jgx","Type":"NodeParagraph","Properties":{"id":"20240612095347-db65jgx","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612095347-gftb8qg","Type":"NodeParagraph","Properties":{"id":"20240612095347-gftb8qg","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"1、赤眼生翳。用秦皮一两，加水一升半煮成七合，澄清后，每日煎温洗眼。此方中亦可加滑石、黄连等分。"}]},{"ID":"20240612095347-niqtil9","Type":"NodeParagraph","Properties":{"id":"20240612095347-niqtil9","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"2、眼睛突然肿痛。用秦皮、黄连各一两，苦竹叶半升，加水二升半，煮成八合，饭后温服。"}]},{"ID":"20240612095347-je6wc0e","Type":"NodeParagraph","Properties":{"id":"20240612095347-je6wc0e","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"3、眼长挑针。用秦皮锉细，和沙糖水同煎，调大黄末一钱服，微泻见效。“"}]},{"ID":"20240612095347-enjpauc","Type":"NodeParagraph","Properties":{"id":"20240612095347-enjpauc","updated":"20240612095347"},"Children":[{"Type":"NodeText","Data":"4、血痢多年。用秦皮、鼠尾草、蔷薇根等分，水煎，去渣，再煎浓做成丸子，如梧子大。每服五、六丸，一天服二次。亦可煎服。"}]},{"ID":"20240612095553-jvdoq66","Type":"NodeThematicBreak","Properties":{"id":"20240612095553-jvdoq66"}},{"ID":"20240612095555-zv0xcde","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095555-zv0xcde","updated":"20240612095559"},"Children":[{"Type":"NodeText","Data":"秦皮《本经逢原》"}]},{"ID":"20240612095555-wb8v9zb","Type":"NodeParagraph","Properties":{"id":"20240612095555-wb8v9zb","updated":"20240612095555"},"Children":[{"Type":"NodeText","Data":"苦微寒无毒。"}]},{"ID":"20240612095555-3rxke6h","Type":"NodeParagraph","Properties":{"id":"20240612095555-3rxke6h","updated":"20240612095555"},"Children":[{"Type":"NodeText","Data":"《本经》治风寒湿痹，洗洗寒气，除热，目中青翳白膜，久服头不白轻身。"}]},{"ID":"20240612095555-f913tu9","Type":"NodeParagraph","Properties":{"id":"20240612095555-f913tu9","updated":"20240612095555"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"秦皮浸水色青，气寒，性涩，肝胆药也。《本经》治风寒湿痹，取其苦燥也。又主青白翳障，取其苦降也。小儿惊痫，取其平木也。崩中带下，热痢下重，取其涩收也。老子云，天道贵啬。此服食之品，故《本经》有久服头不白、轻身之说。而仲景白头翁汤治热痢下重，以黄柏、黄连、秦皮同用，皆苦以坚之也。秦皮、黄连等分，治赤眼肿痛。又一味煎汤洗赤目甚效。其味最苦，胃虚少食者禁用。"}]},{"ID":"20240612095706-qws5gxe","Type":"NodeThematicBreak","Properties":{"id":"20240612095706-qws5gxe"}},{"ID":"20240612095707-hlhd47y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095707-hlhd47y","updated":"20240612095713"},"Children":[{"Type":"NodeText","Data":"秦皮《证类本草》"}]},{"ID":"20240612095707-el7ruev","Type":"NodeParagraph","Properties":{"id":"20240612095707-el7ruev","updated":"20240612095707"},"Children":[{"Type":"NodeText","Data":"味苦，微寒、大寒，无毒。主风寒湿痹，洗洗寒气，除热，目中青翳白膜，疗男子妇人带下，小儿痫，身热。可作洗目汤。久服头不白，轻身，皮肤光泽，肥大有子。"}]},{"ID":"20240612095707-il0e3iy","Type":"NodeParagraph","Properties":{"id":"20240612095707-il0e3iy","updated":"20240612095707"},"Children":[{"Type":"NodeText","Data":"一名岑皮，一名石檀。生庐江川谷及冤句。二月、八月采皮，阴干。（大戟为之使，恶吴茱萸。）"}]},{"ID":"20240612095707-b4j8g0n","Type":"NodeParagraph","Properties":{"id":"20240612095707-b4j8g0n","updated":"20240612095707"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶俗是樊 （音规）皮，而水渍以和墨书，色不脱，微青。且亦殊薄，恐不必尔。俗方∶唯以疗目，道家亦有用处。唐本注云∶此树似檀，叶细，皮有白点而不粗错，取皮水渍便碧色，书纸看皆青色者是。俗见味苦，名为苦树。亦用皮疗眼，有效。以叶似檀，故名石檀也。臣禹锡等谨按药性论云∶秦白皮，平。恶苦瓠、防葵。主明目，去肝中久热，两目赤肿疼痛，风泪不止。治小儿身热，作汤浴瘥。皮一升，水煎澄清，冷洗赤眼极效。日华子云∶洗肝益精明目，小儿热惊，皮肤风痹，退热。一名盆桂。"}]},{"ID":"20240612095707-ce7ylr9","Type":"NodeParagraph","Properties":{"id":"20240612095707-ce7ylr9","updated":"20240612095707"},"Children":[{"Type":"NodeText","Data":"图经曰∶秦皮，生庐江川谷及冤句，今陕西州郡及河阳亦有之。其木大都似檀。枝干皆青绿色。叶如匙头许大而不光。并无花实，根似槐根。二月、八月采皮，阴干。其皮有白点而不粗错，俗呼为自 木。取皮渍水便碧色，书纸看之青色，此为真也。"}]},{"ID":"20240612095707-ogcbuok","Type":"NodeParagraph","Properties":{"id":"20240612095707-ogcbuok","updated":"20240612100717"},"Children":[{"Type":"NodeText","Data":"外台秘要∶治赤眼及睛上疮。秦皮一两，清水一升，于白碗中浸，春夏一食时以上，看碧色出，即以箸头缠绵，仰卧点所患眼，仍先从大 中满眼着，微痛不畏，良久，三五饭间，即侧卧沥却热汁。每日十度以上着，不过两日瘥。又方∶治眼因赤瘥后翳晕。秦皮一两，切，水一升五合，煮取七合，澄清。用渍目中。淮南子∶ 木色青，翳而羸痛蜗脘，此皆治目之药也。注∶ ，苦历木。水浸皮青用洗眼，效。沈存中秦皮，治天蛇毒。似癞而非癞也。天蛇，即...（后续内容缺）"}]},{"ID":"20240612095543-w6xh8wo","Type":"NodeThematicBreak","Properties":{"id":"20240612095543-w6xh8wo"}},{"ID":"20240612095544-ukg5y6c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095544-ukg5y6c","updated":"20240612095548"},"Children":[{"Type":"NodeText","Data":"秦皮《中药炮制》"}]},{"ID":"20240612095544-2ab8tv5","Type":"NodeParagraph","Properties":{"id":"20240612095544-2ab8tv5","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『来源』本品为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦枥白蜡树"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白蜡树"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"尖叶白腊树"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宿住白腊树"},{"Type":"NodeText","Data":"的干燥枝皮或干皮。"}]},{"ID":"20240612095544-fyg6heq","Type":"NodeParagraph","Properties":{"id":"20240612095544-fyg6heq","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『常用名』秽皮。"}]},{"ID":"20240612095544-04ife8h","Type":"NodeParagraph","Properties":{"id":"20240612095544-04ife8h","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『产地』东北及华北等地。"}]},{"ID":"20240612095544-v9x1jf5","Type":"NodeParagraph","Properties":{"id":"20240612095544-v9x1jf5","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『采收季节』春季可采。"}]},{"ID":"20240612095544-lau6ijc","Type":"NodeParagraph","Properties":{"id":"20240612095544-lau6ijc","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『炮制方法』清水洗去灰土，捞起滤干水份，稍润片刻，取出切3分长，晒干。"}]},{"ID":"20240612095544-if4nu9n","Type":"NodeParagraph","Properties":{"id":"20240612095544-if4nu9n","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『用量』3～9克。"}]},{"ID":"20240612095544-h4dtgus","Type":"NodeParagraph","Properties":{"id":"20240612095544-h4dtgus","updated":"20240612095544"},"Children":[{"Type":"NodeText","Data":"『贮存』装木箱内，防潮。"}]},{"ID":"20240612095533-gnh4si2","Type":"NodeThematicBreak","Properties":{"id":"20240612095533-gnh4si2"}},{"ID":"20240612095534-v3q0xac","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095534-v3q0xac","updated":"20240612095538"},"Children":[{"Type":"NodeText","Data":"秦皮《要药分剂》"}]},{"ID":"20240612095534-345tw1b","Type":"NodeParagraph","Properties":{"id":"20240612095534-345tw1b","updated":"20240612095534"},"Children":[{"Type":"NodeText","Data":"味苦。性寒。无毒。禀西北高寒之气而生。降也。阴也。大戟为使。恶吴萸。"}]},{"ID":"20240612095534-vmge5p7","Type":"NodeParagraph","Properties":{"id":"20240612095534-vmge5p7","updated":"20240612095534"},"Children":[{"Type":"NodeText","Data":"【主治】主风寒湿痹。洗洗寒气。除热。目中青翳白膜。（本经）男子少精。妇人带下。"}]},{"ID":"20240612095534-yqwmqrz","Type":"NodeParagraph","Properties":{"id":"20240612095534-yqwmqrz","updated":"20240612095534"},"Children":[{"Type":"NodeText","Data":"小煎水敷。（【归经】入肝胆二经。兼入肾经。为收敛之品。（兼补剂眼科要药）【前论】范汪曰。秦皮之功。以能除肝热而明目。故治目疾惊痫。以其收涩而寒。故治崩带"}]},{"ID":"20240612095416-b7hkisl","Type":"NodeThematicBreak","Properties":{"id":"20240612095416-b7hkisl"}},{"ID":"20240612095417-7oar0xf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095417-7oar0xf","updated":"20240612095421"},"Children":[{"Type":"NodeText","Data":"秦皮《本草撮要》"}]},{"ID":"20240612095417-zzov720","Type":"NodeParagraph","Properties":{"id":"20240612095417-zzov720","updated":"20240612095417"},"Children":[{"Type":"NodeText","Data":"味苦涩．入足厥阴少阳经．功专治风寒湿痹．得黄连、阿胶、白头翁治产后下痢．以秦皮煎汤．日日温洗．治赤眼生翳效．细辛、大戟为使．恶吴茱萸．"}]},{"ID":"20240612095503-kom9jzj","Type":"NodeThematicBreak","Properties":{"id":"20240612095503-kom9jzj"}},{"ID":"20240612095505-9ujrbou","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095505-9ujrbou","updated":"20240612095509"},"Children":[{"Type":"NodeText","Data":"秦皮《汤液本草》"}]},{"ID":"20240612095505-ujy6kjh","Type":"NodeParagraph","Properties":{"id":"20240612095505-ujy6kjh","updated":"20240612095505"},"Children":[{"Type":"NodeText","Data":"气寒，味苦。无毒。"}]},{"ID":"20240612095505-0c4dwnx","Type":"NodeParagraph","Properties":{"id":"20240612095505-0c4dwnx","updated":"20240612095505"},"Children":[{"Type":"NodeText","Data":"《液》云∶主热利下重，下焦虚。经云∶以苦坚之。故用白头翁、黄柏、秦皮，苦之剂也。治风寒湿痹，目中青翳白膜，男子少精，妇人带下，小儿惊痫，宜作汤洗目，俗呼为白木。取皮渍水，浸出青蓝色，与紫草同用，以增光晕尤佳。大戟为之使。恶吴茱萸。"}]},{"ID":"20240612095450-c9gj1lc","Type":"NodeThematicBreak","Properties":{"id":"20240612095450-c9gj1lc"}},{"ID":"20240612095452-ox451mi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095452-ox451mi","updated":"20240612095457"},"Children":[{"Type":"NodeText","Data":"秦皮《得配本草》"}]},{"ID":"20240612095452-zxrisiz","Type":"NodeParagraph","Properties":{"id":"20240612095452-zxrisiz","updated":"20240612095452"},"Children":[{"Type":"NodeText","Data":"苦瓠、防癸、大戟为之使。恶吴茱萸。"}]},{"ID":"20240612095452-62lffla","Type":"NodeParagraph","Properties":{"id":"20240612095452-62lffla","updated":"20240612095452"},"Children":[{"Type":"NodeText","Data":"苦，寒、涩。入足厥阴、少阴经。治下痢崩带，疗风寒湿痹，祛肝热，点白膜。（煎汁澄清，频点自效。秦皮能达木郁，木不郁则诸症悉除。）配滑石、川连，洗赤眼生翳；配川连、竹叶，治眼暴赤。"}]},{"ID":"20240612095452-yc37sx2","Type":"NodeParagraph","Properties":{"id":"20240612095452-yc37sx2","updated":"20240612095452"},"Children":[{"Type":"NodeText","Data":"怪症∶田夫忽然发癞，遍身溃烂，号呼欲绝，此天蛇毒也。用秦皮煮汁一斗，二三次服之。"}]},{"ID":"20240612095437-4scmunr","Type":"NodeThematicBreak","Properties":{"id":"20240612095437-4scmunr"}},{"ID":"20240612095438-7bytx2v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095438-7bytx2v","updated":"20240612095446"},"Children":[{"Type":"NodeText","Data":"秦皮《冯氏锦囊秘录》"}]},{"ID":"20240612095438-lncn6tr","Type":"NodeParagraph","Properties":{"id":"20240612095438-lncn6tr","updated":"20240612095438"},"Children":[{"Type":"NodeText","Data":"秦皮，功专眼科，去肝中久热，煎汁澄净，点洗无时，白膜遮睛，视物不见者，旋效。亦肿作痛，流泪无休者殊功，益男子精衰，止妇人带下，风寒湿痹兼驱，热痢后重且却。"}]},{"ID":"20240612095426-qucuy25","Type":"NodeThematicBreak","Properties":{"id":"20240612095426-qucuy25"}},{"ID":"20240612095427-rclyz87","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095427-rclyz87","updated":"20240612095432"},"Children":[{"Type":"NodeText","Data":"秦皮《本草便读》"}]},{"ID":"20240612095427-xkjp9et","Type":"NodeParagraph","Properties":{"id":"20240612095427-xkjp9et","updated":"20240612095427"},"Children":[{"Type":"NodeText","Data":"味苦气寒．色青性涩．主少阳协热之痢疾．逐水行皮．洗厥阴湿火之阳邪．祛风明目．（秦皮浸水色青．书纸不落．且不沾水．故入肝胆二经．以其性寒也．故专清肝胆之湿火．其主治一切之病．皆由肝胆湿火所致．至能益精者．亦邪热去则精自益耳．）"}]},{"ID":"20240612095405-pdnts0l","Type":"NodeThematicBreak","Properties":{"id":"20240612095405-pdnts0l"}},{"ID":"20240612095406-2juo1lo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095406-2juo1lo","updated":"20240612095410"},"Children":[{"Type":"NodeText","Data":"秦皮《新修本草》"}]},{"ID":"20240612095406-0h9v545","Type":"NodeParagraph","Properties":{"id":"20240612095406-0h9v545","updated":"20240612095406"},"Children":[{"Type":"NodeText","Data":"味苦，微寒、大寒，无毒。主风寒湿痹，洗洗寒气，除热，目中青翳白膜。疗男子少精，妇人带下，小儿痫，身热。"}]},{"ID":"20240612095406-17u0soz","Type":"NodeParagraph","Properties":{"id":"20240612095406-17u0soz","updated":"20240612095406"},"Children":[{"Type":"NodeText","Data":"可作洗目汤。久服头不白，轻身，皮肤光泽，肥大有子。一名岑皮，一名石檀。生庐江川谷及宛朐。二月、八月采皮，阴干。"}]},{"ID":"20240612095406-y88tw3c","Type":"NodeParagraph","Properties":{"id":"20240612095406-y88tw3c","updated":"20240612095406"},"Children":[{"Type":"NodeText","Data":"大戟为之使，恶吴茱萸。俗云是樊 皮，而水渍以和墨，书青色不脱，彻青，且亦殊薄，恐不必尔。俗方惟以疗目。道术家亦有用处。"}]},{"ID":"20240612095406-38pqwew","Type":"NodeParagraph","Properties":{"id":"20240612095406-38pqwew","updated":"20240612095406"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此树似檀。叶细，皮有白点而不粗错。取皮水渍便碧色，书纸看皆青色者是。俗见味苦，名为苦树，亦用皮，疗眼有效。以叶似檀，故名石檀也。"}]},{"ID":"20240612095258-vz9cy8d","Type":"NodeThematicBreak","Properties":{"id":"20240612095258-vz9cy8d"}},{"ID":"20240612095312-fn4tgvt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095312-fn4tgvt","updated":"20240612095316"},"Children":[{"Type":"NodeText","Data":"秦皮《本草崇原》"}]},{"ID":"20240612095312-rofg7ye","Type":"NodeParagraph","Properties":{"id":"20240612095312-rofg7ye","updated":"20240612095312"},"Children":[{"Type":"NodeText","Data":"气味苦，微寒，无毒。主治风寒湿痹，洗洗寒气，除热，目中青翳白膜。久服头不白，轻身。"}]},{"ID":"20240612095312-0tfmx2w","Type":"NodeParagraph","Properties":{"id":"20240612095312-0tfmx2w","updated":"20240612095312"},"Children":[{"Type":"NodeText","Data":"（秦皮本名 皮，出陕西州郡，河阳亦有之，其木似檀枝干，皆青绿色，叶细无花实，皮上有白点而不粗错，取皮渍水，色便青碧，书纸上视之亦青色者，为真。）"}]},{"ID":"20240612095312-ad7zt81","Type":"NodeParagraph","Properties":{"id":"20240612095312-ad7zt81","updated":"20240612095312"},"Children":[{"Type":"NodeText","Data":"秦木生于水旁，其皮气味苦寒，其色青碧，受水泽之精，具青碧之色，乃禀水木相生之气化。禀木气而春生，则风寒湿邪之痹证，及肤皮洗洗然之寒气，皆可治也。禀水气而清热，故主除热。目者肝之窍，木气盛，则肝气益，故治目中青翳白膜。发者，血之余，水精足，则血亦充，故久服头不白而轻身。"}]},{"ID":"20240612095258-8w4h3ln","Type":"NodeThematicBreak","Properties":{"id":"20240612095258-8w4h3ln"}},{"ID":"20240612095259-6qkjs36","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095259-6qkjs36","updated":"20240612095303"},"Children":[{"Type":"NodeText","Data":"秦皮《本草述钩元》"}]},{"ID":"20240612095259-z3rfilf","Type":"NodeParagraph","Properties":{"id":"20240612095259-z3rfilf","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"出陕西州郡及河阳。其木似檀。枝干皆青绿。叶细如匙。虚大不光。并无花实。皮上有白点。"}]},{"ID":"20240612095259-2d08fdi","Type":"NodeParagraph","Properties":{"id":"20240612095259-2d08fdi","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"味苦。气寒微。沉也。降也。入足厥阴少阳经。大戟为之使。恶吴茱萸。主治风寒湿痹洗洗寒气。（如冷水浇）洗肝益精。除热。疗目中青翳白膜。去两目赤肿疼痛。久热风泪不止。治热痢下重。下焦虚。疗妇人崩带。作汤浴小儿惊痫风热。秦皮水浸。即青碧。青入肝。风邪为病。先见于色。当为肝之风药。"}]},{"ID":"20240612095259-vo9pofj","Type":"NodeParagraph","Properties":{"id":"20240612095259-vo9pofj","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"〔论〕本经秦皮首主风寒湿痹。洗洗寒气除热。是所谓除热者。即其散风寒湿之痹。"}]},{"ID":"20240612095259-c7gtr9j","Type":"NodeParagraph","Properties":{"id":"20240612095259-c7gtr9j","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"不致郁而为热也。继云疗目中青翳白膜。夫东垣论青白翳有曰。阴盛阳虚。则九窍不通。令青白翳见于大。乃足太阳少阴经中郁遏。厥阴肝气。不得上通于目。故青白内阻也。以此相证。则秦皮退热之功。不专散肝经之风寒湿痹哉。日华子定其用曰洗肝。为能祛寒水之阴以达阳。不致郁而为热。得还其敷和之平气也。故伤寒传经至厥阴。仲景用此为主药。可谓得先圣之精诣矣。（传经之热。正因寒郁。）别录疗男子少精。妇人带下。何以明之。张子和曰。冲任督三脉。同起而异行。一源而三歧。皆属带脉。因诸经上下往来。遗热于带脉之间。"}]},{"ID":"20240612095259-wa8wxx6","Type":"NodeParagraph","Properties":{"id":"20240612095259-wa8wxx6","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"客热郁抑。遂致白物淫溢。男子因溲而下。女子绵绵而下也。经曰。带脉起于季肋足厥阴之章门穴。同足少阳循带脉穴。围周一身。如束带然。若是。则带下之病。焉得不取责于肝乎。"}]},{"ID":"20240612095259-sfsh6hh","Type":"NodeParagraph","Properties":{"id":"20240612095259-sfsh6hh","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"夫冲任督皆本于肾。皆以肝行其化。秦皮达其阴之郁阳者。即能祛其阳之伤阴者。如带下之疗。在除湿热。即本经达风寒湿痹之气。而便以除热之治也。粗工漫同苦寒之味言其退热。"}]},{"ID":"20240612095259-7x6vgyf","Type":"NodeParagraph","Properties":{"id":"20240612095259-7x6vgyf","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"岂知本经止言其气微寒。而甑权又言气平。不依然敷和之春气哉。至于男子益精。当思冲任督俱起于肾。俱行化于肝。以默识此味之功矣。经曰。两神相搏谓之精。两神者。阴阳二气也。肝以一阴为独使。下合于任。上会于督。阴阳之相搏也。岂其微哉。（肝得行其化。"}]},{"ID":"20240612095259-yrt71zg","Type":"NodeParagraph","Properties":{"id":"20240612095259-yrt71zg","updated":"20240612095259"},"Children":[{"Type":"NodeText","Data":"则阴中之阳。所谓元气者自盛。气盛则精盈。修真家亦是此理。）〔辨治〕去骨取皮。渍水。水色侵碧。书纸纸面略青者真。"}]},{"ID":"20240612095230-0ek1ub8","Type":"NodeThematicBreak","Properties":{"id":"20240612095230-0ek1ub8"}},{"ID":"20240612095249-qd4qwem","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095249-qd4qwem","updated":"20240612095253"},"Children":[{"Type":"NodeText","Data":"秦皮《医学入门》"}]},{"ID":"20240612095249-l5ciaxm","Type":"NodeParagraph","Properties":{"id":"20240612095249-l5ciaxm","updated":"20240612095249"},"Children":[{"Type":"NodeText","Data":"秦皮苦寒解热痢，清肝主风寒湿痹，补精止带洗惊痫，点赤眼肿除翳泪。"}]},{"ID":"20240612095249-o2qem9c","Type":"NodeParagraph","Properties":{"id":"20240612095249-o2qem9c","updated":"20240612095249"},"Children":[{"Type":"NodeText","Data":"生秦地陕西州郡，取出渍水皮纸，碧色不脱者真。无毒。《液》云∶主热痢下重，以苦坚之，黄柏、白头翁、秦皮是也。治肝中久热，两目赤肿疼痛，风寒湿痹，洗洗寒气，男子少精发白，妇人带下亦宜。作汤浴小儿惊痫身热，水煎澄清洗赤眼，或冷水浸点眼，除青翳白膜、风泪不止。如草间花黄蜘蛛螫人似癞，煮汁饮一斗即瘥。去骨，大戟为使，恶吴萸、苦匏、防葵。"}]},{"ID":"20240612095231-5av07lk","Type":"NodeThematicBreak","Properties":{"id":"20240612095231-5av07lk"}},{"ID":"20240612095241-hv7hiry","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095241-hv7hiry","updated":"20240612095245"},"Children":[{"Type":"NodeText","Data":"秦皮《本草备要》"}]},{"ID":"20240612095241-kzps1go","Type":"NodeParagraph","Properties":{"id":"20240612095241-kzps1go","updated":"20240612095241"},"Children":[{"Type":"NodeText","Data":"涩而补，明目"}]},{"ID":"20240612095241-t5wq3h7","Type":"NodeParagraph","Properties":{"id":"20240612095241-t5wq3h7","updated":"20240612095241"},"Children":[{"Type":"NodeText","Data":"苦寒，色青，性涩。补肝胆而益肾。以能平木（能除肝热）故治目疾（洗目赤，退翳膜）"}]},{"ID":"20240612095241-rafh19k","Type":"NodeParagraph","Properties":{"id":"20240612095241-rafh19k","updated":"20240612095241"},"Children":[{"Type":"NodeText","Data":"惊痫。以其收涩而寒，故治崩带下痢（仲景白头翁汤用之）。以其涩而补下焦，故能益精有子（时珍曰∶天道贵啬，惟收涩故能补。今人只知治目一节，几于废弃，良为可婉）。出西土。皮有白点、渍水碧色、书纸不脱者真。大戟为使。恶吴茱萸。"}]},{"ID":"20240612095231-9th2nht","Type":"NodeThematicBreak","Properties":{"id":"20240612095231-9th2nht"}},{"ID":"20240612095232-ykbybo8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095232-ykbybo8","updated":"20240612095236"},"Children":[{"Type":"NodeText","Data":"秦皮《本草从新》"}]},{"ID":"20240612095232-9tssucx","Type":"NodeParagraph","Properties":{"id":"20240612095232-9tssucx","updated":"20240612095232"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻热、治目疾、涩止痢．"}]},{"ID":"20240612095232-dho25fb","Type":"NodeParagraph","Properties":{"id":"20240612095232-dho25fb","updated":"20240612095232"},"Children":[{"Type":"NodeText","Data":"苦寒．色青性涩．以其除肝热而平木．故治目疾．（洗服皆效．）惊痫风湿诸痹．以其收涩．"}]},{"ID":"20240612095232-831ch6r","Type":"NodeParagraph","Properties":{"id":"20240612095232-831ch6r","updated":"20240612095232"},"Children":[{"Type":"NodeText","Data":"故治崩带下痢．苦寒清热．是其所长．纲目谓其久服轻身．益精有子．未必然也．出西土．"}]},{"ID":"20240612095232-arw5zhh","Type":"NodeParagraph","Properties":{"id":"20240612095232-arw5zhh","updated":"20240612095232"},"Children":[{"Type":"NodeText","Data":"皮不脱者真．今药客俱以此皮缚北细辛．大戟为使．恶吴茱萸．（赤眼生翳、水煮秦皮一两、澄清、日日温洗．）"}]},{"ID":"20240612095058-ukkw7p0","Type":"NodeThematicBreak","Properties":{"id":"20240612095058-ukkw7p0"}},{"ID":"20240612095222-fyw1rg1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095222-fyw1rg1","updated":"20240612095226"},"Children":[{"Type":"NodeText","Data":"秦皮《千金翼方》"}]},{"ID":"20240612095222-g6eviu5","Type":"NodeParagraph","Properties":{"id":"20240612095222-g6eviu5","updated":"20240612095222"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，大寒，无毒。主风寒湿痹，洗洗寒气，除热中，目中青翳白膜。疗精，妇人带下，小儿痫，身热。可作洗目汤。久服头不白，轻身，皮肤光泽，肥大，有子一名岑皮，一名石檀。生庐江川谷及冤句，二月八月采皮，阴干。"}]},{"ID":"20240612095058-d12byjh","Type":"NodeThematicBreak","Properties":{"id":"20240612095058-d12byjh"}},{"ID":"20240612095212-3w32sbs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095212-3w32sbs","updated":"20240612095216"},"Children":[{"Type":"NodeText","Data":"秦皮《本草求真》"}]},{"ID":"20240612095212-4051ifm","Type":"NodeParagraph","Properties":{"id":"20240612095212-4051ifm","updated":"20240612095212"},"Children":[{"Type":"NodeText","Data":"（乔木）除肝热泻肾气"}]},{"ID":"20240612095212-8nl4sj4","Type":"NodeParagraph","Properties":{"id":"20240612095212-8nl4sj4","updated":"20240612095212"},"Children":[{"Type":"NodeText","Data":"秦皮（专入肝胆肾）。味苦气寒。色青性涩。功专入肝以除热。入肾以涩气。是以因风而见湿痹惊痫目障之症者。则当用此苦燥苦降之味以除。因脱而见崩带肠 下痢之症者。则当用此取涩寒气以固。如仲景白头翁之用秦皮苦涩之类。（白头翁黄柏黄连秦皮等分。）老子云。天道贵涩。惟涩故补。服此不惟泄热止脱。而且益肾有子矣。至治赤眼肿痛。则合黄连等分频点。并秦皮一味。煎汤以洗甚效。（或加滑石黄连等分。出外台秘要。）但此气寒伤胃。总不宜于胃虚少食之人耳。出西上。皮有白点。渍水碧色。书纸不脱者真。大戟为使。恶吴茱萸。"}]},{"ID":"20240612095033-nwres9h","Type":"NodeThematicBreak","Properties":{"id":"20240612095033-nwres9h"}},{"ID":"20240612095051-z7e489m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095051-z7e489m","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"《中国药典》：秦皮"}]},{"ID":"20240612095051-ti4u92c","Type":"NodeParagraph","Properties":{"id":"20240612095051-ti4u92c","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612095051-eci5qhc","Type":"NodeParagraph","Properties":{"id":"20240612095051-eci5qhc","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" Qín Pí"}]},{"ID":"20240612095051-qn62c6i","Type":"NodeParagraph","Properties":{"id":"20240612095051-qn62c6i","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612095051-oqdwmzl","Type":"NodeParagraph","Properties":{"id":"20240612095051-oqdwmzl","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 梣皮"}]},{"ID":"20240612095051-sfz7y40","Type":"NodeParagraph","Properties":{"id":"20240612095051-sfz7y40","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612095051-u41wthd","Type":"NodeParagraph","Properties":{"id":"20240612095051-u41wthd","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" CORTEX FRAXINI"}]},{"ID":"20240612095051-b967bh5","Type":"NodeParagraph","Properties":{"id":"20240612095051-b967bh5","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612095051-b6p48ay","Type":"NodeParagraph","Properties":{"id":"20240612095051-b6p48ay","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 本品为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦枥白蜡树"},{"Type":"NodeText","Data":"Fraxinus rhynchophylla Hance、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白蜡树"},{"Type":"NodeText","Data":"Fraxinus chinensis Roxb.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"尖叶白蜡树"},{"Type":"NodeText","Data":"Fraxinus szaboana Lingelsh.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宿柱白蜡树"},{"Type":"NodeText","Data":"Fraxinus stylosa Lingelsh.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枝皮"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干皮"},{"Type":"NodeText","Data":"。春、秋二季剥取，晒干。"}]},{"ID":"20240612095051-tp3clys","Type":"NodeParagraph","Properties":{"id":"20240612095051-tp3clys","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612095051-q8tym0o","Type":"NodeParagraph","Properties":{"id":"20240612095051-q8tym0o","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 枝皮：呈卷筒状或槽状，长10～60cm，厚1。5～3mm。外表面灰白色、灰棕色至黑棕色或相间呈斑状，平坦或稍粗糙，并有灰白色圆点状皮孔及细斜皱纹，有的具分枝痕。内表面黄白色或棕色，平滑。质硬而脆，断面纤维性，黄白色。无臭，味苦。"}]},{"ID":"20240612095051-b039oio","Type":"NodeParagraph","Properties":{"id":"20240612095051-b039oio","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"干皮：为长条状块片，厚3～6mm。外表面灰棕色，具龟裂状沟纹及红棕色圆形或横长的皮孔。质坚硬，断面纤维性较强。"}]},{"ID":"20240612095051-uizeuth","Type":"NodeParagraph","Properties":{"id":"20240612095051-uizeuth","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612095051-aa78727","Type":"NodeParagraph","Properties":{"id":"20240612095051-aa78727","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切丝，晒干。"}]},{"ID":"20240612095051-3j1c25r","Type":"NodeParagraph","Properties":{"id":"20240612095051-3j1c25r","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612095051-idpl8at","Type":"NodeParagraph","Properties":{"id":"20240612095051-idpl8at","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" （1）取本品，加热水浸泡，浸出液在日光下可见碧蓝色荧光。"}]},{"ID":"20240612095051-uxtcj30","Type":"NodeParagraph","Properties":{"id":"20240612095051-uxtcj30","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"（2）本品横切面：木栓层为5～10 余列细胞。栓内层为数列多角形厚角细胞。皮层较宽，纤维及石细胞单个散在或成群。中柱鞘部位有石细胞及纤维束组成的环带，偶有间断。韧皮部射线宽1～3列细胞；纤维束及少数石细胞成层状排列，中间贯穿射线，形成“井”字形，薄壁细胞含草酸钙砂晶。"}]},{"ID":"20240612095051-gnsynto","Type":"NodeParagraph","Properties":{"id":"20240612095051-gnsynto","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醇10ml，加热回流10分钟，放冷，滤过，滤液作为供试品溶液。另取秦皮甲素与秦皮乙素对照品，加乙醇制成每1ml 各含5mg 的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各3μl，分别点于同一硅胶Ｇ薄层板上，以甲苯－醋酸乙酯－乙醇-甲酸（3:4:2:1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240612095051-56lg5kp","Type":"NodeParagraph","Properties":{"id":"20240612095051-56lg5kp","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612095051-lgykzip","Type":"NodeParagraph","Properties":{"id":"20240612095051-lgykzip","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 归肝、胆、大肠经。"}]},{"ID":"20240612095051-bplt7co","Type":"NodeParagraph","Properties":{"id":"20240612095051-bplt7co","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612095051-0p289kn","Type":"NodeParagraph","Properties":{"id":"20240612095051-0p289kn","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 苦、涩，寒。"}]},{"ID":"20240612095051-h17ny32","Type":"NodeParagraph","Properties":{"id":"20240612095051-h17ny32","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612095051-vdll174","Type":"NodeParagraph","Properties":{"id":"20240612095051-vdll174","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，收涩，明目。用于热痢，泄泻，赤白带下，目赤肿痛，目生翳膜。"}]},{"ID":"20240612095051-321bs93","Type":"NodeParagraph","Properties":{"id":"20240612095051-321bs93","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612095051-ugzz77b","Type":"NodeParagraph","Properties":{"id":"20240612095051-ugzz77b","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 6～12g。外用适量，煎洗患处。"}]},{"ID":"20240612095051-6if9db0","Type":"NodeParagraph","Properties":{"id":"20240612095051-6if9db0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612095051-fh7isvp","Type":"NodeParagraph","Properties":{"id":"20240612095051-fh7isvp","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" （1）对湿热下痢、里急后重，常配伍白头翁、黄连、黄柏等同用。用于目赤肿痛等症，可与黄连、竹叶等配伍同用；也可用以煎汁洗眼。"}]},{"ID":"20240612095051-mxwbva0","Type":"NodeParagraph","Properties":{"id":"20240612095051-mxwbva0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612095051-35vr6mg","Type":"NodeParagraph","Properties":{"id":"20240612095051-35vr6mg","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612095051-nf1qjh6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095051-nf1qjh6","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：秦皮"}]},{"ID":"20240612095051-mpzb1sg","Type":"NodeParagraph","Properties":{"id":"20240612095051-mpzb1sg","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612095051-rwiwezl","Type":"NodeParagraph","Properties":{"id":"20240612095051-rwiwezl","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" Qín Pí"}]},{"ID":"20240612095051-ejphtrz","Type":"NodeParagraph","Properties":{"id":"20240612095051-ejphtrz","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612095051-hq8c13c","Type":"NodeParagraph","Properties":{"id":"20240612095051-hq8c13c","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 岑皮（《淮南万毕术》），梣皮（《别录》），樊槻皮（陶弘景），秦白皮（《药性论》），蜡树皮（《中药志》），苦榴皮（《全展选编·皮肤病》）。"}]},{"ID":"20240612095051-gsgx85e","Type":"NodeParagraph","Properties":{"id":"20240612095051-gsgx85e","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612095051-xgu90uv","Type":"NodeParagraph","Properties":{"id":"20240612095051-xgu90uv","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612095051-5k6o1rt","Type":"NodeParagraph","Properties":{"id":"20240612095051-5k6o1rt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612095051-y7m8j2z","Type":"NodeParagraph","Properties":{"id":"20240612095051-y7m8j2z","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦枥白蜡树"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小叶白蜡树"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"秦岭白蜡树"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"。春、秋剥下枝皮或干皮，晒干。"}]},{"ID":"20240612095051-87g28r2","Type":"NodeParagraph","Properties":{"id":"20240612095051-87g28r2","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612095051-3r6yhjm","Type":"NodeParagraph","Properties":{"id":"20240612095051-3r6yhjm","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" ①苦枥白蜡树，又名：梣木（《淮南子》），苦枥木（《淮南子》高诱注），石檀（《别录》），苦树（《唐本草》），盆桂（《日华子本草》），樊鸡木（《集韵》），秦木（《纲目》），秤星树（《植物名实图考》），大叶栲、大叶白蜡树、花曲柳。"}]},{"ID":"20240612095051-77si41g","Type":"NodeParagraph","Properties":{"id":"20240612095051-77si41g","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高10米左右。树皮灰褐色，较平滑，老时浅裂；小枝亦平滑，皮孔稀疏，阔椭圆形；芽短阔，密被褐色绒毛。单数羽状复叶，对生；叶轴光滑无毛；小叶通常5片，罕有3或7片，小叶柄长5～15毫米，光滑无毛；叶片卵形，罕有长卵形或阔卵形，顶端1片最大，长8～11厘米，宽4.5～6.5厘米，基部一对最小，长4～6厘米，宽3～4.5厘米，先端渐尖，基部阔楔形或略呈圆形，边缘有浅粗锯齿，上面光滑，下面沿中脉下部之两侧有棕色柔毛。花与叶同时开放，或稍迟于叶，圆锥花序生于当年小枝顶端及叶腋；花小，花萼杯状，4裂；无花冠；雄蕊2，外露；雌蕊2，心皮合生，柱头2裂。翅果倒长披针形，窄或稍宽，长约3厘米，先端窄圆或窄尖。花期5～6月。果期8～9月。"}]},{"ID":"20240612095051-piyn2ze","Type":"NodeParagraph","Properties":{"id":"20240612095051-piyn2ze","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"生于阳坡或阔叶林山坡。分布吉林、辽宁、河北、河南等地。"}]},{"ID":"20240612095051-0mo6cul","Type":"NodeParagraph","Properties":{"id":"20240612095051-0mo6cul","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②小叶白蜡树"}]},{"ID":"20240612095051-95atq87","Type":"NodeParagraph","Properties":{"id":"20240612095051-95atq87","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"形态与上种相近，主要区别点为：小叶小，卵形或圆卵形，长2～4厘米，宽1.5～2.5厘米，最下一对小叶不较其他小叶小，或微小；叶两面光滑无毛。有花冠，花瓣线形，淡绿色。花期5月。果期9月。"}]},{"ID":"20240612095051-36ned9w","Type":"NodeParagraph","Properties":{"id":"20240612095051-36ned9w","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"生长于山坡、疏林、沟旁。分布辽宁、吉林、河北、河南、内蒙古、陕西、山西、四川等地。"}]},{"ID":"20240612095051-59ast6h","Type":"NodeParagraph","Properties":{"id":"20240612095051-59ast6h","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"③秦岭白蜡树"}]},{"ID":"20240612095051-cqavcci","Type":"NodeParagraph","Properties":{"id":"20240612095051-cqavcci","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高达20米。冬芽具锈色绒毛。单数羽状复叶，小叶7～9枚，叶柄极短；叶片卵形或长圆状披针形，长8～18厘米，先端渐尖，基部圆形或宽楔形，边缘有浅波状锯齿，下面中部或其基部具锈色绒毛。圆锥花序长大，顶生；花白色，萼大，4裂；花瓣基部线状，渐向先端扩大为匙形；雄蕊与花瓣等高。翅果线状匙形，长2.5～3厘米。花期6月。"}]},{"ID":"20240612095051-05zwgj8","Type":"NodeParagraph","Properties":{"id":"20240612095051-05zwgj8","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"生于山坡或沟岸。分布四川、湖北、陕西等地。"}]},{"ID":"20240612095051-w9d3ro0","Type":"NodeParagraph","Properties":{"id":"20240612095051-w9d3ro0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612095051-l6aet9y","Type":"NodeParagraph","Properties":{"id":"20240612095051-l6aet9y","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 干燥的枝皮呈卷筒状或槽状长条形，长30～70厘米，径1.5～3厘米，厚约3毫米。表面灰褐色或灰黑色，往往相杂不匀。外皮不平滑，有浅色斑点，内面黄白色或棕色，有光泽。质硬，易折断，断面黄白色，纤维性。无臭，味苦。水浸液黄碧色，并有蓝色萤光。干燥的干皮为长条状块片，不成卷，厚6～10毫米。外皮灰棕色，有红棕色斑点相同成不规则的斑纹，外皮剥离后，可见红棕色的内皮。内面浅棕红色，平滑。余与枝皮同。以整齐、长条呈筒状者为佳。"}]},{"ID":"20240612095051-0syqeye","Type":"NodeParagraph","Properties":{"id":"20240612095051-0syqeye","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"主产陕西、河北、河南、山西、辽宁、吉林等地。"}]},{"ID":"20240612095051-fqs85ds","Type":"NodeParagraph","Properties":{"id":"20240612095051-fqs85ds","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"商品秦皮，除上述品种外，目前在国内大部分地区以胡桃科植物核桃楸的枝皮作秦皮用，但据《本草》记载，秦皮应为苦枥白蜡树的树皮。两者的区别：苦枥白蜡树皮常呈卷筒状，易成层状剥离，水浸液黄碧色，有蓝色萤光；核桃楸皮常呈扭曲状、绳状，不易成层状剥离，水浸液黄棕色，无萤光。参见\"核桃楸皮\"条。"}]},{"ID":"20240612095051-f2ziz6t","Type":"NodeParagraph","Properties":{"id":"20240612095051-f2ziz6t","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612095051-oarstle","Type":"NodeParagraph","Properties":{"id":"20240612095051-oarstle","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 苦枥白蜡树树皮含马栗树皮甙、马栗树皮素等香豆精类及鞣质。"}]},{"ID":"20240612095051-wo389lv","Type":"NodeParagraph","Properties":{"id":"20240612095051-wo389lv","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"小叶白蜡树树皮含秦皮素、秦皮甙、马栗树皮素、马栗树皮甙等多种香豆精类、鞣质、皂甙。种子含油15.8％。"}]},{"ID":"20240612095051-b3ip4bs","Type":"NodeParagraph","Properties":{"id":"20240612095051-b3ip4bs","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612095051-d4cf60t","Type":"NodeParagraph","Properties":{"id":"20240612095051-d4cf60t","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" ①消炎、镇痛作用"}]},{"ID":"20240612095051-o71k9u0","Type":"NodeParagraph","Properties":{"id":"20240612095051-o71k9u0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"大鼠腹腔注射马栗树皮甙10毫克/公斤，对角义菜胶性、右旋糖酐性、5-羟色胺性及组织胺性\"关节炎\"有抑制作用，抑制的强度分别为35，28，20，8％。也有报告，马栗树皮甙对甲醛性\"关节炎\"亦有抑制作用，但弱于对角义菜胶性者，而对右旋糖酐性\"关节炎\"的抑制不明显。马栗树皮素在大剂量时对角义菜胶性\"关节炎\"亦有抑制作用。马栗树皮甙能抑制大鼠的肉芽肿形成（棉球法），对豚鼠紫外线照射背部引起的红斑反应，也有抑制作用，马栗树皮素之作用较马栗树皮甙更显著，两者都有显著抑制组织胺引起的毛细血管通透性的作用，马栗树皮甙还有微弱的镇痛作用（小鼠热板法），如以吗啡皮下注射5毫克/公斤的效力作为100％，则马栗树皮甙口服10毫克/公斤之效价为14.8％。"}]},{"ID":"20240612095051-mcbmsg2","Type":"NodeParagraph","Properties":{"id":"20240612095051-mcbmsg2","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②对尿量及尿酸排泄的影响"}]},{"ID":"20240612095051-bvsfp4w","Type":"NodeParagraph","Properties":{"id":"20240612095051-bvsfp4w","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"早年报告秦皮甙有利尿作用，能促进家兔及风湿病患者尿酸的排泄。马栗树皮甙在大鼠及兔的试验中，各种给药途径均可增进尿酸的排泄。在家兔静脉注射马栗树皮甙后，最初半小时内尿量增加，此后血中尿酸浓度即见上升，半小时后尿量即逐渐减少，而尿中尿酸的排泄却不断增加。尿量之增加，仅指给药后短期而言（可能系肾小管重吸收减少所致），给药3～4小时后，尿量仅为给药前的1/2。尿酸排泄增进之作用原理，据分析，系兴奋了交感神经系统；而且马栗树皮甙对肾脏也有直接作用，即抑制了对尿酸的重吸收所致。血中尿酸浓度之增高为肝中尿酸生成增加的结果。也有报告，马栗树皮甙对正常大鼠并无利尿作用，而对小鼠却有较显著的利尿作用。"}]},{"ID":"20240612095051-45emv2a","Type":"NodeParagraph","Properties":{"id":"20240612095051-45emv2a","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240612095051-spgrlss","Type":"NodeParagraph","Properties":{"id":"20240612095051-spgrlss","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"马栗树皮甙对其他器官的作用一般皆不显著。对兔的血压、呼吸、肠管皆无作用。对豚鼠离体小肠、子宫、膀胱、胆囊及离体蛙心以及对兔在位子宫、兔耳血管、蟾蜍下肢血管亦无作用；亦不影响兔颈动脉、股动脉的血流量。马栗树皮素对兔有轻度升压作用，还能抑制离体蟾蜍心脏及离体兔肠，轻度收缩蟾蜍下肢血管，离体蟾蜍腓肠肌之兴奋性亦略有降低。秦皮煎剂还有某些抗菌、治疗慢性气管炎的作用。马栗树皮甙的化学结构与双香豆素相似，故有某些抗血凝作用，其4％溶液能吸收紫外线，故能保护皮肤，免受日光照射之损伤。"}]},{"ID":"20240612095051-4sw9fkh","Type":"NodeParagraph","Properties":{"id":"20240612095051-4sw9fkh","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"④排泄、吸收及一般毒性"}]},{"ID":"20240612095051-5bi2xfr","Type":"NodeParagraph","Properties":{"id":"20240612095051-5bi2xfr","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"马粟树皮甙口服后在小肠上部吸收，胃与大肠不吸收；注射后可出现于胆囊及尿中，肾上腺、睾丸及肾中很早即出现，亦可至脑中。大鼠无论口服或静脉注射，尿中及大便中皆有排出，以原形为主，豚鼠则主要在体内破坏。"}]},{"ID":"20240612095051-2yxn5va","Type":"NodeParagraph","Properties":{"id":"20240612095051-2yxn5va","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"马栗树皮甙3克/公斤或马栗树皮素1克/公斤腹腔注射于小鼠，皆不致死，故毒性很低；但也有报告马栗树皮素皮下注射250毫克/公斤即可致死的。日本秦皮提取物给兔灌胃每天3克/公斤，连续45周仅引起轻度的组织病变，如胃肠粘膜呈现分泌亢进、肠神经丛的膨大及肾小球、肾小管的退行性病变；长期注射给药，肝功能及末梢血象皆无显著变化。"}]},{"ID":"20240612095051-mysb0cb","Type":"NodeParagraph","Properties":{"id":"20240612095051-mysb0cb","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612095051-k1z69ph","Type":"NodeParagraph","Properties":{"id":"20240612095051-k1z69ph","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，洗净，润透后切块或切段，晒干。"}]},{"ID":"20240612095051-d3flwes","Type":"NodeParagraph","Properties":{"id":"20240612095051-d3flwes","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612095051-88fyb7u","Type":"NodeParagraph","Properties":{"id":"20240612095051-88fyb7u","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 入肝、胆经。"}]},{"ID":"20240612095051-tmkor4p","Type":"NodeParagraph","Properties":{"id":"20240612095051-tmkor4p","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"厥阴肝、少阳胆经。\""}]},{"ID":"20240612095051-aoe659v","Type":"NodeParagraph","Properties":{"id":"20240612095051-aoe659v","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肝、肾二经。\""}]},{"ID":"20240612095051-x4enolo","Type":"NodeParagraph","Properties":{"id":"20240612095051-x4enolo","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612095051-i65n3ln","Type":"NodeParagraph","Properties":{"id":"20240612095051-i65n3ln","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612095051-qd52y9d","Type":"NodeParagraph","Properties":{"id":"20240612095051-qd52y9d","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，微寒。\""}]},{"ID":"20240612095051-nqkw5sq","Type":"NodeParagraph","Properties":{"id":"20240612095051-nqkw5sq","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"大寒，无毒。\""}]},{"ID":"20240612095051-pp427ov","Type":"NodeParagraph","Properties":{"id":"20240612095051-pp427ov","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"平。\""}]},{"ID":"20240612095051-i16rti4","Type":"NodeParagraph","Properties":{"id":"20240612095051-i16rti4","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"气寒，味苦，性涩。\""}]},{"ID":"20240612095051-szf53bj","Type":"NodeParagraph","Properties":{"id":"20240612095051-szf53bj","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612095051-vt0bs9e","Type":"NodeParagraph","Properties":{"id":"20240612095051-vt0bs9e","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒者忌服。"}]},{"ID":"20240612095051-81ogfxp","Type":"NodeParagraph","Properties":{"id":"20240612095051-81ogfxp","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"大戟为之使。恶茱萸。\""}]},{"ID":"20240612095051-dybtcry","Type":"NodeParagraph","Properties":{"id":"20240612095051-dybtcry","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"恶苦瓠、防葵。\""}]},{"ID":"20240612095051-co8lliu","Type":"NodeParagraph","Properties":{"id":"20240612095051-co8lliu","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"胃虚少食者禁用。\""}]},{"ID":"20240612095051-bdzzbbz","Type":"NodeParagraph","Properties":{"id":"20240612095051-bdzzbbz","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612095051-uqkrj0l","Type":"NodeParagraph","Properties":{"id":"20240612095051-uqkrj0l","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，平喘止咳，明目。治细菌性痢疾，肠炎，白带，慢性气管炎，目赤肿痛，迎风流泪，牛皮癣。"}]},{"ID":"20240612095051-zjj8r4m","Type":"NodeParagraph","Properties":{"id":"20240612095051-zjj8r4m","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主风寒湿痹，洗洗寒气，除热，目中青翳白膜。\""}]},{"ID":"20240612095051-dqf2tif","Type":"NodeParagraph","Properties":{"id":"20240612095051-dqf2tif","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗男子少精，妇人带下，小儿痫，身热，可作洗目汤。\""}]},{"ID":"20240612095051-kfews3w","Type":"NodeParagraph","Properties":{"id":"20240612095051-kfews3w","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主明目，去肝中久热，两目赤肿疼痛，风泪不止；治小儿身热：作汤浴。\""}]},{"ID":"20240612095051-ruscuti","Type":"NodeParagraph","Properties":{"id":"20240612095051-ruscuti","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"洗肝，益精，明目，小儿热惊，皮肤风痹，退热。\""}]},{"ID":"20240612095051-ui61w6s","Type":"NodeParagraph","Properties":{"id":"20240612095051-ui61w6s","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑤张元素：\"治女子崩中。\""}]},{"ID":"20240612095051-d0023cv","Type":"NodeParagraph","Properties":{"id":"20240612095051-d0023cv","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑥《汤液本草》：\"主热痢下重，下焦虚。\""}]},{"ID":"20240612095051-jt5dgve","Type":"NodeParagraph","Properties":{"id":"20240612095051-jt5dgve","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑦《吉林中草药》：\"治肠风下血。\""}]},{"ID":"20240612095051-kfndp7o","Type":"NodeParagraph","Properties":{"id":"20240612095051-kfndp7o","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑧《黑龙江常用中草药手册》：\"治肠炎腹泻。\""}]},{"ID":"20240612095051-vxa0d3e","Type":"NodeParagraph","Properties":{"id":"20240612095051-vxa0d3e","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑨《陕西中草药》：\"治麦粒肿。\""}]},{"ID":"20240612095051-smlf4n7","Type":"NodeParagraph","Properties":{"id":"20240612095051-smlf4n7","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612095051-7ewp9uo","Type":"NodeParagraph","Properties":{"id":"20240612095051-7ewp9uo","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸剂。外用：煎水洗。"}]},{"ID":"20240612095051-mnn4px8","Type":"NodeParagraph","Properties":{"id":"20240612095051-mnn4px8","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612095051-8bdq3vr","Type":"NodeParagraph","Properties":{"id":"20240612095051-8bdq3vr","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" ①治热痢下露者：白头翁二两，黄柏三两，黄连三两，秦皮三两。上四味，以水七升，煮取二升，去滓，温服一升。不愈，更服一升。（《伤寒论》白头翁汤）"}]},{"ID":"20240612095051-vspamgb","Type":"NodeParagraph","Properties":{"id":"20240612095051-vspamgb","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②治慢性细菌性痢疾：秦皮四钱，生地榆、椿皮各三钱。水煎服。（《河北中药手册》）"}]},{"ID":"20240612095051-hgdzx5x","Type":"NodeParagraph","Properties":{"id":"20240612095051-hgdzx5x","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"③治腹泻：秦皮三钱。水煎加糖，分服。（《黑龙江常用中草药手册》）"}]},{"ID":"20240612095051-23rv9wz","Type":"NodeParagraph","Properties":{"id":"20240612095051-23rv9wz","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"④治赤眼及眼睛上疮：秦皮一大两。以清水一大升于白瓷碗中浸，春夏一食久以上，看碧色出，即以箸头缠绵，点下碧汁，仰卧点所患眼中，仍先从大眦中满跟着，微痛不畏，量久三、五度饭间，即侧卧沥却热汁，每日十度以上着，不过两日瘥。忌酢、萝卜（《近效方》）"}]},{"ID":"20240612095051-z8pmi1w","Type":"NodeParagraph","Properties":{"id":"20240612095051-z8pmi1w","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑤治麦粒肿，大便干燥：秦皮三钱，大黄二钱。水煎服。孕妇忌服。（《河北中药手册》）"}]},{"ID":"20240612095051-04bqfkl","Type":"NodeParagraph","Properties":{"id":"20240612095051-04bqfkl","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑥治妇人赤白带下，及血崩不止：秦皮三两，丹皮二两，当归身一两，俱酒洗，炒研为末，炼蜜为丸梧桐子大。每早服五钱，白汤下。（《本草汇言》）"}]},{"ID":"20240612095051-4erbo1k","Type":"NodeParagraph","Properties":{"id":"20240612095051-4erbo1k","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑦治小儿惊痫发热及变蒸发热：秦皮、茯苓各-钱，甘草五分，灯心廿根。水煎服。（《儿科撮要》）"}]},{"ID":"20240612095051-13q6kr7","Type":"NodeParagraph","Properties":{"id":"20240612095051-13q6kr7","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"⑧治牛皮癣：苦榴皮一至二两。加半面盆水煎，煎液洗患处，每天或隔二至三天洗一次。药液温热后仍可用，每次煎水可洗三次。洗至痊愈为止。（《全展选编·皮肤病》）"}]},{"ID":"20240612095051-xlo1w4y","Type":"NodeParagraph","Properties":{"id":"20240612095051-xlo1w4y","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612095051-pb4uprx","Type":"NodeParagraph","Properties":{"id":"20240612095051-pb4uprx","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" ①治疗细菌性痢疾"}]},{"ID":"20240612095051-52cnako","Type":"NodeParagraph","Properties":{"id":"20240612095051-52cnako","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"㈠秦皮煎剂：每40毫升含生药6钱，治疗小儿菌痢共50例。1岁以下每天8～10毫升，1～3岁10毫升，3岁以上15毫升，分4次口服。体温恢复正常时间平均为1.9天；大便次数恢复正常平均为8.1天；21例粪便培养至第3天以后均转为阴性。服药后有5例发生呕吐。㈡秦皮素：各家所用的剂量不一。有人按每日口服50毫克的剂量，制成合剂，不论年龄大小，分4次服。治疗66例（成人30例，小儿36例），有肯定的疗效，但与对照组用合霉素及四环素者相比，效果较差。有人按50～100毫克/公斤/日的剂量，分2～3次服，疗程5～6日，并按病情需要，配合各种对症处理，治疗77例，有效率在71％以上。有人用秦皮乙素按5毫克/公斤/日的剂量治疗67例，痊愈者41例，进步11例，无效15例。"}]},{"ID":"20240612095051-17vo5fm","Type":"NodeParagraph","Properties":{"id":"20240612095051-17vo5fm","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②治疗慢性气管炎"}]},{"ID":"20240612095051-7fphzpt","Type":"NodeParagraph","Properties":{"id":"20240612095051-7fphzpt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"取苦枥白蜡树摊皮制成1：1浓度的喷雾液，用气雾发生器射入气雾室，每次吸入30分钟，每日1次，每次2毫升；或制成浸膏片（每片含浸膏0.3克），每日3次，每次2片内服。均以10天为一疗程。治疗530例，其中气雾组422例，经二个疗程，近控86例（20.3％），显效140例（33.2％）；气雾组另68例，经五个疗程，近控24例，显效23例；口服组50例，经三个疗程，近控3例，显效29例。部分患者的咳、喘、痰三症在服药第1天即见效，气雾组治疗3天内三症见效者占60％左右。对喘息症状与哮鸣音的近期控制尤为明显。"}]},{"ID":"20240612095051-1zmkgj3","Type":"NodeParagraph","Properties":{"id":"20240612095051-1zmkgj3","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612095051-4ldmylv","Type":"NodeParagraph","Properties":{"id":"20240612095051-4ldmylv","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"梣皮，治目病，惊痫，取其平木也，治下痢崩带，取其收涩也。又能治男子少精，取其涩而补也。此药乃惊、痫、崩、痢所宜，而人止知其治目一节，几于废弃，良为可惋。《淮南子》云：梣皮色青，治目之要药也。又《万毕木》云：梣皮止水，谓其能收泪也。高诱解作致水，言能使水沸者，谬也。\""}]},{"ID":"20240612095051-8bjl5yb","Type":"NodeParagraph","Properties":{"id":"20240612095051-8bjl5yb","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"秦皮，味苦性涩而坚，能收敛走散之精气。故仲景用白头翁汤，以此治下焦虚热而利者，取苦以涩之之意也。《别录》方止男子精虚，妇人崩带；甄氏方又治小儿惊痫身热，及肝热目暗，翳目赤肿，风泪不止等疾；皆缘肝胆火郁气散以致疾，以此澄寒清碧下降之物，使浊气分清，散气收敛。故治眼科，退翳膜，收泪出；治妇人科，定五崩，止血带；治大方科，止虚痢，敛遗精；治小儿科，安惊痫，退变蒸发热。\""}]},{"ID":"20240612095051-wt834u0","Type":"NodeParagraph","Properties":{"id":"20240612095051-wt834u0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612095051-1z2i1kt","Type":"NodeParagraph","Properties":{"id":"20240612095051-1z2i1kt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612095051-rr53xir","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612095051-rr53xir","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"《中华本草》：秦皮"}]},{"ID":"20240612095051-jz2j0ba","Type":"NodeParagraph","Properties":{"id":"20240612095051-jz2j0ba","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612095051-0godf3z","Type":"NodeParagraph","Properties":{"id":"20240612095051-0godf3z","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" Qín Pí"}]},{"ID":"20240612095051-kaste7h","Type":"NodeParagraph","Properties":{"id":"20240612095051-kaste7h","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612095051-h3t66hz","Type":"NodeParagraph","Properties":{"id":"20240612095051-h3t66hz","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 岑皮、（木岑）皮、樊槻皮、秦白皮、（木寻）木皮、蜡树皮"}]},{"ID":"20240612095051-s6uq1eu","Type":"NodeParagraph","Properties":{"id":"20240612095051-s6uq1eu","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612095051-rrgv4ps","Type":"NodeParagraph","Properties":{"id":"20240612095051-rrgv4ps","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612095051-y1eage6","Type":"NodeParagraph","Properties":{"id":"20240612095051-y1eage6","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"1.陶弘景，秦皮，俗云是樊槻皮，而水渍以和墨书，色不脱，微青。且亦殊薄，恐不必耳。俗方惟以疗目。"}]},{"ID":"20240612095051-f6ackwb","Type":"NodeParagraph","Properties":{"id":"20240612095051-f6ackwb","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：秦皮，树似檀；叶细，皮有白点而不粗错。取皮水渍，便碧色，书纸看背，青色者是。俗见味苦，名为苦树。亦用皮，疗眼有效。以叶似檀，故名石檀也。"}]},{"ID":"20240612095051-vya6q9z","Type":"NodeParagraph","Properties":{"id":"20240612095051-vya6q9z","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：秦皮，其木小而岑高，故因以为名。人讹为桪木，又讹为秦木。或云本出秦地，故得秦名也。"}]},{"ID":"20240612095051-q5puigt","Type":"NodeParagraph","Properties":{"id":"20240612095051-q5puigt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612095051-rocdlcu","Type":"NodeParagraph","Properties":{"id":"20240612095051-rocdlcu","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 药材基源：为木犀科植物大叶梣、尖叶梣、白蜡树和宿柱梣的树皮。"}]},{"ID":"20240612095051-3ygmm6f","Type":"NodeParagraph","Properties":{"id":"20240612095051-3ygmm6f","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Fraxinus rhynchophylla Hance［F．Chinensis Roxb.var.rhynchopylla(Hance)Hemsl.]2．Fraxinus szaboana Lingelsh.［F．ChinensisRoxb.var.acuminata Lingelsh.;F.caudata J.L.Wu;F.Rhynchophylla Hance var.huashanensis J.L.Wuet Z．W．Xie］3．Fraxinus chinensis Roxb.［F．Chinensis Roxb．Var·rotundata Lingelsh.］4．Fraxinus stuylosa Lingelsh.[F．Jallax Lingelsh.]"}]},{"ID":"20240612095051-c619ilg","Type":"NodeParagraph","Properties":{"id":"20240612095051-c619ilg","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后5～8年，树干直径达15cm以上时，于春秋两季剥取树皮，切成30～60cm长的短节，晒干。"}]},{"ID":"20240612095051-hesr8jn","Type":"NodeParagraph","Properties":{"id":"20240612095051-hesr8jn","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612095051-e57x8bp","Type":"NodeParagraph","Properties":{"id":"20240612095051-e57x8bp","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡、河岸、路旁。"}]},{"ID":"20240612095051-lz4b201","Type":"NodeParagraph","Properties":{"id":"20240612095051-lz4b201","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.生于山地杂木林中。"}]},{"ID":"20240612095051-o2t00zt","Type":"NodeParagraph","Properties":{"id":"20240612095051-o2t00zt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"3.分布于中国南北各地。"}]},{"ID":"20240612095051-s5lrspo","Type":"NodeParagraph","Properties":{"id":"20240612095051-s5lrspo","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"4.生于海拔1300-3200m的山坡杂木林中。"}]},{"ID":"20240612095051-7zf8h1z","Type":"NodeParagraph","Properties":{"id":"20240612095051-7zf8h1z","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华北及黄河流域、长江流域、浙江、福建、广东、广西、贵州、云南等地。"}]},{"ID":"20240612095051-c9tt3z8","Type":"NodeParagraph","Properties":{"id":"20240612095051-c9tt3z8","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.分布于中国南方各地。"}]},{"ID":"20240612095051-r5u5tm4","Type":"NodeParagraph","Properties":{"id":"20240612095051-r5u5tm4","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"3.多为栽培，也见于海拔800～1600m的山地杂木林中。"}]},{"ID":"20240612095051-vcpqbn9","Type":"NodeParagraph","Properties":{"id":"20240612095051-vcpqbn9","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"4.分布于陕西、甘肃、河南、四川。"}]},{"ID":"20240612095051-lwi32bt","Type":"NodeParagraph","Properties":{"id":"20240612095051-lwi32bt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612095051-0hmy7i8","Type":"NodeParagraph","Properties":{"id":"20240612095051-0hmy7i8","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 1.落叶大乔木，高12-15m。树皮灰褐色，光滑，老时浅裂。冬芽阔卵形.先端尖，黑褐色.具光泽，内侧密被棕色曲柔毛。当年生枝淡黄色，通直，无毛，去年生枝暗褐色，皮孔散生。叶轴上面具浅沟，小叶着生处具关节，节上有时。簇生棕色曲柔毛；小叶5-7枚，革质，阔卵形、倒卵形或卵状披针形，长3-11cm，宽2-6cm，营养枝的小叶较宽大，顶生小叶显着大于侧生小叶，下方1对最小，先端渐尖、骤尖或尾尖，基部钝圆，叶绿呈不规则粗锯齿，齿尖稍向内弯，有时也呈波状，通常下部近全缘，沿脉腋被白色柔毛，渐秃净。圆锥花序顶生或腋生于当年生枝梢，长约10cm；苞片长披针形，长约5mm，早落；花梗长约5mm；雄花与两性花异株；花萼浅杯状，长约1mm，萼片三角形无毛；无花冠；两性花具雄蕊2，长约4mm；雌蕊具短花柱，柱头2叉深裂；雄花花萼小，花丝细，长达3mm；翅果线形，先端坚果长约1cm，略隆起；具宿存萼。花期4-5月，果期9-10月。"}]},{"ID":"20240612095051-5gfziwc","Type":"NodeParagraph","Properties":{"id":"20240612095051-5gfziwc","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.本种与大叶梣的不同点在干：小枝、叶轴和小叶下面被毛。小叶3-5（-7）片，小叶先端长渐尖至尾尖，下面常在中脉基部被白色柔毛。花无花冠，与叶同时开放；花萼杯状，与坚果基部疏离。"}]},{"ID":"20240612095051-h3vij6z","Type":"NodeParagraph","Properties":{"id":"20240612095051-h3vij6z","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"3.与前两种不同点在于：小叶卵形、倒卵状长圆形至披针形，先端锐尖至渐尖；花萼筒状，紧贴坚果基部。"}]},{"ID":"20240612095051-ys7np3d","Type":"NodeParagraph","Properties":{"id":"20240612095051-ys7np3d","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"4.本种与前3种不同点在于：小叶无柄或近于无柄，叶片卵状披针形至阔披针形，叶轴细而直；花具花冠，先叶后花；萼齿明显。"}]},{"ID":"20240612095051-qyl8iai","Type":"NodeParagraph","Properties":{"id":"20240612095051-qyl8iai","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612095051-fr18giv","Type":"NodeParagraph","Properties":{"id":"20240612095051-fr18giv","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候。喜光。对土壤要求不严，黄壤、黄棕壤等土壤上均能生长。"}]},{"ID":"20240612095051-g23fwkf","Type":"NodeParagraph","Properties":{"id":"20240612095051-g23fwkf","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子及扦插繁殖。种子繁殖：3月份播种前将种子用温水浸泡24h，或混拌湿沙在室内催芽，待种子萌动后，可条播于苗床内，每1hm2需种45kg。苗床管理注意适量浇水、中耕、除草、施肥。一般每1hm2产苗30万～45万株，当年苗高可达30～40cm。扦插繁殖：在春季萌芽前选择健壮无病虫害的枝条，截成16～20cm 小段，在苗床上按行距30cm开沟，深12－15cm，每隔6～10cm扦插1根，插条的顶芽露出床面，压实土壤。插后经常淋水，保持土壤湿润，并及时抹去下部的幼芽，保证顶芽正常生长，一年生苗高可达40～50cn。苗高80～100cm。左右，即可移栽造林。"}]},{"ID":"20240612095051-6vb93ma","Type":"NodeParagraph","Properties":{"id":"20240612095051-6vb93ma","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有煤烟病，防治需注意通风、透光。虫害有蚜虫、介壳虫等，可用石硫合剂喷杀。糖槭介， 6～7月用50%杀螟松稀释1000倍液喷洒。"}]},{"ID":"20240612095051-ksbjspx","Type":"NodeParagraph","Properties":{"id":"20240612095051-ksbjspx","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612095051-rsrqgop","Type":"NodeParagraph","Properties":{"id":"20240612095051-rsrqgop","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 枝皮呈卷筒状或槽状，长10-60cm，厚1．5-3mm。外表面灰白色、灰棕色至黑棕色或相间呈斑状，平坦或稍粗糙，并有灰白色圆点状皮孔及细斜皱纹，有的具分枝痕；内表面黄白色或棕色，平滑。质硬而脆，断面纤维性，黄白色。无臭，味苦。干皮为长条状块片，厚3-6mm。外表面灰棕色，有红棕色圆形或横长的皮孔及龟裂状沟纹。质坚硬，断面纤维性较强。"}]},{"ID":"20240612095051-8wd3zdm","Type":"NodeParagraph","Properties":{"id":"20240612095051-8wd3zdm","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"显微鉴别 大叶梣树皮横切面：木栓层为5-10余列细胞。栓内层为数列多角形厚角细胞。皮层较宽，纤维或石细胞单个散在或成群。中柱鞘部位有石细胞及纤维束组成的环带。韧皮射线宽1-3列细胞；韧皮纤维束成层排列，每层2-10列纤维，纤维壁极厚，胞腔点状，纤维层中有时伴有石细胞。本品薄壁细胞含多数淀粉粒和草酸钙砂晶。"}]},{"ID":"20240612095051-r1ywlgx","Type":"NodeParagraph","Properties":{"id":"20240612095051-r1ywlgx","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取药材少许，加热水浸泡，浸出液在日光下可见碧蓝色荧光。（检查马栗树皮甙和马栗树在素）（2）取粉末1g，加95％乙醇10ml，回流10min，滤过，取醇溶液2滴入试管中，加水10ml稀释，在反射光下显天蓝色荧光（检查马栗树皮甙）。另取醇溶液1ml，加1％三氯化铁试液2-3滴，呈暗绿色，再加氨试液3滴，以5倍水稀释，对光观察显深红色。（检查马栗树皮素）（3）薄层色谱 取粉末1g，加乙醇10ml，加热回流10min，放冷，滤过，滤液作为供试品溶液。另取马栗树皮甙和马栗树皮素，加乙醇制成每1ml各含5mg的混合溶液，作为对照品溶液。吸取上述两种溶液各3μl，分别点于同一硅胶G薄层板上，以甲苯-醋酸乙酯-甲酸-乙醇（3：4 :1：2）为展开剂，展开，取出，晾干，在紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240612095051-gk662r0","Type":"NodeParagraph","Properties":{"id":"20240612095051-gk662r0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612095051-zm4o47p","Type":"NodeParagraph","Properties":{"id":"20240612095051-zm4o47p","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 马栗树皮甙3g/kg或马栗树皮素 lg/kg腹腔注射于小鼠，皆不致死，故毒性很低；但也有报告马栗树皮素皮下注射250mg/kg即可致死的。日本秦皮提取物给兔灌胃每天3g/kg，连续45周仅引起轻度的组织病变，如胃肠粘膜呈现分泌亢进、肠神经丛的膨大及肾小球、肾小管的退行性病变；长期注射给药，肝功能及末梢血象皆无显着变化。七叶亭小鼠腹腔注射 3g/kg 时无死亡，皮下注射250mg/kg可使小鼠死亡。莨菪亭对小鼠半数致死量(g/kg)：口服为1.39，腹腔注射0.85。"}]},{"ID":"20240612095051-kg9k2vk","Type":"NodeParagraph","Properties":{"id":"20240612095051-kg9k2vk","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612095051-h35zl10","Type":"NodeParagraph","Properties":{"id":"20240612095051-h35zl10","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 1．大叶梣的树皮含马栗树皮甙（aesculin），马栗树皮素（aesculetin）[1]。预试还含生物碱[2]。"}]},{"ID":"20240612095051-pa44jao","Type":"NodeParagraph","Properties":{"id":"20240612095051-pa44jao","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2．尖叶梣的树皮含马栗树皮素，马栗树皮甙，秦皮甙（frax-in），东莨菪素（sopoletin），2，6-二甲氧基对苯酿（2，6-dimethoxy-p-benzoquinone）和微量的N-苯基-2-萘腔（N-phenyl-2-naphthy－lamine）[3].3．白蜡树的树皮合马栗树皮素，秦皮素（fraxetin）[4]。"}]},{"ID":"20240612095051-ml6q03r","Type":"NodeParagraph","Properties":{"id":"20240612095051-ml6q03r","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"4．宿柱梣的树皮含马栗树皮素，马栗树皮甙，秦皮甙，丁香甙（syringin），宿柱白蜡甙（stylosin）[5]。"}]},{"ID":"20240612095051-bppnuov","Type":"NodeParagraph","Properties":{"id":"20240612095051-bppnuov","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612095051-104ls59","Type":"NodeParagraph","Properties":{"id":"20240612095051-104ls59","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 1.消炎、镇痛作用 大鼠腹腔注射马栗树皮甙10mg/kg，对角义菜胶性、右旋糖酐性、5-羟色胺性及组织胺性关节炎有抑制作用，抑制的强度分别为35，28，20，8%。也有报告，马栗树皮甙对甲醛性关节炎亦有抑制作用，但弱于对角义菜胶性者，而对右旋糖酐性关节炎的抑制不明显。马栗树皮素在大剂量时对角义菜胶性关节炎亦有抑制作用。马栗树皮甙能抑制大鼠的肉芽肿形成(棉球法)，对豚鼠紫外线照射背部引起的红斑反应，也有抑制作用，马栗树皮素之作用较马栗树皮甙更显着，两者都有显着抑制组织胺引起的毛细血管通透性的作用(对 Bradykinin引起的，不起作用)，马栗树皮甙还有微弱的镇痛作用(小鼠热板法)，如以吗啡皮下注射5mg/kg的效力作为100%，则马栗树皮甙口服10mg/kg之效价为 l4.8%。"}]},{"ID":"20240612095051-djp2vnq","Type":"NodeParagraph","Properties":{"id":"20240612095051-djp2vnq","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.对尿量及尿酸排泄的影响 早年报告秦皮甙有利尿作用，能促进家兔及风湿病患者尿酸的排泄。马栗树皮甙在大鼠及兔的试验中，各种给药途径均可增进尿酸的排泄。在家兔静脉注射马栗树皮甙后，最初半小时内尿量增加，此后血中尿酸浓度即见上升，半小时后尿量即逐渐减少，而尿中尿酸的排泄却不断增加。尿量之增加，仅指给药后短期而言(可能系肾小管重吸收减少所致)，给药3-4小时后，尿量仅为给药前的1/2。尿酸排泄增进之作用原理，据分析，系兴奋了交感神经系统；而且马栗树皮甙对肾脏也有直接作用，即抑制了对尿酸的重吸收所致。血中尿酸浓度之增高为肝中尿酸生成增加的结果。也有报告，马栗树皮甙对正常大鼠并无利尿作用，而对小鼠却有较显着的利尿作用。"}]},{"ID":"20240612095051-2497ylc","Type":"NodeParagraph","Properties":{"id":"20240612095051-2497ylc","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"3.其他作用 马栗树皮甙对其他器官的作用一般皆不显着。对兔的血压、呼吸、肠管皆无作用。对豚鼠离体小肠、子宫、膀胱、胆囊及离体蛙心以及对兔在位子宫、兔耳血管、蟾蜍下肢血管亦无作用；亦不影响兔颈动脉、股动脉的血流量。马栗树皮素对兔有轻度升压作用，还能抑制离体蟾蜍心脏及离体兔肠，轻度收缩蟾蜍下肢血管，离体蟾蜍腓肠肌之兴奋性亦略有降低。秦皮煎剂还有某些抗菌、治疗慢性气管炎的作用。马栗树皮甙的化学结构与双香豆素相似，故有某些抗血凝作用，其4%溶液能吸收紫外线，故能保护皮肤，免受日光照射之损伤。"}]},{"ID":"20240612095051-9t2pzsn","Type":"NodeParagraph","Properties":{"id":"20240612095051-9t2pzsn","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612095051-psma0rr","Type":"NodeParagraph","Properties":{"id":"20240612095051-psma0rr","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，洗净，润透后切块或切段，晒干。"}]},{"ID":"20240612095051-q670chr","Type":"NodeParagraph","Properties":{"id":"20240612095051-q670chr","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612095051-22p3tfi","Type":"NodeParagraph","Properties":{"id":"20240612095051-22p3tfi","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 肝、胆、大肠经"}]},{"ID":"20240612095051-djlfvxe","Type":"NodeParagraph","Properties":{"id":"20240612095051-djlfvxe","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612095051-uze27ln","Type":"NodeParagraph","Properties":{"id":"20240612095051-uze27ln","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 苦；涩；性寒"}]},{"ID":"20240612095051-7dmwyo5","Type":"NodeParagraph","Properties":{"id":"20240612095051-7dmwyo5","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612095051-zxaoc12","Type":"NodeParagraph","Properties":{"id":"20240612095051-zxaoc12","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒者忌服。《本经逢原》：胃虚少食者禁用。"}]},{"ID":"20240612095051-tgzmstt","Type":"NodeParagraph","Properties":{"id":"20240612095051-tgzmstt","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612095051-romts1x","Type":"NodeParagraph","Properties":{"id":"20240612095051-romts1x","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 清热燥湿；清肝明目；止咳平喘。主湿热泻痢；带下，目赤肿痛；睛生疮翳；肺热气喘咳嗽"}]},{"ID":"20240612095051-zziqr43","Type":"NodeParagraph","Properties":{"id":"20240612095051-zziqr43","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612095051-iji2595","Type":"NodeParagraph","Properties":{"id":"20240612095051-iji2595","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-12g。外用：适量，煎水洗眼或取汁点眼。"}]},{"ID":"20240612095051-d7zg3bk","Type":"NodeParagraph","Properties":{"id":"20240612095051-d7zg3bk","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612095051-wcs36g8","Type":"NodeParagraph","Properties":{"id":"20240612095051-wcs36g8","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" ①治热痢下重者：白头翁二两，黄柏三两，黄连三两，秦皮三两。上四味，以水七升，煮取二开，去滓，温服一升。不愈，更服一升。(《伤寒论》白头翁汤)②治慢性细菌性痢疾：秦皮四钱，生地榆、椿皮各三钱。水煎服。(《河北中药手册》)、③治腹泻：秦皮三钱。水煎加糖，分服。(《黑龙江常用中草药手册》)④治赤眼及眼睛上疮：秦皮一大两。以清水一大升于白瓷碗中浸，春夏一食久以上，看碧色出，即以箸头缠绵、点下碧汁，仰卧点所患眼中，仍先从大眦中满眼着，微痛不畏，量久三、五度饭间，即侧卧沥却热汁，每日十度以上着，不过两日瘥。忌酢、萝卜。(《近效方》)⑤治麦粒肿，大便干燥：秦皮三钱，大黄二钱。水煎服。孕妇忌服。(《河北中药手册》)⑥治妇人赤白带下，及血崩不止：秦皮三两，丹皮二两，当归身一两。俱酒洗，炒研为未，炼蜜为丸梧桐子大。每早服五钱，白汤下。(《本草汇言》)⑦治小儿惊癎发热及变蒸发热：秦皮、茯苓各一钱，甘草五分，灯心廿根。水煎服。(《儿科撮要》)⑧治牛皮癣：苦榴皮一至二两。加半面盆水煎，煎液洗患处，每天或隔二至三天洗一次。药液温热后仍可用，每次煎水可洗三次。洗至痊愈为止。(《全展选编·皮肤病》)"}]},{"ID":"20240612095051-p7u41ms","Type":"NodeParagraph","Properties":{"id":"20240612095051-p7u41ms","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612095051-s4bm9rz","Type":"NodeParagraph","Properties":{"id":"20240612095051-s4bm9rz","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 1.治疗细菌性痢疾：1.1.秦皮煎剂：每40ml含生药6钱，治疗小儿菌痢共50例。 1岁以下每天8-10ml， 1-3岁10ml，3岁以上15ml，分4次口服。体温恢复正常时间平均为1.9天；大便次数恢复正常平均为8.1天；21例粪便培养至第3天以后均转为阴性。服药后有5例发生呕吐。"}]},{"ID":"20240612095051-b5cm3kc","Type":"NodeParagraph","Properties":{"id":"20240612095051-b5cm3kc","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"1.2.秦皮素：各家所用的剂量不一。有人按每日口服50mg的剂量，制成合剂，不论年龄大小，分4次服。治疗66例(成人30例，小儿36例)，有肯定的疗效，但与对照组用合霉素及四环素者相比，效果较差。有人按50-100mg/kg/日的剂量，分2-3次服，疗程5-6日，并按病情需要，配合各种对症处理，治疗77例，有效率在71%以上。有人用秦皮乙素按5mg/kg/日的剂量治疗67例，痊愈者41例，进步 11例，无效15例。"}]},{"ID":"20240612095051-bl90r9e","Type":"NodeParagraph","Properties":{"id":"20240612095051-bl90r9e","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.治疗慢性气管炎：取苦枥白蜡树树皮制成 1∶1浓度的喷雾液，用气雾发生器射入气雾室，每次吸入30分钟，每日1次，每次2ml；或制成浸膏片(每片含浸膏0.3g)，每日3次，每次2片内服。均以10天为一疗程。治疗530例，其中气雾组422例，经二个疗程，近控86例(20.3%)，显效140例(33.2%)；气雾组另58例，经五个疗程，近控24例，显效23例；口服组50例，经三个疗程，近控3例，显效29例，部分患者的咳、喘、痰三症在服药第1天即见效，气雾组治疗3天内三症见效者占60%左右。对喘息症状与哮鸣音的近期控制尤为明显。"}]},{"ID":"20240612095051-j0awwh0","Type":"NodeParagraph","Properties":{"id":"20240612095051-j0awwh0","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612095051-xtyr4ps","Type":"NodeParagraph","Properties":{"id":"20240612095051-xtyr4ps","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：秦皮，治目病，惊癎，取其平木也，治下痢崩带，取其收涩也。又能治男子少精，取其涩而补也。此药乃惊、癎、崩、痢所宜，而人止知其治目一节，几于废弃，良为可惋。《淮南子》云： 秦皮色青，治目之要药也。又《万毕术》云：秦皮止水，谓其能收泪也。高诱解作致水，言能使水沸者，谬也。"}]},{"ID":"20240612095051-pe21n0y","Type":"NodeParagraph","Properties":{"id":"20240612095051-pe21n0y","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：秦皮，味苦性涩而坚，能收敛走散之精气。故仲景用白头翁汤，以此治下焦虚热而利者，取苦以涩之之意也。《别录》方止男子精虚，妇人崩带；甄氏方又治小儿惊癎身热，及肝热目暗，翳目赤肿，风泪不止等疾；皆缘肝胆火郁气散以致疾，以此澄寒清碧下降之物，使浊气分清，散气收敛。故治眼科，退翳膜，收泪出；治妇人科，定五崩，止血带；治大方科，止虚痢，敛遗精；治小儿科，安惊癎，退变蒸发热。"}]},{"ID":"20240612095051-du18xmb","Type":"NodeParagraph","Properties":{"id":"20240612095051-du18xmb","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612095051-9lwvfwx","Type":"NodeParagraph","Properties":{"id":"20240612095051-9lwvfwx","updated":"20240612095051"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612095053-dee8umz","Type":"NodeThematicBreak","Properties":{"id":"20240612095053-dee8umz"}},{"ID":"20240612095054-m3fx2q2","Type":"NodeParagraph","Properties":{"id":"20240612095054-m3fx2q2"}}]}