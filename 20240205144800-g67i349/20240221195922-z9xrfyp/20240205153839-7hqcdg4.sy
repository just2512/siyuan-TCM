Paren"},{"Type":"NodeLinkDest","Data":"assets/牡丹 6-20240820154644-maln4bm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 643px;\" parent-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牡丹 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牡丹 3-20240820154450-p3si64q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820155808-moorhbl","Type":"NodeParagraph","Properties":{"id":"20240820155808-moorhbl","updated":"20240820155851"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 696px;","style":"width: 686px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牡丹 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牡丹 14-20240820155807-4qv5wkl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 686px;\" parent-style=\"width: 696px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 527px;","style":"width: 517px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牡丹 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牡丹 15-20240820155850-8uzcgn9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 517px;\" parent-style=\"width: 527px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820154529-pxg5qon","Type":"NodeParagraph","Properties":{"id":"20240820154529-pxg5qon","updated":"20240820154529"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 681px;","style":"width: 671px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牡丹 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牡丹 4-20240820154529-rqc95rb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 671px;\" parent-style=\"width: 681px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牡丹 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牡丹 1-20240820154301-ndrgg4n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240820154005-ul4tim6","Type":"NodeParagraph","Properties":{"id":"20240820154005-ul4tim6","updated":"20240820154005"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牡丹"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牡丹-20240820154005-6ea1fq2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611172359-4238t37","Type":"NodeThematicBreak","Properties":{"id":"20240611172359-4238t37"}},{"ID":"20240611172414-wj2pwap","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172414-wj2pwap","updated":"20240611172419"},"Children":[{"Type":"NodeText","Data":"牡丹《神农本草经》"}]},{"ID":"20240611172414-17j2xcq","Type":"NodeParagraph","Properties":{"id":"20240611172414-17j2xcq","updated":"20240611172414"},"Children":[{"Type":"NodeText","Data":"味苦辛寒。"}]},{"ID":"20240611172414-d2mp7cq","Type":"NodeParagraph","Properties":{"id":"20240611172414-d2mp7cq","updated":"20240611172414"},"Children":[{"Type":"NodeText","Data":"主寒热，中风，瘈疭，痉，惊痫，邪气，除症坚，淤血留舍肠胃，安五脏，疗痈创。一名鹿韭，一名鼠姑。生山谷。"}]},{"ID":"20240611172414-t9dxmhw","Type":"NodeParagraph","Properties":{"id":"20240611172414-t9dxmhw","updated":"20240611172414"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：牡丹，神农岐伯辛，李氏小寒，雷公桐君苦无毒，黄帝苦有毒，叶如蓬相植，根如柏，黑中有核，二月采，八月采，日干，人食之，轻身益寿。（《御览》）"}]},{"ID":"20240611172414-77nxast","Type":"NodeParagraph","Properties":{"id":"20240611172414-77nxast","updated":"20240611172414"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生巴郡及汉中，二月八月，采根阴干。"}]},{"ID":"20240611172414-ulv09wr","Type":"NodeParagraph","Properties":{"id":"20240611172414-ulv09wr","updated":"20240611172414"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：白术，牡丹也。《范子计然》云：牡丹出汉中河内，赤色者亦善。"}]},{"ID":"20240611172808-exmwtr7","Type":"NodeThematicBreak","Properties":{"id":"20240611172808-exmwtr7"}},{"ID":"20240611172809-zfgmq2q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172809-zfgmq2q","updated":"20240611172815"},"Children":[{"Type":"NodeText","Data":"牡丹皮《医学入门》"}]},{"ID":"20240611172809-vewm05x","Type":"NodeParagraph","Properties":{"id":"20240611172809-vewm05x","updated":"20240611172809"},"Children":[{"Type":"NodeText","Data":"牡丹皮寒泻火伏，养真血气破结蓄，专主无汗之骨蒸，又补神志之不足。"}]},{"ID":"20240611172809-6tqw468","Type":"NodeParagraph","Properties":{"id":"20240611172809-6tqw468","updated":"20240611172809"},"Children":[{"Type":"NodeText","Data":"牡丹乃天地之精，群花之首。叶为阳发生，花为阴成实，丹为赤即火，故能泻阴中之火。味辛苦，无毒。"}]},{"ID":"20240611172809-andhz41","Type":"NodeParagraph","Properties":{"id":"20240611172809-andhz41","updated":"20240611172809"},"Children":[{"Type":"NodeText","Data":"阴中微阳。入足少阴、手厥阴经。主吐血衄血瘀血，热留肠胃不散。消打扑瘀血，续筋骨，女子经脉不通，血沥腰疼，破坚 ，下胎下胞，产后一切冷热血气。疗疮痈排脓止痛及下部生疮成洞，皆养真血而破瘀血蓄血之功也。又治冷气，散诸痛结及中风螈 ，痉、惊痫、邪气，除时气头痛客热，五劳劳气，头腰痛，风禁癫疾，皆固真气而行结气郁气之力也。易老云∶治神志不足。神属心，志属肾，故八味丸用之以补心肾也。又曰∶牡丹皮入足少阴及手厥阴，治无汗之骨蒸；地骨皮入足少阴及手少阳，治有汗之骨蒸。有二种，白者补，赤者利。"}]},{"ID":"20240611172809-n4ge18m","Type":"NodeParagraph","Properties":{"id":"20240611172809-n4ge18m","updated":"20240611172809"},"Children":[{"Type":"NodeText","Data":"出合州、和州、宣州山中，单叶红花者佳。二八月采根如笔管大者，以铜刀劈去骨，阴干，酒拌蒸三时，日干用。畏菟丝子，忌蒜。今人家移枝接者，名千叶牡丹，不用。"}]},{"ID":"20240611172832-fvgs3we","Type":"NodeThematicBreak","Properties":{"id":"20240611172832-fvgs3we"}},{"ID":"20240611172834-z0dwog1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172834-z0dwog1","updated":"20240611172837"},"Children":[{"Type":"NodeText","Data":"牡丹皮《长沙药解》"}]},{"ID":"20240611172834-hgpjqks","Type":"NodeParagraph","Properties":{"id":"20240611172834-hgpjqks","updated":"20240611172834"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】牡丹。味苦辛寒。主寒热，中风，瘈疭，痉，惊痫，邪气，除癥坚，淤血留舍肠胃，安五脏，疗痈创。一名鹿韭，一名鼠姑。生山谷。"}]},{"ID":"20240611172834-9pqje9w","Type":"NodeParagraph","Properties":{"id":"20240611172834-9pqje9w","updated":"20240611172834"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微寒，入足厥阴肝经。达木郁而清风，行瘀血而泻热，排痈疽之脓血，化脏腑之癥瘕。"}]},{"ID":"20240611172834-psh3b6q","Type":"NodeParagraph","Properties":{"id":"20240611172834-psh3b6q","updated":"20240611172834"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾气丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在地黄。"},{"Type":"NodeText","Data":"用之治消渴，小便反多。以肝木藏血而性疏泄，木郁血凝，不能疏泄水道，风生而燥盛，故上为消渴而下为淋涩。及其积郁怒发，一泄而不藏，则膀胱失约而小便不禁。丹皮行血清风，调通塞之宜也。"}]},{"ID":"20240611172834-j7uq40h","Type":"NodeParagraph","Properties":{"id":"20240611172834-j7uq40h","updated":"20240611172834"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳖甲煎丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在鳖甲。"},{"Type":"NodeText","Data":"用之治久疟而为癥瘕。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝茯苓丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在桂枝。"},{"Type":"NodeText","Data":"用之治妊娠宿有癥瘕。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"温经汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在茱萸。"},{"Type":"NodeText","Data":"用之治带下，瘀血在腹。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄牡丹皮汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治肠痈脓成，其脉洪数，以其消癥瘀而排脓血也。"}]},{"ID":"20240611172834-86zurw2","Type":"NodeParagraph","Properties":{"id":"20240611172834-86zurw2","updated":"20240611172834"},"Children":[{"Type":"NodeText","Data":"牡丹皮辛凉疏利，善化凝血而破宿癥，泻郁热而清风燥。缘血统于肝，肝木遏陷，血脉不行，以致瘀涩而生风热。血行瘀散，则木达风清，肝热自退也。其诸主治，通经脉，下胞胎，清血热，凉骨蒸，止吐衄，断淋沥，安扑损，续折伤，除癞风，消偏坠。"}]},{"ID":"20240611172938-jiz5rud","Type":"NodeThematicBreak","Properties":{"id":"20240611172938-jiz5rud"}},{"ID":"20240611172939-goqoevz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172939-goqoevz","updated":"20240611172946"},"Children":[{"Type":"NodeText","Data":"牡丹皮《本草新编》"}]},{"ID":"20240611172939-opb04m7","Type":"NodeParagraph","Properties":{"id":"20240611172939-opb04m7","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"牡丹皮，味辛、苦，气微寒，阴中微阳，无毒。种分赤、白，性味却同。入肾、肝二经，兼入心包络。凉骨蒸之热，止吐血、衄血、呕血、咯血，兼消瘀血，除症坚，定神志，更善调经，止惊搐，疗痈肿，排脓住痛。亦臣、佐、使之药，而不可为君也。仲景张夫子入之八味丸中，所以治汉武帝消渴之症也。消渴，本是热症，方中加入桂、附，以火治火，奇矣。盖此火乃相火，而非火。相火者，虚火也。实火可泻，虚火必须滋补。阳火可以水折，阴火必须火引。地黄汤中既用熟地、山药以滋阴，不用桂、附以引火，则火不归源，而渴终不可止。但既用桂、附以引火，而火归于下焦，而上焦余热，何能顿清。吾恐命门之火已归于肾宫，心包之火仍炎于心位，热必余焰尚存，而渴仍不止也。故方中又加入牡丹皮，调和于心、肝、肾之际，滋肾而清其肝中之木，使木不助心包之火。而牡丹皮又自能直入于膻中，以凉其热，下火既安，而上火亦静，火宅之中，不成为清凉之境乎。此仲景夫子制方之神，而亦牡丹皮之功，实有如是者也。不特此也，牡丹皮在六味地黄丸中，更有奇议。肾有补无泻，用熟地、山药以补肾，又何必用牡丹皮以滋其骨中之髓耶。若云泻火，则已有泽泻矣；若云健脾，则已用茯苓矣。若云涩精，则已用山萸矣。然则何所取，而又用牡丹皮哉？不知牡丹皮，所以佐五味之不足也。补阴之药过于寒，则阴不能生，而过于热，则阴亦不能生。"}]},{"ID":"20240611172939-79fols6","Type":"NodeParagraph","Properties":{"id":"20240611172939-79fols6","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"六味丸中不寒不热，全赖牡丹皮之力，调和于心、肝、脾、肾之中，使骨中之髓温和，而后精闭于肾内，火泻于膀胱，水湿化于小便，肺气清肃，脾气健旺，而阴愈生矣。"}]},{"ID":"20240611172939-4ghkr1a","Type":"NodeParagraph","Properties":{"id":"20240611172939-4ghkr1a","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"或问地骨皮治有汗之骨蒸，牡丹皮治无汗之骨蒸，此前人之成说，吾子何略而不谈？岂牡丹皮非治无汗之骨蒸耶，铎所亟欲辨者也。夫地骨皮未尝不治无汗之骨蒸，牡丹皮未尝不治有汗之骨蒸也。元素将二药分有汗、无汗，为骨蒸之法，余不知其何所见而分。据其论，牡丹皮牡而不牝，其色丹，象离阳中之火，能泻，似乎牡丹皮乃阳中之阴，亦宜治有汗之骨蒸，而不宜治无汗之骨蒸矣。总之，牡丹皮乃治骨蒸之圣药，原不必分有汗、无汗也。"}]},{"ID":"20240611172939-95ir7e8","Type":"NodeParagraph","Properties":{"id":"20240611172939-95ir7e8","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"或问仲景张公制八味丸，经吾子之阐发奇矣，不知更有异闻乎？曰∶医道何尽，请于前论而再穷其义。夫火有上、下之分。下火非补不能归，其在上之火，非凉不能息。补其在下之火，则火安而上不炎；凉其在上之火，则火静而下亦戢。虽然牡丹皮补肾水，而不补肾火，似乎下火之炎上，不能使其归于下也。然而，牡丹皮虽不能补肾中之火，实能补肾中之水，补水之不足，即能制火之有余。火有所制，自然不敢沸腾，然后用附子、肉桂，引其下伏，则火藏于至阴之肾矣。牡丹皮亦补肾以益心，而不能补肾以克心者也，似乎上火趋下，不能使其静于上也。然牡丹皮虽不能补肾水克心，实能补肾水以益心气之不足。即能制心气之有余，必有所养，自然常能宁定。然后用附子、肉桂导其上通，则暗交于至阴之心矣。此前论所未及者，而阐发其奇又如此矣。"}]},{"ID":"20240611172939-vq17tgt","Type":"NodeParagraph","Properties":{"id":"20240611172939-vq17tgt","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"或又问仲景张公八味丸，已发异论，不识六味丸亦有异论乎？曰∶六味丸中，别有微义也。"}]},{"ID":"20240611172939-m2k1ilm","Type":"NodeParagraph","Properties":{"id":"20240611172939-m2k1ilm","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"牡丹皮用之于六味丸中，岂独凉骨中之髓，以生阴水哉。夫独阴不生，独阳不长。六味丸中，乃纯阴之药也，苟不用阴中微阳之药，入于群阴之内，虽以水济火，似亦为阴虚者之所喜，然而孤阴无阳，仅能制火之有余，不能生水之不足。丹皮虽亦是阴药，入于肾经，但性带微阳，入于六味丸，使阳气通于阴之中，而性亦微寒，但助阴以生水，而不助阳以动火。此仲景夫子立方之本意，铎实有以窥其微而尽发之也。"}]},{"ID":"20240611172939-sshokoy","Type":"NodeParagraph","Properties":{"id":"20240611172939-sshokoy","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"或问牡丹皮阴中微阳，又入于群阴之内，恐阳气更微，虽各药亦有兼于阳者，毕竟阴重而阳微也。不知他药如茯苓、泽泻、山药之类，入于群阴之中，全忘乎其为阳矣。惟牡丹皮虽在阴药之中，而阳之气不绝，子试将六味丸嗅之，牡丹皮之气未尝全消，不可以悟其微阳之独存，不为群阴所夺之明验乎。惟牡丹皮于群阴之中，独全其微，且能使茯苓、泽泻、山茱萸、熟地、山药之阳气不散，以助其生阴之速。故牡丹皮用之于地黄丸中，尤非无意也。"}]},{"ID":"20240611172939-fz6t14b","Type":"NodeParagraph","Properties":{"id":"20240611172939-fz6t14b","updated":"20240611172939"},"Children":[{"Type":"NodeText","Data":"或问牡丹皮能退骨蒸之虚热，是亦地骨皮之流亚也，乃先生誉地骨皮之解骨蒸，而不及牡丹皮，岂别有意欤？夫牡丹皮之解骨蒸，虽同于地骨皮而微有异者，非解有汗与无汗也。牡丹皮之解骨蒸，解骨中之髓热也；地骨皮之解骨蒸，解骨中之血热也。骨中不止髓，髓之外必有血以裹之。骨中之髓热，必耗其骨中之血矣；骨外之血热，必烁其骨中之髓矣。故治骨蒸者，二味必须兼用，不可以有汗用地骨皮、无汗用牡丹皮也。此等论，实前人所未谈，言之必惊世人，然予实闻之吾师，非凿空而论也。髓中有血，斯亦何奇。余尝见人骨折者，骨中流血，与髓俱出，非明验乎。独是地骨皮凉骨中之血，牡丹皮凉骨中之髓，无人证吾言耳。"}]},{"ID":"20240611172822-u4jgzas","Type":"NodeThematicBreak","Properties":{"id":"20240611172822-u4jgzas"}},{"ID":"20240611172823-1bq7dl6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172823-1bq7dl6","updated":"20240611172827"},"Children":[{"Type":"NodeText","Data":"牡丹皮《中药学》"}]},{"ID":"20240611172823-xcs5d4o","Type":"NodeParagraph","Properties":{"id":"20240611172823-xcs5d4o","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【药用】本品为毛茛科植物牡丹的根皮。"}]},{"ID":"20240611172823-zfxcie5","Type":"NodeParagraph","Properties":{"id":"20240611172823-zfxcie5","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，微寒。入心、肝、肾经。"}]},{"ID":"20240611172823-yy440z6","Type":"NodeParagraph","Properties":{"id":"20240611172823-yy440z6","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【功效】清热凉血，活血散瘀。"}]},{"ID":"20240611172823-3idwrt8","Type":"NodeParagraph","Properties":{"id":"20240611172823-3idwrt8","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于温热病、热入营血、高热、舌绛、身发斑疹，血热妄行、吐血、衄血、尿血，以及阴虚发热等症。"}]},{"ID":"20240611172823-lvzkzye","Type":"NodeParagraph","Properties":{"id":"20240611172823-lvzkzye","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"牡丹皮清营血之实热，同时还能治阴虚发热。清血分实热，常与鲜生地、赤芍等同用；疗虚热，常与大生地、知母、青蒿、鳖甲等药相配伍；治血热妄行，常与鲜茅根、侧柏叶、山栀等同用。"}]},{"ID":"20240611172823-pwaoyj5","Type":"NodeParagraph","Properties":{"id":"20240611172823-pwaoyj5","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"2.用于经闭、跌扑损伤，疮痈肿毒、肠痈等症。"}]},{"ID":"20240611172823-cndoh4z","Type":"NodeParagraph","Properties":{"id":"20240611172823-cndoh4z","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"经闭、损伤，皆有气血瘀滞，由于络道瘀阻，常发生疼痛。丹皮能活血散瘀，使瘀滞散而气血流畅，疼痛得解，常和当归、赤芍、桃仁、红花等同用。"}]},{"ID":"20240611172823-4k75uf1","Type":"NodeParagraph","Properties":{"id":"20240611172823-4k75uf1","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"3.对于疮痈肿毒、肠痈等症，本品也是常用的药物。疗疮痈可配合清热解毒药如银花、连翘、地丁草之类；治肠痈初起未能脓者可和大黄、芒硝、桃仁、冬瓜子等同用；已成脓者合红藤、连翘、败酱草之类应用。"}]},{"ID":"20240611172823-0mwgxwj","Type":"NodeParagraph","Properties":{"id":"20240611172823-0mwgxwj","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【处方用名】粉丹皮、丹皮（生用，用于清实热、泻虚火，活血败瘀）、炒丹皮、丹皮炭（炒至黑色用，用于凉血止血）"}]},{"ID":"20240611172823-zup9t74","Type":"NodeParagraph","Properties":{"id":"20240611172823-zup9t74","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240611172823-1d6zkvm","Type":"NodeParagraph","Properties":{"id":"20240611172823-1d6zkvm","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【按语】丹皮善清血，而又活血，因而有凉血散瘀的功效，使血流畅而不留瘀，血热清而不妄行。故对血热炽盛、肝肾火旺及瘀血阻滞等症，都恃为要药。"}]},{"ID":"20240611172823-8i48g4o","Type":"NodeParagraph","Properties":{"id":"20240611172823-8i48g4o","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"本品配鲜生地，能清热凉血；配大生地，则滋肾泻火；配山栀，则清肝泄热；配赤芍、桃仁，则活血散瘀；配侧柏叶、鲜茅根，则凉血止血。"}]},{"ID":"20240611172823-bo2v3wa","Type":"NodeParagraph","Properties":{"id":"20240611172823-bo2v3wa","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"【方剂举例】牡丹散《证治准绳》：牡丹皮、芍药、当归、红花、干漆、苏木、没药、莪朮、鬼箭羽、延胡、乌药、陈皮、甘草、桂枝。治虚损精闭、潮热体疲、午后发烧。"}]},{"ID":"20240611172823-juxr1sc","Type":"NodeParagraph","Properties":{"id":"20240611172823-juxr1sc","updated":"20240611172823"},"Children":[{"Type":"NodeText","Data":"牡丹皮散《证治准绳》：丹皮、赤芍、生地、当归、桃仁、川芎、乳香、没药、骨碎补、续断。治跌仆损伤、滞血疼痛。"}]},{"ID":"20240611172918-7vgnbsl","Type":"NodeThematicBreak","Properties":{"id":"20240611172918-7vgnbsl"}},{"ID":"20240611172919-8ow1hed","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172919-8ow1hed","updated":"20240611172924"},"Children":[{"Type":"NodeText","Data":"牡丹皮《本草从新》"}]},{"ID":"20240611172919-k5suks0","Type":"NodeParagraph","Properties":{"id":"20240611172919-k5suks0","updated":"20240611172919"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻伏火、去瘀．"}]},{"ID":"20240611172919-rlxz7nl","Type":"NodeParagraph","Properties":{"id":"20240611172919-rlxz7nl","updated":"20240611172919"},"Children":[{"Type":"NodeText","Data":"辛苦微寒．入手足少阴（心、肾．）厥阴．（心包、肝．）泻血中伏火．（色赤、故入血分、能泻诸经伏火、古方所以用治相火也、世人专以黄柏治相火、不知丹皮之功更胜．）和血凉血而生血．（血热则枯、凉则生．）破积血．（积瘀不去、则新血不生．）通经脉．止吐衄．（血属阴本静、因相火所逼、故越出上窍、治惊痫螈 ．筋脉伸缩抽掣、为螈 、或手足抽掣、口眼 斜、卒然眩仆、吐涎身软、时发时止、为痫、皆阴虚血热、风火相搏、痰随火涌所致．）除烦热．疗痈疮．（凉血．）下胞胎．退无汗之骨蒸．（张元素曰∶丹皮治无汗之骨蒸、地骨皮治有汗之骨蒸、神不足者手少阴、志不足者足少阴、仲景肾气丸、用丹皮、治神志不足也、按内经云∶水之精为志、故肾藏志、火之精为神、故心藏神．）胃气虚寒．经行过期不净者勿服．胎前亦宜酌用．单瓣花红者入药．（时珍曰∶花白者补、赤者利、须分别之．）肉浓者佳．酒拌蒸用．畏贝母、菟丝、大黄．忌蒜、胡荽、伏砒．（丹皮根捣末服、解中蛊毒．）"}]},{"ID":"20240611172908-70aeqch","Type":"NodeThematicBreak","Properties":{"id":"20240611172908-70aeqch"}},{"ID":"20240611172909-v8mg500","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172909-v8mg500","updated":"20240611172913"},"Children":[{"Type":"NodeText","Data":"牡丹皮《本草备要》"}]},{"ID":"20240611172909-2zuk45i","Type":"NodeParagraph","Properties":{"id":"20240611172909-2zuk45i","updated":"20240611172909"},"Children":[{"Type":"NodeText","Data":"泻伏火而补血"}]},{"ID":"20240611172909-5iavwft","Type":"NodeParagraph","Properties":{"id":"20240611172909-5iavwft","updated":"20240611172909"},"Children":[{"Type":"NodeText","Data":"辛甘寒微。入手足少阴（心、肾）、厥阴（心包、肝）。泻血中伏火（色丹故入血分。时珍曰∶伏火即阴火也，阴火即相火也。世人专以黄柏治相火，不知丹皮之功更胜，故仲景肾气丸用之），和血、凉血而生血（血热则枯，凉则生），破积血（积瘀不去则新血不生），通经脉。"}]},{"ID":"20240611172909-qys2c2a","Type":"NodeParagraph","Properties":{"id":"20240611172909-qys2c2a","updated":"20240611172909"},"Children":[{"Type":"NodeText","Data":"为吐衄必用之药（血属阴本静，因相火所逼，故越出上窍）。治中风，五劳，惊痫螈（筋脉伸缩抽掣为螈 。或手足抽掣，口眼 斜，卒然眩仆，吐涎身软，时发时止为痫。皆阴虚血热，风火相搏，痰随火涌所致），除烦热，疗痈疮（凉血），下胞胎，退无汗之骨蒸（张元素曰∶丹皮治无汗之骨蒸，地骨皮治有汗之骨蒸。神不足者手少阴，志不足者足少阴，故仲景肾气丸用丹皮，治神志不足也。按《内经》曰∶水之精为志，故肾藏志。火之精为神，故心藏神）。"}]},{"ID":"20240611172909-5uay9hv","Type":"NodeParagraph","Properties":{"id":"20240611172909-5uay9hv","updated":"20240611172909"},"Children":[{"Type":"NodeText","Data":"单瓣花红者入药，肉浓者佳。酒拌蒸用。畏贝母、菟丝、大黄。忌蒜、胡荽、伏砒（时珍曰∶花白者补，赤者利，人所罕悟，宜分别之）"}]},{"ID":"20240611173014-l9doqxw","Type":"NodeThematicBreak","Properties":{"id":"20240611173014-l9doqxw"}},{"ID":"20240611173015-phakt24","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173015-phakt24","updated":"20240611173015"},"Children":[{"Type":"NodeText","Data":"牡丹皮"}]},{"ID":"20240611173015-9x5w90n","Type":"NodeParagraph","Properties":{"id":"20240611173015-9x5w90n","updated":"20240611173015"},"Children":[{"Type":"NodeText","Data":"（芳草）泻肾血分实热治无汗骨蒸"}]},{"ID":"20240611173015-tlvk0hx","Type":"NodeParagraph","Properties":{"id":"20240611173015-tlvk0hx","updated":"20240611173015"},"Children":[{"Type":"NodeText","Data":"牡丹皮（专入心肾肝）。辛苦微寒。能入手少阴心足少阴肾足厥阴肝。以治三经血中伏火。时珍曰。伏火即阴火也。阴火即相火也。相火炽则血必枯必燥必滞。与火上浮而见为吐为衄。（汪昂曰。血属阴。本静。因相火所逼。故越出上窍。）虚损与风与痰与火相抟。而见五痨惊痫螈 。（螈则筋急而缩。 则筋缓而伸。或伸或缩。手如拽锯。谓之螈 。即俗所谓为搐惊。则外有所触。心无所主。痫则卒然昏仆。身软吐痰。时发时止。五痨。一曰志痨。二曰心痨。三曰思痨。四曰忧痨。五曰疫痨。）瘀结而见疮疡痈毒产难。并无汗骨蒸。（阴虚又兼邪郁。故见无汗骨蒸。）用此不特味辛而散血中之实热。且有凉相火之神功。世人专以黄柏治相火。而不知丹皮之功更胜。盖黄柏恶寒而燥。初则伤胃。久则败阳。苦燥之性徒存。而补阴之功绝少。丹皮赤色象离。能泻阴中之火。使火退而阴生。所以入足少阴而佐滋补之用。较之黄柏。不啻霄壤矣。张元素曰。丹皮治无汗之骨蒸。地骨皮治有汗之骨蒸。神不足者手少阴心。志不足者足少阴肾。（仲景）肾气丸用丹皮。治神志不足也。（内经曰。水之精为志。故肾藏志。火之精为神。故心藏神。）但补性少而泄性多。凡虚寒血崩。经行过期不尽者。为并禁焉。赤者利血。白者兼补气。酒拌蒸用。忌蒜胡荽。伏砒。"}]},{"ID":"20240611172959-2blx41h","Type":"NodeThematicBreak","Properties":{"id":"20240611172959-2blx41h"}},{"ID":"20240611173000-xn2oxw2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173000-xn2oxw2","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"《中国药典》：牡丹皮"}]},{"ID":"20240611173000-us0fmy0","Type":"NodeParagraph","Properties":{"id":"20240611173000-us0fmy0","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173000-n10t8i3","Type":"NodeParagraph","Properties":{"id":"20240611173000-n10t8i3","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" Mǔ Dān Pí"}]},{"ID":"20240611173000-ox25qc9","Type":"NodeParagraph","Properties":{"id":"20240611173000-ox25qc9","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173000-3hd8huf","Type":"NodeParagraph","Properties":{"id":"20240611173000-3hd8huf","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 丹皮、粉丹皮、木芍药、条丹皮、洛阳花"}]},{"ID":"20240611173000-5hzvhs3","Type":"NodeParagraph","Properties":{"id":"20240611173000-5hzvhs3","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611173000-q7jsqzz","Type":"NodeParagraph","Properties":{"id":"20240611173000-q7jsqzz","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" CORTEX MOUTAN"}]},{"ID":"20240611173000-84z0w1m","Type":"NodeParagraph","Properties":{"id":"20240611173000-84z0w1m","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173000-hnekslb","Type":"NodeParagraph","Properties":{"id":"20240611173000-hnekslb","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 本品为毛茛科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牡丹"},{"Type":"NodeText","Data":"Paeonia suffruticosa Andr.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。秋季采挖根部，除去细根，剥取根皮，晒干。"}]},{"ID":"20240611173000-v955hpq","Type":"NodeParagraph","Properties":{"id":"20240611173000-v955hpq","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611173000-ge2xp5u","Type":"NodeParagraph","Properties":{"id":"20240611173000-ge2xp5u","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 本品呈筒状或半筒状，有纵剖开的裂缝，略向内卷曲或张开，长5～20cm，直径0.5～1.2cm，厚0.1～0.4cm。外表面灰褐色或黄褐色，有多数横长皮孔及细根痕，栓皮脱落处粉红色。内表面淡灰黄色或浅棕色，有明显的细纵纹，常见发亮的结晶。质硬而脆，易折断，断面较平坦，淡粉红色，粉性。气芳香，味微苦而涩。"}]},{"ID":"20240611173000-9wxgsa2","Type":"NodeParagraph","Properties":{"id":"20240611173000-9wxgsa2","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611173000-r9qg7a9","Type":"NodeParagraph","Properties":{"id":"20240611173000-r9qg7a9","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240611173000-vc66069","Type":"NodeParagraph","Properties":{"id":"20240611173000-vc66069","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611173000-e99b8ja","Type":"NodeParagraph","Properties":{"id":"20240611173000-e99b8ja","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 迅速洗净，润后切薄片，晒干。"}]},{"ID":"20240611173000-rrnvq3w","Type":"NodeParagraph","Properties":{"id":"20240611173000-rrnvq3w","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611173000-44flq5x","Type":"NodeParagraph","Properties":{"id":"20240611173000-44flq5x","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末淡红棕色。淀粉粒甚多，单粒类圆形或多角形，直径3～16μm，脐点点状、裂缝状或飞鸟状；复粒由 2～6 分粒组成。草酸钙簇晶直径 9～45μm，有时含晶细胞连接，簇晶排列成行，或一个细胞含数个簇晶。木栓细胞长方形，壁稍厚，浅红色。"}]},{"ID":"20240611173000-2d4wf0l","Type":"NodeParagraph","Properties":{"id":"20240611173000-2d4wf0l","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.15g ，加无水乙醇25ml，振摇数分钟，滤过。取滤液 1ml，加无水乙醇至25ml，照分光亮度法（附录Ⅴ A）测定，在274nm 的波长处有最大吸收。"}]},{"ID":"20240611173000-rg1twca","Type":"NodeParagraph","Properties":{"id":"20240611173000-rg1twca","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末1g，加乙醚10ml，密塞，振摇10分钟，滤过，滤液挥干，残渣加丙铜 2ml使溶解，作为供试品溶液。另取丹皮酚对照品，加丙酮制成每1ml 含5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各 10μl，分别点于同一硅胶Ｇ薄层板上，以环己烷－醋酸乙酯（3:1）为展开剂，展开，取出，晾干，喷以盐酸酸性 5％三氯化铁乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同的蓝褐色斑点。"}]},{"ID":"20240611173000-a9v1zii","Type":"NodeParagraph","Properties":{"id":"20240611173000-a9v1zii","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611173000-cz63rx1","Type":"NodeParagraph","Properties":{"id":"20240611173000-cz63rx1","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 归心、肝、肾经。"}]},{"ID":"20240611173000-r4ys5kz","Type":"NodeParagraph","Properties":{"id":"20240611173000-r4ys5kz","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173000-1t4a3zu","Type":"NodeParagraph","Properties":{"id":"20240611173000-1t4a3zu","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 苦、辛，微寒。"}]},{"ID":"20240611173000-dkie5pp","Type":"NodeParagraph","Properties":{"id":"20240611173000-dkie5pp","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173000-o9asqua","Type":"NodeParagraph","Properties":{"id":"20240611173000-o9asqua","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 清热凉血，活血化瘀。用于温毒发斑，吐血衄血，夜热早凉，无汗骨蒸，经闭痛经，痈肿疮毒，跌扑伤痛。"}]},{"ID":"20240611173000-q88dnvo","Type":"NodeParagraph","Properties":{"id":"20240611173000-q88dnvo","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173000-tb3oyvd","Type":"NodeParagraph","Properties":{"id":"20240611173000-tb3oyvd","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240611173000-0zanxe7","Type":"NodeParagraph","Properties":{"id":"20240611173000-0zanxe7","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611173000-qt0dbno","Type":"NodeParagraph","Properties":{"id":"20240611173000-qt0dbno","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" （1）牡丹皮善清血，而又活血，因而有凉血散瘀的功效，使血流畅而不留瘀，血热清而不妄行。故对血热炽盛、肝肾火旺及瘀血阻滞等症，都恃为要药。本品配鲜生地，能清热凉血；配大生地，则滋肾泻火；配山栀，则清肝泄热；配赤芍、桃仁，则活血散瘀；配侧柏叶、鲜茅根，则凉血止血。"}]},{"ID":"20240611173000-13jl5h1","Type":"NodeParagraph","Properties":{"id":"20240611173000-13jl5h1","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"用于温热病、热入营血、高热、舌绛、身发斑疹，血热妄行、吐血、衄血、尿血，以及阴虚发热等症。牡丹皮清营血之实热，同时还能治阴虚发热。清血分实热，常与鲜生地、赤芍等同用；疗虚热，常与大生地、知母、青蒿、鳖甲等药相配伍；治血热妄行，常与鲜茅根、侧柏叶、山栀等同用。"}]},{"ID":"20240611173000-fryj452","Type":"NodeParagraph","Properties":{"id":"20240611173000-fryj452","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"用于经闭、跌扑损伤，疮痈肿毒、肠痈等症。经闭、损伤，皆有气血瘀滞，由于络道瘀阻，常发生疼痛。丹皮能活血散瘀，使瘀滞散而气血流畅，疼痛得解，常和当归、赤芍、桃仁、红花等同用。"}]},{"ID":"20240611173000-nro7wym","Type":"NodeParagraph","Properties":{"id":"20240611173000-nro7wym","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"对于疮痈肿毒、肠痈等症，本品也是常用的药物。疗疮痈可配合清热解毒药如银花、连翘、地丁草之类；治肠痈初起未能脓者可和大黄、芒硝、桃仁、冬瓜子等同用；已成脓者合红藤、连翘、败酱草之类应用。"}]},{"ID":"20240611173000-is58p7f","Type":"NodeParagraph","Properties":{"id":"20240611173000-is58p7f","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173000-3q75ed6","Type":"NodeParagraph","Properties":{"id":"20240611173000-3q75ed6","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611173000-0vzadtj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173000-0vzadtj","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：牡丹皮"}]},{"ID":"20240611173000-3uz5z3y","Type":"NodeParagraph","Properties":{"id":"20240611173000-3uz5z3y","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173000-p8x97oc","Type":"NodeParagraph","Properties":{"id":"20240611173000-p8x97oc","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" Mǔ Dān Pí"}]},{"ID":"20240611173000-8s5q10k","Type":"NodeParagraph","Properties":{"id":"20240611173000-8s5q10k","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173000-hmxzym3","Type":"NodeParagraph","Properties":{"id":"20240611173000-hmxzym3","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹根皮（《纲目》），丹皮（《本草正》），丹根（《贵州民间方药集》）。"}]},{"ID":"20240611173000-jf89xnr","Type":"NodeParagraph","Properties":{"id":"20240611173000-jf89xnr","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611173000-58p9y3t","Type":"NodeParagraph","Properties":{"id":"20240611173000-58p9y3t","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 《珍珠囊》·《本经》原作牡丹"}]},{"ID":"20240611173000-wypkduf","Type":"NodeParagraph","Properties":{"id":"20240611173000-wypkduf","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173000-xjbpmrs","Type":"NodeParagraph","Properties":{"id":"20240611173000-xjbpmrs","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 为毛茛科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牡丹"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。选择栽培3～5年的牡丹，于秋季或春初采挖，洗净泥土，除去须根及茎苗，剖取根皮，晒干。或刮去外皮后，再剖取根皮晒干。前者称为\"原丹皮\"，后者称为\"刮丹皮。\""}]},{"ID":"20240611173000-skhzv2x","Type":"NodeParagraph","Properties":{"id":"20240611173000-skhzv2x","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611173000-0dhhhgy","Type":"NodeParagraph","Properties":{"id":"20240611173000-0dhhhgy","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 生于向阳及土壤肥沃的地方，常栽培于庭园。分布河北、河南、山东、四川、陕西、甘肃等地。全国各地均有栽培。"}]},{"ID":"20240611173000-kn1bs7i","Type":"NodeParagraph","Properties":{"id":"20240611173000-kn1bs7i","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611173000-rwywspa","Type":"NodeParagraph","Properties":{"id":"20240611173000-rwywspa","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹，又名：鹿韭、鼠姑（《本经》），白术（《广雅》），百两金、吴牡丹（《唐本草》），木芍药（《开元天宝遗事》），花王（《洛阳名园记》），洛阳花（《群芳谱》），铁角牛。"}]},{"ID":"20240611173000-xq4esjh","Type":"NodeParagraph","Properties":{"id":"20240611173000-xq4esjh","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"多年生落叶小灌木，高1～1.5米。根茎肥厚。枝短而粗壮。叶互生，通常为2回3出复叶；柄长6～10厘米；小叶卵形或广卵形，顶生小叶片通常为3裂，侧生小叶亦有呈掌状3裂者，上面深绿色，无毛。下面略带白色，中脉上疏生白色长毛。花单生于枝端，大形；萼片5，覆瓦状排列，绿色；花瓣5片或多数，一般栽培品种，多为重瓣花，变异很大，通常为倒卵形，顶端有缺刻，玫瑰色，红、紫、白色均有；雄蕊多数，花丝红色，花药黄色；雌蕊2～5枚，绿色，密生短毛，花柱短，柱头叶状；花盘杯状。果实为2～5个蓇葖的聚生果，卵圆形，绿色，被褐色短毛。花期5～7月。果期7～8月。"}]},{"ID":"20240611173000-j65vwhp","Type":"NodeParagraph","Properties":{"id":"20240611173000-j65vwhp","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611173000-62u05ni","Type":"NodeParagraph","Properties":{"id":"20240611173000-62u05ni","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" ①原丹皮"}]},{"ID":"20240611173000-8mlz8pa","Type":"NodeParagraph","Properties":{"id":"20240611173000-8mlz8pa","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"根皮呈圆筒状、半筒状，有纵剖开的裂缝，两边向内卷曲，通常长3～8厘米，厚约2毫米。外表灰褐色或紫棕色，木栓有的已脱落，呈棕红色，可见须根痕及突起的皮孔；内表面淡棕色或灰黄色，有纵细纹理及发亮的结晶状物。质硬而脆，断面不平坦，或显粉状，淡黄色而微红。有特殊香气，味微苦而涩，稍有麻舌感。"}]},{"ID":"20240611173000-u8a2zhl","Type":"NodeParagraph","Properties":{"id":"20240611173000-u8a2zhl","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②刮丹皮"}]},{"ID":"20240611173000-8cibqjl","Type":"NodeParagraph","Properties":{"id":"20240611173000-8cibqjl","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"又名：粉丹皮（《滇南本草》），表面稍相糙，粉红色。其他均与原丹皮同。"}]},{"ID":"20240611173000-84ec02v","Type":"NodeParagraph","Properties":{"id":"20240611173000-84ec02v","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"上述二种药材，以条粗长、皮厚、粉性足、香气浓、结晶状物多者为佳。"}]},{"ID":"20240611173000-pyy7sri","Type":"NodeParagraph","Properties":{"id":"20240611173000-pyy7sri","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"主产安徽、四川、甘肃、陕西、湖北、湖南、山东、贵州等地。此外，云南、浙江亦产。以四川、安徽产量最大。安徽铜陵凤凰山所产的质量最佳，称为凤丹皮；安徽南陵所产称瑶丹皮；四川垫江、灌县所产称川丹皮；甘肃、陕西及四川康定、泸定所产称西丹皮；四川西昌所产的称西昌丹皮，质量较次。"}]},{"ID":"20240611173000-llp6qaw","Type":"NodeParagraph","Properties":{"id":"20240611173000-llp6qaw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611173000-9684p00","Type":"NodeParagraph","Properties":{"id":"20240611173000-9684p00","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 根含牡丹酚、牡丹酚甙、牡丹酚原甙、芍药甙。尚含挥发油0.15～0.4％及植物甾醇等。"}]},{"ID":"20240611173000-3rys1wv","Type":"NodeParagraph","Properties":{"id":"20240611173000-3rys1wv","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611173000-kjo5f6g","Type":"NodeParagraph","Properties":{"id":"20240611173000-kjo5f6g","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" ①对中枢的作用"}]},{"ID":"20240611173000-lz0s37z","Type":"NodeParagraph","Properties":{"id":"20240611173000-lz0s37z","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"小鼠腹腔注射或口服牡丹酚，具有镇静、催眠、镇痛作用；使正常小鼠体温降低（腹腔注射或灌胃），对人工发热小鼠（注射伤寒和副伤寒杆菌所致）也有退热作用；还有抗电休克或药物引起的惊瞅的作用"}]},{"ID":"20240611173000-ryoxw6g","Type":"NodeParagraph","Properties":{"id":"20240611173000-ryoxw6g","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②降压作用"}]},{"ID":"20240611173000-eeed2sn","Type":"NodeParagraph","Properties":{"id":"20240611173000-eeed2sn","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"静脉注射丹皮水煎剂（相当生药0.75克／公斤），对麻醉犬、猫和大鼠皆有降压作用；牡丹酚和除去牡丹酚的水煎液，在急性动物实验中亦有降压效力；实验性高血压（\"原发\"型和肾型）犬或大鼠口服，都能出现一定降压作用，但作用出现较慢，可能由于在胃肠道吸收缓慢。"}]},{"ID":"20240611173000-i3mucms","Type":"NodeParagraph","Properties":{"id":"20240611173000-i3mucms","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"③抗菌作用"}]},{"ID":"20240611173000-qb52hyw","Type":"NodeParagraph","Properties":{"id":"20240611173000-qb52hyw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"试管内对白色葡萄球菌、枯草杆菌、大肠杆菌、伤寒杆菌等有较强抗菌作用。牡丹皮对痢疾杆菌、伤寒杆菌等作用显著（试管内两倍稀释法），在pH7.0～7.6杀菌力最强。琼脂平板挖沟法等也证明对伤寒杆菌、痢疾杆菌、副饬寒杆菌、大肠杆菌。变形杆菌、绿脓杆菌、葡萄球菌、溶血性链球菌、肺炎球菌、霍乱弧菌等多种细菌都有不同程度的抑制作用。牡丹酚在试管内对大肠杆菌、枯草杆菌、金黄色葡萄球菌等也有抑制作用。丹皮浸液在试管内对铁锈色小芽胞菌等10种皮肤真菌也有一定抑制作用。"}]},{"ID":"20240611173000-toib62w","Type":"NodeParagraph","Properties":{"id":"20240611173000-toib62w","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240611173000-8xxre8p","Type":"NodeParagraph","Properties":{"id":"20240611173000-8xxre8p","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"牡丹酚对大鼠后肢足蹠浮肿有抑制作用，并能降低血管通透性，牡丹皮除去牡丹酚后即失去上述作用。用鸡胚实验表明，牡丹皮有一定抗病毒作用，但给小鼠灌胃、再感染流感病毒，则结果不一，故其抗病毒作用尚不能肯定。"}]},{"ID":"20240611173000-p0lgvlk","Type":"NodeParagraph","Properties":{"id":"20240611173000-p0lgvlk","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"喜马拉雅山产之喜马牡丹热浸液对各种动物子宫均有兴奋作用，但对蛙心则抑制，对兔、豚鼠肠管有解痉作用。药用牡丹之乙醇提取物，蒸去乙醇，对蛙心有洋地黄样作用，能兴奋子宫，抑制大鼠及兔肠管，轻度降低大白鼠血压，但无镇痛及抗惊厥作用（电休克及五甲烯四氮唑的休克）。"}]},{"ID":"20240611173000-2szdn35","Type":"NodeParagraph","Properties":{"id":"20240611173000-2szdn35","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611173000-s427qsl","Type":"NodeParagraph","Properties":{"id":"20240611173000-s427qsl","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹皮：拣去杂质，除去木心，洗净，润透，切片，晾干。炒丹皮：将丹皮片入热锅内，不断翻炒至略有黄色焦斑时，取山，凉透。丹皮炭：取牡丹皮片入锅内，以武火炒至焦黑色，存性为度，喷淋清水，取出，凉透。"}]},{"ID":"20240611173000-wo4i9k1","Type":"NodeParagraph","Properties":{"id":"20240611173000-wo4i9k1","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611173000-6fhx4g4","Type":"NodeParagraph","Properties":{"id":"20240611173000-6fhx4g4","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 入心、肝、肾经。"}]},{"ID":"20240611173000-8i7apqd","Type":"NodeParagraph","Properties":{"id":"20240611173000-8i7apqd","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"手厥阴、足少阴。\""}]},{"ID":"20240611173000-tvaedj3","Type":"NodeParagraph","Properties":{"id":"20240611173000-tvaedj3","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"手足少阴、厥阴四经。\""}]},{"ID":"20240611173000-y86d1w0","Type":"NodeParagraph","Properties":{"id":"20240611173000-y86d1w0","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入肺经。\""}]},{"ID":"20240611173000-luq558w","Type":"NodeParagraph","Properties":{"id":"20240611173000-luq558w","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173000-6etap2m","Type":"NodeParagraph","Properties":{"id":"20240611173000-6etap2m","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 辛苦，凉。"}]},{"ID":"20240611173000-7dyfdzo","Type":"NodeParagraph","Properties":{"id":"20240611173000-7dyfdzo","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，寒。\""}]},{"ID":"20240611173000-5d8z7cs","Type":"NodeParagraph","Properties":{"id":"20240611173000-5d8z7cs","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"性寒，味酸辛。\""}]},{"ID":"20240611173000-xeswy84","Type":"NodeParagraph","Properties":{"id":"20240611173000-xeswy84","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"③《本草备要》：\"辛甘，微寒。\""}]},{"ID":"20240611173000-2e02fle","Type":"NodeParagraph","Properties":{"id":"20240611173000-2e02fle","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611173000-sahsci0","Type":"NodeParagraph","Properties":{"id":"20240611173000-sahsci0","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 血虚有寒，孕妇及月经过多者慎服。"}]},{"ID":"20240611173000-b47ppyw","Type":"NodeParagraph","Properties":{"id":"20240611173000-b47ppyw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"畏菟丝子。\""}]},{"ID":"20240611173000-edm5veu","Type":"NodeParagraph","Properties":{"id":"20240611173000-edm5veu","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②《古今录验方》：\"忌胡荽。\""}]},{"ID":"20240611173000-za3zplo","Type":"NodeParagraph","Properties":{"id":"20240611173000-za3zplo","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"畏贝母、大黄。\""}]},{"ID":"20240611173000-i0axac6","Type":"NodeParagraph","Properties":{"id":"20240611173000-i0axac6","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"忌蒜。\""}]},{"ID":"20240611173000-39rrtcy","Type":"NodeParagraph","Properties":{"id":"20240611173000-39rrtcy","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑤《本经逢原》：\"自汗多者勿用，为能走泄津液也。痘疹初起勿用，为其性专散血.不无根脚散阔之虑。\""}]},{"ID":"20240611173000-uci6v7v","Type":"NodeParagraph","Properties":{"id":"20240611173000-uci6v7v","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑥《得配本草》：\"胃气虚寒，相火衰者，勿用。\""}]},{"ID":"20240611173000-rl9yphn","Type":"NodeParagraph","Properties":{"id":"20240611173000-rl9yphn","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173000-c7m5wg9","Type":"NodeParagraph","Properties":{"id":"20240611173000-c7m5wg9","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 清热，凉血，和血，消瘀。治热入血分，发斑，惊痫，吐、衄、便血，骨蒸劳热，经闭，症瘕，痈疡，扑损。"}]},{"ID":"20240611173000-z6j823d","Type":"NodeParagraph","Properties":{"id":"20240611173000-z6j823d","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热，中风瘈疭、痉、惊痫邪气，除症坚瘀血留舍肠胃，安五脏，疗痈疮。\""}]},{"ID":"20240611173000-n4rlzr8","Type":"NodeParagraph","Properties":{"id":"20240611173000-n4rlzr8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除时气头痛，客热五劳，劳气头腰痛，风噤，癫疾。\""}]},{"ID":"20240611173000-cqqbwv8","Type":"NodeParagraph","Properties":{"id":"20240611173000-cqqbwv8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治冷气，散诸痛，治女子经脉不通，血沥腰疼。\""}]},{"ID":"20240611173000-xp2u9zt","Type":"NodeParagraph","Properties":{"id":"20240611173000-xp2u9zt","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"除邪气，悦色，通关腠血脉，排脓，通月经，消扑损瘀血，续筋骨，除风痹，落胎下胞，产后一切冷热血气。\""}]},{"ID":"20240611173000-ehfwi6d","Type":"NodeParagraph","Properties":{"id":"20240611173000-ehfwi6d","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑤《珍珠囊》：\"治肠胃积血、衄血、吐血，无汗骨蒸。\""}]},{"ID":"20240611173000-bcbxjxp","Type":"NodeParagraph","Properties":{"id":"20240611173000-bcbxjxp","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"破血，行（血），消癥瘕之疾，除血分之热。\""}]},{"ID":"20240611173000-tgrgrmg","Type":"NodeParagraph","Properties":{"id":"20240611173000-tgrgrmg","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑦《医学入门》：\"泻伏火，养真血气，破结蓄。\""}]},{"ID":"20240611173000-en67h2g","Type":"NodeParagraph","Properties":{"id":"20240611173000-en67h2g","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"和血，生血，凉血。治血中伏火，除烦热。\""}]},{"ID":"20240611173000-s6j00mj","Type":"NodeParagraph","Properties":{"id":"20240611173000-s6j00mj","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173000-96i9coy","Type":"NodeParagraph","Properties":{"id":"20240611173000-96i9coy","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240611173000-n52dcrj","Type":"NodeParagraph","Properties":{"id":"20240611173000-n52dcrj","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611173000-bqkq2dm","Type":"NodeParagraph","Properties":{"id":"20240611173000-bqkq2dm","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" ①治伤寒热毒发疮如豌豆：牡丹皮、山栀子仁、黄芩（去黑心）、大黄（锉、炒）、木香、麻黄（去根、节）。上六味等分，锉如麻豆大。每服三钱匕，水一盏，煎至七分，去滓，温服。（《圣济总录》牡丹汤）"}]},{"ID":"20240611173000-ik13c4q","Type":"NodeParagraph","Properties":{"id":"20240611173000-ik13c4q","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②治妇人恶血攻聚上面，多怒：牡丹皮半两，干漆（烧烟尽）半两。水二钟，煎一钟服。（《诸证辨疑》）"}]},{"ID":"20240611173000-kc2bjt6","Type":"NodeParagraph","Properties":{"id":"20240611173000-kc2bjt6","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"③治伤寒及温病应发汗而不发汗之内蓄血者，及鼻衄、吐血不尽，内余瘀血，面黄，大便黑；消瘀血：犀角一两，生地黄八两，芍药三两，牡丹皮二两。上四味，细切，以水九升，煮取三升，分三服。（《千金方》犀角地黄汤）"}]},{"ID":"20240611173000-fzznabg","Type":"NodeParagraph","Properties":{"id":"20240611173000-fzznabg","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"④治胎前衄血：丹皮、黄芩、蒲黄、白芍、侧柏叶。共为细末，早米糊为丸。空心白汤下百丸。（《秘传内府经验女科》）"}]},{"ID":"20240611173000-2jii55v","Type":"NodeParagraph","Properties":{"id":"20240611173000-2jii55v","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑤治妇人骨蒸，经脉不通，渐增瘦弱：牡丹皮一两半，桂（去粗皮）一两，木通（锉、炒）一两，芍药一两半，鳖甲（醋炙，去裙襕）二两，土瓜根一两半，桃仁（汤浸，去皮、尖、双人，炒）。上七味粗捣筛。每五钱匕，水一盏半，煎至一盏，去滓，分温二服，空心食后各一。（《圣济总录》牡丹汤）"}]},{"ID":"20240611173000-xzoic10","Type":"NodeParagraph","Properties":{"id":"20240611173000-xzoic10","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑥治肠痈，少腹肿痞，按之即痛如淋，小便自调，时时发热，自汗出，复恶寒，其脉迟紧者，脓未成，可下之，当有血，脉洪数者，脓已成，不可下也：大黄四两，牡丹一两，桃仁五十个，瓜子半升，芒硝三合。上五味，以水六升，煮取一升，去滓，内芒硝，再煎沸，顿服之。有脓当下，如无脓当下血。（《金匮要略》大黄牡丹汤）"}]},{"ID":"20240611173000-oj4lv6b","Type":"NodeParagraph","Properties":{"id":"20240611173000-oj4lv6b","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑦治悬痈生于谷道之前，小便之后，初发甚痒，状如松子，-月赤肿如桃，迟治则破，而大小便皆从此出，先服国老汤不消者：牡丹皮、大黄、贝母、白芷、甘草、当归各五钱。共为细末，酒调服二钱，空心吃。（《本草汇言》将军散）"}]},{"ID":"20240611173000-pdkaipw","Type":"NodeParagraph","Properties":{"id":"20240611173000-pdkaipw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑧治下部生疮，已决洞者：牡丹方寸匕，日三服。（《补缺肘后方》）"}]},{"ID":"20240611173000-0m0sycl","Type":"NodeParagraph","Properties":{"id":"20240611173000-0m0sycl","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑨治金疮内漏，血不出：牡丹皮为散，水服三指撮，立尿出血。（《千金方）"}]},{"ID":"20240611173000-hvr350v","Type":"NodeParagraph","Properties":{"id":"20240611173000-hvr350v","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑩治腕折瘀血：虻虫二十枚，牡丹一两。上二味治下筛，酒服方寸匕。（《千金方》）"}]},{"ID":"20240611173000-wmi55kt","Type":"NodeParagraph","Properties":{"id":"20240611173000-wmi55kt","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑾疝气（觉气胀不能动）。用牡丹皮、防风，等分为末，每服二钱，酒送下。"}]},{"ID":"20240611173000-ud7yu01","Type":"NodeParagraph","Properties":{"id":"20240611173000-ud7yu01","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⑿妇女恶血（血往上冲，脸红易怒）。用牡丹皮半两、干漆（烧至烟尽）半两，加水二杯，煎成一杯服下。"}]},{"ID":"20240611173000-xr0zgg1","Type":"NodeParagraph","Properties":{"id":"20240611173000-xr0zgg1","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⒀伤损瘀血。用牡丹皮二两、虻虫二十一个（熬过），同捣碎。每天早晨服一匙，温酒送下。"}]},{"ID":"20240611173000-uper9e2","Type":"NodeParagraph","Properties":{"id":"20240611173000-uper9e2","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⒁刀伤后内出血。用牡丹皮研细，水冲服少许。瘀血自尿中排出。"}]},{"ID":"20240611173000-7sgu3zm","Type":"NodeParagraph","Properties":{"id":"20240611173000-7sgu3zm","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"⒂下部生疮（已破口）。取牡丹末一匙煎服。一天三次。"}]},{"ID":"20240611173000-xg0tr7y","Type":"NodeParagraph","Properties":{"id":"20240611173000-xg0tr7y","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611173000-vojnyx9","Type":"NodeParagraph","Properties":{"id":"20240611173000-vojnyx9","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" ①治疗高血压"}]},{"ID":"20240611173000-lo2srll","Type":"NodeParagraph","Properties":{"id":"20240611173000-lo2srll","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"取牡丹皮1～1.5两，水煎成120～150毫升，每日3次分服；或初次量用5～6钱，如无不良反应增至1两。治疗20余例，一般服药5天左右血压即有明显下降.症状改善；经服药6～33天，舒张压平均下降10～20毫米汞柱，收缩压平均下降20～40毫米汞柱。本组病例近期内均能使血压下降到正常范围或接近正常范围，症状亦随之消失或改善，但远期疗效有待继续观察。个别患者服药后有恶心、头昏等副作用，无需停药即能自然消失。"}]},{"ID":"20240611173000-xr37raw","Type":"NodeParagraph","Properties":{"id":"20240611173000-xr37raw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"②治疗过敏性鼻炎"}]},{"ID":"20240611173000-4ow6hsh","Type":"NodeParagraph","Properties":{"id":"20240611173000-4ow6hsh","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"用10％的牡丹皮煎剂，每晚服50毫升，10天为一疗程，治疗31例，痊愈12例。又治疗9例，服药后症状很快好转，但无1例根治。"}]},{"ID":"20240611173000-9zs81ox","Type":"NodeParagraph","Properties":{"id":"20240611173000-9zs81ox","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"此外，用10％丹皮煎液内服（每晚50毫升），试治乳突凿开术后，因伴有变态反应而致迟迟不得干耳的患者6例，结果5例痊愈，1例减轻。"}]},{"ID":"20240611173000-3up54of","Type":"NodeParagraph","Properties":{"id":"20240611173000-3up54of","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611173000-ols9uhm","Type":"NodeParagraph","Properties":{"id":"20240611173000-ols9uhm","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" （一）西丹皮除上述正品丹皮外，在陕西尚用矮牡丹、紫斑牡丹的根皮。西昌丹皮品种复杂，除正品丹皮外，尚用黄牡丹、野牡丹、保氏牡丹、四川牡丹的根皮。"}]},{"ID":"20240611173000-lgnrtao","Type":"NodeParagraph","Properties":{"id":"20240611173000-lgnrtao","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"此外，四川尚产一种茂丹皮，为茂纹牡丹。云南所产的云南丹皮，则为黄牡丹和云南牡丹的根皮。"}]},{"ID":"20240611173000-e6zx3za","Type":"NodeParagraph","Properties":{"id":"20240611173000-e6zx3za","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"（二）牡丹的功用。在于清热凉血，活血散瘀，能治心、肾、肝等经的伏火（阴火，相火）。治伏火，许多人多用黄蘖；其实，牡丹更胜于黄蘖。李时珍指出：牡丹只取红、白两色的单瓣者入药，其他品种皆人工培育而成\"气味不纯，不可用\"红花者偏于利，白花者偏于补。"}]},{"ID":"20240611173000-ih6zogg","Type":"NodeParagraph","Properties":{"id":"20240611173000-ih6zogg","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173000-qlxcncm","Type":"NodeParagraph","Properties":{"id":"20240611173000-qlxcncm","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611173000-7nbyf3y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173000-7nbyf3y","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"《中华本草》：牡丹皮"}]},{"ID":"20240611173000-vgm877n","Type":"NodeParagraph","Properties":{"id":"20240611173000-vgm877n","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173000-50kiyqy","Type":"NodeParagraph","Properties":{"id":"20240611173000-50kiyqy","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" Mǔ Dān Pí"}]},{"ID":"20240611173000-0fc4j2c","Type":"NodeParagraph","Properties":{"id":"20240611173000-0fc4j2c","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173000-ldphy9n","Type":"NodeParagraph","Properties":{"id":"20240611173000-ldphy9n","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹根皮、丹皮、丹根。"}]},{"ID":"20240611173000-5yeaqnz","Type":"NodeParagraph","Properties":{"id":"20240611173000-5yeaqnz","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611173000-fyacjl6","Type":"NodeParagraph","Properties":{"id":"20240611173000-fyacjl6","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" Tree Peony Bark"}]},{"ID":"20240611173000-4lq5zbd","Type":"NodeParagraph","Properties":{"id":"20240611173000-4lq5zbd","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611173000-q88ede8","Type":"NodeParagraph","Properties":{"id":"20240611173000-q88ede8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 陶弘景：牡丹，今东间亦有。色赤者为好，用之去心。"}]},{"ID":"20240611173000-tdftokw","Type":"NodeParagraph","Properties":{"id":"20240611173000-tdftokw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：牡丹，生汉中。剑南所出者，苗似羊桃，夏生白花，秋实圆绿，冬实赤色，凌冬不雕，根似芍药，肉白皮丹。土人谓之牡丹，亦名百两金，京下谓之吴牡丹者是真也。今俗用者异于此，别有臊气也。"}]},{"ID":"20240611173000-kcx4t9d","Type":"NodeParagraph","Properties":{"id":"20240611173000-kcx4t9d","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"2.《四声本草》：牡丹，今出合州者佳。白者补，赤者利。出和州、宣州者并良。"}]},{"ID":"20240611173000-oesl3q1","Type":"NodeParagraph","Properties":{"id":"20240611173000-oesl3q1","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：牡丹，今丹、延、青、越、滁、和州山中皆有之。花"}]},{"ID":"20240611173000-0r1gubh","Type":"NodeParagraph","Properties":{"id":"20240611173000-0r1gubh","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173000-337wyze","Type":"NodeParagraph","Properties":{"id":"20240611173000-337wyze","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芍药科植物牡丹的根皮。"}]},{"ID":"20240611173000-8qk9skx","Type":"NodeParagraph","Properties":{"id":"20240611173000-8qk9skx","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Paeonia suffruticosa Andr.［P.moutan Sims；P.yunnanensis Fang］"}]},{"ID":"20240611173000-awg3dbc","Type":"NodeParagraph","Properties":{"id":"20240611173000-awg3dbc","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"采收和储藏：种子播种生长4-6年，分株繁殖3-年收获，9月下旬至10月上旬地上部枯萎将根挖起，去泥、须根，趁鲜抽出木心，晒干，即为原丹皮。刮去丹皮后，去除木心者，称刮丹皮。"}]},{"ID":"20240611173000-heypwft","Type":"NodeParagraph","Properties":{"id":"20240611173000-heypwft","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611173000-lhgldsp","Type":"NodeParagraph","Properties":{"id":"20240611173000-lhgldsp","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于向阳及土壤肥沃的地方，常栽培于庭园。"}]},{"ID":"20240611173000-ieayiy1","Type":"NodeParagraph","Properties":{"id":"20240611173000-ieayiy1","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"资源分布：全国各地多有栽培供观赏。"}]},{"ID":"20240611173000-vwt77ml","Type":"NodeParagraph","Properties":{"id":"20240611173000-vwt77ml","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611173000-eq255h6","Type":"NodeParagraph","Properties":{"id":"20240611173000-eq255h6","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹 落叶小灌木，高1-2m。根粗大。茎直立，枝粗壮，树皮黑灰色。叶互生，纸质；叶柄长5-11cm，无毛；叶通常为二回三出复叶，或二回羽状复叶，近技项的叶为三小叶，顶生小叶常深3裂，长7-8cm，宽5.5-7cm，裂片2-3浅裂或不裂，上面绿色，无毛，下面淡绿色，有时被白粉，沿叶脉疏被短柔毛或近无毛，小叶柄长1.2-3cm；侧生小叶狭卵形或长圆状卵形，长4.5-6.5cm，宽2.5-4cm，2-3浅裂或不裂，近无柄。花两性，单生枝项，直径10-20cm；花梗长4-6cm；苞片5，长椭圆形，大小不等；萼片5，宽卵形，大小不等，绿色，宿存；花瓣5，或为重瓣，倒卵形，长5-8cm，宽4.2-6cm，先端呈不规则的波状，紫色、红色、粉红色、玫瑰色、黄色、豆绿色或白色，变异很大；雄蕊多数，长l-1.7cm，花丝亦具紫红等色，花药黄色；花盘杯状，草质，顶端有数个锐齿或裂片，完全包裹心皮，在心皮成熟时裂开；心皮5，稀更多，离生，绿色，密被柔毛。蓇葖果长圆形，腹缝线开裂，密被黄褐色硬毛。花期4-5月，果期6-7月。"}]},{"ID":"20240611173000-lzj2i95","Type":"NodeParagraph","Properties":{"id":"20240611173000-lzj2i95","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611173000-p7kx3ha","Type":"NodeParagraph","Properties":{"id":"20240611173000-p7kx3ha","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，较耐寒、耐旱、怕涝、怕高温，忌强光。喜上层深厚、排水良好、肥沃疏松的砂质壤上或粉砂壤土。盐碱地、粘土地不宜栽培。忌连作，隔3-5年再种，种子千粒重198g，适宜随采随播。"}]},{"ID":"20240611173000-5me2w0g","Type":"NodeParagraph","Properties":{"id":"20240611173000-5me2w0g","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖、分株繁殖或嫁接繁殖。种子繁殖：牡丹种子具有上胚轴休眠特性，以秋播为好。播期北京地区9月中下旬；安徽8月上旬至10月下旬；山东8月上旬至9月上旬。种子播前以50℃温水浸24-30h，促使发芽。春播种子需进行湿沙贮藏后播种。选地施足基肥，每1hm2 60000-75000kg，撒均匀，深翻15-30cm，耙平，做长方形高畦，按行距6-9cm开浅沟将种子均匀播于沟中，每 1hm2下种量 375-525kg，覆土盖平稍镇压，越冬覆保墒土 6cm，或牛马粪1.5-3cm，再盖草以保温保温。翌年早春去掉覆盖物，随地温回升，再扒去保墒土。在幼苗出土前浇1次催芽水，幼苗出齐后追肥l-2次。秋季，选健壮幼苗按行株距30cm X 50cm移栽，栽后培土6-9cm，保护过冬。分株繁殖:整地作成高垄，在收获牡丹皮时选择健壮、无病虫害小根，按根丛形状分劈，每根留芽子2-3个，以1％硫酸铜抹伤口，防止感染。按行株距40cm x 60cm栽于整好地内，每1hm2栽植12000株，栽后浇水、保墒，封冻前培土。嫁接繁殖：此方法多用于观赏品种，大面积栽培上不用。"}]},{"ID":"20240611173000-l9ws3eo","Type":"NodeParagraph","Properties":{"id":"20240611173000-l9ws3eo","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"田间管理每月中耕除草1-2次，幼龄期中耕宜浅，全年松土7-10次，春、秋各追施土杂肥2500-3000kg，或饼肥150-250kg，于行间沟施。北方寒冷地区，需防寒越冬，于10月下旬在植株四周培土或鞋面盖草。"}]},{"ID":"20240611173000-xmy55a8","Type":"NodeParagraph","Properties":{"id":"20240611173000-xmy55a8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"病虫害防治 灰霉病，喷波尔多液1：1：100倍液，每10dl次。斑点病，喷600借代森锰锌。锈病，初期喷波美0.4-0.3度石硫合剂7-10dl次。"}]},{"ID":"20240611173000-ze26tr4","Type":"NodeParagraph","Properties":{"id":"20240611173000-ze26tr4","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611173000-20t33q8","Type":"NodeParagraph","Properties":{"id":"20240611173000-20t33q8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）原丹皮根皮呈简状、半筒状或破碎成片状，有纵剖开的裂隙，两面多向内卷曲，长5-20cm，直径0.1-1.5cm，厚0.l-0.4cm。外表面灰褐色或紫褐色，粗皮脱落处显粉红色，有微突起的长圆形横生皮孔及支根除去后的残迹；内表面棕色或淡灰黄色，有细纵纹，常见发亮的银星（牡丹酚结晶）。质硬而服，易折断，断面较平坦，显粉性，外层灰褐色，内层粉白或淡粉红色，略有圆形环纹。有特殊浓厚香气，味微苦凉，嚼之发涩，稍有麻舌感。"}]},{"ID":"20240611173000-n105qkn","Type":"NodeParagraph","Properties":{"id":"20240611173000-n105qkn","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"（2）刮丹皮外表有刀刮伤痕，表面红棕色或粉黄色，有多数包浅的横生疤痕及支根残迹，并有极少数灰褐色斑点，系未去净之粗皮。以条粗长，皮厚，无木心，断面粉白色，粉性足，亮银星多，香气浓者为佳。"}]},{"ID":"20240611173000-wc1jjy7","Type":"NodeParagraph","Properties":{"id":"20240611173000-wc1jjy7","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根皮横切面：木柱层为4-8列木柱细胞，浅棕红色，类长方形或类方形，切向24-60μm，径向8-24μm。皮层十数列薄壁细胞，多切向延长，靠近木柱层3-5列细胞壁稍厚。韧皮部宽广，约占横切面径向的4/5，筛管群明显；韧皮射线宽l-3列细胞。本品薄壁细胞含淀粉粒；有的含草酸钙簇晶，直径12-50μm。"}]},{"ID":"20240611173000-lvye2o5","Type":"NodeParagraph","Properties":{"id":"20240611173000-lvye2o5","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡灰白色。①淀粉粒众多。单粒类球形，直径3-19μm，脐点明显，点状、星状、三叉状或裂缝状，层纹不明显；复粒较大，由2-6分粒组成。②草酸钙簇晶直径6-50μm，含晶细胞无色，长方形，一般较小，有的细胞含数个草酸钙簇晶。③木柱细胞横断面观长方形，长24-60μm，浅棕红色；表面现类方形、长方形或多角形。④草酸钙方晶稀少，直径5-14μm。"}]},{"ID":"20240611173000-14r21b3","Type":"NodeParagraph","Properties":{"id":"20240611173000-14r21b3","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"品质标志本品按干燥品计算，含丹皮酚（G9H10 O3）不得少于1.20％。水分不得过13.0％。总灰分不得过5.0％。"}]},{"ID":"20240611173000-qjcyvtv","Type":"NodeParagraph","Properties":{"id":"20240611173000-qjcyvtv","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"商品规格商品按加工方法及产区分有凤丹皮（安微铜陵凤凰山，习称凤丹皮）、原丹皮（连丹皮）和刮丹皮3种，均分为1-4个等级。凤丹皮、原丹皮一等：长6cm以上，中部围粗2.5cm以上；二等：长cm以上，中部围粗1.8cm以上；三等：长4cm以上，中部围粗1cm以上；四等：不符合一、二、三等的细条及断支碎片，最小围租不低于0.6cm。刮丹皮一等：长6cm以上，中部围粗2.4cm以上；二等：长5cm以上，中部围粗1.7cm以上；三等：长4cm以上，中部围粗0.9cm以上；四等：不合一、二、三等长度的断支碎片。"}]},{"ID":"20240611173000-0xgsbff","Type":"NodeParagraph","Properties":{"id":"20240611173000-0xgsbff","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611173000-lh47wu7","Type":"NodeParagraph","Properties":{"id":"20240611173000-lh47wu7","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹皮和牡丹酚的毒性小。牡丹酚对小鼠的半数致死量（观察48小时），静脉注射为96mg／kg，腹腔注射为781mg／kg，灌胃为3430mg/kg。牡丹酚溶于50%花生油中，小鼠1次灌胃，观察3天，其半数致死量为4.9士0.47g／kg；用于治疗实验性高血压犬，未见肝功能、血象、血液非蛋白氮、心电图等异常，仅有眼分泌物稍增加，眼粘膜有充血现象。喜马拉雅山产之喜马牡丹Paeonia emodi热浸液对各种动物子宫均有兴奋作用，但对蛙心则抑制，对兔、豚鼠肠管有解痉作用。药用牡丹P.Officinalis之乙醇提取物，蒸去乙醇，对蛙心有洋地黄样作用，能兴奋子宫，抑制大鼠及兔肠管，轻度降低大白鼠血压，但无镇痛及抗惊厥作用（电休克及五甲烯四氮唑的休克）。"}]},{"ID":"20240611173000-5gjzl87","Type":"NodeParagraph","Properties":{"id":"20240611173000-5gjzl87","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611173000-3b32yve","Type":"NodeParagraph","Properties":{"id":"20240611173000-3b32yve","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 根皮含芍药甙（paeonifolrin），氧化芍药甙（oxypaeoniflorin），苯甲酰芍药甙（benzoylpaeoniflorin），牡丹酚（paeonol），牡丹酚甙（paeonoside），牡丹酚原甙（paeonollide），牡丹酚新甙（apiopaeonoside），苯甲酰基氧化芍药甙（benxoyloxy-paeoniflorin ），2，3-二羟基-4-甲氧基苯乙酮（2，3-dihydroy-4-methoxyacetophenone），3-羟基-4-甲氧基苯乙酮（3-hydroxy-4-methoxyacetophenone），1,2,3,4,6-五没食子酰基葡萄糖（1，2，3，4，6-pentagalloylglucose）没食子酸（gallic acid）等。"}]},{"ID":"20240611173000-g7kh6kk","Type":"NodeParagraph","Properties":{"id":"20240611173000-g7kh6kk","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611173000-8nlahlq","Type":"NodeParagraph","Properties":{"id":"20240611173000-8nlahlq","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 1.对心血管的影响：牡丹皮对麻醉犬心能增加冠脉血流量，减少心输出量，降低左室作功的作用。对实验性心肌缺血有明显保护作用，并且持续时间较长，同时降低心肌耗氧量。丹皮煎剂，去牡丹酚后的煎剂1.0-3.0g／kg或牡丹酚80-120mg／kg静脉注射，对麻醉犬和大鼠均有降压作用。原发和肾型高血压犬，用牡丹皮煎剂5g／kg灌胃，连续5天，于第6天，第7天剂量增至10g／kg，血压明显下降。肾型高血压犬，用去牡丹酚后的煎剂10g/kg灌胃，连续10天血压下降。用牡丹酚0.5-1.0g／kg给肾型高血压犬和大鼠也出现一定的降压效果。牡丹酚能显着抑制正常心肌细胞快相（5分钟）和慢相（120分钟）45Ca摄取及搏动频率，显着抑制钙反常心肌细胞45Ca摄取和降低胞内过氧化脂质含量，且呈剂量依赖性，表明牡丹酚减轻钙反常损伤与阻止Ca2+内流及抗氧化有关。牡丹酚磺酸钠除能抑制钙离子摄取外，且能显着抑制钙反常心肌细胞的45Ca摄取及其胞膜SA含量，与剂量呈相关关系。另用食饵性动脉粥样硬化模型，研究牡丹酚的抗动脉粥样硬化作用。结果造型加牡丹酚组主动脉内膜病变肉眼定级及形态学组化分析，均比造型对照组显着减轻。表明腹腔注射牡丹酚100mg／kg·d，连续6周能明显抑制动脉粥样硬化斑块形成。"}]},{"ID":"20240611173000-yvxqk2e","Type":"NodeParagraph","Properties":{"id":"20240611173000-yvxqk2e","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"2.对中枢神经系统的影响：丹皮酚对口服伤寒、副伤寒菌苗引起的小鼠发热有解热作用，并降低正常小鼠体温。口服丹皮酚能抑制腹腔注射醋酸所致小鼠扭体反应及鼠尾压痛反应，并能对抗咖啡因所致小鼠的运动亢进，能明显延长环己巴比妥钠所致小鼠睡眠时间，大剂量时可使小鼠翻正反射消失，能明显对抗戊四氮、士的宁、烟碱和电休克所致的惊厥。作用部位在中脑网状结构和丘脑。"}]},{"ID":"20240611173000-2foxy9x","Type":"NodeParagraph","Properties":{"id":"20240611173000-2foxy9x","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"3.抗炎作用：用丹皮酚灌胃，对大鼠因右旋糖酐或醋酸或角叉菜胶引起的足跖浮肿有抑制作用，并能抑制醋酸或5-羟色胺引起的小鼠腹腔或豚鼠皮肤毛细血管通透性增强，抑制小鼠应激性溃疡的发生。实验证明丹皮水煎剂对角叉菜胶性浮肿、佐剂性关节炎及Arthus反应等所致多种炎症反应具有抑制作用，这与其抑制炎症组织的通透性和抑制PGE2的生物合成有关，丹皮不能抑制残存肾上腺的代偿性增生，对肾上腺维生素C的代谢也无明显影响，提示它既无类可的松样的作用，也无类促肾上腺皮质激素样作用，即其抗炎作用不依赖于垂体肾上腺系统。Ⅰ、Ⅱ、Ⅲ型变态反应是由特异性抗体介导的反应，丹皮对抗体的形成并无明显影响，但对之均有抑制作用，可能是通过非特异性抗炎机制发挥作用，而抑制血清补体活性，也就增强其抗炎效应。丹皮不抑制特异性抗体的产生，不影响补体旁路途径的溶血活性，提示牡丹皮在发挥抗炎作用的同时，不能抑制正常体液免疫功能。"}]},{"ID":"20240611173000-ivf60u2","Type":"NodeParagraph","Properties":{"id":"20240611173000-ivf60u2","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"4.抑菌作用：体外实验表明，牡丹皮煎剂对枯草杆菌、大肠杆菌、伤寒杆菌、副伤寒杆菌、变形杆菌、绿脓杆菌、葡萄球菌、溶血性链球菌、肺炎球菌、霍乱弧菌等均有较强的抗菌作用，牡丹叶煎剂对痢疾杆菌、绿脓杆菌和金黄色葡萄球菌有显着抗菌作用，其有效成份为没食子酸。鸡胚实验表明，牡丹皮煎剂对流感病毒有抑制作用，但小鼠治疗实验结果不一致，故其抗病毒效果尚不能肯定。有人对牡丹皮不同煎煮时间其水煎剂的抑菌成份对热稳定性关系进行探讨。提示牡丹皮经30分钟煎煮后体外抑菌能力明显优于煎剂时间为15分钟的水煎剂，而与煎煮时间为60、90分钟的水煎剂抑菌能力未见显着差异。"}]},{"ID":"20240611173000-cbdo4rc","Type":"NodeParagraph","Properties":{"id":"20240611173000-cbdo4rc","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"5.抗凝作用：体外对人血小板试验，发现牡丹皮水提物及芍药酚均能抑制血小板花生四烯酸产生血栓素A2，进而抑制血小板聚集，这是由于抑制从花生烯酸至前列腺H2的环氧化酶反应的结果。牡丹皮甲醇提取物有抑制内毒素所致实验性血栓的作用。研究表明，牡丹皮抗血栓形成的机理是：丹皮酚、苯甲酰芍药甙及苯甲酰氧化芍药甙抑制血小板凝聚，而丹皮酚、芍药甙、氧化芍药甙有抗调理素作用；苯甲酰芍药甙有阻断纤维蛋白溶酶原活化及抗纤维蛋白溶菌酶的作用；氧化芍药甙、苯甲酰氧化芍药甙，苯甲酰芍药甙对红的胞膜有较强的稳定作用，从而抑制血栓形成。用芍药甙给大鼠腹腔注射或在体外均能抑制ADP或胶原诱导的血小板聚集。"}]},{"ID":"20240611173000-fj58cyd","Type":"NodeParagraph","Properties":{"id":"20240611173000-fj58cyd","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"6.对免疫系统的影响：给小鼠分别灌胃牡丹皮，丹皮酚、芍药甙、氧化芍药甙、苯甲酰芍药甙，均能促进静脉注射的碳粒在血中的廓清速度，即使单核巨噬细胞系统功能处于低下状态也有促进作用，显微镜检查见肝中枯氏细胞及脾中巨噬细胞吞噬力增强。芍药甙、氧化芍药甙在体外亦能增强小鼠腹腔巨噬细胞对乳液的吞噬功能。丹皮液给小鼠腹腔注射能使其脾脏溶血后斑数增加。用丹皮酚给小鼠腹腔注射每大25mg／kg，连用6天，能使脾重明显增加，且可对抗考的松、环磷酰胺所致胸腺重量的减轻。由上可见牡丹皮对体液及细胞免疫均有增强作用。"}]},{"ID":"20240611173000-61ud2xf","Type":"NodeParagraph","Properties":{"id":"20240611173000-61ud2xf","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"7.对脂质代谢的影响：丹皮及其所含丹皮酚，芍药甙对肾上腺素所致的脂细胞的脂肪分解有抑制作用；丹皮水提物能增加脂细胞中葡萄糖生成脂肪，而且明显增加胰岛素所致的葡萄糖生成脂肪。"}]},{"ID":"20240611173000-xv9v7lo","Type":"NodeParagraph","Properties":{"id":"20240611173000-xv9v7lo","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"8.其它作用：用20%丹皮红藤灌入腹腔，对家兔损伤性腹腔粘连有显着预防效果。注入福氏佐剂引起的慢性关节炎鼠，在两个月内于大鼠皮下注射致炎剂酪蛋白，可引起关节炎性的足、尾的变性继续恶化，足、尾的皮下纤维化、骨增生，骨纤维症明显，腹部皮下组织中亦有结缔组织增殖，若在给予酶蛋白的同时连续喂饲牡丹皮或桂枝茯苓丸，则能抑制酶蛋白的新诱发损害。丹皮甲醇提取物体内对小鼠艾氏腹水癌细胞，子宫颈癌细胞均有抑制作用。丹皮酚对苯并芘在大鼠肝微粒体中的代谢有一定抑制作用，对小鼠有抗早孕作用，对大鼠有利尿作用。"}]},{"ID":"20240611173000-dyb30to","Type":"NodeParagraph","Properties":{"id":"20240611173000-dyb30to","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611173000-qx4lrx5","Type":"NodeParagraph","Properties":{"id":"20240611173000-qx4lrx5","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 牡丹皮：拣去杂质，除去木心，洗净，润透，切片，晾干。炒丹皮：将丹皮片入热锅内，不断翻炒至略有黄色焦斑时，取出，凉透。丹皮炭：取牡丹皮片入锅内，以武火炒至焦黑色，存性为度，喷淋清水，取出，凉透。"}]},{"ID":"20240611173000-5o20o98","Type":"NodeParagraph","Properties":{"id":"20240611173000-5o20o98","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611173000-tqqew2o","Type":"NodeParagraph","Properties":{"id":"20240611173000-tqqew2o","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末作微量升华，升华物在显微镜下观察，为长柱形结晶或针状、羽状簇晶，滴加三氯化铁醇溶液，则结晶溶解而显暗紫色。（检查牡丹酚）（2）取本品粉末2g，加乙醚20ml，振摇2min，滤过，取溶液5ml，置水浴上蒸干，放冷，残渣加硝酸数滴，先显棕黄色，后变鲜绿色。（牡丹酚的反应，芍药根皮粉末显黄色）（3）取本品粉末2g，置50m烧瓶中，加蒸馏水15ml，瓶口插有一玻璃导管的橡皮塞，加热煮沸，产生的蒸汽导人盛有氯亚胺基2，6-二氯苯醌试剂（取氯亚胺基2，6-二氯苯配0.1g，加硼砂3.2g，研磨均匀即得）0.1g与蒸馏水1ml中，2min内溶液显蓝色。（牡丹皮显蓝色，芍药根皮不显色）（4）取本品粉末0.15g，加无水乙醇25ml，振摇数分钟，滤过。取滤液lml，用无水乙醇稀释至25ml，在274nm的波长处有最大吸收。"}]},{"ID":"20240611173000-l5y3i8h","Type":"NodeParagraph","Properties":{"id":"20240611173000-l5y3i8h","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"（5）薄层色谱取本品粉末1g，加乙醚10ml，密塞，振摇10min，滤过，滤液挥干，残渣加丙酮2ml使溶解，作为供试品溶液。另取丹皮酚对照品加丙配制成每1ml含5mg的溶液，作为对照品溶液。吸取上述两种溶液各10μl，分别点于同一硅胶G薄层板上，以环己烷-醋酸乙酯（3:1）为展开剂，展开，取出，晾干，喷以盐酸酸性5％三氯化铁乙醇溶液，热风吹至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同的蓝褐色斑点。"}]},{"ID":"20240611173000-gs3isfd","Type":"NodeParagraph","Properties":{"id":"20240611173000-gs3isfd","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611173000-vn72x42","Type":"NodeParagraph","Properties":{"id":"20240611173000-vn72x42","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 心；肝；肾；肺经"}]},{"ID":"20240611173000-et96cmf","Type":"NodeParagraph","Properties":{"id":"20240611173000-et96cmf","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173000-cz5rtbj","Type":"NodeParagraph","Properties":{"id":"20240611173000-cz5rtbj","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 辛苦；凉；微寒"}]},{"ID":"20240611173000-y0fh3k6","Type":"NodeParagraph","Properties":{"id":"20240611173000-y0fh3k6","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611173000-xfodjb2","Type":"NodeParagraph","Properties":{"id":"20240611173000-xfodjb2","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 1.血虚有寒，孕妇及月经过多者慎服。"}]},{"ID":"20240611173000-slgasxe","Type":"NodeParagraph","Properties":{"id":"20240611173000-slgasxe","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：自汗多者勿用，为能走泄津液也。痘疹初起勿用，为其性专散血，不无根脚散阔之虑。"}]},{"ID":"20240611173000-kcc1c0w","Type":"NodeParagraph","Properties":{"id":"20240611173000-kcc1c0w","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"3.《得配本草》：胃气虚寒，相火衰者，勿用。"}]},{"ID":"20240611173000-6ulnuzm","Type":"NodeParagraph","Properties":{"id":"20240611173000-6ulnuzm","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173000-vwc5vhw","Type":"NodeParagraph","Properties":{"id":"20240611173000-vwc5vhw","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 清热；活血散瘀。主温热病热入血分；发斑；吐衄；热泪盈眶病菌后期热伏阴分发热；阴虚骨蒸潮热；血滞经闭；痛经；痈肿疮毒；跌扑伤痛；风湿热痹"}]},{"ID":"20240611173000-g13rkss","Type":"NodeParagraph","Properties":{"id":"20240611173000-g13rkss","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173000-x441s5l","Type":"NodeParagraph","Properties":{"id":"20240611173000-x441s5l","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g；或入丸、散。"}]},{"ID":"20240611173000-b2dapme","Type":"NodeParagraph","Properties":{"id":"20240611173000-b2dapme","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611173000-6vu07yy","Type":"NodeParagraph","Properties":{"id":"20240611173000-6vu07yy","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 1.张元素：牡丹皮，治神志不足，神不足者手少阴，志不足者足少阴，故仲景八味丸用之，能泻阴中之火。牡丹皮入手厥阴、足少阴，治无汗骨蒸；地骨皮（入）足少阴、手少阳，治有汗骨蒸也。牡丹皮治无汗之骨蒸，须与青蒿子、天麦门冬、沙参、地黄、五味子、牛膝、枸杞之属同用，始得其力。"}]},{"ID":"20240611173000-e3kyklu","Type":"NodeParagraph","Properties":{"id":"20240611173000-e3kyklu","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"2.李杲：心虚肠胃积热，心火炽甚，心气不足者，以牡丹皮为君。"}]},{"ID":"20240611173000-xrfg4lc","Type":"NodeParagraph","Properties":{"id":"20240611173000-xrfg4lc","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：牡丹皮，治手足少阴、厥阴四经血分伏火。盖伏火即阴火也，阴火即相火也，古方惟以此治相火，故仲景肾气丸用之。后人乃专以黄蘖治相火，不知丹皮之功更胜也。赤花者利，白花者补，人亦罕悟，宜分别之。"}]},{"ID":"20240611173000-e2o1cq0","Type":"NodeParagraph","Properties":{"id":"20240611173000-e2o1cq0","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：牡丹皮，其味苦而微辛，其气寒而无毒，辛以散结聚，苦寒除血热，入血分，凉血热之要药也。寒热者，阴虚血热之候也。中风瘛疭、痉、惊痫，皆阴虚内热，营血不足之故。热去则血凉，凉则新血生、阴气复，阴气复则火不炎而无因热生风之证矣，故悉主之。痈疮者，热壅血瘀而成也。凉血行血，故疗痈疮。辛能散血，苦能泻热，故能除血分邪气，及症坚瘀血留舍肠胃。脏属阴而藏精，喜清而恶热，热除则五脏自安矣。《别录》并主时气头痛客热，五劳劳气，头腰痛者，泄热凉血之功也。甄权又主经脉不通，血沥腰痛，此皆血因热而枯之候也。血中伏火，非此不除，故治骨蒸无汗，及小儿天行痘疮，血热。东垣谓心虚肠胃积热，心火炽甚，心气不足者，以牡丹皮为君，亦此意也。"}]},{"ID":"20240611173000-mb6lb5s","Type":"NodeParagraph","Properties":{"id":"20240611173000-mb6lb5s","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"5.《本草汇言》：沈拜可先生曰：按《深师方》用牡丹皮，同当归、熟地则补血；同莪术、桃仁则破血；同生地、芩、连则凉血；同肉桂、炮姜则暖血；同川芎、白芍药则调血；同牛膝、红花则活血；同枸杞、阿胶则生血；同香附、牛膝、归、芎，又能调气而和血。若夫阴中之火，非配知母、白芍药不能去；产后诸疾，非配归、芎、益母不能行。又欲顺气疏肝，和以青皮、柴胡；达痰开郁，和以贝母、半夏。若用于疡科排脓、托毒、凉血之际，必协乳香、没药、白芷、羌活、连翘、金银花辈，乃有济也。牡丹皮，清心，养肾，和肝，利包络，并治四经血分伏火。血中气药也。善治女人经脉不通，及产后恶血不止。又治衄血吐血，崩漏淋血，跌扑瘀血，凡一切血气为病，统能治之。盖其气香，香可以调气而行血；其味苦，苦可以下气而止血；其性凉，凉可以和血而生血；其味又辛，辛可以推陈血，而致新血也。故甄权方治女人血因热而将枯，腰脊疼痛，夜热烦渴，用四物重加牡丹皮最验。又古方用此以治相火攻冲，阴虚发热。又按《本经》主寒热，中风瘛疭、痉、惊痫邪气诸症，总属血分为眚。然寒热，中风，此指伤寒热入血室之中风，非指老人气虚痰厥之中风也。其文先之以寒热二字，继之以瘛疭惊痫可知已，况瘛疭、惊痫，正血得热而变现，寒热又属少阳所主者也。6.《本草正》：丹皮，赤者行性多，白者行性缓，总之，性味和缓，原无补性。但其微凉辛，能和血、凉血、生血，除烦热，善行血滞。滞去而郁热自解，故亦退热。用此者，用其行血滞而不峻。"}]},{"ID":"20240611173000-2ot54bh","Type":"NodeParagraph","Properties":{"id":"20240611173000-2ot54bh","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"7.《得配本草》：丹皮、川柏，皆除水中之火，然一清燥火，一降邪火，判不相合。盖肾恶燥，燥则水不归元，宜用辛以润之，凉以清之，丹皮为力；肾欲坚，以火伤之则不坚，宜从其性以补之，川柏为使。"}]},{"ID":"20240611173000-qf2dkcn","Type":"NodeParagraph","Properties":{"id":"20240611173000-qf2dkcn","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"8.《本草求真》：世人专以黄柏治相火，而不知丹皮之功更胜。盖黄柏苦寒而燥，初则伤胃，久则伤阳，苦燥之性徒存，而补阴之功绝少，丹皮能泻阴中之火，使火退而阴生，所以入足少阴而佐滋补之用，较之黄柏不啻霄壤矣。"}]},{"ID":"20240611173000-now53wt","Type":"NodeParagraph","Properties":{"id":"20240611173000-now53wt","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"9.重庆堂随笔》：丹皮虽非热药，而气香味辛，为血中气药，专于行血破瘀，故能堕胎，消癖。所谓能止血者，瘀去则新血自安，非丹皮真能止血也。血虚而感风寒者，可用以发汗，若无瘀而血热妄行，及血虚而无外感者，皆不可用，惟入于养阴剂中，则阴药借以宣行而不滞，并可收其凉血之功，故阴虚热入血分而患赤痢者，最为妙品。然气香而浊，极易作呕，胃弱者服之即吐。诸家《本草》皆未言及，用者审之。"}]},{"ID":"20240611173000-qn3zj0b","Type":"NodeParagraph","Properties":{"id":"20240611173000-qn3zj0b","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"10.《本经疏证》：牡丹皮入心，通血脉中壅滞与桂枝颇同，特桂枝气温，故所通者血脉中寒滞，牡丹皮气寒，故所通者血脉中热结。"}]},{"ID":"20240611173000-qekcpr5","Type":"NodeParagraph","Properties":{"id":"20240611173000-qekcpr5","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"11.《神农本草经》：主寒热，中风瘛疭、痉、惊痫邪气，除症坚瘀血留舍肠胃，安五脏，疗痈疮。12.《名医别录》：除时气头痛，客热五劳，劳气头腰痛，风噤，癫疾。"}]},{"ID":"20240611173000-c1c4ybe","Type":"NodeParagraph","Properties":{"id":"20240611173000-c1c4ybe","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"13.《药性论》：治冷气，散诸痛，治女子经脉不通，血沥腰疼。"}]},{"ID":"20240611173000-9b002g8","Type":"NodeParagraph","Properties":{"id":"20240611173000-9b002g8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"14.《日华子本草》：除邪气，悦色，通关腠血脉，排脓，通月经，消扑损瘀血，续筋骨，除风痹，落胎下胞，产后一切冷热血气。"}]},{"ID":"20240611173000-60pl6cy","Type":"NodeParagraph","Properties":{"id":"20240611173000-60pl6cy","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"15.《珍珠囊》：治肠胃积血、衄血、吐血，无汗骨蒸。"}]},{"ID":"20240611173000-05i2too","Type":"NodeParagraph","Properties":{"id":"20240611173000-05i2too","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"16.《滇南本草》：破血，行（血）消症瘕之疾，除血分之热。"}]},{"ID":"20240611173000-stvr6w8","Type":"NodeParagraph","Properties":{"id":"20240611173000-stvr6w8","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"17.《医学入门》：泻伏火，养真血气，破结蓄。"}]},{"ID":"20240611173000-4rwvmo3","Type":"NodeParagraph","Properties":{"id":"20240611173000-4rwvmo3","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"18.《本草纲目》：和血，生血，凉血。治血中伏火，除烦热。"}]},{"ID":"20240611173000-1um1o4m","Type":"NodeParagraph","Properties":{"id":"20240611173000-1um1o4m","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173000-77ojp6o","Type":"NodeParagraph","Properties":{"id":"20240611173000-77ojp6o","updated":"20240611173000"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611172859-t8zre22","Type":"NodeThematicBreak","Properties":{"id":"20240611172859-t8zre22"}},{"ID":"20240611172900-b2mlsw8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172900-b2mlsw8","updated":"20240611172903"},"Children":[{"Type":"NodeText","Data":"牡丹《本草衍义》"}]},{"ID":"20240611172900-61eqag8","Type":"NodeParagraph","Properties":{"id":"20240611172900-61eqag8","updated":"20240611172900"},"Children":[{"Type":"NodeText","Data":"用其根上皮。花亦有绯者，如西洛潜溪绯是也。今禁苑又有深碧色者。惟山中单叶花红者为佳，家 子次之。若移枝接者不堪用，为其花叶既多发，夺根之气也。何以知之？今千叶牡丹，初春留花稍多，来年花枝并叶便瘦，多是开不成。市人或以枝梗皮售于人，其乖殊甚。"}]},{"ID":"20240611172846-akxttj7","Type":"NodeThematicBreak","Properties":{"id":"20240611172846-akxttj7"}},{"ID":"20240611172847-0sumqof","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172847-0sumqof","updated":"20240611172852"},"Children":[{"Type":"NodeText","Data":"牡丹《证类本草》"}]},{"ID":"20240611172847-2g8zwy7","Type":"NodeParagraph","Properties":{"id":"20240611172847-2g8zwy7","updated":"20240611172847"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，无毒。主寒热，中风螈（音契） （音纵），痉、惊痫邪气，除症坚，瘀血留舍肠胃，安五脏，疗痈疮，除时气，头痛，客热，五劳，劳气，头、腰痛，风噤。癫疾。一名鹿韭，一名鼠姑。生巴郡山谷及汉中。二月、八月采根，阴干。（畏菟丝子。）"}]},{"ID":"20240611172847-yg0m6os","Type":"NodeParagraph","Properties":{"id":"20240611172847-yg0m6os","updated":"20240611172847"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今东间亦有。色赤者为好，用之去心。按∶鼠妇亦名鼠姑，而此又同，殆非其类，恐字误。唐本注云∶牡丹，生汉中。剑南所出者苗似羊桃，夏生白花，秋实圆绿，冬实赤色，凌冬不凋。根似芍药，肉白皮丹。出江、剑南，土人谓之牡丹，亦名百两金，京下谓之吴牡丹者，是真也。今俗用者异于此，别有臊气也。臣禹锡等谨按药性论∶牡丹，能治冷气，散诸痛，治女子经脉不通，血沥腰疼。萧炳云∶今出合州者佳。白者补，赤者利。出和州、宣州者并良。日华子云∶除邪气，悦色，通关腠血脉，排脓，通月经，消扑损瘀血，续筋骨，除风痹，落胎下胞，产后一切女人冷热血气。此便是牡丹花根。巴、蜀、渝、合州者上，海盐者次。服忌蒜。"}]},{"ID":"20240611172847-tl98goh","Type":"NodeParagraph","Properties":{"id":"20240611172847-tl98goh","updated":"20240611172847"},"Children":[{"Type":"NodeText","Data":"图经曰∶牡丹，生巴郡山谷及汉中，今丹、延、青、越、滁、和州山中皆有之。花有黄、紫、红、白数色，此当是山牡丹。其茎便枯燥，黑白色，二月于梗上生苗叶，三月开花。其花、叶与人家所种者相似，但花只五、六叶耳。五月结子黑色，如鸡头子大。根黄白色，可五、七寸长，如笔管大。二月、八月采，铜刀劈去骨，阴干用。此花一名木芍药。近世人多贵重。圃人欲其花诡异，皆秋冬移接，培以壤土，至春盛开，其状百变。故其根性殊失本真，药中不可用此品，绝无力也。牡丹主血，乃去瘀滞。《正元广利方》∶疗因伤损血瘀不散者，取牡丹皮八分，合虻虫二十一枚，熬过同捣筛，每旦温酒和散方寸匕服，血当化为水下。"}]},{"ID":"20240611172847-xfshipc","Type":"NodeParagraph","Properties":{"id":"20240611172847-xfshipc","updated":"20240611172847"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，采得后日干，用铜刀劈破去骨了，细锉如大豆许，用清酒拌蒸，从巳至未，出，日干用，外台秘要∶治蛊毒方∶取牡丹根捣为末，服一钱匕，日三服，良。肘后方∶下部生疮已决洞者。服牡丹方寸匕，日三服。"}]},{"ID":"20240611172847-v9wuwho","Type":"NodeParagraph","Properties":{"id":"20240611172847-v9wuwho","updated":"20240611172847"},"Children":[{"Type":"NodeText","Data":"衍义曰∶牡丹，用其根上皮。花亦有绯者，如西洛潜溪绯是也。今禁苑又有深碧色者。"}]},{"ID":"20240611172847-soamcn4","Type":"NodeParagraph","Properties":{"id":"20240611172847-soamcn4","updated":"20240611172847"},"Children":[{"Type":"NodeText","Data":"唯山中单叶花红者为佳，家 子次之。若移枝接者不堪用，为其花叶既多发，夺根之气也。何以知之？今千叶牡丹，初春留花稍多，来年花枝并叶便瘦。多是开不成。市人或以枝梗皮售于人，其乖殊甚。"}]},{"ID":"20240611172756-m2xx4c1","Type":"NodeThematicBreak","Properties":{"id":"20240611172756-m2xx4c1"}},{"ID":"20240611172757-d9duf83","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172757-d9duf83","updated":"20240611172802"},"Children":[{"Type":"NodeText","Data":"牡丹《神农本草经百种录》"}]},{"ID":"20240611172757-q3isgyd","Type":"NodeParagraph","Properties":{"id":"20240611172757-q3isgyd","updated":"20240611172757"},"Children":[{"Type":"NodeText","Data":"味辛寒。主寒热，中风 、痉，惊痫邪气，皆肝气所发之疾。除症坚，瘀血留舍肠胃，色赤走血，气香能消散也。安五脏，五脏皆血气所留止，血气和则无不利矣。疗痈疮。"}]},{"ID":"20240611172757-2u88403","Type":"NodeParagraph","Properties":{"id":"20240611172757-2u88403","updated":"20240611172757"},"Children":[{"Type":"NodeText","Data":"清血家之毒火。"}]},{"ID":"20240611172757-6moi8wb","Type":"NodeParagraph","Properties":{"id":"20240611172757-6moi8wb","updated":"20240611172757"},"Children":[{"Type":"NodeText","Data":"牡丹为花中之王，乃木气之最荣泽者，故能舒养肝气，和通经脉，与芍药功颇近。但芍药微主敛，而牡丹微主散，则以芍药味胜，牡丹气胜。味属阴，而气属阳也。"}]},{"ID":"20240611172658-a7i0w8j","Type":"NodeThematicBreak","Properties":{"id":"20240611172658-a7i0w8j"}},{"ID":"20240611172700-yfdhvqx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172700-yfdhvqx","updated":"20240611172704"},"Children":[{"Type":"NodeText","Data":"牡丹《本草图经》"}]},{"ID":"20240611172700-2v3c7nx","Type":"NodeParagraph","Properties":{"id":"20240611172700-2v3c7nx","updated":"20240611173205"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"牡丹"},{"Type":"NodeText","Data":"，生巴郡山谷及汉中，今丹、延、青、越、滁、和州山中皆有之。"}]},{"ID":"20240611172700-8l0laro","Type":"NodeParagraph","Properties":{"id":"20240611172700-8l0laro","updated":"20240611172700"},"Children":[{"Type":"NodeText","Data":"花有黄、紫、红、白数色，此当是山牡丹。其茎梗枯燥黑白色，二月于梗上生苗叶，三月开花；其花叶与人家所种者相似，但花只五、六叶耳；五月结子黑色，如鸡头子大；根黄白色，可五、七寸长，如笔管大。二月、八月采，铜刀劈去骨，阴干用。此花一名木芍药，近世人多贵重，圃人欲其花之诡异，皆秋冬移接，培以壤土，至春盛开，其状百变。故其根性殊失本真，药中不可用此品，绝无力也。牡丹主血，乃去瘀滞。《正元广利方》疗因伤损血瘀不散者，取牡丹皮八分，合虻虫二十一枚，熬过同捣筛，每旦温酒和散，方寸匕服，血当化为水下。"}]},{"ID":"20240611172724-6ocaduy","Type":"NodeThematicBreak","Properties":{"id":"20240611172724-6ocaduy"}},{"ID":"20240611172725-z61hf1m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172725-z61hf1m","updated":"20240611172735"},"Children":[{"Type":"NodeText","Data":"牡丹《本草经集注》"}]},{"ID":"20240611172725-oc28lzo","Type":"NodeParagraph","Properties":{"id":"20240611172725-oc28lzo","updated":"20240611172725"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，无毒。主治寒热，中风，螈 ，痉，惊痫，邪气，除症坚，瘀血留舍肠胃，安五脏，治痈疮。除时气，头痛，客热，五劳，劳气，头腰痛，风噤，癫疾。一名鹿韭，一名鼠姑。生巴郡山谷及汉中，二月、八月采根，阴干。（畏菟丝子、贝母、大今东间亦有，色赤者为好，用之去心。按鼠妇亦名鼠姑，而此又同，殆非其类，恐字误。"}]},{"ID":"20240611172708-ct32mhs","Type":"NodeThematicBreak","Properties":{"id":"20240611172708-ct32mhs"}},{"ID":"20240611172709-st9o3y2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172709-st9o3y2","updated":"20240611172713"},"Children":[{"Type":"NodeText","Data":"牡丹《神农本草经赞》"}]},{"ID":"20240611172709-i0hatb8","Type":"NodeParagraph","Properties":{"id":"20240611172709-i0hatb8","updated":"20240611172709"},"Children":[{"Type":"NodeText","Data":"味辛寒。主寒热。中风。螈痉惊痫。邪气。除症坚。瘀血留舍肠胃。安五脏。疗痈创。一名鹿韭。一名鼠妇。生山谷。"}]},{"ID":"20240611172709-2eerdav","Type":"NodeParagraph","Properties":{"id":"20240611172709-2eerdav","updated":"20240611172709"},"Children":[{"Type":"NodeText","Data":"百两精金。丹延植盛。荆棘同俦。琅是竞。艳思移姿。真香失性。枯燥形全。四经顺令。"}]},{"ID":"20240611172709-fj9e8yh","Type":"NodeParagraph","Properties":{"id":"20240611172709-fj9e8yh","updated":"20240611172709"},"Children":[{"Type":"NodeText","Data":"陶弘景曰。土人谓之百两金。李时珍曰。丹州延州以西。及褒斜道中最多。与荆棘无异。"}]},{"ID":"20240611172709-mpka5t1","Type":"NodeParagraph","Properties":{"id":"20240611172709-mpka5t1","updated":"20240611172709"},"Children":[{"Type":"NodeText","Data":"其根入药最良。白居易诗。根本是琅。苏颂曰。世人欲花之诡异。秋冬移接。培以壤土。至春盛开。其状百变。其根性殊失本真。不可入药。温庭筠诗。裁成艳思偏应巧。苏轼诗。真香亦竟空。苏颂曰。山牡丹。茎梗枯燥。李时珍曰。治手足少阴厥阴四经伏火。"}]},{"ID":"20240611172641-ziapvuh","Type":"NodeThematicBreak","Properties":{"id":"20240611172641-ziapvuh"}},{"ID":"20240611172643-0etz94x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172643-0etz94x","updated":"20240611172653"},"Children":[{"Type":"NodeText","Data":"牡丹《新修本草》"}]},{"ID":"20240611172643-dyc2fw8","Type":"NodeParagraph","Properties":{"id":"20240611172643-dyc2fw8","updated":"20240611172643"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，无毒。主寒热，中风，螈 ，痉，惊痫，邪气，除症坚瘀血留舍肠胃，安五脏，疗痈疮。除时气，头痛，客热，五劳，劳气，头腰痛，风噤，癫疾。一名鹿韭，一名鼠姑。生巴郡山谷及汉中，二月、八月采根，阴干。"}]},{"ID":"20240611172643-p1v3dsu","Type":"NodeParagraph","Properties":{"id":"20240611172643-p1v3dsu","updated":"20240611172643"},"Children":[{"Type":"NodeText","Data":"畏菟丝子、贝母、大黄。今东间亦有，色赤者为好，用之去心。按鼠妇亦名鼠姑，而此又同，殆非其类，恐字误。"}]},{"ID":"20240611172643-uvpxle2","Type":"NodeParagraph","Properties":{"id":"20240611172643-uvpxle2","updated":"20240611172643"},"Children":[{"Type":"NodeText","Data":"〔谨案〕牡丹，生汉中。剑南所出者，苗似羊桃，夏生白花，秋实凋，根似芍药，肉白皮丹。"}]},{"ID":"20240611172643-b4cgbce","Type":"NodeParagraph","Properties":{"id":"20240611172643-b4cgbce","updated":"20240611172643"},"Children":[{"Type":"NodeText","Data":"出汉、剑南，土人谓之牡丹，亦名百两金，京下谓之吴牡丹者，是真也。今俗用者，异于此，别有臊气也。"}]},{"ID":"20240611172415-3rwpagl","Type":"NodeThematicBreak","Properties":{"id":"20240611172415-3rwpagl"}},{"ID":"20240611172424-1botwr3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172424-1botwr3","updated":"20240611172428"},"Children":[{"Type":"NodeText","Data":"牡丹《本草纲目》"}]},{"ID":"20240611172424-c4na9ki","Type":"NodeParagraph","Properties":{"id":"20240611172424-c4na9ki","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"「释名」鼠姑、鹿韭、百两金、木芍药、花王。"}]},{"ID":"20240611172424-h8lyqlr","Type":"NodeParagraph","Properties":{"id":"20240611172424-h8lyqlr","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"「气味」（根皮）辛、寒、无毒。"}]},{"ID":"20240611172424-lyuzq82","Type":"NodeParagraph","Properties":{"id":"20240611172424-lyuzq82","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611172424-66i13r9","Type":"NodeParagraph","Properties":{"id":"20240611172424-66i13r9","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"1、疝气（觉气胀不能动）。用牡丹皮、防风，等分为末，每服二钱，酒送下。"}]},{"ID":"20240611172424-37jym30","Type":"NodeParagraph","Properties":{"id":"20240611172424-37jym30","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"2、妇女恶血（血往上冲，脸红易怒）。用牡丹皮半两、干漆（烧至烟尽）半两，加水二杯，煎成一杯服下。"}]},{"ID":"20240611172424-fx86huz","Type":"NodeParagraph","Properties":{"id":"20240611172424-fx86huz","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"3、伤损瘀血。用牡丹皮二两、虻虫二十一个（熬过），同捣碎。每天早晨服一匙，温酒送下。"}]},{"ID":"20240611172424-5vft1qq","Type":"NodeParagraph","Properties":{"id":"20240611172424-5vft1qq","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"4、刀伤后内出血。用牡丹皮研细，水冲服少许。瘀血自尿中排出。"}]},{"ID":"20240611172424-2icseg1","Type":"NodeParagraph","Properties":{"id":"20240611172424-2icseg1","updated":"20240611172424"},"Children":[{"Type":"NodeText","Data":"5、下部生疮（已破口）。取牡丹末一匙煎服。一天三次。"}]},{"ID":"20240611172424-tnj7phf","Type":"NodeThematicBreak","Properties":{"id":"20240611172424-tnj7phf"}},{"ID":"20240611172744-1q1odqs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172744-1q1odqs","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：牡丹花"}]},{"ID":"20240611172744-yyfxm6p","Type":"NodeParagraph","Properties":{"id":"20240611172744-yyfxm6p","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611172744-w10rkq9","Type":"NodeParagraph","Properties":{"id":"20240611172744-w10rkq9","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" Mǔ Dān Huā"}]},{"ID":"20240611172744-pbxrox2","Type":"NodeParagraph","Properties":{"id":"20240611172744-pbxrox2","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611172744-50ucjel","Type":"NodeParagraph","Properties":{"id":"20240611172744-50ucjel","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 《民间常用草药汇编》"}]},{"ID":"20240611172744-zutcb7j","Type":"NodeParagraph","Properties":{"id":"20240611172744-zutcb7j","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611172744-018ncck","Type":"NodeParagraph","Properties":{"id":"20240611172744-018ncck","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 为毛茛科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牡丹"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611172744-j5ckwjk","Type":"NodeParagraph","Properties":{"id":"20240611172744-j5ckwjk","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611172744-dyz07e7","Type":"NodeParagraph","Properties":{"id":"20240611172744-dyz07e7","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 花瓣含黄芪甙。"}]},{"ID":"20240611172744-9wtpil1","Type":"NodeParagraph","Properties":{"id":"20240611172744-9wtpil1","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611172744-pags1fq","Type":"NodeParagraph","Properties":{"id":"20240611172744-pags1fq","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 《四川中药志》：\"性平，味苦淡，无毒。\""}]},{"ID":"20240611172744-yjdxo5a","Type":"NodeParagraph","Properties":{"id":"20240611172744-yjdxo5a","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611172744-1fmq62j","Type":"NodeParagraph","Properties":{"id":"20240611172744-1fmq62j","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" ①《民间常用草药汇编》：\"调经活血。\""}]},{"ID":"20240611172744-aik7vba","Type":"NodeParagraph","Properties":{"id":"20240611172744-aik7vba","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"②《四川中药志》：\"治妇女月经不调，经行腹痛。\""}]},{"ID":"20240611172744-1i2ukhh","Type":"NodeParagraph","Properties":{"id":"20240611172744-1i2ukhh","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611172744-9ypbaj7","Type":"NodeParagraph","Properties":{"id":"20240611172744-9ypbaj7","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱。"}]},{"ID":"20240611172744-ka5owq7","Type":"NodeParagraph","Properties":{"id":"20240611172744-ka5owq7","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611172744-ii3tc4b","Type":"NodeParagraph","Properties":{"id":"20240611172744-ii3tc4b","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611172744-ny7f635","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611172744-ny7f635","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"《中华本草》：牡丹花"}]},{"ID":"20240611172744-yimyo6t","Type":"NodeParagraph","Properties":{"id":"20240611172744-yimyo6t","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611172744-2fna78y","Type":"NodeParagraph","Properties":{"id":"20240611172744-2fna78y","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" Mǔ Dān Huā"}]},{"ID":"20240611172744-wwxpv9t","Type":"NodeParagraph","Properties":{"id":"20240611172744-wwxpv9t","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611172744-lwhg02s","Type":"NodeParagraph","Properties":{"id":"20240611172744-lwhg02s","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" Tree Peony flower, flower of Subshrubby Peony"}]},{"ID":"20240611172744-luedpuu","Type":"NodeParagraph","Properties":{"id":"20240611172744-luedpuu","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611172744-sr6eohm","Type":"NodeParagraph","Properties":{"id":"20240611172744-sr6eohm","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 出自《民间常用草药汇编》。"}]},{"ID":"20240611172744-uxtzd4q","Type":"NodeParagraph","Properties":{"id":"20240611172744-uxtzd4q","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611172744-yqhspjc","Type":"NodeParagraph","Properties":{"id":"20240611172744-yqhspjc","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芍药科植物牡丹Paeonia suffruticosa Andr.的花。"}]},{"ID":"20240611172744-yb9y4c4","Type":"NodeParagraph","Properties":{"id":"20240611172744-yb9y4c4","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Paeonia suffruticosa Andr."}]},{"ID":"20240611172744-oydyqg5","Type":"NodeParagraph","Properties":{"id":"20240611172744-oydyqg5","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611172744-8rfdbyw","Type":"NodeParagraph","Properties":{"id":"20240611172744-8rfdbyw","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 全国各地多有栽培观赏。"}]},{"ID":"20240611172744-baohcdt","Type":"NodeParagraph","Properties":{"id":"20240611172744-baohcdt","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611172744-h9lvk9g","Type":"NodeParagraph","Properties":{"id":"20240611172744-h9lvk9g","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 牡丹 落叶小灌木，高1-2m。根粗大。茎直立，枝粗壮，树皮黑灰色。叶互生，纸质；叶柄长5-11cm，无毛；叶通常为二回三出复叶，或二回羽状复叶，近技项的叶为三小叶，顶生小叶常深3裂，长7-8cm，宽5.5-7cm，裂片2-3浅裂或不裂，上面绿色，无毛，下面淡绿色，有时被白粉，沿叶脉疏被短柔毛或近无毛，小叶柄长1.2-3cm；侧生小叶狭卵形或长圆状卵形，长4.5-6.5cm，宽2.5-4cm，2-3浅裂或不裂，近无柄。花两性，单生枝项，直径10-20cm；花梗长4-6cm；苞片5，长椭圆形，大小不等；萼片5，宽卵形，大小不等，绿色，宿存；花瓣5，或为重瓣，倒卵形，长5-8cm，宽4.2-6cm，先端呈不规则的波状，紫色、红色、粉红色、玫瑰色、黄色、豆绿色或白色，变异很大；雄蕊多数，长l-1.7cm，花丝亦具紫红等色，花药黄色；花盘杯状，草质，顶端有数个锐齿或裂片，完全包裹心皮，在心皮成熟时裂开；心皮5，稀更多，离生，绿色，密被柔毛。蓇葖果长圆形，腹缝线开裂，密被黄褐色硬毛。花期4-5月，果期6-7月。"}]},{"ID":"20240611172744-p7xf6qd","Type":"NodeParagraph","Properties":{"id":"20240611172744-p7xf6qd","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611172744-880juqv","Type":"NodeParagraph","Properties":{"id":"20240611172744-880juqv","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 牡丹花主要含紫云英甙（astragalin）。还含牡丹花甙（paeonin），蹄纹天竺甙（pelargonin）。"}]},{"ID":"20240611172744-xcck2q4","Type":"NodeParagraph","Properties":{"id":"20240611172744-xcck2q4","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611172744-s0p9yxp","Type":"NodeParagraph","Properties":{"id":"20240611172744-s0p9yxp","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240611172744-zayb5g2","Type":"NodeParagraph","Properties":{"id":"20240611172744-zayb5g2","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611172744-ig69fzd","Type":"NodeParagraph","Properties":{"id":"20240611172744-ig69fzd","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 苦；淡；平"}]},{"ID":"20240611172744-s56unxk","Type":"NodeParagraph","Properties":{"id":"20240611172744-s56unxk","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611172744-1mng5a7","Type":"NodeParagraph","Properties":{"id":"20240611172744-1mng5a7","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 活血调经。主妇女月经不调；经行腹痛"}]},{"ID":"20240611172744-h14w05w","Type":"NodeParagraph","Properties":{"id":"20240611172744-h14w05w","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611172744-0c7zjwf","Type":"NodeParagraph","Properties":{"id":"20240611172744-0c7zjwf","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g。"}]},{"ID":"20240611172744-hn9c255","Type":"NodeParagraph","Properties":{"id":"20240611172744-hn9c255","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611172744-ohi6a66","Type":"NodeParagraph","Properties":{"id":"20240611172744-ohi6a66","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 1.《民间常用草药汇编》：调经活血。"}]},{"ID":"20240611172744-7k0r3m6","Type":"NodeParagraph","Properties":{"id":"20240611172744-7k0r3m6","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"2.《四川中药志》：治妇女月经不调，经行腹痛。"}]},{"ID":"20240611172744-169euhy","Type":"NodeParagraph","Properties":{"id":"20240611172744-169euhy","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611172744-w480tc8","Type":"NodeParagraph","Properties":{"id":"20240611172744-w480tc8","updated":"20240611172744"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611172745-nvrvnym","Type":"NodeThematicBreak","Properties":{"id":"20240611172745-nvrvnym"}},{"ID":"20240611172746-2lexsp1","Type":"NodeParagraph","Properties":{"id":"20240611172746-2lexsp1"}}]}