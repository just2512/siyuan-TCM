en":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"连翘 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/连翘 7-20240826084725-h0fis6m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 327px;\" parent-style=\"width: 337px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240701152031-re58y5v","Type":"NodeParagraph","Properties":{"id":"20240701152031-re58y5v","updated":"20240826084634"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1117px;","style":"width: 1107px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"连翘树3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/连翘树3-20240701152026-wh8jwdc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1107px;\" parent-style=\"width: 1117px;\"}"},{"Type":"NodeText","Data":"​​​​​​​​"}]},{"ID":"20240613111707-38716q7","Type":"NodeThematicBreak","Properties":{"id":"20240613111707-38716q7","updated":"20240613111707"}},{"ID":"20240613111707-41zfinx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111707-41zfinx","updated":"20240613111707"},"Children":[{"Type":"NodeText","Data":"连翘《神农本草经》"}]},{"ID":"20240613111707-jeu76jx","Type":"NodeParagraph","Properties":{"id":"20240613111707-jeu76jx","updated":"20240613111707"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240613111707-giwx729","Type":"NodeParagraph","Properties":{"id":"20240613111707-giwx729","updated":"20240613111707"},"Children":[{"Type":"NodeText","Data":"主寒热，鼠瘘，瘰疬，痈肿，恶创，瘿瘤，结热，蛊毒。一名异翘，一名兰华，一名轵，一名三廉。生山谷。"}]},{"ID":"20240613111707-oknirop","Type":"NodeParagraph","Properties":{"id":"20240613111707-oknirop","updated":"20240613111707"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名折根，生太山，八月采，阴干。"}]},{"ID":"20240613111707-7fpxu3a","Type":"NodeParagraph","Properties":{"id":"20240613111707-7fpxu3a","updated":"20240613111707"},"Children":[{"Type":"NodeText","Data":"案《尔雅》云：连，异翘。郭璞云：一名连苕，又名连本草云。"}]},{"ID":"20240613111556-uf676ez","Type":"NodeThematicBreak","Properties":{"id":"20240613111556-uf676ez"}},{"ID":"20240613111641-gd8kr7c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111641-gd8kr7c","updated":"20240613111651"},"Children":[{"Type":"NodeText","Data":"连翘《本草简要方》"}]},{"ID":"20240613111641-i4zzzdj","Type":"NodeParagraph","Properties":{"id":"20240613111641-i4zzzdj","updated":"20240613111641"},"Children":[{"Type":"NodeText","Data":"根茎壳功效略同。而用壳为多。主治泻火清热消肿排脓。止痛。利水。妇人月经不瘰痈肿疮疖。凡热证不属虚火者。均可用之。连槐散。连翘槐角黄连阿胶山楂神曲角各等分。研末。每用少许置掌中。时时舐之。津液润下。治血结。连翘丸。连翘桑白头翁丹皮防风黄柏桂心香豉独活秦艽各一两。海藻五钱。研末蜜丸小豆大。灯心汤下。治儿无故寒热。强健如故。而身体颈项结核瘰。及心腹胁背里有坚核不痛。三岁儿每服五丸。"}]},{"ID":"20240613111641-bgdrhiq","Type":"NodeParagraph","Properties":{"id":"20240613111641-bgdrhiq","updated":"20240613111641"},"Children":[{"Type":"NodeText","Data":"加至十丸。五岁以上酌加。连翘赤小豆汤。连翘赤小豆麻黄甘草生姜生梓白皮各二两四十一粒。大枣十二枚。锉散。每服二钱。水煎服。治小儿伤寒发热身黄。连翘败毒散。连翘羌活独活荆芥防风柴胡升麻桔梗甘草川芎牛蒡子（新瓦上炒研碎）当归尾（酒洗）藏红花（酒洗）苏木天花粉等。水与好酒各一杯。同煎至半。去滓徐徐温服。治发颐初肿。及一切痈疽初发。憎寒壮热。甚者头痛拘急状似伤寒。如未消。加穿山甲（蛤粉炒）一钱。肿至面者加香白芷一钱。漏芦五分。大便燥实者加大黄（酒浸）一钱五分。壮者倍之。内热或寒热交作者。"}]},{"ID":"20240613111641-boegqn9","Type":"NodeParagraph","Properties":{"id":"20240613111641-boegqn9","updated":"20240613111641"},"Children":[{"Type":"NodeText","Data":"倍柴胡。加黄芩（酒洗）黄连（酒炒）各一钱。连翘散。连翘一两。沉香黄各五钱。"}]},{"ID":"20240613111641-12pufz4","Type":"NodeParagraph","Properties":{"id":"20240613111641-12pufz4","updated":"20240613111641"},"Children":[{"Type":"NodeText","Data":"朴硝大黄（炮）甘草各一分捣碎。每服一钱。水一盏。入麝香一厘。煎至五分去滓食后温服。治痈疖。又方。连翘葛根赤芍黄芩栀子桔梗升麻麦冬甘草木通牛蒡子水煎服。治痰饮连翘当归栝蒌根生干地荆芥黄芩赤芍麦冬瞿麦木通牛蒡子（炒）。山栀子防风川分。咀。每服四钱。水一盏半。加灯心十二茎。煎至八分。去滓服。治诸恶疮红赤肿胀。"}]},{"ID":"20240613111641-wu1sc7k","Type":"NodeParagraph","Properties":{"id":"20240613111641-wu1sc7k","updated":"20240613111641"},"Children":[{"Type":"NodeText","Data":"心烦口干。及妇人血风成疮。痒痛溃烂。流黄水。"}]},{"ID":"20240613111629-gn28uln","Type":"NodeThematicBreak","Properties":{"id":"20240613111629-gn28uln"}},{"ID":"20240613111630-9s0mtm9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111630-9s0mtm9","updated":"20240613111635"},"Children":[{"Type":"NodeText","Data":"连翘《本草求真》"}]},{"ID":"20240613111630-6zlmflt","Type":"NodeParagraph","Properties":{"id":"20240613111630-6zlmflt","updated":"20240613111630"},"Children":[{"Type":"NodeText","Data":"（隰草）解心经热邪"}]},{"ID":"20240613111630-5k2mls4","Type":"NodeParagraph","Properties":{"id":"20240613111630-5k2mls4","updated":"20240613111630"},"Children":[{"Type":"NodeText","Data":"连翘（专入心）。味苦微寒。质轻而浮。书虽载泻六经郁火。然其轻清气浮。实为泻心要剂。（连翘形像似心。但开有瓣。）心为火主。心清则诸脏与之皆清矣。然湿热不除。病症百出。是以痈毒五淋。寒热鼠 。瘰 恶疮。热结蛊毒等症。书载皆能以治。（汪昂曰。凡痈而痛者为实邪。肿而不痛为虚邪。肿而赤者为热结。肿而不结者为留气痰饮。）且经有言。诸痛疮疡。皆属心火。连翘实为疮家圣药也。然多用胃虚食少。脾胃不足者慎之。况清而无补。痈疽溃后勿服。火热由于虚者忌投。"}]},{"ID":"20240613111556-ymscoj3","Type":"NodeThematicBreak","Properties":{"id":"20240613111556-ymscoj3"}},{"ID":"20240613111619-b9quxf9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111619-b9quxf9","updated":"20240613111624"},"Children":[{"Type":"NodeText","Data":"连翘《汤液本草》"}]},{"ID":"20240613111619-xgtdifx","Type":"NodeParagraph","Properties":{"id":"20240613111619-xgtdifx","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"气平，味苦。苦，微寒，气味俱轻，阴中阳也，无毒。"}]},{"ID":"20240613111619-1tl26am","Type":"NodeParagraph","Properties":{"id":"20240613111619-1tl26am","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"手足少阳经、阳明经药。"}]},{"ID":"20240613111619-3g4pauz","Type":"NodeParagraph","Properties":{"id":"20240613111619-3g4pauz","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"《象》云∶治寒热瘰 ，诸恶疮肿，除心中客热，去胃虫，通五淋。"}]},{"ID":"20240613111619-xyh62wa","Type":"NodeParagraph","Properties":{"id":"20240613111619-xyh62wa","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"《心》云∶泻心经客热，诸家须用，疮家圣药也。"}]},{"ID":"20240613111619-7av1yq6","Type":"NodeParagraph","Properties":{"id":"20240613111619-7av1yq6","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"《珍》云∶诸经客热，非此不能除。"}]},{"ID":"20240613111619-5q4hmqw","Type":"NodeParagraph","Properties":{"id":"20240613111619-5q4hmqw","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主寒热鼠 ，瘰 ，痈肿瘿瘤，结热蛊毒，去寸白虫。"}]},{"ID":"20240613111619-w374nft","Type":"NodeParagraph","Properties":{"id":"20240613111619-w374nft","updated":"20240613111619"},"Children":[{"Type":"NodeText","Data":"《液》云∶手、足少阳。治疮、疡、瘤、气瘿起、结核，有神。与柴胡同功，但分气血之异耳。与鼠粘子同用，治疮疡别有神功。"}]},{"ID":"20240613111556-czc6kk0","Type":"NodeThematicBreak","Properties":{"id":"20240613111556-czc6kk0"}},{"ID":"20240613111557-mbjlryr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111557-mbjlryr","updated":"20240613111601"},"Children":[{"Type":"NodeText","Data":"连翘《神农本草经百种录》"}]},{"ID":"20240613111557-t2srft7","Type":"NodeParagraph","Properties":{"id":"20240613111557-t2srft7","updated":"20240613111557"},"Children":[{"Type":"NodeText","Data":"味苦平。主寒热，火气所郁之寒热。鼠 瘰 ，痈肿恶疮，瘿瘤结热，皆肝经热结之证。蛊毒。湿热之虫。"}]},{"ID":"20240613111557-c9p9abe","Type":"NodeParagraph","Properties":{"id":"20240613111557-c9p9abe","updated":"20240613111557"},"Children":[{"Type":"NodeText","Data":"凡药之散寒、温凉，有归气分者，有归血分者。大抵气胜者治气，味胜者治血。连翘之气芳家留滞之邪毒也。"}]},{"ID":"20240613111213-eizp8un","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-eizp8un"}},{"ID":"20240613111548-fshg23q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111548-fshg23q","updated":"20240613111552"},"Children":[{"Type":"NodeText","Data":"连翘《长沙药解》"}]},{"ID":"20240613111548-tobjs3r","Type":"NodeParagraph","Properties":{"id":"20240613111548-tobjs3r","updated":"20240613111548"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦平。主寒热，鼠瘘，瘰疬，痈肿，恶创，瘿瘤，结热，蛊毒。一名异翘，一名兰华，一名轵，一名三廉。生山谷。"}]},{"ID":"20240613111548-z8sc09j","Type":"NodeParagraph","Properties":{"id":"20240613111548-z8sc09j","updated":"20240613111548"},"Children":[{"Type":"NodeText","Data":"味苦，性凉，入足太阴脾、足太阳膀胱经。清丁火而退热，利壬水而泻湿。"}]},{"ID":"20240613111548-fjkrqxh","Type":"NodeParagraph","Properties":{"id":"20240613111548-fjkrqxh","updated":"20240613111548"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麻黄连翘赤小豆汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"麻黄二两，生姜二两，甘草一两，大枣十二枚，生梓白皮一斤，杏仁四十枚，连翘二两，赤小豆一升。"},{"Type":"NodeText","Data":"治太阴伤寒，瘀热在里，身必发黄。以太阴湿旺，胃土贼于甲木，肺金刑于相火，木火郁遏，湿化为热，则发黄色。缘肺热则水道不利，湿无泄路，木主五色，入土而化黄也。甘、枣、生姜，补土和中，麻黄泻皮毛之郁，杏仁降肺气之逆，生梓白皮清相火而疏木，连翘、小豆，泻湿热而利水也。"}]},{"ID":"20240613111548-r0521r4","Type":"NodeParagraph","Properties":{"id":"20240613111548-r0521r4","updated":"20240613111548"},"Children":[{"Type":"NodeText","Data":"连翘清心泻火，利水开癃，善除郁热之证，尤能行血通经，凉营散结，疗痈疽瘿疬之病，擅消肿排脓之长。"}]},{"ID":"20240613111437-vlh6jnz","Type":"NodeThematicBreak","Properties":{"id":"20240613111437-vlh6jnz"}},{"ID":"20240613111535-5tz5uls","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111535-5tz5uls","updated":"20240613111542"},"Children":[{"Type":"NodeText","Data":"连翘《本草备要》"}]},{"ID":"20240613111535-d0sumwj","Type":"NodeParagraph","Properties":{"id":"20240613111535-d0sumwj","updated":"20240613111535"},"Children":[{"Type":"NodeText","Data":"轻，宣，散结，泻火"}]},{"ID":"20240613111535-5av8l1x","Type":"NodeParagraph","Properties":{"id":"20240613111535-5av8l1x","updated":"20240613111535"},"Children":[{"Type":"NodeText","Data":"微寒升浮。形似心（实以莲房有瓣），苦入心，故入手少阴，厥阴（心、心包）气分而泻火，兼除手、足少阳（三焦、胆），手阳明经（大肠）气分湿热。散诸经血凝、气聚（营气壅遏，卫气郁滞，遂成疮肿），利水通经，杀虫止痛，消肿排脓（皆结者散之。凡肿而痛者为实邪，肿而不痛为虚邪，肿而赤者为结热，肿而不赤为留气停痰），为十二经疮家圣药（经曰∶诸疮痛痒皆属心火）。"}]},{"ID":"20240613111437-yx8m9ox","Type":"NodeThematicBreak","Properties":{"id":"20240613111437-yx8m9ox"}},{"ID":"20240613111526-73qcnbz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111526-73qcnbz","updated":"20240613111530"},"Children":[{"Type":"NodeText","Data":"连翘《本草述钩元》"}]},{"ID":"20240613111526-zgjm7hu","Type":"NodeParagraph","Properties":{"id":"20240613111526-zgjm7hu","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"秋时结实。内作房瓣。八月采房。有两种。一似椿实之未开者。壳小坚而外完。无跗萼。剖之则中解。气甚芳馥。其实才干。振之皆落。不着茎也。一种如菡萏。壳柔。外有跗萼抱之。而无解脉。亦无香气。干之虽久。着茎不脱。此种江南下泽间极多。如椿实者乃自味苦。气平。性凉。气味俱薄。轻清而浮。升也。阳也。又为阴中微阳。入手足少阳。"}]},{"ID":"20240613111526-itgmjcr","Type":"NodeParagraph","Properties":{"id":"20240613111526-itgmjcr","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"及蛊毒利五十二经神。与柴血分用柴胡。气分用连翘。独茎赤色。"}]},{"ID":"20240613111526-lekv80e","Type":"NodeParagraph","Properties":{"id":"20240613111526-lekv80e","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"乃少阴心厥阴包络气分主药。兼治手足少咸从结气所生。连翘象形易落而能自散。不功力与夏枯草相等。但夏枯偏于从本。秉寒秉容平气味。故外弥肤腠。内偏五中。至于解结从心。理则一矣金水之性。其味苦平。平应作辛。所主鼠瘰瘿瘤结热。皆少阳平凉。正清胆热。芬芳又解郁气。故用靡不瘳。（仲淳）胆经郁热口苦。同柴胡用。殊效。"}]},{"ID":"20240613111526-uey17nd","Type":"NodeParagraph","Properties":{"id":"20240613111526-uey17nd","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"痔疮肿痛。连翘煎汤。熏洗后。以刀上飞过绿矾入麝香贴之。"}]},{"ID":"20240613111526-zib055a","Type":"NodeParagraph","Properties":{"id":"20240613111526-zib055a","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"〔论〕连翘味微苦而气凉。得秋收之气以告成。故其实能散血结气聚。即其房剖之则中解金为阳之者。"}]},{"ID":"20240613111526-xgg1ypa","Type":"NodeParagraph","Properties":{"id":"20240613111526-xgg1ypa","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"惟足妄。然也。然则心胃并气血开阖轻清上浮本于金水思通月水直以收气为散气。（其气为升为阳）彼保和丸中。欲散结聚耶。抑更用治血证。连翘为中使。第其为物苦燥。虚者多致危困。惟实者宜之。（丹溪）痈疽已溃勿服〔修治〕黑而闭口者良。去蒂根。研。"}]},{"ID":"20240613111526-v3128j4","Type":"NodeParagraph","Properties":{"id":"20240613111526-v3128j4","updated":"20240613111526"},"Children":[{"Type":"NodeText","Data":"根（即连轺）味甘平。气寒。有小毒。下热气。益阴精。治伤寒瘀热在里欲发黄。"}]},{"ID":"20240613111454-npnz7lu","Type":"NodeThematicBreak","Properties":{"id":"20240613111454-npnz7lu"}},{"ID":"20240613111516-2zqqgn8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111516-2zqqgn8","updated":"20240613111520"},"Children":[{"Type":"NodeText","Data":"连翘《本经逢原》"}]},{"ID":"20240613111516-59avhds","Type":"NodeParagraph","Properties":{"id":"20240613111516-59avhds","updated":"20240613111516"},"Children":[{"Type":"NodeText","Data":"苦平，无毒。根名连轺，甘寒平，小毒。"}]},{"ID":"20240613111516-9jz6wbf","Type":"NodeParagraph","Properties":{"id":"20240613111516-9jz6wbf","updated":"20240613111516"},"Children":[{"Type":"NodeText","Data":"《本经》主寒热鼠 ，瘰 痈肿，恶疮瘿瘤，结热蛊毒。"}]},{"ID":"20240613111516-8uct1v0","Type":"NodeParagraph","Properties":{"id":"20240613111516-8uct1v0","updated":"20240613111516"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"连翘轻清而浮，本手少阴、厥阴气分药。泻心经客热，破血结，散气聚，消肿毒，利小便。诸痛痒疮，皆属心火。连翘泻心为疮家之圣药；十二经疮药中不可无此，乃结者散之之义。《本经》专主寒热鼠 ， 瘰瘿瘤、结热等病，皆由足少阳胆经气郁而成，此药正清胆经郁热。痈疽恶疮，无非营卫壅遏，得清凉以散之。蛊毒所结，得辛香以解之。然苦寒之性仅可以治热肿，故痈疽溃后脓清色淡及胃弱食少者禁用。根寒降，专下热气，治湿热发黄，湿热去而面悦好，眼目明矣。仲景治瘀热在里发黄，麻黄连翘赤小豆汤主之。奈何世鲜知此，如无根，以实代之。"}]},{"ID":"20240613111454-a98x856","Type":"NodeThematicBreak","Properties":{"id":"20240613111454-a98x856"}},{"ID":"20240613111505-c45zg4k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111505-c45zg4k","updated":"20240613111510"},"Children":[{"Type":"NodeText","Data":"连翘《新修本草》"}]},{"ID":"20240613111505-wec8mdt","Type":"NodeParagraph","Properties":{"id":"20240613111505-wec8mdt","updated":"20240613111505"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主寒热，鼠 ，瘰 ，痈肿，恶疮，瘿瘤，结热，蛊毒。去白虫。一名异翘，一名兰华，一名折根，一名轵，一名三廉。生太山山谷。八月采，阴干。"}]},{"ID":"20240613111505-b5mhwvd","Type":"NodeParagraph","Properties":{"id":"20240613111505-b5mhwvd","updated":"20240613111505"},"Children":[{"Type":"NodeText","Data":"处处有，今用茎连花实也。"}]},{"ID":"20240613111505-u4jngdb","Type":"NodeParagraph","Properties":{"id":"20240613111505-u4jngdb","updated":"20240613111505"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物有两种∶大翘、小翘。大翘叶狭长如水苏，花黄可爱，生下湿地，着子似椿实之未开者，作房，翘出众草；其小翘生岗原之上，叶花实皆似大翘而小细，山南人并用之。今京下惟用大翘子，不用茎花也。"}]},{"ID":"20240613111454-zk5mltm","Type":"NodeThematicBreak","Properties":{"id":"20240613111454-zk5mltm"}},{"ID":"20240613111456-znydfui","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111456-znydfui","updated":"20240613111500"},"Children":[{"Type":"NodeText","Data":"连翘《本草从新》"}]},{"ID":"20240613111456-9637i05","Type":"NodeParagraph","Properties":{"id":"20240613111456-9637i05","updated":"20240613111456"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"轻宣散结、泻火．"}]},{"ID":"20240613111456-ujlbwo5","Type":"NodeParagraph","Properties":{"id":"20240613111456-ujlbwo5","updated":"20240613111456"},"Children":[{"Type":"NodeText","Data":"味苦微寒．而性升浮．其形似心．（实似莲房有瓣．）故入手少阴、厥阴．（心、心包．）"}]},{"ID":"20240613111456-x9ka54j","Type":"NodeParagraph","Properties":{"id":"20240613111456-x9ka54j","updated":"20240613111456"},"Children":[{"Type":"NodeText","Data":"而泻火．兼除手足少阳（三焦、胆．）手阳明经（大肠．）湿热．散诸经血凝气聚．利水通经．杀虫止痛．消肿排脓．（皆结者散之、凡肿而痛者、为实邪、肿而不痛、为虚邪、肿而赤者、为结热、肿而不赤、为留气停痰．）为十二经疮家圣药．（经曰∶诸疮痛痒、皆属心火．）苦寒之物．多饵即减食．痈疽溃后勿服．（集验方、治痔疮肿痛、连翘煎汤、熏洗后、以刀上飞过绿矾、入麝香贴之．）"}]},{"ID":"20240613111437-52kc4xo","Type":"NodeThematicBreak","Properties":{"id":"20240613111437-52kc4xo"}},{"ID":"20240613111446-k9l0af9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111446-k9l0af9","updated":"20240613111450"},"Children":[{"Type":"NodeText","Data":"连翘《本草纲目》"}]},{"ID":"20240613111446-04vc9bp","Type":"NodeParagraph","Properties":{"id":"20240613111446-04vc9bp","updated":"20240613111446"},"Children":[{"Type":"NodeText","Data":"「释名」异翘、旱莲子、兰华、三廉，根名连轺、竹根。"}]},{"ID":"20240613111446-rhkgoxl","Type":"NodeParagraph","Properties":{"id":"20240613111446-rhkgoxl","updated":"20240613111446"},"Children":[{"Type":"NodeText","Data":"「气味」（茎、叶）苦、平、无毒。（翘根）甘、寒、平、有小毒。"}]},{"ID":"20240613111446-n56kzrw","Type":"NodeParagraph","Properties":{"id":"20240613111446-n56kzrw","updated":"20240613111446"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613111446-0od113h","Type":"NodeParagraph","Properties":{"id":"20240613111446-0od113h","updated":"20240613111446"},"Children":[{"Type":"NodeText","Data":"1、瘰疬结核，用连翘、脂订等分为末，随时吞服。"}]},{"ID":"20240613111446-qacfxxv","Type":"NodeParagraph","Properties":{"id":"20240613111446-qacfxxv","updated":"20240613111446"},"Children":[{"Type":"NodeText","Data":"2、痔疮肿痛。用连翘煎汤熏洗，后以绿矾加麝香少许敷贴。"}]},{"ID":"20240613111446-tma6lab","Type":"NodeParagraph","Properties":{"id":"20240613111446-tma6lab","updated":"20240613111446"},"Children":[{"Type":"NodeText","Data":"3、痈疸肿毒。用连翘草及根各一升，加水一斗六升，煮成三升服。出汗为见效。"}]},{"ID":"20240613111437-gsgamgz","Type":"NodeThematicBreak","Properties":{"id":"20240613111437-gsgamgz"}},{"ID":"20240613111438-3b2x8xz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111438-3b2x8xz","updated":"20240613111441"},"Children":[{"Type":"NodeText","Data":"连翘《本草分经》"}]},{"ID":"20240613111438-5io2ira","Type":"NodeParagraph","Properties":{"id":"20240613111438-5io2ira","updated":"20240613111438"},"Children":[{"Type":"NodeText","Data":"苦微寒性升，入心、心包而泻火，兼除三焦大肠胆经湿热，能散诸经血凝气聚，利水杀虫，为十二经疮家要药，多服减食。"}]},{"ID":"20240613111213-nj4oyuv","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-nj4oyuv"}},{"ID":"20240613111427-qfjx1s3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111427-qfjx1s3","updated":"20240613111432"},"Children":[{"Type":"NodeText","Data":"连翘《证类本草》"}]},{"ID":"20240613111427-17yfmee","Type":"NodeParagraph","Properties":{"id":"20240613111427-17yfmee","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主寒热鼠 瘰 ，痈肿恶疮瘿瘤，结热蛊毒，去白虫。一名异翘，一名兰华，一名折根，一名轵，一名三廉。生泰山山谷。八月采，阴干。"}]},{"ID":"20240613111427-kfwh5x7","Type":"NodeParagraph","Properties":{"id":"20240613111427-kfwh5x7","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶处处有，今用茎连花、实也。唐本注云∶此物有两种∶大翘，小翘。大翘叶狭长如水苏，花黄可爱生下湿地，着子似椿实之未开者，作房翘出众草。其小翘生岗原之上，叶、花、实皆似大翘而小细。山南人并用之。今京下唯用大翘子，不用茎、花也。臣禹锡等谨按蜀本云∶连翘，微寒。《图经》云∶苗高三、四尺，今所在下湿地有，采实，日干用之。"}]},{"ID":"20240613111427-68iphx7","Type":"NodeParagraph","Properties":{"id":"20240613111427-68iphx7","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"尔雅云∶连，异翘。释曰∶连一名异翘。郭云∶一名连苕，又名连草。药性论云∶连翘，使。一名旱莲子。主通利五淋，小便不通，除心家客热。日华子云∶通小肠，排脓，治疮疖止痛，通月经。所在有。独茎，梢开三、四黄花，结子内有房瓣子。五月、六月采。"}]},{"ID":"20240613111427-k48hnrh","Type":"NodeParagraph","Properties":{"id":"20240613111427-k48hnrh","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"图经曰∶连翘，生泰山山谷，今近京及河中、江宁府、泽、润、淄、兖、鼎、岳、利州，南康军皆有之。有大翘、小翘二种，生下湿地或山岗上，叶青黄而狭长，如榆叶、水苏辈，茎赤色，高三、四尺许，花黄可爱，秋结实似莲，作房，翘出众草，以此得名，根黄如蒿根。八月采房，阴干。其小翘生岗原之上，叶、花、实皆似大翘而细。南方生者，叶狭而小，茎短，才高一、二尺，花亦黄，实房黄黑，内含黑子如粟粒，亦名旱莲草，南人用花、叶。中品鳢肠亦名旱莲，人或以此当旱莲，非也。《尔雅》谓之连，一名异翘，一名连苕，又名连草。今南中医家说云∶连翘，盖有两种∶一种似椿实之未开者，壳小坚而外完，无跗萼，剖之则中解，气甚芬馥，其实才干，振之皆落，不着茎也。一种乃如菡萏，壳柔，处有跗萼抱之，无解脉，亦无香气，干之虽久，着茎不脱，此甚相异也。今如菡萏者，江南下泽间极多。"}]},{"ID":"20240613111427-zonsswx","Type":"NodeParagraph","Properties":{"id":"20240613111427-zonsswx","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"如椿实者，乃自蜀中来，用之亦胜江南者。据本草言∶则蜀中来者为胜，然未见其茎、叶如何也。"}]},{"ID":"20240613111427-qxjxi6f","Type":"NodeParagraph","Properties":{"id":"20240613111427-qxjxi6f","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"集验方∶洗痔。以连翘煎汤洗讫，刀上飞绿矾，入麝香贴之。"}]},{"ID":"20240613111427-zoeaitw","Type":"NodeParagraph","Properties":{"id":"20240613111427-zoeaitw","updated":"20240613111427"},"Children":[{"Type":"NodeText","Data":"衍义曰∶连翘，亦不至翘出众草，下湿地亦无，泰山山谷间甚多。今只用其子，折之，其间片片相比如翘，应以此得名尔。治心经客热最胜。尤宜小儿。"}]},{"ID":"20240613111213-63dblw0","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-63dblw0"}},{"ID":"20240613111417-mfppabm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111417-mfppabm","updated":"20240613111421"},"Children":[{"Type":"NodeText","Data":"连翘《要药分剂》"}]},{"ID":"20240613111417-6h5vz3s","Type":"NodeParagraph","Properties":{"id":"20240613111417-6h5vz3s","updated":"20240613111417"},"Children":[{"Type":"NodeText","Data":"味苦辛。性平。无毒。感清凉之气。得金水之性以生。升也。阳也。一云阴中阳也。"}]},{"ID":"20240613111417-wcbtm0n","Type":"NodeParagraph","Properties":{"id":"20240613111417-wcbtm0n","updated":"20240613111417"},"Children":[{"Type":"NodeText","Data":"【主治】主结热痈疮。（本经）去白虫。（别录）通利五淋小便不通。除心家客热。"}]},{"ID":"20240613111417-0hi0du1","Type":"NodeParagraph","Properties":{"id":"20240613111417-0hi0du1","updated":"20240613111417"},"Children":[{"Type":"NodeText","Data":"（甄权）心火。"}]},{"ID":"20240613111417-iy1erqb","Type":"NodeParagraph","Properties":{"id":"20240613111417-iy1erqb","updated":"20240613111417"},"Children":[{"Type":"NodeText","Data":"【归经】入胆大肠三焦三经。兼入心心包二经。为散结清火之品。（兼宣剂）【前论】元素曰。连翘之用有三。泻心经客热。一也。去上焦诸热。二也。为疮家圣药。"}]},{"ID":"20240613111417-ae1g1no","Type":"NodeParagraph","Properties":{"id":"20240613111417-ae1g1no","updated":"20240613111417"},"Children":[{"Type":"NodeText","Data":"三痒疮为鳌按、人之气血。贵乎通流。若血分壅滞。气分遏抑。便成疮肿。连翘能散结。故主之也。"}]},{"ID":"20240613111417-7um644k","Type":"NodeParagraph","Properties":{"id":"20240613111417-7um644k","updated":"20240613111417"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。此清而无补之药也。痈疽已溃。及火热由于虚。与脾胃薄弱作泄者。"}]},{"ID":"20240613111213-srjubzl","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-srjubzl"}},{"ID":"20240613111406-58m8qqt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111406-58m8qqt","updated":"20240613111412"},"Children":[{"Type":"NodeText","Data":"连翘《本草便读》"}]},{"ID":"20240613111406-rwd1mwp","Type":"NodeParagraph","Properties":{"id":"20240613111406-rwd1mwp","updated":"20240613111406"},"Children":[{"Type":"NodeText","Data":"苦先入心．寒能及肺．诸疮各毒．皆缘邪火游行．气聚血凝．用此宣通表里．（连翘其仁初生象心．若未开莲花．熟则四解象肺．去心用壳．轻浮解散之品．味苦性寒．入心肺之分．以肺主一身之气．心主一身之血．故能解散十二经血凝气聚．而为痈疽疮疡之圣药．但外证之属寒者禁之．）"}]},{"ID":"20240613111213-9jlad4s","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-9jlad4s"}},{"ID":"20240613111329-nlic8k5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111329-nlic8k5","updated":"20240613111333"},"Children":[{"Type":"NodeText","Data":"连翘《医学入门》"}]},{"ID":"20240613111329-x02oxe1","Type":"NodeParagraph","Properties":{"id":"20240613111329-x02oxe1","updated":"20240613111329"},"Children":[{"Type":"NodeText","Data":"连翘苦寒散心火，脾经湿热特轻可，排脓消肿用作君，治血通淋为之左。"}]},{"ID":"20240613111329-rbwxtdw","Type":"NodeParagraph","Properties":{"id":"20240613111329-rbwxtdw","updated":"20240613111329"},"Children":[{"Type":"NodeText","Data":"片片连合如鸟尾。无毒。浮而升，阳也，手足少阳阳明经药。入手少阴经，散心经火郁客热，降脾胃湿热，专能排脓消肿，瘰疬瘿瘤、痈肿恶疮不可缺也。治血证实者，与黄连同为中焦佐使，防风为上使，地榆为下使也。兼利月经。通五淋，消蛊毒，诸证皆心火凝滞而成。此药气味俱轻，而能散火解郁，虚者慎用。小儿诸疮客热最宜，去穣。根名连轺，苦寒，《本经》不见注，惟仲景伤寒用治身热发黄。"}]},{"ID":"20240613111355-4gjeu8x","Type":"NodeThematicBreak","Properties":{"id":"20240613111355-4gjeu8x"}},{"ID":"20240613111356-uel1ry2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111356-uel1ry2","updated":"20240613111359"},"Children":[{"Type":"NodeText","Data":"连翘《本草崇原》"}]},{"ID":"20240613111356-c0l16s1","Type":"NodeParagraph","Properties":{"id":"20240613111356-c0l16s1","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主治寒热鼠 瘰 ，痈肿恶疮，瘿瘤结热，蛊毒。"}]},{"ID":"20240613111356-nk7cwgb","Type":"NodeParagraph","Properties":{"id":"20240613111356-nk7cwgb","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"（连翘出汴京及河中、江宁、润淄、泽兖、鼎岳、南康诸州皆有之，而以蜀中者为胜。"}]},{"ID":"20240613111356-1xc4ciz","Type":"NodeParagraph","Properties":{"id":"20240613111356-1xc4ciz","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"有大翘、小翘二种。大翘生下湿地，叶如榆叶，独茎赤色，稍间开花黄色可爱，秋结实，形如莲，内作房瓣，气甚芳馥，根黄如蒿根。小翘生岗原之上，叶茎花实皆似大翘，但细小耳。实房黄黑，内含黑子，根名连轺，须知大翘用实不用根，小翘用根不用实。）"}]},{"ID":"20240613111356-wv3irn2","Type":"NodeParagraph","Properties":{"id":"20240613111356-wv3irn2","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"连翘味苦性寒，形象心肾，禀少阴之气化。主治寒热鼠 瘰 者，治鼠 瘰 之寒热也。"}]},{"ID":"20240613111356-vyw5f2q","Type":"NodeParagraph","Properties":{"id":"20240613111356-vyw5f2q","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"夫有内外二因，内因曰鼠 ，外因曰瘰 ，其本在脏，其末在脉。此内因而为水毒之 ，故曰鼠 也。陷脉为 ，留连肉腠，此外因而寒邪薄于肉腠之 ，故曰瘰 也。是鼠 起于肾脏之毒，留于心主之血脉。瘰 因天气之寒，伤人身之经脉。连翘形象心肾，故治鼠 瘰也。痈肿恶疮，肌肉不和。瘿瘤结热，经脉不和。连翘味苦，其气芳香，能通经脉而利肌肉，故治痈肿恶疮，瘿瘤结热也。受蛊毒者在腹，造毒者在心。苦寒泄心，治造毒之原。芳香醒脾，治受毒之腹，故又治蛊毒。"}]},{"ID":"20240613111356-v1stsbo","Type":"NodeParagraph","Properties":{"id":"20240613111356-v1stsbo","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"《灵枢·寒热论》岐伯曰∶鼠 寒热之毒瓦斯也，留于脉而不去者也。其本在于水脏，故曰鼠。上通于心主之脉，颈腋溃烂，故曰 。鼠 寒热之毒瓦斯者，言鼠 水毒而为寒，上合心包而为热也。主治寒热鼠 者，治鼠 之寒热也。今人不解《本经》，祗事剿袭，以寒热二字句逗，谓连翘主治寒热，出于神农之言。凡伤寒中风之寒热，一概用之，岂知风寒之寒热起于皮肤，鼠 之寒热起于血脉，风马牛不相及也。嗟嗟，为医者可不知《内经》乎。《灵枢》论营卫血气之生始，出入脏腑经脉之交合贯通，乃医家根本之学，浅人视为针经而忽之，良可惜也。"}]},{"ID":"20240613111356-9zghw0h","Type":"NodeParagraph","Properties":{"id":"20240613111356-9zghw0h","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"（李时珍曰∶连翘状似人心，两片合成，其中有仁甚香，乃少阴心经，厥阴包络气分主药。"}]},{"ID":"20240613111356-eh9pk8l","Type":"NodeParagraph","Properties":{"id":"20240613111356-eh9pk8l","updated":"20240613111356"},"Children":[{"Type":"NodeText","Data":"诸痛痒疮疡皆属心火，故为十二经疮家圣药，而兼注手足少阳、手阳明之经气分之热也。）"}]},{"ID":"20240613111338-s3lct8n","Type":"NodeThematicBreak","Properties":{"id":"20240613111338-s3lct8n"}},{"ID":"20240613111340-wf4y9g3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111340-wf4y9g3","updated":"20240613111348"},"Children":[{"Type":"NodeText","Data":"连翘《本草新编》"}]},{"ID":"20240613111340-j9k0jiy","Type":"NodeParagraph","Properties":{"id":"20240613111340-j9k0jiy","updated":"20240613111340"},"Children":[{"Type":"NodeText","Data":"连翘，味苦，气平、微寒，性轻而浮，升也，阳也，无毒。入少阴心经，手足少阳、阳明。"}]},{"ID":"20240613111340-gx3i4ny","Type":"NodeParagraph","Properties":{"id":"20240613111340-gx3i4ny","updated":"20240613111340"},"Children":[{"Type":"NodeText","Data":"泻心中客热，脾胃湿热殊效，去痈毒，寸白蛔虫，疮科攸赖。通月经，下五淋，散诸经血凝气聚。但可佐使，非君臣主药，可用之以攻邪，不可恃之以补正，亦可有可无之品。近人无论虚实，一概乱投，为可哂焉。"}]},{"ID":"20240613111340-uhjhsgo","Type":"NodeParagraph","Properties":{"id":"20240613111340-uhjhsgo","updated":"20240613111340"},"Children":[{"Type":"NodeText","Data":"或问连翘为升科要药，是亦药中之甘草也，吾子以为可有可无，何也？连翘实不足轻重也。"}]},{"ID":"20240613111340-x72s1gu","Type":"NodeParagraph","Properties":{"id":"20240613111340-x72s1gu","updated":"20240613111340"},"Children":[{"Type":"NodeText","Data":"盖败毒必须用甘草；化毒必须用金银花；消毒必须用矾石；清毒必须加用芩、连、栀子；杀毒必须加用大黄。是治毒之法，无一件可劳连翘，无之不加重，有之不减轻。但有之以为佐使，则攻邪有力，又未必无小补也。"}]},{"ID":"20240613111213-p2fa7lk","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-p2fa7lk"}},{"ID":"20240613111235-bcy20av","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111235-bcy20av","updated":"20240613111240"},"Children":[{"Type":"NodeText","Data":"连翘《中药学》"}]},{"ID":"20240613111235-6gx95au","Type":"NodeParagraph","Properties":{"id":"20240613111235-6gx95au","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【药用】本品为木犀科植物连翘的果实。"}]},{"ID":"20240613111235-nbfnfpk","Type":"NodeParagraph","Properties":{"id":"20240613111235-nbfnfpk","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，微寒。入心、胆经。"}]},{"ID":"20240613111235-dry1tc8","Type":"NodeParagraph","Properties":{"id":"20240613111235-dry1tc8","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【功效】清热解毒。"}]},{"ID":"20240613111235-j2cazqe","Type":"NodeParagraph","Properties":{"id":"20240613111235-j2cazqe","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于外感风热或温病初起。"}]},{"ID":"20240613111235-a2w9j8r","Type":"NodeParagraph","Properties":{"id":"20240613111235-a2w9j8r","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"本品作用与银花相似，故用于外感风热或温病初起，两药常配合应用。"}]},{"ID":"20240613111235-tz8gh2e","Type":"NodeParagraph","Properties":{"id":"20240613111235-tz8gh2e","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"2.用于热病有高热、烦燥、口渴或发斑疹等症。"}]},{"ID":"20240613111235-eaqp9oz","Type":"NodeParagraph","Properties":{"id":"20240613111235-eaqp9oz","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"连翘能清热解毒，无论气分热或血分热，都可应用。以上诸症，系热邪炽盛，入于营血所致，可用连翘配合黄连、赤芍、丹皮等同用。"}]},{"ID":"20240613111235-x5scc8d","Type":"NodeParagraph","Properties":{"id":"20240613111235-x5scc8d","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"3.用于疮疡肿毒、瘰历、丹毒、乳痈等症。"}]},{"ID":"20240613111235-fgvyphj","Type":"NodeParagraph","Properties":{"id":"20240613111235-fgvyphj","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"连翘功能清热解毒、消肿散结，故可治疗疮疡肿毒、瘰历等症，常和银花、象贝母、夏枯草等同用。"}]},{"ID":"20240613111235-3k7by2a","Type":"NodeParagraph","Properties":{"id":"20240613111235-3k7by2a","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【处方用名】连翘、连翘壳、连乔（生用，清热解毒）、朱砂拌连翘（清心安神，治热病烦燥不安）"}]},{"ID":"20240613111235-vm3o3ur","Type":"NodeParagraph","Properties":{"id":"20240613111235-vm3o3ur","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240613111235-lizwjrh","Type":"NodeParagraph","Properties":{"id":"20240613111235-lizwjrh","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【按语】1.连翘性凉味苦，轻清上浮，可治上焦诸热，尤能解毒消痈而散结，故为疮家的要药。"}]},{"ID":"20240613111235-kg5ztzm","Type":"NodeParagraph","Properties":{"id":"20240613111235-kg5ztzm","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"2.本品配以银花、薄荷、荆芥、甘草，则散风清热；配以玄参、麦冬、青莲心、竹叶卷心等，则清心泄热；配以银花、蒲公英、紫花地丁、赤芍等，则解毒消痈；配以玄参、夏枯草、贝母等，则散结消瘰。"}]},{"ID":"20240613111235-xr3l94p","Type":"NodeParagraph","Properties":{"id":"20240613111235-xr3l94p","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"3.银花与连翘均有良好的清热解毒作用，既能透热达表，又能清里热、解疮毒，故在临床上两药经常同用。但银花尚能凉血止痢；连翘又能清心热，散结消瘰。"}]},{"ID":"20240613111235-2w88pph","Type":"NodeParagraph","Properties":{"id":"20240613111235-2w88pph","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"4.在过去用药习惯上本品分连翘壳与连翘心两种，连翘壳为果实，连翘心为种子，一般认为连翘心的清心功用较好。现上海地区已予简化，只有一种连翘，不再分为两药。"}]},{"ID":"20240613111235-5ea135c","Type":"NodeParagraph","Properties":{"id":"20240613111235-5ea135c","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"【方剂举例】连翘解毒汤《疡医大全》：连翘、牡丹皮、牛膝、天花粉、木瓜、桃仁、金银花、薏苡仁、甘草、白僵蚕。治腋窝疮。"}]},{"ID":"20240613111235-4ejtvu1","Type":"NodeParagraph","Properties":{"id":"20240613111235-4ejtvu1","updated":"20240613111235"},"Children":[{"Type":"NodeText","Data":"连翘汤《圣济总录》：连翘、玄参、木香、昆布、枳壳、犀角、柴胡、黄芩、甘草、升麻、沉香、当归、芍药、木通、生姜、大枣、柳枝。治瘰历结核在项腋下，项强背痛。"}]},{"ID":"20240613111213-c2ie6t3","Type":"NodeThematicBreak","Properties":{"id":"20240613111213-c2ie6t3"}},{"ID":"20240613111223-qetiqui","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111223-qetiqui","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"《中国药典》：连翘"}]},{"ID":"20240613111223-78us4om","Type":"NodeParagraph","Properties":{"id":"20240613111223-78us4om","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613111223-am4l94s","Type":"NodeParagraph","Properties":{"id":"20240613111223-am4l94s","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" Lián Qiáo"}]},{"ID":"20240613111223-vd7qwnh","Type":"NodeParagraph","Properties":{"id":"20240613111223-vd7qwnh","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613111223-f71omk0","Type":"NodeParagraph","Properties":{"id":"20240613111223-f71omk0","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 连壳、黄花条、黄链条花、黄奇丹、青翘、落翘"}]},{"ID":"20240613111223-8vh4wf4","Type":"NodeParagraph","Properties":{"id":"20240613111223-8vh4wf4","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613111223-30vq684","Type":"NodeParagraph","Properties":{"id":"20240613111223-30vq684","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" FRUCTUS FORSYTHIAE"}]},{"ID":"20240613111223-5kmpaet","Type":"NodeParagraph","Properties":{"id":"20240613111223-5kmpaet","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613111223-ywvsdap","Type":"NodeParagraph","Properties":{"id":"20240613111223-ywvsdap","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 本品为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"连翘"},{"Type":"NodeText","Data":"Forsythia suspensa （Thunb.）Vahl的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。秋季果实初熟尚带绿色时采收，除去杂质，蒸熟，晒干，习称“青翘”；果实熟透时采收,晒干，除去杂质，习称“老翘” 。"}]},{"ID":"20240613111223-j6qv1au","Type":"NodeParagraph","Properties":{"id":"20240613111223-j6qv1au","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613111223-v190pwo","Type":"NodeParagraph","Properties":{"id":"20240613111223-v190pwo","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 本品呈长卵形至卵形，稍扁，长1.5～2.5cm，直径0.5～1.3cm。表面有不规则的纵皱纹及多数凸起的小斑点，两面各有1条明显的纵沟。顶端锐尖，基部有小果梗或已脱落。青翘多不开裂，表面绿褐色，凸起的灰白色小斑点较少，质硬；种子多数，黄绿色，细长，一侧有翅。老翘自顶端开裂或裂成两瓣，表面黄棕色或红棕色，内表面多为浅黄棕色，平滑，具一纵隔；质脆；种子棕色，多已脱落。气微香，味苦。"}]},{"ID":"20240613111223-ssjk9qa","Type":"NodeParagraph","Properties":{"id":"20240613111223-ssjk9qa","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613111223-e6q49ee","Type":"NodeParagraph","Properties":{"id":"20240613111223-e6q49ee","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240613111223-919rek9","Type":"NodeParagraph","Properties":{"id":"20240613111223-919rek9","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613111223-rf5c8s2","Type":"NodeParagraph","Properties":{"id":"20240613111223-rf5c8s2","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" （1）本品果皮横切面：外果皮为 1列扁平细胞，外壁及侧壁增厚，被角质层。中果皮外侧薄壁组织中散有维管束；中果皮内侧为多列石细胞，长条形、类圆形或长圆形，壁厚薄不一，多切向排列成镶嵌状，并延伸至纵隔壁；内果皮为1 列薄壁细胞。"}]},{"ID":"20240613111223-smr3d05","Type":"NodeParagraph","Properties":{"id":"20240613111223-smr3d05","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末 1g，加氯仿 30ml，加热回流1小时，滤过，弃去滤液，药渣挥干，加甲醇40ml，加热加流1小时，滤过，滤液浓缩至约1ml，加于聚酰胺柱（14～30目，3g,内径1～1.2cm，用水50ml预洗）上，用水50ml洗脱，弃去水液，再用乙醇100ml洗脱，收集洗脱液，蒸干，残渣加水30ml使溶解，滤过，滤液置分液漏斗中，用醋酸乙酯提取2 次，每次20ml，合并提取液，蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取连翘对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一以含5％磷酸二氢钠的羧甲基纤维素钠溶液为黏合剂的硅胶Ｇ薄层板上，置以苯－丙酮－醋酸乙酯－甲醇-水（20:25:30:3:3）为展开剂的展开缸中饱和30分钟，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中,在与对照药材色谱相应的位置上，显相同颜色的荧光斑点；再喷以香草醛硫酸试液，加热至斑点显色清晰，供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240613111223-cf095lk","Type":"NodeParagraph","Properties":{"id":"20240613111223-cf095lk","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613111223-ibsagzq","Type":"NodeParagraph","Properties":{"id":"20240613111223-ibsagzq","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 归肺、心、小肠经。"}]},{"ID":"20240613111223-tq83whl","Type":"NodeParagraph","Properties":{"id":"20240613111223-tq83whl","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613111223-f4yp32w","Type":"NodeParagraph","Properties":{"id":"20240613111223-f4yp32w","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 苦，微寒。"}]},{"ID":"20240613111223-itmrqsp","Type":"NodeParagraph","Properties":{"id":"20240613111223-itmrqsp","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613111223-xjmsop9","Type":"NodeParagraph","Properties":{"id":"20240613111223-xjmsop9","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 清热解毒，消肿散结。用于痈疽，瘰疠，乳痈，丹毒，风热感冒，温病初起，温热入营，高热烦渴，神昏发斑，热淋尿闭。"}]},{"ID":"20240613111223-xdw7jg4","Type":"NodeParagraph","Properties":{"id":"20240613111223-xdw7jg4","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613111223-hjumjm7","Type":"NodeParagraph","Properties":{"id":"20240613111223-hjumjm7","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 6～15g。"}]},{"ID":"20240613111223-y3vlzwo","Type":"NodeParagraph","Properties":{"id":"20240613111223-y3vlzwo","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613111223-vzvu8lo","Type":"NodeParagraph","Properties":{"id":"20240613111223-vzvu8lo","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" （1）连翘性凉味苦，轻清上浮，可治上焦诸热，尤能解毒消痈而散结，故为疮家的要药。"}]},{"ID":"20240613111223-q5t4phu","Type":"NodeParagraph","Properties":{"id":"20240613111223-q5t4phu","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"（2）本品配以银花、薄荷、荆芥、甘草，则散风清热；配以玄参、麦冬、青莲心、竹叶卷心等，则清心泄热；配以银花、蒲公英、紫花地丁、赤芍等，则解毒消痈；配以玄参、夏枯草、贝母等，则散结消瘰。"}]},{"ID":"20240613111223-dob6ryp","Type":"NodeParagraph","Properties":{"id":"20240613111223-dob6ryp","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"（3）银花与连翘均有良好的清热解毒作用，既能透热达表，又能清里热、解疮毒，故在临床上两药经常同用。但银花尚能凉血止痢；连翘又能清心热，散结消瘰。"}]},{"ID":"20240613111223-i5zjfes","Type":"NodeParagraph","Properties":{"id":"20240613111223-i5zjfes","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"（4）在过去用药习惯上本品分连翘壳与连翘心两种，连翘壳为果实，连翘心为种子，一般认为连翘心的清心功用较好。现上海地区已予简化，只有一种连翘，不再分为两药。"}]},{"ID":"20240613111223-yr5izcw","Type":"NodeParagraph","Properties":{"id":"20240613111223-yr5izcw","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613111223-a3yp4ga","Type":"NodeParagraph","Properties":{"id":"20240613111223-a3yp4ga","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613111223-f5b5l6l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111223-f5b5l6l","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：连翘"}]},{"ID":"20240613111223-waehslu","Type":"NodeParagraph","Properties":{"id":"20240613111223-waehslu","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613111223-f0rtx3v","Type":"NodeParagraph","Properties":{"id":"20240613111223-f0rtx3v","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" Lián Qiáo"}]},{"ID":"20240613111223-jqxco8o","Type":"NodeParagraph","Properties":{"id":"20240613111223-jqxco8o","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613111223-d7y1o55","Type":"NodeParagraph","Properties":{"id":"20240613111223-d7y1o55","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 旱连子（《药性论》），大翘子（《唐本草》），空壳（《中药志》）。"}]},{"ID":"20240613111223-jha3zdy","Type":"NodeParagraph","Properties":{"id":"20240613111223-jha3zdy","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613111223-fs0ngw6","Type":"NodeParagraph","Properties":{"id":"20240613111223-fs0ngw6","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613111223-s6iv9s9","Type":"NodeParagraph","Properties":{"id":"20240613111223-s6iv9s9","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613111223-t1u4deo","Type":"NodeParagraph","Properties":{"id":"20240613111223-t1u4deo","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"连翘"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。果实初熟或熟透时采收。初熟的果实采下后，蒸熟，晒干，尚带绿色，商品称为\"青翘\"；熟透的果实，采下后晒干，除去种子及杂质。称为\"老翘\"；其种子称\"连翘心\"。"}]},{"ID":"20240613111223-7b940yc","Type":"NodeParagraph","Properties":{"id":"20240613111223-7b940yc","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613111223-ur2bwae","Type":"NodeParagraph","Properties":{"id":"20240613111223-ur2bwae","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 多丛生于山野荒坡间，各地亦有栽培。分布辽宁、河北、河南、山东、江苏、湖北、江西、云南、山西、陕西、甘肃等地。主产山西、河南、陕西、山东。此外，湖北、河北、四川、甘肃亦产。"}]},{"ID":"20240613111223-bjrhvx1","Type":"NodeParagraph","Properties":{"id":"20240613111223-bjrhvx1","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613111223-whs9tck","Type":"NodeParagraph","Properties":{"id":"20240613111223-whs9tck","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 连翘，又名：连、异翘（《尔雅》），兰华、轵、折根、三廉（《本经》），连草（《尔雅》郭璞注），大翘（《唐本草》），黄花杆、黄寿丹、黄花瓣、落翘、黄花条。"}]},{"ID":"20240613111223-dc0uu6o","Type":"NodeParagraph","Properties":{"id":"20240613111223-dc0uu6o","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高2～4米。枝开展或伸长，稍带蔓性，常着地生根，小枝稍呈四棱形，节间中空，仅在节部具有实髓。单叶对生，或成为3小叶；叶柄长8～20毫米；叶片卵形、长卵形、广卵形以至圆形，长3～7厘米，宽2～4厘米，先端渐尖、急尖或钝。基部阔楔形或圆形，边缘有不整齐的锯齿；半革质。花先叶开放，腋生，长约2.5厘米；花萼4深裂，椭圆形；花冠基部管状，上部4裂，裂片卵圆形。金黄色，通常具橘红色条纹；雄蕊2，着生于花冠基部；雌蕊1，子房卵圆形，花柱细长，柱头2裂。蒴果狭卵形略扁，长约15厘米，先端有短喙，成熟时2瓣裂。种子多数，棕色，狭椭圆形，扁平，一侧有薄翅。花期3～5月。果期7～8月。"}]},{"ID":"20240613111223-04vhg2n","Type":"NodeParagraph","Properties":{"id":"20240613111223-04vhg2n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613111223-3p10d10","Type":"NodeParagraph","Properties":{"id":"20240613111223-3p10d10","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 干燥的果实呈长卵形，长1.5～2厘米，直径0.6～1厘米。顶端锐尖，基部有小柄，或已脱落。表面有不规则的纵皱纹及多数凸起的小斑点，两侧各有1条明显的纵沟。青翘多不开裂，绿褐色，表面凸起的灰白色小斑点较少，种子多数，细长，一侧有翅，黄绿色。老翘自尖端开裂或裂成两瓣，表面黄棕色或红棕色，内表面多为浅黄棕色，种子棕色，多已脱落。气微香，味苦。青翘以色青绿、无枝梗者为佳；老翘以色黄、壳厚、无种子、纯净者为佳。"}]},{"ID":"20240613111223-kgczl1v","Type":"NodeParagraph","Properties":{"id":"20240613111223-kgczl1v","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613111223-9d2y7p7","Type":"NodeParagraph","Properties":{"id":"20240613111223-9d2y7p7","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 果实含连翘酚、甾醇化合物、皂甙（无溶血性）及黄酮醇甙类、马苔树脂醇甙等。果皮含齐墩果酸。青连翘含皂甙4.89％，生物碱0.2％。"}]},{"ID":"20240613111223-g9ve5lg","Type":"NodeParagraph","Properties":{"id":"20240613111223-g9ve5lg","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613111223-ea47z88","Type":"NodeParagraph","Properties":{"id":"20240613111223-ea47z88","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" ①抗菌作用"}]},{"ID":"20240613111223-1cbyodj","Type":"NodeParagraph","Properties":{"id":"20240613111223-1cbyodj","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"连翘浓缩煎剂在体外有抗菌作用，可抑制伤寒杆菌、副伤寒杆菌、大肠杆菌、痢疾杆菌、白喉杆菌及霍乱弧菌、葡萄球菌、链球菌等。连翘在体外的抑菌作用与金银花大体相似；为银翘散中抗菌之主要成分。金银花对沙门氏菌属，特别是伤寒杆菌以及溶血性链球菌的抑制作用似超过连翘，而对痢疾杆菌、金黄色葡萄球菌之抑制则以连翘似较好。二者联合使用，在试管中并无协同作用，与黄连，黄芩组成的复方，体外抑菌作用比单用连翘时据云更强。连翘中抗菌的有效成分研究不多，连翘酚在试管中对金黄色葡萄球菌的抑菌浓度为1：5120；对痢疾杆菌为1：1280；对白喉杆菌及副伤寒（甲）杆菌为1：640，可能为抗菌有效成分。花对小鼠实验性结核病有一定疗效，对豚鼠则无效。此外，还报告过它在试管中及临床上的抗结核杆菌的作用。连翘的醇提取物在体外有抗钩端螺旋体作用，其强度不及黄连、荔枝草或金银花、黄芩，而与黄柏、蚤休相似。连翘水浸剂（1：5）在试管内对星形奴卡氏菌有些抑制作用。朝鲜连翘果实的乙醇、丙酮提取物以及从F.intermedia中提出的树脂有抗真菌作用。"}]},{"ID":"20240613111223-y3x1l2j","Type":"NodeParagraph","Properties":{"id":"20240613111223-y3x1l2j","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240613111223-n104bdu","Type":"NodeParagraph","Properties":{"id":"20240613111223-n104bdu","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"连翘能抑制洋地黄对鸽静脉注射的催吐作用，减少呕吐次数，但不改变呕吐的潜伏期，其镇吐效果与注射氯丙嚓两小时后的作用相仿。它又能抑制犬皮下注射阿朴吗啡所引起的呕吐，故推测其镇吐作用原理可能是抑制延脑的催吐化学感受区。连翘的果皮中含齐墩果酸（又名洋橄榄叶酸），故有强心、利尿作用。"}]},{"ID":"20240613111223-dc2179a","Type":"NodeParagraph","Properties":{"id":"20240613111223-dc2179a","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613111223-es2al8t","Type":"NodeParagraph","Properties":{"id":"20240613111223-es2al8t","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，搓开，除去枝梗。"}]},{"ID":"20240613111223-yksqhkm","Type":"NodeParagraph","Properties":{"id":"20240613111223-yksqhkm","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613111223-z6ob0a1","Type":"NodeParagraph","Properties":{"id":"20240613111223-z6ob0a1","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 入心、肝、胆经。"}]},{"ID":"20240613111223-wv4kdno","Type":"NodeParagraph","Properties":{"id":"20240613111223-wv4kdno","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"手足少阳、阳明经。\""}]},{"ID":"20240613111223-r7nvjw4","Type":"NodeParagraph","Properties":{"id":"20240613111223-r7nvjw4","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"少阴心经、厥阴包络气分。\""}]},{"ID":"20240613111223-0xsirak","Type":"NodeParagraph","Properties":{"id":"20240613111223-0xsirak","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入心、肝、胆、胃、三焦、大肠六经。\""}]},{"ID":"20240613111223-bw8p489","Type":"NodeParagraph","Properties":{"id":"20240613111223-bw8p489","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613111223-j63hszs","Type":"NodeParagraph","Properties":{"id":"20240613111223-j63hszs","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 苦，凉。"}]},{"ID":"20240613111223-m3tix11","Type":"NodeParagraph","Properties":{"id":"20240613111223-m3tix11","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240613111223-wo4ik4p","Type":"NodeParagraph","Properties":{"id":"20240613111223-wo4ik4p","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613111223-3ncju1v","Type":"NodeParagraph","Properties":{"id":"20240613111223-3ncju1v","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"《主治秘诀》云，性凉，味苦。\""}]},{"ID":"20240613111223-x0ml8g5","Type":"NodeParagraph","Properties":{"id":"20240613111223-x0ml8g5","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"微苦辛。\""}]},{"ID":"20240613111223-1ua2gi4","Type":"NodeParagraph","Properties":{"id":"20240613111223-1ua2gi4","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613111223-xeyob7b","Type":"NodeParagraph","Properties":{"id":"20240613111223-xeyob7b","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 脾胃虚弱，气虚发热，痈疽已溃、脓稀色淡者忌服。"}]},{"ID":"20240613111223-11chb0k","Type":"NodeParagraph","Properties":{"id":"20240613111223-11chb0k","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"痈疽巳溃勿服，大热由于虚者勿服，脾胃薄弱易于作泄者勿服。\""}]},{"ID":"20240613111223-astnsil","Type":"NodeParagraph","Properties":{"id":"20240613111223-astnsil","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②《本草通玄》：\"久服有寒中之患。\""}]},{"ID":"20240613111223-paiq09h","Type":"NodeParagraph","Properties":{"id":"20240613111223-paiq09h","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613111223-ua1kdzz","Type":"NodeParagraph","Properties":{"id":"20240613111223-ua1kdzz","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 清热，解毒，散结，消肿。治温热，丹毒，斑疹，痈疡肿毒，瘰疬，小便淋闭。"}]},{"ID":"20240613111223-vah0y5f","Type":"NodeParagraph","Properties":{"id":"20240613111223-vah0y5f","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热，鼠痿，瘰疬，痈肿恶疮，瘿瘤，结热。\""}]},{"ID":"20240613111223-zytimcf","Type":"NodeParagraph","Properties":{"id":"20240613111223-zytimcf","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"去白虫。\""}]},{"ID":"20240613111223-bir6fq6","Type":"NodeParagraph","Properties":{"id":"20240613111223-bir6fq6","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主通利五淋，小便不通，除心家客热。\""}]},{"ID":"20240613111223-qbvdmtm","Type":"NodeParagraph","Properties":{"id":"20240613111223-qbvdmtm","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"通小肠，排脓。治疮疖，止痛，通月经。\""}]},{"ID":"20240613111223-346olgb","Type":"NodeParagraph","Properties":{"id":"20240613111223-346olgb","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"⑤李杲：\"散诸经血结气聚；消肿。\""}]},{"ID":"20240613111223-kv8bc95","Type":"NodeParagraph","Properties":{"id":"20240613111223-kv8bc95","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"⑥王好古：\"治耳聋浑浑焞焞。\""}]},{"ID":"20240613111223-ivghrhd","Type":"NodeParagraph","Properties":{"id":"20240613111223-ivghrhd","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613111223-zgvbp4u","Type":"NodeParagraph","Properties":{"id":"20240613111223-zgvbp4u","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；或入丸，散。外用：煎水洗。"}]},{"ID":"20240613111223-uv58ppu","Type":"NodeParagraph","Properties":{"id":"20240613111223-uv58ppu","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613111223-3nezqru","Type":"NodeParagraph","Properties":{"id":"20240613111223-3nezqru","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" ①治太阴风温、温热、温疫、冬温，初起但热不恶寒而渴者：连翘一两，银花一两，苦桔梗六钱，薄荷六钱，竹叶四钱，生甘草五钱，芥穗四钱，淡豆豉五钱，牛蒡子六钱。上杵为散，每服六钱，鲜苇根汤煎，香气大出，即取服，勿过煮。病重者，约二时一服，日三服，夜一服；轻者三时一服，日三服，夜一服；病不解者，作再服。（《温病条辨》银翘散）"}]},{"ID":"20240613111223-te8411e","Type":"NodeParagraph","Properties":{"id":"20240613111223-te8411e","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②治小儿一切热：连翘、防风、甘草（炙）、山栀子各等分。上捣罗为末，每服二钱，水一中盏，煎七分，去滓温服。（《类证活人书》连翘饮）"}]},{"ID":"20240613111223-n4ve8aa","Type":"NodeParagraph","Properties":{"id":"20240613111223-n4ve8aa","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"③治赤游癍毒：连翘一味，煎汤饮之。（《玉樵医令》）"}]},{"ID":"20240613111223-i7drf56","Type":"NodeParagraph","Properties":{"id":"20240613111223-i7drf56","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"④治乳痈，乳核：连翘、雄鼠屎、蒲公英、川贝母各二钱。水煎服。（《玉樵医令》）"}]},{"ID":"20240613111223-unaa2hz","Type":"NodeParagraph","Properties":{"id":"20240613111223-unaa2hz","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"⑤治瘰疬结核不消：连翘、鬼箭羽、瞿麦、甘草（炙）各等分。上为细末，每服二钱，临卧米泔水调下。（《杨氏家藏方》连翘散）"}]},{"ID":"20240613111223-8lziv25","Type":"NodeParagraph","Properties":{"id":"20240613111223-8lziv25","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"⑥治舌破生疮：连翘五钱，黄柏三钱，甘草二钱。水煎含漱。（《玉樵医令》）"}]},{"ID":"20240613111223-h859y18","Type":"NodeParagraph","Properties":{"id":"20240613111223-h859y18","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613111223-pm41iub","Type":"NodeParagraph","Properties":{"id":"20240613111223-pm41iub","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" ①治疗急性肾炎"}]},{"ID":"20240613111223-y8erwjw","Type":"NodeParagraph","Properties":{"id":"20240613111223-y8erwjw","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"取连翘6钱，加水用文火煎至150毫升，分3次食前服，小儿酌减。视病情需要连服5～10日，忌辣物及盐。8例患者治疗前均有浮肿，血压在140～200/96～110毫米汞柱之间，尿检有蛋白、颗粒管型及红、白细胞等。治疗后6例浮肿全部消退，2例显着好转；血压显着下降；尿检6例转阴，2例好转。"}]},{"ID":"20240613111223-qiarb1k","Type":"NodeParagraph","Properties":{"id":"20240613111223-qiarb1k","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"②治疗紫癜病"}]},{"ID":"20240613111223-ubnpm61","Type":"NodeParagraph","Properties":{"id":"20240613111223-ubnpm61","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"取连翘6钱，加水用文火煎成150毫升，分3次食前服，忌辣物。治疗血小板减少性出血性紫癜1例，过敏性紫癜2例。经2～7日治疗，皮肤紫瘫全部消退。连翘对本病所起的作用，可能与其中含有多量芸香甙，具有保持毛细血管正常抵抗力，减少毛细血管的脆性和通透性有关；此外，连翘似乎尚有脱敏作用。"}]},{"ID":"20240613111223-zsyfil0","Type":"NodeParagraph","Properties":{"id":"20240613111223-zsyfil0","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"③治疗肺脓肿"}]},{"ID":"20240613111223-673v5xf","Type":"NodeParagraph","Properties":{"id":"20240613111223-673v5xf","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"将连翘制成注射液，每毫升含连翘1克。采用气管滴入法合并肌肉注射。气管滴入一般用6～10毫升，每日1次；症状好转后隔日1次；趋向萎缩或闭合后则每周2次。治疗25例，治愈14例，好转10例，死亡1例；据18例统计，平均治疗12天退热，气管滴注平均26.8次，最多者50次。"}]},{"ID":"20240613111223-zjw6cui","Type":"NodeParagraph","Properties":{"id":"20240613111223-zjw6cui","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"④治疗视网膜出血"}]},{"ID":"20240613111223-wrfslvt","Type":"NodeParagraph","Properties":{"id":"20240613111223-wrfslvt","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"取连翘6～7钱，文火水煎，分3次食前服，2例视网膜黄斑区出血，服药20～27天后，均显著吸收，视力有所增强。"}]},{"ID":"20240613111223-blk6766","Type":"NodeParagraph","Properties":{"id":"20240613111223-blk6766","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613111223-0hnc01g","Type":"NodeParagraph","Properties":{"id":"20240613111223-0hnc01g","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613111223-g77nvab","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613111223-g77nvab","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"《中华本草》：连翘"}]},{"ID":"20240613111223-bds03pv","Type":"NodeParagraph","Properties":{"id":"20240613111223-bds03pv","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613111223-e8ig0x5","Type":"NodeParagraph","Properties":{"id":"20240613111223-e8ig0x5","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" Lián Qiáo"}]},{"ID":"20240613111223-4xxo84n","Type":"NodeParagraph","Properties":{"id":"20240613111223-4xxo84n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613111223-330uvtq","Type":"NodeParagraph","Properties":{"id":"20240613111223-330uvtq","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 旱连子、大翘子、空翘、空壳、落翘"}]},{"ID":"20240613111223-l3ipa0b","Type":"NodeParagraph","Properties":{"id":"20240613111223-l3ipa0b","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613111223-wao901g","Type":"NodeParagraph","Properties":{"id":"20240613111223-wao901g","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613111223-paja263","Type":"NodeParagraph","Properties":{"id":"20240613111223-paja263","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：连翘处处有，今用茎连花实也。"}]},{"ID":"20240613111223-qwum7u0","Type":"NodeParagraph","Properties":{"id":"20240613111223-qwum7u0","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：连翘有两种，大翘、小翘。大翘叶狭长，如水苏，花黄可爱，生下湿地，着子似椿实之未开者，作房翘出众草。其小翘生岗原之上，叶花实皆似大翘而小细，山南人并用之。今京下惟用大翘子，不用茎花也。"}]},{"ID":"20240613111223-tk6cr4o","Type":"NodeParagraph","Properties":{"id":"20240613111223-tk6cr4o","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：连翘，今近京及河中、江宁府，泽、润、淄衮、鼎、岳、利州，南康军皆有之。有大翘、小翘二种。(大翘)生下"}]},{"ID":"20240613111223-wpjtm6v","Type":"NodeParagraph","Properties":{"id":"20240613111223-wpjtm6v","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613111223-p373dea","Type":"NodeParagraph","Properties":{"id":"20240613111223-p373dea","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 药材基源：为木犀科植物连翘的果实。"}]},{"ID":"20240613111223-g26n8l4","Type":"NodeParagraph","Properties":{"id":"20240613111223-g26n8l4","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Forsythia suspensa （Thunb.）Vahl[Sy－ringa suspensa Thunb.」"}]},{"ID":"20240613111223-xagrsmr","Type":"NodeParagraph","Properties":{"id":"20240613111223-xagrsmr","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"采收和储藏：连翘定植3-4年后开花结实。药用分“青翘”、“老翘”两种。青翘在9月上旬，果皮呈青色尚未成熟时采下，置沸水中稍煮片刻或放蒸笼内蒸约0．5h，取出晒干。老翘在10月上旬果实熟透变黄，果壳裂开时采收，晒干，筛去种子及杂质。"}]},{"ID":"20240613111223-y98pnwt","Type":"NodeParagraph","Properties":{"id":"20240613111223-y98pnwt","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613111223-dvpbay2","Type":"NodeParagraph","Properties":{"id":"20240613111223-dvpbay2","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山坡灌丛、疏林及草丛中。"}]},{"ID":"20240613111223-f11ilxj","Type":"NodeParagraph","Properties":{"id":"20240613111223-f11ilxj","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于河北、山西、陕西、甘肃、山东、江苏、安徽、河南、湖北、四川等地。现有栽培。"}]},{"ID":"20240613111223-ztvr7gl","Type":"NodeParagraph","Properties":{"id":"20240613111223-ztvr7gl","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613111223-oajicu1","Type":"NodeParagraph","Properties":{"id":"20240613111223-oajicu1","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 落叶灌木。小枝土黄色或灰褐色，略呈四棱形，疏生皮孔，节间中空，节部具实心髓。叶通常为单叶，或3裂至3出复叶；叶柄长0.8-1.5cm，无毛；叶片卵形、宽卵形或椭圆状卵形至椭圆形，长2-10cm，宽1.5-5cm，先端锐尖，基部圆形至楔形，叶缘除基部外具锐锯齿或粗锯齿。花通常单生或2至数朵着生于叶腋，先于叶开放；花梗长5-6mm；花萼绿色，裂片4，长圆形或长圆状椭圆形，边缘具睫毛；花冠黄色，裂片4，倒卵状椭圆形，长1.2-2cm，宽6-10mm；雄蕊2，着生在花冠管基部；花柱细长，柱头2裂。蒴果卵球形，2室，长1.2-2.5cm，宽0.6-1.2cm，先端喙状渐尖，表面疏生瘤点；果梗长0.7-1.5cm。花期3-4月，果期7-9月。"}]},{"ID":"20240613111223-j78dj3e","Type":"NodeParagraph","Properties":{"id":"20240613111223-j78dj3e","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613111223-j4umaal","Type":"NodeParagraph","Properties":{"id":"20240613111223-j4umaal","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖潮湿气候。适应性强，耐寒、耐瘠薄。喜阳光充足。对土壤要求不严，腐殖土及砂质砾土中都能生长。"}]},{"ID":"20240613111223-bushqya","Type":"NodeParagraph","Properties":{"id":"20240613111223-bushqya","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"栽培技术 采用种子、压条、扦插繁殖。种子繁殖：北方于3月底至4月上旬，南方于3月上、中旬播种。播前将种子在50℃的温水中浸泡10～12h取出，晾干后播种。或在9～10月种子用湿沙进行层积处理，经春取出播种，可以提高发芽率。行距30cm左右，覆土1～2cm，再盖草保持土壤湿润。苗高15～20cm时间苗，按株距10cm定苗，并追施人畜粪水，当年秋季或第2年早春移栽。压条繁殖：在雨季到来之前，将母株上较长的当年生枝条向下压弯，埋入母株附近的土中3～4cm，然后灌水，经常保持湿润，第2年早春移栽。扦插繁殖：在秋季落叶后或早春发芽前选用1～2年生健壮枝条，剪取长20cm左右，只留上部2～3片叶，其余的叶摘掉。按行株距5cm×15cm，插入苗床中，使插条露出土面1～2个节，插后立即灌水，经常保持湿润，扦插成活后20～30d开始施肥，3～4次，当年即可移栽。移栽时按穴距2m×1.5m开穴，施少量腐殖熟堆肥或厩肥，栽时使根自然舒展，埋上压实。连翘的结果率很低，在移栽时必须使长花柱植株和短花柱植株相间栽培，才能提高结果率。"}]},{"ID":"20240613111223-rpsxlbs","Type":"NodeParagraph","Properties":{"id":"20240613111223-rpsxlbs","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期中必须进行合理修剪，去弱留强，才能多结果实。冬季修剪时，以疏剪为主，短截为辅。除每墩保持3～7条旺盛的主干外，其余瘦弱的、枯老的枝条可视情况剪除。修剪后应施用追肥或厩肥、堆肥加过磷酸钙等，在株旁开沟施入后覆土。6月间应清除从基部新发的多余徒长枝，并按具体情况进行中耕除草、摘心等工作。"}]},{"ID":"20240613111223-i53gwb1","Type":"NodeParagraph","Properties":{"id":"20240613111223-i53gwb1","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有立枯病；虫害有地老虎等为害。"}]},{"ID":"20240613111223-odkidg9","Type":"NodeParagraph","Properties":{"id":"20240613111223-odkidg9","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613111223-o0kub42","Type":"NodeParagraph","Properties":{"id":"20240613111223-o0kub42","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实长卵形至卵形，稍扁，长1－2．5cm，直径0．5-1．3cm。“老翘”多自先端开裂，略向外反曲或裂成两瓣，基部有果柄或其断痕，果瓣外表面黄棕色，有不规则的纵皱纹及多数凸起的淡黄色瘤点，基部瘤点较少，中央有1条纵凹沟；内表面淡黄棕色，平滑，略带光泽，中央有一条纵隔，种子多已脱落，果皮硬脆，断面平坦。“清翘”多不开裂，表面绿褐色，瘤点较少，基部多具果柄，内有种子多数，披针形，微弯曲，长约0．7cm，宽约0.2cm，表面棕色，一侧有窄翅。气微香，味苦。"}]},{"ID":"20240613111223-3op9hhr","Type":"NodeParagraph","Properties":{"id":"20240613111223-3op9hhr","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"“青翘”以色绿、不开裂者为佳；“老翘”以色黄、瓣大、壳厚者为佳。"}]},{"ID":"20240613111223-tw3nq0n","Type":"NodeParagraph","Properties":{"id":"20240613111223-tw3nq0n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果皮横切面：外果皮为1列切向延长的表皮细胞，外被角质层，瘤点处可见薄壁组织隆起。中果皮由10-30列薄壁细胞组成，壁厚薄不一，具纹孔，罕含方晶；外韧型维管束，大小不一，老翘木质部内侧常见石细胞群和纤维束，青翘中有时可见。内果皮为5-14列厚壁组织，纵横交错排列，大多为木化的纤维束并夹有石细胞群，壁厚薄不均。最内层为1列较小的切向延长的内表皮细胞。"}]},{"ID":"20240613111223-g2vx01p","Type":"NodeParagraph","Properties":{"id":"20240613111223-g2vx01p","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"果皮粉末特征：淡黄棕色。①内果皮纤维较多．多成束，有时上下层纵横交错；短梭形或不规则形，边缘不平整或有凹凸，有的中部狭细，长80-224μm，直径24-32μm，壁厚8-18μm，木化，纹孔较少，孔沟细。②石细胞极多，单个散在或成群；类多角形、类长方形、类圆形或类方形，直径36-48μm，壁厚8-22μm，有的壁一边较薄，纹孔疏密不一，孔沟隐约可见。③果皮表皮细胞无色或微带黄色；断面观呈类万形，表面观呈类方形或类多角形，垂周壁增厚，稍弯曲，外平周壁表面微现不规则或网状角质纹理。④中果皮细胞棕黄色，壁厚，部分连珠状，纹孔偶见。另有螺纹导管及管胞，直径约14μm。"}]},{"ID":"20240613111223-yo6i3c0","Type":"NodeParagraph","Properties":{"id":"20240613111223-yo6i3c0","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"理化鉴别 （1）取本品粉末1g，加70％乙醇10ml热浸，浸出液蒸干。残渣以1ml冰醋酸溶解后，倾入小试管，沿管壁加入硫酸1ml，两液层间出现紫红色环。（检查三萜皂甙）（2）取本品粉末0．5g，加乙醚5ml，振摇5min，滤过，滤液置小试管中，加7％盐酸羟胺甲醇溶液3滴，2O％氢氧化钾甲醇溶液3滴，于水浴中微热2min，放冷，加1％盐酸，使呈微酸性，再加1％三氯化铁乙醇溶液2滴，呈紫红色。（检查香豆精）（3）薄层色谱 取本品粉末3g，加水20ml，煎煮30min，加6mol／L盐酸，调节pH至2，即用乙醚20ml提取，回收乙醚后的残渣，再溶于乙醇0．5ml中，作为供试品试液。另取齐墩果酸配制成对照品溶液。吸取上述两种溶液，分别点于同一硅胶H-1％CMC薄层板上，以氯仿-甲醇（20：1）为展开剂，展开，取出，晾干，喷以10％硫酸，于110t烤10min供试品色谱中，在与对照品色谱相应的位置上，显相同的灰黑色斑点。或碘熏后，呈相同的黄棕色斑点。"}]},{"ID":"20240613111223-wwff4lj","Type":"NodeParagraph","Properties":{"id":"20240613111223-wwff4lj","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"品质标志 用65％乙醇作溶剂，按《中华人民共和国药典》1995年版醇溶性浸出物测定法项下的冷浸法测定，醇溶性浸出物“青翘”不得少于30．0％，“老翘”不得少于16．0％。"}]},{"ID":"20240613111223-oy9u24m","Type":"NodeParagraph","Properties":{"id":"20240613111223-oy9u24m","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613111223-lwom0cv","Type":"NodeParagraph","Properties":{"id":"20240613111223-lwom0cv","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 连翘注射液(1：1)小鼠腹腔注射LD50为24.85±1.12g／kg。复方连翘注射液小鼠腹腔注射LD50为119.5g(生药)／kg。"}]},{"ID":"20240613111223-0gl7vug","Type":"NodeParagraph","Properties":{"id":"20240613111223-0gl7vug","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613111223-ydm3wo2","Type":"NodeParagraph","Properties":{"id":"20240613111223-ydm3wo2","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 果实含木脂体类化合物：连翘甙（forsythin，phillyrin）[1]，连翘甙元（phillygenin），右旋松脂酚 （pinoresin－ol）[2,3]，右旋松脂醇葡萄糖甙（pinoresinol-β-D-glucoside）[3,4]；黄酮类化合物：芸香甙（rutin）[2,4]；苯乙烷类衍生物：连翘脂甙（forsythoside）A、C、D、E[5]，连翘种甙（suspensaside）[6]，毛柳甙（salidroside）[5]；乙基环己醇类衍生物：（木来）木甙（cornside）［5］，连翘环己醇（rengyol），异连翘环己醇（isorengyol），连翘环己醇氧化物（rengyoxide），连翘环己醇酮（rengyolone），连翘环己醇甙（rengyoside）A、B、C[5]；三萜类化合物：白烨脂酸（betulinic acid），齐墩果酸（oleanolic acid）［2］，熊果酸（ursolic acid）［3］，β-香树脂醇乙酸酯（β-amyrin acetate），异降香萜烯酸乙酸酯（isobauerenyl acetate），20（S）-达玛-24-烯-3β，20-二醇-3-乙酸酯〔20（S）-dammar-24-ene-3β，20－diol－3－acetate］[7]等。"}]},{"ID":"20240613111223-h9oyxt2","Type":"NodeParagraph","Properties":{"id":"20240613111223-h9oyxt2","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613111223-4vs7yi8","Type":"NodeParagraph","Properties":{"id":"20240613111223-4vs7yi8","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 1.抗菌、抗病毒作用 1.1.抗细菌作用：将连翘种子挥发油乳剂以试管倍量稀释法进行抗菌试验，结果显示该药除对绿脓杆菌作用稍低外，对其它10株革兰氏阳性和阴性细菌均有较强的抗菌作用。其中对金黄色葡萄球菌的作用最强(抗菌效价为1／1.024)；其次为肺炎球菌；甲、乙型链球菌；卡他奈氏球菌；福氏痢疾杆菌；甲型副伤寒杆菌；(抗菌效价均为1／512)和大肠杆菌(抗菌效价为1/256)，对肺炎杆菌、普通变形杆菌抗菌效价均为1／28。选取对所试菌有抗菌作用之试验液，进行再传代培养试验，结果显示连翘种子挥发油对所试细菌的抗菌作用较为彻底而且稳定。连翘浓缩煎剂在体外有抗菌作用，可抑制伤寒杆菌、副伤寒杆菌、大肠杆菌、痢疾杆菌、白喉杆菌及霍乱弧菌、葡萄球菌、链球菌等。连翘在体外的抑菌作用与金银花大体相似；为银翘散中抗菌之主要成分。金银花对沙门氏菌属，特别是伤寒杆菌以及溶血性链球菌的抑制作用似超过连翘，而对痢疾杆菌、金黄色葡萄球菌之抑制则以连翘似较好。二者联合使用，在试管中并无协同作用，与黄连、黄芩组成的复方，体外抑菌作用比单用连翘时据云更强。连翘中抗菌的有效成分研究不多，连翘酚在试营中对金黄色葡萄球菌的抑菌浓度为1：5120；对痢疾杆菌为1：1280；对白喉杆菌及副伤寒(甲)杆菌为1：640，可能力抗菌有效成分。花对小鼠实验性结核病有一定疗效，对豚鼠则无效。此外，还报告过它在试管中及临床上的抗结核杆菌的作用。连翘的醇提取物在体外有抗钩端螺旋体作用，其强度不及黄连、荔枝草或金银花、黄芩，而与黄柏、蚤休相似。连翘水浸剂(1：5)在试管内对星形奴卡氏菌有些抑制作用。"}]},{"ID":"20240613111223-xqvxer7","Type":"NodeParagraph","Properties":{"id":"20240613111223-xqvxer7","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"1.2.抗真菌作用：将连翘种子挥发油乳剂以试管倍量稀释法进行抗白色和热带念珠菌的试验，结果显示该药对所试的二个菌株均有较明显的抗菌作用，其抗菌效价分别为1／1.024和1/512。"}]},{"ID":"20240613111223-vfsry8y","Type":"NodeParagraph","Properties":{"id":"20240613111223-vfsry8y","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"1.3.抗病毒作用 将连翘种子挥发油乳剂以鸡胚内法(药物浓度为1/32)和鸡胚外法进行抗亚洲甲型流感病毒和I型副流感病毒作用试验。可见连翘种子挥发油对京科68-1珠病毒在感染同时给药能显示作用，仙台株病毒在感染同时给药和感染前给药能显示作用。可以看出连翘种子挥发油乳剂在鸡胚外对京科68-1株和仙台株病毒均有显着的抗病毒作用。对所试两种病毒的抗病毒效价均为1／65，536。用斑点杂交法试验，连翘煎剂25%-100%浓度，有降低乙型肝炎病毒脱氧核糖核酸(HBVDNA)含量的作用。"}]},{"ID":"20240613111223-yvl6kfl","Type":"NodeParagraph","Properties":{"id":"20240613111223-yvl6kfl","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的影响 2.1.连翘注射液对中毒性休克时在体猫心的影响：实验用猫3只，腹腔麻醉，颈动脉插管测量血压，气管插管，连电动人工呼吸机，打开胸腔及心包，暴露心脏，用丝线将心尖联于微拉力传感仪，用三笔记录仪描记心脏舒缩曲线。实验前，先描记一段心肌舒缩波及血压曲线作为正常对照，然后静脉注射伤寒菌苗0.8-2.5ml／kg待出现较明显损害的心肌曲线(心肌舒缩波高低不齐，节律不整)，血压下降。静脉注射连翘注射液8g／kg后，心律变齐其中2只猫心肌舒缩波振幅增大，血压在30分钟后上升约40mmHg。提示有强心及升压作用。"}]},{"ID":"20240613111223-ekktc22","Type":"NodeParagraph","Properties":{"id":"20240613111223-ekktc22","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"2.2.对毛细血管通透性的影响 选健康小鼠雌雄不拘，体重18-22g，分为实验组和对照组，实验组7只动物，由尾静脉或皮下注射连翘注射液(60g/kg)，对照组9只动物，用生理盐水代替药物(0.4ml／只)。10分钟后经尾静脉注入0.5%伊文氏蓝液0.2ml／只。30分钟后，腹腔注射0.4%醋酸0.4ml／只。再30分钟后将小鼠脱血处死，打开腹腔用生理盐水冲洗腹腔渗出液，将洗出液置于5ml刻度试管至刻度，以2000转／分离心10分钟，取上清液测定其伊文氏蓝浓度。结果对照组腹腔渗出液伊文氏蓝浓度(μg%)为368.47±28.55(平均值±标准差，下同)，而实验组为160.12±28.37(P＜0.01)。表明连翘注射液对醋酸所致的毛细血管通透性有明显抑制作用。"}]},{"ID":"20240613111223-ljjkl1n","Type":"NodeParagraph","Properties":{"id":"20240613111223-ljjkl1n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"3.对离体小肠的抑制作用 实验用豚鼠，按Magnur法作离体肠标本。离体小肠置于12×l0-2连翘营养液中，共做10次试验，结果4次表现为肠张力降低，6次先升后降。收缩振幅8次减弱，2次无变化。等容量生理盐水对离体肠无影响。提示连翘对豚鼠离体小肠有抑制作用。"}]},{"ID":"20240613111223-xobo9pl","Type":"NodeParagraph","Properties":{"id":"20240613111223-xobo9pl","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"4.抑制弹性蛋白酶活力作用：连翘等稀释成每1ml含1.5g、0.75g及0.375g，3种浓度。猪胰弹性蛋白酶(PPE)稀释成19u／0.5mg·ml及9.5u／0.25mg·ml两种浓度。将19u／0.5mg·ml的酶液与上述不同浓度的药物分别等量混匀后，各取10μl，分别滴入琼脂板孔内，每一皿内均留两孔各滴10μl、9.5u／0.25mg.ml的酶液作酶溶解平行对照，37℃温育24小时后测量溶解环直径。(酶活力与溶解环直径成线性关系)。连翘抑制弹性蛋白酶活力的作用见表5。可见三种浓度的连翘均可显着抑制0.095u的PPE的酶活力(P＜0.001)，其中在7.5mg浓度时完全抑制PPE酶活力。连翘水溶性粗提物10-3g/ml、10-4g/ml对磷酸二脂酶有抑制作用。"}]},{"ID":"20240613111223-vkb8vxh","Type":"NodeParagraph","Properties":{"id":"20240613111223-vkb8vxh","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"5.抗辐射损伤。连翘甲醇提取物1g/kg腹腔注射，于X线照射前5分钟给药，对小鼠皮肤损害有防护作用。"}]},{"ID":"20240613111223-4k5025n","Type":"NodeParagraph","Properties":{"id":"20240613111223-4k5025n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613111223-qcf9rn2","Type":"NodeParagraph","Properties":{"id":"20240613111223-qcf9rn2","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，搓开，除去枝梗。"}]},{"ID":"20240613111223-0k2oxn1","Type":"NodeParagraph","Properties":{"id":"20240613111223-0k2oxn1","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613111223-3x3910n","Type":"NodeParagraph","Properties":{"id":"20240613111223-3x3910n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 肺；心；胆经"}]},{"ID":"20240613111223-s8od1la","Type":"NodeParagraph","Properties":{"id":"20240613111223-s8od1la","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613111223-a5dr2fr","Type":"NodeParagraph","Properties":{"id":"20240613111223-a5dr2fr","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 苦；性微寒"}]},{"ID":"20240613111223-ja59wq4","Type":"NodeParagraph","Properties":{"id":"20240613111223-ja59wq4","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613111223-gaafgoz","Type":"NodeParagraph","Properties":{"id":"20240613111223-gaafgoz","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 1.脾胃虚弱，气虚发热，痈疽已溃、脓稀色淡者忌服。"}]},{"ID":"20240613111223-rzqlnfk","Type":"NodeParagraph","Properties":{"id":"20240613111223-rzqlnfk","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：痈疽已溃勿服，大热由于虚者勿服，脾胃薄弱易于作泄者勿服。"}]},{"ID":"20240613111223-0i9w80k","Type":"NodeParagraph","Properties":{"id":"20240613111223-0i9w80k","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613111223-66ohm6n","Type":"NodeParagraph","Properties":{"id":"20240613111223-66ohm6n","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 清热解毒；消肿散结 风热感冒。主风热感冒；温病；热淋尿闭；痈疽；肿毒；瘰疬；瘿瘤；喉痹"}]},{"ID":"20240613111223-va86vko","Type":"NodeParagraph","Properties":{"id":"20240613111223-va86vko","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613111223-38doo7c","Type":"NodeParagraph","Properties":{"id":"20240613111223-38doo7c","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入丸、散。"}]},{"ID":"20240613111223-qxlo3u0","Type":"NodeParagraph","Properties":{"id":"20240613111223-qxlo3u0","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613111223-jkqlvju","Type":"NodeParagraph","Properties":{"id":"20240613111223-jkqlvju","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主寒热，鼠痿，瘰疬，痈肿恶疮，瘿瘤，结热。"}]},{"ID":"20240613111223-7102xb2","Type":"NodeParagraph","Properties":{"id":"20240613111223-7102xb2","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：去白虫。"}]},{"ID":"20240613111223-i5c7vkq","Type":"NodeParagraph","Properties":{"id":"20240613111223-i5c7vkq","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：主通利五淋，小便不通，除心家客热。"}]},{"ID":"20240613111223-yfxs6gh","Type":"NodeParagraph","Properties":{"id":"20240613111223-yfxs6gh","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：通小肠，排脓。治疮疖，止痛，通月经。"}]},{"ID":"20240613111223-hegiica","Type":"NodeParagraph","Properties":{"id":"20240613111223-hegiica","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"5.李杲：散诸经血结气聚；消肿。"}]},{"ID":"20240613111223-6q6e9cb","Type":"NodeParagraph","Properties":{"id":"20240613111223-6q6e9cb","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"6.王好古：治耳聋浑浑。"}]},{"ID":"20240613111223-a4ct4xd","Type":"NodeParagraph","Properties":{"id":"20240613111223-a4ct4xd","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613111223-zj1gjrs","Type":"NodeParagraph","Properties":{"id":"20240613111223-zj1gjrs","updated":"20240613111223"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613111224-zzco84u","Type":"NodeThematicBreak","Properties":{"id":"20240613111224-zzco84u"}},{"ID":"20240613111225-jius1f3","Type":"NodeParagraph","Properties":{"id":"20240613111225-jius1f3"}}]}