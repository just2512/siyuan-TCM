xt","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 369px;","style":"width: 359px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦参 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦参 10-20240806163902-n4yv68o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 359px;\" parent-style=\"width: 369px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806164817-ca8w3vj","Type":"NodeParagraph","Properties":{"id":"20240806164817-ca8w3vj","updated":"20240813151331"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦参 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦参 12-20240806164817-qt5hlds.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦参叶"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦参叶-20240624125637-9n3prq5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806162009-pvnoyon","Type":"NodeParagraph","Properties":{"id":"20240806162009-pvnoyon","updated":"20240813151333"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 322px;","style":"width: 312px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦参 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦参 8-20240806163025-psqzb2v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 312px;\" parent-style=\"width: 322px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 899px;","style":"width: 889px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦参 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦参 18-20240806165722-clgv6t5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 889px;\" parent-style=\"width: 899px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806150435-tmkjax0","Type":"NodeParagraph","Properties":{"id":"20240806150435-tmkjax0","updated":"20240806163733"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：苦参跟黄芪相似，黄芪叶片小且尾部较圆，苦参叶片狭长且尾部较尖；黄芪茎杆有绒毛且较软，苦参茎杆没有毛且较硬，较光滑；苦参的豆荚细而长，黄芪的豆荚短而宽；还有黄芪茎杆咀嚼有豆腥味，苦参茎杆咀嚼是苦味；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240506114745-6o7wf4i","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"058黄耆（黄芪）"}]},{"ID":"20240806165901-790d1cw","Type":"NodeParagraph","Properties":{"id":"20240806165901-790d1cw","updated":"20240806165926"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：苦参比黄连还要苦，可以称之为最苦的本草；"}]},{"ID":"20240611135033-qlccad2","Type":"NodeThematicBreak","Properties":{"id":"20240611135033-qlccad2"}},{"ID":"20240611135045-o5ihb1s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611135045-o5ihb1s","updated":"20240611135049"},"Children":[{"Type":"NodeText","Data":"苦参《汤液本草》"}]},{"ID":"20240611135045-3qx4sjh","Type":"NodeParagraph","Properties":{"id":"20240611135045-3qx4sjh","updated":"20240611135045"},"Children":[{"Type":"NodeText","Data":"气寒，味苦，气沉，纯阴。"}]},{"ID":"20240611135045-x1191sx","Type":"NodeParagraph","Properties":{"id":"20240611135045-x1191sx","updated":"20240611135045"},"Children":[{"Type":"NodeText","Data":"《心》云∶除湿。"}]},{"ID":"20240611135045-6fxbhac","Type":"NodeParagraph","Properties":{"id":"20240611135045-6fxbhac","updated":"20240611135045"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主心腹结气，症瘕积聚，黄胆，溺有余沥，逐水除痈肿，补中，明目止泪。养肝胆气，安五脏，定志益精，利九窍，除伏热肠 ，止渴醒酒，小便黄赤，疗恶疮，下部 ，平胃气，令人嗜食轻身。"}]},{"ID":"20240611135045-b062m9q","Type":"NodeParagraph","Properties":{"id":"20240611135045-b062m9q","updated":"20240611135045"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶有人病遍身风热细疹，痒痛不可任，连胸颈脐腹近阴处皆然，涎痰亦多，夜不得睡。以苦参末一两，皂角二两，水一升，揉滤取汁，银、石器熬成膏，和苦参末为丸，如梧桐子大，食后温水下二十丸至三十丸。次日便愈。"}]},{"ID":"20240611135045-7jj3fup","Type":"NodeParagraph","Properties":{"id":"20240611135045-7jj3fup","updated":"20240611135045"},"Children":[{"Type":"NodeText","Data":"《时习》云∶苦参揩齿，久能病腰。"}]},{"ID":"20240611135033-w9lh1oy","Type":"NodeThematicBreak","Properties":{"id":"20240611135033-w9lh1oy"}},{"ID":"20240611135034-txo9p4t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611135034-txo9p4t","updated":"20240611135038"},"Children":[{"Type":"NodeText","Data":"苦参《本经逢原》"}]},{"ID":"20240611135034-nmxao98","Type":"NodeParagraph","Properties":{"id":"20240611135034-nmxao98","updated":"20240611135034"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。反藜芦。"}]},{"ID":"20240611135034-20kxxnu","Type":"NodeParagraph","Properties":{"id":"20240611135034-20kxxnu","updated":"20240611135034"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹结气，症瘕积聚，黄瘅，溺有余沥，逐水，除痈肿，补中，明目，止泪。"}]},{"ID":"20240611135034-sq86ufh","Type":"NodeParagraph","Properties":{"id":"20240611135034-sq86ufh","updated":"20240611135034"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"苦参、黄 之苦寒下降，皆能益肾，盖取其苦燥湿寒除热也。热生风，湿生虫，故又能治风杀虫。惟肾水烁而相火胜者宜之。若脾胃虚而饮食减少，肝肾虚而火衰精冷，及年高之人不可用也。久服苦参多致腰重，因其性降而不升也。观《本经》主治皆湿热为患之病，详补中当是补阴之误，以其能除湿热，湿热去而阴自复，目自明矣。然惟湿热者宜之。"}]},{"ID":"20240611135034-rlfv4xe","Type":"NodeParagraph","Properties":{"id":"20240611135034-rlfv4xe","updated":"20240611135034"},"Children":[{"Type":"NodeText","Data":"沈存中苦腰重，久坐不能行，此因病齿痛数年，用苦参揩齿，其气味入齿伤肾所致也。后施昭先亦用苦参揩齿，岁久亦病腰重，自后悉不用之，腰疾皆愈。或云∶苦参既能补阴明目，何久服反病腰重乎，殊不知苦寒之性直入心肾，内有湿热者，足以当之。始得之，则有辅阴祛邪之力，清热明目之功，湿热既去而又服之，必致苦寒伤肾，腰重脚弱在所不免，理固然也，何疑之有。"}]},{"ID":"20240611134958-rti961u","Type":"NodeThematicBreak","Properties":{"id":"20240611134958-rti961u"}},{"ID":"20240611135019-xzjvx1x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611135019-xzjvx1x","updated":"20240611135024"},"Children":[{"Type":"NodeText","Data":"苦参《本草图经》"}]},{"ID":"20240611135019-obim2w0","Type":"NodeParagraph","Properties":{"id":"20240611135019-obim2w0","updated":"20240611135027"},"Children":[{"Type":"NodeText","Data":"苦参，生汝南山谷及田野，今近道处处皆有之。其根黄色，长五、七寸许，两指粗细；三、五茎并生，苗高三、二尺以来；叶碎青色，极似槐叶，故有水槐名，春生冬凋；其花黄白，七月结实如小豆子。河北生者无花子。五月、六月、八月、十月采根，曝干用。古今方用治疮疹最多，亦可治癞疾。其法∶用苦参五斤，切，以好酒三斗，渍三十日，每饮一合，日三。"}]},{"ID":"20240611135019-4ssprc4","Type":"NodeParagraph","Properties":{"id":"20240611135019-4ssprc4","updated":"20240611135019"},"Children":[{"Type":"NodeText","Data":"常服不绝，若觉痹，即瘥。取根皮末服之，亦良。"}]},{"ID":"20240611134958-xr62brs","Type":"NodeThematicBreak","Properties":{"id":"20240611134958-xr62brs"}},{"ID":"20240611135010-0oyf5d0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611135010-0oyf5d0","updated":"20240611135014"},"Children":[{"Type":"NodeText","Data":"苦参《本草衍义》"}]},{"ID":"20240611135010-xf5ttze","Type":"NodeParagraph","Properties":{"id":"20240611135010-xf5ttze","updated":"20240611135010"},"Children":[{"Type":"NodeText","Data":"有朝士苦腰重，久坐，旅拒十余步，然后能行。有一将佐谓朝士曰∶见公日逐以药揩齿，得无用苦参否？曰∶始以病齿，用苦参已数年。此病由苦参入齿，其气味伤肾，故使人腰重。后有太常少卿舒昭亮，用苦参揩齿，岁久亦病腰。自后悉不用，腰疾皆愈，此皆方书旧不载者。有人病遍身风热细疹，痒痛不可任，连胸颈脐腹及近隐处皆然，涎痰亦多，夜不得睡。以苦参末一两，皂角二两，水一升，揉滤取汁，银石器熬成膏，和苦参末为丸，如梧桐子大，食后温水服二十至三十丸，次日便愈。"}]},{"ID":"20240611134958-ckj0j8r","Type":"NodeThematicBreak","Properties":{"id":"20240611134958-ckj0j8r"}},{"ID":"20240611134959-i9f68ca","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134959-i9f68ca","updated":"20240611135004"},"Children":[{"Type":"NodeText","Data":"苦参《本草从新》"}]},{"ID":"20240611134959-ngn23js","Type":"NodeParagraph","Properties":{"id":"20240611134959-ngn23js","updated":"20240611134959"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻湿热、祛风．"}]},{"ID":"20240611134959-61aoqcs","Type":"NodeParagraph","Properties":{"id":"20240611134959-61aoqcs","updated":"20240611134959"},"Children":[{"Type":"NodeText","Data":"大苦燥湿．大寒胜热．沉降入肾．消痈解毒．明目止泪．（泪为肝热．）治梦遗滑精．（白术牡蛎倍之、雄猪肚丸、亦治赤白带下．）热痢血痢．（纯下清血者、风伤肝也、宜散风凉血．）肠风泻血．溺赤黄胆．又能祛风（热极生风．）杀虫．（虫因湿生．）治大风疥癞眉脱．又能解酒毒．（酒为湿热之最．）肝肾虚而无热者忌．（其气能伤肾、沈括梦溪笔谈云∶久用苦参擦牙、逐病腰痛、由其气伤肾也．）糯米泔浸去腥气．蒸．元参为使．恶贝母、菟丝、漏芦．反藜芦．"}]},{"ID":"20240611134916-shhrid3","Type":"NodeThematicBreak","Properties":{"id":"20240611134916-shhrid3"}},{"ID":"20240611134947-10rvjma","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134947-10rvjma","updated":"20240611134953"},"Children":[{"Type":"NodeText","Data":"苦参《神农本草经赞》"}]},{"ID":"20240611134947-29jcfod","Type":"NodeParagraph","Properties":{"id":"20240611134947-29jcfod","updated":"20240611134947"},"Children":[{"Type":"NodeText","Data":"味苦寒。主心腹结气。症瘕积聚。黄胆。溺有余沥。逐水除痈肿。补中明目止泪。一名水槐。一名苦。生山谷及田野。"}]},{"ID":"20240611134947-hyqn6j5","Type":"NodeParagraph","Properties":{"id":"20240611134947-hyqn6j5","updated":"20240611134947"},"Children":[{"Type":"NodeText","Data":"骈茎三五。萌春催。名别菜。叶类骄槐。疏风齿固。遏气腰。患增偏胜。化变心裁。"}]},{"ID":"20240611134947-9702zuo","Type":"NodeParagraph","Properties":{"id":"20240611134947-9702zuo","updated":"20240611134947"},"Children":[{"Type":"NodeText","Data":"苏颂曰。根三五茎并生。春生冬凋。李时珍曰。与菜苦同名异物。陶弘景曰。叶极似槐叶。别录。一名骄槐。史记传。齐大夫病龋齿。以苦参汤日漱三升。出入其风。胡震亨曰。苦参峻补阴或致腰重者。气降而不升也。"}]},{"ID":"20240611134947-toww70s","Type":"NodeParagraph","Properties":{"id":"20240611134947-toww70s","updated":"20240611134947"},"Children":[{"Type":"NodeText","Data":"张从正曰。苦参久服必有偏胜气增之患。易。化而裁之谓之变。"}]},{"ID":"20240611134917-xg18bje","Type":"NodeThematicBreak","Properties":{"id":"20240611134917-xg18bje"}},{"ID":"20240611134935-zllf9dz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134935-zllf9dz","updated":"20240611134943"},"Children":[{"Type":"NodeText","Data":"苦参《本草便读》"}]},{"ID":"20240611134935-1d6h7sa","Type":"NodeParagraph","Properties":{"id":"20240611134935-1d6h7sa","updated":"20240611134935"},"Children":[{"Type":"NodeText","Data":"大苦大寒．纯阴纯降．达心脾而及肾．三经湿热尽蠲除．治疥癞与诸疮．下部火邪都涣散．梦遗精滑．皆缘湿火为殃．血痢肠红．并是阳邪作咎．若治黄瘅积聚．宣泄中州．至其逐水杀虫．流通火腑．（苦参苦寒沉降之品．宜入肾脏血分．多服则腰重不能行立．以其降性太过．伤肾伤骨也．非下焦湿火炽盛者．不宜用之．其所以能治风杀虫．亦热生风湿生虫耳．宜用于洗方丸方中为佳．若煎方不可多用．）"}]},{"ID":"20240611134917-rprv0rm","Type":"NodeThematicBreak","Properties":{"id":"20240611134917-rprv0rm"}},{"ID":"20240611134918-e3vo6j0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134918-e3vo6j0","updated":"20240611134923"},"Children":[{"Type":"NodeText","Data":"苦参《长沙药解》"}]},{"ID":"20240611134918-u1u7nef","Type":"NodeParagraph","Properties":{"id":"20240611134918-u1u7nef","updated":"20240611134918"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主心腹结气，癥瘕积聚，黄疸，溺有余沥，逐水，除痈肿，补中，明目，止泪。一名水槐，一名苦识。生山谷及田野。"}]},{"ID":"20240611134918-gibo9nl","Type":"NodeParagraph","Properties":{"id":"20240611134918-gibo9nl","updated":"20240611134918"},"Children":[{"Type":"NodeText","Data":"味苦，性寒，入足厥阴肝、足太阳膀胱经。清乙木而杀虫，利壬水而泻热。"}]},{"ID":"20240611134918-t2cb5os","Type":"NodeParagraph","Properties":{"id":"20240611134918-t2cb5os","updated":"20240611134918"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦参汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"苦参一斤，煎汤熏洗。"},{"Type":"NodeText","Data":"治狐惑蚀于下部者。以肝主筋，前阴者，宗筋之聚，土湿木陷，郁而为热，化生虫（匿/虫虫），蚀于前阴。苦参清热而去湿，疗疮而杀虫也。"}]},{"ID":"20240611134918-qymggce","Type":"NodeParagraph","Properties":{"id":"20240611134918-qymggce","updated":"20240611134918"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当归贝母苦参丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在当归。"},{"Type":"NodeText","Data":"用之治妊娠小便难，以土湿木陷，郁而生热，不能泄水，热传膀胱，以致便难。苦参清湿热而通淋涩也。"}]},{"ID":"20240611134918-a9jiswq","Type":"NodeParagraph","Properties":{"id":"20240611134918-a9jiswq","updated":"20240611134918"},"Children":[{"Type":"NodeText","Data":"苦参苦寒之性，清乙木之瘀热而杀虫（匿/虫虫），泻壬水之热涩而开癃闭。其诸主治，疗鼻齆，止牙痛，消痈肿，除疥癞，平瘰疬，调痔漏，治黄疸、红痢、齿衄、便血。"}]},{"ID":"20240611134856-iw9vdo2","Type":"NodeThematicBreak","Properties":{"id":"20240611134856-iw9vdo2"}},{"ID":"20240611134906-yxq9a4c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134906-yxq9a4c","updated":"20240611134911"},"Children":[{"Type":"NodeText","Data":"苦参《神农本草经》"}]},{"ID":"20240611134906-emyzwh7","Type":"NodeParagraph","Properties":{"id":"20240611134906-emyzwh7","updated":"20240611134906"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240611134906-f6w84ng","Type":"NodeParagraph","Properties":{"id":"20240611134906-f6w84ng","updated":"20240611134906"},"Children":[{"Type":"NodeText","Data":"主心腹结气，症瘕积聚，黄疸，溺有余沥，逐水，除痈肿，补中，明目，止泪。一名水槐，一名苦识。生山谷及田野。"}]},{"ID":"20240611134906-0fgqbch","Type":"NodeParagraph","Properties":{"id":"20240611134906-0fgqbch","updated":"20240611134906"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名地槐，一名菟槐，一名骄槐，一名白茎，一名虎麻，一名芩茎，一名禄曰，一名陵郎，生汝南，三月八月十月，采根，暴干。"}]},{"ID":"20240611134856-pe36my9","Type":"NodeThematicBreak","Properties":{"id":"20240611134856-pe36my9"}},{"ID":"20240611134855-zdxvidy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134855-zdxvidy","updated":"20240611134902"},"Children":[{"Type":"NodeText","Data":"苦参《本草分经》"}]},{"ID":"20240611134855-l37lcyi","Type":"NodeParagraph","Properties":{"id":"20240611134855-l37lcyi","updated":"20240611134855"},"Children":[{"Type":"NodeText","Data":"大苦大寒，沉阴主肾，燥湿胜热，养肝胆利九窍，祛风逐水，解毒杀虫。"}]},{"ID":"20240611134831-0n16pta","Type":"NodeThematicBreak","Properties":{"id":"20240611134831-0n16pta"}},{"ID":"20240611134842-cfnmi3e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134842-cfnmi3e","updated":"20240611134849"},"Children":[{"Type":"NodeText","Data":"苦参《神农本草经读》"}]},{"ID":"20240611134842-89vmomu","Type":"NodeParagraph","Properties":{"id":"20240611134842-89vmomu","updated":"20240611134842"},"Children":[{"Type":"NodeText","Data":"气味苦、寒。主心腹结气，症瘕积聚，黄胆，溺有余沥。逐水，除痈肿，补中，明目止泪。"}]},{"ID":"20240611134842-bvsta8f","Type":"NodeParagraph","Properties":{"id":"20240611134842-bvsta8f","updated":"20240611134842"},"Children":[{"Type":"NodeText","Data":"徐灵胎曰∶此以味为治也。苦入心，寒除火，故苦参专治心经之火，与黄连功用相近。"}]},{"ID":"20240611134842-p55vocu","Type":"NodeParagraph","Properties":{"id":"20240611134842-p55vocu","updated":"20240611134842"},"Children":[{"Type":"NodeText","Data":"但黄连似去心脏之火为多，苦参似去心府小肠之火为多；则以黄连之气味清，而苦参之气味浊也。（按∶“补中”二字，亦取其苦以燥脾之义也）。"}]},{"ID":"20240611134832-u221gl6","Type":"NodeThematicBreak","Properties":{"id":"20240611134832-u221gl6"}},{"ID":"20240611134833-7uycwsd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134833-7uycwsd","updated":"20240611134838"},"Children":[{"Type":"NodeText","Data":"苦参《本草择要纲目》"}]},{"ID":"20240611134833-fuqut6q","Type":"NodeParagraph","Properties":{"id":"20240611134833-fuqut6q","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"（采根．用糯米浓泔水汁浸一宿．其醒秽气并浮在水面上．须重重淘过．即蒸之．从巳至申．取晒切用．）"}]},{"ID":"20240611134833-6pgn7tp","Type":"NodeParagraph","Properties":{"id":"20240611134833-6pgn7tp","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611134833-6f4uzd2","Type":"NodeParagraph","Properties":{"id":"20240611134833-6f4uzd2","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"苦寒无毒．气沉纯阴．入足少阴肾经君药也．"}]},{"ID":"20240611134833-76gfe3h","Type":"NodeParagraph","Properties":{"id":"20240611134833-76gfe3h","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611134833-a6ux1ge","Type":"NodeParagraph","Properties":{"id":"20240611134833-a6ux1ge","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"心腹结气症瘕积聚黄胆．溺有余沥．逐水．除痈肿．补中明目止泪．治腹中冷痛．中恶腹痛．养肝胆气．安五脏．平胃气．令人嗜食．轻身定志．益精利九窍．除伏热肠癖．止渴醒酒．小便黄赤．疗恶疮下部 ．治恶虫胫酸．杀疳虫．炒存性米饮服．治肠风泻血并热痢．渍酒饮治疥杀虫．生疮赤癞眉脱．除大热嗜睡．治热毒风皮肌烦躁．李时珍曰．子午乃少阴君火对化．故苦参黄柏之苦寒．皆能补肾．盖取其苦燥湿寒除热也．热生风．湿生虫．故又能治风杀虫．惟肾水弱而相火胜者用之相宜．若火衰精冷．真元不足．及年高之人不可用耳．"}]},{"ID":"20240611134833-2opbvlh","Type":"NodeParagraph","Properties":{"id":"20240611134833-2opbvlh","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"【恶】（贝母 兔丝 漏芦）"}]},{"ID":"20240611134833-5339f99","Type":"NodeParagraph","Properties":{"id":"20240611134833-5339f99","updated":"20240611134833"},"Children":[{"Type":"NodeText","Data":"【反】（藜芦）"}]},{"ID":"20240611134740-wi8sp34","Type":"NodeThematicBreak","Properties":{"id":"20240611134740-wi8sp34"}},{"ID":"20240611134816-iwfau7d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134816-iwfau7d","updated":"20240611134823"},"Children":[{"Type":"NodeText","Data":"苦参《本草纲目》"}]},{"ID":"20240611134816-tqlbzds","Type":"NodeParagraph","Properties":{"id":"20240611134816-tqlbzds","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"「释名」亦名苦、苦骨、地槐、水槐、菟槐、骄槐、野槐、白茎。"}]},{"ID":"20240611134816-8p840lb","Type":"NodeParagraph","Properties":{"id":"20240611134816-8p840lb","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"「气味」苦、寒、无毒。"}]},{"ID":"20240611134816-vly9jiu","Type":"NodeParagraph","Properties":{"id":"20240611134816-vly9jiu","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611134816-fxcr13d","Type":"NodeParagraph","Properties":{"id":"20240611134816-fxcr13d","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"1、热病发狂。用苦参末，加蜜调成丸子，如梧子大。每服十丸，薄荷汤送下。也可用苦参末二钱，水煎服。"}]},{"ID":"20240611134816-cux1amw","Type":"NodeParagraph","Properties":{"id":"20240611134816-cux1amw","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"2、伤寒结胸（伤寒流行时，感病四、五日，胸满痛，大发烧）。用苦参一两，加醋三升，煮成一升二合，服后能吐即愈。"}]},{"ID":"20240611134816-vebld08","Type":"NodeParagraph","Properties":{"id":"20240611134816-vebld08","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"3、谷疸（头昏、心慌、发黄。这是大病后暴食伤胃所引起）。用苦参二两、龙胆一合，共研为末，加牛胆调药成丸，如梧子大。每服五丸，生大麦煎汁送下。一天服三次。"}]},{"ID":"20240611134816-ohecb2i","Type":"NodeParagraph","Properties":{"id":"20240611134816-ohecb2i","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"4、毒热足肿。用苦参煮酒多擦。"}]},{"ID":"20240611134816-r1r1f7l","Type":"NodeParagraph","Properties":{"id":"20240611134816-r1r1f7l","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"5、梦遗食减。用苦参三两、白术五两、牡蛎粉四两，共三为末；另取雄猪肚一个，洗净，在沙罐中煮烂，和药捣匀，做成丸子，如小豆大。每服四十丸，米汤送下。每天服三次。久服能使身体转健，食量增加，不再梦遗。"}]},{"ID":"20240611134816-7hkyqg3","Type":"NodeParagraph","Properties":{"id":"20240611134816-7hkyqg3","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"6、饮食中毒。用苦参三两，苦酒一升半，煮成八合，分两次服，取吐即愈。"}]},{"ID":"20240611134816-u9qddza","Type":"NodeParagraph","Properties":{"id":"20240611134816-u9qddza","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"7、血痢。用苦参炒焦为末，滴水做成丸子，如梧子大。每服十五丸，米汤送下。"}]},{"ID":"20240611134816-lkhdjlt","Type":"NodeParagraph","Properties":{"id":"20240611134816-lkhdjlt","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"8、脱肛。用苦参、五倍子、陈壁土等分，煎汤洗患处，并以木贼末敷上。"}]},{"ID":"20240611134816-w4am1aq","Type":"NodeParagraph","Properties":{"id":"20240611134816-w4am1aq","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"9、齿缝出血。用苦参一两、枯矾一钱，共研为末。一天擦齿三次，有效。"}]},{"ID":"20240611134816-xorc5q7","Type":"NodeParagraph","Properties":{"id":"20240611134816-xorc5q7","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"10、鼻疮流脓发臭。用苦参、枯矾各一两，生地黄汁三合，加水煎浓，随时滴疮上。"}]},{"ID":"20240611134816-zspja60","Type":"NodeParagraph","Properties":{"id":"20240611134816-zspja60","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"11、遍身风疹（痛不可忍，涎痰多，夜难睡）。用苦参末一两，另用皂角二两，在水一升中揉滤取汁，瓦器内熬成膏，和药末做成丸子，如梧子大。每服三十丸，饭后服，温水送下。"}]},{"ID":"20240611134816-sutrjoe","Type":"NodeParagraph","Properties":{"id":"20240611134816-sutrjoe","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"12、大风癞（按：即麻风）。用苦参五两，切片，浸在酒三斗中，过一个月后，每取取酒饮一合。一天三次。宜常服不断。又方：苦参末二两，缝在猪肚子中煮熟，把药去掉。病人先饿一天，第二天早晨，饮清水一碗后，即取食猪肚，如吐出，须再吃。过一、二时后，以肉汤调“无忧散”五、六钱服下。有恶物排出时，即为见效。再服皂角一斤（去皮，去子）煮汁，汁中调入苦参末，另加何首乌末二两、防风末一两半、当归末一两、芍药末五钱、人参末三钱，一起做成丸子，如梧子大。每服三十至五十丸，温酒或茶送下。一天服三次。同时，还用麻黄、苦参、荆芥煎水洗癞。又方：治大风癞及热毒、风疮、疥癣等，用苦参（去皮，晒干）一斤、枳壳（麸炒）六两，共研为末，加蜜为丸，如梧子大。每服三十丸，温酒送下。一天服三次（白天两次，夜间一次）。"}]},{"ID":"20240611134816-0hn0kz9","Type":"NodeParagraph","Properties":{"id":"20240611134816-0hn0kz9","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"13、皮肤疥癞，手足坏烂，时出黄水。用苦参三十一两、荆芥穗十六两，共研为末，滴水糊成丸子，如梧子大。每服三十丸，茶送下。"}]},{"ID":"20240611134816-1lsu0tz","Type":"NodeParagraph","Properties":{"id":"20240611134816-1lsu0tz","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"14、上下诸瘘（或在颈部，或在下部）。用苦参五升，在苦酒一斗中浸泡三、四天后服下。"}]},{"ID":"20240611134816-diwavtr","Type":"NodeParagraph","Properties":{"id":"20240611134816-diwavtr","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"15、瘰疬结核。用苦参末四两，加牛膝汁调成丸子，如绿豆大。每服二十丸，热开水送下。"}]},{"ID":"20240611134816-xvqjte0","Type":"NodeParagraph","Properties":{"id":"20240611134816-xvqjte0","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"16、汤火伤。用油调苦参末敷伤处。"}]},{"ID":"20240611134816-18ax6xf","Type":"NodeParagraph","Properties":{"id":"20240611134816-18ax6xf","updated":"20240611134816"},"Children":[{"Type":"NodeText","Data":"18、赤白带下。用苦参二两、牡蛎粉一两五钱，共研为末；另以雄猪肚一个，在水三碗中煮烂后，再捣成泥，和药末做成丸子，如梧子大。每服百丸，温酒送下。"}]},{"ID":"20240611134740-3eyyzvk","Type":"NodeThematicBreak","Properties":{"id":"20240611134740-3eyyzvk"}},{"ID":"20240611134746-1vhzjd0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134746-1vhzjd0","updated":"20240611134752"},"Children":[{"Type":"NodeText","Data":"苦参《神农本草经百种录》"}]},{"ID":"20240611134746-qb3nqqs","Type":"NodeParagraph","Properties":{"id":"20240611134746-qb3nqqs","updated":"20240611134746"},"Children":[{"Type":"NodeText","Data":"味苦寒。主心腹结气，苦入心，以散热结之气。症瘕积聚，苦极则能泄。黄胆，寒能除郁热。溺有余沥，心通于小肠，心火除则小肠郁塞之气通矣。逐水，小肠通则水去。除痈肿诸疮皆属心火，心火清则痈肿自去也。补中，《内经》云∶脾苦湿，急食苦以燥之，即此义也。明目止泪。寒清肝火，苦除肝湿。"}]},{"ID":"20240611134746-z87xohz","Type":"NodeParagraph","Properties":{"id":"20240611134746-z87xohz","updated":"20240611134746"},"Children":[{"Type":"NodeText","Data":"此以味为治也，苦入心，寒除火，故苦参专治心经之火，与黄连功用相近。但黄连似去心脏之火为多，苦参似去心腑小肠之火为多。则以黄连之气味清，而苦参之气味浊也。"}]},{"ID":"20240611134327-4zpgfka","Type":"NodeThematicBreak","Properties":{"id":"20240611134327-4zpgfka"}},{"ID":"20240611134732-1fjab9u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134732-1fjab9u","updated":"20240611134737"},"Children":[{"Type":"NodeText","Data":"苦参《本草备要》"}]},{"ID":"20240611134732-d967mmg","Type":"NodeParagraph","Properties":{"id":"20240611134732-d967mmg","updated":"20240611134732"},"Children":[{"Type":"NodeText","Data":"泻火，燥湿，补阴"}]},{"ID":"20240611134732-b701878","Type":"NodeParagraph","Properties":{"id":"20240611134732-b701878","updated":"20240611134732"},"Children":[{"Type":"NodeText","Data":"苦燥湿，寒胜热。沉阴主肾。补阴益精，养肝胆，安五脏（湿热去则血气和平，而五脏自安）利九窍，生津止渴，明目止泪（泪为肝热）。"}]},{"ID":"20240611134732-pech7nj","Type":"NodeParagraph","Properties":{"id":"20240611134732-pech7nj","updated":"20240611134732"},"Children":[{"Type":"NodeText","Data":"治温病血痢（纯下清血者，风伤肝也，宜散风凉血；下如豆汁者，湿伤脾也，宜清热渗湿），肠风溺赤，黄胆酒毒。热生风，湿生虫，又能祛风、逐水、杀虫，治大肠疥癞。然大苦大寒，肝、肾虚而无热者勿服（张从正曰∶凡药皆毒也，虽苦参、甘草，不可不谓之毒，久服必偏胜为患。经曰∶五味入胃，各归其所喜攻，久而增气，物化之常也。气增而久，夭之由也。王冰注曰∶气增不已，则脏有偏胜，偏胜则脏有偏绝，故令人暴夭。《笔谈》曰∶久用苦参擦牙，遂病腰痛，由其气伤肾也。经又曰∶大毒治病，十去其六；常毒治病，十去其七；小毒治病，十去其八；无毒治病，十去其九。谷肉果菜，食养尽之，无使过之，伤其正也。按∶人参补脾，沙参补肺，紫参补肝，丹参补心，玄参补肾。苦参不在五参之内，然名参者皆补也。药能医病，不能养人，食能养人，不能医病）。"}]},{"ID":"20240611134732-zggppou","Type":"NodeParagraph","Properties":{"id":"20240611134732-zggppou","updated":"20240611134732"},"Children":[{"Type":"NodeText","Data":"糯米泔浸去腥气，蒸用。玄参为使。恶贝母，菟丝子、漏芦。反藜芦（苦参一两，或酒煎，或醋煮，能吐天行时毒）。"}]},{"ID":"20240611134649-0htuf3f","Type":"NodeThematicBreak","Properties":{"id":"20240611134649-0htuf3f"}},{"ID":"20240611134715-j8p5yq9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134715-j8p5yq9","updated":"20240611134722"},"Children":[{"Type":"NodeText","Data":"苦参《医学入门》"}]},{"ID":"20240611134715-pwo30bc","Type":"NodeParagraph","Properties":{"id":"20240611134715-pwo30bc","updated":"20240611134715"},"Children":[{"Type":"NodeText","Data":"苦参气寒吐大热，平胃能除心腹结，逐水利疸破 瘕，大风恶疮虫疥杀。"}]},{"ID":"20240611134715-nr97axc","Type":"NodeParagraph","Properties":{"id":"20240611134715-nr97axc","updated":"20240611134715"},"Children":[{"Type":"NodeText","Data":"味至苦，入口则吐。无毒。沉也，纯阴，入足少阳经。主时气恶病大热，伏热结胸，用此为末，醋调吐之。平胃气补中，养肝胆气，安五脏，定志益精，利九窍。治疸逐水，除心腹结气 瘕积聚，及大风赤癞眉脱，遍身胸胫脐腹近阴处生风热细疥痒痛，杀疥疮虫、下部 。又能明目止泪，治卒心痛、肠 热痢、热毒风、皮肤烦躁止渴醒酒，狂邪发恶，饮食中毒。丹溪云∶苦参属水而有火，能峻补阴气。有用揩齿而致腰重者，以其气降而不升，非伤肾之谓也。胃弱者慎用。"}]},{"ID":"20240611134715-4irlv1u","Type":"NodeParagraph","Properties":{"id":"20240611134715-4irlv1u","updated":"20240611134715"},"Children":[{"Type":"NodeText","Data":"糯米泔浸一宿，蒸三时久，晒干，少入汤药，多作丸服。治疮，浸酒；治肠风，炒至烟起为末。玄参为使，恶贝母、菟丝子，反藜芦。"}]},{"ID":"20240611134649-qohhiya","Type":"NodeThematicBreak","Properties":{"id":"20240611134649-qohhiya"}},{"ID":"20240611134651-uclyn5b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134651-uclyn5b","updated":"20240611134655"},"Children":[{"Type":"NodeText","Data":"苦参《本草新编》"}]},{"ID":"20240611134651-mfbvmee","Type":"NodeParagraph","Properties":{"id":"20240611134651-mfbvmee","updated":"20240611134651"},"Children":[{"Type":"NodeText","Data":"苦参，味苦，气寒，沉也，纯阴，无毒。入心、肝、肾、大肠之经。治肠风下血，热痢刮痛难当，疗狂言心燥，结胸垂死；赤癞眉脱者，祛风有功；黄胆遗溺者，逐水立效。扫遍身痒疹，止卒暴心疼，杀疥虫，破症瘕，散结气，明目止泪，解渴生津，利九窍，通大便。第过于迅利，宜少用为佐使，不宜多用为君臣。至称益肾、安五脏、定心志，不可信之辞也。"}]},{"ID":"20240611134651-yv5qdj5","Type":"NodeParagraph","Properties":{"id":"20240611134651-yv5qdj5","updated":"20240611134651"},"Children":[{"Type":"NodeText","Data":"或问苦参非益肾之药，夫人而知之也，但未知其所以损肾之故乎？苦参之不益肾，岂待问哉。沉寒败肾，必有五更泄利之病；苦寒泻肾，必有少腹作痛之 。苦参味苦而寒，气沉而降，安得不败肾而泻肾乎。而五更泄利，小腹作痛，必不能免矣。败泻肾气，而反言益肾，殊不可解，愿吾子勿信也。"}]},{"ID":"20240611134327-bopptp4","Type":"NodeThematicBreak","Properties":{"id":"20240611134327-bopptp4"}},{"ID":"20240611134637-o44w1qk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134637-o44w1qk","updated":"20240611134643"},"Children":[{"Type":"NodeText","Data":"苦参《本草述钩元》"}]},{"ID":"20240611134637-gh3xtaf","Type":"NodeParagraph","Properties":{"id":"20240611134637-gh3xtaf","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"河北生者无花子。五六十月采根。曝干用。"}]},{"ID":"20240611134637-x3bezoo","Type":"NodeParagraph","Properties":{"id":"20240611134637-x3bezoo","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"味至苦。气寒而沉。纯阴之剂。足少阴肾经君药也。苦燥湿。兼泄气分之热。寒以除血分之热。热生风。湿生虫。故又能治风杀虫。惟肾水弱而相火旺者。用之相宜。疗时气恶病。"}]},{"ID":"20240611134637-nskm9kr","Type":"NodeParagraph","Properties":{"id":"20240611134637-nskm9kr","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"大热狂邪。或结胸壮热。行结热。心腹结气积聚。小腹积热苦痛。利疸热。逐水。治伏热肠。热毒风。皮肤烦燥。生疮。（古今方治风热疮疹最多）赤癞眉脱。及下部。（诸本草）炒存性。米饮服。杀疳虫。渍酒饮。治疥杀虫。又治疠风鼻。方书治消瘅痿厥。中风虚劳。"}]},{"ID":"20240611134637-bporuhm","Type":"NodeParagraph","Properties":{"id":"20240611134637-bporuhm","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"虚烦盗汗。胀满痰饮。身体痛着痹。滞下痔疮。小便不通及不禁。禀润下之寒化。合从至阴。"}]},{"ID":"20240611134637-x9toe10","Type":"NodeParagraph","Properties":{"id":"20240611134637-x9toe10","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"对待火热为因。积聚为证者。（之颐）苦参峻补阴气。（子午乃少阴君火对化。故苦参黄柏之苦寒。皆能补肾。）或得之而致腰重者。因其气降而不升。非伤肾之谓也。（丹溪）本草又谓苦参养肝胆。平胃气。本经更言补中。盖血热不能养肝胆。则风木自来侮土。而胃气不平。"}]},{"ID":"20240611134637-knwmyz7","Type":"NodeParagraph","Properties":{"id":"20240611134637-knwmyz7","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"即以病于中气。三者常相因也。同胡麻刺蒺藜荆芥穗甘菊白芷当归川芎地黄天冬首乌牛膝漆叶秦艽龙胆草。治大麻风。同牡蛎粉白术青黛。治童子胃热。羸瘦疳蛔。腊月米醋渍入瓮中。封固。主一切天行热病。头疼口渴身热。饮碗许。得吐则愈。汗亦如之。热病狂邪。"}]},{"ID":"20240611134637-p5vqqhs","Type":"NodeParagraph","Properties":{"id":"20240611134637-p5vqqhs","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"不避水火。欲杀人。苦参末。蜜丸梧子大。每服十丸。薄荷汤下。亦可为末二钱煎服。天行病四五日。结胸满痛壮热者。苦参一两。以醋三升。煮取一升二合。饮之取吐。"}]},{"ID":"20240611134637-8jbkpww","Type":"NodeParagraph","Properties":{"id":"20240611134637-8jbkpww","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"即愈。小腹热痛。青黑或赤色。不能喘者。苦参一两。醋一升半。煎八合。分二服。遍身风疹。（胸颈脐腹及近隐处皆然）痒痛不可忍。（始而痒。抓之则痛。渐渐赤烂。遍体无皮。"}]},{"ID":"20240611134637-iq4jmgs","Type":"NodeParagraph","Properties":{"id":"20240611134637-iq4jmgs","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"发肿。流脓水。）作丹毒治愈甚。惟用皂角二两。水一升揉摅取汁。瓦器熬成膏。和苦参末一两。丸梧子大。温汤下三十丸。仍以苦参煎水洗之。湿烂者末渗之。次日即愈。此味解热杀虫。治疥洗热疮甚效。大风癞疾。苦参五两切。以好酒三斗渍三十日。每饮一合。日三服。"}]},{"ID":"20240611134637-5xeyqs4","Type":"NodeParagraph","Properties":{"id":"20240611134637-5xeyqs4","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"常服不绝。若觉痹即瘥。又方。苦参末二两。以猪肚盛之。缝合煮熟。取出去药。先饿一日。次早先饮新水一盏。将猪肚食之。如吐再食。待一二时。以肉汤调无忧散五七钱服。取出大小虫一二万为效。后以不蛀皂角一斤。去皮子煮汁。入苦参末调糊。下首乌末二两。防风末一两半。当归末一两。芍药末五钱。人参末三钱。丸梧子大。每服三五十丸。温酒或茶下。日三服。仍用麻黄苦参荆芥煎水洗之。肾脏风毒。及心肺积热。皮肤生疥癞。瘙痒。时出黄水。并大风手足坏烂。一切风疾。苦参三十一两。荆芥穗十六两。为末。水糊丸梧子大。"}]},{"ID":"20240611134637-12l81se","Type":"NodeParagraph","Properties":{"id":"20240611134637-12l81se","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"每〔论〕苦参味至苦。气复寒。夫苦为火味。肾中原有真阳。故味之苦者入之。况苦味禀乎寒水之气化。其气味固有专至者。所谓纯阴而气降。止宜于肾水弱而相火旺之人。皆确论也。其治热毒风之义。更为可参。盖风者阳之淫气。即阳之郁气。气郁化风。渐已化为热矣。是浅而病乎卫者也。由卫及营以病乎血。积久而热之壅者。更就血中而为毒。热毒之所化。遂病乎肾肝之真阴而为热毒风。（气郁化风者。即已化热气之热不去。因病乎血热之在血中者。久而又不去。遂能蚀血。故曰热毒。热毒原是风毒。故曰热毒风。其病变固有浅深也。）故风热在卫。止散阳郁之邪而清其气。热毒蚀阴。必直驱其伤阴之邪。而用至阴以胜之。如苦参辈是也。第洁古谓为纯阴。而透以气沉二字。可悟。苦参元参。均之入肾。而却有迥殊之用存焉。使与病证不相对待。将沉寒直入命门。痼冷大伤元阳矣。其可漫投乎哉。"}]},{"ID":"20240611134637-jasa50z","Type":"NodeParagraph","Properties":{"id":"20240611134637-jasa50z","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"又生地苦参凉血。一则虑其寒滞于中。一则虑其寒沉于下。若风之化热。热又鼓风。而未至为热毒风者。则本柴胡四物为用。丹栀翘甘辈颇为适宜。（薛新甫法。血分热者。四物加丹皮。或小柴胡加山栀芎归。能清肝凉血。又四物加翘甘。能生血清热。如风热则用小柴胡加防翘。此可以思营卫之分矣。"}]},{"ID":"20240611134637-6arnpuq","Type":"NodeParagraph","Properties":{"id":"20240611134637-6arnpuq","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"总之。血热为病。不能舍血药。即芍地虑其滞。而芎归固不可少也。）如苦参犹可需次以投也。"}]},{"ID":"20240611134637-8hzhb8m","Type":"NodeParagraph","Properties":{"id":"20240611134637-8hzhb8m","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"缪氏云。虽能泄血中之热而除虫疠。然大苦大寒。久服能损肾气。肝肾虚而无大热者。"}]},{"ID":"20240611134637-enjlat6","Type":"NodeParagraph","Properties":{"id":"20240611134637-enjlat6","updated":"20240611134637"},"Children":[{"Type":"NodeText","Data":"弗服。火衰精冷。真元不足。及年高之人。不可用。（濒湖）〔修治〕少入汤剂。多作丸服。用糯米泔浸一宿。蒸三时久。晒干。治疮浸酒。治肠风炒至烟起为末。"}]},{"ID":"20240611134613-0zc5vsa","Type":"NodeThematicBreak","Properties":{"id":"20240611134613-0zc5vsa"}},{"ID":"20240611134624-eqmvgs8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134624-eqmvgs8","updated":"20240611134631"},"Children":[{"Type":"NodeText","Data":"苦参《本草崇原》"}]},{"ID":"20240611134624-lw9bfa9","Type":"NodeParagraph","Properties":{"id":"20240611134624-lw9bfa9","updated":"20240611134624"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治心腹结气，症瘕积聚，黄胆，溺有余沥，逐水，除痈肿，补中，明目，止泪。"}]},{"ID":"20240611134624-5dk8r3h","Type":"NodeParagraph","Properties":{"id":"20240611134624-5dk8r3h","updated":"20240611134624"},"Children":[{"Type":"NodeText","Data":"（苦参《本经》名水槐，一名地槐，又名苦骨。近道处处有之。花开黄白，根色亦黄白，长五七寸许，叶形似槐，味苦性寒，故有水槐、地槐之名。苦以味名，参以功名，有补益上中下之功，故名曰参。参犹参也。）"}]},{"ID":"20240611134624-xwkec02","Type":"NodeParagraph","Properties":{"id":"20240611134624-xwkec02","updated":"20240611134624"},"Children":[{"Type":"NodeText","Data":"苦参气味苦寒，根花黄白，禀寒水之精，得中土之化，水精上与君火相参，故主治心腹结气，参伍于中土之中，故治症瘕积聚而清黄胆。禀水精，则能资肾，故治溺有余沥。苦主下泄，故逐水。苦能清热，故除痈肿。得中土之化，故补中。水之精，上通于火之神，故明目止泪。"}]},{"ID":"20240611134614-cqn338p","Type":"NodeThematicBreak","Properties":{"id":"20240611134614-cqn338p"}},{"ID":"20240611134615-hvludm0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134615-hvludm0","updated":"20240611134619"},"Children":[{"Type":"NodeText","Data":"苦参《千金翼方》"}]},{"ID":"20240611134615-2mby7sa","Type":"NodeParagraph","Properties":{"id":"20240611134615-2mby7sa","updated":"20240611134615"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主心腹结气，症瘕积聚，黄胆，溺有余沥，逐水，除痈肿，补中明目，止泪，养肝胆气，安五脏，定志益精，利九窍，除伏热肠 ，止渴，醒酒，小便黄赤，疗恶疮，下部 疮，平胃气。令人嗜食，轻身。一名水槐，一名苦 ，一名地槐，一名菟槐，一名桥槐，一名白茎，一名虎麻，一名禄茎，一名禄白，一名陵郎。生汝南山谷及田野，三月八月十月采根，曝干。"}]},{"ID":"20240611134327-nl14jc9","Type":"NodeThematicBreak","Properties":{"id":"20240611134327-nl14jc9"}},{"ID":"20240611134513-hi731q2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134513-hi731q2","updated":"20240611134518"},"Children":[{"Type":"NodeText","Data":"苦参《本草求真》"}]},{"ID":"20240611134513-8fzurtp","Type":"NodeParagraph","Properties":{"id":"20240611134513-8fzurtp","updated":"20240611134513"},"Children":[{"Type":"NodeText","Data":"（山草）清热除湿杀虫"}]},{"ID":"20240611134513-k1ji7mf","Type":"NodeParagraph","Properties":{"id":"20240611134513-k1ji7mf","updated":"20240611134513"},"Children":[{"Type":"NodeText","Data":"苦参（专入肾。兼入脾胃）。味苦至极。古书有云。虽在五参之外。（人参。沙参。紫参。丹参．玄参。）云参亦属有补。然究止属除湿导热之品。于补其奚济乎？（绣按。五参除人参可以言补。余不得以补名。）凡味惟甘为正。惟温为补。苦参味等黄柏。寒类大黄。阴似朴硝。（的解）号为极苦极寒。用此杀虫除风。治水去疸。扫疥治癞。开窍通道。清痢解疲。或云有益。若谓于肾有补。纵书立有是说。亦不过从湿除热祛之后而言。岂真补阴益肾之谓哉？"}]},{"ID":"20240611134513-lq7bh4i","Type":"NodeParagraph","Properties":{"id":"20240611134513-lq7bh4i","updated":"20240611134513"},"Children":[{"Type":"NodeText","Data":"况有用此擦牙。而更见有腰痛伤肾之症。其可谓之补肾者乎！（素问云。五味入胃。各归其所喜攻。久则增气。物化之常也。气增而久。夭之由也。王冰注云。入肝为温。入心为热。入肺为清。入肾为寒。入脾为至阴而兼四气。皆为增其味而益其气。各从本脏之气用尔。故久服黄连苦参而反热者。此其类也。气增不已。则脏气有偏胜。偏胜则脏有偏绝。故有暴夭。是以药不具五味。不备四气。而久服之。虽且复胜。久必暴夭。但人疏忽。不能精候耳。张从正云。凡药皆毒也。虽甘草苦参不可不谓之毒。久服则五味各归其脏。必有偏胜。气增之患。诸药皆然。学人当触类而长之可也。）至脾胃虚寒。尤为切忌。泔浸。去腥气。蒸用。玄参为使。恶贝母菟丝子漏芦。反藜芦。"}]},{"ID":"20240611134357-rlholqc","Type":"NodeThematicBreak","Properties":{"id":"20240611134357-rlholqc"}},{"ID":"20240611134403-gt81gx9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134403-gt81gx9","updated":"20240611134417"},"Children":[{"Type":"NodeText","Data":"苦参《中药学》"}]},{"ID":"20240611134403-ektzsnr","Type":"NodeParagraph","Properties":{"id":"20240611134403-ektzsnr","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【药用】本品为豆科植物苦参的根。"}]},{"ID":"20240611134403-ac6iugz","Type":"NodeParagraph","Properties":{"id":"20240611134403-ac6iugz","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒。入心、肝、小肠、大肠、胃经。"}]},{"ID":"20240611134403-vnopswt","Type":"NodeParagraph","Properties":{"id":"20240611134403-vnopswt","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【功效】清热燥湿，祛风杀虫。"}]},{"ID":"20240611134403-1mjf14h","Type":"NodeParagraph","Properties":{"id":"20240611134403-1mjf14h","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于湿热下痢，黄疸，赤白带下，阴部瘙痒等症。"}]},{"ID":"20240611134403-j2ekud6","Type":"NodeParagraph","Properties":{"id":"20240611134403-j2ekud6","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"苦参清化湿热，并能导湿热渗于下窍，故适用于上述诸症，常与黄柏、龙胆草等合用。"}]},{"ID":"20240611134403-abr0cxi","Type":"NodeParagraph","Properties":{"id":"20240611134403-abr0cxi","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"2.用于周身风痒，疥疮顽癣，麻风等症。"}]},{"ID":"20240611134403-xeaicuz","Type":"NodeParagraph","Properties":{"id":"20240611134403-xeaicuz","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"苦参祛风而化湿，且能杀虫，用于周身风痒，疥疮顽癣，常合赤芍、地黄、白藓皮等同用；用于麻风，常与大风子等同用。"}]},{"ID":"20240611134403-j7rjife","Type":"NodeParagraph","Properties":{"id":"20240611134403-j7rjife","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"此外，本品又能清热痢尿，可用于湿热内蕴、小便不利之症。"}]},{"ID":"20240611134403-flb7azv","Type":"NodeParagraph","Properties":{"id":"20240611134403-flb7azv","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【处方用名】苦参、苦参片（洗净，晒干，切片用）"}]},{"ID":"20240611134403-ls653xj","Type":"NodeParagraph","Properties":{"id":"20240611134403-ls653xj","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240611134403-dlco6aj","Type":"NodeParagraph","Properties":{"id":"20240611134403-dlco6aj","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【按语】苦参清热治痢的功效，与黄连相近；除下焦湿热，也与黄柏、龙胆草等相似。但它又能祛风、杀虫而止痒，可用治皮肤湿疹、瘙痒等症，这是苦参的特长。"}]},{"ID":"20240611134403-pdzhj61","Type":"NodeParagraph","Properties":{"id":"20240611134403-pdzhj61","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"【方剂举例】治痢散《医学心悟》：苦参、葛根、赤芍、山渣、陈皮、麦芽、陈松罗茶。治痢疾。"}]},{"ID":"20240611134403-fpgjfrx","Type":"NodeParagraph","Properties":{"id":"20240611134403-fpgjfrx","updated":"20240611134403"},"Children":[{"Type":"NodeText","Data":"苦参散《证治准绳》：苦参、丹参、蛇床子。治一切疥及风瘙痒，瘙之成疮。"}]},{"ID":"20240611134327-d3iq1kl","Type":"NodeThematicBreak","Properties":{"id":"20240611134327-d3iq1kl"}},{"ID":"20240611134348-ub73ahi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134348-ub73ahi","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"《中国药典》：苦参"}]},{"ID":"20240611134348-zn2xd6a","Type":"NodeParagraph","Properties":{"id":"20240611134348-zn2xd6a","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611134348-4130397","Type":"NodeParagraph","Properties":{"id":"20240611134348-4130397","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" Kǔ Shēn"}]},{"ID":"20240611134348-rnde064","Type":"NodeParagraph","Properties":{"id":"20240611134348-rnde064","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611134348-t1xvs8k","Type":"NodeParagraph","Properties":{"id":"20240611134348-t1xvs8k","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 野槐、好汉枝、苦骨、地骨、地槐、山槐子"}]},{"ID":"20240611134348-jhcf2jf","Type":"NodeParagraph","Properties":{"id":"20240611134348-jhcf2jf","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611134348-n7n06q7","Type":"NodeParagraph","Properties":{"id":"20240611134348-n7n06q7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" RADIX SOPHORAE FLAVESCENTIS"}]},{"ID":"20240611134348-3wwhf1b","Type":"NodeParagraph","Properties":{"id":"20240611134348-3wwhf1b","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611134348-4yp21j2","Type":"NodeParagraph","Properties":{"id":"20240611134348-4yp21j2","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 本品为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦参"},{"Type":"NodeText","Data":"Sophora flavescens Ait.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去根头及小支根，洗净，干燥，或趁鲜切片，干燥。"}]},{"ID":"20240611134348-ng4qj48","Type":"NodeParagraph","Properties":{"id":"20240611134348-ng4qj48","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611134348-xz77vrv","Type":"NodeParagraph","Properties":{"id":"20240611134348-xz77vrv","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 本品呈长圆柱形，下部常有分枝，长10～30cm，直径1～2cm。表面灰棕色或棕黄色，具纵皱纹及横长皮孔，外皮薄，多破裂反卷，易剥落，剥落处显黄色，光滑。质硬，不易折断，断面纤维性；切片厚3～6mm；切面黄白色，具放射状纹理及裂隙，有的可见同心性环纹。气微，味极苦。"}]},{"ID":"20240611134348-3i32bx7","Type":"NodeParagraph","Properties":{"id":"20240611134348-3i32bx7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611134348-o8akpq7","Type":"NodeParagraph","Properties":{"id":"20240611134348-o8akpq7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240611134348-ykuv5eq","Type":"NodeParagraph","Properties":{"id":"20240611134348-ykuv5eq","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611134348-1eal1e3","Type":"NodeParagraph","Properties":{"id":"20240611134348-1eal1e3","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 除去残留根头，大小分开，洗净，浸泡至约六成透时，润透，切厚片，干燥。"}]},{"ID":"20240611134348-c0hsfrb","Type":"NodeParagraph","Properties":{"id":"20240611134348-c0hsfrb","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611134348-c72di3v","Type":"NodeParagraph","Properties":{"id":"20240611134348-c72di3v","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" （1）取本品横切片，加氢氧化钠试液数滴，栓皮即呈橙红色，渐变为血红色，久置不消失。木质部不呈现颜色反应。"}]},{"ID":"20240611134348-iqf3hdc","Type":"NodeParagraph","Properties":{"id":"20240611134348-iqf3hdc","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"（2）取本品粗粉1g，加含 0。5％盐酸乙醇溶液20ml，加热回流1小时，滤过，滤液加氨试液使呈中性，蒸干，残渣加 1％盐酸溶液10ml使溶解，滤过，取滤液分置三支试管中，一管中加碘化铋钾试液，生成红棕色沉淀；一管中加碘化汞钾试液，生成黄白色沉淀；另一管中加碘化钾碘试液，生成棕褐色沉淀。"}]},{"ID":"20240611134348-ma02vxw","Type":"NodeParagraph","Properties":{"id":"20240611134348-ma02vxw","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末0。5g，加甲醇10ml，加热回流10分钟，滤过。取滤液1ml，置试管中，加镁粉少量与盐酸3～4滴，加热，显红色；另取滤液点于滤纸上，喷以5％三氯化铝乙醇溶液，晾干，置紫外光灯（254nm）下观察，显黄绿色荧光。"}]},{"ID":"20240611134348-h3x62fe","Type":"NodeParagraph","Properties":{"id":"20240611134348-h3x62fe","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"（4）取本品粉末0。5g，加氯仿25ml、浓氨试液0。3ml，放置过夜，滤过，滤液蒸干，残渣加氯仿0。5ml 使溶解，作为供试品溶液。另取氧化苦参碱和槐定碱对照品，加乙醇制成每1ml各含0。2mg的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各4μl，分别点于同一用 2％氢氧化钠溶液制备的硅胶Ｇ薄层板上，以苯－丙酮－甲醇（8:3:0。5）为展开剂，展开，展距约8cm ，取出，晾干，再以甲苯－醋酸乙酯－甲醇－水（2:4:2:1）10℃以下放置后的上层溶液为展开剂，展开，展距同上，取出，晾干，依次喷以碘化铋钾试液和亚硝酸钠乙醇试液。供试品色谱中，在与对照品"}]},{"ID":"20240611134348-6umyx41","Type":"NodeParagraph","Properties":{"id":"20240611134348-6umyx41","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"色谱相应的位置上，显相同的两个橙色斑点。"}]},{"ID":"20240611134348-krzrd16","Type":"NodeParagraph","Properties":{"id":"20240611134348-krzrd16","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611134348-va1jzjg","Type":"NodeParagraph","Properties":{"id":"20240611134348-va1jzjg","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 归心、肝、胃、大肠、膀胱经。"}]},{"ID":"20240611134348-s31npjb","Type":"NodeParagraph","Properties":{"id":"20240611134348-s31npjb","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611134348-z2hy5gm","Type":"NodeParagraph","Properties":{"id":"20240611134348-z2hy5gm","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611134348-7nthk1d","Type":"NodeParagraph","Properties":{"id":"20240611134348-7nthk1d","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611134348-v806y1c","Type":"NodeParagraph","Properties":{"id":"20240611134348-v806y1c","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 不宜与藜芦同用。"}]},{"ID":"20240611134348-pcva94n","Type":"NodeParagraph","Properties":{"id":"20240611134348-pcva94n","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611134348-ebto7ny","Type":"NodeParagraph","Properties":{"id":"20240611134348-ebto7ny","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，杀虫，利尿。用于热痢，便血，黄疸尿闭，赤白带下，阴肿阴痒，湿疹，湿疮，皮肤瘙痒，疥癣麻风；外治滴虫性阴道炎。"}]},{"ID":"20240611134348-hwb8rul","Type":"NodeParagraph","Properties":{"id":"20240611134348-hwb8rul","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611134348-ta37tqg","Type":"NodeParagraph","Properties":{"id":"20240611134348-ta37tqg","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 4。5～9g。外用适量，煎汤洗患处。"}]},{"ID":"20240611134348-tyo48co","Type":"NodeParagraph","Properties":{"id":"20240611134348-tyo48co","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611134348-ospznqm","Type":"NodeParagraph","Properties":{"id":"20240611134348-ospznqm","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" （1）本品有小毒，用量不宜过大，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中毒"},{"Type":"NodeText","Data":"后出现流涎、步伐不整、呼吸、脉搏急速、惊厥，最后因呼吸停止死亡。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解救方法"},{"Type":"NodeText","Data":"：未出现惊厥时可洗胃和导泻；内服蛋清，鞣酸或浓茶；静脉滴注葡萄糖盐水；惊厥时肌肉注射苯巴比妥等解痉剂；呼吸障碍时用呼吸兴奋剂。"}]},{"ID":"20240611134348-zp8l7ck","Type":"NodeParagraph","Properties":{"id":"20240611134348-zp8l7ck","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"（2）用于湿热下痢，黄疸，赤白带下，阴部瘙痒等，常与黄柏、龙胆草等合用。用于周身风痒，疥疮顽癣，常合赤芍、地黄、白藓皮等同用；用于麻风，常与大风子等同用。"}]},{"ID":"20240611134348-qhsgglj","Type":"NodeParagraph","Properties":{"id":"20240611134348-qhsgglj","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611134348-88dn0ck","Type":"NodeParagraph","Properties":{"id":"20240611134348-88dn0ck","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611134348-n9n12uu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134348-n9n12uu","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：苦参"}]},{"ID":"20240611134348-thlaebc","Type":"NodeParagraph","Properties":{"id":"20240611134348-thlaebc","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611134348-06yh3ca","Type":"NodeParagraph","Properties":{"id":"20240611134348-06yh3ca","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" Kǔ Shēn"}]},{"ID":"20240611134348-mwlpfwk","Type":"NodeParagraph","Properties":{"id":"20240611134348-mwlpfwk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611134348-f396zrs","Type":"NodeParagraph","Properties":{"id":"20240611134348-f396zrs","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦骨（《纲目》），川参（《贵州民间方药集》），凤凰爪（《广西中兽医药植》），牛参（《湖南药物志》）。"}]},{"ID":"20240611134348-4o1pb6o","Type":"NodeParagraph","Properties":{"id":"20240611134348-4o1pb6o","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611134348-bk596fi","Type":"NodeParagraph","Properties":{"id":"20240611134348-bk596fi","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611134348-aiv03p7","Type":"NodeParagraph","Properties":{"id":"20240611134348-aiv03p7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611134348-3vlob77","Type":"NodeParagraph","Properties":{"id":"20240611134348-3vlob77","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 为豆种植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦参"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋采收，以秋采者为佳。挖出根后，去掉根头、须根，洗净泥沙，晒干。鲜根切片晒干，称苦参片。"}]},{"ID":"20240611134348-e6r3ws6","Type":"NodeParagraph","Properties":{"id":"20240611134348-e6r3ws6","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611134348-jkuemby","Type":"NodeParagraph","Properties":{"id":"20240611134348-jkuemby","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 生于山坡草地、平原、路旁、沙质地和红壤地的向阳处。我国各地皆有分布。全国各地均产，以山西、湖北、河南、河北产量较大。"}]},{"ID":"20240611134348-tz8henk","Type":"NodeParagraph","Properties":{"id":"20240611134348-tz8henk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611134348-0mib0fp","Type":"NodeParagraph","Properties":{"id":"20240611134348-0mib0fp","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦参，又名：水槐（《本经》），地槐、菟槐、骄槐、白茎、虎麻、岑茎、禄白、陵郎（《别录》），野槐（《纲目》），山槐子、白萼。"}]},{"ID":"20240611134348-z3xjtas","Type":"NodeParagraph","Properties":{"id":"20240611134348-z3xjtas","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"亚灌木，高50～120厘米。根圆柱状，外皮黄色。茎枝草本状，绿色，具不规则的纵沟，幼时被黄色细毛。单数羽状复叶，互生；下具线形托叶；叶片长20～25厘米，叶轴上被细毛；小叶5～21枚，有短柄，卵状椭圆形至长椭圆状披针形，先端圆形或钝尖，基部圆形或广楔形，全缘。总状花序顶生，长10～20厘米，被短毛；苞片线形；花淡黄白色；萼钟状，稍偏斜，先端5裂；花冠蝶形，旗瓣较其他的花瓣稍长，先端近圆形；雄蕊10，花丝离生，仅基部愈合；雌蕊1，子房上位，子房柄被细毛，花柱纤细，柱头圆形。荚果线形，先端具长喙，成熟时不开裂。种子通常3～7枚，种子间有缢缩，黑色，近球形。花期5～7月。果期7～9月。"}]},{"ID":"20240611134348-8keow3m","Type":"NodeParagraph","Properties":{"id":"20240611134348-8keow3m","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611134348-z4v3smp","Type":"NodeParagraph","Properties":{"id":"20240611134348-z4v3smp","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 干燥根呈圆柱形，长10～30厘米，直径1～2.4厘米。表面有明显纵皱，皮孔明显突出而稍反卷，横向延长。栓皮很薄，棕黄色或灰棕色，多数破裂向外卷曲，易剥落而显现黄色的光滑皮部。质坚硬，不易折断，折断面粗纤维状。横断面黄白色，形成层明显。气刺鼻，味极苦。苦参片为斜切的薄片，形状大小不一，斜圆形或长椭圆形，长2～5厘米，宽1～1.5厘米，厚约2～5毫米。质坚硬，切面淡黄白色，有环状年轮，木质部作放射纹。以整齐、色黄白、味苦者为佳。"}]},{"ID":"20240611134348-sxplg57","Type":"NodeParagraph","Properties":{"id":"20240611134348-sxplg57","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611134348-k0vy3bd","Type":"NodeParagraph","Properties":{"id":"20240611134348-k0vy3bd","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240611134348-aid7de8","Type":"NodeParagraph","Properties":{"id":"20240611134348-aid7de8","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611134348-yd4lfaw","Type":"NodeParagraph","Properties":{"id":"20240611134348-yd4lfaw","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 根含多种生物碱：d-苦参碱、d-氧化苦参碱、槐花醇l-臭豆碱、l-甲基金雀花碱、l-穿叶赝靛碱及槐果碱。还含黄酮类：黄腐醇、异黄腐醇、3，4′，5-三羟-7-甲氧-8-异戊烯基黄酮、8-异戊烯基山柰酚等。茎、叶含木犀草素-7-葡萄糖甙。"}]},{"ID":"20240611134348-0auuq0h","Type":"NodeParagraph","Properties":{"id":"20240611134348-0auuq0h","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611134348-n2no5yw","Type":"NodeParagraph","Properties":{"id":"20240611134348-n2no5yw","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" ①利尿作用"}]},{"ID":"20240611134348-8exxxka","Type":"NodeParagraph","Properties":{"id":"20240611134348-8exxxka","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"苦参煎剂及其中所含之苦参碱给兔口服或注射，皆可产生利尿作用，尿量增加前即有盐分排出之增多。但实验中所用家兔之数目较少，又未叙述饮水控制之情况，因而有人认为需进一步研究。"}]},{"ID":"20240611134348-h8clgur","Type":"NodeParagraph","Properties":{"id":"20240611134348-h8clgur","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②抗病原体作用"}]},{"ID":"20240611134348-n4a4z8c","Type":"NodeParagraph","Properties":{"id":"20240611134348-n4a4z8c","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"煎剂在试管中，高浓度（1：100）对结核杆菌有抑制作用。煎剂（8％）、水浸剂（1：3）在体外对某些常见的皮肤真菌有不同程度的抑制作用。醇浸膏在体外尚有抗滴虫作用，强度弱于黄连，而与蛇床子相近。"}]},{"ID":"20240611134348-66uxthw","Type":"NodeParagraph","Properties":{"id":"20240611134348-66uxthw","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240611134348-ohqtoaj","Type":"NodeParagraph","Properties":{"id":"20240611134348-ohqtoaj","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"苦参碱注射于家兔，发现中枢神经麻痹现象，同时发生痉挛，终则呼吸停止而死。注射于青蛙，初呈兴奋，继则麻痹，呼吸变为缓慢而不规则，最后发生痉挛，以致呼吸停止而死；其痉挛的发作，恐系起因于脊髓反射的亢进。对家兔的最小致死量为0.4克／公斤。"}]},{"ID":"20240611134348-qe6e6i3","Type":"NodeParagraph","Properties":{"id":"20240611134348-qe6e6i3","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611134348-2un0v2r","Type":"NodeParagraph","Properties":{"id":"20240611134348-2un0v2r","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去残茎，洗净泥土，用水浸泡，捞出，润透，切片，晒干。"}]},{"ID":"20240611134348-qv3hdir","Type":"NodeParagraph","Properties":{"id":"20240611134348-qv3hdir","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使苦参，先需用糯米浓泔汁浸一宿，上有腥秽气并在水面上浮，并须重重淘过，即蒸，从巳至申出，晒干细锉用之。\""}]},{"ID":"20240611134348-wzor20k","Type":"NodeParagraph","Properties":{"id":"20240611134348-wzor20k","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611134348-o1zv690","Type":"NodeParagraph","Properties":{"id":"20240611134348-o1zv690","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 入肝、肾、大肠、小肠经。"}]},{"ID":"20240611134348-q9hcggk","Type":"NodeParagraph","Properties":{"id":"20240611134348-q9hcggk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"①张元素：\"少阴肾经。\""}]},{"ID":"20240611134348-y9guoj6","Type":"NodeParagraph","Properties":{"id":"20240611134348-y9guoj6","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入胃、大肠、肝、肾四经。\""}]},{"ID":"20240611134348-dl278au","Type":"NodeParagraph","Properties":{"id":"20240611134348-dl278au","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入心、肺，肾、大肠经。\""}]},{"ID":"20240611134348-j19yol6","Type":"NodeParagraph","Properties":{"id":"20240611134348-j19yol6","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611134348-szj07g5","Type":"NodeParagraph","Properties":{"id":"20240611134348-szj07g5","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611134348-fw2gycu","Type":"NodeParagraph","Properties":{"id":"20240611134348-fw2gycu","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240611134348-ap612d2","Type":"NodeParagraph","Properties":{"id":"20240611134348-ap612d2","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611134348-tzcpgle","Type":"NodeParagraph","Properties":{"id":"20240611134348-tzcpgle","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"大苦，大寒。\""}]},{"ID":"20240611134348-9n1vkyp","Type":"NodeParagraph","Properties":{"id":"20240611134348-9n1vkyp","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611134348-i7kauv4","Type":"NodeParagraph","Properties":{"id":"20240611134348-i7kauv4","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒者忌服。"}]},{"ID":"20240611134348-4y1f3w6","Type":"NodeParagraph","Properties":{"id":"20240611134348-4y1f3w6","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》；\"玄参为之使。恶贝母、漏芦、菟丝子。反藜芦。\""}]},{"ID":"20240611134348-v2oykwl","Type":"NodeParagraph","Properties":{"id":"20240611134348-v2oykwl","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②《医学入门》：\"胃弱者慎用。\""}]},{"ID":"20240611134348-hmq6plz","Type":"NodeParagraph","Properties":{"id":"20240611134348-hmq6plz","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③《本草经疏，：\"久服能损肾气，肝、肾虚而无大热者勿服。\""}]},{"ID":"20240611134348-kdhkdv4","Type":"NodeParagraph","Properties":{"id":"20240611134348-kdhkdv4","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611134348-ymr15un","Type":"NodeParagraph","Properties":{"id":"20240611134348-ymr15un","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 清热，燥湿，杀虫。治热毒血痢，肠风下血，黄疸，赤白带下，小儿肺炎，疳积，急性扁桃体炎，痔漏，脱肛，皮肤瘙痒，疥癞恶疮，阴疮湿痒，瘰疬，烫伤。外治滴虫性阴道炎。"}]},{"ID":"20240611134348-3ccf2fk","Type":"NodeParagraph","Properties":{"id":"20240611134348-3ccf2fk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹结气，症瘕积聚，黄疸，溺有余沥，逐水，除痈肿，补中，明目止泪。\""}]},{"ID":"20240611134348-ihf4fu1","Type":"NodeParagraph","Properties":{"id":"20240611134348-ihf4fu1","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"养肝胆气，安五脏，定志益精，利九窍，除伏热肠澼，止渴，醒酒，小便黄亦，疗恶疮下部匿，平胃气，令人嗜食。\""}]},{"ID":"20240611134348-ezkqt5v","Type":"NodeParagraph","Properties":{"id":"20240611134348-ezkqt5v","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"恶病人酒渍饮之，患疥者服亦除，盖能杀虫。\""}]},{"ID":"20240611134348-cmadl7m","Type":"NodeParagraph","Properties":{"id":"20240611134348-cmadl7m","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治热毒风，皮肌烦燥生疮，赤癞眉脱，主除大热嗜睡，治腹中冷痛，中恶腹痛，除体闷，治心腹积聚。\""}]},{"ID":"20240611134348-dgjyo4i","Type":"NodeParagraph","Properties":{"id":"20240611134348-dgjyo4i","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑤《唐本草》：\"治胫酸，疗恶虫。\""}]},{"ID":"20240611134348-sqhvulk","Type":"NodeParagraph","Properties":{"id":"20240611134348-sqhvulk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑥《日华于本草》：\"杀疳虫。炒带烟出为末，饭饮下，治肠风下血并热痢。\""}]},{"ID":"20240611134348-2ro39lf","Type":"NodeParagraph","Properties":{"id":"20240611134348-2ro39lf","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑦《珍珠囊》：\"去湿。\""}]},{"ID":"20240611134348-i91gn6g","Type":"NodeParagraph","Properties":{"id":"20240611134348-i91gn6g","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑧《滇南本草》：\"凉血，解热毒，疥癞，脓窠疮毒。疗皮肤瘙痒，血风癣疮，顽皮白屑，肠风下血，便血。消风，消肿毒，痰毒。\""}]},{"ID":"20240611134348-finzruu","Type":"NodeParagraph","Properties":{"id":"20240611134348-finzruu","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑨《本草从新》：\"燥湿，胜热，治梦遗滑精。\""}]},{"ID":"20240611134348-ml488oa","Type":"NodeParagraph","Properties":{"id":"20240611134348-ml488oa","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611134348-389nr8u","Type":"NodeParagraph","Properties":{"id":"20240611134348-389nr8u","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外用：煎水洗。"}]},{"ID":"20240611134348-l0pdhl1","Type":"NodeParagraph","Properties":{"id":"20240611134348-l0pdhl1","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611134348-w2l4ze4","Type":"NodeParagraph","Properties":{"id":"20240611134348-w2l4ze4","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" ①治血痢不止：苦参炒焦为末，水丸梧子大。每服十五丸，米饮下。（《仁存堂经验方》）"}]},{"ID":"20240611134348-yzwyjl2","Type":"NodeParagraph","Properties":{"id":"20240611134348-yzwyjl2","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②治痔漏出血，肠风下血，酒毒下血：苦参（切片，酒浸湿，蒸晒九次为度，炒黄为末，净）一斤，地黄四两（酒浸一宿，蒸熟，捣烂）。加蜂蜜为丸。每服二钱，白滚汤或酒送下，日服二次。（《外科大成》苦参地黄丸）"}]},{"ID":"20240611134348-mbifiuy","Type":"NodeParagraph","Properties":{"id":"20240611134348-mbifiuy","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③治谷疸，食毕头旋，心怫郁不安而发黄，由失饥大食，胃气冲熏所致：苦参三两，龙胆一合（末）。牛胆丸如梧子。以生姜汁服五丸，日三服。（《补缺肘后方》）"}]},{"ID":"20240611134348-q0e8d85","Type":"NodeParagraph","Properties":{"id":"20240611134348-q0e8d85","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"④治赤白带下：苦参二两，牡蛎一两五钱。为末，以雄猪肚一个，水三碗煮烂，捣泥和丸，梧子大。每服百丸，温酒下。（《积德堂经验方》）"}]},{"ID":"20240611134348-nfp1xdm","Type":"NodeParagraph","Properties":{"id":"20240611134348-nfp1xdm","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑤治下部疮漏：苦参煎汤，日日洗之。（《仁斋直指方》）"}]},{"ID":"20240611134348-rr62ao0","Type":"NodeParagraph","Properties":{"id":"20240611134348-rr62ao0","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑥治大肠脱肛：苦参、五倍子、陈壁土等分。煎汤洗之，以木贼末敷之。（《医方摘要》）"}]},{"ID":"20240611134348-48hdxs9","Type":"NodeParagraph","Properties":{"id":"20240611134348-48hdxs9","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑦治心肺积热，肾脏风毒攻于皮肤，时生疥癞，瘙痒难忍，时出黄水，及大风手足烂坏，眉毛脱落，一切风疾：苦参三十二两，荆芥（去梗）十六两。上为细末，水糊为丸，如梧桐子大。每服三十丸，好茶吞下，或荆芥汤下，食后服。（《局方》苦参丸）"}]},{"ID":"20240611134348-dxbvnk0","Type":"NodeParagraph","Properties":{"id":"20240611134348-dxbvnk0","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑧治漏脓肥疮，脓窠疮，腊梨头，遍身风癞，瘾疹疥癣，瘙痒异常，麻木不仁，诸风手足酸痛，皮肤破烂，阴囊痒极，并归人阴痒、湿痒：苦参一斤（为末），鹅毛（香油炒存性）六两。黄米糊丸，朱砂为衣。茶汤送下，日进二次。或随病作散擦或洗、贴。（《王秋泉家秘》神功至宝丹）"}]},{"ID":"20240611134348-vew9xb7","Type":"NodeParagraph","Properties":{"id":"20240611134348-vew9xb7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑨治瘰疬：苦参四两，捣末，生牛膝和丸如梧子。食后暖水下十丸，日三服。（《随身备急方》）"}]},{"ID":"20240611134348-c5r0gus","Type":"NodeParagraph","Properties":{"id":"20240611134348-c5r0gus","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑩治鼠瘘诸恶疮：苦参二斤，露蜂房二两，曲二斤。水三斗，渍药二宿，去滓，黍米二升，酿熟梢饮，日三。一方加猬皮，更佳。（《补缺肘后方》）"}]},{"ID":"20240611134348-28ae5nd","Type":"NodeParagraph","Properties":{"id":"20240611134348-28ae5nd","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑾治汤熨火烧疼痛：苦参不以多少，为细末，用香油调搽。（《卫生宝鉴》绿白散）"}]},{"ID":"20240611134348-ses1al1","Type":"NodeParagraph","Properties":{"id":"20240611134348-ses1al1","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑿治旋耳疮（又名月蚀疮）初起在耳轮上或耳后，耳垂处发一黄色米粒样疙瘩，周围发红，顶白透脓，奇痒难忍，破后脓水外溢，蔓延传染，不几日耳前后成为一片，脓水淋漓，此疮小儿最易传染：苦参、黄柏各五钱，苍术、海螵蛸各三钱。各研极细，和匀。用温开水调敷患部，每日早晚各换药一次。（《浙江中医杂志》（6）：27，1958）"}]},{"ID":"20240611134348-jel68r2","Type":"NodeParagraph","Properties":{"id":"20240611134348-jel68r2","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⒀治齿缝出血：苦参一两，枯矾一钱。为末，日三揩之。（《普济方》）"}]},{"ID":"20240611134348-n7kl14n","Type":"NodeParagraph","Properties":{"id":"20240611134348-n7kl14n","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⒁治毒热足肿作痛欲脱者：苦参煮酒渍之。（《姚僧坦集验方》）"}]},{"ID":"20240611134348-kurwv93","Type":"NodeParagraph","Properties":{"id":"20240611134348-kurwv93","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611134348-af58qrz","Type":"NodeParagraph","Properties":{"id":"20240611134348-af58qrz","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" ①治疗细菌性痢疾"}]},{"ID":"20240611134348-zof6kti","Type":"NodeParagraph","Properties":{"id":"20240611134348-zof6kti","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"㈠口服法：50％浓煎剂，每次20～30毫升，日服3次。或用苦参2两，加水400毫升煎成200毫升，每日2次分服，7～10天为一疗程。亦可用含生药0.5克的片剂，每次2～4片，日服4次。㈡注射法：50％注射液肌肉注射2～4毫升，早晚各1次；静脉点滴4～8毫升，加10％葡萄糖液500毫升稀释。常用作口服煎剂的辅助治疗。㈢灌肠法：50％煎剂100毫升（内加0.25％普鲁卡因10～20毫升），每晚一次保留灌肠，7～10天为一疗程。用于口服煎剂后症状好转而肠道病理改变恢复不明显的病例。㈣敷脐法：用苦参粉8～10克，以温水调成稠糊状，做饼敷脐部，盖以油纸或纱布，用绷带固定。每日1～2次。据数百例临床观察，口服煎剂或外用敷脐治疗急性菌痢的治愈率均在85％以上。平均治愈日数在1周左右，尤以临床症状改善较快。煎液对慢性迁延性菌痢，特别是胃肠功能紊乱型效果也较好。苦参敷脐后，患者腹部有发热感，肠蠕动稍增强，排气通顺，腹痛、便次及里急后重逐渐减轻，同时出现多尿现象。由此推断，可能是药物刺激脐部穴位，通过穴位的神经反射，调整植物神经系统功能，促进胃肠血液循环，增强白细胞吞噬作用，从而发生疗效。也有认为其疗效的获得有两个环节：一是药物本身的作用，二是脐穴的作用。"}]},{"ID":"20240611134348-e3d81xs","Type":"NodeParagraph","Properties":{"id":"20240611134348-e3d81xs","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②治疗急性肠胃炎"}]},{"ID":"20240611134348-0lv8595","Type":"NodeParagraph","Properties":{"id":"20240611134348-0lv8595","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"每次用1.5钱煎服，每日2次；或用糖浆剂（每100毫升含生药1两），每次10～15毫升，日服2次；也可用胶囊剂，每次0.5克干粉，日服4次。一般服药1～2天治愈。"}]},{"ID":"20240611134348-vfckapg","Type":"NodeParagraph","Properties":{"id":"20240611134348-vfckapg","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③治疗急性传染性肝炎"}]},{"ID":"20240611134348-tiy89lc","Type":"NodeParagraph","Properties":{"id":"20240611134348-tiy89lc","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"除一般保肝治疗外，每日用苦参粉4克，装胶囊或制成丸剂分4次服。观察19例，黄疸消退时间平均为12.6天，最短的3天；同时自觉症状亦有所改善；肝肿大及肝功能的恢复亦较快。"}]},{"ID":"20240611134348-z6hvluk","Type":"NodeParagraph","Properties":{"id":"20240611134348-z6hvluk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"④治疗小儿肺炎"}]},{"ID":"20240611134348-ec1b9vv","Type":"NodeParagraph","Properties":{"id":"20240611134348-ec1b9vv","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"用200％苦参注射液2毫升行肌肉注射，每日2次。有心力衰竭和暴喘、高热、惊厥及呼吸功能衰竭的病例，加用西药处理。根据129例（其中有47例合并静脉点滴广谱抗菌素1次）的观察结果，有效率在92％以上，临床治愈率为34.9％，平均住院天数为3.8天。有57.4％的患儿呼吸道感染症状减轻、肺部罗音减少，病情好转后即出院。无效病例为重症肺炎，或有合并症及脱水者。治疗过程中有两例于注射后5分钟发生过敏反应，分别表现为呼吸急促、面色青紫、四肢厥冷、心率增加和突然憋气、满头大汗、面色苍白、脉细弱至不能触及。"}]},{"ID":"20240611134348-pxmhyr4","Type":"NodeParagraph","Properties":{"id":"20240611134348-pxmhyr4","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑤治疗急性扁桃体炎等"}]},{"ID":"20240611134348-dr3mhre","Type":"NodeParagraph","Properties":{"id":"20240611134348-dr3mhre","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"用50％苦参注射液肌肉注射，每次2～3毫升，每日2次，治疗急性扁桃体炎、急性结合膜炎、急性乳腺炎、牙周炎、外科感染和疖肿、肾盂肾炎、急性气管炎、急性淋巴结炎等10余种急性炎症性疾病220例，平均有效率在90％以上，治愈率在74％以上。此外，对结肠炎、胆囊炎、膀胱炎及其它炎症也有一定疗效。"}]},{"ID":"20240611134348-zovmnbs","Type":"NodeParagraph","Properties":{"id":"20240611134348-zovmnbs","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑥治疗慢性气管炎"}]},{"ID":"20240611134348-g9dse9m","Type":"NodeParagraph","Properties":{"id":"20240611134348-g9dse9m","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"取苦参、桔梗按7：3配合，共研细末，水泛为丸。每次1钱，日服2次，10天一疗程。疗程间隔5天。共治498例（均为50岁以上患者），治愈2例，显效112例，好转296例，无效88例。有效率为82.3％。副作用：有43例出现恶心呕吐，胃部灼热感及疼痛，腹泻腹胀；2例鼻咽发干，1例眼花。"}]},{"ID":"20240611134348-mqixttj","Type":"NodeParagraph","Properties":{"id":"20240611134348-mqixttj","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑦治疗蓝氏贾第鞭毛虫病"}]},{"ID":"20240611134348-b8o5gt9","Type":"NodeParagraph","Properties":{"id":"20240611134348-b8o5gt9","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"口服浸膏制成的片剂或糖浆，成人每日按生药30克的剂量3次分服，小儿酌减，连服7日为一疗程。治疗100例，92例治愈。大多数于治疗后1～4日症状消失，粪便恢复正常，粪检阴转。部分病例随访3～9个月，除1例外，其余未见复发。如用25％苦参煎液行保留灌肠，成人每次100～200毫升，每日1次，连续5次，也有疗效，但不及口服为佳。少数病例服药后感恶心，个别手指发麻，均不影响继续治疗。"}]},{"ID":"20240611134348-6f58vwr","Type":"NodeParagraph","Properties":{"id":"20240611134348-6f58vwr","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑧治疗人肠滴虫"}]},{"ID":"20240611134348-hu4f1ko","Type":"NodeParagraph","Properties":{"id":"20240611134348-hu4f1ko","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"口服苦参粉胶囊或苦参片，成人每次按生药1.2～4克的剂量，每日3次，小儿酌减。一般以10天为一疗程。如效果不佳，可另用50％苦参煎剂60～100毫升行保留溜肠，每日1次。对腹痛明显或大便次数较多者加用西药对症处理，有蛔虫者兼用驱蛔药。据54例观察结果，临床治愈率占50％。治愈者症状和体征平均于11.44天消失，粪检平均于11.67天转阴。少数病例有头晕、便秘、胃纳减退、恶心等反应，均很轻微，能自行消失。"}]},{"ID":"20240611134348-5b41fpr","Type":"NodeParagraph","Properties":{"id":"20240611134348-5b41fpr","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑨治疗滴虫性阴道炎"}]},{"ID":"20240611134348-736ctgf","Type":"NodeParagraph","Properties":{"id":"20240611134348-736ctgf","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"用苦参粉0.6克与等量葡萄糖、硼酸粉及枯矾粉混合作为1次量，行局部治疗。用时先以1／5000高锰酸钾溶液灌洗阴道，擦干后撒入药粉。每日1次，连续3次为一疗程。临床观察176例，总成功率为71.5％。其中追踪3月症状消失，阴道分泌物无滴虫者为痊愈，占26.1％；追踪不足3月，但症状消失、阴道分泌物无滴虫者属有效，占45.4％。有宫颈糜烂者治疗后亦大有改善。用药后少数患者阴道有轻微疼痛；疗程结束后复查几乎所有患者都有阴道表皮脱落现象，经追踪观察未见对机体有不良影响。"}]},{"ID":"20240611134348-u76zonq","Type":"NodeParagraph","Properties":{"id":"20240611134348-u76zonq","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"⑩治疗血吸虫病腹水"}]},{"ID":"20240611134348-e9d2c7o","Type":"NodeParagraph","Properties":{"id":"20240611134348-e9d2c7o","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"每天用苦参6～8克煎服。观察25例，大多在服药后2日内小便次数增多，腹围减小，为进行脾切除术创造了条件。"}]},{"ID":"20240611134348-gpgf4ow","Type":"NodeParagraph","Properties":{"id":"20240611134348-gpgf4ow","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"此外，据报告试服苦参制剂治疗丝虫病，似有杀虫作用。"}]},{"ID":"20240611134348-e055l9m","Type":"NodeParagraph","Properties":{"id":"20240611134348-e055l9m","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611134348-l1cmnil","Type":"NodeParagraph","Properties":{"id":"20240611134348-l1cmnil","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"苦参、黄柏之苦寒，皆能补肾，盖取其苦燥湿，寒除热也。热生风，湿生虫，故又能治风杀虫。惟肾水弱而相火胜者用之相宜，若火衰精冷，真元不足，及年高之人不可用也。张从正亦云，凡药皆毒也，虽甘草、苦参，不可不谓之毒，久服则五味各归其脏，必有偏胜气增之患，诸药皆然，学者当触类而长之可也，至于饮食亦然。又按《史记》云，太仓公淳于意医齐大夫病龋齿，灸左手阳明脉，以苦参汤日漱三升，出入慎风，五、六日愈，此亦取其去风气湿热杀虫之义。\""}]},{"ID":"20240611134348-l52vl46","Type":"NodeParagraph","Properties":{"id":"20240611134348-l52vl46","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"②《本草经百种录》：\"苦参，专治心经之火，与黄连功用相近。但黄连似去心脏之火为多，苦参似去心腑小肠之火为多，则以黄连之气味清，而苦参之气味浊也。按补中二字，亦取其苦以燥脾之义也。\""}]},{"ID":"20240611134348-vp6hakx","Type":"NodeParagraph","Properties":{"id":"20240611134348-vp6hakx","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"③《本草正义》：\"苦参，大苦大寒，退热泄降，荡涤湿火，其功效与芩、连、龙胆皆相近，而苦参之苦愈甚，其燥尤烈，故能杀湿热所生之虫，较之芩、连力量益烈。近人乃不敢以入煎剂，盖不特畏其苦味难服，亦嫌其峻厉而避之也。然毒风恶癞，非此不除，今人但以为洗疮之用，恐未免因噎而废食耳。\""}]},{"ID":"20240611134348-6g34zqv","Type":"NodeParagraph","Properties":{"id":"20240611134348-6g34zqv","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611134348-q0ifht9","Type":"NodeParagraph","Properties":{"id":"20240611134348-q0ifht9","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611134348-bf02qeg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611134348-bf02qeg","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"《中华本草》：苦参"}]},{"ID":"20240611134348-opneswq","Type":"NodeParagraph","Properties":{"id":"20240611134348-opneswq","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611134348-n2cdny7","Type":"NodeParagraph","Properties":{"id":"20240611134348-n2cdny7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" Kǔ Shēn"}]},{"ID":"20240611134348-5dqf0ty","Type":"NodeParagraph","Properties":{"id":"20240611134348-5dqf0ty","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611134348-xavgmpk","Type":"NodeParagraph","Properties":{"id":"20240611134348-xavgmpk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦骨、川参、凤凰爪、牛参、地骨、野槐根、山槐根、地参。"}]},{"ID":"20240611134348-5qiak28","Type":"NodeParagraph","Properties":{"id":"20240611134348-5qiak28","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611134348-wp8r4n1","Type":"NodeParagraph","Properties":{"id":"20240611134348-wp8r4n1","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" Lightyellow Sophora Root, Root of Lightyellow Sophorn"}]},{"ID":"20240611134348-gm5js2i","Type":"NodeParagraph","Properties":{"id":"20240611134348-gm5js2i","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611134348-v2fsbs0","Type":"NodeParagraph","Properties":{"id":"20240611134348-v2fsbs0","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611134348-lp7r5kc","Type":"NodeParagraph","Properties":{"id":"20240611134348-lp7r5kc","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611134348-3hp03hj","Type":"NodeParagraph","Properties":{"id":"20240611134348-3hp03hj","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物苦参的根。"}]},{"ID":"20240611134348-5yrjh3r","Type":"NodeParagraph","Properties":{"id":"20240611134348-5yrjh3r","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sophora flavescens Ait.[S.angustifolia Sieb.et Zucc.]"}]},{"ID":"20240611134348-ryzpf7k","Type":"NodeParagraph","Properties":{"id":"20240611134348-ryzpf7k","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"采收和储藏：播种第3年9-10月挖取全株，除去地上部分及芦头、须根，用刀割成单根，洗去泥土、晒干或烘干。"}]},{"ID":"20240611134348-b9rutmj","Type":"NodeParagraph","Properties":{"id":"20240611134348-b9rutmj","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611134348-r9e0jue","Type":"NodeParagraph","Properties":{"id":"20240611134348-r9e0jue","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于沙地或向阳山坡草丛中及溪沟边。"}]},{"ID":"20240611134348-a9zg2bv","Type":"NodeParagraph","Properties":{"id":"20240611134348-a9zg2bv","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国各地。"}]},{"ID":"20240611134348-9wlqlkn","Type":"NodeParagraph","Properties":{"id":"20240611134348-9wlqlkn","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611134348-j3vng2s","Type":"NodeParagraph","Properties":{"id":"20240611134348-j3vng2s","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦参 落叶半灌木，高1.5-3m。根圆柱状，外皮黄白色。茎直立，多分枝，具纵沟；幼枝被疏毛，后变无毛。奇数羽状复叶，长20-25cm，互生；小叶15-29，叶片披针形至线状披针形，长3-4cm，宽1.2-2cm，先端渐尖，基部圆，有短柄，全缘，背面密生平贴柔毛；托叶线形。总状花序顶生，长15-20cm，被短毛，苞片线形；萼钟状，扁平，长6-7mm，5浅裂；花冠蝶形，淡黄白色；旗瓣匙形，翼瓣无耳，与龙骨瓣等长；雄蕊10，花丝分离；子房柄被细毛，柱头圆形。荚果线形，先端具长喙，成熟时不开裂，长5-8cm。种子间微缢缩，呈不明显的串珠状，疏生短柔毛。种子3-7颗，近球形，黑色。花期5-7月，果期7-9月。"}]},{"ID":"20240611134348-noo2wik","Type":"NodeParagraph","Properties":{"id":"20240611134348-noo2wik","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611134348-lxgkmz6","Type":"NodeParagraph","Properties":{"id":"20240611134348-lxgkmz6","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 生物学特性 对土壤要求不严，一般砂壤和粘壤上均可生长，为深根性植物，应选择地下水位低，排水良好地块种植。当年播种的幼苗多不开花，冬季叶子变黄脱落进入休眠，至翌年春重新返青生长，6月孕蕾开花，7-8月中旬果实成熟，全年生长期约210d，种子干粒重49.63g。"}]},{"ID":"20240611134348-ya1yz1w","Type":"NodeParagraph","Properties":{"id":"20240611134348-ya1yz1w","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"栽培技术 种子繁殖：播种前用40-45℃温水浸10-12h，或进行沙藏，1：3混合放在0-10℃左右条件下处理20-30d，南方3-4月，北方4月播种，按行距65cm，株距30cm穴播，每穴播种8-10粒，覆土2-3cm。1hm2播种量22.5-37.5kg，播后温度在15-19℃，有足够湿度约25d即出苗。苗高15-16cm时，匀苗、补苗，每穴留苗3-4株。"}]},{"ID":"20240611134348-dgiddp4","Type":"NodeParagraph","Properties":{"id":"20240611134348-dgiddp4","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"田间管理 及时除草、浇水、培土，每年追肥l-2次，第1次在5月中、下旬，第2次在8月间，以粪肥和厩肥为主。"}]},{"ID":"20240611134348-9ft8jwe","Type":"NodeParagraph","Properties":{"id":"20240611134348-9ft8jwe","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611134348-9giuz9i","Type":"NodeParagraph","Properties":{"id":"20240611134348-9giuz9i","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根长圆柱形，下部常分枝，长10-30cm，直径l-2.5cm。表面棕黄色至灰棕色，具纵皱纹及横生皮孔。栓皮薄，常破裂反卷，易剥落，露出黄色内皮。质硬，不易折断，折断面纤维性。切片厚3-6mm，切面黄白色，具放射状纹理。气做，味苦。以条匀、断面黄白、味极苦者为佳。"}]},{"ID":"20240611134348-jxrhmto","Type":"NodeParagraph","Properties":{"id":"20240611134348-jxrhmto","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：木栓层为8-12列细胞，有时栓皮剥落。韧皮部有多数纤维常数个至数十个成束。束间形成层有的不明显。木质部自中央向外分叉为2-4束，木质部束导管l-2列，直径至72μm，木纤维常沿切向排列。射线宽5-15列细胞，中央有少数细小导管及纤维束散在。薄壁细胞中含众多淀粉粒及草酸钙方晶。"}]},{"ID":"20240611134348-eovgks2","Type":"NodeParagraph","Properties":{"id":"20240611134348-eovgks2","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡黄色。①纤维众多成束，非木化，平直或稍弯曲，直径11-27μm，纤维周围的细胞中含草酸钙方晶，形成晶纤维。②导管主为具缘纹孔导管，淡黄色或黄色，直径27-126μm，具缘纹孔椭圆形，排列紧密，有的数个纹孔口连成线状。③木栓细胞表面观多角形，多层重叠，平周壁表面有不规则细裂纹。④薄壁细胞类圆形或类长方形，有的垂周壁呈不均匀连珠状，胸腔内含细小草酸钙针晶，长达11μm。此外，有众多淀粉粒及少数石细胞。"}]},{"ID":"20240611134348-d1vcbk5","Type":"NodeParagraph","Properties":{"id":"20240611134348-d1vcbk5","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611134348-rv4hwud","Type":"NodeParagraph","Properties":{"id":"20240611134348-rv4hwud","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 苦参碱注射于家兔，发现中枢神经麻痹现象，同时发生痉挛，终则呼吸停止而死。注射于青蛙，初呈兴奋，继则麻痹，呼吸变为缓慢而不规则，最后发生痉挛，以致呼吸停止而死；其痉挛的发作，恐系起因于脊髓反射的亢进。对家兔的最小致死量为0.4g／kg。苦参生物碱对冷血和温血动物均有引起痉挛和麻痹呼吸中枢的作用。接受较大剂量药物的小鼠出现燥跳、痉挛性抽搐等兴奋现象；静脉注射家兔开始出现畏惧不安，最后呼吸困难而死亡。槐果碱当大剂量（150mg/kg）注入家兔体内时，引起静脉充血、血压下降、呼吸次数明显减少，呼吸麻痹而中毒死亡。苦参生物碱LD50测定结果报道不一致。苦参总黄酮给小鼠静脉注射的LD50为103.1±7.66g／kg。小鼠肌肉注射和静脉注射氧化苦参碱的LD50分别为256.74±573.6mg／kg和144.2±22.8mg／kg。灌胃和肌肉注射苦参浸膏小鼠的LD50分别为14.5g／kg和14.4g／kg。小鼠皮下注射苦参结晶碱的LD50为571.2±48.8mg／kg犬肌肉注射苦参碱结昌（200mg／kg）或苦参浸膏（0.1g／kg），鸽肌肉注射苦参生物碱（100mg／kg）均未见中毒症状。苦参避孕栓对小白鼠阴道、宫颈无刺激性。"}]},{"ID":"20240611134348-dgyncrk","Type":"NodeParagraph","Properties":{"id":"20240611134348-dgyncrk","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611134348-1sgfk3r","Type":"NodeParagraph","Properties":{"id":"20240611134348-1sgfk3r","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 根中含生物碱：苦参碱（matrine），氧化苦参碱（oxymatrine），N-氧化槐根碱（N-oxysophocarpine）、槐定碱（sophoridine），右旋别苦参碱（-allomatrine），右旋异苦参碱（I-somatrine），右旋槐花醇（sophoranol），（＋）槐花醇N-氧化物（sophoranol N-oxide），左旋槐根碱（sophocarpine），左旋槐胺碱（sophoramine），右旋-N-甲基金雀花碱（N-methylcytisine），左旋臭豆碱（anagyrine），赝靛叶碱（baptifoline）。根中还含多种黄酮类化合物：苦参新醇（kushenol）A、B、C、D、E、F、G、H、I、J、K、L、M、N、O，苦参查耳酮（kuraridin），苦参查耳酮醇（kuraridinol），苦参醇（kurarinol），新苦参醇（neokurarinol），降苦参醇（norkurarinol），异苦参酮（isokurarinone），刺芒柄花素（for-mononetin），苦参酮（kurarinone），降苦参酮（norkurarinone），甲基苦参新醇C（methylkushenol C），l-山槐素（lmaackiain），三叶豆紫檀甙（trifolirhizin）及三叶豆紫檀甙丙二酸酯（rtifolirhizin-6”-O-malonate），苦参素（kushenin），异脱水淫羊藿素（isoanhy-droicaritin），降脱水淫羊藿素（noranhydroicaritin），黄腐醇（xan-thohumol），异黄腐酸（isoxanthohumol），木犀草素-7-葡萄糖甙（luteolin-7-glucoside）。此外，根中还含有三萜皂甙：苦参皂甙（sophoraflavoside）Ⅰ，Ⅱ、Ⅲ、Ⅳ，大豆皂甙（soyasaponin）I以及醌类化合物：苦参醌（kushequinone）A。地上部分含生物碱：苦参碱，氧化苦参碱，右旋一别苦参减，异苦参碱，槐花醇，槐花醇N-氧化物，臭豆碱，赝靛叶碱，左旋-N-甲基金雀花碱，左旋-槐根碱，左旋-槐胺碱，右旋-N-氧化槐根碱，左族-△7-脱氢槐胺碱（△7-dehydrosophoramine），异槐根碱（isosophocarpine），左旋-13，14去氢槐定碱（13，14-dehy-drosophoridine），右旋-9a-羟基苦参碱（9a-hydroxymatrine），左旋-9a-羟基槐根碱（9a-hydroxysophocarpine），左旋-9a-羟基槐根碱-N-氧化物（9a-hydroxysophocarpine N-oxide），左旋-7，8-脱氢槐胺碱（7，8-dehydrosophoramine），左旋-9a-羟基槐胺碱（9a-hydrox-ysophoramine），N-甲基金雀花碱二聚体（dimer of N-methyleyti-sine），槐定碱，有旋-12-去氢苦参碱（lehmannine）。还含2-烷基色酮衍生物（2-alkylchromone derivatives），其中以2-正二十一烷基-5，7-二羟基-6，8-二甲基色酮（2-n-heneicosyl-5，7-dihydroxy-6，8-dimethyl chromone）和2-正二十三烷基-5，7-二羟基-6，8-二甲基色酮（2-n-tricosyl-5，7-dihydroxy-6，8-dimethylchromone）为主，还有2-正十三烷基（2-n-tridecyl）-、2-正十五烷基（2-n-pentadecyl）-、2-正十七烷基（2-n-heptadecyl）-、2-正十九烷基（2-n-nonadecyl）和2-正二十五烷基（2-n-pentacosyl）-的5,7-二羟基-6，8-二甲基色酮（5，7-dihydroxy-6，8-dimethyl chromone）。"}]},{"ID":"20240611134348-q31rdd9","Type":"NodeParagraph","Properties":{"id":"20240611134348-q31rdd9","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"花中含生物碱：右旋-苦参碱，右旋-氧化苦参碱，左旋-7，11-去氢苦参碱（7，11-dehydromatrine），右旋-5a，9a-二羟基苦参碱（5a，9a-dihydroxymatrine），左旋-槐根碱，N-氧化槐根碱，左旋-槐胺碱，左旋-9a-羟基槐胺碱，右旋-槐花醇，槐花醇-N-氧化物，羽扇豆碱（lupanine），左旋-臭豆碱，左旋-赝靛叶碱，左族-N-甲基金雀花碱，左旋-菱叶野决明碱（-rhombifoline），右旋-黄叶槐碱（mamanine），右旋-苦参胺（kuraranine），异苦参胺（isokuraramine）。"}]},{"ID":"20240611134348-2jhn7vh","Type":"NodeParagraph","Properties":{"id":"20240611134348-2jhn7vh","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611134348-ewsziyy","Type":"NodeParagraph","Properties":{"id":"20240611134348-ewsziyy","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 1.抗肿瘤作用：苦参碱具有抗癌活性，小鼠腹腔注射500μg.d组2mo存活率为40%，而对照组在23天内全部死亡。氧化苦参碱则对此无作用。苦参碱在体外具有降低小鼠腹腔巨噬细胞抑制P815肿瘤细胞增殖的效应。槐果碱（Sophocarpine）亦有抗癌活性，在实验小鼠体内对S-180、U-14.ECA、L等瘤株均表现明显的抑制作用。苦参碱、氧化苦参碱、槐果碱及其不同比例混合的A、B、C碱对S-180实体瘤均有不同程度的抑制作用，各单体生物碱的抑瘤率均在35%以上，经不同比例混合的C碱剂量在113mg／（kg·d）时，连续腹腔注射给药10天抑瘤率达61.38%，比总碱提高23.5%，与单纯苦参碱相比，有显着差异（P＜0.01）。苦参碱对慢性粒细胞白血病外周多向造血祖细胞集落产生率有显着的抑制作用，抑制率达0.76，最佳抑制浓度为100mg／L。苦参水煎液作用于体外培养的人早幼粒白血病细胞，在剂量为8mg／ml时，可显着地诱导白血病细胞向单核巨噬细胞方向分化。"}]},{"ID":"20240611134348-wlebvht","Type":"NodeParagraph","Properties":{"id":"20240611134348-wlebvht","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"2.升白细胞作用：氧化苦参碱可防止小鼠因MMC、环磷酰胺所致小鼠白细胞减少症，静脉注射或肌肉注射30mg/kg苦参总碱和100mg／kg氧化苦参碱对正常家兔外周血白细胞数有明显的升高作用，而且氧化苦参碱对正常家兔升白作用的显效时间、维持时间和白细胞计数峰值与苦参总碱相比，在给药后的18天内基本是一致的，升白效果优于鲨肝醇。在苦参总碱、氧化苦参碱、苦参碱对家兔X线600伦照射后引起的白细胞减少症的治疗实验中，苦参总碱组从给药5天后到第l9天，白细胞计数基本保持在6000／mm3以上，而对照组直到22天才恢复上述水平；氧化苦参碱的升白效价不高于总碱，苦参碱则未见治疗效果。氧化苦参碱对家兔经60钴r-射线500伦全身照射后引起的白细胞减少症，剂量率为31伦／min，显示一定防治作用，在剂量率为120伦／min无防治作用。"}]},{"ID":"20240611134348-7cxmf2b","Type":"NodeParagraph","Properties":{"id":"20240611134348-7cxmf2b","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的作用：1/4LD50的苦参碱和氧化苦参碱静脉注射显着对抗乌头碱和氯仿-肾上腺素诱发的大鼠心律失常；腹腔注射显着对抗氯仿诱发的小鼠心室纤颤，也提高乌头碱诱发大鼠心律失常所需的用量，对抗氯化钡诱发的大鼠心律失常和结扎大鼠冠脉前降支诱发的心律失常。给兔静脉注射30mg／kg氧化苦参碱，缩短肾上腺素诱发的心律失常恢复时间，治疗给药平均缩短43%，预防给药平均缩短22%。静脉注射42mg／kg槐果碱可对抗氯化钙诱发的小鼠室性心律失常和乌头碱诱发的大鼠心律失常；静脉注射l6mg／kg能提高哇巴因引起兔早搏和心脏停搏所需用量，也能对抗冠脉阻塞-再灌流诱发犬心律失常，但不能对抗氯化钙-乙酰胆碱诱发小鼠房颤（扑）和氯仿-肾上腺素诱发兔心律失常。静脉注射l／5 LD50的槐定碱（11mg／kg）可预防或治疗乌头碱诱发的大鼠心律夫常，也可提高豚鼠对哇巴因引起各种心律失常的耐受量，防止氯化钡和氯化钙诱发大鼠心律失常。1/10 LD50剂量（5mg/kg）显着缩短肾上腺素引起兔心律失常时间，且作用持续时间远较奎尼丁长。也能提高兔左心室电致颤阈值，且随静脉注射剂量增大而提高，还能剂量相关地降低氯仿或四氯化碳诱发的小鼠室颤率，以及对抗四氯化碳-肾上腺素引起的兔心律失常。苦参生物碱有扩张血管和对急性心肌缺血的保护作用。对麻醉家兔可引起明显的降压作用，一般降压20mmHg左右，持续2-3分钟恢复正常；对离体兔耳血管能立即引起扩张，并且持续10分钟左右；对急性失血性心脏能延长其停搏时间，延长时间为7分钟左右；对脑垂体后叶素所致急性心肌缺血有明显的保护作用。氧化苦参碱可增加兔心房收缩力，且有良好的量-效关系，9μm不影响心肌兴奋性，但缩短功能不应期；降低肾上腺素诱发左心房自律性的阈浓度；减慢右心房自动节律，并降低CaCl2对右心房的正性频率作用。中毒量（360μm）可降低心肌收缩力和兴奋性。氧化苦参碱50μmol/L可拮抗异丙肾上腺素的正性频率作用。而氧化苦参碱（100μmol/L）在培养心肌细胞较低（高）浓度可使以α（β）受体介导产生负（正）性频率作用。苦参碱可减慢豚鼠右房自动频率，增加右房收缩力和降低左房MDF（最大驱动频率），并呈剂量依赖关系；其负性频率，正性肌力和负性MDF作用均呈直线相关。苦参碱可抑制乌头碱诱发大鼠左房自律性作用或延长乌头碱诱发自动节律的潜伏期和减慢其初始频率；也可提高哇巴因诱发豚鼠右房心律失常和肾上腺素注射液诱发豚鼠左房自律性的阈浓度，并对哇巴因的正性肌力作用有增强效应。苦参碱能被Ca2+通道阻滞剂维拉帕米（1μmol／l）显着抑制，且抑制平滑肌大于心肌，提示苦参碱的正肌力作用可能与激活Ca2+通道有关。苦参碱可提高大鼠血浆中cAMP含量和降低cMP水平，对心肌组织cAMP和cGMP含量无显着影响。槐定碱可提高大鼠血浆中cAMP水平和心肌组织中cAMP含量。氧化苦参碱50μmol/L和250μmol／L对丝裂霉素C所致体外培养心肌细胞损伤乳酸脱氢酶含量升高有显着的抑制作用，并能减轻由缺糖缺氧造成的心肌细胞损伤，但对氯丙嗪所致的心肌细胞损伤无保护作用。肌肉注射氧化苦参碱具有明显延长小鼠异体游离移植心肌存活期的作用，并随剂量加大其作用增强。苦参总黄酮125-250μg/ml时，能减慢培养乳鼠心肌细胞团自发搏动的频率，并能对抗心肌细胞团自发性及哇巴因诱发的搏动节律失常。苦参总黄酮对小鼠吸入氯仿所致心室纤颤有明显的对抗作用，其LD50为23.9±1.1g／kg，治疗指数为3.56。给家兔静脉注射苦参总黄酮8g和30g／kg，30-60分钟后，能明显对抗氯仿-肾上腺素引起的心律失常。完全对抗率分别为40%和70%。静脉注射苦参总黄酮20-40g／kg，对静脉注射乌头碱所致大鼠心律失常有明显地治疗作用。第一次治疗有效率达63%，第二次治疗的有效率为84%。大鼠静脉注射苦参碱能显着对抗乌头碱、氯化钡和结扎冠脉所致的心律失常给麻醉大鼠静脉注射苦参总黄酮30g／kg和60g／kg，呈现明显地负性自律性作用，负性频率作用和负性传导作用。这些作用随剂量的增加而增强。"}]},{"ID":"20240611134348-c11q6mi","Type":"NodeParagraph","Properties":{"id":"20240611134348-c11q6mi","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"4.平喘祛痰作用：苦参碱主要是通过兴奋β受体，尤其是兴奋中枢的β受体，解除支气管痉挛及抑制抗体和慢反应物质的释放而产生平喘作用的。苦参碱在有钙或无钙克氏营养液中，均能对抗乙酰胆碱氯化钡兴奋离体豚鼠、大鼠气管和肠管的作用。苦参总碱、氧化苦参碱对组胺致喘豚鼠的平喘效果与氨茶碱基本相似，1小时平喘率都在90%以上，而对照组在15%左右；平喘时间上，氨茶碱在6小时平喘率是55%，苦参总碱则在80%以上。槐果碱Ach的致喘作用比氨茶碱强，其平喘作用可能是通过兴奋中脑的β-受体而起作用。酚红排泌法证明、小鼠灌胃苦参总碱、黄酮0.8g／kg，有明显祛谈作用。"}]},{"ID":"20240611134348-cshv243","Type":"NodeParagraph","Properties":{"id":"20240611134348-cshv243","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"5.安定作用：苦参总碱50-100mg／kg能明显抑制小鼠的自由活动；400mg／kg对小鼠被动活动明显抑制；100-200mg／kg能抑制孤独小鼠的欧斗攻击行为；苦参总碱25-40mg／kg与冬眠灵（5mg／kg）合用，可致小鼠翻正反射消失，100-200mg／kg苦参总碱能明显加强0.5mg／kg利血平对小鼠自发活动的抑制作用；苦参总碱50-200mg／kg与腹腔注射阈下剂量的戊巴比妥钠20-25mg／kg合用，可致小鼠入睡；分别与硫喷妥钠（腹腔注射，40mg／kg）、水合氯醛（腹腔注射，200mg/kg）合用，能显着加强其中枢抑制作用。亦能明显对抗中枢兴奋剂苯丙胺（腹腔注射，4-6mg／kg）及咖啡因（50mg／kg）所致的精神运动性兴奋；苦参总碱对士的宁及戊四氮所致的惊厥不但无对抗作用，反而使其惊厥增强和增加其动物死亡数；苦参总碱单独使用有轻度的镇痛作用，与阈剂量吗啡合用，可显着增加其镇痛百分率。"}]},{"ID":"20240611134348-w5yfn8s","Type":"NodeParagraph","Properties":{"id":"20240611134348-w5yfn8s","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"6.抗过敏作用：苦参碱可降低过敏介质的释放，为免疫抑制剂，其抑制50%T细胞增殖的浓度为0.55-0.56mg／ml；抑制IL-2产量的浓度为0.1mg／kg。"}]},{"ID":"20240611134348-xlj7r17","Type":"NodeParagraph","Properties":{"id":"20240611134348-xlj7r17","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"7.免疫抑制作用：苦参碱、氧化苦参碱在1／5 LD50剂量下对小鼠免疫功能均有抑制作用。兔、大鼠肌肉注射氧化苦参碱150mg／kg或100mg／kg对被动或主动皮肤过敏反应均有明显抑制作用，并对兔血清IgE抗体形成有明显抑制作用。腹腔注射氧化苦参碱200mg／kg·d，共21天，对小鼠速发型变态反应引起的死亡有保护作用。"}]},{"ID":"20240611134348-qp0tvnf","Type":"NodeParagraph","Properties":{"id":"20240611134348-qp0tvnf","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"8.其它作用：肌肉注射氧化苦参碱能明显对抗巴豆油、角叉菜胶（大鼠）和冰醋酸（小鼠）诱发的渗出性炎症。兔灌胃、皮下注射、静脉注射、腹腔注射和肌肉注射苦参煎剂、苦参注射液及苦参碱均有利尿作用，尿中氯化钠量有显着增加。苦参50%甲醇浸膏具有抗盐酸乙醇所致的溃疡作用，其活性成分为苦参酮（Kurarinone）。此外，苦参碱体内外均有抗菌作用，体内作用强度与氯霉素相当，醇浸膏体外有抗滴虫作用，其强度与蛇麻子相近。"}]},{"ID":"20240611134348-wv1azif","Type":"NodeParagraph","Properties":{"id":"20240611134348-wv1azif","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611134348-0s9y8ri","Type":"NodeParagraph","Properties":{"id":"20240611134348-0s9y8ri","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去残茎，洗净泥土，用水浸泡，捞出，润透，切片，晒干；先需用糯米浓泔汁浸一宿，上有腥秽气并在水面上浮，并须重重淘过，即蒸，从巳至申出，晒干细锉用之。"}]},{"ID":"20240611134348-zbp9gmx","Type":"NodeParagraph","Properties":{"id":"20240611134348-zbp9gmx","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611134348-dodfm0q","Type":"NodeParagraph","Properties":{"id":"20240611134348-dodfm0q","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （l）取本品横切片加氢氧化钠试液数滴，栓皮即呈橙红色，渐变血红色，久置不消失。木质部不呈现颜色反应。（检查色素）（2）本品粉末0.5g，加1％盐酸15ml，水浴加热10min，滤过。分取滤液于3支小试管中，分别加入碘化铋钾、碘化汞钾及碘化钾碘试剂，均产生沉淀。（检查生物碱）（3）取本品粉末0.5g，加甲醇10ml，加热回流10min，滤过。取滤液lml，置试管中，加镁粉少量与盐酸3-4滴，加热，显红色。另取滤液5μl，点于滤纸上，喷以5％三氧化铝乙醇溶液，晾干，置紫外光灯（254nm）下观察，显黄绿色荧光。（检查黄酮）（4）薄层色谱 取本品粉末0.5g，加氯仿25ml，浓氨试液0.3ml，放置过夜，滤过，滤液蒸干，残渣加氯仿0.5ml使溶解，作为供试品溶液。另取氯化苦参碱和槐定碱对照品，加乙醇制成每lml各含0.2mg的混合溶液，作为对照品溶液。吸取上述两种溶液各4μl，分别点于同一用2％氢氧化钠溶液制备的硅胶G薄层板上，以苯-丙酮-甲醇（8：3：O.5）为展开剂，展开，展距约8cm，取出，晾干，再以甲苯-醋酸乙酯-甲醇-水（2：4：2：1）10℃以下放置后的上层溶液为展开剂，展开，展距与第1次相同，取出，晾干，依次喷以碘化秘钾试液和亚硝酸钠乙醇试液。"}]},{"ID":"20240611134348-l951r4g","Type":"NodeParagraph","Properties":{"id":"20240611134348-l951r4g","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"供试品色谱中，在与对照品色谱相应的位置上，显相同的两个棕色斑点。"}]},{"ID":"20240611134348-8zdbeb6","Type":"NodeParagraph","Properties":{"id":"20240611134348-8zdbeb6","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"品质标志《中华人民共和国药典》1995年版规定：本品含生物碱以苦参碱计算，不得少于2.0％。"}]},{"ID":"20240611134348-irfu1uz","Type":"NodeParagraph","Properties":{"id":"20240611134348-irfu1uz","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611134348-k73c0p7","Type":"NodeParagraph","Properties":{"id":"20240611134348-k73c0p7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 肝；肾；大肠；小肠经；膀胱；心经"}]},{"ID":"20240611134348-pob6gdh","Type":"NodeParagraph","Properties":{"id":"20240611134348-pob6gdh","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611134348-y9t4wz1","Type":"NodeParagraph","Properties":{"id":"20240611134348-y9t4wz1","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒"}]},{"ID":"20240611134348-1q7yoep","Type":"NodeParagraph","Properties":{"id":"20240611134348-1q7yoep","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611134348-ein7fq7","Type":"NodeParagraph","Properties":{"id":"20240611134348-ein7fq7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 1.脾胃虚寒者忌服。"}]},{"ID":"20240611134348-tb5l0nn","Type":"NodeParagraph","Properties":{"id":"20240611134348-tb5l0nn","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"2.《医学入门》：胃弱者慎用。"}]},{"ID":"20240611134348-t92hxwp","Type":"NodeParagraph","Properties":{"id":"20240611134348-t92hxwp","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：久服能损肾气，肝、肾虚而无大热者勿服。"}]},{"ID":"20240611134348-rzlhlkt","Type":"NodeParagraph","Properties":{"id":"20240611134348-rzlhlkt","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611134348-phhkpis","Type":"NodeParagraph","Properties":{"id":"20240611134348-phhkpis","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 清热燥湿；祛风杀虫。主湿热泻痢；肠风便血；黄疸；小便不利；水肿；带下；阴痒；疥癣；麻风；皮肤瘙痒；湿毒疮疡"}]},{"ID":"20240611134348-hbbz7rx","Type":"NodeParagraph","Properties":{"id":"20240611134348-hbbz7rx","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611134348-fl2z4cx","Type":"NodeParagraph","Properties":{"id":"20240611134348-fl2z4cx","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。外用：适量，煎水熏洗；或研末敷；或浸洒搽。"}]},{"ID":"20240611134348-bp7u0q7","Type":"NodeParagraph","Properties":{"id":"20240611134348-bp7u0q7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611134348-gd2xt2h","Type":"NodeParagraph","Properties":{"id":"20240611134348-gd2xt2h","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：苦参，能峻补阴气，或得之而致腰重者，因其气降而不升也，非伤肾之谓也。其治大风有功，况风热细疹乎。"}]},{"ID":"20240611134348-8eeuivy","Type":"NodeParagraph","Properties":{"id":"20240611134348-8eeuivy","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"2.《本草纲目》：苦参、黄柏之苦寒，皆能补肾，盖取其苦燥湿，寒除热也。热生风，湿生虫，故又能治风杀虫。惟肾水弱而相火胜者用之相宜，若火衰精冷，真元不足，及年高之人不可用也。张从正亦云，凡药皆毒也，虽甘草、苦参，不可不谓之毒，久服则五味各归其脏，必有偏胜气增之患，诸药皆然，学者当触类而长之可也，至于饮食亦然。又按《史记》云，太仓公淳于意医齐大夫病龋齿，灸左手阳明脉，以苦参汤日漱三升，出入慎风，五、六日愈，此亦取其去风气湿热杀虫之义。"}]},{"ID":"20240611134348-esjs818","Type":"NodeParagraph","Properties":{"id":"20240611134348-esjs818","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：姚斐成云，苦参，祛风泻火，燥湿去虫之药也。前人谓苦参补肾补阴，其论甚谬。盖此药味苦气腥，阴燥之物，秽恶难服，惟肾气实而湿火胜者宜之；若火衰精冷，元阳不足，及年高之人，胃虚气弱，非所宜也。况有久服而致腰重者，因其专降而不升，实伤肾之谓也，何有补肾补阴之功乎？。"}]},{"ID":"20240611134348-suayifu","Type":"NodeParagraph","Properties":{"id":"20240611134348-suayifu","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"4.《本草经百种录》：苦参，专治心经之火，与黄连功用相近。但黄连似去心脏之火为多，苦参似去心腑小肠之火为多，则以黄连之气味清，而苦参之气味浊也。按补中二字，亦取其苦以燥脾之义也。"}]},{"ID":"20240611134348-kb2gheu","Type":"NodeParagraph","Properties":{"id":"20240611134348-kb2gheu","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"5.《长沙药解》：《金匮》苦参汤，治狐惑蚀于下部者，以肝主筋，前阴者宗筋之聚，土湿木陷，郁而为热，化生虫NI，蚀于前阴，苦参清热而去湿，疗疮而杀虫也。当归贝母苦参丸，用之治妊娠小便难，以土湿木陷，郁而生热，不能泄水，热传膀胱，以致便难，苦参清湿热而通淋涩也。"}]},{"ID":"20240611134348-xevc6sa","Type":"NodeParagraph","Properties":{"id":"20240611134348-xevc6sa","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"6.《本草正义》：苦参，大苦大寒，退热泄降，荡涤湿火，其功效与芩、连、龙胆皆相近，而苦参之苦愈甚，其燥尤烈，故能杀湿热所生之虫，较之芩、连力量益烈。近人乃不敢以入煎剂，盖不特畏其苦味难服，亦嫌其峻厉而避之也。然毒风恶癞，非此不除，今人但以为洗疮之用，恐未免因噎而废食耳。"}]},{"ID":"20240611134348-2zbouqh","Type":"NodeParagraph","Properties":{"id":"20240611134348-2zbouqh","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"7.《神农本草经》：主心腹结气，症瘕积聚，黄疸，溺有余沥，逐水，除痈肿，补中，明目止泪。"}]},{"ID":"20240611134348-fww16fg","Type":"NodeParagraph","Properties":{"id":"20240611134348-fww16fg","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"8.《名医别录》：养肝胆气，安五脏，定志益精，利九窍，除伏热肠澼，止渴，醒酒，小便黄赤，疗恶疮下部疡，平胃气，令人嗜食。"}]},{"ID":"20240611134348-4ye9xno","Type":"NodeParagraph","Properties":{"id":"20240611134348-4ye9xno","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"9.陶弘景：恶病人酒渍饮之，患疥者服亦除，盖能杀虫。"}]},{"ID":"20240611134348-tfldem8","Type":"NodeParagraph","Properties":{"id":"20240611134348-tfldem8","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"10.《药性论》：治热毒风，皮肌烦燥生疮，赤癞眉脱，主除大热嗜睡，治腹中冷痛，中恶腹痛，除体闷，治心腹积聚。"}]},{"ID":"20240611134348-jv8px3o","Type":"NodeParagraph","Properties":{"id":"20240611134348-jv8px3o","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"11.《唐本草》：治胫酸，疗恶虫。"}]},{"ID":"20240611134348-ncbppig","Type":"NodeParagraph","Properties":{"id":"20240611134348-ncbppig","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：杀疳虫。炒带烟出为末，饭饮下，治肠风下血并热痢。"}]},{"ID":"20240611134348-hedybbv","Type":"NodeParagraph","Properties":{"id":"20240611134348-hedybbv","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"13.《珍珠囊》：去湿。"}]},{"ID":"20240611134348-5pyblj7","Type":"NodeParagraph","Properties":{"id":"20240611134348-5pyblj7","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"14.《滇南本草》：凉血，解热毒，疥癞，脓窠疮毒。疗皮肤瘙痒，血风癣疮，顽皮白屑，肠风下血，便血。消风，消肿毒，痰毒。"}]},{"ID":"20240611134348-l835efw","Type":"NodeParagraph","Properties":{"id":"20240611134348-l835efw","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"15.《本草从新》：燥湿，胜热，治梦遗滑精。"}]},{"ID":"20240611134348-nf3t493","Type":"NodeParagraph","Properties":{"id":"20240611134348-nf3t493","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611134348-6e96x0k","Type":"NodeParagraph","Properties":{"id":"20240611134348-6e96x0k","updated":"20240611134348"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611134349-5ub406k","Type":"NodeThematicBreak","Properties":{"id":"20240611134349-5ub406k"}},{"ID":"20240611134350-xu2w9tw","Type":"NodeParagraph","Properties":{"id":"20240611134350-xu2w9tw"}}]}