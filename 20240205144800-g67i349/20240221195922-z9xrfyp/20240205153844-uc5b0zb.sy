=\"width: 663px;\" parent-style=\"width: 673px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619141521-sjmu21e","Type":"NodeParagraph","Properties":{"id":"20240619141521-sjmu21e","updated":"20240807132622"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 720px;","style":"width: 710px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子6-20240619141521-r43xyuk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 710px;\" parent-style=\"width: 720px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子7-20240619141655-nxxqpux.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807135129-gxttckt","Type":"NodeParagraph","Properties":{"id":"20240807135129-gxttckt","updated":"20240807135129"}},{"ID":"20240807135129-7k45th0","Type":"NodeParagraph","Properties":{"id":"20240807135129-7k45th0","updated":"20240807135201"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为伪品（双荚决明）"}]},{"ID":"20240807143126-1eu80gi","Type":"NodeParagraph","Properties":{"id":"20240807143126-1eu80gi","updated":"20240807143206"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 329px;","style":"width: 319px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"双荚决明"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/双荚决明-20240807143126-4y8q33k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 319px;\" parent-style=\"width: 329px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 728px;","style":"width: 718px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"双荚决明 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/双荚决明 1-20240807143206-vdevm5x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 718px;\" parent-style=\"width: 728px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807135231-ja0nvst","Type":"NodeParagraph","Properties":{"id":"20240807135231-ja0nvst","updated":"20240807135253"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 531px;","style":"width: 521px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子-20240807135231-ehb3h1u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 521px;\" parent-style=\"width: 531px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 532px;","style":"width: 522px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子 1-20240807135253-b03bfze.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 522px;\" parent-style=\"width: 532px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807135301-gef72qw","Type":"NodeParagraph","Properties":{"id":"20240807135301-gef72qw","updated":"20240807135311"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 536px;","style":"width: 526px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子 3-20240807135306-s9fossm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 526px;\" parent-style=\"width: 536px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 533px;","style":"width: 523px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子 2-20240807135301-qrjkcow.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 523px;\" parent-style=\"width: 533px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807141516-59nv1bc","Type":"NodeParagraph","Properties":{"id":"20240807141516-59nv1bc","updated":"20240807141516"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 540px;","style":"width: 530px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"决明子 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/决明子 5-20240807141516-eswz03x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 530px;\" parent-style=\"width: 540px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807133951-wuo5md8","Type":"NodeParagraph","Properties":{"id":"20240807133951-wuo5md8","updated":"20240807134014"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：药用决明子要用炒熟的；"}]},{"ID":"20240807134525-w0zy1xy","Type":"NodeParagraph","Properties":{"id":"20240807134525-w0zy1xy","updated":"20240807143019"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：药用决明子是草决明的种子，为草本植物，不是木本植物，最高长到两米左右；（有一种木本植物的决明子，叫双荚决明，双荚决明是外来入侵物种，是树）"}]},{"ID":"20240807142932-bfds4x0","Type":"NodeParagraph","Properties":{"id":"20240807142932-bfds4x0","updated":"20240807143048"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：草决明白天叶子展开，晚上会像含羞草一样把叶子合起来；"}]},{"ID":"20240616140507-cwnpofy","Type":"NodeThematicBreak","Properties":{"id":"20240616140507-cwnpofy"}},{"ID":"20240616140529-un3lcjj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140529-un3lcjj","updated":"20240616140532"},"Children":[{"Type":"NodeText","Data":"决明子《神农本草经》"}]},{"ID":"20240616140529-mkl2kil","Type":"NodeParagraph","Properties":{"id":"20240616140529-mkl2kil","updated":"20240616140529"},"Children":[{"Type":"NodeText","Data":"味咸平。"}]},{"ID":"20240616140529-gfkl6sv","Type":"NodeParagraph","Properties":{"id":"20240616140529-gfkl6sv","updated":"20240616140529"},"Children":[{"Type":"NodeText","Data":"主青盲，目淫，肤赤，白膜，眼赤痛，泪出。久服益精光（太平《御览》引作理目珠精，理，即治字），轻身。生川泽。"}]},{"ID":"20240616140529-w7rwotw","Type":"NodeParagraph","Properties":{"id":"20240616140529-w7rwotw","updated":"20240616140529"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：决明子，一名草决明，一名羊明（《御览》）。"}]},{"ID":"20240616140529-dn8sw3r","Type":"NodeParagraph","Properties":{"id":"20240616140529-dn8sw3r","updated":"20240616140529"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生龙门，石决明生豫章，十月采，阴干百日。"}]},{"ID":"20240616140529-2acdg7t","Type":"NodeParagraph","Properties":{"id":"20240616140529-2acdg7t","updated":"20240616140529"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：羊，英光也，又决明，羊明也；《尔雅》云：英光；郭璞云：英，明也，叶黄锐，赤华，实如山茱萸；陶宏景云：形似马蹄决明。"}]},{"ID":"20240616140507-3ftbcor","Type":"NodeThematicBreak","Properties":{"id":"20240616140507-3ftbcor"}},{"ID":"20240616140519-ssktqlc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140519-ssktqlc","updated":"20240616140523"},"Children":[{"Type":"NodeText","Data":"决明子《神农本草经百种录》"}]},{"ID":"20240616140519-6bf5utf","Type":"NodeParagraph","Properties":{"id":"20240616140519-6bf5utf","updated":"20240616140519"},"Children":[{"Type":"NodeText","Data":"味咸平。主青盲，目淫肤赤白膜，眼赤痛，泪出。凡目病内外等证，无所不治。久服，益精光，不但能治目邪，而且能补目之精也，其咸降清火功。轻身。火清则体健也。"}]},{"ID":"20240616140519-rlwnrvg","Type":"NodeParagraph","Properties":{"id":"20240616140519-rlwnrvg","updated":"20240616140519"},"Children":[{"Type":"NodeText","Data":"决明生于秋，得金气之正。其色极黄，得金之色，其功专于明目，详上扁青条内。夫金之正色，白而非黄，但白为受色之地，乃无色之色耳。故凡物之属金者，往往借土之色以为色，即五金亦以黄金为贵。子肖其母也，草木至秋，感金气则黄落，故诸花实之中，凡色黄而耐久者，皆得金气为多者也。"}]},{"ID":"20240616140508-hkkn6o7","Type":"NodeThematicBreak","Properties":{"id":"20240616140508-hkkn6o7"}},{"ID":"20240616140509-0jd8ftn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140509-0jd8ftn","updated":"20240616140514"},"Children":[{"Type":"NodeText","Data":"决明子《千金翼方》"}]},{"ID":"20240616140509-s8a1tsr","Type":"NodeParagraph","Properties":{"id":"20240616140509-s8a1tsr","updated":"20240616140509"},"Children":[{"Type":"NodeText","Data":"味咸苦甘，平，微寒，无毒。主青盲，目淫肤赤白膜，眼赤痛泪出。疗唇口青。久服益精光，轻身，生龙门川泽。石决明生豫章，十月十日采，阴干百日。"}]},{"ID":"20240607124739-j2m2io8","Type":"NodeThematicBreak","Properties":{"id":"20240607124739-j2m2io8"}},{"ID":"20240616140459-kunjlt0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140459-kunjlt0","updated":"20240616140503"},"Children":[{"Type":"NodeText","Data":"决明子《本草乘雅半偈》"}]},{"ID":"20240616140459-db4x6cd","Type":"NodeParagraph","Properties":{"id":"20240616140459-db4x6cd","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240616140459-co1jqg1","Type":"NodeParagraph","Properties":{"id":"20240616140459-co1jqg1","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"【气味】咸平，无毒。"}]},{"ID":"20240616140459-15ot7r3","Type":"NodeParagraph","Properties":{"id":"20240616140459-15ot7r3","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"【主治】主青盲，目淫肤赤白膜，眼赤，泪出。久服益精光，轻身。"}]},{"ID":"20240616140459-7qf81jd","Type":"NodeParagraph","Properties":{"id":"20240616140459-7qf81jd","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"【核】曰∶生龙门川泽者良。今处处有之。为园圃所莳。四月生苗，高三四尺。本小末大，叶似苜蓿，昼开夜合，两两相贴。七月开花，淡黄五出，结角如初生豇豆，长二三寸，角内列青碧子数十粒，参差相连，状如马蹄，下大上锐。一种本小末尖，叶不夜合者，茳芒也。蓍实为之使。恶大麻子。"}]},{"ID":"20240616140459-hlt9fzj","Type":"NodeParagraph","Properties":{"id":"20240616140459-hlt9fzj","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"绍隆王先生云∶决明禀阴精之体，具青阳之用；宜入肝肾，肝开窍于目，瞳子精光，肾所司也。"}]},{"ID":"20240616140459-gryvyqk","Type":"NodeParagraph","Properties":{"id":"20240616140459-gryvyqk","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"先人题药云∶决明叶昼开夜合，两两相贴。其叶夜不合者，茳芒也。人之眼夜合，故治眼疾，因名决明。味咸走血，气寒待热，故治青盲肤膜泪出，热伤血分者相宜；倘属气分，及"}]},{"ID":"20240616140459-fjnvvmd","Type":"NodeParagraph","Properties":{"id":"20240616140459-fjnvvmd","updated":"20240616140459"},"Children":[{"Type":"NodeText","Data":"【 】曰∶夏仲生苗，秋仲结实，独得呼出之机，俨具合张之相。味咸走血，故治目中诸眚（仲夏半夏生，盖当夏之半，夏仲决明生，亦当夏之半。秋仲结实，又当秋之半矣。然则夏之能张，秋之能合，枢机使然耳。）"}]},{"ID":"20240607124739-6rxt1ua","Type":"NodeThematicBreak","Properties":{"id":"20240607124739-6rxt1ua"}},{"ID":"20240616140446-84owj4q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140446-84owj4q","updated":"20240616140452"},"Children":[{"Type":"NodeText","Data":"决明子《本草图经》"}]},{"ID":"20240616140446-dputtdg","Type":"NodeParagraph","Properties":{"id":"20240616140446-dputtdg","updated":"20240616140448"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"决明子"},{"Type":"NodeText","Data":"，生龙门川泽，今处处有之。人家园圃所莳。夏初生苗，高三、四尺许，根带紫色；叶似苜蓿而大；七月有花，黄白色；其子作穗，如青绿豆而锐。十月十日采，阴干百日。按《尔雅》∶ ， 。释曰∶药草，决明也。郭璞注云∶叶黄锐，赤华，实如山茱萸。关西谓之 ，与此种颇不类。又有一种马蹄决明，叶如茳芏，于形似马蹄，故得此名。又萋蒿子亦谓之草决明，未知孰为入药者。然今医家但用子，如绿豆者。其石决明，是蚌蛤类，当在虫兽部中。"}]},{"ID":"20240616140557-diuhfpf","Type":"NodeThematicBreak","Properties":{"id":"20240616140557-diuhfpf"}},{"ID":"20240616140558-zourlyt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140558-zourlyt","updated":"20240616140602"},"Children":[{"Type":"NodeText","Data":"决明子《本草衍义》"}]},{"ID":"20240616140558-tn57ptf","Type":"NodeParagraph","Properties":{"id":"20240616140558-tn57ptf","updated":"20240616140558"},"Children":[{"Type":"NodeText","Data":"苗高四五尺，春亦为蔬，秋深结角。其子生角中，如羊肾。今湖南北人家园圃所种甚多，或在村野成段种。《蜀本·图经》言∶叶似苜蓿而阔大，甚为允当。"}]},{"ID":"20240616144616-c6kp7nw","Type":"NodeThematicBreak","Properties":{"id":"20240616144616-c6kp7nw"}},{"ID":"20240616144617-08dbxla","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144617-08dbxla","updated":"20240616144621"},"Children":[{"Type":"NodeText","Data":"决明子《名医别录》"}]},{"ID":"20240616144617-w40xsua","Type":"NodeParagraph","Properties":{"id":"20240616144617-w40xsua","updated":"20240616144617"},"Children":[{"Type":"NodeText","Data":"味苦、甘，微寒，无毒．主治唇口青．生龙门，石决明生豫章．十月十日采，阴干（蓍实为之使，恶大麻子．）"}]},{"ID":"20240616144617-g3h377c","Type":"NodeParagraph","Properties":{"id":"20240616144617-g3h377c","updated":"20240616144617"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶决明子，味咸，平．主青盲，目淫肤，赤白膜，眼赤痛泪出．久服益精光，轻身．生川泽．"}]},{"ID":"20240616144606-p13tm6e","Type":"NodeThematicBreak","Properties":{"id":"20240616144606-p13tm6e"}},{"ID":"20240616144607-uejh79z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144607-uejh79z","updated":"20240616144611"},"Children":[{"Type":"NodeText","Data":"决明子《新修本草》"}]},{"ID":"20240616144607-b18wcnm","Type":"NodeParagraph","Properties":{"id":"20240616144607-b18wcnm","updated":"20240616144607"},"Children":[{"Type":"NodeText","Data":"味咸、苦、甘、平、微寒、无毒。主青盲，目淫，肤赤，白膜，眼赤痛，泪出。疗唇口青。久服益精光，轻身。生龙门川泽，石决明生豫章。十月十日采，阴干百日。"}]},{"ID":"20240616144607-dn60eji","Type":"NodeParagraph","Properties":{"id":"20240616144607-dn60eji","updated":"20240616144607"},"Children":[{"Type":"NodeText","Data":"蓍实为之使，恶大麻子。龙门乃在长安北。今处处有。叶如茳芒，子形似马蹄，呼为马蹄决明。用之当捣碎。又别有草决明，是萋蒿子，在下品中也。"}]},{"ID":"20240616144607-b96g6if","Type":"NodeParagraph","Properties":{"id":"20240616144607-b96g6if","updated":"20240616144607"},"Children":[{"Type":"NodeText","Data":"〔谨案〕石决明，是蚌蛤类，形似紫贝，附见别出在鱼兽条中，皆主明目，故并有决明之名。俗方惟以疗眼也，道术时须。"}]},{"ID":"20240616144632-33h5z0l","Type":"NodeThematicBreak","Properties":{"id":"20240616144632-33h5z0l"}},{"ID":"20240616144633-ukqyi2y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144633-ukqyi2y","updated":"20240616144637"},"Children":[{"Type":"NodeText","Data":"决明子《本草蒙筌》"}]},{"ID":"20240616144633-d2bx129","Type":"NodeParagraph","Properties":{"id":"20240616144633-d2bx129","updated":"20240616144633"},"Children":[{"Type":"NodeText","Data":"味咸、苦、甘，气平、微寒。无毒。川泽多生，苗高数尺。叶类苜蓿阔大，堪作菜蔬；子如绿豆锐圆，可入药剂。冬月采曝，捣碎才煎。恶火麻，使蓍实。除肝热尤和肝气，收目泪且止目疼。诚为明目仙丹，故得决明美誉。仍止鼻衄，水调末急贴脑心；更益寿龄，蜜为丸空心吞服。治头风须筑枕卧，消肿毒亦调水敷。头痛兼驱，蛇毒可解。"}]},{"ID":"20240616144706-cos799p","Type":"NodeThematicBreak","Properties":{"id":"20240616144706-cos799p"}},{"ID":"20240616144707-1avgu3f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144707-1avgu3f","updated":"20240616144711"},"Children":[{"Type":"NodeText","Data":"决明子《本草求真》"}]},{"ID":"20240616144707-dkut4le","Type":"NodeParagraph","Properties":{"id":"20240616144707-dkut4le","updated":"20240616144707"},"Children":[{"Type":"NodeText","Data":"（隰草）入肝散热明目"}]},{"ID":"20240616144707-0peluaj","Type":"NodeParagraph","Properties":{"id":"20240616144707-0peluaj","updated":"20240616144707"},"Children":[{"Type":"NodeText","Data":"决明子（专入肝）。气禀清阳。味咸苦甘。微寒无毒。能入肝经除风散热。凡人目泪不收。眼痛不止。多属风热内淫。以致血不上行。治当即为驱逐。按此苦能泄热。咸能软坚。甘能补血。力薄气浮。又能升散风邪。故为治目收泪止痛要药。并可作枕以治头风。但此服之太过。搜风至甚。反招风害。故必合以蒺藜甘菊枸杞生地女贞实槐实谷精草。相为补助。则功更胜。谓之决明。即是此意。状如马蹄。俗呼马蹄决明。捣碎用。恶大麻仁。"}]},{"ID":"20240616144656-9ziylms","Type":"NodeThematicBreak","Properties":{"id":"20240616144656-9ziylms"}},{"ID":"20240616144657-zfn6qz4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144657-zfn6qz4","updated":"20240616144702"},"Children":[{"Type":"NodeText","Data":"决明子《本草便读》"}]},{"ID":"20240616144657-y3zwbqe","Type":"NodeParagraph","Properties":{"id":"20240616144657-y3zwbqe","updated":"20240616144657"},"Children":[{"Type":"NodeText","Data":"微寒无毒．治水虚木实之邪．甘苦兼咸．疗赤肿羞明之疾．（决明子一名马蹄决明．其形如豆．色青黑．味甘苦咸寒．入肝肾二经．略有补性．故本经尊之上品．大抵不外益肾水．清肝火．水生火退．则目自明．故有此名也．）"}]},{"ID":"20240616144641-ouqd8eb","Type":"NodeThematicBreak","Properties":{"id":"20240616144641-ouqd8eb"}},{"ID":"20240616144642-atrla0g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144642-atrla0g","updated":"20240616144646"},"Children":[{"Type":"NodeText","Data":"决明子《本草备要》"}]},{"ID":"20240616144642-vhtoxmj","Type":"NodeParagraph","Properties":{"id":"20240616144642-vhtoxmj","updated":"20240616144642"},"Children":[{"Type":"NodeText","Data":"泻肝，明目"}]},{"ID":"20240616144642-tc2w4z3","Type":"NodeParagraph","Properties":{"id":"20240616144642-tc2w4z3","updated":"20240616144642"},"Children":[{"Type":"NodeText","Data":"甘苦咸平。入肝经，除风热。治一切目疾，故有决明之名。又曰∶益肾精（瞳子神光属肾。日华曰∶明目甚于黑豆，作枕治头风）。"}]},{"ID":"20240616144642-vo7234h","Type":"NodeParagraph","Properties":{"id":"20240616144642-vo7234h","updated":"20240616144642"},"Children":[{"Type":"NodeText","Data":"状如马蹄决明。捣碎煎。恶大麻仁。"}]},{"ID":"20240616144729-tjf6kn8","Type":"NodeThematicBreak","Properties":{"id":"20240616144729-tjf6kn8"}},{"ID":"20240616144730-5xl7jxd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144730-5xl7jxd","updated":"20240616144735"},"Children":[{"Type":"NodeText","Data":"决明子《顾松园医镜》"}]},{"ID":"20240616144730-h762prx","Type":"NodeParagraph","Properties":{"id":"20240616144730-h762prx","updated":"20240616144730"},"Children":[{"Type":"NodeText","Data":"〔咸平，入肝、肾二经。〕治青盲，〔俗名青昏。〕翳障，除赤肿泪流，益阴除热，决有明目之功。"}]},{"ID":"20240616144740-1gr8jz2","Type":"NodeThematicBreak","Properties":{"id":"20240616144740-1gr8jz2"}},{"ID":"20240616144741-bb3fkah","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144741-bb3fkah","updated":"20240616144748"},"Children":[{"Type":"NodeText","Data":"决明子《神农本草经赞》"}]},{"ID":"20240616144741-h1xksf7","Type":"NodeParagraph","Properties":{"id":"20240616144741-h1xksf7","updated":"20240616144741"},"Children":[{"Type":"NodeText","Data":"味咸平。主青盲。目淫肤赤白膜。眼赤痛泪出。久服益精光轻身。生川泽。"}]},{"ID":"20240616144741-xv20i8k","Type":"NodeParagraph","Properties":{"id":"20240616144741-xv20i8k","updated":"20240616144741"},"Children":[{"Type":"NodeText","Data":"龙门嘉种。香雾盈畦。金钱无数。翠羽初齐。青披细角。绿印簇蹄。黑甜一枕。明决昏。"}]},{"ID":"20240616144741-khd9jxt","Type":"NodeParagraph","Properties":{"id":"20240616144741-khd9jxt","updated":"20240616144741"},"Children":[{"Type":"NodeText","Data":"名医曰。生龙门。黄庭坚诗。后皇富嘉种。吴宽诗。畦间香雾正氤氲。杜甫诗。叶满枝翠羽盖。开花无数黄金钱。李时珍曰。结角如初生豉豆。角中子数十粒。参差相连。状如马蹄。青绿色。以明目之功而名。苏轼诗。一枕黑甜余。虞淳熙诗。午夜失昏。"}]},{"ID":"20240616144753-ozy1k6b","Type":"NodeThematicBreak","Properties":{"id":"20240616144753-ozy1k6b"}},{"ID":"20240616144754-usravhb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144754-usravhb","updated":"20240616144758"},"Children":[{"Type":"NodeText","Data":"决明子《本草撮要》"}]},{"ID":"20240616144754-mhfjuwq","Type":"NodeParagraph","Properties":{"id":"20240616144754-mhfjuwq","updated":"20240616144754"},"Children":[{"Type":"NodeText","Data":"味甘苦咸平．入足厥阴经．功专除风热．治一切目疾．作枕治头风．明目胜于黑豆．俗呼马蹄决明．恶大麻仁．"}]},{"ID":"20240616144813-8za50h2","Type":"NodeThematicBreak","Properties":{"id":"20240616144813-8za50h2"}},{"ID":"20240616144814-z6hwn7p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144814-z6hwn7p","updated":"20240616144818"},"Children":[{"Type":"NodeText","Data":"决明子《得配本草》"}]},{"ID":"20240616144814-35ckmuc","Type":"NodeParagraph","Properties":{"id":"20240616144814-35ckmuc","updated":"20240616144814"},"Children":[{"Type":"NodeText","Data":"实为之使。恶大麻子。"}]},{"ID":"20240616144814-vfebqo0","Type":"NodeParagraph","Properties":{"id":"20240616144814-vfebqo0","updated":"20240616144814"},"Children":[{"Type":"NodeText","Data":"甘、苦，微寒。入足厥阴经。除肝热，和肝气。凡因血热，以致头风、鼻衄、肿毒、目翳赤泪、唇口青色者，均得此而愈。得生甘草，治发背初起。配地肤子，治青盲雀目。"}]},{"ID":"20240616144850-tpsyadf","Type":"NodeThematicBreak","Properties":{"id":"20240616144850-tpsyadf"}},{"ID":"20240616144851-bvsoe68","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144851-bvsoe68","updated":"20240616144855"},"Children":[{"Type":"NodeText","Data":"决明子《本草述钩元》"}]},{"ID":"20240616144851-7mw6esa","Type":"NodeParagraph","Properties":{"id":"20240616144851-7mw6esa","updated":"20240616144851"},"Children":[{"Type":"NodeText","Data":"此马蹄决明。又有草决明。即青葙子也。以其亦能明目。用之者遂冒为决明子。误盖青葙茎直如蒿。苗叶花实。与鸡冠相类。子在穗中。黑扁而光。粒同苋实。决明子叶蓿而阔大。秋深结角。如初生细豇豆子。在角中状如马蹄。青绿色。故曰马蹄决明。其稍大。而主治尤优。不可不审。（嘉谟）味咸平苦甘。气微寒。足厥阴肝正药。亦入肾经。除肝热。和肝气。主治青盲目淫。"}]},{"ID":"20240616144851-3c6z0yh","Type":"NodeParagraph","Properties":{"id":"20240616144851-3c6z0yh","updated":"20240616144851"},"Children":[{"Type":"NodeText","Data":"肤赤草）芥黄附案一童子素有目疾。已愈。又因久衄。肾肝虚火俱动。致目赤。左微痛。用姜汁制生胡五每〔论〕决明子得水士阴经之气。而兼禀乎清阳者也。（本仲淳）味咸走血。气寒对治热。故治优于青葙分。"}]},{"ID":"20240616144824-q8mgk0b","Type":"NodeThematicBreak","Properties":{"id":"20240616144824-q8mgk0b"}},{"ID":"20240616144826-ryawxmh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144826-ryawxmh","updated":"20240616144829"},"Children":[{"Type":"NodeText","Data":"决明子《冯氏锦囊秘录》"}]},{"ID":"20240616144826-mj64a28","Type":"NodeParagraph","Properties":{"id":"20240616144826-mj64a28","updated":"20240616144826"},"Children":[{"Type":"NodeText","Data":"得水土阴精之气，兼禀乎清阳者，故其味咸苦，甘平微寒无毒。咸得水气，甘得土气，苦可泄热，平和胃气，寒能益阴泄热，足厥阴肝家正药。入胆肾，又可作枕，治头风明目。"}]},{"ID":"20240616144826-hvud5zj","Type":"NodeParagraph","Properties":{"id":"20240616144826-hvud5zj","updated":"20240616144826"},"Children":[{"Type":"NodeText","Data":"决明子，除肝热，尤和肝气，收目泪，止目疼痛，明目仙丹，头风兼驱，得沙苑蒺藜、甘菊、枸杞、生地、女贞实、槐实、谷精草，补肝明目益精之要药，功力更优。"}]},{"ID":"20240616144826-foy8s1i","Type":"NodeParagraph","Properties":{"id":"20240616144826-foy8s1i","updated":"20240616144826"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 主青盲目淫，肤赤白膜，肿痛泪出，除肝家热。"}]},{"ID":"20240616144803-g62k8yx","Type":"NodeThematicBreak","Properties":{"id":"20240616144803-g62k8yx"}},{"ID":"20240616144805-zntq3b9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144805-zntq3b9","updated":"20240616144809"},"Children":[{"Type":"NodeText","Data":"决明子《本草简要方》"}]},{"ID":"20240616144805-90afnto","Type":"NodeParagraph","Properties":{"id":"20240616144805-90afnto","updated":"20240616144805"},"Children":[{"Type":"NodeText","Data":"主治泻肝邪治头风。及一切目疾。尚有草决明石决明二种。功用相同。附载于后。"}]},{"ID":"20240616144805-53me8p2","Type":"NodeParagraph","Properties":{"id":"20240616144805-53me8p2","updated":"20240616144805"},"Children":[{"Type":"NodeText","Data":"子丸。决明子（炒）细辛草决明（即青葙子）蒺藜（炒去角）茺蔚子川芎独活羚羊角（镑）升麻防风各五钱。玄参枸杞子黄连各三两。菊花一两。研末蜜丸梧子大。每服二十丸。加至三十丸。"}]},{"ID":"20240616144805-wtbchro","Type":"NodeParagraph","Properties":{"id":"20240616144805-wtbchro","updated":"20240616144805"},"Children":[{"Type":"NodeText","Data":"淡竹叶煎汤下。治风热上冲眼目。或因外受风邪疼痛。视物不明。决明子散。决明子黄麻枳壳（麸炒）玄参各一两。黄芩七钱五分车前子栀子仁地肤子人参各五钱。锉碎。每服三钱。"}]},{"ID":"20240616144805-hdt3nhg","Type":"NodeParagraph","Properties":{"id":"20240616144805-hdt3nhg","updated":"20240616144805"},"Children":[{"Type":"NodeText","Data":"水一中盏煎至六分。去滓。食后服。治翳膜遮睛。决明益阴丸。石决明（）三钱。草决明黄芩黄连（酒炒）黄柏知母各一两。羌活独活当归尾（酒制）五味子炙草防风各五钱。"}]},{"ID":"20240616144805-8n25ko0","Type":"NodeParagraph","Properties":{"id":"20240616144805-8n25ko0","updated":"20240616144805"},"Children":[{"Type":"NodeText","Data":"丸梧子大。每服五十丸。加至百丸。茶汤下。治两目畏日畏火。沙涩难开。眵泪俱多。久病不痊者。"}]},{"ID":"20240616144805-hlzw2zv","Type":"NodeParagraph","Properties":{"id":"20240616144805-hlzw2zv","updated":"20240616144805"},"Children":[{"Type":"NodeText","Data":"青葙子丸。青葙子生地各二两。菟丝子茺蔚子防风黑参柴胡泽泻车前子茯苓各一两。五味子细辛各三钱。研末蜜丸梧子大。每服三钱。空腹茶汤下。治肝虚目病。"}]},{"ID":"20240616144553-836q5a2","Type":"NodeThematicBreak","Properties":{"id":"20240616144553-836q5a2"}},{"ID":"20240616144554-um0xxrx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616144554-um0xxrx","updated":"20240616144602"},"Children":[{"Type":"NodeText","Data":"决明子《要药分剂》"}]},{"ID":"20240616144554-2cah2r8","Type":"NodeParagraph","Properties":{"id":"20240616144554-2cah2r8","updated":"20240616144554"},"Children":[{"Type":"NodeText","Data":"此马蹄决明也。味甘苦咸。性微寒。无毒。得水土阴精之气。兼禀乎清阳以生。恶仁。捣碎煎。"}]},{"ID":"20240616144554-j36ytbq","Type":"NodeParagraph","Properties":{"id":"20240616144554-j36ytbq","updated":"20240616144554"},"Children":[{"Type":"NodeText","Data":"【主治】主青盲目淫。肤赤白膜。眼赤痛泪出。疗唇口青。久服益精光。（本经）助肝气。"}]},{"ID":"20240616144554-boek3j5","Type":"NodeParagraph","Properties":{"id":"20240616144554-boek3j5","updated":"20240616144554"},"Children":[{"Type":"NodeText","Data":"除【归经】入肝胆二经。为泻肝明目之品。（肝家正药）【前论】仲淳曰。补肝明目益精。除肝脏热之要药也。此疗目疾外。无他用。故无禁忌。"}]},{"ID":"20240607124740-qgt31n1","Type":"NodeThematicBreak","Properties":{"id":"20240607124740-qgt31n1"}},{"ID":"20240616140437-xjqgje0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140437-xjqgje0","updated":"20240616140441"},"Children":[{"Type":"NodeText","Data":"决明子《本经逢原》"}]},{"ID":"20240616140437-q2nzwsb","Type":"NodeParagraph","Properties":{"id":"20240616140437-q2nzwsb","updated":"20240616140437"},"Children":[{"Type":"NodeText","Data":"咸平，无毒。《别录》云∶苦甘微寒，无毒，炒研用。"}]},{"ID":"20240616140437-5w0v1xl","Type":"NodeParagraph","Properties":{"id":"20240616140437-5w0v1xl","updated":"20240616140437"},"Children":[{"Type":"NodeText","Data":"《本经》主青盲目淫，肤赤白膜，眼赤痛泪出，久服益精光，轻身。"}]},{"ID":"20240616140437-unijk4h","Type":"NodeParagraph","Properties":{"id":"20240616140437-unijk4h","updated":"20240616140437"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"《相感志》言，园中种决明，蛇不敢入。丹溪言∶决明解蛇毒，本此入药，明目。《本经》治青盲目淫，眼赤泪出，取其苦寒清热也。以水调末涂肿毒，贴心止鼻衄，贴太阳穴治头疼；作枕治头风。《别录》疗口青是主肝经蓄热之验也。不宜久服，久服令人患风伐肝，搜风太过，反招风热也。《本经》言，久服益精光，轻身，是指目疾人肝热内滞者而言。若脾虚血弱者，过用虚风内扰，在所必致耳。"}]},{"ID":"20240616140545-nc3fwtz","Type":"NodeThematicBreak","Properties":{"id":"20240616140545-nc3fwtz"}},{"ID":"20240616140546-wos1xvm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140546-wos1xvm","updated":"20240616140551"},"Children":[{"Type":"NodeText","Data":"决明《本草纲目》"}]},{"ID":"20240616140546-tawwq71","Type":"NodeParagraph","Properties":{"id":"20240616140546-tawwq71","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"「释名」马蹄决明。"}]},{"ID":"20240616140546-5fozucq","Type":"NodeParagraph","Properties":{"id":"20240616140546-5fozucq","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"「气味」（子）咸、平、无毒。"}]},{"ID":"20240616140546-c48nxym","Type":"NodeParagraph","Properties":{"id":"20240616140546-c48nxym","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616140546-03h4h06","Type":"NodeParagraph","Properties":{"id":"20240616140546-03h4h06","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"1、多年失明。用决明子二升研为末，每服一匙，饭后服，稀粥送下。"}]},{"ID":"20240616140546-6qrj0uq","Type":"NodeParagraph","Properties":{"id":"20240616140546-6qrj0uq","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"2、青盲、雀目（按：青盲是外观正常，但不见物，雀目即夜盲）。用决明一程序、地肤子五两，共研为末，加米汤做成丸子，如梧子大，每服二、三十丸，米汤送下。"}]},{"ID":"20240616140546-cecd0ai","Type":"NodeParagraph","Properties":{"id":"20240616140546-cecd0ai","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"3、眼睛红肿。用决明子炒过，研细，加茶调匀敷太阳穴，药干即换，一夜肿消。"}]},{"ID":"20240616140546-47vinfv","Type":"NodeParagraph","Properties":{"id":"20240616140546-47vinfv","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"4、头风热痛。治方同上。"}]},{"ID":"20240616140546-ni3jr8w","Type":"NodeParagraph","Properties":{"id":"20240616140546-ni3jr8w","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"5、鼻血不止。用决明子末，加水调交，敷胸口处。"}]},{"ID":"20240616140546-r627lsw","Type":"NodeParagraph","Properties":{"id":"20240616140546-r627lsw","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"6、癣疮蔓延。用决明子一两末。加水银、轻粉少许，研至极细，看不到水银星。擦破癣疮后再敷药。"}]},{"ID":"20240616140546-2gkr2nz","Type":"NodeParagraph","Properties":{"id":"20240616140546-2gkr2nz","updated":"20240616140546"},"Children":[{"Type":"NodeText","Data":"7、背疮初起。用决明子一升（捣碎）、生甘草一两，加水三升，煮成一升，分二次服下。"}]},{"ID":"20240607124652-ty4fyoc","Type":"NodeThematicBreak","Properties":{"id":"20240607124652-ty4fyoc"}},{"ID":"20240607124717-5l9hfqh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124717-5l9hfqh","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"《中国药典》：决明子"}]},{"ID":"20240607124717-9nqubuc","Type":"NodeParagraph","Properties":{"id":"20240607124717-9nqubuc","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124717-vp98b8e","Type":"NodeParagraph","Properties":{"id":"20240607124717-vp98b8e","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" Jué Mínɡ Zǐ"}]},{"ID":"20240607124717-19tn0ld","Type":"NodeParagraph","Properties":{"id":"20240607124717-19tn0ld","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124717-rlusgqk","Type":"NodeParagraph","Properties":{"id":"20240607124717-rlusgqk","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 马蹄决明、钝叶决明、假绿豆、草决明"}]},{"ID":"20240607124717-euuegnp","Type":"NodeParagraph","Properties":{"id":"20240607124717-euuegnp","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607124717-cqo8d7w","Type":"NodeParagraph","Properties":{"id":"20240607124717-cqo8d7w","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" SEMEN CASSIAE"}]},{"ID":"20240607124717-nghmha6","Type":"NodeParagraph","Properties":{"id":"20240607124717-nghmha6","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124717-3m2ug7n","Type":"NodeParagraph","Properties":{"id":"20240607124717-3m2ug7n","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 本品为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"决明"},{"Type":"NodeText","Data":"Cassia obtusifolia L. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小决明"},{"Type":"NodeText","Data":"Cassia tora L. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种子"},{"Type":"NodeText","Data":"。秋季采收成熟果实，晒干，打下种子，除去杂质。"}]},{"ID":"20240607124717-3edmh4t","Type":"NodeParagraph","Properties":{"id":"20240607124717-3edmh4t","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607124717-la2ia0s","Type":"NodeParagraph","Properties":{"id":"20240607124717-la2ia0s","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 决明：略呈棱方形或短圆柱形，两端平行倾斜，长3～7mm，宽2～4mm。表面绿棕色或暗棕色，平滑有光泽。一端较平坦，另端斜尖，背腹面各有1条突起的棱线，棱线两侧各有1条斜向对称而色较浅的线形凹纹。质坚硬，不易破碎。种皮薄，子叶2，黄色，呈“Ｓ”形折曲并重叠。气微，味微苦。"}]},{"ID":"20240607124717-j693t5t","Type":"NodeParagraph","Properties":{"id":"20240607124717-j693t5t","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"小决明：呈短圆柱形，较小，长3～5mm，宽2～3mm。表面棱线两侧各有1片宽广的浅黄棕色带。"}]},{"ID":"20240607124717-xnh7fqx","Type":"NodeParagraph","Properties":{"id":"20240607124717-xnh7fqx","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607124717-o0wb4o5","Type":"NodeParagraph","Properties":{"id":"20240607124717-o0wb4o5","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240607124717-djsfprn","Type":"NodeParagraph","Properties":{"id":"20240607124717-djsfprn","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607124717-ydtwvw5","Type":"NodeParagraph","Properties":{"id":"20240607124717-ydtwvw5","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"决明子"},{"Type":"NodeText","Data":"：除去杂质，洗净，干燥。用时捣碎。炒决明子：取净决明子，照清炒法（附录Ⅱ D）炒至微有香气。用时捣碎。"}]},{"ID":"20240607124717-vs2frhp","Type":"NodeParagraph","Properties":{"id":"20240607124717-vs2frhp","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607124717-9jgjplu","Type":"NodeParagraph","Properties":{"id":"20240607124717-9jgjplu","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" （1）取本品粉末0.5g，加稀硫酸20ml与氯仿10ml，微沸回流15分钟，放冷后，移入分液漏斗中，分取氯仿层，加氢氧化钠试液10ml，振摇，放置，碱液层显红色。如显棕色，则分取碱液层加过氧化氢试液1～2滴，再置水浴中加热4 分钟，即显红色。"}]},{"ID":"20240607124717-tc31oef","Type":"NodeParagraph","Properties":{"id":"20240607124717-tc31oef","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加甲醇10ml，浸渍1 小时，滤过，滤液蒸干，残渣加水10ml使溶解，再加盐酸1ml,置水浴上加热30分钟，立即冷却，用乙醚分2 次提取，每次20ml,合并乙醚液，蒸干，残渣加氯仿1ml 使溶解，作为供试品溶液。另取大黄素、大黄酚对照品，加甲醇制成每1ml各含1mg的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一以羧甲基纤维钠为黏合剂的硅胶Ｈ薄层板上，以石油醚（30～60℃）－甲酸乙酯－甲酸（15:5:1）的上层溶液为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同的橙色荧光斑点；置氨蒸气中熏后，斑点变为红色。"}]},{"ID":"20240607124717-kzmjnhb","Type":"NodeParagraph","Properties":{"id":"20240607124717-kzmjnhb","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124717-0qmqzst","Type":"NodeParagraph","Properties":{"id":"20240607124717-0qmqzst","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 归肝、大肠经。"}]},{"ID":"20240607124717-m5ge015","Type":"NodeParagraph","Properties":{"id":"20240607124717-m5ge015","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124717-iq2lw5h","Type":"NodeParagraph","Properties":{"id":"20240607124717-iq2lw5h","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 甘、苦、咸，微寒。"}]},{"ID":"20240607124717-uipwusg","Type":"NodeParagraph","Properties":{"id":"20240607124717-uipwusg","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124717-5lxn3xm","Type":"NodeParagraph","Properties":{"id":"20240607124717-5lxn3xm","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 清热明目，润肠通便。用于目赤涩痛，羞明多泪，头痛眩晕，目暗不明，大便秘结。"}]},{"ID":"20240607124717-473r1nm","Type":"NodeParagraph","Properties":{"id":"20240607124717-473r1nm","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124717-bcrmhle","Type":"NodeParagraph","Properties":{"id":"20240607124717-bcrmhle","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240607124717-b0j30xd","Type":"NodeParagraph","Properties":{"id":"20240607124717-b0j30xd","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607124717-qkkyt6y","Type":"NodeParagraph","Properties":{"id":"20240607124717-qkkyt6y","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" （1）目赤肿痛，羞明多泪等症，系肝火上扰，或风热上壅头目所致。决明子既能清泄肝胆郁火，又能疏散风热，为治目赤肿痛要药。风热者，常与蝉衣、菊花等同用；肝火者，常配龙胆草、黄芩、夏枯草等同用。青盲内障，多由肝肾不足所引起。决明子清肝而明目，常与补养肝肾药如沙苑蒺藜、女贞子、枸杞子、生地等同用，以治青盲内障。此外，决明子还有润肠通便作用，能治疗大便燥结。近年来临床上又用于高血压病而呈现肝阳上扰、头晕目眩等症候者，常与钩藤、生牡蛎等同用。"}]},{"ID":"20240607124717-i4y9oft","Type":"NodeParagraph","Properties":{"id":"20240607124717-i4y9oft","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124717-uiueuye","Type":"NodeParagraph","Properties":{"id":"20240607124717-uiueuye","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607124717-361gsai","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124717-361gsai","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：决明子"}]},{"ID":"20240607124717-x1arrn5","Type":"NodeParagraph","Properties":{"id":"20240607124717-x1arrn5","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124717-ag1at5b","Type":"NodeParagraph","Properties":{"id":"20240607124717-ag1at5b","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" Jué Mínɡ Zǐ"}]},{"ID":"20240607124717-mnqvcw1","Type":"NodeParagraph","Properties":{"id":"20240607124717-mnqvcw1","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124717-luqhh90","Type":"NodeParagraph","Properties":{"id":"20240607124717-luqhh90","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 草决明，羊明（《吴普本草》），羊角（《广雅》），马蹄决明（陶弘景），还瞳子（《医学正传》），狗屎豆（《生草药性备要》），假绿豆（《中国药植志》），马蹄子（《江苏植药志》），千里光（《山西中药志）），芹决（《陕西中药志》），羊角豆（《广东中药》），野青豆（《江西草药》），猪骨明、猪屎蓝豆、细叶猪屎豆、夜拉子、羊尾豆（《南方主要有毒植物》）。"}]},{"ID":"20240607124717-pvmp21k","Type":"NodeParagraph","Properties":{"id":"20240607124717-pvmp21k","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607124717-bw27y5y","Type":"NodeParagraph","Properties":{"id":"20240607124717-bw27y5y","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607124717-t5pwh2n","Type":"NodeParagraph","Properties":{"id":"20240607124717-t5pwh2n","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124717-n7rcu26","Type":"NodeParagraph","Properties":{"id":"20240607124717-n7rcu26","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"决明"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种子"},{"Type":"NodeText","Data":"。秋季果实成熟后采收，将全株割下或摘下果荚，晒干，打出种子，扬净荚壳及杂质，再晒干。"}]},{"ID":"20240607124717-1al89n4","Type":"NodeParagraph","Properties":{"id":"20240607124717-1al89n4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607124717-g56lecm","Type":"NodeParagraph","Properties":{"id":"20240607124717-g56lecm","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 野生于山坡、河边，或栽培。全国大部分地区有分布。全国各地均产。主产于安徽、广西、四川、浙江、广东等地。"}]},{"ID":"20240607124717-yjj4g8j","Type":"NodeParagraph","Properties":{"id":"20240607124717-yjj4g8j","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607124717-51a25in","Type":"NodeParagraph","Properties":{"id":"20240607124717-51a25in","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 决明（《本经》），又名：夜关门、羊触足、假羊角菜、假花生、夜合草、野花生。"}]},{"ID":"20240607124717-fvngpfr","Type":"NodeParagraph","Properties":{"id":"20240607124717-fvngpfr","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"一年生草本，高约1米.茎直立，上部多分杖，全体被短柔毛。叶互生；双数羽状复叶；叶柄上面有沟，叶轴上2小叶间有腺体；托叶线状，早落；小叶3对，倒卵形，长2～3厘米，宽1.5～3厘米，先端圆形，有微突尖，基部广楔形或近圆形，一边倾斜，全缘，上面近无毛，下面被柔毛。花腋生，成对；总花梗长约1厘米，被柔毛；萼片5，卵圆形，外面被柔毛；花瓣5，倒卵形或椭圆形，具短爪，黄色；雄蕊10，上面3枚退化，下面7枚发育完全；子房细长，弯曲，被毛，具柄，花柱极短，柱头头状。荚果，线形，略扁，弓形弯曲，长15～24厘米，直径4～6毫米，被疏柔毛。种子多数，菱形，灰绿色，有光亮。花期6～8月。果期9～10月。"}]},{"ID":"20240607124717-3n98qkc","Type":"NodeParagraph","Properties":{"id":"20240607124717-3n98qkc","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607124717-ocbzpdi","Type":"NodeParagraph","Properties":{"id":"20240607124717-ocbzpdi","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 干燥种子，呈菱方形，状如马蹄，一端稍尖，一端截状，长5～8毫米，宽2.5～3毫米。表面黄褐色或绿褐色，平滑光泽，两面各有1凸起的棕色棱线，棱线两侧各有一条浅色而稍凹陷的线纹，水浸时由此处胀裂。质硬不易破碎横切面皮薄，可见灰白色至淡黄色的胚乳，子叶黄色或暗棕色，强烈折叠而皱缩。气无，味微苦，略带粘液性。以颗粒均匀、饱满、黄褐色者为佳。"}]},{"ID":"20240607124717-gtkbeyx","Type":"NodeParagraph","Properties":{"id":"20240607124717-gtkbeyx","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607124717-99s5n0d","Type":"NodeParagraph","Properties":{"id":"20240607124717-99s5n0d","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 新鲜种子含大黄酚、大黄素、芦荟大黄素、大黄酸、大黄素葡萄糖甙、大黄素蒽酮、大黄素甲醚、决明素、橙黄决明素，以及新月孢子菌玫瑰色素、决明松、决明内酯。尚含维生素A。"}]},{"ID":"20240607124717-mceippo","Type":"NodeParagraph","Properties":{"id":"20240607124717-mceippo","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607124717-lf8wmcp","Type":"NodeParagraph","Properties":{"id":"20240607124717-lf8wmcp","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" ①降血压作用"}]},{"ID":"20240607124717-o4lij0u","Type":"NodeParagraph","Properties":{"id":"20240607124717-o4lij0u","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"决明子的水浸液、酵-水浸液，醇浸液对麻醉犬、猫、兔等皆有降压作用。但浸剂对麻醉兔降压作用不明显，而用决明子酊5毫升，降压较明显，且持续时间较长，用同量稀醇静注，亦可降压（可立即恢复）。对离体蟾蜍心脏有抑制作用；对血管有收缩作用（下肢灌注法）。在慢性实验中，煎剂每日2克（生药）／公斤，无降压作用。"}]},{"ID":"20240607124717-vskzlyq","Type":"NodeParagraph","Properties":{"id":"20240607124717-vskzlyq","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"②抗菌作用"}]},{"ID":"20240607124717-onmr16a","Type":"NodeParagraph","Properties":{"id":"20240607124717-onmr16a","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"种子的醇提取物对葡萄球菌、白喉杆菌及伤寒、副伤寒、大肠杆菌等均有抑制作用，而水提取物则无效，水浸剂（1：4）在试管中对某些皮肤真菌有不同程度的抑制作用。含大黄酚，但量不多，可能与其轻度的抗菌，泻下作用有关。"}]},{"ID":"20240607124717-j1oq92r","Type":"NodeParagraph","Properties":{"id":"20240607124717-j1oq92r","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607124717-a4mlkbw","Type":"NodeParagraph","Properties":{"id":"20240607124717-a4mlkbw","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 炒决明子：取净决明子，置锅内炒至微有香气，取出，放凉。"}]},{"ID":"20240607124717-kc9jj9n","Type":"NodeParagraph","Properties":{"id":"20240607124717-kc9jj9n","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124717-1z75cq2","Type":"NodeParagraph","Properties":{"id":"20240607124717-1z75cq2","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607124717-n3m55ba","Type":"NodeParagraph","Properties":{"id":"20240607124717-n3m55ba","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肝经。\""}]},{"ID":"20240607124717-iujyauy","Type":"NodeParagraph","Properties":{"id":"20240607124717-iujyauy","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"足厥阴肝，亦入胆、肾。\""}]},{"ID":"20240607124717-remgyhd","Type":"NodeParagraph","Properties":{"id":"20240607124717-remgyhd","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124717-44gd9nh","Type":"NodeParagraph","Properties":{"id":"20240607124717-44gd9nh","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 苦甘，凉。"}]},{"ID":"20240607124717-9wvlicd","Type":"NodeParagraph","Properties":{"id":"20240607124717-9wvlicd","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味咸，平。\""}]},{"ID":"20240607124717-jdumfkn","Type":"NodeParagraph","Properties":{"id":"20240607124717-jdumfkn","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦甘，微寒，无毒。\""}]},{"ID":"20240607124717-6gha3kn","Type":"NodeParagraph","Properties":{"id":"20240607124717-6gha3kn","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味微苦微甘，性平，微凉。\""}]},{"ID":"20240607124717-u1jviu1","Type":"NodeParagraph","Properties":{"id":"20240607124717-u1jviu1","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607124717-gc0ol25","Type":"NodeParagraph","Properties":{"id":"20240607124717-gc0ol25","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：\"蓍实为之使。恶大麻子。\""}]},{"ID":"20240607124717-k4lky2q","Type":"NodeParagraph","Properties":{"id":"20240607124717-k4lky2q","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124717-jx6a1if","Type":"NodeParagraph","Properties":{"id":"20240607124717-jx6a1if","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 清肝，明目，利水，通便。治风热赤眼，青盲，雀目，高血压，肝炎，肝硬化腹水，习惯性便秘。"}]},{"ID":"20240607124717-s0f3vof","Type":"NodeParagraph","Properties":{"id":"20240607124717-s0f3vof","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"①《本经）：\"治青盲，目淫肤赤白膜，眼赤痛，泪出，久服益精光。\""}]},{"ID":"20240607124717-vfahcct","Type":"NodeParagraph","Properties":{"id":"20240607124717-vfahcct","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗唇口青。\""}]},{"ID":"20240607124717-wbe8tlp","Type":"NodeParagraph","Properties":{"id":"20240607124717-wbe8tlp","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"利五脏，除肝家热。\""}]},{"ID":"20240607124717-lc17kow","Type":"NodeParagraph","Properties":{"id":"20240607124717-lc17kow","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"助肝气，益精水；调末涂，消肿毒，熁太阳穴治头痛，又贴脑心止鼻衄；作枕胜黑豆，治头风，明目。\""}]},{"ID":"20240607124717-dtlhs9i","Type":"NodeParagraph","Properties":{"id":"20240607124717-dtlhs9i","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑤《本草衍义补遗》：\"解蛇毒。\""}]},{"ID":"20240607124717-l43rkgw","Type":"NodeParagraph","Properties":{"id":"20240607124717-l43rkgw","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑥《生草药性备要》：\"治小儿五疳，擦癣癞。\""}]},{"ID":"20240607124717-kxrmses","Type":"NodeParagraph","Properties":{"id":"20240607124717-kxrmses","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑦《医林纂要》：\"泻邪水。\""}]},{"ID":"20240607124717-vrmljau","Type":"NodeParagraph","Properties":{"id":"20240607124717-vrmljau","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑧《湖南药物志）：\"明目，利尿。治昏眩，脚气，浮肿，肺痈，胸痹。\""}]},{"ID":"20240607124717-zbkndz0","Type":"NodeParagraph","Properties":{"id":"20240607124717-zbkndz0","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑨广州部队《常用中草药手册》：\"清肝明目，利水通便。治肝炎，肝硬化腹水，高血压，小儿疳积，夜盲，风热眼痛，习惯性便秘。\""}]},{"ID":"20240607124717-q9mce57","Type":"NodeParagraph","Properties":{"id":"20240607124717-q9mce57","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124717-1g0vpt7","Type":"NodeParagraph","Properties":{"id":"20240607124717-1g0vpt7","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或研末。外用：研末调敷。"}]},{"ID":"20240607124717-05pnxhj","Type":"NodeParagraph","Properties":{"id":"20240607124717-05pnxhj","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607124717-mfjiuu9","Type":"NodeParagraph","Properties":{"id":"20240607124717-mfjiuu9","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" ①治失明，目中无他病，无所见，如绢中视：马蹄决明二升，捣筛，以粥坎服方寸匕。忌鱼、蒜、猪肉、辛菜。（《僧深集方》决明散）"}]},{"ID":"20240607124717-eq3wl57","Type":"NodeParagraph","Properties":{"id":"20240607124717-eq3wl57","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"②治目赤肿痛：决明子炒研，茶调，敷两太阳穴，干则易之。亦治头风热痛。（《摘元方》）"}]},{"ID":"20240607124717-tlyplza","Type":"NodeParagraph","Properties":{"id":"20240607124717-tlyplza","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"③治雀目：决明子二两，地肤子一两。上药，捣细罗为散。每于食后，以清粥饮调下一钱。（《圣惠方》）"}]},{"ID":"20240607124717-em9hwm1","Type":"NodeParagraph","Properties":{"id":"20240607124717-em9hwm1","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"④治眼补肝，除暗明目：决明子一升，蔓荆子一升（用好酒五升，煮酒尽，曝干）。上药，捣细罗为散。每服，以温水调下二钱，食后及临卧服。（《圣惠方》决明子散）"}]},{"ID":"20240607124717-2rqzppr","Type":"NodeParagraph","Properties":{"id":"20240607124717-2rqzppr","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑤治急性结膜炎：决明子、菊花各三钱，蔓荆子、木贼各二钱，水煎服。（《河北中药手册》）"}]},{"ID":"20240607124717-sj7ciup","Type":"NodeParagraph","Properties":{"id":"20240607124717-sj7ciup","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑥治高血压：决明子五钱，炒黄，水煎代茶饮。（《江西草药》）"}]},{"ID":"20240607124717-owymvf6","Type":"NodeParagraph","Properties":{"id":"20240607124717-owymvf6","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑦治小儿疳积：草决明子三钱，研末，鸡肝一具，捣烂，白酒少许，调和成饼，蒸熟服。（《江西草药》）"}]},{"ID":"20240607124717-jdw2ra3","Type":"NodeParagraph","Properties":{"id":"20240607124717-jdw2ra3","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑧治癣：决明子不以多少，为末，少加水银粉，同为散。先以物擦破癣，上以散敷之。（《苏沈良方》）"}]},{"ID":"20240607124717-le9aqj4","Type":"NodeParagraph","Properties":{"id":"20240607124717-le9aqj4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑨多年失明。用决明子二升研为末，每服一匙，饭后服，稀粥送下。"}]},{"ID":"20240607124717-nisu3y5","Type":"NodeParagraph","Properties":{"id":"20240607124717-nisu3y5","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑩青盲、雀目（按：青盲是外观正常，但不见物，雀目即夜盲）。用决明一程式、地肤子五两，共研为末，加米汤做成丸子，如梧子大，每服二、三十丸，米汤送下。"}]},{"ID":"20240607124717-wr7vbir","Type":"NodeParagraph","Properties":{"id":"20240607124717-wr7vbir","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑾眼睛红肿。用决明子炒过，研细，加茶调匀敷太阳穴，药干即换，一夜肿消。"}]},{"ID":"20240607124717-8st5g87","Type":"NodeParagraph","Properties":{"id":"20240607124717-8st5g87","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⑿头风热痛。治方同上。"}]},{"ID":"20240607124717-yfsnvgy","Type":"NodeParagraph","Properties":{"id":"20240607124717-yfsnvgy","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⒀鼻血不止。用决明子三工业区末，加水调交，敷胸口处。"}]},{"ID":"20240607124717-iwtlx5o","Type":"NodeParagraph","Properties":{"id":"20240607124717-iwtlx5o","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⒁癣疮蔓延。用决明子一两，三工业区末。加水银、轻粉少许，研至极细，看不到水银星。擦破癣疮后再敷药。"}]},{"ID":"20240607124717-cdvhwir","Type":"NodeParagraph","Properties":{"id":"20240607124717-cdvhwir","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"⒂背疮初起。用决明子一升（捣碎）、生甘草一两，加水三升，煮成一升，分二次服下。"}]},{"ID":"20240607124717-5sfgw12","Type":"NodeParagraph","Properties":{"id":"20240607124717-5sfgw12","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607124717-wr2v306","Type":"NodeParagraph","Properties":{"id":"20240607124717-wr2v306","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 降低血清胆甾醇:观察100例，治前血清胆甾醇在484～210毫克％之间，平均为246.91毫克％；治后降至110～208毫克％之间，平均下降87.9毫克％。大部分病例于用药后均有不同程度的下降，2周内有85％降至正常水平，4周内降至正常水平者占96％，总有效率为98％。但在长期观察的5例中，因故停药后血清胆甾醇则又逐渐上升，再行服药后仍可下降。提示本品降低血清胆甾醇系暂时性的，为达到治疗目的需长期维持，需维持多久尚待观察。服药后有85％病例的头晕、头痛、乏力等症状有所改善。制剂及用法：㈠煎剂-决明子1两，水煎分2次服。㈡糖浆-每100毫升含生药1.5两，每次20毫升，日服3次。㈢片剂-每片含生药6分，日服3次，每次5片。三种剂型经观察疗效无明显差异。决明子用量与疗效有密切关系，量少（如口煎剂每日用5钱）不能达到疗效。副作用：发生率占9％，主要为腹胀、腹泻与恶心，多见于服药初期，均不影响继续服药，可自行消失。关于本品的疗效机理、远期效果及对粥样斑块形成的影响等尚待研究。"}]},{"ID":"20240607124717-i3399ib","Type":"NodeParagraph","Properties":{"id":"20240607124717-i3399ib","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124717-fr8w1v3","Type":"NodeParagraph","Properties":{"id":"20240607124717-fr8w1v3","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607124717-6mr8567","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124717-6mr8567","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"《中华本草》：决明子"}]},{"ID":"20240607124717-81ajv0h","Type":"NodeParagraph","Properties":{"id":"20240607124717-81ajv0h","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124717-3gvpam6","Type":"NodeParagraph","Properties":{"id":"20240607124717-3gvpam6","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" Jué Mínɡ Zǐ"}]},{"ID":"20240607124717-ymyii0x","Type":"NodeParagraph","Properties":{"id":"20240607124717-ymyii0x","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124717-hbz7it3","Type":"NodeParagraph","Properties":{"id":"20240607124717-hbz7it3","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 草决明、羊明、羊角、马蹄决明、还瞳子、狗屎豆、假绿豆、马蹄子、羊角豆、野青豆、大号山土豆、猪骨明、猪屎蓝豆、夜拉子、羊尾豆"}]},{"ID":"20240607124717-qje97du","Type":"NodeParagraph","Properties":{"id":"20240607124717-qje97du","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607124717-dte7f86","Type":"NodeParagraph","Properties":{"id":"20240607124717-dte7f86","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" Cassia Seed, Seed of Sickle Senna"}]},{"ID":"20240607124717-btct0br","Type":"NodeParagraph","Properties":{"id":"20240607124717-btct0br","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607124717-fk5brxc","Type":"NodeParagraph","Properties":{"id":"20240607124717-fk5brxc","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.陶弘景：决明，叶如茳芒，子形似马蹄，呼为马蹄决明。用之当捣碎。又别有草决明，是萋蒿子，在下品中也。"}]},{"ID":"20240607124717-37wdzci","Type":"NodeParagraph","Properties":{"id":"20240607124717-37wdzci","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：此马蹄决阴也，以明目之功而名，又有草决明、石决明，皆同功者。草决明即青葙子，陶氏所谓萋蒿是也。决明有二种，一种马蹄决明，茎高三、四尺，叶大于苜蓿而本小末茤，昼开夜合，两两相帖。秋开淡黄花，五出。结角如初生细豇豆，长五、六寸，角中子数十粒，参差相连，状如马蹄，"}]},{"ID":"20240607124717-sefrzg1","Type":"NodeParagraph","Properties":{"id":"20240607124717-sefrzg1","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124717-ppbucja","Type":"NodeParagraph","Properties":{"id":"20240607124717-ppbucja","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物决明和小决明的成熟种子。"}]},{"ID":"20240607124717-6qdvlrl","Type":"NodeParagraph","Properties":{"id":"20240607124717-6qdvlrl","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Cassia obtusifolia L.2.Cassia tora L."}]},{"ID":"20240607124717-ixbiox3","Type":"NodeParagraph","Properties":{"id":"20240607124717-ixbiox3","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋末果实成熟，荚果变黄褐色时采收，将全株割下晒干，打下种子，去净杂质即可。"}]},{"ID":"20240607124717-arhqbaj","Type":"NodeParagraph","Properties":{"id":"20240607124717-arhqbaj","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607124717-mg6y7z4","Type":"NodeParagraph","Properties":{"id":"20240607124717-mg6y7z4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于丘陵、路边、荒山、山坡疏林下。"}]},{"ID":"20240607124717-3qesxj9","Type":"NodeParagraph","Properties":{"id":"20240607124717-3qesxj9","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.生于山坡、河边。"}]},{"ID":"20240607124717-btm0jf4","Type":"NodeParagraph","Properties":{"id":"20240607124717-btm0jf4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"资源分布：1.我国南北各省均有栽培或野生。"}]},{"ID":"20240607124717-t2yvxxe","Type":"NodeParagraph","Properties":{"id":"20240607124717-t2yvxxe","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.分布于华东、中南、西南及吉林、辽宁、河北、山西。栽培或野生。"}]},{"ID":"20240607124717-gmmg8x6","Type":"NodeParagraph","Properties":{"id":"20240607124717-gmmg8x6","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607124717-uw3uwmn","Type":"NodeParagraph","Properties":{"id":"20240607124717-uw3uwmn","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 1.决明 一年生半灌木状草本，高0.5-2m。上部分枝多。叶互生，羽状复叶；叶柄长2-5cm；小叶3对，叶片倒卵形或倒卵状长圆形，长2-6cm，宽1.5-3.5cm，先端圆形，基部楔形，稍偏斜，下面及边缘有柔毛，最下1对小叶间有1条形腺体，或下面2对小叶间各有一腺体。花成对腋生，最上部的聚生；总花梗极短；小花梗长约1-2cm；萼片5，倒卵形；花冠黄色，花瓣5，倒卵形，长12-15mm，基部有爪；雄蕊10，发有雄蕊7，3个较大的花药先端急狭成瓶颈状；子房细长，花柱弯曲。荚果细长，近四棱形，长15-20cm，宽3-4mm，果柄长2-4cm。种子多数，菱柱形或菱形略扁，淡褐色，光亮，两侧各有1条线形斜凹纹。花期6-8月，果期8-10月。"}]},{"ID":"20240607124717-bb6ych8","Type":"NodeParagraph","Properties":{"id":"20240607124717-bb6ych8","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.小决明 一年生半灌木状草本，高l-2m。叶互生，羽状复叶；叶柄无腺体，在叶轴上两小叶之间有棒状的腺体1个；小叶3对，膜质；小叶柄长1.5-2mm；托叶线形，被柔毛.早落；叶片倒卵形或倒卵状长椭圆形，长2-6cm，宽1.5-2.5cm，先端圆钝而有小尖头，基部渐狭，偏斜，上面被稀疏柔毛，下面被柔毛。花通常2朵生于叶腋；总花梗长6-10mm；花梗长l-1.5cm；萼片5，稍不等大，卵形或卵状长圆形，膜质，外面被柔毛，长约8mm；花黄色，花瓣5，下面2片略长，长12-15mm，宽5-7mm；雄蕊10，能育雄蕊7；子房线状，无柄，被白色细毛，花柱内弯。果纤细，近扁，呈弓形弯曲，长 15-24cm，直径4-6mm，被疏柔毛。种子多数，菱形，灰绿色，有光泽。花期6-8月，果期9-10月。"}]},{"ID":"20240607124717-p85orfb","Type":"NodeParagraph","Properties":{"id":"20240607124717-p85orfb","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607124717-r2h96o4","Type":"NodeParagraph","Properties":{"id":"20240607124717-r2h96o4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜高温湿润气候，需阳光充足以盛夏高温多雨季节生长最快。适宜的土壤为疏松肥沃的砂壤土，低洼、阴坡地不宜栽种。忌连作。种子千粒重28.2-30.7g。"}]},{"ID":"20240607124717-a5vvd9n","Type":"NodeParagraph","Properties":{"id":"20240607124717-a5vvd9n","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种于繁殖。播种前以温水浸种，捞出稍凉。"}]},{"ID":"20240607124717-omvlwo3","Type":"NodeParagraph","Properties":{"id":"20240607124717-omvlwo3","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"播种期南方4月上旬，北方4月中旬。条播，行距55-65cm，开5-7cm沟，将种子均匀撒入沟内，覆土3cm左右，稍加镇压。后保持土壤湿润，7-10d可出苗。穴播，每穴7-8粒，每lh㎡用种量15-22.5kg。"}]},{"ID":"20240607124717-myie8nm","Type":"NodeParagraph","Properties":{"id":"20240607124717-myie8nm","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高5cm时间苗，拔去过密的弱苗，15cm时结合中耕除草按株距30cm定苗，苗高40cm左右进行最后一次中耕培土，可防倒伏。开花前追肥l-2次，每lh㎡用硫酸铵120kg，过磷酸钙225kg，混合撒于植株旁侧，结合培土埋入。四季注意排水防涝，出苗后及时除草浇水。"}]},{"ID":"20240607124717-ubvg1xf","Type":"NodeParagraph","Properties":{"id":"20240607124717-ubvg1xf","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有灰斑病：于发病前或发病初期用40%灭菌丹400-500倍液喷雾。轮纹病：茎、叶、荚均可感染，防病方法同上。虫害有蚜虫为害，苗期较重。"}]},{"ID":"20240607124717-h5udj8u","Type":"NodeParagraph","Properties":{"id":"20240607124717-h5udj8u","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607124717-xse8cud","Type":"NodeParagraph","Properties":{"id":"20240607124717-xse8cud","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）决明 呈四棱性短圆柱形，一端钝圆，另一端倾斜并有尖头，长4-6mm，宽2-3mm。表面棕绿色或暗棕色，平滑，有光泽，背腹面各有1条凸起的棱线，棱线两侧各有1条从脐点向合点斜向的浅棕色线形凹纹。质坚硬。横切面种皮薄；胚乳灰白色，半透明；胚黄色，两片子叶重叠呈S状折曲。完整种子气微，破碎后有微弱豆腥气；味微苦，稍带粘性。（2）小决明 短圆柱形，长3-5mm，宽2-2.5mm。棱线两侧各有1条宽广的浅黄棕色带。以籽粒饱满，色绿棕者为佳。"}]},{"ID":"20240607124717-wk2kpoc","Type":"NodeParagraph","Properties":{"id":"20240607124717-wk2kpoc","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"显微鉴别 种子横切面：（1〕决明 最外为厚的角质层，表皮为1列栅状细胞，壁不均匀加厚，在细胞的1/2和下1/3处各有1条光辉带；以下为1列支柱细胞，略呈哑铃状，壁厚，相邻两细胞间有大的细胞间隙；内方为6-8列营养层薄壁细胞，内含草酸钙簇晶，直径3-10μm；最内1列种皮细胞排列整齐，长方形，含草酸钙棱晶。胚乳细胞壁不均匀加厚，含粘液质、糊粉粒、色素、草酸钙簇晶和油滴。子叶细胞内含草酸钙簇晶，直径3-10μm。(2)小决明 草酸钙簇晶较多，直径10-19μm，部分支柱细胞外侧壁特别增厚，营养层细胞5-6列。粉末特征：(1)决明 呈黄棕色。①角质层碎片平滑、透明，表面可见波状弯曲的网状花纹。②栅状细胞侧壁不均匀增厚，表面观细胞多角形，壁厚。③支柱细胞侧面观呈哑铃状，表面观呈类圆形或多角形，并可见上下两层同心圆圈。④种皮薄壁细胞含草酸钙棱晶。⑤胚乳细胞壁不均匀增厚，含糊粉粒及草酸钙簇晶。⑥子叶细胞含草酸钙簇晶，直径3-10μm。(2)小决明 与上种的区别为：①角质层碎片较少，表面观可见多角形的网状花纹。②部分支柱细胞表面观不见两层同心圆圈，只见一层圆圈，内为一弯曲的细线。③草酸钙簇晶较多且大，直径10-19μm。"}]},{"ID":"20240607124717-meoqehk","Type":"NodeParagraph","Properties":{"id":"20240607124717-meoqehk","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607124717-ddoyea1","Type":"NodeParagraph","Properties":{"id":"20240607124717-ddoyea1","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 1.Sprague一Dawloy大鼠在饲料中加入决明子16-32%，至8天随着决明子剂量的增加，大鼠的体重亦增加，饲料及水的饮用量减少。"}]},{"ID":"20240607124717-zmo55s7","Type":"NodeParagraph","Properties":{"id":"20240607124717-zmo55s7","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.当饲料中加入决明子的量≥8%时，可见大鼠睾丸中精子减少，骨髓减轻、骨髓中多色红细胞数量减少，中性白细胞与淋巴细胞比值增加等。"}]},{"ID":"20240607124717-2eg50x6","Type":"NodeParagraph","Properties":{"id":"20240607124717-2eg50x6","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607124717-3o8mful","Type":"NodeParagraph","Properties":{"id":"20240607124717-3o8mful","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 决明种子含大黄酚(chrysophanol)，大黄素甲醚(physcion)，美决明子素(obtusifolin)，黄决明素(chryso-ob-tusin)，决明素(obtusin)，橙黄决明素(aurantio-obtusin)，葡萄糖基美决明子素(gluco-obtusifolin)，葡萄糖基黄决明素(gluco-chryso-obtusin)，葡萄糖基橙黄决明素(gluco-aurantio-obtusin)，红镰玫素(rubrofusarin)，决明子甙(cassiaside)，决明蒽酮(torosachrysone)，异决明种内酯(isotoralactone)，决明子内酯(cassialactone)，2，5-二甲氧基苯醌(2，5-dimethoxyben-zoquinone)，决明种内酯(toralactone)，大黄素(emodin)，芦荟大黄素(aloe-emodin)，大黄酚-9-蒽酮(chrysophanol-9-anthro-ne)，决明子甙(cassiaside)B及C，红镰玫素-6-O-龙胆二糖甙(rubrofusarin-6-O-gentiobioside)，意大利鼠李蒽醌-1-O-葡萄糖甙(alaternin-1-O-β-D-glucopyranoside)，大黄素甲醚-8-O-葡萄糖甙(physcion-8-O-β-D-glucopyranoside)，1-去甲基决明素(1-desmethylobtusin)，1-去甲基橙黄决明素(1-desmethylaurantio-ob-tusin)，1-去甲基黄决明素(1-desmethylchryso-obtusin)，大黄酚-10, 10ˊ-联蒽酮(chrysophanol-10，10ˊ-bianthrone)，大黄素-8-甲醚(questin)，苯甲酸(benzoic acid)。另含油4.65%-5.79%，其中主成分为棕榈酸(palmitic acid)，硬脂酸(stearic acid)，油酸(oleic acid)，亚油酸(linoleic acid)。又含能被蒸汽挥发的油0．014%，其中二氢猕猴桃内酯(dihydroactinodiolide)，间-甲酚(m-cresol)，2-羟基-4-甲氧基苯乙酮(2-hydroxy-4-methoxy-ace-tophenone)，棕榈酸甲酯(methyl palmitate)，油酸甲酯(methy-loleate)为主成分。在非皂化物质中，有C16-C31烷，胆甾醇(cholesterol)，豆甾醇(stigmasterol)，β-谷甾醇(β-sitosterol)，1，3-二羟基-3-甲基蒽醌(1，3-dihydroxy-3-methylanthraquinone)。小决明种子含大黄酚，决明素，橙黄决明素，大黄素，芦荟大黄素，大黄素甲醚，决明种内酯，大黄酸(rhein)，美决明子素，黄决明素，红镰玫素，去甲基红镰玫素(norrubrofusarin)，决明子甙，决明子甙B，红镰玫素-6-O-龙胆二糖甙，红镰玫素-6-O-芹糖葡萄糖甙"}]},{"ID":"20240607124717-0zyqhbc","Type":"NodeParagraph","Properties":{"id":"20240607124717-0zyqhbc","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607124717-hqwr4c6","Type":"NodeParagraph","Properties":{"id":"20240607124717-hqwr4c6","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用 决明子醇提物对葡萄球菌、白喉杆菌、伤寒、副伤寒、大肠杆菌均有抑制作用，而水提物则无效。决明子的根和种子均呈现抗菌活性，从中分得的2，5-二甲氧基苯醌对葡萄球菌、大肠杆菌均呈强抗菌活性，8-O-甲基大黄酚（8-O-methylchrysophanol）仅对葡萄球菌有抗菌活性。从根及种子获得的化合物通过纸片法观察对金黄色葡萄球菌209P及大肠杆菌NiHJ的抗菌活性，并测定了最小抑菌浓度，证明苯醌（2，5-二甲氧基苯醌）、大黄素型蒽醌类（大黄素、大黄素-8-甲醚）、四氢蒽（决明蒽酮）及萘-a-吡喃酮类（决明种内酯、异决明种内酯）抗菌活性强，而红镰玫素等萘-γ-吡喃酮无抗菌活性。有资料表明天然蒽醌中以1，8-二羟基蒽醌类衍生物的抗菌活性最强，如大黄酸、大黄素等，由于该类化合物抑制细菌中核酸的生物合成和呼吸过程而产生抗菌活性。"}]},{"ID":"20240607124717-q0inlxm","Type":"NodeParagraph","Properties":{"id":"20240607124717-q0inlxm","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用 决明子水浸剂（1：4）在试管中对石膏样毛癣菌、许兰黄癣菌、奥杜盎小芽胞癣菌等皮肤真菌有不同程度抑制作用。决明子含大黄酚-9-蒽酮，体外对红色毛癣菌、须毛癣菌、犬小孢子菌、石膏样小孢子菌、地丝菌均有较强抑制作用。"}]},{"ID":"20240607124717-wbic1kl","Type":"NodeParagraph","Properties":{"id":"20240607124717-wbic1kl","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"3.降压作用 决明子水浸液、醇-水浸液、醇浸液对麻醉犬、猫、兔等皆有降压作用。在慢性实验中，煎剂每日2g（生药）/kg，无降压作用。决明子注射液0.05g/100g体重静脉注入可使自发遗传性高血压大鼠收缩压明显降低，同时也使舒张压显着降低，其降压效果、降压幅度、作用时间均优于静脉注射利血平0.3mg/kg组大鼠。"}]},{"ID":"20240607124717-kjhgcqo","Type":"NodeParagraph","Properties":{"id":"20240607124717-kjhgcqo","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"4.对高脂血症的影响 含7%决明子的高脂饮料喂养小鼠2星期，决明子不能影响血清总胆固醇（TC）水平，但能明显升高血清高密度脂蛋白-胆固醇（HDL-C）含量及提高HDL-C/TC比值，即明显改善体内胆固醇的分布状况，而有利于预防动脉粥样硬化。决明子散有降低实验性高脂血症大鼠血浆总胆固醇和三酰甘油（甘油三酯）的作用，使之分别比模型组降低29%和73%，还能降低肝中三酰甘油和抑制血小板聚集的作用，其值分别比模型组降低49%和59%。有资料证明决明中蒽醌类化合物具有降血脂作用。"}]},{"ID":"20240607124717-xwuhsn0","Type":"NodeParagraph","Properties":{"id":"20240607124717-xwuhsn0","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"5.抗血小板聚集作用 决明具有抗二磷酸腺苷（ADP）、花生四烯酸（AA）、胶原（collagen）诱导的血小板聚集作用。决明中的3个蒽醌化合物橙黄决明素、黄决明素、大黄素有微弱的抗血小板聚集活性。从中还发现3个蒽醌糖甙类化合物葡萄糖基美决明子素、葡萄糖基橙黄决明素和葡萄糖基黄决明素均具有强的血小板聚集抑制作用。对决明分得17个9，10-蒽醌化合物进行抑制AA、ADP、胶原诱导大鼠血小板聚集活性进行筛选，结果抑制AA诱导：葡萄糖基美决明子素和葡萄糖基橙黄决明素与阿司匹林相当，葡萄糖基黄决明素约为阿司匹林的3倍；抑制ADP诱导：上述3个蒽醌塘甙类化合物为阿司匹林的5-50倍；抑制胶原诱导：上述3个蒽醌糖甙类化合物为阿斯匹林的2-5倍。并发现，在9，10-蒽醌的化合物结构中引进羟基、甲氧基或羟基成甙后，使之抑制血小板聚集活性增强。"}]},{"ID":"20240607124717-adp0laf","Type":"NodeParagraph","Properties":{"id":"20240607124717-adp0laf","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"6.对免疫功能的影响 决明子水煎醇沉剂15g/kg皮下注射可使小鼠胸腺萎缩，外周血淋巴细胞ANAE染色阴性率明显降低，使2，4-二硝基氯苯（DNCB）所致小鼠皮肤迟发型超敏反应受抑，但对血清溶血素形成无明显影响，另外决明子水煎醇沉剂可使小鼠腹腔巨噬细胞吞噬鸡红细胞百分率和吞噬指数明显增高，溶菌酶水平也明显高于对照组。上述结果表明决明子对细胞免疫功能有抑制作用，对体液免疫功能无明显影响，而对巨噬细胞吞噬功能有增强作用。"}]},{"ID":"20240607124717-gk8mwl9","Type":"NodeParagraph","Properties":{"id":"20240607124717-gk8mwl9","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"7.保肝作用 决明子热水提取物口服670mg/kg对四氯化碳中毒小鼠肝脏有弱的解毒作用。决明子经石油醚脱脂、氯仿提取，再用甲醇提取，结果该甲醇提取物有显着的护肝作用。进一步从中分得大黄酚-l-O-三葡萄糖甙、大黄酚-1-O-四葡萄糖甙在1mg/ml时对四氯化碳损伤的肝细胞有弱的保护作用，还发现芦荟大黄素也有类似的抗肝毒作用。深入的药理及植化研究还表明决明子甙、红镰玫素-6-O-龙胆二糖甙和红镰玫素-6-O-芹糖葡萄糖甙是决明子保肝的主要活性成分。"}]},{"ID":"20240607124717-nvhpz64","Type":"NodeParagraph","Properties":{"id":"20240607124717-nvhpz64","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"8.泻下作用 决明子具有缓泻作用。其流浸膏口服后泻下作用在3-5h达到高峰。从水煎液中得50%乙醇可溶部分，依次用醋酸乙酯、丁酸，分别得到各可溶部分及水溶部分。将泻下活性最高的丁醇部分用葡聚糖凝胶柱分离出数个组分，将具有活性的组分用酸水解，得到相同的大黄酚、二蒽酮及d-葡萄糖。口服这些组分后，可从大肠内检测到亚硝基二苯胺的缩合物及大黄酚蒽酮，但对用氯霉素处理而抑制肠内细菌增殖的小鼠，其泻下活性减半，蒽酮生成也降低。可见，其泻下成分可能与番泻甙A在小鼠内的作用方式相同，即在肠内细菌作用下，生成对肠管作用的物质而发挥作用。决明子含有的泻下物质之一，系相当于番泻甙A的大黄酚二蒽酮甙。"}]},{"ID":"20240607124717-qpp8fx7","Type":"NodeParagraph","Properties":{"id":"20240607124717-qpp8fx7","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"9.对胃液分泌的影响 对做了胃瘘的狗，空腹时给决明子流浸膏可促进胃液的分泌。"}]},{"ID":"20240607124717-lxcdp8b","Type":"NodeParagraph","Properties":{"id":"20240607124717-lxcdp8b","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"10.抑制15-羟基前列腺素脱氢酶（15-OH PGDH）作用具有利尿作用的前列腺素E2经15-羟基前列腺素脱氢酶作用转变为15-酮代前列腺素而被排到体外，通过抑制此体内反应可使利尿作用延长。决明子水提取液具有抑制15-OH PGDH活性。用乙烷、氯仿、甲醇、水依次提取，再用柱析法分离酶活性抑制物质，发现蒽醌衍生物决明素及美决明子素的IC50分别为1.064×10mol/，1.666×10mol/L，共存的蒽醌衍生物大黄酚及大黄素甲醚的IC50分别为1.789×10mol/L，1.236×10mol/L，抑制活性均样均较弱。"}]},{"ID":"20240607124717-8qtiu76","Type":"NodeParagraph","Properties":{"id":"20240607124717-8qtiu76","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"11.毒性 实验证明药用植物中的蒽醌化合物具有致癌性。大部分羟基蒽醌甙元对鼠伤寒沙门菌TA-1537有致突变作用。对哺乳动物细胞的测试表明，羟基蒽醌类化合物致生殖毒性有明显的构效关系，当1，3位羟基（如大黄素）和侧链有羟甲基（如2-羟基蒽酮、芦荟大黄素）时，这些蒽醌化合物就有致生殖毒性。但决明子本身的毒性尚待研究。"}]},{"ID":"20240607124717-qav67c5","Type":"NodeParagraph","Properties":{"id":"20240607124717-qav67c5","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607124717-tpntjpk","Type":"NodeParagraph","Properties":{"id":"20240607124717-tpntjpk","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 炒决明子：取净决明子，置锅内炒至微有香气，取出，放凉。"}]},{"ID":"20240607124717-92hlqfg","Type":"NodeParagraph","Properties":{"id":"20240607124717-92hlqfg","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607124717-tr6lzbt","Type":"NodeParagraph","Properties":{"id":"20240607124717-tr6lzbt","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" (1)取本品粉末0.2g，进行微量升华，将升华物置显微镜下观察，可见针状或羽状黄色结晶，加氢氧化钾试液，结晶溶解，并呈红色。(检查蒽醌类衍生物)（2）取本品粉末0.5g，加稀硫酸20ml与氯仿10ml，微沸回流15min，放冷后，移入分液漏斗中，分取氯仿层，加氢氧化钠试液10ml，振摇，放置，碱液层呈显红色。如显棕色，则分取碱液层加过氧化氢试液l-2滴，再置水浴中加热4min，即显红色。（检查蒽醌类衍生物）（3）薄层色谱 取本品粉末1g，加甲醇10ml，浸渍lh，滤过，滤液蒸干，残渣加水10ml使溶解，再加盐酸1ml，置水浴上加热30min，立即冷却，用乙醚分2次提取，每次20ml，合并乙醚液，蒸干，残渣加氯仿1ml使溶解，作为供试品溶液。另取大黄素、大黄酚对照品，加甲醇制成每1ml中各含1mg的混合溶液，作为对照品溶液。吸取上述两种溶液各2μl，分别点于同一以羧甲基纤维素钠为粘合剂的硅胶H薄层板上，以石油醚（30-60℃）-甲酸乙酯-甲酸（15：5：1）的上层溶液为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同的橙色荧光斑点；置氨气中熏后，斑点变为红色。"}]},{"ID":"20240607124717-sizjwk5","Type":"NodeParagraph","Properties":{"id":"20240607124717-sizjwk5","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124717-h58inld","Type":"NodeParagraph","Properties":{"id":"20240607124717-h58inld","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 肝；胆；肾经"}]},{"ID":"20240607124717-d6a6o8r","Type":"NodeParagraph","Properties":{"id":"20240607124717-d6a6o8r","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124717-fr6h3if","Type":"NodeParagraph","Properties":{"id":"20240607124717-fr6h3if","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 咸苦；平凉；无毒"}]},{"ID":"20240607124717-h28v51q","Type":"NodeParagraph","Properties":{"id":"20240607124717-h28v51q","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607124717-ua0dx0g","Type":"NodeParagraph","Properties":{"id":"20240607124717-ua0dx0g","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 泄泻和血压低者慎用。《本草经集注》：蓍实为之使。恶大麻子。"}]},{"ID":"20240607124717-l1mro98","Type":"NodeParagraph","Properties":{"id":"20240607124717-l1mro98","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124717-19toz5m","Type":"NodeParagraph","Properties":{"id":"20240607124717-19toz5m","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 祛风清热，解毒利湿。主风热感冒，流感，急性结膜炎，湿热黄疸，急慢性肾炎，带下，瘰疬，疮痈疖肿，乳腺炎"}]},{"ID":"20240607124717-nz5el83","Type":"NodeParagraph","Properties":{"id":"20240607124717-nz5el83","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124717-z5vbe6z","Type":"NodeParagraph","Properties":{"id":"20240607124717-z5vbe6z","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g。"}]},{"ID":"20240607124717-8uft5qm","Type":"NodeParagraph","Properties":{"id":"20240607124717-8uft5qm","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607124717-nw5wde4","Type":"NodeParagraph","Properties":{"id":"20240607124717-nw5wde4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 1.决明子散(《圣惠方》)，具补肝明目之功。2.菊花决明散(《证治准绳》)，主治目赤肿痛，羞明多泪。3.石斛夜光散(《原机启微》)，平肝疏风，滋阴明目，主治肝肾不足，阴虚火旺，瞳神散大，视物昏花，羞明流泪，以及内障等症。"}]},{"ID":"20240607124717-ezzb242","Type":"NodeParagraph","Properties":{"id":"20240607124717-ezzb242","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607124717-yh3qmf9","Type":"NodeParagraph","Properties":{"id":"20240607124717-yh3qmf9","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：治青盲，目淫肤赤白膜，眼赤痛，泪出，久服益精光。"}]},{"ID":"20240607124717-1xagzoq","Type":"NodeParagraph","Properties":{"id":"20240607124717-1xagzoq","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗唇口青。"}]},{"ID":"20240607124717-czxkt10","Type":"NodeParagraph","Properties":{"id":"20240607124717-czxkt10","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：利五脏，除肝家热。"}]},{"ID":"20240607124717-71z9set","Type":"NodeParagraph","Properties":{"id":"20240607124717-71z9set","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：助肝气，益精水；调末涂，消肿毒，熁太阳穴治头痛，又贴脑心止鼻衄；作枕胜黑豆，治头风，明目。"}]},{"ID":"20240607124717-6mdf2n4","Type":"NodeParagraph","Properties":{"id":"20240607124717-6mdf2n4","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"5.《本草衍义补遗》：解蛇毒。"}]},{"ID":"20240607124717-bafwumx","Type":"NodeParagraph","Properties":{"id":"20240607124717-bafwumx","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"6.《生草药性备要》：治小儿五疳，擦癣癞。"}]},{"ID":"20240607124717-c1br5iy","Type":"NodeParagraph","Properties":{"id":"20240607124717-c1br5iy","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"7.《医林纂要》：泻邪水。"}]},{"ID":"20240607124717-gc4lnax","Type":"NodeParagraph","Properties":{"id":"20240607124717-gc4lnax","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"8.《湖南药物志》：明目，利尿。治昏眩，脚气，浮肿，肺痈，胸痹。"}]},{"ID":"20240607124717-gxp5wct","Type":"NodeParagraph","Properties":{"id":"20240607124717-gxp5wct","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"9.广州部队《常用中草药手册》：清肝明目，利水通便。治肝炎，肝硬化腹水，高血压，小儿疳积，夜盲，风热眼痛，习惯性便秘。"}]},{"ID":"20240607124717-sgass4p","Type":"NodeParagraph","Properties":{"id":"20240607124717-sgass4p","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"10.《本草考汇》：决明，味咸走血，气寒治热，故治青盲肤膜泪出之因热伤血分者，倘系气分及风寒而致目中诸证，非其宜矣。"}]},{"ID":"20240607124717-n8vrr2w","Type":"NodeParagraph","Properties":{"id":"20240607124717-n8vrr2w","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"11.《本草经疏》：决明子，其味咸平，《别录》益以苦甘微寒而无毒。咸得水气，甘得土气，苦可泄热，平合胃气，寒能益阴泄热，足厥阴肝家正药也。亦入胆肾。肝开窍于目，瞳子神光属肾，故主青盲目淫，肤赤白膜，眼赤痛泪出。《别录》兼疗唇口青。《本经》久服益精光者，益阴泄热、大补肝肾之气所致也。"}]},{"ID":"20240607124717-w6t1zqu","Type":"NodeParagraph","Properties":{"id":"20240607124717-w6t1zqu","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"12.《本草述》：决明子、青葙子，虽曰其治目同功，然青葙子味，《本经》上云苦微寒，而决明子曰咸平，在《别录》又曰苦甘微寒，是固亦有别也。况嘉谟谓其除肝热，尤和肝气，其主治优于青葙。又先哲谓其和肝气不损元气者，二说岂尽无据欤。余治一十余岁童子，素有目疾已愈，又因衄血久而肝肾虚火俱动，致目赤左眼眦微痛，加减六味丸中入决明，不用青葙，而效甚速。"}]},{"ID":"20240607124717-p0bcxj3","Type":"NodeParagraph","Properties":{"id":"20240607124717-p0bcxj3","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"13.《本草求真》：决明子，除风散热。凡人目泪不收，眼痛不止，多属风热内淫，以致血不上行，治当即为驱逐；按此若能泄热，咸能软坚，甘能补血，力薄气浮，又能升散风邪，故为治目收泪止痛要药。并可作枕以治头风，但此服之太过，搜风至甚，反招风害，故必合以蒺藜、甘菊、枸杞、生地、女贞实、槐实、谷精草相为补助，则功更胜。谓之决明，即是此意。"}]},{"ID":"20240607124717-tdkkjjj","Type":"NodeParagraph","Properties":{"id":"20240607124717-tdkkjjj","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"14.《本草正义》：决明子明目，乃滋益肝肾，以镇潜补阴为义，是培本之正治，非如温辛散风，寒凉降热之止为标病立法者可比，最为有利无弊。"}]},{"ID":"20240607124717-ju4e9eu","Type":"NodeParagraph","Properties":{"id":"20240607124717-ju4e9eu","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124717-vqw3wvn","Type":"NodeParagraph","Properties":{"id":"20240607124717-vqw3wvn","updated":"20240607124717"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607124719-bgzak7h","Type":"NodeThematicBreak","Properties":{"id":"20240607124719-bgzak7h"}},{"ID":"20240607124720-22t8ltm","Type":"NodeParagraph","Properties":{"id":"20240607124720-22t8ltm"}}]}