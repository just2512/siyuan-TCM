n"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 537px;\" parent-style=\"width: 547px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814185924-bbj7mem","Type":"NodeParagraph","Properties":{"id":"20240814185924-bbj7mem","updated":"20240814185924"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芩 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芩 10-20240814185650-8g9asje.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 616px;","style":"width: 606px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芩 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芩 1-20240717193119-qz58dx6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 606px;\" parent-style=\"width: 616px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814185502-rguvr38","Type":"NodeParagraph","Properties":{"id":"20240814185502-rguvr38","updated":"20240814185502"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 751px;","style":"width: 741px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芩 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芩 9-20240814185433-1uqndy2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 741px;\" parent-style=\"width: 751px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 460px;","style":"width: 450px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芩 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芩 5-20240814185025-15vbx0x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 450px;\" parent-style=\"width: 460px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717193014-sp0d8ot","Type":"NodeParagraph","Properties":{"id":"20240717193014-sp0d8ot","updated":"20240814190810"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 701px;","style":"width: 691px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芩"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芩-20240717193014-7dhyhd5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 691px;\" parent-style=\"width: 701px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 437px;","style":"width: 427px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄芩 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄芩 14-20240814190810-1gtgi32.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 427px;\" parent-style=\"width: 437px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814185705-b9v86kz","Type":"NodeParagraph","Properties":{"id":"20240814185705-b9v86kz","updated":"20240814190009"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：早采挖的黄芩根部结实，叫做"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"子芩"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，生长年份较久的黄芩根部会中空腐烂，这也是黄芩的一个特点，而这种年份较久的黄芩，叫做"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"枯芩"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"；"}]},{"ID":"20240611151722-nakoi6n","Type":"NodeThematicBreak","Properties":{"id":"20240611151722-nakoi6n"}},{"ID":"20240611151734-i74jvey","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151734-i74jvey","updated":"20240611151747"},"Children":[{"Type":"NodeText","Data":"黄芩《神农本草经》"}]},{"ID":"20240611151734-wjow21x","Type":"NodeParagraph","Properties":{"id":"20240611151734-wjow21x","updated":"20240611151734"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240611151734-ects86h","Type":"NodeParagraph","Properties":{"id":"20240611151734-ects86h","updated":"20240611151734"},"Children":[{"Type":"NodeText","Data":"主诸热黄疽，肠澼，泄利，逐水，下血闭，恶创恒蚀，火疡。一名腐肠。生川谷。"}]},{"ID":"20240611151734-4b499e0","Type":"NodeParagraph","Properties":{"id":"20240611151734-4b499e0","updated":"20240611151734"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：黄芩，一名黄文，一名妒妇，一名虹胜，一名红芩，一名印头，一名内虚，神农桐君黄帝雷公扁鹊苦无毒。李氏小温，二月生赤黄叶，两两四四相值，茎空中，或方员，高三四尺，四月花紫红赤，五月实黑根黄，二月至九月采。（《御览》）"}]},{"ID":"20240611151734-2h26gaj","Type":"NodeParagraph","Properties":{"id":"20240611151734-2h26gaj","updated":"20240611151734"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名空肠，一名内虚，一名黄文，一名经芩，一名妒妇，生秭归及冤句，三月三日，采根阴干。"}]},{"ID":"20240611151734-uu3wp4v","Type":"NodeParagraph","Properties":{"id":"20240611151734-uu3wp4v","updated":"20240611151734"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上艹下金），黄（上艹下金）也。《广雅》云：（上艹下妊）葿，黄文，内虚，黄芩也。《范子计然》云：黄芩出三辅，色黄者，善。"}]},{"ID":"20240611151847-xltpw3k","Type":"NodeThematicBreak","Properties":{"id":"20240611151847-xltpw3k"}},{"ID":"20240611151848-7ypyvag","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151848-7ypyvag","updated":"20240611151854"},"Children":[{"Type":"NodeText","Data":"黄芩《要药分剂》"}]},{"ID":"20240611151848-5tn416e","Type":"NodeParagraph","Properties":{"id":"20240611151848-5tn416e","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"味苦。性平。无毒。得天地清寒之气。而兼金之性以生。可升可降。阳中阴也。"}]},{"ID":"20240611151848-fkx847a","Type":"NodeParagraph","Properties":{"id":"20240611151848-fkx847a","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"【主治】主诸热。黄胆。肠泄痢。逐水。下血闭。恶疮疽蚀火疡。（本经）疗痰热。"}]},{"ID":"20240611151848-e7yb0hn","Type":"NodeParagraph","Properties":{"id":"20240611151848-e7yb0hn","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"胃中热录）主目赤积血【归经】入心肺大小肠四经。兼入胆经。为除湿清火之品。（中焦实火脾家湿热）【前论】东垣曰。中枯而飘者名片芩。泻肺火。细实而坚者名条芩。泻大肠火。丹溪曰。"}]},{"ID":"20240611151848-hd291gs","Type":"NodeParagraph","Properties":{"id":"20240611151848-hd291gs","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"黄多用则伤肺。须先以天冬保定肺气。而后用之。罗天益曰。肺主气。热伤气。故身体麻木。"}]},{"ID":"20240611151848-ueu077j","Type":"NodeParagraph","Properties":{"id":"20240611151848-ueu077j","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"黄芩去肺热。故补气。柴胡退热。乃苦以发之。散火之标也。黄芩退热。乃寒以胜之。折火之本也。时珍曰。黄芩得柴胡退寒热。得芍药治痢。得浓朴、黄连止腹痛。得桑皮泻肺火。"}]},{"ID":"20240611151848-39tpth7","Type":"NodeParagraph","Properties":{"id":"20240611151848-39tpth7","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"得白术安胎。得陈酒上行。得猪胆汁除肝胆火。"}]},{"ID":"20240611151848-2gnw1sb","Type":"NodeParagraph","Properties":{"id":"20240611151848-2gnw1sb","updated":"20240611151848"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。过服损胃。血虚寒中者。忌用。"}]},{"ID":"20240611151937-u0iunpi","Type":"NodeThematicBreak","Properties":{"id":"20240611151937-u0iunpi"}},{"ID":"20240611151938-e24rbun","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151938-e24rbun","updated":"20240611151943"},"Children":[{"Type":"NodeText","Data":"黄芩《本草纲目》"}]},{"ID":"20240611151938-hphghgt","Type":"NodeParagraph","Properties":{"id":"20240611151938-hphghgt","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"「释名」腐肠、空肠、内虚、经芩、黄文、印头、苦督邮。内部实在的叫子芩、条芩、鼠芩。"}]},{"ID":"20240611151938-jcn7g9y","Type":"NodeParagraph","Properties":{"id":"20240611151938-jcn7g9y","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、平、无毒（一称大寒）。"}]},{"ID":"20240611151938-nw6isxz","Type":"NodeParagraph","Properties":{"id":"20240611151938-nw6isxz","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611151938-m0abx1g","Type":"NodeParagraph","Properties":{"id":"20240611151938-m0abx1g","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"1、男子五劳七伤、消渴不生肌肉，妇女带下、手足寒热，宜服“三黄丸”。随季节而不同。按上列三药的右诹，春季用量是：四两一三两一四两；夏季是：六两一一两一七两；秋季是：六两一三两一三两；冬季是：三两一五两一二两。配好后捣碎和蜜做成丸子，如乌豆大。每服五丸，渐增至七丸。一天服三次。一月后病愈。久服使人健壮。"}]},{"ID":"20240611151938-iz7gds4","Type":"NodeParagraph","Properties":{"id":"20240611151938-iz7gds4","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"2、胸部积热。用黄芩、黄连、黄蘖，等分为末。加蒸饼做成丸子，如梧子大。每服二、三十丸，开水送下。此方名“三补丸”。"}]},{"ID":"20240611151938-4vmlkmt","Type":"NodeParagraph","Properties":{"id":"20240611151938-4vmlkmt","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"3、肤热如火烧，骨蒸（结核）痰嗽等。用黄芩一两，加水二杯，煎成一杯，一次服下。"}]},{"ID":"20240611151938-3uqbxyd","Type":"NodeParagraph","Properties":{"id":"20240611151938-3uqbxyd","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"4、肝热生翳。用黄芩一两、淡豉三两，共研为末。每服三钱，以熟猪肝裹着吃，温汤送下。一天服二次。忌食酒、面。"}]},{"ID":"20240611151938-kkb2r6o","Type":"NodeParagraph","Properties":{"id":"20240611151938-kkb2r6o","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"5、吐血、鼻血、下血。黄芩一两，研末，每取三钱，加水一碗，煎至六成，和渣一起温服。"}]},{"ID":"20240611151938-u10ax0y","Type":"NodeParagraph","Properties":{"id":"20240611151938-u10ax0y","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"6、血淋热痛。用黄芩一两，水煎，热服。"}]},{"ID":"20240611151938-7swq577","Type":"NodeParagraph","Properties":{"id":"20240611151938-7swq577","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"7、妇女绝经期的年龄已过，仍有月经或月经过多。用黄芩心二两，浸淘米水中七天，取出炙干再浸，如此七次，研细，加醋加糊做成丸子，如梧子大。每服七十丸，空心服，温酒送下。一天服二次。"}]},{"ID":"20240611151938-yyam512","Type":"NodeParagraph","Properties":{"id":"20240611151938-yyam512","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"8、安胎清热。用芩、白术，等分为末，调米汤做成丸子，如梧子大。每服五十丸，开水磅下。药中加神曲亦可。"}]},{"ID":"20240611151938-z6i2jbb","Type":"NodeParagraph","Properties":{"id":"20240611151938-z6i2jbb","updated":"20240611151938"},"Children":[{"Type":"NodeText","Data":"9、产后血渴，饮水不止。用黄芩、麦门冬，等分为末，水煎，温服。"}]},{"ID":"20240611151924-d89se6f","Type":"NodeThematicBreak","Properties":{"id":"20240611151924-d89se6f"}},{"ID":"20240611151925-mgv1vzc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151925-mgv1vzc","updated":"20240611151929"},"Children":[{"Type":"NodeText","Data":"黄芩《本草备要》"}]},{"ID":"20240611151925-j5c87ri","Type":"NodeParagraph","Properties":{"id":"20240611151925-j5c87ri","updated":"20240611151925"},"Children":[{"Type":"NodeText","Data":"泻火，除湿"}]},{"ID":"20240611151925-3ozyncz","Type":"NodeParagraph","Properties":{"id":"20240611151925-3ozyncz","updated":"20240611151925"},"Children":[{"Type":"NodeText","Data":"苦入心，寒胜热。泻中焦实火，除脾家湿热。"}]},{"ID":"20240611151925-jy72atv","Type":"NodeParagraph","Properties":{"id":"20240611151925-jy72atv","updated":"20240611151925"},"Children":[{"Type":"NodeText","Data":"治 痢腹痛（便血曰 ，寒痛忌用。凡腹痛有寒热、虚实、食积，瘀血、痰湿之不同。"}]},{"ID":"20240611151925-iwyiw8t","Type":"NodeParagraph","Properties":{"id":"20240611151925-iwyiw8t","updated":"20240611151925"},"Children":[{"Type":"NodeText","Data":"寒宜温，热宜清，虚宜补，实宜下，食宜消导，瘀血宜行散，痰湿宜化痰利湿。痛时手不可按者为实痛，按之痛止者为虚痛），寒热往来（邪在少阳），黄胆五淋，血闭（实热在血分）气逆，痈疽疮疡，及诸失血。消痰（丹溪以黄芩降痰，假其降火也。按痰因火动，当先降火）利水，解渴安胎（胎孕宜清热凉血，血不妄行则胎安），养阴退阳，补膀胱水。"}]},{"ID":"20240611151925-3cyft6k","Type":"NodeParagraph","Properties":{"id":"20240611151925-3cyft6k","updated":"20240611151925"},"Children":[{"Type":"NodeText","Data":"酒炒则上行，泻肺火，利胸中气（肺主气，热伤气，泻热所以保肺）。治上焦之风热、湿热（丹溪曰∶黄芩上、中二焦药），火嗽喉腥（五臭，肺为腥），目赤肿痛。过服损胃。血虚、寒中者禁用（得柴胡退寒热，得芍药治痢，得浓朴、黄连止腹痛，得桑皮泻肺火，得白术安胎之圣药。时珍曰∶仲景治少阳证小柴胡汤，太阳少阳合病下利黄芩汤，少阳证下后心满泻心汤，并用之。盖黄连苦寒，入心泻热，除脾家湿热，使胃火不流入肺，不致刑金，即所以保肺也。肺虚不宜者，苦寒伤土，损其母也。少阳证虽在半表半里，而心膈痞满，实兼心、肺上焦之邪。心烦喜呕，默默不欲食，又兼脾、胃中焦之证，故用黄芩以治手，足少阳相火，黄芩亦少阳药也。杨士瀛曰∶柴胡退热，不及黄芩。时珍曰∶柴胡乃苦以发之，散火之标也；黄芩乃寒能胜热，折火之本也。东垣治肺热，身如火燎，烦燥引饮。而昼盛者，宜一味黄芩汤，以泻肺经气分之火，黄芩一两煎服。《本事方》用治崩中、暴下）。"}]},{"ID":"20240611151925-5kyh9hq","Type":"NodeParagraph","Properties":{"id":"20240611151925-5kyh9hq","updated":"20240611151925"},"Children":[{"Type":"NodeText","Data":"黄明者良。中虚名枯芩，即片芩，泻肺火，清肌表之热。内实名条芩，即子芩，泻大肠火，补膀胱水。上行酒炒。泻肝，胆火，猪胆汁炒。山茱萸、龙骨为使。畏丹皮、丹砂。"}]},{"ID":"20240611151901-zxhwyw5","Type":"NodeThematicBreak","Properties":{"id":"20240611151901-zxhwyw5"}},{"ID":"20240611151902-0uyqpsb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151902-0uyqpsb","updated":"20240611151916"},"Children":[{"Type":"NodeText","Data":"黄芩《医学入门》"}]},{"ID":"20240611151902-bkb4n40","Type":"NodeParagraph","Properties":{"id":"20240611151902-bkb4n40","updated":"20240611151902"},"Children":[{"Type":"NodeText","Data":"黄芩苦味枯飘者，泻肺除风热在肌，坚者大肠除热用，膀胱得助化源宜。"}]},{"ID":"20240611151902-vp983df","Type":"NodeParagraph","Properties":{"id":"20240611151902-vp983df","updated":"20240611151902"},"Children":[{"Type":"NodeText","Data":"芩，金也，黄色，应秋金也。气寒。无毒。可升可降，阴也，入手太阴经。中空而烂者名腐肠，泻肺受火邪气逆，消膈上痰热及胃中湿热黄胆。中破而飘者名宿芩，泻肺痰火，利气，除时行风湿热邪在表，寒热往来，诸疮乳痈，背发疔肿火疡，用之排脓。一切上部实热痰热积血，假此降散。细实直而坚者名条芩，泻大肠火，逐水消谷，止热泻下痢脓血、腹痛后重，养阴退阳。细实圆而坚者名子芩，去膀胱热，滋化源，利小肠，治五淋小腹绞痛，及女子血闭下血。又安胎者，由其能降上中二焦之火，使之下行也。故曰得浓朴、黄连止腹痛；得五味子，牡蒙、牡蛎令人有子；得黄 、白蔹、赤小豆疗鼠 ；得川芎调平心血，心平而热自退，血不妄行矣。酒炒上行，便炒下行，寻常生用。山茱萸、龙骨为使，恶葱实，畏丹砂、牡丹、藜芦。"}]},{"ID":"20240611151954-1p3u52g","Type":"NodeThematicBreak","Properties":{"id":"20240611151954-1p3u52g"}},{"ID":"20240611152000-8xqd67g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152000-8xqd67g","updated":"20240611152013"},"Children":[{"Type":"NodeText","Data":"黄芩《证类本草》"}]},{"ID":"20240611152000-bf3oti0","Type":"NodeParagraph","Properties":{"id":"20240611152000-bf3oti0","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"味苦，平、大寒，无毒。主诸热黄胆，肠 泄痢，逐水下血闭，恶疮疽蚀火疡，疗痰热，胃中热，小腹绞痛，消谷，利小肠，女子血闭，淋露下血，小儿腹痛。一名腐肠，一名空肠，一名内虚，一名黄文，一名经芩，一名妒妇。其子主肠 脓血。生秭归川谷及冤句。"}]},{"ID":"20240611152000-73ljrcv","Type":"NodeParagraph","Properties":{"id":"20240611152000-73ljrcv","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"三月三日采根，阴干。（得浓朴、黄连止腹痛。得五味子、牡蒙、牡蛎令人有子。得黄 、白蔹、赤小豆疗鼠 。山茱萸、龙骨为之使，恶葱实，畏丹砂、牡丹、藜芦。）"}]},{"ID":"20240611152000-goxhp27","Type":"NodeParagraph","Properties":{"id":"20240611152000-goxhp27","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶秭归属建平郡，今第一出彭城，郁州亦有之。圆者名子芩为胜，破者名宿芩，其腹中皆烂，故名腐肠。唯取深色坚实者为好。俗方多用，道家不须。"}]},{"ID":"20240611152000-c1aeiul","Type":"NodeParagraph","Properties":{"id":"20240611152000-c1aeiul","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"唐本注云∶叶细长，两叶相对，作丛生，亦有独茎者。今出宜州、 州、泾州者佳。兖州者大实亦好，名豚尾芩也。臣禹锡等谨按药性论云∶黄芩，臣，味苦、甘。能治热毒，骨蒸，寒热往来，肠胃不利，破拥气，治五淋，令人宣畅，去关节烦闷，解热渴，治热，腹中 痛，心腹坚胀。日华子云∶下气，主天行热疾，疔疮，排脓，治乳痈、发背。"}]},{"ID":"20240611152000-uvhacsx","Type":"NodeParagraph","Properties":{"id":"20240611152000-uvhacsx","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"图经曰∶黄芩，生秭归山谷及冤句，今川蜀、河东、陕西近郡皆有之。苗长尺余，茎秆粗如箸，叶从地四面作丛生，类紫草，高一尺许，亦有独茎者，叶细长，青色，两两相对。六月开紫花，根黄如知母粗细，长四、五寸，二月、八月采根，曝干用之。《吴普本草》云∶黄芩又名印头，一名内虚。二月生赤黄叶，两两、四四相值，其茎空中，或方圆，高三、四尺。"}]},{"ID":"20240611152000-f2i3559","Type":"NodeParagraph","Properties":{"id":"20240611152000-f2i3559","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"花紫红赤，五月实黑，根黄。二月、九月采。与今所有小异。张仲景治伤寒心下痞满泻心汤，四方皆用黄芩，以其主诸热，利小肠故也。又太阳病，下之利下止，有葛根黄芩黄连汤，及主妊娠安胎散亦多用黄芩。今医家尝用有效者，因着之。又《千金方》∶巴郡太守奏加减三黄丸，疗男子五劳七伤，消渴，不生肌肉，妇人带下，手足寒热者。春三月，黄芩四两，大黄三两，黄连四两；夏三月，黄芩六两，大黄一两，黄连七两；秋三月，黄芩六两，大黄二两，黄连三两；冬三月，黄芩三两，大黄五两，黄连二两。三物随时合捣下筛，蜜丸大如乌豆。米饮服五丸，日三。不知，稍增七丸，服一月病愈。久服走及走奔马，近频有验。食禁猪肉。又陶隐居云∶黄芩圆者名子芩。仲景治杂病方，多用之。"}]},{"ID":"20240611152000-5vhay7o","Type":"NodeParagraph","Properties":{"id":"20240611152000-5vhay7o","updated":"20240611152000"},"Children":[{"Type":"NodeText","Data":"千金翼治淋。黄芩四两，袋贮之，水五升煮三升，分三服。梅师治火丹。杵黄芩末，水调敷之。"}]},{"ID":"20240611152019-d0cc6ey","Type":"NodeThematicBreak","Properties":{"id":"20240611152019-d0cc6ey"}},{"ID":"20240611152021-ey8dzs2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152021-ey8dzs2","updated":"20240611152025"},"Children":[{"Type":"NodeText","Data":"黄芩《本草从新》"}]},{"ID":"20240611152021-t44qz4u","Type":"NodeParagraph","Properties":{"id":"20240611152021-t44qz4u","updated":"20240611152021"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻火除湿．"}]},{"ID":"20240611152021-8yjgr5v","Type":"NodeParagraph","Properties":{"id":"20240611152021-8yjgr5v","updated":"20240611152021"},"Children":[{"Type":"NodeText","Data":"苦入心．寒胜热．泻中焦实火．除脾家湿热．治 痢腹痛．（寒痛忌用、凡腹痛、有寒热、虚实、食积、瘀血、痰湿之不同、寒宜温、热宜清、虚宜补、实宜攻、食宜消导、瘀血宜行散、湿痰宜化痰利湿、痛时手不可按者、为实痛、按之痛止者、为虚痛．）寒热往来．（邪在少阳．）黄胆五淋血闭．（实热在血分．）气逆痈疽疮疡．及诸失血．降痰．（丹溪曰∶黄芩降痰、假其降火也、痰因火动、当先降火．）解渴安胎．（胎孕宜清热凉血、血不妄行、则胎安．）"}]},{"ID":"20240611152021-xfzmea3","Type":"NodeParagraph","Properties":{"id":"20240611152021-xfzmea3","updated":"20240611152021"},"Children":[{"Type":"NodeText","Data":"酒炒则上行．泻肺火．利胸中气．（肺主气、热伤气、泻热所以利气．）治上焦之风热湿热．（丹溪曰∶黄芩、上中二焦药．）火嗽喉腥．（五臭、肺为腥．）目赤肿痛．（黄芩得柴胡、退寒热、得芍药、治痢、得浓朴黄连、止腹痛、得桑皮、泻肺火、得白术、安胎之圣药、时珍曰∶仲景治少阳证、小柴胡汤、太阳少阳合病下痢、黄芩汤、少阳证下后心满、泻心汤并用之、盖黄芩苦寒入心、泻热、除脾家湿热、使胃火不流入肺、不致刑金、即所以保肺也、肺虚不宜者、苦寒伤土、损其母也、少阳证虽在半表半里、而心膈痞满、实兼心肺上焦之邪、心烦喜呕、默默不欲食、又兼脾胃中焦之证、故用黄芩以治手足少阳相火、黄芩亦少阳药也、杨士瀛直指方曰∶柴胡退热、不及黄芩、时珍曰∶柴胡乃苦以发之、散火之标也、黄芩乃寒能胜热、折火之本也、东垣治肺热、身如火燎、烦躁引饮而昼盛者、宜一味黄芩汤、以泻肺经气分之火、黄芩一两、煎服、本事方、治崩中暴下．）苦寒伤胃．虚寒者．均宜戒．"}]},{"ID":"20240611152021-xhjizbq","Type":"NodeParagraph","Properties":{"id":"20240611152021-xhjizbq","updated":"20240611152021"},"Children":[{"Type":"NodeText","Data":"胎前若非实热而服之．阴损胎元矣．中虚者名枯芩．即片芩．泻肺火．清肌表之热．（轻飘者上行．）内实者名条芩．即子芩．泻大肠火．（坚重者下降．）上行酒炒．泻肝胆火猪胆汁炒．山茱、龙骨为使．畏丹皮、丹砂．"}]},{"ID":"20240611152042-r7a8m3a","Type":"NodeThematicBreak","Properties":{"id":"20240611152042-r7a8m3a"}},{"ID":"20240611152043-uveghan","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152043-uveghan","updated":"20240611152047"},"Children":[{"Type":"NodeText","Data":"黄芩《得配本草》"}]},{"ID":"20240611152043-c2mdf5b","Type":"NodeParagraph","Properties":{"id":"20240611152043-c2mdf5b","updated":"20240611152043"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旧根中空而枯者名片芩，又名枯芩。新根内实者名子芩，又名条芩。"}]},{"ID":"20240611152043-svtzt4n","Type":"NodeParagraph","Properties":{"id":"20240611152043-svtzt4n","updated":"20240611152043"},"Children":[{"Type":"NodeText","Data":"龙骨、山茱萸为之使。畏丹砂、牡丹、藜芦。恶葱。"}]},{"ID":"20240611152043-nem1sez","Type":"NodeParagraph","Properties":{"id":"20240611152043-nem1sez","updated":"20240611152043"},"Children":[{"Type":"NodeText","Data":"苦，寒。入手太阴、少阳、阳明经气分。泻三焦实火，祛肌表邪热，利气郁，消膈痰，解喉腥，化斑疹，治疮疡，通肠闭，止热痛，凉血安胎。得黄 、白蔹、赤小豆，治鼠 。得浓朴、川连，止腹痛。得白芍，治下痢。得桑白皮，泻肺火。得白术，安胎。得米醋浸，炙七次为末，水服，治吐衄崩中下血。得酒炒为末服，治灸疮出血。（一人灸至五壮，血出不止如尿，手冷欲绝，服此即止。）配人参为末，治小儿惊啼。配白芷、细茶，治眉眶痛。"}]},{"ID":"20240611152043-3xasdfn","Type":"NodeParagraph","Properties":{"id":"20240611152043-3xasdfn","updated":"20240611152043"},"Children":[{"Type":"NodeText","Data":"酒炒，上行。生用，下行。猪胆汁炒，泻肝胆火。片芩泻肺胃上焦之火，子芩泻大肠下焦之火。痘疹灌浆时，大肠无火，肺气虚弱，血虚胎动，皆禁用。黄芩、山栀、甘菊、知母、麦冬、沙参、桑皮、地骨皮、花粉、紫菀，皆制肺金之火。盖肺本清肃之府，最畏者惟火。故气热而欲泄之，桑皮、地骨皮之类。邪火而欲泄之，山栀、黄芩之类。金枯于火而欲泄之，沙参、麦冬之类。痰火而欲泄之，紫菀、花粉之类。木火侮金而欲泄之，甘菊、黄芩之类。肾火烁金而欲泄之，知母、地骨皮之类。其余各经之火，皆能侵犯肺金，务在各祛其火，不治肺而肺无不治，勿得专用黄芩以治肺火。"}]},{"ID":"20240611152052-uq2ar7a","Type":"NodeThematicBreak","Properties":{"id":"20240611152052-uq2ar7a"}},{"ID":"20240611152053-3z7ekiy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152053-3z7ekiy","updated":"20240611152058"},"Children":[{"Type":"NodeText","Data":"黄芩《神农本草经百种录》"}]},{"ID":"20240611152053-wy0zqgq","Type":"NodeParagraph","Properties":{"id":"20240611152053-wy0zqgq","updated":"20240611152053"},"Children":[{"Type":"NodeText","Data":"味苦平。主诸热，黄胆，大肠经中之郁热。肠 泄痢，大肠府中之郁结。逐水，水在肠中者。下血闭，血之在阳明者使从大便出。恶疮疽蚀，火疡。阳明主肌肉，凡肌肉热毒等病，此皆除之。"}]},{"ID":"20240611152053-8jw87c6","Type":"NodeParagraph","Properties":{"id":"20240611152053-8jw87c6","updated":"20240611152053"},"Children":[{"Type":"NodeText","Data":"此以形色为治，黄芩中空而色黄，为大肠之药，故能除肠胃诸热病。黄色属土属脾，大肠属阳明燥金，而黄芩之黄属大肠，何也？盖胃与大肠为出纳水谷之道，皆统于脾。又金多借土之色以为色。义详决明条下，相参益显也。"}]},{"ID":"20240611152144-sfyvcqs","Type":"NodeThematicBreak","Properties":{"id":"20240611152144-sfyvcqs"}},{"ID":"20240611152145-o0ebol6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152145-o0ebol6","updated":"20240611152149"},"Children":[{"Type":"NodeText","Data":"黄芩《千金翼方》"}]},{"ID":"20240611152145-800l93e","Type":"NodeParagraph","Properties":{"id":"20240611152145-800l93e","updated":"20240611152145"},"Children":[{"Type":"NodeText","Data":"味苦，平，大寒，无毒。主热，黄胆，肠 泻痢，逐水，下血闭，恶疮，疽蚀，疗痰热，胃中热，小腹绞痛，消谷，利小肠，女子血闭，淋露下血，小儿腹痛。一名腐肠一名空肠，一名内虚，一名黄文，一名经芩，一名妒妇。其子主肠 脓血。生秭归川谷及句，三月三日采根，阴干。"}]},{"ID":"20240611152103-wmenhr1","Type":"NodeThematicBreak","Properties":{"id":"20240611152103-wmenhr1"}},{"ID":"20240611152104-rdqdtac","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152104-rdqdtac","updated":"20240611152113"},"Children":[{"Type":"NodeText","Data":"黄芩《本草图经》"}]},{"ID":"20240611152104-1e5affz","Type":"NodeParagraph","Properties":{"id":"20240611152104-1e5affz","updated":"20240611152108"},"Children":[{"Type":"NodeText","Data":"黄芩，生秭归山谷及冤句，今川蜀、河东、陕西近郡皆有之。苗长尺余、茎秆粗如箸；叶从地四面作丛生，类紫草，高一尺许，亦有独茎者，叶细长青色，两两相对；六月开紫花；根黄，如知母粗细，长四、五寸。二月、八月采根，曝干用之。《吴普本草》云∶黄芩又名印头，一名内虚。二月生，赤黄。叶两两四四相值；其茎空中，或方圆，高三、四尺；花紫红赤。五月实黑；根黄，二月、九月采，与今所有小异。张仲景治伤寒心下痞满，泻心汤，四方皆用黄芩，以其主诸热，利小肠故也。又太阳病下之，利不止，有葛根黄芩黄连汤，及主妊娠安胎散，亦多用黄芩。今医家尝用有效者因着之。又《千金方》巴郡太守奏加减三黄丸，疗男子五劳七伤，消渴，不生肌肉，妇人带下手足寒热者。春三月，黄芩四两，大黄三两，黄连四两；夏三月，黄芩六两，大黄一两，黄连七两；秋三月，黄芩六两，大黄二两，黄连三两；冬三月，黄芩三两，大黄五两，黄连二两。三物随时合捣，下筛，蜜丸，大如乌豆，米饮服五丸，日三，不知稍增七丸，服一月，病愈。久服，走及奔马近频有验。食禁猪肉。又陶隐居云∶黄芩圆者，名子芩。仲景治杂病方多用之。"}]},{"ID":"20240611152207-p46l76g","Type":"NodeThematicBreak","Properties":{"id":"20240611152207-p46l76g"}},{"ID":"20240611152208-iun18pt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152208-iun18pt","updated":"20240611152213"},"Children":[{"Type":"NodeText","Data":"黄芩《本草害利》"}]},{"ID":"20240611152208-98dvgg2","Type":"NodeParagraph","Properties":{"id":"20240611152208-98dvgg2","updated":"20240611152208"},"Children":[{"Type":"NodeText","Data":"〔害〕凡苦寒性燥，功能除热，而非补益之品。但无湿者，如脾肺虚热，及中寒作泄，中寒腹痛，肝肾虚水肿，血枯经闭，肺受寒邪喘嗽，及血虚胎不安，阴虚淋漏皆忌。胎前若非实热而服之，因损胎元矣。"}]},{"ID":"20240611152208-ezxbqh6","Type":"NodeParagraph","Properties":{"id":"20240611152208-ezxbqh6","updated":"20240611152208"},"Children":[{"Type":"NodeText","Data":"〔利〕苦寒，中虚而大者曰枯芩，泻肺火，清肌表之热，并理目赤，疔痈。坚实而细者曰条芩，即子芩，泻大肠火，治 痢腹痛，兼可安胎，亦治上焦风热湿热，利水。二芩俱兼入脾经，苦能燥湿，泄热下气也。轻飘者上行，坚重者下降，不可不别也。柴胡退热不及黄芩，柴胡苦以发之，散火之标，黄芩寒以胜热，折火之本。"}]},{"ID":"20240611152208-ps12l1s","Type":"NodeParagraph","Properties":{"id":"20240611152208-ps12l1s","updated":"20240611152208"},"Children":[{"Type":"NodeText","Data":"若饮食受寒，腹中痛，及饮水心下悸，小便不利，而脉不数者，是里无热也。"}]},{"ID":"20240611152208-q88oz2z","Type":"NodeParagraph","Properties":{"id":"20240611152208-q88oz2z","updated":"20240611152208"},"Children":[{"Type":"NodeText","Data":"〔修治〕得酒炒则上行，得猪肝汁炒，除肝胆火，得柴胡退寒热，得芍药治下痢，得桑白皮泻肺火，皆取苦寒泻有余之邪。"}]},{"ID":"20240611152231-oc6d4gg","Type":"NodeThematicBreak","Properties":{"id":"20240611152231-oc6d4gg"}},{"ID":"20240611152232-lfwq5f5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152232-lfwq5f5","updated":"20240611152237"},"Children":[{"Type":"NodeText","Data":"黄芩《长沙药解》"}]},{"ID":"20240611152232-fkf1xg9","Type":"NodeParagraph","Properties":{"id":"20240611152232-fkf1xg9","updated":"20240611152232"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦平。主诸热黄疽，肠澼，泄利，逐水，下血闭，恶创恒蚀，火疡。一名腐肠。生川谷。"}]},{"ID":"20240611152232-ebarhua","Type":"NodeParagraph","Properties":{"id":"20240611152232-ebarhua","updated":"20240611152232"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"味苦，气寒，入足少阳胆、足厥阴肝经。清相火而断下利，泻甲木而止上呕，除少阳之痞热，退厥阴之郁蒸。"}]},{"ID":"20240611152232-ija19hq","Type":"NodeParagraph","Properties":{"id":"20240611152232-ija19hq","updated":"20240611152232"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄芩三两，芍药二两，甘草一两，大枣十二枚，若呕者，加半夏半升，生姜三两。"},{"Type":"NodeText","Data":"治太阳少阳合病，自下利者。以太阳而传少阳，少阳经气内遏，必侵克戊土，而为呕利。逆而不降，则壅迫上脘而为呕，降而不舒，则郁迫下脘而为利。利泄胃阳，则入太阴之脏，利亡脾阴，则传阳明之腑。少阳以甲木而化相火，易传阳明而为热。甘草、大枣，补其脾精。黄芩、芍药，泻其相火也。"}]},{"ID":"20240611152232-906h8fu","Type":"NodeParagraph","Properties":{"id":"20240611152232-906h8fu","updated":"20240611152232"},"Children":[{"Type":"NodeText","Data":"《外台》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄芩三两，半夏半升，人参三两，大枣十二枚，干姜二两，桂枝一两。"},{"Type":"NodeText","Data":"治干呕下利者。以其中气虚寒，脾陷而贼于乙木，则为下利，胃逆而贼于甲木，则为干呕。人参、大枣，补中培土，干姜、桂枝，温升肝脾而止下利，黄芩、半夏，清降胆胃而止干呕也。"}]},{"ID":"20240611152232-1bkx6vs","Type":"NodeParagraph","Properties":{"id":"20240611152232-1bkx6vs","updated":"20240611152232"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小柴胡汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在柴胡。"},{"Type":"NodeText","Data":"用之治往来寒热，胸胁硬满。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大柴胡汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在柴胡。"},{"Type":"NodeText","Data":"用之治发热汗出，心下痞硬。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏泻心汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在半夏。"},{"Type":"NodeText","Data":"用之治呕而发热，心中痞满。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生姜泻心汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在生姜。"},{"Type":"NodeText","Data":"用之治干呕食臭，心下痞硬。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"甘草泻心汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在甘草。"},{"Type":"NodeText","Data":"用之治水谷不化，心下痞硬。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"附子泻心汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在附子。"},{"Type":"NodeText","Data":"用之治恶寒汗出，心下痞硬。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄黄连泻心汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治关上脉浮，心下痞濡。"}]},{"ID":"20240611152232-pz72qz2","Type":"NodeParagraph","Properties":{"id":"20240611152232-pz72qz2","updated":"20240611152232"},"Children":[{"Type":"NodeText","Data":"以少阳之经，自头走足，下胸贯膈，由心下而行两胁。经气郁遏，内攻戊土，胃气被贼，胀满不运，外逼少阳之经，结塞不开，是以心胁痞满。结微则濡，结甚则硬。少阳经郁，相火升炎，黄芩清少阳之相火，以泻痞郁之热也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葛根黄芩黄连汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在葛根。"},{"Type":"NodeText","Data":"用之治喘而汗出者。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽漆汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在泽漆。"},{"Type":"NodeText","Data":"用之治咳而脉浮者，清相火之刑辛金也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干姜芩连人参汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在干姜。"},{"Type":"NodeText","Data":"用之治食入即吐者，清甲木之克戊土也。《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳖甲煎丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在鳖甲。"},{"Type":"NodeText","Data":"用之治疟病结为癥瘕，清少阳之郁火也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄（庶/虫）虫丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治虚劳内有干血，清厥阴之燥热也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当归散"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在当归。"},{"Type":"NodeText","Data":"用之治妊妇诸病，清风木之郁蒸也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄土汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在黄土。"},{"Type":"NodeText","Data":"用之治便后下血，清风木之疏泄也。"}]},{"ID":"20240611152232-b1yxn2i","Type":"NodeParagraph","Properties":{"id":"20240611152232-b1yxn2i","updated":"20240611152232"},"Children":[{"Type":"NodeText","Data":"甲木清降，则下根癸水而上不热，乙木温升，则上生丁火而下不热。足厥阴病则乙木郁陷而生下热，足少阳病则甲木郁升而生上热，以甲木原化气于相火，乙木亦含孕乎君火也。黄芩苦寒，并入甲乙，泻相火而清风木，肝胆郁热之证，非此不能除也。然甚能寒中，厥阴伤寒，脉迟，而反与黄芩汤彻其热，脉迟为寒，今与黄芩汤复除其热，腹中应冷，当不能食，今反能食，此名除中，必死。小柴胡汤，腹中痛者，去黄芩，加芍药。心下悸，小便不利者，去黄芩，加茯苓。凡脉迟，腹痛，心下悸，小便少者，忌之。"}]},{"ID":"20240611152232-vskfg8o","Type":"NodeParagraph","Properties":{"id":"20240611152232-vskfg8o","updated":"20240611152232"},"Children":[{"Type":"NodeText","Data":"清上用枯者，清下用实者。内行醋炒，外行酒炒。"}]},{"ID":"20240611152217-ksxj65f","Type":"NodeThematicBreak","Properties":{"id":"20240611152217-ksxj65f"}},{"ID":"20240611152219-3gxlsdg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152219-3gxlsdg","updated":"20240611152224"},"Children":[{"Type":"NodeText","Data":"黄芩《吴普本草》"}]},{"ID":"20240611152219-3qj2uvu","Type":"NodeParagraph","Properties":{"id":"20240611152219-3qj2uvu","updated":"20240611152219"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十二"}]},{"ID":"20240611152219-jx6n2cf","Type":"NodeParagraph","Properties":{"id":"20240611152219-jx6n2cf","updated":"20240611152219"},"Children":[{"Type":"NodeText","Data":"一名黄文，一名妒妇，一名虹胜，一名经芩，一名印头，一名内虚。神农、桐君、黄帝、雷公、扁鹊∶苦，无毒。李氏∶小温。二月生，赤黄叶，两两四四相值，茎空中，或方圆，高三、四尺，四月华紫红赤，五月实黑，根黄，二月至九月采。"}]},{"ID":"20240611152155-jmyxyun","Type":"NodeThematicBreak","Properties":{"id":"20240611152155-jmyxyun"}},{"ID":"20240611152156-phmn6kb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152156-phmn6kb","updated":"20240611152201"},"Children":[{"Type":"NodeText","Data":"黄芩《汤液本草》"}]},{"ID":"20240611152156-02m5gqs","Type":"NodeParagraph","Properties":{"id":"20240611152156-02m5gqs","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"气寒，味微苦，苦而甘。微寒，味薄气浓，阳中阴也。阴中微阳，大寒。无毒。"}]},{"ID":"20240611152156-uslsgj5","Type":"NodeParagraph","Properties":{"id":"20240611152156-uslsgj5","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"入手太阴经之剂。"}]},{"ID":"20240611152156-xvx6ni5","Type":"NodeParagraph","Properties":{"id":"20240611152156-xvx6ni5","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"《象》云∶治肺中湿热，疗上热，目中赤肿，瘀肉壅盛，必用之药。泄肺受火邪上逆于膈上。补膀胱之寒不足，乃滋其化源也。"}]},{"ID":"20240611152156-blika4p","Type":"NodeParagraph","Properties":{"id":"20240611152156-blika4p","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"《心》云∶泻肺中之火。"}]},{"ID":"20240611152156-jqmc9c3","Type":"NodeParagraph","Properties":{"id":"20240611152156-jqmc9c3","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"洁古云∶利胸中气，消膈上痰。性苦寒，下痢脓血稠粘，腹疼后重，身热，久不可者。"}]},{"ID":"20240611152156-hvumx4a","Type":"NodeParagraph","Properties":{"id":"20240611152156-hvumx4a","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"与芍药、甘草同用。"}]},{"ID":"20240611152156-567j1d1","Type":"NodeParagraph","Properties":{"id":"20240611152156-567j1d1","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"《珍》云∶除阳有余，凉心去热，通寒格。阴中微阳，酒炒上行，主上部积血，非此不能除。肺苦气上逆，急食苦以泄之。"}]},{"ID":"20240611152156-2jbl3c8","Type":"NodeParagraph","Properties":{"id":"20240611152156-2jbl3c8","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主诸热黄胆，肠 泄痢，逐水，下血闭，恶疮疽蚀，火伤，疗痰热，胃中热，小腹绞痛。消谷，利小肠，女子血闭，淋露下血，小儿腹痛。"}]},{"ID":"20240611152156-yn4ij3g","Type":"NodeParagraph","Properties":{"id":"20240611152156-yn4ij3g","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"东垣云∶味苦而薄，中枯而飘，故能泻肺火而解肌热，手太阴剂也。细实而中不空者，治下部妙。"}]},{"ID":"20240611152156-wnvj7df","Type":"NodeParagraph","Properties":{"id":"20240611152156-wnvj7df","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶色深坚实者好。又治奔豚、脐下热痛。飘与实，高下之分，与枳实、枳壳同例。黄芩，其子主肠 脓血。"}]},{"ID":"20240611152156-y5w1ls4","Type":"NodeParagraph","Properties":{"id":"20240611152156-y5w1ls4","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"《本草》又云∶得浓朴、黄连，治腹痛；得五味子、牡蒙、牡蛎，令人有子；得黄 、白蔹、赤小豆，疗鼠 。山茱萸、龙骨为之使。恶葱实。畏丹砂、牡丹、黎芦。"}]},{"ID":"20240611152156-dmbjhtj","Type":"NodeParagraph","Properties":{"id":"20240611152156-dmbjhtj","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"张仲景治伤寒心下痞满，泻心汤四方皆用黄芩，以其去诸热、利小肠故也。又，太阳病下之，利不止，有葛根黄芩黄连汤。亦主妊娠，安胎散内多用黄芩，今医家常用有效者，因着之。《千金方》∶巴郡太守奏加减三黄丸，疗男子五劳七伤、消渴、不生肌肉，妇人带下、手足寒热者。久服之，得行及奔马。甚验。"}]},{"ID":"20240611152156-0av5fgo","Type":"NodeParagraph","Properties":{"id":"20240611152156-0av5fgo","updated":"20240611152156"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶黄芩，圆者名子芩，仲景治杂病方多用之。"}]},{"ID":"20240611152132-9ozn31j","Type":"NodeThematicBreak","Properties":{"id":"20240611152132-9ozn31j"}},{"ID":"20240611152133-4y1ez6a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152133-4y1ez6a","updated":"20240611152137"},"Children":[{"Type":"NodeText","Data":"黄芩《神农本草经赞》"}]},{"ID":"20240611152133-z5je5uk","Type":"NodeParagraph","Properties":{"id":"20240611152133-z5je5uk","updated":"20240611152133"},"Children":[{"Type":"NodeText","Data":"味苦平。主诸热黄胆。肠泄利。逐水下血闭。恶创疽蚀火疡。一名腐肠。生川谷。"}]},{"ID":"20240611152133-npmjhon","Type":"NodeParagraph","Properties":{"id":"20240611152133-npmjhon","updated":"20240611152133"},"Children":[{"Type":"NodeText","Data":"修条尾似。黠鼠奔。黄深北塞。黔杂西原。枯飘利表。坚实滋源。督邮耐苦。决躁疏烦。"}]},{"ID":"20240611152133-6jdaiu0","Type":"NodeParagraph","Properties":{"id":"20240611152133-6jdaiu0","updated":"20240611152133"},"Children":[{"Type":"NodeText","Data":"陶弘景曰。一名鼠尾芩。苏恭曰。一名尾芩。李时珍曰。子芩新根。今谓之条芩。或言北芩深黄。西芩色黔。黔乃黄黑之色也。易林。沙漠北塞。岑参诗。西原驿路挂城头。李杲曰。黄芩之中枯而飘者。利气消痰。清肌表之热。实而坚者。养阴退阳。泻火补水。滋其化源。记事珠。一名苦督邮。易。震为决躁。中论。疏烦以理之。"}]},{"ID":"20240611152120-x99gi0o","Type":"NodeThematicBreak","Properties":{"id":"20240611152120-x99gi0o"}},{"ID":"20240611152121-138emh9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152121-138emh9","updated":"20240611152126"},"Children":[{"Type":"NodeText","Data":"黄芩《本经逢原》"}]},{"ID":"20240611152121-7cym3uy","Type":"NodeParagraph","Properties":{"id":"20240611152121-7cym3uy","updated":"20240611152121"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。中空者为枯芩入肺，细实者为子芩入大肠，并煮熟酒炒用。"}]},{"ID":"20240611152121-g2dbtal","Type":"NodeParagraph","Properties":{"id":"20240611152121-g2dbtal","updated":"20240611152121"},"Children":[{"Type":"NodeText","Data":"《本经》主诸热黄瘅，肠 泄利，逐水下血闭，治恶疮疽，蚀火疡。"}]},{"ID":"20240611152121-ojfg7au","Type":"NodeParagraph","Properties":{"id":"20240611152121-ojfg7au","updated":"20240611152127"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明 "},{"Type":"NodeText","Data":"黄芩苦燥而坚肠胃，故湿热黄瘅、肠 泻痢为必用之药。其枯芩性升，入手太阴经，清肌表之热。条芩性降，泻肝胆大肠之火，除胃中热。得酒炒上行，主膈上诸热。得芍药、甘草治下痢脓血、腹痛后重、身热。佐黄连治诸疮痛不可忍。同黑参治喉间腥臭。助白术安胎，盖黄芩能清热凉血，白术能补脾统血也。此惟胎热升动不宁者宜之；胎寒下坠及食少便溏者，慎勿混用。丹溪言黄芩治三焦火。仲景治伤寒少阳证，用小柴胡汤。汗下不解，胸满心烦用柴胡桂姜汤。温病用黄芩汤。太阳少阳合病用葛根黄芩黄连汤。心下痞满用泻心汤。寒格吐逆用干姜黄芩黄连人参汤等方，皆用黄芩以治表里诸热，使邪从小肠而泄，皆《本经》主诸热之纲旨。其黄瘅肠 泻痢之治，取苦寒以去湿热也。逐水下血闭者，火郁血热之所致，火降则邪行，水下血闭自通矣。昔人以柴胡去热不及黄芩，盖柴胡专主少阳往来寒热，少阳为枢，非柴胡不能宣通中外。黄芩专主阳明蒸热，阳明居中，非黄芩不能开泄蕴隆。一主风木客邪，一主湿土蕴着，讵可混论。芩虽苦寒，毕竟治标之药，惟躯壳热者宜之。若阴虚伏热，虚阳发露可轻试乎。其条实者兼行冲脉，治血热妄行。古方有一味子芩丸，治妇人血热，经水暴下不止者最效。若血虚发热，肾虚挟寒，及妊娠胎寒下坠，脉迟小弱皆不可用，以其苦寒而伐生发之气也。"}]},{"ID":"20240611152029-k2ul2gb","Type":"NodeThematicBreak","Properties":{"id":"20240611152029-k2ul2gb"}},{"ID":"20240611152031-yuboolg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611152031-yuboolg","updated":"20240611152037"},"Children":[{"Type":"NodeText","Data":"黄芩《本草便读》"}]},{"ID":"20240611152031-e2hxos1","Type":"NodeParagraph","Properties":{"id":"20240611152031-e2hxos1","updated":"20240611152031"},"Children":[{"Type":"NodeText","Data":"苦入心脾．坚肠胃而性燥．寒行肝肺．除湿热之功多．质虚而空者为枯芩．上达可治心肺肌表之郁火．色青而坚者为条芩．下行能除肝胆肠内之阳邪．同白术可以安胎．火退则胎安之义．合白芍又堪止痢．热除有痢愈之机．（黄芩处处山原皆有之．其根中心皆腐去．故外虽黄而内带黑色．均为之枯芩片芩．惟条芩子芩．系新发之根．中实有心．而兼青色．虽有治上治下之不同．毕竟苦寒性燥之品．伤脾败胃．非上中有湿热邪火者．不可乱用．况又有久而增气之说乎．黄芩之苦寒性燥．固与黄连相似．而黄连味浓．黄芩味薄．黄芩能入肝肺．行肌表．黄连则不能．固所禀形色气质不同．故主治亦异耳．）"}]},{"ID":"20240611151757-89xskyq","Type":"NodeThematicBreak","Properties":{"id":"20240611151757-89xskyq"}},{"ID":"20240611151758-8m1oda0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151758-8m1oda0","updated":"20240611151819"},"Children":[{"Type":"NodeText","Data":"黄芩《本草新编》"}]},{"ID":"20240611151758-svjr22c","Type":"NodeParagraph","Properties":{"id":"20240611151758-svjr22c","updated":"20240611151758"},"Children":[{"Type":"NodeText","Data":"黄芩，味苦，气平，性寒，可升可降，阴中微阳，无毒。入肺经、大肠。退热除烦，泻膀胱之火，止赤痢，消赤眼，善安胎气，解伤寒郁蒸，润燥，益肺气。但可为臣使，而不可为君药。近人最喜用之，然亦必肺与大肠、膀胱之有火者，用之始宜，否则，不可频用也。古人云黄芩乃安胎之圣药，亦因胎中有火，故用之于白术、归身、人参、熟地、杜仲之中，自然胎安。倘无火，而寒虚胎动，正恐得黄芩而反助其寒，虽有参、归等药补气、补血、补阴，未必胎气之能固也，况不用参、归等药，欲望其安胎，万无是理矣。"}]},{"ID":"20240611151758-hznlxo4","Type":"NodeParagraph","Properties":{"id":"20240611151758-hznlxo4","updated":"20240611151758"},"Children":[{"Type":"NodeText","Data":"或问黄芩清肺之品也，肺经之热，必须用之，然亦有肺热用黄芩而转甚者，何也？曰∶用黄芩以清肺热，此正治之法也。正治者，治肺经之实邪也。肺经有实邪，黄芩用之，可以解热；肺经有虚邪，黄芩用之，反足以增寒。盖实邪宜正治，而虚邪宜从治也。"}]},{"ID":"20240611151758-1h67iks","Type":"NodeParagraph","Properties":{"id":"20240611151758-1h67iks","updated":"20240611151758"},"Children":[{"Type":"NodeText","Data":"或问黄芩举世用而无疑，与用知母、黄柏颇相同，乃先生止咎用知母、黄柏之误，而不咎用黄芩，何也？曰∶黄芩亦非可久用之药，然其性寒而不大甚，但入于肺，而不入于肾。世人上热多，而下热者实少，清上热，正所以救下寒也。虽多用久用，亦有损于胃，然肾经未伤，本实不拨，一用温补，便易还原，其弊尚不至于杀人。若知母、黄柏泻肾中之火矣，肾火消亡，脾胃必无生气，下愈寒而上愈热，本欲救阴虚火动，谁知反愈增其火哉。下火无根，上火必灭，欲不成阴寒世界得乎。此用黄柏、知母之必宜辟也。"}]},{"ID":"20240611151758-n838334","Type":"NodeParagraph","Properties":{"id":"20240611151758-n838334","updated":"20240611151758"},"Children":[{"Type":"NodeText","Data":"或问黄芩乃清肺之药，肺气热，则肾水不能生，用黄芩以清肺金，正所以生肾水乎？曰∶黄芩但能清肺中之金，安能生肾中之水。夫肺虽为肾经之母，肺处于上游，居高润下，理之常也，何以清金而不能生水。盖肺中之火乃邪火，而非真火也，黄芩止清肺之邪火耳，邪火散而真水自生，安在不可下生肾水。不知肾水之生，必得真火之养，黄芩能泻邪火，而不能生真火，此所以不能生肾水也。予之取黄芩者，取其暂用以全金，非取其久用以益水。"}]},{"ID":"20240611151758-4bd9pqd","Type":"NodeParagraph","Properties":{"id":"20240611151758-4bd9pqd","updated":"20240611151758"},"Children":[{"Type":"NodeText","Data":"或疑黄芩之寒凉，不及黄柏、知母，以黄芩味轻，而性又善散，吾子攻黄柏、知母宜也，并及黄芩，毋乃过乎？曰∶黄芩之多用，祸不及黄柏、知母远甚，余未尝有过责之辞，独是攻击知母、黄柏，在于黄芩门下而畅论之，似乎并及黄芩矣。谁知借黄芩以论黄柏、知母，意重在黄柏、知母也。见黄芩之不宜多用，益知黄柏、知母之不可重用矣。世重寒凉，病深肺腑，不如此，又何以救援哉。"}]},{"ID":"20240611151833-21c3vxe","Type":"NodeThematicBreak","Properties":{"id":"20240611151833-21c3vxe"}},{"ID":"20240611151834-nf4t13o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151834-nf4t13o","updated":"20240611151840"},"Children":[{"Type":"NodeText","Data":"黄芩《本草述钩元》"}]},{"ID":"20240611151834-fulnsa8","Type":"NodeParagraph","Properties":{"id":"20240611151834-fulnsa8","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"圆者名子芩。新根内实。其直者条芩。破者名宿芩。乃旧根。中空外黄内黝。即今片芩。"}]},{"ID":"20240611151834-xvot1qm","Type":"NodeParagraph","Properties":{"id":"20240611151834-xvot1qm","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"气寒。味苦平。可升可降。阳中阴也。入手太阴气分。并入手少阴少阳太阳阳明经。亦入足少阳经。本经治诸热黄胆。肠泻痢。逐水。下血闭。恶疮疽蚀火疡。（凡诸疮痛不可忍者。宜芩连苦寒之药。详上下。分身梢及引经药用之。）泻肺火。清上部。除天表风热。"}]},{"ID":"20240611151834-wfhno01","Type":"NodeParagraph","Properties":{"id":"20240611151834-wfhno01","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"皮肤间风热风湿。目中赤肿。利胸中气。消上膈痰热。及头痛。并火逆肺咳肺痿喉腥。并失血证，瘀血壅盛。非此不除。上部积血。假之消散。（上行用酒炒）疗热毒骨蒸。（肺主气。"}]},{"ID":"20240611151834-qxqdj1h","Type":"NodeParagraph","Properties":{"id":"20240611151834-qxqdj1h","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"终始三焦。三焦以肾与膀胱为气之资始。故有热毒骨蒸之证治也。）寒热往来。除脾经诸湿。"}]},{"ID":"20240611151834-7y7o53l","Type":"NodeParagraph","Properties":{"id":"20240611151834-7y7o53l","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"胃中热。肠胃不利。小腹挟热痛。利小肠。益膀胱寒水。愈五淋。及女子血闭淋露。下血安胎。（能降上中二焦之火使之下行故也）产后养阴退阳。（诸本草）中空而烂者名腐阳。泻肺受火邪气逆。消膈上痰热。及胃中湿热黄胆。中破而飘者名宿芩。泻肺利气。除时行风湿。"}]},{"ID":"20240611151834-1xak9vt","Type":"NodeParagraph","Properties":{"id":"20240611151834-1xak9vt","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"热邪在表。寒热往来。诸疮乳痈背发。疔肿火疡。用之排脓。一切上部湿热。痰热积血。假此降散。细实直而坚者名条芩。泻大肠火。逐水消谷。止热泻。下痢脓血。腹痛后重。养阴退阳。圆而坚者子芩。去膀胱热。利小肠。治五淋小腹绞痛。及女子血闭下血。（门）肺主气。热伤气。故身体麻木。又五臭入肺为腥。黄芩之苦寒。能泻火补气而利肺。故治喉中辛臭。（天益）骨蒸发热。肤如火燎。六脉浮洪。烦躁引饮而昼盛者。此气分热也。宜泻肺。"}]},{"ID":"20240611151834-ncv6b3o","Type":"NodeParagraph","Properties":{"id":"20240611151834-ncv6b3o","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"用一味黄芩汤。片芩一两。水二钟。煎一钟。顿服愈。（濒湖）片芩泻肺火。须用桑白皮佐之。若肺虚者。多用则伤肺。必先以天冬保定肺气而后用之。（丹溪）得川芎调。平心血。"}]},{"ID":"20240611151834-zpy72x9","Type":"NodeParagraph","Properties":{"id":"20240611151834-zpy72x9","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"心平而热自退。血不妄行。得白术。为安胎圣药。俗以黄芩为寒而不敢用。不知胎孕宜清热凉血。血不妄行。乃得养胎。（丹溪）下痢脓血。腹痛后重。身热久不能止者。与芍药甘草同用之。（洁古）风热有痰。眉眶作痛。用酒浸黄芩同白芷天麻等分。为末。每服二钱。茶调下。同芍药炙草黄连升麻防风车前子。治湿热作泄。腹痛。同芍药黄连炙草升麻滑石。治滞下腹痛。同芍药麦冬白术。能安胎清热。"}]},{"ID":"20240611151834-71naabz","Type":"NodeParagraph","Properties":{"id":"20240611151834-71naabz","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"〔论〕罗天益云。肺主气。热伤气。黄芩能泻火益气而利肺。则其为肺经气分药无疑。"}]},{"ID":"20240611151834-jxo9wu3","Type":"NodeParagraph","Properties":{"id":"20240611151834-jxo9wu3","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"本经首言治诸热。是举其功之大概也。次即承以黄胆肠泄痢。是就诸热之中。举其病于湿热者而言也。又次承以逐水下血闭。则其功专于湿热明矣。第湿热与气分之热。是一是二欤。"}]},{"ID":"20240611151834-1dx7o77","Type":"NodeParagraph","Properties":{"id":"20240611151834-1dx7o77","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"曰。黄芩专主上焦之阳。阳中之阴药也。人生阴阳生化之机。在下焦阴中有阳而气生。在上焦阳中有阴而气化。使阳不得阴以化。则热能化湿。是湿热之治。正气化之所以得行耳。惟从阳实之初证而言。则为气分之热。从阳实阴虚以致气不能化之后证而言。则为湿热。虽治稍有别。而其病于气者。无二义也。大抵肺热除。则肺阴下降入心。以和于孕坎之离。膻中（心主之宫城）之气自降而入胃。以和胃阳而与脾阴表里。手太阳小肠。心之腑也。固与肺同司上焦之气化者。即皆相因以及之。是黄芩治肺气分之热为专功。而大肠即次之。清心胃之热则由肺而及。（未有肺热而心胃能清者）利小肠膀胱。又由心胃之治而及也。（未有心胃留热而血能和。血不和而水道能清者。）能治心胃小肠。则并入血分而治血。盖肺阴下降于心胃。即气之所以化血者。（心主血。而胃阳合于脾阴。鼓煽阴阳。即其使液化血者也。又小肠为气化之腑。心胃因肺阴降而气中之血赖以资生。能生即能化。小肠之气化。即资之以行。如所治上部瘀积。及女子血闭淋露下血。固皆气化之自应者。盖阳中阴化。而气化乃行。"}]},{"ID":"20240611151834-lhupu8q","Type":"NodeParagraph","Properties":{"id":"20240611151834-lhupu8q","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"气化行而水道乃畅。水与血是二是一。斯义固可参也。其又能疗失血诸证者。总因阴得育于阳中耳。）又足三阴并至于肺。肺阴下降。即是还返其真阴之元。故能滋化原而补膀胱寒水。但此味惟治三焦之实热。若三焦火郁而为病。则以升为治。不宜投苦寒降剂。即肺热属气虚者。亦未可妄投。以气属阳。阳主升。若奉上者微而反降之。是虚其虚也。（是以老人慎用）夫人身湿热之症。类居强半。芩与连虽俱治湿热。而黄芩治由热而化湿者。黄连则治由湿而化热者。内经谓治病必求其本。是芩连两味未可滚同而施用也。至于芩之治湿热。又云疗风湿者。以其味苦寒而色乃黄。本由胃至肺之用。且黄中有绿。实寓震坤相见妙理。合于由胃至肺。而肝实达之。（后天之气。本于胃中谷气以至肺。而谷气能合于膻中宗气以至肺者。乃属于肝。此正所谓元气。胃气。风升之气。合而为一者。）又虽苦多甘少。实则自苦归甘。胃资于肝。举其苦寒者。上而效用于肺。以清其气分之热。是在中土中而有风木之用。"}]},{"ID":"20240611151834-kvfl21r","Type":"NodeParagraph","Properties":{"id":"20240611151834-kvfl21r","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"故谓其能除表热。又曰除风热。且曰除风湿也。试参小柴胡汤之除寒热。芩岂专属胆药者。"}]},{"ID":"20240611151834-w1prhnw","Type":"NodeParagraph","Properties":{"id":"20240611151834-w1prhnw","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"固为胆之至于胃以上达肺者。热郁而不清耳。肝胆清热之剂。须分气血。如栀子为血分药。"}]},{"ID":"20240611151834-05m15b1","Type":"NodeParagraph","Properties":{"id":"20240611151834-05m15b1","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"入厥阴肝。薛立斋每同丹皮用之。犹黄芩之入胆而并柴胡。其义正可相参尔。"}]},{"ID":"20240611151834-jpw63x7","Type":"NodeParagraph","Properties":{"id":"20240611151834-jpw63x7","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"缪氏云。能损胃气而伤脾阴。脾肺虚热者忌。凡中寒泄泻腹痛。法并禁用。"}]},{"ID":"20240611151834-jgtopmn","Type":"NodeParagraph","Properties":{"id":"20240611151834-jgtopmn","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"〔修治〕寻常生用。或水炒去寒性亦可。上行。酒浸切炒。下行。便浸炒。除肝胆火。"}]},{"ID":"20240611151834-sq0ofr9","Type":"NodeParagraph","Properties":{"id":"20240611151834-sq0ofr9","updated":"20240611151834"},"Children":[{"Type":"NodeText","Data":"猪胆汁拌炒。更有用吴萸制芩者。欲其入肝散滞火也。"}]},{"ID":"20240611151722-sv2tj2u","Type":"NodeThematicBreak","Properties":{"id":"20240611151722-sv2tj2u"}},{"ID":"20240611151724-2v4w2n1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151724-2v4w2n1","updated":"20240611151728"},"Children":[{"Type":"NodeText","Data":"黄芩《本草经集注》"}]},{"ID":"20240611151724-8x4ox23","Type":"NodeParagraph","Properties":{"id":"20240611151724-8x4ox23","updated":"20240611151724"},"Children":[{"Type":"NodeText","Data":"味苦，平、大寒，无毒。主治诸热，黄胆，肠 泄痢，逐水，下血闭，恶疮。疽蚀，火伤。治痰热，胃中热，小腹绞痛，消谷，利小肠，女子血闭、淋露、下血，小儿腹痛。一名腐肠，一名空肠，一名内虚，一名黄文，一名经芩，一名妒妇。其子∶主肠 脓血。生秭归川谷及冤句。三月三日采根，阴干。（得浓朴、黄连止腹痛。得五味子、牡蒙、牡蛎，令人有子。得黄 、白蔹、赤小豆治鼠 。山茱萸、龙骨为之使，恶葱实，畏丹参、牡丹、藜芦。）"}]},{"ID":"20240611151724-6ucw892","Type":"NodeParagraph","Properties":{"id":"20240611151724-6ucw892","updated":"20240611151724"},"Children":[{"Type":"NodeText","Data":"秭归属建平郡。今第一出彭城，郁州亦有之。圆者名子芩为胜。破者名宿芩，其腹中皆烂，故名腐肠，惟取深色坚实者为好。世方多用，道家不须。"}]},{"ID":"20240611151652-i89csx0","Type":"NodeThematicBreak","Properties":{"id":"20240611151652-i89csx0"}},{"ID":"20240611151703-gazr2qz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151703-gazr2qz","updated":"20240611151707"},"Children":[{"Type":"NodeText","Data":"黄芩《新修本草》"}]},{"ID":"20240611151703-qbfrha0","Type":"NodeParagraph","Properties":{"id":"20240611151703-qbfrha0","updated":"20240611151703"},"Children":[{"Type":"NodeText","Data":"味苦，平、大寒，无毒。主诸热黄胆，肠 泄痢，逐水，下血闭，恶疮，疽蚀，火伤。"}]},{"ID":"20240611151703-fxmq4wo","Type":"NodeParagraph","Properties":{"id":"20240611151703-fxmq4wo","updated":"20240611151703"},"Children":[{"Type":"NodeText","Data":"疗痰热，胃中热，小腹绞痛，消谷，利小肠，女子血闭、淋露、下血，小儿腹痛。一名腐肠，一黄文，一名经芩，一名妒妇。"}]},{"ID":"20240611151703-ifhm6qi","Type":"NodeParagraph","Properties":{"id":"20240611151703-ifhm6qi","updated":"20240611151703"},"Children":[{"Type":"NodeText","Data":"其子主肠 脓血。生秭归川谷及宛朐。三月三日采根，阴干。"}]},{"ID":"20240611151703-9fluaa3","Type":"NodeParagraph","Properties":{"id":"20240611151703-9fluaa3","updated":"20240611151703"},"Children":[{"Type":"NodeText","Data":"得浓朴、黄连止腹痛；得五味子、牡蒙、牡蛎，令人有子；得黄 、白蔹、赤小豆疗鼠；山茱萸、龙骨为之使，恶葱实，畏丹砂、牡丹、藜芦。 秭归属建平郡。今第一出彭城，郁为胜。破者名宿芩，其腹中皆烂，故名腐肠，惟取深色坚实者为好。俗〔谨案〕叶细长，两叶相对，作丛生，亦有独茎者。"}]},{"ID":"20240611151703-7aswyxq","Type":"NodeParagraph","Properties":{"id":"20240611151703-7aswyxq","updated":"20240611151703"},"Children":[{"Type":"NodeText","Data":"今出宜州、 州、泾州者佳，兖州者大实亦好，名豚尾芩也。"}]},{"ID":"20240611151652-amxj3j1","Type":"NodeThematicBreak","Properties":{"id":"20240611151652-amxj3j1"}},{"ID":"20240611151653-5kdun89","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151653-5kdun89","updated":"20240611151658"},"Children":[{"Type":"NodeText","Data":"黄芩《本草崇原》"}]},{"ID":"20240611151653-oqv2hh0","Type":"NodeParagraph","Properties":{"id":"20240611151653-oqv2hh0","updated":"20240611151653"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治诸热，黄胆，肠 ，泄痢，逐水，下血闭，恶疮，疽蚀，火疡。"}]},{"ID":"20240611151653-r1env86","Type":"NodeParagraph","Properties":{"id":"20240611151653-r1env86","updated":"20240611151653"},"Children":[{"Type":"NodeText","Data":"（黄芩《本经》名腐肠，又名空肠，又名妒妇，谓外皮肉，而内空腐，妒妇心黯，黄芩心黑同也。出川蜀及陕西河东，近道皆有。芩者黔也，黑色也。其根黑而黄，故曰黄芩。）"}]},{"ID":"20240611151653-56lw3c4","Type":"NodeParagraph","Properties":{"id":"20240611151653-56lw3c4","updated":"20240611151653"},"Children":[{"Type":"NodeText","Data":"黄芩色黄内空，能清肠胃之热，外肌皮而性寒，能清肌表之热，乃手足阳明兼手太阴之药也。主治诸热黄胆，肠 泄痢者，言诸经之热，归于胃土而为黄胆，归于大肠而为泄痢。黄芩中空，主清肠胃之热，故能治之。肠胃受浊，得肺气通调，则水津四布，血气营运，逐水下血闭者，黄芩外肌皮而清肌表。肌表清，则肺气和，而留水可逐，血闭自下矣。火热之气留于肌肉皮肤，则为恶疮疽蚀。恶疮疽蚀名曰火疡。黄芩治之，清肌表也。"}]},{"ID":"20240611151511-2lb22dx","Type":"NodeThematicBreak","Properties":{"id":"20240611151511-2lb22dx"}},{"ID":"20240611151642-qv72dvd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151642-qv72dvd","updated":"20240611151647"},"Children":[{"Type":"NodeText","Data":"黄芩《本草求真》"}]},{"ID":"20240611151642-ckhqq99","Type":"NodeParagraph","Properties":{"id":"20240611151642-ckhqq99","updated":"20240611151642"},"Children":[{"Type":"NodeText","Data":"（山草）清上中二焦火热与湿"}]},{"ID":"20240611151642-pyo8dci","Type":"NodeParagraph","Properties":{"id":"20240611151642-pyo8dci","updated":"20240611151642"},"Children":[{"Type":"NodeText","Data":"黄芩（专入心脾肺。兼入肝大肠膀胱）。书载味苦入心。又载入肺。入脾除湿。入大肠以治肠 腹痛。（痢为肠 。凡痢有寒有热。痢属于热。则其形气坚强。脉必滑实有力。身则畏热喜冷。不欲衣被。渴则恣好冷水。愈凉愈快。随饮随消。小便热赤涩痛不堪。下痢纯红。痛则便硬拒按。并或头疼身热。筋骨酸痛。此其症之实者也。痢属于寒。则其形体薄弱。颜色清白。脉虽紧数。而无力无神。脉即真弦。而中虚似实。血则微红不鲜。及或杂有紫红紫白屋漏水形。所下之物。或浅黄色淡。不甚臭秽。痛则不实不坚。或喜揉按。或喜暖熨。或胸腹如饥而不欲食。或胃脘作呕而多吞酸。或数至圊欲出不出。或口虽渴而不欲饮冷。饮冷而不欲咽。此其症之虚者也。）入小肠膀胱以治淋闭。且治中焦实火。及邪在少阳胆经。得此以为清理。一药而上下表里皆治。其功力之泛涉。殆有难为专主者耳。不知内火冲激。外邪传入。皆能恣害。上如胸膈咽喉。下如肚腹二便。中如表里之所。阴阳之界。无不病症悉形。以故腹痛肠 。（痢）寒热往来。（疟）黄胆淋闭。胸高气喘。痈疽疮疡。火嗽喉腥。经闭胎漏。口渴津枯。一皆湿之所淫。热之所侵。火之所胜。（提出湿热与火。为诸病之要。）"}]},{"ID":"20240611151642-ctn2wic","Type":"NodeParagraph","Properties":{"id":"20240611151642-ctn2wic","updated":"20240611151642"},"Children":[{"Type":"NodeText","Data":"黄芩味苦性寒。枯而大者轻飘上升以清肺。肺清则痰自理矣。（汪昂曰。痰因火动。当先降火。）实而细者沉重下降以利便。便利则肠 自去。酒炒则膈热可除。而肝胆火熄。生用则实热堪投。而腹痛斯愈。（时珍曰。仲景治少阳症小柴胡汤。太阳少阳合病下痢黄芩汤。少阳症下后心下满而不痛泻心汤并用之。盖黄芩味苦气寒。色黄而绿。泻心火而除脾湿。俾金不受胃火上刑。故能救肺。少阳之症。虽曰病在半表半里。为胸胁痞满。实兼心肺上焦之邪。心烦喜呕。默默不欲饮食。又兼脾胃中焦之症。故用黄芩以治手足少阳相火。黄芩亦少阳本经药也。杨士瀛直指方云。柴胡退热。不及黄芩。盖亦不知柴胡之退热。乃苦以发之。散火之标也。黄芩之退热。乃寒能胜热。折火之本也。）且得白术砂仁以安胎。得浓朴黄连以除腹痛。得芍药以治痢。得柴胡以治寒热往来。此虽合上与下。表里皆治。而究止为上中二焦除热与湿之味矣。（东垣治肺热。身如火燎。烦燥引饮而昼盛者。宜一味黄芩汤以泻肺经气分之火。方用黄芩一两。）但肺虚腹痛属寒者切忌。（时珍曰。肺虚不宜者。苦寒伤脾胃。损其母也。）黄明者良。中虚者为枯芩。即片芩。内实者名条芩。即子芩。上行酒炒。泻肝胆火。猪胆汁炒。山药龙骨为使。畏丹皮丹砂。"}]},{"ID":"20240611151511-8f8c7rv","Type":"NodeThematicBreak","Properties":{"id":"20240611151511-8f8c7rv"}},{"ID":"20240611151628-ohezzub","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151628-ohezzub","updated":"20240611151638"},"Children":[{"Type":"NodeText","Data":"黄芩《神农本草经读》"}]},{"ID":"20240611151628-qeqio7q","Type":"NodeParagraph","Properties":{"id":"20240611151628-qeqio7q","updated":"20240611151628"},"Children":[{"Type":"NodeText","Data":"气味苦、寒、无毒。主诸热，黄胆，肠泄痢，逐水，下血闭，恶疮，疽蚀，火疡。"}]},{"ID":"20240611151628-jw55owk","Type":"NodeParagraph","Properties":{"id":"20240611151628-jw55owk","updated":"20240611151628"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶黄芩与黄连、黄柏皆气寒味苦而色黄，主治大略相似。大抵气寒皆能除热，味苦皆能燥湿，色黄者皆属于土，黄而明亮者则属于金，金借土之色以为色，故五金以黄金为贵也。但黄芩中空似肠胃，肠为手阳明，胃为足阳明。其主诸热者，指肠胃诸热病而言也。"}]},{"ID":"20240611151628-l23c2fv","Type":"NodeParagraph","Properties":{"id":"20240611151628-l23c2fv","updated":"20240611151628"},"Children":[{"Type":"NodeText","Data":"黄胆为大肠经中之郁热；肠泄痢者，为大肠腑中之郁热。逐水者，逐肠中之水。下血闭者，攻肠中之蓄血。恶疮疽蚀火疡者，为肌肉之热毒；阳明主肌肉，泻阳明之火即所以解毒也。"}]},{"ID":"20240611151628-mvjnlar","Type":"NodeParagraph","Properties":{"id":"20240611151628-mvjnlar","updated":"20240611151628"},"Children":[{"Type":"NodeText","Data":"《本经》之言主治如此，仲景于少阳经用之∶于心下悸易茯苓，于腹痛易芍药，又于《本经》言外别有会悟也。"}]},{"ID":"20240611151511-tv6qg7b","Type":"NodeThematicBreak","Properties":{"id":"20240611151511-tv6qg7b"}},{"ID":"20240611151513-c6n1u03","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151513-c6n1u03","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"《中国药典》：黄芩"}]},{"ID":"20240611151513-2p66jgw","Type":"NodeParagraph","Properties":{"id":"20240611151513-2p66jgw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611151513-s65addx","Type":"NodeParagraph","Properties":{"id":"20240611151513-s65addx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" Huánɡ Qín"}]},{"ID":"20240611151513-cv39phx","Type":"NodeParagraph","Properties":{"id":"20240611151513-cv39phx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611151513-r2tr602","Type":"NodeParagraph","Properties":{"id":"20240611151513-r2tr602","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 山茶根、黄芩茶、土金茶根"}]},{"ID":"20240611151513-c7o6en6","Type":"NodeParagraph","Properties":{"id":"20240611151513-c7o6en6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611151513-m5bblrg","Type":"NodeParagraph","Properties":{"id":"20240611151513-m5bblrg","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" RADIX SCUTELLARIAE"}]},{"ID":"20240611151513-efioliw","Type":"NodeParagraph","Properties":{"id":"20240611151513-efioliw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611151513-v2i82lf","Type":"NodeParagraph","Properties":{"id":"20240611151513-v2i82lf","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 本品为唇形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩"},{"Type":"NodeText","Data":"Scutellaria baicalensis Georgi的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去须根及泥沙，晒后撞去粗皮，晒干。"}]},{"ID":"20240611151513-bq5y3aj","Type":"NodeParagraph","Properties":{"id":"20240611151513-bq5y3aj","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611151513-379wucn","Type":"NodeParagraph","Properties":{"id":"20240611151513-379wucn","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 本品呈圆锥形，扭曲，长8～25cm，直径1～3cm。表面棕黄色或深黄色，有稀疏的疣状细根痕，上部较粗糙，有扭曲的纵皱或不规则的网纹，下部有顺纹和细皱。质硬而脆，易折断，断面黄色，中间红棕色；老根中心枯朽状或中空，呈暗棕色或棕黑色。气微，味苦。"}]},{"ID":"20240611151513-b0ne8h8","Type":"NodeParagraph","Properties":{"id":"20240611151513-b0ne8h8","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611151513-1vh3opq","Type":"NodeParagraph","Properties":{"id":"20240611151513-1vh3opq","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮。"}]},{"ID":"20240611151513-8d8nl94","Type":"NodeParagraph","Properties":{"id":"20240611151513-8d8nl94","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611151513-kcvbx4f","Type":"NodeParagraph","Properties":{"id":"20240611151513-kcvbx4f","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩片"},{"Type":"NodeText","Data":"：除去杂质，置沸水中煮10分钟，取出，闷透，切薄片，干燥；或蒸半小时，取出，切薄片，干燥（注意避免曝晒）。本品为类圆形或不规则形薄片，外表皮黄棕色至棕褐色，切面黄棕色或黄绿色，具放射状纹理。照上述[鉴别]（1）、（2）项下试验，应显相同的结果；照上述[含量测定]项下的方法测定，含黄芩苷（C21H18O11）不得少于8.0％。"}]},{"ID":"20240611151513-bx1y33y","Type":"NodeParagraph","Properties":{"id":"20240611151513-bx1y33y","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"酒黄芩：取黄芩片，照酒炙法（附录Ⅱ D）炒干。本品为类圆形或不规则形薄片，外表皮棕褐色，切面黄棕色，呈放射状纹理，略带焦斑，中心部分有的呈棕色。照上述[含量测定]项下的方法测定，含黄芩苷不得少于8.0％。"}]},{"ID":"20240611151513-pv6py7m","Type":"NodeParagraph","Properties":{"id":"20240611151513-pv6py7m","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611151513-vc6rt2i","Type":"NodeParagraph","Properties":{"id":"20240611151513-vc6rt2i","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末黄色。韧皮纤维单个散在或数个成束，梭形，长60～ 250μm，直径9～33μm，壁厚，孔沟细。石细胞类圆形、类方形或长方形，壁较厚或甚厚。木栓细胞棕黄色，多角形。网纹导管多见，直径24～72μm 。木纤维多碎断，直径约12μm ，有稀疏斜纹孔。淀粉粒甚多，单粒类球形，直径2～10μm，脐点明显，复粒由 2～3 分粒组成。"}]},{"ID":"20240611151513-814zcih","Type":"NodeParagraph","Properties":{"id":"20240611151513-814zcih","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末1g，加甲醇20ml，超声处理20分钟，滤过，滤液蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取黄芩对照药材1g，同法制成对照药材溶液。再取黄芩苷对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述三种溶液各5μl，分别点于同一以含4％醋酸钠的羧甲基纤维素钠溶液为黏合剂的硅胶G薄层板上，以醋酸乙酯-丁酮-甲酸-水（5:3:1:1）为展开剂，预平衡30分钟，展开，取出，晾干，喷以1％三氯化铁乙醇溶液。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点；在与对照品色谱相应的位置上，显一相同的暗绿色斑点。"}]},{"ID":"20240611151513-tfkl52g","Type":"NodeParagraph","Properties":{"id":"20240611151513-tfkl52g","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611151513-vp2lvp0","Type":"NodeParagraph","Properties":{"id":"20240611151513-vp2lvp0","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 归肺、胆、脾、大肠、小肠经。"}]},{"ID":"20240611151513-tuzdk30","Type":"NodeParagraph","Properties":{"id":"20240611151513-tuzdk30","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611151513-usrq4ud","Type":"NodeParagraph","Properties":{"id":"20240611151513-usrq4ud","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611151513-w230h06","Type":"NodeParagraph","Properties":{"id":"20240611151513-w230h06","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611151513-dw620t6","Type":"NodeParagraph","Properties":{"id":"20240611151513-dw620t6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，泻火解毒，止血，安胎。用于湿温、暑温胸闷呕恶，湿热痞满，泻痢，黄疸，肺热咳嗽，高热烦渴，血热吐衄，痈肿疮毒，胎动不安。"}]},{"ID":"20240611151513-mlt5dlz","Type":"NodeParagraph","Properties":{"id":"20240611151513-mlt5dlz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611151513-k68raet","Type":"NodeParagraph","Properties":{"id":"20240611151513-k68raet","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240611151513-qzc6nc9","Type":"NodeParagraph","Properties":{"id":"20240611151513-qzc6nc9","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611151513-83o6dfp","Type":"NodeParagraph","Properties":{"id":"20240611151513-83o6dfp","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" （1）无对湿温发热，可与滑石、白蔻仁、茯苓等配合应用；对湿热泻痢、腹痛，又常与白芍、葛根、甘草同用；对于湿热蕴结所致的黄疸，可与绵茵陈、栀子、淡竹叶等同用。治热病高热，常与黄连、山栀等配伍；治肺热咳嗽，可与知母、桑白皮等同用；治血热妄行，可与生地、丹皮、侧柏叶等同用；对热毒疮疡，可与银花、连翘等药同用。用于胎动不安，常与白朮、竹茹等配合应用。"}]},{"ID":"20240611151513-qc16tmz","Type":"NodeParagraph","Properties":{"id":"20240611151513-qc16tmz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611151513-mof4d2u","Type":"NodeParagraph","Properties":{"id":"20240611151513-mof4d2u","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611151513-ux9vkbl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151513-ux9vkbl","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：黄芩"}]},{"ID":"20240611151513-xhd2mn5","Type":"NodeParagraph","Properties":{"id":"20240611151513-xhd2mn5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611151513-puvac73","Type":"NodeParagraph","Properties":{"id":"20240611151513-puvac73","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" Huánɡ Qín"}]},{"ID":"20240611151513-fnxo3lm","Type":"NodeParagraph","Properties":{"id":"20240611151513-fnxo3lm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611151513-eg9auvj","Type":"NodeParagraph","Properties":{"id":"20240611151513-eg9auvj","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 腐肠（《本经》），黄文、虹胜、经芩、印头、内虚（《吴普本草》），空肠（《别录》），元芩、土金茶根（《东北药植志》）。"}]},{"ID":"20240611151513-jguxa6d","Type":"NodeParagraph","Properties":{"id":"20240611151513-jguxa6d","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611151513-jtclkgm","Type":"NodeParagraph","Properties":{"id":"20240611151513-jtclkgm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611151513-g1t045u","Type":"NodeParagraph","Properties":{"id":"20240611151513-g1t045u","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611151513-pidbvcm","Type":"NodeParagraph","Properties":{"id":"20240611151513-pidbvcm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 为唇形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄芩"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春季至夏初采收（秋季亦可）。选生长3～4年的植株。将根挖出后除去茎苗、须根及泥土，晒至半干时撞去栓皮，再晒至全干。"}]},{"ID":"20240611151513-vj2sxxz","Type":"NodeParagraph","Properties":{"id":"20240611151513-vj2sxxz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611151513-1p3p14e","Type":"NodeParagraph","Properties":{"id":"20240611151513-1p3p14e","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 生于草原、高燥砾质的山坡。分布黑龙江、吉林、辽宁、河北、河南、山东、四川、云南、山西、陕西、甘肃、内蒙古等地。"}]},{"ID":"20240611151513-b8n1p2u","Type":"NodeParagraph","Properties":{"id":"20240611151513-b8n1p2u","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611151513-fejbjua","Type":"NodeParagraph","Properties":{"id":"20240611151513-fejbjua","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 黄芩，又名：空心草、黄金茶。"}]},{"ID":"20240611151513-hpt7dng","Type":"NodeParagraph","Properties":{"id":"20240611151513-hpt7dng","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"多年生草本，主根长大，略呈圆锥状，外皮褐色。茎方形，高25～60厘米，基部多分歧，光滑或被短毛。叶对生，卵状披针形、披针形或线状披针形，长1.5～4.5厘米，宽3～12毫米，先端钝或急尖，基部圆形，全缘，具睫毛，上面光滑或被短毛，下面有腺点，光滑或仅在中肋有短毛；无柄或有短柄。总状花序脓生，花偏向一方；萼钟形，被白色长柔毛，先端5裂；花冠唇形，上唇比下唇长，筒状，上部膨大，基部甚细，紫色，长2～2.5厘米，表面被白色短柔毛；雄蕊4，2强；雌蕊1，子房4深裂，花柱基底着生。小坚果4，近圆形，黑色。花期7～8月。果期8～9月。"}]},{"ID":"20240611151513-70ph896","Type":"NodeParagraph","Properties":{"id":"20240611151513-70ph896","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611151513-00l8v4q","Type":"NodeParagraph","Properties":{"id":"20240611151513-00l8v4q","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 干燥根呈倒圆锥形，扭曲不直，长7～27厘米，径约1～2厦米。表面深黄色或黄棕色。上部皮较粗糙，有扭曲的纵皱纹或不规则的网纹，下部皮细，有顺纹或细皱纹，上下均有稀疏的疣状支根痕。质硬而脆，易折断；断面深黄色，中间有棕红色圆心。老根断面中央呈暗棕色或棕黑色朽片状，习称\"枯黄芩\"或\"枯芩\"；或因中空而不坚硬，呈劈破状者，习称\"黄芩瓣\"。根遇潮湿或冷水则变为黄绿色。无臭，味苦。以条粗长、质坚实、色黄、除净外皮者为佳。条短、质松、色深黄、成瓣状者质次。"}]},{"ID":"20240611151513-bmg5ef1","Type":"NodeParagraph","Properties":{"id":"20240611151513-bmg5ef1","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"主产河北、内蒙古、山西、山东、陕西等地。此外，辽宁、黑龙江亦产。"}]},{"ID":"20240611151513-fwluu3j","Type":"NodeParagraph","Properties":{"id":"20240611151513-fwluu3j","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"四川、云南所产的黄芩，为植物滇黄芩的根。药材外形相似，但较细，直径一般约0.5～1厘米，常有分枝，断面为极明显的黄绿色，质量较差。"}]},{"ID":"20240611151513-14qpl7g","Type":"NodeParagraph","Properties":{"id":"20240611151513-14qpl7g","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611151513-smvss4r","Type":"NodeParagraph","Properties":{"id":"20240611151513-smvss4r","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 黄芩毒性极低，煎剂给兔灌胃，醇提取液静脉注射，仅呈活动减弱，黄芩浸剂4克/公斤给狗灌胃8周，亦未见任何毒性反应，如将黄芩浸剂2克/公斤静脉注射于健康兔，先表现镇静，以后死亡，可见静脉注射比口服毒性大得多。黄芩提取物肌肉及静脉注射，可使正常家兔白细胞总数短时间内显着降低。"}]},{"ID":"20240611151513-hjrdlei","Type":"NodeParagraph","Properties":{"id":"20240611151513-hjrdlei","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611151513-xe45lkb","Type":"NodeParagraph","Properties":{"id":"20240611151513-xe45lkb","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 黄芩根含黄芩甙元、黄芩甙、汉黄芩素、汉黄芩甙和黄芩新素，还含苯甲酸、β-谷甾醇等。茎叶中含黄芩素甙。"}]},{"ID":"20240611151513-x733jvn","Type":"NodeParagraph","Properties":{"id":"20240611151513-x733jvn","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611151513-fyiqxdr","Type":"NodeParagraph","Properties":{"id":"20240611151513-fyiqxdr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" ①抗炎抗变态反应"}]},{"ID":"20240611151513-x5a2xrc","Type":"NodeParagraph","Properties":{"id":"20240611151513-x5a2xrc","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩甙、黄芩甙元对豚鼠寓体气管过敏性收缩及整体动物过敏性气喘，均有缓解作用，并与麻黄碱表现协同。甙元的磷酸钠盐较硫酸钠盐作用强，黄芩甙元能抑制离体气管及回肠之Sehultz-Dale反应，对豚鼠被动性皮肤过敏反应、组织胺皮肤反应亦表现抑制，在抗变态反应方面，甙元较甙作用强。黄芩此种抗变态反应，是由于伤害了肥大细胞的酶激活系统（SH-酶），抑制了过敏性介体的释放，因而不产生过敏反应，此外它对平滑肌本身，也有直接的松弛作用。黄芩甙元及黄芩甙均能抑制过敏性之浮肿及炎症，二者并能降低小鼠：耳毛细血管的通透性，后者尚能防止低气压引起的小白鼠肺出血。"}]},{"ID":"20240611151513-1ziv7gd","Type":"NodeParagraph","Properties":{"id":"20240611151513-1ziv7gd","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②抗微生物作用"}]},{"ID":"20240611151513-ai2qden","Type":"NodeParagraph","Properties":{"id":"20240611151513-ai2qden","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩有较广的抗菌谱，在试管内对痢疾杆菌、白喉杆菌、绿脓杆菌、葡萄球菌、链球菌、肺炎双球菌以及脑膜炎球菌等均有抑制作用，煎剂作喉头喷雾，对脑膜炎带菌者亦有效，即使对青霉素等抗菌素已产生抗药性的金黄色葡萄球菌，对黄芩仍属敏感。试管内对人型结核杆菌的抑制作用，报告不一致，煎剂对小白鼠实验性结核病有效，但对豚鼠则无效。试管内对流感病毒PR株有抑制作用，鼠痞染病毒后，能使之减轻肺部损伤和延长存活日期。对多种皮肤致病性真菌，体外亦有抑制效力，并能杀死钩端螺旋体。"}]},{"ID":"20240611151513-wi7sz7l","Type":"NodeParagraph","Properties":{"id":"20240611151513-wi7sz7l","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③解热作用"}]},{"ID":"20240611151513-tos3j2e","Type":"NodeParagraph","Properties":{"id":"20240611151513-tos3j2e","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"早年报告，对疫苗引起发热的家兔静脉注射6％黄芩浸剂4～6毫升，有解热作用，以后有人用大剂量黄芩水煎剂（比上述报告静脉注射黄芩浸剂之量大4～30倍）口服或肌肉住射均未能证实有解热作用，如静脉注射则有轻微解热作用，此情况与静脉注射生理盐水一样，黄芩5克/公斤亦不能使热穿刺法致热的家兔退热。但腹腔或静脉注射黄芩甙，口服黄芩煎剂，对疫苗或酵母致热的家兔均能解热。上述研究结果不一致，可能由于植物来源多未作生药学检定，品种混乱，粗制剂静脉注射影响血压，亦能干扰解热作用。因此黄芩是否有解热性质，有待进一步研究。黄芩提取物对正常家兔无降温作用。"}]},{"ID":"20240611151513-rij86kg","Type":"NodeParagraph","Properties":{"id":"20240611151513-rij86kg","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"④降压、利尿作用"}]},{"ID":"20240611151513-1e7f2da","Type":"NodeParagraph","Properties":{"id":"20240611151513-1e7f2da","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩酊剂、浸剂、煎剂、醇或水提取物、黄芩甙对麻醉犬、猫、兔静脉、肌肉注射或灌胃，均可引起降压作用。浸剂口服能降低正常及慢性肾性高血压犬的血压，酊剂可使神经性高血压犬血压回至正常。浸剂口服的降压作用，以云南产者为最佳，河北次之，西北的较差。黄芩的降压原理，一般认为系直接扩张血管，也可能作用于血管感受器，反射地引起降压。黄芩同属植物Scutellaria galericulata则无降压作用。"}]},{"ID":"20240611151513-9uduzfs","Type":"NodeParagraph","Properties":{"id":"20240611151513-9uduzfs","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"在急性利尿实验中，黄芩甙元作用最强，汉黄芩素次之，黄芩甙更差。黄芩醇提取物及煎剂（正常人及家兔）亦有利尿作用。"}]},{"ID":"20240611151513-xcld23e","Type":"NodeParagraph","Properties":{"id":"20240611151513-xcld23e","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑤对血脂及血糖的作用"}]},{"ID":"20240611151513-xoq5dqh","Type":"NodeParagraph","Properties":{"id":"20240611151513-xoq5dqh","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩及三黄制剂（黄连：黄芩：大黄为1：1：1）对正常家兔血清中总胆甾醇/总磷脂之比值无影响，但能降低饲养胆甾醇7周后家兔的此种比值，对切除甲状腺家兔的此种比值，三黄制剂亦能降低之。黄芩能使血糖轻度上升。"}]},{"ID":"20240611151513-swrv5q9","Type":"NodeParagraph","Properties":{"id":"20240611151513-swrv5q9","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑥和胆，解痉作用"}]},{"ID":"20240611151513-dxtk30t","Type":"NodeParagraph","Properties":{"id":"20240611151513-dxtk30t","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩煎剂和乙醇提取液可增加犬、兔胆汁排泄量，黄芩甙元较黄芩甙作用明显，汉黄芩素无影响；黄芩甙使结扎总输胆管的家兔在1～6小时内胆红素（较对照组）增高，但24～48小时后则使之降低。黄芩酊剂、煎剂对在位肠管有明显的抑制作用，酊剂可拮抗毛果芸香碱引起的肠管运动增强现象，切断迷走神经后并不影响其作用，用小白鼠小肠段进行解痉的效价测定，汉黄芩素只有弱的解痉作用，黄芩甙元则无解痉效力。"}]},{"ID":"20240611151513-ssf1bij","Type":"NodeParagraph","Properties":{"id":"20240611151513-ssf1bij","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑦镇静作用"}]},{"ID":"20240611151513-yqbeuld","Type":"NodeParagraph","Properties":{"id":"20240611151513-yqbeuld","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩甙能抑制小白鼠的自发活动，作用强度与剂量有关，黄芩煎剂可抑制小鼠阳性条件反射，此作用可能是由于它加强了皮层抑制过程所致，可用于神经兴奋性增高及失眠的高血压患者。"}]},{"ID":"20240611151513-lx63gc3","Type":"NodeParagraph","Properties":{"id":"20240611151513-lx63gc3","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑧其他作用"}]},{"ID":"20240611151513-vfl0b88","Type":"NodeParagraph","Properties":{"id":"20240611151513-vfl0b88","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"黄芩根茎的酊剂静脉注射，对士的宁中毒的蛙、猫、狗，可消除强直性痉挛的症状，并使动物免于死亡。黄芩甙、葡萄糖醛酸可降低小鼠士的宁中毒死亡率，前者10毫克就能提高其半数致死量约2.5倍。从测定四氯化碳中毒小鼠的肝糖元含量，以葡萄糖醛酸组含量较高，黄芩甙次之，黄芩甙元最低。"}]},{"ID":"20240611151513-i28q3e4","Type":"NodeParagraph","Properties":{"id":"20240611151513-i28q3e4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611151513-ye94ukd","Type":"NodeParagraph","Properties":{"id":"20240611151513-ye94ukd","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 黄芩：拣去杂质，除去残茎，用凉水浸润或置开水中稍浸捞出，润透后切片晒干（注意避免曝晒过度发红）。酒黄芩：取黄芩片喷淋黄酒，拌匀，用文火微炒，取出，晾干。（每黄芩100斤，用黄酒10～15斤）炒黄芩：取黄芩片用文火炒至表面微焦为度，取出，放凉。黄芩炭：取黄芩片用武火炒至表面焦褐色、边缘带黑色为度，但须存性，喷淋清水，取出，晒干。"}]},{"ID":"20240611151513-996ac5i","Type":"NodeParagraph","Properties":{"id":"20240611151513-996ac5i","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611151513-ben0wud","Type":"NodeParagraph","Properties":{"id":"20240611151513-ben0wud","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 入心、肺、胆、大肠经。"}]},{"ID":"20240611151513-p4j4f4y","Type":"NodeParagraph","Properties":{"id":"20240611151513-p4j4f4y","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"①《品汇精要》：\"行手太阴、阳明经。\""}]},{"ID":"20240611151513-mzhlsi5","Type":"NodeParagraph","Properties":{"id":"20240611151513-mzhlsi5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"入手少阴、阳明，手足太阴、少阳六经。\""}]},{"ID":"20240611151513-uc7fbmw","Type":"NodeParagraph","Properties":{"id":"20240611151513-uc7fbmw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入肺、大肠、膀胱、胆四经。\""}]},{"ID":"20240611151513-xrgzrbi","Type":"NodeParagraph","Properties":{"id":"20240611151513-xrgzrbi","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611151513-ekrfbae","Type":"NodeParagraph","Properties":{"id":"20240611151513-ekrfbae","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611151513-flatn4m","Type":"NodeParagraph","Properties":{"id":"20240611151513-flatn4m","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240611151513-hjmbq5z","Type":"NodeParagraph","Properties":{"id":"20240611151513-hjmbq5z","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"大寒，无毒。\""}]},{"ID":"20240611151513-wgw9f55","Type":"NodeParagraph","Properties":{"id":"20240611151513-wgw9f55","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦甘。\""}]},{"ID":"20240611151513-relvls3","Type":"NodeParagraph","Properties":{"id":"20240611151513-relvls3","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611151513-zuz3lgx","Type":"NodeParagraph","Properties":{"id":"20240611151513-zuz3lgx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" ①《药对》：\"山茱萸、龙骨为之使。恶葱实。畏丹砂、牡丹、藜芦。\""}]},{"ID":"20240611151513-y1i0xhv","Type":"NodeParagraph","Properties":{"id":"20240611151513-y1i0xhv","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"脾肺虚热者忌之。凡中寒作泄，中寒腹痛，肝肾虚而少腹痛，血虚腹痛，脾虚泄泻，肾虚溏泻，脾虚水肿，血枯经闭，气虚小水不利，肺受寒邪喘咳，及血虚胎不安，阴虚淋露，法并禁用。\""}]},{"ID":"20240611151513-cifkfyx","Type":"NodeParagraph","Properties":{"id":"20240611151513-cifkfyx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611151513-tn5k4vy","Type":"NodeParagraph","Properties":{"id":"20240611151513-tn5k4vy","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 泻实火，除湿热，止血，安胎。治壮热烦渴，肺热咳嗽，湿热泻痢，黄疸，热淋，吐、衄、崩、漏，目赤肿痛，胎动不安，痈肿疔疮。"}]},{"ID":"20240611151513-e1fvnqt","Type":"NodeParagraph","Properties":{"id":"20240611151513-e1fvnqt","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主诸热黄疸，肠澼，泄利，逐水，下血闭，（治）恶疮，疽蚀，火疡。\""}]},{"ID":"20240611151513-4mywwmc","Type":"NodeParagraph","Properties":{"id":"20240611151513-4mywwmc","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗痰热，胃中热，小腹绞痛，消谷，利小肠，女子血闭，淋露下血，小儿腹痛。\""}]},{"ID":"20240611151513-rimkpca","Type":"NodeParagraph","Properties":{"id":"20240611151513-rimkpca","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"治奔豚，脐下热痛。\""}]},{"ID":"20240611151513-gbhct3o","Type":"NodeParagraph","Properties":{"id":"20240611151513-gbhct3o","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"能治热毒，骨蒸，寒热往来，肠胃不利，破壅气，治五淋，令人宣畅，去关节烦闷，解热渴，治热腹中疞痛，心腹坚胀。\""}]},{"ID":"20240611151513-r4oxv7y","Type":"NodeParagraph","Properties":{"id":"20240611151513-r4oxv7y","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"下气，主天行热疾，疔疮，排脓。治乳痈，发背。\""}]},{"ID":"20240611151513-xz9o3xx","Type":"NodeParagraph","Properties":{"id":"20240611151513-xz9o3xx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"除阳有余，凉心去热，通寒格。\""}]},{"ID":"20240611151513-mz2rkc5","Type":"NodeParagraph","Properties":{"id":"20240611151513-mz2rkc5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑦李杲：\"治发热口苦。\""}]},{"ID":"20240611151513-ayqndyt","Type":"NodeParagraph","Properties":{"id":"20240611151513-ayqndyt","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑧《滇南本草》：\"上行泻肺火，下行泻膀胱火，（治）男子五淋，女子暴崩，调经清热，胎有火热不安，清胎热，除六经实火实热。\""}]},{"ID":"20240611151513-6nb637k","Type":"NodeParagraph","Properties":{"id":"20240611151513-6nb637k","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑨《纲目》：\"治风热湿热头疼，奔豚热痛，火咳，肺痿喉腥，诸失血。\""}]},{"ID":"20240611151513-c58bs8s","Type":"NodeParagraph","Properties":{"id":"20240611151513-c58bs8s","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑩《本草正》：\"枯者清上焦之火，消痰利气，定喘嗽，止失血，退往来寒热，风热湿热，头痛，解瘟疫，清咽，疗肺痿肺痈，乳痈发背，尤祛肌表之热，故治斑疹、鼠瘘，疮疡、赤眼；实者凉下焦之热，能除赤痢，热蓄膀胱，五淋涩痛，大肠闭结，便血、漏血。\""}]},{"ID":"20240611151513-mt7bxuf","Type":"NodeParagraph","Properties":{"id":"20240611151513-mt7bxuf","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑾《科学的民间药草》：\"外洗创口，有防腐作用。\""}]},{"ID":"20240611151513-zsdnmy0","Type":"NodeParagraph","Properties":{"id":"20240611151513-zsdnmy0","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611151513-grivdns","Type":"NodeParagraph","Properties":{"id":"20240611151513-grivdns","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。外用：煎水洗或研末撤。"}]},{"ID":"20240611151513-vcg4kwv","Type":"NodeParagraph","Properties":{"id":"20240611151513-vcg4kwv","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611151513-o0f76if","Type":"NodeParagraph","Properties":{"id":"20240611151513-o0f76if","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" ①治小儿心热惊啼：黄芩（去黑心）、人参各一分。捣罗为散。每服一字匕，竹叶汤调下，不拘时候服。（《圣济总录》黄芩散）"}]},{"ID":"20240611151513-ujv3prk","Type":"NodeParagraph","Properties":{"id":"20240611151513-ujv3prk","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②泻肺火，降膈上热痰：片子黄芩，炒，为末，糊丸，或蒸饼丸梧子大。服五十丸。（《丹溪心法》清金丸）"}]},{"ID":"20240611151513-5tane41","Type":"NodeParagraph","Properties":{"id":"20240611151513-5tane41","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③治慢性气管炎：黄芩、葶苈子各等分，共为细末，糖衣为片，每片含生药0.3克，每日三次，每次五片。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240611151513-83c8qzf","Type":"NodeParagraph","Properties":{"id":"20240611151513-83c8qzf","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"④治上呼吸道感染，肠炎：黄芩切碎，加四倍量水浸泡四小时，过滤残渣，再加二倍水浸泡两次，合并滤液，用20％明矾液倒入浸液中，调节pH为3.5（每100公斤黄芩，需明矾6～8公斤），产生黄色沉淀，静置四小时，弃去上层清液，将沉淀物装入布袋中加水过滤，烘干，粉碎，造粒打片。每次服二至三片。（辽宁《中草药新医疗法资料选编》）"}]},{"ID":"20240611151513-j4rtykz","Type":"NodeParagraph","Properties":{"id":"20240611151513-j4rtykz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑤治少阳头痛及太阳头痛，不拘偏正：片黄芩，酒浸透，晒干为末。每服一钱，茶、酒任下。（《兰室秘藏》小清空膏）"}]},{"ID":"20240611151513-qhc905e","Type":"NodeParagraph","Properties":{"id":"20240611151513-qhc905e","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑥治太阳与少阳合病，自下利者：黄芩三两，芍药二两，甘草二两（炙），大枣十二枚（擘）。上四味，以水一斗，煮取三升，去滓。温服一升，日再夜一服。（《伤寒论》黄芩汤）"}]},{"ID":"20240611151513-q1wd6c2","Type":"NodeParagraph","Properties":{"id":"20240611151513-q1wd6c2","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑦治淋，亦主下血：黄芩四两，细切，以水五升，煮取二升，分三服。（《千金翼方》）"}]},{"ID":"20240611151513-dbw1ea0","Type":"NodeParagraph","Properties":{"id":"20240611151513-dbw1ea0","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑧治吐血衄血，或发或止，皆心脏积热所致：黄芩一两（去心中黑腐），捣细罗为散。每服三钱，以水一中盏，煎至六分。不计时候，和滓温服。（《圣惠方》黄芩散）"}]},{"ID":"20240611151513-b9gh0x6","Type":"NodeParagraph","Properties":{"id":"20240611151513-b9gh0x6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑨治崩中下血：黄芩，为细末。每服一钱，烧秤锤淬酒调下。（《本事方》）"}]},{"ID":"20240611151513-ang4qwo","Type":"NodeParagraph","Properties":{"id":"20240611151513-ang4qwo","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑩治妇人四十九岁已后，天癸却行，或过多不止：黄芩心枝条者二两（重用米醋，浸七日，炙干，又浸又炙，如此七次）。为细末，醋糊为丸，如梧桐子大。每服七十丸，空心温酒送下，日进二服。（《瑞竹堂经验方》芩心丸）"}]},{"ID":"20240611151513-959mife","Type":"NodeParagraph","Properties":{"id":"20240611151513-959mife","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑾安胎：白术、黄芩、炒曲。上为末，粥丸，服。（《丹溪心法》）"}]},{"ID":"20240611151513-awo4gri","Type":"NodeParagraph","Properties":{"id":"20240611151513-awo4gri","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑿治肝热生翳，不拘大Z’bJL：黄芩一两，淡豉三两，为末。每服三钱，以热猪肝襄吃，温扬送下，日二撮。忌酒，面。（（卫生家宝方））"}]},{"ID":"20240611151513-rgc6e2r","Type":"NodeParagraph","Properties":{"id":"20240611151513-rgc6e2r","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⒀治眉眶痛，属风热与痰：黄芩（酒漫，炒）、白芷。上为末，茶清调二钱。（（丹溪心法））"}]},{"ID":"20240611151513-gc17oyn","Type":"NodeParagraph","Properties":{"id":"20240611151513-gc17oyn","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⒁治灸疮血出：酒炒黄芩二钱。为末，酒服。（（怪证奇方》）"}]},{"ID":"20240611151513-m8q80fq","Type":"NodeParagraph","Properties":{"id":"20240611151513-m8q80fq","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⒂治火丹：杵黄芩末，水调敷之。（（G阴沸验方））"}]},{"ID":"20240611151513-jl07rv5","Type":"NodeParagraph","Properties":{"id":"20240611151513-jl07rv5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⒃治产后血渴，饮水不止：黄芩（新瓦上焙干）、麦门冬（去心）各半两。上件，细切。每服三钱，水一盏半，煎至八分，去滓温服，不拘时候。（倘氏家藏方）"}]},{"ID":"20240611151513-em1x2e1","Type":"NodeParagraph","Properties":{"id":"20240611151513-em1x2e1","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611151513-jdmnijn","Type":"NodeParagraph","Properties":{"id":"20240611151513-jdmnijn","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" ①治疗小儿急性呼吸道感染"}]},{"ID":"20240611151513-2kp9zbt","Type":"NodeParagraph","Properties":{"id":"20240611151513-2kp9zbt","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"用50％黄芩煎液，1岁以下每天6毫升，1岁以上8～10毫升，5岁以上酌加，皆分3次服。经治急性上呼吸道感染51例，急性支气管炎11例，急性扁桃体炎1例。治后体温降至正常、症状消失者51例，无效12例。体温多在3天内恢复正常，症状消失多为4天。"}]},{"ID":"20240611151513-kuq0rqc","Type":"NodeParagraph","Properties":{"id":"20240611151513-kuq0rqc","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②治疗慢性气管炎"}]},{"ID":"20240611151513-qemwa1a","Type":"NodeParagraph","Properties":{"id":"20240611151513-qemwa1a","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"取黄芩1斤，甘草0.5斤，加水煎煮2次，得煎液3斤；另取生石灰1斤，加冷开水10斤，搅拌浸泡静置24小时，取上清液8斤。将煎液缓缓加入石灰水中，边加边搅拌，至pH呈7～8为止。每次20～25毫升，日服3次。治疗35例，临床治愈2例，显效16例。对单纯型疗效较好。"}]},{"ID":"20240611151513-0ygf5pw","Type":"NodeParagraph","Properties":{"id":"20240611151513-0ygf5pw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③治疗急性菌痢"}]},{"ID":"20240611151513-0dsna3n","Type":"NodeParagraph","Properties":{"id":"20240611151513-0dsna3n","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"取黄芩、诃子等量，以明矾沉淀法提制成粉。每次2克，日服4次，小儿酌减。对症治疗：失水者补液，高热者配合解热剂。治疗100例，平均2.5天症状消失，3.3天大便镜检正常，4.3天大便培养转阴，5.3天临床治愈。"}]},{"ID":"20240611151513-vpaffdm","Type":"NodeParagraph","Properties":{"id":"20240611151513-vpaffdm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"④治疗钩端螺旋体病"}]},{"ID":"20240611151513-c562xho","Type":"NodeParagraph","Properties":{"id":"20240611151513-c562xho","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"取黄芩、银花、连翘等量，分别制成黄芩素及银花、连翘浸膏，混合制成片剂，每片重0.5克，相当于生药3.7克。每次10～15片，6小时服1次，小儿酌减。共治65例，其中一个地区收治59例，治愈58例；另一地区收治6例，失败4例，疗效差异甚大，原因有待研究。有效病例服药后，开始降温时间平均为7.5小时，体温恢复正常时间平均为1.8天，临床症状和体征大多在2～5天内减轻或消失。以对中、轻度病人疗效较好，退热较快，对重度晚期病人退热较慢，疗效较差。服药期间未见严重毒性反应，仅少数病例有轻微恶心、呕吐及腹泻现象，停药后即可消失。"}]},{"ID":"20240611151513-7kjzdho","Type":"NodeParagraph","Properties":{"id":"20240611151513-7kjzdho","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑤治疗传染性肝炎"}]},{"ID":"20240611151513-x267gnr","Type":"NodeParagraph","Properties":{"id":"20240611151513-x267gnr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"将黄芩的提取物-黄芩素装胶囊，每粒0.25克。每次2粒，日服3次，儿童酌减。治疗急性传染性肝炎27例，自觉症状和体征均于1月内消失，肝功能恢复正常。其中治疗半月，谷丙转氨酶即降至正常者占74.1％。亦有用黄芩素针剂，每日肌注2毫升（含黄芩素40毫克），1个月为一疗程，治疗急性无黄疸型肝炎13例，基本治愈4例，显效1例，有效6例。另曾配合胎盘组织液每天肌注2毫升，有腹水者配合利尿剂，治疗迁延性肝炎7例，基本治愈4例，显效1例，有效2例；治疗慢性肝炎47例，基本治愈13例，显效6例，有效14例，无效14例。未见明显副作用。"}]},{"ID":"20240611151513-kq2s9iu","Type":"NodeParagraph","Properties":{"id":"20240611151513-kq2s9iu","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑥治疗肾炎、肾盂肾炎"}]},{"ID":"20240611151513-6crwaak","Type":"NodeParagraph","Properties":{"id":"20240611151513-6crwaak","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"用黄芩提取物制成5％黄芩素注射液，每次肌注100～200毫克（儿童减半），每日2次。共治20例，治疗期间除配合卧床休息、低盐饮食外，均未兼用其他药物。结果急性肾炎11例，治愈（临床症状完全消失；复查尿液两次以上均正常）6例，好转（临床症状完全消失，复查尿液仅有少量红、白细胞）5例；肾盂肾炎9例，治愈、好转（标准同上）各4例，1例用药10天无变化。疗程最长17.5天，最短7天，平均12.5天。治愈病例临床症状的消失时间平均为9天，尿检恢复正常时间平均为15.6天。黄芩治疗肾病所以奏效，可能与其具有抗菌、降血压、利水等作用有关。"}]},{"ID":"20240611151513-qh7ailo","Type":"NodeParagraph","Properties":{"id":"20240611151513-qh7ailo","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑦治疗高血压病"}]},{"ID":"20240611151513-cn8nf4n","Type":"NodeParagraph","Properties":{"id":"20240611151513-cn8nf4n","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"将黄芩制成20％的酊剂，每次5～10毫升，日服3次。治疗51例，服药前血压均在180/100毫米汞柱以上，服药1～12月后血压下降20/10毫米汞柱以上者占70％以上。一般临床症状也随之消失或减轻。据观察，本药虽经较长时期服用，仍能发挥继续降压作用。无明显副作用。"}]},{"ID":"20240611151513-xx3mgux","Type":"NodeParagraph","Properties":{"id":"20240611151513-xx3mgux","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"此外，以黄芩煎荆预防猩红热，黄芩含片预防白喉，有一定作用。"}]},{"ID":"20240611151513-wtvtk4f","Type":"NodeParagraph","Properties":{"id":"20240611151513-wtvtk4f","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611151513-x7c0cfv","Type":"NodeParagraph","Properties":{"id":"20240611151513-x7c0cfv","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" ①《药对》：\"黄芩，得厚朴、黄连止腹痛；得五味子、牡蒙、牡蛎令人有子；得黄芪、白蔹、赤小豆疗鼠瘘。\""}]},{"ID":"20240611151513-skz9e74","Type":"NodeParagraph","Properties":{"id":"20240611151513-skz9e74","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"张仲景治伤寒心下痞满，泻心汤四方皆用黄芩，以其主诸热，利小肠故也。又太阳病下之利不止，有葛根黄芩黄连汤，及主妊娠安胎散，亦多用黄芩。\""}]},{"ID":"20240611151513-7cplf2o","Type":"NodeParagraph","Properties":{"id":"20240611151513-7cplf2o","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"黄芩，治肺中湿热，疗上热目中肿赤，瘀血壅盛，必用之药。泄肺中火邪上逆于膈上，补膀胱之寒水不足，乃滋其化源。《主治秘诀》云，其用有九：泻肺经热，一也；夏月须用，二也；上焦及皮肤风热，三也；去诸热，四也；妇人产后，养阴退阳，五也；利胸中气，六也；消膈上痰，七也；除上焦热及脾湿，八也；安胎，九也。单制、二制、不制，分上中下也。酒炒上行，主上部积血，非此不能除，肺苦气上逆，急食苦以泄之，正谓此也。\""}]},{"ID":"20240611151513-gwpsum4","Type":"NodeParagraph","Properties":{"id":"20240611151513-gwpsum4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"④张元素：\"下痢脓血稠粘，腹痛后重，身热久不可者，黄芩与芍药、甘草同用。肌热及去痰用黄芩，上焦湿热亦用黄芩，泻肺火故也。疮痛不可忍者，用苦寒药，如黄芩、黄连，详上下，分梢根，及引经药用之。\""}]},{"ID":"20240611151513-q3amua5","Type":"NodeParagraph","Properties":{"id":"20240611151513-q3amua5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑤李杲：\"黄芩，味苦而薄，故能泄肺火而解肌热，手太阴剂也。细实而中不空者，治下部妙。\""}]},{"ID":"20240611151513-pmqqx10","Type":"NodeParagraph","Properties":{"id":"20240611151513-pmqqx10","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑥朱震亨：\"黄芩降痰，假其降火也。凡去上焦湿热，须以酒洗过用。片芩泻肺火，须用桑白皮佐之。若肺虚者，多用则伤肺，必先以天门冬保定肺气，而后用之。黄芩、白术乃安胎圣药，俗以黄芩为寒而不敢用，盖不知胎孕宜清热凉血，血不妄行，乃能养胎，黄芩乃上、中二焦药，能降火下行，白术能补脾也。\""}]},{"ID":"20240611151513-xxiqomq","Type":"NodeParagraph","Properties":{"id":"20240611151513-xxiqomq","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"洁古张氏言黄芩泻肺火，治脾湿；东垣李氏言片芩治肺火，条芩治大肠火；丹溪朱氏言黄芩治上中二焦火；而张仲景治少阳证小柴胡汤，太阳、少阳合病下利黄芩汤，少阳证下后心下满而不痛泻心汤并用之；成无己言黄芩苦而入心，泄痞热，是黄芩能入手少阴、阳明、手足大阴、少阳六经典。盖黄芩气寒味苦，苦人心，寒胜热，泻心火，治脾之湿热，一则金不受刑，一则胃火不流入肺，即所以救肺也；肺虚不宜者，苦寒伤脾胃，损其母也。……杨士瀛《直指方》云，柴胡退热，不及黄芩，盖亦不知柴胡之退热，乃苦以发之，散火之标也，黄芩之退热，乃寒能胜热，折火之本也。\"\"黄芩得酒上行，得猪胆汁除肝胆热，得柴胡退寒热，得芍药治下痢，得桑白皮泻肺火，得白术安胎。\""}]},{"ID":"20240611151513-acj0sj9","Type":"NodeParagraph","Properties":{"id":"20240611151513-acj0sj9","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑧《本草经疏》：\"黄芩，其性清肃，所以除邪；味苦所以燥湿；阴寒所以胜热，故主诸热。诸热者，邪热与湿热也，黄疸、肠澼、泄痢，皆温热胜之病也，折其本，则诸病自瘳矣。苦寒能除湿热，所以小肠利而水自逐，源清则流洁也。血闭者，实热在血分，即热入血室，令人经闭不通，湿热解，则荣气清而自行也。恶疮疽蚀者，血热则留结，而为痈肿溃烂也；火疡者，火气伤血也，凉血除热，则自愈也。《别录》消痰热者，热在胸中，则生痰火，在少腹则绞痛，小儿内热则腹痛，胃中湿热去，则胃安而消谷也。淋露下血，是热在阴分也；其治往来寒热者，邪在少阳也；五淋者，湿热胜所致也；苦寒清肃之气胜，则邪气自解，是伐其本也。\"\"黄芩为苦寒清肃之药，功在除热邪，而非补益之品，当与黄连并列，虽能清热利湿消痰，然苦寒能损胃气而伤脾阴，脾肺虚热者忌之。\""}]},{"ID":"20240611151513-df8ax5p","Type":"NodeParagraph","Properties":{"id":"20240611151513-df8ax5p","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑨《本草汇言》：\"清肌退热，柴胡最佳，然无黄芩不能凉肌达表。上焦之火，山栀可降，然舍黄芩不能上清头目。……所以方脉科以之清肌退热，疮疡科以之解毒生肌，光明科以之散热明目，妇女科以之安胎理经，此盖诸科半表半里之首剂也。\""}]},{"ID":"20240611151513-gzvtjmo","Type":"NodeParagraph","Properties":{"id":"20240611151513-gzvtjmo","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑩《药品化义》：\"黄芩中枯者名枯芩，条细者名条芩，一品宜分两用。盖枯芩体轻主浮，专泻肺胃上焦之火，主治胸中逆气，膈上热痰，咳嗽喘急，目赤齿痛，吐衄失血，发斑发黄，痘疹疮毒，以其大能凉膈也。其条芩体重主降，专泻大肠下焦之火，主治大便闭结，小便淋浊，小腹急胀，肠红痢疾，血热崩中，胎漏下血，挟热腹痛，谵语狂言，以其能清大肠也。\""}]},{"ID":"20240611151513-x3wqqjd","Type":"NodeParagraph","Properties":{"id":"20240611151513-x3wqqjd","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑾《本经逢原》：\"昔人以柴胡去热不及黄芩，盖柴胡专主少阳往来寒热，少阳为枢，非柴胡不能宣通中外；黄芩专主阳明蒸热，阳明居中，非黄芩不能开泄蕴著，一主风木客邪，一主湿土蕴著，讵可混论。芩虽苦寒，毕竟治标之药，惟躯壳热者宜之，若阴虚伏热，虚阳发霉，可轻试乎?其条实者兼行冲脉，治血热妄行，古方有一味子芩丸，治女人血热，经水暴下不止者，最效。\""}]},{"ID":"20240611151513-pb214mm","Type":"NodeParagraph","Properties":{"id":"20240611151513-pb214mm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑿《本经疏证》：\"仲景用黄芩有三耦焉，气分热结者，与柴胡为耦（小柴胡汤、大柴胡汤、柴胡桂枝干姜汤、柴胡桂枝汤）；血分热结者，与芍药为耦（桂枝柴胡汤、黄芩汤、大柴胡汤、黄连阿胶汤、鳖甲煎丸、大黄蟅虫丸、奔豚汤、王不留行散、当归散）；湿热阻中者，与黄连为耦（半夏泻心汤、甘草泻心汤、生姜泻心汤、葛根黄芩黄连汤、干姜黄芩黄连人参汤）。以柴胡能开气分之结，不能泄气分之热，芍药能开血分之结，不能清迫血之热，黄连能治湿生之热，不能治热生之湿。譬之解斗，但去其斗者，未平其致斗之怒，斗终未巳也。故黄芩协柴胡，能清气分之热，协芍药，能泄迫血之热，协黄连，能解热生之湿也。\""}]},{"ID":"20240611151513-zzsndk6","Type":"NodeParagraph","Properties":{"id":"20240611151513-zzsndk6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611151513-qwo5u90","Type":"NodeParagraph","Properties":{"id":"20240611151513-qwo5u90","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 下列同属植物亦同供药用："}]},{"ID":"20240611151513-v9l2jl8","Type":"NodeParagraph","Properties":{"id":"20240611151513-v9l2jl8","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"①粘毛黄芩，又名：黄花黄芩。形态与黄芩相似，唯植株较矮，高仅10～27厘米。花淡黄色，花萼密被腺毛及柔毛。小坚果被长柔毛。生砂砾地、荒地或草坡。分布内蒙古、山西、河北等地。"}]},{"ID":"20240611151513-2qpybjj","Type":"NodeParagraph","Properties":{"id":"20240611151513-2qpybjj","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"②滇黄芩，又名：西南黄芩。植株矮小，高10～25厘米。茎直立，每节间密被两纵列白色柔毛及腺毛。叶片长椭圆形或广披针形，长达3.5厘米，宽约1.2厘米，全缘或稍具疏齿，两面疏被微柔毛；无柄。总状花序顶生；花冠蓝紫色，外面密被柔毛及腺毛。小坚果椭圆形，棕褐色，被柔毛。生于山区林边或疏林间。分布四川、云南等地。"}]},{"ID":"20240611151513-qhdiqdh","Type":"NodeParagraph","Properties":{"id":"20240611151513-qhdiqdh","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"③甘肃黄芩，形态与滇黄芩相近，但叶较宽，呈卵状三角形，叶缘有不等的锯齿，叶柄显著。多生于石山地向阳草坡上。分布甘肃、陕西及山西。"}]},{"ID":"20240611151513-rhz1vam","Type":"NodeParagraph","Properties":{"id":"20240611151513-rhz1vam","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"④薄叶黄芩，植株较小，高约35厘米。叶较薄，上面无毛或散生短毛，下面叶脉及边缘具短毛，散生腺点。分布东北至宁夏等地。"}]},{"ID":"20240611151513-rq6de1a","Type":"NodeParagraph","Properties":{"id":"20240611151513-rq6de1a","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑤丽江黄芩，茎高20～36厘米，被倒向小疏柔毛。叶近无柄，椭圆状卵形或椭圆形。花冠黄白色、黄色至绿黄色，常带紫斑。生灌丛、草坡或松林下。分布云南西北部。"}]},{"ID":"20240611151513-2jifx33","Type":"NodeParagraph","Properties":{"id":"20240611151513-2jifx33","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"⑥川黄芩，茎高10～30厘米。叶片大多为卵形。花冠白色、绿白色至紫色、紫蓝色。小坚果卵球形，具瘤。生于草坡、高山森林林缘。分布四川西部。"}]},{"ID":"20240611151513-3sajj7e","Type":"NodeParagraph","Properties":{"id":"20240611151513-3sajj7e","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611151513-vu6plxq","Type":"NodeParagraph","Properties":{"id":"20240611151513-vu6plxq","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611151513-5div0nu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151513-5div0nu","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"《中华本草》：黄芩"}]},{"ID":"20240611151513-yuwrtns","Type":"NodeParagraph","Properties":{"id":"20240611151513-yuwrtns","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611151513-2v9j3q8","Type":"NodeParagraph","Properties":{"id":"20240611151513-2v9j3q8","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" Huánɡ Qín"}]},{"ID":"20240611151513-gasvgrw","Type":"NodeParagraph","Properties":{"id":"20240611151513-gasvgrw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611151513-4l9gtx4","Type":"NodeParagraph","Properties":{"id":"20240611151513-4l9gtx4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 腐肠、黄文、妒妇、虹胜、经芩、印头、内虚、空肠、子芩、宿芩、条芩、元芩、土金茶根、山茶根、黄金条根"}]},{"ID":"20240611151513-qslaai2","Type":"NodeParagraph","Properties":{"id":"20240611151513-qslaai2","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611151513-o5rblo6","Type":"NodeParagraph","Properties":{"id":"20240611151513-o5rblo6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" Baical Skullcap Root"}]},{"ID":"20240611151513-sbs8hh3","Type":"NodeParagraph","Properties":{"id":"20240611151513-sbs8hh3","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611151513-yu435le","Type":"NodeParagraph","Properties":{"id":"20240611151513-yu435le","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 出自《吴普本草》：黄芩，二月生，赤黄叶，两两四四相值，茎空，中或方员，高三、四尺，四月花红赤，五月实黑，根黄。二月至九月采。"}]},{"ID":"20240611151513-o5k0xnz","Type":"NodeParagraph","Properties":{"id":"20240611151513-o5k0xnz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"1.《别录》：黄芩生秭归川谷及冤句。三月三日采根，阴干。"}]},{"ID":"20240611151513-x1j19a0","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611151513-x1j19a0","updated":"20240611151513"},"Children":[{"ID":"20240611151513-bs8489g","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240611151513-bs8489g","updated":"20240611151513"},"Children":[{"ID":"20240611151513-xsyof40","Type":"NodeParagraph","Properties":{"id":"20240611151513-xsyof40","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"陶弘景：黄芩，今第一出彭城，郁州亦有之。圆者名子芩为胜，破者名宿芩。其腹中皆烂、故名腐肠。惟取深色坚实者为好。"}]}]}]},{"ID":"20240611151513-src8584","Type":"NodeParagraph","Properties":{"id":"20240611151513-src8584","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：宿芩乃旧根，多中空，外黄内黑，即今所谓片芩。子芩乃新根，多内实，即"}]},{"ID":"20240611151513-12i9brp","Type":"NodeParagraph","Properties":{"id":"20240611151513-12i9brp","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611151513-ig0titf","Type":"NodeParagraph","Properties":{"id":"20240611151513-ig0titf","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 药材基源：为唇形科植物黄芩、滇黄芩、粘毛黄芩和丽江黄芩的根。"}]},{"ID":"20240611151513-m4r92wm","Type":"NodeParagraph","Properties":{"id":"20240611151513-m4r92wm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Scutellaria baicalensis Georgi2.Scutellaria amoena G.H.Wrignt3.Scutellaria uiscidula Bunge4.Scutellaria likiangensis Diels"}]},{"ID":"20240611151513-2kgxo39","Type":"NodeParagraph","Properties":{"id":"20240611151513-2kgxo39","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培2-3年收获，于秋后茎叶枯黄时，选晴天挖取。将根部除着的茎叶去掉，抖落泥土，晒至半干，撞去外皮，晒干或烘干。"}]},{"ID":"20240611151513-th620jm","Type":"NodeParagraph","Properties":{"id":"20240611151513-th620jm","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611151513-xmdqdhw","Type":"NodeParagraph","Properties":{"id":"20240611151513-xmdqdhw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔60-2000m的向阳干燥山坡、荒地上，常见于路边。"}]},{"ID":"20240611151513-cesyyzx","Type":"NodeParagraph","Properties":{"id":"20240611151513-cesyyzx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"生于海拔1300-3000m的草地或松林下。"}]},{"ID":"20240611151513-8mkvb9l","Type":"NodeParagraph","Properties":{"id":"20240611151513-8mkvb9l","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"生于海拔700-1400m的沙砾荒草地。"}]},{"ID":"20240611151513-d5avosf","Type":"NodeParagraph","Properties":{"id":"20240611151513-d5avosf","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"生于海拔2500-3100m的灌丛或草坡上。"}]},{"ID":"20240611151513-j9bo2o5","Type":"NodeParagraph","Properties":{"id":"20240611151513-j9bo2o5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、内蒙古、河北、山西、陕西、甘肃、山东、河南等地。"}]},{"ID":"20240611151513-wbrucyf","Type":"NodeParagraph","Properties":{"id":"20240611151513-wbrucyf","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"分布于四川、贵州、云南等地。"}]},{"ID":"20240611151513-2u9j3zd","Type":"NodeParagraph","Properties":{"id":"20240611151513-2u9j3zd","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"分布于吉林、内蒙古、河北、山西、山东等地。"}]},{"ID":"20240611151513-asrfhh2","Type":"NodeParagraph","Properties":{"id":"20240611151513-asrfhh2","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"分布于四川南部、云南西北部。"}]},{"ID":"20240611151513-ywoqa4z","Type":"NodeParagraph","Properties":{"id":"20240611151513-ywoqa4z","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611151513-b4f58wx","Type":"NodeParagraph","Properties":{"id":"20240611151513-b4f58wx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高30-80cm。茎钝四棱形，具细条纹，无毛或被上曲至开展的微柔毛，绿色或常带紫色；自基部分枝多而细。叶交互对生；无柄或几无柄；叶片披针形至线状披针形，长1.5-4.5cm，宽3-12mm，先端钝，基部近圆形，全缘，上面深绿色，无毛或微有毛，下面淡绿色，沿中脉被柔毛，密被黑色下陷的腺点。总状花序顶生或腑生，偏向一侧，长7-15cm；苞片叶状，卵圆状披针形至披针形，长4-11cm，近无毛；花萼二唇形，紫绿色，上唇背部有盾状附属物，果时增大，腊质；花冠二唇形，蓝紫色或紫红色，上唇盔状，先端微缺，下唇宽，中裂片三角状卵圆形，宽7.5mm，两侧裂片向上唇靠合，花冠管细，基部骤曲；雄蕊4，稍露出，药室裂口有白色髯毛；子房褐色，无毛，4深裂，生于环状花盘上，花柱细长，先端微裂。小坚果4，卵球形，长1.5mm，径1mm，黑褐色，有瘤。花期6-9月，果期8-10月。"}]},{"ID":"20240611151513-ms6mqc5","Type":"NodeParagraph","Properties":{"id":"20240611151513-ms6mqc5","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"多年生草本，高20-35cm。茎锐四棱形，略具槽，沿棱角被疏毛，分枝或不分枝，常带紫色。叶对生；叶柄短，长1-2mm；叶片草质，长圆状卵形或长圆形，常对折，长1.4-3.5cm，。宽7-14mm，先端钝，基部圆形或楔形至浅心形，边缘有不明显的圆齿至全缘，上面暗绿色，无毛或被疏柔毛，下面淡绿色，密被下陷的腺点，沿中脉被柔毛。花对生，排列成顶生长5-14cm的总状花序；苞片叶状，披针状长圆形，长5-10mm；花萼二唇形，常带紫色，背部盾片膜质，果时增大；花冠二唇形，紫色或蓝紫色，长2.4-3cm，外被腺毛；雄蕊4，花丝扁平；子房无毛，花柱细长，柱头微裂。小坚果卵球形，棕褐色，具瘤。花期5-9月，果期7-10月。"}]},{"ID":"20240611151513-3tls3q4","Type":"NodeParagraph","Properties":{"id":"20240611151513-3tls3q4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"多年生草本，高20-35cm。茎直立，褐紫色，四棱形，被倒向柔毛，茎中部节是长1.8-3.6cm。叶交互对生；叶片椭圆状卵圆形工椭圆形，长1.3-3cm，宽6-15mm，先端圆钝，有时微缺，边缘在中部以上有不明显的圆齿或近全缘，上面绿色，被稀疏的柔毛，下面淡绿色，密被凹腺点。花对生，在茎顶排列或顶生的总状花序，长6.5-12cm；苞片叶状，两面均被腺毛；花萼二唇形，常带紫色，外面密被腺毛，盾片半圆形，果时竖立，反折；花冠二唇形，黄白色、黄色至绿黄以，常有粉紫斑或条纹，长2.6-3cm，外面密被腺毛，冠筒近基部囊状膨大；雄蕊4；子房深4裂，花柱细长，柱头微裂。小坚果4，黑色，卵球形，具瘤。花期5-8月，果期7-9月。"}]},{"ID":"20240611151513-fx7itv3","Type":"NodeParagraph","Properties":{"id":"20240611151513-fx7itv3","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611151513-24wplfz","Type":"NodeParagraph","Properties":{"id":"20240611151513-24wplfz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖凉爽气候，耐严寒，耐旱，耐瘠薄，成年植株地下部分可忍受-30℃的低温。以阳光充足、土层深厚、肥沃的中性或微碱性壤土或砂质壤土栽培为宜。忌连作。"}]},{"ID":"20240611151513-83lmwk8","Type":"NodeParagraph","Properties":{"id":"20240611151513-83lmwk8","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖或分根繁殖。种子繁殖：可用直播或育苗移栽法。直播法法，省劳力，根条长，权根少，产量高。春播3-4月中旬；秋播8月中旬，开沟条播，行距30-45cm。每1hm2用种量15kg左右。幼苗出齐后，分2-3次间苗，保持株距12-15cm。分根繁殖：即挖取洞未萌发的3年生黄芩根茎，切取主根留供药用，然后根据根茎生长的自然形状分切成若干块，每块有芽眼2-3个即可栽种。"}]},{"ID":"20240611151513-cb90g91","Type":"NodeParagraph","Properties":{"id":"20240611151513-cb90g91","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"田间管理 在出苗期应保持土壤湿润：适时松土除草；每年追肥2-3次，6-7月为生长旺盛期，可追施人畜粪肥或硫酸铵或过磷钙等。除留种地外，抽出花序之前应剪去花梗。"}]},{"ID":"20240611151513-8bjw28f","Type":"NodeParagraph","Properties":{"id":"20240611151513-8bjw28f","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有叶枯病，可清洁田园，发端正初期喷洒1：1：200波尔多液，或用50%多菌灵1000倍液防治。根腐病，注意排水，实行轮作。虫害有黄芩舞蛾，可用90%敌百虫防治。"}]},{"ID":"20240611151513-95njjqk","Type":"NodeParagraph","Properties":{"id":"20240611151513-95njjqk","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611151513-k3m6nkr","Type":"NodeParagraph","Properties":{"id":"20240611151513-k3m6nkr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）黄芩 根呈圆锥形，多扭曲，长5-25cm，直径1-3cm。表面棕黄色或深黄色，粗糙，有明显的纵向皱纹或不规则网纹，具侧根残痕，顶端有茎痕或残留茎基。质硬而脆，易折断，断面黄色，中间红棕色，老根木部枯朽，棕黑色或中空者称“枯芩”。气微，味苦。"}]},{"ID":"20240611151513-m8gunol","Type":"NodeParagraph","Properties":{"id":"20240611151513-m8gunol","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"以条长、质坚实、色黄者为佳。"}]},{"ID":"20240611151513-ie3sdg7","Type":"NodeParagraph","Properties":{"id":"20240611151513-ie3sdg7","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（2）滇黄芩 根茎横生或斜生，粗1cm以上。根呈圆锥形的不规则条状，常有分枝，长5-20cm，直径1-1.6cm。表面黄褐色或棕黄色，常有粗糙的栓皮，有皱纹。下端有支根痕，断面纤维状，鲜黄色或微带绿色。"}]},{"ID":"20240611151513-r4nbr59","Type":"NodeParagraph","Properties":{"id":"20240611151513-r4nbr59","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（3）粘毛黄芩 根多细长，圆锥形或圆柱形，长7-15cm，直径0.5-1.5cm。表面与黄芩相似，很少中空或腐朽。"}]},{"ID":"20240611151513-kh3vq46","Type":"NodeParagraph","Properties":{"id":"20240611151513-kh3vq46","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（4）丽江黄芩 根呈圆柱形，有分枝，长8-20cm，直径0.2-0.5.cm。表面黄棕色，断面黄色，老根中间显暗褐色，枯朽。"}]},{"ID":"20240611151513-8p6lhqk","Type":"NodeParagraph","Properties":{"id":"20240611151513-8p6lhqk","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：（1）黄芩 木栓层多除去或残存数列，细胞多呈扁平状，偶见单个石细胞散在。栓内层狭窄。韧皮部较宽广，约占根直径的1/3，有多数韧皮纤维与石细胞，石细胞的分布于外侧，韧皮纤维多分布于内侧。韧皮射线宽阔，为10-25列整齐的细胞。形成层多成环。木质部约占根直径的2/3，木质部束6-10，木射线宽广耐平直，7-25列薄壁细胞，导管直径16-60μm。老根中央有一至数个同心排列的木栓环。本品薄壁细胞含淀粉粒，圆形、椭圆形和不规则形，长径4-32μm，短径4-24μm，层纹不易见。脐点呈点状或“人”字形，有的不明显，大多数为单粒，复粒较少，由2-3分粒组成。"}]},{"ID":"20240611151513-w2gg1si","Type":"NodeParagraph","Properties":{"id":"20240611151513-w2gg1si","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（2）滇黄芩 木栓层为6-9列细胞。韧皮部约占根的1/4，有纤维散在，偶见大、小悬殊的石细胞，石细胞方形，不规则形。形成层不明显。木质部束8-13，木射线8-18列薄壁细胞。导管直径28-44μm。中央无木栓环。淀粉粒直径2-12μm，脐点未见，无层纹。"}]},{"ID":"20240611151513-ywve2fa","Type":"NodeParagraph","Properties":{"id":"20240611151513-ywve2fa","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（3）粘毛黄芩 木栓层为5-8列细胞。韧皮部约占根直径的1-3，级纤维散在，偶见极小石细胞。形成层明显。木质部束7-13，木射线7-21列薄壁细胞，导管直径40-80μm。中央有木栓层环，外侧有石细胞散在。淀粉粒直径2-12μm，脐点“一”字形、“人”字形，无层纹。"}]},{"ID":"20240611151513-s5qi75k","Type":"NodeParagraph","Properties":{"id":"20240611151513-s5qi75k","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"（4）丽江黄芩 木栓层为6-9列细胞。韧皮部约占根直径的1/3，无石细胞和纤维。木质部束9-10，木射线8-19列薄壁细胞，导管直径20-40μm，中央无木栓环。演粉粒多数，圆形，直径4-10μm，脐点未见，无层纹。"}]},{"ID":"20240611151513-w26gzgk","Type":"NodeParagraph","Properties":{"id":"20240611151513-w26gzgk","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"粉末特征：深黄色。①韧皮纤维微黄色，梭形，两端尖或钝圆，长51-200（-270）μm，直径9-33μm，壁甚厚，木化，孔沟明显。②石细胞类方形、类圆形、椭圆形、类三角形、类多角形、纹锤形或不规则形，直径24-48μm，长85-160μ，壁厚至24μ；偶见黄棕色石细胞，类圆形，直径约66μm。③纺锤形木薄壁细胞常伴于导管旁，壁稍厚，非木化，细胞中部有菲薄横隔。④韧 皮薄壁细胞纺锤形或长圆形，壁有时呈连珠状增厚。⑤网纹、具缘纹孔导管直径约至72μ，导管分子较短，端壁倾斜，常延长成尾状；有时呈扭曲状。⑥木纤纤维细长，壁稍厚，具斜纹孔或具缘纹孔。另有淀粉粒，木栓细胞。"}]},{"ID":"20240611151513-o9yey7v","Type":"NodeParagraph","Properties":{"id":"20240611151513-o9yey7v","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611151513-p7m5g5r","Type":"NodeParagraph","Properties":{"id":"20240611151513-p7m5g5r","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 黄芩毒性极低，煎剂给兔灌胃，醇提取液静脉注射，仅呈活动减弱，黄芩浸剂4 g/kg给狗灌胃8周，亦未见任何毒性反应，如将黄芥浸剂2g/kg静脉注射于健康兔，先表现镇静，以后死亡，可见静脉注射比口服毒性大得多。黄芩提取物肌肉及静脉注射，可使正常家兔白细胞总数短时间内显着降低。黄芩素腹腔注射对小鼠的半数致死量为3081mg/kg。黄芩浸剂15g/kg/灌胃对犬有呕吐现象，5g/kg灌胃连续8周，使犬粪便稀软。"}]},{"ID":"20240611151513-gsd55dj","Type":"NodeParagraph","Properties":{"id":"20240611151513-gsd55dj","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611151513-qfsqn2r","Type":"NodeParagraph","Properties":{"id":"20240611151513-qfsqn2r","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 1.黄芩 根含黄酮类化合物：黄芩素（baicalein)，黄芩新素（neobaicalein)，即黄芩黄酮Ⅱ（skullcapflavoneⅡ），黄芩甙（baicalin)，汉黄芩素（wogonin)，汉黄芩甙（wogono-side)[1]，木蝴蝶素A（oroxylin,oroxylin A)[2，3]，7-甲氧基黄芩素（7-methoxbaic alein)[2]，黄芩黄酮（skullcapflavone)Ⅰ[3，4]，二氢木蝴蝶素A（dihydrooroxylin A)，白杨素（chrysin)，2，5，8-三羟基-7-甲氧基黄酮（2,5,8-trihydroxy-7-methoxy-flavone)，2，5，8-三羟基-6，7-二甲氧基黄酮（2,5,8-trihydroxy-6,7-dimethoxyflavone)4，5，7-三羟基-6-甲氧基黄烷酮（4，5，7-trhydroxy-6-methoxyflavanone)[5]，2，3，5，6，7-五羟基黄烷酮（2，3，5，6，7-pentahydroxyflavanone)汉黄芩素-5-β-D-葡萄糖甙（wogonin-5-β-D-glucoside)，2-（3-羟基-4-甲氧基苯基）-乙基-1-O-α-L-鼠李糖基（1→3）-β-D（4-阿魏酰基）-葡萄糖[2-（3-hydroxy-4-methoxyphenyl)ethyl-1-O-α-L-rhamnosyl(1→3）-β-D-（4-feruloyl)glucoside][6]，白杨素；-6-C-α-L-阿拉伯糖甙（chrysin-6-C-β-D-glucoside-8-C-β-L-arabinoside)，白杨素-6-C-α-L-阿拉伯糖甙-8-C-β-D-葡萄糖甙（chrysin-6-C-α-L-arabi-noside-8-C-β-D-glucoside)[7]，（2S）-2，5，6，7-四羟基黄烷酮[（2S）-25，6，7-terahydroxyflavanone][8，9]，5，7，2，6-四羟基黄酮（5，7，2，7-tetrahydroxyflavone)，5，8-二羟基-6，7-二甲氧基黄酮（5，8-dihydroxy-6,7-drimethoxyflavone)，5，7，4-三羟基-8-甲氧基黄酮（5，7，4-trihydroxy-8-methoxyflavone)，木蝴蝶素A-7-O-葡萄糖醛酸甙（oroxylinA-7-O-glucuronide)[10]，5，7，2-三羟基甲氧基黄酮（5，7，2-trihyroxy-6-methoxyflavone)，5，2-二羟基-6，7，8-三甲氧基黄酮（5，2-dihydroxy-6,7,8-trimethoxyfla-vone)，5-闳基-7，8-二甲氧基黄酮（5-hydroxy-7,8-dimethoxy-flavone)，去甲汉黄芩素（norwogonin)，二氢黄芩素（dihydro-baicalin)[11]，5，7，2-三羟基黄酮（5,7,2-trihydroxyflavone)，5，7，2-三羟基-8，6-二甲氧基黄酮（5，7，2-trihydroxy-8,6-dimethoxyflavone)，5，7，2，5-四羟基-8。6-二甲氧基黄酮即粘毛黄芩素Ⅲ（5，7，2，5-tetrahydroxy-8,6-dimethoxyflavone，vis-ciduiin Ⅲ）5，25-三羟基三甲氧基黄酮（5，2，5-trihy-droxy-6,7,8-trimethoxyflavone)，黄芩素-7-O-β-D-吡喃葡萄糖甙(baicalein-7-O-β-D-glucopyranoside)[12]；5，7，2-三羟基-8-甲氧基黄酮（5，7，2-trhiyroxy-8-methoxyflavone)即韧黄芩素Ⅱ（tenax-in Ⅱ），5，2，6-三羟基-7，8-二甲氧基黄酮（5,2,6-三羟基-6-甲氧基黄酮（5,7,2-trihydroxy-6-methoxyflavone)，5，7，2，3-四羟基黄酮（5，7，2-trihydroxy-6-methoxyflavone)，5，7，2，3-四闳基黄酮（5，7，2，3-tetrahydroxyflavone)，3，5，7，2，5，6-五羟基黄酮(3,5,7,2,6-pentahydroxyflavone)即粘毛黄芩素Ⅰ（viscidulin Ⅰ），（2S）-7，2，6-三羟基-5-甲氧基黄烷酮[（2S）-7，2，6-trihydroxy-5-methoxyflavanone]，2，6，2，4-四羟基-6-甲氧基查尔酮（2，6，2，4-tetrahydroxy-6-methoxychalcone)[13]，5，72，5-四羟基黄酮（5，7，2，5-tetrahydroxyflavone)，左旋圣草素（eriodictyol)，半枝莲种素（rivularin)及粘毛黄芩素Ⅲ-2-O-β-D-吡喃葡萄糖甙（viscidulin Ⅲ-2-O-β-D-glucoplyranoside)[14]等。另外还含β-谷甾醇（β-sitosterol)，菜油甾醇（campesterol)及豆甾醇（stigmasterol)[3]。2.滇黄芩 根含泾黄芩素，黄芩素，黄芩甙，汉黄芩甙，5，7，2-三羟基-6-甲氧基黄酮[15，16]，（2S）-5，7，8-三羟基黄烷酮[（2S）-5，7，8-trihydroxyflavanone],(2S)-2,5,6,7-四羟基黄烷黄芩素，木蝴蝶素A，滇黄芩新甙（scuteamoenoside)，（2R，3R）-2，3，5，7-四羟基黄烷酮[（2R，3R）-2，3，5，7-tetrahydrox-yflavanone][17]，滇黄芩新素（scuteamoenin),(2R,3R)-3,5,7-三羟基黄烷酮-（2R，3R）-3，5，7-trihydroxyflavanone]，黄芩黄酮Ⅱ，2，3，5，6，7-五羟基黄酮，白杨素，β-谷甾醇[16]。3.粘毛黄芩 根含黄芩甙，汉黄芩甙[18，19]，黄芩素，汉黄芩素，木蝴蝶素A，黄芩新素，5，2-二羟基二甲氧基黄酮（panicolin)即黄芩黄酮Ⅰ，粘毛黄芩素Ⅰ、Ⅱ[19]、Ⅲ[19，20]。"}]},{"ID":"20240611151513-cro5yv0","Type":"NodeParagraph","Properties":{"id":"20240611151513-cro5yv0","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"4.丽江黄芩 根含黄芩素，汉黄芩素，白杨素，木蝴蝶素A，韧黄芩素Ⅱ，粘千周黄芩素Ⅰ[21]。"}]},{"ID":"20240611151513-oyaonop","Type":"NodeParagraph","Properties":{"id":"20240611151513-oyaonop","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"同属植物甘肃黄芩根含甘肃黄芩素（rehderianin)Ⅰ，粘毛黄芩素Ⅲ[22]，黄芩甙，汉黄芩素，黄芩素，木蝴蝶素A，甘肃芩甙元（ganhuangenin)[23]。川黄芩根含黄芩甙，汉黄芩甙，黄芩素，粘毛黄芩素Ⅰ、Ⅱ，木蝴蝶素A和汉黄芩素[24]。"}]},{"ID":"20240611151513-upi1bht","Type":"NodeParagraph","Properties":{"id":"20240611151513-upi1bht","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611151513-ombpl0z","Type":"NodeParagraph","Properties":{"id":"20240611151513-ombpl0z","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用：黄芩煎剂100%浓度，平板法试验，对痢疾杆菌、伤寒杆菌、副伤寒杆菌、霍乱弧菌、大肠杆菌、变形杆菌、绿脓杆菌、葡萄球菌、溶血性琏球菌（a，B）、肺炎双球菌、白喉杆菌等有抑制作用。黄芩煎剂试管法试验1：1280 浓度可抑制伤寒杆菌、溶血性链球菌 a，1：640 浓度抑制溶血性链球菌B，肺炎双球菌及福氏痢疾杆菌、人结核杆菌 H37，1：320 浓度可抑制霍乱弧菌、志贺氏痢疾杆菌；1：80 浓度时宋内氏痢疾杆菌有抑制作用。黄芩醇浸液0.5g/ml或0.05g/ml，用琼脂斜面培养，药液与培养基1：1 混合，对绿脓杆菌有抑制作用。黄芩醇浸液2g/ml浓度，平皿法试验对大肠杆菌、桔草杆菌、金黄色葡萄球菌有抑制作用。黄芩煎 剂、醇提剂 1g/ml浓度，用平板法试验时对脑膜炎球菌均有抑作用。"}]},{"ID":"20240611151513-lx73wx1","Type":"NodeParagraph","Properties":{"id":"20240611151513-lx73wx1","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用：黄芩煎液，试管斜面法试验4%浓度抑制狗小牙胞菌及堇色毛癣菌，8%浓度抑制许兰氏黄癣菌，10%浓度抑制许兰氏黄癣菌蒙古变种，15%浓度抑制共心性毛癣菌及铁锈色毛癣菌。黄芩水浸剂1：3浓度在试管内对堇色毛癣菌、同心性毛癣菌，许兰氏黄癣菌、奥杜盎氏小芽胞癣菌、羊毛样小芽胞癣菌、红色表皮癣菌、K、W、氏表皮癣菌、星形奴卡氏菌等有不同程度抑菌作用。"}]},{"ID":"20240611151513-jqm10l4","Type":"NodeParagraph","Properties":{"id":"20240611151513-jqm10l4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"3.抗病毒作用：黄芩煎剂25-100%浓度，体外试验对乙型肝炎病毒DNA复制有抑制作用。"}]},{"ID":"20240611151513-6qt9vhc","Type":"NodeParagraph","Properties":{"id":"20240611151513-6qt9vhc","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"4.抗炎抗变态反应：黄芩70%乙醇提取物200，500mg/kg 灌胃黄芩素、黄芩甙、汉黄芩素50，100mg/kg 灌胃，可抑制醋酸引起的小鼠腹腔渗出增加，对48/80（一种化合物名称，Sigma 生产）引起的大鼠足肿也有抑制作用，黄芩70%乙醇提取物500mg/kg 灌胃，黄芩素、黄芩甙及汉黄芩素100mg/kg灌胃 对大鼠佐剂性关节炎有抑制作用。黄芩水提物100，200mg/kg 灌胃，对大鼠被动皮肤过敏反应（PCA）有抑制作用，但对氯化苦引起的小鼠接触皮炎（耳肿胀）无明显影响。黄芩抑制被动皮肤过敏反应（PCA）的有效成分为黄芩甙及黄芩素。黄芩甙、黄芩素对实验性气喘有效，黄芩甙10-4g/ml浓度可抑制豚鼠气管Schultz-Dale反应38%，并有抗组胺，抗胆碱及罂粟碱样作用。黄芩素不溶于水，其两个水溶性衍生物黄芩素-6-磷酸二钠（BPS）及黄芩素-6-硫酸二钠（BSS）于抗原攻击前5mg/kg 静脉注射，对大鼠PCA有抑制作用；10mg/kg 静脉注射 于抗原攻击前10分钟给药，对豚鼠过敏性气喘有抑制作用；BPS及BSS于10-4g/ml浓度对离体豚鼠肠管及气管chultz-Dale反应均有抑制作用；BPS及BSS 5mg/kg 静脉注射，对大鼠反向皮肤过敏反应（RCA）有抑制作用；5-10mg/kg 静脉注射也抑制Forssman皮肤血管炎，但对Arthus反应无明显影响。黄芩素及BPS结构上与抗过敏药色甘酸二钠（DSCG）相类似，但DSCG为双色酮类，黄芩素及BPS为单色酮类，DSCG对反应素（Reagin）抗体介导的过敏反应有高度特异性，而对非反应素（IgG）抗体介导的过敏反应几无作用，PBS则不仅抑制反应素抗体介导的过敏反应，如PBS 10-6-10-4g/ml抑制抗原引起的猴肺介质释放，PBS 200mg/kg腹腔注射抑制大鼠同种PCA，10-4g/ml抑制反应素抗体介导的大鼠肥大细胞脱颗粒等，也抑制非反应素抗体介导的反应，如BPS10-4g/ml可抑制卵白蛋白致敏豚鼠肺释放介质及抑制抗IgE抗体引起的人肺释放过敏介质，认为DSCG分子中两个色酮核间有一定距离，可结合于反应素抗体功能位置上，而不适合于非反应素抗体，但单色酮的黄芩素或BPS可以两个分子结合于这两种抗体上。黄芩素对大鼠血小板花生四烯酸代谢中环氧酶与脂氧酶均有抑制作用，对脂氧酶更具选择性，其IC50为0.12μm，而对环氧的IC50为6917倍于脂氧酶。黄芩素对大鼠白细胞可抑制花生四烯酸代谢，抑制脂氧酶代谢产物5-羟基二十碳四烯酸（5-HETE）及环氧酶代谢产物12-羟基十七碳三烯酸（HHT）的生成，其IC50分别为7.13±0.767μm及5.53±16.9μm；黄芩甙对白细胞5-HETE形成也抑制，但不抑制HHT的形成；汉黄芩素抑制HHT的形成，IC50为14.6±3.51μm黄芩成分对化合物48/80刺激大鼠腹腔肥大细胞释放组胺的抑制作用，黄芩素的IC50为52.1μm，黄芩甙IC50为＞200μm，汉黄芩素的IC50为40.0μm，汉黄芩素-7-O-D葡萄糖醛酸的IC50为140.0mol/l，（25）2'，5，6'，7-四羟黄烷酮的IC50为17.7μm，（2R，3R）-2'，3，5，6'，7-五羟黄烷酮的IC50为15.5μm，白杨素(Chrysin)的IC50＞200μm，黄芩新素Ⅱ（Skullcapflavon Ⅱ）的IC50为15.0μm。黄芩甙10，100mg/ml，对钙离子载体A23187诱导的大鼠腹腔巨噬细胞产生PGE2及TXA2均有明显抑制作用。"}]},{"ID":"20240611151513-7bxys55","Type":"NodeParagraph","Properties":{"id":"20240611151513-7bxys55","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"5.对中枢神经系统的作用：黄芩煎剂4g/kg 腹腔注射，对小鼠防御性条件反射可使阳性反射时延长，而对非条件反射及分化无影响，说明黄芩可加强皮层抑制过程。黄芩煎剂2g/kg，对伤寒混合疫苗致热家兔有解热作用。但也有报道黄芩水煎剂或酒浸剂5-9g/只灌胃，或2g/只im，均不能证明黄芩对伤寒疫苗致热家兔有解热作用。"}]},{"ID":"20240611151513-9bzsfat","Type":"NodeParagraph","Properties":{"id":"20240611151513-9bzsfat","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"6.对心血管的作用：黄芩醇提液1g/kg 静脉注射，可使麻醉犬血压下降。黄芩煎剂0.06g/kg 静脉注射，对麻醉犬有明显降压作用。黄芩素20mg/kg 静脉注射，可使麻醉犬血压下降40-50%。黄芩浸剂灌胃/kg 灌胃，3次/天，连续4周，使慢性肾性高血压犬血压下降，心率变慢。黄芩甙2×10(-4)mol/l，在豚鼠离体主动脉条、肺动脉条、气管条及右心房均有竞争性的拮抗肾上腺素，去甲肾上腺素及多巴胺引起的收缩作用，也拮抗异丙肾上腺素舒张气管和增加右心房自发频率作用，提示黄芩甙对a，B1，B2 受体均有阻断作用。"}]},{"ID":"20240611151513-05jjblo","Type":"NodeParagraph","Properties":{"id":"20240611151513-05jjblo","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"7.抗血小板聚集及抗凝：黄芩素、汉黄芩素、千层纸素A、黄芩黄酮Ⅱ及白杨素（chrysin）于浓度1.0mM时，均可抑制胶原诱导的大鼠血小板聚集，白杨素对ADP诱导的血小板聚集也有抑制作用，黄芩素及汉黄芩素对花生四烯酸诱导的血小板聚集也有抑制作用，黄芩素及黄芩甙对凝血酶诱导的纤维蛋白原转化为纤维蛋白也抑制；黄芩素及黄芩甙20，50mg/kg 灌胃，对内毒素诱导的大鼠弥漫性血管内凝血，可以防止血小板及纤维蛋白原含量的降低。"}]},{"ID":"20240611151513-b8qcz8n","Type":"NodeParagraph","Properties":{"id":"20240611151513-b8qcz8n","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"8.降血脂作用：黄芩水浸液10%2ml/只灌胃，连续给药7周，可使胆固醇喂饲的家兔血清胆固醇含量下降。黄芩素、黄芩甙100mg/kg 灌胃，可降低实验性高血脂大鼠玉米油-胆固醇-胆酸喂饲血清游离脂肪酸、甘油三酯及肝甘油三酯的含量，黄芩黄酮Ⅱ100mg/kg 灌胃，可降低血清总胆固醇及肝甘油三酯的含量，增加血清高密度脂蛋白-胆固醇（HDL-ch）的含量，汉黄芩素 100mg/kg 灌胃，可防止肝甘油三酯的沉积并增加血清HDL-ch的含量。黄芩素、黄芩甙 100mg/kg 灌胃，对乙醇引起的高血脂大鼠，可降低肝总胆固醇、游离胆固醇及甘油三酯含量，汉黄芩素能降低血清甘油三酯的水平，黄芩素能增加血清HDL-ch含量。"}]},{"ID":"20240611151513-gp0fx6j","Type":"NodeParagraph","Properties":{"id":"20240611151513-gp0fx6j","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"9.保肝、利胆、抗氧化：黄芩甲醇提取物1000mg/kg 腹腔注射，对异硫氰酸萘酯（ANIT）引起的大鼠肝损害有抑制作用，可抑制血清胆红素的增加。黄芩醇提物50，100mg/kg，黄芩甙50，100mg/kg 灌胃，对家兔有利胆作用。汉黄芩素10(-4)-10(-6)mol/l 浓度体外试验，对大鼠肝微粒体脂质过氧化有抑制作用，使丙二醛（MDA）含量下降。黄芩素及黄芩甙2.5×10(-4)mol/l，1.0×10(-4)mol/l，汉黄芩素2.5×10(-4)mol/l，黄芩黄酮Ⅱ2.5×10(-4)mol/l，汉黄芩素-7-O-D葡萄糖醛酸2.5×10(-4)mol/l，1.0× 10(-4)mol/l，对FeC12-维生素C-ADP混合物诱导的大鼠肝匀浆脂质过氧化有抑制作用，使肝MDA的形成显着下降，对NADPH一ADP引起的脂质过氧化也抑制。"}]},{"ID":"20240611151513-box5523","Type":"NodeParagraph","Properties":{"id":"20240611151513-box5523","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"10.抗癌作用：黄芩醚提物对小鼠白血病L1210细胞有细胞毒作用，半数有效量为10.4mg/ml，黄芩黄酮Ⅱ对小鼠L1210 细胞的半数有效量 为1.5μg/ml，黄芩甙、黄芩素及汉黄芩素对L1210作用不显着。"}]},{"ID":"20240611151513-wmw361x","Type":"NodeParagraph","Properties":{"id":"20240611151513-wmw361x","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"11.其它作用：黄芩素10，20mg/kg 静脉注射，对麻醉犬有利尿作用。黄芩煎剂4g/kg 灌胃，对大鼠半乳糖性白内障有防治作用，可延缓白内障的形成。黄芩甙对大鼠晶体醛糖还原酶有抑制作用，其ID50 为1.81 × 10(-3)mg/ml。黄芩甙150mg/kg 灌胃，对链黑霉素引起的糖尿病大鼠血糖水平无明显下降，但红细胞山梨醇含量于治疗后显着降低，提示在动物体内也有抑制醛糖酶的作用，有可能用于糖尿病性并发症的防治。黄芩甙、黄芩素及汉黄芩素50-125μg/ml 对小鼠肝唾液酸酶有抑制作用。黄芩甙100mg/kg，葡萄糖醛酸43mg/kg 皮下注射均可对抗士的宁引起的小鼠死亡，而甙元黄芩素无效，认为黄芩甙水解后的葡萄糖醛酸起的解毒作用。黄芩对PGs的代谢有较广泛的影响，水提物对PGs的生物合成有抑制作用。"}]},{"ID":"20240611151513-cs193lz","Type":"NodeParagraph","Properties":{"id":"20240611151513-cs193lz","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611151513-03rbv2p","Type":"NodeParagraph","Properties":{"id":"20240611151513-03rbv2p","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 黄芩：拣去杂质，除去残茎，用凉水浸润或置开水中稍浸捞出，润透后切片晒干（注意避免曝晒过度发红）。酒黄芩：取黄芥片喷淋黄酒，拌匀，用文火微炒，取出，晾干。（每黄芩100斤，用黄酒10-15斤）炒黄芩：取黄芩片用文火炒至表面微焦为度，取出，放凉。黄芩炭：取黄芩片用武火炒至表面焦褐色、边缘带黑色为度，但须存性，喷淋清水，取出，晒干。"}]},{"ID":"20240611151513-14zj2af","Type":"NodeParagraph","Properties":{"id":"20240611151513-14zj2af","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611151513-ikbu5yr","Type":"NodeParagraph","Properties":{"id":"20240611151513-ikbu5yr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取粉末2g，置100ml锥形瓶中，加乙醇20ml；置水浴上回流15min，滤过。取滤液1ml，加醋酸铅试液2-3滴，即发生橘黄色沉淀；另取滤液1ml，加镁粉少量与盐酸3-4滴，显红色。（检查黄酮）（2）薄层色谱 ①取粉末1g，加乙醚40ml于索氏提取器中回流提取至醚液无色，浓缩至干，以70%乙醇5ml溶解，作供试液。取黄芩素和汉黄苓素和汉黄芩素为对照品，分别点样于同一0.25mol/L草酸硅胶G薄板上，以氯仿-甲醇（10：1）展形，于紫外灯（365nm）下观察，黄芩素、汉黄芩素均为暗灰棕色。②上述乙醚提取后的残潭，挥尽乙醚，加50%乙醇浸泡过夜，回流2h，乙醇提取液作供试液。以黄芩甙对照品，分别点于同一聚酰胺板上，以氯仿-甲醇-丁酮-乙酰丙酮（16：10：5：1）展开，于紫外灯（365nm）下观察，黄芩甙为暗斑。"}]},{"ID":"20240611151513-ycl4end","Type":"NodeParagraph","Properties":{"id":"20240611151513-ycl4end","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611151513-varjoqv","Type":"NodeParagraph","Properties":{"id":"20240611151513-varjoqv","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 归肺；心；肝；胆；大肠经"}]},{"ID":"20240611151513-y10gb23","Type":"NodeParagraph","Properties":{"id":"20240611151513-y10gb23","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611151513-g00yclr","Type":"NodeParagraph","Properties":{"id":"20240611151513-g00yclr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒"}]},{"ID":"20240611151513-1i7pfs6","Type":"NodeParagraph","Properties":{"id":"20240611151513-1i7pfs6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611151513-6s77ivk","Type":"NodeParagraph","Properties":{"id":"20240611151513-6s77ivk","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 《本草经疏》：脾肺虚热者忌之。凡中寒作泄，中寒腹痛，肝肾虚而少腹痛，血虚腹痛，脾虚泄泻，肾虚溏泻，脾虚水肿，血枯经闭，气虚小水不利，肺受寒邪喘咳，及血虚胎不安，阴虚淋露，法并禁用。"}]},{"ID":"20240611151513-vodbxut","Type":"NodeParagraph","Properties":{"id":"20240611151513-vodbxut","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611151513-602f7f8","Type":"NodeParagraph","Properties":{"id":"20240611151513-602f7f8","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 清热泻火；燥湿解毒；止血；安胎。主肺热咳嗽；热病高热神昏；肝火头痛；目赤肿痛；湿热黄疸；泻痢；热淋；吐衄血；崩漏；胎热不安；痈肿疔疮"}]},{"ID":"20240611151513-f0r70tr","Type":"NodeParagraph","Properties":{"id":"20240611151513-f0r70tr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611151513-hrm2qxu","Type":"NodeParagraph","Properties":{"id":"20240611151513-hrm2qxu","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或入丸、散；外用：适量，煎水洗；或研末调敷。"}]},{"ID":"20240611151513-lfobxq9","Type":"NodeParagraph","Properties":{"id":"20240611151513-lfobxq9","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611151513-cac6px2","Type":"NodeParagraph","Properties":{"id":"20240611151513-cac6px2","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" ①治小儿心热惊啼：黄芩(去黑心)、人参各一分。捣罗为散。每服一字匕，，竹叶汤调下，不拘时候服(《圣济总录》黄芩散)②泻肺火，降隔上热痰：片子黄芩，炒，为末，糊丸，或蒸饼丸梧子大。服五十丸。(《丹溪心法》清金丸)③治慢性气管炎：黄芩、亭苈子各等分，共为细末，糖衣为片，每片含生药0．8克，每日三次，每次五片。(内蒙古《中草药新医疗法资料选编》)④治上呼吸道感染，肠炎：黄芩切碎，加四倍量水浸泡四小时，过胳残渣，再加二倍水浸泡两次，合并滤液，用20％明矾液倒入浸液中，调节pH为3．5(每100公斤黄芩，需明矾6～8公斤)，产生黄色沉淀，静置四小时，弃去上层清液，将沉淀物装人布袋中加水过滤，烘干，粉碎，造粒打片。侮次服二至三片。(辽宁《中草药新医疗法资料选编》)⑤治少阳头痛及太阳头痛，不拘偏正：片黄莽，酒浸透。晒千为未。每服一钱，茶、酒任下。(《兰室秘藏》小清空膏)⑥治太阳与少阳合病，自下利者：黄芥三两，芍药二两，甘草二两(炙)，大枣十二枚(擘)，上四味，以水一斗、煮取三升)去滓。温服一升，日再夜一服。(《伤寒论》黄芩汤)⑦治淋，亦主下血：黄芩四两，细切，以水五升，煮取二升，分三服。(《千金翼方》)。⑧治吐血衄血，或发或止，皆心脏积热所致：黄芩一两(去心中黑腐)，捣细罗为散。每服三钱，以水一中盏，煎至六分。不计时候，和滓温服。(《圣惠方》黄芩散调⑨治崩中下血：黄芥，为细未。每服一钱、烧秤锤淬酒调下。(《本事方》)⑩治妇人四十九岁已后，天癸却行 或过多不止：黄芩心枝条者二两(重用米醋，浸七日，炙干，又浸又炙。如此七次)。为细未，醋糊为丸，如梧桐子大。每服七十丸，空心温酒送下，日进二服。(《瑞竹堂经验方》芩心丸)11.安胎：白术、黄芩、炒曲。上为未，粥丸，服。(《丹溪心治》)12.治肝热生翳，不拘大人小儿：黄芩一两。淡豉三两，为未。每服三钱，以熟猪肝裹吃，温汤送下，日二服。忌酒、面。(《卫生家宝方》)、13.治眉眶痛，属风热与痰：黄芩(酒浸，炒)、白芷。上为未，茶清调二钱。(《丹溪心法》)14.治灸疮血出：酒炒黄芩二钱。为未，酒服。(《怪证奇方》)15.治火丹：杵黄芩末，水调敷之。(《梅师集验方》)16.治产后血渴，饮水不止：黄芩(新瓦上焙干)、麦门冬(去心)各半两。上件，细切。每服三钱，水一盏半，煎至八分，去滓温服，不拘时候。(《杨氏家藏方》)"}]},{"ID":"20240611151513-4tnb6mr","Type":"NodeParagraph","Properties":{"id":"20240611151513-4tnb6mr","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611151513-fawk8a6","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611151513-fawk8a6","updated":"20240611151513"},"Children":[{"ID":"20240611151513-rci2dxq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611151513-rci2dxq","updated":"20240611151513"},"Children":[{"ID":"20240611151513-onweec6","Type":"NodeParagraph","Properties":{"id":"20240611151513-onweec6","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"治疗小儿急性呼吸道感染： 用50%黄芩煎液，1岁以下每天6ml，1岁以上8-10ml，5岁以上酌加，皆分3次服。经治急性上呼吸道感染51例，急性支气管炎11例，急性扁桃休炎1例。治后体温降至正常、症状消失者51例，无效12例。体温多在3天内恢复正常，症状消失多为4 天。"}]}]},{"ID":"20240611151513-sptayw7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240611151513-sptayw7","updated":"20240611151513"},"Children":[{"ID":"20240611151513-5ouanyu","Type":"NodeParagraph","Properties":{"id":"20240611151513-5ouanyu","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"治疗慢性气管炎： 取黄芩1斤，甘草0.5斤，加水煎煮之次，得煎液3斤；另取生石灰1斤，加冷开水10斤，搅拌浸泡静置24小时，取上清液8斤。将煎液缓缓加入石灰水中，边加边搅拌，至pH呈7-8为止。每次20-25ml，日服3次。治疗35例，临床治愈之例，显效16例。对单纯型疗效较好。"}]}]},{"ID":"20240611151513-7o8p1df","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240611151513-7o8p1df","updated":"20240611151513"},"Children":[{"ID":"20240611151513-4ou99aj","Type":"NodeParagraph","Properties":{"id":"20240611151513-4ou99aj","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"治疗急性菌痢： 取黄芩、诃子等量，以明矾沉淀法提制成粉。每次3g，日服斗次，小儿酌减。对症治疗：失水者补液，高热者配合解热剂，治疗100例，平均2.5天症状消失，3.3天大便镜检正常，3天大便培养转阴，5天临床治愈。"}]}]},{"ID":"20240611151513-92z5t4b","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240611151513-92z5t4b","updated":"20240611151513"},"Children":[{"ID":"20240611151513-5z7bisw","Type":"NodeParagraph","Properties":{"id":"20240611151513-5z7bisw","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"治疗钩端螺旋体病： 取黄芩、银花、连翘等量，分别制成黄芩素及银花、连翘浸膏，混合制成片剂，每片重0.5g，相当于生药3.7g。每次10-15片，6小时服1次，小儿酌减。共洽65例，其中一个地区收治59例，治愈58例；另一地区收治6例，失败4例，疗效差异甚大，原因有待研究。有效病例服药后，开始降温时间平均为了1.5小时，体温恢复正常时间平均为1.8天，临床症状和体征大多在2-5天内减轻或消失。以对中、轻度病人疗效较好，退热较快；对重度晚期病人退热较慢，疗效较差。服药期间未见严重毒性反应，仅少数病例有轻微恶心。呕吐及腹泻现象，停药后即可消失。"}]}]},{"ID":"20240611151513-xfbw675","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20240611151513-xfbw675","updated":"20240611151513"},"Children":[{"ID":"20240611151513-lnesxha","Type":"NodeParagraph","Properties":{"id":"20240611151513-lnesxha","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"治疗传染性肝炎：将黄芥的提取物--黄芩素装胶囊，每粒0.25g。每次2粒，日服3次，儿童酌减。治疗急性传染性肝炎27例，自觉症状和体征均于1月内消失，肝功能恢复正常。其中治疗半月，谷丙转氨酶即降至正常者占74.1%。亦有用黄芩素针剂，每日肌注之毫升（含黄芩素40mg），1个月为一疗程，治疗急性无黄疸型肝炎13例，基本治愈4例，显效1例，有效6例。另曾配合胎盘组织液每天肌注之毫升，有腹水者配合利尿剂，治疗迁延性肝炎7例，基本治愈吐例，显效1例，有效2例；治疗慢性肝炎47例，基本治愈13例，显效6例，有效n例，无效14例。未见明显副作用。"}]}]}]},{"ID":"20240611151513-ot4yqh4","Type":"NodeParagraph","Properties":{"id":"20240611151513-ot4yqh4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"6.治疗肾炎、肾盂肾炎： 用黄芩提取物制成5%黄芩素注射液，每次肌注100-200mg（儿童减半），每日2次。共冶20例，治疗期间除配合卧床休息、低盐饮食外，均未兼用其他药物，结果急性肾炎11例，治愈（临床症状完全消失，复查尿液两次以上均正常）8例；好转（临床症状完全消失，复查尿液仅有少量红、白细胞）5例；肾盂肾炎9例，治愈、好转（标准同上）各4例，1例用药10天无变化）疗程最长17.5天，最短7天，平均12.5天。治愈病例临床症状的消失时间平均为9天，尿检恢复正常时间平均为15.6天。黄芩治疗肾病所以奏效，可能与其具有抗菌、降血压、利水等作用有关。"}]},{"ID":"20240611151513-dcckmvc","Type":"NodeParagraph","Properties":{"id":"20240611151513-dcckmvc","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"7.治疗高血压病： 将黄芩制成20%的酊剂，每次5-10ml方日服3次。治疗51例，服药前血压均在180/ 100mm汞往以上，服药1-12月后血压下降20/10mm汞拄以上者占70%以上。一般临床症状也随之消失或减轻。据观察，本药虽经较长时期服用，仍能发挥继续降压作用。无明显副作用＼此外，以黄芩煎剂预防猩红热，黄芩含片预防白喉，有一定作用。"}]},{"ID":"20240611151513-shhmd1h","Type":"NodeParagraph","Properties":{"id":"20240611151513-shhmd1h","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611151513-n0w6ay0","Type":"NodeParagraph","Properties":{"id":"20240611151513-n0w6ay0","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 1.《药对》：黄芩，得厚朴、黄连止腹痛：得五味子、牡蒙、牡蛎令人有子；得黄芪、白蔹、赤小豆疗鼠瘘。"}]},{"ID":"20240611151513-9b14lec","Type":"NodeParagraph","Properties":{"id":"20240611151513-9b14lec","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：张仲景治伤寒心下痞满，泻心汤四方皆用黄芩，以其主诸热，，利小肠故也。又太阳病下之利不止，有葛根黄芩黄连汤；及主妊娠安胎散，亦多用黄芩。"}]},{"ID":"20240611151513-zmbeeva","Type":"NodeParagraph","Properties":{"id":"20240611151513-zmbeeva","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"3.《医学启源》：黄芩，洽肺中湿热，疗上热目中肿赤，瘀血垄盛，必用之药。泄肺中火邪上逆于隔上，补膀恍之寒水不足，乃滋其化源。《主治秘诀》云，其用有九：泻肺经热，一一也；夏月须用，二也；上焦及皮肤风热，三也：去诸热，四也；妇人产后，养阴退阳，五也；利胸中气，六也；消隔上痰，七也；除上焦热及脾湿，八也；安胎，九也。单制、二制、不制，分上中下也。酒炒上行，主上部积血，非此不能除，肺苦气上逆，急食苦以泄之，正谓此也。"}]},{"ID":"20240611151513-iyjhsvj","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611151513-iyjhsvj","updated":"20240611151513"},"Children":[{"ID":"20240611151513-4o4imx1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240611151513-4o4imx1","updated":"20240611151513"},"Children":[{"ID":"20240611151513-1ptoaa4","Type":"NodeParagraph","Properties":{"id":"20240611151513-1ptoaa4","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"张元素：下痢脓血稠粘，腹痛后重，身热久不可者，黄芩与芍药、甘草同用。肌热及去痰用黄芩，上焦湿热亦用黄芬，泻肺火故也。疮痛不可忍者，用苦寒药，如黄芩、黄连，详上下，分梢根，及引经药用之。"}]}]},{"ID":"20240611151513-fg24kv7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20240611151513-fg24kv7","updated":"20240611151513"},"Children":[{"ID":"20240611151513-hk51zbo","Type":"NodeParagraph","Properties":{"id":"20240611151513-hk51zbo","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"李果：黄卒，味苦而薄，故能泄肺火而解肌热，手太阴剂也。细实而中不空者，洽下部妙。"}]}]},{"ID":"20240611151513-hksv62v","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240611151513-hksv62v","updated":"20240611151513"},"Children":[{"ID":"20240611151513-y21ritx","Type":"NodeParagraph","Properties":{"id":"20240611151513-y21ritx","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"朱震亨：黄芩降痰，假其降火也。凡去上焦湿热，须以酒洗过用。片芩泻肺火，须用桑白皮佐之。若肺虚者，多用则伤肺，必先以天门冬保定肺气一而后用之。黄芩、白尤乃安胎圣药，俗以黄卒为寒而不敢用，盖不知胎孕宜清热凉血，血不妄行，乃能养胎，黄芩乃上、中二焦药，能降火下行，白尤能补脾也。"}]}]}]},{"ID":"20240611151513-yjzs5xb","Type":"NodeParagraph","Properties":{"id":"20240611151513-yjzs5xb","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"7.《纲目》：洁古张氏言黄芩泻肺火，洽脾湿；东垣李氏言片芩治肺火，条芩治大肠火；丹溪朱氏言黄芩治上中二焦火；而张仲景治少阳证小柴胡汤，太阳、少阳合病下利黄芩汤，少阳证下后心下满而不痛：泻心汤并用之；成无己言黄芩苦而入乙，泄痞热，是黄芩能入手少阴、阳明、手足太阴、少阳六经矣。盖黄苹气寒味苦，苦入乙，寒胜热，泻心火，治脾之湿热，一则金不受刑，一则胃火不流入肺，即所以救肺也：肺虚不宜者，苦寒伤脾胃，损其母也。杨士瀛《直指方》云，柴胡退热，不及黄芩，盖亦不知柴胡之退热，乃音以发之，散火之标也，黄尊之热，乃寒能胜热，拆火之本也。黄芩得酒上行，得猪胆汁除肝胆热，得柴胡退寒热，得芍药治下痢，得桑白皮泻肺火，得白术安胎。"}]},{"ID":"20240611151513-pjoui4m","Type":"NodeParagraph","Properties":{"id":"20240611151513-pjoui4m","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"8.《本草经疏》：黄芩，其性清肃，所以除邪：味苦所以燥湿；阴寒所以胜热，故主诸热。诸热者，邪热与遍热也，黄疸、肠僻、泄痢，皆湿热胜之病也，析其本，则诸病自瘳矣。苦寒能除湿热，所以小肠利而水自逐，源清则流洁也。血闭者，实热在血分，即热人血室，令人经闭不通，湿热解，则荣气清而自行也。恶疮疽蚀者，血热则留结，而为痈肿渍烂也：火疡者，火气伤血也，凉血除热，则自愈也。《别录》消痰热者，热在胸中，则生痰火，在少腹则绞痛，小儿内热则腹痛，胃中湿热去，则胃安而消谷也。淋露下血,是热在阴分也：其治往来寒热者，邪在少阳也：五淋者，湿热胜所致也：苦寒清肃之气胜，则邪气自解，是伐其本也。黄菩为苦寒清肃之药，功在除热邪，而非补益之品，当与黄连并列，虽能清热利湿消痰，然苦寒能损胃气而伤脾阴，脾肺虚热者忌之。"}]},{"ID":"20240611151513-d7maugg","Type":"NodeParagraph","Properties":{"id":"20240611151513-d7maugg","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"9.《本草汇言》：清肌退热，柴胡最佳，然无黄芩不能凉肌达表。上焦之火，山桅可降，然舍黄芩不能上清头目。所以方脉科以之清肌退热，疮疡科以之解毒生肌，光明科以之散热明目，妇女科以之安胎理经，此盖诸科半表半里之首剂也。"}]},{"ID":"20240611151513-pp1wsep","Type":"NodeParagraph","Properties":{"id":"20240611151513-pp1wsep","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"10.《药品化义》：黄芩中枯者名枯芩，条细者名条芩，一品宜分两用。盖枯芩体轻主浮，专泻肺胃上焦之火，主治胸中逆气，隔上热痰，咳嗽喘急，目赤齿痛，吐衄失血，发斑发黄，痘疹疮毒，以其大能凉膈也。其条芩体重主降，专泻大肠下焦之火，主治大使闭结，小便淋浊，小腹急胀，肠红痢疾，血热崩中，胎漏下血，挟热腹痛，谵语狂言，以其能清大肠也。"}]},{"ID":"20240611151513-hom4red","Type":"NodeParagraph","Properties":{"id":"20240611151513-hom4red","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"11.《本经逢原》：昔人以柴胡去热不及黄芩，盖柴胡专主少阳往来寒热，少阳为枢，非柴胡不能宣通中外；黄芩专主阳明蒸热，阳明居中，非黄芩不能开泄蕴着，一主风木客邪，一主湿上蕴着，讵可混论。芩虽苦寒，毕竟治标之药，惟躯壳热者宜之，若阴虚伏热，虚阳发露，可轻试乎其条实者兼行冲脉，治血热妄行，古方有一味子芩丸，治女人血热，经水暴下不止者，最效。"}]},{"ID":"20240611151513-u2o6juo","Type":"NodeParagraph","Properties":{"id":"20240611151513-u2o6juo","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"12.《本经疏证》：仲景用黄芩有三耦焉，气分热结者，与柴胡为耦（小柴胡汤、大柴胡汤、柴胡桂枝干姜汤、柴胡桂枝汤）：血分热结者，与芍药为耦（桂枝柴胡汤、黄芩汤、大柴胡汤、黄连阿胶汤、鳖甲煎丸、大黄虫丸、奔汤、王不留行散、当归散）；湿热阻中者，与黄连为耦（半夏泻心汤、甘草泻心汤、生姜泻心汤、葛根黄芩黄连汤、于姜黄芩黄连人参汤）。以柴胡能开气分之结，不能泄气分之热，芍药能开血分之结，不能清迫血之热，黄连能治湿生之热，不能治热主之湿。譬之解斗，但去其斗者，未平其致斗之怒，斗终未已也。故黄芩协柴胡，能清气分之热，协芍药，能泄迫血之热，协黄连，能解热生之湿也。"}]},{"ID":"20240611151513-jvwj25n","Type":"NodeParagraph","Properties":{"id":"20240611151513-jvwj25n","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"13.《本经》：主诸热黄疸，肠僻，泄利，逐水，下血闭，（治）恶疮，疽蚀，火疡。"}]},{"ID":"20240611151513-cvylo62","Type":"NodeParagraph","Properties":{"id":"20240611151513-cvylo62","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"14.《别录》：疗痰热，胃中热，小腹绞痛，消谷，利小肠，女子血闭，淋露下血，小儿腹痛。"}]},{"ID":"20240611151513-503r5d0","Type":"NodeParagraph","Properties":{"id":"20240611151513-503r5d0","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"15.《滇南本草》：上行泻肺火，下行泻膀胱火，（治）男子五淋，女子暴崩，调经清热，胎有火热不安，清胎热，除六经实火实热。"}]},{"ID":"20240611151513-08zk8xk","Type":"NodeParagraph","Properties":{"id":"20240611151513-08zk8xk","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"16.《纲目》：治风热湿热头疼，奔豚热痛，火咳，肺痿喉，诸失血。"}]},{"ID":"20240611151513-8d3k6r9","Type":"NodeParagraph","Properties":{"id":"20240611151513-8d3k6r9","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"17.《本草正》：枯者清上焦之火，消痰利气，定喘嗽，止失血，退往来寒热，风热湿热，头痛，解瘟疫，清咽，疗肺痿肺痈，乳痈发背，尤法肌表之热，故治斑疹、鼠瘘，疮疡、赤眼；实者凉下焦之热，能除赤痢，热蓄膀胱，五淋涩痛，大肠闭结，便血、漏血。"}]},{"ID":"20240611151513-vv6hufu","Type":"NodeParagraph","Properties":{"id":"20240611151513-vv6hufu","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"18.《 科学的民间药草》：外洗创口，有防腐作用。"}]},{"ID":"20240611151513-gv8b754","Type":"NodeParagraph","Properties":{"id":"20240611151513-gv8b754","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611151513-yli3iur","Type":"NodeParagraph","Properties":{"id":"20240611151513-yli3iur","updated":"20240611151513"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611151515-k4iimcw","Type":"NodeThematicBreak","Properties":{"id":"20240611151515-k4iimcw"}},{"ID":"20240611151516-sbzcdz2","Type":"NodeParagraph","Properties":{"id":"20240611151516-sbzcdz2"}}]}