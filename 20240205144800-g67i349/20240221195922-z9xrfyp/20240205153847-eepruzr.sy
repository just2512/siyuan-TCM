es":{"parent-style":"width: 374px;","style":"width: 364px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄连"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄连-20240806125746-oo2f6zl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 364px;\" parent-style=\"width: 374px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 389px;","style":"width: 379px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄连 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄连 1-20240806130444-69cg1s2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 379px;\" parent-style=\"width: 389px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 420px;","style":"width: 410px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄连 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄连 2-20240806134338-z3s1thu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806132008-v0g02e4","Type":"NodeParagraph","Properties":{"id":"20240806132008-v0g02e4","updated":"20240806132017"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：生长五年以上的黄连才能入药；"}]},{"ID":"20240806140024-ibhstyz","Type":"NodeParagraph","Properties":{"id":"20240806140024-ibhstyz","updated":"20240806140035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：以上取图未按品种分类，为杂图；"}]},{"ID":"20240616124757-jumgsy1","Type":"NodeThematicBreak","Properties":{"id":"20240616124757-jumgsy1"}},{"ID":"20240616125247-2uy63vo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125247-2uy63vo","updated":"20240616125251"},"Children":[{"Type":"NodeText","Data":"黄连《神农本草经》"}]},{"ID":"20240616125247-7uq115r","Type":"NodeParagraph","Properties":{"id":"20240616125247-7uq115r","updated":"20240616125247"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240616125247-bo2m9x1","Type":"NodeParagraph","Properties":{"id":"20240616125247-bo2m9x1","updated":"20240616125247"},"Children":[{"Type":"NodeText","Data":"主热气，目痛，眦伤，泣出，明目（《御览》引云，主茎伤，《大观本》，无），肠澼，腹痛，下利，妇人阴中肿痛。久服，令人不忘。一名王连。生川谷。"}]},{"ID":"20240616125247-q23lvfk","Type":"NodeParagraph","Properties":{"id":"20240616125247-q23lvfk","updated":"20240616125247"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：黄连，神农岐伯黄帝雷公苦无毒，李氏小寒，或生蜀郡，太山之阳（《御览》）。"}]},{"ID":"20240616125247-8duq3yk","Type":"NodeParagraph","Properties":{"id":"20240616125247-8duq3yk","updated":"20240616125247"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生巫阳及蜀郡，太山，二月八月采。"}]},{"ID":"20240616125247-sjbr1h8","Type":"NodeParagraph","Properties":{"id":"20240616125247-sjbr1h8","updated":"20240616125247"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：王连，黄连也；《范子计然》云：黄连出蜀郡，黄肥坚者善。"}]},{"ID":"20240616125315-tpnj72v","Type":"NodeThematicBreak","Properties":{"id":"20240616125315-tpnj72v"}},{"ID":"20240616125316-s1rb3yz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125316-s1rb3yz","updated":"20240616125321"},"Children":[{"Type":"NodeText","Data":"黄连《神农本草经读》"}]},{"ID":"20240616125316-h9wmgrd","Type":"NodeParagraph","Properties":{"id":"20240616125316-h9wmgrd","updated":"20240616125316"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主热气目痛、伤泪出，明目，肠腹痛下痢，妇人阴中肿痛。久服令人不忘。"}]},{"ID":"20240616125316-wbe2vx5","Type":"NodeParagraph","Properties":{"id":"20240616125316-wbe2vx5","updated":"20240616125316"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶黄连气寒，禀天冬寒水之气，入足少阴肾；味苦无毒，得地南方之火味，入手少阴心。气水而味火，一物同具，故能除水火相乱，而为湿热之病。其云主热气者，除一切气分之热也。目痛、伤、泪出、不明，皆湿热在上之病；肠腹痛下痢，皆湿热在中之病；妇人阴中肿痛，为湿热在下之病；黄连除湿热，所以主之。久服令人不忘者，苦入心即能补心以其味之苦而补之；而寒能胜火，即以其气之寒而泻之。千古唯仲景得《本经》之秘。《金匮》治心气不足而吐血者，取之以补心；《伤寒》寒热互结心下而痞满者，取之以泻心；厥阴之热气撞心者，合以乌梅；下利后重者，合以白头翁等法。真信而好古之圣人也。"}]},{"ID":"20240616125523-azca1p3","Type":"NodeThematicBreak","Properties":{"id":"20240616125523-azca1p3"}},{"ID":"20240616125524-75qik4o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125524-75qik4o","updated":"20240616125528"},"Children":[{"Type":"NodeText","Data":"黄连《本草经解》"}]},{"ID":"20240616125524-oilslnk","Type":"NodeParagraph","Properties":{"id":"20240616125524-oilslnk","updated":"20240616125524"},"Children":[{"Type":"NodeText","Data":"气寒．味苦．无毒．主热气目痛 伤泪出．明目．肠 腹痛下痢．妇人阴中肿痛．久服令人不忘．（酒炒吴茱萸同炒姜汁炒）"}]},{"ID":"20240616125524-dskjt0c","Type":"NodeParagraph","Properties":{"id":"20240616125524-dskjt0c","updated":"20240616125524"},"Children":[{"Type":"NodeText","Data":"黄连气寒．禀天冬寒之水气．入足少阴肾经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．其主热气目痛者．心主火．火气热．心病舍肝．肝开窍于目也．黄连苦寒．所以清火也．手少阴之正．出于面．合目内 ．手少阴为心火．火盛则心系急而泪出．伤泪出皆心火也．黄连清心．所以主之．实则泻其子．心者肝木之子也．清心则肝邪泻．所以明目也．大肠为庚金之腑．心火乘之．则津液化成脓血．痛而下痢矣．其主之者．寒以清火．苦以泄热也．北方黑色．入通于肾．开窍于二阴．妇人阴中乃肾窍也．热胜则肿．肿痛者火盛也．黄连入肾．寒苦清火．所以主之．其久服令人不忘者．入心清火．火清则心明．能记忆也．"}]},{"ID":"20240616125524-n86xync","Type":"NodeParagraph","Properties":{"id":"20240616125524-n86xync","updated":"20240616125524"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616125524-pvt62zb","Type":"NodeParagraph","Properties":{"id":"20240616125524-pvt62zb","updated":"20240616125524"},"Children":[{"Type":"NodeText","Data":"黄连同西河柳、黄芩、黄柏、石膏、知母、甘草．治痧疹已透．烦躁不止．同当归、枣仁、圆肉、生地、黄芩、黄柏、黄 ．治火症盗汗．同槐花、枳壳、乳香、没药．治痢纯血腹痛．同五味、麦冬、干葛．治酒病．同麦冬、五味．治卒消渴小便多．同人参、莲子．治虚痢．专为末丸．名泻心丸．治心实心痛．同吴茱萸、神曲丸．治肝火作痛．同白术、陈皮、神曲丸．名四物丸．治胸中嘈杂作痛．同白茯．治思想所致白淫．同木香丸．名香连丸．治痢．同炮姜末．治气痢后重．"}]},{"ID":"20240616125512-enrtwho","Type":"NodeThematicBreak","Properties":{"id":"20240616125512-enrtwho"}},{"ID":"20240616125513-9orztuo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125513-9orztuo","updated":"20240616125518"},"Children":[{"Type":"NodeText","Data":"黄连《医学入门》"}]},{"ID":"20240616125513-5gvcj6j","Type":"NodeParagraph","Properties":{"id":"20240616125513-5gvcj6j","updated":"20240616125513"},"Children":[{"Type":"NodeText","Data":"黄连苦寒清心胃，目赤口疮胸痞滞，热呕热痢热毒疮，妇阴肿痛儿疳气。"}]},{"ID":"20240616125513-tolr68j","Type":"NodeParagraph","Properties":{"id":"20240616125513-tolr68j","updated":"20240616125513"},"Children":[{"Type":"NodeText","Data":"黄，晃也，象日光色也；连珠而生，上草也。无毒。味浓气薄，阴中阳也，入手少阴经。火就燥也，然泻心实泻脾胃，子令母实。心火因脾湿热而盛，故目为中焦使。药酒浸炒，则上行头目口舌；姜汁炒，辛散冲热有功，消心下痞满，伏梁积。热郁中焦欲吐不吐，恶心嘈杂吞酸，惊悸健忘，或卒心痛，热呕热泻热痢。一切湿热形瘦气急，一切时行热毒暑毒，诸般恶毒秽毒，诸疮疡毒，俱以姜和其寒，而少变其性，不使热有 牾也。"}]},{"ID":"20240616125513-vj6vqta","Type":"NodeParagraph","Properties":{"id":"20240616125513-vj6vqta","updated":"20240616125513"},"Children":[{"Type":"NodeText","Data":"生用治实火斑狂烦渴。吴萸水炒，调胃浓肠，治冷热不调，久痢久泻，肠 腹痛下血，益胆镇肝，止血行滞。"}]},{"ID":"20240616125513-xnxhae0","Type":"NodeParagraph","Properties":{"id":"20240616125513-xnxhae0","updated":"20240616125513"},"Children":[{"Type":"NodeText","Data":"黄土炒，治食积，安蛔虫，小儿疳病有虫好食泥土。盐水炒治下焦伏火，妇人阴中肿痛。心去，疗下焦虚，坚肾。《日华》云∶治五劳七伤，皆泻南补北之谓也。丹溪谓黄连治病，清心胃也。肠胃有寒及伤寒下早。阴虚下血及损脾而血不归元者，皆不可用。黄芩、龙骨为使，恶菊花、芫花、玄参，畏款冬花，胜乌头，解巴豆毒，忌猪肉、冷水。单方∶治小儿鼻下两道赤，名曰 鼻疳，以米泔洗，用黄连末敷之。"}]},{"ID":"20240616125501-9ptl43y","Type":"NodeThematicBreak","Properties":{"id":"20240616125501-9ptl43y"}},{"ID":"20240616125502-u1stk07","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125502-u1stk07","updated":"20240616125507"},"Children":[{"Type":"NodeText","Data":"黄连《本草经解》"}]},{"ID":"20240616125502-qvoyl8z","Type":"NodeParagraph","Properties":{"id":"20240616125502-qvoyl8z","updated":"20240616125502"},"Children":[{"Type":"NodeText","Data":"气寒．味苦．无毒．主热气目痛 伤泪出．明目．肠 腹痛下痢．妇人阴中肿痛．久服令人不忘．（酒炒吴茱萸同炒姜汁炒）"}]},{"ID":"20240616125502-2paimcg","Type":"NodeParagraph","Properties":{"id":"20240616125502-2paimcg","updated":"20240616125502"},"Children":[{"Type":"NodeText","Data":"黄连气寒．禀天冬寒之水气．入足少阴肾经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．其主热气目痛者．心主火．火气热．心病舍肝．肝开窍于目也．黄连苦寒．所以清火也．手少阴之正．出于面．合目内 ．手少阴为心火．火盛则心系急而泪出．伤泪出皆心火也．黄连清心．所以主之．实则泻其子．心者肝木之子也．清心则肝邪泻．所以明目也．大肠为庚金之腑．心火乘之．则津液化成脓血．痛而下痢矣．其主之者．寒以清火．苦以泄热也．北方黑色．入通于肾．开窍于二阴．妇人阴中乃肾窍也．热胜则肿．肿痛者火盛也．黄连入肾．寒苦清火．所以主之．其久服令人不忘者．入心清火．火清则心明．能记忆也．"}]},{"ID":"20240616125502-ixlvchl","Type":"NodeParagraph","Properties":{"id":"20240616125502-ixlvchl","updated":"20240616125502"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616125502-ci7art9","Type":"NodeParagraph","Properties":{"id":"20240616125502-ci7art9","updated":"20240616125502"},"Children":[{"Type":"NodeText","Data":"黄连同西河柳、黄芩、黄柏、石膏、知母、甘草．治痧疹已透．烦躁不止．同当归、枣仁、圆肉、生地、黄芩、黄柏、黄 ．治火症盗汗．同槐花、枳壳、乳香、没药．治痢纯血腹痛．同五味、麦冬、干葛．治酒病．同麦冬、五味．治卒消渴小便多．同人参、莲子．治虚痢．专为末丸．名泻心丸．治心实心痛．同吴茱萸、神曲丸．治肝火作痛．同白术、陈皮、神曲丸．名四物丸．治胸中嘈杂作痛．同白茯．治思想所致白淫．同木香丸．名香连丸．治痢．同炮姜末．治气痢后重．"}]},{"ID":"20240616125451-ckqlwfg","Type":"NodeThematicBreak","Properties":{"id":"20240616125451-ckqlwfg"}},{"ID":"20240616125452-1grgdn8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125452-1grgdn8","updated":"20240616125456"},"Children":[{"Type":"NodeText","Data":"黄连《医学入门》"}]},{"ID":"20240616125452-0ju2fad","Type":"NodeParagraph","Properties":{"id":"20240616125452-0ju2fad","updated":"20240616125452"},"Children":[{"Type":"NodeText","Data":"黄连苦寒清心胃，目赤口疮胸痞滞，热呕热痢热毒疮，妇阴肿痛儿疳气。"}]},{"ID":"20240616125452-saki9gb","Type":"NodeParagraph","Properties":{"id":"20240616125452-saki9gb","updated":"20240616125452"},"Children":[{"Type":"NodeText","Data":"黄，晃也，象日光色也；连珠而生，上草也。无毒。味浓气薄，阴中阳也，入手少阴经。火就燥也，然泻心实泻脾胃，子令母实。心火因脾湿热而盛，故目为中焦使。药酒浸炒，则上行头目口舌；姜汁炒，辛散冲热有功，消心下痞满，伏梁积。热郁中焦欲吐不吐，恶心嘈杂吞酸，惊悸健忘，或卒心痛，热呕热泻热痢。一切湿热形瘦气急，一切时行热毒暑毒，诸般恶毒秽毒，诸疮疡毒，俱以姜和其寒，而少变其性，不使热有 牾也。"}]},{"ID":"20240616125452-lgy8i3a","Type":"NodeParagraph","Properties":{"id":"20240616125452-lgy8i3a","updated":"20240616125452"},"Children":[{"Type":"NodeText","Data":"生用治实火斑狂烦渴。吴萸水炒，调胃浓肠，治冷热不调，久痢久泻，肠 腹痛下血，益胆镇肝，止血行滞。"}]},{"ID":"20240616125452-8ig0wsk","Type":"NodeParagraph","Properties":{"id":"20240616125452-8ig0wsk","updated":"20240616125452"},"Children":[{"Type":"NodeText","Data":"黄土炒，治食积，安蛔虫，小儿疳病有虫好食泥土。盐水炒治下焦伏火，妇人阴中肿痛。心去，疗下焦虚，坚肾。《日华》云∶治五劳七伤，皆泻南补北之谓也。丹溪谓黄连治病，清心胃也。肠胃有寒及伤寒下早。阴虚下血及损脾而血不归元者，皆不可用。黄芩、龙骨为使，恶菊花、芫花、玄参，畏款冬花，胜乌头，解巴豆毒，忌猪肉、冷水。单方∶治小儿鼻下两道赤，名曰 鼻疳，以米泔洗，用黄连末敷之。"}]},{"ID":"20240616125421-2u7kn0n","Type":"NodeThematicBreak","Properties":{"id":"20240616125421-2u7kn0n"}},{"ID":"20240616125422-9zcz6gw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125422-9zcz6gw","updated":"20240616125426"},"Children":[{"Type":"NodeText","Data":"黄连《名医别录》"}]},{"ID":"20240616125422-f44u30c","Type":"NodeParagraph","Properties":{"id":"20240616125422-f44u30c","updated":"20240616125422"},"Children":[{"Type":"NodeText","Data":"微寒，无毒．主治五脏冷热，久下泄 、脓血，止消渴、大惊，除水，利骨，调胃，肠，益胆，治口疮．生巫阳及蜀郡、太山．二月、八月采．（黄芩、龙骨、理石为之使，菊花、芫花、玄参、白藓，畏款冬，胜乌头，解巴豆毒．）"}]},{"ID":"20240616125422-h718zs4","Type":"NodeParagraph","Properties":{"id":"20240616125422-h718zs4","updated":"20240616125438"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶黄连，味苦，寒．主热气，目痛 伤泣出，明目，肠 腹痛下利，妇人阴中肿痛．久服令人不忘。一名王连。生川谷。"}]},{"ID":"20240616125610-r0v4l3d","Type":"NodeThematicBreak","Properties":{"id":"20240616125610-r0v4l3d"}},{"ID":"20240616125611-l7k7r4n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125611-l7k7r4n","updated":"20240616125616"},"Children":[{"Type":"NodeText","Data":"黄连《本草蒙筌》"}]},{"ID":"20240616125611-oz9r42u","Type":"NodeParagraph","Properties":{"id":"20240616125611-oz9r42u","updated":"20240616125611"},"Children":[{"Type":"NodeText","Data":"味苦，气寒。味浓气薄，可升可降，沉也，阴也，阴中微阳。无毒。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣连"},{"Type":"NodeText","Data":"出宣城，（苗收者。）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川连"},{"Type":"NodeText","Data":"生川省，瘦小苗多。（带苗收者。）并取类鹰爪连珠，日曝待甚干燥，布裹捋（音落）净须苗。治诸火邪，依各制炒。火在上炒以醇酒，火在下炒以童便。实火朴硝，虚火酽醋。痰火姜汁，伏火（火伏下焦者。）盐汤。气滞火同吴茱萸，血瘕火拌干漆末。食积泻亦可服，陈壁土（向东者妙。）"}]},{"ID":"20240616125611-hh4hzf0","Type":"NodeParagraph","Properties":{"id":"20240616125611-hh4hzf0","updated":"20240616125611"},"Children":[{"Type":"NodeText","Data":"研炒之。（硝茱漆土俱研细，调水和炒。）肝胆火盛欲驱，必求猪胆汁炒。又治赤眼，人乳浸蒸。或点或吞，立能劫痛。"}]},{"ID":"20240616125611-xwszohi","Type":"NodeParagraph","Properties":{"id":"20240616125611-xwszohi","updated":"20240616125611"},"Children":[{"Type":"NodeText","Data":"胜乌附，（乌头、附子。）畏款冬。恶芫菊（芫花、菊花。）玄参，忌猪肉冷水。为使黄芩龙骨，入手少阴心经。巴豆遇之，其毒即解。可熬膏煎液，任合散为丸。香连丸广木香和搀，为腹痛下痢要药；茱连丸吴茱萸佐助，乃吞吐酸水神方。如止消渴便多，单研蜜为丸亦效。同枳壳治血痔，同当归治眼疮。佐桂蜜煎服空心，（黄连为君，佐官桂少许，煎百沸入蜜，空心服之。）使心肾交于顷刻。镇肝凉血，（凡治血，防风为上使，黄连为中使，地榆为痫，泻心除痞病。去妇人阴户作肿，愈小儿食土成疳。消恶疮恶痈，却湿热郁热。又种生羌胡国土，因以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胡黄连"},{"Type":"NodeText","Data":"为名。干如杨柳枯枝，折断一线烟出。气平寒味尤苦甚，心内黑皮略淡黄。恶玄参菊花，亦解巴毒；忌猪肉误食，令人泄精。疗痨热骨蒸，治伤寒咳嗽。温疟多热即解，久痢成疳竟除。补肝胆劫目痛尤灵，理腰肾敛阴汗最捷。小儿盗汗潮热，妇人胎蒸虚惊。并宜用之，不可缺也。"}]},{"ID":"20240616125611-w9vk64v","Type":"NodeParagraph","Properties":{"id":"20240616125611-w9vk64v","updated":"20240616125611"},"Children":[{"Type":"NodeText","Data":"（谟）按∶苦先入心，火必就燥。黄连苦燥，乃入心经。虽云泻心实，泻脾脏为子能令母实，实则泻其子也。但久服之，反从火化，愈觉发热，不知有寒。故其功效惟初病气实热盛者，服之最良，而久病气虚发热，服之又反助其火也。"}]},{"ID":"20240616125554-3w3tthz","Type":"NodeThematicBreak","Properties":{"id":"20240616125554-3w3tthz"}},{"ID":"20240616125556-14yls0a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125556-14yls0a","updated":"20240616125601"},"Children":[{"Type":"NodeText","Data":"黄连《本草纲目》"}]},{"ID":"20240616125556-3h4vdya","Type":"NodeParagraph","Properties":{"id":"20240616125556-3h4vdya","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"「释名」亦名王连、支连。"}]},{"ID":"20240616125556-skjak01","Type":"NodeParagraph","Properties":{"id":"20240616125556-skjak01","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240616125556-734agkt","Type":"NodeParagraph","Properties":{"id":"20240616125556-734agkt","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616125556-to6uind","Type":"NodeParagraph","Properties":{"id":"20240616125556-to6uind","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"1、心经实热。用黄连七一，加水一碗半，煎成一碗，饭后过一阵（食远）温服。小儿减量。"}]},{"ID":"20240616125556-1iaab3e","Type":"NodeParagraph","Properties":{"id":"20240616125556-1iaab3e","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"2、伏暑发热、作渴、呕吐及赤白痢。用黄连一斤，切小，加好酒二升半煮干，再焙过、研细，糊成丸子，如梧子大。每服五十丸，一天服三次。此方名“黄龙丸”。"}]},{"ID":"20240616125556-own6g9m","Type":"NodeParagraph","Properties":{"id":"20240616125556-own6g9m","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"3、骨热黄瘦。用黄连四分，切小，加童便五大合，浸一夜，微煎三四沸，去喳，分二次服下。"}]},{"ID":"20240616125556-ykvmybe","Type":"NodeParagraph","Properties":{"id":"20240616125556-ykvmybe","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"4、小儿疳热（遍身疮蚀、潮热、肚胀、口渴）。用黄连五两，切碎，以水调湿，纳猪肚中，缝好，放在饭上蒸熟，连同少许饭烂捣烂做成丸子，如绿豆大。每服二十丸，米汤送下。另服调血清心的药，使病速愈。"}]},{"ID":"20240616125556-94gdayr","Type":"NodeParagraph","Properties":{"id":"20240616125556-94gdayr","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"5、消渴尿多。用黄连末和蜜成丸，如梧子大，每服三十丸。又方：黄连半斤，酒一升，放在开水锅里，煮一伏时，取出晒干，三细，滴水做成丸子，如梧子大。每服五十丸，温水送下。"}]},{"ID":"20240616125556-t3auy30","Type":"NodeParagraph","Properties":{"id":"20240616125556-t3auy30","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"6、小便如油（按：这是消渴晚期病伏）。用黄连五两、栝楼根五两，共研为末，加生地黄汁和成丸子，如梧子大。每服五十丸，牛乳送下。一天服二次。忌食冷水、猪肉。"}]},{"ID":"20240616125556-ak41wx0","Type":"NodeParagraph","Properties":{"id":"20240616125556-ak41wx0","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"7、破伤风。用黄连五钱，加酒一碗，煎至七成，再加黄蜡三钱溶化后，趁热服。"}]},{"ID":"20240616125556-3wfey2b","Type":"NodeParagraph","Properties":{"id":"20240616125556-3wfey2b","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"8、白浊。用黄连、白茯苓，等分为末，加酒、糊做成丸子，如梧子大。每服三十丸，以补骨脂煎汤送下。一天服三次。"}]},{"ID":"20240616125556-4deujvc","Type":"NodeParagraph","Properties":{"id":"20240616125556-4deujvc","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"9、痢症多血。用黄连一两，加水二升，煮成半斤，露一夜，次日烧热后空心服。又方：黄连一两，和鸡蛋白做饼，灸成紫色，研细，以浆水三升，慢火熬成膏。每服半合，温米汤送下。单以鸡蛋白调黄连末为丸服亦可。又方：黄连二两，切碎，放在瓦上焙焦，加当归一两（焙过），共研为末，再加麝香少许。每服二钱，陈米汤送下。"}]},{"ID":"20240616125556-6goz8eq","Type":"NodeParagraph","Properties":{"id":"20240616125556-6goz8eq","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"10、冷热诸痢。用黄连一两半、龙骨一两、大附子一个、干姜一两半、胶一两半，切细，加水五合，煮沸即停，稍冷再添水煮，如此反复九次，最后约得药汁一升，一顿服下。"}]},{"ID":"20240616125556-sdzqjfh","Type":"NodeParagraph","Properties":{"id":"20240616125556-sdzqjfh","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"11、痢疾腹痛，里急后重。用黄连、木香，等分为末，加蜜做成丸子，如梧子大。每服二、三十丸。一天服一次。此方名“香连丸”。"}]},{"ID":"20240616125556-adoktz6","Type":"NodeParagraph","Properties":{"id":"20240616125556-adoktz6","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"12、鸡冠痔。用黄连末涂搽，加入赤小豆末更好。"}]},{"ID":"20240616125556-za9uxmj","Type":"NodeParagraph","Properties":{"id":"20240616125556-za9uxmj","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"13、痔病秘结。用黄连、枳壳，等分为末，加糊做成丸子，如梧子大，每服五十丸，空心服，米汤送下。"}]},{"ID":"20240616125556-5kytfnc","Type":"NodeParagraph","Properties":{"id":"20240616125556-5kytfnc","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"14、水泄、脾泄。用黄连一两、生姜四两，同以文火炒至姜脆。取出，把两药分开，各研为末。水泄用姜末，脾泄用黄连末。每服二钱，空心服，开水送下。此方名“神圣香黄散”，亦治痢疾。"}]},{"ID":"20240616125556-ejuvevr","Type":"NodeParagraph","Properties":{"id":"20240616125556-ejuvevr","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"15、吐血不止。用黄连一两，捣碎，加鼓二十粒，水煎去渣，温服。"}]},{"ID":"20240616125556-6ueyub6","Type":"NodeParagraph","Properties":{"id":"20240616125556-6ueyub6","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"16、眼目诸病。用黄连不限多少，捣碎，浸清水中六十天，然后单取汁熬干。另用艾铺瓦上，燃艾，把熬干的药碗，盖在艾上，受到艾的烟熏。艾烟尽后，刮取碗底药末做成丸子，如小豆大。每服十丸，甜竹叶汤送下。"}]},{"ID":"20240616125556-vqskzep","Type":"NodeParagraph","Properties":{"id":"20240616125556-vqskzep","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"17、眼睛突然红痛。用黄边锉碎，浸在鸡蛋清里，经过一夜，次日，滤去渣，以鸡毛蘸蛋清点眼。又方：用黄连和冬青叶煎汤洗眼。又方：黄连、干姜、杏仁，等分为末，用棉包裹浸入热水中，趁热闭目淋洗。"}]},{"ID":"20240616125556-dr2nuh2","Type":"NodeParagraph","Properties":{"id":"20240616125556-dr2nuh2","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"18、双目痒痛。用黄连浸乳中，随时取汁点眼。"}]},{"ID":"20240616125556-s4vibvf","Type":"NodeParagraph","Properties":{"id":"20240616125556-s4vibvf","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"19、泪出不止。用黄连浸水成浓汁搽洗。"}]},{"ID":"20240616125556-24nmncs","Type":"NodeParagraph","Properties":{"id":"20240616125556-24nmncs","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"20、牙痛。用黄连末搽痛处。"}]},{"ID":"20240616125556-xbclj8w","Type":"NodeParagraph","Properties":{"id":"20240616125556-xbclj8w","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"21、口舌生疮。用黄连煎酒，时时含漱。"}]},{"ID":"20240616125556-det899b","Type":"NodeParagraph","Properties":{"id":"20240616125556-det899b","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"22、小儿口疳。用黄连、芦荟，等分为末。每服五分，蜜汤送下。如系走马疳，可再加蟾灰等分、青黛减半、麝香少许。"}]},{"ID":"20240616125556-dvhzn1b","Type":"NodeParagraph","Properties":{"id":"20240616125556-dvhzn1b","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"23、小儿耳后疮（称月月蚀）。用黄连末搽敷。"}]},{"ID":"20240616125556-8ydj16f","Type":"NodeParagraph","Properties":{"id":"20240616125556-8ydj16f","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"24、胎动出血。用黄连研末，每服一茶匙，酒送下。一天服三次。"}]},{"ID":"20240616125556-htop38d","Type":"NodeParagraph","Properties":{"id":"20240616125556-htop38d","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"25、妊妇心烦，不能睡眠。用黄连研末，每服一钱，清稀饭送下。"}]},{"ID":"20240616125556-ez6axoj","Type":"NodeParagraph","Properties":{"id":"20240616125556-ez6axoj","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"26、无名肿毒。用黄连、槟榔，等分为末，加鸡蛋清调匀搽患处。疮已溃或未溃，皆可用此方。"}]},{"ID":"20240616125556-19rq7da","Type":"NodeParagraph","Properties":{"id":"20240616125556-19rq7da","updated":"20240616125556"},"Children":[{"Type":"NodeText","Data":"27、中巴豆毒，下泻不止。用黄连、干姜，等分为末，取一茶匙，水冲服。"}]},{"ID":"20240616125541-qw692nf","Type":"NodeThematicBreak","Properties":{"id":"20240616125541-qw692nf"}},{"ID":"20240616125542-4iqfx52","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125542-4iqfx52","updated":"20240616125548"},"Children":[{"Type":"NodeText","Data":"黄连《本草述钩元》"}]},{"ID":"20240616125542-t3kfki8","Type":"NodeParagraph","Properties":{"id":"20240616125542-t3kfki8","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"雅州眉州者良。有二种。一根粗无毛。有连珠。形如鹰爪。其质坚实。其色深黄。一无珠多毛。中虚色淡黄。用各有所宜。（核）节多坚重。相击有声。色鲜明如赤金者善。芦多者劣。瘦小须多者。不堪入药。（原始）根味苦而浓。气寒而降。性冷而燥。阴也。入手少阴经。（苦入心。火就燥）并入手阳明足少阳厥阴足阳明太阴。经冬不凋。寒水之象。有节色黄。中土之制。心之用药也。（复）镇肝凉血。（本寒水之化以入心。故能凉血。凉血即所以镇肝。）调胃浓肠。主治郁热在中。"}]},{"ID":"20240616125542-gp8veaj","Type":"NodeParagraph","Properties":{"id":"20240616125542-gp8veaj","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"烦躁消渴。或兀兀欲吐。心下痞满。（仲景治九种心下痞。五等泻心汤。皆用之。）吞酸吐酸。"}]},{"ID":"20240616125542-b22v3gp","Type":"NodeParagraph","Properties":{"id":"20240616125542-b22v3gp","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"或卒心痛。并胁及小腹边痛。热呕热泻。一切湿热。腹痛热痢。五脏冷热。久下泄脓血。"}]},{"ID":"20240616125542-7gtsxiq","Type":"NodeParagraph","Properties":{"id":"20240616125542-7gtsxiq","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"疗暑毒。及一切天行热毒。诸疮疡毒。治热气目痛皆伤泪出。又小儿疳气。妇人阴中肿痛。"}]},{"ID":"20240616125542-5q67fo2","Type":"NodeParagraph","Properties":{"id":"20240616125542-5q67fo2","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"（诸本草）能泻心火。故本草言其宁神。治惊悸安神定惊等丸皆用之。（嵩）凡治血病。防风为上使。黄连为中使。（泻心实泻脾。故目为中焦使。）地榆为下使。（海藏）盖心为血主。黄连本寒水之化以入心。正所以调血而治肠诸病也。伤寒留蓄恶血。内外俱热。有证与少阳相似者。如服小柴胡不效。当以黄连一分。赤茯苓半分。入灯心煎与之。又大小产热入血室。小柴胡力所不及者。于内加五灵脂。仍以黄连赤苓佐之。盖心主血而连苓皆清心凉血之剂也。（仁斋）黄连入中土气分。去湿热而泻心火。若脾胃气虚不能转运者。以茯苓黄芩代之。（丹溪）丹溪治食积丸。首用黄连。以吴萸制连而治左。以益智制连而治右。佐以枳壳。消痞甚速。用姜汁制炒。治上焦痰火。（嘉谟）同木香用。治心下痞。并肠中积滞。"}]},{"ID":"20240616125542-ac1kwhq","Type":"NodeParagraph","Properties":{"id":"20240616125542-ac1kwhq","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"为腹痛下痢之要药。同吴萸用。治肝火。兼胁与小腹边痛。又为吞吐酸水要药。（嵩）黄连为病酒之仙药。滞下之神草。六经所至。各有殊功。（仲淳）诸苦寒药多泄。惟连柏性冷而燥。能降火去湿而止泻痢。故治痢以之为君。盖治痢惟宜辛苦寒药。辛能发散。开通郁结。"}]},{"ID":"20240616125542-h2wy0z9","Type":"NodeParagraph","Properties":{"id":"20240616125542-h2wy0z9","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"苦能燥湿。寒能胜热。使气宣平而已。（守真）下痢。胃口热。噤口者。用黄连人参煎汤。"}]},{"ID":"20240616125542-rhyum3e","Type":"NodeParagraph","Properties":{"id":"20240616125542-rhyum3e","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"终日呷之。如吐。再强饮。但得一呷下咽。便好。（丹溪）以黄土姜汁酒蜜四炒为君。使君子为臣。酒白芍为佐。木香为使。治小儿五疳。以吴萸同炒。加木香等分。生大黄倍之。水丸。治五痢。（韩）治痢。用干姜黄连。名姜连散。治消渴。用酒蒸黄连。治口疮。用细辛黄连。不独相制而无偏胜之患。亦审其受病之浅深。脏腑之上下以制使也。同赤柽叶入三黄石膏汤。治痧疹已透而烦躁不止。入当归六黄汤。加枣仁龙眼。治盗汗。同地黄甘菊荆芥穗甘草梢柴胡川芎木通蝉蜕。治风热上攻。目赤痛。同芍药扁豆莲子升麻滑石甘草红曲。治一切滞下脓血。同槐花枳壳乳香没药。治滞下纯血腹痛。同人参莲子。治虚人患痢。及老人产妇滞下不止。同麦冬五味。治卒消渴。小便多。同五谷虫芦荟白芜荑青黛白槿花白芙蓉花。"}]},{"ID":"20240616125542-78esokt","Type":"NodeParagraph","Properties":{"id":"20240616125542-78esokt","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"治小儿一切疳热。"}]},{"ID":"20240616125542-bs3hyoz","Type":"NodeParagraph","Properties":{"id":"20240616125542-bs3hyoz","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"附方香连丸。治赤白诸痢。里急后重腹痛。用宣黄连青木香等分。捣筛。白蜜丸梧子大。每服二三十丸下。日再服。神效。久冷者。以煨蒜捣和丸之。此李绛兵部手集方。易简治痢。黄连用吴萸炒过四两。木香面煨过一两。粟米饭丸。丹溪用治噤口痢。加石莲肉。王氏治痢。渴加乌梅肉。以阿胶化和为丸。秘传香连丸。治气痢后重。（济生方）黄连四两。"}]},{"ID":"20240616125542-vm6o7s9","Type":"NodeParagraph","Properties":{"id":"20240616125542-vm6o7s9","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"木香二两。生姜四两。以姜铺砂锅底。次铺连。上铺香。入新汲水三碗煮。焙研。醋调仓米糊为丸。如常日服五次。变通丸。治赤白下痢日夜无度。及肠风下血。用川黄连去毛。吴萸汤泡过。各二两。同炒香拣出。各为末。以粟米饭和丸。梧子大。水收。每服三十丸。赤痢。"}]},{"ID":"20240616125542-5fuh3vf","Type":"NodeParagraph","Properties":{"id":"20240616125542-5fuh3vf","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"甘草汤下黄连丸。白痢。姜汤下吴萸丸。赤白痢。各用十五丸。米汤下。姜黄散。用宣连一两。生姜四两。同以文火炒至姜脆。各自拣出为末。水泄。用姜末。脾泄。用连末。每服二钱。空心白汤下。甚者不过二服。亦治痢疾。蒜连丸。治脏毒下血。用独囊蒜煨捣。和黄连末为丸。日日米汤服之。按黄连为痢疾要药。而香连之制。升以佐降。真有妙理。盖痢病概本于肺气不行。木香能除肺中滞气。夫以寒理热。更调升降。而除其滞气。故此方永利也。"}]},{"ID":"20240616125542-gsi9y4q","Type":"NodeParagraph","Properties":{"id":"20240616125542-gsi9y4q","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"后之或用姜。或用茱。亦自有别。生姜由肺而胃。助苦寒以达气。而热乃行。似于气分居多。"}]},{"ID":"20240616125542-6j8oivu","Type":"NodeParagraph","Properties":{"id":"20240616125542-6j8oivu","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"吴萸由肝而脾。助苦燥以除湿。而热乃清。似于血分为多。以湿热固在血分也。至于伏暑用酒煮。为干于心胞络。胞络主血也。久冷及脏毒下血。并用煨蒜和丸。为其辛热喜散。更能通五脏而清血分之滞着也。"}]},{"ID":"20240616125542-sm2fsvk","Type":"NodeParagraph","Properties":{"id":"20240616125542-sm2fsvk","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"〔论〕黄连本寒水至阴气味。而色象与告成之时。俱归中土。（其花黄。六月结黄实。"}]},{"ID":"20240616125542-sh1ndrt","Type":"NodeParagraph","Properties":{"id":"20240616125542-sh1ndrt","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"根亦黄。六七月根紧乃堪采。）盖寒水不假黄婆。则何以得交于火。此天然妙理。在物性亦有然者也。（离中裕坎。丁壬有合也。肾脉支者注胸中。而脾与肝肾同上行。脾脉注于心中。）先哲曰。心是天真神机开发之本。胃是谷气充大真气之标。标本相得。则膻中所留宗气。"}]},{"ID":"20240616125542-pt86ni6","Type":"NodeParagraph","Properties":{"id":"20240616125542-pt86ni6","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"（即督脉之注于胸中者）乃能流布四脏而不为病。（即真气与谷气并而充身之谓）然则胃中谷气所以充大宗气。而脾脉之合肾肝以注心者。岂不为心之用欤。心之用病。是即病乎心也。"}]},{"ID":"20240616125542-hlgjvf4","Type":"NodeParagraph","Properties":{"id":"20240616125542-hlgjvf4","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"海藏云。黄连泻心。其实泻脾。丹溪谓黄连治病。在清心胃。皆非臆说。夫人身一水不胜二火。而六淫七情之与正气戾者。即化为热。从六淫则由肺而胃。（肺阴不降入心。则清中之浊不能入胃而生血。以还为心病）。从七情则由心而胃。此味主治。皆本于阳中之太阳。不能合于寒水真阴以为病者。（阳中阴少。则气郁而化热。热郁久则化湿。惟黄连本寒水之化。"}]},{"ID":"20240616125542-858zgja","Type":"NodeParagraph","Properties":{"id":"20240616125542-858zgja","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"以为中土之用。其性味兼得乎燥金。故于郁热湿热之病。最为中的。）抑心之用病。莫先于中土。而黄连治热之郁。郁而化湿者。亦莫先于中土。正对待以奏功也。能致寒水之化以归中土。若风木本达寒水之化以上奉者。是以肝病即次及之。而又谓其能浓肠胃者。以燥性即在苦寒中。而手足阳明皆燥金。同气相求故也。"}]},{"ID":"20240616125542-ufpsszc","Type":"NodeParagraph","Properties":{"id":"20240616125542-ufpsszc","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"缪氏云。凡病患血少气虚。脾胃薄弱。泄泻腹痛者。犯之危殆。服时大忌猪肉。惟实热盛者宜服。若胃中停食受寒。及伤寒下早致痞。俱不可用。除肠红因湿热者固宜。若阴虚下血。及损脾血下者。俱禁用。"}]},{"ID":"20240616125542-t9sml7f","Type":"NodeParagraph","Properties":{"id":"20240616125542-t9sml7f","updated":"20240616125542"},"Children":[{"Type":"NodeText","Data":"〔修治〕入痢疾药。取真川连折之。中有孔。色如赤金者。去须切片。分开粗细。各置姜汁透。用绵纸衬。先用山黄土炒干。研细。再炒至将红。以连片隔纸放土上。炒干。再拌姜汁。切不可用水。纸焦易新者。如是九次为度。若赤痢。则用湿槐花拌炒。至于治本脏之火。则生用。治肝胆实火。以猪胆汁浸炒。治肝胆虚火。醋浸炒。治上焦之火。则酒炒。治中焦火。姜汁炒。治下焦火。盐水炒。朴硝炒。治气分湿热之火。以吴萸汤浸炒。治血分块中伏火。干漆水炒。诸法不独为之导引。盖辛热能制其苦寒。盐寒能制其燥性。用者详之。"}]},{"ID":"20240616125353-ckrieuu","Type":"NodeThematicBreak","Properties":{"id":"20240616125353-ckrieuu"}},{"ID":"20240616125355-nhwc999","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125355-nhwc999","updated":"20240616125358"},"Children":[{"Type":"NodeText","Data":"黄连《本草从新》"}]},{"ID":"20240616125355-9zprkbp","Type":"NodeParagraph","Properties":{"id":"20240616125355-9zprkbp","updated":"20240616125355"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻火燥湿．"}]},{"ID":"20240616125355-3wpyx25","Type":"NodeParagraph","Properties":{"id":"20240616125355-3wpyx25","updated":"20240616125355"},"Children":[{"Type":"NodeText","Data":"大苦大寒．入心泻火．（海藏曰∶泻心实泻脾也、实则泻其子．）镇肝凉血．（凡治血、防风为上部之使、黄连为中部之使、地榆为下部之使．）燥湿开郁．解渴除烦．消心瘀．（能去心窍恶血．）止盗汗．（凉心．）治热毒诸痢．（致痢之由不一、若止因湿热而气实者、连为要药、嘉言曰∶治痢必先汗解其外、后调其内、首用辛凉以解表、次用苦寒以清里．痢有虚实寒热之分、白属气分、红属血分、红热白寒之说非也、须凭脉证、而为凉泻温补．）痞满嘈杂．吞酸吐酸．（因肝火郁而成者、同吴萸降火开郁．）腹痛心痛伏梁．（心积．）目痛 伤．（人乳浸点、或合归芍等分、煎汤热洗、散热活血、亦佳．）痈疽疮疥．（诸疮痛痒、皆属心火．）酒毒明目．定惊止呕．（热郁恶心、兀兀欲吐、可用数分．）解毒除疳．杀蛔．蛔得苦则伏．）虚寒为病．大忌．（久服黄连苦参、反热从火化也、盖炎上作苦、味苦必燥、燥则热矣、且苦寒沉阴肃杀、伐伤生和之气也．或用甘草以调其苦、或加人参以节制之、其庶几乎．）黄连种数甚多．雅州连，细长弯曲．微黄无毛．有硬刺．马湖连，色黑细毛．绣花针头硬刺．形如鸡爪．此二种最佳．云南连，体松．软毛．无硬刺．古勇连，（产云南古勇山．）体重无毛．无硬刺．此二种次之．水连头．（又名鲁连、产川中．）体松．有毛．无硬刺．又次之．新山连．（产广西．）光黄性重．断则淡黄色．土连．（产处州．）色黑．团节．（马药中用之．）鸡屎连．色黑细小．断则淡绿色．以上三种．服之害人．云景连．（产云南．）色黑．断则红色．不入药．川中种连．色黄．软毛．无硬刺．味微苦而薄．服之无效．去毛．治心火．生用．肝胆火．猪胆汁炒．上焦火、酒炒．中焦火、姜汁炒．下焦火、盐水炒．（或童便炒．）食积火、黄土炒．湿热在气分．吴萸汤炒．在血分．醋炒．（时珍曰∶诸法不独为之引导、盖辛热制其苦寒、咸寒制其燥性、用者详之．）黄芩、龙骨为使．恶菊花、元参、僵蚕、白藓皮．畏款冬、牛膝．忌猪肉．（时珍曰∶方有脏连丸、黄连猪肚丸、岂忌肉而不忌脏腑乎．）杀乌头、巴豆毒．"}]},{"ID":"20240616125407-ih0vbyz","Type":"NodeThematicBreak","Properties":{"id":"20240616125407-ih0vbyz"}},{"ID":"20240616125408-nol1hk5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125408-nol1hk5","updated":"20240616125411"},"Children":[{"Type":"NodeText","Data":"黄连《千金翼方》"}]},{"ID":"20240616125408-1d26c95","Type":"NodeParagraph","Properties":{"id":"20240616125408-1d26c95","updated":"20240616125408"},"Children":[{"Type":"NodeText","Data":"味苦，寒，微寒无毒。主热气，目痛 伤，泪出，明目，肠 ，腹痛下痢，妇人阴中痛，五脏冷热，久下泻 脓血，止消渴，大惊，除水，利骨，调胃，浓肠，益胆，疗口疮。"}]},{"ID":"20240616125342-xz2dwiz","Type":"NodeThematicBreak","Properties":{"id":"20240616125342-xz2dwiz"}},{"ID":"20240616125343-nn0wsmi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125343-nn0wsmi","updated":"20240616125348"},"Children":[{"Type":"NodeText","Data":"黄连《本草备要》"}]},{"ID":"20240616125343-hf3w7x3","Type":"NodeParagraph","Properties":{"id":"20240616125343-hf3w7x3","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"泻火，燥湿"}]},{"ID":"20240616125343-59yfnl9","Type":"NodeParagraph","Properties":{"id":"20240616125343-59yfnl9","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"大苦大寒。入心泻火（王海藏曰∶泻心，实泻脾也。实则泻其子），镇肝凉血（凡治血，防风为上部之使，黄连为中部之使，地榆为下部之使），燥湿开郁，解渴（单用能治消渴）"}]},{"ID":"20240616125343-nq7pk5d","Type":"NodeParagraph","Properties":{"id":"20240616125343-nq7pk5d","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"除烦，益肝胆，浓肠胃，消心瘀（能去心窍恶血），止盗汗（凉心）。"}]},{"ID":"20240616125343-feogkmp","Type":"NodeParagraph","Properties":{"id":"20240616125343-feogkmp","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"治肠 泻痢（便血曰 ，有脏连丸。湿热郁而为痢，黄连治痢要药。噤口者，热壅上焦，同人参煎汤呷之，但得下咽便好。喻嘉言曰∶下痢，必先汗解其外，后调其内。首用辛凉以解表，次用苦寒以攻里。《机要》云∶后重宜下，腹痛宜和，身重宜除湿，脉弦宜去风，风邪内结宜汗，身冷自汗宜温，脓血稠粘宜重剂以竭之。下痢，赤属血分，白属气分。戴氏曰∶俗谓赤热、白寒者，非也。通作湿热处治，但有新久、虚实之分），痞满（燥湿开郁。"}]},{"ID":"20240616125343-8wfyzl9","Type":"NodeParagraph","Properties":{"id":"20240616125343-8wfyzl9","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"张仲景治九种心下痞，五等泻心汤皆用之）腹痛（清热），心痛伏梁（心积），目痛 伤（人乳浸点或合归、芍等分，煎汤热洗，散热活血），痈疽疮疥（诸痛痒疮，皆属心火），酒毒胎毒（小儿初生，合甘草为末，蜜调令咽之），明目（《传信方》∶羊肝一具，黄连一两，捣丸，名羊肝丸，凡是目疾皆治）定惊（镇肝），止汗解毒，除疳（同猪肝蒸为丸）杀蛔（蛔得苦则伏）。虚寒为病者禁用（久服黄连、苦参反热，从火化也。昂按∶炎上作苦，味苦必燥，燥则热矣，旦苦寒沉阴肃杀，伐伤生和之气也。韩 曰∶黄连与肉桂同行，能交心肾于顷刻。"}]},{"ID":"20240616125343-6q5y4ns","Type":"NodeParagraph","Properties":{"id":"20240616125343-6q5y4ns","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"时珍曰∶治痢用香连丸，姜连丸用黄连、干姜，姜黄散用黄连、生姜，左金丸用黄连、吴茱萸，治口疮用黄连、细辛，止下血用黄连、大蒜，一阴一阳，寒因热用，热因寒用，最得制方之妙）。出宜州者粗肥，出四川者瘦小。状类鹰爪、连珠者良。去毛。治心火生用，虚火醋炒，肝、胆火猪胆汁炒，上焦火酒炒（有吞酸嘈杂等证，亦有吐酸者名酢心，宜黄连。吴茱萸降火开郁。酢，音醋），中焦火姜汁炒，下焦火盐水或童便炒，食积火黄士炒，治湿热在气分，吴茱萸汤炒，在血分干漆水炒，点眼赤人乳浸（时珍曰∶诸法不独为之引导，盖辛热制其寒苦，咸寒制其燥性，用者详之）。黄芩龙骨为使。恶菊花、玄参、僵蚕、白鲜皮。"}]},{"ID":"20240616125343-s1tgs0y","Type":"NodeParagraph","Properties":{"id":"20240616125343-s1tgs0y","updated":"20240616125343"},"Children":[{"Type":"NodeText","Data":"畏款冬、牛膝。忌猪肉（时珍曰∶方有脏连丸、黄连猪肚丸，岂忌肉而不忌脏腑乎？）。杀乌头、巴豆毒。（黄连泻心火，佐以龙胆泻肝、胆火，白芍泻脾火，石膏泻胃火，知母泻肾火，黄柏泻膀胱火，木通泻小肠火。黄芩泻肺火，栀子佐之；泻大肠火，黄连佐之；柴胡泻肝胆火，黄连佐之；泻三焦火，黄芩佐之。郑奠一曰∶兀兀欲吐，用黄连数分甚效）。"}]},{"ID":"20240616125326-t814y41","Type":"NodeThematicBreak","Properties":{"id":"20240616125326-t814y41"}},{"ID":"20240616125327-7w9efnb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125327-7w9efnb","updated":"20240616125336"},"Children":[{"Type":"NodeText","Data":"黄连《本草图经》"}]},{"ID":"20240616125327-8frlvy6","Type":"NodeParagraph","Properties":{"id":"20240616125327-8frlvy6","updated":"20240616125333"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄连"},{"Type":"NodeText","Data":"，生巫阳川谷及蜀郡泰山，今江、湖、荆、夔州郡亦有，而以宣城者为胜，施、黔者次之。苗高一尺以来，叶似甘菊，四月开花黄色，六月结实似芹子，色亦黄。二月、八月采根用。生江左者根若连珠，其苗经冬不凋，叶如小雉尾草，正月开花，作细穗，淡白微黄色，六、七月根紧始堪采。古方以黄连为治痢之最。胡洽方载九盏汤，主下痢，不问冷热赤白，谷滞休息久下，悉主之。以黄连长三寸三十枚，秤重一两半，龙骨如棋子四枚，重四分，附子大者一枚，干姜一两半，胶一两半，并切。先以水五合，着铜器中，去火三寸，煎沸便下，着生土上，沸止，又上水五合，如此九上九下。内诸药着火上，沸辄下，着土上，沸止又复，九上九下，度可得一升，顿服，即止。又香连丸，亦主下痢，近世盛行其法，以宣连、青木香分两停，同捣筛，白蜜丸如梧子，空腹饮下二、三十丸，日再，如神。其久冷人，即用煨熟大蒜作丸。此方本出李绛《兵部手集方》，婴孺用之亦效。又治目方，用黄连多矣。而羊肝丸尤奇异，取黄连末一大两，白羊子肝一具，去膜，同于砂盆内研令极细，众手捻为丸如梧子，每食心暖浆水吞二七枚，连作五剂，瘥。但是诸眼目疾及障翳青盲，皆主之。禁食猪肉及冷水。刘禹锡云∶有崔承元者，因官治一死罪囚出活之，囚后数年以病自致死。一旦崔为内障所苦，丧明，逾年后，半夜叹息，独坐时，闻阶除间悉 之声，崔问为谁？曰∶是昔所蒙活者囚，今故报恩至此，遂以此方告讫而没。崔依此合服，不数月，眼复明，因传此方于世。又今医家洗眼汤，以当归、芍药、黄连等分停，细切，以雪水或甜水煎浓汁，乘热洗，冷即再温洗，甚益眼目。但是风毒、赤目、花翳等，皆可用之。其说云∶凡眼目之病，皆以血脉凝滞使然，故以行血药合黄连治之。血得热即行，故乘热洗之，用者无不神效。"}]},{"ID":"20240616125306-ohg4zsw","Type":"NodeThematicBreak","Properties":{"id":"20240616125306-ohg4zsw"}},{"ID":"20240616125307-epl81s3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125307-epl81s3","updated":"20240616125311"},"Children":[{"Type":"NodeText","Data":"黄连《药鉴》"}]},{"ID":"20240616125307-c6u77tw","Type":"NodeParagraph","Properties":{"id":"20240616125307-c6u77tw","updated":"20240616125307"},"Children":[{"Type":"NodeText","Data":"气寒味苦，气薄味浓，无毒，沉也，阴也。手少阴药也。以姜汁炒用，则止呕吐，清心胃。且治一切时气，又解诸般热毒秽毒，及肿毒疮疡，目疾之暴发者。盖黄连得姜汁制，则和其寒而性轻折，且少变其性，以引至热处，而使之驯化，正经所谓热因寒用是也。与木香同用，为腹痛下痢要药。与吴茱萸同用，乃吞吐酸水神方。同枳壳治血痔，同当归治眼疾。"}]},{"ID":"20240616125307-m6pya1g","Type":"NodeParagraph","Properties":{"id":"20240616125307-m6pya1g","updated":"20240616125307"},"Children":[{"Type":"NodeText","Data":"佐桂蜜，使心肾交于顷刻。入姜辛，疗心肺妙于须臾。欲上清头目口疮之类，酒炒为佳。欲泻肝胆之火，猪胆蒸之为妙，取其入下部而泻之也。欲解痘疮之毒，桔梗麻黄汁炒之，取其达表而解之也。实火同朴硝，虚火用酾醋，痰火用姜汁，伏火用盐汤。米食积泻者，壁土炒之。赤眼暴发者，人乳浸之。东垣以为浓肠胃者，何也？盖肠胃为湿热所挠，而为痢为痛，得此苦寒之剂，则湿热去而痛止，则肠胃自浓矣。又曰，与木香同用，治心下痞满，并伏梁心积，宜矣。若停食受寒，及伤寒下早所使者，则不可用。又曰，除肠中混杂之红，宜矣。"}]},{"ID":"20240616125307-ddqpl7q","Type":"NodeParagraph","Properties":{"id":"20240616125307-ddqpl7q","updated":"20240616125307"},"Children":[{"Type":"NodeText","Data":"如阴虚下血，及损脾而血不归脾者，概用之乎。又曰，治五劳七情，定惊悸，止心腹痛，皆未分寒热而混言之，用者宜斟酌可也。"}]},{"ID":"20240616125307-faqin2s","Type":"NodeParagraph","Properties":{"id":"20240616125307-faqin2s","updated":"20240616125307"},"Children":[{"Type":"NodeText","Data":"胡黄连疗劳热骨蒸，治伤寒咳嗽，温疟多热即解，久痢成疳竟除。补肝胆，劫目疼尤灵。"}]},{"ID":"20240616125307-ln6ow8d","Type":"NodeParagraph","Properties":{"id":"20240616125307-ln6ow8d","updated":"20240616125307"},"Children":[{"Type":"NodeText","Data":"理腰肾，敛阴汗最捷。大都苦先入心，入心则热燥，此剂虽云泻心，实泻脾土，盖子能令母实，实则泻其子也。中病即已，不可久服，久则反从火化，愈觉发热。故曰，芩连栀子，久服发热，此之谓也。反花猪肉。"}]},{"ID":"20240616125256-b1nmb7v","Type":"NodeThematicBreak","Properties":{"id":"20240616125256-b1nmb7v"}},{"ID":"20240616125257-o204qi8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125257-o204qi8","updated":"20240616125301"},"Children":[{"Type":"NodeText","Data":"黄连《本草经集注》"}]},{"ID":"20240616125257-8wv7lyl","Type":"NodeParagraph","Properties":{"id":"20240616125257-8wv7lyl","updated":"20240616125257"},"Children":[{"Type":"NodeText","Data":"味苦，寒、微寒，无毒。主治热气，目痛， 伤泪出，明目，肠 ，腹痛。下痢，妇人阴中肿痛。五脏冷热，久下泄 脓血，止消渴，大惊，除水，利骨，调胃，浓肠，益胆，治口疮。久服令人不忘。一名王连。生巫阳川谷及蜀郡太山。二月、八月采。（黄芩、龙骨、理石为之使，恶菊花、芫花、玄参、白藓，畏款冬，胜乌头，解巴豆毒。）"}]},{"ID":"20240616125257-9vv4dch","Type":"NodeParagraph","Properties":{"id":"20240616125257-9vv4dch","updated":"20240616125257"},"Children":[{"Type":"NodeText","Data":"巫阳在建平。今西间者色浅而虚，不及东阳、新安诸县最胜。临海诸县者不佳。用之当布裹 去毛，令如连珠。世方多治下痢及渴，道方服食长生。"}]},{"ID":"20240616124758-uq1wznj","Type":"NodeThematicBreak","Properties":{"id":"20240616124758-uq1wznj"}},{"ID":"20240616125238-nis14o0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125238-nis14o0","updated":"20240616125242"},"Children":[{"Type":"NodeText","Data":"黄连《长沙药解》"}]},{"ID":"20240616125238-6txjxg7","Type":"NodeParagraph","Properties":{"id":"20240616125238-6txjxg7","updated":"20240616125238"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主热气，目痛，眦伤，泣出，明目，肠澼，腹痛，下利，妇人阴中肿痛。久服，令人不忘。一名王连。生川谷。"}]},{"ID":"20240616125238-05m9f6f","Type":"NodeParagraph","Properties":{"id":"20240616125238-05m9f6f","updated":"20240616125238"},"Children":[{"Type":"NodeText","Data":"味苦，性寒，入手少阴心经。清心退热，泻火除烦。"}]},{"ID":"20240616125238-4h219zf","Type":"NodeParagraph","Properties":{"id":"20240616125238-4h219zf","updated":"20240616125238"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄连汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄连三两，桂枝三两，甘草三两，干姜三两，人参二两，大枣十二枚，半夏半升。"},{"Type":"NodeText","Data":"治太阴伤寒，胸中有热，胃中有邪气，腹中痛，欲呕吐者。以中气虚寒，木邪克土，脾陷而贼于乙木，故腹中痛，胃逆而贼于甲木，故欲呕吐。君火不降，故胸中有热。姜、甘、参、枣，温中而补土，桂枝达乙木而止疼，半夏降戊土而止呕，黄连清君火而泻热也。"}]},{"ID":"20240616125238-umg3rx2","Type":"NodeParagraph","Properties":{"id":"20240616125238-umg3rx2","updated":"20240616125238"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄连阿胶汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄连四两，黄芩一两，芍药二两，阿胶三两，鸡子黄二枚。水五升，煎二升，去滓，入胶，消化，内鸡子黄，搅，温分三服。"},{"Type":"NodeText","Data":"治少阴病，心烦不得卧。少阴水火同经，水胜则火负，火胜则水负。火本不胜水，其所以胜者，火旺而土燥也。君火下蛰，则心清而善寐，君火上亢，则心烦而不得卧。缘坎水根于离阴，燥土克水，消耗心液，神宇不清，是以生烦。黄连清君火而除烦，芩、芍清相火而泻热，阿胶、鸡子黄，补脾精而滋燥土也。"}]},{"ID":"20240616125238-z3ku08g","Type":"NodeParagraph","Properties":{"id":"20240616125238-z3ku08g","updated":"20240616125238"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄连粉"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黄连。研末，水调服。"},{"Type":"NodeText","Data":"治浸淫疮。以土湿火升，郁生上热，湿热浸淫，结为毒疮。从口而走四肢则生，从四肢而入口则死。黄连泻湿热之浸淫也。"}]},{"ID":"20240616125238-z0gmygq","Type":"NodeParagraph","Properties":{"id":"20240616125238-z0gmygq","updated":"20240616125238"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄黄连泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"治太阳伤寒，误下成痞。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"附子泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在附子。"},{"Type":"NodeText","Data":"治心下痞硬，恶寒汗出。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"甘草泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在甘草。"},{"Type":"NodeText","Data":"治心下痞硬，干呕心烦。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生姜泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在生姜。"},{"Type":"NodeText","Data":"治心下痞硬，干噫食臭。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半夏泻心汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在半夏。"},{"Type":"NodeText","Data":"治少阳伤寒，心下痞满。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葛根黄连黄芩汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在葛根。"},{"Type":"NodeText","Data":"治中风下后，喘而汗出。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"干姜芩连人参汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在干姜。"},{"Type":"NodeText","Data":"治厥阴吐下后，食入即吐。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小陷胸汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在栝蒌。"},{"Type":"NodeText","Data":"治小结胸，脉浮滑者。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白头翁汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在白头翁。"},{"Type":"NodeText","Data":"治厥阴下利，热渴饮水者。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌梅丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在乌梅。"},{"Type":"NodeText","Data":"治厥阴蛔厥，心中疼热。皆用之，以其泻心君之火也。"}]},{"ID":"20240616125238-qcsnwbh","Type":"NodeParagraph","Properties":{"id":"20240616125238-qcsnwbh","updated":"20240616125238"},"Children":[{"Type":"NodeText","Data":"火蛰于土，土燥则火降而神清，土湿则火升而心烦。黄连苦寒，泻心火而除烦热，君火不降，湿热烦郁者宜之。土生于火，火旺则土燥，火衰则土湿，凡太阴之湿，皆君火之虚也。虚而不降，则升炎而上盛。其上愈盛，其下愈虚，当其上盛之时，即其下虚之会。故仲景黄连清上诸方，多与温中暖下之药并用，此一定之法也。凡泻火清心之药，必用黄连，切当中病即止，不可过剂，过则中下寒生，上热愈甚。庸工不解，以为久服黄连，反从火化，真可笑也。"}]},{"ID":"20240616124758-4k441kp","Type":"NodeThematicBreak","Properties":{"id":"20240616124758-4k441kp"}},{"ID":"20240616125223-3zjwsfh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125223-3zjwsfh","updated":"20240616125231"},"Children":[{"Type":"NodeText","Data":"黄连《吴普本草》"}]},{"ID":"20240616125223-81mowgr","Type":"NodeParagraph","Properties":{"id":"20240616125223-81mowgr","updated":"20240616125223"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十一"}]},{"ID":"20240616125223-kqk5mhi","Type":"NodeParagraph","Properties":{"id":"20240616125223-kqk5mhi","updated":"20240616125223"},"Children":[{"Type":"NodeText","Data":"神农、岐伯、黄帝、雷公∶苦，无毒。李氏∶小寒。或生蜀郡、太山之阳。"}]},{"ID":"20240616124758-2odjv88","Type":"NodeThematicBreak","Properties":{"id":"20240616124758-2odjv88"}},{"ID":"20240616125212-mkf3j9s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125212-mkf3j9s","updated":"20240616125217"},"Children":[{"Type":"NodeText","Data":"黄连《新修本草》"}]},{"ID":"20240616125212-92rzz5t","Type":"NodeParagraph","Properties":{"id":"20240616125212-92rzz5t","updated":"20240616125212"},"Children":[{"Type":"NodeText","Data":"味苦，寒、微寒，无毒。主热气，目痛 伤泣出，明目，肠 ，腹痛，下痢，妇人阴中肿痛。五脏冷热，久下泄 ，脓血，止消渴，大惊，除水利骨，调胃，浓肠，益胆，疗口疮。久生巫阳川谷及蜀郡太山。二月、八月采。"}]},{"ID":"20240616125212-fa2htl1","Type":"NodeParagraph","Properties":{"id":"20240616125212-fa2htl1","updated":"20240616125212"},"Children":[{"Type":"NodeText","Data":"黄芩、龙骨、理石为之使，恶菊花、芫花、玄参、白藓，畏款冬，胜乌头，解巴豆毒。"}]},{"ID":"20240616125212-0pijhzj","Type":"NodeParagraph","Properties":{"id":"20240616125212-0pijhzj","updated":"20240616125212"},"Children":[{"Type":"NodeText","Data":"巫阳在建平。今西间者色浅而虚，不及东阳、新安诸县最胜。临海诸县者不佳。用之当布裹 去毛，令如连珠。俗方多疗下痢及渴，道方服食长生。"}]},{"ID":"20240616125212-7gyzl6m","Type":"NodeParagraph","Properties":{"id":"20240616125212-7gyzl6m","updated":"20240616125212"},"Children":[{"Type":"NodeText","Data":"〔谨案〕蜀道者粗大节平，味极浓苦，疗渴为最。江东者节如连珠，疗痢大善。今沣州者更胜。"}]},{"ID":"20240616124758-38sqly4","Type":"NodeThematicBreak","Properties":{"id":"20240616124758-38sqly4"}},{"ID":"20240616124907-r2nhhai","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124907-r2nhhai","updated":"20240616124912"},"Children":[{"Type":"NodeText","Data":"黄连《药征》"}]},{"ID":"20240616124907-ohtep8f","Type":"NodeParagraph","Properties":{"id":"20240616124907-ohtep8f","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"主治心中烦悸也。旁治心下痞、吐下、腹中痛。"}]},{"ID":"20240616124907-exo68l2","Type":"NodeParagraph","Properties":{"id":"20240616124907-exo68l2","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240616124907-vk4tvds","Type":"NodeParagraph","Properties":{"id":"20240616124907-vk4tvds","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"黄连阿胶汤证曰∶心中烦、不得卧。"}]},{"ID":"20240616124907-iiuueab","Type":"NodeParagraph","Properties":{"id":"20240616124907-iiuueab","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"以上一方，黄连四两。"}]},{"ID":"20240616124907-9w4gz47","Type":"NodeParagraph","Properties":{"id":"20240616124907-9w4gz47","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"黄连汤证曰∶胸中有热、腹中痛、欲呕吐。"}]},{"ID":"20240616124907-tpj4xgn","Type":"NodeParagraph","Properties":{"id":"20240616124907-tpj4xgn","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"干姜黄连黄芩人参汤证曰∶吐下。"}]},{"ID":"20240616124907-00h66hs","Type":"NodeParagraph","Properties":{"id":"20240616124907-00h66hs","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"葛根黄连黄芩汤证曰∶利遂不吐。"}]},{"ID":"20240616124907-licloch","Type":"NodeParagraph","Properties":{"id":"20240616124907-licloch","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"白头翁汤证曰∶下利欲饮水。"}]},{"ID":"20240616124907-ewsjhot","Type":"NodeParagraph","Properties":{"id":"20240616124907-ewsjhot","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"以上四方，黄连皆三两。"}]},{"ID":"20240616124907-osdh3cc","Type":"NodeParagraph","Properties":{"id":"20240616124907-osdh3cc","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"大黄黄连泻心汤证曰∶心下痞、按之濡。"}]},{"ID":"20240616124907-sl8bnwx","Type":"NodeParagraph","Properties":{"id":"20240616124907-sl8bnwx","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"泻心汤证曰∶心气不足。"}]},{"ID":"20240616124907-7gve18h","Type":"NodeParagraph","Properties":{"id":"20240616124907-7gve18h","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"附子泻心汤证曰∶心下痞。"}]},{"ID":"20240616124907-sqx3lg8","Type":"NodeParagraph","Properties":{"id":"20240616124907-sqx3lg8","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"以上三方，黄连皆一两，而亦三两之例。"}]},{"ID":"20240616124907-q63mcob","Type":"NodeParagraph","Properties":{"id":"20240616124907-q63mcob","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"上历观此诸方，黄连治心中烦悸也明矣。故心中烦悸而痞者、吐者、利者、腹痛者，用此皆治也。此外用黄连一两方多，其比余药分量差少，但举心胸之微疾，不足取而征焉！故不枚举也。"}]},{"ID":"20240616124907-nq3p4os","Type":"NodeParagraph","Properties":{"id":"20240616124907-nq3p4os","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240616124907-gmocc4v","Type":"NodeParagraph","Properties":{"id":"20240616124907-gmocc4v","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"张仲景用黄连。其证与人参、茯苓，大同而小异。说在人参部。"}]},{"ID":"20240616124907-cv3pjdo","Type":"NodeParagraph","Properties":{"id":"20240616124907-cv3pjdo","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"黄连阿胶汤证曰∶心中烦。此方黄连为君，而有心中烦之证，斯可以见其主治矣。泻心汤证曰∶心气不足，而吐血衄血者，泻心汤主之。既云不足，又云泻心，此后世论说之所由起也；然《千金方》不足作不定，斯仲景之古也。而不定者，烦悸之谓也。凡病心中烦悸、心下痞、按之濡者，用此汤皆治也。由是观之，所谓不定者，烦悸之谓也。"}]},{"ID":"20240616124907-c5sctzk","Type":"NodeParagraph","Properties":{"id":"20240616124907-c5sctzk","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"【辨误】"}]},{"ID":"20240616124907-2brm90a","Type":"NodeParagraph","Properties":{"id":"20240616124907-2brm90a","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"夫万物生于天也，故天命之谓性。性唯一也，其能亦唯一也，谓之良能。然其有多能者，性之所枝而岐也，非性之本也，谓之蠃能。人之眩蠃能，而谓性多能者多矣。余尝读本草，举其主治甚多。夫主治也者，性之能也。一物一性，岂有此多能哉！今近取譬于人之多能乎？"}]},{"ID":"20240616124907-uqf7tl9","Type":"NodeParagraph","Properties":{"id":"20240616124907-uqf7tl9","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"夫人之性也，有任焉者，有清焉者，有和焉者，有直焉者，虽圣人不可移易也；而有多能焉，有无能焉，多能非求于天性之外而成焉，无能非求于天性之中而无焉。人其性而用之，则多能也，是善于用其性者也，非由天性而多能也，故天性任焉者，用而多能，则尽其性之任而已。任之外，无有其能也。清则清，和则和，直则直，从性之一而贯之，不可移易也。亦有学而修之，以成其多能者，若天性然，然非去性而然，亦与性成者也。此所以论于人之道，而非所以论于草根木皮也。夫善于用人性之能者若彼，而况于草根木皮乎？性之外，无有多能，而一草何多能之有？夫黄连之苦，治心烦也，是性之为能也，张仲景用焉，而治心下痞呕吐，下利之证也，是性之所枝而岐也，故无心烦之状者，试之无效。如心烦者，其应如响。仲景治心下痞，呕吐下利，其方用黄连者甚多，斯亦可以征也。由是观之，黄连主治心烦也，本草之谬也明矣。黄连之能多乎哉，不多也。"}]},{"ID":"20240616124907-ugpr19a","Type":"NodeParagraph","Properties":{"id":"20240616124907-ugpr19a","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240616124907-i754o71","Type":"NodeParagraph","Properties":{"id":"20240616124907-i754o71","updated":"20240616124907"},"Children":[{"Type":"NodeText","Data":"黄连 处处出焉，出于本邦越中者，为上品，世所谓加贺黄连是也。贪利之贾，成以郁金色之，不可不择也，锉用。"}]},{"ID":"20240616124758-ewk0ib5","Type":"NodeThematicBreak","Properties":{"id":"20240616124758-ewk0ib5"}},{"ID":"20240616124849-8dqrgxl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124849-8dqrgxl","updated":"20240616124856"},"Children":[{"Type":"NodeText","Data":"黄连《证类本草》"}]},{"ID":"20240616124849-8e882ne","Type":"NodeParagraph","Properties":{"id":"20240616124849-8e882ne","updated":"20240616124849"},"Children":[{"Type":"NodeText","Data":"味苦，寒、微寒，无毒。主热气，目痛 伤泣出，明目，肠 腹痛，下痢，妇人阴中肿痛，五脏冷热，久下泄 脓血。止消渴、大惊，除水利骨，调胃浓肠，益胆，疗口疮。久服令人不忘。一名王连。生巫阳川谷及蜀郡、泰山，二月、八月采。（黄芩、龙骨、理石为之使，恶菊花、芫花、玄参、白藓，畏款冬，胜乌头，解巴豆毒。）"}]},{"ID":"20240616124849-yu76j5f","Type":"NodeParagraph","Properties":{"id":"20240616124849-yu76j5f","updated":"20240616124849"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶巫阳在建平。今西间者，色浅而虚，不及东阳、新安诸县最胜。临海诸县者不佳。用之当布裹挪去毛，令如连珠。俗方多疗下痢及渴，道方服食长生。唐本注云∶蜀道者粗大节平，味极浓苦，疗渴为最。江东者节如连珠，疗痢大善。今澧州者更胜。今注医家见用宣州九节坚重、相击有声者为胜。臣禹锡等谨按蜀本图经云∶苗似茶，花黄丛生，一茎生三叶，高尺许，冬不凋。江左者节高若连珠。蜀都者，节下不连珠。今秦地及杭州、柳州者佳。药性论云∶黄连，臣。一名支连，恶白僵蚕，忌猪肉，恶冷水。杀小儿疳虫，点赤眼昏痛，镇肝去热毒。萧炳云∶今出宣州绝佳，东阳亦有，歙州、处州者次。陈藏器云∶主羸瘦气急。日华子云∶治五劳七伤，益气，止心腹痛，惊悸烦躁，润心肺，长肉止血，并疮疥，盗汗，天行热疾。猪肚蒸为丸，治小儿疳气。"}]},{"ID":"20240616124849-7afr5w8","Type":"NodeParagraph","Properties":{"id":"20240616124849-7afr5w8","updated":"20240616124849"},"Children":[{"Type":"NodeText","Data":"图经曰∶黄连，生巫阳川谷及蜀郡、泰山，今江、湖、荆、夔州郡亦有，而以宣城者为胜，施、黔者次之。苗高一尺以来，叶似甘菊，四月开花，黄色。六月结实似芹子，色亦黄。二月、八月采根用。生江左者，根若连珠，其苗经冬不凋，叶如小雉尾草，正月开花作细穗，淡白微黄色，六、七月根紧始堪采。古方以黄连为治痢之最，胡洽方载九盏汤，主下痢，不问冷热、赤白、谷滞、休息、久下悉主之。以黄连长三寸三十枚秤重一两半，龙骨如棋子四枚重四分，附子大者一枚，干姜一两半，胶一两半，并切。先以水五合，着铜器中，去火三寸，煎沸便下，着生土上，沸止又上水五合，如此九上九下；纳诸药着火上，沸辄下，着土上，沸止又复，九上九下，度可得一升，顿服即止。又香连丸亦主下痢，近世盛行。其法以宣连、青木香分两停同捣筛，白蜜丸如梧子，空腹饮下二、三十丸，日再，如神。其久冷人，即用煨熟大蒜作丸。此方本出李绛《兵部手集方》，婴孺用之亦效。又治目方用黄连多矣，而羊肝丸尤奇异，取黄连末一大两，白羊子肝一具，去膜，同于砂盆内，研令极细，众手拈为丸如梧子。每食以暖浆水吞二七枚，连作五剂，瘥。但是诸眼目疾及障翳、青盲皆主之，禁食猪肉及冷水。刘禹锡云，有崔承元者，因官治一死罪囚出活之，囚后数年以病自致死。一旦，崔为内障所苦，丧明逾年后，半夜叹息独坐，时闻阶除间悉KT 之声，崔问为谁？曰是昔所蒙活者囚，今故报恩至此，遂以此方告讫而没。崔根据此合服，不数月，眼复明，因传此方于世。又今医家洗眼汤，以当归、芍药、黄连等分停，细切，以雪水或甜水煎浓汁，乘热洗，冷即再温洗，甚益眼目，但是风毒赤目、花翳等，皆可用之，其说云∶凡眼目之病，皆以血脉凝滞使然，故以行血药合黄连治之，血得热即行，故乘热洗之，用者无不神效。"}]},{"ID":"20240616124849-ucdvofz","Type":"NodeParagraph","Properties":{"id":"20240616124849-ucdvofz","updated":"20240616124849"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，以布拭上肉毛，然后用浆水浸二伏时，漉出，于柳木火中焙干用。若服此药得十两，不得食猪肉。若服至三年，不得食猪肉一生也。外台秘要∶治卒心痛。黄连八两，一味咀，以水七升，煮取五升，绞去滓，寒温饮五合，日三服。又方∶治目卒痒，目痛。末黄连，乳汁浸，点 中止。千金方∶治大热毒纯血痢。宣连六两，以水七升，煮取三升半，夜露星月下，平旦空腹顿服之，少卧将息。肘后方∶治眼泪出不止，浓汁渍绵干拭目。又方∶赤痢热下，久不止。黄连末，鸡子白丸，饮服十丸，三十丸即瘥。又方∶治卒消渴，小便多。捣黄连，绢筛，蜜和，服三十丸，治渴延年。又方∶赤白痢下，令人下部疼重，故名重下，出脓血如鸡子白，日夜数十行，绞脐痛。治之∶黄连一升，酒五升，煮取一升半，分再服，当小绞痛。经验方∶治暴赤白痢如鹅、鸭肝者，痛不忍。黄连、黄芩各一两，以水二升，煎取一升，分三服，热吃，冷即凝矣。梅师方∶伤寒病，发豌豆疮，未成脓方∶黄连四两，水三升，煎取一升，去滓分服。斗门方∶治痔疾有头如鸡冠者。用黄连末，敷之即瘥，更加赤小豆末尤良。简要济众小儿吐血不止。以一两去须，捣为散，每服一钱，水七分，入豉二十粒，同煎至五分，去滓，温服，量儿大、小加减进。博济方∶治久患脾泄，神圣香黄散∶宣连一两，生姜四两，一处以慢火炒，令姜干脆，色深，去姜取连捣末，每服二钱匕，空心腊茶清下。甚者不过二服，瘥。胜金方∶治眼黄连丸∶宣连不限多少，捶碎。用新汲水一大碗，浸至六十日后，用绵滤过取汁，入元碗内，却于重汤上熬，不住以匙荡搅，候干为度。即穿地坑子可深一尺，以瓦铺底，将熟艾四两，坐在瓦上，以火然如灸法。然后以药碗覆上，四畔封泥，开孔令烟出尽即止，取出刮下，丸如小豆大，每服十丸，甜竹叶汤下。又方∶治久痢，累医不瘥。黄连一两为末，以鸡子白和为饼，炙令如紫肝色，杵为末，以浆水三升，慢火煎成膏。白痢加酒半盏同煎，每服半合，温米饮调下，食前服。广利方∶治骨节热积渐黄瘦。黄连四分，碎切，以童子小便五大合。浸经宿，微煎三、四沸，去滓，食上分两服，如人行四、五里再服。杜壬治气痢泻，里急后重。神妙方∶宣连一两，干姜半两，各为末。每用连二钱，姜半钱，和匀，空心温酒下。子母秘录因惊举重，胎动出血。取黄连末，酒服方寸匕，日三服。孙尚药同。又方∶小儿赤白痢多时，体弱不堪。宣连浓煎，和蜜服。日六、七服，量其大小，每煎三分水减二分，频服。又方∶小儿耳后月蚀疮，末黄连敷之。又方∶小儿鼻下两道赤者名曰 ，亦名赤鼻疳。鼻以米泔洗，敷黄连末，日三、四度，佳。姚和众∶小儿方小儿食土。取好土浓煎黄连汁搜之，日干与服。抱朴子∶乳汁煎之，治目中百病。宋王微∶黄连赞黄连味苦，左右相因。断凉涤暑，阐命轻身。缙云昔御，飞跸上 。不行而至，吾闻其人。梁江淹黄连颂黄连上草，丹砂之次。御孽辟妖，长灵久视。骖龙行天，驯马匝地。鸿飞以仪，顺道则利。"}]},{"ID":"20240616124849-bsngjsz","Type":"NodeParagraph","Properties":{"id":"20240616124849-bsngjsz","updated":"20240616124849"},"Children":[{"Type":"NodeText","Data":"衍义曰∶黄连，今人多用治痢，盖热以苦燥之义。下俚但见肠虚渗泄，微似有血便，即用之更不知止。又罔顾寒热多少，但以尽剂为度，由是多致危困。若气实初病，热多血利，服之便止，仍不必尽剂也。或虚而冷，则不须服。余如《经》。"}]},{"ID":"20240616125733-o61gkwa","Type":"NodeThematicBreak","Properties":{"id":"20240616125733-o61gkwa"}},{"ID":"20240616125734-44w5nsf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125734-44w5nsf","updated":"20240616125740"},"Children":[{"Type":"NodeText","Data":"黄连《本草崇原》"}]},{"ID":"20240616125734-htb7x8o","Type":"NodeParagraph","Properties":{"id":"20240616125734-htb7x8o","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治热气，目痛， 伤泣出，明目，肠 ，腹痛下痢，妇人阴中肿痛。久服令人不忘。"}]},{"ID":"20240616125734-v3eb5oy","Type":"NodeParagraph","Properties":{"id":"20240616125734-v3eb5oy","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"（黄连始出巫阳山谷，及蜀郡太山之阳，今以雅州者为胜。苗高尺许，似茶丛生，一茎三叶，凌冬不凋，四月开花黄色，六月结实如芹子，色亦黄，根如连珠，形如鸡距，外刺内空。"}]},{"ID":"20240616125734-r1vhpd1","Type":"NodeParagraph","Properties":{"id":"20240616125734-r1vhpd1","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"）"}]},{"ID":"20240616125734-fwl58h7","Type":"NodeParagraph","Properties":{"id":"20240616125734-fwl58h7","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"黄连生于西蜀，味苦气寒，禀少阴水阴之精气。主治热气者，水滋其火，阴济其阳也。"}]},{"ID":"20240616125734-lss5wce","Type":"NodeParagraph","Properties":{"id":"20240616125734-lss5wce","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"目痛、伤泣出者，火热上炎于目，则目痛而 肉伤， 肉伤则泣出。又曰∶明目者，申明治目痛， 伤泣出，以其能明目也。肠 者，火热内乘于阴，夫热淫于内，薄为肠 ，此热伤阴分也。腹痛下痢者，风寒暑湿之邪伤其经脉，不能从肌腠而外出，则下行肠胃，致有肠痛下痢之证。黄连泻火热而养阴，故治肠 腹痛下痢。妇人阴中肿痛者，心火协相火而交炽也。黄连苦寒，内清火热，故治妇人阴中肿痛。久服令人不忘者，水精上滋，泻心火而养神，则不忘也。大凡苦寒之药，多在中品下品，唯黄连列于上品者，阴中有阳，能济君火而养神也。"}]},{"ID":"20240616125734-cooyrih","Type":"NodeParagraph","Properties":{"id":"20240616125734-cooyrih","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"少阴主水而君火在上，起冬不落叶。"}]},{"ID":"20240616125734-dewpqvl","Type":"NodeParagraph","Properties":{"id":"20240616125734-dewpqvl","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"凡物性有寒热温清燥润，及五色五味。五色五味以应五运，寒热温清燥润以应六气，是以上古司岁备物。如少阴君火，少阳相火司岁，则备温热之药。太阳寒水司岁，则备阴寒之药。"}]},{"ID":"20240616125734-d5ts95w","Type":"NodeParagraph","Properties":{"id":"20240616125734-d5ts95w","updated":"20240616125734"},"Children":[{"Type":"NodeText","Data":"厥阴风木司岁，则备清凉之药。太阴湿土司岁，则备甘润之药。阳明燥金司岁，则备辛燥之药。岐伯曰∶司岁备物得天地之专精，非司岁备物则气散也。后世不能效上古之预备，因加炮制以助其力。如黄连水浸，附子火炮，即助寒水君火之火。后人不体经义，反以火炒黄连，尿煮附子。"}]},{"ID":"20240616125734-999t150","Type":"NodeParagraph","Properties":{"id":"20240616125734-999t150","updated":"20240616125750"},"Children":[{"Type":"NodeText","Data":"寒者热之，热者寒之，是制也，非制也。譬之鹰犬之力，在于爪牙。今束其爪，缚其牙，亦何贵乎鹰犬哉?"}]},{"ID":"20240616125654-u7eu4gi","Type":"NodeThematicBreak","Properties":{"id":"20240616125654-u7eu4gi"}},{"ID":"20240616125656-49hyhgj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125656-49hyhgj","updated":"20240616125700"},"Children":[{"Type":"NodeText","Data":"黄连《神农本草经百种录》"}]},{"ID":"20240616125656-fjg8rqo","Type":"NodeParagraph","Properties":{"id":"20240616125656-fjg8rqo","updated":"20240616125656"},"Children":[{"Type":"NodeText","Data":"味苦寒。主热气，除热在气分者。目痛， 伤泪出，明目，除湿热在上之病。肠 ，腹痛下痢，除湿热在中之病。妇人阴中肿痛。除湿热在下之病。久服，令人不忘。苦入心能补心也。"}]},{"ID":"20240616125656-a4sg1kz","Type":"NodeParagraph","Properties":{"id":"20240616125656-a4sg1kz","updated":"20240616125707"},"Children":[{"Type":"NodeText","Data":"苦味属火，其性皆热，此固常理。黄连至苦，而反至寒，则得火之味，与水之性者也，故能除水火相乱之病。水火相乱者，湿热是也。凡药能去湿者，必增热，能除热者，必不能去湿。惟黄连能以苦燥湿，以寒除热，一举两得，莫神于此。心属火，寒胜则火，黄连宜为泻心之药，而反能补心何也？盖苦为火之正味，乃以味补之也。若心家有邪火，则此亦能泻之，而真火反得宁，是泻之即所以补之也。苦之极者，其性反寒，即《内经》亢害承制之义。所谓火盛之极.反兼水化也。” 常言黄连以苦燥湿,此说乃出于《内经》。"}]},{"ID":"20240616125629-qv8d4gt","Type":"NodeThematicBreak","Properties":{"id":"20240616125629-qv8d4gt"}},{"ID":"20240616125630-qknsgx4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616125630-qknsgx4","updated":"20240616125634"},"Children":[{"Type":"NodeText","Data":"黄连《中药学》"}]},{"ID":"20240616125630-93l4ky1","Type":"NodeParagraph","Properties":{"id":"20240616125630-93l4ky1","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【药用】本品为毛茛科植物黄连或同属植物的根茎。"}]},{"ID":"20240616125630-sm6xg1q","Type":"NodeParagraph","Properties":{"id":"20240616125630-sm6xg1q","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒。入心、肝、胆、胃、大肠经。"}]},{"ID":"20240616125630-po821pb","Type":"NodeParagraph","Properties":{"id":"20240616125630-po821pb","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【功效】清热燥湿，泻火解毒。"}]},{"ID":"20240616125630-8md3mgo","Type":"NodeParagraph","Properties":{"id":"20240616125630-8md3mgo","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于湿热内蕴、胸中烦热痞满、舌苔黄腻，黄疸，以及肠胃湿热留恋、呕吐、泻痢、痔疮等症。"}]},{"ID":"20240616125630-gdbtjn2","Type":"NodeParagraph","Properties":{"id":"20240616125630-gdbtjn2","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"黄连清热燥湿的作用很强，配黄芩、大黄等，能治湿热内蕴之症。对湿热留恋肠胃，常配合半夏、竹茹以止呕，配木香、黄芩、葛根等以治泻痢。"}]},{"ID":"20240616125630-y6v3lp0","Type":"NodeParagraph","Properties":{"id":"20240616125630-y6v3lp0","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"2.用于热病高热、口渴烦躁、甚至神昏谵语，心火亢盛、失眠、心烦、血热妄行、吐血衄血，以及热毒疮疡等症。"}]},{"ID":"20240616125630-4xu35d1","Type":"NodeParagraph","Properties":{"id":"20240616125630-4xu35d1","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"黄连为泻火解毒要药，对热病高热、心火亢盛，有良好疗效，常配合山栀、连翘等同用；对于血热妄行，可配伍黄芩、大黄等同用；对热毒疮疡，可配伍赤芍、丹皮等药同用。"}]},{"ID":"20240616125630-yxvpg1x","Type":"NodeParagraph","Properties":{"id":"20240616125630-yxvpg1x","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"此外，黄连还可用于胃火炽盛的中消证，可配合天花粉、知母、生地等同用。外用以黄连汁点眼，可治火盛目赤；涂口。可治口舌生疮。"}]},{"ID":"20240616125630-55gru64","Type":"NodeParagraph","Properties":{"id":"20240616125630-55gru64","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【处方用名】川连、川雅莲、细川连、小川连（生用，清热泻火）、炒川连（炒用，减低寒性）、姜川连（姜汁拌炒，用于止呕）、酒炒川连（酒拌炒，上行，清上焦火）"}]},{"ID":"20240616125630-em43o6u","Type":"NodeParagraph","Properties":{"id":"20240616125630-em43o6u","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】五分至一钱五分，煎服。研粉吞服，每次三至五分，每日服二至三次。"}]},{"ID":"20240616125630-jt400li","Type":"NodeParagraph","Properties":{"id":"20240616125630-jt400li","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【按语】1.黄连性寒，味甚苦，功能泻心火、解热毒，为治痢止呕的要药。"}]},{"ID":"20240616125630-6qwryj8","Type":"NodeParagraph","Properties":{"id":"20240616125630-6qwryj8","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"2.本品配以黄芩、山栀等，则泻火而解热毒；配以大黄、黄芩，则泻火而止吐衄，且可治目赤口疮；配木香，则清热止痢而除腹痛；配竹茹，则清胃热而止呕吐；配吴茱萸，则和肝胃而治胃痛泛酸；配天花粉、知母、生地，则清胃火而治消渴；配朱砂，则泻心火而安神。"}]},{"ID":"20240616125630-43stexj","Type":"NodeParagraph","Properties":{"id":"20240616125630-43stexj","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"【方剂举例】黄连解毒汤《外台秘要》：黄连、黄芩、黄柏、山栀。治疮毒。"}]},{"ID":"20240616125630-nynskr9","Type":"NodeParagraph","Properties":{"id":"20240616125630-nynskr9","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"香连丸《和剂局方》：黄连、木香。治下痢腹痛，里急后重。"}]},{"ID":"20240616125630-jy4m1v3","Type":"NodeParagraph","Properties":{"id":"20240616125630-jy4m1v3","updated":"20240616125630"},"Children":[{"Type":"NodeText","Data":"左金丸《丹溪心法》：黄连、吴茱萸。治吞吐酸水。"}]},{"ID":"20240607114847-mqoaygj","Type":"NodeThematicBreak","Properties":{"id":"20240607114847-mqoaygj"}},{"ID":"20240607114914-vqhff6h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114914-vqhff6h","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"《中国药典》：黄连"}]},{"ID":"20240607114914-7cumpgp","Type":"NodeParagraph","Properties":{"id":"20240607114914-7cumpgp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114914-ccal8t6","Type":"NodeParagraph","Properties":{"id":"20240607114914-ccal8t6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" Huánɡ Lián"}]},{"ID":"20240607114914-o46qpcj","Type":"NodeParagraph","Properties":{"id":"20240607114914-o46qpcj","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114914-lptas36","Type":"NodeParagraph","Properties":{"id":"20240607114914-lptas36","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 云连、雅连、川连、味连、鸡爪连"}]},{"ID":"20240607114914-yoyh4a2","Type":"NodeParagraph","Properties":{"id":"20240607114914-yoyh4a2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607114914-paw3sas","Type":"NodeParagraph","Properties":{"id":"20240607114914-paw3sas","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" RHIZOMA COPTIDIS"}]},{"ID":"20240607114914-wmgryg0","Type":"NodeParagraph","Properties":{"id":"20240607114914-wmgryg0","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114914-er7qv94","Type":"NodeParagraph","Properties":{"id":"20240607114914-er7qv94","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 本品为毛茛科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄连"},{"Type":"NodeText","Data":"Coptis chinensis Franch.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三角叶黄连"},{"Type":"NodeText","Data":"Coptis deltoidea C. Y. Cheng et Hsiao或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"云连"},{"Type":"NodeText","Data":"Coptis teeta Wall.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。以上三种分别习称“味连”、“雅连”、“云连”。秋季采挖，除去须根及泥沙，干燥，撞去残留须根。"}]},{"ID":"20240607114914-tl6x7il","Type":"NodeParagraph","Properties":{"id":"20240607114914-tl6x7il","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607114914-ut9frm6","Type":"NodeParagraph","Properties":{"id":"20240607114914-ut9frm6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 味连：多集聚成簇，常弯曲，形如鸡爪，单枝根茎长3～6cm，直径0.3～0.8cm。表面灰黄色或黄褐色，粗糙，有不规则结节状隆起、须根及须根残基，有的节间表面平滑如茎杆，习称“过桥”。上部多残留褐色鳞叶，顶端常留有残余的茎或叶柄。质硬，断面不整齐，皮部橙红色或暗棕色，木部鲜黄色或橙黄色，呈放射状排列，髓部有的中空。气微，味极苦。"}]},{"ID":"20240607114914-h26n65l","Type":"NodeParagraph","Properties":{"id":"20240607114914-h26n65l","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"雅连：多为单枝，略呈圆柱形，微弯曲，长4～8cm，直径0.5～1cm。“过桥”较长。顶端有少许残茎。"}]},{"ID":"20240607114914-uopnlx8","Type":"NodeParagraph","Properties":{"id":"20240607114914-uopnlx8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"云连：弯曲呈钩状，多为单枝，较细小。"}]},{"ID":"20240607114914-vip4j6k","Type":"NodeParagraph","Properties":{"id":"20240607114914-vip4j6k","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607114914-f5rmc52","Type":"NodeParagraph","Properties":{"id":"20240607114914-f5rmc52","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240607114914-jzdnuqc","Type":"NodeParagraph","Properties":{"id":"20240607114914-jzdnuqc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607114914-712p10y","Type":"NodeParagraph","Properties":{"id":"20240607114914-712p10y","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄连"},{"Type":"NodeText","Data":"：除去杂质，润透后切薄片，晾干，或用时捣碎。"}]},{"ID":"20240607114914-9wqlxau","Type":"NodeParagraph","Properties":{"id":"20240607114914-9wqlxau","updated":"20240607114914"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒黄连"},{"Type":"NodeText","Data":"：取净黄连，照酒炙法（附录Ⅱ D）炒干。每100kg黄连 ，用黄酒12.5kg。"}]},{"ID":"20240607114914-803grvu","Type":"NodeParagraph","Properties":{"id":"20240607114914-803grvu","updated":"20240607114914"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"姜黄连"},{"Type":"NodeText","Data":"：取净黄连，照姜汁炙法（附录Ⅱ D）炒干。每100kg黄连 ，用生姜12.5kg。"}]},{"ID":"20240607114914-pdif34o","Type":"NodeParagraph","Properties":{"id":"20240607114914-pdif34o","updated":"20240607114914"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"萸黄连"},{"Type":"NodeText","Data":"：取吴茱萸加适量水煎煮，煎液与净黄连拌匀，待液吸尽，炒干。每100kg黄连 ，用吴茱萸10kg。"}]},{"ID":"20240607114914-9e9o8so","Type":"NodeParagraph","Properties":{"id":"20240607114914-9e9o8so","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"酒黄连、姜黄连、萸黄连照上述总灰分的方法测定，均不得过 4.0％。"}]},{"ID":"20240607114914-attmj68","Type":"NodeParagraph","Properties":{"id":"20240607114914-attmj68","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607114914-ckbel0x","Type":"NodeParagraph","Properties":{"id":"20240607114914-ckbel0x","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：味连 木栓层为数列细胞。皮层较宽，石细胞单个或成群散在。中柱鞘纤维成束，或伴有少数石细胞，均显黄色。维管束外韧型，环列。束间形成层不明显。木质部黄色，均木化，木纤维较发达。髓部均为薄壁细胞，无石细胞。"}]},{"ID":"20240607114914-nn6iuzn","Type":"NodeParagraph","Properties":{"id":"20240607114914-nn6iuzn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"雅连 髓部有石细胞。"}]},{"ID":"20240607114914-8gtpl73","Type":"NodeParagraph","Properties":{"id":"20240607114914-8gtpl73","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"云连 皮层、中柱鞘及髓部均无石细胞。"}]},{"ID":"20240607114914-3ad4221","Type":"NodeParagraph","Properties":{"id":"20240607114914-3ad4221","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粗粉约1g，加乙醇10ml，加热至沸腾，放冷，滤过。取滤液5 滴，加稀盐酸1ml 与含氯石灰少量，即显樱红色；另取滤液5 滴，加5％ 没食子酸乙醇溶液 2～3 滴，蒸干，趁热加硫酸数滴，即显深绿色。"}]},{"ID":"20240607114914-wj46k26","Type":"NodeParagraph","Properties":{"id":"20240607114914-wj46k26","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（3） 取本品粉末50mg，加甲醇5ml ，加热回流15分钟，滤过，滤液补加甲醇使成5ml，作为供试品溶液。另取黄连对照药材，同法制成对照药材溶液。再取盐酸小檗碱对照品，加甲醇制成每1ml 含0。5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述三种溶液各1μl，分别点于同一硅胶Ｇ薄层板上，以苯－醋酸乙酯－异丙醇-甲醇－水（6:3:1。5:1。5:0。3） 为展开剂，置氨蒸气饱和的展开缸内，展开，取出，晾干，置紫外光灯（365nm） 下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同的黄色荧光斑点；在与对照品色谱相应的位置上，显相同的一个黄色荧光斑点。"}]},{"ID":"20240607114914-ccgbz23","Type":"NodeParagraph","Properties":{"id":"20240607114914-ccgbz23","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114914-js63os9","Type":"NodeParagraph","Properties":{"id":"20240607114914-js63os9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 归心、脾、胃、肝、胆、大肠经。"}]},{"ID":"20240607114914-odjxdis","Type":"NodeParagraph","Properties":{"id":"20240607114914-odjxdis","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114914-j6pqk8a","Type":"NodeParagraph","Properties":{"id":"20240607114914-j6pqk8a","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240607114914-hthqbmp","Type":"NodeParagraph","Properties":{"id":"20240607114914-hthqbmp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114914-3leqm8p","Type":"NodeParagraph","Properties":{"id":"20240607114914-3leqm8p","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，泻火解毒。用于湿热痞满，呕吐吞酸，泻痢，黄疸，高热神昏，心火亢盛，心烦不寐，血热吐衄，目赤，牙痛，消渴，痈肿疔疮；外治湿疹，湿疮，耳道流脓。酒黄连善清上焦火热。用于目赤，口疮。姜黄连清胃和胃止呕。用于寒热互结，湿热中阻，痞满呕吐。萸黄连舒肝和胃止呕。用于肝胃不和，呕吐吞酸。"}]},{"ID":"20240607114914-ddlxpwx","Type":"NodeParagraph","Properties":{"id":"20240607114914-ddlxpwx","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114914-b9bhs4h","Type":"NodeParagraph","Properties":{"id":"20240607114914-b9bhs4h","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 2～5g。外用适量。"}]},{"ID":"20240607114914-7ja8kng","Type":"NodeParagraph","Properties":{"id":"20240607114914-7ja8kng","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607114914-7hd644k","Type":"NodeParagraph","Properties":{"id":"20240607114914-7hd644k","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" （1）配黄芩、大黄等，能治湿热内蕴之症。对湿热留恋肠胃，常配合半夏、竹茹以止呕，配木香、黄芩、葛根等以治泻痢。对热病高热、心火亢盛，有良好疗效，常配合山栀、连翘等同用；对于血热妄行，可配伍黄芩、大黄等同用；对热毒疮疡，可配伍赤芍、丹皮等药同用。用于胃火炽盛的中消证，可配合天花粉、知母、生地等同用。外用以黄连汁点眼，可治火盛目赤；涂口。可治口舌生疮。"}]},{"ID":"20240607114914-p5igfu5","Type":"NodeParagraph","Properties":{"id":"20240607114914-p5igfu5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114914-7tcdhaf","Type":"NodeParagraph","Properties":{"id":"20240607114914-7tcdhaf","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607114914-ozbaevv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114914-ozbaevv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：黄连"}]},{"ID":"20240607114914-rb6x24w","Type":"NodeParagraph","Properties":{"id":"20240607114914-rb6x24w","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114914-cz9bcsw","Type":"NodeParagraph","Properties":{"id":"20240607114914-cz9bcsw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" Huánɡ Lián"}]},{"ID":"20240607114914-u9nspju","Type":"NodeParagraph","Properties":{"id":"20240607114914-u9nspju","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114914-xl0xajc","Type":"NodeParagraph","Properties":{"id":"20240607114914-xl0xajc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 王连（《本经》），灾连（《药性论》）。"}]},{"ID":"20240607114914-6s81hpv","Type":"NodeParagraph","Properties":{"id":"20240607114914-6s81hpv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607114914-vp860x2","Type":"NodeParagraph","Properties":{"id":"20240607114914-vp860x2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607114914-iap1qo9","Type":"NodeParagraph","Properties":{"id":"20240607114914-iap1qo9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114914-poyuvp6","Type":"NodeParagraph","Properties":{"id":"20240607114914-poyuvp6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 为毛茛科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄连"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三角叶黄连"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"峨嵋野连"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"云南黄连"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。以立冬后（11月）采收为宜。掘出后除去茎叶、须根及泥土，晒干或烘干，撞去粗皮。"}]},{"ID":"20240607114914-7asm2x4","Type":"NodeParagraph","Properties":{"id":"20240607114914-7asm2x4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607114914-2jhzmvf","Type":"NodeParagraph","Properties":{"id":"20240607114914-2jhzmvf","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" ①黄连"}]},{"ID":"20240607114914-1lbs92q","Type":"NodeParagraph","Properties":{"id":"20240607114914-1lbs92q","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15～25厘米。根茎黄色，常分枝，密生须根。叶基生，叶柄长6～16厘米，无毛；叶片稍带革质，卵状三角形，宽达10厘米，3全裂；中央裂片稍呈菱形，墓部急遽下延成长1～1.8厘米的细柄，裂片再作羽状深裂，深裂片4～5对，近长圆形，先端急尖，彼此相距2～6毫米，边缘具针刺状锯齿；两侧裂片斜卵形，比中央效片短，不等2深裂或罕2全裂，裂片常再作羽状深裂；上面沿脉被短柔毛，下面无毛。花茎1～2，与叶等长或更长；二歧或多歧聚伞花序，生花3～8朵；苞片披针形，3～5羽状深裂；萼片5，黄绿色，长椭圆状卵形至披针形，长9～12.5毫米，宽2～3毫米；花瓣线形或线状拉针形，长5～6.5毫米，先端尖，中央有蜜槽；雄蕊多数，外轮雄蕊比花瓣略短或近等长，花药广椭圆形，黄色；心皮8～12。蓇葖6～12，具柄，长6～7毫米。种子7～8，长椭圆形，长约2毫米，褐色。花期2～4月。果期3～6月。"}]},{"ID":"20240607114914-dx7vlvh","Type":"NodeParagraph","Properties":{"id":"20240607114914-dx7vlvh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"野生或栽培。分布四川、贵州、湖北、陕西等地。"}]},{"ID":"20240607114914-oz371yb","Type":"NodeParagraph","Properties":{"id":"20240607114914-oz371yb","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②三角叶黄连"}]},{"ID":"20240607114914-sp2s556","Type":"NodeParagraph","Properties":{"id":"20240607114914-sp2s556","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"多年生草本。形态与黄连相似，主要特征为根茎不分枝或少分枝。叶片纸质，卵形，长达16厘米，宽达15厘米，3全裂，裂片均具明显的柄；中央裂片三角状卵形，基部急缩成长达2.5厘米的细柄，羽状深裂4～6对，两侧裂片斜卵状三角形，不等的2深裂或半裂，小裂片彼此邻接。苞片线状披针形，近中部3裂或栉状羽状深裂。花萼狭卵形；花瓣近倒披针形，均较宽；雄蕊约20，长仅为花瓣的1/2左右；心皮9～12。种子不育。"}]},{"ID":"20240607114914-av2tcji","Type":"NodeParagraph","Properties":{"id":"20240607114914-av2tcji","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"栽培于四川，野生种已不多见。"}]},{"ID":"20240607114914-utktix0","Type":"NodeParagraph","Properties":{"id":"20240607114914-utktix0","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③峨嵋野连"}]},{"ID":"20240607114914-1t3up9i","Type":"NodeParagraph","Properties":{"id":"20240607114914-1t3up9i","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15～30厘米。根茎较少分枝，节间短而密。叶基生，4～11枚，叶柄长5～16厘米；叶片披针形或窄卵形，约与叶柄等长，宽3.5～6.5厘米，3全裂；中央裂片三角状披针形，长达14厘米，宽达6厘米，先端渐尖，基部急缩成小柄，羽状深裂，7～10对，小裂片长椭圆状卵形，缘具尖锯齿；两侧裂片斜卵形，长仅为中央裂片的1/3～1/4，2深裂或偶2全裂，小裂片再作羽状分裂或2深裂；上面沿脉被微柔毛外余均无毛。花茎多单一，多歧聚伞花序，有花3～6朵；萼片线形，长7.5～10毫米，宽0.7～1.2毫米；花瓣9～12，狭线形，长约为花萼的1/2或较短；雄蕊多数，长约4毫米；心皮9～14。蓇葖长约8毫米。种子长圆形，黄褐色。"}]},{"ID":"20240607114914-nd39r69","Type":"NodeParagraph","Properties":{"id":"20240607114914-nd39r69","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"野生于阴湿丛林中。分布四川。"}]},{"ID":"20240607114914-gz9mrik","Type":"NodeParagraph","Properties":{"id":"20240607114914-gz9mrik","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④云南黄连"}]},{"ID":"20240607114914-akzvkbk","Type":"NodeParagraph","Properties":{"id":"20240607114914-akzvkbk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"多年生草本。形态与黄连很近似，主要区别为：根茎较少分枝，节间密。中央裂片卵状菱形或长菱形，羽状深裂3～6对，小裂片彼此的距离稀疏。多歧聚伞花序，有花3～5朵；苞片椭圆形，3深裂或羽状深裂；花萼卵形或椭圆形，长6～8毫米，宽2～3毫米；花瓣匙形或卵状匙形，长4.5～6毫米，宽0.5～1毫米，先端圆或钝，中部以下变狭成细长的爪，中央有蜜槽；心皮8～15。"}]},{"ID":"20240607114914-y950ymy","Type":"NodeParagraph","Properties":{"id":"20240607114914-y950ymy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"生于高山寒湿林荫下。分布云南、西藏昌都地区，云南有栽培。"}]},{"ID":"20240607114914-mmsk9tq","Type":"NodeParagraph","Properties":{"id":"20240607114914-mmsk9tq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607114914-xncbj76","Type":"NodeParagraph","Properties":{"id":"20240607114914-xncbj76","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 黄连商品，因原植物与产地的不同，大致可分如下几种："}]},{"ID":"20240607114914-a0u5q5r","Type":"NodeParagraph","Properties":{"id":"20240607114914-a0u5q5r","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"①味连，又名：川连（《本草蒙筌》），鸡爪连、鸡爪黄连、光连。为植物黄连的干燥根茎，多分枝，常3～6枝成束，稍弯曲，形如鸡爪，长约3～7厘米，单枝直径3～8毫米。外表黄褐色，栓皮剥落处呈红棕色；分枝上有间断横纹，结节膨大，形如连珠，着生多数坚硬的细须根及须根痕，有的表面无横纹而平滑如茎杆，习称\"过江枝\"或\"过桥杆\"；上部多有褐色鳞片残留，顶端有未去净的残茎或叶柄。质坚实而硬，断面不整齐，皮部暗棕色，木部金黄色，射线有裂隙，中央髓部红黄色，偶有空心。无臭，味极苦，嚼之唾液可染为红黄色。以条肥壮、连珠形、质坚实、断面红黄色、无残茎及须根者为佳。"}]},{"ID":"20240607114914-66yn6ym","Type":"NodeParagraph","Properties":{"id":"20240607114914-66yn6ym","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"均属栽培品，主产四川、湖北。陕西（平利）亦产。"}]},{"ID":"20240607114914-ymskxtp","Type":"NodeParagraph","Properties":{"id":"20240607114914-ymskxtp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②雅连（《本草从新》），又名：峨嵋连、嘉定连、刺盖连。为植物三角叶黄连的干燥根茎。多为单枝，少有分枝，略呈圆柱形，微弯曲呈蚕状，长约4～8厘米，直径约3～9毫米。外表褐色或黄棕色，间断横纹多，结节明显，有多数须根残痕、叶柄残基及鳞片，\"过江枝\"较味连为少。质坚实，断面不齐，皮部暗棕色，木部深黄色，射线明显，髓部时有空心。无臭，味极苦。以条肥壮、连珠形、质坚实、断面黄色、无残茎及须根者为佳。"}]},{"ID":"20240607114914-p61epfu","Type":"NodeParagraph","Properties":{"id":"20240607114914-p61epfu","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"均属栽培品，主产四川（峨嵋、洪雅）。"}]},{"ID":"20240607114914-ygx32d2","Type":"NodeParagraph","Properties":{"id":"20240607114914-ygx32d2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③野黄连，又名：凤尾连。为植物峨嵋野连的干燥根茎。外形与雅连相近，惟顶端多留有长6～10厘米的叶柄，作为野生的标记；根茎多单枝或有2分枝，略弯曲，长约5～6厘米，直径4～6毫米，外表呈黑褐色，结节紧密成连珠状，无\"过江枝\"；残留的鳞片较多，须根较硬。断面木部鲜黄色。"}]},{"ID":"20240607114914-3nez645","Type":"NodeParagraph","Properties":{"id":"20240607114914-3nez645","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"均属野生。主产四川（峨嵋、洪雅、峨边），产量极小，但一般认为品质最优。"}]},{"ID":"20240607114914-dkrmjt1","Type":"NodeParagraph","Properties":{"id":"20240607114914-dkrmjt1","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④云连（《本草从新》）主要为植物云南黄连的干燥根茎。较细小，多弯曲，拘挛，多为单枝，形如蝎尾。长约1.5～8厘米，直径约2～4毫米。外皮黄绿色或灰黄色。其余特征与以上品种大致相同。"}]},{"ID":"20240607114914-22aa5to","Type":"NodeParagraph","Properties":{"id":"20240607114914-22aa5to","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"栽培或野生。主产云南（德钦、维西、腾冲、碧江）。"}]},{"ID":"20240607114914-cewkqfb","Type":"NodeParagraph","Properties":{"id":"20240607114914-cewkqfb","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607114914-oc7wgtc","Type":"NodeParagraph","Properties":{"id":"20240607114914-oc7wgtc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 小蘖碱的治疗量相当安全，副作用也很少，长期服用也未见任何障碍，一次口服小檗碱2.0克或连用黄连粉100克未见任何副作用。在动物试验中，毒性也很轻，给小鼠口服不易致死，腹腔注射的最小致死量为0.01克/公斤，亦有测得其半数致死量为0.066克/公斤（黄柏或黄连则各为0.52，0.73克/公斤）。猫口服0.1克/公斤可引起全身抑制，呕吐，于8～10天后死亡，呼吸由兴奋转向麻痹，死亡前可发生惊厥。"}]},{"ID":"20240607114914-aj134tf","Type":"NodeParagraph","Properties":{"id":"20240607114914-aj134tf","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607114914-asw95l9","Type":"NodeParagraph","Properties":{"id":"20240607114914-asw95l9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 黄连含小檗碱7～9％、黄连碱，甲基黄连碱、掌叶防已碱、非洲防己碱等生物碱，尚含黄柏酮、黄柏内酯。"}]},{"ID":"20240607114914-081mv3j","Type":"NodeParagraph","Properties":{"id":"20240607114914-081mv3j","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"峨嵋野连中分离出小檗碱、甲基黄连碱、药根碱、掌叶防己碱，以及两种非酚性生物碱，两种酚性生物碱。"}]},{"ID":"20240607114914-qt1t27o","Type":"NodeParagraph","Properties":{"id":"20240607114914-qt1t27o","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607114914-r5tci6i","Type":"NodeParagraph","Properties":{"id":"20240607114914-r5tci6i","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" ①抗微生物及抗原虫作用"}]},{"ID":"20240607114914-2fbtg57","Type":"NodeParagraph","Properties":{"id":"20240607114914-2fbtg57","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"㈠细菌：体外试验证明，黄连或小檗碱对溶血性链球菌、脑膜炎球菌、肺炎双球菌、霍乱弧菌、炭疽杆菌以及金黄色葡萄球菌皆有较强的抑菌作用；对痢疾杆菌、白喉杆菌、枯草杆菌、绿色链球菌均有抑制作用；对肺炎杆菌、百日咳杆菌、鼠疫杆菌、布氏杆菌、破伤风杆菌、产气荚膜杆菌、结核杆菌等亦有效；对变形杆菌、大肠杆菌、伤寒杆菌则作用较差，对宋内氏痢疾杆菌，副伤寒杆菌、绿脓杆菌则几无作用。由于实验方法之不同，各家报告有些差异。对痢疾杆菌，以舒氏痢疾杆菌的敏感度较高，其次弗氏、宋内氏最差。其作用等于或优于磺胺而弱于链霉素及氯霉素。黄连粗提取物与纯小檗碱的抗菌作用，基本上是一致的；但也有少数情况，对某种细菌的作用不完全一致的。煎剂即有良好的抗菌作用，对链霉素、氯霉素、土霉素抗药后，小檗碱仍有抗菌作用，也有报告，加用小檗碱可恢复肠道细菌对上述药物的敏感性；在体外及体内的试验中，它与链霉素、磺胺对葡萄球菌还显示有协同作用。小檗碱与磺胺类药物对痢疾杆菌同时发生抗药性的菌株虽较多，但并无完全的交叉耐药性。在试管中对百日咳杆菌有显著的抑菌作用，虽然其最低有效浓度高于链霉素与氯霉素，但其临床疗效至少不低于链霉素与氯霉素。对白喉杆菌，体外有抑菌作用；但口服黄连，不能保护白喉杆菌对豚鼠的致死作用，也未能减轻或抑制局部反应的发生以及皮内注射白喉毒素的局部反应。对鸟型、牛型、人型结核杆菌皆有抑制作用。由于所用培养基及菌株等条件的不同,其抑制作用有较为显著的，也有不显著的，一般远不及对氨水杨酸。体内试验，对接种结核杆菌的小鼠、家兔、豚鼠的疗效均不十分显著。有人报告，1：2000小檗碱与结核菌在体外作用三日后，并不影响细菌对豚鼠的致病力，如作用14日后，则可使其致病力降低1/2。㈡其他微生物及原虫：在鸡胚试验中，黄连对各型流感病毒、新城病毒均有一定的抑制作用。在试管中对十余种常见致病性真菌有广泛而显著的抑制。对钩端螺旋体，在试管中有相当强的杀灭作用，小檗碱在7.5微克/毫升，黄连水煎剂在1.9毫克/毫升时，即有显著作用。黄连煎剂及硫酸小檗碱在体外及体内均有抗阿米巴原虫作用，体外试验，其效力相当于依米丁的1/128，汉防己甲素的1/4；体内试验相当于汉防己甲素的1/16。此外，尚有抗滴虫、抗黑热病原虫、抗锥虫、杀草履虫等作用。由于其作用广泛，有人认为可作为防腐剂，其酚系数在5～20之间。黄连抑菌的有效成分，一般认为是小檗碱。黄连生药炒焦后，小檗碱含量有所降低，抗菌力亦随之减弱。它低浓度（约为10毫克/100毫升）为抑菌，高浓度（约为20毫克/100毫升）为杀菌。其杀菌作用原理较为复杂，尚未完全阐明。小檗碱能抑制金黄色葡萄球菌的生长与呼吸，抑制细菌的葡萄糖及糖代谢中间产物的氧化过程，特别是脱氢反应。与维生素PP及B有较显著的拮抗作用；偏碱性时，能使大肠杆菌、粪链球菌的吡哆醛与酶蛋白的结合受到抑制，在酸性时则否，能抑制细菌对蛋白质的合成；黄连及其复方制剂可使金黄色葡萄球菌溶血素及血浆蛋白凝固酶的效价降低。在对霍乱弧菌的研究中证明，小檗碱可能伤害了细胞膜，而导致细胞内成分的改变；它不影响核酸合成，而增加蛋白质的分解过程，对脂肪酸成分（饱和的及不饱和的）也有改变。据报道，它能增强白细胞及肝脏网状内皮系统的吞噬能力；能使动物因感染而产生的代谢障碍，如心肌糖元及某些酶活性之降低，有所恢复。对豚鼠对布氏杆菌活菌菌苗的免疫反应，小檗碱（单用或与磷胺并用）在早期用药时，稍呈抑制，晚期则并无影响。金黄色葡萄球菌、溶血性链球菌与弗氏痢疾杆菌对单用小檗碱极易产生抗药性。某些细菌还可从培养基中同化小檗碱；但对青霉素、链霉素、金霉素、异烟肼、对氨水杨酸之间并无交叉耐药性。据报道，用黄连组成复方后，抗药性之形成远较单用时为小，抗菌效力还有所提高。"}]},{"ID":"20240607114914-pfyx327","Type":"NodeParagraph","Properties":{"id":"20240607114914-pfyx327","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②对循环系统的作用"}]},{"ID":"20240607114914-7x23lim","Type":"NodeParagraph","Properties":{"id":"20240607114914-7x23lim","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"静脉注射或口服小檗碱对麻醉（犬、猫、兔）或不麻醉（大鼠）动物，均可引起血压下降。一般剂量时，持续时间不长，重复给药，无增强作用及耐受现象。降压作用与心脏无关，因为在一般剂量或小剂量时，它能兴奋心脏，增加冠状动脉血流量，大剂量方抑制心脏；即使再增加剂量，在离体蟾蜍或猫的心脏上亦无停搏现象。降压与血管的扩张有关，因为降压的同时，脾、肠、肾及四肢容积皆有增大，蟾蜍血管灌流及家兔寓体肾脏灌流，也都证明它能直接扩张血管。小檗碱的降压作用不受苯海拉明和利血平化的影响；阿托品可阻断其降压作用（麻醉大鼠），但不影响乙酰胆碱的降压反应；因此其作用可能是直接兴奋毒蕈碱样受体。对降压原理中的各方面因素进行了不少的研究以后，一般认为，其降压乃由于对血管的直接作用与增强乙酰胆碱（见下节）两种因素而来。有若干原理至今尚未获圆满解释，如麦角毒能将小檗碱的降压作用翻转为升压作用；注射大量阿托品后，乙酰胆碱的升压作用可被小檗碱翻转为降压作用等，皆有待继续研究。"}]},{"ID":"20240607114914-xpjnoqo","Type":"NodeParagraph","Properties":{"id":"20240607114914-xpjnoqo","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③对乙酰胆碱等的作用"}]},{"ID":"20240607114914-yvwc09j","Type":"NodeParagraph","Properties":{"id":"20240607114914-yvwc09j","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱在哺乳类心脏标本（心肺装置、离体猫心、离体兔心耳、离体猫心耳）上，小剂量能增强乙酰胆碱的作用，大剂量则对抗之，在整体动物上也是这样，小剂量增强乙酰胆碱或电刺激迷走神经外周端引起的血压下降，大剂量则削弱此种反应。在兔耳、蛙下肢灌流、离体兔肠、支气管等标本上，小檗碱都能增强乙酰胆碱的作用；亦可增强电刺激鼓索神经、注射毛果芸香碱引起的唾液分泌。在对家兔瞳孔的试验中，局部用药，小檗碱（0.5％）可增强乙酰胆碱的作用。此外，它还能显著增强乙酰胆碱对蛙腹直肌的作用，小剂量时呈现显著的抗箭毒样作用，剂量过大，则又可增强某些药的箭毒样作用。在整体动物身上也可观察到抗箭毒样作用，但在体内，作用发生很慢，与毒扁豆碱不同.其作用强度（兔垂头及小鼠的毒性试验）不如毒扁豆碱，其衍化物可有更强的抗箭毒样作用。总之，小檗碱具有双相作用；它对乙酰胆碱的增强作用，与其抗胆碱酯酶有关，在犬、马血清、兔脑匀浆胆碱酯酶的活力测定中，都确定它的抗胆碱酯酶的作用，但效力仅及新斯的明的1/200。另一方面，小檗碱对乙酰胆碱的拮抗作用，则可能与其化学结构同属季铵化合物，因而二者之间发生相互竞争性拮抗所致。"}]},{"ID":"20240607114914-hufrpws","Type":"NodeParagraph","Properties":{"id":"20240607114914-hufrpws","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱还有某些抗肾上腺素样作用，在小檗碱引起麻醉动物降压的过程中，肾上腺素的升压反应被大大削弱，但很快即恢复。小檗碱能拮抗肾上腺素及其同类物如去甲肾上腺素、异丙肾上腺素、甲氧胺等在麻醉兔身上引起的心律不整、心率变慢以及心电图的改变。"}]},{"ID":"20240607114914-coxsk1n","Type":"NodeParagraph","Properties":{"id":"20240607114914-coxsk1n","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④对平滑肌的作用"}]},{"ID":"20240607114914-ox8canp","Type":"NodeParagraph","Properties":{"id":"20240607114914-ox8canp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱除对血管平滑肌起松弛作用外，对其他平滑肌如子宫、膀胱、支气管、肠胃道等都具有兴奋作用。对离体豚鼠及猫的子宫有显著的兴奋作用，甚至超过北美黄连碱，此点在妇产科应用上有意义。黄连煎剂对离体兔肠，低浓度使肠的紧张度上升，浓度过高反引起弛缓。"}]},{"ID":"20240607114914-1rh6gbm","Type":"NodeParagraph","Properties":{"id":"20240607114914-1rh6gbm","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑤对胆汁分泌及血液的影响"}]},{"ID":"20240607114914-fwxzqum","Type":"NodeParagraph","Properties":{"id":"20240607114914-fwxzqum","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱有利胆作用，增加胆汁形成，使胆汁变稀，对慢性胆囊炎患者，口服有良好效果。在慢性试验中，小檗碱对大鼠口服（20毫克/公斤）、肌肉注射（2毫克/公斤）可降低血清胆甾醇。黄连的热水浸液对家兔在饲喂胆甾醇或切除甲状腺后，可使升高的血清C/P值较早的恢复正常或降低血脂质水平。对家兔的苯肼性动脉硬化症，三黄粉（黄连、黄芩、大黄）可使升高的c/P值有所下降。早年报告的降低血糖的作用，未被证实。据报道，小檗碱及某些苦味健胃药（丁香中的石竹萜烯等）有抗贫血作用。对注射苯肼及二胺甲苯引起贫血的家兔，小檗碱可使红细胞的减少幅度较对照组少而血红蛋白也有某些增高。但也有报告，未发现黄连粉末有此作用。早年报告的小檗碱能减少白细胞，抑制白细胞的阿米巴样运动，未被证实，一般剂量时，它对白细胞并无影响。"}]},{"ID":"20240607114914-mbdm1dy","Type":"NodeParagraph","Properties":{"id":"20240607114914-mbdm1dy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑥抗癌、抗放射及对细胞代谢的作用"}]},{"ID":"20240607114914-hcpr6gl","Type":"NodeParagraph","Properties":{"id":"20240607114914-hcpr6gl","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"以前认为小檗碱系原浆毒或细胞分裂毒，它与秋水恼、白屈菜碱同属芪胺类化合物，并与秋水仙有协同作用。在组织培养试验中，抑制细胞呼吸、氧的摄取并引起细胞的脂肪性变，萤光照相显示小檗碱存在于细胞内之颗粒中。它的抑制细胞呼吸，主要是由于抑制了丙酮酸的氧化脱羧所致，对异丁烯二酸、延胡索酸、醋酸、无氧糖醇解等并无影响。也有认为，它之抑制呼吸，主要是抑制黄酶，而癌组织的黄酶含量低，故较正常细胞对小檗碱更为敏感，还有报告它能抑制癌细胞的核酸合成，抑制嘌呤核甙酸合成的中间体羧胺的利用。尽管在试管中有制癌作用，但对小鼠艾氏腹水癌的治疗作用效果不佳。小檗碱对小鼠遭受Coγ-射线照射而致的死亡有某些保护作用，从体外酵母菌的试验中得知，此种保护可能与小檗碱改变了细胞内微粒体表面的某些特性有关。"}]},{"ID":"20240607114914-qtmxumw","Type":"NodeParagraph","Properties":{"id":"20240607114914-qtmxumw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑦其他作用"}]},{"ID":"20240607114914-nzmhx2p","Type":"NodeParagraph","Properties":{"id":"20240607114914-nzmhx2p","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱小剂量能加强小鼠大脑皮层的兴奋过程，大剂量可削弱之；同时它也能加强抑制过程。小檗碱对颈动脉体、骨髓及肠管的化学感受器有兴奋作用；颈动脉注射与静脉注射本药不同，不是引起恒定的降压反应，而是引起血压的波动性改变。此种现象可能与它对颈动脉体的反射性升压作用这一因素有关。在对大鼠的巴豆油肉芽囊的实验中，用组织学的方法证明，小檗碱皮下注射，可帮助机体加强对炎症病灶形成屏障的作用。黄连的甲醇提取液有抗炎作用（大鼠足踝浮肿法及巴豆油肉芽囊性炎症法等），局部给药也能使肉芽肿重量减轻，其作用近似保泰松。据称小檗碱有解热、抗利尿、局部麻醉、镇静、镇痛、延长戊巴比妥睡眠时间以及降低家兔眼内压等作用，无雌性激素样作用。黄连与萱草根同时或在较短时间内同服，可降低后者对小鼠的毒性。"}]},{"ID":"20240607114914-xwxtekn","Type":"NodeParagraph","Properties":{"id":"20240607114914-xwxtekn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑧吸收、分布、排泄"}]},{"ID":"20240607114914-xplaa6v","Type":"NodeParagraph","Properties":{"id":"20240607114914-xplaa6v","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱口服不易吸收。肠外给药，吸收入血后迅速进入组织，血浓度不易维持；人类口服0.4克盐酸小檗碱后30分钟血浓度为100微克％（体外杀菌浓度大约为20毫克％），随后逐渐减少，即使重复给药，每4小时0.4克，血浓度亦不见增高。在体内，几乎所有组织均有小檗碱的分布，而以心、肾、肺、肝等为最多。它在各组织中贮留的时间甚为短暂，24小时后仅有微量，主要在体内进行代谢，也有少部分（6.4％）经肾排出。兔口服后，亦能吸收，并能在血中停留72小时，尿中亦有排泄，组织中以心脏中浓度最高，胰、肝次之。大鼠口服，吸收甚微。注射给药，则主要进入心、胰、肝、大网膜脂肪；24小时后仅有胰、脂肪中中仍可查见相当量的小檗碱。仅少量（1％）自尿排出。"}]},{"ID":"20240607114914-gb9fphi","Type":"NodeParagraph","Properties":{"id":"20240607114914-gb9fphi","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607114914-e9p9ztt","Type":"NodeParagraph","Properties":{"id":"20240607114914-e9p9ztt","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 黄连：拣去杂质，洗净泥砂，润透，切片，阴干。炒黄连：将黄连片以文火炒至表面呈深黄色为度，取出放凉。姜黄连：用鲜生姜打汁，加适量之开水，均匀地喷入黄连片内，待吸收后，用文火炒至表面深黄色为度，取出放凉。（每黄连片100斤用生姜12斤8两）萸黄连：先取吴茱萸加清水适量煎透，去渣，再将黄连片拌入汤内，至汤液吸尽，文火微炒，待略干，取出晾干。（每黄连片100斤用吴茱萸6斤4两）"}]},{"ID":"20240607114914-j00h2q9","Type":"NodeParagraph","Properties":{"id":"20240607114914-j00h2q9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"酒黄连：取黄连片用黄酒拌匀，稍闷，炒至表面深黄色为度，取出放凉。（每黄连片100斤用黄酒12斤8两）"}]},{"ID":"20240607114914-gl6e35s","Type":"NodeParagraph","Properties":{"id":"20240607114914-gl6e35s","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使黄连，以布拭上肉毛，然后用浆水浸二伏时，漉出，于柳木火中焙干用。\""}]},{"ID":"20240607114914-6ycqvve","Type":"NodeParagraph","Properties":{"id":"20240607114914-6ycqvve","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114914-u2hox8n","Type":"NodeParagraph","Properties":{"id":"20240607114914-u2hox8n","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 入心、肝、胃、大肠经。"}]},{"ID":"20240607114914-hwhh0ym","Type":"NodeParagraph","Properties":{"id":"20240607114914-hwhh0ym","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手少阴经。\""}]},{"ID":"20240607114914-ffensxc","Type":"NodeParagraph","Properties":{"id":"20240607114914-ffensxc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入手少阴、阳明，足少阳、厥阴、阳明、太阴。\""}]},{"ID":"20240607114914-euvls2y","Type":"NodeParagraph","Properties":{"id":"20240607114914-euvls2y","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入足少阴肾经、手少阴心经。"}]},{"ID":"20240607114914-y25tvx9","Type":"NodeParagraph","Properties":{"id":"20240607114914-y25tvx9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114914-uxv1y8g","Type":"NodeParagraph","Properties":{"id":"20240607114914-uxv1y8g","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240607114914-isyfauy","Type":"NodeParagraph","Properties":{"id":"20240607114914-isyfauy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240607114914-617ygdm","Type":"NodeParagraph","Properties":{"id":"20240607114914-617ygdm","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、歧伯、雷公：苦，无毒；李氏：小寒。\""}]},{"ID":"20240607114914-32di0l5","Type":"NodeParagraph","Properties":{"id":"20240607114914-32di0l5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607114914-dx0jhcb","Type":"NodeParagraph","Properties":{"id":"20240607114914-dx0jhcb","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 凡阴虚烦热，胃虚呕恶，脾虚泄泻，五更泄泻慎服。"}]},{"ID":"20240607114914-j7m1t7h","Type":"NodeParagraph","Properties":{"id":"20240607114914-j7m1t7h","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"黄芩、龙骨、理石为之使。恶菊花、芫花、玄参、白鲜皮。畏款冬。胜乌头。\""}]},{"ID":"20240607114914-9mxajti","Type":"NodeParagraph","Properties":{"id":"20240607114914-9mxajti","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"恶白僵蚕。忌猪肉。\""}]},{"ID":"20240607114914-88ytp2c","Type":"NodeParagraph","Properties":{"id":"20240607114914-88ytp2c","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③《蜀本草》；\"畏牛膝。\""}]},{"ID":"20240607114914-utawcgp","Type":"NodeParagraph","Properties":{"id":"20240607114914-utawcgp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④朱震亨：\"肠胃有寒及伤寒下早，阴虚下血，及损脾而血不归元者，皆不可用。\""}]},{"ID":"20240607114914-l4n1hos","Type":"NodeParagraph","Properties":{"id":"20240607114914-l4n1hos","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑤《本草经疏》：\"凡病人血少气虚，脾胃薄弱，血不足，以致惊悸不眠，而兼烦热躁渴，及产后不眠，血虚发热，泄泻腹痛；小儿痘疮阳虚作泄，行浆后泄泻；老人脾胃虚寒作泻；阴虚人天明溏泄，病名肾泄；真阴不足，内热烦躁诸证，法咸忌之，犯之使人危殆。\""}]},{"ID":"20240607114914-m96u4c1","Type":"NodeParagraph","Properties":{"id":"20240607114914-m96u4c1","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114914-3mfsi2s","Type":"NodeParagraph","Properties":{"id":"20240607114914-3mfsi2s","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 泻火，燥湿，解毒，杀虫。治时行热毒，伤寒，热盛心烦，痞满呕逆，菌痢，热泻腹痛，肺结按，吐、衄、下血，消渴，疳积，蛔虫病，百日咳，咽喉肿痛，火眼，口疮，痈疽疮毒，湿疹，汤火烫伤。"}]},{"ID":"20240607114914-0sd00gv","Type":"NodeParagraph","Properties":{"id":"20240607114914-0sd00gv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主热气目痛，眦伤泣出，明目，肠辩腹痛下痢，妇人阴中肿痛。\""}]},{"ID":"20240607114914-icl8gdr","Type":"NodeParagraph","Properties":{"id":"20240607114914-icl8gdr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"解巴豆毒。\""}]},{"ID":"20240607114914-cwg9zby","Type":"NodeParagraph","Properties":{"id":"20240607114914-cwg9zby","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"主五脏冷热，久下泄辩脓血，止消渴，大惊，除水利骨，调胃厚肠，益胆，疗口疮。\""}]},{"ID":"20240607114914-sdv21lq","Type":"NodeParagraph","Properties":{"id":"20240607114914-sdv21lq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"杀小儿疳虫，点赤眼昏痛，镇肝去热毒。\""}]},{"ID":"20240607114914-8seprr4","Type":"NodeParagraph","Properties":{"id":"20240607114914-8seprr4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑤《本草拾遗》：\"主羸瘦气急。\""}]},{"ID":"20240607114914-0jvn86t","Type":"NodeParagraph","Properties":{"id":"20240607114914-0jvn86t","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑥《日华子本草》：\"治五劳七伤，益气，止心腹痛。惊悸烦躁，润心肺，长肉，止血；并疮疥，盗汗，天行热疾；猪肚蒸为丸，治小儿疳气。\""}]},{"ID":"20240607114914-h9qkw9g","Type":"NodeParagraph","Properties":{"id":"20240607114914-h9qkw9g","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑦《仁斋直指方》：\"能去心窍恶血。\""}]},{"ID":"20240607114914-w1smawy","Type":"NodeParagraph","Properties":{"id":"20240607114914-w1smawy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑧《珍珠囊》：\"泻心火，心下痞。酒炒、酒浸，上颈已上。\""}]},{"ID":"20240607114914-w4dd61p","Type":"NodeParagraph","Properties":{"id":"20240607114914-w4dd61p","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑨王好古：\"主心病逆而盛，心积伏梁。\""}]},{"ID":"20240607114914-jbpnmqr","Type":"NodeParagraph","Properties":{"id":"20240607114914-jbpnmqr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑩《本草衍义补遗》：\"以姜汁炒，辛散除热有功。\""}]},{"ID":"20240607114914-hwikcrn","Type":"NodeParagraph","Properties":{"id":"20240607114914-hwikcrn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑾《纲目》：\"解服药过剂烦闷及轻粉毒。\""}]},{"ID":"20240607114914-jymh3w3","Type":"NodeParagraph","Properties":{"id":"20240607114914-jymh3w3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑿《本草新编》：\"止吐利吞酸，解口渴，治火眼，安心，止梦遗，定狂躁，除痞满。\""}]},{"ID":"20240607114914-her99hk","Type":"NodeParagraph","Properties":{"id":"20240607114914-her99hk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒀《本草备要》：\"治痈疽疮疥，酒毒，胎毒。除疳，杀蛔。\""}]},{"ID":"20240607114914-3rimfao","Type":"NodeParagraph","Properties":{"id":"20240607114914-3rimfao","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114914-u32qzfo","Type":"NodeParagraph","Properties":{"id":"20240607114914-u32qzfo","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1钱；或入丸、散。外用：研末调敷、煎水洗或浸汁点眼。"}]},{"ID":"20240607114914-v4ko0m2","Type":"NodeParagraph","Properties":{"id":"20240607114914-v4ko0m2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607114914-c1bxjvv","Type":"NodeParagraph","Properties":{"id":"20240607114914-c1bxjvv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" ①治心烦懊憹反复，心乱，怔忡，上热，胸中气乱，心下痞闷，食入反出：朱砂四钱，黄连五钱，生甘草二钱半。为细末，汤浸蒸饼，丸如黍米大。每服一十丸，食后时时津唾咽下。（《仁斋直指方》黄连安神丸）"}]},{"ID":"20240607114914-b26t4dd","Type":"NodeParagraph","Properties":{"id":"20240607114914-b26t4dd","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②治少阴病，得之二三日以上，心中烦，不得卧：黄连四两，黄芩二两，芍药二两，鸡子黄二枚，阿胶三两（一云三挺）。上五味，以水六升，先煮三物，取二升，去滓，纳胶烊尽，小冷，纳鸡子黄，搅令相得。温服七合，日三服。（《伤寒论》黄连阿胶汤）"}]},{"ID":"20240607114914-3aqpw79","Type":"NodeParagraph","Properties":{"id":"20240607114914-3aqpw79","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③治心肾不交，怔忡无寐：生川连五钱，肉桂心五分。研细，白蜜丸。空心淡盐汤下。（《四科简效方》交泰丸）"}]},{"ID":"20240607114914-idtkdzi","Type":"NodeParagraph","Properties":{"id":"20240607114914-idtkdzi","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④治心经实热：黄连七钱，水一盏半，煎一盏，食远温服。小儿减之。（《局方》泻心汤）"}]},{"ID":"20240607114914-4ay09xk","Type":"NodeParagraph","Properties":{"id":"20240607114914-4ay09xk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑤治心下痞，按之濡，其脉关上浮者：大黄二两，黄连一两。上二味，以麻沸汤二升渍之，须臾绞去滓。分温再服。（《伤寒论》大黄黄连泻心汤）"}]},{"ID":"20240607114914-ogczcfh","Type":"NodeParagraph","Properties":{"id":"20240607114914-ogczcfh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑥治小结胸病，正在心下，按之则痛，脉浮滑者：黄连一两，半夏半升（洗），栝楼实大者一枚。上三味，以水六升，先煮栝楼，取三升，去滓，内诸药，煮取二升，去滓。分温三服。（《伤寒论》小陷胸汤）"}]},{"ID":"20240607114914-7n8p53d","Type":"NodeParagraph","Properties":{"id":"20240607114914-7n8p53d","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑦治大热盛，烦呕，呻吟，错语，不得卧：黄连三两，黄芩、黄柏各二两，栀子十四枚（擘）。上四味，切，以水六升，煮取二升，分二服。忌猪肉、冷水。（《外台秘要方》黄连解毒汤）"}]},{"ID":"20240607114914-at8l1xh","Type":"NodeParagraph","Properties":{"id":"20240607114914-at8l1xh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑧治伤寒胸中有热，胃中有邪气，腹中痛，欲呕吐者：黄连三两，甘草三两（炙），干姜三两，桂枝三两（去皮），人参二两，半夏半升（洗），大枣十二枚（擘）。上七味。以水一斗，煮取六升，去滓。温服，昼三夜二。（《伤寒论》黄连汤）"}]},{"ID":"20240607114914-8xqjpye","Type":"NodeParagraph","Properties":{"id":"20240607114914-8xqjpye","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑨治呕吐酸水，脉弦迟者：人参、白术、干姜、炙甘草、黄连，水煎服。（《症因脉治》连理汤）"}]},{"ID":"20240607114914-mtxvhmi","Type":"NodeParagraph","Properties":{"id":"20240607114914-mtxvhmi","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑩治肝火：黄连六两，吴茱萸一两或半两。上为末，水丸或蒸饼丸。白汤下五十丸。（《丹溪心法》左金丸一名回令丸）"}]},{"ID":"20240607114914-plth1p8","Type":"NodeParagraph","Properties":{"id":"20240607114914-plth1p8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑾治诸痢牌泄，脏毒下血：雅州黄连半斤，去毛，切，装肥猪大肠内，扎定，入砂锅中，以水酒煮烂，取连焙，研末，捣肠和丸梧子大。每服百丸，米汤下。（《仁斋直指方》）"}]},{"ID":"20240607114914-ohb16lz","Type":"NodeParagraph","Properties":{"id":"20240607114914-ohb16lz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑿治下痢：宣黄连、青木香，同捣筛，白蜜丸，如梧子。空腹饮下二、三十丸，日再。其久冷人，即用煨熟大蒜作丸。婴孺用之亦效。（《兵部手集方》香连丸）"}]},{"ID":"20240607114914-crfsqhn","Type":"NodeParagraph","Properties":{"id":"20240607114914-crfsqhn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒀治大冷洞痢肠滑，下赤白如鱼脑，日夜无节度，腹痛不可堪忍者：黄连六两，干姜二两，当归、阿胶各三荫。上四味，末之，以大醋八合烊胶和之，并手丸如大豆许，干之。大人饮服三十丸，小儿百日以还三丸，期年者五丸，余以意加减，日三服。（《千金方》驻车丸）"}]},{"ID":"20240607114914-lep67dx","Type":"NodeParagraph","Properties":{"id":"20240607114914-lep67dx","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒁治脏毒：鹰爪黄连末，用独头蒜一颗，煨香烂熟，研和入臼，治丸如梧子大。每服三、四十丸，陈米饮下。（《本事方释义》蒜连丸）"}]},{"ID":"20240607114914-83nzqpk","Type":"NodeParagraph","Properties":{"id":"20240607114914-83nzqpk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒂治脾受湿气，泄利不止，米谷迟化，脐腹刺痛，小儿有疳气下痢，亦能治之：黄连（去须）、吴茱萸（去梗，炒）、白芍药各五两。上为细末，面糊为丸，如梧桐子大。每服二十丸，浓煎米饮下，空心日三服。（《局方》戊己丸）"}]},{"ID":"20240607114914-o4pcmo4","Type":"NodeParagraph","Properties":{"id":"20240607114914-o4pcmo4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒃治心气不足，吐血衄血，亦治霍乱：大黄二两，黄连、黄芩各一两。上三味，以水三升，煮取一升。顿服之。（《金匮要略》泻心汤）"}]},{"ID":"20240607114914-2h1kqau","Type":"NodeParagraph","Properties":{"id":"20240607114914-2h1kqau","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒄治消渴能饮水，小便甜，有如脂麸片，日夜六、七十起：冬瓜一枚，黄连十两。上截冬瓜头去穰，入黄连末，火中煨之，候黄连熟，布绞取汁。一服一大盏，日再服，但服两三枚瓜，以差为度。（《近效方》）"}]},{"ID":"20240607114914-s477wto","Type":"NodeParagraph","Properties":{"id":"20240607114914-s477wto","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒅治妇人热劳羸瘦：黄连三两（去须），人参一两（去芦头），赤茯苓一两，黄芪一两（锉），木香半两，鳖甲一两半（涂醋，炙令黄，去裙襕），柴胡一两（去苗），地骨皮半两，桃仁一两半（汤浸去皮、尖、双仁，麸炒微黄）。上药，捣细罗为散，用好嫩猪肚一枚，将前药末安猪肚内，以线子缝合，蒸令烂熟，砂盆内研令如膏，为丸加梧桐子大。食前，以粥饮下三十丸。（《圣惠方》黄连猪肚丸）"}]},{"ID":"20240607114914-84e4nzp","Type":"NodeParagraph","Properties":{"id":"20240607114914-84e4nzp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒆治小儿胃热吐乳：黄连二钱，清半夏二钱。共为细末，分100等分，日服三次，每次一分。（辽宁《中草药新医疗法资料选编》）"}]},{"ID":"20240607114914-i76ko4h","Type":"NodeParagraph","Properties":{"id":"20240607114914-i76ko4h","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒇治甲赤痛，除热：黄连半两，大枣一枚（切）。上二味，以水五合，煎取一合，去滓，展绵取如麻子注目，日十夜再。（《僧深集方》黄连煎）"}]},{"ID":"20240607114914-kfr0xj5","Type":"NodeParagraph","Properties":{"id":"20240607114914-kfr0xj5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（21）治痈疽肿毒，已溃未溃皆可用：黄连、槟榔等分，为末，以鸡子清调搽之。（《简易方论》）"}]},{"ID":"20240607114914-uemfpgn","Type":"NodeParagraph","Properties":{"id":"20240607114914-uemfpgn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（22）治脓疱疮，急性湿疹：黄连、松香、海螵蛸各三钱。共研细末，加黄蜡二钱，放入适量熟胡麻油内溶化，调成软膏。涂于患处，每日三次。涂药前用热毛巾湿敷患处，使疮痴脱落。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240607114914-qw8wrvm","Type":"NodeParagraph","Properties":{"id":"20240607114914-qw8wrvm","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（23）治口舌生疮：黄连煎酒，时含呷之。（《肘后方》）"}]},{"ID":"20240607114914-lypbbz6","Type":"NodeParagraph","Properties":{"id":"20240607114914-lypbbz6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（24）治小儿口疳：黄连、芦荟等分，为束。每蜜汤眼五分。走马牙疳，入蟾灰等分，青黛减半，麝香少许。（《简便单方》）"}]},{"ID":"20240607114914-f4b7nl0","Type":"NodeParagraph","Properties":{"id":"20240607114914-f4b7nl0","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（25）治醇酒厚味，唇齿作痛，或齿龈溃烂，或连头面颈项作痛：黄连（炒）一钱五分，生地黄、牡丹皮、当归各一钱，升麻二钱。上水煎服，实热便秘加大黄。（《妇人良方》清胃散）"}]},{"ID":"20240607114914-cdcsde2","Type":"NodeParagraph","Properties":{"id":"20240607114914-cdcsde2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（26）治妊娠子烦，口干不得卧：黄连末，每服一钱，粥饮下，或酒蒸黄连丸，亦妙。（《妇入良方》）"}]},{"ID":"20240607114914-vob7j09","Type":"NodeParagraph","Properties":{"id":"20240607114914-vob7j09","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（27）治火烫伤：川连研末，调茶油搽之。（《中医杂志》（2）：170，1922）"}]},{"ID":"20240607114914-6el9a8t","Type":"NodeParagraph","Properties":{"id":"20240607114914-6el9a8t","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（28）治药中巴豆，下痢不止：末干姜、黄连，服方寸匕。（《补缺肘后方》）"}]},{"ID":"20240607114914-7c66unr","Type":"NodeParagraph","Properties":{"id":"20240607114914-7c66unr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607114914-k81bc0e","Type":"NodeParagraph","Properties":{"id":"20240607114914-k81bc0e","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" ①治疗细菌性痢疾"}]},{"ID":"20240607114914-ntew0dh","Type":"NodeParagraph","Properties":{"id":"20240607114914-ntew0dh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"黄连治疗菌痢，疗效比较肯定，多在用药5～7天治愈。所用口服剂量，小者每日2～3克，大者8～12克 。有人主张每日量以6克为宜，每日3克者效果差。小儿1岁以内0.2～0.3克，2～4岁0.3～0.6克，4～8岁0.5～1.0克，8岁以上0.5～1.5克，日服4～6次，首剂加倍。少数顽固病例可另用2～3％黄连溶液行保留灌肠，成人每次100～200毫升，每日1～2次。慢性菌痢肠粘膜有实质性病理改变者，可在乙状结肠镜的帮助下将黄连粉直接喷射于肠壁上，隔日1次，3～5次为一疗程。黄连对菌痢的远期疗效亦称良好，如复发再服仍有效，但对阿米巴痢疾疗效较逊，对小儿中毒型菌痢亦堪应用。急性菌痢的平均退热时间，短者为21小时，长者约为3.2天，腹痛消失时间为1.5～5.9天，大便培养转阴时间为3～5.8天。有人曾将黄连与碘胺药物、链霉素、痢疾噬菌体作疗效对比，发现临床症状改善的速度，黄连组与其他三组相等，而大便培养转阴时间，以黄连组为快。不少作者认为黄连至少不亚于其他几种治疗痢疾的药物，且不象碘胺类药、氯霉素等易有副作用。此外，黄连中所含的生物碱黄连碱对痢疾杆菌具有良好的抗菌效力，一般用量成人为100～200毫克，日服3～4次，待临床症状消失，大便性状转为正常及培养转阴后改用半量，连续2～3次培养阴性后停药。或用0.1％黄连素液1毫升加1％普鲁卡因液1毫升，作穴位注射。选穴：关元，气海，天枢，足三里（双侧交替注射），每穴0.5毫升，每天1次，7天为一疗程。手法为：进针慢，推药慢，出针快。共治疗急慢性菌痢87例，疗效以急性者为好。"}]},{"ID":"20240607114914-n3mb1jk","Type":"NodeParagraph","Properties":{"id":"20240607114914-n3mb1jk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②治疗伤寒"}]},{"ID":"20240607114914-2ddjayd","Type":"NodeParagraph","Properties":{"id":"20240607114914-2ddjayd","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连粉装入胶囊口服，每次2克，每4小时1次，直至体温正常后3～5日为止。治疗15例，临床治愈13例，2例无效；治愈病例完全退热之平均天数为5.6天。2例伤寒复发病人在用各种抗菌素及激素无效后，改用黄连素200毫克，日服3次，结果用药后第3日体温即显著下降，第13日完全恢复正常。共服21天并无不良反应。停药2周，大便培养2次阴性。有人报道使用香连丸（黄连、木香）治疗伤寒带菌者137例，绝对疗效在98％以上，但另一报道用香连丸或黄连素治疗伤寒带菌者11例，经长期观察均无效果。"}]},{"ID":"20240607114914-ywogp7t","Type":"NodeParagraph","Properties":{"id":"20240607114914-ywogp7t","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③治疗肺结核"}]},{"ID":"20240607114914-o1vqhar","Type":"NodeParagraph","Properties":{"id":"20240607114914-o1vqhar","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连素每次300毫克，每日3次口服，3个月为一疗程。报道30例肺结核患者的咯血、发热、咳嗽等症状治后全部消失，排菌者的阴转串为83.3％，X线摄片病灶吸收好转。亦有用2％黄连液戊0.25％黄连素液作气管滴入治疗结核性空洞，一般以薄壁空洞闭合率为高。曾有以黄连素与异烟胼并用治疗重症肺结核合并糖尿病的患者，用药后糖尿病病情亦呈观好转与稳定。"}]},{"ID":"20240607114914-q7jhl5z","Type":"NodeParagraph","Properties":{"id":"20240607114914-q7jhl5z","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④治疗流行性脑脊髓膜炎"}]},{"ID":"20240607114914-s4di9fq","Type":"NodeParagraph","Properties":{"id":"20240607114914-s4di9fq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"应用大剂量黄连素治疗40例，治愈24例，平均疗程为7.4天。少数患者脑脊液培养仍有脑膜炎双球菌生长，提示黄连素对抗脑膜炎双球菌的作用是制菌而非杀菌，并推测黄连素是通过脑膜血管到达脑膜从而控制炎症，而不是透过血脑屏障进入脑脊液。故认为黄连素对本病的治疗尚不够理想，不能取代磺胺药。"}]},{"ID":"20240607114914-x6s6pm9","Type":"NodeParagraph","Properties":{"id":"20240607114914-x6s6pm9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑤治疗大叶肺炎"}]},{"ID":"20240607114914-0lgbyox","Type":"NodeParagraph","Properties":{"id":"20240607114914-0lgbyox","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连粉内服，每次2分，每日4～6次。据23例观察，平均退热天数为2.9天。"}]},{"ID":"20240607114914-0k15w9z","Type":"NodeParagraph","Properties":{"id":"20240607114914-0k15w9z","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑥治疗猩红热"}]},{"ID":"20240607114914-al6n0ku","Type":"NodeParagraph","Properties":{"id":"20240607114914-al6n0ku","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用10％黄连糖浆内服治疗44例猩红热患者，全部治愈；与青霉素和青霉素加磺胺分组对比的结果，黄连组的疗效并不逊于其他两组。再有内服黄连干浸膏（0.25克约等于原生药1克）治疗猩红热患者38例，儿童剂量为0.15～0.3克，成人0.45克，每日3～4次，持续用药6.5天，少数病例兼用5％黄连液滴鼻或喷喉，均获痊愈。"}]},{"ID":"20240607114914-b7w68cv","Type":"NodeParagraph","Properties":{"id":"20240607114914-b7w68cv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑦治疗白喉"}]},{"ID":"20240607114914-m2qlpb0","Type":"NodeParagraph","Properties":{"id":"20240607114914-m2qlpb0","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连粉（每次0.6克，每日4～6次）内服，并配合1％黄连溶液漱口，治疗轻症白喉11例，体温在1～3天内恢复正常，假膜平均在2.6天消退。治疗后咽拭培养平均2.8天转为阴性。用上法治疗溃疡膜性咽炎亦取得良好效果。亦有采用黄连梗（即叶柄）治疗白喉的报道：凡白喉患者，病程未超过24小时，体温在38℃以下，一般状况较佳，局部未形成大块白膜者，用相当于火柴棒长短粗细的黄连梗8根，含置于口内齿颊间，每次1小时，每日3～4次；体温38℃以上的患者除含用黄连梗外，同时用10％黄连梗浸液（黄连梗10克加水浸泡48小时过滤，煎成100毫升，凉透备用），以喷雾器喷射咽腔，每日3～4次。经用上法治疗50例，全部治愈。"}]},{"ID":"20240607114914-7n6kxlm","Type":"NodeParagraph","Properties":{"id":"20240607114914-7n6kxlm","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑧治疗肺脓肿"}]},{"ID":"20240607114914-4eo63v0","Type":"NodeParagraph","Properties":{"id":"20240607114914-4eo63v0","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"采取气管内滴入与口服合并治疗法。每次滴入黄连素4～6毫克，每日1次，同时每日用黄连素1.2～4.8克，分3次服，4周为一疗程，每隔1周复查血常规、痰常规及胸透1次。病变在1个肺叶以内者28例，痊愈14例，显著进步10例，进步3例，无效1例；超过1个肺叶者4例，显著进步、进步各1例，无效2例。X线胸片确诊有空洞者25例，治后闭合者28例，无效2例。"}]},{"ID":"20240607114914-0rti8hi","Type":"NodeParagraph","Properties":{"id":"20240607114914-0rti8hi","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑨治疗脓胸"}]},{"ID":"20240607114914-20wegkk","Type":"NodeParagraph","Properties":{"id":"20240607114914-20wegkk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"取川黄连研粉用水浸煎2次，配制成10％的溶液，作游子透入。每日1次，每次20分钟，15～20次为一疗程。如病变顽固者，休息10天后可继续下一疗程。治疗小儿急性脓胸12例，以透入疗法为主，配合抽脓及全身支持疗法等。结果：透入10次以内痊愈（体温降至正常，气喘、呼吸困难消失，胸透积液完全消失）3例，好转（体温明显下降，气喘减轻，呼吸困难消失，胸透仍有少量积液）1例；透入10～23次痊愈者6例。另2例病情严重，控制感染无效，仅作数次透入疗法，即出现呼吸衰竭而死亡。据观察，黄连除对金黄色葡萄球菌和肺炎双球菌有显著的制菌作用外，并有特异的收敛作用，减轻炎性渗出，促进病灶的吸收，使症状缓解，病程缩短。临床可作为一种辅助治疗方法，但应尽早施行。"}]},{"ID":"20240607114914-bxvai2t","Type":"NodeParagraph","Properties":{"id":"20240607114914-bxvai2t","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑩治疗溃疡性结肠炎"}]},{"ID":"20240607114914-xue8i9z","Type":"NodeParagraph","Properties":{"id":"20240607114914-xue8i9z","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"共18例，治愈15例。治法：喷粉法-洗净患者肠内容物，凡使用乙状结肠镜可窥视到的溃疡及其他炎症病变，均可用带有长金属臂的喷粉器.将黄连粉直接喷到溃疡或病变部位，每次用药6～8分，隔日1次，9次为一个疗程，以后视病情需要可每隔1周进行第二或第三个疗程。定位灌肠法-病变如系高位，按X线检查测知的病变部位，算好自肛门到病变区的距离插入胶管（使用洗胃管，硬度合适），待胶管头部抵达目的地，然后将生黄连粉混于150毫升温水中灌入。注药后根据病变部位采用左侧、右侧、平卧和臀部高位等体位，同时嘱病人用双手压迫肠段病变的两端安静休息，一般1～2小时后可随意活动。隔日灌1次，9次为一疗程。需要时每隔1周可进行第二、第三疗程。行喷粉法或灌肠法，开始偶有痛感，经2～3次后即可消失，并无其他副作用。如添加适量盐酸普鲁卡因粉剂可避免疼痛，亦不影响疗效。在进行上述治疗时，应同时给予一般常规护理及治疗。"}]},{"ID":"20240607114914-5rp5at8","Type":"NodeParagraph","Properties":{"id":"20240607114914-5rp5at8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑾治疗高血压"}]},{"ID":"20240607114914-jx10pbp","Type":"NodeParagraph","Properties":{"id":"20240607114914-jx10pbp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连碱每天0.75～4克，分3～4次口服，疗程6～14天。治疗13例，结果有12例于治疗后数天内血压降至正常范围。据介绍，黄连碱能抑制链球菌，并有扩张血管的作用，故认为，黄连碱治疗急性肾炎之高血压，及用于高血压伴有心绞痛和冠状动脉机能不全时，可能收到双重效果。同时由于黄连素既有舒张血管降低血压的作用，故在治疗急性感染性疾患合并有血压降低或休克时，使用大剂量黄连应慎重。"}]},{"ID":"20240607114914-jfo9qnz","Type":"NodeParagraph","Properties":{"id":"20240607114914-jfo9qnz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑿治疗布氏杆菌病"}]},{"ID":"20240607114914-yyi26ql","Type":"NodeParagraph","Properties":{"id":"20240607114914-yyi26ql","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用0.2％注射液（每安瓿2毫升，含黄连素4毫克），每日2毫升肌肉注射，15天为一疗程，适用于各期布氏杆菌病患者，有一定疗效。或用黄连素5.5克，昔鲁卡因2.5克，蒸馏水1000毫升，配成无菌溶液，每天穴位注射3毫升，8天为一疗程。同时并配合对症治疗。观察31例，均有效。此外，曾有用黄连碱及大剂量黄连为主的煎剂内服进行临床观察，结果疗效都不明显。认为黄连及黄连碱对本病的疗效均甚差，且易于产生抗药性。"}]},{"ID":"20240607114914-r0olbac","Type":"NodeParagraph","Properties":{"id":"20240607114914-r0olbac","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒀治疗肺白色念珠菌病"}]},{"ID":"20240607114914-cytagv6","Type":"NodeParagraph","Properties":{"id":"20240607114914-cytagv6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"曾试用黄连2克，6小时服1次，配合维生素、葡萄糖生理盐水对1例肺白色念珠菌病作实验性治疗。用药2天后，临床症状显著好转，18天后，X线透视炎症消失，空洞不明显，痰细菌培养无致病菌生长。黄连总量共用160克。"}]},{"ID":"20240607114914-porp2gg","Type":"NodeParagraph","Properties":{"id":"20240607114914-porp2gg","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒁治疗结肠小袋纤毛虫病"}]},{"ID":"20240607114914-xy5uydo","Type":"NodeParagraph","Properties":{"id":"20240607114914-xy5uydo","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"本病是由于感染结肠小袋纤毛虫所引起的结肠炎，严重者可因衰竭而危及生命。治疗药物虽不下数十种，尚无疗效比较满意的。曾有1例用黄连粉0.6克，每日口服2次，治疗7天便次减少，腹痛减轻；第9天剂量增至1克，每日4次，用药4天后大便减为每日2次，腹痛消失；治疗18天大便成形，镜检未发现结肠小袋纤毛虫。临床症状全部消失。随访1月，体力恢复，参加劳动。"}]},{"ID":"20240607114914-uvdwc4h","Type":"NodeParagraph","Properties":{"id":"20240607114914-uvdwc4h","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒂防治麻疹"}]},{"ID":"20240607114914-er7o455","Type":"NodeParagraph","Properties":{"id":"20240607114914-er7o455","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"以35％黄连注射液1毫升肌注，用于有麻疹接触史而未见症状的儿童。如有咳嗽、目赤、流泪、流涕等症状出现，均1次注射2毫升；若出现典型症状，并兼有发热及麻疹粘膜斑者，第1次注射2毫升，2天后再注射2毫升，经2次注射，症状可基本消退而进入恢复期。曾用上法对57名有接触史之儿童进行预防注射，共观察24天，其中6名出现典型麻疹症状，16名只出现目赤、咳嗽或流泪，其余36名均未发病。"}]},{"ID":"20240607114914-5mgyjs4","Type":"NodeParagraph","Properties":{"id":"20240607114914-5mgyjs4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒃治疗百日咳"}]},{"ID":"20240607114914-i0mgutv","Type":"NodeParagraph","Properties":{"id":"20240607114914-i0mgutv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用100％黄连煎剂，疗效显著。与链霉素、氯（合）霉素相比较，疗效并不逊色。用药愈早效果愈好。剂量：1岁以下每日1.0～1.5毫升，1～2岁1.5～2.0毫升，2～5岁2.0～2.5毫升，5岁以上2.5～3毫升。均每日3次分服（每次均混以5～10毫升的饱和糖浆）。亦可用20％黄连注射液深部肌肉注射，1岁以下每次0.5～1.0毫升，1～2岁每次1.5～2.0毫升，2～5岁每次2～3毫升，5～12岁每次3～5毫升。每日或隔日一次，5～7次为一疗程。"}]},{"ID":"20240607114914-okvz45u","Type":"NodeParagraph","Properties":{"id":"20240607114914-okvz45u","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒄治疗烧伤"}]},{"ID":"20240607114914-4ng2n29","Type":"NodeParagraph","Properties":{"id":"20240607114914-4ng2n29","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"采用5～10％黄连油或2％黄连水治疗Ⅰ、Ⅱ度新鲜烧伤，可使创面迅速干燥；一般在24～48小时，即可结痂，具有明显的控制感染、缩短疗程作用。黄连油可用蓖麻油或麻油作溶剂，并加入普鲁卡因溶液，以减少刺激性。对脓性分泌物较多的创面，用20％黄连水湿敷或喷雾，如能同时用烤灯，保持创面干燥，则疗效更佳。"}]},{"ID":"20240607114914-5ty9pvx","Type":"NodeParagraph","Properties":{"id":"20240607114914-5ty9pvx","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒅治疗化脓性感染"}]},{"ID":"20240607114914-okw5luv","Type":"NodeParagraph","Properties":{"id":"20240607114914-okw5luv","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"一般局限在炎症浸润期者用10％黄连软膏贴敷，溃破或术后创口用2～10％黄连溶液换药；炎症较重者给予黄连粉胶囊1克，日服4次，可使疼痛减轻，并兼有健胃作用。治疗疖肿、痈、急性乳房脓肿、术后感染、急性淋巴腺炎等共66例，均于2.7～6天炎症消退，脓性分泌物减少，创面干净而愈。应据报道，100例外科急性化脓疮口换药用黄连纱条，与50例应用凡士林纱条进行比较，证实其疗效较凡士林纱条显著优异。另据100例创面脓液培养证明有47％的细菌对黄连有不同程度的敏感，黄连液的最低有效浓度为2～3％。"}]},{"ID":"20240607114914-i41r7yn","Type":"NodeParagraph","Properties":{"id":"20240607114914-i41r7yn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒆治疗肛裂"}]},{"ID":"20240607114914-aygidtd","Type":"NodeParagraph","Properties":{"id":"20240607114914-aygidtd","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用10％黄连（或黄柏）煎剂浸泡棉签于肛裂面作雀啄治疗，每次连续使用10余根，手法由轻至重；观察20例，一般只需治疗1～2次，便血即止，痛痒即瘥，2～5次痊愈。或有用黄连粉1份，绿豆粉1份调匀加适量生理盐水成糊状，治疗肛门瘘周围皮肤炎。换药次数随肛瘘换药次数而定。可使皮肤浸润消退，小脓疱及小水泡迅速结痴，应用2～3天后结痂很快脱落，完全恢复正常。"}]},{"ID":"20240607114914-7zodpem","Type":"NodeParagraph","Properties":{"id":"20240607114914-7zodpem","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒇治疗骨关节结核窦道"}]},{"ID":"20240607114914-y09pbtu","Type":"NodeParagraph","Properties":{"id":"20240607114914-y09pbtu","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用5％黄连煎液注入窦道中。如窦道较深，曲折不齐，可用细橡皮导尿管插入窦道处，然后注药，要求药液遍及脓腔，并挤压患部，使药液容易吸收。根据伤口的清洁情况；每日或隔日换药1次，连续1～2月或2月以上，可使窦道愈合。在最初1～2次注入药液后，患者可有不同程度发热反应，数次以后即不再发生。黄连除对结核杆菌有效外，尚可控制结核窦道的混合感染，并有收敛及制止发酵的作用。此外，对于慢性结核性瘘管，亦可按上法用细软的塑料管吸取1％黄连素液5毫升插入瘘管腔底部，进行灌注，疗程7～48天。此法有融解瘘管壁、促进新鲜肉芽组织增生的作用。治疗初期分泌物可骤增，坏死及秽暗肉芽组织很快分离液化，出现红润的颗粒性肉芽；随着治疗的继续，分泌物逐渐减少，炎症肿胀现象亦渐消退，治后并无后遗症。用黄连乌梅液浸纱布湿敷患处，每日1次，治疗创口肉芽过剩有一定效果。"}]},{"ID":"20240607114914-keoyrma","Type":"NodeParagraph","Properties":{"id":"20240607114914-keoyrma","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（21）治疗妇科疾病"}]},{"ID":"20240607114914-tmbjzpj","Type":"NodeParagraph","Properties":{"id":"20240607114914-tmbjzpj","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用20％黄连浸剂浸渍的阴道用棉拴，治疗49例滴虫性阴道炎，治愈率达95％以上。黄连用于治疗子宫颈糜烂和妇科其他炎症亦有一定效果。"}]},{"ID":"20240607114914-5kk5vmg","Type":"NodeParagraph","Properties":{"id":"20240607114914-5kk5vmg","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（22）治疗眼科疾病"}]},{"ID":"20240607114914-aub0npw","Type":"NodeParagraph","Properties":{"id":"20240607114914-aub0npw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用5～10％黄连溶液作眼浴或滴眼，可以治疗急性结合膜炎和一般浅层角膜炎。用黄连硼酸溶液（含黄连10％，硼酸3％）滴眼，治疗急性结合膜炎、浅层角膜炎（加用5％黄连膏外涂）、麦粒肿及各种睑缘炎等外眼炎症近200例，均取得良好疗效。采用黄连冰片液（含黄连20％）治疗急性结合膜炎亦有同样效果。曾用黄连素电游子透入治疗沙眼102例、睑缘炎30例，均有效。再有报道用10％黄连液每日滴眼2次，疗程3周，治疗沙眼110例，有效率86.3％；用10％黄连液浸泡海螵蛸（乌贼骨）棒摩擦沙眼，轻症1～3次，重症最多10次；通过1835人次临床观察，效果良好，反应均轻微。"}]},{"ID":"20240607114914-u0ks58b","Type":"NodeParagraph","Properties":{"id":"20240607114914-u0ks58b","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（23）治疗化脓性中耳炎"}]},{"ID":"20240607114914-bgrti3i","Type":"NodeParagraph","Properties":{"id":"20240607114914-bgrti3i","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连10％加入3％硼酸溶液100毫升中，浸泡后，蒸沸过滤2次。按常规洗净患耳，每日滴耳3～4次，对急性患者效果明显。亦有用复方黄连滴剂（黄连8钱，珊砂1.5钱，冰片1分，将黄连加水煎成100毫升后过滤，加入硼砂和冰片备用）治疗23例久治不愈的慢性化脓性中耳炎，短期内干耳者22例，仅1例复发。也可用0.5％黄连素作电游子透入治疗，据15人17个病耳的观察，其中急性者6个病耳全部治愈，慢性者11个病耳治愈3个，进步2个。"}]},{"ID":"20240607114914-xkag4lz","Type":"NodeParagraph","Properties":{"id":"20240607114914-xkag4lz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（24）治疗萎缩性鼻炎"}]},{"ID":"20240607114914-ij6ipao","Type":"NodeParagraph","Properties":{"id":"20240607114914-ij6ipao","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"以长约6厘米、宽0.5厘米之消毒纱条浸于10％黄连液内24小时以上，以之填塞于患侧鼻腔，每日1次，10次为一疗程。共治10例，对轻度或中度萎缩之病变效果良好，遇鼻甲高度萎缩及有大量结痂者疗效不佳。使用本药后对嗅觉恢复、结痂、鼻分泌物减少等方面效果显著。"}]},{"ID":"20240607114914-wbibkb4","Type":"NodeParagraph","Properties":{"id":"20240607114914-wbibkb4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（25）治疗咽峡炎"}]},{"ID":"20240607114914-zdir0wu","Type":"NodeParagraph","Properties":{"id":"20240607114914-zdir0wu","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"黄连粉0.4克（装胶囊，小儿酌减），日服4次；兼用1另黄连溶液含漱。治疗卡他性咽炎19例，急性咽峡炎33例，溃疡膜性咽炎4例。咽喉部红肿及颌下淋巴结肿大均在服药1～4日内恢复正常。"}]},{"ID":"20240607114914-upjvgtw","Type":"NodeParagraph","Properties":{"id":"20240607114914-upjvgtw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（26）治疗急性扁桃体炎"}]},{"ID":"20240607114914-6k826zy","Type":"NodeParagraph","Properties":{"id":"20240607114914-6k826zy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用10％黄连素注射液肌注，每次4毫升，每日2次。治疗8例，用药1～2天后，体温及白细胞总数均明显下降，最后恢复正常。有少数病例采用黄连素溶液喷雾，效果迅速，4小时后体温即降至正常，咽痛消失。"}]},{"ID":"20240607114914-uts2j04","Type":"NodeParagraph","Properties":{"id":"20240607114914-uts2j04","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（27）治疗上颌窦炎"}]},{"ID":"20240607114914-jugmrsr","Type":"NodeParagraph","Properties":{"id":"20240607114914-jugmrsr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"常规冲洗上颌窦后，每侧灌注30％黄连溶液2毫升，灌后头侧向注洗侧15分钟。每周1次，4～7次为一疗程。治疗15例，4例痊愈，8例进步，疗效不明及无效者3例。多数病人灌洗1～2次后即见效。治程中无全身不良反应。亦有用0.2％黄连小檗碱溶液（新鲜配制的无菌溶液）于每次上颌窦冲洗后，灌注2毫升，每周1～2次。据89例统计，治愈率为76.4％，有效率为83.2％。而采用青霉素治疗之81例上颌窦炎治愈率为43.2％。"}]},{"ID":"20240607114914-1e3de5i","Type":"NodeParagraph","Properties":{"id":"20240607114914-1e3de5i","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（28）治疗根管疾患"}]},{"ID":"20240607114914-94ez21s","Type":"NodeParagraph","Properties":{"id":"20240607114914-94ez21s","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用10％黄连浸液（经高压处理）冲洗根管，治疗24例，最短1次，最多5次，治愈22例。据观察，黄连制剂不仅有较强之灭菌作用，还有收敛作用，能促使瘘管早日封闭愈合；且黄连不具有对牙齿根尖牙周组织之有害刺激作用。"}]},{"ID":"20240607114914-bx2zb6e","Type":"NodeParagraph","Properties":{"id":"20240607114914-bx2zb6e","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（29）治疗口腔颌面部炎症"}]},{"ID":"20240607114914-2b12r41","Type":"NodeParagraph","Properties":{"id":"20240607114914-2b12r41","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"以黄连素（成人600～900毫克，日服3次，重症感染600毫克，日服4次，并加用注射，儿童酌减。疗程2～8天）用于16例口腔领面手术后，创口愈合良好，唇裂修补创口呈一期愈合；治疗急性牙周膜炎及急性根夹周炎共66例，45例经用药2～4天后症状消失，9例显著进步，6例无效，6例未再复诊；治疗急性牙周脓肿共21例，12例在用药同时切开引流，均于2日后临床症状消失而愈；治疗急性智齿冠周炎20例，经口服或注射本药后，11例症状消失而痊愈；治疗急性脓肿9例，经用药5～8天，5例痊愈，2例改善，2例疗效不明显。但使用黄连治疗时不能忽视一般治疗法则，更不能代替外科手术。"}]},{"ID":"20240607114914-eyntjbs","Type":"NodeParagraph","Properties":{"id":"20240607114914-eyntjbs","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（30）治疗皮肤癌染性炎症"}]},{"ID":"20240607114914-1bk8d28","Type":"NodeParagraph","Properties":{"id":"20240607114914-1bk8d28","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"采用10％黄连液行游子透入法治疗疖肿、痈等皮肤化脓性感染50例，结果有2/3患者治后当即感到疼痛减轻，早期炎症漫润很快消退，一般治疗1～3次即愈。已化脓者，治后脓疱很快破溃，坏死组织脱落，肉芽上皮迅速生长，创口愈合。平均治愈日数为4.7天，治程中无任何不良反应。"}]},{"ID":"20240607114914-0cnd5z9","Type":"NodeParagraph","Properties":{"id":"20240607114914-0cnd5z9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（31）治疗湿疹"}]},{"ID":"20240607114914-36refhg","Type":"NodeParagraph","Properties":{"id":"20240607114914-36refhg","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用黄连粉1份加蓖麻油3份调成混悬液，涂患部。共治疗20例，痊愈12例，进步5例，不明显3例。使用中末遇到疖肿等合并症发生。"}]},{"ID":"20240607114914-25y5g48","Type":"NodeParagraph","Properties":{"id":"20240607114914-25y5g48","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（32）治疗多型性渗出性红斑"}]},{"ID":"20240607114914-tp77j86","Type":"NodeParagraph","Properties":{"id":"20240607114914-tp77j86","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"口腔与唇部用黄连粉和蜂蜜调成10％糖浆涂布，躯干、肛门及外阴用10％黄连溶液涂抹（连渣），眼部用澄清之溶液；同时内服黄连粉胶囊1克，每日3次。共治疗9例，一般在第2天开始症状消退，3～13天痊愈。此病的主要症状发生于口腔，常见疱疹溃破糜烂；其他如眼、鼻、尿生殖道、肛门及脐部亦常伴发同样病变；以抗菌素及激素等治疗效果均不明显。"}]},{"ID":"20240607114914-ae4kzc5","Type":"NodeParagraph","Properties":{"id":"20240607114914-ae4kzc5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"此外，临床上有过内服或注射黄连素引起过敏反应的报道，应予重视。又曾对黄连的抗菌力与抗药性进行过实验研究，认为黄连复方的抗菌力远较单味为强，单味黄连的抗药性的形成远远高于复方。"}]},{"ID":"20240607114914-o0jdpu4","Type":"NodeParagraph","Properties":{"id":"20240607114914-o0jdpu4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607114914-tn1zjq8","Type":"NodeParagraph","Properties":{"id":"20240607114914-tn1zjq8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" ①《本草图经》：\"今医家洗眼汤，以当归、芍药、黄连等分停细切，以雪水或甜水煎浓汁，乘热洗，冷即再温洗，甚益眼目，但是风毒赤目花翳等皆可用之。其说云：凡眼目之病，皆以血脉凝滞使然，故以行血药合黄连治之，血得热即行，故乘热洗之，用者无不效。\""}]},{"ID":"20240607114914-xx0p009","Type":"NodeParagraph","Properties":{"id":"20240607114914-xx0p009","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"②《本草衍义》：\"黄连，今人多用治痢，盖执以苦燥之义。亦有但见肠虚渗泄，微似有血，便即用之，更不知止，又不顾寒热多少，但以尽剂为度，由是多致危困。若气实初病热多，血痢，服之便止，仍不必尽剂也。若虚而冷者，则不须眼。\""}]},{"ID":"20240607114914-deyj3jt","Type":"NodeParagraph","Properties":{"id":"20240607114914-deyj3jt","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"③《注解伤寒论》：\"苦入心，寒除热，大黄、黄连之苦，以导泻心下之虚热。\"\"上热者泄之以苦，黄连之苦以降阳。\"\"蛔得甘别动，得苦则安，黄连、黄柏之苦以安蛔。\""}]},{"ID":"20240607114914-ntcq8bm","Type":"NodeParagraph","Properties":{"id":"20240607114914-ntcq8bm","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"④刘完素：\"古方以黄连为治痢之最，盖治痢惟宜辛苦寒药，辛能发散，开通郁结，苦能燥湿，寒能胜热，使气宣平而已。诸苦寒药多泄，惟黄连、黄柏性冷而燥，能降火去湿，而止泄痢，故治痢以之为君。\""}]},{"ID":"20240607114914-4ijno5f","Type":"NodeParagraph","Properties":{"id":"20240607114914-4ijno5f","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑤李杲：\"诸痛痒疮疡，皆属心火，凡诸疮宜以黄连、当归为君，甘草、黄芩为佐。\""}]},{"ID":"20240607114914-jxsjrj3","Type":"NodeParagraph","Properties":{"id":"20240607114914-jxsjrj3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑥《汤液本草》：\"黄连苦燥，故入心，火就燥也，然泻心，其实泻脾也，为子能令母实，实则泻其子。治血，防风为上使，黄连为中使，地榆为下使。\""}]},{"ID":"20240607114914-xdwhxh3","Type":"NodeParagraph","Properties":{"id":"20240607114914-xdwhxh3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑦朱震亨：\"黄连，去中焦湿热而泻心火，若脾胃气虚，不能转运者，则以茯苓，黄芩代之。以猪胆汁拌炒，佐以龙胆草，则大泻肝胆之火。下痢胃热噤口者，用黄连、人参煎汤，终日呷之，如吐，再强饮，但得一呷下咽便好。\""}]},{"ID":"20240607114914-1wb303k","Type":"NodeParagraph","Properties":{"id":"20240607114914-1wb303k","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑧《韩氏医道》：\"火分之病，黄连为主，五脏皆有火，平则治，病则乱，方书有君火、相火、邪火、龙火之论，其实一气而已。故丹溪云，气有余便是火，分为数类。凡治本病，略炒以从：邪实火，以朴硝汤；假火，酒；虚火，醋；痰火，姜汁；俱浸透炒。气滞火，以茱萸；食积泄，黄土；血癥瘦痛，干漆；俱水拌同炒，去萸、土、漆。下焦伏火，以盐水浸透拌焙；目疾以人乳浸蒸，或点或服。生用为君，佐官桂少许，煎百沸，入蜜空心服之，能使心肾交于顷刻。入五苓滑石，大治梦遗。以上、姜、酒、蜜四者为君，使君子为臣，白芍药酒煮为佐，广木香为使，治小儿五疳。以茱萸炒者，加木香等分，生大黄倍之，水丸，治五痢。以姜汁酒煮者为末，和霞天膏，治癫痫诸风眩晕疮疡，皆效，非彼但云泻心火，而与芩、柏诸苦药例称者比也。\""}]},{"ID":"20240607114914-gbc6mc5","Type":"NodeParagraph","Properties":{"id":"20240607114914-gbc6mc5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑨《本草蒙筌》：\"黄连，久服之，反从火化，愈觉发热，不知有寒。故其功效，惟初病气实热盛者，服之最良，而久病气虚发热，服之又反助其火也。\""}]},{"ID":"20240607114914-v2nrldh","Type":"NodeParagraph","Properties":{"id":"20240607114914-v2nrldh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑩《医学入门》：\"黄连，酒浸炒，则上行头目口舌；姜汁炒，辛散冲热有功。一切湿热形瘦气急，一切时行热毒暑毒、诸般恶毒秽毒，诸疮疡毒。俱以姜和其寒，而少变其性，不使热有牴牾也。\""}]},{"ID":"20240607114914-v89o8ia","Type":"NodeParagraph","Properties":{"id":"20240607114914-v89o8ia","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑾《纲目》：\"黄连治目及痢为要药，古方治痢香连丸，用黄连、木香；姜连散，用干姜、黄连；变通丸，用黄连、茱萸；姜黄散，用黄连、生姜；治消渴，用酒蒸黄连；治伏暑，用酒煮黄连；治下血，用黄连、大蒜；治肝火，用黄连、茱萸；治口疮，用黄连、细辛，皆是一冷-热，一阴一阳，寒因热用，热因寒用，主辅相佐，阴阳相济，最得制方之妙，所以有成功而无偏胜之害也。\""}]},{"ID":"20240607114914-jpjnx47","Type":"NodeParagraph","Properties":{"id":"20240607114914-jpjnx47","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⑿《本草经疏》：\"黄连为病酒之仙药，滞下之神草，六经所至，各有殊功，其主热气目痛，眦伤泪出，明日、大惊、益胆者，凉心清肝胆也。肠澼腹痛下痢，《别录》主泄澼，泄者，泻利也，澼者，大肠下血也，俗呼为脏毒。除水、利骨、厚肠胃、疗口疮者，涤除肠、胃、脾三家之湿热也。久服令人不忘者，心家无火则清，清则明，故不忘。\""}]},{"ID":"20240607114914-frwf6dy","Type":"NodeParagraph","Properties":{"id":"20240607114914-frwf6dy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒀《本草汇言》：\"黄连，解伤寒疫热，定阳明、少阴赫曦之传邪，退心脾郁热，祛下痢赤白后重之恶疾。又如惊悸、怔忡、烦乱、恍惚而神志不宁，痛痒、疮疡、癍毒、瘄痘而邪热有余，黄连为必用也。若目痛赤肿，睛散羞明，乃肝之邪热也；呕逆恶心，吞吐酸苦，乃脾之邪热也；胁痛弦气，心下痞满，乃肝脾之邪热也；舌烂口臭，唇齿燥裂，乃心脾之邪热也；均属火热内甚，阳盛阴衰之证，非此不治。设或七情之火，聚而不散，六郁之火，结而不舒，用二陈以清之可也，然无黄连之苦寒，则二陈不能独清；吐血衄血，妄奔于上，溲血淋血，妄泄于下，用四生以止之可也，然无黄连之少佐，则四生不能独止。又有肠风下血，用之可以厚肠胃而止血。小便热闭，用之可以清内热而行便。又能退伏热而消蓄暑，其功专于泻火。清湿热而治疳热，其味在于苦寒。若胃虚不足，苦寒有不可投，姜汁制炒可也。阴分之病，苦寒有不能入，醇酒制炒可也。按法乘机而用，药至病自除矣。\""}]},{"ID":"20240607114914-dkkll3x","Type":"NodeParagraph","Properties":{"id":"20240607114914-dkkll3x","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒁《本草新编》：\"黄连，入心与胞络，最泻火，亦能入肝，大约同引经之药，俱能入之，而入心尤专任也。宜少用而不宜多用，可治实热而不可治虚热也。盖虚火宜补，而实火宜泻，以黄连泻火者，正治也，以肉桂治火者，从治也，故黄连、肉桂寒热实相反，似乎不可并用，而实有并用而成功者，盖黄连入心，肉桂入肾也。凡人日夜之间，必心肾两交，而后水火始得既济，水火两分，而心肾不交矣。心不交于肾，则日不能寐，肾不交于心，则夜不能寐矣，黄连与肉桂同用，则心肾交于顷刻，又何梦之不安乎?\""}]},{"ID":"20240607114914-soslbh8","Type":"NodeParagraph","Properties":{"id":"20240607114914-soslbh8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"⒂《本草经百种录》：\"凡药能去湿者必增热，能除热者，必不能去湿，惟黄连能以苦燥湿，以寒除热，一举两得，莫神于此。心属火，寒胜火，则黄连宜为泻心之药，而反能补心何也?盖苦为火之正味，乃以味补之也。若心家有邪火，则此亦能浑之，而真火反得宁，是泻之即所以补之也。\""}]},{"ID":"20240607114914-l12vrsa","Type":"NodeParagraph","Properties":{"id":"20240607114914-l12vrsa","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（16）《本经疏证》：\"伤寒胸中有热，胃中有邪气，腹中疼，欲呕吐者，黄连汤主之。少阴病二、三日以上，心中烦、不得卧，黄连阿蚊汤主之。二方皆以黄连为君，二证皆发于心，可见黄连为泻心火之剂矣。\""}]},{"ID":"20240607114914-cspsdrf","Type":"NodeParagraph","Properties":{"id":"20240607114914-cspsdrf","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（17）《本草思辨录》：\"黄连之用，见于仲圣方者，黄连阿胶汤，治心也；五泻心汤、黄连汤、干姜黄连黄芩人参汤，治胃也，黄连粉，治脾也；乌梅丸，治肝也；白头翁汤、葛根黄芩黄连汤，治肠也。其制剂之道，或配以大黄、芍药之泄，或配以半夏、栝楼实之宣，或配以干姜、附于之温，或配以阿胶、鸡子黄之濡，或配以人参、甘草之补，因证制宜，所以能收苦燥之益而无苦燥之弊也。\""}]},{"ID":"20240607114914-xzocet5","Type":"NodeParagraph","Properties":{"id":"20240607114914-xzocet5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（18）《本草正义》：\"黄连大苦大寒，苦燥湿，寒胜热，能泄降一切有余之湿火，而心、脾、肝、肾之热，胆、胃、大小肠之火，无不治之。上以清风火之目病，中以平肝胃之呕吐，下以通腹痛之滞下，皆燥湿清热之效也。又苦先入心，清涤血热，故血家诸病，如吐衄溲血，便血淋浊，痔漏崩带等证，及痈疡斑疹丹毒，并皆仰给于此。但目疾须合泄风行血，滞下须兼行气导浊，呕吐须兼镇坠化痰，方有捷效，仅恃苦寒，亦不能操必胜之券。且连之苦寒，尤以苦胜，故燥湿之功独显，凡诸证之必需于连者，类皆湿热郁蒸，恃以为苦燥泄降之资，不仅以清热见长，凡非舌厚苔黄，腻浊满布者，亦不任此大苦大燥之品。即疮疡一科，世人几视为阳证通用之药；实则惟疔毒一证发于实火，需连最多，余惟湿热交结，亦所恒用。此外血热血毒之不挟湿邪者；自有清血解毒之剂，亦非专恃黄连可以通治也。\""}]},{"ID":"20240607114914-td00xfm","Type":"NodeParagraph","Properties":{"id":"20240607114914-td00xfm","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607114914-o0bfni2","Type":"NodeParagraph","Properties":{"id":"20240607114914-o0bfni2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 此外，尚有短萼黄连（分布广西、广东、福建、安徽、浙江、江西、湖南、贵州，少有栽培），五裂黄连（分布云南东南部），亦同供药用。"}]},{"ID":"20240607114914-uw7w70n","Type":"NodeParagraph","Properties":{"id":"20240607114914-uw7w70n","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"此外，植物短萼黄连的根，商品多称为\"土黄连\"或\"土川连\"，各地有少量生产；植物五裂黄连的根，在云南亦作\"云连\"使用。黄连加工过程的剩余部分-黄连须（须根）、剪口连（叶柄基部）、千子连（全部叶柄）、黄连叶（叶片）、黄连渣（撞笼中撞下的渣子）在少数地区亦代黄连使用。"}]},{"ID":"20240607114914-odlho4o","Type":"NodeParagraph","Properties":{"id":"20240607114914-odlho4o","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114914-3z8b8q4","Type":"NodeParagraph","Properties":{"id":"20240607114914-3z8b8q4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607114914-m6akq2f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114914-m6akq2f","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"《中华本草》：黄连"}]},{"ID":"20240607114914-qapra4l","Type":"NodeParagraph","Properties":{"id":"20240607114914-qapra4l","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114914-pgof3ew","Type":"NodeParagraph","Properties":{"id":"20240607114914-pgof3ew","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" Huánɡ Lián"}]},{"ID":"20240607114914-5a3nop5","Type":"NodeParagraph","Properties":{"id":"20240607114914-5a3nop5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114914-b2vokot","Type":"NodeParagraph","Properties":{"id":"20240607114914-b2vokot","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 王连、支连"}]},{"ID":"20240607114914-sde5i54","Type":"NodeParagraph","Properties":{"id":"20240607114914-sde5i54","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607114914-9txrac6","Type":"NodeParagraph","Properties":{"id":"20240607114914-9txrac6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" Coptis Root, Golden Thread"}]},{"ID":"20240607114914-8t5hfbr","Type":"NodeParagraph","Properties":{"id":"20240607114914-8t5hfbr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607114914-6tp99b4","Type":"NodeParagraph","Properties":{"id":"20240607114914-6tp99b4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607114914-e5biej5","Type":"NodeParagraph","Properties":{"id":"20240607114914-e5biej5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"1．《别录》：黄连，生巫阳川谷及蜀郡、太山。二月、八月采。"}]},{"ID":"20240607114914-2p2vrbh","Type":"NodeParagraph","Properties":{"id":"20240607114914-2p2vrbh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2．陶弘景：黄连，今西间者色浅而虚，不及东阳、新安诸县最胜。临海诸县者不佳。用之当布裹去毛，令如连珠。俗方多疗下痢及渴。"}]},{"ID":"20240607114914-jh7w5ft","Type":"NodeParagraph","Properties":{"id":"20240607114914-jh7w5ft","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3．《唐本草》：黄连，蜀道者粗大节平，味极浓苦，疗渴为最；江东者节如连珠，疗痢大善。今澧州者更胜。"}]},{"ID":"20240607114914-fflgsfc","Type":"NodeParagraph","Properties":{"id":"20240607114914-fflgsfc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"4．《四声本草》：黄连，今出宣州绝佳，东阳亦有，歙州、处州者次。"}]},{"ID":"20240607114914-n10tqzo","Type":"NodeParagraph","Properties":{"id":"20240607114914-n10tqzo","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114914-922rokc","Type":"NodeParagraph","Properties":{"id":"20240607114914-922rokc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 药材基源：为毛茛科植物黄连、三角叶黄连或云南黄连的根茎。"}]},{"ID":"20240607114914-qk6ozcr","Type":"NodeParagraph","Properties":{"id":"20240607114914-qk6ozcr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Coptis chinensis Franch.[C.teeta Wall.var.chinensis Finet et Gagnep.]2.Coptis deltoidea C.Y.Cheng et Hsiao3.Coptis teetoides C.Y.Cheng"}]},{"ID":"20240607114914-u3arits","Type":"NodeParagraph","Properties":{"id":"20240607114914-u3arits","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"采收和储藏：黄连栽后5-6年的10-11月间收获。用黄连抓子连根抓起，抖掉泥土，剪去须根和叶，取根茎在黄连炕上供炕干燥，烘时用操板翻动，并打掉已干燥的泥土。五六成平时出炕，根据根茎大小，分为3-4等，再分别细炕，勤翻动，待根茎断面呈干草色时即可出炕，装入槽笼，撞掉泥土和须根即成。每1hm2可产干黄连1500-2250kg。"}]},{"ID":"20240607114914-1v9p6vr","Type":"NodeParagraph","Properties":{"id":"20240607114914-1v9p6vr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607114914-tafji9g","Type":"NodeParagraph","Properties":{"id":"20240607114914-tafji9g","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔1000-2000m山地密林中或山谷阴凉处。野生或栽培。"}]},{"ID":"20240607114914-ej8r4k7","Type":"NodeParagraph","Properties":{"id":"20240607114914-ej8r4k7","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.栽培于四川峨眉及洪雅-带海拔1600-2200m之间的山地林下。"}]},{"ID":"20240607114914-iyf0t94","Type":"NodeParagraph","Properties":{"id":"20240607114914-iyf0t94","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.生于海拔1500-2300m之间的高山寒湿的林荫下，野生或栽培。"}]},{"ID":"20240607114914-86oz20t","Type":"NodeParagraph","Properties":{"id":"20240607114914-86oz20t","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于陕西、湖北、湖南、四川、贵州等地；在四川东部。"}]},{"ID":"20240607114914-c5eyfjr","Type":"NodeParagraph","Properties":{"id":"20240607114914-c5eyfjr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"湖北西部和陕西南部有较大量栽培。"}]},{"ID":"20240607114914-kcxpwjf","Type":"NodeParagraph","Properties":{"id":"20240607114914-kcxpwjf","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.分布于云南西北部及西藏东南部。"}]},{"ID":"20240607114914-erkssgu","Type":"NodeParagraph","Properties":{"id":"20240607114914-erkssgu","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607114914-r2sv0x3","Type":"NodeParagraph","Properties":{"id":"20240607114914-r2sv0x3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.黄连，多年生草本。根茎黄色，常分枝，密生多数须根。叶全部基生；叶柄长5-12（-16）cm；叶片坚纸质，卵状三角形，宽达10cm，3全裂；中央裂片有细柄，卵状菱形，长3-8cm，宽2-4cm，顶端急尖，羽状深裂，边缘有锐锯齿，侧生裂片不等2深裂，表面沿脉被短柔毛。花葶l-2，高12-25cm，二歧或多歧聚伞花序，有花3-朵；总苞片通常3，披针形，羽状深裂，小苞片圆形，稍小；萼片5，黄绿色，窄卵形，长9-12.5mm；花瓣线形或线状披针形，长5-7mm，中央有蜜槽；雄蕊多数，外轮雄蕊比花瓣略短或近等长；心皮8-12，离生，有短柄。蓇葖果6-12，长6-8mm，具细柄。种子7-8粒，长椭圆形，长约2mm，宽约0.8mm，褐色。花期2-4月，果期3-6月。"}]},{"ID":"20240607114914-fvsywm7","Type":"NodeParagraph","Properties":{"id":"20240607114914-fvsywm7","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.三角叶黄连，根茎黄色，不分枝或少分枝，节间明显，密生多数细根，匍匐茎横走。叶片卵形，宽达15cm，3全裂；中央裂片三角状卵形，长3-12cm，宽3-10cm，羽状深裂，深裂片多少彼此密接。花瓣近披针形，雄蕊短，仅为花瓣的1／2左右。3.云南黄连，根茎黄色，节间密，较少分枝，生多数须根。叶片卵状三角形，长6-12cm，宽5-9cm，三全裂，中央裂片卵状菱形，先端长渐尖至渐尖，羽状深裂，深裂片彼此流离，相距最宽处可达1.5cm。花瓣匙形至卵状匙形，先端钝。"}]},{"ID":"20240607114914-g4di8gj","Type":"NodeParagraph","Properties":{"id":"20240607114914-g4di8gj","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607114914-1w6y0m4","Type":"NodeParagraph","Properties":{"id":"20240607114914-1w6y0m4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.生物学特性 黄连性喜冷凉阴湿，在川东、鄂西海拔1200-1800m的高山地区有大量栽培，产区多雨多雾，年平均温度在10℃左右，7月份平均21℃，1月份平均-3--4℃，冬季在冰雪覆盖下越冬，叶可保持常绿不枯。年平均降雨量1300-1700mm，大气相对湿度90％左右。耐肥力很强；土壤以上泡下实，土壤上层以富含腐殖质肥沃疏松的沙壤土，下层以保水保肥力较强的粘壤上最适宜；酸性至微酸性土，pH5.5左右。黄连为阴地植物，有强大的叶面积群，可利用林间间隙照射的阳光，忌直射强光。"}]},{"ID":"20240607114914-5q446y8","Type":"NodeParagraph","Properties":{"id":"20240607114914-5q446y8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.栽培技术 用种子繁殖。种子底胚后熟类型。5月上旬种子成熟采收后，选择阴凉较平坦的山坡用树枝搭荫棚，雨水能自然淋入棚内，挖20cm深地作窖，将种子与湿沙在窖内层积贮藏。经早晚及秋季低温，胚逐渐发育形成。10- 11月间种子裂口后撒播于高畦，每1hm2播种子22.5-37.5kg，用牛马粪覆盖。次年2月下旬在畦面搭矮棚遮荫，3月初出苗，拣去畦面落叶，并除净杂草。苗期5-6月间应追施速效性氮肥催苗，10-11月间撒细碎牛马粪及火灰腐殖土以利越冬。传统的栽连技术都采用搭棚遮荫，于冬季砍树搭1.2m高荫棚，荫蔽度70％左右，棚内作1.6m宽高畦（厢）。播种后第3年3月间苗圃幼苗已长出4-6片真叶时移栽，行株距10cm×10cm，栽深3-5cm，每1hm2栽苗75-90万株。近年有用玉米间作与林间栽连技术，冬季在畦面以行株距1.6m见方，间隔栽植麻、桑等灌木及松、杉等乔木。早春2月末在塑料矮棚中作营养钵培育玉米苗。"}]},{"ID":"20240607114914-dtmgvc2","Type":"NodeParagraph","Properties":{"id":"20240607114914-dtmgvc2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"苗高30cm左右时，在高畦沟两边以株距30cm，叶对叶定向移栽玉米苗，6、7月份玉米叶封垄后即在行间栽黄连。冬季玉米收获后，用玉米秆编织矮棚，为黄连遮荫。次年复栽玉米，约4-5年后灌木已成林，可为黄连遮荫，不再栽种玉米。黄连收获后在林间整地，施足底肥，还可再栽连；灌木林栽黄连2-3季后，乔木已成林，便可砍伐灌木，在乔木林下栽连。采用玉米和造林遮荫技术栽连，不但不影响黄连产量，同时省工、省料、节约投资，活立木积蓄量比不栽黄连的树林快1倍。"}]},{"ID":"20240607114914-79fnrou","Type":"NodeParagraph","Properties":{"id":"20240607114914-79fnrou","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.田间管理 栽植后，立即撒施少量牛马粪及熏土称刀口肥。"}]},{"ID":"20240607114914-1rldgmp","Type":"NodeParagraph","Properties":{"id":"20240607114914-1rldgmp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"每年早春、夏季种子收获后及冬季10-11月间各追肥1次，春夏以氮磷等速效性肥料为主，冬肥以牛马粪及熏土为主，施各肥后应培土。第1、第2年培土约1cm，第3、第4年2-3cm。追肥前应除草，移栽后一二年苗小露地孔隙大，易生杂草，每年应拔草4-5次，四五年生黄连已封垄，结合追肥每年拔草3次。搭棚栽连，当年5月种子采收后应揭去盖棚敞阳，抑制叶的生长，促使根茎充实；林间栽连，栽后第3年开始冬季应修枝亮棚，使荫蔽度由栽连时的70％左右降低到20％-30 ％。"}]},{"ID":"20240607114914-zafdziz","Type":"NodeParagraph","Properties":{"id":"20240607114914-zafdziz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"4.病虫害防治 主要病害有白粉病，应降低荫蔽度增加光照并可用石硫合剂防治。虫害有蛴螬、蝼蛄等，可用毒饵诱杀。早春有麂子、锦鸡为害花苔和种子，应围以篱笆，加强人工捕杀，减较为害。"}]},{"ID":"20240607114914-laxpbwr","Type":"NodeParagraph","Properties":{"id":"20240607114914-laxpbwr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607114914-upueqg7","Type":"NodeParagraph","Properties":{"id":"20240607114914-upueqg7","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 （1）味连 根茎多簇状分枝，弯曲巨抱，形似倒鸡爪状，习称“鸡爪黄连”；单枝类圆柱形，长3-6cm，直径2-8mm。表面灰黄色或黄棕色，外皮剥落处显红棕色，粗糙，有不规则结节状隆起、须根及须根残基，有的节间表面平滑如茎杆，习称“过桥”；上部多残留褐色鳞叶，顶端常留有残余的茎或叶柄。质坚硬，折断面不整齐，皮部橙红色或暗棕色，木部鲜黄色或橙黄色，髓部红棕色，有时中空。气微，味极苦。"}]},{"ID":"20240607114914-9z2hz5u","Type":"NodeParagraph","Properties":{"id":"20240607114914-9z2hz5u","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（2）雅连 多为单枝，略呈圆柱形，微弯曲，长4-8cm，直径5-10mm。过桥较长。顶端有少许残茎。"}]},{"ID":"20240607114914-o9m1pvt","Type":"NodeParagraph","Properties":{"id":"20240607114914-o9m1pvt","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（3）云连 多为单枝，弯曲呈约状，较细小，长2-5cm，直径2-4mm。"}]},{"ID":"20240607114914-y35n8qw","Type":"NodeParagraph","Properties":{"id":"20240607114914-y35n8qw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"以身干粗壮、残留叶柄及须根少、质坚实、断面红黄色者为佳。"}]},{"ID":"20240607114914-ngz0ge6","Type":"NodeParagraph","Properties":{"id":"20240607114914-ngz0ge6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 根茎横切面：（1）味连 鳞叶组织常脱落。木栓层为数列木栓细胞。皮层宽广，有的可见根迹和叶迹维管束；石细胞黄色，单个散在或数个成群。纸管束外韧型，呈断续的环状排列，束间形成层不明显。韧皮部外侧有纤维束，大小不等有数个至数十个或上百个纤维；有的还伴有黄色石细胞。木质部黄色，均木化；木纤维较发达。髓部薄壁细胞间有时可见少数单个或成群存在的石细胞。薄壁细胞均含淀粉粒。"}]},{"ID":"20240607114914-06a4g56","Type":"NodeParagraph","Properties":{"id":"20240607114914-06a4g56","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（2）雅连 与味连相似，但髓部有多数石细胞。"}]},{"ID":"20240607114914-r6hv5zn","Type":"NodeParagraph","Properties":{"id":"20240607114914-r6hv5zn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（3）云连 无石细胞和韧皮纤维。"}]},{"ID":"20240607114914-f8flp7b","Type":"NodeParagraph","Properties":{"id":"20240607114914-f8flp7b","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.粉末特征：（1）味连 黄棕色或黄色。①石细胞鲜黄色，类圆形、类方形、类多角形或稍延长，直径25-64μm，长约至102μm，壁厚9-28μm，纹孔明显，有的层纹明显。②木纤维众多，黄色，细长；直径10-13ctn，壁稍厚，木化，纹孔稀疏。③韧皮纤维鲜黄色，纺锤形或长梭形，长136-185μm，直径25-40μm，壁较厚，纹孔较稀。④导管主为孔纹和螺纹导管，直径8-20μm。⑤淀粉粒多为单粒，长圆形、肾形、类球形或卵形，直径1-10μm；复粒少数，由2-4分粒组成。③鳞叶表皮细胞绿黄色或黄棕色，略呈长方形，壁微波状弯曲。"}]},{"ID":"20240607114914-smji8bk","Type":"NodeParagraph","Properties":{"id":"20240607114914-smji8bk","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（2）雅连 与味连相似，主要特征：石细胞较多，鲜黄色，长椭圆形、类方形、类长方形或不规则条形，长35-252μm，直径23-102μm，墨厚7-26μm，层纹细密而用显。"}]},{"ID":"20240607114914-tjogoee","Type":"NodeParagraph","Properties":{"id":"20240607114914-tjogoee","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（3）云连 无石细胞。"}]},{"ID":"20240607114914-mid74zn","Type":"NodeParagraph","Properties":{"id":"20240607114914-mid74zn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607114914-hagya0a","Type":"NodeParagraph","Properties":{"id":"20240607114914-hagya0a","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 小檗碱的治疗量相当安全，副作用也很少，长期服用也未见任何障碍，一次口服小檗碱2.0g或连用黄连粉100g未见任何副作用。在动物试验中，毒性也很轻，给小鼠口服不易致死，腹腔注射的最小致死量为 O.01g/kg，亦有测得其半数致死量为0.066g/kg(黄柏或黄连则各为0.52，0.73g/kg)。猫口服0.1g/kg可引起全身抑制，呕吐，于8-10天后死亡，呼吸由兴奋转向麻痹，死亡前可发生惊厥。小鼠腹腔注射硫酸小檗碱的半数致死量为24.3 mg/kg。四氢小檗碱给小鼠灌胃、皮下及静脉注射的半数致死量分别为940mg/kg、790mg/kg及100mg/kg。 盐酸小檗碱腹腔注射对小鼠的半数致死量为24.3mg/kg。小檗碱最严重的毒性为心脏毒性，在临床可出现急性心源性脑缺氧综合征，100mg于葡萄糖溶液中滴注，病人有出现头昏、气急、心律紊乱、循环呼吸吸骤停等，并有死亡病例报道。过敏反应也较多见，小檗碱针剂（0.1%）2-4ml im，有出现全身搔痒、荨麻疹、体温升高、心慌、关节疼痛、呼吸迪促、烦躁不安、恶心、呕吐、严重的可致血压下降出现过敏性休克。"}]},{"ID":"20240607114914-frfb9bz","Type":"NodeParagraph","Properties":{"id":"20240607114914-frfb9bz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607114914-nrx2gww","Type":"NodeParagraph","Properties":{"id":"20240607114914-nrx2gww","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.黄连 根茎含小檗碱（berberine）5. 56％-7.25％，黄连碱（coptisine），表小檗碱（epiberberine），小檗红碱（berberrubine），掌叶防已碱（palmatine），非洲防己碱（columbamine），药根碱（jatrorrhizine），甲基黄连碱（worenine），木兰花减（magnoflorine），阿魏酸（ferulic acid），黄柏酮（obakunone），黄柏内酯（obakulactone）。"}]},{"ID":"20240607114914-hiz1gw1","Type":"NodeParagraph","Properties":{"id":"20240607114914-hiz1gw1","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.三角叶黄连 根茎含表小檗碱，小檗碱，黄连碱，掌叶防已碱，甲基黄连碱，药根碱，木兰花碱。"}]},{"ID":"20240607114914-hah304d","Type":"NodeParagraph","Properties":{"id":"20240607114914-hah304d","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.云南黄连 根茎含小檗碱，掌叶防已碱，药根碱，甲基黄连碱，木兰花碱，黄连碱。"}]},{"ID":"20240607114914-1sifp6x","Type":"NodeParagraph","Properties":{"id":"20240607114914-1sifp6x","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607114914-hllofei","Type":"NodeParagraph","Properties":{"id":"20240607114914-hllofei","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用：黄连煎剂100%浓度，平皿法实验表明对痢疾痢杆菌、伤寒杆菌、副伤寒杆菌、霍乱弧菌、大肠杆菌、变形杆菌等7种革兰氏阴性菌及葡萄球菌、a-溶血性链球菌、B-溶血性链球菌、肺炎双球菌、百日咳杆菌等5种革兰氏阳性菌皆有较强的抑菌作用。黄连煎剂以试管稀释法试验表明1：160 对宋内氏、1 ：1280 对弗氏、1：2560 对志贺氏、1 ：5120 对施氏痢疾杆菌，1：160 对伤寒杆菌，1：128 对鼠疫杆菌，1：160及1：1280分别对a-及B-溶血性链球菌，1：640对白喉杆菌、肺炎双球菌、霍乱弧菌，1：2560对人结核杆菌（H37）有抑制作用。黄连水煎液1 ：640对炭疽杆菌，1：320对金黄色葡萄球菌、丹毒杆菌，1：20对绿脓杆菌有抑制作用。黄连煎液100%，酊剂20%，用平皿滤纸法或渗透法试验对志贺氏、施氏、弗氏痢疾杆菌及金黄色葡萄球菌、链球菌均有显着的抑制作用。黄连水煎剂100%浓度，平皿打孔法试验，对志贺氏、弗氏、宋内氏和施氏4种痢疾杆菌均具有抗菌作用。黄连煎剂1：1-1：128浓度，对百日咳杆菌有抑菌作用。小檗碱1 ：4000浓度对结核杆菌有抑制作用，1.5，2.5g/kg 灌胃，连续21，28天，可延缓小鼠实验性结核病的发展。小檗碱1：32000浓度对溶血性链球菌、肺炎双球菌、炭疽杆菌、霍乱弧菌有抑制作用；1 ：16000对金黄色葡萄球菌、白色葡萄球菌有抑制作用；1 ：8000对柠檬色葡萄球菌、绿色链球菌、白喉杆菌、枯草杆菌、志贺氏痢疾杆菌、福氏痢疾杆菌有抑制作用；1 ：4000对肺炎杆菌、变形杆菌有抑制作用；1 ：1000对伤寒杆菌有抑制作用；实验发现有7种氨基酸（天冬氨酸及其酰胺、组氨酸、甘氨酸、甲硫氨酸、苏氨酸、色氨酸）3种维生素（烟酸及烟酰胺、对氨苯甲酸、维生素 B6）及腺苷酸、尿嘧啶能对抗小檗碱的抗菌作用，因此小檗碱的抗菌作用可能是通过影响细菌的代谢过程来实现的。黄连煎剂及醇提剂1g/ml，平板打洞法试验表明对脑膜炎球菌有抑制作用，试管稀释法煎剂1 ：1280，醇提剂1：320 对脑膜炎球菌有抑制作用。小檗碱对3H－胸腺嘧啶核苷和3H－尿嘧啶核苷参入金黄色葡萄球菌及大肠杆菌，低浓度（10μg/ml）呈促进，高浓度（100，500mg/ml）呈抑制作用。"}]},{"ID":"20240607114914-esvz6lz","Type":"NodeParagraph","Properties":{"id":"20240607114914-esvz6lz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用：黄连煎剂15%浓度对许兰氏黄癣菌、许兰氏黄癣菌蒙古变种、铁锈色毛癣菌有抑制作用，8%浓度对狗小芽胞菌、絮状表皮癣菌、堇色毛癣菌有抑制作用，10%浓度对共心性毛癣菌、20%浓度对红色毛癣菌、25%浓度对足跖毛癣菌、35%浓度对白色念珠菌有抑制作用。黄连水浸剂1：3浓度对堇色毛癣菌、同心性毛癣菌、石膏样毛癣菌、许兰氏黄癣菌、奥杜盎氏小芽胞菌、铁锈色小芽胞菌、羊毛状小芽胞菌、腹股沟表皮癣菌、红色表皮癣菌、考夫曼一沃尔夫氏表皮癣菌、白色念珠菌、紧密着色芽生菌、星形奴卡氏菌等有抑菌作用。"}]},{"ID":"20240607114914-yqn0kk9","Type":"NodeParagraph","Properties":{"id":"20240607114914-yqn0kk9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.抗病毒作用：黄连煎剂50%浓度0.1ml/蛋，鸡胚法试验表明对流感病毒PR8株、甲型流感病毒56-S8株、亚甲型病毒FMl株、乙型流感病毒Lee株、内型流感病毒1233株均有抑制作用。黄连煎剂25-100%浓度对乙型肝炎病毒DNA有抑制作用。小檗碱0.5mg/蛋，能有效地降低沙眼病毒感染鸡胚的死亡率，并抑制病毒原生小体的产生。"}]},{"ID":"20240607114914-lwr1ayg","Type":"NodeParagraph","Properties":{"id":"20240607114914-lwr1ayg","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"4.抗阿米巴作用：黄连煎剂1：20-1 ：80 浓度、小檗碱1：5000-1 ：10，000浓度体外试验有抗阿米巴作用；黄连煎剂1.3g/kg 灌胃，小檗碱50mg/kg 灌胃 对接种于大鼠盲肠的溶组织阿米巴原虫有杀灭作用。"}]},{"ID":"20240607114914-uvjqpn9","Type":"NodeParagraph","Properties":{"id":"20240607114914-uvjqpn9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"5.抗炎、抗腹泻作用：黄连甲醇提取物400μg/只对鸡受精卵法试验，表明有抑制肉芽组织增生的作用，盐酸小檗碱50mg/kg 灌胃，对大鼠巴豆油囊法、棉球法也表现有抗炎作用。小檗碱1×10(-4)浓度体外试验有抑制人多形核白细胞产生白三烯B4的作用，抑制率为43.7±5.6%。小檗碱40.80mg/kg 灌胃，能对抗蓖麻油或番泻叶引起的小鼠腹泻；30.60mg/kg 灌胃，抑制醋酸引起的小鼠腹腔渗出增加；20.50mg/kg 皮下注射，抑制组胺引起的大鼠皮肤毛细血管通透性增加；4.8mg/kg 皮下注射抑制二甲苯引起的小鼠耳廓肿胀，因此，认为小檗碱的抗腹泻与抗炎作用有关。小檗碱0.06-20mg/kg 灌胃，可推迟、减少、减轻印度牵牛根（Ipomoea turpethμm root）引起的犬腹泻，但对MgSO4 灌胃 引起的大鼠腹泻无效，10mg/kg 灌胃或腹腔注射可降低正常小鼠小肠运动，由于对血清蛋白或鸡蛋清蛋白无沉淀作用，因此其抗腹泻不是由于收敛作用。小檗碱20-30mg 灌胃，对霍乱毒素引起的兔实验性霍乱有抑制作用，可停止腹泻，或延长生命。小檗碱10mg/kg 灌胃，可推迟、减轻、减少霍乱毒素引起的大鼠腹泻，也减少大鼠肠内水分及电介质水平。对霍乱毒素注入小肠的大鼠，小檗碱1mm注入肠内，可促使Na+Cl-吸收。小檗碱5mg注入豚鼠肠内浓度为2.7×10(-3)M，可降低大肠杆菌毒素引起的水和电介质的分泌，其抗分泌作用类似a-受体激动剂、鸦片类及抗组胺药。"}]},{"ID":"20240607114914-joychzj","Type":"NodeParagraph","Properties":{"id":"20240607114914-joychzj","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"6.对心血管作用：小檗碱3-5mg/kg 静脉注射，可使麻醉犬血压下降，如动物预先用麦角毒处理，则小檗碱的降压作用可被翻转。硫酸小檗碱0.1-6.0mg/kg 静脉注射，可使麻醉犬、猫、大鼠血压下降。小檗碱2-10μg/ml可抑制去甲肾上腺素引起的兔肺动脉条收缩。小檗碱0.1%浓度，5ml 静脉注射，能增强乙酰胆碱引起的麻醉犬血压下降，小檗碱2×10(-6)-2×10(-5)可增强乙酰胆碱对蛙腹直肌收缩作用，但10(-4)浓度以上则对抗乙酰胆碱的作用，表面小檗碱能抑制胆碱酯酶，故增强乙酰胆碱作用，而小檗碱本身又有对抗乙酰胆碱作用。小檗碱、黄连碱（Coptisine）体外试验对大鼠脑乙酰胆碱酯酶有抑制作用，其IC50小檗碱为9.8×10(-7)黄连碱为5.8×10(-6)。小檗碱能阻断苯肾上腺素对离体兔主动脉条的收缩作用，其IC50为30μm，而对组胺、5-羟色胺、KCl引起的上动脉条收缩无影响，也不影响血管条的基本张力，说明小檗碱对a-受体有选择性阻断作用。小檗碱0.3，1.3μmol/L，使去氧肾上腺素在大鼠肛尾肌和兔主动脉标本的累积量一效曲线平行右移，不压低最大反应，表明小檗碱对a-受体具竞争性阻断作用。"}]},{"ID":"20240607114914-8m4hjt3","Type":"NodeParagraph","Properties":{"id":"20240607114914-8m4hjt3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱10μmol/L，育享宾 1mol/L 均明显减弱可乐定对电刺激大鼠输精管前列腺端所引起兴奋的抑制作用，使可乐定累积量一效曲线右移，最大反应不变，PA2值分别为5.3和7.8；小檗碱 1μmol/L 及派唑嗪10μmol/l在大鼠肛尾肌标本可使苯肾上腺素量一效曲线平行右移，最大效应不变，PA2值分别为6.4和8.5，说明小檗碱对a1及a2受体均有阻滞作用，阻滞作用的选择比率（a1/a2）为8。小檗碱5.5μmol/L，使乙酰胆碱对大鼠肛尾肌收缩的量效曲线右移，最大反应压低83.5及38.4%，小檗碱 5μmol/L可拮抗5一羟色胺 10μmol/L引起的肛尾肌收缩反应，也拮抗组胺1mmol/L引起的肛尾肌收缩，也抑制异丙肾腺素引起的肛尾肌收缩，说明小檗碱在大鼠肛尾肌对多种受体有阻断作用。"}]},{"ID":"20240607114914-g2koziz","Type":"NodeParagraph","Properties":{"id":"20240607114914-g2koziz","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱腹腔注射 对CHCl3引起的小鼠室颤有保护作用，其半数有效量为14.91±0.0104mg/kg；小檗碱15mg/kg静脉注射，对乌头碱诱发的大鼠室颤也有保护作用，但对哇巴因引起的室性心律失常无效。小檗碱1mg/kg 静脉注射，能引起清醒大鼠血压、左室压及左室舒张期末压的降低，其下降程度为舒张压＞收缩压＞左室压，心率反射性加快，然后缓慢而持久的下降，在后负荷及心率下降的同时，并不伴有左室压力变化最大速率（±dp/dt）max、左室压力上升速度一压力变化比（dp/dt）p-1的降低或左室力速向量环LVP（（dp/dt）P-1及其斜率的缩小，甚至还略有增加，表明小檗碱对心肌的收缩性能的增强作用，因此降压效应主要为降低心率及外周血管阻力所6隆Ｐ￠藜?mg/kg 静脉注射，可提高麻醉猫电致室颤阈值，6-120μmol/L对豚鼠离体心乳头状肌可延长APD、ERP，问时出现正性肌力作用，可能与促Ca2+跨膜内流有关。"}]},{"ID":"20240607114914-w2aag0o","Type":"NodeParagraph","Properties":{"id":"20240607114914-w2aag0o","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱10(-4)mol/L浓度对豚鼠离体左心房，可明显增强其收缩力，延长功能不应期（FRP），降低肾上腺素诱发的自律性阈浓度，对右心房也增强收缩力，减慢自搏频率，拮抗肾上腺素正性频率作用而不影响其正性肌力作用。小檗碱给犬1mg/kg 静脉注射为负荷量，继而以每1分钟0．2mg/kg恒速输入，可延长心室及心房的ERP及FRP，提高电刺激致室颤阈值。小檗碱0.1-30μmol/L浓度，能剂量依赖性地降低兔窦房结、房室结细胞的APA、Vmax、最大除极电位（MDP）及自搏频率，并延长APD50、APD95及ERP，同时抑制窦房结功能，即延长窦性周期及窦房恢复时间及校正窦房恢复时间，小檗碱对窦房结的抑制作用，不被阿托品所拮抗，a2受体拮抗剂BHT一920或a1受体激动剂苯肾上腺素也不能翻转小檗碱的作用；其抑制窦性周期、APA及Vmax的作用，可被去甲肾上腺素所翻转，在无钙液中，小檗碱对窦房结的抑制作用仍然存在，但在心房，除APD50及APD95外，对其他的指标则消失，因此小檗碱可能作用于B受体及Ca2+内流，其抗心律失常作用可能与心肌慢反应细胞有关。"}]},{"ID":"20240607114914-p2occzb","Type":"NodeParagraph","Properties":{"id":"20240607114914-p2occzb","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"小檗碱10μmol/ L可使离体兔心脏S一C（窦房结细胞O相AP到界嵴细胞O相AP）及C一H（界嵴细胞O相AP到希氏束O相AP）间期缩短，膜反应性增强，并依浓度性抑制窦房结及界嵴细胞AP各指标，对前者作用强于后者；在整体试验中，小檗碱10mg/kg 静脉注射可缩短兔心A一H（心房到希氏束传导时间）及H一V（希氏束到心室传导时间）间期，延长心房有效不应期（AERP）及房室结功能性不应期（AVNFRP），表明小檗碱加快房内及室内传导，但15mg/kg 静脉注射时，则出现严重的心脏抑制。小檗碱5-100μmol/L可使离体豚鼠右室乳头状肌动作电位 Vmax降低，APD90延长；4mg/kg 静脉注射，使大鼠血压下降，左室内压变化最大速率（dp/dtmax）、左室内压峰值（LVSP）轻度减少，心室开始收缩到压力上升速率最大值的间隔时间（t-dp/dt-max）和左室舒张末期压（LVEDP）轻度增加，表明左室心肌收缩性能受到抑制，5分钟后，心收缩性能逐渐加强，LVSP、dp/dtmax和-dp/dtmax均增加，左室舒张期压（LVOP）及 LVEDP和t-dp/dtmax减少。小檗碱0.1-300μmol/L，对豚鼠离体右心房肌与乳头状肌呈正性变力作用，还能延长心肌功能不应期（FRP），抑制肾上腺素诱发的异常自律性。小檗碱5mg/kg 静脉注射，可使慢性心肌梗塞犬心电图QTC间期延长，使右室有效不应期（RERP）、左室正常区不应期（NERP）及左室梗塞区不应期（IERP）也延长，缩小IERP的差异和左室有效不应期离散性，抑制程控刺激诱发的室速、室颤。"}]},{"ID":"20240607114914-fnm7sdl","Type":"NodeParagraph","Properties":{"id":"20240607114914-fnm7sdl","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"此外，小檗碱可预防梗塞后由急性心肌缺血所致的自发性室颤，直接证实了小檗碱抗室颤作用。盐酸小檗碱1%浓度，每1小时 10ml/kg恒速给犬静脉输入，开始随体内药量的增加，左室内压峰值（LVSP）增加，左室内压最大变化速率（dp/dtmax）加快，左室开始收缩至出现dp/dtmax的间隔时间（R一dp/dtmax）缩短；继续输药，体内药量继续增加，至输药60分钟时LVSP下降，dp/dtmax减慢，R一dp/dt－ max延长，最后心脏收缩无力，血压下降死亡，表明小檗碱小剂量兴奋心脏，大剂量则呈抑制作用。小檗碱对豚鼠心室乳头状肌慢向离子电流呈先增加后减少的双相作用，小檗碱72，365μmol/L于用药初期明显促进心肌细胞外Ca2+内流，使慢向离子电流幅值增大，随作用时间延长，小檗碱又阻滞钙通道，使Ca2+内流减少，慢向离子电流幅值逐渐减小，甚至消失，心肌收缩力下降，这可能是临床上静滴小檗碱引起患者心肌抑制甚至死亡的原因。"}]},{"ID":"20240607114914-3ags2zn","Type":"NodeParagraph","Properties":{"id":"20240607114914-3ags2zn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"7.解热作用：黄连注射剂0.5mg/kg 静脉注射，对家兔白细胞致热原性发热有解热作用，并使脑脊液中 cAMP含量下降，表明其解热作用与中枢cAMP生成有关。"}]},{"ID":"20240607114914-is2by1r","Type":"NodeParagraph","Properties":{"id":"20240607114914-is2by1r","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"8.降血糖作用：黄连水煎剂1.0-10.0g/kg 灌胃，可降低正常小鼠的血糖水平；小檗碱50mg/kg 灌胃，给药1-7天，可降低正常小鼠、四氧嘧啶糖尿病小鼠及自发性糖尿病小鼠的血糖水平，也对抗腹腔注射 葡萄糖、肾上腺素引起的血糖升高。小檗碱50mg/kg 灌胃，对小鼠不影响胰岛素的分泌，也不影响肝细膜胰岛素受体的数目与亲和力，小檗碱的作用可能力受体后效应，小檗碱可以对抗注射葡萄糖引起的血糖升高，可以抑制以丙氨酸为底物的糖原异生，以及小檗碱的降血糖作用与血乳酸的升高密切相关，因而小檗碱可能通过抑制糖原异生或促进糖酵解而产生降血糖作用的。"}]},{"ID":"20240607114914-6riowqs","Type":"NodeParagraph","Properties":{"id":"20240607114914-6riowqs","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"9.降血脂作用：黄连水浸液2ml，灌胃，连续给药7周,对胆固醇喂饲的家兔，可使血清胆固醇含量降低。小檗碱50mg/kg 灌胃，连续7天，对喂饲高胆固醇乳剂的小鼠，可使血清胆固醇含量降低。"}]},{"ID":"20240607114914-len7ru3","Type":"NodeParagraph","Properties":{"id":"20240607114914-len7ru3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"10.抗氧化作用：5%黄连水煎剂0.5ml与大鼠脑匀浆5%0.6ml混合培养，可使脑匀浆丙二醛（MDA）的生成减少；10%黄连水煎剂4-5ml/只，灌胃，1天2次，可使四氧嘧啶处理大鼠胰、肝中的MDA含量下降。"}]},{"ID":"20240607114914-4d4fswd","Type":"NodeParagraph","Properties":{"id":"20240607114914-4d4fswd","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"11.对血液系统的影响：硫酸小檗碱1-3mg/ml体外试验，可降低肝素（50u/ml）对人及犬血的抗凝血作用，但小檗碱单独使用10mg/ml，本身具抗凝作用。小檗碱40-200μg/ml体外试验，对ADP诱导的兔血小板聚集有抑制作用，IC50为120μg/ml，且呈量效关系。小檗碱有抑制兔血小板的聚集与释放ATP的作用，抑制ADP诱导的血小板聚集及释放的IC50分别为0.19及 0.6mmol/L的抑制胶原诱导的血小板聚集及释放的IC50分别为0．12及0．08mmol/L,抑制花生四烯酸诱导的血小板聚集及释放的IC50分别为0．76及0.43mmol/L，抑制A23187诱导的血小板聚集及释放的IC50分别为2.36及0.85mmol/L，作用机制可能与抑制花生四烯酸代谢和胞内Ca2+升高和/或cAMP升高有关。小檗碱0.5mol/L，明显抑制由胶原、ADP、花生四烯酸诱导的兔血小板血栓素A2（TXA2）的释放，并呈现剂量依赖关系，兔25mg/kg 静脉注射后，60min血浆中前列环素（PGI2）含量下降，实验结果证明小檗碱有抑制花生四烯酸自血小板膜磷脂释放和代谢的作用。"}]},{"ID":"20240607114914-e4ygb7b","Type":"NodeParagraph","Properties":{"id":"20240607114914-e4ygb7b","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"12.其它作用：小檗碱1×10(-4)浓度体外试验对钙离子载体A23187赖激人多形核白细胞产生白三烯 B4有抑制作用。盐酸小檗碱4.40μg/ml体外试验可抑制小鼠肉瘤180（S180细胞DNA、RNA、蛋白质及脂肪的合成，还抑制葡萄糖氧化成CO2，但在体给药，10mg/kg 腹腔注射，对小鼠肿 瘤DNA、蛋白质合成抑制作用很小，2.5-20mg/kg 腹腔注射 对小鼠S180也无抑制作用，存在这种差异，可能是血糖浓度的问题，在肿瘤细胞培养基中加入葡萄糖浓度达0.01-2.68mg/ml，可以阻碍小檗碱对蛋白质合成的抑制作用，表明了葡萄糖与小檗碱在S180细胞摄取上有对抗作用。小檗碱30，60mg/kg 皮下注射可延长常压密闭缺氧小鼠存活时间，并能对抗异丙肾上腺素或酚妥拉明的缩短耐缺氧时间，小檗碱30，60mg/kg 灌胃或4.8mg/kg 皮下注射，均可延长断头小鼠张口动作持续时间，也延长KCN4mg/kg 静脉注射及NaNO2 800mg/kg 腹腔注射 中毒小鼠的存活时间，40，80mg/kg 灌胃 可延长利多卡因150mg/kg 腹腔注射中毒小鼠的存活时间。盐酸小檗碱1.5mg/kg，对犬有利胆作用。还有抗溃疡作用。"}]},{"ID":"20240607114914-c3jqog6","Type":"NodeParagraph","Properties":{"id":"20240607114914-c3jqog6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607114914-ahia1vw","Type":"NodeParagraph","Properties":{"id":"20240607114914-ahia1vw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 黄连：拣去杂质，洗净泥秒，润透，切片，阴干。炒黄连：将黄连片以文火炒至表面呈深黄色为度，取出放凉。姜黄连：用鲜生姜打汁，加适量之开水，均匀地喷入黄连片内，待吸收后，用文火炒至表面深黄色为度，取出放凉。 (每黄连片100斤用生姜12厅8两) 萸黄连：先取吴茱萸加清水适量煎透，去渣，再将黄连片拌入汤内，至汤液吸尽，文火微炒，待略干，取出晾干。(每黄连片100斤用吴茱萸6斤4两) 酒黄连：取黄连片用黄酒拌匀，稍闷，炒至表面深黄色为度，取出放凉。 (每黄连片 100斤用黄酒12斤8两)《雷公炮炙论》：凡使黄连，以布拭上肉毛，然后用浆水浸二伏时，漉出，于柳木火中焙干用。"}]},{"ID":"20240607114914-ikrn797","Type":"NodeParagraph","Properties":{"id":"20240607114914-ikrn797","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607114914-i6sgb4r","Type":"NodeParagraph","Properties":{"id":"20240607114914-i6sgb4r","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.理化鉴别 （1）本品折断面在紫外光灯下显金黄色荧光，木质部尤为显着。"}]},{"ID":"20240607114914-frp9yiq","Type":"NodeParagraph","Properties":{"id":"20240607114914-frp9yiq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末约1g，加乙醇10ml，加热至沸腾，放冷，滤过，取滤液5滴，加稀盐酸1ml与漂白粉少量，即显樱红色；另取滤液5滴，加5％五倍子酸的乙醇溶液2-3滴，蒸干，趁热加硫酸数滴，即显深绿色。（检查小檗碱）（3）取本品粉末或切片，加稀盐酸或30％硝酸1滴，片刻后镜检，可见黄色针状结晶簇，加热结晶显红色并消失。（检查小檗碱）（4）薄层色谱 取本品粉末约1g，加甲醇10ml，加热至沸腾，放冷，过滤，滤液作为样品溶液。另以盐酸小檗碱、盐酸掌叶防己碱、盐酸药根碱及盐酸木兰花碱为对照品，加甲醇制成每1ml各含2mg的混合液作为对照溶液。在硅胶薄层板上点样品溶液1-2μm，对照溶液5μl，以氯仿-甲醇-氨水（15：4：1）展开，取出，晾干。所得色谱图，在自然光下小檗碱及掌叶防已碱显黄色，药根碱在有氨存在时显红棕色，木兰花碱无色。在紫外光（254μm）下小檗碱和掌叶防已减显亮黄绿色，木兰花减显亮蓝紫色，药根碱显暗斑。"}]},{"ID":"20240607114914-u39n75n","Type":"NodeParagraph","Properties":{"id":"20240607114914-u39n75n","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.商品规格 （1）味连 一等：多聚集成簇，分枝肥壮坚实，间有过桥，长不超过2cm。无不到1.5cm的碎节、残茎、焦枯、杂质、霉变。二等：条较一等瘦小，有过桥。间有碎节、碎渣、焦枯。"}]},{"ID":"20240607114914-icpcdas","Type":"NodeParagraph","Properties":{"id":"20240607114914-icpcdas","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"余同一等品。"}]},{"ID":"20240607114914-bezktyj","Type":"NodeParagraph","Properties":{"id":"20240607114914-bezktyj","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（2）雅连 一等：单枝，过桥少，长不超过2.5cm。无碎节、毛须、焦枯、杂质、霉变。二等：条较一等瘦，过桥较多。间有碎节、毛须、焦枯。余同一等品。"}]},{"ID":"20240607114914-8ugxboa","Type":"NodeParagraph","Properties":{"id":"20240607114914-8ugxboa","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"（3）云连 一等：单枝，直径在0.3cm以上。无毛须、过桥、杂质、霉变。二等：条较瘦小，直径在0.3cm以下，间有过桥。"}]},{"ID":"20240607114914-mrhof5d","Type":"NodeParagraph","Properties":{"id":"20240607114914-mrhof5d","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"余同一等品。"}]},{"ID":"20240607114914-tr82hn4","Type":"NodeParagraph","Properties":{"id":"20240607114914-tr82hn4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114914-mo0tr3s","Type":"NodeParagraph","Properties":{"id":"20240607114914-mo0tr3s","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 心；肝；胃；大肠经"}]},{"ID":"20240607114914-abzlkru","Type":"NodeParagraph","Properties":{"id":"20240607114914-abzlkru","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114914-zc74lpr","Type":"NodeParagraph","Properties":{"id":"20240607114914-zc74lpr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 苦；寒"}]},{"ID":"20240607114914-a415wfg","Type":"NodeParagraph","Properties":{"id":"20240607114914-a415wfg","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607114914-jkqyidq","Type":"NodeParagraph","Properties":{"id":"20240607114914-jkqyidq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 胃虚呕恶，脾虚泄泻，五更肾泻，均应慎服。"}]},{"ID":"20240607114914-8ya949f","Type":"NodeParagraph","Properties":{"id":"20240607114914-8ya949f","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114914-t8es3ow","Type":"NodeParagraph","Properties":{"id":"20240607114914-t8es3ow","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 清热泻火；燥湿；解毒。主热病邪入心经之高热；烦躁；谵妄或热盛迫血妄行之吐衄；湿热胸痞；泄泻；痢疾；心火亢盛之心烦失眠；胃热呕吐或消谷善饥；肝火目赤肿痛；以及热毒疮疡；疔毒走黄；牙龈肿痛；口舌生疮；聤耳；阴肿；痔血；湿疹；烫伤。"}]},{"ID":"20240607114914-42ebmcw","Type":"NodeParagraph","Properties":{"id":"20240607114914-42ebmcw","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114914-wgzw7bn","Type":"NodeParagraph","Properties":{"id":"20240607114914-wgzw7bn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5-3g；研末，每次0.3-0.6g；或入丸、散。外用：适量，研末调敷；或煎水洗；或熬膏；或浸汁用。"}]},{"ID":"20240607114914-bwq82zu","Type":"NodeParagraph","Properties":{"id":"20240607114914-bwq82zu","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607114914-ulxa0op","Type":"NodeParagraph","Properties":{"id":"20240607114914-ulxa0op","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" ①治心烦懊憹反复，心乱，怔忡，上热，胸中气乱，心下痞闷，食入反出： 朱砂四钱，黄连五钱，生甘草二钱半。为细末，汤浸蒸饼，丸如黍米大。每服一十丸，食后时时津唾咽下。 (《仁斋直指方》黄连安神丸) ②治少阴病，得之二三日以上，心中烦，不得卧： 黄连四两，黄芩二两， 芍药二两，鸡子黄二枚，阿胶三两(一云三挺)。上五味，以水六升，先煮三物，取二升，去滓，纳胶烊尽，小冷，纳鸡子黄，搅令相得。温服七台，日三服。(《伤寒论》黄连阿胶汤) ③治心肾不交，怔忡无寐： 生川连五钱，肉桂心五分。研细，白蜜丸。空心淡盐汤下。(《四科简效方》交泰丸) ④治心经实热：黄连七钱，水一盏半，煎一盏，食远温服。小儿减之。(《局方》泻心汤) ⑤治心下痞，按之濡，其脉关上浮者： 大黄二两，黄连一两。上二陈，以麻沸汤二升渍之，须臾绞去滓。分温再服。(《伤寒论》大黄黄连泻心汤) ⑥治小结胸病，正在心下，按之则痛，脉浮滑者： 黄连一两，半夏半升(洗)，桥楼实大者一枚。上三味，以水六升，先煮栝楼，取三升，去滓，内诸药，煮取二升，去滓。分温三服。(《伤寒论》小陷胸汤) ⑦治大热盛，烦呕，呻吟，错语，不得卧： 黄连三两，黄芩、黄柏各二两，栀子十四枚(擘)。上四味，切，以水六升，煮取二升，分二服。忌猪肉、冷水。(《外台秘要方》黄连解毒汤) ⑧治伤寒胸中有热，胃中有邪气，腹中痛，欲呕吐者： 黄连三两，甘草三两(炙)，干姜三两，桂枝三两(去皮)，人参二两，半夏半升(洗)，大枣十二枚(擘)。上七味。以水一斗，煮取六升，去滓。温服，昼三夜二。(《伤寒论》黄连汤) ⑨治呕吐酸水，脉弦迟者： 人参、白术、干姜、炙甘草、黄连，水煎服。(《症因脉治》连理汤) ⑩治肝火： 黄连六两，吴茱萸一两或半两。上为末，水丸或蒸饼丸。 白汤下五十丸。(《丹溪心法》左金丸一名回令丸) 11.治诸痢脾泄，脏毒下血： 雅州黄连半斤，去毛，切，装肥猪大肠内，扎定，入砂锅中，以水酒煮烂，取连焙，研末，捣肠和丸梧子大。每服百丸，米汤下。(《仁斋直指方》) 12.治下痢： 宣黄连、青木香，同捣筛，白蜜丸，如梧子。空腹饮下二、三十丸， 日再。其久冷人， 即用煨熟大蒜作丸。婴孺用之亦效。 (《兵部手集方》香连丸) 13.治大冷洞痢肠滑，下赤白如鱼脑，日夜无节度，腹痛不可堪忍者： 黄连六两，干姜二两，当归、阿胶各三两。上四味，末之，以大醋八合烊胶和之，并手丸加大豆许，干之。大人饮服三十丸，小儿百日以还三丸，期年者五丸，余以意加减，日三服。(《千金方》驻车丸)14.治脏毒： 鹰爪黄连末，用独头蒜一颗，煨香烂熟，研和入臼，治丸如梧子大。每服三、四十丸，陈米饮下。(《本事方释义》蒜连丸) 15.治脾受湿气，泄利不止，米谷退化，脐腹刺痛，小儿有疳气下痢，亦能治之： 黄连(去须)、吴茱萸(去梗，炒)、白芍药各五两：上为细末，面糊为丸，如梧桐子大。每服二十丸，浓煎米饮下，空心日三服。(《局方》戊己丸) 16.治心气不足，吐血衄血，亦治霍乱： 大黄二两，黄连、黄芩各一两。上三味，以水三升，煮取一升。顿服之。(《金匮要略》泻心汤) 17.治消渴能饮水，小便甜，有如脂麸片，日夜六、七十起：冬瓜一枚，黄连十两。上截冬瓜头去穰，入黄连末，火中煨之，侯黄连熟，布绞取汁。一服一大盏，日再服，但服两三枚瓜，以差为度。 (《近效方》) 18.治妇人热劳羸瘦： 黄连三两(去须)，人参一两(去芦头)，赤茯苓一两，黄芪一两(锉)，木雷半两，鳖甲一两半(涂醋，炙令黄，去裙谰)，柴胡一两(去苗)，地骨皮半两，桃仁一两半(汤浸去皮、尖、双仁，麸炒微黄)。上药，捣细罗为散，用好嫩猪肚一枚，将前药末安猪肚内，以线子缝合，蒸令烂熟，砂盆内研令如膏，为丸如梧桐子大。食前，以粥饮下三十丸。(《圣惠方》黄连猪肚丸) 19.治小儿胃热吐乳： 黄连二钱，消半夏二钱。共为细末，分100等分，日服三次，每次一分。(辽宁《中草药新医疗法资料选编》) 20、治眼赤痛，除热： 黄连半两，大枣一枚(切)。上二陈，以水五合，煎取一合，去滓，展锦取如麻子注目，日十夜再。(《僧深集方》黄连煎) 21.治痈疽肿毒，已溃未溃皆可用： 黄连、槟榔等分，为末，以鸡子清调搽之。 (《简易方论》) 22.治脓疱疮，急性湿疹： 黄连、松香、海螵蛸各三钱。共研细末，加黄蜡二钱，放入适量熟胡麻油内溶化，调成软膏。涂于患处，每日三次。涂药前用热毛巾湿敷患处，使疮痂脱落。(内蒙古《中草药新医疗法资料选编》) 23.治口舌生疮： 黄连煎酒，时含呷之。 (《肘后方》) 24.治小儿口疳： 黄连、芦荟等分，为末。每蜜汤服五分。定马牙疳， 入蟾灰等分，青黛减半，麝香少许。(《简便单方》) 25.治醇酒厚味，唇齿作痛，或齿龈溃烂，或连头面颈项作痛： 黄连(炒)一钱五分，生地黄、牡丹皮、当归各一钱，升麻二钱。上水煎服，实热便秘加大黄。(《妇人良方》清胃散)26.治妊娠子烦，口干不得卧： 黄连末，每服一钱，粥饮下，或酒蒸黄连丸，亦妙。(《妇人良方》) 27.治火烫伤： 川连研末，调茶油搽之。 〔《中医杂志》(2)：170，1922〕 28.治药中巴豆，下痢不止： 末干姜、黄连，服方寸匕。(《补缺肘后方》)"}]},{"ID":"20240607114914-j0vifc1","Type":"NodeParagraph","Properties":{"id":"20240607114914-j0vifc1","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607114914-ynju11z","Type":"NodeParagraph","Properties":{"id":"20240607114914-ynju11z","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.治疗细菌性痢疾： 黄连治疗菌痢，疗效比较肯定，多在用药5-7天治愈。所用口服剂量，小者每日2-3g，大者8-12g。有人主张每日量以6g为宜，每日3g者效果差。小儿 1岁以内0.2-0．3g，2-4岁0．3-0.6g，4-8岁0．5-1．0g，8岁以上 O．5-1．5g，日服4-6次，首剂加倍。少数顽固病例可另用2-3%黄连溶液行保留灌肠，成人每次100-200ml，每日 1-2次。慢性菌痢肠粘膜有实质性病理改变者，可在乙状结肠镜的帮助下将黄连粉直接喷射于肠壁上，隔日1次，3-5次为一疗程。黄连对菌痢的远期疗效亦称良好，如复发再服仍有效，但对阿米巴痢疾疗效较逊，对小儿中毒型菌痢亦堪应用。急性菌痢的平均退热时间，短者为21小时，长者约为3.2天，腹痛消失时间为1.5-5.9天，大便培养转阴时间为3-5.8天。有人曾将黄连与磺胺药物、链霉素、痢疾噬菌体作疗效对比，发现临床症状改善的速度，黄连组与其他三组相等，而大便培养转阴时间， 以黄连组为快。不少作者认为黄连至少不亚于其他几种治疗痢疾的药物，且不象磺胺类药、氯霉素等易有副作用。此外，黄连中所含的生物碱黄连碱对痢疾杆菌具有良好的抗菌效力，一般用量成人为100-200mg， 日服3-4次，待临床症状消失，大便性状转为正常及培养转阴后改用半量，连续2-3次培养阴性后停药。或用0.1%黄连素液1ml加 1%普鲁卡困液1ml，作穴位注射。选穴：关元，气海，天枢，足三里(双侧交替注射)，每穴0.5ml，每天1次，7天为一疗程。手按为：进针慢，推药慢，出针快。共治疗急慢性菌痢87例，疗效以急性者为好。"}]},{"ID":"20240607114914-m832wi8","Type":"NodeParagraph","Properties":{"id":"20240607114914-m832wi8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.治疗伤寒： 用黄连粉装入胶囊口服，每次2g，每4小时1次，直至体温正常后3-5日为止。治疗15例，临床治愈13例，2例无效；治愈病例完全退热之平均天数为5.6天。2例伤寒复发病人在用各种抗菌素及激素无效后，改用黄连素200mg，日服3次，结果用药后第3日体温即显着下降，第13日完全恢复正常。共服21天并无不良反应。停药2周，大便培养2次阴性。有人报道使用香连丸（黄连、木香）治疗伤寒带菌者137例，绝对疗效在98%以上；但另一报道用香连丸或黄连素治疗伤寒带菌者 11例，经长期观察均无效果。"}]},{"ID":"20240607114914-xjwj7bf","Type":"NodeParagraph","Properties":{"id":"20240607114914-xjwj7bf","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.治疗肺结核： 用黄连素每次300mg，每日3次口服，3个月为一疗程。报道30例肺结核患者的咯血、发热、咳嗽等症状治后全部消失，排菌者的阴转串为83.3%，X线摄片病灶吸收好转。亦有用2%黄连液或0.25%黄连素液作气管滴入治疗结核性空洞，一般以薄壁空洞闭合率为高。曾有以黄连累与异烟肼并用治疗重症肺结核合并糖尿病的患者，用药后糖尿病病情亦呈现好转与稳定。"}]},{"ID":"20240607114914-auy8zr5","Type":"NodeParagraph","Properties":{"id":"20240607114914-auy8zr5","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"4.治疗流行性脑脊髓膜炎： 应用大剂量黄连素治疗40例，治愈24例，平均疗程为7.4天。少数患者脑脊液培养仍有脑膜炎双球菌生长，提示黄连素对抗脑膜炎双球菌的作用是制菌而非杀菌，并推测黄连素是通过脑膜血管到达脑膜从而控制炎症，而不是透过血脑屏障进入脑脊液。故认为黄连素对本病的治疗尚不够理想，不能取代磺胺药。"}]},{"ID":"20240607114914-1x2lt7f","Type":"NodeParagraph","Properties":{"id":"20240607114914-1x2lt7f","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"5.治疗大叶肺炎： 用黄连粉内服，每次2分，每日4-6次。据23例观察，平均退热天数为2.9天。"}]},{"ID":"20240607114914-1o1jrir","Type":"NodeParagraph","Properties":{"id":"20240607114914-1o1jrir","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"6.治疗猩红热： 用10%黄连糖浆内服治疗44例猩红热患者，全部治愈；与青霉素和青霉素加磺胺分组对比的结果，黄连组的疗效并不逊于其他两组。再有内服黄连干浸膏(0.25g约等于原生药 1g)治疗猩红热患者38例，儿童剂量为0.15-0.3g，成人0.45g，每日3-4次，持续用药6.5天，少数病例兼用5绍黄连液滴鼻或喷喉，均获痊愈。"}]},{"ID":"20240607114914-dpvtin4","Type":"NodeParagraph","Properties":{"id":"20240607114914-dpvtin4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"7.治疗白喉： 用黄连粉(每次0.6g，每日4-6次)内服，并配合1%黄连溶液漱口，治疗轻症白喉11例，体温在1-3天内恢复正常，假膜平均在2.6天消退。治疗后咽拭培养平均2.8天转为阴性。用上法治疗溃疡膜性咽炎亦取得良好效果。亦有采用黄连梗(即叶柄)治疗白喉的报道：凡白喉患者，病程未超过24小时，体温在38℃以下，一般状况较佳，局部未形成大块白膜者，用相当于火柴棒长短粗细的黄连梗8根，含置于口内齿颊间，每次 1小时，每日3-4次；体温38℃以上的患者除含用黄连梗外，同时用10形黄连梗浸液(黄连梗10g加水浸泡48小时过滤，煎成100ml，凉透备用)，以喷雾器哦射咽腔，每日3-4次。经用上法治疗50例，全部治愈。"}]},{"ID":"20240607114914-optfjeg","Type":"NodeParagraph","Properties":{"id":"20240607114914-optfjeg","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"8.治疗肺脓肿： 采取气管内滴入与口服合并治疗法。每次滴人黄连素4-6mg，每日1次，同时每日用黄连素1.2-4.8g，分3次服，4周为一疗程，每隔 1周复查血常规、痰常规及胸透1次。病变在1个肺叶以内者28例，痊愈14例，显着进步10例，进步3俐，无效 1例；超过 1个肺叶者4例，显着进步、进步各 l例，无效2例。 X线脑片确诊有空洞者25例，治后闭合者23例，无效2例。"}]},{"ID":"20240607114914-wlkhqz4","Type":"NodeParagraph","Properties":{"id":"20240607114914-wlkhqz4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"9.治疗脓胸： 取川黄连研粉用水浸煎2次，配制成10%的溶液，作游子透入。每日1次，每次20分钟，15-20次为一疗程。如病变顽固者，休息10天后可继续下一疗程。治疗小儿急性脓胸12例，以透入疗法为主，配合抽脓及全身支持疗法等。结果：透入10次以内痊愈(体温降至正常，气喘、呼吸困难消失，胸透积液完全消失)3例，好转(体温明显下降，气喘减轻，呼吸困难消失，脑透仍有少量积液)l例；透入10-23次痊愈者6例。另2例病情严重，控制感染无效，仅作数次透入疗法。"}]},{"ID":"20240607114914-o41yu9c","Type":"NodeParagraph","Properties":{"id":"20240607114914-o41yu9c","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"10.治疗溃疡性结肠炎：共18例，治愈15例。治法： 喷粉法--洗净患者肠内容物，凡使用乙状结肠镜可窥视到的溃疡及其他炎症病变，均可用带有长金属管的喷粉器，将黄连粉直接喷到溃疡或病变部位，每次用药6-8分，隔日1次，9次为一个疗程，以后视病情需要可每隔1周进行第二或第三个疗程。定位灌肠法--病变如系高位，按X线检查测知的病变部位，算好自肛门到病变区的距离插入胶管(使用洗胃管，硬度合适)，待胶管头部抵达目的地，然后将生黄连粉混于150ml温水中灌入。注药后根据病变部位采用左侧、右侧、平卧和臀部高位等体位，同时嘱病人用双手压迫肠段病蛮的两端安静休息，一般 1-2小时后可随意活动。隔日灌1次，9次为一疗程。需要时每隔1周可进行第二、第三疗程。行喷粉法或灌肠法，开始偶有病感，经2-3次后即可消失，并无其他副作用。如添加适量盐酸普鲁卡因粉剂可避免疼痛，亦不影响疗效。在进行上述治疗时，应同时给予一般常规护理及治疗。"}]},{"ID":"20240607114914-f46uzkh","Type":"NodeParagraph","Properties":{"id":"20240607114914-f46uzkh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"11.治疗高血压：用黄连碱每天0.75-4g，分3-4次口服，疗程6-14天。治疗13例，结果有12例于治疗质数天内血压降至正常范围。据介绍，黄连碱能抑制链球菌，并有扩张血管的作用，故认为，黄连碱治疗急性肾炎之高血压，及用于高血压伴有心绞痛和冠状动脉机能不全时，可能收到双重效果。同时由于黄连素既有舒张血管降低血压的作用，故在治疗急性感染性疾患合并有血压降低或休克时，使用大剂量黄连应慎重。"}]},{"ID":"20240607114914-i9avx8t","Type":"NodeParagraph","Properties":{"id":"20240607114914-i9avx8t","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"12.治疗布氏杆菌病：用0.2%注射液(每安瓿2ml，含黄连素4mg)，每日2ml肌肉注射，15天为一疗程，适用于各期布氏杆菌病患者，有一定疗效。或用黄连素5.5g，普鲁卡因2.5g，蒸馏水1000ml，配成无菌溶液，每天穴位注射3ml，8天为一疗程。同时并配合对症治疗。观察31例，均有效。此外，曾有用黄连碱及大剂量黄连为主的煎剂内服进行临床观察，结果疗效都不明显。认为黄连及黄连碱对本病的疗效均甚差，且易于产生杭药性。"}]},{"ID":"20240607114914-5mfqup8","Type":"NodeParagraph","Properties":{"id":"20240607114914-5mfqup8","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"13.治疗肺白色念珠菌病：曾试用黄连2g，6小时服1次，配合维生素、葡萄糖生理盐水对 1例肺白色念珠菌病作实验性治疗。用药2天后，临床症状显着好转，18天后， X线透视炎症消失，空洞不明显，痰细菌培养无致病菌生长。黄连思量共用160g。"}]},{"ID":"20240607114914-qnv6yfs","Type":"NodeParagraph","Properties":{"id":"20240607114914-qnv6yfs","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"14.治疗结肠小袋纤毛虫病： 本病是由于感染结肠小袋纤毛虫所引起的结肠炎，严重者可因衰竭而危及生命。治疗药物虽不下数十种，尚无疗效比较满意的。曾有 1例用黄连粉0.5g，每日口服2次，治疗7天便次减少，腹痛减轻：第9天剂量增至 1g，每日4次，用药4天后大便减为每日2次，腹痛消失；治疗18天大便成形，镜检未发现结肠小袋纤毛虫，临床症状全部消失。随访1月，体力恢复，参加劳动。"}]},{"ID":"20240607114914-3bf56l1","Type":"NodeParagraph","Properties":{"id":"20240607114914-3bf56l1","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"15.防治麻疹：以35%黄连注射液1ml肌注，用于有麻疹接触史而未见症状的儿童。如有咳嗽、目赤、流泪、流涕等症状出现，均1次注射2ml；若出现典型症状，并兼有发热及麻疹粘膜斑者，第1次注射2ml，2天后再注射2ml，经2次注射，症状可基本消退而进入恢复期。曾用上法对57名有接触史之儿童进行预防注射，共观察24天，其中6名出现典型麻疹症状，15名只出现目赤、咳嗽或流泪，其余36名均未发病。"}]},{"ID":"20240607114914-kahgm68","Type":"NodeParagraph","Properties":{"id":"20240607114914-kahgm68","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"16.治疗百日咳：用100%黄连煎剂，疗效显着。与链霉素、氯(合)霉素相比较，疗效并不逊色。用药愈早效果愈好。剂量： 1岁以下每日1.0-1.5ml，1-2岁1.5-2.0ml，2-5岁2.0-2.5ml，5岁以上2.5-3ml。均每日3次分服(每次均混以5-10ml的饱和糖浆)。亦可用20%黄连注射液深部肌肉注射， 1岁以下每次0.5-1.0ml， 1-2岁每次1.5-2.0ml，2-5岁每次2-3ml，5-12岁每次3-5ml。每日或隔日一次，5-7次为-一疗程。"}]},{"ID":"20240607114914-79rhoy1","Type":"NodeParagraph","Properties":{"id":"20240607114914-79rhoy1","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"17.治疗烧伤：采用5-10%黄连油或2%黄连水治疗 Ⅰ、Ⅱ度新鲜烧伤，可使创面迅速干燥，一般在24-48小时，即可结痂，具有明显的控制感染、缩短疗程作用。黄连油可用蓖麻油或麻油作溶剂，并加入普鲁卡因溶液，以减少刺激性。对脓性分泌物较多的创面，用20%黄连水湿敷或喷雾，如能同时用烤灯，保持创面干燥，则疗效更佳。"}]},{"ID":"20240607114914-flo0z6z","Type":"NodeParagraph","Properties":{"id":"20240607114914-flo0z6z","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"18.治疗化脓性感染：一般局限在炎症浸润期者用10%黄连软膏贴敷，溃破或术后创口用2-10%黄连溶液换药；炎症较重者给予黄连粉胶囊 1g，日服4次，可使疼痛减轻，并兼有健胃作用。治疗疖肿、痈、急性乳房脓肿、术后感染、急性淋巴腺炎等共66例，均于2.7-6天炎症消退，脓性分泌物减少，创面干净而愈。应据报道， 1O0例外科急性化脓疮口换药用黄连纱条，与50例应用凡士林纱条进行比较，证实其疗效较凡士林纱条显着优异。另据100例创面脓液培养证明有47%的细菌对黄连有不同程度的敏感，黄连液的最低有效浓度为2-3%。"}]},{"ID":"20240607114914-6fucsto","Type":"NodeParagraph","Properties":{"id":"20240607114914-6fucsto","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"19.治疗肛裂：用10%黄连(或黄柏)煎剂浸泡棉签于肛裂面作雀啄治疗，每次连续使用10余根，手法由轻至重；观察20例，一般只需治疗 1-2次，便血即止，痛痒即瘥，2-5次痊愈。或有用黄连粉 1份，绿豆粉 1份调匀加适量生理盐水成糊状，治疗肛门瘘周围皮肤炎。换药次数随肛瘘换药次数而定。可使皮肤浸润消退，小脓疱及小水泡迅速结痂，应用2-3天后结痂很快脱落，完全恢复正常。"}]},{"ID":"20240607114914-s4q2v10","Type":"NodeParagraph","Properties":{"id":"20240607114914-s4q2v10","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"20.治疗骨关节结核窦道：用5%黄连煎液注入窦道中。如窦道较深，曲折不齐，可用细橡皮导尿管插入窦道处，然后注药，要求药液遍及脓腔，并挤压患部，使药液容易吸收。根据伤口的清洁情况，每日或隔日换药1次，连续1-2月或2月以上，可使窦道愈合。在最初 1-2次注入药液后，患者可有不同程度发热反应，数次以后即不再发生。黄连除对结核杆菌有效外，尚可控制结核窦道的混合感染，并有收敛及制止发酵的作用。此外，对于慢性结核性瘘管，亦可按上法用细软的塑料管吸取 1绍黄连素液5ml插入瘘管腔底部，进行灌注，疗程7-48天。此法有融解瘘管壁、促进新鲜肉芽组织增生的作用。治疗初期分泌物可骤增，坏死及秽暗肉芽组织很快分离液化，出现红润的颗粒性肉芽；随着治疗的继续，分泌物逐渐减少，炎症肿胀现象亦渐消退，治后并无后遗症。用黄连乌梅液浸纱布湿敷患处，每日1次，治疗创口肉芽过剩有一定效果。"}]},{"ID":"20240607114914-eswdsnr","Type":"NodeParagraph","Properties":{"id":"20240607114914-eswdsnr","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"21.治疗妇科疾病：用2O%黄连浸剂浸渍的阴道用棉栓，治疗49例滴虫性阴道炎，治愈率达95%以上。黄连用于治疗子宫颈糜烂和妇科其他炎症亦有一定效果。"}]},{"ID":"20240607114914-crwflbi","Type":"NodeParagraph","Properties":{"id":"20240607114914-crwflbi","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"22.治疗眼科疾病：用5-10%黄连溶液作眼浴或滴眼，可以治疗急性结合膜炎和一般浅层角膜炎。用黄连硼酸溶液(含黄连10%，硼酸3%)滴眼，治疗急性结合膜炎、浅层角膜炎(加用5%黄连膏外涂)、麦粒肿及各种睑缘炎等外眼炎症近200例，均取得良好疗效。采用黄连冰片液(含黄连2O%)治疗急性结合膜炎亦有同样效果。曾用黄连素电游子透入治疗沙眼102例、睑缘炎30例，均有效。再有报道用10%黄连液每日滴眼2次，疗程3周，治疗沙眼110例，有效率86.3%；用10%黄连液浸泡海螵蛸(乌贼骨)棒摩擦沙眼，轻症 1-3次，重症最多10次；通过1835人次临床观察，效果良好，反应均轻微。"}]},{"ID":"20240607114914-2loj3if","Type":"NodeParagraph","Properties":{"id":"20240607114914-2loj3if","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"23.治疗化脓性中耳炎：用黄连10g加入3%硼酸溶液100ml中，浸泡后，蒸沸过滤2次。按常规洗净患耳，每日滴耳3-4次，对急性患者效果明显。亦有用复方黄连滴剂(黄连8钱，硼砂1.5钱，冰片1分，将黄连加水煎成100ml后过滤，加入硼砂和冰片备用)治疗23例久治不愈的慢性化脓性中耳炎，短期内干耳者22例，仅1例复发。也可用0.5%黄连素作电游子透入治疗，据15人17个病耳的观察，其中急性者6个病耳全部治愈，慢性者 11个病耳治愈3个，进步2个。"}]},{"ID":"20240607114914-7jqcoug","Type":"NodeParagraph","Properties":{"id":"20240607114914-7jqcoug","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"24.治疗萎缩性鼻炎：以长约6cm、宽0.5cm之消毒纱条浸于10%黄连液内24小时以上，以之填塞于患侧鼻腔，每日1次，10次为一疗程。共治10例，对轻度或中度萎缩之病变效果良好，遇鼻甲高度萎缩及有大量结痂者疗效不佳。使用本药后对嗅觉恢复、结痂、鼻分泌物减少等方面效果显着。"}]},{"ID":"20240607114914-jptlpsa","Type":"NodeParagraph","Properties":{"id":"20240607114914-jptlpsa","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"25.治疗咽峡炎：黄连粉0.4g(装胶囊，小儿酌减)，日服4次；兼用1%黄连溶液含漱。治疗卡他性咽炎19例，急性咽峡炎33例，溃疡膜性咽炎4例。咽喉部红肿及颌下淋巴结肿大均在服药 1-4日内恢复正常。"}]},{"ID":"20240607114914-ee2683d","Type":"NodeParagraph","Properties":{"id":"20240607114914-ee2683d","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"26.治疗急性扁桃体炎：用10%黄连素注射液肌注，每次4ml，每日2次。治疗8例，用药 1-2天后，体温及白细胞总数均明显下降，最后恢复正常。有少数病例采用黄连素溶液喷雾，效果迅速，4小时辰体温即降至正常，咽痛消失。"}]},{"ID":"20240607114914-ekpwiel","Type":"NodeParagraph","Properties":{"id":"20240607114914-ekpwiel","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"27.治疗上颌窦炎：常规冲洗上颌窦后，每侧灌注30%黄连溶液2ml，灌后头侧向注洗侧15分钟。每周1次，4-7次为一疗程。治疗15例，4例痊愈，8例进步，疗效不明及无效者3例。多数病人灌洗1-2次后即见效。治程中元全身不良反应。亦有用0.2%黄连小檗碱溶液(新鲜配制的无菌溶液)于每次上颌窦冲洗后，灌注2ml，每周1-2次。据89例统计，治愈率为76.4%，有效率为83.2%。而采用青霉素治疗之81例上颌窦炎治愈率为43.2%。"}]},{"ID":"20240607114914-e8nl6ts","Type":"NodeParagraph","Properties":{"id":"20240607114914-e8nl6ts","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"28.治疗根管疾患：用10%黄连浸液(经高压处理)冲洗棍管，治疗24例，最短1次，最多5次，治愈22例。据观察，黄连制剂不仅有较强之灭菌作用，还有收敛作用，能促使瘘管早日封闭愈台；且黄连不具有对牙齿根尖牙周组织之有害刺激作用。"}]},{"ID":"20240607114914-gepuqib","Type":"NodeParagraph","Properties":{"id":"20240607114914-gepuqib","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"29.治疗口腔颌面部炎症：以黄连素(成人600-900mg，日服3次，重症感染600mg，日服4次，并加用注射，儿童酌减。疗程2-8天)用于16例口腔颌面手术后，创口愈合良好，唇裂修补创口呈一期愈合；治疗急性牙周膜炎及急性根尖周炎共66例，45例经用药2-4天后症状消失，9例显着进步，6例无效，6例未再复诊；治疗急性牙周脓肿共21例，12例在用药同时切开引流，均于2日后临床症状消失而愈；治疗急性智齿冠周炎20例，经口服或注射本药后， 11例症状消失而痊愈；治疗急性脓肿9例，经用药5-8天，5例痊愈，2例改善，2例疗效不明显。但使用黄连治疗时不能忽视一般治疗法则，更不能代替外科手术。"}]},{"ID":"20240607114914-n7oqiq6","Type":"NodeParagraph","Properties":{"id":"20240607114914-n7oqiq6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"30.治疗皮肤感染性炎症：采用10%黄连液行游子透入法治疗疖肿、痈等皮肤化脓性感染50例，结果有2/3患者治后当即感到疼痛减轻，早期炎症浸润很快消退，一般治疗1-3次即愈。已化脓者，治后脓疱很快破溃，坏死组织脱落，肉芽上皮迅速生长，创口愈合。平均治愈口数为4.7天，治程中无任何不良反应。"}]},{"ID":"20240607114914-bpyruu6","Type":"NodeParagraph","Properties":{"id":"20240607114914-bpyruu6","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"31.治疗湿疹：用黄连粉 1份加蓖麻油3份调成混悬液，涂患部。共治疗20例，痊愈12例，进步5例，不明显3例。使用中未遇到疖肿等合并症发生。"}]},{"ID":"20240607114914-csft385","Type":"NodeParagraph","Properties":{"id":"20240607114914-csft385","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"32.治疗多型性渗出性红斑： 口腔与唇部用黄连粉和蜂蜜稠成 10%糖浆涂布，躯干、肛门及外朗用10%黄连溶液涂抹(连渣），眼部用澄清之溶液；同时内服黄连粉胶囊 1g，每日3次。共治疗9例，一般在第2天开始症状消退，3-13天痊愈。此病的主要症状发生于口腔，常疱疹溃破糜烂；其他如眼、鼻、尿生殖道、肛门及脐部亦常伴发同样病变；以抗菌素及激素等治疗效果均不明显。此外，临床上有过内服或注射黄连素引起过敏反应的报道，应予重视。又曾对黄连的抗菌力与抗药性进行过实验研究，认为黄连复方的杭菌力远较单味为强，单味黄连的抗药性的形成远远高于复方。"}]},{"ID":"20240607114914-05pvnd9","Type":"NodeParagraph","Properties":{"id":"20240607114914-05pvnd9","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607114914-pms8522","Type":"NodeParagraph","Properties":{"id":"20240607114914-pms8522","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 1.《本草图经》：今医家洗眼汤， 以当归、芍药、黄连等分停纲切，以雪水或甜水煎浓汁，乘热洗，冷即再温洗，甚益眼目，但是风毒赤目花翳等皆可用之。其说云：凡眼目之病，皆以血脉凝滞使然，故以行血药合黄连治之，血得热即行，故乘热洗之，用者无不效。"}]},{"ID":"20240607114914-a91gy3s","Type":"NodeParagraph","Properties":{"id":"20240607114914-a91gy3s","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"2.《本草衍义》：黄连，今人多用治痢，盖执以苦燥之义。亦有但见肠虚渗泄，微似有血，便即用之，更不知止，又不顾寒热多少，但以尽剂为度，由是多致危困。若气实初病热多，血痢，服之便止，仍不必尽剂也。若虚而冷者，则不须服。"}]},{"ID":"20240607114914-xq6s38k","Type":"NodeParagraph","Properties":{"id":"20240607114914-xq6s38k","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"3.《注解伤寒论》：苦人心，寒除热，大黄、黄连之苦，以导泻心下之虚热。上热者泄之以苦，黄连之苦以降阳。蛔得甘则动，得苦则安，黄连、黄柏之苦以安蛔。"}]},{"ID":"20240607114914-ix2ewls","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607114914-ix2ewls","updated":"20240607114914"},"Children":[{"ID":"20240607114914-j14w1z2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240607114914-j14w1z2","updated":"20240607114914"},"Children":[{"ID":"20240607114914-gds7imh","Type":"NodeParagraph","Properties":{"id":"20240607114914-gds7imh","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"刘完素：古方以黄连为治痢之最，盖治痢惟宜辛苦寒药，辛能发散，开通郁结，营能燥湿，寒能胜热，佼气宣平面巳。诸苦寒药多泄，惟黄连、黄柏性冷而燥，能降火去湿，而止泄痢，故治痢以之为君。"}]}]},{"ID":"20240607114914-17a9jgu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20240607114914-17a9jgu","updated":"20240607114914"},"Children":[{"ID":"20240607114914-s8tkqcq","Type":"NodeParagraph","Properties":{"id":"20240607114914-s8tkqcq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"李杲：诸病痒疮疡，皆属心火，凡诸疮宜以黄连、当归为君，甘草、黄芩为佐。"}]}]}]},{"ID":"20240607114914-caxfle7","Type":"NodeParagraph","Properties":{"id":"20240607114914-caxfle7","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"6.《汤液本草》：黄连苦燥，故入心，火就燥也，然泻心，其实泻脾也，为子能令母实，实则泻其子。治血，防风为上使，黄连为中使，地榆为下使。"}]},{"ID":"20240607114914-56y8a6p","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607114914-56y8a6p","updated":"20240607114914"},"Children":[{"ID":"20240607114914-dezxdlu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ny4=","Num":7},"Properties":{"id":"20240607114914-dezxdlu","updated":"20240607114914"},"Children":[{"ID":"20240607114914-3ocp7wc","Type":"NodeParagraph","Properties":{"id":"20240607114914-3ocp7wc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"朱震亨：黄连，击中焦湿热而泻心火，若脾胃气虚，不能转运者，则以茯苓、黄芩代之。 以猪胆汁拌炒，佐以龙胆草，则大泻肝胆之火。下痢胃热噤口者，用黄连、人参煎汤，终日呷之，如吐，再强饮，但得一呷下咽便好。"}]}]}]},{"ID":"20240607114914-gwx9ol2","Type":"NodeParagraph","Properties":{"id":"20240607114914-gwx9ol2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"8.《韩氏医通》：火分之病，黄连为主，五脏皆有火，平则治，病则乱，方书有君火、相火、邪火、龙火之论，其实一气而已。故丹溪云，气有余便是火，分为数类。凡治本病，略炒以从：邪实火，以朴硝汤；假火，酒；虚火，醋；痰火，姜汁；俱浸透炒。气滞火，以茱萸；食积泄，黄土；血尿瘦痛，干漆；俱水拌同炒，去萸、土、漆。下焦伏火，以盐水浸透拌焙；目疾以人乳浸蒸，或点或服。生用为君，佐官桂少许，煎百沸，入蜜空心服之，能使心肾交于顷刻。八五苓滑石，大治梦遗。以上、姜、酒、蜜四者为君，使君子为臣，白芍药酒煮为佐，广木香为使，治小儿五痛。以茱萸炒者，加木香等分，生大黄倍之，水丸，治五痢。以姜汁酒煮者为末，和霞天膏，治癫痫诸风眩晕疮疡，皆效，非彼但云泻心火，而与芩、柏诸苦药例称者比也。"}]},{"ID":"20240607114914-o698vfn","Type":"NodeParagraph","Properties":{"id":"20240607114914-o698vfn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"9.《本草蒙筌》：黄连，久服之，反从火化，愈觉发热，不知有寒。故其功效，惟初病气实热盛者，服之最良，而久病气虚发热，服之又反助其火也。"}]},{"ID":"20240607114914-qgolz6r","Type":"NodeParagraph","Properties":{"id":"20240607114914-qgolz6r","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"10．《医学入门》：黄连，酒浸炒，则上行头目口舌；姜汁炒，辛散冲热有功。一切湿热形瘦气急，一切时行热毒暑毒、诸般恶毒秽毒，诸疮疡毒，俱以姜和其寒，而少变其性。"}]},{"ID":"20240607114914-0y132f3","Type":"NodeParagraph","Properties":{"id":"20240607114914-0y132f3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"11．《纲目》：黄连治目及痢为要药，古方治痢香连丸，用黄连、木香；姜连散，用干姜、黄连；变通丸，用黄连、茱萸；姜黄散，用黄连、生姜；治消渴，用酒蒸黄连；治伏暑，用酒煮黄连；治下血，用黄连、大蒜；治肝火，用黄连、茱萸；治口疮，用黄连、细辛，皆是一冷一热，一阴一阳，寒因热用，热因寒用，主辅相佐，朋阳根济，最得制方之妙，所以有成功而无偏胜之害也。"}]},{"ID":"20240607114914-db9sm17","Type":"NodeParagraph","Properties":{"id":"20240607114914-db9sm17","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"12．《本草经疏》：黄连为病酒之仙药，滞下之伸草，六经所至，各有殊功，其主热气目痛，眦伤泪出，明目、大惊、益胆者，凉心情肝胆也。腹泄腹痛下痢，《别录》主泄泻， 泄者，泻利也，大肠下血也，俗呼为脏毒。除水、利骨、厚肠胃、疗口疮者，涤除肠、胃、脾三家之湿热也。久服令人不忘者，心家无火则清，清则明，故不忘。"}]},{"ID":"20240607114914-7gqmej3","Type":"NodeParagraph","Properties":{"id":"20240607114914-7gqmej3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"13．《本草汇言》：黄连，解伤寒疫热，定阳明、少阴赫曦之传邪，退心脾郁热，怯下痢赤白后重之恶疾。又如惊悸、怔忡、烦乱、恍惚而神志不宁，痛痒、疮疡、癍毒而邪热有余，黄连为必用也，若目痛赤肿，睛散羞明，乃肝之邪热也；呕逆恶心，吞吐酸苦，乃脾之邪热也；胁病弦气，心下痞满，乃肝脾之邪热也；舌烂口臭，唇齿燥裂，乃心脾之邪热也；均属火热内甚，阳盛阴衰之证，非此不治。设或七情之火，聚而不散，六郁之火，结而不舒，用二陈以清之可也，然无黄连之苦寒，则二陈不能独清；吐血衄血，妄奔于上，溲血淋血，妄泄于下，用四生以止之可也，然无黄连之少佐，则四生不能独止。又有肠风下血，用之可以厚肠胃而止血。小便热闭，用之可以清内热而行便。又能退伏热而消蓄暑，其功专于泻火。清湿热而治疳热，其味在于苦寒。若胃虚不足，苦寒有不可投，姜汁制炒可也。阴分之病，苦寒有不能人，醇酒制炒可也。按法乘机而用，药至病自除矣。"}]},{"ID":"20240607114914-p9ya0xt","Type":"NodeParagraph","Properties":{"id":"20240607114914-p9ya0xt","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"14．《本草新编》：黄连，入心与胞络，最泻火，亦能入肝，大约同引经之药，俱能入之，而入心尤专任也。宜少用而不宜多用，可治实热而不可治虚热也。盖虚火宜补，而实火宜泻，以黄连泻火者，正治也，以肉桂治火者，从治也，故黄连、肉桂寒热实相反，似乎不可并用，而实有并用而成功者，盖黄连入心，肉桂入肾也。凡人日夜之间，必心肾两交，而后水火始得既济，水火两分，而心肾不交矣。心不交于肾，则日不能寐，肾不交于心，则夜不能寐矣，黄连与肉桂同用，则心肾交于顷刻，又何梦之不安平。"}]},{"ID":"20240607114914-tuw5yc3","Type":"NodeParagraph","Properties":{"id":"20240607114914-tuw5yc3","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"15．《本草经百种录》：凡药能去湿者必增热，能除热者，必不能去湿，惟黄连能以苦燥湿，以寒除热，一举两得，莫神于此。心属火，寒胜火，则黄连宜为泻心之药，而反能补心何也盖苦为火之正味，乃以味补之也。若心家有邪火，则此亦能泻之，而真火反得宁，是泻之即所以补之也。"}]},{"ID":"20240607114914-ghr0jte","Type":"NodeParagraph","Properties":{"id":"20240607114914-ghr0jte","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"16．《本经疏证》：伤寒胸中有热，胃中有邪气，腹中疼，欲呕吐者，黄连汤主之。少阴病二、三日以上，心中烦、不得卧，黄连阿胶汤主之。二方皆以黄连为君，二证皆发于心，可见黄连为泻心火之剂矣。"}]},{"ID":"20240607114914-uiajtzn","Type":"NodeParagraph","Properties":{"id":"20240607114914-uiajtzn","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"17．《本草思辨录》：黄连之用，见于仲圣方者，黄连阿胶汤，治心也；五泻心汤、黄连汤、干姜黄连黄芩人参汤，治胃也，黄连粉，治脾也；乌梅丸，治肝也；白头翁汤、葛根黄芩黄连汤，治肠也。其制剂之道，或配以大黄、芍药之泄，或配以半夏、栝楼实之宣，或配以干姜、附子之温，或配以阿胶、鸡子黄之濡，或配以人参、甘草之补，因证制宜，所以能收苦燥之益而无苦燥之弊也。"}]},{"ID":"20240607114914-fpicntl","Type":"NodeParagraph","Properties":{"id":"20240607114914-fpicntl","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"18．《本草正义》：黄连大苦大寒，苦燥湿，寒胜热，能泄降一切有余之湿火，而心、脾、肝、肾之热，胆、胃、大小肠之火，无不治之。上以清风火之目病，中以平肝胃之呕吐，下以通腹痛之滞下，皆燥湿清热之效也。又苦先人心，清涤血热，故血家诸病，如吐衄溲血，便血淋浊，痔漏崩带等证，及痈疡斑疹丹毒，并皆仰给于此。但目疾须合泄风行血，滞下须兼行气导浊，呕吐须兼镇坠化痰，方有捷效，仅恃苦寒，亦不能操必胜之券。且连之苦寒，尤以苦胜，故燥湿之功独显，凡诸证之必需于连者，类皆湿热郁蒸，恃以为苦燥泄降之资，不仅以清热见长，凡非舌厚苔黄，腻浊满布者，亦不任此大苦大燥之品。即疮疡一科，世人几视为阳证通用之药，实则惟疗毒一证发于实火，需连最多，余惟湿热交结，亦所值用。此外血热血毒之不挟湿邪者，自有清血解毒之剂，亦非专恃黄连可以通治也。"}]},{"ID":"20240607114914-ezo50sa","Type":"NodeParagraph","Properties":{"id":"20240607114914-ezo50sa","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"19．《本经》：主热气目痛，眦伤泣出， 明目，腹痛下痢，妇人阴中肿痛。"}]},{"ID":"20240607114914-ap65b90","Type":"NodeParagraph","Properties":{"id":"20240607114914-ap65b90","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"20．《本草经集注》：解巴豆毒。"}]},{"ID":"20240607114914-89y7jeu","Type":"NodeParagraph","Properties":{"id":"20240607114914-89y7jeu","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"21．《别录》：主五脏冷热，久下泄脓血，止消渴，大惊，除水利骨，调胃厚肠，益胆，疗口疮。"}]},{"ID":"20240607114914-9or5grc","Type":"NodeParagraph","Properties":{"id":"20240607114914-9or5grc","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"22．《药性论》：杀小儿疳虫，点赤眼昏痛，镇肝去热毒。"}]},{"ID":"20240607114914-ztcv4n4","Type":"NodeParagraph","Properties":{"id":"20240607114914-ztcv4n4","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"23．《本草拾遗》：主羸瘦气急。"}]},{"ID":"20240607114914-enj79qi","Type":"NodeParagraph","Properties":{"id":"20240607114914-enj79qi","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"24．《日华子本草》：治五劳七伤，益气，止心腹痛。惊悸烦躁，润心肺，长肉，止血；并疮疥，盗汗，天热疾；猪肚蒸为丸，治小儿疳气。"}]},{"ID":"20240607114914-6t04pjp","Type":"NodeParagraph","Properties":{"id":"20240607114914-6t04pjp","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"25．《仁斋直指方》：能去心窍恶血。"}]},{"ID":"20240607114914-1mjc3n2","Type":"NodeParagraph","Properties":{"id":"20240607114914-1mjc3n2","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"26．《珍珠囊》：泻心火，心下痞。酒炒、酒浸，上颈已上。"}]},{"ID":"20240607114914-fz6jcdy","Type":"NodeParagraph","Properties":{"id":"20240607114914-fz6jcdy","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"27．王好古：主心病逆而盛，心积伏梁。"}]},{"ID":"20240607114914-ioozrfq","Type":"NodeParagraph","Properties":{"id":"20240607114914-ioozrfq","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"28．《本草衍义补遗》：以姜汁炒，辛散除热有功。"}]},{"ID":"20240607114914-7bbzraj","Type":"NodeParagraph","Properties":{"id":"20240607114914-7bbzraj","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"29．《纲目》：解服药过剂烦闷及轻粉毒。"}]},{"ID":"20240607114914-nvxckj0","Type":"NodeParagraph","Properties":{"id":"20240607114914-nvxckj0","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"30．《本草新编》：止吐利吞酸，解口渴，治火眼，安心，止梦遗，定狂躁，除痞满。"}]},{"ID":"20240607114914-n1wi53c","Type":"NodeParagraph","Properties":{"id":"20240607114914-n1wi53c","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"31．《本草备要》：治痈疽疮疥，酒毒，胎毒。 除疳，杀蛔。"}]},{"ID":"20240607114914-b2k0315","Type":"NodeParagraph","Properties":{"id":"20240607114914-b2k0315","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114914-e164n38","Type":"NodeParagraph","Properties":{"id":"20240607114914-e164n38","updated":"20240607114914"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607114916-6spant8","Type":"NodeThematicBreak","Properties":{"id":"20240607114916-6spant8"}},{"ID":"20240607114917-ckavqq0","Type":"NodeParagraph","Properties":{"id":"20240607114917-ckavqq0"}}]}