en"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 388px;\" parent-style=\"width: 398px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823135140-u4yh4dz","Type":"NodeParagraph","Properties":{"id":"20240823135140-u4yh4dz","updated":"20240823135943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 510px;","style":"width: 500px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"绵马贯众1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/绵马贯众1-20240629153139-yf7df5q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 500px;\" parent-style=\"width: 510px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 338px;","style":"width: 328px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"绵马贯众 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240629153541-q13dtvn.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 328px;\" parent-style=\"width: 338px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 426px;","style":"width: 416px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"绵马贯众 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/绵马贯众 9-20240823135943-gllkqwq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 416px;\" parent-style=\"width: 426px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823135238-qvssube","Type":"NodeParagraph","Properties":{"id":"20240823135238-qvssube","updated":"20240823135955"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 820px;","style":"width: 810px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"绵马贯众4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/绵马贯众4-20240629154634-zo77gdr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 810px;\" parent-style=\"width: 820px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 385px;","style":"width: 375px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"绵马贯众 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/绵马贯众 5-20240823135630-f780gx9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 375px;\" parent-style=\"width: 385px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823134658-ee4utel","Type":"NodeParagraph","Properties":{"id":"20240823134658-ee4utel","updated":"20240823135956"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 363px;","style":"width: 353px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"贯众"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/贯众-20240823134658-jkey8ar.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 353px;\" parent-style=\"width: 363px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 853px;","style":"width: 843px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"绵马贯众 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/绵马贯众 3-20240823135238-z7baky6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 843px;\" parent-style=\"width: 853px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240613100401-yhw00u4","Type":"NodeThematicBreak","Properties":{"id":"20240613100401-yhw00u4"}},{"ID":"20240613100402-91wzw8o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100402-91wzw8o","updated":"20240613100406"},"Children":[{"Type":"NodeText","Data":"贯众《神农本草经》"}]},{"ID":"20240613100402-vp0hh9v","Type":"NodeParagraph","Properties":{"id":"20240613100402-vp0hh9v","updated":"20240613100402"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240613100402-9o3uz4k","Type":"NodeParagraph","Properties":{"id":"20240613100402-9o3uz4k","updated":"20240613100402"},"Children":[{"Type":"NodeText","Data":"主腹中邪，热气，诸毒，杀三虫。一名贯节，一名贯渠，一名百头（《御览》作白），一名虎卷，一名扁符。生山谷。"}]},{"ID":"20240613100402-2brem39","Type":"NodeParagraph","Properties":{"id":"20240613100402-2brem39","updated":"20240613100402"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：贯众一名贯来，一名贯中，一名渠母，一名贯钟，一名伯芹，一名药藻，一名扁符，一名黄钟，神农岐伯苦有毒，桐君扁鹊苦，一经甘有毒，黄帝咸酸，一经苦无毒，叶黄，两两相对，茎，黑毛聚生，冬夏不老，四月花，八月实，黑聚相连，卷旁行生，三月八月采根，五月采药（《御览》）。"}]},{"ID":"20240613100402-pzb7u3a","Type":"NodeParagraph","Properties":{"id":"20240613100402-pzb7u3a","updated":"20240613100402"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名伯萍，一名药藻，此谓草鸱头，生元山及冤句，少室山，二月八月，采根阴干。"}]},{"ID":"20240613100402-dlvb9ao","Type":"NodeParagraph","Properties":{"id":"20240613100402-dlvb9ao","updated":"20240613100402"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上艹下中）草也。《广雅》云：贯节、贯众也。《尔雅》云：泺贯众。郭璞云：叶，圆锐，茎，毛黑，布地，冬夏不死，一名贯渠。又上云：扁符止。郭璞云：未详。据经云：一名篇符，即此也。《尔雅》当云：篇符，止，泺贯众。"}]},{"ID":"20240613100423-v2cpeg8","Type":"NodeThematicBreak","Properties":{"id":"20240613100423-v2cpeg8"}},{"ID":"20240613100425-qtqqqfd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100425-qtqqqfd","updated":"20240613100430"},"Children":[{"Type":"NodeText","Data":"贯众《本草从新》"}]},{"ID":"20240613100425-t5hxppr","Type":"NodeParagraph","Properties":{"id":"20240613100425-t5hxppr","updated":"20240613100425"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻热解毒．"}]},{"ID":"20240613100425-jcbassf","Type":"NodeParagraph","Properties":{"id":"20240613100425-jcbassf","updated":"20240613100425"},"Children":[{"Type":"NodeText","Data":"味苦微寒．能解邪热之毒．治崩淋带下．产后血气胀痛．金疮鼻血．破症瘕．发斑痘．"}]},{"ID":"20240613100425-ldn4ug6","Type":"NodeParagraph","Properties":{"id":"20240613100425-ldn4ug6","updated":"20240613100425"},"Children":[{"Type":"NodeText","Data":"化骨哽．（能软坚．）杀诸虫．有毒而能解毒．去瘀而能生新．别名管仲．岂音相类耶．抑为其有杂霸之气耶．根似狗脊而大．汁能制三黄．化五金．伏钟乳．结砂制汞．解毒软坚．（浸水缸中、日饮其水、能辟时疫．）"}]},{"ID":"20240613100608-11n5oy4","Type":"NodeThematicBreak","Properties":{"id":"20240613100608-11n5oy4"}},{"ID":"20240613100609-qh9f5c3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100609-qh9f5c3","updated":"20240613100614"},"Children":[{"Type":"NodeText","Data":"贯众《得配本草》"}]},{"ID":"20240613100609-rwpevny","Type":"NodeParagraph","Properties":{"id":"20240613100609-rwpevny","updated":"20240613100609"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名黑狗脊"}]},{"ID":"20240613100609-lne13w1","Type":"NodeParagraph","Properties":{"id":"20240613100609-lne13w1","updated":"20240613100609"},"Children":[{"Type":"NodeText","Data":"菌、赤小豆为之使。制三黄、汞。伏石钟乳。化五金。"}]},{"ID":"20240613100609-ahdhpzf","Type":"NodeParagraph","Properties":{"id":"20240613100609-ahdhpzf","updated":"20240613100609"},"Children":[{"Type":"NodeText","Data":"苦、寒、微毒。入足厥阴经。解邪热，止鼻衄，除血淋，驱诸毒，杀三虫，破症瘕，疗金疮。病因内感而发之于外者，多效。配苏木，治咳嗽脓血。配升麻、甘草、赤芍，发痘。配缩砂、甘草，为粗末，绵包少许，含咽汁，治鸡鱼骨哽。 炭，童便、酒下，治乳痈。"}]},{"ID":"20240613100609-2vwnydl","Type":"NodeParagraph","Properties":{"id":"20240613100609-2vwnydl","updated":"20240613100609"},"Children":[{"Type":"NodeText","Data":"置水缸中，用水制饮食，令人疫气不染。"}]},{"ID":"20240613100553-bzs81sy","Type":"NodeThematicBreak","Properties":{"id":"20240613100553-bzs81sy"}},{"ID":"20240613100554-x5b99w5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100554-x5b99w5","updated":"20240613100558"},"Children":[{"Type":"NodeText","Data":"贯众《本经逢原》"}]},{"ID":"20240613100554-ntwpjod","Type":"NodeParagraph","Properties":{"id":"20240613100554-ntwpjod","updated":"20240613100554"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《别录》名草鸱头"}]},{"ID":"20240613100554-xxgh1xw","Type":"NodeParagraph","Properties":{"id":"20240613100554-xxgh1xw","updated":"20240613100554"},"Children":[{"Type":"NodeText","Data":"苦微寒，有毒。"}]},{"ID":"20240613100554-7bp2p32","Type":"NodeParagraph","Properties":{"id":"20240613100554-7bp2p32","updated":"20240613100554"},"Children":[{"Type":"NodeText","Data":"《本经》主腹中邪热气诸毒，杀三虫。"}]},{"ID":"20240613100554-jfuwhwc","Type":"NodeParagraph","Properties":{"id":"20240613100554-jfuwhwc","updated":"20240613100554"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"贯众苦寒而降，辟时行疫疠不正之气。疫发之时，以此药置水，食之则不传染，且能解毒软坚，治妇人血气。《本经》治腹中邪热气诸毒，以其性专散结积诸毒。而虫积皆由湿热所生，苦寒能除湿热，故亦主之。王海藏治夏月痘出不快，快斑散用之。云贯众有毒而能解腹中邪热，杀三虫，病从内发者多效。王 《百一选方》言，食鲤鱼羹为肋骨所鲠，百药不效，或令以贯众煎浓汁连进，一咯而出。可见软坚之功，不但治疮治血而已。病患虚寒无实热者勿服。"}]},{"ID":"20240613100538-ijd3b9c","Type":"NodeThematicBreak","Properties":{"id":"20240613100538-ijd3b9c"}},{"ID":"20240613100539-mpy4bii","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100539-mpy4bii","updated":"20240613100548"},"Children":[{"Type":"NodeText","Data":"贯众《滇南本草》"}]},{"ID":"20240613100539-vp8o8ax","Type":"NodeParagraph","Properties":{"id":"20240613100539-vp8o8ax","updated":"20240613100542"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"贯众"},{"Type":"NodeText","Data":"，即蕨薇菜根。味咸、涩，性寒。祛毒，止血，解水毒。二、三月间，泡水盆中。凡用，去毛，切片于火上，白酒汁醮上焙干。"}]},{"ID":"20240613100539-cx1w03l","Type":"NodeParagraph","Properties":{"id":"20240613100539-cx1w03l","updated":"20240613100539"},"Children":[{"Type":"NodeText","Data":"（附方）治妇人白带。制法如前。研末，开水服。"}]},{"ID":"20240613100539-vn7fvu4","Type":"NodeParagraph","Properties":{"id":"20240613100539-vn7fvu4","updated":"20240613100539"},"Children":[{"Type":"NodeText","Data":"（又方）治刀伤流血不止。"}]},{"ID":"20240613100539-m6nt9oy","Type":"NodeParagraph","Properties":{"id":"20240613100539-m6nt9oy","updated":"20240613100539"},"Children":[{"Type":"NodeText","Data":"贯众（去毛） 发灰（炒为末） 龙骨（为末）各等份，共为细末，搽患处，能止血收口生肌。"}]},{"ID":"20240613100525-pyke91l","Type":"NodeThematicBreak","Properties":{"id":"20240613100525-pyke91l"}},{"ID":"20240613100527-20z14vi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100527-20z14vi","updated":"20240613100531"},"Children":[{"Type":"NodeText","Data":"贯众《千金翼方》"}]},{"ID":"20240613100527-qzzl6c9","Type":"NodeParagraph","Properties":{"id":"20240613100527-qzzl6c9","updated":"20240613100527"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒。主腹中邪热气诸毒，杀三虫，去寸白虫，破症瘕，除头风，止金疮。"}]},{"ID":"20240613100527-32ul3nj","Type":"NodeParagraph","Properties":{"id":"20240613100527-32ul3nj","updated":"20240613100527"},"Children":[{"Type":"NodeText","Data":"花∶疗恶疮，令人泻。一名贯节，一名贯渠，一名百头，一名虎卷，一名扁符，一名伯萍，一名药藻，此谓草鸱头。生玄山山谷及冤句少室山，二月八月采根，阴干。"}]},{"ID":"20240613100514-dr5dzcx","Type":"NodeThematicBreak","Properties":{"id":"20240613100514-dr5dzcx"}},{"ID":"20240613100515-z7j3oz4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100515-z7j3oz4","updated":"20240613100520"},"Children":[{"Type":"NodeText","Data":"贯众《冯氏锦囊秘录》"}]},{"ID":"20240613100515-hhxl62h","Type":"NodeParagraph","Properties":{"id":"20240613100515-hhxl62h","updated":"20240613100515"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有小毒。寒能泄热，苦能杀虫，故治腹中邪热，诸毒诸虫湿热所生之病也。疫气时行，以此置水中，合人饮之，则不传染。"}]},{"ID":"20240613100515-mjbvjjg","Type":"NodeParagraph","Properties":{"id":"20240613100515-mjbvjjg","updated":"20240613100515"},"Children":[{"Type":"NodeText","Data":"贯众，杀三虫，驱诸毒，破 瘕，除邪热，产后崩淋，金疮鼻血。"}]},{"ID":"20240613100502-d5avqgp","Type":"NodeThematicBreak","Properties":{"id":"20240613100502-d5avqgp"}},{"ID":"20240613100503-9g7jm3r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100503-9g7jm3r","updated":"20240613100507"},"Children":[{"Type":"NodeText","Data":"贯众《本草撮要》"}]},{"ID":"20240613100503-o3o8o39","Type":"NodeParagraph","Properties":{"id":"20240613100503-o3o8o39","updated":"20240613100503"},"Children":[{"Type":"NodeText","Data":"味苦微寒有毒．入手太阴足厥阴经．功专解邪热．治崩中带下．产后血气胀痛．破症瘕．发斑痘．化骨鲠．杀三虫．以之浸水中．去垢辟毒．"}]},{"ID":"20240613100451-ic3f7ep","Type":"NodeThematicBreak","Properties":{"id":"20240613100451-ic3f7ep"}},{"ID":"20240613100452-385sp4k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100452-385sp4k","updated":"20240613100456"},"Children":[{"Type":"NodeText","Data":"贯众《本草求真》"}]},{"ID":"20240613100452-s9u4ybf","Type":"NodeParagraph","Properties":{"id":"20240613100452-s9u4ybf","updated":"20240613100452"},"Children":[{"Type":"NodeText","Data":"（山草）杀虫辟时行不正"}]},{"ID":"20240613100452-gdlztv9","Type":"NodeParagraph","Properties":{"id":"20240613100452-gdlztv9","updated":"20240613100452"},"Children":[{"Type":"NodeText","Data":"贯众（专入肝胃）。即俗称为管仲者是也。味苦微寒无毒。世遇天时行不正之气。人多用此置之水缸。使人食之不染。且不独力能解毒。凡遇崩中带下。并症瘕斑痘。虫蛊骨鲠。皆可用之。盖以苦能杀虫。寒能故也。（以诸症皆因热成。）昔王 百一选方。言食鲤鱼羹。为骨所鲠。百药不效。或令以贯众煎浓汁连进。一喀而出。可见软坚之功。其殆若是之神矣！形似狗脊而大。汁能制三黄。化五金。伏钟乳。结沙制汞。解毒软坚。"}]},{"ID":"20240613100440-60fg4ar","Type":"NodeThematicBreak","Properties":{"id":"20240613100440-60fg4ar"}},{"ID":"20240613100442-s5kfce4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100442-s5kfce4","updated":"20240613100446"},"Children":[{"Type":"NodeText","Data":"贯众《增广和剂局方药性总论》"}]},{"ID":"20240613100442-ml50mzv","Type":"NodeParagraph","Properties":{"id":"20240613100442-ml50mzv","updated":"20240613100442"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒。主腹中邪热气，诸毒，杀三虫，去寸白，破症瘕，除头风，止金疮。花∶疗恶疮，令人泄。《药性论》云∶使。主腹热。赤小豆、 菌为之使。杀寸白虫。"}]},{"ID":"20240613100442-kni4ong","Type":"NodeParagraph","Properties":{"id":"20240613100442-kni4ong","updated":"20240613100442"},"Children":[{"Type":"NodeText","Data":"又《图经》云∶苗似狗脊状，如雉尾，根直多枝，皮黑肉赤曲者名草鸱头，疗头风。又∶荆南人取根为末，水调服一钱匕，止鼻血有效。"}]},{"ID":"20240613100412-5zzzkjg","Type":"NodeThematicBreak","Properties":{"id":"20240613100412-5zzzkjg"}},{"ID":"20240613100413-zl4k85o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100413-zl4k85o","updated":"20240613100419"},"Children":[{"Type":"NodeText","Data":"贯众《本草图经》"}]},{"ID":"20240613100413-7vkx8lu","Type":"NodeParagraph","Properties":{"id":"20240613100413-7vkx8lu","updated":"20240613100415"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"贯众"},{"Type":"NodeText","Data":"，生玄山山谷及冤句少室山，今陕西、河东州郡及荆、襄间多有之。而少有花者，春生，苗赤；叶大如蕨，茎秆三棱，叶绿色似小鸡翎，又名凤尾草；根紫黑色，形如大瓜，下有黑须毛，又似老鸱。《尔雅》云∶泺（舒若切），贯众。郭璞注云∶叶圆锐，茎毛黑，布地，冬不死，《广雅》谓之贯节是也。三月采根，晒干。荆南人取根为末，水调服一钱匕，止鼻血有效。"}]},{"ID":"20240613100005-durukgt","Type":"NodeThematicBreak","Properties":{"id":"20240613100005-durukgt"}},{"ID":"20240613100353-rhxayrv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100353-rhxayrv","updated":"20240613100356"},"Children":[{"Type":"NodeText","Data":"贯众《本草纲目》"}]},{"ID":"20240613100353-wniea5j","Type":"NodeParagraph","Properties":{"id":"20240613100353-wniea5j","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"「释名」亦名贯节、贯渠、百头、草头、黑狗脊、凤尾草。"}]},{"ID":"20240613100353-7uhrc3e","Type":"NodeParagraph","Properties":{"id":"20240613100353-7uhrc3e","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、微寒、无毒。"}]},{"ID":"20240613100353-8zbpt8z","Type":"NodeParagraph","Properties":{"id":"20240613100353-8zbpt8z","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613100353-p4g1to1","Type":"NodeParagraph","Properties":{"id":"20240613100353-p4g1to1","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"1、鼻血不止。用贯众根研末，取一钱，水冲服。"}]},{"ID":"20240613100353-88130cd","Type":"NodeParagraph","Properties":{"id":"20240613100353-88130cd","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"2、各种下血（包括痔下血、漏下血以及肠风酒痢等）。用贯众去掉皮毛，焙干，研细。每服二钱，空心服，米汤送下。或加醋、糊和药为丸，如梧子大。每服三、四十丸，米汤送下。或将药烧存性，研细，加麝香少许。每服二钱，米汤送下。"}]},{"ID":"20240613100353-wjslgb3","Type":"NodeParagraph","Properties":{"id":"20240613100353-wjslgb3","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"3、妇女血崩。用贯众半两，煎酒服。"}]},{"ID":"20240613100353-oy0slg3","Type":"NodeParagraph","Properties":{"id":"20240613100353-oy0slg3","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"4、产后流血过多，心腹彻痛。用状如刺猥的大贯众一个，全用不锉，只去毛，以好醋蘸湿，慢火灸令香熟，冷后研细。每服三钱，空心服，米汤送下。此方名“独对汤”。。"}]},{"ID":"20240613100353-embvpbf","Type":"NodeParagraph","Properties":{"id":"20240613100353-embvpbf","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"5、赤白带下。治法同上。对久病者亦有效。"}]},{"ID":"20240613100353-0w1lmei","Type":"NodeParagraph","Properties":{"id":"20240613100353-0w1lmei","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"6、长期咳嗽，痰带脓血。用贯众、苏方木等份。每服三钱，以水一碗，生姜三片，煎服。日服二次。"}]},{"ID":"20240613100353-rlmomfg","Type":"NodeParagraph","Properties":{"id":"20240613100353-rlmomfg","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"7、白秃头疮。用贯众、白芷，共研为末，调油涂搽。"}]},{"ID":"20240613100353-3crtfrl","Type":"NodeParagraph","Properties":{"id":"20240613100353-3crtfrl","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"8、漆疮作痒。用贯众研末，调油涂搽。"}]},{"ID":"20240613100353-0fetjyf","Type":"NodeParagraph","Properties":{"id":"20240613100353-0fetjyf","updated":"20240613100353"},"Children":[{"Type":"NodeText","Data":"9、鸡鱼骨鲠。用贯众、缩砂、甘草等分，研为精末。棉包少许含口中，嚼汁呖下。久则骨刺随痰吐出。"}]},{"ID":"20240613100005-sdq2ob7","Type":"NodeThematicBreak","Properties":{"id":"20240613100005-sdq2ob7"}},{"ID":"20240613100340-j5uygv4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100340-j5uygv4","updated":"20240613100347"},"Children":[{"Type":"NodeText","Data":"贯众《证类本草》"}]},{"ID":"20240613100340-nvl9pm6","Type":"NodeParagraph","Properties":{"id":"20240613100340-nvl9pm6","updated":"20240613100340"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒。主腹中邪热气，诸毒，杀三虫，去寸白，破症瘕，除头风，止金疮。"}]},{"ID":"20240613100340-pedxe1q","Type":"NodeParagraph","Properties":{"id":"20240613100340-pedxe1q","updated":"20240613100340"},"Children":[{"Type":"NodeText","Data":"花疗恶疮，令人泄。一名贯节，一名贯渠，一名百头，一名虎卷，一名扁苻，一名伯萍，一名乐藻。此谓草鸱头。生玄山山谷及冤句少室山。二月、八月采根，阴干。（ 菌为之使。）"}]},{"ID":"20240613100340-5tbzq12","Type":"NodeParagraph","Properties":{"id":"20240613100340-5tbzq12","updated":"20240613100340"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道亦有。叶如大蕨，其根形色毛芒，全似老鸱头。故呼为草鸱头。臣禹锡等谨按尔雅云∶泺，贯众。注∶叶圆锐，茎毛黑，布地，冬不死，一名贯渠，《广雅》云贯节。"}]},{"ID":"20240613100340-kjsi4kx","Type":"NodeParagraph","Properties":{"id":"20240613100340-kjsi4kx","updated":"20240613100340"},"Children":[{"Type":"NodeText","Data":"赤，曲者名草鸱头，疗头风用之。今所在山谷阴处有之。药性论云∶贯众，使。主腹热，赤小豆为使。杀寸白虫。"}]},{"ID":"20240613100340-mxs3052","Type":"NodeParagraph","Properties":{"id":"20240613100340-mxs3052","updated":"20240613100340"},"Children":[{"Type":"NodeText","Data":"图经曰∶贯众，生玄山山谷及冤句少室山，今陕西、河东州郡及荆、襄间多有之，而少有花者。春生苗，赤。叶大如蕨。茎秆三棱。叶绿色似小鸡瓴，又名凤尾草。根紫黑色，形如大瓜，下有黑须毛，又似老鸱。《尔雅》云∶泺（舒若切），贯众。郭璞注云∶叶圆锐，茎毛黑，布地，冬不死。《广雅》谓之贯节是也。三月采根，晒干。荆南人取根为末，水调服一钱匕，止鼻血有效。"}]},{"ID":"20240613100253-26qv0eb","Type":"NodeThematicBreak","Properties":{"id":"20240613100253-26qv0eb"}},{"ID":"20240613100330-mb4g5pv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100330-mb4g5pv","updated":"20240613100334"},"Children":[{"Type":"NodeText","Data":"贯众《新修本草》"}]},{"ID":"20240613100330-48wi9jl","Type":"NodeParagraph","Properties":{"id":"20240613100330-48wi9jl","updated":"20240613100330"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒。主腹中邪热气，诸毒，杀三虫。去寸白，破症瘕，除头风，止金创。"}]},{"ID":"20240613100330-xp9adfq","Type":"NodeParagraph","Properties":{"id":"20240613100330-xp9adfq","updated":"20240613100330"},"Children":[{"Type":"NodeText","Data":"花疗恶疮，令人泄。一名贯节，一名贯渠，一名百头，一名虎卷，一名扁苻，一名伯萍，一名乐藻，此谓草鸱头。生玄山山谷及宛朐又少室。二月、八月采根，阴干。"}]},{"ID":"20240613100330-z8bjwet","Type":"NodeParagraph","Properties":{"id":"20240613100330-z8bjwet","updated":"20240613100330"},"Children":[{"Type":"NodeText","Data":"菌为之使。近道亦有，叶如大蕨，其根形色毛芒全似老鸱头，故呼为草鸱头也。"}]},{"ID":"20240613100253-my64sph","Type":"NodeThematicBreak","Properties":{"id":"20240613100253-my64sph"}},{"ID":"20240613100318-iw8eq4p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100318-iw8eq4p","updated":"20240613100325"},"Children":[{"Type":"NodeText","Data":"贯众《本草述钩元》"}]},{"ID":"20240613100318-mhbjbm8","Type":"NodeParagraph","Properties":{"id":"20240613100318-mhbjbm8","updated":"20240613100318"},"Children":[{"Type":"NodeText","Data":"一本而众枝贯之。茎叶如凤尾。故草名凤尾。根名贯众。贯节贯渠。渠者魁也。根直多枝。皮黑肉赤。三八月采之。曲者名草鸱头。其根曲而有尖嘴。黑须丛簇似狗脊而大。状如伏鸱。"}]},{"ID":"20240613100318-subqaa0","Type":"NodeParagraph","Properties":{"id":"20240613100318-subqaa0","updated":"20240613100318"},"Children":[{"Type":"NodeText","Data":"气叶苦。微寒。有毒。主治腹中邪热气。诸毒。解斑疹毒。杀三虫。治衄血下血。崩中带下。产后血气胀痛。（皆泄热散结之功）根汁解毒软坚。能制三黄。化五金。伏钟乳结砂。"}]},{"ID":"20240613100318-uvur4sd","Type":"NodeParagraph","Properties":{"id":"20240613100318-uvur4sd","updated":"20240613100318"},"Children":[{"Type":"NodeText","Data":"制汞。海藏治夏月痘出不快。（怏斑散中用之）云贯众有毒。而能解腹中邪热之毒。病因内感而发之于外者多效。非古法之分经也。为末。水服一钱。或煎浓汁连服。治鱼肋骨鲠。为细末。水调一钱匙。治鼻衄。疫气发时。以此药置水中。令人饮此水。则不传染。荒年以煮黑豆。服豆便可食百草木枝叶。诸般下血。肠风酒痢。血痔鼠痔下血。黑狗脊（须内肉赤色者即贯众也）去皮毛。锉焙为末。每服二钱。空心米饮下。或醋糊丸梧子大。每米饮下三四十丸。女子血崩。贯众半两。煎酒饮之。立止。赤白带下。年深诸药不效者。贯众一个全用。"}]},{"ID":"20240613100318-tgxv2jc","Type":"NodeParagraph","Properties":{"id":"20240613100318-tgxv2jc","updated":"20240613100318"},"Children":[{"Type":"NodeText","Data":"不锉。只揉去毛及花萼。以好醋蘸湿。慢火炙令香熟。候冷为末。空心米饮。每服二钱。甚效。"}]},{"ID":"20240613100318-w9zi922","Type":"NodeParagraph","Properties":{"id":"20240613100318-w9zi922","updated":"20240613100318"},"Children":[{"Type":"NodeText","Data":"〔论〕贯众多生山阴近水处。冬夏不死。且百叶俱贯于一根。禀阴之浓而能撤诸阳之毒以出于外。故遇毒热则无不解。而多治血病也。绎海藏所云。非古分经之法。可以知其功之所及。并其所不及。盖分经乃人物阴阳相为对待而酌治之理。兹味但解邪热之毒。为其性之所独禀而已。"}]},{"ID":"20240613100254-zjmmp41","Type":"NodeThematicBreak","Properties":{"id":"20240613100254-zjmmp41"}},{"ID":"20240613100307-tywc4rf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100307-tywc4rf","updated":"20240613100311"},"Children":[{"Type":"NodeText","Data":"贯众《神农本草经百种录》"}]},{"ID":"20240613100307-ykeemy5","Type":"NodeParagraph","Properties":{"id":"20240613100307-ykeemy5","updated":"20240613100307"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主腹中邪热气，寒能除热。诸毒，邪热之毒。杀三虫。湿热所生之虫。"}]},{"ID":"20240613100307-0gie0tm","Type":"NodeParagraph","Properties":{"id":"20240613100307-0gie0tm","updated":"20240613100307"},"Children":[{"Type":"NodeText","Data":"贯众生于山涧之中，得天地清阴之气，故能除蕴热湿秽之疾。其体中虚而清芳，故能解中焦之毒。人身之虫，皆湿热所生。湿热除，则诸虫自消也。"}]},{"ID":"20240613100254-pmc32wj","Type":"NodeThematicBreak","Properties":{"id":"20240613100254-pmc32wj"}},{"ID":"20240613100255-lcnk75t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100255-lcnk75t","updated":"20240613100301"},"Children":[{"Type":"NodeText","Data":"贯众《本草便读》"}]},{"ID":"20240613100255-xetiigz","Type":"NodeParagraph","Properties":{"id":"20240613100255-xetiigz","updated":"20240613100255"},"Children":[{"Type":"NodeText","Data":"辟时行之疫疠．入血除邪．化痘毒与 疹．散瘀解热．杀虫化哽方多效．入胃行肝苦且寒．（贯众多生山阴近水处．味苦性寒．有小毒．故本经主治腹中邪热诸毒．杀三虫等语．皆取寒能胜热．以毒攻毒之意．其所以治诸血病者．亦血因热结．用此寒散之力也．察其形性肝胃血分之药．一根能贯众枝．故名．皮黑肉赤．血分药也．其根丛生．虽苦寒而能解散．有小毒而能解毒．凡遇时疫盛行．痘疹窃发．皆以此浸水缸中辟之．）"}]},{"ID":"20240613100005-8bug3f5","Type":"NodeThematicBreak","Properties":{"id":"20240613100005-8bug3f5"}},{"ID":"20240613100238-jt6i51d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100238-jt6i51d","updated":"20240613100244"},"Children":[{"Type":"NodeText","Data":"贯众《本草乘雅半偈》"}]},{"ID":"20240613100238-4nz1g21","Type":"NodeParagraph","Properties":{"id":"20240613100238-4nz1g21","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613100238-us78rd6","Type":"NodeParagraph","Properties":{"id":"20240613100238-us78rd6","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"【气味】苦，微寒，有毒。"}]},{"ID":"20240613100238-jvwrcc6","Type":"NodeParagraph","Properties":{"id":"20240613100238-jvwrcc6","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"【主治】主腹中邪热气，诸毒，杀三虫。"}]},{"ID":"20240613100238-2xu65uw","Type":"NodeParagraph","Properties":{"id":"20240613100238-2xu65uw","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出玄山山谷，及冤句少室山，今陕西、河东州郡，及荆、襄间多有之。生山阴近水处。冬夏不死，数根丛生，每根必有多茎贯之，茎作三棱如蕨状，有黑色汁，颇涎滑也。其叶两两对生，如鸡翎，及凤尾，又似狗脊叶而无锯齿，色青黄，面深背淡。四月花白，七月实黑，相聚连卷，而 生其根，曲而有尖嘴，黑须丛族，亦似狗脊根状，及伏鸱，皮黑肉赤，直而多枝，若百头也。 菌、赤小豆为之使，伏石钟乳。"}]},{"ID":"20240613100238-k9dk0sp","Type":"NodeParagraph","Properties":{"id":"20240613100238-k9dk0sp","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"先人云∶百头而以一贯，故名贯众。连卷有夏脉如钩之象，是心物无疑矣。腹中邪热，是夏气在脏之病，从血脉流入心腹之部者，当须此品。"}]},{"ID":"20240613100238-8kpk8hq","Type":"NodeParagraph","Properties":{"id":"20240613100238-8kpk8hq","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"【 】曰∶根具百头，独茎叶两两相对，若偶贯群阴也，因名贯众。多生山阴近水处，故禀苦寒气味，对待阳不贯阴而成邪热，理不贯经而成诸毒。生阳不贯四大而成三虫，亦地以阳杀阴藏之象欤。"}]},{"ID":"20240613100238-e8zqtxu","Type":"NodeParagraph","Properties":{"id":"20240613100238-e8zqtxu","updated":"20240613100238"},"Children":[{"Type":"NodeText","Data":"（既连卷有夏脉如钩之象，则百头一贯，有心主百脉宗主之象矣。假以治百合病者颇象形百合病者，百脉一宗悉致其病故也。）"}]},{"ID":"20240613100155-xithj4h","Type":"NodeThematicBreak","Properties":{"id":"20240613100155-xithj4h"}},{"ID":"20240613100228-b3yyhbh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100228-b3yyhbh","updated":"20240613100232"},"Children":[{"Type":"NodeText","Data":"贯众《医学入门》"}]},{"ID":"20240613100228-y4hk31p","Type":"NodeParagraph","Properties":{"id":"20240613100228-y4hk31p","updated":"20240613100228"},"Children":[{"Type":"NodeText","Data":"生山谷阴处，苗赤叶绿，如叶茎干三棱，似雉尾，根大如瓜，紫黑色，有毛，凌冬不死，又谓之贯节。味苦，微寒。有毒。主腹中邪热气诸毒，除头风，破 瘕，止鼻血金疮，杀三虫，去寸白。二八月采根阴干，去毛皮。赤小豆使。"}]},{"ID":"20240613100155-j4jgbx4","Type":"NodeThematicBreak","Properties":{"id":"20240613100155-j4jgbx4"}},{"ID":"20240613100218-oow1688","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100218-oow1688","updated":"20240613100223"},"Children":[{"Type":"NodeText","Data":"贯众《神农本草经赞》"}]},{"ID":"20240613100218-q68zbz9","Type":"NodeParagraph","Properties":{"id":"20240613100218-q68zbz9","updated":"20240613100218"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主腹中邪热气诸毒。杀三虫。一名贯节。一名贯渠。一名百头。一名虎卷。一名扁符。生山谷。"}]},{"ID":"20240613100218-50s5ehr","Type":"NodeParagraph","Properties":{"id":"20240613100218-50s5ehr","updated":"20240613100218"},"Children":[{"Type":"NodeText","Data":"水曲山阴。暑寒独适。中贯连卷。旁生滋益。翘尾摩翎。攒头伏脊。煮豆疗饥。羹通嗌。"}]},{"ID":"20240613100218-8p9ygyq","Type":"NodeParagraph","Properties":{"id":"20240613100218-8p9ygyq","updated":"20240613100218"},"Children":[{"Type":"NodeText","Data":"李时珍曰。多生山阴近水处。其根一本而众枝贯之。吴普曰。贯中冬夏不凋。黑聚相连卷。"}]},{"ID":"20240613100218-b428486","Type":"NodeParagraph","Properties":{"id":"20240613100218-b428486","updated":"20240613100218"},"Children":[{"Type":"NodeText","Data":"旁行生。苏颂曰。叶绿色。似鸡翎。又名凤尾草。陶弘景曰。毛芒金似老鸱头。韩保升曰。"}]},{"ID":"20240613100218-khqtwbd","Type":"NodeParagraph","Properties":{"id":"20240613100218-khqtwbd","updated":"20240613100218"},"Children":[{"Type":"NodeText","Data":"苗似狗脊。郭璞赞。翘尾翻飞。王履诗。金仙已跨摩云翎。元好问诗。攒头争似与春争。乔宇记。俯首伏脊。黄庭坚书。荒年以贯众煮黑豆。日啖五七粒。能食百草木枝叶。有味可饱。礼。毋羹。王曰。有食鱼羹。为骨所鲠。饮贯众浓汁而消。"}]},{"ID":"20240613100155-b5334y6","Type":"NodeThematicBreak","Properties":{"id":"20240613100155-b5334y6"}},{"ID":"20240613100208-r72xu3e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100208-r72xu3e","updated":"20240613100212"},"Children":[{"Type":"NodeText","Data":"贯众《本草新编》"}]},{"ID":"20240613100208-8pjylad","Type":"NodeParagraph","Properties":{"id":"20240613100208-8pjylad","updated":"20240613100208"},"Children":[{"Type":"NodeText","Data":"贯众，味苦，气微寒。有小毒。入阳明胃经，亦入心、入肺。祛诸毒，理金疮恶毒，杀三虫，去寸白虫，仍除头风，更破症瘕，尤祛时气，亦止心疼。此物有毒而能去毒，所谓以毒攻毒也。人家小缸内置贯众一枝，永无疫 之侵，然须三月一易为妙，否则，味散无益耳。"}]},{"ID":"20240613100208-04hf3qr","Type":"NodeParagraph","Properties":{"id":"20240613100208-04hf3qr","updated":"20240613100208"},"Children":[{"Type":"NodeText","Data":"或曰解毒用贯众，不可用贯众以祛毒，以贯众能消毒于毒之未至，不能逐散于毒之已成也。"}]},{"ID":"20240613100208-j435uyh","Type":"NodeParagraph","Properties":{"id":"20240613100208-j435uyh","updated":"20240613100208"},"Children":[{"Type":"NodeText","Data":"是未知贯众矣。贯众实化毒之仙丹，毒未至，可以预防；已至，可以善解；毒已成，可以速祛，正不可以前后而异视之。惟毒来之重，单用贯众，则力薄势绝，必须佐之以攻毒之药，始易奏功耳。"}]},{"ID":"20240613100155-iar6b7x","Type":"NodeThematicBreak","Properties":{"id":"20240613100155-iar6b7x"}},{"ID":"20240613100157-2knq09m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100157-2knq09m","updated":"20240613100201"},"Children":[{"Type":"NodeText","Data":"贯众《本草备要》"}]},{"ID":"20240613100157-wvf8iof","Type":"NodeParagraph","Properties":{"id":"20240613100157-wvf8iof","updated":"20240613100157"},"Children":[{"Type":"NodeText","Data":"泻热，解毒"}]},{"ID":"20240613100157-y7dqgjt","Type":"NodeParagraph","Properties":{"id":"20240613100157-y7dqgjt","updated":"20240613100157"},"Children":[{"Type":"NodeText","Data":"味苦微寒，有毒，而能解邪热之毒。"}]},{"ID":"20240613100157-8xz05ei","Type":"NodeParagraph","Properties":{"id":"20240613100157-8xz05ei","updated":"20240613100157"},"Children":[{"Type":"NodeText","Data":"治崩中带下，产后血气胀痛，破症瘕，发斑痘（王海藏快斑散用之），化骨哽（能软坚），杀三虫。"}]},{"ID":"20240613100157-cn90t30","Type":"NodeParagraph","Properties":{"id":"20240613100157-cn90t30","updated":"20240613100157"},"Children":[{"Type":"NodeText","Data":"根似狗脊而大。汁能制三黄，化五金，伏钟乳、结砂、制汞，解毒软坚（以此浸水缸中，日饮其水，能辟时疾）。"}]},{"ID":"20240613100005-zay2y66","Type":"NodeThematicBreak","Properties":{"id":"20240613100005-zay2y66"}},{"ID":"20240613100032-2lkwzn1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100032-2lkwzn1","updated":"20240613100044"},"Children":[{"Type":"NodeText","Data":"贯众《中药学》"}]},{"ID":"20240613100032-5vgopzy","Type":"NodeParagraph","Properties":{"id":"20240613100032-5vgopzy","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【药用】本品为叉蕨科植物贯众的根茎及叶柄残基。"}]},{"ID":"20240613100032-8bahcqu","Type":"NodeParagraph","Properties":{"id":"20240613100032-8bahcqu","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，微寒。有小毒。入肝、脾经。"}]},{"ID":"20240613100032-yee1qcs","Type":"NodeParagraph","Properties":{"id":"20240613100032-yee1qcs","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【功效】杀虫，清热解毒，止血。"}]},{"ID":"20240613100032-4oqehy3","Type":"NodeParagraph","Properties":{"id":"20240613100032-4oqehy3","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于虫积腹痛等症。"}]},{"ID":"20240613100032-xcfgt0i","Type":"NodeParagraph","Properties":{"id":"20240613100032-xcfgt0i","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"本品功能驱虫，治虫积腹痛，常用于蛲虫、绦虫等病，但颇少单用，临床尚可与芜荑、鹤虱、使君子、雷丸、槟榔等配伍应用。近年临床上又用于治疗钩虫病。"}]},{"ID":"20240613100032-9nudk30","Type":"NodeParagraph","Properties":{"id":"20240613100032-9nudk30","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"2.用于热毒疮疡，痄腮肿痛等症。"}]},{"ID":"20240613100032-ilpmhn3","Type":"NodeParagraph","Properties":{"id":"20240613100032-ilpmhn3","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"本品功能清热解毒，对热毒引起的疮疡肿毒、痄腮等症，常与金银花、蒲公英等配合应用。"}]},{"ID":"20240613100032-9ew60g6","Type":"NodeParagraph","Properties":{"id":"20240613100032-9ew60g6","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"3.用于崩漏出血等症。"}]},{"ID":"20240613100032-nlg99oq","Type":"NodeParagraph","Properties":{"id":"20240613100032-nlg99oq","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"本品性寒，功能凉血止血，故可用于子宫出血属热症者，常与侧柏叶、仙鹤草、墨旱莲、陈棕炭等同用。"}]},{"ID":"20240613100032-ks4t0q3","Type":"NodeParagraph","Properties":{"id":"20240613100032-ks4t0q3","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"此外，本品还可用于预防感冒、麻疹等。"}]},{"ID":"20240613100032-otvkhgk","Type":"NodeParagraph","Properties":{"id":"20240613100032-otvkhgk","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【处方用名】贯众、贯仲（生用，用于杀虫与清热解毒）、贯众炭、贯仲炭（炒焦黑用，用于止血）"}]},{"ID":"20240613100032-4bsvg6l","Type":"NodeParagraph","Properties":{"id":"20240613100032-4bsvg6l","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240613100032-ma5pekh","Type":"NodeParagraph","Properties":{"id":"20240613100032-ma5pekh","updated":"20240613100032"},"Children":[{"Type":"NodeText","Data":"【方剂举例】下虫丸《证治准绳》：苦楝根皮、槟榔、鹤虱、贯众、使君子、干虾蟆、芜荑、木香、桃仁、轻粉。治虫积腹痛。"}]},{"ID":"20240613100005-r69nro6","Type":"NodeThematicBreak","Properties":{"id":"20240613100005-r69nro6"}},{"ID":"20240613100014-8sa3jej","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100014-8sa3jej","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：贯众"}]},{"ID":"20240613100014-q89ht74","Type":"NodeParagraph","Properties":{"id":"20240613100014-q89ht74","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613100014-yvqwtcb","Type":"NodeParagraph","Properties":{"id":"20240613100014-yvqwtcb","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" Guàn Zhònɡ"}]},{"ID":"20240613100014-jp7h8wq","Type":"NodeParagraph","Properties":{"id":"20240613100014-jp7h8wq","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613100014-bvhawc5","Type":"NodeParagraph","Properties":{"id":"20240613100014-bvhawc5","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 萹苻、泺（《尔雅》），贯节、贯渠、百头、虎卷、扁符（《本经》），贯中、贯钟、贯来、渠母、伯芹、药渠、黄钟（《吴普本草》），伯萍、乐藻（《别录》），草鸱头（陶弘景），伯药、药藻（《经典释文》），凤尾草（《本草图经》），蕨薇菜根（《滇南本草》），黑狗脊、贯仲、管仲（《纲目》）。"}]},{"ID":"20240613100014-xhziuj9","Type":"NodeParagraph","Properties":{"id":"20240613100014-xhziuj9","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613100014-lh8vss1","Type":"NodeParagraph","Properties":{"id":"20240613100014-lh8vss1","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613100014-8gx40d0","Type":"NodeParagraph","Properties":{"id":"20240613100014-8gx40d0","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613100014-ntehvhp","Type":"NodeParagraph","Properties":{"id":"20240613100014-ntehvhp","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 主要为鳞毛蕨科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粗茎鳞毛蕨"},{"Type":"NodeText","Data":"，蹄盖蕨科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛾眉蕨"},{"Type":"NodeText","Data":"，球子蕨科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荚果蕨"},{"Type":"NodeText","Data":"，紫萁科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫萁"},{"Type":"NodeText","Data":"，乌毛蕨科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌毛蕨"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苏铁蕨"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"狗脊蕨"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋采挖，削去叶柄、须根，除净泥土，晒干。"}]},{"ID":"20240613100014-4iz0ih0","Type":"NodeParagraph","Properties":{"id":"20240613100014-4iz0ih0","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613100014-nm2heea","Type":"NodeParagraph","Properties":{"id":"20240613100014-nm2heea","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" ①粗茎鳞毛蕨，又名:绵马鳞毛蕨、鸡膀鳞毛蕨，野鸡膀子、绵马羊齿、东绵马、日本绵马、牛毛黄。"}]},{"ID":"20240613100014-kysgibb","Type":"NodeParagraph","Properties":{"id":"20240613100014-kysgibb","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"多年生草本，高50～100厘米。地下根茎斜生，粗大块状，坚硬，有许多叶柄残基及须根，并密生锈色或深褐色的大形鳞片，鳞片长披针形至线形，长1～2.5厘米。叶簇生于根茎顶端；叶柄长10～25厘米，自基部直达叶轴均密生棕色条形至钻形狭鳞片；叶片草质，广倒披针形，长60～100厘米，中部稍上方最宽处约25厘米，二回羽状全裂或深裂:中部羽片长10～15厘米，宽2～3厘米；小裂片密接，长圆形，圆头，几全缘或先端有钝锯齿，两面多少被锈色鳞片，下面淡绿色；侧脉羽状分叉。孢子囊群分布于叶片中部以上的羽片上，生于小脉中部以下，每裂片2～4对；囊群盖肾圆形，直径约1毫米，棕色。"}]},{"ID":"20240613100014-bp2rqjy","Type":"NodeParagraph","Properties":{"id":"20240613100014-bp2rqjy","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生于林下沼地。分布黑龙江、吉林、辽宁、河北等地。"}]},{"ID":"20240613100014-sie4zzl","Type":"NodeParagraph","Properties":{"id":"20240613100014-sie4zzl","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②蛾眉蕨，又名:亚美蹄盖蕨。"}]},{"ID":"20240613100014-jh133ux","Type":"NodeParagraph","Properties":{"id":"20240613100014-jh133ux","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～90厘米。根状茎粗短，直立或斜生，有较多坚硬的叶柄残基，先端有阔披针形鳞片。叶簇生；叶柄长15～20厘米，禾秆色；叶片草质，长约60厘米，宽约20厘米，先端渐尖，沿叶轴、羽轴和主脉有棕色短毛，2回羽状全裂和深裂，中部羽片长12～15厘米，宽1～2厘米，羽裂几达羽轴；裂片椭圆形，先端钝或浑圆，宽3～4毫米，边缘有浅圆齿，有单一的侧脉5～7对。孢子囊群狭长圆形，囊群盖新月形，全缘，质厚。"}]},{"ID":"20240613100014-ymwd6is","Type":"NodeParagraph","Properties":{"id":"20240613100014-ymwd6is","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生于山谷林下或灌丛中。分布东北及河北、河南、陕西、四川、云南西北部。"}]},{"ID":"20240613100014-mdqz73y","Type":"NodeParagraph","Properties":{"id":"20240613100014-mdqz73y","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③荚果蕨，又名:小叶贯众。"}]},{"ID":"20240613100014-ooxbulw","Type":"NodeParagraph","Properties":{"id":"20240613100014-ooxbulw","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"多年生草本，高50～90厘米。根状茎直立，连同叶柄基部密生披针形鳞片。叶簇生，2型，有柄；不育叶片圆倒披针形，长45～90厘米，宽14～25厘米，2回深羽裂，中部羽片宽1～2厘米；裂片边缘浅波状或顶端具圆齿；侧脉单一；下部羽片向下逐渐缩短成耳状。能育叶较短小，挺立，具粗硬的长柄，一回羽状，纸质，羽片向下反卷成有节的荚果状，包被囊群。孢子囊群圆形，生于侧脉分支的中部，成熟时汇合成条形；囊群盖白色膜质，熟后破裂消失。"}]},{"ID":"20240613100014-dqq455j","Type":"NodeParagraph","Properties":{"id":"20240613100014-dqq455j","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生于高山林下。分布东北、华北以及四川、西藏、陕西等地。"}]},{"ID":"20240613100014-mpryony","Type":"NodeParagraph","Properties":{"id":"20240613100014-mpryony","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④紫萁，又名:高脚贯众、老虎牙、水骨菜。"}]},{"ID":"20240613100014-o9suvjt","Type":"NodeParagraph","Properties":{"id":"20240613100014-o9suvjt","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"多年生草本，高50～80厘米。根状茎粗壮，横生或斜升。叶2型，幼时密被绒毛；不育叶片三角状阔卵形，长30～50厘米，宽25～40厘米，顶部以下2回羽状，小羽片长圆形或长圆披针形，先端钝或尖，基部圆形或宽楔形，边缘有匀密的微钝锯齿。能育叶强度收缩，小羽片条形，长1.5～2厘米，沿主脉两侧密生孢子囊，成熟后枯萎。"}]},{"ID":"20240613100014-br82pdr","Type":"NodeParagraph","Properties":{"id":"20240613100014-br82pdr","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生于林下或溪边的酸性土壤上。分布河南、山东、安徽、江苏、浙江、福建、台湾、广东、广西、江西、湖北、四川、贵州、云南、陕西等地。"}]},{"ID":"20240613100014-n0iqwp1","Type":"NodeParagraph","Properties":{"id":"20240613100014-n0iqwp1","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑤乌毛蕨，又名:龙船蕨、赤蕨头。形态参见\"东方乌毛蕨叶\"条。"}]},{"ID":"20240613100014-651bm1k","Type":"NodeParagraph","Properties":{"id":"20240613100014-651bm1k","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑥苏铁蕨"}]},{"ID":"20240613100014-14k6gda","Type":"NodeParagraph","Properties":{"id":"20240613100014-14k6gda","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"常绿粗大多年生草本，高约1.2米。根状茎木质，粗短，直立；有圆柱状主轴，连同根茎密生红棕色长钻形鳞片。叶多数，簇生主轴顶部；叶柄长6～20厘米，黄棕色；叶片革质，光滑，长圆披针形，长60～100厘米，宽10～30厘米，1回羽状，羽片条状披针形，长10～15厘米，宽1～1.5厘米，先端渐尖，基部斜心形，边缘有细密钝锯齿，常向下反卷；叶脉下凹，主脉两侧各有一行斜上的三角形网眼，网眼外的小脉分离。孢子囊最初沿网脉生长，以后向外布满叶脉全部，无囊群盖。"}]},{"ID":"20240613100014-31cqwwg","Type":"NodeParagraph","Properties":{"id":"20240613100014-31cqwwg","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生于山地干旱荒坡上。分布广东、广西、台湾和云南、贵州等地。"}]},{"ID":"20240613100014-l7bxaux","Type":"NodeParagraph","Properties":{"id":"20240613100014-l7bxaux","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑦狗脊蕨，又名:大叶贯众。"}]},{"ID":"20240613100014-jxhc9ok","Type":"NodeParagraph","Properties":{"id":"20240613100014-jxhc9ok","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"多年生草本，高50～90厘米。根状茎租短，倾斜，密生棕色披针形大鳞片。叶簇生；叶柄长30～50厘米，黄棕色，被多数鳞片；叶片厚纸质，长圆形，长30～80厘米，宽20～40厘米，2回羽裂，仅羽轴下部有小鳞片；下部羽片长15厘米左右，宽2～3厘米，羽裂1／2或略深；裂片三角形或三角状长圆形，先端尖，具微锯齿；叶脉网状，有网眼1～2行，网眼外的小脉分离，无内藏小脉。孢子囊群长形，生于主脉两侧相对的网脉上；囊群盖长肾形，褐色，革质，以外侧边着生网脉上，开向主脉。"}]},{"ID":"20240613100014-6z93tci","Type":"NodeParagraph","Properties":{"id":"20240613100014-6z93tci","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生于山坡疏林下阴湿处。分布西南、华南、华东及长江流域各地。"}]},{"ID":"20240613100014-6odr54f","Type":"NodeParagraph","Properties":{"id":"20240613100014-6odr54f","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613100014-kpt7rul","Type":"NodeParagraph","Properties":{"id":"20240613100014-kpt7rul","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" ①东北贯众"}]},{"ID":"20240613100014-x2mnpyt","Type":"NodeParagraph","Properties":{"id":"20240613100014-x2mnpyt","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"为植物粗茎鳞毛蕨的干燥根茎。呈长圆锥形，上端钝圆或截形，下端较尖，略弯曲；长10～20厘米，直径5～8厘米。表面黄棕色至黑棕色，密被排列整齐的叶柄残基及鳞叶，并有弯曲线状的细根。叶柄残基呈扁圆柱形，稍弯曲，质硬，折断面略平坦；棕色，维管束5～7个，呈黄白色点状，排列成圆环，河面一对稍大，每一叶柄基部外侧常生出3条须根。剥去叶柄残基，可见根茎，直径1～2厘米，质坚硬而不易折断，断面不平坦，呈深绿色至棕色。气特殊；味初淡而微带涩，渐苦而辛。"}]},{"ID":"20240613100014-osc57ro","Type":"NodeParagraph","Properties":{"id":"20240613100014-osc57ro","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"主产东北地区。"}]},{"ID":"20240613100014-k0dltg4","Type":"NodeParagraph","Properties":{"id":"20240613100014-k0dltg4","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②蛾眉蕨贯众"}]},{"ID":"20240613100014-j52grma","Type":"NodeParagraph","Properties":{"id":"20240613100014-j52grma","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"为植物蛾眉蕨的干燥根茎。呈长卵圆形，上端钝圆，下端较尖；长10～16厘米，直径6～10厘米；黑褐色。叶柄残基上部较宽而扁，向下渐细，两侧边缘具有明显的刺状突起，基部较窄常呈菱方形；质硬而脆，易折断，断面平坦，维管束2条，呈\"八\"字形排列；维管束中间，常有-个暗色点或已成空洞。叶柄基部外侧生有1或3条须根，常扁压，有分支。气微而特异，味涩或苦辛。"}]},{"ID":"20240613100014-rn4ui9f","Type":"NodeParagraph","Properties":{"id":"20240613100014-rn4ui9f","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"产北京、河南、甘肃等地。"}]},{"ID":"20240613100014-rj0g9ek","Type":"NodeParagraph","Properties":{"id":"20240613100014-rj0g9ek","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③荚果蕨贯众"}]},{"ID":"20240613100014-4kw881s","Type":"NodeParagraph","Properties":{"id":"20240613100014-4kw881s","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"为植物荚果蕨的根茎。呈倒卵形或长卵圃形，上部钝圆，下部稍尖，稍弯曲，常有呈尖嘴状突出的根茎；全体长10～16厘米，直径4～7厘米；棕褐色；周围密被叶柄残基及须根和少量鳞片。叶柄残基上部扁平，向下渐窄，背部隆起，中央有-条明显的纵棱脊，近上端可见呈\"V\"或\"M\"形的突起皱纹；质硬而脆，易折断，断面略平坦，有维管束2条，呈\"八\"字形排列。叶柄基部生出1～3条弯曲的须根，多分支，有时具棕色绒毛。气微而特异，味涩"}]},{"ID":"20240613100014-p838d55","Type":"NodeParagraph","Properties":{"id":"20240613100014-p838d55","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"产吉林、河北、河南、北京、陕西等地。"}]},{"ID":"20240613100014-1kpo0zl","Type":"NodeParagraph","Properties":{"id":"20240613100014-1kpo0zl","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④紫萁贯众，又名:薇贯众。为植物紫萁的干燥根茎。呈圆锥状或三角圆锥状，稍弯曲，顶端有时分支；长10～20厘米，直径4～8厘米；表面棕褐色，密被斜生的叶柄残基及须根，无鳞片。叶柄残基呈扁圆柱形，边缘钝圆，具耳状托叶翅，但翅易剥落，多已不存或呈撕裂状；质硬，折断面呈新月形或扁圆形，多中空，可见\"U\"形维管束，托叶翅的厚壁组织连成-片，断面呈一条黑线。叶柄基部生出弯曲的须根，常扁压，多分支。气微弱而特异，味淡微涩。"}]},{"ID":"20240613100014-9snd84d","Type":"NodeParagraph","Properties":{"id":"20240613100014-9snd84d","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"产华中、华东等地。"}]},{"ID":"20240613100014-m7826sp","Type":"NodeParagraph","Properties":{"id":"20240613100014-m7826sp","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑤乌毛蕨贯众"}]},{"ID":"20240613100014-xhqfy34","Type":"NodeParagraph","Properties":{"id":"20240613100014-xhqfy34","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"为植物乌毛蕨的干燥根茎。呈圆柱状或棱柱形，上端稍大；长10～20厘米，直径5～6厘米；呈棕褐色或黑褐色。根茎直立，粗壮，密被有空洞的叶柄残基及须根和鳞片。叶柄残基扁圆柱形，表面被黑褐色伏生的鳞片，脱落处呈小突起，粗糙；质坚硬，横断面中央多呈空洞状，皮部薄，有十数个点状维管束，排成环状，内面的两个稍大。叶柄基部较粗，外侧有一瘤状突起，簇生十余条须根。气微弱而特异，味微涩。"}]},{"ID":"20240613100014-ywd81mv","Type":"NodeParagraph","Properties":{"id":"20240613100014-ywd81mv","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"产湖南、广东、广西等地。"}]},{"ID":"20240613100014-lub2qt2","Type":"NodeParagraph","Properties":{"id":"20240613100014-lub2qt2","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑥苏铁蕨贯众"}]},{"ID":"20240613100014-5rprreo","Type":"NodeParagraph","Properties":{"id":"20240613100014-5rprreo","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"为植物苏铁蕨的干燥根茎。呈圆柱形，有时稍弯曲，多已纵切成两半或横切、斜切成厚片。根茎粗壮，直径3～5厘米，密被极短的叶柄残基及须根和少量鳞片，或叶柄残基全被削除；质坚硬，横切面圆形，灰棕色至红棕色，密布黑色小点；边缘呈不规则圆齿形，外皮黑褐色，皮层散布多数黄色点状维管束，中柱维管束十数个，多呈\"U\"、\"V\"字形或短线形，排成一圆圈，形成花纹。叶柄基部切面近圆形，直径5～8毫米，密布小黑点，维管束6～10个，排列成环，鳞片呈棕黄色毛茸状，松软。气微弱，味涩。"}]},{"ID":"20240613100014-vs0zcnp","Type":"NodeParagraph","Properties":{"id":"20240613100014-vs0zcnp","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"产广东、广西。"}]},{"ID":"20240613100014-l2cd1sm","Type":"NodeParagraph","Properties":{"id":"20240613100014-l2cd1sm","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑦狗脊蕨贯众"}]},{"ID":"20240613100014-amybuz6","Type":"NodeParagraph","Properties":{"id":"20240613100014-amybuz6","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"为植物狗脊蕨的干燥根茎。呈长圆柱形或削成四方柱形，挺直或稍弯曲，下端较尖；长6～26厘米，直径2～7厘米；红棕色至黑褐色。粗壮的根茎密被粗短的叶柄残基及须根和鳞片。叶柄残基半圆柱形，镰刀状弯曲，质坚硬，折断面可见维管束2～4个，内面的一对大，成\"八\"字形或\"ε3\"形排列。叶柄基部常生出1条弯曲的须根。鳞片靠近顶端较多，棕红色，片状，全缘。气微弱，味微苦涩。"}]},{"ID":"20240613100014-z2irnys","Type":"NodeParagraph","Properties":{"id":"20240613100014-z2irnys","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"产浙江、湖南、四川等地。"}]},{"ID":"20240613100014-6bf104n","Type":"NodeParagraph","Properties":{"id":"20240613100014-6bf104n","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613100014-f33w7dz","Type":"NodeParagraph","Properties":{"id":"20240613100014-f33w7dz","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 粗茎鳞毛蕨根茎主要成分为绵马素，系一种复杂的间苯三酚衍生物，性不稳定，能缓缓分解而产生三叉蕨素及白三叉蕨素；又含三叉蕨酚、黄三叉蕨酸、绵马次酸。另含有挥发袖、绵马鞣质、脂肪、树脂等；尚含三萜化合物羊齿烯、茉烯-b、铁线蕨酮、茉醇、茉醇-29雁齿烯等。"}]},{"ID":"20240613100014-q9h34t5","Type":"NodeParagraph","Properties":{"id":"20240613100014-q9h34t5","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"荚果蕨根茎含坡那甾酮A、蜕皮甾酮、蝶甾酮。"}]},{"ID":"20240613100014-b00scay","Type":"NodeParagraph","Properties":{"id":"20240613100014-b00scay","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"紫萁根茎含坡那甾酮-A、蜕皮松、蜕皮甾酮。"}]},{"ID":"20240613100014-b35dfzh","Type":"NodeParagraph","Properties":{"id":"20240613100014-b35dfzh","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"乌毛蕨根茎含绿原酸。"}]},{"ID":"20240613100014-86s7eb0","Type":"NodeParagraph","Properties":{"id":"20240613100014-86s7eb0","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"狗脊蕨根茎含淀粉（29.5％或48.5％）、鞣质。"}]},{"ID":"20240613100014-fp2k7ul","Type":"NodeParagraph","Properties":{"id":"20240613100014-fp2k7ul","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"欧洲鳞毛蕨根茎含绿原酸、绵马酸、黄三叉蕨酸、副三叉蕨素、低三叉蕨素、三叉蕨酚、白三叉蕨素、三叉蕨素、三叉蕨宁、黄三叉蕨宁、低三叉蕨酚及绵马次酸等。"}]},{"ID":"20240613100014-fh4nrvs","Type":"NodeParagraph","Properties":{"id":"20240613100014-fh4nrvs","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613100014-v4uv69b","Type":"NodeParagraph","Properties":{"id":"20240613100014-v4uv69b","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众品种较多，药理试验时大多未作鉴定。"}]},{"ID":"20240613100014-nv8h7fx","Type":"NodeParagraph","Properties":{"id":"20240613100014-nv8h7fx","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"①驱虫作用"}]},{"ID":"20240613100014-u0yt5rb","Type":"NodeParagraph","Properties":{"id":"20240613100014-u0yt5rb","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"粗茎鳞毛蕨，即东北贯众，根称绵马，含粗绵马精49.17％，可作欧绵马的代用品，驱除绦虫。欧绵马能麻痹绦虫，应用历史已很长。国内报告，贯众（品种未经鉴定）在体外对猪蛔有效。粗茎鳞毛蕨还能驱除牛肝蛭。其复方煎剂对牛片形吸虫病及阔吸盘吸虫病有治疗功效。"}]},{"ID":"20240613100014-lop01uz","Type":"NodeParagraph","Properties":{"id":"20240613100014-lop01uz","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②抗病毒作用"}]},{"ID":"20240613100014-jajeykg","Type":"NodeParagraph","Properties":{"id":"20240613100014-jajeykg","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"上海报道，贯众对流感病毒（流感原甲型PR株、亚洲甲型病毒）在鸡胚试验上有强烈抑制作用，在小鼠（滴鼻法）试验上也有效。但作用较弱。此抗病毒作用与其所含鞣酸有关（含14.5％）。陕西亦报道，贯众对流感病毒的甲型（PR6）、亚洲甲型（57-4）、乙型（Lee）、丙型（1233）、丁型（仙台）均有抑制作用。在用人胚肾原代单层细胞的组织培养上，也证明贯众对479号腺病毒3型、72号脊髓灰质炎Ⅱ型、44号爱可9型、柯萨奇A9型、柯萨奇B6型、乙型脑炎（京卫研1株）、140号单纯疱疹等七种有代表性病毒株有较强的抗病毒作用。欧绵马的水煎剂也有抗单纯疱疹病毒的作用。"}]},{"ID":"20240613100014-v5rcuzr","Type":"NodeParagraph","Properties":{"id":"20240613100014-v5rcuzr","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③抗菌作用"}]},{"ID":"20240613100014-e70otso","Type":"NodeParagraph","Properties":{"id":"20240613100014-e70otso","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"江西、湖南、广东报道，当地贯众有某些抑菌作用，但效力不强，农村中作饮水消毒或预防流行性脑脊髓膜炎。据称，对皮肤真菌也有些抑制作用。"}]},{"ID":"20240613100014-7hmrsoy","Type":"NodeParagraph","Properties":{"id":"20240613100014-7hmrsoy","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④对子宫的作用"}]},{"ID":"20240613100014-xfxcyev","Type":"NodeParagraph","Properties":{"id":"20240613100014-xfxcyev","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"煎剂及精制后的有效成分对家兔的离体及在位子宫有显著的兴奋作用，收缩增强，张力提高。粗茎鳞毛蕨注射液对豚鼠（0.1～0.7毫升。每毫升相当生药50毫克）、家兔（O.8～1.3毫升）的离体子宫有显著的兴奋作用，运动频率及紧张度均增加，振幅减小，大剂量呈现强直性收缩；但换洗后，仍可恢复正常。蛾眉蕨贯众对子宫作用不甚明显。据报道，贯众与拳参等组成的\"止血净\"，外用有止血、镇痛、消炎作用。"}]},{"ID":"20240613100014-ns9vcrh","Type":"NodeParagraph","Properties":{"id":"20240613100014-ns9vcrh","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613100014-3io06ew","Type":"NodeParagraph","Properties":{"id":"20240613100014-3io06ew","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众:用清水稍浸，取出，早晚各洒水一次，润软，切片，晒干。贯众炭:取净贯众片炒至焦黑色为度，喷洒清水，放凉。"}]},{"ID":"20240613100014-tajmnjh","Type":"NodeParagraph","Properties":{"id":"20240613100014-tajmnjh","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613100014-00shq0s","Type":"NodeParagraph","Properties":{"id":"20240613100014-00shq0s","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 入肝、胃经。"}]},{"ID":"20240613100014-gt6323g","Type":"NodeParagraph","Properties":{"id":"20240613100014-gt6323g","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"①《本草新编》:\"入阳明胃经，亦入心、肺。\""}]},{"ID":"20240613100014-456e1yf","Type":"NodeParagraph","Properties":{"id":"20240613100014-456e1yf","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②《得配本草》:\"入足厥阴经。\""}]},{"ID":"20240613100014-jpwuu04","Type":"NodeParagraph","Properties":{"id":"20240613100014-jpwuu04","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③《本草再新》:\"入肝、肾二经。\""}]},{"ID":"20240613100014-z01j0wv","Type":"NodeParagraph","Properties":{"id":"20240613100014-z01j0wv","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④《本草撮要》:\"入手太阴、足厥阴经。\""}]},{"ID":"20240613100014-28cdlvz","Type":"NodeParagraph","Properties":{"id":"20240613100014-28cdlvz","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613100014-tfofd5e","Type":"NodeParagraph","Properties":{"id":"20240613100014-tfofd5e","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 苦，凉。"}]},{"ID":"20240613100014-94rgaly","Type":"NodeParagraph","Properties":{"id":"20240613100014-94rgaly","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"味苦，微寒。\""}]},{"ID":"20240613100014-c6mykp5","Type":"NodeParagraph","Properties":{"id":"20240613100014-c6mykp5","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》:\"神农、歧伯:苦，有毒。一《经》甘，有毒。黄帝:咸酸，一《经》苦，无毒。\""}]},{"ID":"20240613100014-j1h8gq0","Type":"NodeParagraph","Properties":{"id":"20240613100014-j1h8gq0","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》:\"性寒，味咸涩。\""}]},{"ID":"20240613100014-88xco5k","Type":"NodeParagraph","Properties":{"id":"20240613100014-88xco5k","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④《陕西中草药》:\"味涩、苦，性寒，有小毒。\""}]},{"ID":"20240613100014-o8sk03p","Type":"NodeParagraph","Properties":{"id":"20240613100014-o8sk03p","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑤金华《常用中草药单方验方选编》:\"苦甘，温。\""}]},{"ID":"20240613100014-lmji0nt","Type":"NodeParagraph","Properties":{"id":"20240613100014-lmji0nt","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613100014-yb8zfqu","Type":"NodeParagraph","Properties":{"id":"20240613100014-yb8zfqu","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 阴虚内热及脾胃虚寒者不宜，孕妇慎用。"}]},{"ID":"20240613100014-u6jvt5n","Type":"NodeParagraph","Properties":{"id":"20240613100014-u6jvt5n","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》:\"藋菌为之使。\""}]},{"ID":"20240613100014-1ihivaq","Type":"NodeParagraph","Properties":{"id":"20240613100014-1ihivaq","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②《药性论》:\"赤小豆为使。\""}]},{"ID":"20240613100014-a6w5ir5","Type":"NodeParagraph","Properties":{"id":"20240613100014-a6w5ir5","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》:\"病人虚寒无实热者禁用。\""}]},{"ID":"20240613100014-bg7fjgk","Type":"NodeParagraph","Properties":{"id":"20240613100014-bg7fjgk","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④《云南中草药》:\"孕妇忌服。\""}]},{"ID":"20240613100014-zp1ox3t","Type":"NodeParagraph","Properties":{"id":"20240613100014-zp1ox3t","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613100014-mefkhdj","Type":"NodeParagraph","Properties":{"id":"20240613100014-mefkhdj","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 杀蛔、绦、蛲虫，清热，解毒，凉血，止血。治风热感冒。温热斑疹，吐血，衄血，肠风便血，血痢，血崩，带下，疮疡，尿血，月经过多，刀伤出血，蛔虫、饶虫、绦虫病，人工流产，产后出血。"}]},{"ID":"20240613100014-db1z3e1","Type":"NodeParagraph","Properties":{"id":"20240613100014-db1z3e1","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"主腹中邪热气，诸毒，杀三虫。\""}]},{"ID":"20240613100014-eakmgxt","Type":"NodeParagraph","Properties":{"id":"20240613100014-eakmgxt","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"去寸白，破症瘕，除头风，止金疮。\""}]},{"ID":"20240613100014-0plhc26","Type":"NodeParagraph","Properties":{"id":"20240613100014-0plhc26","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③《本草图经》:\"止鼻衄。\""}]},{"ID":"20240613100014-943c6x4","Type":"NodeParagraph","Properties":{"id":"20240613100014-943c6x4","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》:\"祛毒，止血，解水毒。\""}]},{"ID":"20240613100014-vgzbl4j","Type":"NodeParagraph","Properties":{"id":"20240613100014-vgzbl4j","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》:\"治下血崩中，带下，产后血气胀痛，斑疹毒，漆毒，骨哽。\""}]},{"ID":"20240613100014-kx4rn59","Type":"NodeParagraph","Properties":{"id":"20240613100014-kx4rn59","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑥《会约医镜》:\"治邪热腹痛，解时行疫气。\""}]},{"ID":"20240613100014-l8taiok","Type":"NodeParagraph","Properties":{"id":"20240613100014-l8taiok","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑦《奉经续疏》:\"治喉痹，消顽肿。\""}]},{"ID":"20240613100014-nrz0m0f","Type":"NodeParagraph","Properties":{"id":"20240613100014-nrz0m0f","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑧《东北常用中草药手册》:\"驱虫，止血，清热解毒。治蛔虫，绦虫，虫积腹痛；子宫功能牲出血，白带。贯众放在水缸中，饮用其水，预防流行性感冒、感冒、流行性脑脊髓膜炎、麻疹。\""}]},{"ID":"20240613100014-mixzohc","Type":"NodeParagraph","Properties":{"id":"20240613100014-mixzohc","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑨《陕西中草药》:\"清热解毒，止血杀虫。预防流行性乙型脑炎、流行性腮腺炎等传染病。治便血。尿血、鼻衄、月经过多、蛔虫症、蛲虫症。\""}]},{"ID":"20240613100014-2yv2990","Type":"NodeParagraph","Properties":{"id":"20240613100014-2yv2990","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑩金华《常用中草药单方验方选编》:\"祛风活血，补肝肾。治风寒湿痹，腰膝酸痛，遗尿。\""}]},{"ID":"20240613100014-qiuqd4m","Type":"NodeParagraph","Properties":{"id":"20240613100014-qiuqd4m","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613100014-qktymos","Type":"NodeParagraph","Properties":{"id":"20240613100014-qktymos","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 内服:煎汤，1.5～3钱；或入丸、散。外用:研末调涂。"}]},{"ID":"20240613100014-hp31sbb","Type":"NodeParagraph","Properties":{"id":"20240613100014-hp31sbb","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613100014-ucxxy7i","Type":"NodeParagraph","Properties":{"id":"20240613100014-ucxxy7i","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" ①治蛔虫攻心，吐如醋水，痛不能止:贯众一两，鹤虱一两（纸上微炒），狼牙一两，麝香一钱（细研），芜荑仁一两，龙胆一两（去芦头）。上药捣细罗为散。每于食前以淡醋汤调下二钱。（《圣惠方》贯众散）"}]},{"ID":"20240613100014-vin3erv","Type":"NodeParagraph","Properties":{"id":"20240613100014-vin3erv","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②治钩虫病:㈠贯众三斤，黄荆叶二斤，蜂蜜六斤四两，槟榔、鹤虱各半斤，霍丸四两；㈡贯众三斤，黄荆叶二斤，蜂蜜六斤，陈皮一斤；㈢贯众三斤，黄荆叶二斤，蜂蜜七斤，槟榔、榧子各半斤，雷丸三两，鹤虱四两。各方制法，均是各研细末，充分和匀，先将蜂蜜熬至滴水结块为度，搅拌药粉，放在清洁捣臼里捣二千杵左右，制丸。每丸潮重二钱五分左右。均在晚饭后一至二小时服，十至十二岁，一次服四丸；十三至十六岁，服六丸；十六岁以上服八丸。（《浙江医学》2（9）:384，1961）"}]},{"ID":"20240613100014-dat7o6r","Type":"NodeParagraph","Properties":{"id":"20240613100014-dat7o6r","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③治钩虫病:贯众三两，苦楝皮、山紫苏、土荆芥各五钱。煎汤，成人-次服用。（《中医杂志》（3）:3，1959）"}]},{"ID":"20240613100014-4ho815x","Type":"NodeParagraph","Properties":{"id":"20240613100014-4ho815x","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④解一切诸热毒，或中食毒、酒毒、药毒等:贯众、黄连、甘草各三钱，骆驼峰五钱。上为细末。每服三钱，冷水调下。（《普济方》贯众散）"}]},{"ID":"20240613100014-mjaapfu","Type":"NodeParagraph","Properties":{"id":"20240613100014-mjaapfu","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑤治疮疹出快肥红:贯众一两（拣，洗净，焙干），赤芍药一两，甘草半两，川升麻半两，枳壳（麸炒，去穰）半两。上为末。每服-钱，水一小盏，入竹叶七片，煎至五分，去滓温服，无时。（《小儿卫生总微论方》快斑散）"}]},{"ID":"20240613100014-rjf54xo","Type":"NodeParagraph","Properties":{"id":"20240613100014-rjf54xo","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑥预防麻疹:贯众五钱，银花五钱，鬼灯笼三钱。水煎服，连服五剂以上，每日服一剂。（《陆川本草》）"}]},{"ID":"20240613100014-pgedhdn","Type":"NodeParagraph","Properties":{"id":"20240613100014-pgedhdn","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑦预防流行性感冒:㈠贯众每天三钱。水煎，分二次服，儿童酌减。（湖北《中草医药经验交流》）；㈡贯众三钱，南瓜蔓一尺。水煎服，可连服三日。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240613100014-7uzvsub","Type":"NodeParagraph","Properties":{"id":"20240613100014-7uzvsub","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑧预防流行性脑脊髓膜炎:贯众二两，雄黄三钱，生明矾八钱。放入饮水缸内，作饮水消毒用，七天换一次。（《全展选编。爱国卫生》）"}]},{"ID":"20240613100014-eitii8n","Type":"NodeParagraph","Properties":{"id":"20240613100014-eitii8n","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑨治年深咳嗽，出脓血:贯众、苏方木等分。每服三钱，水一盏，生姜三片，煎服，日二服。（《圣惠方》）"}]},{"ID":"20240613100014-16yhhsh","Type":"NodeParagraph","Properties":{"id":"20240613100014-16yhhsh","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑩治久咳渐成劳瘵:凤尾草为末，用鱼鲊蘸食之。（《圣惠方》）"}]},{"ID":"20240613100014-gnhkoli","Type":"NodeParagraph","Properties":{"id":"20240613100014-gnhkoli","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑾治暴吐血嗽血:贯众一两，黄连（去须）年老者半两、年少者三分。上二味捣罗为细散，每服二钱匕，浓煎糯米饮调下。（《圣济总录》贯众散）"}]},{"ID":"20240613100014-aasrw8o","Type":"NodeParagraph","Properties":{"id":"20240613100014-aasrw8o","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⑿治吐血成斗，命在须臾:管仲二钱（净末），血余五钱（烧灰），侧柏叶（捣汁）一碗.上将药末两味、入柏汁内搅匀，于大碗内盛之，重汤煮一炷香时，取出待温，入童便一小盅，黄酒少许，频频温服。（《万病回春》管仲汤）"}]},{"ID":"20240613100014-89oimis","Type":"NodeParagraph","Properties":{"id":"20240613100014-89oimis","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒀治鼻大衄:贯众根为末，水调服一钱匕。（《本草图经》）"}]},{"ID":"20240613100014-dmnqwwu","Type":"NodeParagraph","Properties":{"id":"20240613100014-dmnqwwu","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒁治肠风酒痢下血及鼠于痔出血、血痔:贯仲二两。去芦头，烧灰存性，用瓦合地上去火毒，为末，入麝香一字研匀。米饮调服二钱。（《普济方》经效散）"}]},{"ID":"20240613100014-ckkjcce","Type":"NodeParagraph","Properties":{"id":"20240613100014-ckkjcce","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒂治血痢不止:凤尾草根五钱。煎酒服。（《濒湖集简方》）"}]},{"ID":"20240613100014-vvwx04j","Type":"NodeParagraph","Properties":{"id":"20240613100014-vvwx04j","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒃治肠风便血，久痢下血水，妇人崩淋沥血，并积年白带:贯众一分（酒漫一日，连须并内肉，俱切碎，曝干，微炒），黑蒲黄、丹参各减半（俱酒洗，炒）。共为末。每早晚食前白酒下。（《本草汇言》）"}]},{"ID":"20240613100014-rjaa2wa","Type":"NodeParagraph","Properties":{"id":"20240613100014-rjaa2wa","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒄治妇人崩漏:管仲同米炒。每服二钱，酒、醋下。（《海上方》）"}]},{"ID":"20240613100014-rjc7adk","Type":"NodeParagraph","Properties":{"id":"20240613100014-rjc7adk","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒅治功能性子宫出血，对消化道出血、尿血、小量咯血亦有疗效:贯众炭一两，乌贼骨四钱。共为细末，打片，加阿胶一钱，每片0.5克。每日三次，每次八片。（《教育革命简报》1:33，1972）"}]},{"ID":"20240613100014-tt1bgl7","Type":"NodeParagraph","Properties":{"id":"20240613100014-tt1bgl7","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒆治崩漏血色紫而有块，少腹胀痛，脉沉，有瘀血者:贯众、五灵脂各三钱。均炒黑研末。用水冲服。（《中医杂志》（6）:224，1961）"}]},{"ID":"20240613100014-svxf074","Type":"NodeParagraph","Properties":{"id":"20240613100014-svxf074","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"⒇治产妇恶露淋沥，体倦面黄，食少恶寒，昼夜不寐，惊悸汗出:贯众（醋蘸炙干）为末。每服二钱，米饮调下。（《妇人良方》）"}]},{"ID":"20240613100014-0difjge","Type":"NodeParagraph","Properties":{"id":"20240613100014-0difjge","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"（21）治漆疮:贯众，治末以涂上，干以油和之。（《千金方》）"}]},{"ID":"20240613100014-3wwpdpo","Type":"NodeParagraph","Properties":{"id":"20240613100014-3wwpdpo","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"（22）治便毒肿痛:贯众，酒服二钱。（《多能鄙事》）"}]},{"ID":"20240613100014-4k0gdzg","Type":"NodeParagraph","Properties":{"id":"20240613100014-4k0gdzg","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"（23）治火烧疮:贯众煅灰，和香油调涂，止痛。（《岭南采药录》）"}]},{"ID":"20240613100014-rvykbv3","Type":"NodeParagraph","Properties":{"id":"20240613100014-rvykbv3","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"（24）解轻粉毒，齿缝出血臭肿:贯众、黄连各半两。煎水，入冰片少许，时时漱之。（《积德堂经验方》）"}]},{"ID":"20240613100014-d9fj1fr","Type":"NodeParagraph","Properties":{"id":"20240613100014-d9fj1fr","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"（25）治骨鲠:缩砂仁、甘草、贯众等分。上捣为粗末。如一切鲠，以绵裹少许含之，旋旋咽津，久则随痰出。（《普济方》缩砂散）"}]},{"ID":"20240613100014-l6bix07","Type":"NodeParagraph","Properties":{"id":"20240613100014-l6bix07","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613100014-tg6sy33","Type":"NodeParagraph","Properties":{"id":"20240613100014-tg6sy33","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众品种较多，各地临床报道，大多未经鉴定。"}]},{"ID":"20240613100014-hpby19d","Type":"NodeParagraph","Properties":{"id":"20240613100014-hpby19d","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"①预防感冒"}]},{"ID":"20240613100014-hx1hky3","Type":"NodeParagraph","Properties":{"id":"20240613100014-hx1hky3","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"将贯众制成冲剂内服，每人每次12克（相当于生药9钱），每周2次。预防服药观察306人，观察期间发病者占12.02％，而对照组340人中发病者占33.2％。亦可用贯众3钱、桑叶1.5钱煎服，每天1次，每周连服2天，共服3周。服药者671人，发病者占3.56％；对照组649人，发病率为8.32％。"}]},{"ID":"20240613100014-5mlw1jn","Type":"NodeParagraph","Properties":{"id":"20240613100014-5mlw1jn","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②预防流行性脑脊髓膜炎"}]},{"ID":"20240613100014-l625gfb","Type":"NodeParagraph","Properties":{"id":"20240613100014-l625gfb","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"内服粉剂或片剂，成人每次2克，10岁以下1克，1岁以下0.5克，每周服药1次，连服2周。在4764人中检出健康带菌者（咽拭培养阳性）59例，按上法服药后，复查均转为阴性。以后每月再按上法服药2周，经3个月后再次复查，仍为阴性。"}]},{"ID":"20240613100014-3gb9z6m","Type":"NodeParagraph","Properties":{"id":"20240613100014-3gb9z6m","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③治疗胆道蛔虫病"}]},{"ID":"20240613100014-9pdguet","Type":"NodeParagraph","Properties":{"id":"20240613100014-9pdguet","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"用贯众、苦楝根皮各75克（15岁以下儿童每次每岁各5克），水煎两次，煎液混合浓缩成100毫升左右，空腹时1次顿服，连服2日。病情急剧者可日服2次，连服2次后须间隔1、2天再服，以防中毒。除便秘者外，不必服泻药。观察34例，服药2～6次，症状、体征消失者30例，显著减轻者4例，所有病例均在服药后1～4天内连续排出蛔虫。"}]},{"ID":"20240613100014-b9so5ww","Type":"NodeParagraph","Properties":{"id":"20240613100014-b9so5ww","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④用于收缩子宫"}]},{"ID":"20240613100014-794ti36","Type":"NodeParagraph","Properties":{"id":"20240613100014-794ti36","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"用粗茎鳞毛蕨制成注射液，每2毫升相当于原药1克，行肌肉注射或子宫颈局部注射，重症剂量加倍。治疗产后出血、流产后出血、人工流产、剖腹产及葡萄胎手术共48例，有效率91.6％。一般在用药后10分钟左右出现明显子宫收缩，随即流血减少直至停止。另有报道用乌毛蕨制成注射液，轻症2毫升（相当生药5克），重症4毫升，肌肉注射，应用于人工流产及产后流血52例，均在注射后3～5分钟出现明显的子宫收缩，无一例失败，且注射后无任何副作用。"}]},{"ID":"20240613100014-c1s6f50","Type":"NodeParagraph","Properties":{"id":"20240613100014-c1s6f50","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"此外，不少地区曾用贯众配合苦楝皮、紫苏、土荆芥组成复方，治疗钩虫病，但疗效差异极大。"}]},{"ID":"20240613100014-dcpqp6t","Type":"NodeParagraph","Properties":{"id":"20240613100014-dcpqp6t","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613100014-hiwfap1","Type":"NodeParagraph","Properties":{"id":"20240613100014-hiwfap1","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" ①《纲目》:\"贯众，大治妇人血气。王海藏治夏月痘出不快，快斑散用之，云贯众有毒，而能解腹中邪热之毒。病因内感而发之于外者多效，非古法之分经也。\""}]},{"ID":"20240613100014-s99rg98","Type":"NodeParagraph","Properties":{"id":"20240613100014-s99rg98","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》:\"贯众，以其苦寒，故主腹中邪热气诸毒。苦以泄之，亦兼有散之之义，故破症瘕。苦寒能除风热，故止头风。金疮出血后必发热，泄热散结，则金疮自止。\""}]},{"ID":"20240613100014-taif4ty","Type":"NodeParagraph","Properties":{"id":"20240613100014-taif4ty","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》:\"贯众，杀虫化症之药也。前古主腹中邪热结气，故时人用为杀虫化症，皆属腹中邪热湿郁结气也.苏氏方，又治下血崩淋，衄血不止，亦取其气味苦寒散结热耳。但性寒气燥有毒，如病人营虚血槁，肝肾有火，并阴虚咳嗽人，不可加用。\""}]},{"ID":"20240613100014-38k46x3","Type":"NodeParagraph","Properties":{"id":"20240613100014-38k46x3","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"④《本草正义》:\"贯众，苦寒沉降之质，故主邪热而能止血，并治血痢下血，甚有捷效，皆苦以燥湿、寒以泄热之功也。然气亦浓厚，故能解时邪热结之毒。《别录》除头风，专指风热言之，凡大头疫肿连耳目，用泄散而不遽应者，但加入贯众一味，即邪势透泄，而热解神清，不独苦寒泄降，亦气之足以散邪也。故时疫盛行，宜浸入水缸中，常饮则不传染，而井中沉一枚，不犯百毒，则解毒之功，尤其独著，不得以轻贱而忽之。\""}]},{"ID":"20240613100014-o3q968l","Type":"NodeParagraph","Properties":{"id":"20240613100014-o3q968l","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613100014-o3knizy","Type":"NodeParagraph","Properties":{"id":"20240613100014-o3knizy","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众的品种，历来就很复杂，除上述品种外，尚有多种蕨类植物的根茎在不同地区作贯众使用。如辽东鳞毛蕨的根茎使用于河南、山东、湖南；单芽狗脊蕨的根茎使用于甘肃、湖南、云南、贵州；多鳞耳蕨的根茎使用于西藏地区；欧洲鳞毛蕨的根茎使用于新疆。另外，鳞毛蕨科植物山地贯众习称贯众，与《植物名实图考》所载的贯众相符，但这种植物的根茎，目前很少作贯众入药，仅在四川、云南、贵州、江西等省的部分县及江苏南京等地民间使用。参见\"昏鸡头\"条。"}]},{"ID":"20240613100014-17nwdg1","Type":"NodeParagraph","Properties":{"id":"20240613100014-17nwdg1","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613100014-w2ammoj","Type":"NodeParagraph","Properties":{"id":"20240613100014-w2ammoj","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613100014-476xm24","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613100014-476xm24","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"《中华本草》：贯众"}]},{"ID":"20240613100014-xyolyg6","Type":"NodeParagraph","Properties":{"id":"20240613100014-xyolyg6","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613100014-vlt70sk","Type":"NodeParagraph","Properties":{"id":"20240613100014-vlt70sk","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" Guàn Zhònɡ"}]},{"ID":"20240613100014-s0ygvqo","Type":"NodeParagraph","Properties":{"id":"20240613100014-s0ygvqo","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613100014-9l0zs9o","Type":"NodeParagraph","Properties":{"id":"20240613100014-9l0zs9o","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 止泺、贯节、贯渠、百头、虎卷、扁苻、贯来、贯中、渠母、贯钟、伯芹、药渠、黄钟、伯萍、乐藻、草鸱头、伯药、药藻、凤尾草、蕨薇菜根、贯仲、管仲、绵马贯仲"}]},{"ID":"20240613100014-ddgbyl7","Type":"NodeParagraph","Properties":{"id":"20240613100014-ddgbyl7","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613100014-8urz9bh","Type":"NodeParagraph","Properties":{"id":"20240613100014-8urz9bh","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" Japanese Flowering Fern Rhizome， Male Fern Rhizome， Cyrtomium Rhizome， Matteuccia Fern Rhizome， Japonica China Fern Rhizome， Oriental Blechnum Fern Rhizome"}]},{"ID":"20240613100014-8dkajvu","Type":"NodeParagraph","Properties":{"id":"20240613100014-8dkajvu","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613100014-lcxt035","Type":"NodeParagraph","Properties":{"id":"20240613100014-lcxt035","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 1.《吴普本草》：贯众，叶青黄，两两相对，茎黑毛聚生，冬夏不死，四月华白，七月实黑，三月、八月采根，五月采叶。"}]},{"ID":"20240613100014-dic3ybi","Type":"NodeParagraph","Properties":{"id":"20240613100014-dic3ybi","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"2.《别录》：贯众，生玄山山谷，及冤句少室山。二月、八月采根，阴干。"}]},{"ID":"20240613100014-nd33pqm","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613100014-nd33pqm","updated":"20240613100014"},"Children":[{"ID":"20240613100014-qmyo3xb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240613100014-qmyo3xb","updated":"20240613100014"},"Children":[{"ID":"20240613100014-34kbg2f","Type":"NodeParagraph","Properties":{"id":"20240613100014-34kbg2f","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"陶弘景：贯众，近道亦有。叶如大蕨，其根形毛芒全以老鸱头，故呼为草鸱头。"}]}]}]},{"ID":"20240613100014-wd1iqqx","Type":"NodeParagraph","Properties":{"id":"20240613100014-wd1iqqx","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"4.《蜀本草》：《图经》云，贯众，苗似狗脊，状如雉尾，根直多枝，皮黑肉赤，曲者名草鸱头，今所在山谷阴处有之。"}]},{"ID":"20240613100014-jln1lzi","Type":"NodeParagraph","Properties":{"id":"20240613100014-jln1lzi","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"5.《"}]},{"ID":"20240613100014-jwu180j","Type":"NodeParagraph","Properties":{"id":"20240613100014-jwu180j","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613100014-y20lypz","Type":"NodeParagraph","Properties":{"id":"20240613100014-y20lypz","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鳞毛蕨科植物粗茎鳞毛蕨的根茎及叶柄残基。"}]},{"ID":"20240613100014-26gsiit","Type":"NodeParagraph","Properties":{"id":"20240613100014-26gsiit","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dryopteris crassirhizoma Nakai"}]},{"ID":"20240613100014-jzog7kv","Type":"NodeParagraph","Properties":{"id":"20240613100014-jzog7kv","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收，将全株挖起，除去地上部分及须根，洗净，晒干。"}]},{"ID":"20240613100014-08mfst5","Type":"NodeParagraph","Properties":{"id":"20240613100014-08mfst5","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613100014-po5uovl","Type":"NodeParagraph","Properties":{"id":"20240613100014-po5uovl","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔300-1200m的林下沼泽地或林下阴湿处。"}]},{"ID":"20240613100014-s6cmtug","Type":"NodeParagraph","Properties":{"id":"20240613100014-s6cmtug","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北及内蒙古、河北等地及北京市。"}]},{"ID":"20240613100014-7ehr1df","Type":"NodeParagraph","Properties":{"id":"20240613100014-7ehr1df","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613100014-w3mx4y0","Type":"NodeParagraph","Properties":{"id":"20240613100014-w3mx4y0","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高50-100cm。根茎粗壮，斜生，有较多坚硬的叶柄残基及黑色细根，密被深褐色、长披针形的大鳞片。叶簇生于根茎顶端；叶柄长10-25cm，基部以上直达叶轴密生棕色条形至钻形狭鳞片，叶片草质，倒披针形，长60-100cm，中部稍上处宽20-25cm，二回羽状全裂或深裂；羽片无柄，裂片密接，长圆形，圆头或圆截头，近全缘或先端有钝锯齿；上面深绿色，下面淡绿色，侧脉羽状分叉。孢子叶与营养叶同形，孢子囊群着生于叶中部以上的羽片上，生于叶背小脉中部以下，囊群盖肾形或圆肾形，棕色。"}]},{"ID":"20240613100014-en4svqv","Type":"NodeParagraph","Properties":{"id":"20240613100014-en4svqv","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613100014-se36wwo","Type":"NodeParagraph","Properties":{"id":"20240613100014-se36wwo","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 全体略呈圆锥形，似凤梨，长10-20cm，直径4.5-8cm，表面密生整齐的叶柄残基及黄棕色膜质鳞片，并有弯曲的须根。叶柄残基呈扁圆柱形，稍弯曲，质硬，折断面棕色，近边缘处有细小分体中柱5-10（-13）个，环状排列。剥去叶柄残基，可见根茎，质坚硬，横断面有黄白色分体中柱5-13个，作环状排列。气特异，味微涩、苦。"}]},{"ID":"20240613100014-pcz7a8t","Type":"NodeParagraph","Properties":{"id":"20240613100014-pcz7a8t","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"以个大，质坚实，叶柄断面棕绿色者为佳。"}]},{"ID":"20240613100014-7b325k8","Type":"NodeParagraph","Properties":{"id":"20240613100014-7b325k8","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 叶柄基部横切面：表皮常脱落。下皮纤维10数列，纤维多角形，壁非木化。基本薄壁组织细胞类圆形，排列疏松，有大形细胞间隙，内生单细胞间隙腺毛，头部类球形，含分泌物，柄极短。分体中柱5-13个，环列。每1分体中柱最外层为内皮层，凯氏点明显，木质部居中，由多角形管胞组成，周围为韧皮部。根茎的薄壁组织间隙中，也有间隙腺毛。"}]},{"ID":"20240613100014-jnghpp0","Type":"NodeParagraph","Properties":{"id":"20240613100014-jnghpp0","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613100014-c0bxs67","Type":"NodeParagraph","Properties":{"id":"20240613100014-c0bxs67","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 毒性绵马有毒，故已少用。所幸它在肠胃道不易吸收，但如肠中有过多脂肪，则可促进吸收而致中毒。它能麻痹随意肌（包括心肌），对胃肠道有刺激，严重时导致呕吐、下泻，还能引起视力障碍，甚至失明（视网膜血管痉挛及伤害视神经）；中毒时引起中枢神经系统之障碍，震颤、惊厥乃至延脑麻痹。对孕妇、虚弱患者、小儿、实质器官的疾病患者、消化道溃疡者皆禁用。粗茎鳞毛蕨注射液，临床应用尚未发现有何副作用，动物试验，毒性较轻，小鼠腹腔注射半数致死量为34±0.04ml/kg。应准确掌握剂量。"}]},{"ID":"20240613100014-jq1rmag","Type":"NodeParagraph","Properties":{"id":"20240613100014-jq1rmag","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613100014-n4bd8c8","Type":"NodeParagraph","Properties":{"id":"20240613100014-n4bd8c8","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 粗茎鳞毛蕨的根茎含绵马酸（filixic acid）BBB、PBB、PBP等，黄绵马酸（flavaspidic acid）AB、BB、PB，以及白绵马素（albaspidin）。还含东北贯众素（dryocrassin），α-D-葡辛糖-δ-内脂-烯二醇（α-D-glucooctano-δ-lactone enediol），异戊烯腺甙（isopentenyaldenosine）。又含三萜成分：里白烯（diploptene），9（11）-羊齿烯[9（11）-fernene]，铁线蕨酮（adiantone），29-何帕醇（29-hopanol），里白醇（diplopterol），雁齿烯（filicene）等。"}]},{"ID":"20240613100014-8qe7m5w","Type":"NodeParagraph","Properties":{"id":"20240613100014-8qe7m5w","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613100014-mb5fabe","Type":"NodeParagraph","Properties":{"id":"20240613100014-mb5fabe","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众品种较多，药理试验时大多未作鉴定。"}]},{"ID":"20240613100014-jr99ej1","Type":"NodeParagraph","Properties":{"id":"20240613100014-jr99ej1","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"1.驱虫作用：粗茎鳞毛蕨，即东北贯众，根称绵马，含粗绵马精（Filicin）49.17%，可作欧绵马Dryopterisfilixmas（L.）Schott的代用品，驱除绦虫。欧绵马能麻痹绦虫，应用历史已很长。国内报告，贯众（品种未经鉴定）在体外对猪蛔有效。粗茎鳞毛蕨还能驱除牛肝蛭。其复方煎剂对牛片形吸虫病及阔吸盘吸虫病有治疗功效。"}]},{"ID":"20240613100014-xpez5oh","Type":"NodeParagraph","Properties":{"id":"20240613100014-xpez5oh","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"2.抗病毒作用：上海报道，贯众对流感病毒（流感原甲型PR8株、亚洲甲型病毒）在鸡胚试验上有强烈抑制作用，在小鼠（滴鼻法）试验上也有效，但作用较弱。此抗病毒作用与其所含鞣酸有关（含14.5%）。陕西亦报道，贯众对流感病毒的甲型（PR8）、亚洲甲型（57-4）、乙型（Lee）、丙型（1233）、丁型（仙台）均有抑制作用。在用人胚肾原代单层细胞的组织培养上，也证明贯众对479号腺病毒3型、72号脊髓灰质炎Ⅱ型、44号爱可9型、柯萨奇A9型、柯萨奇B5型、乙型脑炎（京卫研1株）、140号单纯疱疹等七种有代表性病毒株有较强的抗病毒作用。欧绵马的水煎剂也有抗单纯疱疹病毒的作用。"}]},{"ID":"20240613100014-7jeow1j","Type":"NodeParagraph","Properties":{"id":"20240613100014-7jeow1j","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"3．抗菌作用：江西、湖南、广东报道，当地贯众有某些抑菌作用，但效力不强，农村中作饮水消毒或预防流行性脑脊髓膜炎。据称，对皮肤真菌也有些抑制作用。"}]},{"ID":"20240613100014-eucdnr6","Type":"NodeParagraph","Properties":{"id":"20240613100014-eucdnr6","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"4.对子宫的作用：煎剂及精制后的有效成分对家兔的离体及在位子宫有显着的兴奋作用，收缩增强，张力提高。粗茎鳞毛蕨注射液对豚鼠（0.1-0.7ml，每毫升相当生药50mg）、家兔（0.8-1.3ml）的离体子宫有显着的兴奋作用，运动频率及紧张度均增加，振幅减小，大剂量呈现强直性收缩；但换洗后，仍可恢复正常。蛾眉蕨贯众对子宫作用不甚明显。"}]},{"ID":"20240613100014-4c1kwop","Type":"NodeParagraph","Properties":{"id":"20240613100014-4c1kwop","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613100014-hbp1d47","Type":"NodeParagraph","Properties":{"id":"20240613100014-hbp1d47","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众：用清水稍浸，取出，早晚各洒水一次，润软，切片，晒干。贯众炭：取净贯众片炒至焦黑色为度，喷洒清水，放凉。"}]},{"ID":"20240613100014-p3q7fiu","Type":"NodeParagraph","Properties":{"id":"20240613100014-p3q7fiu","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613100014-h3gzg4m","Type":"NodeParagraph","Properties":{"id":"20240613100014-h3gzg4m","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" （1）薄层色谱 取本品粗粉3g，加水30ml，加热提取30min，滤过，滤液加盐酸酸化，用乙醚提取3次，合并滤液，浓缩至干，加氯仿2ml溶解，点于硅胶G薄层板上，以氯仿-丙酮-冰醋酸（80：20：2.5）展开，先喷以新配的0.5%牢固蓝B盐（fast blue B salt）溶液，再喷0.1mol/L氢氧化钠溶液，绵马酸类显橙红色斑点。"}]},{"ID":"20240613100014-pdbohd3","Type":"NodeParagraph","Properties":{"id":"20240613100014-pdbohd3","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"（2）取本品横切面片，滴加1%香草醛乙醇溶液及浓盐酸，镜检，可见细胞间隙的内生腺毛显红色。"}]},{"ID":"20240613100014-v43t3rc","Type":"NodeParagraph","Properties":{"id":"20240613100014-v43t3rc","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613100014-mu4xec4","Type":"NodeParagraph","Properties":{"id":"20240613100014-mu4xec4","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 肝；胃经"}]},{"ID":"20240613100014-druofgu","Type":"NodeParagraph","Properties":{"id":"20240613100014-druofgu","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613100014-m8ybc46","Type":"NodeParagraph","Properties":{"id":"20240613100014-m8ybc46","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 苦；涩；微寒；有小毒"}]},{"ID":"20240613100014-8t0wjdk","Type":"NodeParagraph","Properties":{"id":"20240613100014-8t0wjdk","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613100014-q88wfjr","Type":"NodeParagraph","Properties":{"id":"20240613100014-q88wfjr","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 阴虚内热及脾胃虚寒者不宜，孕妇慎用。"}]},{"ID":"20240613100014-yl06bp3","Type":"NodeParagraph","Properties":{"id":"20240613100014-yl06bp3","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613100014-tel4qvv","Type":"NodeParagraph","Properties":{"id":"20240613100014-tel4qvv","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 杀虫；清热；解毒；凉血止血。主风热感冒；温热癍疹；吐血；咳血；衄血；便血；崩漏；血痢；带下及钩、蛔、绦虫等肠寄生虫病"}]},{"ID":"20240613100014-2stau9s","Type":"NodeParagraph","Properties":{"id":"20240613100014-2stau9s","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613100014-10o1ywq","Type":"NodeParagraph","Properties":{"id":"20240613100014-10o1ywq","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-15g；或入丸、散。外用：适量，研末调涂。"}]},{"ID":"20240613100014-7w1dagz","Type":"NodeParagraph","Properties":{"id":"20240613100014-7w1dagz","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613100014-1dxf2zj","Type":"NodeParagraph","Properties":{"id":"20240613100014-1dxf2zj","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 贯众散《太平圣惠方》；贯众散《普济方》；贯众散《圣济总论》；"}]},{"ID":"20240613100014-casahtc","Type":"NodeParagraph","Properties":{"id":"20240613100014-casahtc","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613100014-f33u2k3","Type":"NodeParagraph","Properties":{"id":"20240613100014-f33u2k3","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：贯众，大治妇人血气。王海藏治夏月痘出不快，快斑散用之，云贯众有毒，而能解腹中邪热之毒。病因内感而发之于外者多效，非古法之分经也。"}]},{"ID":"20240613100014-up7ib6g","Type":"NodeParagraph","Properties":{"id":"20240613100014-up7ib6g","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：贯众，以其苦寒，故主腹中邪热气诸毒。苦以泄之，亦兼有散之之义，故破症瘕。苦寒能除风热，故止头风。金疮出血后必发热，泄热散结，则金疮自止。"}]},{"ID":"20240613100014-mbsaiae","Type":"NodeParagraph","Properties":{"id":"20240613100014-mbsaiae","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：贯众，杀虫化症药也。前古主腹中邪热结气，故时人用为杀虫化症瘸，皆属腹中邪热湿郁结气也。苏氏方，又治下血崩淋，衄血不止，亦取其气味苦寒散结热耳。但性寒气燥有毒，如病人营虚血槁，肝肾有火，并阴虚咳嗽人，不可加用。"}]},{"ID":"20240613100014-qpegpcb","Type":"NodeParagraph","Properties":{"id":"20240613100014-qpegpcb","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：贯众，苦寒沉降之质，故主邪热而能上血，并治血痢下血，甚有捷效，皆苦以燥湿、寒以泄热之功也。然气亦浓厚，故能解时邪热结之毒。《别录》除头风，专指风热言之，凡大头疫肿连耳目，用泄散而不遽应者，但加入贯众一味，即邪势透泄，而热解神清，不独苦寒泄降，亦气之足以散邪也。故时疫盛行，宜侵入水缸中，常饮则不传染，而井中沉一枚，不犯百毒，则解毒之功，尤其独着，不得以轻贱而忽之。"}]},{"ID":"20240613100014-a4d5kuz","Type":"NodeParagraph","Properties":{"id":"20240613100014-a4d5kuz","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主腹中邪热气，诸毒，杀三虫。"}]},{"ID":"20240613100014-efo3ycg","Type":"NodeParagraph","Properties":{"id":"20240613100014-efo3ycg","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"6.《别录》：去寸白，破症瘕，除头风，止金疮。"}]},{"ID":"20240613100014-j8tvfoj","Type":"NodeParagraph","Properties":{"id":"20240613100014-j8tvfoj","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"7.《本草图经》：止鼻衄。"}]},{"ID":"20240613100014-3ttfz0i","Type":"NodeParagraph","Properties":{"id":"20240613100014-3ttfz0i","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"8.《滇南本草》：祛毒，止血，解水毒。"}]},{"ID":"20240613100014-vu7mr6y","Type":"NodeParagraph","Properties":{"id":"20240613100014-vu7mr6y","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"9.《纲目》：治下血崩中，带下，产后血气胀痛，斑疹毒，漆毒，骨哽。"}]},{"ID":"20240613100014-vz3xg5u","Type":"NodeParagraph","Properties":{"id":"20240613100014-vz3xg5u","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"10.《会约医镜》：治邪热腹痛，解时行疫气。"}]},{"ID":"20240613100014-v243f48","Type":"NodeParagraph","Properties":{"id":"20240613100014-v243f48","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"11.《本经续疏》：治喉痹，消顽肿。"}]},{"ID":"20240613100014-pd73mhc","Type":"NodeParagraph","Properties":{"id":"20240613100014-pd73mhc","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"12.《东北常用中草药手册》：驱虫，止血，清热解毒。治蛔虫，绦虫，虫积腹痛；子宫功能性出血，白带。贯众放在水缸中，饮用其水，预防流行性感冒、感冒、流行性脑脊髓膜炎、麻疹。"}]},{"ID":"20240613100014-uof455t","Type":"NodeParagraph","Properties":{"id":"20240613100014-uof455t","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"13.《陕西中草药》：清热解毒，止血杀虫。预防流行性乙型脑炎、流行性腮腺炎等传染病。治便血、尿血、鼻衄、月经过多、蛔虫症、蛲虫症。"}]},{"ID":"20240613100014-g961gyw","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613100014-g961gyw","updated":"20240613100014"},"Children":[{"ID":"20240613100014-ltgjbtc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTQu","Num":14},"Properties":{"id":"20240613100014-ltgjbtc","updated":"20240613100014"},"Children":[{"ID":"20240613100014-5t3sc0w","Type":"NodeParagraph","Properties":{"id":"20240613100014-5t3sc0w","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"金华《常用中草药单方验方选编》：祛风活血，补肝肾。治风寒湿痹，腰膝酸痛，遗尿。"}]}]}]},{"ID":"20240613100014-gxobg1o","Type":"NodeParagraph","Properties":{"id":"20240613100014-gxobg1o","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613100014-yed4nnr","Type":"NodeParagraph","Properties":{"id":"20240613100014-yed4nnr","updated":"20240613100014"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613100017-ldwl4nb","Type":"NodeThematicBreak","Properties":{"id":"20240613100017-ldwl4nb"}},{"ID":"20240613100017-8jn3gy4","Type":"NodeParagraph","Properties":{"id":"20240613100017-8jn3gy4"}}]}