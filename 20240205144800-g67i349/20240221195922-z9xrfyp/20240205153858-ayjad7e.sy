width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芍药 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芍药 8-20240813164831-4fpkgvn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240624143731-n1ctwfo","Type":"NodeParagraph","Properties":{"id":"20240624143731-n1ctwfo","updated":"20240813165713"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芍药 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芍药 11-20240813165459-txa0n57.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813170706-lbhatid","Type":"NodeParagraph","Properties":{"id":"20240813170706-lbhatid","updated":"20240813170706"}},{"ID":"20240205165524-ml0n9cp","Type":"NodeParagraph","Properties":{"id":"20240205165524-ml0n9cp","updated":"20240205165526"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"赤芍"}]},{"ID":"20240206082337-3py140z","Type":"NodeParagraph","Properties":{"id":"20240206082337-3py140z","updated":"20240206082342"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产东北、内蒙古等地。\n【性状】\t该品呈圆柱形，稍弯曲，长540cm，直径0.53cm。表面棕褐色，粗糙，有纵沟及皱纹，并有须根痕及横向凸起的皮孔，有的外皮易脱落。质硬而脆，易折断，断面粉白色或粉红色，皮部窄，木部放射状纹理明显，有的有裂隙。气微香，味微苦、酸涩。\n【性味】\t苦，微寒。\n【功效】\t清热凉血、散瘀止痛的功能。生赤芍以清热凉血力胜。多用于温病热入血分的身热出血，目赤肿痛，痈肿疮毒。\n【注解】\t“糟皮粉碴”：指赤芍外皮薄，疏松易剥落，断面白色泛红，呈粉性。\n“菊花心”：药材断面形如菊花的放射状纹理。"}]},{"ID":"20240206082330-s4mz69w","Type":"NodeParagraph","Properties":{"id":"20240206082330-s4mz69w","updated":"20240206082330"},"Childr