813100009-c9edp76.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 643px;\" parent-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621171334-dbu7yh9","Type":"NodeParagraph","Properties":{"id":"20240621171334-dbu7yh9","updated":"20240815112906"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：根据网上较普遍的说法，败酱一般常用的是黄花败酱和白花败酱（真正的败酱草一般指黄花败酱）；"}]},{"ID":"20240611155431-s5mjl45","Type":"NodeThematicBreak","Properties":{"id":"20240611155431-s5mjl45"}},{"ID":"20240611155432-udcho1m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155432-udcho1m","updated":"20240611155437"},"Children":[{"Type":"NodeText","Data":"败酱《神农本草经》"}]},{"ID":"20240611155432-a6at33o","Type":"NodeParagraph","Properties":{"id":"20240611155432-a6at33o","updated":"20240611155432"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240611155432-w66iy2p","Type":"NodeParagraph","Properties":{"id":"20240611155432-w66iy2p","updated":"20240611155432"},"Children":[{"Type":"NodeText","Data":"主暴热火创，赤气，疥搔，疸痔，马鞍，热气。一名鹿肠。生川谷。"}]},{"ID":"20240611155432-9y5e2fa","Type":"NodeParagraph","Properties":{"id":"20240611155432-9y5e2fa","updated":"20240611155432"},"Children":[{"Type":"NodeText","Data":"《名医》曰：“一名鹿首，一名马草，一名泽败，生江夏，八月采根曝干。"}]},{"ID":"20240611155432-6cisj4z","Type":"NodeParagraph","Properties":{"id":"20240611155432-6cisj4z","updated":"20240611155432"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：败酱出三辅。陶宏景云：气如败酱。故以为名。"}]},{"ID":"20240611155038-v1z3gil","Type":"NodeThematicBreak","Properties":{"id":"20240611155038-v1z3gil"}},{"ID":"20240611155059-0t08b5a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155059-0t08b5a","updated":"20240611155106"},"Children":[{"Type":"NodeText","Data":"败酱《本草纲目》"}]},{"ID":"20240611155059-gvr0jj2","Type":"NodeParagraph","Properties":{"id":"20240611155059-gvr0jj2","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"「释名」苦菜、泽败、鹿肠、鹿首、马草。"}]},{"ID":"20240611155059-n42rd51","Type":"NodeParagraph","Properties":{"id":"20240611155059-n42rd51","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、平、无毒。"}]},{"ID":"20240611155059-qe27h9c","Type":"NodeParagraph","Properties":{"id":"20240611155059-qe27h9c","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611155059-y722qra","Type":"NodeParagraph","Properties":{"id":"20240611155059-y722qra","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"1、腹痈有脓。用薏苡仁十分、附子二分、败酱五分，共捣为末。每取一匙，加水二升，煎成一升，一次服下。"}]},{"ID":"20240611155059-5blft68","Type":"NodeParagraph","Properties":{"id":"20240611155059-5blft68","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"2、产后恶露。用败酱、当归各六分，续断、芍药八分，芎穷、竹茹各四分，生地黄（炒）十二分，加水二升煮成八合，空心服下。"}]},{"ID":"20240611155059-s3fwh16","Type":"NodeParagraph","Properties":{"id":"20240611155059-s3fwh16","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"3、产后腹痛。用败酱五两，加水四升，煮成二升，每服二合，一天服三次。"}]},{"ID":"20240611155059-ss8nc3j","Type":"NodeParagraph","Properties":{"id":"20240611155059-ss8nc3j","updated":"20240611155059"},"Children":[{"Type":"NodeText","Data":"4、蠼螋尿疮。用败酱煎汁涂搽，有效。"}]},{"ID":"20240611155503-uii30cd","Type":"NodeThematicBreak","Properties":{"id":"20240611155503-uii30cd"}},{"ID":"20240611155504-h4uneeb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155504-h4uneeb","updated":"20240611155508"},"Children":[{"Type":"NodeText","Data":"败酱《得配本草》"}]},{"ID":"20240611155504-8xxu6oq","Type":"NodeParagraph","Properties":{"id":"20240611155504-8xxu6oq","updated":"20240611155504"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即苦菜"}]},{"ID":"20240611155504-zij53oi","Type":"NodeParagraph","Properties":{"id":"20240611155504-zij53oi","updated":"20240611155504"},"Children":[{"Type":"NodeText","Data":"苦，平。入足厥阴，兼入足阳明经。破血排脓。去疽痔，除痈肿。配米仁、附子，下腹痈。"}]},{"ID":"20240611155504-mtjxp5c","Type":"NodeParagraph","Properties":{"id":"20240611155504-mtjxp5c","updated":"20240611155504"},"Children":[{"Type":"NodeText","Data":"入四物，治恶露不止。"}]},{"ID":"20240611155452-3ulveuy","Type":"NodeThematicBreak","Properties":{"id":"20240611155452-3ulveuy"}},{"ID":"20240611155453-7upbs5o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155453-7upbs5o","updated":"20240611155459"},"Children":[{"Type":"NodeText","Data":"败酱《神农本草经赞》"}]},{"ID":"20240611155453-2v4s8jd","Type":"NodeParagraph","Properties":{"id":"20240611155453-2v4s8jd","updated":"20240611155453"},"Children":[{"Type":"NodeText","Data":"味苦平。主暴热火创。赤气疥搔。疽痔。马鞍热气。一名鹿肠。生川谷。"}]},{"ID":"20240611155453-b9h1a54","Type":"NodeParagraph","Properties":{"id":"20240611155453-b9h1a54","updated":"20240611155453"},"Children":[{"Type":"NodeText","Data":"丛生冈岭。败味含嘉。浅深菘叶。碎簇芹花。酸咸并具。甘苦交加。谓鹿呼马。命意纷拿。"}]},{"ID":"20240611155453-sw596v2","Type":"NodeParagraph","Properties":{"id":"20240611155453-sw596v2","updated":"20240611155453"},"Children":[{"Type":"NodeText","Data":"苏恭曰。此药多生冈岭间。陶弘景曰。根作陈败豆酱气故名。李时珍曰。初时叶布地似菘菜。"}]},{"ID":"20240611155453-3mltygb","Type":"NodeParagraph","Properties":{"id":"20240611155453-3mltygb","updated":"20240611155453"},"Children":[{"Type":"NodeText","Data":"叶绿色面深背浅。顶开白花成簇如芹花。根味微苦带甘。日华子曰。味酸。名医曰。咸微寒。一名鹿首。又名马草。史记纪。赵高谓鹿为马。庄子。呼我马也。而谓之马。朱子书。辩说纷拿。"}]},{"ID":"20240611155442-unpq5e4","Type":"NodeThematicBreak","Properties":{"id":"20240611155442-unpq5e4"}},{"ID":"20240611155443-mbbf3ut","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155443-mbbf3ut","updated":"20240611155446"},"Children":[{"Type":"NodeText","Data":"败酱《汤液本草》"}]},{"ID":"20240611155443-lynb4ni","Type":"NodeParagraph","Properties":{"id":"20240611155443-lynb4ni","updated":"20240611155443"},"Children":[{"Type":"NodeText","Data":"气微寒平，味苦、咸。无毒。"}]},{"ID":"20240611155443-jboj8jr","Type":"NodeParagraph","Properties":{"id":"20240611155443-jboj8jr","updated":"20240611155443"},"Children":[{"Type":"NodeText","Data":"入足少阴经，手厥阴经。"}]},{"ID":"20240611155443-sehspd9","Type":"NodeParagraph","Properties":{"id":"20240611155443-sehspd9","updated":"20240611155443"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主暴热火疮，赤气，疥瘙疽痔，马鞍热气。除痈肿，浮肿，结热，风痹不足，产后疾痛。"}]},{"ID":"20240611155443-pw5ief0","Type":"NodeParagraph","Properties":{"id":"20240611155443-pw5ief0","updated":"20240611155443"},"Children":[{"Type":"NodeText","Data":"仲景治肠痈有脓者，薏苡仁附子败酱汤。薏苡仁二十分，附子二分，败酱五分。三物为末。取方寸匕，以水二升，煎取一升，顿服之，小盒饭下，愈。"}]},{"ID":"20240611155321-k7bewol","Type":"NodeThematicBreak","Properties":{"id":"20240611155321-k7bewol"}},{"ID":"20240611155322-9ekift1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155322-9ekift1","updated":"20240611155326"},"Children":[{"Type":"NodeText","Data":"败酱《本草从新》"}]},{"ID":"20240611155322-773e34t","Type":"NodeParagraph","Properties":{"id":"20240611155322-773e34t","updated":"20240611155322"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、破血解毒．"}]},{"ID":"20240611155322-clduc8i","Type":"NodeParagraph","Properties":{"id":"20240611155322-clduc8i","updated":"20240611155322"},"Children":[{"Type":"NodeText","Data":"苦平．解毒排脓．治痈肿．破凝血．疗产后诸病．（时珍曰∶败酱乃手足阳明、厥阴药也、善排脓破血、故仲景治痈、及古方妇人科、产后腰痛腹痛等证多用之、后人不知用、盖未遇识者尔．）一名苦菜．用根苗．（杨氏疗乳方、治蠼 尿疮绕腰者、败酱煎汁、涂之甚良．）"}]},{"ID":"20240611155411-ebrk9ns","Type":"NodeThematicBreak","Properties":{"id":"20240611155411-ebrk9ns"}},{"ID":"20240611155413-c8lecxu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155413-c8lecxu","updated":"20240611155413"},"Children":[{"Type":"NodeText","Data":"败酱"}]},{"ID":"20240611155413-gap3dde","Type":"NodeParagraph","Properties":{"id":"20240611155413-gap3dde","updated":"20240611155419"},"Children":[{"Type":"NodeText","Data":"败酱，生江夏川谷，今江东亦有之，多生岗岭间。叶似水茛及薇衔，丛生；花黄，根紫色，似柴胡，作陈败豆酱气，故以为名。八月采根，曝干用。张仲景治腹痈，腹有脓者，薏苡仁附子败酱汤。薏苡仁十分，附子二分，败酱五分，三物捣为末，取方寸匕，以水二升，煎取一升，顿服之，小盒饭下，愈。"}]},{"ID":"20240611155358-0xaz2x5","Type":"NodeThematicBreak","Properties":{"id":"20240611155358-0xaz2x5"}},{"ID":"20240611155359-pm5izks","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155359-pm5izks","updated":"20240611155405"},"Children":[{"Type":"NodeText","Data":"败酱《本草崇原》"}]},{"ID":"20240611155359-o24ctdx","Type":"NodeParagraph","Properties":{"id":"20240611155359-o24ctdx","updated":"20240611155359"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主治暴热火疮赤气，疥瘙，疽痔，马鞍热气。"}]},{"ID":"20240611155359-nb2motb","Type":"NodeParagraph","Properties":{"id":"20240611155359-nb2motb","updated":"20240611155359"},"Children":[{"Type":"NodeText","Data":"（败酱俗名苦菜，处处原野皆有。春初生苗，深冬始凋，野人多食之。）"}]},{"ID":"20240611155359-pug0i20","Type":"NodeParagraph","Properties":{"id":"20240611155359-pug0i20","updated":"20240611155359"},"Children":[{"Type":"NodeText","Data":"败酱味苦性寒，故主治暴热火疮赤气，而疥瘙疽痔，马鞍热气，皆为火热之病。马者，火之畜也。《金匮》方有薏苡附子败酱散，亦主肠痈而消热毒。"}]},{"ID":"20240611155331-mtdqmje","Type":"NodeThematicBreak","Properties":{"id":"20240611155331-mtdqmje"}},{"ID":"20240611155332-weu0fg8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155332-weu0fg8","updated":"20240611155339"},"Children":[{"Type":"NodeText","Data":"败酱《本草便读》"}]},{"ID":"20240611155332-dw06oc1","Type":"NodeParagraph","Properties":{"id":"20240611155332-dw06oc1","updated":"20240611155332"},"Children":[{"Type":"NodeText","Data":"排脓消肿．肠痈藉辛苦之功．达胃行肝．瘀热仗咸寒之力．（败酱辛苦咸微寒．一名苦菜．叶如芥．其色青紫．能入血分．散血中瘀留结热．入手足阳明厥阴．金匮用之治肠痈．亦取其排脓破血之意．）"}]},{"ID":"20240611155347-kagj8ne","Type":"NodeThematicBreak","Properties":{"id":"20240611155347-kagj8ne"}},{"ID":"20240611155348-zu5mu0n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155348-zu5mu0n","updated":"20240611155352"},"Children":[{"Type":"NodeText","Data":"败酱《本草分经》"}]},{"ID":"20240611155348-uxah0kb","Type":"NodeParagraph","Properties":{"id":"20240611155348-uxah0kb","updated":"20240611155348"},"Children":[{"Type":"NodeText","Data":"即苦菜，苦咸微寒，入心包肾，主暴热火疮疥痔，除痈肿结热风痹，为治肠痈之上药。"}]},{"ID":"20240611155259-e79o8jk","Type":"NodeThematicBreak","Properties":{"id":"20240611155259-e79o8jk"}},{"ID":"20240611155300-w2f2yoz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155300-w2f2yoz","updated":"20240611155315"},"Children":[{"Type":"NodeText","Data":"败酱《本草乘雅半偈》"}]},{"ID":"20240611155300-0opmdq5","Type":"NodeParagraph","Properties":{"id":"20240611155300-0opmdq5","updated":"20240611155300"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240611155300-lbwvx05","Type":"NodeParagraph","Properties":{"id":"20240611155300-lbwvx05","updated":"20240611155300"},"Children":[{"Type":"NodeText","Data":"【气味】苦平，无毒。"}]},{"ID":"20240611155300-3avw5sp","Type":"NodeParagraph","Properties":{"id":"20240611155300-3avw5sp","updated":"20240611155300"},"Children":[{"Type":"NodeText","Data":"【主治】暴热，火疮赤气，疥瘙疽痔，马鞍热气。"}]},{"ID":"20240611155300-bgo93xt","Type":"NodeParagraph","Properties":{"id":"20240611155300-bgo93xt","updated":"20240611155300"},"Children":[{"Type":"NodeText","Data":"【核】曰∶败酱，一名苦菜。又名苦蕺，苦蕺同酸酱名，酸酱叶则高硕也。亦与苦贾、龙葵同名，种类则迥别矣。生江夏川谷，所在溪涧近水处亦有之。春初嫩苗塌地，似松菜叶，略狭长，面深背浅，有锯齿。采作菜蔬，漂去苦味，有陈酱气。三月茎渐高，数寸一节，节间生叶，各起小枝，四散如伞，高三四尺。入夏白花成簇，根白紫，八月采取，曝干用。"}]},{"ID":"20240611155300-sjk9a97","Type":"NodeParagraph","Properties":{"id":"20240611155300-sjk9a97","updated":"20240611155300"},"Children":[{"Type":"NodeText","Data":"【 】曰∶诠名败酱，烹之色臭相似，形脏腹肠之所需也。气平味苦，盖炎上作苦，苦性走下苦肃肤腠，苦浓肠胃，平则无过不及矣。因名苦菜，月令小满，苦菜秀，白花整密敷布如盖。夏三月，此谓蕃秀，若所爱在外，犹夏日在肤，泛泛乎，若万物之有余也。盖夏火主时，金遇庚伏，而乃白花金布，抑秉制为用，制则化生欤。故从治暴热，火疮赤气，焦烁肺金肤皮形脏，而为疥瘙疽痔，马鞍热气者。热解则清而愈，此即点火成金，不烦另觅种子矣。仲景先生用治肠痈之为病，其身甲错，腹皮急，按之濡，如肿状，腹无积聚，身无大热，脉数，此为腹内有痈脓。不独焦烁肺金之形脏，并毁败腑配之大肠。金至斯坚，将来者进，成功者退，理势然也。"}]},{"ID":"20240611155247-3l61a8a","Type":"NodeThematicBreak","Properties":{"id":"20240611155247-3l61a8a"}},{"ID":"20240611155249-12infas","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155249-12infas","updated":"20240611155253"},"Children":[{"Type":"NodeText","Data":"败酱《新修本草》"}]},{"ID":"20240611155249-0htxo1r","Type":"NodeParagraph","Properties":{"id":"20240611155249-0htxo1r","updated":"20240611155249"},"Children":[{"Type":"NodeText","Data":"味苦、咸，平、微寒，无毒。主暴热火疮赤气，疥瘙，疽痔，马鞍热气。除痈肿，浮肿，结疾痛。一名鹿肠，一名鹿首，一名马草，一名泽败。生江夏川谷。八月采根，曝干。"}]},{"ID":"20240611155249-uhqj40j","Type":"NodeParagraph","Properties":{"id":"20240611155249-uhqj40j","updated":"20240611155249"},"Children":[{"Type":"NodeText","Data":"出近道，叶似 ，根形似柴胡，气如败豆酱，故以为名。"}]},{"ID":"20240611155249-sxa3n3d","Type":"NodeParagraph","Properties":{"id":"20240611155249-sxa3n3d","updated":"20240611155249"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药不出近道，多生岗岭间。叶似水莨及薇衔，丛生，花黄，根紫，作陈酱色，其叶殊不似 也。"}]},{"ID":"20240611155234-s01b71r","Type":"NodeThematicBreak","Properties":{"id":"20240611155234-s01b71r"}},{"ID":"20240611155235-nsg3hmj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155235-nsg3hmj","updated":"20240611155243"},"Children":[{"Type":"NodeText","Data":"败酱《证类本草》"}]},{"ID":"20240611155235-ulncqqo","Type":"NodeParagraph","Properties":{"id":"20240611155235-ulncqqo","updated":"20240611155235"},"Children":[{"Type":"NodeText","Data":"味苦、咸，平、微寒，无毒。主暴热火疮赤气，疥瘙，疽痔，马鞍热气，除痈肿，浮肿，结热，风痹不足，产后疾痛。一名鹿肠，一名鹿首，一名马草，一名泽败。生江夏川谷。八月采根，曝干。"}]},{"ID":"20240611155235-dztpw6m","Type":"NodeParagraph","Properties":{"id":"20240611155235-dztpw6m","updated":"20240611155235"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶出近道，叶似 ，根形似茈胡，气如败豆酱，故以为名。唐本注云∶此药不出近道，多生岗岭间。叶似水莨及薇衔，丛生，花黄根紫，作陈酱色，其叶殊不似 也。臣禹锡等谨按药性论云∶鹿酱，臣，败酱是也。味辛、苦，微寒。治毒风 痹，主破多年凝血，能化脓为水及产后诸病，止腹痛，余疹烦渴。日华子云∶味酸。治赤眼障膜， 肉， 耳，血气心腹痛，破症结，产前后诸疾，催生落胞，血晕，排脓，补 ，鼻洪，吐血，赤白带下，疮痍疥癣，丹毒。又名酸益。七、八、十月采。"}]},{"ID":"20240611155235-o7w0whf","Type":"NodeParagraph","Properties":{"id":"20240611155235-o7w0whf","updated":"20240611155235"},"Children":[{"Type":"NodeText","Data":"图经曰∶败酱，生江夏川谷，今江东亦有之，多生岗岭间。叶似水莨及薇衔，丛生，花黄根紫色，似柴胡，作陈败豆酱气，故以为名。八月采根，曝干用。张仲景治腹痈，腹有脓者。薏苡仁附子败酱汤∶薏苡仁十分，附子二分，败酱五分，三物捣为末，取方寸匕，以水二升，煎取一升，顿服之。小盒饭下，愈。"}]},{"ID":"20240611155235-cw79sob","Type":"NodeParagraph","Properties":{"id":"20240611155235-cw79sob","updated":"20240611155235"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，收得后便粗杵，入甘草叶相拌对蒸，从巳至未，出，焙干，去甘草叶，取用。杨氏产乳∶治蠼 尿绕腰者。煎败酱汁涂之，瘥。"}]},{"ID":"20240611155220-nayvcwt","Type":"NodeThematicBreak","Properties":{"id":"20240611155220-nayvcwt"}},{"ID":"20240611155222-h6f8exh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155222-h6f8exh","updated":"20240611155230"},"Children":[{"Type":"NodeText","Data":"败酱《本草择要纲目》"}]},{"ID":"20240611155222-2uzxcy1","Type":"NodeParagraph","Properties":{"id":"20240611155222-2uzxcy1","updated":"20240611155222"},"Children":[{"Type":"NodeText","Data":"（一名苦菜．根苗同．）"}]},{"ID":"20240611155222-19roxhh","Type":"NodeParagraph","Properties":{"id":"20240611155222-19roxhh","updated":"20240611155222"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611155222-tv3aosh","Type":"NodeParagraph","Properties":{"id":"20240611155222-tv3aosh","updated":"20240611155222"},"Children":[{"Type":"NodeText","Data":"苦平无毒．"}]},{"ID":"20240611155222-g4efxr4","Type":"NodeParagraph","Properties":{"id":"20240611155222-g4efxr4","updated":"20240611155222"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611155222-4z847t8","Type":"NodeParagraph","Properties":{"id":"20240611155222-4z847t8","updated":"20240611155222"},"Children":[{"Type":"NodeText","Data":"暴热火疮赤气．疥瘙疽痔．马鞍热气．除痈肿浮肿结热风 痹．破多年凝血．能化脓为水．产后诸病．止腹痛余疹烦渴．治血气心腹痛．破症结．催生落胞．血运鼻衄吐血．赤白带下．赤眼障膜 肉． 耳疮疖疥癣丹毒．排脓补 ．败酱乃手足阳明厥阴药也．善排脓破血．故仲景治痈及古方妇人科皆用之．乃易得之物．而后人不知用．盖未遇识者耳．"}]},{"ID":"20240611155208-wygbpol","Type":"NodeThematicBreak","Properties":{"id":"20240611155208-wygbpol"}},{"ID":"20240611155209-s1hbns2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155209-s1hbns2","updated":"20240611155212"},"Children":[{"Type":"NodeText","Data":"败酱《医学入门》"}]},{"ID":"20240611155209-fyusmx2","Type":"NodeParagraph","Properties":{"id":"20240611155209-fyusmx2","updated":"20240611155209"},"Children":[{"Type":"NodeText","Data":"败酱苦咸化脓水，肠痈痔 能消补，逐瘀破 祛痹风，最益妇人陈良甫。"}]},{"ID":"20240611155209-7jiuep0","Type":"NodeParagraph","Properties":{"id":"20240611155209-7jiuep0","updated":"20240611155209"},"Children":[{"Type":"NodeText","Data":"出近道。叶似 ，丛生，花黄，根似柴胡，色紫，作陈败豆酱气。微寒，无毒。能化脓为水。消肠痈，补痔 ，一切疮痍疥癣，丹毒暴热，火疮赤气，马鞍热气，除痈肿、浮肿、结热，破多年凝血，消 结，治风毒、痿痹。陈良甫云∶即苦荠菜，最益妇人。治血气心痛，赤白带下，催生落胎，产后血晕，烦渴腹痛，胎前后诸病，皆治之。兼治赤眼，障目 肉， 耳，鼻洪吐血。八月采根，干，日锉碎，和甘草叶相拌，蒸半日，去甘草晒用。"}]},{"ID":"20240611155157-w5bb38n","Type":"NodeThematicBreak","Properties":{"id":"20240611155157-w5bb38n"}},{"ID":"20240611155158-ijf2ds7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155158-ijf2ds7","updated":"20240611155203"},"Children":[{"Type":"NodeText","Data":"败酱《千金翼方》"}]},{"ID":"20240611155158-156hr2u","Type":"NodeParagraph","Properties":{"id":"20240611155158-156hr2u","updated":"20240611155158"},"Children":[{"Type":"NodeText","Data":"味苦咸，平，无毒。主曝热火疮，赤气，疥瘙疽痔，马鞍热气。除痈肿，浮肿，结热，风痹不足，产后腹痛。一名鹿肠，一名鹿首，一名马草，一名泽败。生江夏川谷，八月采根，曝干。"}]},{"ID":"20240611155038-cc9cssj","Type":"NodeThematicBreak","Properties":{"id":"20240611155038-cc9cssj"}},{"ID":"20240611155039-icobqti","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155039-icobqti","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：败酱"}]},{"ID":"20240611155039-g8yogqt","Type":"NodeParagraph","Properties":{"id":"20240611155039-g8yogqt","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611155039-2w0ni27","Type":"NodeParagraph","Properties":{"id":"20240611155039-2w0ni27","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" Bài Jiànɡ"}]},{"ID":"20240611155039-ts2uvrb","Type":"NodeParagraph","Properties":{"id":"20240611155039-ts2uvrb","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611155039-29atb2d","Type":"NodeParagraph","Properties":{"id":"20240611155039-29atb2d","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 鹿肠（《本经》），鹿首、马草、泽败（《别录》），鹿酱（《药性论》），酸益（《日华子本草》），苦菜、苦蘵（《纲目》），野苦菜（《植物名实图考》），苦猪菜（《江西中药》），苦斋公（《四川中药志》），豆豉草、豆渣草（《重庆草药》），白苦爹、苦苴（《闽东本草》）。"}]},{"ID":"20240611155039-o7sq7ey","Type":"NodeParagraph","Properties":{"id":"20240611155039-o7sq7ey","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611155039-92vsehx","Type":"NodeParagraph","Properties":{"id":"20240611155039-92vsehx","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611155039-xvj1uk0","Type":"NodeParagraph","Properties":{"id":"20240611155039-xvj1uk0","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611155039-veon8o7","Type":"NodeParagraph","Properties":{"id":"20240611155039-veon8o7","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 为败酱科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白花败酱"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄花败酱"},{"Type":"NodeText","Data":"或其近缘植物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带根全草"},{"Type":"NodeText","Data":"。一般多在夏季采收，将全株拔起，除去泥沙后晒干。"}]},{"ID":"20240611155039-unzb2uc","Type":"NodeParagraph","Properties":{"id":"20240611155039-unzb2uc","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611155039-r1ujzwy","Type":"NodeParagraph","Properties":{"id":"20240611155039-r1ujzwy","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 产于四川、江西、福建等地。"}]},{"ID":"20240611155039-vszes68","Type":"NodeParagraph","Properties":{"id":"20240611155039-vszes68","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611155039-lijm6cj","Type":"NodeParagraph","Properties":{"id":"20240611155039-lijm6cj","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" ①白花败酱，又名：胭脂麻。"}]},{"ID":"20240611155039-rgf6xyr","Type":"NodeParagraph","Properties":{"id":"20240611155039-rgf6xyr","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"多年生草本，高50～100厘米。根茎横卧或斜坐，有特殊的臭气，如腐败的酱味。茎直立，具倒生的白色粗毛，上部稍有分枝。叶对生；叶片卵形，长3～10厘米，宽1.5～5厘米，边缘具粗锯齿，或3裂而基部裂片很小，两面均有粗毛，先端尖锐，基部窄狭；下部叶有翼柄，上部叶近于无柄。聚伞花序多分枝，呈伞房状的圆锥花丛；花冠5裂，白色，筒部短，无距；雄蕊4；子房下位，3室，柱头头状。果实倒卵形，长约2毫米，背部有一小苞所成的圆翼，长宽各约5毫米。花期9月。"}]},{"ID":"20240611155039-tkjtz5s","Type":"NodeParagraph","Properties":{"id":"20240611155039-tkjtz5s","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"生长于山坡草地及路旁。全国大部地区均有分布。"}]},{"ID":"20240611155039-eb56qsw","Type":"NodeParagraph","Properties":{"id":"20240611155039-eb56qsw","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"②黄花败酱，又名：黄花龙牙、野黄花、野芹、山白菜、黄花草、鸡肠子草。"}]},{"ID":"20240611155039-237p7np","Type":"NodeParagraph","Properties":{"id":"20240611155039-237p7np","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"多年生草本。形与上种相似，惟根生叶卵状披针形，有长柄；茎生叶具短柄或近无柄，叶片羽状全裂，上方的叶片较大，裂片5～11，披针形，先端渐尖、锐尖，边缘具不整齐的大锯齿，两面无毛或被白色刚毛。花黄色。果椭圆形，长2.5～3.5毫米，宽1.7～2.2毫米，不具翼状苞。花期7～9月。"}]},{"ID":"20240611155039-6ed2v96","Type":"NodeParagraph","Properties":{"id":"20240611155039-6ed2v96","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"生长于山坡草地。全国大部地区均有分布。"}]},{"ID":"20240611155039-2s87ute","Type":"NodeParagraph","Properties":{"id":"20240611155039-2s87ute","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611155039-gte04kc","Type":"NodeParagraph","Properties":{"id":"20240611155039-gte04kc","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 白花败酱的干燥全株，长短不等；根茎有节，上生须状细根。茎圆柱形，外表黄棕色或黄绿色，有纵向纹理，被有粗毛。质脆，易拆断，断面中空，白色。叶多皱缩、破碎，或已脱落。全株有陈腐的豆酱气，味苦。以干燥、叶多、气浓、无泥沙杂草者为佳。"}]},{"ID":"20240611155039-m9gwezi","Type":"NodeParagraph","Properties":{"id":"20240611155039-m9gwezi","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611155039-bl5hf5v","Type":"NodeParagraph","Properties":{"id":"20240611155039-bl5hf5v","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 白花败酱含有挥发油，干燥果枝含黑芥子甙等。根与根茎中含莫罗忍冬甙、番木鳖甙、白花败酱甙等。"}]},{"ID":"20240611155039-qpffs0w","Type":"NodeParagraph","Properties":{"id":"20240611155039-qpffs0w","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"黄花败酱根和根茎含齐墩果酸、常春藤皂甙元、β-谷甾醇-β-D-葡萄糖甙，多种皂甙中已知结构的有败酱皂甙C、D、C1、D1，黄花败酱皂甙A、B、C、D、E、F、G。根中尚含挥发油8％、生物碱。鞣质、淀粉。"}]},{"ID":"20240611155039-3uq557d","Type":"NodeParagraph","Properties":{"id":"20240611155039-3uq557d","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611155039-qntf96y","Type":"NodeParagraph","Properties":{"id":"20240611155039-qntf96y","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 入肝、胃、大肠经。"}]},{"ID":"20240611155039-nwolc62","Type":"NodeParagraph","Properties":{"id":"20240611155039-nwolc62","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足少阴、手厥阴经。\""}]},{"ID":"20240611155039-inft1qq","Type":"NodeParagraph","Properties":{"id":"20240611155039-inft1qq","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"手足阳明、厥阴。\""}]},{"ID":"20240611155039-lraawc9","Type":"NodeParagraph","Properties":{"id":"20240611155039-lraawc9","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611155039-nae0db1","Type":"NodeParagraph","Properties":{"id":"20240611155039-nae0db1","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240611155039-9uayes9","Type":"NodeParagraph","Properties":{"id":"20240611155039-9uayes9","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240611155039-rqyix6g","Type":"NodeParagraph","Properties":{"id":"20240611155039-rqyix6g","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"咸，微寒，无毒。\""}]},{"ID":"20240611155039-frbo2ew","Type":"NodeParagraph","Properties":{"id":"20240611155039-frbo2ew","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味辛苦，微寒。\""}]},{"ID":"20240611155039-5rpdixk","Type":"NodeParagraph","Properties":{"id":"20240611155039-5rpdixk","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"微苦带甘。\""}]},{"ID":"20240611155039-sk4eo9s","Type":"NodeParagraph","Properties":{"id":"20240611155039-sk4eo9s","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611155039-ah0kwvr","Type":"NodeParagraph","Properties":{"id":"20240611155039-ah0kwvr","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：\"久病胃虚牌弱，泄泻不食之症，一切虚寒下脱之疾，咸忌之。\""}]},{"ID":"20240611155039-17sostb","Type":"NodeParagraph","Properties":{"id":"20240611155039-17sostb","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611155039-m4u2sk2","Type":"NodeParagraph","Properties":{"id":"20240611155039-m4u2sk2","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 清热解毒，排脓破瘀。治肠痈，下痢，赤白带下，产后瘀滞腹痛，目赤肿痛，痈肿疥癣。"}]},{"ID":"20240611155039-7uzx4ro","Type":"NodeParagraph","Properties":{"id":"20240611155039-7uzx4ro","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主暴热火疮、赤气，疥瘙疽痔，马鞍热气。\""}]},{"ID":"20240611155039-tlx2b49","Type":"NodeParagraph","Properties":{"id":"20240611155039-tlx2b49","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除痈肿，浮肿，结热，风痹不足，产后疾痛。\""}]},{"ID":"20240611155039-ade39ok","Type":"NodeParagraph","Properties":{"id":"20240611155039-ade39ok","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治毒风顽痹，主破多年瘀血，能化脓为水。及产后诸病。止腹痛余疹、烦渴。\""}]},{"ID":"20240611155039-qjcu1s4","Type":"NodeParagraph","Properties":{"id":"20240611155039-qjcu1s4","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治赤眼，障膜，胬肉，聤耳，血气心腹痛，破症结，产前后诸疾，催生、落胞，血运，排脓、补瘘，鼻洪吐血。赤白带下。疮痍疥癣，丹毒。\""}]},{"ID":"20240611155039-fpd8qoz","Type":"NodeParagraph","Properties":{"id":"20240611155039-fpd8qoz","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"⑤《现代实用中药》：\"治肠炎下痢。\""}]},{"ID":"20240611155039-wswhrhb","Type":"NodeParagraph","Properties":{"id":"20240611155039-wswhrhb","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611155039-9ybmv58","Type":"NodeParagraph","Properties":{"id":"20240611155039-9ybmv58","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱（鲜者2～4两）。外用：捣敷。"}]},{"ID":"20240611155039-1w66ni4","Type":"NodeParagraph","Properties":{"id":"20240611155039-1w66ni4","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611155039-knbwfez","Type":"NodeParagraph","Properties":{"id":"20240611155039-knbwfez","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" ①治肠痈之为病，其身甲错，腹皮急，按之濡如肿状，腹无积聚，身无热，脉数，此为肠内有痈脓：薏苡仁十分，附子二分，败酱五分。上三味，杵为末，取方寸匕，以水二升，煎减半，顿服，小便当下。（《金匮要略》薏苡附子败酱散）"}]},{"ID":"20240611155039-zullfl3","Type":"NodeParagraph","Properties":{"id":"20240611155039-zullfl3","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"②治产后恶露七、八日不止：败酱、当归各六分，续断、芍药各八分，芎藭、竹茹各四分，生地黄（炒）十二分。水二升，煮取八合，空心服。（《外台》）"}]},{"ID":"20240611155039-dlon951","Type":"NodeParagraph","Properties":{"id":"20240611155039-dlon951","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"③治产后腰痛，乃气血流入腰腿，痛不可转者：败酱、当归各八分，芎藭、芍药、桂心各六分。水二升，煮八合，分二服。忌葱。（《广济方》）"}]},{"ID":"20240611155039-67bpve3","Type":"NodeParagraph","Properties":{"id":"20240611155039-67bpve3","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"④治产后腹痛如锥刺者：败酱草五两，水四升，煮二升，每服二合，日三服。（《卫生易简方》）"}]},{"ID":"20240611155039-y9pwt4o","Type":"NodeParagraph","Properties":{"id":"20240611155039-y9pwt4o","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"⑤治赤眼、障痛并胬肉攀睛：败酱一握，荆芥、草决明、木贼草各二钱，白蒺藜一钱五分。水煎服。（《硕虎斋省医语》）"}]},{"ID":"20240611155039-3nxspgz","Type":"NodeParagraph","Properties":{"id":"20240611155039-3nxspgz","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"⑥治痈疽肿毒，无论已溃未溃：鲜败酱草四两，地瓜酒四两。开水适量冲炖服。将渣捣烂，冬蜜调敷患处。"}]},{"ID":"20240611155039-v9zu1iq","Type":"NodeParagraph","Properties":{"id":"20240611155039-v9zu1iq","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"⑦治吐血：败酱草煎汤服。"}]},{"ID":"20240611155039-2pzowf7","Type":"NodeParagraph","Properties":{"id":"20240611155039-2pzowf7","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"⑧治赤白痢疾：鲜败酱草二两，冰糖五钱。开水炖服。"}]},{"ID":"20240611155039-rpvfm2a","Type":"NodeParagraph","Properties":{"id":"20240611155039-rpvfm2a","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"⑨治蛇咬：败酱草半斤，煎汤顿服。另用鲜败酱草杵细外敷。（⑥方以下出《闽东本草》）"}]},{"ID":"20240611155039-5c9m74e","Type":"NodeParagraph","Properties":{"id":"20240611155039-5c9m74e","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611155039-w6svvpa","Type":"NodeParagraph","Properties":{"id":"20240611155039-w6svvpa","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"治疗流行性腮腺炎:"},{"Type":"NodeText","Data":"取黄花败酱鲜叶适量，加生石膏0.5～1两共捣烂，再用1个鸭蛋清调匀，敷于肿痛处，24小时后取下。重者需敷2次。有并发症者加服20～50％黄花败酱草煎剂，每日3～4次，每次20～30毫升；或当茶饮。治疗200余例，90％的病例在局部敷药后24小时内症状消失，重症（包括有睾丸炎合并症的）患者在第2次敷药后一般症状也能消失。此外，本品对疖、痈、乳腺炎、淋巴管炎等也有效果。"}]},{"ID":"20240611155039-dlf80ly","Type":"NodeParagraph","Properties":{"id":"20240611155039-dlf80ly","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611155039-7gxtd7y","Type":"NodeParagraph","Properties":{"id":"20240611155039-7gxtd7y","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"败酱，善排脓破血，故仲景治痈，及古方妇人科皆用之。乃易得之物，而后人不知用，盖未遇识者耳。\""}]},{"ID":"20240611155039-o0axlhb","Type":"NodeParagraph","Properties":{"id":"20240611155039-o0axlhb","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"②《本草正义》：\"此草有陈腐气，故以败酱得名。能清热泄结，利水消肿，破瘀排脓。惟宜于实热之体。《本经》、《别录》、《药性论》、《日华子》诸书所载，无一非实热瘀滞之症。惟产后诸痛，当以瘀露作痛者为宜。而濒湖所引《别录》，竟作产后疾痛；《大明本草》又以产后诸病浑言之，则流弊良多，不可不知所辨别者也。\""}]},{"ID":"20240611155039-mou7dur","Type":"NodeParagraph","Properties":{"id":"20240611155039-mou7dur","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611155039-8lr4y7w","Type":"NodeParagraph","Properties":{"id":"20240611155039-8lr4y7w","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 据《本草》记载，败酱应为上述败酱科植物，但除四川、江西、安徽、福建等地使用外，大部分地区习惯上以菊科植物苣荬菜的带根全草和十字花科植物菥蓂的带果全草作败酱使用。前者习用于北方；后者习用于南方。参见\"苣荬菜\"和\"菥蓂\"条。"}]},{"ID":"20240611155039-oxtrvwe","Type":"NodeParagraph","Properties":{"id":"20240611155039-oxtrvwe","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611155039-ohjhfr5","Type":"NodeParagraph","Properties":{"id":"20240611155039-ohjhfr5","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611155039-dfdm2g5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155039-dfdm2g5","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"《中华本草》：败酱"}]},{"ID":"20240611155039-lodisn9","Type":"NodeParagraph","Properties":{"id":"20240611155039-lodisn9","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611155039-1zrayzi","Type":"NodeParagraph","Properties":{"id":"20240611155039-1zrayzi","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" Bài Jiànɡ"}]},{"ID":"20240611155039-ectfqnv","Type":"NodeParagraph","Properties":{"id":"20240611155039-ectfqnv","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611155039-j1zlmxb","Type":"NodeParagraph","Properties":{"id":"20240611155039-j1zlmxb","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 鹿肠、鹿首、马草、泽败、鹿酱、酸益、败酱草、苦菜、野苦菜；苦斋公；豆豇草；豆渣草；观音菜；白苦爹、苦苴、苦叶菜、萌菜、女郎花"}]},{"ID":"20240611155039-ibdi6ab","Type":"NodeParagraph","Properties":{"id":"20240611155039-ibdi6ab","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611155039-fx3vz7p","Type":"NodeParagraph","Properties":{"id":"20240611155039-fx3vz7p","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" Dahurian Patrinia Herb Whiteflower Patrinia Herb, Herb of Dahurian Patrinia, Herb of Whiteflower Patrinia, Patrinia scabiosaefolia Fisch., Patrinia villosa Juss."}]},{"ID":"20240611155039-uxov4ic","Type":"NodeParagraph","Properties":{"id":"20240611155039-uxov4ic","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611155039-n4tmtak","Type":"NodeParagraph","Properties":{"id":"20240611155039-n4tmtak","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611155039-xp0a1d1","Type":"NodeParagraph","Properties":{"id":"20240611155039-xp0a1d1","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"1.《吴普本草》：败酱，似桔梗，其臭如败豆酱。"}]},{"ID":"20240611155039-zyppkn7","Type":"NodeParagraph","Properties":{"id":"20240611155039-zyppkn7","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：败酱，生江夏川谷。八月采根，晒干。"}]},{"ID":"20240611155039-o93hlkj","Type":"NodeParagraph","Properties":{"id":"20240611155039-o93hlkj","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：败酱，出近道，叶似豨莶，根形似茈胡。"}]},{"ID":"20240611155039-0cql608","Type":"NodeParagraph","Properties":{"id":"20240611155039-0cql608","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"4.《唐本草》：败酱，不出近道，多生岗岭间，叶似水莨及薇衔，丛生，花黄，根紫作陈酱色；其叶殊不似豨莶也。"}]},{"ID":"20240611155039-lh12yom","Type":"NodeParagraph","Properties":{"id":"20240611155039-lh12yom","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611155039-pcm5rl7","Type":"NodeParagraph","Properties":{"id":"20240611155039-pcm5rl7","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 药材基源：为败酱科植物黄花败酱和白花败酱的全草。"}]},{"ID":"20240611155039-d5t1ypg","Type":"NodeParagraph","Properties":{"id":"20240611155039-d5t1ypg","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Patrinia scabiosaefolia Fisch. Ex Trev.2.Parinia uillosa (Thunb.) Juss.[Valeriana uillosa Thunb.]"}]},{"ID":"20240611155039-y41qzir","Type":"NodeParagraph","Properties":{"id":"20240611155039-y41qzir","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"采收和储藏：野生者夏、秋季采挖，栽培者可在当年开花前采收。洗净，晒干。"}]},{"ID":"20240611155039-m3fuggq","Type":"NodeParagraph","Properties":{"id":"20240611155039-m3fuggq","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611155039-ysq4u2u","Type":"NodeParagraph","Properties":{"id":"20240611155039-ysq4u2u","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山坡沟谷灌丛边、林缘草地或间湿草地。"}]},{"ID":"20240611155039-gxe9ycu","Type":"NodeParagraph","Properties":{"id":"20240611155039-gxe9ycu","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"2.生于海拔500-800m的荒山草地、林缘灌丛中。"}]},{"ID":"20240611155039-txu7ckp","Type":"NodeParagraph","Properties":{"id":"20240611155039-txu7ckp","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华涨、华东、华南以及四川、贵州。"}]},{"ID":"20240611155039-0m05f6l","Type":"NodeParagraph","Properties":{"id":"20240611155039-0m05f6l","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"2.分布于东北、华北、华东、华南和西南等地。"}]},{"ID":"20240611155039-wj4llxl","Type":"NodeParagraph","Properties":{"id":"20240611155039-wj4llxl","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611155039-q4h1eej","Type":"NodeParagraph","Properties":{"id":"20240611155039-q4h1eej","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 1.黄花败酱 多年生草本，高70-1300cm。地下根茎细长，横卧生，有特殖臭气。基生叶丛生，有长柄，花时叶枯落；茎生叶对生；柄长1-2cm，上部叶渐无柄；叶片2-3对羽状深裂，长5-15cm，中央裂片最大，椭圆形或卵形，两侧裂片窄椭圆形至线形，先端渐尖，叶缘有粗锯齿，两面疏被粗毛或无毛。聚伞状圆锥花序集成疏而大的伞房状花序，腋生或顶生；总花梗常仅相对两侧或仅一侧被粗毛，花序基部有线形总苞片1对，甚小；花直径约3mm；花萼短，萼齿5，不明显；花冠黄色，上部5裂，冠筒短，内侧具白色长毛；雄蕊4，与缘稍扁，由背部向两侧延展成窄翅状。花期7-9月，果期9-10月。"}]},{"ID":"20240611155039-088840i","Type":"NodeParagraph","Properties":{"id":"20240611155039-088840i","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"2.白花败酱 多年生草本，高50-100cm。根茎有特臭味；茎枝被粗白毛，后毛渐脱落。基生叶丛生；叶柄较叶片稍长；叶片宽卵形或近圆形，边缘粗锯齿；茎生叶对生；叶柄长1-3cm，上部地渐近无柄；叶片卵形、菱状卵形或窄椭圆形，长4-11cm，宽2-5cm，先端渐尖至窄长渐尖，基部楔形下延，叶2对羽状分裂，两面疏具糙伏毛或近无毛。聚伞圆锥花序，集成疏生大伞房关；总苞叶卵状披针形；花萼小，萼齿5，不明显；花冠白色，直径约5mm，冠筒短，先端5理解；雄蕊4，伸出；子房下位，花柱稍短于雄蕊。瘦果倒卵形，宿存苞片贴生、苞片近圆形，膜质，网脉明显。"}]},{"ID":"20240611155039-24vttdr","Type":"NodeParagraph","Properties":{"id":"20240611155039-24vttdr","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611155039-91m13gh","Type":"NodeParagraph","Properties":{"id":"20240611155039-91m13gh","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜稍湿润环境，耐亚寒，一般土地均可栽培，但以较肥活的砂持壤土为佳。"}]},{"ID":"20240611155039-oa1cirp","Type":"NodeParagraph","Properties":{"id":"20240611155039-oa1cirp","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖和分株繁殖。种子繁殖：春季3、4月在宽1m的苗床播种，条播，覆土0.5-1cm，播种后保持土壤湿润，约半个月左右出苗，出苗后当苗高3-6cm时可间苗1次，5月或6月初可移植大田。分株繁殖：4-5月挖取老株，或将老株四周自生的幼苗掘起进行移栽。行距为30-40cm，株距为25-30cm，每穴栽苗2-3株。"}]},{"ID":"20240611155039-j8gxza5","Type":"NodeParagraph","Properties":{"id":"20240611155039-j8gxza5","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期间可施粪肥2-3次。"}]},{"ID":"20240611155039-alskrhi","Type":"NodeParagraph","Properties":{"id":"20240611155039-alskrhi","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611155039-7vdtv8g","Type":"NodeParagraph","Properties":{"id":"20240611155039-7vdtv8g","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）黄花败酱 全体常折迭成束。要命茎圆柱形，弯曲，长5-15cm，直径2-5mm，顶端粗达9mm；表面有栓皮，易脱落，紫棕色或暗棕色，节疏密不等，节上有芽痕及根痕；断面纤维性，中央具棕色“木心”。根长圆锥形或长圆柱形，长达10cm，直径1-4mm；表面有纵纹，断面黄白色。茎圆柱形，直径2-8mm；表面黄绿以或共同棕色，具纵棱及细纹理，有倒生粗毛。茎生叶多卷缩或破碎，两面疏被白毛，完整呈多羽状深裂或全裂，裂片5-11，边缘有锯齿；茎上部叶较小，常3裂。有限公司枝端有花序或果序；小花黄色。瘦果长椭圆形，无膜质翅状苞片。气特异，味微苦。"}]},{"ID":"20240611155039-mec6mqu","Type":"NodeParagraph","Properties":{"id":"20240611155039-mec6mqu","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"（2）白花败酱 根茎短，长约至10cm，有的具细长的匍匐茎，断面无棕色“木心”；茎光滑，直径可达1.1cm，完整叶卵形或长椭圆形，不裂或基部具1对小裂片；花白色；苞片膜质，多具2条主脉。"}]},{"ID":"20240611155039-ryd3elc","Type":"NodeParagraph","Properties":{"id":"20240611155039-ryd3elc","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根茎横切面：（1）黄花败酱 落皮层可见，厚壁细胞壁木化，断续排列成环。木栓层为多列木栓细胞。皮层较窗，有裂隙。韧皮部细胞小，壁薄。束间形成层有时一明显。木质部宽广，中部有10余列薄壁细胞线成的环带，细胞排列整齐，内侧或全部五带细胞栓化，含少数簇晶；环带外侧导管2-3成群散在，内侧导管单个散在或2-4成群径向排列，胞腔常含黄棕以物；木射线宽1-2列细胞。髓部薄壁细胞含草酸钙簇晶。老的根茎髓部常成空洞。薄壁细胞含淀粉粒。"}]},{"ID":"20240611155039-cxpdgoq","Type":"NodeParagraph","Properties":{"id":"20240611155039-cxpdgoq","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"（2）白花败酱 木质部中无薄壁细胞环带；髓部大；本吕薄壁细胞不含淀粉粒，草酸钙簇晶少见。"}]},{"ID":"20240611155039-89fjp2u","Type":"NodeParagraph","Properties":{"id":"20240611155039-89fjp2u","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611155039-b8sjcl0","Type":"NodeParagraph","Properties":{"id":"20240611155039-b8sjcl0","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 给小鼠灌服黄花败酱干浸膏24g（生药）/KG；观察48小时，未见不良反应。黄花龙芽精分别以320MG/KG、600MG/KG、1200MG/KG，即相当于人用量的400、700和1500倍，喂饲小鼠7日，未见异常。黄花败酱醇浸膏30g/kg，灌服，对小鼠有轻度呼吸抑制和轻度致泻作用。"}]},{"ID":"20240611155039-hd368p3","Type":"NodeParagraph","Properties":{"id":"20240611155039-hd368p3","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611155039-tthfcw5","Type":"NodeParagraph","Properties":{"id":"20240611155039-tthfcw5","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 黄花败酱根、根茎含败酱皂甙（patrino-side）[1，2]，败酱皂甙A1、B1、C1、D1、E、F、G、H、J、K、L[3]，根含黄花败酱皂甙（scabioside）A、B、C[4]、D、E、F、G[5]，齐墩果酸-3-O-α-L-吡喃阿拉伯糖甙（3-O-α-L-arabinopyranosyloleanolic acid），常春藤皂甙元-3-O-α-L-吡喃阿拉伯糖甙（3-O-α-L0arabinopyranosyl hederagenin），常春藤皂甙元-2-O-乙酰基-3-O-α-L-吡喃阿拉伯糖甙（2-O-acetyl-3-O-α-L-arabinopyranosylhederagenin）[6]，常春藤皂甙元-3-O-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[3-O-α-L-glucopyranoside]，常春藤皂甙元-（2-O-乙酰基-3-O-α-L-吡喃阿拉伯糖基）-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[2-O-acetyl-3-O-α-L-ara-binopyranosyl hederagenin-28-O-β-D-glucopyranosyl(1→6)-β-D-glucopyranoside]，齐墩果酸-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-rhamnopyranosyl(1→2)-α-L-吡喃阿拉伯糖甙[3-O-β-D-glucopyra-nosyl(1→3)-α-L-rhamnopyranosyl(1→2)-α-L-arabinopyranosyl oleanolic acid]，齐墩果酸-3-O-β-D-吡喃葡萄糖基（1→2）-α-L-arabinopyranosyl oleanolic acid]，齐墩果酸-3-O-β-D-吡喃葡萄糖基（1→3）-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[3-O-β-D-glucopyranosyl(1→3)-α-L-rhamnopyranosyl(→2)-α-L-arabinopyranosyl oleanolic acid-28-O-β-D-glucopyranosyl(1→6)-β-D-glucopyranoside][7]，齐墩果酸-3-O-α-L-吡喃鼠了糖基（1→2）-α-L-吡喃阿拉伯糖甙[3-O-α-L-rhamnopyranosyl()1→2]-α-L-arabinopyranosyl oleanolic acid]，常春藤皂甙元-3-O-α-D-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖甙[3-O-α-L-rhamnopyranosyl(1→2)-α-L-arabinopyranoyl hedera-genin][8],齐墩果酸（oleanolic acid），常春藤皂甙元（hederage-nin），β-谷甾醇-β-D-吡喃葡萄糖甙（β-sitosterol-β-D-glucopyra-noside）[4]，菜油甾醇-D-葡萄糖甙（campesterol-D-glucoside）[6]，东莨菪素（scopoletin），马栗树皮素（esculotin）[8]，还含挥发油（约8%）。"}]},{"ID":"20240611155039-dhpdxcm","Type":"NodeParagraph","Properties":{"id":"20240611155039-dhpdxcm","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"种子含硫酸败酱皂甙（sulfapatrinoside）Ⅰ、Ⅱ[10]，熊果酸-3-O-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖甙即败酱糖甙A-I[3-O-α--L-rhamnopyranosyl(1→2)-α-L-rarbinopyranosyhursolic acid,patrinia -glycoside A I]，齐墩果酸-3-O-α-L-吡喃鼠李糖基（1→2）α-L-吡喃阿拉伯糖甙，熊果酸-3-O-β-D-吡喃葡萄糖基（1→3）α-O-吡喃阿拉伯糖甙[3-O-β-D-glucopyranosyl(1→3)-α-L-ara-binopyranosylursolic acid]，齐墩果酸-3-O-β-D-吡喃葡萄糖基（1→3）α-L-吡喃阿拉伯糖基[3-O-β-D-glucopyranosyl(1→3)-α-L-ara-binopyranosyloleanoic acid]，熊果酸3-O-α-L-吡喃鼠李糖基（1→2）-[β-D-吡喃葡萄糖基（1→3）]-α-L-吡喃阿拉伯甙即败酱糖甙B-I"}]},{"ID":"20240611155039-8bakopy","Type":"NodeParagraph","Properties":{"id":"20240611155039-8bakopy","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611155039-jkrwoku","Type":"NodeParagraph","Properties":{"id":"20240611155039-jkrwoku","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 1.镇静作用：曾报道、东北产黄芪败酱有镇静作用，并认为其中所含皂甙为其有效成分。近年进一步研究证明黄花败酱的乙醇浸膏或挥发油口服，对小鼠都有明显镇静作用，且能增强戊巴比妥钠的催眠作用。而蒸去挥发油的药渣浸膏和总皂甙都镇静作用。在挥发油中主要起作用的是败酱烯和异败酱烯，异戊酸无镇静作用。败酱的镇静作用比同属植物缬草强一倍以上。"}]},{"ID":"20240611155039-4rdpvr0","Type":"NodeParagraph","Properties":{"id":"20240611155039-4rdpvr0","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用：败酱浸剂在体外对金黄色葡萄球菌，白色葡萄球菌、类白喉杆菌、肺炎杆菌、炭疽杆菌和破伤风杆菌则无作用。白花败酱全草的水煎液在鸡胚内对流感病毒的抑制作用亦不明显。"}]},{"ID":"20240611155039-sqefbue","Type":"NodeParagraph","Properties":{"id":"20240611155039-sqefbue","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"3.其他作用：败酱有促进肝细胞再生，防止肝细胞变性的作用。是否与其所含墩果酸有关，值得探讨。因为齐墩果酸对肝脏有保护作用。败酱根热水提取物500μg/ml对人子宫颈癌细胞的抑制率为100%，而对正常细胞则反有促进增殖的作用。"}]},{"ID":"20240611155039-3sac4pr","Type":"NodeParagraph","Properties":{"id":"20240611155039-3sac4pr","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"4.抗癌作用：败酱根的热水提取物腹腔注射给荷瘤小鼠（肉瘤-180）抑制癌细胞生长率为57.4%。"}]},{"ID":"20240611155039-4xh7vr2","Type":"NodeParagraph","Properties":{"id":"20240611155039-4xh7vr2","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611155039-ak9qlo4","Type":"NodeParagraph","Properties":{"id":"20240611155039-ak9qlo4","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 败酱草炭：取败酱草，置锅内，用中火炒至黑色，喷淋少许清水，灭尽火星，取出，凉透。"}]},{"ID":"20240611155039-0i6mqbx","Type":"NodeParagraph","Properties":{"id":"20240611155039-0i6mqbx","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611155039-30pzw7e","Type":"NodeParagraph","Properties":{"id":"20240611155039-30pzw7e","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末1g，加节馏水10ml，水浴加热10min，滤过。滤液置试管中，密塞，强烈振摇1min。黄花败酱泡沫15min消失，白花败酱泡沫很快消失。（检查皂甙）(2)取本品甲醇提取液1ml，范干，以1ml冰醋酸溶解残渣，加1ml醋酐-浓硫酸（19：1），混匀，稍加热。黄花败酱由黄变为紫红色，白花败酱由黄绿变为紫红色。（检查三萜皂甙）（3）取本品甲醇提取液数滴，点于白磁板上，滴加10%香荚兰醛浓硫酸溶液数滴。黄花败酱显蓝紫色，白花败酱显黄棕色。（检查押发油）"}]},{"ID":"20240611155039-xbf7573","Type":"NodeParagraph","Properties":{"id":"20240611155039-xbf7573","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611155039-easmcw0","Type":"NodeParagraph","Properties":{"id":"20240611155039-easmcw0","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 归肋；大肠；肝经"}]},{"ID":"20240611155039-tsbd1vg","Type":"NodeParagraph","Properties":{"id":"20240611155039-tsbd1vg","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611155039-htdnld9","Type":"NodeParagraph","Properties":{"id":"20240611155039-htdnld9","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性微寒"}]},{"ID":"20240611155039-5nkjpo7","Type":"NodeParagraph","Properties":{"id":"20240611155039-5nkjpo7","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611155039-q1qnrin","Type":"NodeParagraph","Properties":{"id":"20240611155039-q1qnrin","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：久病胃虚脾弱，泄泻不食之症，一切虚寒下脱之疾，咸忌之。"}]},{"ID":"20240611155039-iugd5ay","Type":"NodeParagraph","Properties":{"id":"20240611155039-iugd5ay","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611155039-zz9v2d9","Type":"NodeParagraph","Properties":{"id":"20240611155039-zz9v2d9","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 清热解毒；活血排脓。主肠痈；肺痈；痈肿；痢疾；产后瘀滞腹痛"}]},{"ID":"20240611155039-27oh6yg","Type":"NodeParagraph","Properties":{"id":"20240611155039-27oh6yg","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611155039-8x4kc3i","Type":"NodeParagraph","Properties":{"id":"20240611155039-8x4kc3i","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g。外用：鲜品适量，捣敷患处。"}]},{"ID":"20240611155039-6n1vfkr","Type":"NodeParagraph","Properties":{"id":"20240611155039-6n1vfkr","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"制剂"}]},{"ID":"20240611155039-bsdqewj","Type":"NodeParagraph","Properties":{"id":"20240611155039-bsdqewj","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 抗炎阑合剂；败酱片；舒眠片；郴州蛇药；白花败酱冲剂。"}]},{"ID":"20240611155039-lvjv836","Type":"NodeParagraph","Properties":{"id":"20240611155039-lvjv836","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611155039-l7fjghc","Type":"NodeParagraph","Properties":{"id":"20240611155039-l7fjghc","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 1.《本草纲目》：败酱，善排脓破血，故仲景治痈，及古方妇人科皆用之。乃易得之物，而后人不知用，盖未遇识者耳。"}]},{"ID":"20240611155039-uxjvtum","Type":"NodeParagraph","Properties":{"id":"20240611155039-uxjvtum","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"2.《本草正义》：此草有陈腐气，故以败酱得名。能清热泄结，利水消肿，破瘀排脓。惟宜于实热之体。《本经》、《别录》、《药性论》、《日华子》诸书所载，无一非实热瘀滞之症。惟产后诸痛，当以瘀露作痛者为宜。而濒湖所引《别录》，竟作产后疾痛；《大明本草》又以产后诸病浑言之，则流弊良多，不可不知所辨别者也。"}]},{"ID":"20240611155039-51onuxs","Type":"NodeParagraph","Properties":{"id":"20240611155039-51onuxs","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611155039-543r3i7","Type":"NodeParagraph","Properties":{"id":"20240611155039-543r3i7","updated":"20240611155039"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611155040-kcr816z","Type":"NodeThematicBreak","Properties":{"id":"20240611155040-kcr816z"}},{"ID":"20240611155041-1aulp9i","Type":"NodeParagraph","Properties":{"id":"20240611155041-1aulp9i"}}]}