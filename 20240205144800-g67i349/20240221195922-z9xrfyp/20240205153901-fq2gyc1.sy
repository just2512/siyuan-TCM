0815160430-bvrnwlm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 431px;\" parent-style=\"width: 441px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 776px;","style":"width: 766px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白鲜皮 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白鲜皮 14-20240815161634-otbf1mw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 766px;\" parent-style=\"width: 776px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240815160636-s1qt9q1","Type":"NodeParagraph","Properties":{"id":"20240815160636-s1qt9q1","updated":"20240815161424"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 711px;","style":"width: 701px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白鲜皮 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白鲜皮 3-20240815160203-6sely9f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 701px;\" parent-style=\"width: 711px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白鲜皮 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白鲜皮 12-20240815161424-mf3cgwm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611155959-o3xvpo5","Type":"NodeThematicBreak","Properties":{"id":"20240611155959-o3xvpo5"}},{"ID":"20240611160100-tq00b60","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611160100-tq00b60","updated":"20240611160105"},"Children":[{"Type":"NodeText","Data":"白鲜《神农本草经》"}]},{"ID":"20240611160100-qc4o0x7","Type":"NodeParagraph","Properties":{"id":"20240611160100-qc4o0x7","updated":"20240611160100"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240611160100-pw2m64f","Type":"NodeParagraph","Properties":{"id":"20240611160100-pw2m64f","updated":"20240611160100"},"Children":[{"Type":"NodeText","Data":"主头风，黄疸，咳逆，淋沥，女子阴中肿痛，湿痹死肌，不可屈伸，起止行步。生川谷。"}]},{"ID":"20240611160100-y9ptke9","Type":"NodeParagraph","Properties":{"id":"20240611160100-y9ptke9","updated":"20240611160100"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生上谷及冤句，四月五月，采根阴干。"}]},{"ID":"20240611160100-frprgex","Type":"NodeParagraph","Properties":{"id":"20240611160100-frprgex","updated":"20240611160100"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：俗呼为白羊鲜，气息正似羊膻或名白膻。"}]},{"ID":"20240611155959-qph572e","Type":"NodeThematicBreak","Properties":{"id":"20240611155959-qph572e"}},{"ID":"20240611160000-n8ftsxa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611160000-n8ftsxa","updated":"20240611160031"},"Children":[{"Type":"NodeText","Data":"白鲜皮《本草备要》"}]},{"ID":"20240611160000-7s17cc2","Type":"NodeParagraph","Properties":{"id":"20240611160000-7s17cc2","updated":"20240611160000"},"Children":[{"Type":"NodeText","Data":"白鲜皮（通，祛风湿。）"}]},{"ID":"20240611160000-wdq6old","Type":"NodeParagraph","Properties":{"id":"20240611160000-wdq6old","updated":"20240611160000"},"Children":[{"Type":"NodeText","Data":"气寒善行，味苦性燥，（行水故燥。）入脾胃，除湿热，兼入膀胱、小肠，行水道，通关节，利九窍，为诸黄风痹之要药。（一味白鲜皮汤，治产后风。时珍曰：世医止施之疮科，浅矣。）兼治风疮疥癣，女子阴中肿痛。（湿热乘虚客肾与膀胱所致。）"}]},{"ID":"20240611160000-ta5l2cv","Type":"NodeParagraph","Properties":{"id":"20240611160000-ta5l2cv","updated":"20240611160000"},"Children":[{"Type":"NodeText","Data":"根黄白而心实，取皮用。"}]},{"ID":"20240611160000-2x7e7k2","Type":"NodeParagraph","Properties":{"id":"20240611160000-2x7e7k2","updated":"20240611160000"},"Children":[{"Type":"NodeText","Data":"恶桑螵蛸、桔梗、茯苓、萆薢。"}]},{"ID":"20240611160012-1gcqabj","Type":"NodeThematicBreak","Properties":{"id":"20240611160012-1gcqabj"}},{"ID":"20240611160013-u7f7lgy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611160013-u7f7lgy","updated":"20240611160017"},"Children":[{"Type":"NodeText","Data":"白鲜《本草图经》"}]},{"ID":"20240611160013-qlbaeaq","Type":"NodeParagraph","Properties":{"id":"20240611160013-qlbaeaq","updated":"20240611160020"},"Children":[{"Type":"NodeText","Data":"白鲜，生上谷、川谷及冤句，今河中、江宁府、滁州、润州亦有之。"}]},{"ID":"20240611160013-97qwtpo","Type":"NodeParagraph","Properties":{"id":"20240611160013-97qwtpo","updated":"20240611160013"},"Children":[{"Type":"NodeText","Data":"苗高尺余，茎青，叶稍白，如槐，亦似茱萸；四月开花淡紫色，似小蜀葵；根似蔓菁，皮黄白而心实。四月、五月采根，阴干用。又云∶宜二月采，差晚则虚恶也。其气息都似羊膻，故俗呼为白羊鲜，又名地羊膻，又名金爵儿椒。其苗，山人以为菜茹。葛洪治鼠 已有口，脓血出者，白鲜皮煮汁服一升，当吐鼠子乃愈。李《兵部手集方》疗肺嗽，有白鲜皮汤方，甚妙。"}]},{"ID":"20240611155733-m2ctx9g","Type":"NodeThematicBreak","Properties":{"id":"20240611155733-m2ctx9g"}},{"ID":"20240611155805-9m9gh4r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155805-9m9gh4r","updated":"20240611155809"},"Children":[{"Type":"NodeText","Data":"白藓皮《本草思辨录》"}]},{"ID":"20240611155805-5nrhm11","Type":"NodeParagraph","Properties":{"id":"20240611155805-5nrhm11","updated":"20240611155805"},"Children":[{"Type":"NodeText","Data":"白藓之根作羊毡气，毡属风，宜治在下之风矣。而其根于四五月花开之后，即虚恶无用，是未花之前，其气上注必力，且采于二月风木司令，自于治头风极合。至味苦化燥，气寒已热，又能于湿热大展其用，治淋沥阴肿者，根走极下之验也。治黄胆湿痹者，皮走肌肉之验也。治四肢不安腹中大热饮水者，皮黄白入肺胃之验也。用之于湿热，不必挟风，用之于风，不必挟湿而必挟热，否则于是物无当矣。"}]},{"ID":"20240611155733-0f9sefs","Type":"NodeThematicBreak","Properties":{"id":"20240611155733-0f9sefs"}},{"ID":"20240611155753-yhobp8w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155753-yhobp8w","updated":"20240611155758"},"Children":[{"Type":"NodeText","Data":"白藓皮《本草求真》"}]},{"ID":"20240611155753-rkpx2mu","Type":"NodeParagraph","Properties":{"id":"20240611155753-rkpx2mu","updated":"20240611155753"},"Children":[{"Type":"NodeText","Data":"（山草）泻脾胃湿热"}]},{"ID":"20240611155753-a1bas3b","Type":"NodeParagraph","Properties":{"id":"20240611155753-a1bas3b","updated":"20240611155753"},"Children":[{"Type":"NodeText","Data":"白藓皮（专入脾胃）。味苦与咸。性寒无毒。盖阳明胃土喜燥恶湿。一有邪入。则阳被郁不伸而热生矣。有热自必有湿。湿淫则热益盛。而风更乘热至。相依为害。以致关节不通。九窍不利。见为风疮疥癣。毛脱疸黄。湿痹便结。溺闭阴肿。咳逆狂叫饮水种种等症。（诸症皆就湿热以论。）治宜用此苦泄寒咸之味。以为开关通窍。俾水行热除风息。而症自克平。（肘后治鼠 已破。出脓血。用白藓皮煮汁服一升。当吐若鼠子也。又陈延之治产后中风人虚不可服他药者。一物白藓皮汤温服。）奈世不察。猥以此为疮疡之外用。其亦未达本经主治之意耳！然此止可施于脾胃坚实之人。若使素属虚寒。切勿妄用。根黄白而心实者良。取皮用。恶桑螵蛸茯苓桔梗萆 。"}]},{"ID":"20240611155733-2sx18oq","Type":"NodeThematicBreak","Properties":{"id":"20240611155733-2sx18oq"}},{"ID":"20240611155734-koutf6w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155734-koutf6w","updated":"20240611155741"},"Children":[{"Type":"NodeText","Data":"白藓皮《本草便读》"}]},{"ID":"20240611155734-t8i0z7a","Type":"NodeParagraph","Properties":{"id":"20240611155734-t8i0z7a","updated":"20240611155734"},"Children":[{"Type":"NodeText","Data":"气寒善行．味苦能降．清脾胃之湿热．导水宣邪．治癣癞与疯疮．行皮达肺．（白藓皮苦寒．直清肺脾湿热下行．故本经能治女子淋沥．阴中肿痛等证．亦谓其下行而祛湿热也．肺主皮毛．脾主肌肉．肺脾之湿热清．则皮肉之疮疡可愈耳．功用不过如此．又此药味兼微咸．能行血分．然沉阴之性．若下部虚寒者．不可用之．且其根有膻浊之气．又易败胃．）"}]},{"ID":"20240611155555-ny3f4v5","Type":"NodeThematicBreak","Properties":{"id":"20240611155555-ny3f4v5"}},{"ID":"20240611155724-iqzkxxn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155724-iqzkxxn","updated":"20240611155729"},"Children":[{"Type":"NodeText","Data":"白鲜皮《本草从新》"}]},{"ID":"20240611155724-6t84geu","Type":"NodeParagraph","Properties":{"id":"20240611155724-6t84geu","updated":"20240611155724"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、祛风湿．"}]},{"ID":"20240611155724-j62rq16","Type":"NodeParagraph","Properties":{"id":"20240611155724-j62rq16","updated":"20240611155724"},"Children":[{"Type":"NodeText","Data":"气寒善行．味苦性燥．入脾胃．除湿热．兼入膀胱小肠．行水道．通关节．利九窍．为诸黄风痹之要药．（一味白鲜皮汤、治产后风、时珍曰∶世医止施之疮科、浅矣．）兼治风疮疥癣．女子阴中肿痛．（湿热乘虚、客肾与膀胱所致．）下部虚寒．虽有湿证．勿可饵也．近道处处有之．以四川所产为良．江宁府、滁州、润州所产．俱次之．根黄白而心实．取皮用．（山人采嫩苗、为菜茹．）恶桑螵蛸、桔梗、茯苓、萆 ．（鼠 已破、出脓血、白鲜煮汁服、效．）"}]},{"ID":"20240611155556-rvykq0c","Type":"NodeThematicBreak","Properties":{"id":"20240611155556-rvykq0c"}},{"ID":"20240611155607-3bdk2rv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155607-3bdk2rv","updated":"20240611155626"},"Children":[{"Type":"NodeText","Data":"白鲜皮《医学入门》"}]},{"ID":"20240611155607-80gw2mz","Type":"NodeParagraph","Properties":{"id":"20240611155607-80gw2mz","updated":"20240611155607"},"Children":[{"Type":"NodeText","Data":"白鲜皮味苦咸寒，风瘫湿痹屈伸难，治诸疥癣清头目，咳逆淋疸尤能安。"}]},{"ID":"20240611155607-anceh3g","Type":"NodeParagraph","Properties":{"id":"20240611155607-anceh3g","updated":"20240611155607"},"Children":[{"Type":"NodeText","Data":"白色，鲜。膻气似羊膻，俗呼白羊鲜。无毒。主风瘫手足不举，筋骨弱乏湿痹，死肌不可屈伸，一切热毒恶疮风癣，眉发脱落。又治时行头风目痛，腹热饮水欲狂，咳逆。《日华》云∶通小肠水气，故淋沥黄胆用之。"}]},{"ID":"20240611155607-njtwrwf","Type":"NodeParagraph","Properties":{"id":"20240611155607-njtwrwf","updated":"20240611155607"},"Children":[{"Type":"NodeText","Data":"兼疗女子阴中肿痛，小儿惊痫。昔葛洪治鼠 已有口，脓血出者，煮服一升，吐鼠子而愈。水洗去粗皮，恶螵蛸、桔梗、茯苓。"}]},{"ID":"20240611155540-8dcv6iv","Type":"NodeThematicBreak","Properties":{"id":"20240611155540-8dcv6iv"}},{"ID":"20240611155550-gmta8ow","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155550-gmta8ow","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"《中国药典》：白鲜皮"}]},{"ID":"20240611155550-gv5rut5","Type":"NodeParagraph","Properties":{"id":"20240611155550-gv5rut5","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611155550-t586eq4","Type":"NodeParagraph","Properties":{"id":"20240611155550-t586eq4","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" Bái Xiān Pí"}]},{"ID":"20240611155550-so1pqlk","Type":"NodeParagraph","Properties":{"id":"20240611155550-so1pqlk","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611155550-ui9u7ou","Type":"NodeParagraph","Properties":{"id":"20240611155550-ui9u7ou","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 白藓皮、八股牛、山牡丹、羊鲜草"}]},{"ID":"20240611155550-wryf5kh","Type":"NodeParagraph","Properties":{"id":"20240611155550-wryf5kh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611155550-tl1betj","Type":"NodeParagraph","Properties":{"id":"20240611155550-tl1betj","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" CORTEX DICTAMNI"}]},{"ID":"20240611155550-nt0tsr7","Type":"NodeParagraph","Properties":{"id":"20240611155550-nt0tsr7","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611155550-z5gj8ae","Type":"NodeParagraph","Properties":{"id":"20240611155550-z5gj8ae","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 本品为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白鲜"},{"Type":"NodeText","Data":"Dictamnus dasycarpus Turcz.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"。春、秋二季采挖根部，除去泥沙及粗皮，剥取根皮，干燥。"}]},{"ID":"20240611155550-6wnbizr","Type":"NodeParagraph","Properties":{"id":"20240611155550-6wnbizr","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611155550-s48nop2","Type":"NodeParagraph","Properties":{"id":"20240611155550-s48nop2","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 本品呈卷筒状，长5～15cm，直径1～2cm，厚0。2～0。5cm。外表面灰白色或淡灰黄色，具细纵皱纹及细根痕，常有突起的颗粒状小点；内表面类白色，有细纵纹。质脆，折断时有粉尘飞扬，断面不平坦，略呈层片状，剥去外层，迎光可见闪烁的小亮点。有羊膻气，味微苦。"}]},{"ID":"20240611155550-k9xxs31","Type":"NodeParagraph","Properties":{"id":"20240611155550-k9xxs31","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611155550-22lu1qx","Type":"NodeParagraph","Properties":{"id":"20240611155550-22lu1qx","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，稍润，切厚片，干燥。"}]},{"ID":"20240611155550-j3nh8nc","Type":"NodeParagraph","Properties":{"id":"20240611155550-j3nh8nc","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611155550-qgmyzc4","Type":"NodeParagraph","Properties":{"id":"20240611155550-qgmyzc4","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：木栓层为10余列细胞。皮层狭窄，纤维多单个散在，黄色，直径25～ 100μm，壁厚，层纹明显。韧皮部宽广，射线宽 1～3 列细胞；纤维单个散在。薄壁组织中有多数草酸钙簇晶，直径 5～30μm。"}]},{"ID":"20240611155550-b4pgzhc","Type":"NodeParagraph","Properties":{"id":"20240611155550-b4pgzhc","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"（2） 取本品1g，粉碎，加氯仿20ml，超声处理10分钟，滤过，滤液蒸干，残渣加甲醇1ml使溶解，作为供试品溶液。另取白鲜皮对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一硅胶G薄层板上，以正已烷-醋酸乙酯（3：2）为展开剂，展开，取出，晾干，置碘蒸气中熏至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611155550-dggje8d","Type":"NodeParagraph","Properties":{"id":"20240611155550-dggje8d","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611155550-8wg4e1h","Type":"NodeParagraph","Properties":{"id":"20240611155550-8wg4e1h","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、膀胱经。"}]},{"ID":"20240611155550-1hlbbxz","Type":"NodeParagraph","Properties":{"id":"20240611155550-1hlbbxz","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611155550-gni3n6w","Type":"NodeParagraph","Properties":{"id":"20240611155550-gni3n6w","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611155550-289t288","Type":"NodeParagraph","Properties":{"id":"20240611155550-289t288","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611155550-6fnm2s0","Type":"NodeParagraph","Properties":{"id":"20240611155550-6fnm2s0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，祛风解毒。用于湿热疮毒，黄水淋漓，湿疹，风疹，疥癣疮癞，风湿热痹，黄疸尿赤。"}]},{"ID":"20240611155550-tjt9g5a","Type":"NodeParagraph","Properties":{"id":"20240611155550-tjt9g5a","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611155550-ddjg17t","Type":"NodeParagraph","Properties":{"id":"20240611155550-ddjg17t","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 4.5～9g；外用适量，煎汤洗或研粉敷。"}]},{"ID":"20240611155550-y6cs3f8","Type":"NodeParagraph","Properties":{"id":"20240611155550-y6cs3f8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611155550-kluzq2x","Type":"NodeParagraph","Properties":{"id":"20240611155550-kluzq2x","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611155550-neirvmq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155550-neirvmq","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白鲜皮"}]},{"ID":"20240611155550-u38ajse","Type":"NodeParagraph","Properties":{"id":"20240611155550-u38ajse","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611155550-zaliifk","Type":"NodeParagraph","Properties":{"id":"20240611155550-zaliifk","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" Bái Xiān Pí"}]},{"ID":"20240611155550-a3se1d9","Type":"NodeParagraph","Properties":{"id":"20240611155550-a3se1d9","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611155550-i32jw7x","Type":"NodeParagraph","Properties":{"id":"20240611155550-i32jw7x","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 北鲜皮（《药材资料汇编》）。"}]},{"ID":"20240611155550-k9goh1a","Type":"NodeParagraph","Properties":{"id":"20240611155550-k9goh1a","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611155550-dueuyy7","Type":"NodeParagraph","Properties":{"id":"20240611155550-dueuyy7","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 《药性论》"}]},{"ID":"20240611155550-hfib44w","Type":"NodeParagraph","Properties":{"id":"20240611155550-hfib44w","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611155550-w6r0wto","Type":"NodeParagraph","Properties":{"id":"20240611155550-w6r0wto","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白鲜"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"皮。北方于春、秋二季采收，南方于夏季采收。挖出后，洗净泥土，除去须根及粗皮，乘鲜时纵向剖开，抽去木心，晒干。"}]},{"ID":"20240611155550-ktbp6l0","Type":"NodeParagraph","Properties":{"id":"20240611155550-ktbp6l0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611155550-ka3qbxu","Type":"NodeParagraph","Properties":{"id":"20240611155550-ka3qbxu","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 生于山坡及丛林中。分布东北、河北、山东、河南、安徽、江苏、江西、四川、贵州、陕西、甘肃、内蒙古等地。主产辽宁、河北、四川、江苏、浙江、安徽等地。"}]},{"ID":"20240611155550-lj7jc5q","Type":"NodeParagraph","Properties":{"id":"20240611155550-lj7jc5q","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611155550-m3wn3dp","Type":"NodeParagraph","Properties":{"id":"20240611155550-m3wn3dp","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 白鲜（《本经》），又名：白藓（《本草经集注》），白膻、白羊鲜（陶弘景），金雀儿椒（《日华子本草》），地羊膻（《本草图经》），八圭牛、野花椒、八股牛。"}]},{"ID":"20240611155550-rp30e54","Type":"NodeParagraph","Properties":{"id":"20240611155550-rp30e54","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"多年生草本，全株有特异的刺激味。根木质化，数条丛生，外皮淡黄白色。茎直立，高50～65厘米。单数羽状复叶互生；有叶柄；叶轴有狭翼，小叶通常9～11片，无柄，卵形至长圆状椭圆形，长3.5～9厘米，宽2～4厘米，先端锐尖，边缘具细锯齿，表面密布腺点，叶两面沿脉有柔毛，尤以背面较多，至果期脱落，近光滑。总状花序；花轴及花梗混生白色柔毛及黑色腺毛；花梗基部有线状苞片1枚；花淡红色而有紫红色线条；萼片5，长约花瓣的1/5；花瓣5，倒披针形或长圆形，基部渐细呈柄状；雄蕊10；子房5室。蒴果，密被腺毛，成熟时5裂，每瓣片先端有一针尖。种子2～3枚，黑色，近圆形。花期4～5月。果期5～6月。"}]},{"ID":"20240611155550-ap0l8z9","Type":"NodeParagraph","Properties":{"id":"20240611155550-ap0l8z9","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611155550-yuvj7f3","Type":"NodeParagraph","Properties":{"id":"20240611155550-yuvj7f3","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 干燥根皮，呈卷筒状或双卷简状，长7～12厘米，直径1～2厘米，厚2～5毫米，表面黄白色至淡棕色，稍光滑，有时有纵皱和侧根痕。内表面淡黄色，光滑而具侧根形成的圆孔。质松脆，易折断，断面乳白色，呈层状。在日光或灯光下，可见闪烁的白色细小结晶物。气膻，味微苦。以卷筒状、无木心、皮厚、块大者佳。"}]},{"ID":"20240611155550-dgcdtbt","Type":"NodeParagraph","Properties":{"id":"20240611155550-dgcdtbt","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611155550-5kzrbv8","Type":"NodeParagraph","Properties":{"id":"20240611155550-5kzrbv8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 根含白鲜碱、白鲜内酯、谷甾醇、黄柏酮酸、胡芦巴碱、胆碱、梣皮酮。尚含菜油甾醇、茵芋碱、γ-崖椒碱、白鲜明碱。"}]},{"ID":"20240611155550-88mjva9","Type":"NodeParagraph","Properties":{"id":"20240611155550-88mjva9","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"地上部分含有补骨脂素和花椒毒素。"}]},{"ID":"20240611155550-23eax7l","Type":"NodeParagraph","Properties":{"id":"20240611155550-23eax7l","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611155550-rf2spl6","Type":"NodeParagraph","Properties":{"id":"20240611155550-rf2spl6","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去粗皮，洗净，稍润，切片；晒干。"}]},{"ID":"20240611155550-ntk84ig","Type":"NodeParagraph","Properties":{"id":"20240611155550-ntk84ig","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"《得配本草》：\"酒拌炒。\""}]},{"ID":"20240611155550-o8oopwy","Type":"NodeParagraph","Properties":{"id":"20240611155550-o8oopwy","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611155550-p1s8cx3","Type":"NodeParagraph","Properties":{"id":"20240611155550-p1s8cx3","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240611155550-cwpvtnm","Type":"NodeParagraph","Properties":{"id":"20240611155550-cwpvtnm","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入足太阴、阳明经，兼人手太阴、阳明。\""}]},{"ID":"20240611155550-uuepf1t","Type":"NodeParagraph","Properties":{"id":"20240611155550-uuepf1t","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"②《本草原始》：\"入肺、小肠经。\""}]},{"ID":"20240611155550-nqroer5","Type":"NodeParagraph","Properties":{"id":"20240611155550-nqroer5","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"入脾、胃，兼入膀胱、小肠。\""}]},{"ID":"20240611155550-lfrwouz","Type":"NodeParagraph","Properties":{"id":"20240611155550-lfrwouz","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611155550-njwo4gh","Type":"NodeParagraph","Properties":{"id":"20240611155550-njwo4gh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 苦咸，寒。"}]},{"ID":"20240611155550-fhwiczn","Type":"NodeParagraph","Properties":{"id":"20240611155550-fhwiczn","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240611155550-bkqvauq","Type":"NodeParagraph","Properties":{"id":"20240611155550-bkqvauq","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"咸，无毒。\""}]},{"ID":"20240611155550-r5l3h48","Type":"NodeParagraph","Properties":{"id":"20240611155550-r5l3h48","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"③《本草述》：\"苦微咸微辛。\""}]},{"ID":"20240611155550-tc3en9i","Type":"NodeParagraph","Properties":{"id":"20240611155550-tc3en9i","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611155550-xnwdrc8","Type":"NodeParagraph","Properties":{"id":"20240611155550-xnwdrc8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 虚寒证忌服。"}]},{"ID":"20240611155550-b9h5mba","Type":"NodeParagraph","Properties":{"id":"20240611155550-b9h5mba","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶螵蛸、桔梗、茯苓、萆薢。\""}]},{"ID":"20240611155550-tkg5u3k","Type":"NodeParagraph","Properties":{"id":"20240611155550-tkg5u3k","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"下部虚寒之人，虽有湿证勿用。\""}]},{"ID":"20240611155550-vxchff0","Type":"NodeParagraph","Properties":{"id":"20240611155550-vxchff0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611155550-nmhdaq2","Type":"NodeParagraph","Properties":{"id":"20240611155550-nmhdaq2","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 祛风，燥湿，清热，解毒。治风热疮毒，疥癣，皮肤痒疹，风湿痹痛，黄疸。"}]},{"ID":"20240611155550-rznhsjn","Type":"NodeParagraph","Properties":{"id":"20240611155550-rznhsjn","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主头风，黄疸，咳逆，淋沥，女子阴中肿痛，湿痹死肌，不可屈伸、起止、行步。\""}]},{"ID":"20240611155550-qv3y9cu","Type":"NodeParagraph","Properties":{"id":"20240611155550-qv3y9cu","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗四肢不安，时行腹中太热，饮水、欲走、大呼，小儿惊痫，妇人产后余痛。\""}]},{"ID":"20240611155550-bt6azsz","Type":"NodeParagraph","Properties":{"id":"20240611155550-bt6azsz","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治一切热毒风，恶风，风疮、疥癣赤烂，眉发脱脆，皮肌急，壮热恶寒；主解热黄、酒黄、急黄、谷黄、劳黄等。\""}]},{"ID":"20240611155550-fqnm1zn","Type":"NodeParagraph","Properties":{"id":"20240611155550-fqnm1zn","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"④《兵部手集方》：\"疗肺嗽。\""}]},{"ID":"20240611155550-pvw94zv","Type":"NodeParagraph","Properties":{"id":"20240611155550-pvw94zv","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"通关节，利九窍及血脉，并一切风痹筋骨弱乏，通小肠水气，天行时疾，头痛眼疼。根皮良，花功用同上。\""}]},{"ID":"20240611155550-ggofell","Type":"NodeParagraph","Properties":{"id":"20240611155550-ggofell","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"⑥《本草原始》：\"治一切疥癞、恶风、疥癣、杨梅、诸疮热毒。\""}]},{"ID":"20240611155550-8exrylh","Type":"NodeParagraph","Properties":{"id":"20240611155550-8exrylh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611155550-669gqwh","Type":"NodeParagraph","Properties":{"id":"20240611155550-669gqwh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～5钱。外用：煎水洗。"}]},{"ID":"20240611155550-0hatbhy","Type":"NodeParagraph","Properties":{"id":"20240611155550-0hatbhy","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611155550-95w82hs","Type":"NodeParagraph","Properties":{"id":"20240611155550-95w82hs","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" ①治肺藏风热，毒气攻皮肤瘙痒，胸膈不利，时发烦躁：白鲜皮、防风（去叉）、人参、知母（焙）、沙参各一两，黄苓（去黑心）三分。上六味捣罗为散。每服二钱匕，水一盏，煎至六分，温服，食后临卧。（《圣济总录》白鲜皮散）"}]},{"ID":"20240611155550-wabgigc","Type":"NodeParagraph","Properties":{"id":"20240611155550-wabgigc","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"②治痫黄：白鲜皮、茵陈蒿各等分。水二钟煎服，日二服。（《沈氏尊生书》白鲜皮汤）"}]},{"ID":"20240611155550-9c5n5t5","Type":"NodeParagraph","Properties":{"id":"20240611155550-9c5n5t5","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"③治鼠疫已有核，脓血出者：白鲜皮，煮服一升。（《补缺肘后方》）"}]},{"ID":"20240611155550-3wz6fqz","Type":"NodeParagraph","Properties":{"id":"20240611155550-3wz6fqz","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"④疗产后中风，虚人不可服他药者：白鲜皮三两。以水三升，煮取一升，分服。耐酒者可酒、水等分煮之。（《小品方》一物白鲜汤）"}]},{"ID":"20240611155550-ze0owr0","Type":"NodeParagraph","Properties":{"id":"20240611155550-ze0owr0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611155550-v0loda8","Type":"NodeParagraph","Properties":{"id":"20240611155550-v0loda8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 新疆地区尚以同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"狭叶白鲜"},{"Type":"NodeText","Data":"的根皮作白鲜入药。"}]},{"ID":"20240611155550-5g23m3f","Type":"NodeParagraph","Properties":{"id":"20240611155550-5g23m3f","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611155550-x4cscf9","Type":"NodeParagraph","Properties":{"id":"20240611155550-x4cscf9","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611155550-tfxstig","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611155550-tfxstig","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"《中华本草》：白鲜皮"}]},{"ID":"20240611155550-gom5qlu","Type":"NodeParagraph","Properties":{"id":"20240611155550-gom5qlu","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611155550-ibqahl8","Type":"NodeParagraph","Properties":{"id":"20240611155550-ibqahl8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" Bái Xiān Pí"}]},{"ID":"20240611155550-uh7yxyi","Type":"NodeParagraph","Properties":{"id":"20240611155550-uh7yxyi","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611155550-5ims4vs","Type":"NodeParagraph","Properties":{"id":"20240611155550-5ims4vs","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 北鲜皮、藓皮、野花椒根皮、臭根皮。"}]},{"ID":"20240611155550-a9cyn48","Type":"NodeParagraph","Properties":{"id":"20240611155550-a9cyn48","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611155550-8832biz","Type":"NodeParagraph","Properties":{"id":"20240611155550-8832biz","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" Densefruit Pittany Root-bark, Root-bark of Densefruit Pittany"}]},{"ID":"20240611155550-kiss7we","Type":"NodeParagraph","Properties":{"id":"20240611155550-kiss7we","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611155550-a9tbolh","Type":"NodeParagraph","Properties":{"id":"20240611155550-a9tbolh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》。"}]},{"ID":"20240611155550-19b0qmh","Type":"NodeParagraph","Properties":{"id":"20240611155550-19b0qmh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611155550-2bpjzun","Type":"NodeParagraph","Properties":{"id":"20240611155550-2bpjzun","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芸香科植物白鲜和狭叶白鲜的根皮。"}]},{"ID":"20240611155550-9k37vdb","Type":"NodeParagraph","Properties":{"id":"20240611155550-9k37vdb","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Dictamnus dasycarpus Turcz.2.Dictamnus angustifolius G.Don ex Sweet."}]},{"ID":"20240611155550-ulgoeu1","Type":"NodeParagraph","Properties":{"id":"20240611155550-ulgoeu1","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"采收和储藏：大部分地区在春秋季节采挖，南方于立夏后采挖，洗净泥土，去除须根及粗皮，趁鲜时纵向剖开，抽去木心，晒干。"}]},{"ID":"20240611155550-lhf094z","Type":"NodeParagraph","Properties":{"id":"20240611155550-lhf094z","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611155550-h94ve6s","Type":"NodeParagraph","Properties":{"id":"20240611155550-h94ve6s","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 生态环境：1. 生于土坡及灌丛中。"}]},{"ID":"20240611155550-5ntsfmj","Type":"NodeParagraph","Properties":{"id":"20240611155550-5ntsfmj","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"2.生于山地灌木丛中及森林下，山坡阳坡。"}]},{"ID":"20240611155550-rpxavjh","Type":"NodeParagraph","Properties":{"id":"20240611155550-rpxavjh","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北、华北、华东及陕西、甘肃、河南、四川、贵州。"}]},{"ID":"20240611155550-0ae6z4h","Type":"NodeParagraph","Properties":{"id":"20240611155550-0ae6z4h","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"2.分布于新疆，以伊犁、阿尔泰地区最多。"}]},{"ID":"20240611155550-ma91p0k","Type":"NodeParagraph","Properties":{"id":"20240611155550-ma91p0k","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611155550-n7ejxj7","Type":"NodeParagraph","Properties":{"id":"20240611155550-n7ejxj7","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 1.白鲜 多年生草本，基部木质，高达1m。全株有特异的香味。根肉质，多侧根，外皮黄白至黄褐色。奇数羽状复叶互生；叶轴有狭翼，无叶柄；小叶9-13，叶片卵形至椭圆形，长3.5-9cm，宽2-4cm，先端锐尖，基部楔形，边缘具细锯齿，上面深绿色，密布腺点，下面白绿色，腺点较稀。总状花序顶生，长达30cm，花轴及花柄混生白色柔毛及黑色腺毛；花柄长1-2.5cm，基部有线形苞片1枚；萼片5，卵状披针形，长约5mm，宽约2mm，基部愈合；花瓣5，色淡红而有紫红色线条，倒披针形或长圆形，长约25mm，宽5-7mm，某部渐细呈柄状：雄蕊10；子房上位，5室。蒴果，密被腺毛，成熟时5裂，每瓣片先端有一针尖。种子2-3颗，近球形，直径约3mm，先端短尖，黑色，有光泽。花期4-5月，果期6月。"}]},{"ID":"20240611155550-8lijpwu","Type":"NodeParagraph","Properties":{"id":"20240611155550-8lijpwu","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"2.狭叶白鲜 多年生草本，高30-80cm。茎直立，多从基部分枝，被密集的长绒毛，下部光滑有时有短毛，有香味。奇数羽状复叶互生；叶轴具毛，基部不是翅状；小叶柄极短；小叶7-15，长圆形或长椭圆形，长5-10cm，宽2-3cm，先端渐尖，基部宽楔形或近圆钝，边缘有细小的锯齿，向下面卷曲，上面光滑，下面沿叶脉有稀疏的白毛。花序总状，着生在茎顶端，密被暗褐色的腺毛和淡褐色毛；苞片线状披针形，密被暗褐色腺毛；萼片5，披针状线形，长7-9mm，先端尖锐，密被腺毛；花冠披针形或长圆形，长2-4.5cm，淡粉红色，有紫褐色毛，先端尖锐或钝，基部渐收缩呈爪状；雄蕊10，分离，花丝全部有毛；子房上位，有稀疏的白毛，花柱光滑。蒴果，密被腺毛及细毛，成熟时5裂，每片先端有一针尖。种子2-3颗，近球形，黑色，有光泽。花期5-7月，果期8-9月。"}]},{"ID":"20240611155550-is6ldt8","Type":"NodeParagraph","Properties":{"id":"20240611155550-is6ldt8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611155550-xp8fvia","Type":"NodeParagraph","Properties":{"id":"20240611155550-xp8fvia","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，耐寒、怕旱、怕涝、怕强光照。浙江产区年平均气温17-17.5℃，地上部和地下部的适宜气温12-18℃；年降雨量1350-1500mm。地下块茎分布较浅，多集中于土层下3-7cm处，每块茎具l-2个芽，多者3-4个。9月上旬-10月上旬栽种，幼芽从芽眼长出但不出土；11月上旬地温在5cm处有23-25℃时块茎从下部生根；地温在18-20℃萌芽开始，沿水平方向伸展成细长匍匐茎，习称“行鞭”；12月上旬形成第1个茎节，生有2-4支地下茎。"}]},{"ID":"20240611155550-d6nph3h","Type":"NodeParagraph","Properties":{"id":"20240611155550-d6nph3h","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"气温在4-5℃时茎开始出土，尤以7-10℃为宜。2月上旬出苗展叶，幼叶呈淡红色，逐渐变成绿色。3月上旬地下茎在节处膨大形成淡黄色光滑的块茎。4月中旬种块茎腐烂萎缩。以选地势高燥、向阳、排水良好，富含腐殖质的中性或微酸性砂质壤上或壤土栽培为宜。前茬地以甘薯、小麦、水稻、玉米、豆类、白术、粟等作物为宜；亦可水旱轮作或与薏苡轮作。"}]},{"ID":"20240611155550-na7dpes","Type":"NodeParagraph","Properties":{"id":"20240611155550-na7dpes","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"栽培技术 用块茎繁殖。栽种期9月中、下旬-11月上旬，尤以9月下旬-10月上旬为适期。选当年生块茎呈扁球形、色淡黄、芽眼多、健壮无病虫伤疤、横径约1.4-1.6cm、组织较幼嫩者作种用。栽种前块茎用退菌特50％可湿性粉剂1000倍液浸种5min，稍晾干，随即栽种。条栽或穴栽，以条栽为好。"}]},{"ID":"20240611155550-nk1j3rl","Type":"NodeParagraph","Properties":{"id":"20240611155550-nk1j3rl","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"按行距20cm开浅条沟，沟深6-7cm，块茎交互栽种2行。芽头向上，栽种不宜过浅或过深，以免影响出苗。边种边覆土，上盖草木灰或土杂灰一层。每1hm2用种量900-1125kg。田间管理 出苗后要及时拔除杂草，不宜中耕。可用除草剂“绿麦隆”可湿性粉剂300倍液喷射，再盖薄层草木灰，以免药液挥发。亦可用“绿麦隆”250 g拌土25kg制成毒土，栽种后撤施畦面，再盖草木灰1层，除草效果较好。遇旱时应及时灌溉，遇雨季及时排水。施肥要施足基肥，重施腊肥，巧施苗肥。11月下旬-12月上旬施腐熟饼肥或腐熟厩肥，促使地下茎生长，节间增多，又可防冻保苗；幼叶展开后追施人粪尿或硫酸铵，亦可用氟、磷、钾复合肥料，提高生物碱总量，促使新块茎形成。或可在3月下旬用2％过磷酸钙澄清液进行2-3次根外追肥。"}]},{"ID":"20240611155550-ov4n3v0","Type":"NodeParagraph","Properties":{"id":"20240611155550-ov4n3v0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有霜霉病，3月开始发病，多发生在叶部，叶初生褐色斑点，渐在叶背产生1层霜霉状物，使叶片枯死，可用40％乙磷铝可湿性粉剂200信液，或50％瑞毒霉500倍液、甲基托布津800倍液喷射。菌核病，3月中旬发病，为害茎基部，初呈黄褐色或深褐色的水渍状梭形病斑，严重时茎基腐烂，地上部位倒伏枯萎，土表可见菌丝及菌核，可用3％菌核利或1：3石灰和草木炭混合后撤入畦面，或用5％氯硝铵粉剂撒施。锈病，3月上、中旬发病，在初期叶现黄绿色病斑，后变黄褐色，叶背或茎上病斑隆起，散出锈色粉末，可用60％代森锌可湿性粉剂500倍液喷射，或用25％粉锈宁可湿性粉剂1000倍液喷射。还有白绢病为害。虫害有地老虎为害幼苗及块茎，另有蝼蛄、金龟子幼虫、种蝇为害。"}]},{"ID":"20240611155550-u9xy4lv","Type":"NodeParagraph","Properties":{"id":"20240611155550-u9xy4lv","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611155550-7ukneo0","Type":"NodeParagraph","Properties":{"id":"20240611155550-7ukneo0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 性状鉴别白鲜根皮呈卷筒状，长5-15cm，直径1-2cm，厚2-5mm。外表面灰白色或淡灰黄色，具细纵皱纹及细根痕，常有突起的颗粒状小点；内表面类白色，有细纵纹。质脆，折断时有粉尘飞扬，断面不平坦，略呈层片状，剥去外层，对光可见闪烁的小亮点。有羊膻气，味微苦。以条大、肉厚、包灰白、断面分居者为佳。"}]},{"ID":"20240611155550-vchtple","Type":"NodeParagraph","Properties":{"id":"20240611155550-vchtple","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根皮横切面：白鲜木栓层为10余列木栓细胞。皮层狭窄，有横长大型裂隙。韧皮部宽广，细胞排列疏松，有裂隙；韧皮射线宽1-3列细胞。皮层、韧皮部散有单个纤维，类方形或长多角形，壁极厚，木化。本品薄壁细胞含淀粉粒及草酸钙簇晶。"}]},{"ID":"20240611155550-j0kyqrp","Type":"NodeParagraph","Properties":{"id":"20240611155550-j0kyqrp","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611155550-uadh6bc","Type":"NodeParagraph","Properties":{"id":"20240611155550-uadh6bc","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 对小鼠的LD50白鲜碱、花椒碱、茵芋碱相近腹腔注射为150-250mｇ／kｇ；葫芦巴碱对大鼠皮下注射的LD50为5.0ｇ／kｇ。"}]},{"ID":"20240611155550-58c9f1l","Type":"NodeParagraph","Properties":{"id":"20240611155550-58c9f1l","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611155550-otflqim","Type":"NodeParagraph","Properties":{"id":"20240611155550-otflqim","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 1．白鲜地上部分含补骨脂素（psoralen），花椒毒素（xanthotoxin），东莨菪素（scopoletin），槲皮素（quercetin），异槲皮素（isoquercetin），根含白鲜碱（dictamnine），γ-崖椒碱（γ-fagarine），前茵芋碱（preskimmianine）］，茵芋碱（skimmia-＿nine），白鲜明碱（dasycarpamin），胡芦巴碱（trigonelline），胆碱（choline），O-乙基-降-白鲜碱（O-ethylnordictamnine），O-乙基-降-γ-崖椒碱（O-ethylnor-γ-fagarine），O-乙基-降-茵芋碱（O-ethylnorskimmianine），异斑点沸林草碱（isomaculosidine），吴茱萸苦素（rutaevin），白鲜醇（dictamnol），娠烯酸酮（peregnenolone），秦皮酮（fraxinellone），黄柏酮（obacunone），柠檬苦素（limonin），β-谷甾醇（β-sitosterol），莱油甾醇（campesterol），皂甙等。"}]},{"ID":"20240611155550-fknrq69","Type":"NodeParagraph","Properties":{"id":"20240611155550-fknrq69","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"2．狭叶白鲜根皮中含有秦皮酮，黄柏酮，柠檬苦素，柠檬苦素地奥酚（limonindiosphenol）及白鲜二醇（dictamdiol）。"}]},{"ID":"20240611155550-ijs8cft","Type":"NodeParagraph","Properties":{"id":"20240611155550-ijs8cft","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611155550-3an20k7","Type":"NodeParagraph","Properties":{"id":"20240611155550-3an20k7","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用：体外试验1：4的水浸液对多种致病真菌如堇色毛癣菌、同心性毛癣菌、许兰氏黄癣菌，均有不同程度的抑制作用，但有报告本品的乙醚、乙醇和水提取物对金黄色等球菌、大肠杆菌绿脓杆菌和草分枝杆菌均未见效果。1：20煎剂对阴道毛滴虫并无杀灭作用。"}]},{"ID":"20240611155550-ruqunm0","Type":"NodeParagraph","Properties":{"id":"20240611155550-ruqunm0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统及血液的影响：本品所含白藓碱于小量时对离体蛙心有兴奋作用，可使心肌张力增加，分钟输出量及博出量均增加。对离体兔耳血管有明显的收缩作用。所含花椒碱有抗心律失常作用，菌芋碱有麻黄碱样作用,能使麻醉猫血压上升，增强猫瞬膜收缩、扩张冠脉，增强肾上腺素的升压作用。"}]},{"ID":"20240611155550-iphwqne","Type":"NodeParagraph","Properties":{"id":"20240611155550-iphwqne","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"3.对子宫及肠平滑肌的影响：白藓碱对家兔和豚鼠子宫平滑肌有强力的收缩作用，茵芋碱也能加强猫或兔的在位子宫收缩，加强肾上腺素对子宫的影响，白藓碱、崖椒碱对大鼠子宫的自发性收缩无影响，但对于催产素所引起的大鼠子宫收缩则可减弱之，而茵芋碱则可增强。茵芋碱能抑制小肠收缩、崖椒碱能抑制氯化钡所致离体兔回肠痉挛，崖椒碱及芋茵碱还能松弛奥狄氏括约肌，有报告指出，白鲜碱、崖椒碱、茵芋碱等的混合物，对大鼠、豚鼠的解痉作用较单个生物碱的作用强。"}]},{"ID":"20240611155550-ihs2f5t","Type":"NodeParagraph","Properties":{"id":"20240611155550-ihs2f5t","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"4.抗癌作用：伊红染色法结果表明本品非极性溶剂提取物及挥发油有体外抗癌活性，从本品乙醚提取物中分离得到岑皮酮，白鲜碱及得自挥发油的一种无色透明液体为其体外抗癌的有效成分，其45%的浓度能杀死艾氏腹水癌、S180及U14细胞，而黄柏酮、柠檬苦素及β-谷甾醇无效。"}]},{"ID":"20240611155550-yeoolbu","Type":"NodeParagraph","Properties":{"id":"20240611155550-yeoolbu","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"5.Dictamnus albus L.根皮有解热作用，给发热（温刺法）之家兔口服其煎剂，能使体温下降。狗静脉注射另一种白鲜皮D. Albus var.Caucasicus浸膏，能缩短血凝时间。"}]},{"ID":"20240611155550-j7218c8","Type":"NodeParagraph","Properties":{"id":"20240611155550-j7218c8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"6.其它作用：白鲜碱、茵芋碱及崖椒碱的混合物能降低肾上腺素对豚鼠精囊的作用，茵芋碱能使肌肉麻痹，并可因累及心肌而引起哺乳动物血压进行性下降。茵芋碱能提高横纹肌的张力，加强脊髓反射的兴奋性，葫芦巴碱药理活性弱，但早年有报告其在神经肌肉标本能降低神经的时值，对肌肉的时值则先降低后增加，此外，葫芦巴碱有一定抗癌作用，12.5mｇ／kｇ能使P388白血病小鼠生命延长31%。"}]},{"ID":"20240611155550-ndo2xq7","Type":"NodeParagraph","Properties":{"id":"20240611155550-ndo2xq7","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611155550-38p317m","Type":"NodeParagraph","Properties":{"id":"20240611155550-38p317m","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，除去粗皮，洗净，稍润，切片，晒干或酒拌炒。"}]},{"ID":"20240611155550-wml2imo","Type":"NodeParagraph","Properties":{"id":"20240611155550-wml2imo","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611155550-1f8d6ze","Type":"NodeParagraph","Properties":{"id":"20240611155550-1f8d6ze","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱：取本品粉末1g，加氯仿10ml，回流提取30min，滤过，滤液浓缩至2ml，作为供试液，另取黄柏酮0.5g溶于1ml氯仿液中作对照品溶液，吸取二溶液分别点祥于同一硅胶G-0.3％CMC薄层板上，以甲苯一氯仿一甲醇（3：12：3）展开，用碘蒸气熏后，供试液色谱在与对照品色谱相应的位置上，显相同的黄色斑点。"}]},{"ID":"20240611155550-rarynle","Type":"NodeParagraph","Properties":{"id":"20240611155550-rarynle","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611155550-bi7wy4o","Type":"NodeParagraph","Properties":{"id":"20240611155550-bi7wy4o","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 脾；肺；小肠；胃；膀胱经"}]},{"ID":"20240611155550-3tu1pi8","Type":"NodeParagraph","Properties":{"id":"20240611155550-3tu1pi8","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611155550-rsrld82","Type":"NodeParagraph","Properties":{"id":"20240611155550-rsrld82","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 苦；咸；寒"}]},{"ID":"20240611155550-2a5num4","Type":"NodeParagraph","Properties":{"id":"20240611155550-2a5num4","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611155550-z14l6sm","Type":"NodeParagraph","Properties":{"id":"20240611155550-z14l6sm","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 虚寒证忌服。"}]},{"ID":"20240611155550-d0urmyy","Type":"NodeParagraph","Properties":{"id":"20240611155550-d0urmyy","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611155550-88zj117","Type":"NodeParagraph","Properties":{"id":"20240611155550-88zj117","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 清热燥湿；祛风止痒；解毒。主风热湿毒所致的风疹；湿疹；疥癣；黄疸；湿热 痹"}]},{"ID":"20240611155550-028v3hb","Type":"NodeParagraph","Properties":{"id":"20240611155550-028v3hb","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611155550-q40dpmk","Type":"NodeParagraph","Properties":{"id":"20240611155550-q40dpmk","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入丸、散。外用：适量，煎水洗或研末敷。"}]},{"ID":"20240611155550-wvyzc52","Type":"NodeParagraph","Properties":{"id":"20240611155550-wvyzc52","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611155550-6pv9pe0","Type":"NodeParagraph","Properties":{"id":"20240611155550-6pv9pe0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：白鲜皮，气寒善行，味苦性燥，为诸黄风痹要药，世医止施之疮科，浅矣。"}]},{"ID":"20240611155550-52zgtbc","Type":"NodeParagraph","Properties":{"id":"20240611155550-52zgtbc","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"2.《本草原始》：白鲜皮，入肺经，故能去风，入小肠经，故能去湿，夫风湿既除，则血气自活而热亦去。治一切疥癞、恶风、疥癣、杨梅、诸疮热毒。"}]},{"ID":"20240611155550-58w3e9k","Type":"NodeParagraph","Properties":{"id":"20240611155550-58w3e9k","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：白鲜皮，苦能泄热，寒能除热，故主头风有火证。性寒而燥，能除湿热，故主五疸。咳逆者，实火上冲也，得寒而散，则咳逆止矣。淋沥及女子阴中肿痛，亦皆下部湿热，乘虚客肾与膀胱所致也。湿痹死肌不可屈伸、起止、行步者，地之湿气，感则害人皮肉筋脉也，脾主四肢，恶湿而喜燥，今为湿邪所干，故四肢不安也。时行腹中大热，因而饮水、大呼、欲走者，邪热盛也。小儿惊痫，亦热则生风之候也。散湿除热，蔑不济矣。妇人产后余痛，应是血虚而热，非所宜也。"}]},{"ID":"20240611155550-5nh8kfw","Type":"NodeParagraph","Properties":{"id":"20240611155550-5nh8kfw","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"4.《本草述》：白鲜根皮，始尝之，味微咸，后味辛，后即纯苦，苦中复有微辛，《本草》言其气寒。夫咸入血，苦寒之性，有辛而合之以入血，宜能清散血中之滞热矣。肝为风木，不独血虚能生风，即血滞者亦然，血之滞也，不独寒能涩之，即热而气伤者亦能涩之，此味于是有专功，谓其通关节，利九窍及血脉者不谬也。但脾以肝为用，而此之借金气以达者，肝更借肺为用以致于脾，脾因肝之血和，肺之气达，而湿热乃散，故治湿痹及黄疸症。如所谓女子阴中肿痛，及筋病不可屈伸、起止、行步，非肝之病乎？如所谓黄疸并湿痹死肌，又非脾与肺之病乎，虽肝肾属下，其奏功多在下部，如希雍所云，然肝肾之病，未有脾肺之气不达而能疗者也。明者审之。"}]},{"ID":"20240611155550-0eakoz0","Type":"NodeParagraph","Properties":{"id":"20240611155550-0eakoz0","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：白鲜皮，阳明胃土，喜燥恶湿，一有邪入，则阳被郁不伸，而热生矣。有热自必有湿,湿淫则热益盛，而风更乘热至，相依为害，以致关节不通，九窍不利，见为风疮疥癣，毛脱疸黄，湿痹便结，溺闭阴肿，咳逆狂叫，饮水种种等症，治宜用此苦泄寒咸之味，以为开关通窍，俾水行热除，风息而症自克平。奈世不察，猥以此为疮疡之外用，其亦未达主治之意耳。然此止可施于脾胃坚实之人，若使素属虚寒，切勿妄用。"}]},{"ID":"20240611155550-tr3qdlt","Type":"NodeParagraph","Properties":{"id":"20240611155550-tr3qdlt","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"6.《本草正义》：白鲜乃苦寒胜湿之药，又能通行经隧脉络。《本经》主头风者，风湿热之在上者也；黄疸咳逆，湿热之在中者也；湿痹死肌，不可屈伸、起止、行步，湿热之痹于关节、着于肌肉者也。白鲜气味甚烈，故能彻上彻下，通利关节，胜湿除热，无微不至也。《别录》疗四肢不安者，即痹着之病也;时行腹中大热，饮水、欲走、大呼者，则天行热病狂易之类也;小儿惊痫，亦风热病耳。《别录》又有主妇人产后余痛二语，则有血虚血瘀之辨，且皆不宜于苦寒之品，虽容有血热一症，然白鲜亦非主要之药，仲醇已有血虚而热，非其所宜之说。"}]},{"ID":"20240611155550-ykv73ya","Type":"NodeParagraph","Properties":{"id":"20240611155550-ykv73ya","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"7.《本经》：主头风，黄疸，咳逆，淋沥，女子阴中肿痛，湿痹死肌，不可屈伸、起止、行步。"}]},{"ID":"20240611155550-g4uycvz","Type":"NodeParagraph","Properties":{"id":"20240611155550-g4uycvz","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"8.《别录》：疗四肢不安，时行腹中大热，饮水、欲走、大呼，小儿惊痫，妇人产后余痛。"}]},{"ID":"20240611155550-bempiwg","Type":"NodeParagraph","Properties":{"id":"20240611155550-bempiwg","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：治一切热毒风，恶风，风疮、疥癣赤烂，眉发脱脆，皮肌急，壮热恶寒；主解热黄、酒黄、急黄、谷黄、劳黄等。"}]},{"ID":"20240611155550-1kpf55l","Type":"NodeParagraph","Properties":{"id":"20240611155550-1kpf55l","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"9.《兵部手集方》：疗肺嗽。"}]},{"ID":"20240611155550-uq5wpqo","Type":"NodeParagraph","Properties":{"id":"20240611155550-uq5wpqo","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"10.《日华子本草》：通关节，利九窍及血脉，并一切风痹筋骨弱乏，通小肠水气，天行时疾，头痛眼疼。根皮良，花功用同上。"}]},{"ID":"20240611155550-xjmyve7","Type":"NodeParagraph","Properties":{"id":"20240611155550-xjmyve7","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611155550-qjkfi9f","Type":"NodeParagraph","Properties":{"id":"20240611155550-qjkfi9f","updated":"20240611155550"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611155551-hycc9k9","Type":"NodeThematicBreak","Properties":{"id":"20240611155551-hycc9k9"}},{"ID":"20240611155552-yb0oyyv","Type":"NodeParagraph","Properties":{"id":"20240611155552-yb0oyyv"}}]}