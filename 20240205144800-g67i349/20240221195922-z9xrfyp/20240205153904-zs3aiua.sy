,"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白玉兰 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白玉兰 12-20240811130932-y0lz6lc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 454px;\" parent-style=\"width: 464px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811131413-l7i38et","Type":"NodeParagraph","Properties":{"id":"20240811131413-l7i38et","updated":"20240811131425"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白玉兰 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白玉兰 15-20240811131411-inhig3n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白玉兰 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白玉兰 16-20240811131425-d8d1ghq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811124538-4gah9cr","Type":"NodeVideo","Data":"\u003cvideo controls=\"controls\" src=\"assets/辛夷 1-20240811124537-xi9dx7s.mp4\" data-src=\"assets/辛夷 1-20240811124537-xi9dx7s.mp4\"\u003e\u003c/video\u003e","Properties":{"id":"20240811124538-4gah9cr","updated":"20240811115733"}},{"ID":"20240811124519-kmw811s","Type":"NodeVideo","Data":"\u003cvideo controls=\"controls\" src=\"assets/辛夷-20240811124519-nvvh9jm.mp4\" data-src=\"assets/辛夷-20240811124519-nvvh9jm.mp4\"\u003e\u003c/video\u003e","Properties":{"id":"20240811124519-kmw811s","updated":"20240811115733"}},{"ID":"20240811125812-zchumtx","Type":"NodeParagraph","Properties":{"id":"20240811125812-zchumtx","updated":"20240811115733"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：关于辛夷，观点较多，不保证取图正确，烦请各位以实际临床经验为准；"}]},{"ID":"20240811125816-73b2eay","Type":"NodeThematicBreak","Properties":{"id":"20240811125816-73b2eay","updated":"20240811115733"}},{"ID":"20240617110121-nve1xxt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110121-nve1xxt","updated":"20240617110121"},"Children":[{"Type":"NodeText","Data":"辛夷《神农本草经》"}]},{"ID":"20240617110121-plbi7o5","Type":"NodeParagraph","Properties":{"id":"20240617110121-plbi7o5","updated":"20240617110121"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240617110121-w2yyvz2","Type":"NodeParagraph","Properties":{"id":"20240617110121-w2yyvz2","updated":"20240617110121"},"Children":[{"Type":"NodeText","Data":"主五脏，身体寒风，头脑痛，面皯。久服，下气轻身，明目，增年耐老。一名辛矧（《御览》作引），一名侯桃，一名房木。生川谷。"}]},{"ID":"20240617110121-tfq1t9u","Type":"NodeParagraph","Properties":{"id":"20240617110121-tfq1t9u","updated":"20240617110121"},"Children":[{"Type":"NodeText","Data":"《名医》曰：九月采实，暴干。"}]},{"ID":"20240617110121-so1qwqj","Type":"NodeParagraph","Properties":{"id":"20240617110121-so1qwqj","updated":"20240617110121"},"Children":[{"Type":"NodeText","Data":"案汉书扬雄赋云：列新雉于林薄；师古云：新雉即辛夷耳，为树甚大，其木枝叶皆芳，一名新矧；《史记·司马相如传》：杂以流夷；注《汉书音义》曰：流夷，新夷也；陶宏景云：小时气辛香，即《离骚》所呼辛夷者；陈藏起云：初发如笔，北人呼为木笔，其花最早，南人呼为迎春。按唐人名为玉蕊，又曰玉兰。"}]},{"ID":"20240617110121-thunm1d","Type":"NodeThematicBreak","Properties":{"id":"20240617110121-thunm1d","updated":"20240617110121"}},{"ID":"20240607145513-k4rxyui","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145513-k4rxyui","updated":"20240607145518"},"Children":[{"Type":"NodeText","Data":"辛夷《医学入门》"}]},{"ID":"20240607145513-ilxg9h1","Type":"NodeParagraph","Properties":{"id":"20240607145513-ilxg9h1","updated":"20240607145513"},"Children":[{"Type":"NodeText","Data":"辛夷辛温治脑风，眩冒如在船车中，面肿齿痛并鼻塞，解肌利窍杀诸虫。"}]},{"ID":"20240607145513-zgz90kx","Type":"NodeParagraph","Properties":{"id":"20240607145513-zgz90kx","updated":"20240607145513"},"Children":[{"Type":"NodeText","Data":"辛，辛香也；夷，灭也。善灭面 ，以功言也。无毒。主头风痛，面肿引齿痛，眩冒身兀函如在舟车上，通鼻塞涕出。又解肌去五脏身体寒热，利九窍，去白虫。去皮心及外毛，毛射入肺令咳。水洗微炙，川芎为使，恶五石脂，畏菖蒲、蒲黄、黄连、石膏。"}]},{"ID":"20240617110513-7wdx8o5","Type":"NodeThematicBreak","Properties":{"id":"20240617110513-7wdx8o5"}},{"ID":"20240617110514-ceeb2yc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110514-ceeb2yc","updated":"20240617110519"},"Children":[{"Type":"NodeText","Data":"辛夷《名医别录》"}]},{"ID":"20240617110514-e3t148o","Type":"NodeParagraph","Properties":{"id":"20240617110514-e3t148o","updated":"20240617110514"},"Children":[{"Type":"NodeText","Data":"无毒．温中，解肌，利九窍，通鼻塞，涕出，治面肿引齿痛，眩冒，身洋洋如在车船上者．生须发，去白虫．可作膏药，用之去中心及外毛，毛射人肺，令人咳．生汉中．九采实，曝干．（芎 为之使，恶五石脂，畏菖蒲、黄连、石膏、黄环．）"}]},{"ID":"20240617110514-sbag0yd","Type":"NodeParagraph","Properties":{"id":"20240617110514-sbag0yd","updated":"20240617110531"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶辛夷，味辛，温．主五脏身体寒热，风头脑痛面 ．久服下气，轻身明目，增年耐老。一名辛矧，一名侯桃，一名房木。生川谷。"}]},{"ID":"20240617110556-skdulth","Type":"NodeThematicBreak","Properties":{"id":"20240617110556-skdulth"}},{"ID":"20240617110558-ectjpbp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110558-ectjpbp","updated":"20240617110602"},"Children":[{"Type":"NodeText","Data":"辛夷《要药分剂》"}]},{"ID":"20240617110558-svmkbfg","Type":"NodeParagraph","Properties":{"id":"20240617110558-svmkbfg","updated":"20240617110558"},"Children":[{"Type":"NodeText","Data":"味辛。性温。无毒。禀春阳之气以生。升也。阳也。川芎为使。恶五石脂。畏菖蒲、蒲黄、黄连、石膏。"}]},{"ID":"20240617110558-qukv7xi","Type":"NodeParagraph","Properties":{"id":"20240617110558-qukv7xi","updated":"20240617110558"},"Children":[{"Type":"NodeText","Data":"【主治】主五脏身体寒热风。头脑痛。久服下气明目。（本经）利九窍。通鼻塞涕出。"}]},{"ID":"20240617110558-kjqdac8","Type":"NodeParagraph","Properties":{"id":"20240617110558-kjqdac8","updated":"20240617110558"},"Children":[{"Type":"NodeText","Data":"治面肿引齿痛。头眩。身兀兀如在车船之上。生须发。去白虫。（别录）通关脉。治头痛憎寒体噤。（大明）鼻渊。鼻鼽。鼻窒。鼻疮。及痘后鼻疮。并研末入麝少许。葱白蘸入数次。"}]},{"ID":"20240617110558-4suisl6","Type":"NodeParagraph","Properties":{"id":"20240617110558-4suisl6","updated":"20240617110558"},"Children":[{"Type":"NodeText","Data":"甚良。（纲目）【归经】入肺胃二经。为辛香走窜之品。（二经气分药能助胃中清阳上行通于头脑巅顶）【前论】汪机曰。肺主鼻。胆移热于脑。则鼻多浊涕而成渊。风寒客于脑则鼻寒。经云。"}]},{"ID":"20240617110558-tzu37kz","Type":"NodeParagraph","Properties":{"id":"20240617110558-tzu37kz","updated":"20240617110612"},"Children":[{"Type":"NodeText","Data":"脑渗为涕。王冰云。胆液不澄。则为浊涕。如泉不已。故曰鼻渊。时珍曰。肺开窍于鼻。而阳明胃脉环鼻而上行。脑为元神之府。鼻为命门之窍。人之中气不足。清阳不升。则头为之倾岐【禁忌】经疏曰。凡气虚人忌。偶感风寒鼻塞。亦忌。头脑痛属血虚火炽者忌。齿痛属胃火者忌。"}]},{"ID":"20240607145457-9hn22u9","Type":"NodeThematicBreak","Properties":{"id":"20240607145457-9hn22u9"}},{"ID":"20240607145503-4upl07l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145503-4upl07l","updated":"20240607145507"},"Children":[{"Type":"NodeText","Data":"辛夷《得配本草》"}]},{"ID":"20240607145503-q6p3gqi","Type":"NodeParagraph","Properties":{"id":"20240607145503-q6p3gqi","updated":"20240607145503"},"Children":[{"Type":"NodeText","Data":"芎 为之使。畏菖蒲、黄连、蒲黄、石膏、黄环。恶五石脂。"}]},{"ID":"20240607145503-8chqoza","Type":"NodeParagraph","Properties":{"id":"20240607145503-8chqoza","updated":"20240607145503"},"Children":[{"Type":"NodeText","Data":"辛，温。入手太阴、足阳明经气分。通九窍，利关节，行头脑，而散上焦之风热。佐薄荷、石膏，治鼻流清涕。佐川柏、牡蛎，治鼻渊如脓。"}]},{"ID":"20240607145503-j058vag","Type":"NodeParagraph","Properties":{"id":"20240607145503-j058vag","updated":"20240607145503"},"Children":[{"Type":"NodeText","Data":"去心及皮毛，甘草汤浸炒，或芭蕉水浸，焙干用。气虚，火盛，二者禁用。"}]},{"ID":"20240607145449-gnzmxux","Type":"NodeThematicBreak","Properties":{"id":"20240607145449-gnzmxux"}},{"ID":"20240607145451-vhyetha","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145451-vhyetha","updated":"20240607145456"},"Children":[{"Type":"NodeText","Data":"辛夷《本草求真》"}]},{"ID":"20240607145451-i117wum","Type":"NodeParagraph","Properties":{"id":"20240607145451-i117wum","updated":"20240607145451"},"Children":[{"Type":"NodeText","Data":"（香木）散肺中风热"}]},{"ID":"20240607145451-kn290gj","Type":"NodeParagraph","Properties":{"id":"20240607145451-kn290gj","updated":"20240607145451"},"Children":[{"Type":"NodeText","Data":"辛夷（专入肺）。辛温气浮。功专入肺解散风热。缘人鼻气通天。肺窍开鼻。鼻主肺。风热移于脑。则鼻多浊涕而渊。风寒客于脑则鼻塞。经曰。脑渗为涕。胆液不澄。则为浊涕如泉不已。故曰鼻渊。（鼻渊不尽外感。在长洲张璐指为阳明伏火。会稽景岳指为督火发。海盐楚瞻指为肾经亏损。要在相症施治。）并头痛面 。目眩齿痛。九窍不利。皆是风热上攻。是宜用此芳香上窜头目。兼逐阳分风邪。则诸症自愈。但辛香走窜。血虚火炽。及偶感风寒不闻香臭者。其并禁焉。（时珍曰。鼻气通于天。天者头也。肺也。肺开窍于鼻。而阳明胃脉。环鼻而上行脑。为元神之府。而鼻为命门之窍。人之中气不足。清阳不升。则头为之倾。九窍为之不利。辛夷之辛温走气而入肺。其体轻浮。能助胃中清阳上行通于天。所以能。治头面目鼻九窍之病。汪昂曰。吾乡金正希先生尝语余曰。人之记性。皆在脑中。小儿善忘者。脑未满也。老人健忘者。脑渐空也。凡人外见一物。必有一形留影留于脑中。昂思今人每记忆往事。必闭目上瞪而思索之。此即凝神于脑之意也。不经先生道破。人皆习焉而不察矣。）即木笔花。去外皮毛。微炒。恶石脂。畏黄 菖蒲蒲黄黄连石膏。"}]},{"ID":"20240607145437-gc3j9g1","Type":"NodeThematicBreak","Properties":{"id":"20240607145437-gc3j9g1"}},{"ID":"20240607145438-bobwx1m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145438-bobwx1m","updated":"20240607145443"},"Children":[{"Type":"NodeText","Data":"辛夷《本草撮要》"}]},{"ID":"20240607145438-s8cb47f","Type":"NodeParagraph","Properties":{"id":"20240607145438-s8cb47f","updated":"20240607145438"},"Children":[{"Type":"NodeText","Data":"味辛．入手太阴足阳明经．功专去头风鼻病．得川芎、薄荷、细辛、石膏．治鼻塞流涕．不闻香臭．得南星、半夏、黄柏、牡蛎治鼻渊下如白脓．偶感风寒鼻塞及血虚火炽者均忌．去皮毛焙用．川芎为使．恶石脂．畏菖蒲、石膏、蒲黄、黄连．一名木笔花．一名迎春花．"}]},{"ID":"20240607144950-wvoe6eh","Type":"NodeThematicBreak","Properties":{"id":"20240607144950-wvoe6eh"}},{"ID":"20240607145402-j33wo9r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145402-j33wo9r","updated":"20240607145408"},"Children":[{"Type":"NodeText","Data":"辛夷《本草衍义》"}]},{"ID":"20240607145402-bskokuo","Type":"NodeParagraph","Properties":{"id":"20240607145402-bskokuo","updated":"20240607145402"},"Children":[{"Type":"NodeText","Data":"先花后叶，即木笔花也。最先春，以其花未开时，其花苞有毛，光长如笔，故取像曰木笔。有红、紫二本，一本如桃花色者，一本紫者。今入药当用紫色者，仍须未开时收取。"}]},{"ID":"20240607145402-8lj8yy4","Type":"NodeParagraph","Properties":{"id":"20240607145402-8lj8yy4","updated":"20240607145402"},"Children":[{"Type":"NodeText","Data":"入药，去毛苞。"}]},{"ID":"20240607145403-gt7kzqo","Type":"NodeThematicBreak","Properties":{"id":"20240607145403-gt7kzqo"}},{"ID":"20240607145346-7kqx3rt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145346-7kqx3rt","updated":"20240607145352"},"Children":[{"Type":"NodeText","Data":"辛夷《神农本草经赞》"}]},{"ID":"20240607145346-aq9t394","Type":"NodeParagraph","Properties":{"id":"20240607145346-aq9t394","updated":"20240607145346"},"Children":[{"Type":"NodeText","Data":"味辛温。主五脏身体。寒风头脑痛。面。久服下气。轻身明目。增年耐老。一名辛矧。一名侯桃。一名房木。生川谷。"}]},{"ID":"20240607145346-w9esgb2","Type":"NodeParagraph","Properties":{"id":"20240607145346-w9esgb2","updated":"20240607145346"},"Children":[{"Type":"NodeText","Data":"潜苞蓄锐。攒紫团红。夭桃敛实。健笔书空。吐高灼日。送谢摇风。迎春玉蕊。功岂从同。"}]},{"ID":"20240607145346-yehvi9v","Type":"NodeParagraph","Properties":{"id":"20240607145346-yehvi9v","updated":"20240607145346"},"Children":[{"Type":"NodeText","Data":"韩愈诗。潜苞绛实坼。李翰论。含光蓄锐。谢诗。发萼初攒紫。李贺诗。细绿及团红。"}]},{"ID":"20240607145346-dse8sot","Type":"NodeParagraph","Properties":{"id":"20240607145346-dse8sot","updated":"20240607145346"},"Children":[{"Type":"NodeText","Data":"名医曰。似东桃而小。潘尼赋。收华敛实。陈藏器曰。北人呼为木笔。方千诗。春物诱材归健笔。欧阳炯诗。势欲书空映早霞。韩琦诗。辛夷吐高花。徐铉诗。晴后日高偏照灼。韩愈书。迎繁送谢别有意。江淹赋。摇风忽起。苕溪渔隐丛话。木笔色紫。二月方开。迎春白色。"}]},{"ID":"20240607145346-vkkwceq","Type":"NodeParagraph","Properties":{"id":"20240607145346-vkkwceq","updated":"20240607145346"},"Children":[{"Type":"NodeText","Data":"立春已开。自是二种。公羊传。其余从同同。"}]},{"ID":"20240607145346-wrzdp39","Type":"NodeThematicBreak","Properties":{"id":"20240607145346-wrzdp39"}},{"ID":"20240607145334-hv01i1x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145334-hv01i1x","updated":"20240607145340"},"Children":[{"Type":"NodeText","Data":"辛夷《本经逢原》"}]},{"ID":"20240607145334-4id494w","Type":"NodeParagraph","Properties":{"id":"20240607145334-4id494w","updated":"20240607145334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即木笔花"}]},{"ID":"20240607145334-m6cvsm4","Type":"NodeParagraph","Properties":{"id":"20240607145334-m6cvsm4","updated":"20240607145334"},"Children":[{"Type":"NodeText","Data":"辛温无毒。剥去毛瓣，取仁用，忌火焙。"}]},{"ID":"20240607145334-if059zo","Type":"NodeParagraph","Properties":{"id":"20240607145334-if059zo","updated":"20240607145334"},"Children":[{"Type":"NodeText","Data":"《本经》主五脏身体寒热，头风脑痛、面 。"}]},{"ID":"20240607145334-fckujor","Type":"NodeParagraph","Properties":{"id":"20240607145334-fckujor","updated":"20240607145334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"鼻气通于天，肺开窍于鼻，辛夷之辛温走气而入肺利窍。其体轻浮，能开胃中清阳，上行通于天。故《本经》治阳气郁遏，身体寒热，头风脑痛、面 。辛温能解肌表，芳香上窜头目逐阳分之风邪，则诸证自愈。轩岐之后，能达此理者，东垣一人而已。凡鼻鼽、鼻渊、鼻塞及痘后鼻疮，并研末，入麝香少许，以葱白蘸入甚良，脑鼻中有湿气久窒不通者宜之。但辛香走窜，虚人血虚火炽而鼻塞，及偶感风寒，鼻塞不闻香臭者禁用。"}]},{"ID":"20240607145334-sy2cvob","Type":"NodeThematicBreak","Properties":{"id":"20240607145334-sy2cvob"}},{"ID":"20240607145319-sdcodnb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145319-sdcodnb","updated":"20240607145326"},"Children":[{"Type":"NodeText","Data":"辛夷《本草崇原》"}]},{"ID":"20240607145319-ybnp7ta","Type":"NodeParagraph","Properties":{"id":"20240607145319-ybnp7ta","updated":"20240607145319"},"Children":[{"Type":"NodeText","Data":"气味辛温，无毒。主治五脏身体寒热，风头脑痛，面 。久服下气，轻身，明目，增年耐老。"}]},{"ID":"20240607145319-z0hmt3h","Type":"NodeParagraph","Properties":{"id":"20240607145319-z0hmt3h","updated":"20240607145319"},"Children":[{"Type":"NodeText","Data":"（辛夷始出汉中、魏兴、梁州川谷，今近道处处有之。人家园亭亦多种植。树高丈余，花先叶后，叶苞有茸毛。花开白色者，名玉兰，谓花色如玉，花香如兰也。红紫色者，名木笔，谓花苞尖长，俨然如笔也。入药红白皆用，取含苞未开者收之。）"}]},{"ID":"20240607145319-z3q4yjr","Type":"NodeParagraph","Properties":{"id":"20240607145319-z3q4yjr","updated":"20240607145319"},"Children":[{"Type":"NodeText","Data":"辛夷味辛臭香，苞毛花白，禀阳明土金之气化也。阳明者土也，五脏之所归也。故主治五脏不和而为身体之寒热。阳明者金也，金能制风，故主治风淫头脑之痛。阳明之气有余，则面生光，故治面 。 ，黑色也。《经》云∶阳明者，胃脉也，其气下行，故久服下气，土气和平，故轻身。金水相生，故明目。下气轻身明目，则增年耐老。"}]},{"ID":"20240607145319-lnn1dcr","Type":"NodeThematicBreak","Properties":{"id":"20240607145319-lnn1dcr"}},{"ID":"20240607145306-5ao94fs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145306-5ao94fs","updated":"20240607145312"},"Children":[{"Type":"NodeText","Data":"辛夷《本草从新》"}]},{"ID":"20240607145306-n0e6vpu","Type":"NodeParagraph","Properties":{"id":"20240607145306-n0e6vpu","updated":"20240607145306"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名木笔花、一名迎春花．宣散上焦风热．"}]},{"ID":"20240607145306-8l5o9bs","Type":"NodeParagraph","Properties":{"id":"20240607145306-8l5o9bs","updated":"20240607145306"},"Children":[{"Type":"NodeText","Data":"辛温轻浮．入肺胃气分．能助胃中清阳上行．通于头脑．温中解肌．通九窍．利关节．"}]},{"ID":"20240607145306-szllkq8","Type":"NodeParagraph","Properties":{"id":"20240607145306-szllkq8","updated":"20240607145306"},"Children":[{"Type":"NodeText","Data":"主治胆移热于脑则鼻多浊涕而渊、风寒客于脑则鼻塞、经曰∶脑渗为涕、王冰曰∶胆液不澄、则为浊涕、如泉不已、故曰鼻渊．）及头痛面 ．（黑斑、可作面脂．）"}]},{"ID":"20240607145306-pcyc3tn","Type":"NodeParagraph","Properties":{"id":"20240607145306-pcyc3tn","updated":"20240607145306"},"Children":[{"Type":"NodeText","Data":"目眩齿痛．九窍风热之病．辛香走窜．虚人偶感风寒而鼻塞者禁之．头痛属血虚火炽者．服之转甚．（李时珍曰∶肺开窍于鼻、阳明胃脉、环鼻上行、脑为元神之府、鼻为命门之窍、人之中气不足、清阳不升、则头为之倾、九窍为之不利．人之记性、皆在脑中、小儿善忘者、脑未满也、老人健忘者、脑渐空也、凡人外见一形、必有一形留于脑中、今人每记忆往事、必闭目上瞪而思索之、此即凝神于脑之意也．）去外皮毛．（毛射肺、令人咳．）微焙．"}]},{"ID":"20240607145306-95xr8ye","Type":"NodeParagraph","Properties":{"id":"20240607145306-95xr8ye","updated":"20240607145306"},"Children":[{"Type":"NodeText","Data":"芎蒲、石膏、蒲黄、黄连．（鼻渊、鼻 、鼻窒、鼻疮、及痘后鼻疮、并用辛夷研末、入麝香少许、葱白蘸入数次、甚良．）"}]},{"ID":"20240607145300-plc0lyp","Type":"NodeThematicBreak","Properties":{"id":"20240607145300-plc0lyp"}},{"ID":"20240607145239-e5bcwpz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145239-e5bcwpz","updated":"20240607145254"},"Children":[{"Type":"NodeText","Data":"辛夷《本草便读》"}]},{"ID":"20240607145246-a5jw3ed","Type":"NodeParagraph","Properties":{"id":"20240607145246-a5jw3ed","updated":"20240607145250"},"Children":[{"Type":"NodeText","Data":"禀春阳之气．味薄而辛．具香窜之能．气温且散．开窍搜邪于肺部．鼻塞堪通．升清助胃于上焦．头风亦愈．（辛夷一名木笔花．一云即玉兰花蕊也．此物初生如笔．重重有毛．当去净用．否则毛射肺中．令人咳嗽．禀春初生发之气．轻浮上升．辛温香散．入肺胃二经．肺气通于鼻．胃脉行于面．故主头风鼻塞．开窍解肌．纯乎解散上部风寒之物．虚而无邪者．不可用之．）"}]},{"ID":"20240607145241-bkx4l3g","Type":"NodeThematicBreak","Properties":{"id":"20240607145241-bkx4l3g"}},{"ID":"20240607145225-h01k1or","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145225-h01k1or","updated":"20240607145230"},"Children":[{"Type":"NodeText","Data":"辛夷《本草纲目》"}]},{"ID":"20240607145225-kb1e4wf","Type":"NodeParagraph","Properties":{"id":"20240607145225-kb1e4wf","updated":"20240607145225"},"Children":[{"Type":"NodeText","Data":"「释名」辛、侯桃、房木、木笔、迎春（按：本吕为木兰的干燥花蕾）。"}]},{"ID":"20240607145225-5ggqrpv","Type":"NodeParagraph","Properties":{"id":"20240607145225-5ggqrpv","updated":"20240607145225"},"Children":[{"Type":"NodeText","Data":"「气味」辛、温、无毒。"}]},{"ID":"20240607145225-pvlogdr","Type":"NodeParagraph","Properties":{"id":"20240607145225-pvlogdr","updated":"20240607145225"},"Children":[{"Type":"NodeText","Data":"「主治」鼻渊、鼻塞。用辛夷研末，加麝香少许，以葱白蘸入鼻中，几次即见效。"}]},{"ID":"20240607145225-ugmprhe","Type":"NodeThematicBreak","Properties":{"id":"20240607145225-ugmprhe"}},{"ID":"20240607145120-d5r496h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145120-d5r496h","updated":"20240607145127"},"Children":[{"Type":"NodeText","Data":"辛夷《玉楸药解》"}]},{"ID":"20240607145120-1mzc4g3","Type":"NodeParagraph","Properties":{"id":"20240607145120-1mzc4g3","updated":"20240607145120"},"Children":[{"Type":"NodeText","Data":"味辛，微温，入手太阴肺、足阳明胃经。泻肺降逆，利气破壅。"}]},{"ID":"20240607145120-eo4cr4b","Type":"NodeParagraph","Properties":{"id":"20240607145120-eo4cr4b","updated":"20240607145120"},"Children":[{"Type":"NodeText","Data":"辛夷降泻肺胃，治头痛，口齿疼，鼻塞，收涕去鼾，散寒止痒，涂面润肤，吹鼻疗疮。"}]},{"ID":"20240607145120-9q1huk6","Type":"NodeParagraph","Properties":{"id":"20240607145120-9q1huk6","updated":"20240607145120"},"Children":[{"Type":"NodeText","Data":"亦名木笔花。"}]},{"ID":"20240617110456-15466hj","Type":"NodeThematicBreak","Properties":{"id":"20240617110456-15466hj"}},{"ID":"20240617110457-alhlufd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110457-alhlufd","updated":"20240617110501"},"Children":[{"Type":"NodeText","Data":"辛夷《本草经集注》"}]},{"ID":"20240617110457-kkfm5ol","Type":"NodeParagraph","Properties":{"id":"20240617110457-kkfm5ol","updated":"20240617110457"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主治五脏身体寒风，风头脑痛，面 。温中，解肌，利九窍。通鼻塞涕出。治面肿引齿痛，眩冒，身洋洋如在车船之上者。生须发，去白虫。久服下气，轻身，明目，增年耐老。可作膏药，用之去中心及外毛，毛射人肺，令人咳。一名辛矧，一名侯桃，一名房木。生汉中川谷。九月采实，曝干。（芎 为之使，恶五石脂，畏菖蒲、蒲黄、黄连、石膏、黄环。）"}]},{"ID":"20240617110457-dzm6y05","Type":"NodeParagraph","Properties":{"id":"20240617110457-dzm6y05","updated":"20240617110457"},"Children":[{"Type":"NodeText","Data":"今出丹阳近道，形如桃子，小时气辛香，即《离骚》所呼辛夷者也。"}]},{"ID":"20240617110423-zrni7bp","Type":"NodeThematicBreak","Properties":{"id":"20240617110423-zrni7bp"}},{"ID":"20240617110424-6p45sj3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110424-6p45sj3","updated":"20240617110428"},"Children":[{"Type":"NodeText","Data":"辛夷《雷公炮制药性解》"}]},{"ID":"20240617110424-gzi4r44","Type":"NodeParagraph","Properties":{"id":"20240617110424-gzi4r44","updated":"20240617110424"},"Children":[{"Type":"NodeText","Data":"味辛，性温无毒，入肺胃二经。主身体寒热，头风脑痛，面肿齿痛，眩冒如在车船，温中气，利九窍，解肌表，通鼻塞，除浊涕，生须发，杀白虫，去面点。去毛及心用，芎为使，恶五灵脂，畏菖蒲，蒲黄、黄连、石膏、黄环。"}]},{"ID":"20240617110424-itlh90d","Type":"NodeParagraph","Properties":{"id":"20240617110424-itlh90d","updated":"20240617110424"},"Children":[{"Type":"NodeText","Data":"按∶辛夷辛温发散，太阴阳明之入，固其宜也。若肺胃虚热不受风邪者，勿得漫用。"}]},{"ID":"20240617110424-8myhpip","Type":"NodeParagraph","Properties":{"id":"20240617110424-8myhpip","updated":"20240617110424"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使之去粗皮，拭上赤肉毛了，即以芭蕉水浸一宿，漉出，用浆水煮，从巳至未出，焙干用。若治眼目中患，即一时去皮，用向里实者。"}]},{"ID":"20240617110433-scpokh5","Type":"NodeThematicBreak","Properties":{"id":"20240617110433-scpokh5"}},{"ID":"20240617110434-lht2gld","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110434-lht2gld","updated":"20240617110443"},"Children":[{"Type":"NodeText","Data":"辛夷《神农本草经百种录》"}]},{"ID":"20240617110434-ybgb59t","Type":"NodeParagraph","Properties":{"id":"20240617110434-ybgb59t","updated":"20240617110434"},"Children":[{"Type":"NodeText","Data":"味辛温。主五脏，身体寒热，清气下陷之疾。头风脑痛，升散风邪。面 。去皮毛之风滞。久服，下气，轻身，明目，增年耐老。清气上升则浊气下降，而百体清宁，可永年矣。"}]},{"ID":"20240617110434-soe3moz","Type":"NodeParagraph","Properties":{"id":"20240617110434-soe3moz","updated":"20240617110434"},"Children":[{"Type":"NodeText","Data":"辛夷与众木同植，必高于众木而后已，其性专于向上，故能升达清气。又得春气之最先，故能疏达肝气。又芳香清烈，能驱逐邪风头目之病。药不能尽达，此为之引也。"}]},{"ID":"20240617110410-4b3nnb5","Type":"NodeThematicBreak","Properties":{"id":"20240617110410-4b3nnb5"}},{"ID":"20240617110412-y3bq5b3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110412-y3bq5b3","updated":"20240617110416"},"Children":[{"Type":"NodeText","Data":"辛夷《本草述钩元》"}]},{"ID":"20240617110412-bo9k1du","Type":"NodeParagraph","Properties":{"id":"20240617110412-bo9k1du","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"宜于花未开时收之。正二月采。"}]},{"ID":"20240617110412-dcj3axw","Type":"NodeParagraph","Properties":{"id":"20240617110412-dcj3axw","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"苞"}]},{"ID":"20240617110412-i1p65qs","Type":"NodeParagraph","Properties":{"id":"20240617110412-i1p65qs","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"气味辛温。气清而香。味薄而散。浮而升。阳也。入手太阴足阳明经。芎为之使。主治风头脑痛。面肿引齿痛。通鼻塞涕出。疗鼻渊鼻鼽鼻疮鼻窒。及痘后鼻疮。（并研末。入麝之湖）〔论〕辛夷之所用者苞也。其花开于正二月。花落乃生叶。叶间随含花茁。经伏历冬。"}]},{"ID":"20240617110412-2uw3uxu","Type":"NodeParagraph","Properties":{"id":"20240617110412-2uw3uxu","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"茁阳中鼻者。亦同足太阳以行矣。所以鼻渊固病于脑。而必出于鼻。即鼻塞鼻鼽。虽未尝病于脑。"}]},{"ID":"20240617110412-aqcay1h","Type":"NodeParagraph","Properties":{"id":"20240617110412-aqcay1h","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"而不能于阴极。而阳之蓄于阴中者渐以滋长。犹阳之蓄于地也。至三阳交泰之候。而阳之出于阴中者。顿以宣发。犹阳之达于天也。蓄于地而达于天。犹人身之真阳首于足太阳。丽于足阳明。"}]},{"ID":"20240617110412-qns0kn4","Type":"NodeParagraph","Properties":{"id":"20240617110412-qns0kn4","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"乃至脑之类。虚如脑冷以及肾虚脑漏之类。）虽各有攸宜之剂。而必以此味为关捩子。不得徒以辛温壅而皆属于脑。脑者阴也。又曰何以能充髓于脑。而阴亦达于上乎。"}]},{"ID":"20240617110412-kpkzgom","Type":"NodeParagraph","Properties":{"id":"20240617110412-kpkzgom","updated":"20240617110412"},"Children":[{"Type":"NodeText","Data":"其性辛香走窜。气虚人不宜。头痛属血虚火炽。及齿痛属胃火者。皆禁用。（仲淳）〔修事〕去毛。免射人肺。去心。不致人烦。水洗。微炒。"}]},{"ID":"20240607145121-ysvp92p","Type":"NodeThematicBreak","Properties":{"id":"20240607145121-ysvp92p"}},{"ID":"20240607145040-9d5yi8s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145040-9d5yi8s","updated":"20240607145044"},"Children":[{"Type":"NodeText","Data":"辛夷《药性切用》"}]},{"ID":"20240607145040-9jjrfpx","Type":"NodeParagraph","Properties":{"id":"20240607145040-9jjrfpx","updated":"20240607145040"},"Children":[{"Type":"NodeText","Data":"一名迎春花，即木笔花。性味辛寒，轻浮入肺，兼入胃经，能引胃中清气上行，通于脑，为脑热鼻渊之专药。"}]},{"ID":"20240607145019-0l45uy2","Type":"NodeThematicBreak","Properties":{"id":"20240607145019-0l45uy2"}},{"ID":"20240607145020-jyke7t8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607145020-jyke7t8","updated":"20240607145028"},"Children":[{"Type":"NodeText","Data":"辛夷《证类本草》"}]},{"ID":"20240607145020-3kn83oa","Type":"NodeParagraph","Properties":{"id":"20240607145020-3kn83oa","updated":"20240607145020"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主五脏身体寒热，风头脑痛，面 ，温中解肌，利九窍，通鼻塞涕出，治面肿引齿痛，眩冒身兀兀如在车船之上者，生须发，去白虫。久服下气，轻身明目，增年耐老。可作膏药用之，去心及外毛。毛射人肺，令人咳。一名辛矧，一名候桃，一名房木。"}]},{"ID":"20240607145020-km2afne","Type":"NodeParagraph","Properties":{"id":"20240607145020-km2afne","updated":"20240607145020"},"Children":[{"Type":"NodeText","Data":"生汉中川谷。九月采实，曝干。（芎 为之使。恶五石脂，畏菖蒲、蒲黄、黄连、石膏、黄环。）"}]},{"ID":"20240607145020-vkhmjgv","Type":"NodeParagraph","Properties":{"id":"20240607145020-vkhmjgv","updated":"20240607145020"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出丹阳近道。形如桃子，小时气辛香。即《离骚》所呼辛夷者。唐本注云∶此是树花未开时收之。正月、二月好采。今见用者是。其九月采实者，恐误。其树大，连合抱，高数仞。叶大于柿叶。所在皆有。实臭不任药也。方云去毛用其心，然难得而滋人面，此用花开者易得，而且香也。今按陈藏器本草云∶辛夷，今时所用者，是未发花时如小桃子，有毛，未折时取之。所云用花开者，及在二月，此殊误尔。此花，江南地暖正月开；北地寒二月开。初发如笔，北人呼为木笔。其花最早，南人呼为迎春。臣禹锡等谨按蜀本图经云∶树高数仞。叶似柿叶而狭长。正月、二月，花似着毛小桃，色白而带紫。花落而无子。夏杪复着花，如小笔。又有一种，三月花开，四月花落，子赤似相思子。花、叶与无子者同。取花欲开者胜，所在山谷皆有。此二种，今苑中有树，高三、四丈，花、叶一如《图经》所说，但树身径二尺许，去根三尺以来便有枝柯，繁茂可爱。正月、二月花开，紫白色。花落复生叶，至夏初还生花如小笔。经秋历冬，叶、花渐大，如有毛小桃，至来年正月、二月始开。初是兴元府进来，其树才可三、四尺，有花无子，谓之木笔花。树种经二十余载方结实。以此推之。即是年岁浅者无子，非有二种也。其花开早晚，应各随其土风尔。药性论云∶辛夷，臣。能治面生 ，面脂用，主光华。日华子云∶通关脉图经曰∶辛夷，生汉中川谷。今处处有之，人家园庭亦多种植。木高数丈，叶似柿而长。"}]},{"ID":"20240607145020-fmo4926","Type":"NodeParagraph","Properties":{"id":"20240607145020-fmo4926","updated":"20240607145020"},"Children":[{"Type":"NodeText","Data":"正月、二月生花似着毛小桃子，色白带紫。花落无子。至夏复开花，初出如笔，故北人呼为木笔花。又有一种，枝、叶并相类，但岁一开花，四月花落时，有子如相思子。或云都是一种。经一、二十年老者，方结实耳。其花开早晚，亦随南北节气寒温。九月采实，暴干用。"}]},{"ID":"20240607145020-ozqsji9","Type":"NodeParagraph","Properties":{"id":"20240607145020-ozqsji9","updated":"20240607145020"},"Children":[{"Type":"NodeText","Data":"或云∶用花蕊缩者良。已开者劣，谢者不佳。"}]},{"ID":"20240607145020-mudmko3","Type":"NodeParagraph","Properties":{"id":"20240607145020-mudmko3","updated":"20240607145020"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡用之，去粗皮，拭上赤肉毛了，即以芭蕉水浸一宿漉出，用浆水煮，从巳至未，出，焙干用。若治眼目中患，即一时去皮用向里实者。屈平九歌∶乘赤豹兮从文狸，辛夷车兮结桂旗。注∶辛夷，香草也。言山鬼出入乘赤豹从神狸，结桂与辛夷以为车旗，言有香洁也衍义曰∶辛夷，先花后叶，即木笔花也。最先春以具花，未开时，其花苞有毛，光长如笔，故取象曰木笔。有红、紫二本∶一本如桃花色者，一本紫者。今入药当用紫色者，仍须未开时收取。入药当去毛苞。"}]},{"ID":"20240617110333-fy2ejpn","Type":"NodeThematicBreak","Properties":{"id":"20240617110333-fy2ejpn"}},{"ID":"20240617110334-a7ge0eu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110334-a7ge0eu","updated":"20240617110338"},"Children":[{"Type":"NodeText","Data":"辛夷《本草害利》"}]},{"ID":"20240617110334-qodg0xk","Type":"NodeParagraph","Properties":{"id":"20240617110334-qodg0xk","updated":"20240617110334"},"Children":[{"Type":"NodeText","Data":"〔害〕辛香走窜之性，气虚人偶感风寒而鼻塞者，禁之。头脑痛，属血虚火炽，及齿痛属胃火者，服之转甚。毛射入肺中，令人咳。"}]},{"ID":"20240617110334-160y35r","Type":"NodeParagraph","Properties":{"id":"20240617110334-160y35r","updated":"20240617110334"},"Children":[{"Type":"NodeText","Data":"〔利〕入肺胃二经。宣散上焦风热，辛温开窍，鼻塞与昏冒咸宜。清阳解肌，壮热与憎寒并选。"}]},{"ID":"20240617110334-kodg1ir","Type":"NodeParagraph","Properties":{"id":"20240617110334-kodg1ir","updated":"20240617110334"},"Children":[{"Type":"NodeText","Data":"味薄而散，能助胃中清气，上达高巅头面九窍，皆归治平也。"}]},{"ID":"20240617110334-ywup985","Type":"NodeParagraph","Properties":{"id":"20240617110334-ywup985","updated":"20240617110334"},"Children":[{"Type":"NodeText","Data":"〔修治〕九月采实，曝，去心及外皮毛，入药微焙。"}]},{"ID":"20240617110054-1oal8j2","Type":"NodeThematicBreak","Properties":{"id":"20240617110054-1oal8j2"}},{"ID":"20240617110055-t0z7moj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110055-t0z7moj","updated":"20240617110101"},"Children":[{"Type":"NodeText","Data":"辛夷《中药学》"}]},{"ID":"20240617110055-qgg5fci","Type":"NodeParagraph","Properties":{"id":"20240617110055-qgg5fci","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【药用】本品为木兰科植物木兰的花蕾。"}]},{"ID":"20240617110055-oga6jix","Type":"NodeParagraph","Properties":{"id":"20240617110055-oga6jix","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛，温。入肺、胃经。"}]},{"ID":"20240617110055-mlzd33c","Type":"NodeParagraph","Properties":{"id":"20240617110055-mlzd33c","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【功效】散风，通窍。"}]},{"ID":"20240617110055-gegud2u","Type":"NodeParagraph","Properties":{"id":"20240617110055-gegud2u","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于鼻渊鼻塞，流涕腥臭等症。"}]},{"ID":"20240617110055-pui3zqu","Type":"NodeParagraph","Properties":{"id":"20240617110055-pui3zqu","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"本品入肺经，上通于鼻，以散风寒，故临床上用于治疗鼻多浊涕、不闻香臭的鼻渊症，常与白芷、细辛、防风、苍耳子等配伍应用。"}]},{"ID":"20240617110055-ilop7vy","Type":"NodeParagraph","Properties":{"id":"20240617110055-ilop7vy","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【处方用名】辛夷、辛夷花、木笔花、春花（晒干用）"}]},{"ID":"20240617110055-mhxun3i","Type":"NodeParagraph","Properties":{"id":"20240617110055-mhxun3i","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至二钱，煎服。"}]},{"ID":"20240617110055-mytgd3h","Type":"NodeParagraph","Properties":{"id":"20240617110055-mytgd3h","updated":"20240617110055"},"Children":[{"Type":"NodeText","Data":"【方剂举例】辛夷散（《济生方》）辛夷、白芷、升麻、藁本、防风、川芎、细辛、木通、甘草。治头痛头风、鼻渊鼻塞。"}]},{"ID":"20240607144724-y3ezjws","Type":"NodeThematicBreak","Properties":{"id":"20240607144724-y3ezjws"}},{"ID":"20240607144727-vyxo6wx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144727-vyxo6wx","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"《中国药典》：辛夷"}]},{"ID":"20240607144727-vif0v95","Type":"NodeParagraph","Properties":{"id":"20240607144727-vif0v95","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607144727-d034fe8","Type":"NodeParagraph","Properties":{"id":"20240607144727-d034fe8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" Xīn Yí"}]},{"ID":"20240607144727-x49hh1q","Type":"NodeParagraph","Properties":{"id":"20240607144727-x49hh1q","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607144727-j2s60gz","Type":"NodeParagraph","Properties":{"id":"20240607144727-j2s60gz","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 木笔花、望春花、春花、木兰、紫玉兰、白玉兰、二月花、广玉兰"}]},{"ID":"20240607144727-p0jhvu0","Type":"NodeParagraph","Properties":{"id":"20240607144727-p0jhvu0","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607144727-3wtwpcx","Type":"NodeParagraph","Properties":{"id":"20240607144727-3wtwpcx","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" FLOS MAGNOLIAE"}]},{"ID":"20240607144727-07bh13s","Type":"NodeParagraph","Properties":{"id":"20240607144727-07bh13s","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607144727-i3ryj4w","Type":"NodeParagraph","Properties":{"id":"20240607144727-i3ryj4w","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 本品为木兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"望春花"},{"Type":"NodeText","Data":"Magnolia biondii Pamp.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玉兰"},{"Type":"NodeText","Data":"Magnolia denudata Desv.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"武当玉兰"},{"Type":"NodeText","Data":"Magnolia sprengeri Pamp.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花蕾"},{"Type":"NodeText","Data":"。冬末春初花未开放时采收，除去枝梗，阴干。"}]},{"ID":"20240607144727-ze9q2wo","Type":"NodeParagraph","Properties":{"id":"20240607144727-ze9q2wo","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607144727-ps0tdwy","Type":"NodeParagraph","Properties":{"id":"20240607144727-ps0tdwy","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 望春花：本品呈长卵形，似毛笔头，长1.2～2.5cm，直径0.8～1.5cm。基部常具短梗，长约5mm,梗上有类白色点状皮孔。苞片2～3层，每层2片，两层苞片间有小鳞芽，苞片外表面密被灰白色或灰绿色茸毛，内表面类棕色，无毛。花被片9,类棕色，外轮花被片3,条形，约为内两轮长的1/4,呈萼片状，内两轮花被片6,每轮3,轮状排列。雄蕊和雌蕊多数，螺旋状排列。体轻，质脆。气芳香，味辛凉而稍苦。"}]},{"ID":"20240607144727-e0pt92r","Type":"NodeParagraph","Properties":{"id":"20240607144727-e0pt92r","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"玉兰：长1.5～3cm，直径1～1.5cm。基部枝梗较粗壮，皮孔浅棕色。苞片外表面密被灰白色或灰绿色茸毛。花被片9,内外轮同型。"}]},{"ID":"20240607144727-5smy4i3","Type":"NodeParagraph","Properties":{"id":"20240607144727-5smy4i3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"武当玉兰：长2～4cm，直径1～2cm。基部枝梗粗壮，皮孔红棕色。苞片外表面密被淡黄色或淡黄绿色茸毛，有的最外层苞片茸毛已脱落而呈黑褐色。花被片10～12（15），内外轮无显著差异。"}]},{"ID":"20240607144727-qee9s8f","Type":"NodeParagraph","Properties":{"id":"20240607144727-qee9s8f","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607144727-d77z3ep","Type":"NodeParagraph","Properties":{"id":"20240607144727-d77z3ep","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240607144727-q7all9l","Type":"NodeParagraph","Properties":{"id":"20240607144727-q7all9l","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607144727-6i8bbj1","Type":"NodeParagraph","Properties":{"id":"20240607144727-6i8bbj1","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末灰绿色或淡黄绿色。非腺毛甚多，散在，多碎断；完整者2～4细胞，亦有单细胞，壁厚4～13μm，基部细胞短粗膨大，细胞壁极度增厚似石细胞。石细胞多成群，呈椭圆形、不规则形或分枝状，壁厚4～20μm，孔沟不甚明显，胞腔中可见棕黄色分泌物。油细胞较多，类圆形，有的可见微小油滴。苞片表皮细胞扁方形，垂周壁连珠状。"}]},{"ID":"20240607144727-m8yar5a","Type":"NodeParagraph","Properties":{"id":"20240607144727-m8yar5a","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"（2）取本品粗粉1g，加氯仿10ml，密塞，超声处理30分钟，滤过，滤液蒸干，残渣加氯仿2ml使溶解，作为供试品溶液。另取木兰脂素对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2～10μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶 H 薄层板上，以氯仿-乙醚（5：1）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在90℃加热至斑点显色清晰。供试品色谱中,在与对照品色谱相应的位置上，显相同的紫红色斑点。"}]},{"ID":"20240607144727-40d49bi","Type":"NodeParagraph","Properties":{"id":"20240607144727-40d49bi","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607144727-dzk68u3","Type":"NodeParagraph","Properties":{"id":"20240607144727-dzk68u3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 归肺、胃经。"}]},{"ID":"20240607144727-91d9lrx","Type":"NodeParagraph","Properties":{"id":"20240607144727-91d9lrx","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607144727-15jtwgh","Type":"NodeParagraph","Properties":{"id":"20240607144727-15jtwgh","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240607144727-wmm7lwu","Type":"NodeParagraph","Properties":{"id":"20240607144727-wmm7lwu","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607144727-x7cu3bg","Type":"NodeParagraph","Properties":{"id":"20240607144727-x7cu3bg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 散风寒，通鼻窍。用于风寒头痛，鼻塞，鼻渊，鼻流浊涕。"}]},{"ID":"20240607144727-tfcj5cm","Type":"NodeParagraph","Properties":{"id":"20240607144727-tfcj5cm","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607144727-suzp3nl","Type":"NodeParagraph","Properties":{"id":"20240607144727-suzp3nl","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 3～9g；外用适量。"}]},{"ID":"20240607144727-4xxbef2","Type":"NodeParagraph","Properties":{"id":"20240607144727-4xxbef2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607144727-pi95g4d","Type":"NodeParagraph","Properties":{"id":"20240607144727-pi95g4d","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" （1）同属植物尚有下列数种的花蕾在不同地区也作辛夷入药："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辛夷（木兰、紫玉兰）"},{"Type":"NodeText","Data":"Magnolia liliflora Desr.[M. quinquepeta （Buc’hoz）Dandy]；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"应春花（二月花）"},{"Type":"NodeText","Data":"Magnolia diva stapf[M. denudata Desr. var. purpurascens Rehd. et Wils.]；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滇藏木兰"},{"Type":"NodeText","Data":"Magnolia campbellii Hook. f. et Thoms.；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荷花玉兰（广玉兰）"},{"Type":"NodeText","Data":"Magnolia grandiflora L.。"}]},{"ID":"20240607144727-6nqiq9v","Type":"NodeParagraph","Properties":{"id":"20240607144727-6nqiq9v","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"（2）本品入肺经，上通于鼻，以散风寒，故临床上用于治疗鼻多浊涕、不闻香臭的鼻渊症，常与白芷、细辛、防风、苍耳子等配伍应用。"}]},{"ID":"20240607144727-q03kz51","Type":"NodeParagraph","Properties":{"id":"20240607144727-q03kz51","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607144727-2lktf75","Type":"NodeParagraph","Properties":{"id":"20240607144727-2lktf75","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607144727-qyi4p2x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144727-qyi4p2x","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：辛夷"}]},{"ID":"20240607144727-f816rtb","Type":"NodeParagraph","Properties":{"id":"20240607144727-f816rtb","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607144727-9lwtq8m","Type":"NodeParagraph","Properties":{"id":"20240607144727-9lwtq8m","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" Xīn Yí"}]},{"ID":"20240607144727-k8c9kzd","Type":"NodeParagraph","Properties":{"id":"20240607144727-k8c9kzd","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607144727-hjefgoy","Type":"NodeParagraph","Properties":{"id":"20240607144727-hjefgoy","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 辛矧、侯桃、房木（《本经》），新雉（《甘泉赋》），迎春（《本草拾遗》），木笔花（《蜀本草》），毛辛夷、辛夷桃（《山西中药志》），姜朴花（《四川中药志》）。"}]},{"ID":"20240607144727-8qjgt6u","Type":"NodeParagraph","Properties":{"id":"20240607144727-8qjgt6u","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607144727-mbw5wpi","Type":"NodeParagraph","Properties":{"id":"20240607144727-mbw5wpi","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607144727-3amhzf8","Type":"NodeParagraph","Properties":{"id":"20240607144727-3amhzf8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607144727-x8ozf0b","Type":"NodeParagraph","Properties":{"id":"20240607144727-x8ozf0b","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 为木兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辛夷"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玉兰"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花蕾"},{"Type":"NodeText","Data":"。一般在早春花蕾未放时采摘，剪去枝梗，干燥即可。"}]},{"ID":"20240607144727-o2wue5i","Type":"NodeParagraph","Properties":{"id":"20240607144727-o2wue5i","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607144727-brta71c","Type":"NodeParagraph","Properties":{"id":"20240607144727-brta71c","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 全国大部分地区有产，主产河南、四川、安徽、浙江、陕西、湖北等地。"}]},{"ID":"20240607144727-c00ih3h","Type":"NodeParagraph","Properties":{"id":"20240607144727-c00ih3h","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607144727-gq89c3y","Type":"NodeParagraph","Properties":{"id":"20240607144727-gq89c3y","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" ①辛夷，又名：林兰（《本经》），木栏、桂栏（《广雅》），杜兰（《别录》），木兰、紫玉兰。"}]},{"ID":"20240607144727-cpjxt5m","Type":"NodeParagraph","Properties":{"id":"20240607144727-cpjxt5m","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"落叶灌木，高3～4米。干皮灰白色；小枝紫褐色，平滑无毛，具纵阔椭圆形皮孔，浅白棕色；顶生冬芽卵形，长1～1.5厘米，被淡灰绿色绢毛，腋芽小，长2～3毫米。叶互生，具短柄，柄长1.5-2厘米，无毛，有时稍具短毛；叶片椭圆形或倒卵状椭圆形，长10～16厘米，宽5～8.5厘米，先端渐尖，基部圆形，或呈圆楔形，全缘，两面均光滑无毛，有时于叶缘处具极稀短毛，表面绿色，背面浅绿色，主脉凸出。花于叶前开放，或近同时开放，单一，生于小枝顶端；花萼3片，绿色，卵状披针形，长约为花瓣的1／4～1／3，通常早脱；花冠6片，外面紫红色，内面白色，倒卵形，长8厘米左右，雄蕊多数，螺旋排列，花药线形，花丝短；心皮多数分离，亦螺旋排列，花柱短小尖细。果实长椭圆形，有时稍弯曲。花期2～5月。"}]},{"ID":"20240607144727-n03ncy8","Type":"NodeParagraph","Properties":{"id":"20240607144727-n03ncy8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"生长于较温暖地区。原分布湖北、安徽、浙江、福建一带，现在野生较少，在山东、四川、江西、湖北、云南、陕西南部、河南等地广泛栽培。"}]},{"ID":"20240607144727-6noejjq","Type":"NodeParagraph","Properties":{"id":"20240607144727-6noejjq","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"本植物的树皮（木兰皮）、花（木兰花）亦供药用，各详专条。"}]},{"ID":"20240607144727-xb9vd5p","Type":"NodeParagraph","Properties":{"id":"20240607144727-xb9vd5p","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②玉兰（《学圃杂疏》），又名白木莲（《本草纲目启蒙》）、应春花、玉堂春、白玉兰。"}]},{"ID":"20240607144727-j76qh0d","Type":"NodeParagraph","Properties":{"id":"20240607144727-j76qh0d","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高达15米。树冠卵形，分枝少，幼枝有毛。叶互生；叶柄长1～2.5厘米，被柔毛；叶片倒卵形，或倒卵状矩圆形，长8～16厘米，宽5～10厘米，先端阔而突尖，基部渐狭，全缘，上面绿色，脉上被疏毛，下面淡绿色，被灰白色柔毛；冬芽密生绒毛。花大，单生，先叶开放，杯状，直径10～15厘米，白色，或外面紫色而内面白色；花梗粗短，密生黄褐色柔毛；花萼与花瓣相似，9片，倒卵形或卵状矩圆形；雄蕊多数，花丝扁平；心皮多数，卵形，聚生于延长的花托上。果实圆筒形，长7～10厘米。花期2月。果期6～7月。"}]},{"ID":"20240607144727-u4oq5is","Type":"NodeParagraph","Properties":{"id":"20240607144727-u4oq5is","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"多栽培或野生于阔叶林中。分布河南、山东、江苏、浙江、安徽、江西、福建、广东、广西、四川、云南、贵州、陕西等地。"}]},{"ID":"20240607144727-84wfp95","Type":"NodeParagraph","Properties":{"id":"20240607144727-84wfp95","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"本植物的花（玉兰花）亦供药用，另详专条。"}]},{"ID":"20240607144727-9tbd8ch","Type":"NodeParagraph","Properties":{"id":"20240607144727-9tbd8ch","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607144727-9xy5at7","Type":"NodeParagraph","Properties":{"id":"20240607144727-9xy5at7","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 干燥的花蕾，呈倒圆锥状，形如毛笔头，基部带有木质短枝。花蕾长1～4厘米，中部直径0.7～2厘米。外裹苞片2枚成两层，两层之间尚可见小芽鳞。苞片表面密被黄绿色柔软长毛，毛茸长约5毫米，内表面平滑，棕紫色。除去苞片后可见3片花萼与6～12片紧密相包的棕紫色花瓣，其内有多数棕黄色雄蕊与1枚褐色雌蕊。质脆易破碎。有特殊香气，味辛凉而稍苦。以花蕾未开，身干，色绿，无枝梗者为佳。"}]},{"ID":"20240607144727-rbjusse","Type":"NodeParagraph","Properties":{"id":"20240607144727-rbjusse","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607144727-5u956mf","Type":"NodeParagraph","Properties":{"id":"20240607144727-5u956mf","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 玉兰花蕾含挥发油，中含柠檬醛、丁香油酚，1，8-桉叶素。根含木兰花碱。叶和果实都含芍药素的甙。"}]},{"ID":"20240607144727-mjmfgvw","Type":"NodeParagraph","Properties":{"id":"20240607144727-mjmfgvw","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"从望春花花蕾中提出一种生物碱结晶。另还分出松树脂醇二甲醚，鹅掌楸树脂醇B二甲醚、望春花素和发氏玉兰素等木脂体成分。"}]},{"ID":"20240607144727-fk6nhr2","Type":"NodeParagraph","Properties":{"id":"20240607144727-fk6nhr2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607144727-6mndyv6","Type":"NodeParagraph","Properties":{"id":"20240607144727-6mndyv6","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" ①降压作用"}]},{"ID":"20240607144727-694n18x","Type":"NodeParagraph","Properties":{"id":"20240607144727-694n18x","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"以辛夷花苞干燥粉末的水、醇提取物对麻醉动物（狗、猫、兔、大鼠等）静脉、腹腔、肌肉注射均有降压作用。肌肉注射对未麻醉狗也出现降压作用，1克/公斤（按生药计算）时降低血压约40％以上，对实验性肾性高血压大鼠，亦出现降压作用，对肾性高血压的狗则效果不明显，但对老年性\"原发性\"高血压狗则有明显的降压效果。降压成分在去油水溶液中转溶于乙醚之部分。在降压原理方面，与中枢神经系统似无甚关系，而是直接抑制心脏，特别是扩张血管以及神经节阻断而来。口服时降压作用不明显，可能因有效成分不易被吸收的原故。根含木兰花碱，故有降压作用。"}]},{"ID":"20240607144727-812slmd","Type":"NodeParagraph","Properties":{"id":"20240607144727-812slmd","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②对横纹肌的作用"}]},{"ID":"20240607144727-mmbfi0h","Type":"NodeParagraph","Properties":{"id":"20240607144727-mmbfi0h","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"望春花花蕾中的生物碱结晶在蛙腹直肌标本上，有箭毒样作用；而水煎剂则相反，有乙酰胆碱样作用。用不同提取方法在上述标本上作比较试验，证明望春花花蕾与日本产的花蕾性质相同，而前者作用较强。"}]},{"ID":"20240607144727-cihi414","Type":"NodeParagraph","Properties":{"id":"20240607144727-cihi414","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"③对子宫的作用"}]},{"ID":"20240607144727-43smft6","Type":"NodeParagraph","Properties":{"id":"20240607144727-43smft6","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"在大鼠及家兔离体子宫，狗及家兔在位子宫及子宫瘘管的实验中，证明辛夷煎剂、流浸膏对子宫有兴奋作用，且在未明显影响血压、呼吸之剂量，即能呈现此种作用。并谓辛夷内所含的兴奋子宫成分为溶于水及乙醇的非挥发性物质。"}]},{"ID":"20240607144727-8r1vfx3","Type":"NodeParagraph","Properties":{"id":"20240607144727-8r1vfx3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240607144727-z0hy0gq","Type":"NodeParagraph","Properties":{"id":"20240607144727-z0hy0gq","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"15～30％辛夷煎剂对多种致病性真菌有抑制作用。浸剂或煎剂对动物有局部麻醉作用（对豚鼠的浸润麻醉及对蛙的阻断麻醉）。日本辛夷M.kobus对淋巴球性脉络丛脑膜炎病毒在体外、体内（小鼠皮下注射其煎剂）均有明显的抗病毒作用。"}]},{"ID":"20240607144727-n1z0wxd","Type":"NodeParagraph","Properties":{"id":"20240607144727-n1z0wxd","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607144727-s5vewnx","Type":"NodeParagraph","Properties":{"id":"20240607144727-s5vewnx","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 拣净枝梗杂质，捣碎用。"}]},{"ID":"20240607144727-cw9ypni","Type":"NodeParagraph","Properties":{"id":"20240607144727-cw9ypni","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"《日华子本草》：\"入药微炙，已开者劣，谢者不佳。\""}]},{"ID":"20240607144727-bqxjx9m","Type":"NodeParagraph","Properties":{"id":"20240607144727-bqxjx9m","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607144727-680dqmq","Type":"NodeParagraph","Properties":{"id":"20240607144727-680dqmq","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 入肺、胃经。"}]},{"ID":"20240607144727-aazbf83","Type":"NodeParagraph","Properties":{"id":"20240607144727-aazbf83","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入手太阴、足阳明经。\""}]},{"ID":"20240607144727-1qu8h0q","Type":"NodeParagraph","Properties":{"id":"20240607144727-1qu8h0q","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入肺、胆二经。\""}]},{"ID":"20240607144727-hxux510","Type":"NodeParagraph","Properties":{"id":"20240607144727-hxux510","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入脾、肺二经。\""}]},{"ID":"20240607144727-2mko31v","Type":"NodeParagraph","Properties":{"id":"20240607144727-2mko31v","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"④《本草撮要》：\"入足厥阴经。\""}]},{"ID":"20240607144727-nxa7g4s","Type":"NodeParagraph","Properties":{"id":"20240607144727-nxa7g4s","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607144727-wh2q682","Type":"NodeParagraph","Properties":{"id":"20240607144727-wh2q682","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240607144727-a16pdvs","Type":"NodeParagraph","Properties":{"id":"20240607144727-a16pdvs","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240607144727-fegh62q","Type":"NodeParagraph","Properties":{"id":"20240607144727-fegh62q","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607144727-6cyaie3","Type":"NodeParagraph","Properties":{"id":"20240607144727-6cyaie3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"性温，味辛微苦。\""}]},{"ID":"20240607144727-isn7nw2","Type":"NodeParagraph","Properties":{"id":"20240607144727-isn7nw2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607144727-wivrh6s","Type":"NodeParagraph","Properties":{"id":"20240607144727-wivrh6s","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 阴虚火旺者忌服。"}]},{"ID":"20240607144727-62f53t3","Type":"NodeParagraph","Properties":{"id":"20240607144727-62f53t3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"芎藭为之使。恶五石脂。畏菖蒲、蒲黄、黄连、石膏、黄环。\""}]},{"ID":"20240607144727-co69yt5","Type":"NodeParagraph","Properties":{"id":"20240607144727-co69yt5","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②《本草经巯》：\"凡气虚人忌，头脑痛属血虚火炽者忌，齿痛属胃火者忌。\""}]},{"ID":"20240607144727-ow9vr2e","Type":"NodeParagraph","Properties":{"id":"20240607144727-ow9vr2e","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"气虚之人，虽偶感风寒，致诸窍不通者，不宜用。\""}]},{"ID":"20240607144727-5qchyeg","Type":"NodeParagraph","Properties":{"id":"20240607144727-5qchyeg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607144727-nfxhglg","Type":"NodeParagraph","Properties":{"id":"20240607144727-nfxhglg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 祛风，通窍。治头痛，鼻渊，鼻塞不通，齿痛。"}]},{"ID":"20240607144727-5t8vsru","Type":"NodeParagraph","Properties":{"id":"20240607144727-5t8vsru","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五脏身体寒热，风头脑痛，面酐。\""}]},{"ID":"20240607144727-623s4l2","Type":"NodeParagraph","Properties":{"id":"20240607144727-623s4l2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"温中解肌，利九窍，通鼻塞、涕出，治面肿引齿痛，眩冒、身几几如在车船之上者。生须发，去白虫。\""}]},{"ID":"20240607144727-0vqp11z","Type":"NodeParagraph","Properties":{"id":"20240607144727-0vqp11z","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能治面生酐。面脂用，主光华。\""}]},{"ID":"20240607144727-1e1z3wg","Type":"NodeParagraph","Properties":{"id":"20240607144727-1e1z3wg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"通关脉，明目。治头痛，憎寒、体噤、瘙痒。\""}]},{"ID":"20240607144727-80ykp1a","Type":"NodeParagraph","Properties":{"id":"20240607144727-80ykp1a","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"治脑漏鼻渊，祛风，新瓦焙为末。治面寒痛，胃气痛，热洒服。\""}]},{"ID":"20240607144727-79ob0oy","Type":"NodeParagraph","Properties":{"id":"20240607144727-79ob0oy","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"鼻渊、鼻鼽、鼻窒、鼻疮及痘后鼻疮，并用研末，入麝香少许，葱白蘸入数次。\""}]},{"ID":"20240607144727-gyluj2g","Type":"NodeParagraph","Properties":{"id":"20240607144727-gyluj2g","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑦《玉楸药解》：\"泄肺降逆，利气破壅。\""}]},{"ID":"20240607144727-4g47adt","Type":"NodeParagraph","Properties":{"id":"20240607144727-4g47adt","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑧《江西中药》：\"外用能促进子宫收缩，具催生作用。\""}]},{"ID":"20240607144727-4qu9zjq","Type":"NodeParagraph","Properties":{"id":"20240607144727-4qu9zjq","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607144727-c9vh4xn","Type":"NodeParagraph","Properties":{"id":"20240607144727-c9vh4xn","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。外用：研末塞鼻或水浸蒸馏滴鼻。"}]},{"ID":"20240607144727-l3gftqp","Type":"NodeParagraph","Properties":{"id":"20240607144727-l3gftqp","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607144727-wt8p6s3","Type":"NodeParagraph","Properties":{"id":"20240607144727-wt8p6s3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" ①治鼻渊：辛夷半两，苍耳子二钱半，香白芷一两，薄荷叶半钱。上并晒干，为细末。每服二钱，用葱、茶清食后调服。（《济生方》苍耳散）"}]},{"ID":"20240607144727-okh0ixb","Type":"NodeParagraph","Properties":{"id":"20240607144727-okh0ixb","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"②治鼻炎、鼻窦炎：㈠辛夷三钱，鸡蛋三个。同煮，吃蛋饮汤。（《单方验方调查资料选编》）㈡辛夷四份，鹅不食草一份。用水浸泡4～8小时后蒸馏，取芳香水，滴鼻。（广东《中草药处方选编》）"}]},{"ID":"20240607144727-zbmorx2","Type":"NodeParagraph","Properties":{"id":"20240607144727-zbmorx2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"③治鼻漏，鼻孔中长出一块：辛夷（去毛）、桑白皮（蜜炙）各四两，栀子一两，枳实、桔梗、白芷各二两。共为细末。每服二钱，淡萝卜汤调服。（《疡医大全》）"}]},{"ID":"20240607144727-xygh951","Type":"NodeParagraph","Properties":{"id":"20240607144727-xygh951","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"④治鼻内窒塞不通，不得喘息：辛夷、芎藭各-两，细辛（去苗）七钱半，木通半两。上为细末。每用少许，绵裹塞鼻中，湿则易之。五，七日瘥。（《证治准绳》芎藭散）"}]},{"ID":"20240607144727-ht2qvaj","Type":"NodeParagraph","Properties":{"id":"20240607144727-ht2qvaj","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑤治鼻塞不知香味：皂角、辛夷、石菖蒲等分。为末。绵裹塞鼻中。（《梅氏验方新编》）"}]},{"ID":"20240607144727-9idbruc","Type":"NodeParagraph","Properties":{"id":"20240607144727-9idbruc","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑥治鼻内作胀或生疮（此系酒毒者多）：辛夷一两，川黄连五钱，连翘二两。俱微炒，研为末。每饭后服三钱，白汤下。（《缪氏方选》）"}]},{"ID":"20240607144727-y2z7794","Type":"NodeParagraph","Properties":{"id":"20240607144727-y2z7794","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑦治齿牙作痛，或肿或牙龈浮烂：辛夷一两，蛇床子二两，青盐五钱。共为末掺之。（《本草汇言》）"}]},{"ID":"20240607144727-shxvxs3","Type":"NodeParagraph","Properties":{"id":"20240607144727-shxvxs3","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑧治头面肿痒如虫行（此属风痰）：辛夷一两，白附子、半夏、天花粉、白芷、僵蚕、玄参、赤芍各五钱，薄荷八钱。分作十剂服。（《古今医准》）"}]},{"ID":"20240607144727-bzbwlr2","Type":"NodeParagraph","Properties":{"id":"20240607144727-bzbwlr2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"⑨治头眩昏冒欲呕（此属寒痰）：辛夷一两，制半夏、胆星、天麻、干姜、川芎各八钱。为末，水泛为丸。每晚服三钱，白汤下。（《本草汇言》）"}]},{"ID":"20240607144727-387ijn9","Type":"NodeParagraph","Properties":{"id":"20240607144727-387ijn9","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607144727-f6p1k0i","Type":"NodeParagraph","Properties":{"id":"20240607144727-f6p1k0i","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 治疗鼻炎：取辛夷50克碾碎后，用醇浸泡3天过滤，滤液加热蒸发浓缩成粘稠状浸膏，以20克无水羊毛脂混合调匀，再加凡士林100克调匀即成软膏。用时作成12x3厘米的油纱条，填入鼻腔，如下鼻甲甚肥大，纱条不易填入时，可先滴1％麻黄素后再填入。纱条之一端应露于鼻孔之外，并加粘膏固定，以免滑入咽内。2～3小时后取出。每日或隔日填塞1次，10次为一疗程。一般皆在4～5次后鼻通气情况开始好转，但亦有10次后始见效果的。鼻腔通气好转后仍需继续填塞5～10次，以期巩固。治疗肥大性鼻炎100例，多数经2年观察，痊愈者（鼻腔通气良好，头痛消失，分泌物减少，鼻甲已不肥大）44％；进步者（鼻通气情况及鼻甲肥大情况均较前大有改善，但仍未完.全正常）44％；无效者（经一疗程以上自觉或他觉症状皆无改善）12％。此外，亦可将辛夷制成煎剂、油剂、乳剂、麻油合剂等，用棉条浸透后塞鼻。据228人次的观察，对肥厚性鼻炎和急性鼻炎的收敛作用很明显；一般以乳剂与浓油效果最佳，油剂次之，煎剂又次之，麻油合剂较差。"}]},{"ID":"20240607144727-f72zeo2","Type":"NodeParagraph","Properties":{"id":"20240607144727-f72zeo2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607144727-n7ry0w1","Type":"NodeParagraph","Properties":{"id":"20240607144727-n7ry0w1","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 此外，河南尚有以同属植物望春花的花蕾作辛夷；西藏地区则以滇藏玉兰的花蕾作辛夷。"}]},{"ID":"20240607144727-3b493jv","Type":"NodeParagraph","Properties":{"id":"20240607144727-3b493jv","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607144727-j6p0xjl","Type":"NodeParagraph","Properties":{"id":"20240607144727-j6p0xjl","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607144727-s1dhewi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144727-s1dhewi","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"《中华本草》：辛夷"}]},{"ID":"20240607144727-qzedpkg","Type":"NodeParagraph","Properties":{"id":"20240607144727-qzedpkg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607144727-bsp0pkv","Type":"NodeParagraph","Properties":{"id":"20240607144727-bsp0pkv","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" Xīn Yí"}]},{"ID":"20240607144727-79mpzbz","Type":"NodeParagraph","Properties":{"id":"20240607144727-79mpzbz","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607144727-8omtxbi","Type":"NodeParagraph","Properties":{"id":"20240607144727-8omtxbi","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 辛矧、侯桃、房木、辛雉、迎春、木笔花、毛辛夷、姜朴花"}]},{"ID":"20240607144727-hb48uvs","Type":"NodeParagraph","Properties":{"id":"20240607144727-hb48uvs","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607144727-6m3gri1","Type":"NodeParagraph","Properties":{"id":"20240607144727-6m3gri1","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607144727-ovcrjm4","Type":"NodeParagraph","Properties":{"id":"20240607144727-ovcrjm4","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：辛夷，是树花，未开时收之，正月、二月好采。其树大连抱，高数仞，叶大于柿叶，所在皆有。实臭，不任药也。"}]},{"ID":"20240607144727-t2wjf3h","Type":"NodeParagraph","Properties":{"id":"20240607144727-t2wjf3h","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.《本草衍义》：辛夷有红紫二本，一本如桃花色者，一本紫者，今入药当用紫色者。"}]},{"ID":"20240607144727-fohfihu","Type":"NodeParagraph","Properties":{"id":"20240607144727-fohfihu","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：辛夷花，初出枝头，苞长半寸，而尖锐俨如笔头，重重有青黄茸毛顺铺，长半分许，及开则似莲花而小如盏，紫苞红焰，作莲及兰花香。亦有白色者，人呼为玉兰。"}]},{"ID":"20240607144727-9hfqggu","Type":"NodeParagraph","Properties":{"id":"20240607144727-9hfqggu","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607144727-vxbui6x","Type":"NodeParagraph","Properties":{"id":"20240607144727-vxbui6x","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 药材基源：为木兰科植物望春玉兰、玉兰、武当玉兰等的干燥花蕾。"}]},{"ID":"20240607144727-qrkd5eh","Type":"NodeParagraph","Properties":{"id":"20240607144727-qrkd5eh","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Magnolia biondoii Pamp.[M．Fargesii(Finet et Gagnep.)Cheng」2．Magnolia denudata Desr.[M．Heptapeta Buchoz）Dandy；M．Obovata Thunb. Var.denudata （Desr．）DC．]。"}]},{"ID":"20240607144727-hge07vt","Type":"NodeParagraph","Properties":{"id":"20240607144727-hge07vt","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3．Magnolia sprengeri Pamp．[M．DenudataRehd． Et Wils．Var．Purpurascens（Maxim．） Rehd． Et Wils．；M．Denudata Rehd.et wils.var．Elongata Rehd.et Wils．］"}]},{"ID":"20240607144727-kroj6zu","Type":"NodeParagraph","Properties":{"id":"20240607144727-kroj6zu","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"采收和储藏：1～3月，齐花梗处剪下未开放的花蕾，白天置阳光下曝晒，晚上堆成垛发汗，使里外干湿一致。晒至五成干时，堆放1～2d，再晒至全干。如遇雨天，可烘干。"}]},{"ID":"20240607144727-2vv19jg","Type":"NodeParagraph","Properties":{"id":"20240607144727-2vv19jg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607144727-lff7me7","Type":"NodeParagraph","Properties":{"id":"20240607144727-lff7me7","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔400-2400m的山坡林中。"}]},{"ID":"20240607144727-fp5ud7q","Type":"NodeParagraph","Properties":{"id":"20240607144727-fp5ud7q","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.生于海拔1200m以下的常绿阔叶树和落叶阔叶树混交林中，现庭园普遍栽培。"}]},{"ID":"20240607144727-lo7l5rd","Type":"NodeParagraph","Properties":{"id":"20240607144727-lo7l5rd","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.生于海拔1300-2000m的常绿、落叶阔叶混交林中。"}]},{"ID":"20240607144727-5m5qbv6","Type":"NodeParagraph","Properties":{"id":"20240607144727-5m5qbv6","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于陕西南部、甘肃、河南西部、湖北西部及四川等地。"}]},{"ID":"20240607144727-yu7bop7","Type":"NodeParagraph","Properties":{"id":"20240607144727-yu7bop7","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.分布于安徽、浙江、江西、湖南、广东等地。"}]},{"ID":"20240607144727-ib3jv7r","Type":"NodeParagraph","Properties":{"id":"20240607144727-ib3jv7r","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.分布于陕西、甘肃、河南、湖北、四川等地。"}]},{"ID":"20240607144727-caydk6k","Type":"NodeParagraph","Properties":{"id":"20240607144727-caydk6k","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607144727-yzn5wr0","Type":"NodeParagraph","Properties":{"id":"20240607144727-yzn5wr0","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 1.落叶乔木，高6-12m。小枝黄绿色或淡棕黄色，光滑或近梢处有毛；冬芽卵形，苞片密生淡黄色茸毛。单叶互生；叶柄长1-2cm，基部有托叶痕；叶片长圆状披针形或卵状披针形，长10-18cm，宽3.5-6.5cm，先端渐尖，基部圆形或楔形，全缘，表面深绿色，光滑，背面淡绿色，沿脉有疏毛。花先叶开放，单生枝顶，稀腋生，呈钟状，直径6-8cm，白色，外面基部带紫红色，芳香；外轮花被3，萼片状近线形，长约为花瓣的四分之一；中、内轮花被各3，匙形，长4-8cm，宽约2.5cm；雄蕊多数，在伸长的花托下部螺旋状排列；雌蕊多数，排列在花托上部。聚合果圆筒形，稍扭曲，长8-13cm；（艹骨）（艹突）木质。种子倒卵形。花期2-3月，果期9月。"}]},{"ID":"20240607144727-bpjepqd","Type":"NodeParagraph","Properties":{"id":"20240607144727-bpjepqd","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.本种与望春玉兰的区别在于：小枝粗壮，被柔毛；叶片通常倒卵形、宽倒卵形，先端宽圆、平截或稍凹缺，常具急短尖，基部楔形，叶柄及叶下面有白色细柔毛。花被9片，白色，有时外面基部红色，倒卵状长圆形。花期2-3月，果期8-9月。"}]},{"ID":"20240607144727-b6xfewb","Type":"NodeParagraph","Properties":{"id":"20240607144727-b6xfewb","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.与上两种区别在于：叶先端急尖、急渐尖或具突起的小尖头。花被片12-14，外面玫瑰红色，里面较淡，有深紫色纵纹。花期3月，果期6-7月。"}]},{"ID":"20240607144727-hul6zcp","Type":"NodeParagraph","Properties":{"id":"20240607144727-hul6zcp","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607144727-l9hhn2j","Type":"NodeParagraph","Properties":{"id":"20240607144727-l9hhn2j","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，较耐寒、耐旱，忌积水。幼苗怕强光和干旱。以选阳光充足、肥沃、微酸性的砂壤土栽培为宜。"}]},{"ID":"20240607144727-rtkpgl4","Type":"NodeParagraph","Properties":{"id":"20240607144727-rtkpgl4","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、嫁接、扦插繁殖，亦可用压条繁殖。种子繁殖：应选15年生以上健壮母株采种，用层积法贮藏种子，3月中、下旬，在苗床上按行距33cm开深约3～4cm的沟，将种子按株距3cm播入沟内，覆土与沟面平，轻轻压实。幼苗期要遮荫，经常喷水，及时中耕除草，结合浇水适施稀薄人畜粪水或尿素等。培育2年，即可定植。嫁接繁殖：芽接、枝接（切接、劈接）均可，但因辛夷砧木髓心大，所以芽接比枝接成活率高。在初春幼芽萌发前和秋季新梢成熟后进行芽接为宜。砧木以2～3年生，茎粗1～1．5cm木兰实生苗为优，接穗应选一年生粗壮枝条上的饱满芽体，采用削芽腹接法。扦插繁殖：在5月初～6月中旬，选择幼年树的当年生健壮枝条长10-12cm，留叶2片，下端切口留芽带踵，在10（-3）吲哚丁酸溶液中快速蘸一下，随即扦插。苗床用干净湿砂做成，按行株距15cmx4cm插入，使叶片倒向一边，切勿重叠或贴地。插后浇透水，用塑料薄膜覆盖，其上再盖草帘遮荫。插条成活后，要勤除草、追肥。培育1年即可定植。一般在秋季落叶和早春萌芽前定植。"}]},{"ID":"20240607144727-oeqoxnm","Type":"NodeParagraph","Properties":{"id":"20240607144727-oeqoxnm","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"田间管理 定植后至成林前，每年在夏、秋两季各中耕除草1次，并将杂草覆盖根际。定植时应施足基肥，在冬季适施堆肥，或在春季施人畜粪水，促进苗木迅速成林。始花后，每年应在冬季增施过磷酸钙，使蕾壮花多。为了控制树形高大，矮化树干，主干长至1m高时打去顶芽，促使分枝。在植株基部选留3个主枝，向四方发展，各级侧生短、中枝条一般不剪，长枝保留20～25cm。每年修剪的原则是，以轻剪长枝为主，重剪为辅，以截枝为主，疏枝为辅，在8月中旬还要注意摘心，控制顶端优势，促其翌年多抽新生果枝。"}]},{"ID":"20240607144727-r858uuv","Type":"NodeParagraph","Properties":{"id":"20240607144727-r858uuv","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有极腐病，可用50％甲基托布津1000～1500倍液浇注根部。虫害有大蓑蛾，可捕杀。"}]},{"ID":"20240607144727-5u5dq4f","Type":"NodeParagraph","Properties":{"id":"20240607144727-5u5dq4f","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607144727-5izxio2","Type":"NodeParagraph","Properties":{"id":"20240607144727-5izxio2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）望春玉兰 花蕾长卵形，似毛笔头，长1．2-2.5cm，直径0．8-1．5cm，基部常具木质短梗，长约5mm，梗上有类白色点状皮孔。苞片2-3层，每层2片，两层苞片间有小鳞芽，苞片外表面密被灰白色或灰绿色长茸毛，内表面棕褐色，无毛。花被片9，3轮，棕褐色，外轮花被片条形，约为内两轮长的1／4，呈萼片状；雄蕊多数，螺旋状着生于花托下部，花丝扁平，花药线形；雌蕊多数，螺旋状着生于花托上部。体轻，质脆。气芳香，味辛凉而稍苦。"}]},{"ID":"20240607144727-dlfhmlh","Type":"NodeParagraph","Properties":{"id":"20240607144727-dlfhmlh","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"（2）玉兰 花蕾长1．5-3cm，直径1-1．5cm，基部枝梗较粗壮，皮孔浅棕色。苞片外表面密被灰白色或灰绿色茸毛。花被片9，内外轮无显着差异。"}]},{"ID":"20240607144727-74gd3du","Type":"NodeParagraph","Properties":{"id":"20240607144727-74gd3du","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"（3）武当玉兰 花蕾长3-4cm，直径1-2cm，枝梗粗壮，皮孔红棕色。苞片外表面密被淡黄色或淡黄绿色茸毛，有的外层苞片茸毛已脱落，呈黑褐色。花被片10-15，内外轮无显着差异。三种药材均以花蕾大、未开放、色黄绿、无枝梗者为佳。"}]},{"ID":"20240607144727-xda6m7r","Type":"NodeParagraph","Properties":{"id":"20240607144727-xda6m7r","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"显微鉴别 花梗（苞片下）横切面：（1）望春玉兰 表皮细胞1列，呈石细胞状；非腺毛1-3细胞。皮层有少数油细胞及石细胞群，石细胞类圆形、梭形或不规则形，长30-80μm，直径30-40μm，多数可见层纹。维管束环列。髓部有少数油细胞和石细胞群。"}]},{"ID":"20240607144727-bw15a6v","Type":"NodeParagraph","Properties":{"id":"20240607144727-bw15a6v","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"（2）玉兰 表皮细胞长方形不呈石细胞状，内含红棕色色素，无非腺毛。皮层石细胞较多。中柱鞘部位石细胞群环列。髓部无油细胞。"}]},{"ID":"20240607144727-mna90it","Type":"NodeParagraph","Properties":{"id":"20240607144727-mna90it","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"（3）武当玉兰 表皮细胞略呈石细胞状，无非腺毛。皮层有少数外韧型或周韧型维管束。髓部石细胞较少，油细胞较多。品质标志《中华人民共和国药典》1995年版规定：本品含挥发油不得少于1．0％（ml／g）。"}]},{"ID":"20240607144727-b8bnr9c","Type":"NodeParagraph","Properties":{"id":"20240607144727-b8bnr9c","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607144727-g6k4aqq","Type":"NodeParagraph","Properties":{"id":"20240607144727-g6k4aqq","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 1.毒性：辛夷毒性较低，犬静脉注射煎剂1g／kg，兔静脉注射4.75g／kg均未见死亡。辛夷酊剂(去醇)腹腔注射大鼠的LD50为22.5g(生药)／kg，小鼠为19.9g(生药)／kg。腹腔注射后，动物最初5-10分钟走动不安，以后转趋安静，呼吸深且慢，出现耳壳及脚掌血管扩张，发绀，最后惊厥而死，如1-2h内不死者可逐渐恢复。河南产辛荑(M.Biondii)醇浸膏对小鼠灌胃的LD50为38.21±5.2g(生药)／kg，四川产辛夷(M.Sprengeri)醇浸膏为93.55g(生药)／kg。水浸膏给至最大浓度和体积未见毒性。柳叶木兰碱的急性LD50：小鼠腹腔注射为171mg／kg，静脉注射为46mg／kg。兔静脉注射的MLD约为50mg／kg。动物死亡原因主要是呼吸麻痹。"}]},{"ID":"20240607144727-wphgsic","Type":"NodeParagraph","Properties":{"id":"20240607144727-wphgsic","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.亚急性毒性：辛荑醇浸膏以18g(生药)／kg，水浸膏以30g、15g(生药)／kg，给予大鼠、口服，lmo后与各对照组比较，各项生化检查及病理切片均未见异常变化。"}]},{"ID":"20240607144727-xccutny","Type":"NodeParagraph","Properties":{"id":"20240607144727-xccutny","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607144727-me2j7dw","Type":"NodeParagraph","Properties":{"id":"20240607144727-me2j7dw","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 1．望春玉兰 花蕾含挥发油3．4％，其中主成分为β-蒎烯（β-pinene），1，8-桉叶素（1，8－cineole）及樟脑（cam－phor），还含：α-蒎烯（α-pinene），α-及β-水芹烯phellandrene），香桧烯（sabinene），α-及γ-松油烯（terpinene），叔丁基苯（tert－butyl－benzene），水化香桧烯（sabinene hydrate），沉香醇（agarol），α-及β-松油醇（terpineol），4-松油醇（4－terpineol），β-榄香烯（β-elemene），须式及反式的丁香烯（caryophylene），β-芹子烯（β-selinen），β-，γ-及δ-荜澄茄烯（cadinene），香榧醇（torreyol）[1]。另据报道，花蕾的干品含挥发油2％～2．5％，其中主成分为：α-及β-蒎烯，1，8-桉叶素，香桧烯，α-松油烯，月桂烯（myrcene），α-柠檬烯（α-limonene），4-松油醇，还含：樟烯（camphene），蒈烯（carene），α-及γ-松油醇（terpineol），水化香桧烯，聚伞花素（cymene），α-松油烯，甲基庚烯酮（methyl heptenone），樟脑，乙酸龙脑酯（bornyl ac-etate），丁香烯，α-（廿律）草烯（α-humulene），双环榄香烯（bicycloelemene），柠檬醛（citral）a、b，香茅醇（citronellol），牻牛儿醇（geraniol），甲基丁香油酚（methyleugenol），榄香醇（elemol），香榧醇，橙花叔醇（nerolidol），荜澄茄油烯（cubebene），金合欢醇（far－nesol），反，反-金合欢醛（farnesal），芳樟醇（linalool），反式水化香桧烯（trans－sabinene hydrate），8-荜澄茄烯，邻苯二甲酸二乙酯（diethyl phthalate）[2]等。花蕾还含木质体成分：松脂酚二甲醚（pinoresinol dimethyl ether），望春花素（magnolin），鹅掌楸树脂醇B二甲醚（lirioresinol B dimethyl ether），发氏玉兰素（fargesin），刚果荜澄茄脂素（aschantin），去甲氧基刚果荜澄茄脂素（demethoxyaschantin）[3]，望春玉兰脂素（biondinin）A［4］，玉兰脂素（denuda- tin）B,发氏玉兰脂酮（fargespone)A、B、C[14]。"}]},{"ID":"20240607144727-ce9s9ng","Type":"NodeParagraph","Properties":{"id":"20240607144727-ce9s9ng","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.玉兰 花蕾和花分别含挥发油0．29％～0．67％和0．08％～0．09％，其中主成分是1，8-桉叶素，还含α-及β-蒎烯，樟烯，香桧烯，β-月桂烯，柠檬烯，对聚伞花素（p-cymene），顺式的3-己烯-1-醇(3-hexen-1-ol),须式及反式的的芳樟醇氧化物（linalool oxide），正十五烷（n－pentadecane），α-（王古）（王巴）烯（α-copaene），β-旁波烯（β-bourbonene），右旋的4-松油醇，左旋的乙酸龙脑酯，β-丁香棉、α-松油醇，α-（艹律）草烯，α-及γ-衣兰油烯（muurolene），大牻牛儿烯（germacrene）D，a-乙酸香茅醇酯（α－cit-ronellyl acetate），β-芹子烯，乙酸牻牛儿醇酯（geranyl acetate），α-，γ-及δ-荜澄茄烯，牻牛儿醇，对聚伞花素-8-醇（p-cymen-8-ol），菖蒲烯（calamenene），正十九烷（n－nonadecane），丁香烯氧化物（caryophyllene oxide），右旋反式橙花叔醇（trans－neroidol），榄香醇，β-桉叶醇（β－eudesmol）[5]等。花还含黄酮类成分：芸香甙（rutin），槲皮素-7-葡萄糖甙（quercetin-7-glucoside）[6]。叶含挥发油0．04％～0．15％，其中主成分是β-丁香烯和橙花叔醇，其余成分与花中所含类似，但少含了正十五烷，正十九烷、对聚伞花素-8-醇，并多含了α-松油醇，γ-松油烯，β-榄香烯[4]。叶中还含新木脂体成分：玉兰脂素（denudatin）A及B，玉兰脂酮（denuda－tone），布尔乞灵（burchellin），细叶青萎藤烯酮（futoenone），蔚瑞昆森（veraguensin）[7]。树皮含挥发油，其中主成分是1，8-桉叶素，右旋的4-松油醇和左旋的α-松油醇[5]。还含生物碱：柳叶木兰碱（salicifoline），木兰箭毒碱（magnocurarine）[8]。"}]},{"ID":"20240607144727-7u00ab8","Type":"NodeParagraph","Properties":{"id":"20240607144727-7u00ab8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3．武当玉兰 花蕾含挥发油，其中主成分是乙酸龙脑酯，反式丁香烯，丁香烯氧化物，β-桉叶醇，还含α-及β-蒎烯，樟烯，月桂烯，柠檬烯，桉叶素，γ-松油烯，对聚伞花素，樟脑，芳樟醇，葎草烯，香橙烯（aromadendrene），佛术烯eremophilene），顺式及反式-β-金合欢烯（β-farnesene），芳-姜黄烯（ar－curcumene），γ-荜澄茄烯，α-及γ-衣兰油烯，香茅醇，菖蒲烯，甲基丁香油酚，榄香醇，γ-桉叶素，香榧醇等[9]。花含挥发油1．0％，其中主成分是月桂烯，对聚伞花素，α-及β-蒎烯，还含侧柏烯（thujene），樟烯，γ-松油烯，4-侧柏醇（4-thujanol），香桧烯，2-对（艹孟）烯-4-醇（p-2－men－then－4-ol），1，4桉叶素（1，4-cineole），δ-荜澄茄醇（δ-cadinol），芳樟醇，樟脑，3-癸烯-2-酮（3－decen－2－one），4-松油醇，α-松油醇，香桧醇（sabinol），1-对(艹孟)烯-3-醇（p-1－menthen－3－ol），对异丙基苯甲醛（p－isopropylbenzaldehyde），牻牛儿醇，异龙脑（isoborneol），1，4-卡达二烯（1，4－cadaladiene），α-荜澄茄油烯，百里香酚（thymol），α- （王古）（王巴）烯，α－，β-，γ-及δ-荜澄茄烯，α-金合欢烯，葎草烯，β-丁香烯，姜黄烯（curcumene），α-衣兰油烯，二氢-α-（王古）（王巴）-8-醇（dihydro-α-copaene-8-ol）[10]等。树皮含挥发油，其主要成分为β-桉叶醇[11]。树皮还含生物碱：柳叶木兰碱，木兰箭毒碱[11，13]，武当木兰碱（magnospren gerine）[12,13]。"}]},{"ID":"20240607144727-cn9ek9i","Type":"NodeParagraph","Properties":{"id":"20240607144727-cn9ek9i","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607144727-o90xzt8","Type":"NodeParagraph","Properties":{"id":"20240607144727-o90xzt8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 1.局部收敛、刺激和麻醉作用：辛夷挥发油制成的芳香水剂或乳剂，滴入兔结膜囊中，立即产生结膜血管扩张、充血、瞳孔微有扩大；滴于麻醉兔的皮下组织及肠粘膜面上，可产生一层乳白色蛋白凝固薄膜，静脉亦扩张，微血管扩张尤为显着。辛夷1：1浸剂或1：4煎剂豚鼠皮下给药，均有浸润麻醉作用；辛夷饱和溶液注射于蛙坐骨神经处，可产生阻断麻醉作用。辛夷醇浸膏(3.75g生药／kg)，用于大鼠十二指肠给药。观察给药前后大鼠鼻粘膜血流量，结果给药后30分钟与给药前比较有明显差异P＜0.05，60分钟时鼻粘膜血流量仍有增高趋势。"}]},{"ID":"20240607144727-dq7amwa","Type":"NodeParagraph","Properties":{"id":"20240607144727-dq7amwa","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.抑菌、消炎作用：采用体外试管法测定辛夷的MIC(mg／ml)，结果金葡菌为3.13-6.25(水浸膏)，6.25-12.5(醇浸臂)，肺炎双球菌为39.5(水浸膏)、4.69(醇浸膏)、绿脓杆菌为18.75-75(水浸膏)、75-300以上(醇浸膏)，福氏志贺氏菌为150(水浸膏)、300(醇浸膏)，大肠杆菌为37.5-75(水浸膏)、150-300(醇浸膏)。对混合致炎液所致小鼠耳壳炎症有明显的抗炎作用，辛夷水浸膏的剂量为1g／ml，醇浸膏为0.75g／ml，与对照组比较P＜0.01。"}]},{"ID":"20240607144727-pia7jai","Type":"NodeParagraph","Properties":{"id":"20240607144727-pia7jai","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.镇痛作用：辛夷醇浸膏6.5g／kg和水浸膏15g／kg剂量，观察对小鼠热板法镇痛的作用。结果醇浸膏用药后60-240分钟痛阈值明显增加，P＜0.01，而水浸膏仅在240分钟时才有明显差异，P＜0.01。"}]},{"ID":"20240607144727-9e1kf3h","Type":"NodeParagraph","Properties":{"id":"20240607144727-9e1kf3h","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"4.降压作用：辛夷的水或醇提物，肌肉注射或腹腔注射，对麻醉犬、猫、兔及不麻醉大鼠均有降压作用。肌肉注射对不麻醉犬也出现降压，lg(生药)／kg时血压降低40%以上，静脉注射可见一过性呼吸兴奋现象。辛夷对实验性肾性高血压大鼠亦有降压作用，对肾性高血压犬则效果不明显，但对原发性高血压大有明显的降压效果。降压成分在去油水溶液中转溶于乙醚之部分。在降压原理方面，与中枢神经系统似无甚关系，而是直接抑制心脏，特别是扩张血管以及神经节阻断而来。口服时降压作用不明显，可能因有效成分不易被吸收的原故。根含木兰花碱，故有降压作用。"}]},{"ID":"20240607144727-otn8rnp","Type":"NodeParagraph","Properties":{"id":"20240607144727-otn8rnp","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"5.对横纹肌的作用：从望春花花蕾中得到的酚性生物碱，在蛙的腹直肌及坐骨神经缝匠肌标本上呈现箭毒样作用。以蛙腹直肌标本作试验，水煎剂则有乙酰胆碱样作用。用不同提取方法在上述标本上作比较试验，证明望春花花蕾与日本产Magnolia salici-folia Maxim.的花蕾性质相同，而前者作用较强。"}]},{"ID":"20240607144727-mnny4zl","Type":"NodeParagraph","Properties":{"id":"20240607144727-mnny4zl","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"6.对子宫及肠道平滑肌的作用：在人鼠及兔离体子宫，犬及兔在位于宫和兔于宫瘘管等试验中，证明辛夷煎剂和流浸膏能兴奋子宫。在未明显影响血压和呼吸的剂量时，静脉注射或灌胃给药，均呈现这种作用。灌胃量在1-2.4g／kg时，20-60分钟后出现作用，可持续8-24小时。已孕子宫较未孕者更为敏感。兴奋子宫成分为溶于水及乙醇的非挥发性物质。"}]},{"ID":"20240607144727-43a9orb","Type":"NodeParagraph","Properties":{"id":"20240607144727-43a9orb","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"7.对离体肠的影响：取雄性成鹑直肠2-3cm，装入含有20ml含氧台氏液恒温浴管中，观察描记辛夷对组胺1×l0(-3)所致离体直肠痉挛性收缩的抑制作用，结果辛夷醇浸膏5×l0(-3)和水浸膏2.5×10(-3)生药g／ml，均有不同程度的抗组胺作用。"}]},{"ID":"20240607144727-o8dnfod","Type":"NodeParagraph","Properties":{"id":"20240607144727-o8dnfod","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"8.抗过敏作用：。"}]},{"ID":"20240607144727-g9oni55","Type":"NodeParagraph","Properties":{"id":"20240607144727-g9oni55","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"8.1.抗慢反应物质(SRS-A)的作用：辛夷油20、30、40μg／ml浓度，对SRS-A所致豚鼠离体回肠收缩的ID50为30μg／ml。辛夷油40g／ml剂量还能拮抗SRS-A对豚鼠肺条的收缩作用。"}]},{"ID":"20240607144727-6dmk5bg","Type":"NodeParagraph","Properties":{"id":"20240607144727-6dmk5bg","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"8.2.辛夷油10、20、30、40μg/ml对组胺、乙酰胆碱拮抗作用的ID50均为18μg／ml。"}]},{"ID":"20240607144727-11fdmql","Type":"NodeParagraph","Properties":{"id":"20240607144727-11fdmql","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"8.3.辛夷油60μg／ml剂量具有抗致敏豚鼠回肠过敏性收缩作用(P＜0.01)。"}]},{"ID":"20240607144727-iowlgmf","Type":"NodeParagraph","Properties":{"id":"20240607144727-iowlgmf","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"8.4.按药理实验方法学(1985)用辛夷油200mg／kg，最后一大腹腔注射90分钟后观察对豚鼠过敏性哮喘的作用。结果具有明显的保护作用(P＜0.01)。"}]},{"ID":"20240607144727-4onjg73","Type":"NodeParagraph","Properties":{"id":"20240607144727-4onjg73","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607144727-giwgv3t","Type":"NodeParagraph","Properties":{"id":"20240607144727-giwgv3t","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 拣净枝梗杂质，捣碎用；入药微炙，已开者劣，谢者不佳。"}]},{"ID":"20240607144727-5zqui3r","Type":"NodeParagraph","Properties":{"id":"20240607144727-5zqui3r","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607144727-avhb5is","Type":"NodeParagraph","Properties":{"id":"20240607144727-avhb5is","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 肺；胃经"}]},{"ID":"20240607144727-7hhx5h1","Type":"NodeParagraph","Properties":{"id":"20240607144727-7hhx5h1","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607144727-7lb5eii","Type":"NodeParagraph","Properties":{"id":"20240607144727-7lb5eii","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 辛；性温"}]},{"ID":"20240607144727-iwqilb1","Type":"NodeParagraph","Properties":{"id":"20240607144727-iwqilb1","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607144727-5lgxz95","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607144727-5lgxz95","updated":"20240607144727"},"Children":[{"ID":"20240607144727-7mski3f","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240607144727-7mski3f","updated":"20240607144727"},"Children":[{"ID":"20240607144727-a1r2jx7","Type":"NodeParagraph","Properties":{"id":"20240607144727-a1r2jx7","updated":"20240607144727"}}]}]},{"ID":"20240607144727-frovrp8","Type":"NodeParagraph","Properties":{"id":"20240607144727-frovrp8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：凡气虚人忌，头脑痛属血虚火炽者忌，齿痛属胃火者忌。"}]},{"ID":"20240607144727-jdaxmga","Type":"NodeParagraph","Properties":{"id":"20240607144727-jdaxmga","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：气虚之人，虽偶感风寒，致诸窍不通者，不宜用。"}]},{"ID":"20240607144727-jr67hhi","Type":"NodeParagraph","Properties":{"id":"20240607144727-jr67hhi","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607144727-b8ayaxa","Type":"NodeParagraph","Properties":{"id":"20240607144727-b8ayaxa","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 散风寒；通鼻窍。主鼻渊；风寒感冒之头痛；鼻塞；流涕"}]},{"ID":"20240607144727-qiz1jwo","Type":"NodeParagraph","Properties":{"id":"20240607144727-qiz1jwo","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607144727-boyeda2","Type":"NodeParagraph","Properties":{"id":"20240607144727-boyeda2","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤 ，3-10g，宜包煎；或入丸、散。外用：适量，研末搐鼻；或以其蒸馏水滴鼻。"}]},{"ID":"20240607144727-s0s0gg8","Type":"NodeParagraph","Properties":{"id":"20240607144727-s0s0gg8","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607144727-fvphljb","Type":"NodeParagraph","Properties":{"id":"20240607144727-fvphljb","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 1.《本草纲目》：肺开窍于鼻，而阳明胃脉环鼻而上行，脑为元神之府，鼻为命门之窍；人之中气不足，清阳不升，则头为之倾，九窍为之不利。辛夷之辛温走气而入肺，能助胃中清阳上行通于天，所以能温中治头面目鼻之病。"}]},{"ID":"20240607144727-978tfuf","Type":"NodeParagraph","Properties":{"id":"20240607144727-978tfuf","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：辛夷，主五脏身体寒热，风头脑痛，面野，解肌，通鼻塞涕出。面肿引齿痛者，皆二经受风邪所致，足阳明主肌肉，手太阴主皮毛，风邪之中人，必自皮毛肌肉，以达于五脏，而变为寒热；又鼻为肺之窍，头为诸阳之首，三阳之脉会于头面，风客阳分则为头痛、面歪、鼻塞、涕出、面肿引齿痛，辛温能解肌散表，芳香能上窜头目，逐阳分之风邪，则诸证自愈矣。眩冒及身几几如在车船之上者，风主动摇之象故也，风邪散，中气温，则九窍通矣。大风之中人，则毛发脱落，风湿之浸淫，则肠胃生虫，散风行湿，则须发生而虫自去矣。"}]},{"ID":"20240607144727-h41hieu","Type":"NodeParagraph","Properties":{"id":"20240607144727-h41hieu","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"3.《本草新编》：辛夷，通窍而上走于脑舍，(治)鼻塞鼻渊之症，无他用，存之以备用可耳。且辛散之物多用，则真气有伤，可暂用而不可久用也。"}]},{"ID":"20240607144727-ejwppxh","Type":"NodeParagraph","Properties":{"id":"20240607144727-ejwppxh","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"4.《本经续疏》：无五脏身体寒热，而风头脑痛者，是阳淫极上不得阴交而化风，非辛夷所可治也。五脏身体寒热，而不风头脑痛者，是邪连中外，不随阳气而透达，亦非辛夷所可治也。惟风头脑痛之属五脏身体寒热者，乃可以辛夷治。"}]},{"ID":"20240607144727-v9souyl","Type":"NodeParagraph","Properties":{"id":"20240607144727-v9souyl","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"5.《神农本草经》：主五脏身体寒热风，头脑痛。"}]},{"ID":"20240607144727-5jyjl9x","Type":"NodeParagraph","Properties":{"id":"20240607144727-5jyjl9x","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"6.《名医别录》：温中解肌，利九窍，通鼻塞、涕出，治面肿引齿痛，眩冒、身几几如在车船之上者。生须发，去白虫。"}]},{"ID":"20240607144727-kr4flji","Type":"NodeParagraph","Properties":{"id":"20240607144727-kr4flji","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：能治面生疱。面脂用，主光华。"}]},{"ID":"20240607144727-yy4rmhw","Type":"NodeParagraph","Properties":{"id":"20240607144727-yy4rmhw","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：通关脉，明目。治头痛、憎寒、体噤、瘙痒。"}]},{"ID":"20240607144727-0nrwnys","Type":"NodeParagraph","Properties":{"id":"20240607144727-0nrwnys","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"9.《滇南本草》：治脑漏鼻渊，祛风，新瓦焙为末。治面寒痛，胃气痛，热酒服。"}]},{"ID":"20240607144727-r5jyhsu","Type":"NodeParagraph","Properties":{"id":"20240607144727-r5jyhsu","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"10.《本草纲目》：鼻渊、鼻窒、鼻疮及痘后鼻疮，并用研末，入麝香少许，葱白蘸入数次。"}]},{"ID":"20240607144727-g05vjp5","Type":"NodeParagraph","Properties":{"id":"20240607144727-g05vjp5","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"11.《玉楸药解》：泄肺降逆，利气破壅。"}]},{"ID":"20240607144727-9rf1r3z","Type":"NodeParagraph","Properties":{"id":"20240607144727-9rf1r3z","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"12.《江西中药》：外用能促进子宫收缩，具催生作用。"}]},{"ID":"20240607144727-j8u7kj5","Type":"NodeParagraph","Properties":{"id":"20240607144727-j8u7kj5","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607144727-8wvkxui","Type":"NodeParagraph","Properties":{"id":"20240607144727-8wvkxui","updated":"20240607144727"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607144728-2n3hi0e","Type":"NodeThematicBreak","Properties":{"id":"20240607144728-2n3hi0e"}},{"ID":"20240607144729-p4s6o02","Type":"NodeParagraph","Properties":{"id":"20240607144729-p4s6o02"}}]}