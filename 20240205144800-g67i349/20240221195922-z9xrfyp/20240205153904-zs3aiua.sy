ng-fold":"1","id":"20240811115009-3u7394q","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"其实以上图片也是收录错了，取图为二乔玉兰居多"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（由于已将该篇定位错录内容，不作修正，并将原所有内容定义为错录）"}]},{"ID":"20240811114913-jblejqd","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-jblejqd","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫玉兰、二乔玉兰对比"}]},{"ID":"20240811114913-kj1mrmg","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-kj1mrmg","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为紫玉兰"}]},{"ID":"20240811115247-g4zdrfh","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811115247-g4zdrfh","updated":"20240812173012"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 344px;","style":"width: 334px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫玉兰 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫玉兰 1-20240811115142-ntpd8nf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 334px;\" parent-style=\"width: 344px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 345px;","style":"width: 335px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫玉兰 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫玉兰 2-20240811115225-q3f96op.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 335px;\" parent-style=\"width: 345px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811114913-6x7leo0","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-6x7leo0","updated":"20240812173012"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 358px;","style":"width: 348px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"辛夷 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/辛夷 8-20240811113718-44sh7dg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 348px;\" parent-style=\"width: 358px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 857px;","style":"width: 847px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫玉兰"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫玉兰-20240811110941-oqi5v21.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 847px;\" parent-style=\"width: 857px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811114913-2nzd176","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-2nzd176","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（一般是6片花瓣；花叶同放，为灌木较矮；）"}]},{"ID":"20240811114913-wkkdz5s","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-wkkdz5s","updated":"20240812173012"}},{"ID":"20240811114913-nd3gxuc","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-nd3gxuc","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为二乔玉兰（紫玉兰和白玉兰杂交品种）"}]},{"ID":"20240811114913-v1xqfb3","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-v1xqfb3","updated":"20240812173012"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 251px;","style":"width: 241px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"二乔玉兰"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/二乔玉兰-20240811105244-gnp2bbz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 241px;\" parent-style=\"width: 251px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 490px;","style":"width: 480px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"二乔玉兰 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/二乔玉兰 1-20240811105513-i4ehik0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 480px;\" parent-style=\"width: 490px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 437px;","style":"width: 427px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"二乔玉兰 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/二乔玉兰 2-20240811110304-h18qtjl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 427px;\" parent-style=\"width: 437px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811114913-hkhvf26","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-hkhvf26","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（6-9片花瓣，通常为9片，外紫内白，外层的花苞片比内层的短，约二分之一或三分之二长；见花时不见叶；为乔木）"}]},{"ID":"20240811114913-ojv9h7v","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-ojv9h7v","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为玉兰树的干燥花蕾；玉兰很多种，白玉兰，紫玉兰，荷花玉兰，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"紫玉兰的花苞才能叫辛夷"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（紫玉兰才是土生土长能入药的玉兰，其它颜色的都是杂交出来的）；"}]},{"ID":"20240811114913-pn0ib2e","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-pn0ib2e","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"二乔玉兰和紫玉兰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"极为相似，二乔玉兰花的背面是紫色的，正面是白色的，而紫玉兰正反面都为紫色；而且二乔玉兰是先开花后长叶，紫玉兰先长叶后开花或者花叶同时出；"}]},{"ID":"20240811114913-m2rl1uc","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811114913-m2rl1uc","updated":"20240812173012"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：北方极少见到紫玉兰，二乔玉兰偏多。有专家认为，北京甚至北方所谓的紫玉兰，基本上都是二乔玉兰；二乔玉兰也有二次开花的特点——"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"抖音创作者“西河柳”"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"；"}]},{"ID":"20240812173040-wliwy25","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812173040-wliwy25","updated":"20240812173040"}},{"ID":"20240812173040-wdc22mr","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812173040-wdc22mr","updated":"20240812173040"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"起初辛夷取图为未按图分类的玉兰花花苞"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"→"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"再而发现错误，应定位为紫玉兰的花苞"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"→"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"再而发现现今紫玉兰大多被一种名为二乔玉兰的杂交品种取代，原品种取图困难"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"→难以定夺之下，最终以抖音创作者‘百草恒益’查证观点，个人觉得更合理（肺色为白，开窍在鼻），故以下取图为白玉兰，另附上视频；"}]},{"ID":"20240811104536-uf5urxj","Type":"NodeThematicBreak","Properties":{"heading-fold":"1","id":"20240811104536-uf5urxj","updated":"20240812173012"}},{"ID":"20240811115815-xxng7h3","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240811115815-xxng7h3","updated":"20240812173012"}},{"ID":"20240811115502-v34ley0","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20240811115502-v34ley0","updated":"20240812173110"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关于辛夷"}]},{"ID":"20240811122558-1swyiu7","Type":"NodeParagraph","Properties":{"id":"20240811122558-1swyiu7","updated":"20240812173110"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辛夷取自抖音创作者‘百草恒益’查证观点，个人觉得更合理（肺色为白，开窍在鼻，实际请以临床经验为准），故以下取图为白玉兰，另附上视频；"}]},{"ID":"20240811131929-e2sptzn","Type":"NodeParagraph","Properties":{"id":"20240811131929-e2sptzn","updated":"20240811132014"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 455px;","style":"width: 445