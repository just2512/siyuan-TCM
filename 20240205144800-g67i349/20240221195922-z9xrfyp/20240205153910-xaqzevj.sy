pe":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蔓荆子 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蔓荆子 6-20240809150212-anz7kp0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 416px;\" parent-style=\"width: 426px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 425px;","style":"width: 415px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蔓荆子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蔓荆子-20240809145417-ev2z3xl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 426px;","style":"width: 416px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蔓荆子 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蔓荆子 4-20240809145734-2m0nj7d.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 416px;\" parent-style=\"width: 426px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809162413-80jeibn","Type":"NodeParagraph","Properties":{"id":"20240809162413-80jeibn","updated":"20240809163403"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"（古籍所记录的蔓荆子不是单叶蔓荆，该说法出自一篇文章，不确定真实性，这里仅截取部分内容）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，如下"}]},{"ID":"20240809162730-j8st28a","Type":"NodeParagraph","Properties":{"id":"20240809162730-j8st28a","updated":"20240809162730"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 691px;","style":"width: 681px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240809162730-atxm40l.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 681px;\" parent-style=\"width: 691px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809162842-pfs6wwi","Type":"NodeParagraph","Properties":{"id":"20240809162842-pfs6wwi","updated":"20240809162842"}},{"ID":"20240809151233-h4si5xz","Type":"NodeParagraph","Properties":{"id":"20240809151233-h4si5xz","updated":"20240809151305"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：本土蔓荆是一枝分三片叶，叶片对生的；"}]},{"ID":"20240809151027-etc502s","Type":"NodeParagraph","Properties":{"id":"20240809151027-etc502s","updated":"20240809151237"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：诸花皆升，旋覆独降，诸子皆降，蔓荆独升；"}]},{"ID":"20240617105917-nf52uh5","Type":"NodeThematicBreak","Properties":{"id":"20240617105917-nf52uh5"}},{"ID":"20240617105918-umussof","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105918-umussof","updated":"20240617105922"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草求真》"}]},{"ID":"20240617105918-qgq3pdc","Type":"NodeParagraph","Properties":{"id":"20240617105918-qgq3pdc","updated":"20240617105918"},"Children":[{"Type":"NodeText","Data":"（灌木）散筋骨间寒湿除头面风寒"}]},{"ID":"20240617105918-9b87k2t","Type":"NodeParagraph","Properties":{"id":"20240617105918-9b87k2t","updated":"20240617105918"},"Children":[{"Type":"NodeText","Data":"蔓荆子（专入膀胱。兼入胃肝。）辛苦微温。书言主治太阳膀胱。兼理足阳明胃足厥阴肝。缘太阳本属寒水之经。因风邪内客。而致巅顶头痛脑鸣。（太阳脉络于脑。）肝属风脏。风既内犯。则风必挟肝木上侵。而致泪出不止。（目为肝窍。）筋藉血养。则血亦被风犯。而致筋亦不荣。齿亦不坚矣！（齿者骨之余。上龈属足阳明。因下龈属手阳明大肠。风热上攻则痛。）"}]},{"ID":"20240617105918-4y8lch7","Type":"NodeParagraph","Properties":{"id":"20240617105918-4y8lch7","updated":"20240617105918"},"Children":[{"Type":"NodeText","Data":"（口鼻耳目二阴）蔽塞而病斯剧。蔓荆体轻而浮。故既可治筋骨间寒热。而令湿痹拘急斯去。气升而散。复能祛风除寒。而令头面虚风之症悉治。且使九窍皆利。白虫能杀。是亦风寒湿热俱除之一验耳。但气虚血虚等症。用此祸必旋踵。不可不知。去膜酒蒸炒。或打碎用。恶乌头石膏。"}]},{"ID":"20240617110008-omv0h7h","Type":"NodeThematicBreak","Properties":{"id":"20240617110008-omv0h7h"}},{"ID":"20240617110010-nj0obb7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110010-nj0obb7","updated":"20240617110016"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草从新》"}]},{"ID":"20240617110010-7z7ngcs","Type":"NodeParagraph","Properties":{"id":"20240617110010-7z7ngcs","updated":"20240617110010"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"轻宣、散上部风．"}]},{"ID":"20240617110010-zcdros3","Type":"NodeParagraph","Properties":{"id":"20240617110010-zcdros3","updated":"20240617110010"},"Children":[{"Type":"NodeText","Data":"味苦辛平．轻浮升散而搜风．通利九窍．治湿痹拘挛．头痛脑鸣．（太阳脉络于脑．）目痛齿痛．（齿虽属肾、为骨之余、而上龈属足阳明、下龈属手阳明、阳明风热上攻、则动摇肿痛．）头面风虚之证．头痛目痛．不因风邪而因血虚有火者．忌之．元素云．胃虚人不可食．"}]},{"ID":"20240617110010-wj7mmr0","Type":"NodeParagraph","Properties":{"id":"20240617110010-wj7mmr0","updated":"20240617110010"},"Children":[{"Type":"NodeText","Data":"恐生痰疾．产南皮县．（去膜、打碎用、亦有酒蒸炒者．）恶石膏、乌头．（乳痈初起、酒服末方寸七．）"}]},{"ID":"20240617110024-jyz4hnk","Type":"NodeThematicBreak","Properties":{"id":"20240617110024-jyz4hnk"}},{"ID":"20240617110025-kw2mbbl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617110025-kw2mbbl","updated":"20240617110029"},"Children":[{"Type":"NodeText","Data":"蔓荆子《得配本草》"}]},{"ID":"20240617110025-fh7ofnh","Type":"NodeParagraph","Properties":{"id":"20240617110025-fh7ofnh","updated":"20240617110025"},"Children":[{"Type":"NodeText","Data":"恶乌头、石膏。"}]},{"ID":"20240617110025-56gi6x2","Type":"NodeParagraph","Properties":{"id":"20240617110025-56gi6x2","updated":"20240617110025"},"Children":[{"Type":"NodeText","Data":"辛、苦、微温。入足太阳、厥阴经气分。搜肝风，祛寒湿，除头痛，止睛疼，利九窍，杀白虫，治湿痹拘挛，疗脑鸣齿痛。配马蔺，治喉痹口噤。配蒺藜，治皮痹不仁。"}]},{"ID":"20240617110025-n88lslg","Type":"NodeParagraph","Properties":{"id":"20240617110025-n88lslg","updated":"20240617110025"},"Children":[{"Type":"NodeText","Data":"去膜拷碎，酒蒸用，或酒拌炒用。胃虚，（服之恐致痰疾。）血虚头痛，二者禁用。"}]},{"ID":"20240607144642-r0h2z6e","Type":"NodeThematicBreak","Properties":{"id":"20240607144642-r0h2z6e"}},{"ID":"20240607144643-4ef3o2f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144643-4ef3o2f","updated":"20240607144648"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草备要》"}]},{"ID":"20240607144643-m0zuujs","Type":"NodeParagraph","Properties":{"id":"20240607144643-m0zuujs","updated":"20240607144643"},"Children":[{"Type":"NodeText","Data":"轻宣，散上部风热"}]},{"ID":"20240607144643-dtv0ywf","Type":"NodeParagraph","Properties":{"id":"20240607144643-dtv0ywf","updated":"20240607144643"},"Children":[{"Type":"NodeText","Data":"辛苦微寒、轻浮升散。入足太阳、阳明、厥阴（膀胱、胃、肝）经。搜风凉血，通利九窍。"}]},{"ID":"20240607144643-dx0ehuo","Type":"NodeParagraph","Properties":{"id":"20240607144643-dx0ehuo","updated":"20240607144643"},"Children":[{"Type":"NodeText","Data":"治湿痹拘挛，头痛脑鸣（太阳脉络于脑），目赤齿痛（齿虽属肾，为骨之余。而上龈属足阳明，下龈属手阳明。阳明风热上攻，则动摇肿痛），头面风虚之证。明目固齿，长发泽肌。"}]},{"ID":"20240607144643-u1cwzcc","Type":"NodeParagraph","Properties":{"id":"20240607144643-u1cwzcc","updated":"20240607144643"},"Children":[{"Type":"NodeText","Data":"去膜，打碎用，亦有酒蒸、炒用者。恶石膏、乌头。"}]},{"ID":"20240617105957-zgdbhlm","Type":"NodeThematicBreak","Properties":{"id":"20240617105957-zgdbhlm"}},{"ID":"20240617105958-cuj1rty","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105958-cuj1rty","updated":"20240617110002"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草撮要》"}]},{"ID":"20240617105958-kev5nsz","Type":"NodeParagraph","Properties":{"id":"20240617105958-kev5nsz","updated":"20240617105958"},"Children":[{"Type":"NodeText","Data":"味辛甘微凉．入足太阳厥阴经．功专凉诸经血．明目搜肝风．得皂荚、蒺藜治皮痹不仁．得羌活、防风治风热头痛．血虚有火者慎用．恶石膏、乌头．"}]},{"ID":"20240617105947-9saxah2","Type":"NodeThematicBreak","Properties":{"id":"20240617105947-9saxah2"}},{"ID":"20240617105948-c6cmu0c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105948-c6cmu0c","updated":"20240617105953"},"Children":[{"Type":"NodeText","Data":"蔓荆子《顾松园医镜》"}]},{"ID":"20240617105948-xh036pk","Type":"NodeParagraph","Properties":{"id":"20240617105948-xh036pk","updated":"20240617105948"},"Children":[{"Type":"NodeText","Data":"〔辛苦平，入肾、肝、膀胱三经。〕善疗头风目痛，〔气清，体轻，上行而散，故治偏头风痛目将损者。〕堪舒湿痹拘挛。〔风能胜湿。〕头痛目痛，不由风邪，而因于血虚有火者忌之。"}]},{"ID":"20240617105932-lfp2s27","Type":"NodeThematicBreak","Properties":{"id":"20240617105932-lfp2s27"}},{"ID":"20240617105933-iyjltfy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105933-iyjltfy","updated":"20240617105940"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草易读》"}]},{"ID":"20240617105933-yia3pin","Type":"NodeParagraph","Properties":{"id":"20240617105933-yia3pin","updated":"20240617105933"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"去蒂下白膜，打碎用之，或酒蒸。恶乌头、石膏。"}]},{"ID":"20240617105933-z7dnx8g","Type":"NodeParagraph","Properties":{"id":"20240617105933-z7dnx8g","updated":"20240617105933"},"Children":[{"Type":"NodeText","Data":"辛，平，无毒。明目坚齿，凉血搜风。解风寒头痛脑痛，除筋骨湿痹拘挛。长须发而利关窍虚头痛及胃虚者忌之。"}]},{"ID":"20240617105933-sow0uh4","Type":"NodeParagraph","Properties":{"id":"20240617105933-sow0uh4","updated":"20240617105933"},"Children":[{"Type":"NodeText","Data":"汴京、秦、陇、明、越诸州多有之，茎蔓延长丈余。春园旧枝而生小叶，五月叶成，似李叶月有实，黑斑，大如梧子而虚轻。"}]},{"ID":"20240617105933-o4m5wir","Type":"NodeParagraph","Properties":{"id":"20240617105933-o4m5wir","updated":"20240617105933"},"Children":[{"Type":"NodeText","Data":"头风作痛，渍酒七日服。（验方第一。）"}]},{"ID":"20240617105933-78s7vo2","Type":"NodeParagraph","Properties":{"id":"20240617105933-78s7vo2","updated":"20240617105933"},"Children":[{"Type":"NodeText","Data":"乳痈初起，炒末酒服，以渣敷之。（第二。）"}]},{"ID":"20240607144212-esnmm4m","Type":"NodeThematicBreak","Properties":{"id":"20240607144212-esnmm4m"}},{"ID":"20240607144630-f2uikhz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144630-f2uikhz","updated":"20240607144635"},"Children":[{"Type":"NodeText","Data":"蔓荆子《汤液本草》"}]},{"ID":"20240607144630-76ilne4","Type":"NodeParagraph","Properties":{"id":"20240607144630-76ilne4","updated":"20240607144630"},"Children":[{"Type":"NodeText","Data":"气清，味辛温苦、甘，阳中之阴。太阳经药。"}]},{"ID":"20240607144630-iwbih3m","Type":"NodeParagraph","Properties":{"id":"20240607144630-iwbih3m","updated":"20240607144630"},"Children":[{"Type":"NodeText","Data":"《象》云∶治太阳经头痛，头昏闷，除目暗，散风邪药，胃虚人勿服，恐生痰疾。拣净，杵碎用。"}]},{"ID":"20240607144630-hr92cc6","Type":"NodeParagraph","Properties":{"id":"20240607144630-hr92cc6","updated":"20240607144630"},"Children":[{"Type":"NodeText","Data":"《珍》云∶凉诸经血，止头痛，主目睛内痛。"}]},{"ID":"20240607144630-f0gxkfu","Type":"NodeParagraph","Properties":{"id":"20240607144630-f0gxkfu","updated":"20240607144630"},"Children":[{"Type":"NodeText","Data":"《本草》云∶恶乌头、石膏。"}]},{"ID":"20240607144212-vmzxd0t","Type":"NodeThematicBreak","Properties":{"id":"20240607144212-vmzxd0t"}},{"ID":"20240607144618-670n64l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144618-670n64l","updated":"20240607144623"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本经逢原》"}]},{"ID":"20240607144618-ygizdhz","Type":"NodeParagraph","Properties":{"id":"20240607144618-ygizdhz","updated":"20240607144618"},"Children":[{"Type":"NodeText","Data":"苦辛温，无毒。"}]},{"ID":"20240607144618-ljgyhl3","Type":"NodeParagraph","Properties":{"id":"20240607144618-ljgyhl3","updated":"20240607144618"},"Children":[{"Type":"NodeText","Data":"《本经》主筋骨间寒热湿痹，拘挛，明目，坚齿，利九窍，去白虫。"}]},{"ID":"20240607144618-7o0lw7f","Type":"NodeParagraph","Properties":{"id":"20240607144618-7o0lw7f","updated":"20240607144618"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"蔓荆子入足太阳，体轻而浮，故治筋骨间寒热湿痹拘急。上行而散，故能明目，坚齿，利九窍，去白虫，及风寒目痛，头面风虚之证。然胃虚人不可服，恐助痰湿为患也。"}]},{"ID":"20240607144618-17plngy","Type":"NodeParagraph","Properties":{"id":"20240607144618-17plngy","updated":"20240607144618"},"Children":[{"Type":"NodeText","Data":"凡头痛目痛，不因风邪而血虚有火者禁用；瞳神散大尤忌。"}]},{"ID":"20240607144558-2piitol","Type":"NodeThematicBreak","Properties":{"id":"20240607144558-2piitol"}},{"ID":"20240607144603-sotz47v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144603-sotz47v","updated":"20240607144608"},"Children":[{"Type":"NodeText","Data":"蔓荆子《雷公炮制药性解》"}]},{"ID":"20240607144603-85c6uoc","Type":"NodeParagraph","Properties":{"id":"20240607144603-85c6uoc","updated":"20240607144603"},"Children":[{"Type":"NodeText","Data":"味苦甘辛，性微寒无毒，入肝经。主散风寒，疗头风，除目痛，去翳膜坚齿牙，利九窍，杀百虫。酒浸一宿蒸用，恶石膏、乌头。"}]},{"ID":"20240607144603-0a407xv","Type":"NodeParagraph","Properties":{"id":"20240607144603-0a407xv","updated":"20240607144603"},"Children":[{"Type":"NodeText","Data":"按∶经曰；东方青色，入通于肝，开窍于目。又曰∶风生木，木生酸。酸生肝，荆实入肝，故专主散风，以疗目疾。《主治秘诀》云∶其味苦甘，为阳中之阴，能凉诸经之血热。"}]},{"ID":"20240607144458-jjwdwgv","Type":"NodeThematicBreak","Properties":{"id":"20240607144458-jjwdwgv"}},{"ID":"20240607144552-cjv0ptx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144552-cjv0ptx","updated":"20240607144557"},"Children":[{"Type":"NodeText","Data":"蔓荆子《玉楸药解》"}]},{"ID":"20240607144552-33i26nv","Type":"NodeParagraph","Properties":{"id":"20240607144552-33i26nv","updated":"20240607144552"},"Children":[{"Type":"NodeText","Data":"味苦，微温，入足厥阴肝经。泻风湿，清头目。"}]},{"ID":"20240607144552-74sh6mm","Type":"NodeParagraph","Properties":{"id":"20240607144552-74sh6mm","updated":"20240607144552"},"Children":[{"Type":"NodeText","Data":"蔓荆子发散风湿，治麻痹拘挛、眼肿头痛之证。"}]},{"ID":"20240607144552-01odcrh","Type":"NodeParagraph","Properties":{"id":"20240607144552-01odcrh","updated":"20240607144552"},"Children":[{"Type":"NodeText","Data":"头目疼痛，乃胆胃逆升，浊气上壅所致，庸医以为头风，而用蔓荆子发散之药，不通极矣！诸家本草，皆出于下士之手，此等妄言，不胜其数。"}]},{"ID":"20240607144458-o4cq27p","Type":"NodeThematicBreak","Properties":{"id":"20240607144458-o4cq27p"}},{"ID":"20240607144459-j1kklx4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144459-j1kklx4","updated":"20240607144505"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草述钩元》"}]},{"ID":"20240607144459-uzemmxt","Type":"NodeParagraph","Properties":{"id":"20240607144459-uzemmxt","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"其枝小弱如蔓。故名。"}]},{"ID":"20240607144459-jan9pxw","Type":"NodeParagraph","Properties":{"id":"20240607144459-jan9pxw","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"气味苦辛。微凉。气清味薄。阳中之阴。入手足太阳经。主治凉诸经血。益气明目。利关节及九窍。治筋骨间寒热。湿痹拘挛。搜肝风。散风邪。治太阳风头痛。头沉昏闷。除昏暗。止目睛内痛。及目泪出。方书主眩晕螈。颈项强痛。腰痛挛痞。行痹着痹。并耳鼻齿病。蔓荆子禀阳气以生。兼得金化而成。（仲淳）气清味辛。体轻而浮。上行而散。故主头面风虚之证。（濒湖）蔓荆之治。何以于头目为先。盖阳气先于天表。而乃及于经脉。正所谓卫气充周。而后精专者入于脉也。"}]},{"ID":"20240607144459-ppm9e9d","Type":"NodeParagraph","Properties":{"id":"20240607144459-ppm9e9d","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"〔论〕蔓荆春因旧枝而生小叶。至夏茂盛作花。是秉春温之气以生。夏热之气以长。"}]},{"ID":"20240607144459-bxphwj9","Type":"NodeParagraph","Properties":{"id":"20240607144459-bxphwj9","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"九月结实。是因深秋凉降之气以成。其味始尝之多苦。后味之有辛。更有微凉。正其气化之应也。先哲曰。假令自地而升天。非苦无以至地。非温无以至天。故用苦温之剂。假令自天而降地。非辛无以至天。非凉无以至地。故用辛凉之剂。凉固在天之阴而降地者也。蔓荆从苦温而成于辛凉。以升天始。以降地终。夫有温升。始有凉降。而有凉降。乃以成其温升。"}]},{"ID":"20240607144459-4qaqxb9","Type":"NodeParagraph","Properties":{"id":"20240607144459-4qaqxb9","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"（阳不得阴。则阳无以化也。）东垣曰。诸阳气皆根于阴血。阴受火邪。则上乘阳分。而阳道不行。此味成于凉降。能凉诸经之血。不使火邪乘于阳分。且阳得阴以化。而阳道行。绎东垣数语。足以明其功用矣。世第以其辛温升散。推为风剂。孰知有妙于凉降以成其温升。"}]},{"ID":"20240607144459-ptb7gbu","Type":"NodeParagraph","Properties":{"id":"20240607144459-ptb7gbu","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"不使阳之戾气。化为风眚者乎。（凉血则阳得阴以为守。而风木之气化自平。故此味专治内风。凡方书中用疗风证。须识此义。）或曰。本经首治筋骨间寒热湿痹拘挛。此凉血之故欤。"}]},{"ID":"20240607144459-u4eypkb","Type":"NodeParagraph","Properties":{"id":"20240607144459-u4eypkb","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"抑气也。虽水谷之悍气入卫。不能入于脉。然卫气充周。和调五脏。洒陈六腑。遂能入于脉。"}]},{"ID":"20240607144459-yk1b5n0","Type":"NodeParagraph","Properties":{"id":"20240607144459-yk1b5n0","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"是有充周之气。乃有精专者以入于营。固无二气也。然则如上主治。岂能外于温升之气乎。"}]},{"ID":"20240607144459-x0xom1y","Type":"NodeParagraph","Properties":{"id":"20240607144459-x0xom1y","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"第温升之气无凉降。则阳中无阴。与经所谓至阴虚天气绝者无二义。惟此味本温升之气以归凉降。有阴降而阳随之化机。故能使阳入阴中。而营气得以贯注。遂为筋骨之利。而痹者通挛者伸耳。先哲言营之机不动。则卫气不布。斯语可互为参也。（即伏虎丹之治瘫痪。拯济换骨丹之治半身不遂。茯神汤之疗心痹。小乌犀汤之治行痹。神效黄汤蔓荆子汤苦参汤之疗着痹。有一不由于营卫之合以致其用者乎。更参苦参汤。乃治营虚卫实而肌肉不仁者。可知兹味之用。以阴而达阳。即由阳以彻阴也。）再如洁古谓其凉诸经血。又曰气清。别录言其益气。大约凉血益气。妙皆以清气为关捩子。盖其气清者。阳得阴以化。东垣所谓阳道得行。即此是气益矣。故气虚而头疼。气虚而着痹。气虚而胸次痞。率于补气中用之。不可想见其气清即气益之微义欤。至其并能化阳之戾者。以气之虚者欲补。此能清其气以达之。气之戾者欲散。此更能清其气以化之。总之于气胥益也。（观螈一证。有牛黄散治其虚。更有胃风汤独活散治其实可见。）然则此味先入何经。乃合于凉血。以奏益气之功欤。曰。手太阳小肠受邪。蔓荆子除之。此说最当矣。夫心为火主。气者火之灵也。而小肠与之合。心不司气化。而小肠为心司气化之权。又心主血。而小肠即为血化之府。东垣所谓诸阳气根于阴血者也。况小肠经脉。上会诸阳于督。下会诸阳于任。其上而受诸阳之施化者。实下而根柢于真阴之熏蒸也。所谓小肠之邪。即病于气化不清。除小肠之邪。非即凉血而令气清。气清而令气益乎哉。彼洁古云入太阳者。固包举手足两经而言矣。"}]},{"ID":"20240607144459-z9uy3f5","Type":"NodeParagraph","Properties":{"id":"20240607144459-z9uy3f5","updated":"20240607144459"},"Children":[{"Type":"NodeText","Data":"〔修治〕去膜。打碎用。"}]},{"ID":"20240607144426-rffbldj","Type":"NodeThematicBreak","Properties":{"id":"20240607144426-rffbldj"}},{"ID":"20240607144438-shjr3gu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144438-shjr3gu","updated":"20240607144448"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草新编》"}]},{"ID":"20240607144438-5bhzzfv","Type":"NodeParagraph","Properties":{"id":"20240607144438-5bhzzfv","updated":"20240607144438"},"Children":[{"Type":"NodeText","Data":"蔓荆子，味苦、辛、甘，气温、微寒，阳中之阴，无毒。入太阳经。主筋骨寒热，湿痹拘挛，本经头痛，头沉昏闷，利关节，长发，通九窍，去虫，散风淫，明目，耳鸣乃止，齿动尤坚。此物散而不补，何能轻身耐老。胃虚因不可用，气血弱衰者，尤不可频用也。"}]},{"ID":"20240607144438-7dxqbsj","Type":"NodeParagraph","Properties":{"id":"20240607144438-7dxqbsj","updated":"20240607144438"},"Children":[{"Type":"NodeText","Data":"或问蔓荆子，止头痛圣药，凡有风邪在头面者，俱可用，而吾子又以为不可频用，谓其攻而不补也。但药取其去病，能去病，又何虑用之频与不频哉。不知蔓荆子体轻而浮，虽散气不至于太甚，似乎有邪者，俱可用之。然而，虚弱者少有所损，则气怯神虚，而不胜其野狼狈矣。予言不可频用者，为虚者言之也。若形气实，邪塞于上焦，又安在所禁之内哉。"}]},{"ID":"20240607144438-41f5dac","Type":"NodeParagraph","Properties":{"id":"20240607144438-41f5dac","updated":"20240607144438"},"Children":[{"Type":"NodeText","Data":"蔓荆子佐补药中，以治头痛尤效，因其体轻力薄，藉之易于上升也。倘单恃一味，欲取胜于顷刻，则不能也。"}]},{"ID":"20240607144438-45n7etv","Type":"NodeParagraph","Properties":{"id":"20240607144438-45n7etv","updated":"20240607144438"},"Children":[{"Type":"NodeText","Data":"或问蔓荆子入太阳经，能散风邪，何仲景张公不用之以表太阳之风邪，得毋非太阳之药乎？"}]},{"ID":"20240607144438-dr51yfh","Type":"NodeParagraph","Properties":{"id":"20240607144438-dr51yfh","updated":"20240607144438"},"Children":[{"Type":"NodeText","Data":"不知蔓荆子入太阳之营卫，不能如桂枝单散卫而不散营，麻黄单散营而不散卫，各有专功。"}]},{"ID":"20240607144438-qoxjlam","Type":"NodeParagraph","Properties":{"id":"20240607144438-qoxjlam","updated":"20240607144438"},"Children":[{"Type":"NodeText","Data":"伤寒初入之时，邪未深入，在卫不可引入营，在营不可仍散卫。蔓荆子营卫齐散，所以不宜矣。"}]},{"ID":"20240607144426-u0oxtw0","Type":"NodeThematicBreak","Properties":{"id":"20240607144426-u0oxtw0"}},{"ID":"20240607144427-5ar5adu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144427-5ar5adu","updated":"20240607144432"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草择要纲目》"}]},{"ID":"20240607144427-s89fdqf","Type":"NodeParagraph","Properties":{"id":"20240607144427-s89fdqf","updated":"20240607144427"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240607144427-n06vzzf","Type":"NodeParagraph","Properties":{"id":"20240607144427-n06vzzf","updated":"20240607144427"},"Children":[{"Type":"NodeText","Data":"苦微寒无毒．阳中之阴．入太阳经．胃虚人不可服．恐生痰疾．"}]},{"ID":"20240607144427-w2kdvv7","Type":"NodeParagraph","Properties":{"id":"20240607144427-w2kdvv7","updated":"20240607144427"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240607144427-k320v22","Type":"NodeParagraph","Properties":{"id":"20240607144427-k320v22","updated":"20240607144427"},"Children":[{"Type":"NodeText","Data":"明目坚齿．利九窍．头痛脑鸣．目翳泪出．散风邪．凉诸经血．止目睛内痛．搜肝风．盖蔓荆实气清味辛．体轻而浮．上行而散．故所主皆头面风虚之症也．"}]},{"ID":"20240607144348-w1cs4kc","Type":"NodeThematicBreak","Properties":{"id":"20240607144348-w1cs4kc"}},{"ID":"20240607144414-nqo2yzx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144414-nqo2yzx","updated":"20240607144421"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草经解》"}]},{"ID":"20240607144414-4uktq9y","Type":"NodeParagraph","Properties":{"id":"20240607144414-4uktq9y","updated":"20240607144414"},"Children":[{"Type":"NodeText","Data":"气微寒．味苦．无毒．主筋骨间．寒热湿痹拘挛．明目坚齿．利九窍．去白虫．久服轻身耐老．蔓荆子气微寒．禀天冬寒之水气．入足少阴肾经、足太阳寒水膀胱经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．太阳寒水．主筋所生之病．而骨者肾之合也．蔓荆寒可清热．苦可燥湿．湿热攘．则寒热退而拘挛愈矣．气寒壮水．味苦清火．火清则目明．水壮则齿坚．齿乃肾之余也．九窍者．耳目鼻各二．口大小便各一也．苦味清火．所以九窍皆利也．白虫湿热所化．苦寒入膀胱以泻湿热．所以去白虫也．久服轻身者祛湿之功．耐老者壮水之力也．"}]},{"ID":"20240607144414-bpkxfsa","Type":"NodeParagraph","Properties":{"id":"20240607144414-bpkxfsa","updated":"20240607144414"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240607144414-mrcgial","Type":"NodeParagraph","Properties":{"id":"20240607144414-mrcgial","updated":"20240607144414"},"Children":[{"Type":"NodeText","Data":"蔓荆子同甘菊、荆芥、黄芩、乌梅、芽茶、白蒺藜、川芎、黑豆、土茯苓．治偏正头风．目将损者．"}]},{"ID":"20240607144328-qtm62z3","Type":"NodeThematicBreak","Properties":{"id":"20240607144328-qtm62z3"}},{"ID":"20240607144351-n0bdgwx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144351-n0bdgwx","updated":"20240607144405"},"Children":[{"Type":"NodeText","Data":"蔓荆子《要药分剂》"}]},{"ID":"20240607144351-298i2ev","Type":"NodeParagraph","Properties":{"id":"20240607144351-298i2ev","updated":"20240607144351"},"Children":[{"Type":"NodeText","Data":"味苦辛。性微寒。无毒。禀阳气以生。兼得金化而成。升也。阳也。恶乌头、石膏。"}]},{"ID":"20240607144351-d724mfp","Type":"NodeParagraph","Properties":{"id":"20240607144351-d724mfp","updated":"20240607144351"},"Children":[{"Type":"NodeText","Data":"【主治】主筋骨间寒热。湿痹拘挛。明目坚齿。利九窍。去白虫。（本经）风头痛。脑鸣。"}]},{"ID":"20240607144351-kbdn8jp","Type":"NodeParagraph","Properties":{"id":"20240607144351-kbdn8jp","updated":"20240607144351"},"Children":[{"Type":"NodeText","Data":"目凉诸【归经】入肝膀胱二经。兼入胃经。为搜风凉血之品。（兼轻剂能散上部风热）【前论】之才曰。齿虽属肾。为骨之余。而上龈属胃。下龈属大肠。阳明风热上攻。则动摇肿痛。蔓荆能散阳明风热。故齿坚。时珍曰。体轻浮。上升而散。故所主者。皆头面风热之症。仲淳曰。六淫之邪。风则伤筋。寒则伤骨。而为寒热。甚则或成湿痹。或为拘挛。"}]},{"ID":"20240607144351-qaa09hr","Type":"NodeParagraph","Properties":{"id":"20240607144351-qaa09hr","updated":"20240607144351"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。头目痛不因风邪而由血虚有火者。忌之。元素云。胃虚人不可服。恐生痰【炮制】雷公曰。凡使。去蒂子下白膜。酒浸一日。蒸之。晒干用。"}]},{"ID":"20240607144328-2irhtqg","Type":"NodeThematicBreak","Properties":{"id":"20240607144328-2irhtqg"}},{"ID":"20240607144335-i2p8yao","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144335-i2p8yao","updated":"20240607144341"},"Children":[{"Type":"NodeText","Data":"蔓荆子《本草崇原》"}]},{"ID":"20240607144335-85dx8sr","Type":"NodeParagraph","Properties":{"id":"20240607144335-85dx8sr","updated":"20240607144335"},"Children":[{"Type":"NodeText","Data":"气味苦，微寒，无毒。主治筋骨间寒热，湿痹拘挛，明目，坚齿，利九窍，去白虫。久服轻身耐老，小荆实亦等。"}]},{"ID":"20240607144335-c0nj6wz","Type":"NodeParagraph","Properties":{"id":"20240607144335-c0nj6wz","updated":"20240607144335"},"Children":[{"Type":"NodeText","Data":"（蔓荆生于水滨，苗高丈余，其茎小弱如蔓，故名蔓荆。春叶夏茂，六月有花，淡红色，九月成实，黑斑色，大如梧子而轻虚。一种木本者，其枝茎坚劲作科不作蔓，名牡荆，结实如麻子大，又名小荆实。）"}]},{"ID":"20240607144335-30ezjk4","Type":"NodeParagraph","Properties":{"id":"20240607144335-30ezjk4","updated":"20240607144335"},"Children":[{"Type":"NodeText","Data":"蔓荆多生水滨，其子黑色，气味苦寒，禀太阳寒水之气化，盖太阳本寒标热，少阴本热标寒。主治筋骨间寒热者，太阳主筋病，少阴主骨病，治太阳、少阴之寒热也。湿痹拘挛，湿伤筋骨也。益水之精，故明目。补骨之余，故坚齿。九窍为水注之气，水精充足，故利九窍。"}]},{"ID":"20240607144335-3j4rejx","Type":"NodeParagraph","Properties":{"id":"20240607144335-3j4rejx","updated":"20240607144335"},"Children":[{"Type":"NodeText","Data":"虫乃阴类，太阳有标阳之气，故去白虫。久服则筋骨强健，故轻身耐老。小荆实亦等，言蔓荆之外，更有一种小荆，其实与蔓荆之实功力相等，可合一而并用也。"}]},{"ID":"20240607144230-psy7xza","Type":"NodeThematicBreak","Properties":{"id":"20240607144230-psy7xza"}},{"ID":"20240607144315-bxs15jv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144315-bxs15jv","updated":"20240607144321"},"Children":[{"Type":"NodeText","Data":"蔓荆子《医学入门》"}]},{"ID":"20240607144315-67ccd8z","Type":"NodeParagraph","Properties":{"id":"20240607144315-67ccd8z","updated":"20240607144315"},"Children":[{"Type":"NodeText","Data":"蔓荆子味苦甘辛，主筋骨痹热寒攻，明目坚齿脑鸣痛，长须利窍杀白虫。"}]},{"ID":"20240607144315-vzyaxw7","Type":"NodeParagraph","Properties":{"id":"20240607144315-vzyaxw7","updated":"20240607144315"},"Children":[{"Type":"NodeText","Data":"出秦地，六月开花，九月结实，故名蔓。无毒。阳中阴也，太阳经药。主筋骨寒热，湿痹拘挛，除目睛内痛，赤肿泪出，齿痛头痛，头昏脑鸣，凉诸经血故也。兼能长须发，利关节通窍，杀白虫，胃虚者禁用。酒蒸一时，晒于捣碎，恶乌头、石膏。"}]},{"ID":"20240607144212-4pmvw3r","Type":"NodeThematicBreak","Properties":{"id":"20240607144212-4pmvw3r"}},{"ID":"20240607144220-uukf077","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144220-uukf077","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"《中国药典》：蔓荆子"}]},{"ID":"20240607144220-euwvykq","Type":"NodeParagraph","Properties":{"id":"20240607144220-euwvykq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607144220-p9kkx66","Type":"NodeParagraph","Properties":{"id":"20240607144220-p9kkx66","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" Màn Jīnɡ Zǐ"}]},{"ID":"20240607144220-cib2mj0","Type":"NodeParagraph","Properties":{"id":"20240607144220-cib2mj0","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607144220-3ovw1jw","Type":"NodeParagraph","Properties":{"id":"20240607144220-3ovw1jw","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 白背木耳、白背杨、水捻子、白布荆"}]},{"ID":"20240607144220-q7nmf8i","Type":"NodeParagraph","Properties":{"id":"20240607144220-q7nmf8i","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607144220-v9j7aol","Type":"NodeParagraph","Properties":{"id":"20240607144220-v9j7aol","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" FRUCTUS VITICIS"}]},{"ID":"20240607144220-lae9g1p","Type":"NodeParagraph","Properties":{"id":"20240607144220-lae9g1p","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607144220-p3miq9t","Type":"NodeParagraph","Properties":{"id":"20240607144220-p3miq9t","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 本品为马鞭草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单叶蔓荆"},{"Type":"NodeText","Data":"Vitex trifolia L. var. simplicifolia Cham. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蔓荆"},{"Type":"NodeText","Data":"Vitex trifolia L.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。秋季果实成熟时采收，除去杂质，晒干。"}]},{"ID":"20240607144220-o2bkjqn","Type":"NodeParagraph","Properties":{"id":"20240607144220-o2bkjqn","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607144220-jfmhxeo","Type":"NodeParagraph","Properties":{"id":"20240607144220-jfmhxeo","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 本品呈球形，直径4～6mm。表面灰黑色或黑褐色，被灰白色粉霜状茸毛，有纵向浅沟4条，顶端微凹，基部有灰白色宿萼及短果梗。萼长为果实的1/3～2/3，5齿裂，其中2裂较深，密被茸毛。体轻，质坚韧，不易破碎。横切面可见4室，每室有种子1枚。气特异而芳香，味淡、微辛。"}]},{"ID":"20240607144220-j0nwieu","Type":"NodeParagraph","Properties":{"id":"20240607144220-j0nwieu","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607144220-s95btta","Type":"NodeParagraph","Properties":{"id":"20240607144220-s95btta","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240607144220-12w6iq9","Type":"NodeParagraph","Properties":{"id":"20240607144220-12w6iq9","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607144220-h7xa0kz","Type":"NodeParagraph","Properties":{"id":"20240607144220-h7xa0kz","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蔓荆子"},{"Type":"NodeText","Data":":除去杂质。"}]},{"ID":"20240607144220-8lu7eqk","Type":"NodeParagraph","Properties":{"id":"20240607144220-8lu7eqk","updated":"20240607144220"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒蔓荆子"},{"Type":"NodeText","Data":":取净蔓荆子，照清炒法（附录Ⅱ D）微炒。用时捣碎。"}]},{"ID":"20240607144220-xwiz079","Type":"NodeParagraph","Properties":{"id":"20240607144220-xwiz079","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607144220-04v55om","Type":"NodeParagraph","Properties":{"id":"20240607144220-04v55om","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末灰褐色。花萼表皮细胞类圆形，壁多弯曲；非腺毛2～3细胞，顶端细胞基部稍粗，有疣状突起。外果皮细胞多角形，有角质纹理和毛茸脱落后的痕迹，并有腺毛与非腺毛：腺毛分头部单细胞、柄1～2细胞及头部2～6细胞、柄单细胞两种；非腺毛2～4细胞，长14～68μm ，多弯曲，有壁疣。中果皮细胞长圆形或类圆形，壁微木化，纹孔明显。油管多破碎，含分泌物，周围细胞有淡黄色油滴。内果皮石细胞椭圆形或近方形，直径10～35μm 。种皮细胞圆形或类圆形，直径42～73μm,壁有网状纹理，木化。"}]},{"ID":"20240607144220-qwphwgq","Type":"NodeParagraph","Properties":{"id":"20240607144220-qwphwgq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"（2）取本品5g，加石油醚（60～90℃）50ml，加热回流2小时，滤过，弃去石油醚，药渣挥干，加丙酮80ml，加热回流1.5小时，滤过，滤液蒸干，残渣加甲醇2ml使溶解，作为供试品溶液。另取蔓荆子黄素对照品，加甲醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一用1％氢氧化钠溶液制备的硅胶G薄层板上，以环己烷-醋酸乙酯-甲醇（3：2：0.2）为展开剂，展开，取出，晾干，喷以10％三氯化铝乙醇溶液。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607144220-2mj3any","Type":"NodeParagraph","Properties":{"id":"20240607144220-2mj3any","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607144220-e2mk170","Type":"NodeParagraph","Properties":{"id":"20240607144220-e2mk170","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 归膀胱、肝、胃经。"}]},{"ID":"20240607144220-vqyayfq","Type":"NodeParagraph","Properties":{"id":"20240607144220-vqyayfq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607144220-da8w25w","Type":"NodeParagraph","Properties":{"id":"20240607144220-da8w25w","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 辛、苦，微寒。"}]},{"ID":"20240607144220-w5ldbdh","Type":"NodeParagraph","Properties":{"id":"20240607144220-w5ldbdh","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607144220-bzjb9kc","Type":"NodeParagraph","Properties":{"id":"20240607144220-bzjb9kc","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 疏散风热，清利头目。用于风热感冒头痛，齿龈肿痛，目赤多泪，目暗不明，头晕目眩。"}]},{"ID":"20240607144220-i6f10da","Type":"NodeParagraph","Properties":{"id":"20240607144220-i6f10da","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607144220-x3qppns","Type":"NodeParagraph","Properties":{"id":"20240607144220-x3qppns","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 5～9g。"}]},{"ID":"20240607144220-qpclg43","Type":"NodeParagraph","Properties":{"id":"20240607144220-qpclg43","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607144220-kvo8qfw","Type":"NodeParagraph","Properties":{"id":"20240607144220-kvo8qfw","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" （1）用于感受风热引起的头痛，临床常与防风、菊花、石膏等配伍应用；对于头风头痛病症，本品又可与藁本、川芎等配伍应用。治风邪所致的目赤肿痛、头目昏暗，常与菊花、川芎、决明子等配伍应用。"}]},{"ID":"20240607144220-akwpbhm","Type":"NodeParagraph","Properties":{"id":"20240607144220-akwpbhm","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607144220-m6yzw9x","Type":"NodeParagraph","Properties":{"id":"20240607144220-m6yzw9x","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607144220-wk5ga7n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144220-wk5ga7n","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蔓荆子"}]},{"ID":"20240607144220-nqo3fv0","Type":"NodeParagraph","Properties":{"id":"20240607144220-nqo3fv0","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607144220-4v3ivby","Type":"NodeParagraph","Properties":{"id":"20240607144220-4v3ivby","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" Màn Jīnɡ Zǐ"}]},{"ID":"20240607144220-kt1cmt0","Type":"NodeParagraph","Properties":{"id":"20240607144220-kt1cmt0","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607144220-tq1dngf","Type":"NodeParagraph","Properties":{"id":"20240607144220-tq1dngf","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 蔓荆实（《本经》），荆子（《本草经集注》），万荆子（《浙江中药手册》），蔓青子（《中药材手册》）。"}]},{"ID":"20240607144220-vpo0onf","Type":"NodeParagraph","Properties":{"id":"20240607144220-vpo0onf","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607144220-61jtx3j","Type":"NodeParagraph","Properties":{"id":"20240607144220-61jtx3j","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240607144220-iikow5x","Type":"NodeParagraph","Properties":{"id":"20240607144220-iikow5x","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607144220-6x13d88","Type":"NodeParagraph","Properties":{"id":"20240607144220-6x13d88","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 为马鞭草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单叶蔓荆"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蔓荆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。秋季果实成熟时采收。晒干，去净杂质，贮干燥处，防止潮湿霉烂。"}]},{"ID":"20240607144220-5qosvlz","Type":"NodeParagraph","Properties":{"id":"20240607144220-5qosvlz","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607144220-5eejn7p","Type":"NodeParagraph","Properties":{"id":"20240607144220-5eejn7p","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 主产山东、浙江、江西、福建。此外，河南、江苏、安徽、湖南、湖北、广东、广西、云南等地亦产。"}]},{"ID":"20240607144220-lf9szdt","Type":"NodeParagraph","Properties":{"id":"20240607144220-lf9szdt","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607144220-rgkkom1","Type":"NodeParagraph","Properties":{"id":"20240607144220-rgkkom1","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" ①单叶蔓荆"}]},{"ID":"20240607144220-a5ujg95","Type":"NodeParagraph","Properties":{"id":"20240607144220-a5ujg95","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"落叶灌木或小乔木，高约3米，有香气。幼枝4方形，密生细柔毛，者枝渐变圆，毛渐脱落。单叶，叶柄长5～18毫米；叶片卵形或倒卵形，长2.5～5厘米，宽1.5～3厘米，先端短尖，基部楔形至圆形，全缘，上面绿色，疏生短柔毛和腺点，下面白色，密生短柔毛和腺点，侧脉约8对。圆锥花序顶生，长2～12厘米；花萼钟形，先端具5短刺，外面密生白色短柔毛，萼筒长约4毫米；花冠淡紫色，5裂，中间1裂片最大，下半有毛：雄蕊4，伸出花冠管外，花药个字形分叉；子房球形，密生腺点，花柱无毛，柱头2裂。浆果球形，直径5～7毫米，大部为增大的宿存花萼所包围。花期7月。果期9月。"}]},{"ID":"20240607144220-rl5ucmz","Type":"NodeParagraph","Properties":{"id":"20240607144220-rl5ucmz","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"生长海滨、沙滩、湖畔等处。分布辽宁、河北、河南、山东、安徽、江苏、浙江、福建、台湾、江西、湖南、湖北、云南、广东等地。"}]},{"ID":"20240607144220-oc4vh9j","Type":"NodeParagraph","Properties":{"id":"20240607144220-oc4vh9j","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②蔓荆（《本经》），又名：白背木耳（《岭南采药录》），小刀豆藤、白背风、白背草。"}]},{"ID":"20240607144220-wnxcs9s","Type":"NodeParagraph","Properties":{"id":"20240607144220-wnxcs9s","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"形态与单叶蔓荆相似，所异者叶通常为3小叶的复叶，在同一枝条的上部或下部有时为单叶；小叶无柄；小叶片倒卵形或倒披针形，中间小叶通常比侧生的长约1/3，叶柄长1～3厘米，密被细绒毛。聚伞花序多数，相对排列成顶生圆锥花序。花期7月。果期11月。"}]},{"ID":"20240607144220-hfa3ykp","Type":"NodeParagraph","Properties":{"id":"20240607144220-hfa3ykp","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"生长于平原草地、河滩和荒地上。分布我国沿海各省及云南、广西等地。"}]},{"ID":"20240607144220-88rs1mo","Type":"NodeParagraph","Properties":{"id":"20240607144220-88rs1mo","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607144220-wh9uhgq","Type":"NodeParagraph","Properties":{"id":"20240607144220-wh9uhgq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 干燥果实圆球形，直径4～6毫米。表面灰黑色或黑褐色，被灰白色粉霜，有4条纵沟；用放大镜观察，密布淡黄色小点。底部有薄膜状宿萼及小果柄，宿萼包被果实的1/3～2/3，边缘5齿裂，常深裂成两瓣，灰白色，密生细柔毛。体轻，质坚韧，不易破碎，横断面果皮灰黄色，有棕褐色油点，内分四室，每室有种子1枚，种仁白色，有油性。气特异而芳香，味淡微辛。以粒大、饱满、气芳香、无杂质者为佳。"}]},{"ID":"20240607144220-yt9l8cq","Type":"NodeParagraph","Properties":{"id":"20240607144220-yt9l8cq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607144220-bacx315","Type":"NodeParagraph","Properties":{"id":"20240607144220-bacx315","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 单叶蔓荆果实和叶含挥发油，主要成分为莰烯和蒎烯，并含有微量生物碱和维生素A；果实中尚含牡荆子黄酮，即紫花牡荆素。"}]},{"ID":"20240607144220-a7qshly","Type":"NodeParagraph","Properties":{"id":"20240607144220-a7qshly","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"蔓荆果实含少量（0.01％）蔓荆子碱。"}]},{"ID":"20240607144220-2jh1dus","Type":"NodeParagraph","Properties":{"id":"20240607144220-2jh1dus","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607144220-drgu1do","Type":"NodeParagraph","Properties":{"id":"20240607144220-drgu1do","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 炒蔓荆子：筛净灰屑，除去残存萼片，置锅内用武火炒至焦黄色，略喷清水，放凉。"}]},{"ID":"20240607144220-iho4frc","Type":"NodeParagraph","Properties":{"id":"20240607144220-iho4frc","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使蔓荆子，去蒂子下白膜一重，用酒浸一伏时后蒸，从巳至未，出，晒干用。\""}]},{"ID":"20240607144220-jmq7hb5","Type":"NodeParagraph","Properties":{"id":"20240607144220-jmq7hb5","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607144220-fxtewe7","Type":"NodeParagraph","Properties":{"id":"20240607144220-fxtewe7","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 入肝、胃、膀胱经。"}]},{"ID":"20240607144220-7348qn0","Type":"NodeParagraph","Properties":{"id":"20240607144220-7348qn0","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"太阳经药。\""}]},{"ID":"20240607144220-vq735zt","Type":"NodeParagraph","Properties":{"id":"20240607144220-vq735zt","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肝经。\""}]},{"ID":"20240607144220-rhya4o0","Type":"NodeParagraph","Properties":{"id":"20240607144220-rhya4o0","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足太阳、厥阴，兼入足阳明经。\""}]},{"ID":"20240607144220-brii7le","Type":"NodeParagraph","Properties":{"id":"20240607144220-brii7le","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607144220-qagm9ki","Type":"NodeParagraph","Properties":{"id":"20240607144220-qagm9ki","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 苦辛，凉。"}]},{"ID":"20240607144220-emmk2gy","Type":"NodeParagraph","Properties":{"id":"20240607144220-emmk2gy","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，微寒。\""}]},{"ID":"20240607144220-kcp5t8r","Type":"NodeParagraph","Properties":{"id":"20240607144220-kcp5t8r","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②《珍珠囊》：\"苦，辛。\""}]},{"ID":"20240607144220-w8rhzpi","Type":"NodeParagraph","Properties":{"id":"20240607144220-w8rhzpi","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607144220-sehjebh","Type":"NodeParagraph","Properties":{"id":"20240607144220-sehjebh","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 血虚有火之头痛目眩及胃虚者慎服。"}]},{"ID":"20240607144220-88mvdsi","Type":"NodeParagraph","Properties":{"id":"20240607144220-88mvdsi","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶乌头、石膏。\""}]},{"ID":"20240607144220-jda0jhv","Type":"NodeParagraph","Properties":{"id":"20240607144220-jda0jhv","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②《医学启源》：\"胃虚人不可服，恐生痰。\""}]},{"ID":"20240607144220-lkcmspx","Type":"NodeParagraph","Properties":{"id":"20240607144220-lkcmspx","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"头目痛不因风邪，而由于血虚有火者忌之。\""}]},{"ID":"20240607144220-3pken9a","Type":"NodeParagraph","Properties":{"id":"20240607144220-3pken9a","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》：\"痿痹拘挛不由风湿之邪，而由于阳虚血涸筋衰者勿用也；寒疝脚气不由阴湿外感，而由于肝脾羸败者亦勿用也。\""}]},{"ID":"20240607144220-zgi85b6","Type":"NodeParagraph","Properties":{"id":"20240607144220-zgi85b6","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607144220-1tyfc3t","Type":"NodeParagraph","Properties":{"id":"20240607144220-1tyfc3t","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 疏散风热，清利头目。治风热感冒，正、偏头痛，齿痛，赤眼，目睛内痛，昏暗多泪，湿痹拘挛。\""}]},{"ID":"20240607144220-nitnws3","Type":"NodeParagraph","Properties":{"id":"20240607144220-nitnws3","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主筋骨间寒热，湿痹拘挛，明目，坚齿，利九窍，去白虫。\""}]},{"ID":"20240607144220-zuww3zn","Type":"NodeParagraph","Properties":{"id":"20240607144220-zuww3zn","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"主发秃落。\""}]},{"ID":"20240607144220-j3d045z","Type":"NodeParagraph","Properties":{"id":"20240607144220-j3d045z","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"去长虫，主风头痛，脑鸣，目泪出；益气，令人光泽脂致。\""}]},{"ID":"20240607144220-ft6856p","Type":"NodeParagraph","Properties":{"id":"20240607144220-ft6856p","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治贼风，能长髭发。\""}]},{"ID":"20240607144220-91b64hv","Type":"NodeParagraph","Properties":{"id":"20240607144220-91b64hv","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"利关节，治赤眼，痫疾。\""}]},{"ID":"20240607144220-ynsyhtj","Type":"NodeParagraph","Properties":{"id":"20240607144220-ynsyhtj","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"凉诸经血，止头痛，主目睛内痛。\""}]},{"ID":"20240607144220-qcfo4jo","Type":"NodeParagraph","Properties":{"id":"20240607144220-qcfo4jo","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑦王好古：\"搜肝风。\""}]},{"ID":"20240607144220-ffbjna4","Type":"NodeParagraph","Properties":{"id":"20240607144220-ffbjna4","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑧《医林纂要》：\"散热，祛风，兼能燥湿。\""}]},{"ID":"20240607144220-fcvhsgr","Type":"NodeParagraph","Properties":{"id":"20240607144220-fcvhsgr","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑨《广西中药志》：\"治胃痛。\""}]},{"ID":"20240607144220-xg8e0tb","Type":"NodeParagraph","Properties":{"id":"20240607144220-xg8e0tb","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑩广州部队《常用中草药手册》：\"疏风散热，平肝止痛。治感冒发热，眼痛眩晕，风湿筋骨痛，消化不良，肠炎腹泻，跌打肿痛。\""}]},{"ID":"20240607144220-n1bfmyp","Type":"NodeParagraph","Properties":{"id":"20240607144220-n1bfmyp","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607144220-iw17p0u","Type":"NodeParagraph","Properties":{"id":"20240607144220-iw17p0u","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～3钱；浸酒或入丸、散。外用：捣敷。"}]},{"ID":"20240607144220-hfn59td","Type":"NodeParagraph","Properties":{"id":"20240607144220-hfn59td","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607144220-7l00wop","Type":"NodeParagraph","Properties":{"id":"20240607144220-7l00wop","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" ①治头风：蔓荆子二升（末），酒一斗。绢袋盛.浸七宿，温服三合，日三。（《千金方》）"}]},{"ID":"20240607144220-vuf2h1n","Type":"NodeParagraph","Properties":{"id":"20240607144220-vuf2h1n","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②治风寒侵目，肿痛出泪，涩胀羞明：蔓荆子三钱，荆芥、白蒺藜各二钱，柴胡、防风各一钱，甘草五分。水煎服。（《本草汇言》）"}]},{"ID":"20240607144220-78xrtzz","Type":"NodeParagraph","Properties":{"id":"20240607144220-78xrtzz","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"③治劳役饮食不节，内障眼病：黄芪、人参各一两，炙甘草八钱，蔓荆子二钱半，黄柏三钱（酒拌炒四遍），白芍药三钱。上嚼咀，每服三、五钱，水煎。（《兰室秘藏》蔓荆子汤）"}]},{"ID":"20240607144220-f2mbel5","Type":"NodeParagraph","Properties":{"id":"20240607144220-f2mbel5","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607144220-xcjm5hj","Type":"NodeParagraph","Properties":{"id":"20240607144220-xcjm5hj","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"蔓荆实，气轻味辛，体轻而浮，上行而散，故所主者皆头面风虚之症。\""}]},{"ID":"20240607144220-o0c6pne","Type":"NodeParagraph","Properties":{"id":"20240607144220-o0c6pne","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"②《本草经巯》：\"蔓荆实，’神农’味苦，微寒，无毒；《别录》加辛平温。察其功用，应是苦温辛散之性，而寒则甚少也。气清味薄，浮而升，阳也。其主筋骨间寒热，湿痹拘挛，风头痛、脑鸣、目泪出者，盖以六淫之邪，风则伤筋，寒则伤骨，而为寒热，甚则或成湿痹，或为拘挛；又足太阳之脉，夹脊循项而络于脑，目为厥阴开窍之位，邪伤二经，则头痛、脑鸣、目泪出。此药味辛气温，入二脏而散风寒之邪，则诸证悉除矣。邪去则九窍自通，痹散则光泽脂致。其主坚齿者，齿虽属肾，而床属阳明，阳明客风热，则上攻牙齿，为动摇肿痛，散阳明之风热，则齿自坚矣。去白虫、长虫者，假其苦辛之味耳。\""}]},{"ID":"20240607144220-cwhvp69","Type":"NodeParagraph","Properties":{"id":"20240607144220-cwhvp69","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"蔓荆子，主头面诸风疾之药也。前古主通利九窍.活利关节，明目坚齿，祛除风寒风热之邪。其辛温轻散，浮而上行，故所主头面虚风诸证。推其通九窍，利关节而言，故后世治湿痹拘挛，寒疝脚气，入汤散中，屡用奏效，又不拘于头面上部也。\""}]},{"ID":"20240607144220-y73mhtx","Type":"NodeParagraph","Properties":{"id":"20240607144220-y73mhtx","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"蔓荆子，能疏风、凉血、利窍，凡太阳头痛，及偏头风、脑鸣、目泪、目昏，皆血热风淫所致，以此凉之，取其气薄主升，佐神效黄芪汤，疏消障翳，使目复光，为肝经胜药。\""}]},{"ID":"20240607144220-u654z6l","Type":"NodeParagraph","Properties":{"id":"20240607144220-u654z6l","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑤《本草新编》：\"蔓荆子，佐补中药以治头痛最效，因其体轻力薄，藉之易于上升也，倘单恃一味，欲取胜于俄顷，则不能。\""}]},{"ID":"20240607144220-1xznv0q","Type":"NodeParagraph","Properties":{"id":"20240607144220-1xznv0q","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"⑥张寿颐：\"凡草木之子，多坚实沉重，性皆下行，蔓荆之实，虽不甚重，然其性必降，《本经》谓主治筋骨间寒热，湿痹拘挛，明目、坚齿、利九窍，固皆清泄降火之功用。《别录》虽加以辛字，而主治风头痛，脑鸣、目泪出，仍是内风升腾之病，用以清降，断非疏散外风之品。《日华子》谓治赤目；张洁古谓治头沉昏闷，止目睛内痛；王海藏谓搜肝风；皆是息风降火，其义甚明。独甄权谓治贼风；洁古又谓治太阳头痛，散风邪；则误作疏散之药，绝非《本经》、《别录》真旨。盖内风、外风，治法含浑，久为汉、魏以来通病，甄权等此说，实属误认，奈何濒湖《纲目》，亦谓其气清味辛，体轻而浮，上行而散，竟以甄权等之误说，反加附会而为之证实。近三百年，更无人能知蔓荆子之真实功用矣。然濒湖亦谓所主者皆头面风虚之证，则试问风而属虚，岂有再用浮散主治之理?《千金方》以一味蔓荆子为末，浸酒服，治头风作痛，亦是内风，非祛散外风之法，其用酒者乃借酒力引之上行，使药力达于头脑之意。轻用一钱五分，重用可至三、四钱。\""}]},{"ID":"20240607144220-skgja3d","Type":"NodeParagraph","Properties":{"id":"20240607144220-skgja3d","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607144220-kqssa6f","Type":"NodeParagraph","Properties":{"id":"20240607144220-kqssa6f","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607144220-7r73mr1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607144220-7r73mr1","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蔓荆子"}]},{"ID":"20240607144220-ut773wd","Type":"NodeParagraph","Properties":{"id":"20240607144220-ut773wd","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607144220-e7psxk6","Type":"NodeParagraph","Properties":{"id":"20240607144220-e7psxk6","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" Màn Jīnɡ Zǐ"}]},{"ID":"20240607144220-anljj8k","Type":"NodeParagraph","Properties":{"id":"20240607144220-anljj8k","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607144220-3btxhm8","Type":"NodeParagraph","Properties":{"id":"20240607144220-3btxhm8","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 蔓荆实、荆子、万荆子、蔓青子"}]},{"ID":"20240607144220-molzl5d","Type":"NodeParagraph","Properties":{"id":"20240607144220-molzl5d","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607144220-cve3vxb","Type":"NodeParagraph","Properties":{"id":"20240607144220-cve3vxb","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" Simpleleaf Shrub ChasteTCMLIBee Fruit，Fruit of Shrub ChasteTCMLIBee，Fruit of Threeleaf ChasteTCMLIBee"}]},{"ID":"20240607144220-i8ydjg9","Type":"NodeParagraph","Properties":{"id":"20240607144220-i8ydjg9","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607144220-0zu8jty","Type":"NodeParagraph","Properties":{"id":"20240607144220-0zu8jty","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 出自《本草经集注》1.《唐本草》：蔓荆，苗蔓生，故名蔓荆。生水滨。叶似杏叶而细，茎长丈余，花红白色。今人误以小荆为蔓荆，遂将蔓荆子为牡荆子也。"}]},{"ID":"20240607144220-oee501w","Type":"NodeParagraph","Properties":{"id":"20240607144220-oee501w","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：《图经》云：蔓荆，蔓生水滨，苗叶蔓延，春因旧枝而生小叶，五月叶成如杏叶。六月有花，浅红色，蕊黄。九月有实，黑斑，大如梧子而虚轻。冬则叶雕。"}]},{"ID":"20240607144220-kn4hfr8","Type":"NodeParagraph","Properties":{"id":"20240607144220-kn4hfr8","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：蔓荆，旧不载所出州土，今近京及秦、陇、阴、越州多有之。苗茎高四尺，对节"}]},{"ID":"20240607144220-u8lhurz","Type":"NodeParagraph","Properties":{"id":"20240607144220-u8lhurz","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607144220-phyjozj","Type":"NodeParagraph","Properties":{"id":"20240607144220-phyjozj","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 药材基源：为马鞭草科植物单叶蔓荆和蔓荆的果实。"}]},{"ID":"20240607144220-nk5ic63","Type":"NodeParagraph","Properties":{"id":"20240607144220-nk5ic63","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Vitex TCMLIBifolia L. var. simplicifolia Cham.[V.rotundifolia L.f.;V. ouata Thunb.]"}]},{"ID":"20240607144220-jxpgvpj","Type":"NodeParagraph","Properties":{"id":"20240607144220-jxpgvpj","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"采收和储藏：种子繁殖的栽培后3-4年结果，扦插繁殖的栽后2-3年结果，在7月上旬至10月下旬果实陆续成熟，应边成熟边采摘，先在室内堆放3-4d，然后摊开晒或烘干，筛去枝梗，扬净杂质即成。"}]},{"ID":"20240607144220-i5jqcp9","Type":"NodeParagraph","Properties":{"id":"20240607144220-i5jqcp9","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607144220-d2um7mq","Type":"NodeParagraph","Properties":{"id":"20240607144220-d2um7mq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.单叶蔓荆生长海滨沙滩地及湖畔，亦有栽培。"}]},{"ID":"20240607144220-28nviym","Type":"NodeParagraph","Properties":{"id":"20240607144220-28nviym","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"2.蔓荆海边、沙滩、河边、平原及村寨附近。"}]},{"ID":"20240607144220-yqx68k5","Type":"NodeParagraph","Properties":{"id":"20240607144220-yqx68k5","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"资源分布：1.单叶蔓荆：分布辽宁、河北、山东、江苏、安徽、浙江、江西、福建、台湾、广东。 2.蔓荆：分布于福建、台湾、广东、广西、云南。"}]},{"ID":"20240607144220-9a8wan0","Type":"NodeParagraph","Properties":{"id":"20240607144220-9a8wan0","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607144220-kll9ata","Type":"NodeParagraph","Properties":{"id":"20240607144220-kll9ata","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 1.单叶蔓荆，落叶小灌木，植株高约2m。全株被灰白色柔毛。主茎匍匐地面，节上常生不定根，幼枝四棱形，老枝近圆形。单叶对生，具短柄；叶片倒卵形至椭圆形，先端钝圆，基部楔形，全缘，长 2.5-5cm，宽1.5-3cm，表面绿色，背面粉白色；侧脉约8对。圆锥花序顶生；花萼钟状，先端5齿裂；花冠淡紫色，先端5裂，下面1裂片最大，宽卵形，内面中下部有毛；雄蕊4，伸于花冠管外；子房球形，密生腺点，柱头2裂。核果球形，径约5-7mm，具宿萼。花期7-8月，果期8-10月。喜生于海滨沙滩地及湖畔，亦有栽培。分布于辽宁、河北、山东、江苏、安徽、浙江、江西、福建、台湾、广东。 2.蔓荆，落叶灌木，植株高 1.5-5m。具香味。小枝四棱形，密生细柔毛。三出复叶，对生，有时偶有单叶；叶柄长1-3cm；小叶片卵形，长倒卵形或倒卵状长圆形，长2-9cm，宽1-3cm，先端钝或短尖，基部楔形，全缘，表面绿色，无毛或被微柔毛，背面密生灰白色绒毛；侧脉8对；小叶无柄或有时中间1片小叶下延成短柄。圆锥花序顶生，长3-15cm，花序柄密被灰白色绒毛；花萼钟形，先端5浅裂，被灰白色绒毛；花冠淡紫色或蓝紫色，长6-10mm，外面有毛，花冠管内及喉部有毛，先端5裂，二唇形；雄蕊4，伸于花冠外；子房密生腺点。核果近圆形，径约5mm，熟时黑色；萼宿存。花期7月，果期9-11月。生于海边、沙滩、河边、平原及村寨附近。分布于福建、台湾、广东、广西、云南。"}]},{"ID":"20240607144220-onx1c1o","Type":"NodeParagraph","Properties":{"id":"20240607144220-onx1c1o","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607144220-7eohjgo","Type":"NodeParagraph","Properties":{"id":"20240607144220-7eohjgo","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 生物学特性 适应性较强，对环境条件要求不严。但喜温暖湿润，土壤以疏松、肥沃的砂质壤土较好。耐盐碱，在酸性上土壤生长不良。 栽培技术 可采用播种、扦插、压条、分株等方法繁殖，但以扦插繁殖为主。扦插繁殖：春、秋均可进行，但以春季扦插为好。在3月下旬或9月下旬，剪取一二年生健壮枝条，取其中段，截成长20-30cm带有2-3个节的插穗；按株行距6cm×15cm插入苗床；育苗期应经常浇水，保持苗床湿润，并适当追肥。秋季扦插的翌年春4月上旬移栽；春季扦插的当年秋季定植。种子繁殖：在秋季采收成熟时实，与2倍湿细沙拌匀，堆放阴凉通风的室内，翌年4月上、中旬播种，将果实搓去外壳，用35-40℃温水浸泡1昼夜，捞出稍晾后，与混合粪肥的火灰拌匀，条播于苗床，第1hm2播种75-105kg，苗期注意浇水，适当追肥，当年春季育苗，幼苗当年高30-40cm，秋后定植。压条繁殖：5-6月间，选一二年生的健壮长枝，用波状压条法，每隔40-50cm埋入土中，深约15cm，压实。待长出不定根后，分段栽断，带根定植。分株繁殖：在4月上旬或7月旬，随挖随栽。定植在秋季或春季，植株落叶后至萌芽前进行，按株行距1m×1.3m开穴，施土杂肥与土壤混匀，每穴栽2-3株，填土压实，浇透水。 田间管理 定植后1-2年，在春季萌芽前，6月和生产关系了落叶后各中耕除草1次，冬季中耕结合培土。追肥在定植后的前2年以施人畜粪水为主，第3、4年开花结果后，应增施堆肥和磷肥，每年施肥2次，第1次在开花前，第2次在修剪后，在花期可喷施1%过磷酸钙水溶液1-2次。在地势低洼的地段，雨季要注意及时排除积水。冬季休眠期，应剪除枯枝、老弱枝，病虫枝及徙长枝，对生长多年长势衰退的植株应进行更新，即在离地面30cm处将老枝全部剪除，增施肥料，促进多发健壮新枝。在新枝长至1m多高时，要及时打顶，太高的枝要进行弯枝，均可促其多发新枝，多结果实。"}]},{"ID":"20240607144220-5zlklf6","Type":"NodeParagraph","Properties":{"id":"20240607144220-5zlklf6","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607144220-i86t7ax","Type":"NodeParagraph","Properties":{"id":"20240607144220-i86t7ax","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实球形，直径4-6mm，表面黑色或棕褐色，被粉霜状绒毛，有细纵沟4条。用放大镜观察可见密布淡黄色小点。顶端微凹，有脱落花柱痕，下部有宿萼及短果柄，宿萼包被果实的1/3-2/3，先端5齿裂，常在一侧撕裂成两瓣，灰白色，密生细绒毛。体轻质坚，不易破碎。横断面果皮灰黄色，有棕褐色点排列成环，分为4室，每室有种子1枚或不育。种仁黄白色，有油性。气芳香，味微辛、略苦。以粒大饱满，气香者为佳。 显微鉴别 果实横切面：（1）单叶蔓荆 外果皮为1列含棕色颗粒物的扁平细胞，外被角质层；密存贮腺毛，头部单细胞或多细胞，柄1-2细胞；偶有非腺毛，1-3细胞，具壁疣。其下为2-5列薄壁细胞，亦含棕色颗粒物。中果皮细胞大，类圆形，壁稍厚，木化；散有维管束，排列规则，呈环状。内果皮为3-6列类圆形或分枝状石细胞，延伸至内侧将种子包围。果实中轴部分有2-4个周韧维管束。种皮表皮为1列扁小薄壁细胞，其内为2-5列网纹细胞。 （2）蔓荆 维管束排列不甚规则，略呈环状。 理化鉴别 （1）取本品粉末（40目）1g，加10ml现酮冷浸4-6h，滤过。滤液挥干，加1ml丙酮溶解。取2支试管，各加丙酮浸出液3-5滴，分别加入镁粉-盐酸、锌粉-盐酸试剂，依次分别呈现深红色和樱红色。（检查黄酮） （2） 薄层色谱 取现酮提取液作供试液，以蔓荆子黄素为对照品，分别点样于硅胶-0.3%CMC板上，以石油醚-乙酸乙酯（3：2）展开，取出晾干。于紫外灯（365nm）下观察，蔓荆子黄素显黄棕色黄光。再喷以2%香草醛硫酸液，供试品色谱在与对照口色谱相应位置上显相同的鲜黄色的斑点。"}]},{"ID":"20240607144220-sgpgfp2","Type":"NodeParagraph","Properties":{"id":"20240607144220-sgpgfp2","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607144220-8ta0d5g","Type":"NodeParagraph","Properties":{"id":"20240607144220-8ta0d5g","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 1.单叶蔓荆 果实和叶含挥发油，及微量生物碱和维生素A；果实中含牡荆子黄酮（vitexicarpin），即紫花牡荆素（casticin）。 2.蔓荆 果实含少量（0.01%）蔓荆子碱（viTCMLIBicin）。及含2.60%的脂肪油，主要成分是肉豆营蔻酸（myristic acid），棕榈酸（palmitic acid），硬脂酸（stearic acid），棕榈油酸（palmitoleicaid），油酸（oleic acid）和亚油酸（linoleic acid）以及0.90%的不皂化物系少量的石蜡（paraffin），γ-生育酚（γ-tocopherol）和β-谷甾醇（β-sitosterol）。另含对-羟基苯甲酸（p-hydroxy benzoic acid），对-茴香酸（p-anisic acid）及香草醛（vanillin）。蔓荆叶挥发油含α-和β-蒎烯（pinene），苯酚（phenol）1，8-桉叶素（1，8-cineole）及α-萜醇（α-terpineol）。"}]},{"ID":"20240607144220-zvkfb0l","Type":"NodeParagraph","Properties":{"id":"20240607144220-zvkfb0l","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607144220-qt1umx8","Type":"NodeParagraph","Properties":{"id":"20240607144220-qt1umx8","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 1.镇静止痛作用：用于神经性头痛，对于高血压有效。炮制品提取物的镇痛作用生蔓荆子醇总提取物注射液（I）：制法为生蔓荆子50g，加800ml45%乙醇分二次回流提取，合并提取液，回收乙醇，残液加蒸馏水200ml，滤去不溶物，浓缩至25ml。炒黄制品醇总提取物注射液（Ⅱ）：称取炒黄制品50g，制法同（Ⅰ）。生品水总提取物注射液（Ⅲ），制法为生蔓荆子50g，加800ml蒸馏水，分二次回流提取，合并滤液，蒸发浓缩，残渣加95%乙醇200ml搅拌，取滤液浓缩至25ml。炒黄制品水总提取物注射液（Ⅳ），制法同（Ⅲ）。以上制品每1ml相当生药2g。采用热板法，将小鼠（18-22g）在55±0.5℃的热板上（室温20±1℃）。以小鼠接触热板到舐足时间为痛反应指标，5分钟重复测一次痛阈，两次痛反应时间的均数作为正常痛阈值，正常值在30秒内者用于实验。动物分六组，在给药后10、20、30、40、50、60分钟时测定痛阈均值。比较给药前后痛阈变化及各组间区别。结果表明：样品：Ⅰ-Ⅱ在剂量为30g/kg时，ip给药后20分钟镇阈显着提高，30分钟左右作用最强，作用持续30-60分钟。30分钟时，经方差分析四种样品与生理盐水（阴性对照）和吗啡（阳性对照）比较均有极显着性差异(P\u003c0.01)，40分钟时两组间方差分析得：Ⅰ号（生品）、Ⅱ号（炒黄品）比较，p\u003c0.01，且Ⅰ号作用大于Ⅱ号，。Ⅱ号与Ⅳ号样品比较，P\u003c0.01。Ⅱ号作用强于Ⅳ号样品。"}]},{"ID":"20240607144220-ciq59ql","Type":"NodeParagraph","Properties":{"id":"20240607144220-ciq59ql","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"2.退热作用：镇静体温中枢。蔓荆子水煎液1：10浓度，对病毒ECHO11株有抑制作用。蔓荆子黄素对金黄色葡萄球菌、蜡样芽胞杆菌、巨大芽胞杆菌均有明显的抑制作用。本品水煎液1：10 浓度对病毒ECHO11株有抑制作用。"}]},{"ID":"20240607144220-fkreyib","Type":"NodeParagraph","Properties":{"id":"20240607144220-fkreyib","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607144220-7nxywie","Type":"NodeParagraph","Properties":{"id":"20240607144220-7nxywie","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 1.炒蔓荆子：筛净灰屑，除去残存萼片，置锅内用武火炒至焦黄色，略喷清水，放凉。"}]},{"ID":"20240607144220-8pj514q","Type":"NodeParagraph","Properties":{"id":"20240607144220-8pj514q","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮炙论》：凡使蔓荆子，去蒂子下白膜一重，用酒浸一伏时后蒸，从巳至未，出，晒干用。"}]},{"ID":"20240607144220-ohjoulb","Type":"NodeParagraph","Properties":{"id":"20240607144220-ohjoulb","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607144220-stblqvq","Type":"NodeParagraph","Properties":{"id":"20240607144220-stblqvq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 肝；胃；膀胱经"}]},{"ID":"20240607144220-i933xtq","Type":"NodeParagraph","Properties":{"id":"20240607144220-i933xtq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607144220-174dqzp","Type":"NodeParagraph","Properties":{"id":"20240607144220-174dqzp","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性微寒"}]},{"ID":"20240607144220-q3nvoql","Type":"NodeParagraph","Properties":{"id":"20240607144220-q3nvoql","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607144220-0bgf7ay","Type":"NodeParagraph","Properties":{"id":"20240607144220-0bgf7ay","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 胃虚者慎服。"}]},{"ID":"20240607144220-7j5l2s2","Type":"NodeParagraph","Properties":{"id":"20240607144220-7j5l2s2","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607144220-cwgyedq","Type":"NodeParagraph","Properties":{"id":"20240607144220-cwgyedq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 疏散风热；清利头目。主外感风热；头昏头痛；偏头痛；牙龈肿痛；目赤肿痛多泪；目睛内痛；昏暗不明；湿痹拘挛。"}]},{"ID":"20240607144220-bpwkldv","Type":"NodeParagraph","Properties":{"id":"20240607144220-bpwkldv","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607144220-xvo41s2","Type":"NodeParagraph","Properties":{"id":"20240607144220-xvo41s2","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-10g；或浸酒；或入丸、散。外用：适量，煎汤外洗。"}]},{"ID":"20240607144220-awk1bvg","Type":"NodeParagraph","Properties":{"id":"20240607144220-awk1bvg","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"制剂"}]},{"ID":"20240607144220-1jqhoe6","Type":"NodeParagraph","Properties":{"id":"20240607144220-1jqhoe6","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 加味香苏散；蔓荆子汤；蝉花散；白蒺藜散；羌活胜湿汤；"}]},{"ID":"20240607144220-s8mkrjy","Type":"NodeParagraph","Properties":{"id":"20240607144220-s8mkrjy","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607144220-1dkxhdj","Type":"NodeParagraph","Properties":{"id":"20240607144220-1dkxhdj","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" ①治头风： 蔓荆子二升(末)，酒一斗。 绢袋盛，浸七宿，温服三合，日三。(《千金方》)②治风寒侵目，肿痛出泪，涩胀羞明： 蔓荆子三钱，荆芥、白蒺藜各二钱，柴胡、防风各一钱，甘草五分。水煎服。(《本草汇言》)③治劳役饮食不节，内障眼病： 黄芪、人参各一两，炙甘草八钱，蔓荆子二钱半，黄柏三钱(酒拌炒四遍)，白芍药三钱。每服三、五钱，水煎。(《兰室秘藏》蔓荆子汤)"}]},{"ID":"20240607144220-bdal9fv","Type":"NodeParagraph","Properties":{"id":"20240607144220-bdal9fv","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607144220-17av0jj","Type":"NodeParagraph","Properties":{"id":"20240607144220-17av0jj","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：蔓荆实，气轻味辛，体轻而浮，上行而散，故所主者皆头面风虚之症。"}]},{"ID":"20240607144220-o4ycls5","Type":"NodeParagraph","Properties":{"id":"20240607144220-o4ycls5","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：蔓荆实，'神农'味苦，微寒，无毒；《别录》味辛，平温。察其功用，应是苦温辛散之性，而寒则甚少也。气清味薄，浮而升，阳也。其主筋骨间寒热，湿痹拘挛，风头痛、脑鸣、目泪出者，盖以六淫之邪，风则伤筋，寒则伤骨，而为寒热，甚则或成湿痹，或为拘挛；又足太阳之脉，夹背循项、而络于脑，目为厥阴开窍之位，邪伤二经，则头痛、脑鸣、目泪出。此药味辛气温，入二脏而散风寒之邪，则诸证悉除矣。邪去则九窍自通，痹散则光泽脂致。其主坚齿者，齿虽属肾，而床属阳明，阳明客风热，则上攻牙齿，为动摇肿痛，散阳明之风热，则齿自坚矣。去白虫、长虫者，假其苦辛之味耳。"}]},{"ID":"20240607144220-3gitf7f","Type":"NodeParagraph","Properties":{"id":"20240607144220-3gitf7f","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：蔓荆子，主头面诸风疾之药也。前古主通利九窍，活利关节，明目坚齿，祛除风寒风热之邪。其辛温轻散，浮而上行，故所主头面虚风诸证。推其通九窍，利关节而言，故后世治湿痹拘挛，寒疝脚气，入汤散中，屡用奏效，又不拘于头面上部也。"}]},{"ID":"20240607144220-vaxackb","Type":"NodeParagraph","Properties":{"id":"20240607144220-vaxackb","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：蔓荆子，能疏风、凉血、利窍，凡太阳头痛，及偏头风、脑鸣、目泪、目昏，皆血热风淫所致，以此凉之，取其气薄主升，佐神效黄芪汤，疏消障翳，使目复光，为肝经胜药。"}]},{"ID":"20240607144220-0bd5hx6","Type":"NodeParagraph","Properties":{"id":"20240607144220-0bd5hx6","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"5.《本草新编》：蔓荆子，佐补中药以治头痛最效， 因其体轻力薄，藉之易于上升也，倘单恃一味，欲取胜于俄顷，则不能。"}]},{"ID":"20240607144220-z88ecbx","Type":"NodeParagraph","Properties":{"id":"20240607144220-z88ecbx","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"6.张寿颐：凡草木之子，多坚实沉重，性皆下行，蔓荆之实，虽不甚重，然其性必降，《本经》谓主治筋骨间寒热，湿痹拘挛，明目、坚齿、利九窍，固皆清泄降火之功用。《别录》虽加以辛字，而主治风头痛，脑鸣、目泪出，仍是内风升腾之病，用以清降，断非疏散外风之品。《日华子》谓治赤目； 张洁古谓治头沉昏闷，止目睛内痛；王海藏谓搜肝风；皆是患风降火，其义甚明。独甄权谓治贼风；洁古又谓治太阳头痛，散风邪；则误作疏散之药，绝非《本经》、《别录》真旨。盖内风、外风，治法含浑，久为汉、魏以来通病，甄权等此说，实属误认，奈何濒湖《纲目》，亦谓其气清味辛，体轻而浮，上行而散，竞以甄权等之误说，反加附会而为之证实。近三百年，更无人能知蔓荆子之真实功用矣。然濒湖亦谓所主者皆头面风虚之证，则试问风而属虚，岂有再用浮散主治之理《千金方》以一味蔓荆子为末，浸酒服，治头风作痛，亦是内风，非祛散外风之法，其用酒者乃借酒力引之上行，使药力达于头脑之意。轻用一钱五分，重用可至三、四钱。"}]},{"ID":"20240607144220-0tol18e","Type":"NodeParagraph","Properties":{"id":"20240607144220-0tol18e","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"7.《本经》：主筋骨间寒热，湿痹拘挛，明目，坚齿，利九窍，去白虫。"}]},{"ID":"20240607144220-lsfnf1p","Type":"NodeParagraph","Properties":{"id":"20240607144220-lsfnf1p","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"8.《本草经集注》：主发秃落。"}]},{"ID":"20240607144220-va6e67p","Type":"NodeParagraph","Properties":{"id":"20240607144220-va6e67p","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"9.《别录》：去长虫，主风头痛，脑鸣，目泪出；益气，令人光泽脂致。"}]},{"ID":"20240607144220-fh7dtvw","Type":"NodeParagraph","Properties":{"id":"20240607144220-fh7dtvw","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"10.《药性论》：治贼风，能长髭发。"}]},{"ID":"20240607144220-cmqrxgv","Type":"NodeParagraph","Properties":{"id":"20240607144220-cmqrxgv","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"11.《日华子本草》：利关节，治赤眼，痫疾。"}]},{"ID":"20240607144220-bpypbjw","Type":"NodeParagraph","Properties":{"id":"20240607144220-bpypbjw","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"12.《珍珠囊》：凉诸经血，止头痛，主目睛内痛。"}]},{"ID":"20240607144220-c283oto","Type":"NodeParagraph","Properties":{"id":"20240607144220-c283oto","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"13.王好古：搜肝风。"}]},{"ID":"20240607144220-bzqrjaw","Type":"NodeParagraph","Properties":{"id":"20240607144220-bzqrjaw","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"14.《医林纂要》：散热，祛风，兼能燥湿。"}]},{"ID":"20240607144220-odniflq","Type":"NodeParagraph","Properties":{"id":"20240607144220-odniflq","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"15.《广西中药志》：治胃痛。"}]},{"ID":"20240607144220-5ugykj6","Type":"NodeParagraph","Properties":{"id":"20240607144220-5ugykj6","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"16.广州部队《常用中草药手册》：疏风散热，平肝止痛。治感冒发热，眼病眩晕，风湿筋骨痛，消化不良，肠炎腹泻，跌打肿痛。"}]},{"ID":"20240607144220-cm0c5u2","Type":"NodeParagraph","Properties":{"id":"20240607144220-cm0c5u2","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607144220-485xsl7","Type":"NodeParagraph","Properties":{"id":"20240607144220-485xsl7","updated":"20240607144220"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607144222-yaxo4vo","Type":"NodeThematicBreak","Properties":{"id":"20240607144222-yaxo4vo"}},{"ID":"20240607144223-w9bumkr","Type":"NodeParagraph","Properties":{"id":"20240607144223-w9bumkr"}}]}