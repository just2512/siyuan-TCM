h: 526px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菊花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菊花 7-20240801111538-dtttchw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 526px;\" parent-style=\"width: 536px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801103438-q9zxv8f","Type":"NodeParagraph","Properties":{"id":"20240801103438-q9zxv8f","updated":"20240801103438"}},{"ID":"20240205160204-z0rm2x3","Type":"NodeParagraph","Properties":{"id":"20240205160204-z0rm2x3","updated":"20240205160208"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野菊花"}]},{"ID":"20240206113245-7r4mhzc","Type":"NodeParagraph","Properties":{"id":"20240206113245-7r4mhzc","updated":"20240206113248"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于安徽、江苏、江西等地。\n【性状】\t花序呈类球形，直径0.31cm，棕黄色。总苞由45层苞片组成。舌状花一轮，黄色，皱缩卷曲；管状花多数，深黄色。体轻。气芳香，味苦。\n【性味】\t苦、辛，微寒。\n【功效】\t清热解毒，消肿。对金黄色葡萄球菌、白喉杆菌、链球菌、绿脓杆菌、蒺疾杆菌、流感病毒，均有抑制作用。"}]},{"ID":"20240206113239-ercsatv","Type":"NodeParagraph","Properties":{"id":"20240206113239-ercsatv","updated":"20240206113239"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206113239-col2mwr.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205160210-lhnnm5l","Type":"NodeParagraph","Properties":{"id":"20240205160210-lhnnm5l","updated":"20240205160210"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"野菊花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/野菊花-20240205160210-8bxujp5.jpg"},{"Type":"NodeClo