deCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801104248-9ceygeb","Type":"NodeParagraph","Properties":{"id":"20240801104248-9ceygeb","updated":"20240801104248"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 612px;","style":"width: 602px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"野菊花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/野菊花-20240801103601-eopoj9a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 602px;\" parent-style=\"width: 612px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 615px;","style":"width: 605px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"野菊花 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/野菊花 1-20240801103930-eosdrgo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 605px;\" parent-style=\"width: 615px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801104045-ux7o458","Type":"NodeParagraph","Properties":{"id":"20240801104045-ux7o458","updated":"20240801104045"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 646px;","style":"width: 636px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"野菊花 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/野菊花 2-20240801104045-27ovflm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 636px;\" parent-style=\"width: 646px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 647px;","style":"width: 637px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"野菊花 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/野菊花 3-20240801104135-rkco6dn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 637px;\" parent-style=\"width: 647px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801103753-tl07awn","Type":"NodeParagraph","Properties":{"id":"20240801103753-tl07awn","updated":"20240801111310"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：菊花和野菊花叶片都是羽状分裂，菊花的羽状分裂叶片较大，野菊花羽状分裂叶片较小；野菊花的花朵也比菊花小；"}]},{"ID":"20240614165354-sy4735s","Type":"NodeThematicBreak","Properties":{"id":"20240614165354-sy4735s"}},{"ID":"20240614165454-ukx8ld2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165454-ukx8ld2","updated":"20240614165459"},"Children":[{"Type":"NodeText","Data":"鞠华《神农本草经》"}]},{"ID":"20240614165454-chs2lu0","Type":"NodeParagraph","Properties":{"id":"20240614165454-chs2lu0","updated":"20240614165454"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240614165454-rzo5by3","Type":"NodeParagraph","Properties":{"id":"20240614165454-rzo5by3","updated":"20240614165454"},"Children":[{"Type":"NodeText","Data":"主风，头眩肿痛，目欲脱，泪出，皮肤死肌，恶风湿痹。久服，利血气，轻身，耐老延年。一名节华，生川泽及田野。"}]},{"ID":"20240614165454-qyte1fz","Type":"NodeParagraph","Properties":{"id":"20240614165454-qyte1fz","updated":"20240614165454"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：菊华一名白华（初学记），一名女华，一名女茎。"}]},{"ID":"20240614165454-mhbsd4q","Type":"NodeParagraph","Properties":{"id":"20240614165454-mhbsd4q","updated":"20240614165454"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名日精，一名女节，一名女华，一名女茎，一名更生，一名周盈，一名傅延年，一名阴成，生雍州。正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干。"}]},{"ID":"20240614165454-u3xg5ki","Type":"NodeParagraph","Properties":{"id":"20240614165454-u3xg5ki","updated":"20240614165454"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蘜治墙也，蘜日精也，似秋华，或省作，《尔雅》云，蘜治墙；郭璞云：今之秋华菊，则蘜、（上艹下左辛右匊）、蓻皆秋华，字、惟今作菊，《说文》以为大菊瞿麦，假音用之也。"}]},{"ID":"20240614165504-kec58u1","Type":"NodeThematicBreak","Properties":{"id":"20240614165504-kec58u1"}},{"ID":"20240614165506-wpm89lw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165506-wpm89lw","updated":"20240614165510"},"Children":[{"Type":"NodeText","Data":"鞠华《神农本草经赞》"}]},{"ID":"20240614165506-wyenx0k","Type":"NodeParagraph","Properties":{"id":"20240614165506-wyenx0k","updated":"20240614165506"},"Children":[{"Type":"NodeText","Data":"味苦平。主头风眩肿目痛欲脱泪出。皮肤死肌。恶风湿痹。久服利血气轻身耐老延年。一名节华。生川泽及田野。"}]},{"ID":"20240614165506-umi2gaz","Type":"NodeParagraph","Properties":{"id":"20240614165506-umi2gaz","updated":"20240614165506"},"Children":[{"Type":"NodeText","Data":"女节女华。是生女几。采周四时。德包五美。自叶流根。抗茎敷蕊。饮杂芳醪。精调琼靡。"}]},{"ID":"20240614165506-fvyxdw2","Type":"NodeParagraph","Properties":{"id":"20240614165506-fvyxdw2","updated":"20240614165506"},"Children":[{"Type":"NodeText","Data":"崔实月令。女节女华菊花之名。山海经。女几之山。其草多菊。名医曰。正月采根。"}]},{"ID":"20240614165506-ym1u5cg","Type":"NodeParagraph","Properties":{"id":"20240614165506-ym1u5cg","updated":"20240614165506"},"Children":[{"Type":"NodeText","Data":"三月采叶。五月采茎。九月采花。十一月采实。钟会赞。菊有五美。西京杂记。饮菊花酒令人长寿。扬雄反骚。精琼靡与秋菊兮。"}]},{"ID":"20240614165709-z473qie","Type":"NodeThematicBreak","Properties":{"id":"20240614165709-z473qie"}},{"ID":"20240614165710-2ciznqx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165710-2ciznqx","updated":"20240614165716"},"Children":[{"Type":"NodeText","Data":"菊花《医学入门》"}]},{"ID":"20240614165710-qjlhxaj","Type":"NodeParagraph","Properties":{"id":"20240614165710-qjlhxaj","updated":"20240614165710"},"Children":[{"Type":"NodeText","Data":"菊花味甘气平寒，诸风温痹皮肤顽，头眩目泪胸烦痛，久服滋阴肠胃安。"}]},{"ID":"20240614165710-cqb8yvr","Type":"NodeParagraph","Properties":{"id":"20240614165710-cqb8yvr","updated":"20240614165710"},"Children":[{"Type":"NodeText","Data":"菊，鞠也。《尔雅》云∶鞠如聚金不落。花，萼也，后凡言花者，仿此，无毒。可升可降，阴中阳也。主诸风湿痹，腰痛去来，四肢游风，皮肤死肌。治头风眩痛，两目欲脱泪出。去翳养血，明目要剂也。又宽胸膈烦热，止心痛。丹溪云∶能补阴气，治头目胸热诸证者，补其水而清气升，风火自降也。久服安肠胃，黑发延年，兼治疔肿，取根叶绞汁内服外敷。白菊，润肺黑须发，和巨胜子蜜丸服。正月采叶，五月采茎，九月采花，阴干，味甘，单叶黄花应候开者入药。野菊味苦，大伤胃气不用。桑白皮为使。"}]},{"ID":"20240614165733-205rwuq","Type":"NodeThematicBreak","Properties":{"id":"20240614165733-205rwuq"}},{"ID":"20240614165734-uqasksw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165734-uqasksw","updated":"20240614165741"},"Children":[{"Type":"NodeText","Data":"菊花《神农本草经百种录》"}]},{"ID":"20240614165734-kv2mtvr","Type":"NodeParagraph","Properties":{"id":"20240614165734-kv2mtvr","updated":"20240614165734"},"Children":[{"Type":"NodeText","Data":"味苦平。主风，头眩肿痛，目欲脱，泪出，芳香上达，又得秋金之气，故能平肝风而益金水。皮肤死肌，清肺疏风。恶风湿痹。驱风散湿。久服，利血气，轻身、耐老延年。菊花晚开晚落，花中之最寿者也，故其益人如此。"}]},{"ID":"20240614165734-5jw3csm","Type":"NodeParagraph","Properties":{"id":"20240614165734-5jw3csm","updated":"20240614165734"},"Children":[{"Type":"NodeText","Data":"凡芳香之物，皆能治头目肌表之疾。但香则无不辛燥者，惟菊得天地秋金清肃之气，而不甚燥烈，故于头目风火之疾，尤宜焉。"}]},{"ID":"20240614165734-nhkz9na","Type":"NodeParagraph","Properties":{"id":"20240614165734-nhkz9na","updated":"20240614165734"},"Children":[{"Type":"NodeText","Data":"味甘，微寒。主补五脏，安精神，定魂魄，止惊悸，有形无形，无一之不补也。除邪气，正气充则邪气自除。明目，五脏六腑之精皆上注于目，此所云明乃补其精之效，非若他药，专有明目之功也。开心益智。人参气盛而不滞，补而兼通，故能入心孔而益神明也。久服，轻身延年。补气之功。"}]},{"ID":"20240614165734-68bck8c","Type":"NodeParagraph","Properties":{"id":"20240614165734-68bck8c","updated":"20240614165734"},"Children":[{"Type":"NodeText","Data":"人参得天地精英纯粹之气以生，与人之气体相似，故于人身无所不补。非若他药有偏长而治病各有其能也。凡补气之药皆属阳，惟人参能补气，而体质属阴，故无刚燥之病，而又能入于阴分，最为可贵。然力大而峻，用之失宜，其害亦甚于他药也。今医家之用参救人者少，杀人者多。盖人之死于虚者，十之一二，死于病者，十之八九。人参长于补虚，而短于攻疾。"}]},{"ID":"20240614165734-mi8o5sr","Type":"NodeParagraph","Properties":{"id":"20240614165734-mi8o5sr","updated":"20240614165734"},"Children":[{"Type":"NodeText","Data":"医家不论病之已去未去，于病久或体弱，或富贵之人，皆必用参。一则过为谨慎，一则借以塞责，而病家亦以用参为尽慈孝之道。不知病未去而用参，则非独元气不充，而病根遂固，诸药罔效，终无愈期。故曰杀人者多也。"}]},{"ID":"20240614165734-diydg8e","Type":"NodeParagraph","Properties":{"id":"20240614165734-diydg8e","updated":"20240614165734"},"Children":[{"Type":"NodeText","Data":"或曰仲景伤寒方中病未去而用参者不少，如小柴胡、新加汤之类，何也？曰∶此则以补为泻古人曲审病情至精至密，知病有分有合。合者邪正并居，当专于攻散；分者邪正相离，有虚有实。实处宜泻，虚处宜补。一方之中，兼用无碍，且能相济，则用人参以建中生津，托出邪气，更为有力。若邪气尚盛而未分，必从专治，无用参之法也。况用之亦皆入疏散药中，从无与熟地、萸肉等药同入感证方中者。明乎此，而后能不以生人者杀人矣。人参亦草根耳，与人殊体，何以能骤益人之精血。盖人参乃升提元气之药，元气下陷，不能与精血流贯，人参能提之使起，如火药藏于炮内不能升发，则以火发之。若炮中本无火药，虽以炮投火中不发也，此补之义也。"}]},{"ID":"20240614165753-h859fvg","Type":"NodeThematicBreak","Properties":{"id":"20240614165753-h859fvg"}},{"ID":"20240614165755-vuctc7z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165755-vuctc7z","updated":"20240614165759"},"Children":[{"Type":"NodeText","Data":"野菊《本草纲目》"}]},{"ID":"20240614165755-2fats4o","Type":"NodeParagraph","Properties":{"id":"20240614165755-2fats4o","updated":"20240614165755"},"Children":[{"Type":"NodeText","Data":"「释名」苦薏。"}]},{"ID":"20240614165755-a5b2eoa","Type":"NodeParagraph","Properties":{"id":"20240614165755-a5b2eoa","updated":"20240614165755"},"Children":[{"Type":"NodeText","Data":"「气味」（根、叶、茎、花）苦、辛、温、有小毒。"}]},{"ID":"20240614165755-dfrc6ep","Type":"NodeParagraph","Properties":{"id":"20240614165755-dfrc6ep","updated":"20240614165755"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614165755-892y0ad","Type":"NodeParagraph","Properties":{"id":"20240614165755-892y0ad","updated":"20240614165755"},"Children":[{"Type":"NodeText","Data":"1、无名肿毒。用野菊花连茎捣烂，酒煎，乘热服，让汗发出；另以药渣敷患处。又方：野菊花茎叶、苍耳草各一把，共捣烂，加入酒一碗，绞取汁取；仍以药渣敷患处。要出汗才好。又方：夏日采苍耳叶，秋日采野菊花，共研为末。每服三钱，酒送下。"}]},{"ID":"20240614165755-37v88q4","Type":"NodeParagraph","Properties":{"id":"20240614165755-37v88q4","updated":"20240614165755"},"Children":[{"Type":"NodeText","Data":"2、天泡湿疮。用野菊花根、枣木，共煎汤洗患处。"}]},{"ID":"20240614165755-cepgger","Type":"NodeParagraph","Properties":{"id":"20240614165755-cepgger","updated":"20240614165755"},"Children":[{"Type":"NodeText","Data":"3、瘰疬末破。用野菊花根捣烂，煎酒内服；以药渣敷患处。"}]},{"ID":"20240614165803-2u5kaow","Type":"NodeThematicBreak","Properties":{"id":"20240614165803-2u5kaow"}},{"ID":"20240614165804-lrt68vn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165804-lrt68vn","updated":"20240614165808"},"Children":[{"Type":"NodeText","Data":"野菊花《本草求真》"}]},{"ID":"20240614165804-sjbudhr","Type":"NodeParagraph","Properties":{"id":"20240614165804-sjbudhr","updated":"20240614165804"},"Children":[{"Type":"NodeText","Data":"（隰草）散火气消痈毒"}]},{"ID":"20240614165804-kvx88k8","Type":"NodeParagraph","Properties":{"id":"20240614165804-kvx88k8","updated":"20240614165804"},"Children":[{"Type":"NodeText","Data":"野菊花（专入肺肝）。一名苦薏。为外科痈肿药也。其味辛而且苦。大能散火散气。故凡痈毒疔肿瘰 眼目热痛。妇人瘀血等症。无不得此则治。以辛能散气。苦能散火者是也。是以经验方治瘰 未破。用根煎酒热服。渣敷自消。孙氏治毒方用此。连根叶捣烂。煎酒热服取汗。以渣敷贴。或用苍耳同入。或作汤服。或为末酒调。自无不可。（卫生简易方）但胃气虚弱。切勿妄投。（震亨曰。野菊花服之大伤胃气。）"}]},{"ID":"20240614165817-m7fwyoa","Type":"NodeThematicBreak","Properties":{"id":"20240614165817-m7fwyoa"}},{"ID":"20240614165818-4sb1i8v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165818-4sb1i8v","updated":"20240614165823"},"Children":[{"Type":"NodeText","Data":"菊花《新修本草》"}]},{"ID":"20240614165818-wa517h9","Type":"NodeParagraph","Properties":{"id":"20240614165818-wa517h9","updated":"20240614165818"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主风头眩、肿痛，目欲脱，泪出，皮肤死肌，恶风，湿痹。疗腰痛去来陶陶，除胸中烦热，安肠胃，利五脉，调四肢。久服利血气，轻身，耐老，延年。一名节华，一名甘精，一名女节，一名女华，一名女茎，一名更生，一名周盈，一名傅延年，一名阴成。生雍州川泽及田野。正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干。"}]},{"ID":"20240614165818-yzj30so","Type":"NodeParagraph","Properties":{"id":"20240614165818-yzj30so","updated":"20240614165818"},"Children":[{"Type":"NodeText","Data":"术、枸杞根、桑根白皮为之使。菊有两种∶一种茎紫气香而味甘，叶可作羹食者，为真；一味苦不堪食者，名苦薏，非真。其华正相似，唯以甘苦别之尔。南阳郦县最多，今近道处处有，取种之便得。又有白菊，茎叶都相似，唯花白，五月取。亦主风眩，能令头不白。《仙经》以菊为妙用，但难多得，宜常服之尔。"}]},{"ID":"20240614165721-yxhamvz","Type":"NodeThematicBreak","Properties":{"id":"20240614165721-yxhamvz"}},{"ID":"20240614165723-i325by8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165723-i325by8","updated":"20240614165727"},"Children":[{"Type":"NodeText","Data":"菊花《本草经集注》"}]},{"ID":"20240614165723-ha5swnr","Type":"NodeParagraph","Properties":{"id":"20240614165723-ha5swnr","updated":"20240614165723"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主治风头，头眩，肿痛，目欲脱，泪出，皮肤死肌，恶风，湿痹。"}]},{"ID":"20240614165723-lbrc1fm","Type":"NodeParagraph","Properties":{"id":"20240614165723-lbrc1fm","updated":"20240614165723"},"Children":[{"Type":"NodeText","Data":"治腰痛去来陶陶，除胸中烦热，安肠胃，利五脉，调四肢。久服利血气，轻身，耐老，延年。一名节花。一名日精，一名女节，一名女花，一名女茎，一名更生，一名周盈，一名傅延年，一名阴成。生雍州川泽及田野。正月采根，三月采叶，五月采茎，九月采花，十一菊有两种∶一种茎紫气香而味甘，叶可作羹食者，为真；一种青茎而大，作蒿艾气。味苦??"}]},{"ID":"20240614165723-i9qjydp","Type":"NodeParagraph","Properties":{"id":"20240614165723-i9qjydp","updated":"20240614165723"},"Children":[{"Type":"NodeText","Data":"取种之便得。又有白菊，茎叶都相似，唯花白，五月取。亦主风眩，能令头不白。"}]},{"ID":"20240614165847-tssbh0h","Type":"NodeThematicBreak","Properties":{"id":"20240614165847-tssbh0h"}},{"ID":"20240614165848-nu1quae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165848-nu1quae","updated":"20240614165853"},"Children":[{"Type":"NodeText","Data":"菊花《本草害利》"}]},{"ID":"20240614165848-legla3v","Type":"NodeParagraph","Properties":{"id":"20240614165848-legla3v","updated":"20240614165848"},"Children":[{"Type":"NodeText","Data":"〔害〕苦寒之品，非胃家所宜。《牧竖闲谈》云∶真菊延龄，野菊泄人。故丹溪曰∶野菊服之，大伤胃气是也。"}]},{"ID":"20240614165848-uryxf5l","Type":"NodeParagraph","Properties":{"id":"20240614165848-uryxf5l","updated":"20240614165848"},"Children":[{"Type":"NodeText","Data":"〔利〕甘苦微寒，补益金水，善制风木，去胸中之热，祛头目之风，白术、枸杞、地骨皮、桑白皮为使。"}]},{"ID":"20240614165848-o2qencu","Type":"NodeParagraph","Properties":{"id":"20240614165848-o2qencu","updated":"20240614165848"},"Children":[{"Type":"NodeText","Data":"〔修治〕滁州菊，单瓣色白味甘者为上。杭州黄白茶菊，微苦者次之。其余苦菊，单不入药，或炒黑，或煨炭，或生用。九月采摘曝干。野菊苦辛惨烈有小毒，调中破血，治痈肿疔毒，连茎叶捣，敷服皆效。"}]},{"ID":"20240614165909-pt4zw1c","Type":"NodeThematicBreak","Properties":{"id":"20240614165909-pt4zw1c"}},{"ID":"20240614165911-a0t8xvu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165911-a0t8xvu","updated":"20240614165918"},"Children":[{"Type":"NodeText","Data":"菊花《本草图经》"}]},{"ID":"20240614165911-hwnp0qr","Type":"NodeParagraph","Properties":{"id":"20240614165911-hwnp0qr","updated":"20240614165913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"菊花"},{"Type":"NodeText","Data":"，生雍州川泽及田野，今处处有之，以南阳菊潭者为佳。初春布地生细苗，夏茂，秋花，冬实，然菊之种类颇多。有紫茎而气香，叶浓至柔嫩可食者，其花微小，味甚甘，此为真；有青茎而大，叶细作蒿艾气味苦者，华亦大，名苦薏，非真也。南阳菊亦有两种∶白菊，叶大似艾叶，茎青，根细，花白，蕊黄；其黄菊，叶似茼蒿，花、蕊都黄。然今服饵家多用白者。南京又有一种开小花，花瓣下如小珠子，谓之珠子菊。云入药亦佳。正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干用。《唐天宝单方图》∶载白菊，云味辛，平，无毒。元生南阳山谷及田野中。 川人呼为回蜂菊。汝南名茶苦蒿。"}]},{"ID":"20240614165911-v91uthe","Type":"NodeParagraph","Properties":{"id":"20240614165911-v91uthe","updated":"20240614165911"},"Children":[{"Type":"NodeText","Data":"上党及建安郡、顺政郡并名羊欢草。河内名地薇蒿。诸郡皆有。其功主丈夫妇人久患头风眩闷，头发干落，胸中痰结，每风发即头旋眼昏暗，不觉欲倒者，是其候也。先灸两风池各二七壮，并服此白菊酒及丸，永瘥。其法∶春末夏初，收软苗，阴干，捣末，空腹取一方寸匕，和无灰酒服之。日再，渐加三方寸匕。若不欲饮酒者，但和羹粥汁服之，亦得。秋八月，合花收，曝干，切取三大斤，以生绢囊盛，贮三大斗酒中，经七日服之，日三，常令酒气相续为佳。今诸州亦有作菊花酒者，其法得于此乎。"}]},{"ID":"20240614165958-tgagnfm","Type":"NodeThematicBreak","Properties":{"id":"20240614165958-tgagnfm"}},{"ID":"20240614165959-pl6nesh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165959-pl6nesh","updated":"20240614170014"},"Children":[{"Type":"NodeText","Data":"菊花《本草崇原》"}]},{"ID":"20240614165959-c33z16e","Type":"NodeParagraph","Properties":{"id":"20240614165959-c33z16e","updated":"20240614165959"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主治诸风头眩肿痛，目欲脱，泪出，皮肤死肌，恶风湿痹。久服利血气，轻身，耐老延年。"}]},{"ID":"20240614165959-ori6vz7","Type":"NodeParagraph","Properties":{"id":"20240614165959-ori6vz7","updated":"20240614165959"},"Children":[{"Type":"NodeText","Data":"（菊花处处有之，以南阳菊潭者为佳，菊之种类不一，培植而花球大者，只供玩赏。生于山野田泽，开花不起楼子，色只黄白二种，名茶菊者，方可入药，以味甘者为胜。古云∶甘菊延令，苦菊泄人，不可不辨。《本经》气味主治，概茎叶花实而言，今时只用花矣。）"}]},{"ID":"20240614165959-ym8j4pi","Type":"NodeParagraph","Properties":{"id":"20240614165959-ym8j4pi","updated":"20240614170009"},"Children":[{"Type":"NodeText","Data":"菊花《本经》名节华，以其应重阳节候而华也。《月令》云∶九月菊有黄花，茎叶味苦，花味兼甘，色有黄白，禀阳明秋金之气化。主治诸风头眩肿痛，禀金气而制风也。目欲脱泪出，言风火上淫于目，痛极欲脱而泪出。菊禀秋金清肃之气，能治风木之火热也。皮肤死肌，恶风湿痹，言感恶风湿邪而成风湿之痹证，则为皮肤死肌。菊禀金气，而治皮肤之风，兼得阳明土气，而治肌肉之湿也。周身血气，生于阳明胃府，故久服利血气轻身，血气利而轻身，则耐老延年。"}]},{"ID":"20240614165928-clgouux","Type":"NodeThematicBreak","Properties":{"id":"20240614165928-clgouux"}},{"ID":"20240614165930-07ajvym","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165930-07ajvym","updated":"20240614165936"},"Children":[{"Type":"NodeText","Data":"菊花《证类本草》"}]},{"ID":"20240614165930-w1hol4t","Type":"NodeParagraph","Properties":{"id":"20240614165930-w1hol4t","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主风头眩、肿痛，目欲脱，泪出，皮肤死肌，恶风，湿痹，疗腰痛去来陶陶，除胸中烦热，安肠胃，利五脉，调四肢。久服利血气，轻身，耐老，延年。"}]},{"ID":"20240614165930-0i0832r","Type":"NodeParagraph","Properties":{"id":"20240614165930-0i0832r","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"一名节华，一名日精，一名女节，一名女华，一名女茎，一名更生，一名周盈，一名傅延年，一名阴成。生雍州川泽及田野。正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干。（术、枸杞根、桑根白皮为之使。）"}]},{"ID":"20240614165930-ziaypq3","Type":"NodeParagraph","Properties":{"id":"20240614165930-ziaypq3","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶菊有两种∶一种茎紫，气香而味甘，叶可作羹食者，为真。一种青茎而大，作蒿艾气，味苦不堪食者名苦薏，非真。其华正相似，唯以甘、苦别之尔。南阳郦县最多，今近道处处有，取种之便得。又有白菊，茎、叶都相似，唯花白，五月取。亦主风眩，能令头不白。《仙经》以菊为妙用，但难多得，宜常服之尔。臣禹锡等谨按尔雅云∶鞠，治蔷。注∶今之秋华菊。药性论云∶甘菊花，使。能治热头风旋倒地，脑骨疼痛，身上诸风令消散。陈藏器云∶苦薏，味苦破血。妇人腹内宿血，食之。又调中止泄。花如菊，茎似马兰，生泽畔，似菊，菊甘而薏苦。语曰∶苦如薏是也。又云白菊，味苦。染髭发令黑，和巨胜、茯苓蜜丸，主风眩，变白，不老，益颜色。又《灵宝方》∶茯苓合为丸以成，炼松脂和，每服如鸡子一丸，令人好颜色不老，主头眩。生平泽，花紫白，五月花。《抱朴子·刘生丹法》∶用白菊花汁和之。杨损之云∶甘者入药，苦者不任。日华子云∶菊花，治四肢游风，利血脉，心烦，胸膈壅闷，并痈毒，头痛，作枕明目，叶亦明目，生熟并可食。菊有两种∶花大气香，茎紫者为甘菊；花小气烈，茎青小者名野菊，味苦。然虽如此，园蔬内种肥沃后同一体。花上水，益色壮阳，治一切风，并无所忌。"}]},{"ID":"20240614165930-nql9ncz","Type":"NodeParagraph","Properties":{"id":"20240614165930-nql9ncz","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"图经曰∶菊花，生雍州川泽及田野，今处处有之，以南阳菊潭者为佳。初春布地生细苗，夏茂、秋花、冬实。然菊之种类颇多，有紫茎而气香，叶浓至柔嫩可食者，其花微小，味甚甘，此为真。有青茎而大，叶细作蒿艾气味苦者，华亦大名苦薏，非真也。南阳菊亦有两种∶白菊，叶大似艾叶，茎青根细，花白蕊黄；其黄菊，叶似茼蒿，花蕊都黄。然今服饵家多用白者。南京又有一种开小花，花瓣下如小珠子，谓之珠子菊，云入药亦佳。正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干用。唐《天宝单方图》载白菊云∶味辛，平，无毒。元生南阳山谷及田野中，颖川人呼为回蜂菊，汝南名荼苦蒿，上党及建安郡、顺政郡并名羊欢草，河内名地薇蒿，诸郡皆有。其功主丈夫、妇人久患头风眩闷，头发干落，胸中痰结，每风发即头旋，眼昏暗，不觉欲倒者，是其候也。先灸两风池各二七壮，并服此白菊酒及丸，永瘥。其法∶春末夏初收软苗，阴干，捣末。空腹取一方寸匕，和无灰酒服之，日再，渐加三方寸匕。若不欲饮酒者，但和羹、粥、汁服之亦得。秋八月合花收曝干，切，取三大斤，以生绢囊盛贮三大斗酒中，经七日服之，日三，常令酒气相续为佳。今诸州亦有作菊花酒者，其法得于此乎。"}]},{"ID":"20240614165930-6y66yu8","Type":"NodeParagraph","Properties":{"id":"20240614165930-6y66yu8","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"食疗云∶甘菊，平。其叶正月采，可作羹；茎五月五日采；花九月九日采。并主头风，目眩，泪出，去烦热，利五脏。野生苦菊不堪用。圣惠方∶治头风头旋。用九月九日菊花曝干，取家糯米一斗蒸熟，用五两菊花末，搜拌如常酝法，多用细面曲为候，酒熟即压之去滓，每暖一小盏服。外台秘要∶治酒醉不醒。九月九日真菊花末，饮服方寸匕。肘后方∶治疔肿垂死。菊叶一握，捣绞汁一升，入口即活，此神验。冬用其根。食医心镜∶甘菊，主头风目眩，胸中汹汹，目泪出，风痹骨肉痛，切作羹煮粥，并生食并得。玉函方∶王子乔变白增年方∶甘菊，三月上寅日采，名曰玉英；六月上寅日采，名曰容成；九月上寅日采，名曰金精；十二月上寅日采，名曰长生。长生者，根茎是也。四味并阴干百日，取等分，以成日合捣千杵为末，酒调下一钱匕。以蜜丸如桐子大，酒服七丸，一日三服。百日身轻润泽；服之一年，发白变黑；服之二年，齿落再生；服之三年，八十岁老人变为童儿，神效。"}]},{"ID":"20240614165930-rvaua70","Type":"NodeParagraph","Properties":{"id":"20240614165930-rvaua70","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"衍义曰∶菊花，近世有二十余种，唯单叶花小而黄绿，叶色深小而薄，应候而开者是也。"}]},{"ID":"20240614165930-o9tschb","Type":"NodeParagraph","Properties":{"id":"20240614165930-o9tschb","updated":"20240614165930"},"Children":[{"Type":"NodeText","Data":"《月令》所谓菊有黄花者也。又邓州白菊，单叶者亦入药，余皆医经不用。专治头目风热，今多收之作枕。"}]},{"ID":"20240614165857-fgsrjlx","Type":"NodeThematicBreak","Properties":{"id":"20240614165857-fgsrjlx"}},{"ID":"20240614165859-3leb7ak","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165859-3leb7ak","updated":"20240614165904"},"Children":[{"Type":"NodeText","Data":"菊花《冯氏锦囊秘录》"}]},{"ID":"20240614165859-rpot870","Type":"NodeParagraph","Properties":{"id":"20240614165859-rpot870","updated":"20240614165859"},"Children":[{"Type":"NodeText","Data":"生于春，长于夏，秀于秋，资乎土，得天地之清，独禀金精，专制风木，味苦甘兼辛，气平无毒。凡采须阴干，若入补养药去心蒂，蜜酒拌蒸晒干用。若入去风热剂中，生用。"}]},{"ID":"20240614165859-a0r5mia","Type":"NodeParagraph","Properties":{"id":"20240614165859-a0r5mia","updated":"20240614165859"},"Children":[{"Type":"NodeText","Data":"菊花驱头风。止头痛，眩晕，清头脑第一，养眼血，收眼泪翳膜，明眼目无双。散风淫湿痹，除皮肤死肌，利一身血气，逐四肢游风，疗腰痛去来，退胸中烦热。历春夏秋三时，得天地之清芳，禀金精之正气，故能平肝生水，降火明目也。且气性轻扬，故主用多在上部。同枸杞便能助肾矣。以单瓣味甘者入药，黄者入阴分，白者入阳分，可药可饵，可酿可枕，《本经》列之上品，叶救垂死、疗肿即活。"}]},{"ID":"20240614165859-w1cr5kc","Type":"NodeParagraph","Properties":{"id":"20240614165859-w1cr5kc","updated":"20240614165859"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 治痘热毒入眼，专能明目去翳膜，同归地又能补眼血凉血矣（其青叶治诸疗危，急者用之即愈；以叶捣烂，入酒，绞汁，饮之，共渣敷于毒上，神效）。"}]},{"ID":"20240614165517-9ssxej9","Type":"NodeThematicBreak","Properties":{"id":"20240614165517-9ssxej9"}},{"ID":"20240614165519-az3vtkr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165519-az3vtkr","updated":"20240614165523"},"Children":[{"Type":"NodeText","Data":"菊花《名医别录》"}]},{"ID":"20240614165519-0g6tqre","Type":"NodeParagraph","Properties":{"id":"20240614165519-0g6tqre","updated":"20240614165519"},"Children":[{"Type":"NodeText","Data":"味甘，无毒．主治腰痛去来陶陶，除胸中烦热，安肠胃，利五脉，调四肢．一名曰精一名女节，一名女华，一名女茎，一名更生，一名周盈，一名傅延年，一名阴成．生雍州田野．正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干．（术、枸杞根桑根白皮为之使．）"}]},{"ID":"20240614165519-vzw2q2g","Type":"NodeParagraph","Properties":{"id":"20240614165519-vzw2q2g","updated":"20240614165527"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶鞠华，味苦，平．主风头眩肿痛，目欲脱，泪出，皮肤死肌，恶风湿痹．久服利血气，轻身，耐老延年。一名节华，生川泽及田野。"}]},{"ID":"20240614165834-197t977","Type":"NodeThematicBreak","Properties":{"id":"20240614165834-197t977"}},{"ID":"20240614165835-1hd1myl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614165835-1hd1myl","updated":"20240614165841"},"Children":[{"Type":"NodeText","Data":"菊花《中药学》"}]},{"ID":"20240614165835-qmca2m6","Type":"NodeParagraph","Properties":{"id":"20240614165835-qmca2m6","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【药用】本品为菊科植物菊及其变种的头状花序。"}]},{"ID":"20240614165835-abhrp41","Type":"NodeParagraph","Properties":{"id":"20240614165835-abhrp41","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、苦，微寒。入肺、肝经。"}]},{"ID":"20240614165835-5nu54us","Type":"NodeParagraph","Properties":{"id":"20240614165835-5nu54us","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【功效】疏散风热，明目，清热解毒，平肝阳。"}]},{"ID":"20240614165835-4i3cvxr","Type":"NodeParagraph","Properties":{"id":"20240614165835-4i3cvxr","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于外感风热、发热、恶寒、头痛等症。"}]},{"ID":"20240614165835-s7r5hlq","Type":"NodeParagraph","Properties":{"id":"20240614165835-s7r5hlq","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"菊花疏风较弱，清热力佳，用于外感风热常配桑叶同用，也可配黄芩、山栀治热盛烦燥等症。"}]},{"ID":"20240614165835-7eqn7l5","Type":"NodeParagraph","Properties":{"id":"20240614165835-7eqn7l5","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"2.用于目赤肿痛。"}]},{"ID":"20240614165835-vh9hvnj","Type":"NodeParagraph","Properties":{"id":"20240614165835-vh9hvnj","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"菊花治目赤肿痛，无论属于肝火或风热引起者，均可应用，因本品既能清肝火，又能散风热，常配合蝉衣、白蒺藜等同用。如肝阴不足，眼目昏花，则多配生地、杞子等同用。"}]},{"ID":"20240614165835-lcmesmn","Type":"NodeParagraph","Properties":{"id":"20240614165835-lcmesmn","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"3.用于疮疡肿痛等症。"}]},{"ID":"20240614165835-bfwcc2f","Type":"NodeParagraph","Properties":{"id":"20240614165835-bfwcc2f","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"菊花清热解毒之功甚佳，为外科要药，主要用于热毒疮疡、红肿热痛之症，特别对于疔疮肿痛毒尤有良好疗效，既可内服，又可捣烂外敷。临床上常与地丁草、蒲公英等清热解毒之品配合应用。"}]},{"ID":"20240614165835-k9ksqj0","Type":"NodeParagraph","Properties":{"id":"20240614165835-k9ksqj0","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"4.用于肝阳上亢引起的头晕、目眩、头胀、头痛等症。"}]},{"ID":"20240614165835-xmdbnoa","Type":"NodeParagraph","Properties":{"id":"20240614165835-xmdbnoa","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"菊花能平降肝阳，对肝阳上亢引起的头目眩晕，往往与珍珠母、葛藤等配伍应用。"}]},{"ID":"20240614165835-9yefds6","Type":"NodeParagraph","Properties":{"id":"20240614165835-9yefds6","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【处方用名】黄菊花、杭菊花（均为黄色之菊花，生用；疏散风热、清热解毒作用较好。）"}]},{"ID":"20240614165835-2jk7x0q","Type":"NodeParagraph","Properties":{"id":"20240614165835-2jk7x0q","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"白菊花、甘菊花、滁菊花（均为白色之菊花，生用；平肝作用较好。）"}]},{"ID":"20240614165835-z3uwv0w","Type":"NodeParagraph","Properties":{"id":"20240614165835-z3uwv0w","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱,煎服。"}]},{"ID":"20240614165835-hw4c1im","Type":"NodeParagraph","Properties":{"id":"20240614165835-hw4c1im","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【附药】1.野菊：为菊科植物菊花脑的茎、叶。各地都有野生。性味苦辛凉。功能清热解毒，可治鼻炎、支气管炎、风火赤眼、疮疖痈肿、咽喉肿痛。一般用量为五钱至一两，煎服。治疗蛇咬伤、湿疹、皮肤瘙痒，用三至四两，煎汤熏洗，或鲜草打烂外敷。"}]},{"ID":"20240614165835-0515mtx","Type":"NodeParagraph","Properties":{"id":"20240614165835-0515mtx","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"2.野菊花：即野菊的花，性味功效与野菊相同，而清热解毒作用更为显著。此外，还有降血压作用，可以治疗高血压。一般用量为两钱至五钱，煎服；外用适量。"}]},{"ID":"20240614165835-u8uvdha","Type":"NodeParagraph","Properties":{"id":"20240614165835-u8uvdha","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【按语】1.菊花一药，主要分白菊、黄菊、野菊。黄、白两菊，都有疏散风热、平肝明目、清热解毒的功效。白菊花味甘、清热力稍弱，长于平肝明目；黄菊花味苦，泄热力较强，常用于疏散风热；野菊花味甚苦，清热解毒的力量很强。野菊的茎、叶，功用与花相似，无论内服与外敷，都有功效。"}]},{"ID":"20240614165835-2h9fnvo","Type":"NodeParagraph","Properties":{"id":"20240614165835-2h9fnvo","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"2.桑叶与菊花，均能疏散风热，清泄肺肝，故在外感风热、发热头痛及目赤肿痛等症，两药往往相辅为用。但桑叶疏风清肺的功效较好，故治肺燥咳嗽，往往用桑叶而不用菊花；菊花则长于平肝阳，且能清热解毒。"}]},{"ID":"20240614165835-dcd9q12","Type":"NodeParagraph","Properties":{"id":"20240614165835-dcd9q12","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"【方剂举例】菊花茶调散《和剂局方》：菊花、薄荷、荆芥、川芎、防风、羌活、甘草、白芷、细辛、僵蚕。治头目眩晕、偏正头痛、目赤鼻塞。"}]},{"ID":"20240614165835-w6150t8","Type":"NodeParagraph","Properties":{"id":"20240614165835-w6150t8","updated":"20240614165835"},"Children":[{"Type":"NodeText","Data":"菊花散《和剂局方》：白菊花、白蒺藜、羌活、木贼、蝉蜕。治肝受风毒、眼目赤肿、昏暗羞明、多泪涩痛，渐生翳膜。"}]},{"ID":"20240607093809-scwzt06","Type":"NodeThematicBreak","Properties":{"id":"20240607093809-scwzt06"}},{"ID":"20240607093811-x3ek1e3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607093811-x3ek1e3","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"《中国药典》：菊花"}]},{"ID":"20240607093811-p7imyew","Type":"NodeParagraph","Properties":{"id":"20240607093811-p7imyew","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607093811-k243a90","Type":"NodeParagraph","Properties":{"id":"20240607093811-k243a90","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" Jú Huā"}]},{"ID":"20240607093811-10hxj3r","Type":"NodeParagraph","Properties":{"id":"20240607093811-10hxj3r","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607093811-18t81yc","Type":"NodeParagraph","Properties":{"id":"20240607093811-18t81yc","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 甘菊花、白菊花、黄甘菊、药菊、白茶菊、茶菊、怀菊花、滁菊、毫菊、杭菊、贡菊"}]},{"ID":"20240607093811-rql2sb6","Type":"NodeParagraph","Properties":{"id":"20240607093811-rql2sb6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607093811-18jysm6","Type":"NodeParagraph","Properties":{"id":"20240607093811-18jysm6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" FLOS CHRYSANTHEMI"}]},{"ID":"20240607093811-5pyu6i4","Type":"NodeParagraph","Properties":{"id":"20240607093811-5pyu6i4","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607093811-rjzyyz5","Type":"NodeParagraph","Properties":{"id":"20240607093811-rjzyyz5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菊"},{"Type":"NodeText","Data":"Chrysanthemum morifolium Ramat.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头状花序"},{"Type":"NodeText","Data":"。9～11月花盛开时分批采收，阴干或焙干，或熏、蒸后晒干。药材按产地和加工方法不同，分为“ 亳菊 ”、“滁菊”、“贡菊”、“杭菊”。"}]},{"ID":"20240607093811-n0s59sq","Type":"NodeParagraph","Properties":{"id":"20240607093811-n0s59sq","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607093811-zm9pt8y","Type":"NodeParagraph","Properties":{"id":"20240607093811-zm9pt8y","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 亳菊：呈倒圆锥形或圆筒形，有时稍压扁呈扇形，直径1.5～3cm，离散。总苞碟状；总苞片3～4层，卵形或椭圆形，草质，黄绿色或褐绿色，外面被柔毛，边缘膜质。花托半球形，无托片或托毛。舌状花数层，雌性，位于外围，类白色，劲直，上举，纵向折缩，散生金黄色腺点；管状花多数，两性，位于中央，为舌状花所隐藏，黄色，顶端5齿裂。瘦果不发育，无冠毛。体轻，质柔润，干时松脆。气清香，味甘、微苦。"}]},{"ID":"20240607093811-mljspeb","Type":"NodeParagraph","Properties":{"id":"20240607093811-mljspeb","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"滁菊：呈不规则球形或扁球形，直径1.5～2.5cm。舌状花尖白色，不规则扭曲，内卷，边缘皱缩，有时可见淡褐色腺点；管状花大多隐藏。"}]},{"ID":"20240607093811-5p9u52f","Type":"NodeParagraph","Properties":{"id":"20240607093811-5p9u52f","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"贡菊：呈扁球形或不规则球形，直径1.5～2.5cm。舌状花白色或类白色，斜升，上部反折，边缘稍内卷而皱缩，通常无腺点；管状花少，外露。"}]},{"ID":"20240607093811-5z9jfu6","Type":"NodeParagraph","Properties":{"id":"20240607093811-5z9jfu6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"杭菊：呈碟形或扁球形，直径2.5～4cm，常数个相连成片。舌状花类白色或黄色,平展或微折叠，彼此粘连，通常无腺点；管状花多数，外露。"}]},{"ID":"20240607093811-20b3zm5","Type":"NodeParagraph","Properties":{"id":"20240607093811-20b3zm5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607093811-vfi6fgl","Type":"NodeParagraph","Properties":{"id":"20240607093811-vfi6fgl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 取本品1g，剪碎，加石油醚20ml，超声处理10分钟，弃去石油醚，药渣挥干，加稀盐酸1ml与醋酸乙酯50ml，超声处理30分钟，滤过，滤液蒸干，残渣加甲醇2ml使溶解，作为供试品溶液。另取绿原酸对照品，加乙醇制成每1ml含0.5mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各0.5～1μl，分别点于同一聚酰胺薄膜上，以甲苯-醋酸乙酯-甲酸-冰醋酸-水（2：30：2：2：4）的上层溶液为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607093811-eauisby","Type":"NodeParagraph","Properties":{"id":"20240607093811-eauisby","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607093811-lf3k6ke","Type":"NodeParagraph","Properties":{"id":"20240607093811-lf3k6ke","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 归肺、肝经。"}]},{"ID":"20240607093811-o85lpl2","Type":"NodeParagraph","Properties":{"id":"20240607093811-o85lpl2","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607093811-ug78ftm","Type":"NodeParagraph","Properties":{"id":"20240607093811-ug78ftm","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 甘、苦，微寒。"}]},{"ID":"20240607093811-u3ecjv5","Type":"NodeParagraph","Properties":{"id":"20240607093811-u3ecjv5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607093811-eic75a4","Type":"NodeParagraph","Properties":{"id":"20240607093811-eic75a4","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 散风清热，平肝明目。用于风热感冒，头痛眩晕，目赤肿痛，眼目昏花。"}]},{"ID":"20240607093811-h5wz48a","Type":"NodeParagraph","Properties":{"id":"20240607093811-h5wz48a","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607093811-4ufxbvn","Type":"NodeParagraph","Properties":{"id":"20240607093811-4ufxbvn","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 5～9g。"}]},{"ID":"20240607093811-ex700p7","Type":"NodeParagraph","Properties":{"id":"20240607093811-ex700p7","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607093811-tmxy4fa","Type":"NodeParagraph","Properties":{"id":"20240607093811-tmxy4fa","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" （1）菊花疏风较弱，清热力佳，用于外感风热常配桑叶同用，也可配黄芩、山栀治热盛烦燥等症。菊花治目赤肿痛，无论属于肝火或风热引起者，均可应用，因本品既能清肝火，又能散风热，常配合蝉衣、白蒺藜等同用。如肝阴不足，眼目昏花，则多配生地、杞子等同用。菊花清热解毒之功甚佳，为外科要药，主要用于热毒疮疡、红肿热痛之症，特别对于疔疮肿痛毒尤有良好疗效，既可内服，又可捣烂外敷。临床上常与地丁草、蒲公英等清热解毒之品配合应用。菊花能平降肝阳，对肝阳上亢引起的头目眩晕，往往与珍珠母、葛藤等配伍应用。"}]},{"ID":"20240607093811-uo18cq2","Type":"NodeParagraph","Properties":{"id":"20240607093811-uo18cq2","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"（2）菊花一药，主要分白菊、黄菊、野菊。黄、白两菊，都有疏散风热、平肝明目、清热解毒的功效。白菊花味甘、清热力稍弱，长于平肝明目；黄菊花味苦，泄热力较强，常用于疏散风热；野菊花味甚苦，清热解毒的力量很强。野菊的茎、叶，功用与花相似，无论内服与外敷，都有功效。桑叶与菊花，均能疏散风热，清泄肺肝，故在外感风热、发热头痛及目赤肿痛等症，两药往往相辅为用。但桑叶疏风清肺的功效较好，故治肺燥咳嗽，往往用桑叶而不用菊花；菊花则长于平肝阳，且能清热解毒。"}]},{"ID":"20240607093811-8oya3n2","Type":"NodeParagraph","Properties":{"id":"20240607093811-8oya3n2","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607093811-shfd96m","Type":"NodeParagraph","Properties":{"id":"20240607093811-shfd96m","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607093811-bpmz3vv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607093811-bpmz3vv","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：菊花"}]},{"ID":"20240607093811-carv7zp","Type":"NodeParagraph","Properties":{"id":"20240607093811-carv7zp","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607093811-i07qasp","Type":"NodeParagraph","Properties":{"id":"20240607093811-i07qasp","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" Jú Huā"}]},{"ID":"20240607093811-sso4gb3","Type":"NodeParagraph","Properties":{"id":"20240607093811-sso4gb3","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607093811-jjrklrl","Type":"NodeParagraph","Properties":{"id":"20240607093811-jjrklrl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 节华（《本经》），金精（《金匮玉函方》），甘菊、真菊（《抱朴子》），金蕊（《纲目》），家菊（《群芳谱》），馒头菊、簪头菊（《医林纂要》），甜菊花（《随息居饮食谱》），药菊（《河北药材》）。"}]},{"ID":"20240607093811-3d8vu7f","Type":"NodeParagraph","Properties":{"id":"20240607093811-3d8vu7f","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607093811-p8y9qf8","Type":"NodeParagraph","Properties":{"id":"20240607093811-p8y9qf8","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607093811-6tswnlk","Type":"NodeParagraph","Properties":{"id":"20240607093811-6tswnlk","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607093811-247jp76","Type":"NodeParagraph","Properties":{"id":"20240607093811-247jp76","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菊"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头状花序"},{"Type":"NodeText","Data":"。霜降前花正盛开时采收，其加工法因各产地的药材种类而不同。白菊：割下花枝，捆成小把，倒挂阴干。然后摘取花序。滁菊：摘取花序。经硫黄熏过，晒至六成干时，用筛子筛成球状，晒干。贡菊：摘取花序，烘干。杭菊：有杭白菊、杭黄菊两种，杭白菊摘取花序，蒸后晒干；杭黄菊则用炭火烘干。"}]},{"ID":"20240607093811-rffgzjj","Type":"NodeParagraph","Properties":{"id":"20240607093811-rffgzjj","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607093811-qum7wg4","Type":"NodeParagraph","Properties":{"id":"20240607093811-qum7wg4","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 我国大部分地区有栽培。"}]},{"ID":"20240607093811-fag8kuz","Type":"NodeParagraph","Properties":{"id":"20240607093811-fag8kuz","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607093811-37beol6","Type":"NodeParagraph","Properties":{"id":"20240607093811-37beol6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高50～140厘米，全体密被白色绒毛。茎基部稍木质化，略带紫红色，幼枝略具棱。叶互生，卵形或卵状披针形，长3.5～5厘米，宽3～4厘米，先端钝，基部近心形或阔楔形，边缘通常羽状深裂，裂片具粗锯齿或重锯齿，两面密被白绒毛；叶柄有浅槽。头状花序顶生成腋生，直径2.5～5厘米；总苞半球形，苞片3～4层，绿色，被毛，边缘膜质透明，淡棕色，外层苞片较小，卵形或卵状披针形，第二层苞片阔卵形，内层苞片长椭圆形；花托小，凸出，半球形；舌状花雌性，位于边缘，舌片线状长圆形，长可至3厘米，先端钝圆，白色、黄色、淡红色或淡紫色，无雄蕊，雌蕊1，花柱短，柱头2裂；管状花两性，位于中央，黄色，每花外具1卵状膜质鳞片，花冠管长约4毫米，先端5裂，裂片三角状卵形，雄蕊5，聚药，花丝极短，分离，雌蕊1，子房下位，矩圆形，花柱线形，柱头2裂。瘦果矩圆形，具4棱，顶端平截，光滑无毛。花期9～11月。果期10～11月。"}]},{"ID":"20240607093811-40fnxch","Type":"NodeParagraph","Properties":{"id":"20240607093811-40fnxch","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607093811-8wv2c5m","Type":"NodeParagraph","Properties":{"id":"20240607093811-8wv2c5m","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 干燥头状花序，外层为数层舌状花，呈扁平花瓣状，中心由多数管状花聚合而成，基部有总苞，系由3～4层苞片组成。气清香，味淡微苦。以花朵完整、颜色鲜艳、气清香、无杂质者为佳。"}]},{"ID":"20240607093811-qcfojzv","Type":"NodeParagraph","Properties":{"id":"20240607093811-qcfojzv","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"各种菊花商品，其性状互有差异："}]},{"ID":"20240607093811-s6op7pj","Type":"NodeParagraph","Properties":{"id":"20240607093811-s6op7pj","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"①白菊"}]},{"ID":"20240607093811-rnzwoe6","Type":"NodeParagraph","Properties":{"id":"20240607093811-rnzwoe6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"呈不规则的球状或压扁状，直径约2厘米，瓣多紧密。花序的绝大部分为白色舌状花，长约18毫米，宽约3毫米，中央为极少数短小的淡黄色管状花。主产安徽亳县，称亳菊，品质最佳。另有怀菊（河南）、祁菊（河北）、川菊（四川）也属白菊一类。但质量较次。"}]},{"ID":"20240607093811-xdmgn2v","Type":"NodeParagraph","Properties":{"id":"20240607093811-xdmgn2v","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②滁菊"}]},{"ID":"20240607093811-45xi5au","Type":"NodeParagraph","Properties":{"id":"20240607093811-45xi5au","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"呈球状，形较小，瓣紧密。舌状花白色，长约15毫米，宽约3毫米，中央管状花黄色。主产安徽滁县，品质亦佳。"}]},{"ID":"20240607093811-6cr2gyx","Type":"NodeParagraph","Properties":{"id":"20240607093811-6cr2gyx","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"③贡菊"}]},{"ID":"20240607093811-5diqio0","Type":"NodeParagraph","Properties":{"id":"20240607093811-5diqio0","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"形似滁菊，瓣细而厚。舌状花白色，长10～12毫米，宽约2毫米，中央有少数黄色管状花。主产安徽歙县，亦称徽菊。过去浙江德清亦产，称德菊。"}]},{"ID":"20240607093811-n4maso2","Type":"NodeParagraph","Properties":{"id":"20240607093811-n4maso2","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"④杭菊"}]},{"ID":"20240607093811-jdwfo6h","Type":"NodeParagraph","Properties":{"id":"20240607093811-jdwfo6h","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"㈠杭白菊，又名白茶菊（《纲目拾遗》）。呈不规则压扁状，朵大，瓣宽而疏。舌状花较少，类白色，长约22毫米，宽约6毫米，中央有少数深黄色管状花。㈡杭黄菊，又名黄甘菊（《圣惠方》）。形与杭白菊相似，但舌状花黄色至淡棕色。均产浙江。"}]},{"ID":"20240607093811-coftm97","Type":"NodeParagraph","Properties":{"id":"20240607093811-coftm97","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607093811-a3a1acw","Type":"NodeParagraph","Properties":{"id":"20240607093811-a3a1acw","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 花和茎含挥发油，并有腺嘌呤、胆碱、水苏碱等。花又含菊甙、氨基酸、黄酮类及微量维生素B1。挥发油主要含龙脑、樟脑、菊油环酮等。黄酮类有木犀草素-7-葡萄糖甙、大波斯菊甙、刺槐甙。尚含丁二酸二甲基酰肼。"}]},{"ID":"20240607093811-19hkbtv","Type":"NodeParagraph","Properties":{"id":"20240607093811-19hkbtv","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607093811-b6sel8l","Type":"NodeParagraph","Properties":{"id":"20240607093811-b6sel8l","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" ①抗病原体作用"}]},{"ID":"20240607093811-brgrlwl","Type":"NodeParagraph","Properties":{"id":"20240607093811-brgrlwl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"菊花在体外对革兰氏阳性细菌（金黄色葡萄球菌及β-溶血性链球菌）、人型结核杆菌有某些抑制作用。其水浸剂（1：4）对某些常见皮肤致病性真菌亦有些抑制作用。高浓度在体外还有抗病毒（PB8株）及抗螺旋体作用。"}]},{"ID":"20240607093811-y939ahp","Type":"NodeParagraph","Properties":{"id":"20240607093811-y939ahp","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②增强毛细血管抵抗力"}]},{"ID":"20240607093811-mrkvd04","Type":"NodeParagraph","Properties":{"id":"20240607093811-mrkvd04","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"菊花提取物刚、鼠腹腔注射，可使皮内注射组织胺之局部台盼蓝之扩散较小，显示其能抑制毛细血管的通透性而有抗炎作用。其提取物10毫克相当芦丁2.5毫克之效力。"}]},{"ID":"20240607093811-cfgd3nq","Type":"NodeParagraph","Properties":{"id":"20240607093811-cfgd3nq","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607093811-c8sy0pu","Type":"NodeParagraph","Properties":{"id":"20240607093811-c8sy0pu","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 菊花：拣净叶梗、花柄及泥屑杂质。菊花炭：取拣净的菊花，置锅内炒至焦褐黄色，但须存性，喷洒清水，取出晒干。"}]},{"ID":"20240607093811-i14olsl","Type":"NodeParagraph","Properties":{"id":"20240607093811-i14olsl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607093811-n07cy9h","Type":"NodeParagraph","Properties":{"id":"20240607093811-n07cy9h","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 入肺、肝经。"}]},{"ID":"20240607093811-m02gbbq","Type":"NodeParagraph","Properties":{"id":"20240607093811-m02gbbq","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"《雷公炮制药性解》：\"入肺、脾；肝、肾四经。\""}]},{"ID":"20240607093811-basu60d","Type":"NodeParagraph","Properties":{"id":"20240607093811-basu60d","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607093811-xaisjui","Type":"NodeParagraph","Properties":{"id":"20240607093811-xaisjui","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 甘苦，凉。"}]},{"ID":"20240607093811-ymr1ij5","Type":"NodeParagraph","Properties":{"id":"20240607093811-ymr1ij5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240607093811-7yww3lv","Type":"NodeParagraph","Properties":{"id":"20240607093811-7yww3lv","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240607093811-g1161ev","Type":"NodeParagraph","Properties":{"id":"20240607093811-g1161ev","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"③《天宝单方图》：\"白菊：味辛，平，无毒。\""}]},{"ID":"20240607093811-u725hhi","Type":"NodeParagraph","Properties":{"id":"20240607093811-u725hhi","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"④《随息居饮食谱》：\"甘，凉。\""}]},{"ID":"20240607093811-yerbr1k","Type":"NodeParagraph","Properties":{"id":"20240607093811-yerbr1k","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607093811-wg23n2o","Type":"NodeParagraph","Properties":{"id":"20240607093811-wg23n2o","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"术、枸杞根、桑根白皮为之使。\""}]},{"ID":"20240607093811-kf18shj","Type":"NodeParagraph","Properties":{"id":"20240607093811-kf18shj","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"气虚胃寒，食少泄泻之病，宜少用之。\""}]},{"ID":"20240607093811-bz70tp5","Type":"NodeParagraph","Properties":{"id":"20240607093811-bz70tp5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607093811-o6zix2x","Type":"NodeParagraph","Properties":{"id":"20240607093811-o6zix2x","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 疏风，清热，明目，解毒。治头痛，眩晕，目赤，心胸烦热，疔疮，肿毒。"}]},{"ID":"20240607093811-ie15nj1","Type":"NodeParagraph","Properties":{"id":"20240607093811-ie15nj1","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主诸风头眩、肿痛，目欲脱，泪出，皮肤死肌，恶风湿痹，利血气。\""}]},{"ID":"20240607093811-rtvbd4y","Type":"NodeParagraph","Properties":{"id":"20240607093811-rtvbd4y","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗腰痛去来陶陶，除胸中烦热，安肠胃，利五脉，调四肢。\""}]},{"ID":"20240607093811-mvpbhva","Type":"NodeParagraph","Properties":{"id":"20240607093811-mvpbhva","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"白菊：主风眩。\""}]},{"ID":"20240607093811-d2wuzhx","Type":"NodeParagraph","Properties":{"id":"20240607093811-d2wuzhx","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"能治热头风旋倒地，脑骨疼痛，身上诸风令消散。\""}]},{"ID":"20240607093811-po4gtxi","Type":"NodeParagraph","Properties":{"id":"20240607093811-po4gtxi","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"利血脉，治四肢游风，心烦，胸膈壅闷，并痈毒，头痛；作枕明目。\""}]},{"ID":"20240607093811-72dzqcp","Type":"NodeParagraph","Properties":{"id":"20240607093811-72dzqcp","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"养目血。\""}]},{"ID":"20240607093811-fg4xcqx","Type":"NodeParagraph","Properties":{"id":"20240607093811-fg4xcqx","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑦《用药心法》：\"去翳膜，明目。\""}]},{"ID":"20240607093811-j0y1jfh","Type":"NodeParagraph","Properties":{"id":"20240607093811-j0y1jfh","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑧王好古：\"主肝气不足。\""}]},{"ID":"20240607093811-ldeimhu","Type":"NodeParagraph","Properties":{"id":"20240607093811-ldeimhu","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑨《纲目拾遗》：\"专入阳分。治诸风头眩，解酒毒疔肿。\"\"黄茶菊：明目祛风，搜肝气，治头晕目眩，益血润容，入血分；白茶菊：通肺气，止咳逆，清三焦郁火，疗肌热，入气分。\""}]},{"ID":"20240607093811-la136m5","Type":"NodeParagraph","Properties":{"id":"20240607093811-la136m5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607093811-rwlv06p","Type":"NodeParagraph","Properties":{"id":"20240607093811-rwlv06p","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；泡茶或入丸、散。"}]},{"ID":"20240607093811-pv4mf68","Type":"NodeParagraph","Properties":{"id":"20240607093811-pv4mf68","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607093811-vpfn2pp","Type":"NodeParagraph","Properties":{"id":"20240607093811-vpfn2pp","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" ①治风热头痛：菊花、石膏、川芎各三钱。为末。每服一钱半，茶调下。（《简便单方》）"}]},{"ID":"20240607093811-zmzppgr","Type":"NodeParagraph","Properties":{"id":"20240607093811-zmzppgr","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②治太阴风温，但咳，身不甚热，微渴者：杏仁二钱，连翘一钱五分，薄荷八分，桑叶二钱五分，菊花一钱，苦桔梗二钱，甘草八分，苇根二钱。水二杯，煮取一杯，日三服。（《温病条辨》桑菊饮）"}]},{"ID":"20240607093811-asc3qg1","Type":"NodeParagraph","Properties":{"id":"20240607093811-asc3qg1","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"③治风眩：甘菊花暴干。作末，以米馈中，蒸作酒服。（徐嗣伯·菊花酒）"}]},{"ID":"20240607093811-2r4464y","Type":"NodeParagraph","Properties":{"id":"20240607093811-2r4464y","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"④治热毒风上攻，目赤头旋，眼花面肿：菊花（焙）、排风子（焙）、甘草（炮）各一两。上三味，捣罗为散。夜卧时温水调下三钱匕。（《圣济总录》菊花散）"}]},{"ID":"20240607093811-4xevzgl","Type":"NodeParagraph","Properties":{"id":"20240607093811-4xevzgl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑤治眼目昏暗诸疾：蜀椒（去目并闭口，炒出汗，一斤半捣罗取末）一斤，甘菊花（末）一斤。上二味和匀，取肥地黄十五斤，切，捣研，绞取汁八、九斗许，将前药末拌浸，令匀，暴稍干，入盘中，摊暴三、四日内取干，候得所即止，勿令大燥，入炼蜜二斤，同捣数千杵，丸如梧桐子大。每服三十丸，空心日午，热水下。（《圣济总录》夜光丸）"}]},{"ID":"20240607093811-z7tu7os","Type":"NodeParagraph","Properties":{"id":"20240607093811-z7tu7os","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑥治肝肾不足，虚火上炎，目赤肿痛，久视昏暗，迎风流泪，怕日羞明，头晕盗汗，潮热足软：枸杞子、甘菊花、熟地黄、山萸肉、怀山药、白茯苓、牡丹皮、泽泻。炼蜜为丸。（《医级》杞菊地黄丸）"}]},{"ID":"20240607093811-pue85a4","Type":"NodeParagraph","Properties":{"id":"20240607093811-pue85a4","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑦治肝肾不足，眼目昏暗：甘菊花四两，巴戟（去心）一两，苁蓉（酒浸，去皮，炒，切，焙）二两，枸杞子三两。上为细末，炼蜜丸，如梧桐子大。每服三十丸至五十丸，温酒或盐汤下，空心食前服。（《局方》菊睛丸）"}]},{"ID":"20240607093811-1bg4h2r","Type":"NodeParagraph","Properties":{"id":"20240607093811-1bg4h2r","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑧治病后生翳：白菊花、蝉蜕等分。为散。每用二、三钱，入蜜少许，水煎服。（《救急方》）"}]},{"ID":"20240607093811-u3wqily","Type":"NodeParagraph","Properties":{"id":"20240607093811-u3wqily","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑨治疔：白菊花四两，甘草四钱。水煎，顿服，渣再煎服。（《外科十法》菊花甘草汤）"}]},{"ID":"20240607093811-x4m7eug","Type":"NodeParagraph","Properties":{"id":"20240607093811-x4m7eug","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑩治膝风：陈艾、菊花。作护膝，久用。（《扶寿精方》）"}]},{"ID":"20240607093811-b9f0fck","Type":"NodeParagraph","Properties":{"id":"20240607093811-b9f0fck","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607093811-r0c5oig","Type":"NodeParagraph","Properties":{"id":"20240607093811-r0c5oig","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" ①治疗冠心病"}]},{"ID":"20240607093811-chyydxl","Type":"NodeParagraph","Properties":{"id":"20240607093811-chyydxl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"以菊花煎剂观察61例，对心绞痛症状的总有效率为80％，其中显效43.3％，改善36.7％，以轻度者疗效较好；对胸闷、心悸、气急及头晕、头痛、四肢发麻等症状，亦有不同程度的疗效；心电图的总有效率为45.9％，其中显效18.8％，好转27.1％。对部分高血压患者有降压作用；对心率无明显影响；对血清胆甾醇、三酸甘油酯未见明显的规律性变化。服药期间除1例有上腹痛、1例有轻度腹泻外，均无其他副作用。即使原有溃疡病的患者，亦多无影响。制剂及用法：白菊花10两，加温水浸泡过夜，次日煎2次，每次半小时；待沉淀后除去沉渣，再浓缩至500毫升。每日2次，每次25毫升。2个月为一疗程。"}]},{"ID":"20240607093811-jbt0gd7","Type":"NodeParagraph","Properties":{"id":"20240607093811-jbt0gd7","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②治疗高血压病"}]},{"ID":"20240607093811-wxsjadi","Type":"NodeParagraph","Properties":{"id":"20240607093811-wxsjadi","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"每日用菊花、银花各0.8～1两（头晕明显加桑叶全钱，动脉硬化、血清胆甾醇高者加山楂4～8钱），混匀，分4次用沸滚开水冲泡10～15分钟后当茶饮。一般冲泡2次后，药渣即可弃掉另换。不可煎熬，否则会破坏有效成分。据46例观察，服药3～7天后头痛、眩晕、失眠等症状开始减轻，随之血压渐降至正常者共35例，其余病例服药10～30天后，自觉症状均有不同程度的好转。"}]},{"ID":"20240607093811-np0hgmc","Type":"NodeParagraph","Properties":{"id":"20240607093811-np0hgmc","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607093811-l0olqur","Type":"NodeParagraph","Properties":{"id":"20240607093811-l0olqur","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义补遗》：\"菊花，能补阴，须味甘者，若山野苦者勿用，大伤胃气。\""}]},{"ID":"20240607093811-s1e4sep","Type":"NodeParagraph","Properties":{"id":"20240607093811-s1e4sep","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"菊花，昔人谓其能除风热，益肝补阴。盖不知其尤多能益金、水二脏也，补水所以制火，益金所以平木，木平则风息，火降则热除，用治诸风头目，其旨深微。\""}]},{"ID":"20240607093811-blwkb3e","Type":"NodeParagraph","Properties":{"id":"20240607093811-blwkb3e","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"菊花专制风木，故为去风之要药。苦可泄热，甘能益血，甘可解毒，平则兼辛，故亦散结，苦入心、小肠，甘入脾、胃，平辛走肝、胆，兼入肺与大肠。其主风头眩、肿痛、目欲脱、泪出、皮肤死肌、恶风、湿痹者，诸风掉眩，皆属肝木，风药先入肝，肝开窍于目，风为阳邪，势必走上，血虚则热，热则生风，风火相搏故也。腰痛去来陶陶者，乃血虚气滞之候，苦以泄滞结，甘以益血脉，辛平以散虚热也。其除胸中烦热者，心主血，虚则病烦，阴虚则热收于内，故热在胸中，血益则阴生，阴生则烦止，苦辛能泄热，故烦热并解。安肠胃，利五脉，调四肢，利血气者，即除热，祛风，益血，入心，入脾，入肝之验也。生捣最治疔疮，血线疔尤为要药，疔者风火之毒也。\""}]},{"ID":"20240607093811-bhlhzq3","Type":"NodeParagraph","Properties":{"id":"20240607093811-bhlhzq3","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"甘菊，取白色者，其体轻，味微苦，性气和平，至清之品。《经》曰，治温以清。凡病热退，其气尚温，以此同桑皮理头痛，除余邪。佐黄芪治眼昏，去翳障。助沙参疗肠红，止下血。领石斛、扁豆，明目聪耳，调达四肢。是以肺气虚，须用白甘菊。如黄色者，其味苦重，清香气散，主清肺火。凡头风眩晕.鼻塞热壅，肌肤湿痹，四肢游风，肩背疼痛，皆繇肺气热，以此清顺肺金，且清金则肝木有制。又治暴赤眼肿、目痛泪出。是以清肺热须用黄甘菊。\""}]},{"ID":"20240607093811-ifc7w16","Type":"NodeParagraph","Properties":{"id":"20240607093811-ifc7w16","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑤《本草新编》：\"甘菊花，气味轻清，功亦甚缓，必宜久服始效，不可责以近功，惟目痛骤用之，成功甚速，余则俱于缓始能取效也。近人多种菊，而不知滋补之方间有用之者。又取作茶茗之需，以为明目也。然而甘菊不单明目，可以大用之者，全在退阳明之胃火。盖阳明内热，必宜阴寒之药以泻之，如石膏、知母之类，然石膏过于太峻，未免太寒以损胃气，不若用甘菊花至一，二两，同元参、麦冬共剂之，既能平胃中之火，而不伤胃之气也。\""}]},{"ID":"20240607093811-wdxkhbj","Type":"NodeParagraph","Properties":{"id":"20240607093811-wdxkhbj","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑥《本草经百种录》：\"凡芳香之物，皆能治头目肌表之疾。但香则无不辛燥者，惟菊不甚燥烈，故于头目风火之疾，尤宜焉。\""}]},{"ID":"20240607093811-k19dk68","Type":"NodeParagraph","Properties":{"id":"20240607093811-k19dk68","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑦《本草便读》：\"甘菊之用，可一言以蔽之，曰疏风而已。然虽系疏风之品，而性味甘寒，与羌、麻等辛燥者不同，故补肝肾蓟中可相需而用也。’"}]},{"ID":"20240607093811-u6tz1mg","Type":"NodeParagraph","Properties":{"id":"20240607093811-u6tz1mg","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"⑧《本草正义》：\"凡花皆主宣扬疏泄，独菊花则摄纳下降，能平肝火，熄内风，抑木气之横逆。《本经》主风头眩者，以阴虚阳浮，气火升腾，肝风上扰之眩晕言之，非外来风邪，能令人眩也。肿痛，连上风头眩三字读。肝火直上顶巅，而为眩，为肿，为痛，阳焰直升，其势最暴。凡是头风作痛，无非内火内风震撼不息，而菊花能治之，非肃降静镇迥异寻常者，殆难有此力量。目如欲脱，乃肝阳内风之尤甚者。世谓头风痛甚，至于丧明，抑知且有目珠突出，形如雀卵者。泪出亦阴虚于下，肝火上扬，真阴无摄纳之权，而风阳以疏泄为用，则迎风而泪下，此皆肝肾阴亏，而浮阳上亢为虐，惟菊花之清苦泄降，能收摄虚阳而纳归于下，故为目科要药。又治皮肤死肌，恶风湿痹者，则血热而络脉不洁，渐以积秽成腐。菊花苦辛宣络，能理血中热毒，则污浊去而痹着之死肌可愈。石顽渭清利血脉，而痹着湿邪，得以开泄，持论甚正。惟此是冲和纯粹之品，以清经隧积淤之浊血，断非旦夕可以速效，弗以无近功，而遽疑《经》言之不可信也。《别录》谓治腰痛去来陶陶，盖言其悠久不已之状，是亦肾阴不足，而湿邪痹着为患，故其痛续续不息。菊花滋肾阴而清湿热，是以主之。又治胸中烦热而安肠胃，固无一非清肃泄热之功用也。甄权谓治头目风旋倒地，脑骨疼痛，则肝阳内风头痛，固有直上顶巅，脑骨如裂者，若风旋倒地，则血冲脑经，而失其知觉运动矣。又谓治身上一切游风，令消散，利血脉，则是血热生风之症，苦泄清理，而风自息。大明谓作枕明目，叶亦明目。洁古谓养目血，去翳膜。海藏谓主肝气不足。盖亦养肝阴，滋肝血之意。虽其气味清芬，然终非肝家气药。仲醇谓生捣最治疔疮，血线疔尤为要药。按疔是火毒，非大剂清解不可，外敷诸药如忍冬藤、马齿苋、蒲公英、草河车、芙蓉叶、青菊叶等，不过清热退肿，皆非专主之任，缪所称之血线疔，盖即红丝疔，有一痕红晕，自疮口上窜，直过肘膝者。治皆以内服清解为主。但知外治，断不可恃。\""}]},{"ID":"20240607093811-7jct82e","Type":"NodeParagraph","Properties":{"id":"20240607093811-7jct82e","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607093811-3yaxlok","Type":"NodeParagraph","Properties":{"id":"20240607093811-3yaxlok","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607093811-tm9bq04","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607093811-tm9bq04","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"《中华本草》：菊花"}]},{"ID":"20240607093811-ny110lw","Type":"NodeParagraph","Properties":{"id":"20240607093811-ny110lw","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607093811-3zpcy7z","Type":"NodeParagraph","Properties":{"id":"20240607093811-3zpcy7z","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" Jú Huā"}]},{"ID":"20240607093811-4xmgw4h","Type":"NodeParagraph","Properties":{"id":"20240607093811-4xmgw4h","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607093811-aiccffw","Type":"NodeParagraph","Properties":{"id":"20240607093811-aiccffw","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 节华、日精、女节、女华、女茎、更生、周盈、傅延年、阴成、甘菊、真菊、金精、金蕊、镘头菊、簪头菊、甜菊花、药菊"}]},{"ID":"20240607093811-kjax3nr","Type":"NodeParagraph","Properties":{"id":"20240607093811-kjax3nr","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607093811-pspg2ms","Type":"NodeParagraph","Properties":{"id":"20240607093811-pspg2ms","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" Chrysanthemum"}]},{"ID":"20240607093811-e1obhmv","Type":"NodeParagraph","Properties":{"id":"20240607093811-e1obhmv","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607093811-nfumyb0","Type":"NodeParagraph","Properties":{"id":"20240607093811-nfumyb0","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607093811-jg7axp5","Type":"NodeParagraph","Properties":{"id":"20240607093811-jg7axp5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"1.《别录》：菊花，生雍州川泽及田野。正月采根，三月采叶，五月采茎，九月采花，十一月采实，皆阴干。"}]},{"ID":"20240607093811-ikg13kr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607093811-ikg13kr","updated":"20240607093811"},"Children":[{"ID":"20240607093811-2loxv1c","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240607093811-2loxv1c","updated":"20240607093811"},"Children":[{"ID":"20240607093811-wir59ma","Type":"NodeParagraph","Properties":{"id":"20240607093811-wir59ma","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"陶弘景：菊有两种：一种茎紫，气香而味甘，叶可作羹食者为真；一种青茎而大，作蒿艾气，味苦不堪食者，名苦薏，非真。其花正相似，难以甘、苦别之尔。南阳郦县最多，今近道处处有，取种之便得。又有白菊，茎叶都相似，唯花白，五月取，亦主凤眩，能令头不白。"}]}]}]},{"ID":"20240607093811-18qt9b8","Type":"NodeParagraph","Properties":{"id":"20240607093811-18qt9b8","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"3.《本草图"}]},{"ID":"20240607093811-1n688i3","Type":"NodeParagraph","Properties":{"id":"20240607093811-1n688i3","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607093811-0rehmqx","Type":"NodeParagraph","Properties":{"id":"20240607093811-0rehmqx","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 药材基源：为区科植物菊的头状花序。"}]},{"ID":"20240607093811-g5z6xu3","Type":"NodeParagraph","Properties":{"id":"20240607093811-g5z6xu3","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dendranthema morifolium (Ramat.) Tzvel. [Chrysanthemum morifolium Ramat.]"}]},{"ID":"20240607093811-nzmfj0g","Type":"NodeParagraph","Properties":{"id":"20240607093811-nzmfj0g","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"采收和储藏：11月初开花时，待花瓣平展，由黄转白而心略带黄时，选晴天露水干后或午后分批采收，这时采的花水分少，易干燥，色泽好，品质好。采下鲜花，切忌堆放，需及时干燥或薄摊于通风处。加工方法因各地产的药材品种而不同；阴干，适用于小面积生产，待花大部开放，选晴天，割下花枝，捆成小把，县员通风处，经30-40d，待花干燥，后摘下，略晒；晒干，将鲜菊花薄铺蒸笼内，厚度不超过3朵花，待水沸后，将蒸笼置锅上蒸3-4min，倒至晒具内晒干，不家翻动；烘干，将鲜菊铺于烘筛上，厚度不超过3cm，用60℃炕干。"}]},{"ID":"20240607093811-aso00fh","Type":"NodeParagraph","Properties":{"id":"20240607093811-aso00fh","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607093811-unqagl5","Type":"NodeParagraph","Properties":{"id":"20240607093811-unqagl5","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 为栽培种，培育的品种极多，头状花序多弯化，形色各异。全国各地均有栽培。药用菊花以河南、安徽、浙江、栽培最多。"}]},{"ID":"20240607093811-eg8dieo","Type":"NodeParagraph","Properties":{"id":"20240607093811-eg8dieo","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607093811-dxuxjcn","Type":"NodeParagraph","Properties":{"id":"20240607093811-dxuxjcn","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 菊 多年生草本，高60-150cm。茎直立，分枝或不分枝，被柔毛。叶互生；有短柄；叶片卵形至披针形，长5-15cm，羽状浅裂或半裂，基部楔形，下面被白色短柔毛。头状花序直径2.5-20cm，大小不一，单个或数个集生于茎枝顶端；总苞片多层，外层绿色，条形，边缘膜质，外面被柔毛；舌状花白色、红色、紫色或黄色。瘦果不发育。花期9-11。"}]},{"ID":"20240607093811-xr873yh","Type":"NodeParagraph","Properties":{"id":"20240607093811-xr873yh","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607093811-vdtv25k","Type":"NodeParagraph","Properties":{"id":"20240607093811-vdtv25k","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候、阳光充足、忌遮荫。耐寒，稍耐旱，怕水涝，喜肥。最适生长温度20℃左右，在0-10℃以下能生长，花期能耐-4℃，根可耐-16～-17℃的低温。对土壤要求不严。以地热高燥，背风向阳，疏松肥沃，含丰富的腐殖质，排水良好，pH6-8的砂质壤土或壤土栽培为宜。忌连作。可与早玉米、桑、蚕豆、烟草、油菜、大蒜、小麦间套作。粘重土、低洼积水地不宜栽种。"}]},{"ID":"20240607093811-0p4ul5e","Type":"NodeParagraph","Properties":{"id":"20240607093811-0p4ul5e","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"栽培技术 药用菊主要用扦插、分株繁殖。扦插繁殖、育苗移栽法：4月下旬至5月上旬截取母株的幼枝作插穗，随剪随插，插穗长10-12cm，顶端留2片叶，除去下部2-3节的叶片，插入土中5cm，顶端露出3cm，按行距24cm开沟，沟深14cm，每隔15-20cm，扦插1株，覆土压实，浇水。扦插后要遮荫，经常浇水保湿，松土除草，每隔半月施稀人粪尿1次，约经15-20d生根，待生长健壮后即可移栽。赤可使用两次扦插法，使稀栽推迟至5月下旬至6月上旬。分析繁殖：11月选优良植株，收花后割除残茎，培土越冬。4月中、下旬至5月上旬，待新苗长至15cm高，选择阴天，挖掘母株，将健壮带有白根的幼苗，适当煎去枝叶，按行株距40cm×40cm开穴，每穴栽1-2株，煎去顶端，填土压实，浇水。"}]},{"ID":"20240607093811-40bjhsz","Type":"NodeParagraph","Properties":{"id":"20240607093811-40bjhsz","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期间需中耕除草3-4次，每隔半月1次，后两次中耕除草结合培土。苗高30-40cm进行打顶，第2次在6月底，第3次不迟至7月。菊花喜肥，但应控制施氮肥，以免徒长，遭病虫为家。一般在幼苗成活后施稀人粪尿或尿素，开始分枝时施人畜粪及腐熟饼肥，9月施浓粪肥，增加过磷酸钙，施肥应亥集中在中期。生长前期少浇水，是旱浇水，9月孕蕾期注意防旱。雨季要排除积水，以防烂根。"}]},{"ID":"20240607093811-fnsakgg","Type":"NodeParagraph","Properties":{"id":"20240607093811-fnsakgg","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有叶枯病，整个生长期均可发生，发病实期摘除病叶，中用1：1：100波尔多液或65%可湿性代森锌500倍液喷雾。根腐病，6月下旬至8月上旬发病，可用退菌特50%可湿性粉剂500倍液灌注。锈病可用敌锈钠97%可湿性粉剂200倍液喷射。另有白粉病、霜霉病、黄萎病等为害。虫害有棉蚜、大青叶跳甲、菊天牛、瘿蟥、斜纹夜蛾、地老虎等为害。"}]},{"ID":"20240607093811-5umgtt0","Type":"NodeParagraph","Properties":{"id":"20240607093811-5umgtt0","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607093811-xot2d5h","Type":"NodeParagraph","Properties":{"id":"20240607093811-xot2d5h","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）毫菊 头状花序倒圆锥形或圆筒形，有时稍压扁呈房形，直径1.5-3cm。总苞碟状，总苞片3-4层，卵形椭圆形，草质，黄绿色或褐绿色，外被柔毛，边缘膜质，花托半球形，无托片或托毛。舌状花数层，雌性，位于外围，类立色，劲直，上举，纵向折缩，散生金黄色腺点；管状花多数，两性，位于中央，为舌状花所限藏，黄色，先端5齿裂。瘦果不发育，无冠毛。体轻，质柔润，干时松脆。气清香，味甘、微苦。"}]},{"ID":"20240607093811-uf1h149","Type":"NodeParagraph","Properties":{"id":"20240607093811-uf1h149","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"（2）滁菊 不规则球形或扁球形，直径1.5-2.5cm。舌状花白色，不规则扭曲，内卷，边缘皱缩，有时可见淡褐色腺点；管状花大多陷藏。"}]},{"ID":"20240607093811-35zz2w9","Type":"NodeParagraph","Properties":{"id":"20240607093811-35zz2w9","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"（3）贡菊 扁球形或不规则球形，直径1.5-2.5cm。舌状花白色或类白色，斜升，部反折，边缘稍内卷而皱缩，通常无腺点；管状花少，外露。"}]},{"ID":"20240607093811-fj6q4j4","Type":"NodeParagraph","Properties":{"id":"20240607093811-fj6q4j4","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"（4）杭菊 碟形或扁球形，直径2.5-4cm，常数个相连成片。舌状药类白色黄色，平展或微折叠，彼此粘连，能常无腺点；管状花多数，外露。"}]},{"ID":"20240607093811-5kcs6vv","Type":"NodeParagraph","Properties":{"id":"20240607093811-5kcs6vv","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"以花朵完整不散瓣、色白（黄）、香气浓郁、无杂质者为佳。"}]},{"ID":"20240607093811-22pot9o","Type":"NodeParagraph","Properties":{"id":"20240607093811-22pot9o","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：黄棕色，气清香。①花粉粒黄色，类圆形，直径22-38μm，有3孔沟，表面有刺，刺长3.4-7μm，每裂片4-5刺。②花冠表皮细胞表面以垂周壁波状弯曲，表面有微细致密的角质纹理。③苞片表皮细胞垂周壁波状弯曲，表面有稍粗的角质纹理。气孔不定式，副卫细胞3-6个。④花柱及柱头碎片的边缘细胞呈绒毛状突起。⑤T形毛少见，大多碎断，顶端细胞长大，基部2-5细胞。⑥腺毛少见。头部鞋底形，4、6或8人细胞，两两相对排列，长径32-127μm，短径22-74μm，外被角质层。此外，有药隔顶端附属物及基部细胞、花粉囊内壁细胞、分泌道、纤维、子房表皮细胞等。"}]},{"ID":"20240607093811-pi60t45","Type":"NodeParagraph","Properties":{"id":"20240607093811-pi60t45","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607093811-f1oziza","Type":"NodeParagraph","Properties":{"id":"20240607093811-f1oziza","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 花含挥发油，成分主要为龙脑（borneol），樟脑（camphor），菊油环酮（chrysanthenone），还含木犀草素-7葡萄糖甙（luteolin-7-glucoside），大波斯菊甙（cosmosiin）即芹菜素-7-O-葡萄糖甙（apigenin-7-O-glucoside）[1]，刺槐甙（acacetin-7-Orhamnoglucoside），芹菜素（apigenin），芹菜素-7-O-鼠李葡萄糖甙（apigenin-7-O-rhamnoglucoside），刺槐素-7-O-葡萄糖甙（acacetin-7-O-glucoside）槲皮素-3-O-半乳糖甙（isorhamnetin-3-O-galactoside），木犀草素-7-O-鼠李葡萄糖甙（luteolin-7-O-galactoside），木犀草素-7-O-鼠李葡萄糖甙（luteolin-7-O-rhamnogside）[2]，木犀草素（luteolin），β-榄香烯（β-elemene），百里香酚（thymol），二十一烷（heneicosane），二十三烷（tricosa-ne），二十六烷（hexacosane）[3]，以及糖类和氨基酸[4]。"}]},{"ID":"20240607093811-fwkvcjy","Type":"NodeParagraph","Properties":{"id":"20240607093811-fwkvcjy","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607093811-79xz8fn","Type":"NodeParagraph","Properties":{"id":"20240607093811-79xz8fn","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 1.对心血管系统的作用：菊花水煎醇沉制剂对离体兔心有显着扩张冠脉,增加冠脉流量的作用。于接近心插管的恒压灌流液中注入1g生药时，可使2分钟内冠脉流量增加约62%，并使心率平均减慢20%左右。较大剂量对在位犬心，亦可致冠脉流量平均增加40%左右，心肌耗氧量平均增加27%。对电刺激兔中枢神经引起的缺血性心电图ST段压低有减轻作用，心率无变化或减慢，与离体兔心实验结果基本一致。对实验性冠脉粥样硬化兔的离体心脏，也能增加冠脉流量和提高心肌耗氧量。对菊花水提醇沉制剂以乙酸乙酯、氯仿提取分为不同部分，各部分对增加冠脉流量等均有作用。但均不及原制剂作用强度，说明菊花含有多种心脏活性成分，体现对心脏的协同作用。在对菊花酚性成分研究中发现，杭白菊酚性部分可以增加豚鼠离体心脏冠脉流量，提高小鼠对减压缺氧的耐受能力，总之菊花制剂能扩张冠脉，从而减轻心肌缺血状态，虽有使心收缩力加强与耗氧量增加的作用，但似仍以扩张冠脉占优势。"}]},{"ID":"20240607093811-fpuvpku","Type":"NodeParagraph","Properties":{"id":"20240607093811-fpuvpku","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"2.抗病原微生物作用：菊花水煎剂或水浸剂，体外试验对多种致病菌，以及流感病毒PR8和钩端螺旋体均有一定抑制作用，MIC约为1 ：10-1 ：80。小鼠体内抑菌试验表明，新鲜全草（地上部分）加水蒸馏所得的挥发油，对金黄色葡萄球菌，大肠杆菌，福氏痢疾杆菌等抑菌作用较强，对绿脓杆菌作用甚弱，对肺炎双球菌无效。"}]},{"ID":"20240607093811-lj6n4r0","Type":"NodeParagraph","Properties":{"id":"20240607093811-lj6n4r0","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"3.其它作用：大鼠口服菊花水煎剂3周后，抑制其肝微粒体羟甲基戊二酰辅酶A还原酶的活力，并能激活肝微粒体胆固醇7a－羟化酶。菊花与牛膝，熟地，山药合用可延长家蚕龄期，影响小鼠血液谷胱甘肽过氧化物酶活性和过氧化脂质的含量。菊花散剂给兔灌胃，有缩短凝血时间的效果，焙成炭药的散剂作用较生药有所增强。菊花制剂还能抑制皮内注射组胺所致的局部毛细血管通透性增加，其10mg的效力和芦丁2.5mg相当。"}]},{"ID":"20240607093811-i5zvy4w","Type":"NodeParagraph","Properties":{"id":"20240607093811-i5zvy4w","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607093811-5p9rbzl","Type":"NodeParagraph","Properties":{"id":"20240607093811-5p9rbzl","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 菊花：拣净叶梗、花柄及泥屑杂质。菊花炭：取拣净的菊花，置锅沟炒至焦褐黄色，但须存快，喷洒清水。取出晒干。"}]},{"ID":"20240607093811-6lz4ze6","Type":"NodeParagraph","Properties":{"id":"20240607093811-6lz4ze6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607093811-buuli4e","Type":"NodeParagraph","Properties":{"id":"20240607093811-buuli4e","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 归肺；肝经"}]},{"ID":"20240607093811-3u0jn40","Type":"NodeParagraph","Properties":{"id":"20240607093811-3u0jn40","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607093811-i07odae","Type":"NodeParagraph","Properties":{"id":"20240607093811-i07odae","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 味甘；苦；性微寒"}]},{"ID":"20240607093811-ymj9wwe","Type":"NodeParagraph","Properties":{"id":"20240607093811-ymj9wwe","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607093811-mgni6o1","Type":"NodeParagraph","Properties":{"id":"20240607093811-mgni6o1","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：气虚胃寒，食少泄泻之病，宜少用之。凡阳虚或头痛而恶寒者均忌用。"}]},{"ID":"20240607093811-l6e2uqd","Type":"NodeParagraph","Properties":{"id":"20240607093811-l6e2uqd","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607093811-pov2ky9","Type":"NodeParagraph","Properties":{"id":"20240607093811-pov2ky9","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 疏风清热；平肝明目；解毒消肿。主外感风或风温初起；发热头痛；眩晕；目赤肿痛；疔疮肿毒"}]},{"ID":"20240607093811-9vurv1a","Type":"NodeParagraph","Properties":{"id":"20240607093811-9vurv1a","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607093811-yjagefb","Type":"NodeParagraph","Properties":{"id":"20240607093811-yjagefb","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g；或入丸、散；或泡茶。外用：适量，煎水洗；或捣敷。"}]},{"ID":"20240607093811-waeuaf0","Type":"NodeParagraph","Properties":{"id":"20240607093811-waeuaf0","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607093811-37vwceh","Type":"NodeParagraph","Properties":{"id":"20240607093811-37vwceh","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" ①治风热头痛：菊花、石膏、卅穹各三钱。为未。每服一钱半，茶调下。(《简便单方》)②治太阴风温，但咳，身不甚热，微渴者：杏仁二钱，连翘一钱五分，薄荷八分，桑叶二钱五分，菊花一钱，苦桔梗二钱，甘草八分，苇根二钱，水二杯，煮取一杯，日三服。(《温病条辨》桑菊饮)③冶风眩：甘菊花暴干。作未，以米馈中，蒸作酒服。(徐嗣伯·菊花酒)④治热毒风上攻，目赤头旋，眼花面肿：菊花(焙)、排风子(焙)、甘草(炮)各一两。上三味，捣罗为散。夜卧时温水调下三钱匕。(《圣济总录》菊花散)⑤治眼目昏暗诸疾：蜀椒(去目并闭口，炒出汗，一斤半捣罗取未)一斤，甘菊花(未)一斤，上二味和匀，取肥地黄十五斤，切，捣研，绞取汁八、丸斗许，将前药未拌浸，令匀，暴稍干，入盘中，摊暴三、四日内取干，候得所即止，勿令大燥，入炼蜜二斤，同捣数千杵，丸如梧桐子大。每服三十丸，空心日午，熟水下。(《圣济总录》夜光丸)⑥治肝肾不足，虚火上炎，目赤肿痛，久视昏暗，迎风流泪，伯日羞明，头晕盗汗，潮热足软：枸杞子、甘菊花。熟地黄、山萸肉、怀山药、白茯苓、牡丹皮、泽泻。炼蜜为丸。(《医级》杞菊地黄丸)⑦治肝肾不足，眼目昏暗：甘菊花四两，巴戟(去心)一两，苁蓉(酒浸，去皮，炒，切，焙)二两)枸杞子三两。上为细未，炼蜜丸，如梧桐子大。每服三十丸至五十丸，温酒或盐汤下，空心食前服。( 《局方》菊睛丸)⑧治病后生翳：白菊花、蝉蜕等分。为散。每用二、三钱，入蜜少许，水煎服。(《救急方》)⑨治疗：白菊花四两，甘草四钱。水煎，顿服，渣再煎服。(《外科十法》菊花甘草汤)⑩治膝风：陈艾、菊花。作护膝，久用。(《扶寿精方》)"}]},{"ID":"20240607093811-uddlu4p","Type":"NodeParagraph","Properties":{"id":"20240607093811-uddlu4p","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607093811-zuwpdzp","Type":"NodeParagraph","Properties":{"id":"20240607093811-zuwpdzp","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 1.治疗冠心病：以菊花煎剂观察61例，对心绞痛症状的总有效率为80% ，其中显效43.3% ，改善86.7% ，以轻度者疗效较好；对胸闷、心悸、气急及头晕、头痛、四肢发麻等症状，亦有不同程度的疗效；心电图的总有效率为45.9% ，其中显效18.8% ，好转27.1%。对部分高血压患者有降压作用；对心率无明显影响，对血清胆制醇、三酸甘油酯未见明显的规律性变化。服药期间除1例有上腹痛、1例有轻度腹泻外，均无其他副作用。即使原有溃疡病的患者，亦多无影响。制剂及用法：白菊花10两，加温水浸泡过夜，次日煎2次，每次半小时；待沉淀后除去沉渣，再浓缩至500ml。每日2次，每次25ml。2个月为一疗程。"}]},{"ID":"20240607093811-inocm9m","Type":"NodeParagraph","Properties":{"id":"20240607093811-inocm9m","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"2.治疗高血压病：每日用菊花、银花各0.8-1两（头晕明显加桑叶4 钱，动脉硬化、血情胆制醇高者加山楂4-8钱），混匀，分4次用沸滚开水冲泡10-15分钟后当茶饮。一般冲泡2次后，药渣即可弃掉另换。不可煎熬，否则会破坏有效成分。据46例观察，服药3-7天后头痛、眩晕、失眠等症状开始减轻，随之血压渐降至正常者共35例，其余病例服药10-30天后，自觉症状均有不同程度的好转。"}]},{"ID":"20240607093811-ezd5771","Type":"NodeParagraph","Properties":{"id":"20240607093811-ezd5771","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607093811-eb3hhw6","Type":"NodeParagraph","Properties":{"id":"20240607093811-eb3hhw6","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：菊花，能补阴，须味甘者，若山野苦者勿用，大伤胃气。"}]},{"ID":"20240607093811-6a56tba","Type":"NodeParagraph","Properties":{"id":"20240607093811-6a56tba","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：菊花，昔人谓其能除风热，益肝补阴，盖不知其尤多能益金、水二脏也，补水所以制火，益金所以平木，木平则风息，火降则热除，用治诸风头目，其旨深微。"}]},{"ID":"20240607093811-5yktzro","Type":"NodeParagraph","Properties":{"id":"20240607093811-5yktzro","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：菊花专制凤木，故为去风之要药。苦可泄热，甘能益血，甘可解毒，平则兼辛，故亦散结，苦人心、小肠，甘人脾、胃，平辛走肝、胆，兼入沛与大肠。其主风头眩、肿痛、目欲脱、泪出、皮肤死肌、恶风、湿痹者，诸风掉眩，皆属肝木，风药先人肝，肝开窍于目，风为阳邪，势必走上，血虚则热，热则生风，风火相搏故也。腰痛去来陶陶者，乃血虚气滞之候，苦以泄滞结，甘以益血脉，辛平以散虚热也。其除胸中烦热者，心主血，虚则病烦，阴虚则热收于内，故热在胸中，血益则阴生，阴生则烦止，苦辛能泄热，故烦热并解。安肠胃，利五脉，调四肢，利血气者，即除热，祛风，益血，入心，入脾，入肝之验也。生捣最治疗疮，血线疔尤为要药，疗者风火之毒也。"}]},{"ID":"20240607093811-r3d3hjc","Type":"NodeParagraph","Properties":{"id":"20240607093811-r3d3hjc","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"4.《药品化》：甘菊，取白色者，其体轻，味微苦，性气和平，至清之品。《经》曰，治温以清。凡病热退，其气尚温，以此同桑皮理头痛，除余邪。佐黄蔑治眼昏，去翳障。助沙参疔肠红，止下血。领石斜、扁豆，明目聪耳，调达四肢。是以肺气虚，须用白甘菊。如黄色者，其味苦重，清香气散，主清肺火。凡头风眩晕，鼻塞热壅，肌肤湿痹，四肢游风，肩背疼痛，皆繇肺气热，以此清顺肺金，且清金则肝木有制。又治暴赤眼肿、目痛泪出。是以清肺热须用黄甘菊。"}]},{"ID":"20240607093811-1r2ayux","Type":"NodeParagraph","Properties":{"id":"20240607093811-1r2ayux","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"5.《本草新编》：甘菊花，气味轻清，功亦甚缓，必宜久服始效，不可责以近功，惟目痛骤用之，成功甚速，余则俱于缓始能取效也。近人多种菊，而不知滋补之方问有用之者。又取作茶茗之需，以为明目也。然而甘菊不单明目，可以大用之者，全在退阳明之胃火。盖阳明内热，必宜阴寒之药以泻之，如石膏、知母之类，然石育过于大峻，未免大寒以损胃气，不若用甘菊花至一、二两，同元参、麦冬共剂之，既能平胃中之火，而不伤胃之气也。"}]},{"ID":"20240607093811-qlkh25x","Type":"NodeParagraph","Properties":{"id":"20240607093811-qlkh25x","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"6.《本草经百种录》：凡芳香之物，皆能治头目肌表之疾。但香则无不辛燥者，惟菊不甚燥烈，故于头目风火之疾，尤宜焉。"}]},{"ID":"20240607093811-mtr580h","Type":"NodeParagraph","Properties":{"id":"20240607093811-mtr580h","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"7.《本草便读》：甘菊之用，可一言以蔽之，日疏风而已。然虽系疏风之品，而性味甘寒，与羌、麻等辛燥者不同，故补肝肾药中可相需而用也。"}]},{"ID":"20240607093811-pyp4oak","Type":"NodeParagraph","Properties":{"id":"20240607093811-pyp4oak","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"8.《本草正义》：凡花皆主宣扬疏泄，独菊花则摄纳下降，能平肝火，熄内风，抑木气之横逆。《本经》主风头眩者，以阴虚阳浮，气火升腾，肝凤上扰之眩晕言之，非外来风邪，能令人眩也。肿痛，连上风头眩三字读。肝火直上顶巅，而为眩，为肿，为痛，阳焰直升，其势最暴。凡是头凤作痛，无非内火内风震撼不息，而菊花能治之，非肃降静镇迥异寻常者，殆难有此力量。目如欲脱，乃肝阳内风之尤甚者。世谓头凤痛甚，至于丧明，抑知且有目珠突出，形如雀卵者。泪出亦阴虚于下，肝火上扬，真阴无摄纳之权，而风阳以疏泄为用，则迎风而泪下，此皆肝肾阴亏，而浮阳上亢为虐，惟菊花之清苦泄降，能收摄虚阳而纳归于下，故为目科要药。又治皮肤死肌，恶风湿痹者，则血热而络脉不洁，渐以积秽成腐。菊花苦辛宣络，能理血中热毒，则污浊去而痹着之死肌可愈。石顽谓清利血脉，而痹着湿邪，得以开泄，持论甚正。惟此是冲和纯粹之品，以清经隧积淤之浊血，断非旦夕可以速效，弗以无近功，而遽疑《经》言之不可信也。《别录》谓洽腰痛去来陶陶，盖言其悠久不已之状，是亦肾阴不足，而湿邪痹着为患，故其痛续续不息。菊花滋肾阴而清湿热，是以主之。又治胸中烦热而安肠胃，固无一非情肃泄热之功用也。甄权谓治头目风旋倒地，脑骨疼痛，则肝阳内风头痛，固有直上顶巅，脑骨如裂者，若风旋倒地，则血冲脑经，而失其知觉运动矣。又谓治身上一切游风，令消散，利血脉，则是血热生风之症，苦泄清理，而风自息。大明谓作枕明目，叶亦明目。洁古谓养目血，去翳膜。海藏谓主肝气不足。盖亦养肝阴，滋肝血之意。虽其气味清芬，然终非肝家气药。仲醇谓生捣最治疔疮，血线疗尤为要药。按疔是火毒，非大剂清解不可，外敷诸药如忍冬藤、马齿苋、蒲公英、草河车、芙蓉叶、青菊叶等，不过清热退肿，皆非专主之任，缨所称之血线疔，盖即红丝疔，有一痕红晕，自疮口上窜，直过时膝者。治皆以内服清解为主。但知外治，断不可恃。"}]},{"ID":"20240607093811-avb25jx","Type":"NodeParagraph","Properties":{"id":"20240607093811-avb25jx","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607093811-w9qwv01","Type":"NodeParagraph","Properties":{"id":"20240607093811-w9qwv01","updated":"20240607093811"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]}]}