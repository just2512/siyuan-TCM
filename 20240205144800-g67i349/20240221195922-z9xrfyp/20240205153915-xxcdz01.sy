h: 599px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 602px;","style":"width: 592px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 10-20240722130639-187pp21.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 592px;\" parent-style=\"width: 602px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722130958-n8eyqem","Type":"NodeParagraph","Properties":{"id":"20240722130958-n8eyqem","updated":"20240813150612"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 362px;","style":"width: 352px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 5-20240722124400-5zk08sq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 352px;\" parent-style=\"width: 362px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 514px;","style":"width: 504px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 4-20240722124231-bw3hfau.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 504px;\" parent-style=\"width: 514px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 345px;","style":"width: 335px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 6-20240722124641-goimicy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 335px;\" parent-style=\"width: 345px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722114723-kqvht9w","Type":"NodeParagraph","Properties":{"id":"20240722114723-kqvht9w","updated":"20240813150610"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 620px;","style":"width: 610px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 1-20240722115051-egk0adj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 610px;\" parent-style=\"width: 620px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 621px;","style":"width: 611px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 15-20240722131832-zk24mu5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 611px;\" parent-style=\"width: 621px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240909170639-9pk9ywr","Type":"NodeParagraph","Properties":{"id":"20240909170639-9pk9ywr","updated":"20240909170639"}},{"ID":"20240624115455-87e6rd6","Type":"NodeParagraph","Properties":{"id":"20240624115455-87e6rd6","updated":"20240807195324"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉葛、柴葛对比（葛根一般用柴葛）"}]},{"ID":"20240624111358-5iot6yi","Type":"NodeParagraph","Properties":{"id":"20240624111358-5iot6yi","updated":"20240722115641"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粉葛、柴葛对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粉葛、柴葛对比-20240722115626-to8ahll.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722131957-o1e4o76","Type":"NodeParagraph","Properties":{"id":"20240722131957-o1e4o76","updated":"20240813150238"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：药用葛根一般指柴葛，效果更佳，柴葛也叫野葛，根更深更难采挖；还有一种粉葛更多的是作为食物使用；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"block-ref strong","TextMarkBlockRefID":"20240206083526-e7szgia","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"粉葛"}]},{"ID":"20240611130911-pu5rpjc","Type":"NodeThematicBreak","Properties":{"id":"20240611130911-pu5rpjc"}},{"ID":"20240611130912-nh5lhsp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130912-nh5lhsp","updated":"20240611130916"},"Children":[{"Type":"NodeText","Data":"葛根《神农本草经》"}]},{"ID":"20240611130912-00tot66","Type":"NodeParagraph","Properties":{"id":"20240611130912-00tot66","updated":"20240611130912"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240611130912-0swa4jy","Type":"NodeParagraph","Properties":{"id":"20240611130912-0swa4jy","updated":"20240611130912"},"Children":[{"Type":"NodeText","Data":"主消渴，身大热，呕吐，诸痹，起阴气，解诸毒，葛谷，主下利，十岁已上。一名鸡齐根。生川谷。"}]},{"ID":"20240611130912-7b2zsp9","Type":"NodeParagraph","Properties":{"id":"20240611130912-7b2zsp9","updated":"20240611130912"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：葛根，神农甘，生太山（《御览》）。"}]},{"ID":"20240611130912-gv2rpkg","Type":"NodeParagraph","Properties":{"id":"20240611130912-gv2rpkg","updated":"20240611130912"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名鹿藿，一名黄斤，生汶山，五月采根，暴干。"}]},{"ID":"20240611131009-uzeuyj1","Type":"NodeThematicBreak","Properties":{"id":"20240611131009-uzeuyj1"}},{"ID":"20240611131010-g5rw79h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131010-g5rw79h","updated":"20240611131015"},"Children":[{"Type":"NodeText","Data":"葛根《神农本草经赞》"}]},{"ID":"20240611131010-wr0hswb","Type":"NodeParagraph","Properties":{"id":"20240611131010-wr0hswb","updated":"20240611131010"},"Children":[{"Type":"NodeText","Data":"味甘。主消渴身大热呕吐诸痹。起阴气。解诸毒。葛谷主下利十岁以上。一名鸡齐根。生川谷。"}]},{"ID":"20240611131010-gd4j3z0","Type":"NodeParagraph","Properties":{"id":"20240611131010-gd4j3z0","updated":"20240611131010"},"Children":[{"Type":"NodeText","Data":"鸡齐鹿藿。庇本繁滋。臂伸蜷曲。绝纷披。累依桂树。枯花萱枝。秋登谷似。龆龀扶羸。"}]},{"ID":"20240611131010-5zkbjhs","Type":"NodeParagraph","Properties":{"id":"20240611131010-5zkbjhs","updated":"20240611131010"},"Children":[{"Type":"NodeText","Data":"名医曰。一名鹿藿。左传注。葛庇其本根。蔓繁滋者。以本枝荫庇之多。苏颂曰。"}]},{"ID":"20240611131010-q84567n","Type":"NodeParagraph","Properties":{"id":"20240611131010-q84567n","updated":"20240611131010"},"Children":[{"Type":"NodeText","Data":"根形大如手臂。庾信表。一枝蜷曲。苏恭曰。葛根入土五六寸以上者名葛。有微毒。服之令人吐。说苑。王悬躯绝。许有壬诗。筐荐纷披。刘向九叹。葛累于桂树兮。张时彻诗。"}]},{"ID":"20240611131010-bfwaqsm","Type":"NodeParagraph","Properties":{"id":"20240611131010-bfwaqsm","updated":"20240611131010"},"Children":[{"Type":"NodeText","Data":"愿留枯根株。化作萱花枝。李时珍曰。葛谷是实。八九月采之。诗。式谷似之。庾信碑。未逾龆龀。宋史传。李渎扶羸养疾。"}]},{"ID":"20240611131035-bx6zk9o","Type":"NodeThematicBreak","Properties":{"id":"20240611131035-bx6zk9o"}},{"ID":"20240611131036-h64gn74","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131036-h64gn74","updated":"20240611131041"},"Children":[{"Type":"NodeText","Data":"葛根《本草衍义》"}]},{"ID":"20240611131036-yg0zabd","Type":"NodeParagraph","Properties":{"id":"20240611131036-yg0zabd","updated":"20240611131036"},"Children":[{"Type":"NodeText","Data":"澧、鼎之间，冬月取生葛，以水中揉出粉，澄成垛，先煎汤使沸，后擘成块下汤中，良久，色如胶，其体甚韧，以蜜汤中拌食之。擦少生姜尤佳。大治中热、酒、渴病，多食行小便，亦能使人利。病酒及渴者，得之甚良。彼之人，又切入煮茶中以待宾，但甘而无益。"}]},{"ID":"20240611131036-dki8lnw","Type":"NodeParagraph","Properties":{"id":"20240611131036-dki8lnw","updated":"20240611131036"},"Children":[{"Type":"NodeText","Data":"又将生葛根煮熟者，作果卖。虔、吉州、南安军亦如此卖。"}]},{"ID":"20240611131046-smw8eda","Type":"NodeThematicBreak","Properties":{"id":"20240611131046-smw8eda"}},{"ID":"20240611131047-1l0osnc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131047-1l0osnc","updated":"20240611131055"},"Children":[{"Type":"NodeText","Data":"葛根《本草便读》"}]},{"ID":"20240611131047-k5eb057","Type":"NodeParagraph","Properties":{"id":"20240611131047-k5eb057","updated":"20240611131047"},"Children":[{"Type":"NodeText","Data":"解阳明肌表之邪．甘凉无毒．鼓胃气升腾而上．津液资生．若云火郁发之．用其升散．或治痘疹不起．赖以宣疏．治泻则煨熟用之．又主两阳合邪之下利．解酒则葛花为最．因有解表利便之功能．孕妇固当忌投．有故亦能无殒．（葛根甘凉入胃．其根寓升发之意．故能解散阳明肌表之邪．凡一切风温热病．邪郁于表．热势内蒸．以致无汗口渴者．最为相宜．然毕竟气凉之品．如风寒在表．以及内不热而恶寒者．似又不宜也．煨熟则散性全无．即由胃入肠．不行阳明之表．但入阳明之里．升清为用．亦如升麻之煨熟即升而不散．可以浓肠止泻耳．）"}]},{"ID":"20240611131101-0tsi99n","Type":"NodeThematicBreak","Properties":{"id":"20240611131101-0tsi99n"}},{"ID":"20240611131103-eqb1q8l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131103-eqb1q8l","updated":"20240611131112"},"Children":[{"Type":"NodeText","Data":"葛根《本草图经》"}]},{"ID":"20240611131103-wveph2n","Type":"NodeParagraph","Properties":{"id":"20240611131103-wveph2n","updated":"20240611131109"},"Children":[{"Type":"NodeText","Data":"葛根，生汶山川谷，今处处有之，江浙尤多。春生苗，引藤蔓，长一、二丈，紫色；叶颇似楸叶而青；七月着花，似豌豆花，不结实；根形如手臂，紫黑色。五月五日午时采根，曝干。似入土深者为佳。今人多以作粉食之，甚益人。下品有葛粉条，即谓此也。古方多用根。"}]},{"ID":"20240611131103-mv1mljv","Type":"NodeParagraph","Properties":{"id":"20240611131103-mv1mljv","updated":"20240611131103"},"Children":[{"Type":"NodeText","Data":"张仲景治伤寒，有葛根及加半夏葛根黄芩黄连汤，以其主大热解肌，开腠理故也。葛洪治（古对切）腰痛，取生根嚼之，咽其汁，多益佳。叶主金刃疮，山行伤刺血出，卒不可得药，但叶敷之，甚效。《正元广利方》金创、中风、痉，欲死者，取生根四大两，切，以水三升，煮取一升，去滓，分温四服。口噤者，灌下，即瘥。"}]},{"ID":"20240611131023-dbxgjca","Type":"NodeThematicBreak","Properties":{"id":"20240611131023-dbxgjca"}},{"ID":"20240611131024-fk9b5cr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131024-fk9b5cr","updated":"20240611131029"},"Children":[{"Type":"NodeText","Data":"葛根《本草求真》"}]},{"ID":"20240611131024-2xxktws","Type":"NodeParagraph","Properties":{"id":"20240611131024-2xxktws","updated":"20240611131024"},"Children":[{"Type":"NodeText","Data":"（蔓草）入胃升阳解肌退热生津"}]},{"ID":"20240611131024-m8wlssc","Type":"NodeParagraph","Properties":{"id":"20240611131024-m8wlssc","updated":"20240611131024"},"Children":[{"Type":"NodeText","Data":"葛根（专入胃。兼入脾）。辛甘性平。轻扬升发。能入足扬明胃经鼓其胃气上行。生津止渴。（汪昂曰。风药多燥。葛根独能止渴者。以其能升胃气入肺而生津耳。）兼入脾经开腠发汗。（脾主肌肉。）解肌退热。缘伤寒太阳病罢。传入阳明。则头循经而痛。胃被寒蔽。而气不得上升。入肺则渴。胃主肌肉。气不宣通则热。故当用此以治。俾其气升津生。肌解热退。（因其体轻故解肌。因其气升故生津。）而无复传之势矣！（时珍曰。本草十剂云。轻可去实。麻黄葛根之属。盖麻黄乃太阳经药。兼入肺经。肺主皮毛。葛根乃阳明经药。兼入脾经。脾主肌肉。所以二味药皆轻扬发散。而所入迥然不同也。绣曰。麻黄入肺而不入脾。因其中空象肺之故。葛根入脾而不入肺。因其体轻蔓延。周身通达象肌之故。）但葛根一味。必其于头额侠之处（阳明经行于面额）。痛如刀劈。方谓邪传阳明。其药可用。（张元素曰。头颅痛如刀破。乃阳明中风。可用葛根葱白汤。）若使未入阳明。又是引邪内入。不可用也。即邪在于太阳而略见于阳明。则以方来之阳明为重。故必用葛根以绝其路。（仲景治太阳阳明合病桂枝汤加葛根麻黄。又有葛根黄芩黄连解肌汤。是用以断太阳阳明之路。非太阳药也。）若使阳明症备。而止兼有太阳。则又以未罢之太阳为重。故又不用葛根。且阳明主肌肉者也。而用干葛大开肌肉。则津液尽从外泄。恐胃愈燥而阴立亡。至于疹痘未发。则可用此升提。酒醉则可用此解酲。火郁则可用此升散。但亦须审中病辄止。（如丹溪云。治疟无汗要有汗。散邪为主带补。有汗要无汗。扶正为主带散。若阳疟有汗。加参耆以敛之。无汗加芩葛苍术以发之。）不可过用。以致胃气有伤也。（如丹溪云。斑疹已见红点。不可更服升葛汤。恐表虚反增斑烂。）"}]},{"ID":"20240611130841-q8rj1la","Type":"NodeThematicBreak","Properties":{"id":"20240611130841-q8rj1la"}},{"ID":"20240611130858-a3ikqqa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130858-a3ikqqa","updated":"20240611130904"},"Children":[{"Type":"NodeText","Data":"葛根《本草崇原》"}]},{"ID":"20240611130858-2kirqmy","Type":"NodeParagraph","Properties":{"id":"20240611130858-2kirqmy","updated":"20240611130858"},"Children":[{"Type":"NodeText","Data":"气味甘辛平，无毒。主治消渴，身大热，呕吐，诸痹，起阴气，解诸毒。"}]},{"ID":"20240611130858-q4nfn80","Type":"NodeParagraph","Properties":{"id":"20240611130858-q4nfn80","updated":"20240611130858"},"Children":[{"Type":"NodeText","Data":"（葛处处有之，江浙尤多，春生苗，延引藤蔓，其根大如手臂，外色紫黑，内色洁白，可作粉食，其花红紫，结实如黄豆荚，其仁如梅核，生嚼腥气。《本经》所谓葛谷者是也。）"}]},{"ID":"20240611130858-qwq5v07","Type":"NodeParagraph","Properties":{"id":"20240611130858-qwq5v07","updated":"20240611130858"},"Children":[{"Type":"NodeText","Data":"葛根延引藤蔓，则主经脉，甘辛粉白，则入阳明，皮黑花红，则合太阳，故葛根为宣达阳明中土之气，而外合于太阳经脉之药也。主治消渴身大热者，从胃府而宣达水谷之津，则消渴自止，从经脉而调和肌表之气，则大热自除。治呕吐者，和阳明之胃气也，治诸痹者，和太阳之经脉也。起阴气者，藤引蔓延，从下而上也，解诸毒者，气味甘辛，和于中而散于外也。"}]},{"ID":"20240611130858-cgyupfx","Type":"NodeParagraph","Properties":{"id":"20240611130858-cgyupfx","updated":"20240611130858"},"Children":[{"Type":"NodeText","Data":"元人张元素曰∶葛根为阳明仙药，若太阳初病，未入阳明，而头痛者，不可便用升麻、葛根，用之反引邪入阳明，为引贼破家也。愚按∶仲祖《伤寒论》方有葛根汤，治太阳病，项背强几几，无汗，恶风。又治太阳与阳明合病。若阳明本病，只有白虎、承气诸汤，并无葛根汤证，况葛根主宣通经脉之正气以散邪，岂反引邪内入耶。前人学不明经，屡为异说。李时珍一概收录，不加辩证，学人看本草发明，当合经论参究，庶不为前人所误。"}]},{"ID":"20240611130858-bjc2efx","Type":"NodeParagraph","Properties":{"id":"20240611130858-bjc2efx","updated":"20240611130858"},"Children":[{"Type":"NodeText","Data":"（卢子由曰∶《本经》痹字与风寒湿相合之痹不同，如消渴、身热、呕吐及阴气不起，与诸毒皆痹也，故云诸痹。）"}]},{"ID":"20240611130814-hpgztje","Type":"NodeThematicBreak","Properties":{"id":"20240611130814-hpgztje"}},{"ID":"20240611130825-fxg9mxv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130825-fxg9mxv","updated":"20240611130834"},"Children":[{"Type":"NodeText","Data":"葛根《本草新编》"}]},{"ID":"20240611130825-c3nq518","Type":"NodeParagraph","Properties":{"id":"20240611130825-c3nq518","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"葛根，味甘，气平，体轻上行，浮而微降，阳中阴也，无毒。入胃足阴明，疗伤寒，发表肌热。又入脾，解燥，生津止渴。解酒毒卒中，却温疟往来寒热，散疮疹止疼，提气，除热蒸。"}]},{"ID":"20240611130825-stg4jyi","Type":"NodeParagraph","Properties":{"id":"20240611130825-stg4jyi","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"虽君药而切戒过用，恐耗散人真气也。"}]},{"ID":"20240611130825-ovrugd8","Type":"NodeParagraph","Properties":{"id":"20240611130825-ovrugd8","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或问葛根解寒伤营之圣药，何以有时用之以解营中寒邪，而风邪不肯散，得毋葛根非解营之圣药耶？夫葛根实解寒伤营之圣药也。因人多用，反致伤营之正气，正气伤，而寒邪欺正气之弱，不肯外泄，反致无功。盖葛根轻浮，少用则浮而外散，多用则沉而内降矣。"}]},{"ID":"20240611130825-uo30ls1","Type":"NodeParagraph","Properties":{"id":"20240611130825-uo30ls1","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或问葛根解肌表之邪，何以仲景张公用之于葛根汤中，以入阳明耶？曰∶葛根原是阳明之药，少用则散肌中之风，多用则解胃中之热，一物而可以两用也。况寒邪由营以入腑，邪入胃中，而未必尽入胃也，半入于胃，而半留于营。用葛根，则营卫不两解乎，此葛根汤所以用葛根也。"}]},{"ID":"20240611130825-uwt81xk","Type":"NodeParagraph","Properties":{"id":"20240611130825-uwt81xk","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或问用葛根以退胃中之邪热，而胃之热不能去，胃之邪不能解，必用石膏白虎汤而后解，似乎葛根非阳明之药也。不知葛根止能退阳明初入之邪，不能退阳明变热之邪，变热之邪，必须用石膏，而不可用葛根，非葛根不是阳明之药也。"}]},{"ID":"20240611130825-dg6qe68","Type":"NodeParagraph","Properties":{"id":"20240611130825-dg6qe68","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或问葛根解肺之燥，何以又入胃中，以解肌中之热，得毋有误乎？非误也。葛根体轻则入肺，下降则入胃，又何疑焉。惟是解胃中之热，即所以解肺中之燥，不可不知其义也。伤寒肺燥者，邪入于胃也。胃热则火炽，火炽则金燥，胃本生肺，过燥，则生肺者转克肺矣。葛根解胃中之热，热解而火息，火息而土之气生，土之气生而金之气亦生，金之气生而肺之燥自解。用一葛根，肺与胃已两治之矣，不必解胃中之热，又去解肺中之燥也。"}]},{"ID":"20240611130825-6nq7077","Type":"NodeParagraph","Properties":{"id":"20240611130825-6nq7077","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或问葛根发表除热，而表不能发，热不能除者，何故？此不善用葛根之故也。葛根轻清，少用则遂其性而上行，多用则违其性而下降。夫风邪在外，宜引而外出，不宜引而内入。火邪炎上，宜引而上散，不宜引而下散，乃不少用以遂其性，反多用以违其性，自然风邪不外出而内入，火邪不上散而下攻矣，欲其发表除热得乎，此葛根所以宜善用也。"}]},{"ID":"20240611130825-x9k7ypm","Type":"NodeParagraph","Properties":{"id":"20240611130825-x9k7ypm","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或疑葛根发表解肌热，与麻黄功用相同，何以麻黄在亡阳之列，而葛根独不之戒耶？盖葛根未尝不能亡阳，但较麻黄则少轻耳，不然，亦何必劝人少用，而不可多用乎哉！"}]},{"ID":"20240611130825-wdnen89","Type":"NodeParagraph","Properties":{"id":"20240611130825-wdnen89","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或疑葛根散邪而不补正，今人用之者甚多矣，未见其害人也。曰∶葛根耗人元气，原在无形。天下有形之损，其损小。无形之损，其损大，不可不知也。"}]},{"ID":"20240611130825-eb81ysz","Type":"NodeParagraph","Properties":{"id":"20240611130825-eb81ysz","updated":"20240611130825"},"Children":[{"Type":"NodeText","Data":"或问葛根轻清之味，耗人之元气，亦必不甚，安有损于无形者大乎？夫元气甚微，损伤于无形，从何而知其非大耶？大凡气之重者可防，味浓者可辨。葛根之味则淡也，气则微也，宜乎世不用信之，然药实闻诸异人之言，故告世共知之，诚以淡之中而有危，微微之内而有死法，杀人于气味之外耳。"}]},{"ID":"20240611130814-jnld7vu","Type":"NodeThematicBreak","Properties":{"id":"20240611130814-jnld7vu"}},{"ID":"20240611130815-67k2p9b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130815-67k2p9b","updated":"20240611130820"},"Children":[{"Type":"NodeText","Data":"葛根《本草从新》"}]},{"ID":"20240611130815-7ft0slx","Type":"NodeParagraph","Properties":{"id":"20240611130815-7ft0slx","updated":"20240611130815"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"轻、宣、解肌、升阳散火．"}]},{"ID":"20240611130815-jufamsf","Type":"NodeParagraph","Properties":{"id":"20240611130815-jufamsf","updated":"20240611130815"},"Children":[{"Type":"NodeText","Data":"辛甘性平．轻扬升发．入阳明经．能鼓胃气上行．生津止渴．（风药多燥、葛根独能止渴者、以其升胃气入肺而生津尔．）兼入脾经．开腠发汗．解肌退热．（脾主肌肉．）为治清气下陷泄泻之圣药．（经曰∶清气在下、则生飧泄、葛根能升阳明清气．）疗伤寒中风．阳明头痛．（元素曰∶头痛如破、乃阳明中风、可用葛根葱白汤、若太阳初病、未入阳明而头痛者、不可便服升葛汤发之、反引邪气入阳明也、仲景治太阳阳明合病、桂枝汤加葛根麻黄、又有葛根黄芩黄连解肌汤、是用以断太阳入阳明之路、非太阳药也．）血痢温疟．（丹溪曰∶凡治疟、无汗要有汗、散邪为主、带补、有汗要无汗、扶正为主、带散、若阳疟有汗、加参 白术以敛之、无汗、加柴葛苍术以发之．）肠风痘疹．（能发痘疹、丹溪曰∶凡斑疹已见红点、不可更服升葛汤、恐表虚反增斑烂也．）又能起阴气．散郁火．解酒毒．（葛花尤良．）利二便．杀百药毒．上盛下虚之人．虽有脾胃病．亦不宜服．即当用者．亦宜少用．多则反伤胃气．以其升散太过也．（夏月表虚汗多、尤忌．）生葛汁大寒．解温病大热．吐衄诸血．"}]},{"ID":"20240611131140-49731os","Type":"NodeThematicBreak","Properties":{"id":"20240611131140-49731os"}},{"ID":"20240611131141-0h879l0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131141-0h879l0","updated":"20240611131146"},"Children":[{"Type":"NodeText","Data":"葛根《本草择要纲目》"}]},{"ID":"20240611131141-s96n07t","Type":"NodeParagraph","Properties":{"id":"20240611131141-s96n07t","updated":"20240611131141"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611131141-b1w699s","Type":"NodeParagraph","Properties":{"id":"20240611131141-b1w699s","updated":"20240611131141"},"Children":[{"Type":"NodeText","Data":"甘辛平无毒．升也阳也．为阳明经行经之药．"}]},{"ID":"20240611131141-imuoszt","Type":"NodeParagraph","Properties":{"id":"20240611131141-imuoszt","updated":"20240611131141"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611131141-aadyrai","Type":"NodeParagraph","Properties":{"id":"20240611131141-aadyrai","updated":"20240611131141"},"Children":[{"Type":"NodeText","Data":"消渴身大热．疗伤寒中风头痛．解肌发表出汗．开腠理．其气轻浮．鼓舞胃气上行．朱氏云．凡头痛如破．投以莲须葱白汤而不已者．以葛根葱白汤主之．似乎葛根又为太阳之药．不知仲景之治太阳阳明合病．桂枝汤内加麻黄葛根．又有葛根黄连黄芩解肌汤．是因此以是断太阳入阳明之路．非即太阳药也．虽然葛根固能断太阳入阳明之路．孰知太阳初病未入阳明而头痛者．不可便服升麻葛根之发剂．反能引邪气入阳明为引贼破家之害欤．又仲景治伤寒有葛根汤．以主大热解肌发腠理．若 痘之症葛根汤亦为对剂．孰知 痘已见红点．则不可复用升麻葛根汤．致重虚其表．而增 烂之患也．又或谓葛根为治脾虚作渴之仙药．复云不可多用．多用则恐伤其胃气何也．孰知脾者津液之府．脾气不伸．则津液耗竭．得葛根以升发其阳．则脾得所生．若误认为脾药而过发不已．则胃气何得无伤乎．"}]},{"ID":"20240611131128-b6mls9q","Type":"NodeThematicBreak","Properties":{"id":"20240611131128-b6mls9q"}},{"ID":"20240611131130-tj2m5rr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131130-tj2m5rr","updated":"20240611131134"},"Children":[{"Type":"NodeText","Data":"葛根《汤液本草》"}]},{"ID":"20240611131130-ctc2mhj","Type":"NodeParagraph","Properties":{"id":"20240611131130-ctc2mhj","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"气平，味甘。无毒。"}]},{"ID":"20240611131130-z0oesk5","Type":"NodeParagraph","Properties":{"id":"20240611131130-z0oesk5","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"阳明经引经药，足阳明经行经的药。"}]},{"ID":"20240611131130-fz00g4p","Type":"NodeParagraph","Properties":{"id":"20240611131130-fz00g4p","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《象》云∶治脾虚而渴，除胃热，解酒毒，通行足阳明经之药，去皮用。"}]},{"ID":"20240611131130-brrhp2e","Type":"NodeParagraph","Properties":{"id":"20240611131130-brrhp2e","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《心》云∶止渴升阳。"}]},{"ID":"20240611131130-ureu9sp","Type":"NodeParagraph","Properties":{"id":"20240611131130-ureu9sp","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《珍》云∶益阳生津，勿多用，恐伤胃气。虚渴者，非此不能除。"}]},{"ID":"20240611131130-aymzw9w","Type":"NodeParagraph","Properties":{"id":"20240611131130-aymzw9w","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主消渴，身大热，呕吐，诸痹，起阴气，解诸毒，疗伤寒中风头痛，解肌发表出汗，开腠理，疗金疮，止痛，胁风痛。生根汁，寒，治消渴，伤寒壮热。花，主消酒。粉，味甘，大寒，主压丹石，去烦热，利大小便，止渴。小儿热秃，以葛根浸、捣汁饮之，良。"}]},{"ID":"20240611131130-5uxyatc","Type":"NodeParagraph","Properties":{"id":"20240611131130-5uxyatc","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"东垣云∶葛根甘平，温，世人初病太阳证，便服葛根升麻汤，非也。"}]},{"ID":"20240611131130-irm2wj1","Type":"NodeParagraph","Properties":{"id":"20240611131130-irm2wj1","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"朱奉议云∶头痛如欲破者，连须葱白汤饮之，又不已者，葛根葱白汤。"}]},{"ID":"20240611131130-cazwihs","Type":"NodeParagraph","Properties":{"id":"20240611131130-cazwihs","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"易老云∶用此以断太阳入阳明之路，非即太阳药也。故仲景治太阳、阳明合病，桂枝汤内加麻黄、葛根也。又有葛根、黄芩、黄连解肌汤，是知葛根非太阳药，即阳明药。"}]},{"ID":"20240611131130-oi36u7u","Type":"NodeParagraph","Properties":{"id":"20240611131130-oi36u7u","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《食疗》云∶葛根蒸食之消毒，其粉亦甚妙。其粉以水调三合，能解鸩毒。"}]},{"ID":"20240611131130-kilulvf","Type":"NodeParagraph","Properties":{"id":"20240611131130-kilulvf","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶治中热酒渴病，多食行小便，亦能使人利。病酒及渴者，得之甚良。"}]},{"ID":"20240611131130-1za4crz","Type":"NodeParagraph","Properties":{"id":"20240611131130-1za4crz","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"易老又云∶太阳初病未入阳明，头痛者，不可便服葛根发之；若服之，是引贼破家也。"}]},{"ID":"20240611131130-zc6ey0x","Type":"NodeParagraph","Properties":{"id":"20240611131130-zc6ey0x","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"若头颅痛者，可服之。葛根汤，阳明自中风之仙药也。"}]},{"ID":"20240611131130-ta400gj","Type":"NodeParagraph","Properties":{"id":"20240611131130-ta400gj","updated":"20240611131130"},"Children":[{"Type":"NodeText","Data":"《本草》又云∶杀野葛、巴豆百药毒。"}]},{"ID":"20240611130650-ja4gytm","Type":"NodeThematicBreak","Properties":{"id":"20240611130650-ja4gytm"}},{"ID":"20240611130801-mx6vbzg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130801-mx6vbzg","updated":"20240611130809"},"Children":[{"Type":"NodeText","Data":"葛根《本经逢原》"}]},{"ID":"20240611130801-yfec9gc","Type":"NodeParagraph","Properties":{"id":"20240611130801-yfec9gc","updated":"20240611130801"},"Children":[{"Type":"NodeText","Data":"甘平，无毒。色白者良。入阳明。表药生用。胃热烦渴，煨熟用。"}]},{"ID":"20240611130801-v961hxn","Type":"NodeParagraph","Properties":{"id":"20240611130801-v961hxn","updated":"20240611130801"},"Children":[{"Type":"NodeText","Data":"《本经》主消渴、身大热、呕吐、诸痹，起阳气，解诸毒。"}]},{"ID":"20240611130801-um22rws","Type":"NodeParagraph","Properties":{"id":"20240611130801-um22rws","updated":"20240611130801"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"葛根性升属阳，能鼓午胃中清阳之气，故《本经》主消渴、身热、呕吐，使胃气敷布，诸痹自开。其言起阳气、解诸毒者，胃气升发，诸邪毒自不能留而解散矣。葛根乃阳明经之专药，治头额痛，眉棱骨痛，天行热气呕逆，发散解肌，开胃止渴，宣斑发痘。若太阳经初病头脑痛而不渴者，邪尚未入阳明不可便用，恐引邪内入也。仲景治太阳、阳明合病，自利反不利，但呕者俱用葛根汤。太阳病下之遂利不止，喘汗脉促者，葛根黄芩黄连汤，此皆随二经表里寒热轻重而为处方。按证施治，靡不应手神效。又葛根葱白汤为阳明头痛仙药。斑疹已见点不可用葛根、升麻，恐表虚反增斑烂也；又葛根轻浮，生用则升阳生津，熟用则鼓午胃气，故治胃虚作渴，七味白术散用之。又清暑益气汤兼黄 用者，以暑伤阳明，额颅必胀，非此不能开发也。花能解酒毒，葛花解醒汤用之，必兼人参，但无酒毒者不可服，服之损人天元，以大开肌肉而发泄伤津也。"}]},{"ID":"20240611130558-j0crhe7","Type":"NodeThematicBreak","Properties":{"id":"20240611130558-j0crhe7"}},{"ID":"20240611130624-jjwf5l5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130624-jjwf5l5","updated":"20240611130648"},"Children":[{"Type":"NodeText","Data":"葛根《中药学》"}]},{"ID":"20240611130624-oq0wlr7","Type":"NodeParagraph","Properties":{"id":"20240611130624-oq0wlr7","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【药用】本品为豆科植物粉葛的根。"}]},{"ID":"20240611130624-zn0fpvm","Type":"NodeParagraph","Properties":{"id":"20240611130624-zn0fpvm","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、辛，平。入脾，胃经。"}]},{"ID":"20240611130624-7a1m2y3","Type":"NodeParagraph","Properties":{"id":"20240611130624-7a1m2y3","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【功效】解表，透疹，生津，止泻。"}]},{"ID":"20240611130624-qhy3k3g","Type":"NodeParagraph","Properties":{"id":"20240611130624-qhy3k3g","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于感冒、发热、恶寒、无汗、项强等症。"}]},{"ID":"20240611130624-stzl760","Type":"NodeParagraph","Properties":{"id":"20240611130624-stzl760","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"葛根有发汗、退热作用，与柴胡等配伍可用于表热症；与麻黄、桂枝、芍药同用治风寒表症而见项背强、无汗、恶风者。"}]},{"ID":"20240611130624-pamyoyd","Type":"NodeParagraph","Properties":{"id":"20240611130624-pamyoyd","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"2.用于麻疹透发不畅。"}]},{"ID":"20240611130624-7mce38k","Type":"NodeParagraph","Properties":{"id":"20240611130624-7mce38k","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"葛根有透发麻疹作用，因其兼有生津、止泻功能，所以麻疹发热口渴，或伴有腹泻等症，常与升麻等配合应用。"}]},{"ID":"20240611130624-kibeu62","Type":"NodeParagraph","Properties":{"id":"20240611130624-kibeu62","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"3.用于胃热口渴等症。"}]},{"ID":"20240611130624-fw8c4xw","Type":"NodeParagraph","Properties":{"id":"20240611130624-fw8c4xw","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"本品又能生津止渴，对热病口渴，或消渴等症，可配麦冬、天花粉等同用。"}]},{"ID":"20240611130624-49cfr99","Type":"NodeParagraph","Properties":{"id":"20240611130624-49cfr99","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"4.用于脾虚泄泻、湿热泻痢等症。"}]},{"ID":"20240611130624-cflml5f","Type":"NodeParagraph","Properties":{"id":"20240611130624-cflml5f","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"本品性能升发清阳，鼓舞脾胃阳气上升，有制止泄泻的作用，临床常配合党参、白朮等治疗脾虚泄泻；但又可配黄连、黄芩等，用于湿热泻痢等症。"}]},{"ID":"20240611130624-hjjbceh","Type":"NodeParagraph","Properties":{"id":"20240611130624-hjjbceh","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【处方用名】生葛根、粉葛根（生用，用于解表、透疹、生津。）、煨葛根（用麸皮同炒至微黄色为度，用于止泻。"}]},{"ID":"20240611130624-akjx0le","Type":"NodeParagraph","Properties":{"id":"20240611130624-akjx0le","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240611130624-bewxfqq","Type":"NodeParagraph","Properties":{"id":"20240611130624-bewxfqq","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【附药】葛花：药用粉葛的花。性味甘平。功能解酒毒，醒胃止渴。适用于饮酒过度，口渴，胃气受伤。一般用量为一钱至二钱，煎服。"}]},{"ID":"20240611130624-2brd4o9","Type":"NodeParagraph","Properties":{"id":"20240611130624-2brd4o9","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【按语】1.葛根甘润性平而偏凉，有升散、退热、生津的功效。凡邪郁肌表，身热不退，不论口渴或不渴，有汗或无汗，都可应用。"}]},{"ID":"20240611130624-8fvp5li","Type":"NodeParagraph","Properties":{"id":"20240611130624-8fvp5li","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"2.根据前人经验，葛根可用治项背强的病候，近年来经临床实践，本品确有缓解肌肉痉挛的功效。"}]},{"ID":"20240611130624-f1oieao","Type":"NodeParagraph","Properties":{"id":"20240611130624-f1oieao","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"【方剂举例】柴葛解肌汤《伤寒六书》：柴胡、葛根、石膏、羌活、白芷、黄芩、芍药、桔梗、甘草、生姜、大枣。治三阳合病。头痛发热、心烦不眠、目疼鼻干、四肢酸楚、脉微洪者。"}]},{"ID":"20240611130624-0zb25h8","Type":"NodeParagraph","Properties":{"id":"20240611130624-0zb25h8","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"葛根黄芩黄连汤《伤寒论》：葛根、黄芩、黄连、甘草。治身热下利、胸脘烦热、口中作渴、喘而汗出者。"}]},{"ID":"20240611130624-9puduc0","Type":"NodeParagraph","Properties":{"id":"20240611130624-9puduc0","updated":"20240611130624"},"Children":[{"Type":"NodeText","Data":"葛根汤《伤寒论》：葛根、麻黄、甘草、芍药、桂枝、生姜、大枣。治太阳病、项背强几几无汗恶风者；又治太阳，阳明合病，自下利者。"}]},{"ID":"20240611130559-z0rjbet","Type":"NodeThematicBreak","Properties":{"id":"20240611130559-z0rjbet"}},{"ID":"20240611130610-2du0k4w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130610-2du0k4w","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"《中国药典》：葛根"}]},{"ID":"20240611130610-lzxhelw","Type":"NodeParagraph","Properties":{"id":"20240611130610-lzxhelw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611130610-utoe0yi","Type":"NodeParagraph","Properties":{"id":"20240611130610-utoe0yi","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" Gě Gēn"}]},{"ID":"20240611130610-rtzon25","Type":"NodeParagraph","Properties":{"id":"20240611130610-rtzon25","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611130610-0293g0y","Type":"NodeParagraph","Properties":{"id":"20240611130610-0293g0y","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 葛藤、粉葛、干葛、葛麻藤"}]},{"ID":"20240611130610-5ldfu17","Type":"NodeParagraph","Properties":{"id":"20240611130610-5ldfu17","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611130610-sutofz4","Type":"NodeParagraph","Properties":{"id":"20240611130610-sutofz4","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" RADIX PUERARIAE"}]},{"ID":"20240611130610-y3fl8m6","Type":"NodeParagraph","Properties":{"id":"20240611130610-y3fl8m6","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611130610-5otoge4","Type":"NodeParagraph","Properties":{"id":"20240611130610-5otoge4","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 本品为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野葛"},{"Type":"NodeText","Data":"Pueraria lobata （Willd.）Ohwi或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"甘葛藤"},{"Type":"NodeText","Data":"Pueraria thomsonii Benth.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋、冬二季采挖，野葛多趁鲜切成厚片或小块；干燥；甘葛藤习称“粉葛”，多除去外皮，用硫黄熏后，稍干，截段或再纵切两半，干燥。"}]},{"ID":"20240611130610-qhyce99","Type":"NodeParagraph","Properties":{"id":"20240611130610-qhyce99","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611130610-qyqals8","Type":"NodeParagraph","Properties":{"id":"20240611130610-qyqals8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 野葛：呈纵切的长方形厚片或小方块，长5～35cm,厚0.5～1cm。外皮淡棕色，有纵皱纹，粗糙。切面黄白色，纹理不明显。质韧，纤维性强。无臭，味微甜。"}]},{"ID":"20240611130610-ghtnt6t","Type":"NodeParagraph","Properties":{"id":"20240611130610-ghtnt6t","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"粉葛：呈圆柱形、类纺锤形或半圆柱形，长12～15cm，直径4～8cm；有的为纵切或斜切的厚片，大小不一。表面黄白色或淡棕色，未去外皮的呈灰棕色。横切面可见由纤维形成的浅棕色同心性环纹，纵切面可见由纤维形成的数条纵纹。体重，质硬，富粉性。"}]},{"ID":"20240611130610-p54n9jt","Type":"NodeParagraph","Properties":{"id":"20240611130610-p54n9jt","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611130610-k3sg85o","Type":"NodeParagraph","Properties":{"id":"20240611130610-k3sg85o","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240611130610-28j9ctc","Type":"NodeParagraph","Properties":{"id":"20240611130610-28j9ctc","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611130610-5clj8gc","Type":"NodeParagraph","Properties":{"id":"20240611130610-5clj8gc","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240611130610-se4s5in","Type":"NodeParagraph","Properties":{"id":"20240611130610-se4s5in","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611130610-d1sn6r5","Type":"NodeParagraph","Properties":{"id":"20240611130610-d1sn6r5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末淡棕色、黄白色或淡黄色。淀粉粒甚多，单粒球形、半圆形或多角形，直径 3～37μｍ，脐点点状、裂缝状或星状；复粒由2～10 分粒组成。纤维多成束，壁厚，木化，周围细胞大多含草酸钙方晶，形成晶纤维，含晶细胞壁木化增厚。石细胞少见，类圆形或多角形，直径38～70μm 。具缘纹孔导管较大，具缘纹孔六角形或椭圆形，排列极为紧密。"}]},{"ID":"20240611130610-wy6q2xm","Type":"NodeParagraph","Properties":{"id":"20240611130610-wy6q2xm","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末0.8g，加甲醇10ml，放置2 小时，滤过，滤液蒸干,残渣加甲醇0.5ml使溶解，作为供试品溶液。另取葛根素对照品，加甲醇制成每1ml 含1mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各10μl ，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｈ薄层板上，使成条状，以氯仿－甲醇－水 （7:2.5:0.25） 为展开剂，展开，取出，晾干，置紫外光灯（365nm） 下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光条斑。"}]},{"ID":"20240611130610-uywg1x3","Type":"NodeParagraph","Properties":{"id":"20240611130610-uywg1x3","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611130610-4n6fa8x","Type":"NodeParagraph","Properties":{"id":"20240611130610-4n6fa8x","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 归脾、胃经。"}]},{"ID":"20240611130610-mdfg8g1","Type":"NodeParagraph","Properties":{"id":"20240611130610-mdfg8g1","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611130610-ukssl1u","Type":"NodeParagraph","Properties":{"id":"20240611130610-ukssl1u","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 甘、辛，凉。"}]},{"ID":"20240611130610-fsugfsv","Type":"NodeParagraph","Properties":{"id":"20240611130610-fsugfsv","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611130610-ahhpjcz","Type":"NodeParagraph","Properties":{"id":"20240611130610-ahhpjcz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 解肌退热，生津，透疹，升阳止泻。用于外感发热头痛、项背强痛，口渴，消渴，麻疹不透，热痢，泄泻；高血压颈项强痛。"}]},{"ID":"20240611130610-pnqwhji","Type":"NodeParagraph","Properties":{"id":"20240611130610-pnqwhji","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611130610-o7vqhew","Type":"NodeParagraph","Properties":{"id":"20240611130610-o7vqhew","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611130610-nck6or5","Type":"NodeParagraph","Properties":{"id":"20240611130610-nck6or5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611130610-k8fr52r","Type":"NodeParagraph","Properties":{"id":"20240611130610-k8fr52r","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" （1）葛根有发汗、退热作用，与柴胡等配伍可用于表热症；与麻黄、桂枝、芍药同用治风寒表症而见项背强、无汗、恶风者。葛根有透发麻疹作用，因其兼有生津、止泻功能，所以麻疹发热口渴，或伴有腹泻等症，常与升麻等配合应用。本品又能生津止渴，对热病口渴，或消渴等症，可配麦冬、天花粉等同用。本品性能升发清阳，鼓舞脾胃阳气上升，有制止泄泻的作用，临床常配合党参、白朮等治疗脾虚泄泻；但又可配黄连、黄芩等，用于湿热泻痢等症。"}]},{"ID":"20240611130610-cv114ma","Type":"NodeParagraph","Properties":{"id":"20240611130610-cv114ma","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611130610-01516yl","Type":"NodeParagraph","Properties":{"id":"20240611130610-01516yl","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611130610-etps3c5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130610-etps3c5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：葛根"}]},{"ID":"20240611130610-di6n2aj","Type":"NodeParagraph","Properties":{"id":"20240611130610-di6n2aj","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611130610-k9zll79","Type":"NodeParagraph","Properties":{"id":"20240611130610-k9zll79","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" Gě Gēn"}]},{"ID":"20240611130610-g5vy5xd","Type":"NodeParagraph","Properties":{"id":"20240611130610-g5vy5xd","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611130610-jhjvn7b","Type":"NodeParagraph","Properties":{"id":"20240611130610-jhjvn7b","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 干葛（《阎氏小儿方》），甘葛（《滇南本草》），粉葛（《草木便方》），葛麻茹（《陆川本草》），葛于根（《山东中药》），黄葛根（《四川中药志》），葛条根（《陕西中药志》）。"}]},{"ID":"20240611130610-f5bj9za","Type":"NodeParagraph","Properties":{"id":"20240611130610-f5bj9za","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611130610-pzks4zx","Type":"NodeParagraph","Properties":{"id":"20240611130610-pzks4zx","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611130610-jg3vrdk","Type":"NodeParagraph","Properties":{"id":"20240611130610-jg3vrdk","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611130610-u4o8tsn","Type":"NodeParagraph","Properties":{"id":"20240611130610-u4o8tsn","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葛"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。春、秋采挖，洗净，除去外皮，切片，晒干或烘干。广东、福建等垃切片后，用盐水、白矾水或淘米水浸泡，再用硫黄熏后晒干，色较白净。"}]},{"ID":"20240611130610-2f9r2jd","Type":"NodeParagraph","Properties":{"id":"20240611130610-2f9r2jd","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611130610-pxkpqpz","Type":"NodeParagraph","Properties":{"id":"20240611130610-pxkpqpz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 生于山坡草丛中或路旁及较阴湿的地方。分布辽宁、河北、河南、山东、安徽、江苏、浙江、福建、台湾、广东、广西、江西、湖南、湖北、四川、贵州、云南、山西、陕西、甘肃等地。全国大部地区有产，主产河南、湖南、浙江、四川等地。"}]},{"ID":"20240611130610-0fipfyu","Type":"NodeParagraph","Properties":{"id":"20240611130610-0fipfyu","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611130610-x83471z","Type":"NodeParagraph","Properties":{"id":"20240611130610-x83471z","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 葛（《诗经》），又名：鸡齐（《本经》），絺绤草（《说文》），鹿藿、黄斤（《别录》），黄葛藤（《天宝本草》），野扁葛。"}]},{"ID":"20240611130610-1ljsdpd","Type":"NodeParagraph","Properties":{"id":"20240611130610-1ljsdpd","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"多年生藤本，长达10米，全株被黄褐色粗毛。块根肥厚。叶互生；具长柄；3出复叶，顶端小叶的柄较长，叶片菱状圆形，有时有3波状浅裂，长8～19厘米，宽6.5～18厘米，先端急尖，基部圆形，两面均被白色伏生短柔毛，下面较密；侧生小叶较小，偏椭圆形或偏菱状椭圆形，有时有2～3波状浅裂。总状花序腋生，总花梗密被黄白色绒毛；花密生；苞片狭线形，早落，小苞片线状披针形；蝶形花蓝紫色或紫色，长15～19厘米；花萼5齿裂，萼齿披针形；旗瓣近圆形或卵圆形，先端微凹，基部有两短耳，翼瓣狭椭圆形，较旗瓣短，通常仅一边的基部有耳，龙骨瓣较翼瓣稍长；雄蕊10，两体（9+1）；子房线形，花柱弯曲。荚果线形，扁平，长6～9厘米，宽7～10毫米，密被黄褐色的长硬毛。种子卵圆形而扁，赤褐色，有光泽。花期4～8月。果期8～10月。"}]},{"ID":"20240611130610-mnobkvt","Type":"NodeParagraph","Properties":{"id":"20240611130610-mnobkvt","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611130610-sov1okc","Type":"NodeParagraph","Properties":{"id":"20240611130610-sov1okc","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 干燥块根呈长圆柱形，药材多纵切或斜切成板状厚片，长短不等，约长20厘米左右，直径5～10厘米，厚0.7～1.3厘米。白色或淡棕色，表面有时可见残存的棕色外皮，切面粗糙，纤维性强。质硬而重，富粉性，并含大量纤维，横断面可见由纤维所形成的同心性环层，纵切片可见纤维性与粉质相间，形成纵纹。无臭，味甘。以块肥大、质坚实、色白、粉性足、纤维性少者为佳；质松、色黄、无粉性、纤维性多者质次。"}]},{"ID":"20240611130610-iv1s4f4","Type":"NodeParagraph","Properties":{"id":"20240611130610-iv1s4f4","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611130610-0rbuynu","Type":"NodeParagraph","Properties":{"id":"20240611130610-0rbuynu","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 葛根含异黄酮成分葛根素、葛根素木糖甙、大豆黄酮、大豆黄酮甙及β-谷甾醇、花生酸，又含多量淀粉（新鲜葛根中含量为19～20％）。"}]},{"ID":"20240611130610-xlhwkhz","Type":"NodeParagraph","Properties":{"id":"20240611130610-xlhwkhz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"甘葛藤的干根含淀粉37％。"}]},{"ID":"20240611130610-vnfutz1","Type":"NodeParagraph","Properties":{"id":"20240611130610-vnfutz1","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"三裂叶野葛藤的根部含淀粉15～20％。"}]},{"ID":"20240611130610-vto5p6y","Type":"NodeParagraph","Properties":{"id":"20240611130610-vto5p6y","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"从印度的同属植物的根中分离出葛根素、大豆黄酮、大豆黄酮甙、β-谷甾醇、4′，6″-二乙酰葛根素和豆甾醇。"}]},{"ID":"20240611130610-zykvz4b","Type":"NodeParagraph","Properties":{"id":"20240611130610-zykvz4b","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611130610-6bqwg3v","Type":"NodeParagraph","Properties":{"id":"20240611130610-6bqwg3v","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" ①对循环系统的作用"}]},{"ID":"20240611130610-ikma2c3","Type":"NodeParagraph","Properties":{"id":"20240611130610-ikma2c3","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"葛根中提出的黄酮能增加脑及冠状血管血流量。麻醉狗颈内动脉注射葛根黄酮后，脑血流量增加，血管阻力相应降低，作用维持2～20分钟，如静脉注射，则脑血流量增加较轻，也不能解除肾上腺素及去甲肾上腺素收缩脑血管的作用，但对高血压动脉硬化病人则能改善脑循环，其作用温和。葛根黄酮及葛根酒浸膏注射于狗的冠状动脉及静脉，均能使冠状血管血流量增加，血管阻力降低。给大鼠腹腔及皮下注射葛根酒浸膏和腹腔注射其水煎剂及葛根中提出的结晶，对垂体后叶素所引起的心脏缺血反应均有保护作用，葛根水煎剂口服对高血压狗无明显的降压作用。葛根（日本产）煎剂中据报道有兴奋和抑制心脏两种成分。"}]},{"ID":"20240611130610-9m5ii9g","Type":"NodeParagraph","Properties":{"id":"20240611130610-9m5ii9g","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②解痉作用"}]},{"ID":"20240611130610-i72adat","Type":"NodeParagraph","Properties":{"id":"20240611130610-i72adat","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"中国葛根（品种未注明）与日本市售葛根中均含天豆黄酮，对小鼠、豚鼠离体肠管具有罂粟碱样解痉作用，但中国产葛根较日本产者解痉作用强，可能与所含大且黄酮较多有关，此解痉成分能对抗组织胺及乙酰胆碱的作用；从日本产葛根中分离出之其他异黄酮类衍化物则无明显的扩乙酰胆碱作用。此外尚分离出肘肠管有收缩作用的物质，日本产葛根中提出之MTF-101有毒蕈碱样作用。"}]},{"ID":"20240611130610-4o1v3o0","Type":"NodeParagraph","Properties":{"id":"20240611130610-4o1v3o0","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③降血糖作用"}]},{"ID":"20240611130610-kmubn16","Type":"NodeParagraph","Properties":{"id":"20240611130610-kmubn16","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"葛根（品种未注明）煎剂给家兔口服，开始2小时血糖上升，随即下降，第3、4小时下降最低，对家兔肾上腺素性高血糖不仅无对抗作用，反而使之增高，但能促进血糖提早恢复正常。葛根水提取物也能使家兔血糖初上升后下降，对饥锇家兔升血糖作用更显著，乙醚提取物对糖代谢则无明显影响。"}]},{"ID":"20240611130610-3pv5953","Type":"NodeParagraph","Properties":{"id":"20240611130610-3pv5953","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"④解热及雌激素样作用"}]},{"ID":"20240611130610-xtuuwtx","Type":"NodeParagraph","Properties":{"id":"20240611130610-xtuuwtx","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"日本产葛根浸剂对人工发热家兔有明显解热作用，维持4～5小时之久。葛根能增加未成熟小鼠子宫的重量，有雌激素样作用。此作用之有效成分为大豆黄酮。"}]},{"ID":"20240611130610-lryw3ec","Type":"NodeParagraph","Properties":{"id":"20240611130610-lryw3ec","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611130610-uj5bhkg","Type":"NodeParagraph","Properties":{"id":"20240611130610-uj5bhkg","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 葛根：拣去杂质，洗净，用水浸泡，捞出，润透，及时切片，晒干。煨葛根：先以少量麸皮撒入热锅内，待冒烟后，将葛根片倒入，上面覆盖剩下的麸皮，煨至下层麸皮呈焦黄色时.随即以铁铲将葛根与麸皮不断翻动，至葛根片呈深黄色为匿，取出，筛去麸皮，凉透。（每葛根100斤，麸皮25斤）"}]},{"ID":"20240611130610-xg58p0w","Type":"NodeParagraph","Properties":{"id":"20240611130610-xg58p0w","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"《品汇精要》：\"葛根，刮去皮或捣汁用。\""}]},{"ID":"20240611130610-1zz793e","Type":"NodeParagraph","Properties":{"id":"20240611130610-1zz793e","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611130610-6rfe0yc","Type":"NodeParagraph","Properties":{"id":"20240611130610-6rfe0yc","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240611130610-7vvi9ce","Type":"NodeParagraph","Properties":{"id":"20240611130610-7vvi9ce","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"①张元素：\"通行足阳明经。\""}]},{"ID":"20240611130610-kqambwe","Type":"NodeParagraph","Properties":{"id":"20240611130610-kqambwe","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"入胃，又入肺。\""}]},{"ID":"20240611130610-j339x2d","Type":"NodeParagraph","Properties":{"id":"20240611130610-j339x2d","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入胃，兼入脾。\""}]},{"ID":"20240611130610-3apmf5c","Type":"NodeParagraph","Properties":{"id":"20240611130610-3apmf5c","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"④《要药分剂》：\"入胃、膀胱二经，兼入脾经。\""}]},{"ID":"20240611130610-8n69b7z","Type":"NodeParagraph","Properties":{"id":"20240611130610-8n69b7z","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611130610-rapabf8","Type":"NodeParagraph","Properties":{"id":"20240611130610-rapabf8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 甘辛，平。"}]},{"ID":"20240611130610-ev3rlva","Type":"NodeParagraph","Properties":{"id":"20240611130610-ev3rlva","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240611130610-aiktr1u","Type":"NodeParagraph","Properties":{"id":"20240611130610-aiktr1u","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。生根汁，大寒。\""}]},{"ID":"20240611130610-2nima8u","Type":"NodeParagraph","Properties":{"id":"20240611130610-2nima8u","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘辛，平，无毒。\""}]},{"ID":"20240611130610-wlqy9do","Type":"NodeParagraph","Properties":{"id":"20240611130610-wlqy9do","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611130610-6hn1iyp","Type":"NodeParagraph","Properties":{"id":"20240611130610-6hn1iyp","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" ①张元素：\"不可多服，恐损胃气。\""}]},{"ID":"20240611130610-mzdquro","Type":"NodeParagraph","Properties":{"id":"20240611130610-mzdquro","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②《本草正》：\"其性凉，易于动呕，胃寒者所当慎用。\""}]},{"ID":"20240611130610-vcedc01","Type":"NodeParagraph","Properties":{"id":"20240611130610-vcedc01","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"夏日表虚汗多尤忌。\""}]},{"ID":"20240611130610-zitp2ep","Type":"NodeParagraph","Properties":{"id":"20240611130610-zitp2ep","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611130610-tniu46w","Type":"NodeParagraph","Properties":{"id":"20240611130610-tniu46w","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 升阳解肌，透疹止泻，除烦止温。治伤寒、温热头痛项强，烦热消渴，泄泻，痢疾，癍疹不透，高血压，心绞痛，耳聋。"}]},{"ID":"20240611130610-al6lo3d","Type":"NodeParagraph","Properties":{"id":"20240611130610-al6lo3d","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主消渴，身太热，呕吐，诸痹，起阴气，解诸毒。\""}]},{"ID":"20240611130610-u6hkd56","Type":"NodeParagraph","Properties":{"id":"20240611130610-u6hkd56","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗伤寒中风头痛，解肌，发表，出汗，开腠理。疗金疮，止痛，胁风痛。\"\"生根汁，疗消渴，伤寒壮热。\""}]},{"ID":"20240611130610-eeb79n2","Type":"NodeParagraph","Properties":{"id":"20240611130610-eeb79n2","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③《本草经集注》：\"杀野葛、巴豆、百药毒。\""}]},{"ID":"20240611130610-xnjhu8h","Type":"NodeParagraph","Properties":{"id":"20240611130610-xnjhu8h","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"④陶弘景：\"生者捣取汁饮之，解温病发热。葛根为屑，疗金疮断血，亦疗疟及疮。\""}]},{"ID":"20240611130610-37iblsy","Type":"NodeParagraph","Properties":{"id":"20240611130610-37iblsy","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑤《药性论》：\"治天行上气，呕逆，开胃下食，主解酒毒，止烦渴。熬屑治金疮，治时疾解热。\""}]},{"ID":"20240611130610-rby83n8","Type":"NodeParagraph","Properties":{"id":"20240611130610-rby83n8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑥《唐本草》：\"末服之，主猘狗啮，并饮其汁良。\""}]},{"ID":"20240611130610-0implzz","Type":"NodeParagraph","Properties":{"id":"20240611130610-0implzz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑦《本草拾遗》：\"生者破血，合疮，堕胎，解酒毒，身热赤，酒黄，小便赤涩。\""}]},{"ID":"20240611130610-kt18mhz","Type":"NodeParagraph","Properties":{"id":"20240611130610-kt18mhz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑧《日华子本草》：\"治胸膈热，心烦闷热狂，止血痢，通小肠，排脓破血，敷蛇虫啮。\""}]},{"ID":"20240611130610-qr5yixk","Type":"NodeParagraph","Properties":{"id":"20240611130610-qr5yixk","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑨《开宝本草》：\"小儿热痞，以葛根浸捣汁饮之。\""}]},{"ID":"20240611130610-k72dkd6","Type":"NodeParagraph","Properties":{"id":"20240611130610-k72dkd6","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑩《医学启原》：\"除脾胃虚热而渴。\""}]},{"ID":"20240611130610-zsrm3fm","Type":"NodeParagraph","Properties":{"id":"20240611130610-zsrm3fm","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑾张元素：\"发散表邪，发散小儿疮疹难出。\""}]},{"ID":"20240611130610-9grodmv","Type":"NodeParagraph","Properties":{"id":"20240611130610-9grodmv","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑿《纲目》：\"散郁火。\""}]},{"ID":"20240611130610-hf7fcgw","Type":"NodeParagraph","Properties":{"id":"20240611130610-hf7fcgw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611130610-fekuf4b","Type":"NodeParagraph","Properties":{"id":"20240611130610-fekuf4b","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或捣汁。外用：捣敷。"}]},{"ID":"20240611130610-21oeo6h","Type":"NodeParagraph","Properties":{"id":"20240611130610-21oeo6h","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611130610-srlv3l5","Type":"NodeParagraph","Properties":{"id":"20240611130610-srlv3l5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" ①治大阳病，项背强几几，无汗恶风：葛根四两，麻黄三两（去节），桂枝二两（去皮），生姜三两（切），甘草二两（炙），芍药二两，大枣十二枚（擘）。上七味，以水一斗，先煮麻黄、葛根，减二升，去白沫，纳诸药，煮取三升，去渣，温服一升，覆取微似汗。（《伤寒论》葛根汤）"}]},{"ID":"20240611130610-g25tmod","Type":"NodeParagraph","Properties":{"id":"20240611130610-g25tmod","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②治太阳病，桂枝证，医反下之，利遂不止，脉促（表未解也），喘而汗出：葛根半斤，甘草二两（炙），黄芩三两，黄连三两。上四味，以水八升，先煮葛根，减二升，纳诸药，煮取二升，去滓，分温再服。（《伤寒论》葛根黄芩黄连汤）"}]},{"ID":"20240611130610-m2vh91z","Type":"NodeParagraph","Properties":{"id":"20240611130610-m2vh91z","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③治伤寒温疫，风热壮热，头痛、肢体痛，疮疹已发未发：升麻、干葛（细锉）、芍药、甘草（锉，炙）各等分。同为粗末，每服四钱，水一盏半，煎至一盏，量大小与之，温服无时。（《阎氏小儿方》升麻葛根汤）"}]},{"ID":"20240611130610-7ntkw4r","Type":"NodeParagraph","Properties":{"id":"20240611130610-7ntkw4r","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"④治癍疹初发，壮热，点粒未透：葛根、升麻、桔梗、前胡、防风各一钱，甘草五分。水煎服。（《全幼心鉴》）"}]},{"ID":"20240611130610-jdc8h7r","Type":"NodeParagraph","Properties":{"id":"20240611130610-jdc8h7r","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑤治热毒下血，或因吃热物发动：生葛根二斤，捣取汁一升，并藕汁一升，相和服。（《梅师集验方》）"}]},{"ID":"20240611130610-4y7uzwy","Type":"NodeParagraph","Properties":{"id":"20240611130610-4y7uzwy","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑥治心热吐血不止：生葛根汁半大升，顿服。（《广利方》）"}]},{"ID":"20240611130610-85ke8i0","Type":"NodeParagraph","Properties":{"id":"20240611130610-85ke8i0","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑦治鼻衄，终日不止，心神烦闷：生葛根，捣取汁，每服一小盏。（《圣惠方》）"}]},{"ID":"20240611130610-wyuw2nm","Type":"NodeParagraph","Properties":{"id":"20240611130610-wyuw2nm","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑧治妊娠热病心闷：葛根汁二升，分作三服。（《伤寒类要》）"}]},{"ID":"20240611130610-p4bwc01","Type":"NodeParagraph","Properties":{"id":"20240611130610-p4bwc01","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑨治卒干呕不息：捣葛根，绞取汁，服一升差。（《补缺肘后方》）"}]},{"ID":"20240611130610-3cnm2di","Type":"NodeParagraph","Properties":{"id":"20240611130610-3cnm2di","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑩治酒醉不醒：葛根汁一斗二升，饮之，取醒，止。（《千金方》）"}]},{"ID":"20240611130610-7d2946r","Type":"NodeParagraph","Properties":{"id":"20240611130610-7d2946r","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑾治食诸菜中毒，发狂烦闷；吐下欲死：煮葛根饮汁。（《补缺肘后方》）"}]},{"ID":"20240611130610-fo4n1vw","Type":"NodeParagraph","Properties":{"id":"20240611130610-fo4n1vw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑿治服药失度，心中苦烦：饮生葛根汁大良。无生者，干葛为末，水服五合，亦可煮服之。（《补缺肘后方》）"}]},{"ID":"20240611130610-pwn9n6m","Type":"NodeParagraph","Properties":{"id":"20240611130610-pwn9n6m","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⒀治急性肠梗阻：葛根、皂角各1斤，加水4000毫升，煎煮40分钟，去渣，置药汁锅于火炉上保持适当温度（以不致烫伤为度）。另以1市尺见方之10层纱布垫4块，浸以药液后，稍稍除去水分，交替置腹部作持续热敷，每次1小时，每天2至3次。（《河南医学院学报》9（4）：203，1965）"}]},{"ID":"20240611130610-75x0wdh","Type":"NodeParagraph","Properties":{"id":"20240611130610-75x0wdh","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⒁治金疮中风，痉欲死：捣生葛根一斤，细切，以水一斗，煮取五升，去滓，取一升服，若干者，捣末，温酒调三指撮，若口噤不开，但多服竹沥，又多服生葛根自愈，食亦妙。（《肘后方》）"}]},{"ID":"20240611130610-bgbtcfv","Type":"NodeParagraph","Properties":{"id":"20240611130610-bgbtcfv","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（15）伤寒（初觉头痛，内热脉洪）。用葛根四两，加水两升、豉一升，同煮成半升服。加生姜汁更好。"}]},{"ID":"20240611130610-mrcuqrn","Type":"NodeParagraph","Properties":{"id":"20240611130610-mrcuqrn","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（16）烦躁热渴。用葛粉四两，拌入泡过粟米一夜的水中，煮熟，加米汤同服。"}]},{"ID":"20240611130610-65rj0f8","Type":"NodeParagraph","Properties":{"id":"20240611130610-65rj0f8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（17）疖子初起。用葛蔓烧灰，水调敷涂。"}]},{"ID":"20240611130610-4jqqd1x","Type":"NodeParagraph","Properties":{"id":"20240611130610-4jqqd1x","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611130610-nhkwknn","Type":"NodeParagraph","Properties":{"id":"20240611130610-nhkwknn","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" ①治疗高血压病颈项强痛"}]},{"ID":"20240611130610-bfia00q","Type":"NodeParagraph","Properties":{"id":"20240611130610-bfia00q","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"根据用葛根治疗外感病项背强痛的经验，试用于治疗高血压病的颈项强痛，亦取得疗效。㈠煎剂：10～15克/日，煎分2次服，连服2～8周。观察52例，颈项强痛消失17例，明显减轻30例。㈡总黄酮：每日量100毫克，两次分服，疗程同上。治疗40例，项痛消失9例，明显减轻27例。同时对高血压病的头痛、头晕、耳鸣及肢麻等症状也有一定改善作用，但降压不明显。多数患者在用药第1周即可出现疗效，作用持续1～2周。无明显副作用。"}]},{"ID":"20240611130610-e682ahf","Type":"NodeParagraph","Properties":{"id":"20240611130610-e682ahf","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②治疗冠心病心绞痛"}]},{"ID":"20240611130610-q3bi4ll","Type":"NodeParagraph","Properties":{"id":"20240611130610-q3bi4ll","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"用葛根酒浸膏片每日6～12片，分2～3次服，总疗程4～22周。治疗冠心病心绞痛71例，对心绞痛症状显效29例，改善20例，基本无效22例。心电图有效率为41.3％，血清胆甾醇及β-脂蛋白在服药期间无明显变化。又据75例用酒浸膏片（每片含葛甙100毫克，每日量900～1200毫克，少数用至1600毫克；13例加用葛根注射液，每日2～4毫升，每毫升含黄酮200毫克）治疗2～9个月的结果，心绞痛的有效率为86.7％，其中显效率为36％，心电图的好转率为44.4％。一般在1个月左右生效，2个月疗效较明显，此后疗效与疗程并不成正比，加用葛根注射液可提高部分患者疗效。对缓解憋气的效果较差。胆甾醇治疗前后有显著差异性，但可能是受季节、饮食等改变所影响，因此本品是否能降低胆甾醇尚待研究。还有用葛根糖浆（每毫升相当生药1克）每次20毫升，日服3次，疗程4～12周，观察19例。用药后6例症状消失或基本消失，8例心绞痛发作次数、程度及持续时间均有明显减轻，无效5例。生效时间多在服药后1～2周。疗程达8周或以上者疗效较好。心电图复查，显效5例，好转5例，无效9冽。血清胆甾醇检查有10例明显降低，但对血压无明显影响。治疗中除1例胃溃疡患者于服药第1周内有轻度腹胀及上腹部不适外，未见明显副作用。"}]},{"ID":"20240611130610-vg2syhe","Type":"NodeParagraph","Properties":{"id":"20240611130610-vg2syhe","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③治疗眼底病"}]},{"ID":"20240611130610-6hbaugw","Type":"NodeParagraph","Properties":{"id":"20240611130610-6hbaugw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"用葛根黄酮注射液（每毫升含黄酮40毫克）局部注射。一般均采用结膜下注射法，遇局部反应重时，可交替使用球后注射法。前者每次0.2～0.4毫升，后者每次0.3～0.5毫升。初次宜用小剂量，以后可渐增。每周注射2次，2周一疗程。病程超过半年者可加用胎盘组织液肌肉注射；视神经萎缩病例加用维生素B1肌注。尽量不与激素同用。共观察中央性视网膜炎35例，痊愈26例，显效5例，进步1例，无效3例。视神经萎缩12例，显效6例，进步2例，无效4例。妊娠毒血症视网膜病变2例均无效。陈旧性脉络膜炎3例，视网膜中央动脉栓塞、视网膜剥离手术后各1例，均有进步。黄斑发育不良及高度近视合并黄斑变性各1例均无效。葛根黄酮对因视网膜血管痉挛引起的中央性视网膜炎的疗效比较显著，治疗不能少于4次，视力恢复正常或病变已经吸收后，可以本品肌肉注射或片剂内服以巩固疗效，防止复发。"}]},{"ID":"20240611130610-gchinp8","Type":"NodeParagraph","Properties":{"id":"20240611130610-gchinp8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"④治疗早期突发性耳聋"}]},{"ID":"20240611130610-wudogfe","Type":"NodeParagraph","Properties":{"id":"20240611130610-wudogfe","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"日服葛根（总黄酮体）2～3次，每次20毫克；同时配合复合维生素B口服。观察33例，年龄15～64岁。根据EAG（电听阈曲线）和症状判断疗效，痊愈9例，显效6例，进步9例，无效9例。"}]},{"ID":"20240611130610-3g54bsd","Type":"NodeParagraph","Properties":{"id":"20240611130610-3g54bsd","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611130610-fwi7bn7","Type":"NodeParagraph","Properties":{"id":"20240611130610-fwi7bn7","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" ①张元素：\"用此（葛根）以断太阳入阳明之路，即非太阳药也，故仲景治太阳阳明合病，桂枝汤加麻黄、葛根也。又有葛根黄芩黄连解肌汤，是知葛根非太阳药，即阳明药。\"\"太阳初病，未入阳明，头痛者，不可便服葛根发之，若服之是引贼破家也，若头颅痛者可服之。\""}]},{"ID":"20240611130610-uqt08i4","Type":"NodeParagraph","Properties":{"id":"20240611130610-uqt08i4","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"②李杲：\"干葛，其气轻浮，鼓舞胃气上行，生津液，又解肌热，治脾胃虚弱泄泻圣药也。\""}]},{"ID":"20240611130610-0wvbuni","Type":"NodeParagraph","Properties":{"id":"20240611130610-0wvbuni","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"本草十剂云，轻可去实，麻黄、葛根之属。盖麻黄乃太阳经药，兼入肺经，肺主皮毛；葛根乃阳明经药，兼入脾经，脾主肌肉。所以二味药皆轻扬发散，而所入迥然不同也。\""}]},{"ID":"20240611130610-vwlnfs5","Type":"NodeParagraph","Properties":{"id":"20240611130610-vwlnfs5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"葛根，解散阳明温病热邪主要药也，故主消渴，身大热，热壅胸膈作呕吐。发散而升，风药之性也，故主诸痹。\"\"伤寒头痛兼项强腰脊痛，及遍身骨疼者，足太阳也，邪犹未入阳明，故无渴证，不宜服。\""}]},{"ID":"20240611130610-kqax5wm","Type":"NodeParagraph","Properties":{"id":"20240611130610-kqax5wm","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑤《本草汇言》：\"葛根，清风寒，净表邪，解肌热，止烦渴。泻胃火之药也。尝观发表散邪之药，其品亦多，如麻黄拔太阳营分之寒，桂枝解太阳卫分之风，防风、紫苏散太阳在表之风寒，藁本、羌活散太阳在表之寒湿，均称发散药也，而葛根之发散，亦入太阳，亦散风寒，又不同矣，非若麻、桂、苏、防，辛香温燥，发散而又有损中气之误也；非若藁本、羌活，发散而又有耗营血之虞也。《神农经》谓起阴气，除消渴，身太热，明属三阳表热无寒之邪，能散之清之之意也如伤风伤寒，温病热病，寒邪已去，标阳已炽，邪热伏于肌腠之间，非表非里，又非半表半里，口燥烦渴，仍头痛发热者，必用葛根之甘寒，清肌退热可也，否则舍葛根而用辛温（如麻、桂、苏、防之类），不惟疏表过甚，而元气虚，必致多汗亡阳矣。然而葛根之性专在解肌．解肌而热自退，渴自止，汗自收。而本草诸书又言能发汗者，非发三阳寒邪在表之汗也，又非发风温在经之汗也，实乃发三阳寒郁不解，郁极成热之汗也。又如太阳汗出不彻、阳气怫郁，其人面色缘缘正赤，躁烦不知痛之所在，短气．更发汗以愈，宜葛根汤治之，郁解热除，汗出而邪自退，此所以本草诸书言发汗者此也。\""}]},{"ID":"20240611130610-gmmt7np","Type":"NodeParagraph","Properties":{"id":"20240611130610-gmmt7np","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑥《本草正》：\"葛根，用此者，用其凉散，虽善达诸阳经，而阳明为最，以其气轻，故善解表发汗。凡解散之药多辛热，此独凉而甘，故解温热时行疫疾，凡热而兼渴者，此为最良．当以为君，而佐以柴、防、甘、桔。\""}]},{"ID":"20240611130610-t27ik04","Type":"NodeParagraph","Properties":{"id":"20240611130610-t27ik04","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑦《药品化义》：\"葛根，根主上升，甘主散表，若多用二、三钱，能理肌肉之邪，开发腠理而出汗，属足阳明胃经药，治伤寒发热，鼻干口燥，目痛不眠，疟疾热重。盖麻黄、紫苏专能攻表，而葛根独能解肌耳。因其性味甘凉，能鼓舞胃气，若少用五、六分，治胃虚热渴，酒毒呕吐，胃中郁火，牙疼口臭。或佐健脾药，有醒脾之力。且脾主肌肉，又主四肢，如阳气郁遏于脾胃之中，状非表症，饮食如常，但肌表及四肢发热如火，以此同升麻、柴胡、防风、羌活，升阳散火，清肌退热，薛立斋常用剂也。若金疮、若中风、若痉病以致口噤者，捣生葛根汁，同竹沥灌下即醒，干者为末，酒调服亦可。痘疮难出，以此发之甚捷。\""}]},{"ID":"20240611130610-92ot87y","Type":"NodeParagraph","Properties":{"id":"20240611130610-92ot87y","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑧《本经逢原》：\"葛根轻浮，生用则升阳生津，熟用则鼓舞胃气，故治胃虚作渴，七味白术散用之。又清暑益气汤兼黄柏用者，以暑伤阳明，额颅必胀，非此不能开发也。\""}]},{"ID":"20240611130610-jzvkxz8","Type":"NodeParagraph","Properties":{"id":"20240611130610-jzvkxz8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑨《本经疏证》：\"葛根之用，妙在非徒如栝蒌但浥阴津，亦非徒如升麻但升阳气，而能兼擅二者之长，故太阳阳明合病，自下利者（葛根汤证），太阳被下，利遂不止，脉促喘汗者（葛根芩连汤证）咸用之。盖两者之利，为阳盛于外，不与阴交，阴遂不固而下溜，起其阴气，使与阳泱，得曳以上行，则非但使利止，并能使阳之遏于外者，随胃阳鼓荡面散矣。\""}]},{"ID":"20240611130610-whigwyr","Type":"NodeParagraph","Properties":{"id":"20240611130610-whigwyr","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑩《药盦医学丛书》：\"葛根，斑疹为必用之药，亦并非巳见点不可用，痧麻均以透达为主，所惧者是陷，岂有见点不可用之理?惟无论痧麻，舌绛且干者，为热入营分，非犀角、地黄不办，误用葛根，即变证百出，是不可不知也。又凡伤寒阳明症已见，太阳未罢，得葛根良。太阳已罢，纯粹阳明经症，得葛根亦良。惟温病之属湿温及伏暑、秋邪者不适用，此当于辨症加之注意。若一例横施，伏暑、秋邪得此，反见白瘖，则用之不当之为害也。\""}]},{"ID":"20240611130610-1ly5xtw","Type":"NodeParagraph","Properties":{"id":"20240611130610-1ly5xtw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"⑾《本草正义》：\"葛根，气味皆薄，最能升发脾胃清阳之气，《伤寒论》以为阳明主药，正惟表寒过郁于外，胃家阳气不能散布，故以此轻扬升举之药，捷动清阳，捍御外寒，斯表邪解而胃阳舒展，所以葛根汤中仍有麻黄，明为阳明表寒之主药，非阳明里热之专司，若已内传而为阳明热症，则仲景自有白虎诸法，非葛根汤之所宜用。其葛根黄芩黄连汤方，则主阳明协热下利，貌视之．颇似专为里有实热而设，故任用芩、连之苦寒，则葛根似亦为清里之品；抑知本条为太阳病桂枝证医反下之之变，邪热因误下而入里，里虽宜清，而利遂不止．即以脾胃清阳下陷之侯，葛根只以升奉陷下之气，并非为清里而设，此皆仲师选用葛根之真旨。由此推之，而知《本经》之主消渴者，亦以燥令太过，降气迅速，故虽饮多而渴不解，此药治之，非特润燥，亦以升清。又主呕吐者，亦以胃气不能敷布，致令食不得入，非可概治胃火上逆之呕吐。而仅知为清胃生津、甘润退热之普通药剂，则似是实非，宁独毫厘之差，真是千里之谬矣。\""}]},{"ID":"20240611130610-9jjzycz","Type":"NodeParagraph","Properties":{"id":"20240611130610-9jjzycz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611130610-9ca838x","Type":"NodeParagraph","Properties":{"id":"20240611130610-9ca838x","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 除上述正品外，尚有同属植物食用葛藤、峨嵋葛藤、甘葛藤、三裂叶野葛藤等的块根，在少数地区亦作葛根使用。"}]},{"ID":"20240611130610-npvhr96","Type":"NodeParagraph","Properties":{"id":"20240611130610-npvhr96","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611130610-r2u7gmj","Type":"NodeParagraph","Properties":{"id":"20240611130610-r2u7gmj","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611130610-2zphkuv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130610-2zphkuv","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"《中华本草》：葛根"}]},{"ID":"20240611130610-tzi2j3s","Type":"NodeParagraph","Properties":{"id":"20240611130610-tzi2j3s","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611130610-llen1kp","Type":"NodeParagraph","Properties":{"id":"20240611130610-llen1kp","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" Gě Gēn"}]},{"ID":"20240611130610-0lsw1xt","Type":"NodeParagraph","Properties":{"id":"20240611130610-0lsw1xt","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611130610-87jvpwj","Type":"NodeParagraph","Properties":{"id":"20240611130610-87jvpwj","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 干葛、甘葛、粉葛、葛葛根、葛麻茹、葛子根、葛条根、鸡齐根。"}]},{"ID":"20240611130610-x5ucbvg","Type":"NodeParagraph","Properties":{"id":"20240611130610-x5ucbvg","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611130610-aeh0t3v","Type":"NodeParagraph","Properties":{"id":"20240611130610-aeh0t3v","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" Root of Lobed Kudzuvine,Root of Thomson Kudzuvine,Kudzuvine Root，PUERARAE"}]},{"ID":"20240611130610-rfwhgfm","Type":"NodeParagraph","Properties":{"id":"20240611130610-rfwhgfm","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611130610-hkjjuyw","Type":"NodeParagraph","Properties":{"id":"20240611130610-hkjjuyw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611130610-qxqsah3","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611130610-qxqsah3","updated":"20240611130610"},"Children":[{"ID":"20240611130610-brk0h6j","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611130610-brk0h6j","updated":"20240611130610"},"Children":[{"ID":"20240611130610-v8r5fyq","Type":"NodeParagraph","Properties":{"id":"20240611130610-v8r5fyq","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"陶弘景：葛根，人皆蒸食之，当取入土深大者，被面日干之。南康、庐陵间最胜，多肉而少筋，甘美，但为药用之，不及此间尔。"}]}]}]},{"ID":"20240611130610-nhijyj2","Type":"NodeParagraph","Properties":{"id":"20240611130610-nhijyj2","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：葛虽除毒，其根入土五、六寸已上者名葛DUAN，颈也，服之令人吐，以有微毒也。"}]},{"ID":"20240611130610-xpr0dyd","Type":"NodeParagraph","Properties":{"id":"20240611130610-xpr0dyd","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"3.《滇南本草》：葛根，味甜者甘葛，味苦者苦葛。"}]},{"ID":"20240611130610-vi6ckc5","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611130610-vi6ckc5","updated":"20240611130610"},"Children":[{"ID":"20240611130610-zd6s7ag","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240611130610-zd6s7ag","updated":"20240611130610"},"Children":[{"ID":"20240611130610-94xfffz","Type":"NodeParagraph","Properties":{"id":"20240611130610-94xfffz","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"苦葛根为同属植物云南葛根 Pueraria peduncularis Grah．("}]}]}]},{"ID":"20240611130610-86kz5yk","Type":"NodeParagraph","Properties":{"id":"20240611130610-86kz5yk","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611130610-c70d4qj","Type":"NodeParagraph","Properties":{"id":"20240611130610-c70d4qj","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物野葛或甘葛藤的块根。"}]},{"ID":"20240611130610-n6cberw","Type":"NodeParagraph","Properties":{"id":"20240611130610-n6cberw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Pueraria lobata （Willd.）Ohwi [P.thunbergiana（Sieb.et Zucc.）Benth.；P.hirsuta（Thunb.）Scheneid.；P.pseudohirsuta Tang et Wang]2.Pueraria thomsonii Benth."}]},{"ID":"20240611130610-6wwd6je","Type":"NodeParagraph","Properties":{"id":"20240611130610-6wwd6je","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培3-4年采挖，在冬季叶片枯黄后到发芽前进行。把块根挖出，去掉藤蔓，切下根头作种，除去泥沙，刮去粗皮，切成1.5-2cm厚的斜片，晒干或烘干。广东、福建等地切片后，用盐水、白矾水或淘米水浸泡，再用硫黄熏后晒干，色较白净。"}]},{"ID":"20240611130610-sg3qoze","Type":"NodeParagraph","Properties":{"id":"20240611130610-sg3qoze","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611130610-mhsvsli","Type":"NodeParagraph","Properties":{"id":"20240611130610-mhsvsli","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡、路边草丛中及较阴湿的地方。"}]},{"ID":"20240611130610-9usk3qx","Type":"NodeParagraph","Properties":{"id":"20240611130610-9usk3qx","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.栽培或野生于山野灌丛和疏林中。"}]},{"ID":"20240611130610-6eafho8","Type":"NodeParagraph","Properties":{"id":"20240611130610-6eafho8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"资源分布：1.除新疆、西藏外，全国各地均有分布。"}]},{"ID":"20240611130610-bs6jwvo","Type":"NodeParagraph","Properties":{"id":"20240611130610-bs6jwvo","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.分布于广东、广西、四川、云南等地。"}]},{"ID":"20240611130610-c1yqqju","Type":"NodeParagraph","Properties":{"id":"20240611130610-c1yqqju","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611130610-7x1o3bt","Type":"NodeParagraph","Properties":{"id":"20240611130610-7x1o3bt","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 1.野葛 多年生落叶藤本，长达10m。全株被黄褐色粗毛。块根圆柱状，肥厚，外皮灰黄色，内部粉质，纤维性很强。茎基部粗壮，上部多分枝。三出复叶；顶生小叶柄较长；叶片菱状圆形，长5.5-19cm，宽4.5-18cm，先端渐尖，基部圆形，有时浅裂，侧生小叶较小，斜卵形，两边不等，背面苍白色，有粉霜，两面均被白色伏生短柔毛；托叶盾状着生，卵状长椭圆形，小托叶针状。总状花序腋生或顶生，花冠蓝紫色或紫色；苞片狭线形，早落，小苞片卵形或披针形；萼钟状，长0.8-1cm，萼齿5，披针形，上面2齿合生，下面1齿较长；旗瓣近圆形或卵圆形，先端微凹，基部有两短耳，翼辩狭椭圆形，较旗瓣短，常一边的基部有耳，龙骨瓣较翼瓣稍长；雄蕊10，二体；子房线形，花柱弯曲。荚果线形，长6-9cm，宽7-10mm，密被黄褐色长硬毛。种子卵圆形，赤褐色，有光泽。花期4-8月，果期8-10月。"}]},{"ID":"20240611130610-4sgt89l","Type":"NodeParagraph","Properties":{"id":"20240611130610-4sgt89l","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.甘葛藤 藤本。根肥大。茎枝被黄褐色短毛或杂有长硬毛。三出复叶，具长柄；托叶披针状长椭圆形，有毛；小叶片菱状卵形至宽卵形，有时3裂，长9-21cm，宽8-18cm，先端短渐尖，基部图形。总状花序腋生；小苞片卵形；花萼钟状，长1.2-1.5cm，萼齿5，披针形，较萼筒长，被黄色长硬毛；花冠紫色，长1.3-1.8cm。荚果长椭圆形，扁平；长10-12cm，宽1-1。2cm，密被黄褐色长硬毛。种子肾形或圆形。花期6-9月，果期8-10月。"}]},{"ID":"20240611130610-0gou6ye","Type":"NodeParagraph","Properties":{"id":"20240611130610-0gou6ye","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611130610-j622kwg","Type":"NodeParagraph","Properties":{"id":"20240611130610-j622kwg","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 生物学特性 适应性强，在向阳湿润的荒坡、林边都可栽培。土壤以深厚、肥沃、疏松的夹沙土较好。"}]},{"ID":"20240611130610-p6hqa4h","Type":"NodeParagraph","Properties":{"id":"20240611130610-p6hqa4h","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"栽培技术 用扦插、根头、压条、种子等方法繁殖，但以扦插和根头繁殖为常用。扦插繁殖：在冬季采挖葛根时，把较粗大的藤子割下，剪去头尾，选取中间健壮部分，剪成长33cm的短段，每段有2-3个芽，埋于湿润的细沙中，堆藏阴凉湿润处，清明前后发芽时，取出栽种，按行殊距各0.6-1m开窝，施堆肥或木灰，每窝栽插条2-3根。根头繁殖：在采挖时，把葛根头切下10-12cm作种，随挖随栽，每窝栽种1株。"}]},{"ID":"20240611130610-pd2rol1","Type":"NodeParagraph","Properties":{"id":"20240611130610-pd2rol1","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"田间管理 栽后第1年松窝3次，第五次在出苗后，第2次在6-7月，第3次在冬季落叶后。以后每年只进行2次，第1次在早春发芽时，第2次在冬季落叶后。在每次中除后，施追肥三次，肥料以人畜粪水为主。当茎藤长约65cm时要摘去顶芽，以促使多发侧藤，有利块根生长。"}]},{"ID":"20240611130610-xd7p5ri","Type":"NodeParagraph","Properties":{"id":"20240611130610-xd7p5ri","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"病虫害防治 金金龟子，咬食叶片，可用90 ％晶体敌百虫1000倍波喷叶面防治。斑螫，咬食花瓣，可于露水未干时，捕捉，晒干作药用。"}]},{"ID":"20240611130610-1cvd521","Type":"NodeParagraph","Properties":{"id":"20240611130610-1cvd521","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611130610-m4jfj8p","Type":"NodeParagraph","Properties":{"id":"20240611130610-m4jfj8p","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）野葛根完整的多呈圆柱形。商品常为斜切、纵切、横切的片块，大小不等。表面褐色，具纵皱纹，可见横向皮孔和不规则的须根痕。质坚实，断面粗糙，黄白色，隐约可见l-3层同心环层。纤维性强，略具粉性。气微、味微甜。"}]},{"ID":"20240611130610-pma3lry","Type":"NodeParagraph","Properties":{"id":"20240611130610-pma3lry","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（2）粉葛根呈圆柱形、类纺锤形或半圆柱形，有的为纵切或斜切的厚片，大小不一。除去外皮的表面黄白色或淡黄色，未去外皮的呈灰棕色。质坚硬而重，纤维性较弱，有的呈绵毛状，富粉性。以块大、质坚实、色白、粉性足、纤维少为佳。"}]},{"ID":"20240611130610-xhtdw3n","Type":"NodeParagraph","Properties":{"id":"20240611130610-xhtdw3n","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：（l）野葛根木栓层为多列木栓细胞。栓内层为4-5列细胞，排列紧密，外侧细胞含有少量草酸钙方晶，内侧偶见石细胞，石细胞类方形、类椭圆形或不规则形，直径32-66μm，壁厚。异形维管束排列形成1-3个同心环。射线较窄，4-5列细胞，韧皮部与木质部径向宽度之比为1：1-2，韧皮部具少数分泌细胞，内含红棕色块状物，形成切向不规则的条状，晶鞘纤维众多。木质部导管密集，径向辐射状排列，直径38-115μm。晶鞘纤维众多。薄壁细胞中充满淀粉粒。"}]},{"ID":"20240611130610-m7lytig","Type":"NodeParagraph","Properties":{"id":"20240611130610-m7lytig","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（2）粉葛根皮层内侧石细胞偶见，类长方形、类方形，直径25-74μm，壁薄，纹孔清晰。异形维管束排列成3-5个同心环。韧皮部与木质部宽度之比为1：8-10。木质部大部为薄壁细胞，导管及纤维束较少。导管直径26-127μm。薄壁细胞充满淀粉粒。"}]},{"ID":"20240611130610-v4oog6o","Type":"NodeParagraph","Properties":{"id":"20240611130610-v4oog6o","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611130610-3r3urxw","Type":"NodeParagraph","Properties":{"id":"20240611130610-3r3urxw","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 小鼠口服醇浸剂干粉10g及20g／kg，连服3天，未见毒性反应，口服醇浸剂2g／kg／天连续2月，实质性器官无病理改变。醇浸剂干粉静脉注射的半数致死量为2.1±0.12kg／kg。葛根素150mg／kg 对胎鼠无致畸作用，葛根素注射液对雄性生殖细胞无致突作用。"}]},{"ID":"20240611130610-u3zkhze","Type":"NodeParagraph","Properties":{"id":"20240611130610-u3zkhze","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611130610-qrb8c2z","Type":"NodeParagraph","Properties":{"id":"20240611130610-qrb8c2z","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 野葛根含大豆甙元（daidzein），大豆甙（daidzin），葛根素（puerarin），4＇-甲氧基葛根素（4’-methoxypuerarin），大豆甙元-4’，7-二葡萄糖甙（daidzein-4’，7-diglucoside），大豆甙元-7-（6-O-丙二酰基）-葡萄糖甙[daidzein-7-（6-O-malonyl）-lucoside]，染料木素（genistein），刺芒柄花素（for-mononetin），大豆甙元-8-C-芹菜糖基（l→6）-葡萄糖甙[daidzein-8-C-apiosyl（1→6）-glucoside]，染料木素-8-C-芹菜糖基（1→6）-葡萄糖甙[genistein-8-C-apiosyl（1→6）-glucoside]，葛根素木糖甙（puerarinxyloside，PG-2），3’-羟基葛根素（3’-hydroxypuerarin，PG-1），3’-甲氧基葛根素（3’-methoxypuerarin，PG-3），4’-O-葡萄糖基葛根素（4’-O-glucosyl puerarin，PG-6），葛根酚（puerarol），葛根甙（pueroside）A、B，刺芒柄花素-7-葡萄糖甙（formononetin-7-glucoside），羽扇烯酮（lupenone），β-谷甾醇（β-sitosterol），二十二烷酸（docosanoic acid），二十四烷酸（tetracosanoic acid），l-二十四烷酸甘油酯（glucerol-1-monotetracosanoate），尿囊素（allantoin），β-谷甾醇-β-D-葡萄糖甙（β-sitosteryl-β-D-glucoside），6，7-二甲氧基香豆精（6，7-dimethoxycoumarin），5-甲基海因（5-methylhydantoin）及以槐花二醇（sophoradiol），广东相思子三醇（cantoniensistriol），大豆皂醇（soyasapogenol）A、B ，葛根皂醇（kudzusapogenol）C、A和葛根皂醇B甲酯（kudzusapogenol B methylester）为甙元的三萜皂甙。葛藤亦含有大豆甙元，大豆甙，葛根素和β-谷甾醇。甘葛藤根含大豆甙，葛根素，4＇-甲氧基葛根素，大豆甙元及痕量大豆甙元-4，7＇-二葡萄糖甙。"}]},{"ID":"20240611130610-2fygmsa","Type":"NodeParagraph","Properties":{"id":"20240611130610-2fygmsa","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611130610-yru2o3d","Type":"NodeParagraph","Properties":{"id":"20240611130610-yru2o3d","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 1.对心血管的作用：1.1.对脑循环的影响：麻醉狗以电磁流量计直接测量脑动脉血流量，经颈动脉注射葛根总黄酮0.1-0.5mg/kg，脑血流量增加87.7%-134%，如股静脉注射总黄酮10-30mg/kg，脑血流量流量增加约20%；高血压病人肌内注射总黄酮200mg,约53%的病人脑血流量有改善，血管阻力和流入时间减少。"}]},{"ID":"20240611130610-iso6q4a","Type":"NodeParagraph","Properties":{"id":"20240611130610-iso6q4a","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"1.2.对冠脉循环的影响：以动脉导管插入麻醉狗左冠状动脉回旋支以测量冠脉血流量，经动脉注射总黄酮1-2mg/kg，血流量增加102%-120%，血管阻力下降50%，静脉注射也有一定有作用；乙醇浸膏的作用和总黄酮相似，葛根能治疗心绞痛可能与此有关。"}]},{"ID":"20240611130610-spopjux","Type":"NodeParagraph","Properties":{"id":"20240611130610-spopjux","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"1.3.对急性心肌缺血的保护作用：给大鼠腹腔或皮下注射葛根乙醇浸剂10g/kg对因静脉垂体后叶素引起的心肌缺血时的侧枝血流，并减少与心肌耗氧有关的血流动力学参数，这均有益于治疗心肌缺血。"}]},{"ID":"20240611130610-mzbb4a3","Type":"NodeParagraph","Properties":{"id":"20240611130610-mzbb4a3","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"1.4.对心脏收缩力和频率的影响：葛根素0.1、3μmol/L能阻断异丙肾上腺素对离体兔心房肌和豚鼠气管的正性变时性和负性变力性作用，对心房肌β1 受体的选择性强于对气管条的β2受体。但也有认为葛根素对α、β受体均无作用，其作用机制不是通过肾上腺素受体。"}]},{"ID":"20240611130610-2f8v0sf","Type":"NodeParagraph","Properties":{"id":"20240611130610-2f8v0sf","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"1.5.对微循环的影响：小鼠静脉注射葛根素52mg/kg可减轻局部滴注肾上腺素所致的肠系膜微动脉收缩、血液流速减慢和流量减少的微循环障碍。"}]},{"ID":"20240611130610-27yb0wa","Type":"NodeParagraph","Properties":{"id":"20240611130610-27yb0wa","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.对中枢神经的作用：2.1.解热作用：葛根醇浸剂2g/kg灌胃，对疫苗发热的兔有明显的解热作用。"}]},{"ID":"20240611130610-posm7rm","Type":"NodeParagraph","Properties":{"id":"20240611130610-posm7rm","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.2.改善学习记忆：葛根醇提物3.6g/kg灌胃，或葛根总黄酮1.5g/kg灌胃，对小鼠跳台法试验，均能对抗东莨菪碱所致小鼠记忆获得障碍及40%乙醇所致的记忆再现障碍，也对抗东莨菪碱降低小鼠大脑皮质和海马乙酰胆碱含量及海马胆碱乙酰转移酶的活性，这可能是葛根改善学习记忆的作用机制之一。"}]},{"ID":"20240611130610-x6f2wsf","Type":"NodeParagraph","Properties":{"id":"20240611130610-x6f2wsf","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"3.平滑肌解痉：大豆素对小鼠离体肠管有解痉作用，并对扩抗乙酰胆引起的痉挛，其作用与罂粟碱相仿，是为葛根的有效成分之一。"}]},{"ID":"20240611130610-1holnhe","Type":"NodeParagraph","Properties":{"id":"20240611130610-1holnhe","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611130610-79p8jk1","Type":"NodeParagraph","Properties":{"id":"20240611130610-79p8jk1","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 洗净，除去外皮，切片，晒干或烘干。广东、福建等地切片后，用盐水、白矾水或淘米水浸泡，再用硫黄熏后晒干，色较白净。切片，晒干。煨葛根：先以少量麸皮撒入热祸内，待冒烟后，将葛根片倒入，上面覆盖剩下的麸皮，煨至下层麸皮呈焦黄色时．随即以铁铲将葛根与麸皮不断翻动，至葛根片呈深黄色为废，取出，筛去麸皮，凉透。 (每葛根100斤，麸皮25斤)《品汇精要》：葛根，刮去皮或捣汁用。"}]},{"ID":"20240611130610-w5f6c7z","Type":"NodeParagraph","Properties":{"id":"20240611130610-w5f6c7z","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611130610-qqz668i","Type":"NodeParagraph","Properties":{"id":"20240611130610-qqz668i","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （l）取本品粉末0.5-1g，加乙醇25ml，80℃热浸30min，放冷，滤过，滤液点于滤纸上，喷洒1％三氯化铝乙醇液，干燥后在紫外光灯下（254nm）显蓝色荧光，用氨水熏后颜色更亮。（检查异黄酮）（2）薄层色谱取上述提取液蒸去乙醇，残渣加水溶解后用氯仿萃取去杂质，水液蒸干，用乙醇溶解后作供试液；另以葛根素为对照品。分别点样于同一硅胶G薄层板上，以氯仿一甲醇（8：2）展开，晾干，在紫外光（254nm）下供试液色谱中在与对照品色谱相应位置上，显相同的蓝色荧光斑点。商品规格（l）野葛根为统货，鲜时切成块或片。"}]},{"ID":"20240611130610-mididcn","Type":"NodeParagraph","Properties":{"id":"20240611130610-mididcn","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"（2）粉葛根一等：粉白色，断面显环纹，粉性足，纤维少。剖瓣长13-17cm，中部直径5cm以上。二等：表皮货白色。断面色白，有环纹，纤维较多，有粉性。中部直径1.5cm以上。间有断根、碎破小块。"}]},{"ID":"20240611130610-knv91be","Type":"NodeParagraph","Properties":{"id":"20240611130610-knv91be","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611130610-yjjwgnj","Type":"NodeParagraph","Properties":{"id":"20240611130610-yjjwgnj","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 脾；胃；肺；膀胱经"}]},{"ID":"20240611130610-0v99zwa","Type":"NodeParagraph","Properties":{"id":"20240611130610-0v99zwa","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611130610-w669vgl","Type":"NodeParagraph","Properties":{"id":"20240611130610-w669vgl","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 甘；辛；平"}]},{"ID":"20240611130610-ngb1udf","Type":"NodeParagraph","Properties":{"id":"20240611130610-ngb1udf","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611130610-suohhm8","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611130610-suohhm8","updated":"20240611130610"},"Children":[{"ID":"20240611130610-y1m22o5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611130610-y1m22o5","updated":"20240611130610"},"Children":[{"ID":"20240611130610-43h1vix","Type":"NodeParagraph","Properties":{"id":"20240611130610-43h1vix","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"张元素：不可多服，恐损胃气。"}]}]}]},{"ID":"20240611130610-8opa0oc","Type":"NodeParagraph","Properties":{"id":"20240611130610-8opa0oc","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.《本草正》：其性凉，易于动呕，胃寒者所当慎用。"}]},{"ID":"20240611130610-2nok3lf","Type":"NodeParagraph","Properties":{"id":"20240611130610-2nok3lf","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：夏日表虚汗多尤忌。"}]},{"ID":"20240611130610-wyrvkfq","Type":"NodeParagraph","Properties":{"id":"20240611130610-wyrvkfq","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611130610-jlghupu","Type":"NodeParagraph","Properties":{"id":"20240611130610-jlghupu","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 解肌退热；发表透诊；生津止渴；升阳止泻。主外感发热；头项强痛；麻疹初起；疹出不畅；温病口渴；消渴病；泄泻；痢疾；高血压；冠心病"}]},{"ID":"20240611130610-1oz5yk1","Type":"NodeParagraph","Properties":{"id":"20240611130610-1oz5yk1","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611130610-b47q5tn","Type":"NodeParagraph","Properties":{"id":"20240611130610-b47q5tn","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g；或捣汁。外用：适量，捣敷。"}]},{"ID":"20240611130610-7nhdxaj","Type":"NodeParagraph","Properties":{"id":"20240611130610-7nhdxaj","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611130610-c1v727m","Type":"NodeParagraph","Properties":{"id":"20240611130610-c1v727m","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" ①治太阳病，项背强几几，无汗恶风： 葛根四两，麻黄三两(去节)，桂枝二两(去皮)，生姜三两(切)，甘草二两(炙)，芍药二两，太枣十二枚(擘)。上七味，以水一斗，先煮麻黄、葛根，减二升，去白沫，纳诸药，煮取三升，去渣，温服一升，覆取微似汗。 (《伤寒论》葛根汤)②治太阳病，桂枝证医反下之， 利遂不止，脉促(表未解也)，喘而汗出： 葛根半斤，甘草二两(炙)，黄芩三两，黄连三两。上四味，以水八升，先煮葛根，减二升，纳诸，煮取二升，去滓，分温再服。(《伤寒论》葛根黄芩黄连汤)③治伤寒温疫，风热壮热，头痛、肢体痛，疮疹已发未发：升麻、干葛(细锉)、芍药、甘草(锉，炙)各等分。同为粗末，每服四钱，水一盏半，煎至一盏，量大小与之，温服无时。(《阎氏小儿方》升麻葛根汤) ④治癍疹初发，壮热，点粒未透： 葛根、升麻、桔梗、前胡、防风各一钱，甘草五分。水煎服。(《全幼心鉴》)⑤治热毒下血，或因吃热物发动：生葛根二斤；捣取汁一升，并藕汁一升，相和服。(《梅师集验方》) ⑥治心热吐血不止：生葛根汁半大升，顿服。(《广利方》) ⑦治鼻衄，终日不止，心神烦闷： 生葛根，捣取汁，每服一小盏。 (《圣惠方》)⑧治妊娠热病心闷： 葛根汁二升，分作三服。 (《伤寒类要》)⑨治卒干呕不息： 捣葛根，绞取汁，服一升许。(《补缺肘后方》) ⑩治酒醉不醒： 葛根汁一斗二升，饮之，取醒，止。 (《千金方》) (11)治食诸莱中毒，发狂烦闷，吐下欲死：煮葛根饮汁。(《补缺肘后方》) (12)治服药失度，心中苦烦： 饮生葛根汗大良。无生者，干葛为末，水服五合，亦可煮服之。 (《补缺肘后方》)(13)治急性肠梗阻：葛根、皂角各1斤，加水4000毫，煎煮40分钟，去渣，置药汁锅于火炉上保持适当温度(以不致烫伤为度)。另以 1市尺见方之10层纱布垫4块，浸以药液后，稍稍除去水分，交替置腹部作持续热敷，每次 1小时，每天2至3次。〔《河南医学院学报》9(4)：203；1965〕(14)治金疮中风，痉欲死： 捣生葛根一，细切，以水一斗，煮取五升，去滓，取一升服，若干者，捣末，温酒调三指撮，若口噤不开，但多服竹沥，又多服生葛根自愈，食亦妙。(《肘后方》)"}]},{"ID":"20240611130610-07uaqk4","Type":"NodeParagraph","Properties":{"id":"20240611130610-07uaqk4","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611130610-w7cw9o4","Type":"NodeParagraph","Properties":{"id":"20240611130610-w7cw9o4","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 1.治疗高血压病颈项强痛：根据用葛根治疗外感病项背强痛的经验，试用于治疗高血压病的颈项强痛，亦取得疗效。"}]},{"ID":"20240611130610-b2k8xsl","Type":"NodeParagraph","Properties":{"id":"20240611130610-b2k8xsl","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"1.1.煎剂： 10-15g／日，煎分2次服，连服2-8周。观察52例，颈项强痛消失17例，明显减轻30例。"}]},{"ID":"20240611130610-9tocwh0","Type":"NodeParagraph","Properties":{"id":"20240611130610-9tocwh0","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"1.2.总黄酮：每日量100mg，两次分服，疗程同上。治疗40例，项痛消失9例，明显减轻27例。同时对高血压病的头痛、头晕、耳鸣及肢麻等症状也有一定改善作用，但降压不明显。多数患者在用药第1周即可出现疗效，作用持续1-2周。无明显副作用。"}]},{"ID":"20240611130610-jjerlpq","Type":"NodeParagraph","Properties":{"id":"20240611130610-jjerlpq","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"2.治疗冠心病心绞痛：用葛根酒浸膏片每日6-12片，分2-3次服，总疗程4-22周。治疗冠心病心绞痛71例，对心绞痛症状显效29例，改善2O例，基本无效22例。心电图有效率为41.3%，血清胆甾醇及β-脂蛋白在服药期间无明显变化。又据75例用酒浸膏片(每片含葛甙100mg，每日量900-1200mg，少数用至1600mg；13例加用葛根注射液，每日2-4ml，每毫升含黄酮200mg)治疗2-9个月的结果，心绞痛的有效率为86.7%，其中显效率为36%，心电图的好转率为44.4%。一般在1月左右生效，2个月疗效较明显，此后疗效与疗程并不成正比，加用葛根注射液可提高部分患者疗效。对缓解憋气的效果较差。胆甾醇治疗前后有显着差异性，但可能是受季节、饮食等改变所影响，因此本品是否能降低胆甾醇尚待研究。还有用葛根糖浆(每毫升相当生药1g)每次20ml，日服3次，疗程4-12周，观察19例。用药后6例症状消失或基本消失，8例心绞痛发作次数、程度及持续时间均有明显减轻，无效5例。生效时间多在服药后 1-2周。疗程达8周或以上者疗效较好。心电图复查，显效5例，好转5例，无效9例。血清胆甾醇检查有10例明显降低，但对血压无明显影响。治疗中除 1例胃溃疡患者于服药第 1周内有轻度腹胀及上腹部不适外，未见明显副作用。"}]},{"ID":"20240611130610-ylqwp9w","Type":"NodeParagraph","Properties":{"id":"20240611130610-ylqwp9w","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"3.治疗眼底病：用葛根黄酮注射液(每毫升含黄酮40mg)局部注射。一般均采用结膜下注射法，遇局部反应重时，可交替使用球后注射法。前者每次0.2-0.4ml，后者每次0.3-0.5ml。初次宜用小剂量，以后可渐增。每周注射2次，2周一疗程。病程超过半年者可加用胎盘组织液肌肉注射；视神经萎缩病例加用维生素 B1肌注。尽量不与激素同用。共观察中央性视网膜炎35例，痊愈26例，显效5例，进步1例，无效3例。视神经萎缩12例，显效6例，进步2例，无效4例。妊娠毒血症视网膜病变2例均无效。陈旧性脉络膜炎3例，视网膜中动脉栓塞、视网膜剥离手术后各 1例，均有进步。黄斑发育不良及高度近视合并黄斑变性各1例均无效。葛根黄酮对因视网膜血管痉挛引起的中央性视网膜炎的疗效比较显着，治疗不能少于4次，视力恢复正常或病变已经吸收后，可以本品肌肉注射或片剂内服以巩固疗效，防止复发。"}]},{"ID":"20240611130610-vrjr9c1","Type":"NodeParagraph","Properties":{"id":"20240611130610-vrjr9c1","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"4.治疗早期突发性耳聋：日服葛根(总黄酮体)2-3次，每次20mg；同时配合复合维生素B口服。观察33例，年龄15-64岁。根据 EAG(电听阈曲线)和症状判断疗效，痊愈9例，显效6例，进步9例，无效9例。"}]},{"ID":"20240611130610-gbhonw5","Type":"NodeParagraph","Properties":{"id":"20240611130610-gbhonw5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611130610-7rqrrf7","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611130610-7rqrrf7","updated":"20240611130610"},"Children":[{"ID":"20240611130610-ryk94fk","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611130610-ryk94fk","updated":"20240611130610"},"Children":[{"ID":"20240611130610-lqalgr5","Type":"NodeParagraph","Properties":{"id":"20240611130610-lqalgr5","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"张元素：用此(葛根)以断太阳入阳明之路，即非太阳药也，故仲景治大阳阳明合病，桂枝汤加麻黄、葛根也。 又有葛根黄芩黄连解肌汤，是知葛根非太阳药，即阳明药。太阳初病、未入阳明，头痛者，不可便服葛根发之，若服之是引贼破家也，若头颅痛者可服之。"}]}]},{"ID":"20240611130610-7hlcw36","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240611130610-7hlcw36","updated":"20240611130610"},"Children":[{"ID":"20240611130610-361llux","Type":"NodeParagraph","Properties":{"id":"20240611130610-361llux","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"李杲：干葛，其气轻浮，鼓舞胃气上行，生津液，又解肌热，治脾胃虚弱泄泻圣药也。"}]}]}]},{"ID":"20240611130610-mex6lao","Type":"NodeParagraph","Properties":{"id":"20240611130610-mex6lao","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：本草十剂云，轻可去实，麻黄、葛根之属。盖麻黄乃太阳经药，兼入肺经，肺主皮毛；葛根乃阳阴经药，兼人脾经，脾主肌肉。所以二味药皆轻扬发散，而所入迥然不同也。"}]},{"ID":"20240611130610-73rpdk0","Type":"NodeParagraph","Properties":{"id":"20240611130610-73rpdk0","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：葛根，解散阳明温病热邪之要药也，故主消渴，身大热，热壅胸隔作呕吐。发散而升，风药之性也，放主诸痹。伤寒头痛兼项强腰脊痛，及遍身骨疼看，足太阳也，邪犹未入阳明，故无渴证，不宜服。"}]},{"ID":"20240611130610-hfds8ug","Type":"NodeParagraph","Properties":{"id":"20240611130610-hfds8ug","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"5.《本草汇言》：葛根，清风寒，净表邪，解肌热，止烦渴，泻胃火之药也。尝观发表散邪之药，其品亦多，如麻黄拔太阳营分之寒，桂枝解太阳卫分之风，防风、紫苏散太阳在表之风寒，藁本、羌活散太阳在表之寒湿，均称发散药也，而葛根之发散，亦入太阳，亦散风寒，又不同矣，非若麻、桂、苏、防，辛香温燥，发散而又有损中气之误也；非若藁本、羌活，发散而又有耗营血之虞也。《神农经》谓起阴气，除消渴，身大热，明属三阳表热无寒之邪，能散之清之之意也。如伤风伤寒，温病热病，寒邪已去，标阳已炽，邪热伏于肌腠之间，非表非里，又非半表半里，口燥烦渴，仍头痛发热者，必用葛根之甘寒，清肌退热可也，否则舍葛根而用辛温(如麻、桂、苏、防之类)，不惟疏表过甚，而元气虚，必致多汗亡阳矣。然而葛根之性专在解肌，解肌而热自退，渴自止，汗自收。而本草诸书又言能发汗者，非发三阳寒邪在表之汗也，又非发风温在经之汗也，实乃发三阳寒郁不解，郁极成热之汗也。 又如太阳汗出不彻、阳气怫郁，其人面色缘缘正赤，躁烦不知痛之所在，短气，更发汗以愈，宜葛根汤治之，郁解热除，汗出而邪自退，此所以本草诸书言发汗者此也。"}]},{"ID":"20240611130610-melar3j","Type":"NodeParagraph","Properties":{"id":"20240611130610-melar3j","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"6.《本草正》：葛根，用此者，用其凉散，虽善达诸阳经，而阳明为最， 以其气轻，故善解表发汗。凡解散之药多辛热，此独凉而甘，故解温热时行疫疾，凡热而兼渴者，此为最良，当以为君，而佐以柴、防、甘、桔。"}]},{"ID":"20240611130610-o25bxq8","Type":"NodeParagraph","Properties":{"id":"20240611130610-o25bxq8","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"7.《药品化义》：葛根，根主上升，甘主散表，若多用二、三钱，能理肌肉之邪，开发腠理而出汗，属足阳明胃经药，治伤寒发热，鼻干口燥，疟疾热重。盖麻黄、紫苏专能攻表，而葛根独能解肌耳。因其性味甘凉，能鼓舞胃气，若少用五、六分，治胃虚热渴，酒毒呕吐，胃中郁火，牙疼口臭。或佐健脾药，有醒脾之力。且脾主肌肉，又主四肢，如阳气郁遏于脾胃之中，状非表症，饮食如常，但肌表及四肢发热如火，以此同升麻、柴胡、防风、羌活，升阳散火，清肌退热，薛立斋常用剂也。若金疮、若中风、若痉病以致口噤者，捣生葛根汁，同竹沥灌下即醒，干者为末，酒调服亦可。痘疮难出，以此发之甚捷。"}]},{"ID":"20240611130610-n55op4z","Type":"NodeParagraph","Properties":{"id":"20240611130610-n55op4z","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"8.《本经逢原》：葛根轻浮，生用则升阳生津，熟用则鼓舞胃气，故治胃虚作渴，七味白术散用之。又清暑益气汤兼黄柏用者，以暑伤阳阴，额颅必胀，非此不能开发也。"}]},{"ID":"20240611130610-5c2mtrs","Type":"NodeParagraph","Properties":{"id":"20240611130610-5c2mtrs","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"9.《本经疏证》：葛根之用，妙在非徒如栝蒌但FU阴律，亦非徒如升麻但升阳气，而能兼擅二者之长，故太阳阳明合病，自下利看(葛根汤证)，太阳被下，利遂不止，脉促喘汗者(葛根芩连汤证)咸用之。盖两者之利，为阳盛于外，不与阴交，阴遂不固而下溜，起其阴气，使与阳浃，得曳以上行，则非但使利止，并能使阳之遏于外者，随胃阳鼓荡而散矣。"}]},{"ID":"20240611130610-lz4wfj6","Type":"NodeParagraph","Properties":{"id":"20240611130610-lz4wfj6","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"10.《药医学丛书》：葛根，斑疹为必用之药，亦并非已见点不司用，痧麻均以透达为主，所惧者是陷，岂有见点不可用之理惟无论痧麻，舌绛且干者，为热入营分，非犀、地黄不办，误用葛根，即变证百出，是不可不知也。又凡伤寒阳阴症已见，太阳未罢，得葛根良。太阳已罢，纯粹阳明经症，得葛根亦良。惟温病之属湿温及伏暑、秋邪者不适用，此当于辨症加之注意。若一例横施，伏暑、秋邪得此，反见白，则用之不当之为害也。"}]},{"ID":"20240611130610-lvgwjoq","Type":"NodeParagraph","Properties":{"id":"20240611130610-lvgwjoq","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"11.《本草正义》：葛根，气味皆薄，最能升发脾胃清阳之气，《伤寒论》以为阳明主药，正惟表寒过郁于外，胃家阳气不能散布，故以此轻扬升举之药，捷动清阳，扞御外寒，斯表邪解而胃阳舒展，所以葛根汤中仍有麻黄，明为阳阴表寒之主药，非阳明里热之专司，若已内传而为阳明热，则仲景自有白虎诸法，非葛根汤之所宜用。其葛根黄芩黄连汤方，则主阳明协热下利，貌视之，颇似专为里有实热而设，故任用芩、连之苦寒，则葛根似亦为清里之品；抑知本条为太阳病桂枝证医反下之之变，邪热因误下而入里，里虽宜清，而利遂不止，即以脾胃清阳下陷之候，葛根只以升举陷下之气，并非为清里而设，此皆仲师选用葛根之真旨。由此推之，而知《本经》之主消渴者，亦以燥令太过，降气迅速，故虽饮多而渴不解，此药治之，非特润燥，亦以升清。又主呕吐者，亦以胃气不能敷布，致令食不得入，非可概治胃火上逆之呕吐。而仅知为清胃生津、甘润退热之普通药剂，则似是实非，宁独毫厘之差，真是千里之谬矣。"}]},{"ID":"20240611130610-5cxc3ze","Type":"NodeParagraph","Properties":{"id":"20240611130610-5cxc3ze","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611130610-5qusmab","Type":"NodeParagraph","Properties":{"id":"20240611130610-5qusmab","updated":"20240611130610"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611130612-v2v1xs6","Type":"NodeThematicBreak","Properties":{"id":"20240611130612-v2v1xs6"}},{"ID":"20240611130613-4ksso32","Type":"NodeParagraph","Properties":{"id":"20240611130613-4ksso32"}}]}