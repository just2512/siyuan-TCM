{"ID":"20240205153915-xxcdz01","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153915-xxcdz01","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153915-xxcdz01\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206084140-tlsvn8x\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611130613-4ksso32\u0026quot;,\u0026quot;scrollTop\u0026quot;:700,\u0026quot;focusId\u0026quot;:\u0026quot;20240620103851-0rcibvl\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"159葛根（柴葛、野葛）","type":"doc","updated":"20240813150610"},"Children":[{"ID":"20240206084140-tlsvn8x","Type":"NodeParagraph","Properties":{"id":"20240206084140-tlsvn8x","updated":"20240206084147"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产河南、浙江、广东、湖南等地。\n【性状】\t本品呈纵切的长方形厚片或小方块，长535cm，厚0.51cm。外皮淡棕色，有纵皱纹，粗糙。切面黄白色，纹理不明显。质韧，纤维性强。气微，味微甜。\n【性味】\t甘、辛，凉。\n【功效】\t解表退热，生津，透疹，升阳止泻。用于外感发热头痛、高血压颈项强痛、口渴、消渴、麻疹不透、热痢、泄泻。"}]},{"ID":"20240206084139-bqg7020","Type":"NodeParagraph","Properties":{"id":"20240206084139-bqg7020","updated":"20240813145730"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206084139-qlt8w7x.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205155041-6o94bg9","Type":"NodeParagraph","Properties":{"id":"20240205155041-6o94bg9","updated":"20240813145727"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根-20240205155041-al57rk1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813145845-1n3exwy","Type":"NodeParagraph","Properties":{"id":"20240813145845-1n3exwy","updated":"20240813150124"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 666px;","style":"width: 656px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根-20240813145845-d4ipt4c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 656px;\" parent-style=\"width: 666px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240722124059-76kg7cc","Type":"NodeParagraph","Properties":{"id":"20240722124059-76kg7cc","updated":"20240813150619"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 355px;","style":"width: 345px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 2-20240722124059-vps7rvr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 345px;\" parent-style=\"width: 355px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 398px;","style":"width: 388px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葛根 3-20240722124118-txdjd4s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 388px;\" parent-style=\"width: 398px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 483px;","style":"width: 473px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葛根 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpe