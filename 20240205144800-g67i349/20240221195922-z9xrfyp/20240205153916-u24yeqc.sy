.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 797px;\" parent-style=\"width: 807px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820092144-ny8sf3n","Type":"NodeParagraph","Properties":{"id":"20240820092144-ny8sf3n","updated":"20240820093248"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 536px;","style":"width: 526px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 9-20240820092144-pi1iys8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 526px;\" parent-style=\"width: 536px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 615px;","style":"width: 605px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 12-20240820092857-3u3of3a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 605px;\" parent-style=\"width: 615px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240820091752-np92e6z","Type":"NodeParagraph","Properties":{"id":"20240820091752-np92e6z","updated":"20240820093251"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 425px;","style":"width: 415px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 10-20240820092238-0ne7b1z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 749px;","style":"width: 739px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 11-20240820092401-cn1v2d9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 739px;\" parent-style=\"width: 749px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820093813-7qn1i9e","Type":"NodeParagraph","Properties":{"id":"20240820093813-7qn1i9e","updated":"20240820093813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 14-20240820093813-lagdtz0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820091730-qi37i6l","Type":"NodeParagraph","Properties":{"id":"20240820091730-qi37i6l","updated":"20240820092501"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：伞型科植物较为相像，请在专业人员指导下甄别；"}]},{"ID":"20240820092449-rz5xy93","Type":"NodeParagraph","Properties":{"id":"20240820092449-rz5xy93","updated":"20240820092918"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：藁本的叶子比较细，杆是空心的，植株高度一米左右；"}]},{"ID":"20240611162414-b5xv8bn","Type":"NodeThematicBreak","Properties":{"id":"20240611162414-b5xv8bn"}},{"ID":"20240611162518-lnkrexk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162518-lnkrexk","updated":"20240611162525"},"Children":[{"Type":"NodeText","Data":"藁本《神农本草经》"}]},{"ID":"20240611162518-sq8p4iz","Type":"NodeParagraph","Properties":{"id":"20240611162518-sq8p4iz","updated":"20240611162518"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240611162518-mqcl3nq","Type":"NodeParagraph","Properties":{"id":"20240611162518-mqcl3nq","updated":"20240611162518"},"Children":[{"Type":"NodeText","Data":"主妇人疝瘕，阴中寒肿痛，腹中急，除风头痛，长肌肤：说颜色。一名鬼卿，一名地新。生山谷。"}]},{"ID":"20240611162518-gbnmiec","Type":"NodeParagraph","Properties":{"id":"20240611162518-gbnmiec","updated":"20240611162518"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名微茎，生崇山，正月二月采根暴干，三十日成。"}]},{"ID":"20240611162518-4rzsjhe","Type":"NodeParagraph","Properties":{"id":"20240611162518-4rzsjhe","updated":"20240611162518"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：山芷蔚香，藁本也。《管子·地员篇》云：五臭畴生藁本。《荀子·大略篇》云：兰芷藁本，浙于蜜醴，一佩易之。樊光注《尔雅》云：藁本一名麋芜，根名靳芷，归作藁，非。"}]},{"ID":"20240611162539-zgow9cr","Type":"NodeThematicBreak","Properties":{"id":"20240611162539-zgow9cr"}},{"ID":"20240611162540-kkjh5f9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162540-kkjh5f9","updated":"20240611162544"},"Children":[{"Type":"NodeText","Data":"藁本《中药学》"}]},{"ID":"20240611162540-zr0uukx","Type":"NodeParagraph","Properties":{"id":"20240611162540-zr0uukx","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【药用】本品为伞形科植物藁本的根茎及根。"}]},{"ID":"20240611162540-lcqx79b","Type":"NodeParagraph","Properties":{"id":"20240611162540-lcqx79b","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛，温。入膀胱经。"}]},{"ID":"20240611162540-q26wh7e","Type":"NodeParagraph","Properties":{"id":"20240611162540-q26wh7e","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【功效】祛风散寒止痛。"}]},{"ID":"20240611162540-ajj4mev","Type":"NodeParagraph","Properties":{"id":"20240611162540-ajj4mev","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于外感风寒，头痛，以及巅顶头痛等症。"}]},{"ID":"20240611162540-gx48dbg","Type":"NodeParagraph","Properties":{"id":"20240611162540-gx48dbg","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"本品辛温辛散，善达头之巅顶，有止痛作用，故适用于感冒风寒引起的头痛、巅顶头痛、偏头痛，常与川芎、白芷等配伍应用。"}]},{"ID":"20240611162540-5rcssrw","Type":"NodeParagraph","Properties":{"id":"20240611162540-5rcssrw","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"此外，对于风寒湿邪所引起的风湿痹痛、肢节疼痛，常与苍朮、羌活等配伍应用。"}]},{"ID":"20240611162540-olicnsq","Type":"NodeParagraph","Properties":{"id":"20240611162540-olicnsq","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【处方用名】藁本、川藁本（洗净，晒干，切片用）"}]},{"ID":"20240611162540-bedwydf","Type":"NodeParagraph","Properties":{"id":"20240611162540-bedwydf","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240611162540-1zutppj","Type":"NodeParagraph","Properties":{"id":"20240611162540-1zutppj","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【方剂举例】羌活防风汤（《活法机要》）羌活、独活、防风、藁本、蔓荆子、川芎、甘草。治感冒头痛。"}]},{"ID":"20240611162540-u50n72f","Type":"NodeParagraph","Properties":{"id":"20240611162540-u50n72f","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主妇人疝瘕，阴中寒肿痛，腹中急，除风头痛，长肌肤。」"}]},{"ID":"20240611162540-9y51jue","Type":"NodeParagraph","Properties":{"id":"20240611162540-9y51jue","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"《珍珠囊》：「治太阳头痛，巅顶痛，大寒犯脑，痛连齿颊。」"}]},{"ID":"20240611162540-hts5wro","Type":"NodeParagraph","Properties":{"id":"20240611162540-hts5wro","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"《用药法象》：「头面身体皮肤风湿。」"}]},{"ID":"20240611162540-dtrsy19","Type":"NodeParagraph","Properties":{"id":"20240611162540-dtrsy19","updated":"20240611162540"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「治痈疽，排脓内塞。」"}]},{"ID":"20240611162550-ylgixlv","Type":"NodeThematicBreak","Properties":{"id":"20240611162550-ylgixlv"}},{"ID":"20240611162551-nqv1z64","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162551-nqv1z64","updated":"20240611162555"},"Children":[{"Type":"NodeText","Data":"藁本《医学入门》"}]},{"ID":"20240611162551-zs900sx","Type":"NodeParagraph","Properties":{"id":"20240611162551-zs900sx","updated":"20240611162551"},"Children":[{"Type":"NodeText","Data":"藁本辛温治 风，顶面皮肤一样功，专辟雾露兼通血，疝瘕腹痛阴肿同。"}]},{"ID":"20240611162551-duq36zk","Type":"NodeParagraph","Properties":{"id":"20240611162551-duq36zk","updated":"20240611162551"},"Children":[{"Type":"NodeText","Data":"根上苗下似枯 。无毒。升也，阳也，太阳本经药。主风邪 曳疼痛，痫风金疮，大寒犯脑巅顶痛，或引齿痛。一切头面皮肤风疾，及酒渣粉刺，中雾露清邪必用之。既治风，又治湿也，兼通妇人血脉疝瘕腹急痛，阴中寒肿。长肌悦颜，可作面脂。去芦，出宕州者佳。恶茹，畏青葙子。"}]},{"ID":"20240611162602-ra7zawd","Type":"NodeThematicBreak","Properties":{"id":"20240611162602-ra7zawd"}},{"ID":"20240611162603-d7xh08h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162603-d7xh08h","updated":"20240611162607"},"Children":[{"Type":"NodeText","Data":"蒿本《千金翼方》"}]},{"ID":"20240611162603-7815kb3","Type":"NodeParagraph","Properties":{"id":"20240611162603-7815kb3","updated":"20240611162603"},"Children":[{"Type":"NodeText","Data":"味辛苦，温，微温，微寒，无毒。主妇人疝瘕，阴中寒肿痛，腹中急，除风头痛，长肌肤，悦颜色，辟雾露润泽。疗风邪 曳，金疮。可作沐药面脂。实∶主风流四肢。一名鬼卿，一名地新，一名微茎。生崇山山谷，正月二月采干，曝干，三十日成。"}]},{"ID":"20240611162336-es77f57","Type":"NodeThematicBreak","Properties":{"id":"20240611162336-es77f57"}},{"ID":"20240611162407-2b42ljy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162407-2b42ljy","updated":"20240611162412"},"Children":[{"Type":"NodeText","Data":"藁本《本草纲目》"}]},{"ID":"20240611162407-2yn7460","Type":"NodeParagraph","Properties":{"id":"20240611162407-2yn7460","updated":"20240611162407"},"Children":[{"Type":"NodeText","Data":"「释名」亦名藁茇、鬼卿、地新、微茎。"}]},{"ID":"20240611162407-lm0bzok","Type":"NodeParagraph","Properties":{"id":"20240611162407-lm0bzok","updated":"20240611162407"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、温、无毒。"}]},{"ID":"20240611162407-himjjml","Type":"NodeParagraph","Properties":{"id":"20240611162407-himjjml","updated":"20240611162407"},"Children":[{"Type":"NodeText","Data":"「主治」太阳头痛、巅顶痛、头面身体皮肤风湿，亦治痈疽，排脓内塞。小儿疥癣，可用藁本煎汤洗，并搓洗换下来的衣服。"}]},{"ID":"20240611162407-f2qd6ys","Type":"NodeParagraph","Properties":{"id":"20240611162407-f2qd6ys","updated":"20240611162407"},"Children":[{"Type":"NodeText","Data":"头屑多，可用藁本、白芷，等分为末，夜间干擦头发，清晨梳去，头屑自除。"}]},{"ID":"20240611162336-8ezsh17","Type":"NodeThematicBreak","Properties":{"id":"20240611162336-8ezsh17"}},{"ID":"20240611162337-i9aq4co","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162337-i9aq4co","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"《中国药典》：藁本"}]},{"ID":"20240611162337-qy1yq1z","Type":"NodeParagraph","Properties":{"id":"20240611162337-qy1yq1z","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162337-yzv5307","Type":"NodeParagraph","Properties":{"id":"20240611162337-yzv5307","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" Gǎo Běn"}]},{"ID":"20240611162337-m1rbi8h","Type":"NodeParagraph","Properties":{"id":"20240611162337-m1rbi8h","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162337-izh73ek","Type":"NodeParagraph","Properties":{"id":"20240611162337-izh73ek","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 香藁本"}]},{"ID":"20240611162337-j5oszbe","Type":"NodeParagraph","Properties":{"id":"20240611162337-j5oszbe","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611162337-7hl8xie","Type":"NodeParagraph","Properties":{"id":"20240611162337-7hl8xie","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" RHIZOMA LIGUSTICI"}]},{"ID":"20240611162337-hb6xgb6","Type":"NodeParagraph","Properties":{"id":"20240611162337-hb6xgb6","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162337-z91u1et","Type":"NodeParagraph","Properties":{"id":"20240611162337-z91u1et","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 本品为伞形科藁本属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藁本"},{"Type":"NodeText","Data":"Ligusticum sinense Oliv.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辽藁本"},{"Type":"NodeText","Data":"Ligusticum jeholense Nakai et Kitag. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋季茎叶枯萎或次春出苗时采挖，除去泥沙，晒干或烘干。"}]},{"ID":"20240611162337-ogycbjo","Type":"NodeParagraph","Properties":{"id":"20240611162337-ogycbjo","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162337-hk5ln8f","Type":"NodeParagraph","Properties":{"id":"20240611162337-hk5ln8f","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 藁本：根茎呈不规则结节状圆柱形，稍扭曲，有分枝，长3～10cm，直径1～2cm。表面棕褐色或暗棕色，粗糙，有纵皱纹，上侧残留数个凹陷的圆形茎基，下侧有多数点状突起的根痕及残根。体轻，质较硬，易折断，断面黄色或黄白色，纤维状。气浓香，味辛、苦、微麻。"}]},{"ID":"20240611162337-6b6w6lg","Type":"NodeParagraph","Properties":{"id":"20240611162337-6b6w6lg","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"辽藁本：较小，根茎呈不规则的团块状或柱状，有多数细长弯曲的根。"}]},{"ID":"20240611162337-tqrm1ay","Type":"NodeParagraph","Properties":{"id":"20240611162337-tqrm1ay","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611162337-fawsnd8","Type":"NodeParagraph","Properties":{"id":"20240611162337-fawsnd8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防潮，防蛀。"}]},{"ID":"20240611162337-l8b80n9","Type":"NodeParagraph","Properties":{"id":"20240611162337-l8b80n9","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611162337-lof5qki","Type":"NodeParagraph","Properties":{"id":"20240611162337-lof5qki","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240611162337-3xkb88p","Type":"NodeParagraph","Properties":{"id":"20240611162337-3xkb88p","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611162337-ofhef8t","Type":"NodeParagraph","Properties":{"id":"20240611162337-ofhef8t","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 取本品粉末1g，加乙醚10ml，冷浸1小时后，超声处理20分钟，滤过，滤液浓缩至1ml，作为供试品溶液。另取藁本对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各1μl,分别点于同一硅胶G薄层板上，以石油醚（60～90℃）-丙酮（95：5）为展开剂，展开，展距10cm，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上,显相同颜色的荧光主斑点。"}]},{"ID":"20240611162337-gfte3gv","Type":"NodeParagraph","Properties":{"id":"20240611162337-gfte3gv","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162337-zdv5xnt","Type":"NodeParagraph","Properties":{"id":"20240611162337-zdv5xnt","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 归膀胱经。"}]},{"ID":"20240611162337-69jt05v","Type":"NodeParagraph","Properties":{"id":"20240611162337-69jt05v","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162337-40qmpbd","Type":"NodeParagraph","Properties":{"id":"20240611162337-40qmpbd","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240611162337-m3cffeo","Type":"NodeParagraph","Properties":{"id":"20240611162337-m3cffeo","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162337-zott1d8","Type":"NodeParagraph","Properties":{"id":"20240611162337-zott1d8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 祛风，散寒，除湿，止痛。用于风寒感冒，巅顶疼痛，风湿肢节痹痛。"}]},{"ID":"20240611162337-lcx1bkv","Type":"NodeParagraph","Properties":{"id":"20240611162337-lcx1bkv","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162337-r1nf0ug","Type":"NodeParagraph","Properties":{"id":"20240611162337-r1nf0ug","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240611162337-608jamm","Type":"NodeParagraph","Properties":{"id":"20240611162337-608jamm","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611162337-en85d83","Type":"NodeParagraph","Properties":{"id":"20240611162337-en85d83","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" （1）本品辛温辛散，善达头之巅顶，有止痛作用，故适用于感冒风寒引起的头痛、巅顶头痛、偏头痛，常与川芎、白芷等配伍应用。此外，对于风寒湿邪所引起的风湿痹痛、肢节疼痛，常与苍朮、羌活等配伍应用。"}]},{"ID":"20240611162337-x23rm5b","Type":"NodeParagraph","Properties":{"id":"20240611162337-x23rm5b","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162337-lm9z48s","Type":"NodeParagraph","Properties":{"id":"20240611162337-lm9z48s","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611162337-2le5ur8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162337-2le5ur8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：藁本"}]},{"ID":"20240611162337-dgudwr8","Type":"NodeParagraph","Properties":{"id":"20240611162337-dgudwr8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162337-evvfz5f","Type":"NodeParagraph","Properties":{"id":"20240611162337-evvfz5f","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" Gǎo Běn"}]},{"ID":"20240611162337-w5iyq7p","Type":"NodeParagraph","Properties":{"id":"20240611162337-w5iyq7p","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162337-3xj429q","Type":"NodeParagraph","Properties":{"id":"20240611162337-3xj429q","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 藁茇（《山海经》），鬼卿、地新（《本经》），山茝、蔚香（《广雅》），微茎（《别录》），藁板（《山东中药》）。"}]},{"ID":"20240611162337-i30xf84","Type":"NodeParagraph","Properties":{"id":"20240611162337-i30xf84","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611162337-x0aukix","Type":"NodeParagraph","Properties":{"id":"20240611162337-x0aukix","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611162337-smtivt6","Type":"NodeParagraph","Properties":{"id":"20240611162337-smtivt6","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162337-m3v5e15","Type":"NodeParagraph","Properties":{"id":"20240611162337-m3v5e15","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藁本"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辽藁本"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"火藁本"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋采挖根茎及根，除去茎叶及泥土，晒干或烘干。"}]},{"ID":"20240611162337-gxlwkb9","Type":"NodeParagraph","Properties":{"id":"20240611162337-gxlwkb9","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611162337-bqy4hag","Type":"NodeParagraph","Properties":{"id":"20240611162337-bqy4hag","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" ①藁本，又名：山园荽（《救荒本草》）。"}]},{"ID":"20240611162337-ekhby5a","Type":"NodeParagraph","Properties":{"id":"20240611162337-ekhby5a","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"多年生草本。茎直立，中空，表面有纵直沟纹。叶互生；基生叶三角形，长8～15厘米，2回羽状全裂，最终裂片3～4对，卵形，上面叶脉上有乳头状突起，边缘具不整齐的羽状深裂，先端渐尖；叶柄长9～20厘米；茎上部的叶具扩展叶鞘。复伞形花序，顶生或腋生；总苞片羽状细裂，远较伞梗为短；伞梗16～20个或更多；小伞形花序有花多数，小伞梗纤细，长不超过1厘米：小总苞线形或狭披针形，较小伞梗为短；花小，无花萼；花瓣5，白色，椭圆形至倒卵形，中央有短尖突起，向内折卷；雄蕊5，花丝细软，弯曲，花药椭圆形，2室，纵裂；花柱2，细软而反折，子房卵形，下位，2室。双悬果广卵形，无毛，分果具5条果棱，棱槽中各有3个油管，合生面有5个油管。花期7～8月，果期9～10月。"}]},{"ID":"20240611162337-5dj7o8r","Type":"NodeParagraph","Properties":{"id":"20240611162337-5dj7o8r","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"野生于向阳山坡草丛中或润湿的水滩边。分布河南、陕西、甘肃、江西、湖北、湖南、四川、山东、云南等地。"}]},{"ID":"20240611162337-kjivffl","Type":"NodeParagraph","Properties":{"id":"20240611162337-kjivffl","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②辽藁本，又名：家藁本、水藁本。"}]},{"ID":"20240611162337-rtjj6pj","Type":"NodeParagraph","Properties":{"id":"20240611162337-rtjj6pj","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15～60厘米。根茎短。茎直立，通常单一，中空，表面具纵棱，常带紫色。基生叶在花期时雕落；茎生叶互生，在下部和中部的叶有长柄；叶片全形为广三角形，通常为3回3出羽状全裂，最终裂片卵形或广卵形，先端短渐尖，基部楔形，或近圆形，边缘有少数缺刻状牙齿，上面绿色，沿脉有细微的乳头突起，下面灰绿色；茎上部的叶较小，叶柄鞘状，2回3出羽状全裂。复伞形花序顶生；总苞片少数，早落；伞梗6～19个；小总苞片锥形，10枚左右，花梗20左右；萼齿不明显；花瓣5，白色，椭圆形；雄蕊5，较花瓣长，花药黑紫色；子房下位，花柱呈压扁的圆锥形。双悬果椭圆形，分果具5条果棱，果棱具狭翅，背棱棱槽中有油管1个，侧棱棱槽中有油管1～2个，合生面有油管2～4个。花期7～9月。果期9～10月。"}]},{"ID":"20240611162337-y1p9tj8","Type":"NodeParagraph","Properties":{"id":"20240611162337-y1p9tj8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"生于山地林缘，以及多石砾的山坡林下。分布吉林、辽宁、河北、山东、山西等地。"}]},{"ID":"20240611162337-c1s6wkw","Type":"NodeParagraph","Properties":{"id":"20240611162337-c1s6wkw","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"③火藁本"}]},{"ID":"20240611162337-fpug4dj","Type":"NodeParagraph","Properties":{"id":"20240611162337-fpug4dj","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"形态与辽藁本相似，但根较粗大。叶为3～4回3出羽状细裂，裂片线形。无总苞或有1～2枚总苞，白色，披针形，比伞梗短，花药绛红色。果实油管在背棱上有1个，侧棱上有2个，接合面上2个。"}]},{"ID":"20240611162337-e4ffjei","Type":"NodeParagraph","Properties":{"id":"20240611162337-e4ffjei","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"分布东北地区。"}]},{"ID":"20240611162337-cm8ycsg","Type":"NodeParagraph","Properties":{"id":"20240611162337-cm8ycsg","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162337-mbgbg25","Type":"NodeParagraph","Properties":{"id":"20240611162337-mbgbg25","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" ①藁本"}]},{"ID":"20240611162337-gw1hq7x","Type":"NodeParagraph","Properties":{"id":"20240611162337-gw1hq7x","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"又名：西芎藁本。为植物藁本的干燥根茎及根。根茎呈不规则的结节状圆柱形，有分枝，稍弯曲，多横向生长，长3～8厘米，直径0.7～3厘米。外皮棕褐色或棕黑色，皱缩有沟，纹。上侧具有数个较长的茎基残留，茎基中空有洞，表面具纵直沟纹。下侧着生多数支根和须根（商品多已除去），支根直径约1～5毫米，上有纵沟纹及点状突起的须根残痕，外皮易剥落。质硬易折断，断面淡黄色或黄白色。气芳香，味苦而辛。以身干、整齐、香气浓者为佳。"}]},{"ID":"20240611162337-ldmp0lz","Type":"NodeParagraph","Properties":{"id":"20240611162337-ldmp0lz","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"主产湖北、湖南、四川。此外，陕西、山东等地亦产。"}]},{"ID":"20240611162337-2m38aig","Type":"NodeParagraph","Properties":{"id":"20240611162337-2m38aig","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②北藁本"}]},{"ID":"20240611162337-gqjwm5c","Type":"NodeParagraph","Properties":{"id":"20240611162337-gqjwm5c","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"为植物辽藁本及火藁本的干燥根茎和根。根茎呈不规则的柱状或圆块状，常分歧，纵向及横向生长均有，长约1.5～6厘米，径0.5～1.5厘米；顶端有残留茎基，有时下陷呈空洞状；表面灰棕色至暗棕色，粗糙，密生细长弯曲的根，有突起的节及根痕。质轻，易折断，断面略呈纤维状，黄白色至浅棕色，可见散生的棕色分泌腔，中央有髓。根长约1～5～10厘米，径约2～5毫米。表面有纵皱及横纹，并有须根痕，外皮易剥离；较难折断，断面中央无髓。气特异而芳香，味苦辛。以身子、整齐、香气浓者为佳。"}]},{"ID":"20240611162337-kz3o8ps","Type":"NodeParagraph","Properties":{"id":"20240611162337-kz3o8ps","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"主产河北、辽宁。吉林、内蒙古等地亦产。"}]},{"ID":"20240611162337-cvpdw9b","Type":"NodeParagraph","Properties":{"id":"20240611162337-cvpdw9b","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611162337-sjh86t0","Type":"NodeParagraph","Properties":{"id":"20240611162337-sjh86t0","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 藁本含挥发油，其中主要成分是3-丁基苯酞，蛇床酞内酯。辽藁本根含挥发油1.5％。泽芹鲜草含挥发油0.4％。"}]},{"ID":"20240611162337-ws43tyt","Type":"NodeParagraph","Properties":{"id":"20240611162337-ws43tyt","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611162337-1txy4a5","Type":"NodeParagraph","Properties":{"id":"20240611162337-1txy4a5","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 在试管内，15～30％藁本煎液对多种常见致病性皮肤真菌有抑制作用。"}]},{"ID":"20240611162337-m22klv1","Type":"NodeParagraph","Properties":{"id":"20240611162337-m22klv1","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611162337-y4i6bdq","Type":"NodeParagraph","Properties":{"id":"20240611162337-y4i6bdq","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 除去残茎，拣净杂质，洗净，润透后切片晒干。"}]},{"ID":"20240611162337-y4oxzwy","Type":"NodeParagraph","Properties":{"id":"20240611162337-y4oxzwy","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162337-cb3qhf4","Type":"NodeParagraph","Properties":{"id":"20240611162337-cb3qhf4","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 入膀胱经。"}]},{"ID":"20240611162337-354klfk","Type":"NodeParagraph","Properties":{"id":"20240611162337-354klfk","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"足太阳膀胱、手太阳小肠经。\""}]},{"ID":"20240611162337-j662z6h","Type":"NodeParagraph","Properties":{"id":"20240611162337-j662z6h","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入膀胱，兼入奇督。\""}]},{"ID":"20240611162337-r1jl3rt","Type":"NodeParagraph","Properties":{"id":"20240611162337-r1jl3rt","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162337-9fv8m45","Type":"NodeParagraph","Properties":{"id":"20240611162337-9fv8m45","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240611162337-mfe9tj1","Type":"NodeParagraph","Properties":{"id":"20240611162337-mfe9tj1","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"辛，温。\""}]},{"ID":"20240611162337-877a2n3","Type":"NodeParagraph","Properties":{"id":"20240611162337-877a2n3","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"微温。\""}]},{"ID":"20240611162337-g9vevsw","Type":"NodeParagraph","Properties":{"id":"20240611162337-g9vevsw","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"味甘辛，性温。\""}]},{"ID":"20240611162337-n1w824t","Type":"NodeParagraph","Properties":{"id":"20240611162337-n1w824t","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611162337-k4y0mef","Type":"NodeParagraph","Properties":{"id":"20240611162337-k4y0mef","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 血虚头痛忌服。"}]},{"ID":"20240611162337-ql3bxhm","Type":"NodeParagraph","Properties":{"id":"20240611162337-ql3bxhm","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶闾茹。\""}]},{"ID":"20240611162337-9p3lnf9","Type":"NodeParagraph","Properties":{"id":"20240611162337-9p3lnf9","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"畏青葙子。\""}]},{"ID":"20240611162337-j5e1l85","Type":"NodeParagraph","Properties":{"id":"20240611162337-j5e1l85","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"温病头痛，发热口渴或骨疼，及伤寒发于春夏，阳证头痛，产后血虚火炎头痛，皆不宜服。\""}]},{"ID":"20240611162337-wxdo3sc","Type":"NodeParagraph","Properties":{"id":"20240611162337-wxdo3sc","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162337-6478ys3","Type":"NodeParagraph","Properties":{"id":"20240611162337-6478ys3","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 散风寒湿邪。治风寒头痛，巅顶痛，寒湿腹痛，泄泻，疝瘕，疥癣。"}]},{"ID":"20240611162337-d7fmc4b","Type":"NodeParagraph","Properties":{"id":"20240611162337-d7fmc4b","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主妇人疝瘕，阴中寒，肿痛，腹中急，除风头痛。\""}]},{"ID":"20240611162337-6kerl0k","Type":"NodeParagraph","Properties":{"id":"20240611162337-6kerl0k","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辟雾露润泽；疗风邪亸曳，金疮。\""}]},{"ID":"20240611162337-s6obelr","Type":"NodeParagraph","Properties":{"id":"20240611162337-s6obelr","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治恶风流入腰，痛冷，能化小便，通血，去头风鼾疱。\""}]},{"ID":"20240611162337-j6h49ql","Type":"NodeParagraph","Properties":{"id":"20240611162337-j6h49ql","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治病疾，并皮肤疵皯、酒齄、粉刺。\""}]},{"ID":"20240611162337-7m8kfz9","Type":"NodeParagraph","Properties":{"id":"20240611162337-7m8kfz9","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑤《医学启源》：\"治头痛，胸痛，齿痛。\""}]},{"ID":"20240611162337-1dj72lk","Type":"NodeParagraph","Properties":{"id":"20240611162337-1dj72lk","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑥李杲：\"治头面及遍身皮肤风湿。\""}]},{"ID":"20240611162337-bsih8a2","Type":"NodeParagraph","Properties":{"id":"20240611162337-bsih8a2","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑦王好古：\"治督脉为病，脊强而厥。\""}]},{"ID":"20240611162337-e8qg772","Type":"NodeParagraph","Properties":{"id":"20240611162337-e8qg772","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"治痈疽，排脓内塞。\""}]},{"ID":"20240611162337-mwzrjlz","Type":"NodeParagraph","Properties":{"id":"20240611162337-mwzrjlz","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑨《本草正》：\"疗风湿泄泻，风痫雾露瘴疫。\""}]},{"ID":"20240611162337-f1phdan","Type":"NodeParagraph","Properties":{"id":"20240611162337-f1phdan","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"治风湿痛痒，头风目肿，泄泻疟痢。\""}]},{"ID":"20240611162337-krppixl","Type":"NodeParagraph","Properties":{"id":"20240611162337-krppixl","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162337-omqhduw","Type":"NodeParagraph","Properties":{"id":"20240611162337-omqhduw","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱。外用：煎水洗或研末调涂。"}]},{"ID":"20240611162337-xd9gdg2","Type":"NodeParagraph","Properties":{"id":"20240611162337-xd9gdg2","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611162337-8bfaava","Type":"NodeParagraph","Properties":{"id":"20240611162337-8bfaava","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" ①治寒邪郁于足太阳经，头痛及巅顶痛：藁本、川芎、细辛、葱头。煎服。（《广济方》）"}]},{"ID":"20240611162337-wksaff3","Type":"NodeParagraph","Properties":{"id":"20240611162337-wksaff3","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②治一切风偏正头痛，鼻塞脑闷，大解伤寒及头风，遍身疮癣，手足顽麻：川芎、细辛、白芷、甘草、藁本各等分。为末，每药四两，入煅了石膏末一斤，水和为丸，每一两作八丸。每服一丸，食后薄荷茶嚼下。（《普济方》白龙丸）"}]},{"ID":"20240611162337-sp647td","Type":"NodeParagraph","Properties":{"id":"20240611162337-sp647td","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"③治胃痉挛、腹痛：藁本五钱，苍术三钱，水煎服。（《新疆中草药手册》）"}]},{"ID":"20240611162337-x2p6kus","Type":"NodeParagraph","Properties":{"id":"20240611162337-x2p6kus","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"④治疥癣：藁本煎汤浴之，及用浣衣。（《小儿卫生总微论方》）"}]},{"ID":"20240611162337-4vwxw3x","Type":"NodeParagraph","Properties":{"id":"20240611162337-4vwxw3x","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑤干洗头屑：藁本、白芷等分。为末，夜掺发内，明早梳之，垢自去。（《便民图纂》）"}]},{"ID":"20240611162337-x1jhlha","Type":"NodeParagraph","Properties":{"id":"20240611162337-x1jhlha","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑥治鼻上面上赤：藁本研细末，先以皂角水擦动赤处，拭干，以冷水或蜜水调涂，干再用。（《鸡峰普济方》藁本散）"}]},{"ID":"20240611162337-sjy2yvu","Type":"NodeParagraph","Properties":{"id":"20240611162337-sjy2yvu","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611162337-xva9aum","Type":"NodeParagraph","Properties":{"id":"20240611162337-xva9aum","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 治疗神经性皮炎，用50％藁本注射液于病损处皮下注射。一般每个病损每周注射2次，每次5～10毫升；如病损较多，或范围较大，可每日轮流注射，以便每周内每个病损均能注射2次。每次注射后的晚间，局部可用热敷，避免形成硬结。经治139例，观察1～4个月，痊愈（皮疹全部消退，不痒）46例，显效（皮疹2/3以上消退，无明显痒感）44例，有效（皮疹部分消退，仍有一定痒感）47例，无效2例。有效率为98.5％（其中6例曾并用少量0.5％氢化可的松乳剂）。一般在注射2～4次后痒感减退，逐渐好转；病损较小者8～10次可痊愈，最多达20次。在治程中一般无明显副作用，个别有过敏现象，或出现荨麻疹样皮疹；有的注射部位发生肿胀疼痛，可对症处理。发生过敏者应停药。"}]},{"ID":"20240611162337-3ualp11","Type":"NodeParagraph","Properties":{"id":"20240611162337-3ualp11","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611162337-13v99op","Type":"NodeParagraph","Properties":{"id":"20240611162337-13v99op","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" ①张元素：\"藁本，乃太阳经风药，其气雄壮，寒气郁于本经头痛必用之药，巅顶痛，非此不能治。与木香同用，治雾露之清邪中于上焦；与白芷同作面脂，既治风，又治湿，亦各从其类也。\""}]},{"ID":"20240611162337-02vae7c","Type":"NodeParagraph","Properties":{"id":"20240611162337-02vae7c","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"藁本，升阳而发散风湿，上通巅顶，下达肠胃之药也。其气辛香雄烈，能清上焦之邪，辟雾露之气，故治风头痛，寒气犯脑以连齿痛。又能利下焦之湿，消阴障之气，故兼治妇人阴中作痛，腹中急疾，疝瘕淋带，及老人风客于胃，久利不止。大抵辛温升散，祛风寒湿气于巨阳之经为专功，若利下寒湿之证，必兼下行之药为善。\""}]},{"ID":"20240611162337-imk16os","Type":"NodeParagraph","Properties":{"id":"20240611162337-imk16os","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"今人只知藁本为治颠顶头脑之药，而《本经》治妇人疝瘕，腹中急，阴中寒等证，皆大阳经寒湿为病，亦属客邪内犯之侯，故用藁本去风除湿，则中外之疾皆痊，岂特除风头痛而已哉。\""}]},{"ID":"20240611162337-u7jjh9p","Type":"NodeParagraph","Properties":{"id":"20240611162337-u7jjh9p","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"④《本草求真》：\"藁本，书言能治胃风泄泻，又治粉刺酒齄，亦是风干太阳，连累而及，治则与之俱治，岂但治风头痛而已哉。或谓其性颇有类于芎藭，皆能以治头痛，然一主于肝胆，虽行头目，而不及于巅顶，一主太阳及督，虽其上下皆通，而不兼及肝胆之为异耳。\""}]},{"ID":"20240611162337-6bb0jt3","Type":"NodeParagraph","Properties":{"id":"20240611162337-6bb0jt3","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"藁本味辛气温，上行升散，专主太阳太阴之寒风寒湿，而能疏达厥阴郁滞，功用与细辛、川芎、羌活近似。《本经》主妇人疝瘕、阴中寒、肿痛、腹中急，皆清阳不振，厥阴之气郁窒不伸为病，温以和之，升以举之，解结除寒，斯急痛可巳，疝瘕可除。而阴虚内热、肝络结滞之疝瘕急痛，非其治也。《别录》谓辟雾露润泽者，温升助阳，能胜寒湿，此即仲景所谓清邪中上之病，亦即经言阳中雾露之气也。又谓疗风邪嚲曳，则风寒袭络，而经掣不仁，步履无力之症，庶几近之，亦有阴虚无力，痿躄不用，而肢体嚲曳者，则更非风药所可妄试。\""}]},{"ID":"20240611162337-ams7pgx","Type":"NodeParagraph","Properties":{"id":"20240611162337-ams7pgx","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611162337-abymmg5","Type":"NodeParagraph","Properties":{"id":"20240611162337-abymmg5","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 某些地区作藁本入药的尚有下列几种：云南产的黄藁本为同属植物滇藁本的根。新疆所产藁本为伞形科植物新疆藁本的根。江苏产的山藁本（又名：土藁本）为伞形科植物泽芹或骨缘当归的全草。"}]},{"ID":"20240611162337-bel4ees","Type":"NodeParagraph","Properties":{"id":"20240611162337-bel4ees","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162337-oj2b6zx","Type":"NodeParagraph","Properties":{"id":"20240611162337-oj2b6zx","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611162337-yu0ipxb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162337-yu0ipxb","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"《中华本草》：藁本"}]},{"ID":"20240611162337-m13s1wv","Type":"NodeParagraph","Properties":{"id":"20240611162337-m13s1wv","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162337-nbfq8v7","Type":"NodeParagraph","Properties":{"id":"20240611162337-nbfq8v7","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" Gǎo Běn"}]},{"ID":"20240611162337-3qav4tt","Type":"NodeParagraph","Properties":{"id":"20240611162337-3qav4tt","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162337-nejxf03","Type":"NodeParagraph","Properties":{"id":"20240611162337-nejxf03","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 藁茇、鬼卿、地新、山茝、蔚香、微茎、藁板"}]},{"ID":"20240611162337-hgy0uwd","Type":"NodeParagraph","Properties":{"id":"20240611162337-hgy0uwd","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611162337-qu6zkko","Type":"NodeParagraph","Properties":{"id":"20240611162337-qu6zkko","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" Ligusticum sinense Oliv. Chinese Ligusticum, Jehol Ligusticum, Chinese Ligusticum Rhizome Jehol Ligusticum Rhizome"}]},{"ID":"20240611162337-6u17g1e","Type":"NodeParagraph","Properties":{"id":"20240611162337-6u17g1e","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611162337-ijg4b8h","Type":"NodeParagraph","Properties":{"id":"20240611162337-ijg4b8h","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611162337-r4g9zlm","Type":"NodeParagraph","Properties":{"id":"20240611162337-r4g9zlm","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"1.《别录》：藁本实，主风流四肢。"}]},{"ID":"20240611162337-tbdmknn","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611162337-tbdmknn","updated":"20240611162337"},"Children":[{"ID":"20240611162337-l3w08kl","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240611162337-l3w08kl","updated":"20240611162337"},"Children":[{"ID":"20240611162337-7uy24k9","Type":"NodeParagraph","Properties":{"id":"20240611162337-7uy24k9","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"陶弘景：藁本俗中留用芎穷根须，其形气乃相类，而《桐君药录》说草穷苗似藁本，论说花实皆不同，所生处又异，今东山别有藁本，形气甚相似，惟长大耳。"}]}]}]},{"ID":"20240611162337-xhhkwoj","Type":"NodeParagraph","Properties":{"id":"20240611162337-xhhkwoj","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：藁本，今西川、河东州郡及兖州、杭州有之。叶似白英，香又似苇劳，但草劳似水芹而大，菱本叶细耳。根上苗下似禾霹，故以名之。五月有白花，七、八月结子，根紫色。"}]},{"ID":"20240611162337-r045c9q","Type":"NodeParagraph","Properties":{"id":"20240611162337-r045c9q","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162337-cds6wtv","Type":"NodeParagraph","Properties":{"id":"20240611162337-cds6wtv","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物藁本和辽藁本的根茎和根。"}]},{"ID":"20240611162337-xwsg40b","Type":"NodeParagraph","Properties":{"id":"20240611162337-xwsg40b","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Ligusticum sinense Oliv.2.Ligusticum jeholense(Nakai et Kitag.) Nakai et Kitag. [Cniium jeholense Nakai et Kitag.]"}]},{"ID":"20240611162337-773zv72","Type":"NodeParagraph","Properties":{"id":"20240611162337-773zv72","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种2年即可收获。在9-10月倒苗后，挖取地下部分，去掉泥土及残茎，晒干或炕干。"}]},{"ID":"20240611162337-7nzzdc3","Type":"NodeParagraph","Properties":{"id":"20240611162337-7nzzdc3","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611162337-8lxq51c","Type":"NodeParagraph","Properties":{"id":"20240611162337-8lxq51c","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1000-2700m的林下、沟边草丛中及湿润的水滩边。生于海拔1250-2500m的林下、草甸、林缘、阴湿石砾山坡及沟边。"}]},{"ID":"20240611162337-wnusupg","Type":"NodeParagraph","Properties":{"id":"20240611162337-wnusupg","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、浙江、江西、河南、湖南、湖南、湖北、四川等地。分布于吉林、辽宁、湖北、山西、山东等地"}]},{"ID":"20240611162337-nb3ub7b","Type":"NodeParagraph","Properties":{"id":"20240611162337-nb3ub7b","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611162337-xc1v2ca","Type":"NodeParagraph","Properties":{"id":"20240611162337-xc1v2ca","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高达1m。根茎发达，具膨大的结节。茎直立，圆柱形，中空，有纵直沟纹。基生叶具长柄，柄长可达20cm；叶片轮熟宽三角形，长10-15cm，宽15-18cm，二回三出式羽状全裂，第一回羽片轮廓长圆状卵形，长6-10cm，宽5-7cm，下部羽片具柄，柄长3-5cm，基部略膨大；末回裂片卵形，长约3cm，宽约2cm，先端渐尖，边缘具状浅裂，有小尖头，两面无毛，仅脉上有短柔毛，顶生小羽片先端渐尖至尾状；茎中部叶较大；茎 上部叶近无柄，基部膨大成卵形抱茎的鞘。复伞形花序顶生或侧生；总苞片6-10，线形至羽状细裂，长约6mm；伞辐14-30，长达5cm，四棱形，有短糙毛；小伞花序有小总苞片约10片，线形或窄披针形，长3-4mm；花小，无萼齿；花瓣白以，倒卵形，先端微凹，具内折小尖头；雄蕊5；花柱基隆起，花柱长，向外反曲。双悬果长圆卵形，长约4mm，宽2-2.5mm，先端狭，分生果背棱突起，侧棱扩大成翅状，背棱棱槽内有油管1-3，侧棱棱槽内有油管3，合生面有油管4-6，胚乳腹面平直。花期7-9月，果期9-10月。多年生草本，高30-80cm。根茎较知；根圆锥形，分叉，表面深褐色。茎直立，圆柱形，中空，表面有纵条纹，常带紫色。叶具柄，基生叶叶柄长达19cm，二至三回三出式羽状全裂，第一回裂片4-6对，最下一对有较长的柄，柄长2-5cm；第二回裂片常无柄；末回裂片卵形至菱状卵形，长2-3cm，宽1-2cm，基部心形至楔形，边缘常3-5浅裂，裂片具齿，齿端有小尖形花序顶生或侧生，直径3-7cm；总苞片2，线形，长约1cm，被糙毛，边缘狭膜质，早落；伞辐8-16，长2-3cm；小总苞片8-10，钻形，长3-5mm，被糙毛；小伞形花序有花15-20；萼齿不明显；花瓣白色，长圆状倒卵形，具内折小舌片；花柱基隆起，半球形，花柱长，果期向下反曲。双悬果椭圆形，长3-4mm，宽2-2.5mm，分生果背棱突起，侧棱狭翅状，棱槽内有油管1，少为2，合生面2-4，胚乳腹面平直。花期7-9月，果期9-10月。"}]},{"ID":"20240611162337-6u5pojv","Type":"NodeParagraph","Properties":{"id":"20240611162337-6u5pojv","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611162337-oo6e5vl","Type":"NodeParagraph","Properties":{"id":"20240611162337-oo6e5vl","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜冷凉湿润气候，耐寒，怕涝。对土壤要求不严格，但以土层深厚、疏松肥沃，排水良好的砂质壤土栽种生长最好，不宜在粘土和贫瘠干燥的地方种植。忌连作。"}]},{"ID":"20240611162337-fych7f7","Type":"NodeParagraph","Properties":{"id":"20240611162337-fych7f7","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"栽培技术 用根茎繁殖。于9-10月收获时，先无病、肥大的根茎，切去殖茎，去掉细长的支根，将结节状根茎，按芽胞切成小段，繁段应有2-3节，随割随种，按行株距各约33cm开穴，深10-13cm，每穴放根茎1-2段，施人畜粪水后，盖土杂肥或火灰一把萌芽前，晚秋10月下旬地上部枯萎后，将根刨出，每丛分成3-4株不等，并带有芽。穴栽，每穴1小丛，穴距30cm×30cm。春栽覆土至根芽上3cm；秋栽覆土3-4.5cm。"}]},{"ID":"20240611162337-p1q1l8r","Type":"NodeParagraph","Properties":{"id":"20240611162337-p1q1l8r","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"田间管理 第2年中耕除草、追肥各3次，第1次在3-4月出苗后，第2次在6月，第3次在10月倒苗后，前2次施人粪尿水，第3次冬前施土杂肥或火灰，施后培土防冻，第3年3-4月中耕除草、追肥肉各1次。辽藁本每年中耕除草3-次，追肥后更应注意及时除草，中耕时不宜过深，以免碰伤根茎。春天返青前每1hm2施厩肥37500kg，开沟施入，或于返青后1个月浇稀粪1次；6月中旬，每亩施过磷酸钙15kg，施后浇水。"}]},{"ID":"20240611162337-i69l90m","Type":"NodeParagraph","Properties":{"id":"20240611162337-i69l90m","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162337-r800l8b","Type":"NodeParagraph","Properties":{"id":"20240611162337-r800l8b","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）藁本 根茎呈不规则结节状圆柱形，稍扭曲，略有分枝，长3-10cm。表面共同棕色暗棕色，粗糙，有纵皱纹，栓皮易剥落，上端有一至数个圆孔状茎基，下侧有多数点状突起的根痕及残根。体轻，质较硬，易折断，断面黄色或黄白色，纤维性。气浓香，味辛、苦，微麻。"}]},{"ID":"20240611162337-kdxh60o","Type":"NodeParagraph","Properties":{"id":"20240611162337-kdxh60o","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"（2）辽藁本 根茎呈不规由的团块状或柱状，长2-10cm，直径0.5-1.5cm。表面棕褐色，上端有丛生的叶基及突起的节，下端有多数细长弯曲的根。"}]},{"ID":"20240611162337-a26zcsl","Type":"NodeParagraph","Properties":{"id":"20240611162337-a26zcsl","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"均以个大体粗、质坚，香气浓郁者为佳。"}]},{"ID":"20240611162337-dy21fgh","Type":"NodeParagraph","Properties":{"id":"20240611162337-dy21fgh","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根茎横切面：（1）藁本木栓层棕色，有8-10余列细胞。皮层狭窄。维管束外韧型，约20余个排列成环；韧皮部宽广，散有根迹维管束和较多的油室，油室直径64-200μm，内含黄色油状物；形居层成环；木质部导管直径14-40μm。其中部有纤维束连接成环状。"}]},{"ID":"20240611162337-t1vjlut","Type":"NodeParagraph","Properties":{"id":"20240611162337-t1vjlut","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"（2）辽藁本 与藁本相似，但韧皮部油室直径45-200μm，木质部导管直径10-27μm，木纤维群发达，近中心的纤维群有的被3-4列栓化细胞所包围。髓部具少数油室。"}]},{"ID":"20240611162337-rpdcofx","Type":"NodeParagraph","Properties":{"id":"20240611162337-rpdcofx","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611162337-n1hfzcr","Type":"NodeParagraph","Properties":{"id":"20240611162337-n1hfzcr","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 急性毒性试验用寇氏法求得小鼠灌胃藁本中性油72小时，半数致死量为70.17±4.95g/kg（按生药计算）。"}]},{"ID":"20240611162337-mee00sc","Type":"NodeParagraph","Properties":{"id":"20240611162337-mee00sc","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611162337-ykpqf2w","Type":"NodeParagraph","Properties":{"id":"20240611162337-ykpqf2w","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 1.藁本含挥发油0.85%，主成分为：新蛇床内酯（neocindilide)占25%，柠檬烯（limonene)占14.44%，蛇床内酯（cnidilide)占10.78%，4-松油醇（4-terpineol)占8.0%；还含：乙酸4-松油醇酯（4-terpinyl acetate)，棕榈酸（palmitic acid)，α-柏木烯（α-cedrene)，β-，ξ-芹子烯（selinene)，2，3-二氯-4-甲基呋喃（2，3-dihydro-4-methylfuran)，庚醛（heptanal)，α蒎烯（α-pinene)，3-蒈烯（△△2-carene)，香桧烯（sabinene)，β-罗勒烯-Y（β-ocimene-Y)，异松油烯（terpinolone)，异戊酸-3-甲基丁基酯（3-methyl-butlisovalerate)，对甲氧基乙酰苯酮（p-methoxyacetophenone)，α-及β-榄香烯（el-emene)，ξ-愈创木烯（ξ-guaiene)，雪松烯（himachalene)，γ-荜澄茄烯（γ-cadinene)，肉豆蔻醚（myristicin)，9，10-十八碳二烯酸（9，10-octadecadienoic acid)[1]等。另有报道，挥发油中含：α-及β-蒎烯，香桧烯，樟烯（camphene)，月桂烯（myrcene)，3-蒈烯，α-及β-水芹烯（phellandrene)，对聚伞花素（p-cymene)，α-及γ-松油烯（terpinene)，异松油烯，1-氧基-4-甲基苯（1-ethoxyl-4-methyl-benene)，樟脑（camphor)，戊苯（pent-ylbenzene)，4-松油醇，薰衣草醇（lavandulol)，α-松油醇（α-terpineol)，桃金娘醇（myrtenol)，马革命鞭草烯酮（verbenone)，橙花醇（nerol)，橙花醛（neral)，牻牛儿醇（geraniol)，牻牛儿醛（geranial)，乙酸龙脑酯（bornylacetate)，乙酸-4-松油醇酯香荆芥酚（carvacrol)，α-（王古）（王巴）烯（α-copaene)，β-榄香烯，β-丁香烯（β-caryophyllene)，α-及β-金合欢烯（farnesene)，香橙烯（aromadendrene)，α葎草烯（α-humulene)，α-姜黄烯（α-curcum-ene)，γ-衣兰油烯（γ-muurolene)，γ-广藿香烯（γ-patchoulene)，β-芹子烯，β-荜澄茄烯（β-cadinene)，异肉豆蔻醚（isomyristicin)，榄香脂素（elemincin)，3-亚丁基苯酞（3-cadinene phtylidene)，新蛇床内酯[2]等，藁本还含3-亚丁基-4，5-二氢苯酞（3-butylidene4,5-dihydrophthalide)，蔗糖（sucrose)[3]，对苯干甲酸二甲酯（dimethylp-phthalate)，洋川穹内酯（senkyunolide)A、G、H、I，β-谷甾醇（β-sitosterol)[4]，阿魏酸（ferulicacid)[5].2.辽藁本含挥发油1.3%，主成分为：β-水芹烯占33.32%，乙酸4-松油醇酯占13.82%，肉豆蔻醚（myristicin)占9.05%，藁本内酯（ligustilide)占6.23%；还含异松油烯，蛇床内酯，4-松油醇，β-及ξ-愈创木烯，亚丁基苯酞，辣薄荷烯酮（piperitenone)，α-蒎烯，α罗勒烯（α-ocimene)，β-萝勒烯-Y，枯酸（cumic acid)，1，4-十一碳二烯（1，4-undecadiene)，α-、β-及ξ-榄香烯，榄香脂素，乙酸香茅醇酯（citronellyl acetate)，丙酸橙花醇酯（nerol propionate)，2，3-二氢-4，6，8-三甲基-（2H）-萘烯酮[2，3-dihydro-4,6,8-trimethyl-(2H)-naphthalenone][1]。"}]},{"ID":"20240611162337-54ha575","Type":"NodeParagraph","Properties":{"id":"20240611162337-54ha575","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611162337-f3f5p7k","Type":"NodeParagraph","Properties":{"id":"20240611162337-f3f5p7k","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" ①对中枢神经的作用：藁本中性油用1/10、1/5 半数致死量的剂量（小鼠灌胃的半数致死量 为70.17±4.95g(生药)/kg）灌胃，能抑制小鼠自发活动，对抗苯丙胺引起的运动兴奋，加强硫喷妥钠的催眠作用，对抗酒石酸锑钾引起的扭体反应，延长热板反应时间，降低实验性发热兔体温及正常小鼠体温。②抗炎：藁本中性油1/10、1/5 半数致死量剂量（半数致死量同上）灌胃，抑制二甲苯引起的小鼠耳廓肿胀；抑制角叉菜胶引起的大鼠足肿胀。③对肠和子宫平滑肌的作用：藁本中性油1.4×10-3－5.6×10-3g/ml能抑制兔和豚鼠离体肠管的收缩，并能对抗组胺、乙酰胆碱、烟碱、毒扁豆碱、酚妥拉明和氯化钡收缩肠管的作用；70、140g/kg灌胃，抑制小鼠小肠推进运动，也抑制蓖麻油引起的小鼠腹泻；7×10-3－14×10-3g/ml抑制兔离体子宫，并能对抗催产素兴奋子宫的作用。"}]},{"ID":"20240611162337-xudxxo8","Type":"NodeParagraph","Properties":{"id":"20240611162337-xudxxo8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"1.抑菌作用：15%煎剂用平板稀释法，对许兰氏毛菌等皮肤癣菌有抑制作用。"}]},{"ID":"20240611162337-mqi1mll","Type":"NodeParagraph","Properties":{"id":"20240611162337-mqi1mll","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"2.镇静、镇痛、解热和抗炎作用：2.1．藁本中性油能抑制小鼠的自发活动及对抗苯丙胺引起的运动性兴奋，能加强硫贲妥钠的催眠作用，能对抗酒石酸锑钾引起的小鼠扭歪反应及明显延长热板反应的时间，并降低致热动物的体温及正常小鼠的体温，还能对抗二甲苯炎症。"}]},{"ID":"20240611162337-h4te5yx","Type":"NodeParagraph","Properties":{"id":"20240611162337-h4te5yx","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"2.2．藁本中性油能抑制醋酸提高小鼠腹腔毛细血管渗透性及组胺提高大鼠皮肤毛细血管渗透性，抑制二甲苯所致小鼠耳壳肿胀，抑制角叉菜胶所致大鼠足跖肿胀及摘除肾上腺大鼠注射角叉菜胶所致的足跖肿胀。但不能抑制大鼠塑料环肉芽肿增生，也不能延长摘除肾上腺大鼠的生存时间。提示其抗炎症作用与垂体－肾上腺系统无明显关系，推测其可能是通过抑制前列腺素产生抗炎作用。"}]},{"ID":"20240611162337-hs3cjp2","Type":"NodeParagraph","Properties":{"id":"20240611162337-hs3cjp2","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"2.3．藁本中成分之一阿魏酸（Ferulicacid）能减少扭歪反应及延长环己烯巴比妥钠的睡眠时间，此外，另一成分藁本内酯具有镇静、催眠、降温以及抗氯胺酮兴奋作用。"}]},{"ID":"20240611162337-eh11u2q","Type":"NodeParagraph","Properties":{"id":"20240611162337-eh11u2q","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"3.平滑肌作用：3.1．对肠和子宫平滑肌的抑制作用：藁本中性油有抑制离体兔小肠收缩振幅、抑制离体豚鼠回肠张力，抑制离体兔子宫张力的作用；还可以对抗组织胺、乙酰胆碱、烟碱、毒扁豆碱、酚妥拉明和氯化钡引起的肠活动兴奋，对抗催产素引起的子宫肌张力增变；还可抑制小鼠小肠推进运动，抑制蓖麻油引起的小鼠腹泻。结果表明，藁本中性油具有抑制肠及子宫平滑肌的作用。"}]},{"ID":"20240611162337-j7pania","Type":"NodeParagraph","Properties":{"id":"20240611162337-j7pania","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"3.2．平喘作用：3.2.1.藁本内脂的平喘作用：给豚鼠腹腔注射0.14ml/kg 藁本内酯能缓解组织胺与乙酰胆碱的致喘反应，其效力约与氨茶碱50mg/kg相仿，在豚鼠肺溢流实验，静脉注射藁本内酯 0.08ml/kg能对抗组织胺2-10μg/kg所引起的支气管收缩。藁本内酯不仅对豚鼠离体气管条有松驰作用，而且对乙酰胆碱、组织胺以及氯化钡引起的气管平滑肌痉挛收缩，有明显的解痉作用。该作用不能被心得安所阻断。藁本内酯对豚鼠肺、肠组织内cAMP及cGMP的含量均无明显影响，认为有可能作用于平滑肌本身。"}]},{"ID":"20240611162337-7rsxubi","Type":"NodeParagraph","Properties":{"id":"20240611162337-7rsxubi","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"3.2.2.苯酞及其衍生物的平喘作用：苯酞及其衍生物乙烯基内酯、丙烯基夫内酯、正丁烯夫内酯及正丁基夫内酯对动物气管平滑肌均具有显着的松弛作用。其作用强度最终无明显差异，认为正丁烯夫内酯及其同系物的平喘作用，为其母核苯酞所具有，六种化合物的作用速度与其化学结构之间，似有规律性变化，其中以苯酞和乙烯基内酯为最快，随着侧链的增长似有减慢的趋势。不具双键的正丁基夫内酯作用速度较具有双键的正丁烯夫内酯为快。苯酞松弛气管平滑肌的作用并非通过兴奋气管平滑肌上β-受体或促进肾上腺素能神经释放介质所引起。其与M一胆碱受体和组胺受体关系不大。苯酞可迅速而显着地对抗氯化钡的作用，表明它可能是直接作用使气管平滑肌松弛。上述化合物均具有一定的毒性及对胃肠道的刺激作用。"}]},{"ID":"20240611162337-rtjagx9","Type":"NodeParagraph","Properties":{"id":"20240611162337-rtjagx9","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611162337-a91h8fb","Type":"NodeParagraph","Properties":{"id":"20240611162337-a91h8fb","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 除去残茎，拣净杂质，洗净，润透后切片晒干。"}]},{"ID":"20240611162337-vj9xlux","Type":"NodeParagraph","Properties":{"id":"20240611162337-vj9xlux","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611162337-spi8met","Type":"NodeParagraph","Properties":{"id":"20240611162337-spi8met","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取粉末0.5g，加入已醚适量，冷浸1h，滤过。滤液浓宿至1ml，加7%盐酸羟胺甲醇液2-3滴、20%氢氧化钾乙醇液3滴，在水浴上微热，冷却后，加稀盐酸调节Ph至3-4，再加1%三氯化铁乙醇液1-2滴，显紫红色。（检查香豆素和内酯类）（2）薄层色谱 取粉末2g，加乙醚6ml，冷浸4h，滤过。滤液浓缩至干，残潭用氯仿溶解至1.0ml，作供试品溶液。另以阿魏酸为对照品。分别点样于同一硅胶G-CMC薄板上，以氯仿苯-甲醇（20：20：6）展开。置紫外光灯下观察荧光。供试品液色谱在与对照品液色谱的相应位置显相同荧光色斑。"}]},{"ID":"20240611162337-gqmh4xx","Type":"NodeParagraph","Properties":{"id":"20240611162337-gqmh4xx","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"（3）紫外吸收光谱 本品挥发油配制成0.2%（ml/ml）的无水乙醇溶液，在波长320nm处有一低矮的吸收峰。"}]},{"ID":"20240611162337-wla6ag0","Type":"NodeParagraph","Properties":{"id":"20240611162337-wla6ag0","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"（4）红外光谱 挥发油用液膜法测定红外吸收光谱，在次数2920cm-1、2860cm-1、1765cm-1处及吸收峰。"}]},{"ID":"20240611162337-ry47pnz","Type":"NodeParagraph","Properties":{"id":"20240611162337-ry47pnz","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162337-1sirsy2","Type":"NodeParagraph","Properties":{"id":"20240611162337-1sirsy2","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 归膀胱经"}]},{"ID":"20240611162337-xkj57gi","Type":"NodeParagraph","Properties":{"id":"20240611162337-xkj57gi","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162337-hb1f6w5","Type":"NodeParagraph","Properties":{"id":"20240611162337-hb1f6w5","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 味辛；性湿"}]},{"ID":"20240611162337-l68iorf","Type":"NodeParagraph","Properties":{"id":"20240611162337-l68iorf","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611162337-c0iau9u","Type":"NodeParagraph","Properties":{"id":"20240611162337-c0iau9u","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 血虚头痛忌服。"}]},{"ID":"20240611162337-s3oxfz8","Type":"NodeParagraph","Properties":{"id":"20240611162337-s3oxfz8","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162337-aoz4set","Type":"NodeParagraph","Properties":{"id":"20240611162337-aoz4set","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 祛风胜湿；散寒止痛。主风寒头痛；巅顶疼痛；风湿痹痛；疥癣；寒湿泄泻；腹痛；疝瘕"}]},{"ID":"20240611162337-vmibm43","Type":"NodeParagraph","Properties":{"id":"20240611162337-vmibm43","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162337-b37l24t","Type":"NodeParagraph","Properties":{"id":"20240611162337-b37l24t","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤， 3-10g；或入丸、散。外用：适量，煎水洗；或研末调涂。"}]},{"ID":"20240611162337-v7yhflu","Type":"NodeParagraph","Properties":{"id":"20240611162337-v7yhflu","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611162337-wc5fdfk","Type":"NodeParagraph","Properties":{"id":"20240611162337-wc5fdfk","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主妇人疝瘕，阴中寒，肿痛，腹中急，除风头痛。"}]},{"ID":"20240611162337-blquf89","Type":"NodeParagraph","Properties":{"id":"20240611162337-blquf89","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"2.《药性沦》：治恶风流入腰，痛冷，能化小便，通血，去头风痛。"}]},{"ID":"20240611162337-ujgsaui","Type":"NodeParagraph","Properties":{"id":"20240611162337-ujgsaui","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：治痫疾，并皮肤疵皯、酒渣、粉刺。"}]},{"ID":"20240611162337-dutm2a4","Type":"NodeParagraph","Properties":{"id":"20240611162337-dutm2a4","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162337-m4pocmn","Type":"NodeParagraph","Properties":{"id":"20240611162337-m4pocmn","updated":"20240611162337"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611162339-pasc8ze","Type":"NodeThematicBreak","Properties":{"id":"20240611162339-pasc8ze"}},{"ID":"20240611162340-bt8v4zr","Type":"NodeParagraph","Properties":{"id":"20240611162340-bt8v4zr"}}]}