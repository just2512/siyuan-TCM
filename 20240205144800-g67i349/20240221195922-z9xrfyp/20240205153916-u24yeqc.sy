{"ID":"20240205153916-u24yeqc","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205153916-u24yeqc","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205153916-u24yeqc\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206084049-5koie2q\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611162340-bt8v4zr\u0026quot;,\u0026quot;scrollTop\u0026quot;:2900,\u0026quot;focusId\u0026quot;:\u0026quot;20240625101140-e5mvc2d\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"185藁本","type":"doc","updated":"20240820093813"},"Children":[{"ID":"20240206084049-5koie2q","Type":"NodeParagraph","Properties":{"id":"20240206084049-5koie2q","updated":"20240206084052"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产四川、湖北、湖南、江西。\n【性状】\t根茎呈不规则结节状圆柱形，稍扭曲，有分枝，长310cm，直径12cm。表面棕褐色或暗棕色，粗糙，有纵皱纹，上侧残留数个凹陷的圆形茎基，下侧有多数点状突起的根痕及残根。体轻，质较硬，易折断，断面黄色或黄白色，纤维状。气浓香，味辛、苦、微麻。\n【性味】\t辛，温。\n【功效】\t祛风，散寒，除湿，止痛。用于风寒感冒，巅顶疼痛，风湿肢节痹痛。"}]},{"ID":"20240206084042-ltgkksu","Type":"NodeParagraph","Properties":{"id":"20240206084042-ltgkksu","updated":"20240206084042"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206084042-vosklo0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205155004-c9s0ec8","Type":"NodeParagraph","Properties":{"id":"20240205155004-c9s0ec8","updated":"20240205155004"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本-20240205155004-act0iph.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820091123-1weghmz","Type":"NodeParagraph","Properties":{"id":"20240820091123-1weghmz","updated":"20240820091249"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 1-20240820091123-667qz74.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 378px;","style":"width: 368px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 2-20240820091206-o67pf0x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 368px;\" parent-style=\"width: 378px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 353px;","style":"width: 343px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藁本 3-20240820091249-40fba93.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 343px;\" parent-style=\"width: 353px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820091350-4lrk12g","Type":"NodeParagraph","Properties":{"id":"20240820091350-4lrk12g","updated":"20240820093005"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 630px;","style":"width: 620px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藁本5"},{"Type":"NodeCloseBracke