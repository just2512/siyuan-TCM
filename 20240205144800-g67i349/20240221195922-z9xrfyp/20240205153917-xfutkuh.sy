tyle":"width: 375px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"防风 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/防风 17-20240807092300-6db494b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 375px;\" parent-style=\"width: 385px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 407px;","style":"width: 397px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"防风 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/防风 15-20240807091531-2z0kqb5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 397px;\" parent-style=\"width: 407px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806171258-8ppakrg","Type":"NodeParagraph","Properties":{"id":"20240806171258-8ppakrg","updated":"20240806171432"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：伞形科植物大多相似，防风跟蛇床很像，不同的是蛇床的根部为絮状，防风的根部像萝卜；"}]},{"ID":"20240913155614-nxpmlqs","Type":"NodeParagraph","Properties":{"id":"20240913155614-nxpmlqs","updated":"20240913160120"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"十注：防风、升麻、当归、前胡、独活、白芷长得都太像，虽附有辨别方法，但辨别仍有难度；请在专业的老师指导下分辨。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240616133343-ba7ozbo","Type":"NodeThematicBreak","Properties":{"id":"20240616133343-ba7ozbo"}},{"ID":"20240616133407-3hmiv60","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133407-3hmiv60","updated":"20240616133411"},"Children":[{"Type":"NodeText","Data":"防风《神农本草经》"}]},{"ID":"20240616133407-695yk92","Type":"NodeParagraph","Properties":{"id":"20240616133407-695yk92","updated":"20240616133407"},"Children":[{"Type":"NodeText","Data":"味甘温，无毒。"}]},{"ID":"20240616133407-tf7j7o3","Type":"NodeParagraph","Properties":{"id":"20240616133407-tf7j7o3","updated":"20240616133407"},"Children":[{"Type":"NodeText","Data":"主大风，头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹（《御览》作痛），烦满。久服轻身。一名铜芸（《御览》作芒）。生川泽。"}]},{"ID":"20240616133407-mpsz647","Type":"NodeParagraph","Properties":{"id":"20240616133407-mpsz647","updated":"20240616133407"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：防风一名回云，一名回草，一名百枝，一名蕳根，一名百韭，一名百种，神农黄帝岐伯桐君雷公扁鹊甘无毒，李氏小寒，或生邯郸上蔡，正月生叶，细圆，青黑黄白，五月花黄，六月实黑，三月十月采根，日干，琅邪者良（《御览》）。"}]},{"ID":"20240616133407-46jgzq5","Type":"NodeParagraph","Properties":{"id":"20240616133407-46jgzq5","updated":"20240616133407"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名茴草，一名百枝，一名屏风，一名蕳根，一名百蜚，生沙苑，及邯郸，琅邪，上蔡，二月十月采根，暴干。"}]},{"ID":"20240616133407-1z6xqq6","Type":"NodeParagraph","Properties":{"id":"20240616133407-1z6xqq6","updated":"20240616133407"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：防风出三辅，白者善。"}]},{"ID":"20240616133520-qgpz3rw","Type":"NodeThematicBreak","Properties":{"id":"20240616133520-qgpz3rw"}},{"ID":"20240616133521-jb7dkh6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133521-jb7dkh6","updated":"20240616133525"},"Children":[{"Type":"NodeText","Data":"防风《本草新编》"}]},{"ID":"20240616133521-ug5q4sd","Type":"NodeParagraph","Properties":{"id":"20240616133521-ug5q4sd","updated":"20240616133521"},"Children":[{"Type":"NodeText","Data":"防风，味甘、辛，气温，升也，阳也，无毒。系太阳本经之药，又通行脾、胃二经。古人曾分上、中、下以疗病，其实，治风则一。盖随所用而听令，从各引经之药，无所不达，治一身之痛，疗半身之风，散上下之湿，祛阴阳之火，皆能取效。但散而不收，攻而不补，可暂时少用以成功，而不可经年频用以助虚耳。"}]},{"ID":"20240616133521-8jwgg4z","Type":"NodeParagraph","Properties":{"id":"20240616133521-8jwgg4z","updated":"20240616133521"},"Children":[{"Type":"NodeText","Data":"或问通圣散，专恃防风以散风邪，可常用乎？曰∶此方暂服尚不可，乌可常哉。盖防风散人真气，即以之散风邪，亦未可专恃也。"}]},{"ID":"20240616133521-m2mn40v","Type":"NodeParagraph","Properties":{"id":"20240616133521-m2mn40v","updated":"20240616133521"},"Children":[{"Type":"NodeText","Data":"或问防风得黄 ，则不散邪而辅正，是防风亦可补之物，先生何谓攻而不补乎？夫黄得防风，而其功更大，未闻防风得黄 ，而其功更神，然则防风仍是攻而不补，非攻而亦补之物也。近人皆以防风为散风神药，毋论外感与非外感俱用之，乃服而不效也。"}]},{"ID":"20240616133521-zwur23m","Type":"NodeParagraph","Properties":{"id":"20240616133521-zwur23m","updated":"20240616133521"},"Children":[{"Type":"NodeText","Data":"或疑所用之不多也，更加分两，以致散尽真气，不可哂乎？殊不知防风宜于无风之时，同黄用之，可以杜邪风之不入于皮毛，非风邪已入而可用之物也。古人名一物，必在深意，顾名而可悟矣。"}]},{"ID":"20240616133509-ouiobsj","Type":"NodeThematicBreak","Properties":{"id":"20240616133509-ouiobsj"}},{"ID":"20240616133510-l2bj9tu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133510-l2bj9tu","updated":"20240616133514"},"Children":[{"Type":"NodeText","Data":"防风《神农本草经读》"}]},{"ID":"20240616133510-vyh3b65","Type":"NodeParagraph","Properties":{"id":"20240616133510-vyh3b65","updated":"20240616133510"},"Children":[{"Type":"NodeText","Data":"气味甘、温，无毒。主大风，头眩痛，恶风，风邪目盲无所见，风行周身，骨节疼痛、身重。久服轻身。"}]},{"ID":"20240616133510-b9t84xv","Type":"NodeParagraph","Properties":{"id":"20240616133510-b9t84xv","updated":"20240616133510"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶防风气温，禀天春术之气而入肝；味甘无毒，得地中土之味而入脾。主大风三字提纲，详于巴戟天注，不赘。风伤阳位，则目盲无所见。风行周身者，经络之风也；骨节疼痛者，关节之风也；身重者，病风而不能捷也。防风之甘温发散，可以统主之。然温属春和之气，入肝而治风；尤妙在甘以入脾，培土以和水气，其用独神。此理证之易象，于剥复二卦而可悟焉。两土同崩则剥，故大败必顾脾胃；土木无忤则复，故病转必和肝脾。防风驱风之中，大有回生之力；李东垣竟目为卒伍卑贱之品，真门外汉也。"}]},{"ID":"20240616133531-y12z83r","Type":"NodeThematicBreak","Properties":{"id":"20240616133531-y12z83r"}},{"ID":"20240616133532-epkha55","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133532-epkha55","updated":"20240616133538"},"Children":[{"Type":"NodeText","Data":"防风《本草经解》"}]},{"ID":"20240616133532-ugc7pa2","Type":"NodeParagraph","Properties":{"id":"20240616133532-ugc7pa2","updated":"20240616133532"},"Children":[{"Type":"NodeText","Data":"气温．味甘．无毒．主大风头眩痛．恶风风邪．目盲无所见．风行周身．骨节疼痛．久服轻身．防风气温．禀天春和风木之气．入足厥阴肝经．味甘无毒．得地中正之土味．入足太阴脾经．气味俱升．阳也．肝为风木．其经与督脉会于巅顶．大风之邪入肝．则行于阳位．故头眩痛．其主之者．温以散之也．伤风则恶风．恶风风邪．在表之风也．肝开窍于目．目盲无所见．在肝经之风也．风行周身．在经络之风也．骨节疼痛．风在关节而兼湿也．盖有湿则阳气滞而痛也．皆主之者．风气通肝．防风入肝．甘温发散也．脾主肌肉．湿则身重矣．久服轻身者．风剂散湿．且引清阳上达也．"}]},{"ID":"20240616133532-7rqf3ly","Type":"NodeParagraph","Properties":{"id":"20240616133532-7rqf3ly","updated":"20240616133532"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616133532-6dfjls6","Type":"NodeParagraph","Properties":{"id":"20240616133532-6dfjls6","updated":"20240616133605"},"Children":[{"Type":"NodeText","Data":"防风同白芍、黄 ．治表虚自汗．同荆芥、白芷、生地、地榆、黄耆．治破伤风．"}]},{"ID":"20240616133445-cf932vw","Type":"NodeThematicBreak","Properties":{"id":"20240616133445-cf932vw"}},{"ID":"20240616133446-qmck6at","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133446-qmck6at","updated":"20240616133450"},"Children":[{"Type":"NodeText","Data":"防风《新修本草》"}]},{"ID":"20240616133446-2n2q24x","Type":"NodeParagraph","Properties":{"id":"20240616133446-2n2q24x","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"味甘、辛，温，无毒。主大风头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹，烦满。胁痛胁风，头面去来，四肢挛急，字乳金疮内痉。久服轻身。叶，主中风热汗出。"}]},{"ID":"20240616133446-ivqm53z","Type":"NodeParagraph","Properties":{"id":"20240616133446-ivqm53z","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"一名铜芸，一名茴草，一名百枝，一名屏风，一名 根，一名百蜚。生沙苑川泽及邯郸、琅、上蔡。二月、十月采根，曝干。"}]},{"ID":"20240616133446-jl2mq5y","Type":"NodeParagraph","Properties":{"id":"20240616133446-jl2mq5y","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"得泽泻、蒿本疗风，得当归、芍药、阳起石、禹余粮疗妇人子藏风，杀附子毒，恶干姜、藜芦、白蔹、芫花，畏萆。郡县无名沙苑。今第一出彭城、兰陵，即近琅 者。郁州百市亦得之。次出襄阳、义阳县界，亦可用，即近上蔡者。"}]},{"ID":"20240616133446-mbb8jaa","Type":"NodeParagraph","Properties":{"id":"20240616133446-mbb8jaa","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"唯实而脂润，头节坚如蚯蚓头者为好。"}]},{"ID":"20240616133446-h7zbg3t","Type":"NodeParagraph","Properties":{"id":"20240616133446-h7zbg3t","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"俗用疗风最要，道方时用。"}]},{"ID":"20240616133446-84aq0o1","Type":"NodeParagraph","Properties":{"id":"20240616133446-84aq0o1","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"〔谨案〕今出齐州、龙山最善，淄州、兖州、青州者亦佳。叶似牡蒿、附子苗等。《别录》云∶叉头者，令人发狂；叉尾者，发痼疾。子似胡荽而大，调食用之香，而疗风更优也。沙苑在同州南，亦出防风，轻虚不如东道者，陶云无沙苑，误矣。"}]},{"ID":"20240616133446-g16lhd1","Type":"NodeParagraph","Properties":{"id":"20240616133446-g16lhd1","updated":"20240616133446"},"Children":[{"Type":"NodeText","Data":"襄阳、义阳、上蔡，元无防风，陶乃妄注尔。"}]},{"ID":"20240616133417-q22bvsq","Type":"NodeThematicBreak","Properties":{"id":"20240616133417-q22bvsq"}},{"ID":"20240616133418-hzeydix","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133418-hzeydix","updated":"20240616133422"},"Children":[{"Type":"NodeText","Data":"防风《名医别录》"}]},{"ID":"20240616133418-0627k07","Type":"NodeParagraph","Properties":{"id":"20240616133418-0627k07","updated":"20240616133418"},"Children":[{"Type":"NodeText","Data":"味辛，无毒．主治胁痛、胁风头面去来，四肢挛急，字乳金疮内痉．叶，主治中风热出．一名茴草，一名百枝，一名屏风，一名 根，一名百蜚．生沙苑及邯郸、琅 、上蔡二月、十月采根，曝干．（得泽泻、 本治风，得当归、芍药、阳起石、禹余粮治妇人子风，恶干姜、藜芦、白蔹、芫花，杀附子毒．）"}]},{"ID":"20240616133418-ofiq4yr","Type":"NodeParagraph","Properties":{"id":"20240616133418-ofiq4yr","updated":"20240616133418"},"Children":[{"Type":"NodeText","Data":"又，叉头者令人发狂，叉尾者发痼疾．"}]},{"ID":"20240616133418-5quy4c9","Type":"NodeParagraph","Properties":{"id":"20240616133418-5quy4c9","updated":"20240616133436"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶防风，味甘，温，无毒．主大风，头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹，烦满。久服轻身。一名铜芸。生川泽。"}]},{"ID":"20240616133343-f36g480","Type":"NodeThematicBreak","Properties":{"id":"20240616133343-f36g480"}},{"ID":"20240616133354-lf6tb1v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133354-lf6tb1v","updated":"20240616133358"},"Children":[{"Type":"NodeText","Data":"防风《冯氏锦囊秘录》"}]},{"ID":"20240616133354-39sdd5c","Type":"NodeParagraph","Properties":{"id":"20240616133354-39sdd5c","updated":"20240616133354"},"Children":[{"Type":"NodeText","Data":"禀天地之阳气以生，故味甘辛温而无毒。气浓味薄，升也，阳也。入手阳明，足少阳，厥阴风药也。治风通用，升发而能散。恶藜芦，杀附子毒。"}]},{"ID":"20240616133354-x618hyd","Type":"NodeParagraph","Properties":{"id":"20240616133354-x618hyd","updated":"20240616133354"},"Children":[{"Type":"NodeText","Data":"防风杀乌头大毒，足太阳本经药，又通行脾胃二经，职居卒伍卑贱之流，听命即行，随引竟至。尽治一身之痛，为风药之润剂也。治风通用，散湿亦易，消去身半已上风邪，消去身半已下风疾，收滞气面颊，尤泻肺实有余，驱眩晕头颅，开目盲无见，搜肝顺气，四体挛急，开腠理，托痈疽。大风、恶风、风邪周痹，头面游风，眼赤多泪，除上焦风邪要药。倘或误服，反泻人上焦元气。疗药中用之者，以风能除湿，热且宣扬药势也。必兼荆芥者，以防风入气分，荆芥入血分也。"}]},{"ID":"20240616133354-2dmkklh","Type":"NodeParagraph","Properties":{"id":"20240616133354-2dmkklh","updated":"20240616133354"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 凡痘初风热发表不可缺，如疮搔痒者，与黄 同用，手足不起发者，与白芍桂枝同用，须以酒炒，疮太湿者用之，风能胜湿也。疮干者亦用之，以其能行药中之润剂。故曰∶利热解毒，和血止痒。然不可久用，盖味辛纯阳，终属走散耗血也。"}]},{"ID":"20240616133354-seiy0yt","Type":"NodeParagraph","Properties":{"id":"20240616133354-seiy0yt","updated":"20240616133354"},"Children":[{"Type":"NodeText","Data":"按∶防风虽为祛风祛湿之仙药，然系辛温走泄之品，肺虚、气虚、血虚、火燥者，服用之。"}]},{"ID":"20240616133343-swqx5vh","Type":"NodeThematicBreak","Properties":{"id":"20240616133343-swqx5vh"}},{"ID":"20240616133344-qf1n9lh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133344-qf1n9lh","updated":"20240616133349"},"Children":[{"Type":"NodeText","Data":"防风《本草求真》"}]},{"ID":"20240616133344-8dpo3f2","Type":"NodeParagraph","Properties":{"id":"20240616133344-8dpo3f2","updated":"20240616133344"},"Children":[{"Type":"NodeText","Data":"（山草）有膀胱上焦筋骨风邪仍为风药通用"}]},{"ID":"20240616133344-ck0bg5d","Type":"NodeParagraph","Properties":{"id":"20240616133344-ck0bg5d","updated":"20240616133344"},"Children":[{"Type":"NodeText","Data":"防风（专入膀胱。兼入脾胃）。味甘微温。虽入足太阳膀胱。以治上焦风邪。头痛目眩。脊痛项强。周身尽痛。（之才曰。得葱白能行周身。）然亦能入脾胃二经。（杲曰。若补胃。非此引用不能行。）以为去风除湿。（凡风药皆能胜湿。）盖此等于卑贱卒伍。任主使唤。能循诸经之药以为追随。故同解毒药。则能除湿扫疮。同补气药。则能取汗升举。（或同黄 芍药以止汗。或合黄 固表为玉屏风散。）实为风药润剂。比之二活。则质稍轻。气亦稍平。凡属风药。皆可通用。但血虚 急。头痛不因风寒。泄泻不因寒湿。阴虚盗汗。阳虚自汗。火升发嗽者。则并当知所禁矣。（凡表药多有损于脏腑气血。）出北地黄润者佳。泗风车风。不堪入药。上部用身。下部用梢。畏萆 。恶干姜白蔹芫花。杀附子毒。"}]},{"ID":"20240616133253-eo4pxwi","Type":"NodeThematicBreak","Properties":{"id":"20240616133253-eo4pxwi"}},{"ID":"20240616133332-aqb59xs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133332-aqb59xs","updated":"20240616133338"},"Children":[{"Type":"NodeText","Data":"防风《雷公炮制药性解》"}]},{"ID":"20240616133332-nudlqpg","Type":"NodeParagraph","Properties":{"id":"20240616133332-nudlqpg","updated":"20240616133332"},"Children":[{"Type":"NodeText","Data":"味辛甘，性温无毒，入肺经。泻肺金、疗诸风，开结气，理目痛。恶干姜、藜芦、白蔹、芫花，解附子毒。"}]},{"ID":"20240616133332-j83n4fu","Type":"NodeParagraph","Properties":{"id":"20240616133332-j83n4fu","updated":"20240616133332"},"Children":[{"Type":"NodeText","Data":"按∶防风辛走肺，为升阳之剂，故通疗诸风。气之结者，肺之疾也。目之痛者，风之患也，宜并主之。东垣云∶卑贱之卒，听令而行，随所引而至，乃风药中润剂也，能泻上焦，元气虚者不概用，今人类犯此弊。"}]},{"ID":"20240616133254-wzel41y","Type":"NodeThematicBreak","Properties":{"id":"20240616133254-wzel41y"}},{"ID":"20240616133324-fd520ml","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133324-fd520ml","updated":"20240616133328"},"Children":[{"Type":"NodeText","Data":"防风《本经逢原》"}]},{"ID":"20240616133324-ofjna9e","Type":"NodeParagraph","Properties":{"id":"20240616133324-ofjna9e","updated":"20240616133324"},"Children":[{"Type":"NodeText","Data":"甘辛温，无毒。叉头者令人烦喘，叉尾者发人痼疾。"}]},{"ID":"20240616133324-037n9od","Type":"NodeParagraph","Properties":{"id":"20240616133324-037n9od","updated":"20240616133324"},"Children":[{"Type":"NodeText","Data":"《本经》主大风头眩痛，恶风风邪，目盲无所见，风行周身骨节疼痛。"}]},{"ID":"20240616133324-gtvwhhm","Type":"NodeParagraph","Properties":{"id":"20240616133324-gtvwhhm","updated":"20240616133324"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"防风浮而升，阳也。入手太阳、阳明、少阳、厥阴，兼通足太阳，治风去湿之仙药，以风能胜湿也。其治大风头眩痛，恶风，风邪等病，其性上行，故治上盛风邪，泻肺实喘满，及周身痹痛，四肢挛急，目盲无所见，风眼冷泪，总不出《本经》主治也。防风治一身尽痛，乃卒伍卑贱之职，随所引而至，风药中润剂也。若补脾胃非此引用不能行，盖于土中泻水也。凡脊痛项强不可回顾，腰似折，项似拔者，乃手足太阳证，正当用之。凡疮在胸膈以上者，虽无手足太阳证，亦当用防风，为能散结去上部风热也。《经验方》治妇人风入胞门，崩中不止，独圣散用一味防风，面糊酒调丸服。然惟血色清稀，而脉浮弦者为宜。如血色浓赤，脉来数者，又属一味子芩丸证，不可混也。惟肺虚有汗喘乏，及气升作呕，火升发嗽，阴虚盗汗，阳虚自汗者勿服。妇人产后血虚发痉，婴儿泻后脾虚发搐，咸为切禁。"}]},{"ID":"20240616133254-jyqosxk","Type":"NodeThematicBreak","Properties":{"id":"20240616133254-jyqosxk"}},{"ID":"20240616133306-e13fbc6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133306-e13fbc6","updated":"20240616133314"},"Children":[{"Type":"NodeText","Data":"防风《汤液本草》"}]},{"ID":"20240616133306-eh55sfz","Type":"NodeParagraph","Properties":{"id":"20240616133306-eh55sfz","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"纯阳，性温，味甘、辛。无毒。"}]},{"ID":"20240616133306-tr1xzty","Type":"NodeParagraph","Properties":{"id":"20240616133306-tr1xzty","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"足阳明胃经、足太阴脾经，乃二经行经之药，太阳经本经药。"}]},{"ID":"20240616133306-h6baq93","Type":"NodeParagraph","Properties":{"id":"20240616133306-h6baq93","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"《象》云∶治风通用，泻肺实，散头目中滞气，除上焦风邪之仙药也。误服，泻人上焦元气。去芦并钗股用。"}]},{"ID":"20240616133306-xszrf4x","Type":"NodeParagraph","Properties":{"id":"20240616133306-xszrf4x","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"《珍》云∶身，去身半以上风邪；梢，去身半以下风邪。"}]},{"ID":"20240616133306-dlzxqex","Type":"NodeParagraph","Properties":{"id":"20240616133306-dlzxqex","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"《心》云∶又去湿之仙药也，风能胜湿尔。"}]},{"ID":"20240616133306-njx3msy","Type":"NodeParagraph","Properties":{"id":"20240616133306-njx3msy","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主大风头眩痛，恶风，风邪目盲无所见。风行周身，骨节疼痹。烦满，胁痛胁风。头面游风去来，四肢挛急，字乳，金疮内痉。"}]},{"ID":"20240616133306-sr7bhdr","Type":"NodeParagraph","Properties":{"id":"20240616133306-sr7bhdr","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"东垣云∶防风能制黄 ，黄 得防风，其功愈大。又云∶防风乃卒伍卑贱之职，随所引而至，乃风药末润剂也。虽与黄 相制，乃相畏而相使者也。"}]},{"ID":"20240616133306-2uvezyl","Type":"NodeParagraph","Properties":{"id":"20240616133306-2uvezyl","updated":"20240616133306"},"Children":[{"Type":"NodeText","Data":"《本草》又云∶得泽泻、 本，疗风；得当归、芍药、阳起石、禹余粮，疗妇人子脏风。杀附子毒。恶干姜、藜芦、白蔹、芫花。"}]},{"ID":"20240616133254-lnay7m0","Type":"NodeThematicBreak","Properties":{"id":"20240616133254-lnay7m0"}},{"ID":"20240616133255-ivimkzl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133255-ivimkzl","updated":"20240616133300"},"Children":[{"Type":"NodeText","Data":"防风《本草便读》"}]},{"ID":"20240616133255-eckx536","Type":"NodeParagraph","Properties":{"id":"20240616133255-eckx536","updated":"20240616133255"},"Children":[{"Type":"NodeText","Data":"走太阳兼达肺通肝．表解风疏．甘辛温之力．得黄 则寓宣于补．痹舒邪化．随所引俱宜．且为脾胃引经．风能胜湿．都道卑微卒伍．润可柔枯．（防风能通行一身．防御外风．故名．为散药中润剂．太阳主一身之表．风气通于肝．肺主皮毛．故皆入之．补脾胃药用之为引者．以疏风则木不郁．湿去则土自健耳．非防风能补也．防风本足太阳发汗疏风之药．而云能去经络留湿者．湿从汗出也．黄 固表．防风泻表．黄 畏防风．然得防风其功愈大．）"}]},{"ID":"20240616133114-fisw3wy","Type":"NodeThematicBreak","Properties":{"id":"20240616133114-fisw3wy"}},{"ID":"20240616133241-75419lp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133241-75419lp","updated":"20240616133250"},"Children":[{"Type":"NodeText","Data":"防风《要药分剂》"}]},{"ID":"20240616133241-vesf161","Type":"NodeParagraph","Properties":{"id":"20240616133241-vesf161","updated":"20240616133241"},"Children":[{"Type":"NodeText","Data":"味甘辛。性微温。无毒。禀天地之阳气以生。升也。阳也。畏萆。恶藜芦、白蔹、干姜、芫花。"}]},{"ID":"20240616133241-ctxcmjh","Type":"NodeParagraph","Properties":{"id":"20240616133241-ctxcmjh","updated":"20240616133241"},"Children":[{"Type":"NodeText","Data":"【主治】主大风头眩痛。恶风。风邪。目盲无所见。风行周身。骨节疼痛。（本经）烦满胁痛赤眼。"}]},{"ID":"20240616133241-jlcibi0","Type":"NodeParagraph","Properties":{"id":"20240616133241-jlcibi0","updated":"20240616133241"},"Children":[{"Type":"NodeText","Data":"（大明）治上焦风邪。泻肺实。散头目中滞气。经络中留湿。主上部见血。（元素）头痛目眩。脊【归经】入肝大肠三焦三经。为表发疏散之品。（搜肝泻肺发表祛风胜湿）【前论】苏恭曰。凡风药。皆能胜湿。东垣曰。卒伍卑贱之职。随所引而下。乃风药中润剂使也。"}]},{"ID":"20240616133241-33nbo2l","Type":"NodeParagraph","Properties":{"id":"20240616133241-33nbo2l","updated":"20240616133241"},"Children":[{"Type":"NodeText","Data":"子脏风药也。"}]},{"ID":"20240616133241-bb9v07l","Type":"NodeParagraph","Properties":{"id":"20240616133241-bb9v07l","updated":"20240616133241"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。似中风。产后血虚发痉诸病。血虚痉急。头痛不因风寒。溏泄不因寒湿。"}]},{"ID":"20240616133114-v1j3sq9","Type":"NodeThematicBreak","Properties":{"id":"20240616133114-v1j3sq9"}},{"ID":"20240616133229-3qcyi03","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133229-3qcyi03","updated":"20240616133233"},"Children":[{"Type":"NodeText","Data":"防风《本草简要方》"}]},{"ID":"20240616133229-7rz3g4l","Type":"NodeParagraph","Properties":{"id":"20240616133229-7rz3g4l","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"主治。疏通经络。散内外诸风。骨节痛。疗金疮。疮疡。"}]},{"ID":"20240616133229-we8g074","Type":"NodeParagraph","Properties":{"id":"20240616133229-we8g074","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风丸。防风川芎天麻（酒浸一宿）炙草各二两。研末蜜丸。朱砂五钱水飞为衣。每丸一钱。不拘时荆芥汤或茶酒化下。治一切风及痰热上攻。头痛恶心。项背拘急。目眩心怔。手足无力。骨节疼痛。言语謇涩。口眼动。神思恍惚。痰涎壅塞。昏愦健忘。虚烦少睡。"}]},{"ID":"20240616133229-w2u24dw","Type":"NodeParagraph","Properties":{"id":"20240616133229-w2u24dw","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风升麻汤。防风升麻山栀仁麦冬荆芥木通干葛薄荷玄参牛蒡子甘草各一钱。加灯芯十茎。水煎服。治小儿游风丹毒。大便闭者。加大黄枳壳各一钱。忌鱼腥鸡鹅。丹毒重者。攻入心脏难救。先服此药解内毒。次用磁针刺去恶血。则毒随血散。"}]},{"ID":"20240616133229-ln6md3b","Type":"NodeParagraph","Properties":{"id":"20240616133229-ln6md3b","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风天麻丸。防风天麻升麻白附子（炮）定风草川芎细辛人参丹参苦参玄参紫参蔓荆子威灵仙穿山甲（炒）何首乌（另捣末）各一两。蜈蚣一对。研末。与何首乌末拌匀。每药末二两。"}]},{"ID":"20240616133229-rjek6l8","Type":"NodeParagraph","Properties":{"id":"20240616133229-rjek6l8","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"胡麻一斤淘净晒干炒香熟。另研极细末。与药末拌匀。蜜丸。共作九十丸。不拘时细嚼。温浆水下。日三次。食淡白粥百二十日。大忌房事。须将息慎口。治疠风癞疾。防风牛蒡汤。"}]},{"ID":"20240616133229-vkfbkna","Type":"NodeParagraph","Properties":{"id":"20240616133229-vkfbkna","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风牛蒡子山栀石膏黄芩苍术木通。水煎服。治血热。"}]},{"ID":"20240616133229-s0rmctz","Type":"NodeParagraph","Properties":{"id":"20240616133229-s0rmctz","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风如神散。防风枳壳（麸炒）各等分。每服三钱。水煎服。治风热气滞粪后下血。"}]},{"ID":"20240616133229-t9emw3r","Type":"NodeParagraph","Properties":{"id":"20240616133229-t9emw3r","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风芍药汤。防风芍药（炒）黄芩（炒）各二钱。研粗末。水煎服。治飧泄身热。脉弦。"}]},{"ID":"20240616133229-qoe99p8","Type":"NodeParagraph","Properties":{"id":"20240616133229-qoe99p8","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"头痛腹痛。"}]},{"ID":"20240616133229-luv0fym","Type":"NodeParagraph","Properties":{"id":"20240616133229-luv0fym","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风羌活汤。防风羌活各一钱。连翘二钱。升麻七分。夏枯草二钱。牛蒡子（炒研）川芎黄芩（酒浸）昆布（酒炒洗）海藻（酒洗）薄荷各一钱。甘草五分。僵蚕（酒炒）二钱。水煎服。治风毒。瘰。初发寒热者。虚加人参当归。实加大黄黄连。"}]},{"ID":"20240616133229-3xxe511","Type":"NodeParagraph","Properties":{"id":"20240616133229-3xxe511","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风秦艽汤。防风秦艽当归生地白芍（酒炒）赤茯苓。连翘川芎各一钱。生栀子（研）苍术（米泔浸炒）槐角白芷地榆枳壳（麸炒）槟榔生草各六分。水二钟煎至八分。食前温服。治肠风便血。大便秘加大黄。"}]},{"ID":"20240616133229-xh9dueq","Type":"NodeParagraph","Properties":{"id":"20240616133229-xh9dueq","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风通圣散。防风川芎当归芍药（焙）大黄（煨）薄荷叶麻黄连翘芒硝各五钱。石膏（）黄芩（焙）桔梗各一两。滑石（飞过）三两。生草二两。荆芥穗白术（土炒）栀子（炒）各二钱五分。"}]},{"ID":"20240616133229-r5pju13","Type":"NodeParagraph","Properties":{"id":"20240616133229-r5pju13","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"研粗末。每服二三钱。水一大盏。加生姜三片。煎至六分。食前温服。或白汤调下。治一切风湿暑湿。饥饱劳役。内外诸邪。气血怫郁。表里三焦俱实。憎寒壮热。头目昏晕。目赤睛痛。耳鸣鼻塞。口苦舌干。咽喉不利。唾涕稠粘。咳嗽上气。大便秘结。小便赤涩。疮疡肿毒。折跌损伤。瘀血便血。肠风痔漏。手足螈惊狂谵妄。丹斑痈疹等证。解利四时。伤寒及一切内外伤者。每一两加益元散一两。葱白十茎。盐豉一合。生姜五钱。水一碗。煎一小时。温冷服一半。以筋投之即吐。吐后服一半。稍热服。汗出立解。头旋脑热。鼻塞浊涕时下者。每一两加黄连薄荷各二钱五分。如风伤于肺。咳嗽喘急者。每一两加半夏桔梗紫菀各二钱。气逆加木香末一钱。涎嗽加半夏五钱。诸风痫搐。大便秘结。筋转惊悸。肌肉蠕动。"}]},{"ID":"20240616133229-ex4zvq4","Type":"NodeParagraph","Properties":{"id":"20240616133229-ex4zvq4","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"及小儿惊风。每一两加大黄栀子茯苓末各二钱。如肌肉蠕动者。调羌活末一钱。饮酒中风身热头痛者加黄连须二钱。葱白十茎。水煎服。慎勿用麻黄桂枝汤。劳汗当风寒。薄为渣郁乃痤。去芒硝。倍加芍药当归。破伤风在表者。辛以散之。在里者苦以下之。兼散之。汗下后通利荣血。祛逐风邪。每一两加荆芥穗大黄各二钱。全蝎末羌活末各一钱。腰胁走注疼痛者。"}]},{"ID":"20240616133229-lbzrjjl","Type":"NodeParagraph","Properties":{"id":"20240616133229-lbzrjjl","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"每服加硝石当归甘草各二钱。调车前子末海金砂末各一钱。小便淋闭去麻黄。加滑石连翘。"}]},{"ID":"20240616133229-r5guqg7","Type":"NodeParagraph","Properties":{"id":"20240616133229-r5guqg7","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"又调木香末一钱匕。凡泻者去芒硝大黄。秃疮须将药醇酒浸焙研末。每服一二钱。食后滚汤调下。服至头上汗出为度。风刺瘾疹或赤或白者。去芒硝。倍麻黄。加盐豉葱白。水煎服。"}]},{"ID":"20240616133229-uf0wa92","Type":"NodeParagraph","Properties":{"id":"20240616133229-uf0wa92","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"发汗后根据方中加四物汤。黄连解毒汤三药合而饮之。每日两次。打扑损伤。肢节疼痛。腹中恶血不下者。每一两加大黄当归各三钱五分。调没药乳香末各二钱。"}]},{"ID":"20240616133229-ikrl8xv","Type":"NodeParagraph","Properties":{"id":"20240616133229-ikrl8xv","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风散。防风五加皮萆薏仁海桐皮枳壳（麸炒）赤芍桂心熟地黄杜仲（炒去丝）牛膝（酒浸）各一两。续断鼠粘子羚羊角（屑）各七钱五分研末。每服二钱。温酒下。日二三次。忌生冷油腻鱼腥。治风虚劳筋脉拘挛。腰膝疼痛者。防风黄芩丸。防风条芩（炒焦）各等分。研末。"}]},{"ID":"20240616133229-2e7ph5s","Type":"NodeParagraph","Properties":{"id":"20240616133229-2e7ph5s","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"酒煮米糊为丸。梧子大。每服三五十丸。治妇人肝经风热。致吐血。血崩。便血。尿血。"}]},{"ID":"20240616133229-jxw3bxm","Type":"NodeParagraph","Properties":{"id":"20240616133229-jxw3bxm","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风黄汤。防风黄各等分。水煎服。治中风不语。脉迟弱者。"}]},{"ID":"20240616133229-y61lhhv","Type":"NodeParagraph","Properties":{"id":"20240616133229-y61lhhv","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风当归汤。防风当归川芎生地各一两。每服一两。水三碗煎至二碗温服。治发汗过多。"}]},{"ID":"20240616133229-sl2kpf3","Type":"NodeParagraph","Properties":{"id":"20240616133229-sl2kpf3","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"发热头摇口噤。背反张。及破伤风发表太过。自汗不止。妇人产后血气大虚。及产后痉。"}]},{"ID":"20240616133229-i0j0ax8","Type":"NodeParagraph","Properties":{"id":"20240616133229-i0j0ax8","updated":"20240616133229"},"Children":[{"Type":"NodeText","Data":"防风苍术汤。防风苍术桔梗陈皮桃仁白芷川芎当归枳壳浓朴。水煎服。治风痛。"}]},{"ID":"20240616133115-xz30ey7","Type":"NodeThematicBreak","Properties":{"id":"20240616133115-xz30ey7"}},{"ID":"20240616133218-xxgqh0d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133218-xxgqh0d","updated":"20240616133222"},"Children":[{"Type":"NodeText","Data":"防风《本草从新》"}]},{"ID":"20240616133218-n8gdj1h","Type":"NodeParagraph","Properties":{"id":"20240616133218-n8gdj1h","updated":"20240616133218"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、发表、去风胜湿．"}]},{"ID":"20240616133218-9wlfgcl","Type":"NodeParagraph","Properties":{"id":"20240616133218-9wlfgcl","updated":"20240616133218"},"Children":[{"Type":"NodeText","Data":"辛甘微温．升浮为阳．搜肝泻肺．散头目滞气．经络留湿．主上部见血．（用之为使、亦能治崩．）上焦风邪．头痛目眩．脊痛项强．周身尽痛．太阳经证．（膀胱、徐之才曰∶得葱白、能行周身．）又行脾胃二经．为去风胜湿之要药．（凡风药皆能胜湿、东垣曰∶卒伍卑贱之职、随所引而至、乃风药中润剂、若补脾胃、非此引用不能行．）散目赤疮疡．若血虚痉急．头痛不因风寒．（内伤．）泄泻不因寒湿．火升作嗽．阴虚盗汗．阳虚自汗者．并禁用．（同黄 白芍、又能实表止汗、合黄 白术、名玉屏风散、固表圣药、黄 得防风而功益大、乃相畏而更相使也．）青州黄润者良．软芦糯体．（登州莱阳次之．关东者、性硬不用．）恶干姜、白蔹、芫花．畏萆 ．杀附子毒．"}]},{"ID":"20240616133115-qrxkkv2","Type":"NodeThematicBreak","Properties":{"id":"20240616133115-qrxkkv2"}},{"ID":"20240616133204-cnw2lxj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133204-cnw2lxj","updated":"20240616133209"},"Children":[{"Type":"NodeText","Data":"防风《本草经集注》"}]},{"ID":"20240616133204-i9wms98","Type":"NodeParagraph","Properties":{"id":"20240616133204-i9wms98","updated":"20240616133204"},"Children":[{"Type":"NodeText","Data":"味甘、辛，温，无毒。主治大风，头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹，烦满。胁痛胁风，头面去来，四肢挛急，字乳金疮内痉。久服轻身。叶∶主中风热汗出。一名铜芸，一名茴草，一名百枝，一名屏风，一名 根，一名百蜚。生沙苑川泽及邯郸、琅琊、上蔡。二月、十月采根，曝干。（得泽泻、 本治风，得当归、芍药、阳起石、禹余粮治妇人子藏风，杀附子毒，恶干姜、藜芦、白蔹、芫花。）"}]},{"ID":"20240616133204-v6b5zt6","Type":"NodeParagraph","Properties":{"id":"20240616133204-v6b5zt6","updated":"20240616133204"},"Children":[{"Type":"NodeText","Data":"郡县无名沙苑。今第一出彭城、兰陵，即近琅琊者。郁州互市亦得之。次出襄阳、义阳县界，亦可用，即近上蔡者。唯实而脂润，头节坚如蚯蚓头者为好。世用治风最要，道方时用。"}]},{"ID":"20240616133115-rvapns3","Type":"NodeThematicBreak","Properties":{"id":"20240616133115-rvapns3"}},{"ID":"20240616133140-s0ilngz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133140-s0ilngz","updated":"20240616133143"},"Children":[{"Type":"NodeText","Data":"防风《本草崇原》"}]},{"ID":"20240616133140-piuwqiw","Type":"NodeParagraph","Properties":{"id":"20240616133140-piuwqiw","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"气味甘温，无毒。主大风头眩痛，恶风风邪，目盲无所见，风行周身，骨节疼痛烦满。久服轻身。"}]},{"ID":"20240616133140-ol6thop","Type":"NodeParagraph","Properties":{"id":"20240616133140-ol6thop","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"（防风始出沙苑川泽及邯郸、琅琊、上蔡，皆属中州之地。春初发嫩芽，红紫色，三月茎叶俱青，五月开细白花，六月结实黑色，九月、十月采根，色黄空通。）"}]},{"ID":"20240616133140-3dbutll","Type":"NodeParagraph","Properties":{"id":"20240616133140-3dbutll","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"防风茎、叶、花、实，兼备五色，其味甘，其质黄，其臭香，禀土运之专精，治周身之风证。盖土气浓，则风可屏，故名防风。风淫于头，则大风头眩痛。申明大风者，乃恶风之风邪，眩痛不已，必至目盲无所见，而防风能治之。又，风邪行于周身，甚至骨节疼痛，而防风亦能治之，久服则土气盛，故轻身。"}]},{"ID":"20240616133140-rqspxsb","Type":"NodeParagraph","Properties":{"id":"20240616133140-rqspxsb","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"元人王好古曰∶病头痛、肢节痛、一身尽痛，非羌活不能除，乃却乱反正之主君药也。"}]},{"ID":"20240616133140-w826p8u","Type":"NodeParagraph","Properties":{"id":"20240616133140-w826p8u","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"李东垣曰∶防风治一身尽痛，随所引而至，乃卒伍卑贱之职也。"}]},{"ID":"20240616133140-cjf3p27","Type":"NodeParagraph","Properties":{"id":"20240616133140-cjf3p27","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"愚按∶《神农》以上品为君，羌活、防风皆列上品，俱散风治病，何以贵贱回别若是。"}]},{"ID":"20240616133140-i3rybwa","Type":"NodeParagraph","Properties":{"id":"20240616133140-i3rybwa","updated":"20240616133140"},"Children":[{"Type":"NodeText","Data":"后人发明药性，多有如此谬妄之论，虽曰无关治法，学人遵而信之，陋习何由得洗乎。"}]},{"ID":"20240616133644-tgys8k1","Type":"NodeThematicBreak","Properties":{"id":"20240616133644-tgys8k1"}},{"ID":"20240616133645-30apa0o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133645-30apa0o","updated":"20240616133649"},"Children":[{"Type":"NodeText","Data":"防风《医学入门》"}]},{"ID":"20240616133645-gycst5b","Type":"NodeParagraph","Properties":{"id":"20240616133645-gycst5b","updated":"20240616133645"},"Children":[{"Type":"NodeText","Data":"防风气温味甘辛，通疗诸风痛满身，头目胁痛并胸满，除湿止汗住崩津。"}]},{"ID":"20240616133645-kl167bq","Type":"NodeParagraph","Properties":{"id":"20240616133645-kl167bq","updated":"20240616133645"},"Children":[{"Type":"NodeText","Data":"凡药必先其立名之义，而后审其治疗。防风者，预防风疾也。无毒。浮而升，阳也，治脾胃二经及太阳经。"}]},{"ID":"20240616133645-hk7aphq","Type":"NodeParagraph","Properties":{"id":"20240616133645-hk7aphq","updated":"20240616133645"},"Children":[{"Type":"NodeText","Data":"乃卒伍卑贱之职，随所引而至者也。主诸风邪在表，恶风，周身节痛，四肢拘挛，一切风邪头眩目盲流泪，胁痛诸疮，泻上焦风邪之仙药也。又疏泄肺窍，解胸膈烦满，通五脏关脉，药中润剂。误服泻人上焦元气。兼理劳损盗汗，女人崩带。除经络间留湿，风能胜湿故也。诸风药皆然。坚润者佳，去芦及叉头叉尾者。恶干姜、藜芦、白蔹、芫花，畏萆 ，杀附子毒。得泽泻、 本治风，得当归、芍药、阳起石，治妇人子脏风。"}]},{"ID":"20240616133632-dmkzrx2","Type":"NodeThematicBreak","Properties":{"id":"20240616133632-dmkzrx2"}},{"ID":"20240616133634-2fgvt2q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133634-2fgvt2q","updated":"20240616133639"},"Children":[{"Type":"NodeText","Data":"防风《本草述钩元》"}]},{"ID":"20240616133634-ymwnwwa","Type":"NodeParagraph","Properties":{"id":"20240616133634-ymwnwwa","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"出齐州龙山者最胜。青兖淄州者亦佳。九月采用。（不止用根。故通身采。）味辛而甘。气温而浮。气浓味薄。升也。阳也。手足太阳经本药。又行足阳明太阴二经。为肝经气分药。（洁古更言治上焦风邪。泻肺实。其义可合为一欤。盖肺统气者也。气者水火之所合化也。气所合化之经。手足太阳是也。至于行足阳明太阴。即以经言伤肺之义参之。经曰。夫伤肺者。脾气不守。胃气不清。经气不为使。真脏坏决。经脉傍绝。五脏漏泄。不衄则呕。"}]},{"ID":"20240616133634-9xz32yn","Type":"NodeParagraph","Properties":{"id":"20240616133634-9xz32yn","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"即此数语。可以明于合一。且了然于诸上焦见血之义矣。）本经主大风头眩痛。恶风。风邪目瞀盲。并风行周身。骨节疼痛。治上焦风邪。泻肺实。除烦满胁痛。四肢挛急。搜肝气。"}]},{"ID":"20240616133634-m6orlhy","Type":"NodeParagraph","Properties":{"id":"20240616133634-m6orlhy","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"通利关脉。散经络中留湿。头目中滞气。上部见血。（诸本草）身半以上用身。身半以下用梢。为治风去湿之仙药。除上焦在表。风邪为最。兼治下焦风湿。（洁古嵩）。风药中润剂。"}]},{"ID":"20240616133634-np0op0g","Type":"NodeParagraph","Properties":{"id":"20240616133634-np0op0g","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"治一身尽痛。乃卒伍卑贱之职。随所引而辄至。若补脾胃。非此引用不行。钱乙泻黄散。倍用防风。乃于土中泻木也。（盖风木之邪不化。便侮其所胜而病于土。能升阳以达中土之气。"}]},{"ID":"20240616133634-ai4pw1b","Type":"NodeParagraph","Properties":{"id":"20240616133634-ai4pw1b","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"则土木各正其所司之位矣。）凡脊痛项强不可回顾。腰似折。项似拔者。乃手足太阳证。正当用防风。凡疮在胸膈以上。虽无手足太阳证。亦当用之。（为能散结去上部风也）病患身体拘倦者。风也。诸疮见此证。亦须用之。（东垣）亦入治风痹药用。若入大风疠风药中。须加杀虫活血药。不可纯任风剂。同黄芍药。"}]},{"ID":"20240616133634-kzga44j","Type":"NodeParagraph","Properties":{"id":"20240616133634-kzga44j","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"能实表止汗。同荆芥穗白芷生地地榆黄。治破伤风有神。同桔梗甘草紫苏杏仁桑白皮细辛。"}]},{"ID":"20240616133634-fs66s3i","Type":"NodeParagraph","Properties":{"id":"20240616133634-fs66s3i","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"解利伤风。以薄荷换紫苏。加石膏。兼除风热。用麻黄易紫苏。治风寒郁于腠理。皮肤致密无汗。"}]},{"ID":"20240616133634-duw3ysd","Type":"NodeParagraph","Properties":{"id":"20240616133634-duw3ysd","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"附方破伤中风。牙关紧急。天南星防风等分。为末。每服二三匙。用童便五升。煎至四升。分二服即止。妇人崩中。用防风去芦头。炙赤为末。每服一钱。以面糊酒调下。更以面糊酒投之。累验。一方。加炒黑蒲黄等分。"}]},{"ID":"20240616133634-bwu2tut","Type":"NodeParagraph","Properties":{"id":"20240616133634-bwu2tut","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"〔论〕防风先辛而后甘。辛又胜于甘。谓其防上焦风邪泻肺实者。确论也。何以为手足太阳本经药。盖风木即继寒水之后。经曰。卫出下焦。本阴中之阳气。以际于极上。而肺统之。此所谓风升之气。即元气也。主肺表之风剂。岂得不本于首出之根蒂哉。其行足阳明太阴者。亦缘升阳之剂。即以达中土之气。东垣谓风升之气。元气。胃气。当作一体而论。"}]},{"ID":"20240616133634-rlrigyb","Type":"NodeParagraph","Properties":{"id":"20240616133634-rlrigyb","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"故补脾胃药非此引用不行。（盖风木藉土以为用。而即能使土木不相侵者。惟此味独擅其长。）惟其由肺以合于脾胃。故能通利五脏关脉。散经络中留湿。（以脾胃行气于三阴三阳故也）夫肝主经络。"}]},{"ID":"20240616133634-m51a9qa","Type":"NodeParagraph","Properties":{"id":"20240616133634-m51a9qa","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"防风气味。皆属风升。又为肝经气分药。故风行周身。本于善行数变。而此亦随其所行以为治也。羌活防风。通行经络。有不能不少为区别者。羌活味辛苦。苦多而辛少。防风味辛甘。辛多而甘少。本乎地者亲下。非苦无以至地。本乎天者亲上。非辛无以至天。盖手足太阳相表里。一水一火攸分。羌活达其气于水中。散其阴之结。防风则畅其气于火中。而散其阳之结。（故谓除上焦风邪而泻肺实）阳结即肺实。所谓肺阳盛而肺阴虚是也。（以风邪而云结者。阳不得阴以化也。第四时之风。因于四时之气。故必因其气以为施治。惟类中风证。"}]},{"ID":"20240616133634-ro8j4xb","Type":"NodeParagraph","Properties":{"id":"20240616133634-ro8j4xb","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"止从阳不得阴以化。更不得阴以守之治法耳。）要知羌活非不除风。然其所治之风是湿化风。"}]},{"ID":"20240616133634-wd05aql","Type":"NodeParagraph","Properties":{"id":"20240616133634-wd05aql","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"本于阴也。防风非不行湿。然其所治之湿是风化湿。本于阳也。惟二经原表里相须。而风湿亦相因为病。故羌活散湿以化风。时与防风合而奏散风之功。防风祛风以行湿。时与羌活协而为除湿之助。所以用之概为风剂耳。凡人病于风。则元气即因之以病。元气病而元阴亦因之以病。（风木为化阴之地。而风淫还以蚀阴。）故人身血之为病。类先病于元气以及元阴。"}]},{"ID":"20240616133634-kwe803m","Type":"NodeParagraph","Properties":{"id":"20240616133634-kwe803m","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"是即风化湿之证也。如本经所主大风头眩痛恶风风邪目盲无见等证。是非风化湿之证欤。至于通利五脏关脉及散经络中留滞。不与本经所主相发明欤。更如洁古主治上部见血。亦可以前义推求之矣。（参观下羌活论自明）缪氏云。凡南方中风及头痛。不因风寒。溏泄不因寒湿。或气升作呕。火升发嗽。盗汗自汗。二便闭涩等病。犯之增剧。诸病血虚痉急。小儿脾虚发搐。慢惊慢脾风。咸在所忌。"}]},{"ID":"20240616133634-s5yc9ep","Type":"NodeParagraph","Properties":{"id":"20240616133634-s5yc9ep","updated":"20240616133634"},"Children":[{"Type":"NodeText","Data":"〔辨治〕质实而润头节坚者良。去芦并叉头叉尾及形弯者弗用。能令人吐。"}]},{"ID":"20240616133115-1vtstpo","Type":"NodeThematicBreak","Properties":{"id":"20240616133115-1vtstpo"}},{"ID":"20240616133130-04s72r3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133130-04s72r3","updated":"20240616133133"},"Children":[{"Type":"NodeText","Data":"防风《本草备要》"}]},{"ID":"20240616133130-xmsj71v","Type":"NodeParagraph","Properties":{"id":"20240616133130-xmsj71v","updated":"20240616133130"},"Children":[{"Type":"NodeText","Data":"宣，发表，胜湿"}]},{"ID":"20240616133130-mny7l01","Type":"NodeParagraph","Properties":{"id":"20240616133130-mny7l01","updated":"20240616133130"},"Children":[{"Type":"NodeText","Data":"辛苦性温，升浮为阳。搜肝泻肺，散头目滞气、经络留湿。"}]},{"ID":"20240616133130-ercvoxc","Type":"NodeParagraph","Properties":{"id":"20240616133130-ercvoxc","updated":"20240616133130"},"Children":[{"Type":"NodeText","Data":"主上部见血（用之为使，亦能治崩），上焦风邪，头痛目眩，脊痛项强，周身尽痛，太阳（膀胱）经证（徐之才曰∶得葱白，能行周身）。又行脾胃二经，为去风胜湿之要药（凡风药皆能胜湿。东垣曰∶卒伍卑贱之职，随所引而止，乃风药中润剂。若补脾胃，非此引用不能行），散目赤、疮疡。若血虚痉急、头痛不因风寒（内伤头痛）、泄泻不因寒湿、火升发嗽、阴虚盗汗、阳虚自汗者并禁用（同黄 、芍药，又能实表止汗；合黄 、白术，名玉屏风散，固表圣药。黄 得防风而功益大，取其相畏而相使也）。"}]},{"ID":"20240616133130-b1wf2oc","Type":"NodeParagraph","Properties":{"id":"20240616133130-b1wf2oc","updated":"20240616133130"},"Children":[{"Type":"NodeText","Data":"黄润者良。上部用身，下部用梢。畏萆 。恶干姜、白蔹、芫花。杀附子毒。"}]},{"ID":"20240616133115-k0em1wo","Type":"NodeThematicBreak","Properties":{"id":"20240616133115-k0em1wo"}},{"ID":"20240616133120-1484dzi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133120-1484dzi","updated":"20240616133124"},"Children":[{"Type":"NodeText","Data":"防风《长沙药解》"}]},{"ID":"20240616133120-1mzi4w0","Type":"NodeParagraph","Properties":{"id":"20240616133120-1mzi4w0","updated":"20240616133120"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦温，无毒。主大风，头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹，烦满。久服轻身。一名铜芸。生川泽。"}]},{"ID":"20240616133120-ydww0om","Type":"NodeParagraph","Properties":{"id":"20240616133120-ydww0om","updated":"20240616133120"},"Children":[{"Type":"NodeText","Data":"味甘、辛，入足厥阴肝经。燥己土而泻湿，达乙木而息风。"}]},{"ID":"20240616133120-lly9odu","Type":"NodeParagraph","Properties":{"id":"20240616133120-lly9odu","updated":"20240616133120"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝芍药知母汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在桂枝。"},{"Type":"NodeText","Data":"用之治历节疼痛，以其燥湿而舒筋脉也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在薯蓣。"},{"Type":"NodeText","Data":"用之治虚劳，风气百病，以其燥湿而达木郁也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"竹叶汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在竹叶。"},{"Type":"NodeText","Data":"用之治产后中风，发热面赤，以其疏木而发营郁也。"}]},{"ID":"20240616133120-q973le4","Type":"NodeParagraph","Properties":{"id":"20240616133120-q973le4","updated":"20240616133120"},"Children":[{"Type":"NodeText","Data":"厥阴风木之气，土湿而木气不达，则郁怒而风生。防风辛燥发扬，最泻湿土而达木郁，木达而风自息，非防风之发散风邪也。风木疏泄，则窍开而汗出，风静而汗自收，非防风之收敛肌表也。其诸主治，行经络，逐湿淫，通关节，止疼痛，舒筋脉，伸急挛，活肢节，起瘫痪，清赤眼，收冷泪，敛自汗盗汗，断漏下崩中。"}]},{"ID":"20240616133615-fsw2620","Type":"NodeThematicBreak","Properties":{"id":"20240616133615-fsw2620"}},{"ID":"20240616133620-rsbc1pl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616133620-rsbc1pl","updated":"20240616133625"},"Children":[{"Type":"NodeText","Data":"防风《中药学》"}]},{"ID":"20240616133620-jopi2nj","Type":"NodeParagraph","Properties":{"id":"20240616133620-jopi2nj","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【药用】本品为伞形科防风植物的根。"}]},{"ID":"20240616133620-vsa7fh1","Type":"NodeParagraph","Properties":{"id":"20240616133620-vsa7fh1","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、甘，微温。入膀胱、肝、脾经。"}]},{"ID":"20240616133620-9jpvxaw","Type":"NodeParagraph","Properties":{"id":"20240616133620-9jpvxaw","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【功效】祛风解表，胜湿解痉，止泻止血。"}]},{"ID":"20240616133620-bwahkx0","Type":"NodeParagraph","Properties":{"id":"20240616133620-bwahkx0","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于感冒风寒，发热恶寒，头痛、身痛。以及感冒风热、发热恶寒、目赤、咽痛等症。"}]},{"ID":"20240616133620-ox5gmjz","Type":"NodeParagraph","Properties":{"id":"20240616133620-ox5gmjz","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"防风解表以祛风为长，既能散风寒，又能发散风热，与荆芥作用相仿，故两药往往配合应用。"}]},{"ID":"20240616133620-hnc1kq1","Type":"NodeParagraph","Properties":{"id":"20240616133620-hnc1kq1","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"2.用于风湿痹痛"}]},{"ID":"20240616133620-bedg8d6","Type":"NodeParagraph","Properties":{"id":"20240616133620-bedg8d6","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"防风能祛风湿而止痛，常配合羌活、防己等治疗风湿痹痛等症。3.用于破伤风、牙关紧闭、角弓反张防风治破伤风，有祛风止痉的作用，但多配合天南星、天麻、白附子等药同用。"}]},{"ID":"20240616133620-zoggwb8","Type":"NodeParagraph","Properties":{"id":"20240616133620-zoggwb8","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"此外，本品又有止血、止泻作用，如用于腹痛泄泻，常配合白芍、白朮、陈皮等同用；如用于便血、崩漏，一般炒炭应用。"}]},{"ID":"20240616133620-rzkytjf","Type":"NodeParagraph","Properties":{"id":"20240616133620-rzkytjf","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【处方用名】防风、青防风（生用，主要用于解表、祛风湿、解痉）"}]},{"ID":"20240616133620-6fuf6tx","Type":"NodeParagraph","Properties":{"id":"20240616133620-6fuf6tx","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"炒防风（炒至焦黄色为度，解表力缓和，用于止泻）"}]},{"ID":"20240616133620-kfivhdk","Type":"NodeParagraph","Properties":{"id":"20240616133620-kfivhdk","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"防风炭（炒至黑色为度，用于止血）"}]},{"ID":"20240616133620-b2mo2ur","Type":"NodeParagraph","Properties":{"id":"20240616133620-b2mo2ur","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240616133620-ghzp7b7","Type":"NodeParagraph","Properties":{"id":"20240616133620-ghzp7b7","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【按语】1.防风一药，顾名思义，是治风止痛的药物。它既能祛风寒而解表，又能祛风湿而止痛。因它微温而不燥，药性较为缓和，故又可用于风热痈盛、目赤肿痛、咽喉不利等症，可与荆芥、薄荷、连翘、山栀、黄芩等同用。至于祛风解痉方面，则力量较弱，如用治破伤风，本品只能作为辅助药，不能独任其功。"}]},{"ID":"20240616133620-mydj5gd","Type":"NodeParagraph","Properties":{"id":"20240616133620-mydj5gd","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"2.荆芥与防风常同用于祛风解表，有如麻黄配桂枝以发汗解表，也是取它相须的作用。但荆、防发散之力不如麻、桂，作用较为缓和。至于荆、防两药相比，则荆芥发汗之力较强，而防风祛风止痛之功较好。"}]},{"ID":"20240616133620-4c7kcnw","Type":"NodeParagraph","Properties":{"id":"20240616133620-4c7kcnw","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"3.根据临床体会，防风炒用可减缓它祛风的力量，却有止泻的功效，可用于腹泻。"}]},{"ID":"20240616133620-vkxtm4f","Type":"NodeParagraph","Properties":{"id":"20240616133620-vkxtm4f","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"4.防风炒炭，又可用于崩漏而见血色清淡者，与温经止血的炮姜相比，则功用相似而力较逊。"}]},{"ID":"20240616133620-sy42zju","Type":"NodeParagraph","Properties":{"id":"20240616133620-sy42zju","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【方剂举例】防风汤（《证治准绳》）：防风、葛根、秦艽、桂枝、甘草、当归、杏仁、黄芩、赤茯苓、生姜。治感冒头痛。"}]},{"ID":"20240616133620-gac51qo","Type":"NodeParagraph","Properties":{"id":"20240616133620-gac51qo","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"玉真散（《医宗金鉴》）：防风、白芷、天麻、羌活、白附子、南星。治破伤风。"}]},{"ID":"20240616133620-1wyleco","Type":"NodeParagraph","Properties":{"id":"20240616133620-1wyleco","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"凉惊汤（《医宗金鉴》）：防风、钩藤、青黛、黄连、牛黄、生姜。治小儿痉挛。"}]},{"ID":"20240616133620-0cyy3qz","Type":"NodeParagraph","Properties":{"id":"20240616133620-0cyy3qz","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主大风头眩痛，恶风风邪，目盲无所见，风行周身，骨节疼痛。」"}]},{"ID":"20240616133620-li4i69u","Type":"NodeParagraph","Properties":{"id":"20240616133620-li4i69u","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"《千金方》：「解乌头毒」、「解芫花毒」"}]},{"ID":"20240616133620-jeyfz41","Type":"NodeParagraph","Properties":{"id":"20240616133620-jeyfz41","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"《珍珠囊》：「治上焦风邪，泻肺实，散头目中滞气，经络中留湿。」"}]},{"ID":"20240616133620-nidmge5","Type":"NodeParagraph","Properties":{"id":"20240616133620-nidmge5","updated":"20240616133620"},"Children":[{"Type":"NodeText","Data":"《菊人医话》：「婴儿周与耕涎生数月时，感受暑滞，脾阳不振，水泄多日，囟门下陷，乳饮日少，脆弱万分。投以小剂补中益气汤，去升麻易以煨防风，次日泻止而囟门亦起。」又说：「按东垣用升麻来升脾阳，每嫌其过；天士改用防风，比较稳妥。」"}]},{"ID":"20240607123311-mxrkqeb","Type":"NodeThematicBreak","Properties":{"id":"20240607123311-mxrkqeb"}},{"ID":"20240607123323-aj9sny3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123323-aj9sny3","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"《中国药典》：防风"}]},{"ID":"20240607123323-cauzds9","Type":"NodeParagraph","Properties":{"id":"20240607123323-cauzds9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123323-s1vjyb1","Type":"NodeParagraph","Properties":{"id":"20240607123323-s1vjyb1","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" Fánɡ Fēnɡ"}]},{"ID":"20240607123323-iyir8mr","Type":"NodeParagraph","Properties":{"id":"20240607123323-iyir8mr","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607123323-4q9t5jp","Type":"NodeParagraph","Properties":{"id":"20240607123323-4q9t5jp","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" RADIX SAPOSHNIKOVIAE"}]},{"ID":"20240607123323-g8w17ie","Type":"NodeParagraph","Properties":{"id":"20240607123323-g8w17ie","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123323-m2xmv76","Type":"NodeParagraph","Properties":{"id":"20240607123323-m2xmv76","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 本品为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防风"},{"Type":"NodeText","Data":"Saposhnikovia divaricata （Turcz.） Schischk. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋二季采挖未抽花茎植株的根，除去须根及泥沙，晒干。"}]},{"ID":"20240607123323-2csvkto","Type":"NodeParagraph","Properties":{"id":"20240607123323-2csvkto","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123323-p3b6iln","Type":"NodeParagraph","Properties":{"id":"20240607123323-p3b6iln","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 本品呈长圆锥形或长圆柱形，下部渐细，有的略弯曲，长15～30cm，直径0.5～2cm。表面灰棕色，粗糙，有纵皱纹、多数横长皮孔及点状突起的细根痕。根头部有明显密集的环纹，有的环纹上残存棕褐色毛状叶基。体轻，质松，易折断，断面不平坦，皮部浅棕色，有裂隙，木部浅黄色。气特异，味微甘。"}]},{"ID":"20240607123323-5v5bbas","Type":"NodeParagraph","Properties":{"id":"20240607123323-5v5bbas","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607123323-f0c7nbh","Type":"NodeParagraph","Properties":{"id":"20240607123323-f0c7nbh","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防蛀。"}]},{"ID":"20240607123323-4vnxnx9","Type":"NodeParagraph","Properties":{"id":"20240607123323-4vnxnx9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123323-ialw6dk","Type":"NodeParagraph","Properties":{"id":"20240607123323-ialw6dk","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240607123323-m7ubnh3","Type":"NodeParagraph","Properties":{"id":"20240607123323-m7ubnh3","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607123323-duyqqne","Type":"NodeParagraph","Properties":{"id":"20240607123323-duyqqne","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：木栓层为 5～30列细胞。皮层窄,有较大的椭圆形油管。韧皮部较宽，有多数类圆形油管，周围分泌细胞4～8个，管内可见金黄色分泌物；射线多弯曲，外侧常成裂隙。形成层明显。木质部导管甚多，呈放射状排列。根头处有髓，"}]},{"ID":"20240607123323-adrfzth","Type":"NodeParagraph","Properties":{"id":"20240607123323-adrfzth","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"薄壁组织中偶见石细胞。粉末淡棕色。油管直径17～60μm，充满金黄色分泌物。叶基维管束常伴有纤维束。网纹导管直径14～85μm。石细胞少见，黄绿色，长圆形或类长方形，壁较厚。"}]},{"ID":"20240607123323-lir4g7u","Type":"NodeParagraph","Properties":{"id":"20240607123323-lir4g7u","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末1g，加丙酮20ml，超声处理20分钟，滤过，滤液蒸干，残渣加乙醇1ml使溶解，作为供试品溶液。另取防风对照药材1g，同法制成对照药材溶液。再取升麻苷和5-O-甲基维斯阿米醇苷对照品，加乙醇制成每1ml各含1mg的混合溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述三种溶液各10μl，分别点于同一硅胶GF254薄层板上，以氯仿-甲醇（4：1）为展开剂，展开，取出，晾干，置紫外光灯（254nm）下检视。供试品色谱中，在与对照药材和对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607123323-a7ejc78","Type":"NodeParagraph","Properties":{"id":"20240607123323-a7ejc78","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123323-x1ldk0h","Type":"NodeParagraph","Properties":{"id":"20240607123323-x1ldk0h","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 归膀胱、肝、脾经。"}]},{"ID":"20240607123323-k7l8j0f","Type":"NodeParagraph","Properties":{"id":"20240607123323-k7l8j0f","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123323-1x01bq1","Type":"NodeParagraph","Properties":{"id":"20240607123323-1x01bq1","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 辛、甘，温。"}]},{"ID":"20240607123323-edbp43g","Type":"NodeParagraph","Properties":{"id":"20240607123323-edbp43g","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123323-r4zzkoe","Type":"NodeParagraph","Properties":{"id":"20240607123323-r4zzkoe","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 解表祛风，胜湿，止痉。用于感冒头痛，风湿痹痛，风疹瘙痒，破伤风。"}]},{"ID":"20240607123323-bv15og7","Type":"NodeParagraph","Properties":{"id":"20240607123323-bv15og7","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123323-1w8jdat","Type":"NodeParagraph","Properties":{"id":"20240607123323-1w8jdat","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 4.5～9g。"}]},{"ID":"20240607123323-rlbazbw","Type":"NodeParagraph","Properties":{"id":"20240607123323-rlbazbw","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607123323-xw73k77","Type":"NodeParagraph","Properties":{"id":"20240607123323-xw73k77","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" （1）防风解表以祛风为长，既能散风寒，又能发散风热，与荆芥作用相仿，故两药往往配合应用。防风能祛风湿而止痛，常配合羌活、防己等治疗风湿痹痛等症。防风治破伤风，有祛风止痉的作用，但多配合天南星、天麻、白附子等药同用。此外，本品又有止血、止泻作用，如用于腹痛泄泻，常配合白芍、白朮、陈皮等同用；如用于便血、崩漏，一般炒炭应用。"}]},{"ID":"20240607123323-o2zxf99","Type":"NodeParagraph","Properties":{"id":"20240607123323-o2zxf99","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"（2）防风一药，顾名思义，是治风止痛的药物。它既能祛风寒而解表，又能祛风湿而止痛。因它微温而不燥，药性较为缓和，故又可用于风热痈盛、目赤肿痛、咽喉不利等症，可与荆芥、薄荷、连翘、山栀、黄芩等同用。至于祛风解痉方面，则力量较弱，如用治破伤风，本品只能作为辅助药，不能独任其功。荆芥与防风常同用于祛风解表，有如麻黄配桂枝以发汗解表，也是取它相须的作用。但荆、防发散之力不如麻、桂，作用较为缓和。至于荆、防两药相比，则荆芥发汗之力较强，而防风祛风止痛之功较好。根据临床体会，防风炒用可减缓它祛风的力量，却有止泻的功效，可用于腹泻。防风炒炭，又可用于崩漏而见血色清淡者，与温经止血的炮姜相比，则功用相似而力较逊。"}]},{"ID":"20240607123323-939ygtm","Type":"NodeParagraph","Properties":{"id":"20240607123323-939ygtm","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123323-7ma1om3","Type":"NodeParagraph","Properties":{"id":"20240607123323-7ma1om3","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607123323-c8t61b5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123323-c8t61b5","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：防风"}]},{"ID":"20240607123323-a3o4rkc","Type":"NodeParagraph","Properties":{"id":"20240607123323-a3o4rkc","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123323-ni47sda","Type":"NodeParagraph","Properties":{"id":"20240607123323-ni47sda","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" Fánɡ Fēnɡ"}]},{"ID":"20240607123323-evr9ljv","Type":"NodeParagraph","Properties":{"id":"20240607123323-evr9ljv","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123323-344ztqo","Type":"NodeParagraph","Properties":{"id":"20240607123323-344ztqo","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 铜芸（《本经》），茴芸、茴草、百枝、闾根、百蜚（《吴普本草》），屏风（《别录》），风肉（《药材资料汇编》）。"}]},{"ID":"20240607123323-8n26ru2","Type":"NodeParagraph","Properties":{"id":"20240607123323-8n26ru2","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607123323-2dqnya2","Type":"NodeParagraph","Properties":{"id":"20240607123323-2dqnya2","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607123323-azg88lt","Type":"NodeParagraph","Properties":{"id":"20240607123323-azg88lt","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123323-bg58ltq","Type":"NodeParagraph","Properties":{"id":"20240607123323-bg58ltq","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防风"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋均可采挖，将根挖出后，除去茎叶及泥土，先晒至八成干，捆把后，再晒至足干。"}]},{"ID":"20240607123323-8abb30y","Type":"NodeParagraph","Properties":{"id":"20240607123323-8abb30y","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607123323-03jzenl","Type":"NodeParagraph","Properties":{"id":"20240607123323-03jzenl","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 野生于丘陵地带山坡草丛中，或田边、路旁，高山中、下部。分布东北、内蒙古、河北、山东、河南、陕西、山西、湖南等地。"}]},{"ID":"20240607123323-ty6whij","Type":"NodeParagraph","Properties":{"id":"20240607123323-ty6whij","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123323-xcezwxb","Type":"NodeParagraph","Properties":{"id":"20240607123323-xcezwxb","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 防风，又名：山芹莱、白毛草。"}]},{"ID":"20240607123323-egxpq8m","Type":"NodeParagraph","Properties":{"id":"20240607123323-egxpq8m","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～80厘米，全体无毛。根粗壮，茎基密生褐色纤维状的叶柄残基。茎单生，2歧分枝。基生叶三角状卵形，长7～19厘米，2～3回羽状分裂，最终裂片条形至披针形，全缘；叶柄长2～6.5厘米；顶生叶简化，具扩展叶鞘.复伞形花序，顶生；伞梗5～9，不等长；总苞片缺如；小伞形花序有花4～9朵，小总苞片4～5，披针形；萼齿短三角形，较显着；花瓣5，白色，倒卵形，凹头，向内卷；子房下位，2室，花柱2，花柱基部圆锥形。双悬果卵形，幼嫩时具疣状突起，成熟时裂开成2分果，悬挂在二果柄的顶端，分果有棱。花期8～9月；果期9～10月。"}]},{"ID":"20240607123323-3po2ard","Type":"NodeParagraph","Properties":{"id":"20240607123323-3po2ard","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123323-rvhyj34","Type":"NodeParagraph","Properties":{"id":"20240607123323-rvhyj34","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 干燥的根，呈圆锥形或纺锤形，稍弯曲，长20～30厘米，根头部直径约1厘米，中部直径1～1.5厘米。表面灰黄色或灰棕色。根头部有密集的细环节，节上有棕色粗毛，顶端有茎的残痕；根部外皮皱缩而粗糙，有不整齐的纵皱及细横纹，除散生污黄色的横长皮孔外，点状突起的须根痕也随处可见。质松而软，易折断，断而不平坦，木部淡黄色，皮部黄棕色有裂隙，射线呈放射状。气微香，味微甘。以条粗壮、皮细而紧、无毛头、断面有棕色环、中心色淡黄者为佳。外皮粗糙、有毛头，带硬苗者质次。"}]},{"ID":"20240607123323-xbj0loh","Type":"NodeParagraph","Properties":{"id":"20240607123323-xbj0loh","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"主产于黑龙江、吉林、内蒙古、河北。此外，辽防风药材宁、山东、山西、陕西等地亦产。以黑龙江产量最大。在商品中，黑龙江、吉林、辽宁，内蒙古（东部）所产的称\"关防风\"或\"东防风\"，品质最佳；内蒙古（西部）、河北（承德、张家口）所产的\"口防风\"和山西所产的\"西防风\"品质次于关防风；河北（保定、唐山）及山东所产的称\"山防风\"，又称\"黄防风\"、\"青防风\"，品质亦较次。"}]},{"ID":"20240607123323-rrjfg5m","Type":"NodeParagraph","Properties":{"id":"20240607123323-rrjfg5m","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607123323-8z6ylgz","Type":"NodeParagraph","Properties":{"id":"20240607123323-8z6ylgz","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防蛀。"}]},{"ID":"20240607123323-1t8no00","Type":"NodeParagraph","Properties":{"id":"20240607123323-1t8no00","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123323-x8p9cmw","Type":"NodeParagraph","Properties":{"id":"20240607123323-x8p9cmw","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 防风含挥发油、甘露醇、苦味甙等。"}]},{"ID":"20240607123323-klun0gc","Type":"NodeParagraph","Properties":{"id":"20240607123323-klun0gc","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607123323-diig671","Type":"NodeParagraph","Properties":{"id":"20240607123323-diig671","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" ①解热作用"}]},{"ID":"20240607123323-0cmhg0b","Type":"NodeParagraph","Properties":{"id":"20240607123323-0cmhg0b","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"对人工发热家兔，经口给予关防风煎剂或浸剂，有明显解热作用，煎剂的作用较浸剂好。"}]},{"ID":"20240607123323-yq171wi","Type":"NodeParagraph","Properties":{"id":"20240607123323-yq171wi","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②镇痛作用"}]},{"ID":"20240607123323-3e3h7lt","Type":"NodeParagraph","Properties":{"id":"20240607123323-3e3h7lt","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"小鼠灌服防风（品种未鉴定）50％乙醇浸出液（蒸去乙醇），能明显提高痛阈（电刺激鼠尾法），皮下注射同样有效。"}]},{"ID":"20240607123323-vy5e1pi","Type":"NodeParagraph","Properties":{"id":"20240607123323-vy5e1pi","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③抗菌作用"}]},{"ID":"20240607123323-36xv8gr","Type":"NodeParagraph","Properties":{"id":"20240607123323-36xv8gr","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"新鲜关防风榨出液在体外试验，对绿脓杆菌及金黄色葡萄球菌有一定抗菌作用。品种未经鉴定的防风煎剂对溶血性链球菌及痢疾杆菌也有一定的抗菌作用。"}]},{"ID":"20240607123323-mwtl5xb","Type":"NodeParagraph","Properties":{"id":"20240607123323-mwtl5xb","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"关防风醇浸膏给家兔皮下注射，对血糖无影响。"}]},{"ID":"20240607123323-hezsqs9","Type":"NodeParagraph","Properties":{"id":"20240607123323-hezsqs9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123323-9q9cqas","Type":"NodeParagraph","Properties":{"id":"20240607123323-9q9cqas","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 防风：除去残茎，用水浸泡，捞出，润透切片，晒干。炒防风：取防风片，置锅内微炒至深黄色，取出放凉。"}]},{"ID":"20240607123323-60lsnf8","Type":"NodeParagraph","Properties":{"id":"20240607123323-60lsnf8","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607123323-qwt179s","Type":"NodeParagraph","Properties":{"id":"20240607123323-qwt179s","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 本品横切面：木栓层为 5～30列细胞。皮层窄，有较大的椭圆形油管。韧皮部较宽，有多数类圆形油管，周围分泌细胞4～8个，管内可见金黄色分泌物；射线多弯曲，外侧常成裂隙。形成层明显。木质部导管甚多，呈放射状排列。根头处有髓，薄壁组织中偶见石细胞。粉末淡棕色。油管直径17～60μｍ，充满金黄色分泌物。叶基维管束常伴有纤维束。网纹导管直径14～85μｍ。石细胞少见，黄绿色，长圆形或类长方形，壁较厚。"}]},{"ID":"20240607123323-s5bq9cy","Type":"NodeParagraph","Properties":{"id":"20240607123323-s5bq9cy","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123323-e400sfc","Type":"NodeParagraph","Properties":{"id":"20240607123323-e400sfc","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 入膀胱、肺、脾经。"}]},{"ID":"20240607123323-hmrgvtu","Type":"NodeParagraph","Properties":{"id":"20240607123323-hmrgvtu","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"太阳经本药。\""}]},{"ID":"20240607123323-qkzl4ht","Type":"NodeParagraph","Properties":{"id":"20240607123323-qkzl4ht","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②《汤液本草》：\"足阳明胃、足太阴脾二经之行经药。\""}]},{"ID":"20240607123323-aomcbft","Type":"NodeParagraph","Properties":{"id":"20240607123323-aomcbft","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③《雷公炮制药性解》：\"入肺经。\""}]},{"ID":"20240607123323-phhqpi6","Type":"NodeParagraph","Properties":{"id":"20240607123323-phhqpi6","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入肝、脾、肾三经。\""}]},{"ID":"20240607123323-gh08i45","Type":"NodeParagraph","Properties":{"id":"20240607123323-gh08i45","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123323-w5zu16w","Type":"NodeParagraph","Properties":{"id":"20240607123323-w5zu16w","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 辛甘，温。"}]},{"ID":"20240607123323-d72cilv","Type":"NodeParagraph","Properties":{"id":"20240607123323-d72cilv","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，温。\""}]},{"ID":"20240607123323-prjutwl","Type":"NodeParagraph","Properties":{"id":"20240607123323-prjutwl","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛，无毒。\""}]},{"ID":"20240607123323-nbhr6dl","Type":"NodeParagraph","Properties":{"id":"20240607123323-nbhr6dl","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"气和，味甘微辛，性微温。\""}]},{"ID":"20240607123323-0tuqy6r","Type":"NodeParagraph","Properties":{"id":"20240607123323-0tuqy6r","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"味辛，性平，无毒。\""}]},{"ID":"20240607123323-j2qv84r","Type":"NodeParagraph","Properties":{"id":"20240607123323-j2qv84r","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607123323-4y61l0e","Type":"NodeParagraph","Properties":{"id":"20240607123323-4y61l0e","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 血虚痉急或头痛不因风邪者忌服。"}]},{"ID":"20240607123323-wazikpy","Type":"NodeParagraph","Properties":{"id":"20240607123323-wazikpy","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶干姜、藜芦、白蔹、芫花。\""}]},{"ID":"20240607123323-lqovqko","Type":"NodeParagraph","Properties":{"id":"20240607123323-lqovqko","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"畏萆薢。\""}]},{"ID":"20240607123323-htj02qj","Type":"NodeParagraph","Properties":{"id":"20240607123323-htj02qj","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"诸病血虚痉急，头痛不因于风寒，溏泄不因于寒湿，二便秘涩，小儿脾虚发搐，慢惊慢脾风，气升作呕，火升发嗽，阴虚盗汗，阳虚自汗等病，法所同忌。\""}]},{"ID":"20240607123323-3b1e03h","Type":"NodeParagraph","Properties":{"id":"20240607123323-3b1e03h","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"④《得配本草》：\"元气虚，病不因风湿者禁用。\""}]},{"ID":"20240607123323-n0s3ipe","Type":"NodeParagraph","Properties":{"id":"20240607123323-n0s3ipe","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123323-780f640","Type":"NodeParagraph","Properties":{"id":"20240607123323-780f640","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 发表，祛风，胜湿，止痛。治外感风寒，头痛，目眩，项强，风寒湿痹，骨节酸痛，四肢挛急，破伤风。"}]},{"ID":"20240607123323-prjvsx8","Type":"NodeParagraph","Properties":{"id":"20240607123323-prjvsx8","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主大风头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹，烦满。\""}]},{"ID":"20240607123323-hauojj2","Type":"NodeParagraph","Properties":{"id":"20240607123323-hauojj2","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"杀附子毒。\""}]},{"ID":"20240607123323-bbo8xeu","Type":"NodeParagraph","Properties":{"id":"20240607123323-bbo8xeu","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"胁痛，胁风头面去来，四肢挛急，字乳金疮内痉。\""}]},{"ID":"20240607123323-t9jxa5c","Type":"NodeParagraph","Properties":{"id":"20240607123323-t9jxa5c","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治三十六般风，男子一切劳劣，补中益神，风赤眼，止泪及瘫缓，通利五脏关脉，五劳七伤，羸损盗汗，心烦体重，能安神定志，匀气脉。\""}]},{"ID":"20240607123323-nh02vi0","Type":"NodeParagraph","Properties":{"id":"20240607123323-nh02vi0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑤《珍珠囊》：\"身：去上风，梢：去下风。\""}]},{"ID":"20240607123323-mzrm3y7","Type":"NodeParagraph","Properties":{"id":"20240607123323-mzrm3y7","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑥《药类法象》：\"治风通用。泻肺实，散头目中滞气，除上焦风邪。\""}]},{"ID":"20240607123323-iitqkb0","Type":"NodeParagraph","Properties":{"id":"20240607123323-iitqkb0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑦王好占：\"搜肝气。\""}]},{"ID":"20240607123323-sjszhbt","Type":"NodeParagraph","Properties":{"id":"20240607123323-sjszhbt","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑧《长沙药解》：\"行经络，逐湿淫，通关节，止疼痛，舒筋脉，伸急挛，活肢节，起瘫痪，敛自汗、盔汗，断漏下、崩中。\""}]},{"ID":"20240607123323-d1tp2d0","Type":"NodeParagraph","Properties":{"id":"20240607123323-d1tp2d0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑨《本草求原》：\"解乌头、芫花、野菌诸热药毒。\""}]},{"ID":"20240607123323-2kkq0d4","Type":"NodeParagraph","Properties":{"id":"20240607123323-2kkq0d4","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123323-2i34x5l","Type":"NodeParagraph","Properties":{"id":"20240607123323-2i34x5l","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240607123323-l0e1m0m","Type":"NodeParagraph","Properties":{"id":"20240607123323-l0e1m0m","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123323-dvepf03","Type":"NodeParagraph","Properties":{"id":"20240607123323-dvepf03","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" ①治风邪伤卫，有汗恶风：防风、荆芥、葛根。（《症因脉治》防风汤）"}]},{"ID":"20240607123323-y8zcq1x","Type":"NodeParagraph","Properties":{"id":"20240607123323-y8zcq1x","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②治偏正头痛，年深不愈，风湿热上塑损目，及脑痛不止：川芎五钱，柴胡七钱，黄连（炒）、防风（去芦）、羌活各一两，炙甘草一两五钱，黄芩三两（去皮，锉，一半酒制，一半炒）。上为细末，每服二钱匕，于盏内入茶少许，汤调如膏，抹在口内，少用白汤送下。临卧，如苦头痛，每服加细辛二分。（《兰室秘藏》清空膏）"}]},{"ID":"20240607123323-49n2trd","Type":"NodeParagraph","Properties":{"id":"20240607123323-49n2trd","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③治偏正头风，痛不可忍者：防风、白芷各四两。上为细末，炼蜜和丸，如弹子大。如牙风毒，只用茶清为丸，每服一丸，茶汤下。如偏正头风，空心服。如身上麻风，食后服。未愈连进三服。（《普济方》）"}]},{"ID":"20240607123323-u2cv61a","Type":"NodeParagraph","Properties":{"id":"20240607123323-u2cv61a","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"④治风热拂郁，筋脉拘倦，肢体焦痿，头目昏眩，腰脊强痛，耳鸣鼻塞，口苦舌干，咽嗌不利，胸膈痞闷，咳呕喘满，涕唾稠粘，肠胃燥，热结，便溺淋闭等症：防风、川芎、当归、芍药、大黄、薄荷叶、麻黄、连翘，芒硝各半两，石膏、黄芩、桔梗各一两，滑石三两，甘草二两，荆芥、白术、栀子各-分。上为末，每服二钱，水一大盏，生姜三片，煎至六分，温服。（《宜明论方》防风通圣散）"}]},{"ID":"20240607123323-lc5w0n5","Type":"NodeParagraph","Properties":{"id":"20240607123323-lc5w0n5","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑤治白虎风，走转疼痛，两膝热肿：防风一（二）两（去芦头，微炒），地龙二两（微炒），漏芦二两，上件药，捣细罗为散，每服，不计时候，以温酒调下二钱。（《圣惠方》防风散）"}]},{"ID":"20240607123323-7iegxz8","Type":"NodeParagraph","Properties":{"id":"20240607123323-7iegxz8","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑥治痈疽最难收口者：防风、白芷、甘草、赤芍、川芎、归尾各二钱，雄猪蹄一节。加连须葱白五根，用水三大碗煎，以绢片蘸水洗之，拭干，然后上药，其深曲处，以羊毛笔洗之。（《外科十法》防风汤）"}]},{"ID":"20240607123323-vtaubqv","Type":"NodeParagraph","Properties":{"id":"20240607123323-vtaubqv","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑦治一切风疮疥癣，皮肤瘙痒，搔成瘾疹：防风（去叉）、蝉壳、猪牙皂荚（酥炙，去皮、子）各一两半，天麻二两。上四味捣为细末，用精羊肉煮熟捣烂，以酒熬为膏，丸如绿豆大，每服三十丸，荆芥酒或茶汤下。（《圣济总录》防风丸）"}]},{"ID":"20240607123323-pb1qw3n","Type":"NodeParagraph","Properties":{"id":"20240607123323-pb1qw3n","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑧治破伤风及打扑伤损：天南星（汤洗七次）、防风（去叉股）各等分。细末。如破伤以药敷贴疮口，然后以温酒调下一钱。如牙关急紧，角弓反张，用药二钱，童子小便调下，或因斗伤相打，内有伤损之人，以药二钱，温酒调下。（《本事方》玉真散）"}]},{"ID":"20240607123323-bfmesvq","Type":"NodeParagraph","Properties":{"id":"20240607123323-bfmesvq","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑨治自汗：防风、黄芪各一两，白术二两。每服三钱，水一钟半，姜三片煎服。（《丹溪心法》玉屏风散）"}]},{"ID":"20240607123323-lw9u9g2","Type":"NodeParagraph","Properties":{"id":"20240607123323-lw9u9g2","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑩治盗汗：防风五钱，川芎二钱半，人参一钱二分半。为细末，每服二钱，临卧米饮调下。（《世医得效方》防风散）"}]},{"ID":"20240607123323-i39rc8q","Type":"NodeParagraph","Properties":{"id":"20240607123323-i39rc8q","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑾消风顺气，治老人大肠秘涩：防风、枳壳（麸炒）各一两，甘草半两。为末，每食前白汤服二钱。（《简便单方》）"}]},{"ID":"20240607123323-1mc3x6g","Type":"NodeParagraph","Properties":{"id":"20240607123323-1mc3x6g","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⑿治崩中：防风去芦头，炙亦为末，每服二钱，以面糊、酒调下，更以面糊、酒投之。（《经验后方》）"}]},{"ID":"20240607123323-f8inxnq","Type":"NodeParagraph","Properties":{"id":"20240607123323-f8inxnq","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"⒀治霉菌性阴道炎：防风、大戟、艾叶各五钱。水煎，熏洗，每日一次。（徐州《单方验方新医疗法》）"}]},{"ID":"20240607123323-ywvi510","Type":"NodeParagraph","Properties":{"id":"20240607123323-ywvi510","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607123323-1v9p6nx","Type":"NodeParagraph","Properties":{"id":"20240607123323-1v9p6nx","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 除上述正品防风外，尚有以下几种，均为地区习惯用药。"}]},{"ID":"20240607123323-l2xyvci","Type":"NodeParagraph","Properties":{"id":"20240607123323-l2xyvci","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"①川防风为同科植物短裂藁本的根，详\"川防风\"条。"}]},{"ID":"20240607123323-ng2usud","Type":"NodeParagraph","Properties":{"id":"20240607123323-ng2usud","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"②竹叶防风"}]},{"ID":"20240607123323-ornt80o","Type":"NodeParagraph","Properties":{"id":"20240607123323-ornt80o","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"为同科植物竹叶防风的根，详\"竹叶防风\"条。"}]},{"ID":"20240607123323-xm44vk0","Type":"NodeParagraph","Properties":{"id":"20240607123323-xm44vk0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"③云防风"}]},{"ID":"20240607123323-o6waoj0","Type":"NodeParagraph","Properties":{"id":"20240607123323-o6waoj0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"为同科植物松叶防风的根，产云南、四川。植物高30～100厘米，茎有细条纹。叶为2回或3回成三数分裂，裂片狭线形或线状披针形，中部以上茎生叶有叶鞘。伞形花序，花序柄延长，坚硬；无总苞或仅有叶状总苞1片；伞辐6～8，长短不一；小总苞片约10片；萼缺；花冠黄色。果卵形。"}]},{"ID":"20240607123323-kmskexq","Type":"NodeParagraph","Properties":{"id":"20240607123323-kmskexq","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"④新疆防风"}]},{"ID":"20240607123323-w1due8d","Type":"NodeParagraph","Properties":{"id":"20240607123323-w1due8d","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"为同科植物细叶防风的根。产新疆。植物高1～2米。基生叶多数，3回羽状全裂，裂片线形；茎生叶较小。伞形花序，伞辐少数，不等长，被短柔毛；总苞有5～10片披针形苞片，背面被短柔毛；小伞形花序有花多数，集成头状，小总苞有6～7片小苞片；萼齿短，丝状；花瓣白色。果近圆柱形，密生柔毛。"}]},{"ID":"20240607123323-53wxl1h","Type":"NodeParagraph","Properties":{"id":"20240607123323-53wxl1h","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123323-v30qlks","Type":"NodeParagraph","Properties":{"id":"20240607123323-v30qlks","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607123323-eozx1oi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123323-eozx1oi","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"《中华本草》：防风"}]},{"ID":"20240607123323-4z4dki9","Type":"NodeParagraph","Properties":{"id":"20240607123323-4z4dki9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123323-idjb1it","Type":"NodeParagraph","Properties":{"id":"20240607123323-idjb1it","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" Fánɡ Fēnɡ"}]},{"ID":"20240607123323-x4gf0pc","Type":"NodeParagraph","Properties":{"id":"20240607123323-x4gf0pc","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123323-e3jprks","Type":"NodeParagraph","Properties":{"id":"20240607123323-e3jprks","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 铜芸、回云、回草、百枝、百种、屏风、风肉"}]},{"ID":"20240607123323-ianzhgh","Type":"NodeParagraph","Properties":{"id":"20240607123323-ianzhgh","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607123323-4ovgqkd","Type":"NodeParagraph","Properties":{"id":"20240607123323-4ovgqkd","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" Divaricate Saposhnikovia Root, Root of Divaricate Saposhnikovia"}]},{"ID":"20240607123323-pzttjoa","Type":"NodeParagraph","Properties":{"id":"20240607123323-pzttjoa","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607123323-bow0fhb","Type":"NodeParagraph","Properties":{"id":"20240607123323-bow0fhb","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.《别录》：防风、生沙苑川泽及邯郸、琅琊、上蔡。二月、十月采根，暴干。"}]},{"ID":"20240607123323-u41etz3","Type":"NodeParagraph","Properties":{"id":"20240607123323-u41etz3","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：郡县无名沙苑。今（防风）第一出彭城兰陵，即近琅琊者，郁州互市亦得之。次出襄阳、义阳县界，亦可用，即近上蔡者，惟实而脂润，头节坚如蚯蚓头者为好。"}]},{"ID":"20240607123323-d8vmzfg","Type":"NodeParagraph","Properties":{"id":"20240607123323-d8vmzfg","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：防风今出齐州，龙山最善，淄州、兖州、青州者亦佳。叶似牡蒿、附子苗等。《别录》云，叉头者令人发狂，叉尾者发痼疾，子似胡荽而大，"}]},{"ID":"20240607123323-hwa4e6v","Type":"NodeParagraph","Properties":{"id":"20240607123323-hwa4e6v","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123323-gs0n4v6","Type":"NodeParagraph","Properties":{"id":"20240607123323-gs0n4v6","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物防风的根。"}]},{"ID":"20240607123323-q7de7s2","Type":"NodeParagraph","Properties":{"id":"20240607123323-q7de7s2","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Saposhnikouia diuaricata (Turcz.) Schis-chk.[Stenocoelium diuaricatum Turcz.; Siler diuaricatum (Tur-cz.) Benth. Et Hoo. F. ; Ledebouriella seseloides Auct. Non Wolff; L.diuaricata (Turcz) Hiroe]"}]},{"ID":"20240607123323-ur6vayk","Type":"NodeParagraph","Properties":{"id":"20240607123323-ur6vayk","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"采收和储藏：一般于地苛种第2年的冬季收获，如选地不当或管理不善，则需3-4年收获。采挖后，去掉残茎、须根及泥土，晒至九成干时，按粗细长短分别扎成小捆，再晒或炕干。"}]},{"ID":"20240607123323-mh00rzt","Type":"NodeParagraph","Properties":{"id":"20240607123323-mh00rzt","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607123323-bdqiwtw","Type":"NodeParagraph","Properties":{"id":"20240607123323-bdqiwtw","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于草原、丘陵和多古砾山坡上。"}]},{"ID":"20240607123323-i31szuc","Type":"NodeParagraph","Properties":{"id":"20240607123323-i31szuc","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北及陕西、甘肃、宁夏、山东等地。"}]},{"ID":"20240607123323-ahu88b2","Type":"NodeParagraph","Properties":{"id":"20240607123323-ahu88b2","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123323-55c3jrd","Type":"NodeParagraph","Properties":{"id":"20240607123323-55c3jrd","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高30-80cm。根粗壮，长圆柱形，有分枝，淡黄桂冠色，根斜上升，与主茎近等长，有细棱。基生叶丛生，有扁长的叶柄，基部有宽叶鞘，稍抱茎；叶片卵形或长圆形，长14-35cm，宽6-8（-18）cm，二至三回羽状分裂，第一回裂片卵形或长圆形，有柄，长5-8cm，第二回裂片下部具短柄，末回裂片狭楔形，长2.5-5cm，宽1-2.5cm；顶生叶间化，有宽叶鞘。复伞形花序多数，生于茎和分枝顶端，顶生花序梗长2-5cm，伞辐5-7，长3-5cm，无毛，无总苞片；小伞形花序有死4-10，小总苞片4-6，线形或披针形，长约3mm；萼齿三角状卵形；花瓣倒卵形，白色，长约1.5mm，无毛，先端微凹，具内折小舌片。双悬果狭圆形或椭圆形，长4-5mm，宽2-3mm，幼时有疣状突起，成熟时渐平滑；每棱槽内有油管1，合生面有油管2。花期8-9月，果期9-10月。"}]},{"ID":"20240607123323-f4bd4pb","Type":"NodeParagraph","Properties":{"id":"20240607123323-f4bd4pb","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607123323-70wlcvs","Type":"NodeParagraph","Properties":{"id":"20240607123323-70wlcvs","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽气候，耐寒，耐干旱。宜选阳光充足，土层深厚，疏松肥沃、排水良好的砂质壤土栽培，不宜在酸性大，粘性重的土壤中种植。"}]},{"ID":"20240607123323-h8sc5wr","Type":"NodeParagraph","Properties":{"id":"20240607123323-h8sc5wr","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、根插繁殖。种子繁殖：春播在3月下旬至4月中旬；秋播在9-10月进行。条播按行距30cm开沟，深2cm，将种子均匀播入沟内，覆土盖平，盖草浇水。播后20-25d即可出苗，1hm2用种子15-30kg。根插繁殖：在收获时或早春，取粗0.7cm以上的根条，截成3-5cm长段，按行株距50cm×15cm。1hm2用根量750kg。也可将种根于冬季按行株距10cm×50cm假植育苗，待翌年早春有1-2片叶子时移栽定植。"}]},{"ID":"20240607123323-5mkprgv","Type":"NodeParagraph","Properties":{"id":"20240607123323-5mkprgv","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高5cm时，按株距7cm间苗，苗高10-13cm时，按株距13-16cm，定苗。6月前除草、培土，6月上旬和8月下旬各追肥1次。两年以上植株，除留种外，应及时摘除蓊苔。"}]},{"ID":"20240607123323-x109xqy","Type":"NodeParagraph","Properties":{"id":"20240607123323-x109xqy","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害的白粉病，夏、秋季为害，发病时喷波美0.2-0.3度石硫合剂，或托布津800-1000倍液，或25%粉锈宁1000倍液喷雾。虫害有黄凤蝶，5月开始为害，在幼龄期喷90%敌百虫800倍液喷杀。黄翅茴香螟，现蕾开花期发生，在早晨或傍晚用90%敌虫800倍液或Bt乳剂300倍液喷雾防治。"}]},{"ID":"20240607123323-l4ny90d","Type":"NodeParagraph","Properties":{"id":"20240607123323-l4ny90d","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"还有蚜虫为害。"}]},{"ID":"20240607123323-1ynqze1","Type":"NodeParagraph","Properties":{"id":"20240607123323-1ynqze1","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123323-57f6xnm","Type":"NodeParagraph","Properties":{"id":"20240607123323-57f6xnm","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根呈长圆锥形或长圆柱形，下部渐细，有的略弯曲，长15-30cm，直径0.5-2cm。表面灰棕色，粗糙，有纵皱纹、多数横长皮孔及点状突起的细根痕。根头部有明显密集的环纹，有的部有明显密集的环纹，有的五纹上残存棕褐色毛状叶基。体轻，质松，易折断，断面不平坦，皮部浅棕色，有裂隙，散生黄棕色油点，木部浅黄色。气特异，味微甘。"}]},{"ID":"20240607123323-xfsiox6","Type":"NodeParagraph","Properties":{"id":"20240607123323-xfsiox6","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"以条粗壮、断面皮部色浅棕、木部色浅黄者为佳。"}]},{"ID":"20240607123323-dt2u44k","Type":"NodeParagraph","Properties":{"id":"20240607123323-dt2u44k","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：木栓层为5-30列木栓细胞。皮层窄，有较大的椭圆形油管。韧皮部较宽，有多数类圆油管，周围分泌细胞4-8个，管内可见金黄色分泌物；射线多弯曲，外侧常成裂隙。形成层明显。木质部导色分泌物；射线多弯曲，外侧常成裂隙。形成层明显。木质部导管甚多，呈放射状排列。根头处有髓。薄壁组织中偶见石细胞。"}]},{"ID":"20240607123323-59uyebt","Type":"NodeParagraph","Properties":{"id":"20240607123323-59uyebt","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡棕色。①油管直径17-60μm，充满金黄色分泌物。②叶基维管束常拌有纤维束。③网纹导管直径14-85μm。④石细胞少见，黄绿色，长圆形或类长方形，壁较厚。"}]},{"ID":"20240607123323-pd1cxy8","Type":"NodeParagraph","Properties":{"id":"20240607123323-pd1cxy8","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607123323-ui5ern0","Type":"NodeParagraph","Properties":{"id":"20240607123323-ui5ern0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 取体重18-20g小鼠雌雄各半，均分4组，1次分别ig不同剂量的防风，观察5天由动物死亡数，按简化机率单位法计算LD50，结果LD50为213.8±25.4g（生药/kg）。"}]},{"ID":"20240607123323-v954vhq","Type":"NodeParagraph","Properties":{"id":"20240607123323-v954vhq","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123323-eh7y8kf","Type":"NodeParagraph","Properties":{"id":"20240607123323-eh7y8kf","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 根含色酮类成分：防风色酮醇（lede-bouriellol)，4′-O-葡萄糖基-5-O-甲基齿阿密醇（4′-O-glucosyl-5-O-methylvisamminol)，3′-O-当归酰基亥酚（3′-O-angeloyl-hamaudol)，亥茅酚（hamaudol)，3′-O-乙酰基亥茅酚（3 ′-O-acetyl-hamaudol)，亥茅酚甙（sec-O-glucosylhamaudol)，5-O-甲基具阿米醇（5-O-methylyisamminol)，升麻素（cimifugin)，升麻素甙（prim-O-glucosylcimifugin)；香豆精类成分：香柑内酯（bergapten)，补骨脂素（psoralen)，欧前胡内酯（imperatorin)，珊瑚菜素（phellopte-rin)，德尔妥因（deltoin)[1，2]，花椒毒素（xanthotoxin)[2]，川白芷内酯（anomalin)[3]，东莨菪素（scopoletin)[3,4]，印度榅桲素（marmesin)[4]；聚乙炔类成发：人参炔醇（panaxynol)又称镰叶芹醇（falcarinol)，镰叶芹二醇（falcarindiol)，（8E）-十七碳-1，8-二烯-4，6-二块-3，10-二醇[（8E）-heptadeca-1,8-dien-4,6-diyn-3,10diol][2,5]；防风酸性多糖（saposhnikovan)A、C[6，7]；挥发油含数10种成分，能鉴定的共20种，含量较高的有辛醛（octanal)，β-甜没药烯（β-bisabolene)，壬醛（nonanal)，7-辛烯-4-醇（7-octen-4-ol)，已醛（hexanal)，侧析烯（cuparene)和β-桉叶醇（β-eudesmol)等[8]。还含β-谷甾醇（β-sitosterol)，β-谷醇-β-D-葡萄糖甙（β-sitosterol-β-D-glucoside)[3]，甘露醇（mannitol)，香草酸（vanillic acid)[4]等。"}]},{"ID":"20240607123323-cpupxty","Type":"NodeParagraph","Properties":{"id":"20240607123323-cpupxty","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607123323-jy9jrel","Type":"NodeParagraph","Properties":{"id":"20240607123323-jy9jrel","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 1.镇痛作用:1.1.对醋酸致小鼠扭体反应的影响:取体重18-21g小鼠24只均分二组，分别po防风水煎剂（1ml含2g生药）40g/kg和同体积水。1小时后ip0.5%醋酸0.2ml/20g，观察20分钟内小鼠扭体反应次数，结果防风组小鼠扭体反应数为11.4±1.8次，明显低于对照组19.2±2.4次（P\u003c0.05）。"}]},{"ID":"20240607123323-bi5rh3d","Type":"NodeParagraph","Properties":{"id":"20240607123323-bi5rh3d","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"1.2.对小鼠痛阈的影响:采用热板法测定痛阈，其条件是热板温度为55±0.5℃。取体重18-20g雌性小鼠，经预测反应潜伏期后挑选其反应潜伏期不超过30s的小鼠20只，均分二组，分别po防风水煎剂相当生药40g/kg及同体积水，测定给药前后小鼠反应潜伏期，结果见表2，防风组小鼠的反应潜伏期在服药后60s及90s均明显延长，（P\u003c0.05）。"}]},{"ID":"20240607123323-kns27o5","Type":"NodeParagraph","Properties":{"id":"20240607123323-kns27o5","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"1.3.电刺激鼠尾法:电刺激鼠尾法表明，防冈乙醇浸剂给小白鼠ig21.18g/kg及sc42.36g/kg，均有一定镇痛作用，给药后镇痛率分别为46.4%和56.7%，60分钟后的镇痛率则分别39.O%与53.3%。"}]},{"ID":"20240607123323-nqoo3jf","Type":"NodeParagraph","Properties":{"id":"20240607123323-nqoo3jf","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.镇静作用:2.1.对戊巴比妥钠阈下睡眠剂量的影响:取体重20-28g小鼠40只均分二组，分别po防风水煎剂相当40g/kg和同体积水后1小时，ip戊巴比妥钠35mg/kg，记录15分钟内动物入睡数，以翻正反射消失1分钟以上为入睡指标。结果防风组入睡小鼠（17只，85%）比对照组（17只，35%）明显增加（P\u003c0.01）。"}]},{"ID":"20240607123323-ez3gwbq","Type":"NodeParagraph","Properties":{"id":"20240607123323-ez3gwbq","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.2.对小鼠自发活动的影响:取体重20-22g小鼠24只均分二组，分别po防风水煎剂相当40g/kg和同体积水后50分钟，记录10分钟内小鼠活动次数。结果防风组为226.3±35.9、对照组为326.7±27.7，可见防风使小鼠自发活动明显减少（P\u003c0.01）。"}]},{"ID":"20240607123323-5uwetot","Type":"NodeParagraph","Properties":{"id":"20240607123323-5uwetot","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.3.抗炎作用:取体重24g-26g雄性小鼠20只均分二组，剂量同上，l小时后，用巴豆油合剂25ul涂右耳致炎，4小时处死小鼠，称重并观察炎症反应程度。结果防风组的肿胀程度（13.9±0.9mg）明显低于对照组（18.4±1.2mg）（P\u003c0.05）。"}]},{"ID":"20240607123323-h14syek","Type":"NodeParagraph","Properties":{"id":"20240607123323-h14syek","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.4.体外抑菌试验:采用平板法进行体外抑菌实验，结果防风对金黄色葡萄球菌、乙型溶血性链球菌、肺炎双球菌及二种霉菌（产黄青霉、杂色曲霉）等有抑菌作用，而对流感杆菌、伤寒杆菌、福氏及志贺氏痢疾杆菌无抑菌作用。"}]},{"ID":"20240607123323-u4xjovg","Type":"NodeParagraph","Properties":{"id":"20240607123323-u4xjovg","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"5.抗过敏作用:5.1.对2，4-二硝基氯苯（DNCB）所致迟发型超敏反应的影响:取体重25-28g雄性小鼠20只均分二组，用5%DNCB丙酮溶液0.01ml背部皮肤致敏，次日再致敏一次，5天开始给药，防风组小鼠每日po防风20g/kg，对照组服用同体积水，连续给药7天，在末次给药后用1%DNCB丙酮0.02ml涂右耳，20小时处死小鼠取左右耳片（直径8mm）称重，以二耳片重量之差表示迟发型超敏反应的程度。结果防风组为2.90±0.45mg，明显低于对照组4.88±0.78mg（P\u003c0.05），说明防风有抑制DNCB所致的迟发型超敏反应的作用。"}]},{"ID":"20240607123323-e1yq1ih","Type":"NodeParagraph","Properties":{"id":"20240607123323-e1yq1ih","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"5.2.对致敏豚鼠离体气管、回肠平滑肌过敏性收缩的影响:取体重250g-350g豚鼠10只，于每只豚鼠腹腔注射5%卵蛋白1ml，同时二后腿各注射0.4ml致敏，4周后进行豚鼠离体气管回肠平滑肌过敏性收缩试验。结果，气管收缩（2.8±0.5mm），比对照试验（7.8±0.7mm）明显降低。回肠收缩试验结果，10段回肠收缩高度为31.8±4.3mm比对照组10段回肠收缩高度（42.4±5.2mm）明显降低。"}]},{"ID":"20240607123323-uwlcvw9","Type":"NodeParagraph","Properties":{"id":"20240607123323-uwlcvw9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"6.对小鼠腹腔巨噬细胞吞噬功能的影响:取体重23-25g小鼠24只分2组，每日ig给药1次，连服4天，在末次给药后同时ip5%鸡红细胞液0.5ml再处死，计算红细胞的吞噬百分率和吞噬指数。"}]},{"ID":"20240607123323-jlakyw9","Type":"NodeParagraph","Properties":{"id":"20240607123323-jlakyw9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"7.解热作用:将家兔用三联疫苗（百日咳、白喉、破伤风疫苗）制成动物致热模型。Ip关防风水煎液2g/kg，以安替匹林和生理盐水作对照。防风水煎液在1-2小时内解热作用明显。"}]},{"ID":"20240607123323-ke4g5qs","Type":"NodeParagraph","Properties":{"id":"20240607123323-ke4g5qs","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123323-2osogc9","Type":"NodeParagraph","Properties":{"id":"20240607123323-2osogc9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 1.除去残茎，用水浸泡，捞出，润透切片，晒干。"}]},{"ID":"20240607123323-ci3i4te","Type":"NodeParagraph","Properties":{"id":"20240607123323-ci3i4te","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.炒防风：取防风片，置锅内微炒至深黄色，取出放凉。"}]},{"ID":"20240607123323-8hne42d","Type":"NodeParagraph","Properties":{"id":"20240607123323-8hne42d","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"3.炭制：取防风片置锅内，用中火炒至外呈黑色，内呈黄褐色为度。喷洒清水适量，灭尽火星，取出，晾一夜。"}]},{"ID":"20240607123323-5dza3jm","Type":"NodeParagraph","Properties":{"id":"20240607123323-5dza3jm","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"4.蜜炙：取防风，加蜜炒至蜜被吸尽，放冷即可。每防风片1kg，蜂蜜0.3kg。"}]},{"ID":"20240607123323-am230u4","Type":"NodeParagraph","Properties":{"id":"20240607123323-am230u4","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123323-p5tgvh0","Type":"NodeParagraph","Properties":{"id":"20240607123323-p5tgvh0","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 归膀胱；肺；脾；肝经"}]},{"ID":"20240607123323-c51cadg","Type":"NodeParagraph","Properties":{"id":"20240607123323-c51cadg","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123323-25cq2lm","Type":"NodeParagraph","Properties":{"id":"20240607123323-25cq2lm","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 味辛；甘；性微温"}]},{"ID":"20240607123323-zgvhdjk","Type":"NodeParagraph","Properties":{"id":"20240607123323-zgvhdjk","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607123323-te4pfar","Type":"NodeParagraph","Properties":{"id":"20240607123323-te4pfar","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 血虚痉急或头痛不因风邪者忌服。"}]},{"ID":"20240607123323-3v0lial","Type":"NodeParagraph","Properties":{"id":"20240607123323-3v0lial","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：恶干姜、藜芦、白蔹、芫花。"}]},{"ID":"20240607123323-zk3xbi1","Type":"NodeParagraph","Properties":{"id":"20240607123323-zk3xbi1","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：畏萆薢。"}]},{"ID":"20240607123323-xwnonn1","Type":"NodeParagraph","Properties":{"id":"20240607123323-xwnonn1","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：诸病血虚痉急，头痛不因于风寒，溏泄不因于寒湿，二便秘涩，小儿脾虚发搐，慢惊慢脾风，气升作呕，火升发嗽，阴虚盗汗，阳虚自汗等病，法所同忌。"}]},{"ID":"20240607123323-rjvogoi","Type":"NodeParagraph","Properties":{"id":"20240607123323-rjvogoi","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"4.《得配本草》：元气虚，病不因风湿者禁用。"}]},{"ID":"20240607123323-puxvkzg","Type":"NodeParagraph","Properties":{"id":"20240607123323-puxvkzg","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123323-1w6g7vd","Type":"NodeParagraph","Properties":{"id":"20240607123323-1w6g7vd","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 祛风解表；胜湿止痛；解痉；止痒。主外感风寒；头痛身痛；风湿痹痛；骨节酸痛；腹痛泄泻；肠风下血；破伤风；风疹瘙痒；疮疡初起"}]},{"ID":"20240607123323-r7j5dus","Type":"NodeParagraph","Properties":{"id":"20240607123323-r7j5dus","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123323-eqmn2z9","Type":"NodeParagraph","Properties":{"id":"20240607123323-eqmn2z9","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g；或入丸、散。外用：适量，煎水熏洗。"}]},{"ID":"20240607123323-78rxyep","Type":"NodeParagraph","Properties":{"id":"20240607123323-78rxyep","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"一般生用，止泻炒用，止血炒炭用。"}]},{"ID":"20240607123323-92zbjve","Type":"NodeParagraph","Properties":{"id":"20240607123323-92zbjve","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123323-yz6zjp3","Type":"NodeParagraph","Properties":{"id":"20240607123323-yz6zjp3","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 1.2.九味羌活汤(《此事难知》)，发汗祛湿，兼清里热，主治外感风寒湿邪。3.玉屏风散(《丹溪心法》)，益气固表，主治表虚自汗，易感风邪。4.消风散(《外科正宗》)，疏风养血，清热除湿，主治风疹，湿疹。5.川芎茶调散(《太平惠民和剂局方》)，疏风止痛，主治外感风邪头痛。6.玉真散(《外科正宗》)，功效祛风化痰。"}]},{"ID":"20240607123323-5tbug7v","Type":"NodeParagraph","Properties":{"id":"20240607123323-5tbug7v","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607123323-wt46azd","Type":"NodeParagraph","Properties":{"id":"20240607123323-wt46azd","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主大风头眩痛，恶风，风邪，目盲无所见，风行周身，骨节疼痹，烦满。"}]},{"ID":"20240607123323-6m307fn","Type":"NodeParagraph","Properties":{"id":"20240607123323-6m307fn","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：杀附子毒。"}]},{"ID":"20240607123323-atlrn5k","Type":"NodeParagraph","Properties":{"id":"20240607123323-atlrn5k","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"3.《别录》：胁痛，胁风头面去来，四肢挛急，字乳金疮内痉。"}]},{"ID":"20240607123323-teqwpss","Type":"NodeParagraph","Properties":{"id":"20240607123323-teqwpss","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：治三十六般风，男子一切劳劣，补中益神，风赤眼，止泪及瘫缓，通利五脏关脉，五劳七伤，羸损盗汗，心烦体重，能安神定志，匀气脉。"}]},{"ID":"20240607123323-uiy2jyd","Type":"NodeParagraph","Properties":{"id":"20240607123323-uiy2jyd","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"5.《珍珠囊》：身：去上风，梢：去下风。"}]},{"ID":"20240607123323-8bxwn28","Type":"NodeParagraph","Properties":{"id":"20240607123323-8bxwn28","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"6.《药类法象》：治风通用。泻肺实，散头目中滞气，除上焦邪。"}]},{"ID":"20240607123323-xq1inuy","Type":"NodeParagraph","Properties":{"id":"20240607123323-xq1inuy","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"7.王好古：搜肝气。"}]},{"ID":"20240607123323-0jogvzy","Type":"NodeParagraph","Properties":{"id":"20240607123323-0jogvzy","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"8.《长沙药解》：行经络，逐湿淫，通关节，止疼痛，舒筋脉，伸急孪，活肢节，起瘫痪，敛自汗、盗汗，断漏下、崩中。"}]},{"ID":"20240607123323-qv97rxm","Type":"NodeParagraph","Properties":{"id":"20240607123323-qv97rxm","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"9.《本草求原》：解乌头、芫花、野菌诸热药毒。"}]},{"ID":"20240607123323-6km0z68","Type":"NodeParagraph","Properties":{"id":"20240607123323-6km0z68","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"10.《药对》：（防风）得葱白能行周身，得泽泻、藁本疗风，得当归、芍药、阳起石、禹余粮疗妇人子藏风。"}]},{"ID":"20240607123323-iuv57s5","Type":"NodeParagraph","Properties":{"id":"20240607123323-iuv57s5","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"11.李杲：防风，治一身尽痛，随所引而至，乃风药中润剂也。若补脾胃，非此引用不能行。凡脊痛项强，不可回顾。腰似折，项似拔者，乃手足太阳证，正当用防风。凡疮在胸膈以上，虽无手足太阳证亦当用之，为能散结去上部风。病人身体拘倦者风也，诸疮见此证，亦须用之。钱仲阳泻黄散中倍用防风者，乃于土中泻木也。防风能制黄芪，黄芪得防风其功愈大，乃相畏而相使也。"}]},{"ID":"20240607123323-sw5jotg","Type":"NodeParagraph","Properties":{"id":"20240607123323-sw5jotg","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"12.《本草经疏》：防风治风通用，升发而能散，故主大风头眩痛，恶风风邪，周身骨节疼痹，胁痛、胁风头面去来，四肢挛急，下乳，金疮因伤于风内痉。其云主目无所见者，因中风邪，故不见也。烦满者，因风邪客于胸中，故烦满也。风、寒、湿三者合而成痹，祛风燥湿，故主痹也。发散之药，焉可久服，其曰轻身，亦湿去耳。《别录》云，叉头者令人发狂，叉尾者发痼疾，子似胡荽而大，调食用之香而疗风更优也。"}]},{"ID":"20240607123323-x5c9f59","Type":"NodeParagraph","Properties":{"id":"20240607123323-x5c9f59","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"13.《本草汇言》：防风，散风寒湿痹之药也，故主诸风周身不遂，骨节酸痛，四肢挛急，痿躄癎痉等证。又伤寒初病太阳经，头痛发热，身痛无汗，或伤风咳嗽，鼻塞咽干，或痘？将出，根点未透，用防风辛温轻散，润泽不燥，能发邪从毛窍出，故外科痈疮肿毒、疮痍风癞诸证，亦必需也。为卒伍之职，随引而效，如无引经之药，亦不能独奏其功。故与芎、芷上行，治头目之风；与羌、独下行，治腰膝之风；与当归治血风；与白术治脾风；与苏、麻治寒风；与芥、连治热风；与荆、柏治肠风；与乳、桂治痛风，及大人中风、小儿惊风，防风尽能去之。若入大风厉风药中，须加杀虫活血药乃可。"}]},{"ID":"20240607123323-xr2ti5p","Type":"NodeParagraph","Properties":{"id":"20240607123323-xr2ti5p","updated":"20240607123427"},"Children":[{"Type":"NodeText","Data":"14.《本草正义》：防风，用此者用其气平散风，虽膀胱脾胃经药，然随诸经之药，各经皆至。气味俱轻，故散风邪治一身之痛，疗风眼。"}]},{"ID":"20240607123342-lrr3kdw","Type":"NodeParagraph","Properties":{"id":"20240607123342-lrr3kdw"},"Children":[{"Type":"NodeText","Data":"《本草正义》：防风，通治一切风邪，故《本经》以主大风三字为提纲。头痛恶风，及风邪而目盲无所见，其外感风邪之盛可知，风行周身，而骨节为之痛痹，亦风邪之深且重者，而防风皆治之，诚风药中之首屈一指者矣。《别录》主烦满胁痛，亦风淫于外而遏抑其清阳之气，不得宣布也。胁风二字，太不经见，而下文接以头面去来一句，则所谓风者，盖即指头面去来之风邪，胁字盖误，濒湖《纲目》引此无胁字，亦疑而删之也。四肢挛急，即《本经》风行周身、骨节疼痹之证。字乳者，产育乳子之时。金疮则破伤也。内痉二字，直接字乳金疮作一句读，即新产之中风及破伤风二证，皆有发痉一候，是血虚而内风煽动，非外来之风邪，故曰内痉，而防风亦能通治，颇似合外风内风而一以贯之。然古人以中风一证，无不从外来风邪治疗，是以产后发痉，角弓反张，《千金》、《外台》均用豆淋酒等方，纯以发表祛风为主。究竟产后痉厥、金创破伤二者，虽有猝为寒风所乘，宜于解表之一证，要知二者皆在血脱之后，阴不涵阳，肝风内煽，发为痉瘈，尤其多数，此则宜于潜阳息风，镇定为亟，万不可再用风药，助其暴戾。《别录》内痉二字，必非防风之辛温发散者所可妄试。防风为风病之主药，《本经》所主，皆风门重证，故首以大风一句表扬其功用，则驱除外风，兼能通痹起废，其效最弘，《本经》列于上品，正以其足当大任而推重之，非无故也。后人但以为感冒风寒，轻疏发散之用，未免视之太浅。防风为泄风之上剂，然以走窜宣散成功，必其人气血充足，体质坚实，猝为外邪所乘，乃能任此辛温宣泄，而无流弊。几古人治风诸方，皆不能轻用于今时东南之人者，以质脆阴薄，不能胜此燥烈之性也。防风虽不至如乌、附、姜、辛之刚烈，然温燥之气，扑人眉字，确是温辛一类，所以温热之风邪外受，凡柴、葛、羌、防皆当审慎，而肝阳之动风，血虚之风痉，又必柔润息风，方为正治，散风诸剂，非徒无益，而又害之。"}]},{"ID":"20240607123323-ewpaz7j","Type":"NodeParagraph","Properties":{"id":"20240607123323-ewpaz7j","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123323-682blx3","Type":"NodeParagraph","Properties":{"id":"20240607123323-682blx3","updated":"20240607123323"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607123324-z5xslgw","Type":"NodeThematicBreak","Properties":{"id":"20240607123324-z5xslgw"}},{"ID":"20240607123325-9ub3agb","Type":"NodeParagraph","Properties":{"id":"20240607123325-9ub3agb"}}]}