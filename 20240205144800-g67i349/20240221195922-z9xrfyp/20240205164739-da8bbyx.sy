seParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 600px;\" parent-style=\"width: 610px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240807190111-l9w46ms","Type":"NodeParagraph","Properties":{"id":"20240807190111-l9w46ms","updated":"20240807190115"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 779px;","style":"width: 769px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"北沙参"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/北沙参-20240807183109-rlgep0z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 769px;\" parent-style=\"width: 779px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 452px;","style":"width: 442px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"北沙参 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/北沙参 1-20240807183307-2zw4pv5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 442px;\" parent-style=\"width: 452px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620101454-eluqafb","Type":"NodeParagraph","Properties":{"id":"20240620101454-eluqafb"}},{"ID":"20240206081507-v8jpkaf","Type":"NodeParagraph","Properties":{"id":"20240206081507-v8jpkaf","updated":"20240206081518"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"南沙参"}]},{"ID":"20240206091155-lrcm87g","Type":"NodeParagraph","Properties":{"id":"20240206091155-lrcm87g","updated":"20240206091159"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产江苏、安徽、浙江、贵州等地。\n【性状】\t根呈圆锥形或圆柱形，略弯曲，长727cm，直径0.83cm。表面黄白色或淡棕黄色，凹陷处常有残留粗皮，上部多有深陷横纹，呈断续的环状，下部有纵纹及纵沟。顶端具1或2个根茎 (芦头) 。体轻、质脆易折断，断面不平坦，黄白色，多裂隙。无臭，味微甘。\n【性味】\t甘，微寒。\n【功效】\t养阴清肺，益胃生津，补气，化痰。补肺脾之气，适用于脾肺气虚，倦怠乏力，食少，自汗，舌淡，脉弱者。\n【炙品】\t蜜沙参：取南沙参片与炼蜜水拌匀吸尽，闷润，用文火炒至微黄并不粘手为度，取出放凉。每10公斤南沙参片，用炼蜜2.5公斤取适量开水稀释，滤过。\n【注解】\t“螺纹”指根基根茎类药材表面上螺旋形的环纹。\n“裂隙”指药材干燥后断面上形成的裂开部分，由射线细胞、薄壁细胞干枯皱缩而成。"}]},{"ID":"20240206091147-f9fhbkg","Type":"NodeParagraph","Properties":{"id":"20240206091147-f9fhbkg","updated":"20240206091147"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206091147-805ikyz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240206081512-9wr3g8f","Type":"NodeParagraph","Properties":{"id":"20240206081512-9wr3g8f","updated":"20240206081512"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 450px;","style":"width: 440px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南沙参"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南沙参-20240205165903-dwmgdwu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 440px;\" parent-style=\"width: 450px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620100657-p7q44zi","Type":"NodeParagraph","Properties":{"id":"20240620100657-p7q44zi","updated":"20240807193327"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 451px;","style":"width: 441px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620102045-se8utuu.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 441px;\" parent-style=\"width: 451px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807190622-sg592u4","Type":"NodeParagraph","Properties":{"id":"20240807190622-sg