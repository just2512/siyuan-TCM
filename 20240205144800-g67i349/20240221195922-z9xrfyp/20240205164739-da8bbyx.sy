},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南沙参 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南沙参 8-20240807192423-wxzl0sl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807190222-phpebsf","Type":"NodeParagraph","Properties":{"id":"20240807190222-phpebsf","updated":"20240807194021"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 783px;","style":"width: 773px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南沙参 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南沙参 10-20240807193258-y47ghir.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 773px;\" parent-style=\"width: 783px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 441px;","style":"width: 431px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"南沙参 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/南沙参 12-20240807194021-clarw9h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 431px;\" parent-style=\"width: 441px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807191029-br05ed6","Type":"NodeParagraph","Properties":{"id":"20240807191029-br05ed6","updated":"20240807191029"}},{"ID":"20240620101958-3rv8ebk","Type":"NodeParagraph","Properties":{"id":"20240620101958-3rv8ebk","updated":"20240807194034"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"南沙参、北沙参对比"}]},{"ID":"20240620102004-ejy3xtu","Type":"NodeParagraph","Properties":{"id":"20240620102004-ejy3xtu","updated":"20240620102004"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620102004-02adodg.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616172114-iljkuxe","Type":"NodeThematicBreak","Properties":{"id":"20240616172114-iljkuxe"}},{"ID":"20240616172502-a9rvn6l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172502-a9rvn6l","updated":"20240616172506"},"Children":[{"Type":"NodeText","Data":"沙参《神农本草经》"}]},{"ID":"20240616172502-z72i6ry","Type":"NodeParagraph","Properties":{"id":"20240616172502-z72i6ry","updated":"20240616172502"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240616172502-m3u42p8","Type":"NodeParagraph","Properties":{"id":"20240616172502-m3u42p8","updated":"20240616172502"},"Children":[{"Type":"NodeText","Data":"主血积惊气，除寒热，补中，益肺气。久服利人。一名知母。生川谷。"}]},{"ID":"20240616172502-irpxjnv","Type":"NodeParagraph","Properties":{"id":"20240616172502-irpxjnv","updated":"20240616172502"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：白沙参，一名苦心，一名识美，一名虎须，一名白参，一名志取，一名文虎，神农黄帝扁鹊无毒，岐伯咸，李氏大寒，生河内川谷，或般阳渎山，三月生如葵，叶青，实白如芥，根大白如芜菁，三月采（《御览》）。"}]},{"ID":"20240616172502-x96vfyu","Type":"NodeParagraph","Properties":{"id":"20240616172502-x96vfyu","updated":"20240616172502"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名苦心，一名志取，一名虎须，一名白参，一名识美，一名文希，生河内及冤句，般阳续山，二月八月采根，暴干。"}]},{"ID":"20240616172502-2gwit2r","Type":"NodeParagraph","Properties":{"id":"20240616172502-2gwit2r","updated":"20240616172502"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：苦心，沙参也，其蒿，青蓑也；《范子计然》云：白沙参，出洛阳，白者善。"}]},{"ID":"20240616172515-qo0yy18","Type":"NodeThematicBreak","Properties":{"id":"20240616172515-qo0yy18"}},{"ID":"20240616172516-1bis244","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172516-1bis244","updated":"20240616172520"},"Children":[{"Type":"NodeText","Data":"沙参《本草纲目》"}]},{"ID":"20240616172516-h75k2do","Type":"NodeParagraph","Properties":{"id":"20240616172516-h75k2do","updated":"20240616172516"},"Children":[{"Type":"NodeText","Data":"「释名」亦名白参、知母、羊乳、羊婆奶、铃儿草、虎须、苦心。"}]},{"ID":"20240616172516-jdf16cd","Type":"NodeParagraph","Properties":{"id":"20240616172516-jdf16cd","updated":"20240616172516"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、微寒、无毒。"}]},{"ID":"20240616172516-hl2qjjh","Type":"NodeParagraph","Properties":{"id":"20240616172516-hl2qjjh","updated":"20240616172516"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616172516-7aww3b4","Type":"NodeParagraph","Properties":{"id":"20240616172516-7aww3b4","updated":"20240616172516"},"Children":[{"Type":"NodeText","Data":"1、肺热咳嗽。用沙参半两，水煎服。"}]},{"ID":"20240616172516-l2k6l6j","Type":"NodeParagraph","Properties":{"id":"20240616172516-l2k6l6j","updated":"20240616172516"},"Children":[{"Type":"NodeText","Data":"2、突然发疝（小腹及阴中绞痛，自法出，几欲死）。用沙参研细，每服一茶匙，酒送下。"}]},{"ID":"20240616172516-02mzeim","Type":"NodeParagraph","Properties":{"id":"20240616172516-02mzeim","updated":"20240616172516"},"Children":[{"Type":"NodeText","Data":"3、妇女白带。用沙参研细，每服二钱，米汤送下。"}]},{"ID":"20240616172640-rbs8qio","Type":"NodeThematicBreak","Properties":{"id":"20240616172640-rbs8qio"}},{"ID":"20240616172642-2e064vt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172642-2e064vt","updated":"20240616172646"},"Children":[{"Type":"NodeText","Data":"沙参《千金翼方》"}]},{"ID":"20240616172642-p7blxhd","Type":"NodeParagraph","Properties":{"id":"20240616172642-p7blxhd","updated":"20240616172642"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主血积惊气，除寒热，补中，益肺气。疗胃痹，心腹痛，结气，头痛，皮间邪热，安五脏，补中。久服利人。一名知母，一名苦心，一名志取，一名虎须，一名白参，一名识美，一名文希。生河内川谷，及冤句般阳续山，二月八月采根，曝干"}]},{"ID":"20240616172528-gdoc9j0","Type":"NodeThematicBreak","Properties":{"id":"20240616172528-gdoc9j0"}},{"ID":"20240616172530-81pw2y3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172530-81pw2y3","updated":"20240616172534"},"Children":[{"Type":"NodeText","Data":"沙参《证类本草》"}]},{"ID":"20240616172530-yxnju7l","Type":"NodeParagraph","Properties":{"id":"20240616172530-yxnju7l","updated":"20240616172530"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主血积惊气，除寒热，补中，益肺气，疗胃痹心腹痛，结热邪气，头痛，皮间邪热，安五脏，补中。久服利人。一名知母，一名苦心，一名志取，一名虎须，一名白参，一名识美，一名文希。生河内川谷及冤句、般阳续山，二月、八月采根，曝干。（恶防己，反藜芦。）"}]},{"ID":"20240616172530-shred36","Type":"NodeParagraph","Properties":{"id":"20240616172530-shred36","updated":"20240616172530"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出近道。丛生，叶似枸杞，根白实者佳。此沙参并人参是为五参，其形不尽相类，而主疗颇同，故皆有参名。又有紫参，正名牡蒙，在中品。唐本注云∶紫参、牡蒙，各是一物，非异名也。今沙参出华州为善。臣禹锡等谨按蜀本图经云∶花白色，根若葵根。"}]},{"ID":"20240616172530-kqp2thx","Type":"NodeParagraph","Properties":{"id":"20240616172530-kqp2thx","updated":"20240616172530"},"Children":[{"Type":"NodeText","Data":"药性论云∶沙参，臣。能去皮肌浮风，疝气下坠，治常欲眠，养肝气，宣五脏风气。日华子云∶补虚，止惊烦，益心肺，并一切恶疮疥癣及身痒，排脓，消肿毒。"}]},{"ID":"20240616172530-a9c027x","Type":"NodeParagraph","Properties":{"id":"20240616172530-a9c027x","updated":"20240616172530"},"Children":[{"Type":"NodeText","Data":"图经曰∶沙参，生河内川谷及冤句、般阳续山，今出淄、齐、潞、随州，而江、淮、荆、湖州郡或有之。苗长一、二尺以来，丛生崖壁间，叶似枸杞而有叉牙。七月开紫花，根如葵根，箸许大，赤黄色，中正白实者佳。二月、八月采根，曝干。南土生者，叶有细有大，花白，瓣上仍有白粘胶，此为小异。古方亦单用。葛洪卒得诸疝，小腹及阴中相引痛如绞，自汗出欲死者。捣筛末，酒服方寸匕，立瘥。"}]},{"ID":"20240616172114-xrol8q0","Type":"NodeThematicBreak","Properties":{"id":"20240616172114-xrol8q0"}},{"ID":"20240616172053-vijtguq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172053-vijtguq","updated":"20240616172058"},"Children":[{"Type":"NodeText","Data":"沙参《增广和剂局方药性总论》"}]},{"ID":"20240616172053-hx727e7","Type":"NodeParagraph","Properties":{"id":"20240616172053-hx727e7","updated":"20240616172053"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主血积惊气，除寒热，补中，益肺气，疗胃痹心腹痛，结热邪头痛及皮间邪热。《药性论》云∶臣。能去皮肌浮风，疝气下坠，治常欲眠，养肝气，脏风气。日华子云∶补虚，止惊烦，益心肺，一切恶疮疥癣及身痒，排脓，消肿毒。"}]},{"ID":"20240616172028-xutm2su","Type":"NodeThematicBreak","Properties":{"id":"20240616172028-xutm2su"}},{"ID":"20240616172043-joghbf2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172043-joghbf2","updated":"20240616172048"},"Children":[{"Type":"NodeText","Data":"沙参《新修本草》"}]},{"ID":"20240616172043-uha0ypd","Type":"NodeParagraph","Properties":{"id":"20240616172043-uha0ypd","updated":"20240616172043"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主血积惊气，除寒热，补中，益肺气。疗胃痹心腹痛，结热邪气，头痛，皮间邪热，安五脏，补中。久服利人。一名知母，一名苦心，一名志取，一名虎须，一文希。生河内川谷及宛朐般阳续山。二月、八月采根，曝干。"}]},{"ID":"20240616172043-9rh8z3x","Type":"NodeParagraph","Properties":{"id":"20240616172043-9rh8z3x","updated":"20240616172043"},"Children":[{"Type":"NodeText","Data":"恶防己，反藜芦。今出近道，丛生，叶似枸杞，根白实者佳。此沙参并人参、玄参、丹参、苦参是为五参，其形不尽相类，而主疗颇同，故皆有参名。又有紫参，正名牡蒙，在中品。"}]},{"ID":"20240616172043-lmgq8wz","Type":"NodeParagraph","Properties":{"id":"20240616172043-lmgq8wz","updated":"20240616172043"},"Children":[{"Type":"NodeText","Data":"〔谨案〕紫参、牡蒙各是一物，非异名也。今沙参出华州为善。"}]},{"ID":"20240616172028-5ox1rcg","Type":"NodeThematicBreak","Properties":{"id":"20240616172028-5ox1rcg"}},{"ID":"20240616172029-a75rqle","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172029-a75rqle","updated":"20240616172034"},"Children":[{"Type":"NodeText","Data":"沙参《本草乘雅半偈》"}]},{"ID":"20240616172029-xbdqj8w","Type":"NodeParagraph","Properties":{"id":"20240616172029-xbdqj8w","updated":"20240616172029"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240616172029-exlu7yr","Type":"NodeParagraph","Properties":{"id":"20240616172029-exlu7yr","updated":"20240616172029"},"Children":[{"Type":"NodeText","Data":"【气味】苦，微寒，无毒。"}]},{"ID":"20240616172029-qcf50is","Type":"NodeParagraph","Properties":{"id":"20240616172029-qcf50is","updated":"20240616172029"},"Children":[{"Type":"NodeText","Data":"【主治】主血结，惊气，除寒热，补中，益肺气。"}]},{"ID":"20240616172029-1a1axw3","Type":"NodeParagraph","Properties":{"id":"20240616172029-1a1axw3","updated":"20240616172029"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出淄、齐、潞、随、江、淮、荆、湖州郡沙碛中。二月生苗，初生如小葵叶，圆扁不光。八、九月抽茎，茎端叶尖长，如枸杞，边有细齿。叶间开小花五出，色紫，长如铃铎，结实如冬青，实中有细子。霜后苗枯，根长尺许，若黄土地中者，根则短小。根茎俱有白汁如乳，故一名羊乳、羊婆奶。根干时，宛似人参，中黄外白，世所用者皆伪，不知为何许物，食之反损肺气。恶防己，反藜芦。"}]},{"ID":"20240616172029-6fo1l0s","Type":"NodeParagraph","Properties":{"id":"20240616172029-6fo1l0s","updated":"20240616172029"},"Children":[{"Type":"NodeText","Data":"先人云∶色白而乳，肺金之津液药也。故又得知母志取苦心之名。"}]},{"ID":"20240616172029-jc20cq8","Type":"NodeParagraph","Properties":{"id":"20240616172029-jc20cq8","updated":"20240616172029"},"Children":[{"Type":"NodeText","Data":"【 】曰∶乐树沙碛而气疏，质本秋成而性洁。参容平之金令，转炎敲为清肃者也。故可汰除肺眚，因热伤气分，为洒淅寒热，及藏真失行营卫阴阳，致气不 ，血不濡，与惊气上逆，不能 之使下者，功用颇捷。"}]},{"ID":"20240616171945-zm665c2","Type":"NodeThematicBreak","Properties":{"id":"20240616171945-zm665c2"}},{"ID":"20240616172018-l2hkfow","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172018-l2hkfow","updated":"20240616172024"},"Children":[{"Type":"NodeText","Data":"沙参《本草崇原》"}]},{"ID":"20240616172018-dtfdyzk","Type":"NodeParagraph","Properties":{"id":"20240616172018-dtfdyzk","updated":"20240616172018"},"Children":[{"Type":"NodeText","Data":"气味苦，微寒，无毒。主血结惊风，除寒热，补中，益肺气。《别录》云∶久服利人。"}]},{"ID":"20240616172018-wepuley","Type":"NodeParagraph","Properties":{"id":"20240616172018-wepuley","updated":"20240616172018"},"Children":[{"Type":"NodeText","Data":"（沙参一名白参，以其根色名也。又名羊乳。俚人呼为羊婆奶，以其根茎折之皆有白汁也。始出河内川谷及冤句、般阳，今淄齐，潞随，江淮，荆湖州郡，及处处山原有之。喜生近水沙地中。）"}]},{"ID":"20240616172018-4odawhb","Type":"NodeParagraph","Properties":{"id":"20240616172018-4odawhb","updated":"20240616172018"},"Children":[{"Type":"NodeText","Data":"沙参生于近水之沙地，其性全寒，苦中带甘，故曰微寒，色白多汁，禀金水之精气。血结惊气者，荣气内虚，故血结而惊气也。寒热者，卫气外虚，故肌表不和而寒热也。补中者，补中焦之精汁。补中则血结惊气可治矣。益肺者，益肺气于皮毛，益肺则寒热可除矣。所以然者，禀水精而补中，禀金精而益肺也。久服则血气调而荣卫和，故利人。"}]},{"ID":"20240616172018-ocz5usi","Type":"NodeParagraph","Properties":{"id":"20240616172018-ocz5usi","updated":"20240616172018"},"Children":[{"Type":"NodeText","Data":"愚按∶《本经》人参味甘，沙参味苦，性皆微寒。后人改人参微温，沙参味甘，不知人参味甘，甘中稍苦，故曰微寒。沙参全寒，苦中带甘，故曰微寒。先圣立言自有深意，后人不思体会而审察之，擅改圣经，误人最甚。"}]},{"ID":"20240616171946-i8no23f","Type":"NodeThematicBreak","Properties":{"id":"20240616171946-i8no23f"}},{"ID":"20240616172008-3c3ny9x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172008-3c3ny9x","updated":"20240616172012"},"Children":[{"Type":"NodeText","Data":"沙参《冯氏锦囊秘录》"}]},{"ID":"20240616172008-nbpq10p","Type":"NodeParagraph","Properties":{"id":"20240616172008-nbpq10p","updated":"20240616172008"},"Children":[{"Type":"NodeText","Data":"禀天地清和之气，味苦、甘，微寒，无毒。放散结除热则有之，补中益气则不及也。"}]},{"ID":"20240616172008-bf71d8s","Type":"NodeParagraph","Properties":{"id":"20240616172008-bf71d8s","updated":"20240616172008"},"Children":[{"Type":"NodeText","Data":"沙参，味淡体轻，专补脾气而益脾与肾，久咳肺痿，金受火克者宜之。寒客肺中作嗽者勿服。主寒热咳嗽胸痹头痛，定心内惊烦，退皮间邪热，易老服代人参，盖取味之苦甘，泻中兼补略相类耳。"}]},{"ID":"20240616172008-qa5zh3o","Type":"NodeParagraph","Properties":{"id":"20240616172008-qa5zh3o","updated":"20240616172008"},"Children":[{"Type":"NodeText","Data":"按∶沙参气轻力薄，非肩弘任大之品也。人参甘温体重，专益肺气补血而生阴；沙参甘寒，体轻专清肺热，补阴而制阳，一行春气，一行秋气，不相侔也。故脏腑无实热，及寒客肺经，而嗽者勿服。"}]},{"ID":"20240616171946-vcm7ngi","Type":"NodeThematicBreak","Properties":{"id":"20240616171946-vcm7ngi"}},{"ID":"20240616171957-x7ctgll","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171957-x7ctgll","updated":"20240616172003"},"Children":[{"Type":"NodeText","Data":"沙参《本草求真》"}]},{"ID":"20240616171957-u9ckh9b","Type":"NodeParagraph","Properties":{"id":"20240616171957-u9ckh9b","updated":"20240616171957"},"Children":[{"Type":"NodeText","Data":"（山草）肺火熏蒸"}]},{"ID":"20240616171957-n35va9o","Type":"NodeParagraph","Properties":{"id":"20240616171957-n35va9o","updated":"20240616171957"},"Children":[{"Type":"NodeText","Data":"沙参（专入肺）。甘苦而淡。性寒体轻。故能入肺以泄热。及泻肺火。凡久嗽肺萎。金受火克者。服此最宜。盖以热气熏蒸。非用甘苦轻淡。不能以制焚烁之势。故嗽必借此止。若寒客肺中作嗽。切勿妄用。以嗽既属寒成。复以寒药为治。不更使寒益甚乎？至书有言补肺养肝。及益脾肾。皆是从肺子母受累推究而出。服此肺不受刑。子母皆安。即肝亦不受累。诸脏并见安和耳。非真能以补阴也。（热在于肺宜用。肺热清而阴不受累。故书言人参补五脏之阳。沙参补五脏之阴。）凡书所载药性补泻。类多如斯。不独沙参为然。似人参而体轻松白实者良。生沙地长大。生黄土者瘦小。恶防己。反藜芦。"}]},{"ID":"20240616171946-h9wihi1","Type":"NodeThematicBreak","Properties":{"id":"20240616171946-h9wihi1"}},{"ID":"20240616171947-gsj0ng4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171947-gsj0ng4","updated":"20240616171952"},"Children":[{"Type":"NodeText","Data":"沙参《神农本草经读》"}]},{"ID":"20240616171947-7kqkpvz","Type":"NodeParagraph","Properties":{"id":"20240616171947-7kqkpvz","updated":"20240616171947"},"Children":[{"Type":"NodeText","Data":"气味苦、微寒，无毒。主血结，惊气，除寒热，补中，益肺气。"}]},{"ID":"20240616171947-ox4dtx8","Type":"NodeParagraph","Properties":{"id":"20240616171947-ox4dtx8","updated":"20240616171947"},"Children":[{"Type":"NodeText","Data":"（参叶天士）沙参气微寒，禀水气而入肾；味苦无毒，得火味而入心。谓其得水气，以泻心火之有余也。心火亢，则所主之血不行而为结，而味之苦可以攻之；心火亢，则所藏之神不宁而生惊，而气之寒可以平之。心火禀炎上之性，火郁则寒，火发则热，而苦寒能清心火，故能除寒热也。阴者，所以守中者也，苦寒益阴，所以补中；补中则金得土生，又无火克，所以益肺气也。"}]},{"ID":"20240616172319-cg63qyf","Type":"NodeThematicBreak","Properties":{"id":"20240616172319-cg63qyf"}},{"ID":"20240616172320-nffngg9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172320-nffngg9","updated":"20240616172324"},"Children":[{"Type":"NodeText","Data":"沙参《神农本草经赞》"}]},{"ID":"20240616172320-moomaoh","Type":"NodeParagraph","Properties":{"id":"20240616172320-moomaoh","updated":"20240616172320"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主血积惊气。除寒热。补中益肺气。久服利人。一名知母。生川谷。"}]},{"ID":"20240616172320-e065zy2","Type":"NodeParagraph","Properties":{"id":"20240616172320-e065zy2","updated":"20240616172320"},"Children":[{"Type":"NodeText","Data":"文希志取。美识参形。尖长排齿。紫白悬铃。乳流液。肺沃神醒。孕金伏火。风扇泠泠。"}]},{"ID":"20240616172320-o21560u","Type":"NodeParagraph","Properties":{"id":"20240616172320-o21560u","updated":"20240616172320"},"Children":[{"Type":"NodeText","Data":"名医曰。一名文希。一名志取。一名识美。陶弘景曰。与人参主疗颇同。故有参名。李时珍曰。叶尖长如枸杞叶而小。有细齿。开小紫花。状如铃铎。亦有白花者。根茎皆有白汁。俗名羊婆奶。束晰赋。液濡泽。李咸用歌。风摇两拂精神醒。牛宏歌。孕金成德。李颀诗。"}]},{"ID":"20240616172320-1bbbatt","Type":"NodeParagraph","Properties":{"id":"20240616172320-1bbbatt","updated":"20240616172320"},"Children":[{"Type":"NodeText","Data":"心穷伏火阳精丹。葛洪诗。洞阳泠泠风佩清。"}]},{"ID":"20240616172344-1h8xmo1","Type":"NodeThematicBreak","Properties":{"id":"20240616172344-1h8xmo1"}},{"ID":"20240616172345-gq34fou","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172345-gq34fou","updated":"20240616172351"},"Children":[{"Type":"NodeText","Data":"沙参《本草便读》"}]},{"ID":"20240616172345-dlsn3rp","Type":"NodeParagraph","Properties":{"id":"20240616172345-dlsn3rp","updated":"20240616172345"},"Children":[{"Type":"NodeText","Data":"补肺阴之不足．甘苦微寒．降金令之有余．整肃上热．疏痰利咳．南参力薄形松．体润质坚．北者功优性滑．（沙参处处山原沙地皆有之．古无南北之分．然观各家本草云．其色白．其根多汁等语．似指北参而言．若南参则质粗大而松．气薄味淡．大抵甘寒入肺．清养之功．北逊于南．其润降之性．南不及北耳．南北之分．亦各随地土之所出．故大小不同．质坚质松有异也．）"}]},{"ID":"20240616172449-h14ajsm","Type":"NodeThematicBreak","Properties":{"id":"20240616172449-h14ajsm"}},{"ID":"20240616172450-8560cy4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172450-8560cy4","updated":"20240616172454"},"Children":[{"Type":"NodeText","Data":"沙参《医学入门》"}]},{"ID":"20240616172450-atwttxq","Type":"NodeParagraph","Properties":{"id":"20240616172450-atwttxq","updated":"20240616172450"},"Children":[{"Type":"NodeText","Data":"沙参性寒甘苦味，能除表热与胃痹，卒疝恶疮身浮痒，散血积兮补阴气。"}]},{"ID":"20240616172450-y02xfn0","Type":"NodeParagraph","Properties":{"id":"20240616172450-y02xfn0","updated":"20240616172450"},"Children":[{"Type":"NodeText","Data":"生砂地，叶似枸杞，根如葵，筋大外赤黄内白，一名白参，出华州者良。无毒。主肌表间热，头痛寒热，胃痹心腹痛结热，卒得疝气下坠绞痛，一切恶疮疥癣，浮风身痒，散血分积，养肝之功居多，常欲眠而多惊烦者最宜，故曰厥阴本药也。兼泻肺热，能补五脏之阴，亦随各脏引至。易老常以此代人参，取其甘也。米泔浸晒。恶防己，反藜芦。"}]},{"ID":"20240616172435-8q6og5f","Type":"NodeThematicBreak","Properties":{"id":"20240616172435-8q6og5f"}},{"ID":"20240616172436-5gc3y7z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172436-5gc3y7z","updated":"20240616172443"},"Children":[{"Type":"NodeText","Data":"沙参《本草备要》"}]},{"ID":"20240616172436-ouu0gco","Type":"NodeParagraph","Properties":{"id":"20240616172436-ouu0gco","updated":"20240616172436"},"Children":[{"Type":"NodeText","Data":"补阴，泻肺火"}]},{"ID":"20240616172436-c0a11ug","Type":"NodeParagraph","Properties":{"id":"20240616172436-c0a11ug","updated":"20240616172436"},"Children":[{"Type":"NodeText","Data":"甘苦微寒。味淡体轻，专补肺气，清肺养肝，兼益脾肾（脾为肺母，肾为肺子）。久嗽肺痿，金受火克者宜之，寒客肺中作嗽者勿服（人参补五脏之阳，沙参补五脏之阴，肺热者用之，以代人参）。"}]},{"ID":"20240616172436-oqc7io0","Type":"NodeParagraph","Properties":{"id":"20240616172436-oqc7io0","updated":"20240616172436"},"Children":[{"Type":"NodeText","Data":"似人参而体轻松，白实者良，生沙地者长大，生黄土者瘦小。畏防己。反黎芦（北地真者难得。郑奠一曰∶能疗胸痹、心腹痛、邪热结，去皮肤游风、疥癣、恶疮、疝气、崩带）"}]},{"ID":"20240616172425-iy0edl0","Type":"NodeThematicBreak","Properties":{"id":"20240616172425-iy0edl0"}},{"ID":"20240616172426-8yoaab1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172426-8yoaab1","updated":"20240616172430"},"Children":[{"Type":"NodeText","Data":"沙参《本草经解》"}]},{"ID":"20240616172426-20jsok0","Type":"NodeParagraph","Properties":{"id":"20240616172426-20jsok0","updated":"20240616172426"},"Children":[{"Type":"NodeText","Data":"气微寒．味苦．无毒．主血结惊气．除寒热．补中益肺气．沙参气微寒．禀天初冬之水气．入足少阴肾经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．心主血而藏神．神不宁则血结而易惊矣．结者散之．惊者平之．沙参味苦能散．气寒能平也．心火禀炎上之性．火郁则寒．火发则热．苦寒之味能清心火．故除寒热．阴者所以守中者也．气寒益阴．所以补中．肺为金藏．其性畏火．沙参入心．苦寒清火．所以益肺气也．"}]},{"ID":"20240616172426-ecv7718","Type":"NodeParagraph","Properties":{"id":"20240616172426-ecv7718","updated":"20240616172426"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616172426-ybdqqfn","Type":"NodeParagraph","Properties":{"id":"20240616172426-ybdqqfn","updated":"20240616172426"},"Children":[{"Type":"NodeText","Data":"沙参一味．治肺热咳嗽．为末．酒服方寸匕．治卒疝．少腹及阴中相引绞痛．自汗出欲死者．用米饮下二钱．治白带．"}]},{"ID":"20240616172406-jj1i775","Type":"NodeThematicBreak","Properties":{"id":"20240616172406-jj1i775"}},{"ID":"20240616172408-qv4cnvj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172408-qv4cnvj","updated":"20240616172412"},"Children":[{"Type":"NodeText","Data":"沙参《神农本草经百种录》"}]},{"ID":"20240616172408-i9v9uz5","Type":"NodeParagraph","Properties":{"id":"20240616172408-i9v9uz5","updated":"20240616172408"},"Children":[{"Type":"NodeText","Data":"味苦，微寒。主血积，肺气上逆之血。惊气，心火犯肺。除寒热，肺家失调之寒热。"}]},{"ID":"20240616172408-0lj22y4","Type":"NodeParagraph","Properties":{"id":"20240616172408-0lj22y4","updated":"20240616172408"},"Children":[{"Type":"NodeText","Data":"补中，肺主气，肺气和则气充而三焦实也。益肺气。色白体轻故入肺也。久服利人。肺气清和之效。"}]},{"ID":"20240616172408-f5rj0vv","Type":"NodeParagraph","Properties":{"id":"20240616172408-f5rj0vv","updated":"20240616172408"},"Children":[{"Type":"NodeText","Data":"肺主气，故肺家之药气胜者为多。但气胜之品必偏于燥，而能滋肺者，又腻滞而不清虚，惟沙参为肺家气分中理血之药，色白体轻，疏通而不燥，润泽而不滞，血阻于肺者，非此不能清也。"}]},{"ID":"20240616172355-5qubdqt","Type":"NodeThematicBreak","Properties":{"id":"20240616172355-5qubdqt"}},{"ID":"20240616172356-sjkspez","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172356-sjkspez","updated":"20240616172401"},"Children":[{"Type":"NodeText","Data":"沙参《玉楸药解》"}]},{"ID":"20240616172356-r15pysv","Type":"NodeParagraph","Properties":{"id":"20240616172356-r15pysv","updated":"20240616172356"},"Children":[{"Type":"NodeText","Data":"味甘，稍苦，微凉，入手太阴肺经。清金除烦，润燥生津。"}]},{"ID":"20240616172356-1mjz7pu","Type":"NodeParagraph","Properties":{"id":"20240616172356-1mjz7pu","updated":"20240616172356"},"Children":[{"Type":"NodeText","Data":"沙参凉肃冲淡，补肺中清气，退头上郁火，而无寒中败土之弊。但情性轻缓，宜多用乃效。"}]},{"ID":"20240616172356-cq6qf7r","Type":"NodeParagraph","Properties":{"id":"20240616172356-cq6qf7r","updated":"20240616172356"},"Children":[{"Type":"NodeText","Data":"山东、辽东者佳，坚脆洁白，迥异他产，一切疮疡疥癣、肿痛瘙痒皆效。"}]},{"ID":"20240616172331-7qu6ac1","Type":"NodeThematicBreak","Properties":{"id":"20240616172331-7qu6ac1"}},{"ID":"20240616172332-59rdd68","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172332-59rdd68","updated":"20240616172336"},"Children":[{"Type":"NodeText","Data":"沙参《本经逢原》"}]},{"ID":"20240616172332-zjupe35","Type":"NodeParagraph","Properties":{"id":"20240616172332-zjupe35","updated":"20240616172332"},"Children":[{"Type":"NodeText","Data":"甘淡微寒，无毒。有南北二种，北者质坚、性寒，南者体虚力微。反藜芦。"}]},{"ID":"20240616172332-h2bxef2","Type":"NodeParagraph","Properties":{"id":"20240616172332-h2bxef2","updated":"20240616172332"},"Children":[{"Type":"NodeText","Data":"《本经》主血结，惊气，除寒热，补中益肺气。"}]},{"ID":"20240616172332-vs54hwf","Type":"NodeParagraph","Properties":{"id":"20240616172332-vs54hwf","updated":"20240616172332"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"沙参专泄肺气之热，故喘嗽气壅，小便赤涩不利，金受火克。阴虚失血，或喘咳寒热及肺痿等疾宜之。《本经》主血结惊气者，因惊气入心，心包热郁而血结也。除寒热者，郁热解而寒热除也。补中益肺气者，用以清理脾胃之虚热，则津液复而正气受益矣。洁古言，肺寒用人参，肺热用沙参。好古言，沙参性寒，补五脏之阴，总未达轻虚泄热之义也。"}]},{"ID":"20240616172332-xk7hae0","Type":"NodeParagraph","Properties":{"id":"20240616172332-xk7hae0","updated":"20240616172332"},"Children":[{"Type":"NodeText","Data":"《卫生方》治肺热咳嗽，沙参一味，水煎服之。《肘后方》治卒然疝痛，自汗欲死，沙参为末，酒服立瘥。《证治要诀》治妇人白带，沙参为末，米饮服之。盖沙参专开肺气，肺气清则木邪散，而疝自除，带自愈矣。时珍云∶人参甘苦而温，其体重实，专补脾胃元气，因而益肺与肾，故内伤元气者宜之。沙参甘淡而寒，其体轻虚，专清肺气，因而益肺与肾，故金受火克者宜之。此即《本经》补中益肺气之谓，一补阳而生阴，一补阴而制阳。不可不辨。"}]},{"ID":"20240616172257-7jijb7k","Type":"NodeThematicBreak","Properties":{"id":"20240616172257-7jijb7k"}},{"ID":"20240616172258-y0vn2mp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172258-y0vn2mp","updated":"20240616172302"},"Children":[{"Type":"NodeText","Data":"沙参《本草简要方》"}]},{"ID":"20240616172258-gsmksdx","Type":"NodeParagraph","Properties":{"id":"20240616172258-gsmksdx","updated":"20240616172258"},"Children":[{"Type":"NodeText","Data":"产北地者良。南方者力薄。故有南北之分。"}]},{"ID":"20240616172258-45iw4et","Type":"NodeParagraph","Properties":{"id":"20240616172258-45iw4et","updated":"20240616172258"},"Children":[{"Type":"NodeText","Data":"主治。泻肺火。清肺热。补中益气。妇人白带。"}]},{"ID":"20240616172258-bsib1jt","Type":"NodeParagraph","Properties":{"id":"20240616172258-bsib1jt","updated":"20240616172258"},"Children":[{"Type":"NodeText","Data":"沙参麦冬汤。沙参麦冬各三钱。玉竹二钱。生草一钱。冬桑叶生扁豆天花粉各一钱半。"}]},{"ID":"20240616172258-td16ih1","Type":"NodeParagraph","Properties":{"id":"20240616172258-td16ih1","updated":"20240616172258"},"Children":[{"Type":"NodeText","Data":"水五杯煮取二杯。日再服。治燥伤肺胃阴分。或热或咳。久热久咳者加地骨皮三钱。"}]},{"ID":"20240616172307-kfanu60","Type":"NodeThematicBreak","Properties":{"id":"20240616172307-kfanu60"}},{"ID":"20240616172308-1923rk0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172308-1923rk0","updated":"20240616172313"},"Children":[{"Type":"NodeText","Data":"沙参《要药分剂》"}]},{"ID":"20240616172308-vvdfpy7","Type":"NodeParagraph","Properties":{"id":"20240616172308-vvdfpy7","updated":"20240616172308"},"Children":[{"Type":"NodeText","Data":"味甘苦。性微寒。无毒。禀天地清利之气而生。降多于升。阴也。反藜芦。恶防己、一名白参。"}]},{"ID":"20240616172308-m1adnz5","Type":"NodeParagraph","Properties":{"id":"20240616172308-m1adnz5","updated":"20240616172308"},"Children":[{"Type":"NodeText","Data":"【主治】主专益肺气。补中。血结。惊气。除寒热。（本经）疗胸痹心腹痛。结热。邪气头痛养肝【归经】入肺经。兼入脾肾二经。为补阴泻火之品。（兼泻剂）【前论】元素曰。肺寒者用人参。肺热者用沙参。李言闻曰。人参甘苦温。其体重实。"}]},{"ID":"20240616172308-jc3z8dk","Type":"NodeParagraph","Properties":{"id":"20240616172308-jc3z8dk","updated":"20240616172308"},"Children":[{"Type":"NodeText","Data":"专补因而【禁忌】经疏曰。脏腑无实热。肺虚寒客作嗽者。均忌。"}]},{"ID":"20240616172557-ra3dlzv","Type":"NodeThematicBreak","Properties":{"id":"20240616172557-ra3dlzv"}},{"ID":"20240616172559-x9lt33o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172559-x9lt33o","updated":"20240616172604"},"Children":[{"Type":"NodeText","Data":"沙参《本草经集注》"}]},{"ID":"20240616172559-rxhday6","Type":"NodeParagraph","Properties":{"id":"20240616172559-rxhday6","updated":"20240616172559"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主治血积，惊气，除寒热，补中，益肺气。治胃痹，心腹痛，结热邪气，头痛，皮间邪热，安五脏，补中。久服利人。一名知母，一名苦心，一名志取，一名虎须，一名白参，一名识美，一名文希。生河内川谷及宛朐般阳续山。二月、八月采根，曝干。（恶防己，反藜芦。）"}]},{"ID":"20240616172559-b2s2s3r","Type":"NodeParagraph","Properties":{"id":"20240616172559-b2s2s3r","updated":"20240616172559"},"Children":[{"Type":"NodeText","Data":"今出近道，丛生，叶似枸杞，根白实者佳。此沙参并人参、玄参、丹参、苦参是为五参，其形不尽相类，而主治颇同，故皆有参名。又有紫参，正名牡蒙，在中品。"}]},{"ID":"20240616172244-tg1ioor","Type":"NodeThematicBreak","Properties":{"id":"20240616172244-tg1ioor"}},{"ID":"20240616172245-hm5f3o3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172245-hm5f3o3","updated":"20240616172250"},"Children":[{"Type":"NodeText","Data":"沙参《中药炮制》"}]},{"ID":"20240616172245-t22s8hf","Type":"NodeParagraph","Properties":{"id":"20240616172245-t22s8hf","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『来源』本品为桔梗科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"轮叶沙参"},{"Type":"NodeText","Data":"的干燥根。"}]},{"ID":"20240616172245-2sg821r","Type":"NodeParagraph","Properties":{"id":"20240616172245-2sg821r","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『常用名』南沙参。"}]},{"ID":"20240616172245-ztv2slc","Type":"NodeParagraph","Properties":{"id":"20240616172245-ztv2slc","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『产地』湖北、安徽、江苏、浙江、河南。"}]},{"ID":"20240616172245-cdu4bcv","Type":"NodeParagraph","Properties":{"id":"20240616172245-cdu4bcv","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『采收季节』秋季采挖。"}]},{"ID":"20240616172245-iog1dd8","Type":"NodeParagraph","Properties":{"id":"20240616172245-iog1dd8","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『炮制方法』去杂质，冬春季用温水抢洗，夏秋季用冷水抢洗，捞入筐内，上盖湿布，次日取出，切横片1分厚。如鲜品，当时刮去表皮，用冷水抢洗，捞起滤干水分，切横片1分厚晒干。"}]},{"ID":"20240616172245-ahn365q","Type":"NodeParagraph","Properties":{"id":"20240616172245-ahn365q","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『用量』9～18克。"}]},{"ID":"20240616172245-izc91l2","Type":"NodeParagraph","Properties":{"id":"20240616172245-izc91l2","updated":"20240616172245"},"Children":[{"Type":"NodeText","Data":"『贮存』装缸内或箱内加盖，防潮及虫蛀。"}]},{"ID":"20240616172143-7j36s72","Type":"NodeThematicBreak","Properties":{"id":"20240616172143-7j36s72"}},{"ID":"20240616172144-fmlmxo3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172144-fmlmxo3","updated":"20240616172237"},"Children":[{"Type":"NodeText","Data":"北沙参《本草从新》"}]},{"ID":"20240616172144-4471lhx","Type":"NodeParagraph","Properties":{"id":"20240616172144-4471lhx","updated":"20240616172144"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补阴、清肺火．"}]},{"ID":"20240616172144-14e42k9","Type":"NodeParagraph","Properties":{"id":"20240616172144-14e42k9","updated":"20240616172144"},"Children":[{"Type":"NodeText","Data":"甘苦微寒．味淡体轻．专补肺阴．清肺火．治久咳肺痿．金受火刑者宜之．寒客肺中作嗽者勿服．（人参补五脏之阳、沙参补五脏之阴、肺热者用之．）白实长大者良．恶防己．反藜芦．（肺热咳嗽者、用沙参半两、水煎服之、甚效．）"}]},{"ID":"20240616172144-6qmolqx","Type":"NodeParagraph","Properties":{"id":"20240616172144-6qmolqx","updated":"20240616172144"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"南沙参"},{"Type":"NodeText","Data":"（补阴、清肺火．）功同北参，而力稍逊．色稍黄．形稍瘦小而短．近有一种味带辣者．不可用．（产亳州．）"}]},{"ID":"20240616172547-tmov03l","Type":"NodeThematicBreak","Properties":{"id":"20240616172547-tmov03l"}},{"ID":"20240616172548-znwv4dj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172548-znwv4dj","updated":"20240616172548"},"Children":[{"Type":"NodeText","Data":"北沙参《本草分经》"}]},{"ID":"20240616172548-jiys0a9","Type":"NodeParagraph","Properties":{"id":"20240616172548-jiys0a9","updated":"20240616172548"},"Children":[{"Type":"NodeText","Data":"甘苦微寒，专补肺阴清肺火，金受火刑者宜之。南沙参功同，而力稍逊。"}]},{"ID":"20240616172548-6qr7k8d","Type":"NodeThematicBreak","Properties":{"id":"20240616172548-6qr7k8d","updated":"20240616172548"}},{"ID":"20240616172548-ao264jz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172548-ao264jz","updated":"20240616172548"},"Children":[{"Type":"NodeText","Data":"北沙参《得配本草》"}]},{"ID":"20240616172548-wdd0197","Type":"NodeParagraph","Properties":{"id":"20240616172548-wdd0197","updated":"20240616172548"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名白参，一名铃儿参。"}]},{"ID":"20240616172548-1oiko4v","Type":"NodeParagraph","Properties":{"id":"20240616172548-1oiko4v","updated":"20240616172548"},"Children":[{"Type":"NodeText","Data":"恶防己。反藜芦。"}]},{"ID":"20240616172548-mpmbcex","Type":"NodeParagraph","Properties":{"id":"20240616172548-mpmbcex","updated":"20240616172548"},"Children":[{"Type":"NodeText","Data":"甘，平，微苦，微寒。入手太阴经。补阴以制阳，清金以滋水。治久咳肺痿，皮热瘙痒，惊烦，嘈杂，多眠，疝痛，长肌肉，消痈肿。得糯米，助脾阴。配生地，凉血热。佐柴葛，去邪火。合玄参，止干嗽。"}]},{"ID":"20240616172548-gckjjj8","Type":"NodeParagraph","Properties":{"id":"20240616172548-gckjjj8","updated":"20240616172548"},"Children":[{"Type":"NodeText","Data":"气味清薄，宜加倍用。肺气寒，虚气上浮者，禁用。"}]},{"ID":"20240607131211-mwpab59","Type":"NodeThematicBreak","Properties":{"id":"20240607131211-mwpab59"}},{"ID":"20240607131213-kyw6llu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607131213-kyw6llu","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：沙参"}]},{"ID":"20240607131213-dup52sj","Type":"NodeParagraph","Properties":{"id":"20240607131213-dup52sj","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607131213-vtp64lg","Type":"NodeParagraph","Properties":{"id":"20240607131213-vtp64lg","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" Shā Shēn"}]},{"ID":"20240607131213-tf8lh7n","Type":"NodeParagraph","Properties":{"id":"20240607131213-tf8lh7n","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607131213-8lqaly4","Type":"NodeParagraph","Properties":{"id":"20240607131213-8lqaly4","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 南沙参、泡参、泡沙参"}]},{"ID":"20240607131213-o4xorwb","Type":"NodeParagraph","Properties":{"id":"20240607131213-o4xorwb","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607131213-n95t70q","Type":"NodeParagraph","Properties":{"id":"20240607131213-n95t70q","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 为桔梗科沙参属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四叶沙参"},{"Type":"NodeText","Data":"Adenophora tetraphylla （Thunb.） Fisch.[A. berticillata （Pall.） Fisch.]、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杏叶沙参"},{"Type":"NodeText","Data":"A. axilliflora Borb [A. stricta Miq.]或其同属植物，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"入药。秋季刨采，除去地上部分及须根，刮去粗皮，即时晒干。"}]},{"ID":"20240607131213-2os7kxl","Type":"NodeParagraph","Properties":{"id":"20240607131213-2os7kxl","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607131213-ir9oew6","Type":"NodeParagraph","Properties":{"id":"20240607131213-ir9oew6","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1、四叶沙参（轮叶沙参） 生于山野阴坡草丛中、林缘或路边。分布于东北及河北、山东、江苏、安徽、浙江、江西、广东、贵州、云南等地。"}]},{"ID":"20240607131213-eqhef0b","Type":"NodeParagraph","Properties":{"id":"20240607131213-eqhef0b","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2、杏叶沙参 生于路旁、山坡石缝或草丛中。分布于华东、中南及四川等地区。"}]},{"ID":"20240607131213-oxpv31l","Type":"NodeParagraph","Properties":{"id":"20240607131213-oxpv31l","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607131213-frkk8y6","Type":"NodeParagraph","Properties":{"id":"20240607131213-frkk8y6","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1、四叶沙参（轮叶沙参）多年生草本，高30～50厘米。主根粗肥，长圆锥形或圆柱状，黄褐色，粗糙，具横纹，顶端有芦头。茎常单生，少有丛生，除花序外不分枝，无毛。基生叶成丛，卵形、长椭圆形或近圆形；茎生叶常4片轮生，偶有5～6片轮生，外形变化很大，由卵形、披针形至条形，长4～8厘米，宽1.5～3厘米，边缘有粗锯齿、细锯齿至全缘，叶越宽，齿越粗。夏季开花，花序圆锥状，下部花枝轮生，顶部花枝有时互生；花萼光滑而小，杯状，先端5裂，裂片条状；花冠蓝色，窄钟形，长约1厘米，先端5浅裂；雄蕊5；雌蕊1，下部具肉质花盘，花柱细长，突出花冠外，柱头2裂，子房下位。蒴果球形而稍扁，孔裂，含有多数种子。"}]},{"ID":"20240607131213-oxh5aj5","Type":"NodeParagraph","Properties":{"id":"20240607131213-oxh5aj5","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2、杏叶沙参 多年生草本，高60～100厘米，全株被白色细毛。主根粗肥，细长圆锥形。茎单一，直立，上部分枝。基生叶有长柄，叶片广卵形；茎生叶互生，有短柄或无柄；叶片卵形或窄卵形，长3～7厘米，愈向上部叶愈窄小，边缘有粗细不等的锯齿。夏季开花，宽相近，蓝色。蒴果近球形。"}]},{"ID":"20240607131213-bti7nvg","Type":"NodeParagraph","Properties":{"id":"20240607131213-bti7nvg","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607131213-p0vyfuw","Type":"NodeParagraph","Properties":{"id":"20240607131213-p0vyfuw","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1、四叶沙参的根含三萜类皂甙为沙参皂甙（C"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"30"},{"Type":"NodeText","Data":"H"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"58"},{"Type":"NodeText","Data":"O"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"）。"}]},{"ID":"20240607131213-oocjyw8","Type":"NodeParagraph","Properties":{"id":"20240607131213-oocjyw8","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2、杏叶沙参的根含呋喃香豆精类：花椒毒素（xanthotoxin 或 ammoidin，为8-甲氧基补骨脂素）。"}]},{"ID":"20240607131213-d9zualf","Type":"NodeParagraph","Properties":{"id":"20240607131213-d9zualf","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607131213-qghklmj","Type":"NodeParagraph","Properties":{"id":"20240607131213-qghklmj","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1、本品有祛痰作用，可持续4小时以上。"}]},{"ID":"20240607131213-ge6n9jz","Type":"NodeParagraph","Properties":{"id":"20240607131213-ge6n9jz","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2、沙参的1:40浸液无溶血现象，但能与红血球作用变色而发生混浊沉淀。"}]},{"ID":"20240607131213-6h1j6ds","Type":"NodeParagraph","Properties":{"id":"20240607131213-6h1j6ds","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607131213-3szv6fj","Type":"NodeParagraph","Properties":{"id":"20240607131213-3szv6fj","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 甘，凉。"}]},{"ID":"20240607131213-93f3jp8","Type":"NodeParagraph","Properties":{"id":"20240607131213-93f3jp8","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607131213-voiml1c","Type":"NodeParagraph","Properties":{"id":"20240607131213-voiml1c","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 清热养阴，润肺止咳。主治气管炎，百日咳，肺热咳嗽，咯痰黄稠。"}]},{"ID":"20240607131213-vmor9o1","Type":"NodeParagraph","Properties":{"id":"20240607131213-vmor9o1","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607131213-wyigbe3","Type":"NodeParagraph","Properties":{"id":"20240607131213-wyigbe3","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 2～4钱。"}]},{"ID":"20240607131213-ogoy43l","Type":"NodeParagraph","Properties":{"id":"20240607131213-ogoy43l","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607131213-7mxh25q","Type":"NodeParagraph","Properties":{"id":"20240607131213-7mxh25q","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 肺热咳嗽无痰，咽干：（南）沙参、桑叶、麦冬各4钱，杏仁、贝母、枇杷叶各3钱。水煎服。"}]},{"ID":"20240607131213-tqnaxs3","Type":"NodeParagraph","Properties":{"id":"20240607131213-tqnaxs3","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607131213-s5qjk0y","Type":"NodeParagraph","Properties":{"id":"20240607131213-s5qjk0y","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 同属植物凡主根粗壮者均可作沙参（南沙参）入药，常见的还有以下数种："}]},{"ID":"20240607131213-pu1r7j1","Type":"NodeParagraph","Properties":{"id":"20240607131213-pu1r7j1","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"1、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"阔叶沙参"},{"Type":"NodeText","Data":"Adenophora pereskiaefolia （Fisch. ex Roem. et Schult.） Fisch., ex Loud.。分布于吉林、辽宁、河北、山西、陕西、山东、安徽等省。"}]},{"ID":"20240607131213-y6p80vw","Type":"NodeParagraph","Properties":{"id":"20240607131213-y6p80vw","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山沙参"},{"Type":"NodeText","Data":"Adenophora potaninii Korsh.。分布于河北、陕西、甘肃、青海、四川等省。"}]},{"ID":"20240607131213-qc9qb81","Type":"NodeParagraph","Properties":{"id":"20240607131213-qc9qb81","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"3、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长柱沙参"},{"Type":"NodeText","Data":"Adenophora stenanthina （Ledeb.）Kitag.，分布于东北各省。"}]},{"ID":"20240607131213-ai5ede0","Type":"NodeParagraph","Properties":{"id":"20240607131213-ai5ede0","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"4、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柳叶沙参"},{"Type":"NodeText","Data":"Adenophora coronopifolia Fisch.，分布于东北各省。"}]},{"ID":"20240607131213-axq5twu","Type":"NodeParagraph","Properties":{"id":"20240607131213-axq5twu","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"5、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线齿沙参"},{"Type":"NodeText","Data":"Adenophora capillaris Hemsl.，分布于四川省。"}]},{"ID":"20240607131213-he5jl39","Type":"NodeParagraph","Properties":{"id":"20240607131213-he5jl39","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"6、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"西南沙参"},{"Type":"NodeText","Data":"Adenophora buueyana Diels，分布于四川、云南等省。"}]},{"ID":"20240607131213-10jj9tw","Type":"NodeParagraph","Properties":{"id":"20240607131213-10jj9tw","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"7、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合叶沙参"},{"Type":"NodeText","Data":"Adenophora lilifolioides Pax et Hoffm.，分布于西藏。"}]},{"ID":"20240607131213-brwgoee","Type":"NodeParagraph","Properties":{"id":"20240607131213-brwgoee","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"8、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紫沙参"},{"Type":"NodeText","Data":"Adenophora paniculata Nannf.，分布于辽宁、河北、山西、内蒙古、陕西、甘肃等省。"}]},{"ID":"20240607131213-asyul6f","Type":"NodeParagraph","Properties":{"id":"20240607131213-asyul6f","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607131213-u93qal5","Type":"NodeParagraph","Properties":{"id":"20240607131213-u93qal5","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607131213-2oot1m3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607131213-2oot1m3","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"《中华本草》：沙参"}]},{"ID":"20240607131213-ri987d8","Type":"NodeParagraph","Properties":{"id":"20240607131213-ri987d8","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607131213-rxtqrn9","Type":"NodeParagraph","Properties":{"id":"20240607131213-rxtqrn9","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" Shā Shēn"}]},{"ID":"20240607131213-ffe6cpp","Type":"NodeParagraph","Properties":{"id":"20240607131213-ffe6cpp","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607131213-w56conk","Type":"NodeParagraph","Properties":{"id":"20240607131213-w56conk","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 知母、白沙参、苦心、识美、虎须、白参、志取、文虎、文希、羊婆奶、南沙参、铃儿参、泡参、桔参、山沙参、沙獭子"}]},{"ID":"20240607131213-yln1gqh","Type":"NodeParagraph","Properties":{"id":"20240607131213-yln1gqh","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607131213-ztmzk6q","Type":"NodeParagraph","Properties":{"id":"20240607131213-ztmzk6q","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 本品始载于《本经》,列为上品。《吴普本草》首先记载沙参之形态,云：\"三月生如葵,叶青,实白如芥,根大,白如芜菁 。三月采。\"《蜀本草》亦谓：\"花白色,根苦葵根。\"《纲目》记载较详,云：\"沙参处处山原有之。二月生苗,叶如初生小葵叶而团扁不光。八、九月抽茎,高一二尺。茎上之叶则尖长如枸记叶而小,有细齿。秋月叶间开小紫花,长二三分,状如铃铎,五出,白蕊,亦有白花春。并结实,大加冬青实,中有细于。霜后苗枯"}]},{"ID":"20240607131213-gcq8zql","Type":"NodeParagraph","Properties":{"id":"20240607131213-gcq8zql","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607131213-5no1fhk","Type":"NodeParagraph","Properties":{"id":"20240607131213-5no1fhk","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 药材基源：为桔梗科植物沙参、杏叶沙参、轮叶沙参、云南沙参、泡沙参及其同属数种植物的根。"}]},{"ID":"20240607131213-qx9eo7s","Type":"NodeParagraph","Properties":{"id":"20240607131213-qx9eo7s","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Adinophora stricta Miq.2.Adenophora hunanensis Nannf.3.Adenophora tetraphylla (Thunb.) Fisch. [A.uerticillata Fisch.; Campanula tetraphylla Thunb.]4.Adenophora khasiana (Hook. F. et Thoms.)5.Adenophora potaninii Korsh."}]},{"ID":"20240607131213-tusca3f","Type":"NodeParagraph","Properties":{"id":"20240607131213-tusca3f","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"采收和储藏：播种后2-3年采收，秋季挖取根部，除去茎叶及须根，洗净泥土，乘新鲜时用竹片刮去外皮，切片，晒干。"}]},{"ID":"20240607131213-u81l5ml","Type":"NodeParagraph","Properties":{"id":"20240607131213-u81l5ml","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607131213-meyr4df","Type":"NodeParagraph","Properties":{"id":"20240607131213-meyr4df","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.多生于低山草丛中和岩石缝内，也有生于海拔600-700m的草地上或1000-3200m的开旷山坡及林内者。"}]},{"ID":"20240607131213-tfktx3l","Type":"NodeParagraph","Properties":{"id":"20240607131213-tfktx3l","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"生于海拔600-2000m的草地或林缘草地中。"}]},{"ID":"20240607131213-sknlozc","Type":"NodeParagraph","Properties":{"id":"20240607131213-sknlozc","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2.生于山地草丛中。"}]},{"ID":"20240607131213-n2chx4q","Type":"NodeParagraph","Properties":{"id":"20240607131213-n2chx4q","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"3.生于草地或灌木丛中。"}]},{"ID":"20240607131213-il5osna","Type":"NodeParagraph","Properties":{"id":"20240607131213-il5osna","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"4.生于海拔1000-2800m的杂木林、灌丛或草丛中。"}]},{"ID":"20240607131213-33890zq","Type":"NodeParagraph","Properties":{"id":"20240607131213-33890zq","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"5.生于海拔3100m以下的阳坡草地，少生于灌丛或林下。"}]},{"ID":"20240607131213-l12yctk","Type":"NodeParagraph","Properties":{"id":"20240607131213-l12yctk","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于江苏、安徽、浙江、江西、湖南等地。"}]},{"ID":"20240607131213-fnck9ng","Type":"NodeParagraph","Properties":{"id":"20240607131213-fnck9ng","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"分布于西南及陕西、甘肃、广西等地。"}]},{"ID":"20240607131213-vypjujd","Type":"NodeParagraph","Properties":{"id":"20240607131213-vypjujd","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2.分布于河北、山西、陕西、河南、湖北、湖南、广东、广西、四川、贵州等地。"}]},{"ID":"20240607131213-m10d1cg","Type":"NodeParagraph","Properties":{"id":"20240607131213-m10d1cg","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"3.分布于东北、华北、华东、西南及华南。"}]},{"ID":"20240607131213-u15vszf","Type":"NodeParagraph","Properties":{"id":"20240607131213-u15vszf","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"4.分布于四川、云南、西西藏。"}]},{"ID":"20240607131213-p8k8v5s","Type":"NodeParagraph","Properties":{"id":"20240607131213-p8k8v5s","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"5.分布于山西、陕西、宁夏、甘肃、青海、四川等地。"}]},{"ID":"20240607131213-r6h37tx","Type":"NodeParagraph","Properties":{"id":"20240607131213-r6h37tx","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607131213-eox1cpr","Type":"NodeParagraph","Properties":{"id":"20240607131213-eox1cpr","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1.沙渗 多年生草本，茎高40-80cm。不分枝，常被短硬毛或长柔毛。基生叶心形，大而具长柄；茎生叶无柄，或仅下部的叶有极短而带翅的柄；叶片椭圆形、狭卵形，基部楔形，长3-11cm，宽1.5-5cm。先端急尖或短渐尖，边缘有不整齐的锯齿，两面疏生短毛或长硬毛，或近于毛。花序学不分枝而成假总状花序，或有短分枝而成极狭的圆锥花序，极少具长分枝而成圆锥花序的；花梗长不足5mm；花萼常被短柔毛呀粒状毛，少数无毛，筒部常倒卵状，少数为倒卵状圆锥形，裂片5，狭长，多为钻形，少数为条状披针形；花冠宽钟状，蓝色或紫色，外面无毛或有硬毛，裂片5，三角状卵形；花盘短筒状，无毛；雄蕊5，花丝下部扩大成片状，花药细长；花柱常略长于花冠，柱头3裂，子房下位，3室。蒴果椭圆状球形，极少为椭圆状，长6-10mm。种子多数，棕黄色，稍扁，有1条棱，长约1.5cm。花、果期8-10月。"}]},{"ID":"20240607131213-qvh5rdt","Type":"NodeParagraph","Properties":{"id":"20240607131213-qvh5rdt","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2.杏叶沙参 本种与沙参的区别在于：茎生叶在茎上部的无柄或仅有楔状短柄，叶基部常楔状下延，基生叶具长柄。花序分枝粗壮，几乎平展或弓曲向上；花萼裂片卵形至长卵形，最宽处在中下部，通常多少重叠，宽1.5-4mm，花盘多功能数有毛，少无毛；花柱与花冠等长。花期7-9月。"}]},{"ID":"20240607131213-rj5kj04","Type":"NodeParagraph","Properties":{"id":"20240607131213-rj5kj04","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"3.轮叶沙参 本种与前两种的区别在于：叶3-6轮生，卵圆形至线状披针形。花序分枝也常轮生；花盘较短，长2-4mm，直径不超过1mm；花冠细小，近于筒状，口部稍收缢，裂片长约2mm。花期7-9月。"}]},{"ID":"20240607131213-hs5afzw","Type":"NodeParagraph","Properties":{"id":"20240607131213-hs5afzw","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"4.云南沙参 本种与前三种的区别在于：茎生叶均匀分布于茎上；常无柄，叶片卵圆形至长卵形或倒卵形，上面疏生糙毛，下面密硬毛或仅叶脉上被硬毛。假总状花序；花盘短筒状，长不超过1mm；花萼边缘有1-3对小齿。花期8-10月。"}]},{"ID":"20240607131213-lhc27oc","Type":"NodeParagraph","Properties":{"id":"20240607131213-lhc27oc","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"5.泡沙参 本种与前四各的区别在于：茎常密被倒生短硬毛；茎生叶无柄，极个别有楔状短柄；叶片卵状椭圆形、长圆形、狭椭圆形和倒卵形，两面被毛，边缘有2至数个粗大齿。花序通常在基部有分枝；花盘被毛；花柱与花冠近等长。花期7-10月，果期10-11月。"}]},{"ID":"20240607131213-fa75141","Type":"NodeParagraph","Properties":{"id":"20240607131213-fa75141","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607131213-ss0dkon","Type":"NodeParagraph","Properties":{"id":"20240607131213-ss0dkon","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖或凉爽气候，耐寒，虽耐干旱，但在生长期中也需要适量水分，幼苗时期，干旱往往引起死苗。当年播种的沙参，一般不开花结实，需至翌年6月开花，花基6-9月，9月种子成熟。以土层深厚肥沃、富含腐殖质、排水良好的砂质壤土栽培为宜。"}]},{"ID":"20240607131213-tgcvnlq","Type":"NodeParagraph","Properties":{"id":"20240607131213-tgcvnlq","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"栽培技术 作种子繁殖，分春播与冬播，北方春播4月，冬播在1月上冻以前。整地施足基肥，每1hm2施堆肥或厩肥4500-60000kg。整地后，作畦宽1m，按行距40cm开浅沟，把种子均匀撒入沟内，覆土1-1.5cm，稍镇压，浇水，并经常保持土壤湿润，春播种子约两星期后出苗。冬播种子第2年春季出苗。"}]},{"ID":"20240607131213-g0d4414","Type":"NodeParagraph","Properties":{"id":"20240607131213-g0d4414","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"田间管理体制 幼苗出土后要注意除草、松土，苗高3cm左右间苗1次，高10-15cm时定苗，每隔10-15cm，留壮苗1棵。为防止倒伏，在生长期间，可结合施肥进行培土壅根。追肥，苗期需勤施薄肥，保持幼苗健壮，以后除每年植枯萎后和出苗前，各追肥1次外，还需在5、7、9月各肥1次，以人畜粪为主，在植株高45cm时，及时打顶，控制植株高度，减少养分消耗，有利根部生长。"}]},{"ID":"20240607131213-mofkrf3","Type":"NodeParagraph","Properties":{"id":"20240607131213-mofkrf3","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有根腐病，可用退菌特50%可湿性粉剂500倍液喷射。褐斑病可用代森锌65%可湿性粉剂500倍液喷射，虫害有蚜虫、地老虎等为害。"}]},{"ID":"20240607131213-ivxlvq3","Type":"NodeParagraph","Properties":{"id":"20240607131213-ivxlvq3","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607131213-7w3rsbx","Type":"NodeParagraph","Properties":{"id":"20240607131213-7w3rsbx","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）沙参 根圆柱形或圆锥形，有的弯曲或扭曲，少数2-3分枝，长8-27cm，直径1-4.3cm。表面黄白色或淡棕贡色，较粗糙，有不规则扭曲的皱纹，上部有细密横纹，凹陷处常有殖留棕褐色栓皮。顶端芦头（根茎）单个，稀多个，长2-7cm，四周具多数半月形茎痕，呈盘节状。质硬脆，易折断，折断面不平坦，类白色，多裂隙，较松泡。气微，味微甘、苦。"}]},{"ID":"20240607131213-vq61v9b","Type":"NodeParagraph","Properties":{"id":"20240607131213-vq61v9b","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（2）杏叶沙参 根圆锥形，下部分枝极少，长9-17cm，直径0.7-2cm。表面灰黄色或灰褐色，无环纹，有纵皱。顶端芦头长1.4-8.8cm，盘节明显或不明显。折断面不平坦，类白色，较结实。"}]},{"ID":"20240607131213-4ala2g7","Type":"NodeParagraph","Properties":{"id":"20240607131213-4ala2g7","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（3）轮叶沙参 根圆柱形，少2-分枝，长5.5-14cm，直径0.5-2cm。表面无纵皱，上部具环纹。折断面不平坦，白色，中空。"}]},{"ID":"20240607131213-by9mpvf","Type":"NodeParagraph","Properties":{"id":"20240607131213-by9mpvf","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（4）云南沙参 根偶有分枝，长5-25cm，直径1-3.5cm，上部多横纹，下部具弯曲纵纹或深沟纹。芦头长0.5-4cm。折断面白色，多裂隙。"}]},{"ID":"20240607131213-3huz4xg","Type":"NodeParagraph","Properties":{"id":"20240607131213-3huz4xg","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（5）泡沙参 根圆柱形，少2分枝，长8-14cm，直径0.9-3cm，表面矍环纹。芦头长3-6.5cm，盘节密。折断面不平坦，淡黄白色，松泡，中空。"}]},{"ID":"20240607131213-wdptoj7","Type":"NodeParagraph","Properties":{"id":"20240607131213-wdptoj7","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"均以粗细均匀、肥壮、色白者为佳。"}]},{"ID":"20240607131213-ts9nrnv","Type":"NodeParagraph","Properties":{"id":"20240607131213-ts9nrnv","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：（1）沙参（未去皮） 落皮层由木栓石细胞和木栓层组成。木栓石细胞1-3环，每环1列细胞，细胞长亠菜，外壁增厚4-45μm，侧壁常增厚成倒“U”字形，有的外壁呈脊状增厚突入胞腔内：木栓细胞2-4环，每环3-7列细胞。皮层窄，可见狭长的乳汁管。中柱三生构造明显，次生构造略偏心；近中央的三生维管束与次生维管束相嵌排列；形成层和额外形成层呈断续的弧状；三生维管束的木质部束常短宽，单束成分叉；射线明显，常挤压破碎，本品乳汁和常与筛管群伴生；菊糖仅见在少数导管或导和附近薄壁细胞中。"}]},{"ID":"20240607131213-5a6aroy","Type":"NodeParagraph","Properties":{"id":"20240607131213-5a6aroy","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（2）杏叶沙参 无木栓石细胞。木栓层厚4-25列细胞，木栓细胞壁平直工微波状弯曲。三生维管束密集。乳汁管存在于韧皮部、栓皮层。菊糖结晶少，存在于导管中，极少存在于薄壁细胞中。常见封闭组织。"}]},{"ID":"20240607131213-6v3erqd","Type":"NodeParagraph","Properties":{"id":"20240607131213-6v3erqd","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（3）轮叶沙参 木栓石细胞1-8环，每环厚1-2列细胞。木栓细胞厚3-7列细胞。乳汁管稀少，多聚集在筛管群附近。菊糖结晶多，存在于韧皮部。"}]},{"ID":"20240607131213-vcjzcfc","Type":"NodeParagraph","Properties":{"id":"20240607131213-vcjzcfc","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（4）泡沙参 木栓石细胞1-6环，每环厚1-5裂细胞；木栓石细胞壁均匀增厚，纹孔、孔沟明显。木栓细胞环2-15列细胞。三生维管束多，排列零乱；韧皮部外侧乳汁管群成环。菊糖结晶无或偶见。"}]},{"ID":"20240607131213-2o85boa","Type":"NodeParagraph","Properties":{"id":"20240607131213-2o85boa","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"粉末特征：（1）沙参 ①网纹、螺纹导管直径18-70μm，网纹导管网孔多狭缝状。②木栓石细胞表面观类长方形、长条形、类椭圆形、类多边形，长18-155μm，宽18-61μm，壁厚1-5μm，有的垂周壁连珠状增厚；侧面观长方形，外壁增厚5-7μm。③木栓细胸表面观类长方形、长条形或不规则形，垂周壁直或弯曲；断面观类长方表，壁略波状弯曲，有的可见条状纹理。④有节乳管常连接成网状。⑤菊糖结晶扇形、类圆形或不规则形。"}]},{"ID":"20240607131213-ga3wyr8","Type":"NodeParagraph","Properties":{"id":"20240607131213-ga3wyr8","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（2）杏叶沙参 ①网纹、梯纹导管直径14-71μm；梯纹导管纹孔多呈长方形。②木栓细胞表面观类多边形、类长方形，长35-2233μm，宽12-53μm。此外，有菊糖、乳汁管，偶见木栓石细胞（根茎）。"}]},{"ID":"20240607131213-d916oad","Type":"NodeParagraph","Properties":{"id":"20240607131213-d916oad","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（3）轮叶沙参 ①网纹、孔网纹及梯纹导管直径12-88μm。②木栓石细胞表面观类长方形，长93-240μm，宽21-59μm，壁厚1-27μm，可见细必裂纹及纹孔；断面观长方形，外壁厚，侧壁稍厚，呈马蹄形。此外，有木栓细胞、乳汁管及菊糖。"}]},{"ID":"20240607131213-9p1bz4e","Type":"NodeParagraph","Properties":{"id":"20240607131213-9p1bz4e","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"（4）泡沙参 ①网纹、梯纹导管直径12-75μm。②木栓石细胞表面观类长方形、类多边形，长35-107μm，宽19-46μm，壁厚5-14μm，纺也稀，细孔状，孔沟明显。③木栓细胞表面观长条形、类长方形或类多边形，垂周壁平直或波状弯曲；断面观类长方形，壁略弯曲，有的可见条状纹理。此外，有乳汁管、菊糖。"}]},{"ID":"20240607131213-alwwcmr","Type":"NodeParagraph","Properties":{"id":"20240607131213-alwwcmr","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607131213-k6mpxc6","Type":"NodeParagraph","Properties":{"id":"20240607131213-k6mpxc6","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 沙参根中分离得4个化合物，它们是：β-谷甾醇（β-sitosterol），β-谷甾醇-β-D-吡喃葡萄糖甙（β-sitosterol-O-β-D-glucopyranoside），蒲公英赛酮（taraxerone）及二十八碳酸（octa-cosanoic acid）[1]。"}]},{"ID":"20240607131213-pwvx8iw","Type":"NodeParagraph","Properties":{"id":"20240607131213-pwvx8iw","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607131213-ge586cc","Type":"NodeParagraph","Properties":{"id":"20240607131213-ge586cc","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1.对免疫功能的影响：腹腔注射杏叶沙参煎液（0.5g/只）能明显增高小鼠末梢血中淋巴细胞和T细胞数；胸腺内淋巴细胞数和T细胞数亦有增加趋势,可显着提高小鼠腹腔巨噬细胞吞噬百分率；可明显增加小鼠脾脏重量,但降低小鼠脾脏淋巴细胞数和T细胞数。表明沙参可提高机体细胞免疫和非特异性免疫,抑制体液免疫。具有调节免疫平衡的功能。沙参也可提高淋巴细胞转换率。"}]},{"ID":"20240607131213-j29odd5","Type":"NodeParagraph","Properties":{"id":"20240607131213-j29odd5","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2.祛痰作用：按1g/kg剂量给家兔灌服沙参煎剂表明具有一定的祛痰作用,其作用可持续4小时以上,但作用强度不及紫花等。"}]},{"ID":"20240607131213-hyfrjwr","Type":"NodeParagraph","Properties":{"id":"20240607131213-hyfrjwr","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"3.抗真菌作用：沙参水浸剂（1：2）在试管内对奥杜盎小芽胞癣菌、羊毛样小芽胞癣菌等皮肤真菌有不同程度的抑制作用。"}]},{"ID":"20240607131213-ihccc3m","Type":"NodeParagraph","Properties":{"id":"20240607131213-ihccc3m","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"4．强心作用：1%沙参浸剂对离体蟾蜍心脏具有明显强心作用,离体心脏振幅增大,作用可持续5分钟。"}]},{"ID":"20240607131213-8m7pe88","Type":"NodeParagraph","Properties":{"id":"20240607131213-8m7pe88","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607131213-b9mbk9y","Type":"NodeParagraph","Properties":{"id":"20240607131213-b9mbk9y","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1.沙参：现行,取原药材,除去杂质和芦头,洗净,润透,切厚片,干燥。"}]},{"ID":"20240607131213-lo4nqyg","Type":"NodeParagraph","Properties":{"id":"20240607131213-lo4nqyg","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"2.蜜沙参：现行,取炼蜜用适量开水稀释后,加入南沙参片中拌匀,闷透,置锅内,用文火加热,炒至黄橙色,不粘手为度。取出放凉。每南沙参片100kg用炼蜜25kg。"}]},{"ID":"20240607131213-tdg2duz","Type":"NodeParagraph","Properties":{"id":"20240607131213-tdg2duz","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"3．饮片性状：沙参为圆形或类圆形厚片,表面黄白色或类白色,有多数不规则裂隙,呈花纹状。周边淡棕黄色,皱缩。质轻。无臭,味微甘。蜜沙参形如南沙参片,表面橙黄色或焦黄色,偶见焦斑,味甜。"}]},{"ID":"20240607131213-2yixyum","Type":"NodeParagraph","Properties":{"id":"20240607131213-2yixyum","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607131213-qxpsxjn","Type":"NodeParagraph","Properties":{"id":"20240607131213-qxpsxjn","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 量化鉴别 （1）取本品粗粉身碎骨2g，加水20ml，置水浴中加热10min，滤过。取液液2ml，加5%α-萘酚乙醇液2-3滴，摇匀，沿试和壁缓缓加入硫酸0.5ml，两液接界处即显紫红色环。（检查糖类） 另取滤液2ml，加碱性酒石酸铜试液4-5滴，置水浴中加热5min，生成红棕色氧化亚铜沉淀。（检查糖类）（2）薄层色谱 取药材粉末2g，置索氏提取器中，加氯仿60ml，回流提取4h，回收氯仿后，残渣以1ml氯仿溶解作为供试液。另取β-谷甾醇及β-谷甾醇棕榈酸酯各1mg，加氯仿1ml溶解作为对照液。分别吸取上述供试液和和对照液各10μm，点于同一硅胶G薄板上。以氯仿-苯（9：1）展开至1/2处，吹干，再以氯仿-苯（7：3）展开。取出，晾干，喷以10%硫酸乙醇液，110℃加热5min。样品液色谱在与对照液色谱相应位置上显相同颜色的斑点。"}]},{"ID":"20240607131213-uglp5cd","Type":"NodeParagraph","Properties":{"id":"20240607131213-uglp5cd","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607131213-joesild","Type":"NodeParagraph","Properties":{"id":"20240607131213-joesild","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 归肺；胃经"}]},{"ID":"20240607131213-e68yhjy","Type":"NodeParagraph","Properties":{"id":"20240607131213-e68yhjy","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607131213-nc599ds","Type":"NodeParagraph","Properties":{"id":"20240607131213-nc599ds","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 味甘；微苦；性微寒"}]},{"ID":"20240607131213-pi1ud8u","Type":"NodeParagraph","Properties":{"id":"20240607131213-pi1ud8u","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607131213-q388xo5","Type":"NodeParagraph","Properties":{"id":"20240607131213-q388xo5","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 风寒咳嗽禁服。"}]},{"ID":"20240607131213-ljw0fqf","Type":"NodeParagraph","Properties":{"id":"20240607131213-ljw0fqf","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：\"恶防己,反藜芦。\"2.《本草经疏》：\"脏腑无实热,肺虚寒客之作嗽者,勿服。\""}]},{"ID":"20240607131213-glb5mqf","Type":"NodeParagraph","Properties":{"id":"20240607131213-glb5mqf","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607131213-oxs9une","Type":"NodeParagraph","Properties":{"id":"20240607131213-oxs9une","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 养阴清热；润肺化痰；益胃生津。主阴虚久咳；痨嗽痰血；燥咳痰少；虚热喉痹；津伤口渴"}]},{"ID":"20240607131213-pnepxwb","Type":"NodeParagraph","Properties":{"id":"20240607131213-pnepxwb","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607131213-0s9t3cg","Type":"NodeParagraph","Properties":{"id":"20240607131213-0s9t3cg","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g，鲜品15-30g，或入丸、散。"}]},{"ID":"20240607131213-5j5hsqk","Type":"NodeParagraph","Properties":{"id":"20240607131213-5j5hsqk","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607131213-kcrp19s","Type":"NodeParagraph","Properties":{"id":"20240607131213-kcrp19s","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 《纲目》:“沙参白色,宜于沙地,故名。其根多白汁,俚人呼为羊婆奶,《别录》有名未用羊乳,即此也。此物无心味谈,而《别录》一名苦心,又与知母同名,不知所谓也。铃儿草,象花形也。”按:弘景谓五参“主疗颇同”,非也,实因其根皆为锥形与人参相类也。时珍列沙参为山草类,并谓“沙参处处山原有之”,而又调其“宜于沙地”,所释乃望文生义。《吴普本草》云:“沙参,一名白参,实白如芥,很大,白如芜菁。”《广雅疏证》:“案‘沙’之言斯,白也。”《诗刊、小雅. 瓠叶)笺云:“‘斯’,白也。今俗语斯白字作‘鲜’,齐鲁之声近斯。斯、沙古音相近。实与根皆白,故调之‘白参’,又谓之‘沙参’”。“沙参”与“白参”同义。《广雅疏证》又云:“《神农本草》云:‘沙参一名知母,味苦,此苦心之所以名也。’”《本草经考注》则云:“沙参、知母,古误混同……知母下地参、水参、水须三名盖为沙参一名。沙参下黑字一名虎须亦是知母条错简欤。”可供参考。"}]},{"ID":"20240607131213-b0xrj5w","Type":"NodeParagraph","Properties":{"id":"20240607131213-b0xrj5w","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607131213-c7y0tkk","Type":"NodeParagraph","Properties":{"id":"20240607131213-c7y0tkk","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1.骚日老西散（沙参四味散）沙参 25g,甘草15g,紫草茸15g,拳参15g。以上四味,粉碎成细粉,混匀,分装,即得,每袋50g。本品淡白色粉末；味微甘。功能解热清肺,止咳祛痰。用于感冒咳嗽,肺热咳嗽,痰中带血,胸胁刺痛。口服,每次5g,每日1-2次,小儿酌减。（《辽宁省药品标准》1987年）2.南沙参浸膏溶液：南沙参 1000g。取南沙参按渗漉法,以35%乙醇为溶媒,俟渗出液达生药量5倍时,停止渗漉,回收乙醇并浓缩,滤过。取少许澄明滤液测定含量后,调整至每1ml含抽出物250mg,再加0.5%宋甲酸钠,静置8-10天,取上清液滤过即得。按总抽出物方法测定：每1ml含总抽出物250mg。功能镇咳祛痰,清肺火止咳。用于肺气虚弱,慢性气管炎,肺气肿,肺脓疡,肺结核,咳嗽气短,午后发热,咯血等。口服,每次2-10ml,每日2次。（《中药制剂汇编》）3.利咽合剂：南沙参250g,桑叶75g,石斛125g,射干125g,木蝴蝶37g,白苏子125g,麦冬150g。以上七味,加水煎煮2次,合并煎液,滤过,静置,上清液浓缩至1050ml,加适量防腐剂,搅拌,静置,取上清液 1 000ml,即得。本品为淡黄色液体,味苦。放置后略有沉淀。取本品2ml,加碱性酒石酸铜试液4-5滴,水浴加热5分钟,产生红棕色沉淀,本品的相对密度应不低于1.03。功能养阴生津,清热利咽。用于慢性咽炎。口服,每次20ml,每日2次。（南京市卫生局《医院制剂规范》）"}]},{"ID":"20240607131213-6w07sri","Type":"NodeParagraph","Properties":{"id":"20240607131213-6w07sri","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607131213-3ebxvxo","Type":"NodeParagraph","Properties":{"id":"20240607131213-3ebxvxo","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 1.《别录》：\"沙参生河内川谷及冤句、般阳续山。二月、八月采根,暴干。\"2.《本草经集注》：\"今出近道,丛生,叶似枸杞,根白实者佳。此沙参井人参是为五参,其形不尽相类,而主疗颇同,故皆有多名,又有紫参,正名牡蒙,在中品。\"3.《蜀本草》：《图经》云：花白色,根若葵根。\"4.《本草图经》：\"今出淄、齐。潞、随州,而江、淮、荆、湖州郡或有之。苗长一、二尺以来,丛生崖壁间,叶似枸杞而有叉牙,七月开紫花,根知葵根,着许大,赤黄色,中正白实者佳。二月、八月来根,暴十。有上生者叶有细有大,花白,瓣上仍有白粘胶,此为小异。\"5.《救荒本草》：\"沙参,令辉县太行山边亦有之。又有杏叶沙参及细叶沙参,气味与此相类,但《图经》内不曾载此二种叶苗形容,未敢收入本条。今皆另条开载。救饥：掘根浸洗极净,换水煮上苦味,再以水煮饭熟,食之。\"6.《本草备要》：\"似人参而体轻松,向实者良。生沙地者长大,生黄土者瘦小（北地真者难得。沙参分南北两种：北者良；南者功用相同而力稍逊。）\"7.《本草从新》：\"南沙参,色稍黄,形稍瘦小而短,近有. 种味带辣者,不可用。\"8.《本经逢原》：\"沙参有南北二种,北者质坚性寒,南者体虚力微。\"9.《植物名实图考》：\"沙参,《本经》上品。处处皆有,以北产及太行山为上,其类亦有数种,洋《救荒本草》。花与荠苨相同,惟叶小而很有心为别。\""}]},{"ID":"20240607131213-8isefju","Type":"NodeParagraph","Properties":{"id":"20240607131213-8isefju","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607131213-q48qsu0","Type":"NodeParagraph","Properties":{"id":"20240607131213-q48qsu0","updated":"20240607131213"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607131214-564kz6j","Type":"NodeThematicBreak","Properties":{"id":"20240607131214-564kz6j"}},{"ID":"20240616172128-865tgtj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172128-865tgtj","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：北沙参"}]},{"ID":"20240616172128-rqhaxjd","Type":"NodeParagraph","Properties":{"id":"20240616172128-rqhaxjd","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616172128-55fj86h","Type":"NodeParagraph","Properties":{"id":"20240616172128-55fj86h","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" Běi Shā Shēn"}]},{"ID":"20240616172128-qvi272n","Type":"NodeParagraph","Properties":{"id":"20240616172128-qvi272n","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616172128-x9fpz4d","Type":"NodeParagraph","Properties":{"id":"20240616172128-x9fpz4d","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 莱阳沙参、海沙参、辽沙参、条沙参"}]},{"ID":"20240616172128-4jtjqd5","Type":"NodeParagraph","Properties":{"id":"20240616172128-4jtjqd5","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240616172128-wfhxtur","Type":"NodeParagraph","Properties":{"id":"20240616172128-wfhxtur","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" RADIX GLEHNIAE"}]},{"ID":"20240616172128-1vt1epa","Type":"NodeParagraph","Properties":{"id":"20240616172128-1vt1epa","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616172128-0vl1j7r","Type":"NodeParagraph","Properties":{"id":"20240616172128-0vl1j7r","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 本品为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"珊瑚菜"},{"Type":"NodeText","Data":"Glehnia littoralis Fr. Schmidt ex Miq. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。夏、秋二季采挖，除去须根，洗净，稍晾，置沸水中烫后，除去外皮，干燥。或洗净直接干燥。"}]},{"ID":"20240616172128-2p5yq1o","Type":"NodeParagraph","Properties":{"id":"20240616172128-2p5yq1o","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616172128-s16b4cc","Type":"NodeParagraph","Properties":{"id":"20240616172128-s16b4cc","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 本品呈细长圆柱形，偶有分枝，长15～45cm，直径0.4～1.2cm。表面淡黄白色，略粗糙，偶有残存外皮，不去外皮的表面黄棕色。全体有细纵皱纹及纵沟，并有棕黄色点状细根痕。顶端常留有黄棕色根茎残基；上端稍细，中部略粗，下部渐细。质脆，易折断，断面皮部浅黄白色，木部黄色。气特异，味微甘。"}]},{"ID":"20240616172128-frnibns","Type":"NodeParagraph","Properties":{"id":"20240616172128-frnibns","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240616172128-frirs58","Type":"NodeParagraph","Properties":{"id":"20240616172128-frirs58","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240616172128-d9u52z5","Type":"NodeParagraph","Properties":{"id":"20240616172128-d9u52z5","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240616172128-j6x9ozj","Type":"NodeParagraph","Properties":{"id":"20240616172128-j6x9ozj","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 除去残茎及杂质，略润，切段，晒干。"}]},{"ID":"20240616172128-xt1pauk","Type":"NodeParagraph","Properties":{"id":"20240616172128-xt1pauk","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240616172128-79zuk4z","Type":"NodeParagraph","Properties":{"id":"20240616172128-79zuk4z","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 本品横切面：皮层为数列薄壁细胞，有分泌道散在。不去外皮的可见木栓层。韧皮部宽广，射线明显；外侧筛管群颓废作条状；分泌道散列，直径20～65μm，内含黄棕色分泌物，周围分泌细胞 5～8 个。形成层成环。木质部射线宽 2～ 5 列细胞；导管大多成“Ｖ”形排列；薄壁细胞含糊化淀粉粒。"}]},{"ID":"20240616172128-24q7dto","Type":"NodeParagraph","Properties":{"id":"20240616172128-24q7dto","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616172128-l9izlnm","Type":"NodeParagraph","Properties":{"id":"20240616172128-l9izlnm","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 归肺、胃经。"}]},{"ID":"20240616172128-qcyw7j8","Type":"NodeParagraph","Properties":{"id":"20240616172128-qcyw7j8","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616172128-k62svxz","Type":"NodeParagraph","Properties":{"id":"20240616172128-k62svxz","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 甘、微苦，微寒。"}]},{"ID":"20240616172128-y2a75b0","Type":"NodeParagraph","Properties":{"id":"20240616172128-y2a75b0","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240616172128-syios2z","Type":"NodeParagraph","Properties":{"id":"20240616172128-syios2z","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 不宜与藜芦同用。"}]},{"ID":"20240616172128-esizetx","Type":"NodeParagraph","Properties":{"id":"20240616172128-esizetx","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616172128-aw712ie","Type":"NodeParagraph","Properties":{"id":"20240616172128-aw712ie","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 养阴清肺，益胃生津。用于肺热燥咳，劳嗽痰血，热病津伤口渴。"}]},{"ID":"20240616172128-f6koxmc","Type":"NodeParagraph","Properties":{"id":"20240616172128-f6koxmc","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616172128-9wff23b","Type":"NodeParagraph","Properties":{"id":"20240616172128-9wff23b","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 4.5～9g。"}]},{"ID":"20240616172128-r8aeedk","Type":"NodeParagraph","Properties":{"id":"20240616172128-r8aeedk","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616172128-2yotzfm","Type":"NodeParagraph","Properties":{"id":"20240616172128-2yotzfm","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240616172128-ngcxrun","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172128-ngcxrun","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：北沙参"}]},{"ID":"20240616172128-fkwnvqu","Type":"NodeParagraph","Properties":{"id":"20240616172128-fkwnvqu","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616172128-hdhdizq","Type":"NodeParagraph","Properties":{"id":"20240616172128-hdhdizq","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" Běi Shā Shēn"}]},{"ID":"20240616172128-u9l74w8","Type":"NodeParagraph","Properties":{"id":"20240616172128-u9l74w8","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616172128-48g2yew","Type":"NodeParagraph","Properties":{"id":"20240616172128-48g2yew","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 海沙参、银条参、莱阳参（《江苏植药志》），辽沙参（《中药志》），野香菜根（《中药材手册》），真北沙参（《卫生易简方》）。"}]},{"ID":"20240616172128-heal3i4","Type":"NodeParagraph","Properties":{"id":"20240616172128-heal3i4","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616172128-cxjgokh","Type":"NodeParagraph","Properties":{"id":"20240616172128-cxjgokh","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"珊瑚菜"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。7～8月或9月下旬采挖，除去地上茎及须根，洗净泥土，放开水中烫后剥去外皮，晒干或烘干。"}]},{"ID":"20240616172128-u322n8e","Type":"NodeParagraph","Properties":{"id":"20240616172128-u322n8e","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240616172128-2fk0dsl","Type":"NodeParagraph","Properties":{"id":"20240616172128-2fk0dsl","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 生于海边沙滩，或为栽培。分布辽宁、河北、山东、江苏、浙江、广东、福建、台湾等地。主产山东、河北、辽宁、江苏等地。"}]},{"ID":"20240616172128-0i9a7lg","Type":"NodeParagraph","Properties":{"id":"20240616172128-0i9a7lg","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616172128-mq8lcjy","Type":"NodeParagraph","Properties":{"id":"20240616172128-mq8lcjy","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 珊瑚菜（《江淮杂记》），又名：滨防风。"}]},{"ID":"20240616172128-5hwb9do","Type":"NodeParagraph","Properties":{"id":"20240616172128-5hwb9do","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"多年生草本，高5～35厘米。主根细长圆柱形。茎大部埋在沙中，一部分露出地面。叶基出，互生；叶柄长，基部鞘状；叶片卵圆形，3出式分裂至2回羽状分裂，最后裂片圆卵形，先端圆或渐尖，基部截形，边缘刺刻，质厚。复伞形花序顶生，具租毛；伞梗10～20条，长1～2厘米；无总苞，小总苞由数个线状披针形的小苞片组成；花白色，每1小伞形花序有花15～20朵；花萼5齿裂，狭三角状披针形，疏生粗毛；花瓣5，卵状披针形；雄蕊5，与花瓣互生；子房下位，花柱基部扁圆锥形。果实近圆球形，具绒毛，果棱有翅。花期5～7月。果期6～8月。"}]},{"ID":"20240616172128-llelfht","Type":"NodeParagraph","Properties":{"id":"20240616172128-llelfht","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616172128-czhrvv1","Type":"NodeParagraph","Properties":{"id":"20240616172128-czhrvv1","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 干燥根呈细圆柱形或直条状，两头较细，很少有分歧，长15～30厘米，直径3～8毫米。外表淡黄色，粗糙，具纵纹及未除尽的棕黄色栓皮，并有棕色点状的支报痕迹，顶端往往残留圆柱状的根茎。质硬而脆，易折断。断面不整齐，淡黄色，中央有黄色放射状的木质部，形成层呈圆环状，深褐色。气微，味甘。以根条细长、均匀色白、质坚实者佳。"}]},{"ID":"20240616172128-rpqwihm","Type":"NodeParagraph","Properties":{"id":"20240616172128-rpqwihm","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240616172128-zk2zfv1","Type":"NodeParagraph","Properties":{"id":"20240616172128-zk2zfv1","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240616172128-ii0ove2","Type":"NodeParagraph","Properties":{"id":"20240616172128-ii0ove2","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616172128-d16s8ra","Type":"NodeParagraph","Properties":{"id":"20240616172128-d16s8ra","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 根含生物碱、丰富的淀粉。果实含珊瑚菜素。"}]},{"ID":"20240616172128-609rtyl","Type":"NodeParagraph","Properties":{"id":"20240616172128-609rtyl","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240616172128-5fjxo41","Type":"NodeParagraph","Properties":{"id":"20240616172128-5fjxo41","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，除去茎基，用水略洗，捞出，稍润，切段，晒干。"}]},{"ID":"20240616172128-i9pfn2x","Type":"NodeParagraph","Properties":{"id":"20240616172128-i9pfn2x","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616172128-udcy4mr","Type":"NodeParagraph","Properties":{"id":"20240616172128-udcy4mr","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 入肺、脾经。"}]},{"ID":"20240616172128-70d5ehx","Type":"NodeParagraph","Properties":{"id":"20240616172128-70d5ehx","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入手太阴经。\""}]},{"ID":"20240616172128-fdjd9sf","Type":"NodeParagraph","Properties":{"id":"20240616172128-fdjd9sf","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"入手、足太阴经。\""}]},{"ID":"20240616172128-wkhp272","Type":"NodeParagraph","Properties":{"id":"20240616172128-wkhp272","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616172128-kj147mv","Type":"NodeParagraph","Properties":{"id":"20240616172128-kj147mv","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 甘苦淡，凉。"}]},{"ID":"20240616172128-05hdnmz","Type":"NodeParagraph","Properties":{"id":"20240616172128-05hdnmz","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"①《本经逢原》：\"甘淡，性寒，无毒。\""}]},{"ID":"20240616172128-vrukz7i","Type":"NodeParagraph","Properties":{"id":"20240616172128-vrukz7i","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"甘苦味淡，微寒。\""}]},{"ID":"20240616172128-a5oleos","Type":"NodeParagraph","Properties":{"id":"20240616172128-a5oleos","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240616172128-o0glwbo","Type":"NodeParagraph","Properties":{"id":"20240616172128-o0glwbo","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 风寒作嗽及肺胃虚寒者忌服。"}]},{"ID":"20240616172128-w2wo2s1","Type":"NodeParagraph","Properties":{"id":"20240616172128-w2wo2s1","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"《本草从新》：\"恶防己。反藜芦。\""}]},{"ID":"20240616172128-751our5","Type":"NodeParagraph","Properties":{"id":"20240616172128-751our5","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616172128-1o4vnxw","Type":"NodeParagraph","Properties":{"id":"20240616172128-1o4vnxw","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 养阴清肺，祛痰止咳。治肺热燥咳，虚痨久咳，阴伤咽干、口渴。"}]},{"ID":"20240616172128-74uyb3f","Type":"NodeParagraph","Properties":{"id":"20240616172128-74uyb3f","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"①《本草从新》：\"专补肺阴，清肺火，治久咳肺痿。\""}]},{"ID":"20240616172128-hv4m0ex","Type":"NodeParagraph","Properties":{"id":"20240616172128-hv4m0ex","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"②《饮片新参》：\"养肺胃阴，治劳咳痰血。\""}]},{"ID":"20240616172128-qrn72lf","Type":"NodeParagraph","Properties":{"id":"20240616172128-qrn72lf","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"③《东北药植志》：\"治慢性支气管炎，肺结核，肺膨胀不全，肺脓疡等。\""}]},{"ID":"20240616172128-v6hrgp2","Type":"NodeParagraph","Properties":{"id":"20240616172128-v6hrgp2","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"④《中药志》：\"养肺阴，清肺热，祛痰止咳。治虚劳发热，阴伤燥咳，口渴咽干。\""}]},{"ID":"20240616172128-mc47ptc","Type":"NodeParagraph","Properties":{"id":"20240616172128-mc47ptc","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616172128-jdozdu4","Type":"NodeParagraph","Properties":{"id":"20240616172128-jdozdu4","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；亦可熬膏或入丸剂。"}]},{"ID":"20240616172128-1h2whcx","Type":"NodeParagraph","Properties":{"id":"20240616172128-1h2whcx","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240616172128-gcdjvmv","Type":"NodeParagraph","Properties":{"id":"20240616172128-gcdjvmv","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" ①治阴虚火炎，咳嗽无痰，骨蒸劳热，肌皮枯燥，口苦烦渴等证：真北沙参、麦门冬、知母、川贝母、怀熟地、鳖甲，地骨皮各四两。或作丸，或作膏，每早服三钱，白汤下。（《卫生易简方》）"}]},{"ID":"20240616172128-3dxptad","Type":"NodeParagraph","Properties":{"id":"20240616172128-3dxptad","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"②治一切阴虚火炎，似虚似实，逆气不降，消气不升，烦渴咳嗽，胀满不食：真北沙参五钱。水煎服。（《林仲先医案》）"}]},{"ID":"20240616172128-mlz51vu","Type":"NodeParagraph","Properties":{"id":"20240616172128-mlz51vu","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616172128-tnxci9k","Type":"NodeParagraph","Properties":{"id":"20240616172128-tnxci9k","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240616172128-g5gyalo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616172128-g5gyalo","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"《中华本草》：北沙参"}]},{"ID":"20240616172128-tl29kc8","Type":"NodeParagraph","Properties":{"id":"20240616172128-tl29kc8","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616172128-1ei5m46","Type":"NodeParagraph","Properties":{"id":"20240616172128-1ei5m46","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" Běi Shā Shēn"}]},{"ID":"20240616172128-asf27a0","Type":"NodeParagraph","Properties":{"id":"20240616172128-asf27a0","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616172128-8wjs76p","Type":"NodeParagraph","Properties":{"id":"20240616172128-8wjs76p","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 真北沙参；海沙参；根条参；菜阳参；辽沙参；野香菜根"}]},{"ID":"20240616172128-gn27amk","Type":"NodeParagraph","Properties":{"id":"20240616172128-gn27amk","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240616172128-54jhfb3","Type":"NodeParagraph","Properties":{"id":"20240616172128-54jhfb3","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" coastal Glehnia Root, Root of coastal Glehnia"}]},{"ID":"20240616172128-jhwbvig","Type":"NodeParagraph","Properties":{"id":"20240616172128-jhwbvig","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240616172128-4dh3vnz","Type":"NodeParagraph","Properties":{"id":"20240616172128-4dh3vnz","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 出自《本草汇言》。"}]},{"ID":"20240616172128-18mild4","Type":"NodeParagraph","Properties":{"id":"20240616172128-18mild4","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616172128-fy86zp7","Type":"NodeParagraph","Properties":{"id":"20240616172128-fy86zp7","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物北沙参的根。"}]},{"ID":"20240616172128-1gfrwws","Type":"NodeParagraph","Properties":{"id":"20240616172128-1gfrwws","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Glehnia littoralis F. Schmidtex Miq."}]},{"ID":"20240616172128-zecx3ut","Type":"NodeParagraph","Properties":{"id":"20240616172128-zecx3ut","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春参（二年生参）在第3年7月收，秋参（1年生参）在第2年9月收，以秋参为好，刨出根，去须根，洗净，用开水烫后，剥去外皮，晒干或烘干。"}]},{"ID":"20240616172128-a6k1vxi","Type":"NodeParagraph","Properties":{"id":"20240616172128-a6k1vxi","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240616172128-1y5xe1h","Type":"NodeParagraph","Properties":{"id":"20240616172128-1y5xe1h","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海岸沙地、沙滩，或栽培于肥沃疏松的砂质壤土。"}]},{"ID":"20240616172128-6pcprys","Type":"NodeParagraph","Properties":{"id":"20240616172128-6pcprys","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于辽宁、河北、山东、江苏、浙江、福建、台湾、广东等地。"}]},{"ID":"20240616172128-znbbris","Type":"NodeParagraph","Properties":{"id":"20240616172128-znbbris","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616172128-f9rerkx","Type":"NodeParagraph","Properties":{"id":"20240616172128-f9rerkx","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高5-20cm。全株被白色柔毛。主根细长，圆柱菜，长达30cm，粗0.5-1.5cm，很少分枝。茎露于地上部分较短，地下部分伸长。基生叶质厚，有长柄；叶柄长5-15cm，基部宽鞘状，边缘膜质；叶片轮廓呈圆卵形至三角状卵形，三出式分裂或三出式二回羽状分裂，末回裂片倒卵形至卵圆形，长1-6cm，贡1-4cm，顶端圆至渐尖，基部楔形至截形，边缘有缺刻状锯齿，齿缘白以软骨质；叶柄和叶脉有细微硬毛；茎生叶形状与基生叶相似，叶柄基部渐膨大成鞘状。复伞形花序顶生，密被灰褐色长柔毛，径3-6cm，花序梗长2-6cm；伞辐8-16，不等长，长1-3cm；无总苞片；小总苞片数片，线状披针形，边缘及背部必被柔毛；小伞形花序有花15-20；萼齿5，窄三角状披针形，疏生粗毛；花瓣白色；花柱基短圆锥状。又悬果圆球形椭圆形，长6-13mm，宽6-10mm，必被棕色长柔毛及绒毛，果棱有木栓质翅，分生果横剖面扁椭圆形，有5个棱角，合生面平坦，油管较多，连成一圈，胚乳腹面略凹陷。花期5-7月，果期6-8月。"}]},{"ID":"20240616172128-1s97c2p","Type":"NodeParagraph","Properties":{"id":"20240616172128-1s97c2p","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240616172128-gud9d9o","Type":"NodeParagraph","Properties":{"id":"20240616172128-gud9d9o","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，能抗寒，耐干旱，忌水涝，忌连作和花生茬。以土层深厚、疏松肥沃、排水良好的油砂土，砂壤土和冲积砂土栽种，不宜在粘土和低洼积水地种植。"}]},{"ID":"20240616172128-7m1podw","Type":"NodeParagraph","Properties":{"id":"20240616172128-7m1podw","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"栽培技术 用当年种子繁殖，秋季和春季均可播种。秋播在11月上旬，播前20多日湿润种了，常翻动检查，至种仁发软。春播在早春开冻后，但必须在冬季将滚滚的种子放在室外潮湿处，埋于土中经受低温冷冻处理，使种胚发育成熟。如春播干种子，当年不能出苗。播种分宽幅条播和窄幅条播。宽幅条播：播同宽15cm左右，行距25cm开沟，深4cm左右，种子与种子相隔4-5cm，开第2沟时溢土覆盖前沟，覆土约3cm。窄幅条播：播幅宽6cm，行距15cm左右，方法与宽幅条播相同，播种量沙质壤土每1hm275kg，纯沙地每1hm290-112.5kg。"}]},{"ID":"20240616172128-0xltndl","Type":"NodeParagraph","Properties":{"id":"20240616172128-0xltndl","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"田间管理 小苗有2-3片真叶时间苗，三角形留苗，株距3cm左右，在间苗时，需进行除草。由于是密植作物，且茎叶脆嫩易断，不宜中耕除草，草多可拔除。春季如遇干旱需酌情浇水，保持地面湿润。生长后期地面积水应及时排水，发现小参苗现蕾，须及时摘除。生长后期可追施磷、钾肥。"}]},{"ID":"20240616172128-nikyw0d","Type":"NodeParagraph","Properties":{"id":"20240616172128-nikyw0d","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"病虫害防治 根结线虫害，5月份开始发生，忌连作和花生茬，选用无病地。北沙参病毒病，彻底防治蚜虫，红蜘蛛等病毒传播者，选无病株留种。锈病，用25%粉锈宁可湿性粉1000倍液喷雾，每10d1次，连续数次。大灰象甲（象鼻虫—），清晨或傍晚进行人工捕杀，每1hm2用75-120kg，鲜萝卜条功其他盥菜；国90%敌百虫100g，用少量水拦均作毒饵，于傍晚撒于地诱杀。钻心虫，在卵期及幼虫初孵未钻入前用90%敌百虫喷杀。"}]},{"ID":"20240616172128-lukt97k","Type":"NodeParagraph","Properties":{"id":"20240616172128-lukt97k","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616172128-l1qnyw5","Type":"NodeParagraph","Properties":{"id":"20240616172128-l1qnyw5","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根细长国cm，直径0.2-1.5cm。表面淡黄白色，略粗糙，偶有残留外皮；不去外皮的表面横棕以，有不规则纵沟及裂隙，并有横棕色横长皮孔及较多点状突起的细根痕。根头渐细，有残留茎基。质坚脆，易折断，断面皮部浅黄白色，形成层环深褐色，木部黄色，放射状。气微香，味微甜。"}]},{"ID":"20240616172128-9ae10xy","Type":"NodeParagraph","Properties":{"id":"20240616172128-9ae10xy","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"以粗细均匀、长短一致、去净栓皮、色黄白者为佳。"}]},{"ID":"20240616172128-fn008v5","Type":"NodeParagraph","Properties":{"id":"20240616172128-fn008v5","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：未去外皮者木栓层2-11列细胞。皮层为数列细胞，有扁圆形分泌道散在，有的1个分泌道并列或中间溶合成一体。韧皮部宽广，分泌道略呈环状排列，类圆形，直径24-135μm，分泌细胞4-10个；韧皮射线向外扩大成喇兄弟状，并向一侧弯曲。形成层环明显。木质部导管单个散在或数个相聚，木射线宽1-3列细胞。本品薄壁细胞含糊化演粉粒。"}]},{"ID":"20240616172128-mzxkym8","Type":"NodeParagraph","Properties":{"id":"20240616172128-mzxkym8","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄白色。①网纹导管直径17-86μm，网孔长而宽。②分泌道多碎断，分泌细胞含黄色分泌物，有的可见节条状金黄色分泌物，直径约至69μm。③糊化演粉粒呈不规则块状，未加工的可见演粉粒单粒圆形或类圆形，直径2-22μm，脐点点状，复粒稀少。此外，有木栓细胞及射线细胞。"}]},{"ID":"20240616172128-b3on16y","Type":"NodeParagraph","Properties":{"id":"20240616172128-b3on16y","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616172128-pq47rcw","Type":"NodeParagraph","Properties":{"id":"20240616172128-pq47rcw","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 根、根茎含多种香豆精类化合物：补骨脂素（psoralen)，香柑内酯（bergapten），花椒毒素（xanthotoxin)，异欧前胡内酯（isoimperatorin)，欧前胡内酯（imperatorin)，香柑素（bergaptin)，9-牻牛儿醇基补骨脂素（9-geranyloxypsoralen)，9-甲氧基异欧前胡内酯（cnidiline)，花椒毒酚（xanthotoxol)，别异欧前胡内酯（alloisoimperatorin)，9-（1，1-二甲基烯丙基）-4-羟基补骨脂素[9-（1，1-dimethylallyl)-4-hydroxypsoralen)，印度榅桲素（marmesin)，东莨菪素（scopoletin)，7-O-（3，3-二甲基烯丙基）-东莨菪素[7-O-（3，3-dimethylallyl)-scopoletin]及欧芹酚-7-O-β-龙胆二糖甙（ostheol-7-O-β-gentiobioside)[1]。还含北沙参多糖（GLP）[2]，磷脂（phospholipid)约140-150mg/100g，其中卵磷脂（lecithin)约占51%，脑磷脂（cephalin)xq hk 18%[3]。"}]},{"ID":"20240616172128-vbd2rd9","Type":"NodeParagraph","Properties":{"id":"20240616172128-vbd2rd9","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240616172128-r4kab1h","Type":"NodeParagraph","Properties":{"id":"20240616172128-r4kab1h","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 1.免疫抑制作用：1.1.对小鼠脾脏溶血空斑形成细胞（PFC）的抑制作用：BALB／c小鼠30只等分为5组，每组腹腔注射3×10(2)绵羊红血球（SRBC）致敏。致敏前2天，各用药组分别给予北沙参多糖（GLP）5，50，200和800mg／kg。致敏后第4天颈椎脱臼处死小鼠，参照改良Jernes方法。剖取脾脏制备脾细胞悬液，进行脾脏溶血空斑形成细胞测定。结果以抑制率表示。共进行2批实验，4种剂量北沙参多糖均有抑制脾脏溶血空斑形成细胞的作用（P\u003c0.05）。另取G57BL小鼠30只，等分为5组，用药组分别致敏前后不同时间不同天数给北沙参多糖，每次剂量均为800mg／kg，对照组为生理盐水。于第4天测定脾脏溶血空斑形成细胞。结果以脾脏溶血空斑形成细胞数／10（2）脾细胞（X±SD，以下同）表示，对照组为654±65，d（10分钟）用药组为650±101，d-3，-2，d-1用药组为41±2（p\u003c0.01），d-3，-2，-1，0，1，2，3用药组为540±10（p\u003c0.01），第0，1，2，3天用药组为485±78（p\u003c0.05）。上述结果表明北沙参多糖于致敏前给药显着抑制脾脏溶血空斑形成细胞，致敏后给药脾脏溶血空斑形成细胞抑制作用减弱。"}]},{"ID":"20240616172128-b1f12pu","Type":"NodeParagraph","Properties":{"id":"20240616172128-b1f12pu","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"1.2.对小鼠血清凝集素效价的抑制作用：C57BL小鼠15只等分为5组，每组腹腔注射3×10（2）绵羊红血球致敏。用药组分别于d一1给北沙参多糖100，400，800和1000mg／kg，于第7天摘眼球取血，按文献方法测定血清凝集素效价，以抗体积数表示结果。表明4种剂量均有抑制小鼠血清凝集素效价的作用（P\u003c0.05）。"}]},{"ID":"20240616172128-ofl8s5g","Type":"NodeParagraph","Properties":{"id":"20240616172128-ofl8s5g","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"1.3.对2，4-二硝基氯苯所致小鼠耳迟发型超敏反应的抑制作用：取昆明种小鼠39只等分为3组，每鼠背部皮下注射7%2，4-二硝基氯苯0.02ml致敏。于d一1用药组分别给环磷酰胺（CY）50mg／kg与北沙参多糖500mg／kg，于第3天每鼠再次皮下注射7%2，4-二硝基氯苯0.02ml，于第4天用药组第二次给环磷酰胺50mg／kg与北沙参多糖500mg／kg。于第9天各鼠左耳涂7%2，4-二硝基氯苯0.02ml，第l0天用圆冲头将每鼠左右耳壳各冲下直径为9mm耳片一块。迟发型超敏反应程度以左耳肿胀度表示。结果表明，对照组的耳肿胀度为110.5±45.8%，环磷酰胺组为55.6±19.5%（P\u003c0.001）,北沙参多糖组为47.4±27.1%（P\u003c0.001），北沙参多糖组类同环磷酰胺可显着地抑制2，4-二硝基氯苯所致鼠耳迟发型超敏反应。"}]},{"ID":"20240616172128-tz3jmg6","Type":"NodeParagraph","Properties":{"id":"20240616172128-tz3jmg6","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"1.4.对正常人血淋巴细胞体外增生的作用：参照文献方法,用3例正常人肝素抗凝血全血测定北沙参多糖、醋酸氢化可的松（AHC）及人参多糖（GP）对由植物血凝素诱导的淋巴细胞体外增生的作用。实验结果表明，人参多糖对植物血凝素诱导的血淋巴细胞增生无明显作用，而醋酸氢化可的松则有显着抑制作用。各种浓度的北沙参多糖，除1例在400mg／ml无明显影响外，均有抑制作用，此外，北沙参多糖2000mg/ml对由植物血凝素（PHA），刀豆素（ConA）及美洲商陆分裂原（PWM）诱导的人血淋巴细胞增生均有抑制作用。以上结果提示，北沙参多糖对细胞免疫功能和T、B细胞的增生均有抑制作用。"}]},{"ID":"20240616172128-xap02kk","Type":"NodeParagraph","Properties":{"id":"20240616172128-xap02kk","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"2.解热镇痛作用：根的乙醇提取物能使正常家兔体温轻度下降，对伤寒疫苗引起发热的家兔也有降温作用。另外还有镇痛（兔牙髓电刺激法）。叶的乙醇提取物作用较差，根的挥发油更差。"}]},{"ID":"20240616172128-rswijvw","Type":"NodeParagraph","Properties":{"id":"20240616172128-rswijvw","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"3.对心血管作用：北沙参水浸液对离体蛙心低浓度加强收缩，高浓度抑制收缩直至心室停跳，但可恢复。对在体蛙心的作用与离体相似。麻醉兔静脉注射水浸液可使血压稍有上升，呼吸加强；切断迷走神经此作用仍存在。"}]},{"ID":"20240616172128-vqjppww","Type":"NodeParagraph","Properties":{"id":"20240616172128-vqjppww","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240616172128-qepkmeg","Type":"NodeParagraph","Properties":{"id":"20240616172128-qepkmeg","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 除去地上茎及须根，洗净泥土，放开水中烫后剥去外皮，晒干或烘干或拣去杂质，除去茎基，用水略洗，捞出，稍润，切段，晒干。"}]},{"ID":"20240616172128-7j4bs0b","Type":"NodeParagraph","Properties":{"id":"20240616172128-7j4bs0b","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616172128-fra319m","Type":"NodeParagraph","Properties":{"id":"20240616172128-fra319m","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 归肺；胃经"}]},{"ID":"20240616172128-2zmpccu","Type":"NodeParagraph","Properties":{"id":"20240616172128-2zmpccu","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616172128-4s4o047","Type":"NodeParagraph","Properties":{"id":"20240616172128-4s4o047","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 味甘；性凉"}]},{"ID":"20240616172128-rj1tlcf","Type":"NodeParagraph","Properties":{"id":"20240616172128-rj1tlcf","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240616172128-j034atn","Type":"NodeParagraph","Properties":{"id":"20240616172128-j034atn","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 风寒作嗽及肺胃虚寒者忌服。"}]},{"ID":"20240616172128-d7r7cwi","Type":"NodeParagraph","Properties":{"id":"20240616172128-d7r7cwi","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616172128-vvqxute","Type":"NodeParagraph","Properties":{"id":"20240616172128-vvqxute","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 养阴清肺；益胃生津。主肺燥干咳；虚劳嗽血；胃级不足；津伤口干"}]},{"ID":"20240616172128-qmmohv3","Type":"NodeParagraph","Properties":{"id":"20240616172128-qmmohv3","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616172128-10v6wfr","Type":"NodeParagraph","Properties":{"id":"20240616172128-10v6wfr","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g；或入丸、散、膏剂。"}]},{"ID":"20240616172128-4lngmp0","Type":"NodeParagraph","Properties":{"id":"20240616172128-4lngmp0","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240616172128-a88q0od","Type":"NodeParagraph","Properties":{"id":"20240616172128-a88q0od","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 一贯煎《柳州医话》"}]},{"ID":"20240616172128-p5fwukh","Type":"NodeParagraph","Properties":{"id":"20240616172128-p5fwukh","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240616172128-p6ydiqy","Type":"NodeParagraph","Properties":{"id":"20240616172128-p6ydiqy","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 1.《本草从新》：专补肺阴，清肺火，治久咳肺痿。"}]},{"ID":"20240616172128-0q762d5","Type":"NodeParagraph","Properties":{"id":"20240616172128-0q762d5","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"2.《饮片新参》：养肺胃阴，治劳咳痰血。"}]},{"ID":"20240616172128-s7s8lpk","Type":"NodeParagraph","Properties":{"id":"20240616172128-s7s8lpk","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"3.《东北药植志》：治慢性支气管炎，肺结核，肺膨胀不全，肺脓疡等。"}]},{"ID":"20240616172128-4fwibki","Type":"NodeParagraph","Properties":{"id":"20240616172128-4fwibki","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"4.《中药志》：养肺阴，清肺热，祛痰止咳。治虚劳发热，阴伤燥咳，口渴咽干。"}]},{"ID":"20240616172128-26szz2t","Type":"NodeParagraph","Properties":{"id":"20240616172128-26szz2t","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"5.《野生药植图说》：捣敷肿痛，可消肿、拔毒、生肌。"}]},{"ID":"20240616172128-huhvp7f","Type":"NodeParagraph","Properties":{"id":"20240616172128-huhvp7f","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616172128-8zivlhx","Type":"NodeParagraph","Properties":{"id":"20240616172128-8zivlhx","updated":"20240616172128"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240616172130-xwpmjck","Type":"NodeThematicBreak","Properties":{"id":"20240616172130-xwpmjck"}},{"ID":"20240616172131-b8x5ojb","Type":"NodeParagraph","Properties":{"id":"20240616172131-b8x5ojb"}}]}