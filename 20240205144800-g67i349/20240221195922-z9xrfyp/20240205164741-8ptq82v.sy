{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"百合 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/百合 18-20240814142944-hoiy6oo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"百合 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/百合 19-20240814143033-c5ps0wn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814134722-vyz7d1g","Type":"NodeParagraph","Properties":{"id":"20240814134722-vyz7d1g","updated":"20240814143046"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 468px;","style":"width: 458px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"百合 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/百合 15-20240814142310-zx7x77k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 458px;\" parent-style=\"width: 468px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240814140659-ux5y92d","Type":"NodeParagraph","Properties":{"id":"20240814140659-ux5y92d","updated":"20240814143943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：野百合的球茎有黄色、黄紫色、紫色，味微苦；菜百合球茎一般是白色的；"}]},{"ID":"20240814142551-zcb1f4v","Type":"NodeParagraph","Properties":{"id":"20240814142551-zcb1f4v","updated":"20240814143945"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：百合分"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"药百合"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（野百合）和"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"菜百合"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（食用百合），野百合偏苦，菜百合较甜食用口感好；"}]},{"ID":"20240611144047-se60v7a","Type":"NodeThematicBreak","Properties":{"id":"20240611144047-se60v7a"}},{"ID":"20240814143852-v8pqmgl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240814143852-v8pqmgl","updated":"20240814143857"},"Children":[{"Type":"NodeText","Data":"百合《神农本草经》"}]},{"ID":"20240814143839-pfljfz2","Type":"NodeParagraph","Properties":{"id":"20240814143839-pfljfz2","updated":"20240814143857"},"Children":[{"Type":"NodeText","Data":"味甘平。主邪气腹张心痛，利大小便，补中益气。生川谷。"}]},{"ID":"20240814143839-8tz7935","Type":"NodeParagraph","Properties":{"id":"20240814143839-8tz7935","updated":"20240814143857"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：百合一名重迈，一名中庭，生冠朐及荆山。（艺文类聚引云：一名重匡）"}]},{"ID":"20240814143839-k8w7d8o","Type":"NodeParagraph","Properties":{"id":"20240814143839-k8w7d8o","updated":"20240814143857"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名重箱，一名摩罗，一名中逢花，一名强瞿，生荆州，二月八月，采根，暴干。"}]},{"ID":"20240814143839-frmj6bf","Type":"NodeParagraph","Properties":{"id":"20240814143839-frmj6bf","updated":"20240814143857"},"Children":[{"Type":"NodeText","Data":"案玉篇云：蹯，百合蒜也。"}]},{"ID":"20240814143806-isoq73q","Type":"NodeThematicBreak","Properties":{"id":"20240814143806-isoq73q","updated":"20240814143857"}},{"ID":"20240611144107-0yetrna","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144107-0yetrna","updated":"20240611144112"},"Children":[{"Type":"NodeText","Data":"百合《本草述钩元》"}]},{"ID":"20240611144107-yg2ro6b","Type":"NodeParagraph","Properties":{"id":"20240611144107-yg2ro6b","updated":"20240611144107"},"Children":[{"Type":"NodeText","Data":"其根以众瓣合成。故名。类有三种。叶短而阔。微似竹叶。白花四垂者。百合也。叶而狭。尖如柳叶四月开红花。不四垂者。山丹也。茎叶似山丹而高。秋开红花带黄而四垂上有黑点。其子入夏先结在枝叶间者。卷丹也。"}]},{"ID":"20240611144107-fnbpjqx","Type":"NodeParagraph","Properties":{"id":"20240611144107-fnbpjqx","updated":"20240611144107"},"Children":[{"Type":"NodeText","Data":"味甘微苦。气平。入手太阴少阴。并入手阳明经。保肺止嗽。养五脏。补中气。渗利和中。"}]},{"ID":"20240611144107-4jn6kdi","Type":"NodeParagraph","Properties":{"id":"20240611144107-4jn6kdi","updated":"20240611144107"},"Children":[{"Type":"NodeText","Data":"气之故麦冬百部桑皮薏仁枇杷叶。治肺热咳嗽。及吐脓血。同麦冬白芍甘草木通。利大小便。同知母柴胡竹叶。治寒热邪气通身疼痛。同白芍炙草麦冬五味。补中益气。同白芍茯苓车前子桑白皮〔论〕百合之功在益气。而兼之利气。在养正而更能去邪。故李氏谓为渗利和中之美药。"}]},{"ID":"20240611144107-5lz939v","Type":"NodeParagraph","Properties":{"id":"20240611144107-5lz939v","updated":"20240611144107"},"Children":[{"Type":"NodeText","Data":"府精气不中寒者勿服。（仲淳）"}]},{"ID":"20240611144048-z609911","Type":"NodeThematicBreak","Properties":{"id":"20240611144048-z609911"}},{"ID":"20240611144058-2bwp0lk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144058-2bwp0lk","updated":"20240611144102"},"Children":[{"Type":"NodeText","Data":"百合《本草求真》"}]},{"ID":"20240611144058-ayulhpe","Type":"NodeParagraph","Properties":{"id":"20240611144058-ayulhpe","updated":"20240611144058"},"Children":[{"Type":"NodeText","Data":"（柔滑）清心肺余热"}]},{"ID":"20240611144058-fs5nq5p","Type":"NodeParagraph","Properties":{"id":"20240611144058-fs5nq5p","updated":"20240611144058"},"Children":[{"Type":"NodeText","Data":"百合（专入心肺）。甘淡微寒。功有利于肺心。而能敛气养心。安神定魄。（朱二允曰。百合之甘敛。胜于五味之酸收。）然究止属清邪除热利湿之品。因其气味稍缓。且于甘中有收。故于心肺最宜。而不致与血有碍耳。是以余热未靖。坐卧不安。咳嗽不已。（朱二允曰。久嗽之人。肺气必虚。虚则宜敛。）涕泪不收。（涕泪系肝肺之邪。有寒有热。当察其因。不可概作热治。但此专就余热言。经曰。肺为涕。肝为泪。心为汗。脾为涎。肾为唾。）胸浮气胀。状有鬼神。用此治其余孽。收其残虏。安养抚恤。恩威不骤。故能安享无事。岂非宁神益气之谓乎？仲景用此以治百合病症。义亦由此。但初嗽不宜遽用。花白者入药。"}]},{"ID":"20240611144048-weu9ged","Type":"NodeThematicBreak","Properties":{"id":"20240611144048-weu9ged"}},{"ID":"20240611144049-so800di","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144049-so800di","updated":"20240611144053"},"Children":[{"Type":"NodeText","Data":"百合《汤液本草》"}]},{"ID":"20240611144049-4c83rue","Type":"NodeParagraph","Properties":{"id":"20240611144049-4c83rue","updated":"20240611144049"},"Children":[{"Type":"NodeText","Data":"气平，味甘。无毒。"}]},{"ID":"20240611144049-chtogsi","Type":"NodeParagraph","Properties":{"id":"20240611144049-chtogsi","updated":"20240611144049"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主邪气腹胀心痛，利大小便，补中益气，除浮肿胪胀，痞满寒热，遍身疼痛，及乳难喉痹，止涕泪。"}]},{"ID":"20240611144049-2qlf6si","Type":"NodeParagraph","Properties":{"id":"20240611144049-2qlf6si","updated":"20240611144049"},"Children":[{"Type":"NodeText","Data":"仲景治百合病，百合知母汤、百合滑石代赭石汤，有百合鸡子汤、百合地黄汤。或百合病已经汗者，或未经汗下吐者，或病形如初，或病变寒热。并见《活人书》，治伤寒腹中疼，百合一两，炒黄为末。米饮调服。"}]},{"ID":"20240611144049-7gs05og","Type":"NodeParagraph","Properties":{"id":"20240611144049-7gs05og","updated":"20240611144049"},"Children":[{"Type":"NodeText","Data":"孙真人云∶治百合阴毒，煮百合浓汁，服一升。"}]},{"ID":"20240611144020-n5zl8uh","Type":"NodeThematicBreak","Properties":{"id":"20240611144020-n5zl8uh"}},{"ID":"20240611144038-lh8n66b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144038-lh8n66b","updated":"20240611144043"},"Children":[{"Type":"NodeText","Data":"百合《本草简要方》"}]},{"ID":"20240611144038-7q6h5ps","Type":"NodeParagraph","Properties":{"id":"20240611144038-7q6h5ps","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"主治补中。益气安心。定胆腹胀。心痛。止嗽。润肺。清热身肿。颠狂惊悸。香港脚。"}]},{"ID":"20240611144038-1bl4ad2","Type":"NodeParagraph","Properties":{"id":"20240611144038-1bl4ad2","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"痹。吐血。妇人产后血晕乳难乳痈。疗疮肿胁痈发背。百合地黄汤。百合七枚。生地汁一升。百合洗净浸一宿去水更以水二升煎取一升。去滓。纳生地汁煮取。一升五合。分温再服。"}]},{"ID":"20240611144038-m0eo7zd","Type":"NodeParagraph","Properties":{"id":"20240611144038-m0eo7zd","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"治百合病不经吐下发汗病形如初者。"}]},{"ID":"20240611144038-a59gj39","Type":"NodeParagraph","Properties":{"id":"20240611144038-a59gj39","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"百合知母汤。百合（擘）十枚。知母（切）三两。百合洗净浸一宿。换水二升煎取一升。"}]},{"ID":"20240611144038-fw8cb4a","Type":"NodeParagraph","Properties":{"id":"20240611144038-fw8cb4a","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"去滓。另以水二升煎知母取一升。去滓合煎取一升五合。分温再服。治百合病发汗后虚而不足。"}]},{"ID":"20240611144038-j2i9jts","Type":"NodeParagraph","Properties":{"id":"20240611144038-j2i9jts","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"百合固金丸。百合芍药（炒）当归贝母生草各一钱。生地二钱。熟地三钱。麦冬一钱五分。"}]},{"ID":"20240611144038-pvl5wft","Type":"NodeParagraph","Properties":{"id":"20240611144038-pvl5wft","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"玄。百合七枚。滑石三两。（碎绵裹）代赭石（一枚弹子大碎绵裹）洗净百合浸一宿。换水二升煎取一升。去滓。另以水二升煎二石取一升。去滓合煎取一升五合。温服五合。治百合病误下。又散方。百合（炙）一两。滑石三两。研末。每服方寸匕。米饮调下。日三次。治百合病发热微利止服。热则除。百合鸡子黄汤。百合七枚。（擘）鸡子黄一枚。如前法煮百合取升。"}]},{"ID":"20240611144038-o9feen2","Type":"NodeParagraph","Properties":{"id":"20240611144038-o9feen2","updated":"20240611144038"},"Children":[{"Type":"NodeText","Data":"纳鸡子黄搅匀。煎至五分温服。治百合病吐后胃不和。百合散。百合（蒸）紫草茸（洗）赤苓白芍桔梗（炒）前胡贝母各一钱五分。炙草五分。水二钟。加生姜五片。煎至一钟服风壅咳嗽痰多喘满。又方。百合黄柏各一钱。白芨二钱五分。蓖麻子五十粒。研饼贴。日三四次。治颐颏生疮。又方。百合川芎赤芍当归生地侧柏叶（炒）荆芩（炒）黄连栀子郁金大黄。水煎加童便和服。治打扑伤损。败血流入胃脘呕黑血汁。大便利者去大黄。百合汤。百合赤苓陈皮紫苏茎叶人参大腹皮猪苓桑根白皮枳壳（麸炒）麦冬炙草各一两。马兜铃七枚。粗捣。每服四钱。水一盏半。加生姜枣大一块。煎至气壅滞。咳嗽烦闷。脘膈不利。口渴。腰膝肿。小便淋涩。又方。百归白芍荆芥各二钱。水煎服。治呕吐。百合膏。百合一两朴硝杏仁桑钱。研末蜜丸黍米大。每服十丸。米饮下。量儿大小加减。能润肠去积。"}]},{"ID":"20240611144020-r5z4cnk","Type":"NodeThematicBreak","Properties":{"id":"20240611144020-r5z4cnk"}},{"ID":"20240611144022-e03jp2x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144022-e03jp2x","updated":"20240611144031"},"Children":[{"Type":"NodeText","Data":"百合《医宗金鉴》"}]},{"ID":"20240611144022-jx7mcuk","Type":"NodeParagraph","Properties":{"id":"20240611144022-jx7mcuk","updated":"20240611144027"},"Children":[{"Type":"NodeText","Data":"百合百脉合一病，如寒似热药无灵，饮食起居皆忽忽，如神若鬼附其形。脉数溺时辄头痛，溺时不痛淅淅风，溺时快然但头眩，六四二十病方宁。"}]},{"ID":"20240611144022-38kt5k6","Type":"NodeParagraph","Properties":{"id":"20240611144022-38kt5k6","updated":"20240611144022"},"Children":[{"Type":"NodeText","Data":"【注】百合病者，谓伤寒过期，留连不解，不分经络百脉，悉合为一病也。如寒似热，诸药无灵，欲饮不能饮，欲食不能食，欲卧不能卧，欲行不能行，精神忽忽，如神若鬼附其形体，而莫知所适从也。如脉数、溺尿时辄头痛者，六十日乃愈。若溺尿时头不痛，惟淅淅然恶风寒者，四十日乃愈。若溺时快然，但头眩者，二十日乃愈。故曰：六四二十日病方宁也。"}]},{"ID":"20240611144006-0kfjwp5","Type":"NodeThematicBreak","Properties":{"id":"20240611144006-0kfjwp5"}},{"ID":"20240611144007-8awvzx0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611144007-8awvzx0","updated":"20240611144012"},"Children":[{"Type":"NodeText","Data":"百合《得配本草》"}]},{"ID":"20240611144007-zoe0ksb","Type":"NodeParagraph","Properties":{"id":"20240611144007-zoe0ksb","updated":"20240611144007"},"Children":[{"Type":"NodeText","Data":"甘、苦、平。入手太阴及手少阴经。润肺宁心，清热止嗽，利二便，除浮肿，疗虚痞，退寒热，定惊悸，止涕泪，治伤寒百合病。（行住坐卧不定。）得川贝母，降肺气。配款冬花，治痰血。"}]},{"ID":"20240611144007-hsiqvy3","Type":"NodeParagraph","Properties":{"id":"20240611144007-hsiqvy3","updated":"20240611144007"},"Children":[{"Type":"NodeText","Data":"白花者入药。鲜者可煎可煮，干者作粉食，最益人。肠滑者禁用。多服伤脾气。（中气寒则下陷。）"}]},{"ID":"20240611143645-v38rcr4","Type":"NodeThematicBreak","Properties":{"id":"20240611143645-v38rcr4"}},{"ID":"20240611143953-gygubdd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143953-gygubdd","updated":"20240611144001"},"Children":[{"Type":"NodeText","Data":"百合《本草衍义》"}]},{"ID":"20240611143953-7mdctuo","Type":"NodeParagraph","Properties":{"id":"20240611143953-7mdctuo","updated":"20240611143953"},"Children":[{"Type":"NodeText","Data":"张仲景用治伤寒坏后百合病须此也。茎高三尺许，叶如大柳叶，四向攒枝而上。其颠即有淡黄白花，四垂向下覆，长蕊。花心有檀色，每一枝颠，须五六花。子紫色，圆如梧子，生于枝叶间。每叶一子，不在花中，此又异也。根即百合，其色白，其形如松子壳，四向攒生，中间出苗。"}]},{"ID":"20240611143823-cbtk6vx","Type":"NodeThematicBreak","Properties":{"id":"20240611143823-cbtk6vx"}},{"ID":"20240611143937-zujrog1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143937-zujrog1","updated":"20240611143946"},"Children":[{"Type":"NodeText","Data":"百合《本草便读》"}]},{"ID":"20240611143937-gfo686x","Type":"NodeParagraph","Properties":{"id":"20240611143937-gfo686x","updated":"20240611143937"},"Children":[{"Type":"NodeText","Data":"．利二便以益阴．化源无阻．（百合味甘平．微寒微苦．入心肺．功专补虚清热．其根以众瓣合成．有裹束之义．其质味甚浓．故能宁神定魄．肺热清则咳止肿消．二便清利矣．金匮百合病用之者．亦因病后余热留于肺部所致．故方中皆以百合为君也．）"}]},{"ID":"20240611143834-ht4zko4","Type":"NodeThematicBreak","Properties":{"id":"20240611143834-ht4zko4"}},{"ID":"20240611143925-p5vhq5b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143925-p5vhq5b","updated":"20240611143932"},"Children":[{"Type":"NodeText","Data":"百合《本经逢原》"}]},{"ID":"20240611143925-5omxm9h","Type":"NodeParagraph","Properties":{"id":"20240611143925-5omxm9h","updated":"20240611143925"},"Children":[{"Type":"NodeText","Data":"甘平无毒。白花者补脾肺，赤花者名山丹，散瘀血药用之。"}]},{"ID":"20240611143925-wj1c16y","Type":"NodeParagraph","Properties":{"id":"20240611143925-wj1c16y","updated":"20240611143925"},"Children":[{"Type":"NodeText","Data":"《本经》主邪气腹胀心痛，利大小便，补中益气。"}]},{"ID":"20240611143925-6qtmo6d","Type":"NodeParagraph","Properties":{"id":"20240611143925-6qtmo6d","updated":"20240611143925"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"百合能补土清金，止咳利小便，仲景百合病兼地黄用之，取其能消瘀血也。《本经》主邪气腹胀心痛，亦是散积蓄之邪，今世所昧也。其曰利大小便者，性专降泄耳。其曰补中益气者，邪热去而脾胃安矣。然性专降泄，中气虚寒、二便滑泄者忌之。红花者活血，治妇人崩中。其蕊敷疔肿恶疮，按中吴纪闻云，百合乃蚯蚓所化，此洵有之。余亲见包山土罅中有变化未全者，大略野生百合，蚓化有之。其清热解毒，散积消瘀，乃蚓之本性耳。"}]},{"ID":"20240611143847-7hu85y9","Type":"NodeThematicBreak","Properties":{"id":"20240611143847-7hu85y9"}},{"ID":"20240611143911-p0u9isn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143911-p0u9isn","updated":"20240611143916"},"Children":[{"Type":"NodeText","Data":"百合《本草新编》"}]},{"ID":"20240611143911-5yt2xcu","Type":"NodeParagraph","Properties":{"id":"20240611143911-5yt2xcu","updated":"20240611143911"},"Children":[{"Type":"NodeText","Data":"百合，味甘，气平，无毒。入肺、脾、心三经。安心益志，定惊悸狂叫之邪，消浮肿痞满之气，止遍身疼痛，利大小便，辟鬼气时疫，除咳逆，杀虫毒，治痈疽、乳肿、喉痹，又治伤寒坏症，兼能补中益气。此物和平，有解纷之功，扶持弱锄强，祛邪助正。但气味甚薄，必须重用，其功必倍，是百合可为君主，而又可为佐使者也，用之可至一二两。若止用数钱，安能定狂定痛，逐鬼消痈。倘用之安心益志，益气补中，当与参、术同施，又不必多用也。"}]},{"ID":"20240611143911-htgqawa","Type":"NodeParagraph","Properties":{"id":"20240611143911-htgqawa","updated":"20240611143911"},"Children":[{"Type":"NodeText","Data":"或问百合能止喘。百合非止喘之药也，但能消痞满耳。喘生于痞满，痞满消而喘胀除，故言痞满，而治喘在其中矣也。"}]},{"ID":"20240611143911-cvtktqq","Type":"NodeParagraph","Properties":{"id":"20240611143911-cvtktqq","updated":"20240611143911"},"Children":[{"Type":"NodeText","Data":"或问伤寒证中有百合病，特用百合为汤治之，而子何以不言耶？曰∶伤寒门中之百合病，即将成之坏证也。言坏症，而百合在其内矣。夫坏症何以用百合。正取其气味之和平，解各经之纷纭，即定各经之变乱也。百合有解纷之功，伤寒之变，然亦必须以他药佐之，未可全恃百合也。"}]},{"ID":"20240611143847-09gqsog","Type":"NodeThematicBreak","Properties":{"id":"20240611143847-09gqsog"}},{"ID":"20240611143901-721knyd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143901-721knyd","updated":"20240611143906"},"Children":[{"Type":"NodeText","Data":"百合《本草害利》"}]},{"ID":"20240611143901-j5n9sz2","Type":"NodeParagraph","Properties":{"id":"20240611143901-j5n9sz2","updated":"20240611143901"},"Children":[{"Type":"NodeText","Data":"〔害〕善通二便，中寒下陷者勿服。"}]},{"ID":"20240611143901-z02b7qp","Type":"NodeParagraph","Properties":{"id":"20240611143901-z02b7qp","updated":"20240611143901"},"Children":[{"Type":"NodeText","Data":"〔利〕甘微寒，保肺止咳，清心安精，又补大肠，肺与大肠相表里也。"}]},{"ID":"20240611143901-3qgsa7d","Type":"NodeParagraph","Properties":{"id":"20240611143901-3qgsa7d","updated":"20240611143901"},"Children":[{"Type":"NodeText","Data":"〔修治〕一茎直上，四向生叶，似短竹叶而阔，茎端五六月开大白花者佳。"}]},{"ID":"20240611143901-0ubth3k","Type":"NodeParagraph","Properties":{"id":"20240611143901-0ubth3k","updated":"20240611143901"},"Children":[{"Type":"NodeText","Data":"五月开红花者，名山丹，其根微苦，食之不甚良，是不及白花也。山丹者，主治疮肿惊邪，女人崩中。二月八月采根阴干，近道山谷处处有之。"}]},{"ID":"20240611143847-hzcqxg8","Type":"NodeThematicBreak","Properties":{"id":"20240611143847-hzcqxg8"}},{"ID":"20240611143848-jrkb9vx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143848-jrkb9vx","updated":"20240611143855"},"Children":[{"Type":"NodeText","Data":"百合《本草纲目》"}]},{"ID":"20240611143848-7i12nad","Type":"NodeParagraph","Properties":{"id":"20240611143848-7i12nad","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"「释名」藩、强瞿、蒜脑薯。"}]},{"ID":"20240611143848-3p65s4c","Type":"NodeParagraph","Properties":{"id":"20240611143848-3p65s4c","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"「气味」（根）甘、平、无毒。"}]},{"ID":"20240611143848-d9mpoux","Type":"NodeParagraph","Properties":{"id":"20240611143848-d9mpoux","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611143848-1ieeh7o","Type":"NodeParagraph","Properties":{"id":"20240611143848-1ieeh7o","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"1、面合病（伤寒病之后坐卧不安，神志不清，胡言乱语）。如已发汗用百合枚，水泡一夜，次日清晨以泉水煮取一升；另用知母三两，加水二程序煮取一升。百合汁、知母汁合在一起煮成一升半，分次服。此方名“百合知母汤”。如已吐过，则用百全七枚，水泡一夜，次日清晨以泉水二升煮取一升，加鸡蛋白一个，分两次服。此方名“百合鸡子汤”。如已泻过，则用百合七枚，水泡一夜，次日清晨以泉水二繁荣昌盛煮取一升；另用代赭石一两、滑石三两，加水二繁荣昌盛煮取一升，是百合汁一起再煮成一升半，分两次服。此方名“百合代赭汤”。如未经汗、吞、下，则用百合枚，水泡一领先，次日清晨以泉水二升煮取一升；另以生地黄汁一升，令两汁合煮成一升半，分两次服。此方名“百合地黄汤”。如病已变成消渴，则用百合一升在水一半中泡一夜，取汗温洗病人，洗毕，令病人吃白汤饼。如病已变成热症，则用百合一两、滑石三两，共研为末，水冲一匙，微泻即见药效。如病已变成腹满作痛，则用百合炒为末，每服一匙，水送下。一天服二次。"}]},{"ID":"20240611143848-8h9qzmz","Type":"NodeParagraph","Properties":{"id":"20240611143848-8h9qzmz","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"2、肺脏热。烦闷咳嗽。用新百合四两，加蜜蒸软，时时含一片吞津。"}]},{"ID":"20240611143848-qw484rh","Type":"NodeParagraph","Properties":{"id":"20240611143848-qw484rh","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"3、肺病吐血。用新百合捣汁，水送服。煮百合吃亦可。"}]},{"ID":"20240611143848-paabzug","Type":"NodeParagraph","Properties":{"id":"20240611143848-paabzug","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"4、风疹流走。用盐泥二两、百合半两、黄丹二钱、醋一分、唾液四分，捣和敷贴。"}]},{"ID":"20240611143848-0q930y4","Type":"NodeParagraph","Properties":{"id":"20240611143848-0q930y4","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"5、疮肿不穿。用野百合同盐捣泥敷涂。"}]},{"ID":"20240611143848-gfge0vk","Type":"NodeParagraph","Properties":{"id":"20240611143848-gfge0vk","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"6、天泡疮。用生百合捣涂，二日即安。或用百合花晒干为末，调菜油涂搽亦有效。"}]},{"ID":"20240611143848-hzklbdg","Type":"NodeParagraph","Properties":{"id":"20240611143848-hzklbdg","updated":"20240611143848"},"Children":[{"Type":"NodeText","Data":"7、肠风下血。有百合子，酒炒微赤，研为末，开水冲服。"}]},{"ID":"20240611143835-m16hdka","Type":"NodeThematicBreak","Properties":{"id":"20240611143835-m16hdka"}},{"ID":"20240611143836-uyotett","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143836-uyotett","updated":"20240611143841"},"Children":[{"Type":"NodeText","Data":"百合《名医别录》"}]},{"ID":"20240611143836-zvfn24h","Type":"NodeParagraph","Properties":{"id":"20240611143836-zvfn24h","updated":"20240611143836"},"Children":[{"Type":"NodeText","Data":"无毒．主除浮肿，胪胀，痞满，寒热，通身疼痛，及乳难喉痹肿，止涕泪．一名重一名重迈，一名摩罗，一名中逢花，一名强瞿．生荆州．二月、八月采根，曝干．"}]},{"ID":"20240611143836-60hy133","Type":"NodeParagraph","Properties":{"id":"20240611143836-60hy133","updated":"20240611143836"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶百合，味甘，平．主邪气腹张，心痛，利大小便，补中益气．生川谷．"}]},{"ID":"20240611143823-k0m1yr6","Type":"NodeThematicBreak","Properties":{"id":"20240611143823-k0m1yr6"}},{"ID":"20240611143824-ovbggy7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143824-ovbggy7","updated":"20240611143830"},"Children":[{"Type":"NodeText","Data":"百合《新修本草》"}]},{"ID":"20240611143824-8iomu7c","Type":"NodeParagraph","Properties":{"id":"20240611143824-8iomu7c","updated":"20240611143824"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主邪气腹胀，心痛，利大小便，补中益气。除浮肿，胪胀，痞满，寒热，通身疼痛，及乳难喉痹肿，止涕泪。一名重箱，一名重迈，一名摩罗，一名中逢花，一名强瞿。生荆州川谷。二月、八月采根，曝干。"}]},{"ID":"20240611143824-wg5tkiw","Type":"NodeParagraph","Properties":{"id":"20240611143824-wg5tkiw","updated":"20240611143824"},"Children":[{"Type":"NodeText","Data":"近道处处有，根如胡蒜，数十片相累，人亦蒸煮食之。乃言初是蚯蚓相缠结变作之，俗人皆呼为强仇，仇即瞿也，声之讹尔，亦堪服食。"}]},{"ID":"20240611143824-u4wjhjr","Type":"NodeParagraph","Properties":{"id":"20240611143824-u4wjhjr","updated":"20240611143824"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药有二种∶一种细叶，花红白色；一种叶大，茎长，根粗，花白，宜入药用。"}]},{"ID":"20240611143645-jfeceb0","Type":"NodeThematicBreak","Properties":{"id":"20240611143645-jfeceb0"}},{"ID":"20240611143811-6ohfhy3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143811-6ohfhy3","updated":"20240611143816"},"Children":[{"Type":"NodeText","Data":"百合《本草经解》"}]},{"ID":"20240611143811-i15ow67","Type":"NodeParagraph","Properties":{"id":"20240611143811-i15ow67","updated":"20240611143811"},"Children":[{"Type":"NodeText","Data":"气平．气甘．无毒．主邪气腹胀心痛．利大小便．补中益气．百合气平．禀天秋平之金气．入手太阴肺经．味甘无毒．得地中正之土味．入足太阴脾经．气降味和．阴也．肺主气．气逆则腹胀心痛．谓之邪者．盖非其位则为邪也．气平下降．所以主之．膀胱者州都之官．津液气化则出．肺主气．而与大肠为合．脾者又为胃行津液者也．百合甘平．平则气降．气化及于州都．则小便利．甘则脾润．脾行胃之津液．则大便利也．脾为中州．补中者味甘益脾也．肺主气．益气者气平肃肺也．"}]},{"ID":"20240611143811-6f071mo","Type":"NodeParagraph","Properties":{"id":"20240611143811-6f071mo","updated":"20240611143811"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611143811-75uie1d","Type":"NodeParagraph","Properties":{"id":"20240611143811-75uie1d","updated":"20240611143811"},"Children":[{"Type":"NodeText","Data":"百协议麦冬、白芍、甘草、木通．利大小便．同知母、柴胡、竹叶．治寒热邪气．通身疼痛．同麦冬、五味、白芍、甘草．补中益气．同白芍、白茯、车前、桑皮．治皮毛浮肿．"}]},{"ID":"20240611143645-b79k0de","Type":"NodeThematicBreak","Properties":{"id":"20240611143645-b79k0de"}},{"ID":"20240611143759-sdp0is4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143759-sdp0is4","updated":"20240611143806"},"Children":[{"Type":"NodeText","Data":"百合《本草崇原》"}]},{"ID":"20240611143759-ht9z1mg","Type":"NodeParagraph","Properties":{"id":"20240611143759-ht9z1mg","updated":"20240611143759"},"Children":[{"Type":"NodeText","Data":"气味甘平，无毒。主治邪气腹胀心痛，利大小便，补中益气。"}]},{"ID":"20240611143759-h32jk1v","Type":"NodeParagraph","Properties":{"id":"20240611143759-h32jk1v","updated":"20240611143759"},"Children":[{"Type":"NodeText","Data":"（百合近道山谷处处有之。三月生苗，高二三尺，一茎直上，叶如竹叶，又似柳叶，四向而生，五月茎端开白花，芬芳六出，四垂向下，昼开夜合，故名夜合花。其根如蒜，细白而长，重叠生二三十瓣。煮食甘美，取瓣分种，如种蒜法，一种花红不四垂者，山丹也。一种花红带黄而四垂，上有黑斑点，其子黑色，结在枝叶间者，卷丹也。其根皆同百合，皆可煮食，而味不美。盖一类三种，唯白花者入药，余不可用。）"}]},{"ID":"20240611143759-pmpji2z","Type":"NodeParagraph","Properties":{"id":"20240611143759-pmpji2z","updated":"20240611143759"},"Children":[{"Type":"NodeText","Data":"百合色白属金，味甘属土，昼开夜合，应天道之昼行于阳，夜行于阴，四向六合，应土气之达于四旁。主治邪气腹胀心痛者，邪气下乘于脾，则地气不升而腹胀。邪气上乘于肺，则天气不降而心痛。盖腹者脾之部，肺者心之盖也。利大小便者，脾气上升，肺气下降，则水津四布，糟粕营运矣。补中者，补脾。益气者，益肺也。"}]},{"ID":"20240611143646-q27to16","Type":"NodeThematicBreak","Properties":{"id":"20240611143646-q27to16"}},{"ID":"20240611143747-lyxdvec","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143747-lyxdvec","updated":"20240611143753"},"Children":[{"Type":"NodeText","Data":"百合《长沙药解》"}]},{"ID":"20240611143747-ymhsoit","Type":"NodeParagraph","Properties":{"id":"20240611143747-ymhsoit","updated":"20240611143747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味甘平。主邪气腹张心痛，利大小便，补中益气。生川谷。"}]},{"ID":"20240611143747-3so0bu4","Type":"NodeParagraph","Properties":{"id":"20240611143747-3so0bu4","updated":"20240611143747"},"Children":[{"Type":"NodeText","Data":"味甘、微苦，微寒，入手太阴肺经。凉金泻热，清肺除烦。"}]},{"ID":"20240611143747-fu1tw9v","Type":"NodeParagraph","Properties":{"id":"20240611143747-fu1tw9v","updated":"20240611143747"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合知母汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"百合七枚，知母二两。"},{"Type":"NodeText","Data":"治百合病，发汗后者。伤寒之后，邪气传变，百脉皆病，是为百合。其证眠食俱废，吐利皆作，寒热难分，坐卧不安，口苦便赤，心烦意乱，不能指其为何经何脏之病也。然百脉之气，受之于肺，肺者，百脉之宗也，是宜清肺。其在发汗之后者，津枯而金燔，百合清肺而生津，知母凉金而泻热也。"}]},{"ID":"20240611143747-l1wek2y","Type":"NodeParagraph","Properties":{"id":"20240611143747-l1wek2y","updated":"20240611143747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滑石代赭汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"百合七枚，滑石三两碎，代赭石如鸡子大。"},{"Type":"NodeText","Data":"治百合病，下之后者。下败中脘之阳，土湿胃逆，肺热郁蒸。百合清肺而泻热，滑石、代赭，渗湿而降逆也。"}]},{"ID":"20240611143747-8stoh1p","Type":"NodeParagraph","Properties":{"id":"20240611143747-8stoh1p","updated":"20240611143747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合鸡子汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"百合七枚，煎汤，入鸡子黄一枚，搅匀煎。"},{"Type":"NodeText","Data":"治百合病，吐之后者。吐伤肺胃之津，金土俱燥。百合清肺热而生津，鸡子黄补脾精而润燥也。"}]},{"ID":"20240611143747-k4bgq62","Type":"NodeParagraph","Properties":{"id":"20240611143747-k4bgq62","updated":"20240611143747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合地黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"百合七枚，生地黄汁一斤。入百合汤，煎服。大便当如漆。"},{"Type":"NodeText","Data":"治百合病，不经发汗、吐、下，病形如初者。不经发汗、吐、下，而瘀热淫蒸，败浊未泄。百合清肺而泻热，生地黄汁凉泻肠胃而下垢浊也。"}]},{"ID":"20240611143747-9rtkmg8","Type":"NodeParagraph","Properties":{"id":"20240611143747-9rtkmg8","updated":"20240611143747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合洗方"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"百合一斤，水一斗，渍一宿，洗身。洗后食煮饼，勿以盐。"},{"Type":"NodeText","Data":"治百合病，一月不解，变成渴者。火炎金燥，则肺热不解，变而为渴。肺主皮毛，百合洗皮毛，以清肺热也。"}]},{"ID":"20240611143747-756pfjq","Type":"NodeParagraph","Properties":{"id":"20240611143747-756pfjq","updated":"20240611143747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合滑石散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"百合一两，滑石二两。为散，饮服方寸匕，日三服。微利，止服，热则除。"},{"Type":"NodeText","Data":"治百合病，变发热者。湿动胃逆，肺郁生热。百合清金而泻热，滑石利水而除湿也。"}]},{"ID":"20240611143747-5ysqxmh","Type":"NodeParagraph","Properties":{"id":"20240611143747-5ysqxmh","updated":"20240611143747"},"Children":[{"Type":"NodeText","Data":"百合凉金润燥，泻热消郁，消肃气分之上品。其诸主治，收涕泪，止悲伤，开喉痹，通肺痈，清肺热，疗吐血，利小便，滑大肠，调耳聋、耳痛，理胁痈、乳痈、发背诸疮。"}]},{"ID":"20240611143747-chlwdrq","Type":"NodeParagraph","Properties":{"id":"20240611143747-chlwdrq","updated":"20240611143747"},"Children":[{"Type":"NodeText","Data":"水渍一宿，白沫出，去其水，更以泉水煎汤用。"}]},{"ID":"20240611143646-gu5tw93","Type":"NodeThematicBreak","Properties":{"id":"20240611143646-gu5tw93"}},{"ID":"20240611143647-il8anoi","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240611143647-il8anoi","updated":"20240611143657"},"Children":[{"Type":"NodeText","Data":"百合《中药学》"}]},{"ID":"20240611143647-fq1lgud","Type":"NodeParagraph","Properties":{"id":"20240611143647-fq1lgud","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为百合科植物百合等的肉质鳞片。"}]},{"ID":"20240611143647-bx9q1r6","Type":"NodeParagraph","Properties":{"id":"20240611143647-bx9q1r6","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，微寒。入心、肺经。"}]},{"ID":"20240611143647-ab7338f","Type":"NodeParagraph","Properties":{"id":"20240611143647-ab7338f","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【功效】润肺止咳，宁心安神。"}]},{"ID":"20240611143647-0tfxese","Type":"NodeParagraph","Properties":{"id":"20240611143647-0tfxese","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肺燥或肺热咳嗽等症。"}]},{"ID":"20240611143647-ywj3ng9","Type":"NodeParagraph","Properties":{"id":"20240611143647-ywj3ng9","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"本品甘寒，能清肺润燥，对肺燥或肺热咳嗽等症，常与麦冬、沙参、贝母、甘草等配合应用。"}]},{"ID":"20240611143647-y97aqfj","Type":"NodeParagraph","Properties":{"id":"20240611143647-y97aqfj","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"2.用于热病后余热未清，神思恍惚等症。"}]},{"ID":"20240611143647-3rblmln","Type":"NodeParagraph","Properties":{"id":"20240611143647-3rblmln","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"本品有宁心安神作用，用于热病后余热未清、神思恍惚之症，与知母、地黄等配合应用。"}]},{"ID":"20240611143647-d9bu5gy","Type":"NodeParagraph","Properties":{"id":"20240611143647-d9bu5gy","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【处方用名】百合、野百合（洗净，晒干用）。"}]},{"ID":"20240611143647-jc6sb2x","Type":"NodeParagraph","Properties":{"id":"20240611143647-jc6sb2x","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240611143647-9lx09dq","Type":"NodeParagraph","Properties":{"id":"20240611143647-9lx09dq","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【方剂举例】百合知母汤《金匮要略》：百合、知母。治百合病。"}]},{"ID":"20240611143647-0yz4rrn","Type":"NodeParagraph","Properties":{"id":"20240611143647-0yz4rrn","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"百合固金丸（录自《医方集解》）：生地、熟地、麦冬、贝母、百合、当归，芍药、甘草、玄参、桔梗。治肺伤咽痛，咳喘痰血。"}]},{"ID":"20240611143647-1oi5lqw","Type":"NodeParagraph","Properties":{"id":"20240611143647-1oi5lqw","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"【文献搞录】《本经》：「邪气腹胀心病，利大小便，补中益气。」"}]},{"ID":"20240611143647-8mfhlec","Type":"NodeParagraph","Properties":{"id":"20240611143647-8mfhlec","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"《别录》：「除浮肿胪胀，痞满寒热，通身疼痛，及乳难喉痹，止涕泪。」"}]},{"ID":"20240611143647-kuhwkir","Type":"NodeParagraph","Properties":{"id":"20240611143647-kuhwkir","updated":"20240611143647"},"Children":[{"Type":"NodeText","Data":"《大明本草》：「安心定胆，益志养五脏。」"}]},{"ID":"20240611143612-dsdj2fo","Type":"NodeThematicBreak","Properties":{"id":"20240611143612-dsdj2fo"}},{"ID":"20240611143621-mfwt1wg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143621-mfwt1wg","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"《中国药典》：百合"}]},{"ID":"20240611143621-gl6dkap","Type":"NodeParagraph","Properties":{"id":"20240611143621-gl6dkap","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611143621-hrpnaze","Type":"NodeParagraph","Properties":{"id":"20240611143621-hrpnaze","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" Bǎi Hé"}]},{"ID":"20240611143621-p87c62o","Type":"NodeParagraph","Properties":{"id":"20240611143621-p87c62o","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611143621-uvi2amq","Type":"NodeParagraph","Properties":{"id":"20240611143621-uvi2amq","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 野百合、喇叭筒、山百合、药百合、家百合"}]},{"ID":"20240611143621-2et3bld","Type":"NodeParagraph","Properties":{"id":"20240611143621-2et3bld","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611143621-abskzt4","Type":"NodeParagraph","Properties":{"id":"20240611143621-abskzt4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" BULBUS LILII"}]},{"ID":"20240611143621-75nt4fa","Type":"NodeParagraph","Properties":{"id":"20240611143621-75nt4fa","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611143621-9gfdrwu","Type":"NodeParagraph","Properties":{"id":"20240611143621-9gfdrwu","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 本品为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"卷丹"},{"Type":"NodeText","Data":"Lilium lancifolium Thunb.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合"},{"Type":"NodeText","Data":"Lilium brownii F.E.Brown var. viridulum Baker 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"细叶百合"},{"Type":"NodeText","Data":"Lilium pumilum DC. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉质鳞叶"},{"Type":"NodeText","Data":"。秋季采挖，洗净，剥取鳞叶，置沸水中略烫，干燥。"}]},{"ID":"20240611143621-yvcpksy","Type":"NodeParagraph","Properties":{"id":"20240611143621-yvcpksy","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611143621-il9mxoo","Type":"NodeParagraph","Properties":{"id":"20240611143621-il9mxoo","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 本品呈长椭圆形，长2～5cm，宽1～2cm，中部厚1.3～4mm。表面类白色、淡棕黄色或微带紫色，有数条纵直平行的白色维管束。顶端稍尖，基部较宽，边缘薄，微波状，略向内弯曲。质硬而脆，断面较平坦，角质样。无臭，味微苦。"}]},{"ID":"20240611143621-xo8nqmc","Type":"NodeParagraph","Properties":{"id":"20240611143621-xo8nqmc","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611143621-h44488n","Type":"NodeParagraph","Properties":{"id":"20240611143621-h44488n","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜜百合"},{"Type":"NodeText","Data":"：取净百合，照蜜炙法（附录Ⅱ D）炒至不粘手。每100kg百合，用炼蜜 5kg。"}]},{"ID":"20240611143621-1oigguk","Type":"NodeParagraph","Properties":{"id":"20240611143621-1oigguk","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611143621-1ud2ton","Type":"NodeParagraph","Properties":{"id":"20240611143621-1ud2ton","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 取本品粗粉3g，加90％酸性乙醇（用稀硫酸调节pH值至2～3）50ml，加热回流1小时，滤过，滤液蒸至近干，加水30ml，加热使溶解，放冷，滴加氢氧化钠试液调节pH值至9～10，用氯仿振摇提取4次，每次15ml，合并氯仿液，加适量无水硫酸钠搅拌滤过，滤液蒸干，残渣加氯仿0.5ml使溶解，作为供试品溶液。另取百合对照药材1g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液15μl、对照药材溶液10μl,分别点于同一硅胶GF\u003c[254]\u003e薄层板上，以氯仿-甲醇-醋酸乙酯（22:5:6）为展开剂，置氨蒸气预饱和的展开缸内，展开，取出，晾干，置紫外光灯（254nm）下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611143621-3p8g52z","Type":"NodeParagraph","Properties":{"id":"20240611143621-3p8g52z","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611143621-tmdi18b","Type":"NodeParagraph","Properties":{"id":"20240611143621-tmdi18b","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 归心、肺经。"}]},{"ID":"20240611143621-hu98k4x","Type":"NodeParagraph","Properties":{"id":"20240611143621-hu98k4x","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611143621-d3tgoth","Type":"NodeParagraph","Properties":{"id":"20240611143621-d3tgoth","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240611143621-wi4p5bt","Type":"NodeParagraph","Properties":{"id":"20240611143621-wi4p5bt","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611143621-m0ydfw2","Type":"NodeParagraph","Properties":{"id":"20240611143621-m0ydfw2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 养阴润肺，清心安神。用于阴虚久咳，痰中带血，虚烦惊悸，失眠多梦，精神恍惚。"}]},{"ID":"20240611143621-i1q4aja","Type":"NodeParagraph","Properties":{"id":"20240611143621-i1q4aja","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611143621-tn0sfcg","Type":"NodeParagraph","Properties":{"id":"20240611143621-tn0sfcg","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240611143621-eecobea","Type":"NodeParagraph","Properties":{"id":"20240611143621-eecobea","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611143621-3e4hlsc","Type":"NodeParagraph","Properties":{"id":"20240611143621-3e4hlsc","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611143621-212g7i5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143621-212g7i5","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：百合"}]},{"ID":"20240611143621-5k0l2y9","Type":"NodeParagraph","Properties":{"id":"20240611143621-5k0l2y9","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611143621-z2lwvff","Type":"NodeParagraph","Properties":{"id":"20240611143621-z2lwvff","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" Bǎi Hé"}]},{"ID":"20240611143621-sxzg1br","Type":"NodeParagraph","Properties":{"id":"20240611143621-sxzg1br","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611143621-2zu8fpe","Type":"NodeParagraph","Properties":{"id":"20240611143621-2zu8fpe","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 白百合（《日华子本草》），蒜脑薯（《纲目》）。"}]},{"ID":"20240611143621-3rqgrps","Type":"NodeParagraph","Properties":{"id":"20240611143621-3rqgrps","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611143621-9q0sl88","Type":"NodeParagraph","Properties":{"id":"20240611143621-9q0sl88","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611143621-7qqbkrg","Type":"NodeParagraph","Properties":{"id":"20240611143621-7qqbkrg","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611143621-tn0g964","Type":"NodeParagraph","Properties":{"id":"20240611143621-tn0g964","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"百合"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"细叶百合"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麝香百合"},{"Type":"NodeText","Data":"及其同属多种植物鳞茎的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳞叶"},{"Type":"NodeText","Data":"。秋、冬采挖，除去地上部分，洗净泥土，剥取鳞片，用沸水捞过或微蒸后，焙干或晒干。"}]},{"ID":"20240611143621-gnklysa","Type":"NodeParagraph","Properties":{"id":"20240611143621-gnklysa","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611143621-biaslwb","Type":"NodeParagraph","Properties":{"id":"20240611143621-biaslwb","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" ①百合，又名：重迈、中庭（《吴普本草》），重箱、摩罗、强瞿、中逢花（《别录》），强仇（陶弘景），百合蒜（《玉篇》），夜合花（《本草崇原》）。白花百合（《救生苦海》）。"}]},{"ID":"20240611143621-vqih4k4","Type":"NodeParagraph","Properties":{"id":"20240611143621-vqih4k4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60～lOO厘米。鳞茎球状，白色，肉质，先端常开放如荷花状，长3.5～5厘米，直径3～4厘米，下面着生多数须根。茎直立，圆柱形，常有褐紫色斑点。叶4～5列互生；无柄；叶片线状披针形至长椭圆状披针形，长4.5～10厘米，宽8～20毫米，先端渐尖，基部渐狭，全缘或微波状，叶脉5条，平行。花大，单生于茎顶，少有1朵以上者；花梗长达。3～10厘米；花被6片，乳白色或带淡棕色，倒卵形；雄蕊6，花药线形，丁字着生；雌蕊1，子房圆柱形，3室，每室有多数胚珠，柱头膨大，盾状。蒴果长卵圆形，室间开裂，绿色；种子多数。花期6～8月。果期9月。"}]},{"ID":"20240611143621-euo9wmn","Type":"NodeParagraph","Properties":{"id":"20240611143621-euo9wmn","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"生长于土壤深肥的林边或草丛中。分布几遍全国，大部地区有栽培。"}]},{"ID":"20240611143621-y1az4zt","Type":"NodeParagraph","Properties":{"id":"20240611143621-y1az4zt","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"本植物的花（百合花）、种子（百合子）亦供药用，各详专条。"}]},{"ID":"20240611143621-v8k6so8","Type":"NodeParagraph","Properties":{"id":"20240611143621-v8k6so8","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"②细叶百合，又名：线叶百合、卷莲花、灯伞花、散莲伞."}]},{"ID":"20240611143621-qsmujpt","Type":"NodeParagraph","Properties":{"id":"20240611143621-qsmujpt","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"多年生草本，高20～60厘米.鳞茎广椭圆形，长2.5～4厘米，直径1.5～3厘米。茎细，圆柱形，绿色。叶3～5列互生，至茎顶渐少而小；无柄；叶片窄线形，长3～14厘米，宽1～3毫米，先端锐尖，基部渐狭。花单生于茎顶，或在茎顶叶腋间各生一花，成总状花序状，俯垂；花梗粗壮，长6厘米左右；花被6片，红色，向外反卷；雄蕊6，短于花被；雌蕊1，子房细长，先端平截，花柱细长，先端扩展，柱头浅裂。蒴果椭圆形，长2～3厘米。花期6～8月。果期8～9月。"}]},{"ID":"20240611143621-nbkhs9n","Type":"NodeParagraph","Properties":{"id":"20240611143621-nbkhs9n","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"生长于山坡林下及山地岩石间。分布黑龙江、吉林、辽宁、河北、河南、山东、山西、陕西、甘肃、青海、内蒙古等地。"}]},{"ID":"20240611143621-0yvtoz5","Type":"NodeParagraph","Properties":{"id":"20240611143621-0yvtoz5","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"③麝香百合（《汝南圃史》），又名：岩百合，红岩百合。"}]},{"ID":"20240611143621-0jjuwsq","Type":"NodeParagraph","Properties":{"id":"20240611143621-0jjuwsq","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"多年生草本，高约50～100厘米，鳞茎近球形，径约5厘米。茎直立，基部淡红色。叶披针形或狭长椭圆形，长10～15厘米，宽5～15毫米，先端渐尖或锐尖。花顶生，2～3朵，平生或稍下弯；喇叭状，纯白色，基部染成绿色；花被6片，倒卵形或倒披针形，上方稍有反曲；雄蕊6；雌蕊1，花柱细长，上部弯曲，柱头头状。蒴果长椭圆形。花期初夏。"}]},{"ID":"20240611143621-vm4057s","Type":"NodeParagraph","Properties":{"id":"20240611143621-vm4057s","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"栽培或野生。分布贵州、广东等地。"}]},{"ID":"20240611143621-ach1t2t","Type":"NodeParagraph","Properties":{"id":"20240611143621-ach1t2t","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611143621-x1m8hvq","Type":"NodeParagraph","Properties":{"id":"20240611143621-x1m8hvq","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 干燥的鳞叶，呈长椭圆形，披针形或长三角形，长约2～4厘米，宽约0.5～1.5厘米，肉质肥厚，中心较厚，边缘薄而成波状，或向内卷曲，表面乳白色或淡黄棕色，光滑细腻，略有光泽，瓣内有数条平行纵走的白色维管束。质坚硬而稍脆，折断面较平整，黄白色似蜡样。气微，味微苦。以瓣匀肉厚、色黄白、质坚、筋少者为佳。"}]},{"ID":"20240611143621-42ja4mo","Type":"NodeParagraph","Properties":{"id":"20240611143621-42ja4mo","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"药用百合有家种与野生之分，家种的鳞片阔而薄，味不甚苦；野生的鳞片小而厚，味较苦。"}]},{"ID":"20240611143621-2lkkqys","Type":"NodeParagraph","Properties":{"id":"20240611143621-2lkkqys","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611143621-a6x00xk","Type":"NodeParagraph","Properties":{"id":"20240611143621-a6x00xk","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240611143621-ffds7jc","Type":"NodeParagraph","Properties":{"id":"20240611143621-ffds7jc","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611143621-c0lmzjo","Type":"NodeParagraph","Properties":{"id":"20240611143621-c0lmzjo","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 百合鳞茎含秋水仙碱等多种生物碱及淀粉、蛋白质、脂肪等。麝香百合的花药含有多种类胡萝卜素，其中大部分是顺花药黄质酯，占91.7～94％ 。卷丹的花药含水分2.68％，灰分4.17％，蛋白质21.29％，脂肪12.43％，淀粉3.61％，还元糖11.47％，维生素B1_443微克％，B2_1829微克％，泛酸306微克％，维生素C 21.2毫克％，并含β-胡萝卜素等。"}]},{"ID":"20240611143621-hy25h23","Type":"NodeParagraph","Properties":{"id":"20240611143621-hy25h23","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611143621-45jn8nz","Type":"NodeParagraph","Properties":{"id":"20240611143621-45jn8nz","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 百合煎剂对氨水引起的小鼠咳嗽有止咳作用，小白鼠肺灌流使流量增加，并能对抗组织胺引起的蟾蜍哮喘。"}]},{"ID":"20240611143621-tp17i08","Type":"NodeParagraph","Properties":{"id":"20240611143621-tp17i08","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611143621-qiuc0vj","Type":"NodeParagraph","Properties":{"id":"20240611143621-qiuc0vj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 百合：拣去杂质、黑瓣，簸除灰屑。蜜百合：取净百合，加炼熟的蜂蜜（百合100斤用炼蜜6斤4两）与开水适量。拌匀，稍闷，置锅内用文火炒至黄色不沾手为度，取出，放凉。"}]},{"ID":"20240611143621-nba1d54","Type":"NodeParagraph","Properties":{"id":"20240611143621-nba1d54","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"《品汇精要》：\"百合，蒸熟用。\""}]},{"ID":"20240611143621-kmc77w7","Type":"NodeParagraph","Properties":{"id":"20240611143621-kmc77w7","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611143621-tx64602","Type":"NodeParagraph","Properties":{"id":"20240611143621-tx64602","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 入心、肺经。"}]},{"ID":"20240611143621-az0sdsy","Type":"NodeParagraph","Properties":{"id":"20240611143621-az0sdsy","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入心肺、大、小肠四经。\""}]},{"ID":"20240611143621-jbe0vek","Type":"NodeParagraph","Properties":{"id":"20240611143621-jbe0vek","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手足太阴，手足厥阴，手足阳明经。\""}]},{"ID":"20240611143621-8g7i595","Type":"NodeParagraph","Properties":{"id":"20240611143621-8g7i595","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"入肺、心、胆三经。\""}]},{"ID":"20240611143621-amj845m","Type":"NodeParagraph","Properties":{"id":"20240611143621-amj845m","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611143621-hpb6wi9","Type":"NodeParagraph","Properties":{"id":"20240611143621-hpb6wi9","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 甘微苦，平。"}]},{"ID":"20240611143621-av09rnn","Type":"NodeParagraph","Properties":{"id":"20240611143621-av09rnn","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"①《本经）：\"味甘，平。\""}]},{"ID":"20240611143621-qkqd0d3","Type":"NodeParagraph","Properties":{"id":"20240611143621-qkqd0d3","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611143621-dw2yjir","Type":"NodeParagraph","Properties":{"id":"20240611143621-dw2yjir","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"③《救荒本草》：\"味甘辛，平。\""}]},{"ID":"20240611143621-1l3l015","Type":"NodeParagraph","Properties":{"id":"20240611143621-1l3l015","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"④《长沙药解》：\"味甘微苦，微寒。\""}]},{"ID":"20240611143621-lf88wfp","Type":"NodeParagraph","Properties":{"id":"20240611143621-lf88wfp","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611143621-dth1ata","Type":"NodeParagraph","Properties":{"id":"20240611143621-dth1ata","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 风寒痰嗽，中寒便滑者忌服。"}]},{"ID":"20240611143621-uzqfpmf","Type":"NodeParagraph","Properties":{"id":"20240611143621-uzqfpmf","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"①《本经逢原》：\"中气虚寒，二便滑泄者忌之。\""}]},{"ID":"20240611143621-wh8834g","Type":"NodeParagraph","Properties":{"id":"20240611143621-wh8834g","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"初嗽不宜遽用。\""}]},{"ID":"20240611143621-3804njs","Type":"NodeParagraph","Properties":{"id":"20240611143621-3804njs","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611143621-hze99vj","Type":"NodeParagraph","Properties":{"id":"20240611143621-hze99vj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 润肺止咳，清心安神。治肺费久嗽，咳唾痰血；热病后余热来清，虚烦惊悸，神志恍惚；脚气浮肿。（1）润肺止咳：用于肺燥或阴虚之咳嗽、咯血，常配川贝。（2）清心安神：用于热性病后余热不清、虚烦不眠、神志恍惚，常配地黄。"}]},{"ID":"20240611143621-v4hb4tw","Type":"NodeParagraph","Properties":{"id":"20240611143621-v4hb4tw","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主邪气腹胀、心痛。利大小便，补中益气。\""}]},{"ID":"20240611143621-3njislv","Type":"NodeParagraph","Properties":{"id":"20240611143621-3njislv","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除浮肿胪胀，痞满，寒热，通身疼痛，及乳难。喉痹，止涕泪。’"}]},{"ID":"20240611143621-hhfuvys","Type":"NodeParagraph","Properties":{"id":"20240611143621-hhfuvys","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"除心下急、满、痛，治脚气，热咳逆。\""}]},{"ID":"20240611143621-7j644nb","Type":"NodeParagraph","Properties":{"id":"20240611143621-7j644nb","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"④《食疗本草》：\"主心急黄。\""}]},{"ID":"20240611143621-rht0bn6","Type":"NodeParagraph","Properties":{"id":"20240611143621-rht0bn6","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"安心，定胆，益志，养五脏。治癫邪啼泣、狂叫，惊悸，杀蛊毒气，熁乳痈、发背及诸疮肿，并治产后血狂运。\""}]},{"ID":"20240611143621-vbqp20y","Type":"NodeParagraph","Properties":{"id":"20240611143621-vbqp20y","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑥《本草衍义》：\"治伤寒坏后百合病。\""}]},{"ID":"20240611143621-zj533ha","Type":"NodeParagraph","Properties":{"id":"20240611143621-zj533ha","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑦《本草蒙筌》：\"除时疫咳逆。\""}]},{"ID":"20240611143621-39eu968","Type":"NodeParagraph","Properties":{"id":"20240611143621-39eu968","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑧《医学入门》：\"治肺痿，肺痈。\""}]},{"ID":"20240611143621-tfo89mz","Type":"NodeParagraph","Properties":{"id":"20240611143621-tfo89mz","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑨《纲目拾遗》：\"清痰火，补虚损。\""}]},{"ID":"20240611143621-jiiaxnu","Type":"NodeParagraph","Properties":{"id":"20240611143621-jiiaxnu","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑩《上海常用中草药》：\"治肺热咳嗽，干咳久咳，热病后虚热，烦躁不安。\""}]},{"ID":"20240611143621-k2ylrbd","Type":"NodeParagraph","Properties":{"id":"20240611143621-k2ylrbd","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611143621-0elsskd","Type":"NodeParagraph","Properties":{"id":"20240611143621-0elsskd","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.3～1两；蒸食或煮粥食。外用：捣敷。"}]},{"ID":"20240611143621-z73hkyu","Type":"NodeParagraph","Properties":{"id":"20240611143621-z73hkyu","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611143621-4lr6dlj","Type":"NodeParagraph","Properties":{"id":"20240611143621-4lr6dlj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" ①治咳嗽不巳，或痰中有血：款冬花、百合（焙，蒸）等分。上为细末，炼蜜为丸，如龙眼大。每服-丸，食后临卧细嚼，姜汤咽下，噙化尤佳。（《济生方》百花膏）"}]},{"ID":"20240611143621-mq7hvk1","Type":"NodeParagraph","Properties":{"id":"20240611143621-mq7hvk1","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"②治支气管扩张、咯血：百合二两，白及四两，蛤粉二两，百部一两。共为细末，炼蜜为丸，每重二钱，每次一丸，日三次。（《新疆中草药手册》）"}]},{"ID":"20240611143621-a8exsea","Type":"NodeParagraph","Properties":{"id":"20240611143621-a8exsea","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"③治肺病吐血：新百合捣汁，和水坎之，亦可煮食。（《卫生易简方》）"}]},{"ID":"20240611143621-a3hfeka","Type":"NodeParagraph","Properties":{"id":"20240611143621-a3hfeka","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"④治背心前胸肺慕间热，咳嗽咽痛，咯血，恶寒，手大拇指循白肉际间上肩背至胸前如火烙：熟地、生地、归身各三钱，白芍、甘草各一钱，桔梗、元参备八分，贝母、麦冬、百合各钱半。如咳嗽，初一、二服，加五味子二十粒。（《慎斋遗书》百合固金汤）"}]},{"ID":"20240611143621-q73iyvo","Type":"NodeParagraph","Properties":{"id":"20240611143621-q73iyvo","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑤治肺脏壅热烦闷：新百合四两，用蜜半叠，拌和百合，蒸令软，时时含如枣大，咽津。（《圣惠方》）"}]},{"ID":"20240611143621-3f1eb4g","Type":"NodeParagraph","Properties":{"id":"20240611143621-3f1eb4g","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑥治百合病发汗后者：百合七枚（擘），知母三两（切）。上先以水洗百合，渍一宿，当白沫出，去其水，更以泉水二升，煎取一升，去渣；别以泉水二升煎知母，取一升，去渣后，合和煎取一升五合，分温再服。（百合知母汤）"}]},{"ID":"20240611143621-rg77sy3","Type":"NodeParagraph","Properties":{"id":"20240611143621-rg77sy3","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑦治百合病吐之后者：百合七枚（擘），鸡子黄一枚。上先以水洗百合，渍一宿，当白沫出，去其水，更以泉水二升，煎取-升，去渣，内鸡子黄，搅匀，煎五分，温服。（百合鸡子汤）"}]},{"ID":"20240611143621-42oi1uq","Type":"NodeParagraph","Properties":{"id":"20240611143621-42oi1uq","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑧治百合病下之后者：百合七枚（擘），滑石三两（碎，绵裹），代赭石如弹丸大一枚（碎，绵裹）。上先以水洗百合，渍一宿，当白沫出，去其水，更以泉水二升，煎取-升，去渣；别以泉水二升煎滑石、代赭取-升，去渣后，合和重煎，取-升五合，分温服。（滑石代赭汤）"}]},{"ID":"20240611143621-tfrod95","Type":"NodeParagraph","Properties":{"id":"20240611143621-tfrod95","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑨治百合病不经吐下发汗，病形如初者：百合七枚（擘），生地黄汁一升。上以水洗百合，渍一宿，当白沫出，去其水，更以泉水二升煎取-升，去渣，内地黄汁煎取一升五合，分温再服，中病勿更服，大便当如漆。（百合地黄汤）"}]},{"ID":"20240611143621-21n5b4y","Type":"NodeParagraph","Properties":{"id":"20240611143621-21n5b4y","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑩治百合病变发热者：百合一两（炙），滑石三两。上为散，饮服方寸匕，日三服，当微利者止服，热则除。（百合滑石散。⑥方以下出《金匮要略》）"}]},{"ID":"20240611143621-89azkoh","Type":"NodeParagraph","Properties":{"id":"20240611143621-89azkoh","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑾治神经衰弱，心烦失眠，百合五钱，酸枣仁五钱，远志三钱。水煎服。（《新疆中草药手册》）"}]},{"ID":"20240611143621-pdx5g0s","Type":"NodeParagraph","Properties":{"id":"20240611143621-pdx5g0s","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⑿治肺痈：白花百合，或煮或蒸，频食。拌蜜蒸更好。（《经验广集》百合煎）"}]},{"ID":"20240611143621-tldzp6z","Type":"NodeParagraph","Properties":{"id":"20240611143621-tldzp6z","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒀治疮肿不穿：野百合同盐捣泥敷之良。（《包会应验方》）"}]},{"ID":"20240611143621-gmu3v0q","Type":"NodeParagraph","Properties":{"id":"20240611143621-gmu3v0q","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒁治天疱湿疮：生百合捣涂，一、二日即安。（《濒湖集简方》）"}]},{"ID":"20240611143621-df32xyh","Type":"NodeParagraph","Properties":{"id":"20240611143621-df32xyh","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒂治耳聋、耳痛：干百合为末，温水服二钱，日二服。（《千金方》）"}]},{"ID":"20240611143621-vb6y2i2","Type":"NodeParagraph","Properties":{"id":"20240611143621-vb6y2i2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒃鲜百合汁：鲜百合三个，取汁用温开水冲服，早晚各一次，可治肺结核之咯血，慢性支气管炎伴有肺气肿。"}]},{"ID":"20240611143621-ek88tu8","Type":"NodeParagraph","Properties":{"id":"20240611143621-ek88tu8","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒄百花煎：百合30克，冬花15克，水煎服，可治肺热咳嗽，咽干口渴。"}]},{"ID":"20240611143621-qi074xx","Type":"NodeParagraph","Properties":{"id":"20240611143621-qi074xx","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒅百合知母汤：百合30克，知母15克，水煎服，可用热性病后期的各种症状。"}]},{"ID":"20240611143621-w3gyqkf","Type":"NodeParagraph","Properties":{"id":"20240611143621-w3gyqkf","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒆百合汤：百合30克，鸟药10克，水煎服，可治日久不愈的胃痛。"}]},{"ID":"20240611143621-bgzmkuc","Type":"NodeParagraph","Properties":{"id":"20240611143621-bgzmkuc","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"⒇百合50克，北沙参15克，冰糖15克，水煎服。可治干咳，口干咽燥。"}]},{"ID":"20240611143621-aiebooh","Type":"NodeParagraph","Properties":{"id":"20240611143621-aiebooh","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（21）百合、莲藕节各20克，水煎，汤水冲入白芨粉10克服下，可治肺阴虚有热引起的咳血。"}]},{"ID":"20240611143621-a3yqbs4","Type":"NodeParagraph","Properties":{"id":"20240611143621-a3yqbs4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（22）百合15克，麦冬10克，五味子10克，冬虫夏草10克，川贝6克，水煎服，每日一剂，可治咳喘，痰少，咽干，气短乏力等症。"}]},{"ID":"20240611143621-kivhvrj","Type":"NodeParagraph","Properties":{"id":"20240611143621-kivhvrj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（23）百合30克，北沙参15克（亦可加冬花10克），冰糖15克，水煎服，每日一剂，可治干咳痰少，口干咽燥。"}]},{"ID":"20240611143621-fwps3e0","Type":"NodeParagraph","Properties":{"id":"20240611143621-fwps3e0","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（24）百合蜜：百合100克，蜂蜜50克拌匀蒸熟，于睡前食用。适用于神经衰弱，睡眠欠佳，久咳，口干等症。"}]},{"ID":"20240611143621-evcn6cj","Type":"NodeParagraph","Properties":{"id":"20240611143621-evcn6cj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（25）清蒸百合：鲜百合洗净，蒸熟食用，可连续服用，对肝炎，胃病，贫血，体虚，有良好的疗效。"}]},{"ID":"20240611143621-p5sh4qt","Type":"NodeParagraph","Properties":{"id":"20240611143621-p5sh4qt","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（26）百合糖水：百合100克，白糖适量，煮汤食用。适用于肺结核和热性病后期患者以及失眠，心悸，精神不安，肺痿肺痈，痰火咳血等症。"}]},{"ID":"20240611143621-2vpfkzp","Type":"NodeParagraph","Properties":{"id":"20240611143621-2vpfkzp","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（27）百合炖肉：百合100克，瘦猪肉（亦可用鸡肉、羊肉）500克，共炖熟佐餐食用。适用于身体虚弱者及慢性支气管炎、浮肿患者作调补之用。"}]},{"ID":"20240611143621-ep53yjj","Type":"NodeParagraph","Properties":{"id":"20240611143621-ep53yjj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（28）百合粥：百合50克、粳米100克，同煮粥，加冰糖调味食用。有润肺止咳，养心安神作用。适用于慢性支气管炎，肺热或肺燥所致的干咳，以及肺结核，久咳不愈，睡眠不好，烦躁不安，肺气肿，咯血，妇女更年期综合症，神经衰弱等症。脾胃虚弱或风寒感冒咳嗽者不宜食用。"}]},{"ID":"20240611143621-6nmwdri","Type":"NodeParagraph","Properties":{"id":"20240611143621-6nmwdri","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（29）百合粥：百合、莲子、薏米各适量，同煮粥，加冰糖或白糖调味食用。有滋补、安神、益胃、润肺作用。适用于各种虚弱，心悸，大便溏稀，脚气病等症。"}]},{"ID":"20240611143621-8xcz8gt","Type":"NodeParagraph","Properties":{"id":"20240611143621-8xcz8gt","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（30）百合病（伤寒病之后坐卧不安，神志不清，胡言乱语）。如已发汗用百合枚，水泡一夜，次日清晨以泉水煮取一升；另用知母三两，加水二程式煮取一升。百合汁、知母汁合在一起煮成一升半，分次服。此方名\"百合知母汤\"。如已吐过，则用百全七枚，水泡一夜，次日清晨以泉水二升煮取一升，加鸡蛋白一个，分两次服。此方名\"百合鸡子汤\"。如已泻过，则用百合七枚，水泡一夜，次日清晨以泉水二繁荣昌盛煮取一升；另用代赭石一两、滑石三两，加水二繁荣昌盛煮取一升，是百合汁一起再煮成一升半，分两次服。此方名\"百合代赭汤\"。如未经汗、吞、下，则用百合枚，水泡一领先，次日清晨以泉水二升煮取一升；另以生地黄汁一升，令两汁合煮成一升半，分两次服。此方名\"百合地黄汤\"。如病已变成消渴，则用百合一升在水一半中泡一夜，取汗温洗病人，洗毕，令病人吃白汤饼。如病已变成热症，则用百合一两、滑石三两，共研为末，水冲一匙，微泻即见药效。如病已变成腹满作痛，则用百合炒为末，每服一匙，水送下。一天服二次。"}]},{"ID":"20240611143621-8nrwt2m","Type":"NodeParagraph","Properties":{"id":"20240611143621-8nrwt2m","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（31）肺脏壅热。烦闷咳嗽。用新百合四两，加蜜蒸软，时时含一片吞津。"}]},{"ID":"20240611143621-2a1o0du","Type":"NodeParagraph","Properties":{"id":"20240611143621-2a1o0du","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（32）肺病吐血。用新百合捣汁，水送服。煮百合吃亦可。"}]},{"ID":"20240611143621-f0g1a1o","Type":"NodeParagraph","Properties":{"id":"20240611143621-f0g1a1o","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（33）风疹流走。用盐泥二两、百合半两、黄丹二钱、醋一分、唾液四分，捣和敷贴。"}]},{"ID":"20240611143621-9vt7ks1","Type":"NodeParagraph","Properties":{"id":"20240611143621-9vt7ks1","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（34）疮肿不穿。用野百合同盐捣泥敷涂。"}]},{"ID":"20240611143621-j6c6pnn","Type":"NodeParagraph","Properties":{"id":"20240611143621-j6c6pnn","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（35）天泡疮。用生百合捣涂，二、二日即安。或用百合花晒干为末，调菜油涂搽亦有效。"}]},{"ID":"20240611143621-0gtcfpr","Type":"NodeParagraph","Properties":{"id":"20240611143621-0gtcfpr","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"（36）肠风下血。有百合子，酒炒微赤，研为末，开水冲服。"}]},{"ID":"20240611143621-9a8v2vd","Type":"NodeParagraph","Properties":{"id":"20240611143621-9a8v2vd","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611143621-ud7l5ol","Type":"NodeParagraph","Properties":{"id":"20240611143621-ud7l5ol","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外用止血:"},{"Type":"NodeText","Data":"取百合粉15克，加入蒸馏水配成15％混悬液，再加温约至60℃，并搅动使成糊状。俟冷，放入2～4℃0冰箱内冻结；冻结成海绵状后再放入石灰桶内，或用纱布包好挂起，使之慢慢解冻（不可加温或曝晒）；继将海绵体中之水分挤去，再剪成所需之大小与形状，装在瓶内在15磅压力下蒸气消毒15分钟即可应用。临床以百合海绵填塞治疗鼻衄及用于鼻息肉切除、中下鼻甲部分截除等手术后止血，据100余例观察，止血效果良好，百合海绵在鼻腔中3小时即开始溶化，14小时完全消失，能被组织吸收而无不良过敏反应。"}]},{"ID":"20240611143621-fwd64k9","Type":"NodeParagraph","Properties":{"id":"20240611143621-fwd64k9","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611143621-vxa0b12","Type":"NodeParagraph","Properties":{"id":"20240611143621-vxa0b12","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 同属植物如：卷丹（《纲目》）（东北）、山丹（《食疗本草》）（详\"山丹\"条）、山百合（《植物名实图考》）（云南）、松叶百合、渥丹（《花镜》）、赛渥丹（东北）、轮叶百合、高原卷丹（西北、西南）、野百合（新疆）等，均可入药。"}]},{"ID":"20240611143621-zqxweyi","Type":"NodeParagraph","Properties":{"id":"20240611143621-zqxweyi","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611143621-lwdw64f","Type":"NodeParagraph","Properties":{"id":"20240611143621-lwdw64f","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611143621-b2b5pak","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611143621-b2b5pak","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"《中华本草》：百合"}]},{"ID":"20240611143621-fs6gvx0","Type":"NodeParagraph","Properties":{"id":"20240611143621-fs6gvx0","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611143621-x6dbali","Type":"NodeParagraph","Properties":{"id":"20240611143621-x6dbali","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" Bǎi Hé"}]},{"ID":"20240611143621-f7q0r1a","Type":"NodeParagraph","Properties":{"id":"20240611143621-f7q0r1a","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611143621-whc3hoi","Type":"NodeParagraph","Properties":{"id":"20240611143621-whc3hoi","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 重迈、中庭、重箱、摩罗、强瞿、百合蒜、蒜脑薯"}]},{"ID":"20240611143621-2gm0sih","Type":"NodeParagraph","Properties":{"id":"20240611143621-2gm0sih","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611143621-trjutlv","Type":"NodeParagraph","Properties":{"id":"20240611143621-trjutlv","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" Lanceleaf Lily Bulb Greenish Lily BulbLow Lily Bulb， Greenish Lily"}]},{"ID":"20240611143621-cggmut2","Type":"NodeParagraph","Properties":{"id":"20240611143621-cggmut2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611143621-tbuuy2z","Type":"NodeParagraph","Properties":{"id":"20240611143621-tbuuy2z","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611143621-4y3o4e4","Type":"NodeParagraph","Properties":{"id":"20240611143621-4y3o4e4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"1.《纲目》：百合之根，以众瓣合成也。或云，专治百合病，故名，亦通。其根如大蒜，其味如山薯，故俗称为蒜脑薯。此物花叶根皆四向，故日强瞿。凡物旁生谓之瞿，义出《韩诗外传》。百合一茎直上，四向生叶，叶似短竹叶，不似柳叶，五、六月茎端开大白花，长五寸，六出，红蕊四垂向下，色亦不红。红者叶似柳，乃山丹也。百合结实，略似马兜铃，其内，子亦似之，其瓣种之如种蒜法，山中者宿根，年年自"}]},{"ID":"20240611143621-9i2wpa2","Type":"NodeParagraph","Properties":{"id":"20240611143621-9i2wpa2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611143621-3s1gnxd","Type":"NodeParagraph","Properties":{"id":"20240611143621-3s1gnxd","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物百合、卷丹、山丹、川百合等的鳞茎。"}]},{"ID":"20240611143621-n9e50zb","Type":"NodeParagraph","Properties":{"id":"20240611143621-n9e50zb","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Lilium brownii F. E.Brown ex Miellezvar.viridulum Baker[L.browniiF.E.Brownex Miellez var.colchesteri(Van Houtt.)Wils.ex Elwes ] 2.Lilium lancifolium Thunb. [L.tigrinum Ker-Gawl.] 3.Liliumpumilum DC.[L.tenuifolium Fisch.] 4.Lilium davidii Duch."}]},{"ID":"20240611143621-ymzt38p","Type":"NodeParagraph","Properties":{"id":"20240611143621-ymzt38p","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"采收和储藏：于移栽第2年，9-10月茎叶枯萎后采挖，去掉茎杆、须根，将小鳞茎选留做种，将大鳞茎洗净，从基部横切一刀，使鳞片分开，然后于开水中烫5-10min，当鳞片边缘变软，背面有微裂时，迅速捞起，放清水冲洗去粘液，薄摊晒干或炕干。"}]},{"ID":"20240611143621-rpjjz7p","Type":"NodeParagraph","Properties":{"id":"20240611143621-rpjjz7p","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611143621-fguk4k3","Type":"NodeParagraph","Properties":{"id":"20240611143621-fguk4k3","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔900m以下的山坡草丛、石缝中或村舍附近。也有栽培。"}]},{"ID":"20240611143621-oavtsvi","Type":"NodeParagraph","Properties":{"id":"20240611143621-oavtsvi","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"2.生于海拔2500m以下的林缘路旁及山坡草地。"}]},{"ID":"20240611143621-h1yttxy","Type":"NodeParagraph","Properties":{"id":"20240611143621-h1yttxy","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.生于海拔400-2500m的山坡、林下及山地岩石间。 4.生于海拔850-3200m的山坡草地或林缘。"}]},{"ID":"20240611143621-fuzumra","Type":"NodeParagraph","Properties":{"id":"20240611143621-fuzumra","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于河北、山西、陕西、安徽、浙江、江西、河南、湖北、湖南等地。"}]},{"ID":"20240611143621-y77hrsw","Type":"NodeParagraph","Properties":{"id":"20240611143621-y77hrsw","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"2.分布于河北、陕西、甘肃、山东、江苏、安徽、浙江、江西、河南、湖北、湖南、广东、四川、贵州、云南、西藏等地。 3.分布于东北、华北、西北、山东、河南等地。 4.分布于山西、陕西、甘肃、河南、湖北、四川、云南等地。"}]},{"ID":"20240611143621-pakow1g","Type":"NodeParagraph","Properties":{"id":"20240611143621-pakow1g","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611143621-g8fcmck","Type":"NodeParagraph","Properties":{"id":"20240611143621-g8fcmck","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 1.百合，多年生草本，高70-150cm。茎上有紫色条纹，无毛；鳞茎球形，直径约5cm，鳞茎瓣广展，无节，白色。叶散生，具短柄；上部叶常小于中部叶，叶片倒披针形至倒卵形，长7-10cm，宽2-3cm，先端急尖，基部余窄，全缘，无毛，有3-5条脉。花1-4朵，喇叭形，有香味；花被片6，倒卵形，长15-20cm，宽3-4.5cm，多为白色，背面带紫褐色，无斑点，先端弯而不卷，蜜腺两边具小乳头状突起；雄蕊6，前弯，花丝长9.58-11cm，具柔毛，花药椭圆形，丁字着生，花粉粒褐红色；子房长柱形，长约3.5cm，花柱长11cm，无毛，柱头3裂。蒴果长圆形，长约5cm，宽约3cm，有棱。种子多数。花、果期6-9月。 2.卷丹 多年生草本，高1-1.5m。鳞茎卵圆状扁球形，高4-7cm，直径5-8cm。茎直立，淡紫色，被白色绵毛。叶互生，无柄；叶片披针形或长圆状披针形，长5-20cm，宽0.5-2cm，向上渐小成苞片状，上部叶腋内常有紫黑色珠芽。花3-6朵或更多，生于近顶端处，下垂，橘红色，花蕾时被白色绵毛；花被片披针形向外反卷，内面密被紫黑色斑点；雄蕊6，短于花被，花药紫色；子房长约1.5cm，柱头3裂，紫色。蒴果长圆形至倒卵形，长3-4cm。种子多数。花期6-7月，果期8-10月。3.山丹 多年生草本，高20-60cm。鳞茎圆锥形或长卵形，直径1.8-3.5cm，具薄膜，鳞瓣长圆形或长卵形，长2-3.5cm，宽0.7-1.2cm，白色。叶散生于茎中部，无柄；叶片条形，长3-10cm，宽1-3mm，无毛，先端锐尖，基部渐窄，有1条明显的脉。花一至数朵，生于茎顶或在茎端叶腋间，俯垂，鲜红色或紫红色；花被片6，长3-4.5cm，宽5-7mm，内花被片稍宽，反卷，无斑点或有少数斑点，蜜腺两边有乳头状突起；雄蕊6，短于花被，花丝无毛，花药长椭圆形，黄色，具红色花粉粒；子房圆柱形，长约9mm，花柱比子房长1.5-2倍。蒴果长圆形。花期7-8月，果期8-10月。 4.川百合 多年生草本，高约1.5m。鳞茎球形，直径2-4cm，白色。茎直立，具小突起或稀疏的锦毛。叶散生，中部密集；叶片条形，长6-10cm，宽2-3mm，两面无毛，边缘反卷并有明显的小乳头状突起，叶腋处具白色绵毛，中脉明显。花单生或2-8朵成总状排列，下垂，橙黄色，直径5-8cm；花梗长3-6cm，具披针形叶状苞片；花被片6，长圆形，长4-6cm，宽1cm左右，向外反卷，具紫色斑点，外面具稀绵毛，蜜腺两边具毛和乳头状突起；花丝无毛，花药长圆形，长1.4-1.6cm，花粉深橘红色；花柱长为子房的2倍。蒴果长椭圆形，长3.5cm，直径1.7-2cm。花期7-8月，果期9月。"}]},{"ID":"20240611143621-g5abynj","Type":"NodeParagraph","Properties":{"id":"20240611143621-g5abynj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611143621-iywjd2s","Type":"NodeParagraph","Properties":{"id":"20240611143621-iywjd2s","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖稍带冷凉而干燥的气候，耐荫性较强。耐寒，生长发育温度以15-25度为宜。能耐干旱。最忌酷热和雨水过多。为长日照植物，生长前期和中期喜光照。宜选向阳、土层深厚、疏松肥沃、排水良好的砂质土壤栽培，低湿地不宜种值。忌连作，与豆类和禾本科作物轮作较好。 栽培技术 无性繁殖和有性繁殖均可。目前生产上主要用鳞片、小鳞茎和珠芽繁殖。鳞片繁殖：秋季采挖鳞茎，剥取里层鳞片，选肥大者在1：500的苯菌灵或克菌丹水溶液中浸30min，取出，阴干，基部向下插入苗床内，第2年9月挖出，按行株距15cm×6cm移栽，经2-3年培育可收获。亦可采用育苗箱育种。小鳞茎繁殖：采收时，将小鳞茎按行株距15cm×6cm播种，经2年培育可收获。珠芽繁殖：夏季采收珠芽，用湿沙混合贮藏于阴凉通风处，当年8-9月播于苗床上，第2年秋季地上部枯萎后，挖取鳞茎，按行株距20cm×10cm播种，到第3年秋采收，较小者再培育1年。 田间管理 苗出齐后和5月间，各中耕除草1次，同时追肥、培土、用人畜粪水、油饼、草木灰、过磷酸钙等混合施用。亦可用0.2%磷酸二氢钾进行叶面追肥。5月下旬要去顶，并打珠芽，6-7月孕蕾期间，应及 时摘除花茎。夏季高温多雨季节，要注意排水。 病虫害防治 病害有病毒病，选择无病鳞茎繁殖，并消灭传染病害的蚜虫。立枯病，要避免连作，注意排水，发现病株，立即拔除，并撒石灰消毒。虫害有蚜虫，可用50%马拉硫磷1000倍液喷射防治。"}]},{"ID":"20240611143621-meebvqu","Type":"NodeParagraph","Properties":{"id":"20240611143621-meebvqu","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611143621-0zc4pjn","Type":"NodeParagraph","Properties":{"id":"20240611143621-0zc4pjn","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）百合 鳞叶呈长椭圆形，顶端尖，基部较宽，微波状，向内卷曲，长1.5-3cm，宽0.5-1cm，厚约4mm，有脉纹3-5条，有的不明显。表面白色或淡黄色，光滑半透明，质硬而脆，易折断，断面平坦，角质样，无臭，味微苦。 （2）卷丹 鳞叶长2-3.5cm，宽1.5-3cm，厚1-3cm，表面乳白色或淡黄棕色，有纵直的脉纹3-8条，质硬而脆；易折断，断面平坦，角质样。无臭，味微苦。 （3）山丹 鳞叶长约5.5cm，宽约2.5cm，厚至3.5mm，色较暗，脉纹不太明显。 （4）川百合 鳞叶长2.5-5.5cm，宽约1.2cm，厚1-3mm。以鳞叶均匀、肉厚、质硬、筋少、色白、味微苦者为佳。 显微鉴别 粉末特征：（1）百合 灰白色。①未糊化淀粉粒呈卵形或长圆形，两端圆或稍平截，直径5-50μm，长至80μm；脐点人字状、三叉状或马蹄状，层纹明显。②表皮细胞壁薄，微波状；气孔类圆形者，直径56-67μm，长圆形者直径40-48μm，长45-61μm，副卫细胞3-5个。③螺纹导管直径约至25μm。 （2）卷丹 米黄色。 ①未湖化淀粉粒呈长卵圆形、类圆形或不规则形，直径4-29μm，长约至46μm，脐点不明显，呈人字状或短缝状，多位于小端，层纹隐约可见。②表皮细胞垂周壁稍增厚，有的呈连珠状；气孔类圆形，直径60-68μm，副卫细胞3-5个，保卫细胞有纹理。③螺纹、网纹导管直径约至30μm （3）山丹 灰白色。 ①未湖化淀粉粒卵圆、椭圆形或略呈贝壳状，较小端稍尖突，直径3-48μm，长至72μm；脐点人字状、点状或短缝状，层纹明显，复粒由2-4分粒组成。②表皮细胞壁波状弯曲；气孔类圆形，直径44-52μm，副卫细胞4-5个，保卫细胞有纹理。③螺纹导管直径约至21μm。 （4）川百合 灰白色。 ①未湖化淀粉粒圆形或长卵形，脐点裂缝状、点状，层纹不明显。②外表皮细胞极弯曲，气孔类圆形，副卫细胞4-5个。"}]},{"ID":"20240611143621-7wy4oks","Type":"NodeParagraph","Properties":{"id":"20240611143621-7wy4oks","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611143621-vurfa2s","Type":"NodeParagraph","Properties":{"id":"20240611143621-vurfa2s","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 1.秋水仙碱有骨髓抑制、胃肠道症状如恶心、呕吐、食欲减退、腹泻、便秘等，有的可产生肠麻痹、四肢酸痛。"}]},{"ID":"20240611143621-ifhhm02","Type":"NodeParagraph","Properties":{"id":"20240611143621-ifhhm02","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"2.注射液局部刺激性较大，漏于血管外，可引起局部坏死。"}]},{"ID":"20240611143621-ueachb2","Type":"NodeParagraph","Properties":{"id":"20240611143621-ueachb2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.少数患者有脱发、心电图改变。"}]},{"ID":"20240611143621-0qngizr","Type":"NodeParagraph","Properties":{"id":"20240611143621-0qngizr","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611143621-46csyph","Type":"NodeParagraph","Properties":{"id":"20240611143621-46csyph","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 百合鳞茎含岷江百合甙（regaloside）A、D，3，6'-O-二阿魏酰蔗糖（3，6'-O-diferuloylsucrose），1-O-阿魏酰甘油（1-O-feruloylglycerol）,1-O-对-香豆酰甘油（1-O-p-coumaroylglycerol），26-O-β-D-吡喃葡萄糖基-奴阿皂甙元-3-O-α-L-吡喃鼠李糖基-（1→2）-β-D-吡喃葡萄糖甙〔26-O-β-D-glucopyranosylnuatigenin-3-O-α-L-rhamnopyranosyl（1→2）-β-D-glucopyranoside〕，26-O-β-D-吡喃葡萄糖基-奴阿皂甙元-3-O-α-L-吡喃鼠李糖基-（1→2）-O-[β-D-吡喃葡萄糖基（1→4）]-β-D-吡喃葡萄糖甙"}]},{"ID":"20240611143621-7x3whi4","Type":"NodeParagraph","Properties":{"id":"20240611143621-7x3whi4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611143621-iirmo3l","Type":"NodeParagraph","Properties":{"id":"20240611143621-iirmo3l","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 1.镇咳祛痰作用1.1.镇咳作用小鼠用SO2引咳法，观察其镇咳效果。结果见表2。均有明显的镇咳作用。"}]},{"ID":"20240611143621-0e9aolu","Type":"NodeParagraph","Properties":{"id":"20240611143621-0e9aolu","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"1.2.祛痰作用用酚红比色法，气管最后用0.5mlNaHCO3冲洗，于546nm处测定吸收度，并从酚红标准曲线中求出气管排出酚红量。结果见表3。均有显着的祛痰作用。"}]},{"ID":"20240611143621-c77j6ig","Type":"NodeParagraph","Properties":{"id":"20240611143621-c77j6ig","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"2.镇静作用小鼠停食8小时后，分别ig百合20g/kg，用酸枣仁作阳性对照，空白用生理盐水，给药30分钟ip戊巴比妥钠40mg/kg，以翻正反射消失到恢复的时间作为睡眠时指标。同时观察对戊巴比妥钠阈下剂量睡眠率的影响。均具有显着地增加戊巴比妥钠睡眠时间及阈下剂量的睡眠率，提示有明显的镇静作用。"}]},{"ID":"20240611143621-eoru824","Type":"NodeParagraph","Properties":{"id":"20240611143621-eoru824","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.滋阴润肺作用3.1.肺气虚模型游泳实验表明，百合、卷丹以10g/kg剂量ig给于小鼠，并与黄芪（10g/kg）对照，有显着的延长游泳时间，三者的P值均\u003c0.001。"}]},{"ID":"20240611143621-f65n337","Type":"NodeParagraph","Properties":{"id":"20240611143621-f65n337","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.2.甲亢阴虚模型耐缺氧实验，用甲状腺素0.3mg/只制成小鼠模型。结果百合加甲状腺素组和卷丹加甲状腺素组，明显延长小鼠耐缺氧能力，其P值分别为P\u003c0.01和P\u003c0.001。"}]},{"ID":"20240611143621-g5747du","Type":"NodeParagraph","Properties":{"id":"20240611143621-g5747du","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.3.对肾上腺皮质激素所致阴虚模型负荷游泳实验，取雄性小鼠，分生理盐水组、强的松龙（40mg/kg/次）造型组和药物（ig10g/kg）加强的松龙组。结果百合对肾上腺皮质功能衰竭起显着性的保护作用（P\u003c0.001）。"}]},{"ID":"20240611143621-fnr1o95","Type":"NodeParagraph","Properties":{"id":"20240611143621-fnr1o95","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.4.对小鼠以2，4-二硝基氯苯（DNCB）所致迟发型过敏反应亦有显着的抑制作用。"}]},{"ID":"20240611143621-u6580mp","Type":"NodeParagraph","Properties":{"id":"20240611143621-u6580mp","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"4.强壮作用4.1.对小鼠负荷游泳的影响小鼠igl0g/kg的药物，并与生理盐水和阿胶养血口服液0.2ml/10g作阳性对照。结果卷丹具显着的延长小鼠游泳时间（P\u003c0.001)。"}]},{"ID":"20240611143621-56g5vwb","Type":"NodeParagraph","Properties":{"id":"20240611143621-56g5vwb","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"4.2.对小鼠耐常压缺氧的影响小鼠ig10g/kg的药物，以生理盐水作空白对照和以阿胶养血口服液0.2ml/10g作阳性对照。结果卷丹亦能明显的延长小鼠耐缺氧时间（P\u003c0.05)。"}]},{"ID":"20240611143621-jinhv8e","Type":"NodeParagraph","Properties":{"id":"20240611143621-jinhv8e","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"4.3.对异丙肾上腺素所致的耐缺氧未见明显的作用。"}]},{"ID":"20240611143621-8fad1uw","Type":"NodeParagraph","Properties":{"id":"20240611143621-8fad1uw","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"5.抗癌作用本品所含秋水仙碱能抑制癌细胞的增殖。"}]},{"ID":"20240611143621-bnd5ts8","Type":"NodeParagraph","Properties":{"id":"20240611143621-bnd5ts8","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611143621-ao253yr","Type":"NodeParagraph","Properties":{"id":"20240611143621-ao253yr","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 1.百合：拣去杂质、黑瓣，簸除灰屑。"}]},{"ID":"20240611143621-9o1x2a1","Type":"NodeParagraph","Properties":{"id":"20240611143621-9o1x2a1","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"2.蜜百合：取净百合，加炼熟的蜂蜜（百合100斤用炼蜜6斤4两）与开水适量，拌匀，稍闷，置锅内用文火炒至黄色不沾手为度，取出，放凉。《品汇精要》：百合，蒸熟用。"}]},{"ID":"20240611143621-eztffi9","Type":"NodeParagraph","Properties":{"id":"20240611143621-eztffi9","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611143621-s3nzla2","Type":"NodeParagraph","Properties":{"id":"20240611143621-s3nzla2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱：取本品粗粉0.5g，加60%乙醇5-10ml，温浸并不断振摇30min，滤过，滤液浓缩至1ml，作为供试液。另用果糖和蔗糖对照。分别点于同一硅胶G板上，以醋酸乙酯-甲醇-乙酸-水（12：3：3：2）展开，用α-萘酚硫酸液显色。供试液色谱在与对照品色谱相应位置上，显相同的紫红色斑点。"}]},{"ID":"20240611143621-iq6x437","Type":"NodeParagraph","Properties":{"id":"20240611143621-iq6x437","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611143621-bxjr9vj","Type":"NodeParagraph","Properties":{"id":"20240611143621-bxjr9vj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 心；肺经"}]},{"ID":"20240611143621-lnct99j","Type":"NodeParagraph","Properties":{"id":"20240611143621-lnct99j","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611143621-tvquzsv","Type":"NodeParagraph","Properties":{"id":"20240611143621-tvquzsv","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 甘；微苦；微寒"}]},{"ID":"20240611143621-843yugx","Type":"NodeParagraph","Properties":{"id":"20240611143621-843yugx","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611143621-8cvvtjj","Type":"NodeParagraph","Properties":{"id":"20240611143621-8cvvtjj","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 风寒咳嗽及中寒便溏者忌服。"}]},{"ID":"20240611143621-5f57za1","Type":"NodeParagraph","Properties":{"id":"20240611143621-5f57za1","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611143621-4d4zsx9","Type":"NodeParagraph","Properties":{"id":"20240611143621-4d4zsx9","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 养阴润肺；清心安神。主阴虚久嗽；痰中带血；热病后期；余热未清，或情志不遂所致的虚烦惊悸、失眠多梦、精神恍惚；痈肿；湿疮"}]},{"ID":"20240611143621-zzurrd3","Type":"NodeParagraph","Properties":{"id":"20240611143621-zzurrd3","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611143621-igtnnc1","Type":"NodeParagraph","Properties":{"id":"20240611143621-igtnnc1","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-12g；或入丸、散；亦可蒸食、煮粥。外用：适量，捣敷。"}]},{"ID":"20240611143621-i38s4ni","Type":"NodeParagraph","Properties":{"id":"20240611143621-i38s4ni","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611143621-tc7kegv","Type":"NodeParagraph","Properties":{"id":"20240611143621-tc7kegv","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 1.百合固金汤(《医方集解》)，养阴润肺，化痰止咳，主治肺肾阴虚。2.滑石代赭汤(《金匮要略》)，养阴清热，利尿降逆。3.百合知母汤(《金匮要略》)，宁心安神，润肺清热，主治百合病误汗后，津液受伤，虚热加重，心烦口渴。4.百合鸡子黄汤(《金匮要略》)，养阴除烦，主治百合病误吐后，虚烦不安，口干唇燥，大便干燥。5.百合地黄汤(《金匮要略》)，润养心肺，清热凉血，主治百合病。6.百花膏(《济生方》)，主治咳嗽不已，痰中有血。7.补肾丸(《银海精微》)，滋阴补阴。"}]},{"ID":"20240611143621-ej9wc4r","Type":"NodeParagraph","Properties":{"id":"20240611143621-ej9wc4r","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611143621-8cr7h5l","Type":"NodeParagraph","Properties":{"id":"20240611143621-8cr7h5l","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主邪气腹胀、心痛。利大小便，补中益气。"}]},{"ID":"20240611143621-9jb21s1","Type":"NodeParagraph","Properties":{"id":"20240611143621-9jb21s1","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"2.《别录》：除浮肿胪胀，痞满，寒热，通身疼痛，及乳难，喉痹，止涕泪。"}]},{"ID":"20240611143621-5r3o70c","Type":"NodeParagraph","Properties":{"id":"20240611143621-5r3o70c","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：除心下急、满、痛，治脚气，热咳逆。"}]},{"ID":"20240611143621-bxtzblm","Type":"NodeParagraph","Properties":{"id":"20240611143621-bxtzblm","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"4.《食疗本草》：主心急黄。"}]},{"ID":"20240611143621-zb9eksg","Type":"NodeParagraph","Properties":{"id":"20240611143621-zb9eksg","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：安心，定胆，益志，养五脏。治癫邪啼位、狂叫，惊悸，杀蛊毒气，燲乳痈、发背及诸疮肿，并治产后血狂运。"}]},{"ID":"20240611143621-k3jzv54","Type":"NodeParagraph","Properties":{"id":"20240611143621-k3jzv54","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"6.《本草衍义》：治伤寒坏后百合病。"}]},{"ID":"20240611143621-axkg7f4","Type":"NodeParagraph","Properties":{"id":"20240611143621-axkg7f4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"7.《本草蒙筌》：除时疫咳逆。"}]},{"ID":"20240611143621-jjkzsv2","Type":"NodeParagraph","Properties":{"id":"20240611143621-jjkzsv2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"8.《医学入门》：治肺痿，肺痈。"}]},{"ID":"20240611143621-mtm9yh2","Type":"NodeParagraph","Properties":{"id":"20240611143621-mtm9yh2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"9.《纲目拾遗》：清痰火，补虚损。"}]},{"ID":"20240611143621-n3d1c30","Type":"NodeParagraph","Properties":{"id":"20240611143621-n3d1c30","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"10.《上海常用中草药》：治肺热咳嗽，干咳久咳，热病后虚热，烦躁不安。"}]},{"ID":"20240611143621-ucgcdgf","Type":"NodeParagraph","Properties":{"id":"20240611143621-ucgcdgf","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"11.《本草经疏》：百合，主邪气腹胀。所谓邪气者，即邪热也。邪热在腹故腹胀，清其邪热则胀消矣。解利心家之邪热，则心痛自廖。肾主二便，肾与大肠二经有热邪则不通利，清二经之邪热，则大小便自利。甘能补中，热清则气生，故补中益气。清热利小便，故除浮肿、胪胀。痞满寒热，通身疼痛，乳难，足阳明热也；喉痹者，手少阳三焦、手少阴心家热也；涕、泪，肺肝热也；清阳明三焦心部之热，则上来诸病自除。"}]},{"ID":"20240611143621-c0s7wzi","Type":"NodeParagraph","Properties":{"id":"20240611143621-c0s7wzi","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"12.《本草述》：百合之功，在益气而兼之利气，在养正而更能去邪，故李氏谓其为渗利和中之美药也。如伤寒百合病，《要略》言其行住坐卧，皆不能定，如有神灵，此可想见其邪正相干，乱于胸中之故，而此味用之以为主治者，其义可思也。"}]},{"ID":"20240611143621-uwm65wa","Type":"NodeParagraph","Properties":{"id":"20240611143621-uwm65wa","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"13.《本经逢原》：百合，能补土清金，止嗽，利小便。仲景百合病，兼地黄用之，取其能消瘀血也。《本经》主邪气腹胀心痛，亦是散积蓄之邪。其曰利大小便者，性专降泄耳。其曰补中益气者，邪热去而脾胃安矣。"}]},{"ID":"20240611143621-bar20u4","Type":"NodeParagraph","Properties":{"id":"20240611143621-bar20u4","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"14.《本草从新》：朱二允云：久嗽之人，肺气必虚，虚则宜敛。百合之甘敛，甚于五味之酸收也。"}]},{"ID":"20240611143621-nkbro9y","Type":"NodeParagraph","Properties":{"id":"20240611143621-nkbro9y","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"15.《医林纂要》：百合，以敛为用，内不足而虚热、虚嗽、虚肿者宜之。与姜之用，正相反也。"}]},{"ID":"20240611143621-2w7v1dg","Type":"NodeParagraph","Properties":{"id":"20240611143621-2w7v1dg","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"16.《本草正义》：百合，乃甘寒滑利之品，《本经》虽曰甘平，然古今主治，皆以清热泄降为义，其性可见。《本经》主邪气，《别录》主寒热，皆以蕴结之热邪言之。主腹胀心痛，利大小便，除浮肿胪胀，痞满疼痛、乳难、喉痹，皆滑润开结，通利泄导之功用。《本经》又以为补中益气，《日华》又有安心益志等说，皆谓邪热去而正气自旺，非径以甘寒之品为补益也。仲景《金匮》以主伤寒后之百合病，《外台秘要》中更多此法，则百合病者，本为伤寒病后馀热未清之证，所以神志恍惚，莫名所苦，故谓之百脉一宗，悉致其病，百合能清泄肺胃之热，而通调水道，导泄郁热，是以治之。然则凡瞋胀浮肿等证，必系热阻气郁，百合方为正治，而寒湿交滞，脾肾阳衰者，皆当忌之。甄权谓其除心下急满，治脚气，亦必以有热者为宜。甄权又主热咳，洁古谓为止嗽，又必以肺热炽甚，气火烁金之证，乃为合法；而风寒外束，肺气不宣之咳，尤为禁品。古方以百合、款冬花同熬成膏，名曰百花膏，治久咳痰血之病，亦以阴虚火旺，上烁燥金，故以百合之清润降火，合之款冬之微温开泄者，宣散气火，滋益肺虚，是为正治。而世俗或以百合通治外感之嗽者，又未免寒降遏抑，反令肺气室塞，外邪无从宣泄矣。"}]},{"ID":"20240611143621-zk1jvz2","Type":"NodeParagraph","Properties":{"id":"20240611143621-zk1jvz2","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611143621-d2k2ddv","Type":"NodeParagraph","Properties":{"id":"20240611143621-d2k2ddv","updated":"20240611143621"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611143622-fgdow7l","Type":"NodeThematicBreak","Properties":{"id":"20240611143622-fgdow7l"}},{"ID":"20240611143623-g21ne71","Type":"NodeParagraph","Properties":{"id":"20240611143623-g21ne71"}}]}