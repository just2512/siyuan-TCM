Bang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍术"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍术-20240801143200-62hntyz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 471px;\" parent-style=\"width: 481px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801145933-ujsijwu","Type":"NodeParagraph","Properties":{"id":"20240801145933-ujsijwu","updated":"20240801145933"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 797px;","style":"width: 787px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍术 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍术 4-20240801143909-nekohrp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 787px;\" parent-style=\"width: 797px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240618115103-986i2ha","Type":"NodeParagraph","Properties":{"id":"20240618115103-986i2ha"}},{"ID":"20240618115103-xarn2ew","Type":"NodeParagraph","Properties":{"id":"20240618115103-xarn2ew","updated":"20240618115106"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白术、苍术"}]},{"ID":"20240618115057-1iql5hu","Type":"NodeParagraph","Properties":{"id":"20240618115057-1iql5hu","updated":"20240618115057"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 731px;","style":"width: 721px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240618115057-q3gg3hn.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 721px;\" parent-style=\"width: 731px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801152733-55woehw","Type":"NodeParagraph","Properties":{"id":"20240801152733-55woehw","updated":"20240801152945"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍术白术对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍术白术对比-20240801152938-pypgtz1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240828124509-r1nnxwz","Type":"NodeParagraph","Properties":{"id":"20240828124509-r1nnxwz","updated":"20240912162942"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：据抖音创作者考证，茅苍术为真正的苍术；"}]},{"ID":"20240912163041-lymds1q","Type":"NodeParagraph","Properties":{"id":"20240912163041-lymds1q","updated":"20240912163913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：苍术放久了会起白色的霜，看起来像是发霉了，实际上属于正常现象，加热后或太阳晒过白霜就会消失了；（起霜是源于苍术内部油分的挥发）；如下图；"}]},{"ID":"20240912163348-x1e3gik","Type":"NodeParagraph","Properties":{"id":"20240912163348-x1e3gik","updated":"20240912163449"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 440px;","style":"width: 430px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍术起霜"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍术起霜-20240912163348-q0xievt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 430px;\" parent-style=\"width: 440px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 605px;","style":"width: 595px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍术起霜 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍术起霜 2-20240912163449-629qr6i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 595px;\" parent-style=\"width: 605px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607095034-lowpg8d","Type":"NodeThematicBreak","Properties":{"id":"20240607095034-lowpg8d"}},{"ID":"20240616083717-m6ym20t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083717-m6ym20t","updated":"20240616083725"},"Children":[{"Type":"NodeText","Data":"术《神农本草经》"}]},{"ID":"20240616083717-t27cm07","Type":"NodeParagraph","Properties":{"id":"20240616083717-t27cm07","updated":"20240616083717"},"Children":[{"Type":"NodeText","Data":"味苦温。"}]},{"ID":"20240616083717-ynrok5r","Type":"NodeParagraph","Properties":{"id":"20240616083717-ynrok5r","updated":"20240616083717"},"Children":[{"Type":"NodeText","Data":"主风寒湿痹死肌，痉疸，止汗，除热，消食，作煎饵。久服，轻身延年，不饥。一名山蓟（艺文类聚引作山筋），生山谷。"}]},{"ID":"20240616083717-yf44ysf","Type":"NodeParagraph","Properties":{"id":"20240616083717-yf44ysf","updated":"20240616083717"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：术，一名山连，一名山芥，一名天苏，一名山姜（艺文类聚）。"}]},{"ID":"20240616083717-0vashc6","Type":"NodeParagraph","Properties":{"id":"20240616083717-0vashc6","updated":"20240616083717"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名山姜，一名山连，生郑山，汉中，南郑，二月三月八月九月，采根暴干。"}]},{"ID":"20240616083717-6d1waze","Type":"NodeParagraph","Properties":{"id":"20240616083717-6d1waze","updated":"20240616083717"},"Children":[{"Type":"NodeText","Data":"案《说文》云：术，山蓟也；《广雅》云：山姜，术也，白术，牡丹也；《中山经》云：首山草多术；郭璞云：术，山蓟也；《尔雅》云：术，山蓟；郭璞云：今术似蓟，而生山中；《范子计然》云：术出三辅，黄白色者善；《列仙传》云：涓子好饵术；《抱朴子·仙药》云：术一名山蓟，一名山精，故神药经曰：必欲长生，长服山精。"}]},{"ID":"20240616084447-8qzwp9i","Type":"NodeThematicBreak","Properties":{"id":"20240616084447-8qzwp9i"}},{"ID":"20240616084448-y3d9obh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084448-y3d9obh","updated":"20240616084455"},"Children":[{"Type":"NodeText","Data":"术《本草述钩元》"}]},{"ID":"20240616084448-os6rok4","Type":"NodeParagraph","Properties":{"id":"20240616084448-os6rok4","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"苍术苦辛气烈。白术苦甘气和。宋以来始各自施用。秋采者佳。春采者虚软易坏。苍术处处有之。白术吴越有之。浙产为云头术。颇肥大。种由粪力也。易润油。歙产名狗头术。虽瘦小。得土气充。甚燥。其白胜于浙术。宁国昌化池州者。并同歙术。境相邻也。"}]},{"ID":"20240616084448-jsqd9eo","Type":"NodeParagraph","Properties":{"id":"20240616084448-jsqd9eo","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"白术味甘微辛而苦。气温。味浓气薄。阳中阴也。可升可降。入足阳明太阴足厥阴少阴手太阳少阳经。主治除湿益气。和中补阳。理胃益脾。进食消谷。生脾津。除胃热。（盖脾之阴不化。则津不生。气不行。而热还归于胃也。）止渴。消湿痰虚痰。逐水饮。驱宿滞。"}]},{"ID":"20240616084448-ag84vug","Type":"NodeParagraph","Properties":{"id":"20240616084448-ag84vug","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"治心下湿痞水痞。胃脘虚痛寒痛。心腹胀满。水肿腹满。止脾虚呕逆。湿泻水泻。并泻痢。"}]},{"ID":"20240616084448-xazmyvg","Type":"NodeParagraph","Properties":{"id":"20240616084448-xazmyvg","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"多年气痢。止肌热。愈四肢困倦嗜卧。目不能开。逐皮间风水结肿。消足胫水肿。治冷气癖气块。利腰脐间血。并卫脉为病。逆气里急。脐腹痛。补肝风虚。温中止汗。利水道。上而皮毛。中而心胸。下而腰脐之间。在气主气。在血主血。（海藏）佐黄芩。安胎。佐枳实。"}]},{"ID":"20240616084448-xtmp3qi","Type":"NodeParagraph","Properties":{"id":"20240616084448-xtmp3qi","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"消痞。配二陈。健脾消食。化痰除湿。与归芍生地之类同用。能补脾家之血。合干姜。逐脾家寒湿。和枳实姜连。除脾中湿热。与芍等同附方洁古枳术丸。消痞强胃。久服令人食自不停。白术黄壁土炒一两。枳实麸炒一两。"}]},{"ID":"20240616084448-rw8f9mz","Type":"NodeParagraph","Properties":{"id":"20240616084448-rw8f9mz","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"为末。荷叶包饭。烧熟捣和丸梧子大。每白汤下五十丸。气滞。加橘皮一两。有火。加黄连一两。有痰。加半夏一两。有寒。加干姜五钱。木香三钱。有食。加神曲麦芽各五钱。用白术方。不能备录。今但摘其治泻。有所因不同而所和之味亦异者。即类推之。可以善术之用也。脾虚泄泻。白术五钱。白芍一两。冬月加肉豆蔻煨。为末。米饮丸梧子大。每米饮下五十丸。日二服。湿泻暑泻。白术车前子等分。炒为末。白汤下二三钱。久泻滑肠。白术炒茯苓各一两。糯米炒二两。为末。枣肉拌食。或丸服之。老小滑泻。白术半斤。黄土炒过。山药四两。炒为末。饭丸。量人大小。米汤服。或加人参三钱。老人常泻。白术二两。黄土拌蒸。焙干去土。苍术五钱。泔浸炒。茯苓一两。为末。米糊丸。梧子大。每米汤下七八十丸。"}]},{"ID":"20240616084448-kdkgh25","Type":"NodeParagraph","Properties":{"id":"20240616084448-kdkgh25","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"泻血萎黄。肠风痔漏。脱肛。积年不瘥者。白术一斤。黄土炒过研末。干地黄半斤。饭上蒸熟。捣和。干则少入酒。丸梧子大。每用米饮下五十丸。日三服。"}]},{"ID":"20240616084448-uy4rgke","Type":"NodeParagraph","Properties":{"id":"20240616084448-uy4rgke","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"〔论〕人身元气。每困于湿。湿除则气益。惟白术于坤顺之体。具干健之用。不等于淡味渗湿。风剂燥湿。故洁古论术。首以除湿益气归之。夫脾为湿主。湿困。是阴中之阳困。"}]},{"ID":"20240616084448-a7c9wl6","Type":"NodeParagraph","Properties":{"id":"20240616084448-a7c9wl6","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"苟不得胃脘之健阳以召之。将何以为胃行气于三阳三阴乎。惟术能健胃阳。以化脾阴。而召阴中之阳。乃为表里相应。水火互召。元气于是畅。于是益。且脾主地气。胃主天气。脾不得天气之召。则地气不上行。胃不得地气之和。则天气不下施。（内经论脾胃切切于天气地气之分。因谓其主升降之化也。）至地气上与天气和。则所谓上焦合而营诸阳。总归于阳之能施能化。所以一切主治。阴固在阳中而不尸其功。况诸证非病于阳之不能健运。即阴之不得阳以运化者也。（大抵白术之用在除湿。胃之功至于脾也。除湿而即能益气。由脾而归胃也。益气而便能和血。表里相应。水火互召也。海藏所谓在气主气。在血主血者。不可相提并论。以阴从阳化而不尸其功也。）其所入之经。先胃及脾。其他所入之经。又由脾胃以及之。历审诸治。总由宣天气之阳。以化地气之阴。阴阳和而气乃行。由真气以化谷气。即由谷气以充真气。俾中土气交能行升降之化。为后天补接良剂。而于老人更切也。洁古谓下行则用之者。以足三阴同起于下。益脾者即能与肝肾俱。（胃得地气之和以下施故也）由脾胃而达肾肝之阴。海藏故云。补肝经风虚。又治冲脉逆气里急及脐腹痛也。惟阴虚而阳炽者。"}]},{"ID":"20240616084448-5sm5hfx","Type":"NodeParagraph","Properties":{"id":"20240616084448-5sm5hfx","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"投此味则相反若冰炭。（阴已虚而更燥之。阳已炽而更益之。可乎。）每见粗工治阴虚证。亦用参术理脾。大属梦梦。经曰。脏腑各因其经而受气于阳明。故为胃行其津液。盖气阳也。"}]},{"ID":"20240616084448-qwi59bi","Type":"NodeParagraph","Properties":{"id":"20240616084448-qwi59bi","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"各脏腑之阳。皆禀于胃经者。血脉之所注阴也。各脏腑之阴。皆源于脾。脏腑各因脾之经。"}]},{"ID":"20240616084448-l9atuys","Type":"NodeParagraph","Properties":{"id":"20240616084448-l9atuys","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"而乃受气于阳明者。以阳原出于阴中也。因脾之经而必行其津液者。经脉固液所化也。（脾患于湿。则阴不化。而津液不生。白术之理胃益脾。能令生津以通经。乃得由经以达气。）经曰。四肢皆禀气于胃。今脾不能为胃行其津液。四肢不得禀水谷气。气日以衰。脉道不利。"}]},{"ID":"20240616084448-92luqdv","Type":"NodeParagraph","Properties":{"id":"20240616084448-92luqdv","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"筋骨肌肉皆无气以生。玩此数语。则白术之理胃。以其健阳。而真气并于谷气。能行于诸脏腑也。其能行于诸脏腑者。以其健胃阳。而即能化脾阴。致其津液。以荣血脉通经隧也。经曰。五脏皆禀气于胃。而不得至经。必因于脾。乃得禀也。数语透露极矣。白术以除湿益气为功。则凡湿皆用术乎。曰。湿分内外。尤别寒热。属于寒是阳郁阴中而不升也。阴之所蓄则气虚矣。属于热是阴困阳中而不降也。阳之所并则气实矣。虚实皆属气。气之虚实皆化湿。"}]},{"ID":"20240616084448-v30tkk2","Type":"NodeParagraph","Properties":{"id":"20240616084448-v30tkk2","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"但实者邪气之实也。尚可投术以益气乎。夫湿为地气。阳蓄于阴。是地气因天气之郁而不化。"}]},{"ID":"20240616084448-tn4syep","Type":"NodeParagraph","Properties":{"id":"20240616084448-tn4syep","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"阴困于阳。是地气受天气之并而不化。总之化湿者皆阴。而阴之所以化湿者。皆本于阳之不能化。唯一虚一实。而投治乃殊。虚者补正以益气。如白术茯苓是也。实者除邪以益气。如连柏栀黄皆可燥湿。不执二术为用也。夫气者水所生阴生阳也。液者气所化阳化阴也。气能化液。何湿之有。如气虚不能化。补其阳而液自化矣。（液之所化。即气之所到也。）至气实而不化者。不等于真气之不足。乃病于真气之受伤。必先除其所伤之邪。盖抑阳则阴化。（阴受并于阳则亦不化故也。）阴化则液行。液行则湿除。湿除则气益矣（气与湿不能相离以为本。除湿益气。亦不能相离以为用。特益正除邪。贵于适事为故耳。）第寒热虚实之用术。"}]},{"ID":"20240616084448-ofwd86j","Type":"NodeParagraph","Properties":{"id":"20240616084448-ofwd86j","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"如斯较然。而又谓其能治风证。何也。曰。风亦有别。阳虚阴蓄。阴固非真阴也。阴久不化。"}]},{"ID":"20240616084448-inhrjre","Type":"NodeParagraph","Properties":{"id":"20240616084448-inhrjre","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"则阳从之而化风。是谓风虚。所宜活血（即气能化液也）以化阴。而补其风虚者也。（白术补肝风虚）阳盛阴困。阳固非真阳也。阳久不化。则阴从之而化风。是谓风实。所宜清气以化阳。而疏其风实者也。（风皆属阳。风虚者阳从乎阴以病血也。故应治血。风实者阴从乎阳以病气也。故应治气。）二治于兹味宜否。所当酌处矣。总之。因湿化热。因热化湿。皆患于阴不得阳以化。太阴之脾不能行其液以通经脉而增湿。致胃气不能达于三阴三阳以增热。"}]},{"ID":"20240616084448-pcio4c8","Type":"NodeParagraph","Properties":{"id":"20240616084448-pcio4c8","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"展转相因。为病乃剧耳。经曰。经隧者气血所从出之道也。气血之道壅。而经络阻绝。如卒中之类。孰非热化湿。湿更化热以亡其阴之为病乎。又如反胃中满。非皆湿热驯致以至此极乎。丹溪所以云人身湿热为病居多也。抑白术主治。有腹满呕逆等证。固非湿热欤。曰。此皆阳虚化湿之的对。至阳盛而热化湿者。当先责其本于热。惟皆本于阳之不能化阴。故虽投剂清热。以期阴之能化。而或攻或补。又不可伤其真阳以绝化原。故亦有不能舍术之时也。"}]},{"ID":"20240616084448-8mw1k8y","Type":"NodeParagraph","Properties":{"id":"20240616084448-8mw1k8y","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"湿热之证。无如七情所伤者。伤于阴而不能化阳。以致气郁成湿。湿郁化热。但究其本。是阴气有伤。非若阴盛蓄阳之湿热也。虽不宜寒降。宜除湿理脾。其可投二术之辛燥以亡阴乎。"}]},{"ID":"20240616084448-to0w3gm","Type":"NodeParagraph","Properties":{"id":"20240616084448-to0w3gm","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"此证关于神思。乃阳中之阴伤。虽曰不宜凑阳。而宜裕阴和气。却不可以纯阴濡剂绝其化原。"}]},{"ID":"20240616084448-7p0ryp7","Type":"NodeParagraph","Properties":{"id":"20240616084448-7p0ryp7","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"即二冬犹虑其滞阳也。近代程若水。每用茯神石枣丹皮滋阴降火。茯苓薏仁木瓜车前健脾行湿。佐山楂石菖蒲以行湿滞。殊有理会。斯证患之者最多。因误治而夭枉者不少。故特表而出之。人身之病。惟痰为多。而为害最甚。自真阴虚损之火痰。先以补益真阴为急。外困六淫之气痰。先以祛除外邪为急。饮食积聚之郁痰。先以导散郁滞为急。此外。凡内伤中气而为虚痰。为湿痰。未有不以理中气为本者也。盖不补脾气。则液不化。痰不行。不行不化。"}]},{"ID":"20240616084448-7xhdcqc","Type":"NodeParagraph","Properties":{"id":"20240616084448-7xhdcqc","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"将脾胃之气愈困。而不能行气于阴阳。即经隧之道塞。而不能通营血以归于血海。将下焦之元阴愈虚。上焦之虚热更生。真阴日亏。而真阳日惫。是惟老人最甚。此际健脾行痰者。无过白术而已。然须的审其可投而投之。抑或其初未可。而需后乃可。庶几信心以奏效也。"}]},{"ID":"20240616084448-lgi14ov","Type":"NodeParagraph","Properties":{"id":"20240616084448-lgi14ov","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"缪氏云。术燥肾而闭气。肝肾有动气脐间筑筑者。勿服。刘涓子云。痈疽溃疡。服之反生脓作痛。"}]},{"ID":"20240616084448-gb7jsfg","Type":"NodeParagraph","Properties":{"id":"20240616084448-gb7jsfg","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"〔修治〕弗用油者。去皮切片。米泔水浸透。晒干。陈壁土裹。蒸晒九次。洗净。仍晒干。用此法窃土气以助脾。入乳汁润之。制其性也。脾病则陈壁土炒。其脾虚而气滞者。枳实煎水渍炒。或香附煎水渍炒。枳术丸用白术。须以紫苏薄荷黄芩肉桂汤煮过。"}]},{"ID":"20240616084448-94o8yjb","Type":"NodeParagraph","Properties":{"id":"20240616084448-94o8yjb","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"味甘微苦而辛。气温。可升可降。阴中阳也。入足太阴阳明手太阴阳明太阳之经。禀初夏之气以生。其味苦甘而浓。其气芳烈而温。其性纯阳而健。为除风痹之上药。安脾胃之神品。（仲淳）主治除湿。（其体轻浮。气力雄壮。能去皮肤间腠理湿）发汗。（与白术止汗特异）总解诸郁。（痰火湿食气血六郁。皆因传化失常。不得升降。病在中焦。"}]},{"ID":"20240616084448-kgwy3wr","Type":"NodeParagraph","Properties":{"id":"20240616084448-kgwy3wr","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"苍术气"}]},{"ID":"20240616084448-ywmfby9","Type":"NodeParagraph","Properties":{"id":"20240616084448-ywmfby9","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"味辛烈。强胃强脾。发谷之气。能径入诸经。疏泄阳明之湿。通行敛涩。故郁散而平。）疏滞宽中。强胃安脾。治湿痰留饮。心下急满。水肿胀满。或挟瘀血成窠囊。止寒湿呕逆。"}]},{"ID":"20240616084448-pv0c5w6","Type":"NodeParagraph","Properties":{"id":"20240616084448-pv0c5w6","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"下泄冷痢。治痿疗疸。及风寒湿痹。更脾湿下流。浊淋带下。（仁斋谓脾精不禁。小便漏浊淋不止。腰背酸疼。宜用苍术以敛脾精。所谓敛者。即除湿而不使脾淫。同于东垣除湿下安太阴之义。非别有收敛之功也。）阴寒疝气。腹中窄狭者。须用之。（洁古）引以黄柏牛膝石膏下行之药。治下焦湿。同白术。治胫足湿肿。入平胃散。去中焦湿。平胃中有余之气。入葱白麻黄之类。能散肉分至皮表之邪。同人参茯苓白芍甘草橘皮莲肉缩砂。为调中之正法。"}]},{"ID":"20240616084448-gxm0kqt","Type":"NodeParagraph","Properties":{"id":"20240616084448-gxm0kqt","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"健脾。开胃。消饮食。同藿香橘皮茯苓人参木瓜猪苓泽泻缩砂。治霍乱转筋吐泻。同干葛防风茯苓炙草猪苓泽泻车前。治湿泻若雷奔。同秦艽萆木瓜薏仁石斛桑寄生石菖蒲黄地黄甘草晚蚕砂桂枝。治一切痛痹。及关节不利。热者去桂枝。加黄柏。得黄柏牛膝木瓜石斛。"}]},{"ID":"20240616084448-tivfw63","Type":"NodeParagraph","Properties":{"id":"20240616084448-tivfw63","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"能健步潜行。得苦参牡蛎。治小儿胃家湿热。饮食不生肌肉。君人参芍药木瓜薏仁茯苓桑皮赤豆车前橘皮。佐以猪苓泽泻。治一切水肿。日重倍人参。夜重加地黄芍药。俱与术倍。"}]},{"ID":"20240616084448-d76i3ch","Type":"NodeParagraph","Properties":{"id":"20240616084448-d76i3ch","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"君枳实半夏橘皮砂仁人参。除心腹胀满。消宿食。开胃。去痰涎。除伤食发寒热。及泄泻。"}]},{"ID":"20240616084448-dzuqqp4","Type":"NodeParagraph","Properties":{"id":"20240616084448-dzuqqp4","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"同人参橘皮茯苓木瓜藿香。治反胃吐逆。因寒加生姜。因热加竹茹枇杷叶逆水芦根。同麦冬石斛黄柏白芍木瓜薏仁五味子。为治痿要药。同生姜藿香槟榔。治山岚瘴气。同四物麦冬荆芥防风地榆。治肠风下血。同补骨脂川椒茴香青盐川楝子黄柏。治疝。"}]},{"ID":"20240616084448-0n9pm2o","Type":"NodeParagraph","Properties":{"id":"20240616084448-0n9pm2o","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"附方治蛊胀由于脾虚有湿者。真茅术末。每清晨米饮调三钱。服不数月。强健如故。"}]},{"ID":"20240616084448-f9smebb","Type":"NodeParagraph","Properties":{"id":"20240616084448-f9smebb","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"苍术丸。老年常服。饮啖可过少壮。真茅术四斤。如法洗浸。去皮切片。以桑椹怀生地何首乌各一斤。熬浓汁。至无味而止。去渣滤清。下苍术浸之。晒干复浸。汁尽为度。研末。又以人乳拌匀。晒干数次。约重数两。炼蜜丸。白汤或酒吞数钱。治痹。可令年老身轻。矫捷甚于少年。真茅术十斤。洗净。先以米泔浸三宿。再用蜜酒浸一宿。去皮。用黑豆一层。拌苍术一层。蒸二次。再用蜜酒蒸一次。用河水砂锅内熬浓汁。去渣。隔汤煮滴水成珠为度。"}]},{"ID":"20240616084448-cncl1dd","Type":"NodeParagraph","Properties":{"id":"20240616084448-cncl1dd","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"每膏一斤。和炼蜜一斤。白汤调服。本事方治停饮囊。去湿崇土以填窠臼。用苍术一斤。"}]},{"ID":"20240616084448-2281p8m","Type":"NodeParagraph","Properties":{"id":"20240616084448-2281p8m","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"去皮切片。为末。油麻五钱。水二盏。研滤汁。大枣五十枚。煮去皮核。捣和丸梧子大。每空腹温服五十丸。增至一二百丸。初服必觉微燥。以山栀子末沸汤点服解之。三月疾除。忌桃李雀肉。"}]},{"ID":"20240616084448-saffx8f","Type":"NodeParagraph","Properties":{"id":"20240616084448-saffx8f","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"〔论〕白术之味始甘。次有微辛。后归于苦。苦味居多。苦从火化。火乃土之母也。"}]},{"ID":"20240616084448-1bqdrys","Type":"NodeParagraph","Properties":{"id":"20240616084448-1bqdrys","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"故为健脾胃之主。苍术始甘。次苦。后归于辛。辛味居多。辛从金化。金乃土之子也。故能行脾胃之化。盖脾不主湿。则阴气无以达于阳。而卫气先病。营即随之。苍术之能发谷气。"}]},{"ID":"20240616084448-7tthfqg","Type":"NodeParagraph","Properties":{"id":"20240616084448-7tthfqg","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"犹水谷悍气。剽疾滑利。先卫而后营。与白术之健运于中者自别。有谓其气极雄壮通行脾肾者。讵知脾与三阴同居于下。脾阴至肺。肾阴亦至于肺。脾之至阴。藉燥而辛烈者。以发谷气。俾上行至肺而肾亦至矣。且谷气发越。则凡阳明之气所至者皆能至之。丹溪所谓上中下除湿皆可用也。"}]},{"ID":"20240616084448-zcflwm8","Type":"NodeParagraph","Properties":{"id":"20240616084448-zcflwm8","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"阴虚便燥。渴而火亢者。忌之。血虚怯弱。及七情气闷者。慎用。虚火动而痞闷。愈宜远。"}]},{"ID":"20240616084448-r7t5l3m","Type":"NodeParagraph","Properties":{"id":"20240616084448-r7t5l3m","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"〔辨治〕出茅山。细而带糖香味甘者真。米泔浸洗极净。刮去皮。拌黑豆蒸引之。合水气也。又拌蜜酒蒸。又拌人乳透蒸。皆润之使更合于金气而不燥也。凡三次蒸时。须烘晒极干。气方透。胎中酒蒸。平用泔制。（能）缪氏云。二术俱为阳草。故祛邪之功胜。而益阴之效亏。药性偏长。物无兼力。此物生自然之道也。凡脏皆属阴。若脾虚无湿者用之。反损脾阴而竭津液。此最易误。"}]},{"ID":"20240616084448-xb3omj4","Type":"NodeParagraph","Properties":{"id":"20240616084448-xb3omj4","updated":"20240616084448"},"Children":[{"Type":"NodeText","Data":"〔总论〕术之用。补中益气。力优在白。除湿快气。能专于苍。所谓祛邪之功胜。而益阴之效亏者。当以坐苍。不得概蔽之白。至于燥肾闭气。又宜坐白。不能混及于苍。（前人以枳实佐白术良有深意）凡病脾土虚者。无论湿邪之有无。白术皆所急需。但不宜于胃有实热者耳。"}]},{"ID":"20240616083542-s88y7uc","Type":"NodeThematicBreak","Properties":{"id":"20240616083542-s88y7uc"}},{"ID":"20240616083558-rymmi1d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083558-rymmi1d","updated":"20240616083602"},"Children":[{"Type":"NodeText","Data":"白术《本草撮要》"}]},{"ID":"20240616083558-5wr59bd","Type":"NodeParagraph","Properties":{"id":"20240616083558-5wr59bd","updated":"20240616083558"},"Children":[{"Type":"NodeText","Data":"味辛甘．入足太阴经．功专除湿益气．得枳实．能涤饮消痞．得条芩能安胎．无湿者禁用．溃疡亦忌．以能生脓作痛也．和脾糯米泔浸．助脾土炒．或蜜水炒人乳拌以制燥．千金方齿长退场门．名曰髓溢．单用白术愈．"}]},{"ID":"20240616083542-u4ppfds","Type":"NodeThematicBreak","Properties":{"id":"20240616083542-u4ppfds"}},{"ID":"20240616083543-y0xblho","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083543-y0xblho","updated":"20240616083552"},"Children":[{"Type":"NodeText","Data":"白术《本草便读》"}]},{"ID":"20240616083543-nigg6eu","Type":"NodeParagraph","Properties":{"id":"20240616083543-nigg6eu","updated":"20240616083543"},"Children":[{"Type":"NodeText","Data":"补脾燥湿．法干健之功能．冬采野生．随坤土而运用．化水痰于胃脘．腰脐血结并能搜．进饮食于太仓．妊妇胎元均赖固．脾虚久泻．温燥多灵．痹着诸邪．苦甘有力．（白术产浙江安徽等处．以于潜野生者为佳．土人皆用种法种之．冬采者为冬术．以冬令则精华汇聚于根也．为补脾之正药．脾喜温燥．白术之性气温而燥．能补脾而资其健运．脾健则运化有权．诸病皆愈耳．白术虽燥．中有膏汁．虽日晒后即复还软．刚中有柔．故脾阴不足者．亦可蜜炙用之．白术之补脾燥湿．当与陈皮茯苓同用．否则恐有滞性．以其中含津液．是以能闭气．故又宜土炒用之．）"}]},{"ID":"20240616083037-5nlxxb8","Type":"NodeThematicBreak","Properties":{"id":"20240616083037-5nlxxb8"}},{"ID":"20240616083528-90gftwr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083528-90gftwr","updated":"20240616083534"},"Children":[{"Type":"NodeText","Data":"白术《增广和剂局方药性总论》"}]},{"ID":"20240616083528-q6hih2l","Type":"NodeParagraph","Properties":{"id":"20240616083528-q6hih2l","updated":"20240616083528"},"Children":[{"Type":"NodeText","Data":"味苦甘，温，无毒。主风寒湿痹，死肌痉疸，止汗，除热，消食。主大风在身面、风头痛，目泪出，消痰水，逐皮间风水结肿，除心下急满及霍乱吐下不止，利腰脐间血，益液，暖胃，消谷嗜食。《药性论》云∶君。忌∶桃、李、雀肉、菘菜、青鱼。味甘辛，无主多年气痢，心腹胀痛，破消宿食，开胃，治水肿胀满。日华子云∶治五劳七伤，冷气补腰膝及筋骨弱软， 癖气块，妇人冷症瘕，温疾，山岚瘴气。除烦长肌，又治内外障防风、地榆为之使。《仙经》云∶亦能除恶气，弥灾 。今处处有之，出茅山者佳。"}]},{"ID":"20240616083038-m6r2uwr","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-m6r2uwr"}},{"ID":"20240616083519-up7z3pp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083519-up7z3pp","updated":"20240616083523"},"Children":[{"Type":"NodeText","Data":"白术《冯氏锦囊秘录》"}]},{"ID":"20240616083519-2vnssiq","Type":"NodeParagraph","Properties":{"id":"20240616083519-2vnssiq","updated":"20240616083519"},"Children":[{"Type":"NodeText","Data":"禀初夏之气以生，味苦气温，从火化也。得土之冲气，益之以甘，昭土德也，故无毒。其气芳烈，其味甘浓，其性纯阳，较之于苍术补多燥减矣。浙术即名云术，由粪力滋溉，肥大易油。敛术即俗名狗头术，瘦小燥白，得土气甚充，反胜云术，宜囫囵米泔水浸一宿切片晒干，炒深黄。如入滋阴药，人乳拌炒；如入止泻药，东壁土拌炒；如入膨胀药，麸皮拌炒。"}]},{"ID":"20240616083519-8bf4w3r","Type":"NodeParagraph","Properties":{"id":"20240616083519-8bf4w3r","updated":"20240616083519"},"Children":[{"Type":"NodeText","Data":"白术，暖脾益津，除湿益燥，腱脾进食，消谷补中，除胃虚停饮，理心下急痛，补劳倦内伤，祛周身湿痹，驱胃脘食积痰涎，皮毛间风，腰脐间血，手足懒举贪眠。"}]},{"ID":"20240616083519-75p0j0r","Type":"NodeParagraph","Properties":{"id":"20240616083519-75p0j0r","updated":"20240616083519"},"Children":[{"Type":"NodeText","Data":"在气主气，在血主血，中气不足，脾胃诸虚之圣药也。同枳实能消症，同黄芩能安胎。"}]},{"ID":"20240616083519-e5ywvg1","Type":"NodeParagraph","Properties":{"id":"20240616083519-e5ywvg1","updated":"20240616083519"},"Children":[{"Type":"NodeText","Data":"有汗则止，无汗则发，喘症哮症忌用。"}]},{"ID":"20240616083519-2n5936f","Type":"NodeParagraph","Properties":{"id":"20240616083519-2n5936f","updated":"20240616083519"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 健脾止泻，补虚敛汗，发泡浆溢者多加。然在浓时用之，则湿润之气不行，而痘难成浆矣。并热盛喘嗽，音哑烦渴，热毒烦躁者，并禁之。惟泻泄虚渴者，并水泡多，或胖甚不痂者，及中气大虚者甚宜。"}]},{"ID":"20240616083519-0s598ux","Type":"NodeParagraph","Properties":{"id":"20240616083519-0s598ux","updated":"20240616083519"},"Children":[{"Type":"NodeText","Data":"按∶白术，甘温得中土之冲气，补脾胃之第一品也。术赞云∶味重金浆，芳逾玉液，百邪外御，六腑内充，察草木之盛，益于己者，并不及术之多功也。每遇暴病尺虚，中气欲脱之症，用此馨香冲和之味，托住中气，真矣奇功，不亚人参。试思古人理中术附二汤，咸仗为君，补虚续绝诸方，必兼佐用，但不无少偏于燥性，久服宁免偏胜。未若人参纯得阳和之气，可久服单服也。奈俗医往往概嫌其滞，一坐未读本草，一坐炮制未精耳，但其间有动气筑筑，及阴虚燥渴，便闭者禁之。"}]},{"ID":"20240616083038-pbggqf4","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-pbggqf4"}},{"ID":"20240616083508-7xzak4z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083508-7xzak4z","updated":"20240616083513"},"Children":[{"Type":"NodeText","Data":"白术《顾松园医镜》"}]},{"ID":"20240616083508-1d507d4","Type":"NodeParagraph","Properties":{"id":"20240616083508-1d507d4","updated":"20240616083508"},"Children":[{"Type":"NodeText","Data":"〔甘苦温，入脾、胃二经。于潜者佳。泔浸土蒸，蜜水拌炒。〕健脾强胃，消谷嗜食，〔土恶湿，湿去则脾健而消谷，胃强而嗜食。〕化痰逐水，消肿止泻。〔湿客中焦则生痰生水，湿胜则为泻为肿，除湿则诸症自安。〕君枳实以消痞，〔强脾胃之力。〕佐黄芩而安胎，〔化湿热之功。〕益气和中除湿之圣药也。人但知白术补脾，而不知脾恶湿，湿去则脾健，故曰补也。"}]},{"ID":"20240616083508-h000jb1","Type":"NodeParagraph","Properties":{"id":"20240616083508-h000jb1","updated":"20240616083508"},"Children":[{"Type":"NodeText","Data":"若脾虚而无湿邪者用之，反燥竭津液，是损脾阴矣，此最误人，特表出之。凡阴虚内热，便秘滞下，肝、肾有动气者勿服。"}]},{"ID":"20240616083038-ggxxnfp","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-ggxxnfp"}},{"ID":"20240616083457-9rqxf2c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083457-9rqxf2c","updated":"20240616083502"},"Children":[{"Type":"NodeText","Data":"白术《长沙药解》"}]},{"ID":"20240616083457-4lhqwzq","Type":"NodeParagraph","Properties":{"id":"20240616083457-4lhqwzq","updated":"20240616083457"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】术。味苦温。主风寒湿痹死肌，痉疸，止汗，除热，消食，作煎饵。久服轻身延年，不饥。一名山蓟，生山谷。"}]},{"ID":"20240616083457-umwo7ih","Type":"NodeParagraph","Properties":{"id":"20240616083457-umwo7ih","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"味甘、微苦，入足阳明胃、足太阴脾经。补中燥湿，止渴生津，最益脾精，大养胃气，降浊阴而进饮食，善止呕吐，升清阳而消水谷，能医泄利。"}]},{"ID":"20240616083457-rqph70s","Type":"NodeParagraph","Properties":{"id":"20240616083457-rqph70s","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂枝附子去桂加白术汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"甘草二两，大枣六枚，生姜两半，附子一枚，白术一两"},{"Type":"NodeText","Data":"。治风湿相抟，身体疼烦，大便坚，小便自利者。以汗出遇风，表闭汗回，流溢经络关节，营卫郁阻，是以疼烦。若小便不利，此应桂枝加附子，暖水达木，以通水道。今大便坚，小便自利，则湿兼在表而不在里。而水道过通，恐亡津液，故去桂枝之疏泄，加白术以补津液也。"}]},{"ID":"20240616083457-k4c97nq","Type":"NodeParagraph","Properties":{"id":"20240616083457-k4c97nq","updated":"20240616083457"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"越婢加术汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"麻黄六两，石膏半斤，甘草二两，生姜三两，大枣十二枚，白术四两"},{"Type":"NodeText","Data":"。治里水，一身面目黄肿，小便自利而渴者。以皮毛外闭，湿气在经，不得泄路，郁而生热，湿热淫蒸，是以一身面目黄肿。若小便不利，此应表里渗泻，以驱湿热。今小便自利而渴，则湿兼在表，而不但在里。便利亡津，是以发渴。甘草、姜、枣，补土和中，麻、膏，泻经络之湿热，白术补脏腑之津液也。"}]},{"ID":"20240616083457-uky37w9","Type":"NodeParagraph","Properties":{"id":"20240616083457-uky37w9","updated":"20240616083457"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麻黄加术汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"麻黄三两，桂枝二两，甘草一两，杏仁七十枚，白术四两"},{"Type":"NodeText","Data":"。治湿家身烦疼者。以湿郁经络，皮毛不泄，故身烦疼。麻黄汤泄皮毛以驱湿，恐汗去而津亡，故加白术，以益津也。此即里水之证，小便不利者也。"}]},{"ID":"20240616083457-yafolpn","Type":"NodeParagraph","Properties":{"id":"20240616083457-yafolpn","updated":"20240616083457"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"理中丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在人参"},{"Type":"NodeText","Data":"。治霍乱吐利。若脐下筑者，肾气动也，去术，加桂四两，去术之滞，加桂枝益肝阳而伐肾阴也。吐多者，去术，加生姜三两，去术之壅，加生姜降逆而止呕吐也。腹满者，去术，加附子一枚，去术之闭，加附子开瘀浊而消胀满也。下多者，仍用术，以其固脱陷而止泄也。渴欲得水者，加术足前成四两半，以其生津液而去湿也。"}]},{"ID":"20240616083457-pxoax8q","Type":"NodeParagraph","Properties":{"id":"20240616083457-pxoax8q","updated":"20240616083457"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白术散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"白术、蜀椒、川芎、牡蛎等分"},{"Type":"NodeText","Data":"。妊娠养胎。以胎妊之病，水寒土湿，木气郁结，而克脾土，则脾困不能养胎。白术补土燥湿，蜀椒暖水敛火，芎?疏乙木之郁，牡蛎消肝气之结也。"}]},{"ID":"20240616083457-v9ebtvn","Type":"NodeParagraph","Properties":{"id":"20240616083457-v9ebtvn","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"脾以太阴而抱阳气，故温升而化木火，胃以阳明而含阴精，故清降而生金水。胃降则空虚而善容，是以食下而不呕，脾升则磨荡而善腐，是以谷消而不利。五行之性，火燥而水湿，太阴脾土，升自水分，因从水分而化湿，阳明胃土，降于火位，因从火位而化燥。太阴之湿济阳明之燥，阳明之燥济太阴之湿，燥湿调和，中气轮旋，是以胃纳脾消，吐利不作。"}]},{"ID":"20240616083457-ftgtt44","Type":"NodeParagraph","Properties":{"id":"20240616083457-ftgtt44","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"但太阴脾土以湿土司令，阳明胃从燥金化气。辛金己土，俱属太阴，而辛金不如己土之湿，庚金戊土，俱属阳明，而戊土不如庚金之燥，缘化于人，不敌主令于己者之旺也。人之衰也，火日亏而水日盛，燥日消而湿日长，湿则中气凝郁，枢轴不运，升降反作，脾陷胃逆。脾陷则乙木不达，下克己土，水谷不消而为泄，胃逆则甲木失归，上克戊土，饮食不纳而为呕。白术补土燥湿，土燥而升降如前，是以吐泄兼医。"}]},{"ID":"20240616083457-760e6e8","Type":"NodeParagraph","Properties":{"id":"20240616083457-760e6e8","updated":"20240616083457"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"理中汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在人参"},{"Type":"NodeText","Data":"。用之以治痞满呕泄，盖与姜、甘、人参温补中气，转其升降之轴，自复清浊之位也。其性守而不走，故于补虚故固脱，独擅其长，而于疏通宣导，则未能焉。若脐动腹满诸证，非姜、桂、附子，不能胜任矣。"}]},{"ID":"20240616083457-hf4p7tw","Type":"NodeParagraph","Properties":{"id":"20240616083457-hf4p7tw","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"凡去湿之品，每伤于燥。白术气味浓郁，汁浆淳厚，既养胃气，亦补脾气，最生津液，而止燥渴。仲景用之于桂枝、麻黄之内，汗去而津液不伤，至妙之法也。"}]},{"ID":"20240616083457-n6ziqxa","Type":"NodeParagraph","Properties":{"id":"20240616083457-n6ziqxa","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"盖湿淫之病，善伤津液。以土燥金清，则肺气降洒，而化雨露。其露气之氤氲而游溢者，浸润滑泽，是谓之津。津液渗灌，脏腑沾濡，是以不渴。湿则气滞津凝，淫生痰涎，脏腑失滋，每生燥渴。津液无多，而再经汗泄，湿愈而燥伤矣。加白术去湿而养津，此除湿发汗之金绳也。"}]},{"ID":"20240616083457-77r8nh2","Type":"NodeParagraph","Properties":{"id":"20240616083457-77r8nh2","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"水火之交，其权在土。水化而为木火，由己土之左旋，火化而为金水，缘戊土之右转，土者，水火之中气也。中气旺则戊土蛰封，阴降而抱阳，九地之下，常煦然而如春，己土升发，阳升而含阴，九天之上，常凛然而如秋。中气衰则戊土逆升，失其封蛰之职，火飞而病上热，己土顺陷，乖其发达之政，水沉而病下寒，是以火热水寒之病，必缘土败。仲景治水，五苓、真武、附子、泽泻诸方，俱用白术，所以培土而制水也。禹平水土，非土则水不可平。治天下之水者，莫如神禹，治一身之水者，莫如仲景，圣圣心符，天人不殊也。"}]},{"ID":"20240616083457-j1rg7b6","Type":"NodeParagraph","Properties":{"id":"20240616083457-j1rg7b6","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"白术性颇壅滞，宜辅之疏利之品。肺胃不开，加生姜、半夏以驱浊，肝脾不达，加砂仁、桂枝以宣郁，令其旋补而旋行，则美善而无弊矣。"}]},{"ID":"20240616083457-64ml3fo","Type":"NodeParagraph","Properties":{"id":"20240616083457-64ml3fo","updated":"20240616083457"},"Children":[{"Type":"NodeText","Data":"产于潜者佳。选坚白肥鲜者，泔浸，切片，盘盛，隔布，上下铺湿米，蒸至米烂，晒干用。"}]},{"ID":"20240616083038-fugrqhu","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-fugrqhu"}},{"ID":"20240616083445-dg6gzrd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083445-dg6gzrd","updated":"20240616083450"},"Children":[{"Type":"NodeText","Data":"白术《本草思辨录》"}]},{"ID":"20240616083445-sf1m70s","Type":"NodeParagraph","Properties":{"id":"20240616083445-sf1m70s","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"邹氏云∶脾主升举清阳，胃主通降浊阴，皆属土而畏湿。术开花于初夏，结实于伏时，偏于湿热弥漫之际，显其有猷有为，确知其入脾胃，能力固中气，外御湿侮矣。刘氏亦脾胃同论，而以为先胃而后及脾。张隐庵则专主益脾而不及胃。窃思胃为阳明燥金，脾为太阳湿土，土必名湿者，即隐庵所谓土有湿气，始能灌溉四旁，如地得雨露而后发生万物也。白术味甘多脂，有似湿土，非脾之正药而何。其肉白，老则微红，味复带辛，故能由脾及胃而达肌表白术除脾湿，固中气，为中流之砥柱。其散表邪，非辅以麻黄桂枝附子之属，不能由肌肉而透皮毛。盖其味浓而甘，擅长于守也。麻黄桂枝附子，为走散风寒之剂，加以白术除湿，则为治风湿，治寒湿。无湿不加，故麻黄桂枝附子多用于伤寒太阳病，而术惟有水气始用之。邹氏云∶仲圣治风寒湿痹方，多有不用术者，以术于风胜湿胜者为最宜，寒胜者差减。"}]},{"ID":"20240616083445-jj8hkoc","Type":"NodeParagraph","Properties":{"id":"20240616083445-jj8hkoc","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"盖风胜必烦，湿胜必重。金匮中治痹用术诸方，非兼烦必兼重。或云身烦疼，或云身体疼烦，或云骨节烦疼掣痛，或云腹重，或云头重，或不烦不重，而云身体疼、手足寒、骨节痛，是析风与湿与寒而三之矣。不知仲圣方言烦者未尝不兼湿，言重者未尝不兼风，言寒者未尝不兼风与湿，核诸本经主风寒湿痹，无不吻合。邹氏徒泥于字面而不知细审，遂并白术性用而胥失之矣。"}]},{"ID":"20240616083445-ccdnqlf","Type":"NodeParagraph","Properties":{"id":"20240616083445-ccdnqlf","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"凡仲圣方用桂至四两，必为利小便与下肾邪，桂枝附子去桂加白术汤，又明云大便硬小便自利去桂，大便不硬小便不利当加桂，是桂枝之能利小便无疑矣。乃尤氏解此方云∶大便硬小便自利，知其人在表之阳虽弱，而在里之气自治。则皮中之湿，所当驱之于里，使水从水道而出，不必更出之表以危久弱之阳，故去桂枝之辛散，加白术之苦燥，合附子之大力健行者，于以并走皮中逐水气。夫去桂以小便利也。今去桂而犹欲驱湿从水道出，不知其意何居。况既云当驱之于里，不必更出之表，而又云加白术合附子，以并走皮中逐水气，不仍出之于表乎。是尤氏于本条语意，全未体会。邹氏之说，差胜于尤，而亦未见其当。其解去桂加术也。曰∶脾健则能制水，水在内能使下输膀胱而大便实，水在外能使还入胃中而大便濡。夫谓使在内之水下输膀胱，实非术之能事。仲圣加术，正取其不利小便。谓使在外之水还入胃中，则殆以大便硬而更崇其土，理不可晓，作此当然之想耳。按仲圣云，三服尽其人如冒状勿怪，此以术附并走皮中，逐水气未得除，故使之耳。可见术附并用，是使水从表除，不从里泄，即水不还入胃中之据。或谓如大便硬何。曰∶小便数者，大便必硬，此小便自利，即小便数也。皮中之水不当留而留，水府之水当留而不留，脾不举其职，而肠胃与膀胱之传化咸乖矣。去桂加术，则小便节而本有之津液不随之而亡，亦脾职复而后致之津液可由是而裕；水湿外除，津液内蒸，谁谓白术之加，不足以濡大便哉。"}]},{"ID":"20240616083445-lm1bapk","Type":"NodeParagraph","Properties":{"id":"20240616083445-lm1bapk","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"白术大明主反胃、利小便，洁古主生津、止渴，殆不善会仲圣方而致误耳。五苓散药止五味，而交相为用，中多奥旨。夫所谓脉浮发热者，表证也，烦渴小便不利者，里证也。太阳表邪化热传本，因而渴饮，因而水蓄不化，因而小便不利。解表止桂枝一味，治里亦第利水而不涤热，且利水用至四味，不更助燥增热乎。要知表未全解，尚属阳中有阴，不似阳明病可任寒药。水为阴邪，非辛甘温不化，桂枝虽不以利水，而化气必藉桂枝。猪苓茯苓亦太阳药，协桂枝则利水而亦解表。五味分两皆甚少，且以散服，多饮暖水，为出汗计者至矣。"}]},{"ID":"20240616083445-bordi9p","Type":"NodeParagraph","Properties":{"id":"20240616083445-bordi9p","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"而治里之法即具于其中。桂枝最少，欲其达表；泽泻最多，取其咸降；更以白术一味益中气，收水湿，安靖上下；而后表无不解，水无不行。表解水行，则热自撤，渴自止。若谓术能止渴、利小便，则实非其所长。茯苓泽泻汤治胃反吐，而渴欲饮水。胃反，是脾伤不磨，并挟饮邪，故以白术健脾胜水，非以止胃反。生姜半夏为治呕吐之专药，方有生姜无半夏者，以渴忌半夏也。白术味甘多脂，原能生津，观桂枝附子去桂加白术汤之治大便硬可见。然其性燥，用于有水湿之证，诚能使脾运而津生。若阴虚津枯，责效于白术，则白术谢不敏矣。"}]},{"ID":"20240616083445-of1jmaa","Type":"NodeParagraph","Properties":{"id":"20240616083445-of1jmaa","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"术之或去或加，见于理中丸者为多，欲明用术之道，于此求之，思过半矣。曰脐上筑者，肾气动也。去术加桂四两。肾气动，是欲作奔豚之征兆，以桂四两降而泄之，原有成法，见于伤寒金匮两书。加桂可矣，去术何为？夫土能制水，故千金以白术治髓溢，似此证正宜崇土；然术能御之不能泄之，不去术，则术横亘于中，足以掣桂之肘，此加桂所以必去术也。曰∶吐多者，去术加生姜二两；下多者还用术。猪苓汤、五苓散、茯苓泽泻汤，皆有吐不去术。生姜泻心汤、黄芩汤、四逆汤、白通汤，皆有下利不用术。兹何为不然？不知此为寒霍乱言耳。吐多者吐多于下，下多者下多于吐。吐多于下，则里湿尚轻而胃逆为甚，加生姜是以辛散之，去术为甘壅也。下多于吐，则脾湿重矣，健脾除湿，非术不可。故吐多去之，而下多必还用之。曰∶渴欲饮水者，加术足前成四两半。术非治渴之物，此不特不去而更加于前数，何故？盖理中所以温中，所以治寒多不用水之霍乱。今渴欲饮水，自非燥热之渴，乃因吐利重丧其津，而脾弱不振也。是虽有参以生津，而参以气胜，术以味胜。味胜者培中土而滋化源，尤为得力，故不加参而加术也。曰∶腹满者去术加附子一枚。洄溪谓阳虚，尤氏谓气脾，邹氏谓脾实。按证是脾寒，金匮有腹满为寒之文，又观所加为附子，其为阳虚无疑。若是脾实，则当与以浓朴七物大柴胡大承气之属，与此悬绝矣。四逆温肾用姜附，此温脾亦用姜附。盖肾寒阳虚，必侵及脾，故以姜辅附。脾寒阳虚，其源由肾，故以附辅姜。其必去别录术除心下急满一语，须连上消痰水看；然术不能独任其责，亦惟中虚者宜之。金匮云∶病痰饮者，当以温药和之。苓桂术甘汤，四味皆相协以成功，无一味可缺。用于伤寒，则茯苓增一两以急下其水，白术减一两以微损其壅，为其气冲故也。而要非吐下之后，未必以术补虚。桂枝人参汤，证兼心下痞硬，而其用术也，以数下之后，利下不止，虚亦甚也。"}]},{"ID":"20240616083445-3cduj5e","Type":"NodeParagraph","Properties":{"id":"20240616083445-3cduj5e","updated":"20240616083445"},"Children":[{"Type":"NodeText","Data":"惟桂枝去桂加茯苓白术汤，表证未罢而去桂，心下满痛而加术，几令人不解。然服桂枝汤或下之，虽不切中病情，而病气亦已衰矣。头项强痛、翕翕发热，而脉不云浮，亦不恶寒恶风，翕翕乃微开微阖之象，是未可与头痛发热并论者，独水停心下满而微痛、无汗而小便不利，邪无从出，为是证之关键。盖太阳为寒水之府，头顶乃太阳经脉之所至，若非水停心下，前服桂枝汤即强痛可除。其不除者，半由寒水之不下行也。桂枝一味，无汗固忌，不治表亦无需乎桂，故去之。利小盒饭首推茯苓，故加之。水气因阳气不充而停，不益其气，病机不转，术益气而除湿，故加之。虽然甘壅之术，非满痛之心下所宜，其所以得收其效者，独赖有芍药以敛之耳。况术为脾家准对之药，得芍药自疾趋而入脾，得茯苓又相协而利水，水行则满痛必除，太阳之微邪，何至仍踞于表。甘草乃白术补虚之佐使。姜枣调营卫，使邪无所容，别录术主大风在身面，其所谓风，即海藏谓术补肝风虚之风。刘氏云∶阳虚阴蓄，久而阴不化，则阳从之而化风，是谓风虚。又云∶阳蓄阴中则气虚，气虚则生湿。是术之治风仍不离乎湿。金匮附近效术附汤一方，即治风虚之证也。别录又主风眩头痛目泪出，下句接以消痰水，盖以风眩本于痰水，消痰水即所以治风眩。邹氏谓湿与水与饮是一源三歧，历举金匮治眩与治湿治水各方以证之，并谓本经止汗除热，多系风湿相搏之证，如五苓散、防己黄汤、甘草附子汤，皆止汗除热之验，而不得用于温热之汗出身热，洵属确论。然其于金匮有不得其解者，谓小半夏加茯苓汤，治饮眩而不用术，以心下痞故。夫小半夏汤治呕吐之方也，药止三味，而必以小半夏加茯苓名之，明乎此以止呕吐利水为治也。虽然，呕吐因膈间有水，因膈间有水而眩悸，皆术所宜从事，即心下痞因饥而得者，亦何尝忌术；乃绝不许术阑入其间，诚不可解。愚盖细思而得其故焉，仲圣下字皆极有斟酌，呕吐而曰卒，卒字讵容忽过，呕吐由于卒致，则必膈间本无宿水，或因清阳偶弛，饮停不化，遂胃逆而为呕吐。脾固无恙，无虑其虚。以姜夏宣阳降逆于上，茯苓利水于下，足以疗之而有余。若再以甘壅之术，横于膈间，则非徒无益，而又害之矣。枳实薤白桂枝汤之治胸痹也，曰人参汤亦主之，一证而虚实不同，药即攻补相反，术之宜与不宜，不益可见哉。"}]},{"ID":"20240616083038-nmd3z8a","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-nmd3z8a"}},{"ID":"20240616083433-ro1ohg6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083433-ro1ohg6","updated":"20240616083437"},"Children":[{"Type":"NodeText","Data":"白术《本草备要》"}]},{"ID":"20240616083433-xi6uz8s","Type":"NodeParagraph","Properties":{"id":"20240616083433-xi6uz8s","updated":"20240616083433"},"Children":[{"Type":"NodeText","Data":"补脾燥湿"}]},{"ID":"20240616083433-wvev8fm","Type":"NodeParagraph","Properties":{"id":"20240616083433-wvev8fm","updated":"20240616083433"},"Children":[{"Type":"NodeText","Data":"苦燥湿（经曰∶脾苦湿，急食苦以燥之），甘补脾，温和中。在血补血，在气补气（同血药则补血，同气药则补气），无汗能发，有汗能止（湿从汗出，湿去汗止。止汗同 、芍之类，发汗加辛散之味）。燥湿则能利小便，生津液（既燥湿而又生津何也？汪机曰∶脾恶湿，湿胜则气不得施化，津何由生？用白术以除其湿，则气得周流，而津液生矣），止泄泻（凡水泻，湿也。腹痛肠鸣而泻，火也。水火相激则肠鸣。痛甚而泻，泻而痛减者食也。完谷不化气虚也。在伤寒下利，则为邪热不杀谷也。久泻名脾泄，肾虚而命火衰，不能生土也。有积痰壅滞，肺气不能下降，大肠虚而作泻者宜豁痰。有伤风泄泻者宜散风。如脾虚湿泻者宜白术。凡治泻，丸散优于汤剂），消痰水肿满，黄胆湿痹。补脾则能进饮食，祛劳倦（脾主四肢，虚则四肢倦怠），止肌热（脾主肌肉），化症癖（同枳实则消痞，一消一补，名枳术丸、荷叶烧饭为丸，脾运则积化也）。和中则能已呕吐，定痛安胎（同黄 则安胎，黄芩除胃热，白术补脾，亦除胃热，利腰脐间血。盖胎气系于脾，脾虚则蒂无所附，故易落。利腰脐血者，湿除则血气流行也）。血燥无湿者禁用。能生脓作痛，溃疡忌之（补气故也，凡胀满者忌用，白术闭气，然亦有塞因塞用者）。"}]},{"ID":"20240616083433-at6nxfw","Type":"NodeParagraph","Properties":{"id":"20240616083433-at6nxfw","updated":"20240616083433"},"Children":[{"Type":"NodeText","Data":"肥白者出浙地，名云头术；燥白者出宣歙，名狗头术，差胜于浙。用糯米泔浸（借谷气以和脾），陈壁土炒（借土气以助脾），或蜜水炒，人乳拌用（润以制其燥，《千金方》曰∶有人病牙齿退场门，艰于饮食者，名髓溢，单用白术愈）。"}]},{"ID":"20240616083038-19srk1c","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-19srk1c"}},{"ID":"20240616083421-yrd0718","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083421-yrd0718","updated":"20240616083426"},"Children":[{"Type":"NodeText","Data":"白术《汤液本草》"}]},{"ID":"20240616083421-luhjqhf","Type":"NodeParagraph","Properties":{"id":"20240616083421-luhjqhf","updated":"20240616083421"},"Children":[{"Type":"NodeText","Data":"气温，味甘。苦而甘、温，味浓气薄，阴中阳也。无毒。"}]},{"ID":"20240616083421-9raeaju","Type":"NodeParagraph","Properties":{"id":"20240616083421-9raeaju","updated":"20240616083421"},"Children":[{"Type":"NodeText","Data":"入手太阳、少阴经，足阳明、太阴、少阴、厥阴四经。"}]},{"ID":"20240616083421-nwag52f","Type":"NodeParagraph","Properties":{"id":"20240616083421-nwag52f","updated":"20240616083421"},"Children":[{"Type":"NodeText","Data":"《象》云∶除湿益燥，和中益气，利腰脐间血，除胃中热，去诸经之湿，理胃。"}]},{"ID":"20240616083421-p942gud","Type":"NodeParagraph","Properties":{"id":"20240616083421-p942gud","updated":"20240616083421"},"Children":[{"Type":"NodeText","Data":"洁古云∶温中去湿，除热，降胃气，苍术亦同，但味颇浓耳。下行则用之，甘温补阳，健脾逐水，寒淫所胜，缓脾生津去湿，渴者用之。"}]},{"ID":"20240616083421-5dyme70","Type":"NodeParagraph","Properties":{"id":"20240616083421-5dyme70","updated":"20240616083421"},"Children":[{"Type":"NodeText","Data":"《本草》∶在术条下，无苍、白之名。近多用白术治皮间风，止汗消痞，补胃和中，利腰脐间血。通水道，上而皮毛，中而心胃，下而腰脐。在气主气，在血主血。"}]},{"ID":"20240616083421-i0yfcdj","Type":"NodeParagraph","Properties":{"id":"20240616083421-i0yfcdj","updated":"20240616083421"},"Children":[{"Type":"NodeText","Data":"洁古又云∶非白术不能去湿，非枳实不能消痞。除湿利水道，如何是益津液。"}]},{"ID":"20240616083038-7z87uj7","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-7z87uj7"}},{"ID":"20240616083413-ud8hqxu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083413-ud8hqxu","updated":"20240616083417"},"Children":[{"Type":"NodeText","Data":"白术《本草择要纲目》"}]},{"ID":"20240616083413-3ii0vhd","Type":"NodeParagraph","Properties":{"id":"20240616083413-3ii0vhd","updated":"20240616083413"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616083413-pc7muoo","Type":"NodeParagraph","Properties":{"id":"20240616083413-pc7muoo","updated":"20240616083413"},"Children":[{"Type":"NodeText","Data":"甘温无毒．可升可降．阳中阴也．入手太阳少阴足太阴阳明少阴厥阴六经．（用乳汁润之．以制其性．脾病以陈壁土炒过．窃土气以助脾也．）"}]},{"ID":"20240616083413-p6hsdho","Type":"NodeParagraph","Properties":{"id":"20240616083413-p6hsdho","updated":"20240616083413"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616083413-9kegviq","Type":"NodeParagraph","Properties":{"id":"20240616083413-9kegviq","updated":"20240616083413"},"Children":[{"Type":"NodeText","Data":"温中去脾胃湿．除脾胃热．强脾胃气．进饮食．和脾胃以生津液．止肌热．治四肢困倦．目不能开．怠惰嗜卧．不思饮食．止渴安胎．凡中焦不受湿不能下利．必须白术以逐水益脾．非白术不能去湿．非枳实不能消痞．故枳术丸以之为君．然脾恶湿．湿胜则气不得施化．津液何由而生．故曰膀胱津液之府．气化则能出焉．用白术以除其湿．则气得周流．而津液自生矣．"}]},{"ID":"20240616083038-ueb2cu7","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-ueb2cu7"}},{"ID":"20240616083402-z526wax","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083402-z526wax","updated":"20240616083406"},"Children":[{"Type":"NodeText","Data":"白术《本经逢原》"}]},{"ID":"20240616083402-4oi7iw2","Type":"NodeParagraph","Properties":{"id":"20240616083402-4oi7iw2","updated":"20240616083402"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名山姜"}]},{"ID":"20240616083402-otqy3uz","Type":"NodeParagraph","Properties":{"id":"20240616083402-otqy3uz","updated":"20240616083402"},"Children":[{"Type":"NodeText","Data":"甘温，无毒。云术肥大气壅。台术条细力薄。宁国狗头术皮赤稍大，然皆栽灌而成，故其气浊，不若于潜野生者气清，无壅滞之患。入诸补气药，饭上蒸数次用。入肺胃久嗽药，蜜水拌蒸。入脾胃痰湿药，姜汁拌晒。入健脾药，土炒。入泻痢虚脱药，炒存性用。入风痹痰湿利水破血药，俱生用。然非于潜产者，不可生用也。"}]},{"ID":"20240616083402-aj58fml","Type":"NodeParagraph","Properties":{"id":"20240616083402-aj58fml","updated":"20240616083402"},"Children":[{"Type":"NodeText","Data":"《本经》主风寒湿痹，死肌痉疸，止汗除热，消食作煎饵。久服轻身延年，不饥。"}]},{"ID":"20240616083402-c4h3sr4","Type":"NodeParagraph","Properties":{"id":"20240616083402-c4h3sr4","updated":"20240616083402"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"白术甘温味浓，阳中之阴，可升可降，入脾胃二经。生用则有除湿益燥、消痰利水，治风寒湿痹死肌痉疸，散腰脐间血及冲脉为病，逆气里急之功。制熟则有和中补气，止渴生津，止汗除热，进饮食，安胎之效。《本经》主风寒湿痹，死肌痉疸者，正以风、寒、湿三者合而成痹，痹者，拘挛而痛是也。《经》曰∶地之湿气感则害人皮筋骨。死肌者，湿毒侵肌肉也。痉者，风寒乘虚客于肝肺肾经所致也。疸者，脾胃虚而湿热瘀滞也。如上诸证，莫不由风、寒、湿而成，术有除此三者之功，故能祛其所致之疾也。止汗除湿进食者，湿热盛则自汗，湿邪客则发热，湿去则脾胃燥，燥则食自消、汗自止、热自除矣。又主大风在身，而风眩头痛，目泪出，消痰水，逐皮肤间风水结肿，除心下急满及霍乱吐下不止，利腰脐间血，益津暖胃，消谷嗜食，得参、苓大补中气，得枳、橘健运饮食。《本经》言，消食作煎饵，留其滓以健运脾气，食自化矣。仲景五苓散，祖《素问》泽术麋衔汤并用生者，但彼兼麋衔以统血，则汗自止；此兼桂枝以通津，则渴自除。洁古枳术丸，祖《金匮》枳实汤，彼用生者以健胃，则逆满自愈。此用熟者以助脾，则饮食自强，且以荷叶裹饭为丸，取清震之气，以鼓克运之力也。盖白术得中宫冲和之气，补脾胃药以之为君，脾土旺则清气升而精微上，浊气降而糟粕输。仲淳有云∶白术禀纯阳之土气，除邪之功胜，而益阴之效亏。"}]},{"ID":"20240616083402-x6agzo5","Type":"NodeParagraph","Properties":{"id":"20240616083402-x6agzo5","updated":"20240616083402"},"Children":[{"Type":"NodeText","Data":"故病属阴虚血少，精不足，内热骨蒸，口干唇燥，咳嗽吐痰，吐血鼻衄齿衄，便闭滞下者，法咸忌之。术燥肾而闭气，肝肾有动气者勿服。刘涓子云∶痈疽忌白术，以其燥肾而闭气，故反生脓作痛也。凡脏皆属阴，世人但知白术能健脾，宁知脾虚而无湿邪者用之，反燥脾家津液，是损脾阴也，何补之有，此最易误，故特表而出之。"}]},{"ID":"20240616083038-nvpjxyu","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-nvpjxyu"}},{"ID":"20240616083351-is7u4az","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083351-is7u4az","updated":"20240616083355"},"Children":[{"Type":"NodeText","Data":"白术《本草新编》"}]},{"ID":"20240616083351-9wvkegr","Type":"NodeParagraph","Properties":{"id":"20240616083351-9wvkegr","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"白术，味甘辛，气温，可升可降，阳中阴也，无毒。入心、脾、胃、肾、三焦之经。除湿消食，益气强阴，尤利腰脐之气。（〔批〕白术利腰脐之气，原是利肾中之湿也。肾不湿则腰不疼，湿去而腰脐自利矣。）有汗能止，无汗能发，与黄 同功，实君药而非偏裨。往往可用一味以成功，世人未知也，吾今泄天地之奇。如人腰疼也，用白术二三两，水煎服，一剂而疼减半，再剂而痛如失矣。夫腰疼乃肾经之症，人未有不信。肾虚者用熟地、山茱以补水未效也，用杜仲、破故纸以补火未效也，何以用白术一味而反能取效。不知白术最利腰脐。腰疼乃水湿之气浸入于肾宫，故用补剂，转足以助其邪气之盛，不若独用白术一味，无拘无束，直利腰脐之为得。夫二者之气，原通于命门，脐之气通，而腰之气亦利，腰脐之气既利，而肾中之湿气何能久留，自然湿去而痛忽失也。通之而酒湿作泻，经年累月而不愈者，亦止消用此一味，一连数服，未有不效者。而且湿去而泻止，泻止而脾健，脾健而胃亦健，精神奋发，颜色光彩，受益正无穷也。是白术之功，何亚于人参乎。不特此也，如人患疟病，用白术二两、半夏一两，米饭为丸，一日服尽即愈。夫疟病，至难愈之病也。用柴胡、青皮散邪不效，用鳖甲、首乌逐邪不效，用草果、常山伐邪不效，何以用白术二两为君，半夏一两为臣，即以奏功，不知白术健脾开胃之神药，而其妙尤能去湿，半夏去痰，无痰不成疟，而无湿亦不成痰。利湿则痰已清其源，消痰则疟已失其党，况脾胃健旺，无非阳气之升腾，疟鬼又于何地存身哉。此效之所以甚捷也。由此观之，则白术非君药而何。推之二陈汤，必多加白术所以消痰也；四君子汤，必多加白术所以补气也；五苓散，必多加白术所以利水也；理中汤，必多加白术所以祛寒也；香薷饮，必多加白术所以消暑也。至于产前必多加白术以安胎，产后必多加白术以救脱，消食非多用白术何以速化，降气非多用白术何以遽定，中风非多用白术安能夺命于须臾，痞块非多用白术安能救困于败坏哉。人知白术为君药而留心于多用也，必能奏功如神矣。或问白术利腰脐而去湿，若不在腰脐者，似非可利，胡为凡有湿病皆不能外耶？此未明乎腰脐之义也。人之初生，先生命门。命门者，肾中之主，先天之火气也。有命门而后生五脏六腑，而脐乃成，是脐又后天之母气也。命门在腰而对乎脐，腰脐为一身之主宰。腰脐利而人健，腰脐不利而人病矣。凡有水湿，必侵腰脐，但有轻重之分耳。治水湿者，一利腰脐而水即入于膀胱，从小便而化出，所以得水必须利腰脐，而利腰脐必须用白术也。况白术之利腰脐者，利腰脐之气，非利腰脐之水也。腰脐之气利，则气即通于膀胱，而凡感水湿之邪，俱不能留，尽从膀胱外泄，是白术不利之利，正胜于利也。（〔批〕利气非泻气之谓，正利其气通膀胱也。膀胱非气不行，气闭则塞，气通则开。白术利气以利水，所以必用之也。）"}]},{"ID":"20240616083351-2n2m1yp","Type":"NodeParagraph","Properties":{"id":"20240616083351-2n2m1yp","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或问白术健脾去湿，为后天培土圣药，真缓急可恃者也。虽然人知白术益人，而不知白术之损人也。白术利水，则其性必燥。世人湿病，十居其四，而燥症十居其六。肺气之燥也，更用白术以利之，则肺气烁尽津液，必有干嗽之忧；胃气之燥也，更用白术以利之，则胃气炎蒸津液，必有口渴之虑。脾气之燥也，更用白术以利之，则脾气焦枯津液，必有肠结之苦。盖宜于湿者，不宜于燥也。去湿既受其益，则添燥安得不受其损哉。"}]},{"ID":"20240616083351-2dmxkks","Type":"NodeParagraph","Properties":{"id":"20240616083351-2dmxkks","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或疑白术乃去湿生津之上品，而先生谓其性燥，不可治肺、胃、脾三家之燥病，吾不得其义也。夫白术生津，但能生水火既济之津，不能生水火未济之津也。如湿病宜去其湿，则燥病宜解其燥，亦明矣，乃不解其燥，而反用燥以治之，即能生津，亦为火所烁矣。况白术去湿，则内无津液而外无水气，又从何而生津乎。此白术止可治湿而不可治燥也。虽然白术性虽燥，终是健脾之物，脾健而津液自生。用润药以佐其燥，则白术且自失其燥矣，又何能助燥哉。（〔批〕性燥而润制之，白术何往不可善用乎。）"}]},{"ID":"20240616083351-0k8nzoo","Type":"NodeParagraph","Properties":{"id":"20240616083351-0k8nzoo","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或疑白术健脾生胃，有时用白术而脾胃不能受补者何也？此虚不受补也。脾胃之气，喜生发而不喜闭塞。白术正开胃开脾之圣药，何至用之而反无功，明是土崩瓦解之象。而土崩瓦解之故，由于肾火之大败也。土非火不生，火非土不旺，脾胃之土必得肾中之火相生，而土乃坚刚，以消水谷。今因肾水既枯，而肾火又复将绝，土既无根培之，又何益乎。徒用白术以健脾开胃，而肾中先天之火已耗尽无余，如炉中烬绝，益之薪炭，而热灰终难起焰。此生之不生，乃脾不可生。非白术能生而不生也。（〔批〕无根之土，必须培火。）"}]},{"ID":"20240616083351-pvnk7fz","Type":"NodeParagraph","Properties":{"id":"20240616083351-pvnk7fz","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或又问脾土固肾火所生，而胃土实心火所生，肾火绝而心火未绝，宜用白术以健胃，尚可以生土也。夫胃土非心火不生，而心火必得肾火以相济，肾火绝，又何以济心之不足乎。心火因肾火之绝，而心火欲救肾火而未遑，又何能救胃哉。胃既不可救，则胃无二火之生，胃气欲不亡，不可得矣。胃气既亡，而白术虽能健脾，而欲生胃无从也。（〔批〕脾土生于肾火，胃土生于心火，虽有所分，其实脾胃皆生于肾火也，故肾一绝而脾胃两无可救矣。）"}]},{"ID":"20240616083351-6pm83gt","Type":"NodeParagraph","Properties":{"id":"20240616083351-6pm83gt","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或又问心、肾二火既绝，故用白术而无功，吾救心、肾之火而兼用白术，则不生者可以生矣。嗟乎。先天之火虽绝而未绝也，后天之火一绝而俱绝矣。肾中之火，先天之火也。心中之火，后天之火也。后天火绝者，由于先天之火先绝也。救先天之火，则后天之火自生。救后天之火，则先天之火难活。故救火者，必须先救肾中之火，肾火生则心火不死，肾火绝则心火不生。故欲救脾胃之生，不可徒救心火之绝，非心火之不宜救也，救肾火正所以救心火耳。倘肾火之绝不及救，而徒救夫心火，多用桂、附于白术、人参之中，欲救心以救肾也，终亦必亡而已矣，况仅用白术，又何以救之哉。（〔批〕阐发白术之义，得如许奇论，真石破天惊。）"}]},{"ID":"20240616083351-qvjmfw1","Type":"NodeParagraph","Properties":{"id":"20240616083351-qvjmfw1","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或疑白术性燥，脾胃有火者不宜用，恐其助热也。此等议论，真民生之大不幸也。夫白术甘温，正能去热，脾胃有火者，安在不相宜。（〔批〕白术甘温，正解火热。）惟胃中邪火沸腾，不可用之以助邪。倘胃中虚火作祟，非白术之甘温，又何以解热哉。世人一见白术，无论有火无火，与火之是虚是邪，一概曰白术助火不宜用，更有疑白术为闭气者，尤为可笑。白术利腰脐之气，岂有腰脐利而脾胃反不利者乎。"}]},{"ID":"20240616083351-aytydq8","Type":"NodeParagraph","Properties":{"id":"20240616083351-aytydq8","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或疑白术闭气，闭上焦之气也。先生谓利腰脐之气，乃利下焦之气，上下各不相同，恐未可以利下而并疑上焦之俱利也。曰∶腰脐为生气之根，岂有根本大利而枝叶不舒发之理。彼言白术之闭气者，言气虚散失者，白术能补而收闭其耗散之气也。世人错认闭字，致使白术利气之药，反同闭气之品而弃之。此千古之冤也。"}]},{"ID":"20240616083351-f1d2mwb","Type":"NodeParagraph","Properties":{"id":"20240616083351-f1d2mwb","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或问白术阳药，能益脾土之阴，是白术自能生阳中之阴乎，抑必有藉于补阴之味以生阳也？"}]},{"ID":"20240616083351-t7m3yok","Type":"NodeParagraph","Properties":{"id":"20240616083351-t7m3yok","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"曰∶阳药补阳，而白术偏能于阳中补阴，是白术亦阴分之药也。白术既阴阳兼补，得阴阳之药，皆相济而成功，安在入诸补阴以生阳，入诸补阳而不能生阴哉。"}]},{"ID":"20240616083351-67f9itm","Type":"NodeParagraph","Properties":{"id":"20240616083351-67f9itm","updated":"20240616083351"},"Children":[{"Type":"NodeText","Data":"或疑白术阳药，而补脾气之阴，是阳能生阴也，又何以阳又能生阳乎？夫阴阳原两相生也，阳以生阳，不若阳以生阴之速，但不可谓阳不生阳也。白术阳药，以生脾中之阴者十之八，而生脾中之阳者十之二耳。"}]},{"ID":"20240616083038-p69qdln","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-p69qdln"}},{"ID":"20240616083340-19lz33j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083340-19lz33j","updated":"20240616083344"},"Children":[{"Type":"NodeText","Data":"白术《医学入门》"}]},{"ID":"20240616083340-6x4cfc0","Type":"NodeParagraph","Properties":{"id":"20240616083340-6x4cfc0","updated":"20240616083340"},"Children":[{"Type":"NodeText","Data":"白术甘温健胃脾，寒湿热湿尽相宜，痰痞呕泄肿汗渴，兼补气血安胎儿。"}]},{"ID":"20240616083340-00tenc0","Type":"NodeParagraph","Properties":{"id":"20240616083340-00tenc0","updated":"20240616083340"},"Children":[{"Type":"NodeText","Data":"术，浊也，色白而形浊也。味甘而辛苦不烈。无毒。可升可降，阳也。入手太阳少阴、足阳明太阴经。"}]},{"ID":"20240616083340-2pcnpdf","Type":"NodeParagraph","Properties":{"id":"20240616083340-2pcnpdf","updated":"20240616083340"},"Children":[{"Type":"NodeText","Data":"补脾胃虚弱，不思饮食，去诸经湿。又退胃热，除寒热，消虚痰痞气宿滞，止霍乱、呕逆、泄泻、腹中冷痛，利小便，消水肿胀满。又有汗则能止，无法则能发。缓脾生津除湿渴，利腰膝间血。上而皮毛，中而心胃，下而腰膝。在气主气，在血主血，故补虚药多用之。兼安胎产，产后中风口噤及大风、痿痹、足胫毒疮，皆效。"}]},{"ID":"20240616083340-91n5lrk","Type":"NodeParagraph","Properties":{"id":"20240616083340-91n5lrk","updated":"20240616083340"},"Children":[{"Type":"NodeText","Data":"丹溪云∶与二陈同用，则健胃消食，化痰除湿；与芍药、当归，枳实、生地之类同用，则补脾而清脾家湿热，再加干姜，去脾家寒湿。东垣云∶佐黄芩有安胎之能，君枳实有消痞之妙，惟伤寒动气不宜用。米泔浸半日，去芦。泻胃火生用，补胃虚土炒。防风、地榆为使。忌桃、李、雀、鸽肉。"}]},{"ID":"20240616083038-mejwxx1","Type":"NodeThematicBreak","Properties":{"id":"20240616083038-mejwxx1"}},{"ID":"20240616083327-11lqnva","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083327-11lqnva","updated":"20240616083331"},"Children":[{"Type":"NodeText","Data":"白术《神农本草经读》"}]},{"ID":"20240616083327-fc0j0ln","Type":"NodeParagraph","Properties":{"id":"20240616083327-fc0j0ln","updated":"20240616083327"},"Children":[{"Type":"NodeText","Data":"气味甘、温，无毒。主风寒湿痹，死肌、痉、疸，止汗，除热，消食。作煎饵，久服轻身延年不饥。（仲景有赤术，即苍术也。功用略同，偏长于消导。汗多者大忌之。）陈修园曰∶此为脾之正药。其曰∶风寒湿痹者，以风寒湿三气合而为痹也。三气杂至，以湿气为主。死肌者，湿浸肌肉也；痉者，湿流关节也；疸者，湿郁而为热，热则发黄也；湿与热交蒸，则自汗而发热也；脾受湿则失其健运之常，斯食不能消也；白术功在除湿，所以主之。“作药饵”三字另提。先圣大费苦心，以白术之功用在燥，而所以妙处，在于多脂。（张隐庵云∶土有湿气，始能灌溉四旁，如地得雨露，始能发生万物。）今以生术削去皮，急火炙令熟，则味甘温而质滋润，久服有延年不饥之效。可见今人炒燥、炒黑、土蒸、水漂等制，大失经旨。"}]},{"ID":"20240616083039-vx7ghnq","Type":"NodeThematicBreak","Properties":{"id":"20240616083039-vx7ghnq"}},{"ID":"20240616083315-tmgbgb5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083315-tmgbgb5","updated":"20240616083320"},"Children":[{"Type":"NodeText","Data":"白术《本草新编》"}]},{"ID":"20240616083315-5n0nxlv","Type":"NodeParagraph","Properties":{"id":"20240616083315-5n0nxlv","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"白术，味甘辛，气温，可升可降，阳中阴也，无毒。入心、脾、胃、肾、三焦之经。除湿消食，益气强阴，尤利腰脐之气。（〔批〕白术利腰脐之气，原是利肾中之湿也。肾不湿则腰不疼，湿去而腰脐自利矣。）有汗能止，无汗能发，与黄 同功，实君药而非偏裨。往往可用一味以成功，世人未知也，吾今泄天地之奇。如人腰疼也，用白术二三两，水煎服，一剂而疼减半，再剂而痛如失矣。夫腰疼乃肾经之症，人未有不信。肾虚者用熟地、山茱以补水未效也，用杜仲、破故纸以补火未效也，何以用白术一味而反能取效。不知白术最利腰脐。腰疼乃水湿之气浸入于肾宫，故用补剂，转足以助其邪气之盛，不若独用白术一味，无拘无束，直利腰脐之为得。夫二者之气，原通于命门，脐之气通，而腰之气亦利，腰脐之气既利，而肾中之湿气何能久留，自然湿去而痛忽失也。通之而酒湿作泻，经年累月而不愈者，亦止消用此一味，一连数服，未有不效者。而且湿去而泻止，泻止而脾健，脾健而胃亦健，精神奋发，颜色光彩，受益正无穷也。是白术之功，何亚于人参乎。不特此也，如人患疟病，用白术二两、半夏一两，米饭为丸，一日服尽即愈。夫疟病，至难愈之病也。用柴胡、青皮散邪不效，用鳖甲、首乌逐邪不效，用草果、常山伐邪不效，何以用白术二两为君，半夏一两为臣，即以奏功，不知白术健脾开胃之神药，而其妙尤能去湿，半夏去痰，无痰不成疟，而无湿亦不成痰。利湿则痰已清其源，消痰则疟已失其党，况脾胃健旺，无非阳气之升腾，疟鬼又于何地存身哉。此效之所以甚捷也。由此观之，则白术非君药而何。推之二陈汤，必多加白术所以消痰也；四君子汤，必多加白术所以补气也；五苓散，必多加白术所以利水也；理中汤，必多加白术所以祛寒也；香薷饮，必多加白术所以消暑也。至于产前必多加白术以安胎，产后必多加白术以救脱，消食非多用白术何以速化，降气非多用白术何以遽定，中风非多用白术安能夺命于须臾，痞块非多用白术安能救困于败坏哉。人知白术为君药而留心于多用也，必能奏功如神矣。或问白术利腰脐而去湿，若不在腰脐者，似非可利，胡为凡有湿病皆不能外耶？此未明乎腰脐之义也。人之初生，先生命门。命门者，肾中之主，先天之火气也。有命门而后生五脏六腑，而脐乃成，是脐又后天之母气也。命门在腰而对乎脐，腰脐为一身之主宰。腰脐利而人健，腰脐不利而人病矣。凡有水湿，必侵腰脐，但有轻重之分耳。治水湿者，一利腰脐而水即入于膀胱，从小便而化出，所以得水必须利腰脐，而利腰脐必须用白术也。况白术之利腰脐者，利腰脐之气，非利腰脐之水也。腰脐之气利，则气即通于膀胱，而凡感水湿之邪，俱不能留，尽从膀胱外泄，是白术不利之利，正胜于利也。（〔批〕利气非泻气之谓，正利其气通膀胱也。膀胱非气不行，气闭则塞，气通则开。白术利气以利水，所以必用之也。）"}]},{"ID":"20240616083315-gvssotx","Type":"NodeParagraph","Properties":{"id":"20240616083315-gvssotx","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或问白术健脾去湿，为后天培土圣药，真缓急可恃者也。虽然人知白术益人，而不知白术之损人也。白术利水，则其性必燥。世人湿病，十居其四，而燥症十居其六。肺气之燥也，更用白术以利之，则肺气烁尽津液，必有干嗽之忧；胃气之燥也，更用白术以利之，则胃气炎蒸津液，必有口渴之虑。脾气之燥也，更用白术以利之，则脾气焦枯津液，必有肠结之苦。盖宜于湿者，不宜于燥也。去湿既受其益，则添燥安得不受其损哉。"}]},{"ID":"20240616083315-k8876qz","Type":"NodeParagraph","Properties":{"id":"20240616083315-k8876qz","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或疑白术乃去湿生津之上品，而先生谓其性燥，不可治肺、胃、脾三家之燥病，吾不得其义也。夫白术生津，但能生水火既济之津，不能生水火未济之津也。如湿病宜去其湿，则燥病宜解其燥，亦明矣，乃不解其燥，而反用燥以治之，即能生津，亦为火所烁矣。况白术去湿，则内无津液而外无水气，又从何而生津乎。此白术止可治湿而不可治燥也。虽然白术性虽燥，终是健脾之物，脾健而津液自生。用润药以佐其燥，则白术且自失其燥矣，又何能助燥哉。（〔批〕性燥而润制之，白术何往不可善用乎。）"}]},{"ID":"20240616083315-yg1fpex","Type":"NodeParagraph","Properties":{"id":"20240616083315-yg1fpex","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或疑白术健脾生胃，有时用白术而脾胃不能受补者何也？此虚不受补也。脾胃之气，喜生发而不喜闭塞。白术正开胃开脾之圣药，何至用之而反无功，明是土崩瓦解之象。而土崩瓦解之故，由于肾火之大败也。土非火不生，火非土不旺，脾胃之土必得肾中之火相生，而土乃坚刚，以消水谷。今因肾水既枯，而肾火又复将绝，土既无根培之，又何益乎。徒用白术以健脾开胃，而肾中先天之火已耗尽无余，如炉中烬绝，益之薪炭，而热灰终难起焰。此生之不生，乃脾不可生。非白术能生而不生也。（〔批〕无根之土，必须培火。）"}]},{"ID":"20240616083315-97pkqq0","Type":"NodeParagraph","Properties":{"id":"20240616083315-97pkqq0","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或又问脾土固肾火所生，而胃土实心火所生，肾火绝而心火未绝，宜用白术以健胃，尚可以生土也。夫胃土非心火不生，而心火必得肾火以相济，肾火绝，又何以济心之不足乎。心火因肾火之绝，而心火欲救肾火而未遑，又何能救胃哉。胃既不可救，则胃无二火之生，胃气欲不亡，不可得矣。胃气既亡，而白术虽能健脾，而欲生胃无从也。（〔批〕脾土生于肾火，胃土生于心火，虽有所分，其实脾胃皆生于肾火也，故肾一绝而脾胃两无可救矣。）"}]},{"ID":"20240616083315-712ovi0","Type":"NodeParagraph","Properties":{"id":"20240616083315-712ovi0","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或又问心、肾二火既绝，故用白术而无功，吾救心、肾之火而兼用白术，则不生者可以生矣。嗟乎。先天之火虽绝而未绝也，后天之火一绝而俱绝矣。肾中之火，先天之火也。心中之火，后天之火也。后天火绝者，由于先天之火先绝也。救先天之火，则后天之火自生。救后天之火，则先天之火难活。故救火者，必须先救肾中之火，肾火生则心火不死，肾火绝则心火不生。故欲救脾胃之生，不可徒救心火之绝，非心火之不宜救也，救肾火正所以救心火耳。倘肾火之绝不及救，而徒救夫心火，多用桂、附于白术、人参之中，欲救心以救肾也，终亦必亡而已矣，况仅用白术，又何以救之哉。（〔批〕阐发白术之义，得如许奇论，真石破天惊。）"}]},{"ID":"20240616083315-u8hxlhm","Type":"NodeParagraph","Properties":{"id":"20240616083315-u8hxlhm","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或疑白术性燥，脾胃有火者不宜用，恐其助热也。此等议论，真民生之大不幸也。夫白术甘温，正能去热，脾胃有火者，安在不相宜。（〔批〕白术甘温，正解火热。）惟胃中邪火沸腾，不可用之以助邪。倘胃中虚火作祟，非白术之甘温，又何以解热哉。世人一见白术，无论有火无火，与火之是虚是邪，一概曰白术助火不宜用，更有疑白术为闭气者，尤为可笑。白术利腰脐之气，岂有腰脐利而脾胃反不利者乎。"}]},{"ID":"20240616083315-622uztq","Type":"NodeParagraph","Properties":{"id":"20240616083315-622uztq","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或疑白术闭气，闭上焦之气也。先生谓利腰脐之气，乃利下焦之气，上下各不相同，恐未可以利下而并疑上焦之俱利也。曰∶腰脐为生气之根，岂有根本大利而枝叶不舒发之理。彼言白术之闭气者，言气虚散失者，白术能补而收闭其耗散之气也。世人错认闭字，致使白术利气之药，反同闭气之品而弃之。此千古之冤也。"}]},{"ID":"20240616083315-dw0rdnm","Type":"NodeParagraph","Properties":{"id":"20240616083315-dw0rdnm","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或问白术阳药，能益脾土之阴，是白术自能生阳中之阴乎，抑必有藉于补阴之味以生阳也？"}]},{"ID":"20240616083315-d25878l","Type":"NodeParagraph","Properties":{"id":"20240616083315-d25878l","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"曰∶阳药补阳，而白术偏能于阳中补阴，是白术亦阴分之药也。白术既阴阳兼补，得阴阳之药，皆相济而成功，安在入诸补阴以生阳，入诸补阳而不能生阴哉。"}]},{"ID":"20240616083315-ri5p2sz","Type":"NodeParagraph","Properties":{"id":"20240616083315-ri5p2sz","updated":"20240616083315"},"Children":[{"Type":"NodeText","Data":"或疑白术阳药，而补脾气之阴，是阳能生阴也，又何以阳又能生阳乎？夫阴阳原两相生也，阳以生阳，不若阳以生阴之速，但不可谓阳不生阳也。白术阳药，以生脾中之阴者十之八，而生脾中之阳者十之二耳。"}]},{"ID":"20240616083039-qwq52cj","Type":"NodeThematicBreak","Properties":{"id":"20240616083039-qwq52cj"}},{"ID":"20240616083304-k9336hh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083304-k9336hh","updated":"20240616083308"},"Children":[{"Type":"NodeText","Data":"白术《本草崇原》"}]},{"ID":"20240616083304-re9t4wa","Type":"NodeParagraph","Properties":{"id":"20240616083304-re9t4wa","updated":"20240616083304"},"Children":[{"Type":"NodeText","Data":"气味甘温，无毒。治风寒湿痹、死肌、痉、疸，止汗、除热、消食，作煎饵。久服，轻身延年不饥。"}]},{"ID":"20240616083304-noo2fjx","Type":"NodeParagraph","Properties":{"id":"20240616083304-noo2fjx","updated":"20240616083304"},"Children":[{"Type":"NodeText","Data":"（术始出南郑山谷，今处处有之，以嵩山、茅山及野生者为胜。其根皮黄，肉白，老则苍赤，质多膏液，有赤白二种。《本经》未分，而汉时仲祖汤方始有赤术、白术之分，二术性有和暴之殊，用有缓急之别。）"}]},{"ID":"20240616083304-auh3wcz","Type":"NodeParagraph","Properties":{"id":"20240616083304-auh3wcz","updated":"20240616083304"},"Children":[{"Type":"NodeText","Data":"（按∶《本经》单言曰术，确是白术一种，苍术固不可以混也，试取二术之苗、叶、根、茎白术近根之叶，每叶三岐，略似半夏，其上叶绝似棠梨叶，色淡绿不光。苍术近根之叶，作三五叉，其上叶则狭而长，色青光润。白术茎绿，苍术茎紫。白术根如人指，亦有大如拳者，皮褐色，肉白色，老则微红。苍术根如老姜状，皮色苍褐，肉色黄，老则有朱砂点。白术味始甘，次微辛，后乃有苦。苍术始甘，次苦，辛味特胜。白术性和而不烈，苍术性燥而烈，并非一种可知。后人以其同有术名，同主脾胃，其治风寒湿痹之功亦相近，遂谓《本经》兼二术言之，盖未尝深辩耳；观《本经》所云止汗二字，唯白术有此功，用苍术反是写得相混耶。白术之味，《本经》云苦，陶弘景云甘，甄权云甘辛，张杲云味苦而甘，今取浙中所产白术尝之，实兼甘辛苦三味。夏采者，辛多甘少，冬采者，甘多辛少，而后皆归于苦。是知诸说各举其偏，而未及乎全也。隐庵于《本经》原文定苦字为甘字，爰以白术为调和脾土之品，甘是正味，苦乃兼味，故采弘景之说，以订正之耳。）"}]},{"ID":"20240616083304-3z3kbax","Type":"NodeParagraph","Properties":{"id":"20240616083304-3z3kbax","updated":"20240616083304"},"Children":[{"Type":"NodeText","Data":"白术气味甘温，质多脂液，乃调和脾土之药也。主治风寒湿痹者，《素问·痹论》云∶风寒湿三气杂至，合而为痹。白术味甘，性温，补益脾土，土气营运，则肌肉之气外通皮肤，内通经脉，故风寒湿之痹证皆可治也。夫脾主肌肉，治死肌者，助脾气也。又脾主四肢，痉者，四肢强而不和。脾主黄色，疸者，身目黄而土虚。白术补脾，则痉疸可治也。止汗者，土能胜湿也。除热者，除脾土之虚热也。消食者，助脾土之转运也。作煎饵者，言白术多脂，又治脾土之燥，作煎则味甘温而质滋润，土气和平矣。故久服则轻身延年不饥。"}]},{"ID":"20240616083304-d5rwg3h","Type":"NodeParagraph","Properties":{"id":"20240616083304-d5rwg3h","updated":"20240616083304"},"Children":[{"Type":"NodeText","Data":"愚按∶太阴主湿土而属脾，为阴中之至阴，喜燥恶湿，喜温恶寒。然土有湿气，始能灌溉四旁，如地得雨露，始能发生万物。若过于炎燥，则止而不行，为便难脾约之证。白术作煎饵，则燥而能润，温而能和，此先圣教人之苦心，学人所当体会者也。"}]},{"ID":"20240616083105-sfsds2z","Type":"NodeThematicBreak","Properties":{"id":"20240616083105-sfsds2z"}},{"ID":"20240616083252-hcpzdkt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083252-hcpzdkt","updated":"20240616083258"},"Children":[{"Type":"NodeText","Data":"白术《本草求真》"}]},{"ID":"20240616083252-sitit9f","Type":"NodeParagraph","Properties":{"id":"20240616083252-sitit9f","updated":"20240616083252"},"Children":[{"Type":"NodeText","Data":"（山草）补脾气燥脾湿"}]},{"ID":"20240616083252-jyjuy64","Type":"NodeParagraph","Properties":{"id":"20240616083252-jyjuy64","updated":"20240616083252"},"Children":[{"Type":"NodeText","Data":"脾欲缓。急食甘以缓之。（《内经》）白术味苦而甘。既能燥湿实脾。复能缓脾生津。（湿燥则脾实。脾缓则津生。）且其性最温。服则能以健食消谷。为脾脏补气第一要药也。（五脏各有阴阳。白术专补脾阳。故曰补气。）书言无汗能发。有汗能收。通溺止泄。消痰治肿。止热化癖。安胎（胎气系于脾。脾虚则蒂无所附。故易落。）止呕。（声物俱有为呕。有物无声为吐。东垣云。生姜半夏。皆可以治表实气壅。若虚呕谷气不行。当以参术补胃。推扬谷气而已。）功效甚多。总因脾湿则汗不止。脾健则汗易发。凡水湿诸邪。靡不因其脾健而自除。吐泻及胎不安。（胃之上口为贲门。水谷于此而入。胃之下口为幽门。水谷之滓秽自此而入小肠。又自小肠下一十六曲。水谷始下小肠下口阑门。水谷自此泌别。凡秽为浊。入于大肠。水之清。入于胱膀。如水谷不分。清浊不别。则皆入于大肠而成。李士材云。脾士强者。自能胜湿。无湿则不泄。湿多成于五泄。若土虚不能制湿。则风寒与热。皆得干而为病。）亦靡不因其脾健而悉平矣。故同枳实则能治痞。同黄芩则能安胎。同泽泻则能利水。同干姜桂心。则能消饮祛癖。同地黄为丸。则能以治血泻萎黄。同半夏丁香姜汁。则可以治小儿久泻。同牡蛎石斛麦麸。则可以治脾虚盗汗。然血燥无湿。肾间动气筑筑。燥渴便闭者忌服。谓其燥肾闭气。则其气益筑。（刘涓子云。痈疽忌白术。以其燥肾而闭气。故反生脓作痛也。凡脏皆属阴。世人但知白术能健脾。宁知脾虚而无湿邪者！用之反燥脾家津液。是损脾阴也。何补之有？此最易误。故特表而出之。）又寒湿过甚。水满中宫者亦忌。谓其水气未决。苦不胜水。甘徒滋壅。必待肾阳培补。水气渐消。肾气安位。术始可投。（犹洪水冲堤。必待水退。方可培土御水。）此又不得不稍变换于中也。（凡土亏水泛。必俟水势稍退。方进理中等药。）盖补脾之药不一。白术专补脾阳。（仲淳曰。白术禀纯阳之土气。除邪之功胜。而益阴之效亏。故病属阴虚。血少精不足。内热骨蒸。口干唇燥。咳嗽吐痰。吐血鼻衄齿衄。便秘滞下者。法咸忌之。）生则较熟性更鲜补不滞腻。能治风寒湿痹。及散腰脐间血。并冲脉为病逆气里急之功。非若山药止补脾脏之阴。甘草止缓脾中之气。而不散于上下。俾血可生。燥症全无。苍术气味过烈。散多于补。人参一味冲和。燥气悉化。补脾而更补肺。所当分别而异视者也。出浙江于潜地者为于潜术。最佳。米泔浸。（借谷气和脾。）壁土拌炒。（借土气助脾。）入清燥药。蜜水炒。（借润制燥。）入滋阴药。人乳拌用。（借乳入血制燥。）入清胀药。麸皮拌炒用。（借麸入中。）"}]},{"ID":"20240616083105-oerh6ek","Type":"NodeThematicBreak","Properties":{"id":"20240616083105-oerh6ek"}},{"ID":"20240616083131-u1dd9bb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083131-u1dd9bb","updated":"20240616083135"},"Children":[{"Type":"NodeText","Data":"白朮《中药学》"}]},{"ID":"20240616083131-oiz5w8y","Type":"NodeParagraph","Properties":{"id":"20240616083131-oiz5w8y","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为菊科植物白朮的根茎。"}]},{"ID":"20240616083131-dej60b4","Type":"NodeParagraph","Properties":{"id":"20240616083131-dej60b4","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、甘，温。入脾、胃经。"}]},{"ID":"20240616083131-cp78uye","Type":"NodeParagraph","Properties":{"id":"20240616083131-cp78uye","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【功效】补脾燥湿，利水，止汗。"}]},{"ID":"20240616083131-0kkegs1","Type":"NodeParagraph","Properties":{"id":"20240616083131-0kkegs1","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于脾胃虚弱，食少胀满，倦怠乏力，泄泻等症。"}]},{"ID":"20240616083131-2cltk8m","Type":"NodeParagraph","Properties":{"id":"20240616083131-2cltk8m","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"白朮有补脾燥湿的作用，故可用于脾胃虚弱、食少倦怠及脾虚湿困、腹胀泄泻等症。补脾胃可与党参、甘草等配伍；消痞除胀可与枳壳等同用；健脾燥湿止泻可与陈皮、茯苓等同用。"}]},{"ID":"20240616083131-jfetbtf","Type":"NodeParagraph","Properties":{"id":"20240616083131-jfetbtf","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"2.用于水湿停留、痰饮、水肿等症。"}]},{"ID":"20240616083131-h1a6udl","Type":"NodeParagraph","Properties":{"id":"20240616083131-h1a6udl","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"白朮既能燥湿，又能利水，故可用于水湿内停之痰饮或水湿外溢之水肿。治寒饮可与茯苓、桂枝等配伍；治水肿常与茯苓皮、大腹皮等同用。"}]},{"ID":"20240616083131-km4bhjb","Type":"NodeParagraph","Properties":{"id":"20240616083131-km4bhjb","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"3.用于表虚自汗。"}]},{"ID":"20240616083131-xe1jvow","Type":"NodeParagraph","Properties":{"id":"20240616083131-xe1jvow","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"本品与黄耆、浮小麦等同用，有固表止汗之功，可治表虚自汗。此外，本品又可用于安胎，治妊娠足肿、胎气不安等症，有内热者可与黄芩等配伍；腰酸者可与杜仲、桑寄生等同用。"}]},{"ID":"20240616083131-59mlenv","Type":"NodeParagraph","Properties":{"id":"20240616083131-59mlenv","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【处方用名】生白朮（生用，燥湿、利水作用较好）、炒白朮、焦白朮（用麸皮炒黄用，减少燥性，功偏补脾。）、制白朮（蒸熟用，燥性减弱，用于补脾益气。）"}]},{"ID":"20240616083131-1nmhd4p","Type":"NodeParagraph","Properties":{"id":"20240616083131-1nmhd4p","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240616083131-fn8s1a8","Type":"NodeParagraph","Properties":{"id":"20240616083131-fn8s1a8","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【按语】1.白朮是一味培补脾胃的药物，它补气的作用较弱，但苦温燥湿，能补脾阳。因脾司运化，喜燥而恶湿，得阳始运，能升则健。如脾阳不振，运化失职，必致里湿不化，水湿停留，而发生痰饮、痞满、泄泻等病症，都可应用本品。至于胃阴不足，舌苔光剥，津液缺少，唇燥口干者，就不宜用性偏温燥的白朮了。"}]},{"ID":"20240616083131-86jn8tp","Type":"NodeParagraph","Properties":{"id":"20240616083131-86jn8tp","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"2.过去上海有于于朮、冬朮、白朮三种，一般认为于于朮和冬朮作用较好，但现在上海地区已经简化，不再区分。"}]},{"ID":"20240616083131-8b0jy0v","Type":"NodeParagraph","Properties":{"id":"20240616083131-8b0jy0v","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【方剂举例】参朮散（验方）：人参、白朮、白茯苓、砂仁、甘草、薏苡仁、白莲肉、六曲、山楂肉、肉豆蔻、诃子、陈皮、木香。治脾虚泄泻。"}]},{"ID":"20240616083131-jvifxuk","Type":"NodeParagraph","Properties":{"id":"20240616083131-jvifxuk","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主风寒湿痹死肌，痉疸，止汗除热，消食。」"}]},{"ID":"20240616083131-xvw79ik","Type":"NodeParagraph","Properties":{"id":"20240616083131-xvw79ik","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"《别录》：「消痰水，逐皮间风水结肿....暖胃消谷嗜食。」"}]},{"ID":"20240616083131-0di1zvz","Type":"NodeParagraph","Properties":{"id":"20240616083131-0di1zvz","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"《大明本草》：「利小便。」"}]},{"ID":"20240616083131-hf2k82w","Type":"NodeParagraph","Properties":{"id":"20240616083131-hf2k82w","updated":"20240616083131"},"Children":[{"Type":"NodeText","Data":"《珍珠囊》：「除湿益气，和中补阳，消痰逐水，生津止渴，止泻痢，消足胫湿肿，....得枳实消痞满气分，佐黄芩安胎清热。」"}]},{"ID":"20240616084426-0w57tmt","Type":"NodeThematicBreak","Properties":{"id":"20240616084426-0w57tmt"}},{"ID":"20240616084427-osey2cw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084427-osey2cw","updated":"20240616084431"},"Children":[{"Type":"NodeText","Data":"苍术《本草害利》"}]},{"ID":"20240616084427-hmzowy5","Type":"NodeParagraph","Properties":{"id":"20240616084427-hmzowy5","updated":"20240616084427"},"Children":[{"Type":"NodeText","Data":"〔害〕辛温燥烈，大便燥结多汗者忌用。余与白术禁例同。"}]},{"ID":"20240616084427-fjymoel","Type":"NodeParagraph","Properties":{"id":"20240616084427-fjymoel","updated":"20240616084427"},"Children":[{"Type":"NodeText","Data":"〔利〕苦辛温，入脾胃二经。燥湿消痰，发汗解郁，除山岚瘴气，弭灾 恶疾。"}]},{"ID":"20240616084427-b3iveid","Type":"NodeParagraph","Properties":{"id":"20240616084427-b3iveid","updated":"20240616084427"},"Children":[{"Type":"NodeText","Data":"〔修治〕出茅山，坚小有朱砂点者良。糯米泔浸焙干，同芝麻炒，以制其燥。本草经不分苍白。陶隐居分两种施用。"}]},{"ID":"20240616084416-qps8yn4","Type":"NodeThematicBreak","Properties":{"id":"20240616084416-qps8yn4"}},{"ID":"20240616084417-fimbbyz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084417-fimbbyz","updated":"20240616084421"},"Children":[{"Type":"NodeText","Data":"苍术《汤液本草》"}]},{"ID":"20240616084417-ljsoupk","Type":"NodeParagraph","Properties":{"id":"20240616084417-ljsoupk","updated":"20240616084417"},"Children":[{"Type":"NodeText","Data":"气温，味甘。"}]},{"ID":"20240616084417-2dbc4k3","Type":"NodeParagraph","Properties":{"id":"20240616084417-2dbc4k3","updated":"20240616084417"},"Children":[{"Type":"NodeText","Data":"入足阳明、太阴经。"}]},{"ID":"20240616084417-68mq3us","Type":"NodeParagraph","Properties":{"id":"20240616084417-68mq3us","updated":"20240616084417"},"Children":[{"Type":"NodeText","Data":"《象》云∶主治同白术，若除上湿、发汗，功最大；若补中焦、除湿，力小，如白术也。《衍义》云∶其长如大拇指，肥实，皮色褐，气味辛烈，须米泔浸洗，再换泔浸二日，去上粗皮。"}]},{"ID":"20240616084417-7gkuvkf","Type":"NodeParagraph","Properties":{"id":"20240616084417-7gkuvkf","updated":"20240616084417"},"Children":[{"Type":"NodeText","Data":"东垣云∶入足阳明、太阴，能健胃安脾。"}]},{"ID":"20240616084417-0pxgg72","Type":"NodeParagraph","Properties":{"id":"20240616084417-0pxgg72","updated":"20240616084417"},"Children":[{"Type":"NodeText","Data":"《本草》但言∶术，不分苍、白。其苍术别有雄壮之气，以其经泔浸、火炒，故能出汗，与白术止汗特异，用者不可以此代彼。"}]},{"ID":"20240616084417-0ayyu1v","Type":"NodeParagraph","Properties":{"id":"20240616084417-0ayyu1v","updated":"20240616084417"},"Children":[{"Type":"NodeText","Data":"海藏云∶苍、白有止、发之异，其余主治，并见《图经》。"}]},{"ID":"20240616084407-gd9ujx3","Type":"NodeThematicBreak","Properties":{"id":"20240616084407-gd9ujx3"}},{"ID":"20240616084408-0x7vu2r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084408-0x7vu2r","updated":"20240616084412"},"Children":[{"Type":"NodeText","Data":"苍术《本草从新》"}]},{"ID":"20240616084408-c9woqa1","Type":"NodeParagraph","Properties":{"id":"20240616084408-c9woqa1","updated":"20240616084408"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补脾燥湿、宣、升阳解郁．"}]},{"ID":"20240616084408-zprfc52","Type":"NodeParagraph","Properties":{"id":"20240616084408-zprfc52","updated":"20240616084408"},"Children":[{"Type":"NodeText","Data":"苦温辛烈．燥胃强脾．发汗除湿．能升发胃中阳气．（上行雄壮、能除湿、治中气下陷、下安太阴、使邪气不入脾．）止吐泻．逐痰水．（许叔微本事方曰∶苍术能破水饮之 囊、盖燥脾以去湿、崇土以补脾、方用苍术一斤、大枣五十枚、去皮捣、油麻半两、水二盏、研滤汁和实脾土、燥脾湿、是治痰之本．）消肿满．辟恶气．（为除邪气之上品、辟一切岚瘴邪恶鬼气、阴湿处焚之佳．）散风寒湿．为治痿要药．（阳明虚、则宗筋纵弛、带脉不引、故痿 、苍术阳明经药、经曰∶治痿独取阳明、合黄柏为二妙散、加牛膝名三妙散．）又能总解痰、火、气、血、湿、食六郁．（丹溪曰∶诸郁皆因传化失常、气不得升降、病在中焦、将欲升之、必先降之、将欲降之、必先升之、越鞠丸用苍术、香附、苍术、能径入诸经、疏泄阳明之湿、通行敛涩、香附乃阴中快气之药、一升一降、故郁散而平．）及脾湿下流．肠风带浊．（带浊赤者热伤血分、白者湿伤气分、并有寒热二证、亦有因痰而带柴．）燥结多汗者忌用．出茅山．坚小有朱砂点者良．糯米泔浸．焙干．同芝麻炒．以制其燥．二术皆防风、地榆为使．古本草不分苍白．陶隐居分两种．始各施用．（因湿气身痛者、苍术泔浸、切、煎取浓汁、熬膏、白汤点服．）"}]},{"ID":"20240616084353-elz7yek","Type":"NodeThematicBreak","Properties":{"id":"20240616084353-elz7yek"}},{"ID":"20240616084354-g7a7wp6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084354-g7a7wp6","updated":"20240616084359"},"Children":[{"Type":"NodeText","Data":"苍术《得配本草》"}]},{"ID":"20240616084354-ahvljsh","Type":"NodeParagraph","Properties":{"id":"20240616084354-ahvljsh","updated":"20240616084354"},"Children":[{"Type":"NodeText","Data":"防风、地榆为之使。忌桃、李、雀肉、菘菜、青鱼。"}]},{"ID":"20240616084354-zdtqdhw","Type":"NodeParagraph","Properties":{"id":"20240616084354-zdtqdhw","updated":"20240616084354"},"Children":[{"Type":"NodeText","Data":"甘、苦、辛，温。入足太阴、阳明经。燥胃强脾，发汗除湿。治风寒湿痹，山岚瘴气，霍乱吐泻，心腹急痛，水肿胀满，筋骨痿 。疗湿痰留饮，或挟瘀血成窠囊，及脾湿下流，肠风带浊。得熟地、干姜，治面黄食少。得栀子，解术性之燥。得川椒醋丸，治飧泻久痢。得川柏，治痿 。（加牛膝更好。）得米泔浸一宿，焙为末，蒸饼丸，治好食生米。"}]},{"ID":"20240616084354-qzho2kw","Type":"NodeParagraph","Properties":{"id":"20240616084354-qzho2kw","updated":"20240616084354"},"Children":[{"Type":"NodeText","Data":"得羊肝一具，撒术末四两，扎缚，以粟米水入砂锅煮熟食，治小儿癖疾，及青盲雀目。（以热气熏目，临卧食。）配香附，解六郁。（痰、火、气、血、湿、热。）烧烟，辟邪恶尸气。茅山产者佳。糯米泔浸一宿，焙干用，或以脂麻研碎同炒用。"}]},{"ID":"20240616084354-ewmaden","Type":"NodeParagraph","Properties":{"id":"20240616084354-ewmaden","updated":"20240616084354"},"Children":[{"Type":"NodeText","Data":"白露后米泔水浸，置屋上晒露一月，转燥为清，能发散头风痰湿。燥结多汗，脾虚胀闷，阴虚津枯者，禁用。怪症∶腹中如石，脐中出水，旋变作虫行，绕身匝痒难忍，拨扫不尽，此湿气凝结也。外用苍术煎浓汤浴之，内服苍术末，入麝香少许，水调下，自愈。"}]},{"ID":"20240616084342-92eu12c","Type":"NodeThematicBreak","Properties":{"id":"20240616084342-92eu12c"}},{"ID":"20240616084343-14tt9kh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084343-14tt9kh","updated":"20240616084349"},"Children":[{"Type":"NodeText","Data":"苍术《本经逢原》"}]},{"ID":"20240616084343-53ln36r","Type":"NodeParagraph","Properties":{"id":"20240616084343-53ln36r","updated":"20240616084343"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名山蓟"}]},{"ID":"20240616084343-lsuo9jm","Type":"NodeParagraph","Properties":{"id":"20240616084343-lsuo9jm","updated":"20240616084343"},"Children":[{"Type":"NodeText","Data":"苦辛温，无毒。产茅山者味甘形瘦多毛，最良。吴郡诸山者次之。楚中大块辛烈气燥者为下。制用糯米泔浸，刮去皮，切片，同芝麻炒或麻油炒通黄，去焦末。或去皮、切片，蜜水拌，饭上蒸用。又白露后以泔水净，置屋上晒露一月，谓之神术。"}]},{"ID":"20240616084343-5o4j921","Type":"NodeParagraph","Properties":{"id":"20240616084343-5o4j921","updated":"20240616084343"},"Children":[{"Type":"NodeText","Data":"《本经》主风寒湿痹，死肌痉疸。"}]},{"ID":"20240616084343-ernse0q","Type":"NodeParagraph","Properties":{"id":"20240616084343-ernse0q","updated":"20240616084343"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"苍术辛烈，性温而燥。可升可降，能径入诸经，疏泄阳明之湿，而安太阴，辟时行恶气。因经泔浸炒，故能除上湿发汗，与白术止汗则异，腹中窄狭者须之。《本经》治风寒湿痹，死肌痉疸等证，总取性专开腠，故能发汗而去风寒湿气，祛湿而去死肌痉疸，下气而消痰食饮癖。又能总解诸郁，佐以香附快气之药，下气最速，一升一降则郁散而气平也。遗精不禁，淋浊不止，腰背酸痛，用以敛脾津，津生于谷气也。同黄 为二妙，治下部湿热痛肿。又苍术一味，麻油制过为末，煮大枣肉为丸，治胁下饮 。许叔微患饮 三十年，始因少年夜坐写文，左向伏几，是以饮食多坠左边，饮酒止，从左下有声，胁痛食减嘈杂，饮酒半杯即止，不数日必呕酸水，暑月左半身绝无汗，服雄、附、矾石、牵牛、遂、戟等皆无效，自揣必有 囊如水之有窠臼，不盈科不行，乃悉屏诸药，以前丸服三月而疾除。暑月汗亦周身，灯下能书细字，皆苍术之力也。然惟素禀肥盛多湿者为宜，若形瘦多火者禁用。"}]},{"ID":"20240616084343-jaxpqk8","Type":"NodeParagraph","Properties":{"id":"20240616084343-jaxpqk8","updated":"20240616084343"},"Children":[{"Type":"NodeText","Data":"其神术已经露制，转燥为清，用以发散上部头风痰湿诸证，故治时行头痛，有神术汤，此得制度之妙也。"}]},{"ID":"20240616084331-bxtkjfr","Type":"NodeThematicBreak","Properties":{"id":"20240616084331-bxtkjfr"}},{"ID":"20240616084332-33mecqd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084332-33mecqd","updated":"20240616084337"},"Children":[{"Type":"NodeText","Data":"苍术《本草简要方》"}]},{"ID":"20240616084332-tmwhvoo","Type":"NodeParagraph","Properties":{"id":"20240616084332-tmwhvoo","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"主治。健胃。安脾。发汗。消谷解郁及霍乱吐下呕逆。凡祛风发汗。攻郁逐邪。力过白术。健胃补脾则逊白术。盖此术实战将也。"}]},{"ID":"20240616084332-3swzav6","Type":"NodeParagraph","Properties":{"id":"20240616084332-3swzav6","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"苍术丸。生苍术（另研不拘多少）乳香（另研）没药（另研）各二钱。川牛膝（酒浸）青盐（研）各五钱。熟艾（米糯过研）四钱。全蝎（炒）一钱。川乌（炮去皮脐）三钱研末入研药令匀。"}]},{"ID":"20240616084332-o0oz8pt","Type":"NodeParagraph","Properties":{"id":"20240616084332-o0oz8pt","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"以木瓜大者一枚。切头作盖。去瓤纳药末瓜内。将盖签定。置黑豆中蒸令极烂。取出去皮。同药研成膏。再入苍术末。拌令得所。丸梧子大。每服五十丸。空腹木瓜汤或盐汤或酒下。日三次。忌酒肉。治干湿香港脚。筋脉拘痛。不能行动。兼补下部。"}]},{"ID":"20240616084332-te23zaj","Type":"NodeParagraph","Properties":{"id":"20240616084332-te23zaj","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"乾坤生意平补固真丹。苍术刮净一斤。作四分。一分川椒一两炒。一分破故纸一两炒。"}]},{"ID":"20240616084332-5jqnva8","Type":"NodeParagraph","Properties":{"id":"20240616084332-5jqnva8","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"一分茴香食盐各一两炒。一分川楝肉一两炒。取净术为末入白茯苓末二两。酒洗当归末二两。"}]},{"ID":"20240616084332-g122mee","Type":"NodeParagraph","Properties":{"id":"20240616084332-g122mee","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"酒煮面糊丸梧子大。每空腹盐酒下三十丸。治元脏久虚。遗精白浊。妇人赤白带下崩漏。"}]},{"ID":"20240616084332-15vpfvd","Type":"NodeParagraph","Properties":{"id":"20240616084332-15vpfvd","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"苍术羌活汤。苍术（制）羌活黄芩枳壳半夏柴胡川芎陈皮各等分。甘草减半。生姜三片。"}]},{"ID":"20240616084332-glldzfn","Type":"NodeParagraph","Properties":{"id":"20240616084332-glldzfn","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"水煎温服。治瘴疠腹满寒热。"}]},{"ID":"20240616084332-8t8srp7","Type":"NodeParagraph","Properties":{"id":"20240616084332-8t8srp7","updated":"20240616084332"},"Children":[{"Type":"NodeText","Data":"苍术香附丸。苍术香附三棱神曲浓朴（姜制）生地蓬莪术当归各二两。明矾八两。（麸炒黑色）研细末水丸梧子大。每服二三十丸。熟汤下。治妇人气块。"}]},{"ID":"20240616084319-qnfvpwx","Type":"NodeThematicBreak","Properties":{"id":"20240616084319-qnfvpwx"}},{"ID":"20240616084320-crdxo9s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084320-crdxo9s","updated":"20240616084326"},"Children":[{"Type":"NodeText","Data":"苍术《本草衍义》"}]},{"ID":"20240616084320-6tu9cmz","Type":"NodeParagraph","Properties":{"id":"20240616084320-6tu9cmz","updated":"20240616084320"},"Children":[{"Type":"NodeText","Data":"其长如大拇指，肥实，皮色褐，气味辛烈，须米泔浸洗，再换泔浸二日，去上粗皮。"}]},{"ID":"20240616084320-gfvqwiy","Type":"NodeParagraph","Properties":{"id":"20240616084320-gfvqwiy","updated":"20240616084320"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白术"},{"Type":"NodeText","Data":"粗促，色微褐，气味亦微辛，苦而不烈。古方及《本经》只言术，未见分其苍白二种也。只缘陶隐居言术有两种。自此，人多贵白者。今人但贵其难得，惟用白者，往往将苍术置而不用。如古方平胃散之类，苍术为最要药，功尤速。殊不详《本草》元无白术之名，近世多用，亦宜两审。嵇康曰∶“闻道人遗言，饵术、黄精，令人久寿”，亦无白字。"}]},{"ID":"20240616084303-fxit6x3","Type":"NodeThematicBreak","Properties":{"id":"20240616084303-fxit6x3"}},{"ID":"20240616084304-p0tlh77","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084304-p0tlh77","updated":"20240616084309"},"Children":[{"Type":"NodeText","Data":"苍术《本草求真》"}]},{"ID":"20240616084304-r6tad3w","Type":"NodeParagraph","Properties":{"id":"20240616084304-r6tad3w","updated":"20240616084304"},"Children":[{"Type":"NodeText","Data":"（山草）升阳发汗除郁"}]},{"ID":"20240616084304-7jzkv2a","Type":"NodeParagraph","Properties":{"id":"20240616084304-7jzkv2a","updated":"20240616084304"},"Children":[{"Type":"NodeText","Data":"苍术（专入脾）。甘苦辛烈。气温无毒。虽有升阳散郁。发汗除湿。（杨氏家验方。男子妇人因食生熟物。留滞肠胃。遂至生虫。久则好食生米。否则终日不乐。及至憔悴萎黄。饮食不思。用苍术一味为丸而愈。益昌伶人刘清啸一娼名曰花翠。年逾笄。病此。惠民局监赵尹以此治之。两旬而愈。盖生米留滞肠胃。受湿则谷不磨而成此疾。故用苍术去湿暖胃消谷。）"}]},{"ID":"20240616084304-bfw811f","Type":"NodeParagraph","Properties":{"id":"20240616084304-bfw811f","updated":"20240616084304"},"Children":[{"Type":"NodeText","Data":"燥痰（许叔微本事方云。予患饮癖三十年。遍求名医不效。自揣必有癖囊。如水之有科臼。不盈科不行。但清者可行。而浊者停滞。无路以决之。故积至五七日必呕而去。脾土恶湿。而水则流湿。莫如燥脾以去湿。崇土以填科臼。乃悉屏诸药。只以苍术一味。同枣肉为丸。忌桃李雀肉而疾除。）辟恶。（时珍曰。陶隐居言术能除恶气。弥灾诊。故今病疫及岁旦。人家往往烧苍术以辟邪气。夷坚志载江西一士人为阴气所侵。或曰。君必当暴泄。但多服平胃散为良。中有苍术能去辟也。）治肿之功。然甘味少而辛苦重。不似白术性禀中和。直固清阳中气之为妙耳。故同香附则为散郁而气平。（苍术能径入诸经。疏泄阳明之湿。通行敛涩。香附乃阴中快气之药。一升一降。故郁散而平。）同黄柏则能治下部湿热。（黄柏味苦。苦胜热。故可以去湿中之热。苍术性燥。燥胜湿。故可以去热中之湿。两者相需妙用。故其方呼为二妙。）同大枣则能治胁下饮 。（用枣始能固中也。）同二陈加白术升柴。则能以治脾湿下流。肠风带浊。（带浊有寒有热。有痰有气。有风有湿各异。须要审症辨用。）然必禀体肥盛多湿者始宜。若形瘦多火切忌。至云服能轻身长生。不过因其湿去之谓。岂真能入仙境之地哉？（本草多有长生不老之说。欺世惑民。以致药品真义不出耳。）出茅山。坚小有朱砂点者良。糯米泔浸焙干。同芝麻炒以制其燥。防风地榆为使。"}]},{"ID":"20240616084252-p8bmw68","Type":"NodeThematicBreak","Properties":{"id":"20240616084252-p8bmw68"}},{"ID":"20240616084253-fo3sm1g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084253-fo3sm1g","updated":"20240616084257"},"Children":[{"Type":"NodeText","Data":"苍术《本草备要》"}]},{"ID":"20240616084253-n1udts0","Type":"NodeParagraph","Properties":{"id":"20240616084253-n1udts0","updated":"20240616084253"},"Children":[{"Type":"NodeText","Data":"补脾燥湿，宣，升阳散郁"}]},{"ID":"20240616084253-w34yqzk","Type":"NodeParagraph","Properties":{"id":"20240616084253-w34yqzk","updated":"20240616084253"},"Children":[{"Type":"NodeText","Data":"甘温辛烈。燥胃强脾，发汗除湿，能升发胃中阳气（东垣曰∶雄壮上行，能除湿，下安太阴，使邪气不传入脾），止吐泻，逐痰水（许叔微云∶苍术能治水饮之 囊，盖燥脾以去湿，崇土以填科。日用苍术一斤，大枣五十枚，去皮捣，麻油半两，水二盏研，滤汁和丸，名神术丸。丹溪曰∶实脾土，燥脾湿，洵是治痰之本），消肿满，辟恶气（辟一切岚瘴、邪恶、鬼气。暑湿月，焚之佳。《夷坚志》曰∶有士人游西湖，遇一女子，明艳动人，重币求之不得。又五年重寻旧游，怅然空返，忽遇女子，士欣然并行，过旅馆，留半岁，将议偕逝。"}]},{"ID":"20240616084253-bauh7jc","Type":"NodeParagraph","Properties":{"id":"20240616084253-bauh7jc","updated":"20240616084253"},"Children":[{"Type":"NodeText","Data":"女曰∶向自君去，忆念之苦，感疾而亡，今非人也，但君浸阴气深，当暴泻，宜服平胃散，以补安精血。士惊惋曰∶药味皆平，何得取效？女曰∶中有苍术除邪气，乃为上品也）。散风寒湿，为治痿要药（阳明虚则宗筋纵弛，带脉不引故痿蹶。苍术阳明经药。经曰∶治痿独取阳明。合黄柏为二妙散，加牛膝名三妙散）。又能总解痰、火、气、血、湿、食六郁（丹溪曰∶诸郁皆因传化失常，气不得升降。病在中焦，将欲升之，必先降之，将欲降之，必先升之。越鞠丸用苍术、香附。苍术能径入诸经，疏泄阳明之湿，通行敛涩，香附乃阴中快气之药，一升一降，故郁散而平），及脾湿下流，肠风带浊（带浊赤者湿伤血分，从心、小肠来。白者湿伤气分，从肺、大肠来。并有寒热二证，亦有因痰而带浊者，宜二陈加二术、升，柴）。燥结多汗者忌用（南阳文氏值乱，逃往壶山，饥，因有人教以饵术，遂不饥。数十年后归家，颜色更少，气力转健。术一名山精，一名山姜。《导仙录》曰∶子欲长生，当服山精，子欲轻翔，当服山姜。昂按∶苍术善发汗，安能长远服食？文氏仙录之说，要亦方书夸张之言也）。"}]},{"ID":"20240616084253-qjc0tot","Type":"NodeParagraph","Properties":{"id":"20240616084253-qjc0tot","updated":"20240616084253"},"Children":[{"Type":"NodeText","Data":"出茅山坚小有朱砂点者良。糯米泔浸焙干，同芝麻炒，以制其燥。"}]},{"ID":"20240616084253-ttmhv0y","Type":"NodeParagraph","Properties":{"id":"20240616084253-ttmhv0y","updated":"20240616084253"},"Children":[{"Type":"NodeText","Data":"二术皆防风、地榆为使，主治略同，第有止汗发汗之异。古文本草不分苍、白，陶隐君（即宏景）言有两种，始各施用。"}]},{"ID":"20240616084238-83mxfbl","Type":"NodeThematicBreak","Properties":{"id":"20240616084238-83mxfbl"}},{"ID":"20240616084239-6df6lyy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084239-6df6lyy","updated":"20240616084243"},"Children":[{"Type":"NodeText","Data":"苍术《本草撮要》"}]},{"ID":"20240616084239-5up5cy9","Type":"NodeParagraph","Properties":{"id":"20240616084239-5up5cy9","updated":"20240616084239"},"Children":[{"Type":"NodeText","Data":"味苦辛温．入足阳明经．功专补脾燥湿．升阳散郁．得防风发汗．得黄柏胜湿．得香附快中下二焦之气．得山栀解术性之燥．二术皆防风地榆为使．糯米泔浸焙干．同芝麻炒以制其燥．"}]},{"ID":"20240616084228-7x3x0bu","Type":"NodeThematicBreak","Properties":{"id":"20240616084228-7x3x0bu"}},{"ID":"20240616084229-n328try","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084229-n328try","updated":"20240616084233"},"Children":[{"Type":"NodeText","Data":"苍术《冯氏锦囊秘录》"}]},{"ID":"20240616084229-xzxemru","Type":"NodeParagraph","Properties":{"id":"20240616084229-xzxemru","updated":"20240616084229"},"Children":[{"Type":"NodeText","Data":"味苦、甘、辛，气温，无毒。苦辛重而甘味轻，故燥烈除湿之功则有余，补中扶脾之功则不足矣。宜囫囵米泔水浸一宿，切片晒干，炒深黄色。"}]},{"ID":"20240616084229-0gv4jyc","Type":"NodeParagraph","Properties":{"id":"20240616084229-0gv4jyc","updated":"20240616084229"},"Children":[{"Type":"NodeText","Data":"苍术消痰结窠囊，宽胸中窄狭，治身面大风，风眩头疼。辟山岚障气，瘟疫时气，暖胃安胎，宽中进食，驱 癖气块，止心腹胀痛。补脾燥湿之功，与白术功用皆同，但白补性居多，且能敛汗；苍气辛烈，又能发汗。白术性禀冲和，直固清阳中气；苍木性多燥悍，功专除湿祛风，无湿者便不可用，况于燥症乎。"}]},{"ID":"20240616084229-k1utd7p","Type":"NodeParagraph","Properties":{"id":"20240616084229-k1utd7p","updated":"20240616084229"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 燥湿健脾，辟恶宽中，进食暖胃，痘疮湿疡及不结痂可用。然性太燥，不宜多投，在起胀灌浆，尤所禁焉。有用以烧烟，辟其不正之气，可暂不可常，亦虑其燥耳。"}]},{"ID":"20240616084229-q5l6p15","Type":"NodeParagraph","Properties":{"id":"20240616084229-q5l6p15","updated":"20240616084229"},"Children":[{"Type":"NodeText","Data":"按∶苍术为湿家痰家要剂，辛温辟邪，得天地之正气者欤，但阴虚便燥，渴而火亢者忌之。"}]},{"ID":"20240616084215-ics0q7f","Type":"NodeThematicBreak","Properties":{"id":"20240616084215-ics0q7f"}},{"ID":"20240616084216-h1hs35y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084216-h1hs35y","updated":"20240616084222"},"Children":[{"Type":"NodeText","Data":"苍术《本草便读》"}]},{"ID":"20240616084216-9ypf0r9","Type":"NodeParagraph","Properties":{"id":"20240616084216-9ypf0r9","updated":"20240616084216"},"Children":[{"Type":"NodeText","Data":"辛苦气温．燥湿强脾能发汗．芳香质壮．宣中解郁并驱邪．破水结之 囊．浊痰尽化．平胃中之敦阜．瘴疠全消．（苍术汉时名赤术．处处山谷皆有之．而以江苏茅山者为上．其形较白术为小．切之内有朱砂点．其味辛苦．其气香烈．燥散之性则有余．补助之功则不足也．专入脾胃．阴虚血燥者忌之．）"}]},{"ID":"20240616084204-n37fquu","Type":"NodeThematicBreak","Properties":{"id":"20240616084204-n37fquu"}},{"ID":"20240616084206-5ccvrw9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084206-5ccvrw9","updated":"20240616084210"},"Children":[{"Type":"NodeText","Data":"苍术《本草纲目》"}]},{"ID":"20240616084206-5x23cpt","Type":"NodeParagraph","Properties":{"id":"20240616084206-5x23cpt","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"「释名」亦名赤术、山精、仙术、山蓟。"}]},{"ID":"20240616084206-yulip4b","Type":"NodeParagraph","Properties":{"id":"20240616084206-yulip4b","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"「气味」苦、温、无毒。"}]},{"ID":"20240616084206-enyj1ja","Type":"NodeParagraph","Properties":{"id":"20240616084206-enyj1ja","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616084206-55n9ely","Type":"NodeParagraph","Properties":{"id":"20240616084206-55n9ely","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"1、面黄食少。用苍术一斤、熟地黄半斤、干姜（炮）五钱至一两（夏天五钱，冬天一两），共研细，加糊成丸，如梧子大。每服五十丸。温水送下。"}]},{"ID":"20240616084206-4xrf910","Type":"NodeParagraph","Properties":{"id":"20240616084206-4xrf910","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"2、喜吃生米（不思熟食，爱嚼生米，憔悴萎黄，终于不起）。用苍术在淘米水中浸一夜，取出焙干，锉碎成末，加蒸饼做成丸子，如梧子大。每服五十丸，饭前服，一天服三次，米汤送下。半月左右可愈。"}]},{"ID":"20240616084206-vp06bj5","Type":"NodeParagraph","Properties":{"id":"20240616084206-vp06bj5","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"3、腹中虚冷，不能饮食，食亦不化。用苍术二斤、曲一斤，共炒为末，加蜜做成丸子，如梧子大。每服三十丸，米汤送下。一天服三次。如怕冷，加干姜三两；腹痛，加当归三两；衰弱，加甘草二两。"}]},{"ID":"20240616084206-4ygpo9z","Type":"NodeParagraph","Properties":{"id":"20240616084206-4ygpo9z","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"4、脾湿水泻（困弱无力，水谷不化，腹痛甚剧）。用苍术二两、白芍药一两、黄芩半两、淡桂二钱，混合后，每取一两煎服。如脉弦，头微痛，则减去芍药，加防水二两。"}]},{"ID":"20240616084206-gu4lhrq","Type":"NodeParagraph","Properties":{"id":"20240616084206-gu4lhrq","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"5、暑天暴泻。用神曲（炒）、苍术（淘米水中浸一夜，焙干），等为分末，加糊做成丸子，如梧子大。每服三、五丸，米汤送下。此方名“曲术丸”。"}]},{"ID":"20240616084206-fk4jc06","Type":"NodeParagraph","Properties":{"id":"20240616084206-fk4jc06","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"6、久痢。用苍术二两、川椒一两，共研为末，加醋、糊做成丸子，如梧子大。每服二十丸，饭前服，温水送下。此方称“椒术丸”。恶痢久者，加桂。"}]},{"ID":"20240616084206-276h4ua","Type":"NodeParagraph","Properties":{"id":"20240616084206-276h4ua","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"7、脾湿下血。用苍术二两、地榆一两、分作两份，每份以水二碗，煎成一碗，食前湿服。"}]},{"ID":"20240616084206-3k7vxg4","Type":"NodeParagraph","Properties":{"id":"20240616084206-3k7vxg4","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"8、青盲、雀目。用苍术四两，淘米水浸一夜，切片焙干，研细，每服三钱。另将药末包在猪肝中，扎好，和粟米同煮熟，用以熏眼。临眼前，食肝饮汁。又方：用苍术二两，淘米水浸过，焙干，捣碎为末，每服一钱。另以羊肝一斤，切破，放入药末，扎好，以淘米水煮熟，冷定吃下。"}]},{"ID":"20240616084206-wktrep5","Type":"NodeParagraph","Properties":{"id":"20240616084206-wktrep5","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"9、两目昏涩。用苍术半斤，淘米水浸七天，去皮切片，焙干，加木贼二两，共研为末。每服一钱，茶或酒送下。"}]},{"ID":"20240616084206-wgl3uzm","Type":"NodeParagraph","Properties":{"id":"20240616084206-wgl3uzm","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"10、风牙肿痛。把盐水浸过的苍术烧存性，研档擦牙。"}]},{"ID":"20240616084206-uwvnftw","Type":"NodeParagraph","Properties":{"id":"20240616084206-uwvnftw","updated":"20240616084206"},"Children":[{"Type":"NodeText","Data":"11、脐虫怪病（腹硬如铁，脐中流水，如虫爬行，痒不可忍）。用苍术煎成浓汤洗浴。另以苍术末加麝香少许，水调匀服下。"}]},{"ID":"20240616084153-f0kbbpz","Type":"NodeThematicBreak","Properties":{"id":"20240616084153-f0kbbpz"}},{"ID":"20240616084154-hyqdv1g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084154-hyqdv1g","updated":"20240616084158"},"Children":[{"Type":"NodeText","Data":"苍术《医学入门》"}]},{"ID":"20240616084154-dy7hsgk","Type":"NodeParagraph","Properties":{"id":"20240616084154-dy7hsgk","updated":"20240616084154"},"Children":[{"Type":"NodeText","Data":"苍术辛烈苦甘温，主风寒湿痹疸屯，肿满痰积疟皆散，止呕泻治头目昏。"}]},{"ID":"20240616084154-vt3cbzw","Type":"NodeParagraph","Properties":{"id":"20240616084154-vt3cbzw","updated":"20240616084154"},"Children":[{"Type":"NodeText","Data":"苍，以色言，无毒。浮而升，阳也。入足阳明太阴经。主风寒湿痹，死肌痉疸，逐皮间风水结肿，心下满闷，腹中胀痛窄狭，消痰饮、 癖、气块，祛疟，除瘟疫、山岚瘴气，止霍乱吐泻不止。治大风在身面，风眩头痛，目泪出、青盲雀目、内外翳障。久服乌须注颜、壮筋骨、明耳目、润肌肤是验，然此皆为阳虚者言也。"}]},{"ID":"20240616084154-tydbm82","Type":"NodeParagraph","Properties":{"id":"20240616084154-tydbm82","updated":"20240616084154"},"Children":[{"Type":"NodeText","Data":"丹溪云∶辛散雄壮，发汗甚速。以黄柏、牛膝、石膏下行之药引之，则治下焦湿疾。入平胃散，能去中焦湿疾，而平胃中有余之气；入葱白、麻黄之类，则能散肉分至皮表之邪。惟血虚怯弱及七情气闷者慎用，误服耗气血，燥津液，虚火动而痞闷愈甚。米泔浸七日夜，去粗皮，炒黄色，或童便浸。防风、地榆为使。忌桃、李、雀、鸽肉。抑考《神农经》云∶若欲长生，须服山精。言术结阴阳之精，未尝分苍白也。自陶隐居分用，而后贵白而贱苍，善乎！东垣云∶补中除湿，力不及白；宽中发汗，功过于白。"}]},{"ID":"20240616084144-n2mmyie","Type":"NodeThematicBreak","Properties":{"id":"20240616084144-n2mmyie"}},{"ID":"20240616084144-8ybe11q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084144-8ybe11q","updated":"20240616084149"},"Children":[{"Type":"NodeText","Data":"苍术《药性切用》"}]},{"ID":"20240616084144-jz18svc","Type":"NodeParagraph","Properties":{"id":"20240616084144-jz18svc","updated":"20240616084144"},"Children":[{"Type":"NodeText","Data":"苦温辛烈，燥胃强脾，发汗除湿，能升发胃中阳气，辟恶解郁。产茅山者，真米泔浸亦有麻油炒者。燥结多汗忌。"}]},{"ID":"20240616084044-ffzejhw","Type":"NodeThematicBreak","Properties":{"id":"20240616084044-ffzejhw"}},{"ID":"20240616084045-9wfwwpx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084045-9wfwwpx","updated":"20240616084049"},"Children":[{"Type":"NodeText","Data":"苍术《本草择要纲目》"}]},{"ID":"20240616084045-2gynbyu","Type":"NodeParagraph","Properties":{"id":"20240616084045-2gynbyu","updated":"20240616084045"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616084045-37sun7t","Type":"NodeParagraph","Properties":{"id":"20240616084045-37sun7t","updated":"20240616084045"},"Children":[{"Type":"NodeText","Data":"苦温无毒．又甘辛．可升可降．阴中阳也．入足太阴阳明太阳之经．"}]},{"ID":"20240616084045-casatak","Type":"NodeParagraph","Properties":{"id":"20240616084045-casatak","updated":"20240616084045"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616084045-h4lem6b","Type":"NodeParagraph","Properties":{"id":"20240616084045-h4lem6b","updated":"20240616084045"},"Children":[{"Type":"NodeText","Data":"风寒湿痹．消痰水．暖胃消谷嗜食．瘟疾山岚瘴气．以其有雄壮上行之气．故能除湿．下安太阴．使邪气不传入脾．以其经疳浸火炒．故能出汗．与白术止汗特异．用者不可以此代彼．盖有止发之别．其余主治则同．脾精不禁．小便漏浊淋不止．腰背酸痛．宜用苍术以敛脾精．精生于谷故也．随经援引．务在驱使得宜．"}]},{"ID":"20240616083948-6g0l95r","Type":"NodeThematicBreak","Properties":{"id":"20240616083948-6g0l95r"}},{"ID":"20240616084030-p0wjp8y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616084030-p0wjp8y","updated":"20240616084037"},"Children":[{"Type":"NodeText","Data":"苍朮《中药学》"}]},{"ID":"20240616084030-zkzsd7x","Type":"NodeParagraph","Properties":{"id":"20240616084030-zkzsd7x","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【药用】菊科草本植物茅苍朮Atractlodeslancea（Thunb.）DC.或北苍朮A.chinensis（DC.）Koidz.或关苍朮A.japonicaKoidz.exKitam的根茎。"}]},{"ID":"20240616084030-mp7s0pq","Type":"NodeParagraph","Properties":{"id":"20240616084030-mp7s0pq","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，温。归脾、胃经。"}]},{"ID":"20240616084030-cyqluzt","Type":"NodeParagraph","Properties":{"id":"20240616084030-cyqluzt","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【功效】燥湿健脾，祛风湿，解表，明目。"}]},{"ID":"20240616084030-4lctq8z","Type":"NodeParagraph","Properties":{"id":"20240616084030-4lctq8z","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于湿阻脾胃、脘腹胀满，寒湿白带，湿温病以及湿热下注、脚膝肿痛、痿软无力等症。"}]},{"ID":"20240616084030-1yz6jk7","Type":"NodeParagraph","Properties":{"id":"20240616084030-1yz6jk7","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"苍朮温燥而辛烈，主要用于寒湿较重的症候一般以舌苔白腻厚浊作为选用的依据。由于其燥湿力强，湿去则脾胃得以健运，故称其功用燥湿健脾。临床用治湿阻脾胃，而见脘腹胀满、食欲不振、倦怠乏力、舌苔白腻厚浊等症，常与厚朴、陈皮等配伍应用；用治寒湿白带，可配白芷同用。本品虽属温燥之品，然燥湿力强，又每配合清热之品以治湿热为患之证，如湿热白带，又可配知母、苦参、墓头回；湿热下注、脚膝肿痛、痿软无力，可配黄柏、牛膝、苡仁等同用；湿温病证可配石膏、知母等同用。"}]},{"ID":"20240616084030-m1clzkj","Type":"NodeParagraph","Properties":{"id":"20240616084030-m1clzkj","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"2.用于风湿痹痛、肢体关节疼痛。"}]},{"ID":"20240616084030-srblbqj","Type":"NodeParagraph","Properties":{"id":"20240616084030-srblbqj","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"本品既能温燥除湿，又能辛散祛风，散除经络肢体的风湿之邪，对寒湿偏重的痹痛尤为适宜，可配合羌活、独活等同用。"}]},{"ID":"20240616084030-lmk9d2w","Type":"NodeParagraph","Properties":{"id":"20240616084030-lmk9d2w","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"3.用于风寒表证。"}]},{"ID":"20240616084030-wy0h0ii","Type":"NodeParagraph","Properties":{"id":"20240616084030-wy0h0ii","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"本品辛散，兼能散寒解表，适用于感受风寒湿邪的头痛、身痛、无汗等症，常与羌活、细辛、防风等同用。"}]},{"ID":"20240616084030-lpkeo4o","Type":"NodeParagraph","Properties":{"id":"20240616084030-lpkeo4o","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"4.用于夜盲、眼目昏涩。"}]},{"ID":"20240616084030-dq4o85m","Type":"NodeParagraph","Properties":{"id":"20240616084030-dq4o85m","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"苍朮生用有明目之功，为治夜盲要药，可与猪肝或羊肝、石决明等配伍同用。"}]},{"ID":"20240616084030-akl1jz8","Type":"NodeParagraph","Properties":{"id":"20240616084030-akl1jz8","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"此外，本品气味芳香，又能辟秽，民间每于夏历端午节用苍朮与白芷在室内同燃，用以辟疫。经近人实验，此法确能起到消毒杀菌的作用。"}]},{"ID":"20240616084030-t26qzhb","Type":"NodeParagraph","Properties":{"id":"20240616084030-t26qzhb","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【处方用名】制苍朮（用米泔水浸透，再蒸黑，减少辛燥之性。）"}]},{"ID":"20240616084030-bszof9j","Type":"NodeParagraph","Properties":{"id":"20240616084030-bszof9j","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"炒苍朮（用麸皮拌炒至微黄色为度，减少它辛燥之性。）"}]},{"ID":"20240616084030-bx6899b","Type":"NodeParagraph","Properties":{"id":"20240616084030-bx6899b","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"生苍朮（用米泔水浸润，切片，晒干。药性较辛燥。）"}]},{"ID":"20240616084030-n8qqnpi","Type":"NodeParagraph","Properties":{"id":"20240616084030-n8qqnpi","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"茅朮、炒茅朮、焦茅朮、灸茅朮（麸皮拌炒）"}]},{"ID":"20240616084030-x61pjtr","Type":"NodeParagraph","Properties":{"id":"20240616084030-x61pjtr","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240616084030-d2q14nf","Type":"NodeParagraph","Properties":{"id":"20240616084030-d2q14nf","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【按语】1.苍朮苦温，能入脾胃，燥湿健脾，以除寒湿中阻之症；辛香且主行散，祛风胜湿，以治风湿痹痛之候。兼能发散除风湿在表，且可明目愈雀目夜盲。"}]},{"ID":"20240616084030-ep9vwl8","Type":"NodeParagraph","Properties":{"id":"20240616084030-ep9vwl8","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"2.苍朮性偏温燥，易于伤阴，以湿浊内阻、舌苔厚腻者用之为宜。如阴虚有热、大便燥结及多汗者，不宜应用。然雀目夜盲之症则不必拘于有湿才可应用的说法。"}]},{"ID":"20240616084030-bw7jat2","Type":"NodeParagraph","Properties":{"id":"20240616084030-bw7jat2","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【方剂举例】平胃散（《和局方剂》）：苍朮、知母、陈皮、甘草治呕吐腹泻，上腹部痞满疼痛。"}]},{"ID":"20240616084030-k1r3ds9","Type":"NodeParagraph","Properties":{"id":"20240616084030-k1r3ds9","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"二妙散（《丹溪心法》）：苍朮、黄柏。治下肢红肿疼痛，痿弱无力。"}]},{"ID":"20240616084030-bcsb9zu","Type":"NodeParagraph","Properties":{"id":"20240616084030-bcsb9zu","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"白虎加苍朮汤（《活人书》）：石膏、知母、甘草、粳米、苍朮。治湿温，汗多，身重足冷；或湿痹化热，以及夏秋季高热，具头重如裹，胸闷，口可不欲饮，关节疼痛，舌苔白腻者。"}]},{"ID":"20240616084030-es0owqw","Type":"NodeParagraph","Properties":{"id":"20240616084030-es0owqw","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"神朮散（《和局方剂》）：苍朮、高本、白芷、细辛、羌活、川芎、甘草、生姜、葱白。治外感风寒湿邪，发热恶寒，头痛项强，肢体酸痛者。"}]},{"ID":"20240616084030-0yffgk4","Type":"NodeParagraph","Properties":{"id":"20240616084030-0yffgk4","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本草通玄》：「宽中发汗，其功胜于白朮，补中除湿，其力不胜白朮。大抵卑坚之土，宜以白朮以培之，敦阜之土，宜于苍朮以平之。」"}]},{"ID":"20240616084030-s51u3ur","Type":"NodeParagraph","Properties":{"id":"20240616084030-s51u3ur","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"《药品化义》：「味主辛散，性温而燥，燥可去湿，专入脾胃，主治风寒湿气，山岚瘴气，皮肤水肿，皆辛烈逐邪之气也。统治三部之湿，若湿在上焦，易生湿痰，以此燥湿行痰；湿在中焦，滞气作泻，以此宽中健脾；湿在下部，足膝痿软，以此同黄柏治痿，能另足膝有力；取其辛散气雄，用之散邪发汗，极其畅快。」"}]},{"ID":"20240616084030-u6sgxiv","Type":"NodeParagraph","Properties":{"id":"20240616084030-u6sgxiv","updated":"20240616084030"},"Children":[{"Type":"NodeText","Data":"《本草正义》：「气味雄厚，较白朮愈猛，能切上切下，燥湿而宣化痰饮，芳香辟秽，胜四时不正之气；故时疫之病多用之。最能驱除秽浊恶气，阴霾之域，久旷之屋，宜焚此物而后居人，亦此意也。凡湿困脾阳，倦怠嗜卧，胸膈满闷，甚则？？胀而舌浊厚腻者，非茅朮芳香猛烈，不能开泄，而痰饮弥漫亦非此不化。......而脾家郁湿，或为？？胀，或为肿满，或为泻泄疟痢，或下流而足重跗肿，或积滞而二便不利，及湿热郁蒸，发为疮疡流注，或寒湿互结，发为阴疽酸痛，但有什浊不可见证，茅朮一味，最为必需之品。是合内外各病，皆有大用者。」"}]},{"ID":"20240607095034-javwsmi","Type":"NodeThematicBreak","Properties":{"id":"20240607095034-javwsmi"}},{"ID":"20240607095035-ynxzin1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095035-ynxzin1","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"《中国药典》：白术"}]},{"ID":"20240607095035-nq7e42v","Type":"NodeParagraph","Properties":{"id":"20240607095035-nq7e42v","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095035-rn6oxyx","Type":"NodeParagraph","Properties":{"id":"20240607095035-rn6oxyx","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" Bái Zhú"}]},{"ID":"20240607095035-hup658k","Type":"NodeParagraph","Properties":{"id":"20240607095035-hup658k","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095035-sdyzxca","Type":"NodeParagraph","Properties":{"id":"20240607095035-sdyzxca","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 于术、冬术、浙术、种术"}]},{"ID":"20240607095035-i22cooa","Type":"NodeParagraph","Properties":{"id":"20240607095035-i22cooa","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607095035-57nsxcb","Type":"NodeParagraph","Properties":{"id":"20240607095035-57nsxcb","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" RHIZOMA ATRACTYLODIS MACROCEPHALAE"}]},{"ID":"20240607095035-0mpbzjs","Type":"NodeParagraph","Properties":{"id":"20240607095035-0mpbzjs","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095035-zn5o6ki","Type":"NodeParagraph","Properties":{"id":"20240607095035-zn5o6ki","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白术"},{"Type":"NodeText","Data":"Atractylodes macrocephala Koidz.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。冬季下部叶枯黄、上部叶变脆时采挖，除去泥沙，烘干或晒干，再除去须根。"}]},{"ID":"20240607095035-1ss57z0","Type":"NodeParagraph","Properties":{"id":"20240607095035-1ss57z0","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095035-5hp75xg","Type":"NodeParagraph","Properties":{"id":"20240607095035-5hp75xg","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 本品为不规则的肥厚团块，长3～13cm，直径1.5～7cm。表面灰黄色或灰棕色，有瘤状突起及断续的纵皱和沟纹，并有须根痕，顶端有残留茎基和芽痕。质坚硬不易折断，断面不平坦，黄白色至淡棕色，有棕黄色的点状油室散在；烘干者断面角质样，色较深或有裂隙。气清香，味甘、微辛，嚼之略带黏性。"}]},{"ID":"20240607095035-rjts2k8","Type":"NodeParagraph","Properties":{"id":"20240607095035-rjts2k8","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095035-ogucb4w","Type":"NodeParagraph","Properties":{"id":"20240607095035-ogucb4w","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"土白术"},{"Type":"NodeText","Data":"：取白术片，用伏龙肝细粉炒至表面挂有土色，筛去多余的土。每100kg白术片 ，用伏龙肝细粉20kg。"}]},{"ID":"20240607095035-v91zchk","Type":"NodeParagraph","Properties":{"id":"20240607095035-v91zchk","updated":"20240607095035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒白术"},{"Type":"NodeText","Data":"：将蜜炙麸皮撒入热锅内，待冒烟时加入白术片，炒至焦黄色、逸出焦香气，取出，筛去蜜炙麸皮。每 100kg白术片，用蜜炙麸皮10kg。"}]},{"ID":"20240607095035-0xldgah","Type":"NodeParagraph","Properties":{"id":"20240607095035-0xldgah","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607095035-uuvpegj","Type":"NodeParagraph","Properties":{"id":"20240607095035-uuvpegj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末淡黄棕色。草酸钙针晶细小，长10～32μm，不规则地聚集于薄壁细胞中，少数针晶直径至 4μm。纤维黄色，大多成束，长梭形，直径约至40μm，壁甚厚，木化，孔沟明显。石细胞淡黄色，类圆形、多角形、长方形或少数纺锤形，直径37～64μm。薄壁细胞含菊糖，表面显放射状纹理。导管分子短小，为网纹及具缘纹孔，直径至48μm。"}]},{"ID":"20240607095035-zu8347f","Type":"NodeParagraph","Properties":{"id":"20240607095035-zu8347f","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末2g，置具塞锥形瓶中，加乙醚20ml，振摇10分钟，滤过。取滤液10ml挥干，加10％香草醛硫酸溶液，显紫色；另取滤液 1滴，点于滤纸上，挥干，喷洒1％香草醛硫酸溶液，显桃红色。"}]},{"ID":"20240607095035-l5ojk4q","Type":"NodeParagraph","Properties":{"id":"20240607095035-l5ojk4q","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"（3） 取本品粉末0.5g，加正已烷 2ml，超声处理15分钟，滤过，滤液作为供试品溶液。另取白术对照药材0.5g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述新制备的两种溶液各10μl，分别点于同一硅胶Ｇ薄层板上，以石油醚（ 60～90℃） －醋酸乙酯（50:1）为展开剂，展开，取出，晾干，喷以 5％香草醛硫酸溶液，加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点，并应显有一桃红色主斑点（苍术酮）。"}]},{"ID":"20240607095035-emqlv0n","Type":"NodeParagraph","Properties":{"id":"20240607095035-emqlv0n","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095035-qrhd3nz","Type":"NodeParagraph","Properties":{"id":"20240607095035-qrhd3nz","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 归脾、胃经。"}]},{"ID":"20240607095035-0bdfuqz","Type":"NodeParagraph","Properties":{"id":"20240607095035-0bdfuqz","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095035-4bhaslc","Type":"NodeParagraph","Properties":{"id":"20240607095035-4bhaslc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 苦、甘，温。"}]},{"ID":"20240607095035-zt890rj","Type":"NodeParagraph","Properties":{"id":"20240607095035-zt890rj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095035-scn2jsc","Type":"NodeParagraph","Properties":{"id":"20240607095035-scn2jsc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 健脾益气，燥湿利水，止汗，安胎。用于脾虚食少，腹胀泄泻，痰饮眩悸，水肿，自汗，胎动不安。土白术健脾，和胃，安胎。用于脾虚食少，泄泻便溏，胎动不安。"}]},{"ID":"20240607095035-v6azdnt","Type":"NodeParagraph","Properties":{"id":"20240607095035-v6azdnt","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095035-a98uv4m","Type":"NodeParagraph","Properties":{"id":"20240607095035-a98uv4m","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240607095035-te73gk0","Type":"NodeParagraph","Properties":{"id":"20240607095035-te73gk0","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095035-90b7fyw","Type":"NodeParagraph","Properties":{"id":"20240607095035-90b7fyw","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607095035-azssbsa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095035-azssbsa","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白术"}]},{"ID":"20240607095035-wvlj5n3","Type":"NodeParagraph","Properties":{"id":"20240607095035-wvlj5n3","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095035-lcy1sel","Type":"NodeParagraph","Properties":{"id":"20240607095035-lcy1sel","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" Bái Zhú"}]},{"ID":"20240607095035-l0f1uf8","Type":"NodeParagraph","Properties":{"id":"20240607095035-l0f1uf8","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095035-btvumpc","Type":"NodeParagraph","Properties":{"id":"20240607095035-btvumpc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 山蓟、杨抱蓟（《尔雅》），术（《本经）），山芥、天蓟（《吴普本草》），山姜（《广雅》），乞力伽（《南方草木状》），山精（《神药经》），山连（《别录》），冬白术（《得配本草》）。"}]},{"ID":"20240607095035-qy47z84","Type":"NodeParagraph","Properties":{"id":"20240607095035-qy47z84","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607095035-jtvawhu","Type":"NodeParagraph","Properties":{"id":"20240607095035-jtvawhu","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 陶弘景"}]},{"ID":"20240607095035-sv4ny6h","Type":"NodeParagraph","Properties":{"id":"20240607095035-sv4ny6h","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095035-e0n22jd","Type":"NodeParagraph","Properties":{"id":"20240607095035-e0n22jd","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白术"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。霜降至立冬采挖，除去茎叶和泥土，烘干或晒干，再除去须根即可。烘干者称\"烘术\"；晒干者称\"生晒术\"，亦称\"冬术\"。"}]},{"ID":"20240607095035-9160a39","Type":"NodeParagraph","Properties":{"id":"20240607095035-9160a39","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607095035-g62qzwh","Type":"NodeParagraph","Properties":{"id":"20240607095035-g62qzwh","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 原生于山区丘陵地带，野生种在原产地几已绝迹。现广为栽培，安徽、江苏、浙江、福建、江西、湖南、湖北、四川、贵州等地均有，而以浙江栽培的数量最大。主产浙江、安徽。此外，湖南、湖北、江西、福建等地亦产。以浙江嵊县、新昌地区产量最大；于潜所产品质最佳，特称为\"于术\"。"}]},{"ID":"20240607095035-sfyu8jq","Type":"NodeParagraph","Properties":{"id":"20240607095035-sfyu8jq","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607095035-wgx9mvz","Type":"NodeParagraph","Properties":{"id":"20240607095035-wgx9mvz","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高30～80厘米。根茎粗大，略呈拳状。茎直立，上部分枝，基部木质化，具不明显纵槽。单叶互生；茎下部叶有长柄，叶片3深裂，偶为5深裂，中间裂片较大，椭圆形或卵状彼针形，两侧裂片较小，通常为卵状披针形，基部不对称；茎上部叶的叶柄较短，叶片不分裂，椭圆形至卵状披针形，长4～10厘米，宽1.5～4厘米，先端渐尖，基部渐狭下延成柄状，叶缘均有刺状齿，上面绿色，下面淡绿色，叶脉凸起显着。头状花序顶生，直径2～4厘米；总苞钟状，总苞片7～8列，膜质，覆瓦状排列；基部叶状苞1轮，羽状深裂，包围总苞；花多数，着生于平坦的花托上；花冠管状，下部细，淡黄色，上部梢膨大，紫色，先端5裂，裂片披针形，外展或反卷；雄蕊5，花药线形，花丝离生；雌蕊1，子房下位，密被淡褐色绒毛，花柱细长，柱头头状，顶端中央有1浅裂缝。瘦果长圆状椭圆形，微扁，长约8毫米，径约2.5毫米，被黄白色绒毛，顶端有冠毛残留的圆形痕迹。花期9～10月。果期10～11月。"}]},{"ID":"20240607095035-k85htap","Type":"NodeParagraph","Properties":{"id":"20240607095035-k85htap","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095035-yj0vhkt","Type":"NodeParagraph","Properties":{"id":"20240607095035-yj0vhkt","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 干燥的根茎，呈拳状团块，有不规则的瘤状突起，长5～8厘米，直径2～5厘米。表面灰黄色至棕黄色，有浅而细的纵皱纹。下部两侧膨大似如意头，俗称\"云头\"。向上则渐细，或留有一段地上茎，俗称\"白术腿\"。在瘤状突起的顶端，常有茎基残迹或芽痕，须根痕也较明显。质坚硬，不易折断，断面不平坦。烘术的断面淡黄白色，角质，中央时有裂隙。生晒术的断面皮部类白色，本质部淡黄色至黄色，有油点。气香，味甜微辛，略带粘液性。以个大、表面灰黄色、断面黄白色、有云头、质坚实、无空心者为佳。"}]},{"ID":"20240607095035-2cwz5q5","Type":"NodeParagraph","Properties":{"id":"20240607095035-2cwz5q5","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"野于术是产于浙江於潜、吕化、天目山一带的野生白术，一名为\"天生术\"，该种商品早巳绝迹。现售之於术，系将新昌的白术种子，播种在於潜山区的栽培品，折断面黄白色，有黄色放射状纹理。气清香，甜味强而辣味少。一般认为於潜白术的品质较新昌白术为佳。"}]},{"ID":"20240607095035-vi7bk4k","Type":"NodeParagraph","Properties":{"id":"20240607095035-vi7bk4k","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607095035-lbr5rnx","Type":"NodeParagraph","Properties":{"id":"20240607095035-lbr5rnx","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 含挥发油1.4％，主要成分为苍术醇、苍术酮等，并含有维生素A。"}]},{"ID":"20240607095035-m9vqkos","Type":"NodeParagraph","Properties":{"id":"20240607095035-m9vqkos","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095035-0eunn8x","Type":"NodeParagraph","Properties":{"id":"20240607095035-0eunn8x","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 生白术：拣净杂质，用水浸泡，浸泡时间应根据季节，气候变化及白术大小适当掌握，泡后捞出，润透，切片，晒干。"}]},{"ID":"20240607095035-jsfzfvz","Type":"NodeParagraph","Properties":{"id":"20240607095035-jsfzfvz","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"炒白术：先将麸皮撒于热锅内，候烟冒出时，将白术片倒入微炒至淡黄色，取出，筛去麸皮后放凉。（每白术片100斤，用麸皮10斤）"}]},{"ID":"20240607095035-137vx86","Type":"NodeParagraph","Properties":{"id":"20240607095035-137vx86","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"焦白术：将白术片置锅内用武火炒至焦黄色，喷淋清水，取出晾干。"}]},{"ID":"20240607095035-t9rdt9s","Type":"NodeParagraph","Properties":{"id":"20240607095035-t9rdt9s","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"土炒白术：取伏龙肝细粉，置锅内炒热，加入白术片，炒至外面挂有土色时取出，筛去泥土，放凉。（每白术片100斤，用伏龙肝粉20斤）"}]},{"ID":"20240607095035-ellg3x2","Type":"NodeParagraph","Properties":{"id":"20240607095035-ellg3x2","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"①《本草蒙筌》：\"白术咀后，人乳汁润之，制其性也，润过陈壁土和炒。\""}]},{"ID":"20240607095035-9r9yzir","Type":"NodeParagraph","Properties":{"id":"20240607095035-9r9yzir","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"②《本草备要》：\"白术，用糯米泔浸，陈壁土炒，或蜜水炒，人乳拌炒。\""}]},{"ID":"20240607095035-wnhdm20","Type":"NodeParagraph","Properties":{"id":"20240607095035-wnhdm20","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095035-6j8l9cs","Type":"NodeParagraph","Properties":{"id":"20240607095035-6j8l9cs","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240607095035-oh9ne6e","Type":"NodeParagraph","Properties":{"id":"20240607095035-oh9ne6e","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阳、少阴，足阳明、太阴，少阴、厥阴经。\""}]},{"ID":"20240607095035-nut3f5l","Type":"NodeParagraph","Properties":{"id":"20240607095035-nut3f5l","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"入心、脾、胃、三焦四经。\""}]},{"ID":"20240607095035-e6c33lu","Type":"NodeParagraph","Properties":{"id":"20240607095035-e6c33lu","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095035-y7h53u2","Type":"NodeParagraph","Properties":{"id":"20240607095035-y7h53u2","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 苦甘，温。"}]},{"ID":"20240607095035-efkly0y","Type":"NodeParagraph","Properties":{"id":"20240607095035-efkly0y","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，温。\""}]},{"ID":"20240607095035-j5mzsxo","Type":"NodeParagraph","Properties":{"id":"20240607095035-j5mzsxo","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240607095035-ed6w0rf","Type":"NodeParagraph","Properties":{"id":"20240607095035-ed6w0rf","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味甘辛，无毒。\""}]},{"ID":"20240607095035-lydj8qw","Type":"NodeParagraph","Properties":{"id":"20240607095035-lydj8qw","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095035-tgmj385","Type":"NodeParagraph","Properties":{"id":"20240607095035-tgmj385","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 阴虚燥渴，气滞胀闷者忌服。"}]},{"ID":"20240607095035-o1e8n0t","Type":"NodeParagraph","Properties":{"id":"20240607095035-o1e8n0t","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"防风、地榆为之使。\""}]},{"ID":"20240607095035-y742791","Type":"NodeParagraph","Properties":{"id":"20240607095035-y742791","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"凡郁结气滞，胀闷积聚，吼喘壅塞，胃痛由火，痈疽多脓，黑瘦人气实作胀，皆宜忌用。\""}]},{"ID":"20240607095035-ifevi5o","Type":"NodeParagraph","Properties":{"id":"20240607095035-ifevi5o","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095035-x4w6uxt","Type":"NodeParagraph","Properties":{"id":"20240607095035-x4w6uxt","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 补脾，益胃，燥湿，和中，安胎。治脾胃气弱，不思饮食，倦怠少气，虚胀，泄泻，痰饮，水肿，黄疸，湿痹，小便不利，头晕，自汗，胎气不安。"}]},{"ID":"20240607095035-1bslhfg","Type":"NodeParagraph","Properties":{"id":"20240607095035-1bslhfg","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主风寒湿痹，死肌，痉，疸，止汗，除热消食。\""}]},{"ID":"20240607095035-yvqdyin","Type":"NodeParagraph","Properties":{"id":"20240607095035-yvqdyin","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主大风在身面，风眩头痛，目泪出，消痰水，逐皮间风水结肿，除心下急满，及霍乱吐下不止，利腰脐间血，益津液，暖胃，消谷嗜食。\""}]},{"ID":"20240607095035-4t5f7n1","Type":"NodeParagraph","Properties":{"id":"20240607095035-4t5f7n1","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主大风顽痹，多年气痢，心腹胀痛，破消宿食，开胃，去痰诞，除寒热，止下泄，主面光悦，驻颜去皯，治水肿胀满，止呕逆，腹内冷痛，吐泻不住，及胃气虚冷痢。\""}]},{"ID":"20240607095035-yvxy1p2","Type":"NodeParagraph","Properties":{"id":"20240607095035-yvxy1p2","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"利小便。\""}]},{"ID":"20240607095035-rcnodwc","Type":"NodeParagraph","Properties":{"id":"20240607095035-rcnodwc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"治一切风疾，五劳七伤，冷气腹胀，补腰膝，消痰，治水气，利小便，止反胃呕逆，及筋骨弱软，痃癖气块，妇人冷癥瘕，温疾，山岚瘴气，除烦长肌。\""}]},{"ID":"20240607095035-dohkm3z","Type":"NodeParagraph","Properties":{"id":"20240607095035-dohkm3z","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"除湿益燥，和中益气，温中，去脾胃中湿，除胃热，强脾胃，进饮食，和胃，生津液，主肌热，四肢困倦，目不欲开，怠惰嗜卧，不思饮食，止渴，安胎。\""}]},{"ID":"20240607095035-p36kpap","Type":"NodeParagraph","Properties":{"id":"20240607095035-p36kpap","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑦李杲：\"去诸经中湿而理脾胃。\""}]},{"ID":"20240607095035-iwh9x3m","Type":"NodeParagraph","Properties":{"id":"20240607095035-iwh9x3m","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑧王好古：\"理中益脾，补肝风虚，主舌本强，食则呕，胃脘痛，身体重，心下急痛，心下水痞，冲脉为病，逆气里急，脐腹痛。\""}]},{"ID":"20240607095035-d2zxw0w","Type":"NodeParagraph","Properties":{"id":"20240607095035-d2zxw0w","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑨《本草衍义补遗》：\"有汗则止，无汗则发。能消虚痰。\""}]},{"ID":"20240607095035-cobyitd","Type":"NodeParagraph","Properties":{"id":"20240607095035-cobyitd","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095035-iddopar","Type":"NodeParagraph","Properties":{"id":"20240607095035-iddopar","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；熬膏或入丸、散。"}]},{"ID":"20240607095035-36ut6xb","Type":"NodeParagraph","Properties":{"id":"20240607095035-36ut6xb","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607095035-xr8gx37","Type":"NodeParagraph","Properties":{"id":"20240607095035-xr8gx37","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" ①治虚弱枯瘦，食而不化：于术（酒浸，九蒸九晒）一斤，菟丝子（酒煮吐丝，晒干）一斤，共为末，蜜丸，梧子大。每服二、三钱。（《纲目拾遗》）"}]},{"ID":"20240607095035-vrnamro","Type":"NodeParagraph","Properties":{"id":"20240607095035-vrnamro","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"②治脾虚胀满：白术二两，橘皮四两。为末，洒糊丸，梧子大。每食前木香汤送下三十丸。（《全生指迷方》宽中丸）"}]},{"ID":"20240607095035-ri3e6ih","Type":"NodeParagraph","Properties":{"id":"20240607095035-ri3e6ih","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"③治痞，消食强胃：枳实（麸炒黄色）一两，白术二两。上为极细末，荷叶裹烧饭为丸，如绿豆一倍大。每服五十丸，白汤下，不拘时候，量所伤多少，加减服之。（《兰室秘藏》积术丸）"}]},{"ID":"20240607095035-nr8wecc","Type":"NodeParagraph","Properties":{"id":"20240607095035-nr8wecc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"④服食滋补，止久泄痢：上好白术十两，切片，入瓦锅内，水淹过二寸，文武火煎至一半，倾汁入器内，以渣再煎，如此三次，乃取前后汁同熬成膏，入器中一夜，倾去上面清水，收之。每服二、三匙，蜜汤调下。（《千金良方》白术膏）"}]},{"ID":"20240607095035-de3iqmb","Type":"NodeParagraph","Properties":{"id":"20240607095035-de3iqmb","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑤治脾虚泄泻：白术一两，芍药半两（冬月不用芍药，加肉豆蔻，泄者炒）。上为末，粥丸。（《丹溪心法》白术丸）"}]},{"ID":"20240607095035-ktes9b8","Type":"NodeParagraph","Properties":{"id":"20240607095035-ktes9b8","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑥治小儿久患泄泻，脾虚不进饮食，或食讫仍前泻下，米谷不化：白术一分（米泔浸一时，切，焙干），半夏一钱半（浸洗七次），丁香半钱（炒）。上为细末，生姜自然汁糊丸，黍米大。每半岁儿三丸，三五岁儿五、七丸，淡生姜汤下，早晚各一。（《小儿卫生总微论方》温白丸）"}]},{"ID":"20240607095035-n5gqoxr","Type":"NodeParagraph","Properties":{"id":"20240607095035-n5gqoxr","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑦治湿泻暑泻：白术、车前子等分，炒为末，白汤下二、三钱。（《简便单方》）"}]},{"ID":"20240607095035-ny4d7pw","Type":"NodeParagraph","Properties":{"id":"20240607095035-ny4d7pw","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑧治肠风痔漏、脱肛泻血、面色萎黄，积年久不瘥：白术一斤（糯米泔浸三日，细研锉，炒焦为末），干地黄半斤（净洗，用碗盛于甑上蒸烂细研）。上相和，如硬，滴酒少许，众手丸梧桐子大，焙干。每服十五丸，空心粥饮下，加至二十丸。（《普济方》香术丸）"}]},{"ID":"20240607095035-f7ioi6j","Type":"NodeParagraph","Properties":{"id":"20240607095035-f7ioi6j","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑨治心下坚，大如盘，边如旋盘，水饮所作：枳实七枚，白术二两。上二味，以水五升，煮取三升，分温三服，腹中软即当散也。（《金匮要赂）枳术汤）"}]},{"ID":"20240607095035-povhhhc","Type":"NodeParagraph","Properties":{"id":"20240607095035-povhhhc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑩治伤寒八九日，风湿相搏，身体疼烦，不能自转侧，不呕不渴，脉浮虚而涩，大便坚，小便自利者：白术二两，附子一枚半（炮去皮），甘草一两（炙），生姜一两半（切），大枣六枚。上五味，以水三升，煮取一升去滓，分温三服，一服觉身痹半日许，再服。三服都尽，其人如冒状，勿怪，即是术、附并走皮中，逐水气未得除故耳。（《金匮要略》白术附子汤）"}]},{"ID":"20240607095035-tihuuvm","Type":"NodeParagraph","Properties":{"id":"20240607095035-tihuuvm","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑾治中湿，口噤，不知人：白术半两，酒三盏。煎一盏，顿服；不能饮酒，以水代之。日三，夜一。（《三因方》白术酒）"}]},{"ID":"20240607095035-dwchf7k","Type":"NodeParagraph","Properties":{"id":"20240607095035-dwchf7k","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⑿治忽头眩运，经久不差，四体渐羸，食无味，好食黄土：白术三斤，曲三斤。上二味搀筛酒和，并手捻丸如梧子，暴干。饮服二十枚，日三。忌桃、李、雀肉等。（《外台》）"}]},{"ID":"20240607095035-4qc8ndd","Type":"NodeParagraph","Properties":{"id":"20240607095035-4qc8ndd","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒀治风虚，头重眩，苦极，不知食味。暖肌，补中，益精气：白术二两，附子一枚半（炮去皮），甘草一两（炙）。上三味，锉，每五钱匕，姜五片，枣一枚，水盏半，煎七分，去滓，温服。（《近效方》术附汤）"}]},{"ID":"20240607095035-0hcnajl","Type":"NodeParagraph","Properties":{"id":"20240607095035-0hcnajl","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒁治自汗不止：白术末，饮服方寸匕，日二服。（《千金方》）"}]},{"ID":"20240607095035-4yywcc8","Type":"NodeParagraph","Properties":{"id":"20240607095035-4yywcc8","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒂治盗汗：白术四两，分作四份，一份用黄芪同炒，一份用石斛同炒，一份用牡蛎同炒，一份用麸皮同炒。上各微炒黄色，去余药。只用白术，研细。每服二钱，粟米汤调下，尽四两。（《丹溪心法》）"}]},{"ID":"20240607095035-zo6dnd4","Type":"NodeParagraph","Properties":{"id":"20240607095035-zo6dnd4","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒃治老小虚汗：白术五钱，小麦一撮，水煮干，去麦为末，用黄芪汤下一钱。（《全幼心鉴》）"}]},{"ID":"20240607095035-c2astgh","Type":"NodeParagraph","Properties":{"id":"20240607095035-c2astgh","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒄治产后呕逆不食：白术五钱，姜六钱。水煎，徐徐温服。（《妇人良方》）"}]},{"ID":"20240607095035-ektt9cs","Type":"NodeParagraph","Properties":{"id":"20240607095035-ektt9cs","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒅治妇人血虚肌热，或脾虚蒸热，或内热寒热：白术、白茯苓、白芍药（炒）各一钱，甘草（炒）五分，姜、枣，水煎。（《妇人良方》乞力伽散）"}]},{"ID":"20240607095035-xysbwvl","Type":"NodeParagraph","Properties":{"id":"20240607095035-xysbwvl","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒆治三日疟：九制於术一斤，广皮八两。熬膏，用饴糖四两收。（《古今良方》）"}]},{"ID":"20240607095035-47otvyn","Type":"NodeParagraph","Properties":{"id":"20240607095035-47otvyn","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"⒇治四日两头疟，一、二年至三、四年不愈者，或愈而复发，连绵不巳者：於术一两，老姜一两。水煎，发日五更温服，重者二服。（《纲目拾遗》）"}]},{"ID":"20240607095035-li94rxj","Type":"NodeParagraph","Properties":{"id":"20240607095035-li94rxj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"（21）治牙齿逐日长，渐渐胀，开口难为饮食，盖髓溢所致：只服白术愈。（《夏子益治奇疾方》）"}]},{"ID":"20240607095035-ci0zvaw","Type":"NodeParagraph","Properties":{"id":"20240607095035-ci0zvaw","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"（22）治儿童流涎：生白术捣碎，加水和食糖，放锅上蒸汁，分次口服，每天用三钱。（《江苏中医》（12）：1，1965）"}]},{"ID":"20240607095035-ebr6cx6","Type":"NodeParagraph","Properties":{"id":"20240607095035-ebr6cx6","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095035-nvo59b4","Type":"NodeParagraph","Properties":{"id":"20240607095035-nvo59b4","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607095035-swux3te","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607095035-swux3te","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"《中华本草》：白术"}]},{"ID":"20240607095035-e60lc26","Type":"NodeParagraph","Properties":{"id":"20240607095035-e60lc26","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607095035-5n6jjna","Type":"NodeParagraph","Properties":{"id":"20240607095035-5n6jjna","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" Bái Zhú"}]},{"ID":"20240607095035-lwd1nax","Type":"NodeParagraph","Properties":{"id":"20240607095035-lwd1nax","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607095035-lc8o0nn","Type":"NodeParagraph","Properties":{"id":"20240607095035-lc8o0nn","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 山蓟、杨枹蓟、术、山芥、天蓟、山姜、山连、山精、乞力伽、冬白术"}]},{"ID":"20240607095035-29wcxlj","Type":"NodeParagraph","Properties":{"id":"20240607095035-29wcxlj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607095035-r4nx4rz","Type":"NodeParagraph","Properties":{"id":"20240607095035-r4nx4rz","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" Largehead Atractylodes Rhizome, Rhizome of Largehead Atractylodes"}]},{"ID":"20240607095035-7i7hwcc","Type":"NodeParagraph","Properties":{"id":"20240607095035-7i7hwcc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607095035-c82uz33","Type":"NodeParagraph","Properties":{"id":"20240607095035-c82uz33","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 出自1.陶弘景：术乃有两种：白术叶大有毛而作桠，根甜而少膏，可作丸散用；赤术叶细无桠，根小苦而多膏，可作煎用。东境术大而无气烈，不任用。"}]},{"ID":"20240607095035-nxcvfpf","Type":"NodeParagraph","Properties":{"id":"20240607095035-nxcvfpf","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"2.《清异录》：潜山产善术，以其盘结丑怪，有兽之形，因号为狮子术。"}]},{"ID":"20240607095035-z9mez4b","Type":"NodeParagraph","Properties":{"id":"20240607095035-z9mez4b","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：术，今处处有之，以嵩山、茅山者为佳。春生苗青色无桠。一名山蓟，以其叶似蓟也，茎作蒿干状，青赤色，长三、二尺以来，夏开花紫碧色，亦似刺蓟，花或有黄白花者；入伏后结子；"}]},{"ID":"20240607095035-bl1vc3x","Type":"NodeParagraph","Properties":{"id":"20240607095035-bl1vc3x","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607095035-nxncrlf","Type":"NodeParagraph","Properties":{"id":"20240607095035-nxncrlf","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物白术的根茎。"}]},{"ID":"20240607095035-64w80ly","Type":"NodeParagraph","Properties":{"id":"20240607095035-64w80ly","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Atractylodes macrocephala Koidz. [A-tractylis macrocephala (Doidz.) Hand.-Mand.-Mazz.]"}]},{"ID":"20240607095035-oyezkfv","Type":"NodeParagraph","Properties":{"id":"20240607095035-oyezkfv","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"采收和储藏：10月下旬至11月中旬待地上部分枯萎后，选睛天，挖掘根部，除运河泥土，剪去茎杆，将根茎烘干，烘温开始用100℃，待表皮发热时，温度减至60-70℃，4-6h上、下翻动一扁，半干时搓去须根，再烘至八成干，取出，堆放5-6d，使表皮变软，再烘至全干。赤可晒干，需用15-20d，晒干全干。"}]},{"ID":"20240607095035-zr1wfjb","Type":"NodeParagraph","Properties":{"id":"20240607095035-zr1wfjb","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607095035-q5dox1o","Type":"NodeParagraph","Properties":{"id":"20240607095035-q5dox1o","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 原野生于山区、丘陵地带，野生种产地已绝迹。现各地多有栽培，以浙江栽培的数量最大。"}]},{"ID":"20240607095035-tz61qgj","Type":"NodeParagraph","Properties":{"id":"20240607095035-tz61qgj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607095035-x4c8lwj","Type":"NodeParagraph","Properties":{"id":"20240607095035-x4c8lwj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 白术 多年生草本。根茎肥厚，块状。茎高50-80cm，上部分枝，基部木质化。茎下部叶有长柄，叶片3裂或羽状5深裂，裂片卵状披针形至披针形，长5-8cm，宽1.5-3cm，先端长渐尖，基部渐狭，边缘长或短针刺状缘，毛或贴伏的细刺齿，先端裂片较大；茎上部叶柄渐短，狭披针形，分裂或不分裂，长4-10cm，宽1.5-4cm。头状花序单生于枝顶，长约2.5cm，总苞片5-8层，膜质，覆瓦状排列，外面略有微柔毛，外层短，卵形，先端钝，最内层多列，先端钝，伸长；花多数，全为管状花，花冠紫红色，长约1.5cm，雄蕊5，花柱细长。瘦果长圆状椭圆形，密被黄白色绒毛，稍扁，长约7.5mm；冠毛长约1.3cm，羽状，污白色，基部联合。花期9-10月，果期10-12月。"}]},{"ID":"20240607095035-66bst1j","Type":"NodeParagraph","Properties":{"id":"20240607095035-66bst1j","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607095035-xkv2oy4","Type":"NodeParagraph","Properties":{"id":"20240607095035-xkv2oy4","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉气候，耐寒，怕湿热、怕干旱。能耐-10℃左右低温，气温超过30℃以上生长受到抑制，24-29℃生长迅速。根茎生长最适温度26-28℃。种子发芽最适温度25-30℃。以选地势高燥稍有倾斜的坡地，土层深厚，疏松肥沃，排水良好的砂质壤土栽培为宜，忌连作，最好在新垦地上栽种。种过的地，须隔5年以上才能再作，否则易发病。前作以禾本科作物为好，不能与易发生白绢病的十字花科、匣科等作物轮作。"}]},{"ID":"20240607095035-f25tvwc","Type":"NodeParagraph","Properties":{"id":"20240607095035-f25tvwc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖、育苗移栽法。选优良的品种，叶大、矮杆、分株少的植株，每株留5-6个成熟一致的花蕾，除去早开和迟开的花蕾。11月上、中旬待植株下部枯萎，部分头状花序上部开裂出现白色冠毛时，选择睛天，露水干后，采摘果育，摊晾几日，果序全部开裂出现白色冠毛时，晒干、脱粒、扬将备用。育苗于3月下旬至4上旬适宜，过早易遇晚霜为害；过迟幼苗生长不良。播种前选用种子饱满、色泽新鲜、子叶完整、无病虫害的作种。播前楞用50%甲基托布津1 000倍液浸种3-5min，取出晾干后播种；赤可用25-30℃温水浸泡24h，捞出种子，用湿布或麻袋装好，置25-30℃室内，早易各淋水1次，经4-5d，种子萌动露白后播种。条播按行距20cm开条沟，沟深5cm，将种子均匀播入，覆土2cm，上盖稻草一层，浇水保湿。每1hm2用种量75-105kg。约经15d左右出苗。出苗后要进行间苗，拔除杂草，遇时时则早、晚浇水。发现抽苔应及早摘除。移栽：10月上、中旬至11月上旬挖起根茎，除去茎叶、须根，先置室内通风处摊放3-5d，待外皮发白，置干燥处贮藏。先在平地铺3cm厚河沙，上放根茎一层5cm，再铺河沙一层，再放根茎，高度不超过40cm，在堆放中播一把稻草，最上面盖6-7cm，河沙。移栽于12月下旬至翌年1月上旬，栽种时选取芽头饱满，先端细长，尾圆大而且密生柔软细根和主根细短的作种。按大、开穴、穴深6cm，芽头向上，覆土压紧。"}]},{"ID":"20240607095035-sz233ci","Type":"NodeParagraph","Properties":{"id":"20240607095035-sz233ci","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"田间管理 出苗后要进行间苗，并结合中耕除草。施足基肥，早施苗肥，重施摘蕾肥，增施磷，钾肥。苗蒿15cm追施人粪尿或复合肥，摘蕾后5-7d施腐熟饼肥、人畜粪肥，再可喷0.1%磷酸二氢钾或2%过磷酸钙浸出液。除去萌蘖，仅留一个主茎。7月上、中旬要分批摘蕾，切忌损伤大叶，不能动摇植株。遇时时要灌溉，遇涝要开沟排水，降低田间湿度。"}]},{"ID":"20240607095035-2napogy","Type":"NodeParagraph","Properties":{"id":"20240607095035-2napogy","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"病早害防治 病害有白绢病，用50%退菌特1 000倍液浸种后栽种，并在植株四周撒石灰消毒。或用50%甲基托布津1 000倍液浇灌病区。立枯病可用505多菌灵1 000倍液浇灌。铁叶病6-8月发病，喷1：1：100波尔多液或50%甲基托布津或多菌灵1 000倍液。锈病可喷25%粉锈宁1 000倍液。根腐病用50%多菌灵500倍液和50%甲基托布津100倍液或50%退菌特800倍液喷射。另有菌核端正、根结线早病、花叶病、菟丝子等为害、早害有白术术籽早、白术长管蚜以及红蜘蛛、金龟子、地老虎等为害。"}]},{"ID":"20240607095035-1beycm2","Type":"NodeParagraph","Properties":{"id":"20240607095035-1beycm2","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607095035-k344t3o","Type":"NodeParagraph","Properties":{"id":"20240607095035-k344t3o","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎规则的肥厚团块，长3-13cm，直径1.5-7cm。表面灰黄构或灰棕色，有瘤状突起及断续的纵皱和沟纹，并有须根痕，顶端有殖留茎基和芽痕。质坚硬，不易折断；断面不平坦，黄白色至淡棕色，有棕黄色的点状油室散在，烘干者断面角质样，色较深或有裂隙。气清香，味甘、微辛，嚼之略带粘性。"}]},{"ID":"20240607095035-gloxas8","Type":"NodeParagraph","Properties":{"id":"20240607095035-gloxas8","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"以个大、质坚实、断面黄白色、香气浓者为佳。"}]},{"ID":"20240607095035-18miyof","Type":"NodeParagraph","Properties":{"id":"20240607095035-18miyof","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根茎横切面：木栓层为1-5列木栓细胞，其间夹有1-2列断续的石细胞带。皮层、韧皮部及射线中散有油室，长径180-370μm，短径135-200μm。表成层环明显。木质部外侧的导管1-3列径向排列，基旁无木纤维束，内侧的导管周围有较发达的木纤维束。薄壁细胞中含草酸钙会晶和菊糖。"}]},{"ID":"20240607095035-hc91evk","Type":"NodeParagraph","Properties":{"id":"20240607095035-hc91evk","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607095035-5fpqb2c","Type":"NodeParagraph","Properties":{"id":"20240607095035-5fpqb2c","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 1.小鼠腹腔注射煎剂半数致死量为13.3士0.7g／kg。麻醉狗静脉注射煎剂0.25g／kg，多数血压急剧下降，平均降低至原水平的52.8%，3-4小时内未见恢复。"}]},{"ID":"20240607095035-k10cqn3","Type":"NodeParagraph","Properties":{"id":"20240607095035-k10cqn3","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"2.大鼠每日灌服煎剂0.5g／kg，共1-2月，未见任何明显的毒性反应。但在用药14天后，有中等度白细胞减少，主要是淋巴细胞减少；服药2月，有轻度贫血，脑、心肌及肝组织无任何变化。某些动物个别肾小管上皮细胞有轻度颗粒变性，肾小球则无任何改变。"}]},{"ID":"20240607095035-y7fuzob","Type":"NodeParagraph","Properties":{"id":"20240607095035-y7fuzob","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607095035-r5g7mb7","Type":"NodeParagraph","Properties":{"id":"20240607095035-r5g7mb7","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 根茎含挥发油，内有α-及β-葎草烯（humu-lene），β-榄香醇（β-elemol），α姜黄烯（α-curcumene），苍术酮（α-tractlone），3β-乙酰氧基苍术酮（3β-acetoxyatractylone），芹子二烯酮[selina-4(14),7(11)-diene-8-one]，桉叶醇（eudesmol），棕榈酸（palmitic acid）[1]，茅术醇（hinesol），β-芹子烯（β-selinene）[2]等。还含倍半萜内酯化合物：苍术内酯（atractylenolide）-Ⅰ、-Ⅱ、-Ⅲ及8β-乙氧基苍术内酯-Ⅱ（8β-ethoxyatractylenolide-Ⅱ）[3]。又含多炔类化合物：14-乙酰基-12-千里光酰基-8-顺式折术三醇（14-acetyl-12-senecioyl-2E,8Z,10E-atracetylentriol），14-乙酰基各里光酰基-8-反式白术三醇（14-acetyl-12-senecioyl-2E,8E,10E-atractylentriol），12-千里光光酰基-8-顺式白术三醇（12-senecioyl-2E,8Z,10E-atracetylentriol），12-千里光酰基-8-反式白术三醇（12-senecioyl-2E,8E,10E-atractylentriol）[3]，12α-甲基丁酰基-14-乙酰基-8-顺式白术三醇（12α-methyl butyryl-14-acetyl-2E,8Z,10E-atractylentriol），12α-甲基丁酰基-14-乙酰基-8-反式白术三醇（12α-methylbutyryl-14-acetyl-2E,8E,10E-atractylentriol），14α-甲基丁酰基-8-顺式白术三醇（14α-methyl butyryl-2E,8Z,10E-atractylentriol），14α-甲基丁酰基-8-反式白术三醇（14α-methyl butyryl-2E,8E,10E-atractylentriol）[4]。另含东莨菪素（scopoletin)[3]，果糖（fructose），菊糖（inulin）[5]，具免疫活性的甘露聚糖AM-3[6]，以及天冬氨酸（aspartic acid），丝氨酸（serine），谷氨酸（glutamic acid），丙氨酸（alanine），甘氨酸（glycine），缬氨酸（valine），异亮氨酸（isoleucine），亮氨酸（leucine），酪氨酸（tyro-sine），苯丙氨酸（phenylalanine），赖氨酸（lysine），组氨酸（histi-sine），精氨酸（arginine），脯氨酸（proline）等氨基酸[5]。"}]},{"ID":"20240607095035-v1cbezw","Type":"NodeParagraph","Properties":{"id":"20240607095035-v1cbezw","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607095035-fuywnel","Type":"NodeParagraph","Properties":{"id":"20240607095035-fuywnel","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 1.利尿作用：具有明显而持久的利尿作用，对各种动物如大鼠、兔、狗都有作用。对不麻醉狗静脉注射煎剂0.05-0.25g／kg，尿量增加可达9倍以上，并在用药5小时后仍高于正常；灌胃给药1-3g／kg，尿量较用药前可增加2-6倍，而且多数于用药6-7小时后仍多于正常，白术煎剂和流浸膏1.0g／kg给大鼠静脉注射，兔1.0g／kg灌胃或腹腔注射，均能产生明显而持久的利尿作用。白术不仅增加水的排泄，也促进电解质特别是钠的排出，并且钠的排泄还胜于水的排泄。它也不影响垂体后叶激素的抗利尿作用，因此白术增加水的排泄可能主要不是影响水的主动性重吸收，而是续发于电解质重吸收的减少，既有汞撒利样排泄氯、钠的作用；又有增高尿中二氧化碳容量、pH值以及增加钾排泄，减少铵排泄的醋唑磺胺样的特点。对人的利尿作用有少数试验，不能最后肯定。"}]},{"ID":"20240607095035-06et9jx","Type":"NodeParagraph","Properties":{"id":"20240607095035-06et9jx","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"2.降血糖作用：家兔灌胃煎剂或浸膏，血糖稍有降低。大鼠灌胃煎剂有加速体内葡萄糖的同化因而降低血糖。小鼠内服煎剂有保护肝脏，防止四氯化碳引起的肝糖元减少作用。"}]},{"ID":"20240607095035-zmc81m5","Type":"NodeParagraph","Properties":{"id":"20240607095035-zmc81m5","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"3.强壮作用：白术煎剂灌胃lmol或6g/kg，能促进小鼠体重增加和增强游泳耐力，白术能增强网状内皮系统的吞噬功能，对小鼠网状内皮系统呈活化作用,促进小鼠腹腔巨噬细胞的吞噬功能，使巨噬细胞的吞噬百分率，吞噬指数及其溶酶体消化平均较对照组显着增加。在白细胞减少症时，白术有升白作用。白术还能提高淋巴细胞转化率和自然玫瑰花形成率，促进细胞免疫功能，且明显增高IgG。说明白术有健脾胃、壮身体和提高抗病能力的作用。"}]},{"ID":"20240607095035-snqobce","Type":"NodeParagraph","Properties":{"id":"20240607095035-snqobce","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"4.抗凝血作用：白术对血小板聚集有明显的抑制作用，白术煎剂0.5g／kg灌胃l-4周,能显着延长大鼠凝血酶元的时间。其作用较双香豆素弱，但较Butadion为强。根的作用比茎强。健康人服用5%根煎剂，每次1汤匙，每天3次，4天后凝血酶元时间及凝血时间均显着延长，停药后10天上述指标恢复到给药前的水平，酒精浸出液也有效果，但维持时间较短。"}]},{"ID":"20240607095035-motid54","Type":"NodeParagraph","Properties":{"id":"20240607095035-motid54","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"5.对心血管系统的作用：白术有血管扩张作用。对心脏呈抑制作用，剂量过大时可致停博，麻醉犬静脉注射煎剂0.1g／kg，血压轻度下降0.25g／kg时，血压急剧下降，3-4小时内未见恢复。"}]},{"ID":"20240607095035-cqgsfer","Type":"NodeParagraph","Properties":{"id":"20240607095035-cqgsfer","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"6.抗肿瘤作用：体外试验表明，白术挥发油中之中性油对食管癌细胞有明显抑制作用。10mcg／ml时，于24小时内可使癌细胞全部脱落。5mcg／ml时，可使大部分癌细胞脱落，残存的小片细胞或散在细胞呈核固缩，核仁模糊不清，泡质多空泡。白术挥发油50-100mg／kg腹腔注射对艾氏腹水癌有显着抑制作用。全身给药时，对实质性实体癌的疗效则报道不一致。对358种植物药、中药单方和复方进行筛选时，白术挥发油对小鼠肉瘤-180的抑制作用最强（抑制率为31-49%）另有报道对S-180，S-37，U-14和W-256，以及白血病模型（L615均无明显作用。近报道，白术对methA肿瘤的中如活性比对照组明显增加，并显着增强MethA肿瘤的迟发性超敏反应，还促进植物血细胞凝集素-P和脂多糖诱导的幼若化反应。"}]},{"ID":"20240607095035-hztcwqj","Type":"NodeParagraph","Properties":{"id":"20240607095035-hztcwqj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"7.对胃肠平滑肌的作用：过去报道，白术对胃肠道功能（如胃酸的胃液分泌，推进性肠蠕动等）无影响，亦无抗溃疡、抗炎和镇痛作用，不影响正常体温，对中枢神经系统无明显抑制作用，后者被认为可以作为与苍术相区别的依据。近报道，白术对家兔离体小肠自发活动的影响多不相同，白术能增强兔离体小肠自发性收缩活动，使其收缩幅度加大，白术油抑制肠管的自发运动，或白术对家兔离体小肠的自发运动影响不明显。白术对乙酰胆碱、二氯化钡所致的家兔离体小肠强直性收缩有明显的拮抗作用，对加入肾上腺素所致的离体家兔小肠活动的抑制，白术可以拮抗此作用。但亦有报道没有明显的拮抗作用。白术煎剂每天10g（生药／kg连续给小鼠灌胃能明显促进小肠蛋白质的合成。白术提取物50mg和200mg／kg灌胃给药，对动物水浸束缚应激性溃疡，有显着抑制效果。"}]},{"ID":"20240607095035-sjzkssf","Type":"NodeParagraph","Properties":{"id":"20240607095035-sjzkssf","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"8.抗菌作用：水浸液在试管内对絮状表皮癣菌、星形奴卡氏菌有抑制作用。煎剂对脑膜炎球菌亦有抑制作用。近报道白术煎剂和四君子汤对伤寒杆菌、甲型副伤寒杆菌、福氏痢疾杆菌、大肠杆菌、绿脓杆菌等均有不同程度的抑菌作用，而无杀菌作用。"}]},{"ID":"20240607095035-v81sr0s","Type":"NodeParagraph","Properties":{"id":"20240607095035-v81sr0s","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"9.促进造血功能：白术煎剂1g/kg,0.2ml/只皮下注射能促进小鼠骨髓红系造血祖细胞（CFU-E）的生长。对于用化学疗法或放射疗法引起的白血球下降，有使其升高的作用。"}]},{"ID":"20240607095035-y1rrf7q","Type":"NodeParagraph","Properties":{"id":"20240607095035-y1rrf7q","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"10.促进蛋白质合成：白术煎剂10g/kg灌胃，连续7天，明显促进小鼠小肠蛋白质的合成。"}]},{"ID":"20240607095035-fv3a2do","Type":"NodeParagraph","Properties":{"id":"20240607095035-fv3a2do","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"11.其它作用：白术对呼吸有短暂的兴奋作用，另外白术对家兔、肠鼠、大鼠和小鼠的子宫平滑肌有明显抑制作用，白术煎剂对小鼠因四氧化碳引起的肝损伤有保护作用。白术乙酸乙酯提取物，大白鼠十二指肠给药，可明显增加胆汁分泌。少量挥发油有镇静作用。"}]},{"ID":"20240607095035-vtldqa5","Type":"NodeParagraph","Properties":{"id":"20240607095035-vtldqa5","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607095035-0r0w8rk","Type":"NodeParagraph","Properties":{"id":"20240607095035-0r0w8rk","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 1.生白术：拣净杂质，用水浸泡，浸泡时间应根据季节、气候变化及白术大小适当掌握，泡后捞出，润透，切片，晒干。"}]},{"ID":"20240607095035-xnvky7g","Type":"NodeParagraph","Properties":{"id":"20240607095035-xnvky7g","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"2.炒白术：先将麸皮撒于热锅内，候烟冒出时，将白术片倒入微炒至淡黄色，取出，筛去麸皮后放凉。（每白术片100斤，用麸皮10斤）3.焦白术：将白术片置锅内用武火炒至焦黄色，喷淋清水，取出晾干。"}]},{"ID":"20240607095035-xq9amdl","Type":"NodeParagraph","Properties":{"id":"20240607095035-xq9amdl","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"4.土炒白术：取伏龙肝细粉，置锅内炒热，加入白术片，炒至外面挂有土色时取出，筛去泥土，放凉。（每白术片100斤，用伏龙肝粉20斤）5.《本草蒙筌》：白术咀后，人乳汁润之，制其性也，润过陈壁土和炒。"}]},{"ID":"20240607095035-4ub9urm","Type":"NodeParagraph","Properties":{"id":"20240607095035-4ub9urm","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"6.《本草备要》：白术，用糯米泔浸，陈壁土炒，或蜜水炒，人乳拌炒。"}]},{"ID":"20240607095035-ehljcuf","Type":"NodeParagraph","Properties":{"id":"20240607095035-ehljcuf","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607095035-mpuhy9g","Type":"NodeParagraph","Properties":{"id":"20240607095035-mpuhy9g","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 量化鉴别 （1）取本品粉末1g，加乙醚5ml，振摇浸出15min，滤过。取滤液2ml，置蒸发皿中，待乙醚挥散后，加含5%对二甲氨基苯甲醛的10%硫酸溶液1ml，则显玫瑰红色；再于100℃烘5min即变成紫色。（检查苍术酮）（2）薄层色谱 按“苍术”顶下的方法进行薄层色谱，喷显色剂后苍术酮即显红色，烘后变紫色。"}]},{"ID":"20240607095035-nn0gufy","Type":"NodeParagraph","Properties":{"id":"20240607095035-nn0gufy","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"品质标志 （1）本品总灰分子得过5.0%。"}]},{"ID":"20240607095035-k3csr3x","Type":"NodeParagraph","Properties":{"id":"20240607095035-k3csr3x","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"（2）色度 取本品最粗粉，精密称取2g，置100ml玻璃烧瓶中，加55%乙醇50ml，用稀盐酸调节pH至2-3，连续振摇1h，用每分钟4 000转的离心机，离心15min，吸取上清液10ml，置比色管中，与此同时量的对照液（取比以用三氯化铁液5ml，加比色用氯化钴液3ml与比色用硫酸铜液0.6ml，用水稀释至10ml制成），同置白纸上，自上面透视，显色不得较深。"}]},{"ID":"20240607095035-mw9r8gu","Type":"NodeParagraph","Properties":{"id":"20240607095035-mw9r8gu","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607095035-j0gbfl2","Type":"NodeParagraph","Properties":{"id":"20240607095035-j0gbfl2","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 归脾；胃经"}]},{"ID":"20240607095035-0pybwwc","Type":"NodeParagraph","Properties":{"id":"20240607095035-0pybwwc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607095035-uvso05l","Type":"NodeParagraph","Properties":{"id":"20240607095035-uvso05l","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 味苦；甘；性温"}]},{"ID":"20240607095035-dmy2lkc","Type":"NodeParagraph","Properties":{"id":"20240607095035-dmy2lkc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607095035-m7y8b1i","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607095035-m7y8b1i","updated":"20240607095035"},"Children":[{"ID":"20240607095035-212wlnt","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240607095035-212wlnt","updated":"20240607095035"},"Children":[{"ID":"20240607095035-88sedbi","Type":"NodeParagraph","Properties":{"id":"20240607095035-88sedbi","updated":"20240607095035"}}]}]},{"ID":"20240607095035-xrusy4f","Type":"NodeParagraph","Properties":{"id":"20240607095035-xrusy4f","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"2.忌桃、李、菘菜、雀肉、青鱼。"}]},{"ID":"20240607095035-wdh3l5f","Type":"NodeParagraph","Properties":{"id":"20240607095035-wdh3l5f","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"3.《药品化义》：凡郁结气滞，胀闷积聚，吼喘壅塞，胃痛由火，痈疽多脓，黑瘦人气实作胀，皆宜忌用。"}]},{"ID":"20240607095035-mmmt6kv","Type":"NodeParagraph","Properties":{"id":"20240607095035-mmmt6kv","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607095035-ghhrp7k","Type":"NodeParagraph","Properties":{"id":"20240607095035-ghhrp7k","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 健脾益气；燥湿利水；止汗；安胎。主脾气虚弱；神疲乏力；食少少腹胀；大便溏薄；水饮内停；小便不利；水肿；痰饮眩晕；温痹酸痛；气虚自汗；胎动不安"}]},{"ID":"20240607095035-djg28ld","Type":"NodeParagraph","Properties":{"id":"20240607095035-djg28ld","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607095035-q5l5y66","Type":"NodeParagraph","Properties":{"id":"20240607095035-q5l5y66","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-15g；或熬膏；或入丸、散。"}]},{"ID":"20240607095035-guqlhsj","Type":"NodeParagraph","Properties":{"id":"20240607095035-guqlhsj","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607095035-q1ptf6k","Type":"NodeParagraph","Properties":{"id":"20240607095035-q1ptf6k","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 四君子汤《太平圣惠民和剂局方》；白术附子汤《金匮要略》；参苓白术散《太平圣惠民和剂局方》；枳术汤《金匮要略》；痛泻要方《景岳全书》；苓桂术甘汤〈伤寒论〉"}]},{"ID":"20240607095035-qe4s9w8","Type":"NodeParagraph","Properties":{"id":"20240607095035-qe4s9w8","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607095035-qiegngr","Type":"NodeParagraph","Properties":{"id":"20240607095035-qiegngr","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 1.《汤液本草》：《本草》在术条下无苍、白之名。近多用白术治皮间风，止汗消痞，补胃和中，利腰脐间血，通水道，上而皮毛，中而心胃，下而腰脐，在气主气，在血主血。"}]},{"ID":"20240607095035-sqsaltp","Type":"NodeParagraph","Properties":{"id":"20240607095035-sqsaltp","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"2.《本草会编》：脾恶湿，湿胜则气不得施化，津何由生？故曰：膀胱者，津液之府，气化则能出焉。用白术以除其湿，则气得周流而津液生矣。"}]},{"ID":"20240607095035-fz53c71","Type":"NodeParagraph","Properties":{"id":"20240607095035-fz53c71","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：术，其气芳烈，其味甘浓，其性纯阳，为除风痹之上药，安脾胃之神品。《本经》主风寒湿痹、死肌、痉、疸者，正以风寒湿三者合而成痹，痹者，拘挛而痛者是也。《经》曰，地之湿气，感则害人皮肉筋骨。死肌者，湿毒侵肌肉也。痉者，风寒乘虚客于肝、脾、肾所致也。疸者，脾胃虚而湿热瘀滞也。如上诸病，莫不由风寒湿而成，术有除此三邪之功，故能祛其所致之疾也。止汗、除热、消食者，湿热盛则自汗，湿邪客则发热，湿去而脾胃燥，燥则食自消，汗自止，热自除也。又主大风在身面者，术气芳烈而悍，纯阳之物也，风为阳邪，发于阳部，故主之也。风眩头痛目泪出者，阳虚则风客之而眩，痰厥则头痛，风热壅则目泪出也。消痰水，逐皮间风水、结肿，除心下急痛，及霍乱吐下不止者，湿客于胃则滞而生痰，客于脾则生水，脾虚湿胜，则为水肿，湿客中焦则心下急满，脾胃俱虚，则中焦不治，而湿邪客之，则为霍乱吐下不止也。利腰脐间血者，血属阴，湿为阴邪，下流客之，使腰脐血滞而不得通利，湿去则诸证无不愈矣。益津液，暖胃消谷嗜食者，湿去则胃强，而津液自生，寒湿散则胃自暖，邪去而脾胃健，则消谷而嗜食矣。术，《本经》无分别，陶弘景有赤、白二种，近世乃有苍、白之分，其用较殊，要之俱为阳草，故祛邪之功胜，而益阴之效亏，药性偏长，物无兼力，此天地生物自然之道也。凡病属阴虚，血少，精不足，内热骨蒸，日干唇燥，咳嗽吐痰，吐血，鼻衄、齿衄，咽塞便秘滞下者，法咸忌之。术燥肾而闭气，肝肾有动气者勿服。《刘涓子痈疽论》云：溃疡忌白术，以其燥肾而闭气，故反生脓作痛也。凡脏皆属阴，世人但知术能健脾，此盖指脾为正邪所干，术能燥湿，湿去则脾健，故曰补也。宁知脾虚而无湿邪者，用之反致燥竭脾家津液，是损脾阴也。何补之足云？此最易误，故特表而出之。"}]},{"ID":"20240607095035-g9zjxz4","Type":"NodeParagraph","Properties":{"id":"20240607095035-g9zjxz4","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"4.《本草汇言》：白术，乃扶植脾胃，散湿除痹，消食除痞之要药也。脾虚不健，术能补之，胃虚不纳，术能助之。是故劳力内伤，四肢困倦，饮食不纳，此中气不足之证也；痼冷虚寒，泄泻下利，滑脱不禁，此脾阳乘陷之证也；或久疟经年不愈，或久痢累月不除，此胃虚失治，脾虚下脱之证也；或痰涎呕吐，眩晕昏眩，或腹满肢肿，面色痿黄，此胃虚不运，脾虚蕴湿之证也；以上诸疾，用白术总能治之。又如血虚而漏下不止，白术可以统血而收阴；阳虚而汗液不收，白术可以回阳而敛汗。大抵此剂能健脾和胃，运气利血。兼参、耆而补肺，兼杞、地而补肾，兼归、芍而补肝，兼龙眼、枣仁而补心，兼芩、连而泻胃火，兼橘、半而醒脾土，兼苍、朴可以燥湿和脾，兼天、麦亦能养肺生金，兼杜仲、木瓜，治老人之脚弱，兼麦芽、枳、朴，治童幼之疳症。黄芩共之，能安胎调气。枳实共之，能消痞除膨。君参、苓、藿、半，定胃寒之虚呕。君归、芎、芍、地，养血弱而调经。温中之剂无白术，愈而复发。溃疡之证用白术，可以托脓。"}]},{"ID":"20240607095035-2eyy0h7","Type":"NodeParagraph","Properties":{"id":"20240607095035-2eyy0h7","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"5.《本草通玄》：白术，补脾胃之药，更无出其右者。土旺则能健运，故不能食者，食停滞者，有痞积者，皆用之也。土旺则能胜湿，故患痰饮者，肿满者，湿痹者，皆赖之也。土旺则清气善升，而精微上奉，浊气善降，而糟粕下输，故吐泻者，不可阙也。《别录》以为利腰脐间血者，因脾胃统摄一身之血，而腰脐乃其分野，借其养正之功，而瘀血不敢稽留矣。张元素谓其生津止渴者，湿去而气得周流，而津液生矣。谓其消痰者，脾无湿则痰自不生也。安胎者，除胃中热也。"}]},{"ID":"20240607095035-jdjqzdu","Type":"NodeParagraph","Properties":{"id":"20240607095035-jdjqzdu","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"6.《本草崇原》：凡欲补脾，则用白术，凡欲运脾，则用苍术，欲补运相兼，则相兼而用，如补多运少，则白术多而苍术少，运多补少，则苍术多而白术少，品虽有二，实则一也。《本经》未分苍、白，而仲祖《伤寒》方中，皆用白术，《金匮》方中，又用赤术，至陶弘景《别录》则分为二，须知赤、白之分，始于仲祖，非弘景始分之也。赤术，即是苍术，其功用与白术略同，故仍以《本经》术之主治为本。但白术味甘，苍术兼苦，白术止汗，苍术发汗，故止汗二字，节去不录。后人谓苍术之味苦，其实苍术之味甘而微苦。"}]},{"ID":"20240607095035-106b5dc","Type":"NodeParagraph","Properties":{"id":"20240607095035-106b5dc","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"7.《本经逢原》：白术，生用有除湿益燥，消痰利水，治风寒湿痹，死肌痉疸，散腰脐间血，及冲脉为病，逆气里急之功；制熟则有和中补气，止渴生津，止汗除热，进饮食，安胎之效。"}]},{"ID":"20240607095035-v16xmn3","Type":"NodeParagraph","Properties":{"id":"20240607095035-v16xmn3","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"8.《长沙药解》：白术，性颇壅滞，宜辅之以疏利之品，肺、胃不开，加生姜、半夏以驱浊，肝、脾不达，加砂仁、桂枝以宣郁，令其旋补而旋行，则美善而无弊矣。"}]},{"ID":"20240607095035-qqbkcui","Type":"NodeParagraph","Properties":{"id":"20240607095035-qqbkcui","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"9.《本草求真》：白术缘何专补脾气？盖以脾苦湿，急食苦以燥之，脾欲缓，急食甘以缓之；白术味苦而甘，既能燥湿实脾，复能缓脾生津。且其性最温，服则能以健食消谷，为脾脏补气第一要药也。书言无汗能发，有汗能收，通溺止泄，消痰治肿，止热化癖，安胎止呕，功效甚多，总因脾湿则汗不止，脾健则汗易发，凡水湿诸邪，靡不因其脾健而自除，吐泻及胎不安，亦靡不因其脾健而悉平矣。故同枳实则能治痞，同黄芩则能安胎，同泽泻则能利水，同干姜、桂心则能消饮去癖，同地黄为丸，则能以治血泻萎黄，同半夏、丁香、姜汁，则可以治小儿久泻，同牡蛎、石斛、麦麸，则可以治脾虚、盗汗。然血燥无湿，肾间动气筑筑，燥渴便闭者忌服。谓其燥肾闭气，则其气益筑。又寒湿过甚，水满中宫者亦忌，谓其水气未决，苦不胜水，甘徒滋壅，必待肾阳培补，水气渐消，肾气安位，术始可投，此又不得不变换于中也。盖补脾之药不一，白术专补脾阳，生则较熟性更鲜，补不腻滞，能治风寒湿痹，及散腰脐间血，并冲脉为病，逆气里急之功，非若山药止补脾脏之阴，甘草止缓脾中之气，而不散于上下，俾血可生，燥症全无。苍术气味过烈，散多于补，人参一味冲和，燥气悉化，补脾而更补肺，所当分别而异视者也。"}]},{"ID":"20240607095035-8a9w9hz","Type":"NodeParagraph","Properties":{"id":"20240607095035-8a9w9hz","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"10.《本经疏证》：风寒湿痹、死肌、痉、疸，不得尽谓脾病，而以术为主剂者，则以湿为脾所主，湿能为患，固属脾气不治，一也；脾主肌肉，介在皮毛筋骨中，痹与痉，病在肌肉内，死肌及疸，病在肌肉外，旁病则当取中，二也；筋骨皮毛，均非驻湿之所，惟肌肉间为可驻湿，三也。知此，则凡痹、死肌、痉、疸之系乎风寒湿者，皆术主之矣。白术之效，于风胜湿者为最宜，寒胜者为差减。何以知之？盖风胜必烦，湿胜必重，检《金匮要略》中治痹诸方，其用术者，非兼烦必兼重，虽然，谓术功擅于风与湿则可，谓于寒有所忌则不可，《伤寒》少阴篇附子汤，治身体疼，手足寒，骨节痛，不烦不重，亦用白术。盖湿流关节，云骨节痛，则未有不兼湿者，矧风湿二者，必挟寒始成痹，不然则否，《素问》之旨可验也。白术治眩，非治眩也，治痰饮与水耳。有痰与水，何以能使人眩？盖眩者神之动，神依于心，心恶水，水盛则心神摇曳为眩，譬如人在舟中，能发眩也，虽然人在舟中，未必尽眩，不在舟中，未必不眩。所以眩证不必尽用术，用术之饮证水证，亦未必尽眩，夫亦各因乎其人耳。《伤寒论》、《金匮要略》其有饮有水，不眩而用术者，则指不胜屈，其有饮眩而不用术者亦多，则系证与术有忌耳，即如卒呕吐，心下痞，膈间有水，眩悸者，小半夏加茯苓汤主之，则以心下痞，故正与理中丸下注云腹满者去术，同一理也。世之人动辄称白术、黄芩安胎圣药，而疏其义者，不过谓白术健脾，黄芩泄热，殊不知健脾泄热之物，岂特白术、黄芩。夫妇人之病，多半涉血，矧妊娠尤赖血气之调，方得母子均安。初妊之时，胎元未旺，吸血不多，则下焦血旺，致气反上逆，是为恶阻。恶阻则中焦之气不变赤而为水，是白术所必需矣。血盛能致气盛，气盛能生火，黄芩泄气分之火而不伤血者也；厥后胎气日充，吸血渐多，血自盘旋而下，气亦随之盘旋于下，胎之所吸，乃血之精者。而其馀与气相搏，能仍化为水，阻于腰脐之间，故妊娠至五、六月时，多有子肿之证，是白术又为必需之剂，而无所事黄芩于其间，《别录》所谓利腰脐间血者此也。考仲景书于妇人妊娠篇之白术散，与芎藭同用，当归芍药散、当归散，与芍药、当归、芎藭同用者，不可知其为除水气而利腰脐间血哉。总之，血分之源不清，则血气不能和，而附血之湿，血盛之火，皆为胎前所有之常患，故出此不必甚为别择之常方，学者尤当会意而用之也。"}]},{"ID":"20240607095035-hytz4a9","Type":"NodeParagraph","Properties":{"id":"20240607095035-hytz4a9","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"11.《医学衷中参西录》：白术，性温而燥，气不香窜，味苦微甘微辛，善健脾胃，消痰水，止泄泻，治脾虚作胀，脾湿作渴，脾弱四肢运动无力，甚或作疼。与凉润药同用，又善补肺；与升散药同用，又善调肝；与镇安药同用，又善养心；与滋阴药同用，又善补肾。为其具土德之全，为后天资生之要药，故能于金、木、水、火四脏，皆能有所补益也。"}]},{"ID":"20240607095035-ciemqvk","Type":"NodeParagraph","Properties":{"id":"20240607095035-ciemqvk","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"12.《本草正义》：《本草经》及《别录》皆称术而无苍、白之分，陶氏弘景及宋之苏颂，皆言术以茅山为胜，似今之所谓茅山苍术，亦即古之所谓术也。然弘景又别有赤术之名，谓其苦而多膏，又似梁时已有苍术一种。今按《本经》主治，详其功用，颇似今之茅术。惟白术健脾化湿，其力亦同。至《名医别录》又言味苦甘，增一甘字，则明是白术。李濒湖以《本经》、《别录》之文，两系白术、苍术二条，而张隐庵因之，真骈拇矣。术之功用，自唐以前，止言其燥湿逐水，所谓暖胃消食，亦燥能健脾醒胃也。盖其气甚烈，故能振动脾阳，而又疏通经络，然又最富脂膏，故虽苦温能燥，而亦滋津液，且以气胜者，流行迅利，本能致津液通气也。唐、宋以后，皆以为补益脾胃，其旨即从此出。颐谓白术、苍术在古不分，而今已各别，则凡古人所称燥湿逐水之用，今必以茅山苍术当之，其补益脾胃，则宜用白术。盖今之所谓冬白术者，质润而气香，健运脾阳，滋养胃阴之力不小，且其气既盛，不致呆守满中，允为健脾益胃之专剂矣。东垣谓白术主安胎，盖谓妊娠养胎，依赖脾土，术能健脾故耳。丹溪谓白术无汗能发，有汗能止。颐按白术补中，虽以气胜，不可谓其发汗。惟苍术则辛烈开腠，能发湿家之汗耳。缪仲醇引《刘涓子痈疽论》谓溃疡忌白术，以其燥肾闭气，故能生脓作痛，张石顽亦采其说，不知术能补益，溃疡毒盛，诚非所宜，若溃后元虚，非补脾胃，何以收效？参、地、术、芪，皆是补虚要药，岂可不论虚实，而一概抹煞之耶？缪氏又谓术以气胜，除邪之功巨，补阴之效亏，凡阴虚血少燥渴及精不足，便闭滞下者忌之。缪氏之意，盖谓其气味燥烈，故有耗阴燥精等弊。愚谓术本多脂，万无伤阴之虑。"}]},{"ID":"20240607095035-u93u3v6","Type":"NodeParagraph","Properties":{"id":"20240607095035-u93u3v6","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607095035-s1cw9iy","Type":"NodeParagraph","Properties":{"id":"20240607095035-s1cw9iy","updated":"20240607095035"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607095037-952szkr","Type":"NodeThematicBreak","Properties":{"id":"20240607095037-952szkr"}},{"ID":"20240616083838-u8qdops","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083838-u8qdops","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"《中国药典》：苍术"}]},{"ID":"20240616083838-r3vw1h3","Type":"NodeParagraph","Properties":{"id":"20240616083838-r3vw1h3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616083838-y8xorax","Type":"NodeParagraph","Properties":{"id":"20240616083838-y8xorax","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" Cānɡ Shù"}]},{"ID":"20240616083838-r8mobpp","Type":"NodeParagraph","Properties":{"id":"20240616083838-r8mobpp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616083838-vn1aeee","Type":"NodeParagraph","Properties":{"id":"20240616083838-vn1aeee","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 赤术、枪头菜"}]},{"ID":"20240616083838-0p7r6e8","Type":"NodeParagraph","Properties":{"id":"20240616083838-0p7r6e8","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240616083838-vq1viaf","Type":"NodeParagraph","Properties":{"id":"20240616083838-vq1viaf","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" RHIZOMA ATRACTYLODIS"}]},{"ID":"20240616083838-tx3kdpy","Type":"NodeParagraph","Properties":{"id":"20240616083838-tx3kdpy","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616083838-fboupfk","Type":"NodeParagraph","Properties":{"id":"20240616083838-fboupfk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茅苍术"},{"Type":"NodeText","Data":"Atractylodes lancea （Thunb.） DC.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"北苍术"},{"Type":"NodeText","Data":"Atractylodes chinensis （DC.） Koidz.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去泥沙，晒干，撞去须根。"}]},{"ID":"20240616083838-fxk0jvh","Type":"NodeParagraph","Properties":{"id":"20240616083838-fxk0jvh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616083838-rij084l","Type":"NodeParagraph","Properties":{"id":"20240616083838-rij084l","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茅苍术"},{"Type":"NodeText","Data":"：呈不规则连珠状或结节状圆柱形，略弯曲，偶有分枝，长3～10cm，直径1～2cm。表面灰棕色，有皱纹、横曲纹及残留须根，顶端具茎痕或残留茎基。质坚实，断面黄白色或灰白色，散有多数橙黄色或棕红色油室，暴露稍久，可析出白色细针状结晶。气香特异，味微甘、辛、苦。"}]},{"ID":"20240616083838-q8q2521","Type":"NodeParagraph","Properties":{"id":"20240616083838-q8q2521","updated":"20240616083838"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"北苍术"},{"Type":"NodeText","Data":"：呈疙瘩块状或结节状圆柱形，长4～9cm，直径1～4cm。表面黑棕色，除去外皮者黄棕色。质较疏松，断面散有黄棕色油室。香气较淡，味辛、苦。"}]},{"ID":"20240616083838-qgwc5yo","Type":"NodeParagraph","Properties":{"id":"20240616083838-qgwc5yo","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240616083838-c3vy4vz","Type":"NodeParagraph","Properties":{"id":"20240616083838-c3vy4vz","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处。"}]},{"ID":"20240616083838-grzrh07","Type":"NodeParagraph","Properties":{"id":"20240616083838-grzrh07","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240616083838-lxsn1fh","Type":"NodeParagraph","Properties":{"id":"20240616083838-lxsn1fh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苍术"},{"Type":"NodeText","Data":"：除去杂质，洗净，润透，切厚片，干燥。"}]},{"ID":"20240616083838-s4lh7ee","Type":"NodeParagraph","Properties":{"id":"20240616083838-s4lh7ee","updated":"20240616083838"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麸炒苍术"},{"Type":"NodeText","Data":"：取苍术片，照麸炒法（附录Ⅱ D）炒至表面深黄色。本品呈类圆形或条形厚片，灰屑不得过3％ （附录Ⅸ B）。"}]},{"ID":"20240616083838-7aeqghk","Type":"NodeParagraph","Properties":{"id":"20240616083838-7aeqghk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240616083838-xs01j3v","Type":"NodeParagraph","Properties":{"id":"20240616083838-xs01j3v","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末棕色。草酸钙针晶细小，长5～30μm，不规则地充塞于薄壁细胞中。纤维大多成束，长梭形，直径约至40μm，壁甚厚，木化。石细胞甚多，有时与木栓细胞连结，多角形、类圆形或类长方形，直径20～80μm，壁极厚。菊糖多见，表面呈放射状纹理。"}]},{"ID":"20240616083838-dm4xr4t","Type":"NodeParagraph","Properties":{"id":"20240616083838-dm4xr4t","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末0.5g，加正己烷2ml， 超声处理15分钟，滤过，滤液作为供试品溶液。另取苍术对照药材0.5g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述新制备的两种溶液各2～6μl， 分别点于同一硅胶Ｇ薄层板上，以石油醚（60～90℃）－醋酸乙酯（20:1）为展开剂，展开，取出，晾干，喷以5％ 对二甲氨基苯甲醛的10％硫酸乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点；并应显有一相同的污绿色主斑点（苍术素）。"}]},{"ID":"20240616083838-qr6udbp","Type":"NodeParagraph","Properties":{"id":"20240616083838-qr6udbp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616083838-gjodpj9","Type":"NodeParagraph","Properties":{"id":"20240616083838-gjodpj9","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 归脾、胃、肝经。"}]},{"ID":"20240616083838-95nopb2","Type":"NodeParagraph","Properties":{"id":"20240616083838-95nopb2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616083838-55uda8w","Type":"NodeParagraph","Properties":{"id":"20240616083838-55uda8w","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 辛、苦，温。"}]},{"ID":"20240616083838-c77p06r","Type":"NodeParagraph","Properties":{"id":"20240616083838-c77p06r","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616083838-of7qedh","Type":"NodeParagraph","Properties":{"id":"20240616083838-of7qedh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 燥湿健脾，祛风散寒，明目。用于脘腹胀满，泄泻，水肿，脚气痿躄，风湿痹痛，风寒感冒，夜盲。"}]},{"ID":"20240616083838-p7bqqg2","Type":"NodeParagraph","Properties":{"id":"20240616083838-p7bqqg2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616083838-oo2j4vt","Type":"NodeParagraph","Properties":{"id":"20240616083838-oo2j4vt","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240616083838-id71cw3","Type":"NodeParagraph","Properties":{"id":"20240616083838-id71cw3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240616083838-owo72vj","Type":"NodeParagraph","Properties":{"id":"20240616083838-owo72vj","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" （1）治湿阻脾胃而见脘腹胀满、食欲不振、倦怠乏力、舌苔白腻厚浊等症，常与厚朴、陈皮等配伍应用；用治寒湿白带，可配白芷同用。本品虽属温燥之品，然燥湿力强，又每配合清热之品以治湿热为患之证，如湿热白带，又可配知母、苦参、墓头回；湿热下注、脚膝肿痛、痿软无力，可配黄柏、牛膝、苡仁等同用；湿温病证可配石膏、知母等同用。对寒湿偏重的痹痛尤为适宜，可配合羌活、独活等同用。用于感受风寒湿邪的头痛、身痛、无汗等症，常与羌活、细辛、防风等同用。有明目之功，为治夜盲要药，可与猪肝或羊肝、石决明等配伍同用。此外，本品气味芳香，又能辟秽，民间每于夏历端午节用苍朮与白芷在室内同燃，用以辟疫。经近人实验，此法确能起到消毒杀菌的作用。"}]},{"ID":"20240616083838-gdd5qfx","Type":"NodeParagraph","Properties":{"id":"20240616083838-gdd5qfx","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616083838-79o1pdu","Type":"NodeParagraph","Properties":{"id":"20240616083838-79o1pdu","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240616083838-kklc9zn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083838-kklc9zn","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：苍术"}]},{"ID":"20240616083838-ggtmyle","Type":"NodeParagraph","Properties":{"id":"20240616083838-ggtmyle","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616083838-2ej8kws","Type":"NodeParagraph","Properties":{"id":"20240616083838-2ej8kws","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" Cānɡ Shù"}]},{"ID":"20240616083838-o4euoc4","Type":"NodeParagraph","Properties":{"id":"20240616083838-o4euoc4","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616083838-hpj347y","Type":"NodeParagraph","Properties":{"id":"20240616083838-hpj347y","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 赤术（陶弘景），马蓟（《说文系传》），青术（张衮《水南翰记》），仙术（《纲目》）。"}]},{"ID":"20240616083838-v8enq5o","Type":"NodeParagraph","Properties":{"id":"20240616083838-v8enq5o","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240616083838-6bdeid5","Type":"NodeParagraph","Properties":{"id":"20240616083838-6bdeid5","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 《证类本草》"}]},{"ID":"20240616083838-5mipo78","Type":"NodeParagraph","Properties":{"id":"20240616083838-5mipo78","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616083838-off2cb1","Type":"NodeParagraph","Properties":{"id":"20240616083838-off2cb1","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"南苍术"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"北苍术"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。春、秋均可采挖，以秋季为好。挖取根茎后，除去残茎、须根及泥土，晒干。"}]},{"ID":"20240616083838-4exsyhk","Type":"NodeParagraph","Properties":{"id":"20240616083838-4exsyhk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616083838-binwdf8","Type":"NodeParagraph","Properties":{"id":"20240616083838-binwdf8","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" ①南苍术"}]},{"ID":"20240616083838-dpoho1t","Type":"NodeParagraph","Properties":{"id":"20240616083838-dpoho1t","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～80厘米。根茎粗大不整齐。茎单一，圆而有纵棱，上部稍有分枝。叶互生，革质而厚；茎下部的叶多为3裂，裂片先端尖，顶端1裂片较大，卵形，基部楔形，无柄而略抱茎；茎上部叶卵状披针形至椭圆形，长约4厘米，宽1～1.5厘米，无柄，叶缘均有刺状齿。上面深绿，下面稍带白粉状。头状花序顶生，直径约2厘米；总花托无梗，基郎有叶状及细羽裂多刺苞片；总苞片6～8层，披针形，膜质，背面绿色，边缘带紫色，并有细乘毛；花托平坦，花多数，两性花与单性花多异株；两性花有多数羽毛状长冠毛；花冠管状，白色，有时稍带红紫色，先端5裂，裂片线形；花丝分离；子房下位，长柱形，密被白色柔毛，花柱细长，柱头2裂。单性花一般为雌花，具5枚线状退化雄蕊，退化雄蕊完全分离，先端略曲卷，其余部分与两性花同。瘦果长圆形，长约5毫米，被棕黄色柔毛。花期8～10月。果期9～10月。"}]},{"ID":"20240616083838-zj2cdt4","Type":"NodeParagraph","Properties":{"id":"20240616083838-zj2cdt4","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"多生于山坡较干燥处。分布江苏、浙江、安徽、江西、湖北、河北、山东等地。"}]},{"ID":"20240616083838-6oqfvz2","Type":"NodeParagraph","Properties":{"id":"20240616083838-6oqfvz2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②北苍术，又名：山苍术、枪头菜、山刺菜。"}]},{"ID":"20240616083838-fd7lnwk","Type":"NodeParagraph","Properties":{"id":"20240616083838-fd7lnwk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～50厘米。根茎肥大，结节状。叶无柄；茎下部叶匙形，多为3～5羽状深缺刻，先端钝，基部楔形而略抱茎；茎上郜叶卵状披针形至椭圆形，3～5羽状浅裂至不裂，叶缘具硬刺齿。头状花序径1厘米左右；基部叶状苞披针形，边缘长栉齿状；总苞片多为5～6层；花冠管状，白色，先端5裂，裂片长卵形；退化雄蕊先端圆，不卷曲。瘦果密生向上的银白色毛。花期7～8月。果期8～10月。"}]},{"ID":"20240616083838-e4wkujh","Type":"NodeParagraph","Properties":{"id":"20240616083838-e4wkujh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"生长于山坡灌木丛及较干旱处。分布吉林、辽宁、河北、山东、山西、陕西、内蒙古等地。"}]},{"ID":"20240616083838-l5esq0u","Type":"NodeParagraph","Properties":{"id":"20240616083838-l5esq0u","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616083838-b783mpb","Type":"NodeParagraph","Properties":{"id":"20240616083838-b783mpb","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" ①南苍术"}]},{"ID":"20240616083838-h1mxmzg","Type":"NodeParagraph","Properties":{"id":"20240616083838-h1mxmzg","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"为植物南苍术的干燥根茎，呈类圆柱形，连珠状，有节，弯曲拘挛，长约3～10厘米，直径1～1.5厘米。表面灰褐色，有根痕及短小的须根，可见茎残痕。质坚实，折断面平坦，黄白色，有明显的棕红色油腺散在，习称\"朱砂点\"。断面暴露稍久，可析出白霉样的微细针状结晶，气芳香，味微甘而辛苦。以个大、坚实、无毛须、内有朱砂点，切开后断面起白霜者佳。"}]},{"ID":"20240616083838-udl65dt","Type":"NodeParagraph","Properties":{"id":"20240616083838-udl65dt","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"主产江苏、湖北、河南。此外，浙江、安徽、江西亦产。以产于江苏茅山一带者质量最好，故称\"茅术\"或\"茅山苍术\"，集散于南京者，亦称\"京茅术\"、\"京苍术\"。湖北、江西所产，多集散于汉口，故亦称\"汉苍术\"，"}]},{"ID":"20240616083838-rzw8kpm","Type":"NodeParagraph","Properties":{"id":"20240616083838-rzw8kpm","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②北苍术"}]},{"ID":"20240616083838-pzz3tci","Type":"NodeParagraph","Properties":{"id":"20240616083838-pzz3tci","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"为植物北苍术的干燥根茎，呈类圆柱形，常分歧或成疙瘩块状，不规则弯曲，长约4～10厘米，直径1.5～3厘米。栓皮多已除去，可见较多圆形茎基或茎痕，或有毛茸状芽附着，下方有小根脱落痕迹或短的小根附着。表面棕褐色，粗糙。质轻，易折断，断面纤维状，极不平坦。断面黄白色，有红黄色或黄色油腺散在，并有明显的木质纤维束。气芳香，味微辛苦。以个肥大、坚实、无毛须、气芳香者为佳。本种较南苍术体轻质松，油腺少，切断面不析出白霉样结晶，香气亦较弱。质量较南苍术为次。"}]},{"ID":"20240616083838-38ihvlm","Type":"NodeParagraph","Properties":{"id":"20240616083838-38ihvlm","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"主产内蒙古、河北、山西、辽宁、吉林、黑龙江。此外，山东、陕西、甘肃等地亦产。河北各地所产的多集散于天津，故有\"津苍术\"之称。"}]},{"ID":"20240616083838-6oyx5w8","Type":"NodeParagraph","Properties":{"id":"20240616083838-6oyx5w8","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616083838-06u2r5f","Type":"NodeParagraph","Properties":{"id":"20240616083838-06u2r5f","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 南苍术根茎含挥发油约5～9％。油的主要成分为苍术醇、茅术醇、β-桉叶醇等。"}]},{"ID":"20240616083838-xywgrbs","Type":"NodeParagraph","Properties":{"id":"20240616083838-xywgrbs","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"北苍术根茎含挥发油1.5％，其主要成分为苍术醇、苍术酮、茅术醇及桉叶醇等。"}]},{"ID":"20240616083838-xfcjhw3","Type":"NodeParagraph","Properties":{"id":"20240616083838-xfcjhw3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"东苍术根茎含挥发油1.5％，其主要成分为苍术醇、茅术醇、β-桉叶醇、苍术呋哺烃、苍术酮。"}]},{"ID":"20240616083838-i1g8zxy","Type":"NodeParagraph","Properties":{"id":"20240616083838-i1g8zxy","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240616083838-xtnjwy2","Type":"NodeParagraph","Properties":{"id":"20240616083838-xtnjwy2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" ①对血糖的影响"}]},{"ID":"20240616083838-a7p1710","Type":"NodeParagraph","Properties":{"id":"20240616083838-a7p1710","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"早年报告南苍术浸膏（相当生药6克／公斤）可降低家兔血糖，未被证实。煎剂或醇浸剂8克／公斤口服或皮下注射，正常家兔的血糖略有上升的倾向。用煎剂10克／公斤灌胃，亦得到相同的结果；但同剂量灌注四氧嘧啶性糖尿病家兔，则血糖略升后即下降到灌药前血糖水平以下，唯差别并不明显。此后在每日灌药的10天内，血糖不断下降，差别显着（自401降至160毫克％）。停药后4～17天血糖未见升高到用药前水平。"}]},{"ID":"20240616083838-g15uqol","Type":"NodeParagraph","Properties":{"id":"20240616083838-g15uqol","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240616083838-cbji2bp","Type":"NodeParagraph","Properties":{"id":"20240616083838-cbji2bp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"南苍术煎剂10～40克／公斤给大鼠灌胃，无利尿作用；却有显着排盐（钠、钾、氯）作用。含苍术的复方-排气汤（苍术、厚朴、台乌、沉香、广木香、炒麦芽及广皮）虽对离体兔肠并无影响，但对在位犬肠，无论灌胃或静脉注射，均有兴奋肠蠕动的作用，临床上有用此治腹气胀有效者。苍术浸膏小量静脉注射，引起兔血压轻度上升，大量则降压；对离体蟾蜍心脏有抑制作用；对离体兔十二指肠亦有抑制作用；对蟾蜍下肢血管，作用微弱。"}]},{"ID":"20240616083838-lizv8wq","Type":"NodeParagraph","Properties":{"id":"20240616083838-lizv8wq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"苍术、艾叶烟熏消毒（6立方米实验室各用4两，烟熏2小时）对结核杆菌、金黄色葡萄球菌、大肠、枯草及绿脓杆菌有显著的灭菌效果，与福尔马林相似；而优于紫外线及乳酸的消毒。"}]},{"ID":"20240616083838-ufew867","Type":"NodeParagraph","Properties":{"id":"20240616083838-ufew867","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240616083838-9g5uocq","Type":"NodeParagraph","Properties":{"id":"20240616083838-9g5uocq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 苍水：拣去杂质，用水泡至七、八成透，捞出，润透后切片，晒干。炒苍术：取苍术片，用米泔水喷洒湿润，置锅内用文火炒至微黄色；或取拣净的苍术，用米泔水浸泡后捞出，置笼履内加热蒸透，取出，切片，干燥即得。"}]},{"ID":"20240616083838-p0fenjd","Type":"NodeParagraph","Properties":{"id":"20240616083838-p0fenjd","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"苍术性燥，故以糯米泔浸去其油，切片焙干用，亦有用脂麻同炒，以制其燥者。\""}]},{"ID":"20240616083838-8ntbjbv","Type":"NodeParagraph","Properties":{"id":"20240616083838-8ntbjbv","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②《本草述钩元》：\"苍术，米泔浸洗极净，刮去皮，拌黑豆蒸引之。又拌蜜酒蒸，又拌人乳透蒸，皆润之使不燥也。凡三次蒸时，须烘晒极干，气方透。\""}]},{"ID":"20240616083838-llucy8s","Type":"NodeParagraph","Properties":{"id":"20240616083838-llucy8s","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616083838-gg6ims7","Type":"NodeParagraph","Properties":{"id":"20240616083838-gg6ims7","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240616083838-r420dgw","Type":"NodeParagraph","Properties":{"id":"20240616083838-r420dgw","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"①《珍珠囊》：\"足阳明、太阴。\""}]},{"ID":"20240616083838-70bvatq","Type":"NodeParagraph","Properties":{"id":"20240616083838-70bvatq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"入足太阴、阳明，手太阴、太阳之经。\""}]},{"ID":"20240616083838-xfgp20l","Type":"NodeParagraph","Properties":{"id":"20240616083838-xfgp20l","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入足阳明、太阳经。\""}]},{"ID":"20240616083838-qohdbpr","Type":"NodeParagraph","Properties":{"id":"20240616083838-qohdbpr","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入脾、肝二经。\""}]},{"ID":"20240616083838-u7qn1cq","Type":"NodeParagraph","Properties":{"id":"20240616083838-u7qn1cq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616083838-enutny4","Type":"NodeParagraph","Properties":{"id":"20240616083838-enutny4","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 辛苦，温。"}]},{"ID":"20240616083838-i24hp1q","Type":"NodeParagraph","Properties":{"id":"20240616083838-i24hp1q","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"①《本草衍义》：\"气味辛烈。\""}]},{"ID":"20240616083838-ocuumvy","Type":"NodeParagraph","Properties":{"id":"20240616083838-ocuumvy","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②《珍珠囊》：\"甘辛。\""}]},{"ID":"20240616083838-0532y0g","Type":"NodeParagraph","Properties":{"id":"20240616083838-0532y0g","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"③《晶汇精要》：\"味苦甘，性温，无毒。\""}]},{"ID":"20240616083838-uuo9ivj","Type":"NodeParagraph","Properties":{"id":"20240616083838-uuo9ivj","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240616083838-ff4nbkd","Type":"NodeParagraph","Properties":{"id":"20240616083838-ff4nbkd","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 阴虚内热，气虚多汗者忌服。"}]},{"ID":"20240616083838-1s3qqvv","Type":"NodeParagraph","Properties":{"id":"20240616083838-1s3qqvv","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"防风、地榆为之使。\""}]},{"ID":"20240616083838-rri0eaj","Type":"NodeParagraph","Properties":{"id":"20240616083838-rri0eaj","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"忌桃、李、雀肉、菘菜、青鱼。\""}]},{"ID":"20240616083838-44r84km","Type":"NodeParagraph","Properties":{"id":"20240616083838-44r84km","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"③《医学入门》：\"血虚怯弱及七情气闷者慎用。误服耗气血，燥津液，虚火动而痞闷愈甚。\""}]},{"ID":"20240616083838-sz92g1d","Type":"NodeParagraph","Properties":{"id":"20240616083838-sz92g1d","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"凡病属阴虚血少、精不足，内热骨蒸，口干唇燥，咳嗽吐痰、吐血，鼻衄，咽塞，便秘滞下者，法咸忌之。肝肾有动气者勿服。\""}]},{"ID":"20240616083838-yy8pjkv","Type":"NodeParagraph","Properties":{"id":"20240616083838-yy8pjkv","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"内热阴虚，表疏汗出者忌服。\""}]},{"ID":"20240616083838-1o87py3","Type":"NodeParagraph","Properties":{"id":"20240616083838-1o87py3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616083838-c9frfup","Type":"NodeParagraph","Properties":{"id":"20240616083838-c9frfup","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 健脾，燥湿，解郁，辟秽。治湿盛困脾，倦怠嗜卧，脘痞腹胀，食欲不振，呕吐，泄泻，痢疾，疟疾，痰饮，水肿，时气感冒，风寒湿痹，足痿，夜盲。"}]},{"ID":"20240616083838-kgkeawf","Type":"NodeParagraph","Properties":{"id":"20240616083838-kgkeawf","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"除恶气。\""}]},{"ID":"20240616083838-n82l0zn","Type":"NodeParagraph","Properties":{"id":"20240616083838-n82l0zn","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②刘完素：\"明目，暖水脏。\""}]},{"ID":"20240616083838-yf1c5wi","Type":"NodeParagraph","Properties":{"id":"20240616083838-yf1c5wi","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"③《珍珠囊》：\"能健胃安脾，诸湿肿非此不能除。\""}]},{"ID":"20240616083838-3xwn7ef","Type":"NodeParagraph","Properties":{"id":"20240616083838-3xwn7ef","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"④李杲：\"除湿发汗，健胃安脾，治痿要药。\""}]},{"ID":"20240616083838-a97xglp","Type":"NodeParagraph","Properties":{"id":"20240616083838-a97xglp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑤朱震亨：\"散风益气，总解诸郁。\""}]},{"ID":"20240616083838-gf2suhq","Type":"NodeParagraph","Properties":{"id":"20240616083838-gf2suhq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治湿痰留饮，或挟瘀血成窠囊，及脾湿下流，浊沥带下，滑泻肠风。\""}]},{"ID":"20240616083838-e6q7ha3","Type":"NodeParagraph","Properties":{"id":"20240616083838-e6q7ha3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑦《玉楸药解》：\"燥土利水，泄饮消痰，行瘀，开郁，去漏，化癣，除癥，理吞酸去腐，辟山川瘴疠，回筋骨之痿软，清溲溺之混浊。\""}]},{"ID":"20240616083838-n55ie9h","Type":"NodeParagraph","Properties":{"id":"20240616083838-n55ie9h","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑧《本草求原》：\"止水泻飧泄，伤食暑泻，脾湿下血。\""}]},{"ID":"20240616083838-mlresdh","Type":"NodeParagraph","Properties":{"id":"20240616083838-mlresdh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616083838-zas07e5","Type":"NodeParagraph","Properties":{"id":"20240616083838-zas07e5","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；熬膏或入丸、散。"}]},{"ID":"20240616083838-kbinrgv","Type":"NodeParagraph","Properties":{"id":"20240616083838-kbinrgv","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240616083838-vcj3c7i","Type":"NodeParagraph","Properties":{"id":"20240616083838-vcj3c7i","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" ①治脾胃不和，不思饮食，心腹胁肋胀满刺痛，口苦无味，呕吐恶心，常多自利：苍术（去粗皮，米泔浸二日）五斤，厚朴（去粗皮，姜汁制，炒香）、陈皮（去白）各三斤二两，甘草（炒）三十两。上为细末。每服二钱，以水一盏，入生姜二片，干枣两枚，同煎至七分，去姜、枣，带热服，空心食前；入盐一捻，沸汤点服亦得。（《局方》平胃散）"}]},{"ID":"20240616083838-mic04go","Type":"NodeParagraph","Properties":{"id":"20240616083838-mic04go","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"②治太阴脾经受湿，水泄注下，体微重微满，困弱无力，不欲饮食，暴泄无数，水谷不化，如痛甚者：苍术二两，芍药一两，黄芩半两。上锉，每服一两，加淡味桂半钱，水一盏半，煎至一盏，温服。（《素问病机保命集》苍术芍药汤）"}]},{"ID":"20240616083838-v5qopa0","Type":"NodeParagraph","Properties":{"id":"20240616083838-v5qopa0","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"③治时暑暴泻，壮脾温胃，进美饮食，及疗饮食所伤，胸膈痞闷：神曲（炒）、苍术（米泔浸一宿，焙干）各等分为末。面糊为丸，如梧桐子大。每服三十丸，不拘时，米饮吞下。（《局方》曲术丸）"}]},{"ID":"20240616083838-d5x0caq","Type":"NodeParagraph","Properties":{"id":"20240616083838-d5x0caq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"④治飧泄：苍术二两，小椒一两（去目，炒）。上为极细末，醋糊为丸，如桐子大。每服二十丸，或三十丸，食前温水下。一法恶痢久不愈者加桂。（《素问病机保命集》椒术丸）"}]},{"ID":"20240616083838-ebl4jaq","Type":"NodeParagraph","Properties":{"id":"20240616083838-ebl4jaq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑤治膈中停饮，已成癣囊：苍术一斤，去皮，切，末之，用生麻油半两，水二盏，研滤取汁，大枣十五枚，烂者去皮、核，研，以麻汁匀研成稀膏，搜和，入臼熟杵，丸梧子大，干之。每日空腹用盐汤吞下五十丸，增至一百丸、二百丸。忌桃李雀鸽。（《本事方》）"}]},{"ID":"20240616083838-zou3pv2","Type":"NodeParagraph","Properties":{"id":"20240616083838-zou3pv2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑥治脾经湿气，少食，湿肿，四肢无力，伤食，酒色过度，劳逸有伤，骨热：鲜白苍术二十斤，浸去粗皮，洗净晒干，锉碎，用米泔浸一宿，洗净，用溪水一担，大锅入药，以慢火煎半干去渣，再入石楠叶三斤，刷去红衣，用楮实子一斤，川归半斤，甘草四两，切，研，同煎黄色，用麻布滤去渣，再煎如稀粥，方入好白蜜三斤，同煎成膏。每用好酒，空心食远，调三、五钱服，不饮酒用米汤。有肿气用白汤，呕吐用姜汤。（《活人心统》苍术膏）"}]},{"ID":"20240616083838-0odpm0v","Type":"NodeParagraph","Properties":{"id":"20240616083838-0odpm0v","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑦治湿温多汗：知母六两，甘草（炙）二两，石膏一斤，苍术三两，粳米三两。上锤如麻豆大。每服五钱，水一盏半，煎至八、九分，去滓取六分清汁，温服。（《类证活人书》白虎加苍术汤）"}]},{"ID":"20240616083838-lodsfhk","Type":"NodeParagraph","Properties":{"id":"20240616083838-lodsfhk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑧治四时瘟疫，头痛项强，发热憎寒，身体疼痛，及伤风、鼻塞声重、咳嗽头昏：苍术（米泔浸一宿，切，焙）五两，藁本（去土）、香白芷、细辛（去叶、土）、羌活（去芦）、川芎、甘草（炙）各一两。上为细末。每服三钱，水一盏，生姜三片，葱白三寸，煎七分，温服，不拘时。如觉伤风鼻塞，只用葱茶调下。（《局方》神术散）"}]},{"ID":"20240616083838-fpa2do4","Type":"NodeParagraph","Properties":{"id":"20240616083838-fpa2do4","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑨治感冒：苍术一两，细辛二钱，侧柏叶三钱。共研细末，每日四次，每次一钱五分，开水冲服，葱白为引，生吃。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240616083838-tu1kvo2","Type":"NodeParagraph","Properties":{"id":"20240616083838-tu1kvo2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑩治湿气身痛：苍术，泔浸切，水煎，取浓汁熬膏，白汤点服。（《简便单方》）"}]},{"ID":"20240616083838-c83ezi9","Type":"NodeParagraph","Properties":{"id":"20240616083838-c83ezi9","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑾治筋骨疼痛因湿热者：黄柏（炒）、苍术（米泔浸炒）。上二味为末，沸汤入姜汁调服。二物皆有雄壮之气，表实气实者，加酒少许佐之。（《丹溪心法》二妙散，即《世医得效方》苍术散）"}]},{"ID":"20240616083838-4f277nb","Type":"NodeParagraph","Properties":{"id":"20240616083838-4f277nb","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⑿补虚明目，健骨和血：苍术（泔浸）四两，熟地黄（焙）二两。为末，酒糊丸梧子大。每温酒下三、五十丸，日三服。（《普济方》）"}]},{"ID":"20240616083838-uw0tpgi","Type":"NodeParagraph","Properties":{"id":"20240616083838-uw0tpgi","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⒀治牙床风肿：大苍术，切作两片，于中穴一孔，入盐实之，湿纸裹，烧存性，取出研细，以此揩之，去风涎即愈，以盐汤漱口。（《普济方）苍术散）"}]},{"ID":"20240616083838-7kxjk46","Type":"NodeParagraph","Properties":{"id":"20240616083838-7kxjk46","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"⒁控制疟疾症状或作预防：苍术、白芷、川芎、桂枝各等分为末，每用1克，以纱布四层包成长形，于疟发前1～2小时塞鼻孔内，5小时或1天。（《山西中草药》）"}]},{"ID":"20240616083838-3xk9109","Type":"NodeParagraph","Properties":{"id":"20240616083838-3xk9109","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240616083838-cvxfgd6","Type":"NodeParagraph","Properties":{"id":"20240616083838-cvxfgd6","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 此外，尚有以下几种同属植物在少数地区有时也作苍术使用。㈠"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"东苍术"},{"Type":"NodeText","Data":"，又名：关苍术。多年生草本，高达70厘米。根茎肥大，结节状。叶柄长2.5～3厘米；茎下部叶3～5羽裂，侧裂片长圆形、倒卵形或椭圆形，先端短尖，边缘刺齿平伏或内弯，顶裂片较大；茎上部叶3裂至不分裂。头状花序径1～1.5厘米，基部叶状苞2列，羽状深裂；总苞片7～8层，先端带紫色；花冠管状，白色。瘦果长圆形，密生向上的银白色毛，冠毛羽状，灰褐色。花期7～8月。果期8～9月。分布我国东北。㈡"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"朝鲜苍术"},{"Type":"NodeText","Data":"，茎先端的叶超出顶端的花，头状花序下的苞叶边缘有栉齿状刺齿。分布东北。㈢"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全叶苍术"},{"Type":"NodeText","Data":"，叶不分裂，长圆形，先端钝尖，全缘。分布华北、东北一带。㈣赤峰苍术，叶5～7裂，裂片急尖，叶缘有不规则齿状锯齿。分布东北赤峰。㈤"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辽东苍术"},{"Type":"NodeText","Data":"，叶长卵形，稍小，质较硬，全缘；头状花序下的叶状苞多数，密集。分布辽东半岛一带。"}]},{"ID":"20240616083838-x0d3ent","Type":"NodeParagraph","Properties":{"id":"20240616083838-x0d3ent","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616083838-roqg99y","Type":"NodeParagraph","Properties":{"id":"20240616083838-roqg99y","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240616083838-fxylzq7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616083838-fxylzq7","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"《中华本草》：苍术"}]},{"ID":"20240616083838-6xoewh6","Type":"NodeParagraph","Properties":{"id":"20240616083838-6xoewh6","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616083838-z89fwsy","Type":"NodeParagraph","Properties":{"id":"20240616083838-z89fwsy","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" Shēnɡ Shù"}]},{"ID":"20240616083838-q6etpqq","Type":"NodeParagraph","Properties":{"id":"20240616083838-q6etpqq","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616083838-vsw3ohz","Type":"NodeParagraph","Properties":{"id":"20240616083838-vsw3ohz","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 山精、赤术、马蓟、青术、仙术"}]},{"ID":"20240616083838-deml86l","Type":"NodeParagraph","Properties":{"id":"20240616083838-deml86l","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240616083838-cc6eudu","Type":"NodeParagraph","Properties":{"id":"20240616083838-cc6eudu","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" Rhizome of Swordlike Atractylodes, Rhizome Chinese Atractylodes, Rhizome Japanese Atractylodes, Rhizome Korea Atractylodes, Rhizome of Swordlike Atractylodes, Rhizome of Simplicifolious Atractylode"}]},{"ID":"20240616083838-h3x9ev7","Type":"NodeParagraph","Properties":{"id":"20240616083838-h3x9ev7","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240616083838-q4m5ocp","Type":"NodeParagraph","Properties":{"id":"20240616083838-q4m5ocp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240616083838-x1i9mpu","Type":"NodeParagraph","Properties":{"id":"20240616083838-x1i9mpu","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616083838-8ep1ky3","Type":"NodeParagraph","Properties":{"id":"20240616083838-8ep1ky3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物茅苍术、北苍术、关苍术的根茎。"}]},{"ID":"20240616083838-0am6z3j","Type":"NodeParagraph","Properties":{"id":"20240616083838-0am6z3j","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Atractylodes lancea (Thunb.)DC. [Atractylis lancea Thunb.; Atractylodes ouata (Thunb.) DC.]2.Atractylodes lancea (Thunb.) DC.var. chinensis (Bunge)Kitam. [A.chinensis (DC.)Koidz.; Atractylis chinen-sis (Bunge) DC.]3.Atractylodes japonica Koidz.ex Kitam.[A.japonica (Ditag.)]"}]},{"ID":"20240616083838-tmv4pmr","Type":"NodeParagraph","Properties":{"id":"20240616083838-tmv4pmr","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培2-3年后，9月上旬至11月上旬或翌年2-3月，挖掘根茎，除将残茎，抖掉泥土，晒干，去除根须或晒至九成干后用火燎掉须根，再晒至全干。"}]},{"ID":"20240616083838-vffm1b9","Type":"NodeParagraph","Properties":{"id":"20240616083838-vffm1b9","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240616083838-qf83pqt","Type":"NodeParagraph","Properties":{"id":"20240616083838-qf83pqt","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡灌丛、草丛中。"}]},{"ID":"20240616083838-drvf4mk","Type":"NodeParagraph","Properties":{"id":"20240616083838-drvf4mk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.生于低山阴坡灌丛、林下及较干燥处。"}]},{"ID":"20240616083838-0hqx52e","Type":"NodeParagraph","Properties":{"id":"20240616083838-0hqx52e","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.生于山坡、林缘、柞林下或灌丛间。"}]},{"ID":"20240616083838-7n2pequ","Type":"NodeParagraph","Properties":{"id":"20240616083838-7n2pequ","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于山东、江苏、安徽、浙江、江西、河南、湖北、四川等地，各地多有栽培。"}]},{"ID":"20240616083838-1v49909","Type":"NodeParagraph","Properties":{"id":"20240616083838-1v49909","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.分布于东北、华北及陕西、宁夏、甘肃、山东、河南等地。"}]},{"ID":"20240616083838-se56teo","Type":"NodeParagraph","Properties":{"id":"20240616083838-se56teo","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.分布于黑龙江、吉林、辽宁、内蒙古、河北等地。"}]},{"ID":"20240616083838-b7trqd1","Type":"NodeParagraph","Properties":{"id":"20240616083838-b7trqd1","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616083838-ibuj52n","Type":"NodeParagraph","Properties":{"id":"20240616083838-ibuj52n","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 1.茅苍术 多年生草本。根状茎横走，节状。茎多纵棱，高30-100m，不分枝或上部稍分枝。叶互生，革质；叶片卵状披针形至椭圆形，长3-8cm，宽1-3cm，先端渐尖，基部渐狭，中央裂片较大，卵形，边缘有刺状锯齿或重刺齿，上面深绿色，有光泽，下面淡绿色，叶脉隆起，无柄，不裂，或下部叶常2裂，裂片先端尖，先端裂片极大，卵形，两侧的较小，基部楔形，无柄或有柄。头状花序生于茎枝先端，叶状苞片1列，羽状深裂，裂片刺状；总苞圆柱形，总苞片5-8层，卵形至披针形，有纤毛；花多数，两性花或单性花多异株；花冠筒状，白色或稍带红色，长约1cm，上部略膨大，先端5裂，裂片条形；两性花有多数羽状分裂的冠毛；单性花一般为雌花，具5枚线状退化雄蕊，先端略卷曲。瘦果倒卵圆形，被稠密的黄白色柔毛。花期8-10月，果期9-12月。"}]},{"ID":"20240616083838-brvjsp3","Type":"NodeParagraph","Properties":{"id":"20240616083838-brvjsp3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.北苍术 本种与茅苍术的区别是：叶片较宽，卵形或长卵形，一般羽状5深裂，茎上部叶3-5羽状浅裂或不裂，叶缘有不规则的刺状锯齿，通常无叶柄；头状花序稍宽，总苞片56-层，较茅苍术略宽；退化雄蕊先端圆，不卷曲。花期7-8月，果期8-9月。"}]},{"ID":"20240616083838-kscf27e","Type":"NodeParagraph","Properties":{"id":"20240616083838-kscf27e","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.关苍术 本种与上述两种主要区别为：叶有长叶柄，上部叶3出，下部叶羽状3-5全裂，裂片长圆形，倒卵形或椭圆形，基部渐狭而下延，边缘有平伏或内弯的刚毛锯齿。花期8-9月，果期9-10月。"}]},{"ID":"20240616083838-2ss2r0n","Type":"NodeParagraph","Properties":{"id":"20240616083838-2ss2r0n","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240616083838-f4izodu","Type":"NodeParagraph","Properties":{"id":"20240616083838-f4izodu","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽气候，耐旱，忌积水。最适生长温度15-22℃，幼苗能耐-15℃左右低温。以半阴半阳、土层深厚、疏松肥沃、富含腐殖质、排水良好的砂质壤土栽培为宜。"}]},{"ID":"20240616083838-2br58io","Type":"NodeParagraph","Properties":{"id":"20240616083838-2br58io","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子或根茎繁殖。种子繁殖：8-10月待种子外被的较毛呈黄棕色时，分批采摘花序，放阴凉处干燥，脱粒、扬将，装入布袋贮藏备用。用直播或育苗移栽法。直播法于3-月中旬至4月上旬，按行株距20cm×10cm开穴，每穴播4-5粒，覆薄细土，以盖满种子为度，浇水。育苗移栽法，撒播，覆稻草一层，浇水保湿。种子发芽率50%左右，温度在16-18℃时约经10-15d出苗。培育1-2年，3月上旬移栽，按行株距20cm×20cm开穴，穴深6-8cm，随挖随栽，每穴2-3株。根茎繁殖：结合收获，挖取根茎，将带芽的根茎切下，其余作药用，待切口晾干后，按行株距20cm×20cm开穴栽种，每穴栽一块，覆土压实。"}]},{"ID":"20240616083838-jykbg92","Type":"NodeParagraph","Properties":{"id":"20240616083838-jykbg92","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"田间管理 幼苗期勤除草松土，施稀人粪尿或硫酸铵1-2次5月施一次提苗肥，7-8月增施磷、钾肥，开沟环施，结合培土，以防倒伏：6-8月抽茎开花时，要摘除花蕾，促进根茎肥大；多雨季节要清理墒沟，排除田间积水，以免烂根。10月培土保苗越冬。"}]},{"ID":"20240616083838-s22g3lk","Type":"NodeParagraph","Properties":{"id":"20240616083838-s22g3lk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有根腐病，5、6月发病，要注意开沟排水，发展病株立即拔除，用退菌特50%可湿性粉剂1000倍液或1%石灰水落浇，赤可用50%托布津800倍液喷射。虫害有蚜虫为害叶片和嫩梢，尤以春夏季最为亚重，可用化学药剂，或用1：1：10烟草石灰水防治。另有小地老虎为害。"}]},{"ID":"20240616083838-tecq5oh","Type":"NodeParagraph","Properties":{"id":"20240616083838-tecq5oh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616083838-92ebmb9","Type":"NodeParagraph","Properties":{"id":"20240616083838-92ebmb9","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）茅苍术 根茎呈不规则结节状或略呈连珠状圆柱形，有的弯曲，通常一分枝，长3-10cm，直径1-2cm。表面黄棕色至灰棕色，有细纵汉、皱纹及少数残留须根，节处常有缢缩的浅横凹沟，节间有圆形茎痕，往往于一端有残留茎基，偶有茎痕，有的于表面析出白色絮状结晶。质坚实，易折断，断面稍不平，类白色或黄白色，散有多数橙黄色或棕红色油室（俗称朱砂点），暴露稍久，可析出白色细针状结晶。横断面于紫外光灯（254nm）下不显蓝色荧光。香气浓郁，味微甘而苦、辛。"}]},{"ID":"20240616083838-78ztqla","Type":"NodeParagraph","Properties":{"id":"20240616083838-78ztqla","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"（2）北苍术 根茎多呈疙瘩块状，有的呈结节状圆柱形，常弯曲并具短分枝，长4-10cm，直径0.7-4cm。表面黑棕色，外色油室，放置后不折出结晶。香气较弱，味苦辛。"}]},{"ID":"20240616083838-uou9nf0","Type":"NodeParagraph","Properties":{"id":"20240616083838-uou9nf0","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"（3）关苍术 根茎多呈结节状圆柱形，长4-12cm，直径1-2.5cm，表面深棕色。质较轻，折断面纤维性。气特异彩，味辛、微苦。"}]},{"ID":"20240616083838-zxfv6g3","Type":"NodeParagraph","Properties":{"id":"20240616083838-zxfv6g3","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"以质坚实、断面朱砂点多、香气浓者为佳。"}]},{"ID":"20240616083838-s7cghjc","Type":"NodeParagraph","Properties":{"id":"20240616083838-s7cghjc","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根茎横切面：（1）茅苍术 木栓层10-40列木栓细胞，其间夹有断续切向排列的石细胞带1-2条。皮层薄壁组织宽广，散有大形油室，长径260-945μm，短径210-650μm。外韧型维管束环列。形成层成环。木质部的木纤维束与导管群相同间排列。髓部较大。射线与髓部散有油室。薄壁细色荧光，北苍术显亮蓝色荧光。"}]},{"ID":"20240616083838-ehfsxg0","Type":"NodeParagraph","Properties":{"id":"20240616083838-ehfsxg0","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"（3）薄层色谱 茅苍术、北苍术、关苍术粉末各50-100g，用挥发油提取器提取挥发油。吸取一定量挥发同，用乙酸乙酯稀释成10%深液，作为供试品深液。另取苍术酮、苍术素、茅术醇及桉油醇的混合溶液作为对照品深液。取供试品深液和对照品溶液，分另点样于同一硅胶G（青岛）薄层板上。用苯-乙酸乙酯-已烷（15：15：70）展开，展距20cm。取出晾干。喷以含5%对二甲氨基苯甲西醛的10%硫酸深液显色：喷后再于100℃烘5min。供试品色谱在与对照品的相应位置上，显相同颜色的斑点。即喷显色剂后，苍术酮立刻显红色，烘后呈紫色；苍术素、茅术醇及桉油醇喷显色剂后不显色，烘后苍术素显绿色，而茅术醇及桉油醇显棕色。"}]},{"ID":"20240616083838-xzrpksz","Type":"NodeParagraph","Properties":{"id":"20240616083838-xzrpksz","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616083838-xh240fl","Type":"NodeParagraph","Properties":{"id":"20240616083838-xh240fl","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 1.茅苍术 根茎含挥发油3.25%-6.92%，内含2-蒈烯（2-carene），1，3，4，5，6，7-六氢-2，5，5-trimethyl-2H-2,4α桥亚乙基萘（1，3，4，5，6，7-hexahydro-2，5，5-trimethyl-2H-2,4α-ethanonaphthalene），β-橄槛烯（β-maalinene），花柏烯（chamigrene），丁香烯（caryophyllene），榄香烯（elemene），葎草烯（humulene），芹子烯（selinene），广藿香烯（patchoulene），1，9-马兜铃二烯（1，9-aristolodiene），愈创薁醇（guaiol），榄香醇（elemol），苍术酮（atractylone），芹子二烯酮[seli-na-4(14),7(11)-diene-8-one]，苍术呋喃烃（atractylodin），茅术醇（hinesol），β-桉叶醇（β-eudesmol）[1，2]等。根茎还含糠醛（furlade-hyde）[3]，乙酰氧基苍术酮（3β-acetoxyatractylone），3β-羟基苍术酮（3β-hydroxyatracetylone）[4]，白术内酯（butenoliede）B[5]等。又含色氨酸（tryptophane），3，5-二甲氧基-4-葡萄糖氧基苯基烯丙醇（3，5-dimethoxy-4-glucosyloxy phenylallylalcohol）以及2-（1,4α-二甲基-3-葡萄糖氧基-2-酮基-2，3，4，4α5，6，7，8-八氢萘-7-基）异丙醇葡萄糖甙[2-（1，4α-dimethyl-3-glucosyloy-2-oxo-2,3,4,4α5,6,7,8-octahydronaphthalen-7-yl）-isopropanolglucoside]，2-[8-甲基-2，8，9-三羟基-2-羟甲基双环[5。3。0]癸-7-基]异丙醇葡萄糖甙"}]},{"ID":"20240616083838-r6ef7f4","Type":"NodeParagraph","Properties":{"id":"20240616083838-r6ef7f4","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240616083838-r5r4w81","Type":"NodeParagraph","Properties":{"id":"20240616083838-r5r4w81","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 1.抗缺氧作用：用氰化钾所致小鼠缺氧模型证明，苍术丙酮提取物750mg／kg灌胃能明显提高小鼠存活时间，降低相对死亡率。苍术的抗缺氧主要活性成分为β-桉叶醇。"}]},{"ID":"20240616083838-z4rliew","Type":"NodeParagraph","Properties":{"id":"20240616083838-z4rliew","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.对消化道的作用：苍术所含挥发油有驱风健胃作用，所含苦味也有健胃、促进食欲的作用。实验证明苍术有明显的抗副交感神经介质乙酰胆碱引起的肠痉挛。对正常家兔离体小肠的自发运动，苍术使小肠张力降低。对交感神经介质肾上腺素引起的兔肠肌松弛，苍术制剂在振幅上能促进肾上腺素抑制作用的振幅恢复，此外，苍术也可通过对抗胆碱作用而对抗盐酸所致大鼠急性胃炎及幽门结扎所致大鼠胃溃疡；另苍术醇有促进胃肠运动作用，对胃平滑肌也有轻微收缩作用。"}]},{"ID":"20240616083838-09pecfj","Type":"NodeParagraph","Properties":{"id":"20240616083838-09pecfj","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.对心血管的作用：苍术对蟾蜍心脏有轻度抑制作用，对蟾蜍后肢血管有轻微扩张作用。苍术浸膏小剂量静脉注射，可使家兔血压轻度上升，大剂量则使血压下降。"}]},{"ID":"20240616083838-cl6k0mk","Type":"NodeParagraph","Properties":{"id":"20240616083838-cl6k0mk","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"4.中枢抑制作用：苍术挥发油少量对蛙有镇静作用，同时使脊髓反射亢进；较大量则呈抑制作用，终至呼吸麻痹而死。其抑制成分主要是β-桉叶醇和茅苍术醇。茅苍术及其所含β-桉叶醇还有抗电击所致小鼠痉挛作用。"}]},{"ID":"20240616083838-jvey6id","Type":"NodeParagraph","Properties":{"id":"20240616083838-jvey6id","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"5.对肝脏的影响：苍术水煎剂每天10g生药／kg连续给小鼠灌胃7天，能明显促进肝蛋白的合成。生药及其所含苍术醇、苍术酮、B-桉叶醇对四氯化碳诱发的一级培养鼠肝细胞损害均有显着的预防作用。"}]},{"ID":"20240616083838-ustn4rf","Type":"NodeParagraph","Properties":{"id":"20240616083838-ustn4rf","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"6.对血糖的影响：将苍术煎剂或醇浸剂8g／kg口服或皮下注射，使正常家兔血糖略有上升。用其煎剂10g/kg灌胃，亦得到同样效果；但用同剂量煎剂灌胃，对四氧嘧啶性糖尿病家兔则血糖略升后即下降到灌药的10天内，血糖不断下降，差别显着，停药7-14天，血糖未见上升到用药前水平。苍术甙对小鼠、大鼠、兔和大有降血糖作用，同时降低肌糖原和肝糖原，抑制糖原生成，使氧耗量降低，血乳酸含量增加，其降血糖作用可能与其对体内巴斯德效应（Pasteur effect）的抑制有关。它和腺嘌呤核甘酸在同一线粒体受点上起竞争性抑制作用，从而抑制细胞内氧化磷酸化作用，干扰能量的转移过程。"}]},{"ID":"20240616083838-dcjj51n","Type":"NodeParagraph","Properties":{"id":"20240616083838-dcjj51n","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"7.对泌尿系统的影响：大鼠试验证明，茅苍术煎剂灌胃，无利尿作用，但却显着增加钠和钾的排泄。"}]},{"ID":"20240616083838-sbc0u9q","Type":"NodeParagraph","Properties":{"id":"20240616083838-sbc0u9q","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"8.抑菌消毒作用：将制备好的苍术放入有盖的搪瓷容器中，加入95%酒精，剂量以淹没苍术为宜，浸泡8-10小时后，取出苍术，放在准备消毒的手术间地面上，点燃，直到苍术化为灰为止。结果消毒后比消毒前菌层数明显减少，消毒效果满意。"}]},{"ID":"20240616083838-qpe7c20","Type":"NodeParagraph","Properties":{"id":"20240616083838-qpe7c20","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240616083838-7u6g99u","Type":"NodeParagraph","Properties":{"id":"20240616083838-7u6g99u","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 1.苍术：拣去杂质，用水泡至七、八成透，捞出，润透后切片，晒干。"}]},{"ID":"20240616083838-mdy2akp","Type":"NodeParagraph","Properties":{"id":"20240616083838-mdy2akp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.炒苍术：取苍术片，用米泔水喷洒湿润，置锅内用文火炒至微黄色；或取拣净的苍术，用米泔水浸泡后捞出，置笼屉内加热蒸透，取出，切片，干燥即得。"}]},{"ID":"20240616083838-a4nwia1","Type":"NodeParagraph","Properties":{"id":"20240616083838-a4nwia1","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.炭制：取苍术片，用武火炒至表面焦黑，内枯黄存，喷水取出；晒干。"}]},{"ID":"20240616083838-njc6rj8","Type":"NodeParagraph","Properties":{"id":"20240616083838-njc6rj8","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"4.盐制：取苍术用大火炒至外皮焦黑色，加盐水，炒干取出。每苍术1斤，加盐5钱，水适量。"}]},{"ID":"20240616083838-35jnr5k","Type":"NodeParagraph","Properties":{"id":"20240616083838-35jnr5k","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"5.苍术性燥，故以糯米泔浸去其油，切片焙干用，亦有用脂麻同炒，以制其燥者。"}]},{"ID":"20240616083838-oe3e2pi","Type":"NodeParagraph","Properties":{"id":"20240616083838-oe3e2pi","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616083838-c02mna9","Type":"NodeParagraph","Properties":{"id":"20240616083838-c02mna9","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 归脾；胃；肝经"}]},{"ID":"20240616083838-fwz7r99","Type":"NodeParagraph","Properties":{"id":"20240616083838-fwz7r99","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616083838-6lhd8tu","Type":"NodeParagraph","Properties":{"id":"20240616083838-6lhd8tu","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性温"}]},{"ID":"20240616083838-6tpapaf","Type":"NodeParagraph","Properties":{"id":"20240616083838-6tpapaf","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240616083838-ii5tfrn","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240616083838-ii5tfrn","updated":"20240616083838"},"Children":[{"ID":"20240616083838-a97qv23","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240616083838-a97qv23","updated":"20240616083838"},"Children":[{"ID":"20240616083838-vunvbqn","Type":"NodeParagraph","Properties":{"id":"20240616083838-vunvbqn","updated":"20240616083838"}}]}]},{"ID":"20240616083838-4zkgk27","Type":"NodeParagraph","Properties":{"id":"20240616083838-4zkgk27","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：防风、地榆为之使。"}]},{"ID":"20240616083838-peqldvb","Type":"NodeParagraph","Properties":{"id":"20240616083838-peqldvb","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：忌桃、李、雀肉、菘菜、青鱼。"}]},{"ID":"20240616083838-e5sodp2","Type":"NodeParagraph","Properties":{"id":"20240616083838-e5sodp2","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"4.《医学入门》：血虚怯弱及七情气闷者慎用。误服耗气血，燥津液，虚火动而痞闷愈甚。"}]},{"ID":"20240616083838-hgzqid0","Type":"NodeParagraph","Properties":{"id":"20240616083838-hgzqid0","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"5.《本草经疏》：凡病属阴虚血少、精不足，内热骨蒸，口干唇燥，咳嗽吐痰、吐血，鼻衄，咽塞，便秘滞下者，法咸忌之。肝肾有动气者勿服。"}]},{"ID":"20240616083838-abt985k","Type":"NodeParagraph","Properties":{"id":"20240616083838-abt985k","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"6.《本草正》：内热阴虚，表疏汗出者忌服。"}]},{"ID":"20240616083838-vi6gyrp","Type":"NodeParagraph","Properties":{"id":"20240616083838-vi6gyrp","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616083838-ykw4vbg","Type":"NodeParagraph","Properties":{"id":"20240616083838-ykw4vbg","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 燥湿健脾；祛风湿；明目。主湿困脾胃；倦怠嗜卧；胞痞腹胀；食欲不振；哎吐泄泻；痰饮；湿肿；表证夹湿；头身重痛；痹证温性；肢节酸痛重着；痿襞；夜盲"}]},{"ID":"20240616083838-0iivofj","Type":"NodeParagraph","Properties":{"id":"20240616083838-0iivofj","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616083838-atz0evl","Type":"NodeParagraph","Properties":{"id":"20240616083838-atz0evl","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或入丸、散。"}]},{"ID":"20240616083838-irad7aj","Type":"NodeParagraph","Properties":{"id":"20240616083838-irad7aj","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240616083838-ybhpu3h","Type":"NodeParagraph","Properties":{"id":"20240616083838-ybhpu3h","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 1.苍术丸(《杂病源流犀烛·内伤外感门》)，治腹中虚冷，不能食。2.苍术导痰丸(《万氏妇科》)，治月经量少，经闭不孕，形体肥胖，痰多乏力。3.苍术难名丹(《世医得效方》)，治元阳气衰，脾精不禁，漏浊淋漓，腰痛力疲。4.苍术三黄散(《疡科全书》)，治一切淫毒。5.苍乌参苓散(《辨证录》)，治一时心痛，倏痛倏已，一日数发，饮食无碍，昼夜不安。6.苍白二陈汤(《证治汇补》)，治湿痰下注便浊。7.苍术白虎汤(《杂病源流犀烛·内伤外感门》)，治秋发寒疫，及湿温，便清，足肿难移。8.苍术除湿汤(《症因脉治》)，治太阳头痛。9.苍术芍药汤(《活法机要》)，治痢疾痛甚者。10.平胃散(《局方》)，治脾胃不和，不思饮食，心腹胁肋胀满刺痛，口苦无味，呕吐恶心，常多自利。11.神术散(《局方》)，治四时瘟疫，头痛项强，发热憎寒，身体疼痛，及伤风，鼻塞声重，咳嗽头晕等。12.二妙散(《丹溪心法》)，治筋骨疼痛因湿热者。"}]},{"ID":"20240616083838-pzu0l7l","Type":"NodeParagraph","Properties":{"id":"20240616083838-pzu0l7l","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240616083838-biapdiv","Type":"NodeParagraph","Properties":{"id":"20240616083838-biapdiv","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 1.陶弘景：除恶气。"}]},{"ID":"20240616083838-2oyvmll","Type":"NodeParagraph","Properties":{"id":"20240616083838-2oyvmll","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"2.刘完素：明目，暖水脏。"}]},{"ID":"20240616083838-3hmxdp7","Type":"NodeParagraph","Properties":{"id":"20240616083838-3hmxdp7","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"3.《珍珠囊》：能健胃安脾，诸湿肿非此不能除。"}]},{"ID":"20240616083838-fqvdq6v","Type":"NodeParagraph","Properties":{"id":"20240616083838-fqvdq6v","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"4.李杲：除湿发汗，健胃安脾，治痿要药。"}]},{"ID":"20240616083838-1e4vl3u","Type":"NodeParagraph","Properties":{"id":"20240616083838-1e4vl3u","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"5.散风益气，总解诸郁。"}]},{"ID":"20240616083838-0g8rqlh","Type":"NodeParagraph","Properties":{"id":"20240616083838-0g8rqlh","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"6.《本草纲目》：治湿痰留饮，或挟瘀血成窠囊，及脾湿下流，浊沥带下，滑泻肠风。"}]},{"ID":"20240616083838-ryxthf5","Type":"NodeParagraph","Properties":{"id":"20240616083838-ryxthf5","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"7.《玉楸药解》：燥土利水，泄饮消痰，行瘀，开郁，去漏，化癖，除症，理吞酸去腐，辟山川瘴疠，回筋骨之痿软，清溲溺之混浊。"}]},{"ID":"20240616083838-jwczoqf","Type":"NodeParagraph","Properties":{"id":"20240616083838-jwczoqf","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"8.《本草求原》：止水泻飨泄，伤食暑泻，脾湿下血。"}]},{"ID":"20240616083838-88wthph","Type":"NodeParagraph","Properties":{"id":"20240616083838-88wthph","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"9.《医学启源》：苍术，主治与白术同，若除上湿发汗，功最大，若补中焦除湿，力少。《主治秘要》云：其用与白术同，但比之白术，气重而体沉。及胫足湿肿，加白术泔浸刮去皮用。10.李杲：《本草》但言术，不分苍、白，而苍术别有雄壮上行之气，能除湿，下安太阴，使邪气不传入脾也。以其经泔浸火炒，故能出汗，与白术止汗特异，用者不可以此代彼，盖有止发之殊，其余主治则同。"}]},{"ID":"20240616083838-86msefm","Type":"NodeParagraph","Properties":{"id":"20240616083838-86msefm","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"11.《仁斋直指方》：脾精不禁，小便漏浊淋不止，腰背酸痛，宜用苍术以敛脾精，精生于谷故也。"}]},{"ID":"20240616083838-3k269ka","Type":"NodeParagraph","Properties":{"id":"20240616083838-3k269ka","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"12.朱震亨：苍术治湿，上、中、下皆有可用。又能总解诸郁，痰、火、湿、食、气、血六郁，皆因传化失常，不得升降，病在中焦，故药必兼升降，将欲开之，必先降之，将欲降之，必先升之，故苍术为足阳明经药，气味辛烈，强胃健脾，发谷之气，能径入诸药，疏泄阳明之湿，通行敛涩，香附乃阴中快气之药，下气最速，一升一降，故郁散而平。"}]},{"ID":"20240616083838-n4o82r0","Type":"NodeParagraph","Properties":{"id":"20240616083838-n4o82r0","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"13.《本草纲目》：张仲景辟一切恶气，用赤术同猪蹄甲烧烟，陶隐居亦言术能除恶气，弭灾诊，故今病疫及岁旦，人家往往烧苍术以辟邪气。"}]},{"ID":"20240616083838-k7ke490","Type":"NodeParagraph","Properties":{"id":"20240616083838-k7ke490","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"14.《本草通玄》：苍术，宽中发汗，其功胜于白术，补中除湿，其力不及白术。大抵卑监之土，宜与白术以培之，敦阜之土，宜与苍术以平之。"}]},{"ID":"20240616083838-gh6215t","Type":"NodeParagraph","Properties":{"id":"20240616083838-gh6215t","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"15.《本草正》：苍术，其性温散，故能发汗宽中，调胃进食，去心腹胀疼，霍乱呕吐，解诸郁结，逐山岚寒疫，散风眩头疼，消痰癖气块，水肿胀满。其性燥湿，故治冷痢冷泄滑泻，肠风，寒湿诸疮。与黄蘖同煎，最逐下焦湿热痿痹。然惟茅山者其质坚小，其味甘醇，补益功多，大胜他术。"}]},{"ID":"20240616083838-wkheu74","Type":"NodeParagraph","Properties":{"id":"20240616083838-wkheu74","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"16.《药品化义》：苍术，味辛主散，性温而燥，燥可去湿，专入脾胃，主治风寒湿痹，山岚瘴气，皮肤水肿，皆辛烈逐邪之功也。统治三部之湿，若湿在上焦，易生湿痰，以此燥湿行痰；湿在中焦，滞气作泻，以此宽中健脾；湿在下部，足膝痿软，以此同黄柏治痿，能令足膝有力；取其辛散气雄，用之散邪发汗，极其畅快。合六神散，通解春夏湿热病；佐柴葛解肌汤，表散疟疾初起；若热病汗下后，虚热不解，以此加入白虎汤，再解之，汗止身凉。缪仲淳用此一味为末、治脾虚蛊胀。"}]},{"ID":"20240616083838-7vemgnn","Type":"NodeParagraph","Properties":{"id":"20240616083838-7vemgnn","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"17.《玉楸药解》：白术守而不走，苍术走而不守，故白术善补，苍术善行。其消食纳谷，止呕住泄亦同白术，而泄水开郁，苍术独长。"}]},{"ID":"20240616083838-cmww6li","Type":"NodeParagraph","Properties":{"id":"20240616083838-cmww6li","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"18.《本草正义》：苍术，气味雄厚，较白术愈猛，能彻上彻下，燥湿而宣化痰饮，芳香辟秽，胜四时不正之气；故时疫之病多用之。最能驱除秽浊恶气，阴霆之域，久旷之屋，宜焚此物而后居人，亦此意也。凡湿困脾阳，倦怠嗜卧，肢体酸软，胸膈满闷，甚至膜胀而舌浊厚腻者，非茅术芳香猛烈，不能开泄，而痰饮弥漫，亦非此不化。夏秋之交，暑湿交蒸，湿温病寒热头胀如裹，或胸痞呕恶，皆须茅术、藿香、佩兰叶等香燥醒脾，其应如响。而脾家郁湿，或为膜胀，或为肿满，或为泻泄疟痢，或下流而足重跗肿，或积滞而二便不利，及湿热郁蒸，发为疮疡流注，或寒湿互结，发为阴疽酸痛，但有舌浊不渴见证，茅术一味，最为必需之品。是合内外各病，皆有大用者。"}]},{"ID":"20240616083838-1ykam93","Type":"NodeParagraph","Properties":{"id":"20240616083838-1ykam93","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616083838-999f6qd","Type":"NodeParagraph","Properties":{"id":"20240616083838-999f6qd","updated":"20240616083838"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240616083839-u30quuc","Type":"NodeThematicBreak","Properties":{"id":"20240616083839-u30quuc"}},{"ID":"20240616083840-fivtw41","Type":"NodeParagraph","Properties":{"id":"20240616083840-fivtw41"}}]}