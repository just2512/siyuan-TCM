erties":{"parent-style":"width: 634px;","style":"width: 624px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白术 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白术 5-20240801145617-4a0lizm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 624px;\" parent-style=\"width: 634px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白术 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白术 4-20240801145250-6pe40bj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240801153032-vhsod8q","Type":"NodeParagraph","Properties":{"id":"20240801153032-vhsod8q","updated":"20240801153032"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白术 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白术 8-20240801153032-y1l5qn4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801153031-9i2mpbr","Type":"NodeParagraph","Properties":{"id":"20240801153031-9i2mpbr","updated":"20240801153031"}},{"ID":"20240206081833-tq35eie","Type":"NodeParagraph","Properties":{"id":"20240206081833-tq35eie","updated":"20240206081839"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苍术"}]},{"ID":"20240206081954-k8ijnja","Type":"NodeParagraph","Properties":{"id":"20240206081954-k8ijnja","updated":"20240206082004"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产浙江、湖北、江苏、河南等地。\n【性状】\t呈不规则连珠状或结节状圆柱形，略弯曲，偶有分枝，长310cm，直径12cm。表面灰棕色，有皱纹、横曲纹及残留须根，顶端具茎痕或残留茎基。质坚实，断面黄白色或灰白色，散有多数橙黄色或棕红色油室，暴露稍久，可析出白色细针状结晶。气香特异，味微甘、辛、苦。\n【性味】\t苦、辛，温。\n【功效】\t燥湿健脾，祛风散寒，明目。用于脘腹胀满，泄泻水肿，脚气痿躄，风湿痹痛，风寒感冒，夜盲。"}]},{"ID":"20240206081951-lhzp48h","Type":"NodeParagraph","Properties":{"id":"20240206081951-lhzp48h","updated":"20240206081951"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206081951-g65al8d.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240206081835-hddq04m","Type":"NodeParagraph","Properties":{"id":"20240206081835-hddq04m","updated":"20240206081835"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍术"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍术-20240205161107-ayzqo13.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240618115603-mwji3ks","Type":"NodeParagraph","Properties":{"id":"20240618115603-mwji3ks","updated":"20240801142800"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 728px;","style":"width: 718px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240618115603-ledkjho.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 718px;\" parent-style=\"width: 728px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties