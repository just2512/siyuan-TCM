racket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五味子 4-20240807155152-d51zevu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 249px;\" parent-style=\"width: 259px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"北五味子5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/北五味子5-20240619152214-2lyee24.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 647px;","style":"width: 637px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五味子 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五味子 13-20240807160225-k0lljxv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 637px;\" parent-style=\"width: 647px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807160530-vyfvktt","Type":"NodeParagraph","Properties":{"id":"20240807160530-vyfvktt","updated":"20240807160640"},"Children":[{"Type":"NodeText","Data":"​"}]},{"ID":"20240619152218-0sg70n4","Type":"NodeParagraph","Properties":{"id":"20240619152218-0sg70n4"},"Children":[{"Type":"NodeText","Data":"​"}]},{"ID":"20240206101744-3wvm705","Type":"NodeParagraph","Properties":{"id":"20240206101744-3wvm705","updated":"20240206101747"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"南五味子"}]},{"ID":"20240206101755-wvhlbf6","Type":"NodeParagraph","Properties":{"id":"20240206101755-wvhlbf6","updated":"20240206101758"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产陕西、甘肃、河南等地。\n【性状】\t本品呈球形或扁球形，直径46mm。表面棕红色至暗棕色，干瘪，皱缩，果肉常紧贴种子上。种子12枚，肾形，表面棕黄色，有光泽，种皮薄而脆。果肉气微，味微酸。\n【性味】\t酸、甘，温。\n【功效】\t收敛固涩，益气生津，补肾宁心。用于久嗽虚喘，梦遗滑精，遗尿尿频，久泻不止，自汗，盗汗，津伤口渴，短气脉虚，内热消渴，心悸失眠。\n【炙品】\t醋南五味子：取净南五味子，照醋蒸法蒸至黑色。用时捣碎。表面棕黑色，干瘪，果肉常紧贴种子上，无黏性。种子表面棕色，无光泽。"}]},{"ID":"20240206101750-x5fu1xa","Type":"NodeParagraph","Properties":{"id":"20240206101750-x5fu1xa","updated":"20240206101750"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206101750-9wrbbdh.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807155238-qf0ns9c","Type":"NodeParagraph","Properties":{"id":"20240807155238-qf0ns9c","updated":"20240807160751"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 811px;","style":"width: 801px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五味子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五味子 10-20240807155633-lldbf9t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 801px;\" parent-style=\"width: 811px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 383px;","style":"width: 373px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"五味子 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/五味子 5-20240807155332-f8z1cgh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 373px;\" parent-style=\"width: 383px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807155616-ujgrzl4","Type":"NodeParagraph","Properties":{"id":"20240807155616-ujgrzl4","updated":"20240807160756"},"Children":[{"Type":"NodeText","Data