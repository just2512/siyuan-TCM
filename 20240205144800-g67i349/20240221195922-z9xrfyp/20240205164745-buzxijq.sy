x;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240821111454-qdw3143","Type":"NodeParagraph","Properties":{"id":"20240821111454-qdw3143","updated":"20240821111838"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 655px;","style":"width: 645px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山茱萸 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山茱萸 1-20240821111455-t2uvmng.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 645px;\" parent-style=\"width: 655px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 520px;","style":"width: 510px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山茱萸 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山茱萸 4-20240821111806-ed1hvnl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 510px;\" parent-style=\"width: 520px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821111552-9ucnwk0","Type":"NodeParagraph","Properties":{"id":"20240821111552-9ucnwk0","updated":"20240821112554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山茱萸7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山茱萸7-20240626103702-q7syg5s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 820px;","style":"width: 810px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山茱萸 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山茱萸 9-20240821112554-qnmggp8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 810px;\" parent-style=\"width: 820px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612101138-1x70tfn","Type":"NodeThematicBreak","Properties":{"id":"20240612101138-1x70tfn"}},{"ID":"20240612101148-vtf08w2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101148-vtf08w2","updated":"20240612101152"},"Children":[{"Type":"NodeText","Data":"山茱萸《神农本草经》"}]},{"ID":"20240612101148-dhh35f7","Type":"NodeParagraph","Properties":{"id":"20240612101148-dhh35f7","updated":"20240612101148"},"Children":[{"Type":"NodeText","Data":"味酸平。"}]},{"ID":"20240612101148-hf9xgcd","Type":"NodeParagraph","Properties":{"id":"20240612101148-hf9xgcd","updated":"20240612101148"},"Children":[{"Type":"NodeText","Data":"主心下邪气，寒热，温中，逐寒湿痹，去三虫。久服轻身。一名蜀枣。生山谷。"}]},{"ID":"20240612101148-o34bjcw","Type":"NodeParagraph","Properties":{"id":"20240612101148-o34bjcw","updated":"20240612101148"},"Children":[{"Type":"NodeText","Data":"《吴普》曰，山茱萸，一名鬾实，一名鼠矢，一名鸡足，神农黄帝雷公扁鹊酸无毒，岐伯辛，一经酸，或生冤句琅邪，或东海承县，叶如梅，有刺毛，二月，华如杏四月实如酸枣，赤，五月采实。（《御览》）"}]},{"ID":"20240612101148-orom2aq","Type":"NodeParagraph","Properties":{"id":"20240612101148-orom2aq","updated":"20240612101148"},"Children":[{"Type":"NodeText","Data":"《名医》曰，一名鸡足，一名鬾实，生汉中及琅邪冤句，东海承县，九月十月采实，阴干。"}]},{"ID":"20240612101156-hhtg86t","Type":"NodeThematicBreak","Properties":{"id":"20240612101156-hhtg86t"}},{"ID":"20240612101158-ai32ybr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101158-ai32ybr","updated":"20240612101203"},"Children":[{"Type":"NodeText","Data":"山茱萸《神农本草经赞》"}]},{"ID":"20240612101158-j4gziee","Type":"NodeParagraph","Properties":{"id":"20240612101158-j4gziee","updated":"20240612101158"},"Children":[{"Type":"NodeText","Data":"味酸平。主心下邪气。寒热温中。逐寒湿痹。去三虫。久服轻身。一名蜀枣。生山谷。"}]},{"ID":"20240612101158-h9sscwm","Type":"NodeParagraph","Properties":{"id":"20240612101158-h9sscwm","updated":"20240612101158"},"Children":[{"Type":"NodeText","Data":"名亦茱萸。性殊治疗。梅叶绿稠。杏枝红闹。棘同酸。荆桃袭貌。春气半含。雀酥同调。"}]},{"ID":"20240612101158-v8ccfr2","Type":"NodeParagraph","Properties":{"id":"20240612101158-v8ccfr2","updated":"20240612101158"},"Children":[{"Type":"NodeText","Data":"寇宗曰。山茱萸与吴茱萸甚不相类。治疗大不相同。未知何缘命名。孟子。其性与人殊。"}]},{"ID":"20240612101158-wk3zmve","Type":"NodeParagraph","Properties":{"id":"20240612101158-wk3zmve","updated":"20240612101158"},"Children":[{"Type":"NodeText","Data":"苏颂曰。叶如梅有刺。二月开花如杏。四月实如酸枣。薛能诗。辞林绿尚稠。遁斋闲览。"}]},{"ID":"20240612101158-avg0h7t","Type":"NodeParagraph","Properties":{"id":"20240612101158-avg0h7t","updated":"20240612101158"},"Children":[{"Type":"NodeText","Data":"张子野曰。得非红杏枝头闹尚书耶。尔雅注。荆桃今樱桃。李时珍曰。陶弘景注。山茱萸及樱桃皆言似胡颓子。凌冬不雕。即雀酥也。吴人呼为半含春。俨如山茱萸。酸涩亦同。"}]},{"ID":"20240612101208-juwx5bx","Type":"NodeThematicBreak","Properties":{"id":"20240612101208-juwx5bx"}},{"ID":"20240612101209-ewclvy8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101209-ewclvy8","updated":"20240612101214"},"Children":[{"Type":"NodeText","Data":"山茱萸《长沙药解》"}]},{"ID":"20240612101209-4jpgfwm","Type":"NodeParagraph","Properties":{"id":"20240612101209-4jpgfwm","updated":"20240612101209"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味酸平。主心下邪气，寒热，温中，逐寒湿痹，去三虫。久服轻身。一名蜀枣。生山谷。"}]},{"ID":"20240612101209-oj25atk","Type":"NodeParagraph","Properties":{"id":"20240612101209-oj25atk","updated":"20240612101209"},"Children":[{"Type":"NodeText","Data":"味酸，性涩，入足厥阴肝经。温乙木而止疏泄，敛精液而缩小便。"}]},{"ID":"20240612101209-vmnsy05","Type":"NodeParagraph","Properties":{"id":"20240612101209-vmnsy05","updated":"20240612101209"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"八味丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在地黄。"},{"Type":"NodeText","Data":"用之治男子消渴，小便反多，以其敛精液而止疏泄也。"}]},{"ID":"20240612101209-tw0tnxc","Type":"NodeParagraph","Properties":{"id":"20240612101209-tw0tnxc","updated":"20240612101209"},"Children":[{"Type":"NodeText","Data":"水主藏，木主泄，消渴之证，木能疏泄而水不能蛰藏，精尿俱下，阳根失敛。久而阳根败竭，则人死矣。山茱萸酸涩敛固，助壬癸蛰藏之令，收敛摄精液，以秘阳根，八味中之要药也。八味之利水，则桂枝、苓、泽之力，非山茱萸所司也。"}]},{"ID":"20240612101209-z33qh7a","Type":"NodeParagraph","Properties":{"id":"20240612101209-z33qh7a","updated":"20240612101209"},"Children":[{"Type":"NodeText","Data":"去核，酒蒸。"}]},{"ID":"20240612101138-5ux5gov","Type":"NodeThematicBreak","Properties":{"id":"20240612101138-5ux5gov"}},{"ID":"20240612101139-ajmptct","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101139-ajmptct","updated":"20240612101144"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草纲目》"}]},{"ID":"20240612101139-xnhxp4i","Type":"NodeParagraph","Properties":{"id":"20240612101139-xnhxp4i","updated":"20240612101139"},"Children":[{"Type":"NodeText","Data":"「释名」蜀酸枣、肉枣、鸡足、鼠矢。"}]},{"ID":"20240612101139-v11z90z","Type":"NodeParagraph","Properties":{"id":"20240612101139-v11z90z","updated":"20240612101139"},"Children":[{"Type":"NodeText","Data":"「气味」酸、平、无毒。"}]},{"ID":"20240612101139-nrgz45u","Type":"NodeParagraph","Properties":{"id":"20240612101139-nrgz45u","updated":"20240612101139"},"Children":[{"Type":"NodeText","Data":"「主治」温肝补肾，除一切风，止月经过多，治老人尿频。"}]},{"ID":"20240612101219-3nsukz5","Type":"NodeThematicBreak","Properties":{"id":"20240612101219-3nsukz5"}},{"ID":"20240612101221-y6l6ijt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101221-y6l6ijt","updated":"20240612101225"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草衍义》"}]},{"ID":"20240612101221-6gyclrq","Type":"NodeParagraph","Properties":{"id":"20240612101221-6gyclrq","updated":"20240612101221"},"Children":[{"Type":"NodeText","Data":"与吴茱萸甚不相类。山茱萸色红，大如枸杞子。吴茱萸如川椒，初结子时，其大小亦不过椒，色正青。得名则一，治疗又不同。未审当日何缘如此命名。然山茱萸补养肾脏，无一不宜。经与《注》所说备矣。"}]},{"ID":"20240612101806-9h8bw92","Type":"NodeThematicBreak","Properties":{"id":"20240612101806-9h8bw92"}},{"ID":"20240612101807-ptfk60n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101807-ptfk60n","updated":"20240612101813"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草图经》"}]},{"ID":"20240612101807-v3jyyqf","Type":"NodeParagraph","Properties":{"id":"20240612101807-v3jyyqf","updated":"20240612101810"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"山茱萸"},{"Type":"NodeText","Data":"，生汉中山谷及琅邪冤句东海承县，今海州亦有之。木高丈余，叶似榆，花白；子初熟未干，赤色，似胡颓子，有核；亦可啖，既干；皮甚薄；九月、十月采实，阴干。吴普云∶一名鼠矢，叶如梅有刺毛。二月花如杏，四月实如酸枣，赤，五月采实，与此小异也。旧说当合核为用。而《雷 炮炙论》云∶子一斤，去核取肉皮用，只秤成四两半。其核八棱者名雀儿苏，别是一物，不可用也。"}]},{"ID":"20240612101757-q83fhjn","Type":"NodeThematicBreak","Properties":{"id":"20240612101757-q83fhjn"}},{"ID":"20240612101758-u9y3iu2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101758-u9y3iu2","updated":"20240612101801"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草撮要》"}]},{"ID":"20240612101758-6f734kj","Type":"NodeParagraph","Properties":{"id":"20240612101758-6f734kj","updated":"20240612101758"},"Children":[{"Type":"NodeText","Data":"味酸．入足厥阴少阴经．功专助阳固阴．得熟地补肾虚．得五味摄精气．强阳不痿．小便不利者忌用．核滑精．用尤宜去．陈者良．恶防己、防风、桔梗．"}]},{"ID":"20240612101746-174kikv","Type":"NodeThematicBreak","Properties":{"id":"20240612101746-174kikv"}},{"ID":"20240612101747-hr1at60","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101747-hr1at60","updated":"20240612101752"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草求真》"}]},{"ID":"20240612101747-uc5v1pu","Type":"NodeParagraph","Properties":{"id":"20240612101747-uc5v1pu","updated":"20240612101747"},"Children":[{"Type":"NodeText","Data":"（灌木）温补肝肾涩精固气"}]},{"ID":"20240612101747-kl4uoid","Type":"NodeParagraph","Properties":{"id":"20240612101747-kl4uoid","updated":"20240612101747"},"Children":[{"Type":"NodeText","Data":"山茱萸（专入肝肾）。味酸性温而涩。何书载缩小便。秘精气。以其味酸（酸主收。）性涩。（涩固脱。）得此则精与气不滑。又云。能暖腰膝及风寒湿痹。（肝虚则风入。肝寒则寒与湿易犯。）鼻塞目黄。（肝虚邪客则目黄。）以其气温克补。得此能入肝肾二经气分者故耳。（冯兆张曰。温暖之剂。方有益于元阳。故四时之令。春生而秋杀也。万物之性。喜暖而恶寒。肝肾居至阴之地。非阳和之气。则阴何以生乎？山茱正入二经。气温而主补。味酸而主敛。故精气益而腰膝强也。）且涩本属收闭。何书载使九窍皆通。耳鸣耳聋皆治。亦是因其精气充足。则九窍自利。又曷为涩而不通乎？（好古曰。滑则气脱。涩剂所以收之。仲景八味丸用之为君。其性可知矣。绣按别录甄权皆云服能发汗。多是服此精气足而汗自发之意。亦非误文。但令后人费解耳。）去核用。恶桔梗防风防己。"}]},{"ID":"20240612100604-b0t9z5t","Type":"NodeThematicBreak","Properties":{"id":"20240612100604-b0t9z5t"}},{"ID":"20240612101119-r2aivgc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101119-r2aivgc","updated":"20240612101124"},"Children":[{"Type":"NodeText","Data":"山茱萸《本经逢原》"}]},{"ID":"20240612101119-w7bd9a4","Type":"NodeParagraph","Properties":{"id":"20240612101119-w7bd9a4","updated":"20240612101119"},"Children":[{"Type":"NodeText","Data":"酸温无毒。去核微焙用，核能泄精。"}]},{"ID":"20240612101119-7qu253v","Type":"NodeParagraph","Properties":{"id":"20240612101119-7qu253v","updated":"20240612101119"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"滑则气脱，涩以收之。山茱萸止小便利，秘精气，取其酸涩以收滑也。甄权治脑骨痛，疗耳鸣，补肾气，兴阳道，坚阴茎，添精髓，止老人尿不节，治面上疮，能发汗，止月水不定。详能发汗，当是能敛汗之误。以其酸收无发越之理，仲景八味丸用之。盖肾气受益，则风藏有度，肝阴得养则疏泄无虞，乙癸同源也。命门火旺，赤浊淋痛及小便不利者禁服。《本经》食茱萸主治从古，误列山茱萸条内，今移入彼，庶不失先圣立言本旨，具眼者辨诸。"}]},{"ID":"20240612100604-uyrn66f","Type":"NodeThematicBreak","Properties":{"id":"20240612100604-uyrn66f"}},{"ID":"20240612100626-2dvhobq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100626-2dvhobq","updated":"20240612100630"},"Children":[{"Type":"NodeText","Data":"山茱萸《汤液本草》"}]},{"ID":"20240612100626-occw99y","Type":"NodeParagraph","Properties":{"id":"20240612100626-occw99y","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"气平微温，味酸。无毒。"}]},{"ID":"20240612100626-uyb78mm","Type":"NodeParagraph","Properties":{"id":"20240612100626-uyb78mm","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"入足厥阴经、少阴经。"}]},{"ID":"20240612100626-qpo0cqn","Type":"NodeParagraph","Properties":{"id":"20240612100626-qpo0cqn","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主温中，逐寒湿痹，强阴益精，通九窍，止小便。入足少阴、厥阴。"}]},{"ID":"20240612100626-3nlq0ls","Type":"NodeParagraph","Properties":{"id":"20240612100626-3nlq0ls","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《圣济经》云∶滑则气脱，涩剂所以收之，山茱萸之涩以收其滑。仲景八味丸用为君主，如何涩剂以通九窍。"}]},{"ID":"20240612100626-ex4mqvz","Type":"NodeParagraph","Properties":{"id":"20240612100626-ex4mqvz","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《雷公》云∶用之去核，一斤取肉四两，缓火熬用，能壮元气，秘精。核，能滑精，故去之。"}]},{"ID":"20240612100626-79wf7tm","Type":"NodeParagraph","Properties":{"id":"20240612100626-79wf7tm","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《珍》云∶温肝。"}]},{"ID":"20240612100626-s4x2izx","Type":"NodeParagraph","Properties":{"id":"20240612100626-s4x2izx","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《本经》云∶止小便利，以其味酸也。观八味丸用为君主，其性味可知矣。"}]},{"ID":"20240612100626-ajktlql","Type":"NodeParagraph","Properties":{"id":"20240612100626-ajktlql","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《药性论》亦云∶补肾添精。"}]},{"ID":"20240612100626-ifqb52t","Type":"NodeParagraph","Properties":{"id":"20240612100626-ifqb52t","updated":"20240612100626"},"Children":[{"Type":"NodeText","Data":"《日华子》亦云∶暖腰膝，助水脏也。"}]},{"ID":"20240612100604-ou5pdk5","Type":"NodeThematicBreak","Properties":{"id":"20240612100604-ou5pdk5"}},{"ID":"20240612100616-6s8zfrm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100616-6s8zfrm","updated":"20240612100620"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草择要纲目》"}]},{"ID":"20240612100616-a9udh6m","Type":"NodeParagraph","Properties":{"id":"20240612100616-a9udh6m","updated":"20240612100616"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612100616-y3inq0i","Type":"NodeParagraph","Properties":{"id":"20240612100616-y3inq0i","updated":"20240612100616"},"Children":[{"Type":"NodeText","Data":"酸涩无毒．阴中之阴．入足厥阴少阴经气分．"}]},{"ID":"20240612100616-sbttcpv","Type":"NodeParagraph","Properties":{"id":"20240612100616-sbttcpv","updated":"20240612100616"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240612100616-2qay1ao","Type":"NodeParagraph","Properties":{"id":"20240612100616-2qay1ao","updated":"20240612100616"},"Children":[{"Type":"NodeText","Data":"温中．逐寒湿痹．强阴益精．疗耳鸣．补肾虚．兴阳道．添精髓．止老人尿不节．暖腰膝．助水脏．逐一切气．破症结温肝．仲景八味丸用之．取其味酸涩．可以秘精而收滑也．"}]},{"ID":"20240612100739-o7swgrb","Type":"NodeThematicBreak","Properties":{"id":"20240612100739-o7swgrb"}},{"ID":"20240612100740-7il0wvr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100740-7il0wvr","updated":"20240612100748"},"Children":[{"Type":"NodeText","Data":"山茱萸《医学入门》"}]},{"ID":"20240612100740-6x2ey9f","Type":"NodeParagraph","Properties":{"id":"20240612100740-6x2ey9f","updated":"20240612100740"},"Children":[{"Type":"NodeText","Data":"山茱萸酸涩微湿，补肾强阴固精无，去头面风除疝瘕，逐痹调经益肝源。"}]},{"ID":"20240612100740-qjcrix0","Type":"NodeParagraph","Properties":{"id":"20240612100740-qjcrix0","updated":"20240612100740"},"Children":[{"Type":"NodeText","Data":"生山中。茱，言色红；萸，肥润也。无毒。补肾气，兴阳道，坚长阴茎，添精髓，止遗精及小便利，去头风骨痛，风气去来，鼻塞鼻 ，目黄，耳鸣耳聋，面 面疮，肠胃风邪亦验。又除疝瘕，逐寒湿痹，治女子月水不定。本草云∶发汗通九窍，去心下寒热邪气。本涩剂也，何以能通发耶？盖诸病皆系下部虚寒，用之补养肝肾，以益其源，则五脏安和，闭者通而利者止，非若他药轻飘疏通之谓也。酒浸去核，每一斤取皮肉四两，慢火焙干。核能滑精，故去之。蓼实为使。恶桔梗、防风、防己。"}]},{"ID":"20240612100956-qxxwgb7","Type":"NodeThematicBreak","Properties":{"id":"20240612100956-qxxwgb7"}},{"ID":"20240612100957-0cauqu4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100957-0cauqu4","updated":"20240612101001"},"Children":[{"Type":"NodeText","Data":"山茱萸《新修本草》"}]},{"ID":"20240612100957-u5142u9","Type":"NodeParagraph","Properties":{"id":"20240612100957-u5142u9","updated":"20240612100957"},"Children":[{"Type":"NodeText","Data":"味酸，平、微温，无毒。主心下邪气，寒热，温中，逐寒湿痹，去三虫，肠胃风邪，寒热，疝瘕，头脑风，风气去来，鼻塞，目黄，耳聋，面 ，温中，下气，出汗，强阴，益精，安利。久服轻身，明目，强力，长年。一名蜀枣，一名鸡足，一名思益，一名 实。生汉中山谷及琅 、宛朐、东海承县。"}]},{"ID":"20240612100957-24tf8ya","Type":"NodeParagraph","Properties":{"id":"20240612100957-24tf8ya","updated":"20240612100957"},"Children":[{"Type":"NodeText","Data":"九月、十月采实，阴干。"}]},{"ID":"20240612100957-i15zowm","Type":"NodeParagraph","Properties":{"id":"20240612100957-i15zowm","updated":"20240612100957"},"Children":[{"Type":"NodeText","Data":"蓼实为之使，恶桔梗、防风、防己。今出近道诸山中大树，子初熟未干，赤色，如胡颓子，亦可啖。既干后，皮甚薄，当合核为用也。"}]},{"ID":"20240612100933-1upmbv5","Type":"NodeThematicBreak","Properties":{"id":"20240612100933-1upmbv5"}},{"ID":"20240612100934-wlc98l5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100934-wlc98l5","updated":"20240612100939"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草经解》"}]},{"ID":"20240612100934-nvzbkvg","Type":"NodeParagraph","Properties":{"id":"20240612100934-nvzbkvg","updated":"20240612100934"},"Children":[{"Type":"NodeText","Data":"气平．味酸．无毒．主心下邪气寒热．温中．逐寒湿痹．去三虫．久服轻身．（去核）"}]},{"ID":"20240612100934-6txe8h4","Type":"NodeParagraph","Properties":{"id":"20240612100934-6txe8h4","updated":"20240612100934"},"Children":[{"Type":"NodeText","Data":"山萸气平．禀天秋成之金气．入手太阴肺经．味酸无毒．得地东方之木味．入足厥阴肝经．气味俱降．阴也．心下脾之分也．脾之邪．肝木之邪也．肝木血少气亢．则克脾土．并于阳则热．并于阴则寒矣．山萸味酸入肝．益肝血而敛肝气．则心下之寒热自除也．山萸味酸收敛．敛火归于下焦．火在下谓之少火．少火生气．所以温中．山萸气平益肺．肺主皮毛而司水道．水道通调．则皮毛疏理．而寒湿之痹瘳矣．三虫者湿热所化也．湿热从水道下行．则虫亦去也．久服味过于酸．肝气以津．肝者敢也．生气生血之脏也．所以身轻也．"}]},{"ID":"20240612100934-xmew6ci","Type":"NodeParagraph","Properties":{"id":"20240612100934-xmew6ci","updated":"20240612100934"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612100934-4jbv0nf","Type":"NodeParagraph","Properties":{"id":"20240612100934-4jbv0nf","updated":"20240612100934"},"Children":[{"Type":"NodeText","Data":"山萸同人参、五味、牡蛎、益智．治老人小便淋沥及遗尿．同菖蒲、甘菊、生地、黄柏、五味．治肾虚耳聋．同杜仲、牛膝、生地、白胶、山药．治肾虚腰痛．同生地、山药、丹皮、白茯、泽泻、柴胡、白芍、归身、五味．名滋肾清肝饮．治水枯木亢之症．同杜仲．治肝肾俱虚．"}]},{"ID":"20240612100808-jz4qv0g","Type":"NodeThematicBreak","Properties":{"id":"20240612100808-jz4qv0g"}},{"ID":"20240612100809-lg0wvey","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100809-lg0wvey","updated":"20240612100813"},"Children":[{"Type":"NodeText","Data":"山茱萸《神农本草经读》"}]},{"ID":"20240612100809-3jfu38q","Type":"NodeParagraph","Properties":{"id":"20240612100809-3jfu38q","updated":"20240612100809"},"Children":[{"Type":"NodeText","Data":"气味酸、平，无毒。主心下邪气，寒热，温中，逐寒湿痹，去三虫，久服轻身。（去核）。"}]},{"ID":"20240612100809-12pdopl","Type":"NodeParagraph","Properties":{"id":"20240612100809-12pdopl","updated":"20240612100809"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶山茱萸色紫赤而味酸平，禀厥阴、少阳木火之气化。手厥阴心包、足厥阴肝，皆属于风木也；手少阳三焦、足少阳胆，皆属于相火也。心下巨阙穴，乃手阙阴心包之募，又心下为脾之分。曰邪气者，脾之邪实为肝木之邪也。足厥阴肝木，血少气亢则克脾土，并于阳则热，并于阴则寒也。又寒热往来，为少阳之病，山萸禀木火之气化，故咸主之。山萸味酸收敛，敛火归于下焦，火在下谓之少火，少火生气，所以温中。山萸味酸入肝，肝主藏血，血能充肤热肉，所以逐周身寒湿之痹。三虫者，厥阴风木之化也；仲景乌梅丸之酸，能治蛔厥，即此物悟出。肝者，敢也，生气生血之脏也。孙真人生脉散中，有五味之酸，能治倦怠而轻身，亦从此物悟出。"}]},{"ID":"20240612100809-l3j4ju2","Type":"NodeParagraph","Properties":{"id":"20240612100809-l3j4ju2","updated":"20240612100809"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶仲祖八味丸，用山茱萸，后人去附、桂改为六味丸，以山茱萸为固精补肾水之药，此外并无他用，皆因安于苟简，不深讨故也。今详观《本经》，山茱萸之功能如此，学人能于《本经》之内会悟而广其用，庶无拘隘之弊。"}]},{"ID":"20240612100754-mca7u3k","Type":"NodeThematicBreak","Properties":{"id":"20240612100754-mca7u3k"}},{"ID":"20240612100755-zf5e1fg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100755-zf5e1fg","updated":"20240612100759"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草从新》"}]},{"ID":"20240612100755-njiptdu","Type":"NodeParagraph","Properties":{"id":"20240612100755-njiptdu","updated":"20240612100755"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补肝肾、涩精气．"}]},{"ID":"20240612100755-om4m43f","Type":"NodeParagraph","Properties":{"id":"20240612100755-om4m43f","updated":"20240612100755"},"Children":[{"Type":"NodeText","Data":"酸涩微温．固精秘气．补肾温肝．强阴助阳．安五脏．通九窍．（圣济总录云∶如何涩剂以通九窍、经疏云∶精气充则九窍通利、 庵曰∶山萸通九窍、古今疑之、得经疏一言而意旨豁然、始叹前人识见深远、不易测识、多有如此类者、即经疏一语而扩充之、实可发医人之慧悟也．）能发汗．（与通窍同义、汗属阴、阴血干枯、汗从何来、唯补阴助阴、始有云蒸雨致之妙、 庵曰∶酸剂敛涩、何以反发、恐属误文、何其明于彼而昧于此也．）暖腰膝．"}]},{"ID":"20240612100755-fd4yh4d","Type":"NodeParagraph","Properties":{"id":"20240612100755-fd4yh4d","updated":"20240612100755"},"Children":[{"Type":"NodeText","Data":"缩小便．治风寒湿痹．（温肝故能逐风．）鼻塞目黄．（肝虚邪客则目黄．）耳鸣耳聋．（肾虚则耳鸣耳聋、皆固精通窍之功、好古曰∶滑则气脱、涩剂所以收之、士材曰∶酸属东方、而功多在北方者、乙癸同源也．）月事过多．强阳不痿．小便不利者．不宜用．去核．（核能滑精．）陈久者良．恶防己、防风、桔梗．"}]},{"ID":"20240612100702-oneu9z5","Type":"NodeThematicBreak","Properties":{"id":"20240612100702-oneu9z5"}},{"ID":"20240612100703-rwoj5r9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100703-rwoj5r9","updated":"20240612100709"},"Children":[{"Type":"NodeText","Data":"山茱萸《证类本草》"}]},{"ID":"20240612100703-6z67jny","Type":"NodeParagraph","Properties":{"id":"20240612100703-6z67jny","updated":"20240612100703"},"Children":[{"Type":"NodeText","Data":"味酸，平、微温，无毒。主心下邪气，寒热，温中，逐寒湿痹，去三虫，肠胃风邪，寒热疝瘕，头风，风气去来，鼻塞，目黄，耳聋，面 ，温中下气，出汗，强阴益精，安通九窍，止小便利。久服轻身，明目，强力长年。一名蜀枣，一名鸡足，一名 （音妓）实。生汉中山谷及琅邪、冤句、东海承县。九月、十月采实，阴干。（蓼实为之使，恶桔梗、防风、防己。）"}]},{"ID":"20240612100703-o4ovni1","Type":"NodeParagraph","Properties":{"id":"20240612100703-o4ovni1","updated":"20240612100703"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶出近道诸山中大树。子初熟未干，赤色，如胡 子，亦可啖；既干，皮甚薄，当以合核为有尔。臣禹锡等谨按药性论云∶山茱萸，使，味咸、辛，大热。治脑骨痛，止月水不定，补肾气，兴阳道，坚长阴茎，添精髓，疗耳鸣，除面上疮，主能发汗，止老人尿不节。日华子云∶暖腰膝，助水脏，除一切风，逐一切气，破症结，治酒渣。陈藏器云∶胡子，熟赤，酢涩。小儿食之当果子。止水痢，生平林间，树高丈余，叶阴白，冬不凋，冬花春熟，最早诸果。茎及叶煮汁饲狗，主 。又有一种大相似，冬凋春实夏熟，人呼为木半夏，无别功。根，平，无毒。根皮煎汤，洗恶疮疥并马 疮。"}]},{"ID":"20240612100703-5oyp204","Type":"NodeParagraph","Properties":{"id":"20240612100703-5oyp204","updated":"20240612100703"},"Children":[{"Type":"NodeText","Data":"图经曰∶山茱萸，生汉中山谷及琅邪、冤句、东海承县，今海州亦有之。木高丈余，叶似榆，花白。子初熟未干，赤色，似胡 子，有核，亦可啖；既干，皮甚薄。九月、十月采实，阴干。吴普云∶一名鼠矢。叶如梅，有刺毛。二月花如杏。四月实如酸枣，赤。五月采实。与此小异也。旧说当合核为用。而雷 《炮炙论》云∶子一斤去核，取肉皮用，只秤成四两半，其核八棱者名雀儿苏，别是一物，不可用也。"}]},{"ID":"20240612100703-khk0lut","Type":"NodeParagraph","Properties":{"id":"20240612100703-khk0lut","updated":"20240612100703"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用雀儿苏，真似山茱萸，只是核八棱，不入药用。使山茱萸，须去内核。每修事去核了，一斤取肉皮用，只秤成四两以来，缓火熬之方∶用。能壮元气，秘精。"}]},{"ID":"20240612100703-118x9mm","Type":"NodeParagraph","Properties":{"id":"20240612100703-118x9mm","updated":"20240612100703"},"Children":[{"Type":"NodeText","Data":"核能滑精。"}]},{"ID":"20240612100703-mzdhe13","Type":"NodeParagraph","Properties":{"id":"20240612100703-mzdhe13","updated":"20240612100703"},"Children":[{"Type":"NodeText","Data":"衍义曰∶山茱萸，与吴茱萸甚不相类。山茱萸色红，大如枸杞子。吴茱萸如川椒，初结子时，其大小亦不过椒，色正青。得名则一，治疗又不同，未审当日何缘如此命名。然山茱萸补养肾脏，无一不宜。《经》与《注》所说备矣。"}]},{"ID":"20240612100650-k1g0hk4","Type":"NodeThematicBreak","Properties":{"id":"20240612100650-k1g0hk4"}},{"ID":"20240612100651-rq7qwbd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100651-rq7qwbd","updated":"20240612100656"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草崇原》"}]},{"ID":"20240612100651-zc78ee7","Type":"NodeParagraph","Properties":{"id":"20240612100651-zc78ee7","updated":"20240612100651"},"Children":[{"Type":"NodeText","Data":"气味酸平，无毒。主治心下邪气寒热，温中，逐寒湿痹，去三虫，久服轻身。"}]},{"ID":"20240612100651-tx5q8ob","Type":"NodeParagraph","Properties":{"id":"20240612100651-tx5q8ob","updated":"20240612100651"},"Children":[{"Type":"NodeText","Data":"（山茱萸今海州，兖州，江浙近道诸山中皆有。木高丈余，叶似榆有刺，二月开花白色，四月结实如酸枣，色紫赤，九月十日采实，阴干去核用肉。）"}]},{"ID":"20240612100651-ltveo3u","Type":"NodeParagraph","Properties":{"id":"20240612100651-ltveo3u","updated":"20240612100651"},"Children":[{"Type":"NodeText","Data":"山茱萸色紫赤而味酸平，禀厥阴少阳木火之气化。手厥阴属心包，故主治心下之邪气寒热。"}]},{"ID":"20240612100651-ifepaon","Type":"NodeParagraph","Properties":{"id":"20240612100651-ifepaon","updated":"20240612100651"},"Children":[{"Type":"NodeText","Data":"心下乃厥阴心包之部也。手少阳属三焦，故温中。中，中焦也。中焦取汁，奉心化赤而为血，血生于心，藏于肝。足厥阴肝主之血，充肤热肉，故逐周身之寒湿痹。木火气盛，则三焦通畅，故去三虫。血充肌腠，故久服轻身。"}]},{"ID":"20240612100651-flspn2e","Type":"NodeParagraph","Properties":{"id":"20240612100651-flspn2e","updated":"20240612100651"},"Children":[{"Type":"NodeText","Data":"愚按∶仲祖八味丸用山茱萸，后人去桂附，改为六味丸，以山茱萸为固精补肾之药。此外并无他用，皆因安于苟简，不深探讨故也。今详观《本经》山茱萸之功能主治如此，学人能于《本经》之内会悟，而广其用，庶无拘隘之弊。"}]},{"ID":"20240612100605-xoc6uxh","Type":"NodeThematicBreak","Properties":{"id":"20240612100605-xoc6uxh"}},{"ID":"20240612100606-kudgfdg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100606-kudgfdg","updated":"20240612100611"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草便读》"}]},{"ID":"20240612100606-9x8qzcu","Type":"NodeParagraph","Properties":{"id":"20240612100606-9x8qzcu","updated":"20240612100606"},"Children":[{"Type":"NodeText","Data":"性敛偏温．固精补肾．味酸而涩．壮水生肝．（山茱萸酸温无毒．入肝肾．肝主疏泄．肾主闭藏．疏泄太过．则滑脱不禁．当用酸涩之剂以收之．况遗精便滑．小便不固．以及虚汗等证属虚者哉．使元气固则精血充．是以为之补也．此物如五味之酸味太甚．于人之气血不甚相宜．虽虚脱者亦宜酌用．有邪火为患者．尤当禁之．）"}]},{"ID":"20240612100446-8lru5cb","Type":"NodeThematicBreak","Properties":{"id":"20240612100446-8lru5cb"}},{"ID":"20240612100554-777g8r0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100554-777g8r0","updated":"20240612100559"},"Children":[{"Type":"NodeText","Data":"山茱萸《得配本草》"}]},{"ID":"20240612100554-sdv6cnn","Type":"NodeParagraph","Properties":{"id":"20240612100554-sdv6cnn","updated":"20240612100554"},"Children":[{"Type":"NodeText","Data":"蓼实为之使。恶桔梗、防风、防己。"}]},{"ID":"20240612100554-b06t08n","Type":"NodeParagraph","Properties":{"id":"20240612100554-b06t08n","updated":"20240612100554"},"Children":[{"Type":"NodeText","Data":"酸，温。入足厥阴、少阴经血分。收少阳之火，滋厥阴之液，补肾温肝，固精秘气。暖腰膝，缩小便，敛内风，涩阴汗，除面 ，止遗泄。"}]},{"ID":"20240612100554-p07f563","Type":"NodeParagraph","Properties":{"id":"20240612100554-p07f563","updated":"20240612100554"},"Children":[{"Type":"NodeText","Data":"去核酒蒸，带核则滑精。命门火盛，（服之助火精遗。）阴虚血热，肝强脾弱，（木克土则泻。）小便不利，四者禁用。"}]},{"ID":"20240612100554-233o683","Type":"NodeThematicBreak","Properties":{"id":"20240612100554-233o683"}},{"ID":"20240612100636-bzuzjgw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612100636-bzuzjgw","updated":"20240612100643"},"Children":[{"Type":"NodeText","Data":"山茱萸《本草新编》"}]},{"ID":"20240612100636-qdvhjyt","Type":"NodeParagraph","Properties":{"id":"20240612100636-qdvhjyt","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"山茱萸，味酸涩，气平、微温，无毒。入肾、肝二经。温肝经之血，补肾脏之精，兴阳道以长阴茎，暖腰膝而助阳气，经候可调，小便能缩，通水窍，去三虫，强力延年，轻身明目。"}]},{"ID":"20240612100636-ds9hw4x","Type":"NodeParagraph","Properties":{"id":"20240612100636-ds9hw4x","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"其核勿用，用则滑精难收，实益阴之圣丹、补髓之神药。仲景夫子所以采入于八味丸中，取其固精而生水也。《本经》谓其九窍堪通，而世人疑之者，以其味过于涩，则窍闭而不能开，恐难以通之也。予以为不然。夫人五脏安，则九窍自利，而五脏之内，一脏不安，则四脏因之不安矣。所谓一脏者何？即肾脏也。肾为四脏之本，肾安而四脏俱安。安四脏而利九窍，又何疑乎。山茱萸佐八味以补肾，正安肾以安五脏之药也。五脏既安，而谓九窍之不能利乎。且山茱萸不止利九窍也。三焦六腑，无不藉其庇荫，受其滋益。此八味汤中之所必用，而岐伯天师新立补肾诸方，无不用之以救垂绝之症也。"}]},{"ID":"20240612100636-pu5b8rc","Type":"NodeParagraph","Properties":{"id":"20240612100636-pu5b8rc","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或问山茱萸入六味丸中，不过佐熟地之生精耳，先生谓其能利九窍，毋乃夸乎？非夸也。"}]},{"ID":"20240612100636-s980ivn","Type":"NodeParagraph","Properties":{"id":"20240612100636-s980ivn","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"熟地得山茱萸，则功始大；山茱萸得熟地，则其益始弘。盖两相须而两相成也。有此二品，则生精而人生。无此二品，则不能生精而人死。山茱萸关人之死生，岂特利九窍而已哉。"}]},{"ID":"20240612100636-v4kqb68","Type":"NodeParagraph","Properties":{"id":"20240612100636-v4kqb68","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或问补阴之药甚多，何必用山茱萸以佐熟地乎？曰∶补阴之药，未有不偏胜者也。独山茱萸大补肝肾，性专而不杂，既无寒热之偏，又无阴阳之背，实为诸补阴之冠。此仲景夫子所以采入于六味丸中，以为救命之药也。"}]},{"ID":"20240612100636-da26ck8","Type":"NodeParagraph","Properties":{"id":"20240612100636-da26ck8","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或问山茱萸为救命之药，所救者何病乎？吁！天下之死于病者，半好色之徒也。好色者，泄精必多，精泄则髓空，精泄则神散。非用九味地黄汤，以大填补其精，则髓空者何以再满而能步履，神散者何以再返而能掺哉。虽六味丸中之功效，不止山茱萸之一味，然舍山茱萸之佐熟地，又何生精之速，添髓而益神乎。所谓救命之药，真非虚语耳。"}]},{"ID":"20240612100636-iito0zl","Type":"NodeParagraph","Properties":{"id":"20240612100636-iito0zl","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或问六味丸之妙义，已将各药阐发无遗，不知山茱萸亦可再为宣扬乎？曰∶山茱萸乃六味丸中之臣药也，其功必大中诸药，是以仲景公用之耳。山茱萸补肾中之水，而又有涩精之妙，精涩则气不走而水愈生，更使利者不至于全利，而泻者不至于全泻也。虽六味丸中如茯苓、泽泻，亦非利泻之药，然补中有利泻之功，未必利泻无补益之失。得山茱萸之涩精，则所泻所利，去肾中之邪，而不损肾中之正，故能佐熟地、山药，以济其填精增髓之神功也。"}]},{"ID":"20240612100636-3c12k3l","Type":"NodeParagraph","Properties":{"id":"20240612100636-3c12k3l","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或又问子既阐山茱萸用于八味丸中者，非仅补水以制火，实补水以养火也。肾中之火，非水不能生，亦非水不能养。火生于水之中，则火不绝。火养于水之内，则火不飞。山茱萸补而且涩，补精则精盛而水增，涩精则精闭而水静，自然火生而无寒弱之虞，火养而无炎腾之祸，助熟地、山药而成既济之功，辅附子、肉桂而无亢阳之失矣。"}]},{"ID":"20240612100636-yv4xa4s","Type":"NodeParagraph","Properties":{"id":"20240612100636-yv4xa4s","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或问山茱萸用于六味、八味，妙义如此，未知舍二方之外，亦可独用以出奇乎？曰∶人有五更泄泻，用山茱萸二两为末，米饭为丸，临睡之时一次服尽，即用饭压之，戒饮酒、行房三日，而泄泻自愈。盖五更泄泻，乃肾气之虚，则水不行于膀胱，而尽入于大肠矣。五更亥子之时也，正肾水主事，肾气行于此时，则肾不能司其权而泻作。山茱萸补肾水，而性又兼涩，一物二用而成功也，非单用之以出奇乎。推之而精滑可止也，小便可缩也，三虫可杀也。"}]},{"ID":"20240612100636-0cdie5y","Type":"NodeParagraph","Properties":{"id":"20240612100636-0cdie5y","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"单用奏效，又乌能尽宣其义哉。"}]},{"ID":"20240612100636-ox6jqo7","Type":"NodeParagraph","Properties":{"id":"20240612100636-ox6jqo7","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或疑山茱萸过于涩精，多服有精不出而内败之虞。嗟乎。此犹临饭而防其不能咽也。山茱萸涩精，又不闭精，为补精之独绝，仲景夫子所以用之于地黄丸中。若精不出而内败者，乃人入房精欲泄而强闭，或有老人与大虚之人，见色而畏怯而不敢战，而心又怦怦动也。相火内炎，而游精暗出于肾宫，亦能精不出而内败。服山茱萸，正足以治之焉。有精闭而内败之虞，彼不出而内败者，乃不服山茱萸，致大小便牵痛，欲便不能，不便不可，愈痛则愈便，愈便则愈痛。服山茱萸，而痛与便立愈矣。可见，山茱萸乃治精不出而内败之神药，如之何其反疑之乎。"}]},{"ID":"20240612100636-t3o3v6i","Type":"NodeParagraph","Properties":{"id":"20240612100636-t3o3v6i","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或疑山茱萸性温，阴虚火动者，不宜多服。夫阴虚火动，非山茱萸又何以益阴生水，止其龙雷之虚火哉。凡火动起于水虚，补其水则火自降，温其水则火自安。倘不用山茱萸之益精温肾，而改用黄柏、知母泻水寒肾，吾恐水愈干而火愈燥，肾愈寒而火愈多，势必至下败其脾，而上绝其肺。脾肺两坏，人有生气乎，故山茱萸正治阴虚火动之神药，不可疑其性温而反助火也。"}]},{"ID":"20240612100636-1s8vnp4","Type":"NodeParagraph","Properties":{"id":"20240612100636-1s8vnp4","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或又疑山茱萸性温动火，不宜于火动梦遗之症。夫梦遗之症，愈寒而愈遗，何忌于山茱萸乎。山茱萸性涩精，安有涩精而反致遗精乎。盖梦遗而至玉关不闭，正因于肾火之衰也。肾火衰，则火不能通于膀胱，而膀胱之水道闭矣。水道闭而水窍塞，水窍塞而精窍反不能塞也，于是，日遗精而不止。然则欲止其精，舍温肾又何以止之乎。人以为山茱萸性温动火，恐不可以治遗精之病。吾以为山茱萸之性，仅温尚不足以助火，恐未能竟治遗精之病也。"}]},{"ID":"20240612100636-j06hs0m","Type":"NodeParagraph","Properties":{"id":"20240612100636-j06hs0m","updated":"20240612100636"},"Children":[{"Type":"NodeText","Data":"或问缪仲醇阐山茱萸之误，云命门火炽，阳强不痿，忌用茱萸，而先生所谈六味、八味，又似命门火炽者服之无碍，然则仲醇非欤？曰∶是仲醇过慎药饵之失也。命门火炽，非山茱萸纯阴之药，又何以制之。既不敢轻用山茱萸，又不能舍山茱萸而他用制火之药，又云当与黄柏同加，则惑矣也。"}]},{"ID":"20240612100637-d7ea0wo","Type":"NodeThematicBreak","Properties":{"id":"20240612100637-d7ea0wo"}},{"ID":"20240612101010-8szoiit","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101010-8szoiit","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"《中国药典》：山茱萸"}]},{"ID":"20240612101010-wz1651b","Type":"NodeParagraph","Properties":{"id":"20240612101010-wz1651b","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612101010-3z1tfll","Type":"NodeParagraph","Properties":{"id":"20240612101010-3z1tfll","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" Shān Zhū Yú"}]},{"ID":"20240612101010-65nox5q","Type":"NodeParagraph","Properties":{"id":"20240612101010-65nox5q","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612101010-ft92smx","Type":"NodeParagraph","Properties":{"id":"20240612101010-ft92smx","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" FRUCTUS CORNI"}]},{"ID":"20240612101010-0fbp0dm","Type":"NodeParagraph","Properties":{"id":"20240612101010-0fbp0dm","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612101010-zuo0bu3","Type":"NodeParagraph","Properties":{"id":"20240612101010-zuo0bu3","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 本品为山茱萸科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山茱萸"},{"Type":"NodeText","Data":"Cornus officinalis Sieb. et Zucc. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果肉"},{"Type":"NodeText","Data":"。秋末冬初果皮变红时采收果实，用文火烘或置沸水中略烫后，及时除去果核，干燥。"}]},{"ID":"20240612101010-q5kzsuq","Type":"NodeParagraph","Properties":{"id":"20240612101010-q5kzsuq","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612101010-fyyn65n","Type":"NodeParagraph","Properties":{"id":"20240612101010-fyyn65n","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 本品呈不规则的片状或囊状，长1～1.5cm，宽0.5～1cm。表面紫红色至紫黑色，皱缩，有光泽。顶端有的有圆形宿萼痕，基部有果梗痕。质柔软。气微，味酸、涩、微苦。"}]},{"ID":"20240612101010-vmpy2g0","Type":"NodeParagraph","Properties":{"id":"20240612101010-vmpy2g0","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612101010-cxriljg","Type":"NodeParagraph","Properties":{"id":"20240612101010-cxriljg","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240612101010-lxw2urf","Type":"NodeParagraph","Properties":{"id":"20240612101010-lxw2urf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612101010-afvx2p8","Type":"NodeParagraph","Properties":{"id":"20240612101010-afvx2p8","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 山萸肉：除去杂质和残留果核。"}]},{"ID":"20240612101010-n91cg9b","Type":"NodeParagraph","Properties":{"id":"20240612101010-n91cg9b","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"酒萸肉：取净山萸肉，用黄酒拌匀，放罐内或其他容器内，封严，放在加水的锅中，蒸至酒被吸尽，取出晾干（每100斤用黄酒20斤）。"}]},{"ID":"20240612101010-e319ge8","Type":"NodeParagraph","Properties":{"id":"20240612101010-e319ge8","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"蒸山萸：将拣净去核的山萸肉，放罐内或笼屉等容器封严，放在加水的锅中，蒸至外面呈黑色时，取出晾干。"}]},{"ID":"20240612101010-zdjqc6d","Type":"NodeParagraph","Properties":{"id":"20240612101010-zdjqc6d","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612101010-wuv8ace","Type":"NodeParagraph","Properties":{"id":"20240612101010-wuv8ace","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 本品粉末红褐色。果皮表皮细胞表面观多角形或类长方形，直径16～30μｍ，垂周壁连珠状增厚，外平周壁颗粒状角质增厚，胞腔含淡橙黄色物。中果皮细胞橙棕色，多皱缩。草酸钙簇晶少数，直径12～32μｍ。石细胞类方形、卵圆形或长方形，纹孔明显，胞腔大。"}]},{"ID":"20240612101010-6trpd6z","Type":"NodeParagraph","Properties":{"id":"20240612101010-6trpd6z","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240612101010-2yotfwf","Type":"NodeParagraph","Properties":{"id":"20240612101010-2yotfwf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 取本品粗粉约1g，精密称定，置索氏提取器中，加乙醚适量，加热回流提取4小时，提取液回收乙醚至干，残渣用石油醚（30～60℃）浸泡2次，每次15ml（约浸泡2分钟），倾去石油醚，残渣加无水乙醇-氯仿（3:2）混合液微热使溶解，转移至5ml量瓶中，并稀释至刻度，摇匀，作为供试品溶液。另取熊果酸对照品,加无水乙醇制成每1ml中含0.5mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液5μl或10μl、对照品溶液4μl与8μl，分别交叉点于同一硅胶Ｇ薄层板上，以环己烷-氯仿-醋酸乙酯（20:5:8）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在110℃加热5～7分钟，至呈现紫红色斑点，取出，在薄层板上覆盖同样大小的玻璃板，周围用胶布固定，照薄层色谱法（附录Ⅵ B 薄层扫描法）进行扫描，波长：λs＝520nm，λR＝700nm，测量供试品吸收度积分值与对照品吸收度积分值，计算，即得。"}]},{"ID":"20240612101010-kt6yo8j","Type":"NodeParagraph","Properties":{"id":"20240612101010-kt6yo8j","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"本品含熊果酸（C30H48O3）不得少于0.20％。"}]},{"ID":"20240612101010-f6ncquz","Type":"NodeParagraph","Properties":{"id":"20240612101010-f6ncquz","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612101010-roe3f4n","Type":"NodeParagraph","Properties":{"id":"20240612101010-roe3f4n","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240612101010-tejsb8w","Type":"NodeParagraph","Properties":{"id":"20240612101010-tejsb8w","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612101010-rgc6dfx","Type":"NodeParagraph","Properties":{"id":"20240612101010-rgc6dfx","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 酸、涩，微温。"}]},{"ID":"20240612101010-t84r17b","Type":"NodeParagraph","Properties":{"id":"20240612101010-t84r17b","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612101010-t5mcbmw","Type":"NodeParagraph","Properties":{"id":"20240612101010-t5mcbmw","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 补益肝肾，涩精固脱。用于眩晕耳鸣，腰膝酸痛，阳痿遗精，遗尿尿频，崩漏带下，大汗虚脱。内热消渴。"}]},{"ID":"20240612101010-4va4x6q","Type":"NodeParagraph","Properties":{"id":"20240612101010-4va4x6q","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612101010-d871x83","Type":"NodeParagraph","Properties":{"id":"20240612101010-d871x83","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240612101010-bk83ohy","Type":"NodeParagraph","Properties":{"id":"20240612101010-bk83ohy","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612101010-uoh54hs","Type":"NodeParagraph","Properties":{"id":"20240612101010-uoh54hs","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612101010-2lf1n7s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101010-2lf1n7s","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：山茱萸"}]},{"ID":"20240612101010-olzwomf","Type":"NodeParagraph","Properties":{"id":"20240612101010-olzwomf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612101010-3knzs8h","Type":"NodeParagraph","Properties":{"id":"20240612101010-3knzs8h","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" Shān Zhū Yú"}]},{"ID":"20240612101010-voq0uvp","Type":"NodeParagraph","Properties":{"id":"20240612101010-voq0uvp","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612101010-r0ciwep","Type":"NodeParagraph","Properties":{"id":"20240612101010-r0ciwep","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 蜀枣（《本经》），鼠矢、鸡足（《吴昔本草》），山萸肉（《小儿药证直诀》），实枣儿（《救荒本草》），肉枣（《纲目》），枣皮（《会约医镜》），萸肉（《医学衷中参西录》），药枣（《四川中药志》）。"}]},{"ID":"20240612101010-od3uggh","Type":"NodeParagraph","Properties":{"id":"20240612101010-od3uggh","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612101010-p8vehk0","Type":"NodeParagraph","Properties":{"id":"20240612101010-p8vehk0","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" Asiatic Cornelian Cherry Fruit"}]},{"ID":"20240612101010-zt8rshs","Type":"NodeParagraph","Properties":{"id":"20240612101010-zt8rshs","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612101010-gdsg3eb","Type":"NodeParagraph","Properties":{"id":"20240612101010-gdsg3eb","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612101010-t7otyax","Type":"NodeParagraph","Properties":{"id":"20240612101010-t7otyax","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612101010-t4aescz","Type":"NodeParagraph","Properties":{"id":"20240612101010-t4aescz","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 为山茱萸科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山茱萸"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果肉"},{"Type":"NodeText","Data":"。10～11月间果实成熟变红后采摘，采后除去枝梗和果柄，用文火烘焙，冷后，取下果肉，再晒干或用文火烘干。宜放置阴暗干燥处，以防霉蛀变质。"}]},{"ID":"20240612101010-4ntbjq1","Type":"NodeParagraph","Properties":{"id":"20240612101010-4ntbjq1","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612101010-sqzmo49","Type":"NodeParagraph","Properties":{"id":"20240612101010-sqzmo49","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 杂生于山坡灌木林中。有栽培。分布陕西、河南、山西、山东、安徽、浙江、四川等地。产浙江、河南、安徽、陕西、山西、四川等地。"}]},{"ID":"20240612101010-pv3j005","Type":"NodeParagraph","Properties":{"id":"20240612101010-pv3j005","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612101010-ix2vrse","Type":"NodeParagraph","Properties":{"id":"20240612101010-ix2vrse","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 落叶小乔木，高4米左右。枝皮灰棕色，小枝无毛。单叶对生；叶片椭圆形或长椭圆形，长5～7厘米，宽3～4.5厘米，先端窄，长锐尖形，基部圆形或阔楔形，全缘，上面近光滑，偶被极细毛，下面被白色伏毛，脉腋有黄褐色毛丛，侧脉5～7对，弧形平行排列；叶柄长1厘米左右。花先叶开放，成伞形花序，簇生于小枝顶端，其下具数片芽鳞状苞片；花小；花萼4，不显着；花瓣4，黄色；雄蕊4；于房下位。核果长椭圆形，长1.2～1.5厘米，直径7毫米左右，无毛，成熟后红色；果柄长1.5～2厘米。种子长椭圆形，两端钝圆。花期5～6月。果期8～10月。"}]},{"ID":"20240612101010-ktnxu6h","Type":"NodeParagraph","Properties":{"id":"20240612101010-ktnxu6h","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612101010-y3cptwh","Type":"NodeParagraph","Properties":{"id":"20240612101010-y3cptwh","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 肉质果皮破裂皱缩，不完整或呈扁简状，长约1.5厘米，宽约o.5厘米。新货表面为紫红色，陈久者则多为紫黑色，有光泽，基部有时可见果柄痕，顶端有一四形宿萼痕迹。质柔润不易碎。无臭，味酸而涩苦。以无核、皮肉肥厚、色红油润者佳。"}]},{"ID":"20240612101010-vmfbg9g","Type":"NodeParagraph","Properties":{"id":"20240612101010-vmfbg9g","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612101010-vf0q33b","Type":"NodeParagraph","Properties":{"id":"20240612101010-vf0q33b","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 含莫罗忍冬甙（morroniside）、7-0-甲基莫罗忍冬甙（7-0-methylmorroniside）、獐牙菜甙（sweroside）、番木鳖甙（Ioganin）、山茱萸鞣质1、2、3、（cornus-tannin 1,2,3）等。"}]},{"ID":"20240612101010-3mzqiys","Type":"NodeParagraph","Properties":{"id":"20240612101010-3mzqiys","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612101010-pdj66rh","Type":"NodeParagraph","Properties":{"id":"20240612101010-pdj66rh","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 山萸肉：洗净，除去果核及杂质，晒干。酒山萸：取净山萸肉，用黄酒拌匀，密封容器内，置水锅中，隔水加热，炖至酒吸尽，取出，晾干（山萸肉每100斤，用黄酒20～25斤）。蒸山萸：取净山萸肉，置笼屉内加热蒸黑为度，取出，晒干。"}]},{"ID":"20240612101010-63se7jk","Type":"NodeParagraph","Properties":{"id":"20240612101010-63se7jk","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612101010-5a41v69","Type":"NodeParagraph","Properties":{"id":"20240612101010-5a41v69","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240612101010-4dcsq9t","Type":"NodeParagraph","Properties":{"id":"20240612101010-4dcsq9t","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入足厥阴、少阴经。\""}]},{"ID":"20240612101010-kz34nng","Type":"NodeParagraph","Properties":{"id":"20240612101010-kz34nng","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入肝、心、肾三经。\""}]},{"ID":"20240612101010-wfd0gr5","Type":"NodeParagraph","Properties":{"id":"20240612101010-wfd0gr5","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"⑧《本草经解》：\"入手太阴肺经、足厥阴肝经。\""}]},{"ID":"20240612101010-xcar7jj","Type":"NodeParagraph","Properties":{"id":"20240612101010-xcar7jj","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612101010-s86u90r","Type":"NodeParagraph","Properties":{"id":"20240612101010-s86u90r","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 酸，微温。"}]},{"ID":"20240612101010-8yk5x85","Type":"NodeParagraph","Properties":{"id":"20240612101010-8yk5x85","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味酸，平。\""}]},{"ID":"20240612101010-l3184rb","Type":"NodeParagraph","Properties":{"id":"20240612101010-l3184rb","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农、黄帝、雷公、扁鹊：酸，无毒。岐伯：辛。\""}]},{"ID":"20240612101010-74ntcb7","Type":"NodeParagraph","Properties":{"id":"20240612101010-74ntcb7","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"微温，无毒。\""}]},{"ID":"20240612101010-p77s2w7","Type":"NodeParagraph","Properties":{"id":"20240612101010-p77s2w7","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"味咸辛，大热。\""}]},{"ID":"20240612101010-9fdj7iw","Type":"NodeParagraph","Properties":{"id":"20240612101010-9fdj7iw","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612101010-xlfira9","Type":"NodeParagraph","Properties":{"id":"20240612101010-xlfira9","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 凡命门火炽，强阳不痿，素有湿热，小便淋涩者忌服。"}]},{"ID":"20240612101010-1y68cb2","Type":"NodeParagraph","Properties":{"id":"20240612101010-1y68cb2","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"《本草经集注》：\"蓼实为之使。恶桔梗、防风、防己。\""}]},{"ID":"20240612101010-0ovkv67","Type":"NodeParagraph","Properties":{"id":"20240612101010-0ovkv67","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612101010-6kml0l0","Type":"NodeParagraph","Properties":{"id":"20240612101010-6kml0l0","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 补肝肾，涩精气，固虚脱。治腰膝酸痛，眩晕，耳鸣，阳痿，遗精，小便频数，肝虚寒热，虚汗不止，心摇脉散。"}]},{"ID":"20240612101010-ff6zaqx","Type":"NodeParagraph","Properties":{"id":"20240612101010-ff6zaqx","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"补益肝肾，涩精固脱。用于眩晕耳鸣、腰膝酸痛、阳痿遗精、遗尿尿频、崩漏带下、大汗虚脱、内热消渴。温肝补肾，除一切风，止月经过多，治老人尿频。"}]},{"ID":"20240612101010-hhxaal5","Type":"NodeParagraph","Properties":{"id":"20240612101010-hhxaal5","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心下邪气寒热，温中，逐寒湿痹，去三虫。\""}]},{"ID":"20240612101010-cetrrot","Type":"NodeParagraph","Properties":{"id":"20240612101010-cetrrot","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"②《雷公炮炙论》：\"壮元气，秘精。\""}]},{"ID":"20240612101010-8pv6xlg","Type":"NodeParagraph","Properties":{"id":"20240612101010-8pv6xlg","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"肠胃风邪，寒热疝瘕，头风，风气去来，鼻塞，目黄，耳聋，面疱，温中，下气，出汗，强阴，益精，安五脏，通九窍，止小便利，明目，强力。\""}]},{"ID":"20240612101010-zgvr1hv","Type":"NodeParagraph","Properties":{"id":"20240612101010-zgvr1hv","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治脑骨痛，止月水不定，补肾气；兴阳道，添精髓，疗耳鸣，除面上疮，主能发汗，止老人尿不节。\""}]},{"ID":"20240612101010-nq9uyzy","Type":"NodeParagraph","Properties":{"id":"20240612101010-nq9uyzy","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"暖腰膝，助水脏，除一切风，逐一切气，破癥结，治酒皶。\""}]},{"ID":"20240612101010-2b8d2m9","Type":"NodeParagraph","Properties":{"id":"20240612101010-2b8d2m9","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"温肝。\""}]},{"ID":"20240612101010-k41di7r","Type":"NodeParagraph","Properties":{"id":"20240612101010-k41di7r","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》：\"止久泻，心虚发热汗出。\""}]},{"ID":"20240612101010-ee6ki7p","Type":"NodeParagraph","Properties":{"id":"20240612101010-ee6ki7p","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612101010-e3hor87","Type":"NodeParagraph","Properties":{"id":"20240612101010-e3hor87","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240612101010-5mr6p44","Type":"NodeParagraph","Properties":{"id":"20240612101010-5mr6p44","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612101010-tglx1js","Type":"NodeParagraph","Properties":{"id":"20240612101010-tglx1js","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" ①治五种腰痛，下焦风冷，腰脚无力：牛膝一两（去苗），山茱萸一两，桂心三分，上药捣细罗为散，每于食前，以温酒调下二钱。（《圣惠方》）"}]},{"ID":"20240612101010-jmhu9aa","Type":"NodeParagraph","Properties":{"id":"20240612101010-jmhu9aa","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"②益元阳，补元气，固元精，壮元神：山茱萸（酒浸）取肉一斤，破故纸（酒浸一日，焙干）半斤，当归四两，麝香一钱。上为细末，炼蜜丸，梧桐子大。每服八十一丸，临卧酒盐汤下。（《扶寿精方》草还丹）"}]},{"ID":"20240612101010-7hzobte","Type":"NodeParagraph","Properties":{"id":"20240612101010-7hzobte","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"③治脚气上入少腹不仁：干地黄八两，山茱萸、薯蓣各四两，泽泻、茯苓、牡丹皮各三两，桂枝、附子（炮）各一两。上八味，末之，炼蜜和丸梧子大，酒下十五丸，日再服。（《金匮要略》崔氏八味丸）"}]},{"ID":"20240612101010-s4ydj4n","Type":"NodeParagraph","Properties":{"id":"20240612101010-s4ydj4n","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"④治肾怯失音，囟开不合，神不足，目中白睛多，面色刮白：熟地黄八钱，山萸肉、干山药各四钱，泽泻、牡丹皮、白茯苓（去皮）各三钱。上为末，炼蜜丸如梧子大。空心服，温水化下三丸。（《小儿药证直诀》地黄丸）"}]},{"ID":"20240612101010-0ur6sg1","Type":"NodeParagraph","Properties":{"id":"20240612101010-0ur6sg1","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"⑤治老人小水不节，或自遗不禁：山茱萸肉二两，益智子一两，人参、白才L各八钱，分作十剂，水煎服。（《方龙潭家秘》）"}]},{"ID":"20240612101010-3dg8ddp","Type":"NodeParagraph","Properties":{"id":"20240612101010-3dg8ddp","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"⑥治寒温外感诸症，大病差后不能自复，寒热往来，虚汗淋漓；或但热不寒，汗出而热解，须臾又热又汗，目睛上窜。势危欲脱，或喘逆，或怔忡，或气虚不足以息：萸肉二两（去净核），生龙骨一两（捣细），生牡蛎一两（捣细），生杭芍六钱，野台参四钱，甘草三钱（蜜炙）。水煎服。（《医学衷中参西录》来复汤）"}]},{"ID":"20240612101010-olvegas","Type":"NodeParagraph","Properties":{"id":"20240612101010-olvegas","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612101010-9kttu8p","Type":"NodeParagraph","Properties":{"id":"20240612101010-9kttu8p","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612101010-sgu05nz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101010-sgu05nz","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"《中华本草》：山茱萸"}]},{"ID":"20240612101010-k9pfnp0","Type":"NodeParagraph","Properties":{"id":"20240612101010-k9pfnp0","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612101010-aybykri","Type":"NodeParagraph","Properties":{"id":"20240612101010-aybykri","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" Shān Zhū Yú"}]},{"ID":"20240612101010-xw4xx3d","Type":"NodeParagraph","Properties":{"id":"20240612101010-xw4xx3d","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612101010-zyvp3o4","Type":"NodeParagraph","Properties":{"id":"20240612101010-zyvp3o4","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 蜀枣、鬾实、鼠矢、鸡足、山萸肉、实枣儿、肉枣、枣皮、药枣、红枣皮"}]},{"ID":"20240612101010-k2nejxf","Type":"NodeParagraph","Properties":{"id":"20240612101010-k2nejxf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612101010-ms3w3ye","Type":"NodeParagraph","Properties":{"id":"20240612101010-ms3w3ye","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" Common Macrocarpium Fruit, Fruit of Common Macrocarpium, Fruit of Japanese cornel Dogwood, Fruit of Asiatic Cornelian Cherry"}]},{"ID":"20240612101010-eqloxkb","Type":"NodeParagraph","Properties":{"id":"20240612101010-eqloxkb","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612101010-m5blwwu","Type":"NodeParagraph","Properties":{"id":"20240612101010-m5blwwu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.《雷公炮炙论》：凡使勿用雀儿苏，真似山茱萸，只是核八棱，不入药用。山茱萸核能滑精。2.陶弘景：山茱萸出近道诸山中。大树子、初熟未干，赤色如胡颓子，亦可噉。既干，皮甚薄，当以合核为用尔。"}]},{"ID":"20240612101010-lq72lkb","Type":"NodeParagraph","Properties":{"id":"20240612101010-lq72lkb","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612101010-nxzhfjv","Type":"NodeParagraph","Properties":{"id":"20240612101010-nxzhfjv","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 药材基源：为山茱萸科植物山茱萸的果实。"}]},{"ID":"20240612101010-pmbe309","Type":"NodeParagraph","Properties":{"id":"20240612101010-pmbe309","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cornus officinalis Sieb. Et Zucc.[Macrocarpium officinale (Sidb. Et Zucc.) Nakai]"}]},{"ID":"20240612101010-ncl6qrx","Type":"NodeParagraph","Properties":{"id":"20240612101010-ncl6qrx","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"采收和储藏：育苗到结果需培育6-7年，15-20年为盛果期。9-11月上旬果产呈红以时成熟，分批采摘，切忌损伤花芽。加工方法可用水煮法；将红以新鲜果置沸水中min，及时捞出浸冷水，趁热挤出种子，将果肉晒干或烘干即成。亦可用机械脱粒法，挤出果肉干燥。"}]},{"ID":"20240612101010-s7foqp6","Type":"NodeParagraph","Properties":{"id":"20240612101010-s7foqp6","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612101010-x9tr4g0","Type":"NodeParagraph","Properties":{"id":"20240612101010-x9tr4g0","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔400-1500m，稀达2100m的林缘或林中。"}]},{"ID":"20240612101010-0ekn6og","Type":"NodeParagraph","Properties":{"id":"20240612101010-0ekn6og","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于山西、陕西、甘肃、山东、灌输、安徽、江西、河南、湖南。四川有引种栽培。"}]},{"ID":"20240612101010-n2hvbdu","Type":"NodeParagraph","Properties":{"id":"20240612101010-n2hvbdu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612101010-nx7qwn1","Type":"NodeParagraph","Properties":{"id":"20240612101010-nx7qwn1","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 山茱萸，落叶小乔木，高4米左右。枝皮灰棕色，小枝无毛。单叶对生；叶片椭圆形或长椭圆形，长5-7cm，宽3-4.5cm，先端窄，长锐尖形，基部圆形或阔楔形，全缘，上面近光滑，偶被极细毛，下面被白色伏毛，脉腋有黄褐色毛丛，侧脉5-7对，弧形平行排列；叶柄长1cm左右。花先叶开放，成伞形花序，簇生于小枝顶端，其下具数片芽鳞状苞片；花小；花萼4，不显着；花瓣4，黄色；雄蕊4；子房下位。核果长椭圆形，长1.2-1.5cm，直径7mm左右，无毛，成熟后红色；果柄长1.5-2cm。种子长椭圆形，两端钝圆。花期5-6月。果期8-10月。"}]},{"ID":"20240612101010-h3ywkyv","Type":"NodeParagraph","Properties":{"id":"20240612101010-h3ywkyv","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612101010-kjs86cj","Type":"NodeParagraph","Properties":{"id":"20240612101010-kjs86cj","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候。喜光。宜选择土质肥沃，土层深厚，排水良好的砂质壤土或壤土栽培。"}]},{"ID":"20240612101010-r4kdkw9","Type":"NodeParagraph","Properties":{"id":"20240612101010-r4kdkw9","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖、压条繁殖和扦插繁殖。种子繁殖；秋季果熟期，采收个大、色红的果实作种，剥去果肉，清洗出种子，与细沙分层贮藏越冬催芽。育苗移栽法：于次年3-4月春播，按行距30cm开汉条播，播后覆土盖草，浇水，保持土壤潮湿，出苗后，去掉盖草，加强除草，松土，施肥，当年苗高30-60cm时，可进行移栽，定植时按行株距2m×2m。开穴栽种。直播法：在栽培地按行株距2m×2m，开穴施肥下种，每穴播种了3-4粒，覆土1-2cm。压条繁殖：秋季收果后，将近地面的2、3年生枝条弯曲至地面，在近地面处将枝条切割至木质部1/3并埋入土中，上覆15cm厚砂壤土。于第2年冬或第3年春将已长根的压条与母株分离即可移植。扦插繁殖：于5月中、下旬，在优良母株上剪取枝条，将木质化的枝条剪成长15-20cm的扦条，在沙床上按行株距20cm×8cm扦插，盖薄膜保温，上搭荫棚遮光，浇水保湿，除草施肥，翌年早春移植。"}]},{"ID":"20240612101010-a0dbfjj","Type":"NodeParagraph","Properties":{"id":"20240612101010-a0dbfjj","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"田间管理 定植后每年中耕除草4-5次；5、6月增施过磷酸钙，促进花芽分化，提高座果率，冬季增施腊肥，亦能平衡结果大小年差异。夏季培土1次，以防倒伏。幼树高约40-60cm时，2月间打去顶梢，选留3-4个主枝，再在职主枝上选留3-4个副主枝，形成自然开心形。幼树以整形为主，修剪为辅。又因山茱萸长、中短果枝均以顶端花芽结果为主，各类果枝不宜短截。成年树于春、秋两季修剪，调节生长与结果之间的矛盾，更新结果枝群，保留生长枝，进行短截，促进分枝。"}]},{"ID":"20240612101010-g8f1k7x","Type":"NodeParagraph","Properties":{"id":"20240612101010-g8f1k7x","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有灰色膏药病，成年植株易发生，由介壳虫传染，发病初期喷1：1：100波尔多液保护。炭疽病，于6月上旬发病为害果实，防治方法参见灰色膏药病。白粉病，为害植株，发病初期喷50%托布津1 000倍液。虫害有蛀果蛾为害果实，在成虫羽化盛期喷2.5%溴氰菊脂5 000倍液防治；还有木掩尺蠖、磊蓑蛾为害。"}]},{"ID":"20240612101010-x7xkz32","Type":"NodeParagraph","Properties":{"id":"20240612101010-x7xkz32","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612101010-htfdpga","Type":"NodeParagraph","Properties":{"id":"20240612101010-htfdpga","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 肉质果皮破裂皱缩，不完整或呈扁筒状，长约1.5cm，宽约0.5cm。新货表面为紫红色，陈久看则多为紫黑色，有光泽，基部有时可见果柄痕，顶端有一圆形宿萼痕迹。质柔润不易碎。无臭，味酸而涩苦。以无核、皮肉肥厚、色红油润者佳。"}]},{"ID":"20240612101010-hn07fyt","Type":"NodeParagraph","Properties":{"id":"20240612101010-hn07fyt","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性状鉴别 果肉呈不规则片状或囊状，长1-1.5cm，宽0.5-1cm。表面紫红色至紫黑色，皱缩有光泽。顶端有的有圆形宿萼痕，基部有果梗痕。质柔软。气微，味酸，涩，微苦。"}]},{"ID":"20240612101010-vua65wu","Type":"NodeParagraph","Properties":{"id":"20240612101010-vua65wu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"以肉厚、柔软、色紫红者为佳。"}]},{"ID":"20240612101010-0yoafa6","Type":"NodeParagraph","Properties":{"id":"20240612101010-0yoafa6","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果肉横切面：外果皮为1列略扁平的表皮细胞，外被较厚的角质层。中果皮宽广，为多列薄壁细胞，大小不一，细胞内含深褐色色素块，近内侧有8个维管束环列。近果柄处的横切面常面有石细胞和纤维束。"}]},{"ID":"20240612101010-smuzs9z","Type":"NodeParagraph","Properties":{"id":"20240612101010-smuzs9z","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612101010-cccbwtl","Type":"NodeParagraph","Properties":{"id":"20240612101010-cccbwtl","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 果肉及果核水煎剂作急性毒性实验，结果两者毒性都很低，果肉LD50为53.55g（生药）/kg，果核LD50为90.8g（生药）/kg。"}]},{"ID":"20240612101010-di1docg","Type":"NodeParagraph","Properties":{"id":"20240612101010-di1docg","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612101010-ynfvjyk","Type":"NodeParagraph","Properties":{"id":"20240612101010-ynfvjyk","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 山茱萸果肉含鞣质成分：山茱萸鞣毛（cornus-tannin)1、2、3[1]，山茱萸鞣质1即是异诃子素（isoterchebin)[2]又名菱属鞣质（trapain)[4],山茱萸鞣质2即是新唢呐草素Ⅱ（tel-limagrandinⅡ)[2]，山茱萸鞣质2即是新唢呐草素Ⅰ（tellima-grandinⅠ）[2]；（木来）木鞣质（cornusiin)A、B、C、[2]、G[3]，丁子香鞣质（eugeniin)，路边青鞣质D（geminD)以及2，3-二-O-没食子酰葡萄糖（2，3-di-O-glloy-β-D-glucose)，1，2，3-三-O-没食子酰葡萄糖（1，2，6-tri-O-galloyl-β-D-glucose),1,2,6-dg -O-D-glucose)，1，2，6-三-O-没食子酰葡萄糖（1、2、6-tetro-O-galloyl-β-D-glucose)[2]。又含糖甙成分；山茱萸裂甙（cornuside)[3]，莫罗忍冬甙（morroniside),7-O-甲基莫罗忍冬甙（7-O-methylmorroniside)，马钱子甙（loganin)，当药甙（sweroside)。还含葡萄糖（glucose)，果糖（fructose)，蔗糖（su-crose)，熊果酸（ursolic acid)[5]，没食子酸（gallic acid)，苹果酸（malic acid)，酒石酸（tartaric acid)及维生素A（vitamin A)[6]等。又含押发油，从中分离得到9个单萜烃、6个倍半萜烃、5个脂肪烃，7个单萜酯和个脂肪醇，4个单萜醛及酮，3个脂肪醛及酮，4个酸18个酯和15个芳香化合物，其中含量较多的主要成分有：异丁醇（isobutyl alcohol)，丁醇（butanol)，异戊醇（isoanyl alcohol),顺式的和反式的蓄谋樟醇氧化物（linalool ），糠醛（furfural)，β-苯已醇（β-phenyl ethylalcohol)，甲基丁香油酚（methyl eugenol)，榄香脂素（elemicin)，异细辛缡（isoasarone)，棕榈酸已酯（ethylpalmitate)，油酸已酯（ethyloleate)，亚油酸已酯（ethyllinoleate)，桂皮酸苄酯（benzyl cinnamate)，棕榈酸（palmitic acid)，硬脂酸（stearic acid)，（王古）（王巴）烯（copaene)，α-松油醇（α-terpi-neol)，α-姜黄烯（αcurcumene)，茴香脑（anethole)，4-甲氧基-1，2-苯并间二氧杂环戊烯（4-methoxy-1,2-benzodioxole)，细辛醚（asaricin)，马兜铃酮（aristolone)，已基香草醛（ethylvanillin)，亚麻酸已酯（ethyllinolenate)，胡薄荷酮（pulegone)，黄樟醚（safrole)[7]等。核中含亚油酸（linoleic acid)，油酸（oleic acid)，棕榈酸（palmitic acid)，硬脂酸（stearic acid)，亚麻酸（linolenic acid)，月桂酸（lauric acid)[8]等脂肪酸和铁、铝、铜、锌、硼、磷等21种元素[9]。果肉及核中均含苏氨酸（threonine)，缬氨酸（valine)，亮氨酸（leucine)，异亮氨酸（isoleucine)，苯丙氨酸（phenylalanine)，组氨酸（histidine)，赖氨酸（lysine)，丝氨酸（serine)，谷氨酸（glutam-ic acid)，甘氨酸（glycine)，丙氨酸（alanine)，酪氨酸（tyrosine)，精氨酸（arginine)，天冬氨酸（aspartic acid)等14种氨基酸，核中还另有蛋氨酸（methionine)，脯氨酸（proline)，胱氨酸（cystine)[9]。"}]},{"ID":"20240612101010-o9cnf30","Type":"NodeParagraph","Properties":{"id":"20240612101010-o9cnf30","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612101010-l6y2je9","Type":"NodeParagraph","Properties":{"id":"20240612101010-l6y2je9","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用 果实煎剂在体外能抑制金黄色葡萄球菌的生长，而对大肠杆菌则无效。煎剂（1:1）对志贺氏痢疾杆菌的抑菌圈，直径可达13-18mm（平板环杯法）。从山茱萸鲜果肉中可得一黑红色酸味液体，对伤寒、痢疾细菌有抑制作用。水浸剂（1:3）在试管内对堇色毛癣菌有不同程度的抑制作用。"}]},{"ID":"20240612101010-pajze1t","Type":"NodeParagraph","Properties":{"id":"20240612101010-pajze1t","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.降血糖作用 2.1对正常大鼠血糖的影响 远交系Wistar雄性大白鼠，体重150-200g，36只均分4组。1组为对照组，其余3组为药物组，分别5、7.5、15g/（kg,d）药物（山茱萸成熟果肉。碾细后用70%乙醇回流提取，制浸膏1ml（相当于3.5g生药）ig。药物组与对照组血糖值无明显差异。另曾以50g/kg药物对大鼠ig1周，结果也未见对正常大鼠血糖值有明显影响。"}]},{"ID":"20240612101010-33tr7a4","Type":"NodeParagraph","Properties":{"id":"20240612101010-33tr7a4","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.2对肾上腺素性大鼠高血糖的影响 大鼠24只，均分3组，禁食2小时后，正常对照组和造型对照组ig给水，给药组ig给山茱萸7g/kg。给药后1小时，造型对照组大鼠sc生理盐水；造型对照组和给药组大鼠sc肾上腺0.25mg/kg。注射后135分钟取血测定血糖。可见山茱萸有明显的对抗肾上腺素性高血糖的作用。"}]},{"ID":"20240612101010-ce2vl8o","Type":"NodeParagraph","Properties":{"id":"20240612101010-ce2vl8o","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.3对四氧嘧啶性大鼠高血糖、肝糖原、甘油三酯和胆固醇的影响大鼠24只，均分3组。1组为正常对照组，另2组于大鼠舌下iv30mg/kg的四氧嘧啶生理盐水溶液，其中一组每日ig山茱萸7g/kg。实验结果表明，山茱萸对四氧嘧啶性糖尿病大鼠的高血糖有明显影响（P＜0.05），有一定的升高大鼠肝糖原的作用，但对甘油三酯和胆固醇无明显影响。"}]},{"ID":"20240612101010-a62o7gr","Type":"NodeParagraph","Properties":{"id":"20240612101010-a62o7gr","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.4对偶氮磺胺性大鼠糖尿病的影响 采用Wistar系雄性大白鼠。动物停食45小时后按50-65mg/kgiv偶氮磺胺诱发糖尿病。将八味地黄丸制成相应干浸膏剂和粉剂，其它组分则制成粉剂。山茱萸除制成乙醚提取剂（COE）并且进一步分离出其他的3个亚组分：COEfr-1、COE一fr-2、COE-rf-3。然后，再从COE-fr-2中制得三种结晶一鱼肝酸油、乌索酸和2-a-羟乌索酸，前两种供实验使用，山茱萸及八味地黄丸的粉剂为2g/kg，COE1g/kg，COE的3个亚组分及鱼肝油酸和乌索酸分别为0.5g/kg。给药的方法是：动物静脉注射偶氮磺胺（Streptozotocin）后lh开始po给药，以后每天2次，共给药6次，于最后1次给药后3小时时从腹腔大静脉取血进行血糖测定。同时测定尿糖以及动物20小时的饮水量和尿量。实验结果表明，以八味地黄丸的粉剂和其中的山茱萸抗糖尿病的效果最为明显，山茱萸粉剂给药后，动物20小时的饮水量为23.3±2.8，与对照组（46.4±50）相比,差异非常显着（P＜0.0001＝。血糖（mg/dl）及尿糖含量（mg/20小时尿）分别为393.3±28.7和2553.0±205.1与对照组相比（470.0±21.3和4733.7±389.5）具有明显差异前者P＜0.05,后者P＜0.0001＝。八味地黄丸粉剂的降血糖和尿糖的作用也非学明显，而其干浸膏则无明显效果。在山茱萸的乙醚提取剂中，尤其COE-fr-2的活性最强。COE-fr-2给药后，动物20小时的饮水量和尿量分别为13.8±3.4和13.5±1.9，与对照组相比（50.0±3.2和36.7±3·0）差异均非常显着（P＜0.001＝，血糖及尿糖含量分别为227.2±25.3和978.2±167·8与对照组相比（403.3±36.6和2916.8±55.4），均具有显着的差异（前者P＜0.05，后者P＜0.0001＝，另外，COE和COE-fr-l也有明显的降尿糖作用，而COE和COE-fr-2有降低动物体重的趋势。对从COE-fr-2中分离制得的鱼肝酸油和乌索酸，虽然两者均可显着地减少动物20小时的饮水量和尿量，但只有乌索酸可以明显地降低血糖和尿糖。乌索酸给药后，动物的血糖和尿糖含量分别为294.2±37.2和1175.5±249.2，与对照组相比（513.2±35.4和3013.3±404.2）具有非常显着的差别（P＜0.0001）2.5对高血糖大鼠全血粘度的影响 四氧嘧啶性糖尿病大鼠ig山茱萸7g/kg1周后，尾静脉取血测定血糖。再用40mg/kg戊巴比妥钠溶液麻醉，肝素抗凝，腹主动脉取血，测定全血粘度。"}]},{"ID":"20240612101010-82s1du9","Type":"NodeParagraph","Properties":{"id":"20240612101010-82s1du9","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.6对高血糖大鼠血小板聚集的影响 山茱萸7h/kg，末次ig四氧嘧啶性糖尿病大鼠后2小时，以3.8%枸橼酸钠9：l比例抗凝，腹主动脉取血，制备富血小板和贫血小板血浆，用ADP为致聚剂，测定药物对血小板聚集功能的影响。结果山茱萸组的血小板抑制聚集率为44.6%（P＜0.00013. 对免疫系统的作用3.1对免疫器官重量的影响 雄性ICR小鼠40只，随机分为4组，实验组连续5dig山茱萸10.20g/kg（水煎剂）；对照组每天给予同样量水，阳性对照组于d3开始，连续3dip环磷酰胺50mg/kg。末次给药后24h，放血处死动物，摘取小鼠胸腺、脾脏及肝脏并称其湿重计算各脏器的指数。山茱萸降低小鼠的胸腺指数，对肝脏、脾脏影响不显着。"}]},{"ID":"20240612101010-q33kmnw","Type":"NodeParagraph","Properties":{"id":"20240612101010-q33kmnw","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.2对碳性粒廓清速率的影响取雄性ICR小鼠，山茱萸及环磷酰胺的给药剂量及方式同上。末次给药后24h，按文献方法计算小鼠的廓清指数（K）及校正廓清指数（a）。结果不同剂量的山茱萸组K值均明显低于对照组。"}]},{"ID":"20240612101010-f9dfr8v","Type":"NodeParagraph","Properties":{"id":"20240612101010-f9dfr8v","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.3对小鼠血清抗体的影响3.3.1对溶血素抗体的影响 雄性NIH小鼠，给药组于绵羊红细胞（SRBC）致敏前第2d始，连续5dig山茱萸5.10g/kg，阳性对照组ip环磷酰胺25mg/kg，每次给药后24h，按比色法测定并计算样本的HC50。由表6可见，山茱萸10g/kg明显升高小鼠血清溶血素抗体含量，山茱萸5g/kg作用不显着。"}]},{"ID":"20240612101010-b391qmb","Type":"NodeParagraph","Properties":{"id":"20240612101010-b391qmb","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.3.2对抗体IgG含量的影响 BALB/C小鼠，雌雄兼用，山茱萸的给药剂量同上，阳性对照组于实验组给药d4开始，连续2dip环磷酰胺100mg/kg。末次给药后24h，小鼠眼眶采血，分离血清，按琼脂单向扩散法测IgG含量，IgG含量，以沉淀环直径表示。不同剂量山茱萸匀能显着升高小鼠血清IgG含量。"}]},{"ID":"20240612101010-gddup2u","Type":"NodeParagraph","Properties":{"id":"20240612101010-gddup2u","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.4对SRBC所致迟发型足垫反应的影响 取雄性昆明种小鼠，实验组于SRBC致敏前1d给药，山茱萸的给药剂量及方式同3，末次给药后lh抗原攻击，24h后测小鼠左右足垫的厚度差及重量差，结果山茱萸5，10g/kg均抑制SRBC所致小鼠迟发型足垫肿胀。"}]},{"ID":"20240612101010-pbqzjk5","Type":"NodeParagraph","Properties":{"id":"20240612101010-pbqzjk5","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.5对DNCB所致接触性皮炎的影响3.5.1攻击前给药对接触性皮炎的影响 取雌性NIH鼠，实验组于DNCB致敏后d6开始，连续5dig山茱萸10，20d/kg，末次给药后6h，以DNCB涂于小鼠右耳进行攻击，16h后剪下两耳，以直径9mm打孔器打下耳片，以右耳的增重表示接触性皮炎的程度，结果不同剂量山茱萸对小鼠的耳廓肿胀均表现明显的抑制作用。"}]},{"ID":"20240612101010-ertlvli","Type":"NodeParagraph","Properties":{"id":"20240612101010-ertlvli","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.5.2攻击后给药对接触性皮炎的影响 雄性NIH小鼠56只，随机分为7组，实验方法同文献，于DNCB致敏后dl0，给药组于抗原攻击后不同时间ig山茱萸20g/kg。山茱萸于攻击后3-15小时给药均能明显抑制DNCB所致小鼠接触性皮炎。"}]},{"ID":"20240612101010-fe1enpd","Type":"NodeParagraph","Properties":{"id":"20240612101010-fe1enpd","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"山茱萸总甙体内外用药，对小鼠均为免疫抑制作用；熊果酸体外试验能杀死培养的小鼠淋巴细胞，使失去淋转，IL-2生成和LAK细胞产生的能力，但如腹腔注射熊果酸，对小鼠的上述指标均明显提高。"}]},{"ID":"20240612101010-8d5148k","Type":"NodeParagraph","Properties":{"id":"20240612101010-8d5148k","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"4.抗休克作用4.1对颈动脉血压的影响 取1.5-3.5kg健康家兔，雌雄不拘，随机分为二组，甲组为实验组，乙组为对照组。在2%普鲁卡因局麻下行颈动脉剥离，插管，接Rm-600型四导生理记录仪，耳静脉注射312u/（m1，kg）肝素。然后开始股动脉缓慢放血，使血压降到50mmHg以下。由于家兔的代偿机能，停止放血后血压可自动回升。若回升较高时，则再次放血，使血压维持在60mmHg以下，持续lh，并记录休克期各项观察指标数值，然后甲组给1g/ml山茱萸注射液颈部皮下浅静脉点滴，给药速度为36滴/min；乙组给等量生理盐水静脉点滴。山茱萸注射液pH为7.68，生理盐水pH为7.5。30分钟后再取标本，并记录治疗后各项观察指标数值，终止观察。实验结果发现：甲组由休克期平均49.73±7.25mmHg上升为87.64±7.13mmHg，上升幅度为39.43±9.97mmHg；乙组由休克期平均55.46±8.57mmHg上升为68.61±17.6mmHg，上升幅度为13.15±12.12mmHg。两组有显着差异，t=61.8,P＜0.001。"}]},{"ID":"20240612101010-pkunkym","Type":"NodeParagraph","Properties":{"id":"20240612101010-pkunkym","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"4.2对血压心搏波振幅的影响 上述实验的甲组由休克期平均1.42±0.7mm增大为4.03±1.11mm，增大幅度为2.61±0.72mm；乙组由体克期平均1.88±0.9mm增大至2.35±0.87mm，增大幅度为0.57±0.93mm。两组有显着差异，t=5.36，P＜0.001。"}]},{"ID":"20240612101010-78ti75g","Type":"NodeParagraph","Properties":{"id":"20240612101010-78ti75g","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5．抑制炎症反应作用5.1抑制小鼠腹腔毛细血管通透性雄性昆明种小鼠，体重18-22g。阳性对照组每日ig阿斯匹林50mg/kg；给药组每日ig山茱萸5，10g/kg（水煎剂含生药1g/ml），连续5d；空白对照组每日给予等量的水，末次给药后lh，各鼠尾iv0.5%Evans蓝5ml/kg，5min后ip0.7%醋酸10ml/kg，间隔30min后将小鼠放血处死，用蒸馏水多次冲洗腹腔，收集冲洗液并稀释至10ml放置lh，用751型分光光度计610nm处比色，由Evans蓝吸收的标准曲线染料渗出量，结果对照组、阿斯匹林组、山茱萸5.10g/kg组染料渗出量（ug/ml）分别为91±1.6，4.9±2.5（P＜0.01），5.3±2.0（P＜0.01），5.5±2.8（P＜0.01）（x±S，n=10）。可见不同剂量山茱萸对醋酸引起的大鼠腹腔毛细血管通透性增加均有明显抑制作用。"}]},{"ID":"20240612101010-ettags7","Type":"NodeParagraph","Properties":{"id":"20240612101010-ettags7","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.2抑制二甲苯所致小鼠耳廓肿胀雄性昆明种小鼠，体重18-22g，给药组连续5dig山茱萸10.20g/kg，末次给药后1h，将二甲苯30ul涂于小鼠右耳廓，左耳廓作对照，2小时后剪下耳廓并以直径9mm打孔器取下耳片，称重。结果对照组、山茱萸10.20g/kg组小鼠左右耳廓重量差（mg）分别为18.2±4.5，9·9±4.5（P＜0.01），11.3±4.3（P＜0·01），（n＝10）。表明山茱萸显着抑制二甲苯所致小鼠耳廓肿胀。"}]},{"ID":"20240612101010-fjki2gd","Type":"NodeParagraph","Properties":{"id":"20240612101010-fjki2gd","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.3抑制致炎剂引起的大鼠足垫肿胀 雄性SD大鼠，体重120-160g，阳性对照组、给药组分别连续5dig阿斯匹林50mg/kg及山茱萸5g/kg，末次给药后l小时，于大鼠右后足垫scl%角叉菜胶成新鲜蛋清0.1ml，致炎后每小时以千分卡测量一次足垫肿胀度（mm），结果山茱萸5g/kg对蛋清所致肿胀具有明显抑制作用，而对角叉菜胶所致足垫肿胀仅在1小时时抑制作用显着。"}]},{"ID":"20240612101010-woy4x4q","Type":"NodeParagraph","Properties":{"id":"20240612101010-woy4x4q","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.4抑制大鼠棉球肉芽组织增生 雄性Wistar大鼠，体重150-220g，乙醚麻醉，于两侧前肢腋窝下各埋植20mg重消毒棉球一个，阳性对照组、给药组分别连续sc氢化可的松10mg/kg及ig山茱萸5，10g/kg，大鼠于d8放血处死，剥离肉芽组织，80℃烘烤3小时后称重，并同时取各鼠胸腺、肾上腺称重。由表12可见山茱萸明显抑制大鼠棉球肉芽组织增生，对胸腺及肾上腺重量无显着影响。"}]},{"ID":"20240612101010-rrcd106","Type":"NodeParagraph","Properties":{"id":"20240612101010-rrcd106","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.5降低大鼠肾上腺内抗坏血酸含量 取肉芽肿试验所用大鼠右侧肾上腺,制成匀浆后按2,4一二硝基苯肼显色法测定其中抗坏血酸含量。山茱萸5,10g/kg均使大鼠肾上腺内抗坏血酸含量明显降低。"}]},{"ID":"20240612101010-s1fo4bk","Type":"NodeParagraph","Properties":{"id":"20240612101010-s1fo4bk","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.6对大鼠炎症组织内PGE含量的影响 雄性SD大鼠，体重150-180g。给药组、阳性对照组分别连续5dig山茱萸10g/kg或消炎痛50mg/kg，末次给药后30分钟，于各鼠右后足垫scl%角叉菜胶0.1ml，3小时后处死，将右后足自踝关节上lcm处剪下称重，剥皮后置于5ml生理盐水中浸泡lh，取上清液0.15ml加入0.5mol/L氢氧化钾甲醇液1ml，在50℃水浴异构化20min，加甲醇2.5ml，于278nm处测定紫外吸收值（△A），以每克炎症组织相当的吸收值表示PGE含量，结果山茱萸10g/kg对大鼠致炎足重量及其PGE含量均无明显影响。"}]},{"ID":"20240612101010-jd135e5","Type":"NodeParagraph","Properties":{"id":"20240612101010-jd135e5","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"6.抗癌作用 取健康的小白鼠接种腹水癌细胞液0.1ml。7-8d后生长癌液较多，抽出癌液加一滴至玻璃片上，并加一滴20%山茱萸煎剂及一滴伊红台氏溶液，在显微镜下观癌细胞的死亡情况，如被杀死则细胞染成红色，未死则仍为无色透明状。对照的正常细胞为唾液腺细胞和精巢细胞。实验结果表明，山茱萸能够杀死全部癌细胞；精巢细胞亦有同样作用，但对唾液腺细胞仅有小部分被杀死。"}]},{"ID":"20240612101010-wwu8x0z","Type":"NodeParagraph","Properties":{"id":"20240612101010-wwu8x0z","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"7.其他作用 早年曾报告，流浸膏对麻醉犬有利尿作用，且能使血压降低，对正常家兔血糖无影响。上述酸性液，对蛙、小鼠、大鼠、兔的毒性不大，对体重和血象无影响，可致兔胃粘膜轻度充血，但对兔结膜无作用。山茱萸甙毒性很低，不溶血，但有较弱的兴奋副交感神经的作用, 本品具抗氧化作用。"}]},{"ID":"20240612101010-63t7rb4","Type":"NodeParagraph","Properties":{"id":"20240612101010-63t7rb4","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612101010-y1v6axu","Type":"NodeParagraph","Properties":{"id":"20240612101010-y1v6axu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 山萸肉：洗净，除去果核及杂质，晒干。酒山萸：取净山萸肉，用黄酒拌匀，密封容器内，置水锅中，隔水加热，炖至酒吸尽，取出，晾干（山萸肉每100斤，用黄酒20-25斤）。蒸山萸：取净山萸肉，置笼屉内加热蒸黑为度，取出，晒干。"}]},{"ID":"20240612101010-x47f3ao","Type":"NodeParagraph","Properties":{"id":"20240612101010-x47f3ao","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612101010-ifocw73","Type":"NodeParagraph","Properties":{"id":"20240612101010-ifocw73","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 薄层层析：取本品粉末约1g，加乙醚回流脱脂2小时，再用石油醚(60-90℃)回流提取4小时，提取液回收溶剂后，用氯仿-无水乙醇(1:1)混合溶剂溶解供点样。另取熊果酸对照品，用氯仿-无水乙醇(1:1)混合溶剂制成对照品溶液。将两溶液分别点样在同一硅胶G薄层反上，以环已烷-氯仿-醋酸乙酯(20：5：8)展开，晾干，喷10%硫酸乙醇试剂，110℃烘5分钟显色，供试品溶液色谱在与对照品色谱相同位置，有相同紫红色斑点。"}]},{"ID":"20240612101010-2zotxgt","Type":"NodeParagraph","Properties":{"id":"20240612101010-2zotxgt","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612101010-trh3i3v","Type":"NodeParagraph","Properties":{"id":"20240612101010-trh3i3v","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 归肝；肾经"}]},{"ID":"20240612101010-a6p6xi8","Type":"NodeParagraph","Properties":{"id":"20240612101010-a6p6xi8","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612101010-l2c2s4l","Type":"NodeParagraph","Properties":{"id":"20240612101010-l2c2s4l","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 味酸；性微温"}]},{"ID":"20240612101010-mwyofqi","Type":"NodeParagraph","Properties":{"id":"20240612101010-mwyofqi","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612101010-rstnxm8","Type":"NodeParagraph","Properties":{"id":"20240612101010-rstnxm8","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 凡命门火炽，强阳不痿，素有湿热，小便淋涩者忌服。《本草经集注》：蓼实为之使。恶桔梗、防风、防己。"}]},{"ID":"20240612101010-loqnc7g","Type":"NodeParagraph","Properties":{"id":"20240612101010-loqnc7g","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612101010-5elbju5","Type":"NodeParagraph","Properties":{"id":"20240612101010-5elbju5","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 补益肝肾；收敛固脱。主腰头晕目眩；耳聋耳鸣；腰膝酸软；跹精滑精；小便频数；虚汗不止；妇女崩漏"}]},{"ID":"20240612101010-82dszg8","Type":"NodeParagraph","Properties":{"id":"20240612101010-82dszg8","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612101010-gz25jvl","Type":"NodeParagraph","Properties":{"id":"20240612101010-gz25jvl","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-10g；或入丸、散。"}]},{"ID":"20240612101010-ylc93cz","Type":"NodeParagraph","Properties":{"id":"20240612101010-ylc93cz","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612101010-a5fy187","Type":"NodeParagraph","Properties":{"id":"20240612101010-a5fy187","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 1.《渑水燕谈录》：山茱萸能补骨髓者，取其核温涩能秘精气，精气不泄，乃所以补骨髓。今人剥取肉用而弃其核，大非古人之意，如此皆近穿凿，若用《本草》中主疗，只当依本说。或别有主疗，改用根茎者，自从别方。"}]},{"ID":"20240612101010-n459575","Type":"NodeParagraph","Properties":{"id":"20240612101010-n459575","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.《本经》云，止小便利，以其味酸，观八味丸用为主药，其性味可知矣。"}]},{"ID":"20240612101010-4ao43ua","Type":"NodeParagraph","Properties":{"id":"20240612101010-4ao43ua","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.《医学入门》：山茱萸本涩剂也，何以能通发邪？盖诸病皆系下部虚寒，用之补养肝肾，以益其源，则五脏安利，闭者通而利者止，非若他药轻飘疏通之谓也。"}]},{"ID":"20240612101010-immj70z","Type":"NodeParagraph","Properties":{"id":"20240612101010-immj70z","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"4.《本草经疏》：山茱萸治心下邪气寒热，肠胃风邪、寒热头风、风去气来、鼻塞、面疱者，皆肝肾二经所主，二经虚热，故见前证。此药温能通行，辛能走散，酸能入肝，而敛虚热，风邪消散，则心下肠胃寒热自除，头目亦清利而鼻塞面疱悉愈也。逐寒湿痹者，借其辛温散结，行而能补也。气温而主补，味酸而主敛，故精气益而阴强也。精益则五脏自安，九窍自利。又肾与膀胱为表里，膀胱虚寒，则小便不禁，耳为肾之外窍，肾虚则耳聋；肝开窍于目，肝虚则邪热客之而目黄；二经受寒邪，则为疝瘕，二脏得补，则诸证无不瘳矣。"}]},{"ID":"20240612101010-3hrsid9","Type":"NodeParagraph","Properties":{"id":"20240612101010-3hrsid9","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.《药品化义》：山茱萸，滋阴益血，主治目昏耳鸣，口苦舌干，面青色脱，汗出振寒，为补肝助胆良品。夫心乃肝之子，心苦散乱而喜收敛，敛则宁静，静则清和，以此收其涣散，治心虚气弱，惊悸怔忡，即虚则补母之义也。肾乃肝之母，肾喜润恶燥，司藏精气，借此酸能收脱，敛水生津，治遗精，白浊，阳道不兴，小水无节，腰膝软弱，足酸疼，即子令母实之义也。"}]},{"ID":"20240612101010-7xr2mkk","Type":"NodeParagraph","Properties":{"id":"20240612101010-7xr2mkk","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"6.《本草新编》：人有五更泄泻，用山茱萸二两为末，米饭为丸，临睡之时，一刻服尽，即用饭压之，戒饮酒行房，三日而泄泻自愈。盖五更泄泻，乃肾气之虚，山茱萸补肾水，而性又兼涩，一物二用而成功也。推之而精滑可止也，小便可缩也，三虫可杀也。或疑山茱萸性温，阴虚火动者，不宜多服。夫阴虚火动，非山茱萸又何以益阴生水，止其龙雷之虚火哉。凡火动起于水虚，补其水则火自降，温其水则火自安，倘不用山茱萸之益精温肾，而改用黄柏、知母泻水寒肾，吾恐水愈干而火愈燥，肾愈寒而火愈多，势必至下败其脾而上绝其肺，脾肺两坏，人有生气乎。故山茱萸正治阴虚火动之药，不可疑其性温而反助火也。"}]},{"ID":"20240612101010-wwpfqqm","Type":"NodeParagraph","Properties":{"id":"20240612101010-wwpfqqm","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"7.《本经逢原》：山茱萸详能发汗，当是能敛汗之误。以其酸收，无发越之理。仲景八味丸用之，盖肾气受益，则封藏有度，肝阴得养，则疏泄无虞，乙癸同源也。"}]},{"ID":"20240612101010-nzjvh6i","Type":"NodeParagraph","Properties":{"id":"20240612101010-nzjvh6i","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"8.《医学衷中参西录》：山茱萸，大能收敛元气，振作精神，固涩滑脱。收涩之中兼具条畅之性，故又通利九窍，流通血脉，治肝虚自汗，肝虚胁疼腰疼，肝虚内风萌动，且敛正气而不敛邪气，与其他酸敛之药不同，是以《本经》谓其逐寒湿痹也。其核与肉之性相反，用时务须将核去净。近阅医报有言核味涩，性亦主收敛，服之恒使小便不利，椎破尝之，果有有涩味者，其说或可信。凡人元气之脱，皆脱在肝。故人虚极者，其肝风必先动，肝风动，即元气欲脱之兆也。又肝与胆，脏腑相依，胆为少阳，有病主寒热往来；肝为厥阴。虚极亦为寒热往来，为有寒热，故多出汗。萸肉既能敛汗。又善补肝，是以肝虚极而元气将脱者，服之最效。愚初试出此药之能力，以为一己之创见，及详观《神农本经》山茱萸原主寒热，其所主之寒热，即肝经虚极之寒热往来也。《本经》：主心下邪气寒热，温中，逐寒湿痹，去三虫。《雷公炮炙论》：壮元气，秘精。《别录》：肠胃风邪，寒热疝瘕，头风，风气去来，鼻塞，目黄，耳聋，面疱，温中，下气，出汗，强阴，益精，安五脏，通九窍，止小便利，明目，强力。"}]},{"ID":"20240612101010-rw45axn","Type":"NodeParagraph","Properties":{"id":"20240612101010-rw45axn","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：治脑骨痛，止月水不定，补肾气，兴阳道，添精髓，疗耳鸣，除面上疮，主能发汗，止老人尿不节。"}]},{"ID":"20240612101010-z491q0i","Type":"NodeParagraph","Properties":{"id":"20240612101010-z491q0i","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"10.《日华子本草》：暖腰膝，助水脏，除一切风，逐一切气，破症结，治酒皶。"}]},{"ID":"20240612101010-m8fd904","Type":"NodeParagraph","Properties":{"id":"20240612101010-m8fd904","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"11.《珍珠囊》：温肝。"}]},{"ID":"20240612101010-tuftcap","Type":"NodeParagraph","Properties":{"id":"20240612101010-tuftcap","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"12.《本草求原》：止久泻，心虚发热汗出。"}]},{"ID":"20240612101010-v4crmu1","Type":"NodeParagraph","Properties":{"id":"20240612101010-v4crmu1","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612101010-1t5x345","Type":"NodeParagraph","Properties":{"id":"20240612101010-1t5x345","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612101010-axsi28v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612101010-axsi28v","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：山茱萸"}]},{"ID":"20240612101010-okfmfwt","Type":"NodeParagraph","Properties":{"id":"20240612101010-okfmfwt","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612101010-8e4wwvw","Type":"NodeParagraph","Properties":{"id":"20240612101010-8e4wwvw","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" Shān Zhū Yú"}]},{"ID":"20240612101010-9zn6ntw","Type":"NodeParagraph","Properties":{"id":"20240612101010-9zn6ntw","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612101010-w8bga3f","Type":"NodeParagraph","Properties":{"id":"20240612101010-w8bga3f","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 萸肉、山萸肉、药枣、枣皮。"}]},{"ID":"20240612101010-rcmyhtu","Type":"NodeParagraph","Properties":{"id":"20240612101010-rcmyhtu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612101010-c6m7vbf","Type":"NodeParagraph","Properties":{"id":"20240612101010-c6m7vbf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 为山茱萸科灯台树属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山茱萸"},{"Type":"NodeText","Data":"Cornusofficinalis Sieb.et Zucc.,[Macrocarpium officinale(Sieb. Et Zucc.)Nakai]以除去种子的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"入药。秋季霜降后，果实变红时采摘，用炭火烘焙至适度，去种子，再晒干，即为山萸肉。"}]},{"ID":"20240612101010-lmprp3j","Type":"NodeParagraph","Properties":{"id":"20240612101010-lmprp3j","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612101010-tza8ayl","Type":"NodeParagraph","Properties":{"id":"20240612101010-tza8ayl","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 生于山坡灌木丛中，分布于山西、陕西、山东、安徽、浙江、河南、四川等省。"}]},{"ID":"20240612101010-7riyetu","Type":"NodeParagraph","Properties":{"id":"20240612101010-7riyetu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612101010-8vfab30","Type":"NodeParagraph","Properties":{"id":"20240612101010-8vfab30","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 落叶灌木或小乔木，高约4米。树皮淡褐色，成薄片剥裂。枝皮灰棕色，小枝无毛。单叶对生，具短柄；叶片椭圆形或长椭圆形，长5"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"12厘米，宽3"},{"Type":"NodeText","Data":"4.5厘米，先端渐尖，基部圆或楔形，全缘，上面蔬生平贴毛，下面粉绿色，毛较密，侧脉6~8对，脉液有黄褐色毛丛。夏季先叶开黄色花，伞形花序顶生或腋生，基部具4个小型苞皮，花萼裂片4，不明显；花瓣4，长约3毫米；雄蕊4，与花瓣互生；子房下位，2室，花柱1。核果长椭圆形，光滑，熟时红色，果梗细长，果皮干后呈网纹状。种子长椭圆形，两端钝圆。"}]},{"ID":"20240612101010-wumwbrx","Type":"NodeParagraph","Properties":{"id":"20240612101010-wumwbrx","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612101010-mcd4pq0","Type":"NodeParagraph","Properties":{"id":"20240612101010-mcd4pq0","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 喜阳光、宜肥沃疏松的砂质壤土种植。用种子繁殖，播前应行催芽，即选无病、饱满子种，于向阳排灌方便的地方，挖长6尺、宽3尺、深8寸的坑。每坑放子种100斤。将坑整平后，先铺细沙一层，上铺一层种子，再放一层细沙，如此反复铺放三层，最上一层铺沙1寸以上，坑口留4寸深，以利保墒。春季萸芽长1分许下种，条播，行距0.8"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"1尺；点播，每簇2"},{"Type":"NodeText","Data":"3粒，播后约一周出苗。移栽是在第二年秋末进行，行株距约7~8尺。"}]},{"ID":"20240612101010-j0hiwl5","Type":"NodeParagraph","Properties":{"id":"20240612101010-j0hiwl5","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612101010-tb5qkzr","Type":"NodeParagraph","Properties":{"id":"20240612101010-tb5qkzr","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 果实含山茱萸甙（即马鞭草甙cornin或verbenalin）、番木虌甙（loganin）、皂甙、鞣质、维生素A样物质、没食子酸、苹果酸、酒石酸及一种熔点为245的结晶性酸。"}]},{"ID":"20240612101010-zmyyuqb","Type":"NodeParagraph","Properties":{"id":"20240612101010-zmyyuqb","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612101010-unkd3pt","Type":"NodeParagraph","Properties":{"id":"20240612101010-unkd3pt","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 1.动物实验证实山茱萸有利尿降压作用。"}]},{"ID":"20240612101010-cgowyxu","Type":"NodeParagraph","Properties":{"id":"20240612101010-cgowyxu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.山茱萸能能对抗组胺、氧化钡及乙酰胆碱所引起的肠管痉挛。"}]},{"ID":"20240612101010-ahfrz3l","Type":"NodeParagraph","Properties":{"id":"20240612101010-ahfrz3l","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.抑菌实验；山茱萸在体外对志贺氏痢疾杆菌及金黄色葡萄球菌均有抑制作用。"}]},{"ID":"20240612101010-5pf14ai","Type":"NodeParagraph","Properties":{"id":"20240612101010-5pf14ai","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"4.山茱萸对于因化学疗法及放射线疗法引起的白血球下降，有使其升高的作用。"}]},{"ID":"20240612101010-qbhsex6","Type":"NodeParagraph","Properties":{"id":"20240612101010-qbhsex6","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612101010-3sxd8cf","Type":"NodeParagraph","Properties":{"id":"20240612101010-3sxd8cf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 酒山萸 将拣净去核的山萸肉，用黄酒拌匀，放罐内或其他容器内，封严，放在加水的锅中，蒸至酒被吸尽，取出晾干（每100斤用黄酒20斤）。"}]},{"ID":"20240612101010-zl3uzhz","Type":"NodeParagraph","Properties":{"id":"20240612101010-zl3uzhz","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"蒸山萸 将拣净去核的山萸肉，放罐内或笼屉等容器内封严，放在加水的锅中，蒸至外面呈黑色时，取出晾干。"}]},{"ID":"20240612101010-kgnv91z","Type":"NodeParagraph","Properties":{"id":"20240612101010-kgnv91z","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612101010-3dnm70w","Type":"NodeParagraph","Properties":{"id":"20240612101010-3dnm70w","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 酸、涩，微温。"}]},{"ID":"20240612101010-yw57ugr","Type":"NodeParagraph","Properties":{"id":"20240612101010-yw57ugr","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612101010-871glfj","Type":"NodeParagraph","Properties":{"id":"20240612101010-871glfj","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 补益肝肾，涩精止汗。头晕目眩，耳聋，自汗，腰膝酸软，阳痿，遣精，尿频。"}]},{"ID":"20240612101010-u7tt2vu","Type":"NodeParagraph","Properties":{"id":"20240612101010-u7tt2vu","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612101010-iyx5sr3","Type":"NodeParagraph","Properties":{"id":"20240612101010-iyx5sr3","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 1~3钱。"}]},{"ID":"20240612101010-yyw8ec1","Type":"NodeParagraph","Properties":{"id":"20240612101010-yyw8ec1","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612101010-smahsn3","Type":"NodeParagraph","Properties":{"id":"20240612101010-smahsn3","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 1.肾虚腰痛，阳痿遣精；山茱萸、补骨脂、菟丝子、金樱子各4钱，当归3钱，水煎服。"}]},{"ID":"20240612101010-eebz1ub","Type":"NodeParagraph","Properties":{"id":"20240612101010-eebz1ub","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"2.自汗；山茱萸、党参各5钱，五味子3钱，水煎服。"}]},{"ID":"20240612101010-fjde3vw","Type":"NodeParagraph","Properties":{"id":"20240612101010-fjde3vw","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"3.汗出不止；山茱萸、白术各5钱，生龙骨、生牡蛎各1两（先煎），水煎服。"}]},{"ID":"20240612101010-cxuakcm","Type":"NodeParagraph","Properties":{"id":"20240612101010-cxuakcm","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"4.遣尿；山茱萸、丹皮、茯苓、覆盆子(酒炒)、肉桂、附片（盐炒）、甘草各1钱。水煎服。"}]},{"ID":"20240612101010-2heaxrf","Type":"NodeParagraph","Properties":{"id":"20240612101010-2heaxrf","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"5.老人尿频失禁；山茱萸3钱，五味子1.5钱，益智人2钱，水煎服。"}]},{"ID":"20240612101010-q1ox9gk","Type":"NodeParagraph","Properties":{"id":"20240612101010-q1ox9gk","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612101010-3kk0wjy","Type":"NodeParagraph","Properties":{"id":"20240612101010-3kk0wjy","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 山茱萸别名枣皮云南地区产一种滇枣皮，又名酸枣皮，西西果皮，为鼠李科枣属"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滇刺枣"},{"Type":"NodeText","Data":"Zizy-phus mauritiana Lam.的果皮，四川德昌、会理等地有一种土枣皮，则为蔷薇科樱桃属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"雕核樱"},{"Type":"NodeText","Data":"pru-nus pleiocerasus Koehne的果皮，均应注意鉴别。"}]},{"ID":"20240612101010-vla8hd6","Type":"NodeParagraph","Properties":{"id":"20240612101010-vla8hd6","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612101010-uewwy51","Type":"NodeParagraph","Properties":{"id":"20240612101010-uewwy51","updated":"20240612101010"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612101012-h6pju6m","Type":"NodeThematicBreak","Properties":{"id":"20240612101012-h6pju6m"}},{"ID":"20240612101013-859ioh7","Type":"NodeParagraph","Properties":{"id":"20240612101013-859ioh7"}}]}