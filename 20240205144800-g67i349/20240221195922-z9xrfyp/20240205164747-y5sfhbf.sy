=\"width: 782px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 452px;","style":"width: 442px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芡实 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芡实 14-20240812105918-6304nre.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 442px;\" parent-style=\"width: 452px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812110841-74v90b5","Type":"NodeParagraph","Properties":{"id":"20240812110841-74v90b5","updated":"20240812110848"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 615px;","style":"width: 605px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芡实 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芡实 19-20240812110841-7a9fxfd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 605px;\" parent-style=\"width: 615px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芡实 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芡实 9-20240812105314-ad9xf2i.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812105238-vpjlz8u","Type":"NodeParagraph","Properties":{"id":"20240812105238-vpjlz8u","updated":"20240812110848"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 631px;","style":"width: 621px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芡实 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芡实 6-20240812105039-b1tzm07.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 621px;\" parent-style=\"width: 631px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 610px;","style":"width: 600px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芡实 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芡实 7-20240812105141-dhbvpzk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 600px;\" parent-style=\"width: 610px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812105728-o8be7tp","Type":"NodeParagraph","Properties":{"id":"20240812105728-o8be7tp","updated":"20240812105728"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1226px;","style":"width: 1216px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芡实 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芡实 13-20240812105728-o8q9004.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1216px;\" parent-style=\"width: 1226px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611101730-e1f8ghe","Type":"NodeParagraph","Properties":{"id":"20240611101730-e1f8ghe","updated":"20240621132839"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：芡实睡莲科水生草本植物芡的种子。"}]},{"ID":"20240611101919-fztx3wh","Type":"NodeThematicBreak","Properties":{"id":"20240611101919-fztx3wh"}},{"ID":"20240611102024-njwiapm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102024-njwiapm","updated":"20240611102510"},"Children":[{"Type":"NodeText","Data":"芡实《本草乘雅半偈》"}]},{"ID":"20240611102022-ihrf0n5","Type":"NodeParagraph","Properties":{"id":"20240611102022-ihrf0n5","updated":"20240611102022"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240611102022-zn2aazq","Type":"NodeParagraph","Properties":{"id":"20240611102022-zn2aazq","updated":"20240611102022"},"Children":[{"Type":"NodeText","Data":"【气味】甘涩平，无毒。"}]},{"ID":"20240611102022-dnzhg5i","Type":"NodeParagraph","Properties":{"id":"20240611102022-dnzhg5i","updated":"20240611102022"},"Children":[{"Type":"NodeText","Data":"【主治】主湿痹，腰脊膝痛，补中，除暴疾，益精气，强志，令耳目聪明。久服轻身，不饥，耐老神仙。"}]},{"ID":"20240611102022-3xhj11z","Type":"NodeParagraph","Properties":{"id":"20240611102022-3xhj11z","updated":"20240611102022"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出雷池池泽，处处亦有，武林者最胜。土人善纪孕实时日，如期采取，则壳柔肉糯，早则壳烂肉未凝，迟则壳坚肉粳老矣。三月生苗，茎在水中，叶贴水面，茎叶多有芒刺，茎长丈余者，中必有孔有丝，软者剥皮可食。叶似荷而大，皱纹如 ，蹙衄如沸，面青背紫。五六月作花紫色，花开向日。向日结苞，外有青刺如 ，形如栗球，花出苞顶，形如鸡喙，剥之内有斑驳软肉裹子，累累如珠玑。壳内有白米，状如鱼目。根作三棱，煮食如芋。尔雅翼曰∶枚食细嚼，能致上池之津，故主益人。犹如马啮短草则肥悦，与小儿食，不易长大，故主驻年。芡与菱，皆水物而性异。芡花向日，菱花背日，其阴阳向背有不同，则损益阴阳亦别异矣。埤雅云∶荷华日舒夜敛，芡华昼合宵炕，此亦阴阳之异也。修治，先蒸熟，日中晒裂取仁亦可，舂取粉用。暇日记云∶芡实一斗，以防风四两煎汤浸过，经久不坏。"}]},{"ID":"20240611102022-d79l910","Type":"NodeParagraph","Properties":{"id":"20240611102022-d79l910","updated":"20240611102022"},"Children":[{"Type":"NodeText","Data":"【 】曰∶芡生水中，华实向日，具既济水火义。又草木类，全藉水土，吮抽发育，芡则更藉日中火，为先后身，亦具木胎火里义。又叶上蹙衄如沸，连茎刺棘如 ，实皮实壳如介，亦具金胎水中义。诚互交木金火水之驻形物也。如益精强志不饥，即驻形之里应；目明耳聪轻身耐老，即驻形之外合；飞行神仙，即驻形之行圆功满也。未有形已驻，而中央之基不筑已不炼者；若湿痹之腰脊膝痛，及卒暴疾，即驻形物之主治功能也。先人博议云∶芡乃大中之小，粗中之精，涩中之甘，荆棘中之软美，壅滞中之流行，意阑中之气悟，疲惫中之强武。然于精细甘美之间，所含畜力，且刚且久，故饵食者，贵细贵长，毋贵多贵数也。"}]},{"ID":"20240611102022-wvyihil","Type":"NodeParagraph","Properties":{"id":"20240611102022-wvyihil","updated":"20240611102022"},"Children":[{"Type":"NodeText","Data":"（龙从火里得，金向水中求，寻胞胎秘旨也。大中粗中，荆棘壅滞，意阑疲惫之流，望之无不抛却，若非前人具眼，几至当面错过。）"}]},{"ID":"20240611102516-pppf93e","Type":"NodeThematicBreak","Properties":{"id":"20240611102516-pppf93e"}},{"ID":"20240611102517-30r3fk6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102517-30r3fk6","updated":"20240611102522"},"Children":[{"Type":"NodeText","Data":"芡实《本草择要纲目》"}]},{"ID":"20240611102517-gn8w9vu","Type":"NodeParagraph","Properties":{"id":"20240611102517-gn8w9vu","updated":"20240611102517"},"Children":[{"Type":"NodeText","Data":"（一名鸡头．）"}]},{"ID":"20240611102517-nx94wse","Type":"NodeParagraph","Properties":{"id":"20240611102517-nx94wse","updated":"20240611102517"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611102517-361yfcl","Type":"NodeParagraph","Properties":{"id":"20240611102517-361yfcl","updated":"20240611102517"},"Children":[{"Type":"NodeText","Data":"甘平涩无毒．"}]},{"ID":"20240611102517-ojui4d4","Type":"NodeParagraph","Properties":{"id":"20240611102517-ojui4d4","updated":"20240611102517"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611102517-tc7evyg","Type":"NodeParagraph","Properties":{"id":"20240611102517-tc7evyg","updated":"20240611102524"},"Children":[{"Type":"NodeText","Data":"湿痹腰脊膝痛．补中除暴疾．益精气．强志．令耳目聪明．久服轻身不饥耐老．开胃助气．止渴益肾．治小便不禁遗精白浊带下．小儿多食令不长．生食多动风冷气．食多不益脾胃．兼难消化．作粉食益人胜于也．"}]},{"ID":"20240611102534-8h8p9nf","Type":"NodeThematicBreak","Properties":{"id":"20240611102534-8h8p9nf"}},{"ID":"20240611102535-yc44iaf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102535-yc44iaf","updated":"20240611102545"},"Children":[{"Type":"NodeText","Data":"芡实《本草述钩元》"}]},{"ID":"20240611102535-v7w9soj","Type":"NodeParagraph","Properties":{"id":"20240611102535-v7w9soj","updated":"20240611102535"},"Children":[{"Type":"NodeText","Data":"味甘涩。气平。入足太阴少阴经。主治益精气强志。开胃助气。益脾实肠。固精。治小便不禁。遗精白浊带下。疗湿痹腰脊膝痛。止泻固精。独于脾肾得力。先后天之根本咸赖焉。（士材）君山药茯苓白术人参莲肉薏仁扁豆。为补脾胃要药。一味捣烂曝干。再捣筛末。"}]},{"ID":"20240611102535-9xsrcht","Type":"NodeParagraph","Properties":{"id":"20240611102535-9xsrcht","updated":"20240611102535"},"Children":[{"Type":"NodeText","Data":"熬金樱子膏和丸。服之补下元。益人。四精丸。治思虑色欲过度。损伤心气。小便数。遗精用秋石白茯苓芡实莲肉各二两。为末。蒸枣和丸。梧子大。每服三十丸。空心盐汤下。厘清丸。治浊。用芡实茯苓二粉。黄蜡化蜜和丸。梧子大。每服百丸。盐汤下。"}]},{"ID":"20240611102535-9t8hoxj","Type":"NodeParagraph","Properties":{"id":"20240611102535-9t8hoxj","updated":"20240611102535"},"Children":[{"Type":"NodeText","Data":"〔论〕芡生于水中。五六月作花紫色。开花向日。向日结苞。夫产于水中者。类受阴气。"}]},{"ID":"20240611102535-0qr3z4o","Type":"NodeParagraph","Properties":{"id":"20240611102535-0qr3z4o","updated":"20240611102535"},"Children":[{"Type":"NodeText","Data":"于阴惟其有经。而生食味涩。动风冷气。小儿不宜多食。（仲淳）〔修治〕新者煮食良。入涩精药。连壳用亦可。"}]},{"ID":"20240611101936-7t93hzz","Type":"NodeThematicBreak","Properties":{"id":"20240611101936-7t93hzz"}},{"ID":"20240611102009-s88zgl5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102009-s88zgl5","updated":"20240611102017"},"Children":[{"Type":"NodeText","Data":"芡实《中药炮制》"}]},{"ID":"20240611102009-pnn3kdj","Type":"NodeParagraph","Properties":{"id":"20240611102009-pnn3kdj","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『来源』本品为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芡"},{"Type":"NodeText","Data":"的干燥成熟种仁。"}]},{"ID":"20240611102009-r4iule1","Type":"NodeParagraph","Properties":{"id":"20240611102009-r4iule1","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『常用名』鸡头包、剪芡、北芡实、苏芡实。"}]},{"ID":"20240611102009-gdhn1jq","Type":"NodeParagraph","Properties":{"id":"20240611102009-gdhn1jq","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『产地』江苏、安徽、山东、湖北等地。"}]},{"ID":"20240611102009-hdgs6xr","Type":"NodeParagraph","Properties":{"id":"20240611102009-hdgs6xr","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『采收季节』9～10月采收。"}]},{"ID":"20240611102009-5rz60mb","Type":"NodeParagraph","Properties":{"id":"20240611102009-5rz60mb","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『炮制方法』拣去杂质和硬壳，若取其治慢性泄泻，将锅烧热撒入麦麸，候冒烟时投入芡实，炒至黄色为度。"}]},{"ID":"20240611102009-gutvvyi","Type":"NodeParagraph","Properties":{"id":"20240611102009-gutvvyi","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『用量』9～12克。"}]},{"ID":"20240611102009-ur7ye7s","Type":"NodeParagraph","Properties":{"id":"20240611102009-ur7ye7s","updated":"20240611102009"},"Children":[{"Type":"NodeText","Data":"『贮存』装铁箱内加盖，防潮及虫蛀。"}]},{"ID":"20240611102615-dzez41l","Type":"NodeThematicBreak","Properties":{"id":"20240611102615-dzez41l"}},{"ID":"20240611102616-rd0hrdz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102616-rd0hrdz","updated":"20240611102621"},"Children":[{"Type":"NodeText","Data":"芡实《雷公炮制药性解》"}]},{"ID":"20240611102616-0nyfaqe","Type":"NodeParagraph","Properties":{"id":"20240611102616-0nyfaqe","updated":"20240611102616"},"Children":[{"Type":"NodeText","Data":"味甘，性平无毒，入心肾脾胃四经。主安五脏，补脾胃，益精气，止遗泄，暖腰膝，去湿痹，明耳目，治健忘。"}]},{"ID":"20240611102616-oe1tjq4","Type":"NodeParagraph","Properties":{"id":"20240611102616-oe1tjq4","updated":"20240611102616"},"Children":[{"Type":"NodeText","Data":"按∶芡实之甘，宜归脾胃，土得其宜，则水不受克，火亦无盗食之虞，故又入心肾二经。"}]},{"ID":"20240611102627-ywrogs1","Type":"NodeThematicBreak","Properties":{"id":"20240611102627-ywrogs1"}},{"ID":"20240611102629-l29hn42","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102629-l29hn42","updated":"20240611102633"},"Children":[{"Type":"NodeText","Data":"芡实《本草备要》"}]},{"ID":"20240611102629-owsqe50","Type":"NodeParagraph","Properties":{"id":"20240611102629-owsqe50","updated":"20240611102635"},"Children":[{"Type":"NodeText","Data":"一名鸡头子"}]},{"ID":"20240611102629-u9se2b7","Type":"NodeParagraph","Properties":{"id":"20240611102629-u9se2b7","updated":"20240611102629"},"Children":[{"Type":"NodeText","Data":"补脾，涩精"}]},{"ID":"20240611102629-kxaejql","Type":"NodeParagraph","Properties":{"id":"20240611102629-kxaejql","updated":"20240611102629"},"Children":[{"Type":"NodeText","Data":"甘涩。固肾益精，补脾去湿。治泄泻带浊，小便不禁，梦遗滑精（同金樱膏为丸，名水陆二仙丹），腰漆瘀痛（吴子野曰∶人之食芡，必枚啮而细嚼之，使华液流通，转相灌溉，其功胜于乳石也。《经验后方》∶煮熟研膏，合粳米煮粥食，益精气）。蒸熟捣粉用，涩精药或连壳用（李惟熙曰∶菱寒而芡暖，菱花背日，芡花向日）。"}]},{"ID":"20240611102646-ejj2761","Type":"NodeThematicBreak","Properties":{"id":"20240611102646-ejj2761"}},{"ID":"20240611102648-azrprfa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102648-azrprfa","updated":"20240611102654"},"Children":[{"Type":"NodeText","Data":"芡实《要药分剂》"}]},{"ID":"20240611102648-2p2szxr","Type":"NodeParagraph","Properties":{"id":"20240611102648-2p2szxr","updated":"20240611102648"},"Children":[{"Type":"NodeText","Data":"味甘。性平。无毒。禀水土之气以生。可升可降。阴也。"}]},{"ID":"20240611102648-75433dw","Type":"NodeParagraph","Properties":{"id":"20240611102648-75433dw","updated":"20240611102648"},"Children":[{"Type":"NodeText","Data":"【主治】主湿痹腰脊膝痛。补中。除暴疾。益精气。强志。聪耳明目。（本经）止渴。"}]},{"ID":"20240611102648-hl5rofx","Type":"NodeParagraph","Properties":{"id":"20240611102648-hl5rofx","updated":"20240611102648"},"Children":[{"Type":"NodeText","Data":"益肾【归经】入脾胃二经。兼入心肾二经。为固本益精之品。（兼补剂）【前论】张子野曰。人之食芡。必枚啮而细嚼之。使华液流通。转相灌输。其功胜于乳汁也【禁忌】经疏曰。生食动风冷气。小儿不宜多食。以难化也。"}]},{"ID":"20240611102752-bimbjr7","Type":"NodeThematicBreak","Properties":{"id":"20240611102752-bimbjr7"}},{"ID":"20240611102753-javxgv0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102753-javxgv0","updated":"20240611102758"},"Children":[{"Type":"NodeText","Data":"芡实《得配本草》"}]},{"ID":"20240611102753-d8xk29q","Type":"NodeParagraph","Properties":{"id":"20240611102753-d8xk29q","updated":"20240611102753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名鸡头"}]},{"ID":"20240611102753-r1u0ah8","Type":"NodeParagraph","Properties":{"id":"20240611102753-r1u0ah8","updated":"20240611102753"},"Children":[{"Type":"NodeText","Data":"甘、平、涩。入足少阴、太阴经。补脾助气，固肾涩精。治遗浊滞下，小便不禁。得金樱子，涩精。配秋石、莲肉、大枣，为丸盐汤下，治便数精滑。佐生地，止血。合菟丝子，实大便。"}]},{"ID":"20240611102709-mxqb8b1","Type":"NodeThematicBreak","Properties":{"id":"20240611102709-mxqb8b1"}},{"ID":"20240611102710-s59b3fx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102710-s59b3fx","updated":"20240611102714"},"Children":[{"Type":"NodeText","Data":"芡实《本草从新》"}]},{"ID":"20240611102710-mzdjq3q","Type":"NodeParagraph","Properties":{"id":"20240611102710-mzdjq3q","updated":"20240611102710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名鸡头．补脾涩精．"}]},{"ID":"20240611102710-67t6hxa","Type":"NodeParagraph","Properties":{"id":"20240611102710-67t6hxa","updated":"20240611102710"},"Children":[{"Type":"NodeText","Data":"甘平而涩．补脾固肾．助气涩精．治梦遗滑精．解暑热酒毒．疗带浊泄泻．小便不禁．"}]},{"ID":"20240611102710-478k1su","Type":"NodeParagraph","Properties":{"id":"20240611102710-478k1su","updated":"20240611102710"},"Children":[{"Type":"NodeText","Data":"大小便不利者勿服．小儿不宜多食．甚难消化．蒸熟捣粉．涩精药．或连壳用．"}]},{"ID":"20240611102659-bvobp2a","Type":"NodeThematicBreak","Properties":{"id":"20240611102659-bvobp2a"}},{"ID":"20240611102701-of465j4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611102701-of465j4","updated":"20240611102705"},"Children":[{"Type":"NodeText","Data":"芡实《玉楸药解》"}]},{"ID":"20240611102701-c96hxt2","Type":"NodeParagraph","Properties":{"id":"20240611102701-c96hxt2","updated":"20240611102701"},"Children":[{"Type":"NodeText","Data":"味甘，性涩，入手太阴肺、足少阴肾经。止遗精，收带下。"}]},{"ID":"20240611102701-ueoyl7s","Type":"NodeParagraph","Properties":{"id":"20240611102701-ueoyl7s","updated":"20240611102701"},"Children":[{"Type":"NodeText","Data":"芡实固涩滑泄，治遗精失溺、白浊带下之病。"}]},{"ID":"20240611101947-p20iogd","Type":"NodeThematicBreak","Properties":{"id":"20240611101947-p20iogd"}},{"ID":"20240611101956-au36mhz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101956-au36mhz","updated":"20240611102004"},"Children":[{"Type":"NodeText","Data":"芡实《本草便读》"}]},{"ID":"20240611101956-qlx43w3","Type":"NodeParagraph","Properties":{"id":"20240611101956-qlx43w3","updated":"20240611101956"},"Children":[{"Type":"NodeText","Data":"扶脾止泻．治水则同气相求．固肾益精．性味则甘平无毒．（芡实生于水而能治水．诸家本草皆谓甘平性涩．然尝之似无涩味．仅觉甘淡而已．此亦邪水去而真水固也．味甘入脾．水属入肾．扶土利水．是其本功．毕竟称其能涩精固气．恐亦未必．岂一物而有通涩二用哉．或此药同山药等味则补．同苡仁等味则利．同金樱子等则涩．各随其用耳．）"}]},{"ID":"20240611101947-s26tmpd","Type":"NodeThematicBreak","Properties":{"id":"20240611101947-s26tmpd"}},{"ID":"20240611101948-w1te35n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101948-w1te35n","updated":"20240611101952"},"Children":[{"Type":"NodeText","Data":"芡实《本草经解》"}]},{"ID":"20240611101948-dhxdz20","Type":"NodeParagraph","Properties":{"id":"20240611101948-dhxdz20","updated":"20240611101948"},"Children":[{"Type":"NodeText","Data":"气平涩．味甘．无毒．主湿痹．腰脊膝痛．补中．除暴疾．益精气．强志．令耳目聪明．久服轻身不饥．耐老神仙．（炒）"}]},{"ID":"20240611101948-6q9mvoa","Type":"NodeParagraph","Properties":{"id":"20240611101948-6q9mvoa","updated":"20240611101948"},"Children":[{"Type":"NodeText","Data":"芡实气平涩．禀天秋收之金气．入手太阴肺经．味甘无毒．得地中正之土味．入足太阴脾经．气味降多于升．阴也．脾为湿土而统血．湿邪伤于下．则走腰脊膝．致血泣而成痹．芡实甘平．则益脾肺．肺通水道则湿行．脾和则血活．而痹者瘳矣．中者脾也．味甘益脾．故能补中．暴疾多属于火．得水之精者．多能抑火．芡实味甘属土．而生于水．所以制火而主暴疾．肾藏精．肺为金而肾为水．气平益肺．肺气旺则生精．金生水也．味甘益脾．脾气升．气平益肺．肺气降．升降如．则天清地宁．养之以刚大．而志强矣．味甘益脾．脾统血．目得血则明．耳得血则聪．故令耳目聪明也．久服气平益肺．肺气充则身轻．味甘益脾．脾血旺耐老不饥也．肺脾气血充足．神仙有自来矣．"}]},{"ID":"20240611101948-4fzhm22","Type":"NodeParagraph","Properties":{"id":"20240611101948-4fzhm22","updated":"20240611101948"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611101948-3bdlgmd","Type":"NodeParagraph","Properties":{"id":"20240611101948-3bdlgmd","updated":"20240611101948"},"Children":[{"Type":"NodeText","Data":"芡实同金樱子丸．补下元虚．同白茯、秋石、莲肉、枣肉丸．治便数遗精．"}]},{"ID":"20240611101936-rb38ztv","Type":"NodeThematicBreak","Properties":{"id":"20240611101936-rb38ztv"}},{"ID":"20240611101937-74r4qnm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101937-74r4qnm","updated":"20240611101942"},"Children":[{"Type":"NodeText","Data":"芡实《本草新编》"}]},{"ID":"20240611101937-vzvbzmk","Type":"NodeParagraph","Properties":{"id":"20240611101937-vzvbzmk","updated":"20240611101937"},"Children":[{"Type":"NodeText","Data":"芡实，味甘，气平，无毒。入脾、肾二经。主湿痹，止腰膝疼痛，益精，令耳目聪明，强志补中，除暴疾，久食延龄益寿。视之若平常，用之大有利益。可君可臣，而又可佐使者也。"}]},{"ID":"20240611101937-y7bajbt","Type":"NodeParagraph","Properties":{"id":"20240611101937-y7bajbt","updated":"20240611101937"},"Children":[{"Type":"NodeText","Data":"其功全在补肾去湿。夫补肾之药，大都润泽者居多，润泽则未免少湿矣。芡实补中去湿，性又不燥，故能去邪水而补神水，与诸补阴之药同用，尤能助之以添精，不虑多投以增湿也。"}]},{"ID":"20240611101937-f5iwaqp","Type":"NodeParagraph","Properties":{"id":"20240611101937-f5iwaqp","updated":"20240611101937"},"Children":[{"Type":"NodeText","Data":"或问芡实平平无奇，而子偏誉之为益精补中之药，何也？曰∶芡实不特益精，且能涩精，补肾至妙药也，子不信其功效乎？夫芡实与山药并用，各为末，日日米饮调服，虽遗精至衰惫者，不旬日而精止神旺矣。至平之药，而实有至奇之功，非世人所能测也。"}]},{"ID":"20240611101937-ax0lpam","Type":"NodeParagraph","Properties":{"id":"20240611101937-ax0lpam","updated":"20240611101937"},"Children":[{"Type":"NodeText","Data":"或问芡实性实平淡，吾子誉其功用，不识益肾补精之外，更有何病可大用乎？曰∶芡实，无症不可大用，而尤可大用者，开胃气耳。胃气大开，何病不藉之以得利。平而实奇，淡而无厌，殆芡实之谓乎。"}]},{"ID":"20240611101937-i4cm8zk","Type":"NodeParagraph","Properties":{"id":"20240611101937-i4cm8zk","updated":"20240611101937"},"Children":[{"Type":"NodeText","Data":"或问芡实平淡无奇而益人，如若，何不日食之作饭乎？曰∶芡实虽不可作饭，然日用之固宜。我有一方，在家、作客，两食之而咸宜。方用芡实二斤、山药二斤、白糯米四斤、白糖一斤、花椒二两，去核，各为末。每日白滚水冲调服一两，最能开胃生精，并无梦遗之病，可服至百岁也。"}]},{"ID":"20240611101937-2evn6h8","Type":"NodeParagraph","Properties":{"id":"20240611101937-2evn6h8","updated":"20240611101937"},"Children":[{"Type":"NodeText","Data":"或疑芡实但能止精，而不能益精，虽精止即是益精，而终不可谓精得芡实而生也，曰∶芡实岂但止精哉。夫遗精之病，必能补而后能止。使芡实不能益精，又何能止精。况芡实不但止精，而亦能生精也。去脾胃中之湿痰，即生肾中之真水。芡实益精，又何疑乎。"}]},{"ID":"20240611101919-njy23kx","Type":"NodeThematicBreak","Properties":{"id":"20240611101919-njy23kx"}},{"ID":"20240611101925-z0d2s8r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101925-z0d2s8r","updated":"20240611101930"},"Children":[{"Type":"NodeText","Data":"芡实《医学入门》"}]},{"ID":"20240611101925-1bfpmn7","Type":"NodeParagraph","Properties":{"id":"20240611101925-1bfpmn7","updated":"20240611101925"},"Children":[{"Type":"NodeText","Data":"芡实甘平主益精，足腰膝痛不能行，治痹补中除暴疾，强志还令耳目明。"}]},{"ID":"20240611101925-omvh55c","Type":"NodeParagraph","Properties":{"id":"20240611101925-omvh55c","updated":"20240611101925"},"Children":[{"Type":"NodeText","Data":"能补人之精欠少，谓之水硫黄。形似鸡头，故又名鸡头实。无毒。东垣云∶芡实益精治白浊，兼补真元。内虚脊腰膝痛，外湿痿痹，补中气开胃进食，除暴疾，强志意，令耳目聪明，久服轻身耐老。但单服多服，亦难消化，生食动风冷气。蒸熟去壳，舂粉益人。根软可作蔬食。"}]},{"ID":"20240611101755-8nhdw6l","Type":"NodeThematicBreak","Properties":{"id":"20240611101755-8nhdw6l"}},{"ID":"20240611101912-k76oykg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101912-k76oykg","updated":"20240611101916"},"Children":[{"Type":"NodeText","Data":"芡实《本草崇原》"}]},{"ID":"20240611101912-u8fj95b","Type":"NodeParagraph","Properties":{"id":"20240611101912-u8fj95b","updated":"20240611101912"},"Children":[{"Type":"NodeText","Data":"气味甘平涩，无毒。主湿痹，腰脊膝痛，补中，除暴疾，益精气，强志，令耳目聪明，久服轻身不饥，耐老神仙。"}]},{"ID":"20240611101912-ribx9c7","Type":"NodeParagraph","Properties":{"id":"20240611101912-ribx9c7","updated":"20240611101912"},"Children":[{"Type":"NodeText","Data":"（芡始出雷池池泽，今处处有之，武林者最胜。三月生叶贴水，似荷而大，皱纹如谷，蹙衄如沸，面青背紫，茎叶皆有刺。五六月开花，紫色，花必向日，结苞处有青刺，如 刺及芡实气味甘平，子黄仁白，生于水中，花开向日，乃阳引而上，阴引而下，故字从欠，得阳明少阴之精气。主治湿痹者，阳明之上，燥气治之也。治腰脊膝痛者，少阴主骨，外合腰膝也。补中者，阳明居中土也。除暴疾者，精气神三虚相搏，则为暴疾。芡实生于水而向日，得水之精，火之神。茎刺肉白，又禀秋金收敛之气，故治三虚之暴疾。益精气，强志，令耳目聪明者，言精气充益，则肾志强。肾志强则耳目聪明。盖心肾开窍于耳，精神共注于目也。久服则积精全神，故轻身不饥，耐老神仙。"}]},{"ID":"20240611101755-5ta09gu","Type":"NodeThematicBreak","Properties":{"id":"20240611101755-5ta09gu"}},{"ID":"20240611101800-03bs17f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101800-03bs17f","updated":"20240611101829"},"Children":[{"Type":"NodeText","Data":"芡实《中药学》"}]},{"ID":"20240611101800-cniwer9","Type":"NodeParagraph","Properties":{"id":"20240611101800-cniwer9","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为睡莲科植物芡的种仁。"}]},{"ID":"20240611101800-duqcxbt","Type":"NodeParagraph","Properties":{"id":"20240611101800-duqcxbt","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、涩，平。入脾、肾经。"}]},{"ID":"20240611101800-ou3ztxh","Type":"NodeParagraph","Properties":{"id":"20240611101800-ou3ztxh","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【功效】益肾固精，健脾止泻，袪湿止带。"}]},{"ID":"20240611101800-hhhm22g","Type":"NodeParagraph","Properties":{"id":"20240611101800-hhhm22g","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肾虚精关不固，梦遗滑精，小便失禁等症。"}]},{"ID":"20240611101800-8zhcojc","Type":"NodeParagraph","Properties":{"id":"20240611101800-8zhcojc","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"芡实益肾而长于收涩，能固下元，故可涩精缩尿，用治梦遗滑精、小便失禁等症，常与金樱子、桑螺峭、菟丝子等配伍同用。"}]},{"ID":"20240611101800-8izvrms","Type":"NodeParagraph","Properties":{"id":"20240611101800-8izvrms","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"2.用于脾虚不运、腹泻不止等症。"}]},{"ID":"20240611101800-pcxexll","Type":"NodeParagraph","Properties":{"id":"20240611101800-pcxexll","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"芡实为滋补敛涩的药品，能扶脾以止泻，治脾虚久泻，常与山药、茯苓、党参、白朮等药配合应用。"}]},{"ID":"20240611101800-w254dfm","Type":"NodeParagraph","Properties":{"id":"20240611101800-w254dfm","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"3.用于妇女白带。"}]},{"ID":"20240611101800-jic9m7i","Type":"NodeParagraph","Properties":{"id":"20240611101800-jic9m7i","updated":"20240611101823"},"Children":[{"Type":"NodeText","Data":"本品能健脾而袪湿，且可固涩而止带，故常用于妇女白带，不论属于湿热带下或脾肾两亏的体虚带下，都可应用。配白果、黄柏、车前子等治湿热带下；配山药、菟丝子、海螵蛸、[ ]牡蛎等治体虚白带。"}]},{"ID":"20240611101800-kg7yu70","Type":"NodeParagraph","Properties":{"id":"20240611101800-kg7yu70","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【处方用名】芡实、南芡实、苏芡实、北芡实（打碎）用。"}]},{"ID":"20240611101800-jhedqva","Type":"NodeParagraph","Properties":{"id":"20240611101800-jhedqva","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至一两，煎服。"}]},{"ID":"20240611101800-jnr5caj","Type":"NodeParagraph","Properties":{"id":"20240611101800-jnr5caj","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【方剂举例】金樱芡实丸（原名水陆二仙丹）《洪氏集验方》：芡实，金樱子治遗精。"}]},{"ID":"20240611101800-m336gz2","Type":"NodeParagraph","Properties":{"id":"20240611101800-m336gz2","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主治湿痹腰脊膝痛，补中，除暴疾，益精气。」"}]},{"ID":"20240611101800-ay1i7ns","Type":"NodeParagraph","Properties":{"id":"20240611101800-ay1i7ns","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「止渴益肾，治小便不禁，遗精，白浊，带下。」"}]},{"ID":"20240611101800-ce7whe0","Type":"NodeParagraph","Properties":{"id":"20240611101800-ce7whe0","updated":"20240611101800"},"Children":[{"Type":"NodeText","Data":"《本草求真》：「功与山药相似。然山药之补，本有过于芡实，而芡实之涩，更有胜于山药，且山药兼补肺阴，而芡实则止于脾肾，而不及于肺。」"}]},{"ID":"20240611101731-mx9cu7d","Type":"NodeThematicBreak","Properties":{"id":"20240611101731-mx9cu7d"}},{"ID":"20240611101749-i5m12c0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101749-i5m12c0","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"《中国药典》：芡实"}]},{"ID":"20240611101749-2zl42wr","Type":"NodeParagraph","Properties":{"id":"20240611101749-2zl42wr","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611101749-kh2w4i2","Type":"NodeParagraph","Properties":{"id":"20240611101749-kh2w4i2","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" Qiàn Shí"}]},{"ID":"20240611101749-wivd3sp","Type":"NodeParagraph","Properties":{"id":"20240611101749-wivd3sp","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611101749-gdzinwf","Type":"NodeParagraph","Properties":{"id":"20240611101749-gdzinwf","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 鸡头米、鸡头"}]},{"ID":"20240611101749-1oudxdw","Type":"NodeParagraph","Properties":{"id":"20240611101749-1oudxdw","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611101749-t1pa1ea","Type":"NodeParagraph","Properties":{"id":"20240611101749-t1pa1ea","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" SEMEN EURYALES"}]},{"ID":"20240611101749-qbx9zkv","Type":"NodeParagraph","Properties":{"id":"20240611101749-qbx9zkv","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611101749-amcxbpj","Type":"NodeParagraph","Properties":{"id":"20240611101749-amcxbpj","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 本品为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芡"},{"Type":"NodeText","Data":"Euryale ferox Salisb. 的干燥成熟"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种仁"},{"Type":"NodeText","Data":"。秋末冬初采收成熟果实，除去果皮，取出种子，洗净，再除去硬壳（外种皮），晒干。"}]},{"ID":"20240611101749-9119v46","Type":"NodeParagraph","Properties":{"id":"20240611101749-9119v46","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611101749-a3ocejz","Type":"NodeParagraph","Properties":{"id":"20240611101749-a3ocejz","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 本品呈类球形，多为破粒，完整者直径5～8mm。表面有棕红色内种皮，一端黄白色，约占全体1/3，有凹点状的种脐痕，除去内种皮显白色。质较硬，断面白色，粉性。无臭，味淡。"}]},{"ID":"20240611101749-4zlr1o8","Type":"NodeParagraph","Properties":{"id":"20240611101749-4zlr1o8","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611101749-0csm40s","Type":"NodeParagraph","Properties":{"id":"20240611101749-0csm40s","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芡实"},{"Type":"NodeText","Data":"：除去杂质。"}]},{"ID":"20240611101749-x56gjry","Type":"NodeParagraph","Properties":{"id":"20240611101749-x56gjry","updated":"20240611101749"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麸炒芡实"},{"Type":"NodeText","Data":"：取净芡实，照麸炒法（附录Ⅱ D）炒至微黄色。"}]},{"ID":"20240611101749-px1bnnb","Type":"NodeParagraph","Properties":{"id":"20240611101749-px1bnnb","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611101749-wq5w1cm","Type":"NodeParagraph","Properties":{"id":"20240611101749-wq5w1cm","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 本品粉末类白色。主为淀粉粒，单粒类圆形，直径1 ～4 μｍ，大粒脐点隐约可见；复粒多数由百余分粒组成，类球形，直径13～35μｍ，少数由 2～3 粒组成。"}]},{"ID":"20240611101749-jq4hke2","Type":"NodeParagraph","Properties":{"id":"20240611101749-jq4hke2","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611101749-eqmmam5","Type":"NodeParagraph","Properties":{"id":"20240611101749-eqmmam5","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 归脾、肾经。"}]},{"ID":"20240611101749-7666q74","Type":"NodeParagraph","Properties":{"id":"20240611101749-7666q74","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611101749-2ap38ik","Type":"NodeParagraph","Properties":{"id":"20240611101749-2ap38ik","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 甘、涩，平。"}]},{"ID":"20240611101749-rmkqrc9","Type":"NodeParagraph","Properties":{"id":"20240611101749-rmkqrc9","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611101749-7akwruu","Type":"NodeParagraph","Properties":{"id":"20240611101749-7akwruu","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 益肾固精，补脾止泻，祛湿止带。用于梦遗滑精，遗尿尿频，脾虚久泻，白浊，带下。"}]},{"ID":"20240611101749-14ym058","Type":"NodeParagraph","Properties":{"id":"20240611101749-14ym058","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611101749-941yqrs","Type":"NodeParagraph","Properties":{"id":"20240611101749-941yqrs","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611101749-qs7mdym","Type":"NodeParagraph","Properties":{"id":"20240611101749-qs7mdym","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611101749-e1jr4wz","Type":"NodeParagraph","Properties":{"id":"20240611101749-e1jr4wz","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611101749-baw3m6b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101749-baw3m6b","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：芡实"}]},{"ID":"20240611101749-3qa91sc","Type":"NodeParagraph","Properties":{"id":"20240611101749-3qa91sc","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611101749-v7xvk7y","Type":"NodeParagraph","Properties":{"id":"20240611101749-v7xvk7y","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" Qiàn Shí"}]},{"ID":"20240611101749-j4rnzsb","Type":"NodeParagraph","Properties":{"id":"20240611101749-j4rnzsb","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611101749-96h7pi9","Type":"NodeParagraph","Properties":{"id":"20240611101749-96h7pi9","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 卵菱（《管子》），鸡瘫（《庄子》），鸡头实、雁喙实（《本经》），鸡头、雁头、乌头（《方言》），艻子（陶弘景），鸿头（韩愈），水流黄（《东坡杂记》），水鸡头（《经验方》），肇实、刺莲藕（《广西中兽医药植》），刀芡实、鸡头果、苏黄、黄实（《江苏植药志》），鸡咀莲（《民间常用草药汇编》），鸡头苞（《江西中药》），刺莲蓬实（《药材学》）。"}]},{"ID":"20240611101749-2xpfzx9","Type":"NodeParagraph","Properties":{"id":"20240611101749-2xpfzx9","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611101749-jnujpbu","Type":"NodeParagraph","Properties":{"id":"20240611101749-jnujpbu","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 《纲目》"}]},{"ID":"20240611101749-t6sp4ai","Type":"NodeParagraph","Properties":{"id":"20240611101749-t6sp4ai","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611101749-swu9d00","Type":"NodeParagraph","Properties":{"id":"20240611101749-swu9d00","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"芡"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种仁"},{"Type":"NodeText","Data":"。9～10月种子成熟时，割取果实，击碎果皮，取出种子，除去硬壳晒干。"}]},{"ID":"20240611101749-4o906it","Type":"NodeParagraph","Properties":{"id":"20240611101749-4o906it","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611101749-26yyy95","Type":"NodeParagraph","Properties":{"id":"20240611101749-26yyy95","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 生于池沼湖泊中。分布黑龙江、吉林、辽宁、河北、河南、山东、江苏，安徽、浙江、福建、江西、台湾、广西、湖南、湖北、四川、广东、云南及贵州等地。主产江苏、湖南、湖北、山东。此外，福建、河北、河南、江西、浙江、四川等地亦产。"}]},{"ID":"20240611101749-xvgszva","Type":"NodeParagraph","Properties":{"id":"20240611101749-xvgszva","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611101749-9ai6k0m","Type":"NodeParagraph","Properties":{"id":"20240611101749-9ai6k0m","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 芡（《周礼》），又名：藙（《方言》），芰（崔豹《古今注》）。"}]},{"ID":"20240611101749-at8vxd8","Type":"NodeParagraph","Properties":{"id":"20240611101749-at8vxd8","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"一年生水生草本，具白色须根及不明显的茎。初生叶沉水，箭形；后生叶浮于水面，叶柄长，圆柱形中空，表面生多数刺，叶片椭圆状肾形或圆状盾形，直径65～130厘米，表面深绿色，有蜡被，具多数隆起，叶脉分歧点有尖刺，背面深紫色，叶脉凸起，有绒毛。花单生；花梗粗长，多刺，伸出水面；萼片4，直立，披针形，肉质，外面绿色，有刺，内面带紫色；花瓣多数，分3轮排列，带紫色；雄蕊多数；子房半下位，8室，无花柱，柱头红色。浆果球形，海绵质，污紫红色，外被皮刺，上有宿存萼片。种子球形，黑色，坚硬，具假种皮。花期6～9月。果期7～10月。"}]},{"ID":"20240611101749-0vjf7bx","Type":"NodeParagraph","Properties":{"id":"20240611101749-0vjf7bx","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611101749-tagkato","Type":"NodeParagraph","Properties":{"id":"20240611101749-tagkato","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 干燥种仁呈圆球形，直径约6毫米。一端呈白色，约占全体1／3，有圆形凹陷，另一端为棕红色，约占全体2／3。表面平滑，有花纹。质硬而脆，破开后，断面不平，色洁白，粉性。无臭，味淡。以颗粒饱满均匀、粉性足、无碎末及皮壳者为佳。"}]},{"ID":"20240611101749-2m0ywe4","Type":"NodeParagraph","Properties":{"id":"20240611101749-2m0ywe4","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611101749-55sfqo3","Type":"NodeParagraph","Properties":{"id":"20240611101749-55sfqo3","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 种子含多量淀粉。每100克中含蛋白质4.4克，脂肪0.2克，碳水化物32克，粗纤维0.4克，灰分0.5克，钙9毫克，磷110毫克，铁0.4毫克，硫胺素0.40毫克，核黄素0.08毫克，尼克酸2.5毫克，抗坏血酸6毫克，胡萝卜素微量。"}]},{"ID":"20240611101749-iud5rcq","Type":"NodeParagraph","Properties":{"id":"20240611101749-iud5rcq","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611101749-xjpdffn","Type":"NodeParagraph","Properties":{"id":"20240611101749-xjpdffn","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 炒芡实：先将麸皮放热锅内炒至烟起，再将净芡实倒入，拌炒至微黄色，取出，筛净麸皮，放凉。"}]},{"ID":"20240611101749-n58u86w","Type":"NodeParagraph","Properties":{"id":"20240611101749-n58u86w","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"孟诜：\"凡用（芡实），蒸熟，烈日晒裂取仁，亦可舂取粉用。\""}]},{"ID":"20240611101749-mj7v5u7","Type":"NodeParagraph","Properties":{"id":"20240611101749-mj7v5u7","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611101749-kcoxpdv","Type":"NodeParagraph","Properties":{"id":"20240611101749-kcoxpdv","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 入脾、肾经。"}]},{"ID":"20240611101749-zh8ifn4","Type":"NodeParagraph","Properties":{"id":"20240611101749-zh8ifn4","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入心、肾、脾、胃四经。\""}]},{"ID":"20240611101749-t7qf7wq","Type":"NodeParagraph","Properties":{"id":"20240611101749-t7qf7wq","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入脾、胃、肝三经。\""}]},{"ID":"20240611101749-hplxq8f","Type":"NodeParagraph","Properties":{"id":"20240611101749-hplxq8f","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611101749-e33foi7","Type":"NodeParagraph","Properties":{"id":"20240611101749-e33foi7","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 甘涩，平。"}]},{"ID":"20240611101749-tam7cqt","Type":"NodeParagraph","Properties":{"id":"20240611101749-tam7cqt","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平，\""}]},{"ID":"20240611101749-hs7m9y1","Type":"NodeParagraph","Properties":{"id":"20240611101749-hs7m9y1","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611101749-sae2f8u","Type":"NodeParagraph","Properties":{"id":"20240611101749-sae2f8u","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘，平，涩，无毒。\""}]},{"ID":"20240611101749-ji15muf","Type":"NodeParagraph","Properties":{"id":"20240611101749-ji15muf","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"味甘，性干温、鲜凉。\""}]},{"ID":"20240611101749-yu6majj","Type":"NodeParagraph","Properties":{"id":"20240611101749-yu6majj","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611101749-ufya6nf","Type":"NodeParagraph","Properties":{"id":"20240611101749-ufya6nf","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 《随息居饮食看》：\"凡外感前后，疟痢疳痔，气郁痞胀，溺赤便秘，食不运化及新产后皆忌之。\""}]},{"ID":"20240611101749-wsl79nx","Type":"NodeParagraph","Properties":{"id":"20240611101749-wsl79nx","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611101749-3v1jlv3","Type":"NodeParagraph","Properties":{"id":"20240611101749-3v1jlv3","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 固肾涩精，补脾止泄。治遗精，淋浊，带下，小便不禁，大便泄泻。"}]},{"ID":"20240611101749-0h1n90f","Type":"NodeParagraph","Properties":{"id":"20240611101749-0h1n90f","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主湿痹腰脊膝痛，补中除暴疾，益精气，强志，令耳目聪明。\""}]},{"ID":"20240611101749-5g7gol1","Type":"NodeParagraph","Properties":{"id":"20240611101749-5g7gol1","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"开胃助气。\""}]},{"ID":"20240611101749-mihai6h","Type":"NodeParagraph","Properties":{"id":"20240611101749-mihai6h","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"止渴益肾。治小便不禁，遗精，白浊，带下。\""}]},{"ID":"20240611101749-b84cwei","Type":"NodeParagraph","Properties":{"id":"20240611101749-b84cwei","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"④《本草从新》：补脾固肾，助气涩精。治梦遗滑精，解暑热酒毒，疗带浊泄泻，小便不禁。\""}]},{"ID":"20240611101749-ivyay61","Type":"NodeParagraph","Properties":{"id":"20240611101749-ivyay61","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611101749-oxxucrd","Type":"NodeParagraph","Properties":{"id":"20240611101749-oxxucrd","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；或入丸、散。"}]},{"ID":"20240611101749-5jn54g5","Type":"NodeParagraph","Properties":{"id":"20240611101749-5jn54g5","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611101749-l3o175g","Type":"NodeParagraph","Properties":{"id":"20240611101749-l3o175g","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" ①治梦遗漏精：鸡头肉末、莲花蕊末、龙骨（别研）、乌梅肉（焙干取末）各一两。上件煮山药糊为丸，如鸡头大。每服一粒，温酒、盐汤任下，空心。（《杨氏家藏方》玉锁丹）"}]},{"ID":"20240611101749-9768dye","Type":"NodeParagraph","Properties":{"id":"20240611101749-9768dye","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"②治精滑不禁：沙苑蒺藜（炒）、芡实（蒸）、莲须各二两，龙骨（酥炙）、牡蛎（盐水煮一日一夜，煅粉）各一两。共为末，莲子粉糊为丸，盐汤下。（《医方集解》金锁固精丸）"}]},{"ID":"20240611101749-uaikl3y","Type":"NodeParagraph","Properties":{"id":"20240611101749-uaikl3y","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"③治浊病：芡实粉、白茯苓粉。黄蜡化蜜和丸，梧桐子大。每服百丸，盐汤下。（《摘元方》分清丸）"}]},{"ID":"20240611101749-qjs5oa5","Type":"NodeParagraph","Properties":{"id":"20240611101749-qjs5oa5","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"④治老幼脾肾虚热及久痢：芡实、山药、茯苓、白术、莲肉、薏苡仁、白扁豆各四两，人参一两。俱炒燥为末，白汤调服。（《方脉正宗》）"}]},{"ID":"20240611101749-h2z660q","Type":"NodeParagraph","Properties":{"id":"20240611101749-h2z660q","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"⑤小便频数及遗精。用秋石、白茯苓、芡实、莲子各二两，共研为末。加蒸枣做成成丸子，如梧子大。每服三十丸，空心服，盐汤送下。此方名\"四精丸\"。"}]},{"ID":"20240611101749-ggqw7cv","Type":"NodeParagraph","Properties":{"id":"20240611101749-ggqw7cv","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"⑥白浊。用芡实粉、白茯苓粉。化黄蜡和蜜作丸子。如梧子大。每服百丸，盐汤送下。此方甸\"分清丸\"。"}]},{"ID":"20240611101749-bups9iu","Type":"NodeParagraph","Properties":{"id":"20240611101749-bups9iu","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611101749-rfssjy1","Type":"NodeParagraph","Properties":{"id":"20240611101749-rfssjy1","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611101749-l1pezxs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611101749-l1pezxs","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"《中华本草》：芡实"}]},{"ID":"20240611101749-1p1h815","Type":"NodeParagraph","Properties":{"id":"20240611101749-1p1h815","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611101749-fhsgyeh","Type":"NodeParagraph","Properties":{"id":"20240611101749-fhsgyeh","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" Qiàn Shí"}]},{"ID":"20240611101749-m7hap6i","Type":"NodeParagraph","Properties":{"id":"20240611101749-m7hap6i","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611101749-y7ojcj9","Type":"NodeParagraph","Properties":{"id":"20240611101749-y7ojcj9","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 卵菱、鸡癕、鸡头实、雁喙实、鸡头、雁头、乌头、蔿子、鸿头、水流黄、水鸡头、肇实、刺莲藕、刀芡实、鸡头果、苏黄、黄实、鸡咀莲、鸡头苞、刺莲蓬实。"}]},{"ID":"20240611101749-0xa052q","Type":"NodeParagraph","Properties":{"id":"20240611101749-0xa052q","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611101749-fn2msw5","Type":"NodeParagraph","Properties":{"id":"20240611101749-fn2msw5","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" Gordon Enryale Seed, Seed of Gordon Euryale"}]},{"ID":"20240611101749-xp8qwaf","Type":"NodeParagraph","Properties":{"id":"20240611101749-xp8qwaf","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611101749-wun26w2","Type":"NodeParagraph","Properties":{"id":"20240611101749-wun26w2","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 出自《本草纲目》。"}]},{"ID":"20240611101749-5qtzaaz","Type":"NodeParagraph","Properties":{"id":"20240611101749-5qtzaaz","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611101749-zbivcij","Type":"NodeParagraph","Properties":{"id":"20240611101749-zbivcij","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 药材基源：为睡莲科植物芡的成熟种仁。"}]},{"ID":"20240611101749-xkh0w60","Type":"NodeParagraph","Properties":{"id":"20240611101749-xkh0w60","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Euryale ferox Salisb."}]},{"ID":"20240611101749-rcg5dyc","Type":"NodeParagraph","Properties":{"id":"20240611101749-rcg5dyc","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在 9-10月间分批采收，先用镰刀割去叶片，然后再收获果实。并用篼捞起自行散浮在水面的种子。采回果实后用棒击破带刺外皮，取出种子洗净，阴干。或用草覆盖10d左右至果壳沤烂后，淘洗出种子，搓去假种皮，放锅内微火炒，大小分开，磨去或用粉碎机打去种壳，簸净种壳杂质即成。"}]},{"ID":"20240611101749-2a1n0if","Type":"NodeParagraph","Properties":{"id":"20240611101749-2a1n0if","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611101749-28vvmei","Type":"NodeParagraph","Properties":{"id":"20240611101749-28vvmei","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于池塘、湖沼及水田中。"}]},{"ID":"20240611101749-4cgitqm","Type":"NodeParagraph","Properties":{"id":"20240611101749-4cgitqm","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北、华东、华中及西南等地。"}]},{"ID":"20240611101749-uuaby9l","Type":"NodeParagraph","Properties":{"id":"20240611101749-uuaby9l","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611101749-csf7pv2","Type":"NodeParagraph","Properties":{"id":"20240611101749-csf7pv2","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 芡 一年生大型水生草本。全株具尖刺。根茎粗壮而短，具白色须根及不明显的茎。初生叶沉水，箭形或椭圆肾形，长4-10cm，两面无刺；叶辆无刺；后生叶浮于水面，革质，椭圆肾形至国形，直径10-130cm，上面深绿色，多皱褶，下面深紫色，有短柔毛，叶脉凸起，边缘向上折。叶柄及花梗粗壮，长可达25cm。"}]},{"ID":"20240611101749-fajs09n","Type":"NodeParagraph","Properties":{"id":"20240611101749-fajs09n","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"花单生，昼开夜合，长约5cm；萼片4，披针形，长l-1.5cm，内面紫色；花瓣多数，长圆状披针形，长1.5-2cm，紫红色，成数轮排列；雄蕊多数；子房下位，心皮8个，柱头红色，成凹入的圆盘状，扁平。浆果球形，直径3-5cm，海绵质，暗紫红色。种子球形，直径约10mm，黑色。花期7-8月，果期8-9月。"}]},{"ID":"20240611101749-l6ilw96","Type":"NodeParagraph","Properties":{"id":"20240611101749-l6ilw96","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611101749-pu8wnkt","Type":"NodeParagraph","Properties":{"id":"20240611101749-pu8wnkt","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 生物学特性喜温暖湿润气候，阳光充足。适温20-30℃。水深60-120cm。在水位比较稳定．有一定疏松污泥的池塘、水库或沟渠种植。土壤酸性不宜过大，寒冷的地区不宜栽培。"}]},{"ID":"20240611101749-9i20vi4","Type":"NodeParagraph","Properties":{"id":"20240611101749-9i20vi4","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"栽培技术种子繁殖；直播或育苗移栽。春、秋均可播种。秋播以采集当种子撒入。春播选颗粒饱满的干种子。播前用粘性泥土将3-4粒种子包成一团，然后按行株距1.6m×22.5kg。育苗移栽：催苗取贮藏种子用水漂洗后放盆中浅水浸没，日晒夜盖，日温25℃，夜温15℃以上时，约8-10d种子露白，播于苗池。每1m2播种300粒。移苗于播后30-40幼苗长2-3片小叶时移栽，带种子起苗，洗耳恭听去根部的泥土，将苗排放在木盆中，防止日晒，按40-60cm见方，逐株插入苗池中，灌水10-50cm。定植前7-10d水位逐渐加深至30-40cm。5月上旬芡实有4-5片绿叶，直径达25cm以上时可起苗定根。"}]},{"ID":"20240611101749-8qtl7dz","Type":"NodeParagraph","Properties":{"id":"20240611101749-8qtl7dz","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"田间管理 及时移密补稀，每1hm2保持1500-2250株。定植后7-10d开始除草，追肥1-2次，注意调节水量，按不同生长期要求掌握春浅、夏浅、秋放、冬蓄的规律。"}]},{"ID":"20240611101749-2oc93zz","Type":"NodeParagraph","Properties":{"id":"20240611101749-2oc93zz","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"病虫害防治 叶斑病、叶瘤病，在发生期喷50%多菌灵500倍液，50%托布津1000倍液加0.3%洗衣粉。霜霉病，用代森锌65%可湿粉剂600倍液喷射。莲缢管蚜、菱角紫叶蝉，以上两种虫混合发生，都群集叶茎部刺吸汁液。可喷2.5%敌杀死4000倍液。"}]},{"ID":"20240611101749-x3qkev2","Type":"NodeParagraph","Properties":{"id":"20240611101749-x3qkev2","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611101749-cikt68i","Type":"NodeParagraph","Properties":{"id":"20240611101749-cikt68i","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 种仁类圆球形，直径5-8mm，有的破碎成块。完整者表面有红棕色或暗紫色的内种皮，可见不规则的脉状网纹，一端约1/3为黄白色。胚小．位于淡黄色一端的圆形凹窝内。质地较硬，断面白色，粉性。气无，味谈。以饱满、断面白色、粉性足、无碎末者为佳。"}]},{"ID":"20240611101749-xkpcagd","Type":"NodeParagraph","Properties":{"id":"20240611101749-xkpcagd","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"显微鉴别粉末特征：类白色。①淀粉粒主为复粒，类圆形、长圆形或国多角形，由数十至数百粒分粒组成，直径12-29μm。分粒极细小，直径1-3（-5）μm。②外胚乳细胞多破碎，完整者长方形、长条形、长多角形或不规则形，细胞中充满淀粉粒。另可见内种皮细胞、色素层细胞和导管。"}]},{"ID":"20240611101749-mfuxoie","Type":"NodeParagraph","Properties":{"id":"20240611101749-mfuxoie","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611101749-vny2ujy","Type":"NodeParagraph","Properties":{"id":"20240611101749-vny2ujy","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 芡实的种子含淀粉、蛋白质及脂肪。此外，尚含钙、磷、铁和维生素 B1、B2、C、烟酸及胡萝素。"}]},{"ID":"20240611101749-lud760u","Type":"NodeParagraph","Properties":{"id":"20240611101749-lud760u","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611101749-ld1eveh","Type":"NodeParagraph","Properties":{"id":"20240611101749-ld1eveh","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 1.炒制：取净芡实放置锅内，宜用文火加热炒至微黄色时，将其取出，放凉后收藏即可。"}]},{"ID":"20240611101749-vk6kmjg","Type":"NodeParagraph","Properties":{"id":"20240611101749-vk6kmjg","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"2.麸制；先将麸皮放热锅内炒至烟起，再将净芡实倒入，拌炒至微黄色，取出，筛净麸皮，放凉。每芡实100kg，用皮10kg。"}]},{"ID":"20240611101749-0t39y58","Type":"NodeParagraph","Properties":{"id":"20240611101749-0t39y58","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"3.土制：取伏龙肝粉置锅内，用文火加热炒至松时，放入净芡实，炒至微黄色，取出，筛去伏龙肝粉，晾凉，每净芡实100kg，用伏龙肝粉20kg。"}]},{"ID":"20240611101749-zmpgj2t","Type":"NodeParagraph","Properties":{"id":"20240611101749-zmpgj2t","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"4.盐制：取芡实加盐水润1夜后蒸透，每芡实10kg，用食盐120g，水适量。盂诜：凡用（芡实），蒸熟，烈日晒裂取仁。亦可春取粉用。"}]},{"ID":"20240611101749-h8926r4","Type":"NodeParagraph","Properties":{"id":"20240611101749-h8926r4","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611101749-fujajki","Type":"NodeParagraph","Properties":{"id":"20240611101749-fujajki","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 理化鉴别薄层色谱：取本品粉末2g，加乙醇10ml，加热回流40min，滤过。滤液浓缩至10nl，作为供试品溶液。另取齐墩果酸对照品，加乙醇溶解，制成lmg/ml的对照液。吸取供试液、对照液适量，点于同-硅胶G板上．用石油酸-乙醚-乙醇（10：10：1）为展开剂。以25％的磷钼酸乙醇溶液显色，115℃加热5min，供试品色谱中，在与对照品色谱相应的位置上，显同一颜色斑点。"}]},{"ID":"20240611101749-qe1idew","Type":"NodeParagraph","Properties":{"id":"20240611101749-qe1idew","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611101749-d4h5bbb","Type":"NodeParagraph","Properties":{"id":"20240611101749-d4h5bbb","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 脾；肾；心；胃；肝经"}]},{"ID":"20240611101749-7fkq2jz","Type":"NodeParagraph","Properties":{"id":"20240611101749-7fkq2jz","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611101749-9m0bo63","Type":"NodeParagraph","Properties":{"id":"20240611101749-9m0bo63","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 甘；涩；平；"}]},{"ID":"20240611101749-zirf90h","Type":"NodeParagraph","Properties":{"id":"20240611101749-zirf90h","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611101749-3en4e74","Type":"NodeParagraph","Properties":{"id":"20240611101749-3en4e74","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 大小便不利者禁服；食滞不化者慎服。"}]},{"ID":"20240611101749-hsmx4vv","Type":"NodeParagraph","Properties":{"id":"20240611101749-hsmx4vv","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611101749-ih3ld3m","Type":"NodeParagraph","Properties":{"id":"20240611101749-ih3ld3m","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 固肾涩精；补脾止泄。主遗精；白浊；淋浊；带下；小便不禁；大便泄泻"}]},{"ID":"20240611101749-icl1ukd","Type":"NodeParagraph","Properties":{"id":"20240611101749-icl1ukd","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611101749-026si7k","Type":"NodeParagraph","Properties":{"id":"20240611101749-026si7k","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g；或入丸、散，亦可适量煮粥食。"}]},{"ID":"20240611101749-dv4egjr","Type":"NodeParagraph","Properties":{"id":"20240611101749-dv4egjr","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611101749-1isiik3","Type":"NodeParagraph","Properties":{"id":"20240611101749-1isiik3","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 1.金锁玉关丸(《证治准绳·类方》)，治遗精白浊，心虚不宁。2.金锁固精丸(《医方集解》)，功能固肾涩精，治肾关不固，遗精滑泄。3.暖肾助火汤(《揣摩有得集》)，治房室过度，肾经虚寒而致的缩阳症。4.旺水汤(《辨证录》)，治纵欲过度，梦遗不止，腰足痿弱，骨内酸疼，夜热自汗，终宵不干，肾水涸竭者。5.易黄汤(《傅青主女科》)，治黄带。6.玉锁丹(《杨氏家藏方》)，治梦遗漏精。7.分清丸(《摘元方》)，治浊病。"}]},{"ID":"20240611101749-c9ylr9f","Type":"NodeParagraph","Properties":{"id":"20240611101749-c9ylr9f","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611101749-7891ozj","Type":"NodeParagraph","Properties":{"id":"20240611101749-7891ozj","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主湿痹腰脊膝痛，补中除暴疾，益精气，强志，令耳目聪明。"}]},{"ID":"20240611101749-b5k3bw2","Type":"NodeParagraph","Properties":{"id":"20240611101749-b5k3bw2","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：开胃助气。"}]},{"ID":"20240611101749-gydmhxt","Type":"NodeParagraph","Properties":{"id":"20240611101749-gydmhxt","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：止渴益肾。治小便不禁，遗精，白浊，带下。"}]},{"ID":"20240611101749-8k1muas","Type":"NodeParagraph","Properties":{"id":"20240611101749-8k1muas","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"4.《本草从新》：补脾固肾，助气涩精。治梦遗滑精，解暑热酒毒，疗带浊泄泻，小便不禁。5.《本草新编》：芡实，佐使者也，其功全在补肾去湿。夫补肾之药，大多润泽者居多，润泽者则未免少湿矣。芡实补中去湿，性又不燥，故能去邪水而补真水，与诸补阴药同用，尤能助之以添精，不虑多投以增湿也。芡实不特益精，且能涩精补肾。与山药并用，各为末，日日米饭调服。"}]},{"ID":"20240611101749-9xxfhpu","Type":"NodeParagraph","Properties":{"id":"20240611101749-9xxfhpu","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"6.《本草经百种录》：鸡头实，甘淡，得土之正味，乃脾肾之药也。脾恶湿而肾恶燥，鸡头实淡渗甘香，则不伤于湿，质粘味涩，而又滑泽肥润，则不伤干燥，凡脾肾之药，往往相反，而此则相成，故尤足贵也。"}]},{"ID":"20240611101749-3ydx2ym","Type":"NodeParagraph","Properties":{"id":"20240611101749-3ydx2ym","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"7.《本草求真》：芡实如何补脾，以其味甘之故；芡实如何固肾，以其味涩之故。惟其味甘补脾，故能利湿，而泄泻腹痛可治；惟其味涩固肾，故能闭气，而使遗带小便不禁皆愈。功与山药相似，然山药之阴，本有过于芡实，而芡实之涩，更有甚于山药；且山药兼补肺阴，而芡实则上于脾肾而不及于肺。"}]},{"ID":"20240611101749-x5rtfcu","Type":"NodeParagraph","Properties":{"id":"20240611101749-x5rtfcu","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611101749-rw0cj9d","Type":"NodeParagraph","Properties":{"id":"20240611101749-rw0cj9d","updated":"20240611101749"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611101750-xtrz0zn","Type":"NodeThematicBreak","Properties":{"id":"20240611101750-xtrz0zn"}},{"ID":"20240611101751-6qh88x0","Type":"NodeParagraph","Properties":{"id":"20240611101751-6qh88x0"}}]}