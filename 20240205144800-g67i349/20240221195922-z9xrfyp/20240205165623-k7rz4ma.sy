3941-tqtjj9p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 317px;\" parent-style=\"width: 327px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 327px;","style":"width: 317px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"淫羊藿 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/淫羊藿 10-20240814184022-w0zug28.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 317px;\" parent-style=\"width: 327px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 321px;","style":"width: 311px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"淫羊藿 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/淫羊藿 11-20240814184111-e9y9mah.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 311px;\" parent-style=\"width: 321px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611151357-9q9brs6","Type":"NodeThematicBreak","Properties":{"id":"20240611151357-9q9brs6"}},{"ID":"20240611151358-wdgpbgz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151358-wdgpbgz","updated":"20240611151403"},"Children":[{"Type":"NodeText","Data":"淫羊藿《神农本草经》"}]},{"ID":"20240611151358-wp93g21","Type":"NodeParagraph","Properties":{"id":"20240611151358-wp93g21","updated":"20240611151358"},"Children":[{"Type":"NodeText","Data":"味辛寒。"}]},{"ID":"20240611151358-pmtnph3","Type":"NodeParagraph","Properties":{"id":"20240611151358-pmtnph3","updated":"20240611151358"},"Children":[{"Type":"NodeText","Data":"主阴痿绝伤，茎中痛，利小便，益气力，强志。一名刚前。生山谷。"}]},{"ID":"20240611151358-jb5uae9","Type":"NodeParagraph","Properties":{"id":"20240611151358-jb5uae9","updated":"20240611151358"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：淫羊藿，神农雷公辛，李氏小寒，坚骨（《御览》）。"}]},{"ID":"20240611151358-2zp7sax","Type":"NodeParagraph","Properties":{"id":"20240611151358-2zp7sax","updated":"20240611151358"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生上山郡阳山。"}]},{"ID":"20240611151408-p6wwo69","Type":"NodeThematicBreak","Properties":{"id":"20240611151408-p6wwo69"}},{"ID":"20240611151409-zbmldaq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151409-zbmldaq","updated":"20240611151413"},"Children":[{"Type":"NodeText","Data":"淫羊藿《神农本草经赞》"}]},{"ID":"20240611151409-cmf9xiy","Type":"NodeParagraph","Properties":{"id":"20240611151409-cmf9xiy","updated":"20240611151409"},"Children":[{"Type":"NodeText","Data":"味辛寒。主阴痿绝伤。茎中痛。利小便。益气力。强志。一名刚前。生山谷。"}]},{"ID":"20240611151409-l5fs8a8","Type":"NodeParagraph","Properties":{"id":"20240611151409-l5fs8a8","updated":"20240611151409"},"Children":[{"Type":"NodeText","Data":"九叶三枝。植谋背水。紫溢柔须。青敷细齿。蹩腾骞。奋起。放杖逍遥。刚前振靡。（邱庚切枯怀切）苏颂曰。一名三枝九叶草。韩保升曰。言生处不闻水声者良。叶青似杏叶。根紫色有须。"}]},{"ID":"20240611151409-bf0zr8o","Type":"NodeParagraph","Properties":{"id":"20240611151409-bf0zr8o","updated":"20240611151409"},"Children":[{"Type":"NodeText","Data":"罗隐启。更谋背水。李时珍曰。叶薄而细齿。柳宗元诗。蹩皆腾骞。集韵。人有力貌。"}]},{"ID":"20240611151409-56r1wxn","Type":"NodeParagraph","Properties":{"id":"20240611151409-56r1wxn","updated":"20240611151409"},"Children":[{"Type":"NodeText","Data":"日华子曰。一名放杖草。"}]},{"ID":"20240611151418-yu4ozfn","Type":"NodeThematicBreak","Properties":{"id":"20240611151418-yu4ozfn"}},{"ID":"20240611151419-gsehxe4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151419-gsehxe4","updated":"20240611151424"},"Children":[{"Type":"NodeText","Data":"淫羊藿《得配本草》"}]},{"ID":"20240611151419-tdlbwad","Type":"NodeParagraph","Properties":{"id":"20240611151419-tdlbwad","updated":"20240611151419"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名仙灵脾"}]},{"ID":"20240611151419-yhk653b","Type":"NodeParagraph","Properties":{"id":"20240611151419-yhk653b","updated":"20240611151419"},"Children":[{"Type":"NodeText","Data":"得酒良。薯蓣、紫芝为之使。"}]},{"ID":"20240611151419-ka0jefv","Type":"NodeParagraph","Properties":{"id":"20240611151419-ka0jefv","updated":"20240611151419"},"Children":[{"Type":"NodeText","Data":"辛，温。入足少阴经气分，兼入手足阳明三焦命门。助相火，强精气，除风冷，解拘挛。"}]},{"ID":"20240611151419-w416s4t","Type":"NodeParagraph","Properties":{"id":"20240611151419-w416s4t","updated":"20240611151419"},"Children":[{"Type":"NodeText","Data":"得覆盆、北味，治三焦冷嗽。配威灵仙，治痘疹入目。君生姜、茶叶，治气胀不食。浸无灰酒，治偏风不仁。"}]},{"ID":"20240611151419-hbrak47","Type":"NodeParagraph","Properties":{"id":"20240611151419-hbrak47","updated":"20240611151419"},"Children":[{"Type":"NodeText","Data":"去花枝洗净，锉细末，每斤用羊脂四两拌炒，脂尽为度。禁用与巴戟同。"}]},{"ID":"20240611151419-thpfb6i","Type":"NodeParagraph","Properties":{"id":"20240611151419-thpfb6i","updated":"20240611151419"},"Children":[{"Type":"NodeText","Data":"巴戟、锁阳、仙茅、淫羊藿，均须生地汁浸透，焙干用。再重用滋阴之剂，以制其热，庶无阳旺阴亏之患。今人动以此为种子良方，服之者多致阳亢阴竭，精液干涸，反受其害，则惑之甚者也。"}]},{"ID":"20240611151428-opotor2","Type":"NodeThematicBreak","Properties":{"id":"20240611151428-opotor2"}},{"ID":"20240611151429-v6u1dkd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151429-v6u1dkd","updated":"20240611151439"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草图经》"}]},{"ID":"20240611151429-c4upxuh","Type":"NodeParagraph","Properties":{"id":"20240611151429-c4upxuh","updated":"20240611151435"},"Children":[{"Type":"NodeText","Data":"淫羊藿，俗名仙灵脾。生上郡阳山山谷，今江东、陕西、泰山、汉中、湖湘间皆有之。叶青似杏，叶上有刺；茎如粟秆；根紫色有须；四月开花白色，亦有紫色，碎小独头子；五月采叶，晒干。湖湘出者，叶如小豆，枝茎紧细，经冬不凋，根似黄连。关中俗呼三枝九叶草，苗高一、二尺许，根叶俱堪使。"}]},{"ID":"20240611150927-pkp4dww","Type":"NodeThematicBreak","Properties":{"id":"20240611150927-pkp4dww"}},{"ID":"20240611151347-c7jrj8d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151347-c7jrj8d","updated":"20240611151352"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草乘雅半偈》"}]},{"ID":"20240611151347-8f3t0u0","Type":"NodeParagraph","Properties":{"id":"20240611151347-8f3t0u0","updated":"20240611151347"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240611151347-48hsmep","Type":"NodeParagraph","Properties":{"id":"20240611151347-48hsmep","updated":"20240611151347"},"Children":[{"Type":"NodeText","Data":"读此真可信，夫人死为羊，羊死为人，否则胡同业相感如此。"}]},{"ID":"20240611151347-jj1a6r7","Type":"NodeParagraph","Properties":{"id":"20240611151347-jj1a6r7","updated":"20240611151347"},"Children":[{"Type":"NodeText","Data":"【气味】辛寒，无毒。"}]},{"ID":"20240611151347-5unjogu","Type":"NodeParagraph","Properties":{"id":"20240611151347-5unjogu","updated":"20240611151347"},"Children":[{"Type":"NodeText","Data":"【主治】主阴痿绝阳，茎中痛，利小便，益气力，强志。"}]},{"ID":"20240611151347-ys65mkb","Type":"NodeParagraph","Properties":{"id":"20240611151347-ys65mkb","updated":"20240611151347"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出上郡阳山山谷，江东、陕西、泰山、汉中、湖湘间皆有。一根数茎，茎细颇坚，高二、三尺，一茎三桠，一桠三叶，长二三寸，如豆藿，叶如杏叶，面光背淡，边有细齿，薄而有刺。四月开花白色，亦有紫色者。碎小独头，经冬不凋，根似黄连，色紫多须，即仙灵脾也。景曰∶西川北部，有兽曰淫羊，与山羊无异，日群百遍，盖食此藿所致也。羊食之而淫，故曰淫羊，若以为川北有淫羊似乎曲为之解矣。又名仙灵脾，当是取其益气力，强志而名之耳。修治，取生处不闻水声者乃良，以夹刀夹去叶之四畔花枝，每斤用羊脂四两拌炒，待脂尽为度。薯蓣、紫芝为之使。得酒良。"}]},{"ID":"20240611151347-ksp3wao","Type":"NodeParagraph","Properties":{"id":"20240611151347-ksp3wao","updated":"20240611151347"},"Children":[{"Type":"NodeText","Data":"【 】曰∶羊性善群，淫羊功力相似，藿则以形举也。茎高二、三尺，细紧劲直，经冬不凋，可想见其作用矣。一茎三桠，一桠三叶，具巽木生成之数，助长厥阴之用，坚固淫业者也。但不可久服，以有余于用，不足于体，令人无子故也。"}]},{"ID":"20240611150927-bh4mxju","Type":"NodeThematicBreak","Properties":{"id":"20240611150927-bh4mxju"}},{"ID":"20240611151330-sq7zp1w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151330-sq7zp1w","updated":"20240611151339"},"Children":[{"Type":"NodeText","Data":"淫羊藿《冯氏锦囊秘录》"}]},{"ID":"20240611151330-eswq7d2","Type":"NodeParagraph","Properties":{"id":"20240611151330-eswq7d2","updated":"20240611151330"},"Children":[{"Type":"NodeText","Data":"又名仙灵脾，又名弃杖草。本得金土之气，而上感天之阳气，故其味辛甘，其气温而无毒。入手厥阴，为补命门之要药，亦入足少阴、厥阴。辛以润肾，甘温益阳气，故主阴痿绝阳。"}]},{"ID":"20240611151330-7vmf939","Type":"NodeParagraph","Properties":{"id":"20240611151330-7vmf939","updated":"20240611151330"},"Children":[{"Type":"NodeText","Data":"淫羊藿，强筋骨，补腰膝，治男子绝阳不兴，女子绝阴不产。然云丈夫久服，令人无子者，恐阳旺多欲，阴精耗散。"}]},{"ID":"20240611151330-ko4coox","Type":"NodeParagraph","Properties":{"id":"20240611151330-ko4coox","updated":"20240611151330"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 冶痘绝阳不起。"}]},{"ID":"20240611151317-s5gyck1","Type":"NodeThematicBreak","Properties":{"id":"20240611151317-s5gyck1"}},{"ID":"20240611151319-om26jc8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151319-om26jc8","updated":"20240611151324"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草便读》"}]},{"ID":"20240611151319-4aa9jjb","Type":"NodeParagraph","Properties":{"id":"20240611151319-4aa9jjb","updated":"20240611151319"},"Children":[{"Type":"NodeText","Data":"有助阳补火之功．辛味独专．甘香并至．治肾弱肝虚等疾．寒淫所胜．痹痿咸宜．（淫羊藿一名仙灵脾．其叶似豆藿．羊食之则喜淫．辛温之性．峻补命门之火．故凡下焦一切风寒湿痹之病．皆可治之．惟阴虚阳胜者．不宜服耳．此药仅助火益阳．虽能补命门．然香燥之品．极易伤阴．较巴戟苁蓉过之．）"}]},{"ID":"20240611150928-09exe47","Type":"NodeThematicBreak","Properties":{"id":"20240611150928-09exe47"}},{"ID":"20240611151308-6njmq4k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151308-6njmq4k","updated":"20240611151313"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草述钩元》"}]},{"ID":"20240611151308-aq79eub","Type":"NodeParagraph","Properties":{"id":"20240611151308-aq79eub","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"（即仙灵脾）江东陕西汉中湖湘间皆有之。生大山中。一根数茎。茎粗如线。高一二尺。一茎二桠。一桠三叶。叶长二三寸。如杏叶及豆藿。面光背淡。甚薄而细。齿有微刺。"}]},{"ID":"20240611151308-7328bhk","Type":"NodeParagraph","Properties":{"id":"20240611151308-7328bhk","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"气味甘香辛温。辛润肾。甘温益阳气。可升可降。阳也。真阳不足者宜之。入手厥阴。"}]},{"ID":"20240611151308-g15iirb","Type":"NodeParagraph","Properties":{"id":"20240611151308-g15iirb","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"为补命门三焦要药。亦入足少阴厥阴。主治阴痿绝伤。茎中痛。利小便。益气力。强志。（本经）丈夫绝阳无子。女人绝阴无子。老人昏耄。中年健忘。一切冷风劳气。筋骨挛急。四肢不仁。补腰膝。强心力。入补中益气汤。治气虚而阳道不兴。盖人自有生以后。一切真阳。"}]},{"ID":"20240611151308-nz6p63n","Type":"NodeParagraph","Properties":{"id":"20240611151308-nz6p63n","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"皆托于后天之气。用补中加入此味。引之归元裕阳。还以同升。则真阳乃毕畅也。与白蒺藜甘枸杞苁蓉五味牛膝山萸同用。为补阳妙剂。"}]},{"ID":"20240611151308-n4pscur","Type":"NodeParagraph","Properties":{"id":"20240611151308-n4pscur","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"〔论〕淫羊藿入命门而补真阳。夫肾命真阳即人身之元气也。凡绝阳绝阴诸病。不本之元气。何以嘘之于既槁乎。至于茎中痛。小便不利。皆肝肾气虚所致。如能入肾而助元阳。"}]},{"ID":"20240611151308-rdpp75h","Type":"NodeParagraph","Properties":{"id":"20240611151308-rdpp75h","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"即是补肾气。而肾肝固同治者已。其味甘香。而微有辛温。甘归中土。举水火二气。由此为权舆。此品正以甘香。故能奏后天之功于绝阳绝阴。不概同于补阳之味。其于人之真阳不足者。既能使天气达地以嘘其枯。而真阳具足者。又能使地气际天以畅厥用。如老人昏耄。中年健忘。皆元阳之衰败而不能上升者也。以是思功。功可知矣。须知此味以降为升。其升由于能降也。"}]},{"ID":"20240611151308-npk123q","Type":"NodeParagraph","Properties":{"id":"20240611151308-npk123q","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"缪氏云。虚阳易举。强阳不痿。梦遗不止。便赤口干者。并忌。"}]},{"ID":"20240611151308-csc5c98","Type":"NodeParagraph","Properties":{"id":"20240611151308-csc5c98","updated":"20240611151308"},"Children":[{"Type":"NodeText","Data":"〔修治〕以夹刀剪去叶之四畔花枝。每斤用羊脂四两拌炒。脂尽为度。山药紫芝为之使。得酒良。（据此是止用叶。必得茎叶俱全。一一如濒湖所说者乃真。）"}]},{"ID":"20240611150928-xq22yxe","Type":"NodeThematicBreak","Properties":{"id":"20240611150928-xq22yxe"}},{"ID":"20240611151256-kwpm100","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151256-kwpm100","updated":"20240611151300"},"Children":[{"Type":"NodeText","Data":"淫羊藿《神农本草经读》"}]},{"ID":"20240611151256-5ev6z41","Type":"NodeParagraph","Properties":{"id":"20240611151256-5ev6z41","updated":"20240611151256"},"Children":[{"Type":"NodeText","Data":"气味辛、寒，无毒。主阴痿绝伤，茎中痛，利小便，益气力，强志。（羊脂拌炒。）陈修园曰∶淫羊藿气寒，禀天冬水之气而入肾；味辛无毒，得地之金味而入肺；金水二脏之药，细味经文，俱以补水脏为主。阴者，宗筋也；宗筋属于肝木，木遇烈日而痿；一得气寒之羊藿，即如得甘露而挺矣。绝伤者，络脉绝而不续也。《金匮》有云∶络脉者，阴精阳气所往来也。羊藿气寒味辛，具水天之气环转营运而能续之也。茎主茎也，火郁于中则痛，热者清之以寒，郁者散之以辛，所以主茎中痛也。小便主于膀胱，必假三焦之气化而出，三焦之火盛则孤阳不化而为溺短。溺闭之证，一得羊藿之气寒味辛，金水相函，阴阳濡布，阳得阴而化，则小便利矣。肺主气，肾藏志。孟夫子云∶“夫志，气之帅也”。润肺之功归于补肾，其益气力强志之训，即可于孟夫子善养刚大之训悟之也。第此理难与时医道耳！叶天士云∶淫羊藿浸酒治偏风不遂，水涸腰痛。"}]},{"ID":"20240611150928-zvifycg","Type":"NodeThematicBreak","Properties":{"id":"20240611150928-zvifycg"}},{"ID":"20240611151246-su1blpv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151246-su1blpv","updated":"20240611151250"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草新编》"}]},{"ID":"20240611151246-r7ur1th","Type":"NodeParagraph","Properties":{"id":"20240611151246-r7ur1th","updated":"20240611151246"},"Children":[{"Type":"NodeText","Data":"淫羊藿，一名仙灵脾。味辛，气温，无毒。云寒，误。用不必羊脂炒，亦不必去刺。入命门治男子绝阳不兴，治妇人绝阳不产，却老景昏耄，除中年健忘，益肾固筋，增力强志。补命门而又不大热，胜于肉桂之功，近人未知也，夫男女虽分阴阳，而五脏六腑正各相同，并无小异。男子命门寒则阳不举，女子命门寒则阳不容，非男子绝阳不能生，女子绝阳尚可产也。《本草》言女人绝阴不产者，乃讹写也。淫羊藿补阳而不补阴，取补男女之阳，则彼此之化生不息。阴中有阳，则男子精热而能施，女子亦精热而能受。倘谓补其阴绝，则纯阴无阳，何以生育乎？此等药，中年以后之人，正可朝夕吞服，庶几无子者可以有子。而《本草》又戒久服有损，想因命门有火而言之也。命门有火者，初服即不相宜，又何待日久始有损哉。"}]},{"ID":"20240611151246-8n7h6su","Type":"NodeParagraph","Properties":{"id":"20240611151246-8n7h6su","updated":"20240611151246"},"Children":[{"Type":"NodeText","Data":"或疑淫羊藿，温补命门之火，故能兴阳，然男子有阳道之势，服之翘然兴举，故知其兴绝阳也，若女子，又从何起验之乎？曰∶女子亦未尝不可验也。女子无阳，则小腹寒而痛，服淫羊藿则不痛矣。然此又无形，不足以验也，更有有形之物，可以相验。女子无阳，则玉户之内有一物如含花之蕊者，必升举而不可以手指相探。服淫羊藿，则含花之蕊必下降，而手指可探矣。此蕊，即胞胎之门户，受精之口也，寒则缩，而温则伸，犹男子寒则痿，而温则坚也。以此相验，断不爽矣。而予更有说，无阳者，无命门之火也。夫命门之火，原在肾之中，而不在肾外，淫羊藿补命门之火，亦在肾之中，而不在肾之外，亦何必求验于男女阴阳之物哉。"}]},{"ID":"20240611151246-nv7oxq5","Type":"NodeParagraph","Properties":{"id":"20240611151246-nv7oxq5","updated":"20240611151246"},"Children":[{"Type":"NodeText","Data":"或问补命门之火者，宜于男子，而不宜于妇人，妇人火动，又安可救乎？夫妇人之欲火盛，非命门之火旺，乃命门之火衰。命门火衰，无以安龙雷之火，而火必越出于肝中，以助肝木之旺。肝木旺，则欲火之心动矣。木能生火，又何制哉，往往有思男子而不可得者矣。治方泻肝木之火，乃一时之权宜也。肝木既平，仍宜补命门之火，龙雷而下安于肾宫，而火无浮动之虞。可见妇人亦必须补命门也。妇人既宜补命门之火，安在淫羊藿但宜于男子，而不宜妇人哉，况淫羊藿妇人用之，又不止温补命门也，更能定小腹之痛，去阴门之痒，暖子宫之寒，止白带之湿。岂可疑只利于男子，而不用之于妇科哉？"}]},{"ID":"20240611151246-lchjb71","Type":"NodeParagraph","Properties":{"id":"20240611151246-lchjb71","updated":"20240611151246"},"Children":[{"Type":"NodeText","Data":"凡用药之权宜，实非一途可论定也。"}]},{"ID":"20240611151246-f5gjsxk","Type":"NodeParagraph","Properties":{"id":"20240611151246-f5gjsxk","updated":"20240611151246"},"Children":[{"Type":"NodeText","Data":"或疑淫羊藿助男子之阳，多用之于丸内，未闻用之于汤剂，不识汤剂中亦可用之乎？曰∶凡药用之于汤者，即可用于丸，岂用于丸者，而独不可用于汤乎？世医之不用于汤剂，以体轻而不便入箱中。铎实有煎膏之法，备于药笼中尤便，因附载之。用淫羊藿，每次五斤，略揉碎，以滚水泡缸内三日，大锅煮汁至浓者，先取起，又添水煎之，以色淡为度。去滓，将浓汁再煎如糊，乃用锡锅盛之，再蒸煮如浓糊，少投鹿角胶，取其粘也，候冷切块，晒之，则成胶矣。入汤剂中调服佳甚，入丸亦妙也。"}]},{"ID":"20240611150928-efvgmdp","Type":"NodeThematicBreak","Properties":{"id":"20240611150928-efvgmdp"}},{"ID":"20240611151234-pmvtc3n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151234-pmvtc3n","updated":"20240611151239"},"Children":[{"Type":"NodeText","Data":"淫羊藿《千金翼方》"}]},{"ID":"20240611151234-z619cvj","Type":"NodeParagraph","Properties":{"id":"20240611151234-z619cvj","updated":"20240611151234"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主阴痿，绝伤，茎中痛，利小便，益气力，强志，坚筋骨，消瘰 ，赤痈，下部有疮洗出虫。丈夫久服，令人无子。一名刚前。生上郡阳山山谷。"}]},{"ID":"20240611151108-g6dyst3","Type":"NodeThematicBreak","Properties":{"id":"20240611151108-g6dyst3"}},{"ID":"20240611151225-9kdgxi4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151225-9kdgxi4","updated":"20240611151229"},"Children":[{"Type":"NodeText","Data":"淫羊霍《本草纲目》"}]},{"ID":"20240611151225-46wnfaf","Type":"NodeParagraph","Properties":{"id":"20240611151225-46wnfaf","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"「释名」亦名仙灵脾、放杖草、弃杖草、千两金、干鸡筋、黄连祖、三枝九叶草、刚草。"}]},{"ID":"20240611151225-mkn1udi","Type":"NodeParagraph","Properties":{"id":"20240611151225-mkn1udi","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"「气味」辛、寒、无毒。李时珍说：“淫羊藿味甘气香，性温不寒，能益精气。......真阳不足者宜之”。"}]},{"ID":"20240611151225-2vf2q6h","Type":"NodeParagraph","Properties":{"id":"20240611151225-2vf2q6h","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611151225-0y2dw4n","Type":"NodeParagraph","Properties":{"id":"20240611151225-0y2dw4n","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"1、阳痿，腰膝冷。用淫羊藿一斤，酒一斗浸泡三天后，常饮服。此方名“仙灵脾酒”。"}]},{"ID":"20240611151225-yifj4az","Type":"NodeParagraph","Properties":{"id":"20240611151225-yifj4az","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"2、偏风不遂。服仙灵脾酒。"}]},{"ID":"20240611151225-iaw5620","Type":"NodeParagraph","Properties":{"id":"20240611151225-iaw5620","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"3、咳嗽，气不顺，腹满不思饮食。用淫羊藿、覆盆子、五味子（炒）各一两，共研为末，加熟蜜做成丸子，如梧子大。每服二十丸，姜茶送下。"}]},{"ID":"20240611151225-sho6kav","Type":"NodeParagraph","Properties":{"id":"20240611151225-sho6kav","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"4、日昏生翳。用淫羊藿、生王瓜（既红色的小栝楼），等分为末。每服一钱，茶送下。一天服二次。"}]},{"ID":"20240611151225-a77hcfu","Type":"NodeParagraph","Properties":{"id":"20240611151225-a77hcfu","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"5、病后青盲（病不久者）。用淫羊藿一两、淡豆鼓一百粒，水一碗半煎成一碗，一次服完。"}]},{"ID":"20240611151225-mxcd1t8","Type":"NodeParagraph","Properties":{"id":"20240611151225-mxcd1t8","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"6、小儿雀目。用淫羊藿根、晚蚕蛾各半两，灸甘草、射干各二钱半，共研为末，另取羊肝一块，切开，纳入上制药末二钱，把肝扎紧，和黑豆一合、淘米水一碗同煮熟。分二次吃完。"}]},{"ID":"20240611151225-9ibw80n","Type":"NodeParagraph","Properties":{"id":"20240611151225-9ibw80n","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"7、痘疹入目。用淫羊藿、威灵仙，等分为末。每服五分，米汤送下。"}]},{"ID":"20240611151225-snir1ox","Type":"NodeParagraph","Properties":{"id":"20240611151225-snir1ox","updated":"20240611151225"},"Children":[{"Type":"NodeText","Data":"8、虚火牙痛。用淫羊藿煎汤，不时嗽口，很见效。"}]},{"ID":"20240611151108-4w7rvvg","Type":"NodeThematicBreak","Properties":{"id":"20240611151108-4w7rvvg"}},{"ID":"20240611151214-57mpauu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151214-57mpauu","updated":"20240611151219"},"Children":[{"Type":"NodeText","Data":"淫羊藿《医学入门》"}]},{"ID":"20240611151214-81cvy7m","Type":"NodeParagraph","Properties":{"id":"20240611151214-81cvy7m","updated":"20240611151214"},"Children":[{"Type":"NodeText","Data":"淫羊藿辛性亦平，补肾助阳壮阴茎，又治冷风筋骨痹，益气强志消痈形。"}]},{"ID":"20240611151214-8dwwy0t","Type":"NodeParagraph","Properties":{"id":"20240611151214-8dwwy0t","updated":"20240611151214"},"Children":[{"Type":"NodeText","Data":"羊食之则淫，人食之好为阴阳，故名。俗云仙灵脾。无毒。补肾虚助阳，主阴痿绝伤，茎中痛，小便不利，丈夫绝阳不兴，女子绝阴不产。又治一切冷风劳气，筋骨挛急，偏风手足不遂，四肢皮肤不仁。益气力，强心志，老人昏耄，中年健忘，消赤痈瘰 ，下部有疮洗虫出。按此兴阳之剂，本草云久服无子者，何也？盖不补真元，徙助虚阳，致动欲火，妄交妄合，精气不实，宜乎无子也。惟阳衰阴痿，略用以鼓动则可。生汉中不闻水声者良，夹刀夹去叶四旁花枝，细锉，羊脂拌炒。山药为使，得酒良。"}]},{"ID":"20240611151118-ghd2exe","Type":"NodeThematicBreak","Properties":{"id":"20240611151118-ghd2exe"}},{"ID":"20240611151204-898g1on","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151204-898g1on","updated":"20240611151208"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草经解》"}]},{"ID":"20240611151204-h9tmn8z","Type":"NodeParagraph","Properties":{"id":"20240611151204-h9tmn8z","updated":"20240611151204"},"Children":[{"Type":"NodeText","Data":"气寒．味辛．无毒．主阴痿绝伤．茎中痛．利小便．益气力．强志．（羊脂拌炒）"}]},{"ID":"20240611151204-gs7wl3b","Type":"NodeParagraph","Properties":{"id":"20240611151204-gs7wl3b","updated":"20240611151204"},"Children":[{"Type":"NodeText","Data":"淫羊藿气寒．禀天冬令之水气．入足少阴肾经．味辛无毒．得地润泽之金味．入手太阴肺经．气味降多于升．阴也．阴者宗筋也．水不制火．火热则筋失其刚性而痿矣．淫羊藿入肾而气寒．寒足以制火而痿自愈也．绝伤者．阴绝而精伤也．气寒益水．味辛能润．润则阴精充也．茎．玉茎也．痛者火郁于中也．热者清之以寒．郁者散之以辛．所以主茎中痛也．小便气化乃出．辛寒之品．清肃肺气．故利小便．肺主气．肾统气．寒益肾．辛润肺．故益气力也．气力既益．内养刚大．所以强志．盖肾藏志也．"}]},{"ID":"20240611151204-79txqbk","Type":"NodeParagraph","Properties":{"id":"20240611151204-79txqbk","updated":"20240611151204"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611151204-8lre8he","Type":"NodeParagraph","Properties":{"id":"20240611151204-8lre8he","updated":"20240611151204"},"Children":[{"Type":"NodeText","Data":"淫羊藿浸酒．治偏风不遂．水涸腰痛．同五味、覆盆丸．治三焦咳嗽．专为末泡汤漱．治牙痛．"}]},{"ID":"20240611151118-t66bn6q","Type":"NodeThematicBreak","Properties":{"id":"20240611151118-t66bn6q"}},{"ID":"20240611151149-087s2pj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151149-087s2pj","updated":"20240611151156"},"Children":[{"Type":"NodeText","Data":"淫羊藿《新修本草》"}]},{"ID":"20240611151149-r80q929","Type":"NodeParagraph","Properties":{"id":"20240611151149-r80q929","updated":"20240611151149"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主阴痿，绝伤，茎中痛，利小便，益气力，强志。坚筋骨，消瘰 ，赤痈，下部有疮洗出虫，丈夫久服，令人无子。一名刚前。生上郡阳山山谷。"}]},{"ID":"20240611151149-zesg0x7","Type":"NodeParagraph","Properties":{"id":"20240611151149-zesg0x7","updated":"20240611151149"},"Children":[{"Type":"NodeText","Data":"薯蓣为之使。服此使人好为阴阳。西川北部有淫羊，一日百遍合，盖食藿所致，故名淫羊藿。"}]},{"ID":"20240611151149-gwzgigq","Type":"NodeParagraph","Properties":{"id":"20240611151149-gwzgigq","updated":"20240611151149"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草，叶形似小豆而圆薄，茎细亦坚，所在皆有，俗名仙灵脾者是也。"}]},{"ID":"20240611151127-oqyunzv","Type":"NodeThematicBreak","Properties":{"id":"20240611151127-oqyunzv"}},{"ID":"20240611151137-aqgxohr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151137-aqgxohr","updated":"20240611151142"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草崇原》"}]},{"ID":"20240611151137-vpz0ix9","Type":"NodeParagraph","Properties":{"id":"20240611151137-vpz0ix9","updated":"20240611151137"},"Children":[{"Type":"NodeText","Data":"气味辛寒，无毒。主治阴痿绝伤，茎中痛，利小便，益气力，强志。"}]},{"ID":"20240611151137-k2i4da5","Type":"NodeParagraph","Properties":{"id":"20240611151137-k2i4da5","updated":"20240611151137"},"Children":[{"Type":"NodeText","Data":"（淫羊藿出上郡阳山山谷，江东陕西、泰山、汉中、湖湘间皆有。茎高一二尺，一茎三桠，一桠三叶，叶似杏叶，上有刺，关中呼为三枝九叶草。枝茎细劲，经冬不凋，四月开白花，亦有紫花者，生处不闻水声者良。陶隐居云∶西川北部有淫羊，一日百遍交合，盖食此藿所致，因以为名。《唐本草》名仙灵脾，有仙灵脾酒，益丈夫，兴阳，理腰膝冷。）"}]},{"ID":"20240611151137-rajj4xr","Type":"NodeParagraph","Properties":{"id":"20240611151137-rajj4xr","updated":"20240611151137"},"Children":[{"Type":"NodeText","Data":"羊为火畜，藿能淫羊，盖禀水中之天气，而得太阳阳热之气化也。禀水中之天气，故气味辛寒。得太阳之阳热，故主治阴痿绝伤。太阳合膀胱寒水之气，故治茎中痛，利小便。太阳之气，上合于肺，内通于肾，故益气力，强志。"}]},{"ID":"20240611151137-o3lz0c8","Type":"NodeParagraph","Properties":{"id":"20240611151137-o3lz0c8","updated":"20240611151137"},"Children":[{"Type":"NodeText","Data":"淫羊藿禀太阳之气，而功能治下，与紫萍禀太阳之气，而浮越于肤表者，少有不同，故生处不闻水声者良。欲使太阳之气藏于水中，而不征现于外也。圣人体察物性，曲尽苦心，学人潜心玩索，庶几得之。"}]},{"ID":"20240611151127-kuxltga","Type":"NodeThematicBreak","Properties":{"id":"20240611151127-kuxltga"}},{"ID":"20240611151128-rvt866m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151128-rvt866m","updated":"20240611151132"},"Children":[{"Type":"NodeText","Data":"淫羊藿《要药分剂》"}]},{"ID":"20240611151128-sd45ro7","Type":"NodeParagraph","Properties":{"id":"20240611151128-sd45ro7","updated":"20240611151128"},"Children":[{"Type":"NodeText","Data":"味辛甘。性温。无毒。得金土之气。而上感天之阳气以生。可升可降。阳也。山药为使。得酒良。"}]},{"ID":"20240611151128-k2us3g7","Type":"NodeParagraph","Properties":{"id":"20240611151128-k2us3g7","updated":"20240611151128"},"Children":[{"Type":"NodeText","Data":"【主治】主阴痿绝伤。茎中痛。利小便。益气力。强志。（本经）坚筋骨。消瘰。下部有疮中年【归经】入命门经。兼入肝经。通入胃大肠三焦三经。为助阳益精之品。（真阳不足者宜之）【前论】士瀛曰。茎中痛。肝肾虚也。补益二经。痛自止矣。"}]},{"ID":"20240611151128-26qmfzm","Type":"NodeParagraph","Properties":{"id":"20240611151128-26qmfzm","updated":"20240611151128"},"Children":[{"Type":"NodeText","Data":"鳌按、别录言久服无子。大明又治绝阴绝阳无子。何二说之相反欤。不知淫羊藿甘温益阳。"}]},{"ID":"20240611151128-u7undb9","Type":"NodeParagraph","Properties":{"id":"20240611151128-u7undb9","updated":"20240611151128"},"Children":[{"Type":"NodeText","Data":"而欲【禁忌】经疏曰。凡虚阳易举。梦遗不止。便赤口干。强阳不痿。均忌。"}]},{"ID":"20240611151128-zz28zln","Type":"NodeParagraph","Properties":{"id":"20240611151128-zz28zln","updated":"20240611151128"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。凡使。夹去叶四畔花枝。每斤用羊脂四两拌炒。"}]},{"ID":"20240611151118-wwi1pge","Type":"NodeThematicBreak","Properties":{"id":"20240611151118-wwi1pge"}},{"ID":"20240611151119-96blck2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151119-96blck2","updated":"20240611151123"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草经集注》"}]},{"ID":"20240611151119-dmxfakn","Type":"NodeParagraph","Properties":{"id":"20240611151119-dmxfakn","updated":"20240611151119"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主治阴痿，绝伤，茎中痛，利小便，益气力，强志。坚筋骨，消瘰 ，赤痈，下部有疮洗出虫，丈夫久服，令人无子。一名刚前。生上郡阳山山谷。（薯蓣服此使人好为阴阳。西川北部有淫羊，一日百遍合，盖食藿所致，故名淫羊藿。"}]},{"ID":"20240611151108-pv3na7g","Type":"NodeThematicBreak","Properties":{"id":"20240611151108-pv3na7g"}},{"ID":"20240611151109-lcof94u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151109-lcof94u","updated":"20240611151113"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草从新》"}]},{"ID":"20240611151109-yneiai0","Type":"NodeParagraph","Properties":{"id":"20240611151109-yneiai0","updated":"20240611151109"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补肾命门．"}]},{"ID":"20240611151109-n772xe5","Type":"NodeParagraph","Properties":{"id":"20240611151109-n772xe5","updated":"20240611151109"},"Children":[{"Type":"NodeText","Data":"辛香甘温．入肝肾．补命门．益精气．坚筋骨．利小便．治绝阳不兴．绝阴不产．冷风劳气．四肢不仁．（手足麻木．）相火易动．远之．一名仙灵脾．北部淫羊．一日百合．食此藿所致．故名．去枝．羊脂拌炒．山药为使．得酒良．（牙齿虚痛、仙灵脾为粗末、煎汤频漱、大效．）"}]},{"ID":"20240611150954-vdhwwrs","Type":"NodeThematicBreak","Properties":{"id":"20240611150954-vdhwwrs"}},{"ID":"20240611151058-yb2xl3s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611151058-yb2xl3s","updated":"20240611151103"},"Children":[{"Type":"NodeText","Data":"淫羊藿《本草求真》"}]},{"ID":"20240611151058-kcl7quh","Type":"NodeParagraph","Properties":{"id":"20240611151058-kcl7quh","updated":"20240611151058"},"Children":[{"Type":"NodeText","Data":"（山草）逐冷散风"}]},{"ID":"20240611151058-7ei0jws","Type":"NodeParagraph","Properties":{"id":"20240611151058-7ei0jws","updated":"20240611151058"},"Children":[{"Type":"NodeText","Data":"淫羊藿（专入命门。兼入肝肾）。辛香甘温。诸书皆载能治男子绝阳不兴。女子绝阴不产。且能治冷风劳气。四肢麻木不仁。腰膝无力。（时珍曰。淫羊藿味甘气香。性温不寒。能益精气。乃手足阳明三焦命门药也。真阳不足者宜之。）盖因气味甘温。则能助阳。兼有辛香。则冷可除而风可散耳！至云久服无子。恐其阳旺多欲。精气耗散。无他故也。（弘景曰。淫羊一日百合。盖食此藿所致。）去枝。羊脂拌炒。山药为使。得酒良。"}]},{"ID":"20240611150955-kpxt5xx","Type":"NodeThematicBreak","Properties":{"id":"20240611150955-kpxt5xx"}},{"ID":"20240611150955-umz08qr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150955-umz08qr","updated":"20240611151000"},"Children":[{"Type":"NodeText","Data":"淫羊藿《中药学》"}]},{"ID":"20240611150955-jz4n27q","Type":"NodeParagraph","Properties":{"id":"20240611150955-jz4n27q","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为小蘗科植物淫羊藿及同属其它植物的全草。"}]},{"ID":"20240611150955-zgc41xr","Type":"NodeParagraph","Properties":{"id":"20240611150955-zgc41xr","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛，温。入肝、肾经。"}]},{"ID":"20240611150955-sdku4vx","Type":"NodeParagraph","Properties":{"id":"20240611150955-sdku4vx","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【功效】补肾助阳，袪风湿。"}]},{"ID":"20240611150955-syumq2k","Type":"NodeParagraph","Properties":{"id":"20240611150955-syumq2k","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肾虚阳痿、遗精早泄、腰膝痿软、肢冷畏寒等症。"}]},{"ID":"20240611150955-9beclo9","Type":"NodeParagraph","Properties":{"id":"20240611150955-9beclo9","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"淫羊翟功能温肾助阳，故适用于肾阳不足的症候。治阳痿遗泄，可配仙茅、山萸肉、肉从蓉等品；治腰膝痿软，可配杜仲，巴戟天、狗脊等品。"}]},{"ID":"20240611150955-ka4m62m","Type":"NodeParagraph","Properties":{"id":"20240611150955-ka4m62m","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"2.用于寒湿痹痛或四肢拘挛麻木等症。"}]},{"ID":"20240611150955-gj7nkc8","Type":"NodeParagraph","Properties":{"id":"20240611150955-gj7nkc8","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"淫羊藿性味辛温，能散风除湿，故又可用于风湿痹痛偏于寒湿者，以及四肢麻木不仁或筋骨拘挛等症，可与威灵仙、巴戟天、肉桂、当归、川芎等配伍同用。"}]},{"ID":"20240611150955-kjyk93h","Type":"NodeParagraph","Properties":{"id":"20240611150955-kjyk93h","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【处方用名】仙灵脾、淫羊藿（洗净，晒干，切碎用。）"}]},{"ID":"20240611150955-ofi86b7","Type":"NodeParagraph","Properties":{"id":"20240611150955-ofi86b7","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240611150955-tpq9v8y","Type":"NodeParagraph","Properties":{"id":"20240611150955-tpq9v8y","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【按语】淫羊藿性味辛温，功能补命门、助肾阳，是临床上治肾阳不足的常用药物根据临床实践体会，本品温肾益火的功效，与仙茅、葫芦巴相近。但仙茅、葫芦巴两药性温偏热，温肾作用较强，服用稍久，即有口苦唇燥的弊害；本品则性温而不热，对偏于肾阳虚的患者，久服无不良现象。"}]},{"ID":"20240611150955-jnht4s9","Type":"NodeParagraph","Properties":{"id":"20240611150955-jnht4s9","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【方剂举例】补肾强身片《上海中成药》：淫羊蕾、菟丝子、金樱子、制狗脊、女贞子。治腰痰足软、头晕耳鸣。"}]},{"ID":"20240611150955-a0pt984","Type":"NodeParagraph","Properties":{"id":"20240611150955-a0pt984","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主阴痿绝伤，茎中痛，利小便，益气力强志。」"}]},{"ID":"20240611150955-h3i7he2","Type":"NodeParagraph","Properties":{"id":"20240611150955-h3i7he2","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"《大明本草》：「一切冷风劳气，筋骨挛急，四肢不仁，补腰膝。」"}]},{"ID":"20240611150955-ey0tafi","Type":"NodeParagraph","Properties":{"id":"20240611150955-ey0tafi","updated":"20240611150955"},"Children":[{"Type":"NodeText","Data":"《本草备要》：「补命门，益精气，坚筋骨，利小便。」"}]},{"ID":"20240611150928-xhk1f9u","Type":"NodeThematicBreak","Properties":{"id":"20240611150928-xhk1f9u"}},{"ID":"20240611150939-nr0fgol","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150939-nr0fgol","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"《中国药典》：淫羊藿"}]},{"ID":"20240611150939-7hk0pnm","Type":"NodeParagraph","Properties":{"id":"20240611150939-7hk0pnm","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611150939-0lsd68x","Type":"NodeParagraph","Properties":{"id":"20240611150939-0lsd68x","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" Yín Yánɡ Huò"}]},{"ID":"20240611150939-mhvii7s","Type":"NodeParagraph","Properties":{"id":"20240611150939-mhvii7s","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611150939-4urxmpl","Type":"NodeParagraph","Properties":{"id":"20240611150939-4urxmpl","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 三枝九叶草、仙灵脾、牛角花、三叉风、羊角风、三角莲"}]},{"ID":"20240611150939-duv75rk","Type":"NodeParagraph","Properties":{"id":"20240611150939-duv75rk","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611150939-jjwhihh","Type":"NodeParagraph","Properties":{"id":"20240611150939-jjwhihh","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" HERBA EPIMEDII"}]},{"ID":"20240611150939-zep2dvg","Type":"NodeParagraph","Properties":{"id":"20240611150939-zep2dvg","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611150939-hcuibw7","Type":"NodeParagraph","Properties":{"id":"20240611150939-hcuibw7","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 本品为小檗科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"淫羊藿"},{"Type":"NodeText","Data":"Epimedium brevicornum Maxim.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"箭叶淫羊藿"},{"Type":"NodeText","Data":"Epimedium sagittatum （Sieb.et Zucc.）Maxim. 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柔毛淫羊藿"},{"Type":"NodeText","Data":"Epimedium pubescens Maxim.、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"巫山淫羊藿"},{"Type":"NodeText","Data":"Epimedium wushanense T.S.Ying、或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"朝鲜淫羊藿"},{"Type":"NodeText","Data":"Epimedium koreanum Nakai的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地上部分"},{"Type":"NodeText","Data":"。夏、秋季茎叶茂盛时采割，除去粗梗及杂质，晒干或阴干。"}]},{"ID":"20240611150939-evm3v9d","Type":"NodeParagraph","Properties":{"id":"20240611150939-evm3v9d","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611150939-4a4roum","Type":"NodeParagraph","Properties":{"id":"20240611150939-4a4roum","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 淫羊藿：茎细圆柱形，长约20cm，表面黄绿色或淡黄色，具光泽。茎生叶对生，二回三出复叶；小叶片卵圆形，长3～8cm，宽2～6cm；先端微尖，顶生小叶基部心形，两侧小叶较小，偏心形，外侧较大，呈耳状，边缘具黄色刺毛状细锯齿；上表面黄绿色，下表面灰绿色，主脉7～9条，基部有稀疏细长毛，细脉两面突起，网脉明显；小叶柄长1～5cm。叶片近革质。无臭，味微苦。"}]},{"ID":"20240611150939-d1k98s5","Type":"NodeParagraph","Properties":{"id":"20240611150939-d1k98s5","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"箭叶淫羊藿：一回三出复叶，小叶片长卵形至卵状披针形，长4～12cm,宽2.5～5cm；先端浙尖，两侧小叶基部明显偏斜，外侧呈箭形。下表面疏被粗短伏毛或近无毛。叶片革质。"}]},{"ID":"20240611150939-y6usitb","Type":"NodeParagraph","Properties":{"id":"20240611150939-y6usitb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"柔毛淫羊藿：叶下表面及叶柄密被绒毛状柔毛。"}]},{"ID":"20240611150939-5tcib9x","Type":"NodeParagraph","Properties":{"id":"20240611150939-5tcib9x","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"巫山淫羊藿：小叶片披针形至狭披针形，长9～23cm,宽1.8～4.5cm；先端渐尖或长渐尖，边缘具刺齿，侧生小叶基部的裂片偏斜，内边裂片小，圆形，外边裂片大，三角形，渐尖。下表面被绵毛或秃净。"}]},{"ID":"20240611150939-wwudqln","Type":"NodeParagraph","Properties":{"id":"20240611150939-wwudqln","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"朝鲜淫羊藿：小叶较大，长4～10cm,宽3.5～7cm，先端长尖。叶片较薄。"}]},{"ID":"20240611150939-2pr65mp","Type":"NodeParagraph","Properties":{"id":"20240611150939-2pr65mp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611150939-gykca99","Type":"NodeParagraph","Properties":{"id":"20240611150939-gykca99","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240611150939-zthjqzs","Type":"NodeParagraph","Properties":{"id":"20240611150939-zthjqzs","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611150939-h4pc3y1","Type":"NodeParagraph","Properties":{"id":"20240611150939-h4pc3y1","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"淫羊藿"},{"Type":"NodeText","Data":"：除去杂质，摘取叶片，喷淋清水，稍润，切丝，干燥。"}]},{"ID":"20240611150939-ckh2krg","Type":"NodeParagraph","Properties":{"id":"20240611150939-ckh2krg","updated":"20240611150939"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炙淫羊藿"},{"Type":"NodeText","Data":"：取羊脂油加热熔化，加入淫羊藿丝，用文火炒至均匀有光泽，取出，放凉。每100kg淫羊藿，用羊脂油（炼油）20kg。"}]},{"ID":"20240611150939-0jxn3yr","Type":"NodeParagraph","Properties":{"id":"20240611150939-0jxn3yr","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611150939-w5qv1e0","Type":"NodeParagraph","Properties":{"id":"20240611150939-w5qv1e0","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 取本品粉末0.5g，加乙醇10ml，温浸30分钟，滤过，滤液蒸干，残渣加乙醇 1ml使溶解，作为供试品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液和[含量测定]项下的对照品溶液各10μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｈ薄层板上，以醋酸乙酯－丁酮-甲酸－水（10:1:1:1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同的暗红色斑点；喷以三氯化铝试液，再置紫外光灯（365nm）下检视，显相同的橙红色荧光斑点。"}]},{"ID":"20240611150939-qalpvpg","Type":"NodeParagraph","Properties":{"id":"20240611150939-qalpvpg","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240611150939-ibxgm80","Type":"NodeParagraph","Properties":{"id":"20240611150939-ibxgm80","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 总黄酮 精密量取淫羊藿苷测定项下供试品溶液0.5ml，置50ml量瓶中，加甲醇至刻度，摇匀，作为供试品溶液。另取淫羊藿苷对照品，加甲醇制成每1ml含10μg的溶液，作为对照品溶液。分别取供试品溶液和对照品溶液，以试剂为空白，照分光亮度法（附录Ⅴ A），在270nm波长处测定吸收度，计算，即得。"}]},{"ID":"20240611150939-2u1163o","Type":"NodeParagraph","Properties":{"id":"20240611150939-2u1163o","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"本品叶片按干燥品计算，含总黄酮以淫羊藿苷（C33H40O15）计，不得少于5.0％。"}]},{"ID":"20240611150939-x132n99","Type":"NodeParagraph","Properties":{"id":"20240611150939-x132n99","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"淫羊藿苷 照高效液相色谱法（附录Ⅵ D）测定。"}]},{"ID":"20240611150939-0lmvjgu","Type":"NodeParagraph","Properties":{"id":"20240611150939-0lmvjgu","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"色谱条件与系统适用性试验 用十八烷基硅烷键合硅胶为填充剂；乙腈-水（30:70）为流动相；检测波长为270nm。理论板数按淫羊藿苷峰计算应不低于1500。"}]},{"ID":"20240611150939-3qx2wp0","Type":"NodeParagraph","Properties":{"id":"20240611150939-3qx2wp0","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"对照品溶液制备 精密称取淫羊藿苷对照品适量，加甲醇制成每1ml含0.1mg的溶液，即得。"}]},{"ID":"20240611150939-2xc3zyz","Type":"NodeParagraph","Properties":{"id":"20240611150939-2xc3zyz","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"供试品溶液的制备 取本品叶片粉末（过40目筛）约0.2g[同时另取本品叶片粉末测定水分（附录Ⅸ H 第一法）]，精密称定，置50ml具塞锥形瓶中，精密加入稀乙醇20ml，密塞，称定重量，超声处理1小时，再称定重量，用稀乙醇补足减失的重量，摇匀，滤过，取续滤液，即得。"}]},{"ID":"20240611150939-x4chhvh","Type":"NodeParagraph","Properties":{"id":"20240611150939-x4chhvh","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"测定法 分别精密吸取对照品溶液与供试品溶液各10μl，注入液相色谱仪，测定，即得。"}]},{"ID":"20240611150939-u30432n","Type":"NodeParagraph","Properties":{"id":"20240611150939-u30432n","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"本品叶片按干燥品计算，含淫羊藿苷（C33H40O15） 不得少于0.50％ 。"}]},{"ID":"20240611150939-jokd6ke","Type":"NodeParagraph","Properties":{"id":"20240611150939-jokd6ke","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611150939-y4055ts","Type":"NodeParagraph","Properties":{"id":"20240611150939-y4055ts","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240611150939-2h5uue5","Type":"NodeParagraph","Properties":{"id":"20240611150939-2h5uue5","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611150939-mlr6hn8","Type":"NodeParagraph","Properties":{"id":"20240611150939-mlr6hn8","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 辛、甘，温。"}]},{"ID":"20240611150939-6zxj2cj","Type":"NodeParagraph","Properties":{"id":"20240611150939-6zxj2cj","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611150939-k94vgqw","Type":"NodeParagraph","Properties":{"id":"20240611150939-k94vgqw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 补肾阳，强筋骨，祛风湿。用于阳痿遗精，筋骨痿软，风湿痹痛，麻木拘挛；更年期高血压。"}]},{"ID":"20240611150939-rje5c9g","Type":"NodeParagraph","Properties":{"id":"20240611150939-rje5c9g","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611150939-ft3mhvw","Type":"NodeParagraph","Properties":{"id":"20240611150939-ft3mhvw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240611150939-rofdz4c","Type":"NodeParagraph","Properties":{"id":"20240611150939-rofdz4c","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611150939-g8fu7bb","Type":"NodeParagraph","Properties":{"id":"20240611150939-g8fu7bb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611150939-9lq8kk6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150939-9lq8kk6","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：淫羊藿"}]},{"ID":"20240611150939-522j4yx","Type":"NodeParagraph","Properties":{"id":"20240611150939-522j4yx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611150939-1llleze","Type":"NodeParagraph","Properties":{"id":"20240611150939-1llleze","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" Yín Yánɡ Huò"}]},{"ID":"20240611150939-2d1wfxg","Type":"NodeParagraph","Properties":{"id":"20240611150939-2d1wfxg","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611150939-c4t8p9p","Type":"NodeParagraph","Properties":{"id":"20240611150939-c4t8p9p","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 刚前（《本经》），仙灵脾（《雷公炮炙论》），仙灵毗（《柳柳州集》），放杖草、弃杖草、千两金、干鸡筋、黄连祖（《日华子本草》），三枝九叶草（《本草图经》），牛角花、铜丝草、铁打杵（《贵州民间方药集》），三叉骨、肺经草、铁菱角（《湖南药物志》）。"}]},{"ID":"20240611150939-4bvfwvh","Type":"NodeParagraph","Properties":{"id":"20240611150939-4bvfwvh","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611150939-c0t9sqx","Type":"NodeParagraph","Properties":{"id":"20240611150939-c0t9sqx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611150939-ablp5j3","Type":"NodeParagraph","Properties":{"id":"20240611150939-ablp5j3","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611150939-t9pu8dc","Type":"NodeParagraph","Properties":{"id":"20240611150939-t9pu8dc","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 为小檗科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"淫羊藿、心叶淫羊藿"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"箭叶淫羊藿"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎叶"},{"Type":"NodeText","Data":"。夏、秋采收，割取茎叶，除去杂质，晒干。"}]},{"ID":"20240611150939-ot1l0ny","Type":"NodeParagraph","Properties":{"id":"20240611150939-ot1l0ny","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611150939-glv6k4h","Type":"NodeParagraph","Properties":{"id":"20240611150939-glv6k4h","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 产陕西、辽宁、山西、湖北、四川、广西等地。"}]},{"ID":"20240611150939-9iizjq7","Type":"NodeParagraph","Properties":{"id":"20240611150939-9iizjq7","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611150939-742f99b","Type":"NodeParagraph","Properties":{"id":"20240611150939-742f99b","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①淫羊藿"}]},{"ID":"20240611150939-29a5ls3","Type":"NodeParagraph","Properties":{"id":"20240611150939-29a5ls3","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～40厘米。根茎长，横走，质硬，须根多数。叶为2回3出复叶，小叶9片，有长柄，小叶片薄革质，卵形至长卵圆形，长4.5～9厘米，宽3.5～7.5厘米，先端尖，边缘有细锯齿，锯齿先端成刺状毛，基部深心形，侧生小叶基部斜形，上面幼时有疏毛，开花后毛渐脱落，下面有长柔毛。花4～6朵成总状花序，花序轴无毛或偶有毛，花梗长约1厘米；基部有苞片，卵状披针形，膜质；花大，直径约2厘米，黄白色或乳白色；花萼8片，卵状披针形，2轮，外面4片小，不同形，内面4片较大，同形；花瓣4，近圆形，具长距；雄蕊4；雌蕊1，花柱长。蓇葖果纺锤形，成熟时2裂。花期4～5月。果期5～6月。"}]},{"ID":"20240611150939-j0b9mre","Type":"NodeParagraph","Properties":{"id":"20240611150939-j0b9mre","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"生长于多荫蔽的树林及灌丛中。分布黑龙江、吉林、辽宁、山东、江苏、江西、湖南、广西、四川、贵州、陕西、甘肃。"}]},{"ID":"20240611150939-itp7xl9","Type":"NodeParagraph","Properties":{"id":"20240611150939-itp7xl9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②心叶淫羊藿"}]},{"ID":"20240611150939-ic78ifk","Type":"NodeParagraph","Properties":{"id":"20240611150939-ic78ifk","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～40厘米。形与上种相似，但小叶片卵圆形或近圆形，长2.5～5厘米，宽2～4厘米，先端宽阔锐尖，边缘具锯齿，基部深心形，侧生小叶不对称，外侧有小尖头。花成聚伞状圆锥花序，花梗有腺毛；花通常白色。花期6～7月。果期8月。"}]},{"ID":"20240611150939-37knm8r","Type":"NodeParagraph","Properties":{"id":"20240611150939-37knm8r","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"生于阴湿的山沟中。分布山西、陕西、甘肃、青海、广西、湖南、安徽等地。"}]},{"ID":"20240611150939-bo1wlyw","Type":"NodeParagraph","Properties":{"id":"20240611150939-bo1wlyw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③箭叶淫羊藿"}]},{"ID":"20240611150939-t207iys","Type":"NodeParagraph","Properties":{"id":"20240611150939-t207iys","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～50厘米。根茎匍行呈结节状。根出叶1～3枚，3出复叶，小叶卵圆形至卵状披针形，长4～9厘米，宽2.5～5厘米，先端尖或渐尖，边缘有细刺毛，基部心形，侧生小叶基部不对称，外侧裂片形斜而较大，三角形，内侧裂片较小而近于圆形；茎生叶常对生于顶端，形与根出叶相似，基部呈歪箭状心形，外侧裂片特大而先端渐尖。花多数，聚成总状或下部分枝而成圆锥花序，花小，直径仅6～8毫米，花瓣有短距或近于无距。花期2～3月。果期4～5月。"}]},{"ID":"20240611150939-80g7fht","Type":"NodeParagraph","Properties":{"id":"20240611150939-80g7fht","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"生于山坡竹林下或路旁岩石缝中。分布浙江、安徽、江西，湖北、四川、台湾、福建、广东、广西等地。"}]},{"ID":"20240611150939-0i65oy6","Type":"NodeParagraph","Properties":{"id":"20240611150939-0i65oy6","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"以上几种植物的根茎（淫羊藿根）亦供药用，另详专条。"}]},{"ID":"20240611150939-tku7sl2","Type":"NodeParagraph","Properties":{"id":"20240611150939-tku7sl2","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"在云南地区应用的淫羊藿，其原植物为尖叶淫羊藿，叶为3小叶或单叶，小叶片狭长，叶背有柔毛。总状花序具10～15朵花，小花梗长而无毛，距较内部的花萼长一倍。"}]},{"ID":"20240611150939-mq9b2up","Type":"NodeParagraph","Properties":{"id":"20240611150939-mq9b2up","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611150939-94titdy","Type":"NodeParagraph","Properties":{"id":"20240611150939-94titdy","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①淫羊藿（又名：大叶淫羊藿）"}]},{"ID":"20240611150939-3n8oqbc","Type":"NodeParagraph","Properties":{"id":"20240611150939-3n8oqbc","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"干燥茎细长圆柱形，中空，长20～30厘米.棕色或黄色，具纵棱，无毛。叶生茎顶.多为一茎生三枝，一枝生三叶。叶片呈卵状心形，先端尖，基部心形。边缘有细刺状锯齿，上面黄绿色，光滑，下面灰绿色，中脉及细脉均突出。叶薄如纸而有弹性。有青草气，味苦。"}]},{"ID":"20240611150939-ec2rd2l","Type":"NodeParagraph","Properties":{"id":"20240611150939-ec2rd2l","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②心叶淫羊藿（又名：小叶淫羊藿）叶片为圆心形，先端微尖。其他与淫羊藿同。"}]},{"ID":"20240611150939-nj2y752","Type":"NodeParagraph","Properties":{"id":"20240611150939-nj2y752","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③箭叶淫羊藿"}]},{"ID":"20240611150939-rt5pa31","Type":"NodeParagraph","Properties":{"id":"20240611150939-rt5pa31","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"叶片为箭状长卵形，革质；叶端渐尖呈刺状，叶基箭形。其他与淫羊藿同。"}]},{"ID":"20240611150939-f8s4zau","Type":"NodeParagraph","Properties":{"id":"20240611150939-f8s4zau","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"以上药材均以梗少、叶多、色黄绿、不破碎者为佳。"}]},{"ID":"20240611150939-eilji8f","Type":"NodeParagraph","Properties":{"id":"20240611150939-eilji8f","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611150939-20c25bt","Type":"NodeParagraph","Properties":{"id":"20240611150939-20c25bt","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 日本产淫羊藿能使蛙的瞳孔扩大，使小白鼠随意运动增加，反射机能亢进，往往发生轻度痉挛，遂至呼吸停止而死，心脏于呼吸停止后一定时间内持续搏动。"}]},{"ID":"20240611150939-9fm7nf9","Type":"NodeParagraph","Properties":{"id":"20240611150939-9fm7nf9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611150939-cyw4r77","Type":"NodeParagraph","Properties":{"id":"20240611150939-cyw4r77","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 淫羊藿茎、叶含淫羊藿甙，叶尚含挥发油、蜡醇、卅一烷、植物甾醇、鞣质、油脂。脂肪油中的脂肪酸有棕榈酸、硬脂酸、油酸、亚油酸。"}]},{"ID":"20240611150939-i28zma9","Type":"NodeParagraph","Properties":{"id":"20240611150939-i28zma9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611150939-wm16sum","Type":"NodeParagraph","Properties":{"id":"20240611150939-wm16sum","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①对性机能的影响"}]},{"ID":"20240611150939-0gm3ibb","Type":"NodeParagraph","Properties":{"id":"20240611150939-0gm3ibb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"淫羊藿有催淫作用，这种作用由于精液分泌亢进，精囊充满后，刺激感觉神经，间接兴奋性欲而起；用淫羊藿或日本产淫羊藿制成的流浸膏，对狗虽不能表现举尾反应，但可知其有促进精液分泌的作用，其叶及根部作用最强，果实次之，茎部最弱；以前列腺、精囊、提肛肌增加重量的方法（小鼠）证明淫羊藿提取液具有雄性激素样作用，其效力较蛇床子弱，但强于始蚧及海马，注射其提取液20～40毫克，其效力相当于7.5微克睾丸素。淫羊藿煎剂用于摘除两侧卵巢的小鼠，证明无雌性激素的作用，对大鼠交配率、排卵周期、家兔小便中雌性激素的排出均无影响，其热水及冷水浸剂结果亦同。日本产淫羊藿乙醇提取物对正常及去卵巢雌性小鼠的性周期无影响，亦不增加子宫、卵巢的重量。"}]},{"ID":"20240611150939-0cj46fy","Type":"NodeParagraph","Properties":{"id":"20240611150939-0cj46fy","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②对微生物的影响"}]},{"ID":"20240611150939-l28kf95","Type":"NodeParagraph","Properties":{"id":"20240611150939-l28kf95","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"淫羊藿煎剂试管内对脊髓灰质炎病毒有显着的抑制作用，在药物与病毒接触1小时内，即表现灭活作用，对其他肠道病毒亦能抑制；对白色葡萄球菌、金黄色葡萄球菌有显着抑菌作用，对奈氏卡他球菌、肺炎双球菌、流感嗜血杆菌有轻度抑制作用。1％浓度对人型结核杆菌有抑菌效力。"}]},{"ID":"20240611150939-4j3xu3i","Type":"NodeParagraph","Properties":{"id":"20240611150939-4j3xu3i","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③镇咳、祛痰与平喘作用"}]},{"ID":"20240611150939-y355nrd","Type":"NodeParagraph","Properties":{"id":"20240611150939-y355nrd","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"淫羊藿的各种制剂中，以茎叶鲜品提取物C及淫羊藿复方Ⅱ号（淫羊藿：桉叶：洋金花=8：2：1）有一定的祛痰作用（小鼠酚红法），乙酸乙酯提取物初步认为有镇咳作用（SO2引起小鼠咳嗽方法），对豚鼠支气管哮喘的平喘作用不够理想。"}]},{"ID":"20240611150939-yv37czm","Type":"NodeParagraph","Properties":{"id":"20240611150939-yv37czm","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240611150939-u8h9gxw","Type":"NodeParagraph","Properties":{"id":"20240611150939-u8h9gxw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"淫羊藿提取液对家兔有降压作用，小量使尿分泌增加，大量则反而抑制之，对离体兔肠有抑制作用，离体子宫则先兴奋后抑制，口服能使高血糖大鼠血糖下降，淫羊藿中含有维生素E（鸡鉴定法）。"}]},{"ID":"20240611150939-crssm8m","Type":"NodeParagraph","Properties":{"id":"20240611150939-crssm8m","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"仙灵脾（箭叶淫羊藿）煎剂及醇提溶液对麻醉家兔、正常和肾型高血压大白鼠都可使血压下降，关于仙灵脾的降压原理有认为主要是由于周围血管扩张所致，也有认为主要由于血管运动中枢的抑制。二仙合剂（仙灵脾、黄柏、当归、知母、仙茅、巴戟天）对麻醉猫、犬的急性实验及高血压犬均表现降压作用，对大白鼠神经型、肾型、睾丸切除型高血压具有显著降压作用，对大白鼠肾上腺烫伤型及卵巢切除型的降压不显著，经初步分析二仙合剂中以黄柏和仙灵脾为主要降压成分。"}]},{"ID":"20240611150939-hs8b0yp","Type":"NodeParagraph","Properties":{"id":"20240611150939-hs8b0yp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611150939-hfere4f","Type":"NodeParagraph","Properties":{"id":"20240611150939-hfere4f","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 淫羊藿：拣净杂质，去梗，切丝，筛去碎屑。炙淫羊藿：先取羊脂袖置锅内加热熔化，去渣，再加入淫羊藿微炒，至羊脂油基本吸尽，取出放凉。（每淫羊藿100斤，用炼成的羊脂油25斤）"}]},{"ID":"20240611150939-gxs3hxq","Type":"NodeParagraph","Properties":{"id":"20240611150939-gxs3hxq","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611150939-4flo0jo","Type":"NodeParagraph","Properties":{"id":"20240611150939-4flo0jo","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240611150939-nxyk3f6","Type":"NodeParagraph","Properties":{"id":"20240611150939-nxyk3f6","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入肝、肾二经。\""}]},{"ID":"20240611150939-1a3j3fi","Type":"NodeParagraph","Properties":{"id":"20240611150939-1a3j3fi","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"手、足阳明，三焦，命门。\""}]},{"ID":"20240611150939-66beva8","Type":"NodeParagraph","Properties":{"id":"20240611150939-66beva8","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入手厥阴，足少阴、厥阴。\""}]},{"ID":"20240611150939-91ewjz0","Type":"NodeParagraph","Properties":{"id":"20240611150939-91ewjz0","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611150939-phys8i7","Type":"NodeParagraph","Properties":{"id":"20240611150939-phys8i7","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 辛甘，温。"}]},{"ID":"20240611150939-e9eatfg","Type":"NodeParagraph","Properties":{"id":"20240611150939-e9eatfg","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"无毒。\""}]},{"ID":"20240611150939-j1qau5b","Type":"NodeParagraph","Properties":{"id":"20240611150939-j1qau5b","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味甘，平。\""}]},{"ID":"20240611150939-b5tn29k","Type":"NodeParagraph","Properties":{"id":"20240611150939-b5tn29k","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③《蜀本草》：\"温。\""}]},{"ID":"20240611150939-yoe8zri","Type":"NodeParagraph","Properties":{"id":"20240611150939-yoe8zri","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"性微温，味微辛。\""}]},{"ID":"20240611150939-m3gvx38","Type":"NodeParagraph","Properties":{"id":"20240611150939-m3gvx38","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611150939-d19r0ts","Type":"NodeParagraph","Properties":{"id":"20240611150939-d19r0ts","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 阴虚而相火易动者忌服。"}]},{"ID":"20240611150939-qphn3kv","Type":"NodeParagraph","Properties":{"id":"20240611150939-qphn3kv","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"薯蓣为之使。\""}]},{"ID":"20240611150939-11ngi61","Type":"NodeParagraph","Properties":{"id":"20240611150939-11ngi61","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"紫芝为使。得酒良。\""}]},{"ID":"20240611150939-awqzorq","Type":"NodeParagraph","Properties":{"id":"20240611150939-awqzorq","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"虚阳易举，梦遗不止，便赤口干，强阳不痿并忌之。\""}]},{"ID":"20240611150939-w8pbij9","Type":"NodeParagraph","Properties":{"id":"20240611150939-w8pbij9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611150939-xta7s19","Type":"NodeParagraph","Properties":{"id":"20240611150939-xta7s19","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 补肾壮阳，祛风除湿。治阳痿不举，小便淋沥，筋骨挛急，半身不遂，腰膝无力，风湿痹痛，四肢不仁。"}]},{"ID":"20240611150939-jpidxun","Type":"NodeParagraph","Properties":{"id":"20240611150939-jpidxun","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主阴痿绝伤，茎中痛。利小便，益气力，强志。\""}]},{"ID":"20240611150939-llc9z9a","Type":"NodeParagraph","Properties":{"id":"20240611150939-llc9z9a","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"坚筋骨。消瘰疬、赤痈；下部有疮，洗，出虫。\""}]},{"ID":"20240611150939-rxv34ry","Type":"NodeParagraph","Properties":{"id":"20240611150939-rxv34ry","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治一切冷风劳气，补腰膝，强心力，丈夫绝阳不起，女子绝阴无子，筋骨挛急，四肢不任，老人昏耄，中年健忘。\""}]},{"ID":"20240611150939-7vduhk2","Type":"NodeParagraph","Properties":{"id":"20240611150939-7vduhk2","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"④《医学入门》：\"补肾虚，助阳。治偏风手足不遂，四肢皮肤不仁。\""}]},{"ID":"20240611150939-7nuj5jb","Type":"NodeParagraph","Properties":{"id":"20240611150939-7nuj5jb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611150939-1pdx9hf","Type":"NodeParagraph","Properties":{"id":"20240611150939-1pdx9hf","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；浸酒、熬膏或入丸、散。外用：煎水洗。"}]},{"ID":"20240611150939-tr8vze1","Type":"NodeParagraph","Properties":{"id":"20240611150939-tr8vze1","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611150939-38z7m60","Type":"NodeParagraph","Properties":{"id":"20240611150939-38z7m60","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①治偏风，手足不遂，皮肤不仁：仙灵脾一斤，细锉，以生绢袋盛，于不津器中，用无灰酒二斗浸之，以厚纸重重密封，不得通气，春夏三日，秋冬五日。每日随性暖饮之，常令醺醺，不得大醉。（《圣惠方》）"}]},{"ID":"20240611150939-5zlrsho","Type":"NodeParagraph","Properties":{"id":"20240611150939-5zlrsho","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②治风走注疼痛，来往不定：仙灵牌一两，威灵仙一两，芎藭一两，桂心一两，苍耳子一两。上药，捣细罗为散。每服，不计时候，以温酒调下一钱。（《圣惠方》仙灵脾散）"}]},{"ID":"20240611150939-mvuecjw","Type":"NodeParagraph","Properties":{"id":"20240611150939-mvuecjw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③治目昏生翳：仙灵脾、生王瓜（即小栝楼红色者）等分。为末，每服一钱，茶下，日二服。（《圣济总录》）"}]},{"ID":"20240611150939-yw7uixw","Type":"NodeParagraph","Properties":{"id":"20240611150939-yw7uixw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"④治牙疼：仙灵脾，不拘多少，为粗末，煎汤漱牙齿。（《奇效良方》固牙散）"}]},{"ID":"20240611150939-33uppwk","Type":"NodeParagraph","Properties":{"id":"20240611150939-33uppwk","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611150939-77cx05t","Type":"NodeParagraph","Properties":{"id":"20240611150939-77cx05t","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①治疗小儿麻痹症"}]},{"ID":"20240611150939-wlkaje0","Type":"NodeParagraph","Properties":{"id":"20240611150939-wlkaje0","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"取淫羊藿、桑寄生等量，制成每2毫升含生药各1克的注射液。急性期以肌肉注射为主，配合穴位注射。肌肉注射每次2毫升，每日2次，连续20天。恢复期及后遗症期以穴位注射为主，配合肌肉注射。穴位注射按常规取穴，每穴注射1～2毫升，隔日1次，连续20天，休息半月再继续治疗。治疗各期小儿麻痹症共246例，其中急性期患者34例，痊愈8例，基本痊愈16例，显着有效7例，有效2例，无效1例；恢复期患者43例，痊愈21例，有效15例，进步5例，无效2例；后遗症期患者共169例，痊愈及基本痊愈9例，显着有效及有效129例，无效31例。据观察，本品对急性期及刚进入恢复期的病例疗效显著，恢复较快。对后遗症期也有一定效果，用药后患肢普遍有发热、有劲等感觉，有效病例可见肌肉逐渐恢复，患肢增粗；其中以一下肢麻痹者疗效较好，上肢麻痹及年龄较大者疗效较差。用药后除有口干现象外，未见其它副作用。"}]},{"ID":"20240611150939-aezwscp","Type":"NodeParagraph","Properties":{"id":"20240611150939-aezwscp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②治疗神经衰弱"}]},{"ID":"20240611150939-toqaj34","Type":"NodeParagraph","Properties":{"id":"20240611150939-toqaj34","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"㈠用3％淫羊蕾煎液游子透入法，每日1次，10～20次为一疗程。少数患者另服镇静剂。观察104例，痊愈22例，显著进步21例，进步46例，无效15例。疗程长者疗效较好；治疗后症状开始好转愈早，疗效愈好，而治疗15次病情仍无好转者，即使继续治疗，疗效亦不显著，且不巩固。少数病例治疗初期可出现轻度反应或症状暂时加重，但继续治疗即迅速消失。㈡用20％淫羊藿酊每次5毫升，每日3次饭前服，连续2～3月。治疗50例，约有80％患者治后症状消除或减轻。服药期间未见不良反应，但不适用于兴奋过程占优势或性欲亢进，及高血压患者。"}]},{"ID":"20240611150939-f8akrcb","Type":"NodeParagraph","Properties":{"id":"20240611150939-f8akrcb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③治疗慢性气管炎"}]},{"ID":"20240611150939-iharqnb","Type":"NodeParagraph","Properties":{"id":"20240611150939-iharqnb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"以单味淫羊藿丸观察1000余例，一疗程的有效率为74.6％，近期控制和显效率为22.1％。如配合矮地茶等组成复方治疗，疗效有所提高。实践证明，单纯型的疗效优于喘息型，年龄大者疗效较差，但病程长短与疗效无明显关系；祛痰、镇咳作用较好，平喘较差；经治两个疗程者比一个疗程的近期控制和显效率有显著提高。观察中曾对经治一疗程的110例进行随访，结果半年后的有效率为59.1％，较原来疗效下降26.1％。制剂及用法：取淫羊藿茎、叶（干品），以其总量的80％煎取浓汁，20％研粉，两者混合为丸。每日量相当于生药1两，两次分服。治疗中曾以相当于生药5钱和1.5两的剂量（一日量），分别对部分病例进行观察，结果疗效与日服1两者均基本相似。服药后部分病例有轻微反应，以口干、恶心为多见，其次为腹胀、头晕，一般可自行消失。"}]},{"ID":"20240611150939-7tyo9pb","Type":"NodeParagraph","Properties":{"id":"20240611150939-7tyo9pb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611150939-l4aa7ko","Type":"NodeParagraph","Properties":{"id":"20240611150939-l4aa7ko","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"淫羊藿，性温不寒，能益精气，真阳不足者宜之。\""}]},{"ID":"20240611150939-b8mcg29","Type":"NodeParagraph","Properties":{"id":"20240611150939-b8mcg29","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"淫羊藿，其气温而无毒。《本经》言寒者，误也。辛以润肾，甘温益阳气，故主阴痿绝阳，益气力，强志。茎中痛者，肝肾虚也，补益二经，痛自止矣。膀胱者。州都之官，津液藏焉，气化则能出矣，辛以润其燥，甘温益阳气以助其化，故利小便也。肝主筋，肾主骨，益肾肝则筋骨自坚矣。辛能散结，甘能缓中，温能通气行血，故主瘰疬赤痈，及下部有疮，洗出虫。\""}]},{"ID":"20240611150939-10xe04o","Type":"NodeParagraph","Properties":{"id":"20240611150939-10xe04o","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"③《本草述》：\"淫羊藿，《本经》首主阴痿绝伤，《日华子》亦首言其疗男子绝阳，女子绝阴，则谓入命门、补真阳者是也。盖命门为肾中之真阳，即人身之元气也，其所谓绝阳绝阴，不本之元气，何以嘘之于既槁。所谓益气力，强志，并治冷气劳气，筋骨挛急等证，皆其助元气之故。至若茎中痛，小便不利，皆肝肾气虚所致，此味入肾而助元阳，即是补肾气，而肝肾固同一治也。老人昏耄，中年健忘，皆元阳衰败而不能上升者也。以是思功，功可知矣。须知此味以降为升，其升由于能降也。\""}]},{"ID":"20240611150939-qgy51yz","Type":"NodeParagraph","Properties":{"id":"20240611150939-qgy51yz","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"④《本草正义》：\"淫羊藿，禀性辛温，专壮肾阳，故主阴痿，曰绝伤者，即阳事之绝伤也。茎中痛，亦肾脏之虚寒。利小便者，指老人及虚寒人之阳事不振，小便滴沥者言之，得其补助肾阳而小便自利，非湿热蕴结，水道赤涩者可比，读书慎勿误会。益气力、强志、坚筋骨，皆元阳振作之功，然虚寒者固其所宜，而阴精不充，真阳不固者，万不可为揠苗之助长也。消瘰疬、赤痈，盖亦因其温通气血，故能消化凝结。然疬疡之病，由于阴血不充，肝阳燔灼，而煎熬津液，凝结痰浊者为多，幸勿误读古书，反以助其烈焰。洗下部之疮，则辛燥能除湿热，亦犹蛇床子洗疮杀虫耳。《日华》主丈夫绝阳，女子绝阴，一切冷风劳气，筋骨挛急，四肢不仁，补腰膝，则辛温之品，固不独益肾壮阳。并能通行经络，祛除风寒湿痹。但《日华》又谓治老人昏耄，中年健忘，则未免誉之太过。而景岳且谓男子阳衰，女子阴衰之艰于子嗣者，皆宜服之，则偏信温补，其弊滋多，更非中正之道矣。石顽谓一味仙灵脾酒，为偏风不遂要药，按不遂之病有二因：一为气血俱虚，不能荣养经络，或风寒湿热痹着之病，古人之所谓痹症是也，其来也缓；一为气血上冲，扰乱脑神经而忽失其运动之病，今之所谓中风，西医之所谓脑经病是也，其病也暴。仙灵脾酒，止可治风寒湿痹之不遂，并不能治气血两虚之不遂，而血冲脑经之不遂，更万万不可误用。\""}]},{"ID":"20240611150939-3vov0rf","Type":"NodeParagraph","Properties":{"id":"20240611150939-3vov0rf","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611150939-uky8r6t","Type":"NodeParagraph","Properties":{"id":"20240611150939-uky8r6t","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611150939-iifjf2r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611150939-iifjf2r","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"《中华本草》：淫羊藿"}]},{"ID":"20240611150939-h3kk62u","Type":"NodeParagraph","Properties":{"id":"20240611150939-h3kk62u","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611150939-owtsnc8","Type":"NodeParagraph","Properties":{"id":"20240611150939-owtsnc8","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" Yín Yánɡ Huò"}]},{"ID":"20240611150939-ze1w1i7","Type":"NodeParagraph","Properties":{"id":"20240611150939-ze1w1i7","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611150939-3horh6s","Type":"NodeParagraph","Properties":{"id":"20240611150939-3horh6s","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 刚前、仙灵脾、仙灵毗、黄连祖、放杖草、弃杖草、三叉风、桂鱼风、铁铧口、铁耙头、鲫鱼风、羊藿叶、羊角风、三角莲、乏力草、千两金、干鸡筋、鸡爪莲、三枝九叶草、牛角花、铜丝草、铁打杵、三叉骨、肺经草、铁菱角。"}]},{"ID":"20240611150939-nlpxv80","Type":"NodeParagraph","Properties":{"id":"20240611150939-nlpxv80","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611150939-updrh61","Type":"NodeParagraph","Properties":{"id":"20240611150939-updrh61","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" Herb of Shorthorned Epimedium, Herb of Sagittate Epimedium, Herb of Pubescent epimedium,Herb of Korean Epimedium,Epimedium Herb"}]},{"ID":"20240611150939-tf6om9j","Type":"NodeParagraph","Properties":{"id":"20240611150939-tf6om9j","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611150939-fd01n91","Type":"NodeParagraph","Properties":{"id":"20240611150939-fd01n91","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611150939-zf74gxp","Type":"NodeParagraph","Properties":{"id":"20240611150939-zf74gxp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"1．《本草图经》：淫羊藿，今江东、陕西、泰山、汉中、湖、湘间皆有之。叶青似杏叶，上有刺。茎如粟秆。根紫色，有须。四月开花，白色，亦有紫色碎小独头子。五月采叶晒干。湖、湘出者，叶如小豆，枝茎坚细，经冬不雕，根似黄连。关中谷呼三枝九叶草，苗高一、二尺许，根叶俱堪使。"}]},{"ID":"20240611150939-972gzz1","Type":"NodeParagraph","Properties":{"id":"20240611150939-972gzz1","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2．《纲目》：淫羊藿，生大山在，一根数茎，茎粗如线，高一二尺，一茎三桠，一桠三叶，叶长二三寸，如杏叶及"}]},{"ID":"20240611150939-rrhhhhx","Type":"NodeParagraph","Properties":{"id":"20240611150939-rrhhhhx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611150939-yo2tm8s","Type":"NodeParagraph","Properties":{"id":"20240611150939-yo2tm8s","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 药材基源：为小檗科植物淫羊藿、前叶淫羊藿、箭叶淫羊藿、巫山淫羊藿、朝鲜淫羊藿、柔毛淫羊藿等的茎叶。"}]},{"ID":"20240611150939-crdzrab","Type":"NodeParagraph","Properties":{"id":"20240611150939-crdzrab","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Epimedium brevicornum Maxim.2.Epimedium sagittatum.3.Epimedium wushanense.4.Epimedium koreanum Nakai.5.Epimedium pubesens Maxim."}]},{"ID":"20240611150939-h3qi83k","Type":"NodeParagraph","Properties":{"id":"20240611150939-h3qi83k","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋采收，割取茎叶，除去杂质，晒干。"}]},{"ID":"20240611150939-cz5ngqo","Type":"NodeParagraph","Properties":{"id":"20240611150939-cz5ngqo","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611150939-ikn8qa6","Type":"NodeParagraph","Properties":{"id":"20240611150939-ikn8qa6","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡阴湿处或山谷林下。"}]},{"ID":"20240611150939-es1i0y9","Type":"NodeParagraph","Properties":{"id":"20240611150939-es1i0y9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2.生于山地、密林、岩石缝中、溪旁或阴处潮湿地。"}]},{"ID":"20240611150939-e1074qk","Type":"NodeParagraph","Properties":{"id":"20240611150939-e1074qk","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3.生于溪边、沟谷。"}]},{"ID":"20240611150939-yksml0p","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611150939-yksml0p","updated":"20240611150939"},"Children":[{"ID":"20240611150939-sq6rm5y","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240611150939-sq6rm5y","updated":"20240611150939"},"Children":[{"ID":"20240611150939-eormrrx","Type":"NodeParagraph","Properties":{"id":"20240611150939-eormrrx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"生于多明的林下或灌丛间，喜富含腐殖质并较湿润的土壤。"}]}]}]},{"ID":"20240611150939-iq8r26u","Type":"NodeParagraph","Properties":{"id":"20240611150939-iq8r26u","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"5.生于山坡、林下草丛中，喜阴湿地带。"}]},{"ID":"20240611150939-oolbgah","Type":"NodeParagraph","Properties":{"id":"20240611150939-oolbgah","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于内蒙古、北京、河北、山西、陕西、宁夏、甘肃、青海、新疆、安徽、河南、湖北、湖南、广西、四川等地。"}]},{"ID":"20240611150939-lpqvfnf","Type":"NodeParagraph","Properties":{"id":"20240611150939-lpqvfnf","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2.分布于陕西、甘肃、江苏、安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西、四川、贵州等地。"}]},{"ID":"20240611150939-rea39r6","Type":"NodeParagraph","Properties":{"id":"20240611150939-rea39r6","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3.分布于陕西、广西、四川、贵州等地。"}]},{"ID":"20240611150939-b870ytk","Type":"NodeParagraph","Properties":{"id":"20240611150939-b870ytk","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"4.分布于黑龙江、吉林、辽宁等地。"}]},{"ID":"20240611150939-jmt6ras","Type":"NodeParagraph","Properties":{"id":"20240611150939-jmt6ras","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"5.分布于内蒙古、河北、陕西、甘肃、安微、浙江、江西、河南、湖北、四川、贵州等地。"}]},{"ID":"20240611150939-vw9rkip","Type":"NodeParagraph","Properties":{"id":"20240611150939-vw9rkip","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611150939-l37bx4v","Type":"NodeParagraph","Properties":{"id":"20240611150939-l37bx4v","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 1.淫羊藿，多年生草本，高30-40cm。根茎，横走，直径3-5mm，质硬，生多数须根。茎直立，有棱，无毛，通常无基生叶。茎生叶2，生于茎顶；有长柄；二回三出复叶，小叶9，宽卵莆或近圆形，长3-7cm，宽2.5-6cm，先端急尖或短渐尖，基部深心形，边缘有刺齿，下面绿色，有光泽，无毛，下苍白色，疏生少数柔毛，两面网脉明显；顶生小叶基部裂片圆形，均等，两侧小叶基部裂片不对称，内侧圆形，外侧急尖。圆锥花序顶生，较狭，长10-35cm；花序轴及花梗有腺毛；花梗基部苞片卵状披针形，膜质；花白色直径1.5,20-50朵，花便长5-20mm；外萼片4，狭卵形，带暗绿色，长1-3mm,内萼片4，披针形，白色或淡黄色，长约Icm，宽2-4mm,花瓣4，小，距长2-3mm；雄蕊4，长3-4mm，花药长约2mm;雌蕊1，花柱长。蓇葖果长Icm，先端有喙。种子1-2颗，褐色。花期5-6月，果期 6-8月。"}]},{"ID":"20240611150939-wx1bjj9","Type":"NodeParagraph","Properties":{"id":"20240611150939-wx1bjj9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2.箭叶淫羊藿 多年生常绿草本、高25-50cm。根茎短粗，略呈结节状，坚硬，外皮褐色，断面白色。茎有条棱，无毛。基生叶1-3mm，一回三出复叶；叶柄细，长4-18cm；茎生叶2，常生于茎顶，与基生叶同型；小叶革质，狭卵至披针形，长15-19cm，宽3-8cm，先端急尖或渐尖，基部心形，箭簇形，两侧小叶基部呈不对称心形，浅裂，边缘生细刺毛，下面初无毛，后疏生单细胞短硬毛；顶生小叶基部裂片近圆形，均等，侧生小叶基部裂片不对称，内侧裂片较小，图形，外侧裂片较大，三角形，急尖。圆锥花序项生。挺直，花序轴及花梗通常无毛，有时被少数腺毛；花白色，直径约6mm，20-60朵花；花梗长约Icm；外轮萼片4，长圆状卵形，长3-4mm,宽1.5-2mm，带紫色，内轮萼片4，卵形或卵状三角形，长约4mm，宽约2mm，先端急尖，白色；花瓣与内萼片近等长，棕黄色，有短距；雄蕊4，长约5mm，花药辩裂，长约3mm。蓇葖果长约lcm,有喙。种子肾状长圆形，长约4mm，深褐色。花期2-3月，果期5-6月。"}]},{"ID":"20240611150939-7loq6vg","Type":"NodeParagraph","Properties":{"id":"20240611150939-7loq6vg","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3.．巫山淫羊藿 多年生常绿草本，高50-80cm。根茎结节状，质硬，表面被褐色鳞片，四周多须根。一回三出复叶，基生或茎生，具长柄；小叶3，小叶具柄。叶片革质，披针形至狭披针形，长9-23cm，宽1.8-4.5cm，先端渐尖或长渐尖，基部心形，边缘呈刺齿，顶生小叶基部具均等的圆形裂片，例生小叶基部的裂片偏斜，内侧裂片小，圆形，外侧裂片大，三角形，浙尖，下面被绵毛或秃净长茎具2枚对生叶。圆锥花序顶生，长15—30cm，偶达50cm，具多数花，花序轴无毛；花便疏被腺毛或无毛；花淡黄色，直径35cm；外萼片4，近圆形，长2-5mm，宽1.5-3mm，内萼片宽椭圆形，长3-15mm，宽1.5-8mm，先端钝；花瓣呈角状距，淡黄色，有时基部带紫色，长0．6-2mm；雄蕊长2—4mm；心皮斜圆柱状，有长花柱，含10-12颗胚珠。蓇葖果长约l．5cm。花期4-5月，果期6月。"}]},{"ID":"20240611150939-ks7p3c4","Type":"NodeParagraph","Properties":{"id":"20240611150939-ks7p3c4","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"4.朝鲜淫羊藿 多年生草本，高20-40cm。根茎横走，长而硬，生多数须根。茎直立，稍上升，有棱，基部包有2-3枚近国形鳞片。基生叶通常无，稀有1-2，与茎近等长；茎生叶为二回三出复叶，l枚，生于茎顶，有长柄，与茎连接处具关节；小叶9，小叶柄短于一回叶柄．小叶片卵形，花期长约5cm，宽约3cm，花后增大，长约10cm，宽约7cm，基部深心形，常歪斜，先端锐尖，边缘具制毛状微细锯齿，上面无毛，下面幼时被伏毛，其后毛渐脱落。总状花序比叶短，与茎叶对生于茎顶两侧，单一或由基部分歧，有长梗，具关节，无毛，基部具2枚小苞，顶生4—6朵花；小花梗长约Icm，花较大，直径2cm；萼片8，卵状技针形，长3-4mm，带淡紫色，外轮4片，较小，内轮4片，较大，长6-9mm；花瓣4．淡黄色或黄白色，近圆形，长7-8mm，先端尖；子房1室，花柱伸长，柱头头状。蓇葖果纺锤形，长约6mm（带花柱），2辩裂，小裂瓣脱落，大者宿存，内有6-8颗种子。花期4月下旬至5月中旬，果期5月。"}]},{"ID":"20240611150939-5ibp8ro","Type":"NodeParagraph","Properties":{"id":"20240611150939-5ibp8ro","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"5.柔毛淫羊藿 多年生草本，高动20-60cm。根茎短租，给节状，直径3-5mm。茎微具条棱，无毛或与叶柄相交接部有细柔毛。一回三出复叶，茎叶2片对生；小叶革质，卵形至披针形，长3-20cm宽2-8cm，先端短渐尖或渐尖，基部深或浅心形，裂片常圆形，边缘有刺齿，上面有光泽，下面密被灰色柔毛或卷柔毛，沿叶脉及叶柄处尤多。圆锥花序顶生或腋生，花序轴及花梗有腺毛；花白色，直径lcm；花梗长五1-2cm；外萼片4，宽卵形，长2—3mm，带紫色，内萼片披针形，长5-7mm，宽1.5-3.5mm，白色，有数脉；花瓣小，短于内萼，长约2mm，束状；雄蕊长4mm，花药长约2mm。蓇葖果长圆形，先端有长喙。花期4-5月，果期5-7月。"}]},{"ID":"20240611150939-t0tbjqu","Type":"NodeParagraph","Properties":{"id":"20240611150939-t0tbjqu","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611150939-n1udhtc","Type":"NodeParagraph","Properties":{"id":"20240611150939-n1udhtc","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 淫羊藿：拣净杂质，去梗，切丝，筛去碎屑。炙淫羊藿：先取羊脂油置锅内加热熔化，去渣，再加入淫羊藿微炒，至羊脂油基本吸尽，取出放凉。(每淫羊藿100斤，用炼成的羊脂油25斤)"}]},{"ID":"20240611150939-bbuzowx","Type":"NodeParagraph","Properties":{"id":"20240611150939-bbuzowx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611150939-4635d9o","Type":"NodeParagraph","Properties":{"id":"20240611150939-4635d9o","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 日本产淫羊藿能使蛙的瞳孔扩大，使小白鼠随意运动增加，反射机能亢进，往往发生轻度痉挛，遂至呼吸停止而死，心脏于呼吸停止后一定时间内持续搏动。淫羊藿浸膏小鼠腹腔注射半数致死量为36g／kg，No5-1-1小鼠静脉注射的半数致死量为56.8±2.7g／kg。本品甲醇提取物的毒性低，小鼠灌胃 450g/kg，连续观察3天,结果活动正常，无毒性反应。日本产淫羊活能使蛙的瞳孔扩大，小白鼠随意运动增加，反射机能亢进，往往发生轻度痉挛，遂至呼吸停止而死。"}]},{"ID":"20240611150939-wzp5ofp","Type":"NodeParagraph","Properties":{"id":"20240611150939-wzp5ofp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611150939-pgspaav","Type":"NodeParagraph","Properties":{"id":"20240611150939-pgspaav","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 1.淫羊藿地上部分含淫羊藿黄酮甙（icari－in），淫羊藿黄酮次甙（icariside）I，并含钾、钙等无机元素。"}]},{"ID":"20240611150939-bwx9snq","Type":"NodeParagraph","Properties":{"id":"20240611150939-bwx9snq","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2.箭叶淫羊藿全草含淫羊藿黄酮甙，皂式，苦味质，鞣质，挥发油，二十六醇（ceryl alcohol），三十烷（triacontane），植物甾醇（phytosterol），油酸（oleic acid），亚油酸（linoeic acid），软脂酸（Palmitic acid)槲皮素（quercetin）及槲皮素-3-O-β-D-葡萄糖甙（quercetin-3-O-β-D-glucoside），此外，含少量钾等无机元素，另有文献报道合淫羊藿黄酮次甙I，淫羊藿素-3-鼠李糖甙（icaritin－3－O-a-rhamnoside)，脱水淫羊藿素-3-鼠李糖甙（anhy－droicaritin-3-O-a-rhamnoside)，箭叶甙（sagittatoside）A、B、C，淫羊藿定（epimedin）A、B、c，箭叶亭甙(sagittatin)A、B；地上部分含淫羊藿甙（icariside）A1、B2、B6、B9、D3、E6、E7、H1，淫羊藿甙元B1（ icarisidinB1），淫羊藿醇（ icariol）A1、A2，赤式及苏式狄利格醇（dilignol)，5，5’二甲氧基秋利格醇（5，5'－dimethoxydilignol），赤式及苏式狄利格醇鼠李糖甙（dilignol rhamnosid），赤式 5’一甲氧基狄利格醇鼠李糖甙（5’－methoxydilignol rhamnoside），赤式及苏式的1，2一双一（4羟基一3一甲氧基苯基）一丙烷一l，3一二醇［l，2-bis-(4-hydroxy-3-methoxyphenyl)-propane-1,3-diol］,5一甲氧基-（－）-异落叶松脂醇〔5－methoxy-（－）-(solaritiresinol〕，异落叶松脂醇，5－甲氧基一9一木糖基-（-）-异落叶松脂醇，左旋-橄榄脂素（olivil），右旋－丁香树脂酚-葡萄糖甙（syringaresinol-O-β－D-glucopy-glucopy-ranoside），山矾脂素葡萄糖甙（symplocosigenin-O-β-D-glucopyra-noside），二氢去氢双松柏醇（ dihydrodehydrodiconiferylalcohol），苯乙醇基葡萄糖甙（Phenethyl glucoside），（Z）-己-3-烯醇葡萄糖甙［(z)-3-hexenyl glucoside］,布卢门醇 C葡萄糖甙（blumenolC gfu－coside）。"}]},{"ID":"20240611150939-5j6o94r","Type":"NodeParagraph","Properties":{"id":"20240611150939-5j6o94r","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3．巫山淫羊藿地上部分含淫羊藿黄酮甙及巫山淫羊藿黄酮甙（wushanicariin），宝藿甙（baohuoside） I、Ⅱ、VI，柔藿甙（rouhuoside），槲皮素-3-半乳糖甙，槲皮索-3-鼠李糖甙，淫羊藿属甙(epimedoside）A淫羊藿素，8-异戊烯基山柰酚-4’-甲氧基-3-〔木糖基（ l→4）鼠李糖甙］－7－葡萄糖甙｛8-prenylkaempferol-4'-methoxy-3-［xylosyl(1→4)rhamnoside］-7-glucoside｝此外尚含钙等无机元素。"}]},{"ID":"20240611150939-7u5rgj7","Type":"NodeParagraph","Properties":{"id":"20240611150939-7u5rgj7","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"4.朝鲜淫羊藿地上部分含淫羊藿黄酮甙及淫羊藿属甙A淫羊藿定 A、B、C，淫羊藿定A1、B1，槲皮素，脱水淫羊藿素-3-鼠李糖甙，朝鲜淫羊藿属甙（epimedokoreanodide)I、Ⅱ，从地下部分分得二十九烷（n-nonacosane），三十一烷（nhentriacotane），菜油甾醇（campesterol），β-谷甾醇（β-sitosterol），β-谷甾醇-3-葡萄糖甙，某油甾醇-3-葡萄糖甙，2”-鼠李糖意卡瑞忒 A（2”－Orhamnosylikarisoside A），2”-鼠李糖淫羊藿黄酮次甙Ⅱ，淫羊藿黄酮甙，淫羊属甙A，意卡瑞甙（ ikarisioside）A即宝藿甙（baohuoside）Ⅱ，此外尚含钙等无机元素。"}]},{"ID":"20240611150939-ews0gqt","Type":"NodeParagraph","Properties":{"id":"20240611150939-ews0gqt","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"5．柔毛淫羊藿地上部分含淫羊藿黄酮甙，淫羊藿黄酮次甙I，淫羊藿属甙C，藿甙Ⅱ、Ⅳ，金丝桃甙（hyperosde）及柔藿甙。此外尚含钙等无机元素。"}]},{"ID":"20240611150939-7y813sf","Type":"NodeParagraph","Properties":{"id":"20240611150939-7y813sf","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"此外，同属植物尖叶淫羊地上部分含钙等无机元素。湖南淫羊藿地上部分含钙等无机元素。宝兴淫羊藿全草含淫羊藿黄酮甙，淫羊藿属甙A、C，淫羊藿素，去甲淫羊藿素，宝霍甙Ⅰ、Ⅱ、Ⅲ、Ⅳ、Ⅴ、Ⅵ、Ⅷ，宝藿素（baohuosu），小麦黄素（tricin），山柰酚-3-双鼠李糖甙（kaemPfero－3-dirhamnoside)及金丝桃甙，此外尚含钙等无机元素。"}]},{"ID":"20240611150939-lud0cj5","Type":"NodeParagraph","Properties":{"id":"20240611150939-lud0cj5","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611150939-l3jgvjo","Type":"NodeParagraph","Properties":{"id":"20240611150939-l3jgvjo","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 1.对性功能的影响：本品促进性功能是由于精液分泌亢进，精囊充满后，刺激感觉神经，间接兴奋性欲而引起。犬灌胃淫羊藿水浸膏，虽不能引起举尾反应，但可促进精液的分泌，以叶及根部的作用最强，果实次之，茎最弱。小鼠前列腺、精囊、提肛肌的重量增加法实验证明，淫羊藿提取物20-40mg注射后产生的效果与7.5μg 睾丸素相当。慢性气管炎患者用淫羊藿后，尿中17－酮类固醇24小时排泄量平均值明显回升，甚至超过健康人的水平，而尿17－羟皮质类固醇24小时排泄量未见明显改善。提示淫羊藿具有一定的促进性腺功能的作用。"}]},{"ID":"20240611150939-i6guzh0","Type":"NodeParagraph","Properties":{"id":"20240611150939-i6guzh0","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2.镇咳、祛痰、平喘作用：小鼠酚红排泌法证明本品鲜品粗提物和干品的乙酸乙酯提取物均有一定的祛痰作用。小鼠二氧化硫引咳法证明，其甲醇和乙酸乙酯提取物均有镇咳作用。前者还可以完全抑制用电刺激猫喉上神经引起的咳嗽，表明其作用是中枢性的，甲醇提取物对豚鼠组胺性哮喘也有保护作用。"}]},{"ID":"20240611150939-8nt6v5e","Type":"NodeParagraph","Properties":{"id":"20240611150939-8nt6v5e","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3.抗病原微生物作用：本品对白色葡萄球菌、金黄色葡萄球菌有较显着的抑制作用，对奈氏卡他球菌、肺炎双球菌、流感嗜血杆菌有轻度抑制作用，其1%浓度在试管内可抑制结核杆菌的生长。淫羊藿对脊髓灰质炎病毒、柯萨奇病毒A9、B4、B5型及ECHO病毒6、9型等均有抑制作用，其作用可能是对病毒的直接灭活。"}]},{"ID":"20240611150939-g08kewx","Type":"NodeParagraph","Properties":{"id":"20240611150939-g08kewx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"4.对心血管系统的作用：4.1．降压作用：本品煎剂及乙醇浸出液给兔（2.5ml／kg）、猫（2ml／kg）及大鼠（4ml／kg）静脉注射,均呈降压作用，其中以对兔的作用最为明显。肾型高血压在鼠灌胃本品甲醇提取物10g／kg，可出现明显的血压下降，停药后血压回升。急性血压试验观察到，淫羊藿可抑制阻断兔双侧颈总动脉引起的加压反射，但不能阻断去甲肾上腺素的升压作用，猫注射阿托品后，本品仍有降压作用，强度无明显减弱，但可明显抑制电刺激猫交感神经节前纤维所致瞬膜收缩反应，而对电刺激节后纤维的反应无明显抑制作用。因此认为淫羊藿的降压作用与肾上腺素能a受体及M-胆碱系统无关，主要与交感神经节阻断有关。"}]},{"ID":"20240611150939-dasm5u8","Type":"NodeParagraph","Properties":{"id":"20240611150939-dasm5u8","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"4.2．对心脏的作用：离体兔心灌流实验证明，淫羊藿醇浸出液及从200%淫羊藿水浸膏片中提取的非氨基酸部分（No5-1-1）能显着增加离体兔心的冠脉流量，后者平均比给药前增加75.3%。离体豚鼠心脏灌流200%淫羊藿煎剂0.5ml，可使冠脉流量平均增加126.6%。麻醉犬静脉注射No5-1-1 1g／kg后对心率无明显影响，但冠脉流量明显增加，同时较显着地减少冠脉阻力。麻醉兔静脉注射No5-1-1后，表现出一过性的降低左心舒张压的作用，并有短暂降低左心舒缩压力差的作用，但作用较弱。No5-1-1对垂体后叶素所致大鼠急性心肌缺血亦有保护作用，对毒毛旋花子甙K及肾上腺素产生的实验性心律不齐，虽然不能完全对抗，但可明显缩短其持续时间。用华勃呼吸器法测定大鼠心肌匀浆耗氧量证明，No5-1-1 制剂2mg，在l小时内能明显增加心肌耗氧量。"}]},{"ID":"20240611150939-wafqflw","Type":"NodeParagraph","Properties":{"id":"20240611150939-wafqflw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"5.对小鼠常压耐受缺氧的影响：小鼠 腹腔注射 100%淫羊藿煎剂0.1-0.15ml，对小鼠缺氧致死有一定的保护作用。"}]},{"ID":"20240611150939-2ply9hz","Type":"NodeParagraph","Properties":{"id":"20240611150939-2ply9hz","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"6.对血脂的影响：给实验性高脂血症家兔 灌胃 100%淫羊藿煎剂，每次5ml，2次／天,共30天，给药后10、20、30天，B-脂蛋白及胆固醇下降，甘油三酯只在给药后10天下降，20、30天后稍上升。"}]},{"ID":"20240611150939-8ryvsr7","Type":"NodeParagraph","Properties":{"id":"20240611150939-8ryvsr7","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"7.对血糖的影响：实验性高血糖大鼠灌胃淫羊藿提取液10mg／kg，有明显降血糖作用，可持续60分钟以上。"}]},{"ID":"20240611150939-ghixzre","Type":"NodeParagraph","Properties":{"id":"20240611150939-ghixzre","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"8.抗炎作用：大鼠皮下注射淫羊藿甲醇提取物50mg／kg，能明显减轻蛋清性脚肿胀程度，兔灌胃 15g／kg，能降低组织胺所致毛细血管通透性增加。"}]},{"ID":"20240611150939-gxu5pjx","Type":"NodeParagraph","Properties":{"id":"20240611150939-gxu5pjx","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"9.对免疫功能的影响：淫羊藿总黄酮可使阳虚小鼠抗体形成细胞功能及抗体滴度趋于恢复，显着促进阳虚小鼠淋巴细胞刺激指数，使之接近正常动物。淫羊藿总黄酮还能提高小鼠血清溶血素抗体水平，增加脾脏抗体生成细胞数，促进PHA刺激的淋巴细胞转化反应，增强腹腔巨噬细胞的吞噬功能。而柔毛淫羊藿50%甲醇提取液在体外可强烈抑制小鼠淋巴细胞对ConA、LPS的增殖反应和小鼠混合淋巴细胞反应，其抑制率与药物浓度呈正相关；体内试验，给小鼠灌胃则可部分延长同种异体新生鼠心脏移植物的存活期。"}]},{"ID":"20240611150939-ola1ouy","Type":"NodeParagraph","Properties":{"id":"20240611150939-ola1ouy","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"10.对血小板聚集性和血液流变学的影响：淫羊藿煎剂、多糖和总黄酮均可促进正常大鼠经ADP诱导的血小板聚集，其作用强度为多糖＞煎剂＞总黄酮，三者本身无诱导血小板聚集作用。但淫羊藿煎剂却明显降低ADP 诱导的健康人血小板聚集率，并可促进部分受试者血小板解聚。健康人口服淫羊藿煎剂后，红血球压积明显减少，红细胞电泳时间缩短，血沉加快，从而使全血比粘度明显降低。"}]},{"ID":"20240611150939-dqriyfp","Type":"NodeParagraph","Properties":{"id":"20240611150939-dqriyfp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"11.对核酸代谢的影响：给羟基脲所致阳虚小鼠灌胃淫羊藿水煎液，可显着提高其DNA合成率。淫羊藿多糖体外试验，可使羟基豚所致阳虚小鼠的骨髓细胞增殖率提高72%，DNA合成率提高68%。"}]},{"ID":"20240611150939-2v9x6hr","Type":"NodeParagraph","Properties":{"id":"20240611150939-2v9x6hr","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"12.其它作用：淫羊藿醇提物对儿茶酚胺类有拮抗作用，其作用与心得安相似。小鼠腹腔注射10%淫羊藿煎剂20ml／kg，有明显的镇静作用。淫羊活可调节M受体cGMP系统，其炮制品亦能明显提高性机能，并增加附性器官重量，提高血浆睾酮含量。另有抗衰老作用。"}]},{"ID":"20240611150939-rrhydhs","Type":"NodeParagraph","Properties":{"id":"20240611150939-rrhydhs","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611150939-au64otw","Type":"NodeParagraph","Properties":{"id":"20240611150939-au64otw","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 1.取粉末1g，加乙醇20ml，热回流1小时，滤液浓缩至5ml。取1ml于试管中，加镁粉少话，摇匀，加浓盐酸数滴，水浴加热1-2分钟，显红色，（检查黄酮）2.薄层层析：取粉末0.5g，加乙醇10ml，温浸30分钟，滤过，滤液蒸干，加乙醇1ml溶解，供试；另取淫羊藿甙乙醇溶液作对照。取上述溶液各1μl，点样在硅胶H-CMC(0.5%)江层板上以醋酸乙酯-丁酮-甲酸-水(10:1:1:1)展开15cm，取出晾干，在紫外灯(365nm)下检视，对照品显一暗红色斑点，喷雾1%三氯化铝乙醇溶液，在紫外灯下检视，显橙红色。"}]},{"ID":"20240611150939-yrhh1te","Type":"NodeParagraph","Properties":{"id":"20240611150939-yrhh1te","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611150939-5m32f0c","Type":"NodeParagraph","Properties":{"id":"20240611150939-5m32f0c","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240611150939-9sef8eq","Type":"NodeParagraph","Properties":{"id":"20240611150939-9sef8eq","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611150939-atzia8t","Type":"NodeParagraph","Properties":{"id":"20240611150939-atzia8t","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 味辛；甘；性温"}]},{"ID":"20240611150939-dh1y275","Type":"NodeParagraph","Properties":{"id":"20240611150939-dh1y275","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611150939-mm0w0om","Type":"NodeParagraph","Properties":{"id":"20240611150939-mm0w0om","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 阴虚而相火易动者禁服。"}]},{"ID":"20240611150939-fllgla4","Type":"NodeParagraph","Properties":{"id":"20240611150939-fllgla4","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611150939-pr7i3od","Type":"NodeParagraph","Properties":{"id":"20240611150939-pr7i3od","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 补肾壮阳；祛风除湿；强筋键骨。主阳痿遗精；虚冷不育；尿频失楚；肾虚喘咳；腰膝酸软；风湿痹痛；半身不遂；四肢不仁"}]},{"ID":"20240611150939-byqgqco","Type":"NodeParagraph","Properties":{"id":"20240611150939-byqgqco","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611150939-xj12wq6","Type":"NodeParagraph","Properties":{"id":"20240611150939-xj12wq6","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" ①治偏风，手足不遂，皮肤不仁：仙灵脾一斤；细锉，以生绢袋盛，于不津器中，用无灰酒二斗浸之，以厚纸重重密封，不得通气，春夏三日，秋冬五日。每日随性暖饮之，常令醺醺，不得大醉。(《圣惠方》)②治风走注疼痛，来往不定：仙灵脾一两，威灵仙一两，芎藭—两，桂心一两；苍耳子一两。上药，捣细罗为散。每服，不计时候，以温酒调下一钱。(《圣惠方》仙灵脾散)③治目昏生翳：仙灵脾、生王瓜(即小栝楼红色者)等分。为末，每服一钱，茶下，日二服。(《圣济总录》)④治牙疼：仙灵脾，不拘多少，为粗末，煎汤漱牙齿。(《奇效良方》固牙散)"}]},{"ID":"20240611150939-vppdxp5","Type":"NodeParagraph","Properties":{"id":"20240611150939-vppdxp5","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611150939-5meebgq","Type":"NodeParagraph","Properties":{"id":"20240611150939-5meebgq","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 1.治疗小儿麻痹症：取淫羊藿、桑寄生等量，制成每2ml含生药各 1g的注射液。急性期以肌肉注射为主，配合穴位注射。肌肉注射每次2ml，每日2次，连续20天。恢复期及后遗症期以穴位注射为主，配合肌肉注射。穴位注射按常规取穴，每穴注射1-2ml，隔日1次，连续20天，休息半月再继续治疗。治疗各期小儿麻痹症共246例，其中急性期患者34例，痊愈8例，基本痊愈16例，显着有效7例，有效2例，无效1例；恢复期患者43例，痊愈21例，有效15例，进步5例，无效2例；后遗症期患者共169例，痊愈及基本痊愈9例，显着有效及有效129例，无效31例。据观察，本品对急性期及刚进入恢复期的病例疗效显着，恢复较快。对后遗症期也有一定效果，用药后患肢普遍有发热、有劲等感觉，有效病例可见肌肉逐渐恢复，患肢增粗；其中以一下肢麻痹者疗效较好，上肢麻痹及年龄较大者疗效较差。用药后除有口干现象外，未见其它副作用。"}]},{"ID":"20240611150939-q1hzlz4","Type":"NodeParagraph","Properties":{"id":"20240611150939-q1hzlz4","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2．治疗神经衰弱：2．1．用3%淫羊藿煎液游子透入法，每日1次，10-20次为一疗程。少数患者另服镇静剂。观察104例，痊愈22例，显着进步21例，进步46例，无效15例。疗程长者疗效较好；治疗后症状开始好转愈早，疗效愈好，而治疗15次病情仍无好转者，即使继续治疗，疗效亦不显着，且不巩固。少数病例治疗初期可出现轻度反应或症状暂时加重，但继续治疗即迅速消失。"}]},{"ID":"20240611150939-nxqg8qp","Type":"NodeParagraph","Properties":{"id":"20240611150939-nxqg8qp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2．2．用20%淫羊藿酊每次5ml，每日3次饭前服，连续2-3月。治疗50例，约有80%患者治后症状消除或减轻。服药期间未见不良反应，但不适用于兴奋过程占优势或性欲亢进，及高血压患者。"}]},{"ID":"20240611150939-te0voyp","Type":"NodeParagraph","Properties":{"id":"20240611150939-te0voyp","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3．治疗慢性气管炎：以单味淫羊藿丸观察1000余例，一疗程的有效率为74.6%，近期控制和显效率为22.1%。如配合矮地茶等组成复方治疗，疗效有所提高。实践证明，单纯型的疗效优于喘息型，年龄大者疗效较差，但病程长短与疗效无明显关系；祛痰、镇咳作用较好，平喘较差；经治两个疗程者比一个疗程的近期控制和显效率有显着提高。观察中曾对经治一疗程的110例进行随访，结果半年后的有效率为59.1%，较原来疗效下降26.1%。制剂及用法：取淫羊藿茎、叶(干品)，以其总量的80%煎取浓汁，20%研粉，两者混合为丸。每日量相当于生药1两，两次分服。治疗中曾以相当于生药5钱和1.5两的剂量(一日量)，分别对部分病例进行观察，结果疗效与日服1两者均基本相似。服药后部分病例有轻微反应，以口干、恶心为多见，其次为腹胀、头晕，一般可自行消失。"}]},{"ID":"20240611150939-f7tpk9t","Type":"NodeParagraph","Properties":{"id":"20240611150939-f7tpk9t","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611150939-1m87jf3","Type":"NodeParagraph","Properties":{"id":"20240611150939-1m87jf3","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：淫羊藿，性温不寒，能益精气，真阳不足者宜之。"}]},{"ID":"20240611150939-lgiykv9","Type":"NodeParagraph","Properties":{"id":"20240611150939-lgiykv9","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：淫羊藿，其气温而无毒。《本经》言寒者，误也。辛以润肾，甘温益阳气，故主阴痿绝阳，益气力，强志。茎中痛者，肝肾虚也，补益二经，痛自止矣。膀胱者，州都之官，津液藏焉，气化则能出矣，辛以润其燥，甘温益阳气以助其化，故利小便也。肝主筋，肾主骨，益肾肝则筋骨自坚矣。辛能散结，甘能缓中，温能通气行血，故主瘰疬赤痈，及下部有疮，洗出虫。"}]},{"ID":"20240611150939-smfrubd","Type":"NodeParagraph","Properties":{"id":"20240611150939-smfrubd","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"3.《本草述》：淫羊藿，《本经》首主阴痿绝伤，《日华子》亦首言其疗男子绝阳，女子绝阴，则谓入命门、补真阳者是也。盖命门为肾中之真阳，即人身之元气也 ，其所谓绝阳绝阴，不本之元气，何以嘘之于既槁。所谓益气力；强志，并治冷气劳气，筋骨挛急等证，皆其助元气之故。至若茎中痛，小便不利，皆肝肾气虚所致，此味入肾而助元阳，即是补肾气，而肝肾固同士治也。老人昏耄，中年健忘，皆元阳衰败而不能上升者也。以是思功，功可知矣。须知此味以降为升，其升由于能降也。"}]},{"ID":"20240611150939-5021ahb","Type":"NodeParagraph","Properties":{"id":"20240611150939-5021ahb","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：淫羊藿，禀性辛温，专壮肾阳，故主阴痿，曰绝伤者，即阳事之绝伤也。茎中痛，亦肾脏之虚寒。利小便者，指老人及虚寒人之阳事不振，小便滴沥者言之，得其补助肾阳而小便自利，非湿热蕴结，水道赤涩者可比，读书慎勿误会。益气力、强志、坚筋骨，皆元阳振作之功，然虚寒者固其所宜，而阴精不充，真阳不固者，万不可为握苗之助长也。消瘰疬、赤痈，盖亦因其温通气血，故能消化凝结。然疬疡之病，由于阴血不充，肝阳燔灼，而煎熬津液，凝结痰浊者为多，幸勿误读古书，反以助其烈焰。洗下部之疮，则辛燥能除湿热，亦犹蛇床子洗疮杀虫耳。《日华》主丈夫绝阳，女子绝阴，一切冷风劳气，筋骨挛急，四肢不仁，补腰膝，则辛温之品，固不独益肾壮阳，并能通行经络，祛除寒湿痹。但《日华》又谓治老人昏耄，中年健忘，则未免誉之太过。而景岳且谓男子阳衰，女子阴衰之艰于子嗣者，皆宜服之，则偏信温补，其弊滋多，更非中正之道矣。石顽谓一味仙灵脾酒，为偏风不遂要药，按不遂之病有二因：一为气血俱虚，不能荣养经络，或风寒湿热痹着之病，古人之所谓痹症是也，其来也缓；一为气血上冲，扰乱脑神经而忽失其运动之病，今之所谓中风，西医之所谓脑经病是也，其病也暴。仙灵脾酒，止可治寒湿痹之不遂，并不能治气血两虚之不遂，而血冲脑经之不遂，更万万不可误用。"}]},{"ID":"20240611150939-v9kmhbh","Type":"NodeParagraph","Properties":{"id":"20240611150939-v9kmhbh","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611150939-fc5qarr","Type":"NodeParagraph","Properties":{"id":"20240611150939-fc5qarr","updated":"20240611150939"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611150941-3i78znf","Type":"NodeThematicBreak","Properties":{"id":"20240611150941-3i78znf"}},{"ID":"20240611150942-8mjwvw2","Type":"NodeParagraph","Properties":{"id":"20240611150942-8mjwvw2"}}]}