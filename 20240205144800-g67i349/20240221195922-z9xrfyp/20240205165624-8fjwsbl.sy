{"ID":"20240205165624-8fjwsbl","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205165624-8fjwsbl","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205165624-8fjwsbl\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206093222-ed3yzof\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607123641-ofhn9bu\u0026quot;,\u0026quot;scrollTop\u0026quot;:2000,\u0026quot;focusId\u0026quot;:\u0026quot;20240619125449-yfcqb3v\u0026quot;,\u0026quot;focusStart\u0026quot;:17,\u0026quot;focusEnd\u0026quot;:17\u0026#125;","title":"063续断（和尚头）","type":"doc","updated":"20240807110812"},"Children":[{"ID":"20240206093222-ed3yzof","Type":"NodeParagraph","Properties":{"id":"20240206093222-ed3yzof","updated":"20240206093226"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产云贵地区和湖北等地。\n【性状】\t根长圆柱形，略扁，微弯曲，长515cm，直径0.52cm。表面棕褐色或灰褐色，有多数明显而扭曲的纵皱纹及沟纹，并多数明显而扭曲的纵皱纹及沟纹，并可见横长皮孔及少数须根痕。质稍软，久置干燥后变硬。易折断，断面不平坦，皮部绿褐色或淡褐色，木部黄褐色，常呈放射状花纹。气微香，味苦，微甜而后涩。\n【性味】\t苦、辛，微温。\n【功效】\t补肝肾；强筋骨；调血脉；续折伤；止崩漏。用于腰背酸痛；肢节痿痹；跌扑创伤、损筋折骨、胎动漏红、血崩、遗精、带下、痈疽疮肿。酒续断多用于风湿痹痛，跌扑损伤。盐续断多用于腰膝酸软。"}]},{"ID":"20240206093217-mdoywq4","Type":"NodeParagraph","Properties":{"id":"20240206093217-mdoywq4","updated":"20240206093217"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206093217-sr2xfcg.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205170124-yk1wu5s","Type":"NodeParagraph","Properties":{"id":"20240205170124-yk1wu5s","updated":"20240205170124"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断-20240205170124-wousli8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807101222-4ta7m43","Type":"NodeParagraph","Properties":{"id":"20240807101222-4ta7m43","updated":"20240807101227"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川续断"}]},{"ID":"20240619125145-fbzut6x","Type":"NodeParagraph","Properties":{"id":"20240619125145-fbzut6x","updated":"20240807102952"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 280px;","style":"width: 270px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断 6-20240807102952-iazzkzp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 270px;\" parent-style=\"width: 280px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 482px;","style":"width: 472px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断-20240807101358-b3yxgeh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 472px;\" parent-style=\"width: 482px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 316px;","style":"width: 306px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断5-20240619125930-d9j0oqe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 306px;\" parent-style=\"width: 316px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807102257-yczzh34","Type":"NodeParagraph","Properties":{"id":"20240807102257-yczzh34