eText","Data":"​​​​"}]},{"ID":"20240807110536-n29hw7r","Type":"NodeParagraph","Properties":{"id":"20240807110536-n29hw7r","updated":"20240807110708"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 490px;","style":"width: 480px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断 20-20240807110536-hcdzlsb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 480px;\" parent-style=\"width: 490px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断 7-20240807103457-lkfrvqw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 393px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807110715-0kjfgp2","Type":"NodeParagraph","Properties":{"id":"20240807110715-0kjfgp2","updated":"20240807110715"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 894px;","style":"width: 884px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"续断7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/续断7-20240619130345-evcu4by.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 884px;\" parent-style=\"width: 894px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807103106-t56rmwy","Type":"NodeParagraph","Properties":{"id":"20240807103106-t56rmwy","updated":"20240807103136"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：川续断长在偏阳的地方，杆多为绿色，长在阴暗的地方杆则偏紫色；"}]},{"ID":"20240607123639-0i4uwti","Type":"NodeThematicBreak","Properties":{"id":"20240607123639-0i4uwti"}},{"ID":"20240616134849-1bwh87j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134849-1bwh87j","updated":"20240616134853"},"Children":[{"Type":"NodeText","Data":"续断《神农本草经》"}]},{"ID":"20240616134849-137qlp4","Type":"NodeParagraph","Properties":{"id":"20240616134849-137qlp4","updated":"20240616134849"},"Children":[{"Type":"NodeText","Data":"味苦微温。"}]},{"ID":"20240616134849-xs1x9a5","Type":"NodeParagraph","Properties":{"id":"20240616134849-xs1x9a5","updated":"20240616134849"},"Children":[{"Type":"NodeText","Data":"主伤寒，补不足，金创痈伤，折跌，续筋骨，妇人乳难（《御览》作乳痈云崩中，漏血，《大观本》，作黑字）。久服益气力。一名龙豆，一名属折。生山谷。"}]},{"ID":"20240616134849-iqaqb1y","Type":"NodeParagraph","Properties":{"id":"20240616134849-iqaqb1y","updated":"20240616134849"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名接骨，一名南草，一名槐，生常山，七月八月采，阴干。"}]},{"ID":"20240616134849-o8jkew4","Type":"NodeParagraph","Properties":{"id":"20240616134849-o8jkew4","updated":"20240616134849"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：褱，续断也；《范子计然》云：续断，出三辅：桐君药录云：续断生蔓延，叶细，茎如荏大，根本黄白有汁，七月八月采根。"}]},{"ID":"20240616134859-4d2r860","Type":"NodeThematicBreak","Properties":{"id":"20240616134859-4d2r860"}},{"ID":"20240616134900-mrbptgw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134900-mrbptgw","updated":"20240616134907"},"Children":[{"Type":"NodeText","Data":"续断《名医别录》"}]},{"ID":"20240616134900-n5mq02c","Type":"NodeParagraph","Properties":{"id":"20240616134900-n5mq02c","updated":"20240616134900"},"Children":[{"Type":"NodeText","Data":"味辛，无毒．主治崩中漏血，金疮血内漏，止痛，生肌肉，及 伤、恶血、腰痛，关节缓急．一名接骨，一名南草，一名槐．生常山．七月、八月采，阴干．（地黄为之使，恶雷丸．）"}]},{"ID":"20240616134900-jdpif3j","Type":"NodeParagraph","Properties":{"id":"20240616134900-jdpif3j","updated":"20240616134922"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶续断，味苦，微温．主伤寒，补不足，金创痈伤折跌，续筋骨，妇人乳难．久服益气力。一名龙豆，一名属折。生山谷。"}]},{"ID":"20240616135017-nbkbehq","Type":"NodeThematicBreak","Properties":{"id":"20240616135017-nbkbehq"}},{"ID":"20240616135017-64xs36i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135017-64xs36i","updated":"20240616135021"},"Children":[{"Type":"NodeText","Data":"续断《本草求真》"}]},{"ID":"20240616135017-hyr878z","Type":"NodeParagraph","Properties":{"id":"20240616135017-hyr878z","updated":"20240616135017"},"Children":[{"Type":"NodeText","Data":"（隰草）补肝以散筋骨血气凝滞"}]},{"ID":"20240616135017-lng6bjy","Type":"NodeParagraph","Properties":{"id":"20240616135017-lng6bjy","updated":"20240616135017"},"Children":[{"Type":"NodeText","Data":"续断（专入肝肾）。因何以续为名。盖缘其味苦。其性温。能入肾经以补骨。又缘其味辛．能入肝经以补筋。（辛能散风。风除而筋活。）味兼甘。又入中州以补虚。（甘味不多。补不甚专。）凡跌扑折伤痈肿。暨筋骨曲节血气滞之处。服此即能消散。（续断力实消散。）止痛生肌。且审其味涩。故能止血治漏。并缩小便固精安胎。（下部血分寒滞者宜此。）久服能气力倍增。（血气不滞。）筋断复续。故曰续断。实疏通（疏通二字贴切。）气血筋骨第一药也。第因气薄而见精脱胎动溺血失血等症。则又深忌。以性下流者故耳。功与地黄牛膝杜仲巴戟相等。但有温补细微之别。不可不知。川产者良。状如鸡脚皮黄皱节节断者真。去里硬筋酒浸用。地黄为使。（每见今人气虚血脱。医用牛膝补骨脂杜仲续断安胎。殊属可骇。）"}]},{"ID":"20240616135007-6hkxsx0","Type":"NodeThematicBreak","Properties":{"id":"20240616135007-6hkxsx0"}},{"ID":"20240616135008-0hd7515","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135008-0hd7515","updated":"20240616135012"},"Children":[{"Type":"NodeText","Data":"续断《本草纲目》"}]},{"ID":"20240616135008-zko4pxw","Type":"NodeParagraph","Properties":{"id":"20240616135008-zko4pxw","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"「释名」亦名属折、接骨、龙豆、南草。"}]},{"ID":"20240616135008-nvr7uf9","Type":"NodeParagraph","Properties":{"id":"20240616135008-nvr7uf9","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、微温、无毒。"}]},{"ID":"20240616135008-65mttj6","Type":"NodeParagraph","Properties":{"id":"20240616135008-65mttj6","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616135008-tqwxwdd","Type":"NodeParagraph","Properties":{"id":"20240616135008-tqwxwdd","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"刀伤、痈疡、折跌、能续筋骨。亦治妇女崩中漏血，破症结瘀血。"}]},{"ID":"20240616135008-zdywjwh","Type":"NodeParagraph","Properties":{"id":"20240616135008-zdywjwh","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"1、妊娠胎动。用川续断（酒浸）、杜仲（姜汁炒，去丝）各二两，等分为末，加煮烂了的枣肉，和成丸子，如梧子大。每服三十丸，米汤送下。"}]},{"ID":"20240616135008-k4br8j4","Type":"NodeParagraph","Properties":{"id":"20240616135008-k4br8j4","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"2、产后诸疾（血晕、心闷、烦热、气接不上、心头硬、乍寒乍热等）。用续断皮一把，加水三升煎成二升，分三次服。"}]},{"ID":"20240616135008-kzlq5rc","Type":"NodeParagraph","Properties":{"id":"20240616135008-kzlq5rc","updated":"20240616135008"},"Children":[{"Type":"NodeText","Data":"3、打伤，闪了骨节。加续断叶捣烂敷伤处。"}]},{"ID":"20240616134957-e5pf3lk","Type":"NodeThematicBreak","Properties":{"id":"20240616134957-e5pf3lk"}},{"ID":"20240616134958-i6ywqnb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134958-i6ywqnb","updated":"20240616135001"},"Children":[{"Type":"NodeText","Data":"续断《本草经解》"}]},{"ID":"20240616134958-8r1es09","Type":"NodeParagraph","Properties":{"id":"20240616134958-8r1es09","updated":"20240616134958"},"Children":[{"Type":"NodeText","Data":"气微温．味苦．无毒．主伤中．补不足．金疮痈疡折跌续筋骨．妇人乳难．久服益气力．（酒炒用）"}]},{"ID":"20240616134958-odqsrul","Type":"NodeParagraph","Properties":{"id":"20240616134958-odqsrul","updated":"20240616134958"},"Children":[{"Type":"NodeText","Data":"续断气微温．禀天春升之木气．入足厥阴肝经．味苦无毒．得地南方之火味．入手少阴心经．气升味降．阳也．肝藏血．心主血．血者营也．中之守也．血虚则中伤．续断气微温入肝．肝者阳中之少阳．以生气血者也．所以主伤中．补不足者．补肝经之不足也．金疮痈疡．皆伤血之症．气温益血．味苦清心．所以主之．折跌续筋骨者．气微温能活血．血活则断者续也．女人血不足则乳难．气温行血．血充乳自多也．肝者罢极之本．以生血气之脏也．气微温．达少阳之气．所以益气力也．"}]},{"ID":"20240616134958-u7n9bku","Type":"NodeParagraph","Properties":{"id":"20240616134958-u7n9bku","updated":"20240616134958"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616134958-sny3t2t","Type":"NodeParagraph","Properties":{"id":"20240616134958-sny3t2t","updated":"20240616134958"},"Children":[{"Type":"NodeText","Data":"续断一味．治产后诸症．同杜仲、枣肉丸．治胎不安．同北味、木瓜、炮姜、牛膝、丹皮、生地．治产后火升．"}]},{"ID":"20240616134929-d7u6065","Type":"NodeThematicBreak","Properties":{"id":"20240616134929-d7u6065"}},{"ID":"20240616134930-nf7stce","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134930-nf7stce","updated":"20240616134935"},"Children":[{"Type":"NodeText","Data":"续断《医学入门》"}]},{"ID":"20240616134930-inh25jn","Type":"NodeParagraph","Properties":{"id":"20240616134930-inh25jn","updated":"20240616134930"},"Children":[{"Type":"NodeText","Data":"续断苦辛温壮阳．止精能令腰脚强，止血调经安胎产，破瘀消痈疗折伤。"}]},{"ID":"20240616134930-rwoirr3","Type":"NodeParagraph","Properties":{"id":"20240616134930-rwoirr3","updated":"20240616134930"},"Children":[{"Type":"NodeText","Data":"无毒。主劳伤不足，益气力，兴阳道，止泄精，缩小便。治腰疼脚软，关节缓急，与桑寄生同功。止血，妇人崩漏带下，尿血为最。又能宣通经脉，胎前胎动漏血，产后血晕，寒热难禁，恹恹气欲绝，单煎一两，温服，即验。一切面黄虚肿、 结，子宫冷症皆治。破瘀血，消疮肿痈毒、乳痈瘰 ，折伤扑损、金疮，乃所主也。盖因能止痛生肌续筋骨，故名曰续断。出川中，皮黄皱，节节断有烟尘起者佳。酒浸焙。地黄为使。恶雷丸。"}]},{"ID":"20240616134944-50qeqdw","Type":"NodeThematicBreak","Properties":{"id":"20240616134944-50qeqdw"}},{"ID":"20240616134945-f8s8liy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134945-f8s8liy","updated":"20240616134949"},"Children":[{"Type":"NodeText","Data":"续断《本草经集注》"}]},{"ID":"20240616134945-z59wm66","Type":"NodeParagraph","Properties":{"id":"20240616134945-z59wm66","updated":"20240616134945"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微温，无毒。主治伤寒，补不足，金疮，痈伤，折跌，续筋骨，妇人乳难，崩中漏血，金疮血内漏，止痛，生肌肉，及 伤，恶血，腰痛，关节缓急。久服益气力。一名龙豆，一名属折，一名接骨，一名南草，一名槐。生常山山谷。七月、八月采，阴干。（地黄为之使，恶雷丸。）"}]},{"ID":"20240616134945-bdgdv9u","Type":"NodeParagraph","Properties":{"id":"20240616134945-bdgdv9u","updated":"20240616134945"},"Children":[{"Type":"NodeText","Data":"案《桐君药录》云∶续断生蔓延，叶细，茎如荏，大根本，黄白有汁，七月、八月采根，今?"}]},{"ID":"20240616134945-y1nrhtx","Type":"NodeParagraph","Properties":{"id":"20240616134945-y1nrhtx","updated":"20240616134945"},"Children":[{"Type":"NodeText","Data":"高丈余许，叶似蒴 ，皮主治金疮，有此接骨名，疑或者。而广州又有一藤名续断，一名诺藤，断其茎，器承其汁饮之，治虚损绝伤，用沐头，又长发。折枝插地即生，恐此又相类。"}]},{"ID":"20240616134945-gwz5kjj","Type":"NodeParagraph","Properties":{"id":"20240616134945-gwz5kjj","updated":"20240616134945"},"Children":[{"Type":"NodeText","Data":"李云是虎蓟，与此大乖，而虎蓟亦自治血尔。"}]},{"ID":"20240616134912-hrtqz8s","Type":"NodeThematicBreak","Properties":{"id":"20240616134912-hrtqz8s"}},{"ID":"20240616134913-byfqzup","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134913-byfqzup","updated":"20240616134918"},"Children":[{"Type":"NodeText","Data":"续断《本草新编》"}]},{"ID":"20240616134913-lzfcmqs","Type":"NodeParagraph","Properties":{"id":"20240616134913-lzfcmqs","updated":"20240616134913"},"Children":[{"Type":"NodeText","Data":"续断，味辛，气微温。无毒。善续筋骨，使断者复续得名。亦调血脉，疗折伤最神，治血症固精滑梦遗，暖子宫，补多于续，但不可多用耳。盖续断气温，多用则生热，热生则火炽矣。少用则温而不热，肾水反得之而渐生。阴生于阳之中也。他本谓其能愈乳痈、瘰 、肠风痔，岂有气温之药，而能愈温热之病乎？恐非可信之论也。（〔批〕实不可信。）"}]},{"ID":"20240616134913-dokuv18","Type":"NodeParagraph","Properties":{"id":"20240616134913-dokuv18","updated":"20240616134913"},"Children":[{"Type":"NodeText","Data":"或问续断能接筋骨，何以单用续断，未见奏功，入之于生血活血药中，反能奏效，何欤？"}]},{"ID":"20240616134913-ac112vc","Type":"NodeParagraph","Properties":{"id":"20240616134913-ac112vc","updated":"20240616134913"},"Children":[{"Type":"NodeText","Data":"曰∶此正续断之奇也。夫断者不能复续，犹死者不能重生也，欲使断者复续，必须使死者重生矣。筋骨至于断，其中之血先死矣。续断止能接筋骨之断，不能使血之生也。用之于生血、活血之中，则血之死者既庆再生，而筋骨之断者自庆再续。（〔批〕活血始可接骨，补虚始能续断，真不易之论。）又何疑于单用之无功，而共用之甚效哉。"}]},{"ID":"20240616134913-yyf1tk6","Type":"NodeParagraph","Properties":{"id":"20240616134913-yyf1tk6","updated":"20240616134913"},"Children":[{"Type":"NodeText","Data":"或疑续断不宜用之于补药之中，恐牵掣其手也。嗟乎。惟补可续，不补何续耶。"}]},{"ID":"20240616134913-y22yepl","Type":"NodeParagraph","Properties":{"id":"20240616134913-y22yepl","updated":"20240616134913"},"Children":[{"Type":"NodeText","Data":"或疑续断因补以接骨，则凡补之药，皆可接骨矣。曰∶单补又何能接续哉。惟续断于补中接骨，则补即有生之义，生即有续之功也。"}]},{"ID":"20240616134609-n2j14od","Type":"NodeThematicBreak","Properties":{"id":"20240616134609-n2j14od"}},{"ID":"20240616134839-hh4p8r6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134839-hh4p8r6","updated":"20240616134843"},"Children":[{"Type":"NodeText","Data":"续断《增广和剂局方药性总论》"}]},{"ID":"20240616134839-f1yk0mk","Type":"NodeParagraph","Properties":{"id":"20240616134839-f1yk0mk","updated":"20240616134839"},"Children":[{"Type":"NodeText","Data":"味苦辛，微温，无毒。主伤寒，补不足，金疮痈伤折跌，续筋骨，妇人乳难，崩中漏血，金疮血内漏，止痛，生肌肉及 伤，恶血，腰痛。《药性论》云∶君。主绝伤，去诸温毒，能宣通经脉。日华子云∶助气，调血脉，补五劳七伤，破症结瘀血，消肿毒，肠风痔，乳痈，瘰 ，扑，妇人产前后一切病，面黄损虚肿，缩小便，止泄精，尿血，胎漏，子宫冷。地黄为之使。恶∶雷丸。"}]},{"ID":"20240616134610-qv1i1nu","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-qv1i1nu"}},{"ID":"20240616134829-m8ad660","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134829-m8ad660","updated":"20240616134834"},"Children":[{"Type":"NodeText","Data":"续断《神农本草经读》"}]},{"ID":"20240616134829-qaamosl","Type":"NodeParagraph","Properties":{"id":"20240616134829-qaamosl","updated":"20240616134829"},"Children":[{"Type":"NodeText","Data":"气味苦、微温，无毒。主伤寒，补不足，金疮痈疡折跌，续筋骨，妇人乳难。久服益气力。"}]},{"ID":"20240616134829-8i7dtyg","Type":"NodeParagraph","Properties":{"id":"20240616134829-8i7dtyg","updated":"20240616134829"},"Children":[{"Type":"NodeText","Data":"【参】此以形为治。续断有肉有筋，如人筋在肉中之象；而色带紫、带黑，为肝肾之象。气味苦温，为少阴、阳明火土之气化；故寒伤于经络而能散之，痈疡络于经络而能疗之，折跌筋骨有伤，而能补不足、续其断绝；以及妇人乳难，而能通其滞而为乳。益气力者，亦能强筋骨之功也。"}]},{"ID":"20240616134610-ocw0689","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-ocw0689"}},{"ID":"20240616134821-smxxfcv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134821-smxxfcv","updated":"20240616134825"},"Children":[{"Type":"NodeText","Data":"续断《本草备要》"}]},{"ID":"20240616134821-uoi5yc3","Type":"NodeParagraph","Properties":{"id":"20240616134821-uoi5yc3","updated":"20240616134821"},"Children":[{"Type":"NodeText","Data":"补肝肾，理筋骨"}]},{"ID":"20240616134821-bgrdgo9","Type":"NodeParagraph","Properties":{"id":"20240616134821-bgrdgo9","updated":"20240616134821"},"Children":[{"Type":"NodeText","Data":"苦温补肾、辛温补肝。能宣通血脉而理筋骨。主伤中，补不足（《经疏》曰∶味甘故然）"}]},{"ID":"20240616134821-s5pkcrv","Type":"NodeParagraph","Properties":{"id":"20240616134821-s5pkcrv","updated":"20240616134821"},"Children":[{"Type":"NodeText","Data":"暖子宫，缩小便，破瘀血。"}]},{"ID":"20240616134821-szk9ps6","Type":"NodeParagraph","Properties":{"id":"20240616134821-szk9ps6","updated":"20240616134821"},"Children":[{"Type":"NodeText","Data":"治腰痛胎漏（怀妊沥血），崩带遗精，肠风血痢（《是斋方》∶平胃散一两，川续断二钱半，每服二钱，米饮下，治时痢亦验），痈痔肿毒。又主金疮折跌（以功命名），止痛生肌。"}]},{"ID":"20240616134821-4t0h8uk","Type":"NodeParagraph","Properties":{"id":"20240616134821-4t0h8uk","updated":"20240616134821"},"Children":[{"Type":"NodeText","Data":"女科外科，需为上剂。川产良。状如鸡脚，皮黄皱节节断者真。去向里硬筋，酒浸用。地黄为使。"}]},{"ID":"20240616134610-a8m4q43","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-a8m4q43"}},{"ID":"20240616134809-sl7segi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134809-sl7segi","updated":"20240616134814"},"Children":[{"Type":"NodeText","Data":"续断《本经逢原》"}]},{"ID":"20240616134809-ewop8n2","Type":"NodeParagraph","Properties":{"id":"20240616134809-ewop8n2","updated":"20240616134809"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名属折，《别录》名接骨"}]},{"ID":"20240616134809-aufjov6","Type":"NodeParagraph","Properties":{"id":"20240616134809-aufjov6","updated":"20240616134809"},"Children":[{"Type":"NodeText","Data":"苦微温，无毒。去根尾，酒炒用。"}]},{"ID":"20240616134809-8yh9oqd","Type":"NodeParagraph","Properties":{"id":"20240616134809-8yh9oqd","updated":"20240616134809"},"Children":[{"Type":"NodeText","Data":"《本经》主伤中补不足，金疮痈疡，折跌，续筋骨。妇人乳难，久服益气力。"}]},{"ID":"20240616134809-7nukw2t","Type":"NodeParagraph","Properties":{"id":"20240616134809-7nukw2t","updated":"20240616134809"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"续断入肝主续筋骨，为妇人胎产崩漏之首药。又主带脉为病，久服益气力，利关节、治腰痛，暖子宫，疗金疮折伤，散痈肿瘀血，疗妇人乳难。《本经》治伤中补不足等病，总取和血通经之义。又能止小便多，治遗泄。古方血痢用平胃散一两、续断三钱为末，每服三钱，水煎服即愈，宁无顾名思义之实乎。"}]},{"ID":"20240616134610-y434vs0","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-y434vs0"}},{"ID":"20240616134759-jf2unf1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134759-jf2unf1","updated":"20240616134803"},"Children":[{"Type":"NodeText","Data":"续断《本草从新》"}]},{"ID":"20240616134759-y84ygh6","Type":"NodeParagraph","Properties":{"id":"20240616134759-y84ygh6","updated":"20240616134759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补肝肾、理筋骨．"}]},{"ID":"20240616134759-egwt5wc","Type":"NodeParagraph","Properties":{"id":"20240616134759-egwt5wc","updated":"20240616134759"},"Children":[{"Type":"NodeText","Data":"苦辛微温．补肝肾．通血脉．理筋骨．主劳伤．暖子宫．缩小便．止遗泄．破瘀血．治腰痛胎漏．（怀妊沥血．）崩带肠风血痢．（平胃散一两、用续断二钱半、每服二钱、米饮下、治时痢甚效．）痈痔肿毒．又主金疮折跌．（以功命名．）止痛生肌．女科外科．需为上剂．（补而不滞、行而不泄、取用宏多．）川产良．状如鸡脚．皮黄皱节．节断者真．（草茅根、形似续断、误服令人筋软．）去向里硬筋．酒浸．地黄为使．恶雷丸．（叶捣罨打扑伤损．）"}]},{"ID":"20240616134610-ck7w1vv","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-ck7w1vv"}},{"ID":"20240616134751-w27sb88","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134751-w27sb88","updated":"20240616134755"},"Children":[{"Type":"NodeText","Data":"续断《玉楸药解》"}]},{"ID":"20240616134751-lr2v5uj","Type":"NodeParagraph","Properties":{"id":"20240616134751-lr2v5uj","updated":"20240616134751"},"Children":[{"Type":"NodeText","Data":"味苦，微温，入足厥阴肝经。行血破瘀，敛营补损。"}]},{"ID":"20240616134751-aqmi8v8","Type":"NodeParagraph","Properties":{"id":"20240616134751-aqmi8v8","updated":"20240616134751"},"Children":[{"Type":"NodeText","Data":"续断行瘀血而敛新血，崩漏、癥瘕、痈疽、瘰疬、淋漓、痔瘘、跌打、金疮诸血，能止能行，有回虚补损、接骨续筋之力。"}]},{"ID":"20240616134610-l36p5vr","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-l36p5vr"}},{"ID":"20240616134743-8obfb25","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134743-8obfb25","updated":"20240616134747"},"Children":[{"Type":"NodeText","Data":"续断《雷公炮制药性解》"}]},{"ID":"20240616134743-5hwdbyh","Type":"NodeParagraph","Properties":{"id":"20240616134743-5hwdbyh","updated":"20240616134743"},"Children":[{"Type":"NodeText","Data":"味苦辛，性温无毒，入肝肾二经，主伤寒不足，折伤金疮诸痈肿，治漏尿血，益气力，续筋骨散诸血，暖子宫，疗腰痛，缩小便，止梦泄，利关节，调血和血，生肌止痛。酒浸一宿，焙干用，地黄为使，恶雷丸。"}]},{"ID":"20240616134743-93wigx8","Type":"NodeParagraph","Properties":{"id":"20240616134743-93wigx8","updated":"20240616134743"},"Children":[{"Type":"NodeText","Data":"按∶肾主骨而藏精，肝主筋而藏血，续断补精血而理筋骨，宜入此二经矣。胎产之证，尤为要药。"}]},{"ID":"20240616134743-yk0zwbz","Type":"NodeParagraph","Properties":{"id":"20240616134743-yk0zwbz","updated":"20240616134743"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使勿用草茆利，真似续断，若误用，服之令人筋软。采得后，横切锉之，又去向里硬筋了，用酒浸一伏时，焙干用。"}]},{"ID":"20240616134610-bya7yvd","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-bya7yvd"}},{"ID":"20240616134735-1y83pg5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134735-1y83pg5","updated":"20240616134739"},"Children":[{"Type":"NodeText","Data":"续断《本草简要方》"}]},{"ID":"20240616134735-tn87wx1","Type":"NodeParagraph","Properties":{"id":"20240616134735-tn87wx1","updated":"20240616134735"},"Children":[{"Type":"NodeText","Data":"主治续筋骨。通脉络破瘀血。暖子宫。治五劳七伤。面黄虚肿。腰痛关节缓急。妇人产前后诸病。打扑伤损。生肌止痛。"}]},{"ID":"20240616134735-8zugdlu","Type":"NodeParagraph","Properties":{"id":"20240616134735-8zugdlu","updated":"20240616134735"},"Children":[{"Type":"NodeText","Data":"续断丸。续断五加皮防风薏仁羌活牛膝（酒浸）各三两。萆四两。思仙木生地各五两。"}]},{"ID":"20240616134735-84aqv35","Type":"NodeParagraph","Properties":{"id":"20240616134735-84aqv35","updated":"20240616134735"},"Children":[{"Type":"NodeText","Data":"研末。好酒三升。化青盐三两。用木瓜八两煎成膏。和杵为丸梧子大。每服三五十丸。空腹温续断（姜酒炒）牛膝（姜酒炒）萆（姜汁炒）各三两。防风一两五钱。川乌（炮）二枚。"}]},{"ID":"20240616134735-0ac3t8b","Type":"NodeParagraph","Properties":{"id":"20240616134735-0ac3t8b","updated":"20240616134735"},"Children":[{"Type":"NodeText","Data":"研末弹子大。每服一丸。细嚼醇酒下。治风寒湿痹。筋挛骨痛。又方。续断当归（炒）萆防风天麻各一两。乳香没药各五钱。川芎七钱五分。研末。蜜丸梧子大。每服四十丸。空腹温酒下。治风湿流注。四肢浮肿。肌肉麻痹。又方。续断当归乌贼骨黄牛角（烧）五甘草龙骨（）赤石脂熟地各一两。地榆五钱。艾叶附子干姜川芎各七钱五分。研末大。"}]},{"ID":"20240616134735-zjs79m2","Type":"NodeParagraph","Properties":{"id":"20240616134735-zjs79m2","updated":"20240616134735"},"Children":[{"Type":"NodeText","Data":"每服三十丸。空腹温酒下。治经水不止。口干心烦。四肢羸乏。饮食减少。"}]},{"ID":"20240616134735-biz53w0","Type":"NodeParagraph","Properties":{"id":"20240616134735-biz53w0","updated":"20240616134735"},"Children":[{"Type":"NodeText","Data":"打扑损伤取续断叶捣敷。"}]},{"ID":"20240616134610-obd5ro5","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-obd5ro5"}},{"ID":"20240616134726-y2blhkc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134726-y2blhkc","updated":"20240616134730"},"Children":[{"Type":"NodeText","Data":"续断《顾松园医镜》"}]},{"ID":"20240616134726-02ieuk1","Type":"NodeParagraph","Properties":{"id":"20240616134726-02ieuk1","updated":"20240616134726"},"Children":[{"Type":"NodeText","Data":"〔辛苦微温，入肝、肾二经，酒焙。〕补劳伤而续筋骨。〔理肝肾之功。〕破瘀结而利关节。〔通宣血脉之力。〕益气力，止腰痛，〔补肾之效。〕胎产必收，〔以其胎前能保，产后能行，且又止崩中漏血。〕外科亦宜。〔以其有消肿止痛生肌之功。〕补而不滞，行而不泻，故女科外科，取用宏多。同归、膝、元胡用，则行血理伤；同地、冬、枸杞、杜仲、五味、山萸、参、 用，则止崩漏补不足。"}]},{"ID":"20240616134726-hw42nuz","Type":"NodeParagraph","Properties":{"id":"20240616134726-hw42nuz","updated":"20240616134726"},"Children":[{"Type":"NodeText","Data":"茅草根似续断，误用令人筋软。"}]},{"ID":"20240616134610-dtipxpt","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-dtipxpt"}},{"ID":"20240616134710-o0sj24l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134710-o0sj24l","updated":"20240616134718"},"Children":[{"Type":"NodeText","Data":"续断《新修本草》"}]},{"ID":"20240616134710-uhklki1","Type":"NodeParagraph","Properties":{"id":"20240616134710-uhklki1","updated":"20240616134710"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微温，无毒。主伤寒，补不足，金疮，痈伤，折跌，续筋骨，妇人乳难。崩中漏血，金疮血内漏，止痛，生肌肉，疗 伤，恶血，腰痛，关节缓急。久服益气力。一名龙一名南草，一名槐。生常山山谷。七月、八月采，阴干。"}]},{"ID":"20240616134710-4u7yzgn","Type":"NodeParagraph","Properties":{"id":"20240616134710-4u7yzgn","updated":"20240616134710"},"Children":[{"Type":"NodeText","Data":"地黄为之使，恶雷丸。 案《桐君药录》云∶续断生蔓延，叶细、茎如荏，大根本，黄白有汁，七月、八月采根。"}]},{"ID":"20240616134710-pjeg6er","Type":"NodeParagraph","Properties":{"id":"20240616134710-pjeg6er","updated":"20240616134710"},"Children":[{"Type":"NodeText","Data":"今皆用茎叶，节节断，皮黄皱，状如鸡脚者，又呼为桑上寄生，恐皆非真。时人又有接骨树，高丈余许，叶似蒴 ，皮主疗金疮，有此接骨名，疑或者。而广州又有一藤名续断，一名诺藤，断其茎，器承其汁饮之，疗虚损绝伤，用沐头，又长发。折枝插地即生，恐此又相类。李云是虎蓟，与此大乖，而虎蓟亦自疗血尔。"}]},{"ID":"20240616134710-wq9w1mt","Type":"NodeParagraph","Properties":{"id":"20240616134710-wq9w1mt","updated":"20240616134710"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药，所在今俗用者是。叶似苎而茎方，根如大蓟，黄白色。陶注者，非也。"}]},{"ID":"20240616134610-187wu2r","Type":"NodeThematicBreak","Properties":{"id":"20240616134610-187wu2r"}},{"ID":"20240616134700-bx3a7g2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134700-bx3a7g2","updated":"20240616134704"},"Children":[{"Type":"NodeText","Data":"续断《要药分剂》"}]},{"ID":"20240616134700-ulkpu6z","Type":"NodeParagraph","Properties":{"id":"20240616134700-ulkpu6z","updated":"20240616134700"},"Children":[{"Type":"NodeText","Data":"味苦辛。性微温。无毒。得土金之气。兼禀天之阳气以生。可升可降。阳也。地黄为恶雷丸。"}]},{"ID":"20240616134700-gqkjygu","Type":"NodeParagraph","Properties":{"id":"20240616134700-gqkjygu","updated":"20240616134700"},"Children":[{"Type":"NodeText","Data":"【主治】主伤中。补不足。金疮。痈疡。折跌续筋骨。妇人乳难。久服益气力。（本经）女人宣通人产前【归经】入肝肾二经。为专益筋骨之品。（腰肾要药治胎产续绝伤）【前论】仲淳曰。欲行血理伤。当与当归、牛膝、肉桂、延胡索同用。欲止血疗崩中补不足则【禁忌】经疏曰。禁与苦寒药治血病。及与大辛热药用于胎前。"}]},{"ID":"20240616134700-ore54mg","Type":"NodeParagraph","Properties":{"id":"20240616134700-ore54mg","updated":"20240616134700"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。取根横切。又去向里硬筋。酒浸一伏时。焙用。备要曰。川产者良。"}]},{"ID":"20240607123640-5lldeoh","Type":"NodeThematicBreak","Properties":{"id":"20240607123640-5lldeoh"}},{"ID":"20240607123641-5xvbkb2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123641-5xvbkb2","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：续断"}]},{"ID":"20240607123641-jlk8red","Type":"NodeParagraph","Properties":{"id":"20240607123641-jlk8red","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123641-omrzml8","Type":"NodeParagraph","Properties":{"id":"20240607123641-omrzml8","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" Xù Duàn"}]},{"ID":"20240607123641-w1oegux","Type":"NodeParagraph","Properties":{"id":"20240607123641-w1oegux","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123641-h4jsci2","Type":"NodeParagraph","Properties":{"id":"20240607123641-h4jsci2","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 川续断、和尚头、山萝卜"}]},{"ID":"20240607123641-qgajmdk","Type":"NodeParagraph","Properties":{"id":"20240607123641-qgajmdk","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607123641-6kndsex","Type":"NodeParagraph","Properties":{"id":"20240607123641-6kndsex","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" RADIX DIPSACI"}]},{"ID":"20240607123641-r57qckx","Type":"NodeParagraph","Properties":{"id":"20240607123641-r57qckx","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123641-tr9qbe1","Type":"NodeParagraph","Properties":{"id":"20240607123641-tr9qbe1","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 本品为川续断科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川续断"},{"Type":"NodeText","Data":"Dipsacus asperoides C. Y. Cheng et T. M. Ai （或Dipsacus asper Wall）的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋季采挖，除去根头及须根，用微火烘至半干，堆置“发汗”至内部变绿色时，再烘干。"}]},{"ID":"20240607123641-ch8otyp","Type":"NodeParagraph","Properties":{"id":"20240607123641-ch8otyp","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123641-f5t5h2w","Type":"NodeParagraph","Properties":{"id":"20240607123641-f5t5h2w","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高60～90厘米。根圆锥形，主根明显，或有数条并生，外皮黄褐色。茎直立，多分枝，具棱和浅沟，生细柔毛，棱上有疏刺毛。叶对生。夏末秋初开花，头状花序近球形。瘦果椭圆楔形，长约3～4毫米，通常外被萼片，有四棱，浅褐色。"}]},{"ID":"20240607123641-ava0mip","Type":"NodeParagraph","Properties":{"id":"20240607123641-ava0mip","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123641-0tdo2ve","Type":"NodeParagraph","Properties":{"id":"20240607123641-0tdo2ve","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 本品呈圆柱形，略扁，有的微弯曲，长5～15cm，直径0.5～2cm。表面灰褐色或黄褐色，有稍扭曲或明显扭曲的纵皱及沟纹，可见横裂的皮孔及少数须根痕。质软，久置后变硬，易折断，断面不平坦，皮部墨绿色或棕色，外缘褐色或淡褐色，木部黄褐色，导管束呈放射状排列。气微香，味苦、微甜而后涩。"}]},{"ID":"20240607123641-jw7v6p5","Type":"NodeParagraph","Properties":{"id":"20240607123641-jw7v6p5","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607123641-8wvrysw","Type":"NodeParagraph","Properties":{"id":"20240607123641-8wvrysw","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240607123641-442183n","Type":"NodeParagraph","Properties":{"id":"20240607123641-442183n","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123641-64bkplr","Type":"NodeParagraph","Properties":{"id":"20240607123641-64bkplr","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"续断片"},{"Type":"NodeText","Data":"：洗净，润透，切薄片，干燥。本品呈类圆形或椭圆形。切面皮部墨绿色或棕褐色，木部灰黄色或黄褐色，可见放射状排列的导管束纹，形成层部位多有深色环。照上述[浸出物]项下的方法测定，不得少于45.0％。"}]},{"ID":"20240607123641-bpdnpet","Type":"NodeParagraph","Properties":{"id":"20240607123641-bpdnpet","updated":"20240607123641"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒续断"},{"Type":"NodeText","Data":"：取续断片，照酒炙法（附录ⅡD）炒至微带黑色。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"盐续断:"},{"Type":"NodeText","Data":"取续断片，照盐炙法（附录Ⅱ D）炒干。"}]},{"ID":"20240607123641-wrllixm","Type":"NodeParagraph","Properties":{"id":"20240607123641-wrllixm","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607123641-p7sn98c","Type":"NodeParagraph","Properties":{"id":"20240607123641-p7sn98c","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" （1）本品横切面：木栓细胞数列。皮层较窄。韧皮部筛管群稀疏散在。形成层环明显或不甚明显。木质部射线宽广，导管近形成层处分布较密，向内渐稀少，常单个散在或2～4个相聚。髓部小，细根多无髓。薄壁细胞含草酸钙簇晶。粉末黄棕色。草酸钙簇晶甚多，直径15～50μm,散在或存在于皱缩的薄壁细胞中，有时数个排列成紧密的条状。纺锤形薄壁细胞壁稍厚，有斜向交错的细纹理。具缘纹孔及网纹导管直径约至72（90）μm 。木栓细胞淡棕色，表面观类长方形、类方形、多角形或长多角形，壁薄。"}]},{"ID":"20240607123641-c0d2lx0","Type":"NodeParagraph","Properties":{"id":"20240607123641-c0d2lx0","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末5g，加氨试液2ml ，搅拌均匀，加氯仿50ml，加热回流1 小时，滤过。滤液加盐酸溶液（1→100）10ml，振摇，分取酸液，加氨试液使呈碱性，加氯仿10ml，振摇，分取氯仿液，加盐酸溶液（1→100）5ml ，振摇，取酸液分置三支试管中：一管中加碘化铋钾试液，生成橘黄色沉淀；一管中加碘化汞钾试液，生成黄色浑浊；另一管中加硅钨酸试液，生成灰白色浑浊。"}]},{"ID":"20240607123641-ofhn9bu","Type":"NodeParagraph","Properties":{"id":"20240607123641-ofhn9bu","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"（3）取本品粉末3g，加浓氨试液4ml，拌匀，放置1小时，加氯仿30ml，超声处理30分钟，滤过，滤液用盐酸溶液（4→100）30ml分次提取，提取液用浓氨试液调节PH值至10，再用氯仿20ml分次提取，合并氯仿液，浓缩至约0.5ml，作为供试品溶液。另取续断对照药材3g，同法制成对照药材溶液。吸取上述两种溶液各10μl,分别点于同一以2％ 氢氧化钠溶液制备的硅胶Ｇ薄层板上，以苯－无水乙醇（9:2）为展开剂，展开，取出，晾干，先喷以稀碘化铋钾试液，再喷以5％ 亚硝酸钠的70％乙醇溶液，放置片刻，在日光下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607123641-glzijw8","Type":"NodeParagraph","Properties":{"id":"20240607123641-glzijw8","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123641-qzp1t6n","Type":"NodeParagraph","Properties":{"id":"20240607123641-qzp1t6n","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607123641-2x8bjpq","Type":"NodeParagraph","Properties":{"id":"20240607123641-2x8bjpq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123641-34bbwhk","Type":"NodeParagraph","Properties":{"id":"20240607123641-34bbwhk","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 苦、辛，微温。"}]},{"ID":"20240607123641-uhww2h5","Type":"NodeParagraph","Properties":{"id":"20240607123641-uhww2h5","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123641-dayygux","Type":"NodeParagraph","Properties":{"id":"20240607123641-dayygux","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强筋骨，续折伤，止崩漏。用于腰膝酸软，风湿痹痛，崩漏，胎漏，跌扑损伤。酒续断多用于风湿痹痛，跌扑损伤。盐续断多用于腰膝酸软。"}]},{"ID":"20240607123641-eg149x5","Type":"NodeParagraph","Properties":{"id":"20240607123641-eg149x5","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123641-021khor","Type":"NodeParagraph","Properties":{"id":"20240607123641-021khor","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240607123641-a9qankm","Type":"NodeParagraph","Properties":{"id":"20240607123641-a9qankm","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123641-t9pn911","Type":"NodeParagraph","Properties":{"id":"20240607123641-t9pn911","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607123641-5pi82i3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123641-5pi82i3","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：续断"}]},{"ID":"20240607123641-7o4gabu","Type":"NodeParagraph","Properties":{"id":"20240607123641-7o4gabu","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123641-qll3m5q","Type":"NodeParagraph","Properties":{"id":"20240607123641-qll3m5q","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" Xù Duàn"}]},{"ID":"20240607123641-6od7hp3","Type":"NodeParagraph","Properties":{"id":"20240607123641-6od7hp3","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123641-o5m1v34","Type":"NodeParagraph","Properties":{"id":"20240607123641-o5m1v34","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 龙豆，属折（《本经》），接骨、南草（《别录》），接骨草（《卫生易简方》），川断（《临证指南》）。"}]},{"ID":"20240607123641-pwfg998","Type":"NodeParagraph","Properties":{"id":"20240607123641-pwfg998","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607123641-lkijrap","Type":"NodeParagraph","Properties":{"id":"20240607123641-lkijrap","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607123641-pv40b50","Type":"NodeParagraph","Properties":{"id":"20240607123641-pv40b50","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123641-rfvpoz5","Type":"NodeParagraph","Properties":{"id":"20240607123641-rfvpoz5","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 为川续断种植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川续断"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"续断"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。8～10月采挖，洗净泥沙，除去根头、尾梢及细根，阴干或炕干。"}]},{"ID":"20240607123641-5m3d4rq","Type":"NodeParagraph","Properties":{"id":"20240607123641-5m3d4rq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607123641-smygk9r","Type":"NodeParagraph","Properties":{"id":"20240607123641-smygk9r","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 主产湖北、四川、湖南、贵州。陕西、云南、江西、广东等地亦产。"}]},{"ID":"20240607123641-dibhy5f","Type":"NodeParagraph","Properties":{"id":"20240607123641-dibhy5f","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123641-anrlvhq","Type":"NodeParagraph","Properties":{"id":"20240607123641-anrlvhq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" ①川续断（《纲目》），又名：鼓捶草、和尚头（《滇南本草》），滋油菜、六汗。"}]},{"ID":"20240607123641-vc8kdyy","Type":"NodeParagraph","Properties":{"id":"20240607123641-vc8kdyy","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"多年生草本，高60～90厘米。根长锥形，主根明显，或数条并生，外皮黄褐色，具细长须根。茎直立，多分枝，具棱和浅槽，生细柔毛，棱上疏生刺毛。叶对生；基生叶有长柄，叶片羽状深裂，先端裂片较大，叶端惭尖，边缘有粗锯齿；茎生叶多为3裂，中央裂片最大，椭圆形至卵状披针形，长11～13厘米，宽4～6厘米，两侧裂片较小，边缘有粗锯齿，两面被白色贴伏柔毛；茎梢的叶3裂或全缘，具短柄，毛较少。花小，多数，成球形头状花序；总苞片数枚，狭披针形，每花外有一苞片，阔倒卵形；副萼具4钝齿，密生柔毛；萼浅盘状具4齿，略呈卵状三角形；花冠白色或浅黄色，具4枚较深的裂片，花冠管基部渐狭，外侧密被下向的长柔毛；雄蕊4，着生于花冠管之上部，花丝细长，伸出花冠外；雌蕊1，柱头短杆状而扁。瘦果椭圆楔形，通常外被萼片，有明显4棱，淡褐色。花期8～9月。果期9～10月。"}]},{"ID":"20240607123641-lkyr140","Type":"NodeParagraph","Properties":{"id":"20240607123641-lkyr140","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"野生于山野及路旁。主要分布于四川、湖北、湖南、云南、西藏等地。"}]},{"ID":"20240607123641-u6em9gz","Type":"NodeParagraph","Properties":{"id":"20240607123641-u6em9gz","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②续断，又名：小血转。"}]},{"ID":"20240607123641-34cieef","Type":"NodeParagraph","Properties":{"id":"20240607123641-34cieef","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"多年生草本，高50～100厘米。茎直立，具棱和浅槽，密被白色柔毛，棱上有较粗糙的刺毛。叶对生；基生叶有长柄，多为羽状深裂或3裂，偶有完整不裂者；茎生叶多为3～5羽状分裂，中央裂片最大，椭圆形至椭圆状广卵形，长8～16厘米，宽3～8厘米，先端渐尖，基都楔形，两侧裂片较小，基部下侧延成翼状；茎梢的叶较小，3裂，中央裂片披针形，两侧裂片较小，线形；边缘有粗锯齿，两面密被白色贴伏的柔毛，背面叶脉上常有刺毛。头状花序球形或广椭圆形；总苞片数枚，线形，每花外有一倒卵形苞片，先端突尖呈粗刺状，边缘有绿色针刺毛；副萼密生柔毛；花萼浅盘状，具4齿，密被细柔毛；花冠红紫色，4浅裂，裂片卵圆形；雄蕊4，着生于花冠管的上部，微伸出或不伸出于花冠外；雌蕊1，子房下位，花柱细长。瘦果楔状长圆形，长5～6毫米，具4棱，淡褐色，花萼宿存。花期8～9月。果期9～10月。"}]},{"ID":"20240607123641-xs46oyl","Type":"NodeParagraph","Properties":{"id":"20240607123641-xs46oyl","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"生于山坡草地，土填较湿处或溪沟旁，阳坡草地亦有生长。分布河北、安徽、江苏、浙扛、福建、广西、江西、山西、贵州、陕西等地。"}]},{"ID":"20240607123641-t9zq4eq","Type":"NodeParagraph","Properties":{"id":"20240607123641-t9zq4eq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123641-7eddeze","Type":"NodeParagraph","Properties":{"id":"20240607123641-7eddeze","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 干燥根呈长圆柱形，向下渐细，或稍弯曲，长7～10厘米，直径1～1.5厘米。表面灰褐色或黄褐色，有扭曲的纵皱及浅沟纹，皮孔横裂，并有少数根痕。质硬而脆，易折断。断面不平坦，微带角质性，皮部褐色，宽度约为木部的一半，形成层略呈红棕色，本部淡褐色或灰绿色。维管束呈放射状排列，微显暗绿色。气微香，味苦甜而涩。以粗肥、质坚、易折断、外色黄褐、内色灰绿者为佳。"}]},{"ID":"20240607123641-6a54o2o","Type":"NodeParagraph","Properties":{"id":"20240607123641-6a54o2o","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123641-y7yu98g","Type":"NodeParagraph","Properties":{"id":"20240607123641-y7yu98g","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 川续断根含生物碱、挥发油，续断根含续断碱及挥发油。"}]},{"ID":"20240607123641-0lg8ble","Type":"NodeParagraph","Properties":{"id":"20240607123641-0lg8ble","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123641-ye695u6","Type":"NodeParagraph","Properties":{"id":"20240607123641-ye695u6","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 续断：洗净泥沙，除去残留根头，润透后切片晒干，筛去屑。炒续断：取续断片入锅内以文火炒至微焦为度。盐续断：取续断片入锅内，加入盐水拌炒至干透为度。（每续断片100斤。用食盐2斤，加开水适量化水）酒续断：取续断片用酒拌匀吸干，入锅内以文火炒干为度。（每续断片100斤，用黄酒20斤）"}]},{"ID":"20240607123641-esi8rnq","Type":"NodeParagraph","Properties":{"id":"20240607123641-esi8rnq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123641-3a0p11v","Type":"NodeParagraph","Properties":{"id":"20240607123641-3a0p11v","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607123641-s9qrvdq","Type":"NodeParagraph","Properties":{"id":"20240607123641-s9qrvdq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入肝。\""}]},{"ID":"20240607123641-3asulj2","Type":"NodeParagraph","Properties":{"id":"20240607123641-3asulj2","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肝、肾二经。\""}]},{"ID":"20240607123641-d4b446w","Type":"NodeParagraph","Properties":{"id":"20240607123641-d4b446w","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123641-sidi7zq","Type":"NodeParagraph","Properties":{"id":"20240607123641-sidi7zq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 苦辛，微温。"}]},{"ID":"20240607123641-p5z1is8","Type":"NodeParagraph","Properties":{"id":"20240607123641-p5z1is8","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，微温。\""}]},{"ID":"20240607123641-qlsg8xm","Type":"NodeParagraph","Properties":{"id":"20240607123641-qlsg8xm","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"性温，微苦微酸。\""}]},{"ID":"20240607123641-lujkhrb","Type":"NodeParagraph","Properties":{"id":"20240607123641-lujkhrb","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"苦甘辛，微温，无毒。\""}]},{"ID":"20240607123641-opaow3m","Type":"NodeParagraph","Properties":{"id":"20240607123641-opaow3m","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607123641-d85ocq5","Type":"NodeParagraph","Properties":{"id":"20240607123641-d85ocq5","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"地黄为之使。恶雷丸。\""}]},{"ID":"20240607123641-njn36x3","Type":"NodeParagraph","Properties":{"id":"20240607123641-njn36x3","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"初痢勿用，怒气郁者禁用。\""}]},{"ID":"20240607123641-4x6iy6m","Type":"NodeParagraph","Properties":{"id":"20240607123641-4x6iy6m","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123641-srlkbvy","Type":"NodeParagraph","Properties":{"id":"20240607123641-srlkbvy","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 补肝肾，续筋骨，调血脉。治腰背酸痛，足膝无力，胎漏，崩漏，带下，遗精，跌打损伤，金疮，痔漏，痈疽疮肿。"}]},{"ID":"20240607123641-sq29bp9","Type":"NodeParagraph","Properties":{"id":"20240607123641-sq29bp9","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤寒，补不足，金疮，痈疡，折跌，续筋骨，妇人乳难，久服益气力。\""}]},{"ID":"20240607123641-371goe0","Type":"NodeParagraph","Properties":{"id":"20240607123641-371goe0","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主崩中漏血，金疮血内漏，止痛，生肌肉，腕伤，恶血，腰痛，关节缓急。\""}]},{"ID":"20240607123641-a6cvlv1","Type":"NodeParagraph","Properties":{"id":"20240607123641-a6cvlv1","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主绝伤，去诸温毒，能宣通经脉。\""}]},{"ID":"20240607123641-e9o20au","Type":"NodeParagraph","Properties":{"id":"20240607123641-e9o20au","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"助气，调血脉，补五劳七伤，破症结瘀血，消肿毒，肠风，痔瘘，乳痈，瘰疬，扑损，妇人产前后一切病，面黄虚肿，缩小便，止泄精，尿血，胎漏，子宫冷。\""}]},{"ID":"20240607123641-t635s89","Type":"NodeParagraph","Properties":{"id":"20240607123641-t635s89","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"补肝，强筋骨，走经络，止经中（筋骨）酸痛，安胎，治妇人白带，生新血，破瘀血，落死眙，止咳嗽咳血，治赤白便浊。\""}]},{"ID":"20240607123641-v3xzc63","Type":"NodeParagraph","Properties":{"id":"20240607123641-v3xzc63","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草图说》：\"治一切无名肿毒，杨梅，天泡诸疮。\""}]},{"ID":"20240607123641-3jslakq","Type":"NodeParagraph","Properties":{"id":"20240607123641-3jslakq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123641-hzu1pcl","Type":"NodeParagraph","Properties":{"id":"20240607123641-hzu1pcl","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；或入丸、散。外用：捣敷。"}]},{"ID":"20240607123641-pasnmda","Type":"NodeParagraph","Properties":{"id":"20240607123641-pasnmda","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123641-xqorhom","Type":"NodeParagraph","Properties":{"id":"20240607123641-xqorhom","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" ①治腰痛并脚酸腿软：续断二两，破故纸、牛膝、木瓜、萆薢；杜仲各一两。上为细末，炼蜜为丸桐子大。空心无灰酒下五、六十丸。（《扶寿精方》续断丸）"}]},{"ID":"20240607123641-rvuj8is","Type":"NodeParagraph","Properties":{"id":"20240607123641-rvuj8is","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②治老人风冷，转筋骨痛：续断、牛膝（去芦，酒浸）。上为细末，温酒调下二钱，食前服。（《魏氏家藏方》续断散）"}]},{"ID":"20240607123641-e5my07u","Type":"NodeParagraph","Properties":{"id":"20240607123641-e5my07u","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"③治妊娠胎动两三月堕：川续断（酒浸）、杜仲（姜汁炒去丝）各二两。为末，枣肉煮烊，杵和丸梧子大。每服三十丸，米饮下。（《纲目》）"}]},{"ID":"20240607123641-2d4ffyf","Type":"NodeParagraph","Properties":{"id":"20240607123641-2d4ffyf","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"④治滑胎：菟丝子四两（炒，炖），桑寄生二两，川续断二两，真阿胶二两。上药将前三味轧细，水化阿胶和为丸一分重（干足一分）。每服二十丸，开水送下，日再服。（《医学衷中参西录》寿胎丸）"}]},{"ID":"20240607123641-9tx8tgw","Type":"NodeParagraph","Properties":{"id":"20240607123641-9tx8tgw","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑤治打扑伤损，闪肭骨节：接骨草捣烂盫之。（《卫生易简方》）"}]},{"ID":"20240607123641-agvd3io","Type":"NodeParagraph","Properties":{"id":"20240607123641-agvd3io","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑥治产后血运，心腹鞕，乍寒乍热：续断三两，粗捣筛，每服二钱匕，以水一盏，煎至七分，去滓温服。（《圣济总录》续断汤）"}]},{"ID":"20240607123641-plqwgxj","Type":"NodeParagraph","Properties":{"id":"20240607123641-plqwgxj","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑦治乳汁不行：川续断五钱，当归、川芎各一钱五分，麻黄、川山甲（火煅）各二钱，天花粉三钱。水二大碗，煎八分，食后服。（《本草汇言》）"}]},{"ID":"20240607123641-p37j8b3","Type":"NodeParagraph","Properties":{"id":"20240607123641-p37j8b3","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑧治乳痈初起可消，久患可愈：川续断八两（酒浸，炒），蒲公英四两（日干，炒）。俱为末，每早晚，各服三钱，白汤调下。（《本草汇言》）"}]},{"ID":"20240607123641-pm2k74q","Type":"NodeParagraph","Properties":{"id":"20240607123641-pm2k74q","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑨治水肿：续断根，炖猪腰子食。（《湖南药物志》）"}]},{"ID":"20240607123641-7q1asty","Type":"NodeParagraph","Properties":{"id":"20240607123641-7q1asty","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607123641-qzchi1h","Type":"NodeParagraph","Properties":{"id":"20240607123641-qzchi1h","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" ①《本草汇言》：\"续断，补续血脉之药也。大抵所断之血脉非此不续，所伤之筋骨非此不养，所滞之关节非此不利，所损之眙孕非此不安，久服常服，能益气力，有补伤生血之效，补而不滞，行而不泄，故女科、外科取用恒多也。\""}]},{"ID":"20240607123641-lyzy179","Type":"NodeParagraph","Properties":{"id":"20240607123641-lyzy179","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"②《本草正》：\"续断，用其苦涩。其味苦而重，故能入血分，调血脉，消肿毒、乳痈、瘰疬、痔痿，治金损跌伤，续筋骨血脉；其味涩，故能治吐血、衄血、崩淋、胎漏、便血、尿血，调血痢，缩小便，止遗精带浊。佐之以甘，如甘草、地黄、人参、山药之类，其效尤捷。\""}]},{"ID":"20240607123641-ws8thju","Type":"NodeParagraph","Properties":{"id":"20240607123641-ws8thju","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"③《药品化义》：\"续断，苦养血脉，辛养皮毛，善理血脉伤损，接续筋骨断折，故各续断。外消乳痈、瘰疬，内清痔漏、肠红，以其气和味清，胎产调经，最为稳当。且苦能坚肾，辛能润肾，可疗小便频数，精滑梦遗，腰背酸疼，足膝无力，此皆肾经症也。若同紫菀用之，调血润燥，治血枯便闭，大能宣通血气而不走泄。\""}]},{"ID":"20240607123641-zwae0lq","Type":"NodeParagraph","Properties":{"id":"20240607123641-zwae0lq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"④《本草求真》：\"续断，实疏通气血筋骨第一药也。第因气薄而见精脱、胎动、溺血、失血等症，则又深忌，以性下流者故耳。功与地黄、牛膝、杜仲、巴戟相等，但有温补细微之别，不可不知。\""}]},{"ID":"20240607123641-u5ytei9","Type":"NodeParagraph","Properties":{"id":"20240607123641-u5ytei9","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"⑤《本草正义》：\"续断，通行百脉，能续绝伤而调气血，《本经》谓其主伤寒，补不足，极言其通调经脉之功。惟伤寒之寒字，殊不可解，疑当作中，然旧本皆作伤寒，惟石顽《逢原》则竟作伤中，盖亦石顽改之，未必其所见旧本之果作伤中也。其治金疮痈疡，止痛生肌肉，及折跌腕伤，恶血，续筋骨，主腰痛，关节缓急等证，无一非活血通络之功效。妇人乳难，则以乳子之时言之。即产后诸病，续断行血而能和血。故通治产后及崩漏也。\"又：\"续断，其气温和，气味俱厚，故兼入气血，能宣行百脉，通利关节，凡经络筋骨血脉诸病，无不主之，而通痹起痿，尤有特长。又其味苦而涩，能行能止，则疗崩漏、带下、血痢、淋浊，而女科之胎产经带，奇经八脉诸病，及伤科腕闪跌仆诸证，外疡痈肿溃腐，支节酸疼，屈伸不利等病，类皆赖以成功，其效甚宏，其用颇广，加以呈功颇捷，而性又柔和，无燥烈刚暴之弊。\""}]},{"ID":"20240607123641-vv8ktt3","Type":"NodeParagraph","Properties":{"id":"20240607123641-vv8ktt3","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123641-u9ktipe","Type":"NodeParagraph","Properties":{"id":"20240607123641-u9ktipe","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607123641-hozugnr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607123641-hozugnr","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"《中华本草》：续断"}]},{"ID":"20240607123641-skdkhec","Type":"NodeParagraph","Properties":{"id":"20240607123641-skdkhec","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123641-k153ga2","Type":"NodeParagraph","Properties":{"id":"20240607123641-k153ga2","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" Xù Duàn"}]},{"ID":"20240607123641-xjjq8vz","Type":"NodeParagraph","Properties":{"id":"20240607123641-xjjq8vz","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123641-qk9yies","Type":"NodeParagraph","Properties":{"id":"20240607123641-qk9yies","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 龙豆、属折、接骨、南草、接骨草、鼓锤草、和尚头、川断、川萝卜根、马蓟、黑老鸦头、小续断、山萝卜"}]},{"ID":"20240607123641-q330lnj","Type":"NodeParagraph","Properties":{"id":"20240607123641-q330lnj","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607123641-zc7amah","Type":"NodeParagraph","Properties":{"id":"20240607123641-zc7amah","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" Himalayan Teasel Root"}]},{"ID":"20240607123641-n5ybf9r","Type":"NodeParagraph","Properties":{"id":"20240607123641-n5ybf9r","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607123641-82qsv5j","Type":"NodeParagraph","Properties":{"id":"20240607123641-82qsv5j","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607123641-4juso6j","Type":"NodeParagraph","Properties":{"id":"20240607123641-4juso6j","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使续断，勿用草茆根，缘真似续断，若误用服之，令人筋软。"}]},{"ID":"20240607123641-6d32pzu","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607123641-6d32pzu","updated":"20240607123641"},"Children":[{"ID":"20240607123641-dzda2eo","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240607123641-dzda2eo","updated":"20240607123641"},"Children":[{"ID":"20240607123641-8qxmokr","Type":"NodeParagraph","Properties":{"id":"20240607123641-8qxmokr","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"陶弘景：按《桐君药录》云： 续断生蔓延，叶细，茎如荏大，根本黄白，有汁。七月八月采根，今皆用茎叶，节节断，皮黄皱，状如鸡脚者；又呼为桑上寄生，恐皆非真。时人又有接骨树，高丈余许，叶似蒴藋，皮主疗金疮，有此接骨名；疑或是。而广州又有一藤，名续断，一名诺藤，断其茎，器承其汁，饮之疗虚"}]}]}]},{"ID":"20240607123641-f40mc2q","Type":"NodeParagraph","Properties":{"id":"20240607123641-f40mc2q","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123641-ifsvp5y","Type":"NodeParagraph","Properties":{"id":"20240607123641-ifsvp5y","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 药材基源：为川续断科植物川续断的根。"}]},{"ID":"20240607123641-if1ci7o","Type":"NodeParagraph","Properties":{"id":"20240607123641-if1ci7o","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dipsacus asperoides C. Y. Cheng et T .M. Ai."}]},{"ID":"20240607123641-97lqhow","Type":"NodeParagraph","Properties":{"id":"20240607123641-97lqhow","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋播第3年采收，春播第2年收获，在霜冻前采挖，将全根挖起，除去泥土，用火烘烤或晒干，也可将鲜根置沸水或蒸笼中蒸或烫至根稍软时取出，堆起，用稻草覆盖任其发酵至草上发生水株进，再摊开晒干或烤至全干，去掉须根、泥土。"}]},{"ID":"20240607123641-wrr9bah","Type":"NodeParagraph","Properties":{"id":"20240607123641-wrr9bah","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607123641-vswsor9","Type":"NodeParagraph","Properties":{"id":"20240607123641-vswsor9","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于土壤肥沃、潮湿的山坡、草地。"}]},{"ID":"20240607123641-0r4zfqa","Type":"NodeParagraph","Properties":{"id":"20240607123641-0r4zfqa","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江西、湖北、湖南、广西、四川、贵州、云南、西藏等地。"}]},{"ID":"20240607123641-aes86qz","Type":"NodeParagraph","Properties":{"id":"20240607123641-aes86qz","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123641-opigmd0","Type":"NodeParagraph","Properties":{"id":"20240607123641-opigmd0","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 川续断 多年生草本，高60-200cm。根1至数条，圆柱状，黄褐色，稍肉质，侧根细长疏和。茎直立，具6-8棱，棱上有刺毛。基生叶稀疏丛生，具长柄，叶片琴状羽裂，长15-25cm，5-20cm，两侧裂片3-4对，靠近中央裂片一对较大，向下渐小，侧裂片倒卵形或匙形，最大的长4-9cm，宽3-4.5cm，上面被短毛，下面脉上被刺毛；茎生叶在茎中下部的羽状深裂，中央裂片特长，披针形，长可达1cm，宽达5cm，先端渐尖，有疏粗锯齿，两侧裂片2-4对，披针形或长圆形，较小，具长柄，向上叶柄渐短；上部叶披针形，不裂或基部3裂。花序头状球形，直径2-3cm；总花梗长可达55cm；总苞片5-7片，着生在花序基部，叶状，披针形或长线形，长1-4.5cm，宽4-5mm，先端稍平截，被短柔毛，中央尖头稍扁平，长2-3mm，小总苞片每侧有两条浅纵沟，顶端4裂，裂片先端急尖，裂片间有一规则细裂；花萼四棱皿关，长约1mm，不裂或4浅裂至4深裂，外被短毛，先端毛较长；花冠淡黄白色，花冠管窄漏斗状，长9-11mm，基部1/4-1/3处窄缩成细管，先端4裂，裂片倒卵形，一片稍大，外被短柔毛；雄蕊4，着生于花冠管的上部，明显超出花冠，花丝扁平，花药紫色，椭圆形；花柱短于雄蕊，柱头短棒状，子房下位，包于小总苞内。瘦果长倒卵柱状，长约4mm，仅先端露于小总苞之外。花期8-9月，果期9-10月。"}]},{"ID":"20240607123641-5rmdzwq","Type":"NodeParagraph","Properties":{"id":"20240607123641-5rmdzwq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607123641-c33z9k2","Type":"NodeParagraph","Properties":{"id":"20240607123641-c33z9k2","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜较凉爽湿润的气候，耐寒，忌高温。适于土层深厚、肥沃、疏松的土壤栽培。在干燥地区或质地粘重排水不良的土壤栽培，不仅生长不良，而且容易染病死亡。夏季高温达35℃以上时，芭叶萎垂，停止生长，容易遭受旱害，如遇多雨或潮湿环境，地下部易发病腐烂。种子萌发适宜温度为20-25℃，30℃高温对萌发有明显的抑制作用。一般每花序含种子2-4颗，也有多达7-8颗；千粒重7.5g左右。"}]},{"ID":"20240607123641-z927hgm","Type":"NodeParagraph","Properties":{"id":"20240607123641-z927hgm","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子和分株繁殖。种子繁殖：春播3月下旬至4月上旬；秋播9月下旬至10月下旬。种子需用40℃温水浸泡10h左右，捞出后放纱布袋或盆内置温暖处催芽，待萌芽时即可播种。条播，播前深翻土地，耙细整平，做宽、高畦[30cm×（15-20）cm]，行距20-35cm，深3cm，播后覆土镇压。每1hm2播种量34.5kg。穴播，行距为35-40cm，穴深7-10cm，穴径17-20cm，每穴播种7-9粒，每1hm27.5kg。播后施人畜粪尿每1hm212000kg，上覆1-1.5cm，细土。分株繁殖：秋季将带有芽的根头及细根，重新栽种，每穴1株，行株距为50cm×（25-33）cm，栽后立即浇水，以利发根。"}]},{"ID":"20240607123641-os2zk3l","Type":"NodeParagraph","Properties":{"id":"20240607123641-os2zk3l","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高7-10cm时间苗，每穴留壮苗2-3株，条播者按株距15cm定苗。结合施肥进行中耕除草，每1hm2可施人畜粪尿15000-30000kg，同时可施适量磷、钾肥，以促进根的膨大。夏季多真雨季节注意排水防涝。"}]},{"ID":"20240607123641-t6wabuu","Type":"NodeParagraph","Properties":{"id":"20240607123641-t6wabuu","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有根腐病，注意播种不宜过密，留苗不宜过多，经常保持土壤排水良好。如果发病严重，可提前1年采收，以免造成损失。虫害有红蜘蛛，苗期用0.2-0.3度波美石硫合剂或40%水胺硫磷1500倍液喷雾。"}]},{"ID":"20240607123641-d75n2v7","Type":"NodeParagraph","Properties":{"id":"20240607123641-d75n2v7","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607123641-37x6yyq","Type":"NodeParagraph","Properties":{"id":"20240607123641-37x6yyq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根长圆柱形，略扁，微弯曲，长5-15cm，直径0.5-2cm。表面棕褐色或灰褐色，有多数明显而扭曲的纵皱纹及沟纹，并多数明显而扭曲的纵皱纹及沟纹，并可见横长皮孔及少数须根痕。质稍软，久置干燥后变硬。易折断，断面不平坦，皮部绿褐色或淡褐色，木部黄褐色，常呈放射状花纹。气微香，味苦，微甜而后涩。"}]},{"ID":"20240607123641-b76beoa","Type":"NodeParagraph","Properties":{"id":"20240607123641-b76beoa","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"以条粗、质软、皮部绿褐色为佳。"}]},{"ID":"20240607123641-dso04qo","Type":"NodeParagraph","Properties":{"id":"20240607123641-dso04qo","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：木栓层为数列木栓细胞，壁薄，其内为数列排列整齐的栓内层。韧皮部宽广大，靠外方有裂隙，筛管群稀疏散在。形成层成环。木质部射线宽广，导管近形成层处分布较密，向内逐渐稀少，常单个散在，或2-3个成群。粗根髓部小，细根（直径0.5cm以下）无髓。薄壁细胞中含草酸钙簇晶及淀粉粒。"}]},{"ID":"20240607123641-zd4gdlb","Type":"NodeParagraph","Properties":{"id":"20240607123641-zd4gdlb","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123641-tmgf3pq","Type":"NodeParagraph","Properties":{"id":"20240607123641-tmgf3pq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 川续断根根含环烯醚萜糖甙：当药甙（swero-side），马钱子甙（loganin），茶茱萸甙（cantleyoside）[1]；三萜皂甙：木通皂甙D即3-O-α-L-吡喃阿拉伯糖基常春藤皂甙元-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[akebiasaponin D,3-O-α-L-arabinopyranosylhederagenin-28-O-β-D-glucopyranosyl（1→6）-β-D-glucopyranoside]，3-O-（4-O-乙酰基）-α-L-吡喃阿拉伯糖基常春藤皂甙元-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[3-O（4-O-acetyl）-α-L-arabinopyranosylhederagnin-28-O-β-D-glucopyranosyl（1→6）-β-D-glucopyranoside][1，2，3-O-α-L-吡喃阿拉伯糖基齐墩果酸-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃萄糖甙[3-O-α-L-arabinopyranosyloleanolic acid-28-O-β-D-glucopy-ranosyl（1→6）-β-D-glucopyranoside][2]，3-O-β-D-吡喃葡萄糖基（1→3）-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基常春藤皂甙元-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[3-O-β-D-glucopyranosyl(1→3)-α-L-rhamnopyranosyl（1→2）-α-L-ara-binopyranosylhederagenin-28-O-β-D-glucopyranosyl（1→6）-β-D-glucopyranoside]，3-O-α-L-吡喃鼠李糖基（1→3）-β-D-吡喃葡萄糖基（1→3）-α-L-吡喃鼠李糖甙（1→2）-α-L-吡喃阿拉伯糖基常春藤皂甙元-28-O-β-D-吡喃葡萄糖基（1→6）-β-D-吡喃葡萄糖甙[3-O-α-L-rhamnopyranosyl（1→3）-β-D-glucopyranosyl（1→3）-α-L-rhamnopyranosyl（1→2）α-L-arabinopyranosylhederagenin-28-Oβ-D- glucopyranosyl（1→6）-β-D-glucopyranoside][3]，3-O-β-D-吡喃木糖基（1→4）-β-D-吡喃葡萄糖基（1→4）-α-L-吡喃鼠李糖基（1→3）-β-D-吡喃葡萄糖基（1→3）-α-L-吡喃鼠李糖基（1→2）-α-L-吡喃阿拉伯糖基常春藤皂甙元"}]},{"ID":"20240607123641-k36zyza","Type":"NodeParagraph","Properties":{"id":"20240607123641-k36zyza","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607123641-95qxjqy","Type":"NodeParagraph","Properties":{"id":"20240607123641-95qxjqy","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 1.抗维生素E缺乏症：经小白鼠和鸡试验，证明续断有抗维生素E缺乏症的作用。"}]},{"ID":"20240607123641-xgco2zn","Type":"NodeParagraph","Properties":{"id":"20240607123641-xgco2zn","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"2.止血、镇痛作用：对痈疡有排脓、止血、镇痛、促进组织再生的作用。"}]},{"ID":"20240607123641-wocmg69","Type":"NodeParagraph","Properties":{"id":"20240607123641-wocmg69","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607123641-sviy2u0","Type":"NodeParagraph","Properties":{"id":"20240607123641-sviy2u0","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 续断：洗净泥沙，除去残留根头，润透后切片晒干，筛去屑。炒续断：取续断片入锅内以文火炒至微焦为度。盐续断：取续断片入锅内，加入盐水拌炒至干透为度。(每续断片100斤，用食盐20斤加开水适量化水)酒续断：取续断片用酒拌匀吸干，入锅内以文火炒干为度。(每续断片100斤，用黄酒20斤)"}]},{"ID":"20240607123641-jdgvze0","Type":"NodeParagraph","Properties":{"id":"20240607123641-jdgvze0","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607123641-zlzz8y9","Type":"NodeParagraph","Properties":{"id":"20240607123641-zlzz8y9","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粗粉2g，加水20ml，在60℃水谷加热30min，滤过，取滤液5ml用力振摇，产生持久性泡沫。（检查皂甙）（2）取本品粗粉1g，加乙醇10ml，回流1h，滤过。取滤液2ml1%三氯化铁试液2-3滴，显污绿色；另取滤液滴于滤低上，滴加香草醛-盐酸试液，变成红色。（检查酚类）"}]},{"ID":"20240607123641-jx3e2a9","Type":"NodeParagraph","Properties":{"id":"20240607123641-jx3e2a9","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607123641-mh88sdb","Type":"NodeParagraph","Properties":{"id":"20240607123641-mh88sdb","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 归肝；肾经"}]},{"ID":"20240607123641-qxf8w7m","Type":"NodeParagraph","Properties":{"id":"20240607123641-qxf8w7m","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607123641-1mogdsz","Type":"NodeParagraph","Properties":{"id":"20240607123641-1mogdsz","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性微温"}]},{"ID":"20240607123641-mv3rxi6","Type":"NodeParagraph","Properties":{"id":"20240607123641-mv3rxi6","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607123641-vojyrua","Type":"NodeParagraph","Properties":{"id":"20240607123641-vojyrua","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 1.《本草经集注》：地黄为之使。恶雷丸。"}]},{"ID":"20240607123641-5ro26z2","Type":"NodeParagraph","Properties":{"id":"20240607123641-5ro26z2","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"2.《得配本草》：初痢勿用，怒气郁者禁用。"}]},{"ID":"20240607123641-z4uvbea","Type":"NodeParagraph","Properties":{"id":"20240607123641-z4uvbea","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123641-gh76czk","Type":"NodeParagraph","Properties":{"id":"20240607123641-gh76czk","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 补肝肾；强筋骨；调血脉；止崩漏。主腰背酸痛；肢节痿痹；跌扑创伤、损筋折骨、胎动漏红、血崩、遗精、带下、痈疽疮肿"}]},{"ID":"20240607123641-vz2zq5y","Type":"NodeParagraph","Properties":{"id":"20240607123641-vz2zq5y","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123641-2uol69v","Type":"NodeParagraph","Properties":{"id":"20240607123641-2uol69v","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入丸、散。外用：鲜品适量，捣敷。"}]},{"ID":"20240607123641-6b8wx4m","Type":"NodeParagraph","Properties":{"id":"20240607123641-6b8wx4m","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123641-wzuyz0z","Type":"NodeParagraph","Properties":{"id":"20240607123641-wzuyz0z","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" ①治腰痛并脚酸腿软： 续断二两，破故纸、牛膝、木瓜、萆薢、杜仲各一两。上为细末，炼蜜为丸桐于大。空心无灰酒下五、六十丸。(《扶寿精方》续断丸)②治老人风冷，转筋骨痛：续断、牛膝(去芦，酒浸)。上为细末，温酒调下二钱，食前服。(《魏氏家藏方》续断散)③治妊娠胎动两三月堕： 川续断(酒浸)、杜仲(姜计炒去丝)各二两。为末，枣肉煮烊，杵和丸梧子大。每服三十丸，米饮下。(《纲目》)④治滑胎： 菟丝子四两(炒，炖)，桑寄生二两，川续断二两，真阿胶二两。上药将前三味轧重(干足一分)。每服二十丸，开水送下，日再服。(《医学衷中参西录》寿胎丸)⑤治打扑伤损，闪肭骨：接骨草捣烂盆之。(《卫生易简方》)⑥治产后血运，心腹鞕，乍寒乍热：续断三两，粗捣筛，每服二钱匕，以水一盏，煎至七分，去滓温服。(《圣济总录》续断汤)⑦治乳汁不行： 川续断五钱，当归、川芎各一钱五分，麻黄、川山甲(火煅)各二钱，天花粉三钱。水二大碗，煎八分，食后服。(《本草汇言》)⑧治乳痈初起可消，久患可愈： 川续断八两(酒浸，炒)，蒲公英四两(日干，炒)。俱为末，每早晚，各服三钱，白汤调下。(《本草汇言》)⑨治水肿： 续断根，炖猪腰子食。(《湖南药物志》)"}]},{"ID":"20240607123641-lop0m1t","Type":"NodeParagraph","Properties":{"id":"20240607123641-lop0m1t","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607123641-onqvgng","Type":"NodeParagraph","Properties":{"id":"20240607123641-onqvgng","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主伤寒，补不足，金疮，痈疡，折跌，续筋骨，妇人乳难，久服益气力。"}]},{"ID":"20240607123641-8e0uu0x","Type":"NodeParagraph","Properties":{"id":"20240607123641-8e0uu0x","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主崩中漏血，金疮血内漏，止痛，生肌肉，踠伤，恶血，腰痛，关节缓急。"}]},{"ID":"20240607123641-5hy7dpw","Type":"NodeParagraph","Properties":{"id":"20240607123641-5hy7dpw","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：主绝伤，去诸温毒，能宣通经脉。"}]},{"ID":"20240607123641-w7ymgv8","Type":"NodeParagraph","Properties":{"id":"20240607123641-w7ymgv8","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：助气，调血脉，补五劳七伤，破症结瘀血，消肿毒，肠风，痔瘘，乳痈，瘰疬，扑损，妇人产前后一切病，面黄虚肿，缩小便，止泄精，尿血，胎漏，子宫冷。"}]},{"ID":"20240607123641-cm6gr3k","Type":"NodeParagraph","Properties":{"id":"20240607123641-cm6gr3k","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：补肝，强筋骨，定经络，止经中(筋骨)酸痛，安胎，治妇人白带，生新血，破瘀血，落死胎，止咳嗽咳血，治赤白便浊。"}]},{"ID":"20240607123641-o7pc0lm","Type":"NodeParagraph","Properties":{"id":"20240607123641-o7pc0lm","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"6.《滇南本草图说》：治一切无各肿毒，杨梅，天泡诸疮。"}]},{"ID":"20240607123641-ky7cybi","Type":"NodeParagraph","Properties":{"id":"20240607123641-ky7cybi","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"7.《本草汇言》：续断，补续血脉之药也。大抵所断之血脉非此不续，所伤之筋骨非此不养，所滞之关节非此不利，所损之胎孕非此不安，久服常服，能益气力，有补伤生血之效，补而不滞，行而不泄，故女科、外科取用恒多也。"}]},{"ID":"20240607123641-x1ny4fm","Type":"NodeParagraph","Properties":{"id":"20240607123641-x1ny4fm","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"8.《本草正》：续断，用其苦涩。其味苦而重，故能入血分，调血脉，消肿毒、乳痈、瘰疬、痔屡，治金损跌伤，续筋骨血脉；其味涩，故能治吐血、衄血、崩淋、胎漏、便血、尿血，调血痢，缩小便，止遗精带浊。佐之以甘，如甘草、地黄、人参、山药之类，其效尤捷。"}]},{"ID":"20240607123641-li5eodf","Type":"NodeParagraph","Properties":{"id":"20240607123641-li5eodf","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"9.《药品化义》：续断，苦养血脉，辛养皮毛，善理血脉伤损，接续筋骨断折，故名续断。外消乳痈、原疡，内清痔漏、肠红，以其气和味清，胎产碉经，最为稳当。且苦能坚肾，李能润肾，可疗小便额数，精滑梦遗，腰背酸疼，足膝无力，此皆肾经症也。若同紫菀用之，调血润燥，治血枯便闭，大能直通血气而不走泄。"}]},{"ID":"20240607123641-7ggb8xj","Type":"NodeParagraph","Properties":{"id":"20240607123641-7ggb8xj","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"10.《本草求真》：续断，实疏通气血筋骨第一药也。第因气薄而见精脱、胎动、溺血、失血等症，则又深忌，以性下流者故耳。功与地黄、牛膝、杜仲、巴戟相等，但有温补细微之别，不可不知。"}]},{"ID":"20240607123641-rtd1s8l","Type":"NodeParagraph","Properties":{"id":"20240607123641-rtd1s8l","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"11.《本草正义》：续断，通行百脉，能续绝伤而调气血，《本经》谓其主伤寒，补不足，极言其通调经脉之功。惟伤寒之寒字，殊不可解，疑当作中，然旧本皆作伤寒，则竟作伤中，盖亦石顽改之，未必其所见旧本之果作伤中也。其治金疮痈疡，止痛生肌肉，及折跌踠伤；恶血，续筋骨，主腰痛，关节缓急等证，无一非活血通终之功效。妇人乳难，则以乳子之时言之。即产后诸病，续断行血而能和血。故通治产后及崩漏也。"}]},{"ID":"20240607123641-8ynrvuq","Type":"NodeParagraph","Properties":{"id":"20240607123641-8ynrvuq","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123641-6j421w0","Type":"NodeParagraph","Properties":{"id":"20240607123641-6j421w0","updated":"20240607123641"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607123643-gt0rl03","Type":"NodeThematicBreak","Properties":{"id":"20240607123643-gt0rl03"}},{"ID":"20240607123644-0f2az81","Type":"NodeParagraph","Properties":{"id":"20240607123644-0f2az81"}}]}