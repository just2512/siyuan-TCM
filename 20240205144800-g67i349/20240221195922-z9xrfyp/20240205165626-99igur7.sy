tyle=\"width: 523px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (27)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 27-20240805114335-n3pnetq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (28)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 28-20240805114414-0iu52qf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805114454-ew2hkhz","Type":"NodeParagraph","Properties":{"id":"20240805114454-ew2hkhz","updated":"20240805115041"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 421px;","style":"width: 411px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (32)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 32-20240805114700-wxe677p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 411px;\" parent-style=\"width: 421px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 779px;","style":"width: 769px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (29)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 29-20240805114454-cpmuz7r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 769px;\" parent-style=\"width: 779px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805114540-km8fbis","Type":"NodeParagraph","Properties":{"id":"20240805114540-km8fbis","updated":"20240805114540"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 608px;","style":"width: 598px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (30)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 30-20240805114540-mz33qz9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 598px;\" parent-style=\"width: 608px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 609px;","style":"width: 599px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (31)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 31-20240805114619-fpu2aov.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 599px;\" parent-style=\"width: 609px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240805114755-2nr76bv","Type":"NodeParagraph","Properties":{"id":"20240805114755-2nr76bv","updated":"20240805114755"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 530px;","style":"width: 520px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (33)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 33-20240805114755-sailjyy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 520px;\" parent-style=\"width: 530px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 715px;","style":"width: 705px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石斛 (34)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石斛 34-20240805115009-2jdm7c7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 705px;\" parent-style=\"width: 715px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805110603-ix8unu4","Type":"NodeParagraph","Properties":{"id":"20240805110603-ix8unu4","updated":"20240805110631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：外型上的区别，金钗石斛茎是扁的，铁皮石斛茎是圆的；"}]},{"ID":"20240805110928-wb15x85","Type":"NodeParagraph","Properties":{"id":"20240805110928-wb15x85","updated":"20240805112141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：金钗石斛的茎长得像古时候女子带的发钗，所以叫金钗石斛；金钗石斛的茎不一定都是金黄色的；金钗石斛花色较多，叶子形状也有圆有尖；"}]},{"ID":"20240805114100-bb4q0ua","Type":"NodeParagraph","Properties":{"id":"20240805114100-bb4q0ua","updated":"20240805114121"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：霍山石斛相比其他石斛要矮许多，极其珍贵；"}]},{"ID":"20240805115123-rp477ks","Type":"NodeParagraph","Properties":{"id":"20240805115123-rp477ks","updated":"20240805115318"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四注：枫斗石斛并不是一种石斛种类，而是将干品的石斛经过缠绕加箍而成的制品；"}]},{"ID":"20240616105011-3c472kx","Type":"NodeThematicBreak","Properties":{"id":"20240616105011-3c472kx"}},{"ID":"20240616105318-wc1rp43","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105318-wc1rp43","updated":"20240616105323"},"Children":[{"Type":"NodeText","Data":"石斛《神农本草经》"}]},{"ID":"20240616105318-f29ti1q","Type":"NodeParagraph","Properties":{"id":"20240616105318-f29ti1q","updated":"20240616105318"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240616105318-f6c6cc9","Type":"NodeParagraph","Properties":{"id":"20240616105318-f6c6cc9","updated":"20240616105318"},"Children":[{"Type":"NodeText","Data":"主伤中，除痹，下气，补五脏虚劳，羸瘦，强阴。久服厚肠胃，轻身延年。一名林兰（《御览》引云，一名禁生，观本，作黑字），生山谷。"}]},{"ID":"20240616105318-1cf5zfz","Type":"NodeParagraph","Properties":{"id":"20240616105318-1cf5zfz","updated":"20240616105318"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：石斛，神农甘平，扁鹊酸，李氏寒（《御览》）。"}]},{"ID":"20240616105318-5wx1ynf","Type":"NodeParagraph","Properties":{"id":"20240616105318-5wx1ynf","updated":"20240616105318"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名禁生，一名杜兰，一名石蓫，生六安水傍石上，七月八月，采茎，阴干。"}]},{"ID":"20240616105318-d2egyzp","Type":"NodeParagraph","Properties":{"id":"20240616105318-d2egyzp","updated":"20240616105318"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：石斛，出六安。"}]},{"ID":"20240616105402-fxsiwh7","Type":"NodeThematicBreak","Properties":{"id":"20240616105402-fxsiwh7"}},{"ID":"20240616105403-cgqelz8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105403-cgqelz8","updated":"20240616105407"},"Children":[{"Type":"NodeText","Data":"石斛《要药分剂》"}]},{"ID":"20240616105403-z2018xc","Type":"NodeParagraph","Properties":{"id":"20240616105403-z2018xc","updated":"20240616105403"},"Children":[{"Type":"NodeText","Data":"味甘。性平。无毒。禀土中冲阳之气。兼感春之和气以生。降也。阴中阳也。陆英为使。恶凝水石、巴豆。畏雷丸、僵蚕。"}]},{"ID":"20240616105403-i2lb7h3","Type":"NodeParagraph","Properties":{"id":"20240616105403-i2lb7h3","updated":"20240616105403"},"Children":[{"Type":"NodeText","Data":"【主治】主补五脏。虚劳羸瘦。强阴益精。（本经）平胃气。逐皮肤邪热痱气。脚膝疼冷痹弱治发热自【归经】入胃肾二经。兼入心脾二经。为除热益阴之品。（除脾胃湿热补益四经）【前论】寇氏曰。石斛治胃中虚热有功。时珍曰。此乃脾及右肾之药。深师云。囊湿精少。"}]},{"ID":"20240616105403-keouqz4","Type":"NodeParagraph","Properties":{"id":"20240616105403-keouqz4","updated":"20240616105403"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。去根头。酒浸一宿。酥拌蒸半日。焙用。入补药乃效。"}]},{"ID":"20240616105425-5uynssc","Type":"NodeThematicBreak","Properties":{"id":"20240616105425-5uynssc"}},{"ID":"20240616105426-lmaj0n6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105426-lmaj0n6","updated":"20240616105431"},"Children":[{"Type":"NodeText","Data":"石斛《新修本草》"}]},{"ID":"20240616105426-8nhyxck","Type":"NodeParagraph","Properties":{"id":"20240616105426-8nhyxck","updated":"20240616105426"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主伤中，除痹，下气，补五脏虚劳羸瘦，强阴。益精，补内绝不足，平胃气，长肌肉，逐皮肤邪热痱气，脚膝疼冷痹弱。久服浓肠胃，轻身延年，定志除惊。一名林兰，一名禁生，一名杜兰，一名石KT 。生六安山谷水旁石上。七月、八月采茎，阴干。"}]},{"ID":"20240616105426-wlidnd7","Type":"NodeParagraph","Properties":{"id":"20240616105426-wlidnd7","updated":"20240616105426"},"Children":[{"Type":"NodeText","Data":"陆英为之使，恶凝水石、巴豆，畏姜蚕、雷丸。今用石斛，出始兴。生石上，细实，桑灰汤沃之，色如金，形似蚱蜢髀者为佳。近道亦有，次宣城间。生栎树上者，名木斛。其茎形长大而色浅。六安属庐江，今始安亦出木斛，至虚长，不入丸散，惟可为酒渍煮汤用尔。俗方最以补虚，疗脚膝。"}]},{"ID":"20240616105426-pcc2js3","Type":"NodeParagraph","Properties":{"id":"20240616105426-pcc2js3","updated":"20240616105426"},"Children":[{"Type":"NodeText","Data":"〔谨案〕作干石斛，先以酒洗，捋蒸炙成，不用灰汤。今荆襄及汉中、江左又有二种∶一者似大麦，累累相连，头生一叶，而性冷；一种大如雀髀，名雀髀斛，生者。亦如麦斛，叶在茎端，其余斛如竹，节间生叶也。"}]},{"ID":"20240616105415-a12as26","Type":"NodeThematicBreak","Properties":{"id":"20240616105415-a12as26"}},{"ID":"20240616105417-xbgopz8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105417-xbgopz8","updated":"20240616105420"},"Children":[{"Type":"NodeText","Data":"石斛《本草求真》"}]},{"ID":"20240616105417-zdleq7o","Type":"NodeParagraph","Properties":{"id":"20240616105417-zdleq7o","updated":"20240616105417"},"Children":[{"Type":"NodeText","Data":"（蔓草）治心热祛肝风"}]},{"ID":"20240616105417-fry2swq","Type":"NodeParagraph","Properties":{"id":"20240616105417-fry2swq","updated":"20240616105417"},"Children":[{"Type":"NodeText","Data":"钩藤（专入心肝）。味甘微苦。气平微寒。为手少阴心厥阴肝经要药。缘肝主风。心主火。风火相煽。则风因火而愈炽。火亦因风而益盛。其在小儿。则病必在惊痫螈 。眼翻抽掣。（筋急而缩为螈。筋缓而弛为 。伸缩不已为螈 。俗谓之搐搦是也。）大人则病必见头旋目眩。妇人则病必见赤白带下。故必用此轻平宣泄认为下降。则风静火熄。而惊风热自尔其克除矣。（藤类象筋。故抽掣病由筋生者。必为之用。）此惟小儿风热。初热病未见甚者。用之得宜。若使风火至极。势难骤遏。则此轻平疏泄。效难克奏。又当细审所因。用以重剂以为投服。则药始与病当。而无病重药轻之弊矣。取藤细多钩者良。（钩尤有力。）但久煎则无力。"}]},{"ID":"20240616105349-5mqoz8a","Type":"NodeThematicBreak","Properties":{"id":"20240616105349-5mqoz8a"}},{"ID":"20240616105350-olqezfn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105350-olqezfn","updated":"20240616105357"},"Children":[{"Type":"NodeText","Data":"石斛《神农本草经赞》"}]},{"ID":"20240616105350-8g41myi","Type":"NodeParagraph","Properties":{"id":"20240616105350-8g41myi","updated":"20240616105350"},"Children":[{"Type":"NodeText","Data":"味甘平。主伤中。除痹下气。补五脏。虚劳羸瘦。强阴。久服浓肠胃。轻身延年。一名林兰。生山谷。"}]},{"ID":"20240616105350-3xppi01","Type":"NodeParagraph","Properties":{"id":"20240616105350-3xppi01","updated":"20240616105350"},"Children":[{"Type":"NodeText","Data":"幽谷熏风。敷芬布畅。整插金钗。攒丛翠障。林窃兰名。节如竹状。润说千年。神恬津藏。"}]},{"ID":"20240616105350-845q98c","Type":"NodeParagraph","Properties":{"id":"20240616105350-845q98c","updated":"20240616105350"},"Children":[{"Type":"NodeText","Data":"诗。出于幽谷。柳公权联句。熏风自南来。苏颂曰。五月生苗。张协赋。和风穆以布畅。"}]},{"ID":"20240616105350-od3yw47","Type":"NodeParagraph","Properties":{"id":"20240616105350-od3yw47","updated":"20240616105350"},"Children":[{"Type":"NodeText","Data":"百卉蔚而敷芬。刘绮诗。整插补余空。李时珍曰。蜀人呼为金钗花。江淹赋。攒丛石径。苏轼诗。乱山横翠障。苏恭曰。石斛如竹节间生叶。李时珍曰。俗称为千年润。元诗。神恬津藏满。"}]},{"ID":"20240616105339-jd5huac","Type":"NodeThematicBreak","Properties":{"id":"20240616105339-jd5huac"}},{"ID":"20240616105340-861z61b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105340-861z61b","updated":"20240616105344"},"Children":[{"Type":"NodeText","Data":"石斛《本草经解》"}]},{"ID":"20240616105340-od1ama6","Type":"NodeParagraph","Properties":{"id":"20240616105340-od1ama6","updated":"20240616105340"},"Children":[{"Type":"NodeText","Data":"名医别录称生六安山谷．苏颂谓广南者佳．纲目谓蜀中者胜．今真石斛干者色正黄．形如蚱蜢髀．所谓金钗石斛也．其生者高不及寸．极似矮小瓦松．丛生连根．种之磁盘．亦堪爱玩．然六境罕有．产英邑深山中．峭壁千寻．可望而不可即．采者自巅顶缒巨 而下及山腰．用器极力搜剔．令纷纷坠落．始就涧谷检取．亦至危险矣．且每斤干才数两．故采者绝少．今地志误为合肥方物．好事者间向征求．李虚舟大令云．境无崇山．何由得此．每用为笑．近友人归自粤西．偶及三七．云彼地亦甚贵．以上官熬膏．需索无厌也．取之铢锱．用之土苴．吾乡玉面金芽．尤物非幸．其不及此．犹喜未有读本草者耳．"}]},{"ID":"20240616105328-a64kpus","Type":"NodeThematicBreak","Properties":{"id":"20240616105328-a64kpus"}},{"ID":"20240616105330-zxznkfp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105330-zxznkfp","updated":"20240616105334"},"Children":[{"Type":"NodeText","Data":"石斛《本草崇原》"}]},{"ID":"20240616105330-rq9b9da","Type":"NodeParagraph","Properties":{"id":"20240616105330-rq9b9da","updated":"20240616105330"},"Children":[{"Type":"NodeText","Data":"气味甘平，无毒。主伤中，除痹，下气，补五脏虚劳羸瘦，强阴益精。久服，浓肠胃（石斛始出六安山谷水旁石上，今荆襄、汉中、庐州、台州、温州诸处皆有。一种形如金钗，谓之钗石斛，为俗所尚，不若川地产者，其形修洁，茎长一二尺，气味清疏，黄白而实，入药最良。其外更有木斛，长而中虚，不若川石斛之中实也。又有麦斛，形如大麦，累累相连，头生一叶，其性微冷。又有竹叶斛，形如竹，节间生叶。又有雀髀斛，茎大如雀之髀，叶在茎头，性皆苦寒，不堪用之。石斛丛生石上，其根纠结，茎叶生皆青翠。干则黄白而软，折之悬挂屋下，时灌以水，经年不死，俗呼为千年润。）"}]},{"ID":"20240616105330-zeju9qi","Type":"NodeParagraph","Properties":{"id":"20240616105330-zeju9qi","updated":"20240616105330"},"Children":[{"Type":"NodeText","Data":"（愚按∶今之石斛，其味皆苦，无有甘者，须知《本经》诸味，皆新出土时味也，干则稍变石斛生于石上，得水长生，是禀水石之专精而补肾。味甘色黄，不假土力，是夺中土之气化而补脾。斛乃量名，主出主入，治伤中者，营运其中土也。除痹者，除皮脉肉筋骨五脏外合之痹证也。夫治伤中则下气，言中气调和，则邪气自下矣。除痹则补五脏虚劳羸瘦，言邪气散除，则正气强盛矣，脾为阴中之至阴，故曰强阴。肾主藏精，故曰益精。久服则土气营运，水精四布，故浓肠胃。"}]},{"ID":"20240616105330-i5zv3p4","Type":"NodeParagraph","Properties":{"id":"20240616105330-i5zv3p4","updated":"20240616105330"},"Children":[{"Type":"NodeText","Data":"《本经》上品，多主除痹，不曰风寒湿，而但曰痹者，乃五脏外合之痹也。盖皮者，肺之合。脉者，心之合。肉者，脾之合。筋者，肝之合。骨者，肾之合。故除痹即所以治五脏之虚劳羸瘦，是攻邪之中而有补益之妙用。治伤中即所以下气，是补益之中而有攻邪之神理云。"}]},{"ID":"20240616105231-lhxpvye","Type":"NodeThematicBreak","Properties":{"id":"20240616105231-lhxpvye"}},{"ID":"20240616105305-q361rr2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105305-q361rr2","updated":"20240616105312"},"Children":[{"Type":"NodeText","Data":"石斛《证类本草》"}]},{"ID":"20240616105305-zhmmptr","Type":"NodeParagraph","Properties":{"id":"20240616105305-zhmmptr","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主伤中，除痹，下气，补五脏，虚劳羸瘦，强阴，益精，补内绝不足，平胃气，长肌肉，逐皮肤邪热痱（音沸）气，脚膝疼冷痹弱。久服浓肠胃，轻身延年，定志除惊。一名林兰，一名禁生，一名杜兰，一名石 （音逐）。生六安山谷水旁石上。七月、八月采茎，阴干。（陆英为之使，恶凝水石、巴豆，畏僵蚕、雷丸。）"}]},{"ID":"20240616105305-5u68dvw","Type":"NodeParagraph","Properties":{"id":"20240616105305-5u68dvw","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今用石斛，出始兴。生石上，细实，桑灰汤沃之，色如金，形似蚱（音窄）"}]},{"ID":"20240616105305-2sscc9v","Type":"NodeParagraph","Properties":{"id":"20240616105305-2sscc9v","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"蜢（音猛）髀者为佳。近道亦有，次宣城间生栎树上者，名木斛。其茎形长大而色浅。六安属庐江，今始安亦出木斛，至虚长，不入丸散，唯可为酒渍、煮汤用尔。俗方最以补虚，疗脚膝。"}]},{"ID":"20240616105305-deprhd9","Type":"NodeParagraph","Properties":{"id":"20240616105305-deprhd9","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"唐本注云∶作干石斛，先以酒洗，捋蒸炙成，不用灰汤。今荆襄及汉中、江左又有二种∶一者似大麦，累累相连，头生一叶而性冷。一种大如雀髀，名雀髀斛，生酒渍服，乃言胜干者。亦如麦斛，叶在茎端，其余斛如竹，节间生叶也。臣禹锡等谨按药性论云∶石斛，君。"}]},{"ID":"20240616105305-tjjifpb","Type":"NodeParagraph","Properties":{"id":"20240616105305-tjjifpb","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"益气除热，主治男子腰肢软弱，健阳，逐皮肌风痹，骨中久冷虚损，补肾，积精，腰痛，养肾气，益力。日华子云∶治虚损劣弱，壮筋骨，暖水脏，轻身益智，平胃气，逐虚邪。"}]},{"ID":"20240616105305-t7li3kk","Type":"NodeParagraph","Properties":{"id":"20240616105305-t7li3kk","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"图经曰∶石斛，生六安山谷水旁石上，今荆、湖、川、广州郡及温、台州亦有之，以广南者为佳。多在山谷中。五月生苗，茎似竹节，节节间出碎叶。七月开花，十月结实，其根细长，黄色。七月、八月采茎。以桑灰汤沃之，色如金，阴干用。或云以酒洗，捋蒸炙成，不用灰汤。其江南生者有二种∶一种似大麦，累累相连，头生一叶，名麦斛。一种大如雀髀，名雀髀斛，唯生石上者胜。亦有生栎木上者，名木斛，不堪用。"}]},{"ID":"20240616105305-y90rxnv","Type":"NodeParagraph","Properties":{"id":"20240616105305-y90rxnv","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，先去头土了，用酒浸一宿，漉出于日中曝干，却用酥蒸，从巳至酉，却徐徐焙干用。石斛锁涎，涩丈夫元气。如斯修事，服满一镒，永无骨痛。"}]},{"ID":"20240616105305-092xhrp","Type":"NodeParagraph","Properties":{"id":"20240616105305-092xhrp","updated":"20240616105305"},"Children":[{"Type":"NodeText","Data":"衍义曰∶石斛，细若小草，长三、四寸，柔韧，折之如肉而实。今人多以木斛浑行，医工亦不能明辨。世又谓之金钗石斛，盖后人取象而言之。然甚不经。将木斛折之，中虚如禾草，长尺余，但色深黄光泽而已。真石斛，治胃中虚热有功。"}]},{"ID":"20240616105231-gt46688","Type":"NodeThematicBreak","Properties":{"id":"20240616105231-gt46688"}},{"ID":"20240616105252-ilnwv32","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105252-ilnwv32","updated":"20240616105256"},"Children":[{"Type":"NodeText","Data":"石斛《本草衍义》"}]},{"ID":"20240616105252-8mag9q9","Type":"NodeParagraph","Properties":{"id":"20240616105252-8mag9q9","updated":"20240616105252"},"Children":[{"Type":"NodeText","Data":"细若小草，长三四寸，柔韧，折之，如肉而实。今人多以木斛浑行，医工亦不能明辨。世又谓之金钗石斛，盖后人取象而言之。然甚不经，将木斛折之，中虚，如禾草，长尺余，但色深黄光泽而已。真石斛治胃中虚热有功。"}]},{"ID":"20240616105231-j3f7y2z","Type":"NodeThematicBreak","Properties":{"id":"20240616105231-j3f7y2z"}},{"ID":"20240616105242-v8ampee","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105242-v8ampee","updated":"20240616105246"},"Children":[{"Type":"NodeText","Data":"石斛《名医别录》"}]},{"ID":"20240616105242-vrz1qa0","Type":"NodeParagraph","Properties":{"id":"20240616105242-vrz1qa0","updated":"20240616105242"},"Children":[{"Type":"NodeText","Data":"无毒．主益精，补内绝不足，平胃气，长肌肉，逐皮肤邪热痱气，脚膝疼冷痹弱．久服定志，除惊．一名禁生，一名杜兰，一名石 ．生六安水傍石上．七月、八月采茎，阴干．（陆英为之使，恶凝水石、巴豆，畏僵蚕、雷丸．）"}]},{"ID":"20240616105242-54kffoc","Type":"NodeParagraph","Properties":{"id":"20240616105242-54kffoc","updated":"20240616105242"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶石斛，味甘，平．主伤中，除痹，下气，补五脏虚劳羸瘦，强阴．久服浓肠胃，轻身延年．"}]},{"ID":"20240616105231-ljr3l68","Type":"NodeThematicBreak","Properties":{"id":"20240616105231-ljr3l68"}},{"ID":"20240616105232-x5elrrz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105232-x5elrrz","updated":"20240616105236"},"Children":[{"Type":"NodeText","Data":"石斛《本草备要》"}]},{"ID":"20240616105232-e3hswtu","Type":"NodeParagraph","Properties":{"id":"20240616105232-e3hswtu","updated":"20240616105232"},"Children":[{"Type":"NodeText","Data":"平补肝肾"}]},{"ID":"20240616105232-6a9cxb1","Type":"NodeParagraph","Properties":{"id":"20240616105232-6a9cxb1","updated":"20240616105232"},"Children":[{"Type":"NodeText","Data":"甘淡入脾，而除虚热，咸平入肾，而涩元气。益精，强阴，暖水脏，平胃气，补虚劳，壮筋骨。"}]},{"ID":"20240616105232-8wlio4i","Type":"NodeParagraph","Properties":{"id":"20240616105232-8wlio4i","updated":"20240616105232"},"Children":[{"Type":"NodeText","Data":"疗风痹脚弱，发热自汗，梦遗滑精，囊涩余沥（雷 曰∶石斛镇髓。昂按∶石斛石生之草，体瘦无汁，味淡难出。置之煎剂，猝难见功，必须熬膏，用之为良）。"}]},{"ID":"20240616105232-2ruqei9","Type":"NodeParagraph","Properties":{"id":"20240616105232-2ruqei9","updated":"20240616105232"},"Children":[{"Type":"NodeText","Data":"光泽如金钗，股短而中实，生石上者良，名金钗石斛。长而虚者名水斛，不堪用。去头、根，酒浸用。恶巴豆。畏僵蚕。细锉水浸，熬膏更良。"}]},{"ID":"20240616105011-bikq62a","Type":"NodeThematicBreak","Properties":{"id":"20240616105011-bikq62a"}},{"ID":"20240616105220-eqlj7dc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105220-eqlj7dc","updated":"20240616105225"},"Children":[{"Type":"NodeText","Data":"石斛《本草经解》"}]},{"ID":"20240616105220-k5iea6f","Type":"NodeParagraph","Properties":{"id":"20240616105220-k5iea6f","updated":"20240616105220"},"Children":[{"Type":"NodeText","Data":"气平．味甘．无毒．主伤中．除痹．下气．补五脏虚劳羸瘦．强阴益精．久服浓肠胃．（酒浸晒）"}]},{"ID":"20240616105220-eykwlhj","Type":"NodeParagraph","Properties":{"id":"20240616105220-eykwlhj","updated":"20240616105220"},"Children":[{"Type":"NodeText","Data":"石斛气平．禀天秋降之金气．入手太阴肺经．味甘无毒．得地中正之土味．入足太阴脾经．甘平为金土之气味．入足阳明胃、手阳明大肠经．气降味和．阴也．阴者中之守也．阴虚则伤中．甘平益阴．故主伤中．痹者闭也．血枯而涩．则麻木而痹．甘平益血．故又除痹．肺主气．肺热则气上．气平清肺．所以下气．五脏藏阴者也．阴虚则五藏俱虚．而不胜作劳．劳则愈伤其真气矣．五脏之阴．脾为之原．脾主肌肉．故五藏虚劳．则肌肉消瘦也．甘平益阴．所以主虚劳而生肌肉也．阴者宗筋也．太阴阳明之所合也．石斛味甘益脾胃．所以强阴．精者阴气之英华也．甘平滋阴．所以益精．肠者手阳明大肠也．胃者足阳明胃也．手足阳明属燥金．燥则肠胃薄矣．久服甘平清润．则阳明不燥．而肠胃浓矣．"}]},{"ID":"20240616105220-gwbaqcj","Type":"NodeParagraph","Properties":{"id":"20240616105220-gwbaqcj","updated":"20240616105220"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616105220-30jqmhe","Type":"NodeParagraph","Properties":{"id":"20240616105220-30jqmhe","updated":"20240616105220"},"Children":[{"Type":"NodeText","Data":"石斛同麦冬、五味、人参、白芍、甘草、杞子、牛膝、杜仲．理伤中．补虚劳．强阴益精．同麦冬、白茯、陈皮、甘草．治胃热四肢软弱．专一味．夏月代茶．健足力．"}]},{"ID":"20240616105146-kb1cvhv","Type":"NodeThematicBreak","Properties":{"id":"20240616105146-kb1cvhv"}},{"ID":"20240616105206-f6wr8mb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105206-f6wr8mb","updated":"20240616105213"},"Children":[{"Type":"NodeText","Data":"石斛《本草纲目》"}]},{"ID":"20240616105206-rysaa6k","Type":"NodeParagraph","Properties":{"id":"20240616105206-rysaa6k","updated":"20240616105206"},"Children":[{"Type":"NodeText","Data":"「释名」石、金钗、禁生、林兰、杜兰。"}]},{"ID":"20240616105206-7vytrmr","Type":"NodeParagraph","Properties":{"id":"20240616105206-7vytrmr","updated":"20240616105206"},"Children":[{"Type":"NodeText","Data":"「气味」甘、平、无毒。"}]},{"ID":"20240616105206-y3r10j9","Type":"NodeParagraph","Properties":{"id":"20240616105206-y3r10j9","updated":"20240616105206"},"Children":[{"Type":"NodeText","Data":"「主治」胃中虚热、发热自汗、痈疽排脓内塞。"}]},{"ID":"20240616105146-0d2kz5o","Type":"NodeThematicBreak","Properties":{"id":"20240616105146-0d2kz5o"}},{"ID":"20240616105157-cbjn3jm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105157-cbjn3jm","updated":"20240616105201"},"Children":[{"Type":"NodeText","Data":"石斛《医学入门》"}]},{"ID":"20240616105157-w5hf7ez","Type":"NodeParagraph","Properties":{"id":"20240616105157-w5hf7ez","updated":"20240616105157"},"Children":[{"Type":"NodeText","Data":"石斛甘平平胃气，皮间热痛多生痱，定惊长肉益精神，内绝虚羸脚膝痹。"}]},{"ID":"20240616105157-96rr64p","Type":"NodeParagraph","Properties":{"id":"20240616105157-96rr64p","updated":"20240616105157"},"Children":[{"Type":"NodeText","Data":"生石上，树有斗子，故名斛。无毒。平胃中虚热，逐皮间邪热痱痛，除惊定志，长肌肉，倍气力，强阴益精，补肾内绝不足，五脏虚劳羸瘦，除脚膝冷痹软痛。酒洗蒸，恶凝水石。巴豆，畏僵蚕、雷丸。"}]},{"ID":"20240616105146-4m8cguh","Type":"NodeThematicBreak","Properties":{"id":"20240616105146-4m8cguh"}},{"ID":"20240616105147-fhyratv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105147-fhyratv","updated":"20240616105152"},"Children":[{"Type":"NodeText","Data":"石斛《神农本草经读》"}]},{"ID":"20240616105147-vqpaoas","Type":"NodeParagraph","Properties":{"id":"20240616105147-vqpaoas","updated":"20240616105147"},"Children":[{"Type":"NodeText","Data":"气味甘、平，无毒。主伤中，除痹，下气，补五脏虚劳羸瘦，强阴益精。久服浓肠胃。"}]},{"ID":"20240616105147-g92gysf","Type":"NodeParagraph","Properties":{"id":"20240616105147-g92gysf","updated":"20240616105147"},"Children":[{"Type":"NodeText","Data":"叶天士曰∶石斛气平入肺，味甘无毒入脾。甘平为金土之气味，入足阳明胃、手阳明大肠。阴者，中之守也；阴虚则伤中，甘平益阴，故主伤中。痹者，脾病也；风、寒、湿三气而脾先受之，石斛甘能补脾，故能除痹。上气，肺病也；火气上逆则为气喘，石斛平能清肺，故能下气。五脏皆属于阴，而脾名至阴，为五脏之主。石斛补脾而荫及五脏，则五脏之虚劳自复，而肌肉之消瘦自生矣。阴者宗筋也；精足则阴自强。精者，阴气之精华也；纳谷多而精自储。肠者，手阳明大肠也；胃者，足阳明胃也；阳明属燥金，久服甘平清润，则阳明不燥，而肠胃浓矣。（《新订》。）张隐庵曰∶石斛生于石上，得水长生，是禀水面之专精而补肾。味甘色黄，不假土力，是夺中土之气化而补脾。斛乃量名，主出主入，能营运中土之气而愈诸病也。"}]},{"ID":"20240616105011-u6hlu8u","Type":"NodeThematicBreak","Properties":{"id":"20240616105011-u6hlu8u"}},{"ID":"20240616105050-0z7id11","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105050-0z7id11","updated":"20240616105055"},"Children":[{"Type":"NodeText","Data":"石斛《千金翼方》"}]},{"ID":"20240616105050-71d6vvv","Type":"NodeParagraph","Properties":{"id":"20240616105050-71d6vvv","updated":"20240616105128"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主伤中，除痹下气，补五脏虚劳，羸瘦，强阴，益精，补内绝平胃气，长肌肉，逐皮肤邪热，痱气，脚膝疼冷痹弱。久服浓肠胃，轻身延年，定志除惊一名林兰，一名禁生，一名杜兰，一名石 。生六安山谷水旁石上，七月八月采茎，阴干。"}]},{"ID":"20240616105012-zd630nu","Type":"NodeThematicBreak","Properties":{"id":"20240616105012-zd630nu"}},{"ID":"20240616105035-h5tdm9q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105035-h5tdm9q","updated":"20240616105041"},"Children":[{"Type":"NodeText","Data":"石斛《滇南本草》"}]},{"ID":"20240616105035-6sxs2u7","Type":"NodeParagraph","Properties":{"id":"20240616105035-6sxs2u7","updated":"20240616105038"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"石斛"},{"Type":"NodeText","Data":"，味甘、淡，性平。升也，阴中之阳也。平胃气，能壮元阳，升托，发散伤寒。"}]},{"ID":"20240616105035-x960bti","Type":"NodeParagraph","Properties":{"id":"20240616105035-x960bti","updated":"20240616105035"},"Children":[{"Type":"NodeText","Data":"（补注）伤寒阳症，传入阴经，半表半里，或表症陷入于里，有升托发汗解表之功。退虚劳发热；截寒热往来，形如疟症；治湿气伤经，故筋骨疼痛；升托，散湿气把住腰膝疼痛，不得屈伸，祛湿散寒，止疼痛。"}]},{"ID":"20240616105035-ezlp56d","Type":"NodeParagraph","Properties":{"id":"20240616105035-ezlp56d","updated":"20240616105035"},"Children":[{"Type":"NodeText","Data":"石斛汤∶昔有一女子，因身染风感寒，平素阴血虚弱，寒邪伏于三阴经，形如劳症。用石斛汤退劳热，反作头疼发热，烦渴饮水，身热如火烙，服后剂，身出酸汗，汗后身凉，又用滋阴降火汤痊愈。"}]},{"ID":"20240616105035-3dt3men","Type":"NodeParagraph","Properties":{"id":"20240616105035-3dt3men","updated":"20240616105035"},"Children":[{"Type":"NodeText","Data":"又石斛汤治虚劳发热，午前乍寒怕冷，午后发热烦渴，头疼体困，饮食无味，自汗盗汗，耳内蝉鸣，头晕心慌，手足酸麻之症，用∶石斛（二钱） 黄柏（五分炒焦） 地骨皮（钱半炙）鳖甲（二钱） 秦艽（一钱） 生地（一钱八分） 薄荷（三分） 点童便煎服。"}]},{"ID":"20240616105035-77aesiz","Type":"NodeParagraph","Properties":{"id":"20240616105035-77aesiz","updated":"20240616105035"},"Children":[{"Type":"NodeText","Data":"（补注）石斛汤治劳热发烧，病反倒重，后二日或三日退热者病好治，服药身凉者轻，服此方身反热者死。"}]},{"ID":"20240616105012-fgg4g71","Type":"NodeThematicBreak","Properties":{"id":"20240616105012-fgg4g71"}},{"ID":"20240616105022-n4ch6er","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105022-n4ch6er","updated":"20240616105029"},"Children":[{"Type":"NodeText","Data":"石斛《本草图经》"}]},{"ID":"20240616105022-0tnsy0n","Type":"NodeParagraph","Properties":{"id":"20240616105022-0tnsy0n","updated":"20240616105026"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"石斛"},{"Type":"NodeText","Data":"，生六安山谷水旁石上，今荆、湖、川、广州郡及温、台州亦有之，以广南者为佳。多在山谷中。五月生苗，茎似竹节，节节间出碎叶；七月开花，十月结实；其根细长，黄色。"}]},{"ID":"20240616105022-4rc4k5v","Type":"NodeParagraph","Properties":{"id":"20240616105022-4rc4k5v","updated":"20240616105022"},"Children":[{"Type":"NodeText","Data":"七月、八月采茎。以桑灰汤沃之，色如金，阴干用。或云以酒洗，捋蒸，炙成，不用灰汤。"}]},{"ID":"20240616105022-hm922eb","Type":"NodeParagraph","Properties":{"id":"20240616105022-hm922eb","updated":"20240616105022"},"Children":[{"Type":"NodeText","Data":"其江南生者有二种∶一种似大麦，累累相连，头生一叶，名麦斛；一种大如雀髀，名雀髀斛，惟生石上者胜。亦有生栎木上者，名木斛，不堪用。"}]},{"ID":"20240616105012-ln5pap7","Type":"NodeThematicBreak","Properties":{"id":"20240616105012-ln5pap7"}},{"ID":"20240616105013-6rh7lb2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616105013-6rh7lb2","updated":"20240616105017"},"Children":[{"Type":"NodeText","Data":"石斛《本草经集注》"}]},{"ID":"20240616105013-jbedlcr","Type":"NodeParagraph","Properties":{"id":"20240616105013-jbedlcr","updated":"20240616105013"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主治伤中，除痹，下气，补五脏虚劳羸瘦，强阴。益精，补内绝不足，平胃气，长肌肉，逐皮肤邪热痱气，脚膝疼冷痹弱。久服浓肠胃，轻身，延年，定志除惊。"}]},{"ID":"20240616105013-p0hy1yr","Type":"NodeParagraph","Properties":{"id":"20240616105013-p0hy1yr","updated":"20240616105013"},"Children":[{"Type":"NodeText","Data":"一名林兰，一名禁生，一名杜兰，一名石KT 。生六安山谷水旁石上。七月、八月采茎，阴干。（陆英为之使。恶凝水石、巴豆，畏僵蚕、雷丸。）"}]},{"ID":"20240616105013-04bifg6","Type":"NodeParagraph","Properties":{"id":"20240616105013-04bifg6","updated":"20240616105013"},"Children":[{"Type":"NodeText","Data":"今用石斛，出始兴。生石上，细实，桑灰汤沃之，色如金，形似蚱蜢髀者为佳。近道亦有，次宣城间。生栎树上者，名木斛。其茎形长大而色浅。六安属庐江，今始安亦出木斛，至虚长，不入丸散，惟可为酒渍煮汤用尔。世方最以补虚，治脚膝。"}]},{"ID":"20240607110940-2kqvhqr","Type":"NodeThematicBreak","Properties":{"id":"20240607110940-2kqvhqr"}},{"ID":"20240607110941-zfk8909","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607110941-zfk8909","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：石斛"}]},{"ID":"20240607110941-rgy950e","Type":"NodeParagraph","Properties":{"id":"20240607110941-rgy950e","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607110941-t3uk2wg","Type":"NodeParagraph","Properties":{"id":"20240607110941-t3uk2wg","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" Shí Hú"}]},{"ID":"20240607110941-kt31867","Type":"NodeParagraph","Properties":{"id":"20240607110941-kt31867","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607110941-n71czrg","Type":"NodeParagraph","Properties":{"id":"20240607110941-n71czrg","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 吊兰[四川]"}]},{"ID":"20240607110941-94vhdgs","Type":"NodeParagraph","Properties":{"id":"20240607110941-94vhdgs","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607110941-h5zbgcb","Type":"NodeParagraph","Properties":{"id":"20240607110941-h5zbgcb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" HERBA DENDROBII"}]},{"ID":"20240607110941-vt9ob6q","Type":"NodeParagraph","Properties":{"id":"20240607110941-vt9ob6q","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607110941-oi6mrze","Type":"NodeParagraph","Properties":{"id":"20240607110941-oi6mrze","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 本品为兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"环草石斛"},{"Type":"NodeText","Data":"Dendrobium loddigesii Rolfe. 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"马鞭石斛"},{"Type":"NodeText","Data":"Dendrobium fimbriatum Hook. var. oculatum Hook . 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄草石斛"},{"Type":"NodeText","Data":"Dendrobium chrysanthum Wall. 、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"铁皮石斛"},{"Type":"NodeText","Data":"Dendrobium candidum Wall. ex Lindl. 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"金钗石斛"},{"Type":"NodeText","Data":"Dendrobium nobile Lindl. 的新鲜或干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎"},{"Type":"NodeText","Data":"。全年均可采收，鲜用者除去根及泥沙；干用者采收后，除去杂质，用开水略烫或烘软，再边搓边烘晒，至叶鞘搓净，干燥。铁皮石斛剪去部分须根后，边炒边扭成螺旋形或弹簧状，烘干，习称“耳环石斛”。"}]},{"ID":"20240607110941-7l4y49q","Type":"NodeParagraph","Properties":{"id":"20240607110941-7l4y49q","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607110941-00429yq","Type":"NodeParagraph","Properties":{"id":"20240607110941-00429yq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 鲜石斛：呈圆柱形或扁圆柱形，长约30cm，直径0.4～1.2cm。表面黄绿色，光滑或有纵纹，节明显，色较深，节上有膜质叶鞘。肉质，多汁，易折断。气微，味微苦而回甜，嚼之有黏性。"}]},{"ID":"20240607110941-fg8pkp6","Type":"NodeParagraph","Properties":{"id":"20240607110941-fg8pkp6","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"环草石斛：呈细长圆柱形，常弯曲或盘绕成团，长15～35cm，直径0.1～0.3cm，节间长1～2cm。表面金黄色，有光泽，具细纵纹。质柔韧而实，断面较平坦。无臭，味淡。"}]},{"ID":"20240607110941-0hwpozw","Type":"NodeParagraph","Properties":{"id":"20240607110941-0hwpozw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"马鞭石斛：呈长圆锥形，长40～120cm，直径0.5～0.8cm，节间长3～4．5cm。表面黄色至暗黄色，有深纵槽。质疏松，断面呈纤维性。味微苦。"}]},{"ID":"20240607110941-sjdcury","Type":"NodeParagraph","Properties":{"id":"20240607110941-sjdcury","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"黄草石斛：长30～80cm，直径0.3～0.5cm，节间长2～3.5cm。表面金黄色至淡黄褐色，具纵沟。体轻，质实，易折断，断面略呈纤维性。嚼之有黏性。"}]},{"ID":"20240607110941-xeuj026","Type":"NodeParagraph","Properties":{"id":"20240607110941-xeuj026","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"耳环石斛：呈螺旋形或弹簧状，一般为2～4个旋纹，茎拉直后长3.5～8cm，直径0.2～0.3cm。表面黄绿色，有细纵皱纹，一端可见茎基部留下的短须根。质坚实，易折断，断面平坦。嚼之有黏性。"}]},{"ID":"20240607110941-vl2vvvw","Type":"NodeParagraph","Properties":{"id":"20240607110941-vl2vvvw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"金钗石斛：呈扁圆柱形，长20～40cm，直径0.4～0.6cm，节间长2.5～3cm。表面金黄色或黄中带绿色，有深纵沟。质硬而脆，断面较平坦。味苦。"}]},{"ID":"20240607110941-4nj29sd","Type":"NodeParagraph","Properties":{"id":"20240607110941-4nj29sd","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607110941-3h90rkg","Type":"NodeParagraph","Properties":{"id":"20240607110941-3h90rkg","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 干品置通风干燥处，防潮；鲜品置阴凉潮湿处，防冻。"}]},{"ID":"20240607110941-awucutu","Type":"NodeParagraph","Properties":{"id":"20240607110941-awucutu","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607110941-q31a6xt","Type":"NodeParagraph","Properties":{"id":"20240607110941-q31a6xt","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 干品除去残根，洗净，切段，干燥。"}]},{"ID":"20240607110941-hhva1e0","Type":"NodeParagraph","Properties":{"id":"20240607110941-hhva1e0","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607110941-lto4xff","Type":"NodeParagraph","Properties":{"id":"20240607110941-lto4xff","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 本品横切面：环草石斛、黄草石斛 表皮细胞1 列，扁平，外被鲜黄色角质层。基本薄壁组织细胞大小近似，有壁孔，散在多数外韧型维管束，略排成3～4圈。维管束外侧纤维群新月形或半圆形，其外缘薄壁细胞，有的含类圆形硅质块，木质部有1～3个导管较大。含草酸钙针晶细胞多见于维管束旁。"}]},{"ID":"20240607110941-0e7y8gm","Type":"NodeParagraph","Properties":{"id":"20240607110941-0e7y8gm","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"马鞭石斛 表皮细胞扁圆形，外壁及侧壁增厚，木化，有层纹。"}]},{"ID":"20240607110941-m01h51x","Type":"NodeParagraph","Properties":{"id":"20240607110941-m01h51x","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"耳环石斛 木质部导管大小近似。含草酸钙针晶束细胞多见于近表皮处。"}]},{"ID":"20240607110941-94figx5","Type":"NodeParagraph","Properties":{"id":"20240607110941-94figx5","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"金钗石斛 基本薄壁组织细胞大小较悬殊。维管束略排成7～8圈。"}]},{"ID":"20240607110941-668p438","Type":"NodeParagraph","Properties":{"id":"20240607110941-668p438","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607110941-78qoaim","Type":"NodeParagraph","Properties":{"id":"20240607110941-78qoaim","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 归胃、肾经。"}]},{"ID":"20240607110941-c13ex2b","Type":"NodeParagraph","Properties":{"id":"20240607110941-c13ex2b","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607110941-gqkh3qs","Type":"NodeParagraph","Properties":{"id":"20240607110941-gqkh3qs","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 甘，微寒。"}]},{"ID":"20240607110941-eldsb5u","Type":"NodeParagraph","Properties":{"id":"20240607110941-eldsb5u","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607110941-js9dqvb","Type":"NodeParagraph","Properties":{"id":"20240607110941-js9dqvb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 益胃生津，滋阴清热。用于阴伤津亏，口干烦渴，食少干呕，病后虚热，目暗不明。"}]},{"ID":"20240607110941-dnz9cta","Type":"NodeParagraph","Properties":{"id":"20240607110941-dnz9cta","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607110941-fqxm73f","Type":"NodeParagraph","Properties":{"id":"20240607110941-fqxm73f","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 6～12g，鲜品15～30g。入复方宜先煎，单用可久煎。"}]},{"ID":"20240607110941-f70elio","Type":"NodeParagraph","Properties":{"id":"20240607110941-f70elio","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607110941-3v0sabk","Type":"NodeParagraph","Properties":{"id":"20240607110941-3v0sabk","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607110941-eppv5in","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607110941-eppv5in","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：石斛"}]},{"ID":"20240607110941-6vo8pi7","Type":"NodeParagraph","Properties":{"id":"20240607110941-6vo8pi7","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607110941-829p594","Type":"NodeParagraph","Properties":{"id":"20240607110941-829p594","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" Shí Hú"}]},{"ID":"20240607110941-filvqf3","Type":"NodeParagraph","Properties":{"id":"20240607110941-filvqf3","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607110941-0q8i4vd","Type":"NodeParagraph","Properties":{"id":"20240607110941-0q8i4vd","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 林兰、禁生（《本经》），杜兰、石蓫（《别录》），金钗花、千年润（《纲目》），黄草（《药物出产辨》），吊兰花（《中国药植志》）。"}]},{"ID":"20240607110941-zusgjxy","Type":"NodeParagraph","Properties":{"id":"20240607110941-zusgjxy","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607110941-ezptfgx","Type":"NodeParagraph","Properties":{"id":"20240607110941-ezptfgx","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607110941-t8w3ypr","Type":"NodeParagraph","Properties":{"id":"20240607110941-t8w3ypr","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607110941-imv0kfe","Type":"NodeParagraph","Properties":{"id":"20240607110941-imv0kfe","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 为兰科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"金钗石斛"},{"Type":"NodeText","Data":"或其多种同属植物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎"},{"Type":"NodeText","Data":"。全年均可采挖，但以秋后采挖者质量好。采回后如保存鲜用时，在春、秋季则应及时栽培于细砂石中，放置阴湿处，经常浇水使根部保持湿润。在冬天应平放于竹筐内，上盖蒲包，但应注意空气流通。干石斛一般系将鲜石斛剪去须根，洗净，晒干或烘干；在广西地区先用开水烫过，趁热边搓边晒（或烘）至全郎干燥为止。耳环石斛：加工时，拣长约4厘米的鲜石斛，修去部分须根，洗净，晾干，然后放入铁锅内，均匀炒至柔软，趁热搓去薄膜状叶鞘，放置略通风处，两天后置于有细眼的铅皮盘内，下面用适当的微火，在离盘约一尺处，微微加温，用手使之弯成螺旋形或弹簧状，再晾干，如此反复进行2～3次，至干燥为止。"}]},{"ID":"20240607110941-g8bu8b4","Type":"NodeParagraph","Properties":{"id":"20240607110941-g8bu8b4","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607110941-1l523qb","Type":"NodeParagraph","Properties":{"id":"20240607110941-1l523qb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" ①金钗石斛（《本草衍义》）"}]},{"ID":"20240607110941-0v8pez9","Type":"NodeParagraph","Properties":{"id":"20240607110941-0v8pez9","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"多年生附生草本，高30～50厘米。茎丛生，直立，直径1～1.3厘米，黄绿色，多节，节间长2.5～3.5厘米。叶无柄，近革质，常3～5片生于茎的上端；叶片长圆形或长圆状披针形，长6～12厘米，宽1.5～2.5厘米，先端钝，有偏斜状的凹缺，叶脉平行，通常9条，叶鞘紧抱于节间，长1.5～2.7厘米。总状花序自茎节生出，通常具花2～3朵；苞片膜质，小，卵形；花甚大，下垂，直径6～8厘米；花萼及花瓣白色，末端呈淡红色；萼片3，中萼片离生，两侧萼片斜生于蕊柱足上，几相等，长圆形，长3.5～4.5厘米，宽1.2～1.5厘米，先端急尖或钝形；花瓣卵状长圆形或椭圆形，与萼片几等长，宽2.1～2.5厘米，唇瓣生于蕊柱足的前方，近圆卵形，长4～4.5厘米，宽3～3.5厘米，先端圆形，基部有短爪，下半部向上反卷包围蕊柱，两面被茸毛，近基部的中央有一块深紫色的斑点；合蕊柱高6～7毫米，连足部长约12毫米；雄蕊呈圆锥状，花药2室，长约3毫米，花粉块4，蜡质。蒴果。花期5～6月。"}]},{"ID":"20240607110941-9ev6wo9","Type":"NodeParagraph","Properties":{"id":"20240607110941-9ev6wo9","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"附生于高山岩石或森林中的树干上。分布四川、贵州、云南、湖北、广西、台湾等地。此外，各地尚有栽培。"}]},{"ID":"20240607110941-n1vhbk1","Type":"NodeParagraph","Properties":{"id":"20240607110941-n1vhbk1","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②长爪石斛"}]},{"ID":"20240607110941-vcde4wp","Type":"NodeParagraph","Properties":{"id":"20240607110941-vcde4wp","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"与上种近似，主要区别为本种茎的节间膝曲或明显地加粗，因此全形稍呈连珠状；花淡紫色。"}]},{"ID":"20240607110941-dthlmj1","Type":"NodeParagraph","Properties":{"id":"20240607110941-dthlmj1","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布广西、广东、台湾等地。"}]},{"ID":"20240607110941-614wiyc","Type":"NodeParagraph","Properties":{"id":"20240607110941-614wiyc","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"③铁皮石斛，又名：霍山石斛。"}]},{"ID":"20240607110941-4w5w9vo","Type":"NodeParagraph","Properties":{"id":"20240607110941-4w5w9vo","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎丛生，直立，高5～30厘米，径约5毫米，圆柱形，基部稍细，绿色并带紫色；多节，节间长1～2厘米。叶少数，生于茎上部，无柄；叶片近卵形、卵状长圆形或近长圆形，长5～7厘米，宽1.5～2厘米，先端急尖而有偏斜状的凹缺，带革质；叶鞘膜质，紧抱节间，灰色，似不清洁状，干后深灰色。总状花序生于无叶茎的上部节上，长达6厘米，花2～5朵；苞片钻状，长5毫米左右；花淡黄绿色，草黄色或淡黄色，直径3.5～4厘米；萼片3，长约19毫米，中央萼片长圆状披针形，两侧萼片长圆状三角形，基部稍向前伸和蕊柱足连生成极短的蕊柱跟；侧生花瓣长圆形，与萼片几等长，唇瓣长圆状卵形，长约15毫米，宽约9毫米，先端急尖，中央具许多紫色或褐紫色斑点，两边反卷包围蕊柱；合蕊柱高3～3.5毫米，连足部长约10毫米；雄蕊卵形，白色，有四棱，花粉块4，稍黄色。蒴果长圆形，长约2.5厘米，有三棱。"}]},{"ID":"20240607110941-c2599j5","Type":"NodeParagraph","Properties":{"id":"20240607110941-c2599j5","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布安徽、浙江、陕西、山西、河南、福建、广东、广西、云南、贵州等地。"}]},{"ID":"20240607110941-te9oce0","Type":"NodeParagraph","Properties":{"id":"20240607110941-te9oce0","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"④细茎石斛，又名：铜皮石斛，细黄草。"}]},{"ID":"20240607110941-q26l3qu","Type":"NodeParagraph","Properties":{"id":"20240607110941-q26l3qu","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"与铁皮石斛很相似。茎高10～20厘米。叶长圆状披针形，长2.5～4厘米，宽7～10毫米，先端钝；叶鞘非灰色不清洁状。总状花序具花2～4朵；花淡黄绿色，直径约2厘米；中央萼片线状披针形，两侧萼片稍带镰刀形；唇瓣黄绿色，中央有1褐色的斑点。"}]},{"ID":"20240607110941-4oroln2","Type":"NodeParagraph","Properties":{"id":"20240607110941-4oroln2","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布浙江、安徽、广西、云南等地；"}]},{"ID":"20240607110941-imgc93p","Type":"NodeParagraph","Properties":{"id":"20240607110941-imgc93p","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑤重唇石斛"}]},{"ID":"20240607110941-akk5jzw","Type":"NodeParagraph","Properties":{"id":"20240607110941-akk5jzw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎直立，高25～50厘米。节间长2.5～3.5厘米；叶鞘紧抱节间，几与节间等长。总状花序生花1～3朵，下垂；花淡紫堇色，直径2～3厘米；萼片近卵形，侧生一对较中央一片稍狭，并略呈镰刀形；花瓣长圆形，唇瓣比两侧花瓣短，下陷呈短舟形，内被柔毛，先端有一突尖；合蕊柱很短，前方被长柔毛；花药深紫色。"}]},{"ID":"20240607110941-ggso41r","Type":"NodeParagraph","Properties":{"id":"20240607110941-ggso41r","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布广西、广东等地。"}]},{"ID":"20240607110941-ymbji2o","Type":"NodeParagraph","Properties":{"id":"20240607110941-ymbji2o","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑥钩状石斛"}]},{"ID":"20240607110941-rtrssjl","Type":"NodeParagraph","Properties":{"id":"20240607110941-rtrssjl","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎直立，较细，高达60厘米。叶互生；无柄；线状披针形至披针形，长7～8厘米，宽15～20毫米，先端渐尖。总状花序较短，生花1～6朵；花白色，径2.5～3厘米；中央萼片卵形，长20毫米，宽6毫米，先端锐尖，侧生一对稍偏斜，蕊柱跟短囊状；花瓣长圆形，长18毫米，先端锐尖，唇瓣广卵形，长12毫米，3浅裂，急尖而先端有凹头；合蕊柱前方被毛；花丝细，花药有乳状突起。"}]},{"ID":"20240607110941-zs111lb","Type":"NodeParagraph","Properties":{"id":"20240607110941-zs111lb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布福建、广东等地。"}]},{"ID":"20240607110941-tsbyuen","Type":"NodeParagraph","Properties":{"id":"20240607110941-tsbyuen","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑦广东石斛，又名：铜皮兰。"}]},{"ID":"20240607110941-5gsm8hs","Type":"NodeParagraph","Properties":{"id":"20240607110941-5gsm8hs","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎直立，圆柱形，细瘦，高15～30厘米。叶线状长圆形，长3～5厘米，宽8～12毫米，先端钝或急尖，有偏斜状凹缺。花白色，开后经日即变黄色，有香气，直径约7厘米，通常1～2朵生于茎的上部；中央1片花萼长圆状披针形，侧生1对萼片披针形；花瓣椭圆状长圆形，唇瓣狭卵形，基部有鲜绿色斑点；合蕊柱短；雄蕊近圆形，具有乳状突起。"}]},{"ID":"20240607110941-d30nwm9","Type":"NodeParagraph","Properties":{"id":"20240607110941-d30nwm9","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布广西、广东等地。"}]},{"ID":"20240607110941-6599vam","Type":"NodeParagraph","Properties":{"id":"20240607110941-6599vam","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑧细叶石斛"}]},{"ID":"20240607110941-cvrsw7r","Type":"NodeParagraph","Properties":{"id":"20240607110941-cvrsw7r","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎直立，细，高15～30厘米，直径3～6毫米，节间长约2.5厘米，有的节上生出细小的分枝。叶天柄；线形，长4～8厘米，宽4～6毫米，先端钝，有偏斜的微凹缺。总状花序腋生，生花1～2朵；花黄色下垂；苞片卵状；总花梗长8～12毫米；萼片与花瓣几同形，长圆形；唇瓣3浅裂，基部有1短阔的爪；合蕊柱高4～4.5毫米。花期7月。"}]},{"ID":"20240607110941-grhis4z","Type":"NodeParagraph","Properties":{"id":"20240607110941-grhis4z","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"生于高山。分布广西、云南、四川等地。"}]},{"ID":"20240607110941-cthnjg2","Type":"NodeParagraph","Properties":{"id":"20240607110941-cthnjg2","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑨罗河石斛，又名：小黄草。"}]},{"ID":"20240607110941-3ki5mtp","Type":"NodeParagraph","Properties":{"id":"20240607110941-3ki5mtp","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎直立，圆柱形，细皮，高25～27厘米，节间长1.3～2.3厘米。叶鞘膜质，管状，抱茎；叶长圆形，长3.5～6厘米，宽1～1.5厘米，两端均尖。花黄色，数朵单生于无叶的茎的上部；中央萼片椭圆形，两侧萼片斜椭圆形；花瓣椭圆形，唇瓣倒卵形，铺平时长2厘米，宽1.7厘米，有肉质乳突状突起，前缘有不规则锯齿；合蕊柱高3.5毫米，蕊柱足长7毫米。花期6月。"}]},{"ID":"20240607110941-70djrpd","Type":"NodeParagraph","Properties":{"id":"20240607110941-70djrpd","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"附生于山谷的岩石上。分布广西。"}]},{"ID":"20240607110941-d178koe","Type":"NodeParagraph","Properties":{"id":"20240607110941-d178koe","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑩美花石斛"}]},{"ID":"20240607110941-6t0pm2h","Type":"NodeParagraph","Properties":{"id":"20240607110941-6t0pm2h","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎圆柱形，高10～15厘米，直径5～7毫米，基部略细。叶无柄，长圆状披针形，长4～6厘米，宽1.2～1.8厘米。花单生；淡粉红色；苞片小；中央萼片长圆状披针形，两侧萼片近筒形，蕊柱跟囊状；花瓣椭圆形，唇瓣3浅裂，先端微凹或近圆形，边缘流苏状，中央被毛；合蕊柱极短。"}]},{"ID":"20240607110941-zl57o73","Type":"NodeParagraph","Properties":{"id":"20240607110941-zl57o73","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布广东、广西、云南等地。"}]},{"ID":"20240607110941-a1rgpyn","Type":"NodeParagraph","Properties":{"id":"20240607110941-a1rgpyn","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑾小美石斛，又名：矮石斛、黑节草。"}]},{"ID":"20240607110941-i19vl6y","Type":"NodeParagraph","Properties":{"id":"20240607110941-i19vl6y","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"茎呈假鳞茎状，纺锤形，高4～7.5厘米，中间直径约1.5厘米，通常3节，外被黑色长硬毛。叶2～4枚，长圆形或椭圆次长圆形，长2～5厘米，宽1～1.8厘米，先端急尖，具偏斜的微凹头。总状花序生于有叶的茎上；花白色，1～3朵，总花梗长1.8～2厘米；中央萼片椭圆状长圆形，两侧萼片近三角形，蕊柱跟广囊状；花瓣卵状长圆形，唇瓣3裂，中央裂片倒心形，两侧裂片近圆形；合蕊柱高5～6毫米。"}]},{"ID":"20240607110941-2r65u5q","Type":"NodeParagraph","Properties":{"id":"20240607110941-2r65u5q","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"分布云南。"}]},{"ID":"20240607110941-bcrkc9p","Type":"NodeParagraph","Properties":{"id":"20240607110941-bcrkc9p","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607110941-9snrulz","Type":"NodeParagraph","Properties":{"id":"20240607110941-9snrulz","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 本品因品种及加工方法不同，通常分为金钗石斛、黄草石斛、小黄草石斛、耳环石斛及鲜石斛等效种。"}]},{"ID":"20240607110941-7ujsowd","Type":"NodeParagraph","Properties":{"id":"20240607110941-7ujsowd","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"①金钗石斛"}]},{"ID":"20240607110941-p4tfouz","Type":"NodeParagraph","Properties":{"id":"20240607110941-p4tfouz","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"为植物金钗石斛的加工品。干燥茎长约20～45厘米，直径约1～1.5厘米，基部为圆柱形，中部及上部为扁圆柱形，茎节微向左右弯曲，表面金黄色而微带绿色，有光泽，具纵沟纹，节明显，棕色，有时节部稍膨大，节间长约2.5～3厘米，向上渐短。体轻而质致密，易折断，断面类白色，散布有深色的小点。气无，味苦，嚼之带粘性。以身长、色金黄、质致密、有光泽者为佳。"}]},{"ID":"20240607110941-rje5481","Type":"NodeParagraph","Properties":{"id":"20240607110941-rje5481","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②黄草石斛"}]},{"ID":"20240607110941-2jru32l","Type":"NodeParagraph","Properties":{"id":"20240607110941-2jru32l","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"为铁皮石斛、罗河石斛、广东石斛、细茎石斛等的加工品。干燥茎长一般在30厘米以上，直径约3～5毫米，圆柱形，略弯曲，表面金黄色而略带绿色，有光泽，具深纵沟纹，节明显，节间长约2～3.5厘米。横切的厚片断面类圆形，边缘有多数角棱，形成齿轮状，中间散布有类白色小点。气无，味微苦，嚼之略带粘性。以条匀、金黄色、致密者为佳。"}]},{"ID":"20240607110941-z9x169b","Type":"NodeParagraph","Properties":{"id":"20240607110941-z9x169b","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"③小黄草石斛"}]},{"ID":"20240607110941-hz4dp59","Type":"NodeParagraph","Properties":{"id":"20240607110941-hz4dp59","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"为美花石斛、罗河石斛、细叶石斛的加工品。干燥茎长一般在30厘米以下，直径约2～2毫米，多弯曲盘绕成团，表面有细密纵纹理，金黄色而略带绿色，有光泽，节间长约1～1.5厘米，断面类圆形，略带粉性。以卷曲、节密、金黄色、富粉质，嚼之有甘凉味、粘性足者为佳。"}]},{"ID":"20240607110941-qsazpdv","Type":"NodeParagraph","Properties":{"id":"20240607110941-qsazpdv","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"④耳环石斛"}]},{"ID":"20240607110941-e0b8ri8","Type":"NodeParagraph","Properties":{"id":"20240607110941-e0b8ri8","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"又名：枫斗。为石斛属多种植物的茎经特殊加工制成。㈠西枫斗，干燥茎扭曲呈螺旋形或弹簧形；一般可见有1～4个旋纹，长约1～1.5厦米，直径约3毫米，一端可见茎基及残留的短须根，称龙头，另一端为茎的尖端，称\"凤尾\"，表面黄绿色，有细纵纹理，节明显或有时不明显。气无；味淡。以条粗肥、旋纹少、有头吊、富粉质者为佳。又以所用原料不同又可分为铁皮枫斗（铁皮石斛制成）、铜皮枫斗（细茎石斛制成）、云南枫斗（小美石斛制成）等。㈡圆枫斗，用铁皮、细茎、小美等石斛长于8厘米的茎而不适宜加工成西枫斗者，将其剪成5厘米左右的长度，在微火上烘干，同时扭卷成圆形，如钟表发条状。㈢结子斗，用铁皮石斛的茎节剪断，烘干时打成纽结状。商品枫斗还有直条枫斗、葫芦斗、生川斗、广霍斗等等规格名称。"}]},{"ID":"20240607110941-0s848wy","Type":"NodeParagraph","Properties":{"id":"20240607110941-0s848wy","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑤鲜石斛"}]},{"ID":"20240607110941-y39nst1","Type":"NodeParagraph","Properties":{"id":"20240607110941-y39nst1","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"金钗型的鲜石斛茎呈稍扁的圆柱形，基部较细，直径约1～1.5厘米，表面黄绿色，光滑，有纵棱，节明显，节上有棕黄色的环，节基部包围有灰色膜质的叶鞘，长度约占节间的1／2。"}]},{"ID":"20240607110941-09itgra","Type":"NodeParagraph","Properties":{"id":"20240607110941-09itgra","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"黄草型的鲜石斛茎呈圆柱形，肉肥厚。常见的有：㈠铁皮石斛：外皮黑绿色，茎较短壮，粗细均匀，节略弯曲；叶片瓜子形，质厚，叶鞘紧包于节间。嚼之有浓厚粘性，味淡。品质好。㈡细茎石斛：外皮黄绿色，茎较瘦长，叶亦较长，质薄，叶鞘易剥离，节直。嚼之粘性较薄，味淡。品质较差。㈢爪兰石斛：外皮绿色，茎粗细不均匀，常两端细，中间粗，叶较长。嚼之有苦味。品质略次。鲜石斛均以青绿色或黄绿色、肥满多汁、嚼之发粘者为佳。"}]},{"ID":"20240607110941-cebewuj","Type":"NodeParagraph","Properties":{"id":"20240607110941-cebewuj","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"以上各种石斛，主产四川、贵州、广西、广东、云南、湖北。此外，安徽、湖南、江西、福建、浙江、陕西、河南等地亦产。"}]},{"ID":"20240607110941-dppf760","Type":"NodeParagraph","Properties":{"id":"20240607110941-dppf760","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607110941-zvf6ufj","Type":"NodeParagraph","Properties":{"id":"20240607110941-zvf6ufj","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 干品置通风干燥处，防潮；鲜品置阴凉潮湿处，防冻。"}]},{"ID":"20240607110941-6x7xzli","Type":"NodeParagraph","Properties":{"id":"20240607110941-6x7xzli","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607110941-h18up1t","Type":"NodeParagraph","Properties":{"id":"20240607110941-h18up1t","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 金钗石斛含石斛碱、石斛胺、石斛次碱、石斛星碱、石斛因碱、6-羟石斛星碱，尚含粘液质、淀粉。细茎石斛含石斛碱、石斛胺及N-甲基石斛碱（季铵盐）。罗河石斛含石斛宁碱。"}]},{"ID":"20240607110941-tabs69v","Type":"NodeParagraph","Properties":{"id":"20240607110941-tabs69v","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607110941-4cjufl2","Type":"NodeParagraph","Properties":{"id":"20240607110941-4cjufl2","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 干石斛：取干燥的石斛，用水泡约至八成透，焖润，除去残根及黑枝，切段，撞去薄膜，晒干。鲜石斛：临用时剪下，搓去膜质叶鞘，洗净，剪段。"}]},{"ID":"20240607110941-fcjkh8f","Type":"NodeParagraph","Properties":{"id":"20240607110941-fcjkh8f","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使石斛，先去头土了，酒浸一宿，漉出，于日中曝干，却用酥蒸，从巳至酉，徐徐焙干用。\""}]},{"ID":"20240607110941-k26pkke","Type":"NodeParagraph","Properties":{"id":"20240607110941-k26pkke","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607110941-acrqwmq","Type":"NodeParagraph","Properties":{"id":"20240607110941-acrqwmq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 入胃、肺，肾经。"}]},{"ID":"20240607110941-0is9e62","Type":"NodeParagraph","Properties":{"id":"20240607110941-0is9e62","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"足太阴脾、足少阴右肾。\""}]},{"ID":"20240607110941-2uxzg81","Type":"NodeParagraph","Properties":{"id":"20240607110941-2uxzg81","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入胃、肾二经。\""}]},{"ID":"20240607110941-ep8lrb0","Type":"NodeParagraph","Properties":{"id":"20240607110941-ep8lrb0","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足阳明、少阴，亦入手少阴。\""}]},{"ID":"20240607110941-s9xyimb","Type":"NodeParagraph","Properties":{"id":"20240607110941-s9xyimb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"入肺、肾、胃三经。\""}]},{"ID":"20240607110941-6898w7w","Type":"NodeParagraph","Properties":{"id":"20240607110941-6898w7w","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607110941-4bngffe","Type":"NodeParagraph","Properties":{"id":"20240607110941-4bngffe","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 甘淡微咸，寒。"}]},{"ID":"20240607110941-i7o3yvi","Type":"NodeParagraph","Properties":{"id":"20240607110941-i7o3yvi","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240607110941-74l8pmn","Type":"NodeParagraph","Properties":{"id":"20240607110941-74l8pmn","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"扁鹊：酸。李当之：寒。\""}]},{"ID":"20240607110941-h9gbf5w","Type":"NodeParagraph","Properties":{"id":"20240607110941-h9gbf5w","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"无毒。\""}]},{"ID":"20240607110941-fn9quo7","Type":"NodeParagraph","Properties":{"id":"20240607110941-fn9quo7","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"性平，味甘淡。\""}]},{"ID":"20240607110941-j9uwvkr","Type":"NodeParagraph","Properties":{"id":"20240607110941-j9uwvkr","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"甘淡微咸。\""}]},{"ID":"20240607110941-louikzw","Type":"NodeParagraph","Properties":{"id":"20240607110941-louikzw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑥《药品化义》：\"味苦，性凉。\""}]},{"ID":"20240607110941-wzlg1qa","Type":"NodeParagraph","Properties":{"id":"20240607110941-wzlg1qa","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607110941-k5f87lj","Type":"NodeParagraph","Properties":{"id":"20240607110941-k5f87lj","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"陆英为之使。恶凝水石、巴豆。畏僵蚕、雷丸。\""}]},{"ID":"20240607110941-soir3qp","Type":"NodeParagraph","Properties":{"id":"20240607110941-soir3qp","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②《百草镜》：\"惟胃肾有虚热者宜之，虚而无火者忌用。\""}]},{"ID":"20240607110941-5qnhuv9","Type":"NodeParagraph","Properties":{"id":"20240607110941-5qnhuv9","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607110941-bwn6uci","Type":"NodeParagraph","Properties":{"id":"20240607110941-bwn6uci","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 生津益胃，清热养阴。治热病伤津，口干烦渴，病后虚热，阴伤目暗。"}]},{"ID":"20240607110941-fs5qu7f","Type":"NodeParagraph","Properties":{"id":"20240607110941-fs5qu7f","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤中，除痹，下气，补五脏虚劳羸瘦，强阴，久服厚肠胃。\""}]},{"ID":"20240607110941-u6gmaiq","Type":"NodeParagraph","Properties":{"id":"20240607110941-u6gmaiq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"益精，补内绝不足，平胃气，长肌肉，逐皮肤邪热疿气，脚膝疼冷痹弱，定志除惊。\""}]},{"ID":"20240607110941-g85nio1","Type":"NodeParagraph","Properties":{"id":"20240607110941-g85nio1","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"③《僧深集方》：\"囊湿精少，小便余沥者，宜加之。\""}]},{"ID":"20240607110941-x2e7vdg","Type":"NodeParagraph","Properties":{"id":"20240607110941-x2e7vdg","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"益气除热。主治男子腰脚软弱，健阳，逐皮肌风痹，骨中久冷，虚损，补肾积精，腰痛，养肾气，益力。\""}]},{"ID":"20240607110941-xknihzm","Type":"NodeParagraph","Properties":{"id":"20240607110941-xknihzm","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"治虚损劣弱，壮筋骨，暖水脏，益智，平胃气，逐虚邪。\""}]},{"ID":"20240607110941-unsa3o3","Type":"NodeParagraph","Properties":{"id":"20240607110941-unsa3o3","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑥《本草衍义》：\"治胃中虚热。\""}]},{"ID":"20240607110941-hufd0bi","Type":"NodeParagraph","Properties":{"id":"20240607110941-hufd0bi","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"治发热自汗，痈疽排脓内塞。\""}]},{"ID":"20240607110941-2e6kyjr","Type":"NodeParagraph","Properties":{"id":"20240607110941-2e6kyjr","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑧《药品化义》：\"治肺气久虚，咳嗽不止。\""}]},{"ID":"20240607110941-dpmub8t","Type":"NodeParagraph","Properties":{"id":"20240607110941-dpmub8t","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑨《本草备要》：\"疗梦遗滑精。\""}]},{"ID":"20240607110941-zehsc0o","Type":"NodeParagraph","Properties":{"id":"20240607110941-zehsc0o","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑩《纲目拾遗》：\"清胃除虚热，生津，已劳损，以之代茶，开胃健脾。定惊疗风，能镇涎痰，解暑，甘芳降气。\""}]},{"ID":"20240607110941-tnvuws0","Type":"NodeParagraph","Properties":{"id":"20240607110941-tnvuws0","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"⑾《本草再新》：\"理胃气，清胃火，除心中烦渴，疗肾经虚热，安神定惊，解盗汗，能散暑。\""}]},{"ID":"20240607110941-n2noxfm","Type":"NodeParagraph","Properties":{"id":"20240607110941-n2noxfm","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607110941-x5100gx","Type":"NodeParagraph","Properties":{"id":"20240607110941-x5100gx","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤（须久煎），2～4钱（鲜者0.5～1两）；熬膏或入丸、散。"}]},{"ID":"20240607110941-fanwies","Type":"NodeParagraph","Properties":{"id":"20240607110941-fanwies","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607110941-un8mv6l","Type":"NodeParagraph","Properties":{"id":"20240607110941-un8mv6l","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" ①治温热有汗，风热化火，热病伤津，温疟舌苔变黑：鲜石斛三钱，连翘（去心）三钱，天花粉二钱，鲜生地四钱，麦冬（去心）四钱，参叶八分。水煎服。（《时病论》清热保津法）"}]},{"ID":"20240607110941-4cc3ykn","Type":"NodeParagraph","Properties":{"id":"20240607110941-4cc3ykn","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"②治中消：鲜石斛五钱，熟石膏四钱，天花粉三钱，南沙参四钱，麦冬二钱，玉竹四钱，山药三钱，茯苓三钱，广皮一钱，半夏一钱五分。甘蔗三两，煎汤代水。（《医醇腆义》祛烦养胃汤）"}]},{"ID":"20240607110941-2dv85el","Type":"NodeParagraph","Properties":{"id":"20240607110941-2dv85el","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"③治眼目昼视精明，暮夜昏暗，视不见物，名曰雀目：石斛、仙灵脾各一两，苍术（米泔浸，切，焙）半两。上三味，捣罗为散，每服三钱匕，空心米饮调服，日再。（《圣济总录》石斛散）"}]},{"ID":"20240607110941-uitjxae","Type":"NodeParagraph","Properties":{"id":"20240607110941-uitjxae","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"④治神水宽大渐散，昏如雾露中行，渐睹空中有黑花，渐睹物成二体，久则光不收，及内障神水淡绿色、淡白色者：天门冬（焙）、人参、茯苓各二两，五味（炒）半两，兔丝子（酒浸）七钱，干菊花七钱，麦门冬一两，熟地黄一两，杏仁七钱半，干山药、枸杞各七钱，牛膝七钱半，生地黄一两，蒺藜、石斛、苁蓉、川芎、炙草、枳壳（麸炒），青葙子、防风、黄连各五钱，草决明八钱，乌犀角半两，羚羊角半两。为细末，炼蜜丸，桐子大。每服三、五十丸，温酒、盐汤任下。（《原机启微》石斛夜光丸）"}]},{"ID":"20240607110941-8htwup1","Type":"NodeParagraph","Properties":{"id":"20240607110941-8htwup1","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607110941-2nbtp5n","Type":"NodeParagraph","Properties":{"id":"20240607110941-2nbtp5n","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607110941-u4vdnvg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607110941-u4vdnvg","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"《中华本草》：石斛"}]},{"ID":"20240607110941-mz7bbpy","Type":"NodeParagraph","Properties":{"id":"20240607110941-mz7bbpy","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607110941-bh7ia6n","Type":"NodeParagraph","Properties":{"id":"20240607110941-bh7ia6n","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" Shí Hú"}]},{"ID":"20240607110941-18fkmpa","Type":"NodeParagraph","Properties":{"id":"20240607110941-18fkmpa","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607110941-agh1slv","Type":"NodeParagraph","Properties":{"id":"20240607110941-agh1slv","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 林兰、禁生、杜兰、石蓫、悬竹、千年竹"}]},{"ID":"20240607110941-ao8sban","Type":"NodeParagraph","Properties":{"id":"20240607110941-ao8sban","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607110941-drp2b87","Type":"NodeParagraph","Properties":{"id":"20240607110941-drp2b87","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" stem of Noble Dendrobium,stem of White Dendrobium,Stem of Moniliform Dendrobium,stem of Doublelip Dendrobium,Stem of Hooked Dendrobium,Stem of Hancock Dendrobium,Stem of Willson Dendrobium,stem of Loh"}]},{"ID":"20240607110941-u7dlh2k","Type":"NodeParagraph","Properties":{"id":"20240607110941-u7dlh2k","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607110941-gmzvgkb","Type":"NodeParagraph","Properties":{"id":"20240607110941-gmzvgkb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 出自1.《本经》。"}]},{"ID":"20240607110941-ot90jk7","Type":"NodeParagraph","Properties":{"id":"20240607110941-ot90jk7","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：作干石斛，先以酒洗捋蒸炙成，不用灰汤。今荆、襄及汉中、江左又有二种，一者似大麦累累相连，头生一叶而性冷（名麦斛）。一种大如雀髀，名雀髀斛，生酒渍服，乃言胜干者，亦如麦斛，叶在茎端。其余斛如竹，节间生叶也。"}]},{"ID":"20240607110941-ese0qau","Type":"NodeParagraph","Properties":{"id":"20240607110941-ese0qau","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：石斛，细若小草，长三、四寸，柔韧，折之如肉而实。今人多以木斛浑行，医工亦不能辨。世又谓之金钗石斛，盖后人取象而言之，然甚不经。将"}]},{"ID":"20240607110941-6vg2coq","Type":"NodeParagraph","Properties":{"id":"20240607110941-6vg2coq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607110941-0ef0pge","Type":"NodeParagraph","Properties":{"id":"20240607110941-0ef0pge","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 药材基源：为兰科植物金钗石斛、美花石斛、铁皮石斛、束花石斛、马鞭石斛的茎。"}]},{"ID":"20240607110941-k196jjp","Type":"NodeParagraph","Properties":{"id":"20240607110941-k196jjp","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Dendrobium nobile Lindl.2.Dendrobium loddigesii Rolfe3.Dendrobium candidum Wall.ex Lindl.[D.officinalis Kimura et Migo]4.Dendrobium chrysanthum Wall.ex Lindl.5.Dendrobium fimbriatum Hook.var.oculatum Hook.."}]},{"ID":"20240607110941-2t88gm6","Type":"NodeParagraph","Properties":{"id":"20240607110941-2t88gm6","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后2-3年即可采收，生长年限愈长，茎数愈多，单产愈高。一年四季均可收割。新收之石斛，鲜用者，除去须根及杂质，另行保存。干用者，去根洗净，搓去薄膜状叶鞘，晒干或烘干；也可先将石斛置开水中略烫，再晒干或烘干，即为干石斛。此外，铁皮石斛等少数品种之嫩茎，还可进行特殊加工，即以长8cm左右的石斛茎洗净晾干，用文火均匀炒至柔软，搓去叶鞘，趁热将茎扭成螺旋状或弹簧状，反复数次，最后晒干，商品称为耳环石斛，又名枫斗。"}]},{"ID":"20240607110941-jlgp0nk","Type":"NodeParagraph","Properties":{"id":"20240607110941-jlgp0nk","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607110941-a75pkxn","Type":"NodeParagraph","Properties":{"id":"20240607110941-a75pkxn","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.金钗石斛附生于高山岩石或林中树干上。"}]},{"ID":"20240607110941-sz6ckx8","Type":"NodeParagraph","Properties":{"id":"20240607110941-sz6ckx8","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.美花石斛附生于树上或林下岩石上。"}]},{"ID":"20240607110941-i9wsmlt","Type":"NodeParagraph","Properties":{"id":"20240607110941-i9wsmlt","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.铁皮石斛附生于树上。"}]},{"ID":"20240607110941-nnh9q4m","Type":"NodeParagraph","Properties":{"id":"20240607110941-nnh9q4m","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"4.束花石斛附生于树上和岩石上。"}]},{"ID":"20240607110941-evehdmi","Type":"NodeParagraph","Properties":{"id":"20240607110941-evehdmi","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"5.马鞭石斛附生于树上或山谷岩石上。"}]},{"ID":"20240607110941-unv230k","Type":"NodeParagraph","Properties":{"id":"20240607110941-unv230k","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"资源分布：1.金钗石斛分布于台湾、湖北、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240607110941-ox7z3i7","Type":"NodeParagraph","Properties":{"id":"20240607110941-ox7z3i7","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.美花石斛分布于广东、广西、贵州、云南等地。"}]},{"ID":"20240607110941-8i2wqze","Type":"NodeParagraph","Properties":{"id":"20240607110941-8i2wqze","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.铁皮石斛分布于广西、云南、贵州等地。"}]},{"ID":"20240607110941-btoexwa","Type":"NodeParagraph","Properties":{"id":"20240607110941-btoexwa","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"4.束花石斛分布于广西、贵州、云南、西藏等地。"}]},{"ID":"20240607110941-wvqa4jg","Type":"NodeParagraph","Properties":{"id":"20240607110941-wvqa4jg","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"5.马鞭石斛分布广西、云南等地。"}]},{"ID":"20240607110941-fqrffla","Type":"NodeParagraph","Properties":{"id":"20240607110941-fqrffla","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607110941-uz496nr","Type":"NodeParagraph","Properties":{"id":"20240607110941-uz496nr","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 1.金钗石斛，多年生附生草本。茎丛生，直立，高30-50cm。直径1-1.3cm，黄绿色，多节，节间长2.5-3.5cm。叶近革质，常3-5枚生于茎上端；叶片长圆形或长圆状披针形，长6-12cm，宽1.5-2.5cm，先端2圆裂，叶脉平行，通常9条，叶鞘紧抱于节间，长1.5-2.7cm。无叶柄。总状花序自茎节生出，通常具2-3花；苞片卵形，小，膜质，花大，下垂，直径6-8cm；花萼及花瓣白色，末端呈淡红色；萼片3，中萼片离生，两侧萼片斜生于蕊柱足上，长圆形，长3.5-4.5cm，宽1.2-1.5cm；花瓣卵状长圆形或椭圆形，与萼片几等长，宽2.1-2.5cm，唇瓣近圆卵形，生于蕊柱足的前方，长4-4.5cm，宽3-3.5cm，先端圆，基部有短爪，下半部向上反卷包围蕊柱，两面被茸毛，近基部的中央有一块深紫色的斑点；合蕊柱高6-7mm，连足部长约12mm；雄蕊呈圆锥状，花药2室，花药块4，蜡质。蒴果。花期5-6月。"}]},{"ID":"20240607110941-cbhjix8","Type":"NodeParagraph","Properties":{"id":"20240607110941-cbhjix8","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.美花石斛，多年生附生草本。茎圆柱形，高10-45cm，直径2-7mm，基部略细。叶纸质，长圆状披针形或舌形，长4-6cm，宽1.2-1.8cm，先端锐尖而略钩转；无柄；叶鞘松抱于茎，鞘口张开。花单生，淡玫瑰色；苞片小；中萼片卵状长圆形，长1.7-1.9cm，宽约6mm，先端钝，侧萼片比中萼片长，但较窄，先端锐尖；萼囊短，钝；花瓣椭圆形，较宽，等长于中萼片，先端钝，边缘多少有齿；唇瓣近圆形，唇盘凹陷，被短柔毛，3条线纹从基部直达先端，边缘流苏状；合蕊柱短。花期4-5月。"}]},{"ID":"20240607110941-3mqwg8a","Type":"NodeParagraph","Properties":{"id":"20240607110941-3mqwg8a","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.铁皮石斛，多年生附生草本，茎丛生，圆柱形，高达35cm，粗2-4mm。上部茎节上有时生根，长出新植株，干后呈青灰色。叶纸质，长圆状披针形，长4-7cm，宽1-1.5cm，先端略钩转，边缘和中脉淡紫色；叶鞘具紫斑，鞘口张开，常与叶留下一个环状间隙。总状花序常生于无叶的茎上端，长2-4cm，回折状弯曲，常具3花；总花梗长约1cm；苞片干膜质，淡白色，长5-7mm；花被片黄绿色，长约1.8cm；中萼片和花瓣相似，长圆状披针形，宽约4mm，先端锐尖，侧萼片镰状三角形，基部宽约1cm，先端急尖；萼囊明显；唇瓣卵状披针形，反折，比萼片略短，不裂或不明显3裂，基部边缘内卷并具1个胼胝体，先端急尖，边缘波状；唇盘被乳突状毛，具紫红色斑点。"}]},{"ID":"20240607110941-6nh93xc","Type":"NodeParagraph","Properties":{"id":"20240607110941-6nh93xc","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"4.束花石斛，多年生附生草全。茎圆柱形，高50-200cm，粗5-15mm。上部略弯曲，节间长3-4cm。叶薄纸质，披针形或长圆状披针形，先端渐尖；叶鞘膜质，干后常具鳞粃状斑点；鞘口张开呈杯状。花期无叶；伞形花序近无总梗，具2-4（-6）朵花；花苞片小，膜质；花黄色，略肉质；中萼片长圆形，长1.5-1.8，宽约1cm，先端钝；侧萼片近镰形，比中萼片略长；萼囊短圆锥形；花瓣倒卵状长圆形，明显比萼片宽，近先端边缘常具齿；唇瓣横长圆形，两面密被绒毛，唇盘上表面具2个血紫色圆形斑块，2条褶片从基部到达近中部，边缘具短流苏。花期5-9月。"}]},{"ID":"20240607110941-10wf797","Type":"NodeParagraph","Properties":{"id":"20240607110941-10wf797","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"5.马鞭石斛，多年生附生草本。茎直立，近圆柱形，有时基部上方呈纺锤形，向上逐渐变细，通常高60cm左右，粗2-20mm，表面具槽。叶两列，近于水平伸展，长圆形或椭圆形，长8-15.5cm，宽2-3.6cm，先端锐尖。花期无叶；总状花序下垂，长约15cm，常具花6-12朵；花序轴较细，略呈“之”字形；总苞片鞘状，膜质，长约5mm；花苞片小，长约3mm；花黄色；萼片长圆形，等长于萼片，具短爪，唇盘上表面密被短柔毛，近基部有一个肾形紫色斑块，边缘具复流苏，花期4-5月。"}]},{"ID":"20240607110941-xagpa48","Type":"NodeParagraph","Properties":{"id":"20240607110941-xagpa48","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607110941-xv42dtq","Type":"NodeParagraph","Properties":{"id":"20240607110941-xv42dtq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候和半阴半阳的环境，不耐寒。"}]},{"ID":"20240607110941-fw8ee1m","Type":"NodeParagraph","Properties":{"id":"20240607110941-fw8ee1m","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"栽培技术 用无性繁殖或试管苗快速繁殖。无性繁殖有分株、扦插育苗和腋芽繁殖。目前以分株繁殖为主。在3月下旬至4月上旬石斛发芽前栽种较好。选生长健壮、根系发达、萌蘖多、无病虫的一年或二年生植株作种，连根挖出，视茎数多少分为若干丛，采用贴树栽种方法，将株从根部用竹钉或竹篾固定在树干上，再用牛粪泥浆抹根部及周围树皮皱纹中。若在岩石上栽培，则选阴湿树林生有苔藓的砂页岩，种在凹处或石缝里。试管苗快速繁殖，可用种子或茎节进行无菌培养。将未开裂蒴果或茎节，经表面灭菌后，在无菌条件下，播种或接种到1/2MS努森培养基中，置26±1℃，加光培养。快速繁殖研究已初见成效。"}]},{"ID":"20240607110941-iirrqzr","Type":"NodeParagraph","Properties":{"id":"20240607110941-iirrqzr","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"田间管理 栽种后从第2年起开始追肥，每年2次，4月和11月，用牛粪、肥泥和磷肥调匀，薄薄地敷在石斛根际周围。种植于岩石上者，应注意拔除杂草，种于树上者，要修去过密的树枝，使透光度适当。"}]},{"ID":"20240607110941-bxbrc1c","Type":"NodeParagraph","Properties":{"id":"20240607110941-bxbrc1c","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"病虫害防治 叶斑病，初夏时在嫩叶上发生，用1：1：50波尔多液或50%多菌灵1000倍液喷雾。蜗牛类，包括东风螺及小蜗牛，使用五氯酚钠或灭螺净喷杀。"}]},{"ID":"20240607110941-mc8yjtv","Type":"NodeParagraph","Properties":{"id":"20240607110941-mc8yjtv","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607110941-i1uthwm","Type":"NodeParagraph","Properties":{"id":"20240607110941-i1uthwm","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）金钗石斛 茎中、下部扁圆柱形，向上稍“之”字形弯曲，长18-42cm，中部直径0.4-1cm，节间长1.5-6cm。表面金黄色或绿黄色，有光泽，具深纵沟及纵纹，节稍膨大，棕色，常残留灰褐色叶鞘。质轻而脆，断面较疏松。气微，味苦。"}]},{"ID":"20240607110941-j41bnxl","Type":"NodeParagraph","Properties":{"id":"20240607110941-j41bnxl","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（2）环草石斛①美花石斛：茎细长圆柱形，常弯曲，盘绕成团或捆成把，长11-40cm，直径1-3mm，节间长0.4-2.3cm。表面金黄色，有光泽，具细纵纹。质柔韧而实，断面较平坦。气无，味较苦，有粘性。②铁皮石斛：叶鞘常短于节间，留有环状间隙，味淡或微苦。"}]},{"ID":"20240607110941-n4uv08e","Type":"NodeParagraph","Properties":{"id":"20240607110941-n4uv08e","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（3）黄草石斛 茎细长圆柱形，中、上部不规则弯曲，长23-120cm，直径2-5mm，节间长2-3.5cm。表面金黄色或棕黄色，有纵纹，体质轻实，易折断，断面略纤维性。气微，味微苦，嚼之有粘性。"}]},{"ID":"20240607110941-qnlvgw9","Type":"NodeParagraph","Properties":{"id":"20240607110941-qnlvgw9","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（4）马鞭石斛 茎细长圆锥形，上部有少数分枝，长30-150cm，直径2-8mm，节间长2-4.5cm。表面棕黄色，有8-9条纵沟。质疏松，断面纤维性。气微，味微苦。商品常切成1.5-3cm长段，切面灰白色。"}]},{"ID":"20240607110941-m4fpcld","Type":"NodeParagraph","Properties":{"id":"20240607110941-m4fpcld","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（5）耳环石斛 茎经加工呈螺旋弹簧状，习称“西枫斗”，一般2-4个旋纹，拉直后长3.5-8cm，直径1.5-3mm，节间长1-3.5cm。有的呈纽结状或扭卷成圆形，习称“结子斗”或“圆枫斗”，表面黄绿色黄色。有细纵纹，有的一端可见茎基部留下的短须根。质坚实，易折断，断面平坦。嚼之有粘性，无渣，味甘。"}]},{"ID":"20240607110941-n36d0t2","Type":"NodeParagraph","Properties":{"id":"20240607110941-n36d0t2","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（6）鲜石斛 茎圆柱形或扁圆柱形，长约30cm，直径0.4-1.2cm。表面黄绿色，光滑或有纵纹，节明显，色较深，节上有膜质叶鞘。肉质，多汁，易折断。气微，味微苦而回甜。嚼之有粘性。"}]},{"ID":"20240607110941-88ojvt4","Type":"NodeParagraph","Properties":{"id":"20240607110941-88ojvt4","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"干石斛均以色金黄、有光泽、质柔韧者为佳。耳环石斛以色黄绿、饱满、结实者为佳。鲜石斛以色黄绿、肥满多汁、嚼之发粘者为佳。"}]},{"ID":"20240607110941-e9l1cja","Type":"NodeParagraph","Properties":{"id":"20240607110941-e9l1cja","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：（1）金钗石斛 表皮细胞扁平，角质层厚，橙黄色。皮下层细胞2-3列，壁薄，角隅微木化。中柱维管束多数，略排成7-8圈。有限外韧型维管束外侧纤维群有1-4列纤维，壁甚厚，外缘嵌有细小薄壁细胞，有的含类圆形硅质块；木质部导管有1-4个较大，内侧无纤维或有1-2列纤维。粘液细胞少数，内含草酸钙针晶束，长50-130μm。"}]},{"ID":"20240607110941-k7ix9o3","Type":"NodeParagraph","Properties":{"id":"20240607110941-k7ix9o3","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（2）环草石斛 维管束略排成3-4个圈，维管束外侧纤维群有2-5列纤维；木质部导管有1-2个较大。含针晶束细胞多见于维管束旁，针晶束长50-74μm。"}]},{"ID":"20240607110941-5w692bj","Type":"NodeParagraph","Properties":{"id":"20240607110941-5w692bj","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（3）黄草石斛 维管束略排成5-6个圈，维管束外侧纤维群有1-6列纤维；硅质块较多；木质部导管有1-3个较大。含针晶束细胞多见于维管束旁，针晶束长47-83μm。"}]},{"ID":"20240607110941-k9kr4kq","Type":"NodeParagraph","Properties":{"id":"20240607110941-k9kr4kq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（4）马鞭石斛 表皮细胞扁圆形，外壁及侧壁增厚，木化，层纹明显。皮下层纤维3-4列。维管束略排成6-7圈。维管束外侧纤维群有2-8列纤维，硅质块较多；木质部导管有1-4个较大。"}]},{"ID":"20240607110941-w81dn12","Type":"NodeParagraph","Properties":{"id":"20240607110941-w81dn12","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"（5）耳环石斛 维管束略排成4-5圈。维管束外侧纤维群有1-4列纤维；木质部导管大小近似。含针晶束细胞多见近表皮处，针晶束长60-108μm。"}]},{"ID":"20240607110941-4vle5ga","Type":"NodeParagraph","Properties":{"id":"20240607110941-4vle5ga","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"粉末特征：金钗石斛茎 灰绿色。①束鞘纤维多成束或散离，微木化，纹孔稀少，纤维束周围含硅质块细胞排成纵行。②草酸钙针晶束存在于薄壁细胞中，完整者长约至170μm。③表皮细胞表面观呈长多角形，垂周壁连珠状增厚，角质层表面有网状裂纹。④木纤维多成束，纹孔较多，可见细小具缘纹孔的薄壁细胞。"}]},{"ID":"20240607110941-3j1fgkt","Type":"NodeParagraph","Properties":{"id":"20240607110941-3j1fgkt","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607110941-isrop15","Type":"NodeParagraph","Properties":{"id":"20240607110941-isrop15","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 对血压和呼吸也有抑制作用，中毒剂量可引起惊厥。"}]},{"ID":"20240607110941-qxxkiil","Type":"NodeParagraph","Properties":{"id":"20240607110941-qxxkiil","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607110941-yj3mmim","Type":"NodeParagraph","Properties":{"id":"20240607110941-yj3mmim","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 1.金钗石斛 茎含生物碱0.3%，已分离得到：石斛碱(dendrobine)，石斛酮碱(nobilonine)，6-羟基石斛碱(6-hydroxydendrobine)又名石斛胺(dendramine)，石斛醚碱(dendroxine)，6-羟基石斛醚碱(6-hydroxydendroxine)，4-羟基石斛醚碱(4-hydroxydendroxine)，石斛酯碱（dendrine），3-羟基-2-氧-石斛碱（3-hydroxy-2-oxydendrobine）等。另据报道，还分离得到（部位不明）5种季铵生物碱：N-甲基石斛季铵碱(N-methyldendrobinium)，N-异戊烯基石斛季铵醚碱(N-isopentenyldendrobinium)，石斛碱N-氧化物（dendrobine N-oxide），N-异戊烯基-6-羟基石斛醚季铵碱(N-isopentenyl-6-hydroxydendroxinium)。茎还含亚甲基金钗石斛素（nobilomethylene），金钗石斛菲醌（denbinobin），β-谷甾醇（β-sitosterol），胡罗卜甙（daucosterol）。"}]},{"ID":"20240607110941-4trboml","Type":"NodeParagraph","Properties":{"id":"20240607110941-4trboml","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.美花石斛 茎含石斛宁碱(shihunine)，石斛宁定碱(shihunidin)，石斛酚（dendrophenol）等生物碱。"}]},{"ID":"20240607110941-7tvxtu3","Type":"NodeParagraph","Properties":{"id":"20240607110941-7tvxtu3","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.束花石斛 含古豆碱（hygrine），顺式和反式的束花石斛碱（dendrochrysine）等生物碱。"}]},{"ID":"20240607110941-tobl09s","Type":"NodeParagraph","Properties":{"id":"20240607110941-tobl09s","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"4.马鞭石斛 茎含对羟-基-顺式桂皮酸（cis-p-hydroxycinnamic acid）的和对羟基反式桂皮酸（trans-p-hydroxycinnamic acid）的二十四醇酯、二十五醇酯、二十六醇酯、二十七醇酯、二十八醇酯、二十九醇酯、三十醇酯、三十一醇酯、三十二醇酯、三十三醇酯及三十四醇酯共18个成分以及豆甾醇类和β-谷甾醇类成分各1个。"}]},{"ID":"20240607110941-a42ksp0","Type":"NodeParagraph","Properties":{"id":"20240607110941-a42ksp0","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"此外，罗河石斛含石斛宁碱；钩状石斛含钩状石斛素(aduncin)；玫瑰石斛含玫瑰石斛定碱（crepidine），玫瑰石斛胺（crepidamine），玫瑰石斛碱（dendrocrepine），过去曾分离得到的异玫瑰石斛碱（isodendrocrepine）和异玫瑰石斛胺（isocrepidamine）实际是在提取离析过程中得到的人工制品；密花石斛全草含密花石斛甙（densifloroside），密花石斛芴三酚（dendroflorin），密花石斛芴二酚（dengibsin），补骨脂素（psoralen），东莨菪素甲醚（scopoletin methylether），齐墩果酸（oleanolic-acid），β-谷甾醇。"}]},{"ID":"20240607110941-dcfwrbi","Type":"NodeParagraph","Properties":{"id":"20240607110941-dcfwrbi","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607110941-e9wt1sz","Type":"NodeParagraph","Properties":{"id":"20240607110941-e9wt1sz","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 1.解热作用：金钗石斛流浸膏对人工发热之家兔无解热作用。石斛碱则有一定的止痛退热作用，与非那西汀相似而较弱。"}]},{"ID":"20240607110941-9mhp55w","Type":"NodeParagraph","Properties":{"id":"20240607110941-9mhp55w","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.对离体肠管活动的影响：2.1.对豚鼠离体肠管活动的影响：取鲜药材捣碎，加70%乙醇（鲜药材1g加4ml）室温冷浸15天，过滤减压回收乙醇至小体积，浸膏用蒸馏水配成每1ml相当于鲜药材4g，置冰箱中备用。取体重300-400g的健康豚鼠，雌雄不限，截取回肠，每段约3cm，用DC-001型离体器官测定仪记录肠管活动（加药后记录30分钟以上），浴槽中的台氏液量显30ml，加温恒定为38±0.5℃，每项实验3-8只豚鼠，肠管6-16段。实验结果表明，当浓度为2.5%时，金钗石斛、细叶石斛、重唇石斛能兴奋肠管；罗珂石斛对肠管活动的影响不明显；铁皮石斛、流苏石斛、细茎石斛、黑毛石斛、迭鞘石斛先使肠管抑制，几分钟后恢复到给药前水平；钩状石斛使肠管收缩幅度稍降低，束花石斛明显地抑制肠管的活动。"}]},{"ID":"20240607110941-k49dqaq","Type":"NodeParagraph","Properties":{"id":"20240607110941-k49dqaq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.2.金钗石斛流浸膏对离体兔肠低浓度时兴奋，高浓度则有抑制作用。"}]},{"ID":"20240607110941-h8lp6e5","Type":"NodeParagraph","Properties":{"id":"20240607110941-h8lp6e5","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.3.石斛浸膏对家兔肠管小剂量兴奋，大剂量呈抑制作用。"}]},{"ID":"20240607110941-ldkrkvd","Type":"NodeParagraph","Properties":{"id":"20240607110941-ldkrkvd","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.4.石斛碱对离体兔肠有抑制作用。"}]},{"ID":"20240607110941-9xchu2w","Type":"NodeParagraph","Properties":{"id":"20240607110941-9xchu2w","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.对小鼠胃肠推进运动的影响：药液Ⅰ：取阿拉伯胶1g，溶于2ml蒸馏水中，搅拌成糊状，加入活性炭0.5g，搅匀，加生理盐水稀释至10ml，搅匀。药液Ⅱ：配法同药液Ⅰ，以金钗石斛浸膏（配制同前）代替生理盐水。药液Ⅲ：配法同药液Ⅰ，以束花石斛浸膏（配制同前）代替生盐水。取18-22g健康小鼠30只，雌雄各半，随机分成3组；第一组以药液Ⅰ作对照，第二组给药液Ⅱ，第三组给药液Ⅲ；按0.4ml／20g体重灌胃给药，30分钟时将小鼠处死，立即剖腹，将消化道自幽门直至直肠末端完整摘出，不加牵引，平铺于木尺上测其全长，并记录炭末的前沿到幽门的距离，计算其与肠道全长的百分比，取全组平均值进行比较，束花石斛可明显抑制胃肠推进运动；石斛对胃肠推进运动无明显的影响。"}]},{"ID":"20240607110941-7boresa","Type":"NodeParagraph","Properties":{"id":"20240607110941-7boresa","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"4.对腹腔巨噬细胞作用：金钗石斛水煎剂给小鼠灌胃6天，可提高其腹腔巨噬细胞对鸡红细胞的吞噬能力。"}]},{"ID":"20240607110941-88hgoxk","Type":"NodeParagraph","Properties":{"id":"20240607110941-88hgoxk","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"5.对心血管系统的作用：金钗石斛流浸膏对离体蟾蜍心脏则不论浓度高低均为抑制。蟾蜍下肢血管灌流时无明显作用。石斛碱有升高血糖、降低血压、减弱心脏收缩力。"}]},{"ID":"20240607110941-pfq5cup","Type":"NodeParagraph","Properties":{"id":"20240607110941-pfq5cup","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"6.对病原微生物的作用：用组织培养作筛选试验，证明金钗石斛煎剂对孤儿病毒（ECHO11）所致的细胞病变有延缓作用。"}]},{"ID":"20240607110941-h1q3ul5","Type":"NodeParagraph","Properties":{"id":"20240607110941-h1q3ul5","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"7.其他作用：石斛碱有抑制呼吸的作用，大剂量可致惊厥，安密妥纳可以对抗解毒；而对离体豚鼠子宫可使之收缩。"}]},{"ID":"20240607110941-mdhitwi","Type":"NodeParagraph","Properties":{"id":"20240607110941-mdhitwi","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607110941-qz3fnol","Type":"NodeParagraph","Properties":{"id":"20240607110941-qz3fnol","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 1.干石斛：取干燥的石斛，用水泡约至八成透，焖润，除去残根及黑枝，切段，撞去薄膜，晒干。"}]},{"ID":"20240607110941-wbegmhb","Type":"NodeParagraph","Properties":{"id":"20240607110941-wbegmhb","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.鲜石斛：临用时剪下，搓去膜质叶鞘，洗净，剪段。"}]},{"ID":"20240607110941-1zef2a6","Type":"NodeParagraph","Properties":{"id":"20240607110941-1zef2a6","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.《雷公炮炙论》：凡使石斛，先去头土了，酒浸一宿，漉出，于日中曝干，却用酥蒸，从巳至酉，徐徐焙干用。"}]},{"ID":"20240607110941-fsf1oi6","Type":"NodeParagraph","Properties":{"id":"20240607110941-fsf1oi6","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607110941-nhsqbqw","Type":"NodeParagraph","Properties":{"id":"20240607110941-nhsqbqw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 薄层色谱：取本品粗粉置于三角瓶中，加少量浓氨水润湿，加氯仿提取，提取液浓缩后供点样，以石斛碱对照品，分别于硅胶G薄板上，氯仿-甲醇（10：0.8）展开（氨蒸气饱和），改良碘化铋钾显色，样品色谱在与对照品色谱相对应位置处，显相同的橘红色斑点。"}]},{"ID":"20240607110941-taapxdo","Type":"NodeParagraph","Properties":{"id":"20240607110941-taapxdo","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607110941-41xcnpv","Type":"NodeParagraph","Properties":{"id":"20240607110941-41xcnpv","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 胃；肺；肾经"}]},{"ID":"20240607110941-xj5ggkx","Type":"NodeParagraph","Properties":{"id":"20240607110941-xj5ggkx","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607110941-fa02oeu","Type":"NodeParagraph","Properties":{"id":"20240607110941-fa02oeu","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 甘；微寒"}]},{"ID":"20240607110941-4au0fw2","Type":"NodeParagraph","Properties":{"id":"20240607110941-4au0fw2","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607110941-lxh2ovw","Type":"NodeParagraph","Properties":{"id":"20240607110941-lxh2ovw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 温热病早期阴未伤者、湿温病未化燥者、脾胃虚寒者均禁服。"}]},{"ID":"20240607110941-qxbou15","Type":"NodeParagraph","Properties":{"id":"20240607110941-qxbou15","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607110941-am04mut","Type":"NodeParagraph","Properties":{"id":"20240607110941-am04mut","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 生津益胃；滋阴清热；润肺益肾；明目强腰。主热病伤津；口干烦渴；胃阴不足；胃痛干呕；肺燥干咳；虚热不退；阴伤目暗；腰膝软弱"}]},{"ID":"20240607110941-xi91hxx","Type":"NodeParagraph","Properties":{"id":"20240607110941-xi91hxx","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607110941-49js1hw","Type":"NodeParagraph","Properties":{"id":"20240607110941-49js1hw","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤6-15g，鲜品加倍；或入丸、散；或熬膏。鲜石斛清热生津力强，热津伤者宜之；干石斛用于胃虚夹热伤阴者为宜。"}]},{"ID":"20240607110941-7wm5fcu","Type":"NodeParagraph","Properties":{"id":"20240607110941-7wm5fcu","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607110941-5sycbxf","Type":"NodeParagraph","Properties":{"id":"20240607110941-5sycbxf","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 石斛散《圣济总录》：养阴明目；夜盲症。石斛夜光丸《原机启微》：视物不清。祛烦养胃汤《医醇鰧义》：中消。清热保津法方《时病论》：温热有汗。"}]},{"ID":"20240607110941-up38cia","Type":"NodeParagraph","Properties":{"id":"20240607110941-up38cia","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607110941-ij1bjno","Type":"NodeParagraph","Properties":{"id":"20240607110941-ij1bjno","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 1.《本草通玄》：石斛，甘可悦脾，咸能益肾，故多功于水土二脏。但气性宽缓，无捷奏之功，古人以此代茶，甚清膈上。"}]},{"ID":"20240607110941-pueux0f","Type":"NodeParagraph","Properties":{"id":"20240607110941-pueux0f","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"2.《本草正》：石斛有二种，力皆微薄，圆细而肉实者，味微而甘淡，其力尤薄。《本草》云圆细者为上，且谓其益精强阴，壮筋补虚，健脚膝，驱冷痹，却惊悸，定心志。但此物性味最薄，焉能滋补如此cao惟是扁大而松、形如钗股者，颇有苦味，用除脾胃之火，去？杂善饥及营中蕴热，其性轻清和缓，有从容分解之妙，故能退火、养阴、除烦、清肺下气，亦止消渴热汗。而诸家谓其厚肠胃、健阳道、暖水脏，岂苦凉之性味所能也？不可不辨。"}]},{"ID":"20240607110941-6k90bhj","Type":"NodeParagraph","Properties":{"id":"20240607110941-6k90bhj","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"3.《药品化义》：石斛气味轻清，合肺之性，性凉而清，得肺之宜。肺为娇脏，独此最为相配。主治肺气久虚，咳嗽不止，邪热痱子，肌表虚热。其清理之功，不特于此，盖肺出气，肾纳气，子母相生，使肺气清则真气旺，顺气下行，以生肾水，强阴益精。且上焦之势，能令肺气委曲下行，无苦寒沉下之弊。"}]},{"ID":"20240607110941-pfylc1i","Type":"NodeParagraph","Properties":{"id":"20240607110941-pfylc1i","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：石斛，入脾而除虚热，入肾而涩元气。但形瘦无汁，味淡难出，非经久熬，气味莫泄，故止可入平剂以治虚热。补性虽有，亦惟在人谅病轻重施用可耳。"}]},{"ID":"20240607110941-dbk0k2z","Type":"NodeParagraph","Properties":{"id":"20240607110941-dbk0k2z","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"5.《本草思辨录》：石斛，为肾药、为肺药、为肠胃药。《本经》强阴二字，足赅全量。所谓阴者，非寒亦非温，用于温而温者寒，用于寒而寒者温。《别录》逐皮肤邪热痱气，是温者寒也；疗脚膝疼冷痹弱，是寒者温也，要不出《本经》除痹、补虚二端。大凡证之恰合乎斛者，必两收除痹、补虚之益，若专以之除痹，专以之补虚，则当弃短取长，而制剂之有道可矣。"}]},{"ID":"20240607110941-75y3fsd","Type":"NodeParagraph","Properties":{"id":"20240607110941-75y3fsd","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"6.徐究仁：石斛功能清胃生津，胃肾虚热者最宜。夫肺胃为温邪必犯之地，热郁灼津，胃液本易被劫。如欲清胃救津，自非用石斛之甘滋轻灵不为功。然有不可徒恃石斛为治者，若温邪延久，伤及下焦，劫灼真阴，则鞠通吴氏有三甲复脉、大小定风珠等法，原为挽救真阴而设，石斛未免嫌其轻浮耳。盖真阴非气液之谓，救真阴者宜浓厚，救气液者宜清淡，苟以浓厚救气液，则转滋转燥，而固邪愈深，以清淡救真阴，则杯水车薪，势必不济。抑有不可滥用石斛者，如湿温尚未化燥，每见口燥欲漱，苔腻皮干，理宜辛淡之法，若误用石斛，则舌苔立转黑燥，湿遏热蒸，渐入昏谵者有之，是又不可不谛审者也。"}]},{"ID":"20240607110941-xuh7a9n","Type":"NodeParagraph","Properties":{"id":"20240607110941-xuh7a9n","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607110941-9u1veeq","Type":"NodeParagraph","Properties":{"id":"20240607110941-9u1veeq","updated":"20240607110941"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607110943-nz7sw9e","Type":"NodeThematicBreak","Properties":{"id":"20240607110943-nz7sw9e"}},{"ID":"20240607110944-khgooq1","Type":"NodeParagraph","Properties":{"id":"20240607110944-khgooq1"}}]}