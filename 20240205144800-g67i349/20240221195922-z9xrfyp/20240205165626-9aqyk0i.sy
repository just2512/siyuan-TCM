eOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山药 34-20240731190034-plnur50.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 372px;\" parent-style=\"width: 382px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731165914-vj1tq87","Type":"NodeParagraph","Properties":{"id":"20240731165914-vj1tq87","updated":"20240731175828"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：据说山药分公母，长豆的就是公山药，长风铃的就是母山药（较少见），公山药笔直一根（营养自给自足），母山药有横根，会分叉出很多根（营养都供给子根）；"}]},{"ID":"20240616100128-nhyjd9a","Type":"NodeThematicBreak","Properties":{"id":"20240616100128-nhyjd9a"}},{"ID":"20240616100209-tg96ysc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616100209-tg96ysc","updated":"20240616100214"},"Children":[{"Type":"NodeText","Data":"署豫《神农本草经》"}]},{"ID":"20240616100209-t0spaaj","Type":"NodeParagraph","Properties":{"id":"20240616100209-t0spaaj","updated":"20240616100209"},"Children":[{"Type":"NodeText","Data":"（旧作薯蓣，《御览》作署豫是）"}]},{"ID":"20240616100209-bfy8utw","Type":"NodeParagraph","Properties":{"id":"20240616100209-bfy8utw","updated":"20240616100209"},"Children":[{"Type":"NodeText","Data":"味甘温。"}]},{"ID":"20240616100209-wn100o4","Type":"NodeParagraph","Properties":{"id":"20240616100209-wn100o4","updated":"20240616100209"},"Children":[{"Type":"NodeText","Data":"主伤中，补虚羸，除寒热邪气，补中益气力，长肌肉。久服耳目聪明，轻身不饥，延年。一名山芋，生山谷。"}]},{"ID":"20240616100209-jbcewpw","Type":"NodeParagraph","Properties":{"id":"20240616100209-jbcewpw","updated":"20240616100209"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：薯蓣，一名诸署（《御览》作署豫，作诸署，艺文类聚，亦作诸），齐越名山芋，一名修脆，一名儿草（《御览》引云，秦楚名玉延，齐越名山芋，郑赵名山芋，一名玉延）神农甘小温，桐君雷公甘（御引作苦），无毒，或生临朐钟山，始生，赤茎细蔓，五月华白，七月实青黄，八月熟落，根中白，皮黄，类芋（《御览》引云，二月八月采根，恶甘遂）。"}]},{"ID":"20240616100209-zoe2e0u","Type":"NodeParagraph","Properties":{"id":"20240616100209-zoe2e0u","updated":"20240616100209"},"Children":[{"Type":"NodeText","Data":"《名医》曰：秦楚名玉延，郑越名土诸，生嵩高，二月八月采根，暴干。"}]},{"ID":"20240616100209-8pgtyx0","Type":"NodeParagraph","Properties":{"id":"20240616100209-8pgtyx0","updated":"20240616100209"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：玉延，薯豫，署蓣也；北山经云：景山草多薯豫；郭璞云：根似羊蹄可食，今江南单呼为薯，语有轻重耳；《范子计然》云：薯豫本出三辅，白色者善；本章衍义云：山药上一字犯宋英庙讳，下一字曰蓣，唐代宗名豫，故改下一字为药。"}]},{"ID":"20240616100128-v9gef9x","Type":"NodeThematicBreak","Properties":{"id":"20240616100128-v9gef9x"}},{"ID":"20240616100129-lr02ilg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616100129-lr02ilg","updated":"20240616100134"},"Children":[{"Type":"NodeText","Data":"薯蓣《名医别录》"}]},{"ID":"20240616100129-c8pljtf","Type":"NodeParagraph","Properties":{"id":"20240616100129-c8pljtf","updated":"20240616100129"},"Children":[{"Type":"NodeText","Data":"平，无毒．主治头面游风、风头、眼眩，下气，止腰痛，补虚劳、羸瘦，充五脏，热，强阴．秦楚名玉延，郑越名土 ．生嵩高．二月、八月采根，曝干．（紫芝为之使甘遂．）"}]},{"ID":"20240616100129-zy6bxpy","Type":"NodeParagraph","Properties":{"id":"20240616100129-zy6bxpy","updated":"20240616100220"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶薯蓣，味甘，温．主伤中，补虚羸，除寒热邪气，补中益气力，长肌肉．久服，耳目聪明，轻身不饥，延年。一名山芋，生山谷。"}]},{"ID":"20240616095547-nf9kkrf","Type":"NodeThematicBreak","Properties":{"id":"20240616095547-nf9kkrf"}},{"ID":"20240616100004-s3ptck4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616100004-s3ptck4","updated":"20240616100031"},"Children":[{"Type":"NodeText","Data":"薯蓣《本草图经》"}]},{"ID":"20240616100004-ug4ptrj","Type":"NodeParagraph","Properties":{"id":"20240616100004-ug4ptrj","updated":"20240616100023"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"薯蓣"},{"Type":"NodeText","Data":"，生嵩高山山谷，今处处有之，以北都、四明者为佳。春生苗，蔓延篱援；茎紫，叶青有三尖角，似牵牛，更浓而光泽；夏开细白花，大类枣花；秋生实于叶间，状如铃。二月、八月采根，今人冬春采，刮之白色者为上，青黑者不堪，曝干用之。法取粗根，刮去黄皮，以水浸，末白矾少许糁水中，经宿取净，洗去涎，焙干。近都人种之极有息。春取宿根头，以黄沙和牛粪作畦种。苗生，以竹梢作援，援高不得过一、二尺，夏月频溉之。当年可食，极肥美。南中有一种，生山中，根细如指，极紧实，刮磨入汤煮之，作块不散，味更珍美，云食之尤益人，过于家园种者。又江湖、闽中出一种，根如姜、芋之类而皮紫。极有大者，一枚可重斤余，刮去皮，煎、煮食之俱美。但性冷于北地者耳。彼土人单呼为 （音若殊），亦曰山 。而《山海经》云∶景山，北望少泽，其草多 （音与薯预同）。郭璞注云∶根似芋，可食。今江南人单呼 （音储），语或有轻重耳。据此注，则薯蓣与薯乃一种。南北之产或有不同,故其形类差别。"}]},{"ID":"20240616100058-fnwe48r","Type":"NodeThematicBreak","Properties":{"id":"20240616100058-fnwe48r"}},{"ID":"20240616100059-ph9k6q1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616100059-ph9k6q1","updated":"20240616100106"},"Children":[{"Type":"NodeText","Data":"薯蓣《本草蒙筌》"}]},{"ID":"20240616100059-46kbwbq","Type":"NodeParagraph","Properties":{"id":"20240616100059-46kbwbq","updated":"20240616100059"},"Children":[{"Type":"NodeText","Data":"（即山药，又名山芋。） 味甘，气温、平。无毒。南北州郡俱产，惟怀庆者独良。秋采曝干，灰藏不蛀。（柴灰同藏罐内，则不蛀坏。）性恶甘遂，共剂不宜。使天麦门冬紫芝，入手足太阴两脏。治诸虚百损，疗五劳七伤。益气力润泽皮肤，长肌肉坚强筋骨。除寒热邪气，烦热兼除；却头面游风，风眩总却。羸瘦堪补，肿硬能消。开心孔聪明，涩精管泄滑。理脾伤止泻，参苓白术散频加；逐腰痛强阴，六味地黄丸当用。捣筛为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粉"},{"Type":"NodeText","Data":"，作糊甚粘。"}]},{"ID":"20240616100059-63glpw1","Type":"NodeParagraph","Properties":{"id":"20240616100059-63glpw1","updated":"20240616100059"},"Children":[{"Type":"NodeText","Data":"久服不饥，延年耐老。"}]},{"ID":"20240616100059-panvmbl","Type":"NodeParagraph","Properties":{"id":"20240616100059-panvmbl","updated":"20240616100059"},"Children":[{"Type":"NodeText","Data":"（谟）按∶山药能消肿硬，因能益气补中故尔。经曰∶虚之所在，邪必凑之。着而不去，其病为实。非肿硬之谓乎？"}]},{"ID":"20240616100059-3sgh404","Type":"NodeParagraph","Properties":{"id":"20240616100059-3sgh404","updated":"20240616100120"},"Children":[{"Type":"NodeText","Data":"故补其气，则邪滞自不容不行。丹溪云∶补阳气生者，能消肿硬，正谓此也。"}]},{"ID":"20240616095547-ng4jerj","Type":"NodeThematicBreak","Properties":{"id":"20240616095547-ng4jerj"}},{"ID":"20240616095727-clkc740","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095727-clkc740","updated":"20240616095731"},"Children":[{"Type":"NodeText","Data":"薯蓣《新修本草》"}]},{"ID":"20240616095727-698mo9j","Type":"NodeParagraph","Properties":{"id":"20240616095727-698mo9j","updated":"20240616095727"},"Children":[{"Type":"NodeText","Data":"味甘，温、平，无毒。主伤中，补虚羸，除寒热邪气，补中，益气力，长肌肉。主头面游风、风头眼眩，下气，止腰痛，补虚劳羸瘦，充五脏，除烦热，强阴。久服耳目聪明，轻身秦楚名玉延，郑越名土薯。"}]},{"ID":"20240616095727-5ynkszn","Type":"NodeParagraph","Properties":{"id":"20240616095727-5ynkszn","updated":"20240616095727"},"Children":[{"Type":"NodeText","Data":"生嵩高山谷。二月、八月采根，曝干。"}]},{"ID":"20240616095727-a8gkfuz","Type":"NodeParagraph","Properties":{"id":"20240616095727-a8gkfuz","updated":"20240616095727"},"Children":[{"Type":"NodeText","Data":"紫芝为之使，恶甘遂。今近道处处有，东山、南江皆多掘取食之以充粮。南康间最大而美，服食亦用之。"}]},{"ID":"20240616095727-8vwrq1m","Type":"NodeParagraph","Properties":{"id":"20240616095727-8vwrq1m","updated":"20240616095727"},"Children":[{"Type":"NodeText","Data":"〔谨案〕薯蓣，晒干捣细，筛为粉，食之大美，且愈疾而补。此有两种∶一者白而且佳；一者青黑，味亦不美。蜀道者尤良。"}]},{"ID":"20240616095929-uc81dnp","Type":"NodeThematicBreak","Properties":{"id":"20240616095929-uc81dnp"}},{"ID":"20240616095930-svqll15","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095930-svqll15","updated":"20240616095935"},"Children":[{"Type":"NodeText","Data":"薯蓣《医学入门》"}]},{"ID":"20240616095930-41q5nzy","Type":"NodeParagraph","Properties":{"id":"20240616095930-41q5nzy","updated":"20240616095930"},"Children":[{"Type":"NodeText","Data":"薯蓣甘温气最平，能补荣卫治湿凝，腰疼梦失虚羸热，又止头风眼眩睛。"}]},{"ID":"20240616095930-hizgcti","Type":"NodeParagraph","Properties":{"id":"20240616095930-hizgcti","updated":"20240616095930"},"Children":[{"Type":"NodeText","Data":"薯，署色明也；蓣，形如芋也。俗名山药。无毒。手太阴经药也。凉而能补，凡脾胃中气不足，久泄者必用之。补心气，开达心孔。安魂多记。补肺津，润皮毛干燥，除烦热或寒热邪气，下逆气。补肾阳气，强阴，涩梦泄，止腰疼。东垣云∶山药而腰湿能医。丹溪云∶生者消肿硬。盖补气血则留滞自不容不行也，补肝能坚筋骨及头面游风、头风眼眩。久服益颜色，长肌肉。病患虚羸，加而用之。怀庆者佳。熟则滞气，湿则滑，惟干实者入药。二门冬、紫芝为使，恶甘遂。"}]},{"ID":"20240616095919-ww6sxq1","Type":"NodeThematicBreak","Properties":{"id":"20240616095919-ww6sxq1"}},{"ID":"20240616095920-dx5f6cl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095920-dx5f6cl","updated":"20240616095924"},"Children":[{"Type":"NodeText","Data":"薯蓣《本草纲目》"}]},{"ID":"20240616095920-zu4w4qf","Type":"NodeParagraph","Properties":{"id":"20240616095920-zu4w4qf","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"「释名」薯，土薯、山薯、山芋、山药、玉延。"}]},{"ID":"20240616095920-i1fqi7r","Type":"NodeParagraph","Properties":{"id":"20240616095920-i1fqi7r","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"「气味」（根）甘、温、平、无毒。"}]},{"ID":"20240616095920-veu7y2i","Type":"NodeParagraph","Properties":{"id":"20240616095920-veu7y2i","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616095920-7kc9qcn","Type":"NodeParagraph","Properties":{"id":"20240616095920-7kc9qcn","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"1、心腹虚胀，手足厥逆，不思饮食。用薯蓣半生半炒为末。每服二钱，米汤关定。一天服二次。"}]},{"ID":"20240616095920-wm1atcu","Type":"NodeParagraph","Properties":{"id":"20240616095920-wm1atcu","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"2、禁口痢。治方同上。"}]},{"ID":"20240616095920-akgbz8a","Type":"NodeParagraph","Properties":{"id":"20240616095920-akgbz8a","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"3、小便数多。用薯蓣（矾水煮过）、白茯苓，等分为末。每服二钱，水送下。"}]},{"ID":"20240616095920-fd5nuqt","Type":"NodeParagraph","Properties":{"id":"20240616095920-fd5nuqt","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"4、痰风喘急。用生薯蓣（捣烂）半碗，加甘蔗汁半碗，和匀，一次饮服。"}]},{"ID":"20240616095920-0g8mzs4","Type":"NodeParagraph","Properties":{"id":"20240616095920-0g8mzs4","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"5、脾胃虚弱，不思饮食。用薯蓣、白术各一两，人参七钱半，共研为末，加水和糊做成丸子，如小豆大。每服四十至五十丸，米汤送下。"}]},{"ID":"20240616095920-rixqsya","Type":"NodeParagraph","Properties":{"id":"20240616095920-rixqsya","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"6、湿热虚泄。用薯蓣、苍术等分，加饭做成丸子米汤送服。"}]},{"ID":"20240616095920-s77i24l","Type":"NodeParagraph","Properties":{"id":"20240616095920-s77i24l","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"7、肿毒初起。用带泥的薯蓣、蓖麻子、糯米等分，水泡过，研细敷涂即散。"}]},{"ID":"20240616095920-fna5bnz","Type":"NodeParagraph","Properties":{"id":"20240616095920-fna5bnz","updated":"20240616095920"},"Children":[{"Type":"NodeText","Data":"8、手足冻疮。有薯蓣一截，磨泥敷上。"}]},{"ID":"20240616095547-al9up74","Type":"NodeThematicBreak","Properties":{"id":"20240616095547-al9up74"}},{"ID":"20240616095710-rgte9c6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095710-rgte9c6","updated":"20240616095716"},"Children":[{"Type":"NodeText","Data":"薯蓣《本草崇原》"}]},{"ID":"20240616095710-7ofvz0g","Type":"NodeParagraph","Properties":{"id":"20240616095710-7ofvz0g","updated":"20240616095710"},"Children":[{"Type":"NodeText","Data":"气味甘平，无毒。主伤中，补虚羸，除寒热邪气，补中，益气力，长肌肉，强阴。久服耳目聪明，轻身不饥，延年。"}]},{"ID":"20240616095710-ph80luh","Type":"NodeParagraph","Properties":{"id":"20240616095710-ph80luh","updated":"20240616095710"},"Children":[{"Type":"NodeText","Data":"（薯蓣即今山药，因唐代宗名预，避讳改为薯药，又因宋英宗名署，避讳改为山药。始出嵩高山谷，今处处有之，入药野生者为胜。种薯蓣法，以杵打穴，截块投于杵穴之中，随所杵之窍而成形，如预备署，所因名薯蓣也，今时但知山药，不知薯蓣矣。）"}]},{"ID":"20240616095710-jjx80yn","Type":"NodeParagraph","Properties":{"id":"20240616095710-jjx80yn","updated":"20240616095710"},"Children":[{"Type":"NodeText","Data":"山药气味甘平，始出中岳，得中土之专精，乃补太阴脾土之药，故主治之功皆在中土。"}]},{"ID":"20240616095710-mdfchgl","Type":"NodeParagraph","Properties":{"id":"20240616095710-mdfchgl","updated":"20240616095710"},"Children":[{"Type":"NodeText","Data":"治伤中者，益中土也。补虚羸者，益肌肉也。除寒热邪气者，中土调和，肌肉充足，则寒热邪气自除矣，夫治伤中，则可以补中而益气力。补虚羸，则可以长肌肉而强阴。阴强，则耳目聪明。气力益，则身体轻健，土气有余，则不饥而延年。"}]},{"ID":"20240616095710-x11y13w","Type":"NodeParagraph","Properties":{"id":"20240616095710-x11y13w","updated":"20240616095710"},"Children":[{"Type":"NodeText","Data":"凡柔滑之物，损即腐坏，山药切块，投于土中，百合分瓣种之，如种蒜法，地黄以根节多者，寸断埋土中，皆能生长。所以然者，百合得太阴之天气，山药、地黄得太阴之地气也。"}]},{"ID":"20240616095547-d0yh14f","Type":"NodeThematicBreak","Properties":{"id":"20240616095547-d0yh14f"}},{"ID":"20240616095658-i4c2g7n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095658-i4c2g7n","updated":"20240616095704"},"Children":[{"Type":"NodeText","Data":"薯蓣《神农本草经读》"}]},{"ID":"20240616095658-k8e4x1j","Type":"NodeParagraph","Properties":{"id":"20240616095658-k8e4x1j","updated":"20240616095658"},"Children":[{"Type":"NodeText","Data":"气味甘、平，无毒。主伤中，补虚羸，除寒热邪气，补中，益气力，长肌肉，强阴。久服耳目聪明，轻身，不饥，延年。"}]},{"ID":"20240616095658-01f6poe","Type":"NodeParagraph","Properties":{"id":"20240616095658-01f6poe","updated":"20240616095658"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶此药因唐代宗名蓣，避讳改为山药。山药气平入肺，味甘无毒入脾。脾为中州而统血，血者阴也，中之守也；唯能益血，故主伤中。伤中愈，则肌肉丰，故补虚羸。肺主气，气虚则寒邪生；脾统血，血虚则热邪生；血气充而寒热邪气除矣。脾主四肢，脾血足则四肢健；肺主气，肺气充则气力倍也。且此物生捣，最多津液而稠粘，又能补肾而填精，精足则强阴。目明、耳聪、不饥，是脾血之旺；轻身是肺气之充；延年是夸其补益之效也。"}]},{"ID":"20240616095658-51gy55a","Type":"NodeParagraph","Properties":{"id":"20240616095658-51gy55a","updated":"20240616095658"},"Children":[{"Type":"NodeText","Data":"凡上品，俱是寻常服食之物，非治病之药，故神农另提出“久服”二字。可见今人每服上品之药，如此物及人参、熟地、葳蕤、阿胶、菟丝子、沙苑蒺藜之类，合为一方，以治大病，误人无算。盖病不速去，元气日伤，伤及则死。凡上品之药，法宜久服，多则终身，少则数年，与五谷之养人相佐，以臻寿考。若大病而需用此药，如五谷为养脾第一品。脾虚之人，强令食谷，即可毕补脾之能事，有是理乎？然操此技者，未有不得盛名。薛立斋、张景岳、冯楚瞻辈，倡之于前。而近日之东延西请、日诊百人者，无非是术，诚可慨也！"}]},{"ID":"20240616095547-zy6jszo","Type":"NodeThematicBreak","Properties":{"id":"20240616095547-zy6jszo"}},{"ID":"20240616095649-w1gnhj9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095649-w1gnhj9","updated":"20240616095653"},"Children":[{"Type":"NodeText","Data":"薯蓣《本经逢原》"}]},{"ID":"20240616095649-ojwfjjc","Type":"NodeParagraph","Properties":{"id":"20240616095649-ojwfjjc","updated":"20240616095649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即山药，因唐代宗名蓣，宋英宗名薯，改名山药"}]},{"ID":"20240616095649-4kqvthh","Type":"NodeParagraph","Properties":{"id":"20240616095649-4kqvthh","updated":"20240616095649"},"Children":[{"Type":"NodeText","Data":"甘平无毒。同面食发动气，微焙用。"}]},{"ID":"20240616095649-afdrdbk","Type":"NodeParagraph","Properties":{"id":"20240616095649-afdrdbk","updated":"20240616095649"},"Children":[{"Type":"NodeText","Data":"《本经》治伤中补虚羸，除寒热邪气，补中益气力，长肌肉强阴。久服耳目聪明，轻身不饥延年。"}]},{"ID":"20240616095649-x0f0mia","Type":"NodeParagraph","Properties":{"id":"20240616095649-x0f0mia","updated":"20240616095649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"山药入手足太阴。色白归肺。味甘归脾。大补黄庭，治气不足而清虚热。故《本经》治伤中寒热邪气，补而不滞，温而不热。又能益气力，长肌肉，强阴固肾，止泄精小便频数。肺为肾之上源，源既有滋，流岂无益，《金匮》八味丸用以强阴也，薯蓣丸以之为君。而主虚劳不足，风气百病，甘温平补而不碍久积之邪也。其鲜者，和生鲫鱼脑捣敷肿，又捣烂和芎 末白糖霜涂乳癖结块及诸痛日久坚硬不溃。但涂上奇痒不可忍，忍之良久渐止，不过数次即愈。子名零余子，补虚损，强腰脚，益肾。一种曰甘薯，色较薯蓣稍紫，味较薯蓣稍甜，质较薯蓣稍腻，性较薯蓣稍温，补脾强肾之功较薯蓣稍胜。广人以之代粮，今徽宁亦多种之，名曰薯，音孺与薯字形切音并相类，传久之讹耳。"}]},{"ID":"20240616095804-a3tsixx","Type":"NodeThematicBreak","Properties":{"id":"20240616095804-a3tsixx"}},{"ID":"20240616095805-8cvgz66","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095805-8cvgz66","updated":"20240616095808"},"Children":[{"Type":"NodeText","Data":"薯蓣《得配本草》"}]},{"ID":"20240616095805-uueyxi8","Type":"NodeParagraph","Properties":{"id":"20240616095805-uueyxi8","updated":"20240616095805"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名山药"}]},{"ID":"20240616095805-31k3xya","Type":"NodeParagraph","Properties":{"id":"20240616095805-31k3xya","updated":"20240616095805"},"Children":[{"Type":"NodeText","Data":"紫芝为之使。恶甘遂。"}]},{"ID":"20240616095805-vk59l43","Type":"NodeParagraph","Properties":{"id":"20240616095805-vk59l43","updated":"20240616095805"},"Children":[{"Type":"NodeText","Data":"甘，平。入手足太阴经血分，兼入足少阴经气分。补脾阴，调肺气。治虚热干咳，遗精泄泻，游风眼眩，惊悸健忘。生者捣敷疮毒，能消肿硬。（合蓖麻子更效。）得菟丝子，止遗泄。配人参，补肺气。佐羊肉，补脾阴。佐熟地，固肾水。合米仁，治泄泻。"}]},{"ID":"20240616095805-m9adr79","Type":"NodeParagraph","Properties":{"id":"20240616095805-m9adr79","updated":"20240616095805"},"Children":[{"Type":"NodeText","Data":"入补脾药，微炒。入补肺药，乳拌蒸。治阴火，生用。恐气滞，佐以陈皮。力薄须倍用。"}]},{"ID":"20240616095805-pyoso8a","Type":"NodeParagraph","Properties":{"id":"20240616095805-pyoso8a","updated":"20240616095805"},"Children":[{"Type":"NodeText","Data":"阴虚火动者，久必脾气衰败，泄泻不止，用白术、米仁以燥土，肾水益致干涸，惟此同芡实、莲子以实之，则补土不妨于水，乃为善治。"}]},{"ID":"20240616095850-8ygtepz","Type":"NodeThematicBreak","Properties":{"id":"20240616095850-8ygtepz"}},{"ID":"20240616095851-rta1529","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095851-rta1529","updated":"20240616095856"},"Children":[{"Type":"NodeText","Data":"薯蓣《本草述钩元》"}]},{"ID":"20240616095851-2jb6l43","Type":"NodeParagraph","Properties":{"id":"20240616095851-2jb6l43","updated":"20240616095851"},"Children":[{"Type":"NodeText","Data":"一名山药。干者佳。唐避代宗讳。改蓣为薯药。宋避英宗讳。改薯为山药。熟则湿则滑。惟干实者入药。必以冀州所产为胜。"}]},{"ID":"20240616095851-tky2njk","Type":"NodeParagraph","Properties":{"id":"20240616095851-tky2njk","updated":"20240616095851"},"Children":[{"Type":"NodeText","Data":"根味甘。气平。入手足太经阴。补脾肺之气。主治伤中。补虚羸。除烦热。补心气不足。"}]},{"ID":"20240616095851-sf3vtg8","Type":"NodeParagraph","Properties":{"id":"20240616095851-sf3vtg8","updated":"20240616095851"},"Children":[{"Type":"NodeText","Data":"养毒性凉补肝泄药等分即散〔论〕薯蓣味甘。甘益中土。所取者根。其质白色。是味之归形者。肺金也。其气温而兼平之气阴易益。"}]},{"ID":"20240616095851-05kbzuv","Type":"NodeParagraph","Properties":{"id":"20240616095851-05kbzuv","updated":"20240616095851"},"Children":[{"Type":"NodeText","Data":"为补至于中外乎手矣。"}]},{"ID":"20240616095851-nna5kl9","Type":"NodeParagraph","Properties":{"id":"20240616095851-nna5kl9","updated":"20240616095851"},"Children":[{"Type":"NodeText","Data":"不宜与面同食。（仲淳）〔修治〕六味丸。取山药由肺入肾以达茯苓泽泻之用。修合时。但微火烘干。如以理脾。"}]},{"ID":"20240616095902-ps5hy3c","Type":"NodeThematicBreak","Properties":{"id":"20240616095902-ps5hy3c"}},{"ID":"20240616095903-yopya9t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095903-yopya9t","updated":"20240616095909"},"Children":[{"Type":"NodeText","Data":"薯蓣《证类本草》"}]},{"ID":"20240616095903-6yd10rs","Type":"NodeParagraph","Properties":{"id":"20240616095903-6yd10rs","updated":"20240616095903"},"Children":[{"Type":"NodeText","Data":"味甘，温，平，无毒。主伤中，补虚羸，除寒热邪气，补中，益气力，长肌肉，主头面游风，风头眼眩，下气，止腰痛。补虚劳羸瘦，充五脏，除烦热，强阴。久服耳目聪明，轻身，不饥，延年。一名山芋，秦、楚名玉延，郑、越名土薯（音除。）生嵩高山谷。二月、八月采根，曝干。紫芝为之使，恶甘遂。"}]},{"ID":"20240616095903-7dkl7sj","Type":"NodeParagraph","Properties":{"id":"20240616095903-7dkl7sj","updated":"20240616095903"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今近道处处有，东山、南江皆多掘取食之以充粮。南康间最大而美，服食亦用之。唐本注云∶薯蓣，日干捣细，筛为粉，食之大美，且愈疾而补。此有两种∶一者白而且佳。一者青黑，味亦不美。蜀道者尤良。臣禹锡等谨按吴氏云∶薯蓣，一名诸署，齐、越名山羊，一名修脆，一名儿草。神农∶甘，小温。桐君、雷公∶甘，无毒。或生临朐钟山，始生赤茎细蔓，五月华白，七月实青黄，八月熟落，根中白，皮黄，类芋。药性论云∶薯蓣，臣。能补五劳七伤，去冷风，止腰疼，镇心神，安魂魄，开达心孔，多记事，补心气不足，患人体虚羸，加而用之。异苑云∶薯蓣，野人谓之土薯。若欲掘取，嘿然则获，唱名便不可得。人有植之者，随所种之物而像之也。日华子云∶助五脏，强筋骨，长志，安神，主泄精，健忘。干者功用同前。"}]},{"ID":"20240616095903-68dze5y","Type":"NodeParagraph","Properties":{"id":"20240616095903-68dze5y","updated":"20240616095903"},"Children":[{"Type":"NodeText","Data":"图经曰∶薯蓣，生嵩高山山谷，今处处有之，以北都、四明者为佳。春生苗，蔓延篱援。"}]},{"ID":"20240616095903-xsuwmz5","Type":"NodeParagraph","Properties":{"id":"20240616095903-xsuwmz5","updated":"20240616095903"},"Children":[{"Type":"NodeText","Data":"茎紫叶青，有三尖角似牵牛更浓而光泽。夏开细白花，大类枣花。秋生实于叶间，状如铃。二月、八月采根，今人冬春采，刮之白色者为上，青黑者不堪，曝干用之。法取粗根，刮去黄皮，以水浸，末白矾少许掺水中，经宿取，净洗去涎，焙干。近都人种之极有息。春取宿根头，以黄沙和牛粪作畦种。苗生以竹梢作援，援高不得过一、二尺，夏月频溉之。当年可食，极肥美。南中有一种，生山中，根细如指，极紧实，刮磨入汤煮之，作块不散，味更珍美，云食之尤益人，过于家园种者。又江湖、闽中出一种，根如姜、芋之类而皮紫。极有大者，一枚可重斤余，刮去皮，煎煮食之俱美，但性冷于北地者耳。彼土人为单呼为薯（音若殊），亦曰山薯。而《山海经》云∶景山北望少泽，其草多薯 （音与薯蓣同）。郭璞注云∶根似芋可食。今江南人单呼薯（音储），语或用轻重耳。据此注，则薯蓣与薯乃一种。南北之产或有不同，故其形类差别。然字音殊、储不同，盖相传之讹也。一名山芋。"}]},{"ID":"20240616095903-8ib9642","Type":"NodeParagraph","Properties":{"id":"20240616095903-8ib9642","updated":"20240616095903"},"Children":[{"Type":"NodeText","Data":"食疗∶治头疼，利丈夫，助阴力。和面作 ，则微动气，为不能制面毒也。熟者和蜜，或为汤煎，或为粉，并佳。干之入药更妙也。雷公云∶凡使，勿用平田生二、三纪内者，要经十纪者，山中生，皮赤，四面有髭生者妙。若采得，用铜刀削去上赤皮，洗去涎，蒸用。圣惠方∶补虚损，益颜色。用薯蓣于砂盆中细研，然后下于铫中，先以酥一大匙熬令香，次旋添酒一盏煎，搅令匀，空心饮之。食医心镜主下焦虚冷，小便数，瘦损无力。生薯蓣半斤。刮去皮，以刀切碎，研令细烂，于铛中着酒，酒沸下薯蓣，不得搅，待熟着少盐、葱白，理添酒，空腹饮三、二杯，妙。"}]},{"ID":"20240616095903-ynjt1pd","Type":"NodeParagraph","Properties":{"id":"20240616095903-ynjt1pd","updated":"20240616095903"},"Children":[{"Type":"NodeText","Data":"衍义曰∶山药，按本草，上一字犯英庙讳，下一字曰蓣，唐代宗名预，故改下一字为药，今人遂呼为山药。如此则尽失当曰本名，虑岁久，以山药为别物，故书之。此物贵生干，方入药，其法∶冬月以布裹手，用竹刀子剐去皮，于檐下风迳处，盛竹筛中，不得见日色。一夕干五分，俟全干收之，唯风紧则干速。所以用干之意，盖生湿则滑，不可入药。熟则只堪啖，亦滞气。余如《经》。"}]},{"ID":"20240616095834-cvb3wok","Type":"NodeThematicBreak","Properties":{"id":"20240616095834-cvb3wok"}},{"ID":"20240616095835-75q1zrr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095835-75q1zrr","updated":"20240616095840"},"Children":[{"Type":"NodeText","Data":"薯蓣《本草经集注》"}]},{"ID":"20240616095835-hnw1kcz","Type":"NodeParagraph","Properties":{"id":"20240616095835-hnw1kcz","updated":"20240616095835"},"Children":[{"Type":"NodeText","Data":"味甘，温、平，无毒。主治伤中，补虚羸，除寒热邪气，补中，益气力，长肌肉。主头面游风，风头目眩，下气，止腰痛，补虚劳羸瘦，充五脏，除烦热，强阴。久服耳目聪明，轻身，不饥，延年。一名山芋，秦楚名玉延，郑越名土薯。生嵩山山谷。二月、八月采根，曝干。（紫芝为之使，恶甘遂。）"}]},{"ID":"20240616095835-m8uc0ma","Type":"NodeParagraph","Properties":{"id":"20240616095835-m8uc0ma","updated":"20240616095835"},"Children":[{"Type":"NodeText","Data":"今近道处处有，东山、南江皆多掘取食之以充粮。南康间最大而美，服食亦用之。"}]},{"ID":"20240616095824-pou30yc","Type":"NodeThematicBreak","Properties":{"id":"20240616095824-pou30yc"}},{"ID":"20240616095825-rusajbp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095825-rusajbp","updated":"20240616095829"},"Children":[{"Type":"NodeText","Data":"薯蓣《要药分剂》"}]},{"ID":"20240616095825-ermwhpj","Type":"NodeParagraph","Properties":{"id":"20240616095825-ermwhpj","updated":"20240616095825"},"Children":[{"Type":"NodeText","Data":"味甘。性温平。无毒。禀土之冲气以生。可升可降。阳也。恶甘遂。一名山药。"}]},{"ID":"20240616095825-6vahwtt","Type":"NodeParagraph","Properties":{"id":"20240616095825-6vahwtt","updated":"20240616095825"},"Children":[{"Type":"NodeText","Data":"【主治】主补虚羸。除寒热邪气。补中。益气力。长肌肉。强阴。（本经）头面游风。"}]},{"ID":"20240616095825-ul0sqjg","Type":"NodeParagraph","Properties":{"id":"20240616095825-ul0sqjg","updated":"20240616095825"},"Children":[{"Type":"NodeText","Data":"头风眼开心孔【归经】入肺脾二经。兼入心肾二经。为补益之品。（兼涩剂）【前论】庵曰。山药入肺脾二经。补其不足。清其虚热。固肠胃。润皮毛。化痰涎。"}]},{"ID":"20240616095825-hu9t9vf","Type":"NodeParagraph","Properties":{"id":"20240616095825-hu9t9vf","updated":"20240616095825"},"Children":[{"Type":"NodeText","Data":"止泻生捣【禁忌】经疏曰。不宜与面同食。"}]},{"ID":"20240616095813-l3jud6e","Type":"NodeThematicBreak","Properties":{"id":"20240616095813-l3jud6e"}},{"ID":"20240616095814-p1kelvv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095814-p1kelvv","updated":"20240616095819"},"Children":[{"Type":"NodeText","Data":"薯蓣《长沙药解》"}]},{"ID":"20240616095814-adf98yc","Type":"NodeParagraph","Properties":{"id":"20240616095814-adf98yc","updated":"20240616095814"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味甘温。主伤中，补虚羸，除寒热邪气，补中益气力，长肌肉。久服耳目聪明，轻身不饥，延年。一名山芋，生山谷。"}]},{"ID":"20240616095814-1nyapc4","Type":"NodeParagraph","Properties":{"id":"20240616095814-1nyapc4","updated":"20240616095814"},"Children":[{"Type":"NodeText","Data":"味甘，气平，入足阳明胃、手太阴肺经。养戊土而行降摄，补辛金而司收敛，善熄风燥，专止疏泄。"}]},{"ID":"20240616095814-seqs73c","Type":"NodeParagraph","Properties":{"id":"20240616095814-seqs73c","updated":"20240616095814"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣丸"},{"Type":"NodeText","Data":"，薯"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蓣三十分，麦冬六分，桔梗五分，杏仁六分，当归十分，阿胶七分，干地黄十分，芍?药六分，芎六分，桂枝十分，大枣百枚为膏，人参七分，茯苓五分，白术六分，甘草二十分，神曲十分，干姜三分，柴胡五分，白蔹二分，豆黄卷十分，防风六分。蜜丸，弹子大，空腹酒服一丸。"},{"Type":"NodeText","Data":"治虚劳诸不足，风气百疾。以虚劳之病，率在厥阴风木一经，厥阴风木，泄而不敛，百病皆生。肺主降敛，薯蓣敛肺而保精，麦冬清金而宁神，桔梗、杏仁，破壅而降逆，此所以助辛金之敛也。肝?主升发，归、胶滋肝而养血，地、芍润木而清风。芎、桂枝，疏郁而升陷，此所以辅乙木之升发也。升降金木，职在中气，大枣补己土之精，人参补戊土之气，苓、术、甘草，培土而泻湿，神曲、干姜，消滞而驱寒，此所以理中而运升降之枢也。贼伤中气，是惟木邪，柴胡、白蔹，泻火而疏甲木，黄卷、防风，燥湿而达乙木，木静而风息，则虚劳百病瘳矣。"}]},{"ID":"20240616095814-l4ogd4l","Type":"NodeParagraph","Properties":{"id":"20240616095814-l4ogd4l","updated":"20240616095814"},"Children":[{"Type":"NodeText","Data":"阴阳之要，阳密乃固，阴平阳秘，精神乃治，阴阳离决，精气乃绝。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"《素问》语。"},{"Type":"NodeText","Data":"四时之气，木火司乎生长，金水司乎收藏，人于秋冬之时，而行收藏之政。宝涩精神，以秘阳根，是谓圣人。下此于蛰藏之期，偏多损失，坎阳不密，木郁风生，木火行疏泄之令，金水无封闭之权，于是惊悸、吐衄、崩带、淋遗之病，种种皆起。是以虚劳之证非一，无不成于乙木之不谧，始于辛金之失敛。究之总缘土败，盖坎中之阳，诸阳之根，坎阳走泄，久而癸水寒增，己土湿旺，脾不能升而胃不能降，此木陷金逆所由来也。法当温燥中脘，左达乙木而右敛辛金。薯蓣之性，善入肺胃而敛精神，辅以调养土木之品，实虚劳百病之良药也。"}]},{"ID":"20240616095751-6xcgsqg","Type":"NodeThematicBreak","Properties":{"id":"20240616095751-6xcgsqg"}},{"ID":"20240616095752-abjwxnu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095752-abjwxnu","updated":"20240616095757"},"Children":[{"Type":"NodeText","Data":"薯蓣《侣山堂类辩》"}]},{"ID":"20240616095752-esv56wi","Type":"NodeParagraph","Properties":{"id":"20240616095752-esv56wi","updated":"20240616095752"},"Children":[{"Type":"NodeText","Data":"薯蓣，古名也，避唐宋帝讳，改名山药。种植之法，切作薄片，随所杵之窍而长之。（卢子由先生治一血利，久久不愈，曰∶此肠内有血管矣。山药随所杵之窍而长满，性能塞管，用山药为君，配血药而愈。此乃意度之妙用。）又百合之白花者，摘碎埋于土中，一瓣即生百瓣，而成一蒲。夫凡物切碎，皆成腐秽，二品所生之异，盖得本体之精，感气化而生长。山药肉内多涎，仲景用百合汤，以水浸一宿，出其白沫。涎沫，乃其精也。气生于精，二品得精气之盛，故主补中益气，长肉强阴。元如曰∶凡物多精汁者，皆主养精补血，益气生肌。"}]},{"ID":"20240616095738-a2os7le","Type":"NodeThematicBreak","Properties":{"id":"20240616095738-a2os7le"}},{"ID":"20240616095739-abrqpov","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616095739-abrqpov","updated":"20240616095745"},"Children":[{"Type":"NodeText","Data":"山药《本草经解》"}]},{"ID":"20240616095739-s8037le","Type":"NodeParagraph","Properties":{"id":"20240616095739-s8037le","updated":"20240616095739"},"Children":[{"Type":"NodeText","Data":"本经名薯蓣．其改称山药．避唐代宗宋英宗御名也．唐本草云．蜀道者良．今惟重怀庆产．然六地此种实佳．有自河北来者．云在彼煮服．尚不逮六产也．里有窭人生儿乏乳．困瘁已甚．或教糜山药饲之．始终此一物．竟得长成．且肥白无疾．胜他儿．则本草称补虚羸．信有证矣．纲目云．入药宜野生者．今六圃产煮熟去皮．色白微碧而坚实．山中有自生者更胜．然但充果菜．若依法修治入药．应不在怀庆下耳．纲目列菜部．"}]},{"ID":"20240607105515-xbxzou8","Type":"NodeThematicBreak","Properties":{"id":"20240607105515-xbxzou8"}},{"ID":"20240607105533-k60zrzb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105533-k60zrzb","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"《中国药典》：山药"}]},{"ID":"20240607105533-xnxvwvi","Type":"NodeParagraph","Properties":{"id":"20240607105533-xnxvwvi","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105533-2fj6id3","Type":"NodeParagraph","Properties":{"id":"20240607105533-2fj6id3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" Shān Yɑo"}]},{"ID":"20240607105533-3ye4dyk","Type":"NodeParagraph","Properties":{"id":"20240607105533-3ye4dyk","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105533-m5b3x4k","Type":"NodeParagraph","Properties":{"id":"20240607105533-m5b3x4k","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 薯蓣、土薯、山薯蓣、怀山药、淮山、白山药"}]},{"ID":"20240607105533-iz1cdni","Type":"NodeParagraph","Properties":{"id":"20240607105533-iz1cdni","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607105533-23qmerz","Type":"NodeParagraph","Properties":{"id":"20240607105533-23qmerz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" RHIZOMA DIOSCOREAE"}]},{"ID":"20240607105533-7cv67l9","Type":"NodeParagraph","Properties":{"id":"20240607105533-7cv67l9","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105533-hu9qtn7","Type":"NodeParagraph","Properties":{"id":"20240607105533-hu9qtn7","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 本品为薯蓣科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣"},{"Type":"NodeText","Data":"Dioscorea opposita Thunb. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。冬季茎叶枯萎后采挖，切去根头，洗净，除去外皮及须根，用硫黄熏后，干燥；也有选择肥大顺直的干燥山药，置清水中，浸至无干心，闷透，用硫黄熏后，切齐两端，用木板搓成圆柱状，晒干，打光，习称“光山药”。"}]},{"ID":"20240607105533-29oj9lf","Type":"NodeParagraph","Properties":{"id":"20240607105533-29oj9lf","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"注：同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野山药"},{"Type":"NodeText","Data":"Dioscorea japonica Thunb.野生于我国各地。其根亦作山药入药，功效类同。"}]},{"ID":"20240607105533-7vhiiqq","Type":"NodeParagraph","Properties":{"id":"20240607105533-7vhiiqq","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607105533-f7lq3dt","Type":"NodeParagraph","Properties":{"id":"20240607105533-f7lq3dt","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 本品略呈圆柱形，弯曲而稍扁，长15～30cm，直径1.5～6cm。表面黄白色或淡黄色，有纵沟、纵皱纹及须根痕，偶有浅棕色外皮残留。体重，质坚实，不易折断，断面白色，粉性。无臭，味淡、微酸，嚼之发黏。光山药呈圆柱形，两端平齐，长9～18cm，直径1.5～3cm。表面光滑，白色或黄白色。"}]},{"ID":"20240607105533-pboarjp","Type":"NodeParagraph","Properties":{"id":"20240607105533-pboarjp","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607105533-y5kpyl4","Type":"NodeParagraph","Properties":{"id":"20240607105533-y5kpyl4","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防蛀。"}]},{"ID":"20240607105533-084g1ok","Type":"NodeParagraph","Properties":{"id":"20240607105533-084g1ok","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105533-pvnnum6","Type":"NodeParagraph","Properties":{"id":"20240607105533-pvnnum6","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 山药：除去杂质，分开大小个，泡润至透，切厚片，干燥。"}]},{"ID":"20240607105533-dl0yzs1","Type":"NodeParagraph","Properties":{"id":"20240607105533-dl0yzs1","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"麸炒山药：取净山药片，照麸炒法（附录Ⅱ D）炒至黄色。"}]},{"ID":"20240607105533-9v2pqu9","Type":"NodeParagraph","Properties":{"id":"20240607105533-9v2pqu9","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607105533-uhf87vm","Type":"NodeParagraph","Properties":{"id":"20240607105533-uhf87vm","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 本品粉末类白色。淀粉粒单粒扁卵形、类圆形、三角状卵形或矩圆形，直径8～35μｍ，脐点点状、人字状、十字状或短缝状，可见层纹；复粒稀少，由2～3分粒组成。草酸钙针晶束存在于黏液细胞中，长约至240μｍ，针晶粗2～5μｍ。具缘纹孔、网纹、螺纹及环纹导管直径12～48μｍ。"}]},{"ID":"20240607105533-r1k99sz","Type":"NodeParagraph","Properties":{"id":"20240607105533-r1k99sz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607105533-agpbogw","Type":"NodeParagraph","Properties":{"id":"20240607105533-agpbogw","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 归脾、肺、肾经。"}]},{"ID":"20240607105533-mf6voh0","Type":"NodeParagraph","Properties":{"id":"20240607105533-mf6voh0","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105533-z9878j3","Type":"NodeParagraph","Properties":{"id":"20240607105533-z9878j3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240607105533-waqg0jp","Type":"NodeParagraph","Properties":{"id":"20240607105533-waqg0jp","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105533-7q3onr5","Type":"NodeParagraph","Properties":{"id":"20240607105533-7q3onr5","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 补脾养胃，生津益肺，补肾涩精。用于脾虚食少，久泻不止，肺虚喘咳，肾虚遗精，带下，尿频，虚热消渴。麸炒山药补脾健胃。用于脾虚食少，泄泻便溏，白带过多。"}]},{"ID":"20240607105533-qdd5isz","Type":"NodeParagraph","Properties":{"id":"20240607105533-qdd5isz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607105533-7hmg1zy","Type":"NodeParagraph","Properties":{"id":"20240607105533-7hmg1zy","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 15～30g。"}]},{"ID":"20240607105533-xbc46ia","Type":"NodeParagraph","Properties":{"id":"20240607105533-xbc46ia","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105533-8kzu9hq","Type":"NodeParagraph","Properties":{"id":"20240607105533-8kzu9hq","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607105533-15mzi8y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105533-15mzi8y","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：山药"}]},{"ID":"20240607105533-amm788u","Type":"NodeParagraph","Properties":{"id":"20240607105533-amm788u","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105533-358nswi","Type":"NodeParagraph","Properties":{"id":"20240607105533-358nswi","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" Shān Yɑo"}]},{"ID":"20240607105533-yrqw5q8","Type":"NodeParagraph","Properties":{"id":"20240607105533-yrqw5q8","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105533-ui3hden","Type":"NodeParagraph","Properties":{"id":"20240607105533-ui3hden","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 藷藇、署预（《山海经》），薯蓣、山芋（《本经》），诸署、署豫、玉延，修脆、几草（《吴普本草》），藷（《山海经》郭璞传），山藷（《别录》），延草（《兼名苑》），王芋（《杂要诀》）。薯药（《清异录》），淮山药（《饮片新参》），蛇芋（《浙江中药手册》），野山豆（《江苏植药志》），山板术（《广西中药志》），白苕（《四川中药志》），九黄姜、野白薯（《湖南药物志》），扇子薯、佛掌薯（《药材学》），白药子（《杭州药植志》）。"}]},{"ID":"20240607105533-q7or05c","Type":"NodeParagraph","Properties":{"id":"20240607105533-q7or05c","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607105533-qtl7ztz","Type":"NodeParagraph","Properties":{"id":"20240607105533-qtl7ztz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 侯宁极《药谱》"}]},{"ID":"20240607105533-8r8x3vb","Type":"NodeParagraph","Properties":{"id":"20240607105533-8r8x3vb","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105533-s0gryh2","Type":"NodeParagraph","Properties":{"id":"20240607105533-s0gryh2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 为薯蓣科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块茎"},{"Type":"NodeText","Data":"。11～12月采挖，切去根头，洗净泥土，用竹刀刮去外皮，晒干或烘干，即为毛山药。选择粗大的毛山药，用清水浸匀，再加微热，并用棉被盖好，保持湿润闷透，然后放在木板上搓揉成圆柱状，将两头切齐，晒干打光，即为光山药。"}]},{"ID":"20240607105533-p19l2hh","Type":"NodeParagraph","Properties":{"id":"20240607105533-p19l2hh","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607105533-log8l5t","Type":"NodeParagraph","Properties":{"id":"20240607105533-log8l5t","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 生山野向阳处。现各地皆有栽培。"}]},{"ID":"20240607105533-nx8w99o","Type":"NodeParagraph","Properties":{"id":"20240607105533-nx8w99o","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607105533-ygtycd2","Type":"NodeParagraph","Properties":{"id":"20240607105533-ygtycd2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 多年生缠绕草本。块茎肉贸肥厚，略呈圆柱形，垂直生长，长可达1米，直径2～7厘米，外皮灰褐色，生有须根。茎细长，蔓性，通常带紫色，有棱，光滑无毛。叶对生或3叶轮生，叶腋间常生珠芽（名零余子）；叶片形状多变化，三角状卵形至三角状广卵形，长3.5～7厘米，宽2～4.5厘米，通常耳状3裂，中央裂片先端渐尖，两侧裂片呈圆耳状，基部戟状心形，两面均光滑无毛；叶脉7～9条基出；叶柄细长，长1.5～3.5厘米。花单性，雌雄异株；花极小，黄绿色，成穗状花序；雄花序直立，2至数个聚生于叶腋，花轴多数成曲折状；花小，近于无柄，苞片三角状卵形；花被6，椭圆形，先端钝；雄蕊6，花丝很短；雌花序下垂，每花的基部各有2枚大小不等的苞片，苞片广卵形，先端长渐尖；花被6；子房下位，长椭圆形，3室，柱头3裂。蒴果有3翅，果翅长几等于宽。种子扁卵圆形，有阔翅。花期7～8月。果期9～10月。"}]},{"ID":"20240607105533-aeii60f","Type":"NodeParagraph","Properties":{"id":"20240607105533-aeii60f","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"本植物的藤（山药藤）、叶腋间的珠芽（零余子）亦供药用，各详专条。"}]},{"ID":"20240607105533-yyinpm5","Type":"NodeParagraph","Properties":{"id":"20240607105533-yyinpm5","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607105533-q2e6946","Type":"NodeParagraph","Properties":{"id":"20240607105533-q2e6946","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" ①毛山药：呈圆柱形，弯曲而稍扁，长约15～30厘米，直径1.5～6匣米，表面黄白色或棕黄色，有明显纵皱及未除尽之栓皮，并少数根痕。质较硬，断面白色，颗粒状，粉质。气微，味甘微酸，嚼之发粘。"}]},{"ID":"20240607105533-rjtoafb","Type":"NodeParagraph","Properties":{"id":"20240607105533-rjtoafb","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"②光山药：呈平滑的圆柱形，长10～20厘米，直径2～4厘米。表面淡黄白色，光滑。质坚硬，不易折断，断面白色，粉质。气微，微甘味酸，嚼之发粘。以质坚实，粉性足，色洁白者为佳。"}]},{"ID":"20240607105533-gzcbt5g","Type":"NodeParagraph","Properties":{"id":"20240607105533-gzcbt5g","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"主产河南。此外，湖南、湖北、山西、云南、河北、陕西、江苏、浙江、江西、贵州、四川等地亦产。一般以河南博爱，沁阳、武陟、温县等地（古怀庆所属）所产质量最佳，习称\"怀山药\"。"}]},{"ID":"20240607105533-iwgd4ca","Type":"NodeParagraph","Properties":{"id":"20240607105533-iwgd4ca","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"除上述正品山药外，在少数地区尚有以日本薯蓣（长江以南各省多有野生，其块茎习称野山药，土山药，原植物参见\"风车儿\"条）、三角叶薯蓣（分布云南、四川、西藏）等多种薯蓣属植物的块茎也作山药使用。"}]},{"ID":"20240607105533-3qa01z8","Type":"NodeParagraph","Properties":{"id":"20240607105533-3qa01z8","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105533-mnmi0u3","Type":"NodeParagraph","Properties":{"id":"20240607105533-mnmi0u3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 山药：拣去杂质，用水浸泡至山药中心部软化为度，捞出稍晾，切片晒干或烘干。炒山药：先将麸皮均匀撒布于热锅内，俟烟起，加入山药片拌炒至淡黄色为度，取出，筛去麸皮，放凉（每山药片100片，用麸皮10斤）。"}]},{"ID":"20240607105533-lmtdg1t","Type":"NodeParagraph","Properties":{"id":"20240607105533-lmtdg1t","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"《本草衍义》：\"山药入药，其法，冬月以布裹手，用竹刀子剐去皮，于屋檐下风径处，盛竹筛中，不得见日色。一夕干五分，俟全干收之，惟风紧则干速。\""}]},{"ID":"20240607105533-yvje7r5","Type":"NodeParagraph","Properties":{"id":"20240607105533-yvje7r5","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607105533-g7shkgg","Type":"NodeParagraph","Properties":{"id":"20240607105533-g7shkgg","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 入肺、脾、肾经。"}]},{"ID":"20240607105533-qap7y0e","Type":"NodeParagraph","Properties":{"id":"20240607105533-qap7y0e","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"手太阴经。\""}]},{"ID":"20240607105533-dwkz7i9","Type":"NodeParagraph","Properties":{"id":"20240607105533-dwkz7i9","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"②《伤寒蕴要》：\"入手、足太阴二经。\""}]},{"ID":"20240607105533-0hxnwcs","Type":"NodeParagraph","Properties":{"id":"20240607105533-0hxnwcs","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"入手、足太阴经血分，兼入足少阴经气分。\""}]},{"ID":"20240607105533-kzgsch6","Type":"NodeParagraph","Properties":{"id":"20240607105533-kzgsch6","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105533-h13qk9p","Type":"NodeParagraph","Properties":{"id":"20240607105533-h13qk9p","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240607105533-704ts3h","Type":"NodeParagraph","Properties":{"id":"20240607105533-704ts3h","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，温。\""}]},{"ID":"20240607105533-9gfuez5","Type":"NodeParagraph","Properties":{"id":"20240607105533-9gfuez5","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"平，无毒。\""}]},{"ID":"20240607105533-t5pwjcz","Type":"NodeParagraph","Properties":{"id":"20240607105533-t5pwjcz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"③《药性类明》：\"味甘，性凉而润。\""}]},{"ID":"20240607105533-16rczfr","Type":"NodeParagraph","Properties":{"id":"20240607105533-16rczfr","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"生者性凉，熟则化凉为温。\""}]},{"ID":"20240607105533-555vsvk","Type":"NodeParagraph","Properties":{"id":"20240607105533-555vsvk","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607105533-497iu0q","Type":"NodeParagraph","Properties":{"id":"20240607105533-497iu0q","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 有实邪者忌服。"}]},{"ID":"20240607105533-gs90lc2","Type":"NodeParagraph","Properties":{"id":"20240607105533-gs90lc2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"紫芝为之使，恶甘逆。\""}]},{"ID":"20240607105533-jdtvhx7","Type":"NodeParagraph","Properties":{"id":"20240607105533-jdtvhx7","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"②《汤液本草》：\"二门冬为之使。\""}]},{"ID":"20240607105533-kabd82c","Type":"NodeParagraph","Properties":{"id":"20240607105533-kabd82c","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105533-mvtfq3d","Type":"NodeParagraph","Properties":{"id":"20240607105533-mvtfq3d","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 健脾，补肺，固肾，益精。治脾虚泄泻，久痢，虚劳咳嗽，消渴，遗精、带下，小便频数。"}]},{"ID":"20240607105533-w1r8s8h","Type":"NodeParagraph","Properties":{"id":"20240607105533-w1r8s8h","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"补脾养胃，生津益肺，补肾涩精。用于脾虚食少、久泻不止、肺虚喘咳、肾虚遗精、带下、尿频、虚热消渴。麸炒山药补脾健胃。用于脾虚食少，泄泻便溏，白带过多。"}]},{"ID":"20240607105533-71pdq6k","Type":"NodeParagraph","Properties":{"id":"20240607105533-71pdq6k","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤中，补虚，除寒热邪气，补中益气力，长肌肉，久服耳目聪明。\""}]},{"ID":"20240607105533-w93ppg7","Type":"NodeParagraph","Properties":{"id":"20240607105533-w93ppg7","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主头面游风，风头（一作’头风’）眼眩，下气，止腰痛，治虚劳羸瘦，充五脏，除烦热，强钥。\""}]},{"ID":"20240607105533-ybb2cwg","Type":"NodeParagraph","Properties":{"id":"20240607105533-ybb2cwg","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"补五劳七伤，去冷风，止腰痛，镇心神，补心气不足，患人体虚羸，加而用之。\""}]},{"ID":"20240607105533-3qzxff3","Type":"NodeParagraph","Properties":{"id":"20240607105533-3qzxff3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"④《食疗本草》：\"治头疼，助阴力。\""}]},{"ID":"20240607105533-q3jqlai","Type":"NodeParagraph","Properties":{"id":"20240607105533-q3jqlai","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"助五脏，强筋骨，长志安神，主泄精健忘。\""}]},{"ID":"20240607105533-5yghifg","Type":"NodeParagraph","Properties":{"id":"20240607105533-5yghifg","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑥朱震亨：\"生捣贴肿硬毒，能消散。\""}]},{"ID":"20240607105533-jelro6d","Type":"NodeParagraph","Properties":{"id":"20240607105533-jelro6d","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑦《伤寒蕴要》：\"补不足，清虚热。\""}]},{"ID":"20240607105533-xppwh6s","Type":"NodeParagraph","Properties":{"id":"20240607105533-xppwh6s","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"益肾气，健脾胃，止泄痢，化痰涎，润皮毛。\""}]},{"ID":"20240607105533-ypp4qo5","Type":"NodeParagraph","Properties":{"id":"20240607105533-ypp4qo5","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607105533-b0aptxo","Type":"NodeParagraph","Properties":{"id":"20240607105533-b0aptxo","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～6钱；或入丸、散。外用：捣敷。"}]},{"ID":"20240607105533-qp6ltsz","Type":"NodeParagraph","Properties":{"id":"20240607105533-qp6ltsz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607105533-yql2l06","Type":"NodeParagraph","Properties":{"id":"20240607105533-yql2l06","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" ①治脾胃虚弱，不思进饮食：山芋、白术各一两，人参三分。上三味，捣罗为细末，煮白面糊为丸，如小豆·大，每服三十丸，空心食前温米饮下。（《圣济总录》山芋丸）"}]},{"ID":"20240607105533-3kvwn83","Type":"NodeParagraph","Properties":{"id":"20240607105533-3kvwn83","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"②治湿热虚泄：山药、苍术等分，饭丸，米饮服。（《濒湖经验方》）"}]},{"ID":"20240607105533-73ffoz8","Type":"NodeParagraph","Properties":{"id":"20240607105533-73ffoz8","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"③治噤口痢：干山药一半炒黄色，半生用，研为细末，米饮调下。（《百一选方》）"}]},{"ID":"20240607105533-ijnniio","Type":"NodeParagraph","Properties":{"id":"20240607105533-ijnniio","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"④治心腹虚膨，手足厥冷，或饮过苦涩凉剂，晨朝未食先呕，或闻食即吐，不思饮食，此乃脾胃虚弱：山药一味，锉如小豆大，一半炒热，一半生用，为末，米饮调下。（《普济方））"}]},{"ID":"20240607105533-pf83iyk","Type":"NodeParagraph","Properties":{"id":"20240607105533-pf83iyk","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑤补下焦虚冷，小便频敷，瘦损无力：薯蓣于沙盆内研细，入铫中，以酒一大匙，熬令香，旋添酒一盏，搅令匀，空心饮之，每旦一服。（《圣惠方》）"}]},{"ID":"20240607105533-33bvlj3","Type":"NodeParagraph","Properties":{"id":"20240607105533-33bvlj3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑥治诸风眩运，益精髓，壮脾胃：薯蓣粉，同曲米酿酒；或同山茱萸、五味子、人参诸药浸酒煮饮。（《纲目》山药酒）"}]},{"ID":"20240607105533-mmjw9m7","Type":"NodeParagraph","Properties":{"id":"20240607105533-mmjw9m7","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑦治小便多，滑数不禁：白茯苓（去黑皮），干山药（去皮，白矾水内湛过，慢火焙干用之）。上二味，各等分，为细末，稀米饮调服。（《儒门事亲》）"}]},{"ID":"20240607105533-9gs62nm","Type":"NodeParagraph","Properties":{"id":"20240607105533-9gs62nm","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑧治痰气喘急：山药捣烂半碗，入甘蔗汁半碗，和匀，顿热饮之。（《简便单方》）"}]},{"ID":"20240607105533-a9o4pm9","Type":"NodeParagraph","Properties":{"id":"20240607105533-a9o4pm9","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑨治肿毒：山药，蓖麻子，糯米为一处，水浸研为泥，敷肿处。（《普济方》）"}]},{"ID":"20240607105533-uy1xqbh","Type":"NodeParagraph","Properties":{"id":"20240607105533-uy1xqbh","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑩治项后结核，或赤肿硬痛：生山药一挺（去皮），蓖麻子二个。同研贴之。（《救急易方》）"}]},{"ID":"20240607105533-2622x4h","Type":"NodeParagraph","Properties":{"id":"20240607105533-2622x4h","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑾治乳癖结块及诸痛日久，坚硬不溃：鲜山药和芎藭、白糖霜共捣烂涂患处。涂上后奇痒不可忍，忍之良久渐止。（《本经逢原》）"}]},{"ID":"20240607105533-i1gsvol","Type":"NodeParagraph","Properties":{"id":"20240607105533-i1gsvol","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"⑿治冻疮：山药少许，于新瓦上磨为泥，涂疮口上。（《儒门事亲》）"}]},{"ID":"20240607105533-yts0n87","Type":"NodeParagraph","Properties":{"id":"20240607105533-yts0n87","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105533-984hxfb","Type":"NodeParagraph","Properties":{"id":"20240607105533-984hxfb","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607105533-mdafbks","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105533-mdafbks","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"《中华本草》：山药"}]},{"ID":"20240607105533-kwfmqam","Type":"NodeParagraph","Properties":{"id":"20240607105533-kwfmqam","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105533-wai2pmq","Type":"NodeParagraph","Properties":{"id":"20240607105533-wai2pmq","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" Shān Yɑo"}]},{"ID":"20240607105533-fpdq9ov","Type":"NodeParagraph","Properties":{"id":"20240607105533-fpdq9ov","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105533-1c9yxu6","Type":"NodeParagraph","Properties":{"id":"20240607105533-1c9yxu6","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 薯藇、署预、薯蓣、山芋、诸署、署豫、玉延、修脆、薯、山薯、王薯、薯药、怀山药、蛇芋、白苕、九黄姜、野白薯、山板薯、扇子薯、佛掌薯"}]},{"ID":"20240607105533-75nmygv","Type":"NodeParagraph","Properties":{"id":"20240607105533-75nmygv","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607105533-r1f3t65","Type":"NodeParagraph","Properties":{"id":"20240607105533-r1f3t65","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" Common Yam RhizomeWinged Yan Rhizome， Rhizome of Common Yam"}]},{"ID":"20240607105533-fbw93bl","Type":"NodeParagraph","Properties":{"id":"20240607105533-fbw93bl","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607105533-i2sb731","Type":"NodeParagraph","Properties":{"id":"20240607105533-i2sb731","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 侯宁极《药谱》。"}]},{"ID":"20240607105533-7gzjtb4","Type":"NodeParagraph","Properties":{"id":"20240607105533-7gzjtb4","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105533-rt9fhie","Type":"NodeParagraph","Properties":{"id":"20240607105533-rt9fhie","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 药材基源：为薯蓣科植物山药的块茎。"}]},{"ID":"20240607105533-po8y0k3","Type":"NodeParagraph","Properties":{"id":"20240607105533-po8y0k3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dioscorea opposita Thunb.[D.batatas Decne.]"}]},{"ID":"20240607105533-xb9dw3z","Type":"NodeParagraph","Properties":{"id":"20240607105533-xb9dw3z","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"采收和储藏：芦头栽种当年收，珠芽繁殖第2年收，于霜降后叶呈黄色时采挖。洗净泥土，用竹刀或碗片刮去外皮，晒干或烘干，即为毛山药。选择粗大顺直的毛山药，用清水浸匀，再加微热，并用棉被盖好，保持湿润，闷透，然后放在木板上搓揉成圆柱状，将两头切剂，晒干打光，即为光山药。"}]},{"ID":"20240607105533-b3mefk2","Type":"NodeParagraph","Properties":{"id":"20240607105533-b3mefk2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607105533-j34kxc0","Type":"NodeParagraph","Properties":{"id":"20240607105533-j34kxc0","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山坡、山谷林下、溪边、路旁的灌丛或杂草中；或为栽培。"}]},{"ID":"20240607105533-u7ify3o","Type":"NodeParagraph","Properties":{"id":"20240607105533-u7ify3o","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华北、西北、华东和华中地区。"}]},{"ID":"20240607105533-viir7ac","Type":"NodeParagraph","Properties":{"id":"20240607105533-viir7ac","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607105533-w4dfqcn","Type":"NodeParagraph","Properties":{"id":"20240607105533-w4dfqcn","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 薯蓣，缠绕草质藤本。块茎长圆形，垂直生长，长可达1m，新鲜时断面白色，富粘性，干后白色粉质。茎通常带紫红色，右旋，无毛。单叶，在茎下部的互生，中部以上的对生，很少3叶轮生；叶片变异大，卵状三角形至宽卵状戟形，长3-9cm，宽2-7cm，先端渐尖，基部深心形、宽心形或戟形至近截形，边缘常3浅裂至3深裂，中裂片卵状椭圆形至披针形，侧裂片耳状，圆形、近方形至长圆形，两侧裂片与中间裂片相摘自可连成不同的弧线，叶形的变异即使在同一植株上也常有出现。幼苗时一般叶片为宽卵形或卵圆形，基部深心形。叶腋内常有珠芽（零余子）。雌雄异株。雄花序为穗状花序，长2-8cm，近直立；2-8个着生于叶腋，偶而呈圆锥状排列；花序轴明显地呈“之”字形曲折；苞片和花被片有紫褐色斑点；雄花的外轮花瓣片宽卵形，内轮卵形；雄蕊6。雌花序为穗状花序，1-3个着生于叶腋。蒴果不反折，三棱状扁圆形或三棱状圆形，长1.2-2.0cm，宽1.5-3.0cm，外面有白粉。种子着生于每室中轴中部，四周有膜质翅。花期6-9月，果期7-11月。"}]},{"ID":"20240607105533-aes9aoq","Type":"NodeParagraph","Properties":{"id":"20240607105533-aes9aoq","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607105533-xl86n2x","Type":"NodeParagraph","Properties":{"id":"20240607105533-xl86n2x","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 生物学特性 野生于山区向阳的地方，喜温暖，耐寒，在北方稍行覆盖可以越冬。由于山药是一种深根性植物，故栽培地区应选择土层深厚、排水良好、蔬松肥沃的砂质壤土。土壤酸碱度以中性最好，若土壤为酸性，易生支根和根瘤，影响根的产量和质量；过碱，其根部不能充分向下生长。因此，在我国南部地区栽培，于较酸性土壤上应施适量石灰，以中和土壤酸度。 栽培技术 主要用芦头和珠芽（山药豆）繁殖。芦头繁殖：每年10月份将地下根挖出，将山药上部芦头15-25cm长折下，于日光下略晒，使其水分蒸发，经过日晒2-3d，伤口愈合，放入室内或室外挖坑贮藏。坑的深度及盖土厚度以不使芦头受冻为度，河南坑深为40cm，盖土6cm，天冷时覆土至10cm。保持湿润。翌年4月（清明至谷雨）取出，在畦内按行距30-45cm，株距18-20cm，开沟栽种，将芦头顺序平放于沟内，盖土。珠芽繁殖：4月中旬将上年秋天采收珠芽（山药豆）从坑中取出，稍晒，即可进行栽种，行距30cm，株距10-15cm，沟深6cm，将珠芽放入沟内，覆土6cm，约1个月左右的时间，可出芽。 田间管理 出苗后，应设支架，以使茎蔓向上生长，支架材料不限，竹竿、秫秸秆及树枝均可。在5-8月期间，应分次追肥，以粪水及厩肥为主，可结合浇水施用或撒布于根旁。浇水后遇雨，土壤过湿，会使根不向下生长而形成叉根，因此，雨季应注意排水工作，浇水要适量。浇水过多也容易引起锈病，使早期落叶，影响根的产量。 病虫害防治 病害主要有白锈病、褐斑病。白锈病于春季发生；褐斑病夏季发生。防治：①搭支架，使通风良好，不能在险湿积水的地方种植；②用波尔多液1：1：140倍液防治。虫害主要有蛴螬、地老虎，咬食根部。防治：发生时用毒饵诱杀。"}]},{"ID":"20240607105533-mpxf4kn","Type":"NodeParagraph","Properties":{"id":"20240607105533-mpxf4kn","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607105533-2a43yxn","Type":"NodeParagraph","Properties":{"id":"20240607105533-2a43yxn","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）毛山药 略呈圆柱形，稍扁而弯曲，长15-30cm，直径1.5-6cm。表面黄白色或浅棕黄色，有明显纵皱及栓皮未除尽的痕迹，并可见少数须根痕，两头不整齐。质坚实，不易折断，断面白色，颗粒状，粉性，散有浅棕黄色点状物。无臭，味甘，微酸，嚼之发粘。 （2）光山药 呈圆柱形，两端齐平，长7-16cm，直径1.5-3cm，粗细均匀，挺直。表面光滑，洁白，粉性足。均以条粗、质坚实、粉性足、色洁白者为佳。 显微鉴别 块茎横切面：基本组织中粘液细胞类圆形，直径34-85μm，长85-115μm，内含草酸钙针晶束，长约52μm。维管束散在，外韧型，四周有一列薄壁性维管束鞘；后生木质部导管直径约至50μm。树脂道分布在薄壁细胞间，内充满黄褐色树脂物。本品薄壁细胞含众多淀粉粒。 粉末特征：白色或淡黄色。①淀粉粒多单粒，类圆形、长圆形或卵形，直径6-17μm，长17-31μm，脐点点状、飞鸟状，位于较少端，大粒层纹明显。②草酸钙针晶束存在于粘液细胞中，针晶长80-240μm。③导管为具缘纹孔及网纹导管，也有螺纹及环纹导管，直径12-48μm。④筛管分子复筛板上的筛域极为明显，排成网状。⑤纤维少数，细长，直径约14μm，壁甚厚，木化。商品规格 商品分光山药和毛山药。"}]},{"ID":"20240607105533-ruy3vph","Type":"NodeParagraph","Properties":{"id":"20240607105533-ruy3vph","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607105533-3d8otr0","Type":"NodeParagraph","Properties":{"id":"20240607105533-3d8otr0","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 山药块茎含薯蓣皂甙元（diosgenin）0。012%，多巴胺（dopamine），盐酸山药碱（batatasine hydrochloride），多酚氧化酶（polyphenoloxidase），尿囊素（allantoin）止杈素（abscisin）Ⅱ。又含糖蛋白（glucoprotein），水解得：赖氨酸（lysine），组氨酸（histidine），精氨酸（arginine），天冬氨酸（aspartic acid），苏氨酸（threonine），丝氨酸（serine），谷氨酸（glutamic acid），脯氨酸（proline），甘氨酸（glycine），丙氨酸（alanine），缬氨酸（valine），亮氨酸（leucine），异亮氨酸（isoleucine），酷氨酸（tyrosine），苯丙氨酸（phenylalanine）和蛋氨酸（methionine）。还含包括上述氨基酸和胱氨酸（cystine），γ-氨基丁酸（γ-aminobutyric acid）在内的自由氨基酸，另含具降血糖作有用的多糖，并含由甘露糖（mannose），葡萄糖（glucose）和半乳糖（galactose）按摩尔比6.45：1：1.26构成的山药多糖，又含钡、铍、铈、钴、铬、铜、镓、镧、锂、锰、铌、镍、磷、锶、钍、钛、钒、钇、镱、锌、锆以及氧化钠、氧化钾、氧化铝、氧化铁、氧化钙、氧化镁等。根茎含多巴胺、儿茶酚胺（catecholamine），以及胆甾醇（cholesterol），麦角甾醇（ergosterol），菜油甾醇（campesterol），豆甾醇（stigmasterol），β-谷甾醇（β-sitosterol）。粘液中含植酸（phytic acid），甘露多糖（mannan）Ia,Ib和Ic；有人说粘液含多糖40%，蛋白质2%，磷3%和灰分24%，多糖部分由80%的甘露糖和少量的半乳糖，木糖（xylose），果糖（fructose）及葡萄糖所组成。珠芽（零余子）含5种分配性植物生长调节剂，命名为山药素（batatasin）Ⅰ、Ⅱ、Ⅲ、Ⅳ、Ⅴ。还含止杈素，多巴胺和多种甾醇：胆甾烷醇（cholestanol），（24R）-α-甲基胆甾烷醇[（24R）-α-methyl cholestanol]，（24S）-β-甲基胆甾烷醇[（24S）-β-methyl cholestanol]，（24R）-α-乙基胆甾烷醇[（24R）-α-ethyl cholestanol]，胆甾醇，菜油甾醇，（24S）-β-甲基胆甾醇[（24S）-β-methyl cholestanol]，24-亚甲基胆甾醇（24-methylenecholesterol），β-谷甾醇，豆甾醇，异岩藻甾醇（isfucosterol），赬桐甾醇（clerosterol），24-亚甲基-25-甲基胆甾醇（24-emthylene-25-methyl cholesterol），7-胆甾烯醇（lathosterol），8（14）-胆甾烯醇[cholest-8（14）-enol]，（24R）-α-甲基-8（14）-胆甾烯醇[（24R）-α-methyl cholest-8（14）-enol]，（24S）-β-甲基-8（14）-胆甾烯醇[（24S）-β-methyl cholest-8（14）-enol]，（24R）-α-乙基-8（14）-胆甾烯醇[（24R）-α-ethyl cholest-8（14）-enol]。 同属植物日本薯蓣块茎含三萜皂甙，尿囊素，胆碱（choline），17种氨基酸（比山药块茎所含的自由氨基酸缺γ-氨基丁酸）及无机化合物（比山药块茎所含的无机化合物缺镧）。又含修养降血糖活性的日本薯蓣多糖（dioscoran）A、B、C、D、E、F。"}]},{"ID":"20240607105533-pjpnigw","Type":"NodeParagraph","Properties":{"id":"20240607105533-pjpnigw","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607105533-vdxzj0v","Type":"NodeParagraph","Properties":{"id":"20240607105533-vdxzj0v","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 1.降血糖作用1.1对四氧嘧啶糖尿病小鼠血糖的影响昆明种小鼠，体重20.6±1.3g，雄性，随机分组。实验组小鼠iv四氧嘧啶9mg/kg，72h眼眶取血测血糖，选血糖250mg/dl以上者用于实验，分组时组间平均血糖相差不大于10mg/dl，给药组分别ig山药水煎剂30.0g/kg，每天1次；或每天2次（共为60g/kg），给药10日。同时设对照组。末次给药前动物禁食2h，给药后3h眼眶取血，用邻甲苯胺法测定全血葡萄糖。给药组与对照组比较可显着降低正常小鼠和四氧嘧啶糖尿病小鼠的血糖。"}]},{"ID":"20240607105533-drf1gog","Type":"NodeParagraph","Properties":{"id":"20240607105533-drf1gog","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"1.2对肾上腺素引起的小鼠血糖升高的影响小鼠随机分为对照组、肾上腺素组及肾上腺素十山药组。山药水煎剂的给药剂量及给药途径同前，对照组及肾上腺素组每大给予等量的水。末次给药后2小时，肾上腺素十山药组ip肾上腺素0.2mg/kg，对照组ip生理盐水。注射后30分钟取血测血糖，ig山药水煎剂60g/kgx10日可明显对抗肾上腺素引起的小鼠血糖升高。"}]},{"ID":"20240607105533-215b6gs","Type":"NodeParagraph","Properties":{"id":"20240607105533-215b6gs","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"1.3预防给药对四氧嘧啶引起的小鼠血糖升高的影响小鼠随机分组，给药组ig山药水煎剂30，60g/kg，连续10日，同时设对照组。末次给药后3小时，给药组及对照组小鼠iv四氧嘧啶90mg/kg。72小时后取血测血糖，与对照组比较，给药组血糖明显降低，表明山药预防给药能对抗血氧嘧啶引起的小鼠血糖升高。"}]},{"ID":"20240607105533-9wt77wm","Type":"NodeParagraph","Properties":{"id":"20240607105533-9wt77wm","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"1.4对葡萄糖引起的小鼠血糖升高的影响正常小鼠7组，3组给药组，每天ig山药水煎剂30g/kg，另外4个为对照组，末次给药前禁食2小时，然后立即给1组对照组取血，以其血糖作为零时血糖，另外3个给药组及3个对照组于末次给药后1小时ip葡萄糖2g/kg。注射后30，60及120分钟各从1组给药组及1组对照取血，测血糖，与对照组比较，给药组在不同时间的血糖明显低于相应对照组，表明山药能对抗外源葡萄糖引起的小鼠血糖升高。"}]},{"ID":"20240607105533-oihojxr","Type":"NodeParagraph","Properties":{"id":"20240607105533-oihojxr","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"2.调节机体对非特异刺激反应性作用 常压耐缺氧试验 昆明种小鼠22只，分2组，分别ip山药水煎液0.2ml/只（含生药1g/ml），对照组注射生理盐水0.2ml/只，30分钟后装入内装20g碱石灰的广口磨口瓶中，凡士林密封，记录小鼠存活时间。与对照组比较，山药能显着延长小鼠存活时间，具有极显着的常压耐缺氧作用，能明显减轻小鼠脏器受缺氧环境的损害，提高耐受性。"}]},{"ID":"20240607105533-akz3tev","Type":"NodeParagraph","Properties":{"id":"20240607105533-akz3tev","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"3.对免疫功能的影响3.1对免疫器官重量的影响昆明种小鼠20只，实验组连续7日ip山药水煎液0.2ml/只（含生药1g/ml），对照组注射生理盐水0.2ml/只，末次给药24小时后，处死动物，立即称体重、胸腺重和脾脏重，计算胸腺指数和脾指数。与对照组比较，山药可显着增加小鼠的脾脏重量，而对胸腺无明显作用。"}]},{"ID":"20240607105533-2xs4gd2","Type":"NodeParagraph","Properties":{"id":"20240607105533-2xs4gd2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"3.2对小鼠碳粒廓清的影响昆明种小鼠12只，实验组连续7日ip山药水煎液0.2ml/只（含生药ig/ml），对照组注射生理盐水0.2ml/只，末次给药24小时后，每鼠尾iv经处理后的中华碳素墨水0.1ml/10g（市售墨水过滤，稀释3倍），注射后0.5和10分钟，分别由眼后静脉丛取血20ml，溶于21%NaHCO3中静置1小时，于650nm处测定吸收值，计算廓清指数。山药可显着增强小鼠碳粒廓清作用。杨中林等又以碳粒廓清实验为指标，研究了山药生品、麸炒品及土炒品对小白鼠非特异性免疫功能的影响，结果表明各给药组与对照组比较均有非常显着性差异，生品又强于麸炒品和土炒品提示补气用山药生品为宜。"}]},{"ID":"20240607105533-fu3ilgp","Type":"NodeParagraph","Properties":{"id":"20240607105533-fu3ilgp","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"3.3对环磷酰胺制抑免疫的影响昆明种小鼠20只，实验组腹腔连续注射山药多糖溶液0.2ml/只10日，dll注射环磷酰胺0.4ml/只（5mg/ml），dl3取血计白细胞数。山药多糖能极有效地对抗环磷酰胺的抑制免疫作用。"}]},{"ID":"20240607105533-9coj4rv","Type":"NodeParagraph","Properties":{"id":"20240607105533-9coj4rv","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"4.对小鼠小肠运动的影响昆明种小鼠20只，分2组，禁食24h，实验组以山药水煎液10ml（含生药1g/ml）＋0.5g活性炭（市售），对照组以10ml生理盐水＋0.5g活性炭，分别ig。20分钟后，立即用脊髓脱臼法处死，取出小肠铺平，测量碳粉从幽门括约肌推向小肠末端的距离（cm），并计算这一距离占小肠全长的百分数。结果表明山药具有刺激小肠运动、促进肠道内容物排空作用。"}]},{"ID":"20240607105533-en30ic2","Type":"NodeParagraph","Properties":{"id":"20240607105533-en30ic2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"5.其他 所含营养成分和粘液质、淀粉酶有关，有滋补作用，能助消化。止泻。祛痰。"}]},{"ID":"20240607105533-ruz8j95","Type":"NodeParagraph","Properties":{"id":"20240607105533-ruz8j95","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105533-6vv46le","Type":"NodeParagraph","Properties":{"id":"20240607105533-6vv46le","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 山药：拣去杂质，用水浸泡至山药中心部软化为度，捞出稍晾，切片晒干或烘干。炒山药：先将麸皮均匀撒布于热锅内，俟烟起，加入山药片拌炒至淡黄色为度，取出，筛去麸皮，放凉（每山药片100片，用麸皮10斤）。《本草衍义》：山药入药，其法，冬月以布裹手，用竹刀子剐去皮，于屋檐下风径处，盛竹筛中，不得见日色，一夕干五分，俟全干收之，惟风紧则干速。"}]},{"ID":"20240607105533-2q7ajqh","Type":"NodeParagraph","Properties":{"id":"20240607105533-2q7ajqh","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"对家兔肠运动的影响 庞国兴等报道，生山药、清炒、土炒、麸炒4种山药炮制品煎剂对家兔离体肠管节律性活动有明显作用。对肾上腺素产生紧张性降低时，给4种山药煎剂却能使肠管恢复节律，拮抗作用明显。对乙酰胆碱引起肠管紧张性增高时，给于4种山药煎剂均未见肠管紧张性下降或明显恢复节律性活动。4种山药对肠作用差别。认为以清炒、生品、土炒略好。"}]},{"ID":"20240607105533-t353f2h","Type":"NodeParagraph","Properties":{"id":"20240607105533-t353f2h","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607105533-ovaaitf","Type":"NodeParagraph","Properties":{"id":"20240607105533-ovaaitf","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粗粉5g，加水煮沸，滤过，滤液供试验用：①取滤液1ml，加5%氢氧化钠液2滴，再加稀硫酸铜液2滴，呈蓝紫色。（检查蛋白质）。②取滤液1ml，加费林试液1ml，水浴加热，产生红色沉淀。（检查还原糖类）③取滤液滴于滤纸上，滴加1%茚三酮丙酮液2滴，加热后立即显紫色（另以空白试剂对照为负反应）。（检查氨基酸） （2）取药材粉末或切片少许，加浓硝酸1ml，呈鲜黄色。（检查蛋白质）"}]},{"ID":"20240607105533-rzp4qj2","Type":"NodeParagraph","Properties":{"id":"20240607105533-rzp4qj2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607105533-wha7ozk","Type":"NodeParagraph","Properties":{"id":"20240607105533-wha7ozk","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 肺；脾；肾经"}]},{"ID":"20240607105533-7xkaj0n","Type":"NodeParagraph","Properties":{"id":"20240607105533-7xkaj0n","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105533-kwwqhi8","Type":"NodeParagraph","Properties":{"id":"20240607105533-kwwqhi8","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 甘；平"}]},{"ID":"20240607105533-hp0ja38","Type":"NodeParagraph","Properties":{"id":"20240607105533-hp0ja38","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607105533-aoqag36","Type":"NodeParagraph","Properties":{"id":"20240607105533-aoqag36","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 湿盛中满或有实邪、积滞者禁服。"}]},{"ID":"20240607105533-uplg7un","Type":"NodeParagraph","Properties":{"id":"20240607105533-uplg7un","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105533-9s6j7ao","Type":"NodeParagraph","Properties":{"id":"20240607105533-9s6j7ao","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 补脾；养肺；固肾；益精。主脾虚泄泻；食少浮肿；肺虚咳喘；消渴；遗精；带下；肾虚尿频；外用治痈肿；瘰疬"}]},{"ID":"20240607105533-aa1mbm9","Type":"NodeParagraph","Properties":{"id":"20240607105533-aa1mbm9","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607105533-dss3t5l","Type":"NodeParagraph","Properties":{"id":"20240607105533-dss3t5l","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g，大剂量60-250g；或入丸、散。外用：适量，捣敷。补阴，宜生用；健脾止泻，宜炒黄用。"}]},{"ID":"20240607105533-j5idgia","Type":"NodeParagraph","Properties":{"id":"20240607105533-j5idgia","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607105533-8b874i6","Type":"NodeParagraph","Properties":{"id":"20240607105533-8b874i6","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 1.李杲：仲景八味丸用干山药，以其凉而能补也。亦治皮肤干燥，以此物润之。"}]},{"ID":"20240607105533-x4qkqjx","Type":"NodeParagraph","Properties":{"id":"20240607105533-x4qkqjx","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"2.《医经溯洄集》：干山药，虽独入手太阴经，然其功亦能强阴，且手太阴为足少阴之上原，原既有滋，流岂无益。"}]},{"ID":"20240607105533-f5dmnjw","Type":"NodeParagraph","Properties":{"id":"20240607105533-f5dmnjw","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"3.《本草正》：山药，能健脾补虚，滋精固肾，治诸虚百损，疗五劳七伤。第其气轻性缓，非堪专任，故补脾肺必主参、术，补肾水必君茱、地，涩带浊须破故同研，固遗泄仗菟丝相济。诸丸固本丸药，亦宜捣末为糊。总之性味柔弱，但可用力佐使。"}]},{"ID":"20240607105533-cp81wez","Type":"NodeParagraph","Properties":{"id":"20240607105533-cp81wez","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：山药，温补而不骤，微香而不燥，循循有调肺之功，治肺虚久嗽，何其稳当。因其味甘气香，用之助脾，治脾虚腹泻，怠惰嗜卧，四肢困倦。又取其甘则补阳，以能补中益气，温养肌肉，为肺脾二脏要药。土旺生金，金盛生水，功用相仍，故六味丸中用之治肾虚腰痛，滑精梦遗，虚怯阳痿。但性缓力微，剂宜倍用。"}]},{"ID":"20240607105533-q30cy5s","Type":"NodeParagraph","Properties":{"id":"20240607105533-q30cy5s","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"5.《本草求真》：山药，本属食物，古人用入汤剂，谓其补脾益气除热。然气虽温而却平，为补脾肺之阴，是以能润皮毛、长肌肉，不似黄芪性温能补肺阳，白术苦燥能补脾阳也。且其性涩，能治遗精不禁，味甘兼咸，又能益肾强阴，故六味地黄丸用此以佐地黄。然性虽阴而滞不甚，故能渗湿以止泄泻。生捣敷痈疮，消肿硬，亦是补阴退热之意。至云补阳消肿，补气除滞，理虽可通，语涉牵混，似非正说。至入汤剂以治火虚危症，难图近功，必多用之方愈，以其秉性和缓故耳。入滋阴药中宜生用，入补脾宜炒黄用。"}]},{"ID":"20240607105533-atel7j5","Type":"NodeParagraph","Properties":{"id":"20240607105533-atel7j5","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"6.《本草经读》：山药，能补肾填精，精足则阴强、目明、耳聪。凡上品俱是寻常服食之物，非治病之药，故神农另提出久服二字，可见今人每取上品之药，如此物及人参、熟地、葳蕤、阿胶、菟丝子、沙苑蒺藜之类，合为一方，以治大病，误人无算。盖病不速去，元气日伤，伤极则死。凡上品之药，法宜久服，多则终身，少则数年，与五谷之养人相佐，以臻寿考。若大病而需用此药，如五谷为养脾第一品，脾虚之人，强令食谷，即可毕补脾之能事，有是理乎！7.《本经疏证》：薯蓣，主伤中补虚羸，即补中益气力也。而《本经》复言之何故，此盖当连下句读，主伤中、补虚羸，除寒热邪气云者，犹云补伤中而致之虚羸，除伤中而受之寒热邪气也。夫虚必有一处为先，他处乃连类及之者。邪之所凑，虽云其气必虚，然亦有阴阳之分，五藏六府之异；薯蓣所主之虚之邪，须审定其由伤中伤气，方得无误。不然伤血及他伤亦能致虚羸、成寒热，又何别焉。《别录》所主补虚劳羸瘦，充五脏，除烦热，正与《本经》相印，惟下气、止腰痛、强阴三项为特出。至于头面游风、头风、眼眩，唐以来医家不甚用此味，故无从参其底里，然质之仲景治风气百疾，《本经》除寒热邪气，亦可默会其旨矣。。"}]},{"ID":"20240607105533-95krjeu","Type":"NodeParagraph","Properties":{"id":"20240607105533-95krjeu","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"8.其他：《唐本草》：署蓣，日干捣细筛为粉，食之大美，且愈疾而补。此有两种：一者白而且佳；一者青黑，味亦不美。蜀道者尤良。《本草图经》：署预，今处处有之，以北都、四明者为佳。南中有一种生山中，根细如指，极紧实，刮磨入汤煮之，作块不散，味更珍美，云食之尤益人，过于家园种者。又江、湖、闽中出一种根如姜芋之类而皮紫，极有大者，一拔可重斤余，刮去皮，煎煮食之，俱美，但性冷于北地者耳。《植物名实图考》：狂风藤，江西赣南山中有之。赭根绿茎，蔓生柔苒。参差生叶，长柄细韧，似山药叶而长，仅有直纹数道。土人以治风疾。章炳麟：薯蓣一味，开血痹特有神效，血痹虚劳方中风气诸不足，用薯蓣丸。今云南人患脚气者，以生薯蓣切片，散布胫上，以布缠之，约一时许，胫上热痒即愈。《本经》：主伤中，补虚，除寒热邪气，补中益气力，长肌肉，久服耳目聪明。《别录》：主头面游风，风头（一作'头风'）眼眩，下气，止腰痛，治虚劳羸瘦，充五脏，除烦热，强阴。《药性论》：补五劳七伤，去冷风，止腰痛，镇心神，补心气不足，患人体虚羸，加而用之。《食疗本草》：治头疼，助阴力。《日华子本草》：助五脏，强筋骨，长志安神，主泄精健亡。朱震亨：生捣贴肿硬毒，能消散。《伤寒蕴要》：补不足，清虚热。《纲目》：益肾气，健脾胃，止泄痢，化痰涎，润皮毛。"}]},{"ID":"20240607105533-g6wukdx","Type":"NodeParagraph","Properties":{"id":"20240607105533-g6wukdx","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105533-3sc8ndp","Type":"NodeParagraph","Properties":{"id":"20240607105533-3sc8ndp","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607105533-2w1xijf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607105533-2w1xijf","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：山药"}]},{"ID":"20240607105533-8sxh32p","Type":"NodeParagraph","Properties":{"id":"20240607105533-8sxh32p","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607105533-jg40kt0","Type":"NodeParagraph","Properties":{"id":"20240607105533-jg40kt0","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" Shān Yao"}]},{"ID":"20240607105533-yfktwly","Type":"NodeParagraph","Properties":{"id":"20240607105533-yfktwly","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607105533-xlfl6tb","Type":"NodeParagraph","Properties":{"id":"20240607105533-xlfl6tb","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 薯蓣、土蓣、山薯蓣、怀山药、淮山、白山药。"}]},{"ID":"20240607105533-3fknpl9","Type":"NodeParagraph","Properties":{"id":"20240607105533-3fknpl9","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607105533-rhxsfbw","Type":"NodeParagraph","Properties":{"id":"20240607105533-rhxsfbw","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 为薯蓣科薯蓣属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣"},{"Type":"NodeText","Data":"Dioscorea oppo-sita Thunb.[D.batas Decne.],以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"入药。秋季采挖，除去地上部分和须根，洗净，再刮去外皮，晒或烘干至干，或趁鲜切片令干。"}]},{"ID":"20240607105533-g4itt6q","Type":"NodeParagraph","Properties":{"id":"20240607105533-g4itt6q","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607105533-zfb0m07","Type":"NodeParagraph","Properties":{"id":"20240607105533-zfb0m07","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 栽培或野生于山地向阳处。全国最部分地区均有分布。主产于河南、山西、河北、陕西等省。"}]},{"ID":"20240607105533-5n7fbjq","Type":"NodeParagraph","Properties":{"id":"20240607105533-5n7fbjq","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607105533-h79yrus","Type":"NodeParagraph","Properties":{"id":"20240607105533-h79yrus","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 多年生缠绕草本。根状茎短，根直生，肉质肥厚，呈圆柱状棍棒形，长可达1米，直径2"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"7厘米，外皮灰褐色，生多数须根，质脆，断面白色带粘性。茎细长，通常带紫色，有棱线，光滑无毛。叶对生或3片轮生，叶腋常生珠芽名“零余子”，俗称“山药豆”。叶片形状多变化，三角状卵形至三角状宽卵形，长3.5"},{"Type":"NodeText","Data":"7厘米，通常三裂，侧裂片圆耳状，中裂片先端渐尖；叶脉7"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"9条自叶基发出。6"},{"Type":"NodeText","Data":"8月开花，花雌雄异株，极小，黄绿色，均成穗状花序，雄花序直立，雌花序下垂。花乳白色花被6片；雄花有6个雄蕊；雌花花柱3，柱头2歧。蒴果有3棱，呈翅状；种子扁圆形；有宽翅。"}]},{"ID":"20240607105533-ga2lgwk","Type":"NodeParagraph","Properties":{"id":"20240607105533-ga2lgwk","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607105533-m3oh9vs","Type":"NodeParagraph","Properties":{"id":"20240607105533-m3oh9vs","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 喜温暖，耐寒。宜选排水良好、向阳、土从深厚、疏松肥沃的砂质壤土栽培。用芦头繁殖。每年10月将地下根挖出，将上部芦头5"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"8寸长折下作栽子，略晒至伤口愈合后放入窑内贮藏。第二年4月（清明"},{"Type":"NodeText","Data":"谷雨）取出，在畦内按行距1"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"1.5尺开沟，沟距5寸，顺沟平放栽种，株距5"},{"Type":"NodeText","Data":"6寸，覆土2"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"3寸。珠芽繁殖，秋天采收珠芽（山药豆），稍晒后贮藏。第二年4月取出，选大粒圆形、无伤的育栽，按行距1尺开沟，沟深2寸，株距3"},{"Type":"NodeText","Data":"4寸，将珠芽放入沟内，覆土2寸，一个月左右出芽。出苗后，苗高1尺左右，搭架，使茎蔓生长。5~8月追肥，以粪稀及厩肥为主。雨季注意排水，浇水适量，过多引起锈病或早期落叶。"}]},{"ID":"20240607105533-5vf7vmd","Type":"NodeParagraph","Properties":{"id":"20240607105533-5vf7vmd","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607105533-sxs7tmf","Type":"NodeParagraph","Properties":{"id":"20240607105533-sxs7tmf","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 根分含皂甙、粘液质、尿襄素（allan-toin）、胆碱（choline）、精氨酸（arginine）、淀粉酶、蛋白质2.7%、脂肪0.2%、淀粉16%及碘质等。"}]},{"ID":"20240607105533-b0qu4t3","Type":"NodeParagraph","Properties":{"id":"20240607105533-b0qu4t3","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607105533-w4vze62","Type":"NodeParagraph","Properties":{"id":"20240607105533-w4vze62","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒山药"},{"Type":"NodeText","Data":"将山药片放锅内，炒至淡黄色，取出晾凉。"}]},{"ID":"20240607105533-rwd7pva","Type":"NodeParagraph","Properties":{"id":"20240607105533-rwd7pva","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607105533-ph1ks57","Type":"NodeParagraph","Properties":{"id":"20240607105533-ph1ks57","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240607105533-h2pwozo","Type":"NodeParagraph","Properties":{"id":"20240607105533-h2pwozo","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607105533-utikhzz","Type":"NodeParagraph","Properties":{"id":"20240607105533-utikhzz","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 健脾止泻，补肺益肾。脾虚久泻，慢性肠炎，肺虚喘咳，慢性肾炎，糖尿病，遗精，遗尿，白带。用量3~6钱。"}]},{"ID":"20240607105533-m703y0c","Type":"NodeParagraph","Properties":{"id":"20240607105533-m703y0c","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607105533-bjcr5bk","Type":"NodeParagraph","Properties":{"id":"20240607105533-bjcr5bk","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 1.脾虚久泻；山药、党参各4钱，白术茯苓各3钱，六曲2钱，水煎服。"}]},{"ID":"20240607105533-9yoehr0","Type":"NodeParagraph","Properties":{"id":"20240607105533-9yoehr0","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"2.小儿腹泻（水泻）；山药、白术各3钱，滑石粉、车前子各1钱，甘草0.5钱，水煎服。"}]},{"ID":"20240607105533-g6s5r7q","Type":"NodeParagraph","Properties":{"id":"20240607105533-g6s5r7q","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"3.糖尿病；山药、天花粉、沙参各5钱，知母、五味子各3钱，水煎服。"}]},{"ID":"20240607105533-tweekum","Type":"NodeParagraph","Properties":{"id":"20240607105533-tweekum","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607105533-4gt5pn8","Type":"NodeParagraph","Properties":{"id":"20240607105533-4gt5pn8","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 同属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野山药"},{"Type":"NodeText","Data":"Dioscorea japonica Thu-nb.与前种的区别是茎和叶都不带紫色，花序轴呈螺丝状弯曲。野生于我国各地。其根亦作山药入药，功效类同。"}]},{"ID":"20240607105533-rf3wtdv","Type":"NodeParagraph","Properties":{"id":"20240607105533-rf3wtdv","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607105533-j48k6r2","Type":"NodeParagraph","Properties":{"id":"20240607105533-j48k6r2","updated":"20240607105533"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607105535-y1vbr84","Type":"NodeThematicBreak","Properties":{"id":"20240607105535-y1vbr84"}},{"ID":"20240607105536-70ts7g8","Type":"NodeParagraph","Properties":{"id":"20240607105536-70ts7g8"}}]}