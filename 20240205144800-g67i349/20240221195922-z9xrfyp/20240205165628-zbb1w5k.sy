:"​"}]},{"ID":"20240811093931-mcj6get","Type":"NodeParagraph","Properties":{"id":"20240811093931-mcj6get","updated":"20240811100303"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 741px;","style":"width: 731px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"女贞子 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/女贞子 3-20240811093931-x2xozx5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 731px;\" parent-style=\"width: 741px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 461px;","style":"width: 451px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"女贞子 (20)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/女贞子 20-20240811100303-8anhes9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 451px;\" parent-style=\"width: 461px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811094458-2y1nkev","Type":"NodeParagraph","Properties":{"id":"20240811094458-2y1nkev","updated":"20240811100950"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"女贞子 (23)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/女贞子 23-20240811100943-he502kn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 545px;","style":"width: 535px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"女贞子 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/女贞子 5-20240811094458-u1jurx8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 535px;\" parent-style=\"width: 545px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607151241-4gn1h3j","Type":"NodeThematicBreak","Properties":{"id":"20240607151241-4gn1h3j"}},{"ID":"20240617111251-y2qvvbi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111251-y2qvvbi","updated":"20240617111251"},"Children":[{"Type":"NodeText","Data":"女贞实《神农本草经》"}]},{"ID":"20240617111251-b2az404","Type":"NodeParagraph","Properties":{"id":"20240617111251-b2az404","updated":"20240617111251"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240617111251-ae8imsy","Type":"NodeParagraph","Properties":{"id":"20240617111251-ae8imsy","updated":"20240617111251"},"Children":[{"Type":"NodeText","Data":"主补中，安五藏，养精神，除百疾。久服肥健，轻身不老。生山谷。"}]},{"ID":"20240617111251-a86prk8","Type":"NodeParagraph","Properties":{"id":"20240617111251-a86prk8","updated":"20240617111251"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生武陵，立冬采。"}]},{"ID":"20240617111251-4gsp8ao","Type":"NodeParagraph","Properties":{"id":"20240617111251-4gsp8ao","updated":"20240617111251"},"Children":[{"Type":"NodeText","Data":"案《说文》云：桢，刚木也。东山经云：太山上多桢木。郭璞云：女桢也，叶冬不凋。《毛诗》云：南山有杞。陆玑云：木杞，其树如樗（陈藏器作栗），一名狗骨，理白滑，其子为木虻子，可合药，《司马相如赋》有女贞。师古曰：女贞树，冬夏常青，未尝凋落，若有节操，故以名为焉。陈藏器云：冬青也。"}]},{"ID":"20240617111251-hwf5ens","Type":"NodeThematicBreak","Properties":{"id":"20240617111251-hwf5ens","updated":"20240617111251"}},{"ID":"20240607151247-muwezs3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151247-muwezs3","updated":"20240607151304"},"Children":[{"Type":"NodeText","Data":"女贞子《本草述钩元》"}]},{"ID":"20240607151247-hxg0j74","Type":"NodeParagraph","Properties":{"id":"20240607151247-hxg0j74","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"一名冬青。然冬青子红。此树子黑。当另是一种。或云即蜡树。寄虫造白蜡者。"}]},{"ID":"20240607151247-kvpvqvy","Type":"NodeParagraph","Properties":{"id":"20240607151247-kvpvqvy","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"味苦甘。气寒。气薄味浓。阴中之阴。降也。入足少阴经。纲目主强阴。健腰膝。变白发。明目。称为上品无毒妙药。典术言女贞本少阴之精。冬不落叶。故其益肾之功可推。"}]},{"ID":"20240607151247-5mrq1xa","Type":"NodeParagraph","Properties":{"id":"20240607151247-5mrq1xa","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"禀天地至阴之气。今人用以变白辄效。应是甘寒凉血益血之药。（仲淳）女贞子气味俱阴。"}]},{"ID":"20240607151247-bqgrwsq","Type":"NodeParagraph","Properties":{"id":"20240607151247-bqgrwsq","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"为入肾除热补精之要品。凡肾阴虚而有热者。此为对待之剂同地黄首乌人参麦冬牛膝枸杞山药旱莲草南烛子没食子桑椹黄柏椒红莲须。为变白要药。同杞子甘菊生地蒺藜。能明目。乌髭须。女贞子一斗。如法去皮。老酒浸一宿。每斗用马料黑豆一斗。淘净晒干。同蒸透。"}]},{"ID":"20240607151247-encih40","Type":"NodeParagraph","Properties":{"id":"20240607151247-encih40","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"九蒸九晒。各为末。加山姜（即苍术）自然汁三两。川椒净末三两。于女贞末内同黑豆末和匀。蜜丸梧子大。先食服四五钱。日汤或酒吞。又方。采鲜鳢肠草二三十斤。捣汁。入九蒸九晒过女贞子末。再晒干为丸亦得。但服之腹痛作泄。不若山姜汁椒末为佳。更服八珍丸以实根本。或用川椒末和女贞子末。等分为丸。腹即不痛。盖女贞补血海纯阴。有川椒从天表之阳。直入命门而补元阳。即能令元阴有主得以施化。此亦不必九蒸九晒也。缪氏更定凉血理脾方。何首乌（乌豆同牛膝蒸制如法。后用人乳浸晒三四十次。）赤白各二斤。女贞子酒拌。九蒸九晒。二斤。旱莲草膏十二两。南烛子膏十二两。茅术泔浸。蒸晒三次。去皮切十二两。真川椒红去白膜闭口者。十二两。没石子十两。为末。以旱莲乌饭子二膏。同炼蜜和丸。梧子大。每空心饥时。各服五钱。白汤吞。加减地黄丸。治男子天元受伤。精气耗损。胃虚劳热。骨体空虚。肾衰阳痿。精泄不施。或生而不育。久服愈百病。长精神。"}]},{"ID":"20240607151247-khjv7lf","Type":"NodeParagraph","Properties":{"id":"20240607151247-khjv7lf","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"有生生广嗣之妙。大生地一斤酒浸。柳木甑蒸烂。摊开竹筛内。日晒。夜收地上。如是蒸晒九次。听用。白茯苓怀山药（乳浸晒干三次）丹皮（酒浸一宿晒干）山萸肉（雄半油炙）何首乌（同黑豆九蒸九晒）枸杞子（蒸熟）金樱子（蒸熟）女贞子（酒浸一宿蒸熟）各八两。"}]},{"ID":"20240607151247-smn0x64","Type":"NodeParagraph","Properties":{"id":"20240607151247-smn0x64","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"配地黄炼蜜。为丸梧子大。每日空心。用白汤或淡酒下八九十丸。杞龙丸。治劳伤过度。"}]},{"ID":"20240607151247-94awaib","Type":"NodeParagraph","Properties":{"id":"20240607151247-94awaib","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"忧愁思虑。心火烁肺。肾水不足。服之能健男子脾胃。调女子经水。枸杞子酒润六两。龙眼肉半斤。熟地一斤。当归酒净六两。人参三两。麦冬七两。五味子去核一两。丹参四两。茯苓乳浸晒干。二次。四两。怀山药六两。何首乌黑豆九蒸九晒。二两。续断四两。女贞子酒浸一宿晒干。六两。丹皮酒净四两。黄连酒炒一次三两。石斛一斤。先将石斛煎浓汁。又将山药焙。投入石斛汁内。收干再晒。配众药末。炼蜜丸梧子大。每服百丸。空心。淡酒或白汤下。久服令人多子。"}]},{"ID":"20240607151247-ize2ys7","Type":"NodeParagraph","Properties":{"id":"20240607151247-ize2ys7","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"〔论〕人身有阴中之气。有阴中之血。益阴诸味。从阴气盛而化血者。与阴血盛而和气者。不可一例视。女贞子入血海益血而和气以上荣。故其效于髭须更着。他味虽如侧柏子凌冬。与女贞同益阴血。而用固迥殊。盖万物向阳。柏独西指。乃受金之正气者也。惟宜于吐血诸证。以坚金之气。因母护子。使不为淫火所烁。若女贞则负至阴之贞。由肾至肺。并以淫精于上下。不独髭须为然。即广嗣方中多用之。又石菖蒲亦秉至阴。四序长清。然苦辛开心和血而帅气。更不同于女贞实之用也。夫人知阳为阴先。不知阴气之盛者。更由于阴血之足。阴血足而后阴气乃得上荣于唇口。以阳源出阴中。阴中之阳。即所谓阴气也。经曰。"}]},{"ID":"20240607151247-99i65u6","Type":"NodeParagraph","Properties":{"id":"20240607151247-99i65u6","updated":"20240607151247"},"Children":[{"Type":"NodeText","Data":"至阴虚。天气绝。此即血脱者。不能致其阴气于天表之明证。再冲脉之上俞在大抒。大抒者足太阳穴也。下俞在巨虚之上下。此胃穴也。先天之气与后天之气合。而后阴血充。以上下行。故乌须者用此。必兼理脾胃。"}]},{"ID":"20240607151232-kmkqmyo","Type":"NodeThematicBreak","Properties":{"id":"20240607151232-kmkqmyo"}},{"ID":"20240607151233-fjxuena","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151233-fjxuena","updated":"20240607151238"},"Children":[{"Type":"NodeText","Data":"女贞子《玉楸药解》"}]},{"ID":"20240607151233-8lcikts","Type":"NodeParagraph","Properties":{"id":"20240607151233-8lcikts","updated":"20240607151233"},"Children":[{"Type":"NodeText","Data":"味苦，气平，入足少阴肾、足厥阴肝经。强筋健骨，秘精壮阳，补益精血，长养精神。"}]},{"ID":"20240607151233-yyrymqt","Type":"NodeParagraph","Properties":{"id":"20240607151233-yyrymqt","updated":"20240607151233"},"Children":[{"Type":"NodeText","Data":"女贞子隆冬苍翠，非其温暖之性，不能如是。"}]},{"ID":"20240607151221-pad268x","Type":"NodeThematicBreak","Properties":{"id":"20240607151221-pad268x"}},{"ID":"20240607151222-bcw2ohk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151222-bcw2ohk","updated":"20240607151227"},"Children":[{"Type":"NodeText","Data":"女贞《本草纲目》"}]},{"ID":"20240607151222-hojcnnl","Type":"NodeParagraph","Properties":{"id":"20240607151222-hojcnnl","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"「释名」贞女、冬青、蜡树。"}]},{"ID":"20240607151222-8khmujr","Type":"NodeParagraph","Properties":{"id":"20240607151222-8khmujr","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"「气味」（实）苦、平、无毒。"}]},{"ID":"20240607151222-yvkbsag","Type":"NodeParagraph","Properties":{"id":"20240607151222-yvkbsag","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240607151222-xuk2ztl","Type":"NodeParagraph","Properties":{"id":"20240607151222-xuk2ztl","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"1、补肾滋阴。取女贞子，去梗叶，浸酒中一日夜，擦去皮，晒干，研为末，待早莲草出时，采数石，捣汁熬浓，和末做成丸子，如梧子大。每夜服百丸，酒送下。十多天之后，体力增加，老人不再起夜。又能变白发为黑色，强腰膝，起阴气。又方：用初冬采收后阴干的女贞实，酒浸一日，蒸透晒干，取一斤四两；夏季采收并阴干的旱莲草，取十两；晚春采收并阴干的桑椹子，取十两。三味共研为末，加炼蜜做成丸子如梧子大。每服七、八直丸，淡盐汤送睛。若是五月份采的又桑椹，八月份采的旱莲，则可直接捣汁和药，不用加蜜。"}]},{"ID":"20240607151222-6a8xz7m","Type":"NodeParagraph","Properties":{"id":"20240607151222-6a8xz7m","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"2、风热赤眼。用女贞子不限量，捣汁熬膏，净瓶收存，埋地中七日后，取以点眼。"}]},{"ID":"20240607151222-efkwe7l","Type":"NodeParagraph","Properties":{"id":"20240607151222-efkwe7l","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"3、口舌生疮，舌肿胀出。取女贞叶捣汁含浸吐涎。"}]},{"ID":"20240607151222-l47x2dr","Type":"NodeParagraph","Properties":{"id":"20240607151222-l47x2dr","updated":"20240607151222"},"Children":[{"Type":"NodeText","Data":"4、一切眼疾，用女贞叶捣烂，加朴硝调匀贴眼部。"}]},{"ID":"20240607151153-fffzyzn","Type":"NodeThematicBreak","Properties":{"id":"20240607151153-fffzyzn"}},{"ID":"20240607151202-j8fojsn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151202-j8fojsn","updated":"20240607151215"},"Children":[{"Type":"NodeText","Data":"女贞子《本草经解》"}]},{"ID":"20240607151202-u6n1d81","Type":"NodeParagraph","Properties":{"id":"20240607151202-u6n1d81","updated":"20240607151202"},"Children":[{"Type":"NodeText","Data":"气平．味苦．无毒．主补中．安五脏．养精神．除百疾．久服肥健．轻身不老．女贞子气平．禀天秋收之金气．入手太阴肺经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．中者阴之守也．五脏者藏阴者也．女贞气平益肺．肺为津液之化源．所以补中而脏安也．心者神之居．肺者水之母．入心肺而益阴．阴足气充．气充神旺精生．所以主养精神也．气失其平则为病．女贞气平．肺主气．气得其平．百病皆除矣．人身有形之皮肉筋骨．皆属阴者也．女贞平苦益阴．则肌肉自丰．筋骨自健也．心者生之本．其华在面．肺者气之源．气足则身轻．血华故不老也．"}]},{"ID":"20240607151202-wpox5su","Type":"NodeParagraph","Properties":{"id":"20240607151202-wpox5su","updated":"20240607151202"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240607151202-1prhc5a","Type":"NodeParagraph","Properties":{"id":"20240607151202-1prhc5a","updated":"20240607151202"},"Children":[{"Type":"NodeText","Data":"女贞同甘菊、生地、杞子、蒺藜．治目昏暗．捣汁熬膏．埋地中七日．点风热赤眼．"}]},{"ID":"20240607151140-h7erj6r","Type":"NodeThematicBreak","Properties":{"id":"20240607151140-h7erj6r"}},{"ID":"20240607151147-55gtpdd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151147-55gtpdd","updated":"20240607151152"},"Children":[{"Type":"NodeText","Data":"女贞实《侣山堂类辩》"}]},{"ID":"20240607151147-v0r9vbo","Type":"NodeParagraph","Properties":{"id":"20240607151147-v0r9vbo","updated":"20240607151147"},"Children":[{"Type":"NodeText","Data":"女贞子，乃本经上品，气味苦平，主补中，安五脏，养精神，除百病，久服肥健，轻身不老，强阴，健腰膝，变白发，明目。即蜡树也。立夏前后，取蜡虫种子，裹置枝上，半月后，其虫化出，延缘枝上，造成白蜡，坚白如凝脂，犹蚕食桑而成丝，连绵温暖，皆得树质精华，是以桑根白皮，主伤中，五劳六极，羸瘦，崩中绝脉，补虚益气。女贞虽与冬青同名，其种实异。冬青名冻青，叶微圆，子赤色，虫不造蜡为别也。世俗混用冻青，实二物，功用迥别。采择者，不可不辨！"}]},{"ID":"20240607151133-zijk48y","Type":"NodeThematicBreak","Properties":{"id":"20240607151133-zijk48y"}},{"ID":"20240607151133-1idkegj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151133-1idkegj","updated":"20240607151138"},"Children":[{"Type":"NodeText","Data":"女贞实《本草经集注》"}]},{"ID":"20240607151133-leilv2b","Type":"NodeParagraph","Properties":{"id":"20240607151133-leilv2b","updated":"20240607151133"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主治补中，安五脏，养精神，除百疾，久服肥健，轻身，不老，生武陵川谷。立冬采。"}]},{"ID":"20240607151133-mcv6hm5","Type":"NodeParagraph","Properties":{"id":"20240607151133-mcv6hm5","updated":"20240607151133"},"Children":[{"Type":"NodeText","Data":"叶茂盛，凌冬不凋，皮青肉白，与秦皮为表里，其树以冬生而可爱，诸处时有。《仙经》"}]},{"ID":"20240607151133-uf5jwrl","Type":"NodeParagraph","Properties":{"id":"20240607151133-uf5jwrl","updated":"20240607151133"},"Children":[{"Type":"NodeText","Data":"亦服食之，世方不复用，市人亦无识之者。（《新修》一○四页，《大观》卷十二，《政和》三○六页）"}]},{"ID":"20240607151035-jeyprzr","Type":"NodeThematicBreak","Properties":{"id":"20240607151035-jeyprzr"}},{"ID":"20240607151107-nphwmiw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151107-nphwmiw","updated":"20240607151114"},"Children":[{"Type":"NodeText","Data":"女贞实《证类本草》"}]},{"ID":"20240607151121-6l4rse9","Type":"NodeParagraph","Properties":{"id":"20240607151121-6l4rse9","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主补中，安五脏，养精神，除百疾。久服肥健，轻身不老。"}]},{"ID":"20240607151121-0lca7vi","Type":"NodeParagraph","Properties":{"id":"20240607151121-0lca7vi","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"生武陵川谷，立冬采。"}]},{"ID":"20240607151121-7dflwk7","Type":"NodeParagraph","Properties":{"id":"20240607151121-7dflwk7","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶叶茂盛，凌冬不凋，皮青肉白，与秦皮为表里。其树以冬生而可爱。诸处时有。《仙经》亦服食之。俗方不复用，市人亦无识者。唐本注云∶女贞，叶似枸骨及冬青树等。其实九月熟，黑似牛李子。陶云与秦皮为表里，误矣。然秦皮叶细冬枯，女贞叶大冬茂，殊有之。"}]},{"ID":"20240607151121-egmpfgz","Type":"NodeParagraph","Properties":{"id":"20240607151121-egmpfgz","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶女贞似枸骨。按枸骨树如杜仲，皮堪浸酒，补腰脚令健。枝、叶烧灰淋取汁，涂白癜风。亦可作稠煎敷之。木肌白似骨，故云枸骨。《诗·义疏》云∶木杞，其树似栗。"}]},{"ID":"20240607151121-943s4sr","Type":"NodeParagraph","Properties":{"id":"20240607151121-943s4sr","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"一名枸骨。理白滑，其子为木虻子。可合药，木虻在叶中卷叶，如子羽化为虻，非木子。"}]},{"ID":"20240607151121-v8fhria","Type":"NodeParagraph","Properties":{"id":"20240607151121-v8fhria","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"又云冬青，其叶堪染绯，子浸酒去风血补益，木肌白有纹作象齿笏，冬月青翠，故名冬青。"}]},{"ID":"20240607151121-tnh1dca","Type":"NodeParagraph","Properties":{"id":"20240607151121-tnh1dca","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"江东人呼为冻生。李邕又云∶出五台山。叶似椿，子赤如郁李，微酸，性热。与此亦小有异同，当是两种冬青。日华子云∶冬青皮，凉，无毒。去血，补益肌肤。"}]},{"ID":"20240607151121-044so1r","Type":"NodeParagraph","Properties":{"id":"20240607151121-044so1r","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"图经曰∶女贞实，生武凌川谷，今处处有之。《山海经》云∶泰山多真木，是此木也。"}]},{"ID":"20240607151121-dbi6xyx","Type":"NodeParagraph","Properties":{"id":"20240607151121-dbi6xyx","updated":"20240607151121"},"Children":[{"Type":"NodeText","Data":"其叶似枸骨及冬青，木极茂盛，凌冬不凋，花细青白色。九月而实成，似牛李子。立冬采实，曝干。其皮可以浸酒。或云∶即今冬青木也。而冬青木肌理白，纹如象齿，道家取以为简，其实亦浸酒，去风补血。其叶烧灰，面膏涂之。治瘅瘃殊效，兼灭瘢疵。又李邕云∶五台山冬青，叶似椿，子如郁李。微酸，性热，与此小有同异，当是别有一种耳。又岭南有一种女贞，花极繁茂而深红色，与此殊异，不闻中药品也。枸骨木多生江、浙间，木体白似骨，故以名。南人取以旋作合器甚佳。《诗·小雅》云∶南山有枸。陆机云∶山木，其状如栌。一名枸骨。理白可为函板者是此也。皮亦堪浸酒，补腰膝。烧其枝叶为灰，淋汁涂白癜风。亦可作煎敷之。"}]},{"ID":"20240607151046-jud74op","Type":"NodeThematicBreak","Properties":{"id":"20240607151046-jud74op"}},{"ID":"20240607151039-qvv6mmb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151039-qvv6mmb","updated":"20240607151044"},"Children":[{"Type":"NodeText","Data":"女贞实《新修本草》"}]},{"ID":"20240607151039-1i77zg1","Type":"NodeParagraph","Properties":{"id":"20240607151039-1i77zg1","updated":"20240607151039"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主补中，安五脏，养精神，除百疾，久服肥健，轻身不老。生武陵川谷。立冬采。"}]},{"ID":"20240607151039-be3cw8z","Type":"NodeParagraph","Properties":{"id":"20240607151039-be3cw8z","updated":"20240607151039"},"Children":[{"Type":"NodeText","Data":"叶茂盛，凌冬不凋，皮青肉白，与秦皮为表里，其树以冬生而可爱，诸处时有。《仙经》"}]},{"ID":"20240607151039-r1lcu1y","Type":"NodeParagraph","Properties":{"id":"20240607151039-r1lcu1y","updated":"20240607151039"},"Children":[{"Type":"NodeText","Data":"亦服食之，俗方不复用，市人亦无识之者。"}]},{"ID":"20240607151039-9gfrjc4","Type":"NodeParagraph","Properties":{"id":"20240607151039-9gfrjc4","updated":"20240607151039"},"Children":[{"Type":"NodeText","Data":"〔谨案〕女贞叶，似枸骨及冬青树等，其实九月熟黑，似牛李子。陶云与秦皮为表里，误矣。然秦皮叶细冬枯，女真叶大冬茂，殊非类也。"}]},{"ID":"20240607150905-6df2s46","Type":"NodeThematicBreak","Properties":{"id":"20240607150905-6df2s46"}},{"ID":"20240607151024-ijwbaef","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151024-ijwbaef","updated":"20240607151033"},"Children":[{"Type":"NodeText","Data":"女贞子《本草新编》"}]},{"ID":"20240607151024-7wqsv3t","Type":"NodeParagraph","Properties":{"id":"20240607151024-7wqsv3t","updated":"20240607151024"},"Children":[{"Type":"NodeText","Data":"女贞子，味苦、甘，气平，无毒，入肾经。黑须乌发，壮筋强力，安五脏，补中气，除百病养精神。多服，补血祛风，健身不老。近人多用之，然其力甚微，可入丸以补虚，不便入汤以滋益。与熟地、枸杞、南烛、麦冬、首乌、旱莲草、乌芝麻、山药、桑椹、茄花、杜仲、白术同用，真变白之神丹也。然又为丸则验，不可责其近效也。"}]},{"ID":"20240607151024-lisioo9","Type":"NodeParagraph","Properties":{"id":"20240607151024-lisioo9","updated":"20240607151024"},"Children":[{"Type":"NodeText","Data":"或问女贞既善黑须，又有诸益，自宜入汤剂中，以收其功，何以不宜乎？夫女贞子功缓，入在汤剂中，实无关于重轻，无之不见损，有之不见益。若必欲入汤剂，非加入一两不可，然而过多，则又与胃不相宜。盖女贞少用则气平，多用则气浮也。"}]},{"ID":"20240607151024-uhlbyqv","Type":"NodeParagraph","Properties":{"id":"20240607151024-uhlbyqv","updated":"20240607151024"},"Children":[{"Type":"NodeText","Data":"女贞子，非冬青也。冬青子大，而女贞子小，冬青子长，而女贞子圆也。若用冬青更为寒凉，尤无功效，未可因《本草》言是一种，而采家园之冬青子以入药也。"}]},{"ID":"20240607151024-keuop1z","Type":"NodeParagraph","Properties":{"id":"20240607151024-keuop1z","updated":"20240607151024"},"Children":[{"Type":"NodeText","Data":"或疑女贞子为长生之药，而子以为无足重轻，何以又誉之为变白之神丹乎？曰∶余前言其有功者，附之于诸补阴药中为丸，以变白也，后言其无足重轻者，欲单恃之作汤，难速效也。"}]},{"ID":"20240607151024-yn390ex","Type":"NodeParagraph","Properties":{"id":"20240607151024-yn390ex","updated":"20240607151024"},"Children":[{"Type":"NodeText","Data":"女贞子缓则有功，而速则寡效，故用之速，实不能取胜于一时；而用之缓，实能延生于永久，亦在人用之得宜耳。"}]},{"ID":"20240607150905-1cm9ko9","Type":"NodeThematicBreak","Properties":{"id":"20240607150905-1cm9ko9"}},{"ID":"20240607150910-i1kgv4h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150910-i1kgv4h","updated":"20240607150915"},"Children":[{"Type":"NodeText","Data":"女贞实《本草崇原》"}]},{"ID":"20240607150910-1tu2f8p","Type":"NodeParagraph","Properties":{"id":"20240607150910-1tu2f8p","updated":"20240607150910"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主补中，安五脏，养精神，除百病。久服肥健，轻身不老。"}]},{"ID":"20240607150910-gr4gsr3","Type":"NodeParagraph","Properties":{"id":"20240607150910-gr4gsr3","updated":"20240607150910"},"Children":[{"Type":"NodeText","Data":"（女贞木始出武陵山谷，今处处有之。叶似冬青，凌冬不落。五月开细青白花，结实，九月熟，紫黑色，放虫造成白蜡者，女贞也。无蜡者，冬青也。）"}]},{"ID":"20240607150910-dfhn8eo","Type":"NodeParagraph","Properties":{"id":"20240607150910-dfhn8eo","updated":"20240607150910"},"Children":[{"Type":"NodeText","Data":"三阳为男，三阴为女，女贞禀三阴之气，岁寒操守，因以为名。味苦性寒，得少阴肾水之气也。凌冬不凋，得少阴君火之气也。作蜡坚白，得太阴肺金之气也。结实而园，得太阴脾土之气也。四季常青，得厥阴肝木之气也。女贞属三阴而禀五脏五行之气，故主补中，安五脏也。水之精为精，火之精为神，禀少阴水火之气，故养精神。人身百病，不外五行，女贞备五脏五行之气，故除百病。久服则水火相济，五脏安和，故肥健，轻身不老。"}]},{"ID":"20240607150824-09qtada","Type":"NodeThematicBreak","Properties":{"id":"20240607150824-09qtada"}},{"ID":"20240607150837-sk933vt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150837-sk933vt","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：女贞子"}]},{"ID":"20240607150837-cv0bj7r","Type":"NodeParagraph","Properties":{"id":"20240607150837-cv0bj7r","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607150837-hpwd9xx","Type":"NodeParagraph","Properties":{"id":"20240607150837-hpwd9xx","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" Nǚ Zhēn Zǐ"}]},{"ID":"20240607150837-rmwsinz","Type":"NodeParagraph","Properties":{"id":"20240607150837-rmwsinz","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607150837-gdvwo4a","Type":"NodeParagraph","Properties":{"id":"20240607150837-gdvwo4a","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 爆格蚤、冬青子[河北、江苏、福建、广西、云南]"}]},{"ID":"20240607150837-al2flo2","Type":"NodeParagraph","Properties":{"id":"20240607150837-al2flo2","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607150837-3m12s4g","Type":"NodeParagraph","Properties":{"id":"20240607150837-3m12s4g","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" FRUCTUS LIGUSTRI LUCIDI"}]},{"ID":"20240607150837-scshoa9","Type":"NodeParagraph","Properties":{"id":"20240607150837-scshoa9","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607150837-hnnrgxe","Type":"NodeParagraph","Properties":{"id":"20240607150837-hnnrgxe","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 本品为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"女贞"},{"Type":"NodeText","Data":"Ligustrum lucidum Ait. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。冬季果实成熟时采收，除去枝叶，稍蒸或置沸水中略烫后，干燥；或直接干燥。"}]},{"ID":"20240607150837-68w2gjz","Type":"NodeParagraph","Properties":{"id":"20240607150837-68w2gjz","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"注：同属植物藏"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"女贞子"},{"Type":"NodeText","Data":"Ligustrum thibeticum Decne.，其果实在西藏也作女贞子入药，功效相似。"}]},{"ID":"20240607150837-7jisqs8","Type":"NodeParagraph","Properties":{"id":"20240607150837-7jisqs8","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607150837-zmuqp57","Type":"NodeParagraph","Properties":{"id":"20240607150837-zmuqp57","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 常绿大灌木或乔木，高达10米。树干直立，树皮灰绿色，光滑不裂，枝开展，平滑无毛，具明显皮孔。叶对生，卵形至卵状披针形。夏季开白色小花，圆锥花序顶生，花芳香，密集，几乎无梗。浆果状核果，长圆形，一侧稍凸，长约1厘米，熟时蓝黑色。"}]},{"ID":"20240607150837-hpujjev","Type":"NodeParagraph","Properties":{"id":"20240607150837-hpujjev","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607150837-qaukv8a","Type":"NodeParagraph","Properties":{"id":"20240607150837-qaukv8a","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 本品呈卵形、椭圆形或肾形，长6～8.5mm，直径3.5～5.5mm。表面黑紫色或灰黑色，皱缩不平，基部有果梗痕或具宿萼及短梗。体轻。外果皮薄，中果皮较松软，易剥离，内果皮木质，黄棕色，具纵棱，破开后种子通常为1粒，肾形，紫黑色，油性。无臭，味甘、微苦涩。"}]},{"ID":"20240607150837-47fmf5o","Type":"NodeParagraph","Properties":{"id":"20240607150837-47fmf5o","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607150837-02p0qma","Type":"NodeParagraph","Properties":{"id":"20240607150837-02p0qma","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240607150837-3d7gani","Type":"NodeParagraph","Properties":{"id":"20240607150837-3d7gani","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607150837-0u4gf9d","Type":"NodeParagraph","Properties":{"id":"20240607150837-0u4gf9d","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒女贞子"},{"Type":"NodeText","Data":"：取拣净的女贞子用黄酒拌匀，放入罐内或其它容器内，封严，再放入加水的锅内，蒸至酒被吸尽，取出晾干（每100斤用黄酒20斤）。"}]},{"ID":"20240607150837-3d4z3o9","Type":"NodeParagraph","Properties":{"id":"20240607150837-3d4z3o9","updated":"20240607150837"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蒸女贞子"},{"Type":"NodeText","Data":"：将拣净的女贞子放入罐内或其它容器，封严，再放在加水的锅内，蒸透，取出晾干。"}]},{"ID":"20240607150837-e3m2nw6","Type":"NodeParagraph","Properties":{"id":"20240607150837-e3m2nw6","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607150837-u88a4nz","Type":"NodeParagraph","Properties":{"id":"20240607150837-u88a4nz","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 取本品粉末0.5g，加甲醇20ml，加热回流30分钟，滤过，滤液蒸干，残渣加无水乙醇-氯仿（3:2）混合液1ml使溶解，作为供试品溶液。另取齐墩果酸对照品，加乙醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液3～5μl、对照品溶液5μl，分别点于同一硅胶G薄层板上，以环已烷-丙酮-醋酸乙酯（5:2:1）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，在110℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240607150837-19guuif","Type":"NodeParagraph","Properties":{"id":"20240607150837-19guuif","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607150837-uzxca57","Type":"NodeParagraph","Properties":{"id":"20240607150837-uzxca57","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607150837-9a5z1mf","Type":"NodeParagraph","Properties":{"id":"20240607150837-9a5z1mf","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607150837-ul6ugoi","Type":"NodeParagraph","Properties":{"id":"20240607150837-ul6ugoi","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 甘、苦，凉。"}]},{"ID":"20240607150837-ccu9wnc","Type":"NodeParagraph","Properties":{"id":"20240607150837-ccu9wnc","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607150837-9bqp92h","Type":"NodeParagraph","Properties":{"id":"20240607150837-9bqp92h","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 滋补肝肾，明目乌发。用于眩晕耳鸣，腰膝酸软，须发早白，目暗不明。"}]},{"ID":"20240607150837-do8cxwb","Type":"NodeParagraph","Properties":{"id":"20240607150837-do8cxwb","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607150837-qtg6fjz","Type":"NodeParagraph","Properties":{"id":"20240607150837-qtg6fjz","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240607150837-n5fz4s0","Type":"NodeParagraph","Properties":{"id":"20240607150837-n5fz4s0","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607150837-c3f7fhl","Type":"NodeParagraph","Properties":{"id":"20240607150837-c3f7fhl","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607150837-fzp3jx7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150837-fzp3jx7","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：女贞子"}]},{"ID":"20240607150837-9caiy2w","Type":"NodeParagraph","Properties":{"id":"20240607150837-9caiy2w","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607150837-8rf2toq","Type":"NodeParagraph","Properties":{"id":"20240607150837-8rf2toq","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" Nǚ Zhēn Zǐ"}]},{"ID":"20240607150837-q9bw8no","Type":"NodeParagraph","Properties":{"id":"20240607150837-q9bw8no","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607150837-m1q8pz9","Type":"NodeParagraph","Properties":{"id":"20240607150837-m1q8pz9","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 女贞实（《本经》），冬青子（《济急仙方》），爆格蚤（《分类草药性》），白蜡树子（《中药形性经验鉴别法》），鼠梓子（《广西中药志》）。"}]},{"ID":"20240607150837-fm23cyj","Type":"NodeParagraph","Properties":{"id":"20240607150837-fm23cyj","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607150837-hzwhrz9","Type":"NodeParagraph","Properties":{"id":"20240607150837-hzwhrz9","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 《本草正》"}]},{"ID":"20240607150837-i1dozcs","Type":"NodeParagraph","Properties":{"id":"20240607150837-i1dozcs","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607150837-7fdur8o","Type":"NodeParagraph","Properties":{"id":"20240607150837-7fdur8o","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 为木犀科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"女贞"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。冬季果实成熟时采摘，除去枝叶晒干，或将果实略熏后，晒干；或置热水中烫过后晒干。"}]},{"ID":"20240607150837-2jihhu4","Type":"NodeParagraph","Properties":{"id":"20240607150837-2jihhu4","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607150837-tw3x7jy","Type":"NodeParagraph","Properties":{"id":"20240607150837-tw3x7jy","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 生长于山野，多栽植于庭园。分布华东、华南、西南及华中各地。主产浙江，江苏、湖南、福建、广西、江西以及四川等地。"}]},{"ID":"20240607150837-kgor7qm","Type":"NodeParagraph","Properties":{"id":"20240607150837-kgor7qm","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607150837-0m2mk24","Type":"NodeParagraph","Properties":{"id":"20240607150837-0m2mk24","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 女贞（《本经》），又名：桢木（《山海经》），女贞木（《典术》），冬青、蜡树（《纲目》），小叶冻膏（《医林纂要》），将军树（《临安县图经》），水蜡树（《植物名实图考》），水瑞香、冻青树，大蜡叶、水桢、白蜡树。"}]},{"ID":"20240607150837-ww633yu","Type":"NodeParagraph","Properties":{"id":"20240607150837-ww633yu","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"常绿大灌木或小乔木，高达10余米。树皮灰色至浅灰褐色，枝条光滑，具皮孔。叶对生，叶柄长1～2厘米，上面有槽；叶片革质，卵形至卵状披针形，长5～14厘米，宽3.5～6厘米，先端渐尖至锐尖，基部阔楔形，全缘，上面深绿色，有光泽，下面淡绿色，密布细小的透明腺点，主脉明显。圆锥花序顶生，长10～15厘米，直径8～17厘米；总花梗长约4厘米，或无；苞片叶状，线状披针形，无柄，早落，小苞卵状三角形；小花梗极短或几无；花萼钟状，长约1.5毫米，4浅裂；花冠管约与裂片等长，裂片4，长方卵形，长约2毫米，白色；雄蕊2，着生于花冠管喉部，花丝细，伸出花冠外；雌蕊1，子房上位，球形，2室，花柱圆柱状，柱头浅2裂。浆果状核果，长椭圆形，长6～12毫米，幼时绿色，熟时蓝黑色。种子1～2枚，长椭圆形。花期6～7月。果期8～12月。"}]},{"ID":"20240607150837-l3e5fxa","Type":"NodeParagraph","Properties":{"id":"20240607150837-l3e5fxa","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607150837-7lqwroh","Type":"NodeParagraph","Properties":{"id":"20240607150837-7lqwroh","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 干燥果实卵形成椭圆球形，有的微弯曲，长5～10毫米，直径3～4毫米。外皮蓝黑色，具皱纹；两端钝圆，底部有果柄痕。质坚，体轻，横面破开后大部分为单仁，如为双仁，中间有隔瓤分开。仁椭圆形，两端尖，外面紫黑色，里面灰白色。无臭，味甘而微苦涩。以粒大、饱满、色蓝黑，质坚实者为佳。"}]},{"ID":"20240607150837-6xojltl","Type":"NodeParagraph","Properties":{"id":"20240607150837-6xojltl","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607150837-pou613j","Type":"NodeParagraph","Properties":{"id":"20240607150837-pou613j","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 含女贞子甙（nuzhenide）、洋橄榄苦甙（oleuropein）、齐墩果酸（oleanolic acid）、4-羟基-B-苯乙基-B-D-葡萄糖甙、桦木醇（betulin）等。"}]},{"ID":"20240607150837-ys1r6fu","Type":"NodeParagraph","Properties":{"id":"20240607150837-ys1r6fu","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607150837-qw44sl7","Type":"NodeParagraph","Properties":{"id":"20240607150837-qw44sl7","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 女贞子：拣去杂质，洗净，晒干。酒女贞子：取净女贞子，加黄酒扑匀，置罐内或适宜容器内，密闭，坐水锅中，隔水炖至酒吸尽，取出，干燥（每女贞子100斤，用黄酒20斤）。"}]},{"ID":"20240607150837-o4ux2ph","Type":"NodeParagraph","Properties":{"id":"20240607150837-o4ux2ph","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"《得配本草》：\"女贞子洗去皮衣，酒拌蒸，晒干。淡盐水拌炒亦可。\""}]},{"ID":"20240607150837-gfrfohm","Type":"NodeParagraph","Properties":{"id":"20240607150837-gfrfohm","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607150837-s3b09ab","Type":"NodeParagraph","Properties":{"id":"20240607150837-s3b09ab","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607150837-piozwqn","Type":"NodeParagraph","Properties":{"id":"20240607150837-piozwqn","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"入足少阴经。\""}]},{"ID":"20240607150837-jvq3ttk","Type":"NodeParagraph","Properties":{"id":"20240607150837-jvq3ttk","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肝、肺、肾三经。\""}]},{"ID":"20240607150837-y7yvq25","Type":"NodeParagraph","Properties":{"id":"20240607150837-y7yvq25","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607150837-3gbfbj1","Type":"NodeParagraph","Properties":{"id":"20240607150837-3gbfbj1","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 苦甘、平。"}]},{"ID":"20240607150837-ko008lk","Type":"NodeParagraph","Properties":{"id":"20240607150837-ko008lk","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240607150837-eh118ie","Type":"NodeParagraph","Properties":{"id":"20240607150837-eh118ie","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240607150837-yw1hnwd","Type":"NodeParagraph","Properties":{"id":"20240607150837-yw1hnwd","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607150837-wlpimfp","Type":"NodeParagraph","Properties":{"id":"20240607150837-wlpimfp","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒泄泻及阳虚者忌服。"}]},{"ID":"20240607150837-dir9gju","Type":"NodeParagraph","Properties":{"id":"20240607150837-dir9gju","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"《本草经疏》：\"当杂保脾胃药及椒红温暖之类同施，不则恐有腹痛作泄之患。\""}]},{"ID":"20240607150837-z83s8az","Type":"NodeParagraph","Properties":{"id":"20240607150837-z83s8az","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607150837-j8sc4cb","Type":"NodeParagraph","Properties":{"id":"20240607150837-j8sc4cb","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强腰膝。治阴虚内热，头晕，目花，耳鸣，腰膝酸软，须发早白。滋补肝肾，明目乌发。用于眩晕耳鸣，腰膝酸软、须发早白、目暗不明。"}]},{"ID":"20240607150837-xnc342u","Type":"NodeParagraph","Properties":{"id":"20240607150837-xnc342u","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主补中，安五脏，养精神，除百疾。久服肥健。\""}]},{"ID":"20240607150837-qtrop2q","Type":"NodeParagraph","Properties":{"id":"20240607150837-qtrop2q","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"黑发黑须，强筋强力，多服补血去风。\""}]},{"ID":"20240607150837-rd26c7e","Type":"NodeParagraph","Properties":{"id":"20240607150837-rd26c7e","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"强阴，健腰膝，明目。\""}]},{"ID":"20240607150837-gmhyzo2","Type":"NodeParagraph","Properties":{"id":"20240607150837-gmhyzo2","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"凉血、益血。\""}]},{"ID":"20240607150837-5ro2m74","Type":"NodeParagraph","Properties":{"id":"20240607150837-5ro2m74","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"养阴气，平阴火，解烦热骨蒸，止虚汗，消渴，及淋浊，崩漏，便血，尿血，阴疮，痔漏疼痛。亦清肝火，可以明目止泪。\""}]},{"ID":"20240607150837-lyj4ycd","Type":"NodeParagraph","Properties":{"id":"20240607150837-lyj4ycd","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"养阴益肾，补气舒肝。治腰腿疼，通经和血。\""}]},{"ID":"20240607150837-5jxz2v3","Type":"NodeParagraph","Properties":{"id":"20240607150837-5jxz2v3","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑦《广西中药志》：\"治老人大便虚秘。\""}]},{"ID":"20240607150837-844y335","Type":"NodeParagraph","Properties":{"id":"20240607150837-844y335","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607150837-1nq11mm","Type":"NodeParagraph","Properties":{"id":"20240607150837-1nq11mm","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；熬膏或入丸剂。外用：熬膏点眼。"}]},{"ID":"20240607150837-hiy2ac1","Type":"NodeParagraph","Properties":{"id":"20240607150837-hiy2ac1","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607150837-jn5p0a8","Type":"NodeParagraph","Properties":{"id":"20240607150837-jn5p0a8","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" ①补腰膝，壮筋骨，强阴肾，乌髭发：女贞子（冬至日采：不拘多少，阴干，蜜酒拌蒸，过一夜，粗袋擦去皮，晒干为末，瓦瓶收贮，或先熬干，旱莲膏旋配用），旱莲草（夏至日采，不拘多少），捣汁熬膏，和前药为丸，临卧酒服。（《医方集解》二至丸）"}]},{"ID":"20240607150837-n1pmlxm","Type":"NodeParagraph","Properties":{"id":"20240607150837-n1pmlxm","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"②治神经衰弱：女贞子、鳢肠、桑椹子各五钱至一两。水煎服。或女贞子二斤，浸米酒二斤，每天酌量服。（《浙江民间常用草药》）"}]},{"ID":"20240607150837-2cbxit9","Type":"NodeParagraph","Properties":{"id":"20240607150837-2cbxit9","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"③治风热赤眼：冬青子不以多少，捣汁熬膏，净瓶收固，埋地中七日，每用点眼。（《济急仙方》）"}]},{"ID":"20240607150837-e4dty6b","Type":"NodeParagraph","Properties":{"id":"20240607150837-e4dty6b","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"④治视神经炎：女贞子、草决明、青葙子各一两。水煎服。（《浙江民间常用草药》）"}]},{"ID":"20240607150837-sls9lqp","Type":"NodeParagraph","Properties":{"id":"20240607150837-sls9lqp","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑤治瘰疬，结核性潮热等：女贞子三钱，地骨皮二钱，青蒿一钱五分，夏枯草二钱五分.水煎，一日三回分服。（《现代实用中药》）"}]},{"ID":"20240607150837-b32x9ia","Type":"NodeParagraph","Properties":{"id":"20240607150837-b32x9ia","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑥治肾受燥热，淋浊溺痛，腰脚无力，久为下消：女贞子四钱，生地六钱，龟板六钱，当归、茯苓、石斛、花粉、萆薢、牛膝，车前子各二钱，大淡菜三枚。水煎服。（《医醇胜义》女贞汤）"}]},{"ID":"20240607150837-orwufci","Type":"NodeParagraph","Properties":{"id":"20240607150837-orwufci","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑦补肾滋阴。取女贞子，去梗叶，浸酒中一日夜，擦去皮，晒干，研为末，待早莲草出时，采数石，捣汁熬浓，和末做成丸子，如梧子大。每夜服百丸，酒送下。十多天之后，体力增加，老人不再起夜。又能变白发为黑色，强腰膝，起阴气。又方：用初冬采收后阴干的女贞实，酒浸一日，蒸透晒干，取一斤四两；夏季采收并阴干的旱莲草，取十两；晚春采收并阴干的桑椹子，取十两。三味共研为末，加炼蜜做成丸子如梧子大。每服七、八直丸，淡盐汤送睛。若是五月份采的又桑椹，八月份采的旱莲，则可直接捣汁和药，不用加蜜。"}]},{"ID":"20240607150837-kmyj7tr","Type":"NodeParagraph","Properties":{"id":"20240607150837-kmyj7tr","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑧风热赤眼。用女贞子不限量，捣汁熬膏，净瓶收存，埋地中七日后，取以点眼。"}]},{"ID":"20240607150837-4985oeq","Type":"NodeParagraph","Properties":{"id":"20240607150837-4985oeq","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑨口舌生疮，舌肿胀出。取女贞叶捣汁含浸吐涎。"}]},{"ID":"20240607150837-qxv74re","Type":"NodeParagraph","Properties":{"id":"20240607150837-qxv74re","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"⑩一切眼疾，用女贞叶捣烂，加朴硝调匀贴眼部。"}]},{"ID":"20240607150837-2lvnghj","Type":"NodeParagraph","Properties":{"id":"20240607150837-2lvnghj","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607150837-gwxqprv","Type":"NodeParagraph","Properties":{"id":"20240607150837-gwxqprv","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607150837-oho70ll","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150837-oho70ll","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"《中华本草》：女贞子"}]},{"ID":"20240607150837-paroomp","Type":"NodeParagraph","Properties":{"id":"20240607150837-paroomp","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607150837-cz4rg2z","Type":"NodeParagraph","Properties":{"id":"20240607150837-cz4rg2z","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" Nǚ Zhēn Zǐ"}]},{"ID":"20240607150837-q3jasb0","Type":"NodeParagraph","Properties":{"id":"20240607150837-q3jasb0","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607150837-i1laoyd","Type":"NodeParagraph","Properties":{"id":"20240607150837-i1laoyd","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 女贞实、冬青子、爆格蚤、白蜡树子、鼠梓子"}]},{"ID":"20240607150837-0onui34","Type":"NodeParagraph","Properties":{"id":"20240607150837-0onui34","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607150837-hr7ai8p","Type":"NodeParagraph","Properties":{"id":"20240607150837-hr7ai8p","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 出自《本草正》《纲目》：女贞、冬青、枸骨三树也。女贞即今俗呼蜡树者；冬青即今俗呼冻青树者；枸骨即今俗呼猫儿刺者。东人因女贞茂盛，亦呼为冬青，与冬青同名异物，盖一类二种尔。二种皆因子自生，最易长。其叶厚而柔长，绿色，面青背淡；女贞叶长者四、五寸，子黑色；冻青叶微圆，子红色，为异。其花皆繁，子并累累满树，冬月鸲鹆喜食之。木肌皆白腻。今人不知女贞，但呼为蜡树。"}]},{"ID":"20240607150837-hi5ks0e","Type":"NodeParagraph","Properties":{"id":"20240607150837-hi5ks0e","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607150837-cp5zvej","Type":"NodeParagraph","Properties":{"id":"20240607150837-cp5zvej","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 药材基源：为木犀科植物女贞的果实。"}]},{"ID":"20240607150837-6pi4gwa","Type":"NodeParagraph","Properties":{"id":"20240607150837-6pi4gwa","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Ligustrum lucidum Ait."}]},{"ID":"20240607150837-sngjnrw","Type":"NodeParagraph","Properties":{"id":"20240607150837-sngjnrw","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"采收和储藏：女贞移栽后4～5年开始结果，在每年12月果实变黑而有白粉时打下，除去梗、叶及杂质，晒干或置热水中烫过后晒干。"}]},{"ID":"20240607150837-fxwxl6u","Type":"NodeParagraph","Properties":{"id":"20240607150837-fxwxl6u","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607150837-y5r2odt","Type":"NodeParagraph","Properties":{"id":"20240607150837-y5r2odt","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔2900m以下的疏林或密林中，亦多栽培于庭院或路旁。"}]},{"ID":"20240607150837-xcqxn9m","Type":"NodeParagraph","Properties":{"id":"20240607150837-xcqxn9m","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、甘肃及长江以南各地。"}]},{"ID":"20240607150837-jaxkvp2","Type":"NodeParagraph","Properties":{"id":"20240607150837-jaxkvp2","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607150837-vyz4p3j","Type":"NodeParagraph","Properties":{"id":"20240607150837-vyz4p3j","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 常绿灌木或乔木，高可达25m。树皮灰褐色。枝黄褐色、灰色或紫红色，圆柱形，疏生圆形或长圆形皮孔。单叶对生；叶柄长1-3cm，上面具沟；叶片革质，卵形、长卵形或椭圆形至宽椭圆形，长6-17cm，宽3-8cm，先端锐尖至渐尖或钝，基部圆形，有时宽楔形或渐狭。圆锥花序顶生，长8-20cm，宽8-25cm;花序梗长达3cm；花序基部苞片常与叶同型，小苞片披针形或线形，凋落；花无梗或近无梗；花萼无毛，长1.5-2mm，齿不明显或近截形；花冠长4-5mm，裂片长2-2.5mm,反折；花丝长1.5-3mm，花药长圆形，长1-1.5mm；花柱长1.5-2mm，柱头棒状。果肾形或近肾形，长7-10mm，径4-6mm，深蓝黑色，成熟时呈红黑色，被白粉。花期5-7月，果期7月至翌年5月。"}]},{"ID":"20240607150837-hv8pcic","Type":"NodeParagraph","Properties":{"id":"20240607150837-hv8pcic","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607150837-ruyinby","Type":"NodeParagraph","Properties":{"id":"20240607150837-ruyinby","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，喜光耐荫，不甚耐寒。"}]},{"ID":"20240607150837-lzkjonk","Type":"NodeParagraph","Properties":{"id":"20240607150837-lzkjonk","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"对大气污染的抗性较强，对二氧化硫、氯气、氟化氢及铅蒸气均有较强抗性，也能忍受较高的粉尘、烟尘污染。对土壤要求不严，以砂质壤上或粘质壤上栽培为宜，但在红、黄壤土上亦能生长。"}]},{"ID":"20240607150837-k6f8o7c","Type":"NodeParagraph","Properties":{"id":"20240607150837-k6f8o7c","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖，也可扦插。秋末冬初果实成熟时采下，剥取种子，随即播种育苗，苗床宽1．3m，按沟心距0．3m开横沟，深约1cm，播幅10cm，把种子匀插沟内，施稀人畜粪，再盖细土。每1hm2用种子量300～375kg。育苗期每年中耕除草4次，在4、6、8、11月进行，并在4月和11月中耕除草后各追施人畜粪水1次，培育2年移栽。在4～5月，按行株距3m×3m左右开穴，每穴栽种1株。"}]},{"ID":"20240607150837-fnbr4wh","Type":"NodeParagraph","Properties":{"id":"20240607150837-fnbr4wh","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"田间管理 栽后每年4、10月各松土1次。结合追施肥1～2次。为了综合利用，有条件地区，可在树上放养白蜡虫。"}]},{"ID":"20240607150837-bcobr8t","Type":"NodeParagraph","Properties":{"id":"20240607150837-bcobr8t","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"病虫害防治 虫害有天牛幼虫为害树干，可用棉球蘸5倍90％敌百虫液塞进虫孔毒杀。"}]},{"ID":"20240607150837-9g0zcbd","Type":"NodeParagraph","Properties":{"id":"20240607150837-9g0zcbd","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607150837-hoor7fv","Type":"NodeParagraph","Properties":{"id":"20240607150837-hoor7fv","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实呈卵形、椭圆形或肾形，长6-8．5mm，直径3．5-5．5mm。表面黑紫色或棕黑色，皱缩不平，基部有果梗痕或具宿萼及短梗。外果皮薄，中果皮稍厚而松软，内果皮木质，黄棕色，有数条纵棱，破开后种子通常1粒，椭圆形；一侧扁平或微弯曲，紫黑色，油性。气微，味微酸，涩。"}]},{"ID":"20240607150837-lpasc6o","Type":"NodeParagraph","Properties":{"id":"20240607150837-lpasc6o","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"以粒大、饱满、色黑紫者为佳。"}]},{"ID":"20240607150837-2mdek24","Type":"NodeParagraph","Properties":{"id":"20240607150837-2mdek24","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果实横切面：外果皮为1列细胞，外壁及侧壁加厚，其内常含油滴。中果皮为12-25列薄壁细胞，近内果皮处有7-12个维管束散在。内果皮为4-8列纤维组成棱环。种皮最外为1列切向延长的表皮细胞，长68-108μm，径向60-80μm，常含油滴。内为薄壁细胞，棕色。胚乳较厚，内有子叶。"}]},{"ID":"20240607150837-edebywg","Type":"NodeParagraph","Properties":{"id":"20240607150837-edebywg","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取粉末约0．5g，加乙醇5ml，振摇5min，滤过。取滤液少量，置蒸发皿中蒸干，滴加三氯化锑氯仿饱和溶液，再蒸干，呈紫色。（检查三萜类）（2）取粉末1g，加乙醇3ml，振摇5min，滤过。滤液置蒸发皿中，蒸干，残渣加醋酐1ml使溶解，加硫酸1滴，先显桃红色，继变紫红色，最后呈污绿色；置紫外光灯（365nm）下观察，显黄绿色荧光。（检查三萜皂甙）（ 3）薄层色谱 取本品粉末5g，加7％硫酸的乙醇-水（1：3）溶液50ml，加热回流2h，放冷后，用氯仿振摇提取3次（50ml、25ml、25ml），氯仿液以水振摇洗涤后，用无水硫酸钠脱水，滤过。氯仿液蒸干，以甲醇1ml溶解作供试液。另取齐墩果酸氯仿溶液作对照液，分别点样于硅胶G（青岛）薄板上，以氯仿-乙醚（1：1）展开，喷以20％硫酸，于105℃烘烤显色，供试品色谱与对照品色谱在相应的位置上显相同颜色的斑点。"}]},{"ID":"20240607150837-hpsrh6r","Type":"NodeParagraph","Properties":{"id":"20240607150837-hpsrh6r","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607150837-tevbaah","Type":"NodeParagraph","Properties":{"id":"20240607150837-tevbaah","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 女贞子对动物毒性很小，兔1次服新鲜成熟果实75g，无中毒现象。"}]},{"ID":"20240607150837-7ilv8vi","Type":"NodeParagraph","Properties":{"id":"20240607150837-7ilv8vi","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607150837-01jg9bh","Type":"NodeParagraph","Properties":{"id":"20240607150837-01jg9bh","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 果实含齐墩果酸（oleanolic acid），乙酰齐墩果酸（acetyloleanolic acid），熊果酸（ursolic acid），乙酸熊果酸（acetylursolic acid），对-羟基苯乙醇（p－hydroxyphenethyl alcohol），3，4-二羟基苯乙醇（3， 4－dihydroxyphenethyl alcohol），β-谷甾醇（β-sitosterol），甘露醇（mannitol），外消旋-圣草素（eriodictyol），右旋-花旗松素（taxifolin），槲皮素（quercetin），女贞甙（ligustroside），10-羟基女贞甙（10－hydroxy ligustroside），女贞子甙（nuezhenide），橄榄苦甙（oleuropein）， 10-羟基橄榄苦甙（10－hydroxy oleu-ropein），对-羟基苯乙基-β-D-葡萄糖甙（p－hydroxyphen-ethyl-β-D-glucoside），3，4-二羟基苯乙基-β-葡萄糖甙（3，4-dihydrox-yphenethyl-β-D-glucoside），甲基-α-D-吡喃半乳糖甙（methyl－α－D-galactopyranoside），洋丁香酚甙（acteoside）[1]，新女贞子甙（neonuezhenide），女贞甙酸（ligustrosidic acid），橄榄苦甙酸（oleu－ropeinic acid）及代号为GI-3的裂环烯醚萜甙[2]。还含有由鼠李糖，阿拉伯糖，葡萄糖，岩藻糖组成的多糖[3]，及总量为0．39％的7种磷脂类化合物，其中以磷脂酰胆碱（phosphatidyl choline）含量最高，占总量的56．52％±1.34％[4]。并含有钾、钙、镁、钠、锌、铁、锰、铜、镍、铬、银等11种元素，其中铜、铁、锌、锰、铬、镍为人所必需微量元素[5]。"}]},{"ID":"20240607150837-7eiwyp8","Type":"NodeParagraph","Properties":{"id":"20240607150837-7eiwyp8","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"女贞种子含女贞子酸（ligustrin）（其结构为五环三萜酸，具有免疫激活作用）[6]。女贞含8-表金银花甙（8－epikingiside）［7］。"}]},{"ID":"20240607150837-bcr6wx8","Type":"NodeParagraph","Properties":{"id":"20240607150837-bcr6wx8","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607150837-9jv9w8y","Type":"NodeParagraph","Properties":{"id":"20240607150837-9jv9w8y","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 1.降血脂及抗动脉硬化 女贞子粗粉20g/只拌入食料中喂饲，对实验性高血脂症兔可降低血清胆甾醇及甘油三酯含量，并使主动脉脂质斑块及冠状动脉粥样斑块形成消减。女贞子成分齐墩果酸30mg/kg拌入饮料喂饲大鼠，0.4%齐墩果酯混悬液0.5ml给兔灌胃，对高血脂症大鼠、兔均有降血脂作用。齐墩果酸30、60mg/kg加于饲料中喂饲日本鹌鹑8周，明显降低血清总胆甾醇、过氧化脂质、动脉壁总胆甾醇含量，降低动脉粥样硬化的发生率。"}]},{"ID":"20240607150837-2pwx1lz","Type":"NodeParagraph","Properties":{"id":"20240607150837-2pwx1lz","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"2.降血糖 齐墩果酸50、100mg/kg皮下注射，连续7日，可降低正常小鼠血糖，对四氧嘧啶引起的小鼠糖尿病有预防及治疗作用，也能对抗肾上腺素或葡萄糖引起的小鼠血糖升高。"}]},{"ID":"20240607150837-1o3a3j2","Type":"NodeParagraph","Properties":{"id":"20240607150837-1o3a3j2","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"3.抗肝损伤 齐墩果酸30、50、100mg/kg皮下注射，可抑制四氯化碳引起的大鼠血清谷丙转氨酶(SGPT)的升高，对未经四氯化碳处理的大鼠，齐墩果酸50、100mg/kg皮下注射，也可使SGPT下降。齐墩果酸70mg/kg皮下注射，可减轻四氯化碳造成的肝损伤，组织学观察，肝细胞空泡变性、疏松变性、肝细胞坏死、小叶间质炎症，均较相应的对照组轻。齐墩果酸2mg/只皮下注射，连续6-9周，对高脂食物及四氯化碳造成的大鼠肝硬变有防治作用。电镜观察对四氯化碳肝损伤大鼠，齐墩果酸20mg/只皮下注射，可使肝细胞的线粒体肿胀与内质网囊泡变均减轻。"}]},{"ID":"20240607150837-zqdwtfj","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607150837-zqdwtfj","updated":"20240607150837"},"Children":[{"ID":"20240607150837-oe59ykz","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240607150837-oe59ykz","updated":"20240607150837"},"Children":[{"ID":"20240607150837-59cdv5q","Type":"NodeParagraph","Properties":{"id":"20240607150837-59cdv5q","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"对机体免疫功能的影响4.1 对非特异性免疫的影响4.1.1升高外周白细胞数 女贞子能显着升高外周白细胞数目，其有效成分为齐墩果酸。醇提取物能回升环磷酰胺(cy)所致小鼠白细胞减少。蒸女贞子480mg/kg对正常小鼠白细胞无影响，但可纠正强的松龙(25mg/kg，ip)所致白细胞下降。"}]}]}]},{"ID":"20240607150837-kr3soph","Type":"NodeParagraph","Properties":{"id":"20240607150837-kr3soph","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"4.1.2对网状内皮系统的吞噬功能的影响 通过血液中异物的廓清速度，观察巨噬细胞活力。发现ig蒸女贞子240mg/kgx5d能显着提高小鼠对iv碳粒的廓清指数，增强网状内皮系统的活性；女贞子480mg/kg，作用不明显。女贞子煎剂12.5g/kgx7d，对廓清指数无明显影响，而25g/kgx7d则明显抑制网状内皮系统的吞噬活性。"}]},{"ID":"20240607150837-82l5ueu","Type":"NodeParagraph","Properties":{"id":"20240607150837-82l5ueu","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"4.2.对特异性免疫的影响4.2.1对细胞免疫功能的影响 女贞子能明显提高T淋巴细胞功能。女贞子的水提剂0.02ml在体外明显增强其适量PHA、COA和PWM引起的淋巴细胞增殖，还明显地增强异种(人)淋巴细胞引起的大鼠局部移植物抗宿主反应(GUH)，可能由于部分地通过消除或消弱抑制性T细胞的作用而实现的。女贞子多糖(LLPS)可使小鼠脾淋巴细胞对ConA刺激的增殖反应增强：3H-TdR掺入值(Cpm)10mg/kg给药组(39308.1±6208)较对照组(17959±4508)增加约120%，P＜0.01，50mg/kg给药组(2979±3625)较对照组增加约70%，p＜0.07。女贞子煎剂对SRBC所致迟发型超敏反应有促进作用。表明女贞子可增强细胞免疫功能。齐墩果酸40mg，1日3次，服用1-2月，对肿瘤病人有提高免疫功能的作用，皮泡法测巨噬细胞吞噬功能和血液淋巴细胞玫瑰花结均显着提高。"}]},{"ID":"20240607150837-dhyoi6r","Type":"NodeParagraph","Properties":{"id":"20240607150837-dhyoi6r","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"女贞子无论是水提物还是醇提物均有诱生M？IL-1的作用，且水提物比醇提物作用强，这一结果揭示女贞子的免疫促进作用可能与诱生M？-IL-1有关。同时，女贞子中通过增强细胞表面受体的活性而促进T细胞的活性，对于因Ts活性过高而引起的免疫功能低下，女贞子可能是较好的免疫调节药物。"}]},{"ID":"20240607150837-l31h4t6","Type":"NodeParagraph","Properties":{"id":"20240607150837-l31h4t6","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"4.2.2对体液免疫功能的影响 女贞子具有增强体液免疫功能的作用。女贞子煎剂连续7日ig12.5～25g/kg，可使鼠免疫器官胸腺、脾脏重量增加；大剂量可使成年鼠脾脏重量增加。蒸女贞子240mg/kg、480mg/kg×7日可明显使C57BL小鼠脾脏、胸腺、腹腔淋巴结，肾上腺增重。女贞子多糖每天注射1次，共7日100mg/kg使LACA小鼠脾脏重量较对照组增加约40%，50mg/kg使小鼠脾脏重量较对照组增加约30%。女贞子煎剂能明显提高小鼠血清溶血素抗体活性，亦能升高正常小鼠血清IgG含量，且对抗Cy的免疫抑制作用；蒸女贞子可明显对抗强的松龙的免疫抑制作用，亦能升高小鼠血清IgG，并能使强的松龙免疫抑制小鼠的IgG含量升高，尚能明显提示小鼠记清净血素抗体活性；女贞子多糖对抗Cy50mg/kgip所造成的荷瘤小鼠(S180)的淋巴细胞增殖反应的抑制低下作用，女贞子多糖明显对抗Cy的免疫抑制作用。"}]},{"ID":"20240607150837-5lgqk1s","Type":"NodeParagraph","Properties":{"id":"20240607150837-5lgqk1s","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"4.3对变态反应的抑制作用 女贞子煎剂12.5，25g/kgig小鼠7d;同剂量5dig大鼠，不同剂量女贞子对小鼠或大鼠被动皮肤过敏反应(PCA)均表现明显的抑制作用。女贞子煎剂能降低大鼠颅骨膜肥大细胞脱颗粒百分率，对抗组胺引起的大鼠皮肤毛细血管通透性增高；抗原攻击前给药，可抑制DNCB所致小鼠接触性皮炎；女贞子25g/kg于抗原攻击后给药亦能明显抑制DNCB引起的小鼠接触性皮突；减轻大鼠主动及反向被动Arthus反应；女贞子20g/kg显着降低豚鼠血清补体总量。说明女贞子对Ⅰ、Ⅱ、Ⅳ型变态反应具有明显抑制作用。"}]},{"ID":"20240607150837-qewjikg","Type":"NodeParagraph","Properties":{"id":"20240607150837-qewjikg","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"5.抗炎作用 采用多种实验炎症模型证实女贞子12.5g/kg，25g/kg每日ig，连续5日，对二甲苯引起小鼠耳廓肿胀、乙酸引起的小鼠腹腔毛细血管通透性增加及时角叉菜胶、蛋清、甲醛性大鼠足垫肿胀均有明显抑制作用；女贞子20g/kg×3日ig，可显着降低大鼠炎症组织PGE的释放量；女贞子20g /kg×7日可抑制大鼠棉球肉芽组织增生，同时伴有肾上腺重量的增加。其抗炎机制可能涉及以下几个方面：①激活垂体一肾上腺皮质系统，促进皮质激素的释放；②抑制PGE的合成或释放。另外女贞子能降低豚鼠血清补体活性，对抗炎症介质组胺引起的大鼠皮肤毛细血管通透性增高，因此女贞子的抗炎机制可能也包括上述作用。"}]},{"ID":"20240607150837-dihjivd","Type":"NodeParagraph","Properties":{"id":"20240607150837-dihjivd","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"6.抗癌、抗突变 齐墩果酸对小鼠肉瘤-180有抑瘤作用。女贞子煎剂12.5、25g/kg灌胃，齐墩果酸50、100mg/kg皮下注射，对环磷酰胺及乌拉坦引起的小鼠骨髓微核率增多有明显抑制作用。"}]},{"ID":"20240607150837-1msxi61","Type":"NodeParagraph","Properties":{"id":"20240607150837-1msxi61","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"7.对内分泌系统的作用 研究表明，女贞子中既有雌激素样物质，也有雄激素样的物质存在，经放射免疫测定，女贞子含睾丸酮428.31pg/g，雌二醇139.02pg/g。证明女贞子既有睾丸酮样也有雌二醇样的激素类似物，即同一药物具有双向调节作用。用女贞子等补肾阴的中药在无势小白鼠阴道粘膜上产生了雌激素样作用，服药组兔卵巢的大卵泡数明显增多，雌激素升高。"}]},{"ID":"20240607150837-e5mzfxh","Type":"NodeParagraph","Properties":{"id":"20240607150837-e5mzfxh","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"8.对造血系统的影响 女贞子对红系造血有促进作用。应用扩散盒血浆凝块法，女贞子能促进CFU-E生长。CFU-E/5×l4为128.6±11.4(8)，CFU一E/股骨为62040±5450(8)，股骨中CFU-E较NS组明显为高，而CFU-D却显着减少。对用药后小鼠骨髓细胞形态学分析，女贞子组红系细胞百分数为47.3±2.99(6)较NS37.3±2.86(6)组增高，粒系细胞百分数37.6±3.96(6)较NS组46.6±6.26(6)减少，粒红比值亦相应变化。"}]},{"ID":"20240607150837-7fhy6ty","Type":"NodeParagraph","Properties":{"id":"20240607150837-7fhy6ty","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"9.对环磷酰胺及乌拉坦引起染色体损伤的保护作用 微核试验法证明女贞子水煎剂pol2.5g/kg25.0g/(kg.d)×6，齐墩果酸ih50mg/kg，100mg/(kg·d)×7对环磷酰胺ip50mg/(kg·d)×2、乌拉坦500mg/(kg·d)×4，ip引起的小鼠染色体损伤有保护作用，能降低其微核率。"}]},{"ID":"20240607150837-6lpxql9","Type":"NodeParagraph","Properties":{"id":"20240607150837-6lpxql9","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"10.抗HpD光氯化作用 女贞子能够对抗HpD的光氧化作用，体内应用能够明显减轻HpD对小鼠的皮肤光敏反应。女贞子60mg生药/ml，能明显减少HpD5ug/ml合并照光10min引起的红细胞丙二醛含量的增加，抑制率为57.7%，明显对抗红细胞膜乙酰胆碱酯酶活力的抑制，对抗率为49.O%，120mg/ml时，对抗率为53.3%，小鼠ipHpD20mg/kg，照光4h，女贞子20g生药/kg，ip1次，明显减轻耳的光敏反应。女贞子对1O2产生的效率比对照组低3.5×10-4倍。"}]},{"ID":"20240607150837-klton8z","Type":"NodeParagraph","Properties":{"id":"20240607150837-klton8z","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"11.其它作用 女贞子尚有强心、扩张冠状血管、扩张外周血管等心血管系统作用；利尿、止咳，缓泻，抗菌等作用。齐墩果酸有某些强心、利尿作用；甘露醇则有缓下作用；还含有多量的葡萄糖；这些可能与其强壮作用有关。"}]},{"ID":"20240607150837-a8foz0p","Type":"NodeParagraph","Properties":{"id":"20240607150837-a8foz0p","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607150837-jsjhczz","Type":"NodeParagraph","Properties":{"id":"20240607150837-jsjhczz","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 女贞子：拣去杂质，洗净，晒干。酒女贞子：取净女贞子100斤，加黄酒20斤拌匀，置罐内或适宜容器内，密闭，坐水锅中，隔水炖至酒吸尽，取出，干燥。《得配本草》：女贞子洗去皮衣，酒拌蒸，晒干。淡盐水拌炒亦可。"}]},{"ID":"20240607150837-vh4kfsw","Type":"NodeParagraph","Properties":{"id":"20240607150837-vh4kfsw","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607150837-10dld5b","Type":"NodeParagraph","Properties":{"id":"20240607150837-10dld5b","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240607150837-a42k3t4","Type":"NodeParagraph","Properties":{"id":"20240607150837-a42k3t4","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607150837-yoso37a","Type":"NodeParagraph","Properties":{"id":"20240607150837-yoso37a","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 甘；苦；性凉"}]},{"ID":"20240607150837-gwerilk","Type":"NodeParagraph","Properties":{"id":"20240607150837-gwerilk","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607150837-3k28fxf","Type":"NodeParagraph","Properties":{"id":"20240607150837-3k28fxf","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒泄泻及阳虚者忌服。《本草经疏》：当杂保脾胃药及椒红温暖之类同施，不则恐有腹痛作泄之患。"}]},{"ID":"20240607150837-awu0ys0","Type":"NodeParagraph","Properties":{"id":"20240607150837-awu0ys0","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607150837-nuqg9k3","Type":"NodeParagraph","Properties":{"id":"20240607150837-nuqg9k3","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 补益肝肾；清虚热；明目。主头昏目眩；腰膝酸软；遗精；耳鸣；须发早白，骨蒸潮热；目暗不明"}]},{"ID":"20240607150837-jzhyaal","Type":"NodeParagraph","Properties":{"id":"20240607150837-jzhyaal","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607150837-4pt4re1","Type":"NodeParagraph","Properties":{"id":"20240607150837-4pt4re1","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入丸剂。外用：适量，敷膏点眼。清虚热宜生用，补肝肾宜熟用。"}]},{"ID":"20240607150837-yovg75u","Type":"NodeParagraph","Properties":{"id":"20240607150837-yovg75u","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607150837-u798iwm","Type":"NodeParagraph","Properties":{"id":"20240607150837-u798iwm","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 《本草经疏》：女贞子，气味俱阴，正入肾除热补精之要品，肾得补，则五脏自安，精神自足，百病去而身肥健矣。其主补中者，以其味甘，甘为主化，故能补中也。此药有变白明目之功，累试辄验，而《经》文不载，为阙略也。《本草述》：女贞实，固入血海益血，而和气以上荣……由肾至肺，并以淫精于上下，不独髭须为然也，即广嗣方中，多用之矣。女贞同固本健阳丸服之，尚有腹疼，则信兹味性果寒也，时珍云温，亦不察之甚矣。《本草新编》：女贞实，近人多用之，然其力甚微，可入丸以补虚，不便入汤以滋益。与熟地、枸杞、南烛、麦冬、首乌、旱莲草、乌芝麻、山药、桑椹、茄花、杜仲、白术同用，真变白之神丹也，然亦为丸则验，不可责其近功。女贞子缓则有功，而速则寡效，故用之速，实不能取胜于一时，而用之缓，实能延生于永久，亦在人之用之得宜耳。《本经逢原》：女贞，性禀纯阴，味偏寒滑，脾胃虚人服之，往往减食作泻。《本经》以枸骨主治，误列此味之下，后世谬认女贞有补中安五脏之功，多致误用，滋患特甚，因表而出之。《本经》：主补中，安五脏，养精神，除百疾。久服肥健。《本草蒙筌》：黑发黑须，强筋强力，多服补血去风。《纲目》：强阴，健腰膝，明目。《本草经疏》：凉血、益血。《本草正》：养阴气，平阴火，解烦热骨蒸，止虚汗，消渴，及淋浊，崩漏，便血，尿血，阴疮，痔漏疼痛。亦清肝火，可以明目止泪。《本草再新》：养阴益肾，补气舒肝。治腰腿疼，通经和血。《广西中药志》：治老人大便虚秘。"}]},{"ID":"20240607150837-04nxmpi","Type":"NodeParagraph","Properties":{"id":"20240607150837-04nxmpi","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607150837-gn8jjsf","Type":"NodeParagraph","Properties":{"id":"20240607150837-gn8jjsf","updated":"20240607150837"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607150839-d6l4j70","Type":"NodeThematicBreak","Properties":{"id":"20240607150839-d6l4j70"}},{"ID":"20240607150840-5xshc3a","Type":"NodeParagraph","Properties":{"id":"20240607150840-5xshc3a"}}]}