8140213-5x5xrl9","Type":"NodeParagraph","Properties":{"id":"20240618140213-5x5xrl9","updated":"20240714082335"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 720px;","style":"width: 710px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麦门冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麦门冬-20240712162057-w4vla1v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 710px;\" parent-style=\"width: 720px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 528px;","style":"width: 518px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小叶麦冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小叶麦冬-20240714082120-frq79vk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 518px;\" parent-style=\"width: 528px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712170614-cb5ntsr","Type":"NodeParagraph","Properties":{"id":"20240712170614-cb5ntsr","updated":"20240712170719"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 623px;","style":"width: 613px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麦冬 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麦冬 6-20240712170614-i6k2xop.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 613px;\" parent-style=\"width: 623px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 610px;","style":"width: 600px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240712170709-e7f55nl.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 600px;\" parent-style=\"width: 610px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240802125331-40pr2g2","Type":"NodeParagraph","Properties":{"id":"20240802125331-40pr2g2","updated":"20240802125331"}},{"ID":"20240712171133-aotzaaq","Type":"NodeParagraph","Properties":{"id":"20240712171133-aotzaaq","updated":"20240712171424"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"阔叶麦冬（山麦冬、大叶麦冬）"}]},{"ID":"20240714084616-lu45p19","Type":"NodeParagraph","Properties":{"id":"20240714084616-lu45p19","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产湖北、福建等地。\n【性状】\t湖北麦冬：呈纺锤形，两端略尖，长1.23cm，直径0.40.7cm。表面淡黄色至棕黄色，具不规则纵皱纹。质柔韧，干后质硬脆，易折断，断面淡黄色至棕黄色，角质样，中柱 (木心) 细小。气微，味甜，嚼之发黏。\n短葶山麦冬：稍扁，长25cm，直径0.30.8cm，具粗纵纹。味甘、微苦。\n【性味】\t甘、微苦，微寒。\n【功效】\t养阴生津，润肺清心。用于肺燥干咳，虚劳咳嗽，津伤口渴，心烦失眠，肠燥便秘。"}]},{"ID":"20240714084616-t7erh10","Type":"NodeParagraph","Properties":{"id":"20240714084616-t7erh10","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206091943-19axoip.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714084616-o2f8o72","Type":"NodeParagraph","Properties":{"id":"20240714084616-o2f8o72","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 442px;","style":"width: 432px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 10-20240714084550-79ca5n0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 432px;\" parent-style=\"width: 442px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 442px;","style":"width: 432px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 6-20240714084131-eeovc4x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 432px;\" parent-style=\"width: 442px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714084616-x7p9260","Type":"NodeParagraph","Properties":{"id":"20240714084616-x7p9260","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 514px;","style":"width: 504px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 4-20240714083657-7li3jtk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 504px;\" parent-style=\"width: 514px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 514px;","style":"width: 504px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 7-20240714084247-k9v4vbn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 504px;\" parent-style=\"width: 514px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714084616-atpweqd","Type":"NodeParagraph","Properties":{"id":"20240714084616-atpweqd","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬-20240714083056-1uht1uf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 790px;","style":"width: 780px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240618140213-e1n1um0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 780px;\" parent-style=\"width: 790px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714084616-uz7kekd","Type":"NodeParagraph","Properties":{"id":"20240714084616-uz7kekd","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 2-20240714083235-lmlsswc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 332px;","style":"width: 322px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 1-20240714083204-y7d5qgl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 322px;\" parent-style=\"width: 332px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 509px;","style":"width: 499px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山麦冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山麦冬-20240712163334-hz0puvu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 499px;\" parent-style=\"width: 509px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714084616-sbhdtwk","Type":"NodeParagraph","Properties":{"id":"20240714084616-sbhdtwk","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 784px;","style":"width: 774px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 5-20240714084004-vrsqukl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 774px;\" parent-style=\"width: 784px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240714084616-t0sq4a3","Type":"NodeParagraph","Properties":{"id":"20240714084616-t0sq4a3","updated":"20240714084616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 315px;","style":"width: 305px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 3-20240714083333-kz8jejd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 305px;\" parent-style=\"width: 315px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 733px;","style":"width: 723px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"阔叶麦冬 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/阔叶麦冬 8-20240714084350-9197dwf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 723px;\" parent-style=\"width: 733px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712160712-sdpu5j9","Type":"NodeParagraph","Properties":{"id":"20240712160712-sdpu5j9","updated":"20240714082951"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：（小叶）麦冬浆果呈现蓝色或深蓝色，人们称它为蓝宝石，且小叶麦冬的果实比较低。而（大叶）山麦冬就是黑色的浆果；"}]},{"ID":"20240712171705-brkvg5t","Type":"NodeParagraph","Properties":{"id":"20240712171705-brkvg5t","updated":"20240714082922"},"Children":[{"Type":"NodeText","Data":"三"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：小叶麦冬的药效更好；"}]},{"ID":"20240616092834-ug671gr","Type":"NodeThematicBreak","Properties":{"id":"20240616092834-ug671gr"}},{"ID":"20240616092854-qbei06g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092854-qbei06g","updated":"20240616092857"},"Children":[{"Type":"NodeText","Data":"麦门冬《神农本草经》"}]},{"ID":"20240616092854-g712n7b","Type":"NodeParagraph","Properties":{"id":"20240616092854-g712n7b","updated":"20240616092854"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240616092854-h0b0g6a","Type":"NodeParagraph","Properties":{"id":"20240616092854-h0b0g6a","updated":"20240616092854"},"Children":[{"Type":"NodeText","Data":"主心腹，结气伤中伤饱，胃络脉绝，羸瘦短气。久服轻身，不老不饥。生川谷及堤阪。"}]},{"ID":"20240616092854-t9wuto7","Type":"NodeParagraph","Properties":{"id":"20240616092854-t9wuto7","updated":"20240616092854"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：一名马韭，一名衅冬，一名忍冬，一名忍陵，一名不死药，一名仆垒，一名随脂（太平《御览》引云，一名羊韭，秦，一名马韭，一名禹韭，韭，越一名羊齐，一名麦韭，一名禹韭，一名衅韭，一名禹余粮），神农岐伯甘平，黄帝桐君雷公甘无毒，李氏甘小温，扁鹊无毒，生山谷肥地，叶如韭，肥泽丛生，采无时，实青黄。"}]},{"ID":"20240616092854-ibet4mx","Type":"NodeParagraph","Properties":{"id":"20240616092854-ibet4mx","updated":"20240616092854"},"Children":[{"Type":"NodeText","Data":"《名医》曰：秦名羊韭，齐名麦韭，楚名马韭，越名羊蓍，一名禹葭，一名禹余粮，叶如韭，冬夏长生，生函谷肥土，石间久废处，二月三月八月十月采，阴干。"}]},{"ID":"20240616092854-auqcwol","Type":"NodeParagraph","Properties":{"id":"20240616092854-auqcwol","updated":"20240616092854"},"Children":[{"Type":"NodeText","Data":"案《说文》云：荵，荵冬草；《中山经》云：青要之山，是多仆累，据《吴普》说，即麦门冬也，忍，荵，垒，累，音同；陶宏景云：实如青珠，根似穬麦，故谓麦门冬。"}]},{"ID":"20240616092835-3kx2mp1","Type":"NodeThematicBreak","Properties":{"id":"20240616092835-3kx2mp1"}},{"ID":"20240616092844-70yxk5n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092844-70yxk5n","updated":"20240616092848"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草择要纲目》"}]},{"ID":"20240616092844-5jg631b","Type":"NodeParagraph","Properties":{"id":"20240616092844-5jg631b","updated":"20240616092844"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616092844-8uddcxk","Type":"NodeParagraph","Properties":{"id":"20240616092844-8uddcxk","updated":"20240616092844"},"Children":[{"Type":"NodeText","Data":"甘平无毒．阳中微阴．降也．入手太阴经气分．"}]},{"ID":"20240616092844-i82tz4e","Type":"NodeParagraph","Properties":{"id":"20240616092844-i82tz4e","updated":"20240616092844"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616092844-hnawly7","Type":"NodeParagraph","Properties":{"id":"20240616092844-hnawly7","updated":"20240616092844"},"Children":[{"Type":"NodeText","Data":"身重目黄．心下支满．虚劳客热．口干燥渴．强阴益精．祛肺中伏火．补心气不足．脉者人之元气．孙真人生肺散用麦冬者．滋燥金而清水源也．佐以人参之甘寒泻热火．五味子之酸温泻丙火．故火盛气壮之人．麦门冬为补髓通肾气滑泽肌体之对剂也．气弱胃寒者不可过饵．"}]},{"ID":"20240616093028-jeuo8bx","Type":"NodeThematicBreak","Properties":{"id":"20240616093028-jeuo8bx"}},{"ID":"20240616093029-mmid2qx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093029-mmid2qx","updated":"20240616093033"},"Children":[{"Type":"NodeText","Data":"麦门冬《增广和剂局方药性总论》"}]},{"ID":"20240616093029-nt3s5s7","Type":"NodeParagraph","Properties":{"id":"20240616093029-nt3s5s7","updated":"20240616093029"},"Children":[{"Type":"NodeText","Data":"君。味甘，平、微寒，无毒。主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气，身重，心下支满，虚劳客热，口干烦渴。止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健，美颜色，有子。《药性论》云∶使。能治热毒，止烦渴，主大水面目肢节浮肿，下水，治肺痿吐脓，主泄精，疗心腹结气。日华子云∶治五劳七伤，安魂定魄，止渴，肥人，时疾热狂头痛，止嗽。地黄、车前为使。恶∶款冬、苦瓠。畏∶苦参、青葙、木耳。"}]},{"ID":"20240616093044-p82cbwr","Type":"NodeThematicBreak","Properties":{"id":"20240616093044-p82cbwr"}},{"ID":"20240616093045-fvgc4pf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093045-fvgc4pf","updated":"20240616093054"},"Children":[{"Type":"NodeText","Data":"麦门冬《证类本草》"}]},{"ID":"20240616093045-53q2mk5","Type":"NodeParagraph","Properties":{"id":"20240616093045-53q2mk5","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"味甘，平、微寒，无毒。主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气，身重目黄，心下支满，虚劳客热，口干燥渴，止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健，美颜色，有子。久服轻身，不老不饥。秦名羊韭，齐名爱韭，楚名马韭，越名羊蓍，一名禹葭，一名禹余粮。叶如韭，冬夏长生。生函谷川谷及堤 肥土石间久废处。二月、三月、八月、十月采，阴干。（地黄、车前为之使，恶款冬、苦瓠，畏苦参、青 。）"}]},{"ID":"20240616093045-u4jvzhn","Type":"NodeParagraph","Properties":{"id":"20240616093045-u4jvzhn","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶函谷即秦关。而麦门冬异于羊韭之名矣。处处有，以四月采，冬月作实如青珠，根似 麦，故谓麦门冬，以肥大者为好。用之汤泽抽去心，不尔，令人烦，断谷家为要。二门冬润时并重，既燥即轻，一斤减四、五两尔。今按陈藏器本草云∶麦门冬，本经》不言生者。按生者本功外。去心煮饮，止烦热消渴，身重目黄，寒热体劳，止呕开胃，下痰饮。干者入丸散及汤用之，功如《本经》方家自有分别。出江宁小润，出新安大白，其大者苗如鹿葱。小者如韭叶。大小有三、四种，功用相似，其子圆碧。久服轻身明目。和车前子、干地黄为丸，食后服之，去温瘴，亦白，明目，夜中见光。臣禹锡等谨按吴氏云一名马韭，一名 （音门）火冬，一名忍冬，一名忍陵，一名不死药，一名仆垒，一名随脂。"}]},{"ID":"20240616093045-6z5empi","Type":"NodeParagraph","Properties":{"id":"20240616093045-6z5empi","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"神农、岐伯∶甘，平。黄帝、桐君、雷公∶甘，无毒。季氏∶甘，小温。扁鹊∶无毒。生山谷肥地，叶如韭，肥泽，丛生，采无时，实青黄。药性论云∶麦门冬，使，恶苦 ，畏木耳。"}]},{"ID":"20240616093045-yfll3n5","Type":"NodeParagraph","Properties":{"id":"20240616093045-yfll3n5","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"结气，身黑目黄，心下苦支满，虚劳客热。日华子云∶治五劳七伤，安魂定魄，止渴，肥人，时疾热狂，头痛，止嗽。"}]},{"ID":"20240616093045-mcuijmm","Type":"NodeParagraph","Properties":{"id":"20240616093045-mcuijmm","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"图经曰∶麦门冬，生函谷川谷及堤 肥土石间久废处，今所在有之。叶青似莎草，长及尺余季不凋。根黄白色，有须根作连珠，形似 麦颗，故名麦门冬。四月开淡红花，如红蓼花。"}]},{"ID":"20240616093045-e09hvlz","Type":"NodeParagraph","Properties":{"id":"20240616093045-e09hvlz","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"实碧而而圆如珠。江南出者，叶大者苗如鹿葱，小者如韭，大小有三、四种，功用相似，或云吴地者尤胜。二月、三月、八月、十月采，阴干。亦堪单作煎饵之。取新根去心，捣熟绞取汁，和白蜜，银器中重汤煮，搅不停手，候如饴乃成。酒化温服之，治中益心，悦颜色，安神，益气，令人肥健，其力甚快。又主金石药发。麦门冬去心六两，人参四两，甘草二两炙，三物下筛，蜜丸如梧子，日再饮下。又崔元亮《海上方》治消渴丸云∶偶于野人处得，神验不可言，用上元板荞麦门冬鲜肥者二大两，宣州黄连九节者二大两，去两头尖三、五节。小刀子条理去皮毛了净，吹去尘，更以生布摩拭，秤之，捣末，以肥大苦瓠汁浸麦门冬经宿，然后去心，即于臼中捣烂，即纳黄连末臼中和捣，候丸得，即并手丸大如梧子，食后饮下五十丸，日再，但服两日，其渴必定。苦重者，即初服药，每一服一百五十丸，第二日服一百二十九，第三日一百丸，第四日八十丸，第五日根据本服丸。若欲合药，先看天气晴明，其夜方浸药。切须净处，禁妇人、鸡、犬见知。如似可，每日只服二十五丸，服讫觉虚，即取白羊头一枚，净去毛洗了，以水三大斗，煮令烂，去头，取汁可一斗以来，细细服之，亦不着盐，不过三剂平复。"}]},{"ID":"20240616093045-m9ja952","Type":"NodeParagraph","Properties":{"id":"20240616093045-m9ja952","updated":"20240616093045"},"Children":[{"Type":"NodeText","Data":"衍义曰∶麦门冬，根上子也。治心肺虚热，并虚劳客热，亦可取苗作熟水饮。"}]},{"ID":"20240616093159-ofnfrnl","Type":"NodeThematicBreak","Properties":{"id":"20240616093159-ofnfrnl"}},{"ID":"20240616093200-1bznfwr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093200-1bznfwr","updated":"20240616093205"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草从新》"}]},{"ID":"20240616093200-wml54da","Type":"NodeParagraph","Properties":{"id":"20240616093200-wml54da","updated":"20240616093200"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"润肺清心、泻热．"}]},{"ID":"20240616093200-q7srr5p","Type":"NodeParagraph","Properties":{"id":"20240616093200-q7srr5p","updated":"20240616093200"},"Children":[{"Type":"NodeText","Data":"味甘．微苦微寒．润肺清心，泻热除烦．（微寒、能泻肺火．）化痰行水．（肺清则水道下行、故治浮肿．）生津止嗽．（午前嗽、多属胃火、午后嗽、及日经夜重者、多属阴虚、宜麦冬五味、同滋阴药用．）治呕吐．（胃火上冲则呕、宜麦冬、又有因寒因食因痰因虚之不同．）"}]},{"ID":"20240616093200-zq2ory6","Type":"NodeParagraph","Properties":{"id":"20240616093200-zq2ory6","updated":"20240616093200"},"Children":[{"Type":"NodeText","Data":"痿（手足缓纵曰痿 、阳明湿热上蒸于肺、肺热叶焦、发为痿 、经疏曰∶麦冬实足阳明之正药．）客热虚劳．暑伤元气．脉绝短气．（同人参五味、名生脉散、盖心主脉、肺朝百脉、补肺清心、则气充而脉复、故脉绝将死者、服此能复生之、夏月火旺克金、服之尤宜、东垣曰∶人参甘温、益元气而泻虚热、麦冬苦寒、滋燥金而清水源、五味酸温、泻丙火而补庚金、益五脏之气也．丙火小肠、庚金大肠、并主津液．）肺痿吐脓．血热妄行．经枯乳闭．明目悦颜．性寒而润．虚寒泄泻者勿用．肥白而大者佳．去心．入滋补药．酒润（制其寒．）或拌米炒黄．地黄、车前为使．恶款冬、苦参、青葙、木耳．忌鲫鱼．熬膏良．齿缝出血、煎汤漱之．）"}]},{"ID":"20240616093251-n2p37lu","Type":"NodeThematicBreak","Properties":{"id":"20240616093251-n2p37lu"}},{"ID":"20240616093253-3g857c7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093253-3g857c7","updated":"20240616093257"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草经集注》"}]},{"ID":"20240616093253-9g1ygeu","Type":"NodeParagraph","Properties":{"id":"20240616093253-9g1ygeu","updated":"20240616093253"},"Children":[{"Type":"NodeText","Data":"味甘，平、微寒，无毒。主治心腹结气，伤中，伤饱，胃络脉绝，羸瘦。短气。身重，目黄，心下支满，虚劳客热，口干燥渴，止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健，美颜色，有子。久服轻身，不老，不饥。秦名羊韭，齐名爱韭，楚名马韭，越名羊蓍，一名禹葭，一名禹余粮。叶如韭，冬夏长生。生 谷川谷及堤 肥土石间久废处。二月、三月、八月、十月采，阴干。（地黄、车前为之使，恶款冬、苦瓠，畏苦参、青 。）"}]},{"ID":"20240616093253-1jumsjm","Type":"NodeParagraph","Properties":{"id":"20240616093253-1jumsjm","updated":"20240616093253"},"Children":[{"Type":"NodeText","Data":"谷，即秦关。而门冬异于羊韭之名矣。处处有，以四月采。冬月作实如青珠，根似 ，故谓门冬，以肥大者为好。用之汤泽抽去心，不尔令人烦，断谷家为要。二门冬润时并重，既燥即轻，一斤减四、五两尔。"}]},{"ID":"20240616093240-ol4r16k","Type":"NodeThematicBreak","Properties":{"id":"20240616093240-ol4r16k"}},{"ID":"20240616093241-qp5b2wr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093241-qp5b2wr","updated":"20240616093245"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草蒙筌》"}]},{"ID":"20240616093241-z3gqu59","Type":"NodeParagraph","Properties":{"id":"20240616093241-z3gqu59","updated":"20240616093241"},"Children":[{"Type":"NodeText","Data":"味甘、微苦，气平，微寒。降也，阳中微阴。无毒。阔 平堤，土肥则产。叶类莎草长秀，根如麦颗连珠，故因名麦门冬也。畏苦参、青 、木耳，恶苦 、苦瓠、款冬。去心用不令人烦，择肥大方获效速。地黄车前为使，入手太阴少阴。治肺伏火邪，及肺痿脓吐腥臭；补心劳伤损，并心血错经妄行。益精强阴，驱烦解渴。心腹结气能散，肠胃伤饱可消。美颜色，悦肌肤，止呕吐，愈痿蹙。（音促。）去心下支满，退虚热客邪。经枯乳汁不行，堪资作引；肺燥咳声连发，须使为君。加五味、人参三者同煎，名生脉散。子专补元气，与地黄、阿胶、麻仁共享，能润经益血，复脉通心。按∶《本经》多治脾胃脏腑，后用者专疗心肺两经。久服轻身，不饥不老。"}]},{"ID":"20240616093241-pmpxa3j","Type":"NodeParagraph","Properties":{"id":"20240616093241-pmpxa3j","updated":"20240616093241"},"Children":[{"Type":"NodeText","Data":"（谟）按∶天、麦门冬并入手太阴经，而能驱烦解渴，止咳消痰。功用似同，实亦有偏胜也。"}]},{"ID":"20240616093241-t7htkum","Type":"NodeParagraph","Properties":{"id":"20240616093241-t7htkum","updated":"20240616093241"},"Children":[{"Type":"NodeText","Data":"麦门冬兼行手少阴心，每每清心降火，使肺不犯于贼邪，故止咳立效；天门冬复走足少阴肾，屡屡滋肾助元，令肺得全其母气，故消痰殊功。盖痰系津液凝成，肾司津液者也，燥盛则凝，润多则化。天门冬润剂，且复走肾经。津液纵凝，亦能化解。麦门冬虽药剂滋润则一，奈经络兼行相殊。故上而止咳，不胜于麦门冬；下而消痰，必让于天门冬尔。先哲亦曰∶痰之标在脾，痰之本在肾。又曰∶半夏惟能治痰之标，不能治痰之本。以是观之，则天门冬惟能治痰之本，不能治痰之标。匪但与麦门冬殊，亦与半夏异也。"}]},{"ID":"20240616093231-ix9v05m","Type":"NodeThematicBreak","Properties":{"id":"20240616093231-ix9v05m"}},{"ID":"20240616093232-bqign3j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093232-bqign3j","updated":"20240616093236"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草纲目》"}]},{"ID":"20240616093232-971q8a1","Type":"NodeParagraph","Properties":{"id":"20240616093232-971q8a1","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"「释名」亦名冬、禹韭、禹余粮、忍冬、忍凌、不死草、阶前草。"}]},{"ID":"20240616093232-d4tah5y","Type":"NodeParagraph","Properties":{"id":"20240616093232-d4tah5y","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"「气味」（根）甘、平、无毒。"}]},{"ID":"20240616093232-z7iyq8h","Type":"NodeParagraph","Properties":{"id":"20240616093232-z7iyq8h","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616093232-kcjs8y6","Type":"NodeParagraph","Properties":{"id":"20240616093232-kcjs8y6","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"1、消渴。把大苦瓜捣成汁，泡麦门冬二两，过一夜，麦门冬去心、捣烂，加黄连（去皮毛）研末，做成丸子，如梧子大。每服五十丸，饭后服。一天服两次。两天后当可见效。"}]},{"ID":"20240616093232-kcdjzfh","Type":"NodeParagraph","Properties":{"id":"20240616093232-kcdjzfh","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"2、吐血、鼻血。用麦门冬（去心）一斤，捣烂取汁，加蜜三合，调匀，分二次服下。"}]},{"ID":"20240616093232-spmrqel","Type":"NodeParagraph","Properties":{"id":"20240616093232-spmrqel","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"3、齿缝出血。用麦门冬煎汤漱口。"}]},{"ID":"20240616093232-t6x0t65","Type":"NodeParagraph","Properties":{"id":"20240616093232-t6x0t65","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"4、喉疮。用麦门冬一两、黄连半两，共研为末，加炼蜜做成丸子，如梧子大。每服二十丸，麦门冬煎汤送下。"}]},{"ID":"20240616093232-6picldv","Type":"NodeParagraph","Properties":{"id":"20240616093232-6picldv","updated":"20240616093232"},"Children":[{"Type":"NodeText","Data":"5、下痢口渴。用麦门冬（去心）三两、乌梅肉二十个，锉细，加水一升，煮成七合，细细饮下，有效。"}]},{"ID":"20240616093221-lzwjmp5","Type":"NodeThematicBreak","Properties":{"id":"20240616093221-lzwjmp5"}},{"ID":"20240616093222-tivl8sk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093222-tivl8sk","updated":"20240616093226"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草备要》"}]},{"ID":"20240616093222-d615431","Type":"NodeParagraph","Properties":{"id":"20240616093222-d615431","updated":"20240616093222"},"Children":[{"Type":"NodeText","Data":"补肺，清心，泻热，润燥"}]},{"ID":"20240616093222-jxlim8m","Type":"NodeParagraph","Properties":{"id":"20240616093222-jxlim8m","updated":"20240616093222"},"Children":[{"Type":"NodeText","Data":"甘微苦寒。清心润肺（东垣曰∶入手太阴气分），强阴益精，泻热除烦（微寒能泻肺火，火退则金清，金旺则水生，阴得水养，则火降心宁而精益），消痰止嗽（午前嗽多属胃火，宜芩、连、栀、柏、知母、石膏；午后嗽及日轻夜重者，多属阴虚，宜五味、麦冬、知母、四物），行水生津（肺清则水道下行，故治浮肿；火降则肾气上腾，故又治消渴）。"}]},{"ID":"20240616093222-c7z598q","Type":"NodeParagraph","Properties":{"id":"20240616093222-c7z598q","updated":"20240616093222"},"Children":[{"Type":"NodeText","Data":"治呕吐（胃火上冲则呕，宜麦冬。又有因寒、因食、因痰、因虚之不同），痿蹶（手足缓纵曰痿蹶。阳明湿热上蒸于肺，故肺热叶焦，发为痿蹶。《经疏》曰∶麦冬实足阳明胃经之正药），客热虚劳，脉绝短气（同人参、五味，名生脉散。盖心主脉，肺朝百脉，补肺清心，则气充而脉复。又有脉绝将死者，服此能复生之。夏月火旺灼金，服之尤宜。东垣曰∶人参甘寒，泻火热而益元气；麦冬苦寒，滋燥金而清水源；五味酸温，泻丙火而补庚金，益五脏之气也。丙火小肠，庚金大肠，并主津液），肺痿吐脓，血热妄行，经枯乳闭。明目悦颜（益水清火）。但性寒而泄，气弱胃寒人禁用。"}]},{"ID":"20240616093222-3g62m56","Type":"NodeParagraph","Properties":{"id":"20240616093222-3g62m56","updated":"20240616093222"},"Children":[{"Type":"NodeText","Data":"肥大者良，去心用。入滋补药酒浸（制其寒）。地黄、车前为使。恶款冬花、苦参、青葙、木耳。"}]},{"ID":"20240616093210-o3rlzaz","Type":"NodeThematicBreak","Properties":{"id":"20240616093210-o3rlzaz"}},{"ID":"20240616093211-gbtgb9y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093211-gbtgb9y","updated":"20240616093217"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草乘雅半偈》"}]},{"ID":"20240616093211-l997lq4","Type":"NodeParagraph","Properties":{"id":"20240616093211-l997lq4","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240616093211-d3atjtp","Type":"NodeParagraph","Properties":{"id":"20240616093211-d3atjtp","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"【气味】甘平，无毒。"}]},{"ID":"20240616093211-27uq18n","Type":"NodeParagraph","Properties":{"id":"20240616093211-27uq18n","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"【主治】主心腹结气，伤中、伤饱，胃络脉绝，羸瘦短气。久服轻身，不老不饥。"}]},{"ID":"20240616093211-686t94v","Type":"NodeParagraph","Properties":{"id":"20240616093211-686t94v","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出函谷川谷，及堤坡肥土石间者，多野生。出江宁、新安及仁和笕桥者多种莳。古人唯用野生者。细皱香美，宛如麦粒，功力殊胜也。四季不凋，秋冬根叶转茂、丛生如韭，青似莎草，长尺余，多纵理，四月开花如蓼，结实翠碧如珠，根须冗 ，贯须连结，俨便易燥，且不损药力。或以竹刀，连心切作薄片，醇酒浸一宿，连酒磨细，入布囊内，揉出白浆，点生姜汁、杏仁末各少许，频搅数百下，久之澄清去酒，晒干收用。入汤膏，亦连心用，方合上德全体。今人去心，不知何所本也。地黄、车前为之使。恶款冬、苦瓠。畏苦参、青、木耳。伏石钟乳。"}]},{"ID":"20240616093211-nk6ydls","Type":"NodeParagraph","Properties":{"id":"20240616093211-nk6ydls","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"绍隆王先生云∶麦门冬，具稼穑甘，禀春和令当入足阳明，为阳明之体用药，故本经所陈诸证，皆属阳明之上为病。若痿蹶，又属阳明之下为病。经云∶阳明为阖，阖折，则气无所止息而痿疾起矣。是以治痿独取诸阳明。阳明为五脏六腑之本，五脏六腑，皆受气于阳明故尔。"}]},{"ID":"20240616093211-1vxz1du","Type":"NodeParagraph","Properties":{"id":"20240616093211-1vxz1du","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"先人博议曰∶心腹脉络，皆心所主。胃络肌肉，皆心所生。美颜吐衄，唯心所现，结者能使之不结，绝者能使之不绝。唯从容润泽，潜滋暗长，沦结成形者也。"}]},{"ID":"20240616093211-km9bqbe","Type":"NodeParagraph","Properties":{"id":"20240616093211-km9bqbe","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"又云∶麦门冬，叶色尝青，根须内劲外柔，连缀贯根上，凌冬不死，随地即生。以白色可入肺，甘平可入脾，多脉理可人心，凌冬可入肾，长生可入肝，虽入五脏，以心为主，心之肾药也。其气象生成，及命名之义，能转春为夏，使肾通心，但力量不阔大，如有守有养，贞静宁谥，和润舒徐之君子也。仓皇之际，虽自愦愦，然躁进表露者，不及其久而不变也。"}]},{"ID":"20240616093211-7bmo54p","Type":"NodeParagraph","Properties":{"id":"20240616093211-7bmo54p","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"其根俨似脉络，故本经以之治心腹结气，伤中伤饱，胃络脉绝。盖心腹中央，皆心之部分，脉络亦心之所主，悉属象形对待法耳。若脉络之绝，伤中之绝，伤饱之绝，羸瘦肉理之绝，气结使然者，咸可使之复生。《别录》所云∶皆结气伤中伤饱之所生，盖强阴益精，消谷保神，安藏美色，皆复脉通心，润经益血之力也。盖心主血脉，脉溃血溢，脉伤则咳；经水已枯，乳汁不下，脉气欲绝者，皆克成效。如水入干经，而血乃成，不入于经，以致浮肿者，潜滋之妙，赖有此耳。惟阴形缓性人，及脾慢中寒有湿者，不相宜也。"}]},{"ID":"20240616093211-ea1dzar","Type":"NodeParagraph","Properties":{"id":"20240616093211-ea1dzar","updated":"20240616093211"},"Children":[{"Type":"NodeText","Data":"【 】曰∶金水主时，则根苗茂盛，有继绝续乏之义。三冬闭藏，而阴阳互根之妙。麦则独贞其窍，故处秋冬之时，能行春夏之令，以降入为升出者也，故名麦门冬。四季长生，中央坚劲，气味甘平，具土德性，当判入脾，脾之脾药也。色白属金，脾之肺药也。似脉属火，脾之心药也。不凋属水，脾之肾药也。长生属木，脾之肝药也。所谓一脏之内，具五脏焉。故五脏六腑位于内，十二经脉见于外，莫不资始于脾，资生于胃，互为枢纽者也。盖心腹结气，中央所司，伤中伤饱，胃络脉绝，羸瘦短气，象形对治，故继绝续乏之义，悉从中字起见耳。广推研释，隽永可思，盖土主中宫，长养后天，必须德全之品，相为匹配，其唯麦冬乎。至若保心之神，定肺之气，安肝之魂，补肾之精，因脾转属者，无所不宜。若脉伤则咳，经络断绝，致血液妄行，经水枯竭，变生烦热焦渴者，求其因而借用之亦可。大抵象形对治，更相宜也。先人有议，辄加推展如此。"}]},{"ID":"20240616093149-uiu1qu7","Type":"NodeThematicBreak","Properties":{"id":"20240616093149-uiu1qu7"}},{"ID":"20240616093150-qt7y8v5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093150-qt7y8v5","updated":"20240616093154"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草经解》"}]},{"ID":"20240616093150-938p80r","Type":"NodeParagraph","Properties":{"id":"20240616093150-938p80r","updated":"20240616093150"},"Children":[{"Type":"NodeText","Data":"气平．味甘．无毒．主心腹结气．伤中伤饱．胃络脉绝．羸瘦短气．久服轻身．不老不饥．（去心）"}]},{"ID":"20240616093150-41vebyn","Type":"NodeParagraph","Properties":{"id":"20240616093150-41vebyn","updated":"20240616093150"},"Children":[{"Type":"NodeText","Data":"麦冬气平．禀天秋平之金气．入手太阴肺经．味甘无毒．得地中和之土味．入足太阴脾经．气降味和．阴也．心腹者．肺脾之分．结气者．邪热之气结也．其主之者．麦冬甘平．平能清热．甘缓散结也．中者阴也．伤中者阴伤也．甘平益阴．故主伤中．脾为胃行津液者也．脾血不润．则不能为胃行津液．而伤饱之症生矣．味甘而润．滋养脾血．故主伤饱．脉者血之府．胃与脾合．胃络脉绝者．脾血不统．脉络不与胃相接也．甘润养阴．所以续脉．脾主肌肉．而禀气于胃．脾阴不润．则肌肉不长．而胃气上逆．肺亦能呼不能吸．而气短促矣．麦冬味甘益脾．故主羸瘦．气平益肺．故主短气也．久服肺气充．所以身轻．脾血润．所以不老不饥也．"}]},{"ID":"20240616093150-1hg8tzx","Type":"NodeParagraph","Properties":{"id":"20240616093150-1hg8tzx","updated":"20240616093150"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240616093150-61by181","Type":"NodeParagraph","Properties":{"id":"20240616093150-61by181","updated":"20240616093150"},"Children":[{"Type":"NodeText","Data":"麦冬同川连．治消渴饮水．同甘草、粳米、大枣、竹叶．治劳气欲绝．同乌梅．治下利口渴．同人参、北味、杞子．治虚热病暑．同沙参、北味．治心肺虚热．"}]},{"ID":"20240616093432-yna5w60","Type":"NodeThematicBreak","Properties":{"id":"20240616093432-yna5w60"}},{"ID":"20240616093434-8xvownq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093434-8xvownq","updated":"20240616093438"},"Children":[{"Type":"NodeText","Data":"麦门冬《神农本草经百种录》"}]},{"ID":"20240616093434-lf2b9rx","Type":"NodeParagraph","Properties":{"id":"20240616093434-lf2b9rx","updated":"20240616093434"},"Children":[{"Type":"NodeText","Data":"味甘平。主心腹结气，解枯燥之结气。伤中伤饱，胃络脉绝，补续胃中之阴气。羸瘦短气。补胃则生肌，清火则益气。久服，轻身耐老，不饥。后天足则体健而能耐饥也。"}]},{"ID":"20240616093434-uubz915","Type":"NodeParagraph","Properties":{"id":"20240616093434-uubz915","updated":"20240616093445"},"Children":[{"Type":"NodeText","Data":"麦冬甘平滋润，为纯补胃阴之药。后人以为肺药者，盖土能生金，肺气全恃胃阴以生。胃气润肺,自资其益也。"}]},{"ID":"20240616093134-29f8lbd","Type":"NodeThematicBreak","Properties":{"id":"20240616093134-29f8lbd"}},{"ID":"20240616093135-3qsa018","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093135-3qsa018","updated":"20240616093145"},"Children":[{"Type":"NodeText","Data":"麦门冬《医学入门》"}]},{"ID":"20240616093135-g0l01oa","Type":"NodeParagraph","Properties":{"id":"20240616093135-g0l01oa","updated":"20240616093135"},"Children":[{"Type":"NodeText","Data":"麦门冬甘气微寒，清肺火令心安神，养阴通脉医痿蹶，清谷调中治呕干。"}]},{"ID":"20240616093135-7zy1qz6","Type":"NodeParagraph","Properties":{"id":"20240616093135-7zy1qz6","updated":"20240616093135"},"Children":[{"Type":"NodeText","Data":"形如 麦。无毒。降也，阳中之阴。入手太阴经。泻肺火，生肺金。治咳嗽烦渴、血热妄行及肺痿吐脓，安心神，清心热及心下支满。夫伏火去则金清自能生水，而阴精日长日固。心神安则血有所统，而客热自散。"}]},{"ID":"20240616093135-m9pya2e","Type":"NodeParagraph","Properties":{"id":"20240616093135-m9pya2e","updated":"20240616093135"},"Children":[{"Type":"NodeText","Data":"又脉失及痿蹶必用者，心肺润而血脉自通也。大抵后人治心肺多，古人治脾胃多。经云∶消谷调中，止呕吐。主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气，身重目黄口干。久服安五脏，美颜色，令有肥健有子。去心用，不令人烦。行经酒浸。地黄、车前为使。恶款冬花，畏苦参。"}]},{"ID":"20240616093111-wn7lsrv","Type":"NodeThematicBreak","Properties":{"id":"20240616093111-wn7lsrv"}},{"ID":"20240616093112-6t9kvxe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093112-6t9kvxe","updated":"20240616093116"},"Children":[{"Type":"NodeText","Data":"麦门冬《侣山堂类辩》"}]},{"ID":"20240616093112-tvzo55v","Type":"NodeParagraph","Properties":{"id":"20240616093112-tvzo55v","updated":"20240616093112"},"Children":[{"Type":"NodeText","Data":"经云∶人之所受气者，谷也；谷之所注者，胃也；胃者，水谷血气之海也。海之所行云气者，天下也，胃之所出血气者，经隧也。经隧者，五脏六腑之大络也。是脏腑受水谷之精气，由胃腑之大络，通于脏腑之经。麦门冬主伤中伤饱，胃络脉绝，以其根须从中而贯，如络脉之贯于募原之中，是通胸络之气，藉中心之贯通也。麦冬经冬不凋，能启阴气，上滋于心肺，故主心腹结气，咳嗽虚劳。肾脉上贯肝膈，入肺中，从肺出络心，是肾气之上交于心肺。心肺之痰热，欲从下解者，又咸藉麦冬之心而导引于脉中也。盖凡物之寒凉者，其心必热，热者，阴中之阳也。人但知去热，而不知用阳，得其阳，而后能通阴中之气。"}]},{"ID":"20240616093121-rlbipwd","Type":"NodeThematicBreak","Properties":{"id":"20240616093121-rlbipwd"}},{"ID":"20240616093122-60yov06","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093122-60yov06","updated":"20240616093126"},"Children":[{"Type":"NodeText","Data":"麦门冬《顾松园医镜》"}]},{"ID":"20240616093122-mru4sfl","Type":"NodeParagraph","Properties":{"id":"20240616093122-mru4sfl","updated":"20240616093122"},"Children":[{"Type":"NodeText","Data":"〔甘微寒，入心、肺、胃三经。忌鲫鱼。去心用。〕退肺中伏火，〔色白性寒，故清肺多功。〕清心内烦热，〔如盛热得凉风，炎蒸若失。〕止渴益精，宁嗽除喘。〔金不燥则不渴，金生水则益精，火不乘金，而咳喘俱宁。〕主妄行之血，〔心主血，心清则血不妄行。〕除虚劳之热，〔阴虚则热，养阴则热自除。〕能止呕吐，〔胃热不上冲也。〕善疔痿 。〔清肺胃之热，痿 治本之道也。〕治经水干枯及乳汁不下。〔内热既除，精血自生。〕润肺除热、清心，为心肺虚热之神品。以甘先入脾胃，故又为阳明之正药。本经谓其主羸弱者胃病则脾无所禀，而肌肉不生。《别录录》谓其疗身重目黄，心下支满，能消谷调中者。盖脾胃之热去，则湿除而诸症愈，脾胃安而能食，肥健矣。"}]},{"ID":"20240616093122-zn4dlpz","Type":"NodeParagraph","Properties":{"id":"20240616093122-zn4dlpz","updated":"20240616093122"},"Children":[{"Type":"NodeText","Data":"虚寒泄泻者忌之。"}]},{"ID":"20240616093059-xacs163","Type":"NodeThematicBreak","Properties":{"id":"20240616093059-xacs163"}},{"ID":"20240616093100-f66mcvr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093100-f66mcvr","updated":"20240616093107"},"Children":[{"Type":"NodeText","Data":"麦门冬《本草图经》"}]},{"ID":"20240616093100-0hsgl2t","Type":"NodeParagraph","Properties":{"id":"20240616093100-0hsgl2t","updated":"20240616093103"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"麦门冬"},{"Type":"NodeText","Data":"，生亟谷川谷及堤 肥土石间久废处，今所在有之。叶青似莎草，长及尺余，四季不凋，根黄白色有须，根作连珠形，似 麦颗，故名麦门冬。四月，开淡红花，如红蓼花；实碧而圆如珠。江南出者∶叶大者，苗如粗葱，小者如韭。大小有三、四种，功用相似，或云吴地者尤胜。二月、三月、八月、十月采，阴干。亦堪单作煎饵之。取新根去心，捣熟，绞取汁，和白蜜，银器中重汤煮，搅不停手，候如饴乃成，酒化温服之。治中益心，悦颜色，安神，益气，令人肥健，其力甚快。又主金石药发。麦门冬去心六两，人参四两，甘草二两炙，三物下筛，蜜丸如梧子，日再饮下。又崔元亮《海上方》，治消渴丸云∶偶于野人处得，神验不可言，用上元板桥麦门冬鲜肥者二大两，宣州黄连九节者二大两，去两头尖三、五节，小刀子条理，去皮毛了净，吹去尘，更以生布摩拭，秤之，捣末，以肥大苦瓠汁浸麦门冬，经宿，然后去心，即于臼中捣烂，即内黄连末臼中，和捣，候丸得，即并手丸大如梧子，食后饮下五十丸，日再，但服两日，其渴必定。若重者，即初服药，每一服一百五十丸，每二日服一百二十丸，第三日一百丸，每四日八十丸，第五日依本服丸。若欲合药，先看天气晴明，其夜方浸药，切须净处，禁妇人、鸡犬见知，如似可，每日只服二十五丸。服讫觉虚，即取白羊头一枚，净去毛，洗了，以水三大斗，煮令烂，去头，取汁可一斗以来，细细服之，亦不着盐，不过三剂平复。"}]},{"ID":"20240616093018-wn5trc6","Type":"NodeThematicBreak","Properties":{"id":"20240616093018-wn5trc6"}},{"ID":"20240616093019-nd0397t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093019-nd0397t","updated":"20240616093023"},"Children":[{"Type":"NodeText","Data":"麦门冬《得配本草》"}]},{"ID":"20240616093019-4g9hb07","Type":"NodeParagraph","Properties":{"id":"20240616093019-4g9hb07","updated":"20240616093019"},"Children":[{"Type":"NodeText","Data":"地黄、车前为之使。畏苦参、青葙、木耳。恶款冬、苦芙、苦瓠。忌鲫鱼。伏石钟乳。"}]},{"ID":"20240616093019-e2w2pjc","Type":"NodeParagraph","Properties":{"id":"20240616093019-e2w2pjc","updated":"20240616093019"},"Children":[{"Type":"NodeText","Data":"甘平、微苦，凉。入手少阴、太阴经气分。生上焦之津液，清胸膈之渴烦。治呕吐止吐衄，消痰嗽，止泄精，疗痿厥，去支满，散结气。得乌梅，治下痢口渴。得犀角，治乳汁不下。"}]},{"ID":"20240616093019-t7heyru","Type":"NodeParagraph","Properties":{"id":"20240616093019-t7heyru","updated":"20240616093019"},"Children":[{"Type":"NodeText","Data":"得桔梗，清金气之郁。得荷叶，清胆腑之气。佐地黄、阿胶，润经血。佐生地、川贝，治吐衄。心能令人烦，去心，忌铁。入凉药，生用。入补药，酒浸，糯米拌蒸亦可。气虚胃寒者禁用。"}]},{"ID":"20240616092959-fncoi06","Type":"NodeThematicBreak","Properties":{"id":"20240616092959-fncoi06"}},{"ID":"20240616092958-hsppzvd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092958-hsppzvd","updated":"20240616093012"},"Children":[{"Type":"NodeText","Data":"麦门冬《本经逢原》"}]},{"ID":"20240616092958-89o4xvb","Type":"NodeParagraph","Properties":{"id":"20240616092958-89o4xvb","updated":"20240616093005"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"本作麦冬"}]},{"ID":"20240616092958-dpxt3a4","Type":"NodeParagraph","Properties":{"id":"20240616092958-dpxt3a4","updated":"20240616092958"},"Children":[{"Type":"NodeText","Data":"甘寒，无毒。去心用，即不烦心。"}]},{"ID":"20240616092958-ml6evmq","Type":"NodeParagraph","Properties":{"id":"20240616092958-ml6evmq","updated":"20240616092958"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气，久服轻身不老，不饥。"}]},{"ID":"20240616092958-pq3h3ib","Type":"NodeParagraph","Properties":{"id":"20240616092958-pq3h3ib","updated":"20240616092958"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"麦门冬阳中微阴，入心肺肾及足阳明之经，定心热惊烦，疗肺痿吐脓。盖专泄而不专收，寒多人禁服。肺中伏火，脉气欲绝者，加五味子、人参为生脉散，专补脉中元气不足。东垣云∶六七月间湿热方盛，人病骨乏无力，身重气短，头旋眼黑，甚则痿软。故孙真人以生脉散补其天元真气。脉者，人之元气也。人参之甘温，泻阴火而益元气。麦门冬甘寒，滋燥金而清水源。五味子之酸咸，泻丙火而补庚金，兼益五脏之气也。时珍曰∶麦门冬以地黄为使，服之令人头不白，添精补髓，通肾气，定喘促，令人肌体滑泽。《本经》主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气，一气贯下，言因过饱伤胃而致心腹气结，脉绝不通，羸瘦短气，故宜以此滋其津液，通其肺胃，殊非开豁痰气，消克饮食之谓。其阴虚羸瘦，喘咳上气，失音失血及风热暴嗽，咸非所宜；恐寒郁热邪，牢不可破，多成虚损之疾。麻疹咳嗽不可误用，以其性寒助阴，固敛阳邪不能发越也。凡脾胃虚寒泄泻及痘疮虚寒作泻，产后血虚泻渴，皆非所宜。"}]},{"ID":"20240616092944-spi1lm6","Type":"NodeThematicBreak","Properties":{"id":"20240616092944-spi1lm6"}},{"ID":"20240616092946-wwqtwhr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092946-wwqtwhr","updated":"20240616092950"},"Children":[{"Type":"NodeText","Data":"麦门冬《汤液本草》"}]},{"ID":"20240616092946-phvn7k8","Type":"NodeParagraph","Properties":{"id":"20240616092946-phvn7k8","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"气寒，味微苦甘。微寒，阳中微阴也。无毒。"}]},{"ID":"20240616092946-jzc3l8w","Type":"NodeParagraph","Properties":{"id":"20240616092946-jzc3l8w","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"入手太阴经。"}]},{"ID":"20240616092946-ev9wglx","Type":"NodeParagraph","Properties":{"id":"20240616092946-ev9wglx","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"《象》云∶治肺中伏火，脉气欲绝。加五味子、人参。三味为生脉之剂，补肺中元气不足。"}]},{"ID":"20240616092946-6r788yj","Type":"NodeParagraph","Properties":{"id":"20240616092946-6r788yj","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"《珍》云∶行经，酒浸、汤浸。去心，治经枯。"}]},{"ID":"20240616092946-onib8aj","Type":"NodeParagraph","Properties":{"id":"20240616092946-onib8aj","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"《心》云∶补心气不足，及治血妄行，补心不足。"}]},{"ID":"20240616092946-m2o6ftv","Type":"NodeParagraph","Properties":{"id":"20240616092946-m2o6ftv","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气。身重目黄，心下支满，虚劳客热，口干燥渴，止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健，美颜色，有子。地黄、车前子为之使，恶款冬花、苦瓠。畏苦参、青 。入手太阴。"}]},{"ID":"20240616092946-vn939dc","Type":"NodeParagraph","Properties":{"id":"20240616092946-vn939dc","updated":"20240616092946"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶治肺热之功为多，其味苦，但专泄而不专收，寒多人禁服。治心肺虚热及虚劳。麦门冬、地黄、麻仁、阿胶，润经益血，复脉通心。二门冬、五味子、枸杞子，同为生脉之剂。"}]},{"ID":"20240616092931-fpevr6h","Type":"NodeThematicBreak","Properties":{"id":"20240616092931-fpevr6h"}},{"ID":"20240616092932-6utjh2r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092932-6utjh2r","updated":"20240616092939"},"Children":[{"Type":"NodeText","Data":"麦门冬《冯氏锦囊秘录》"}]},{"ID":"20240616092932-67zaj2d","Type":"NodeParagraph","Properties":{"id":"20240616092932-67zaj2d","updated":"20240616092932"},"Children":[{"Type":"NodeText","Data":"在天则禀春阳生生之气，在地则感清和稼穑之甘，故甘平微寒无毒。如滋阴润肺去心生用，如同脾肺药兼用，宜拌米炒黄用。"}]},{"ID":"20240616092932-xnzduhc","Type":"NodeParagraph","Properties":{"id":"20240616092932-xnzduhc","updated":"20240616092932"},"Children":[{"Type":"NodeText","Data":"麦冬，治肺家伏火之邪，肺痿吐脓腥臭。补心脏劳伤虚损，心血错经妄行。益精强阴，驱烦解渴。心腹结气能散，无克伐太过之伤；脾胃虚滞可消，有宽饱舒怀之益。"}]},{"ID":"20240616092932-edlw72o","Type":"NodeParagraph","Properties":{"id":"20240616092932-edlw72o","updated":"20240616092932"},"Children":[{"Type":"NodeText","Data":"和颜色，悦肌肤，清膈上之稠痰；调四肢之经脉，去心下支满，退虚热客邪，经枯乳汁不行，堪资作引。肺燥咳声连发，须仗为君同人参五味煎，名生脉散，专补元气。共地黄、阿胶、麻仁用，能润经益血，复脉通心。滋燥金以壮水源，但专泄而不专收。中寒有湿者少服，脾胃虚寒，产后泄泻者忌之。"}]},{"ID":"20240616092932-by5nnne","Type":"NodeParagraph","Properties":{"id":"20240616092932-by5nnne","updated":"20240616092932"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 安五脏，润经益血，清热补心，生脉止烦，清心润肺宣痘，五六朝肺气虚热，上喘作渴及痘无脓者可用。痘后尤宜，但不可早用，恐引毒内行，若泄泻者尤忌之。"}]},{"ID":"20240616092932-ddp1pbt","Type":"NodeParagraph","Properties":{"id":"20240616092932-ddp1pbt","updated":"20240616092932"},"Children":[{"Type":"NodeText","Data":"按∶麦门冬禀秋令之微寒，是以清心润肺之功居多。夫心火焦烦，势如盛暑，秋风一至，炎蒸若失矣。较之天冬甘味稍多，寒性差减，更胜一筹。火盛气壮者多用、生用并宜，气弱胃寒者少用、炒用为妙。"}]},{"ID":"20240616092921-ivnjgez","Type":"NodeThematicBreak","Properties":{"id":"20240616092921-ivnjgez"}},{"ID":"20240616092921-yye928k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092921-yye928k","updated":"20240616092925"},"Children":[{"Type":"NodeText","Data":"麦门冬《新修本草》"}]},{"ID":"20240616092921-xakfx9l","Type":"NodeParagraph","Properties":{"id":"20240616092921-xakfx9l","updated":"20240616092921"},"Children":[{"Type":"NodeText","Data":"味甘，平、微寒，无毒。主心腹结气，伤中、伤饱，胃络脉绝，羸瘦短气。身重、目黄，心下支满，虚劳客热，口干燥渴，止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健，美颜色，有子。久服轻身、不老、不饥。秦名羊韭，齐名爱韭，楚名马韭，越名羊蓍，一名禹葭，一名禹余粮。叶如韭，冬夏长生。生函谷川谷及堤 肥土石间久废处。二月、三月、八月、十月采，阴干。"}]},{"ID":"20240616092921-mbh2vpy","Type":"NodeParagraph","Properties":{"id":"20240616092921-mbh2vpy","updated":"20240616092921"},"Children":[{"Type":"NodeText","Data":"地黄、车前为之使，恶款冬、苦瓠，畏苦参、青 。函谷，即秦关。而麦门冬异于羊韭之名矣。处处有，以四月采，冬月作实如青珠，根似 麦，故谓麦门冬，以肥大者为好。用之汤泽抽去心，不尔令人烦，断谷家为要。二门冬润时并重，既燥即轻，一斤减四、五两尔。"}]},{"ID":"20240616092910-4nt3bh9","Type":"NodeThematicBreak","Properties":{"id":"20240616092910-4nt3bh9"}},{"ID":"20240616092911-j5iw8qe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092911-j5iw8qe","updated":"20240616092916"},"Children":[{"Type":"NodeText","Data":"麦门冬《名医别录》"}]},{"ID":"20240616092911-peel0kc","Type":"NodeParagraph","Properties":{"id":"20240616092911-peel0kc","updated":"20240616092911"},"Children":[{"Type":"NodeText","Data":"微寒，无毒．主治身重目黄，心下支满，虚劳、客热，口干、燥渴，止呕吐，愈痿强阴，益精，消谷调中，保神，定肺气，安五脏，令人肥健，美颜色，有子．秦名、羊齐名爱韭，楚名乌韭，越名羊蓍，一名禹葭，一名禹余粮．叶如韭，冬夏长生．生函谷肥土石间久废处．二月、三月、八月、十月采，阴干．（地黄、车前为之使，恶款冬瓠，畏苦参、青 ．）"}]},{"ID":"20240616092911-wt5drrg","Type":"NodeParagraph","Properties":{"id":"20240616092911-wt5drrg","updated":"20240616092911"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶麦门冬，味甘，平．主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气．久服，轻身不老不饥．"}]},{"ID":"20240616092835-frf97g6","Type":"NodeThematicBreak","Properties":{"id":"20240616092835-frf97g6"}},{"ID":"20240616092836-omk6dex","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616092836-omk6dex","updated":"20240616092839"},"Children":[{"Type":"NodeText","Data":"麦门冬《神农本草经读》"}]},{"ID":"20240616092836-mse7z0b","Type":"NodeParagraph","Properties":{"id":"20240616092836-mse7z0b","updated":"20240616092836"},"Children":[{"Type":"NodeText","Data":"气味甘、平，无毒。主心腹结气，伤中伤饥，胃脉绝，羸瘦短气。久服轻身不老，不饥。"}]},{"ID":"20240616092836-88a5asp","Type":"NodeParagraph","Properties":{"id":"20240616092836-88a5asp","updated":"20240616092836"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶麦冬，本横生，根颗联系。有十二枚者，有十四枚者，有十五、六枚者，盖合于人身十二络。加任之屏翳，督之长强，为十四络；又加脾之大络名大包，共十五络；又加胃之大络名虚里，共十六络。唯圣人能体察之，用之以通脉络，并无“去心”二字。后人不详经义，不穷物理，相沿去心久矣，今特表正之。《经》云∶主心腹结气，伤中伤饥，胃络脉绝者，以麦冬根颗联系不断，能通达上下四旁，令结者解，伤者复，绝者续，皆借中心之贯通也。又主羸瘦短气者，补胃自能生肌，补肾自能纳气也。久服轻身不老、不饥者，先天与后天俱足，斯体健而耐饥矣。（《崇原》曰∶“麦冬气味甘平，质性柔润，凌冬青翠，盖禀少阴冬水之精，与阳明胃土相合。）”又曰∶凡物之凉者，其心必热，热者阴中之阳也。"}]},{"ID":"20240616092836-26o2onn","Type":"NodeParagraph","Properties":{"id":"20240616092836-26o2onn","updated":"20240616092836"},"Children":[{"Type":"NodeText","Data":"人但知去热，而不知用阳，得其阳而后能通阴中之气。"}]},{"ID":"20240616093308-cldp530","Type":"NodeThematicBreak","Properties":{"id":"20240616093308-cldp530"}},{"ID":"20240616093309-mainh53","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616093309-mainh53","updated":"20240616093313"},"Children":[{"Type":"NodeText","Data":"麦门冬《中药学》"}]},{"ID":"20240616093309-fyy8m9h","Type":"NodeParagraph","Properties":{"id":"20240616093309-fyy8m9h","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为百合科植物沿阶草的块根。"}]},{"ID":"20240616093309-mya6sgc","Type":"NodeParagraph","Properties":{"id":"20240616093309-mya6sgc","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、微苦，微寒。入心、肺、胃经。"}]},{"ID":"20240616093309-7ks2k1f","Type":"NodeParagraph","Properties":{"id":"20240616093309-7ks2k1f","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【功效】清心润肺，养胃生津。"}]},{"ID":"20240616093309-oyed80q","Type":"NodeParagraph","Properties":{"id":"20240616093309-oyed80q","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肺阴受伤，燥咳，咯血，以及心烦不安等症。"}]},{"ID":"20240616093309-knzejig","Type":"NodeParagraph","Properties":{"id":"20240616093309-knzejig","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"麦冬为清润之品，既能润肺止咳，又能清心降火。用治肺虚热咳，咯血等症，可与沙参、天冬、生地等配伍；用于清心除烦，可与竹叶卷心、莲子心等同用。"}]},{"ID":"20240616093309-b3ezc10","Type":"NodeParagraph","Properties":{"id":"20240616093309-b3ezc10","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"2.用于津少口渴等症。"}]},{"ID":"20240616093309-jjlbvsn","Type":"NodeParagraph","Properties":{"id":"20240616093309-jjlbvsn","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"麦冬能滋养胃阴而生津，故可用于阴虚内热、胃阴耗伤、津少口渴等症，常与石斛、沙参、天冬、生地、玉竹等配伍应用。"}]},{"ID":"20240616093309-knfcrpo","Type":"NodeParagraph","Properties":{"id":"20240616093309-knfcrpo","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【处方用名】麦冬、麦门冬、笕麦冬（指产浙江笕桥者）、寸麦冬（指粗大盈寸者）（洗净，晒干用）。"}]},{"ID":"20240616093309-hsg9248","Type":"NodeParagraph","Properties":{"id":"20240616093309-hsg9248","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240616093309-zdoir7y","Type":"NodeParagraph","Properties":{"id":"20240616093309-zdoir7y","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【按语】1.麦冬味甘气凉，质柔多汁，长于滋燥泽枯，养阴生津，善治肺胃虚热，且能清心除烦。"}]},{"ID":"20240616093309-vddo8xa","Type":"NodeParagraph","Properties":{"id":"20240616093309-vddo8xa","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"2.本品又有清热润燥滑肠之功，与玄参相似，两药常相须配合，用于热病伤津、肠燥便秘。如属脾胃虚寒，大便溏泻或有湿滞者，不宜应用。"}]},{"ID":"20240616093309-xadj507","Type":"NodeParagraph","Properties":{"id":"20240616093309-xadj507","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"3.麦冬与天冬，都是甘寒清润的药品，两者养阴润燥的功效相似，故对肺阴受伤、干咳少痰等症，常配合同用。但麦冬润肺，又能养胃清心；天冬润肺，又能滋肾，性较寒凉。如胃阴不足、心烦燥渴等症，多用麦冬；肾阴亏损、潮热遗精等症，则多用天冬。"}]},{"ID":"20240616093309-vqdv354","Type":"NodeParagraph","Properties":{"id":"20240616093309-vqdv354","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【方剂举例】益胃汤《温病条辨》：麦冬、沙参、生地、玉竹、冰糖。治胃热液枯。"}]},{"ID":"20240616093309-6umxxe6","Type":"NodeParagraph","Properties":{"id":"20240616093309-6umxxe6","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主心腹结气，伤中伤饱，胃络脉绝，赢瘦短气。」"}]},{"ID":"20240616093309-hbjrsrj","Type":"NodeParagraph","Properties":{"id":"20240616093309-hbjrsrj","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"《别录》：「疗虚痨客热，口干燥渴....定肺气，安五脏。」"}]},{"ID":"20240616093309-u45ydg5","Type":"NodeParagraph","Properties":{"id":"20240616093309-u45ydg5","updated":"20240616093309"},"Children":[{"Type":"NodeText","Data":"《本草蒙筌》：「天麦门冬并....能殴烦解渴，止咳消痰，功用似同，实亦有偏胜也。麦门冬……每每清心降火，使肺不犯于贼邪，故止咳立效；天门冬……屡屡滋肾助元‥…‥故消痰殊功。」"}]},{"ID":"20240607100851-dwwmoqq","Type":"NodeThematicBreak","Properties":{"id":"20240607100851-dwwmoqq"}},{"ID":"20240607100852-fsmqny9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607100852-fsmqny9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：麦门冬"}]},{"ID":"20240607100852-fl39s9j","Type":"NodeParagraph","Properties":{"id":"20240607100852-fl39s9j","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607100852-codd9s8","Type":"NodeParagraph","Properties":{"id":"20240607100852-codd9s8","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" Mài Mén Dōnɡ"}]},{"ID":"20240607100852-oyhk7oh","Type":"NodeParagraph","Properties":{"id":"20240607100852-oyhk7oh","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607100852-lzq60di","Type":"NodeParagraph","Properties":{"id":"20240607100852-lzq60di","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 麦冬（《药品化义》）"}]},{"ID":"20240607100852-94bj35z","Type":"NodeParagraph","Properties":{"id":"20240607100852-94bj35z","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607100852-wone7zf","Type":"NodeParagraph","Properties":{"id":"20240607100852-wone7zf","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607100852-hyb4k7v","Type":"NodeParagraph","Properties":{"id":"20240607100852-hyb4k7v","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607100852-2qlqkkq","Type":"NodeParagraph","Properties":{"id":"20240607100852-2qlqkkq","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"沿阶草"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。商品大多为栽培品。浙江于栽培后第三年立夏时采挖，称\"杭麦冬\"；四川于栽培第二年清明后采挖，称\"川麦冬\"。野麦冬多在清明后挖取，习称\"土麦冬\"。麦冬挖起后，剪下块根，洗净泥土，暴晒3～4天，堆通风处，使其反潮，蒸发水气，约3日，摊开再晒，如此反复2～3次。晒干后，除净须根杂质即可。"}]},{"ID":"20240607100852-wlfy7nu","Type":"NodeParagraph","Properties":{"id":"20240607100852-wlfy7nu","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607100852-vkn2t7x","Type":"NodeParagraph","Properties":{"id":"20240607100852-vkn2t7x","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 生长于溪沟岸边或山坡树林下。全国大部分地区有分布，或为栽培。主产浙江、四川。此外，江苏、贵州、云南、广西、安徽、湖北、湖南等地亦产，但多野生，少有栽培。"}]},{"ID":"20240607100852-t9pugb0","Type":"NodeParagraph","Properties":{"id":"20240607100852-t9pugb0","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607100852-wovmlpg","Type":"NodeParagraph","Properties":{"id":"20240607100852-wovmlpg","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 沿阶草（《江西通志》），又名：羊韭、马韭、羊荠、爱韭、禹韭、忍陵、不死药、仆垒、随脂（《吴普本草》），羊耆、禹葭（《别录》），阶前草（《纲目》），书带草、秀墩草（《群芳谱》），马粪草、家边草、韭叶麦冬。"}]},{"ID":"20240607100852-o36nb9r","Type":"NodeParagraph","Properties":{"id":"20240607100852-o36nb9r","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"多年生草本，高15～40厘米。地下具细长匍匐枝，节上被膜质苞片：须根常有部分膨大成肉质的块根。叶丛生，窄线形，长,15～40厘米，宽1～4毫米，先端钝或锐尖，基部狭窄，叶柄鞘状，两侧有薄膜。花茎长6.5～14厘米；总状花序顶生；苞片膜质，每苞腋生1～3花；花淡紫色，偶为白色，形小，略下垂；花被6片，开展，卵圆形；雄蕊6，花丝不明显，较短于花药，花药先端尖；子房半下位，3室。浆果球状，成熟时深绿色或黑蓝色，直径5～7毫米。花期7月。果期11月。"}]},{"ID":"20240607100852-rk9gx9v","Type":"NodeParagraph","Properties":{"id":"20240607100852-rk9gx9v","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607100852-mot6wqw","Type":"NodeParagraph","Properties":{"id":"20240607100852-mot6wqw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" ①杭麦冬"}]},{"ID":"20240607100852-8hm6bgm","Type":"NodeParagraph","Properties":{"id":"20240607100852-8hm6bgm","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"又名：笕麦冬、浙麦冬。干燥块根呈纺锤形，两头钝尖，中部肥满，微弯曲，长2厘米左右，有的可达4厘米，中部直径4～6毫米。表面黄白色，半透明，有不规则的纵皱纹。未干透时，质较柔韧，干后质坚硬。折断面黄白色，角质状。横断面中央有细小的木质部。气微香，味微甜。"}]},{"ID":"20240607100852-avudyuy","Type":"NodeParagraph","Properties":{"id":"20240607100852-avudyuy","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②川麦冬形状与杭麦冬相似而较短粗。表面乳白色，有光泽。质较坚硬；香气较小；味较淡，少粘性。"}]},{"ID":"20240607100852-7n0kivm","Type":"NodeParagraph","Properties":{"id":"20240607100852-7n0kivm","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③土麦冬"}]},{"ID":"20240607100852-vugdudu","Type":"NodeParagraph","Properties":{"id":"20240607100852-vugdudu","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"表面粗糙皱缩，黄黑色，形体瘦小，纤维性强。"}]},{"ID":"20240607100852-36x302v","Type":"NodeParagraph","Properties":{"id":"20240607100852-36x302v","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"以上均以表面淡黄白色、肥大、质柔、气香、味甜、嚼之发粘者为佳。瘦小、色棕黄、嚼之粘性小者为次。"}]},{"ID":"20240607100852-k12xrp7","Type":"NodeParagraph","Properties":{"id":"20240607100852-k12xrp7","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607100852-bnqj6uj","Type":"NodeParagraph","Properties":{"id":"20240607100852-bnqj6uj","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 沿阶草块根含多种甾体皂甙，其甙元为罗斯考皂甙元；还含β-谷甾醇、豆甾醇、β-谷甾醇-β-D-葡萄糖甙。果实含沿阶草甙，为山柰酚-3-葡萄糖半乳糖甙。"}]},{"ID":"20240607100852-qyqww9z","Type":"NodeParagraph","Properties":{"id":"20240607100852-qyqww9z","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"沿阶草变种块茎含多种甾体皂甙，分别称做沿阶草皂甙A、B、C、D等。其中沿阶草甙A、B、D的甙元都是罗斯考皂甙元。还含β-谷甾醇、豆甾醇、β-谷甾醇-β-L-葡萄糖甙；果实含沿阶草甙。"}]},{"ID":"20240607100852-y8jf321","Type":"NodeParagraph","Properties":{"id":"20240607100852-y8jf321","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"大叶麦冬块根含β-谷甾醇、氨基酸、维生素A、葡萄糖、甾体皂甙。"}]},{"ID":"20240607100852-na1h193","Type":"NodeParagraph","Properties":{"id":"20240607100852-na1h193","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607100852-nbgsuqu","Type":"NodeParagraph","Properties":{"id":"20240607100852-nbgsuqu","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" ①对血糖的影响"}]},{"ID":"20240607100852-s6et7tw","Type":"NodeParagraph","Properties":{"id":"20240607100852-s6et7tw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"家兔用50％麦冬煎剂肌肉注射（1毫升/公斤），能升高血糖。另谓正常兔口服麦冬的水、醇提取物0.2克/公斤，则有降血糖作用；对四氧嘧啶性糖尿病兔，用0.5克/公斤/日，连续4日亦有降血糖作用，并促使胰岛细胞恢复，肝糖元较对照组有增加趋势。"}]},{"ID":"20240607100852-9zggxdu","Type":"NodeParagraph","Properties":{"id":"20240607100852-9zggxdu","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②抗菌作用"}]},{"ID":"20240607100852-j27rtnl","Type":"NodeParagraph","Properties":{"id":"20240607100852-j27rtnl","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"麦冬粉在体外对白色葡萄球菌、大肠杆菌等有某些抗菌作用。（以上药理项麦冬品种均未经鉴定）"}]},{"ID":"20240607100852-vqheomm","Type":"NodeParagraph","Properties":{"id":"20240607100852-vqheomm","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607100852-mrn4eww","Type":"NodeParagraph","Properties":{"id":"20240607100852-mrn4eww","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 麦冬：拣净杂质，用水浸泡，捞出，润透后抽去心，再洗净晒干。朱麦冬：取去心麦冬，置盆内喷水少许，微润，加朱砂细粉，撒布均匀，并随时翻动，至麦冬外面匀被朱砂为度，职出，晾干。（每麦门冬10斤，用朱砂3两）"}]},{"ID":"20240607100852-72p23gl","Type":"NodeParagraph","Properties":{"id":"20240607100852-72p23gl","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"（麦门冬）以肥大者为好，用之汤泽，抽去心，不尔，令人烦。\""}]},{"ID":"20240607100852-15fjl7g","Type":"NodeParagraph","Properties":{"id":"20240607100852-15fjl7g","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"麦门冬，凡入汤液，以滚水润湿，少顷，抽去心，或以瓦焙软，乘热去心；若入丸散，须瓦焙热，即于风中吹冷，如此三、四次即易燥，且不损药力，或以汤浸捣膏和药亦可，滋补药以酒浸擂之。\""}]},{"ID":"20240607100852-l3ryasf","Type":"NodeParagraph","Properties":{"id":"20240607100852-l3ryasf","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607100852-lk0zlz1","Type":"NodeParagraph","Properties":{"id":"20240607100852-lk0zlz1","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 入肺、胃、心经。"}]},{"ID":"20240607100852-cfhmfnf","Type":"NodeParagraph","Properties":{"id":"20240607100852-cfhmfnf","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴经。\""}]},{"ID":"20240607100852-wsjphfw","Type":"NodeParagraph","Properties":{"id":"20240607100852-wsjphfw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"入手太阴、少阴。\""}]},{"ID":"20240607100852-h4egx3k","Type":"NodeParagraph","Properties":{"id":"20240607100852-h4egx3k","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足阳明，兼入手少阴、太阴。\""}]},{"ID":"20240607100852-afd716k","Type":"NodeParagraph","Properties":{"id":"20240607100852-afd716k","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607100852-444lckp","Type":"NodeParagraph","Properties":{"id":"20240607100852-444lckp","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 甘微苦，寒。"}]},{"ID":"20240607100852-v2kc13a","Type":"NodeParagraph","Properties":{"id":"20240607100852-v2kc13a","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240607100852-wrgoa78","Type":"NodeParagraph","Properties":{"id":"20240607100852-wrgoa78","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"微寒，无毒。\""}]},{"ID":"20240607100852-foch395","Type":"NodeParagraph","Properties":{"id":"20240607100852-foch395","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"气寒，味微苦。\""}]},{"ID":"20240607100852-m5ibo2w","Type":"NodeParagraph","Properties":{"id":"20240607100852-m5ibo2w","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"④《医林纂要》：\"甘淡微苦，微寒。\""}]},{"ID":"20240607100852-28n5pj9","Type":"NodeParagraph","Properties":{"id":"20240607100852-28n5pj9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607100852-udjen1c","Type":"NodeParagraph","Properties":{"id":"20240607100852-udjen1c","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 凡脾胃虚寒泄泻，胃有痰饮湿浊及暴感风寒咳嗽者均忌服。"}]},{"ID":"20240607100852-d42x0g5","Type":"NodeParagraph","Properties":{"id":"20240607100852-d42x0g5","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"地黄、车前为之使。恶款冬、苦瓠。畏苦参、青囊。\""}]},{"ID":"20240607100852-4x0xi44","Type":"NodeParagraph","Properties":{"id":"20240607100852-4x0xi44","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"恶苦芺。畏木耳。\""}]},{"ID":"20240607100852-drt8ujc","Type":"NodeParagraph","Properties":{"id":"20240607100852-drt8ujc","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"气弱胃寒者必不可饵。\""}]},{"ID":"20240607100852-7yxf3yc","Type":"NodeParagraph","Properties":{"id":"20240607100852-7yxf3yc","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607100852-v4hx9ug","Type":"NodeParagraph","Properties":{"id":"20240607100852-v4hx9ug","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 养阴润肺，清心除烦，益胃生津。治肺燥干咳，吐血，咯血，肺痿，肺痈，虚劳烦热，消渴，热病津伤，咽干口燥，便秘。"}]},{"ID":"20240607100852-yp48ipp","Type":"NodeParagraph","Properties":{"id":"20240607100852-yp48ipp","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气。\""}]},{"ID":"20240607100852-r681xur","Type":"NodeParagraph","Properties":{"id":"20240607100852-r681xur","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗身重目黄，心下支满，虚劳客热，口干燥渴，止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健。\""}]},{"ID":"20240607100852-xr3uhqs","Type":"NodeParagraph","Properties":{"id":"20240607100852-xr3uhqs","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治热毒，止烦渴，主大水面目肢节浮肿，下水。治肺痿吐脓，主泄精。\""}]},{"ID":"20240607100852-kpm2fwu","Type":"NodeParagraph","Properties":{"id":"20240607100852-kpm2fwu","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"治寒热体劳，下痰饮。\""}]},{"ID":"20240607100852-x2hlavy","Type":"NodeParagraph","Properties":{"id":"20240607100852-x2hlavy","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"治五劳七伤，安魂定魄，时疾热狂，头痛，止嗽。\""}]},{"ID":"20240607100852-0iy0tqz","Type":"NodeParagraph","Properties":{"id":"20240607100852-0iy0tqz","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑥《本草衍义》：\"治心肺虚热。\""}]},{"ID":"20240607100852-w2y7pvw","Type":"NodeParagraph","Properties":{"id":"20240607100852-w2y7pvw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑦《珍珠囊》：\"治肺中伏火，生脉保神。\""}]},{"ID":"20240607100852-0kl2nx9","Type":"NodeParagraph","Properties":{"id":"20240607100852-0kl2nx9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑧《医学启源》：\"《主治秘诀》云，治经枯乳汁不下。\""}]},{"ID":"20240607100852-aieg4at","Type":"NodeParagraph","Properties":{"id":"20240607100852-aieg4at","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑨《用药心法》：\"补心气不足及治血妄行。\""}]},{"ID":"20240607100852-kmakli5","Type":"NodeParagraph","Properties":{"id":"20240607100852-kmakli5","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑩《南京民间药草））：\"治妇女湿淋。\""}]},{"ID":"20240607100852-0yry5nh","Type":"NodeParagraph","Properties":{"id":"20240607100852-0yry5nh","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑾《福建民间草药》：\"能清心益肝，利尿解热，治小便淋闭，小儿肝热。\""}]},{"ID":"20240607100852-g19l8g7","Type":"NodeParagraph","Properties":{"id":"20240607100852-g19l8g7","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑿《安徽药材》：\"治咽喉肿痛。\""}]},{"ID":"20240607100852-4ce4o6b","Type":"NodeParagraph","Properties":{"id":"20240607100852-4ce4o6b","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607100852-iyqcl4i","Type":"NodeParagraph","Properties":{"id":"20240607100852-iyqcl4i","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；或入丸，散。"}]},{"ID":"20240607100852-0richfj","Type":"NodeParagraph","Properties":{"id":"20240607100852-0richfj","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607100852-9pn01pw","Type":"NodeParagraph","Properties":{"id":"20240607100852-9pn01pw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" ①治燥伤肺胃阴分，或热或咳者：沙参三钱，麦冬三钱，玉竹二钱，生甘草一钱，冬桑叶一钱五分，扁豆一钱五分，花粉一钱五分。水五杯，煮取二杯，日再服。（《温病条辨》沙参麦冬汤）"}]},{"ID":"20240607100852-taap0l4","Type":"NodeParagraph","Properties":{"id":"20240607100852-taap0l4","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②治吐血，衄血不止：生麦门冬汁五合，生刺蓟汁五合，生地黄汁五合。相和，于锅中略暖过，每服一小盏，调伏龙肝末一钱服之。（《圣惠方》麦门冬饮子）"}]},{"ID":"20240607100852-6hwjoj2","Type":"NodeParagraph","Properties":{"id":"20240607100852-6hwjoj2","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③治衄血不止：麦门冬、生地黄，每服一两，水煎。（《济生方》麦门冬饮）"}]},{"ID":"20240607100852-62q5ap8","Type":"NodeParagraph","Properties":{"id":"20240607100852-62q5ap8","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"④治齿缝出血成条：人参八分，茯苓、麦冬各一钱。水煎温服。（苏轼麦门冬汤）"}]},{"ID":"20240607100852-ws0agty","Type":"NodeParagraph","Properties":{"id":"20240607100852-ws0agty","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑤治骨蒸肺痿，四肢烦热，不能食，口干渴：麦门冬（去心，焙）、地骨皮各五两。上二味粗捣筛，每服五钱匕。先以水二盏，煎小麦一合，至一盏半，去麦入药，煎至一盏，去滓，分温二服，空腹食后各一。（《圣济总录》麦门冬汤）"}]},{"ID":"20240607100852-ssu594l","Type":"NodeParagraph","Properties":{"id":"20240607100852-ssu594l","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑥治肺痈涕唾涎沫，吐脓如粥：麦门冬（去心，焙）二两，桔梗（去芦头）五两，甘草（炙，锉）三分。上三味粗捣筛，每服三钱匕，水一盏，青蒿心叶十片，同煎至七分，去滓温服。稍轻者粥饮调下亦得。（《圣济总录》麦门冬汤）"}]},{"ID":"20240607100852-kdtrkm9","Type":"NodeParagraph","Properties":{"id":"20240607100852-kdtrkm9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑦治火逆上气，咽喉不利：麦门冬七升，半夏一升，人参二两，甘草二两，粳米三合，大枣十二枚。上六味，以水一斗二升，煮取六升，温服一升，日三夜一服。（《金匮要略》麦门冬汤）"}]},{"ID":"20240607100852-zssehag","Type":"NodeParagraph","Properties":{"id":"20240607100852-zssehag","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑧治虚热上攻，脾肺有热，咽喉生疮：麦门冬一两，黄连五钱。上为末，蜜丸如梧桐子大。每服三十丸，食前麦门冬汤下。（《普济方》麦门冬丸）"}]},{"ID":"20240607100852-kjoo32u","Type":"NodeParagraph","Properties":{"id":"20240607100852-kjoo32u","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑨治患热消渴：黄连一升（去毛），麦门冬五两（去心）。上二味，捣筛，以生地黄汁、栝楼根汁。牛乳各三合和，顿为丸如梧子，一服二十五丸，饮下，日再服，渐渐加至三十丸。（《外台秘要方》）"}]},{"ID":"20240607100852-jqae5cl","Type":"NodeParagraph","Properties":{"id":"20240607100852-jqae5cl","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑩治消渴，喉干不可忍，饮水不止，腹满急胀：麦门冬（去心，焙），乌梅（去核取肉，炒）各二两。上二味粗捣筛，每服三钱匕，水一叠，煎至半盏，去滓，食后温服，日三。（《圣济总录》麦门冬汤）"}]},{"ID":"20240607100852-m539y2l","Type":"NodeParagraph","Properties":{"id":"20240607100852-m539y2l","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑾治阳明温病，无上焦症，数日大便不通，当下之，若其人阴素虚，不可行承气者：元参一两，麦冬八钱，生地八钱。水八杯，煮取三杯，口干则与饮令尽，不便，再作服。（《温病条辨》增液汤）"}]},{"ID":"20240607100852-35xcwhr","Type":"NodeParagraph","Properties":{"id":"20240607100852-35xcwhr","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⑿治疟伤胃阴，不饥，不饱，不便，潮热，得食则烦热愈加，津液不复者：麦冬五钱（连心），火麻仁四钱，生白芍四钱，何首乌三钱，乌梅肉二钱，知母二钱。水八杯，煮取三杯，分三次温服。（《温病条辨》麦冬麻仁汤）"}]},{"ID":"20240607100852-qusvke6","Type":"NodeParagraph","Properties":{"id":"20240607100852-qusvke6","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⒀治燥伤胃阴：玉竹三钱，麦冬三钱，沙参二钱，生甘草一钱，水五杯，煮取二杯，分二次服。（《温病条辫》玉竹麦门冬汤）"}]},{"ID":"20240607100852-6xkxsha","Type":"NodeParagraph","Properties":{"id":"20240607100852-6xkxsha","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"⒁治热伤元气，肢体倦怠，气短懒言，口干作渴，汗出不止，脚欹眼黑，津枯液涸：人参五钱，麦门冬（去心）三钱，五味子二钱（碎）。水煎，不拘时温服。（《千金方》生脉散）"}]},{"ID":"20240607100852-07w0vfe","Type":"NodeParagraph","Properties":{"id":"20240607100852-07w0vfe","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607100852-rssqknl","Type":"NodeParagraph","Properties":{"id":"20240607100852-rssqknl","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 此外，西藏所用的麦冬，为百合科植物蜈蚣七的块根。"}]},{"ID":"20240607100852-jeyd3cv","Type":"NodeParagraph","Properties":{"id":"20240607100852-jeyd3cv","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"各地作土麦冬使用的，尚有以下几种麦冬属植物的块根。"}]},{"ID":"20240607100852-tylzyja","Type":"NodeParagraph","Properties":{"id":"20240607100852-tylzyja","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"①大叶麦冬，植物体较高大；叶长15～30厘米，宽3～7毫米；花较稀，花被6片，花丝略与花药等长，花药钝头，子房上位。分布华北、华中、华东及南方各地。"}]},{"ID":"20240607100852-fwfm024","Type":"NodeParagraph","Properties":{"id":"20240607100852-fwfm024","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"②阔叶麦冬，形态与上种相似，叶宽7～13毫米，花较密。分布华东、华中。"}]},{"ID":"20240607100852-klri124","Type":"NodeParagraph","Properties":{"id":"20240607100852-klri124","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"③小麦冬，植物体较小，高12～25厘米，叶宽2～3毫米。分布江苏、浙江。"}]},{"ID":"20240607100852-xduliqw","Type":"NodeParagraph","Properties":{"id":"20240607100852-xduliqw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"④甘肃麦冬，叶宽1.5毫米；花1～2成一簇，花丝长约为花药的二倍。分布甘肃。"}]},{"ID":"20240607100852-n6sokm7","Type":"NodeParagraph","Properties":{"id":"20240607100852-n6sokm7","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607100852-bicdhsh","Type":"NodeParagraph","Properties":{"id":"20240607100852-bicdhsh","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607100852-ieucw5l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607100852-ieucw5l","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"《中华本草》：麦门冬"}]},{"ID":"20240607100852-vmbb64z","Type":"NodeParagraph","Properties":{"id":"20240607100852-vmbb64z","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607100852-sw1cmh6","Type":"NodeParagraph","Properties":{"id":"20240607100852-sw1cmh6","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" Mài Mén Dōnɡ"}]},{"ID":"20240607100852-bv102yw","Type":"NodeParagraph","Properties":{"id":"20240607100852-bv102yw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607100852-mkx0hpa","Type":"NodeParagraph","Properties":{"id":"20240607100852-mkx0hpa","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 虋冬、不死药、禹余粮"}]},{"ID":"20240607100852-8isv7iq","Type":"NodeParagraph","Properties":{"id":"20240607100852-8isv7iq","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607100852-6mbtubq","Type":"NodeParagraph","Properties":{"id":"20240607100852-6mbtubq","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" Dwarf Lilyturf Tuber"}]},{"ID":"20240607100852-pbiktuw","Type":"NodeParagraph","Properties":{"id":"20240607100852-pbiktuw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607100852-w5skd0o","Type":"NodeParagraph","Properties":{"id":"20240607100852-w5skd0o","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607100852-wv6wqpm","Type":"NodeParagraph","Properties":{"id":"20240607100852-wv6wqpm","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"1.《吴普本草》：麦门冬，生山谷肥地，叶如韭，肥泽丛主，采无时。实青黄。"}]},{"ID":"20240607100852-hfcji0f","Type":"NodeParagraph","Properties":{"id":"20240607100852-hfcji0f","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：麦门冬，叶如韭，冬夏长生，生函谷川谷及堤坂肥土石间久废处。二月、三月、八月、十月采，阴干。"}]},{"ID":"20240607100852-04vd7gw","Type":"NodeParagraph","Properties":{"id":"20240607100852-04vd7gw","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：函谷即秦关，而麦门冬异于羊韭之名矣，处处有，以四月采。冬月作实如青珠，根似穬麦，故谓麦门冬，以肥大者为好。"}]},{"ID":"20240607100852-0ew1uve","Type":"NodeParagraph","Properties":{"id":"20240607100852-0ew1uve","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"4.《本草拾遗》：麦门冬，出江宁，小润；出新安，大"}]},{"ID":"20240607100852-g9wa07w","Type":"NodeParagraph","Properties":{"id":"20240607100852-g9wa07w","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607100852-31edpiv","Type":"NodeParagraph","Properties":{"id":"20240607100852-31edpiv","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物麦冬或沿阶草的块根。"}]},{"ID":"20240607100852-rirdth4","Type":"NodeParagraph","Properties":{"id":"20240607100852-rirdth4","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Ophiopogon japonicus（L.f.）Ker-Gawl. 2.Ophiopogon bodinieri Levl."}]},{"ID":"20240607100852-gt7j2js","Type":"NodeParagraph","Properties":{"id":"20240607100852-gt7j2js","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"采收和储藏：四川在栽后第2年4月下旬收获，浙江在第3年或第4年收获。选晴天挖取麦冬，抖去泥土，切下块根和须根，洗净泥土，晒干水气后，揉搓，再晒，再搓，反复4-5次，直到去尽须根后，干燥即得。浙江是将洗净的块根晒3-5d，放在萝筐内闷放2-3d，再翻晒3-5d，剪去须根，晒干或鲜用。"}]},{"ID":"20240607100852-w30h2bb","Type":"NodeParagraph","Properties":{"id":"20240607100852-w30h2bb","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607100852-fldel1v","Type":"NodeParagraph","Properties":{"id":"20240607100852-fldel1v","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔2000m以下的山坡阴湿处、林下或溪旁，或栽培。 2.生于海拔600-3400m的山坡、山谷潮湿处、沟边或林下。"}]},{"ID":"20240607100852-nrn5zlx","Type":"NodeParagraph","Properties":{"id":"20240607100852-nrn5zlx","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于华东、中南及河北、陕西、四川、贵州、云南等地。浙江、四川、广西有大量栽培。 2.分布于西南及陕西、甘肃、江苏、江西、河南、湖北、广西等地。"}]},{"ID":"20240607100852-svna6ix","Type":"NodeParagraph","Properties":{"id":"20240607100852-svna6ix","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607100852-hdodhxl","Type":"NodeParagraph","Properties":{"id":"20240607100852-hdodhxl","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 麦冬 多年生草本，高12-40cm，须根中部或先端常膨大形成肉质小块根。叶从生；叶柄鞘状，边缘有薄膜；叶片窄长线形，基部有多数纤维状的老叶残基，叶长15-40cm，宽1.5-4mm，先端急尖或渐尖，基部绿白色并稍扩大。花葶较叶为短，长7-15cm，总状花序穗状，顶生，长3-8cm，小苞片膜质，每苞片腋生1-3朵花；花梗长3-4mm，关节位于中倍以上或近中部；花小，淡紫色，略下垂，花被片6，不展开，披针形，长约5mm，雄蕊6，花药三角状披针形；子房半下位，3室，花柱长约4mm，基部宽阔，略呈圆锥形。浆果球形，直径5-7mm，早期绿色，成熟后暗蓝色。花期5-8月，果期7-9月。 2.沿阶草 形态与上种相似，主要区别为：花葶通常稍短于中或近等长；花被片在花盛开时多少展开；花柱细长，圆柱形，基部不宽阔。"}]},{"ID":"20240607100852-c106dgq","Type":"NodeParagraph","Properties":{"id":"20240607100852-c106dgq","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607100852-mrca29t","Type":"NodeParagraph","Properties":{"id":"20240607100852-mrca29t","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，喜荫蔽的环境，耐寒，怕高温，苗期要求阴湿条件，可与其他作物间作或给以适当遮荫。以选疏松、肥沃、湿润、排水良好的中性或微碱性的壤土或砂质壤土栽培为宜，过砂过粘或酸性土壤中生长不良。忌连作。 栽培技术 用小丛分株繁殖。选健壮、无病虫且未抽嫩叶的植株作种苗，4月初采挖，麦冬起土后，敲去泥土，剪下块根和须根，并切去部分老根茎，苗长1cm以下的茎基，以断面呈白色，叶片不散开为度，同时将叶片剪去1/3左右，再分成单株。种植前种苗用清水浸10-15min，使吸足水分，以利生根。边浸种边种植，如不能及时下种时，可选阴凉处假植。栽种时间4月下旬-5月上旬，浙江2年生收获的，行株距26cm×16cm，每穴栽苗8-10株，3年生收获的，行株距（26-32）cm×（20-25）cm。由于麦冬需要阴湿的环境，四川药农在夏、秋季间种玉米，借此可以减少日光对麦门冬的强烈直射，并可增加收入。 田间管理 在整个生长期间，应经常注意浇水。除了施足基肥外，还必须施用足量追肥。追肥以腐熟人粪尿、磷肥、钾肥为主，时间一般在4-6月和8-9月，施肥量可根据当地情况酌情施用。 病虫害防治 病害有黑斑病，为害叶片，防治方法可选用健壮种苗，并在栽种前用1：1：100波尔多液或65%代森锌500倍液浸苗5min。发病期，喷1：1：100波尔多液，每10-14d喷1次，连喷3-4次。虫害有蛴螬为害根部，用90%晶体敌百虫200倍液喷杀，或与水稻轮作，淹水一季，可完全杀死。"}]},{"ID":"20240607100852-pi1oqh0","Type":"NodeParagraph","Properties":{"id":"20240607100852-pi1oqh0","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607100852-qwehpmt","Type":"NodeParagraph","Properties":{"id":"20240607100852-qwehpmt","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）麦冬 （浙麦冬） 块根纺锤形，长1.5-3.5cm，中部直径3-7mm。表面土黄色或黄白色，有较深的不规则细纵纹，有时一端有细小中柱外露。质韧，断面类白色，中央有细小圆形中柱，新鲜时可抽出。气微香，味微甘、涩，嚼之微有粘性。 川麦冬 块根较短小，表面乳白色。质较坚硬，香气小，味淡，少粘性。 （2）沿介草 块根纺锤形，长0.8-2cm，中部直径2-4mm。表面有细纵纹。断面黄白色，中柱细小。味淡。 以肥大、淡黄白色、半透明、质柔、嚼之有粘性者为佳。 显微鉴别 块根黄切面：（1）麦冬 表皮细胞长方形或多角形，有的细胞分化成根毛状；根被2-5列细胞，类方形、类长方形或多角形，有的具纵长纹孔。皮层宽广，外皮层细胞外壁及侧壁微木化，有的分泌细胞含黄色油状物；含草酸钙针晶束的粘液细胞类圆形，含草酸钙柱晶束的粘液细胞显着小于一般细胞；内皮层外侧为1-2列石细胞，长多角形或类多角形，内壁及侧壁增厚；内皮层细胞类方形或类长方形，壁全面增厚，木化，通道细胞壁薄，非木化。中柱约占1/5-1/8；中柱鞘1-2列细胞；韧皮部束15-24个，与木质部交替排列；木质部内侧由木化细胞相连接。髓部细胞非木化。 （2）沿阶草 表皮细胞1列，扁平。皮层中含针晶束细胞，偶见含柱晶束细胞，柱晶长50-60μm；石细胞1-2列，内壁及侧壁增厚，如为2列石细胞，其内列细胞壁全面增厚。中柱占1/8-1/12；韧皮部束5-10个；髓部细胞壁木化。 粉末特征：（1）麦冬 黄白色。①外皮层细胞表面观类方形或类长方形，长44-185μm，宽37-135μm，壁厚3-5μm，其间散有分泌细胞；分泌细胞类圆形或长圆形，长66-125μm，直径37-73μm，壁稍厚，有的含淡黄色分泌物。②草酸钙针晶散在或成束存在于粘液细胞中，针晶长21-78μm，直径约至3μm；另有柱状外地晶，长51-118μm，直径5-9μm，两端斜尖，易断碎。③石细胞常与内皮层细胞上下层相叠。表面观类方形或类多角形，长32-196μm，直径22-94μm，壁厚4-16μm，有的一边菲薄，纹孔密，短缝状或扁圆形，孔沟较粗。④内皮层细胞表面观长方形或长条形，直径22-49μm，长54-250μm，壁厚4-7μm，纹孔较密，孔沟短。⑤木纤维细长，末端倾斜，直径14-36μm，壁稍厚，微木化，纹孔斜裂缝状或相交十字形、人字形。此外，有网纹管胞。 （2）沿阶草 黄色。外皮层细胞类长方形，长66-151μm，宽33-115μm，壁厚1.5-2.5μm；草酸钙针晶长36-73μm，直径1.5-3μm，柱状针晶直径约5μm；石细胞长62-180μm，直径25-52μm，壁厚4-9μm。"}]},{"ID":"20240607100852-k22nqo1","Type":"NodeParagraph","Properties":{"id":"20240607100852-k22nqo1","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607100852-rqs4ouo","Type":"NodeParagraph","Properties":{"id":"20240607100852-rqs4ouo","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 亚慢性毒性试验表明，大、小鼠90天喂养麦冬试验表明，动物检查无异常发现，外周血象正常。肝功能、肾功能测定与对照组比较无显着差异，病理检查亦未见异常。Ames试验为阴性。小鼠腹腔注射麦冬后的LD50为134.34±12.59（95%可信限）。"}]},{"ID":"20240607100852-kocxnsy","Type":"NodeParagraph","Properties":{"id":"20240607100852-kocxnsy","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607100852-26tjj8m","Type":"NodeParagraph","Properties":{"id":"20240607100852-26tjj8m","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 麦冬块根含多种糖甙：甙元为罗斯考皂甙元（ruscogenin）的有麦冬皂甙（ophiopogonin）B、D；甙元为（22S，24S，25S）-23-24-二羟基罗斯考皂甙元[（23S，24S，25S）-23，24-dihydroxyruscogenin]的有（23S，24S，25S）-23，24-二羟基罗斯考皂甙元-1-O-[α-L-吡喃鼠李糖基（1→2）][β-D-吡喃木糖基（1→3）]-α-L-吡喃阿拉伯糖甙-24-O-β-D-吡喃岩藻糖甙"}]},{"ID":"20240607100852-mxoxh7n","Type":"NodeParagraph","Properties":{"id":"20240607100852-mxoxh7n","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607100852-ow885zc","Type":"NodeParagraph","Properties":{"id":"20240607100852-ow885zc","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 1.对中枢神经系统的影响：麦冬总氨基酸0.5ml／10g腹腔注射给于小鼠30分钟后，腹腔注射戊巴比妥钠30mg／kg，观察翻正反射消失动物数。结果麦冬总氨基酸有明显的协同中枢抑制药作用（P＜0.05），而麦冬总皂甙及总糖对阈下催眠剂量的戊巴比妥钠作用无明显影响。15%麦冬须制剂10ml／kg灌胃能抑制注射松节油2.0ml／kg的家兔的发热（P＜0.01），但发热后用药则无抑制作用。麦冬煎剂有镇静作用，亦能加强氯丙嗪的镇静作用，增强戊巴比妥钠的催眠作用，拮抗咖啡因的兴奋作用，能推迟回苏灵引起的抽搐，强直性惊厥及死亡发生的时间，但不能使动物免于死亡。"}]},{"ID":"20240607100852-qkqiuf0","Type":"NodeParagraph","Properties":{"id":"20240607100852-qkqiuf0","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.对心血管系统的影响：。"}]},{"ID":"20240607100852-gb6sjl9","Type":"NodeParagraph","Properties":{"id":"20240607100852-gb6sjl9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.1.对离体蜍蟾心脏心功能的影响：用八木-Hartung法离体蟾蜍心脏灌流证明；麦冬总皂甙I（粗提物）加强心肌收缩力作用最强，而总皂甙Ⅱ（较纯物）作用不及总皂甙Ⅰ，一般在心肌收缩力增强的同时伴有心输出量的增加。大剂量的总皂甙Ⅰ、Ⅱ及总糖对心脏均产生抑制，可使心肌收缩力减弱、心输出量减少，房室传导阻滞、甚至停傅。总皂甙Ⅰ、Ⅱ、总糖、总氨基酸对心率一般稍减慢或不变，均无明显影响。"}]},{"ID":"20240607100852-4sm8mqe","Type":"NodeParagraph","Properties":{"id":"20240607100852-4sm8mqe","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.2.对离体豚鼠心脏心肌收缩振幅的影响：用Langendorff法豚鼠离体心脏灌流表明，麦冬总皂甙及总氨基酸小剂量均可使心肌收缩力增强，冠脉流量增加，大剂量则抑制心肌，减少冠脉流量，但两者对心率无影响。"}]},{"ID":"20240607100852-48ucbj9","Type":"NodeParagraph","Properties":{"id":"20240607100852-48ucbj9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.3.抗心律失常作用及其电生理特性：麦冬总皂甙10mg／kg静脉注射可有效地预防或对抗由CHCL3-Adr，BaCl2，Aco所诱发的心律失常，并使结扎犬冠状动脉24h后的室性心律失常发生率由87±8降至57±7%。电生理实验表明麦冬总皂甙15mg／kg可明显降低兔单相动作电位的Vmax，缩短其APD10，APD50；麦冬总皂甙50μg/ml也可使豚鼠乳头状肌细胞跨膜动作电位的APA，Vmax明显降低，APD10，APD50明显缩短；同时ERP／APD显着增大。麦冬对氯化钡、乌头碱，肾上腺素、垂体后叶素等所致的心律失常均有改善作用。用硫酸镁2.5g，麦冬20g稀释于500ml葡萄糖生理盐水内静脉滴注治疗实验性狗心肌梗塞，用药6h，24h早搏出现次数与对照组相比，结果表明麦冬合同小剂量硫酸镁对心梗后心律失常有一定预防作用。"}]},{"ID":"20240607100852-hbmx8lr","Type":"NodeParagraph","Properties":{"id":"20240607100852-hbmx8lr","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.4.对实验性心肌梗塞时环核苷酸代谢的影响：用新西兰兔麻醉后结扎冠脉前降支，造成急性实验性心肌梗塞，经耳静脉注射麦冬注射液15ml（相当生药15g）。然后与对照组一起在术后即刻、术后15、30、60分钟，直接心脏穿刺采血，测定血浆cAMP和cGMP。结果术后15分钟，对照组cAMP、cGMP继续升高，麦冬组呈下降趋势（P＜0.05），术后30分钟麦冬组仍低于对照组（P＜0.02），术后60分钟恢复至术前水平。血浆cAMP／cGMP比值变化：术前两组无显着性差异，术后即刻两组比值均下降；对照组在术后15、30分钟，继续下降分别为4.6±1.61；4.57±2.01；而麦冬组已接近术前水平，分别为6.46±2.12和6.48±2.39（P值均＜0.05），术后60分钟，麦冬组仍维持术前水平，对照组有上升趋势，两组无显着差异。急性心肌梗塞后血浆cAMP、cGMP含量明显高于正常。可能是一种应激反应，由于大量心肌细胞坏死溶解，释放出cAMP和cGMP，使血浆中水平增高，反应心肌损伤的程度。由于心肌缺血时，cGMP增高较cAMP更明显，所以心梗后cAMP／cGMP比值明显下降。麦冬可能使梗塞后心肌营养血流量增加，缺血缺氧的心肌细胞较快获得修复与保护，致使心肌cGMP和cAMP的释放减少，从而降低血浆中的含量，而使两者比值恢复平衡。"}]},{"ID":"20240607100852-hyvzz8f","Type":"NodeParagraph","Properties":{"id":"20240607100852-hyvzz8f","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.对动物免疫活性的影响：。"}]},{"ID":"20240607100852-1l3niey","Type":"NodeParagraph","Properties":{"id":"20240607100852-1l3niey","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.1.对小鼠常压耐缺氧能力的影响：取18-20g，ICR小鼠30只，分别腹腔注射麦冬多糖、人参总皂甙（20mg／kg），对照用等量生理盐水，30分钟后置盛有钠石灰的密闭广口瓶中，记录小鼠死亡时间。结果麦冬多糖组的小鼠存活时间与对照组比较极显着延长（P＜0.01)。"}]},{"ID":"20240607100852-otvavrg","Type":"NodeParagraph","Properties":{"id":"20240607100852-otvavrg","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.2.对免疫器官重量的影响：取ICR小鼠分别腹腔注射麦冬多糖、人参总皂甙（剂量10mg／kg），对照用等量生理盐水，连续给药7天后放血处死动物，称体重及胸腺、脾脏重量，计算胸腺指数和脾指数。结果麦冬多糖可极显着增加小鼠的脾脏重量（P＜0.01)，而对胸腺无明显影响。"}]},{"ID":"20240607100852-ea5r2xv","Type":"NodeParagraph","Properties":{"id":"20240607100852-ea5r2xv","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.3.对小鼠碳粒廓清作用的影响：取ICR小鼠，分别腹腔注射麦冬多糖、人参总皂甙（10mg／kg）和生理盐水，连续给药7天，末次给药后尾静脉给于稀释3倍的中华碳素墨水0.1ml／10g，分别计算廓清指数。结果麦冬多糖组可显着增强小鼠的碳粒廓清作用（P＜0.01＝。"}]},{"ID":"20240607100852-gyw5pp4","Type":"NodeParagraph","Properties":{"id":"20240607100852-gyw5pp4","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.4.对由环磷酰胺和60Cor照射引起的小鼠白细胞数下降的影响：麦冬多糖10mg／kg对小鼠腹腔注射0.4ml环磷酰胺（5mg／ml）所致的白细胞下降有极显着的对抗作用（P＜0.01)。同样剂量的麦冬多糖连续腹腔注射8天，第8天给药后lh将小鼠放置在距照射源（60Cor）60cm处进行照射，总剂量20.64c／kg，照射后继续给药3天，照射后第7天，眼眶取血，计算白血球数。结果麦冬多糖可显着对抗由60Cor射线照射引起的白血球下降（P＜0.01＝。"}]},{"ID":"20240607100852-prxaiz0","Type":"NodeParagraph","Properties":{"id":"20240607100852-prxaiz0","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.5.麦冬多糖对小鼠血清中溶血素的形成有明显促进作用，对家兔血红细胞具有凝集素样作用。"}]},{"ID":"20240607100852-c4r7jsk","Type":"NodeParagraph","Properties":{"id":"20240607100852-c4r7jsk","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.6.麦冬水煎液腹腔注射小鼠，剂量相当12.5g生药／kg，能极显着增加小鼠脾脏重量；增强小鼠碳粒廓清作用；极显着对抗由环磷酰胺引起的白细胞下降等作用。"}]},{"ID":"20240607100852-gmyi2sd","Type":"NodeParagraph","Properties":{"id":"20240607100852-gmyi2sd","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.7.对体液免疫和细胞免疫的影响：用BALB／C幼鼠，配对成试验组和对照组，饲养1月后，每鼠注射绵羊细胞（SRBC）4.O亿个（0.2ml），注射后定期取血，测定抗体，计算HC50。结果表明用麦冬须有促进抗体生成和延缓抗体消退（P＜0.05）。用配对的两组BALB／C小鼠脾细胞悬液，2份加PHA60μg/ml，1份不加致裂原。培养72h后，用3H胸腺嘧啶核苷掺入后在闪烁仪上测定淋巴细胞转化刺激指数，结果表明，麦冬须根提取物有提高细胞免疫作用。"}]},{"ID":"20240607100852-cp0opv8","Type":"NodeParagraph","Properties":{"id":"20240607100852-cp0opv8","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.8.对带瘤小鼠免疫功能的影响：麦冬须水溶液对NIH纯系接种S180和EAC癌细胞的白细胞和T细胞均有明显的提高（P＜0.01或P＜0.05)。对T细胞亚群可使Tu%含量增高，Tr%含量下降，Tu／Tr值均比对照组高。"}]},{"ID":"20240607100852-9p3uc80","Type":"NodeParagraph","Properties":{"id":"20240607100852-9p3uc80","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"4.其它作用：小鼠在饲料中添加麦冬根须可降低体内羟脯氨酸。对雄性小鼠脑中单胺氧化酶（MAO-B）抑制率为38.6%。雄性小鼠肝中SOD活性提高45.5%。果蝇寿命试验还表明麦冬根须饲料有明显的延长果蝇寿命，提示有延缓衰老趋势。游泳试验表明麦冬所含皂甙、多糖、氨基酸等有明显抗疲劳作用。"}]},{"ID":"20240607100852-jrlow1y","Type":"NodeParagraph","Properties":{"id":"20240607100852-jrlow1y","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607100852-3jmwcui","Type":"NodeParagraph","Properties":{"id":"20240607100852-3jmwcui","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 1.麦冬：拣净杂质，用水浸泡，捞出，润透后抽去心，再洗净晒干。"}]},{"ID":"20240607100852-rd0edxs","Type":"NodeParagraph","Properties":{"id":"20240607100852-rd0edxs","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.取去心麦冬，置盆内喷水少许，微润，加朱砂细粉，撒布均匀，并随时翻动，至麦冬外面匀被朱砂为度，取出，晾干。（每麦门冬10斤，用朱砂3两）。"}]},{"ID":"20240607100852-eciyo4e","Type":"NodeParagraph","Properties":{"id":"20240607100852-eciyo4e","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607100852-ufkysm9","Type":"NodeParagraph","Properties":{"id":"20240607100852-ufkysm9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品的薄片置紫外光灯（365nm）下观察，显浅蓝色荧光。 （2）取本品粉末1g，加70%乙醇20ml，浸渍4h，滤过。滤液挥去乙醇，加3%硫酸适量，水解3-4h，冷后调至中性，蒸干，加0.5ml氯仿溶解作样品溶液；另取β-谷甾醇和假叶树皂甙元加氯仿溶解，作对照品溶液。分别点样于同一硅胶G薄层板上，以正已烷-乙酸乙酯（1：1）展开，取出晾干，喷以10%硫酸乙醇试液于90度显色，假叶树皂甙元显深绿色，β-谷甾醇显紫红色斑点。样品溶液色谱在与对照品溶液色谱的相应位置上，显相同颜色的斑点。 品质标志 《中华人民共和国药典》1995年版规定：本品采用冷浸法测定，水浸出物不得少于60.0%。含水分不得过18.0%。 商品规格 商品分浙麦冬和川麦冬。（1）浙麦冬 纺锤形，半透明，表面黄白色；质柔韧，断面牙白色，有木质心。味微甜，嚼之有粘性。一等：每50g150只以内，无须根。二等：每50g280只以内，余同一等。三等：每50g280只以外，最小不低于麦粒大，无须根，油粒、烂头不超过10%。 （2）川麦冬 纺锤形，半透明，表面淡白色；断面牙白色，木质心细软。味微甜，嚼之少粘性。一等：每50g190粒以内，无须根。二等：每50g300粒以内，余同一等。三等：每50g300粒以外，最小不低于麦粒大，间有乌花、油粒不超过10%，余同一等。 出口商品按浙江省的标准分为四等。一等：色黄亮，颗粒均匀，肥壮，长2.54cm以上。二等：颗粒较小，长约2.54cm。三等：色较着，颗粒大小不匀而瘦，长2.54cm以下。四等：色差粒瘦，长短不一，多在2.54cm以下。"}]},{"ID":"20240607100852-922cku5","Type":"NodeParagraph","Properties":{"id":"20240607100852-922cku5","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607100852-rcvyeo3","Type":"NodeParagraph","Properties":{"id":"20240607100852-rcvyeo3","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 肺；胃；心经"}]},{"ID":"20240607100852-woruyjc","Type":"NodeParagraph","Properties":{"id":"20240607100852-woruyjc","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607100852-5q34pp3","Type":"NodeParagraph","Properties":{"id":"20240607100852-5q34pp3","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 甘；微苦；寒"}]},{"ID":"20240607100852-8ce52c0","Type":"NodeParagraph","Properties":{"id":"20240607100852-8ce52c0","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607100852-kroe4r7","Type":"NodeParagraph","Properties":{"id":"20240607100852-kroe4r7","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 虚寒泄泻、湿浊中阴、风寒或寒痰咳喘者均禁服。"}]},{"ID":"20240607100852-31eubc1","Type":"NodeParagraph","Properties":{"id":"20240607100852-31eubc1","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607100852-azi4tpp","Type":"NodeParagraph","Properties":{"id":"20240607100852-azi4tpp","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 滋阴润肺；益胃生津；清心除烦。主肺燥干咳；肺痈；阴虚劳嗽；津伤口渴；消渴；心烦失眠；咽喉疼痛；肠燥便秘；血热吐衄"}]},{"ID":"20240607100852-hp2jeso","Type":"NodeParagraph","Properties":{"id":"20240607100852-hp2jeso","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607100852-wvf3fof","Type":"NodeParagraph","Properties":{"id":"20240607100852-wvf3fof","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入丸、散、膏。外用：适量，研末调敷；煎汤涂；或鲜品捣汁搽。"}]},{"ID":"20240607100852-29o5azq","Type":"NodeParagraph","Properties":{"id":"20240607100852-29o5azq","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607100852-e08tfhg","Type":"NodeParagraph","Properties":{"id":"20240607100852-e08tfhg","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 1.麦门冬丸(《普济方》)，治虚热上攻，脾肺有热，咽喉生疮。2.生脉散(《千金方》)，治热伤元气，肢体倦怠，气短懒言，口干作渴，汗出不止，脚欹眼黑，津枯液涸。3.麦门冬散(《备急千金要方》)，治缺乳。4.麦门冬散(《太平圣惠方》)，治伤寒阳痉，身壮热，项背强直，心膈烦躁，发热恶寒，头面赤色，四肢疼痛。5.麦门冬丸(《证治准绳·幼科》)，治上儿肌肤赢瘦，骨热，小便赤黄。6.麦门冬饮(《外台秘要》)，治心劳热不止，肉毛焦色无润，口赤干燥，心闷。7.麦门冬饮子(《宣明论方》)，治膈消胸满，心烦，津液亏虚，短气，久为消渴。8.麦门冬汤(《金匮要略》)，功能益胃生津，降逆下气，治胃有虚热，津液不足，气火上逆而致的肺痿。9.麦冬理中汤(《备急千金要方》)，治上焦热，腹满不欲食，或食则先吐后泻，肢挛痛。10.麦冬平肺饮(《杂病源流犀烛·脏腑门》)，治肺痈初起，咳嗽气急，胸中隐痛，吐脓痰者。11.麦冬养荣汤(《血证论》)，治脾之阳气不旺，无以统运阴血而致唾血，心战脉弱，四肢清冷，饮食不健，自汗身热者。12.麦冬麻仁汤(《温病条辨》)，治疟伤胃阴，不饥不饱，不便，潮热，得食则烦热愈加，津液不复者。"}]},{"ID":"20240607100852-jnlwc5u","Type":"NodeParagraph","Properties":{"id":"20240607100852-jnlwc5u","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607100852-kh9e01p","Type":"NodeParagraph","Properties":{"id":"20240607100852-kh9e01p","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气。"}]},{"ID":"20240607100852-dz6ugqx","Type":"NodeParagraph","Properties":{"id":"20240607100852-dz6ugqx","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：疗身重目黄，心下支满，虚劳客热，口干烦渴，止呕吐，愈痿蹶，强阴益精，消谷调中，保神，定肺气，安五脏，令人肥健。"}]},{"ID":"20240607100852-00tdmeh","Type":"NodeParagraph","Properties":{"id":"20240607100852-00tdmeh","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：治热毒，止烦渴，主大水面目肢节浮肿，下水。治肺痿吐脓，主泄精。"}]},{"ID":"20240607100852-s7038r4","Type":"NodeParagraph","Properties":{"id":"20240607100852-s7038r4","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"4.《本草拾遗》：治寒热体劳，下痰饮。"}]},{"ID":"20240607100852-7so8sir","Type":"NodeParagraph","Properties":{"id":"20240607100852-7so8sir","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"5.日华子本草》：治五劳七伤，安魂定魄，时疾热狂，头痛，止嗽。"}]},{"ID":"20240607100852-8ui044a","Type":"NodeParagraph","Properties":{"id":"20240607100852-8ui044a","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"6.《本草衍义》：治心肺虚热。"}]},{"ID":"20240607100852-8oyjh5p","Type":"NodeParagraph","Properties":{"id":"20240607100852-8oyjh5p","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"7.《珍珠囊》：治肺中伏火，生脉保神。"}]},{"ID":"20240607100852-b50ljvp","Type":"NodeParagraph","Properties":{"id":"20240607100852-b50ljvp","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"8.《医学启源》：《主治秘诀》云，治经枯乳汁不下。"}]},{"ID":"20240607100852-lwhad2a","Type":"NodeParagraph","Properties":{"id":"20240607100852-lwhad2a","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"9.《用药心法》：补心气不足及治血妄行。"}]},{"ID":"20240607100852-y7z5nsl","Type":"NodeParagraph","Properties":{"id":"20240607100852-y7z5nsl","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"10.《南京民间药草》：治妇女湿淋。"}]},{"ID":"20240607100852-4do5p1s","Type":"NodeParagraph","Properties":{"id":"20240607100852-4do5p1s","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"11.《福建民间草药》：能清心益肝，利尿解热，治小便淋闭，小儿肝热。"}]},{"ID":"20240607100852-0zmjvk3","Type":"NodeParagraph","Properties":{"id":"20240607100852-0zmjvk3","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"12.《安徽药材》：治咽喉肿痛。"}]},{"ID":"20240607100852-r82uzlv","Type":"NodeParagraph","Properties":{"id":"20240607100852-r82uzlv","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"13.《本草汇言》：麦门冬，清心润肺之药也。主心气不足，惊悸怔忡，健忘恍惚，精神失守；或肺热肺燥，咳声连发，肺痿叶焦，短气虚喘，火伏肺中，咯血咳血；或虚劳客热，津液干少；或脾胃燥涸，虚秘便难；此皆心肺肾脾元虚火郁之证也。然而味甘气平，能益肺金，味苦性寒，能降心火，体润质补，能养肾髓，专治劳损虚热之功居多。如前古主心腹结气，伤中伤饱，胃络脉绝，羸瘦短气等疾，则属劳损明矣。"}]},{"ID":"20240607100852-r0wwfpe","Type":"NodeParagraph","Properties":{"id":"20240607100852-r0wwfpe","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"14.《药品化义》：麦冬，润肺，清肺，盖肺苦气上逆，润之清之，肺气得保，若咳嗽连声，若客热虚劳，若烦渴，若足痿，皆属肺热，无不悉愈。同生地，令心肺清则气顺，结气自释，治虚人元气不运，胸腹虚气痞满，及女人经水枯，乳不下，皆宜用之。同黄芩，扶金制木，治臌胀浮肿。同山栀，清金利水，治支满黄疸。又同小荷钱，清养胆腑，以佐少阳生气。入固本丸，以滋阴血，使心火下降，肾水上升，心肾相交之义。"}]},{"ID":"20240607100852-cqf4u6f","Type":"NodeParagraph","Properties":{"id":"20240607100852-cqf4u6f","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"15.《本草新编》：麦门冬，泻肺中之伏火，清胃中之热邪，补心气之劳伤，止血家之呕吐，益精强阴，解烦止渴，美颜色，悦肌肤，退虚热，解肺燥，定咳嗽，真可持之为君而又可借之为臣使也。但世人未知麦冬之妙用，往往少用之而不能成功为可惜也。不知麦冬必须多用，力量始大，盖火伏于肺中，烁干内液，不用麦冬之多，则火不能制矣；热炽于胃中，熬尽其阴，不用麦冬之多，则火不能息矣。更有膀胱之火，上逆于心胸，小便点滴不能出，人以为小便火闭，由于膀胱之热也，用通水之药不效，用降火之剂不效，此又何用乎？盖膀胱之气，必得上焦清肃之令行，而火乃下降，而水乃下通。夫上焦清肃之令禀于肺也，肺气热，则肺清肃之令不行，而膀胱火闭，水亦闭矣。故欲通膀胱者，必须清肺金之气，清肺之药甚多，皆有损无益，终不若麦冬清中有补，能泻膀胱之火，而又不损膀胱之气，然而少用之，亦不能成功，盖麦冬气味平寒，必多用之而始有济也。"}]},{"ID":"20240607100852-5hpoap9","Type":"NodeParagraph","Properties":{"id":"20240607100852-5hpoap9","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"16.《本经疏证》：麦门冬，其味甘中带苦，又合从胃至心之妙，是以胃得之而能输精上行，肺得之而能敷布四脏，洒陈五腑，结气自尔消熔，脉络自尔联续，饮食得为肌肤，谷神旺而气随之充也。香岩叶氏曰，知饥不能食，胃阴伤也。太阴湿土，得阳始运，阳明燥土，得阴乃安，所制益胃阴方，遂与仲景甘药调之之义合。《伤寒论》、《金匮要略》用麦门冬者五方，惟薯蓣丸药味多，无以见其功外，于炙甘草汤，可以见其阳中阴虚，脉道泣涩；于竹叶石膏汤，可以见其胃火尚盛，谷神未旺；于麦门冬汤，可以见其气因火逆；于温经汤，可以见其因下焦之实，成上焦之虚。虽然，下焦实证，非见手掌烦热，唇口干燥，不可用也；上气因于风，因于痰，不因于火，咽喉利者，不可用也；虚羸气少，不气逆欲吐，反下利者，不可用也；脉非结代，微而欲绝者，不可用也。盖麦门冬之功，在提曳胃家阴精，润泽心肺，以通脉道，以下逆气，以除烦热，若非上焦之证，则与之断不相宜。"}]},{"ID":"20240607100852-gx1zzk3","Type":"NodeParagraph","Properties":{"id":"20240607100852-gx1zzk3","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"17.《本草正义》：麦冬，其味大甘，膏脂浓郁，故专补胃阴，滋津液，本是甘药补益之上品。凡胃火偏盛，阴液渐枯，及热病伤阴，病后虚羸，津液未复，或炎暑燥津，短气倦怠，秋燥逼人，肺胃液耗等证，麦冬寒润，补阴解渴，皆为必用之药。但偏于阴寒，则惟热炽液枯者，最为恰当，而脾胃虚寒，清阳不振者，亦非阴柔之品所能助其发育生长。况复膏泽厚腻，苟脾运不旺，反以碍其转输而有余，而湿阻痰凝，寒饮停滞者，固无论矣。《本经》、《别录》主治，多就养胃一层立论，必当识得此旨，方能洞达此中利弊。不然者，拘执伤饱支满，身重目黄等说，一概乱投，自谓此亦古人精义所在，岂不益增其困？《别录》又以麦冬主痿蹶者，正是《内经》治痿独取阳明之意。胃主肌肉，而阳明之经，又自足而上，阳明经热，则经脉弛缓而不收，胃液干枯，则络脉失润而不利，补胃之津，而养阳明之液，是为治痿起废之本。但亦有湿流关节，而足废不用者，则宜先理其湿，又与滋润一法，遥遥相对，不知辨别，其误尤大。《别录》又谓其定肺气，而后人遂以麦冬为补肺主药，盖以肺家有火，则滋胃之阴以生肺金，亦是正法，参麦散一方，固为养胃保肺无上妙品。然肺为贮痰之器，干燥者少，湿浊者多，设使痰气未清，而即投粘腻，其害已不可胜言，而麦冬又滋腻队中之上将，或更以沙参、玉竹、二母等柔润甘寒之物辅之，则盘踞不行，辟为窟宅，而清肃之肺金，遂为痰饮之渊薮矣。麦冬本为补益胃津之专品，乃今人多以为补肺之药，虽曰补土生金，无甚悖谬，究其之所以专主者，固在胃而不在肺，寇宗奭谓治肺热，亦就肺家有火者言之，柔润滋液，以疗肺热叶焦，亦无不可，《日华》谓主肺痿，固亦以肺火炽盛者言之也。然又继之曰吐脓，则系肺痈矣。究之肺痿、肺痈，一虚一实，虚者干痿，实者痰火。麦冬润而且腻，可以治火燥之痿，不可治痰塞之痈，且肺痈为痰浊与气火交结，咯吐臭秽，或多脓血，宜清宜降，万无投以滋腻之理。即使如法清理，火息痰清，咳吐大减，肺气已呈虚弱之象，犹必以清润为治，误与腻补，痰咳即盛，余焰复张，又临证以来之历历可据者。而肺痿为肺热叶焦之病，若但言理法，自必以补肺为先务。然气虚必咳，咳必迫火上升，而胃中水谷之液，即因而亦化为痰浊。故肺虽痿矣，亦必痰咳频仍，咯吐不已，惟所吐者，多涎沫而非秽浊之脓痰，是亦止宜清养肺气，渐理其烁金之火。使但知为虚而即与粘腻滋补，则虚者未必得其补益，而痰火即得所凭依，又致愈咳愈盛，必至碎金不鸣，而不复可救，此沙参、玉竹、麦冬、知母等味，固不独脓痰肺痈所大忌，即虚痰之肺痿，亦必有不可误与者。《日华》又谓麦冬治五劳七伤，盖亦《本经》主伤中之意，养胃滋阴，生津益血，夫孰非调和五脏之正治。然以为服食之品，调养于未病之先则可，若曰劳伤已成，而以阴柔之药治之，又非阳生阴长之旨。且劳损之病，虽曰内热，然亦是阴虚而阳无所附，补脾之气，助其健运，尚能击其中坚，而首尾皆应。徒事滋润养阴，则阴寒用事，而脾阳必败，不食、泄泻等证，必不可操券以俟，越人所谓过中不治之病，又皆阴柔之药以酿成之矣。"}]},{"ID":"20240607100852-hhxge3w","Type":"NodeParagraph","Properties":{"id":"20240607100852-hhxge3w","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607100852-evqawgh","Type":"NodeParagraph","Properties":{"id":"20240607100852-evqawgh","updated":"20240607100852"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607100854-wouuboz","Type":"NodeThematicBreak","Properties":{"id":"20240607100854-wouuboz"}},{"ID":"20240607100855-gzqs17g","Type":"NodeParagraph","Properties":{"id":"20240607100855-gzqs17g"}}]}