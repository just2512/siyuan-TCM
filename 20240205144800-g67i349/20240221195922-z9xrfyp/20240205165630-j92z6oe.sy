{"ID":"20240205165630-j92z6oe","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205165630-j92z6oe","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205165630-j92z6oe\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206090303-ksxuz5j\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607100855-gzqs17g\u0026quot;,\u0026quot;scrollTop\u0026quot;:2200\u0026#125;","title":"032麦门冬（麦冬、小叶麦冬、大叶麦冬）","type":"doc","updated":"20240802125331"},"Children":[{"ID":"20240712164243-ed2rsse","Type":"NodeParagraph","Properties":{"id":"20240712164243-ed2rsse","updated":"20240712171416"},"Children":[{"Type":"NodeTextMark","TextMarkType":"b strong","TextMarkTextContent":"细叶麦冬（小叶麦冬）"}]},{"ID":"20240206090303-ksxuz5j","Type":"NodeParagraph","Properties":{"id":"20240206090303-ksxuz5j","updated":"20240206090311"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产四川、浙江。\n【性状】\t浙麦冬块根纺锤形，长1.53.5cm，中部直径37mm。表面土黄色或黄白色，有较深的不规则细纵纹，有时一端有细小中柱外露。质韧，断面类白色，中央有细小圆形中柱，新鲜时可抽出。气微香，味微甘、涩，嚼之微有粘性。\n川麦冬块根较短小，表面乳白色。质较坚硬，香气小，味淡，少粘性。\n【性味】\t甘、微苦，凉。\n【功效】\t滋阴生津、润肺止咳、清心除烦。主治热病伤津、心烦、口渴、咽干肺热、咳嗽、肺结核。"}]},{"ID":"20240206090302-eh8epez","Type":"NodeParagraph","Properties":{"id":"20240206090302-eh8epez","updated":"20240206090302"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206090302-qr7f7ai.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240205165853-i09ma1x","Type":"NodeParagraph","Properties":{"id":"20240205165853-i09ma1x","updated":"20240205165853"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麦冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麦冬-20240205165853-ouayry7.jpg"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240618140644-0n9bf5l","Type":"NodeParagraph","Properties":{"id":"20240618140644-0n9bf5l","updated":"20240714082818"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 569px;","style":"width: 559px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小叶麦冬 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小叶麦冬 3-20240714082818-la9ywyz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 559px;\" parent-style=\"width: 569px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 424px;","style":"width: 414px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麦冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麦冬-20240712165252-4cs6x89.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 414px;\" parent-style=\"width: 424px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240712165521-dtn6siq","Type":"NodeParagraph","Properties":{"id":"20240712165521-dtn6siq","updated":"20240712165635"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 323px;","style":"width: 313px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"麦冬 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/麦冬 1-20240712165521-fnp3gn3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 313px;\" parent-style=\"width: 323px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 877px;","style":"width: 867px;"},"Children":[{"Type":"NodeBang"}