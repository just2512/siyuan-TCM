penBracket"},{"Type":"NodeLinkText","Data":"枸杞 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸杞 2-20240710183250-1dfqhuc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 602px;","style":"width: 592px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸杞 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸杞 4-20240710183414-vmye1pf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 592px;\" parent-style=\"width: 602px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710183138-crueue2","Type":"NodeParagraph","Properties":{"id":"20240710183138-crueue2","updated":"20240710185611"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 398px;","style":"width: 388px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸杞1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸杞1-20240620143546-jgml29j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 388px;\" parent-style=\"width: 398px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 788px;","style":"width: 778px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸杞 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸杞 11-20240710185611-5r84v7q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 778px;\" parent-style=\"width: 788px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710185653-plupl10","Type":"NodeParagraph","Properties":{"id":"20240710185653-plupl10","updated":"20240710185703"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 758px;","style":"width: 748px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸杞 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸杞 12-20240710185653-g202gua.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 748px;\" parent-style=\"width: 758px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 461px;","style":"width: 451px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸杞 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸杞 13-20240710185703-5dk7zd9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 451px;\" parent-style=\"width: 461px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607140939-7zhl507","Type":"NodeThematicBreak","Properties":{"id":"20240607140939-7zhl507"}},{"ID":"20240607141038-9q6o5p2","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607141038-9q6o5p2","updated":"20240607141038"},"Children":[{"Type":"NodeText","Data":"枸杞《神农本草经》"}]},{"ID":"20240607141038-nfcjsod","Type":"NodeParagraph","Properties":{"id":"20240607141038-nfcjsod","updated":"20240607141038"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240607141038-q969f0q","Type":"NodeParagraph","Properties":{"id":"20240607141038-q969f0q","updated":"20240607141038"},"Children":[{"Type":"NodeText","Data":"主五内邪气，热中，消渴，周痹。久服，坚筋骨，轻身不老（《御览》作耐老）。一名杞根，一名地骨，一名枸忌，一名地辅。生平泽。"}]},{"ID":"20240607141038-0umsh9v","Type":"NodeParagraph","Properties":{"id":"20240607141038-0umsh9v","updated":"20240607141038"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：枸杞，一名枸已，一名羊乳。（《御览》）"}]},{"ID":"20240607141038-tq7gooa","Type":"NodeParagraph","Properties":{"id":"20240607141038-tq7gooa","updated":"20240607141038"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名羊乳，一名却暑，一名仙人杖，一名西王母杖，生常山，及诸邱陵阪岸，冬采根，春夏采叶，秋采茎实，阴干。"}]},{"ID":"20240607141038-8phcq6b","Type":"NodeParagraph","Properties":{"id":"20240607141038-8phcq6b","updated":"20240607141038"},"Children":[{"Type":"NodeText","Data":"案《说文》云：继，枸杞也。杞，枸杞也；《广雅》云：地筋，枸杞也；《尔雅》云：杞，枸；郭璞云：今枸杞也；《毛诗》云：集子苞杞；《传》云：杞，枸也；陆玑云：苦杞秋熟，正赤，服之轻身益气；《列仙传》云：陆通食橐卢木实；《抱朴子·仙药》云：象柴，一名托卢，是也。或名仙人杖，或云西王母杖，或名天门精，或名却老，或名地骨，或名枸杞也。"}]},{"ID":"20240607140940-nwxu2gl","Type":"NodeThematicBreak","Properties":{"id":"20240607140940-nwxu2gl"}},{"ID":"20240607141012-2m24z08","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141012-2m24z08","updated":"20240607141016"},"Children":[{"Type":"NodeText","Data":"枸杞《证类本草》"}]},{"ID":"20240607141022-1xat8f0","Type":"NodeParagraph","Properties":{"id":"20240607141022-1xat8f0","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"味苦，寒。根大寒，子微寒，无毒。主五内邪气，热中消渴，周痹，风湿，下胸胁气，客热头痛，补内伤大劳嘘吸，坚筋骨，强阴，利大小肠。久服坚筋骨，轻身不老，耐寒暑。"}]},{"ID":"20240607141022-r5m8igw","Type":"NodeParagraph","Properties":{"id":"20240607141022-r5m8igw","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"一名杞根，一名地骨，一名枸忌，一名地辅，一名羊乳，一名却暑，一名仙人杖，一名西王母杖。生常山平泽及诸丘陵阪岸。冬采根，春夏采叶，秋采茎、实，阴干。"}]},{"ID":"20240607141022-25oz24q","Type":"NodeParagraph","Properties":{"id":"20240607141022-25oz24q","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出堂邑，而石头烽火楼下最多。其叶可作羹，味小苦。俗谚云∶去家千里，勿食箩摩、枸杞。此言其补益精气，强盛阴道也。箩摩一名苦丸，叶浓大，作藤生，摘之有白乳汁，人家多种之。可生啖，亦蒸煮食也。枸杞根、实，为服食家用，其说甚美，仙人之杖，远有旨乎。臣禹锡等谨按尔雅疏云∶杞，一名枸 。郭云∶今枸杞也。《诗·四牡》云∶集于苞杞。陆机云∶一名苦杞，一名地骨。春生作羹茹，微苦，其茎似莓，子秋熟，正赤，茎、叶及子，服之轻身益气尔。抱朴子云∶家柴一名托卢，或名天精，或名却老，或名地骨。药性论云∶枸杞，臣，子、叶同说，味甘，平。能补益精，诸不足，易颜色，变白，明目，安神，令人长寿。叶和羊肉作羹，益人，甚除风，明目。若渴，可煮作饮，代茶饮之。"}]},{"ID":"20240607141022-cuhqmke","Type":"NodeParagraph","Properties":{"id":"20240607141022-cuhqmke","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"白色无刺者良。与乳酪相恶。发热诸毒，烦闷，可单煮汁解之。能消热面毒。又，根皮细锉，面拌熟煮吞之，主治肾家风，良。又，益精气法∶取叶上虫窠子，曝干为末，入干地黄中为丸，益阳事。主患眼风障，赤膜昏痛，取叶捣汁注眼中，妙。日华子云∶地仙苗，除烦益志，补五劳七伤，壮心气，去皮肤、骨节间风，消热毒，散疮肿，即枸杞也。"}]},{"ID":"20240607141022-carrrkb","Type":"NodeParagraph","Properties":{"id":"20240607141022-carrrkb","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"图经曰∶枸杞，生常山平泽及丘陵阪岸，今处处有之。春生苗，叶如石榴叶而软薄，堪食，俗呼为红菜头。其茎干高三、五尺，作丛。六月、七月生小红紫花。随便结红实，形微长如枣核。其根名地骨。春夏采叶，秋采茎、实，冬采根。谨按《尔雅》云∶杞，枸 。郭璞云∶今枸杞也。《诗·小雅·四牡》云∶集于苞杞。陆机疏云∶一名苦杞，一名地骨。春生，作羹茹微苦。其茎似莓。子秋熟，正赤。茎、叶及子服之，轻身益气。《淮南枕中记》着西河女子服枸杞法∶正月上寅采根，二月上卯治服之；三月上辰采茎，四月上巳治服之；五月上午采叶，六月上未治服之；七月上申采花，八月上酉治服之；九月上戌采子，十月上亥治服之；十一月上子采根，十二月上丑治服之。又有并花、实、根、茎、叶作煎，及单笮子汁煎膏服之，其功并等。今人相传谓枸杞与枸棘二种相类，其实形长而枝无刺者，真枸杞也。"}]},{"ID":"20240607141022-3p7ofuo","Type":"NodeParagraph","Properties":{"id":"20240607141022-3p7ofuo","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"圆而有刺者，枸棘也。枸棘不堪入药，而下品溲（音搜）疏条注李当之云∶子似枸杞，冬月熟，色赤。味甘、苦。苏恭云∶形似空疏，木高丈许，白皮。其子，七月、八月熟。似枸杞子，味甘而两两相并。今注云∶虽相似，然溲疏有刺，枸杞无刺，以此为别。是三物相似，而二物又有刺。溲疏亦有巨骨之名，如枸杞谓之地骨，当亦相类，用之宜细辨耳。或云∶溲疏以高硕为别，是不然也。今枸杞极有高硕者，其入药乃神良。世传蓬莱县南丘村多枸杞。高者一、二丈，其根蟠结甚固。故其乡人多寿考，亦饮食其水土之品使然耳。润州州寺大井旁生枸杞，亦岁久。故土人目为枸杞井，云饮其水甚益人。"}]},{"ID":"20240607141022-xas3tva","Type":"NodeParagraph","Properties":{"id":"20240607141022-xas3tva","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"溲疏生熊耳川谷及田野丘墟地，四月采。古今方书鲜见用者，当亦难别耳。又按∶枸杞一名仙人杖，而陈藏器《拾遗》别有两种仙人杖，一种是枯死竹竿之色黑者，一种是菜类，并此为三物而同一名也。陈子昂《观玉篇》云∶余从补阙乔公北征，夏四月，次于张掖河洲，草木无他异，唯有仙人杖，往往丛生，予昔尝饵之。此役也，息意滋味，戍人有荐嘉蔬者，此物存焉。因为乔公唱言其功，时东莱王仲烈亦同旅，闻之喜而甘心食之，旬有五日，行人有自谓知药者，谓乔公曰∶此白棘也。仲烈遂疑曰∶吾亦怪其味甘，乔公信是言，乃讥予，予因作《观玉篇》。按此仙人杖作菜茹者，叶似苦苣。白棘木类，何因相似而致疑如此。或曰乔公所谓白棘，当是枸棘，枸棘是枸杞之有针者。而《本经》无白棘之别名。又其味苦，仙人杖味甘，设疑为枸棘，枸棘亦非甘物。乃知草木之类，多而难识，使人惑疑似之言，以真为伪，失青黄甘苦之别而至于是，宜乎子昂论著之详也。"}]},{"ID":"20240607141022-brmhh64","Type":"NodeParagraph","Properties":{"id":"20240607141022-brmhh64","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使根，掘得后使东流水浸，以物刷上土了，然后待干，破去心，用熟甘草汤浸一宿，然后焙干用。其根若似物命形状者上，春食叶，夏食子，秋冬食根并子也。食疗寒，无毒。叶及子并坚筋能老，除风，补益筋骨，能益人去虚劳。根主去骨热，消渴。叶和羊肉作羹尤善益人。代茶法煮汁饮之，益阳事，能去眼中风痒赤膜，捣叶汁点之良。又取洗去泥，和面拌作饮煮熟吞之，去肾气尤良，又益精气。圣惠方枸杞子酒，主补虚，长肌肉，益颜色，肥健人，能去劳热。用生枸杞子五升，好酒二斗，研搦勿碎，浸七日，漉去滓饮之。初以三合为始，后即任性饮之。《外台秘要》同。千金方治齿疼，煮枸杞汁含之。又方治肝虚或当风眼泪等新病方∶枸杞子取肥者二升捣破，内绢袋置罐中，以酒一斗浸讫，密封勿泄气，三七日，每旦饮之，任性勿醉。又方治虚劳客热。用枸杞根末调服，有固疾人不得吃。肘后方，治大赫疮。此患急，宜防毒瓦斯入心腹，饮枸杞汁至瘥。又方疗目热生肤赤白眼。捣枸杞汁洗目，五七度。又方犬食马肉生狂方。忽鼻头燥，眼赤，不食，避人藏身，皆欲发狂。便宜枸杞汁煮粥饲之，即不狂，若不肯食糜，以盐涂其鼻，既舐之，则欲食矣。经验方金髓煎枸杞子，不计多少。逐日旋采摘红熟者，去嫩蒂子拣令洁净，便以无灰酒于净器浸之，须是瓮，用酒浸以两月为限，用蜡纸封闭紧密，无令透气，候日数足漉出，于新竹器内盛贮，旋于沙盆中研令烂细，然后以细布滤过，候研滤皆毕，去滓不用，即并前渍药酒及滤过药汁搅匀，量银锅内多少升斗作番次，慢火熬成膏，切须不住手用物搅，恐粘底不匀，候稀稠得所，待冷，用净瓶器盛之，勿令泄气。每早辰温酒下二大匙头，夜卧服之，百日中身轻气壮，积年不废，可以羽化。经验后方治五劳七伤，庶事衰弱。枸杞叶半斤切，粳米二合，以豉汁中相和，煮作粥，以五味末，葱白等调和食之。又方变白轻身。枸杞子二升，十月壬癸日采，采时面东摘，生地黄汁三升，以好酒二升，于瓷瓶内浸二十一日了，开封，添地黄汁同浸，搅之，却以纸三重封其头了，更浸，候至立春前三十日开瓶，空心暖饮一杯，至立春后，髭鬓却黑。勿食芜荑、葱，服之耐老轻身，无比。孙真人备急方治满口齿有血。枸杞和根、苗煎汤，食后吃。又治骨 风。《经验后方》同。兵部手集疗眼暴赤痛神效，枸杞汁点眼立验。"}]},{"ID":"20240607141022-h1ld610","Type":"NodeParagraph","Properties":{"id":"20240607141022-h1ld610","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"沈存中方陕西枸杞，长一、二丈，其围数寸，无刺，根皮如浓朴，甘美异于诸处，生子如樱桃，全少核，曝干如饼，极烂有味。外台秘要疗眼暴天行肿痒痛。地骨皮三斤，水三斗，煮取三升，绞去滓，更纳盐一两，煎取二升，敷目。或加干姜二两。治疽凡患痈疽恶疮，出脓血不止者。取地骨皮不拘多少净洗，先刮上面粗皮留之，再刮取细白穣，取粗皮同地骨一处煎汤，淋洗病令脓血净，以细穣贴之，立效。有一朝士，腹胁间病疽，经岁不瘥。人烧灰敷贴之，初淋洗出血一、二升，其家人辈惧，欲止，病者曰∶疽似少宽，更淋之，再用五升许，血渐淡，遂止，以细穣贴之，次日结痂，遂愈。别说云枸棘亦非甘物。今按诸文所说，名极多，故使人疑，然比物用甚众，花小而红紫色，采时七月上申日。《图经》所说∶实形长而枝无刺者，真枸杞也。此别是一种类，必多根而致疑。又用根去上浮粗皮一重近白者一重色微紫极薄阴干。治金疮有神验。"}]},{"ID":"20240607141022-8moytu6","Type":"NodeParagraph","Properties":{"id":"20240607141022-8moytu6","updated":"20240607141022"},"Children":[{"Type":"NodeText","Data":"衍义曰∶枸杞，当用梗皮，地骨当用根皮，枸杞子当用其红实，是一物有三用。其皮寒，根大寒，子微寒，亦三等。此正是孟子所谓∶性由杞柳之杞。后人徒劳分别，又为之枸棘，兹强生名耳。凡杞，未有无棘者，虽大至有成架，然亦有棘。但此物小则多刺，大则少刺，还如酸枣及棘，其实皆一也。今人多用其子，直为补肾药，是曾未考究经意。当更量其虚实冷热用之。"}]},{"ID":"20240607141023-3udx4o3","Type":"NodeThematicBreak","Properties":{"id":"20240607141023-3udx4o3"}},{"ID":"20240607141057-4d7k0kj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141057-4d7k0kj","updated":"20240617100828"},"Children":[{"Type":"NodeText","Data":"枸杞《本草经集注》"}]},{"ID":"20240607141057-7b5s0ma","Type":"NodeParagraph","Properties":{"id":"20240607141057-7b5s0ma","updated":"20240607141057"},"Children":[{"Type":"NodeText","Data":"味苦，寒，根大寒，子微寒，无毒。主治五内邪气，热中，消渴，周痹。风湿，下胸胁气，客热，头痛，补内伤，大劳、嘘吸，坚筋骨，强阴，利大小肠。久服坚筋骨，轻身，耐老，耐寒暑。一名杞根，一名地骨，一名枸忌，一名地辅，一名羊乳，一名却暑，一名仙人杖，一名西王母杖。生常山平泽、及诸丘陵阪岸上。冬采根，春、夏采叶，秋采茎、实，阴干。"}]},{"ID":"20240607141057-ad59g8j","Type":"NodeParagraph","Properties":{"id":"20240607141057-ad59g8j","updated":"20240617100830"},"Children":[{"Type":"NodeText","Data":"今出堂邑，而石头烽火楼下最多。其叶可作羹，味小苦。世谚云∶去家千里，勿食萝摩，枸杞，此言其补益精气，强盛阴道也。萝摩一名苦丸，叶浓大作藤生，摘有白乳汁，人家多种之，可生啖，亦蒸煮食也。枸杞根、实，为服食家用，其说乃甚美，仙人之杖，远自有旨乎也。"}]},{"ID":"20240607141106-ybt5v51","Type":"NodeThematicBreak","Properties":{"id":"20240607141106-ybt5v51"}},{"ID":"20240607141116-x2k0my7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141116-x2k0my7","updated":"20240607141121"},"Children":[{"Type":"NodeText","Data":"枸杞《名医别录》"}]},{"ID":"20240607141116-v6upn0r","Type":"NodeParagraph","Properties":{"id":"20240607141116-v6upn0r","updated":"20240607141116"},"Children":[{"Type":"NodeText","Data":"根大寒，子微寒，无毒．主治风湿，下胸胁气，客热头痛，补内伤，大劳、嘘吸，坚骨，强阴，利大小肠．久服耐寒暑．一名羊乳，一名却暑，一名仙人杖，一名西王母杖．常山及诸丘陵阪岸上．冬采根，春夏采叶，秋采茎实．阴干．"}]},{"ID":"20240607141116-fcbz235","Type":"NodeParagraph","Properties":{"id":"20240607141116-fcbz235","updated":"20240607141116"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶枸杞，味苦，寒．主五内邪气，热中消渴，周痹．久服，坚筋骨，轻身不老"}]},{"ID":"20240617101033-qfmnyi6","Type":"NodeThematicBreak","Properties":{"id":"20240617101033-qfmnyi6"}},{"ID":"20240607141126-3z0xj0z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141126-3z0xj0z","updated":"20240607141132"},"Children":[{"Type":"NodeText","Data":"枸杞《神农本草经读》"}]},{"ID":"20240607141126-qhdep40","Type":"NodeParagraph","Properties":{"id":"20240607141126-qhdep40","updated":"20240607141126"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主五内邪气，热中消渴，周麻风湿。久服坚筋骨，轻身不老，耐寒暑。"}]},{"ID":"20240607141126-8c9uln5","Type":"NodeParagraph","Properties":{"id":"20240607141126-8c9uln5","updated":"20240607141126"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶枸杞气寒，禀水气而入肾；味苦无毒，得火味而入心。五内，即五脏。五脏为藏阴之地，热气伤阴即为邪气，邪气伏于中则为热中，热中则津液不足，内不能滋润脏腑而为消渴，外不能灌溉经络而为周痹。热甚则生风，热郁则成湿，种种相因，唯枸杞之苦寒清热可以统主之。“久服坚筋骨，轻身不老，耐寒暑”三句，则又申言其心肾交补之功，以肾字从坚，补之即所以坚之也。坚则身健而轻，自忘老态；况肾水足可以耐暑，心火宁可以耐寒，洵为饮食之上剂。然苦寒二字，《本经》概根、苗、花、子而言。若单论其子，严冬霜雪之中，红润可爱，是禀少阴水精之气兼少阴君火之化，为补养心肾之良药；但性缓不可以治大病、急病耳。"}]},{"ID":"20240617101019-zrcs0ry","Type":"NodeThematicBreak","Properties":{"id":"20240617101019-zrcs0ry"}},{"ID":"20240617101020-zaxhju5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101020-zaxhju5","updated":"20240617101025"},"Children":[{"Type":"NodeText","Data":"枸杞子《顾松园医镜》"}]},{"ID":"20240617101020-wvfgvxt","Type":"NodeParagraph","Properties":{"id":"20240617101020-wvfgvxt","updated":"20240617101020"},"Children":[{"Type":"NodeText","Data":"〔甘平，入肾、肝二经。〕补肾而填精，强阴止渴；〔精不足者，补之以味，枸杞子是也。补肾益精则阴强，润肺生津则渴除〕。益肝以养营，坚筋明目。〔明目者，以肝开窍于目，黑水神光属肾故也。〕益精明目，滋补之圣药。"}]},{"ID":"20240617101020-cgkhg8s","Type":"NodeParagraph","Properties":{"id":"20240617101020-cgkhg8s","updated":"20240617101020"},"Children":[{"Type":"NodeText","Data":"性润而能利大小肠，泄泻者勿用，或与山药、莲肉、茯苓同用则可泻矣。"}]},{"ID":"20240617101010-8q2q27d","Type":"NodeThematicBreak","Properties":{"id":"20240617101010-8q2q27d"}},{"ID":"20240617101011-f3y41g1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101011-f3y41g1","updated":"20240617101015"},"Children":[{"Type":"NodeText","Data":"枸杞《新修本草》"}]},{"ID":"20240617101011-lpr7i0a","Type":"NodeParagraph","Properties":{"id":"20240617101011-lpr7i0a","updated":"20240617101011"},"Children":[{"Type":"NodeText","Data":"味苦，寒，根大寒，子微寒，无毒。主五内邪气，热中，消渴，周痹，风湿，下胸胁气，客劳、嘘吸，坚筋骨，强阴，利大小肠。久服坚筋骨，轻身，能老，耐寒暑。一名杞根，一名地骨，一名枸忌，一名地辅，一名羊乳，一名却暑，一名仙人杖，一名西王母杖。生常山平泽、又诸丘陵阪岸上。冬采根，春、夏采叶，秋采茎、实，阴干。"}]},{"ID":"20240617101011-u893ff6","Type":"NodeParagraph","Properties":{"id":"20240617101011-u893ff6","updated":"20240617101011"},"Children":[{"Type":"NodeText","Data":"今出堂邑，而石头烽火楼下最多。其叶可作羹，味小苦。俗谚云∶去家千里，勿食萝摩、枸强盛阴道也。萝摩一名苦丸，叶浓大作藤生，摘有白乳汁，人家多种之，可生啖，亦蒸煮食也。枸杞根、实，为服食家用，其说乃甚美，仙人之杖，远自有旨乎也。"}]},{"ID":"20240617101002-pgx3de8","Type":"NodeThematicBreak","Properties":{"id":"20240617101002-pgx3de8"}},{"ID":"20240617100959-d4ivpcb","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240617100959-d4ivpcb","updated":"20240617100959"},"Children":[{"Type":"NodeText","Data":"枸杞《本草崇原》"}]},{"ID":"20240617100959-w7z5yj0","Type":"NodeParagraph","Properties":{"id":"20240617100959-w7z5yj0","updated":"20240617100959"},"Children":[{"Type":"NodeText","Data":"味苦寒，无毒。主五内邪气、热中、消渴、周痹风湿。久服坚筋骨，轻身不老，耐寒暑。"}]},{"ID":"20240617100959-8zbjzje","Type":"NodeParagraph","Properties":{"id":"20240617100959-8zbjzje","updated":"20240617100959"},"Children":[{"Type":"NodeText","Data":"（枸杞始出常山平泽及丘陵阪岸，今处处有之，以陕西甘州者为胜。春生，苗叶如石榴，叶软嫩可食，七月开小紫花，随结实，园红如樱桃，凌冬不落。李时珍曰∶枸杞二树名，此木棘如枸刺，茎若杞条，故兼而名之。《本经》气味主治概根苗花实而言，补未分别，后人以实为枸杞子，根名地骨皮，主治稍不同矣。）"}]},{"ID":"20240617100959-8perfgq","Type":"NodeParagraph","Properties":{"id":"20240617100959-8perfgq","updated":"20240617100959"},"Children":[{"Type":"NodeText","Data":"枸杞根苗苦寒，花实紫赤，至严冬霜雪之中，其实红润可爱，是禀少阴水阴之气，兼少阴君火之化者也。主治五内邪气、热中、消渴。谓五脏正气不足，邪气内生，而为热中、消渴之病。枸杞得少阴水阴之气，故可治也。主治周痹风湿者，兼得少阴君火之化也。岐伯曰∶周痹者，在于血脉之中，随脉以上，随脉以下，不能左右，各当其所。枸杞能助君火之神，出于血脉之中，故去周痹而除风湿。久服坚筋骨，轻身不老，耐寒暑。亦得少阴水火之气，而精神充足，阴阳交会也。"}]},{"ID":"20240617101111-7tdf24j","Type":"NodeThematicBreak","Properties":{"id":"20240617101111-7tdf24j"}},{"ID":"20240617101112-anjbd12","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101112-anjbd12","updated":"20240617101118"},"Children":[{"Type":"NodeText","Data":"枸杞《神农本草经赞》"}]},{"ID":"20240617101112-22h4p2b","Type":"NodeParagraph","Properties":{"id":"20240617101112-22h4p2b","updated":"20240617101112"},"Children":[{"Type":"NodeText","Data":"味苦寒。主五内邪气。热中消渴。周痹。久服坚筋骨。轻身不老。一名杞根。一名地骨。一名枸忌。一名地辅。生平泽。"}]},{"ID":"20240617101112-azf8wul","Type":"NodeParagraph","Properties":{"id":"20240617101112-azf8wul","updated":"20240617101112"},"Children":[{"Type":"NodeText","Data":"枸刺杞条。兼名会对。秋果垂红。春苗笼黛。仙杖晨飞。灵夜吠。山北山南。诗人多慨。"}]},{"ID":"20240617101112-v318b9y","Type":"NodeParagraph","Properties":{"id":"20240617101112-v318b9y","updated":"20240617101112"},"Children":[{"Type":"NodeText","Data":"李时珍曰。枸杞。二树名。此物棘如枸之刺。茎如杞之条。故兼名之。尔雅。妃合会对也。"}]},{"ID":"20240617101112-7ks8n0z","Type":"NodeParagraph","Properties":{"id":"20240617101112-7ks8n0z","updated":"20240617101112"},"Children":[{"Type":"NodeText","Data":"诗疏。苞杞其子。秋熟正赤。苏颂曰。春生苗叶。刘禹锡诗。翠黛叶生笼石。殷红子熟照铜瓶。名医曰。一名仙人杖。史子玉赋。仙杖飞空。苏轼诗。灵或夜吠。诗。南山有杞。"}]},{"ID":"20240617101112-7rsw4k2","Type":"NodeParagraph","Properties":{"id":"20240617101112-7rsw4k2","updated":"20240617101112"},"Children":[{"Type":"NodeText","Data":"又陟彼北山。言采其杞。江淹诏。永言多慨。"}]},{"ID":"20240617101249-es6bnca","Type":"NodeThematicBreak","Properties":{"id":"20240617101249-es6bnca"}},{"ID":"20240617101249-vk3ofpk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101249-vk3ofpk","updated":"20240617101255"},"Children":[{"Type":"NodeText","Data":"枸杞《本草图经》"}]},{"ID":"20240617101249-7xcz4c7","Type":"NodeParagraph","Properties":{"id":"20240617101249-7xcz4c7","updated":"20240617101252"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"枸杞"},{"Type":"NodeText","Data":"，生常山平泽，及丘陵 岸，今处处有之。春生苗，叶如石榴叶而软薄堪食，俗呼为甜菜；其茎干高三、五尺，作丛；六月、七月生小红紫花；随便结红实，形微长如枣核；其根名地骨。春夏采叶，秋采茎实，冬采根。谨按《尔雅》云∶杞枸， 。郭璞云∶今枸杞也。"}]},{"ID":"20240617101249-4gth15o","Type":"NodeParagraph","Properties":{"id":"20240617101249-4gth15o","updated":"20240617101249"},"Children":[{"Type":"NodeText","Data":"《诗·小雅四牡》云∶集于苞杞。陆机疏云∶一名苦杞，一名地骨。春生作羹茹，微苦；其茎似莓；子秋熟，正赤。茎、叶及子服之，轻身益气。《淮南枕中记》着西河女子服枸杞法∶正月上寅采根，二月上卯治服之；三月上辰采茎，四月上巳治服之；五月上午采叶，六月上未治服之；七月上申采花，八月上酉治服之；九月上戌采子，十月上亥治服之；十一月上子采根，十二月上丑治服之。又有并花、实、根、茎、叶作煎，及单榨子汁煎膏服之，其功并等。今人相传谓枸杞与枸棘二种相类，其实形长而枝无刺者，真枸杞也；圆而有刺者，枸棘也。枸棘不堪入药。而下品溲（音搜）疏条注∶李当之云∶子似枸杞，冬月熟，色赤，味甘、苦。苏恭云∶形似空疏，木高丈许，白皮；其子七月、八月熟，似枸杞子，味甘，而两两相并。今注云∶虽相似，然溲疏有刺，枸杞无刺，以此为别。是三物相似，而二物又有刺。溲疏亦有巨骨之名，如枸杞谓之地骨，当亦相类，用之宜细辨耳。或云∶溲疏以高硕为别，是不然也。今枸杞极有高硕者，其入药乃神良。"}]},{"ID":"20240617101249-6hrhr97","Type":"NodeParagraph","Properties":{"id":"20240617101249-6hrhr97","updated":"20240617101249"},"Children":[{"Type":"NodeText","Data":"世传蓬莱县南丘村多枸杞，高者一、二丈，其根蟠结甚固。故其乡人多寿考，亦饮食其水土之品使然耳。润州州寺大井旁生枸杞，亦岁久。故土人目为枸杞井，云饮其水甚益人。溲疏，生熊耳川谷及田野丘墟地，四月采，古今方书鲜见用者，当亦难别耳。又按枸杞一名仙人杖。而陈藏器《拾遗》别两种仙人杖∶一种是枯死竹竿之色黑者，一种是菜类，并此为三物，而同一名也。陈子昂《观玉篇》云∶余从补阙乔公北征，夏四月次于张掖，河洲草木无他异，惟有仙人杖，往往丛生。予昔尝饵之，此役也，息意滋味。戍人有荐嘉蔬者，此物存焉。因为乔公唱言其功，时东莱王仲烈亦同旅，闻之喜，而甘心食之，旬有五日，行人有自谓知药者，谓乔公曰∶此白棘也。仲烈遂疑曰∶吾亦怪其味甘。乔公信是言，乃讥予，予因作《观玉篇》。按此仙人杖作菜茹者，叶似苦苣。白棘木类，何因相似而致疑如此。或曰乔公所谓白棘，当是枸棘，枸棘是枸杞之有针者。而《本经》无白棘之别名，又其味苦，仙人杖味甘，设疑为枸棘，枸棘亦非甘物。乃知草木之类多而难识，使人惑疑似之言。以真为伪，失青黄甘苦之别，而至于是宜乎？子昂论著之详也。"}]},{"ID":"20240617101233-v62gclt","Type":"NodeThematicBreak","Properties":{"id":"20240617101233-v62gclt"}},{"ID":"20240617101234-mzelpvh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101234-mzelpvh","updated":"20240617101238"},"Children":[{"Type":"NodeText","Data":"枸杞《本经逢原》"}]},{"ID":"20240617101234-7xvmcy8","Type":"NodeParagraph","Properties":{"id":"20240617101234-7xvmcy8","updated":"20240617101234"},"Children":[{"Type":"NodeText","Data":"甘平无毒。河西及甘州者良。"}]},{"ID":"20240617101234-oe791yz","Type":"NodeParagraph","Properties":{"id":"20240617101234-oe791yz","updated":"20240617101234"},"Children":[{"Type":"NodeText","Data":"《本经》主热中消渴，久服坚筋骨耐寒暑。"}]},{"ID":"20240617101234-b8374jy","Type":"NodeParagraph","Properties":{"id":"20240617101234-b8374jy","updated":"20240617101234"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"枸杞子味甘色赤，性温无疑，根味微苦，性必微寒，缘《本经》根子合论无分，以致后人或言，子性微寒，根性大寒，或言子性大温，根性苦寒。盖有惑于一，本无寒热两殊之理。夫天之生物不齐，都有丰于此，而涩于彼者。如山茱萸之肉涩精，核滑精。当归之头止血，尾破血。橘实之皮涤痰，膜聚痰，不一而足。即炎帝之尝药，不过详气、味、形、色，安有味甘色赤，形质滋腴之物，性寒之理。《本经》所言主热中消渴，坚筋骨耐寒暑，是指其子而言，质润味浓，峻补肝肾冲督之精血，精得补益，水旺骨强，而肾虚火炎热中消渴，血虚目昏，腰膝疼痛悉愈，而无寒暑之患矣。所谓精不足者，补之以味也。古谚有云，去家千里，勿食枸杞。甚言补益精气之速耳。然无阳气衰，阴虚精滑，及妇人失合，劳嗽蒸热之人慎用；以能益精血，精旺则思偶，理固然也。"}]},{"ID":"20240617101337-s2keunw","Type":"NodeThematicBreak","Properties":{"id":"20240617101337-s2keunw"}},{"ID":"20240617101338-gm4aq6i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101338-gm4aq6i","updated":"20240617101342"},"Children":[{"Type":"NodeText","Data":"枸杞《侣山堂类辩》"}]},{"ID":"20240617101338-f0ykebb","Type":"NodeParagraph","Properties":{"id":"20240617101338-f0ykebb","updated":"20240617101338"},"Children":[{"Type":"NodeText","Data":"《神农本经》，总名枸杞，无地骨皮、枸杞子之分。盖枸字谐狗，杞字谐己，狗属戌，而戌主右肾，肾主骨，而己属阴土，故有地骨之名，而久服能坚筋骨。气味苦寒，能清热中消渴，盖能助水土之气，上滋心肺者也。其子色赤性寒，能补两肾之精气，骨之精为瞳子，故助瞳子之光明。"}]},{"ID":"20240617101347-b87qxce","Type":"NodeThematicBreak","Properties":{"id":"20240617101347-b87qxce"}},{"ID":"20240617101349-9crnktw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101349-9crnktw","updated":"20240617101353"},"Children":[{"Type":"NodeText","Data":"枸杞《本草求真》"}]},{"ID":"20240617101349-3oldtbi","Type":"NodeParagraph","Properties":{"id":"20240617101349-3oldtbi","updated":"20240617101349"},"Children":[{"Type":"NodeText","Data":"（灌木）滋肾水滑肠胃"}]},{"ID":"20240617101349-o1fg1yz","Type":"NodeParagraph","Properties":{"id":"20240617101349-o1fg1yz","updated":"20240617101349"},"Children":[{"Type":"NodeText","Data":"枸杞（专入肾。兼入肝）。甘寒性润。据书皆载祛风明目。强筋健骨。补精壮阳。然究因于肾水亏损。服此甘润。阴从阳长。水至风熄。故能明目强筋。是明指为之味。故书又载能治消渴。（时珍曰。子则甘平而润。性滋而补。不能退热。止能补肾润肺。生精益气。此乃之药。所谓精不足者补之以味也。）今人因见色赤。妄谓枸杞补阳。其失远矣！岂有甘润气寒之品。而尚可言补阳耶？若以色赤为补阳。则红花紫草其色更赤。何以不言补阳而曰活血。呜呼！医道不明。总由看书辨药。不细体会者故耳。试以虚寒服此。不惟阳不能补。且更见有滑脱泄泻之弊矣。可不慎欤？出甘州红润少核者良。根名地骨皮。另详于后。"}]},{"ID":"20240617101404-xbww120","Type":"NodeThematicBreak","Properties":{"id":"20240617101404-xbww120"}},{"ID":"20240617101317-z1f2rqh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101317-z1f2rqh","updated":"20240617101321"},"Children":[{"Type":"NodeText","Data":"枸杞《本草思辨录》"}]},{"ID":"20240617101317-qzblixn","Type":"NodeParagraph","Properties":{"id":"20240617101317-qzblixn","updated":"20240617101317"},"Children":[{"Type":"NodeText","Data":"本经别录，枸杞不分子皮苗叶。而就其文体会之，本经之五内邪气、热中消渴、周痹风湿，别录之下胸胁气、客热头痛，是枸杞皮与苗叶之治。本经之久服坚筋骨耐寒暑，别录之补内伤大劳、嘘吸、强阴、利大小肠，是枸杞子之治。此沈芊绿之言，分别颇当。按陶隐居本经序，于地骨皮下列热中消渴字，千金治虚劳客热、虚劳苦渴，皆用地骨皮。地为阴，骨为里，皮为表，气味甘淡而寒，故所治为肺肝肾三脏虚热之 。脏阴亏，则热中消渴、胸胁气逆、头为之痛。周痹乃风寒湿客于分肉之间，今曰周痹风湿，必周痹由寒变热之候，灵枢所谓神归之则热者也。千金而外，后人又以地骨皮退内潮外潮，治骨蒸、骨槽风、吐血、下血、目赤、口糜、小儿耳疳、下疳等证，然系益阴以除热，有安内之功，无攘外之力。虽表里兼治，而风寒之表热，非所能解也。枸杞子内外纯丹，饱含津液，子本入肾，此复似肾中水火兼具之象。味浓而甘，故能阴阳并补，气液骤增而寒暑不畏。且肾气实则阴自强，筋骨自坚，嘘吸之一出一入自适于平。液枯之体，大小肠必燥，得之则利。惟多用须防其滑；而纯丹又能增火也。后世之方，如金髓煎、四神丸、枸杞酒，可谓竭枸杞之才矣。窃意本经之主周痹风湿、耐寒暑，非皮与子同用之，不能有此效，俟明者政之。"}]},{"ID":"20240617101452-irwv7yd","Type":"NodeThematicBreak","Properties":{"id":"20240617101452-irwv7yd"}},{"ID":"20240617101453-x139jcb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101453-x139jcb","updated":"20240617101457"},"Children":[{"Type":"NodeText","Data":"枸杞《本草崇原》"}]},{"ID":"20240617101453-wxgco1z","Type":"NodeParagraph","Properties":{"id":"20240617101453-wxgco1z","updated":"20240617101453"},"Children":[{"Type":"NodeText","Data":"味苦寒，无毒。主五内邪气、热中、消渴、周痹风湿。久服坚筋骨，轻身不老，耐寒暑。"}]},{"ID":"20240617101453-036zmo6","Type":"NodeParagraph","Properties":{"id":"20240617101453-036zmo6","updated":"20240617101453"},"Children":[{"Type":"NodeText","Data":"（枸杞始出常山平泽及丘陵阪岸，今处处有之，以陕西甘州者为胜。春生，苗叶如石榴，叶软嫩可食，七月开小紫花，随结实，园红如樱桃，凌冬不落。李时珍曰∶枸杞二树名，此木棘如枸刺，茎若杞条，故兼而名之。《本经》气味主治概根苗花实而言，补未分别，后人以实为枸杞子，根名地骨皮，主治稍不同矣。）"}]},{"ID":"20240617101453-81ryd65","Type":"NodeParagraph","Properties":{"id":"20240617101453-81ryd65","updated":"20240617101453"},"Children":[{"Type":"NodeText","Data":"枸杞根苗苦寒，花实紫赤，至严冬霜雪之中，其实红润可爱，是禀少阴水阴之气，兼少阴君火之化者也。主治五内邪气、热中、消渴。谓五脏正气不足，邪气内生，而为热中、消渴之病。枸杞得少阴水阴之气，故可治也。主治周痹风湿者，兼得少阴君火之化也。岐伯曰∶周痹者，在于血脉之中，随脉以上，随脉以下，不能左右，各当其所。枸杞能助君火之神，出于血脉之中，故去周痹而除风湿。久服坚筋骨，轻身不老，耐寒暑。亦得少阴水火之气，而精神充足，阴阳交会也。"}]},{"ID":"20240617101101-s0ppmn8","Type":"NodeThematicBreak","Properties":{"id":"20240617101101-s0ppmn8"}},{"ID":"20240617101102-7wjpv06","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101102-7wjpv06","updated":"20240617101107"},"Children":[{"Type":"NodeText","Data":"枸杞《本草衍义》"}]},{"ID":"20240617101102-p6yqdi2","Type":"NodeParagraph","Properties":{"id":"20240617101102-p6yqdi2","updated":"20240617101102"},"Children":[{"Type":"NodeText","Data":"枸杞当用梗皮，地骨当用根皮，枸杞子当用其红实，是一物有三用。其皮寒，根大寒，子微寒，亦三等。此正是孟子所谓“性由杞柳”之杞。后人徒劳分别，又为之枸棘，兹强生名耳。凡杞，未有无棘者，虽大至有成架，然亦有棘。但此物小则多刺，大则少刺，还如酸枣及棘，其实皆一也。今人多用其子，直为补肾药，是曾未考究经意，当更量其虚实冷热用之。"}]},{"ID":"20240617101642-w66z4m4","Type":"NodeThematicBreak","Properties":{"id":"20240617101642-w66z4m4"}},{"ID":"20240617101643-utvd00t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101643-utvd00t","updated":"20240617101647"},"Children":[{"Type":"NodeText","Data":"枸杞《本草乘雅半偈》"}]},{"ID":"20240617101643-bm7qxyl","Type":"NodeParagraph","Properties":{"id":"20240617101643-bm7qxyl","updated":"20240617101643"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240617101643-40qn06l","Type":"NodeParagraph","Properties":{"id":"20240617101643-40qn06l","updated":"20240617101643"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，无毒。"}]},{"ID":"20240617101643-330ydie","Type":"NodeParagraph","Properties":{"id":"20240617101643-330ydie","updated":"20240617101643"},"Children":[{"Type":"NodeText","Data":"【主治】主五内邪气，热中消渴，周痹风湿。久服坚筋骨，轻身不老，能耐寒暑。"}]},{"ID":"20240617101643-u2dqbzi","Type":"NodeParagraph","Properties":{"id":"20240617101643-u2dqbzi","updated":"20240617101643"},"Children":[{"Type":"NodeText","Data":"【核】曰∶古取尝山者为上，后世唯取陕西甘州者称绝品。生平泽，丘陵阪岸间，春放苗，作榴叶状，软薄堪食，茎干丛生，高三五尺，陕之兰灵，及九原以西者，并是大树。七月作花紫色，随结红实，形长如枣核，凌冬不落。二月叶发，五月再发，其实乃谢。七月叶又发，花即随之，极易延蔓。根深者，一发三四尺，枝茎寸截，或分劈镂刻，横埋土中，旬日便发，易生如此。冬采根，春采叶，夏采实，秋采茎，功用并同。本经名概叶实根茎，后世始岐而二之，以根皮有清热滋补之异，而略言茎叶，更以根去骨存皮，则又不可解矣。别有一种枸棘相类其实，但实圆，枝节间有刺不堪用。修治，取实鲜明红润者，洗净，醇酒浸一宿，捣烂用茎叶，唯阴干，根如物状者为上。东流水浸一宿，刷去土，甘草汤又浸一宿，焙干用。苗伏砒砂，根伏硫黄。"}]},{"ID":"20240617101643-d9snsth","Type":"NodeParagraph","Properties":{"id":"20240617101643-d9snsth","updated":"20240617101643"},"Children":[{"Type":"NodeText","Data":"（凡木之易生者，榕柳之与桑杞、榕柳虽易生，不若桑杞通体精专。叶实根茎，功用并着，杞则更胜于桑，凌冬不落为迥别也。嘉安朱孺子，居大箬岩见溪侧有二花犬相戏，逐至杞丛下，获杞根二枚，形状与戏犬无异，煮食之，俄顷飞升仙去。）"}]},{"ID":"20240617101643-yqb5syk","Type":"NodeParagraph","Properties":{"id":"20240617101643-yqb5syk","updated":"20240617101643"},"Children":[{"Type":"NodeText","Data":"【 】曰∶枸从苟，诚也，省作句。观断绝寸茎，根须俱髡，以入土中，旬日即发，枝干分劈镂刻，亦不之死，仁机扇动，一诚之致也。命名之义，或取诸此。其味苦，得夏大之令，其气寒，得寒水之化，故主夏气病藏之邪，致热中消渴也。唯以怒生为用，故痹为之起，湿为之收。又苦寒能坚，故枝韧比筋，根皮裹骨斯筋骨受之，地仙却老，有繇然矣。且二五七月俱发，宜耐寒暑也。"}]},{"ID":"20240617101520-andi2s6","Type":"NodeThematicBreak","Properties":{"id":"20240617101520-andi2s6"}},{"ID":"20240617101521-yj11c5y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101521-yj11c5y","updated":"20240617101526"},"Children":[{"Type":"NodeText","Data":"枸杞《本草述钩元》"}]},{"ID":"20240617101521-k48o879","Type":"NodeParagraph","Properties":{"id":"20240617101521-k48o879","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"陕之兰灵九原以西。枸杞并是大树。其叶浓。其根粗。河西及甘州者。其子圆如樱桃。曝干。紧小少核。干亦红润甘美。异于他处。入药以河西者为上。（濒湖）苗乃天精。"}]},{"ID":"20240617101521-i75v2rs","Type":"NodeParagraph","Properties":{"id":"20240617101521-i75v2rs","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"其味苦甘。而气凉性升。根乃地骨。其味甘淡。气寒性沉。子味甘。气平。性润。气味既殊。"}]},{"ID":"20240617101521-206rti1","Type":"NodeParagraph","Properties":{"id":"20240617101521-206rti1","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"功用自别。而本经止概言之。（又）枸杞凌冬不凋。其叶三发。发于七月者。花即随之。"}]},{"ID":"20240617101521-vaptaui","Type":"NodeParagraph","Properties":{"id":"20240617101521-vaptaui","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"而实亦随结。是禀金气而涵水。固不分于苗根及实矣。特金气之专萃者尤在实。而河以西者。"}]},{"ID":"20240617101521-0gan6b4","Type":"NodeParagraph","Properties":{"id":"20240617101521-0gan6b4","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"气味更浓也。"}]},{"ID":"20240617101521-1u7rth7","Type":"NodeParagraph","Properties":{"id":"20240617101521-1u7rth7","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"苗"}]},{"ID":"20240617101521-5cgsbcr","Type":"NodeParagraph","Properties":{"id":"20240617101521-5cgsbcr","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"如榴叶而软薄。"}]},{"ID":"20240617101521-3l6bpar","Type":"NodeParagraph","Properties":{"id":"20240617101521-3l6bpar","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"味苦微甘。气寒。治上焦心肺客热。去皮肤骨节间风。消热毒。散疮肿。作饮代茶。"}]},{"ID":"20240617101521-ighc3i0","Type":"NodeParagraph","Properties":{"id":"20240617101521-ighc3i0","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"止消渴烦热。火赫毒疮。患此急防毒瓦斯入心腹。枸杞叶捣汁服之。立瘥。"}]},{"ID":"20240617101521-ffsut3q","Type":"NodeParagraph","Properties":{"id":"20240617101521-ffsut3q","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"地骨皮"}]},{"ID":"20240617101521-dbxehlc","Type":"NodeParagraph","Properties":{"id":"20240617101521-dbxehlc","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"即枸杞根。"}]},{"ID":"20240617101521-ex7g068","Type":"NodeParagraph","Properties":{"id":"20240617101521-ex7g068","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"味甘淡而苦。气寒。阴也。入足少阴手少阳气分。主治去下焦肝肾虚热。益精气。凉血坚筋骨。解有汗骨蒸肌热。疗消渴。泻胞中火。降肺中伏火。退热补正气。去肾家风。并治在表无定风邪。（此阴虚生风非指外感之邪也）及骨槽风。方书更治虚劳发热。往来寒热。诸见血证。鼻衄嗽血。咳喘消瘅。中风眩晕。痫痉虚烦。悸健忘。腰痛行痹。香港脚水肿。"}]},{"ID":"20240617101521-bkndvuu","Type":"NodeParagraph","Properties":{"id":"20240617101521-bkndvuu","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"小便不通。赤白浊。西土产者。功用如上。他产则泻热较甚。未可一例言也。凡阴虚血少。"}]},{"ID":"20240617101521-f6on1ze","Type":"NodeParagraph","Properties":{"id":"20240617101521-f6on1ze","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"阳气下陷于内而为热。热气薰蒸于表而汗泄。为有汗骨蒸。又肾主骨。肾脏有热。则骨亦热。"}]},{"ID":"20240617101521-65nu27s","Type":"NodeParagraph","Properties":{"id":"20240617101521-65nu27s","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"而血涸髓枯。筋失荣养矣。地骨皮入肾益阴气凉血。所以解有汗之骨蒸。并强筋骨也。（类明）三焦之气。原自极里。以至于极表。故去肾风者。即能治在表风邪。（东垣）小便出血。鲜地骨皮洗捣自然汁。无汁则以水煎汁。每服一盏。入酒少许。食前温服。带下脉数。枸杞根一斤。生地五斤。酒一斗。煮五升。日日服之。膀胱移热于小肠。上为口糜。"}]},{"ID":"20240617101521-d1f1ktt","Type":"NodeParagraph","Properties":{"id":"20240617101521-d1f1ktt","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"心胃壅热。水谷不下。用地骨皮汤柴胡地骨皮各三钱。水煎服之。"}]},{"ID":"20240617101521-9ilju0n","Type":"NodeParagraph","Properties":{"id":"20240617101521-9ilju0n","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"〔论〕地骨皮能益足少阴肾之阴气。以疗手少阳三焦之虚阳。盖三焦为元气使。根于肾脏元阴。兹味由甘而苦。其气有寒。本中土之冲气以至地。且其金气涵水。能裕真阴之化源。而不伤元阳。故与苦寒者特殊。凡人真阴中有火。自相蒸烁。而见有汗骨蒸。宜此对待之。须知此味不兼养血。却专以益阴为其功。虽能除热。却不以泻火尽其用。即曰益阴气者。"}]},{"ID":"20240617101521-tc6nzid","Type":"NodeParagraph","Properties":{"id":"20240617101521-tc6nzid","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"便能泻火。但直以为泻火而用。则此味专于除热。不能治虚矣。彼病后之虚烦地仙散。及健忘之读书丸。心气不足惊悸健忘之补心丹。（心气根于肾气）并赤白浊之清心莲子饮。可概谓之泻火乎。或曰。兹味治风。风正阳之淫气所化者也。独不谓之泻火乎。不知益阴气以退三焦之虚阳。但令阴气得为阳守。所程治效。总完一个阴气耳。其有不病于阴弱阳盛。止由阴气不足而亦用此以为滋益之元者。（并为三焦元阳之始）故于各证之治。须当识此义也。"}]},{"ID":"20240617101521-7joqcb6","Type":"NodeParagraph","Properties":{"id":"20240617101521-7joqcb6","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"士材云。中寒者。禁用。"}]},{"ID":"20240617101521-0rb1dyc","Type":"NodeParagraph","Properties":{"id":"20240617101521-0rb1dyc","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"〔修治〕凡掘得根。以东流水浸。刷去土。捶去心。用熟甘草汤浸一宿。焙干。恐其太寒。以酒蒸用。根多不能得河西者。必以醇酒浸。近火处顿干。（不可令熟）如此三次。"}]},{"ID":"20240617101521-1kv2a50","Type":"NodeParagraph","Properties":{"id":"20240617101521-1kv2a50","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"老人方可服。"}]},{"ID":"20240617101521-byga6mo","Type":"NodeParagraph","Properties":{"id":"20240617101521-byga6mo","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"子"}]},{"ID":"20240617101521-eg5j2wv","Type":"NodeParagraph","Properties":{"id":"20240617101521-eg5j2wv","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"七月作花紫色。随结红实。凌冬不凋。二月叶发。五月再发。其实乃谢。七月叶又发。"}]},{"ID":"20240617101521-sumw72s","Type":"NodeParagraph","Properties":{"id":"20240617101521-sumw72s","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"花即随之。"}]},{"ID":"20240617101521-d4wotxh","Type":"NodeParagraph","Properties":{"id":"20240617101521-d4wotxh","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"气味甘平。主治滋肾润肺。疗肝风血虚。去虚劳。补精气。主心病嗌干。心痛渴而引饮。"}]},{"ID":"20240617101521-4myv6uk","Type":"NodeParagraph","Properties":{"id":"20240617101521-4myv6uk","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"遗枸杞子甘润滋补。生精益气。所谓精不足者。补之以味也。世人但以芩连知柏补阴降火。"}]},{"ID":"20240617101521-bobsbo8","Type":"NodeParagraph","Properties":{"id":"20240617101521-bobsbo8","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"致伤元气。而不知枸杞地骨甘寒平补。使精气充而邪火自退之妙。又以青蒿佐地骨。退热屡有殊功（濒湖）枸杞子为肝肾真阴不足。劳乏内热。补益之要药。又为益精明目之上品。"}]},{"ID":"20240617101521-ahhz2gm","Type":"NodeParagraph","Properties":{"id":"20240617101521-ahhz2gm","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"老人阴虚者十常八九。故服食尤宜。（仲淳）枸杞煎。治虚劳。退虚热。轻身益气。令一切痈疽永不发。枸杞三十斤。春夏用茎叶。秋冬用根实。水一石。煮取五斗。以渣再煮。取五斗。澄清。去渣再煎。取二斗。入锅煎如饧。收之。每早酒服一合。此药采无刺味甜者。"}]},{"ID":"20240617101521-z0dck26","Type":"NodeParagraph","Properties":{"id":"20240617101521-z0dck26","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"其有刺者服之无益。得地黄麦冬五味牛膝青蒿鳖甲地骨皮。除虚劳内热。或发寒热。加天冬百部枇杷叶。兼治肺热咳嗽之因阴虚者。与甘菊花相对蜜丸。久服则终身无目疾。兼不中风。及生疔疽。补虚长肉。甘杞子五升。无灰酒二斗。入瓷瓮内。拌搦勿碎。浸七日。"}]},{"ID":"20240617101521-igrr927","Type":"NodeParagraph","Properties":{"id":"20240617101521-igrr927","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"漉去子。温饮之。先以三合为始。后任性长饮。以多取效。注夏虚病。枸杞子五味子研细。"}]},{"ID":"20240617101521-u2bq1t1","Type":"NodeParagraph","Properties":{"id":"20240617101521-u2bq1t1","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"滚〔论〕凡味之兼甘者。即非阴阳偏至之气。枸杞根苗及实俱有甘。但根亲乎地则气寒。"}]},{"ID":"20240617101521-bz8l3q5","Type":"NodeParagraph","Properties":{"id":"20240617101521-bz8l3q5","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"苗亲乎天则气凉。惟其子本水土合德之精。而结为孕育不息之生意。所以阴中含阳。阳为生育之元。味甘而气平。故能去虚劳。补精气也。其结实于秋。专得金气。而色却红润。是金中有火。所谓金火合而血化者。此为最切。第用杞子者。类知其由肾润肺。而不知水脏得金气之专。实由能润心燥而后至肾。（海藏治嗌干心痛。次乃及于引饮肾渴。）所以益肾阴者。真有母气精专之化焉。（能润心燥。是离中有坎而血生。故下归于肾。乃得坎中有离而气化。盖因火得金以为用。故润心燥而血生。金得火以为主。故归肾宅而气化也。）夫气不化。则精亦不足。此红润而甘者。味固至浓。气亦甚全。味浓而益阴者。有其资生。气全而化精者。有其资始。生精益气之说。岂其诬哉。惟本益阴。而又能化阳。虽化阳而还归益阴。"}]},{"ID":"20240617101521-76ol3fg","Type":"NodeParagraph","Properties":{"id":"20240617101521-76ol3fg","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"是从天气以归于下之阴。即得从地气以达乎上之阳。人身从阴中达阳者。惟肝胆为先。杞子之由阴达阳。适合于肝。故入肝疗风而尤能明目也。"}]},{"ID":"20240617101521-0xyr8iv","Type":"NodeParagraph","Properties":{"id":"20240617101521-0xyr8iv","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"肠滑者禁用。（士材）〔修治〕去蒂及枯者。酒浸一宿。捣烂入药。"}]},{"ID":"20240617101521-l50zxtw","Type":"NodeParagraph","Properties":{"id":"20240617101521-l50zxtw","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"枸杞虫食枸杞叶。状如蚕。作茧为蛹时。取晒干收。"}]},{"ID":"20240617101521-lqd1mnk","Type":"NodeParagraph","Properties":{"id":"20240617101521-lqd1mnk","updated":"20240617101521"},"Children":[{"Type":"NodeText","Data":"味咸。气温。和地黄为丸服之。大能起阳益精。"}]},{"ID":"20240617101502-1im155c","Type":"NodeThematicBreak","Properties":{"id":"20240617101502-1im155c"}},{"ID":"20240617101503-7gc9j7c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101503-7gc9j7c","updated":"20240617101509"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草分经》"}]},{"ID":"20240617101503-nrdbsxg","Type":"NodeParagraph","Properties":{"id":"20240617101503-nrdbsxg","updated":"20240617101503"},"Children":[{"Type":"NodeText","Data":"甘微温，滋补肝肾而润，生精助阳，去风明目，利大小肠。"}]},{"ID":"20240607141126-kdorihg","Type":"NodeThematicBreak","Properties":{"id":"20240607141126-kdorihg"}},{"ID":"20240607141138-ouz3aak","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141138-ouz3aak","updated":"20240607141144"},"Children":[{"Type":"NodeText","Data":"枸杞子《医学入门》"}]},{"ID":"20240607141138-1p61knj","Type":"NodeParagraph","Properties":{"id":"20240607141138-1p61knj","updated":"20240607141138"},"Children":[{"Type":"NodeText","Data":"枸杞子寒滋肾精，补气养血眼自明，退热宽胸润肠胃，疮毒风痹脚腰疼。"}]},{"ID":"20240607141138-0zyf856","Type":"NodeParagraph","Properties":{"id":"20240607141138-0zyf856","updated":"20240607141138"},"Children":[{"Type":"NodeText","Data":"枸，狗也。《尔雅》云∶其根久如狗形，服之大有灵异。杞，即杞柳之杞。多刺，又名枸棘。味苦、甘，微寒。无毒。古谚云∶去家千里，勿食枸杞。言其滋益清气，强盛阴道也。内伤大劳，嘘吸少气，肝风血虚，眼赤痛痒昏翳。除烦止虚劳寒热，下胸胁气，治五内邪气、热中消渴，利大小肠，散诸疮毒，去皮肤骨节间风、周痹、风湿腰脚疼痛。兼治客热头痛、齿痛、满口出血。煎膏久服．轻身不老，坚筋骨，耐寒暑。其叶甘，春初可作菜食。甘州者佳，去蒂晒干。"}]},{"ID":"20240607141139-0cygcam","Type":"NodeThematicBreak","Properties":{"id":"20240607141139-0cygcam"}},{"ID":"20240617100935-5er2vbs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617100935-5er2vbs","updated":"20240617100941"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草便读》"}]},{"ID":"20240617100935-gt77zbo","Type":"NodeParagraph","Properties":{"id":"20240617100935-gt77zbo","updated":"20240617100935"},"Children":[{"Type":"NodeText","Data":"性平色赤．养肝补肾益真阴．质润味甘．明目添精退虚热．（枸杞子以甘肃甘州者为上．味甘．子少润泽有脂．其余土产者．子多味苦而劣．不堪用．其性平和．不寒不热．凡子皆降．有收束下行之意．故能入肝肾．生精养血．精血充则目可明．渴可止．筋骨坚利．虚劳等证悉除矣．）"}]},{"ID":"20240617101306-md2q6c1","Type":"NodeThematicBreak","Properties":{"id":"20240617101306-md2q6c1"}},{"ID":"20240617101307-x00af9b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101307-x00af9b","updated":"20240617101311"},"Children":[{"Type":"NodeText","Data":"枸杞子《冯氏锦囊秘录》"}]},{"ID":"20240617101307-yjcz50l","Type":"NodeParagraph","Properties":{"id":"20240617101307-yjcz50l","updated":"20240617101307"},"Children":[{"Type":"NodeText","Data":"感天令春寒之气，兼得乎地之冲气，故味苦甘，气寒，无毒。苗叶苦甘，性升且凉，故主清上焦心肺客热，根名地骨，味甘淡性沉而大寒，故主下焦肝肾虚热，为三焦气分之药，《经》曰“热淫于内，泻以甘寒者”是也。子味甘平，其气微寒，润而滋补，兼能退热而专于补肾，润肺生津益气，为肝肾真阴不足，劳乏内热，补益之要药，《经》曰“精不足者，补之以味”是也。"}]},{"ID":"20240617101307-avr78kj","Type":"NodeParagraph","Properties":{"id":"20240617101307-avr78kj","updated":"20240617101307"},"Children":[{"Type":"NodeText","Data":"枸杞子，主五内邪气，热中消渴，周痹风湿，内伤人劳，下胸胁气，客热头痛，利大小肠，固精髓明目，健筋骨兴阳，补药风药皆用，老人阳虚人尤宜，惟少年有火症者勿用。味甘平而温，气滋润而浓，功专补肾，滋肝益精强阴，不热不燥，久服轻身，能耐寒暑，但脾弱泄泻者必兼苓术相佐。"}]},{"ID":"20240617101307-8nocnz9","Type":"NodeParagraph","Properties":{"id":"20240617101307-8nocnz9","updated":"20240617101307"},"Children":[{"Type":"NodeText","Data":"《经验方》金髓煎，用枸杞子逐日摘红熟者，不拘多少，无灰酒侵之，蜡纸封固，勿令泄气，两月足，取入砂盆中擂烂，滤取汁，同浸酒入银锅内慢火熬之，不住手搅，候成膏如饴，净瓶蜜收，每早温酒二大匙，夜卧再服，百日身轻气壮，积年不辍，可以羽化也。一枸杞酒能乌须黑发，耐老轻身，用枸杞子二升，十月壬癸日，面东采之，以好酒二升，瓷瓶内浸三七日，乃添生地黄汁三升，搅匀蜜封，至立春前三十日，开瓶。"}]},{"ID":"20240617101307-rby8zbs","Type":"NodeParagraph","Properties":{"id":"20240617101307-rby8zbs","updated":"20240617101307"},"Children":[{"Type":"NodeText","Data":"每空心暖饮一杯，立春后髭 发却黑，勿食芜菁葱蒜，观此二方，补阴之功大矣。陶氏云∶“去家千里勿食枸杞”，拈其强阳之功耳。"}]},{"ID":"20240617101307-2l4r6jw","Type":"NodeParagraph","Properties":{"id":"20240617101307-2l4r6jw","updated":"20240617101307"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 五内邪气客热，强阴益精，痘风眼痛，风痒瘴膜。"}]},{"ID":"20240617100935-dbes9rm","Type":"NodeThematicBreak","Properties":{"id":"20240617100935-dbes9rm"}},{"ID":"20240617101432-7ib6u8f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101432-7ib6u8f","updated":"20240617101432"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草蒙筌》"}]},{"ID":"20240617101432-my1uyfn","Type":"NodeParagraph","Properties":{"id":"20240617101432-my1uyfn","updated":"20240617101432"},"Children":[{"Type":"NodeText","Data":"味甘、苦，气微寒。无毒。近道田侧俱有，甘肃州（并属陕西）者独佳。春生嫩苗，作茹爽口。秋结赤实，入药益人。依时采收，曝干选用。紫熟味甜，粗小膏润者有力；赤黯味淡，颗大枯燥者无能。今市家多以蜜拌欺人，不可不细认尔。去净梗蒂，任作散丸。明耳目安神，耐寒暑延寿。添精固髓，健骨强筋。滋阴不致阳衰，兴阳常使阳举。谚云∶离家千里，勿服枸杞，亦以其能助阳也。更止消渴，尤补劳伤。叶捣汁注目中，能除风痒去膜。若作茶啜喉内，亦解消渴强阴。诸毒烦闷善驱，面毒发热立却。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶上虫窠子"},{"Type":"NodeText","Data":"收曝，可同干地黄作丸。不厌酒吞，甚益阳事。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎"},{"Type":"NodeText","Data":"名"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"仙人杖"},{"Type":"NodeText","Data":"须识，皮肤骨节风能追。热毒兼消，疮肿可散。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地骨皮"},{"Type":"NodeText","Data":"者，性甚寒凉。即此根名，惟取皮用。经入少阴肾脏，并手少阳三焦。解传尸有汗，肌去五内邪热，利大小二便。"}]},{"ID":"20240617101432-j7n2oyq","Type":"NodeParagraph","Properties":{"id":"20240617101432-j7n2oyq","updated":"20240617101432"},"Children":[{"Type":"NodeText","Data":"强阴强筋，凉血凉骨。"}]},{"ID":"20240617101432-m1mrav6","Type":"NodeParagraph","Properties":{"id":"20240617101432-m1mrav6","updated":"20240617101432"},"Children":[{"Type":"NodeText","Data":"（谟）按∶本草款中，竹笋立死者，既名仙人杖。此枸杞苗茎，又名仙人杖。藏器《拾遗》篇内，一种菜类，亦名仙人杖。何并此三物而同立一名？古今方书，治疗或有用之，但佥其名而未细注其物者，当考究精详，必得证治相合，庶不失于孟浪也。"}]},{"ID":"20240617101432-maq74z7","Type":"NodeThematicBreak","Properties":{"id":"20240617101432-maq74z7","updated":"20240617101432"}},{"ID":"20240617101054-orvme00","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101054-orvme00","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草易读》"}]},{"ID":"20240617101054-9jsyk0k","Type":"NodeParagraph","Properties":{"id":"20240617101054-9jsyk0k","updated":"20240617101054"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酒润，捣烂用。"}]},{"ID":"20240617101054-al0vstq","Type":"NodeParagraph","Properties":{"id":"20240617101054-al0vstq","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"甘，平，无毒。滋肾润肺，益精明目；坚筋立骨，除风治劳。嗌干心痛最宜，渴饮消中亦效热劳如燎，骨皮三两，柴胡一两，每麦冬汤下二两。（验方第一。）"}]},{"ID":"20240617101054-cmeinyy","Type":"NodeParagraph","Properties":{"id":"20240617101054-cmeinyy","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"带下脉数，骨皮半斤，生地半斤，煮酒服。（第二。）"}]},{"ID":"20240617101054-viovpz8","Type":"NodeParagraph","Properties":{"id":"20240617101054-viovpz8","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"妇人阴肿或有疮，骨皮煎洗。（第三。）"}]},{"ID":"20240617101054-arqli2l","Type":"NodeParagraph","Properties":{"id":"20240617101054-arqli2l","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"骨蒸烦热及一切烦热，骨皮二两，防风一两，炙草半斤，每用姜作引，水煎五钱。（第四．）"}]},{"ID":"20240617101054-0qqqyd3","Type":"NodeParagraph","Properties":{"id":"20240617101054-0qqqyd3","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"赤目生翳，净枸杞取汁点之，神效。（第五。）"}]},{"ID":"20240617101054-atk1ax8","Type":"NodeParagraph","Properties":{"id":"20240617101054-atk1ax8","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"注夏病，枸杞子、五味子研细，滚水泡封三日，代茶饮，甚效。（第六。）"}]},{"ID":"20240617101054-tvwa5hk","Type":"NodeParagraph","Properties":{"id":"20240617101054-tvwa5hk","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"足趾鸡眼骨皮、红花为末，敷之。（第七。）"}]},{"ID":"20240617101054-0hdr4xs","Type":"NodeParagraph","Properties":{"id":"20240617101054-0hdr4xs","updated":"20240617101054"},"Children":[{"Type":"NodeText","Data":"骨槽风，槐米二两、骨皮一两，蜜丸弹大，每服一丸。初起者发汗即愈，溃后者点服。（第八．）"}]},{"ID":"20240617101054-8uu16di","Type":"NodeThematicBreak","Properties":{"id":"20240617101054-8uu16di","updated":"20240617101054"}},{"ID":"20240617101125-ck7bf0b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101125-ck7bf0b","updated":"20240617101131"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草从新》"}]},{"ID":"20240617101125-lmdvtip","Type":"NodeParagraph","Properties":{"id":"20240617101125-lmdvtip","updated":"20240617101125"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滋补肝肾、而润．"}]},{"ID":"20240617101125-w6qyqwo","Type":"NodeParagraph","Properties":{"id":"20240617101125-w6qyqwo","updated":"20240617101125"},"Children":[{"Type":"NodeText","Data":"甘微温．滋肝益肾．（景岳曰∶用之以助熟地、甚妙．）生精助阳．补虚劳．强筋骨．（肝主筋、肾主骨．）养营除烦．去风明目．（肝开窍于目、黑水神光属肾．）利大小肠．治嗌干消渴．（谚云∶离家千里、勿食枸杞、以其色赤、属火、补精壮阳耳、然味甘性润、仍是补水之药、所以能润肾益肝、明目而治消渴也．）便滑者勿用．南方树止数尺．北方并是大树．"}]},{"ID":"20240617101125-sos6gvo","Type":"NodeParagraph","Properties":{"id":"20240617101125-sos6gvo","updated":"20240617101125"},"Children":[{"Type":"NodeText","Data":"以甘州所产．红润少核者佳．酒润捣．"}]},{"ID":"20240617101126-ct40uv2","Type":"NodeThematicBreak","Properties":{"id":"20240617101126-ct40uv2"}},{"ID":"20240617101137-u8emxpq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101137-u8emxpq","updated":"20240617101151"},"Children":[{"Type":"NodeText","Data":"枸杞子《得配本草》"}]},{"ID":"20240617101137-m5dq46r","Type":"NodeParagraph","Properties":{"id":"20240617101137-m5dq46r","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"味甘，微温而润。入足少阴，兼厥阴经血分。补肝经之阴，益肾水之阳。退虚热，益精气，解消渴，去湿风，强筋骨，利二便，下胸胁气，疗痘风眼，止阴虚腰痛，疗肝虚目暗。得麦冬，治干咳。得北五味，生心液。配椒、盐，理肾而除气痛。佐术、苓，补阴而不滑泄。"}]},{"ID":"20240617101137-1p9u64n","Type":"NodeParagraph","Properties":{"id":"20240617101137-1p9u64n","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"甘草汤浸，或好酒浸蒸。恐温热，童便拌蒸。大便滑泄，肾阳盛而遗泄，二者禁用。"}]},{"ID":"20240617101137-bnar4f7","Type":"NodeParagraph","Properties":{"id":"20240617101137-bnar4f7","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"怪症∶胁破肠出，臭秽异常，急用香油摸肠送入，煎杞子加人参服之，再吃羊肾粥，十日而效。"}]},{"ID":"20240617101137-46dlphl","Type":"NodeParagraph","Properties":{"id":"20240617101137-46dlphl","updated":"20240617101137"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苗、叶"}]},{"ID":"20240617101137-vsb6ifr","Type":"NodeParagraph","Properties":{"id":"20240617101137-vsb6ifr","updated":"20240617101137"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"名天精草"}]},{"ID":"20240617101137-p4taxai","Type":"NodeParagraph","Properties":{"id":"20240617101137-p4taxai","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"伏砒砂。"}]},{"ID":"20240617101137-q3r48h5","Type":"NodeParagraph","Properties":{"id":"20240617101137-q3r48h5","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"甘、苦、凉。清上焦心肺客热，代茶止渴。"}]},{"ID":"20240617101137-fv5x8hg","Type":"NodeParagraph","Properties":{"id":"20240617101137-fv5x8hg","updated":"20240617101137"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地骨皮"}]},{"ID":"20240617101137-nipto13","Type":"NodeParagraph","Properties":{"id":"20240617101137-nipto13","updated":"20240617101137"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即杞子根皮"}]},{"ID":"20240617101137-0bnyiru","Type":"NodeParagraph","Properties":{"id":"20240617101137-0bnyiru","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"制硫黄、丹砂。"}]},{"ID":"20240617101137-vxrdj8h","Type":"NodeParagraph","Properties":{"id":"20240617101137-vxrdj8h","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"味淡，性寒。入足少阴、手太阴经血分。降肺中伏火，泻肾虚热。上除风热头风，中平胸胁肝痛，（肝火熄，痛自止。）下利大小肠秘，（热清便自行。）除无定之虚邪，退有汗之骨蒸。"}]},{"ID":"20240617101137-maq1wsj","Type":"NodeParagraph","Properties":{"id":"20240617101137-maq1wsj","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"得生地、甘菊，益肝肾阴血。配青蒿，退虚热。得麦冬、小麦，治骨节虚燔。配红花研末，敷足趾鸡眼，作痛作疮。君生地，治带下。（湿热去也。）"}]},{"ID":"20240617101137-ownp3lw","Type":"NodeParagraph","Properties":{"id":"20240617101137-ownp3lw","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"鲜者，同鲜小蓟煎汁洗，治下疳。鲜者捣碎，煎浓汤淋洗恶疮。脓血不止，更以细白穣贴之即愈。"}]},{"ID":"20240617101137-soah4ym","Type":"NodeParagraph","Properties":{"id":"20240617101137-soah4ym","updated":"20240617101137"},"Children":[{"Type":"NodeText","Data":"去骨热，甘草汤浸一宿，焙干用。刮去粗皮，取细白穣，可贴疮。中寒者禁用。"}]},{"ID":"20240617101138-3b68j14","Type":"NodeThematicBreak","Properties":{"id":"20240617101138-3b68j14"}},{"ID":"20240617101159-xfjaod9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101159-xfjaod9","updated":"20240617101203"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草经解》"}]},{"ID":"20240617101159-vcv8kqz","Type":"NodeParagraph","Properties":{"id":"20240617101159-vcv8kqz","updated":"20240617101159"},"Children":[{"Type":"NodeText","Data":"气寒．味苦．无毒．主五内邪气．热中消渴．周痹风湿．久服坚筋骨．轻身不老．耐寒暑．枸杞子气寒．禀天冬寒之水气．入足少阴肾经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．五内者五脏之内也．邪气者邪热之气也．盖五内为藏阴之地．阴虚所以有热邪也．其主之者．苦寒清热也．心为君火．肾为寒水．水不制火．火烁津液．则病热中消渴．其主之者．味苦可以清热．气寒可以益水也．水益火清．消渴自止．其主周痹风湿者．痹为闭症．血枯不运．而风湿乘之也．治风先治血．血行风湿灭也．杞子苦寒益血．所以治痹．久服苦益心．寒益肾．心肾交．则水火宁而筋骨坚．筋骨健则身自轻．血足则色华．所以不老．耐寒暑者．气寒益肾．肾水足可以耐暑．味苦益心．心火宁可以耐寒也．"}]},{"ID":"20240617101159-2d7nvln","Type":"NodeParagraph","Properties":{"id":"20240617101159-2d7nvln","updated":"20240617101159"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240617101159-m6iu90v","Type":"NodeParagraph","Properties":{"id":"20240617101159-m6iu90v","updated":"20240617101159"},"Children":[{"Type":"NodeText","Data":"杞子同五味．治疰夏．同熟地、白茯、白术．治肾虚目暗．"}]},{"ID":"20240617101159-42dnvsy","Type":"NodeThematicBreak","Properties":{"id":"20240617101159-42dnvsy"}},{"ID":"20240617101208-ck1l6st","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101208-ck1l6st","updated":"20240617101215"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草简要方》"}]},{"ID":"20240617101208-dpbw7gh","Type":"NodeParagraph","Properties":{"id":"20240617101208-dpbw7gh","updated":"20240617101208"},"Children":[{"Type":"NodeText","Data":"地骨皮子主治。清肺肝。润肺补肾。益精治五劳七伤。消渴。消中。经络虚痛。周痹风湿。皮主治。凉血。补血。泻肾火。降肺中伏火。去胞中火。坚筋骨。治风邪在表。"}]},{"ID":"20240617101208-boqtq27","Type":"NodeParagraph","Properties":{"id":"20240617101208-boqtq27","updated":"20240617101208"},"Children":[{"Type":"NodeText","Data":"风湿。脾痛虚劳自汗骨蒸。咳嗽。吐血。骨槽风。金疮。四神丸。甘枸杞一斤。好酒浸作四分。四两用蜀椒一两炒。四两用茴香一两炒。四两用脂麻一两炒。四两用川楝肉一两炒。拣出枸杞。加熟地白术白茯苓各一两。研末。蜜丸梧子大。空腹温酒下三十丸。治肾虚目昏。"}]},{"ID":"20240617101208-4fnqnkw","Type":"NodeParagraph","Properties":{"id":"20240617101208-4fnqnkw","updated":"20240617101208"},"Children":[{"Type":"NodeText","Data":"或云翳遮睛。枸杞丸。枸杞子黄精各等分。研末。蜜丸梧子大。每服五十丸。空腹温酒下。补精气。枸杞酒。枸杞子生地浸酒服。除冷风。壮阳道。治虚弱目泪。地骨皮丸。地骨皮黄桑白皮。山栀子马兜铃各等分。研末。甘草膏和丸芡实大。每服一丸。噙化。治肺脏壅热口臭粘腻。又方。地骨皮紫参黄大黄（微炒）郁李仁（微炒）各五钱。龙胆黄芩枳壳（麸炒）木香猪苓海蛤（细研）各一分。研末。蜜丸绿豆大。每服五丸。治脊疳。地骨皮散。"}]},{"ID":"20240617101208-46h7m2d","Type":"NodeParagraph","Properties":{"id":"20240617101208-46h7m2d","updated":"20240617101208"},"Children":[{"Type":"NodeText","Data":"地骨皮知母炙草半夏柴胡人参赤茯苓各等分。研末。每服二钱。水煎加生姜服。治虚热作渴。伤寒壮热余热。又方。地骨皮柴胡各一两。桑白皮（炒）枳壳（麸炒）前胡黄（炒）各七钱五分。白茯苓五加皮人参甘草桂心白芍各五钱。咀。每服三五钱。加生姜水煎服。治妇人血风。气体虚弱。寒热发渴。或晡热内热。地骨皮汤。地骨皮生地麦冬黄山药五味子淡竹叶。水煎服。治心虚热。又方。四物汤加地骨皮丹皮各三钱。治阴虚火旺。骨蒸发热。"}]},{"ID":"20240617101208-4vlvouq","Type":"NodeParagraph","Properties":{"id":"20240617101208-4vlvouq","updated":"20240617101208"},"Children":[{"Type":"NodeText","Data":"日静夜剧。妇人热入血室。胎前发热。"}]},{"ID":"20240617101209-9g7j2d4","Type":"NodeThematicBreak","Properties":{"id":"20240617101209-9g7j2d4"}},{"ID":"20240617101220-bifc7zf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101220-bifc7zf","updated":"20240617101224"},"Children":[{"Type":"NodeText","Data":"枸杞子《本草备要》"}]},{"ID":"20240617101220-og9kk9n","Type":"NodeParagraph","Properties":{"id":"20240617101220-og9kk9n","updated":"20240617101220"},"Children":[{"Type":"NodeText","Data":"平补而润"}]},{"ID":"20240617101220-jixsin5","Type":"NodeParagraph","Properties":{"id":"20240617101220-jixsin5","updated":"20240617101220"},"Children":[{"Type":"NodeText","Data":"甘平（《本草》苦寒）。润肺清肝，滋肾益气，生精助阳，补虚劳，强筋骨（肝主筋，肾主骨），去风明目（目为肝窍，瞳子属肾），利大小肠。治嗌干消渴（昂按∶古谚有云，出家千里，勿食枸杞。其色赤属火，能补精壮阳。然气味甘寒而性润，仍是补水之药，所以能滋肾、益肝、明目而治消渴也）。"}]},{"ID":"20240617101220-zr8bn1c","Type":"NodeParagraph","Properties":{"id":"20240617101220-zr8bn1c","updated":"20240617101220"},"Children":[{"Type":"NodeText","Data":"南方树高数尺，北方并是大树。以甘州所产、红润少核者良。酒浸捣用。根名地骨皮（见下）。"}]},{"ID":"20240617101220-7phz5h3","Type":"NodeParagraph","Properties":{"id":"20240617101220-7phz5h3","updated":"20240617101220"},"Children":[{"Type":"NodeText","Data":"叶，名天精草，苦甘而凉。清上焦心、肺客热，代茶止消渴（时珍曰∶皆三焦气分之药）。"}]},{"ID":"20240617101221-nvywsuu","Type":"NodeThematicBreak","Properties":{"id":"20240617101221-nvywsuu"}},{"ID":"20240617101415-z1th5ni","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101415-z1th5ni","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"枸杞子《中药学》"}]},{"ID":"20240617101415-s7e9ybo","Type":"NodeParagraph","Properties":{"id":"20240617101415-s7e9ybo","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为茄科植物宁夏枸杞的成熟果实。"}]},{"ID":"20240617101415-51lgs80","Type":"NodeParagraph","Properties":{"id":"20240617101415-51lgs80","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，平。入肝、肾经。"}]},{"ID":"20240617101415-kyi6yjh","Type":"NodeParagraph","Properties":{"id":"20240617101415-kyi6yjh","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【功效】补肾益精，养肝明目。"}]},{"ID":"20240617101415-40xnyid","Type":"NodeParagraph","Properties":{"id":"20240617101415-40xnyid","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于肝肾不足，遗精，腰膝酸痛，以及头晕、目眩等症。"}]},{"ID":"20240617101415-mu9k6wo","Type":"NodeParagraph","Properties":{"id":"20240617101415-mu9k6wo","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"枸杞子有补益肝肾之功，不论肾阴虚亏或肾阳不足，皆可应用。治肾虚遗精等症，常与巴戟天、肉苁蓉、潼蒺藜等配伍应用；用于头晕目昏等症，可与菊花、地黄、山萸肉等配伍。"}]},{"ID":"20240617101415-6uapso5","Type":"NodeParagraph","Properties":{"id":"20240617101415-6uapso5","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【处方用名】甘杞子、枸杞子（洗净，晒干用）。"}]},{"ID":"20240617101415-1bkyjla","Type":"NodeParagraph","Properties":{"id":"20240617101415-1bkyjla","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240617101415-t0r3oeq","Type":"NodeParagraph","Properties":{"id":"20240617101415-t0r3oeq","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【按语】1.枸杞子味甘性平，柔润多液，是一味补养肝肾的药品，功与潼蒺藜、菟丝子相近似。然根据临床实践体会，潼蒺藜、菟丝子、枸杞子三药虽都是平补阴阳之品，但潼蒺藜、菟丝子两药助阳之功胜于养阴，故归入助阳药；枸杞子则滋阴之功胜于助阳，且补益作用较佳。本品配以熟地，则补肝滋肾；配以菊花，则养肝明目；配以黄精，则补精益气。凡肝肾不足的疾患，都可配用。"}]},{"ID":"20240617101415-vhpf966","Type":"NodeParagraph","Properties":{"id":"20240617101415-vhpf966","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"2.据古代文献记载，本品可用治消渴。现民间验方单用枸杞子一味，蒸熟嚼食，每次一钱，每日二至三次，治糖尿病症情较轻者，有一定疗效。"}]},{"ID":"20240617101415-n4nqa2l","Type":"NodeParagraph","Properties":{"id":"20240617101415-n4nqa2l","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"3.本品虽为临床常用药物，但如有外邪实热、脾虚湿滞及肠滑便溏者，不宜应用。"}]},{"ID":"20240617101415-y06vbmn","Type":"NodeParagraph","Properties":{"id":"20240617101415-y06vbmn","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【方剂举例】杞菊地黄丸《医级》：枸杞子、菊花、熟地、山茱萸、山药，茯苓、牡丹皮、泽泻。治肝肾不足，头晕目眩，久视昏暗。"}]},{"ID":"20240617101415-el2mfi4","Type":"NodeParagraph","Properties":{"id":"20240617101415-el2mfi4","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《食疗本草》：「坚筋骨....除风去虚劳，补精气。」"}]},{"ID":"20240617101415-g67c2gp","Type":"NodeParagraph","Properties":{"id":"20240617101415-g67c2gp","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"《汤液本草》：「主心病嗌干....渴而引饮，肾病消中。」"}]},{"ID":"20240617101415-w2ny4dj","Type":"NodeParagraph","Properties":{"id":"20240617101415-w2ny4dj","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「能补肾润肺，生精益气，此乃平补之药，所谓精不足者补之以味也。」"}]},{"ID":"20240617101415-lmb3vnx","Type":"NodeParagraph","Properties":{"id":"20240617101415-lmb3vnx","updated":"20240617101415"},"Children":[{"Type":"NodeText","Data":"《本草图解》：「补肾益精....，而消渴、目昏而腰痛膝痛，无不愈矣。」"}]},{"ID":"20240617101415-2pcucx0","Type":"NodeThematicBreak","Properties":{"id":"20240617101415-2pcucx0","updated":"20240617101415"}}]}