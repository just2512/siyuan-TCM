{"ID":"20240205165635-3bbaq4i","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240205165635-3bbaq4i","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205165635-3bbaq4i\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240621101548-xjnryrx\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611083227-p7k33h9\u0026quot;,\u0026quot;scrollTop\u0026quot;:1500,\u0026quot;focusId\u0026quot;:\u0026quot;20240621102600-bd7202f\u0026quot;,\u0026quot;focusStart\u0026quot;:6,\u0026quot;focusEnd\u0026quot;:6\u0026#125;","title":"122蜂子、蜂蜜、蜂蜡","type":"doc","updated":"20240811162910"},"Children":[{"ID":"20240621101548-xjnryrx","Type":"NodeParagraph","Properties":{"id":"20240621101548-xjnryrx","updated":"20240621101552"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜂子"}]},{"ID":"20240811162332-cfc8444","Type":"NodeParagraph","Properties":{"id":"20240811162332-cfc8444","updated":"20240811162332"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 677px;","style":"width: 667px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜂子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜂子-20240811162332-gmbsv3a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 667px;\" parent-style=\"width: 677px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811162442-6noocsk","Type":"NodeParagraph","Properties":{"id":"20240811162442-6noocsk","updated":"20240811162442"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 678px;","style":"width: 668px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜂子 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜂子 1-20240811162442-euzs