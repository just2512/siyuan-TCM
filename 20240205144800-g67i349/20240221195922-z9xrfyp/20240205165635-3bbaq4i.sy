dth: 785px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜜蜂 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜜蜂 8-20240726110228-2xe3olc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 785px;\" parent-style=\"width: 795px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726112505-0nwhpuf","Type":"NodeParagraph","Properties":{"id":"20240726112505-0nwhpuf","updated":"20240811162859"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 590px;","style":"width: 580px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山蜂"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山蜂-20240726104859-qovig5s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 580px;\" parent-style=\"width: 590px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 591px;","style":"width: 581px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山蜂 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山蜂 1-20240726104922-jiqyvnl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 581px;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726112505-4hu54n5","Type":"NodeParagraph","Properties":{"id":"20240726112505-4hu54n5","updated":"20240811162905"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 491px;","style":"width: 481px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜜蜂 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜜蜂 6-20240726105913-69xc5hk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 481px;\" parent-style=\"width: 491px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 664px;","style":"width: 654px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜜蜂 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜜蜂 5-20240726105807-4ibyhwz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 654px;\" parent-style=\"width: 664px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726112505-5ubcyoe","Type":"NodeParagraph","Properties":{"id":"20240726112505-5ubcyoe","updated":"20240811162910"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 401px;","style":"width: 391px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜜蜂 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜜蜂 4-20240726105723-y50kbab.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 391px;\" parent-style=\"width: 401px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 794px;","style":"width: 784px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜜蜂 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜜蜂 2-20240726105453-geznfhw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 784px;\" parent-style=\"width: 794px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611083226-bs2pfum","Type":"NodeParagraph","Properties":{"id":"20240611083226-bs2pfum","updated":"20240621101920"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：蜂子为蜜蜂的蛹，蜂蜜即蜜蜂酿制的蜜，蜂蜡即构成蜂巢的蜡质。"}]},{"ID":"20240611083354-qozj0kn","Type":"NodeThematicBreak","Properties":{"id":"20240611083354-qozj0kn"}},{"ID":"20240611083431-1t1mrmf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083431-1t1mrmf","updated":"20240611083437"},"Children":[{"Type":"NodeText","Data":"蜂子《神农本草经》"}]},{"ID":"20240611083431-8s5thmx","Type":"NodeParagraph","Properties":{"id":"20240611083431-8s5thmx","updated":"20240611083431"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240611083431-0b9vub2","Type":"NodeParagraph","Properties":{"id":"20240611083431-0b9vub2","updated":"20240611083431"},"Children":[{"Type":"NodeText","Data":"主风头，除蛊毒，补虚羸伤中。久服，令人光泽，好颜色，不老，大黄蜂子，主心腹，复满痛，轻身益气，土蜂子，主痈肿。一名蜚零。生山谷。"}]},{"ID":"20240611083431-clxj8f7","Type":"NodeParagraph","Properties":{"id":"20240611083431-clxj8f7","updated":"20240611083431"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生武都。"}]},{"ID":"20240611083431-77m6b2w","Type":"NodeParagraph","Properties":{"id":"20240611083431-77m6b2w","updated":"20240611083431"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蜂，飞虫螫人者。古文省作蜂。《广雅》云：蠓，蜂也。又上蜂，螉也。《尔雅》云：土蜂。郭璞云：今江南大蜂在地中作房者为土蜂，啖其子即马蜂，今荆巴间呼为蟺，又木蜂。郭璞云：似土蜂而小，在树上作房，江东亦呼为木蜂，又食其子。礼记檀弓云：范则冠。郑云：范蜂也。方言云：蜂，燕赵之间，谓"}]},{"ID":"20240611083431-dtjh74g","Type":"NodeParagraph","Properties":{"id":"20240611083431-dtjh74g","updated":"20240611083431"},"Children":[{"Type":"NodeText","Data":"之蠓螉，其小者，谓之螉，或谓之蚴蜕，其大而蜜。谓之壶蜂。郭璞云：今黑蜂，穿竹木作孔，亦有蜜者，或呼笛师，按蜂名为范者声相近，若《司马相如赋》，以泛为枫。左传：沨沨即汛汛也。"}]},{"ID":"20240611083628-08xow7e","Type":"NodeThematicBreak","Properties":{"id":"20240611083628-08xow7e"}},{"ID":"20240611083629-qasjp2w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083629-qasjp2w","updated":"20240611083635"},"Children":[{"Type":"NodeText","Data":"蜂子《证类本草》"}]},{"ID":"20240611083629-kz69qbt","Type":"NodeParagraph","Properties":{"id":"20240611083629-kz69qbt","updated":"20240611083629"},"Children":[{"Type":"NodeText","Data":"味甘，平、微寒，无毒。主风头，除蛊毒，补虚羸，伤中，心腹痛，大人、小儿腹中五虫口吐出者，面目黄。久服令人光泽好颜色，不老，轻身，益气。"}]},{"ID":"20240611083629-veb73dq","Type":"NodeParagraph","Properties":{"id":"20240611083629-veb73dq","updated":"20240611083629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄蜂子"},{"Type":"NodeText","Data":"主心腹胀满痛，干呕，轻身益气。"}]},{"ID":"20240611083629-7wnicp7","Type":"NodeParagraph","Properties":{"id":"20240611083629-7wnicp7","updated":"20240611083629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"土蜂子"},{"Type":"NodeText","Data":"主痈肿，嗌（音益）喉也痛。一名蜚零。生武都山谷。畏黄芩、芍药、牡蛎。"}]},{"ID":"20240611083629-4zil5u8","Type":"NodeParagraph","Properties":{"id":"20240611083629-4zil5u8","updated":"20240611083629"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶前直云蜂子，即应是蜜蜂子也。取其未成头足时炒食之。又，酒渍以敷面，令面悦白。黄蜂则人家屋上者及 （音候） 蜂也。今按陈藏器本草云∶蜂子，主丹毒，风疹，腹内留热，大小便涩，去浮血，妇人带下，下乳汁，此即蜜房中白如蛹者。其穴居者名土蜂，最大，螫人至死，其子亦大、白，功用同蜜蜂子也。臣禹锡等谨按陈藏器云∶按土蜂赤黑色，有毒。利大小便，治妇人带下病等。又有食之者，须以冬瓜及苦 、生姜、紫苏，以制其毒也。"}]},{"ID":"20240611083629-5mzbeiv","Type":"NodeParagraph","Properties":{"id":"20240611083629-5mzbeiv","updated":"20240611083629"},"Children":[{"Type":"NodeText","Data":"图经曰∶蜂，《本经》有蜂子、黄蜂、土蜂，而土蜂下云∶生武都山谷，今处处皆有之。"}]},{"ID":"20240611083629-z7prz4s","Type":"NodeParagraph","Properties":{"id":"20240611083629-z7prz4s","updated":"20240611083629"},"Children":[{"Type":"NodeText","Data":"蜂子，即蜜蜂子也。在蜜脾中，如蛹而白色。大黄蜂子，即人家屋上作房及大木间 （音候）"}]},{"ID":"20240611083629-m239cwj","Type":"NodeParagraph","Properties":{"id":"20240611083629-m239cwj","updated":"20240611083629"},"Children":[{"Type":"NodeText","Data":"（音娄）蜂子也。岭南人亦作馔食之。蜂并黄色，比蜜蜂更大。土蜂子，即穴土居者，其蜂最大，螫人或至死。凡用蜂子，并取头足未成者佳。谨按《岭表录异》载宣、歙人取蜂子法，大蜂结房于山林间，大如巨钟，其中数百层，土人采时，须以草衣蔽体，以捍其毒螫，复以烟火熏散蜂母，乃敢攀缘崖木，断其蒂。一房蜂子或五、六斗至一石，以盐炒曝干，寄入京洛，以为方物。然房中蜂子，三分之一翅足已成，则不堪用。详此木上作房，盖 类也。而今宣城蜂子乃掘地取之，似土蜂也。故郭璞注《尔雅》土蜂云∶今江东呼大蜂在地中作房马蜂。荆、巴间呼为 （音惮）。又注木蜂云∶似土蜂而小，在木上作房，江东人亦呼木蜂，人食其子。然则二蜂子皆可食久矣。大抵蜂类皆同科，其性效不相远矣。"}]},{"ID":"20240611083629-7t904j1","Type":"NodeParagraph","Properties":{"id":"20240611083629-7t904j1","updated":"20240611083629"},"Children":[{"Type":"NodeText","Data":"礼记曰爵、 、蜩、范，注云∶蜩，蝉也。范，蜂也。"}]},{"ID":"20240611083701-qwin9aq","Type":"NodeThematicBreak","Properties":{"id":"20240611083701-qwin9aq"}},{"ID":"20240611083702-5uwaapy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083702-5uwaapy","updated":"20240611083709"},"Children":[{"Type":"NodeText","Data":"蜂子《神农本草经赞》"}]},{"ID":"20240611083702-ekn4fak","Type":"NodeParagraph","Properties":{"id":"20240611083702-ekn4fak","updated":"20240611083702"},"Children":[{"Type":"NodeText","Data":"味甘平。主头风。除蛊毒。补虚羸伤中。久服令人光泽好颜色不老。大黄蜂子。主心腹复满痛。轻身益气。土蜂子。主痈肿。一名蜚零。生山谷。"}]},{"ID":"20240611083702-lsszf92","Type":"NodeParagraph","Properties":{"id":"20240611083702-lsszf92","updated":"20240611083702"},"Children":[{"Type":"NodeText","Data":"类自殊形。尾皆垂颖。冯木虚悬。泥幽屏。毒菌生光。丛桑匿影。白蛹蚕莹。馈来荒憬。"}]},{"ID":"20240611083702-1pd2ow4","Type":"NodeParagraph","Properties":{"id":"20240611083702-1pd2ow4","updated":"20240611083702"},"Children":[{"Type":"NodeText","Data":"欧阳修赋。异类殊形。埤雅。蜂毒在尾。垂颖如锋。曹植赋。上不冯木。陶弘景碑。七度虚悬。苏颂曰。大黄蜂子作房在大木间。埤雅。土蜂好泥作房。韩愈诗。即此是幽屏。酉阳杂俎。岭南毒菌。夜有光。经雨即腐。化为蜂。水经注。延水有桑林为丛桑河。云笈七签。"}]},{"ID":"20240611083702-2sxus3f","Type":"NodeParagraph","Properties":{"id":"20240611083702-2sxus3f","updated":"20240611083702"},"Children":[{"Type":"NodeText","Data":"隐地八术。一曰藏形匿影。诗疏。蒲芦负桑虫。以成其子。岭表录异。蜂儿拣状如蚕蛹。莹白者盐炒曝干。寄京洛以为方物。贺知章诗。荒憬尽怀忠。"}]},{"ID":"20240611083648-x94t6qi","Type":"NodeThematicBreak","Properties":{"id":"20240611083648-x94t6qi"}},{"ID":"20240611083649-w0xizip","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083649-w0xizip","updated":"20240611083654"},"Children":[{"Type":"NodeText","Data":"蜂子《千金翼方》"}]},{"ID":"20240611083649-8t2dk9k","Type":"NodeParagraph","Properties":{"id":"20240611083649-8t2dk9k","updated":"20240611083649"},"Children":[{"Type":"NodeText","Data":"味甘，平，微寒，无毒。主风头，除蛊毒，补虚羸伤中，心腹痛，大人小儿腹中五虫口吐出者，面目黄。久服令人光泽，好颜色，不老，轻身益气。"}]},{"ID":"20240611083616-ggwlokr","Type":"NodeThematicBreak","Properties":{"id":"20240611083616-ggwlokr"}},{"ID":"20240611083617-xgupnpf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083617-xgupnpf","updated":"20240611083622"},"Children":[{"Type":"NodeText","Data":"蜂子《本草经集注》"}]},{"ID":"20240611083617-ia6i301","Type":"NodeParagraph","Properties":{"id":"20240611083617-ia6i301","updated":"20240611083617"},"Children":[{"Type":"NodeText","Data":"味甘，平、微寒，无毒。主治风头，除蛊毒，补虚羸，伤中。治心腹痛，大人小儿腹中五虫口吐出者，面目黄。久服令人光泽，好颜色，不老。轻身益气。大黄蜂子∶主治心腹胀满痛，干呕，轻身益气。土蜂子∶主治痈肿，嗌痛。一名蜚零。生武都山谷。（畏黄芩、芍药、牡蛎。）"}]},{"ID":"20240611083617-mx3pwjl","Type":"NodeParagraph","Properties":{"id":"20240611083617-mx3pwjl","updated":"20240611083617"},"Children":[{"Type":"NodeText","Data":"前直云蜂子，即应是蜜蜂子也，取其未成头足时炒食之；又酒渍以敷面，令面悦白。黄蜂?"}]},{"ID":"20240611083354-stzh0zl","Type":"NodeThematicBreak","Properties":{"id":"20240611083354-stzh0zl"}},{"ID":"20240611083406-mwckipq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083406-mwckipq","updated":"20240611083447"},"Children":[{"Type":"NodeText","Data":"蜂子《医学入门》"}]},{"ID":"20240611083406-pq02hbc","Type":"NodeParagraph","Properties":{"id":"20240611083406-pq02hbc","updated":"20240611083406"},"Children":[{"Type":"NodeText","Data":"蜂子微寒俱有毒，止呕利便和心腹，土蜂消肿制蜘蛛，蜜主吐虫黄面目， 止咳治久聋，房医霍乱乳调服。"}]},{"ID":"20240611083406-zsh6jj5","Type":"NodeParagraph","Properties":{"id":"20240611083406-zsh6jj5","updated":"20240611083406"},"Children":[{"Type":"NodeText","Data":"蜂，尾尖利有锋芒也，俱取其房中白如蛹，未成头足时炒用之，亦可以盐炒，日干，寄入京、洛以为方物。"}]},{"ID":"20240611083406-0tuaitt","Type":"NodeParagraph","Properties":{"id":"20240611083406-0tuaitt","updated":"20240611083406"},"Children":[{"Type":"NodeText","Data":"食之者，须以冬瓜、苦 、姜苏以制其毒。大黄蜂，即人家屋上及大木间作房者，专主干呕，心腹胀痛，利大小便。土蜂，即土穴居者。主痈，嗌痛。又烧灰油调敷蜘蛛咬。此物能食蜘蛛，亦取其相制也。蜜蜂，味甘，主大小、小儿腹中五虫口吐出者，面目黄，补虚羸伤中，久服益气轻身，令人光泽，兼治头风蛊毒、丹毒风疹、腹内留热、大小便闭，去浮血、妇人带下，下乳汁。大抵蜂类，性效皆不相远。畏黄芩、芍药、牡蛎。 ，处处有之。黑色而细腰，虽名土蜂，而不在土中作穴。但HT 土于人家壁间，或器物傍作房如竹管，取他虫于房中化为已子，《诗》云，螟蛉有子，蜾蠃负之是也。味辛、平，有毒。主久聋，咳逆，呕逆，毒瓦斯出汗。疗鼻，生捣 竹木刺。入药妙用。其土房主痈肿风头，小儿霍乱吐泻，微炙为末，乳汁下一字即止。又研细醋调，涂蜂螫。"}]},{"ID":"20240611083731-yimk61w","Type":"NodeThematicBreak","Properties":{"id":"20240611083731-yimk61w"}},{"ID":"20240611083828-0wfbws3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083828-0wfbws3","updated":"20240611083834"},"Children":[{"Type":"NodeText","Data":"蜂蜜《中药学》"}]},{"ID":"20240611083828-et3a2j4","Type":"NodeParagraph","Properties":{"id":"20240611083828-et3a2j4","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"【药用】本品为蜜蜂科昆虫中华蜜蜂等酿成的糖类物质。"}]},{"ID":"20240611083828-o82l7fy","Type":"NodeParagraph","Properties":{"id":"20240611083828-o82l7fy","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，平。入肺、脾、大肠经。"}]},{"ID":"20240611083828-0bkppvx","Type":"NodeParagraph","Properties":{"id":"20240611083828-0bkppvx","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"【功效】滑肠通便，补肺润中，缓急，解毒。"}]},{"ID":"20240611083828-j4fn2ap","Type":"NodeParagraph","Properties":{"id":"20240611083828-j4fn2ap","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肠燥便秘。"}]},{"ID":"20240611083828-uwlkqjt","Type":"NodeParagraph","Properties":{"id":"20240611083828-uwlkqjt","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"本品甘而滋润，能滑利大肠，内服能使大肠通畅。对肠燥便秘，体虚而不宜用攻下药者，甚为适宜。"}]},{"ID":"20240611083828-wke2sh8","Type":"NodeParagraph","Properties":{"id":"20240611083828-wke2sh8","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"2.用于肺燥干咳，肺虚久咳，喉干口燥等症。"}]},{"ID":"20240611083828-o924bqi","Type":"NodeParagraph","Properties":{"id":"20240611083828-o924bqi","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"本品有润肺滋养作用，故对干咳、久咳等症，在使用化痰止咳药如枇杷叶、款冬花、紫菀、百部等时，常用本品拌炒（即蜜炙）；又如治虚劳干咳、咯血的琼玉膏，即用本品与鲜生地、茯苓、人参配制而成。又因它能滋补脾胃，故滋补丸药用蜜丸者甚多，不仅取其矫味及黏性，同时还取它的缓和药性与补养作用。"}]},{"ID":"20240611083828-n56rcyk","Type":"NodeParagraph","Properties":{"id":"20240611083828-n56rcyk","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"此外，本品还可以用解乌头毒。"}]},{"ID":"20240611083828-pt2ldsn","Type":"NodeParagraph","Properties":{"id":"20240611083828-pt2ldsn","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"【处方用名】蜂蜜、白蜜、炼蜜（即经过熬制，在做丸药时应用）"}]},{"ID":"20240611083828-ijtd2ef","Type":"NodeParagraph","Properties":{"id":"20240611083828-ijtd2ef","updated":"20240611083828"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至一两，用开水冲服。"}]},{"ID":"20240611083837-0b1a4lg","Type":"NodeThematicBreak","Properties":{"id":"20240611083837-0b1a4lg"}},{"ID":"20240611083843-0lxw43s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083843-0lxw43s","updated":"20240611083848"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草纲目》"}]},{"ID":"20240611083843-lynfij4","Type":"NodeParagraph","Properties":{"id":"20240611083843-lynfij4","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"「释名」蜂糖。生岩石者名石蜜、石饴、岩蜜。"}]},{"ID":"20240611083843-adlbgjs","Type":"NodeParagraph","Properties":{"id":"20240611083843-adlbgjs","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"「气味」甘、平、无毒。"}]},{"ID":"20240611083843-zcxnowf","Type":"NodeParagraph","Properties":{"id":"20240611083843-zcxnowf","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611083843-hihj56c","Type":"NodeParagraph","Properties":{"id":"20240611083843-hihj56c","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"1、大便不通。用蜜二合，微为煎至饴糖状，乘热做成挺，长一寸们一端尖细。待冷变硬后，寒入肛门中，不久即可通便。"}]},{"ID":"20240611083843-s9wie4d","Type":"NodeParagraph","Properties":{"id":"20240611083843-s9wie4d","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"2、产后口渴。用炼蜜不限量，熟水调服即止。"}]},{"ID":"20240611083843-qabbbr1","Type":"NodeParagraph","Properties":{"id":"20240611083843-qabbbr1","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"3、隐疹作痒。用蜂蜜不限量，好酒调服。"}]},{"ID":"20240611083843-6x02yv9","Type":"NodeParagraph","Properties":{"id":"20240611083843-6x02yv9","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"4、五色丹毒。用蜂蜜调干姜末敷涂。"}]},{"ID":"20240611083843-542nd00","Type":"NodeParagraph","Properties":{"id":"20240611083843-542nd00","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"5、口中生疮。用蜂蜜浸大青叶含咽。"}]},{"ID":"20240611083843-tbgzqko","Type":"NodeParagraph","Properties":{"id":"20240611083843-tbgzqko","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"6、龟头生疮。用蜂蜜煎甘草涂搽。"}]},{"ID":"20240611083843-ox191vr","Type":"NodeParagraph","Properties":{"id":"20240611083843-ox191vr","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"7、肛门生疮（肛门主肺，肺热则肛门肿缩生疮），用蜂蜜一斤，调入猪胆汁一枚，微火煎浓，做成挺子，塞肛六内，令通泄即愈。"}]},{"ID":"20240611083843-t87hzls","Type":"NodeParagraph","Properties":{"id":"20240611083843-t87hzls","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"8、热油烫烧。用蜂蜜涂搽。"}]},{"ID":"20240611083843-2xio7ka","Type":"NodeParagraph","Properties":{"id":"20240611083843-2xio7ka","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"9、疔肿恶毒。用生蜜与隔年葱研成膏。把疔刺破涂上，半小时后，以热醋洗去"}]},{"ID":"20240611083843-h4ej47x","Type":"NodeParagraph","Properties":{"id":"20240611083843-h4ej47x","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"10、大风癞疮。用生姜二斤，捣取汁，拌入蜂蜜一斤中，微火煎浓，收存。每日清晨服枣大一丸，温酒送下，一天服在次，忌生冷醋滑等物。"}]},{"ID":"20240611083843-w5pl62r","Type":"NodeParagraph","Properties":{"id":"20240611083843-w5pl62r","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"11、脸上斑点。用蜂蜜调茯苓末敷搽。"}]},{"ID":"20240611083843-5uo7jq0","Type":"NodeParagraph","Properties":{"id":"20240611083843-5uo7jq0","updated":"20240611083843"},"Children":[{"Type":"NodeText","Data":"12、目生珠管。用生蜜涂目。仰卧半日再洗去。每天一次。"}]},{"ID":"20240611083850-1v32mlh","Type":"NodeThematicBreak","Properties":{"id":"20240611083850-1v32mlh"}},{"ID":"20240611083856-vdukw5j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083856-vdukw5j","updated":"20240611083901"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草新编》"}]},{"ID":"20240611083856-moeizpa","Type":"NodeParagraph","Properties":{"id":"20240611083856-moeizpa","updated":"20240611083856"},"Children":[{"Type":"NodeText","Data":"蜜，味甘，气平、微温，无毒。益气温中，润燥解毒，养脾胃，却痫痉，止肠癖，除口疮、心腹猝痛，补五脏不足，通大便久闭。此采百花而酿成，自然补益。但可丸药中用之，入汤剂内，止润大肠也。"}]},{"ID":"20240611083856-cn5du6z","Type":"NodeParagraph","Properties":{"id":"20240611083856-cn5du6z","updated":"20240611083856"},"Children":[{"Type":"NodeText","Data":"或问蜜有黄、白之分，其功用同乎？曰∶世人以白蜜为上。不知采黄花则蜜黄，采白花则蜜白。黄胜于白，而世人未知也。盖花黄者得中州之气，花白者得西方之气耳。"}]},{"ID":"20240611083907-vkngxpr","Type":"NodeThematicBreak","Properties":{"id":"20240611083907-vkngxpr"}},{"ID":"20240611083908-zi4jca1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083908-zi4jca1","updated":"20240611083913"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草从新》"}]},{"ID":"20240611083908-kd4cxal","Type":"NodeParagraph","Properties":{"id":"20240611083908-kd4cxal","updated":"20240611083908"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俗名蜂糖、生岩石者、名岩蜜、亦名石蜜．补中、润燥滑肠．"}]},{"ID":"20240611083908-npmkm8u","Type":"NodeParagraph","Properties":{"id":"20240611083908-npmkm8u","updated":"20240611083908"},"Children":[{"Type":"NodeText","Data":"采百花之精英．合露气以酿成．生性凉．能清热．熟性温．能补中．甘而和．故能解毒．"}]},{"ID":"20240611083908-74uqggq","Type":"NodeParagraph","Properties":{"id":"20240611083908-74uqggq","updated":"20240611083908"},"Children":[{"Type":"NodeText","Data":"柔而滑．故能润燥．甘缓可以去急．故止心腹肌肉疮疡诸痛．甘缓可以和中．故能调营卫．通三焦．安五脏．和百药．而与甘草同功．止嗽治痢．（解毒润肠、最治痢疾、用姜汁和服、甚佳．）明目悦颜．同薤白捣．涂汤火伤．煎炼成胶．通大便秘．（乘热纳谷道中、名蜜煎导．）大肠虚滑者．虽熟蜜亦在禁例．酸者食之．令人心烦．同葱食害人．食蜜饮后．不可食．令人暴亡．白如膏者良．（汪颖曰∶蜜以花为主、闽广蜜热、川蜜温、西蜜凉、安宣州有黄连蜜、味小苦、点目热、良、西京有梨花蜜、色白如脂．）用银石器．每蜜一斤．入水四两．桑火慢熬．掠去浮沫．至滴水成珠用．黄蜡、甘淡而涩．微温．止痛生肌．疗下痢．（蜜质柔性润、故滑肠胃、蜡质坚性涩、故止泻痢．）续绝伤．（蜜与蜡、皆蜂所酿成、而蜜味至甘、蜡味至淡、故今人言无味者、谓之嚼蜡．）"}]},{"ID":"20240611083915-zi4vrrt","Type":"NodeThematicBreak","Properties":{"id":"20240611083915-zi4vrrt"}},{"ID":"20240611083922-p6jhpqu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083922-p6jhpqu","updated":"20240611083929"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草备要》"}]},{"ID":"20240611083922-whcig3y","Type":"NodeParagraph","Properties":{"id":"20240611083922-whcig3y","updated":"20240611083922"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"亦名石蜜、岩蜜"}]},{"ID":"20240611083922-4od6ii1","Type":"NodeParagraph","Properties":{"id":"20240611083922-4od6ii1","updated":"20240611083922"},"Children":[{"Type":"NodeText","Data":"补中，润燥，滑肠"}]},{"ID":"20240611083922-s9xnjc3","Type":"NodeParagraph","Properties":{"id":"20240611083922-s9xnjc3","updated":"20240611083922"},"Children":[{"Type":"NodeText","Data":"草木精英，合露气以酿成。生性凉，能清热；熟性温，能补中。甘而和，故解毒。柔而滑，故润燥。甘缓可以去急，故止心腹、肌肉、疮疡诸痛；甘缓可以和中，故能调营卫，通三焦，除众病，和百药（故丸药多用之），而与甘草同功。止嗽治痢（解毒润肠，最治痢疾。"}]},{"ID":"20240611083922-ppqgckx","Type":"NodeParagraph","Properties":{"id":"20240611083922-ppqgckx","updated":"20240611083922"},"Children":[{"Type":"NodeText","Data":"姜汁和服甚佳），明目悦颜。同薤白捣，涂汤火伤。煎炼成胶，通大便秘（乘热纳谷道中，名蜜煎导）。然能滑肠，泄泻与中满者忌用之。以白如膏者良（汪颖曰∶蜜以花为主。闽广蜜热，川蜜温，西蜜凉。安宣州有黄连蜜，味小苦，点目热良。西京有梨花蜜，色白如脂）。"}]},{"ID":"20240611083922-5qm8cno","Type":"NodeParagraph","Properties":{"id":"20240611083922-5qm8cno","updated":"20240611083922"},"Children":[{"Type":"NodeText","Data":"用银、石器，每蜜一斤入水四两，桑火慢熬，掠出浮沫，至滴水成珠用。忌葱、鲜莴苣同食（昂按∶生葱同蜜食杀人，而莴苣蜜渍点茶者颇多，未见作害，岂腌过则无患乎？抑药忌亦有不尽然者乎？）。"}]},{"ID":"20240611083922-o35rhr2","Type":"NodeParagraph","Properties":{"id":"20240611083922-o35rhr2","updated":"20240611083922"},"Children":[{"Type":"NodeText","Data":"黄蜡，甘温。止痛生肌，疗下痢（蜜质柔性润，故滑肠胃；蜡质坚性涩，故止泻痢），续绝伤（按∶蜜、蜡皆蜂所酿成，而蜜味至甘，蜡味至淡。故今人言无味者，谓之嚼蜡）。"}]},{"ID":"20240611084001-u498x1k","Type":"NodeThematicBreak","Properties":{"id":"20240611084001-u498x1k"}},{"ID":"20240611084003-n86542r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084003-n86542r","updated":"20240611084008"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草择要纲目》"}]},{"ID":"20240611084003-4w0rwm9","Type":"NodeParagraph","Properties":{"id":"20240611084003-4w0rwm9","updated":"20240611084003"},"Children":[{"Type":"NodeText","Data":"（蜜以密成．故谓之蜜．本经原作石蜜．盖以生岩石者为良耳．而诸家反致疑辨．今直题曰蜂蜜．正名也．凡试蜜以烧红火箸插入提出起气是真．起烟是伪．）"}]},{"ID":"20240611084003-35z8pa3","Type":"NodeParagraph","Properties":{"id":"20240611084003-35z8pa3","updated":"20240611084003"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611084003-z2mbw54","Type":"NodeParagraph","Properties":{"id":"20240611084003-z2mbw54","updated":"20240611084003"},"Children":[{"Type":"NodeText","Data":"甘平无毒．"}]},{"ID":"20240611084003-qxhhal2","Type":"NodeParagraph","Properties":{"id":"20240611084003-qxhhal2","updated":"20240611084003"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611084003-1o1dcwz","Type":"NodeParagraph","Properties":{"id":"20240611084003-1o1dcwz","updated":"20240611084003"},"Children":[{"Type":"NodeText","Data":"心腹邪气诸惊痫痉．安五脏诸不足．益气补中．止痛解毒．除众病．和百药．久服强志轻身．不饥不老延年．养脾气．除心烦饮食不下．止肠 ．肌中疼痛．口疮．明耳目．牙齿疳 ．唇口疮．目肤赤障．杀虫．治卒心痛及赤白痢．水作蜜浆顿服一碗止．或以姜汁同蜜各一合．水和顿服．常服面如花红．治心腹血刺痛及赤白痢．同生地黄汁各一匙服即下．同薤白捣涂烫伤即时痛止．和营卫．润脏腑．通三焦．调脾胃．夫蜂采无毒之花．酿以大便而成蜜．所谓臭腐生神奇也．其入药之功有五．清热也．补中也．解毒也．润燥也．止痛也．生则性凉．故能清热．熟则性温．故能补中．甘而和平．故能解毒．柔而濡泽．故能润燥．缓可以去急．故能止心腹肌肉疮疡之痛．和可以致中．故能调和百药而与甘草同功．张仲景治阳明结燥．大便不通．蜜煎导法．诚千古神方也．凡觉有热．四肢不和．即服蜜浆一碗甚良．"}]},{"ID":"20240611084015-c7ckxh4","Type":"NodeThematicBreak","Properties":{"id":"20240611084015-c7ckxh4"}},{"ID":"20240611084016-7schrzy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084016-7schrzy","updated":"20240611084023"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草崇原》"}]},{"ID":"20240611084016-8o23mf8","Type":"NodeParagraph","Properties":{"id":"20240611084016-8o23mf8","updated":"20240611084016"},"Children":[{"Type":"NodeText","Data":"气味甘平，无毒。主治心腹邪气，诸惊痫 ，安五脏诸不足，益气补中，止痛，解毒，除众病，和百药。久服强志轻身，不饥不老，延年神仙。"}]},{"ID":"20240611084016-5pfy491","Type":"NodeParagraph","Properties":{"id":"20240611084016-5pfy491","updated":"20240611084016"},"Children":[{"Type":"NodeText","Data":"（蜂居山谷，蜜从石岩下流出者，名石蜜。蜂居丛林，蜜从树木中流出者，名木蜜，皆以色白如膏者佳。若人家作桶，收养割取者，是为家蜜，此蜜最胜。春分节后，蜂采花心之粉，置之两髀而归，酝酿成蜜。如遇牡丹、兰蕙之粉，或负于背，或戴于首归，以供王蜂。王所居层叠如台，有君臣之义。寒冬无花，深藏房内，即以酿蜜为食，春暖花朝后，复出采花也。）"}]},{"ID":"20240611084016-zvx50az","Type":"NodeParagraph","Properties":{"id":"20240611084016-zvx50az","updated":"20240611084016"},"Children":[{"Type":"NodeText","Data":"草木百卉，五色咸具，有五行之正色，复有五行之间色，而花心只有黄白二色，故蜜色有黄白也。春夏秋集采群芳，冬月退藏于密，得四时生长收藏之气，吸百卉五色之精。主治心腹邪气者，甘味属土，滋养阳明中土，则上下心腹之正气自和，而邪气可治也。诸惊痫 ，乃心主神气内虚，蜂蜜花心酿成，能和心主之神，而诸惊痫 可治也。安五脏诸不足者，花具五行，故安五脏之不足。益气补中者，气属肺金，中属胃土，蜂采黄白金土之花心，故益气补中也。止痛解毒者，言蜂蜜解毒，故能止痛也。除众病，和百药者，言百药用蜂蜜和丸，以蜂蜜能除众病也，久服强志，金生水也。轻身不饥，土气盛也。轻身不饥，则不老延年，神仙可冀。"}]},{"ID":"20240611084029-n6oyep2","Type":"NodeThematicBreak","Properties":{"id":"20240611084029-n6oyep2"}},{"ID":"20240611084031-lt4ex0s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084031-lt4ex0s","updated":"20240611084037"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草分经》"}]},{"ID":"20240611084031-cr2f5f0","Type":"NodeParagraph","Properties":{"id":"20240611084031-cr2f5f0","updated":"20240611084031"},"Children":[{"Type":"NodeText","Data":"甘滑，生性凉清，热熟性温，补中润燥解毒，调营卫通三焦，安五脏通便秘，止诸痛和百药，与甘草同功，滑肠。同葱食害人，食蜜饱后食 令人暴亡。黄蜡甘淡微温性涩，止痛生肌，续绝伤止泻痢。"}]},{"ID":"20240611084039-flco170","Type":"NodeThematicBreak","Properties":{"id":"20240611084039-flco170"}},{"ID":"20240611084045-mocmcp1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084045-mocmcp1","updated":"20240611084049"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草便读》"}]},{"ID":"20240611084045-givzaf6","Type":"NodeParagraph","Properties":{"id":"20240611084045-givzaf6","updated":"20240611084045"},"Children":[{"Type":"NodeText","Data":"甘平润肺．滋大肠之结燥难通．香滑和中．悦胃气而肌肤自泽．生则解毒而止痛．熟则缓脾以补虚．（蜂蜜．蜂所酿成．白者良．甘平无毒．调五脏．利二肠．和中缓急．毒可解．痛可止．无非皆甘润之力．生则性凉．熟则性温．故炼熟白蜜．又能补益脾胃耳．随宜用之可也．）"}]},{"ID":"20240611084116-wy1upfu","Type":"NodeThematicBreak","Properties":{"id":"20240611084116-wy1upfu"}},{"ID":"20240611084118-26lxwn8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084118-26lxwn8","updated":"20240611084126"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草述钩元》"}]},{"ID":"20240611084118-mwt6dqo","Type":"NodeParagraph","Properties":{"id":"20240611084118-mwt6dqo","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"蜂采无毒之花。酿以大便而成。生岩石者。名石蜜。"}]},{"ID":"20240611084118-hrtsf7n","Type":"NodeParagraph","Properties":{"id":"20240611084118-hrtsf7n","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"气味甘平。（生者有小毒）蜜成于蜂。蜂寒而蜜温。同质异性也。（守真）生者性凉。故能清热热。止痛脉。调脾甚效。涂根汁人乳调服即止虏所染。"}]},{"ID":"20240611084118-5p16f1s","Type":"NodeParagraph","Properties":{"id":"20240611084118-5p16f1s","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"瘢黯色。"}]},{"ID":"20240611084118-0dt0srr","Type":"NodeParagraph","Properties":{"id":"20240611084118-0dt0srr","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"用生蜜与隔〔论〕万物之至味。莫过于甘蜂采百花之英。酿以大便而成蜜。是和群味而以臭腐生神奇者。甘属土。故能养脾。集群味以为甘。更由酝酿而成变化。故解毒为最。甘味属阳。"}]},{"ID":"20240611084118-cpho438","Type":"NodeParagraph","Properties":{"id":"20240611084118-cpho438","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"故所通。"}]},{"ID":"20240611084118-imo9qhc","Type":"NodeParagraph","Properties":{"id":"20240611084118-imo9qhc","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"宜。"}]},{"ID":"20240611084118-t306wro","Type":"NodeParagraph","Properties":{"id":"20240611084118-t306wro","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"丹溪云。西北高燥。故人食之有益。东南卑湿。多食则害生于脾。多食生湿热虫。（濒湖）呕家。"}]},{"ID":"20240611084118-8je7u50","Type":"NodeParagraph","Properties":{"id":"20240611084118-8je7u50","updated":"20240611084118"},"Children":[{"Type":"NodeText","Data":"〔修治〕水火炼法。每斤入水四两。银石器内以桑火慢熬。掠去浮沫。至滴水成珠。乃用。"}]},{"ID":"20240611084143-r8e5cvi","Type":"NodeThematicBreak","Properties":{"id":"20240611084143-r8e5cvi"}},{"ID":"20240611084144-8u8grz4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084144-8u8grz4","updated":"20240611084148"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本经逢原》"}]},{"ID":"20240611084144-jqbfqwb","Type":"NodeParagraph","Properties":{"id":"20240611084144-jqbfqwb","updated":"20240611084144"},"Children":[{"Type":"NodeText","Data":"甘平无毒。入调补药用白蜜，泻火药用赤蜜。味酸者不堪入药，不可与生葱、独蒜、莴苣同食，令人下利。凡炼蜜，炭火慢炼，掠去浮沫至滴水成珠为度。炼成每斤入陈酒四两再熬沸，和药为丸，则药力易化。"}]},{"ID":"20240611084144-49pdefp","Type":"NodeParagraph","Properties":{"id":"20240611084144-49pdefp","updated":"20240611084144"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹邪气，诸惊痫 ，安五脏，补不足，益气补中，止痛解毒，除众病，和百药，久服强志轻身，不饥不老。"}]},{"ID":"20240611084144-8oqq344","Type":"NodeParagraph","Properties":{"id":"20240611084144-8oqq344","updated":"20240611084144"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"蜂采无毒之花酝酿而成。生则性凉清热，故能治心腹之邪气。熟则性温，补中安五脏诸不足，甘而和平，故能解毒。柔而润泽，故能润燥。缓以去急，故能主心腹肌肉疮疡之痛。仲景治阳明结燥，大便不通，用蜜煎导法，取其能通结燥而不伤肠胃也。凡滋补药俱用炼白蜜丸，取其和脾润肺也。赤蜜味酸，食之令人心烦，惟降火药用之。白蜜虽补脾肺，然性凉润，脾胃不实，肾气虚滑，及湿热痰滞，胸痞不宽者，咸须忌之。故琼玉膏用糖霜，枳术丸用荷叶裹饭，佐金丸用米饮，牛黄丸用蒸饼，黑锡丹用酒曲，磁朱丸用神曲，虎潜丸用酒，香连丸用醋，茸珠丹用红枣，滚痰丸用水泛，各有所宜。今人制丸剂概用蜂蜜，殊失先哲用方之义。"}]},{"ID":"20240611084055-ah3jlj4","Type":"NodeThematicBreak","Properties":{"id":"20240611084055-ah3jlj4"}},{"ID":"20240611084101-w8783fp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611084101-w8783fp","updated":"20240611084106"},"Children":[{"Type":"NodeText","Data":"蜂蜜《本草思辨录》"}]},{"ID":"20240611084101-yx8xocb","Type":"NodeParagraph","Properties":{"id":"20240611084101-yx8xocb","updated":"20240611084101"},"Children":[{"Type":"NodeText","Data":"蜂蜜生性凉能清热，熟性温能补中。甘而和故解毒，甘而滑故润燥，甘缓可以去急，故止心腹肌肉疮疡诸痛，甘润可以泄泽养正，故通三焦除众病和百药。"}]},{"ID":"20240611084101-uekkkh4","Type":"NodeParagraph","Properties":{"id":"20240611084101-uekkkh4","updated":"20240611084101"},"Children":[{"Type":"NodeText","Data":"仲圣以蜜煎导通大便，蜜当为下利之所忌矣。然下利有用之者，一为猪肤汤，少阴伏邪内发，阴下泄而阳上乘，致下利咽痛胸满心烦，液伤而脾亦困矣。以猪肤从阳引阴而平邪热，阳不至上乘矣。白粉扶脾而止利，阴不至下泄矣。白蜜则佐猪肤润液，助白粉安中，故加之。"}]},{"ID":"20240611084101-m5e8gbz","Type":"NodeParagraph","Properties":{"id":"20240611084101-m5e8gbz","updated":"20240611084101"},"Children":[{"Type":"NodeText","Data":"一为甘遂半夏汤，脉伏者有留饮在内，欲自利利反快者，利不即利，即利则快。心下续坚满者，利后满减，过时又续，是为饮在上而肠则燥，致饮欲去不去，几与滞下无异。故以半夏白芍，消饮于上而降之。甘遂甘草，借其相反之势以激之。白蜜是润液化燥以速其去，犹滞下之用阿胶，此二方用蜜之意也。"}]},{"ID":"20240611083937-j22jgxh","Type":"NodeThematicBreak","Properties":{"id":"20240611083937-j22jgxh"}},{"ID":"20240611083939-6fpgedm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083939-6fpgedm","updated":"20240611083945"},"Children":[{"Type":"NodeText","Data":"蜂蜜《医学入门》"}]},{"ID":"20240611083939-8qvn3od","Type":"NodeParagraph","Properties":{"id":"20240611083939-8qvn3od","updated":"20240611083939"},"Children":[{"Type":"NodeText","Data":"蜂蜜甘平喜入脾，补中止痛痢痫奇，消烦除渴润便燥，目赤口齿诸疮宜。"}]},{"ID":"20240611083939-h3ae6d0","Type":"NodeParagraph","Properties":{"id":"20240611083939-h3ae6d0","updated":"20240611083939"},"Children":[{"Type":"NodeText","Data":"有木中作者，有土中作者，有石上作者，有人家养者，其蜜一也。但土蜜味碱；家养者取之数，而气味不足；山蜜多石中、古木中，经一二年得者，气味纯浓。《衍义》云∶蜡取新，蜜取陈也。新收者稀黄，经久则白而砂。无毒。甘苦入脾，故能养脾气，补中诸不足，止腹痛，治肠 、赤白痢，诸惊痫 ，除心烦闷不能饮食，润肺燥、消渴、便难及肛门肿塞。又治目生珠管、肤翳、赤肿，口舌生疮，牙齿疳 。火烧、汤泡、热油烧，丹毒，阴头生疮，诸恶疮癞，俱外敷之。"}]},{"ID":"20240611083939-gwdjz2l","Type":"NodeParagraph","Properties":{"id":"20240611083939-gwdjz2l","updated":"20240611083939"},"Children":[{"Type":"NodeText","Data":"兼和百药，解诸毒，安五脏，久服强志不老。惟中寒有湿者禁用。孙真人云∶七月勿食生蜜，令暴下发霍乱，多食亦生诸风。凡炼蜜必须用火熬开，以纸覆经宿，纸上去蜡尽，再熬变色，大约一斤只得十二两为佳，不可过度。"}]},{"ID":"20240611083226-eu4m8xb","Type":"NodeThematicBreak","Properties":{"id":"20240611083226-eu4m8xb"}},{"ID":"20240611083349-d6u1okg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083349-d6u1okg","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蜜蜂子"}]},{"ID":"20240611083349-hmnug6p","Type":"NodeParagraph","Properties":{"id":"20240611083349-hmnug6p","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Mì Fēnɡ Zǐ"}]},{"ID":"20240611083349-2vnyqn9","Type":"NodeParagraph","Properties":{"id":"20240611083349-2vnyqn9","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"蜂子（《本经》）"}]},{"ID":"20240611083349-igi8d2o","Type":"NodeParagraph","Properties":{"id":"20240611083349-igi8d2o","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"《本草经集注》"}]},{"ID":"20240611083349-v5f95sv","Type":"NodeParagraph","Properties":{"id":"20240611083349-v5f95sv","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"为蜜蜂科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中华蜜蜂"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼虫"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611083349-045k6ba","Type":"NodeParagraph","Properties":{"id":"20240611083349-045k6ba","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"甘，平。"}]},{"ID":"20240611083349-vafdeg0","Type":"NodeParagraph","Properties":{"id":"20240611083349-vafdeg0","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240611083349-lb1xmx7","Type":"NodeParagraph","Properties":{"id":"20240611083349-lb1xmx7","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"微寒，无毒。\""}]},{"ID":"20240611083349-qgejh89","Type":"NodeParagraph","Properties":{"id":"20240611083349-qgejh89","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"凉，有毒。\""}]},{"ID":"20240611083349-iwdautu","Type":"NodeParagraph","Properties":{"id":"20240611083349-iwdautu","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"祛风，解毒，杀虫。治头风，麻风，丹毒，风疹，虫积腹痛，妇女带下。"}]},{"ID":"20240611083349-j7s8zm5","Type":"NodeParagraph","Properties":{"id":"20240611083349-j7s8zm5","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主风头，补虚羸伤中。\""}]},{"ID":"20240611083349-q5viw76","Type":"NodeParagraph","Properties":{"id":"20240611083349-q5viw76","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主心腹痛，大人小儿腹中五虫口吐出者，面目黄。\""}]},{"ID":"20240611083349-4l95eb3","Type":"NodeParagraph","Properties":{"id":"20240611083349-4l95eb3","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"③《本草拾遗》：\"主丹毒，风疹，腹内留热，大小便涩，去浮血，妇人带下，下乳汁。\""}]},{"ID":"20240611083349-hnx92s0","Type":"NodeParagraph","Properties":{"id":"20240611083349-hnx92s0","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"治大风疠疾。\""}]},{"ID":"20240611083349-7shb9et","Type":"NodeParagraph","Properties":{"id":"20240611083349-7shb9et","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服：炒炙或研末。"}]},{"ID":"20240611083349-89th0lw","Type":"NodeParagraph","Properties":{"id":"20240611083349-89th0lw","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"①《本草经集注》：\"畏黄芩、芍药、牡蛎。\""}]},{"ID":"20240611083349-4y291g8","Type":"NodeParagraph","Properties":{"id":"20240611083349-4y291g8","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"②《蜀本草》：\"畏白前。\""}]},{"ID":"20240611083349-t84wqfo","Type":"NodeParagraph","Properties":{"id":"20240611083349-t84wqfo","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复方"},{"Type":"NodeText","Data":"治大风疠疾，眉毛堕落，皮肉已烂成疮者：蜜蜂子、胡蜂子、黄蜂子（并炒）各一分，白花蛇、乌蛇（并酒浸去皮、骨，炙干）、全蝎（去土，炒）、白僵蚕（炒）各一两，地龙（去土，炒）半两，蝎虎（全用，炒）、赤足蜈蚣（全者，炒）各十五枚，丹砂一两，雄黄（醋熬）一分，龙脑半钱。为末。每服一钱匕，温蜜汤调下，日三、五服。（《圣济总录》）"}]},{"ID":"20240611083349-hsgytgn","Type":"NodeParagraph","Properties":{"id":"20240611083349-hsgytgn","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《中药大辞典》"}]},{"ID":"20240611083349-ka2h747","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083349-ka2h747","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蜜蜂子"}]},{"ID":"20240611083349-lq0wp3e","Type":"NodeParagraph","Properties":{"id":"20240611083349-lq0wp3e","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Mì Fēnɡ Zǐ"}]},{"ID":"20240611083349-ips0br9","Type":"NodeParagraph","Properties":{"id":"20240611083349-ips0br9","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"英文名"},{"Type":"NodeText","Data":"Bee Larva"}]},{"ID":"20240611083349-jmoaw8y","Type":"NodeParagraph","Properties":{"id":"20240611083349-jmoaw8y","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"蜂子"}]},{"ID":"20240611083349-z0h16km","Type":"NodeParagraph","Properties":{"id":"20240611083349-z0h16km","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"出自《本草经集注》；1.《日华子本草》：蜂子，食之者，须以冬瓜及苦荬、生姜、紫苏以制其毒也。"}]},{"ID":"20240611083349-t9t09an","Type":"NodeParagraph","Properties":{"id":"20240611083349-t9t09an","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：蜂子，在蜜脾中，如蛹而白色。凡用蜂子，并取头足未成者佳。"}]},{"ID":"20240611083349-ewtnfba","Type":"NodeParagraph","Properties":{"id":"20240611083349-ewtnfba","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：蜂子，古人以充馔品，故《本经》、《别录》着其功效，而《圣济总录》治大风疾兼用诸蜂子，盖亦足阳明、太阴之药也。"}]},{"ID":"20240611083349-pd5aubk","Type":"NodeParagraph","Properties":{"id":"20240611083349-pd5aubk","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"药材基源：为蜜蜂科动物中华蜜蜂等的未成熟幼虫。"}]},{"ID":"20240611083349-u9dc7hw","Type":"NodeParagraph","Properties":{"id":"20240611083349-u9dc7hw","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Apis cerana Fabr"}]},{"ID":"20240611083349-onedxvf","Type":"NodeParagraph","Properties":{"id":"20240611083349-onedxvf","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在养蜂季节从蜂巢中取出幼虫。"}]},{"ID":"20240611083349-dbd3fgi","Type":"NodeParagraph","Properties":{"id":"20240611083349-dbd3fgi","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"1.中华蜜蜂，蜂群由工蜂、蜂王及雄蜂组成。工蜂全体被黄褐色毛。头略呈三角形。胸部3节。翅2对，膜质透明。足3对，有采集花粉的构造。腹部圆锥状，有毒腺和螫针。腹下有蜡板4 对，内有蜡腺，分泌蜡质。蜂王体最大，翅短小，腹部特长，生殖器发达，专营生殖产卵。雄蜂较工蜂稍大，头呈球形，尾无毒腺和螫针，足上无采贮花粉构造，腹无蜡板及蜡腺。"}]},{"ID":"20240611083349-wyvpvo9","Type":"NodeParagraph","Properties":{"id":"20240611083349-wyvpvo9","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"2.意大利蜜蜂，体似中华蜜蜂，但较之为大。"}]},{"ID":"20240611083349-6qlc5q3","Type":"NodeParagraph","Properties":{"id":"20240611083349-6qlc5q3","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生境分部"},{"Type":"NodeText","Data":"我国大部分地区均有养殖。"}]},{"ID":"20240611083349-sig6gno","Type":"NodeParagraph","Properties":{"id":"20240611083349-sig6gno","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性状"},{"Type":"NodeText","Data":"性状鉴别，本品为白色或淡黄色蛹状物，长约15mm，直径约5mm。"}]},{"ID":"20240611083349-e6irmk8","Type":"NodeParagraph","Properties":{"id":"20240611083349-e6irmk8","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"味甘；性平"}]},{"ID":"20240611083349-bgprnv0","Type":"NodeParagraph","Properties":{"id":"20240611083349-bgprnv0","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"归经"},{"Type":"NodeText","Data":"脾；胃经"}]},{"ID":"20240611083349-csx3sbl","Type":"NodeParagraph","Properties":{"id":"20240611083349-csx3sbl","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"祛风；解毒；杀虫；通乳。主头风；麻风；丹毒；风疹；虫积腹痛；带下；产后乳少"}]},{"ID":"20240611083349-e5q44xv","Type":"NodeParagraph","Properties":{"id":"20240611083349-e5q44xv","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服：炒炙研末，1-2g。"}]},{"ID":"20240611083349-ncfth3z","Type":"NodeParagraph","Properties":{"id":"20240611083349-ncfth3z","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"1.《本草经集注》：“畏黄共芩、芍药、牡蛎。”2.《蜀本草》：“畏白前。”"}]},{"ID":"20240611083349-xyor337","Type":"NodeParagraph","Properties":{"id":"20240611083349-xyor337","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复方"},{"Type":"NodeText","Data":"治大风疠疾，眉毛堕落，皮肉已烂成疮者：蜜蜂子、胡蜂子、黄蜂子(并炒)各一分，白花蛇、乌蛇(并酒浸去皮、骨，炙干)、全蝎(去土，炒)、白僵蚕(炒)各一两，地龙(去土，炒)半两，蝎虎(全用，炒)、赤足娱蚣(全者，炒)各十五枚，丹砂一两，雄黄(醋熬)一分，龙脑半钱。为末。每服一钱匕，温蜜汤调下，日三、五服。(《圣济总录》)"}]},{"ID":"20240611083349-fhzb60e","Type":"NodeParagraph","Properties":{"id":"20240611083349-fhzb60e","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"各家论述"},{"Type":"NodeText","Data":"1.《本经》：主风头，补虚羸伤中。"}]},{"ID":"20240611083349-geja2kb","Type":"NodeParagraph","Properties":{"id":"20240611083349-geja2kb","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主心腹痛，大人小儿腹中五虫口吐出者，面目黄。"}]},{"ID":"20240611083349-hn5gtnk","Type":"NodeParagraph","Properties":{"id":"20240611083349-hn5gtnk","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：主丹毒，风疹，腹内留热，大小便涩，去浮血，妇人带下，下乳汁。"}]},{"ID":"20240611083349-e5bqur5","Type":"NodeParagraph","Properties":{"id":"20240611083349-e5bqur5","updated":"20240611083349"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：治大风疠疾。"}]},{"ID":"20240611083349-nulm5h8","Type":"NodeParagraph","Properties":{"id":"20240611083349-nulm5h8","updated":"20240611083349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《中华本草》"}]},{"ID":"20240611083259-d6moj6w","Type":"NodeThematicBreak","Properties":{"id":"20240611083259-d6moj6w"}},{"ID":"20240611083312-5qk54w0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083312-5qk54w0","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"《中国药典》：蜂蜜"}]},{"ID":"20240611083312-i7waths","Type":"NodeParagraph","Properties":{"id":"20240611083312-i7waths","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611083312-3rdrnf7","Type":"NodeParagraph","Properties":{"id":"20240611083312-3rdrnf7","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" Fēnɡ Mì"}]},{"ID":"20240611083312-29kok1e","Type":"NodeParagraph","Properties":{"id":"20240611083312-29kok1e","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611083312-v7xmmwe","Type":"NodeParagraph","Properties":{"id":"20240611083312-v7xmmwe","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 蜂糖、蜜糖"}]},{"ID":"20240611083312-2hqp0rc","Type":"NodeParagraph","Properties":{"id":"20240611083312-2hqp0rc","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611083312-vgv4gy8","Type":"NodeParagraph","Properties":{"id":"20240611083312-vgv4gy8","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" MEL"}]},{"ID":"20240611083312-q6ix2zw","Type":"NodeParagraph","Properties":{"id":"20240611083312-q6ix2zw","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611083312-h3bs8s7","Type":"NodeParagraph","Properties":{"id":"20240611083312-h3bs8s7","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 本品为蜜蜂科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中华蜜蜂"},{"Type":"NodeText","Data":"Apis cerana Fabricius或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"意大利蜂"},{"Type":"NodeText","Data":"APis mellifera Linnaeus所酿的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜜"},{"Type":"NodeText","Data":"。春至秋季采收，滤过。"}]},{"ID":"20240611083312-yc6wkv9","Type":"NodeParagraph","Properties":{"id":"20240611083312-yc6wkv9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611083312-3gui5qx","Type":"NodeParagraph","Properties":{"id":"20240611083312-3gui5qx","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 本品为半透明、带光泽、浓稠的液体，白色至淡黄色或橘黄色至黄褐色，放久或遇冷渐有白色颗粒状结晶析出。气芳香，味极甜。相对密度本品如有结晶析出，可置于不超过60℃的水浴中，待结晶全部融化后，搅匀，冷至25℃，照相对密度测定法项下的韦氏比重秤法（附录ⅦA）测定，相对密度应在1。349以上。"}]},{"ID":"20240611083312-pxo6azp","Type":"NodeParagraph","Properties":{"id":"20240611083312-pxo6azp","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611083312-whv5xq4","Type":"NodeParagraph","Properties":{"id":"20240611083312-whv5xq4","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 置阴凉处。"}]},{"ID":"20240611083312-jsbg2k6","Type":"NodeParagraph","Properties":{"id":"20240611083312-jsbg2k6","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611083312-6pms41k","Type":"NodeParagraph","Properties":{"id":"20240611083312-6pms41k","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 归肺、脾、大肠经。"}]},{"ID":"20240611083312-0ia6ube","Type":"NodeParagraph","Properties":{"id":"20240611083312-0ia6ube","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611083312-f27vryq","Type":"NodeParagraph","Properties":{"id":"20240611083312-f27vryq","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240611083312-3lmg0xq","Type":"NodeParagraph","Properties":{"id":"20240611083312-3lmg0xq","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611083312-bzengxf","Type":"NodeParagraph","Properties":{"id":"20240611083312-bzengxf","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 补中，润燥，止痛，解毒。用于脘腹虚痛，肺燥干咳，肠燥便秘；外治疮疡不敛，水火烫伤。"}]},{"ID":"20240611083312-ym70goo","Type":"NodeParagraph","Properties":{"id":"20240611083312-ym70goo","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611083312-1gwa0og","Type":"NodeParagraph","Properties":{"id":"20240611083312-1gwa0og","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 15～30g。"}]},{"ID":"20240611083312-6tftphk","Type":"NodeParagraph","Properties":{"id":"20240611083312-6tftphk","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611083312-atlg7fz","Type":"NodeParagraph","Properties":{"id":"20240611083312-atlg7fz","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" （1）对干咳、久咳等症，在使用化痰止咳药如枇杷叶、款冬花、紫菀、百部等时，常用本品拌炒（即蜜炙）；又如治虚劳干咳、咯血的琼玉膏，即用本品与鲜生地、茯苓、人参配制而成。又因它能滋补脾胃，故滋补丸药用蜜丸者甚多，不仅取其矫味及黏性，同时还取它的缓和药性与补养作用。此外，本品还可以用解乌头毒。"}]},{"ID":"20240611083312-uageelr","Type":"NodeParagraph","Properties":{"id":"20240611083312-uageelr","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611083312-10n3k5y","Type":"NodeParagraph","Properties":{"id":"20240611083312-10n3k5y","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611083312-dxq3xlf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083312-dxq3xlf","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蜂蜜"}]},{"ID":"20240611083312-v97aeq7","Type":"NodeParagraph","Properties":{"id":"20240611083312-v97aeq7","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611083312-v03f1m1","Type":"NodeParagraph","Properties":{"id":"20240611083312-v03f1m1","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" Fēnɡ Mì"}]},{"ID":"20240611083312-7o6zqkf","Type":"NodeParagraph","Properties":{"id":"20240611083312-7o6zqkf","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611083312-mnkf6on","Type":"NodeParagraph","Properties":{"id":"20240611083312-mnkf6on","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 石蜜、石始（《本经》），食蜜（《伤寒论》），蜜（《金匮要略》），白蜜（《药性论》），白沙蜜（《本草衍义》），蜜糖（《本草蒙筌》），沙蜜、蜂糖（《纲目》）。"}]},{"ID":"20240611083312-141p7au","Type":"NodeParagraph","Properties":{"id":"20240611083312-141p7au","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611083312-paemmnm","Type":"NodeParagraph","Properties":{"id":"20240611083312-paemmnm","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 《纲目》"}]},{"ID":"20240611083312-2edh886","Type":"NodeParagraph","Properties":{"id":"20240611083312-2edh886","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611083312-s4sthjt","Type":"NodeParagraph","Properties":{"id":"20240611083312-s4sthjt","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 为蜜蜂科昆虫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中华蜜蜂"},{"Type":"NodeText","Data":"等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"所酿的蜜糖"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611083312-tzw74qj","Type":"NodeParagraph","Properties":{"id":"20240611083312-tzw74qj","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611083312-mksd369","Type":"NodeParagraph","Properties":{"id":"20240611083312-mksd369","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 分布很广。目前全国大部分地区养殖的品种主要是意大利蜜蜂。全国大部地区均产。"}]},{"ID":"20240611083312-nkul2do","Type":"NodeParagraph","Properties":{"id":"20240611083312-nkul2do","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611083312-ktj8ysw","Type":"NodeParagraph","Properties":{"id":"20240611083312-ktj8ysw","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 中华蜜蜂，又名：范（《礼记》），蜡蜂（《纲目》）。"}]},{"ID":"20240611083312-tvxbii5","Type":"NodeParagraph","Properties":{"id":"20240611083312-tvxbii5","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"有母蜂、工蜂和雄蜂三种。工蜂形小，体暗褐色，头、胸、背面密生灰黄色的细毛。头略呈三角形，有复眼1对，单眼3个；触角1对，膝状弯曲；口器发达，适于咀嚼及吮吸。胸部3节，中胸最大；翅2对，膜质透明，后翅中脉分叉。足9对，股节、胫节及跗节等处，均有采集花粉的构造。腹部圆锥状，背面黄褐色，1～4节有黑色环带，末端尖锐，有毒腺和螫针；腹下有蜡板4对，内有蜡腺，分泌蜡质。母蜂俗称蜂王，体最大，翅短小，腹部特长。生殖器发达。雄蜂较工蜂稍大，头呈球状，复眼很大；尾端圆形，无毒腺和螫针。母蜂和雄蜂的口器均退化，足上无采贮花粉的构造，腹下蜡板和蜡腺均无。"}]},{"ID":"20240611083312-h6av8e8","Type":"NodeParagraph","Properties":{"id":"20240611083312-h6av8e8","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"蜜蜂是一种营群体生活的昆虫。每一蜂群，由1个母蜂、数百个雄蜂和上万个工蜂所组成。母蜂为群体中的核心，专司产卵；工蜂为生殖系统不发育的雌性蜂，专司采蜜、酿蜜、喂饲幼虫、筑巢及防御等职。"}]},{"ID":"20240611083312-dr2rl4n","Type":"NodeParagraph","Properties":{"id":"20240611083312-dr2rl4n","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611083312-mllruwv","Type":"NodeParagraph","Properties":{"id":"20240611083312-mllruwv","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 为稠厚的液体，白色至淡黄色（白蜜），或橘黄色至琥珀色（黄蜜）。夏季如清油状，半透明，有光泽；冬季则易变成不透明，并有葡萄糖的结晶析出，状如鱼子。气芳香，味极甜。以水分小，有油性，稠如凝脂，用木棒挑起时蜜汁下流如丝状不断，且盘曲如折叠状，味甜不酸，气芳香，洁净无杂质者为佳。"}]},{"ID":"20240611083312-gtm53gn","Type":"NodeParagraph","Properties":{"id":"20240611083312-gtm53gn","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611083312-qvfvb7d","Type":"NodeParagraph","Properties":{"id":"20240611083312-qvfvb7d","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 蜜因蜂种、蜜源、环境等的不同，其化学组成差异甚大。最重要的成分是果糖和葡萄糖，两者含量合计约70％。尚含少量蔗糖（有时含量颇高），麦芽糖、糊精，树胶，以及含氮化合物、有机酸、挥发油、色素、蜡、植物残片（特别是花粉粒）、酵母、酶类、无机盐等。蜜一般只含微量维生素，其中有A、C、D、胆碱、B2、尼克酸、泛酸、生物素、叶酸、B、K等。在含氮化台物中有蛋白质、胨、际、氨基酸，以及转化酶、过氧化氢酶、淀粉酶等酶类，并含乙酰胆碱。灰分中主含镁、钙、钾、钠、硫、磷，以及微量元素铁、锰、铜、镍等。有机酸中往往有柠檬酸，以及苹果酸、琥珀酸、乙酸。也常含甲酸，但含量极低（0.01％以下）。"}]},{"ID":"20240611083312-l3ugog5","Type":"NodeParagraph","Properties":{"id":"20240611083312-l3ugog5","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611083312-9m5xib9","Type":"NodeParagraph","Properties":{"id":"20240611083312-9m5xib9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 取纯净的蜂蜜，用文火熬炼，过滤去沫。"}]},{"ID":"20240611083312-yd4u65i","Type":"NodeParagraph","Properties":{"id":"20240611083312-yd4u65i","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡炼蜜一斤，只得十二两半是数，若火少，火过，并用不得。\""}]},{"ID":"20240611083312-0dhuqqs","Type":"NodeParagraph","Properties":{"id":"20240611083312-0dhuqqs","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"凡蜜，皆先火上煎，掠去其沫，令色微黄，则丸经久不坏。\""}]},{"ID":"20240611083312-aodc91d","Type":"NodeParagraph","Properties":{"id":"20240611083312-aodc91d","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"凡炼沙蜜，每斤入水四两，银石器内，以桑柴火慢炼，掠去浮沫，至滴水成珠不散，乃用，谓之水火炼法。又法：以器盛置重汤中煮一日，候滴水不散，取用亦佳，且不伤火也。\""}]},{"ID":"20240611083312-g8g2207","Type":"NodeParagraph","Properties":{"id":"20240611083312-g8g2207","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611083312-jf4m0br","Type":"NodeParagraph","Properties":{"id":"20240611083312-jf4m0br","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 入肺、脾、大肠经。"}]},{"ID":"20240611083312-hndoqcq","Type":"NodeParagraph","Properties":{"id":"20240611083312-hndoqcq","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾、肺二经。\""}]},{"ID":"20240611083312-85ioga4","Type":"NodeParagraph","Properties":{"id":"20240611083312-85ioga4","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"入手足太阴、阳明经。\""}]},{"ID":"20240611083312-wrggd30","Type":"NodeParagraph","Properties":{"id":"20240611083312-wrggd30","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③《要药分剂》：\"入心、脾二经。\""}]},{"ID":"20240611083312-5qkifch","Type":"NodeParagraph","Properties":{"id":"20240611083312-5qkifch","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611083312-xziy4xw","Type":"NodeParagraph","Properties":{"id":"20240611083312-xziy4xw","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240611083312-9pbk96u","Type":"NodeParagraph","Properties":{"id":"20240611083312-9pbk96u","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240611083312-w14hyo2","Type":"NodeParagraph","Properties":{"id":"20240611083312-w14hyo2","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"生凉，熟温。\""}]},{"ID":"20240611083312-3nldxey","Type":"NodeParagraph","Properties":{"id":"20240611083312-3nldxey","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"味甘，气寒，无毒。\""}]},{"ID":"20240611083312-1ztul18","Type":"NodeParagraph","Properties":{"id":"20240611083312-1ztul18","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611083312-eqyszsj","Type":"NodeParagraph","Properties":{"id":"20240611083312-eqyszsj","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 痰湿内蕴、中满痞胀及肠滑泄泻者忌服。"}]},{"ID":"20240611083312-id58685","Type":"NodeParagraph","Properties":{"id":"20240611083312-id58685","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"《本草经疏》：\"石蜜，生者性寒滑，能作泄，大肠气虚，完谷不化者不宜用，呕家酒家不宜用，中满蛊胀不宜用，湿热脚气不宜用。\""}]},{"ID":"20240611083312-lqhcbgk","Type":"NodeParagraph","Properties":{"id":"20240611083312-lqhcbgk","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611083312-zxxworg","Type":"NodeParagraph","Properties":{"id":"20240611083312-zxxworg","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 补中，润燥，止痛，解毒。治肺燥咳嗽，肠燥便秘，胃脘疼痛，鼻渊，口疮，汤火烫伤，解乌头毒。"}]},{"ID":"20240611083312-t6hty39","Type":"NodeParagraph","Properties":{"id":"20240611083312-t6hty39","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹邪气，诸惊痫痓，安五脏诸不足，益气补中，止痛解毒，和百药。\""}]},{"ID":"20240611083312-aqonfck","Type":"NodeParagraph","Properties":{"id":"20240611083312-aqonfck","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"养脾气，除心烦，食饮不下，止肠澼，肌中疼痛，口疮，明耳目。\""}]},{"ID":"20240611083312-gh2x6bv","Type":"NodeParagraph","Properties":{"id":"20240611083312-gh2x6bv","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③《本草拾遗》：\"主牙齿疳匿，唇口疮，目肤赤障，杀虫。\""}]},{"ID":"20240611083312-4o5z1qy","Type":"NodeParagraph","Properties":{"id":"20240611083312-4o5z1qy","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"④《本草衍义》：\"汤火伤涂之痛止，仍捣薤白相和。\""}]},{"ID":"20240611083312-g8nqch1","Type":"NodeParagraph","Properties":{"id":"20240611083312-g8nqch1","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"和营卫，润脏腑，通三焦，调脾胃。\""}]},{"ID":"20240611083312-6z0bglk","Type":"NodeParagraph","Properties":{"id":"20240611083312-6z0bglk","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611083312-aqa281q","Type":"NodeParagraph","Properties":{"id":"20240611083312-aqa281q","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 内服：冲调，0.3～1两；或入丸剂、膏剂。外用：涂局部。"}]},{"ID":"20240611083312-yrrynto","Type":"NodeParagraph","Properties":{"id":"20240611083312-yrrynto","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611083312-h7or4kc","Type":"NodeParagraph","Properties":{"id":"20240611083312-h7or4kc","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" ①治咳嗽：白蜜一斤，生姜二斤（取汁）。上二味，先秤铜铫，知斤两讫，纳蜜复秤知数，次纳姜汁，以微火煎令姜汁尽，惟有蜜斤两在，止。旦服如枣大，含一丸，日三服。禁一切杂食。（《千金方》）"}]},{"ID":"20240611083312-ekbsq0o","Type":"NodeParagraph","Properties":{"id":"20240611083312-ekbsq0o","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②治上气咳嗽，喘息，喉中有物，唾血：杏仁、生姜汁各二升，糖、蜜各-升，猪膏二合。上五味，先以猪膏煎杏仁黄，出之，以纸拭令净，捣如膏，合姜汁、蜜、糖等，合煎令可丸。服如杏核一枚，日夜六、七服，渐渐加之。（《千金方》）"}]},{"ID":"20240611083312-htoqelb","Type":"NodeParagraph","Properties":{"id":"20240611083312-htoqelb","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③治阳明病，自汗出，若发汗，小便自利者，此为津液内竭，虽鞕不可攻之，当须自欲大便：食蜜七合。于铜器内，微火煎，当须凝如饴状，搅之勿令焦著，欲可丸，并手捻作铤，令头锐，大如指，长二寸许，当热时急作，冷则鞕。以纳谷道中，以手急抱，欲大便时乃去之。（《伤寒论》）"}]},{"ID":"20240611083312-tnfo2nw","Type":"NodeParagraph","Properties":{"id":"20240611083312-tnfo2nw","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"④治高血压，慢性便秘：蜂蜜一两八钱，黑芝麻一两五钱。先将芝麻蒸熟捣如泥，搅入蜂蜜，用热开水冲化，一日二次分服。（《现代实用中药》）"}]},{"ID":"20240611083312-z7vky2t","Type":"NodeParagraph","Properties":{"id":"20240611083312-z7vky2t","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑤治胃及十二指肠溃疡：蜂蜜一两八钱，生甘草三钱，陈皮二钱。水适量，先煎甘草、陈皮去渣，冲入蜂蜜。一日三次分服。（《现代实用中药》）"}]},{"ID":"20240611083312-sv1d5dy","Type":"NodeParagraph","Properties":{"id":"20240611083312-sv1d5dy","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑥治蛔虫病，吐涎心痛，发作有时，毒药不止：甘草二两，粉一两重，蜜四两。上三味，以水三升，先煮甘草取二升，去滓，纳粉、蜜，搅令和，煎如薄粥，温服一升，瘥即止。（《金匮要略》甘草粉蜜汤）"}]},{"ID":"20240611083312-fklstxx","Type":"NodeParagraph","Properties":{"id":"20240611083312-fklstxx","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑦治疔肿恶毒：生蜜与隔年葱研膏，先刺破涂之，如人行五里许，则疔出，后以热醋汤洗去。（《济急仙方》）"}]},{"ID":"20240611083312-scoqtwz","Type":"NodeParagraph","Properties":{"id":"20240611083312-scoqtwz","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑧治口疮：蜜浸大青叶含之。（《药性论》）"}]},{"ID":"20240611083312-jrzqz0e","Type":"NodeParagraph","Properties":{"id":"20240611083312-jrzqz0e","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑨治男子阴疮：蜜煎甘草末，涂之。（《肘后方》）"}]},{"ID":"20240611083312-mz6ptu9","Type":"NodeParagraph","Properties":{"id":"20240611083312-mz6ptu9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑩治痘疮痒甚，误搔成疮，及疮痂欲落不落者：白蜜不拘多少，涂于疮上，其痂自落，且无疤痕，亦不臭秽。（《普济方》百花膏）"}]},{"ID":"20240611083312-7pdx73k","Type":"NodeParagraph","Properties":{"id":"20240611083312-7pdx73k","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑾治风疹，风癣：沙蜜一斤，糯饭一斤，面曲五两，熟水五升，同入瓶内封七日成酒，寻以蜜入酒代之，亦良。（《纲目》蜜酒）"}]},{"ID":"20240611083312-r6pwqs3","Type":"NodeParagraph","Properties":{"id":"20240611083312-r6pwqs3","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑿治热油烧外痛：白蜜涂之。（《梅师集验方》）"}]},{"ID":"20240611083312-h9liyxe","Type":"NodeParagraph","Properties":{"id":"20240611083312-h9liyxe","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⒀治鼾：白蜜和茯苓，涂上。（《补缺肘后方》）"}]},{"ID":"20240611083312-0fq4vs6","Type":"NodeParagraph","Properties":{"id":"20240611083312-0fq4vs6","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⒁解乌头毒：白蜂蜜每次一至四汤匙，温开水冲服。（《上海常用中草药》）"}]},{"ID":"20240611083312-wazeumo","Type":"NodeParagraph","Properties":{"id":"20240611083312-wazeumo","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611083312-0j8z09q","Type":"NodeParagraph","Properties":{"id":"20240611083312-0j8z09q","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" ①治疗胃、十二指肠溃疡"}]},{"ID":"20240611083312-ipgalto","Type":"NodeParagraph","Properties":{"id":"20240611083312-ipgalto","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"曾观察20例，治疗后15例壁龛消失，3例进步（平均为32天）；18例疼痛完全消失，2例减轻，疼痛消失时间最短6天，平均为22.2天。国外资料报道治疗数百例的痊愈率为82％。用法：每日用新鲜蜂蜜100克，早、中、晚饭前分服；服至第10日后，每日增至150～200克。或用蜂蜜60毫升，0.5％普鲁卡因40毫升，混合为1次量，日服3次。"}]},{"ID":"20240611083312-ndxsx47","Type":"NodeParagraph","Properties":{"id":"20240611083312-ndxsx47","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②治疗烧伤"}]},{"ID":"20240611083312-si4guxo","Type":"NodeParagraph","Properties":{"id":"20240611083312-si4guxo","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"用蜂蜜涂布烧伤创面，能减少渗出液，减轻疼痛，控制感染，促进创面愈合，从而缩短治愈时间。用法：一般Ⅰ、Ⅱ度中小面积烧伤，创面经清洁处理后，即用棉球蘸蜂蜜均匀涂布（不宜太厚或太薄），早期每日2～3次或4～5次，待形成胶痂后改为每日1～2次。采用暴露疗法。如痂下积有脓液，可将胶痂揭去，清创后再行涂布，创面可重新结成胶痂，迅速愈合。对已感染的或面积较大的Ⅲ度烧伤，则可用蜂蜜纱布敷于创面，外用无菌棉垫包扎。冬天不便使用暴露疗法者，亦可采用此法。蜂蜜中也可加入2％普鲁卡因溶液，配成2：1混合液使用，以减轻涂药开始时给创面带来的疼痛。有主张在蜂蜜涂布后，创面上再撒布一薄层石膏粉，以增强疗效。据85例观察，Ⅰ、Ⅱ度烧伤一般涂布蜂蜜2～3天后，创面便形成透明胶痂；6～10天胶痂自行脱落，新生上皮完全生长。晚期入院已有明显感染者，2～3天后创面亦能形成胶痂，并可见痂下上皮细胞生长。采用蜂蜜纱布包扎疗法者，一般经过6～9天肉芽生长良好，2～3周后即可痊愈。在治疗过程中均未发生感染，已感染之创面，涂蜜后脓性分泌物亦逐渐减少。但使用本法时仍应尽力创造无菌条件。对胶痂下的感染情况要留意观察，及时处理。在关节处的胶痂易于破裂，要注意保护。同时，本疗法仅限于创面处理，其它如止痛、抗感染、补充液体及控制休克等，均需按常规配合进行。"}]},{"ID":"20240611083312-wivq0js","Type":"NodeParagraph","Properties":{"id":"20240611083312-wivq0js","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③治疗冻伤、冻疮"}]},{"ID":"20240611083312-cnnxg5n","Type":"NodeParagraph","Properties":{"id":"20240611083312-cnnxg5n","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"对于Ⅱ度以上有炎症及有分泌物的冻伤，用熟蜂蜜与黄凡士林等量调成软膏，薄薄的涂于无菌纱布上，敷盖于创面，每次敷2～3层。敷盖前先将创面清洗干净，敷盖后用敷料包扎固定。一般用药2～3次后，疼痛及炎症渐趋消失，3～7次可望痊愈。对于冻疮，先用温开水洗涤患部，然后涂蜜包扎，间日换药一次。如未破溃的，可不必包扎。"}]},{"ID":"20240611083312-q1r6usu","Type":"NodeParagraph","Properties":{"id":"20240611083312-q1r6usu","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"④治疗溃疡与外伤"}]},{"ID":"20240611083312-6nborl5","Type":"NodeParagraph","Properties":{"id":"20240611083312-6nborl5","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"年久不愈的慢性溃疡，可试用10％蜜汁洗涤疮口，然后用纯蜜浸渍的纱布条敷于创面，敷料包扎，间日换药1次。曾试治两例下肢溃疡，1周后即有肉芽新生，约2个月即愈。另试治1例梅毒性溃疡，结果无效。皮肤与肌肉的外伤，可用10％蜜汁洗涤伤口，然后涂蜜包扎，能防止感染，获得一期愈合。"}]},{"ID":"20240611083312-q8q3nuc","Type":"NodeParagraph","Properties":{"id":"20240611083312-q8q3nuc","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑤治疗皮炎"}]},{"ID":"20240611083312-94v3yh9","Type":"NodeParagraph","Properties":{"id":"20240611083312-94v3yh9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"对过敏性皮炎及湿疹等，用蜂蜜100毫升，加氧化锌10克，淀粉20克，制成软膏外搽。用药后可使红疹消退，渗出物减少，痒感消失。治疗尿布皮炎，先用温水洗净患部，而后用蜂蜜涂搽，每日1～2次。"}]},{"ID":"20240611083312-nwwa0t1","Type":"NodeParagraph","Properties":{"id":"20240611083312-nwwa0t1","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑥治疗角膜溃疡及睑缘炎"}]},{"ID":"20240611083312-fcazhng","Type":"NodeParagraph","Properties":{"id":"20240611083312-fcazhng","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"用蜂蜜制成5％滴眼液滴眼，治疗角膜溃疡29例，治愈22例，进步4例，无效3例。一般在用药1、2天后，溃疡即由进行性转为静止，基底清洁，透明度增加，浸润边缘消失。奏效的原因可能是增强机体防御能力，或影响病变部位的新陈代谢。用蜂蜜外涂，每日3次，治疗睑缘炎76例，平均3.5天治愈。"}]},{"ID":"20240611083312-zm1oai2","Type":"NodeParagraph","Properties":{"id":"20240611083312-zm1oai2","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑦治疗鼻炎和鼻窦炎"}]},{"ID":"20240611083312-kkej24l","Type":"NodeParagraph","Properties":{"id":"20240611083312-kkej24l","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"对慢性鼻炎采用40％蜂蜜行游子透入法治疗，每日1次，电流强度1～5毫安，时间15～20分钟，14次为一疗程。如需行第二疗程时，休息1个月后再继续进行。50例患者经14～24次治疗后，11例痊愈，18例好转，11例减轻，10例无效。对上颌窦炎，经穿刺灌洗后注入20％或40％蜂蜜2毫升，每周2次。观察29例，治愈20例。发病时间愈短，疗效愈好。鼻窦灌洗出的分泌物属于粘液性者效果最佳，粘液脓性者效果最差。又有用蜂蜜涂于鼻腔患处（涂蜜前先洗净鼻腔的结痂及分泌物），早晚各1次，治疗萎缩性鼻炎5例，经8～29天后，鼻部痛痒及前额疼痛均消失，鼻腔无分泌物及结痂。4例嗅觉完全恢复，1例好转。除2例鼻粘膜尚有萎缩现象外，余均恢复正常。"}]},{"ID":"20240611083312-d8bj279","Type":"NodeParagraph","Properties":{"id":"20240611083312-d8bj279","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"⑧其它"}]},{"ID":"20240611083312-g9xysc9","Type":"NodeParagraph","Properties":{"id":"20240611083312-g9xysc9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"蜂蜜还曾用于下列疾病：㈠急性细菌性痢疾：成人每日150克，分4次服；小儿酌减。㈡便秘：适用于习惯性便秘，老年和孕妇便秘。每晨内服，或用20％蜂蜜水灌肠。㈢贫血：对低色素性贫血有效。治疗后血球与血红蛋白有显著的增加。每日用80～100克，分3次服。㈣阴道滴虫：用蜂蜜装入胶囊塞入阴道。此外，对神经衰弱、高血压、肺结核、心脏病、肝脏病等慢性疾患，内服蜂蜜也有一定的治疗作用或调补作用，一般作为辅助用药。"}]},{"ID":"20240611083312-67fhfwl","Type":"NodeParagraph","Properties":{"id":"20240611083312-67fhfwl","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611083312-mwfqcta","Type":"NodeParagraph","Properties":{"id":"20240611083312-mwfqcta","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"蜂蜜，其入药之功有五：清热也，补中也，解毒也，润燥也，止痛也。生则性凉，故能清热；熟则性温，故能补中；甘而和平，故能解毒；柔而濡泽，故能润燥；缓可以去急，故能止心腹肌肉疮疡之痛；和可以致中，故能调和百药而与甘草同功。张仲景治阳明结燥，大便不通，蜜煎导法，诚千古神方也。\""}]},{"ID":"20240611083312-kapls07","Type":"NodeParagraph","Properties":{"id":"20240611083312-kapls07","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"石蜜，其气清和，其味纯甘，施之精神气血，虚实寒热，阴阳内外诸病，罔不相宜。《经》曰：里不足者，以甘补之。\"\"同芦根汁、梨汁、人乳、牛羊乳、童便，治噎膈大便燥结，用此润之，有痰加竹沥。炼熟和诸丸药及膏子，主润五脏，益血脉，调脾，胃，通三焦。涂火灼疮能缓痛。\""}]},{"ID":"20240611083312-2ureghl","Type":"NodeParagraph","Properties":{"id":"20240611083312-2ureghl","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"③《药品化工》；\"蜂蜜采百花之精，味甘主补，滋养五脏，体滑主利，润泽三焦。如怯弱咳嗽不止，精血枯槁，肺焦叶举，致成肺燥之症，寒热均非，诸药鲜效，用老蜜日服两许，约月未有不应者，是燥者润之之义也。生用通利大肠，老年便结，更宜服之。\""}]},{"ID":"20240611083312-ipdkid0","Type":"NodeParagraph","Properties":{"id":"20240611083312-ipdkid0","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611083312-cjfj72k","Type":"NodeParagraph","Properties":{"id":"20240611083312-cjfj72k","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 另有一种有毒性的蜂蜜，在日本常自石楠科植物的花蜜得来。"}]},{"ID":"20240611083312-1xo8ym6","Type":"NodeParagraph","Properties":{"id":"20240611083312-1xo8ym6","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611083312-kcwqklu","Type":"NodeParagraph","Properties":{"id":"20240611083312-kcwqklu","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611083312-vgy2toz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611083312-vgy2toz","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蜂蜜"}]},{"ID":"20240611083312-uuejvm3","Type":"NodeParagraph","Properties":{"id":"20240611083312-uuejvm3","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611083312-ua87s7i","Type":"NodeParagraph","Properties":{"id":"20240611083312-ua87s7i","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" Fēnɡ Mì"}]},{"ID":"20240611083312-29nh9ka","Type":"NodeParagraph","Properties":{"id":"20240611083312-29nh9ka","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611083312-wwbukv6","Type":"NodeParagraph","Properties":{"id":"20240611083312-wwbukv6","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 石蜜、石饴、食蜜、蜜、白蜜、白沙蜜、蜜糖、沙蜜、蜂糖、"}]},{"ID":"20240611083312-j0drzkt","Type":"NodeParagraph","Properties":{"id":"20240611083312-j0drzkt","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611083312-6gisdse","Type":"NodeParagraph","Properties":{"id":"20240611083312-6gisdse","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" Honey"}]},{"ID":"20240611083312-wo1jlo3","Type":"NodeParagraph","Properties":{"id":"20240611083312-wo1jlo3","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611083312-2zx4vz9","Type":"NodeParagraph","Properties":{"id":"20240611083312-2zx4vz9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 1.出自《 名医别录》：石蜜，生武都山谷、河源山谷及诸山石中。色白如膏者良。"}]},{"ID":"20240611083312-kztzdez","Type":"NodeParagraph","Properties":{"id":"20240611083312-kztzdez","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：石蜜即崖蜜也，高山岩石间作之。色青赤，味小碱，食之心烦。其蜂黑色似虻。又木蜜呼为食蜜，悬树枝作之。色青白。树空及人家养作之者亦白，而浓厚味美。"}]},{"ID":"20240611083312-an7uhvv","Type":"NodeParagraph","Properties":{"id":"20240611083312-an7uhvv","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：按寻常蜜亦有木中作者，亦有土中作者，北方地燥，多在士中，南方地湿，多在木中，各随土地所有而生，其蜜一也。宣州有黄连蜜，色黄味苦，主目热，"}]},{"ID":"20240611083312-9pi856u","Type":"NodeParagraph","Properties":{"id":"20240611083312-9pi856u","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611083312-i1e2doy","Type":"NodeParagraph","Properties":{"id":"20240611083312-i1e2doy","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蜜蜂科动物中华密蜂或意大利蜜蜂所酿的蜜糖。"}]},{"ID":"20240611083312-auv2hsr","Type":"NodeParagraph","Properties":{"id":"20240611083312-auv2hsr","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Apis cerana Fabr2.Apis mellifera L."}]},{"ID":"20240611083312-zr7mpa0","Type":"NodeParagraph","Properties":{"id":"20240611083312-zr7mpa0","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"采收和储藏：蜂蜜采收多在春、夏、秋季进行。取蜜时先将蜂巢割下，置于布袋中将蜜挤出。新式取蜜法是将人工蜂巢取出，置于离 心机内，把蜜摇出过滤，除出蜂蜡和碎片及其他杂质即可。"}]},{"ID":"20240611083312-0kn3zt8","Type":"NodeParagraph","Properties":{"id":"20240611083312-0kn3zt8","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611083312-a68kemg","Type":"NodeParagraph","Properties":{"id":"20240611083312-a68kemg","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 我国大部分地区均有养殖。"}]},{"ID":"20240611083312-eaivjaq","Type":"NodeParagraph","Properties":{"id":"20240611083312-eaivjaq","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611083312-lexm8tp","Type":"NodeParagraph","Properties":{"id":"20240611083312-lexm8tp","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 1.中华蜜蜂，蜂群由工蜂、蜂王及雄蜂组成。工蜂全体被黄褐色毛。头略呈三角形。胸部3节。翅2对，膜质透明。足3对，有采集花粉的构造。腹部圆锥状，有毒腺和螫针。腹下有蜡板4 对，内有蜡腺，分泌蜡质。蜂王体最大，翅短小，腹部特长，生殖器发达，专营生殖产卵。雄蜂较工蜂稍大，头呈球形，尾无毒腺和螫针，足上无采贮花粉构造，腹无蜡板及蜡腺。"}]},{"ID":"20240611083312-hjxo3ul","Type":"NodeParagraph","Properties":{"id":"20240611083312-hjxo3ul","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"2.意大利蜜蜂，体似中华蜜蜂，但较之为大。"}]},{"ID":"20240611083312-dahkckz","Type":"NodeParagraph","Properties":{"id":"20240611083312-dahkckz","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611083312-moz7txd","Type":"NodeParagraph","Properties":{"id":"20240611083312-moz7txd","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 生活习性，蜜蜂是群体生活的社会性昆虫，每群有一个蜂王和大批工蜂（皆为雌性），还有少量的雄蜂共同组成。三种暑在形状、生理功能和生产职能方面各不相同。蜂王专司生殖产卵；雄蜂专司与蜂王（母蜂）产配、授精，交配后好死亡；工蜂的职能有筑巢、采集饲料、哺育幼虫和蜂王、清扫巢室、调节巢温等。密蜂在抗寒和而热方面，都体现出了集群活动的力量，以植物的花蜜、花粉作为主食。"}]},{"ID":"20240611083312-ho7zfs9","Type":"NodeParagraph","Properties":{"id":"20240611083312-ho7zfs9","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"繁殖技术，蜜蜂属完全变态昆虫，在蜜源丰富、天气温暖群热壮大的情况下，一个壮年的蜂王每昼夜可产卵2000-3000粒。分为受精卵和未受精卵两种，未受业卵发育成雄蜂，受精卵产在蜂房中者发育成无生殖能力的工蜂，产在蜂王台基上者（后来由工蜂修成王台），并饲以营养三富的蜂王浆就发育成为蜂王，一般在1个蜂群中只有1个。"}]},{"ID":"20240611083312-e960lvq","Type":"NodeParagraph","Properties":{"id":"20240611083312-e960lvq","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"饲养管理，蜂群的春季管理着重是保温和加巢脾繁殖。夏季管理是先用优良新蜂王，更换老化、产卵力下降的蜂王，并及时扩大蜂巢，高速蜂群。秋季管理应喂好越冬饲料，做到蜂壮、蜜足，为蜂群安全越冬和明年春季蜂群繁殖打下基础。冬季管理以保温为主，但要使巢内空气流通。"}]},{"ID":"20240611083312-t6uahno","Type":"NodeParagraph","Properties":{"id":"20240611083312-t6uahno","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611083312-aop0xj7","Type":"NodeParagraph","Properties":{"id":"20240611083312-aop0xj7","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，本品为半透明、带光泽、浓稠的液体，白色至淡黄色或橘黄色至黄褐色，久置或遇冷渐有白色颗粒状结晶析出。气芳香，味极甜。"}]},{"ID":"20240611083312-a511ebt","Type":"NodeParagraph","Properties":{"id":"20240611083312-a511ebt","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611083312-j0h6qhd","Type":"NodeParagraph","Properties":{"id":"20240611083312-j0h6qhd","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 1.中华蜜蜂，在蜂巢中酿成的糖类物质，主含葡萄糖（glucose），果糖（fructose）；其他还含蔗糖，糊精，有机酸，蛋白质，挥发油，蜡，花粉粒，维生素B1、B2、B6、C、K、H，淀粉酶，转人酶，过氧化酶（peroxidase），酯酶，生长刺激素，乙酰胆碱（acetylcholine），烟酸（nicotinic acid），泛酸（pantothenate;pantothenic acid），胡萝卜素（carotene），无机元素钙、硫、磷、镁、钾、钠、碘等。"}]},{"ID":"20240611083312-tykzdqi","Type":"NodeParagraph","Properties":{"id":"20240611083312-tykzdqi","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"2.意大利蜜蜂，在蜂巢中酿成的糖类物质，主含葡萄糖果糖；其他还含少量蔗糖，糊精，有机酸，蛋白质，挥发油，蜡，维生素B1、B2、B6、C、K、H，淀粉酶，转化酶，过氧化酶，酯酶，α-甘油磷酸盐脱氢酶（α-glycerophosphate dehydrogenase），乙酰胆碱，生长刺激素，泛酸，烟酸，胡萝卜素，花粉粒，并含钙、磷、硫、镁、钾、钠、碘等元素。"}]},{"ID":"20240611083312-zufc825","Type":"NodeParagraph","Properties":{"id":"20240611083312-zufc825","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611083312-rijhggf","Type":"NodeParagraph","Properties":{"id":"20240611083312-rijhggf","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 蜂蜜对创面有收敛、营养和促进愈合作用，有润滑性祛痰和轻泻作用。"}]},{"ID":"20240611083312-fw95hbg","Type":"NodeParagraph","Properties":{"id":"20240611083312-fw95hbg","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611083312-onvnwgi","Type":"NodeParagraph","Properties":{"id":"20240611083312-onvnwgi","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 1.取纯净的蜂蜜，用文火熬炼，过滤去沫。"}]},{"ID":"20240611083312-uyuzlt0","Type":"NodeParagraph","Properties":{"id":"20240611083312-uyuzlt0","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"2.《雷公炮炙论》：凡炼蜜一斤，只得十二两半是数，若火少，火过，并用不得。"}]},{"ID":"20240611083312-txuyloq","Type":"NodeParagraph","Properties":{"id":"20240611083312-txuyloq","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"3.《本草经集注》：凡蜜，皆先火上煎，掠去其沫，令色微黄，则丸经久不坏。"}]},{"ID":"20240611083312-i95chih","Type":"NodeParagraph","Properties":{"id":"20240611083312-i95chih","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：凡炼沙蜜，每斤入水四两，银石器内，以桑柴火慢炼，掠去浮沫，至滴水成珠不散，乃用，渭之水火炼法。又法：以器盛置重汤中煮一日，候滴水不散，取用亦佳，且不伤火也。"}]},{"ID":"20240611083312-ghlihbo","Type":"NodeParagraph","Properties":{"id":"20240611083312-ghlihbo","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611083312-xb0madn","Type":"NodeParagraph","Properties":{"id":"20240611083312-xb0madn","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 理化鉴别（1）酸度检查，取本品10g，加新沸过的冷水50ml，混匀，加酚酞指示液2滴与氢氧化钠液（01.mol/L）4ml，应显粉红色，10s内不消失。"}]},{"ID":"20240611083312-sedwvrh","Type":"NodeParagraph","Properties":{"id":"20240611083312-sedwvrh","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"（2）淀粉、糊精检查，取本品2g，加水10ml，加热煮沸，放冷，加碘试液1滴，不得显蓝色、绿色、红褐色。"}]},{"ID":"20240611083312-ijd0znw","Type":"NodeParagraph","Properties":{"id":"20240611083312-ijd0znw","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"（3）吸收度测主，取蜂密约5.0g，精密称定，置50ml量瓶中，加水约25ml溶解，加15%亚铁氰化钾溶液及30%醋酸锌溶液各0.5ml，加水稀释至刻度（必要时加乙醇1滴消除泡沫），摇匀，用干燥滤约滤过，弃去初滤液，精密量取续滤液各5.0ml，分别置于甲、乙两个具塞试管中，甲管加水5.0ml，乙管加新制的0.2%亚硫酸氢钠溶液5.0ml作空白，混匀，在284nm和336nm的波长处测定吸收度，其吸收度差不行大于0.34。"}]},{"ID":"20240611083312-id3ta2k","Type":"NodeParagraph","Properties":{"id":"20240611083312-id3ta2k","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611083312-9nepitp","Type":"NodeParagraph","Properties":{"id":"20240611083312-9nepitp","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 脾；胃；肺；大肠经"}]},{"ID":"20240611083312-vwjjuf4","Type":"NodeParagraph","Properties":{"id":"20240611083312-vwjjuf4","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611083312-7m3r9h5","Type":"NodeParagraph","Properties":{"id":"20240611083312-7m3r9h5","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 味甘；性平"}]},{"ID":"20240611083312-wwffqgj","Type":"NodeParagraph","Properties":{"id":"20240611083312-wwffqgj","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611083312-dh5k49u","Type":"NodeParagraph","Properties":{"id":"20240611083312-dh5k49u","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 痰湿内蕴、中满痞胀及大便不实者禁服。"}]},{"ID":"20240611083312-dxfbhsl","Type":"NodeParagraph","Properties":{"id":"20240611083312-dxfbhsl","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611083312-koqop6m","Type":"NodeParagraph","Properties":{"id":"20240611083312-koqop6m","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 调补脾胃；缓急止痛；润肺止咳；润肠通便；润肤生肌；解毒。主脘腹虚痛；肺燥咳嗽；肠燥便秘；目赤；口疮；溃疡不敛；风疹瘙痒；水火烫伤；手足（军皮）裂"}]},{"ID":"20240611083312-ywoqwip","Type":"NodeParagraph","Properties":{"id":"20240611083312-ywoqwip","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611083312-blokwju","Type":"NodeParagraph","Properties":{"id":"20240611083312-blokwju","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 内服：冲调，15-30g；或入丸剂、膏剂。外用：适量，涂敷。"}]},{"ID":"20240611083312-o53k7pn","Type":"NodeParagraph","Properties":{"id":"20240611083312-o53k7pn","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611083312-ngmffdv","Type":"NodeParagraph","Properties":{"id":"20240611083312-ngmffdv","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" ①治咳嗽： 白蜜一斤，生姜二斤(取汁)。上二味,先秤铜挑，知斤两讫，纳蜜复秤知数，次纳姜汁，以微火煎令姜汁尽，惟有蜜斤两在，止。旦服如枣大，含一九，日三服。禁一切杂食。 (《千金方》)②治上气咳嗽，喘息，喉中有物，唾血： 杏仁、生姜汁各二升，糖、蜜各一升，猪膏药二合。上五味，先以猪膏煎杏仁黄，出之，以纸拭令净，捣如膏，合姜汁、蜜、糖等，合煎令可丸。服如杏核一枚，日夜六、七服，渐渐加之。 (《干金方》)③治阳阴病，自汗出，若发汗，小便自利者， 此为津液内竭，虽鞭不可攻之，当须自欲大便： 食蜜七合。于铜器内，微火煎，当须凝如饴状，搅之勿令焦着，欲可丸，并手捻作铤，令头锐，大如指，长二寸许，当热时急作，冷则鞭。 以纳谷道中，以手急抱，欲大便时乃去之。 (《伤寒论》)④治高血压，慢性便秘： 蜂蜜一两八钱，黑芝麻一两五钱。先将芝麻蒸熟捣如泥，搅人蜂蜜，用热开水冲化，一日二次分服。(《现代实用中药》)⑤治胃及十二指肠溃疡： 蜂蜜一两八钱，生甘草三钱，陈皮二钱。水适量，先煎甘草、陈皮去渣，冲入蜂蜜。一日三次分服。 (《现代实用中药》)⑥治蛔虫病，吐涎心痛，发作有时，毒药不止： 甘草二两，粉一两重，蜜四两。上三味，以水三升，先煮甘草取二升，去滓，纳粉、蜜，搅令和，煎如薄粥，温服一升，庭即止。 (《金固要瞅甘草粉蜜汤)⑦治疗肿恶毒：生蜜与隔年葱研膏，先刺破徐之，如人行五里许，则疗出，后以热醋汤洗去。 (《济急仙方》)⑧治口疮： 蜜浸大青叶含之。 (《药性论》)⑨治男子阴疮： 蜜煎甘草末，涂之。 (《肘后方》)⑩治痘疮痒甚，误搔成疮，及疮疯痂欲落不落者： 白蜜不拘多少，涂于疮上，其预自落，且无疤瘢，亦不臭秽。 (《普济方》百花膏)(11)治风疹，风癣： 沙蜜一斤，糯饭一厅，面曲五两，熟水五升。同入瓶内封七日成酒，寻以蜜入酒代之，亦良。(〈纲目＞蜜酒)(12)治热油侥痛： 白蜜涂之。 (《梅师集验方》)(13)治黯： 白蜜和茯苓，涂上。(《补缺肘后方》)(14)解乌头毒： 白蜂蜜每次一至四汤匙，温开水冲服。(《上海常用中草药》)"}]},{"ID":"20240611083312-v40vhqs","Type":"NodeParagraph","Properties":{"id":"20240611083312-v40vhqs","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611083312-qai5efb","Type":"NodeParagraph","Properties":{"id":"20240611083312-qai5efb","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 1.治疗胃、十二指肠溃疡：曾观察20例，治疗后15例壁龛消失，3例进步(平均为32天)；18例疼痛完全消失，2例减轻，疼痛消失时间最短6天，平均为22.2天。国外资料报道治疗数百例的痊愈率为82%。。用法：每日用新鲜蜂蜜100g，早、中、晚饭前分服的，至第10日后，每日增至150-200g。或用蜂蜜60ml，0、5%普鲁卡因40ml，混合为1次量，日服3次。"}]},{"ID":"20240611083312-r3662bb","Type":"NodeParagraph","Properties":{"id":"20240611083312-r3662bb","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"2.治疗烧伤：用蜂蜜涂布烧伤创面，能减少渗出液，减轻疼痛，控制感染，促进创面愈合，从而缩短治愈时间。用法：一般 Ⅰ、Ⅱ度中小面积烧伤，创面经清洁处理后，用棉球蘸蜂蜜均匀涂布(不宜大厚或太薄)，早期每日2-3次或4-5次，待形成胶痂后改为每日1-2次。采用暴露疗法。如痂下积有脓液，可将胶痂揭去，清创后再行涂布，创面可重新结成胶痂，迅速愈合。对已感染的或面积较大的皿度烧伤则用蜂蜜纱布敷于创面，外用无菌棉垫包扎。冬天不便使用暴露疗法者，亦可采用此法。蜂蜜中也可加入2%普鲁卡因溶液，配成2：1混合液使用， 以减轻涂药开始时给创面带来的疼痛。有主张在蜂蜜涂布后，创面上再撒布一薄层石膏粉，以增强疗效。据85例观察，1、2度烧伤一般涂布蜂蜜2-3天后，创面便形成透明胶痂6-10天胶痂自行脱落，新生上皮完全生长。晚期入院已有明显感染看，2-3天后创面亦能形成胶痂，并可见痂下上皮细胞生长。采用蜂蜜纱布包扎疗法者，一般经过6-9天肉芽生长良好，2-3周后即可痊愈。在治疗过程中均未发生感染，已感染之创面，涂蜜后脓性分泌物亦逐渐减少。但使用本法时仍应尽力创造无菌条件。对胶痂下的感染情况要留意观察，及时处理。夜关节处的胶痂易于破裂，要注意保护。同时，本疗法仅限于创面处理，其它如止痛、抗感染、补充液体及控制休克等，均需按常规配合进行。"}]},{"ID":"20240611083312-42r63bx","Type":"NodeParagraph","Properties":{"id":"20240611083312-42r63bx","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"3.治疗冻伤、冻疮：对于2度以上有炎症及有分泌物的冻伤，用熟蜂蜜与黄凡士林等量调成软膏，薄薄的涂于无菌纱布上，敷盖于创面，每次数2-3层。敷盖前先将创面清洗干净，敷盖后用敷料包扎固定。一般用药2-3次后，疼痛及炎症渐趋消失，3-7次可望痊愈。对于冻疮，先用温开水洗涤患部，然后涂蜜包扎，间日换药一次。如未破面的，可不必包扎。"}]},{"ID":"20240611083312-3r7233v","Type":"NodeParagraph","Properties":{"id":"20240611083312-3r7233v","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"4.治疗溃疡与外伤：年久不愈的慢性溃疡，可试用10%蜜汁洗涤疮口，然后用纯蜜浸渍的纱布条敷于创面，敷料包扎，间日换药1次。曾试治两例下肢溃疡，l周后即有肉芽新生，约2个月即愈。另试治1例梅毒性溃疡，结果无效。皮肤与肌肉的外伤，可用10%蜜汁洗涤伤口，然后涂蜜包扎，能防止感染，获得一期愈合。"}]},{"ID":"20240611083312-h9x78rl","Type":"NodeParagraph","Properties":{"id":"20240611083312-h9x78rl","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"5.治疗皮炎：对过敏性皮炎及湿疹等，用蜂蜜100ml，加氧化锌10g，淀粉20g，制成软膏外搽。用药后可使红疹消退，渗出物减少，痒感消失。治疗尿布皮炎，先用温水洗净患部，而后用蜂蜜涂搽，每日 1-2次。"}]},{"ID":"20240611083312-lnvxucy","Type":"NodeParagraph","Properties":{"id":"20240611083312-lnvxucy","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"6.治疗角膜溃疡及睑缘炎：用蜂蜜制成5%滴眼液滴眼，治疗角膜溃疡29例，治愈22例，进步4例，无效3例。一般在用药 l、2天后，溃疡即由进行性转为静止，基底清洁，透明度增加，浸润边缘消失。奏效的原因可能是增强机体防御能力，或影响病变部位的新陈代谢。用蜂蜜外涂，每日3次，治疗脸缘炎76例，中均3.5天治愈。"}]},{"ID":"20240611083312-9wx3lsf","Type":"NodeParagraph","Properties":{"id":"20240611083312-9wx3lsf","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"7.治疗鼻炎和鼻窦炎：对慢性鼻炎采用40%蜂蜜行离子透入法治疗，每日1次，电流强度 1-5毫安，时间15-20分钟，14次为一疗程。如需行第二疗程时，休息 1个月后再继续进行。50例患者经 14-24次治疗后，11例痊愈，18例好转,11例减轻，10例无效。对上颌窦炎，经穿刺灌洗后注入20%或40%蜂蜜2ml，每周2次。观察29例，治愈20例。发病时间愈短，疗效愈好。鼻窦灌洗出的分泌物属于粘液性者效果最佳，粘液脓性者效果最差。又有用蜂蜜涂于鼻腔患处(涂蜜前先洗净鼻腔的结痂及分泌物)， 早晚各1次，治疗萎缩性鼻炎5例，经8-29天后，鼻部痛痒及前额疼痛均消失，鼻腔无分泌物及结痂 。4例嗅觉完全恢复，1例好转。除2例鼻粘膜尚有萎缩现象外，余均恢复正常。"}]},{"ID":"20240611083312-ecobxnz","Type":"NodeParagraph","Properties":{"id":"20240611083312-ecobxnz","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"8.其它：蜂蜜还曾用于下列疾病：8.1.急性细菌性痢疾：成人每日150g，分4次服；小儿酌减。"}]},{"ID":"20240611083312-di8ibep","Type":"NodeParagraph","Properties":{"id":"20240611083312-di8ibep","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"8.2.便秘：适用于习惯性便秘，老年和孕妇便秘。每晨内服，或用20%蜂蜜水灌肠。"}]},{"ID":"20240611083312-jd7czlg","Type":"NodeParagraph","Properties":{"id":"20240611083312-jd7czlg","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"8.3.贫血：对低色素性贫血有效。治疗后血球与血红蛋白有显着的增加。每日用80-100g，分3次服。"}]},{"ID":"20240611083312-rvlayv3","Type":"NodeParagraph","Properties":{"id":"20240611083312-rvlayv3","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"8.4.阴道滴虫：用蜂蜜装入胶囊塞入阴道。此外，对神经衰弱、高血压、肺结核、心脏病、肝脏病等慢性疾患，内服蜂蜜也有一定的治疗作用或调补作用，一般作为辅助用药。"}]},{"ID":"20240611083312-wp00sca","Type":"NodeParagraph","Properties":{"id":"20240611083312-wp00sca","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611083312-eo5vba2","Type":"NodeParagraph","Properties":{"id":"20240611083312-eo5vba2","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主心腹邪气，诸惊痫，安五脏诸不足，益气补中，止痛解毒，和百药。"}]},{"ID":"20240611083312-d7i9l31","Type":"NodeParagraph","Properties":{"id":"20240611083312-d7i9l31","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"2.《出自《名医别录》》：养脾气，除心烦，食饮不下，肌中疼痛，口疮，明耳目。"}]},{"ID":"20240611083312-vfb8v9c","Type":"NodeParagraph","Properties":{"id":"20240611083312-vfb8v9c","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：主牙齿疳疮，目肤赤障，杀虫。"}]},{"ID":"20240611083312-ti2nlzw","Type":"NodeParagraph","Properties":{"id":"20240611083312-ti2nlzw","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"4.《本草衍义》：汤火伤涂之痛止，仍捣薤白相和。"}]},{"ID":"20240611083312-ou4f0t8","Type":"NodeParagraph","Properties":{"id":"20240611083312-ou4f0t8","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：和营卫、润脏腑，通三焦，调脾胃。"}]},{"ID":"20240611083312-wa6ws8u","Type":"NodeParagraph","Properties":{"id":"20240611083312-wa6ws8u","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611083312-kw88fvs","Type":"NodeParagraph","Properties":{"id":"20240611083312-kw88fvs","updated":"20240611083312"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611083227-p7k33h9","Type":"NodeThematicBreak","Properties":{"id":"20240611083227-p7k33h9"}}]}