pan","Properties":{"parent-style":"width: 402px;","style":"width: 392px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大枣 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大枣 11-20240812083143-g7yqum6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 392px;\" parent-style=\"width: 402px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 829px;","style":"width: 819px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大枣 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大枣 10-20240812083056-3gy1mp8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 819px;\" parent-style=\"width: 829px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812081534-12kfwdk","Type":"NodeParagraph","Properties":{"id":"20240812081534-12kfwdk","updated":"20240812083512"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 451px;","style":"width: 441px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大枣"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大枣-20240812081534-hrq26yc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 441px;\" parent-style=\"width: 451px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 804px;","style":"width: 794px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大枣 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大枣 1-20240812081646-0x6fa3u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 794px;\" parent-style=\"width: 804px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611095714-pj9tox5","Type":"NodeThematicBreak","Properties":{"id":"20240611095714-pj9tox5"}},{"ID":"20240611095719-vs3ldzu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095719-vs3ldzu","updated":"20240611095724"},"Children":[{"Type":"NodeText","Data":"大枣《神农本草经》"}]},{"ID":"20240611095719-6j4q7x8","Type":"NodeParagraph","Properties":{"id":"20240611095719-6j4q7x8","updated":"20240611095719"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240611095719-8s4oo3p","Type":"NodeParagraph","Properties":{"id":"20240611095719-8s4oo3p","updated":"20240611095719"},"Children":[{"Type":"NodeText","Data":"主心腹邪气，安中养脾肋十二经，平胃气，通九窍，补少气，少津液，身中不足，大惊，四肢重，和百药。久服轻身长年，叶覆麻黄，能令出汗。生平泽。"}]},{"ID":"20240611095719-41409gh","Type":"NodeParagraph","Properties":{"id":"20240611095719-41409gh","updated":"20240611095719"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：枣主调中，益脾气，令人好颜色，美志气。（《大观本草》引吴氏本草）"}]},{"ID":"20240611095719-n2qxjpa","Type":"NodeParagraph","Properties":{"id":"20240611095719-n2qxjpa","updated":"20240611095719"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名干枣，一名美枣，一名良枣，八月采，曝干，生河东。"}]},{"ID":"20240611095719-s02ouuz","Type":"NodeParagraph","Properties":{"id":"20240611095719-s02ouuz","updated":"20240611095719"},"Children":[{"Type":"NodeText","Data":"案《说文》云：枣，羊枣也。《尔雅》云：遵羊枣。郭璞云：实小而圆，紫黑色，今俗呼之为羊矢枣，又洗大枣。郭璞云：今河东猗氏县，出大枣子，如鸡卵。"}]},{"ID":"20240611100038-5wsw0gt","Type":"NodeThematicBreak","Properties":{"id":"20240611100038-5wsw0gt"}},{"ID":"20240611100050-4c7qs78","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100050-4c7qs78","updated":"20240611100057"},"Children":[{"Type":"NodeText","Data":"大枣《本草备要》"}]},{"ID":"20240611100050-472riuk","Type":"NodeParagraph","Properties":{"id":"20240611100050-472riuk","updated":"20240611100050"},"Children":[{"Type":"NodeText","Data":"补脾胃，润心肺，和百药"}]},{"ID":"20240611100050-ep7dy3w","Type":"NodeParagraph","Properties":{"id":"20240611100050-ep7dy3w","updated":"20240611100050"},"Children":[{"Type":"NodeText","Data":"甘油。脾经血分药。补中益气，滋脾土，润心肺，调营卫，缓阴血，生津液，悦颜色，通九窍，助十二经，和百药。伤寒及补剂加用之，以发脾胃升腾之气。多食损齿（齿属肾，土克水），中满证忌之（甘令人满。大建中汤心下痞者，减饧、枣与甘草同例。成无己曰∶仲景治奔豚用大枣者，滋脾土以平肾气也。治水饮胁痛，有十枣汤，益脾土以胜妄水也）。"}]},{"ID":"20240611100050-uil67ct","Type":"NodeParagraph","Properties":{"id":"20240611100050-uil67ct","updated":"20240611100050"},"Children":[{"Type":"NodeText","Data":"北产肥润者良（昂按∶金华南枣，更胜于北，徽宁所产，亦有佳者）。杀乌、附毒。忌葱、鱼同食。"}]},{"ID":"20240611100103-uz6zilm","Type":"NodeThematicBreak","Properties":{"id":"20240611100103-uz6zilm"}},{"ID":"20240611100104-9ix1obp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100104-9ix1obp","updated":"20240611100108"},"Children":[{"Type":"NodeText","Data":"大枣《本草分经》"}]},{"ID":"20240611100104-dwptliv","Type":"NodeParagraph","Properties":{"id":"20240611100104-dwptliv","updated":"20240611100104"},"Children":[{"Type":"NodeText","Data":"甘温，补中益气，滋脾土润心肺，调营卫通九窍，助十二经，和百药，脾病患宜食之。加入补剂与姜并行，能发脾胃升腾之气。风疾痰疾俱非所宜。红枣功用相仿，而力稍逊。"}]},{"ID":"20240611100104-tp4quhm","Type":"NodeParagraph","Properties":{"id":"20240611100104-tp4quhm","updated":"20240611100104"},"Children":[{"Type":"NodeText","Data":"南枣不入药。生枣甘辛，多食生寒热。"}]},{"ID":"20240611100114-jb7pzqb","Type":"NodeThematicBreak","Properties":{"id":"20240611100114-jb7pzqb"}},{"ID":"20240611100116-e4jwt8d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100116-e4jwt8d","updated":"20240611100122"},"Children":[{"Type":"NodeText","Data":"大枣《吴普本草》"}]},{"ID":"20240611100116-fry1kg9","Type":"NodeParagraph","Properties":{"id":"20240611100116-fry1kg9","updated":"20240611100116"},"Children":[{"Type":"NodeText","Data":"《证类》卷二十三"}]},{"ID":"20240611100116-d6lfkrd","Type":"NodeParagraph","Properties":{"id":"20240611100116-d6lfkrd","updated":"20240611100116"},"Children":[{"Type":"NodeText","Data":"一名良枣。主调中，益脾气，令人好颜色，美志气。"}]},{"ID":"20240611100116-qc78ld8","Type":"NodeParagraph","Properties":{"id":"20240611100116-qc78ld8","updated":"20240611100116"},"Children":[{"Type":"NodeText","Data":"果类《御览》卷九百九十三"}]},{"ID":"20240611100116-gl330jq","Type":"NodeParagraph","Properties":{"id":"20240611100116-gl330jq","updated":"20240611100116"},"Children":[{"Type":"NodeText","Data":"一名决盆。"}]},{"ID":"20240611100137-odzh6s8","Type":"NodeThematicBreak","Properties":{"id":"20240611100137-odzh6s8"}},{"ID":"20240611100138-hafje1b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100138-hafje1b","updated":"20240611100142"},"Children":[{"Type":"NodeText","Data":"枣《本草纲目》"}]},{"ID":"20240611100138-nxagfuq","Type":"NodeParagraph","Properties":{"id":"20240611100138-nxagfuq","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"「气味」甘、辛、热、无毒。"}]},{"ID":"20240611100138-38bit2m","Type":"NodeParagraph","Properties":{"id":"20240611100138-38bit2m","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611100138-bsmazsr","Type":"NodeParagraph","Properties":{"id":"20240611100138-bsmazsr","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"1、调和胃气。用干枣去核，缓火烤燥，研为末，加少量生姜末，开水送服。"}]},{"ID":"20240611100138-oax1ga4","Type":"NodeParagraph","Properties":{"id":"20240611100138-oax1ga4","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"2、反胃吐食。用大枣一枚去核，加斑蝥一个去头翅，一起煨熟，去斑蝥，空心服，开水送下。"}]},{"ID":"20240611100138-lp6940v","Type":"NodeParagraph","Properties":{"id":"20240611100138-lp6940v","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"3、伤寒病后，口干咽痛、喜唾。用大枣二十枚、乌梅十枚，捣烂，加蜜做成丸仓，口含咽汁，甚效。"}]},{"ID":"20240611100138-ulg4als","Type":"NodeParagraph","Properties":{"id":"20240611100138-ulg4als","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"4、妇女脏燥（悲伤欲器，精神不正常）。用大枣十枚、小麦一升、甘草二两、合并后每取一两小煎服。此方名“大枣汤”，亦补脾气。"}]},{"ID":"20240611100138-xtplju2","Type":"NodeParagraph","Properties":{"id":"20240611100138-xtplju2","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"5、大便燥塞。有大枣一枚去核，加轻粉半钱入枣中，煨熟服，枣汤送下。"}]},{"ID":"20240611100138-bfzmquo","Type":"NodeParagraph","Properties":{"id":"20240611100138-bfzmquo","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"6、烦闷不眠。用大枣十四枚、葱白七根，加水三程式煮成一升，一次服下。"}]},{"ID":"20240611100138-dg9lura","Type":"NodeParagraph","Properties":{"id":"20240611100138-dg9lura","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"7、上气咳嗽。用枣二十枚，去核，以酥四两，微火煎，倒入枣肉中渍尽酥，取枣收存。常含一枚，微微咽汁。"}]},{"ID":"20240611100138-exhja1t","Type":"NodeParagraph","Properties":{"id":"20240611100138-exhja1t","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"8、肺疽吐血。用红枣（连核烧存性）、面药煎（煅过），等分为还想。每服二钱，米汤送下。"}]},{"ID":"20240611100138-mb6c3ke","Type":"NodeParagraph","Properties":{"id":"20240611100138-mb6c3ke","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"9、耳聋鼻塞。取大枣十五枚（去皮、核）、蓖麻子三百枚（去皮），一起捣碎，棉裹塞耳鼻，一天一次，经一个多月，即可闻声音和辩香自。先治耳，后治鼻，不可并塞。"}]},{"ID":"20240611100138-dw1y03q","Type":"NodeParagraph","Properties":{"id":"20240611100138-dw1y03q","updated":"20240611100138"},"Children":[{"Type":"NodeText","Data":"10、诸疮久溃。用枣膏三程式煎水频洗。"}]},{"ID":"20240611100215-ucudvck","Type":"NodeThematicBreak","Properties":{"id":"20240611100215-ucudvck"}},{"ID":"20240611100216-t15whwi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100216-t15whwi","updated":"20240611100221"},"Children":[{"Type":"NodeText","Data":"大枣《药征》"}]},{"ID":"20240611100216-7ms52xc","Type":"NodeParagraph","Properties":{"id":"20240611100216-7ms52xc","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"主治挛引强急也。旁治咳嗽、奔豚、烦躁、身疼、胁痛、腹中痛。"}]},{"ID":"20240611100216-yoxft66","Type":"NodeParagraph","Properties":{"id":"20240611100216-yoxft66","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240611100216-cvovbna","Type":"NodeParagraph","Properties":{"id":"20240611100216-cvovbna","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"十枣汤证曰∶引胁下痛。又曰∶咳烦、胸中痛。"}]},{"ID":"20240611100216-z83te4y","Type":"NodeParagraph","Properties":{"id":"20240611100216-z83te4y","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"葶苈大枣汤证曰∶咳逆上气、喘鸣迫塞。又曰∶不得息。"}]},{"ID":"20240611100216-7qz0uc6","Type":"NodeParagraph","Properties":{"id":"20240611100216-7qz0uc6","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"以上二方，以大枣为君药，一则十枚，一则十二枚。"}]},{"ID":"20240611100216-jdz18qj","Type":"NodeParagraph","Properties":{"id":"20240611100216-jdz18qj","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"苓桂甘枣汤证曰∶欲作奔豚。"}]},{"ID":"20240611100216-b6gx1qe","Type":"NodeParagraph","Properties":{"id":"20240611100216-b6gx1qe","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"越婢汤，证不具也。（说在《类聚方》）"}]},{"ID":"20240611100216-otdiwvm","Type":"NodeParagraph","Properties":{"id":"20240611100216-otdiwvm","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"生姜甘草汤，证不具也。（说在互考中）"}]},{"ID":"20240611100216-66qrwso","Type":"NodeParagraph","Properties":{"id":"20240611100216-66qrwso","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"以上三方，大枣皆十五枚。"}]},{"ID":"20240611100216-qlxiqtb","Type":"NodeParagraph","Properties":{"id":"20240611100216-qlxiqtb","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"甘麦大枣汤证曰∶脏躁、喜悲伤。"}]},{"ID":"20240611100216-te1kyqv","Type":"NodeParagraph","Properties":{"id":"20240611100216-te1kyqv","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"以上一方，大枣十枚。"}]},{"ID":"20240611100216-pveid01","Type":"NodeParagraph","Properties":{"id":"20240611100216-pveid01","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"小柴胡汤证曰∶颈项强。又云∶胁痛。"}]},{"ID":"20240611100216-4kasvrv","Type":"NodeParagraph","Properties":{"id":"20240611100216-4kasvrv","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"小建中汤证曰∶急痛。"}]},{"ID":"20240611100216-k6ta5cf","Type":"NodeParagraph","Properties":{"id":"20240611100216-k6ta5cf","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"大青龙汤证曰∶身疼痛、汗不出而烦躁。"}]},{"ID":"20240611100216-5nznv54","Type":"NodeParagraph","Properties":{"id":"20240611100216-5nznv54","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"黄连汤证曰∶腹中痛。"}]},{"ID":"20240611100216-tup4ssu","Type":"NodeParagraph","Properties":{"id":"20240611100216-tup4ssu","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"葛根汤证曰∶项背强。"}]},{"ID":"20240611100216-1cawslx","Type":"NodeParagraph","Properties":{"id":"20240611100216-1cawslx","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"黄芩汤，证不具也。（说在《类聚方》）"}]},{"ID":"20240611100216-kxi7cyx","Type":"NodeParagraph","Properties":{"id":"20240611100216-kxi7cyx","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"桂枝加黄 汤证曰∶身疼重、烦躁。"}]},{"ID":"20240611100216-50itvgi","Type":"NodeParagraph","Properties":{"id":"20240611100216-50itvgi","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"吴茱萸汤证曰∶烦躁。"}]},{"ID":"20240611100216-ejsksfy","Type":"NodeParagraph","Properties":{"id":"20240611100216-ejsksfy","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"以上八方，大枣皆十二枚。"}]},{"ID":"20240611100216-5hqugm1","Type":"NodeParagraph","Properties":{"id":"20240611100216-5hqugm1","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"上历试此诸方。皆其所举诸证，而有挛引强急之状者，用大枣则治矣，不则无效也。且也十枣汤，大枣为君药，而有引痛证，斯可以为征已。"}]},{"ID":"20240611100216-pg7rh2a","Type":"NodeParagraph","Properties":{"id":"20240611100216-pg7rh2a","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240611100216-uu6e3ty","Type":"NodeParagraph","Properties":{"id":"20240611100216-uu6e3ty","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"甘麦大枣汤条，有喜悲伤证，此毒之逼迫也，故用大枣以治挛引强急，用甘草、小麦以缓迫急也。"}]},{"ID":"20240611100216-k5ustya","Type":"NodeParagraph","Properties":{"id":"20240611100216-k5ustya","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"苓桂甘枣汤条，有奔豚证，此其毒动而上冲，有挛引强急之状者，故用大枣也；生姜甘草汤证曰∶咳唾涎沫不止。为则按∶若之人患，胸中有挛引强急之状，故用大枣居多也。"}]},{"ID":"20240611100216-fz03whw","Type":"NodeParagraph","Properties":{"id":"20240611100216-fz03whw","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"为则按∶仲景氏用大枣、甘草、芍药，其证候大同而小异，要在自得焉耳。"}]},{"ID":"20240611100216-ntez7xq","Type":"NodeParagraph","Properties":{"id":"20240611100216-ntez7xq","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"【辨误】"}]},{"ID":"20240611100216-fgxgkd2","Type":"NodeParagraph","Properties":{"id":"20240611100216-fgxgkd2","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"大枣养脾胃之说，非古也，不取焉。古人云∶攻病以毒药，养精以谷肉果菜。夫攻之与养，所主不同，一物而二义。如曾晰之于羊枣，好而食之是养也。如十枣汤，用大枣，恶而不避，是攻也。无他嗜好之品，而充食用，则为养也。而充药物，则为攻也。十枣汤，大枣为君，而治挛引强急，岂以为养哉？"}]},{"ID":"20240611100216-xtb95so","Type":"NodeParagraph","Properties":{"id":"20240611100216-xtb95so","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240611100216-o40q2gq","Type":"NodeParagraph","Properties":{"id":"20240611100216-o40q2gq","updated":"20240611100216"},"Children":[{"Type":"NodeText","Data":"大枣 汉种者为良。其品核小而肉浓也，不去核而锉用之。"}]},{"ID":"20240611100229-zq7wp3h","Type":"NodeThematicBreak","Properties":{"id":"20240611100229-zq7wp3h"}},{"ID":"20240611100230-7a7b1ao","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100230-7a7b1ao","updated":"20240611100237"},"Children":[{"Type":"NodeText","Data":"大枣《本经逢原》"}]},{"ID":"20240611100230-kkns4jx","Type":"NodeParagraph","Properties":{"id":"20240611100230-kkns4jx","updated":"20240611100230"},"Children":[{"Type":"NodeText","Data":"甘平无毒，入药取大红枣擘去核用。多食令齿生 。《本经》主心腹邪气，安中养脾气，平胃气，通九窍，助十二经，补少气少津液，身中不足，大惊，四肢重，和百药。"}]},{"ID":"20240611100230-7x665q4","Type":"NodeParagraph","Properties":{"id":"20240611100230-7x665q4","updated":"20240611100230"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"枣属土而有火，为脾经血分药。甘先入脾，故用姜枣之辛甘，以和营卫也。仲景治奔豚用湿脾土平肾气也。十枣汤用以益土胜邪水也，而中满者勿食。故仲景建中汤心下痞者减饴，枣与甘草同例，此得用枣之法矣。《金匮》治妇人脏躁、悲愁欲哭，有甘麦大枣汤，亦取其助肝脾肺三经之津液，以滋其燥耳。"}]},{"ID":"20240611100230-th35h8b","Type":"NodeParagraph","Properties":{"id":"20240611100230-th35h8b","updated":"20240611100230"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹邪气，亦是和营卫邪之义。平胃气者，以其甘温健运善平胃中敦阜之气也。《素问》以枣为脾家之果。故《本经》又主身中不足，大惊，四肢重，用此补益脾津而神气自宁，肢体自捷矣。古方中用大枣皆是红枣，取生能散表也。入补脾药，宜用南枣，取甘能益津也。其黑枣助湿中火，损齿生虫，入药非宜。生枣多食令人热渴气胀，瘦人多火者弥不可食。"}]},{"ID":"20240611100147-7o5hnw6","Type":"NodeThematicBreak","Properties":{"id":"20240611100147-7o5hnw6"}},{"ID":"20240611100149-j78a0n5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100149-j78a0n5","updated":"20240611100154"},"Children":[{"Type":"NodeText","Data":"大枣《本草害利》"}]},{"ID":"20240611100149-40tic43","Type":"NodeParagraph","Properties":{"id":"20240611100149-40tic43","updated":"20240611100149"},"Children":[{"Type":"NodeText","Data":"〔害〕虽能补中而益气，然味过于甘，甘令人满，脾必病也。故中满勿服。凡风痰、痰热及齿痛，俱非所宜。小儿疳病亦禁。生者尤为不利，多食致寒热。热渴膨胀，动脏腑，损脾元，助湿热。凡形羸瘦者，不可食。杀乌附毒。忌葱鱼同食。"}]},{"ID":"20240611100149-uol4fl3","Type":"NodeParagraph","Properties":{"id":"20240611100149-uol4fl3","updated":"20240611100149"},"Children":[{"Type":"NodeText","Data":"〔利〕甘平，调中益气，滋脾土，润心肺，和营卫，缓阴血，生津液，悦颜色，和百药。"}]},{"ID":"20240611100149-pxfb1x3","Type":"NodeParagraph","Properties":{"id":"20240611100149-pxfb1x3","updated":"20240611100149"},"Children":[{"Type":"NodeText","Data":"红枣，功用相仿，差不及尔。"}]},{"ID":"20240611100149-ub2t3n9","Type":"NodeParagraph","Properties":{"id":"20240611100149-ub2t3n9","updated":"20240611100149"},"Children":[{"Type":"NodeText","Data":"〔修治〕擘去核用，青州枣，核细形大，多膏甚甜特佳。晒。晋州枣，肥大甘美，次之。"}]},{"ID":"20240611100149-hyyqoe5","Type":"NodeParagraph","Properties":{"id":"20240611100149-hyyqoe5","updated":"20240611100149"},"Children":[{"Type":"NodeText","Data":"频食生虫损齿，贻害多矣。红枣益脾胃，余者止可充食。入和解药，姜汁炒香，入醒胃药，但去核炒香糊丸，药蒸透，乘热去皮核捣烂。"}]},{"ID":"20240611100126-u3lc3q9","Type":"NodeThematicBreak","Properties":{"id":"20240611100126-u3lc3q9"}},{"ID":"20240611100128-hu8gbtr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100128-hu8gbtr","updated":"20240611100132"},"Children":[{"Type":"NodeText","Data":"大枣《千金翼方》"}]},{"ID":"20240611100128-lfx53n9","Type":"NodeParagraph","Properties":{"id":"20240611100128-lfx53n9","updated":"20240611100128"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主心腹邪气，安中养脾，助十二经，平胃气，通九窍，补少气少津液，身中不足，大惊，四肢重，和百药，补中益气，强力，除烦闷，疗心下悬，肠 。久服轻身，长年不饥，神仙。一名干枣，一名美枣，一名良枣。八月采，曝干。"}]},{"ID":"20240611100051-7jrvq8y","Type":"NodeThematicBreak","Properties":{"id":"20240611100051-7jrvq8y"}},{"ID":"20240611100039-ysa1zvi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100039-ysa1zvi","updated":"20240611100044"},"Children":[{"Type":"NodeText","Data":"大枣《本草思辨录》"}]},{"ID":"20240611100039-molyimu","Type":"NodeParagraph","Properties":{"id":"20240611100039-molyimu","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"大枣色赤味甘，为火土合德，甘中带辛，其木多刺，则微兼乎金，故能安中润液而通九窍。通九窍之效，非如细辛木通速而易见，以火金之用为土德所掩也。"}]},{"ID":"20240611100039-xf7sof0","Type":"NodeParagraph","Properties":{"id":"20240611100039-xf7sof0","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"生姜味辛色黄，由阳明入卫。大枣味甘色赤，由太阴入营。其能入营，由于甘中有辛，惟甘守之用多，得生姜乃不至过守。生姜辛通之用多，得大枣乃不至过通。二物并用，所以为和营卫之主剂。"}]},{"ID":"20240611100039-9c0yphq","Type":"NodeParagraph","Properties":{"id":"20240611100039-9c0yphq","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"太阴湿土贵乎湿润，湿润太过则宜白术，湿润不及则宜大枣。大枣肉浓含津，不能挤泌而分，正有似乎湿土，故本经主安中养脾少津液。然其甘壅之弊亦伏于是，故腹满最忌，胸满心满不忌。胁下者，少阳厥阴往来之路，而肝血脾实统之。枣补脾而性腻，亦能滞肝，故胁下至于痞硬亦忌之，但满不忌。"}]},{"ID":"20240611100039-n5697e8","Type":"NodeParagraph","Properties":{"id":"20240611100039-n5697e8","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"硬在心下，非胁下比矣；然脾之支脉从胃注心，枣不能无忌，而较胁下则次之。仲圣法，和营卫以生姜三两、大枣十二枚为相当之数，生姜泻心汤、旋复代赭汤、大柴胡汤，皆心下硬也，枣如常数、而生姜用至四两五两，以硬不在胁下，故枣不去；枣之弊宜杜，故生姜加多也。"}]},{"ID":"20240611100039-mr1tzdm","Type":"NodeParagraph","Properties":{"id":"20240611100039-mr1tzdm","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"然则甘草泻心汤，何以心下硬而生姜且无之？是则有故也，下利日数十行、谷不化、腹中雷鸣，脾之虚甚矣。枣乃脾家专药，脾虚自捷趋于脾，何至上怫其心，此与半夏泻心汤皆病属下后，非若生姜泻心旋复代赭之为汗后，大柴胡之有往来寒热，宜和营卫而生姜必不可去也。"}]},{"ID":"20240611100039-y5u73b5","Type":"NodeParagraph","Properties":{"id":"20240611100039-y5u73b5","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"腹满必不宜枣，然亦间有用者。浓朴七物汤之腹满是实满，实则当下，枣尤大忌。不知病不止腹满也，发热十日脉浮数，表亦有邪，治兼表里，故合小承气桂枝两汤而微变之。浓朴治腹满专药，既以为君，又加生姜至五两，减枣为十枚，何患乎枣之甘壅。仲圣所以不去之者，桂枝汤为解肌和营卫之剂，解肌不能无桂枝，和营卫不能有姜无枣。芍药所以去之者，病本无汗，不当敛其卫气，况有小承气更加芍药，则是脾约之治法，桂枝生姜，尚何望其解肌。是则腹满之有枣，为与生姜和营卫，又有层层顾虑之精心，寓乎其间，非苟焉者也。"}]},{"ID":"20240611100039-c293jy2","Type":"NodeParagraph","Properties":{"id":"20240611100039-c293jy2","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"有和营卫而姜枣之数加多者，竹叶汤是也。风之中人，每带严寒肃杀之气而来，适逢产后阳虚，遂至发热头痛面赤而喘，是邪发太阳兼真阳上越之证。喘非卫实，故只以桂枝桔防开太阳而不用麻杏。若面赤而头项亦强，则为邪入阳明，将欲作痉，故以葛根起阴气而柔筋，附在上之风热，惟竹叶能散之，故以竹叶标方名，明非他中风之比。药具阴阳，故又加人参以和之。且参能偕葛根生津，协附草固里也。然则姜枣之加多何为，产后本已汗出表虚，此复取汗以解邪，岂寻常和营卫之数，能胜其任者哉。"}]},{"ID":"20240611100039-7zarjmb","Type":"NodeParagraph","Properties":{"id":"20240611100039-7zarjmb","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"有和营卫而姜枣之数加少者，柴胡桂枝汤是也。柴胡桂枝两方，皆取微似汗。此合两方为一方，不在取汗而在化太少两经之邪，使药力微偏于里，故虽和营卫而姜枣特减其数也。"}]},{"ID":"20240611100039-c9loowb","Type":"NodeParagraph","Properties":{"id":"20240611100039-c9loowb","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"有姜枣并用，而数不相当即非和营卫者，一为吴茱萸汤。呕加生姜，寒多加生姜，内有久寒加吴茱萸生姜，仲圣固恒言之矣。盖吴茱萸辟厥阴之寒邪，生姜散阳明之呕逆。生姜治寒，是散而上之；吴茱萸治寒，是辟而下之。吴茱萸汤二物并用，所治皆寒证之重者，故生姜用至六两。胃受肝邪，其虚已甚，故以枣与人参大补其中，非与生姜和营卫也。一为当归四逆加吴茱萸生姜汤。当归四逆之用枣，说具于下。此加茱姜，因内有久寒，非茱姜不足以除之。其数更多于吴茱萸汤者，以此兼脉细欲绝之血寒也。一为橘皮竹茹汤。橘姜并用之方，有橘枳生姜汤，有橘皮汤。胸中气塞短气，只肺胃之气结。干呕哕手足厥，明系哕由于呕而作，视单呕者轻。干呕而哕，故气不行于四肢，亦只须利脾肺之气，宣阳明之阳。盖以橘皮辛温而苦，能利水谷，为脾肺之散药泄药。生姜辛而微温，为肺胃之散药升药。二物有相须之益，故常并用。此哕逆而用橘姜，意亦如是。徐氏以橘皮与竹茹、一寒一温为对待释之，失其旨矣。夫胃逆总由于肝逆胆逆∶肝逆则寒，以吴茱萸逐肝寒；胆逆则热，以竹茹泄胆热。"}]},{"ID":"20240611100039-uhn84vn","Type":"NodeParagraph","Properties":{"id":"20240611100039-uhn84vn","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"此天然对待之药。方用竹茹，是为胆逆而哕。惟橘皮用至二斤，生姜用至半斤，热除气平而中亦惫矣。大枣参草，所以补中而善后也。一为黄 桂枝五物汤。桂枝汤，外证得之为解肌和营卫，内证得之为化气调阴阳。（徐忠可语）此治血痹阴阳俱微，故于桂枝汤中重加生姜以宣阳，加黄 以开痹。枣得芍药则化阴，得桂枝则化阳，虽安中而仍能走表。若再加甘草，则守之太过，故大枣不可无而甘草必去之。一为射干麻黄汤。证属肺家邪实，用生姜是与麻黄同泄肺邪，肺泄则伤，即宜安中生金而杜后患，故入大枣为随剿随抚之策。以无桂枝杏仁，故麻黄生姜俱用至四两，大枣只缘麻姜多而佐之，故减为七枚。一为炙甘草汤。病至脉结代、心动悸，不止营卫之不和矣，治以益营补中，则脉复而悸平。生姜与参桂麻麦胶地清酒并施，所以益营而通脉。营出中焦，中不治则血不生，故用枣草以补中而数较生姜为多也。"}]},{"ID":"20240611100039-spcsx9h","Type":"NodeParagraph","Properties":{"id":"20240611100039-spcsx9h","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"有姜枣并用，而数相当亦非和营卫者，黄芩加半夏生姜汤是也。黄芩汤之用枣，说具于下。此加夏姜，专为治呕。姜不加多者，多则于自利有妨也。姜枣之数相当者，适然之事也。"}]},{"ID":"20240611100039-6750evm","Type":"NodeParagraph","Properties":{"id":"20240611100039-6750evm","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"（试更举有枣无姜之方，疏之以毕其义。一为当归四逆汤。厥阴血虚中寒，用桂枝汤内四物加当归细辛通草，所以温血散寒而通脉。散不宜过，故生姜去之。枣加多者，以能补中而随当归辈生血液也。一为黄芩汤。太阳少阳合病下利与太阳阳明合病下利，何以治法迥异？"}]},{"ID":"20240611100039-yk8dov2","Type":"NodeParagraph","Properties":{"id":"20240611100039-yk8dov2","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"盖太阳去阳明最近，虽下利而太阳之邪在表者，曾不少衰，故以葛根从阳明达太阳之药，协麻桂解之于表。加芍药者，约三物峻发之性而使之回旋两经也。太阳去少阳较远，既下利则热气内淫，不能挽少阳之邪，转从太阳而出。故以黄芩清少阳之药，专治其利。加芍药者，恐病邪犹恋太阳而不使之合也。或曰∶葛根汤发汗必虚其表，不可无姜枣和营卫。黄芩汤之不用姜，固其宜矣，独枣何以不去耶？曰∶此正治少阳下利法也。利在太阴少阴，宜燥宜温；此为少阳热耗其液，非清不治，何敢再犯温燥。惟利则脾虚，补脾而复能润液者，舍大枣莫属。况变柴胡汤而仍用和法，枣与甘草皆不得无之。若阳明下利之宜大小承气者，枣草又大忌矣。一为黄连汤。凡病但有热无寒，据脉证一二，可断为少阳者，如呕而发热者，小柴胡汤主之。伤寒脉弦细头痛发热者属少阳。所谓有柴胡证，但见一证便是，不必悉具也。如寒热兼有之少阳病，在表者为往来寒热，在里者为喜呕为腹中痛，其有表无寒热而但里有寒热者，如黄连汤。腹中痛者寒也，欲呕吐者热也。寒在脾，热在胃，乃不曰脾胃病，而以为少阳病者何也？（方中行条辨列少阳篇，金鉴亦依之。）盖少阳居半表半里，出表挟阳而犯胃，则欲呕吐；入里化阴而侮脾，则腹中痛。胃即热则胸不能独寒。胸中有热胃中有邪气二句，谓胸中有热，由胃中有邪气也。胃中之邪，即少阳之邪也。病属少阳，自当以小柴胡汤增减治之。表无寒热，故去柴胡。腹中痛，故去黄芩。治欲呕之胃热，故以黄连佐半夏。治腹痛之脾寒，故以干姜佐人参。胃治则降，脾治则升。脾升胃降，少阳可不治而自治矣。而犹有虑焉者，药兼寒热，不和其在里之阴阳，则少阳之气，未必肯抑然而自下，故又加桂枝协甘草以化气而和之。有桂枝若不去生姜，则桂枝趋重于表，用之何益。且表无寒热，营卫无待于和。枣则补中而能滋热耗之液，故生姜不可有，而大枣不可无也。一为甘麦大枣汤。脏燥或主五脏，或主心脏，或主肺脏，或主子脏。窃于数说中衡之，似以子脏为当。子脏即子宫。"}]},{"ID":"20240611100039-fy6mubc","Type":"NodeParagraph","Properties":{"id":"20240611100039-fy6mubc","updated":"20240611100039"},"Children":[{"Type":"NodeText","Data":"悲伤欲哭诸端，虽见于心肺肾三经，而总由于子宫燥气乘之而致。子宫之燥，则由胃家阴液不足以滋之也。（略参唐容川说）甘麦甘凉，所以益阴清热。大枣甘而微温，复 其中宫之气。藏阴之受荫者大矣。治在滋燥而屏血药不用，岂血虚劳损者比乎。一为十枣汤。芫花甘遂大戟皆毒药，而并用之以逐饮，且不下不止。饮随下去，则脾伤而液亏矣。药之足以补脾润液而御毒者，无过大枣。若云培土以制水，则峻逐之际，何藉于制。夫三物走驶而大枣迟重，相反而适相济。盖与和营卫之偶生姜，泻肺满之偶葶苈，又初无二致也。一为茯苓桂枝甘草大枣汤。发汗后，仲圣每以姜枣和营卫，此发汗后而脐下悸欲作奔豚，则肾气正思上乘，不则补中宫以御之。一为附子粳米汤。说具饴糖。"}]},{"ID":"20240611100005-5xu5fg9","Type":"NodeThematicBreak","Properties":{"id":"20240611100005-5xu5fg9"}},{"ID":"20240611100006-3mxgdbk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100006-3mxgdbk","updated":"20240611100013"},"Children":[{"Type":"NodeText","Data":"大枣《本草新编》"}]},{"ID":"20240611100006-1rr0pti","Type":"NodeParagraph","Properties":{"id":"20240611100006-1rr0pti","updated":"20240611100006"},"Children":[{"Type":"NodeText","Data":"大枣，味甘，气温，无毒，阳也，降也。入五脏。通九窍，和百药，养肺胃，益气，润心肺，生津，助诸经，补五脏。惟中满及热疾忌食，齿疼并风疾禁尝。乃调和之品，非补益之味。《本经》曰其补者，亦因其调和之故也。"}]},{"ID":"20240611100006-e2rfmrk","Type":"NodeParagraph","Properties":{"id":"20240611100006-e2rfmrk","updated":"20240611100006"},"Children":[{"Type":"NodeText","Data":"按∶大枣，仙人遗种，故其味独异于凡枣，善能调和五脏之气也。虽非补益，要亦无损。"}]},{"ID":"20240611100006-57nee3f","Type":"NodeParagraph","Properties":{"id":"20240611100006-57nee3f","updated":"20240611100006"},"Children":[{"Type":"NodeText","Data":"吾浙诸暨，往往枣实有大如鸡蛋者，真仙种也。得其解者食之，实能益暮，惜不可多得耳。"}]},{"ID":"20240611095948-9pinop5","Type":"NodeThematicBreak","Properties":{"id":"20240611095948-9pinop5"}},{"ID":"20240611095949-fq4530k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095949-fq4530k","updated":"20240611095957"},"Children":[{"Type":"NodeText","Data":"大枣《本草述钩元》"}]},{"ID":"20240611095949-tbmjd8s","Type":"NodeParagraph","Properties":{"id":"20240611095949-tbmjd8s","updated":"20240611095949"},"Children":[{"Type":"NodeText","Data":"味甘。气温。气味俱浓。阳也。入足太阴阳明经。主治温胃益脾。和阴阳。调营卫。"}]},{"ID":"20240611095949-pyrhcbz","Type":"NodeParagraph","Properties":{"id":"20240611095949-pyrhcbz","updated":"20240611095949"},"Children":[{"Type":"NodeText","Data":"津液。助十二经。（甘缓阴血。血缓则脉生。）疗心下悬少气。杀乌头附子天雄毒。和光粉烧。治疳痢。小儿患秋痢。与蛀枣食之良。枣属土而有火。味甘性缓。甘先入脾。脾经血分药。（丹溪）经曰。里不足者。以甘补之。又曰。形不足者。温之以气。大枣甘能补中。温能益缓脾。邪在半表则营卫争之。辛甘解之。姜枣以和营卫。（成无己）欲哭服之〔论〕素问言枣为脾果。脾病宜食之。指治病和药说。若无故频食。则生虫损齿。丹溪云。"}]},{"ID":"20240611095949-8ud68v1","Type":"NodeParagraph","Properties":{"id":"20240611095949-8ud68v1","updated":"20240611095949"},"Children":[{"Type":"NodeText","Data":"主。"}]},{"ID":"20240611095949-0jfvuoc","Type":"NodeParagraph","Properties":{"id":"20240611095949-0jfvuoc","updated":"20240611095949"},"Children":[{"Type":"NodeText","Data":"中满者。忌之。小儿疳病。不宜食。齿痛及患痰热者。不宜食。"}]},{"ID":"20240611095949-o7bsyha","Type":"NodeParagraph","Properties":{"id":"20240611095949-o7bsyha","updated":"20240611095949"},"Children":[{"Type":"NodeText","Data":"生者尤不利人。多食致寒热。（仲淳）〔修治〕用青州及晋地者。晒干入药。"}]},{"ID":"20240611095931-6cyihf6","Type":"NodeThematicBreak","Properties":{"id":"20240611095931-6cyihf6"}},{"ID":"20240611095933-vz35zm3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095933-vz35zm3","updated":"20240611095939"},"Children":[{"Type":"NodeText","Data":"大枣《本草求真》"}]},{"ID":"20240611095933-r9pq49z","Type":"NodeParagraph","Properties":{"id":"20240611095933-r9pq49z","updated":"20240611095933"},"Children":[{"Type":"NodeText","Data":"（五果）补脾胃中气血"}]},{"ID":"20240611095933-kksujqw","Type":"NodeParagraph","Properties":{"id":"20240611095933-kksujqw","updated":"20240611095933"},"Children":[{"Type":"NodeText","Data":"大枣（专入脾胃）。味甘气温。色赤肉润。为补脾胃要药。经曰。里不足者。以甘补之。形不足者。温之以气。大枣甘能补中。温能益气。脾胃既补。则十二经脉自通。九窍利。（九窍。口耳鼻目前后二阴。）四肢和也。正气足则神自安。故凡心腹邪气心下悬急者。得此则调。得补则气力强。肠胃清。身中不足及病见肠 者。用此则安。甘能解毒。故于百药中。得甘则协。且于补药中风寒发散。内用为向导。则能于脾助其升发之气。（仲景治奔豚。用大枣滋土以平肾。治水饮胁痛。用十枣益土以胜水。）不似白术性燥不润。专于脾气则补。山药性平不燥。专于脾阴有益之为异耳。但多食损齿。（齿属肾。土燥克水。）及气实中满切忌。（甘令中满。大建中汤减饧枣。与甘草同例。）北产肥润者良。金华南枣亦佳。杀乌附。忌葱鱼同食。"}]},{"ID":"20240611095830-lx00vy9","Type":"NodeThematicBreak","Properties":{"id":"20240611095830-lx00vy9"}},{"ID":"20240611095911-094us3v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095911-094us3v","updated":"20240611095916"},"Children":[{"Type":"NodeText","Data":"大枣《新修本草》"}]},{"ID":"20240611095911-asrkola","Type":"NodeParagraph","Properties":{"id":"20240611095911-asrkola","updated":"20240611095911"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主心腹邪气，安中养脾，助十二经胃气，通九窍，补少气少津，身中不足，大惊，四肢重，和百药。补中益气，强力，除烦闷，疗心下悬，肠 。久服轻身长季，不名美枣，一名良枣。八月采，曝干。三岁陈核中仁，燔之，味苦，主腹痛，邪气。生枣，味甘、辛，多食令人多寒热，羸瘦者，不可食。叶覆麻黄，能出汗。生河东平泽。"}]},{"ID":"20240611095911-gtvk27u","Type":"NodeParagraph","Properties":{"id":"20240611095911-gtvk27u","updated":"20240611095911"},"Children":[{"Type":"NodeText","Data":"大枣杀乌头毒。旧云河东猗氏县枣特异，今出青州、彭城，枣形小，核细，多膏，甚甜。郁者亦好，小不及尔。江东临沂金城枣，形大而虚少暗，好者亦可用。"}]},{"ID":"20240611095911-s63iymv","Type":"NodeParagraph","Properties":{"id":"20240611095911-s63iymv","updated":"20240611095911"},"Children":[{"Type":"NodeText","Data":"道家方药以枣为佳饵，其皮利，肉补虚，所以合汤皆辟用之。"}]},{"ID":"20240611095911-65s847z","Type":"NodeParagraph","Properties":{"id":"20240611095911-65s847z","updated":"20240611095911"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶枣叶散服使人瘦，久即呕吐；揩热痱疮至良。"}]},{"ID":"20240611095910-z3svht8","Type":"NodeThematicBreak","Properties":{"id":"20240611095910-z3svht8"}},{"ID":"20240611095859-btv4sfg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095859-btv4sfg","updated":"20240611095904"},"Children":[{"Type":"NodeText","Data":"大枣《本草经解》"}]},{"ID":"20240611095859-1nggaq2","Type":"NodeParagraph","Properties":{"id":"20240611095859-1nggaq2","updated":"20240611095859"},"Children":[{"Type":"NodeText","Data":"气平．味甘．无毒．主心腹邪气．安中养脾气．平胃气．通九窍．助十二经．补少气少津液．身中不足．大惊四肢重．和百药．久服轻身延年．大枣气平．禀天秋收之金气．入手太阴肺经．味甘无毒．得地中正之土味．入足太阴脾经．气味升多于降．阳也．心腹者．太阴经行之地也．邪之所凑．其气必虚．阴阳形气不足者．宜调以甘药．大枣味甘．可以调不足．故主心腹邪气．外为阳．内为阴．阴和则中安．甘平益阴．所以安中．脾者阴气之原也．胃者阳气之原也．甘平益阴．故养脾气．阴和则阳平．故平胃气．中气不足．则九窍不通．甘能满中．中气足．九窍通也．十二经者．三阴三阳也．脾胃者．阴阳之原也．大枣养脾气．平胃气．则十二经无不助矣．肺主气而生津液．气平益肺．所以主少气少津液也．肺主一身之气．脾统一身之血．甘平益脾肺．身中气血和．自无不足之症矣．血气足则神安．所以定大惊．脾主四肢．味甘益脾．脾气充．四肢自轻．甘平解毒．故和百药．肺气充．脾血足．所以轻身延年也．"}]},{"ID":"20240611095859-7nspcjl","Type":"NodeParagraph","Properties":{"id":"20240611095859-7nspcjl","updated":"20240611095859"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240611095859-26mja8k","Type":"NodeParagraph","Properties":{"id":"20240611095859-26mja8k","updated":"20240611095859"},"Children":[{"Type":"NodeText","Data":"大枣同小麦、甘草．名甘草小麦汤．治妇人脏燥．无故悲啼．"}]},{"ID":"20240611095859-p58u154","Type":"NodeThematicBreak","Properties":{"id":"20240611095859-p58u154"}},{"ID":"20240611095846-u9b8l8n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095846-u9b8l8n","updated":"20240611095852"},"Children":[{"Type":"NodeText","Data":"大枣《本草蒙筌》"}]},{"ID":"20240611095846-ehachc5","Type":"NodeParagraph","Properties":{"id":"20240611095846-ehachc5","updated":"20240611095846"},"Children":[{"Type":"NodeText","Data":"味甘，气平温。气浓，属土有火，阳也，降也。无毒。北郡俱生，青山（属山东）独胜。末秋摘取，微火烘干。多膏甚甜，形大核细。觅斯入药，不负所名。（诸果只载其名，惟枣独加大字故云。）忌生葱，杀乌毒。（乌头毒也。）劈除内核，服免人烦。通九窍略亚菖蒲，和百药不让甘草。养脾胃益气，润心肺生津。助诸经，补五脏。中满及热疾忌食，齿疼并风疾禁尝。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生枣"},{"Type":"NodeText","Data":"食多，胀脐腹作痢；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蒸枣"},{"Type":"NodeText","Data":"旋啖，益肠胃肥中。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦枣"},{"Type":"NodeText","Data":"大寒，系枣中味苦者便是；寒邪外感，致热伏脏腑者能医。通大小二便，去狂荡烦满。煮研代蜜，丸药弥佳。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枣核"},{"Type":"NodeText","Data":"以口常含，受气自生津液。陈年"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核中仁"},{"Type":"NodeText","Data":"，燔之味苦；（三岁者良。）中恶腹内痛，服即效臻。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"覆麻黄，能令出汗。余产因州土不一，各各且形状亦殊。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牙枣波斯枣略"},{"Type":"NodeText","Data":"尖长。（出广州。）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"御枣水菱枣极"},{"Type":"NodeText","Data":"甘美。（出安邑。）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天蒸枣"},{"Type":"NodeText","Data":"皮薄而皱。（出江南州，蒸熟火烘。）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"羊矢枣"},{"Type":"NodeText","Data":"实小边腰枣，出江东。）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"东海枣"},{"Type":"NodeText","Data":"头圆而形大不入药煎。"}]},{"ID":"20240611095847-71p5ju6","Type":"NodeThematicBreak","Properties":{"id":"20240611095847-71p5ju6"}},{"ID":"20240611095831-5wn9vk4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095831-5wn9vk4","updated":"20240611095835"},"Children":[{"Type":"NodeText","Data":"大枣《医学入门》"}]},{"ID":"20240611095831-ltaigul","Type":"NodeParagraph","Properties":{"id":"20240611095831-ltaigul","updated":"20240611095831"},"Children":[{"Type":"NodeText","Data":"大枣甘温和胃脾，肠 癖气故能医，润心肺令神液足，助十二经百药宜，生枣甘辛动湿热，令人胀泄瘦人肌。"}]},{"ID":"20240611095831-i3n1qaf","Type":"NodeParagraph","Properties":{"id":"20240611095831-i3n1qaf","updated":"20240611095831"},"Children":[{"Type":"NodeText","Data":"无毒。降也，阳也。养脾平胃，安中，补中益气。治四肢重及肠 下痢，肠胃间癖气，一切心腹邪气，更疗心悬大惊烦闷。壮神润肺，止嗽，补津液，补气。珍云∶味甘，补经不足以缓阴血，血缓则脉生，故能助十二经脉，补五脏，通九窍，和百药，杀乌头毒，不但心、肺、脾三经剂也。惟心下痞，中满呕吐，有齿病者忌之。又不宜合生葱食，多食动风，脾反受病，属土而有火故也。入药用红枣，蒸去皮核。生枣动湿热，多食令人气满胀，多寒热注泄，羸瘦者勿食。叶温，覆麻黄能令出汗，散服使人瘦，久即呕吐，捣烂揩热痱疮，煎汤浴小儿壮热。三年陈核中仁，燔之味苦，主腹痛，邪气，恶气，疰忤，小儿患秋痢。与虫枣食之良。"}]},{"ID":"20240611095726-5draqkg","Type":"NodeThematicBreak","Properties":{"id":"20240611095726-5draqkg"}},{"ID":"20240611095733-o8n3lps","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095733-o8n3lps","updated":"20240611095738"},"Children":[{"Type":"NodeText","Data":"大枣《名医别录》"}]},{"ID":"20240611095733-a354oa7","Type":"NodeParagraph","Properties":{"id":"20240611095733-a354oa7","updated":"20240611095733"},"Children":[{"Type":"NodeText","Data":"无毒．补中益气，强力，除烦闷，治心下悬、肠 ．久服不饥神仙．一名干枣，一名美枣，一名良枣．八月采，曝干．三岁陈核中仁，燔之，味苦，主治腹痛，邪气．生枣，味甘、辛，多食令人多寒热，羸瘦者，不可食．生河东．（杀乌头毒．）"}]},{"ID":"20240611095655-83kj7lr","Type":"NodeThematicBreak","Properties":{"id":"20240611095655-83kj7lr"}},{"ID":"20240611095706-5wpb1a5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095706-5wpb1a5","updated":"20240611095712"},"Children":[{"Type":"NodeText","Data":"大枣《本草择要纲目》"}]},{"ID":"20240611095706-ojmngbz","Type":"NodeParagraph","Properties":{"id":"20240611095706-ojmngbz","updated":"20240611095706"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611095706-4ilzdi6","Type":"NodeParagraph","Properties":{"id":"20240611095706-4ilzdi6","updated":"20240611095706"},"Children":[{"Type":"NodeText","Data":"甘平无毒．"}]},{"ID":"20240611095706-whhu63d","Type":"NodeParagraph","Properties":{"id":"20240611095706-whhu63d","updated":"20240611095706"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611095706-tap6r8y","Type":"NodeParagraph","Properties":{"id":"20240611095706-tap6r8y","updated":"20240611095706"},"Children":[{"Type":"NodeText","Data":"属土而有火．味甘性缓．甘先入脾．为脾经血分之药．仲景治奔豚用大枣汤．滋脾土以平肾气也．治水饮胁痛有十枣汤．益土而胜水也．方药中用姜枣作引．温以补不足．甘以缓阴血也．有齿病疳病患不宜啖枣．小儿尤不宜食．令齿黄生 ．与葱同食．令人五脏不和．与鱼同食．令人腰腹痛．"}]},{"ID":"20240611095542-a28fo0s","Type":"NodeThematicBreak","Properties":{"id":"20240611095542-a28fo0s"}},{"ID":"20240611095548-2jk2ltp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095548-2jk2ltp","updated":"20240611095654"},"Children":[{"Type":"NodeText","Data":"大枣《中药学》"}]},{"ID":"20240611095548-ldtzyb3","Type":"NodeParagraph","Properties":{"id":"20240611095548-ldtzyb3","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为鼠李科植物枣的成熟果实。"}]},{"ID":"20240611095548-1yiusgw","Type":"NodeParagraph","Properties":{"id":"20240611095548-1yiusgw","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，平。入脾经。"}]},{"ID":"20240611095548-7rbrmge","Type":"NodeParagraph","Properties":{"id":"20240611095548-7rbrmge","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【功效】补脾胃，养营安神，缓和药性。"}]},{"ID":"20240611095548-lcr013c","Type":"NodeParagraph","Properties":{"id":"20240611095548-lcr013c","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于脾胃虚弱、气虚不足、倦怠乏力等症。"}]},{"ID":"20240611095548-xmkkk0o","Type":"NodeParagraph","Properties":{"id":"20240611095548-xmkkk0o","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"本品功能补中益气，用治脾胃虚弱等症，每与党参、白朮等配伍，可加强补中益气的功效。"}]},{"ID":"20240611095548-ukpj2vx","Type":"NodeParagraph","Properties":{"id":"20240611095548-ukpj2vx","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"2.用于脏躁症。"}]},{"ID":"20240611095548-h53kcs2","Type":"NodeParagraph","Properties":{"id":"20240611095548-h53kcs2","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"大枣又能养营安神，临床上常与甘草、小麦等同用，以治脏躁症。"}]},{"ID":"20240611095548-iypkwdl","Type":"NodeParagraph","Properties":{"id":"20240611095548-iypkwdl","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"此外，本品与甘遂、大载、芜花等峻泻药配伍，既能缓和药性，又能补脾和胃。如与生姜同用，既能协调营卫，又可和理脾胃。"}]},{"ID":"20240611095548-4iqvcqo","Type":"NodeParagraph","Properties":{"id":"20240611095548-4iqvcqo","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【处方用名】大枣、红枣、大红枣（劈开用。）"}]},{"ID":"20240611095548-m2n231a","Type":"NodeParagraph","Properties":{"id":"20240611095548-m2n231a","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三枚至十枚，煎服。"}]},{"ID":"20240611095548-65k9769","Type":"NodeParagraph","Properties":{"id":"20240611095548-65k9769","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【按语】1.大枣即平日供食用的红枣，性质平和，能培补脾胃，为调补脾胃的常用辅助药。民间常用作为补血的药物，治疗血虚的病症；因此近年来临床上用它补血以止血，治疗过敏性紫癜，可单用或配合其它药物同用。"}]},{"ID":"20240611095548-zhf41ub","Type":"NodeParagraph","Properties":{"id":"20240611095548-zhf41ub","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"2.本品配合甘草、小麦，即为甘麦大枣汤，前人用治脏躁。脏躁的发病原因，多由情志抑郁或思虑过度，心脾受损，致脏阴不足而成。其临床表现为无故悲伤、精神失常、坐卧不安、心烦不寐等症。此种症候，类似现代的[病意]病。"}]},{"ID":"20240611095548-wwli880","Type":"NodeParagraph","Properties":{"id":"20240611095548-wwli880","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主心腹邪气，安中养脾，助十二经，平胃气，通九窍，补少气，少津浓，身中不足，大惊，四肢重，和百药。」"}]},{"ID":"20240611095548-yqym6aq","Type":"NodeParagraph","Properties":{"id":"20240611095548-yqym6aq","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"《别录》：「补中益气，坚志强力，除烦闷，疗心下悬，除肠僻。」"}]},{"ID":"20240611095548-14r36nk","Type":"NodeParagraph","Properties":{"id":"20240611095548-14r36nk","updated":"20240611095548"},"Children":[{"Type":"NodeText","Data":"《大明本草》：「润心肺，止嗽，补五脏，治虚损，除肠胃澼气。」"}]},{"ID":"20240611095524-r0io5rw","Type":"NodeThematicBreak","Properties":{"id":"20240611095524-r0io5rw"}},{"ID":"20240611095533-cnwni7n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095533-cnwni7n","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"《中国药典》：大枣"}]},{"ID":"20240611095533-n8nbmi3","Type":"NodeParagraph","Properties":{"id":"20240611095533-n8nbmi3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095533-fgab26p","Type":"NodeParagraph","Properties":{"id":"20240611095533-fgab26p","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" Dà Zǎo"}]},{"ID":"20240611095533-sdoij25","Type":"NodeParagraph","Properties":{"id":"20240611095533-sdoij25","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095533-schpfl5","Type":"NodeParagraph","Properties":{"id":"20240611095533-schpfl5","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 本品为鼠李科枣属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枣"},{"Type":"NodeText","Data":"Ziziphus jujuba Mill. var. inermis （Bunge） Rehd. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。秋季果实成熟时采收，晒干。其根、树皮亦入药，随时可采。"}]},{"ID":"20240611095533-j1s5txp","Type":"NodeParagraph","Properties":{"id":"20240611095533-j1s5txp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095533-duin2yd","Type":"NodeParagraph","Properties":{"id":"20240611095533-duin2yd","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 本品呈椭圆形或球形，长2～3.5cm，直径1.5～2.5cm。表面暗红色，略带光泽，有不规则皱纹。基部凹陷，有短果梗。外果皮薄，中果皮棕黄色或淡褐色，肉质，柔软，富糖性而油润。果核纺锤形，两端锐尖，质坚硬。气微香，味甜。"}]},{"ID":"20240611095533-ect2opu","Type":"NodeParagraph","Properties":{"id":"20240611095533-ect2opu","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611095533-ig6xuts","Type":"NodeParagraph","Properties":{"id":"20240611095533-ig6xuts","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防蛀。"}]},{"ID":"20240611095533-goq2aqe","Type":"NodeParagraph","Properties":{"id":"20240611095533-goq2aqe","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611095533-j707835","Type":"NodeParagraph","Properties":{"id":"20240611095533-j707835","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，晒干。用时破开或去核。"}]},{"ID":"20240611095533-yvfm8e3","Type":"NodeParagraph","Properties":{"id":"20240611095533-yvfm8e3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611095533-kiy4bou","Type":"NodeParagraph","Properties":{"id":"20240611095533-kiy4bou","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 取本品粉末2g，加石油醚（60～90℃）10ml浸泡10分钟，超声处理约10分钟，滤过，弃去石油醚液，药渣晾干，加乙醚20ml，浸泡1小时，超声处理约15分钟，滤过，滤液浓缩至2ml，作为供试品溶液。另取齐墩果酸对照品，加乙醇制成每1ml含1mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液10μl、对照品溶液3μl，分别点于同一硅胶G薄层板上，以甲苯-醋酸乙酯-冰醋酸（14:4:0.5）为展开剂，展开，取出，晾干，喷以10％硫酸乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240611095533-lr95itm","Type":"NodeParagraph","Properties":{"id":"20240611095533-lr95itm","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095533-77ts7xr","Type":"NodeParagraph","Properties":{"id":"20240611095533-77ts7xr","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 归脾、胃经。"}]},{"ID":"20240611095533-4vctczg","Type":"NodeParagraph","Properties":{"id":"20240611095533-4vctczg","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095533-5b0tyna","Type":"NodeParagraph","Properties":{"id":"20240611095533-5b0tyna","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 甘，温。"}]},{"ID":"20240611095533-b9zq9d6","Type":"NodeParagraph","Properties":{"id":"20240611095533-b9zq9d6","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095533-5qvvqmz","Type":"NodeParagraph","Properties":{"id":"20240611095533-5qvvqmz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 果（大枣）：补中益气，养血安神。用于脾虚食少，乏力便溏，妇人脏躁。"}]},{"ID":"20240611095533-cmmmpqb","Type":"NodeParagraph","Properties":{"id":"20240611095533-cmmmpqb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"树皮：消炎，止血，止泻。用于气管炎，肠炎，痢疾，崩漏；外用治外伤出血。"}]},{"ID":"20240611095533-qst8k2q","Type":"NodeParagraph","Properties":{"id":"20240611095533-qst8k2q","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"根：行气，活血，调经。用于月经不调，红崩，白带。"}]},{"ID":"20240611095533-988yq3j","Type":"NodeParagraph","Properties":{"id":"20240611095533-988yq3j","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095533-nltnrdq","Type":"NodeParagraph","Properties":{"id":"20240611095533-nltnrdq","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 6～15g。"}]},{"ID":"20240611095533-44qquzr","Type":"NodeParagraph","Properties":{"id":"20240611095533-44qquzr","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095533-y4u8kqe","Type":"NodeParagraph","Properties":{"id":"20240611095533-y4u8kqe","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611095533-4wfbqo4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095533-4wfbqo4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：大枣"}]},{"ID":"20240611095533-zwrptcp","Type":"NodeParagraph","Properties":{"id":"20240611095533-zwrptcp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095533-cbhromr","Type":"NodeParagraph","Properties":{"id":"20240611095533-cbhromr","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" Dà Zǎo"}]},{"ID":"20240611095533-cfiiwa6","Type":"NodeParagraph","Properties":{"id":"20240611095533-cfiiwa6","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095533-rrcw0hd","Type":"NodeParagraph","Properties":{"id":"20240611095533-rrcw0hd","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 枣、红枣、枣子"}]},{"ID":"20240611095533-yld4jxh","Type":"NodeParagraph","Properties":{"id":"20240611095533-yld4jxh","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095533-ax6uuko","Type":"NodeParagraph","Properties":{"id":"20240611095533-ax6uuko","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枣"},{"Type":"NodeText","Data":"Ziziphus jujuba Mill. var. inermis （Bunge） Rehd. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"，其根、树皮亦入药。秋季果实成熟时采收，晒干。根、树皮，随时可采。"}]},{"ID":"20240611095533-9rfiamj","Type":"NodeParagraph","Properties":{"id":"20240611095533-9rfiamj","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095533-nlhlu13","Type":"NodeParagraph","Properties":{"id":"20240611095533-nlhlu13","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 果：甘，温。"}]},{"ID":"20240611095533-2pquock","Type":"NodeParagraph","Properties":{"id":"20240611095533-2pquock","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"树皮：苦、涩，温。"}]},{"ID":"20240611095533-5w2gmvo","Type":"NodeParagraph","Properties":{"id":"20240611095533-5w2gmvo","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"根：甘，温。"}]},{"ID":"20240611095533-u10g16n","Type":"NodeParagraph","Properties":{"id":"20240611095533-u10g16n","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095533-48g7zg9","Type":"NodeParagraph","Properties":{"id":"20240611095533-48g7zg9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 果（大枣）：补脾益气，养心安神。用于脾虚泄泻，心悸，失眠，盗汗，血小板减少性紫癜。"}]},{"ID":"20240611095533-3p1otue","Type":"NodeParagraph","Properties":{"id":"20240611095533-3p1otue","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"树皮：消炎，止血，止泻。用于气管炎，肠炎，痢疾，崩漏；外用治外伤出血。"}]},{"ID":"20240611095533-avt47wi","Type":"NodeParagraph","Properties":{"id":"20240611095533-avt47wi","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"根：行气，活血，调经。用于月经不调，红崩，白带。"}]},{"ID":"20240611095533-e5abqi1","Type":"NodeParagraph","Properties":{"id":"20240611095533-e5abqi1","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095533-ur47vg8","Type":"NodeParagraph","Properties":{"id":"20240611095533-ur47vg8","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 果、树皮、根均为2～3钱。枣树皮经提取后，制成枣树皮消炎片，每次服1～2片，每日服2次。"}]},{"ID":"20240611095533-wrhre0f","Type":"NodeParagraph","Properties":{"id":"20240611095533-wrhre0f","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095533-5t1j6sl","Type":"NodeParagraph","Properties":{"id":"20240611095533-5t1j6sl","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611095533-9h4vc57","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095533-9h4vc57","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：大枣"}]},{"ID":"20240611095533-ys5h0gg","Type":"NodeParagraph","Properties":{"id":"20240611095533-ys5h0gg","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095533-67m775p","Type":"NodeParagraph","Properties":{"id":"20240611095533-67m775p","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" Dà Zǎo"}]},{"ID":"20240611095533-g34pt1u","Type":"NodeParagraph","Properties":{"id":"20240611095533-g34pt1u","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095533-ey2a10x","Type":"NodeParagraph","Properties":{"id":"20240611095533-ey2a10x","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 干枣、美枣，良枣（《别录》），红枣（《医学入门》）。"}]},{"ID":"20240611095533-kugc7d7","Type":"NodeParagraph","Properties":{"id":"20240611095533-kugc7d7","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611095533-yjd2cnk","Type":"NodeParagraph","Properties":{"id":"20240611095533-yjd2cnk","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611095533-h96jbo3","Type":"NodeParagraph","Properties":{"id":"20240611095533-h96jbo3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095533-9x7biu4","Type":"NodeParagraph","Properties":{"id":"20240611095533-9x7biu4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 为鼠李科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枣"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。 秋季果实成熟时采收。拣净杂质，晒干。或烘至皮软，再行晒干。或先用水煮一滚，使果肉柔软而皮未皱缩时即捞起，晒干。"}]},{"ID":"20240611095533-3ckhsur","Type":"NodeParagraph","Properties":{"id":"20240611095533-3ckhsur","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611095533-3ziqxq6","Type":"NodeParagraph","Properties":{"id":"20240611095533-3ziqxq6","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 一般多为栽培。分布全国各地。全国大部分地区有产，主产于河北、河南、山东、四川、贵州等地。"}]},{"ID":"20240611095533-btdng5m","Type":"NodeParagraph","Properties":{"id":"20240611095533-btdng5m","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611095533-0dzj3n4","Type":"NodeParagraph","Properties":{"id":"20240611095533-0dzj3n4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 枣（《诗经》），又名：刺枣。"}]},{"ID":"20240611095533-8phptxq","Type":"NodeParagraph","Properties":{"id":"20240611095533-8phptxq","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"落叶灌木或小乔木，高可达10米。枝平滑无毛，具成对的针刺，直伸或钩曲，幼枝纤弱而簇生，颇似羽状复叶。成\"之\"字形曲折。单叶互生；卵圆形至卵状披针形，少有卵形，长2～6厘米，先端短尖而钝，基部歪斜，边缘具细锯齿，3主脉自基部发出，侧脉明显。花小形，成短聚伞花序，丛生于叶腋，黄绿色；萼5裂，上部呈花瓣状，下部连成筒状，绿色；花瓣5；雄蕊5，与花瓣对生；子房2室，花柱突出于花盘中央，先端2裂，核果卵形至长圆形，长1．5～5厘米，熟时深红色，果肉味甜，核两端锐尖。花期4～5月。果期7～9月。"}]},{"ID":"20240611095533-trnp6n9","Type":"NodeParagraph","Properties":{"id":"20240611095533-trnp6n9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095533-1nxwitk","Type":"NodeParagraph","Properties":{"id":"20240611095533-1nxwitk","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 果实略呈卵圆形或椭圆形，长约2～3．5厘米，直径约1．5～2．5厘米。表面暗红色，带光泽，有不规则皱纹，果实一端有深凹窝，中具一短丽细的果柄，另一端有一小突点。外果皮薄，中果皮肉质松软，如海绵状，黄棕色。果核纺锤形，坚硬，两端尖锐，表面暗红色。气微弱，味香甜。以色红、肉厚、饱满、核小、味甜者为佳。"}]},{"ID":"20240611095533-tkoteyb","Type":"NodeParagraph","Properties":{"id":"20240611095533-tkoteyb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611095533-wr7dmmt","Type":"NodeParagraph","Properties":{"id":"20240611095533-wr7dmmt","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 含大枣皂甙Ⅰ、Ⅱ、Ⅲ（ziziphussaponin Ⅰ，Ⅱ，Ⅲ）、酸枣仁皂甙B（jujuboside B）、光千金藤碱（stepharine）、葡萄糖、果糖、蔗糖、环磷腺苷（cAMP）、环磷乌苷（cGMP）等。"}]},{"ID":"20240611095533-kwhmu3s","Type":"NodeParagraph","Properties":{"id":"20240611095533-kwhmu3s","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095533-16gevee","Type":"NodeParagraph","Properties":{"id":"20240611095533-16gevee","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240611095533-wfvh3sk","Type":"NodeParagraph","Properties":{"id":"20240611095533-wfvh3sk","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"脾经血分。\""}]},{"ID":"20240611095533-64qo9qo","Type":"NodeParagraph","Properties":{"id":"20240611095533-64qo9qo","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足太阴，阳明经。\""}]},{"ID":"20240611095533-4gsphcu","Type":"NodeParagraph","Properties":{"id":"20240611095533-4gsphcu","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095533-ewa1n3c","Type":"NodeParagraph","Properties":{"id":"20240611095533-ewa1n3c","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 甘，温。"}]},{"ID":"20240611095533-qg8i3f3","Type":"NodeParagraph","Properties":{"id":"20240611095533-qg8i3f3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。’"}]},{"ID":"20240611095533-00pbdkd","Type":"NodeParagraph","Properties":{"id":"20240611095533-00pbdkd","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"②《千金·食治》：\"味甘辛，热，无毒。\""}]},{"ID":"20240611095533-qny6ysl","Type":"NodeParagraph","Properties":{"id":"20240611095533-qny6ysl","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"③孟诜：\"温。\""}]},{"ID":"20240611095533-o1v6k09","Type":"NodeParagraph","Properties":{"id":"20240611095533-o1v6k09","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611095533-qo92p3c","Type":"NodeParagraph","Properties":{"id":"20240611095533-qo92p3c","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 凡有湿痰、积滞，齿病、虫病者，均不相宜。"}]},{"ID":"20240611095533-zzgtkvj","Type":"NodeParagraph","Properties":{"id":"20240611095533-zzgtkvj","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"①《医学入门》：\"心下痞，中满呕吐者忌之。多食动风，脾反受病。\""}]},{"ID":"20240611095533-7yx5lf7","Type":"NodeParagraph","Properties":{"id":"20240611095533-7yx5lf7","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"②《本草经巯》：\"小儿疳病不宜食，患痰热者不宜食。\""}]},{"ID":"20240611095533-acg9g61","Type":"NodeParagraph","Properties":{"id":"20240611095533-acg9g61","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"胃痛气闭者，蛔结腹痛及一切诸虫为病者，咸忌之。\""}]},{"ID":"20240611095533-ddw6772","Type":"NodeParagraph","Properties":{"id":"20240611095533-ddw6772","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"④《髓息居饮食谱》：\"多食患胀泄热渴，最不益人。凡小儿、产后及温热、暑湿诸病前后，黄疸、肿胀并忌之。\""}]},{"ID":"20240611095533-31h932m","Type":"NodeParagraph","Properties":{"id":"20240611095533-31h932m","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095533-ncy2tvr","Type":"NodeParagraph","Properties":{"id":"20240611095533-ncy2tvr","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 补脾和胃，益气生津，调营卫，解药毒。治胃虚食少，脾弱便溏，气血津液不足，营卫不和，心悸怔忡。妇人赃躁。"}]},{"ID":"20240611095533-syamc3t","Type":"NodeParagraph","Properties":{"id":"20240611095533-syamc3t","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹邪气，安中养脾，助十二经。平胃气，通九窍，补少气、少津液，身中不足，大惊，四肢重，和百药。\""}]},{"ID":"20240611095533-tpgw30o","Type":"NodeParagraph","Properties":{"id":"20240611095533-tpgw30o","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"煞乌头毒。\""}]},{"ID":"20240611095533-wlakdx2","Type":"NodeParagraph","Properties":{"id":"20240611095533-wlakdx2","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"补中益气，强力，除烦闷，疗心下悬，肠僻澼。\""}]},{"ID":"20240611095533-d0se0e3","Type":"NodeParagraph","Properties":{"id":"20240611095533-d0se0e3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"④《药对》：\"杀附子、天雄毒。\""}]},{"ID":"20240611095533-ftc89pf","Type":"NodeParagraph","Properties":{"id":"20240611095533-ftc89pf","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑤孟诜：\"主补津液，洗心腹邪气，和百药毒，通九窍，补不足气，煮食补肠胃，肥中益气第一，小儿患秋痢，与虫枣食，良。\""}]},{"ID":"20240611095533-bb9wmwm","Type":"NodeParagraph","Properties":{"id":"20240611095533-bb9wmwm","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑥《日华子本草》：\"润心肺，止嗽。补五脏，治虚劳损，除肠胃癣气。\""}]},{"ID":"20240611095533-ch0a3vq","Type":"NodeParagraph","Properties":{"id":"20240611095533-ch0a3vq","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑦《珍珠囊》：\"温胃。\""}]},{"ID":"20240611095533-3w8q7ko","Type":"NodeParagraph","Properties":{"id":"20240611095533-3w8q7ko","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑧李杲：\"温以补脾经不足，甘以缓阴血，和阴阳，调营卫，生津液。\""}]},{"ID":"20240611095533-gbr7ueb","Type":"NodeParagraph","Properties":{"id":"20240611095533-gbr7ueb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑨《药品化义》：\"养血补肝。\""}]},{"ID":"20240611095533-yv9khje","Type":"NodeParagraph","Properties":{"id":"20240611095533-yv9khje","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"补中益气，滋肾暖胃，治阴虚。\""}]},{"ID":"20240611095533-z0mf853","Type":"NodeParagraph","Properties":{"id":"20240611095533-z0mf853","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑾《中国药植图鉴》：\"治过敏性紫斑病、贫血及高血压。\""}]},{"ID":"20240611095533-wyvrmmm","Type":"NodeParagraph","Properties":{"id":"20240611095533-wyvrmmm","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095533-wsd2ejb","Type":"NodeParagraph","Properties":{"id":"20240611095533-wsd2ejb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～6钱；或捣烂作丸。外用：煎水洗或烧存性研末调敷。"}]},{"ID":"20240611095533-loj58eb","Type":"NodeParagraph","Properties":{"id":"20240611095533-loj58eb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611095533-ccaf0up","Type":"NodeParagraph","Properties":{"id":"20240611095533-ccaf0up","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" ①治脾胃湿寒，饮食减少，长作泄泻，完谷不化：白术四两，干姜二两。鸡内金二两，熟枣肉半斤。上药四味，白术、鸡内金皆用生者，每味各自轧细、焙熟，再将干姜轧细，共和枣肉，同捣如泥，作小饼，木炭火上炙干，空心时，当点心，细嚼咽之。（《医学衷中参西录》益脾饼）"}]},{"ID":"20240611095533-u2s30t8","Type":"NodeParagraph","Properties":{"id":"20240611095533-u2s30t8","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"②治反胃吐食：大枣一枚（去核），班蝥一枚（去头翅）入内喂热，去蝥，空心食之，白汤下。（《纲目》）"}]},{"ID":"20240611095533-xg0il9z","Type":"NodeParagraph","Properties":{"id":"20240611095533-xg0il9z","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"③补气：大南枣十枚，蒸软去核，配人参一钱，布包，藏饭锅内蒸烂，捣匀为丸，如弹子大，收贮用之。（《醒园录》枣参丸）"}]},{"ID":"20240611095533-5xylym4","Type":"NodeParagraph","Properties":{"id":"20240611095533-5xylym4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"④治中风惊恐虚悸，四肢沉重：大枣七枚（去核），青粱粟米二合。上二味以水三升半，先煮枣取一升半，去滓，投米煮粥食之。（《圣济总录》补益大枣粥）"}]},{"ID":"20240611095533-zp1jhba","Type":"NodeParagraph","Properties":{"id":"20240611095533-zp1jhba","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑤治妇人脏躁，喜悲伤，欲哭，数欠伸：大枣十枚，甘草三两，小麦一升。上三味，以水六升，煮取三升，温分三服。（《金匮要略》甘麦大枣汤）"}]},{"ID":"20240611095533-6fv1cj8","Type":"NodeParagraph","Properties":{"id":"20240611095533-6fv1cj8","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑥治咳：杏仁一百二十枚（去皮尖，熬），豉一百枚（熬令干），干枣四十枚（去核）。上三味台捣如泥，丸如杏核，含咽令尽。日七、八度，尽，更作。（盂诜《必效方》）"}]},{"ID":"20240611095533-yuq8ya9","Type":"NodeParagraph","Properties":{"id":"20240611095533-yuq8ya9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑦治悬饮：芫花（熬）、甘遂、大戟各等分。上三味捣筛，以水一升五合，先煮肥大枣十枚，取八合，去渣，纳药末，强人服一钱匕，羸人服半钱匕，平日温服之，不下者，明日更加半钱。得快利之后，糜粥自养。（《金匮要略》十枣汤）"}]},{"ID":"20240611095533-bmwwz06","Type":"NodeParagraph","Properties":{"id":"20240611095533-bmwwz06","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑧治虚劳烦闷不得眠：大枣二十枚，葱白七茎。上二味，以水三升，煮一升，去滓顿服。（《千金方》）"}]},{"ID":"20240611095533-3eupcxe","Type":"NodeParagraph","Properties":{"id":"20240611095533-3eupcxe","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑨治肺疽吐血并妄行：红枣（和核烧存性）、百药煎（煅）各等分。为细末，每服二钱，米汤调下。（《三因方》二灰散）"}]},{"ID":"20240611095533-35ijhag","Type":"NodeParagraph","Properties":{"id":"20240611095533-35ijhag","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑩治卒急心痛：乌梅一个，枣二个，杏仁七个。一处捣，男用酒、女用醋送下。（《海上方》）"}]},{"ID":"20240611095533-2yja39j","Type":"NodeParagraph","Properties":{"id":"20240611095533-2yja39j","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑾治非血小板减少性紫瘢：红枣，每天吃三次，每次10只，至紫瘢全部消退为止。一般每人约需红枣一至二斤。（《上海中医药》（4）：22，1962）"}]},{"ID":"20240611095533-vkpsm24","Type":"NodeParagraph","Properties":{"id":"20240611095533-vkpsm24","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⑿治走马牙疳：枣（去核、包信石，烧）、黄柏。同为末，布患处。（《海上方》）"}]},{"ID":"20240611095533-q19h6un","Type":"NodeParagraph","Properties":{"id":"20240611095533-q19h6un","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⒀治诸疮久不瘥：枣膏三升，水三斗，煮取一斗半，数洗取愈。（《千金方》》"}]},{"ID":"20240611095533-7oqhozb","Type":"NodeParagraph","Properties":{"id":"20240611095533-7oqhozb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"⒁治风沿烂眼：大黑枣二十个（去核），明矾末五分，和枣肉捣成膏，湿纸包，火内煨二刻，取出，去纸，水二碗，将枣膏煎汤，去渣，将汤洗眼。（《本草汇言》眼科方）"}]},{"ID":"20240611095533-pfjbze2","Type":"NodeParagraph","Properties":{"id":"20240611095533-pfjbze2","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611095533-z56l2dp","Type":"NodeParagraph","Properties":{"id":"20240611095533-z56l2dp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" ①预防输血反应"}]},{"ID":"20240611095533-qhfavmf","Type":"NodeParagraph","Properties":{"id":"20240611095533-qhfavmf","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"输血前15～30分钟服红枣汤（红枣20枚，地肤子、炒荆芥各3钱）。据46人次观察，无反应者占2／3左右，且很少出现Ⅲ°反应。但对激素未能防止反应的病例，红枣汤似亦无效。"}]},{"ID":"20240611095533-5xfb143","Type":"NodeParagraph","Properties":{"id":"20240611095533-5xfb143","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"②降低血清谷丙转氨酶水平 对于急慢性肝炎、肝硬化患者的血清转氨酶活力较高的病人，每晚睡前服红枣花生汤（红枣、花生、冰糖各1两，先煎花生，后加红枣冰糖）1剂，30天为一疗程，观察12例均有效。但对合并胆道感染、风湿活动合并心肌炎的病人，应再配合清热利胆或祛风湿的药物。"}]},{"ID":"20240611095533-r30ztyz","Type":"NodeParagraph","Properties":{"id":"20240611095533-r30ztyz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611095533-40c7e05","Type":"NodeParagraph","Properties":{"id":"20240611095533-40c7e05","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 大枣因加工的不同，而有红枣、黑枣之分。入药一般以红枣为主。"}]},{"ID":"20240611095533-4dgo0io","Type":"NodeParagraph","Properties":{"id":"20240611095533-4dgo0io","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095533-h9b1ep6","Type":"NodeParagraph","Properties":{"id":"20240611095533-h9b1ep6","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611095533-21y644k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095533-21y644k","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"《中华本草》：大枣"}]},{"ID":"20240611095533-l4own7x","Type":"NodeParagraph","Properties":{"id":"20240611095533-l4own7x","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095533-76o60vv","Type":"NodeParagraph","Properties":{"id":"20240611095533-76o60vv","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" Dà Zǎo"}]},{"ID":"20240611095533-pyvcria","Type":"NodeParagraph","Properties":{"id":"20240611095533-pyvcria","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095533-yyx8suz","Type":"NodeParagraph","Properties":{"id":"20240611095533-yyx8suz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 壶、木蜜、干枣、美枣、良枣、红枣、干赤枣、胶枣、南枣、白蒲枣、半官枣、刺枣。"}]},{"ID":"20240611095533-3xusmqx","Type":"NodeParagraph","Properties":{"id":"20240611095533-3xusmqx","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611095533-9l7wrpp","Type":"NodeParagraph","Properties":{"id":"20240611095533-9l7wrpp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" Chinese Date, Jujube"}]},{"ID":"20240611095533-n0puo9n","Type":"NodeParagraph","Properties":{"id":"20240611095533-n0puo9n","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611095533-1h080r0","Type":"NodeParagraph","Properties":{"id":"20240611095533-1h080r0","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240611095533-jfpg346","Type":"NodeParagraph","Properties":{"id":"20240611095533-jfpg346","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095533-aqsbcl9","Type":"NodeParagraph","Properties":{"id":"20240611095533-aqsbcl9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鼠李科植物枣的果实。"}]},{"ID":"20240611095533-zm5a3z7","Type":"NodeParagraph","Properties":{"id":"20240611095533-zm5a3z7","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Ziziphus jujuba Mill."}]},{"ID":"20240611095533-ex5993w","Type":"NodeParagraph","Properties":{"id":"20240611095533-ex5993w","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季果实成熟时采收，一般随采、随晒。选干燥的地块搭架铺上席箔，将枣分级分别摊在席箔上晾晒，当枣的含水量下降到15％以下时可并箔，然后每隔几日揭开通风，当枣的含水量下降到10％时，即可贮藏。大枣果皮薄，含水分多，采用阴干的方法制干。亦可选适宜品种，加工成黑枣。"}]},{"ID":"20240611095533-9e7l77l","Type":"NodeParagraph","Properties":{"id":"20240611095533-9e7l77l","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611095533-3f0x8x5","Type":"NodeParagraph","Properties":{"id":"20240611095533-3f0x8x5","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1700m以下的山区、丘陵或平原，全国各地广为栽培，栽培品种甚多。"}]},{"ID":"20240611095533-42p16jz","Type":"NodeParagraph","Properties":{"id":"20240611095533-42p16jz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"资源分布：原产我国，现亚洲、欧洲、和美洲常有种植。"}]},{"ID":"20240611095533-w9lhljt","Type":"NodeParagraph","Properties":{"id":"20240611095533-w9lhljt","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611095533-70h2n72","Type":"NodeParagraph","Properties":{"id":"20240611095533-70h2n72","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 枣 落叶灌木或小乔木，高达10m。有长枝、短枝和新枝，长枝平滑，无毛，幼枝纤细略呈“之”形弯曲，紫红色或灰褐色，具2个托叶刺，长刺可达3cm，粗直，短刺下弯，长4-6mm；短枝短粗，长圆状，自老枝发出；当年生小枝绿色，下垂，单生或2-7个簇生于短枝上。单叶互生，纸质，叶柄长1-6mm，长枝上的可达1cm；叶片卵形、卵状椭圆形，长3-7cm，宽2-4cm，先端钝圆或圆形，具小尖头，基部稍偏斜，近圆形，边缘具细锯齿，上面深绿色，无毛，下面浅绿色，无毛或沿脉被疏柔毛；基生三出脉。花黄绿色，两性，常2-8朵着生于叶腋成聚伞花序；萼5裂，裂片卵状三角形；花瓣5，倒卵圆形，基部有爪；雄蕊5，与花瓣对生，着生于花盘边缘；花盘厚，肉质，圆形，5裂；子房2室．与花盘合生，花柱2半裂。核果长圆形或长卵圆形，长2-3.5cm，直径1.5-2cm，成熟时红色，后变红紫色，中果皮肉质、厚、味甜，核两端锐尖。种子扁椭圆形，长约1cm。花期5-7月，果期8-9月。"}]},{"ID":"20240611095533-7z6fgz2","Type":"NodeParagraph","Properties":{"id":"20240611095533-7z6fgz2","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611095533-7wjqmen","Type":"NodeParagraph","Properties":{"id":"20240611095533-7wjqmen","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜干燥冷凉气候，喜光、耐寒、耐旱、耐盐碱，能耐-31.3℃的低温，也能耐39.3℃的高温。向阳干燥的山坡、丘陵、荒地、平原及路旁均可种植，以破土或砂壤土最宜栽培，不适于低洼水涝地。"}]},{"ID":"20240611095533-depcmdp","Type":"NodeParagraph","Properties":{"id":"20240611095533-depcmdp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、分株及嫁接繁殖。种子繁殖：春季播种的种子须经沙藏处理，在解冻后播种，秋播在10月中下旬进行。按行距33cm开沟，深7-10cm。每隔7-10cm播种1粒，覆土2-3cm，浇水保湿。分株繁殖：将老株根部发出的新枝连根劈下栽种。嫁接的枣树生长较快，刺较少，结果较早。多以酸枣为砧木，采用芽接、切接、皮下接、根接等方法。育苗1-2年即可定植，可在春季发芽前和秋季落叶后进行，在山坡地种植，应修鱼鳞坑、小台田、水平梯田，行株距为3m×3m；缓坡地行株距5m×4m或6m×5m。定植穴的直径为80-100cm，每穴施土粪肥25-50kg，定植后立即灌水。"}]},{"ID":"20240611095533-m8f3fgz","Type":"NodeParagraph","Properties":{"id":"20240611095533-m8f3fgz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"田间管理 在萌动期，展叶后及现蕾期均应灌水，一般冬、春季施基肥（如堆肥、厩肥、骨粉等），在开花前每株施硫酸铵、过磷酸钙0.5-1kg，适当进行中耕除草。幼年枣园可与矮生作物如花生、豆类、红薯间作。"}]},{"ID":"20240611095533-q8eu2r8","Type":"NodeParagraph","Properties":{"id":"20240611095533-q8eu2r8","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有枣疯病，对初感病势较轻的植株，增施有机肥料，发现病株随即拔除，病情严重的大树也应连根挖除，并全部烧掉。虫害有步曲虫（枣尺蠖）、桃小食心虫、枣粘虫、刺蛾（洋辣子）、枣叶壁虱等。除选育抗病虫新品种外，还可采用刮树皮、堵树洞、筛虫茧、清除枣园杂草和有病虫的落枝叶、落果等方法。对枣叶壁虱在发芽前喷3-5波美度石硫合剂。"}]},{"ID":"20240611095533-u472spw","Type":"NodeParagraph","Properties":{"id":"20240611095533-u472spw","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095533-p34h9tp","Type":"NodeParagraph","Properties":{"id":"20240611095533-p34h9tp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果实椭圆形或球形，长2-3.5cm，直径1.5-2.5cm。表面暗红色，略带光泽，有不规则皱纹。基部凹陷，有短果柄。外果皮薄，中果皮棕黄色或淡褐色，肉质，柔软，富糖性而油润。果核纺锤形，两端锐尖，质坚硬。气微香，味甜。"}]},{"ID":"20240611095533-e2da9rj","Type":"NodeParagraph","Properties":{"id":"20240611095533-e2da9rj","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"显微鉴别 枣果肉横切面：外果皮最外为1列表皮细胞，胞腔充满棕红色物质并有颗粒状物；外被厚5-7.5μm的角质层；内侧为4-6层厚角细胞，内含无色半透明团块状物。中果皮由类圆形薄壁细胞组成，细胞间隙大，散列不规则走向的细小维管束；薄壁细胞含颗粒状团块和草酸钙方晶及族晶。"}]},{"ID":"20240611095533-sl6fusg","Type":"NodeParagraph","Properties":{"id":"20240611095533-sl6fusg","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611095533-6c55v03","Type":"NodeParagraph","Properties":{"id":"20240611095533-6c55v03","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 台湾大枣中的SpinosaA和B作为催眠药作用时，发现毒性反应。除了大枣种子的这两种成分有毒性外，其他尚未见毒性方面的报道。"}]},{"ID":"20240611095533-19zlhgz","Type":"NodeParagraph","Properties":{"id":"20240611095533-19zlhgz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611095533-xh8k3e5","Type":"NodeParagraph","Properties":{"id":"20240611095533-xh8k3e5","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 1．枣果实含生物碱：光千金藤碱（stephar-ine），N-去甲基荷叶碱（N-nornuciferine），巴婆碱（asmilobine）。"}]},{"ID":"20240611095533-043v3r4","Type":"NodeParagraph","Properties":{"id":"20240611095533-043v3r4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"又含三萜酸类化合物：白桦脂酮酸（betulonic acid），齐墩果酸（oleanoic acid），马斯里酸（maslinic acid）即是山楂酸（cratagolicacid），3-O-反式对-香豆酰马斯里酸（3-O-trans-p-coumaroyl-maslinic acid），3-O-顺式对香豆酰马斯里酸（3-O-cis-p-coumaroyl-maslinic acid），白桦脂酸（betulinic acid），麦珠子酸（alphitolic acid），3-O-反式对香豆酰麦珠子酸（3-O-trans-p-coumaroyl alphi-tolic acid），3-O-顺式对-香豆酰麦珠子酸（3-O-cis-P-coumaroylal-phitolic acid）。还含皂式类化合物：大枣皂式（zizyphus saponin）Ⅰ、Ⅱ、Ⅲ和酸枣皂甙（jujuboside）B。另合环磷酸腺甙（cyclic adenosine 3＇，5’-monophasphate cAMP）和环磷酸鸟甙（cyclic guanosine 3＇，5’-monophosphate，cGMP）。又，果实的水溶性浸出物中含果糖（fructose），葡萄糖（glucose），蔗糖（sucrose），果糖和葡萄糖的低聚糖及少量的阿拉伯聚糖及半乳糖醛酸聚糖；果实所含的主要脂肪酸是油酸（oleic acid），所含的甾醇有谷甾醇（sitosterol）、豆甾醇（stigmasterol）和少量的链甾醇（desmosterol），果肉中还含芸香甙（rutin），含量可达3 385mg/100g，维生素 C 540-972mg/100g以及核黄素（ri-boflavine），硫胺素（thiamine），胡萝卜素（carotene），烟酸（nicotinic acid）等。又含鞣质（tannin），香豆精衍生物（coumarin deriva-tives），类脂类（lipids），树脂类（resins），苹果酸（malic acid）等。"}]},{"ID":"20240611095533-d18a9es","Type":"NodeParagraph","Properties":{"id":"20240611095533-d18a9es","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"种仁含酸枣仁皂甙A、B、B1。又含蚓哚乙酸（indole acetic acid）。大枣还含赖氨酸（lysine），天冬氨酸（aspartic acid），天冬酰胺（asparagine），甘氨酸（glycine），谷氨酸（glutamic acid），丙氨酸（alanine），脯氨酸（proline），缬氨酸（valine），亮氨酸（leucine）等氨基酸和包括硒在内的36种微量元素。"}]},{"ID":"20240611095533-u5q9kf6","Type":"NodeParagraph","Properties":{"id":"20240611095533-u5q9kf6","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"2．无刺枣果实含甙类化合物：无刺枣苄甙（zizybeoside）Ⅰ及Ⅱ无刺枣催吐醇甙（zizyvoside）Ⅰ及Ⅱ，长春花甙（roseoside）。还含生物碱成分：酸枣碱（zizyphusin），无刺枣碱（daechu-alkaloid）A，荷叶碱（nuciferine），衡州乌药碱（co-claurine），原荷叶碱（nornuciferine），观音莲明碱（lysicamine）。又含环肽化合物：无刺枣环肽-1（daechucy-clopeptide-1）、无刺枣因（daechuine）S3等。还含催吐萝芙木醇（vomifliol），6，8-二-C-葡萄糖-2（S）-柚皮素[6，8-di-C-gluco-syl-2（S）-naringenin]，6，8-二-C-葡萄糖基-2（R）-油皮素[6，8-di-C-glucosyl-2（R）-naringenin，棕榈油酸（palmitoseic acid），11-十八碳烯酸（vaccenic acid），油酸（oleic acid）以及环磷酸腺甙，无刺枣阿聚糖（zizyphus-arabinan），糖脂（glycolipid），磷脂（phospholipid）等。"}]},{"ID":"20240611095533-nk82udh","Type":"NodeParagraph","Properties":{"id":"20240611095533-nk82udh","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611095533-tpg4kbf","Type":"NodeParagraph","Properties":{"id":"20240611095533-tpg4kbf","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 1.抗肿瘤作用1.1对N-甲基-N-硝基-N-亚硝基胍（MNNG）诱发大鼠腺胃癌的抑制作用 纯化的Wistrar系大鼠，体重80-120g，雄雌兼用。随机分组I组（对照组），18只，仅给自来水及普通干块饲料。Ⅱ组（MNNG组），18只，自由摄取MNNG100ug/ml连续10mo，其后改喂自来水。给普通干块饲料。Ⅲ组（MNNG同时加枣组），16只，给MNNG100ug/ml的同时给大枣（干果），每鼠每日约1g，mo15停药。其它同Ⅱ组。组（MNNG7mo后加枣组）125只，给MNNG100ug/m17mo月后加大枣至第15个月止。其它同Ⅲ组。将自行死亡或处死者，留胃、十二指肠、小肠、大肠、肝、淋巴结及肺等脏器。胃一般沿大弯切开，取0·3-0·4cm三块组织,固定于酒精、福尔马林溶液，作组织切片，H.E染色。以肉眼和镜下观察形态学改变及胃肠癌的发生率。用MNNG100ug/ml处理大鼠的同时连椟15mo喂给大枣Ⅱ组腺胃腺癌的发生率为15.4（2/13），胃肠道恶性肿瘤总的发生率为38.4%（5/13）；MNNG100ug/ml处理大鼠7mo后，连续8mo投给大枣的Ⅳ组腺胃腺癌的发生率为21.7%（5/23），胃肠道癌瘤总的发生率为34.8%（8/23），与Ⅱ组（MNNG）胃肠道癌瘤的发生率71.14%（10/14）相比，（P＜0.05）有显着性差异。说明用MNNG处理大鼠后，长期喂给中药大枣似有降低胃肠道恶性肿瘤发生率的作用。"}]},{"ID":"20240611095533-xnl3e1k","Type":"NodeParagraph","Properties":{"id":"20240611095533-xnl3e1k","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"1.2对肉瘤一180增殖的抑制作用 从大枣分离得到的三萜类化合物中进一步分离出游离型、酯活性的桦木酸、山楂酸，连续给药7d（25mg/日），对5-35%肉瘤一180增殖有抑制效果，特别是山楂酸，连续给药14日，有61%的抑制效果，比5一Fu抑制率更强。"}]},{"ID":"20240611095533-5n554cf","Type":"NodeParagraph","Properties":{"id":"20240611095533-5n554cf","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"2.抗Ⅰ型变态反应的作用2.1对抗IgE刺激所致人外周血嗜碱性白细胞释放白三烯（LTD4）的抑制作用 大枣10g，加热水100ml提取，得到大枣提取液。用Hubscher法自血液中分离出嗜碱性白细胞。体外培养用Lichteinstein和Osler两步法，以2X10-2抗体氮/ml的抗IgE刺激时，在第二步加入1:10稀释的大枣提取液。LTD4的测定按Samuelsson法进行。结果可见致敏者外周嗜碱性白细胞在未加任何刺激时，LTD4的产生极少（自发性释放），而用2X10-2抗体氮/ml的抗IgE刺激时可见LTD4释放。在第二步加入1:10稀释的大枣提取液时，LTD4的释放与自发性释放大致相同。其机理与大枣所含的cAMP易透过白细胞膜而作用于化学介质释放的第二期，抑制LTD4的释放，因与而抑制变态反应有关。"}]},{"ID":"20240611095533-1sg5vdv","Type":"NodeParagraph","Properties":{"id":"20240611095533-1sg5vdv","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"2.2对IgE抗体产生有特异性抑制作用 大枣乙醇提取物中的乙基-a-果糖甙（ethyl?-D-fructofuranoside）100mg/kg腹腔注射，对大鼠被动皮肤过敏反应有抑制作用。该化合物是在乙醇提取中与大枣所含的果糖在有机媒介作用下生成,具有对IgE抗体的产生有特异性抑制作用。对5-羟色胺和组胺有拮抗作用。抗过敏作用与大枣中含有的cAMP样物质也有关。另外，有报道大枣中的酯型三萜系化合物中香豆酸能提高佐剂的活性。"}]},{"ID":"20240611095533-g5ijzu9","Type":"NodeParagraph","Properties":{"id":"20240611095533-g5ijzu9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"3.其它作用3.1对中枢神经的抑制作用 采用延长硫喷妥钠作用作为指标，发现大枣内苯甲醇糖甙、柚配质（糖甙等多种化合物）具有显着降压作用，并确认柚配质（糖甙类）能降低自发运动，刺激反射作用，强直性木僵作用，并对中枢神经有抑制作用。"}]},{"ID":"20240611095533-jsbgmlr","Type":"NodeParagraph","Properties":{"id":"20240611095533-jsbgmlr","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"3.2对体重、肌力的作用 雄性小白鼠，体重10-20g，分大枣组，对照组各18只。大枣组每天上午用30%大枣煎剂按体重0.3ml/kg，对照组给水0.3ml/kgip，实验中对小鼠分别以吞米混合饲料及蔬菜饲养3wk，上午空腹时称重，大枣组平均增加体重3.0g，对照组则平均增加1.6g。同时，两组动物进行空腹游泳试验，结果大枣组为3分钟50s，而对照组为2分钟30s。证明有增加体重、增强肌力作用。"}]},{"ID":"20240611095533-0tx1gx4","Type":"NodeParagraph","Properties":{"id":"20240611095533-0tx1gx4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"3.3对实验性肝病变家兔血清白蛋白的影响 雄性家兔2只，体重2kg，用四氯化碳0·25ml/kgip，1周后以耳静脉内注射1%硫喷妥钠1ml/kg，结果麻醉时间比正常延长一倍以上。说明肝脏机能降低对硫喷妥钠的解毒作用，肝脏发生轻度病变。然后再用30%大枣煎剂，每天上午喂食前ipl周。实验性家兔进行自身对照血清白蛋白，结果表明，总蛋白正常值5·14g%，治疗前4.6g%，治疗后1wk4.90g%，白蛋白正常组3.10%，治疗前2.46g%，治疗1周后3.00g%；球蛋白2.04g%（正常值）治疗前2.23g%，治疗后周1.90g%。"}]},{"ID":"20240611095533-mn7gksp","Type":"NodeParagraph","Properties":{"id":"20240611095533-mn7gksp","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611095533-tbzvjxh","Type":"NodeParagraph","Properties":{"id":"20240611095533-tbzvjxh","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 净制：去除杂质；洗净，晒干。切制：除去杂质切开去核"}]},{"ID":"20240611095533-0bnfrru","Type":"NodeParagraph","Properties":{"id":"20240611095533-0bnfrru","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611095533-j5pmofn","Type":"NodeParagraph","Properties":{"id":"20240611095533-j5pmofn","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取大枣果肉碎块，用乙醇浸泡过夜。（1）取浸出液滴于滤纸上，置紫外灯（365nm）下观察，显蓝色荧光。（检查香豆素类）（2）取浸出液1ml，加3％碳酸钠溶液1ml，于水治上加热3-5min，放冷，再加入重氮化试剂，溶液呈紫红色。（检查香豆素类）（3）取浸出液1ml，加盐酸羟胺试液及10％氢氧化钾的甲醇溶液至呈碱性，于水浴上加热至反应完全，冷却，加盐酸酸化，并加入1％三氯化铁试液，混匀，溶液呈橙红色。（检查香豆素类）（4）取浸出液适量置蒸发皿中，于水浴上浓缩至干，加稀盐酸溶解，滤过。在3支试管中各加入2ml滤液，分别加1滴碘化秘钾、碘化汞钾、硅钨酸试剂，各自产生橘红色、黄色、白色沉淀。（检查生物碱）"}]},{"ID":"20240611095533-gkhy03e","Type":"NodeParagraph","Properties":{"id":"20240611095533-gkhy03e","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095533-abgg1p5","Type":"NodeParagraph","Properties":{"id":"20240611095533-abgg1p5","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 脾；胃经"}]},{"ID":"20240611095533-own5ra3","Type":"NodeParagraph","Properties":{"id":"20240611095533-own5ra3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095533-5rnuvdd","Type":"NodeParagraph","Properties":{"id":"20240611095533-5rnuvdd","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 甘；温"}]},{"ID":"20240611095533-yql4oeb","Type":"NodeParagraph","Properties":{"id":"20240611095533-yql4oeb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611095533-4e4c1hb","Type":"NodeParagraph","Properties":{"id":"20240611095533-4e4c1hb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 凡有湿痰、积滞、齿病、虫病者，均不相宜。《医学入门》：心下痞，中满呕吐者忌之。多食动风，脾反受病。《本草经疏》：小儿疳病不宜食，患痰热者不宜食。《本草汇言》：胃痛气闭者，蛔结腹痛及一切诸虫为病者，咸忌之。《随息居饮食谱》：多食患胀泄热渴，最不益人。凡小儿、产后及温热、暑湿诸病前后，黄疽、肿胀长并忌之。"}]},{"ID":"20240611095533-fp8is2s","Type":"NodeParagraph","Properties":{"id":"20240611095533-fp8is2s","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095533-w0hslud","Type":"NodeParagraph","Properties":{"id":"20240611095533-w0hslud","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 补脾胃；益气血；安心神；调营卫；和药性。主脾胃虚弱；气血不足；食少便溏；倦怠乏力；心悸失眠；妇人脏躁；营卫不和"}]},{"ID":"20240611095533-k6kl11w","Type":"NodeParagraph","Properties":{"id":"20240611095533-k6kl11w","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095533-mnwlf4j","Type":"NodeParagraph","Properties":{"id":"20240611095533-mnwlf4j","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g。"}]},{"ID":"20240611095533-zo1w7kb","Type":"NodeParagraph","Properties":{"id":"20240611095533-zo1w7kb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611095533-7ntpfqa","Type":"NodeParagraph","Properties":{"id":"20240611095533-7ntpfqa","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 1.《注解伤寒论》茯苓桂枝甘草大枣汤，大枣之甘，滋助脾土，以平肾气。十枣汤，益土而胜水。"}]},{"ID":"20240611095533-e0zgc85","Type":"NodeParagraph","Properties":{"id":"20240611095533-e0zgc85","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：《素问》言枣为脾之果，脾病宜食之，谓治病和药，枣为脾经血分药也。若无故频食，则损齿，贻害多矣。"}]},{"ID":"20240611095533-6tx00k4","Type":"NodeParagraph","Properties":{"id":"20240611095533-6tx00k4","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：沈氏曰，此药甘润膏凝，善补阴阳、气血、津液、脉络、筋俞、骨髓，一切虚损，无不宜之。如龙谭方治惊悸怔忡，健忘恍惚，志意昏迷，精神不守，或中气不和，饮食无味，百体懒重，肌肉瘦,此属心、脾二藏元神亏损之证，必用大枣治之。佐用陈皮，调畅中脘虚滞之痰。"}]},{"ID":"20240611095533-bcag3hb","Type":"NodeParagraph","Properties":{"id":"20240611095533-bcag3hb","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：大黑枣，助阴补血，入肝走肾，主治虚劳，善滋二便，凡补肝肾药中，如滋阴降火汤、茯苓补心汤、产后芎归调血饮、保胎丸、养荣丸、四神丸，俱宜为佐使，因性味甘温，尤能扶脾养胃耳。"}]},{"ID":"20240611095533-lymc0lq","Type":"NodeParagraph","Properties":{"id":"20240611095533-lymc0lq","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"5.《本经逢原》古方中用大枣，皆是红枣，取生能散表也。入补脾药，宜用南枣，取甘能益津也。"}]},{"ID":"20240611095533-2espwtc","Type":"NodeParagraph","Properties":{"id":"20240611095533-2espwtc","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"6.《长沙药解》大枣，补太阴之精，化阳明之气，生津润肺而除燥，养血滋肝而熄风，疗脾胃衰损，调经脉虚芤。其味浓而质厚，则长于补血，而短于补气。人参之补土，补气似生血也；大枣之补土，补血以化气也，是以偏补脾精而养肝血。凡内伤肝脾之病，土虚木燥，风动血耗者，非此不可。而尤宜于外感发表之际，盖汗血一也，桂枝汤开经络而泄荣郁，不以大枣补其荣阴，则汗出血亡，外感去而内伤来矣。故仲景于中风桂枝诸方皆用之，补泻并行之法也。十枣汤、葶苈大枣数方悉是此意。惟伤寒荣闭卫郁，义在泄卫，不在泄荣，故麻黄汤不用也。"}]},{"ID":"20240611095533-v10u4bf","Type":"NodeParagraph","Properties":{"id":"20240611095533-v10u4bf","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"7.《本经疏证》：《伤寒论》、《金匮要略》两书，用枣者五十八方，其不与姜同用者，十一方而已，大率姜与枣联，为和营卫之主剂，姜以主卫，枣以主营，故四十七方中其受桂枝汤节制者二十四，受小柴胡汤节制者六，不受桂柴节制者十七，此盖有二焉，皆有涉于营卫，一者营卫之气为邪阻于外，欲开而出之，又恐其散之猛也，则麻黄剂中加用之以防其太过；一者营卫之气为邪阻于内，欲补而达之，又恐其补之壅也，则人参剂中加用之，以助其不及。防之于外者，欲其力匀称，故分数仍桂枝、柴胡之法；助之于内者，欲其和里之力优，而后外达能锐，故枣重于姜，此实用姜枣之权舆，枣之功能，尤于是足见者也。《金匮要略》曰，病有贲豚，有吐脓，有惊怖，有火邪，此四部病皆从惊发得之。据《本经》大枣主大惊，宜无不可用矣，而不必悉用，何哉？夫《本经》固言之矣，曰身中不足大惊。不可截去'身中不足，，仅以'大惊'二字概之也。其有非身中本不足而用枣者，必缘误治。其义只在《伤寒论》曰，少阳不可吐下，吐下则悸而惊，是故柴胡加尤骨牡蛎汤，下后证也；桂枝加桂汤，发汗及烧针后证也；茯苓桂枝甘草大枣汤，发汗后证也；贲豚汤证，则未经误治，故独不用枣，若夫《千金》风虚惊悸二十三方，用枣十一方，其方有用独后、细辛、羌活、白藓皮、银屑、大黄、石膏、蜀椒、菖蒲、防己、铁精、麻黄者，即不用枣，子此见枣之治惊，但治实中之虚、虚中之虚，而虚中有实者，则其所不能任，若实中之实，又所不待言矣。"}]},{"ID":"20240611095533-8co6rl3","Type":"NodeParagraph","Properties":{"id":"20240611095533-8co6rl3","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"8.《本经》：主心腹邪气，安中养脾，助十二经。平胃气，通九窍，补少气、少津液，身中不足，大惊，四肢重，和百药。"}]},{"ID":"20240611095533-nebebt2","Type":"NodeParagraph","Properties":{"id":"20240611095533-nebebt2","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"9.《本草经集注》：煞乌头毒。"}]},{"ID":"20240611095533-t7cg9d9","Type":"NodeParagraph","Properties":{"id":"20240611095533-t7cg9d9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"10.《别录》：补中益气，强力，除烦闷，疗心下悬，肠僻。"}]},{"ID":"20240611095533-5lw5u49","Type":"NodeParagraph","Properties":{"id":"20240611095533-5lw5u49","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"11.《药对》：杀附子、天雄毒。"}]},{"ID":"20240611095533-rybkmrn","Type":"NodeParagraph","Properties":{"id":"20240611095533-rybkmrn","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"12.孟诜：主补津液，洗心腹邪气，和百药毒，通九窍，补不足气，煮食补肠胃，肥中益气第一，小儿患秋痢，与虫枣食，良。"}]},{"ID":"20240611095533-l9xxxj1","Type":"NodeParagraph","Properties":{"id":"20240611095533-l9xxxj1","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"13.《日华子本草》：润心肺，止嗽。补五脏，治虚劳损，除肠胃癖气。"}]},{"ID":"20240611095533-stbd33a","Type":"NodeParagraph","Properties":{"id":"20240611095533-stbd33a","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"14.《珍珠囊》：温胃。"}]},{"ID":"20240611095533-z9q072d","Type":"NodeParagraph","Properties":{"id":"20240611095533-z9q072d","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"15.李杲：温以补脾经不足，甘以缓阴血，和阴阳，调营卫，生津液。"}]},{"ID":"20240611095533-ajfpkwz","Type":"NodeParagraph","Properties":{"id":"20240611095533-ajfpkwz","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"16.《药品化义》：养血补肝。"}]},{"ID":"20240611095533-p7d9r72","Type":"NodeParagraph","Properties":{"id":"20240611095533-p7d9r72","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"17.《本草再新》：补中益气，滋肾暖胃，治阴虚。"}]},{"ID":"20240611095533-e5ys5la","Type":"NodeParagraph","Properties":{"id":"20240611095533-e5ys5la","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"18.《中国药植图鉴》：治过敏性紫斑病、贫血及高血压。"}]},{"ID":"20240611095533-md9kku9","Type":"NodeParagraph","Properties":{"id":"20240611095533-md9kku9","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095533-fnz5uyq","Type":"NodeParagraph","Properties":{"id":"20240611095533-fnz5uyq","updated":"20240611095533"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611095534-lp5t6jy","Type":"NodeThematicBreak","Properties":{"id":"20240611095534-lp5t6jy"}},{"ID":"20240611095535-rcwf2x2","Type":"NodeParagraph","Properties":{"id":"20240611095535-rcwf2x2"}}]}