"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 8-20240823092936-koxchu2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823101240-9ajdy8y","Type":"NodeParagraph","Properties":{"id":"20240823101240-9ajdy8y","updated":"20240823101240"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 10-20240823093843-yxan5i4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 392px;","style":"width: 382px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 11-20240823093919-8vsels3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 382px;\" parent-style=\"width: 392px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 359px;","style":"width: 349px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 13-20240823094103-wkfwv5b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 349px;\" parent-style=\"width: 359px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823101240-u2citte","Type":"NodeParagraph","Properties":{"id":"20240823101240-u2citte","updated":"20240823101240"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 486px;","style":"width: 476px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 12-20240823094022-rcbuu45.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 476px;\" parent-style=\"width: 486px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 485px;","style":"width: 475px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 14-20240823094153-w5gwx5t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 475px;\" parent-style=\"width: 485px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628160825-ze5y3am","Type":"NodeParagraph","Properties":{"id":"20240628160825-ze5y3am","updated":"20240823101249"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：苗为蜀漆，根名常山；"}]},{"ID":"20240613081155-p82jsth","Type":"NodeThematicBreak","Properties":{"id":"20240613081155-p82jsth"}},{"ID":"20240613081358-1dj3uhe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081358-1dj3uhe","updated":"20240613081405"},"Children":[{"Type":"NodeText","Data":"蜀漆《神农本草经》"}]},{"ID":"20240613081358-6xie6x8","Type":"NodeParagraph","Properties":{"id":"20240613081358-6xie6x8","updated":"20240613081358"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240613081358-8ma3nok","Type":"NodeParagraph","Properties":{"id":"20240613081358-8ma3nok","updated":"20240613081358"},"Children":[{"Type":"NodeText","Data":"主疟及咳逆，寒热，腹中症坚，痞结，积聚邪气，蛊毒，鬼注（旧作，《御览》作蛀）。生川谷。"}]},{"ID":"20240613081358-0415r9w","Type":"NodeParagraph","Properties":{"id":"20240613081358-0415r9w","updated":"20240613081358"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：蜀漆叶，一名恒山，神农岐伯雷公辛有毒，黄帝辛，一经酸，如漆叶蓝青相似，五月采（《御览》）。"}]},{"ID":"20240613081358-51l9nh4","Type":"NodeParagraph","Properties":{"id":"20240613081358-51l9nh4","updated":"20240613081358"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生江陵山，及蜀汉中常山，苗也，五月采叶，阴干。"}]},{"ID":"20240613081358-4c4e4rh","Type":"NodeParagraph","Properties":{"id":"20240613081358-4c4e4rh","updated":"20240613081358"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：恒山蜀漆也。《范子计然》云：蜀漆出蜀郡。"}]},{"ID":"20240613081427-sru1wfh","Type":"NodeThematicBreak","Properties":{"id":"20240613081427-sru1wfh"}},{"ID":"20240613081428-4ung97p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081428-4ung97p","updated":"20240613081433"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草纲目》"}]},{"ID":"20240613081428-6cbc4bs","Type":"NodeParagraph","Properties":{"id":"20240613081428-6cbc4bs","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"「释名」蜀漆是常山的苗，功用是相同。"}]},{"ID":"20240613081428-vysdjux","Type":"NodeParagraph","Properties":{"id":"20240613081428-vysdjux","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"「气味」辛、平、有毒。"}]},{"ID":"20240613081428-4dl1q5q","Type":"NodeParagraph","Properties":{"id":"20240613081428-4dl1q5q","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613081428-1io2oj1","Type":"NodeParagraph","Properties":{"id":"20240613081428-1io2oj1","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"1、截疟：截疟诸汤：用常山三两、浆水三升，泡一夜，煎取一升。发病前一次服完，能吐为好。又方：用常山一两秫米一百粒，加水六升，煮成三升，分三次服（先一夜、未发时、临发时各一次）。又方：常山（酒煮后晒干）、知母、贝母草果各一钱半，加水一杯，煎半熟，五更时热服。药渣泡酒，发病前取饮。截疟诸酒：用常山一两，酒一升，泡二、三日后，分三次服完：清早一服，过一会再服，发病前第三次服。又方：治间日疟：常山一钱二分、大黄二钱半、炙甘草一钱二分，加水一碗半，煎至五成，叫做“醇”，发病日蝗五更温服；原药再加水一碗，煎至五成，叫做“”，未发病之日温服。此方名“醇汤”，甚验。又方：治久疟不止：常山一钱半、槟榔一钱、丁香五分、乌梅一个，酒一盏，泡药一夜，五更时饮下。一服便止，永不发病。截疟诸丸：常山三两，研为末。加鸡蛋白和成丸子，如梧子在。瓦器内煮熟，取出晒干收存。每服二十丸，竹叶汤送上，五更一服，天明后一服，发病前一服，此方名“恒山丸”。数年不愈的疟疾，服两剂即愈；一月左右者，只须一剂。又方；常山捣成末，取三两，黄丹一两，加白蜜共捣匀，做成丸子，如梧子大。病发前服三丸，过一会再服三丸，临归病时又服三丸，酒送下。此方名“丹砂丸”。又方：常山二两、黄丹半两、乌梅（连核瓦焙）一两，共研为末，加糯米粉糊成丸子，如梧子大。每服三、五十丸，凉酒送下。先一夜一服，天明时一服，午后才进食，此方名“黄丹丸”。又方：用常山三两、知母一两、甘划昱两，共研为末，加蜜和丸，如梧子大。发病前服十丸，稍后服七丸，再后服五、六丸。又方：治一切疟，用常山四两，炒存性，草果二两，炒存性，共研为末，加薄糊做成丸子，如梧子大。每卧时服五十丸，冷酒送下。五更时再服一次。忌鹅羊热物。此方名“瞻仰丸”。又方：常山八两，酒浸后先蒸后焙，加要槟榔二两，生研末，拦糊作丸，如梧子大。如上方服法服丸子，此方名“胜金丸”。又方：常山、槟榔各一两，生研，加穿山甲的甲片（煨焦）一两半，共三工业区末。以糯米粉和末做成丸子，如绿豆大，黄丹为衣。每服三十至五十丸，服法同上此方名“二圣丸”。"}]},{"ID":"20240613081428-s4hz3d2","Type":"NodeParagraph","Properties":{"id":"20240613081428-s4hz3d2","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"2、牝疟（只寒不热）。用蜀漆（去母煅三日暗伤）龙骨各二钱，共研为末。每服半钱，临发病之昌早晨一服，发病前再一服，浆水调下。如系温疟（热多于寒）又加蜀漆一钱，此方名“蜀漆散”。"}]},{"ID":"20240613081428-entnurj","Type":"NodeParagraph","Properties":{"id":"20240613081428-entnurj","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"3、牡疟（只热不寒）。用蟓漆一钱半、甘草一钱、麻黄二钱、牡蛎粉二钱，先以水二杯，煎麻黄、蜀漆，去沫，再将其余各药倒入同煎至一杯，未发病前温服，得吐则疟止。"}]},{"ID":"20240613081428-8p1t5yj","Type":"NodeParagraph","Properties":{"id":"20240613081428-8p1t5yj","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"4、妊娠疟疾。用常山（酒蒸）、石膏（煅）各残，乌梅（炒）五分，甘草四分，加水一碗、酒一碗泡一夜，天明时温服。"}]},{"ID":"20240613081428-rep6w07","Type":"NodeParagraph","Properties":{"id":"20240613081428-rep6w07","updated":"20240613081428"},"Children":[{"Type":"NodeText","Data":"5、小儿惊风暴死。用蜀漆（炒）二钱、牡蛎一钱二分，浆米煎服。吐出痰涎即愈。此方名“千金汤”。"}]},{"ID":"20240613081443-9ne6rjz","Type":"NodeThematicBreak","Properties":{"id":"20240613081443-9ne6rjz"}},{"ID":"20240613081444-9ngmgmu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081444-9ngmgmu","updated":"20240613081448"},"Children":[{"Type":"NodeText","Data":"蜀漆《千金翼方》"}]},{"ID":"20240613081444-0nz3ed8","Type":"NodeParagraph","Properties":{"id":"20240613081444-0nz3ed8","updated":"20240613081444"},"Children":[{"Type":"NodeText","Data":"味辛，平，微温，有毒。主疟及咳逆寒热，腹中症坚痞结，积聚邪气，蛊毒鬼疰。疗胸中邪结气，吐出之。生江林山川谷，及蜀汉中。常山苗也，五月采叶，阴干。"}]},{"ID":"20240613081824-82k60j7","Type":"NodeThematicBreak","Properties":{"id":"20240613081824-82k60j7"}},{"ID":"20240613081826-fjdrwt5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081826-fjdrwt5","updated":"20240613081830"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草衍义》"}]},{"ID":"20240613081826-9of6jny","Type":"NodeParagraph","Properties":{"id":"20240613081826-9of6jny","updated":"20240613081826"},"Children":[{"Type":"NodeText","Data":"常山苗也。治疟、多吐人，其他亦未见所长。此草也。虑岁久，人或别有异论，故预云。余如经。"}]},{"ID":"20240613081836-nlzxa0x","Type":"NodeThematicBreak","Properties":{"id":"20240613081836-nlzxa0x"}},{"ID":"20240613081837-g5mj2h0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081837-g5mj2h0","updated":"20240613081843"},"Children":[{"Type":"NodeText","Data":"蜀漆《雷公炮炙论》"}]},{"ID":"20240613081837-85i5kuh","Type":"NodeParagraph","Properties":{"id":"20240613081837-85i5kuh","updated":"20240613081837"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡采得后，和根苗，临用时即去根，取茎并叶，同拌甘草四两，细锉用，拌水令湿同蒸，临时去甘草，取蜀漆五两细锉，又拌甘草水匀，又蒸了，任用。"}]},{"ID":"20240613081837-r9ledvo","Type":"NodeParagraph","Properties":{"id":"20240613081837-r9ledvo","updated":"20240613081837"},"Children":[{"Type":"NodeText","Data":"勿食木笋。"}]},{"ID":"20240613081923-2catsxj","Type":"NodeThematicBreak","Properties":{"id":"20240613081923-2catsxj"}},{"ID":"20240613081925-456cmag","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081925-456cmag","updated":"20240613081929"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草崇原》"}]},{"ID":"20240613081925-5zi4ftw","Type":"NodeParagraph","Properties":{"id":"20240613081925-5zi4ftw","updated":"20240613081925"},"Children":[{"Type":"NodeText","Data":"气味辛平，有毒。主治疟及咳逆寒热，腹中坚症痞结，积聚邪气，蛊毒鬼疰。"}]},{"ID":"20240613081925-mkkm2k7","Type":"NodeParagraph","Properties":{"id":"20240613081925-mkkm2k7","updated":"20240613081925"},"Children":[{"Type":"NodeText","Data":"（常山之茎，名蜀漆，其功用亦与常山相等。）"}]},{"ID":"20240613081925-3wyli5t","Type":"NodeParagraph","Properties":{"id":"20240613081925-3wyli5t","updated":"20240613081925"},"Children":[{"Type":"NodeText","Data":"蜀漆能通金水之气，以救火逆，又能启太阳之阳，以接助其亡阳，亦从阴出阳之药也。"}]},{"ID":"20240613081925-h24omr2","Type":"NodeParagraph","Properties":{"id":"20240613081925-h24omr2","updated":"20240613081925"},"Children":[{"Type":"NodeText","Data":"故《伤寒·太阳篇》云∶伤寒脉浮，医以火迫劫之，亡阳必惊狂，起卧不安者，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。又，《金匮论》云∶疟多寒者，名曰牝疟。蜀漆散主之。李时珍曰∶常山、蜀漆有劫痰截疟之功，须在发散表邪，及提出阳分之后，用之得宜，神效立见。用失其法，真气必伤。"}]},{"ID":"20240613081925-tflir8h","Type":"NodeParagraph","Properties":{"id":"20240613081925-tflir8h","updated":"20240613081925"},"Children":[{"Type":"NodeText","Data":"愚谓∶疟乃伏邪，有留于脏腑募原之间，而为三阴疟者；有藏于肾脏，而为先热后寒之温疟者；有气藏于心，而为但热不寒之瘅疟者。常山主通少阴太阳之气，从阴出阳，自内而外，则邪随气出，所谓有故无殒。若邪已提出阳分。而反用攻利之剂，岂不妄伤正气乎。李蕲阳数十年苦心始成《纲目》，而其间发明议论，有与经旨不合者，长于纂集，而少于参究故也。"}]},{"ID":"20240613081639-qksivt0","Type":"NodeThematicBreak","Properties":{"id":"20240613081639-qksivt0"}},{"ID":"20240613081640-70opr6w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081640-70opr6w","updated":"20240613081644"},"Children":[{"Type":"NodeText","Data":"蜀漆《汤液本草》"}]},{"ID":"20240613081640-c8utoaq","Type":"NodeParagraph","Properties":{"id":"20240613081640-c8utoaq","updated":"20240613081640"},"Children":[{"Type":"NodeText","Data":"气微温，味辛，纯阳。辛平，有毒。"}]},{"ID":"20240613081640-ohqkysw","Type":"NodeParagraph","Properties":{"id":"20240613081640-ohqkysw","updated":"20240613081640"},"Children":[{"Type":"NodeText","Data":"《珍》云∶破血。"}]},{"ID":"20240613081640-50zvbyy","Type":"NodeParagraph","Properties":{"id":"20240613081640-50zvbyy","updated":"20240613081640"},"Children":[{"Type":"NodeText","Data":"《心》云∶洗去腥，与苦酸同用，导胆。"}]},{"ID":"20240613081640-ifezb4o","Type":"NodeParagraph","Properties":{"id":"20240613081640-ifezb4o","updated":"20240613081640"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主疟及咳逆、寒热，腹中症坚、痞结、积聚，邪气、蛊毒、鬼疰，疗胸中邪结气，能吐出之。"}]},{"ID":"20240613081640-4cf1953","Type":"NodeParagraph","Properties":{"id":"20240613081640-4cf1953","updated":"20240613081640"},"Children":[{"Type":"NodeText","Data":"成无己注云∶火邪错逆，加蜀漆之辛以散之。"}]},{"ID":"20240613081809-01tfba9","Type":"NodeThematicBreak","Properties":{"id":"20240613081809-01tfba9"}},{"ID":"20240613081810-k0f72u3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081810-k0f72u3","updated":"20240613081815"},"Children":[{"Type":"NodeText","Data":"蜀漆《药征续编》"}]},{"ID":"20240613081810-yt57mv9","Type":"NodeParagraph","Properties":{"id":"20240613081810-yt57mv9","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"主治胸腹及脐下动剧者，故兼治惊狂，火逆疟疾。"}]},{"ID":"20240613081810-0atftom","Type":"NodeParagraph","Properties":{"id":"20240613081810-0atftom","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240613081810-4a1xry4","Type":"NodeParagraph","Properties":{"id":"20240613081810-4a1xry4","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"桂枝去芍药加蜀漆龙骨牡蛎救逆汤证曰∶惊狂起卧不安者。"}]},{"ID":"20240613081810-bhgvso7","Type":"NodeParagraph","Properties":{"id":"20240613081810-bhgvso7","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"牡蛎汤证曰∶牡疟。"}]},{"ID":"20240613081810-7xilhu3","Type":"NodeParagraph","Properties":{"id":"20240613081810-7xilhu3","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"上二方，蜀漆各三两。"}]},{"ID":"20240613081810-m4kisqq","Type":"NodeParagraph","Properties":{"id":"20240613081810-m4kisqq","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"牡蛎泽泻散，证不具。"}]},{"ID":"20240613081810-lt72jn0","Type":"NodeParagraph","Properties":{"id":"20240613081810-lt72jn0","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"蜀漆散证曰∶牡疟，多寒者。"}]},{"ID":"20240613081810-6yyl6y6","Type":"NodeParagraph","Properties":{"id":"20240613081810-6yyl6y6","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"上二方，蜀漆诸药等分。"}]},{"ID":"20240613081810-exk82cr","Type":"NodeParagraph","Properties":{"id":"20240613081810-exk82cr","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"据此诸方，则蜀漆之为功，古来未尝谓治动矣。然疟疾，及惊狂火逆诸证，必有胸腹脐下动剧者。故见其有动者而用之，则法证无不治者。然则蜀漆者，治胸腹及脐下动剧者明矣。"}]},{"ID":"20240613081810-ykn687a","Type":"NodeParagraph","Properties":{"id":"20240613081810-ykn687a","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240613081810-tpuke3v","Type":"NodeParagraph","Properties":{"id":"20240613081810-tpuke3v","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"牡蛎汤服法曰∶吐则勿更服。今疟疾有喘鸣急迫，或自汗，或不汗，胸腹动剧者，服之，则其人必吐水数升，而无其证不愈者，若有不吐者，则其证不愈也。由此观之，蜀漆能吐水毒，动是水毒明矣。当知疟之为病，亦水毒之所为矣。虽然，此方岂惟治疟疾乎？凡病患喘鸣迫塞，或自汗，或不汗，胸腹动剧，皆此方能治之。往来寒热，发作有时，所以不豫也。晋唐以来，世医之见仲景之方也，皆以为惟治伤寒者。故如彼葛洪、孙思邈、王焘、许叔微之书，皆知备仲景之方于伤寒门，而未尝知治万病矣。殊不知仲景本取治万病之方，以治伤寒矣。降至赵宋之时，有《金匮要略》之书，当时如王洙，得仲景治伤寒中杂病证之方于蠹简之中，而后各分其门，以为一书。世之为医者，遂称其书谓之《金匮玉函》之方。金匮之玉函之，盖尊重之至也。自此以往，世之为医者，又见某门之方，以为某方惟治某证，于是乎如牡蛎汤蜀漆散二方，亦署诸疟疾篇内，而徒知治疟疾，未尝知治余病矣。甚之束之高阁，而谓古方不宜今病，可胜叹哉！呜呼！仲景之方法之衰也，不独王叔和为之，彼葛孙王许实为之，又医道之大罪人乎哉？"}]},{"ID":"20240613081810-w64o1a1","Type":"NodeParagraph","Properties":{"id":"20240613081810-w64o1a1","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"桂枝去芍药加蜀漆龙骨牡蛎救逆汤证曰∶惊狂，起卧不安。 按∶此证者，是外证也。"}]},{"ID":"20240613081810-73g8egj","Type":"NodeParagraph","Properties":{"id":"20240613081810-73g8egj","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"凡仲景之为法，不独以外证治之，且并诊内外治之。故无胸腹及脐下动者，若虽有惊狂起卧不安证，亦非此方所宜也。呜呼！是吾东洞翁千古卓识，吾侪岂不奉此乎哉？"}]},{"ID":"20240613081810-odkm06d","Type":"NodeParagraph","Properties":{"id":"20240613081810-odkm06d","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"蜀漆散证不具，且云牡疟，盖牡疟者，独展不热，非无热也，多寒也。夫疟之为病，先其寒而后其热，虽然，不可以寒热治疟，则岂无内候在乎？曰∶必有脐下动剧矣。故仲景尝以龙骨主之，以蜀漆佐之，医者其察诸。"}]},{"ID":"20240613081810-q191svj","Type":"NodeParagraph","Properties":{"id":"20240613081810-q191svj","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"牡蛎泽泻散证不具，然以仲景用牡蛎之方推之，则其证必有胸腹之动剧。苟有胸腹之动剧，则无有不加蜀漆之方。由此观之，盖此方治水肿胸腹之动剧而渴者明矣。《方极》可考。凡仲景之治动也，其活法有三∶有胸腹之动，则以牡蛎治之；有脐下之动，则以龙骨治之；有胸腹脐下之动剧，则以蜀漆治之。此为仲景治动之三活法矣。故仲景之方，有以蜀漆配之牡蛎者，或有配之龙骨者，或有配之龙骨、牡蛎者，是又仲景用蜀漆之法也。本论不载此法者，盖属脱误。故晋唐以来，无有知蜀漆之功者，而诸病之有动者最多。则动之为病也，为诸病内候之主证，而最为难治者。虽然，二千年来，诸医之说诸家本草，何其不载龙骨、牡蛎、蜀漆之本功矣乎？或云∶牡蛎之咸，消胸腹之满；或云∶龙骨、牡蛎，收敛神气；或云∶蜀漆辛以散之；或云∶龙骨、牡蛎之涩以固之。未尝见言及治动之功者，又未尝知动之为诸病内候之主证也。吾东洞翁，生于二千年之下，始知龙骨、牡蛎、蜀漆之功，其说详于本条之下，是诚二千年来不传之说。而翁独得其旨者，不亦伟乎？韩退之尝推尊孟子，以为功不在禹之下，余以为翁之有功于我医，不在仲景之下矣。是非余之过论也。"}]},{"ID":"20240613081810-3x3oxm4","Type":"NodeParagraph","Properties":{"id":"20240613081810-3x3oxm4","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240613081810-sllo23s","Type":"NodeParagraph","Properties":{"id":"20240613081810-sllo23s","updated":"20240613081810"},"Children":[{"Type":"NodeText","Data":"蜀漆，乃常山苗，其功与常山同，蜀漆无华舶来之物。常山者，华物为良，和产多伪品。"}]},{"ID":"20240613081752-5867sks","Type":"NodeThematicBreak","Properties":{"id":"20240613081752-5867sks"}},{"ID":"20240613081753-cxhzp79","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081753-cxhzp79","updated":"20240613081758"},"Children":[{"Type":"NodeText","Data":"蜀漆《得配本草》"}]},{"ID":"20240613081753-ndg9ip2","Type":"NodeParagraph","Properties":{"id":"20240613081753-ndg9ip2","updated":"20240613081753"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即常山苗"}]},{"ID":"20240613081753-ya7m9ar","Type":"NodeParagraph","Properties":{"id":"20240613081753-ya7m9ar","updated":"20240613081753"},"Children":[{"Type":"NodeText","Data":"桔梗为之使。栝蒌为之使。恶贯众。忌葱、茗。"}]},{"ID":"20240613081753-cac644p","Type":"NodeParagraph","Properties":{"id":"20240613081753-cac644p","updated":"20240613081753"},"Children":[{"Type":"NodeText","Data":"辛、苦、温。有毒。入手足厥阴经。其气升散，其性飞腾，能开阴伏之气，能劫蓄结之痰。"}]},{"ID":"20240613081753-frlwka5","Type":"NodeParagraph","Properties":{"id":"20240613081753-frlwka5","updated":"20240613081801"},"Children":[{"Type":"NodeText","Data":"破血行水，消痞截疟。得 云母、龙骨，治牝疟独寒不热。得牡蛎粉、麻黄、甘草，治牡疟独热不冷。配大黄、葶苈子，疗心下伏瘕。甘草拌蒸。生用性升，炒炭稍缓。胃虚，老幼虚弱..."}]},{"ID":"20240613081624-36xu1nr","Type":"NodeThematicBreak","Properties":{"id":"20240613081624-36xu1nr"}},{"ID":"20240613081626-wcalp4j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081626-wcalp4j","updated":"20240613081632"},"Children":[{"Type":"NodeText","Data":"蜀漆《冯氏锦囊秘录》"}]},{"ID":"20240613081626-s03aesv","Type":"NodeParagraph","Properties":{"id":"20240613081626-s03aesv","updated":"20240613081626"},"Children":[{"Type":"NodeText","Data":"其根名常山。禀天地阴寒之气，味苦、辛、寒、有毒。苦泄辛散，故善逐饮，阴寒祛热，故善破瘴 。入口即吐，其性暴悍可知。古方治疟多用，盖以岭南西粤鬼方山岚瘴气所感，充于营卫皮肤之间，欲去皮肤毛孔中瘴气根本，非常山不可以。性能祛逐祛痰积饮，善散山岚瘴 也。"}]},{"ID":"20240613081626-r660rzc","Type":"NodeParagraph","Properties":{"id":"20240613081626-r660rzc","updated":"20240613081626"},"Children":[{"Type":"NodeText","Data":"蜀漆，系常山苗，散火邪错逆，破痈瘕 坚痞结积凝，虫毒鬼疰久疟，兼治咳逆亦调，切勿服多。亦防恶吐。常山截温疟吐痰沫殊功，水胀堪逐，鬼虫能消，勿热下咽。"}]},{"ID":"20240613081626-semtj23","Type":"NodeParagraph","Properties":{"id":"20240613081626-semtj23","updated":"20240613081626"},"Children":[{"Type":"NodeText","Data":"露宿才投，故老人病久尤宜戒服，盖阴毒暴悍之草，虽能破瘴逐饮，善治久疟，须在发散表邪，提出阳分之后用之。但最损真气，倘疟非因瘴气，老痰积饮者，勿轻用之，功不掩过者也。"}]},{"ID":"20240613081626-x1upg7t","Type":"NodeParagraph","Properties":{"id":"20240613081626-x1upg7t","updated":"20240613081626"},"Children":[{"Type":"NodeText","Data":"按，常山截疟疾甚效者，盖疟疾必有黄涎聚于胸中，故曰∶“无痰不成疟”。且弦脉主痰饮，而疟脉必弦，常山善去老痰积饮，故为疟家要药。必须好酒炒透，否则令人吐也。若同参术，则既可去病，复可御其猛烈之性矣。"}]},{"ID":"20240613082000-btlka9i","Type":"NodeThematicBreak","Properties":{"id":"20240613082000-btlka9i"}},{"ID":"20240613082002-xwygwv0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613082002-xwygwv0","updated":"20240613082008"},"Children":[{"Type":"NodeText","Data":"蜀漆《证类本草》"}]},{"ID":"20240613082002-zuk0cko","Type":"NodeParagraph","Properties":{"id":"20240613082002-zuk0cko","updated":"20240613082002"},"Children":[{"Type":"NodeText","Data":"味辛，平、微温，有毒。主疟及咳逆寒热，腹中症坚，痞结，积聚，邪气，蛊毒，鬼疰，疗胸中邪结气，吐出之。生江林山川谷及蜀汉中。常山苗也。五月采叶，阴干。（栝蒌为之使，恶贯众。）"}]},{"ID":"20240613082002-4nm1es0","Type":"NodeParagraph","Properties":{"id":"20240613082002-4nm1es0","updated":"20240613082002"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶是常山苗，而所出又异者，江林山即益州江阳山名，故是同处尔。彼人采仍萦结作丸，得时燥者佳。唐本注云∶此草，日微萎则把束曝使燥，色青白，堪用。若阴干，便黑烂郁坏矣。陶云作丸。此乃 饼，非蜀漆也。臣禹锡等谨按蜀本图经云∶五月采，日干之。"}]},{"ID":"20240613082002-wb6ng9w","Type":"NodeParagraph","Properties":{"id":"20240613082002-wb6ng9w","updated":"20240613082002"},"Children":[{"Type":"NodeText","Data":"药性论云∶蜀漆，使，畏橐吾，味苦，有小毒。常山苗也。能主治瘴、鬼疟多时不瘥，去寒热疟，治温疟寒热。不可多进，令人吐逆。主坚症，下肥气，积聚。萧炳云∶桔梗为使。日华子云∶蜀漆治症瘕。又名鸡尿草、鸭尿草。李含光云∶常山茎也。八月、九月采。"}]},{"ID":"20240613082002-2mavmm7","Type":"NodeParagraph","Properties":{"id":"20240613082002-2mavmm7","updated":"20240613082002"},"Children":[{"Type":"NodeText","Data":"图经曰∶蜀漆，生江林山川谷及蜀汉。常山苗也。常山生益州山谷及汉中，蜀漆根也。"}]},{"ID":"20240613082002-cho2mvd","Type":"NodeParagraph","Properties":{"id":"20240613082002-cho2mvd","updated":"20240613082002"},"Children":[{"Type":"NodeText","Data":"江林山即益州江阳山名，是同处耳。今京西、淮、浙、湖南州郡亦有之。叶似茗而狭长，两两相当。茎圆有节。三月生红花，青萼。五月结实，青圆，三子为房。苗高者不过三、四尺，根似荆，黄色。而海州出者，叶似楸叶，八月，有花红白色，子碧色，似山楝子而小。五月采叶，八月采根，阴干。此二味为治疟之最要。张仲景蜀漆散∶用蜀漆、云母、龙骨等分，杵末，患者至发前，以浆水和半钱服之。温疟加蜀漆半分，临发时服一钱匕。今天台山出一种草，名土常山，苗叶极甘，人用为饮香，其味如蜜，又名蜜香草，性亦凉，饮之益人，非此常山也。"}]},{"ID":"20240613082002-8fuoqly","Type":"NodeParagraph","Properties":{"id":"20240613082002-8fuoqly","updated":"20240613082002"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡采得后，和根、苗。临用时即去根，取茎并叶，同拌，甘草四两，细锉用，拌水令湿同蒸。临时去甘草，取蜀漆五两，细锉，又拌甘草水匀，又蒸了任用，勿食木笋。"}]},{"ID":"20240613082002-53v7nfi","Type":"NodeParagraph","Properties":{"id":"20240613082002-53v7nfi","updated":"20240613082024"},"Children":[{"Type":"NodeText","Data":"衍义曰∶蜀漆，常山苗也。治疟，多吐人。其他亦未见所长。此草也，虑岁久，人或别有异论，故预云。余如经。"}]},{"ID":"20240613081612-yr95r9u","Type":"NodeThematicBreak","Properties":{"id":"20240613081612-yr95r9u"}},{"ID":"20240613081613-6ekrhmz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081613-6ekrhmz","updated":"20240613081618"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草乘雅半偈》"}]},{"ID":"20240613081613-hzft9s3","Type":"NodeParagraph","Properties":{"id":"20240613081613-hzft9s3","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613081613-zbf8wk7","Type":"NodeParagraph","Properties":{"id":"20240613081613-zbf8wk7","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"【气味】辛平，有毒。"}]},{"ID":"20240613081613-pdu4vpi","Type":"NodeParagraph","Properties":{"id":"20240613081613-pdu4vpi","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"【主治】主疟，及咳逆寒热，腹中症坚，积聚邪气，蛊毒，鬼疰。"}]},{"ID":"20240613081613-zdleqbf","Type":"NodeParagraph","Properties":{"id":"20240613081613-zdleqbf","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出益州川谷，及汉中，今宜都、建平、海州、汴西、淮、浙、湖南并有之。"}]},{"ID":"20240613081613-47kqm7v","Type":"NodeParagraph","Properties":{"id":"20240613081613-47kqm7v","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"生山谷间，茎圆有节，高三四尺。叶似茗，两两相当二月作白花，青萼。五月结实青圆，三子为房。根似荆根，色黄而皱，苗即蜀漆也，采时须连根苗收用，气力始备，性颇恶湿，采即暴燥，青白堪用，否则黑烂郁坏矣。宜都、建平者，根形细实，宛如鸡骨，取用最胜。海州者，叶似楸叶，八月开花红白，似山楝而小。又天台一种土尝山，苗叶并甘而凉，颇适口，非同类也。修事，如用蜀漆，临时去根，同甘草相拌，水润蒸之。去甘草，细锉，再以甘草汁拌蒸，晒干取用。如用尝山，临时去苗，用酒浸一宿，取出，晒干熬捣用。尝山，畏玉札。"}]},{"ID":"20240613081613-dijqk16","Type":"NodeParagraph","Properties":{"id":"20240613081613-dijqk16","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"蜀漆"}]},{"ID":"20240613081613-bbzxn2a","Type":"NodeParagraph","Properties":{"id":"20240613081613-bbzxn2a","updated":"20240613081613"},"Children":[{"Type":"NodeText","Data":"【 】曰∶经久不迁之谓尝，宣气散生之谓山。盖以止行行止为体用，故一名互草。从治伤寒、温疟之体似止，显寒热往来之用似行，及鬼毒与胸中结痰吐逆之似止而行，似行而止者。苗曰蜀漆，山独之谓蜀，水泻欲留之谓漆，故功用相同，略分内外上下之异耳。"}]},{"ID":"20240613081155-belx0o6","Type":"NodeThematicBreak","Properties":{"id":"20240613081155-belx0o6"}},{"ID":"20240613081316-uwj8bki","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081316-uwj8bki","updated":"20240613081322"},"Children":[{"Type":"NodeText","Data":"蜀漆《长沙药解》"}]},{"ID":"20240613081316-2dtu5cz","Type":"NodeParagraph","Properties":{"id":"20240613081316-2dtu5cz","updated":"20240613081316"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛平。主疟及咳逆，寒热，腹中癥坚，痞结，积聚邪气，蛊毒，鬼注。生川谷。"}]},{"ID":"20240613081316-0r0sfbw","Type":"NodeParagraph","Properties":{"id":"20240613081316-0r0sfbw","updated":"20240613081316"},"Children":[{"Type":"NodeText","Data":"味苦、辛，性寒，入足阳明胃、足太阴脾、足少阳胆经。荡浊瘀而治痎疟，扫腐败而疗惊狂。"}]},{"ID":"20240613081316-ivj2ifw","Type":"NodeParagraph","Properties":{"id":"20240613081316-ivj2ifw","updated":"20240613081316"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜀漆散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蜀漆、云母、龙骨等分。为散、未发前浆水服半钱匕。温疟加蜀漆半分，临发时服一钱匕。"},{"Type":"NodeText","Data":"治牝疟多寒者。寒湿之邪，客于少阳之部，郁遏阳气，不得外达。阳气发于阴邪之内，重阴闭束，莫能透越，鼓搏振摇，则生寒战。阳郁热盛，透围而出，是以发热。阳气蓄积，盛而后发，故至期病作，应如潮信。阳旺则蓄而即盛，故日与邪争，阳衰则久而方振，故间日而作。阳进则一郁即发，锐气倍常，故其作日早，阳退则闭极方通，渐至困乏，故其作日晏。作之日早，则邪退日速，作之日晏，则邪退日迟。作晏而退迟者，阳衰不能遽发，是以寒多。阳败而终不能发，则绝寒而无热矣。云母泻其湿寒，龙骨收其腐败，蜀漆排决陈宿，以达阳气也。"}]},{"ID":"20240613081316-2xj2i72","Type":"NodeParagraph","Properties":{"id":"20240613081316-2xj2i72","updated":"20240613081316"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"救逆汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在龙骨。"},{"Type":"NodeText","Data":"用之治伤寒火劫，亡阳惊狂，起卧不安者。以阳亡湿动，君相离根，浊阴上填，心宫胶塞，蜀漆除道而清君侧也。"}]},{"ID":"20240613081316-4xhds7q","Type":"NodeParagraph","Properties":{"id":"20240613081316-4xhds7q","updated":"20240613081316"},"Children":[{"Type":"NodeText","Data":"蜀漆苦寒疏利，扫秽行瘀，破坚化积，清涤痰涎，涌吐垢浊，是以善医痎疟惊狂之病。"}]},{"ID":"20240613081316-k9jdss4","Type":"NodeParagraph","Properties":{"id":"20240613081316-k9jdss4","updated":"20240613081316"},"Children":[{"Type":"NodeText","Data":"洗去腥用。"}]},{"ID":"20240613081412-ybv5e4m","Type":"NodeThematicBreak","Properties":{"id":"20240613081412-ybv5e4m"}},{"ID":"20240613081413-iqx6670","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081413-iqx6670","updated":"20240613081420"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草图经》"}]},{"ID":"20240613081413-4z7639j","Type":"NodeParagraph","Properties":{"id":"20240613081413-4z7639j","updated":"20240628162639"},"Children":[{"Type":"NodeText","Data":"蜀漆，生江林山川谷及蜀汉。常山苗也。常山生益州山谷及汉中，蜀漆根也。江林山即益州江阳山名，是同处耳。今京西、淮、浙、湖南州郡亦有之。叶似茗而狭长，两两相当；茎圆有节；三月生红花，青萼；五月结实，青；三子为房；苗高者不过三、四尺；根似荆，黄色。而海州出者，叶似楸叶，八尺，有花红白色，子碧色，似山楝子而小。五月采叶，八月采根，阴干。此二味为治疟之最要。张仲景蜀漆散∶用蜀漆、云母、龙骨等分，杵末，患者至发前，以浆水和半钱服之。温疟加蜀漆半分，临发时服一钱匕。今天台山出一种草，名土常山，苗、叶极甘，人用为饮香，其味如蜜，又名蜜香草，性亦凉，饮之益人，非此常山也。"}]},{"ID":"20240613081345-86n3w7w","Type":"NodeThematicBreak","Properties":{"id":"20240613081345-86n3w7w"}},{"ID":"20240613081346-bkopf8m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081346-bkopf8m","updated":"20240613081352"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草新编》"}]},{"ID":"20240613081346-ndcntna","Type":"NodeParagraph","Properties":{"id":"20240613081346-ndcntna","updated":"20240613081346"},"Children":[{"Type":"NodeText","Data":"蜀漆，常山之苗也。常山不可用，而苗则可取。味苦，纯阴。散火邪错逆，破痈瘕症坚，除痞结积凝，辟蛊毒鬼疰，久疟兼治，咳逆且调。"}]},{"ID":"20240613081346-3idybk4","Type":"NodeParagraph","Properties":{"id":"20240613081346-3idybk4","updated":"20240613081346"},"Children":[{"Type":"NodeText","Data":"或问蜀漆，即常山之苗，子删常山而取其苗，何谓也？盖常山性烈而功峻，虽取效甚速，而败坏元气亦最深。世人往往用常山治疟，一剂即愈，而身体野狼狈，将息半载，尚未还元。设再不慎，疾一朝重犯，得免于死亡幸也。其不可轻用，亦明矣。蜀漆虽是常山之苗，不比根之猛烈。盖苗发于春，其性轻扬，且得春气之发生，散邪既速，而破气亦轻，可借之以攻坚，不必虑其损内。此所以舍常山而登蜀漆也。"}]},{"ID":"20240613081329-17e0aat","Type":"NodeThematicBreak","Properties":{"id":"20240613081329-17e0aat"}},{"ID":"20240613081331-izxgfam","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081331-izxgfam","updated":"20240613081336"},"Children":[{"Type":"NodeText","Data":"蜀漆《名医别录》"}]},{"ID":"20240613081331-kt62s7l","Type":"NodeParagraph","Properties":{"id":"20240613081331-kt62s7l","updated":"20240613081331"},"Children":[{"Type":"NodeText","Data":"微温，有毒．主治胸中邪结气吐出之．生江林山及蜀汉中，恒山苗也．五月采叶，阴（栝蒌为之使，恶贯众．）"}]},{"ID":"20240613081331-4j3oem1","Type":"NodeParagraph","Properties":{"id":"20240613081331-4j3oem1","updated":"20240613081331"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶蜀漆，味辛，平．主疟及咳逆寒热，腹中症坚痞结，积聚邪气，蛊毒鬼注．生川谷．"}]},{"ID":"20240613081155-cm1lj00","Type":"NodeThematicBreak","Properties":{"id":"20240613081155-cm1lj00"}},{"ID":"20240613081211-di2wp8x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081211-di2wp8x","updated":"20240613081219"},"Children":[{"Type":"NodeText","Data":"蜀漆《新修本草》"}]},{"ID":"20240613081211-k401rku","Type":"NodeParagraph","Properties":{"id":"20240613081211-k401rku","updated":"20240613081211"},"Children":[{"Type":"NodeText","Data":"味辛，平、微温，有毒。主疟及咳逆寒热，腹中症坚，痞结，积聚，邪气，蛊毒，鬼疰。"}]},{"ID":"20240613081211-ope5268","Type":"NodeParagraph","Properties":{"id":"20240613081211-ope5268","updated":"20240613081211"},"Children":[{"Type":"NodeText","Data":"疗江林山川谷，生蜀汉中，恒山苗也。五月采叶，阴干。"}]},{"ID":"20240613081211-vuzzt5t","Type":"NodeParagraph","Properties":{"id":"20240613081211-vuzzt5t","updated":"20240613081211"},"Children":[{"Type":"NodeText","Data":"栝蒌为之使，恶贯众。犹是恒山苗，而所出又异者，江林山即益州江阳山名，故是同处尔。彼人采，仍萦结作丸，得时燥者，佳矣。"}]},{"ID":"20240613081211-k2b3373","Type":"NodeParagraph","Properties":{"id":"20240613081211-k2b3373","updated":"20240613081211"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草晒干，微萎则把束曝使燥，色青白堪用，若阴干便黑烂郁坏矣。陶云作丸，此乃 饼，非蜀漆也。"}]},{"ID":"20240613081135-rjgy717","Type":"NodeThematicBreak","Properties":{"id":"20240613081135-rjgy717"}},{"ID":"20240613081148-9u8y58o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081148-9u8y58o","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蜀漆"}]},{"ID":"20240613081148-9xn917w","Type":"NodeParagraph","Properties":{"id":"20240613081148-9xn917w","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613081148-f65ah4o","Type":"NodeParagraph","Properties":{"id":"20240613081148-f65ah4o","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" Shǔ Qī"}]},{"ID":"20240613081148-b4kl43g","Type":"NodeParagraph","Properties":{"id":"20240613081148-b4kl43g","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613081148-8g7j7rt","Type":"NodeParagraph","Properties":{"id":"20240613081148-8g7j7rt","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 鸡屎草、鸭屎草（《日华子本草》）。"}]},{"ID":"20240613081148-at8w9f5","Type":"NodeParagraph","Properties":{"id":"20240613081148-at8w9f5","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613081148-d7weky2","Type":"NodeParagraph","Properties":{"id":"20240613081148-d7weky2","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613081148-85s9zf7","Type":"NodeParagraph","Properties":{"id":"20240613081148-85s9zf7","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613081148-juoxmfe","Type":"NodeParagraph","Properties":{"id":"20240613081148-juoxmfe","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 为虎耳草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄常山"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"嫩枝叶"},{"Type":"NodeText","Data":"。夏季采收，晒干。"}]},{"ID":"20240613081148-ekeibck","Type":"NodeParagraph","Properties":{"id":"20240613081148-ekeibck","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613081148-kod2oxr","Type":"NodeParagraph","Properties":{"id":"20240613081148-kod2oxr","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 主产于四川、贵州、湖南。此外，湖北、广西亦产。"}]},{"ID":"20240613081148-xx2nktv","Type":"NodeParagraph","Properties":{"id":"20240613081148-xx2nktv","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613081148-8y2by6g","Type":"NodeParagraph","Properties":{"id":"20240613081148-8y2by6g","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 植物形态详\"常山\"条。"}]},{"ID":"20240613081148-ivsvmfc","Type":"NodeParagraph","Properties":{"id":"20240613081148-ivsvmfc","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613081148-zwmph6z","Type":"NodeParagraph","Properties":{"id":"20240613081148-zwmph6z","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 干燥嫩枝，圆柱形，细弱，叶多皱缩，枯褐色或棕绿色，完整的叶椭圆形、广披针形或长方状倒卵形，先端尖，边缘有锯齿，基部楔形，光滑无毛。体轻而薄，质脆易碎。嗅之有特殊的闷气，味微苦。以无者梗、叶大不破碎，味浓者为佳。"}]},{"ID":"20240613081148-lydvjdm","Type":"NodeParagraph","Properties":{"id":"20240613081148-lydvjdm","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613081148-arrikv2","Type":"NodeParagraph","Properties":{"id":"20240613081148-arrikv2","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 参见\"常山\"条。"}]},{"ID":"20240613081148-tfmn846","Type":"NodeParagraph","Properties":{"id":"20240613081148-tfmn846","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613081148-r17jtnd","Type":"NodeParagraph","Properties":{"id":"20240613081148-r17jtnd","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 《得配本草》：\"入手、足厥阴经。\""}]},{"ID":"20240613081148-9i0e1lv","Type":"NodeParagraph","Properties":{"id":"20240613081148-9i0e1lv","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613081148-pn2w4ed","Type":"NodeParagraph","Properties":{"id":"20240613081148-pn2w4ed","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 苦辛，温，有毒。"}]},{"ID":"20240613081148-8pb82b6","Type":"NodeParagraph","Properties":{"id":"20240613081148-8pb82b6","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240613081148-tt2pmni","Type":"NodeParagraph","Properties":{"id":"20240613081148-tt2pmni","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"微温，有毒。\""}]},{"ID":"20240613081148-9rjcncj","Type":"NodeParagraph","Properties":{"id":"20240613081148-9rjcncj","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦，有小毒。\""}]},{"ID":"20240613081148-f1cvts7","Type":"NodeParagraph","Properties":{"id":"20240613081148-f1cvts7","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613081148-ntblmm3","Type":"NodeParagraph","Properties":{"id":"20240613081148-ntblmm3","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 凡正气虚弱，久病体弱者慎服。"}]},{"ID":"20240613081148-gew30vd","Type":"NodeParagraph","Properties":{"id":"20240613081148-gew30vd","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"栝楼为之使。恶贯众。\""}]},{"ID":"20240613081148-uw5mhy6","Type":"NodeParagraph","Properties":{"id":"20240613081148-uw5mhy6","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"不可多进，令人吐逆。畏橐吾。\""}]},{"ID":"20240613081148-yeui1ev","Type":"NodeParagraph","Properties":{"id":"20240613081148-yeui1ev","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"③《四声本草》：\"桔梗为之使。\""}]},{"ID":"20240613081148-2d3j7w4","Type":"NodeParagraph","Properties":{"id":"20240613081148-2d3j7w4","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"④《得配本草》：\"胃虚，老幼虚弱，二者忌用。\"\"忌葱茗。\""}]},{"ID":"20240613081148-fw1rdte","Type":"NodeParagraph","Properties":{"id":"20240613081148-fw1rdte","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613081148-q5n1lmw","Type":"NodeParagraph","Properties":{"id":"20240613081148-q5n1lmw","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 除痰，截疟，消癥瘕积聚。"}]},{"ID":"20240613081148-va8pljv","Type":"NodeParagraph","Properties":{"id":"20240613081148-va8pljv","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主疟及咳逆寒热，腹中症坚痞结，积聚邪气蛊毒。\""}]},{"ID":"20240613081148-ju2el5q","Type":"NodeParagraph","Properties":{"id":"20240613081148-ju2el5q","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗胸中邪结气，吐出之。\""}]},{"ID":"20240613081148-n3ghxth","Type":"NodeParagraph","Properties":{"id":"20240613081148-n3ghxth","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主治瘴疟多时不瘥，去寒热疟。治温疟寒热。\""}]},{"ID":"20240613081148-o13ajfs","Type":"NodeParagraph","Properties":{"id":"20240613081148-o13ajfs","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"④张元素：\"破血，导胆邪。\""}]},{"ID":"20240613081148-7iytzec","Type":"NodeParagraph","Properties":{"id":"20240613081148-7iytzec","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613081148-txvxfur","Type":"NodeParagraph","Properties":{"id":"20240613081148-txvxfur","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱；或研末。"}]},{"ID":"20240613081148-zv5vsom","Type":"NodeParagraph","Properties":{"id":"20240613081148-zv5vsom","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613081148-apqdwwt","Type":"NodeParagraph","Properties":{"id":"20240613081148-apqdwwt","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" ①治疟多寒者，名曰牝疟：蜀漆（洗去腥）、云母（烧二日夜）、龙骨等分。杵为散，未发前，以浆水服半钱匕。温疟加蜀漆半分，临发时服一钱匕。（《金匮要略》蜀漆散）"}]},{"ID":"20240613081148-cwvs5wp","Type":"NodeParagraph","Properties":{"id":"20240613081148-cwvs5wp","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"②治小儿暴惊，卒死中恶：蜀漆（炒）二钱，左顾牡蛎一钱二分。浆水煎服，当吐痰而愈。（《纲目》千金汤）"}]},{"ID":"20240613081148-j52wzwu","Type":"NodeParagraph","Properties":{"id":"20240613081148-j52wzwu","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613081148-35i5w81","Type":"NodeParagraph","Properties":{"id":"20240613081148-35i5w81","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" ①《本经逢原》：\"蜀漆，即常山之苗，故《本经》治疟，及咳逆寒热，积聚蛊毒，功效与之相类。"}]},{"ID":"20240613081148-s4h1say","Type":"NodeParagraph","Properties":{"id":"20240613081148-s4h1say","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"蜀漆，其气升散，其性飞腾，能开阴伏之气，能劫蓄结之痰，破血行水，消痞截疟。甘草拌蒸。生用性升，炒炭稍缓。\""}]},{"ID":"20240613081148-je8edjd","Type":"NodeParagraph","Properties":{"id":"20240613081148-je8edjd","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"③《药征续编》：\"凡仲景之治动也，共活法有三：有胸腹之动，则以牡蛎治之；有脐下之动，则以龙骨治之；有胸腹脐下之动剧，则以蜀漆治之。此为仲景治动之三活法矣。故仲景之方，有以蜀漆配之牡蛎者，或有配之龙骨者，或有配之龙骨、牡蛎者，是又仲景用蜀漆之法也。本论不载此法者，盖属脱误，故晋、唐以来，无有知蜀漆之功者。\""}]},{"ID":"20240613081148-kz7ujqm","Type":"NodeParagraph","Properties":{"id":"20240613081148-kz7ujqm","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"④《本经疏证》：\"凡药非鳞介飞走，未有云气腥者，惟仲景用蜀漆，必注曰洗去腥，则可见其气之恶劣异于他草木矣。\""}]},{"ID":"20240613081148-c92zsj2","Type":"NodeParagraph","Properties":{"id":"20240613081148-c92zsj2","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613081148-t9s203a","Type":"NodeParagraph","Properties":{"id":"20240613081148-t9s203a","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613081148-vphudtm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613081148-vphudtm","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蜀漆"}]},{"ID":"20240613081148-wq167ob","Type":"NodeParagraph","Properties":{"id":"20240613081148-wq167ob","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613081148-jndbhql","Type":"NodeParagraph","Properties":{"id":"20240613081148-jndbhql","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" Shǔ Qī"}]},{"ID":"20240613081148-r3zb649","Type":"NodeParagraph","Properties":{"id":"20240613081148-r3zb649","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613081148-q65locv","Type":"NodeParagraph","Properties":{"id":"20240613081148-q65locv","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 鸡尿草、鸭尿草、七叶"}]},{"ID":"20240613081148-sdl97yc","Type":"NodeParagraph","Properties":{"id":"20240613081148-sdl97yc","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613081148-c0cgd53","Type":"NodeParagraph","Properties":{"id":"20240613081148-c0cgd53","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" twig and leaf of Antifebrile Dichroa"}]},{"ID":"20240613081148-3gff75w","Type":"NodeParagraph","Properties":{"id":"20240613081148-3gff75w","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613081148-1a6v5ca","Type":"NodeParagraph","Properties":{"id":"20240613081148-1a6v5ca","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 出自1.《吴普本草》：蜀漆如漆叶，蓝青相似，五月采。"}]},{"ID":"20240613081148-0ycvx5f","Type":"NodeParagraph","Properties":{"id":"20240613081148-0ycvx5f","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"2.《别录》：蜀漆，生江林山川谷及蜀汉中，常山苗也。五月采叶，阴干。"}]},{"ID":"20240613081148-zcx9ivz","Type":"NodeParagraph","Properties":{"id":"20240613081148-zcx9ivz","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：蜀漆，日微萎，则把束暴使燥，色青白湛用，若阴干，便黑烂郁坏矣。"}]},{"ID":"20240613081148-182kxud","Type":"NodeParagraph","Properties":{"id":"20240613081148-182kxud","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"4.《本草衍义》：蜀漆，常山苗也，治疟多吐人，其他亦未见所长。"}]},{"ID":"20240613081148-sfz2kae","Type":"NodeParagraph","Properties":{"id":"20240613081148-sfz2kae","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613081148-0aq1ugb","Type":"NodeParagraph","Properties":{"id":"20240613081148-0aq1ugb","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 药材基源：为双子叶植物药虎耳草科植物常山的嫩枝叶。"}]},{"ID":"20240613081148-zesgqpi","Type":"NodeParagraph","Properties":{"id":"20240613081148-zesgqpi","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dichroa febrifuga Lour"}]},{"ID":"20240613081148-54cfgig","Type":"NodeParagraph","Properties":{"id":"20240613081148-54cfgig","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季采收，晒干。"}]},{"ID":"20240613081148-e9u9qrk","Type":"NodeParagraph","Properties":{"id":"20240613081148-e9u9qrk","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613081148-f26jfff","Type":"NodeParagraph","Properties":{"id":"20240613081148-f26jfff","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔500-1200m的林缘、沟边、湿润的山地。"}]},{"ID":"20240613081148-jzq04rb","Type":"NodeParagraph","Properties":{"id":"20240613081148-jzq04rb","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"资源分布：主产于四川、贵州、湖南、湖北、广西等地。"}]},{"ID":"20240613081148-zf82njb","Type":"NodeParagraph","Properties":{"id":"20240613081148-zf82njb","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613081148-sm3o8hd","Type":"NodeParagraph","Properties":{"id":"20240613081148-sm3o8hd","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 常山 灌木，高1-2m。小枝绿色，常带紫色，无毛，或稀被微柔毛。叶对生；叶柄长1.5-2cm；叶形变化大，通常椭圆形、长圆形、倒卵状椭圆形，稀为披针形，长5-10cm，宽3-6cm，先端渐尖，基部楔形，边缘有密的锯齿或细锯齿；中脉上面凹陷，侧脉弯拱向上。伞房花序圆锥形；顶生，有梗；花蓝色或青紫色；花萼倒圆锥状，萼齿4-7；花瓣4-7，近肉质，花时反卷；雄蕊10-20，半数与花瓣对生，花丝扁平；子房下位，花柱5（4-6），初时基部合生。浆果蓝色，有多数种子。花期6-7月，果期8-10月。"}]},{"ID":"20240613081148-m5h69tv","Type":"NodeParagraph","Properties":{"id":"20240613081148-m5h69tv","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613081148-6htq7uo","Type":"NodeParagraph","Properties":{"id":"20240613081148-6htq7uo","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：喜阴凉湿润的气候，忌高温。以肥沃疏松、排水良好、腐殖质多的砂质壤土为宜。"}]},{"ID":"20240613081148-1er0h4q","Type":"NodeParagraph","Properties":{"id":"20240613081148-1er0h4q","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"2.整地：深耕30cm左右，作成高10-14cm、宽1-1.4m的高畦，如用种子繁殖，每亩可施以饼肥150-250斤及等量草木灰作基肥。"}]},{"ID":"20240613081148-kbuwomc","Type":"NodeParagraph","Properties":{"id":"20240613081148-kbuwomc","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"3.种植：可用扦插、种子、压条、分株等方法繁殖，主要是用扦插繁殖，其次是种子繁殖。"}]},{"ID":"20240613081148-vj368n1","Type":"NodeParagraph","Properties":{"id":"20240613081148-vj368n1","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"3.1.扦插繁殖法：扦插时期在每年 11月至次年3月间，剪取15cm长带有三介健全芽的插条。按行距30cm开沟，深15cm，沟的一面稍倾斜平整，将插条以3-5cm的距离排好，覆士压紧。如开穴扦插，则每穴插入3根插条，行、株距30cm见方，插后覆土压紧。"}]},{"ID":"20240613081148-epu0yyu","Type":"NodeParagraph","Properties":{"id":"20240613081148-epu0yyu","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"3.2.种子繁殖法： 3月中、下旬播种。播前将种子拌和细土或细沙，均匀地撤播于苗床，稍加镇压后覆盖稻草一薄层，以保持土壤温度和湿度。幼苗生长培育至第二年秋季，按行株距30×30cm移栽。"}]},{"ID":"20240613081148-0lcil2e","Type":"NodeParagraph","Properties":{"id":"20240613081148-0lcil2e","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"4.田间管理：育苗期经常浇水，保持土壤湿润。清除杂草，搭棚遮荫。苗高3-4cm时，追施稀薄粪水肥1次。过密时要间苗。定植后每年须中耕除草4次，并结合培土和追肥。追肥每亩用硫酸按15斤，饼肥60斤，混合施用，或施人粪尿、过磷酸钙。在冬季则施厩肥或饼肥。"}]},{"ID":"20240613081148-e2myrqf","Type":"NodeParagraph","Properties":{"id":"20240613081148-e2myrqf","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"5.病虫害防治：病害主要为叶斑病，在发病前喷射波尔多液预防。虫害有象鼻虫、花面天蛾幼虫、金花虫、猿叶虫，发现后进行人工捕杀；并可喷射六六六粉或砒剂毒杀。"}]},{"ID":"20240613081148-wqet05f","Type":"NodeParagraph","Properties":{"id":"20240613081148-wqet05f","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613081148-kxg2nw9","Type":"NodeParagraph","Properties":{"id":"20240613081148-kxg2nw9","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 嫩枝圆柱，细弱，有纵皱纹。叶皱缩破碎，褐绿色或黄褐色，完整者展平后，叶片呈椭圆形、广披针形或长方状倒卵形，长5-17cm，宽1-6cm，先端尖，边缘有锯齿，基部楔形，两面疏被短或光滑无毛，叶柄长1-2cm。多嗅有特殊闷气，味微苦。"}]},{"ID":"20240613081148-dbl92sd","Type":"NodeParagraph","Properties":{"id":"20240613081148-dbl92sd","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 叶表面观 上表皮细胞表面观多边形，垂周壁波状，下表皮细胞表面观不规则形，垂周壁波浪形，有气孔。气孔不定式。非腺毛单细胞。"}]},{"ID":"20240613081148-v023rdc","Type":"NodeParagraph","Properties":{"id":"20240613081148-v023rdc","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613081148-afdvm1f","Type":"NodeParagraph","Properties":{"id":"20240613081148-afdvm1f","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 阴经"}]},{"ID":"20240613081148-smhcywk","Type":"NodeParagraph","Properties":{"id":"20240613081148-smhcywk","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613081148-jclpe1e","Type":"NodeParagraph","Properties":{"id":"20240613081148-jclpe1e","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性温；有毒"}]},{"ID":"20240613081148-ooez9ig","Type":"NodeParagraph","Properties":{"id":"20240613081148-ooez9ig","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613081148-c73y642","Type":"NodeParagraph","Properties":{"id":"20240613081148-c73y642","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 1.凡正气虚弱，久病体弱者慎服。"}]},{"ID":"20240613081148-clkcj2u","Type":"NodeParagraph","Properties":{"id":"20240613081148-clkcj2u","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：括楼为之使。恶贯众。"}]},{"ID":"20240613081148-aus8rta","Type":"NodeParagraph","Properties":{"id":"20240613081148-aus8rta","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：不可多进，令人吐逆。畏豪吾。"}]},{"ID":"20240613081148-959kt97","Type":"NodeParagraph","Properties":{"id":"20240613081148-959kt97","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"4.《四声本草》：桔梗为之使。"}]},{"ID":"20240613081148-f3llcsg","Type":"NodeParagraph","Properties":{"id":"20240613081148-f3llcsg","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"5.《得配本草》：胃虚，老幼虚弱，二者忌用。忌葱者。"}]},{"ID":"20240613081148-2e95d2w","Type":"NodeParagraph","Properties":{"id":"20240613081148-2e95d2w","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613081148-4w238tv","Type":"NodeParagraph","Properties":{"id":"20240613081148-4w238tv","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 除痰；截疟。主癥瘕积聚，疟疾"}]},{"ID":"20240613081148-7f0fjiq","Type":"NodeParagraph","Properties":{"id":"20240613081148-7f0fjiq","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613081148-y43km4z","Type":"NodeParagraph","Properties":{"id":"20240613081148-y43km4z","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g；或研未。"}]},{"ID":"20240613081148-2wkklvw","Type":"NodeParagraph","Properties":{"id":"20240613081148-2wkklvw","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613081148-gxzh9x0","Type":"NodeParagraph","Properties":{"id":"20240613081148-gxzh9x0","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" ①治疟多寒者，名曰牝疟： 蜀漆(洗去腥)、云母(烧二日夜)、龙骨等分。杆为散，未发前，以浆水服半钱巴。温疟加蜀漆半分，临发时服一钱巴。(《金医要略》蜀漆散)②治小儿暴惊，卒死中恶： 蜀漆(炒)二钱，左顾牡蛎一钱二分。浆水煎服，当吐痰而愈。 (《纲目》千金汤)"}]},{"ID":"20240613081148-l6ednw9","Type":"NodeParagraph","Properties":{"id":"20240613081148-l6ednw9","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613081148-i4bczi2","Type":"NodeParagraph","Properties":{"id":"20240613081148-i4bczi2","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主疟及咳逆寒热，腹中涵坚痞结，积聚邪气 。"}]},{"ID":"20240613081148-u2s3i82","Type":"NodeParagraph","Properties":{"id":"20240613081148-u2s3i82","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗胸中邪结气，吐出之。"}]},{"ID":"20240613081148-khoz6j0","Type":"NodeParagraph","Properties":{"id":"20240613081148-khoz6j0","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：主治瘴疟多时不痊，去寒热疟。治温疟寒热。"}]},{"ID":"20240613081148-ycjmclx","Type":"NodeParagraph","Properties":{"id":"20240613081148-ycjmclx","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"4.张元素：破血，导胆邪。"}]},{"ID":"20240613081148-bazcv07","Type":"NodeParagraph","Properties":{"id":"20240613081148-bazcv07","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613081148-8p2jtzx","Type":"NodeParagraph","Properties":{"id":"20240613081148-8p2jtzx","updated":"20240613081148"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613081149-z0imf8l","Type":"NodeThematicBreak","Properties":{"id":"20240613081149-z0imf8l"}},{"ID":"20240613081150-t4dbgnn","Type":"NodeParagraph","Properties":{"id":"20240613081150-t4dbgnn"}}]}