{"ID":"20240205170444-6bye2l1","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240205170444-6bye2l1","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240205170444-6bye2l1\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506103039-qd98sjr\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240205170643-uhtgnu2\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240506103050-1m8szfe\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"281蜀漆（常山苗）","type":"doc","updated":"20240823101452"},"Children":[{"ID":"20240628160751-2vx7k2y","Type":"NodeParagraph","Properties":{"id":"20240628160751-2vx7k2y","updated":"20240628160751"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 457px;","style":"width: 447px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628160751-6uqge1s.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 447px;\" parent-style=\"width: 457px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823101452-fermlnq","Type":"NodeParagraph","Properties":{"id":"20240823101452-fermlnq","updated":"20240823101452"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 458px;","style":"width: 448px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 25-20240823101452-vr45g99.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 448px;\" parent-style=\"width: 458px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823101240-dl5fg67","Type":"NodeParagraph","Properties":{"id":"20240823101240-dl5fg67","updated":"20240823101240"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 346px;","style":"width: 336px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山2-20240628151218-hs91qnt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 336px;\" parent-style=\"width: 346px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 356px;","style":"width: 346px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628150818-jn2p971.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 346px;\" parent-style=\"width: 356px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823101240-ms06ywj","Type":"NodeParagraph","Properties":{"id":"20240823101240-ms06ywj","updated":"20240823101240"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (23)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 23-20240823100233-dsc0c3j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeO