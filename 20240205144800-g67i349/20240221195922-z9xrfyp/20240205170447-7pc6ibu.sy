pe":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇床子4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇床子4-20240619163600-vuk8yuv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 573px;\" parent-style=\"width: 583px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 656px;","style":"width: 646px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇床子6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇床子6-20240619164820-e6b7mdm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 646px;\" parent-style=\"width: 656px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710161432-njstojo","Type":"NodeParagraph","Properties":{"id":"20240710161432-njstojo","updated":"20240710161501"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 728px;","style":"width: 718px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇床子 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇床子 3-20240710161456-9lp1drz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 718px;\" parent-style=\"width: 728px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 413px;","style":"width: 403px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇床子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇床子 2-20240710161432-njhdvun.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 403px;\" parent-style=\"width: 413px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710160314-fjcfvb6","Type":"NodeParagraph","Properties":{"id":"20240710160314-fjcfvb6","updated":"20240710160432"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 416px;","style":"width: 406px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710160314-fptcgks.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 406px;\" parent-style=\"width: 416px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 677px;","style":"width: 667px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇床子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇床子-20240710160432-dbs6qgn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 667px;\" parent-style=\"width: 677px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807170709-62q7lyv","Type":"NodeParagraph","Properties":{"id":"20240807170709-62q7lyv","updated":"20240807170709"}},{"ID":"20240710155657-xiqf27q","Type":"NodeParagraph","Properties":{"id":"20240710155657-xiqf27q","updated":"20240710155657"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野胡萝卜与蛇床对比"}]},{"ID":"20240710155657-igw7wn1","Type":"NodeParagraph","Properties":{"id":"20240710155657-igw7wn1","updated":"20240710155657"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710155558-9zp0bt3.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240710155619-6oahd52.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240710155649-6qiwz57","Type":"NodeParagraph","Properties":{"id":"20240710155649-6qiwz57","updated":"20240807170832"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：蛇床子与野胡萝卜也就是南鹤虱较为相似，两者区别在于——南鹤虱茎上有粗硬毛，蛇床茎上没有毛；南鹤虱结果以后边缘花序轴向内卷曲，而蛇床没有卷曲；野胡萝卜有刺没有棱，蛇床果实有棱没有刺；蛇床植株高度一般不超过一米，而野胡萝卜一两米很正常；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240206101701-cb8xcsi","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"南鹤虱（野胡萝卜）"}]},{"ID":"20240616164539-9s6e5g0","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-9s6e5g0"}},{"ID":"20240616165234-16w8hm8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616165234-16w8hm8","updated":"20240616165238"},"Children":[{"Type":"NodeText","Data":"蛇床子《神农本草经》"}]},{"ID":"20240616165234-aom530m","Type":"NodeParagraph","Properties":{"id":"20240616165234-aom530m","updated":"20240616165234"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240616165234-ewors5d","Type":"NodeParagraph","Properties":{"id":"20240616165234-ewors5d","updated":"20240616165234"},"Children":[{"Type":"NodeText","Data":"主妇人阴中肿痛，男子阴痿，湿痒，除痹气，利关节，癫痫恶创。久服轻身。一名蛇米。生川谷及田野。"}]},{"ID":"20240616165234-4ffm4na","Type":"NodeParagraph","Properties":{"id":"20240616165234-4ffm4na","updated":"20240616165234"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：蛇床一名蛇珠（《御览》）。"}]},{"ID":"20240616165234-93u4vb4","Type":"NodeParagraph","Properties":{"id":"20240616165234-93u4vb4","updated":"20240616165234"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名蛇粟，一名虺床，一名思盐，一名绳毒，一名枣棘，一名墙蘼，生临淄，五月采实，阴干。"}]},{"ID":"20240616165234-8dfesrr","Type":"NodeParagraph","Properties":{"id":"20240616165234-8dfesrr","updated":"20240616165234"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：蛇粟，马床，蛇床也，《尔雅》云：盱虺床，《淮南子》汜论训云：乱人者若蛇床之与蘼芜。"}]},{"ID":"20240616164539-pcvbxg4","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-pcvbxg4"}},{"ID":"20240616165147-9h9h2nk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616165147-9h9h2nk","updated":"20240616165151"},"Children":[{"Type":"NodeText","Data":"蛇床子《名医别录》"}]},{"ID":"20240616165147-13oi1om","Type":"NodeParagraph","Properties":{"id":"20240616165147-13oi1om","updated":"20240616165147"},"Children":[{"Type":"NodeText","Data":"味辛、甘，无毒．主温中下气，令妇人子藏热，男子阴强．久服好颜色，令人有子名虺床，一名思益，一名绳毒，一名枣棘，一名墙蘼．生临淄．五月采实，阴干．（恶巴豆、贝母．）"}]},{"ID":"20240616165147-o62g0q8","Type":"NodeParagraph","Properties":{"id":"20240616165147-o62g0q8","updated":"20240616165243"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶蛇床子，味苦，平．主妇人阴中肿痛，男子阴痿湿痒，除痹气，利关节，癫痫恶疮.久服轻身。一名蛇米。生川谷及田野。"}]},{"ID":"20240616164539-dfd7x6r","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-dfd7x6r"}},{"ID":"20240616164707-0ujir9x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164707-0ujir9x","updated":"20240616164711"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草新编》"}]},{"ID":"20240616164707-tqr3x74","Type":"NodeParagraph","Properties":{"id":"20240616164707-tqr3x74","updated":"20240616164707"},"Children":[{"Type":"NodeText","Data":"蛇床子，味苦、辛，气平，无毒。治阴户肿疼且痒，温暖子宫，疗男子阴囊湿痒，坚举尿茎，敛阴汗，却癫痫，拂疮疡，利关节，主腰膝胯痛，祛手足痹顽，治产后阴脱不起，妇人无娠，尤宜久服，则功用颇奇。内外俱可施治，而外治尤良。若欲修合丸散，用之于参、 、归、地、山茱之中，实有利益，然又宜乎阴寒无火之人，倘阴虚火动者，服之非宜也。"}]},{"ID":"20240616164707-j4mb4l7","Type":"NodeParagraph","Properties":{"id":"20240616164707-j4mb4l7","updated":"20240616164707"},"Children":[{"Type":"NodeText","Data":"或问蛇床子外治实佳，内治未必得如外治。不知蛇床子内、外治无不佳也。吾言其内治之，益绝阳不起，用蛇床子一两、熟地一两，二味煎服，阳道顿起，可以久战，大异平日，非内治之尤佳乎？以之修合丸散，尤有久力。可见，蛇床子煎丸并用，无不佳妙。不可谓外治佳，内治不佳也。"}]},{"ID":"20240616164707-ivudubo","Type":"NodeParagraph","Properties":{"id":"20240616164707-ivudubo","updated":"20240616164707"},"Children":[{"Type":"NodeText","Data":"或问蛇床子除熟地同用之外，何药更可并用？曰∶蛇床子同黄 各一两，兴阳信奇于用熟地，推之而当归可并用也，推之而白术可并用也，推之而杜仲可并用也，推之菟丝子可并用也。或健脾，或安神，或益血，要任人善用之何如耳，安在不可出奇哉。"}]},{"ID":"20240616164707-dw2asac","Type":"NodeParagraph","Properties":{"id":"20240616164707-dw2asac","updated":"20240616164707"},"Children":[{"Type":"NodeText","Data":"或疑蛇床子乃外治之药，可妄言内治乎，试之杀人之咎将安归？曰∶蛇床子实可内治，而世人以外治，而掩其内治之功，予所以表其奇也，岂好异哉。"}]},{"ID":"20240616164842-51gag28","Type":"NodeThematicBreak","Properties":{"id":"20240616164842-51gag28"}},{"ID":"20240616164843-9o1byn9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164843-9o1byn9","updated":"20240616164847"},"Children":[{"Type":"NodeText","Data":"蛇床子《神农本草经赞》"}]},{"ID":"20240616164843-8vd28ug","Type":"NodeParagraph","Properties":{"id":"20240616164843-8vd28ug","updated":"20240616164843"},"Children":[{"Type":"NodeText","Data":"味苦平。主妇人阴中肿痛。男子阴痿。湿痒。除痹气。利关节。癫痫恶创。久服轻身。一名蛇米。生川谷及田野。"}]},{"ID":"20240616164843-q4gcz8e","Type":"NodeParagraph","Properties":{"id":"20240616164843-q4gcz8e","updated":"20240616164843"},"Children":[{"Type":"NodeText","Data":"湿幽墟。饥蛇凝恋。芎叶槎丫。蒿枝峭茜。百结同窠。双粒合片。蘼弱芜繁。令人目黄诗。苍榛幽墟。李时珍曰。蛇虺喜卧于下。食其子。苏轼诗。饥蛇不汝放。李邕妻温氏表。岁时凝恋。韩保升曰。下湿地皆有。叶似小叶芎。苏颂曰。三月生苗。作丛似蒿枝。每枝有花头百余结同一窠。李时珍曰。其子两片合成。淮南子。乱人者。蛇床之与蘼芜。张名由诗。令人心目。"}]},{"ID":"20240616164904-kfzm27u","Type":"NodeThematicBreak","Properties":{"id":"20240616164904-kfzm27u"}},{"ID":"20240616164905-j3vrbms","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164905-j3vrbms","updated":"20240616164916"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草图经》"}]},{"ID":"20240616164905-tsw9jop","Type":"NodeParagraph","Properties":{"id":"20240616164905-tsw9jop","updated":"20240616164911"},"Children":[{"Type":"NodeText","Data":"蛇床子，生临淄川谷及田野，今处处有之，而扬州、襄州者胜。三月生苗，高三、二尺；叶青碎，作丛似蒿枝；每枝上有花头百余，结同一窠，似马芹类；四、五月开白花，又似散水；子黄褐色，如黍米，至轻虚。五月采实，阴干。《尔雅》谓之盱，一名虺床。"}]},{"ID":"20240616164958-dximdbo","Type":"NodeThematicBreak","Properties":{"id":"20240616164958-dximdbo"}},{"ID":"20240616164959-fztf14q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164959-fztf14q","updated":"20240616165003"},"Children":[{"Type":"NodeText","Data":"蛇床子《新修本草》"}]},{"ID":"20240616164959-g2kubkg","Type":"NodeParagraph","Properties":{"id":"20240616164959-g2kubkg","updated":"20240616164959"},"Children":[{"Type":"NodeText","Data":"味苦、辛、甘，平，无毒。主妇人阴中肿痛，男子阴痿湿痒，除痹气，利关节，癫痫，恶疮。温中下气，令妇人子藏热，男子阴强。久服轻身，好颜色，令人有子。一名蛇粟，一名蛇米，一名虺床，一名思益，一名绳毒，一名枣棘，一名墙蘼。生临淄川谷及田野。五月采实，阴干。"}]},{"ID":"20240616164959-a65m08g","Type":"NodeParagraph","Properties":{"id":"20240616164959-a65m08g","updated":"20240616164959"},"Children":[{"Type":"NodeText","Data":"恶牡丹、巴豆、贝母。 近道田野墟落间甚多。花、叶正似蘼芜。"}]},{"ID":"20240616164959-35lfpau","Type":"NodeParagraph","Properties":{"id":"20240616164959-35lfpau","updated":"20240616164959"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《尔雅》一名盱。"}]},{"ID":"20240616165055-y3glxmu","Type":"NodeThematicBreak","Properties":{"id":"20240616165055-y3glxmu"}},{"ID":"20240616165056-7jzj1jk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616165056-7jzj1jk","updated":"20240616165101"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草崇原》"}]},{"ID":"20240616165056-gb42nmc","Type":"NodeParagraph","Properties":{"id":"20240616165056-gb42nmc","updated":"20240616165056"},"Children":[{"Type":"NodeText","Data":"气味苦辛，无毒。主男子阴痿湿痒，妇人阴中肿痛，除痹气，利关节，癫痫，恶疮。久服轻身，好颜色。（辛，旧作平，今改正。）"}]},{"ID":"20240616165056-dhwsigs","Type":"NodeParagraph","Properties":{"id":"20240616165056-dhwsigs","updated":"20240616165056"},"Children":[{"Type":"NodeText","Data":"（蛇床子《本经》名蛇粟，又名蛇米。《尔雅》名虺床，以虺蛇喜卧于下，嗜食其子，故有此名。始出临溜川谷及田野湿地，今所在皆有。三月生苗，高二三尺，叶青碎作丛似蒿，每蛇床子气味苦辛，其性温热，得少阴君火之气。主治男子阴痿湿痒，妇人阴中肿痛，禀火气而下济其阴寒也。除痹气，利关节，禀火气而外通其经脉也。心气虚而寒邪盛，则癫痫。心气虚而热邪盛，则生恶疮。蛇床味苦性温，能助心气，故治癫痫恶疮。久服则火土相生，故轻身。心气充盛，故好颜色。"}]},{"ID":"20240616165056-dg4q9c7","Type":"NodeParagraph","Properties":{"id":"20240616165056-dg4q9c7","updated":"20240616165115"},"Children":[{"Type":"NodeText","Data":"蛇，阴类也。蛇床子性温热，蛇虺喜卧于中，嗜食其子，犹山鹿之嗜水龟，潜龙之嗜飞燕，李时珍曰∶蛇床子，《神农》列之上品，不独助男子，且有益妇人，乃世人舍此而求补药于远域，且近时但用为疮药，惜哉。"}]},{"ID":"20240616165024-zvdpq8h","Type":"NodeThematicBreak","Properties":{"id":"20240616165024-zvdpq8h"}},{"ID":"20240616165025-bpj81wt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616165025-bpj81wt","updated":"20240616165032"},"Children":[{"Type":"NodeText","Data":"蛇床子《证类本草》"}]},{"ID":"20240616165025-83skgrt","Type":"NodeParagraph","Properties":{"id":"20240616165025-83skgrt","updated":"20240616165025"},"Children":[{"Type":"NodeText","Data":"味苦、辛、甘，平，无毒。主妇人阴中肿痛，男子阴痿，湿痒，除痹气，利关节，癫痫，恶疮，温中下气，令妇人子脏热，男子阴强。久服轻身，好颜色，令人有子。一名蛇粟。一名蛇米，一名虺床，一名思益，一名绳毒，一名枣棘，一名墙蘼。生临淄川谷及田野。五月采实，阴干。（恶牡丹、巴豆、贝母。）"}]},{"ID":"20240616165025-gmqtmus","Type":"NodeParagraph","Properties":{"id":"20240616165025-gmqtmus","updated":"20240616165025"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道田野墟落间甚多。花、叶正似蘼芜。唐本注云∶《尔雅》一名盱（音吁）。"}]},{"ID":"20240616165025-3it8h49","Type":"NodeParagraph","Properties":{"id":"20240616165025-3it8h49","updated":"20240616165025"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按蜀本图经云∶似小叶芎 ，花白，子如黍粒，黄白色。生下湿地，今所在皆有出扬州、襄州者良。采子曝干。尔雅云∶盱，虺床。注∶蛇床也，一名马床。药性论云∶蛇床仁，君，有小毒。治男子、女人虚，湿痹，毒风 痛，去男子腰疼，浴男女阴，去风冷，大益阳事。主大风身痒，煎汤浴之瘥。疗齿痛及小儿惊痫。日华子云∶治暴冷，暖丈夫阳气，助女人阴气，扑损瘀血，腰跨疼，阴汗，湿癣，四肢顽痹，赤白带下，缩小便。凡合药服食，即挪去皮壳，取仁微炒杀毒，即不辣。作汤洗病则生使。"}]},{"ID":"20240616165025-7y99ybu","Type":"NodeParagraph","Properties":{"id":"20240616165025-7y99ybu","updated":"20240616165025"},"Children":[{"Type":"NodeText","Data":"图经曰∶蛇床子，生临淄川谷及田野。今处处有之，而扬州、襄州者胜。三月生苗，高三、二尺，叶青碎作丛似蒿枝。每枝上有花头百余，结同一窠似马芹类。四、五月开白花，又似散水。子黄褐色如黍米，至轻虚。五月采实，阴干。《尔雅》谓之盱，一名虺床。"}]},{"ID":"20240616165025-4aidp40","Type":"NodeParagraph","Properties":{"id":"20240616165025-4aidp40","updated":"20240616165025"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，须用浓蓝汁，并百部草根自然汁，二味同浸三伏时，漉出日干。却用生地黄汁相拌蒸，从午至亥，日干。用此药只令阳气盛数，号曰鬼考也。千金方∶治产后阴下脱。蛇床子绢袋盛，蒸熨之，亦治阴户痛。又方∶治小儿癣疮。杵蛇床末，和猪脂涂之。金匮方温中坐药蛇床子散方∶蛇床子仁为末，以白粉少许和令匀相得，如枣大，绵裹纳之，自然温矣。"}]},{"ID":"20240616165008-4y1m4qs","Type":"NodeThematicBreak","Properties":{"id":"20240616165008-4y1m4qs"}},{"ID":"20240616165009-xfauta3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616165009-xfauta3","updated":"20240616165013"},"Children":[{"Type":"NodeText","Data":"蛇床子《医学入门》"}]},{"ID":"20240616165009-n9m5gd5","Type":"NodeParagraph","Properties":{"id":"20240616165009-n9m5gd5","updated":"20240616165009"},"Children":[{"Type":"NodeText","Data":"蛇床子平甘苦辛，疥癣阴痒及遍身，暖宫壮阳令有子，治痹通关逐瘀湮。"}]},{"ID":"20240616165009-lcmj2ag","Type":"NodeParagraph","Properties":{"id":"20240616165009-lcmj2ag","updated":"20240616165009"},"Children":[{"Type":"NodeText","Data":"蛇常栖息此草上，故名之。无毒。治恶疮，湿癣，阴痒，大风身痒，煎汤浴之，或捣末猪脂调涂。治妇人阴中肿痛，赤白带下，一切子宫冷症；男子阴痿，大益阳事，缩小便，令人有子。又治诸湿痹毒、腰胯疼痛、四肢顽麻，通关节，逐扑损瘀血。兼治颠痫，风冷齿痛。温中下气，久服轻身悦颜。入洗汤生用，入丸、散用布包。挪去皮壳，取净仁微妙。恶牡丹、巴豆、贝母。"}]},{"ID":"20240616164947-t1z5sm2","Type":"NodeThematicBreak","Properties":{"id":"20240616164947-t1z5sm2"}},{"ID":"20240616164948-w8uaiet","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164948-w8uaiet","updated":"20240616164953"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草述钩元》"}]},{"ID":"20240616164948-k5g0g3m","Type":"NodeParagraph","Properties":{"id":"20240616164948-k5g0g3m","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"因蛇虺喜卧其下。食其子。故又名蛇粟。下湿地所在皆有。其子轻虚。褐色。两片合成。"}]},{"ID":"20240616164948-w4tl1b2","Type":"NodeParagraph","Properties":{"id":"20240616164948-w4tl1b2","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"亦有细棱。凡花实似蛇床者。当归川芎水芹胡萝卜。"}]},{"ID":"20240616164948-34nxs1v","Type":"NodeParagraph","Properties":{"id":"20240616164948-34nxs1v","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"气味苦而大辛微甘。乃右肾命门少阳三焦气分之药。主治强阴。益阳事。缩小便。暖女子子脏。温中下气。利关节。疗虚湿痹毒风（手足麻痹也）痛。腰胯酸疼。四肢顽痹。更治男子阴痿湿痒。女子阴中肿痛。去阴汗湿癣。煎汤沿大风身痒。多服令人有子。方书治痿健忘消瘅赤白浊诸剂中亦有之。苦就火至地。辛归金达天。甘属土合气交。故能除湿益阳。"}]},{"ID":"20240616164948-8p7al01","Type":"NodeParagraph","Properties":{"id":"20240616164948-8p7al01","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"不惟已疾而又有补益也。（仲淳）蛇性窜疾。居处隐僻。禀善行数变之体用。蛇床功用。靡不吻合。设非气性相感。宁为蛇虺所嗜耶。故凡厥阴隐僻之地。气闭不通。得蛇床宣大风力。"}]},{"ID":"20240616164948-nhtfs2z","Type":"NodeParagraph","Properties":{"id":"20240616164948-nhtfs2z","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"鼓舞生阳。则前阴疏泄。窜疾自如。并可伸癫痫之气逆于脏。与关节之壅闭不开。而作把握阴阳之良剂也。（之颐）同远志巴戟牛膝首乌阳起石。治阴痿湿痒。按此证多由肝经湿热。"}]},{"ID":"20240616164948-9eigt3i","Type":"NodeParagraph","Properties":{"id":"20240616164948-9eigt3i","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"不得概以辛温之味治之。同巴戟牛膝杜仲续断地黄白胶黄柏。治妇人阴中肿痛。同黄柏山萸五味茯苓车前子香附续断补骨脂。治一切带下。赤者加白胶阿胶。阳事不起。蛇床菟丝五味等分。为末。蜜丸梧子大。每服三十丸。温酒下。日三服。赤白带下。月水不来。蛇床子枯矾等分。为末。醋面糊丸弹子大。胭脂为衣。绵裹纳入阴户。如热极再换。日一次。"}]},{"ID":"20240616164948-kulh1vx","Type":"NodeParagraph","Properties":{"id":"20240616164948-kulh1vx","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"〔论〕蛇床以四月放花白色。结子攒簇。两片轻虚。五月采实。夫实结于夏。而尝之先苦后转大辛。是火气归于金也。然花白色而质轻虚。金质复归于火矣。火不归金。则气之体不全。金不归火。则气之用不昌。气之体全。乃能归命门以孕其元气之用。昌乃能达三焦以致其用。本经治阴痿湿痒。及阴中肿痛。除痹气。利关节。指其用而言也。别录令男子阴强。"}]},{"ID":"20240616164948-qf430fx","Type":"NodeParagraph","Properties":{"id":"20240616164948-qf430fx","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"女子子脏热。指其体而言也。夫元气之体用。全俱于坎离。然坎中孕离。离中宅坎。皆由其得金气也。金为水母。火为金夫。惟水中有金。故坎中孕离。水为火用。而元气以生。惟火中有金。故离中蓄坎。火为水用。而元气以化。兹物乘夏火以结实。而火气尽归金味。赋轻虚以攒成。而金味仍是火质。火归金。故令火为水用而畅阴。此天气至地。夫从妻也。金化火。乃得水为火用而达阳。此地气至天。子随母也。由化归生。复由生归化。元气之体用似有独全者。又蛇床所治。类由阳气之不得鼓舞以畅其用。风虚为病也。如金火合德而气化。"}]},{"ID":"20240616164948-7t9rb0k","Type":"NodeParagraph","Properties":{"id":"20240616164948-7t9rb0k","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"则虽微物。而有天气至地。地气至天之化机。试观其质轻虚。岂非阴湿化为阳明。有鼓之舞之以畅天气者乎。盖天气畅则至地。地气达则至天。火为水用而畅阴。阴畅则降。而阳随之。"}]},{"ID":"20240616164948-fzmhzhs","Type":"NodeParagraph","Properties":{"id":"20240616164948-fzmhzhs","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"水为火用而达阳。阳达则升。而阴随之。是物以达阳而升为终事。却以畅阴而降为始事。乃金火合而归于命门之实际也。归命门则三焦气盛。其原与足厥阴相通者。自能合而行上矣。"}]},{"ID":"20240616164948-fu9z45r","Type":"NodeParagraph","Properties":{"id":"20240616164948-fu9z45r","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"（所以治喉痹耳湿牙风及肾虚耳聋诸方亦用之）别录于此味更云辛甘。辛合于甘以归肾。是由母趋子。故得致津液而化阴中之阳。如菟丝覆盆蛇床。皆补阴气之的剂。非苦辛热偏者胜也。蛇床之用。所谓天气至地。地气至天者。于何征之。如本草强阴。是天气至地。而健忘丸用之。则地气至天也。此犹同宫水火之气耳。若上以治面疮。下以疗痔疾。夫非上下极至之征欤。更如内补鹿茸丸治赤白浊。其益阳若桂附亦用之矣。岂犹藉蛇床以达阳者。盖缘思想伤阴。乃是阳中之阴不化。阴伤而及于阳也。或借此以化阳中之阴。而后真阳乃得复欤。"}]},{"ID":"20240616164948-yrh4u9m","Type":"NodeParagraph","Properties":{"id":"20240616164948-yrh4u9m","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"又如消瘅之白茯苓丸。（因消中后胃热入肾。消烁肾脂。令肾枯燥。遂致此疾。）既滋肾阴而除胃肾之枯燥矣。乃反用此味以达阳者。毋亦阳陷阴中而不化。须借此由阴之化以散阳欤。"}]},{"ID":"20240616164948-t1m6g8y","Type":"NodeParagraph","Properties":{"id":"20240616164948-t1m6g8y","updated":"20240616164948"},"Children":[{"Type":"NodeText","Data":"即此推之。不得但以去湿达阳。尽蛇床之能事矣。大抵火中之金。应归命门元气。以金水子母相恋。且返其所自始也。然则紫苏亦火中之金。何以不归命门。曰。紫苏紫色。合于辛味。自应入心与肺矣。命门为元气之根。心肺即为元气之用。为气之用。所以紫苏为宣剂。其性温燥。凡肾家有火。下部有热者。勿服。（仲淳）〔修治〕作汤洗浴。则生用之。入丸散。用布包去皮壳取仁。微炒杀毒即不辣。酒浸一宿。以生地汁拌。久蒸焙干用。（雷公）按蛇床子之用。全在辣甚。炒殊不宜。不若雷公用生地拌蒸之为当。"}]},{"ID":"20240616164936-tbbhzk5","Type":"NodeThematicBreak","Properties":{"id":"20240616164936-tbbhzk5"}},{"ID":"20240616164937-wm7bb3x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164937-wm7bb3x","updated":"20240616164941"},"Children":[{"Type":"NodeText","Data":"蛇床子《千金翼方》"}]},{"ID":"20240616164937-p9vj6jb","Type":"NodeParagraph","Properties":{"id":"20240616164937-p9vj6jb","updated":"20240616164937"},"Children":[{"Type":"NodeText","Data":"味苦辛甘，平，无毒。主妇人阴中肿痛，男子阴痿湿痒，除痹气，利关节，癫痫，恶疮。"}]},{"ID":"20240616164937-96f09rd","Type":"NodeParagraph","Properties":{"id":"20240616164937-96f09rd","updated":"20240616164937"},"Children":[{"Type":"NodeText","Data":"温中下气，令妇人子脏热，男子阴强。久服轻身，好颜色，令人有子。一名蛇粟，一名蛇米，一名虺床，一名思益，一名绳毒，一名枣棘，一名墙蘼。生临淄川谷及田野，五月采实，阴干。"}]},{"ID":"20240616164920-w6vccdi","Type":"NodeThematicBreak","Properties":{"id":"20240616164920-w6vccdi"}},{"ID":"20240616164921-ro7ea8x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164921-ro7ea8x","updated":"20240616164929"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草便读》"}]},{"ID":"20240616164921-3hvi3ci","Type":"NodeParagraph","Properties":{"id":"20240616164921-3hvi3ci","updated":"20240616164921"},"Children":[{"Type":"NodeText","Data":"助阳暖下．有祛除寒湿之功．入肾行脾．乃辛苦性温之力．阴蚀虫疮等证．煎洗颇宜．风淫疥癞诸疮．外敷有效．（蛇床子辛苦温．微毒．入肾脏．补下元．祛寒湿．暖子宫．杀虫疥．治阴痿囊湿等证．古人每用以内服．极云有效．今皆外治方多用之．或煎汤熏洗．或研末调敷．亦世俗之不同耳．）"}]},{"ID":"20240616164853-cak70la","Type":"NodeThematicBreak","Properties":{"id":"20240616164853-cak70la"}},{"ID":"20240616164854-vpespw9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164854-vpespw9","updated":"20240616164858"},"Children":[{"Type":"NodeText","Data":"蛇床子《药性切用》"}]},{"ID":"20240616164854-nxeas2p","Type":"NodeParagraph","Properties":{"id":"20240616164854-nxeas2p","updated":"20240616164854"},"Children":[{"Type":"NodeText","Data":"辛苦性温，入肾命而祛风燥湿。除下体湿痒、恶疮，为外科专药。"}]},{"ID":"20240616164831-hjdb9un","Type":"NodeThematicBreak","Properties":{"id":"20240616164831-hjdb9un"}},{"ID":"20240616164832-wwu8vdb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164832-wwu8vdb","updated":"20240616164837"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草求真》"}]},{"ID":"20240616164832-bvqzang","Type":"NodeParagraph","Properties":{"id":"20240616164832-bvqzang","updated":"20240616164832"},"Children":[{"Type":"NodeText","Data":"（芳草）燥湿宣风"}]},{"ID":"20240616164832-djryi0e","Type":"NodeParagraph","Properties":{"id":"20240616164832-djryi0e","updated":"20240616164832"},"Children":[{"Type":"NodeText","Data":"蛇床子（专入命门）。辛苦性温。功能入肾补命。祛风燥湿。故凡命门火衰而致风湿内淫。病见阴痿。（蛇床子五味子菟丝子等分为末。蜜丸酒下。）囊湿及女子阴户虫蚀。（蛇床子一两。白矾二钱。煎汤频洗。）子脏虚寒。（取蛇床子仁为末。入白粉少许。和匀如枣。绵裹纳之。）产门不开。暨腰酸体痹带下脱肛。（脱肛。以蛇床子甘草为末服。并以蛇床末敷。）与夫一切风湿疮疥等病。（蛇床子一两。轻粉四钱。为细末。油调抹。）服之则阳茎举。关节利。腰背强。手足遂。疮疥扫。至于大疯身痒难当。作汤浴洗。产后阴脱不收。用此绢袋熨收。但性温燥。凡命门火炽及下部有热者。切忌。恶丹皮贝母巴豆。去皮壳。取仁微炒。"}]},{"ID":"20240616164821-luj7c27","Type":"NodeThematicBreak","Properties":{"id":"20240616164821-luj7c27"}},{"ID":"20240616164822-x0fm5yr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164822-x0fm5yr","updated":"20240616164826"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草简要方》"}]},{"ID":"20240616164822-xpfi14p","Type":"NodeParagraph","Properties":{"id":"20240616164822-xpfi14p","updated":"20240616164822"},"Children":[{"Type":"NodeText","Data":"主治。温中。益阳腰胯酸疼妇人阴寒。此为壮阳暖阴之药。与菟丝枸杞。可以参用。"}]},{"ID":"20240616164805-fu6867k","Type":"NodeThematicBreak","Properties":{"id":"20240616164805-fu6867k"}},{"ID":"20240616164806-pn9obng","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164806-pn9obng","updated":"20240616164812"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草从新》"}]},{"ID":"20240616164806-qs094x7","Type":"NodeParagraph","Properties":{"id":"20240616164806-qs094x7","updated":"20240616164806"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补肾命、去风湿．"}]},{"ID":"20240616164806-flr00sw","Type":"NodeParagraph","Properties":{"id":"20240616164806-flr00sw","updated":"20240616164806"},"Children":[{"Type":"NodeText","Data":"辛苦而温．强阳补肾．散寒祛风．燥湿杀虫．治阴痿囊湿．女子阴痛阴痒．（湿生虫、同矾煎汤洗．）子藏虚寒．产门不闭．（炒热熨之．）肾命之病．腰酸体痹．带下脱肛．及顽癣恶疮．（擦之多效．）风湿诸病．煎汤浴．止风痒．（时珍曰∶肾命三焦气分之药、不独补助男子、而且有益妇人、世人舍此而求补药于远域、岂非贵耳贱目乎．）肾火易动者勿食．似小茴而细．微炒杀毒则不辣．（以地黄汁拌蒸三遍、佳．）恶丹皮、贝母、巴豆．（圣惠方、冬月喉痹肿痛、不可下药者、蛇床烧烟于瓶中、口对瓶口吸烟、其痰自出．）"}]},{"ID":"20240616164748-ts58nca","Type":"NodeThematicBreak","Properties":{"id":"20240616164748-ts58nca"}},{"ID":"20240616164749-o7nwvz9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164749-o7nwvz9","updated":"20240616164800"},"Children":[{"Type":"NodeText","Data":"蛇床子《增广和剂局方药性总论》"}]},{"ID":"20240616164749-7uiyyhm","Type":"NodeParagraph","Properties":{"id":"20240616164749-7uiyyhm","updated":"20240616164749"},"Children":[{"Type":"NodeText","Data":"味苦辛甘，平，无毒。主妇人阴中肿痛，男子阴痿，湿痒，除痹气，利关节，癫痫疮，温中下气，令妇人子脏热，男子阴强。《药性论》云∶君。疗齿痛，浴男女阴去风大益阳事，小儿惊痫。日华子云∶治暴冷，暖丈夫阳气，助女人阴气，扑损瘀血，腰胯阴汗湿癣，四肢顽痹，赤白带下，缩小便。凡用取仁微炒杀毒，作汤洗则生使。恶∶牡丹、巴豆、贝母。"}]},{"ID":"20240616164737-onlvnr8","Type":"NodeThematicBreak","Properties":{"id":"20240616164737-onlvnr8"}},{"ID":"20240616164739-uv8vy20","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164739-uv8vy20","updated":"20240616164742"},"Children":[{"Type":"NodeText","Data":"蛇床《本草纲目》"}]},{"ID":"20240616164739-junqeps","Type":"NodeParagraph","Properties":{"id":"20240616164739-junqeps","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"「释名」亦名蛇粟、蛇米、虺床、马床、墙蘼。"}]},{"ID":"20240616164739-iydy0k9","Type":"NodeParagraph","Properties":{"id":"20240616164739-iydy0k9","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、无毒。"}]},{"ID":"20240616164739-xigpn0l","Type":"NodeParagraph","Properties":{"id":"20240616164739-xigpn0l","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616164739-aioo7c8","Type":"NodeParagraph","Properties":{"id":"20240616164739-aioo7c8","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"1、阳事不起。用蛇床子、五味子、菟丝子，等分为末，加炼蜜做成丸子，如梧子大。每服三十丸，温酒送下。一天服三次。"}]},{"ID":"20240616164739-6tk8blm","Type":"NodeParagraph","Properties":{"id":"20240616164739-6tk8blm","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"2、赤白带下，月经不来。用蛇床子、桔白矾，等分为末，加醋、面和成丸子，如弹子大，胭脂为衣，棉裹后纳入阴道中。一天换药一次。"}]},{"ID":"20240616164739-8emj8oj","Type":"NodeParagraph","Properties":{"id":"20240616164739-8emj8oj","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"3、妇女阴部奇痒。用蛇床子一两、白矾二钱，煎汤常洗。"}]},{"ID":"20240616164739-o96yrms","Type":"NodeParagraph","Properties":{"id":"20240616164739-o96yrms","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"4、产后阴脱。用布包蛇床子蒸熟后熨患处。又方：蛇床子五两、乌梅十四个，煎水洗。一天洗五至六次。此方亦治妇女阴痛。"}]},{"ID":"20240616164739-457xiu4","Type":"NodeParagraph","Properties":{"id":"20240616164739-457xiu4","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"5、男子阴肿、胀痛。用蛇床子研为末，加鸡蛋黄调匀敷患处。"}]},{"ID":"20240616164739-dxabolr","Type":"NodeParagraph","Properties":{"id":"20240616164739-dxabolr","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"6、脱肛。用蛇床子、甘草各一两，研细。每服一钱，白开水送下。一天服三次。同时，用蛇床子末搽患处。"}]},{"ID":"20240616164739-gt2el3l","Type":"NodeParagraph","Properties":{"id":"20240616164739-gt2el3l","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"7、痔疮。用蛇床子煎汤熏洗。"}]},{"ID":"20240616164739-u6el0u3","Type":"NodeParagraph","Properties":{"id":"20240616164739-u6el0u3","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"8、小儿癣疮。用蛇床子末，加猪油调匀，搽疮上。"}]},{"ID":"20240616164739-ky7qv2p","Type":"NodeParagraph","Properties":{"id":"20240616164739-ky7qv2p","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"9、小儿甜疮（疮连到头、面、耳边，流水，极痒，久不愈）。用蛇床子一两、水银粉三钱，共研为末，调油涂患处。"}]},{"ID":"20240616164739-ssqt3ov","Type":"NodeParagraph","Properties":{"id":"20240616164739-ssqt3ov","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"10、牙痛。用蛇床子煎汤，乘热漱口。"}]},{"ID":"20240616164739-bandh3s","Type":"NodeParagraph","Properties":{"id":"20240616164739-bandh3s","updated":"20240616164739"},"Children":[{"Type":"NodeText","Data":"12、冬月喉痹，肿痛不能下药。用蛇床子放入瓶中烧出烟，令病人口含瓶嘴吸烟，有痰吐出，病即渐愈。"}]},{"ID":"20240616164720-oem9yai","Type":"NodeThematicBreak","Properties":{"id":"20240616164720-oem9yai"}},{"ID":"20240616164723-j4ue5ft","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164723-j4ue5ft","updated":"20240616164728"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草易读》"}]},{"ID":"20240616164723-oo7k8pq","Type":"NodeParagraph","Properties":{"id":"20240616164723-oo7k8pq","updated":"20240616164723"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"服食炒用，作汤浴生用。恶牡丹、贝母、巴豆，伏硫黄。"}]},{"ID":"20240616164723-6lrxktr","Type":"NodeParagraph","Properties":{"id":"20240616164723-6lrxktr","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"苦，平，微温，无毒。入脾、肝、肾三经。暖补命门，温养子宫。起丈夫玉茎痿弱，兼洗湿痒，除女子玉门寒冷，并治肿痛。腰膝痛酸，肢节顽痹，扑损瘀血，赤白带漏。洗疥癣痂癞之毒，熏痔漏顽恶之疮。一身尽痒，非此莫浴，小便自遗，用之立收。大益男子之阳事，尤治小儿之痫病。最漱牙痛，亦敛阴汗。"}]},{"ID":"20240616164723-ux33h3h","Type":"NodeParagraph","Properties":{"id":"20240616164723-ux33h3h","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"生临淄川谷及田野。五月采实。近田野墟落甚多。三月生苗，高二三尺，叶青碎，作丛似蒿枝。每枝上花头百余，结同一窠。盖其花实与当归、芎 、水芹、 本、莳萝、胡萝卜等也。在处有之，以扬州、襄州者为良。"}]},{"ID":"20240616164723-cgcmjjx","Type":"NodeParagraph","Properties":{"id":"20240616164723-cgcmjjx","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"阳事不起，同五味、菟丝蜜丸服，酒下。煎浴之尤佳。（验方第一。）"}]},{"ID":"20240616164723-nrna599","Type":"NodeParagraph","Properties":{"id":"20240616164723-nrna599","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"赤白带，同枯矾醋丸弹大，绵包纳阴中，热极再换，甚效。（第二。）"}]},{"ID":"20240616164723-ll5t41w","Type":"NodeParagraph","Properties":{"id":"20240616164723-ll5t41w","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"子宫冷。同上。（第三。）"}]},{"ID":"20240616164723-0y1tjcq","Type":"NodeParagraph","Properties":{"id":"20240616164723-0y1tjcq","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"妇人阴痒，稍佐白矾煎洗。（第四。）"}]},{"ID":"20240616164723-en1cbpe","Type":"NodeParagraph","Properties":{"id":"20240616164723-en1cbpe","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"产后阴脱，蒸热绢包熨之，稍少佐乌梅煎洗。（第五。）"}]},{"ID":"20240616164723-i20az0q","Type":"NodeParagraph","Properties":{"id":"20240616164723-i20az0q","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"妇人阴痛。同上。（第六。）"}]},{"ID":"20240616164723-njw6hc0","Type":"NodeParagraph","Properties":{"id":"20240616164723-njw6hc0","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"男子阴肿痛，为末，鸡子黄合敷。（第七。）"}]},{"ID":"20240616164723-bnibmmp","Type":"NodeParagraph","Properties":{"id":"20240616164723-bnibmmp","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"脱肛，为末敷之，又同甘草服。（第八。）"}]},{"ID":"20240616164723-1j6iwhr","Type":"NodeParagraph","Properties":{"id":"20240616164723-1j6iwhr","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"痔疮肿痛，煎熏洗之。（第九。）"}]},{"ID":"20240616164723-ejosi0z","Type":"NodeParagraph","Properties":{"id":"20240616164723-ejosi0z","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"小儿癣，为末，猪油合敷。（第十。）"}]},{"ID":"20240616164723-45gxo19","Type":"NodeParagraph","Properties":{"id":"20240616164723-45gxo19","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"耳内湿疮，同黄连、轻粉末吹之。（十一。）"}]},{"ID":"20240616164723-u2reca2","Type":"NodeParagraph","Properties":{"id":"20240616164723-u2reca2","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"风虫牙痛，煎漱。（十二。）"}]},{"ID":"20240616164723-wdfrnt6","Type":"NodeParagraph","Properties":{"id":"20240616164723-wdfrnt6","updated":"20240616164723"},"Children":[{"Type":"NodeText","Data":"冬月喉痹，药不下，烧烟瓶中熏之，涎自出。（十三。）"}]},{"ID":"20240616164539-y26le9q","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-y26le9q"}},{"ID":"20240616164656-9p5gg51","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164656-9p5gg51","updated":"20240616164700"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草择要纲目》"}]},{"ID":"20240616164656-pu018m7","Type":"NodeParagraph","Properties":{"id":"20240616164656-pu018m7","updated":"20240616164656"},"Children":[{"Type":"NodeText","Data":"（凡使．须用浓蓝汁．并百部草根自然汁．同浸一伏时．漉出．日干．却用生地黄汁相拌蒸之．从巳至亥．取出日干用．凡服食 去皮壳．取仁微炒．杀毒即不辣也．作汤洗浴．则生用之．）"}]},{"ID":"20240616164656-2nqoywq","Type":"NodeParagraph","Properties":{"id":"20240616164656-2nqoywq","updated":"20240616164656"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616164656-ebxtqql","Type":"NodeParagraph","Properties":{"id":"20240616164656-ebxtqql","updated":"20240616164656"},"Children":[{"Type":"NodeText","Data":"苦平无毒．"}]},{"ID":"20240616164656-7l95wzo","Type":"NodeParagraph","Properties":{"id":"20240616164656-7l95wzo","updated":"20240616164656"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616164656-0d4bg5y","Type":"NodeParagraph","Properties":{"id":"20240616164656-0d4bg5y","updated":"20240616164656"},"Children":[{"Type":"NodeText","Data":"男子阴痿湿痒．妇人阴中肿痛．除痹气．利关节．癫痫恶疮．久服轻身好颜色．温中下气．令妇人子脏热．男子阴强．久服令人有子．治男子女人虚湿痹毒风 痛．去男子腰痛．浴男子阴．去风冷．大益阳事．暖丈夫阳气．女人阴气．治腰胯酸疼．四肢顽痹．缩小便．去阴汗湿癣齿痛．赤白带下．小儿惊痫．扑损瘀血．煎汤浴大风身痒．盖蛇床乃右肾命门少阳三焦气分之药．神农列之上品．不独补助男子．而又有益妇人．世人舍此而求补药．于远域．岂非贱目贵耳乎．"}]},{"ID":"20240616164539-j0n10mg","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-j0n10mg"}},{"ID":"20240616164644-hn0msz8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164644-hn0msz8","updated":"20240616164650"},"Children":[{"Type":"NodeText","Data":"蛇床子《长沙药解》"}]},{"ID":"20240616164644-9lhb2y4","Type":"NodeParagraph","Properties":{"id":"20240616164644-9lhb2y4","updated":"20240616164644"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦平。主妇人阴中肿痛，男子阴痿，湿痒，除痹气，利关节，癫痫恶创。久服轻身。一名蛇米。生川谷及田野。"}]},{"ID":"20240616164644-hnqhylf","Type":"NodeParagraph","Properties":{"id":"20240616164644-hnqhylf","updated":"20240616164644"},"Children":[{"Type":"NodeText","Data":"味苦、辛、微温，入足太阴脾、足厥阴肝、足少阴肾经。暖补命门，温养子宫，兴丈夫玉麈痿弱，除女子玉门寒冷。"}]},{"ID":"20240616164644-edqef2t","Type":"NodeParagraph","Properties":{"id":"20240616164644-edqef2t","updated":"20240616164644"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛇床子散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蛇床子。为末，以米白粉少许，和合如枣核大，绵裹，纳之自温。"},{"Type":"NodeText","Data":"治妇人阴寒，蛇床子温肝而暖肾，燥湿而去寒也。"}]},{"ID":"20240616164644-cbwu77p","Type":"NodeParagraph","Properties":{"id":"20240616164644-cbwu77p","updated":"20240616164644"},"Children":[{"Type":"NodeText","Data":"蛇床子温燥水土，暖补肾肝，壮阳宜子，男女皆良。疗前阴寒湿肿痛，理下部冷痹酸疼，断赤白带下，收溲尿遗失，浴疥癣痂癞，熏痔漏顽疮，打扑、惊痫、脱肛、脱阴并效，漱牙痛、吹听耳，浴男子阳痿绝佳。"}]},{"ID":"20240616164644-rjc6aah","Type":"NodeParagraph","Properties":{"id":"20240616164644-rjc6aah","updated":"20240616164644"},"Children":[{"Type":"NodeText","Data":"去壳取仁，微研用。作浴汤，生用。"}]},{"ID":"20240616164539-2mt9kff","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-2mt9kff"}},{"ID":"20240616164634-fc3b4cc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164634-fc3b4cc","updated":"20240616164638"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草备要》"}]},{"ID":"20240616164634-sqcuwid","Type":"NodeParagraph","Properties":{"id":"20240616164634-sqcuwid","updated":"20240616164634"},"Children":[{"Type":"NodeText","Data":"补肾命，去风湿"}]},{"ID":"20240616164634-pfppxue","Type":"NodeParagraph","Properties":{"id":"20240616164634-pfppxue","updated":"20240616164634"},"Children":[{"Type":"NodeText","Data":"辛苦而温。强阳益阴，补肾祛寒，祛风燥湿。"}]},{"ID":"20240616164634-of50wo9","Type":"NodeParagraph","Properties":{"id":"20240616164634-of50wo9","updated":"20240616164634"},"Children":[{"Type":"NodeText","Data":"治痿囊湿，女子阴痛阴痒（湿生虫，同矾煎汤洗），子脏虚寒，产门不闭（炒热熨之），肾命之病。及腰酸体痛，带下脱肛，喉痹齿痛，湿癣恶疮（杀虫止痒），风湿诸病。煎汤浴，止风痒（时珍曰∶肾命、三焦气分之药，不独补助男子，而且有益妇人，世人舍此而求补药于远域，岂非贵耳贱目乎？）。"}]},{"ID":"20240616164634-d7fw5k5","Type":"NodeParagraph","Properties":{"id":"20240616164634-d7fw5k5","updated":"20240616164634"},"Children":[{"Type":"NodeText","Data":"似小茴而细。微妙，杀毒则不辣（以地黄汁拌蒸三遍佳）。恶丹皮、贝母、巴豆。"}]},{"ID":"20240616164539-h16wj66","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-h16wj66"}},{"ID":"20240616164625-2zly350","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164625-2zly350","updated":"20240616164628"},"Children":[{"Type":"NodeText","Data":"蛇床子《本草分经》"}]},{"ID":"20240616164625-tk6e38m","Type":"NodeParagraph","Properties":{"id":"20240616164625-tk6e38m","updated":"20240616164625"},"Children":[{"Type":"NodeText","Data":"辛苦温，强阳补肾，散寒祛风燥湿杀虫，治男妇前阴诸疾及子脏虚寒疮癣风湿之病，为肾命三焦气分之药。"}]},{"ID":"20240616164539-pc1kt7y","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-pc1kt7y"}},{"ID":"20240616164615-qghtldo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164615-qghtldo","updated":"20240616164619"},"Children":[{"Type":"NodeText","Data":"蛇床子《冯氏锦囊秘录》"}]},{"ID":"20240616164615-dzr972c","Type":"NodeParagraph","Properties":{"id":"20240616164615-dzr972c","updated":"20240616164615"},"Children":[{"Type":"NodeText","Data":"味苦、辛、甘平，无毒，阳也。凡使须用浓蓝汁并百部自然汁二味同浸，三伏时漉出，晒干，却用生地汁拌蒸，从午至亥晒干用。"}]},{"ID":"20240616164615-skofox8","Type":"NodeParagraph","Properties":{"id":"20240616164615-skofox8","updated":"20240616164615"},"Children":[{"Type":"NodeText","Data":"蛇床子，治妇人阴户肿疼，温暖子脏，男子阴囊湿痒，坚举尿茎，扫疮癣，利关节，腰胯肿痛，手足痹顽，益阳气。治腰膝酸痛，敛阴汗，除湿疮疥癞，大风身痒难当，作汤洗愈。产后阴脱不起，绢袋熨收。妇人无娠，最宜久服。但性温燥，肾家有火，下部有热者忌投。"}]},{"ID":"20240616164539-4m0cbj4","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-4m0cbj4"}},{"ID":"20240616164600-6o4ceez","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164600-6o4ceez","updated":"20240616164610"},"Children":[{"Type":"NodeText","Data":"蛇床子《雷公炮制药性解》"}]},{"ID":"20240616164600-ov1wz2s","Type":"NodeParagraph","Properties":{"id":"20240616164600-ov1wz2s","updated":"20240616164600"},"Children":[{"Type":"NodeText","Data":"味苦辛甘，性平有小毒，入肺肾二经。主风寒湿痹，诸恶疮癣，妇人阴中肿痛，男子阴痿湿痒，久服驻颜轻身，令人有子。酒浸一宿，地黄汁拌蒸，焙干用，恶牡丹皮、巴豆、贝母。"}]},{"ID":"20240616164600-i4xp1sx","Type":"NodeParagraph","Properties":{"id":"20240616164600-i4xp1sx","updated":"20240616164600"},"Children":[{"Type":"NodeText","Data":"按∶蛇床理风湿，宜入太阴，补虚痿，宜入少阴。"}]},{"ID":"20240616164539-rap3vaf","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-rap3vaf"}},{"ID":"20240616164551-lgbd2ji","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164551-lgbd2ji","updated":"20240616164555"},"Children":[{"Type":"NodeText","Data":"蛇床子《得配本草》"}]},{"ID":"20240616164551-uhzv570","Type":"NodeParagraph","Properties":{"id":"20240616164551-uhzv570","updated":"20240616164551"},"Children":[{"Type":"NodeText","Data":"恶牡丹、贝母、巴豆。伏硫黄。"}]},{"ID":"20240616164551-k04r5sl","Type":"NodeParagraph","Properties":{"id":"20240616164551-k04r5sl","updated":"20240616164551"},"Children":[{"Type":"NodeText","Data":"辛、苦、温。入石肾命门、手少阳经气分。开郁滞，祛风湿。疗疮癣诸痹。煎汤洗浴，立除皮疮及大风瘙痒。得乌梅，洗阴脱阴痛。（寒气散也。）得川连、轻粉，吹耳内湿疮。配白矾，煎汤洗妇人阴痒。（能杀虫。）佐菟丝子，疗阳痿。（寒湿去也。）"}]},{"ID":"20240616164551-o5eaxg3","Type":"NodeParagraph","Properties":{"id":"20240616164551-o5eaxg3","updated":"20240616164551"},"Children":[{"Type":"NodeText","Data":"去壳取仁，微炒杀其毒则不辣，酒浸晒干，以地黄汁拌蒸，焙干用。或用浓蓝汁、百部汁同浸，漉出晒干，再以生地汁拌蒸，晒干用。若作汤洗疮，生用。"}]},{"ID":"20240616164539-ghir5ja","Type":"NodeThematicBreak","Properties":{"id":"20240616164539-ghir5ja"}},{"ID":"20240616164541-a9ufq5z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164541-a9ufq5z","updated":"20240616164545"},"Children":[{"Type":"NodeText","Data":"蛇床子《要药分剂》"}]},{"ID":"20240616164541-dn8tzgt","Type":"NodeParagraph","Properties":{"id":"20240616164541-dn8tzgt","updated":"20240616164541"},"Children":[{"Type":"NodeText","Data":"味苦辛。性温。无毒。感地之燥气而生。可升可降。阳也。恶丹皮、贝母、巴豆。"}]},{"ID":"20240616164541-8s78qrx","Type":"NodeParagraph","Properties":{"id":"20240616164541-8s78qrx","updated":"20240616164541"},"Children":[{"Type":"NodeText","Data":"伏硫黄。"}]},{"ID":"20240616164541-m438cr4","Type":"NodeParagraph","Properties":{"id":"20240616164541-m438cr4","updated":"20240616164541"},"Children":[{"Type":"NodeText","Data":"【主治】主男子阴痿湿痒。女人阴中肿痛阴痒。除痹气。利关节。癫痫。恶疮。（本经）去男带。煎【归经】入命门三焦二经。为疏风去湿之品。（二经气分药补肾散寒强阳益阴）【前论】好古曰。此药令人阳气盛数。号曰鬼考。"}]},{"ID":"20240616164541-40wbtpw","Type":"NodeParagraph","Properties":{"id":"20240616164541-40wbtpw","updated":"20240616164541"},"Children":[{"Type":"NodeText","Data":"鳌按、凡右肾命门有虚寒症者宜用。若肾家有火。下部有热。及阳易举者。虽有湿宜斟酌用之。"}]},{"ID":"20240616164541-9psyrff","Type":"NodeParagraph","Properties":{"id":"20240616164541-9psyrff","updated":"20240616164541"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。凡使。百部浓汁浸一宿。晒干。生地汁拌蒸半日。晒干用。大明曰。"}]},{"ID":"20240607130224-7avo44s","Type":"NodeThematicBreak","Properties":{"id":"20240607130224-7avo44s"}},{"ID":"20240607130330-mznr3ry","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130330-mznr3ry","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"《中国药典》：蛇床子"}]},{"ID":"20240607130330-00jasn3","Type":"NodeParagraph","Properties":{"id":"20240607130330-00jasn3","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130330-maei3e1","Type":"NodeParagraph","Properties":{"id":"20240607130330-maei3e1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" Shé Chuánɡ Zǐ"}]},{"ID":"20240607130330-wa8k8km","Type":"NodeParagraph","Properties":{"id":"20240607130330-wa8k8km","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130330-ww13vdq","Type":"NodeParagraph","Properties":{"id":"20240607130330-ww13vdq","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 野茴香、野胡萝卜子、蛇米、蛇栗"}]},{"ID":"20240607130330-m1hd130","Type":"NodeParagraph","Properties":{"id":"20240607130330-m1hd130","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607130330-d9jssav","Type":"NodeParagraph","Properties":{"id":"20240607130330-d9jssav","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" FRUCTUS CNIDII"}]},{"ID":"20240607130330-wcnb9oa","Type":"NodeParagraph","Properties":{"id":"20240607130330-wcnb9oa","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130330-8k5t6lh","Type":"NodeParagraph","Properties":{"id":"20240607130330-8k5t6lh","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 本品为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛇床"},{"Type":"NodeText","Data":"Cnidium monnieri （L.）Cuss.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。夏、秋二季果实成熟时采收，除去杂质，晒干。"}]},{"ID":"20240607130330-b6g2w6k","Type":"NodeParagraph","Properties":{"id":"20240607130330-b6g2w6k","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607130330-inowsdb","Type":"NodeParagraph","Properties":{"id":"20240607130330-inowsdb","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 本品为双悬果，呈椭圆形，长2～4mm，直径约2mm。表面灰黄色或灰褐色，顶端有2枚向外弯曲的柱基，基部偶有细梗。分果的背面有薄而突起的纵棱5条，接合面平坦，有2条棕色略突起的纵棱线。果皮松脆，揉搓易脱落，种子细小，灰棕色，显油性。气香，味辛凉，有麻舌感。"}]},{"ID":"20240607130330-zekgbkh","Type":"NodeParagraph","Properties":{"id":"20240607130330-zekgbkh","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607130330-jkmt6x0","Type":"NodeParagraph","Properties":{"id":"20240607130330-jkmt6x0","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240607130330-a5lojir","Type":"NodeParagraph","Properties":{"id":"20240607130330-a5lojir","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607130330-p63bcb1","Type":"NodeParagraph","Properties":{"id":"20240607130330-p63bcb1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" （1） 本品分果横切面：外果皮为1 列扁平细胞，外被角质层。中果皮较厚，纵棱异常突出，中部有维管束，其周围有厚壁木化网纹细胞；背面纵棱间各有椭圆形油管1 个，接合面有油管2 个，共有6 个。内果皮为1 列扁平细胞。种皮为 1列淡棕色细胞。胚乳细胞含多数糊粉粒，每个糊粉粒中含有细小草酸钙簇晶。"}]},{"ID":"20240607130330-oemqsm3","Type":"NodeParagraph","Properties":{"id":"20240607130330-oemqsm3","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，加乙醇20ml，加热回流30分钟，滤过。取滤液数滴，点于白瓷板上，置紫外光灯（365nm）下观察，显蓝紫色荧光；另取滤液 2ml，加等量的 3％碳酸钠溶液，加热5 分钟，放冷，再加新制的重氮对硝基苯胺试液1～2滴，即显樱红色。"}]},{"ID":"20240607130330-0kbjvds","Type":"NodeParagraph","Properties":{"id":"20240607130330-0kbjvds","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"（3）取本品粗粉0.3g，加乙醇5ml,超声处理5 分钟，放置，取上清液作为供试品溶液。另取蛇床子素对照品，加乙醇制成每1ml 含1mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｇ薄层板上，以苯－醋酸乙酯（30:1）为展开剂，展开，取出，晾干，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240607130330-o8jkcrz","Type":"NodeParagraph","Properties":{"id":"20240607130330-o8jkcrz","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"含量测定"}]},{"ID":"20240607130330-nwbff8u","Type":"NodeParagraph","Properties":{"id":"20240607130330-nwbff8u","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 精密称取在五氧化二磷干燥器中减压干燥至恒重的本品粉末（过三号筛）1g，置具塞锥形瓶中，精密加入乙醇20ml，振摇后放置过夜，滤过，取续滤液，作为供试品溶液。另取蛇床子素对照品适量，精密称定，加乙醇制成每1ml 含1mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，精密吸取上述两种溶液各1μl，分别交叉点于同一硅胶Ｇ薄层板上，以苯－醋酸乙酯（30:1）为展开剂，展开，取出，晾干。照薄层色谱法（附录Ⅵ B薄层扫描法）进行荧光扫描，激发波长：λ=365nm，测量供试品与对照品荧光强度积分值，计算，即得。"}]},{"ID":"20240607130330-50a1f2a","Type":"NodeParagraph","Properties":{"id":"20240607130330-50a1f2a","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"本品含蛇床子素（C15H16O3）不得少于1.0％ 。"}]},{"ID":"20240607130330-soti1g1","Type":"NodeParagraph","Properties":{"id":"20240607130330-soti1g1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607130330-mgq6gbt","Type":"NodeParagraph","Properties":{"id":"20240607130330-mgq6gbt","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 归肾经。"}]},{"ID":"20240607130330-d51zsnx","Type":"NodeParagraph","Properties":{"id":"20240607130330-d51zsnx","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130330-3gxpd7y","Type":"NodeParagraph","Properties":{"id":"20240607130330-3gxpd7y","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 辛、苦，温；有小毒。"}]},{"ID":"20240607130330-ooed3cm","Type":"NodeParagraph","Properties":{"id":"20240607130330-ooed3cm","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130330-8dowuw6","Type":"NodeParagraph","Properties":{"id":"20240607130330-8dowuw6","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 温肾壮阳，燥湿，祛风，杀虫。用于阳痿，宫冷，寒湿带下，湿痹腰痛；外治外阴湿疹，妇人阴痒；滴虫性阴道炎。"}]},{"ID":"20240607130330-2d4w2ur","Type":"NodeParagraph","Properties":{"id":"20240607130330-2d4w2ur","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607130330-r3r3duv","Type":"NodeParagraph","Properties":{"id":"20240607130330-r3r3duv","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 3～9g。外用适量，多煎汤熏洗，或研末调敷。"}]},{"ID":"20240607130330-mf43dz0","Type":"NodeParagraph","Properties":{"id":"20240607130330-mf43dz0","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130330-5mdk0us","Type":"NodeParagraph","Properties":{"id":"20240607130330-5mdk0us","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607130330-5sdxey1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130330-5sdxey1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蛇床子"}]},{"ID":"20240607130330-wh5afxh","Type":"NodeParagraph","Properties":{"id":"20240607130330-wh5afxh","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130330-ce9dm14","Type":"NodeParagraph","Properties":{"id":"20240607130330-ce9dm14","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" Shé Chuánɡ Zǐ"}]},{"ID":"20240607130330-8730ykq","Type":"NodeParagraph","Properties":{"id":"20240607130330-8730ykq","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130330-or0bbro","Type":"NodeParagraph","Properties":{"id":"20240607130330-or0bbro","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 蛇米（《本经》），蛇珠（《吴普本草》），蛇粟（《广雅》），蛇床仁（《药性论》），蛇床实（《千金方》），气果、双肾子（《分类草药性》），额头花子（《浙江中药手册》），野茴香（江西《草药手册》）。"}]},{"ID":"20240607130330-dv42sou","Type":"NodeParagraph","Properties":{"id":"20240607130330-dv42sou","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607130330-hll4fda","Type":"NodeParagraph","Properties":{"id":"20240607130330-hll4fda","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607130330-xphymyd","Type":"NodeParagraph","Properties":{"id":"20240607130330-xphymyd","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130330-4y7lrcv","Type":"NodeParagraph","Properties":{"id":"20240607130330-4y7lrcv","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛇床"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。果实成熟，呈黄色时采收，割取全株，打落果实，晒干。"}]},{"ID":"20240607130330-kps4r6m","Type":"NodeParagraph","Properties":{"id":"20240607130330-kps4r6m","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607130330-0tpilfk","Type":"NodeParagraph","Properties":{"id":"20240607130330-0tpilfk","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 生于山坡草丛中，或田间、路旁。我国大部分地区均有分布。主产河北、山东、江苏、浙江等地。此外，广西、四川、陕西、山西亦产。"}]},{"ID":"20240607130330-5f9wbtp","Type":"NodeParagraph","Properties":{"id":"20240607130330-5f9wbtp","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607130330-e0do9ic","Type":"NodeParagraph","Properties":{"id":"20240607130330-e0do9ic","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 蛇床（《本经》），又名：盱、虺床（《尔雅》），马床（《广雅》），思益、绳毒、枣棘、墙蘼（《别录》），秃子花。"}]},{"ID":"20240607130330-rk7gd0k","Type":"NodeParagraph","Properties":{"id":"20240607130330-rk7gd0k","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"一年生草本，高30～80厘米。茎直立，圆柱形，有纵棱，疏生细柔毛。根生叶有柄，基部有短而阔的叶鞘；叶片卵形，2～3回羽状分裂，最终裂片线状披针形，先端尖锐；茎上部的叶和根生叶相似，但叶柄较短。复伞形花序顶生或侧生，伞梗10～25个，基部总苞片8～10，线形，具缘毛；小总苞片8～10，线形；萼齿不明显，花瓣5，白色，倒卵形，先端凹，而具狭窄内折的小舌；雄蕊5，与花瓣互生，花丝细长，花药椭圆形；子房下位，花柱2枚，花柱基部圆锥形。双悬果椭圆形，果棱成翅状，无毛。花期4～7月，果期6～8月。"}]},{"ID":"20240607130330-x3391gg","Type":"NodeParagraph","Properties":{"id":"20240607130330-x3391gg","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607130330-e8sqelb","Type":"NodeParagraph","Properties":{"id":"20240607130330-e8sqelb","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 干燥果实椭圆形，由2分果合成，长约2毫米。直径约1毫米，灰黄色，顶端有2枚向外弯曲的宿存花柱基；分果背面略隆起，有突起的脊线5条，接合面平坦，有2条棕色略突起的纵线，其中有一条浅色的线状物。果皮松脆。种子细小，灰棕色，有油性。气香，味辛凉而有麻舌感。以颗粒饱满、灰黄色、气味浓厚者为佳。"}]},{"ID":"20240607130330-shdkh5v","Type":"NodeParagraph","Properties":{"id":"20240607130330-shdkh5v","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607130330-hvrtwhp","Type":"NodeParagraph","Properties":{"id":"20240607130330-hvrtwhp","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 果实含挥发油1.3％，主要成分为蒎烯、莰烯、异戊酸龙脑酯、异龙脑。又含甲氧基欧芹酚，蛇床明素，异虎耳草素，佛手柑内酯，二氢山芹醇及其当归酸酯、乙酸酯和异戊酸酯，蛇床定，异丁酰氧基二氢山芹醇乙酸酯。根含蛇床明素、异虎耳草素、别欧芹属素乙、花椒毒酚、欧芹属素乙。"}]},{"ID":"20240607130330-rr749qn","Type":"NodeParagraph","Properties":{"id":"20240607130330-rr749qn","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607130330-8jdl68r","Type":"NodeParagraph","Properties":{"id":"20240607130330-8jdl68r","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" ①抗滴虫作用"}]},{"ID":"20240607130330-qkytcjk","Type":"NodeParagraph","Properties":{"id":"20240607130330-qkytcjk","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"以肝浸膏作为培养基，10％及20％蛇床子煎剂对阴道滴虫无杀灭作用或极弱，甲氧基欧芹酚体外亦无杀灭阴道滴虫的作用。虽也有报道对阴道滴虫有效者，但其结果的可靠性有待进一步证实。"}]},{"ID":"20240607130330-wjve7f1","Type":"NodeParagraph","Properties":{"id":"20240607130330-wjve7f1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②性激素样作用"}]},{"ID":"20240607130330-3z6tlbd","Type":"NodeParagraph","Properties":{"id":"20240607130330-3z6tlbd","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"蛇床子乙醇提取物，每天皮下注射于小白鼠连续32天，能延长动情期，缩短动情间期，并能使去势鼠出现动情期，卵巢及子宫重量增加，有类似性激素样作用，以前列腺、精囊、提肛肌增加重量的方法（小鼠）证明，蛇床子提取物有雄性激素样作用。对家兔阴道粘膜无腐蚀作用。"}]},{"ID":"20240607130330-0ljcsed","Type":"NodeParagraph","Properties":{"id":"20240607130330-0ljcsed","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240607130330-227q8g4","Type":"NodeParagraph","Properties":{"id":"20240607130330-227q8g4","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"蛇床子在试管内抗真菌作用的报道不一致，对鸡胚培养的新城病毒，能延长鸡胚生命6小时，放污水中能杀灭孑孓。"}]},{"ID":"20240607130330-sogwmrn","Type":"NodeParagraph","Properties":{"id":"20240607130330-sogwmrn","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607130330-u4e766k","Type":"NodeParagraph","Properties":{"id":"20240607130330-u4e766k","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，筛去泥砂，洗净，晒干。"}]},{"ID":"20240607130330-m2ntfqo","Type":"NodeParagraph","Properties":{"id":"20240607130330-m2ntfqo","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使蛇床须用浓蓝汁，百部草根自然汁，二味同浸三伏时，漉出日干，却用生地黄汁相拌蒸，从午至亥，日干用。\""}]},{"ID":"20240607130330-vznnn2l","Type":"NodeParagraph","Properties":{"id":"20240607130330-vznnn2l","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"蛇床，凡合药服食即按去皮壳取仁，微炒杀毒即不辣，作汤洗病则生使。\""}]},{"ID":"20240607130330-tzbttpv","Type":"NodeParagraph","Properties":{"id":"20240607130330-tzbttpv","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607130330-r8eqsyi","Type":"NodeParagraph","Properties":{"id":"20240607130330-r8eqsyi","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 入肾、脾经。"}]},{"ID":"20240607130330-vsrjhdp","Type":"NodeParagraph","Properties":{"id":"20240607130330-vsrjhdp","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肺、肾二经。\""}]},{"ID":"20240607130330-cmkwhy4","Type":"NodeParagraph","Properties":{"id":"20240607130330-cmkwhy4","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"手少阳、足厥阴经。\""}]},{"ID":"20240607130330-04cnp9l","Type":"NodeParagraph","Properties":{"id":"20240607130330-04cnp9l","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入脾、肾经。\""}]},{"ID":"20240607130330-f7lmozj","Type":"NodeParagraph","Properties":{"id":"20240607130330-f7lmozj","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130330-gnafhfe","Type":"NodeParagraph","Properties":{"id":"20240607130330-gnafhfe","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 辛苦。温。"}]},{"ID":"20240607130330-fyfjdk9","Type":"NodeParagraph","Properties":{"id":"20240607130330-fyfjdk9","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240607130330-vqrf066","Type":"NodeParagraph","Properties":{"id":"20240607130330-vqrf066","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛甘，无毒。\""}]},{"ID":"20240607130330-kemqqh1","Type":"NodeParagraph","Properties":{"id":"20240607130330-kemqqh1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"有小毒。\""}]},{"ID":"20240607130330-w6o8hl3","Type":"NodeParagraph","Properties":{"id":"20240607130330-w6o8hl3","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"④《本草正》：\"味微苦气辛，性温。\""}]},{"ID":"20240607130330-k72giax","Type":"NodeParagraph","Properties":{"id":"20240607130330-k72giax","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607130330-l7btf1a","Type":"NodeParagraph","Properties":{"id":"20240607130330-l7btf1a","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 下焦有湿热，或肾阴不足，相火易动以及精关不固者忌服。"}]},{"ID":"20240607130330-50nf00l","Type":"NodeParagraph","Properties":{"id":"20240607130330-50nf00l","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶牡丹、巴豆，贝母。\""}]},{"ID":"20240607130330-sc0xpmi","Type":"NodeParagraph","Properties":{"id":"20240607130330-sc0xpmi","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"肾家有火及下部有热者勿服。\""}]},{"ID":"20240607130330-zdar1eg","Type":"NodeParagraph","Properties":{"id":"20240607130330-zdar1eg","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"肾火易动，阳强精不固者勿服。\""}]},{"ID":"20240607130330-yy0ae9b","Type":"NodeParagraph","Properties":{"id":"20240607130330-yy0ae9b","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130330-r8xbo7q","Type":"NodeParagraph","Properties":{"id":"20240607130330-r8xbo7q","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 温肾助阳，祛风，燥湿，杀虫。治男子阳痿，阴囊湿痒，女子带下阴痒，子宫寒冷不孕，风湿痹痛，疥癣湿疮。"}]},{"ID":"20240607130330-hmdd58k","Type":"NodeParagraph","Properties":{"id":"20240607130330-hmdd58k","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主妇人阴中肿痛，男子阴痿、湿痒，除痹气，利关节，癫痫，恶创。\""}]},{"ID":"20240607130330-p316jnl","Type":"NodeParagraph","Properties":{"id":"20240607130330-p316jnl","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"温中下气，令妇人子脏热，男子阴强，好颜色，令人有子。\""}]},{"ID":"20240607130330-q2f7fgu","Type":"NodeParagraph","Properties":{"id":"20240607130330-q2f7fgu","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治男子、女人虚，湿痹，毒风，顽痛，去男子腰疼。浴男子阴，去风冷，大益阳事。主大风身痒，煎汤浴之瘥。疗齿痛及小儿惊痫。\""}]},{"ID":"20240607130330-b4vd18t","Type":"NodeParagraph","Properties":{"id":"20240607130330-b4vd18t","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治暴冷，暖丈夫阳气，助女人阴气，扑损瘀血，腰胯疼，阴汗湿癣，肢顽痹，赤白带下，缩小便。’"}]},{"ID":"20240607130330-x34dbty","Type":"NodeParagraph","Properties":{"id":"20240607130330-x34dbty","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑤《生草药性备要》：\"敷疮止痒，洗螆癞。\""}]},{"ID":"20240607130330-nt8gzwq","Type":"NodeParagraph","Properties":{"id":"20240607130330-nt8gzwq","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑥《长沙药解》：\"吹聤耳。\""}]},{"ID":"20240607130330-1pq337t","Type":"NodeParagraph","Properties":{"id":"20240607130330-1pq337t","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607130330-umpu7h3","Type":"NodeParagraph","Properties":{"id":"20240607130330-umpu7h3","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸剂。外用：煎水熏洗；或作坐药（栓剂）；或研末撒、调敷。"}]},{"ID":"20240607130330-x8mvwlh","Type":"NodeParagraph","Properties":{"id":"20240607130330-x8mvwlh","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607130330-bubzxav","Type":"NodeParagraph","Properties":{"id":"20240607130330-bubzxav","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" ①治阳不起：菟丝子、蛇床子、五味子各等分。上三味，末之，蜜丸如梧子。饮服三十丸，日三。（《千金方》）"}]},{"ID":"20240607130330-kp1lxgt","Type":"NodeParagraph","Properties":{"id":"20240607130330-kp1lxgt","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②治白带因寒湿者：蛇床子八两，山茱萸肉六两，南五味子四两，车前子三两，香附二两（俱用醋拌炒），枯白矾五钱，血鹿胶（火炙酒淬）五钱。共为细末，山药打糊丸梧子大。每早空心服五钱，白汤送下。（《方脉正宗》）"}]},{"ID":"20240607130330-xjvy01s","Type":"NodeParagraph","Properties":{"id":"20240607130330-xjvy01s","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③治妇人阴寒，温阴中坐药：蛇床子仁，一味末之，以白粉少许，和合相得，如枣大，绵裹纳之，自然温。（《金匮要略》蛇床子散）"}]},{"ID":"20240607130330-u88y3l1","Type":"NodeParagraph","Properties":{"id":"20240607130330-u88y3l1","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"④治妇人阴痒：蛇床子一两，白矾二钱。煎汤频洗。（《濒湖集简方》）"}]},{"ID":"20240607130330-au95j13","Type":"NodeParagraph","Properties":{"id":"20240607130330-au95j13","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑤治产后阴下脱：蛇床子一升，布裹炙熨之，亦治产后阴中痛。（《千金方》）"}]},{"ID":"20240607130330-bt8xio5","Type":"NodeParagraph","Properties":{"id":"20240607130330-bt8xio5","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑥治妇人子脏挺出：蛇床子一升，酢梅二七枚。水五升，煮取二升半，洗之，日十过。（《僧深集方》蛇床洗方）"}]},{"ID":"20240607130330-opbljxc","Type":"NodeParagraph","Properties":{"id":"20240607130330-opbljxc","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑦治滴虫性阴道炎：㈠蛇床子五钱，水煎，灌洗阴道。（江西《草药手册》）㈡蛇床子一两，黄柏三钱。以甘油明胶为基质做成（2克重）栓剂，每日阴道内置放一枚。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240607130330-r067tjm","Type":"NodeParagraph","Properties":{"id":"20240607130330-r067tjm","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑧治男子阴肿胀痛：蛇床子末，鸡于黄调敷之。（《永类钤方》）"}]},{"ID":"20240607130330-lpfam6e","Type":"NodeParagraph","Properties":{"id":"20240607130330-lpfam6e","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑨治阴囊湿疹：蛇床子五钱，煎水洗阴部。（江西《草药手册》）"}]},{"ID":"20240607130330-p3bidnx","Type":"NodeParagraph","Properties":{"id":"20240607130330-p3bidnx","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑩治小儿癣：蛇床实，捣末，和猪脂敷之。（《千金方》）"}]},{"ID":"20240607130330-8uq5qzh","Type":"NodeParagraph","Properties":{"id":"20240607130330-8uq5qzh","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑾治小儿恶疮：腻粉三分，黄连一分（去须）。蛇床子三分。上药捣细罗为散，每使时，先以温盐汤洗疮令净，拭干，以生油涂之。（《圣惠方》）"}]},{"ID":"20240607130330-915648p","Type":"NodeParagraph","Properties":{"id":"20240607130330-915648p","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⑿治小儿唇口边肥疮，亦治耳疮、头疮、瘑疮：白矾一两（烧灰），蛇床子一两。为末，干掺疮上。（《小儿卫生总微论方》）"}]},{"ID":"20240607130330-4ld30e6","Type":"NodeParagraph","Properties":{"id":"20240607130330-4ld30e6","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⒀治湿疹，过敏性皮炎，漆树过敏，手足癣：蛇床子、桉树叶、苦楝树皮、鸭脚木、苦参、地肤子各适量，煎水泡洗患处，每日二次。（江西《草药手册》）"}]},{"ID":"20240607130330-jradiyu","Type":"NodeParagraph","Properties":{"id":"20240607130330-jradiyu","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"⒁治冬月喉痹肿痛，不可下药者：蛇床子烧烟于瓶中，口含瓶嘴吸烟，其痰自出。（《圣惠方》）"}]},{"ID":"20240607130330-7m1setl","Type":"NodeParagraph","Properties":{"id":"20240607130330-7m1setl","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607130330-64ndoso","Type":"NodeParagraph","Properties":{"id":"20240607130330-64ndoso","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" ①治疗滴虫性阴道炎"}]},{"ID":"20240607130330-d0bzj0v","Type":"NodeParagraph","Properties":{"id":"20240607130330-d0bzj0v","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"先用10％蛇床子煎液500毫升冲洗阴道，然后放入0.5克的蛇床子阴道用片剂（由蛇床子的提取物制成）2片。连续治疗5～7天为一疗程。经近百例观察，多数经一疗程即可治愈，滴虫转阴，痒感消失，阴道清洁，白带消失或显着减少。此外，试用于非滴虫性阴道炎，也有减少白带分泌的作用。对有宫颈糜烂者，应用后未见不良反应。"}]},{"ID":"20240607130330-wg66mty","Type":"NodeParagraph","Properties":{"id":"20240607130330-wg66mty","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②治疗急性渗出性皮肤病"}]},{"ID":"20240607130330-qedw6th","Type":"NodeParagraph","Properties":{"id":"20240607130330-qedw6th","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"取蛇床子2两，用纱布包好，加水1500毫升，煮沸半小时；以棉垫浸透后拧半干，温敷局部，盖以油纸或塑料布包扎，使保持一定温湿度，一般可维持0.5至1小时。每日罨包4～6次。临床观察880例，多数治疗5～10天，渗出物明显减少，炎症消退。未发现任何副作用。亦可将蛇床子研成细末，用凡士林调成软膏，涂于患处，每日1～2次。观察15例婴儿湿疹（糜烂期），大多在用药第2天开始渗出减少，以后结痴而愈。"}]},{"ID":"20240607130330-g31xyf0","Type":"NodeParagraph","Properties":{"id":"20240607130330-g31xyf0","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607130330-vhd7hp0","Type":"NodeParagraph","Properties":{"id":"20240607130330-vhd7hp0","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"蛇床子，味苦平；《别录》辛甘无毒；今详其气味，当必兼温燥，阳也。故主妇人阴中肿痛，男子阴痿湿痒，除痹气，利关节.恶疮。《别录》温中下气，令妇人子脏热，男子阴强，令人有子。盖以苦能除湿，温能散寒，辛能润肾，甘能益脾，故能除妇人男子一切虚寒湿所生病。寒湿既除，则病去，性能益阳，故能已疾，而又有补益也。\""}]},{"ID":"20240607130330-jntwxa7","Type":"NodeParagraph","Properties":{"id":"20240607130330-jntwxa7","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"②《本草新编》：\"蛇床子，功用颇奇，内外俱可施治，而外治尤良。若欲修合丸散，用之于参、芪、归、地、山萸之中，实有利益，然亦宜于阴寒无火之人，倘阴虚火动者，服之非宜。\""}]},{"ID":"20240607130330-t3ua04f","Type":"NodeParagraph","Properties":{"id":"20240607130330-t3ua04f","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"蛇床子不独助男子壮火，且能散妇人郁抑，非妙达《本经》经义，不能得从治之法也。\""}]},{"ID":"20240607130330-sw1al34","Type":"NodeParagraph","Properties":{"id":"20240607130330-sw1al34","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"④《本草正义》：\"蛇床子，温暴刚烈之品，《本经》虽称其苦辛。然主治妇人阴中肿痛，男子阴痿湿痒，则皆主寒湿言之，必也肾阳不振，寒水弥漫，始可以为内服之品。甄权已谓其有毒，濒湖且谓蛇虺喜卧其下，食其子，盖产卑湿汗下之地，本系湿热之气所钟，其含毒质可知。观雷敦制法，以浓蓝汁同浸，再以生地黄汁拌蒸，无非监制其燥烈之性。故近今医籍，绝少用为内服之药，况市肆中以为贱品，皆不炮制，而可妄用以入煎剂乎。《本经》又谓除痹气，利关节，癫痫，则燥烈之性，本能通行经络，疏通关节，然非寒湿，及未经法制者，慎弗轻投。《本经》又主恶疮，则外治之药也。外疡湿热痛痒，浸淫诸疮，可作汤洗，可为末敷，收效甚捷，不得以贱品而忽之。\""}]},{"ID":"20240607130330-82frjf5","Type":"NodeParagraph","Properties":{"id":"20240607130330-82frjf5","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130330-a4hydyp","Type":"NodeParagraph","Properties":{"id":"20240607130330-a4hydyp","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607130330-6ylk1v2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130330-6ylk1v2","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蛇床子"}]},{"ID":"20240607130330-9zirib9","Type":"NodeParagraph","Properties":{"id":"20240607130330-9zirib9","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130330-w7kb0mh","Type":"NodeParagraph","Properties":{"id":"20240607130330-w7kb0mh","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" Shé Chuánɡ Zǐ"}]},{"ID":"20240607130330-2hghuij","Type":"NodeParagraph","Properties":{"id":"20240607130330-2hghuij","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130330-0c3enji","Type":"NodeParagraph","Properties":{"id":"20240607130330-0c3enji","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 蛇米、蛇珠、蛇粟、蛇床仁、蛇床实、气果、双肾子、癞头花子、 野茴香"}]},{"ID":"20240607130330-tq6arq9","Type":"NodeParagraph","Properties":{"id":"20240607130330-tq6arq9","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607130330-1j1a2zz","Type":"NodeParagraph","Properties":{"id":"20240607130330-1j1a2zz","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" Common Cnidium Fruit"}]},{"ID":"20240607130330-q785bmr","Type":"NodeParagraph","Properties":{"id":"20240607130330-q785bmr","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607130330-79t38ng","Type":"NodeParagraph","Properties":{"id":"20240607130330-79t38ng","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607130330-ubqetzc","Type":"NodeParagraph","Properties":{"id":"20240607130330-ubqetzc","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：蛇床子，生临淄川谷及田野。五月果实，阴干。"}]},{"ID":"20240607130330-wy9you5","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607130330-wy9you5","updated":"20240607130330"},"Children":[{"ID":"20240607130330-6me1j4o","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240607130330-6me1j4o","updated":"20240607130330"},"Children":[{"ID":"20240607130330-6gvxo5j","Type":"NodeParagraph","Properties":{"id":"20240607130330-6gvxo5j","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"陶弘景：蛇床，近道田野墟落间甚多。花、叶正似靡芜。"}]}]}]},{"ID":"20240607130330-kwyjfg5","Type":"NodeParagraph","Properties":{"id":"20240607130330-kwyjfg5","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》：《图经》云，蛇床，似小叶芎藭，花白，子如黍粒，黄白色。生下湿地， 今所在皆有，出扬州、襄州者良，采子暴干。"}]},{"ID":"20240607130330-9msiikq","Type":"NodeParagraph","Properties":{"id":"20240607130330-9msiikq","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：蛇床子，三月生，苗高三、二尺，叶青碎作丛似蒿枝，每枝上有花头 百余，结同一窠，似马芹类，四、"}]},{"ID":"20240607130330-3zjypns","Type":"NodeParagraph","Properties":{"id":"20240607130330-3zjypns","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130330-dsnkqwe","Type":"NodeParagraph","Properties":{"id":"20240607130330-dsnkqwe","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物蛇床的果实。"}]},{"ID":"20240607130330-tv9xzqr","Type":"NodeParagraph","Properties":{"id":"20240607130330-tv9xzqr","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cnidium monnieri(L.) Cuss[Selinum monnieria L.]"}]},{"ID":"20240607130330-e8pdlje","Type":"NodeParagraph","Properties":{"id":"20240607130330-e8pdlje","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋两季果实成熟时采收。摘下果实晒干；或割取地上部分晒干，打落果实，筛净或簸去杂质。"}]},{"ID":"20240607130330-9fcn9bf","Type":"NodeParagraph","Properties":{"id":"20240607130330-9fcn9bf","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607130330-x4i851r","Type":"NodeParagraph","Properties":{"id":"20240607130330-x4i851r","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于低山坡、田野、路旁、沟边、河边湿地。"}]},{"ID":"20240607130330-pwria2u","Type":"NodeParagraph","Properties":{"id":"20240607130330-pwria2u","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"资源分布：分布几遍全国各地。"}]},{"ID":"20240607130330-ogn6odg","Type":"NodeParagraph","Properties":{"id":"20240607130330-ogn6odg","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607130330-mnx595u","Type":"NodeParagraph","Properties":{"id":"20240607130330-mnx595u","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高20-80cm。根细长，圆锥形。茎直立或斜上，圆柱形，多分枝，中空，表面具深纵条纹，棱上常具短毛。根生叶具短柄，叶鞘短宽，边缘膜质，上部叶几全部简化鞘状；叶片轮廓卵形至三角状卵形，长3-8cm，宽2-5cm，二至三回三出式羽状全裂；末回裂片线形至线状披针形，长3-10mm，宽1-1.5mm，具小尖头，边缘及脉上粗糙。复伞形花序顶生或侧生，直径2-3cm；总苞片6-10，线形至线状披针形，长约5mm，边缘膜质，有短柔毛；伞辐8-25，长0.5-2cm；小总苞片多数，线形，长3-5mm，边缘膜质，具细睫毛；小侠形花序具花15-20；萼齿不明显；花瓣白色，先端具内折小舌片；花柱基略隆起，花柱长1-1.5mm，向下反曲。分生果长圆形，长1.3-3mm，宽1-2mm，横剖面的五角形，主棱5，均扩展成翅状，每棱槽中有油管1，合生面2，胚乳腹面平直。花期4-6月，果期5-7月。"}]},{"ID":"20240607130330-6o523dr","Type":"NodeParagraph","Properties":{"id":"20240607130330-6o523dr","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607130330-dc1lmog","Type":"NodeParagraph","Properties":{"id":"20240607130330-dc1lmog","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 性状鉴定：干燥果实椭圆形，由2分果合成，长约2mm。直径约1mm，灰黄色，顶端有2枚向外弯曲的宿存花按基；分果背面略隆起，有突起的脊线5条，接台面平坦，有2条棕色略突起的纵线，其中有一条浅色的线状物。果皮松脆。种子细小，灰棕色，有油性。气香，味辛 凉而有麻舌感。以颗粒饱满、灰黄色、气味浓厚者为佳。"}]},{"ID":"20240607130330-95fsr0f","Type":"NodeParagraph","Properties":{"id":"20240607130330-95fsr0f","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"显微鉴定： 分果横切面：外果皮为1列表皮细胞，常皱缩；外被角质层。中果皮为数列薄壁细胞，其间夹杂有条状网纹细胞，以维管柱内侧为多；油管6个，在接合面2个，背面每2个果棱间1个，油管扁长圆形，切向约至110μm，果成熟时油管壁仅为深棕色角质层；维管束柱位于果棱中部，木质部导管类圆形或多角形，并伴有少数纤维，韧皮部位于束柱两侧。内果皮为1-2列扁长形细胞，长短不一。种皮细胞常颓废，于接合面中央为数列细胞；有细小种脊维管束。内胚乳细胞含脂肪油及糊粉粒，糊粉粒中尚含细小簇晶。粉末：黄褐色。"}]},{"ID":"20240607130330-lcnjqrk","Type":"NodeParagraph","Properties":{"id":"20240607130330-lcnjqrk","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"1.外果皮表皮细胞表面观类方形或类多角形，垂周壁微波状深波状弯曲，表面有致密的角质纹理，气孔不等式，副卫细胞4个。"}]},{"ID":"20240607130330-k6tay0d","Type":"NodeParagraph","Properties":{"id":"20240607130330-k6tay0d","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2.网纹细胞类方形，类圆形或类长方形，壁稍厚，非木化或微木化，有条状或网状增厚。"}]},{"ID":"20240607130330-w6mir0g","Type":"NodeParagraph","Properties":{"id":"20240607130330-w6mir0g","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.油管碎片黄棕色或深红棕色，有的可见横隔，表面隐约可见细胞痕迹。"}]},{"ID":"20240607130330-rx9mtza","Type":"NodeParagraph","Properties":{"id":"20240607130330-rx9mtza","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.内果皮镶嵌层细胞壁有的呈连珠状增厚。此外有内胚乳细胞等。 本品以籽粒饱满、色黄绿、手搓之有辛辣香气者为佳。"}]},{"ID":"20240607130330-23z4ges","Type":"NodeParagraph","Properties":{"id":"20240607130330-23z4ges","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607130330-ubq9xl9","Type":"NodeParagraph","Properties":{"id":"20240607130330-ubq9xl9","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 果实含挥发油1．3%，主要成分为蒎烯(l-Pine-ne)、莰烯(l-Camphene)、异成酸龙 脑酯(Bornyl isovale-rate)、异龙脑(Isoborneol)。又含甲氧基欧芹酚(Ostho-le)，蛇床明素(Cnidimine，即 Edultin)，异虎耳草案(IsoPiBrpinelline)，佛手柑内酯，二氢山芹 醇(Dihydroo-roselol，Columbianetin)及其当归酸酯(ColuInbianadin)、乙酸酯(o-Acetyl columbianetin)；口异戊酸酯，蛇床定(Cnidiadiu)，异丁酰氧基二氢山芹醇乙酸酯。 根含蛇床阴素、异虎耳草素、别欧芹属素乙(Alloimperatorine)、花椒毒酚(Xanthotoxol)、 欧芹属素乙(Imperatorine)。果实含挥发油约1.3%，其中主成分为1蒎烯(l-pinene)、1-莰烯(l-camphene)、异缬草酸龙脑酯(bornylisovalerare)及7-甲氧基欧芹酚 (osthole)等。从果实醇提取物中除得到7-甲氧基欧芹酚外，尚得到棕榈酸(palmitic acid))、β-谷甾醇、香柑内酯(bergapten)、异虎耳草素(isopimpinellin)和花椒毒酚(xanthotoxol)等。据报道，我国商品蛇床子果实含哥伦比亚内酯(columbianadin)0.20%，圆白芷素(archangelicin)、食用白芷素(edultin)、香柑内酯、异虎耳草素、O-乙酰二氢欧山芹素(O-acetyl-columbianetin)、二氢欧山芹素(columbianetin)、O-异戊酰二氢欧山芹素(O-islvaleryl-columbianetin)、3'-异丁酰氧-O-乙酰二氢欧山芹素(3'-isobutyloxy-O-acetylcolumbianetin)及O-异丁酰二氢欧山芹素(O-isobutylcolumbianetin,cnidiadin)。 种子含香柑内酯、欧山芹素(orosclol)及食用白芷素。"}]},{"ID":"20240607130330-a3nds1p","Type":"NodeParagraph","Properties":{"id":"20240607130330-a3nds1p","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607130330-oaqgso6","Type":"NodeParagraph","Properties":{"id":"20240607130330-oaqgso6","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 1.抗滴虫作用：蛇床子中医外用治疗滴虫性阴道炎，但单味蛇床子的效果不佳或极弱，对其作用成分也未见报道。而复方蛇床子栓剂或洗剂则效果很好。"}]},{"ID":"20240607130330-lncrjr5","Type":"NodeParagraph","Properties":{"id":"20240607130330-lncrjr5","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2.性激素样作用：蛇床子乙醇提取物，每天皮下注射于小白鼠连续32天，能延长动情期，缩短动情间期，并能使去势鼠出现动情期，卵巢及子宫重量增加，有类似性激素样作用，以前列腺、精囊、提肛肌增加重量的方法（小鼠）证明，蛇床子提取物有雄性激素样作用。对家兔阴道粘膜无腐蚀作用。"}]},{"ID":"20240607130330-xzcz95x","Type":"NodeParagraph","Properties":{"id":"20240607130330-xzcz95x","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.平喘作用：3.1．蛇床子的总香豆素具有平喘作用，能使哮喘患者肺部哮鸣音明显减少或消失，并能显着增高呼气高峰流速值，改善肺部通气功能。其作用表现为扩张支气管平滑肌和改善肺通气功能作用。由此推测蛇床子总香豆素可能具有B－受体兴奋剂的作用，其平喘作用可能是通过激活平滑肌和细胞膜上的腺苷酸环化酶的调节亚单位（B－受体），使细胞内cAMP增加，从而导致细胞内贮存部位的蛋白质磷酸化，摄取Ca2+，使Ca2+进入结合状态，因而细胞内游离 Ca2+减少，平滑肌收缩蛋白系统兴奋性下降，肌肉松弛而实现。"}]},{"ID":"20240607130330-a68u0mx","Type":"NodeParagraph","Properties":{"id":"20240607130330-a68u0mx","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.2. 蛇床子总香豆素还具有一定的祛痰作用。"}]},{"ID":"20240607130330-zo2vu6f","Type":"NodeParagraph","Properties":{"id":"20240607130330-zo2vu6f","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.3．蛇床子总香豆素对豚鼠因吸入致痉剂所致实验性哮喘有明显保护作用，在体外能松弛组胺致痉的气管平滑肌，能加强豚鼠肺灌流量，由此可见该药具有较强的支气管扩张作用。"}]},{"ID":"20240607130330-dxdy5kn","Type":"NodeParagraph","Properties":{"id":"20240607130330-dxdy5kn","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.其它作用：近些年来，对蛇床子的研究较多，发现越来越多的药理作用。"}]},{"ID":"20240607130330-xbfpb1g","Type":"NodeParagraph","Properties":{"id":"20240607130330-xbfpb1g","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.1．抗真菌作用：蛇床子素、佛手柑内酯和异虎耳草素体外试验对发癣菌的须发癣菌有强的活性；花椒毒酚具有显着的抗霉菌作用。"}]},{"ID":"20240607130330-qkqx2ge","Type":"NodeParagraph","Properties":{"id":"20240607130330-qkqx2ge","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.2.抗心律失常： 蛇床子的水提物对氯仿诱发的小鼠室颤、氯化钙诱发的大鼠室颤及对鸟头碱诱发的大鼠心律失常均有预防作用，对后者还有明显的治疗效果。"}]},{"ID":"20240607130330-hxn1znx","Type":"NodeParagraph","Properties":{"id":"20240607130330-hxn1znx","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.3.局麻作用蛇床子的水提液对蟾蜍离体坐骨神经有阻滞麻醉作用；对豚鼠有浸润麻醉作用，并可被盐酸肾上腺素所增强；对家兔有椎管麻醉作用，但对家兔角膜没有表面麻醉作用。还可明显地延长戊巴比妥钠的致睡时间。"}]},{"ID":"20240607130330-zm7drt4","Type":"NodeParagraph","Properties":{"id":"20240607130330-zm7drt4","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.4.抗变态反应蛇床子素能较强地抑制小鼠被动皮肤过敏反应，对整体豚鼠组胺性喘息具有保护作用，对慢反应物质引起的豚鼠离体回肠收缩以及豚鼠离体回肠的Schultz-Dzle 反应呈明显的拮抗和阻断作用，并能抑制大鼠腹腔肥大细胞脱颗粒。以上作用均呈一定的剂量依赖关系。"}]},{"ID":"20240607130330-c802umf","Type":"NodeParagraph","Properties":{"id":"20240607130330-c802umf","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.5.抗诱变蛇床子水提物，通过Ames、离体细胞的姐妹染色单体互换及活体小鼠骨髓细胞染色体畸变和多染红细胞微核试验，表明了该药有较强的抗诱变作用。"}]},{"ID":"20240607130330-7pd1kh6","Type":"NodeParagraph","Properties":{"id":"20240607130330-7pd1kh6","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.6.杀孑孓将蛇床子投入污水中即可杀灭孑孓。"}]},{"ID":"20240607130330-upqqqqc","Type":"NodeParagraph","Properties":{"id":"20240607130330-upqqqqc","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607130330-s7dcryi","Type":"NodeParagraph","Properties":{"id":"20240607130330-s7dcryi","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，筛去泥抄，洗净，晒干。"}]},{"ID":"20240607130330-kv09k5j","Type":"NodeParagraph","Properties":{"id":"20240607130330-kv09k5j","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：凡使蛇床须用浓蓝汁，百部草根自然汁，二味同浸三伏时，漉出日干 ，却用生地黄汁相拌蒸，从午至亥，日干用。"}]},{"ID":"20240607130330-le67i4f","Type":"NodeParagraph","Properties":{"id":"20240607130330-le67i4f","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2.《日华子本草》：蛇床，凡合药服食即挼去皮壳取仁，微炒杀毒即不辣，作汤洗病则 生使。"}]},{"ID":"20240607130330-cv1ivz9","Type":"NodeParagraph","Properties":{"id":"20240607130330-cv1ivz9","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607130330-cxfdq2y","Type":"NodeParagraph","Properties":{"id":"20240607130330-cxfdq2y","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 1.取本品粉末2g，加乙醇20ml，加热回流30分钟，滤过。取滤液数滴，点于白瓷板上，置紫外灯(365nm)下观察，显蓝紫色荧光；另取滤液2ml，加等量3%碳酸钠溶液，加热5分钟，放冷，再加新制的重氮对硝基苯胺试液1-2滴，即显樱红色。"}]},{"ID":"20240607130330-7esgc3h","Type":"NodeParagraph","Properties":{"id":"20240607130330-7esgc3h","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2．取本品为分末0.5g，加入乙醚适量，加热提取5分钟，滤过，滤液浓缩至1ml，加7%盐酸羟胺甲醇液2-3滴，20%氢氧化钾乙醇液3滴，在水浴上微热，冷却后，加稀盐酸调节PH至3-4，再加1%三氯化铁乙醇溶液1-2滴，显紫色。（检查香豆素）"}]},{"ID":"20240607130330-c5owsgk","Type":"NodeParagraph","Properties":{"id":"20240607130330-c5owsgk","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607130330-uwschjk","Type":"NodeParagraph","Properties":{"id":"20240607130330-uwschjk","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 归脾；肾经"}]},{"ID":"20240607130330-y6trado","Type":"NodeParagraph","Properties":{"id":"20240607130330-y6trado","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130330-fzgbju0","Type":"NodeParagraph","Properties":{"id":"20240607130330-fzgbju0","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性温"}]},{"ID":"20240607130330-8sqcade","Type":"NodeParagraph","Properties":{"id":"20240607130330-8sqcade","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607130330-n2hppja","Type":"NodeParagraph","Properties":{"id":"20240607130330-n2hppja","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 下焦有湿热，或肾阴不足，相火易动以及精关不固者忌服。"}]},{"ID":"20240607130330-eys5o23","Type":"NodeParagraph","Properties":{"id":"20240607130330-eys5o23","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：恶牡丹、巴豆、贝母。"}]},{"ID":"20240607130330-5ho64p8","Type":"NodeParagraph","Properties":{"id":"20240607130330-5ho64p8","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：肾家有火及下部有热者勿服。"}]},{"ID":"20240607130330-h2pive0","Type":"NodeParagraph","Properties":{"id":"20240607130330-h2pive0","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：肾火易动，阳强精不固者勿服。"}]},{"ID":"20240607130330-nck5vv9","Type":"NodeParagraph","Properties":{"id":"20240607130330-nck5vv9","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130330-dg9831h","Type":"NodeParagraph","Properties":{"id":"20240607130330-dg9831h","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 温肾壮阳；燥湿杀虫；祛风止痒。主男子阳痿；阴囊湿痒；女子宫寒不孕；寒湿带下；阴痒肿痛；风湿痹痛；湿疮疥癣"}]},{"ID":"20240607130330-fh7cl9e","Type":"NodeParagraph","Properties":{"id":"20240607130330-fh7cl9e","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607130330-n9p3i1g","Type":"NodeParagraph","Properties":{"id":"20240607130330-n9p3i1g","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或入丸、散剂。外用：适量，煎汤熏洗；或做成坐药、栓剂；或研细末调敷。"}]},{"ID":"20240607130330-l7drj9j","Type":"NodeParagraph","Properties":{"id":"20240607130330-l7drj9j","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607130330-ythoae8","Type":"NodeParagraph","Properties":{"id":"20240607130330-ythoae8","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" ①治阳不起： 菟丝子、蛇床子、五味子各等分。上三味， 末之，蜜丸如梧子。 饮服三十丸， 日三。(《千金方》)②治白带因寒湿者： 蛇床干八两，山茱萸肉六两，南五味子四两，车前子三两，香附二两 (俱用醋拌炒)，枯白矾五钱，血鹿胶(火炙酒淬)五钱。共为细末，山药打糊丸梧子大。每旱空心服五钱，白汤送下。(《方脉正宗》)③治妇人阴寒，温阴中坐药： 蛇床子仁，一味末之，以白粉少许，和合相得，如枣大， 绵裹纳之，自然温。(《金匮要略》蛇床子散)④治妇人阴痒： 蛇床子一两，白矾二钱。煎汤频洗。(《濒湖集简方》)⑤治产后阴下脱： 蛇床子一升，布裹炙熨之，亦治产后阴中痛。 (《千金方》)⑥治妇人子脏挺出： 蛇床子一升，酢梅二七枚。水五升，煮取二升半，洗之，日十过。( 《僧深集方》蛇床洗方)⑦治滴虫性阴道炎： 一、蛇床子五钱，水煎，灌洗阴道。(江西《草药手册》)二、蛇床子 一两，黄柏三钱。 以甘油明胶为基质做成(2克重)栓剂， 每日阴道内置放一枚。(内蒙古 《中草药新医疗法资料选编》)⑧治男子阴肿胀痛： 蛇床子末， 鸡子黄调敷之。 (《永类钤方》)⑨治阴囊湿疹： 蛇床子五钱，煎水洗阴部。(江西《草药手册》)⑩治小儿癣： 蛇床实，捣末，和猪脂敷之。(《千金方》)11.治小儿恶疮： 腻粉三分，黄连一分(去须)， 蛇床子三分。上药捣细罗为散，每使时 ，先以温盐汤洗疮令净，拭干，以生油涂之。 (《圣惠方》)12.治小儿唇口边肥疮，亦治耳疮、头疮、瘑疮： 白矾一两(烧灰)，蛇床子一两。为末， 干掺疮上。(《小儿卫生总微论方》)13.治湿疹，过敏性皮炎，漆树过敏，手足癣： 蛇床子、桉树叶、苦楝树皮、鸭脚木、苦 参、地肤干各适量，煎水泡洗患处，每日二次。 (江西《草药手册》)14.治冬月喉痹肿痛，不可下药者： 蛇床子烧烟于瓶中，口含瓶嘴吸烟，其痰自出。 ( 《圣惠方》)"}]},{"ID":"20240607130330-dyblaxm","Type":"NodeParagraph","Properties":{"id":"20240607130330-dyblaxm","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607130330-ob9w6a6","Type":"NodeParagraph","Properties":{"id":"20240607130330-ob9w6a6","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 1.治疗滴虫性阴道炎： 先用10%蛇床子煎液500ml冲洗阴道，然后放入0.5 g的蛇床子阴道用片剂(由蛇床子的提取物制成)2片。连续治疗5-7天为一疗程。经近百例 观察，多数经一疗程即可治愈，滴虫转阴，痒感消失；阴道清洁，白带消失或显着减少。此外，试用于非滴虫性阴道炎，也有减少白带分泌的作用。对有宫颈糜烂者，应用后末见不良反应。"}]},{"ID":"20240607130330-o4c0l92","Type":"NodeParagraph","Properties":{"id":"20240607130330-o4c0l92","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2.治疗急性渗出性皮肤病：取蛇床子2两，用纱布包好，加水1500ml，煮沸半小时；以棉垫浸透后拧半干，温敷局部，盖以油纸或塑料布包扎，使保持一定温湿度，一般可维持0.5至 1小时。每日罨包4-6次。临床观察380例，多数治疗5-10天，渗出物明显减少，炎症消退。未发现任何副作用。亦可将蛇床于研成细末，用凡士林调成软膏，涂于患处，每日 1-2次。观察15例婴儿湿疹(糜烂期)，大多在用药第2天开始渗出减少，以后结痂而愈。"}]},{"ID":"20240607130330-czu2009","Type":"NodeParagraph","Properties":{"id":"20240607130330-czu2009","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607130330-7z3iggg","Type":"NodeParagraph","Properties":{"id":"20240607130330-7z3iggg","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 1.本草经疏》：蛇床子，味苦平；《别录》辛甘无毒；今详其气味，当 必兼温燥，阳也。故主妇人阴中肿痛，男子阴痿湿痒，除痹气，利关节，恶疮。《别录》温中下气，令妇人子服热，男子阴强，令人有子。盖以舌能除湿，温能散寒，辛能润肾，甘能益脾，故能除妇人男子一切虚寒湿所生病。寒湿既除，则病去，性能益阳，故能已疾，而又有补益也。"}]},{"ID":"20240607130330-k71vozi","Type":"NodeParagraph","Properties":{"id":"20240607130330-k71vozi","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"2.《本草新编》：蛇床子，功用颇奇，内外俱可施治，而外治尤良。若欲修合丸散，用之于参、芪、归、地、山萸之中，实有利益，然亦宜于阴寒无火之人，倘阴虚火动者，服之非宜。"}]},{"ID":"20240607130330-4g2cfh3","Type":"NodeParagraph","Properties":{"id":"20240607130330-4g2cfh3","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：蛇床子不独助男子壮火，且能散妇人郁抑，非妙达《本经》经义，不能得从治之法也。"}]},{"ID":"20240607130330-e31nuia","Type":"NodeParagraph","Properties":{"id":"20240607130330-e31nuia","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：蛇床子，温暴刚烈之品，《本经》虽称其苦辛。然主治妇人阴中肿痛 ，男子阴痿湿痒，则皆主寒湿言之，必也肾阳不振，寒水弥漫，始可以为内服之品。甄极已谓其有毒，濒湖且谓蛇虺喜卧其下，食其子，盖产卑湿汗下之地，本系湿热之气所钟，其含毒质可知。观雷斆制法，以浓蓝汁同浸，再以生地黄汁拌蒸，无非监制其燥烈之性。故近今医籍，绝少用为内服之药，况市肆中以为贱品，皆不炮制，而可妄用以入煎剂乎。《本经》又谓除痹气，利关节，癫痫，则燥烈之性，本能通行经络，疏通关节，然非寒湿，及未经法制者，慎弗轻投。《本经》又主恶疮，则外治之药也。外疡湿热痛痒，浸淫诸疮，可作汤洗，可为末敷，收效甚捷，不得以贱品而忽之。"}]},{"ID":"20240607130330-h4tusir","Type":"NodeParagraph","Properties":{"id":"20240607130330-h4tusir","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130330-dsgt8qm","Type":"NodeParagraph","Properties":{"id":"20240607130330-dsgt8qm","updated":"20240607130330"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607130332-snv79cd","Type":"NodeThematicBreak","Properties":{"id":"20240607130332-snv79cd"}},{"ID":"20240607130333-xhv8hvb","Type":"NodeParagraph","Properties":{"id":"20240607130333-xhv8hvb"}}]}