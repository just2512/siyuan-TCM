pe":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白敛 4-20240823102447-g8r1ylx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 607px;\" parent-style=\"width: 617px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823102532-podo962","Type":"NodeParagraph","Properties":{"id":"20240823102532-podo962","updated":"20240823103123"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 682px;","style":"width: 672px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白蔹 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白蔹 1-20240823103111-arhya6n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 672px;\" parent-style=\"width: 682px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 483px;","style":"width: 473px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白敛 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白敛 6-20240823102624-jnkixyp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 473px;\" parent-style=\"width: 483px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823102948-re7lmtv","Type":"NodeParagraph","Properties":{"id":"20240823102948-re7lmtv","updated":"20240823102957"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 573px;","style":"width: 563px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白蔹"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白蔹-20240823102948-q9f3xgk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 563px;\" parent-style=\"width: 573px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白敛 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白敛 7-20240823102736-nrzrrym.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613084115-l4gacb8","Type":"NodeThematicBreak","Properties":{"id":"20240613084115-l4gacb8"}},{"ID":"20240613084136-o1w4gmd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084136-o1w4gmd","updated":"20240613084328"},"Children":[{"Type":"NodeText","Data":"白敛《神农本草经》"}]},{"ID":"20240613084136-ijw58c0","Type":"NodeParagraph","Properties":{"id":"20240613084136-ijw58c0","updated":"20240613084136"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240613084136-5arhgu8","Type":"NodeParagraph","Properties":{"id":"20240613084136-5arhgu8","updated":"20240613084136"},"Children":[{"Type":"NodeText","Data":"主痈肿疽创，散结气，止痛除热，目中赤，小儿惊痫，温疟，女子阴中肿痛。一名免核，一名白草，生山谷。"}]},{"ID":"20240613084136-gy1phs2","Type":"NodeParagraph","Properties":{"id":"20240613084136-gy1phs2","updated":"20240613084136"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名白根，一名昆仑，生衡山，二月八月，采根暴干。"}]},{"ID":"20240613084136-x9l6pjb","Type":"NodeParagraph","Properties":{"id":"20240613084136-x9l6pjb","updated":"20240613084136"},"Children":[{"Type":"NodeText","Data":"案《说文》云：莶，白莶也，或作蔹。《毛诗》云：蔹蔓于野。陆玑疏云：蔹似栝楼，叶盛而细，其子正黑，如燕薁，不可食也，幽人谓之乌服，其茎叶鬻以哺牛，除热。《尔雅》云：萰，菟菄。郭璞云：未详。据玉篇云：菄，白蔹也。经云：一名菟核，核与荄声相近，即此矣。"}]},{"ID":"20240613084432-sw6iyfm","Type":"NodeThematicBreak","Properties":{"id":"20240613084432-sw6iyfm"}},{"ID":"20240613084433-991ll2y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084433-991ll2y","updated":"20240613084438"},"Children":[{"Type":"NodeText","Data":"白蔹《得配本草》"}]},{"ID":"20240613084433-11xws0k","Type":"NodeParagraph","Properties":{"id":"20240613084433-11xws0k","updated":"20240613084433"},"Children":[{"Type":"NodeText","Data":"代赭石为之使。反乌头。"}]},{"ID":"20240613084433-9iy8og5","Type":"NodeParagraph","Properties":{"id":"20240613084433-9iy8og5","updated":"20240613084433"},"Children":[{"Type":"NodeText","Data":"甘、苦、微寒。杀火毒，散结气。治阴肿带下，肠风痔 ，瘰 痈肿，生肌止痛。得藜芦为末，酒调敷痈肿。配白芨，治金疮出血。"}]},{"ID":"20240613084449-wof6pfd","Type":"NodeThematicBreak","Properties":{"id":"20240613084449-wof6pfd"}},{"ID":"20240613084450-f2cwwu7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084450-f2cwwu7","updated":"20240613084501"},"Children":[{"Type":"NodeText","Data":"白蔹《本草便读》"}]},{"ID":"20240613084450-iagdtwp","Type":"NodeParagraph","Properties":{"id":"20240613084450-iagdtwp","updated":"20240613084450"},"Children":[{"Type":"NodeText","Data":"苦能泻热．辛可疏邪．散结行瘀．止为性寒能解利．消痈敛口．皆因毒火未潜消．（白蔹．苦辛而寒．散热结．疏邪滞．并无酸敛之性．即本经亦无敛疮口之句．但云主治痈肿疮疽．散热止痛等语．则后人用之敛疮者．皆因火毒滞留营分．而肌肉不敛耳．）"}]},{"ID":"20240613084539-gqecxjt","Type":"NodeThematicBreak","Properties":{"id":"20240613084539-gqecxjt"}},{"ID":"20240613084540-t18k4qi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084540-t18k4qi","updated":"20240613084545"},"Children":[{"Type":"NodeText","Data":"白蔹《新修本草》"}]},{"ID":"20240613084540-y5ldhhx","Type":"NodeParagraph","Properties":{"id":"20240613084540-y5ldhhx","updated":"20240613084540"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平、微寒，无毒。主痈肿疽疮，散结气，止痛，除热目中赤，小儿惊痫，温疟杀火毒。一名兔核，一名白草，一名白根，一名昆仑。生衡山山谷。二月、八月采根，曝干。"}]},{"ID":"20240613084540-xiqsij5","Type":"NodeParagraph","Properties":{"id":"20240613084540-xiqsij5","updated":"20240613084540"},"Children":[{"Type":"NodeText","Data":"代赭为之使，反乌头。近道处处有之，作藤生，根如白芷，破片以竹穿之，晒干。生取根捣，敷痈肿亦效。"}]},{"ID":"20240613084540-7pmzdrz","Type":"NodeParagraph","Properties":{"id":"20240613084540-7pmzdrz","updated":"20240613084540"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240613084540-835d763","Type":"NodeParagraph","Properties":{"id":"20240613084540-835d763","updated":"20240613084552"},"Children":[{"Type":"NodeText","Data":"此根，似天门冬，一株下有十许根，皮赤黑，肉白，如芍药，殊不如白芷。"}]},{"ID":"20240613084716-ibnlkn8","Type":"NodeThematicBreak","Properties":{"id":"20240613084716-ibnlkn8"}},{"ID":"20240613084717-s2lfkdy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084717-s2lfkdy","updated":"20240613084722"},"Children":[{"Type":"NodeText","Data":"白蔹《医学入门》"}]},{"ID":"20240613084717-kgojni8","Type":"NodeParagraph","Properties":{"id":"20240613084717-kgojni8","updated":"20240613084717"},"Children":[{"Type":"NodeText","Data":"白蔹无毒苦甘平，敛诸疮口故留名，除热目赤杀火毒，女阴肿痛儿痫惊。"}]},{"ID":"20240613084717-ejqm4sx","Type":"NodeParagraph","Properties":{"id":"20240613084717-ejqm4sx","updated":"20240613084717"},"Children":[{"Type":"NodeText","Data":"主痈疽发背、疔疮、瘰 、痔漏、扑损刀箭汤火等疮，散结止痛生肌。《衍义》云∶白蔹、白芨，古今服饵方少用，多见于敛疮方中，二物多相而行。又除热目中赤，杀火毒，女子阴中肿痛，下赤白，小儿惊痫，瘟疟。"}]},{"ID":"20240613084717-khlis0t","Type":"NodeParagraph","Properties":{"id":"20240613084717-khlis0t","updated":"20240613084717"},"Children":[{"Type":"NodeText","Data":"代赭为使，反乌头。又一种赤蔹，功用与白蔹同，但表里俱赤耳。"}]},{"ID":"20240613084912-g4rjo7o","Type":"NodeThematicBreak","Properties":{"id":"20240613084912-g4rjo7o"}},{"ID":"20240613084914-73l6lc2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084914-73l6lc2","updated":"20240613084928"},"Children":[{"Type":"NodeText","Data":"白蔹《本草述钩元》"}]},{"ID":"20240613084914-ut2bfi7","Type":"NodeParagraph","Properties":{"id":"20240613084914-ut2bfi7","updated":"20240613084914"},"Children":[{"Type":"NodeText","Data":"根味苦辛兼甘，气微寒。苦则泄，辛则散，甘则缓，寒则除热。"}]},{"ID":"20240613084914-cmkuwmm","Type":"NodeParagraph","Properties":{"id":"20240613084914-cmkuwmm","updated":"20240617115425"},"Children":[{"Type":"NodeText","Data":"主痈肿疽疮，散结止痛，除血分热，治目中赤，女子阴中肿痛，杀火毒，疗刀箭疮，及扑损生肌止痛。白蔹得金气，与白芨相须而行。得白芨、红药子，加朱砂、雄黄、乳、没、脑、麝，为傅痈疽、止毒散毒之要药。一切痈肿，白蔹、赤小豆、䒽草为末，鸡子白调涂之。风痹筋急肿痛，屈转易常处。白蔹二分，熟附子一分，为末。每酒服半刀圭，日二。以身中热行为候，十日便觉。忌猪肉冷水。"}]},{"ID":"20240613084849-bv0b3gq","Type":"NodeThematicBreak","Properties":{"id":"20240613084849-bv0b3gq"}},{"ID":"20240613084850-za3kt1n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084850-za3kt1n","updated":"20240613084854"},"Children":[{"Type":"NodeText","Data":"白蔹《本草撮要》"}]},{"ID":"20240613084850-2jzvq32","Type":"NodeParagraph","Properties":{"id":"20240613084850-2jzvq32","updated":"20240613084850"},"Children":[{"Type":"NodeText","Data":"味苦．入足少阳厥阴经．功专清上逆之火．泄下郁之热．以及阴肿带下．得白芷治诸物哽咽．得附子治风痹筋急．同丹皮或半夏为末酒服．治箭镞不出．同白芨为末．敛疮口．汤火烂伤．以末敷之效．反乌头．"}]},{"ID":"20240613084835-ays9a0n","Type":"NodeThematicBreak","Properties":{"id":"20240613084835-ays9a0n"}},{"ID":"20240613084836-44wwqwk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084836-44wwqwk","updated":"20240613084842"},"Children":[{"Type":"NodeText","Data":"白蔹《证类本草》"}]},{"ID":"20240613084836-5t6pea8","Type":"NodeParagraph","Properties":{"id":"20240613084836-5t6pea8","updated":"20240613084836"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平、微寒，无毒。主痈肿疽疮，散结气，止痛，除热，目中赤，小儿惊痫，温疟，女子阴中肿痛，下赤白，杀火毒。一名菟核，一名白草，一名白根，一名昆仑。生衡山山谷。二月、八月采根，曝干。（代赭为之使，反乌头。）"}]},{"ID":"20240613084836-ygm3ye2","Type":"NodeParagraph","Properties":{"id":"20240613084836-ygm3ye2","updated":"20240613084836"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处有之。作藤生，根如白芷，破片以竹穿之，日干。生取根捣，敷痈肿亦效。唐本注云∶此根似天门冬，一株下有十许根，皮赤黑，肉白，如芍药，殊不似白芷。臣禹锡等谨按蜀本图经云∶蔓生，枝端有五叶。今所在有之。药性论云∶白蔹使，杀火毒，味苦，平，有毒，恶乌头。能主气壅肿。用赤小豆、 草为末，鸡子白调涂一切肿毒，治面上疮。子治温疟，主寒热，结壅热肿。日华子云∶止惊邪，发背，瘰 ，肠风痔 ，刀箭疮，扑损，温热疟疾，血痢，汤火疮，生肌止痛。"}]},{"ID":"20240613084836-q7zc0o5","Type":"NodeParagraph","Properties":{"id":"20240613084836-q7zc0o5","updated":"20240613084836"},"Children":[{"Type":"NodeText","Data":"图经曰∶白蔹，生衡山山谷，今江淮州郡及荆、襄、怀、孟、商、齐诸州皆有之。二月生苗，多在林中作蔓，赤茎，叶如小桑。五月开花，七月结实。根如鸡鸭卵，三、五枚同窠，皮赤黑，肉白。二月、八月采根，破片曝干。今医治风，金疮及面药方多用之。濠州有一种赤蔹，功用与白蔹同，花实亦相类，但表里俱赤耳。"}]},{"ID":"20240613084836-qdafl2v","Type":"NodeParagraph","Properties":{"id":"20240613084836-qdafl2v","updated":"20240613084836"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治疔疮，以水调白蔹末敷疮上。外台秘要备急治汤火灼烂，用白蔹末敷之。肘后方∶治发背，白蔹末敷并良。"}]},{"ID":"20240613084836-cvk3uhj","Type":"NodeParagraph","Properties":{"id":"20240613084836-cvk3uhj","updated":"20240613084836"},"Children":[{"Type":"NodeText","Data":"衍义曰∶白蔹、白芨，古今服饵方，少有用者，多见于敛疮方中。二物多相须而行。"}]},{"ID":"20240613085017-fk27m4v","Type":"NodeThematicBreak","Properties":{"id":"20240613085017-fk27m4v"}},{"ID":"20240613085018-jef1c1z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085018-jef1c1z","updated":"20240613085027"},"Children":[{"Type":"NodeText","Data":"白蔹《本草图经》"}]},{"ID":"20240613085021-b3r2vt7","Type":"NodeParagraph","Properties":{"id":"20240613085021-b3r2vt7"},"Children":[{"Type":"NodeText","Data":"白蔹，今江淮州郡及荆、襄、怀、孟、商、齐诸州皆有之。二月生苗，多在林中，作蔓，赤茎，叶如小桑，五月开花，七月结实，根如鸡鸭卵，三、五枚同窠，皮赤黑，肉白。濠州有一种赤蔹"}]},{"ID":"20240613084824-hzdi7hx","Type":"NodeThematicBreak","Properties":{"id":"20240613084824-hzdi7hx"}},{"ID":"20240613084825-9e9i733","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084825-9e9i733","updated":"20240613084830"},"Children":[{"Type":"NodeText","Data":"白蔹《本草求真》"}]},{"ID":"20240613084825-1fle9dp","Type":"NodeParagraph","Properties":{"id":"20240613084825-1fle9dp","updated":"20240613084825"},"Children":[{"Type":"NodeText","Data":"（蔓草）散肝脾湿热内结"}]},{"ID":"20240613084825-9t8x7f2","Type":"NodeParagraph","Properties":{"id":"20240613084825-9t8x7f2","updated":"20240613084825"},"Children":[{"Type":"NodeText","Data":"白蔹（专入肝脾）。敷肿疮疡。清热解毒。散结止痛。久为外科所用要药。然目赤惊痫。温疟阴肿。滞下淋浊失精。金疮生血。凡因湿热湿毒而成者。何一不可以为内科之用。如金匮薯蓣丸。用此以解风气百疾蕴蓄。（张璐曰。其汤全以桂枝汤和营散邪。合理中汤兼理药误。君以薯蓣。大理脾肺。毫不及乎补益肾肝。）又书载同地肤子。则可以治淋浊失精。同白芨则可以敛金疮失血。（故曰血饮。）同甘草则可以解野狼毒之毒。岂尽痈肿解毒而已哉？但此味辛（入肺）主散。味苦主降。味甘主缓。故止可以散结解热。若胃气虚弱。痈疽已溃者。均非所宜。蔓赤茎有五叶。根如卵。长有三五枚同窠。皮黑肉白。代赭石为使。反乌头。色赤为赤蔹。功用皆同。"}]},{"ID":"20240613084813-y9tkku7","Type":"NodeThematicBreak","Properties":{"id":"20240613084813-y9tkku7"}},{"ID":"20240613084815-56w01qw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084815-56w01qw","updated":"20240613084819"},"Children":[{"Type":"NodeText","Data":"白蔹《本经逢原》"}]},{"ID":"20240613084815-op04c8y","Type":"NodeParagraph","Properties":{"id":"20240613084815-op04c8y","updated":"20240613084815"},"Children":[{"Type":"NodeText","Data":"苦甘辛微寒，小毒。反乌附。解野狼毒毒。"}]},{"ID":"20240613084815-w7sb1y5","Type":"NodeParagraph","Properties":{"id":"20240613084815-w7sb1y5","updated":"20240613084815"},"Children":[{"Type":"NodeText","Data":"《本经》主痈肿疽疮，散结气止痛，除热、目中赤，小儿惊痫，温疟，女子阴中肿痛，带下赤白。"}]},{"ID":"20240613084815-5d71wod","Type":"NodeParagraph","Properties":{"id":"20240613084815-5d71wod","updated":"20240613084815"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"白蔹性寒。解毒，敷肿疡疮有解散之功，以其味辛也。但阴疽色淡不起，胃气弱者，非其所宜。《本经》治目赤、惊痫、温疟，非取其解热毒之力欤。治阴肿带下，非取其去湿热之力欤。《金匮》薯蓣丸用之，专取其辛凉散结，以解风气百疾之蕴蓄也。世医仅知痈肿解毒之用，陋哉。同地肤子治淋浊失精，同白芨治金疮失血，同甘草解野狼毒之毒，其辛散之功可知。而痈疽已溃者不宜用。"}]},{"ID":"20240613084803-ogzr8zt","Type":"NodeThematicBreak","Properties":{"id":"20240613084803-ogzr8zt"}},{"ID":"20240613084805-is8l3nk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084805-is8l3nk","updated":"20240613084809"},"Children":[{"Type":"NodeText","Data":"白蔹《本草从新》"}]},{"ID":"20240613084805-z8txlob","Type":"NodeParagraph","Properties":{"id":"20240613084805-z8txlob","updated":"20240613084805"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻火散结．"}]},{"ID":"20240613084805-hmaowkd","Type":"NodeParagraph","Properties":{"id":"20240613084805-hmaowkd","updated":"20240613084805"},"Children":[{"Type":"NodeText","Data":"苦能泄．辛能散．甘能缓中．寒能除热．杀火毒．散结气．生肌止痛．治痈疽疮肿．面上疮．金疮扑损．（箭镞不出者、同丹皮或半夏为末、酒服．）敛疮方多用之．（故名、每与白芨相须．）搽冻耳．（同黄柏末、油调．）赤蔹功用皆同．（郑奠一曰∶能治温疟血痢、肠风痔漏、赤白带下．）蔓赤．枝有五叶．根如卵而长．三五枚同窠．皮乌肉白．反乌头．"}]},{"ID":"20240613084751-w0u3emo","Type":"NodeThematicBreak","Properties":{"id":"20240613084751-w0u3emo"}},{"ID":"20240613084752-6epnecp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084752-6epnecp","updated":"20240613084756"},"Children":[{"Type":"NodeText","Data":"白蔹《本草备要》"}]},{"ID":"20240613084752-ag3bikf","Type":"NodeParagraph","Properties":{"id":"20240613084752-ag3bikf","updated":"20240613084752"},"Children":[{"Type":"NodeText","Data":"泻火，散结"}]},{"ID":"20240613084752-nky5x3o","Type":"NodeParagraph","Properties":{"id":"20240613084752-nky5x3o","updated":"20240613084752"},"Children":[{"Type":"NodeText","Data":"苦能泄，辛能散，甘能缓，寒能除热。杀火毒，散结气，生肌止痛。"}]},{"ID":"20240613084752-bvl7e2x","Type":"NodeParagraph","Properties":{"id":"20240613084752-bvl7e2x","updated":"20240613084752"},"Children":[{"Type":"NodeText","Data":"治痈疽疮肿，面上 疮，金疮扑损（箭镞不出者，同丹皮或半夏为末，酒服），敛疮方多用之（故名，每与白芨相须），搽冻耳（同黄柏末油调）。"}]},{"ID":"20240613084752-36cv3se","Type":"NodeParagraph","Properties":{"id":"20240613084752-36cv3se","updated":"20240613084752"},"Children":[{"Type":"NodeText","Data":"蔓赤，枝有五叶，根如卵而长，三五枝同窠，皮乌肉白。一种赤蔹，功用皆用（郑奠一曰∶能治温疟血痢，肠风痔 ，赤白带下）。"}]},{"ID":"20240613084735-6x3prec","Type":"NodeThematicBreak","Properties":{"id":"20240613084735-6x3prec"}},{"ID":"20240613084737-p0umlcz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084737-p0umlcz","updated":"20240613084741"},"Children":[{"Type":"NodeText","Data":"白蔹白芨《本草衍义》"}]},{"ID":"20240613084737-s1k1ubn","Type":"NodeParagraph","Properties":{"id":"20240613084737-s1k1ubn","updated":"20240613084737"},"Children":[{"Type":"NodeText","Data":"古今服饵方少有用者，多见于敛疮方中。二物多相须而行。"}]},{"ID":"20240613084703-ouy19nf","Type":"NodeThematicBreak","Properties":{"id":"20240613084703-ouy19nf"}},{"ID":"20240613084704-mlivmhq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084704-mlivmhq","updated":"20240613084709"},"Children":[{"Type":"NodeText","Data":"白蔹《增广和剂局方药性总论》"}]},{"ID":"20240613084704-vj86o96","Type":"NodeParagraph","Properties":{"id":"20240613084704-vj86o96","updated":"20240613084704"},"Children":[{"Type":"NodeText","Data":"味苦甘，平、微寒，无毒。主痈肿疽疮，散结气，止痛，除热，目中赤，小儿惊痫，疟血邪，发背，瘰 ，肠风，痔 ，刀箭疮，扑损，温热疟疾，血痢，汤火疮，生肌止痛。代赭为之使。反∶乌头。"}]},{"ID":"20240613084646-2rj9px1","Type":"NodeThematicBreak","Properties":{"id":"20240613084646-2rj9px1"}},{"ID":"20240613084648-btsn04o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084648-btsn04o","updated":"20240613084655"},"Children":[{"Type":"NodeText","Data":"白蔹《本草纲目》"}]},{"ID":"20240613084648-yxi6w3i","Type":"NodeParagraph","Properties":{"id":"20240613084648-yxi6w3i","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"「释名」白草、白根、兔核、猫儿卵、昆仑。"}]},{"ID":"20240613084648-5ilg56s","Type":"NodeParagraph","Properties":{"id":"20240613084648-5ilg56s","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、平、无毒。"}]},{"ID":"20240613084648-pwk0l6t","Type":"NodeParagraph","Properties":{"id":"20240613084648-pwk0l6t","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613084648-zw7vtvg","Type":"NodeParagraph","Properties":{"id":"20240613084648-zw7vtvg","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"1、疔疮初起。用水调白蔹末涂搽。"}]},{"ID":"20240613084648-g8cn5uz","Type":"NodeParagraph","Properties":{"id":"20240613084648-g8cn5uz","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"2、一切痈肿。用白蔹、赤小豆、网草，共研为末，加鸡蛋白调匀涂搽。又方：用白蔹二分、藜芦一分，共研为末，酒调涂搽。一天三次。"}]},{"ID":"20240613084648-mlo5onq","Type":"NodeParagraph","Properties":{"id":"20240613084648-mlo5onq","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"3、脸上粉刺。用白蔹二分、藜芦一分，共研末，酒调涂搽。一天三次。"}]},{"ID":"20240613084648-gwcf0f9","Type":"NodeParagraph","Properties":{"id":"20240613084648-gwcf0f9","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"4、冻耳成疮。用白蔹、黄蘖，等分为末，加生油调匀搽耳。"}]},{"ID":"20240613084648-xk09ssj","Type":"NodeParagraph","Properties":{"id":"20240613084648-xk09ssj","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"5、汤火伤。用白蔹研末敷涂。"}]},{"ID":"20240613084648-8krs175","Type":"NodeParagraph","Properties":{"id":"20240613084648-8krs175","updated":"20240613084648"},"Children":[{"Type":"NodeText","Data":"6、风痹筋急。用白蔹二分、熟附子一分，共研为末。每服一小撮，酒送下。一天服二次。以身中暖和为度。忌食猪肉、冷水。"}]},{"ID":"20240613084636-oct3vzv","Type":"NodeThematicBreak","Properties":{"id":"20240613084636-oct3vzv"}},{"ID":"20240613084637-pdhzwe7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084637-pdhzwe7","updated":"20240613084641"},"Children":[{"Type":"NodeText","Data":"白蔹《本草择要纲目》"}]},{"ID":"20240613084637-yrsmf3o","Type":"NodeParagraph","Properties":{"id":"20240613084637-yrsmf3o","updated":"20240613084637"},"Children":[{"Type":"NodeText","Data":"【根】【气味】"}]},{"ID":"20240613084637-f6id2aw","Type":"NodeParagraph","Properties":{"id":"20240613084637-f6id2aw","updated":"20240613084637"},"Children":[{"Type":"NodeText","Data":"苦平无毒．"}]},{"ID":"20240613084637-gjyut8c","Type":"NodeParagraph","Properties":{"id":"20240613084637-gjyut8c","updated":"20240613084637"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240613084637-wb24iv2","Type":"NodeParagraph","Properties":{"id":"20240613084637-wb24iv2","updated":"20240613084637"},"Children":[{"Type":"NodeText","Data":"痈肿疽疮．散结气．止痛除热．目中赤．小儿惊痫温疟．女子阴中肿痛．带下赤白．杀火毒．治发背瘰 ．面上 疮．肠风痔漏．血痢．刀箭疮扑损．生肌止痛．解野狼毒毒．又生取根捣敷痈肿有效．今医治风及金疮多用之．往往与白芨相须而用．"}]},{"ID":"20240613084506-nfldvkn","Type":"NodeThematicBreak","Properties":{"id":"20240613084506-nfldvkn"}},{"ID":"20240613084507-9ese3oz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084507-9ese3oz","updated":"20240613084511"},"Children":[{"Type":"NodeText","Data":"白蔹《长沙药解》"}]},{"ID":"20240613084507-0ehecjw","Type":"NodeParagraph","Properties":{"id":"20240613084507-0ehecjw","updated":"20240613084507"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】白敛。味苦平。主痈肿疽创，散结气，止痛除热，目中赤，小儿惊痫，温疟，女子阴中肿痛。一名免核，一名白草，生山谷。"}]},{"ID":"20240613084507-42nyhs9","Type":"NodeParagraph","Properties":{"id":"20240613084507-42nyhs9","updated":"20240613084507"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，入足少阳胆、足厥阴肝经。清少阳上逆之火，泻厥阴下郁之热。"}]},{"ID":"20240613084507-nxc38u8","Type":"NodeParagraph","Properties":{"id":"20240613084507-nxc38u8","updated":"20240613084507"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在薯蓣。"},{"Type":"NodeText","Data":"用之治虚劳，风气百疾，以其泻肝胆之郁热也。"}]},{"ID":"20240613084507-s2wqqj8","Type":"NodeParagraph","Properties":{"id":"20240613084507-s2wqqj8","updated":"20240613084507"},"Children":[{"Type":"NodeText","Data":"白蔹苦寒疏利，入肝胆之经，散结滞而清郁热。其诸主治，消瘰疬，平痔漏，清赤目，止血痢，除酒皻，灭粉刺，理痈肿，收带浊，解女子阴中肿痛。"}]},{"ID":"20240613084335-z8p8k2z","Type":"NodeThematicBreak","Properties":{"id":"20240613084335-z8p8k2z"}},{"ID":"20240613084336-xtvmf6v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084336-xtvmf6v","updated":"20240613084340"},"Children":[{"Type":"NodeText","Data":"白蔹《本草经集注》"}]},{"ID":"20240613084336-kjr8u6n","Type":"NodeParagraph","Properties":{"id":"20240613084336-kjr8u6n","updated":"20240613084336"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平、微寒，无毒。主治痈肿疽疮，散结气，止痛，除热，目中赤，小儿惊痫。"}]},{"ID":"20240613084336-aqx93zs","Type":"NodeParagraph","Properties":{"id":"20240613084336-aqx93zs","updated":"20240613084336"},"Children":[{"Type":"NodeText","Data":"温疟，女子阴中肿痛。下赤白，杀火毒。一名菟核，一名白草，一名白根，一名昆仑。生衡山山谷。二月、八月采根，曝干。（代赭为之使，反乌头。）"}]},{"ID":"20240613084336-aknxcxq","Type":"NodeParagraph","Properties":{"id":"20240613084336-aknxcxq","updated":"20240613084336"},"Children":[{"Type":"NodeText","Data":"近道处处有之，作藤生，根如白芷，破片以竹穿之，日干。生取根捣，敷痈肿亦效。"}]},{"ID":"20240613084115-it86xw3","Type":"NodeThematicBreak","Properties":{"id":"20240613084115-it86xw3"}},{"ID":"20240613084116-to2ltam","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084116-to2ltam","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"《中国药典》：白蔹"}]},{"ID":"20240613084116-g204cfu","Type":"NodeParagraph","Properties":{"id":"20240613084116-g204cfu","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613084116-wcj4zzw","Type":"NodeParagraph","Properties":{"id":"20240613084116-wcj4zzw","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" Bái Liǎn"}]},{"ID":"20240613084116-uhomtg9","Type":"NodeParagraph","Properties":{"id":"20240613084116-uhomtg9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613084116-4okb6cw","Type":"NodeParagraph","Properties":{"id":"20240613084116-4okb6cw","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 山地瓜、野红薯、山葡萄秧、白根、五爪藤"}]},{"ID":"20240613084116-k3vdl4d","Type":"NodeParagraph","Properties":{"id":"20240613084116-k3vdl4d","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613084116-2gfizlk","Type":"NodeParagraph","Properties":{"id":"20240613084116-2gfizlk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" RADIX AMPELOPSIS"}]},{"ID":"20240613084116-3fopkg8","Type":"NodeParagraph","Properties":{"id":"20240613084116-3fopkg8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613084116-160u57m","Type":"NodeParagraph","Properties":{"id":"20240613084116-160u57m","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 本品为葡萄科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白蔹"},{"Type":"NodeText","Data":"Ampelopsis japonica （Thunb.）Makino 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。春、秋二季采挖，除去泥沙及细根，切成纵瓣或斜片，晒干。"}]},{"ID":"20240613084116-u2m0rlf","Type":"NodeParagraph","Properties":{"id":"20240613084116-u2m0rlf","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613084116-st7opb6","Type":"NodeParagraph","Properties":{"id":"20240613084116-st7opb6","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 本品纵瓣呈长圆形或近纺锤形，长4～10cm，直径1～2cm；切面周边常向内卷曲，中部有1凸起的棱线；外皮红棕色或红褐色，有纵皱纹、细横纹及横长皮孔，易层层脱落，脱落处呈淡红棕色。斜片呈卵圆形，长2。5～5cm，宽2～3cm，切面类白色或浅红棕色，可见放射状纹理，周边较厚，微翘起或略弯曲。体轻，质硬脆，易折断，折断时，有粉尘飞出。气微，味甘。"}]},{"ID":"20240613084116-4knyzg5","Type":"NodeParagraph","Properties":{"id":"20240613084116-4knyzg5","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613084116-dh35nys","Type":"NodeParagraph","Properties":{"id":"20240613084116-dh35nys","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，润透，切厚片，晒干。"}]},{"ID":"20240613084116-u9084i5","Type":"NodeParagraph","Properties":{"id":"20240613084116-u9084i5","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613084116-44ierxq","Type":"NodeParagraph","Properties":{"id":"20240613084116-44ierxq","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 归心、胃经。"}]},{"ID":"20240613084116-wtwftpe","Type":"NodeParagraph","Properties":{"id":"20240613084116-wtwftpe","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613084116-p0kibps","Type":"NodeParagraph","Properties":{"id":"20240613084116-p0kibps","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 苦，微寒。"}]},{"ID":"20240613084116-xie2naz","Type":"NodeParagraph","Properties":{"id":"20240613084116-xie2naz","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613084116-8r6jpex","Type":"NodeParagraph","Properties":{"id":"20240613084116-8r6jpex","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 不宜与乌头类药材同用。"}]},{"ID":"20240613084116-7nnd5ap","Type":"NodeParagraph","Properties":{"id":"20240613084116-7nnd5ap","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613084116-i7zddeb","Type":"NodeParagraph","Properties":{"id":"20240613084116-i7zddeb","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 清热解毒，消痈散结。用于痈疽发背，疔疮，瘰疠，水火烫伤。"}]},{"ID":"20240613084116-6gewnj6","Type":"NodeParagraph","Properties":{"id":"20240613084116-6gewnj6","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613084116-7ht36dw","Type":"NodeParagraph","Properties":{"id":"20240613084116-7ht36dw","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 4.5～9g；外用适量，煎汤洗或研成极细粉敷患处。"}]},{"ID":"20240613084116-svxmp3t","Type":"NodeParagraph","Properties":{"id":"20240613084116-svxmp3t","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613084116-mcswjmc","Type":"NodeParagraph","Properties":{"id":"20240613084116-mcswjmc","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613084116-c4qtfs7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084116-c4qtfs7","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白蔹"}]},{"ID":"20240613084116-ta5o1a8","Type":"NodeParagraph","Properties":{"id":"20240613084116-ta5o1a8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613084116-jpu0joy","Type":"NodeParagraph","Properties":{"id":"20240613084116-jpu0joy","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" Bái Liǎn"}]},{"ID":"20240613084116-ss1evlm","Type":"NodeParagraph","Properties":{"id":"20240613084116-ss1evlm","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613084116-xdx33vr","Type":"NodeParagraph","Properties":{"id":"20240613084116-xdx33vr","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 白根、昆仑（《别录》），猫儿卵（《纲目》），鹅抱蛋（《植物名实图考》），见肿消（《南京民间药草》），穿山老鼠（《浙江中药手册》），白水罐、山地瓜（《东北药植志》），铁老鼠、母鸡带仔、老鼠瓜薯（《广西中药志》），山栗子、八卦牛、白浆罐、狗天天（《辽宁经济植物志》），癞痢茶（江西《草药手册》）。"}]},{"ID":"20240613084116-n6cycnp","Type":"NodeParagraph","Properties":{"id":"20240613084116-n6cycnp","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613084116-y9dfupk","Type":"NodeParagraph","Properties":{"id":"20240613084116-y9dfupk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613084116-jvkf3rk","Type":"NodeParagraph","Properties":{"id":"20240613084116-jvkf3rk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613084116-my5ewjs","Type":"NodeParagraph","Properties":{"id":"20240613084116-my5ewjs","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 为葡萄科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白蔹"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。春、秋采挖，除去茎及细须根，洗净，多纵切成两瓣、四瓣或斜片后晒干。"}]},{"ID":"20240613084116-0mu3yo9","Type":"NodeParagraph","Properties":{"id":"20240613084116-0mu3yo9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613084116-quv94l9","Type":"NodeParagraph","Properties":{"id":"20240613084116-quv94l9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 生长于荒山的灌木丛中。分布黑龙江、吉林、辽宁、河北、河南、山东、安徽、江苏、浙江、江西、湖南、湖北、四川、山西、陕西、广西、内蒙古等地。主产河南、湖北、安徽、江西。此外，江苏、浙江、四川、广西等地亦产。"}]},{"ID":"20240613084116-8xfgp6f","Type":"NodeParagraph","Properties":{"id":"20240613084116-8xfgp6f","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613084116-hu57oy8","Type":"NodeParagraph","Properties":{"id":"20240613084116-hu57oy8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 白蔹，又名：菟核、白草（《本经》），野葡萄秧、小老鸹眼、七角莲、上竹龙、早黄钳、白天天秧。藤本，以卷须攀援他物上升。块根纺锤形或块状，深棕红色，根皮栓化，易剥落。小枝光滑，棕褐色，具纵纹。吁互生，掌状复叶，具柄；小叶片通常5枚，再次作掌状或羽状分裂；小叶有短柄或几无柄，最终裂片披针形残菱形，大小不等，先端尖，基部楔形，边，缘有不规则缺刻状粗齿，叶轴及小叶柄有翅；叶上面暗绿色，下面淡绿色，均光滑无毛。聚伞花序与叶对生，总花梗长4～9厘米，常缠绕，花小，直径1.5～2毫米，淡黄色；花萼5片，不明显；花瓣5片，卵圆形，后脱落；雄蕊5枚，花丝短；花盘杯状，明显；子房着生花盘中央，2室，花柱1枚，甚短。浆果球形，直径6～7毫米，蓝色或蓝紫色。花期6～7月。果期8～9月。"}]},{"ID":"20240613084116-679yxpe","Type":"NodeParagraph","Properties":{"id":"20240613084116-679yxpe","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613084116-ww8isp3","Type":"NodeParagraph","Properties":{"id":"20240613084116-ww8isp3","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 干燥的块根呈长椭圆形或纺锤形，两头较尖，略弯曲，长3～12厘米，直径1～3厘米，外皮红棕色，有皱纹，易层层脱落，内面淡红褐色。纵切瓣切面周边常向内卷曲，中部有一凸起的棱线。斜片呈卵圆形，厚1.5～3毫米，中央略薄，周边较厚，微翘起或微弯曲。质轻，易折断，折断时有粉尘飞出，断面白色或淡红色。气微，味甘。以肥大、断面粉红色，粉性足者为佳。"}]},{"ID":"20240613084116-koniheu","Type":"NodeParagraph","Properties":{"id":"20240613084116-koniheu","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613084116-w73mjho","Type":"NodeParagraph","Properties":{"id":"20240613084116-w73mjho","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 含粘液质、淀粉等。"}]},{"ID":"20240613084116-po754au","Type":"NodeParagraph","Properties":{"id":"20240613084116-po754au","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613084116-sl4aip6","Type":"NodeParagraph","Properties":{"id":"20240613084116-sl4aip6","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 入心、肝、脾经。"}]},{"ID":"20240613084116-o866c4r","Type":"NodeParagraph","Properties":{"id":"20240613084116-o866c4r","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入脾、肺二经。\""}]},{"ID":"20240613084116-14u3lki","Type":"NodeParagraph","Properties":{"id":"20240613084116-14u3lki","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入肝、脾。\""}]},{"ID":"20240613084116-misjbk8","Type":"NodeParagraph","Properties":{"id":"20240613084116-misjbk8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"③《本草撮要》：\"入足少阴、厥阴经。\""}]},{"ID":"20240613084116-7v8srr0","Type":"NodeParagraph","Properties":{"id":"20240613084116-7v8srr0","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613084116-3i57hef","Type":"NodeParagraph","Properties":{"id":"20240613084116-3i57hef","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 苦甘辛，凉。"}]},{"ID":"20240613084116-7df2bu5","Type":"NodeParagraph","Properties":{"id":"20240613084116-7df2bu5","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240613084116-amt1gs7","Type":"NodeParagraph","Properties":{"id":"20240613084116-amt1gs7","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，微寒，无毒。\""}]},{"ID":"20240613084116-5lk5n0p","Type":"NodeParagraph","Properties":{"id":"20240613084116-5lk5n0p","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦，平，有毒。\""}]},{"ID":"20240613084116-t9eb773","Type":"NodeParagraph","Properties":{"id":"20240613084116-t9eb773","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"性微寒，味苦辛。\""}]},{"ID":"20240613084116-85nhgnk","Type":"NodeParagraph","Properties":{"id":"20240613084116-85nhgnk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613084116-eztw4e9","Type":"NodeParagraph","Properties":{"id":"20240613084116-eztw4e9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒及无实火者忌服。"}]},{"ID":"20240613084116-3wxtve2","Type":"NodeParagraph","Properties":{"id":"20240613084116-3wxtve2","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"代赭为使。反乌头。\""}]},{"ID":"20240613084116-brpihts","Type":"NodeParagraph","Properties":{"id":"20240613084116-brpihts","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"痈疽已溃者不宜服。\""}]},{"ID":"20240613084116-srn21fm","Type":"NodeParagraph","Properties":{"id":"20240613084116-srn21fm","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"③《本经逢原》：\"阴疽色淡不起，胃气弱者，非其所宜。\""}]},{"ID":"20240613084116-zqjh8tq","Type":"NodeParagraph","Properties":{"id":"20240613084116-zqjh8tq","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613084116-l7adur5","Type":"NodeParagraph","Properties":{"id":"20240613084116-l7adur5","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 清热，解毒，散结，生肌，止痛，治痈肿，疔疮，瘰疬，烫伤，温疟，惊痫，血痢，肠风，痔漏。"}]},{"ID":"20240613084116-8zm9pc7","Type":"NodeParagraph","Properties":{"id":"20240613084116-8zm9pc7","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主痈肿疽疮，散结气，止痛。除热，目中赤，小儿惊痫，温疟，女子阴中肿痛。\""}]},{"ID":"20240613084116-g03pejt","Type":"NodeParagraph","Properties":{"id":"20240613084116-g03pejt","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"下赤白，杀火毒。\""}]},{"ID":"20240613084116-vjcx8kx","Type":"NodeParagraph","Properties":{"id":"20240613084116-vjcx8kx","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治面上疱疮。\""}]},{"ID":"20240613084116-xeb65lr","Type":"NodeParagraph","Properties":{"id":"20240613084116-xeb65lr","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"止惊邪，发背，瘰窃，肠风，痔漏，刀箭疮，扑损，温热疟疾，血痢，烫火疮，生肌止痛。\""}]},{"ID":"20240613084116-puhquz6","Type":"NodeParagraph","Properties":{"id":"20240613084116-puhquz6","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑤《本草图经》：\"治风，金疮。\""}]},{"ID":"20240613084116-kj7rdly","Type":"NodeParagraph","Properties":{"id":"20240613084116-kj7rdly","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑥李杲：\"涂一切肿毒，敷疔疮。\""}]},{"ID":"20240613084116-kvxikf2","Type":"NodeParagraph","Properties":{"id":"20240613084116-kvxikf2","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"解狼毒毒。\""}]},{"ID":"20240613084116-m87u6fb","Type":"NodeParagraph","Properties":{"id":"20240613084116-m87u6fb","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613084116-3w14yd7","Type":"NodeParagraph","Properties":{"id":"20240613084116-3w14yd7","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 外用：研末撒或调涂。内服：煎汤，1～3钱。"}]},{"ID":"20240613084116-32ei9ti","Type":"NodeParagraph","Properties":{"id":"20240613084116-32ei9ti","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613084116-kvs73yz","Type":"NodeParagraph","Properties":{"id":"20240613084116-kvs73yz","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" ①治痈肿：㈠白蔹二分，藜芦一分。为末，酒和如泥，贴上，日三。（《补缺肘后方》）"}]},{"ID":"20240613084116-fiudd26","Type":"NodeParagraph","Properties":{"id":"20240613084116-fiudd26","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"㈡白蔹、乌头（炮）、黄芩各等分。捣末筛，和鸡子白敷上。（《普济方》白蔹散）"}]},{"ID":"20240613084116-iu12tu9","Type":"NodeParagraph","Properties":{"id":"20240613084116-iu12tu9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"②敛疮：白蔹、白芨、络石各半两，取干者。为细末，干撒疮上。（《鸡峰普济方》白蔹散）"}]},{"ID":"20240613084116-0b1u4f8","Type":"NodeParagraph","Properties":{"id":"20240613084116-0b1u4f8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"③治聤耳出脓血：白蔹、黄连（去须）、龙骨、赤石脂、乌贼鱼骨（去甲）各一两。上五味，捣罗为散。先以绵拭脓干，用药一钱匕，绵裹塞耳中。（《圣济总录》白蔹散）"}]},{"ID":"20240613084116-4gr0m1e","Type":"NodeParagraph","Properties":{"id":"20240613084116-4gr0m1e","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"④治白癜风，遍身斑点瘙痒：白蔹三两.天雄三两（炮裂去皮脐），商陆一两，黄芩二两，干姜二两（炮裂、锉），踯躅花一两（酒拌炒令干）。上药捣罗为细散，每于食前，以温酒调下二钱。（《圣惠方》白蔹散）"}]},{"ID":"20240613084116-qpo6grn","Type":"NodeParagraph","Properties":{"id":"20240613084116-qpo6grn","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑤治冻耳成疮，或痒或痛者：黄柏、白蔹各半两。为末。先以汤洗疮，后用香油调涂。（《仁斋直指方》白蔹散）"}]},{"ID":"20240613084116-h8qkjbl","Type":"NodeParagraph","Properties":{"id":"20240613084116-h8qkjbl","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑥治瘰疬生于颈腋，结肿寒热：白蔹、甘草、玄参、木香、赤芍药、川大黄各半两。上药捣细罗为散，以醋调为膏，贴于患上，干即易之。（《圣惠方》白蔹散）"}]},{"ID":"20240613084116-y0ytpdb","Type":"NodeParagraph","Properties":{"id":"20240613084116-y0ytpdb","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑦治皮肤中热痱、瘰疬：白蔹、黄连各二两，生胡粉一两。上捣筛，容脂调和敷之。（《刘涓子鬼遗方》白蔹膏）"}]},{"ID":"20240613084116-d64xzax","Type":"NodeParagraph","Properties":{"id":"20240613084116-d64xzax","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑧治扭挫伤：见肿消二个，食盐适量。捣烂外敷。（《全展选编·外科》）"}]},{"ID":"20240613084116-dsy44z4","Type":"NodeParagraph","Properties":{"id":"20240613084116-dsy44z4","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑨治汤火灼烂：白蔹末敷之。（《备急方》）"}]},{"ID":"20240613084116-47xqnta","Type":"NodeParagraph","Properties":{"id":"20240613084116-47xqnta","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"⑩治吐血、咯血不止：白蔹三两，阿胶二两（炙令燥）。上二味，粗捣筛，每服二镜匕，酒水共一盏，入生地黄汁二合，同煎至七分，去滓，食后温服。如无地黄汁。入生地黄一分同煎亦得。（《圣济总录》白蔹汤）"}]},{"ID":"20240613084116-6xha30y","Type":"NodeParagraph","Properties":{"id":"20240613084116-6xha30y","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613084116-eyh6mvo","Type":"NodeParagraph","Properties":{"id":"20240613084116-eyh6mvo","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" ①治疗外科炎症"}]},{"ID":"20240613084116-lpn63o2","Type":"NodeParagraph","Properties":{"id":"20240613084116-lpn63o2","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"将白蔹块根去皮研末，取3两（用量根据炎症面积加减）以沸水搅拌成团后，加75～95％酒精调成稠糊状，外敷患处，每日1次，以愈为度。对于疖、痈、蜂窝织炎、淋巴结炎、各种炎性肿块等急性感染的初期，有显着疗效。共观察3l例，除个别病情危急、全身反应严重加用抗菌素外，一般不用其他药物。用药后疼痛减轻，炎症很快吸收或局限。一般经治2～3天可愈。"}]},{"ID":"20240613084116-uvbl6mk","Type":"NodeParagraph","Properties":{"id":"20240613084116-uvbl6mk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"②治疗扭挫伤"}]},{"ID":"20240613084116-wasitnh","Type":"NodeParagraph","Properties":{"id":"20240613084116-wasitnh","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"取见肿消2个，食盐适量，捣烂如泥外敷。共治80例，66例有效。有的经治4天就肿消痛减而愈。"}]},{"ID":"20240613084116-z4ox1ae","Type":"NodeParagraph","Properties":{"id":"20240613084116-z4ox1ae","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613084116-btp891n","Type":"NodeParagraph","Properties":{"id":"20240613084116-btp891n","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613084116-d8i8cx7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613084116-d8i8cx7","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"《中华本草》：白蔹"}]},{"ID":"20240613084116-jwz73dv","Type":"NodeParagraph","Properties":{"id":"20240613084116-jwz73dv","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613084116-0xkc2ak","Type":"NodeParagraph","Properties":{"id":"20240613084116-0xkc2ak","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" Bái Liǎn"}]},{"ID":"20240613084116-jqrd9xd","Type":"NodeParagraph","Properties":{"id":"20240613084116-jqrd9xd","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613084116-u9fs0w6","Type":"NodeParagraph","Properties":{"id":"20240613084116-u9fs0w6","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 兔核、白根、昆仑、猫儿卵、鹅抱蛋、见肿消、穿山老鼠、白水罐、山地瓜、铁老鼠、母鸡带仔、老鼠瓜薯、山栗子、人卦牛、白浆罐、野红薯、地老鼠、野着薯、母鸡抱蛋。"}]},{"ID":"20240613084116-j8z8u7v","Type":"NodeParagraph","Properties":{"id":"20240613084116-j8z8u7v","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613084116-hs7g9me","Type":"NodeParagraph","Properties":{"id":"20240613084116-hs7g9me","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" Japanese Ampelopsis,Japanese Ampelopsis Root, Root of Japanese Ampelopsisc"}]},{"ID":"20240613084116-islvuu0","Type":"NodeParagraph","Properties":{"id":"20240613084116-islvuu0","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613084116-4hlumxm","Type":"NodeParagraph","Properties":{"id":"20240613084116-4hlumxm","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 出自1.《本经》。"}]},{"ID":"20240613084116-d5ei531","Type":"NodeParagraph","Properties":{"id":"20240613084116-d5ei531","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：白蔹近道处处有之。作藤生，根如白芷。破片，以竹穿之，日干。生取根捣敷痈肿亦效。"}]},{"ID":"20240613084116-zcgj5as","Type":"NodeParagraph","Properties":{"id":"20240613084116-zcgj5as","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：白蔹，根似天门冬，一株下有十许根，皮赤黑，肉白如芍药，殊不如白芷。"}]},{"ID":"20240613084116-ibfxncm","Type":"NodeParagraph","Properties":{"id":"20240613084116-ibfxncm","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：白蔹，今江淮州郡及荆、襄、怀、孟、商、齐诸州皆有之。二月生苗，多在林中，作蔓，赤茎，叶如小桑，五月开花，七月结实，根如鸡鸭卵，三、五枚同窠，皮赤黑，肉白。濠州有一种赤蔹"}]},{"ID":"20240613084116-nzey9to","Type":"NodeParagraph","Properties":{"id":"20240613084116-nzey9to","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613084116-44a0p6w","Type":"NodeParagraph","Properties":{"id":"20240613084116-44a0p6w","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 药材基源：为葡萄科植物白蔹的块根。"}]},{"ID":"20240613084116-0jalahy","Type":"NodeParagraph","Properties":{"id":"20240613084116-0jalahy","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Ampelopsis japonica (Thunb.)Makino [Paullinia japonica Thunb.]"}]},{"ID":"20240613084116-z3yms2e","Type":"NodeParagraph","Properties":{"id":"20240613084116-z3yms2e","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋季采挖，除去茎及细须根，洗净，多纵切成两瓣、四瓣或斜片，晒干。"}]},{"ID":"20240613084116-5sl8i0v","Type":"NodeParagraph","Properties":{"id":"20240613084116-5sl8i0v","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613084116-xkcnndw","Type":"NodeParagraph","Properties":{"id":"20240613084116-xkcnndw","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山地、荒坡及灌木林中，也有栽培。"}]},{"ID":"20240613084116-0s3a14p","Type":"NodeParagraph","Properties":{"id":"20240613084116-0s3a14p","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华北、东北、华东、中南及陕西、宁夏、四川等地。"}]},{"ID":"20240613084116-tz5of9e","Type":"NodeParagraph","Properties":{"id":"20240613084116-tz5of9e","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613084116-8p7sm65","Type":"NodeParagraph","Properties":{"id":"20240613084116-8p7sm65","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 白蔹 落叶攀援木质藤本，长约1m。块根粗壮，肉质，卵形、长圆形或长纺锤形，深棕褐色，数个相聚。茎多分枝，幼枝带淡紫色，光滑，有细条纹；卷须与叶对生。掌状复叶互生；叶柄长3-5cm，微淡紫色，光滑或略具细毛；叶片长6-10cm，宽7-12cm；小叶3-5，羽状分裂或羽状缺刻，裂片卵形至椭圆状卵形或卵状披针形，先端渐尖，基部楔形，边缘有深锯齿或缺刻，中间裂片最长，两侧的较小，中轴有闲翅，裂片基部有关节，两面无毛。聚伞花序小，与叶对生，花序梗长3-8cm，细长，常缠绕；花小，黄绿色；花萼5浅裂；花瓣、雄蕊各5；花盘边缘稍分裂。浆果球形，径约6mm，熟时白色或蓝色，有针孔状凹点。花期5-6月，果期9-10月。"}]},{"ID":"20240613084116-454r5hk","Type":"NodeParagraph","Properties":{"id":"20240613084116-454r5hk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613084116-2b96xv9","Type":"NodeParagraph","Properties":{"id":"20240613084116-2b96xv9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽湿润的气候，从亚热带到温带均能栽培，适应性强，耐寒。对土壤要求不严，砂质壤土、壤土、粘壤上均可种植。"}]},{"ID":"20240613084116-hwruvxj","Type":"NodeParagraph","Properties":{"id":"20240613084116-hwruvxj","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"栽培技术 用分根和扦插繁殖。分很繁殖：在春季植株未萌芽前，将植株挖出，每株分出带芽的根3-4个，按行珠距40cm×40cm开穴栽种，每穴栽1个带芽的根，覆土，将周围压实浇水，约20d左右出苗。打插繁殖：在7月进行，截取枝条，每段插穗上留3-4个节，按行株距15cm×15cm斜插于土中2-3节，留1-2节于地上，浇水保湿。生根后即可移栽。此外，还可以用种子和压条法繁殖。"}]},{"ID":"20240613084116-gvms1z9","Type":"NodeParagraph","Properties":{"id":"20240613084116-gvms1z9","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期间除注意中耕除草外，应及时浇水，保持土壤湿润。苗高30cm左右时应搭架缚蔓以利于攀援生长。每年应剪去枯枝和徒长枝，每株留4-5枝即可。每年春季返青前，施堆肥、厩肥等并培土。"}]},{"ID":"20240613084116-zuygkbt","Type":"NodeParagraph","Properties":{"id":"20240613084116-zuygkbt","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613084116-bgxkkp6","Type":"NodeParagraph","Properties":{"id":"20240613084116-bgxkkp6","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 块根长圆形或纺锤形，多纵切成瓣或斜片。完整者长5-12cm，直径1.5-3.5cm。表面红棕色或红褐色，有纵皱纹、细横纹及横长皮孔，栓皮易层层脱落，脱落处显淡红棕色，剖面类白色或淡红棕色，皱缩不平。斜片呈卵圆形，长2.5-5cm，宽2-3cm，切面类白色或浅红棕色，可见放射状纹理，周边较厚，微翘起或略弯曲。体轻，质硬脆，粉性。气微，味微甜。以肥大、断面粉红色、粉性足者为佳。"}]},{"ID":"20240613084116-otbbveo","Type":"NodeParagraph","Properties":{"id":"20240613084116-otbbveo","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"显微鉴别 根横切面：木栓层为2-6列木栓细胞，有时脱落。韧皮部射线宽广，韧皮束呈窄条状，形成层成环。木质部导管稀疏排列，周围有木纤维及木化薄壁细胞。薄壁组织中散有粘液细胞，内含草酸钙针晶束；薄墨细胞内充满淀粉粒，有的内含草酸钙簇晶。"}]},{"ID":"20240613084116-l98e7q8","Type":"NodeParagraph","Properties":{"id":"20240613084116-l98e7q8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡红棕色。①淀粉粒单粒棍棒形、长圆形、长卵形、肾形、扁三角形或菱形，有的两端尖，直径3-13（-26）μm长至25（-43）μm，脐点、层纹不明显；复粒少数。②草酸钙针晶散在或成束存在于粘液细胞中，针晶长86-169μm。③粘液细胞类圆形或椭圆形，长108-224μm，直径66-91μm，内含淡黄色粘液质，有的含针晶束。④草酸钙簇晶直径25-78μm，棱角宽大，有的似方晶。⑤具缘纹孔导管直径35-60（-83）μm，具缘纹孔排列成梯状或网状，纹孔口线形。⑤木薄壁细胞长方形壁稍厚，连珠状，单纹孔形状大小不一。此外，有石细胞、木纤维及木栓细胞。"}]},{"ID":"20240613084116-vb6rfed","Type":"NodeParagraph","Properties":{"id":"20240613084116-vb6rfed","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613084116-xdzjf9q","Type":"NodeParagraph","Properties":{"id":"20240613084116-xdzjf9q","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 块根含粘质和淀粉，酒石酸（tartaricacid），β-谷甾醇（β-sitosterol），延胡索酸（fumaric acid），胡萝卜甙（daucosterol）。叶含没食子酸（gallic acid），1，2，6-三-O-没食子酰基-β-D-吡喃葡萄糖甙（1，2，6-tri-O-galloyl-β-D-glucopyranoside），1，2，3，6-四-O-没食子酰基-β-D-吡喃葡萄糖甙（1，2，3，6-tetra-O-galloyl-β-D-glucopyranoside），1，2，4，6-四-O-没食子酰基-β-D-吡喃葡萄糖甙（1，2，4，6-tetra-O-galloyl-β-D-glucopyranoside），1，2，3，4，6-五-O-没食子酰基-β-D-吡喃葡萄糖甙（1，2，3，4，6-penta-O-galloyl-β-D-glucopyranoside），二没食子酸（digallic acid），1，4，6-三-O-没食子酰基-β-D-吡喃葡萄糖甙（1，4，6-tri-O-galloyl-β-D-glucopyra-noside），2，4，6-三-O-没食子酰基-D-吡喃葡萄糖甙（2，4，6-tri-O-galloyl-D-glucopyranoside），2，3，4，6-四-O-没食子酰基-D-吡喃葡萄糖甙（2，3，4，6-tetra-O-galloyl-D-glucopyranoside），6-O-二没食子酰基-1，2，3-三-O-没食子酰基-β-D-吡喃葡萄糖甙（6-O-digal-loyl-1，2，3-tri-O-galloyl-β-D-glucopyranoside），槲皮素-3-O-a-L-鼠李糖甙（quercetin-3-O-a-L-rhamnoside），槲皮素-3-O-（2-O-没食子酰基）-a-L-鼠李糖甙[quercetin-3-O-（2-O-galloyl）-a-L-rhamnoside]。"}]},{"ID":"20240613084116-fc67d5z","Type":"NodeParagraph","Properties":{"id":"20240613084116-fc67d5z","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613084116-22j0mrr","Type":"NodeParagraph","Properties":{"id":"20240613084116-22j0mrr","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 1.15的浓度对共心性毛癣菌、奥杜盎小孢子菌、腹股沟表皮癣菌等有抑制作用。根醇提物醋酸乙酸酯可溶部分，对四氯化碳致小鼠肝损伤具有保护作用，300mg/kg显着抑制谷丙转氨酶（SGPT）、谷草转氨酶（SGOT）活性的升高。"}]},{"ID":"20240613084116-z85l2b8","Type":"NodeParagraph","Properties":{"id":"20240613084116-z85l2b8","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"2.白蔹煎剂本身无镇痛作用，但可显着增强黑附片和炙川乌的镇痛作用，拮抗黑附片、炙川乌和炙草乌时对离体蛙心的收缩作用。"}]},{"ID":"20240613084116-6ohhi36","Type":"NodeParagraph","Properties":{"id":"20240613084116-6ohhi36","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"3.抗癌作用：体外试验对人子宫颈癌细胞培养系JTC-26有抑制作用，抑制率在90%以上。"}]},{"ID":"20240613084116-z1ricuk","Type":"NodeParagraph","Properties":{"id":"20240613084116-z1ricuk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613084116-r8n78jf","Type":"NodeParagraph","Properties":{"id":"20240613084116-r8n78jf","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 心；肺；肝；脾经"}]},{"ID":"20240613084116-fscc5dg","Type":"NodeParagraph","Properties":{"id":"20240613084116-fscc5dg","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613084116-ph73ibh","Type":"NodeParagraph","Properties":{"id":"20240613084116-ph73ibh","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 苦；辛；性微寒"}]},{"ID":"20240613084116-7h5dxjl","Type":"NodeParagraph","Properties":{"id":"20240613084116-7h5dxjl","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613084116-c99ex89","Type":"NodeParagraph","Properties":{"id":"20240613084116-c99ex89","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 脾胃虚寒及无实火者，痈疽已溃者均不宜服。阴疽色淡不起，胃气弱者，也不宜服用。"}]},{"ID":"20240613084116-y9ecntv","Type":"NodeParagraph","Properties":{"id":"20240613084116-y9ecntv","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613084116-tqz96br","Type":"NodeParagraph","Properties":{"id":"20240613084116-tqz96br","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 清热解毒；散结止痛；生肌敛疮。主疮疡肿毒；瘰疬；烫伤；湿疮；温疟；惊痫；血痢；肠风；痔漏；白带；跌打损伤；外伤出血"}]},{"ID":"20240613084116-r6y2i30","Type":"NodeParagraph","Properties":{"id":"20240613084116-r6y2i30","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613084116-khbz30j","Type":"NodeParagraph","Properties":{"id":"20240613084116-khbz30j","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g。外用：适量，研末撒或调涂。"}]},{"ID":"20240613084116-0i9qo00","Type":"NodeParagraph","Properties":{"id":"20240613084116-0i9qo00","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613084116-xajtk39","Type":"NodeParagraph","Properties":{"id":"20240613084116-xajtk39","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 白蔹汤《圣济总录》；漏芦汤《外科精义》；贯众汤《圣济总录》"}]},{"ID":"20240613084116-gf8y8ap","Type":"NodeParagraph","Properties":{"id":"20240613084116-gf8y8ap","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613084116-jew3h4t","Type":"NodeParagraph","Properties":{"id":"20240613084116-jew3h4t","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：白蔹、白芨古今服饵方少有用者，多见于敛疮方中，二物多相需而行。"}]},{"ID":"20240613084116-zkmi3mj","Type":"NodeParagraph","Properties":{"id":"20240613084116-zkmi3mj","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：白蔹，若则泄，辛则散，甘则缓，寒则除热，故主痈肿疽疮，散结止痛。盖以痈疽皆由荣气不从，逆于肉里所致：女子阴中肿痛，亦由血分有热之故；火毒伤肌肉，即血分有热；目中赤，亦血热为病，散结凉血除热，则上来诸苦，蔑不济矣。其治小儿惊痫、温疟及妇人下赤白，则虽云惊痫属风热，温疟由于暑，赤白淋属湿热，或可通用，然病各有因，药各有主，以类推之，或非其任矣，尚俟后哲详之。总之为疔肿痈疽家要药，乃确论也。"}]},{"ID":"20240613084116-96943cm","Type":"NodeParagraph","Properties":{"id":"20240613084116-96943cm","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：白蔹，性寒解毒，敷肿疡疮，有解散之功，以其味辛也。《本经》治目赤惊痫温疟，非取其解热毒之力欤？治阴肿带下，非取其去湿热之力欤？《金匮》薯蓣丸用之，专取其辛凉散结以解风气百疾之蕴蓄也。世医仅知痈肿解毒之用，陋哉。同地肤子治淋浊失精，同白及治金疮失血，同甘草解狼毒之毒，其辛散之功可知。"}]},{"ID":"20240613084116-r0rvjsk","Type":"NodeParagraph","Properties":{"id":"20240613084116-r0rvjsk","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：白蔹苦泄，能清湿热而通壅滞，痈肿疽疮，多湿火为病，古人所谓痈疽，本外疡之通称，此疽字，非近世之所谓阴疽。结气以热结而言，苦泄宣通，则能散之，痛者亦热结之不通，《经》文以止痛与除热并言，则非泛治一切诸痛可知。目赤乃湿热之上凌，惊痫多气火之上菀，温疟本是热痰窒塞，阴中肿痛，亦湿火结于肝肾之络，总之，皆苦泄宣通之作用。医经主治，未尝不与陆氏《诗疏》同条共贯也，《别录》以治赤白，亦泄导湿热之浊垢，曰杀火毒，则约而言之耳。《日华子》谓治发背，则古之背疽，多是火毒，此与太阳经凝结之背疽不同，不可含浑。又谓瘰疬，面上疱疮，亦即《本经》主痈肿之义。又谓治肠风痔漏，血痢，刀箭疮，扑损，生肌止痛，则于《本经》、《别录》之外，多一层凉血破血，化瘀生新之义。又可作疡家外治末药，盖苦而善泄，义固相因。"}]},{"ID":"20240613084116-xrhefq1","Type":"NodeParagraph","Properties":{"id":"20240613084116-xrhefq1","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主痈肿疽疮，散结气，止痛。除热，目中赤，小儿惊痫，温疟，女子阴中肿痛。"}]},{"ID":"20240613084116-k646pb1","Type":"NodeParagraph","Properties":{"id":"20240613084116-k646pb1","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"6.《别录》：下赤白，杀火毒。"}]},{"ID":"20240613084116-2nj7lkc","Type":"NodeParagraph","Properties":{"id":"20240613084116-2nj7lkc","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：治面上疱疮。"}]},{"ID":"20240613084116-lgtsgic","Type":"NodeParagraph","Properties":{"id":"20240613084116-lgtsgic","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：止惊邪，发背，瘰疬，肠风，痔漏，刀箭疮，扑损，温热疟疾，血痢，烫火疮，生肌止痛。"}]},{"ID":"20240613084116-ad38g3d","Type":"NodeParagraph","Properties":{"id":"20240613084116-ad38g3d","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"9.《本草图经》：治风，金疮。"}]},{"ID":"20240613084116-p0huyfm","Type":"NodeParagraph","Properties":{"id":"20240613084116-p0huyfm","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"10.李杲：涂一切肿毒，敷疔疮。"}]},{"ID":"20240613084116-935mao3","Type":"NodeParagraph","Properties":{"id":"20240613084116-935mao3","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"11.《纲目》：解狼毒毒。"}]},{"ID":"20240613084116-0onaztw","Type":"NodeParagraph","Properties":{"id":"20240613084116-0onaztw","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613084116-el80p3a","Type":"NodeParagraph","Properties":{"id":"20240613084116-el80p3a","updated":"20240613084116"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613084117-i5f19mb","Type":"NodeThematicBreak","Properties":{"id":"20240613084117-i5f19mb"}},{"ID":"20240613084118-wuz7sfo","Type":"NodeParagraph","Properties":{"id":"20240613084118-wuz7sfo"}}]}