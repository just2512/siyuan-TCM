,"Data":"assets/景天 5-20240722154012-14zfgec.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 622px;\" parent-style=\"width: 632px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 538px;","style":"width: 528px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"景天 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/景天 4-20240722153806-9a858ws.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 528px;\" parent-style=\"width: 538px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240722154153-ab1iyni","Type":"NodeParagraph","Properties":{"id":"20240722154153-ab1iyni","updated":"20240722154254"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 803px;","style":"width: 793px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"景天 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/景天 6-20240722154153-0xfeu1y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 793px;\" parent-style=\"width: 803px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 383px;","style":"width: 373px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"景天 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/景天 7-20240722154254-gdhspnn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 373px;\" parent-style=\"width: 383px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616170408-wg8h8g2","Type":"NodeThematicBreak","Properties":{"id":"20240616170408-wg8h8g2"}},{"ID":"20240616170432-4v75xcw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170432-4v75xcw","updated":"20240616170437"},"Children":[{"Type":"NodeText","Data":"景天《神农本草经》"}]},{"ID":"20240616170432-7lp5noy","Type":"NodeParagraph","Properties":{"id":"20240616170432-7lp5noy","updated":"20240616170432"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240616170432-xuz2zfw","Type":"NodeParagraph","Properties":{"id":"20240616170432-xuz2zfw","updated":"20240616170432"},"Children":[{"Type":"NodeText","Data":"主大热，火创，身热，烦邪恶气，华主女人漏下赤白，轻身明目。一名戒火，一名慎火（《御览》引云，一名水母，《大观本》，作黑字，水作火）。生川谷。"}]},{"ID":"20240616170432-1msmyci","Type":"NodeParagraph","Properties":{"id":"20240616170432-1msmyci","updated":"20240616170432"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名火母，一名救火，一名据火，生太山，四月四日，七月七日采，阴干。"}]},{"ID":"20240616170432-17s5fv3","Type":"NodeParagraph","Properties":{"id":"20240616170432-17s5fv3","updated":"20240616170432"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：今人皆盆养之于屋上，云以辟火。"}]},{"ID":"20240616170446-7ry0syl","Type":"NodeThematicBreak","Properties":{"id":"20240616170446-7ry0syl"}},{"ID":"20240616170447-1m99akq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170447-1m99akq","updated":"20240616170451"},"Children":[{"Type":"NodeText","Data":"景天《名医别录》"}]},{"ID":"20240616170447-ocg314m","Type":"NodeParagraph","Properties":{"id":"20240616170447-ocg314m","updated":"20240616170447"},"Children":[{"Type":"NodeText","Data":"味酸，无毒．主治诸虫毒，痂 ，寒热，风痹，诸不足．久服通神不老．一名火母，一名救火，一名据火．生太山．四月四日、七月七日采，阴干．"}]},{"ID":"20240616170447-9ug387m","Type":"NodeParagraph","Properties":{"id":"20240616170447-9ug387m","updated":"20240616170509"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶景天，味苦，平．主大热火疮，身热烦邪恶气．华，主女人漏下赤白，轻身明目。一名戒火，一名慎火。生川谷。"}]},{"ID":"20240616170550-1ajoq9s","Type":"NodeThematicBreak","Properties":{"id":"20240616170550-1ajoq9s"}},{"ID":"20240616170551-f81zrxq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170551-f81zrxq","updated":"20240616170556"},"Children":[{"Type":"NodeText","Data":"景天《本草乘雅半偈》"}]},{"ID":"20240616170551-i7zxl5y","Type":"NodeParagraph","Properties":{"id":"20240616170551-i7zxl5y","updated":"20240616170551"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240616170551-0hb5aqz","Type":"NodeParagraph","Properties":{"id":"20240616170551-0hb5aqz","updated":"20240616170551"},"Children":[{"Type":"NodeText","Data":"具高明之象，秉寒水之化令。"}]},{"ID":"20240616170551-eyjm91e","Type":"NodeParagraph","Properties":{"id":"20240616170551-eyjm91e","updated":"20240616170551"},"Children":[{"Type":"NodeText","Data":"【气味】苦平，无毒。"}]},{"ID":"20240616170551-ftdli5d","Type":"NodeParagraph","Properties":{"id":"20240616170551-ftdli5d","updated":"20240616170551"},"Children":[{"Type":"NodeText","Data":"【主治】主大热火疮，身热烦，邪恶气。花主女人漏下赤白，轻身，明目。"}]},{"ID":"20240616170551-9ii1808","Type":"NodeParagraph","Properties":{"id":"20240616170551-9ii1808","updated":"20240616170551"},"Children":[{"Type":"NodeText","Data":"【核】曰∶景天，一名慎火、戒火，即火丹草也。出太山山谷，今南北皆有。种置檐屋，云可辟火。春生苗，高一二尺，茎色黄赤，质极脆弱，折之有汁，叶色淡绿，似马齿苋，光泽柔浓，作层而上。夏开碎花红白，结实如连翘而小，中有黑子如粟粒。秋后茎枯，明年宿根再发。"}]},{"ID":"20240616170551-u4narho","Type":"NodeParagraph","Properties":{"id":"20240616170551-u4narho","updated":"20240616170602"},"Children":[{"Type":"NodeText","Data":"【】曰∶性喜高显，因名景天。置之檐屋，顺其性尔。炎上作苦，苦性走下，火热为本者。"}]},{"ID":"20240616170633-al7ibt8","Type":"NodeThematicBreak","Properties":{"id":"20240616170633-al7ibt8"}},{"ID":"20240616170634-2dmfaz5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170634-2dmfaz5","updated":"20240616170643"},"Children":[{"Type":"NodeText","Data":"景天《本经逢原》"}]},{"ID":"20240616170634-z2nm4qv","Type":"NodeParagraph","Properties":{"id":"20240616170634-z2nm4qv","updated":"20240616170634"},"Children":[{"Type":"NodeText","Data":"（一名慎火草，俗名火丹草）"}]},{"ID":"20240616170634-quopbab","Type":"NodeParagraph","Properties":{"id":"20240616170634-quopbab","updated":"20240616170634"},"Children":[{"Type":"NodeText","Data":"苦，寒，无毒。"}]},{"ID":"20240616170634-4m2fc1i","Type":"NodeParagraph","Properties":{"id":"20240616170634-4m2fc1i","updated":"20240616170634"},"Children":[{"Type":"NodeText","Data":"《本经》主大热火疮，身热诸邪恶气。"}]},{"ID":"20240616170634-38q9gr8","Type":"NodeParagraph","Properties":{"id":"20240616170634-38q9gr8","updated":"20240616170634"},"Children":[{"Type":"NodeText","Data":"〔发明〕慎火草性能凉血解毒，故《本经》治大热火疮。《日华》治热狂赤眼，头痛，寒热游风，女子带下。《千金》慎火散以之为君，专主血热崩中带下之病。捣汁涂小儿丹毒发热及游风热疮，外用并效。一切病得之寒湿、恶寒喜热者勿投。"}]},{"ID":"20240616170618-t4pohma","Type":"NodeThematicBreak","Properties":{"id":"20240616170618-t4pohma"}},{"ID":"20240616170619-tlts6xg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170619-tlts6xg","updated":"20240616170628"},"Children":[{"Type":"NodeText","Data":"景天《得配本草》"}]},{"ID":"20240616170619-zh9xgjt","Type":"NodeParagraph","Properties":{"id":"20240616170619-zh9xgjt","updated":"20240616170619"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名慎火草"}]},{"ID":"20240616170619-n7kni7b","Type":"NodeParagraph","Properties":{"id":"20240616170619-n7kni7b","updated":"20240616170619"},"Children":[{"Type":"NodeText","Data":"可 朱砂。"}]},{"ID":"20240616170619-2pk7xky","Type":"NodeParagraph","Properties":{"id":"20240616170619-2pk7xky","updated":"20240616170619"},"Children":[{"Type":"NodeText","Data":"苦、酸、寒。有小毒。入手少阴经。解热毒，祛游风，治赤眼，疗带下。配盐捣汁，涂风疹。入醋捣，涂丹毒。"}]},{"ID":"20240616170409-7gxvaug","Type":"NodeThematicBreak","Properties":{"id":"20240616170409-7gxvaug"}},{"ID":"20240616170411-b9xqb08","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170411-b9xqb08","updated":"20240616170415"},"Children":[{"Type":"NodeText","Data":"景天《本草纲目》"}]},{"ID":"20240616170411-p2q4puh","Type":"NodeParagraph","Properties":{"id":"20240616170411-p2q4puh","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"「释名」慎火、戒火、据火、护火、辟火、火母。"}]},{"ID":"20240616170411-eed2u5n","Type":"NodeParagraph","Properties":{"id":"20240616170411-eed2u5n","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、无毒。"}]},{"ID":"20240616170411-bpom0n9","Type":"NodeParagraph","Properties":{"id":"20240616170411-bpom0n9","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616170411-250m5e5","Type":"NodeParagraph","Properties":{"id":"20240616170411-250m5e5","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"1、小儿惊风。用景天（干）半两、麻黄、丹参、白术各二钱半，共研为末。每服半钱，浆水调服。三、四岁的小儿可服一钱。"}]},{"ID":"20240616170411-eoym934","Type":"NodeParagraph","Properties":{"id":"20240616170411-eoym934","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"2、婴儿风疹及疮毒。用景天苗叶五两和盐三两，同研细，绞取汁，以热手抹涂。一天两次。"}]},{"ID":"20240616170411-l0h9qhl","Type":"NodeParagraph","Properties":{"id":"20240616170411-l0h9qhl","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"3、热毒丹疮。用景天捣汁涂搽。一昼夜宜搽一、二十次。"}]},{"ID":"20240616170411-4b78qxx","Type":"NodeParagraph","Properties":{"id":"20240616170411-4b78qxx","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"4、漆沧作痒。揉景天涂搽。"}]},{"ID":"20240616170411-ja6ictu","Type":"NodeParagraph","Properties":{"id":"20240616170411-ja6ictu","updated":"20240616170411"},"Children":[{"Type":"NodeText","Data":"5、眼中生翳，涩痛难开。用景天捣汁，一天点三、五次。"}]},{"ID":"20240616170330-phmebhe","Type":"NodeThematicBreak","Properties":{"id":"20240616170330-phmebhe"}},{"ID":"20240616170332-wwy721j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170332-wwy721j","updated":"20240616170336"},"Children":[{"Type":"NodeText","Data":"景天《冯氏锦囊秘录》"}]},{"ID":"20240616170332-d63jbaj","Type":"NodeParagraph","Properties":{"id":"20240616170332-d63jbaj","updated":"20240616170332"},"Children":[{"Type":"NodeText","Data":"味苦酸平，气寒，无毒，乃大寒纯阴之草也。故主大热火疮身热烦邪，诸中毒虺蛇伤恶气。"}]},{"ID":"20240616170332-91k7yym","Type":"NodeParagraph","Properties":{"id":"20240616170332-91k7yym","updated":"20240616170332"},"Children":[{"Type":"NodeText","Data":"景天又名慎火草，又名挂壁青。治火疮立瘥，又煎汤浴小儿热刺痱疮。若捣烂，能敷小儿赤游丹毒，金疮蛊毒兼疗，风惊热燥并驱。"}]},{"ID":"20240616170254-evpx4br","Type":"NodeThematicBreak","Properties":{"id":"20240616170254-evpx4br"}},{"ID":"20240616170318-odrzyb2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170318-odrzyb2","updated":"20240616170321"},"Children":[{"Type":"NodeText","Data":"景天《本草蒙筌》"}]},{"ID":"20240616170318-mp9uvri","Type":"NodeParagraph","Properties":{"id":"20240616170318-mp9uvri","updated":"20240616170318"},"Children":[{"Type":"NodeText","Data":"味苦、酸，气平。无毒，一云有小毒。人家园亭，多以盆植。茎叶坚浓，随插随生。"}]},{"ID":"20240616170318-jwus7jp","Type":"NodeParagraph","Properties":{"id":"20240616170318-jwus7jp","updated":"20240616170318"},"Children":[{"Type":"NodeText","Data":"俗名挂壁青，谓无土养不瘁。又名慎火草，因治火疮立差。煎汤浴小儿热刺痱疮，捣烂敷小儿赤游丹毒。金疮蛊毒兼疗，风惊热燥总医。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"香细浅红，带赤白能止。"}]},{"ID":"20240616170254-sybzdb0","Type":"NodeThematicBreak","Properties":{"id":"20240616170254-sybzdb0"}},{"ID":"20240616170305-j2tlu9o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170305-j2tlu9o","updated":"20240616170312"},"Children":[{"Type":"NodeText","Data":"景天《本草图经》"}]},{"ID":"20240616170305-4k6baim","Type":"NodeParagraph","Properties":{"id":"20240616170305-4k6baim","updated":"20240616170309"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"景天"},{"Type":"NodeText","Data":"，生泰山山谷，今南北皆有之。人家多种于中庭，或以盆盎植于屋上，云以辟火，谓之慎火草。春生苗，叶似马齿而大，作层而上，茎极脆弱；夏中开红紫碎花，秋后枯死；亦有宿根者。四月四日、七月七日采其花并苗叶，阴干。攻治疮毒及婴孺风疹在皮肤不出者，生取苗叶五大两，和盐三大两，同研，绞取汁，以热手摩涂之，日再。但是热毒丹疮，皆可如此用之。"}]},{"ID":"20240616170254-4kjohfj","Type":"NodeThematicBreak","Properties":{"id":"20240616170254-4kjohfj"}},{"ID":"20240616170255-4wrh7f5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170255-4wrh7f5","updated":"20240616170259"},"Children":[{"Type":"NodeText","Data":"景天《医学入门》"}]},{"ID":"20240616170255-vjviyfe","Type":"NodeParagraph","Properties":{"id":"20240616170255-vjviyfe","updated":"20240616170255"},"Children":[{"Type":"NodeText","Data":"叶似马齿苋而大作层，上茎极脆，开红紫花，今人以盆养于屋上以辟火，故又名慎火草。味苦酸。"}]},{"ID":"20240616170255-9gkxvou","Type":"NodeParagraph","Properties":{"id":"20240616170255-9gkxvou","updated":"20240616170255"},"Children":[{"Type":"NodeText","Data":"气平。无毒。主大热身热烦邪恶气，诸蛊毒痂疵寒热，诸不足。治火疮风疹恶痒，游风疮毒。小儿丹毒赤肿，生捣敷之。其花主女人漏下赤白。七月采阴干。"}]},{"ID":"20240616170245-5fti5hf","Type":"NodeThematicBreak","Properties":{"id":"20240616170245-5fti5hf"}},{"ID":"20240616170246-uz8rw44","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170246-uz8rw44","updated":"20240616170249"},"Children":[{"Type":"NodeText","Data":"景天《药笼小品》"}]},{"ID":"20240616170246-t8bmwm8","Type":"NodeParagraph","Properties":{"id":"20240616170246-t8bmwm8","updated":"20240616170246"},"Children":[{"Type":"NodeText","Data":"苦酸寒，纯阴之品，入心清热。"}]},{"ID":"20240616170246-t7ny46t","Type":"NodeParagraph","Properties":{"id":"20240616170246-t7ny46t","updated":"20240616170246"},"Children":[{"Type":"NodeText","Data":"为末同菊叶汁疗火丹。"}]},{"ID":"20240616170246-peyaba3","Type":"NodeParagraph","Properties":{"id":"20240616170246-peyaba3","updated":"20240616170246"},"Children":[{"Type":"NodeText","Data":"中寒者勿服。"}]},{"ID":"20240616165931-hy30upt","Type":"NodeThematicBreak","Properties":{"id":"20240616165931-hy30upt"}},{"ID":"20240616170237-0ifbyi4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170237-0ifbyi4","updated":"20240616170241"},"Children":[{"Type":"NodeText","Data":"景天《药性切用》"}]},{"ID":"20240616170237-tqkih4b","Type":"NodeParagraph","Properties":{"id":"20240616170237-tqkih4b","updated":"20240616170237"},"Children":[{"Type":"NodeText","Data":"一名慎火草。苦酸性寒，入心，泻热解毒，并涂丹肿、蛇伤。"}]},{"ID":"20240616170204-65b2cy6","Type":"NodeThematicBreak","Properties":{"id":"20240616170204-65b2cy6"}},{"ID":"20240616170227-c8s0829","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170227-c8s0829","updated":"20240616170231"},"Children":[{"Type":"NodeText","Data":"景天《本经逢原》"}]},{"ID":"20240616170227-gpwfwtp","Type":"NodeParagraph","Properties":{"id":"20240616170227-gpwfwtp","updated":"20240616170227"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名慎火草，俗名火丹草"}]},{"ID":"20240616170227-wvosyys","Type":"NodeParagraph","Properties":{"id":"20240616170227-wvosyys","updated":"20240616170227"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。"}]},{"ID":"20240616170227-al3wrm7","Type":"NodeParagraph","Properties":{"id":"20240616170227-al3wrm7","updated":"20240616170227"},"Children":[{"Type":"NodeText","Data":"《本经》主大热火疮，身热诸邪恶气。"}]},{"ID":"20240616170227-aupc2i6","Type":"NodeParagraph","Properties":{"id":"20240616170227-aupc2i6","updated":"20240616170227"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"慎火草性能凉血解毒，故《本经》治大热火疮。《日华》治热狂赤眼，头痛，寒热游风，女子带下，《千金》慎火散以之为君，专主血热崩中带下之病，捣汁涂。小儿丹毒发热及游风热疮，外用并效。一切病得之寒湿，恶寒喜热者勿投。"}]},{"ID":"20240616170205-i98d2zk","Type":"NodeThematicBreak","Properties":{"id":"20240616170205-i98d2zk"}},{"ID":"20240616170219-d6yzjdv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170219-d6yzjdv","updated":"20240616170222"},"Children":[{"Type":"NodeText","Data":"景天《新修本草》"}]},{"ID":"20240616170219-d6n17sw","Type":"NodeParagraph","Properties":{"id":"20240616170219-d6n17sw","updated":"20240616170219"},"Children":[{"Type":"NodeText","Data":"味苦、酸，平，无毒。主大热火疮，身热烦，邪恶气。诸蛊毒，痂 ，寒热风痹，诸不足。花，主女人漏下赤白，轻身明目。久服通神不老。一名戒火，一名火母，一名救火，一名据火，一名慎火。生太山川谷。四月四日、七月七日采，阴干。"}]},{"ID":"20240616170219-gbgvn74","Type":"NodeParagraph","Properties":{"id":"20240616170219-gbgvn74","updated":"20240616170219"},"Children":[{"Type":"NodeText","Data":"今人皆盆盛养之于屋上，云以辟火。叶可疗金疮止血，以洗浴小儿，去烦热惊气。广州城外有一树，云大三、四围，呼为慎火树。江东者，甚细小。方用亦希。其花入服食。众药之名，此最为丽。"}]},{"ID":"20240616170205-axdkbhu","Type":"NodeThematicBreak","Properties":{"id":"20240616170205-axdkbhu"}},{"ID":"20240616170206-b1pz5a3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170206-b1pz5a3","updated":"20240616170211"},"Children":[{"Type":"NodeText","Data":"景天《本草衍义》"}]},{"ID":"20240616170206-cq6gzbl","Type":"NodeParagraph","Properties":{"id":"20240616170206-cq6gzbl","updated":"20240616170206"},"Children":[{"Type":"NodeText","Data":"陶隐居既云∶今人皆盆盛养之于屋上，即知是草药。又言广州城外有一株，云可三四围，呼为慎火木。既曰云，即非亲见也。盖是传闻，亦非误耳，乃陶之轻听也。然极易种，但折生枝置土中，频浇溉，旬日便下根，浓研取汁，涂火心疮，甚验。干为末，水调，扫游风、赤肿、 热者。"}]},{"ID":"20240616165931-zzhmqjc","Type":"NodeThematicBreak","Properties":{"id":"20240616165931-zzhmqjc"}},{"ID":"20240616170122-kcg8cfv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170122-kcg8cfv","updated":"20240616170125"},"Children":[{"Type":"NodeText","Data":"景天《千金翼方》"}]},{"ID":"20240616170122-rvksznm","Type":"NodeParagraph","Properties":{"id":"20240616170122-rvksznm","updated":"20240616170122"},"Children":[{"Type":"NodeText","Data":"味苦酸，平，无毒，主大热火疮，身热，烦邪恶气，诸蛊毒，痂 ，寒热风痹，花∶主女子漏下赤白，轻身明目。久服通神不老。一名戎火，一名火母，一名救火，一火，一名慎火。生太山川谷，四月四日七月七日采，阴干。"}]},{"ID":"20240616165931-2agvqlc","Type":"NodeThematicBreak","Properties":{"id":"20240616165931-2agvqlc"}},{"ID":"20240616170042-xvx9d5r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170042-xvx9d5r","updated":"20240616170048"},"Children":[{"Type":"NodeText","Data":"景天《证类本草》"}]},{"ID":"20240616170042-esl98b6","Type":"NodeParagraph","Properties":{"id":"20240616170042-esl98b6","updated":"20240616170042"},"Children":[{"Type":"NodeText","Data":"味苦、酸，平，无毒。主大热火疮，身热烦，邪恶气，诸蛊毒，痂 （疋几切），寒热风痹，诸不足。花，主女人漏下赤白，轻身明目。久服通神不老。一名戒火，一名火母，一名救火，一名据火，一名慎火。生太山川谷。四月四日、七月七日采，阴干。"}]},{"ID":"20240616170042-rneg1zk","Type":"NodeParagraph","Properties":{"id":"20240616170042-rneg1zk","updated":"20240616170042"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今人皆盆盛养之于屋上，云以辟火。叶，可疗金疮止血，以洗浴小儿，去烦热，惊气。广州城外有一树，云大三、四围，呼为慎火树。江东者甚细小。方用亦稀。其花入服食。众药之名，此最为丽。今注皇朝收复岭表，得广州医官问其事，曾无慎火成树者，盖陶之误尔。臣禹锡等谨按蜀本图经云∶慎火草，叶似马齿苋而大。药性论云∶景天，君，有小毒。能治风疹恶痒，主小儿丹毒及治发热惊疾。花能明目。日华子云∶景天，冷。治心烦热狂，赤眼，头痛，寒热，游风丹肿，女人带下。"}]},{"ID":"20240616170042-j7izy1w","Type":"NodeParagraph","Properties":{"id":"20240616170042-j7izy1w","updated":"20240616170042"},"Children":[{"Type":"NodeText","Data":"图经曰∶景天，生泰山山谷，今南北皆有之，人家多种于中庭，或以盆盎植于屋上，云以辟火，谓之慎火草。春生苗，叶似马齿而大，作层而上，茎极脆弱。夏中开红紫碎花，秋后枯死。亦有宿根者。四月四日、七月七日采其花并苗、叶，阴干。攻治疮毒及婴孺风疹在皮肤不出者，生取苗、叶五大两，和盐三大两。同研，绞取汁，以热手摩涂之，日再。但是热毒丹疮，皆可如此用之。"}]},{"ID":"20240616170042-2ggs5a0","Type":"NodeParagraph","Properties":{"id":"20240616170042-2ggs5a0","updated":"20240616170042"},"Children":[{"Type":"NodeText","Data":"外台秘要∶治瘾疹。以慎火草一斤，捣绞取汁，敷上热炙，摸之再三，即瘥。千金方∶治小儿丹发。慎火草生一握，捣绞汁，以拭之 上，日十遍，夜三、四遍。谭氏小儿方同。子母秘录治产后阴下脱。慎火草一斤阴干，酒五升，煮取汁，分温四服。又方∶治小儿赤游，行于体上下，至心即死。捣生景天敷疮上。杨氏产乳疗烟火丹发，以背起或两胁及两足，赤如火。景天草、真珠末一两，捣和如泥，涂之。又方∶疗蛰火丹从头起，慎火草捣和苦酒涂之。"}]},{"ID":"20240616170042-xgcpmot","Type":"NodeParagraph","Properties":{"id":"20240616170042-xgcpmot","updated":"20240616170201"},"Children":[{"Type":"NodeText","Data":"衍义曰∶景天，陶隐居既云，今人皆盆盛，养之于屋上，即知是草药。又言广州城外有一株，云可三、四围，呼为慎火木。既曰云，即非亲见是也。盖是传闻，亦非误耳，乃陶之轻听也。然极易种，但折生枝置土中，频浇溉。旬日便下根，浓研取汁，涂火心疮，其验。干为末，水调，扫游风、赤肿热者。"}]},{"ID":"20240616170348-xmxnc2s","Type":"NodeThematicBreak","Properties":{"id":"20240616170348-xmxnc2s"}},{"ID":"20240616170349-5thxqf3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170349-5thxqf3","updated":"20240616170354"},"Children":[{"Type":"NodeText","Data":"景天《本草经集注》"}]},{"ID":"20240616170349-4nubtka","Type":"NodeParagraph","Properties":{"id":"20240616170349-4nubtka","updated":"20240616170349"},"Children":[{"Type":"NodeText","Data":"味苦、酸，平，无毒。主治大热，火疮，身热烦，邪恶气。诸蛊毒，痂 ，寒热风痹，诸不足。花∶主治女人漏下赤白，轻身，明目。久服通神不老。一名戒火，一名火母，一名救火，一名据火，一名慎火。生太山川谷。四月四日、七月七日采，阴干。"}]},{"ID":"20240616170349-i3y55s1","Type":"NodeParagraph","Properties":{"id":"20240616170349-i3y55s1","updated":"20240616170349"},"Children":[{"Type":"NodeText","Data":"今人皆盆盛养之于屋上，云以辟火。叶可治金疮，止血，以洗浴小儿，去烦热惊气。广州城外有一树，云大三、四围，呼为慎火树。江东者，甚细小。方用亦稀。其花入服食。众药之名，此最为丽。"}]},{"ID":"20240616165931-a1w6yfh","Type":"NodeThematicBreak","Properties":{"id":"20240616165931-a1w6yfh"}},{"ID":"20240616170031-lwm4yex","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616170031-lwm4yex","updated":"20240616170036"},"Children":[{"Type":"NodeText","Data":"景天《本草从新》"}]},{"ID":"20240616170031-a9tskqz","Type":"NodeParagraph","Properties":{"id":"20240616170031-a9tskqz","updated":"20240616170031"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名慎火草．泻热解毒．"}]},{"ID":"20240616170031-8kytroh","Type":"NodeParagraph","Properties":{"id":"20240616170031-8kytroh","updated":"20240616170031"},"Children":[{"Type":"NodeText","Data":"苦酸而寒．纯阴之品．独入离宫．专清热毒．疗诸种火丹．一切游风．捣敷蛇咬．中寒者．"}]},{"ID":"20240616170031-6kxslrh","Type":"NodeParagraph","Properties":{"id":"20240616170031-6kxslrh","updated":"20240616170031"},"Children":[{"Type":"NodeText","Data":"服之有大害．（眼生花翳、痛涩难开、景天捣汁、日点三五次、效．）"}]},{"ID":"20240607130600-duc71b1","Type":"NodeThematicBreak","Properties":{"id":"20240607130600-duc71b1"}},{"ID":"20240607130625-zq3mvwb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130625-zq3mvwb","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：景天"}]},{"ID":"20240607130625-nt2q7tj","Type":"NodeParagraph","Properties":{"id":"20240607130625-nt2q7tj","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Jǐnɡ Tiān"}]},{"ID":"20240607130625-a6h2zy0","Type":"NodeParagraph","Properties":{"id":"20240607130625-a6h2zy0","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"活血三七、八宝、胡豆七、大打不死"}]},{"ID":"20240607130625-youkyft","Type":"NodeParagraph","Properties":{"id":"20240607130625-youkyft","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"景天科景天属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"景天"},{"Type":"NodeText","Data":"Sedum erythrostictum Miq.[S. alboroseum Baker; S. spectabile Boreau]，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。全年可采，多鲜用。"}]},{"ID":"20240607130625-7axntug","Type":"NodeParagraph","Properties":{"id":"20240607130625-7axntug","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"酸、苦，平。"}]},{"ID":"20240607130625-8utez3m","Type":"NodeParagraph","Properties":{"id":"20240607130625-8utez3m","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"祛风利湿，活血散瘀，止血止痛。用于喉炎，荨麻疹，吐血，小儿丹毒，乳腺炎；外用治疔疮痈肿，跌打损伤，鸡眼，烧烫伤，毒蛇咬伤，带状疱疹，脚癣。"}]},{"ID":"20240607130625-yazu079","Type":"NodeParagraph","Properties":{"id":"20240607130625-yazu079","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"0.5～1两；外用适量，捣烂敷患处或捣汁外搽患处。"}]},{"ID":"20240607130625-nbt2jnv","Type":"NodeParagraph","Properties":{"id":"20240607130625-nbt2jnv","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《全国中草药汇编》"}]},{"ID":"20240607130625-k5wo9vv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130625-k5wo9vv","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：景天"}]},{"ID":"20240607130625-gispzav","Type":"NodeParagraph","Properties":{"id":"20240607130625-gispzav","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Jǐnɡ Tiān"}]},{"ID":"20240607130625-t5u6qve","Type":"NodeParagraph","Properties":{"id":"20240607130625-t5u6qve","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"戒火、慎火（《本经》），火母、据火、救火（《别录》），慎火草（《千金方》），护花草、拔火、谨火（《履巉岩本草》），挂臂青（《本草蒙筌》），护火、辟火（《纲目》），火丹草（《本经逢原》），火焰草、八宝草、佛指甲（《植物名实图考》），火炊灯（《分类草药性》），绣球花、跤蹬草（《福建民间草药》），胡豆七、大打不死（《四川中药志》），土三七（《湖南药物志》），胶稔草、美人草（《闽东本草》）。"}]},{"ID":"20240607130625-2j2ux70","Type":"NodeParagraph","Properties":{"id":"20240607130625-2j2ux70","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"《本经》"}]},{"ID":"20240607130625-xtujcz1","Type":"NodeParagraph","Properties":{"id":"20240607130625-xtujcz1","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"为景天种植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"景天"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。7～8月间采收。"}]},{"ID":"20240607130625-9xvu6iv","Type":"NodeParagraph","Properties":{"id":"20240607130625-9xvu6iv","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"多年生草本。块根胡萝卜状。茎直立，高30～70厘米，不分枝。叶对生，少有为互生或3叶轮生，矩圆形至卵状矩圆形，长4.5～7厘米，宽2～3.5厘米，先端急尖，钝，基部短渐狭，边缘有疏锯齿，无柄。伞房花序顶生；花密生，直径约1厘米；花梗稍短，或与花等长；萼片5，披针形，长1.5毫米；花瓣5，白色至浅红色，宽披针形，长5～6毫米；雄蕊10，与花瓣等长或稍短，花药紫色；鳞片矩圆状楔形，长1毫米；心皮5，直立，基部几分离。"}]},{"ID":"20240607130625-77tqa4o","Type":"NodeParagraph","Properties":{"id":"20240607130625-77tqa4o","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生境分部"},{"Type":"NodeText","Data":"多栽培。或野生于山坡草地及沟边。分布云南、贵州、四川、湖北、陕西、山西、河北、辽宁、吉林、浙江等地。"}]},{"ID":"20240607130625-t4pnrfo","Type":"NodeParagraph","Properties":{"id":"20240607130625-t4pnrfo","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"化学成分"},{"Type":"NodeText","Data":"叶中分得景天庚糖。"}]},{"ID":"20240607130625-rery7rl","Type":"NodeParagraph","Properties":{"id":"20240607130625-rery7rl","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"苦酸，寒。"}]},{"ID":"20240607130625-qsjg7eo","Type":"NodeParagraph","Properties":{"id":"20240607130625-qsjg7eo","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，平。\""}]},{"ID":"20240607130625-0yzp6k0","Type":"NodeParagraph","Properties":{"id":"20240607130625-0yzp6k0","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"酸，无毒。\""}]},{"ID":"20240607130625-jvl0xe1","Type":"NodeParagraph","Properties":{"id":"20240607130625-jvl0xe1","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"冷。\""}]},{"ID":"20240607130625-2jpdvhk","Type":"NodeParagraph","Properties":{"id":"20240607130625-2jpdvhk","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"归经"},{"Type":"NodeText","Data":"①《得配本草》：\"入手少阴经。\""}]},{"ID":"20240607130625-l8znj07","Type":"NodeParagraph","Properties":{"id":"20240607130625-l8znj07","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肝经。\""}]},{"ID":"20240607130625-9dhc3i2","Type":"NodeParagraph","Properties":{"id":"20240607130625-9dhc3i2","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"清热，解毒，止血。治丹毒，游风，烦热惊狂，咯血、吐血，疗疮，肿毒，风疹，漆疮，目赤涩痛，外伤出血。"}]},{"ID":"20240607130625-eln3w3r","Type":"NodeParagraph","Properties":{"id":"20240607130625-eln3w3r","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主大热火疮，身热烦，邪恶气。花主妇人漏下赤白，明目。\""}]},{"ID":"20240607130625-k3lknxc","Type":"NodeParagraph","Properties":{"id":"20240607130625-k3lknxc","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"治痂疕，寒热风痹，诸不足。\""}]},{"ID":"20240607130625-lx26ts2","Type":"NodeParagraph","Properties":{"id":"20240607130625-lx26ts2","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"疗金疮，止血。以洗浴小儿，去烦热惊气。\""}]},{"ID":"20240607130625-zdgn42w","Type":"NodeParagraph","Properties":{"id":"20240607130625-zdgn42w","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治风疹恶痒，主小儿丹毒，治发热惊疾。\""}]},{"ID":"20240607130625-te6ngqs","Type":"NodeParagraph","Properties":{"id":"20240607130625-te6ngqs","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"治心烦热狂，赤眼，头痛寒热，游风丹肿，女人带下。\""}]},{"ID":"20240607130625-oz758na","Type":"NodeParagraph","Properties":{"id":"20240607130625-oz758na","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑥《本草衍义》：\"浓研取汁，涂火心疮。\""}]},{"ID":"20240607130625-k0tf3bk","Type":"NodeParagraph","Properties":{"id":"20240607130625-k0tf3bk","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑦《本草从新》：\"专清热毒。捣敷蛇咬。\""}]},{"ID":"20240607130625-osb4dpt","Type":"NodeParagraph","Properties":{"id":"20240607130625-osb4dpt","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑧《贵州民间方药集》：\"解热，止渴生津，止咳，治喉炎及虫咬伤。\""}]},{"ID":"20240607130625-g3schr8","Type":"NodeParagraph","Properties":{"id":"20240607130625-g3schr8","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑨《四川中药志》：\"叶能贴火眼。\""}]},{"ID":"20240607130625-sxbjiva","Type":"NodeParagraph","Properties":{"id":"20240607130625-sxbjiva","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服：煎汤，0.5～1两；捣汁或入散剂。外用：捣汁涂或煎水洗。"}]},{"ID":"20240607130625-wid580j","Type":"NodeParagraph","Properties":{"id":"20240607130625-wid580j","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"脾胃虚寒者忌服。"}]},{"ID":"20240607130625-chm3297","Type":"NodeParagraph","Properties":{"id":"20240607130625-chm3297","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"一切病得之寒湿，恶寒喜热者勿服。\""}]},{"ID":"20240607130625-lzkrs2m","Type":"NodeParagraph","Properties":{"id":"20240607130625-lzkrs2m","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"苟非实热火邪，切勿轻用以动脾气，惟外涂无碍。\""}]},{"ID":"20240607130625-qukvu74","Type":"NodeParagraph","Properties":{"id":"20240607130625-qukvu74","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"③《闽东本草》：\"忌铁器。虚寒便溏者忌用。\""}]},{"ID":"20240607130625-8o7565h","Type":"NodeParagraph","Properties":{"id":"20240607130625-8o7565h","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复方"},{"Type":"NodeText","Data":"①治小儿殃火丹毒，入腹及阴：慎火草取汁服之。（《千金方》）"}]},{"ID":"20240607130625-pugwzxe","Type":"NodeParagraph","Properties":{"id":"20240607130625-pugwzxe","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"②治小儿烦热惊风：慎火草水煎洗浴。（《普济方》）"}]},{"ID":"20240607130625-8l6eqxl","Type":"NodeParagraph","Properties":{"id":"20240607130625-8l6eqxl","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"③治小儿汗出中风，一日之时，儿头颈腰背热，二日即腹热，手足不屈：慎火草（干者）半两，丹参。麻黄（去根节、先煎掠去沫，焙）、白术各一分。上四味，捣罗为散。一、二岁儿，每服半钱匕，浆水调服；三、四岁儿服一钱匕，日三服，量儿大小加减。（《圣济总录》慎火草散）"}]},{"ID":"20240607130625-ci95bc6","Type":"NodeParagraph","Properties":{"id":"20240607130625-ci95bc6","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"④治小儿风痰抽搐：鲜景天五钱至一两，生姜皮少许，壁蟹壳二个。加水炖服。（《闽东本草》）"}]},{"ID":"20240607130625-2os5r7o","Type":"NodeParagraph","Properties":{"id":"20240607130625-2os5r7o","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑤治疔疮：景天一把，杵烂，调烧酒敷患处。（《闽东本草》）"}]},{"ID":"20240607130625-xtdthb5","Type":"NodeParagraph","Properties":{"id":"20240607130625-xtdthb5","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑥治疮毒及婴孺风疹在皮肤不出者：慎火苗叶五大两，和盐三大两同研，绞取汁，以热手摩涂之，日再，但是热毒丹疮，皆可如此用之。（《本草图经》）"}]},{"ID":"20240607130625-jdhnnws","Type":"NodeParagraph","Properties":{"id":"20240607130625-jdhnnws","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑦治漆疮：挼慎火草若鸡肠草以涂之。漆姑草亦佳。（《肘后方》）"}]},{"ID":"20240607130625-57lrvr1","Type":"NodeParagraph","Properties":{"id":"20240607130625-57lrvr1","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑧治眼生花翳，涩痛：景天草捣绞取汁，日三、五度点之。（《圣惠方》）"}]},{"ID":"20240607130625-han2etu","Type":"NodeParagraph","Properties":{"id":"20240607130625-han2etu","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑨治产后阴下脱：慎火草一斤（阴干）。酒五升，煮取汁，分温四服。（《子母秘录》）"}]},{"ID":"20240607130625-jymqmr5","Type":"NodeParagraph","Properties":{"id":"20240607130625-jymqmr5","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑩治吐血，咯血，咳血：鲜景天叶十多片，冰糖五钱。酌冲开水炖服。"}]},{"ID":"20240607130625-tqll044","Type":"NodeParagraph","Properties":{"id":"20240607130625-tqll044","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑾治肺炎：鲜景天叶一握，捣烂绞汁服。"}]},{"ID":"20240607130625-d5awcko","Type":"NodeParagraph","Properties":{"id":"20240607130625-d5awcko","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⑿治足掌硬疗（因足掌踩硬石头受伤而瘀结作痛）：鲜景天叶一片，浸小便五小时后，取出用火熏烧，乘热罨敷。（⑩方以下出《福建民间草药》）"}]},{"ID":"20240607130625-g9b1auw","Type":"NodeParagraph","Properties":{"id":"20240607130625-g9b1auw","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"⒀热毒丹疮。用景天捣汁涂搽。一昼夜宜搽一、二十次。"}]},{"ID":"20240607130625-2kmrizn","Type":"NodeParagraph","Properties":{"id":"20240607130625-2kmrizn","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《中药大辞典》"}]},{"ID":"20240607130625-zvbgfu3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130625-zvbgfu3","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"《中华本草》：景天"}]},{"ID":"20240607130625-1b07v26","Type":"NodeParagraph","Properties":{"id":"20240607130625-1b07v26","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拼音"},{"Type":"NodeText","Data":"Jǐnɡ Tiān"}]},{"ID":"20240607130625-4yqgp0i","Type":"NodeParagraph","Properties":{"id":"20240607130625-4yqgp0i","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"英文名"},{"Type":"NodeText","Data":"Herb of Common Stonecrop"}]},{"ID":"20240607130625-atgfso7","Type":"NodeParagraph","Properties":{"id":"20240607130625-atgfso7","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名"},{"Type":"NodeText","Data":"戒火、慎火、火母、据火、救火、慎火草、护花草、拔火、谨火、挂壁青、护火、辟火、火丹草、火焰草、八宝草、佛指甲、火炊灯、绣球花、跤蹬草、土三七、龙头三七、蚕豆七、观音扇、橡皮七、活血三七、胶稔草、美人草、猪脚草。"}]},{"ID":"20240607130625-yazmv8f","Type":"NodeParagraph","Properties":{"id":"20240607130625-yazmv8f","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"出处"},{"Type":"NodeText","Data":"1.《名医别录》：景天，生太山川谷。四月、七月采，阴干。"}]},{"ID":"20240607130625-4115axu","Type":"NodeParagraph","Properties":{"id":"20240607130625-4115axu","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：景天，春生苗，叶似马齿而大，作层而上，茎极脆弱，夏中开红紫碎花，秋后枯死，亦有宿根者。四月、七月采其花并苗叶阴干。"}]},{"ID":"20240607130625-j016chq","Type":"NodeParagraph","Properties":{"id":"20240607130625-j016chq","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"来源"},{"Type":"NodeText","Data":"药材基源：为景天科植物八宝的全草。"}]},{"ID":"20240607130625-j4z7nit","Type":"NodeParagraph","Properties":{"id":"20240607130625-j4z7nit","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Hylotelephium erythrostictum（Miq.）H.Ohba[Sedum erythrostictum Miq.]"}]},{"ID":"20240607130625-rzbr0jn","Type":"NodeParagraph","Properties":{"id":"20240607130625-rzbr0jn","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季采挖全草，除去泥土，置沸水中稍烫，晒干。"}]},{"ID":"20240607130625-d3nrtjn","Type":"NodeParagraph","Properties":{"id":"20240607130625-d3nrtjn","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原形态"},{"Type":"NodeText","Data":"八宝 多年生肉质草本，高30-70cm。块根胡萝卜状。茎直立，不分枝，茎节紫色，全株带白粉。叶对生，稀为互生或3叶轮生；近无柄；叶片椭圆形至卵状长圆形，长4.5-10cm，宽2-4cm，先端急尖或钝，基部楔形，边缘有浅波状锯齿。伞房状聚伞花序，项生；花密集，花梗长约1cm；萼片5，披针形或卵形，长1.5mm；花瓣5，白色或粉红色，宽披针形，长5-6mm；雄蕊10，2轮，与花瓣等长或稍短，花药紫色；鳞片5，长圆状楔形，长lmm，先端微缺；心皮 5，分离，针形，淡红色。蓇葖果，直立，带红色或蔷薇红色。花期7-9月，果期10月。"}]},{"ID":"20240607130625-rlb0kz3","Type":"NodeParagraph","Properties":{"id":"20240607130625-rlb0kz3","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生境分部"},{"Type":"NodeText","Data":"生态环境：生于山坡草丛、石缝中或沟边湿地。"}]},{"ID":"20240607130625-sqxmkcz","Type":"NodeParagraph","Properties":{"id":"20240607130625-sqxmkcz","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北及河北、山西、陕西、江苏、安徽、浙江、河南、湖北、四川、贵州、云南等地。"}]},{"ID":"20240607130625-4svfjs9","Type":"NodeParagraph","Properties":{"id":"20240607130625-4svfjs9","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栽培"},{"Type":"NodeText","Data":"1.气候土壤：喜温暖、向阳、能耐旱。以肥沃、疏松的夹砂土栽种最好。"}]},{"ID":"20240607130625-z8dvkh7","Type":"NodeParagraph","Properties":{"id":"20240607130625-z8dvkh7","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"2.种植：用分株繁殖。在2-3月，把老蔸挖起，按芽胞生长情况，分成数小蔸，每小蔸留有芽胞4-5个。在整好的地上，开1.3m宽的畦，按行株距各约33cm开灾，深10-13cm，每穴栽1蔸，填土压紧，施人畜粪水。"}]},{"ID":"20240607130625-e5z3z0k","Type":"NodeParagraph","Properties":{"id":"20240607130625-e5z3z0k","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"3.中耕除草，每年4、6月各进行1次，每次中除后，都要追施人畜粪水1次。每年收获质，宜中除、追肥1次。栽培3-4年，就要翻栽。"}]},{"ID":"20240607130625-txr31zg","Type":"NodeParagraph","Properties":{"id":"20240607130625-txr31zg","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性状"},{"Type":"NodeText","Data":"性状鉴别 根呈圆锥形，表面较粗糙，密生多数细根。茎呈圆柱形，长30-60g，直径2-10mm，表面淡黄绿色、淡紫色或黑棕色，有细纵纹及叶痕。叶多对生，叶片多已碎落，叶展平4后呈长卵形，无柄。有的可见顶生伞房花序或黄白色果实。气微，味甘淡。"}]},{"ID":"20240607130625-x3yjows","Type":"NodeParagraph","Properties":{"id":"20240607130625-x3yjows","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"化学成分"},{"Type":"NodeText","Data":"叶中含有景天庚酮糖（sedoheptulose）。"}]},{"ID":"20240607130625-0ugqhsm","Type":"NodeParagraph","Properties":{"id":"20240607130625-0ugqhsm","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炮制"},{"Type":"NodeText","Data":"挣去杂质，晒干备用。"}]},{"ID":"20240607130625-0ngqzn9","Type":"NodeParagraph","Properties":{"id":"20240607130625-0ngqzn9","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性味"},{"Type":"NodeText","Data":"苦；酸；寒"}]},{"ID":"20240607130625-su9v9lb","Type":"NodeParagraph","Properties":{"id":"20240607130625-su9v9lb","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"归经"},{"Type":"NodeText","Data":"心；肝；肾；大肠经"}]},{"ID":"20240607130625-n0mrnds","Type":"NodeParagraph","Properties":{"id":"20240607130625-n0mrnds","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能主治"},{"Type":"NodeText","Data":"清热解毒；止血。主赤游丹毒；疔疮痈疖；火眼目翳；烦热惊狂；风疹；漆疮；烧烫伤；蛇虫咬伤；吐血；咯血；月经量多；外伤出血"}]},{"ID":"20240607130625-7r3258g","Type":"NodeParagraph","Properties":{"id":"20240607130625-7r3258g","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用法用量"},{"Type":"NodeText","Data":"内服：煎汤，15-30g，鲜品50-100g，或捣汁。外用：适量，捣敷；或取汁摩涂、滴眼；或研粉调搽；或煎水外洗。"}]},{"ID":"20240607130625-pe8psr7","Type":"NodeParagraph","Properties":{"id":"20240607130625-pe8psr7","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"脾胃虚寒者忌服。"}]},{"ID":"20240607130625-31yeesc","Type":"NodeParagraph","Properties":{"id":"20240607130625-31yeesc","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：一切病得之寒湿，恶寒喜热者勿服。"}]},{"ID":"20240607130625-3sm3mhy","Type":"NodeParagraph","Properties":{"id":"20240607130625-3sm3mhy","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：苟非实热火邪，切勿轻用以动脾气，惟外涂无碍。"}]},{"ID":"20240607130625-benxjqm","Type":"NodeParagraph","Properties":{"id":"20240607130625-benxjqm","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"3.《闽东本草》：忌铁器。虚寒便溏者忌用。"}]},{"ID":"20240607130625-hfe0n5w","Type":"NodeParagraph","Properties":{"id":"20240607130625-hfe0n5w","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复方"},{"Type":"NodeText","Data":"①治小儿殃火丹毒，入腹及阴： 慎火草取汁服之。(《干金方》)②治小儿烦热惊风： 慎火草水煎洗浴。 (《普济方》)③治小儿汗出中风，一日之时，儿头颈腰背热，二日即腹热，手足不屈： 慎火草(干者)半两，丹参、麻黄(去根节、先煎掠去沫，焙)、白术各一分。上四味，捣罗为散。一、二岁儿，每服半钱匕，浆水调服；三、四岁儿服一钱匕，日三服，量儿大小加减。 (《圣济总录》慎火草散)④治小儿风痰抽搐： 鲜景天五钱至一两，生姜皮少许，壁蟹壳二个。加水炖服。(《闽东本草》)⑤治疗疮： 景天一把，杵烂，调烧酒敷患处。 (《闽东本草》)⑥治疮毒及婴孺风疹在皮肤不出者： 慎火苗叶五大两，和盐三大两同研，绞取汁，以热手摩涂之，日再，但是热毒丹疮，皆可如此用之。(《本草图经》)⑦治漆疮：LUE慎火草若鸡肠草以涂之。漆姑草亦佳。(《肘后方》)⑧治眼生花翳，涩痛： 景天草捣绞取汁，日三、五度点之。(《圣惠方》)⑨治产后阴下脱： 慎火草一斤(阴干)。酒五升，煮取汁，分温四服。 (《子母秘录》)⑩治吐血，咯血，咳血： 鲜景天叶十多片，冰糖五钱。酌冲开水炖服。(11)治肺炎： 鲜景天叶一握，捣烂绞汁服。(12)治足掌硬疔(因足掌踩硬石头受伤而瘀结作痛)： 鲜景天叶一片，浸小便五小时后，取出用火熏烧，乘热罨敷。 (⑩方以下出《福建民间草药》)"}]},{"ID":"20240607130625-0vk2oxz","Type":"NodeParagraph","Properties":{"id":"20240607130625-0vk2oxz","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"各家论述"},{"Type":"NodeText","Data":"1.《本经》：主大热火疮，身热烦，邪恶气。花主妇人漏下赤白，明目。"}]},{"ID":"20240607130625-90ib8hv","Type":"NodeParagraph","Properties":{"id":"20240607130625-90ib8hv","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"2.《别录》：治痂，寒热风痹，诸不足。"}]},{"ID":"20240607130625-nf1r183","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607130625-nf1r183","updated":"20240607130625"},"Children":[{"ID":"20240607130625-r0vu001","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240607130625-r0vu001","updated":"20240607130625"},"Children":[{"ID":"20240607130625-6a2kooe","Type":"NodeParagraph","Properties":{"id":"20240607130625-6a2kooe","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"陶弘景：疗金疮，止血。以洗浴小儿，去烦热惊气。"}]}]}]},{"ID":"20240607130625-q8ew2er","Type":"NodeParagraph","Properties":{"id":"20240607130625-q8ew2er","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：治风疹恶痒，主小儿丹毒，治发热惊疾。"}]},{"ID":"20240607130625-nw5d9dp","Type":"NodeParagraph","Properties":{"id":"20240607130625-nw5d9dp","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：治心烦热狂，赤眼，头痛寒热，游风丹肿，女人带下。"}]},{"ID":"20240607130625-gx87yrk","Type":"NodeParagraph","Properties":{"id":"20240607130625-gx87yrk","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"6.《本草衍义》：浓研取汁，涂火心疮。"}]},{"ID":"20240607130625-5idwdqf","Type":"NodeParagraph","Properties":{"id":"20240607130625-5idwdqf","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"7.《本草从新》：专清热毒。捣敷蛇咬。"}]},{"ID":"20240607130625-lvbobuk","Type":"NodeParagraph","Properties":{"id":"20240607130625-lvbobuk","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"8.《贵州民间方药集》：解热，止渴生律，止咳，治喉炎及虫咬伤。"}]},{"ID":"20240607130625-7xvzey8","Type":"NodeParagraph","Properties":{"id":"20240607130625-7xvzey8","updated":"20240607130625"},"Children":[{"Type":"NodeText","Data":"9.《四川中药志》：叶能贴火眼。"}]},{"ID":"20240607130625-ppp10bt","Type":"NodeParagraph","Properties":{"id":"20240607130625-ppp10bt","updated":"20240607130625"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘录"},{"Type":"NodeText","Data":"《中华本草》"}]},{"ID":"20240607130626-xs8934l","Type":"NodeThematicBreak","Properties":{"id":"20240607130626-xs8934l"}},{"ID":"20240607130629-hw918a5","Type":"NodeParagraph","Properties":{"id":"20240607130629-hw918a5"}}]}