{"ID":"20240206084507-r9c4xmh","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240206084507-r9c4xmh","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206084507-r9c4xmh\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240620090839-0018srf\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607130625-te6ngqs\u0026quot;,\u0026quot;scrollTop\u0026quot;:1900,\u0026quot;focusId\u0026quot;:\u0026quot;20240620090901-yubey0g\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"076景天（八宝景天、景天三七）","type":"doc","updated":"20240807175522"},"Children":[{"ID":"20240620090839-0018srf","Type":"NodeParagraph","Properties":{"id":"20240620090839-0018srf","updated":"20240620090839"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 384px;","style":"width: 374px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620090839-fyh0tl3.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 374px;\" parent-style=\"width: 384px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620085841-zsovqdv","Type":"NodeParagraph","Properties":{"id":"20240620085841-zsovqdv","updated":"20240722152857"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620085411-zb0y1ed.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620085832-03xg2lb","Typ