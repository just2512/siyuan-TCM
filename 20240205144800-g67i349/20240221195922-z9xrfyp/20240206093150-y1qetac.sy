px;\" parent-style=\"width: 363px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"徐长卿 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/徐长卿 8-20240808083440-27l7d8d.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 477px;","style":"width: 467px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"徐长卿 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/徐长卿 9-20240808083551-p0pjxiu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 467px;\" parent-style=\"width: 477px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808082048-syfkp47","Type":"NodeParagraph","Properties":{"id":"20240808082048-syfkp47","updated":"20240808084224"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 421px;","style":"width: 411px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"徐长卿 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/徐长卿 12-20240808084139-og1g06s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 411px;\" parent-style=\"width: 421px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 423px;","style":"width: 413px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"徐长卿"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/徐长卿-20240808082048-6gtqlox.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 413px;\" parent-style=\"width: 423px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 377px;","style":"width: 367px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"徐长卿 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/徐长卿 10-20240808083905-uuot7u7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 367px;\" parent-style=\"width: 377px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240617082028-md3qcvc","Type":"NodeThematicBreak","Properties":{"id":"20240617082028-md3qcvc"}},{"ID":"20240617082306-r4m8o9l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617082306-r4m8o9l","updated":"20240617082311"},"Children":[{"Type":"NodeText","Data":"徐长卿《神农本草经》"}]},{"ID":"20240617082306-fyo03qs","Type":"NodeParagraph","Properties":{"id":"20240617082306-fyo03qs","updated":"20240617082306"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240617082306-8o68hxq","Type":"NodeParagraph","Properties":{"id":"20240617082306-8o68hxq","updated":"20240617082306"},"Children":[{"Type":"NodeText","Data":"主鬼物，百精，蛊毒，疫疾邪恶气，温疟。久服，强悍轻身。一名鬼督邮。生山谷。"}]},{"ID":"20240617082306-z6we5m7","Type":"NodeParagraph","Properties":{"id":"20240617082306-z6we5m7","updated":"20240617082306"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：徐长卿，一名石下长卿，神农雷公辛，或生陇西，三月采（《御览》）。"}]},{"ID":"20240617082306-t49qpf6","Type":"NodeParagraph","Properties":{"id":"20240617082306-t49qpf6","updated":"20240617082306"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生太山及陇西，三月采。"}]},{"ID":"20240617082306-9jn5v0a","Type":"NodeParagraph","Properties":{"id":"20240617082306-9jn5v0a","updated":"20240617082306"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：徐长卿，鬼督邮也；陶宏景云：鬼督邮之名甚多，今俗用徐长卿者，其根正如细辛，小短扁扁尔，气亦相似。"}]},{"ID":"20240617082052-totahti","Type":"NodeThematicBreak","Properties":{"id":"20240617082052-totahti"}},{"ID":"20240617082053-zpyowyy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617082053-zpyowyy","updated":"20240617082057"},"Children":[{"Type":"NodeText","Data":"徐长卿《千金翼方》"}]},{"ID":"20240617082053-rp5qiwr","Type":"NodeParagraph","Properties":{"id":"20240617082053-rp5qiwr","updated":"20240617082053"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主鬼物百精蛊毒，疫疾邪恶气，温疟。久服强悍，轻身，益气延年。"}]},{"ID":"20240617082053-5xzi5qq","Type":"NodeParagraph","Properties":{"id":"20240617082053-5xzi5qq","updated":"20240617082053"},"Children":[{"Type":"NodeText","Data":"一名鬼督邮，生太山山谷及陇西，三月采。"}]},{"ID":"20240617082028-hggf0oo","Type":"NodeThematicBreak","Properties":{"id":"20240617082028-hggf0oo"}},{"ID":"20240617082044-re2lqnx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617082044-re2lqnx","updated":"20240617082048"},"Children":[{"Type":"NodeText","Data":"徐长卿《名医别录》"}]},{"ID":"20240617082044-uwy17ge","Type":"NodeParagraph","Properties":{"id":"20240617082044-uwy17ge","updated":"20240617082044"},"Children":[{"Type":"NodeText","Data":"无毒．久服益气延年．生太山及陇西，三月采．"}]},{"ID":"20240617082044-j6s6pwn","Type":"NodeParagraph","Properties":{"id":"20240617082044-j6s6pwn","updated":"20240617082044"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶徐长卿，味辛，温．主鬼物百精蛊毒，疫疾邪恶气，温疟．久服强悍轻身．"}]},{"ID":"20240617082029-0a3xdjr","Type":"NodeThematicBreak","Properties":{"id":"20240617082029-0a3xdjr"}},{"ID":"20240617082030-exxp653","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617082030-exxp653","updated":"20240617082038"},"Children":[{"Type":"NodeText","Data":"徐长卿《吴普本草》"}]},{"ID":"20240617082030-2vxi3zm","Type":"NodeParagraph","Properties":{"id":"20240617082030-2vxi3zm","updated":"20240617082030"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十一"}]},{"ID":"20240617082030-gs1yzyj","Type":"NodeParagraph","Properties":{"id":"20240617082030-gs1yzyj","updated":"20240617082030"},"Children":[{"Type":"NodeText","Data":"一名石下长卿。神农、雷公∶辛。或生陇西。三月采。"}]},{"ID":"20240617081910-7lfn2av","Type":"NodeThematicBreak","Properties":{"id":"20240617081910-7lfn2av"}},{"ID":"20240617082017-5sgmw26","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617082017-5sgmw26","updated":"20240617082022"},"Children":[{"Type":"NodeText","Data":"徐长卿《冯氏锦囊秘录》"}]},{"ID":"20240617082017-wh939i8","Type":"NodeParagraph","Properties":{"id":"20240617082017-wh939i8","updated":"20240617082017"},"Children":[{"Type":"NodeText","Data":"徐长卿去虫毒疫疾，杀鬼物精邪，祛温疟逐恶气。"}]},{"ID":"20240617081910-nky1az3","Type":"NodeThematicBreak","Properties":{"id":"20240617081910-nky1az3"}},{"ID":"20240617082005-kr24plw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617082005-kr24plw","updated":"20240617082011"},"Children":[{"Type":"NodeText","Data":"徐长卿《神农本草经赞》"}]},{"ID":"20240617082005-tnu7eic","Type":"NodeParagraph","Properties":{"id":"20240617082005-tnu7eic","updated":"20240617082005"},"Children":[{"Type":"NodeText","Data":"味辛温。主鬼物百精蛊毒。疫疾邪恶气温疟。久服强悍轻身。一名鬼督邮。生山谷言名名物。以作尔庸。寄怀幽石。别访仙踪。桑苗纤绕。柳叶茸。蠲疫驱疟。不若不逢。"}]},{"ID":"20240617082005-pnyzc5d","Type":"NodeParagraph","Properties":{"id":"20240617082005-pnyzc5d","updated":"20240617082005"},"Children":[{"Type":"NodeText","Data":"家语。高辛生而自言其名。周礼。辨其名物。诗。以作尔庸。吴普曰。一名石下长卿。"}]},{"ID":"20240617082005-s3ie53c","Type":"NodeParagraph","Properties":{"id":"20240617082005-s3ie53c","updated":"20240617082005"},"Children":[{"Type":"NodeText","Data":"苏颂曰。一名别仙踪。韩保升曰。苗似小桑。苏恭曰。叶似柳两叶相当。繁钦赋。微条纤绕。李商隐诗。垂柳碧茸。李华赋。养命蠲疫。杨万里诗。不须杜句能驱虐。左传。川泽山林。"}]},{"ID":"20240617082005-7tt9sji","Type":"NodeParagraph","Properties":{"id":"20240617082005-7tt9sji","updated":"20240617082005"},"Children":[{"Type":"NodeText","Data":"不逢不若。"}]},{"ID":"20240617081910-0f0t413","Type":"NodeThematicBreak","Properties":{"id":"20240617081910-0f0t413"}},{"ID":"20240617081954-iibsdiy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617081954-iibsdiy","updated":"20240617082000"},"Children":[{"Type":"NodeText","Data":"徐长卿《新修本草》"}]},{"ID":"20240617081954-6em6v8x","Type":"NodeParagraph","Properties":{"id":"20240617081954-6em6v8x","updated":"20240617081954"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主鬼物百精蛊毒，疫疾邪恶气，温疟。久服强悍轻身。益气，延年。"}]},{"ID":"20240617081954-lysg7n4","Type":"NodeParagraph","Properties":{"id":"20240617081954-lysg7n4","updated":"20240617081954"},"Children":[{"Type":"NodeText","Data":"一名鬼督邮。生太山山谷及陇西，三月采。"}]},{"ID":"20240617081954-4bcp8ny","Type":"NodeParagraph","Properties":{"id":"20240617081954-4bcp8ny","updated":"20240617081954"},"Children":[{"Type":"NodeText","Data":"鬼督邮之名甚多。今俗用徐长卿者，其根正如细辛，小短扁扁尔，气亦相似。今狗脊散用鬼督邮，当取其强悍宜腰脚，所以知是徐长卿，而非鬼箭、赤箭。"}]},{"ID":"20240617081954-i9gxfku","Type":"NodeParagraph","Properties":{"id":"20240617081954-i9gxfku","updated":"20240617081954"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药，叶似柳，两叶相当，有光润，所在川泽有之。根如细辛，微粗长，而有臊气。今俗用代鬼督邮，非也。鬼督邮别有本条，在下。"}]},{"ID":"20240617081910-rq31yt6","Type":"NodeThematicBreak","Properties":{"id":"20240617081910-rq31yt6"}},{"ID":"20240617081911-zrzioci","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617081911-zrzioci","updated":"20240617081915"},"Children":[{"Type":"NodeText","Data":"徐长卿《本草纲目》"}]},{"ID":"20240617081911-5vxuvkn","Type":"NodeParagraph","Properties":{"id":"20240617081911-5vxuvkn","updated":"20240617081911"},"Children":[{"Type":"NodeText","Data":"「释名」亦名鬼督邮、别仙踪。"}]},{"ID":"20240617081911-05nge4x","Type":"NodeParagraph","Properties":{"id":"20240617081911-05nge4x","updated":"20240617081911"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、温、无毒（陶弘景认为有毒）。"}]},{"ID":"20240617081911-iwt7t1x","Type":"NodeParagraph","Properties":{"id":"20240617081911-iwt7t1x","updated":"20240617081911"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240617081911-yn9myad","Type":"NodeParagraph","Properties":{"id":"20240617081911-yn9myad","updated":"20240617081911"},"Children":[{"Type":"NodeText","Data":"1、小便不通。用徐长卿（灸过）半两，茅根三分，木通、冬葵子各一两，滑石二两，槟榔一分，瞿麦穗半两。每服五钱，水煎，再加朴硝一钱，温服。此方名“徐长卿汤”。"}]},{"ID":"20240617081911-tkwdc07","Type":"NodeParagraph","Properties":{"id":"20240617081911-tkwdc07","updated":"20240617081911"},"Children":[{"Type":"NodeText","Data":"2、晕车晕船。用徐长卿、石长生、车前子、车下李根等分捣碎，取半合装在袋子里悬衣带上。"}]},{"ID":"20240617081911-iotzoue","Type":"NodeParagraph","Properties":{"id":"20240617081911-iotzoue","updated":"20240617081911"},"Children":[{"Type":"NodeText","Data":"徐长卿亦治疫疾、邪恶气、温疟等。"}]},{"ID":"20240617081941-wt4w8qi","Type":"NodeThematicBreak","Properties":{"id":"20240617081941-wt4w8qi"}},{"ID":"20240617081942-voml5ur","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617081942-voml5ur","updated":"20240617081947"},"Children":[{"Type":"NodeText","Data":"徐长卿《本草经集注》"}]},{"ID":"20240617081942-ab31t1v","Type":"NodeParagraph","Properties":{"id":"20240617081942-ab31t1v","updated":"20240617081942"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主治鬼物百精，蛊毒，疫疾，邪恶气，温疟。久服强悍，轻身。益气，延年。一名鬼督邮。生太山山谷及陇西，三月采。"}]},{"ID":"20240617081942-nhoze1n","Type":"NodeParagraph","Properties":{"id":"20240617081942-nhoze1n","updated":"20240617081942"},"Children":[{"Type":"NodeText","Data":"鬼督邮之名甚多。今世用徐长卿者，其根正如细辛，小短扁扁尔，气亦相似。"}]},{"ID":"20240617081922-9e12q0j","Type":"NodeThematicBreak","Properties":{"id":"20240617081922-9e12q0j"}},{"ID":"20240617081923-2rhs60r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617081923-2rhs60r","updated":"20240617081927"},"Children":[{"Type":"NodeText","Data":"徐长卿《中药学》"}]},{"ID":"20240617081923-pwk2gog","Type":"NodeParagraph","Properties":{"id":"20240617081923-pwk2gog","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【药用】梦藦科苍本植物徐长卿Cynanchumpaniculatum（Bge.）Kitag的根及根茎。"}]},{"ID":"20240617081923-kfeh7ti","Type":"NodeParagraph","Properties":{"id":"20240617081923-kfeh7ti","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛，温。归肝、胃经。"}]},{"ID":"20240617081923-p9a2cny","Type":"NodeParagraph","Properties":{"id":"20240617081923-p9a2cny","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【功效】祛风通络，止痛，止痒，解毒消肿。"}]},{"ID":"20240617081923-vcikqve","Type":"NodeParagraph","Properties":{"id":"20240617081923-vcikqve","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于风湿痹痛"}]},{"ID":"20240617081923-muarp48","Type":"NodeParagraph","Properties":{"id":"20240617081923-muarp48","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"本品善于祛风，功能通络止痛，用于风湿关节疼痛，可配合虎杖等同用。"}]},{"ID":"20240617081923-rc6wu39","Type":"NodeParagraph","Properties":{"id":"20240617081923-rc6wu39","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"2.用于脘腹痛，牙痛，跌仆伤痛等症。"}]},{"ID":"20240617081923-sxqdw53","Type":"NodeParagraph","Properties":{"id":"20240617081923-sxqdw53","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"徐长卿具有良好的止痛作用，临床上多用于多种疼痛，能取显着的止痛效果，适用于脘腹痛、牙痛及跌打损伤疼痛诸症，可单味应用或随症配伍有关药物。"}]},{"ID":"20240617081923-sdhwdoa","Type":"NodeParagraph","Properties":{"id":"20240617081923-sdhwdoa","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"3.用于湿疹，风疹瘙痒，顽癣等症。"}]},{"ID":"20240617081923-mt9g90y","Type":"NodeParagraph","Properties":{"id":"20240617081923-mt9g90y","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"本品又长于祛风止痒，善治湿疹、风疹、顽癣等皮肤瘙痒之症，可单味煎汤内服，或煎汤外洗，亦可配合苦参、地肤子、白鲜皮等药同用。"}]},{"ID":"20240617081923-0oeiky4","Type":"NodeParagraph","Properties":{"id":"20240617081923-0oeiky4","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"4.用于毒蛇咬伤。"}]},{"ID":"20240617081923-0302fs7","Type":"NodeParagraph","Properties":{"id":"20240617081923-0302fs7","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"本品又能解毒消肿，对于毒蛇咬伤，可配合半边莲、野菊花等药同用。"}]},{"ID":"20240617081923-1xlqg6j","Type":"NodeParagraph","Properties":{"id":"20240617081923-1xlqg6j","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"此外，古代医家认为本品具有通利小便作用；现代又常用于登山呕吐、晕车晕船等症。"}]},{"ID":"20240617081923-hgior4h","Type":"NodeParagraph","Properties":{"id":"20240617081923-hgior4h","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【处方用名】徐长卿、寮刁竹（洗净，晒干，切碎用）"}]},{"ID":"20240617081923-orzuz6x","Type":"NodeParagraph","Properties":{"id":"20240617081923-orzuz6x","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240617081923-2oa69wf","Type":"NodeParagraph","Properties":{"id":"20240617081923-2oa69wf","updated":"20240617081923"},"Children":[{"Type":"NodeText","Data":"【方剂举例】徐长卿汤（《圣惠方》）：徐长卿、茅根、木通、冬葵子、滑石、槟榔、瞿麦、朴硝。治气壅关格不通，小便淋结，脐下妨闷。"}]},{"ID":"20240607131507-luh24b4","Type":"NodeThematicBreak","Properties":{"id":"20240607131507-luh24b4"}},{"ID":"20240607131522-qvze4ut","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607131522-qvze4ut","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"《中国药典》：徐长卿"}]},{"ID":"20240607131522-gra0boo","Type":"NodeParagraph","Properties":{"id":"20240607131522-gra0boo","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607131522-z5bmqb5","Type":"NodeParagraph","Properties":{"id":"20240607131522-z5bmqb5","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" Xú Chánɡ Qīnɡ"}]},{"ID":"20240607131522-4ey8qmp","Type":"NodeParagraph","Properties":{"id":"20240607131522-4ey8qmp","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607131522-15k5vgk","Type":"NodeParagraph","Properties":{"id":"20240607131522-15k5vgk","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 寮刁竹、逍遥竹、遥竹逍、瑶山竹、了刁竹、对节莲、竹叶细辛、铜锣草、一枝香、英雄草"}]},{"ID":"20240607131522-p5pv3du","Type":"NodeParagraph","Properties":{"id":"20240607131522-p5pv3du","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607131522-4mg7rvk","Type":"NodeParagraph","Properties":{"id":"20240607131522-4mg7rvk","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" RADIX CYNANCHI PANICULATI"}]},{"ID":"20240607131522-ysgo0jq","Type":"NodeParagraph","Properties":{"id":"20240607131522-ysgo0jq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607131522-20xhhhj","Type":"NodeParagraph","Properties":{"id":"20240607131522-20xhhhj","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 本品为萝藦科牛皮消属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"徐长卿"},{"Type":"NodeText","Data":"Cynanchum paniculatum （Bge.）Kitag. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。秋季采挖，除去杂质，阴干。"}]},{"ID":"20240607131522-bg9b8gg","Type":"NodeParagraph","Properties":{"id":"20240607131522-bg9b8gg","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607131522-u2gwi9m","Type":"NodeParagraph","Properties":{"id":"20240607131522-u2gwi9m","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 本品根茎呈不规则柱状，有盘节，长0。5～3。5cm，直径2～4mm。有的顶端带有残茎，细圆柱形，长约2cm，直径1～2mm，断面中空；根茎节处周围着生多数根。根呈细长圆柱形，弯曲，长10～16cm，直径1～1。5mm。表面淡黄白色至淡棕黄色，或棕色；具微细的纵皱纹，并有纤细的须根。质脆，易折断，断面粉性，皮部类白色或黄白色，形成层环淡棕色，木部细小。气香，味微辛凉。"}]},{"ID":"20240607131522-ixg57jq","Type":"NodeParagraph","Properties":{"id":"20240607131522-ixg57jq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607131522-hu2xsqu","Type":"NodeParagraph","Properties":{"id":"20240607131522-hu2xsqu","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 除去杂质，迅速洗净，切段，阴干。"}]},{"ID":"20240607131522-ppsfmtk","Type":"NodeParagraph","Properties":{"id":"20240607131522-ppsfmtk","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607131522-wb8v7os","Type":"NodeParagraph","Properties":{"id":"20240607131522-wb8v7os","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" （1）取本品粉末0。5g，置试管中，加水2ml ，管口盖一块用水湿润的滤纸，滤纸上加氯亚氨基－2，6-二氯醌1 份与四硼酸钠32份的混合粉末少量，铺匀，将试管加热至微沸，滤纸即显蓝色。"}]},{"ID":"20240607131522-3pgkdly","Type":"NodeParagraph","Properties":{"id":"20240607131522-3pgkdly","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加乙醚10ml，密塞，振摇10分钟，滤过，滤液挥干，残渣加丙酮1ml 使溶解，作为供试品溶液。另取丹皮酚对照品，加丙酮制成每1ml 含2mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液5μl、对照品溶液10μl，分别点于同一硅胶Ｇ薄层板上，以环己烷－醋酸乙酯（3:1）为展开剂，展开，取出，晾干，喷以盐酸酸性5％的三氯化铁乙醇溶液，加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同的蓝褐色斑点。"}]},{"ID":"20240607131522-bd6ld63","Type":"NodeParagraph","Properties":{"id":"20240607131522-bd6ld63","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607131522-tb01koe","Type":"NodeParagraph","Properties":{"id":"20240607131522-tb01koe","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 归肝、胃经。"}]},{"ID":"20240607131522-9usf1wv","Type":"NodeParagraph","Properties":{"id":"20240607131522-9usf1wv","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607131522-qhu3b72","Type":"NodeParagraph","Properties":{"id":"20240607131522-qhu3b72","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240607131522-3tzfviy","Type":"NodeParagraph","Properties":{"id":"20240607131522-3tzfviy","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607131522-q3fhfvq","Type":"NodeParagraph","Properties":{"id":"20240607131522-q3fhfvq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 祛风化湿，止痛止痒。用于风湿痹痛，胃痛胀满，牙痛，腰痛，跌扑损伤，荨麻疹、湿疹。"}]},{"ID":"20240607131522-m850tpr","Type":"NodeParagraph","Properties":{"id":"20240607131522-m850tpr","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607131522-cf8qck3","Type":"NodeParagraph","Properties":{"id":"20240607131522-cf8qck3","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 3～12g，入煎剂宜后下。"}]},{"ID":"20240607131522-xn063f0","Type":"NodeParagraph","Properties":{"id":"20240607131522-xn063f0","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607131522-felv3np","Type":"NodeParagraph","Properties":{"id":"20240607131522-felv3np","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" （1）适用于脘腹痛、牙痛及跌打损伤疼痛诸症，可单味应用或随症配伍有关药物。治湿疹、风疹、顽癣等皮肤瘙痒之症，可单味煎汤内服，或煎汤外洗，亦可配合苦参、地肤子、白鲜皮等药同用。对于毒蛇咬伤，可配合半边莲、野菊花等药同用。（2）古代医家认为本品具有通利小便作用；现代又常用于登山呕吐、晕车晕船等症。"}]},{"ID":"20240607131522-8ofqz4c","Type":"NodeParagraph","Properties":{"id":"20240607131522-8ofqz4c","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607131522-j0pc5ee","Type":"NodeParagraph","Properties":{"id":"20240607131522-j0pc5ee","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607131522-bvcdtxa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607131522-bvcdtxa","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：徐长卿"}]},{"ID":"20240607131522-apqhxt0","Type":"NodeParagraph","Properties":{"id":"20240607131522-apqhxt0","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607131522-s5xy86o","Type":"NodeParagraph","Properties":{"id":"20240607131522-s5xy86o","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" Xú Chánɡ Qīnɡ"}]},{"ID":"20240607131522-08f5eds","Type":"NodeParagraph","Properties":{"id":"20240607131522-08f5eds","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607131522-koppftg","Type":"NodeParagraph","Properties":{"id":"20240607131522-koppftg","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 鬼督邮、石下长卿（《本经》），别仙踪（《本草图经》），料刁竹（《生草药性备要》），钓鱼竿、逍遥竹、一枝箭（《简易草药》），英雄草、料吊（《本草求原》），土细辛、九头狮子草（《植物名实图考》），竹叶细辛（《植物名汇》），铃柴胡（《植物学大辞典》），生竹（《岭南采药录》），一枝香、牙蛀消、线香草（《中国药植志》），小对叶草、对月草（《贵州民间方药集》），天竹、溪柳、蛇草（《福建民间草药》），瑶山竹（《广西中兽医药植》），黑薇、蜈蚣草、铜锣草（《东北药植志》），山刁竹、蛇利草、药王（《南宁市药物志》）"}]},{"ID":"20240607131522-me82010","Type":"NodeParagraph","Properties":{"id":"20240607131522-me82010","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607131522-wausq5i","Type":"NodeParagraph","Properties":{"id":"20240607131522-wausq5i","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607131522-aq8wdc2","Type":"NodeParagraph","Properties":{"id":"20240607131522-aq8wdc2","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607131522-px009oh","Type":"NodeParagraph","Properties":{"id":"20240607131522-px009oh","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 为萝藦科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"徐长卿"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带根全草"},{"Type":"NodeText","Data":"。夏季连根掘起，洗净，晒干。"}]},{"ID":"20240607131522-rkz9vyw","Type":"NodeParagraph","Properties":{"id":"20240607131522-rkz9vyw","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607131522-xvx80rh","Type":"NodeParagraph","Properties":{"id":"20240607131522-xvx80rh","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 野生于山坡或路旁。全国大部分地区均有分布。产于江苏、河北、湖南、安徽、贵州、广西及东北等地。"}]},{"ID":"20240607131522-xez6zz8","Type":"NodeParagraph","Properties":{"id":"20240607131522-xez6zz8","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607131522-l8xpong","Type":"NodeParagraph","Properties":{"id":"20240607131522-l8xpong","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高约65厘米。根茎短，须状根多数。茎细，刚直，节间长。叶对生，披针形至线形，长约5～14厘米，宽约2～8毫米，先端尖，全缘，边缘稍外反，有缘毛，基部渐狭，下面中脉隆起。圆锥花序顶生于叶腋，总花柄多分枝，花梗细柔，花多数；花萼5深裂，卵状披针形，花冠5深裂，广卵形，平展或下反，黄绿色；副花冠5枚，黄色，肉质，肾形，基部与雄蕊合生；雄蕊5，连成筒状，药2室；雌蕊1，子房上位，由2个离生心皮组成，花柱2，柱头合生。蓇葖果角状。种子顶端着生多数银白色绒毛。花期6～7月。果期9～10月。"}]},{"ID":"20240607131522-be8ddb5","Type":"NodeParagraph","Properties":{"id":"20240607131522-be8ddb5","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607131522-3nuquwz","Type":"NodeParagraph","Properties":{"id":"20240607131522-3nuquwz","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" ①干燥的全草，茎呈细圆柱状，表面灰绿色，基部略带淡紫色，具细纵条纹。质稍脆，折断面纤维性。叶纸质，灰绿色，往往纵向卷折，主脉下面突出，呈淡黄色，茎下部的叶多脱落。"}]},{"ID":"20240607131522-ivsdk5d","Type":"NodeParagraph","Properties":{"id":"20240607131522-ivsdk5d","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"②干燥根茎短而弯曲，长0.5～3.5厘米，深黄褐色，表面具疣状突起的根痕，有时有线状环节。根细长，多数而丛生，直径约1毫米，表面深灰褐色。质脆易断，断面较平，粉质。气香，味微辛。"}]},{"ID":"20240607131522-s9j7zzr","Type":"NodeParagraph","Properties":{"id":"20240607131522-s9j7zzr","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607131522-wgows3b","Type":"NodeParagraph","Properties":{"id":"20240607131522-wgows3b","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 全草含牡丹酚约1％。又找出有与肉珊瑚甙元、去酰牛皮泊甙元、茸毛牛奶藤甙元和去酰萝藦甙元极为相似的物质以及醋酸、桂皮酸等。根含黄酮甙、糖类、氨基酸、牡丹酚。"}]},{"ID":"20240607131522-vvvtp4o","Type":"NodeParagraph","Properties":{"id":"20240607131522-vvvtp4o","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607131522-nhsjhbq","Type":"NodeParagraph","Properties":{"id":"20240607131522-nhsjhbq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 小鼠腹腔注射徐长卿提取液（水煎浓缩，加酒精除去沉淀者，其中不含牡丹酚），能显着减少自发活动，但并不延长巴比妥类的睡眠时间，也有镇痛作用（热板法）。家兔静脉注射则可出现短时间惊厥。上述制剂并能降低狗、家兔和大鼠的血压，因此，除牡丹酚外，徐长卿尚含其他降压成分。徐长卿可减慢正常动物的心率。连续给药7天不能防止家兔静脉滴注脑垂体后叶素引起的心肌急性缺氧性心电图变化。在试管内对痢疾杆菌、金黄色葡萄球菌等有抑制作用。"}]},{"ID":"20240607131522-qce1qyp","Type":"NodeParagraph","Properties":{"id":"20240607131522-qce1qyp","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607131522-o9mecxg","Type":"NodeParagraph","Properties":{"id":"20240607131522-o9mecxg","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 拣净杂草，洗净，润透，切成长1.5厘米段，晒干。"}]},{"ID":"20240607131522-w0tmg5v","Type":"NodeParagraph","Properties":{"id":"20240607131522-w0tmg5v","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607131522-du91d4h","Type":"NodeParagraph","Properties":{"id":"20240607131522-du91d4h","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240607131522-uvky9gk","Type":"NodeParagraph","Properties":{"id":"20240607131522-uvky9gk","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240607131522-53ncg0r","Type":"NodeParagraph","Properties":{"id":"20240607131522-53ncg0r","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607131522-ejku8i1","Type":"NodeParagraph","Properties":{"id":"20240607131522-ejku8i1","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607131522-to2nuzb","Type":"NodeParagraph","Properties":{"id":"20240607131522-to2nuzb","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 体弱者慎服。"}]},{"ID":"20240607131522-slp0lip","Type":"NodeParagraph","Properties":{"id":"20240607131522-slp0lip","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607131522-q6gmk55","Type":"NodeParagraph","Properties":{"id":"20240607131522-q6gmk55","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 镇痛，止咳，利水消肿，活血解毒。治胃痛，牙痛，风湿疼痛，经期腹痛，慢性气管炎，腹水，水肿，痢疾，肠炎，跌打损伤，湿疹，荨麻疹，毒蛇咬伤。"}]},{"ID":"20240607131522-hhdqv7f","Type":"NodeParagraph","Properties":{"id":"20240607131522-hhdqv7f","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"1、用于风湿痹痛、腰痛、跌打损伤疼痛、脘腹痛、牙痛等各种痛症。徐长卿有较好的祛风止痛作用，广泛地用于风湿、寒凝、气滞、血瘀所致的各种痛症。近年来也用于手术后疼痛及癌肿疼痛，有一定的止痛作用。可单味应用，或随证配伍有关的药物。"}]},{"ID":"20240607131522-tnpj4rq","Type":"NodeParagraph","Properties":{"id":"20240607131522-tnpj4rq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"2、用湿疹、风疹块、顽癣等皮肤病。本品有祛风止痒作用。可单用内服或煎汤外洗，亦可配伍苦参、地肤子、白鲜皮等清利湿热的药物。此外，本品还能解蛇毒，治毒蛇咬伤。可与半边莲同用内服或外用。"}]},{"ID":"20240607131522-omu1guw","Type":"NodeParagraph","Properties":{"id":"20240607131522-omu1guw","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主蛊毒，疫疾，邪恶气，温疟，\"\"主注易亡走，啼哭，悲伤，恍惚。\""}]},{"ID":"20240607131522-kub4clh","Type":"NodeParagraph","Properties":{"id":"20240607131522-kub4clh","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"益气。\""}]},{"ID":"20240607131522-114t02z","Type":"NodeParagraph","Properties":{"id":"20240607131522-114t02z","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"③《生草药性备要》：\"浸酒，除风湿。\""}]},{"ID":"20240607131522-1gpqtib","Type":"NodeParagraph","Properties":{"id":"20240607131522-1gpqtib","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"④《简易草药》：\"治跌打损伤，筋骨疼痛。\""}]},{"ID":"20240607131522-3g4udrg","Type":"NodeParagraph","Properties":{"id":"20240607131522-3g4udrg","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑤《岭南采药录》：\"治小儿腹胀，青筋出现。又治癫狗咬伤。\""}]},{"ID":"20240607131522-mmawzgv","Type":"NodeParagraph","Properties":{"id":"20240607131522-mmawzgv","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑥《中国药植志》：\"治一切痧症和肚痛，胃气痛，食积，霍乱。\""}]},{"ID":"20240607131522-t049kol","Type":"NodeParagraph","Properties":{"id":"20240607131522-t049kol","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑦《南京民间药草》：\"苗，浸酒漱口，可治牙痛。\""}]},{"ID":"20240607131522-y6smpc3","Type":"NodeParagraph","Properties":{"id":"20240607131522-y6smpc3","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑧《贵州民间方药集》：\"通经活血。治红崩，白带。\""}]},{"ID":"20240607131522-43id1hs","Type":"NodeParagraph","Properties":{"id":"20240607131522-43id1hs","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑨《福建民间草药》：\"益气，逐凤，强腰藤，解蛇毒。\""}]},{"ID":"20240607131522-dfzs5p9","Type":"NodeParagraph","Properties":{"id":"20240607131522-dfzs5p9","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑩广州部队《常用中草药手册》：\"祛风止痛，解毒消肿，温经通络。治毒蛇咬伤，风湿骨痛，心胃气痛，跌打肿痛，带状疱疹，肝硬化腹水，月经不调，痛经。\""}]},{"ID":"20240607131522-1jo4gd6","Type":"NodeParagraph","Properties":{"id":"20240607131522-1jo4gd6","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑾《吉林中草药》：\"利尿，强壮，镇静止痛，驱寒散瘀，解蛇毒，通络和血。治脚气，水肿，腹水，胀满，寒性腹痛。\""}]},{"ID":"20240607131522-ddiy3be","Type":"NodeParagraph","Properties":{"id":"20240607131522-ddiy3be","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607131522-18uxglw","Type":"NodeParagraph","Properties":{"id":"20240607131522-18uxglw","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；入丸剂或浸酒。外用：捣敷或煎水洗。"}]},{"ID":"20240607131522-s605e5c","Type":"NodeParagraph","Properties":{"id":"20240607131522-s605e5c","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607131522-kb321uu","Type":"NodeParagraph","Properties":{"id":"20240607131522-kb321uu","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" ①治恶庄心痛，闷绝欲死：鬼督邮一两（末），安息香一两（酒浸，细研，去滓，慢火煎成膏）。上药，以安息香煎和丸如梧桐子大。不计时候，以醋汤下十丸。（《圣惠方》）"}]},{"ID":"20240607131522-2cmcwk5","Type":"NodeParagraph","Properties":{"id":"20240607131522-2cmcwk5","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"②治腰痛，胃寒气痛，肝硬化腹水：徐长卿二至四钱。水煎服。（《中草药土方土法战备专辑》）"}]},{"ID":"20240607131522-f8fnpub","Type":"NodeParagraph","Properties":{"id":"20240607131522-f8fnpub","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"③治腹胀：徐长卿三钱。酌加水煎成半碗，温服。（《吉林中草药》）"}]},{"ID":"20240607131522-seabtzy","Type":"NodeParagraph","Properties":{"id":"20240607131522-seabtzy","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"④治牙痛：徐长卿根（干）五钱。洗净，加水1500毫升，煎至500毫升；也可将其根制成粉剂。痛时服水剂90毫升，服时先用药液漱口1～2分钟再咽下；如服粉剂，每次五分至一钱，均每天二次。（《全晨选编·口腔疾病》）"}]},{"ID":"20240607131522-57h91jn","Type":"NodeParagraph","Properties":{"id":"20240607131522-57h91jn","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑤治风湿痛：徐长卿根八钱至一两，猪精肉四两，老酒二两。酌加水煎成半碗，饭前服，日二次。（《福建民间草药》）"}]},{"ID":"20240607131522-t3bdhs0","Type":"NodeParagraph","Properties":{"id":"20240607131522-t3bdhs0","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑥治经期腹痛：对叶莲根三钱，月月红二钱，川芎一钱。切细，泡酒四两，内服。（《贵阳民间药草》）"}]},{"ID":"20240607131522-tvximrh","Type":"NodeParagraph","Properties":{"id":"20240607131522-tvximrh","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑦治痢疾，肠炎：痢止草一至二钱。水煎服，每天一剂。（《全展选编·传染病》）"}]},{"ID":"20240607131522-w9qvgvm","Type":"NodeParagraph","Properties":{"id":"20240607131522-w9qvgvm","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑧治精神分裂症（啼哭、悲伤、恍惚）：徐长卿五钱。泡水当茶饮。（《吉林中草药》）"}]},{"ID":"20240607131522-jo5biff","Type":"NodeParagraph","Properties":{"id":"20240607131522-jo5biff","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑨治皮肤瘙痒：徐长卿适量。煎水洗。（《吉林中草药》）"}]},{"ID":"20240607131522-vap2wil","Type":"NodeParagraph","Properties":{"id":"20240607131522-vap2wil","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑩治带状疱疹，接触性皮炎，顽固性荨麻疹，牛皮癣：徐长卿二至四钱。水煎内服，并外洗患处。（《中草药土方土法战备专楫》）"}]},{"ID":"20240607131522-i3jon1x","Type":"NodeParagraph","Properties":{"id":"20240607131522-i3jon1x","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑾治跌打肿痛，接骨：鲜徐长卿适量，捣烂敷患处。（《中草药土方土法战备专楫》）"}]},{"ID":"20240607131522-3tvfs4y","Type":"NodeParagraph","Properties":{"id":"20240607131522-3tvfs4y","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⑿小便不通。用徐长卿（灸过）半两，茅根三分，木通、冬葵子各一两，滑石二两，槟榔一分，瞿麦穗半两。每服五钱，水煎，再加朴硝一钱，温服。此方名\"徐长卿汤\"。"}]},{"ID":"20240607131522-q4apxsr","Type":"NodeParagraph","Properties":{"id":"20240607131522-q4apxsr","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"⒀晕车晕船。用徐长卿、石长生、车前子、车下李根此，等分捣碎，取半合装在袋子里悬衣带上。"}]},{"ID":"20240607131522-fh9lp4m","Type":"NodeParagraph","Properties":{"id":"20240607131522-fh9lp4m","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607131522-ogns7nc","Type":"NodeParagraph","Properties":{"id":"20240607131522-ogns7nc","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" ①治疗慢性气管炎"}]},{"ID":"20240607131522-xcpnb0g","Type":"NodeParagraph","Properties":{"id":"20240607131522-xcpnb0g","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"取徐长卿1两，制成煎剂或片剂，分2次服，10天为一疗程。治疗54例，有效41例，无效13例。有一定的消炎、化痰、止咳、平喘作用。对单纯性的效果较好，喘息型较差。加用鱼腥草后，疗效有所提高。个别病例服药后有口干、咽干反应。"}]},{"ID":"20240607131522-2spu8vc","Type":"NodeParagraph","Properties":{"id":"20240607131522-2spu8vc","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"②用于镇痛"}]},{"ID":"20240607131522-476lzvf","Type":"NodeParagraph","Properties":{"id":"20240607131522-476lzvf","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"将徐长卿制成100％注射液，肌肉注射，每次2～4毫升。一般注射5～10分钟后，即有镇痛作用，能持续2小时左右。治疗肠炎、胆道蛔虫症、溃疡病、肠蛔虫症、胆囊炎、胆石症、胆道手术综合征等所致的急性腹痛47例，有效36例，无效12例。此外，行穴位注射可治疗风湿性疼痛。"}]},{"ID":"20240607131522-1pxggb4","Type":"NodeParagraph","Properties":{"id":"20240607131522-1pxggb4","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"③治疗皮肤病"}]},{"ID":"20240607131522-1h1wimz","Type":"NodeParagraph","Properties":{"id":"20240607131522-1h1wimz","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"对湿疹、荨麻疹、接触性皮炎以及顽癣等均有效果。据36例治疗结果，痊愈者24例，显效8例，无效4例。用法：每次用徐长卿2～4钱，水煎服，亦可外洗。或制成注射剂、酊剂等应用。"}]},{"ID":"20240607131522-f29cbs2","Type":"NodeParagraph","Properties":{"id":"20240607131522-f29cbs2","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"此外，以徐长卿内服或外用，可治疗毒蛇咬伤、带状疱疹。配合金雀根制成100％注射液行肌肉注射，试治1例口、眼、生殖器三联征，获得一定效果。"}]},{"ID":"20240607131522-wsd8bzc","Type":"NodeParagraph","Properties":{"id":"20240607131522-wsd8bzc","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607131522-57v8q5y","Type":"NodeParagraph","Properties":{"id":"20240607131522-57v8q5y","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607131522-3jmq7fi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607131522-3jmq7fi","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"《中华本草》：徐长卿"}]},{"ID":"20240607131522-zj381zr","Type":"NodeParagraph","Properties":{"id":"20240607131522-zj381zr","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607131522-g9syhac","Type":"NodeParagraph","Properties":{"id":"20240607131522-g9syhac","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" Xú Zhǎnɡ Qīnɡ"}]},{"ID":"20240607131522-2go32oj","Type":"NodeParagraph","Properties":{"id":"20240607131522-2go32oj","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607131522-z2inzwe","Type":"NodeParagraph","Properties":{"id":"20240607131522-z2inzwe","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 鬼督邮、石下长卿、别仙踪、料刁竹、钓鱼竿、逍遥竹、一枝箭、英雄草、料吊、土细辛、九头狮子草、竹叶细辛、铃柴胡、生竹、一枝香、牙蛀消、线香草、小对叶草、对月草、天竹、溪柳、蛇草、瑶山竹、黑薇、蜈蚣草、铜锣草、 山刁竹、蛇利草、药王、对叶莲、上天梯、老君须、香摇边、摇竹消、摇边竹、三百根、刁竹、千云竹、痢止草"}]},{"ID":"20240607131522-7rs2hkv","Type":"NodeParagraph","Properties":{"id":"20240607131522-7rs2hkv","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607131522-f8776bh","Type":"NodeParagraph","Properties":{"id":"20240607131522-f8776bh","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" Paniculate Swallowwort Root"}]},{"ID":"20240607131522-tu1b4fv","Type":"NodeParagraph","Properties":{"id":"20240607131522-tu1b4fv","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607131522-slcwml9","Type":"NodeParagraph","Properties":{"id":"20240607131522-slcwml9","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.《唐本草》：徐长卿，叶似柳，两叶相当，有光润，所在川泽有之。根如纲辛，微粗长而高服气。今俗用代鬼督邮，非也。"}]},{"ID":"20240607131522-zg9ji5n","Type":"NodeParagraph","Properties":{"id":"20240607131522-zg9ji5n","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：《名医别录》于有名未用复出石下长卿条，云一名徐长卿。陶弘景注云，此是误尔，方家无用，亦不复识。今考二条功疗相似。按《吴普本草》云，徐长卿一名石下长卿，其为一物甚明，但石间生者为良，前人欠审，故尔差舛。 鬼督邮、及己之乱杜衡，其功不同，苗亦不同也。徐"}]},{"ID":"20240607131522-9p31qym","Type":"NodeParagraph","Properties":{"id":"20240607131522-9p31qym","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607131522-z3ku22n","Type":"NodeParagraph","Properties":{"id":"20240607131522-z3ku22n","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 药材基源：为双子叶植物药萝藦科植物徐长卿的根及根茎或带根全草"}]},{"ID":"20240607131522-xqn0xvs","Type":"NodeParagraph","Properties":{"id":"20240607131522-xqn0xvs","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Cynanchum paniculatum (Bge.) Kitag."}]},{"ID":"20240607131522-btloxer","Type":"NodeParagraph","Properties":{"id":"20240607131522-btloxer","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季采收，根茎及根，洗净晒干；全草晒至半干，扎把阴干。"}]},{"ID":"20240607131522-skni76g","Type":"NodeParagraph","Properties":{"id":"20240607131522-skni76g","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607131522-ksty9kq","Type":"NodeParagraph","Properties":{"id":"20240607131522-ksty9kq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于阳坡草丛中。"}]},{"ID":"20240607131522-6rsdkj0","Type":"NodeParagraph","Properties":{"id":"20240607131522-6rsdkj0","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东并、华东、中南、西南及内蒙古、河北、陕西、甘肃。"}]},{"ID":"20240607131522-hfhgh1q","Type":"NodeParagraph","Properties":{"id":"20240607131522-hfhgh1q","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607131522-xryr6a6","Type":"NodeParagraph","Properties":{"id":"20240607131522-xryr6a6","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 多年生直立草本，高达1cm根细呈须状，多至50余条，形如马尾，具特殊香气。茎细而刚直，不分枝，无毛或被微毛。叶对生，无柄；叶片披针形至线形，cm，宽3-15mm，先端渐尖，基部渐窄，两面无毛或上面具疏柔毛，叶缘稍反卷，有睫毛，上面深绿色，下淡绿色；主脉突起。圆锥聚伞花序，生近顶端叶腋，长达7cm，有花10余朵；花萼5深裂，卵状披针形；花冠黄绿色，5深裂，广卵形，平展或向外反卷；副花冠5，黄色，肉质，肾形，基部与雄蕊合生；雄蕊5，相连简状，花药2室，花粉块每室1个，下垂臂短、平伸；雌蕊1，子房上位，由2枚离生心皮组成、花柱2，柱头五角形，先端略为突起。蓇葖果呈角状，单生长约6cm，表面淡褐色。种子多数，卵形而扁，暗褐色，先端有一簇白色细长毛。花期5-7月，果期9-12月。"}]},{"ID":"20240607131522-81eukht","Type":"NodeParagraph","Properties":{"id":"20240607131522-81eukht","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607131522-twvlwpm","Type":"NodeParagraph","Properties":{"id":"20240607131522-twvlwpm","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 生物学特性 徐长卿对气候的适应性较强，南北各地均可栽培。土壤以肥沃、疏松的砂质壤土较好。"}]},{"ID":"20240607131522-yzwhz2f","Type":"NodeParagraph","Properties":{"id":"20240607131522-yzwhz2f","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子和分株繁殖。种子繁殖：春季4月中旬播种，条播行距30-35cm，播后覆土、浇水、5月上旬出苗，苗出齐后进行间苗1次，株距10-14cm。分株繁殖：宜在早春老株尚未芽前或晚秋枯苗后进行，行株距为40cm×10cm，开沟栽种，覆土压实后浇水。"}]},{"ID":"20240607131522-9b2h8j2","Type":"NodeParagraph","Properties":{"id":"20240607131522-9b2h8j2","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"田间管理 生长期间注意除草、浇水。苗高3-6cm时，追服1次，以后再追肥3次，肥料以人畜粪水为主。以后每年中耕除草3次，每次中耕后，都要追肥1次。"}]},{"ID":"20240607131522-b1x2mym","Type":"NodeParagraph","Properties":{"id":"20240607131522-b1x2mym","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有根腐病，要注意排水、松土预防；虫害有蚜虫、椿象，可用化学制剂加水喷杀。"}]},{"ID":"20240607131522-37mm7fw","Type":"NodeParagraph","Properties":{"id":"20240607131522-37mm7fw","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607131522-adtloyo","Type":"NodeParagraph","Properties":{"id":"20240607131522-adtloyo","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎不规则柱状，有盘节，长 0.5-3.5cm，直径 2-4mm；有的顶端附圆柱形残茎，长l-2cm，断面中空。根簇生于根茎节处，圆柱形，细长而弯曲，长 10-16cm，直径1-1.5mm；表面淡黄棕色至淡棕色，具微细纵皱纹，并有纤细须根；质脆，易折断，断面粉性，皮部类白色或黄白色，形成层环淡棕色，木部细小。气香，味微辛、凉。全草带有根部，茎单一或少有分枝，长20一 60cm，直1-2mm；表面淡黄绿色，基部略带淡紫色，具细纵纹，或被毛；质稍脆，折断面纤维性。叶对生，叶片扭曲，易破碎，完整者长被针形，表面淡黄绿色，具短柄或几无柄。以香气浓者为佳。"}]},{"ID":"20240607131522-8tj2bjo","Type":"NodeParagraph","Properties":{"id":"20240607131522-8tj2bjo","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"显微鉴别 很横切面：表皮细胞外侧壁增厚。皮层宽阔，薄壁细胞含淀粉粒或草酸钙簇晶。内皮层凯氏点明显。维管束形成层不明显。木质部细胞均木化。"}]},{"ID":"20240607131522-89hjurz","Type":"NodeParagraph","Properties":{"id":"20240607131522-89hjurz","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"茎横切面：表皮外被用质层。皮层最外1列外皮层细胞壁切向增厚。中柱鞘纤维断续成环。维管来双韧型。髓都有大空腔。"}]},{"ID":"20240607131522-u217kfc","Type":"NodeParagraph","Properties":{"id":"20240607131522-u217kfc","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"叶横切面：栅栏细胞1列。中脉维管束双韧型。薄壁细胞含草酸钙簇晶。"}]},{"ID":"20240607131522-ktfrnw0","Type":"NodeParagraph","Properties":{"id":"20240607131522-ktfrnw0","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607131522-cw1md5g","Type":"NodeParagraph","Properties":{"id":"20240607131522-cw1md5g","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 小鼠腹腔注射徐长卿去牡丹酚制剂的半数致死量为32.9±1.0g/kg。兔静脉注射 5g/kg 时，可出现惊厥，持续30-60秒，1-2分钟后始可站立，逐渐恢复正常，48小时内动物情况良好。"}]},{"ID":"20240607131522-bwt5m99","Type":"NodeParagraph","Properties":{"id":"20240607131522-bwt5m99","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607131522-2pqge4e","Type":"NodeParagraph","Properties":{"id":"20240607131522-2pqge4e","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 全草含牡丹酚(PaeonoI)约l%。又找出有与肉珊瑚甙元(Sarcostin)、去酚牛皮消甙元(Deacylcynanchogenin)、茸毛牛 奶藤甙元(Tomentogenin)和去酰萝甙元(Deacylmetaplexigenin)极为相似的物质以及醋酸 、桂皮酸等。根含黄酮甙、糖类、氨基酸、牡丹酚。含C21甾类化合物。水解产物中含肉珊瑚甙元(sarcostin)、去乙酰萝藦甙元(deacyl-metaplexigenin)、去乙酰牛皮消甙元(deacylcynan-chogenin)及托曼甙元(tomentogenin)， 尚含D-加拿大麻糖(D-cymarose)、D-洋地黄毒糖(D-digitox-ose)、L-夹竹桃糖(L-oleandrose)和D-沙门糖(D-sarmentose)。另有报道含C21变形甾甙类化合物，由芫花叶白前甙元D(glaucogenin D)和不同糖链成的徐长卿甙(cynapanoside)A，B，C及芫花叶白前甙元B(glaucogenin B)所形成的白薇甙B(cyna-tratside B)。"}]},{"ID":"20240607131522-3bxw3tv","Type":"NodeParagraph","Properties":{"id":"20240607131522-3bxw3tv","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"此外还含牡丹酚(paeonol)、异丹皮酚(isopaeonol)、硬脂酸癸酯、蜂花烷(triacontane)、十六烯(hexadecene)、β-谷甾醇和D-赤丝草醇(erythritol)。"}]},{"ID":"20240607131522-a325xxq","Type":"NodeParagraph","Properties":{"id":"20240607131522-a325xxq","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607131522-wj0q07l","Type":"NodeParagraph","Properties":{"id":"20240607131522-wj0q07l","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 1.镇痛作用：热板法证明，徐长卿对小鼠有镇痛作用，腹腔注射 5或10g/kg后10分钟出现镇痛，l小时后仍未消失。牡丹酚也可使小鼠痛阈提高。但有人证明，应用去牡丹酚的徐长卿药液也能延长疼痛反应时间，提高痛阈和镇痛率。由此证明徐长卿的镇痛作用除牡丹酚外尚有其它成分。"}]},{"ID":"20240607131522-12pnq5p","Type":"NodeParagraph","Properties":{"id":"20240607131522-12pnq5p","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"2.镇静作用：牡丹酚有镇静作用。光电管法与抖笼法试验证明，去牡丹酚徐长卿注射液5g/kg小鼠 腹腔注射能显着减少自发活动，但不能延长巴比妥类催眠药的睡眠时间。兔静脉注射，可出现惊厥，这是否与给药方法，动物种属差异有关，尚待进一步研究。"}]},{"ID":"20240607131522-uhk9rfe","Type":"NodeParagraph","Properties":{"id":"20240607131522-uhk9rfe","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"3.对心血管系统的作用：兔腹腔注射徐长卿3g/kg连续7天，不能消除该兔静滴脑垂体后叶素引起的心肌急性缺血性心电图T波抬高的变化。但徐长卿煎剂10-15g/kg小鼠腹腔注射，可使其心肌对86铷的摄取明显增加，因而认为能增加冠状动脉血流量，改善心肌代谢，从而缓解心肌缺血。牡丹酚具有降低动物血压作用。去牡丹酚的徐长卿制剂，仍可降低犬，兔和大鼠的血压、减慢心率，故认为徐长卿的降低作用除所含牡丹酚外，可能还有其它降压成分。"}]},{"ID":"20240607131522-qzrxlkd","Type":"NodeParagraph","Properties":{"id":"20240607131522-qzrxlkd","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"4.对实验性高血脂症及动脉粥样硬化病变的影响：对喂饲胆固醇的高血脂症兔每日给徐长卿3g/kg，在第周5和第周9的血清总胆固醇和B-脂蛋白均明显降低，与对照组比较有差异。给药组的动脉粥样硬化病变发生率也较低，仅3/10，而对照组是7/9，徐长卿组大块密集斑块条纹分散且少，小动脉脂质沉积程度也较轻微。给药组动物的肾上腺，网状内皮系统和肝损害程度也较轻。此外，从实验性高血脂症兔血中嗜碱性白细胞的百分数变化，发现在给药后第周9胆固醇下降时，嗜碱性的细胞上升，说明徐长卿有降血脂作用。"}]},{"ID":"20240607131522-go4tui8","Type":"NodeParagraph","Properties":{"id":"20240607131522-go4tui8","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"5.对平滑肌的作用：徐长卿注射液可使豚鼠离体回肠张力下降，并可对抗氯化钡引起的回肠强烈收缩。但对乙酰胆碱、组胺所致的回肠收缩无对抗作用，同法证明，牡丹酚对乙酰胆碱、组胺、氯化钡引起肠鼠离体回肠的强烈收缩，则均有显着的对抗作用。"}]},{"ID":"20240607131522-zvp43ib","Type":"NodeParagraph","Properties":{"id":"20240607131522-zvp43ib","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"6.抗菌作用：平板打洞法证明，金黄色葡萄球菌对徐长卿呈中度敏感，大肠杆菌、宋内氏痢疾杆菌、绿脓杆菌、伤寒杆菌不敏感，徐长卿对甲型链球菌也有抑制作用。试管稀释法证明，徐长卿全植物煎剂1：4对福氏痢疾杆菌、伤寒杆菌；1：2对绿脓杆菌、大肠杆菌、金色葡萄球菌有抑制作用。牡丹酚在体外，1：15000对大肠杆菌、枯草杆菌，1：2000对金黄色葡萄球菌有抑制作"}]},{"ID":"20240607131522-wgbspue","Type":"NodeParagraph","Properties":{"id":"20240607131522-wgbspue","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607131522-d4nacjt","Type":"NodeParagraph","Properties":{"id":"20240607131522-d4nacjt","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 取原药材，除去杂质，抢水洗净，切段，阴干或低温干燥。"}]},{"ID":"20240607131522-t54uxho","Type":"NodeParagraph","Properties":{"id":"20240607131522-t54uxho","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607131522-icqao39","Type":"NodeParagraph","Properties":{"id":"20240607131522-icqao39","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末0.5g，置试管中，加水2ml，管口盖一块用水湿润的滤纸，滤纸上加氯亚胺基-2，6- 二氯醌1份与四硼酸钠32份的混合试剂少量，混匀，将试管加热至微沸，滤纸显蓝色。"}]},{"ID":"20240607131522-o18w79t","Type":"NodeParagraph","Properties":{"id":"20240607131522-o18w79t","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"（2）薄层色谱 取本品粉末1g加乙醚10ml，密塞，振摇10min，滤过。滤液挥十残渣加丙酮1ml使溶解，供点样。另以丹皮酚丙酮溶液（2mg／ml）为对照品溶液。分别点样子硅胶 G薄层板上，用环己院一醋酸乙酯（3：1）展开。以盐酸酸性5％的三氯化铁乙醇溶液喷雾，热风吹至斑点显色清晰。供试液色谱在与对照品色谱相应的位置厂，显相同蓝褐色斑点。"}]},{"ID":"20240607131522-8kczjws","Type":"NodeParagraph","Properties":{"id":"20240607131522-8kczjws","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"品质标志 《中华人民共和国药典）1995年版规定：本品按干燥品计算，含丹皮酚（C9H10O3）不得少于1．3％。"}]},{"ID":"20240607131522-exm8y8g","Type":"NodeParagraph","Properties":{"id":"20240607131522-exm8y8g","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607131522-3wuw3og","Type":"NodeParagraph","Properties":{"id":"20240607131522-3wuw3og","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 肝；胃经"}]},{"ID":"20240607131522-4eyzmde","Type":"NodeParagraph","Properties":{"id":"20240607131522-4eyzmde","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607131522-zureoso","Type":"NodeParagraph","Properties":{"id":"20240607131522-zureoso","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 味辛；性温"}]},{"ID":"20240607131522-yk5rlnz","Type":"NodeParagraph","Properties":{"id":"20240607131522-yk5rlnz","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607131522-msrhn6y","Type":"NodeParagraph","Properties":{"id":"20240607131522-msrhn6y","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 祛风止痛；祛风止痒；活血解毒；去痛止痒；消肿。主胃病；牙痛；风湿痹痛；腰痛；脘腹疼痛；牙痛；听候扑任痛；小便水利；泄泻；痢疾；湿疹；荨麻疹；毒蛇咬伤"}]},{"ID":"20240607131522-o1mr8gn","Type":"NodeParagraph","Properties":{"id":"20240607131522-o1mr8gn","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607131522-eswvgcj","Type":"NodeParagraph","Properties":{"id":"20240607131522-eswvgcj","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤， l-3钱；不宜久煎；入丸剂或浸酒。"}]},{"ID":"20240607131522-mthjl3q","Type":"NodeParagraph","Properties":{"id":"20240607131522-mthjl3q","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607131522-su8vs63","Type":"NodeParagraph","Properties":{"id":"20240607131522-su8vs63","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" ①治恶心痛，闷绝欲死：鬼督邮一两(末)，安息香一两(酒浸，细研，去滓，慢火煎成膏)。上药，以安息香煎和丸如梧桐子大。不计时候，以醋汤下十丸。(《圣惠方》)②治腰痛，胃寒气痛，肝硬化腹水：徐长卿二至四钱。水煎服。(《中草药土方土法战备专辑》)③治腹胀，徐长卿三钱。酌加水煎成半碗，温服。(《吉林中草药》)④治牙痛：徐长卿根(干)五钱。洗净功口水1500毫升，煎至500毫升；也可将其根制成粉剂。痛时服水剂30毫升，服时先用药液漱口 l～2分钟再咽下；如服粉剂，每次五分至一钱，均每天二次。(《全展选编·口腔疾病》)⑤治风湿痛：徐长卿根八钱至一两，猪精肉四两，老酒二两。酌加水煎成半碗，饭前服，日二次。(《福建民间草药》)⑥治经期腹痛：对叶莲根三钱，月月红二钱，川芎一钱。切细，泡酒四两，内服。(《贵阳民间药草》)⑦治痢疾，肠炎：痢止草一至二钱。水煎服，每天一剂。(《全展选编·传染病》) ⑧治精神分裂症(啼哭、悲伤、恍惚)：徐长卿五钱。泡水当茶饮。(《吉林中草药》)⑨治皮肤瘙痒：徐长酿口适量。煎水流。(《吉林中草药》)⑩治带状疱疹，接触性皮炎，顽固性等麻疹，牛皮癣：徐长卿二至四钱。水煎内服，并外洗患处。(《中草药土方土法战备专辑》)11.治跌打肿痛，接骨：鲜徐长卿适量，捣烂敷患处。(《中草药土方土法战备专辑》)"}]},{"ID":"20240607131522-f3u9gkf","Type":"NodeParagraph","Properties":{"id":"20240607131522-f3u9gkf","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607131522-w46i3lz","Type":"NodeParagraph","Properties":{"id":"20240607131522-w46i3lz","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 1.治疗慢性气管炎：取徐长卿l两，制成煎剂或片剂，分2次服，10天为一疗程。治疗54例，有效41例，无效13例。有一定的消炎、化痰、止咳、平喘作用。对单纯性的效果较好，喘息型较差。加用鱼腥草后，疗效有所提高。个别病例服药后有口干、咽干反应。"}]},{"ID":"20240607131522-yur1bgc","Type":"NodeParagraph","Properties":{"id":"20240607131522-yur1bgc","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"2.用于镇痛：将徐长卿制成100露注射液，肌肉注射，每次2-4ml。一般注射5-10分钟后，即有镇痛作用，能持续2小时左右。治疗肠炎、胆道蛔虫症、溃疡病、肠蛔虫症、胆囊炎、胆石症、胆道手术综合征等所致的急性腹痛47例，有效35例，无效12例。此外，行穴位注射可治疗风湿性疼痛。"}]},{"ID":"20240607131522-saj0c5i","Type":"NodeParagraph","Properties":{"id":"20240607131522-saj0c5i","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"3.治疗皮肤病对湿疹、等麻疹、接触性皮炎以及顽癣等均有效果。据36例治疗结果，痊愈者24例，显效8例，无效各例。用法：每次用徐长卿2-4钱，水煎服，亦可外洗。或制成注射剂、配剂等应用。"}]},{"ID":"20240607131522-xfwjdr0","Type":"NodeParagraph","Properties":{"id":"20240607131522-xfwjdr0","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"4.此外，以徐长卿内服或外用，可治疗毒蛇咬伤、带状疱疹。配合金雀根〔豆科植物锦鸡儿Caragana sinica(Buchoz)Rehd.〕制成100%注射液行肌 肉注射，试治 l例口、眼、生殖器三联征，获得一定效果。"}]},{"ID":"20240607131522-v54d9xz","Type":"NodeParagraph","Properties":{"id":"20240607131522-v54d9xz","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607131522-ti6y96d","Type":"NodeParagraph","Properties":{"id":"20240607131522-ti6y96d","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主蛊毒，疫疾，邪恶气，温疟。主注易亡定，啼哭，悲伤，恍惚。"}]},{"ID":"20240607131522-3l0lo6q","Type":"NodeParagraph","Properties":{"id":"20240607131522-3l0lo6q","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"2.《别录》：益气。"}]},{"ID":"20240607131522-lwls64m","Type":"NodeParagraph","Properties":{"id":"20240607131522-lwls64m","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"3.《生草药性备要》：浸酒，除风湿。"}]},{"ID":"20240607131522-u2c4bpj","Type":"NodeParagraph","Properties":{"id":"20240607131522-u2c4bpj","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"4.《简易草药》：治跌打损伤，筋骨疼痛。"}]},{"ID":"20240607131522-u40x8b9","Type":"NodeParagraph","Properties":{"id":"20240607131522-u40x8b9","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"5.《岭南采药录》：治小儿腹胀，青筋出现。又治疯狗咬伤。"}]},{"ID":"20240607131522-88nghft","Type":"NodeParagraph","Properties":{"id":"20240607131522-88nghft","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"6.《中国药植志》：治一切癌症和肚痛，胃气痛，食积，霍乱。"}]},{"ID":"20240607131522-u0o44ph","Type":"NodeParagraph","Properties":{"id":"20240607131522-u0o44ph","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"7.《南京民间药草》：苗，浸酒漱口，可治牙痛。"}]},{"ID":"20240607131522-z4l2ub8","Type":"NodeParagraph","Properties":{"id":"20240607131522-z4l2ub8","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"8.《贵外民间方药集》：通经活血。治红崩，白带。"}]},{"ID":"20240607131522-zaxiqt8","Type":"NodeParagraph","Properties":{"id":"20240607131522-zaxiqt8","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"9.《福建民间草药》：益气，逐风，强腰膝，解蛇毒。"}]},{"ID":"20240607131522-ysm19vb","Type":"NodeParagraph","Properties":{"id":"20240607131522-ysm19vb","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"10.广州部队《常用中草药手册》：祛风止痛，解毒消肿，温经通络。治毒蛇咬伤，风湿骨痛，心胃气痛，跌打肿痛，带状疱疹，肝硬化腹水，月经不调，痛经。"}]},{"ID":"20240607131522-qboto5j","Type":"NodeParagraph","Properties":{"id":"20240607131522-qboto5j","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"11．《吉林中草药》：利尿，强壮，镇静止痛，驱寒散瘀，解蛇毒，通络和血。治脚气，水肿，腹水，胀满，寒性腹痛。"}]},{"ID":"20240607131522-6ytx4g5","Type":"NodeParagraph","Properties":{"id":"20240607131522-6ytx4g5","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607131522-nnnhu2j","Type":"NodeParagraph","Properties":{"id":"20240607131522-nnnhu2j","updated":"20240607131522"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607131524-qb9m0ok","Type":"NodeThematicBreak","Properties":{"id":"20240607131524-qb9m0ok"}},{"ID":"20240607131525-hwbtnrq","Type":"NodeParagraph","Properties":{"id":"20240607131525-hwbtnrq"}}]}