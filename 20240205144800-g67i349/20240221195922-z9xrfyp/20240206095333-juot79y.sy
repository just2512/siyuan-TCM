{"ID":"20240206095333-juot79y","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240206095333-juot79y","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240206095333-juot79y\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240206095402-z5ca576\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607134959-8r7iwvr\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240206095402-z5ca576\u0026quot;,\u0026quot;focusStart\u0026quot;:204,\u0026quot;focusEnd\u0026quot;:204\u0026#125;","title":"088姑活（冬葵子、冬葵果、葵子）","type":"doc","updated":"20240812172631"},"Children":[{"ID":"20240812162742-9pyf69g","Type":"NodeHeading","HeadingLevel":5,"Properties":{"fold":"1","id":"20240812162742-9pyf69g","updated":"20240812172631"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"错录内容"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text","TextMarkTextContent":"（已收纳）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240812162802-x21cpb5","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812162802-x21cpb5","updated":"20240812172631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为苘麻，非冬葵子"}]},{"ID":"20240812162742-3iijn0n","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812162742-3iijn0n","updated":"20240812172631"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子-20240808142838-sra41a2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162742-iocdgep","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812162742-iocdgep","updated":"20240812172631"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 414px;","style":"width: 404px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 4-20240808143208-b10k9kn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 404px;\" parent-style=\"width: 414px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 688px;","style":"width: 678px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 5-20240808143306-0rmwuh3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 678px;\" parent-style=\"width: 688px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162742-8b4x8iu","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812162742-8b4x8iu","updated":"20240812172631"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 566px;","style":"width: 556px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 6-20240808143401-4gdvdxb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 556px;\" parent-style=\"width: 566px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 636px;","style":"width: 626px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 7-20240808143456-x0b0222.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 626px;\" parent-style=\"width: 636px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162742-j1332kn","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240812162742-j1332kn","updated":"20240812172631"}},{"ID":"20240812162743-7ov4oi3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20240812162743-7ov4oi3","updated":"20240812163606"},"Children":[{"Type":"NodeText","Data":"姑活"}]},{"ID":"20240206095402-z5ca576","Type":"NodeParagraph","Properties":{"id":"20240206095402-z5ca576","updated":"20240812162750"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于四川、云南、贵州、湖南、湖北、陕西等地区。\n【性状】\t干燥果实呈扁球状盘形，由1012枚分果瓣组成，果梗细短。分果瓣类扁圆形，具环向细脉纹，表面黄白或黄棕色。种子呈圆形扁平之橘瓣状，或微呈肾形，细小，直径约1.52mm，较薄的一边中央凹下，外表为棕黄色的包壳 (果皮)，具环形细皱纹，搓去皮壳后，种子呈棕褐色。质坚硬，破碎后微有香味。\n【性味】\t甘，寒。\n【功效】\t行水滑肠，通乳，清热排脓。"}]},{"ID":"20240206095348-szmigxu","Type":"NodeParagraph","Properties":{"id":"20240206095348-szmigxu","updated":"20240812162750"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206095348-nst9cdo.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808142912-ki2ysfl","Type":"NodeParagraph","Properties":{"id":"20240808142912-ki2ysfl","updated":"20240812162750"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 254px;","style":"width: 244px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬