4px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 12-20240808152345-985xwg3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 364px;\" parent-style=\"width: 374px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 359px;","style":"width: 349px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 13-20240808152454-vvfrp15.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 349px;\" parent-style=\"width: 359px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621135352-wc74qy1","Type":"NodeParagraph","Properties":{"id":"20240621135352-wc74qy1","updated":"20240812162901"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：据说姑活和冬葵子实际上是一种植物不同称呼，北为姑活，南为冬葵子。"}]},{"ID":"20240607135008-5fk2ev9","Type":"NodeThematicBreak","Properties":{"id":"20240607135008-5fk2ev9","updated":"20240812162750"}},{"ID":"20240607135112-ec8on8v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607135112-ec8on8v","updated":"20240607135116"},"Children":[{"Type":"NodeText","Data":"姑活《神农本草经》"}]},{"ID":"20240607135112-77pglo6","Type":"NodeParagraph","Properties":{"id":"20240607135112-77pglo6","updated":"20240607135112"},"Children":[{"Type":"NodeText","Data":"味甘温。"}]},{"ID":"20240607135112-3nd0u56","Type":"NodeParagraph","Properties":{"id":"20240607135112-3nd0u56","updated":"20240607135112"},"Children":[{"Type":"NodeText","Data":"主大风邪气，湿痹寒痛。久服轻身益寿耐老。一名冬葵子（旧在《唐本草》中无毒，今增）。"}]},{"ID":"20240607135112-dsochvj","Type":"NodeParagraph","Properties":{"id":"20240607135112-dsochvj","updated":"20240607135112"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生河东。"}]},{"ID":"20240607135112-0hutzzt","Type":"NodeParagraph","Properties":{"id":"20240607135112-0hutzzt","updated":"20240607135112"},"Children":[{"Type":"NodeText","Data":"案水经注解县，引《神农本草》云：地有固活，女疏，铜芸，紫苑之族也；陶宏景云：方药亦无用此者，乃有固活丸，即是野葛，一名，此又名冬葵子，非葵菜之冬葵子，疗体乖异。"}]},{"ID":"20240617090050-82rix1x","Type":"NodeThematicBreak","Properties":{"id":"20240617090050-82rix1x"}},{"ID":"20240617090051-rfkiiv4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617090051-rfkiiv4","updated":"20240617090055"},"Children":[{"Type":"NodeText","Data":"姑活《神农本草经赞》"}]},{"ID":"20240617090051-gmi28gd","Type":"NodeParagraph","Properties":{"id":"20240617090051-gmi28gd","updated":"20240617090051"},"Children":[{"Type":"NodeText","Data":"味甘温。主大风邪气。湿痹寒痛。久服轻身。益寿耐老。一名冬葵子。"}]},{"ID":"20240617090051-htbecnd","Type":"NodeParagraph","Properties":{"id":"20240617090051-htbecnd","updated":"20240617090051"},"Children":[{"Type":"NodeText","Data":"姑云徐徐。当生者活。湿燥寒温。风驱邪遏。菜匪冬葵。烟祛野葛。鸡以精名。义难曲括。"}]},{"ID":"20240617090051-ffeme5a","Type":"NodeParagraph","Properties":{"id":"20240617090051-ffeme5a","updated":"20240617090051"},"Children":[{"Type":"NodeText","Data":"孟子。谓之姑徐徐云耳。说苑。扁鹊医赵太子。言当生者活耳。陶弘景曰。冬葵非菜之冬葵。李时珍曰。野葛折之。青烟出者名固活。苏恭曰。一名鸡精。罗湖野录。形于尺素。尤为曲括。"}]},{"ID":"20240617090127-7bazvn4","Type":"NodeThematicBreak","Properties":{"id":"20240617090127-7bazvn4"}},{"ID":"20240617090128-dx5msoq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617090128-dx5msoq","updated":"20240617090131"},"Children":[{"Type":"NodeText","Data":"姑活《证类本草》"}]},{"ID":"20240617090128-7x22gmr","Type":"NodeParagraph","Properties":{"id":"20240617090128-7x22gmr","updated":"20240617090128"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主大风邪气，湿痹寒痛。久服轻身，益寿耐老。一名冬葵子。生河东。"}]},{"ID":"20240617090128-t1ovliz","Type":"NodeParagraph","Properties":{"id":"20240617090128-t1ovliz","updated":"20240617090138"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方∶药亦无用此者，乃有固活丸，取是野葛一名尔。此又名冬葵子，非葵菜之冬葵子,疗体乖异。"}]},{"ID":"20240617090101-34nng5h","Type":"NodeThematicBreak","Properties":{"id":"20240617090101-34nng5h"}},{"ID":"20240617090103-ete72hr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617090103-ete72hr","updated":"20240617090110"},"Children":[{"Type":"NodeText","Data":"姑活《医学入门》"}]},{"ID":"20240617090103-00li0uv","Type":"NodeParagraph","Properties":{"id":"20240617090103-00li0uv","updated":"20240617090103"},"Children":[{"Type":"NodeText","Data":"生河东。味甘，温。无毒。主大风邪气，湿痹寒痛，久服轻身耐老。"}]},{"ID":"20240607135118-f2hn66r","Type":"NodeThematicBreak","Properties":{"id":"20240607135118-f2hn66r"}},{"ID":"20240607135130-cksl58v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607135130-cksl58v","updated":"20240607135134"},"Children":[{"Type":"NodeText","Data":"姑活《名医别录》"}]},{"ID":"20240607135130-w7vgvrb","Type":"NodeParagraph","Properties":{"id":"20240607135130-w7vgvrb","updated":"20240607135130"},"Children":[{"Type":"NodeText","Data":"无毒．生河东．又，姑活，一名鸡精也．"}]},{"ID":"20240607135130-er8hf44","Type":"NodeParagraph","Properties":{"id":"20240607135130-er8hf44","updated":"20240607135130"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶姑活，味甘，温．主大风邪气，湿痹寒痛．久服轻身，益寿耐老．一名冬葵"}]},{"ID":"20240607135120-fom8cl8","Type":"NodeThematicBreak","Properties":{"id":"20240607135120-fom8cl8"}},{"ID":"20240617090013-cb55cwj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617090013-cb55cwj","updated":"20240617090016"},"Children":[{"Type":"NodeText","Data":"姑活《新修本草》"}]},{"ID":"20240617090013-lho6tdk","Type":"NodeParagraph","Properties":{"id":"20240617090013-lho6tdk","updated":"20240617090013"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主大风邪气，湿痹寒痛。久服轻身，益寿耐老。一名冬葵子。生河东川泽。"}]},{"ID":"20240617090013-jodg53v","Type":"NodeParagraph","Properties":{"id":"20240617090013-jodg53v","updated":"20240617090013"},"Children":[{"Type":"NodeText","Data":"方药亦无用此者，乃有固活丸，即是野葛一名耳。此又名冬葵子，非葵菜之冬葵子，疗体乖异。"}]},{"ID":"20240617090013-ixmf2je","Type":"NodeParagraph","Properties":{"id":"20240617090013-ixmf2je","updated":"20240617090013"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》一名鸡精也。"}]},{"ID":"20240617090020-ia8oyxo","Type":"NodeThematicBreak","Properties":{"id":"20240617090020-ia8oyxo"}},{"ID":"20240617090021-me0x68e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617090021-me0x68e","updated":"20240617090026"},"Children":[{"Type":"NodeText","Data":"姑活《千金翼方》"}]},{"ID":"20240617090021-168le28","Type":"NodeParagraph","Properties":{"id":"20240617090021-168le28","updated":"20240617090021"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主大风邪气，湿痹寒痛。久服轻身，益寿耐老。一名冬葵子。"}]},{"ID":"20240607134840-x58hklr","Type":"NodeThematicBreak","Properties":{"id":"20240607134840-x58hklr"}},{"ID":"20240607134957-2le70i3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607134957-2le70i3","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：冬葵子"}]},{"ID":"20240607134957-h2vyq1g","Type":"NodeParagraph","Properties":{"id":"20240607134957-h2vyq1g","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607134957-37ri2r2","Type":"NodeParagraph","Properties":{"id":"20240607134957-37ri2r2","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" Dōnɡ Kuí Zǐ"}]},{"ID":"20240607134957-28drreg","Type":"NodeParagraph","Properties":{"id":"20240607134957-28drreg","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607134957-raesvjb","Type":"NodeParagraph","Properties":{"id":"20240607134957-raesvjb","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 葵子（《金匮要略》），葵菜子（《妇人良方》）。"}]},{"ID":"20240607134957-aojtaa4","Type":"NodeParagraph","Properties":{"id":"20240607134957-aojtaa4","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607134957-m8c9r5b","Type":"NodeParagraph","Properties":{"id":"20240607134957-m8c9r5b","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607134957-s409w44","Type":"NodeParagraph","Properties":{"id":"20240607134957-s409w44","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607134957-zhzl3o1","Type":"NodeParagraph","Properties":{"id":"20240607134957-zhzl3o1","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 为锦葵科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"冬葵"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607134957-8o6dhh0","Type":"NodeParagraph","Properties":{"id":"20240607134957-8o6dhh0","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607134957-854vvcu","Type":"NodeParagraph","Properties":{"id":"20240607134957-854vvcu","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 分布全国各地。"}]},{"ID":"20240607134957-9rua0gy","Type":"NodeParagraph","Properties":{"id":"20240607134957-9rua0gy","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607134957-tbkhp50","Type":"NodeParagraph","Properties":{"id":"20240607134957-tbkhp50","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 冬葵（《本经》），又名：葵（《诗经》），葵菜（《说文》），露葵（《尔雅翼》），冬葵菜（《救荒本草》），滑菜（《纲目》），卫足（《鲜芳谱》），马蹄菜，蕲菜（《医林纂要》），滑肠菜（《宁都州志》），金钱葵、金钱紫花葵（《挚经室集》），冬寒菜（《植物名实图考》），冬苋菜（《分类草药性》），茴菜、滑滑菜、奇菜。"}]},{"ID":"20240607134957-yanvs5e","Type":"NodeParagraph","Properties":{"id":"20240607134957-yanvs5e","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"一年生草本，高30～90厘米。茎直立，被疏毛或几无毛。叶互生；掌状5～7浅裂，圆肾形或近圆形，基部心形，边缘具钝锯齿，掌状5～7脉，有长柄。花小，丛生于叶腋，淡红色，小苞片3，广线形；萼5裂，裂片广三角形；花冠5瓣，倒卵形，先端凹入；雄蕊多数，花丝合生；子房10～12室，每室有一个胚珠。果实扁圆形，由10～12心皮组成，果熟时各心皮彼此分离，且与中轴脱离，心皮无毛，淡棕色。"}]},{"ID":"20240607134957-vhr6fjj","Type":"NodeParagraph","Properties":{"id":"20240607134957-vhr6fjj","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607134957-fc5d5ba","Type":"NodeParagraph","Properties":{"id":"20240607134957-fc5d5ba","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 干燥种子呈圆形扁平之橘瓣状，或微呈肾形，细小，直径约1.5～2毫米，较薄的一边中央凹下，外表为棕黄色的包壳（果皮），具环形细皱纹.搓去皮壳后。种子呈棕褐色。质坚硬，破碎后微有香味。以颗粒饱满、坚老者为佳。"}]},{"ID":"20240607134957-uegie3e","Type":"NodeParagraph","Properties":{"id":"20240607134957-uegie3e","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607134957-dahvk0x","Type":"NodeParagraph","Properties":{"id":"20240607134957-dahvk0x","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 种子含脂肪油及蛋白质。花含花青素类。鲜冬葵含单糖6.8～7.4％，蔗糖4.1～4.6％，麦芽糖4.5～4.8％，淀粉1.2％。"}]},{"ID":"20240607134957-0nrww1w","Type":"NodeParagraph","Properties":{"id":"20240607134957-0nrww1w","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607134957-1xn456l","Type":"NodeParagraph","Properties":{"id":"20240607134957-1xn456l","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 入大小肠、膀胱经。"}]},{"ID":"20240607134957-as44jun","Type":"NodeParagraph","Properties":{"id":"20240607134957-as44jun","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入小肠、膀胱二经。\""}]},{"ID":"20240607134957-jo0sdml","Type":"NodeParagraph","Properties":{"id":"20240607134957-jo0sdml","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"入足太阴经气分。\""}]},{"ID":"20240607134957-zcs4019","Type":"NodeParagraph","Properties":{"id":"20240607134957-zcs4019","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入胃、大小肠。\""}]},{"ID":"20240607134957-cpmd4th","Type":"NodeParagraph","Properties":{"id":"20240607134957-cpmd4th","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入肝、肺二经。\""}]},{"ID":"20240607134957-ev1jqep","Type":"NodeParagraph","Properties":{"id":"20240607134957-ev1jqep","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607134957-c2r33mn","Type":"NodeParagraph","Properties":{"id":"20240607134957-c2r33mn","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240607134957-upvet1n","Type":"NodeParagraph","Properties":{"id":"20240607134957-upvet1n","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，寒。\""}]},{"ID":"20240607134957-02cxsrj","Type":"NodeParagraph","Properties":{"id":"20240607134957-02cxsrj","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607134957-u50lbb8","Type":"NodeParagraph","Properties":{"id":"20240607134957-u50lbb8","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"滑，平。\""}]},{"ID":"20240607134957-0kc1jj0","Type":"NodeParagraph","Properties":{"id":"20240607134957-0kc1jj0","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"味甘苦，性微寒，无毒。\""}]},{"ID":"20240607134957-etvtg1u","Type":"NodeParagraph","Properties":{"id":"20240607134957-etvtg1u","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607134957-v84asv5","Type":"NodeParagraph","Properties":{"id":"20240607134957-v84asv5","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 脾虚肠滑者忌服，孕妇慎服。"}]},{"ID":"20240607134957-qo1w70i","Type":"NodeParagraph","Properties":{"id":"20240607134957-qo1w70i","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"黄芩为之使。\""}]},{"ID":"20240607134957-uu5nd5r","Type":"NodeParagraph","Properties":{"id":"20240607134957-uu5nd5r","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"气虚下陷，脾虚肠滑，二者禁用。\""}]},{"ID":"20240607134957-6xqch83","Type":"NodeParagraph","Properties":{"id":"20240607134957-6xqch83","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607134957-3gpznuo","Type":"NodeParagraph","Properties":{"id":"20240607134957-3gpznuo","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 利水，滑肠，下乳。治二便不通，淋病，水肿，妇女乳汁不行，乳房肿痛。"}]},{"ID":"20240607134957-fidsuuv","Type":"NodeParagraph","Properties":{"id":"20240607134957-fidsuuv","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五脏六府寒热羸瘦，五癃，利小便。\""}]},{"ID":"20240607134957-hwpvtbd","Type":"NodeParagraph","Properties":{"id":"20240607134957-hwpvtbd","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"葵子汁解蜀椒毒。\""}]},{"ID":"20240607134957-9qlzg56","Type":"NodeParagraph","Properties":{"id":"20240607134957-9qlzg56","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"疗妇人乳难内（’内’一作’血’）闭。\""}]},{"ID":"20240607134957-ssdu8h7","Type":"NodeParagraph","Properties":{"id":"20240607134957-ssdu8h7","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"治五淋，主奶肿，下乳汁。\""}]},{"ID":"20240607134957-ahyqede","Type":"NodeParagraph","Properties":{"id":"20240607134957-ahyqede","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑤《本草衍义》：\"患痈疖毒热内攻，未出脓者，水吞三、五枚，遂作窍，脓出。\""}]},{"ID":"20240607134957-ey3um97","Type":"NodeParagraph","Properties":{"id":"20240607134957-ey3um97","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"通大便，消水气，滑胎，治痢。\""}]},{"ID":"20240607134957-hnwsepu","Type":"NodeParagraph","Properties":{"id":"20240607134957-hnwsepu","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑦《本草通玄》：\"达诸窍。\""}]},{"ID":"20240607134957-4g59t5o","Type":"NodeParagraph","Properties":{"id":"20240607134957-4g59t5o","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑧《本草汇》：\"下胞衣。\""}]},{"ID":"20240607134957-x8dyzi1","Type":"NodeParagraph","Properties":{"id":"20240607134957-x8dyzi1","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607134957-hfbk595","Type":"NodeParagraph","Properties":{"id":"20240607134957-hfbk595","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～5钱；或入散剂。"}]},{"ID":"20240607134957-tp2ik3w","Type":"NodeParagraph","Properties":{"id":"20240607134957-tp2ik3w","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607134957-9t4xicm","Type":"NodeParagraph","Properties":{"id":"20240607134957-9t4xicm","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" ①治卒关格，大小便不通，支满欲死：葵子二升，水四升，煮取一升，顿服。内猪脂如鸡子一丸则弥佳。（《肘后方》）"}]},{"ID":"20240607134957-by8fffp","Type":"NodeParagraph","Properties":{"id":"20240607134957-by8fffp","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"②治大便不通十日至一月者：葵子末入乳汁等分，和服。（《圣惠方》）"}]},{"ID":"20240607134957-uv9l1rc","Type":"NodeParagraph","Properties":{"id":"20240607134957-uv9l1rc","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"③治血淋及虚劳尿血：葵子一升，水三升，取汁，日三服。（《千金方》）"}]},{"ID":"20240607134957-nd2myqa","Type":"NodeParagraph","Properties":{"id":"20240607134957-nd2myqa","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"④治妊娠患子淋：英子一升，以水三升，煮取二升，分再服。（《千金方》）"}]},{"ID":"20240607134957-nqmpxt2","Type":"NodeParagraph","Properties":{"id":"20240607134957-nqmpxt2","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑤治产后淋沥不通：葵子一合，朴消八分。水二升，煎八合，下消服之。（《姚僧坦集验方》）"}]},{"ID":"20240607134957-9onko7s","Type":"NodeParagraph","Properties":{"id":"20240607134957-9onko7s","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑥妊娠有水气，身重，小便不利，洒渐恶寒，起即头眩：葵子一斤，茯苓三两。上二味，杵为散，饮服方寸匕，日三服，小便利则愈。（《金匮要略》葵子茯苓散）"}]},{"ID":"20240607134957-05kivow","Type":"NodeParagraph","Properties":{"id":"20240607134957-05kivow","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑦治难产，若生未得者：冬葵子一合，捣破，以水二升，煮取一升；已下，只可半升，去滓，顿服之。（《食疗本草》）"}]},{"ID":"20240607134957-ma6vgqd","Type":"NodeParagraph","Properties":{"id":"20240607134957-ma6vgqd","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑧治胎死腹中：葵子一升，阿胶五两。上二味，以水五升，煮取二升，顿服之。未出再煮服。（《千金方》）"}]},{"ID":"20240607134957-khr2qf4","Type":"NodeParagraph","Properties":{"id":"20240607134957-khr2qf4","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑨治胎死腹中，若母病欲下：牛膝三两，葵子一升。上二味，以水七升，煮取三升，分三服。（《千金方》）"}]},{"ID":"20240607134957-xx4w3e2","Type":"NodeParagraph","Properties":{"id":"20240607134957-xx4w3e2","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑩治乳妇气脉壅塞，乳汁不行，及经络凝滞，奶房胀痛，留蓄作痈毒：葵菜子（炒香）、缩砂仁等分。为末，热酒服二钱。（《妇人良方》）"}]},{"ID":"20240607134957-eoihal9","Type":"NodeParagraph","Properties":{"id":"20240607134957-eoihal9","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑾治血痢、产痢：冬葵子为末，每服二钱，入腊茶一钱，沸汤调服，日三。（《圣惠方》）"}]},{"ID":"20240607134957-6rqxjhs","Type":"NodeParagraph","Properties":{"id":"20240607134957-6rqxjhs","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⑿治痎疟邪热：冬葵子阴干为末，酒服二钱。（《圣惠方》）"}]},{"ID":"20240607134957-kvoa0x5","Type":"NodeParagraph","Properties":{"id":"20240607134957-kvoa0x5","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⒀治盗汗：冬葵子三钱，水煎兑白糖服。（江西《草药手册》）"}]},{"ID":"20240607134957-c70v5q9","Type":"NodeParagraph","Properties":{"id":"20240607134957-c70v5q9","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"⒁治面上疱疮：冬葵子、柏子仁、茯苓、瓜瓣各一两。为末，食后酒服方寸匕，日三服。（陶弘景）"}]},{"ID":"20240607134957-nj44t94","Type":"NodeParagraph","Properties":{"id":"20240607134957-nj44t94","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607134957-ffzzk3p","Type":"NodeParagraph","Properties":{"id":"20240607134957-ffzzk3p","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 目前商品所用的冬葵子，大多为锦葵科植物苘麻的种子。考冬葵子与苘麻子在诸家《本草》中均各列守条，效用亦不相同，参见\"苘麻\"及\"苘实\"条。"}]},{"ID":"20240607134957-0e2bivw","Type":"NodeParagraph","Properties":{"id":"20240607134957-0e2bivw","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607134957-kcrzgnx","Type":"NodeParagraph","Properties":{"id":"20240607134957-kcrzgnx","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607134957-e3wk6it","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607134957-e3wk6it","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"《中华本草》：冬葵子"}]},{"ID":"20240607134957-h2mudms","Type":"NodeParagraph","Properties":{"id":"20240607134957-h2mudms","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607134957-03651yw","Type":"NodeParagraph","Properties":{"id":"20240607134957-03651yw","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" Dōnɡ Kuí Zǐ"}]},{"ID":"20240607134957-nxcwjzj","Type":"NodeParagraph","Properties":{"id":"20240607134957-nxcwjzj","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607134957-5frradg","Type":"NodeParagraph","Properties":{"id":"20240607134957-5frradg","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 葵子、葵菜子。"}]},{"ID":"20240607134957-ds9dpyp","Type":"NodeParagraph","Properties":{"id":"20240607134957-ds9dpyp","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607134957-3a0uz2m","Type":"NodeParagraph","Properties":{"id":"20240607134957-3a0uz2m","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" Chingma Abutilon Seed"}]},{"ID":"20240607134957-kp5f3uw","Type":"NodeParagraph","Properties":{"id":"20240607134957-kp5f3uw","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607134957-hgv4u1v","Type":"NodeParagraph","Properties":{"id":"20240607134957-hgv4u1v","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1.《名医别录》：冬葵子，生少室山。十二月采之。"}]},{"ID":"20240607134957-zziw3df","Type":"NodeParagraph","Properties":{"id":"20240607134957-zziw3df","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：以秋种葵，覆养经冬至春作子，谓之冬葵，多入药用，至滑利，能下石淋。春葵子亦滑利不堪。余药用根，故是常葵尔。"}]},{"ID":"20240607134957-ccart9g","Type":"NodeParagraph","Properties":{"id":"20240607134957-ccart9g","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：葵菜，古人种为常食，今人种者颇鲜。有紫茎、白茎二种，以白茎为胜，大叶小花，花紫黄色，其最小者，名鸭脚葵，其实大如指顶，皮薄如扁，实内子轻虚如榆荚仁，四、五月种者可留子，六、七月种者为秋葵"}]},{"ID":"20240607134957-64t2f2n","Type":"NodeParagraph","Properties":{"id":"20240607134957-64t2f2n","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607134957-9m6xv8a","Type":"NodeParagraph","Properties":{"id":"20240607134957-9m6xv8a","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 药材基源：为锦葵科植物野葵和冬葵的果实。"}]},{"ID":"20240607134957-k2tapt7","Type":"NodeParagraph","Properties":{"id":"20240607134957-k2tapt7","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Malva verticillata L.[M.pulchella Bernh.]2.Melva crispa L."}]},{"ID":"20240607134957-68rgikj","Type":"NodeParagraph","Properties":{"id":"20240607134957-68rgikj","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春季种子成熟时采收。"}]},{"ID":"20240607134957-f0i1pdx","Type":"NodeParagraph","Properties":{"id":"20240607134957-f0i1pdx","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607134957-9m0ruwa","Type":"NodeParagraph","Properties":{"id":"20240607134957-9m0ruwa","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于平原、山野等处。"}]},{"ID":"20240607134957-w78i7kl","Type":"NodeParagraph","Properties":{"id":"20240607134957-w78i7kl","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"资源分布：1.我国各地均有分布。"}]},{"ID":"20240607134957-ep41d7g","Type":"NodeParagraph","Properties":{"id":"20240607134957-ep41d7g","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"2.我国西南及河北、甘肃、江西、湖北、湖南等地种植。"}]},{"ID":"20240607134957-1a5dbz1","Type":"NodeParagraph","Properties":{"id":"20240607134957-1a5dbz1","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607134957-8p8j5hm","Type":"NodeParagraph","Properties":{"id":"20240607134957-8p8j5hm","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 1．野葵 二年生草本，高60-90cm。茎被星状长柔毛。叶互生；叶柄长2-8cm，仅上面槽内被绒毛；托叶卵状披针形，被星状柔毛；叶片肾形至圆形，直径5-11cm，常为掌状5-7裂，裂片短，三角形，具钝尖头，边缘有钝齿，两面被极疏糙状毛或几无毛。花3至数朵簇生于叶腋间，几无柄至有极短柄；总苞的小苞片3枚，线状披针形，被纤毛；萼杯状，5裂，广三角形，被疏星状长硬毛；花冠淡白色至淡红色，花瓣5，长6-9mm，先端凹入，具爪；雄蕊柱长4mm，被毛；花柱分枝10-11。果扁圆形，直径5-7mm，分果丬10-11，背面平滑，两侧具网纹。种子肾形，直径约1.5mm，紫褐色，秃净。花期3-11月。"}]},{"ID":"20240607134957-ypj5zly","Type":"NodeParagraph","Properties":{"id":"20240607134957-ypj5zly","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"2．冬葵 本种与野葵的区别为：一年生草本，不分枝。茎被柔毛。叶柄细瘦，被疏柔毛；叶片圆形，5-7裂，直径5-8cm，基部心形，边缘具细锯齿，特别皱曲。花白色。果扁球形，直径约8mm，分果爿11，网状，具细柔毛。种子直径约1mm，暗黑色。花期6-9月。"}]},{"ID":"20240607134957-vvyop3h","Type":"NodeParagraph","Properties":{"id":"20240607134957-vvyop3h","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607134957-fjpsn0p","Type":"NodeParagraph","Properties":{"id":"20240607134957-fjpsn0p","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 冬葵子果实由7-9个小分果组成，呈扁平圆盘状，底部有宿存花萼。分果呈橘瓣状或肾形，直径1.5-2mm，较薄的一边中央凹下。果皮外表为棕黄色，背面较光滑，两侧面靠凹下处各有一微凹下圆点，由圆点向外有放射性条纹。种子橘瓣状肾形，种皮黑色至棕褐色。质坚硬，破碎后子叶心形，两片重叠折曲。气微、味涩。"}]},{"ID":"20240607134957-4luj7j9","Type":"NodeParagraph","Properties":{"id":"20240607134957-4luj7j9","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：灰褐色。①胚乳细胞较多见，呈多角形或类方形，直径11-35μm，壁略呈念珠状增厚。②种皮栅状细胞表面观细胞界限不清晰，细胞细小，呈星状；侧面观为一列柱状细胞，长33-46μm，直径8-12μm，壁甚厚、木化，胞腔梭形，内含球状结晶。③星状毛易见，由5-7细胞组成，亦有单个散在，呈披针形，基部钝圆，直径5-15μm，长106-245μm，壁厚1-2μm。④色素细胞类多角形，类长方形，胞腔内含红棕色块状物。⑤子叶表皮细胞类长方形，薄壁细胞呈类多角形或椭圆形，含拟晶体。⑤螺纹导管多见，直径27-33μm，网纹导管较少见。"}]},{"ID":"20240607134957-68ku3ai","Type":"NodeParagraph","Properties":{"id":"20240607134957-68ku3ai","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607134957-d68tpn7","Type":"NodeParagraph","Properties":{"id":"20240607134957-d68tpn7","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 种子含中性多糖（neutral polysaccharide）：MVS-Ⅰ，MVS-ⅡA、MVS-ⅡG；酸性多糖（acidic polysac-charide）:MVS-ⅢA，MVS-ⅣA，MVS-Ⅳ及肽聚糖（pep-tidoglycan）：MVS-V。"}]},{"ID":"20240607134957-a51i61v","Type":"NodeParagraph","Properties":{"id":"20240607134957-a51i61v","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607134957-4a37hoo","Type":"NodeParagraph","Properties":{"id":"20240607134957-4a37hoo","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取粉末2g，加水20ml，振摇15min，滤过。取滤液加活性炭1g，置水浴上脱色15min，滤过。取滤液2ml，加碱性酒石酸铜试液4滴，置水浴上加热5min，生成棕红色沉淀；另取滤液2ml，加10％a-萘酚乙醇溶液3滴，摇匀，沿管壁加硫酸0.5ml，两液接界处显紫红色环。"}]},{"ID":"20240607134957-bhdc04c","Type":"NodeParagraph","Properties":{"id":"20240607134957-bhdc04c","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607134957-2pxbbtg","Type":"NodeParagraph","Properties":{"id":"20240607134957-2pxbbtg","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 大肠；小肠；肝；肺；胃；膀胱经"}]},{"ID":"20240607134957-rsq5hjk","Type":"NodeParagraph","Properties":{"id":"20240607134957-rsq5hjk","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607134957-hsr0kh9","Type":"NodeParagraph","Properties":{"id":"20240607134957-hsr0kh9","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 甘；寒"}]},{"ID":"20240607134957-5bfg4wn","Type":"NodeParagraph","Properties":{"id":"20240607134957-5bfg4wn","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607134957-nfg6wvp","Type":"NodeParagraph","Properties":{"id":"20240607134957-nfg6wvp","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 脾虚肠滑者忌服，孕妇慎服。"}]},{"ID":"20240607134957-h52fyar","Type":"NodeParagraph","Properties":{"id":"20240607134957-h52fyar","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：黄芩为之使。"}]},{"ID":"20240607134957-xrloap7","Type":"NodeParagraph","Properties":{"id":"20240607134957-xrloap7","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"2.《得配本草》：气虚下陷，脾虚肠滑，二者禁用。"}]},{"ID":"20240607134957-cxxcjg0","Type":"NodeParagraph","Properties":{"id":"20240607134957-cxxcjg0","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607134957-r1c817x","Type":"NodeParagraph","Properties":{"id":"20240607134957-r1c817x","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 利水通淋；滑肠通便；下乳。主淋病；水肿；大便不通；乳汗不行"}]},{"ID":"20240607134957-15nqton","Type":"NodeParagraph","Properties":{"id":"20240607134957-15nqton","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607134957-epom0uv","Type":"NodeParagraph","Properties":{"id":"20240607134957-epom0uv","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入散剂。"}]},{"ID":"20240607134957-ud21czu","Type":"NodeParagraph","Properties":{"id":"20240607134957-ud21czu","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607134957-yr2wx9d","Type":"NodeParagraph","Properties":{"id":"20240607134957-yr2wx9d","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：葵，气味俱薄，淡滑为阳，故能利窍通乳，消肿滑胎也，其根叶与子，功用相同。通大便，消水气，滑胎，治痢。"}]},{"ID":"20240607134957-wxb4l3j","Type":"NodeParagraph","Properties":{"id":"20240607134957-wxb4l3j","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"2.《本草崇原集说》：葵性寒滑，似非孕妇所直，何以《金匮》治妊娠水气，用葵子茯苓散。修园曰，有病则病当之也。《千金》以参、术等味驾驭其间，愈觉平妥。"}]},{"ID":"20240607134957-vmfkoh5","Type":"NodeParagraph","Properties":{"id":"20240607134957-vmfkoh5","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"3.《本经》：主五脏六府寒热赢瘦，五癃，利小便。《本草经集注》：葵子汁解蜀椒毒。"}]},{"ID":"20240607134957-gevu67o","Type":"NodeParagraph","Properties":{"id":"20240607134957-gevu67o","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"4.《别录》：疗妇人乳难内（内一作血）闭。"}]},{"ID":"20240607134957-re1zyd4","Type":"NodeParagraph","Properties":{"id":"20240607134957-re1zyd4","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"5.《药性论》：治五淋，主奶肿，下乳汁。"}]},{"ID":"20240607134957-faph7mq","Type":"NodeParagraph","Properties":{"id":"20240607134957-faph7mq","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"6.《本草衍义》：患痈疖毒热内攻，未出脓者，水吞三、五枚，遂作窍，脓出。"}]},{"ID":"20240607134957-13i3w3n","Type":"NodeParagraph","Properties":{"id":"20240607134957-13i3w3n","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"7.《本草通玄》：达诸窍。"}]},{"ID":"20240607134957-v089i9c","Type":"NodeParagraph","Properties":{"id":"20240607134957-v089i9c","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"8.《本草汇》：下胞衣。"}]},{"ID":"20240607134957-wga4ttx","Type":"NodeParagraph","Properties":{"id":"20240607134957-wga4ttx","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607134957-ruvn1ct","Type":"NodeParagraph","Properties":{"id":"20240607134957-ruvn1ct","updated":"20240607134957"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607134958-gopazi8","Type":"NodeThematicBreak","Properties":{"id":"20240607134958-gopazi8"}},{"ID":"20240607134959-8r7iwvr","Type":"NodeParagraph","Properties":{"id":"20240607134959-8r7iwvr"}}]}