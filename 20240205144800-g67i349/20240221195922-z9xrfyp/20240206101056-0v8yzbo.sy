0821131943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 911px;","style":"width: 901px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"龙眼 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/龙眼 12-20240821131943-d01hnpu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 901px;\" parent-style=\"width: 911px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"龙眼叶"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/龙眼叶-20240626150150-6t0ylh5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240626145545-zj98ocd","Type":"NodeParagraph","Properties":{"id":"20240626145545-zj98ocd","updated":"20240821132118"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 541px;","style":"width: 531px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"龙眼树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/龙眼树-20240626145545-6j1nqjx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 531px;\" parent-style=\"width: 541px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 718px;","style":"width: 708px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"龙眼 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/龙眼 14-20240821132118-0lbmxo6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 708px;\" parent-style=\"width: 718px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821132217-4gtqoue","Type":"NodeParagraph","Properties":{"id":"20240821132217-4gtqoue","updated":"20240821132217"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"龙眼 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/龙眼 15-20240821132217-k7h4wf5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612103749-ereqvwr","Type":"NodeThematicBreak","Properties":{"id":"20240612103749-ereqvwr"}},{"ID":"20240612104040-qlc0t5z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104040-qlc0t5z","updated":"20240612104044"},"Children":[{"Type":"NodeText","Data":"龙眼《神农本草经》"}]},{"ID":"20240612104040-a5lc0lm","Type":"NodeParagraph","Properties":{"id":"20240612104040-a5lc0lm","updated":"20240612104040"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240612104040-ko3wci2","Type":"NodeParagraph","Properties":{"id":"20240612104040-ko3wci2","updated":"20240612104040"},"Children":[{"Type":"NodeText","Data":"主五脏邪气，安志厌食。久服，强魂聪明，轻身，不老，通神明。一名益智。生山谷。"}]},{"ID":"20240612104040-3262r1h","Type":"NodeParagraph","Properties":{"id":"20240612104040-3262r1h","updated":"20240612104040"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：龙眼一名益智，要术一名比目。（《御览》）"}]},{"ID":"20240612104040-22xtc6e","Type":"NodeParagraph","Properties":{"id":"20240612104040-22xtc6e","updated":"20240612104040"},"Children":[{"Type":"NodeText","Data":"《名医》曰：其大者似槟榔，生南海松树上，五月采，阴干。"}]},{"ID":"20240612104040-6f0p4gw","Type":"NodeParagraph","Properties":{"id":"20240612104040-6f0p4gw","updated":"20240612104040"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：益智，龙眼也。刘达注吴都赋云：龙眼，如荔枝而小，圆如弹丸，味甘，胜荔枝，苍梧，交址，南海，合浦皆献之，山中人家亦种之。"}]},{"ID":"20240612104113-1rogdc0","Type":"NodeThematicBreak","Properties":{"id":"20240612104113-1rogdc0"}},{"ID":"20240612104114-5w0bc7d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104114-5w0bc7d","updated":"20240612104118"},"Children":[{"Type":"NodeText","Data":"龙眼《得配本草》"}]},{"ID":"20240612104114-apa58u5","Type":"NodeParagraph","Properties":{"id":"20240612104114-apa58u5","updated":"20240612104114"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名圆眼"}]},{"ID":"20240612104114-1tk4u6s","Type":"NodeParagraph","Properties":{"id":"20240612104114-1tk4u6s","updated":"20240612104114"},"Children":[{"Type":"NodeText","Data":"甘，平，润。入手少阴、足太阴经血分。益脾胃，葆心血，润五脏，治怔忡。"}]},{"ID":"20240612104114-qphddfa","Type":"NodeParagraph","Properties":{"id":"20240612104114-qphddfa","updated":"20240612104114"},"Children":[{"Type":"NodeText","Data":"蒸熟细嚼，生津。膈满者禁用。过食润肠不助脾。"}]},{"ID":"20240612104114-muy1zid","Type":"NodeParagraph","Properties":{"id":"20240612104114-muy1zid","updated":"20240612104114"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核"}]},{"ID":"20240612104114-ippv45c","Type":"NodeParagraph","Properties":{"id":"20240612104114-ippv45c","updated":"20240612104114"},"Children":[{"Type":"NodeText","Data":"研末，敷金疮出血。同胡椒研末，汗出时擦之，治狐臭。"}]},{"ID":"20240612104137-fyxwzn9","Type":"NodeThematicBreak","Properties":{"id":"20240612104137-fyxwzn9"}},{"ID":"20240612104138-irrepvx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104138-irrepvx","updated":"20240612104142"},"Children":[{"Type":"NodeText","Data":"龙眼《本草衍义》"}]},{"ID":"20240612104138-luppoz9","Type":"NodeParagraph","Properties":{"id":"20240612104138-luppoz9","updated":"20240612104138"},"Children":[{"Type":"NodeText","Data":"经曰∶一名益智。今专为果，未见入药。《补注》不言，《神农本草》编入木部中品，果部中复不曾收入。今除为果之外，别无龙眼。若为益智子，则专调诸气，今为果者复不能也。矧自有益智条，远不相当，故知木部龙眼，即便是今为果者。按今《注》云∶“甘味归脾，而能益智。”此说甚当。"}]},{"ID":"20240612104127-bby3ahz","Type":"NodeThematicBreak","Properties":{"id":"20240612104127-bby3ahz"}},{"ID":"20240612104129-ovr69i8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104129-ovr69i8","updated":"20240612104133"},"Children":[{"Type":"NodeText","Data":"龙眼《本经逢原》"}]},{"ID":"20240612104129-ll3lh8e","Type":"NodeParagraph","Properties":{"id":"20240612104129-ll3lh8e","updated":"20240612104129"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俗名圆眼"}]},{"ID":"20240612104129-ys4n42z","Type":"NodeParagraph","Properties":{"id":"20240612104129-ys4n42z","updated":"20240612104129"},"Children":[{"Type":"NodeText","Data":"甘平无毒。桂产者佳，粤东者性热不堪入药。"}]},{"ID":"20240612104129-kihfq71","Type":"NodeParagraph","Properties":{"id":"20240612104129-kihfq71","updated":"20240612104129"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"龙眼补血益肝，同枸杞熬膏专补心脾之血。归脾汤用之，治思虑伤心脾，皆取甘味归脾，能益人智之义。然中满家呕家勿食，为其气壅也；师尼寡妇勿用，以其能助心包之火，与三焦之火相煽也。"}]},{"ID":"20240612104101-098oxhv","Type":"NodeThematicBreak","Properties":{"id":"20240612104101-098oxhv"}},{"ID":"20240612104103-e2d9k4y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104103-e2d9k4y","updated":"20240612104108"},"Children":[{"Type":"NodeText","Data":"龙眼《神农本草经赞》"}]},{"ID":"20240612104103-s7xd5a2","Type":"NodeParagraph","Properties":{"id":"20240612104103-s7xd5a2","updated":"20240612104103"},"Children":[{"Type":"NodeText","Data":"味甘平。主五脏邪气。安志。厌食。久服强魂。聪明。轻身不老。通神明。一名益智。生山谷。"}]},{"ID":"20240612104103-o9r3r0e","Type":"NodeParagraph","Properties":{"id":"20240612104103-o9r3r0e","updated":"20240612104103"},"Children":[{"Type":"NodeText","Data":"旁挺幽姿。莫如南土。金饰蜜脾。玉流膏乳。星结良宵。珠还合浦。益智策勋。呼奴谁侮。"}]},{"ID":"20240612104103-4l03shz","Type":"NodeParagraph","Properties":{"id":"20240612104103-4l03shz","updated":"20240612104103"},"Children":[{"Type":"NodeText","Data":"刘子诗。幽姿旁挺绿婆娑。诗。莫如南土。宋珏诗。外裹黄金饰。荔枝谱。龙目丛生。"}]},{"ID":"20240612104103-wsa06yq","Type":"NodeParagraph","Properties":{"id":"20240612104103-wsa06yq","updated":"20240612104103"},"Children":[{"Type":"NodeText","Data":"玉露流晨。李商隐诗。红露花房白蜜脾。苏轼诗。平地走膏乳。广东志。澄海县。七夕酒集。"}]},{"ID":"20240612104103-9hvqdyq","Type":"NodeParagraph","Properties":{"id":"20240612104103-9hvqdyq","updated":"20240612104103"},"Children":[{"Type":"NodeText","Data":"多用龙眼。谓之结星。风土记七日为良日。苏轼诗。又恐珠还浦。名医曰。一名益智。王象晋诗。况兼益智策勋殊。南方草木状。一名荔枝奴。孟子。谁敢侮之。"}]},{"ID":"20240612104050-o8ys0zl","Type":"NodeThematicBreak","Properties":{"id":"20240612104050-o8ys0zl"}},{"ID":"20240612104051-fd566vi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104051-fd566vi","updated":"20240612104055"},"Children":[{"Type":"NodeText","Data":"龙眼《冯氏锦囊秘录》"}]},{"ID":"20240612104051-ixwa31u","Type":"NodeParagraph","Properties":{"id":"20240612104051-ixwa31u","updated":"20240612104051"},"Children":[{"Type":"NodeText","Data":"禀稼穑之化，故味甘、气平、无毒。入足太阴、手少阴经。少阴为君主之官，藏神而主血。甘能益血补心，则君主强神明通，五脏安矣。且甘能补脾，脾得补则中气充足，化源不竭，五脏更安，百邪俱辟，心乐神怡，耳目聪明，轻身耐老也。"}]},{"ID":"20240612104051-xgd9kk6","Type":"NodeParagraph","Properties":{"id":"20240612104051-xgd9kk6","updated":"20240612104051"},"Children":[{"Type":"NodeText","Data":"龙眼取肉入药者，甘先入脾也。古方归脾汤中，功与人参并奏，《本经》一名益智，裨益脾之所藏，补心虚而长智，悦胃气以培脾，除健忘与怔忡，能安神而熟寐，不热不寒，和平可贵，养肌肉，美容颜，多服强志聪明，久服轻身不老，若肠滑中满者忌之。"}]},{"ID":"20240612104051-omb1rio","Type":"NodeParagraph","Properties":{"id":"20240612104051-omb1rio","updated":"20240612104051"},"Children":[{"Type":"NodeText","Data":"核治狐臭，以六枚同胡椒二七粒，同研，遇汗出即擦之。"}]},{"ID":"20240612104051-7w3ybjb","Type":"NodeParagraph","Properties":{"id":"20240612104051-7w3ybjb","updated":"20240612104051"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 灌浆时，可人大补托剂中。但泄利肠滑者宜少用之。"}]},{"ID":"20240612104051-svdbvdo","Type":"NodeParagraph","Properties":{"id":"20240612104051-svdbvdo","updated":"20240612104051"},"Children":[{"Type":"NodeText","Data":"按∶方外服龙眼法，五更将不见水干龙眼，以舌在齿上取肉去核，即是舌搅华池之法，细细嚼至渣细成膏，连口中津， 然咽下，如咽甚硬物毕，又如前法，食第二枚，具服九枚。约有一时许，服毕方起，辰巳二时，又服九枚，未申二时，又服九枚，临卧又服九枚，一日四次、却有半日之工、服龙眼则气心净，且漱津纳咽，是取坎填离之法，劳症者勤行一月，无不愈者，方土秘之。"}]},{"ID":"20240612103749-il2efil","Type":"NodeThematicBreak","Properties":{"id":"20240612103749-il2efil"}},{"ID":"20240612103750-63natus","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103750-63natus","updated":"20240612103755"},"Children":[{"Type":"NodeText","Data":"龙眼《本草经集注》"}]},{"ID":"20240612103750-5tf4z5t","Type":"NodeParagraph","Properties":{"id":"20240612103750-5tf4z5t","updated":"20240612103750"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主治五脏邪气，安志厌食，除虫去毒。久服强魂魄，聪察，轻身，不老，通神明。一名益智。其大者似槟榔。生南海山谷。"}]},{"ID":"20240612103750-ocktmqr","Type":"NodeParagraph","Properties":{"id":"20240612103750-ocktmqr","updated":"20240612103750"},"Children":[{"Type":"NodeText","Data":"广州别有龙眼，似荔枝而小，非益智，恐彼人别名，今者为益智耳。食之并利人。"}]},{"ID":"20240612103858-3yyxq85","Type":"NodeThematicBreak","Properties":{"id":"20240612103858-3yyxq85"}},{"ID":"20240612103858-8292b0d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103858-8292b0d","updated":"20240612103914"},"Children":[{"Type":"NodeText","Data":"龙眼《千金翼方》"}]},{"ID":"20240612103858-mbt14g7","Type":"NodeParagraph","Properties":{"id":"20240612103858-mbt14g7","updated":"20240612103858"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主五脏邪气，安志厌食，除虫去毒。久服强魂聪明，轻身不老，通神明。一名益智。其大者似槟榔，生南海山谷。"}]},{"ID":"20240612103956-pbt1qy1","Type":"NodeThematicBreak","Properties":{"id":"20240612103956-pbt1qy1"}},{"ID":"20240612103957-znagklr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103957-znagklr","updated":"20240612104001"},"Children":[{"Type":"NodeText","Data":"龙眼《本草纲目》"}]},{"ID":"20240612103957-jfp1o1g","Type":"NodeParagraph","Properties":{"id":"20240612103957-jfp1o1g","updated":"20240612103957"},"Children":[{"Type":"NodeText","Data":"「释名」龙目、圆眼、益智、亚荔枝、荔枝奴、骊珠、燕卵、蜜脾、鲛泪、川弹子。"}]},{"ID":"20240612103957-r4pzkqh","Type":"NodeParagraph","Properties":{"id":"20240612103957-r4pzkqh","updated":"20240612103957"},"Children":[{"Type":"NodeText","Data":"「气味」（实）甘、平、无毒。"}]},{"ID":"20240612103957-au4ku2j","Type":"NodeParagraph","Properties":{"id":"20240612103957-au4ku2j","updated":"20240612103957"},"Children":[{"Type":"NodeText","Data":"「主治」思虑过度，劳伤心脾，健忘怔忡，虚烦不眠，自汗惊悸。用龙眼肉、酸枣仁（炒）、黄芪（炙）、白术（焙）、茯神各一两，木香半两、炙甘草二钱半，切细。各药配齐后，每服五钱，加姜三惩、枣一枚、水二盅煎成一盅，温服。此方名“归脾汤”。"}]},{"ID":"20240612104029-7phkllb","Type":"NodeThematicBreak","Properties":{"id":"20240612104029-7phkllb"}},{"ID":"20240612104030-falh0dn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104030-falh0dn","updated":"20240612104034"},"Children":[{"Type":"NodeText","Data":"龙眼《顾松园医镜》"}]},{"ID":"20240612104030-wf8jbox","Type":"NodeParagraph","Properties":{"id":"20240612104030-wf8jbox","updated":"20240612104030"},"Children":[{"Type":"NodeText","Data":"〔甘平，入心、脾二经。〕补心虚而长智，〔为其能益血，补心长智，故别名益智。〕悦胃气以培脾，〔甘先入脾、胃也。〕除健忘与怔忡，能安神而熟寐。〔皆益血补心之效。〕〕"}]},{"ID":"20240612104017-5kwz9ii","Type":"NodeThematicBreak","Properties":{"id":"20240612104017-5kwz9ii"}},{"ID":"20240612104018-hqqqr7t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104018-hqqqr7t","updated":"20240612104024"},"Children":[{"Type":"NodeText","Data":"龙眼《本草图经》"}]},{"ID":"20240612104018-8yxtqzr","Type":"NodeParagraph","Properties":{"id":"20240612104018-8yxtqzr","updated":"20240612104021"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"龙眼"},{"Type":"NodeText","Data":"，生南海山谷，今闽、广、蜀道出荔枝处皆有之。木高二丈许，似荔枝而叶微小，凌冬不凋；春末夏初，生细白花，七月而实成，壳青黄色，纹作鳞甲，形圆如弹丸，核若无患而不坚，肉白有浆，甚甘美；其实极繁，每枝常三二十枚，荔枝才过，龙眼即熟，故南人目为荔枝奴，一名益智，以其味甘归脾，而能益智耳。下品自有益智子，非此物也。《东观汉记》云∶南海旧献龙眼、荔枝，十里一置，五里一候，奔驰险阻，道路为患。孝和时，汝南唐羌为临武长县接南海，上书言状，帝下诏，太官勿复受献，由是而止。其为世所贵重久矣。今人亦甚珍之，曝干寄远，北中以为佳果，亚于荔枝。"}]},{"ID":"20240612104006-rprmr07","Type":"NodeThematicBreak","Properties":{"id":"20240612104006-rprmr07"}},{"ID":"20240612104007-t29kcxt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104007-t29kcxt","updated":"20240612104012"},"Children":[{"Type":"NodeText","Data":"龙眼《本草经解》"}]},{"ID":"20240612104007-meme8n0","Type":"NodeParagraph","Properties":{"id":"20240612104007-meme8n0","updated":"20240612104007"},"Children":[{"Type":"NodeText","Data":"本草主治云．安志厌食．厌平声．饱也．纲目称其开胃益脾．补虚长智．即安志厌食之谓也．"}]},{"ID":"20240612103918-vw4p7pa","Type":"NodeThematicBreak","Properties":{"id":"20240612103918-vw4p7pa"}},{"ID":"20240612103919-p0no3lt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103919-p0no3lt","updated":"20240612103929"},"Children":[{"Type":"NodeText","Data":"龙眼《雷公炮制药性解》"}]},{"ID":"20240612103919-42zq7ha","Type":"NodeParagraph","Properties":{"id":"20240612103919-42zq7ha","updated":"20240612103919"},"Children":[{"Type":"NodeText","Data":"味甘，性温无毒，入心脾二经。主补血气，养肌肉，益虚气，美颜色，除健忘，治怔忡，增智慧，明耳目，久服延年。"}]},{"ID":"20240612103919-jg3xlxv","Type":"NodeParagraph","Properties":{"id":"20240612103919-jg3xlxv","updated":"20240612103919"},"Children":[{"Type":"NodeText","Data":"按∶龙眼甘温之品，脾家所悦。心者脾之母也，母无顾子之忧，则心血可，保故入兹，二经然甘能作胀，凡中满气隔之证，均宜远之。"}]},{"ID":"20240612103946-sr8c3ri","Type":"NodeThematicBreak","Properties":{"id":"20240612103946-sr8c3ri"}},{"ID":"20240612103947-0ccfnu7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103947-0ccfnu7","updated":"20240612103952"},"Children":[{"Type":"NodeText","Data":"龙眼《医学入门》"}]},{"ID":"20240612103947-ds3h8ko","Type":"NodeParagraph","Properties":{"id":"20240612103947-ds3h8ko","updated":"20240612103947"},"Children":[{"Type":"NodeText","Data":"龙眼味甘平无毒，归脾宁心益神智，五脏虚邪从此安，除蛊杀虫核止涕。"}]},{"ID":"20240612103947-mje63bn","Type":"NodeParagraph","Properties":{"id":"20240612103947-mje63bn","updated":"20240612103947"},"Children":[{"Type":"NodeText","Data":"形如龙之眼也。味甘。归脾而能益智宁心，去五脏邪气、厌食，除蛊毒，去三虫，久服聪明通神。核烧烟熏鼻，治流涕不止。"}]},{"ID":"20240612103934-ih5lba5","Type":"NodeThematicBreak","Properties":{"id":"20240612103934-ih5lba5"}},{"ID":"20240612103935-9w27q2b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103935-9w27q2b","updated":"20240612103940"},"Children":[{"Type":"NodeText","Data":"龙眼《名医别录》"}]},{"ID":"20240612103935-nb8ph3t","Type":"NodeParagraph","Properties":{"id":"20240612103935-nb8ph3t","updated":"20240612103935"},"Children":[{"Type":"NodeText","Data":"无毒．除虫去毒．其大者似槟榔，生南海．"}]},{"ID":"20240612103935-yzjy28z","Type":"NodeParagraph","Properties":{"id":"20240612103935-yzjy28z","updated":"20240612103935"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶龙眼，味甘，平．主五脏邪气，安志厌食．久服强魂聪明，轻身不老，通明神．一名益智．"}]},{"ID":"20240612103751-m8ik1k5","Type":"NodeThematicBreak","Properties":{"id":"20240612103751-m8ik1k5"}},{"ID":"20240612103803-myjoo1j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103803-myjoo1j","updated":"20240612103809"},"Children":[{"Type":"NodeText","Data":"龙眼《本草求真》"}]},{"ID":"20240612103803-pqesf8i","Type":"NodeParagraph","Properties":{"id":"20240612103803-pqesf8i","updated":"20240612103803"},"Children":[{"Type":"NodeText","Data":"（夷果）补心脾气血"}]},{"ID":"20240612103803-uphrwqh","Type":"NodeParagraph","Properties":{"id":"20240612103803-uphrwqh","updated":"20240612103803"},"Children":[{"Type":"NodeText","Data":"龙眼（专入心脾）。气味甘温。多有似于大枣。但此甘味更重。润气尤多。于补气之中（温则补气。）又更存有补血之力。（润则补血。）故书载能益脾长智。（脾益则智长。）养心保血。（血保则心养。）为心脾要药。是以心思劳伤而见健忘怔忡惊悸。暨肠风下血。（便血症不一端。然大要血清而色鲜。另作一派。溅出远射。四散如筛。其腹不痛。是为肠风无疑。便血而见腹痛。则为热毒下注。不痛则为湿毒下注。痛而喜手谨按。则为寒毒下注。并血而见鲜红为热。瘀淡为寒。瘀晦为积。鲜紫为燥为结。血如鸡肝烂肉绞痛为蛊。与夫症见面色痿黄。大便不实。声短气息。恶心呕吐。六脉沉迟浮大无力为虚。神气不爽。脉数能食。肠红下泄。腹痛便秘为实。而究不越气失所统。阴不随阳。而血自不归附耳。）俱可用此为治。盖血虽属心生。而亦赖脾以统。思虑而气既耗。则非甘者不能以补。思虑而神更损。则非润者不能以济。龙眼甘润兼有。既能补脾固气。复能保血不耗。则神气自尔长养。而无惊悸健忘之病矣！按古归脾汤有用龙眼肉以治心脾伤损。义实基此。非若大枣力专补脾。气味虽甘。其性稍燥。而无甘润和柔。以至于极之妙也。至书有言久服令人轻身不老。百邪俱辟。止是神智长养之谓。蛊毒可除。三虫可杀。止是气血充足而蛊不食之谓。但此味甘体润。凡中满气壅。肠滑泄利。为大忌耳。桂产者佳。粤东者性热。不堪入药。"}]},{"ID":"20240612103803-sccgze9","Type":"NodeThematicBreak","Properties":{"id":"20240612103803-sccgze9"}},{"ID":"20240612103813-lgvxu76","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103813-lgvxu76","updated":"20240612103818"},"Children":[{"Type":"NodeText","Data":"龙眼《新修本草》"}]},{"ID":"20240612103813-dsr4d6w","Type":"NodeParagraph","Properties":{"id":"20240612103813-dsr4d6w","updated":"20240612103813"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主疗五脏邪气，安志厌食，除虫去毒。久服强魂魄，聪察，轻身不老，通者似槟榔。生南海山谷。"}]},{"ID":"20240612103813-c0zbmun","Type":"NodeParagraph","Properties":{"id":"20240612103813-c0zbmun","updated":"20240612103813"},"Children":[{"Type":"NodeText","Data":"广州别有龙眼，似荔枝而小，非益智，恐彼人别名，今者为益智耳，食之并利人。"}]},{"ID":"20240612103813-4yv4jfp","Type":"NodeParagraph","Properties":{"id":"20240612103813-4yv4jfp","updated":"20240612103813"},"Children":[{"Type":"NodeText","Data":"〔谨案〕益智，似连翘子，头未开者，味甘、辛，殊不似槟榔。其苗、叶、花、根与豆蔻无别，唯子小耳。龙眼一名益智，而益智非龙眼也。其龙眼树，似荔枝，叶若林檎，花白色，子如槟榔，有鳞甲，大如雉卵，味甘酸。"}]},{"ID":"20240612103813-7ouz88c","Type":"NodeThematicBreak","Properties":{"id":"20240612103813-7ouz88c"}},{"ID":"20240612103823-q8ytd3g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103823-q8ytd3g","updated":"20240612103830"},"Children":[{"Type":"NodeText","Data":"龙眼《证类本草》"}]},{"ID":"20240612103823-ieghg6z","Type":"NodeParagraph","Properties":{"id":"20240612103823-ieghg6z","updated":"20240612103823"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主五脏邪气，安志厌食，除虫去毒。久服强魂聪明，轻身不老，通神明。一名益智。其大者似槟榔。生南海山谷。"}]},{"ID":"20240612103823-pmiu1wj","Type":"NodeParagraph","Properties":{"id":"20240612103823-pmiu1wj","updated":"20240612103823"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶广州别有龙眼，似荔枝而小，非益智，恐彼人别名，今者为益智尔。食之并利人。唐本注云∶益智似连翘子头未开者。味甘、辛。殊不似槟榔。其苗、叶、花、根，与豆蔻无别，唯子小尔。龙眼一名益智，而益智非龙眼也。其龙眼树似荔枝，叶若林檎，花白色。子如槟榔，有鳞甲，大如雀卵。味甘、酸也。今注按此树高二丈余，枝叶凌冬不凋。花白色。七月始熟。一名亚荔枝。大者形似槟榔而小，有鳞甲，其肉薄于荔枝，而甘美堪食。"}]},{"ID":"20240612103823-0as3nhn","Type":"NodeParagraph","Properties":{"id":"20240612103823-0as3nhn","updated":"20240612103823"},"Children":[{"Type":"NodeText","Data":"《本经》云一名益智者。盖甘味归脾而能益智，非今益智子尔。臣禹锡等谨按蜀本龙眼，除蛊图经曰∶龙眼，生南海山谷，今闽、广、蜀道出荔枝处皆有之。木高二丈许，似荔枝而叶微小，凌冬不凋。春末夏初，生细白花。七月而实成，壳青黄色，文作鳞甲，形圆如弹丸，核若无患而不坚，肉白有浆，甚甘美。其实极繁，每枝常三、二十枚。荔枝才过，龙眼即熟，故观汉记》云∶南海旧献龙眼、荔枝，十里一置，五里一候，奔驰险阻，道路为患。孝和时，汝南唐羌为临武长，县接南海，上书言状。帝下诏太官，勿复受献，由是而止。其为世所贵重久矣。今人亦甚珍之，曝干。寄远，北中以为佳果，亚于荔枝。"}]},{"ID":"20240612103823-bli7jw6","Type":"NodeParagraph","Properties":{"id":"20240612103823-bli7jw6","updated":"20240612103823"},"Children":[{"Type":"NodeText","Data":"衍义曰∶龙眼，《经》曰∶一名益智。今专为果，未见入药，《补注》不言。《神农本草》编入木部中品，果部中复不曾收入。今除为果之外，别无龙眼。若谓为益智子，则专调诸气，今为果者，复不能也。矧自有益智条，远不相当。故知木部龙眼，即便是今为果者。按《今注》云∶甘味归脾，而能益智，此说甚当。"}]},{"ID":"20240612103823-zfwd55z","Type":"NodeThematicBreak","Properties":{"id":"20240612103823-zfwd55z"}},{"ID":"20240612103839-x82ieb6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103839-x82ieb6","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"《中国药典》：龙眼肉"}]},{"ID":"20240612103839-hfdei7f","Type":"NodeParagraph","Properties":{"id":"20240612103839-hfdei7f","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612103839-r1tmwld","Type":"NodeParagraph","Properties":{"id":"20240612103839-r1tmwld","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" Lónɡ Yǎn Ròu"}]},{"ID":"20240612103839-dwnkbpe","Type":"NodeParagraph","Properties":{"id":"20240612103839-dwnkbpe","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612103839-eozg5ky","Type":"NodeParagraph","Properties":{"id":"20240612103839-eozg5ky","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 龙眼、桂圆、圆眼"}]},{"ID":"20240612103839-pzi1plv","Type":"NodeParagraph","Properties":{"id":"20240612103839-pzi1plv","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612103839-1doo579","Type":"NodeParagraph","Properties":{"id":"20240612103839-1doo579","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" ARILLUS LONGAN"}]},{"ID":"20240612103839-lt2lwxr","Type":"NodeParagraph","Properties":{"id":"20240612103839-lt2lwxr","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612103839-s5aatdq","Type":"NodeParagraph","Properties":{"id":"20240612103839-s5aatdq","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 本品为无患子科龙眼属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"龙眼"},{"Type":"NodeText","Data":"Dimocarpus longan Lour.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"假种皮"},{"Type":"NodeText","Data":"。夏、秋二季采收成熟果实，干燥，除去壳、核，晒至干爽不黏。"}]},{"ID":"20240612103839-s3ucell","Type":"NodeParagraph","Properties":{"id":"20240612103839-s3ucell","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612103839-kx9dsk9","Type":"NodeParagraph","Properties":{"id":"20240612103839-kx9dsk9","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 本品为纵向破裂的不规则薄片，常数片粘结。长约1.5cm,宽2～4cm，厚约0.1cm。棕褐色，半透明。一面皱缩不平，一面光亮而有细纵皱纹。质柔润。气微香，味甜。"}]},{"ID":"20240612103839-sb5b6wi","Type":"NodeParagraph","Properties":{"id":"20240612103839-sb5b6wi","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612103839-jnxqius","Type":"NodeParagraph","Properties":{"id":"20240612103839-jnxqius","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮，防蛀。"}]},{"ID":"20240612103839-p10jpx3","Type":"NodeParagraph","Properties":{"id":"20240612103839-p10jpx3","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612103839-u08cy7x","Type":"NodeParagraph","Properties":{"id":"20240612103839-u08cy7x","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 本品横切面：外表皮细胞1 列，呈类方形。内表皮细胞1 列，壁稍厚，外被较厚的角质层。内外表皮间为多列大型条状薄壁细胞，直径约148μm。有的细胞中含淡黄色团块及脂肪油滴。"}]},{"ID":"20240612103839-0bufkcc","Type":"NodeParagraph","Properties":{"id":"20240612103839-0bufkcc","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612103839-sie2810","Type":"NodeParagraph","Properties":{"id":"20240612103839-sie2810","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 归心、脾经。"}]},{"ID":"20240612103839-z4y92w2","Type":"NodeParagraph","Properties":{"id":"20240612103839-z4y92w2","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612103839-1kjz0v3","Type":"NodeParagraph","Properties":{"id":"20240612103839-1kjz0v3","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 甘，温。"}]},{"ID":"20240612103839-f37cvbb","Type":"NodeParagraph","Properties":{"id":"20240612103839-f37cvbb","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612103839-n7vo22s","Type":"NodeParagraph","Properties":{"id":"20240612103839-n7vo22s","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 补益心脾，养血安神。用于气血不足，心悸怔忡，健忘失眠，血虚萎黄。"}]},{"ID":"20240612103839-4w6k76c","Type":"NodeParagraph","Properties":{"id":"20240612103839-4w6k76c","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612103839-6mlgrsf","Type":"NodeParagraph","Properties":{"id":"20240612103839-6mlgrsf","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240612103839-83ffh77","Type":"NodeParagraph","Properties":{"id":"20240612103839-83ffh77","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612103839-gauj7ie","Type":"NodeParagraph","Properties":{"id":"20240612103839-gauj7ie","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612103839-n086835","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103839-n086835","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：龙眼肉"}]},{"ID":"20240612103839-p7l0zg0","Type":"NodeParagraph","Properties":{"id":"20240612103839-p7l0zg0","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612103839-7bt77gd","Type":"NodeParagraph","Properties":{"id":"20240612103839-7bt77gd","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" Lónɡ Yǎn Ròu"}]},{"ID":"20240612103839-bjn697w","Type":"NodeParagraph","Properties":{"id":"20240612103839-bjn697w","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612103839-bhiytsx","Type":"NodeParagraph","Properties":{"id":"20240612103839-bhiytsx","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 益智（《本经》），蜜脾（《纲目》），龙眼干（《泉州本草》）。"}]},{"ID":"20240612103839-5jtajwq","Type":"NodeParagraph","Properties":{"id":"20240612103839-5jtajwq","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612103839-um2avuf","Type":"NodeParagraph","Properties":{"id":"20240612103839-um2avuf","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 《开宝本草》·《本经》原作龙眼"}]},{"ID":"20240612103839-t2wx0h4","Type":"NodeParagraph","Properties":{"id":"20240612103839-t2wx0h4","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612103839-ct14yw0","Type":"NodeParagraph","Properties":{"id":"20240612103839-ct14yw0","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 为无患子科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"龙眼"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"假种皮"},{"Type":"NodeText","Data":"。7～10月果实成熟时采摘，烘干或晒干，剥去果皮，取其假种皮。或将果实入开水中煮10分钟，捞出摊放，使水分散失，再烤一昼夜，然后剥取假种皮，晒干。"}]},{"ID":"20240612103839-s6gti4t","Type":"NodeParagraph","Properties":{"id":"20240612103839-s6gti4t","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612103839-5xrmmqs","Type":"NodeParagraph","Properties":{"id":"20240612103839-5xrmmqs","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 分布福建、台湾、广东、广西、云南、贵州、四川等地。主产广西、福建、广东、四川、台湾等地。"}]},{"ID":"20240612103839-ek08fqd","Type":"NodeParagraph","Properties":{"id":"20240612103839-ek08fqd","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612103839-g3ugnr1","Type":"NodeParagraph","Properties":{"id":"20240612103839-g3ugnr1","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 龙眼，又名：龙目（《蜀都赋》），比目（《吴普本草》），荔枝奴（《南方草木状》），绣木团、川弹子（《清异录》），亚荔枝（《开宝本草》），木弹、骊珠、燕卵、鲛泪、圆眼（《纲目》），海珠丛（《群芳谱》），桂圆（《药品化义》）。"}]},{"ID":"20240612103839-g67w25o","Type":"NodeParagraph","Properties":{"id":"20240612103839-g67w25o","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"常绿乔木，高达10米以上。幼枝被锈色柔毛。双数羽状复叶，互生，长15～20厘米；小叶2～5对，通常互生，革质，椭圆形至卵状披针形，长6～15厘米。先端短尖或钝，基部偏斜，全缘或波浪形，暗绿色，嫩时褐色，下面通常粉绿色。花两性，或单性花与两性花共存；为顶生或腋生的圆锥花序；花小，黄白色，直径4～5毫米，被锈色星状小柔毛；花萼5深裂，裂片卵形；花瓣5，匙形，内面有毛；雄蕊通常8；子房2～3室，柱头2裂。核果球形，直径1.5～2厘米，外皮黄褐色，租糙，假种皮白色肉质，内有黑褐色种子1颗。花期3～4月。果期7～9月。"}]},{"ID":"20240612103839-iteq39o","Type":"NodeParagraph","Properties":{"id":"20240612103839-iteq39o","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612103839-tiblxon","Type":"NodeParagraph","Properties":{"id":"20240612103839-tiblxon","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 生药为由顶端纵向裂开的不规则块片，长约1.5厘米，宽1.5～3.5厘米，厚不及1毫米，表面黄棕色，半透明；靠近果皮的一面皱缩不平，粗糙；靠近种皮的一面光亮而有纵皱纹。质柔韧而微有粘性，常粘结呈块状。气香，味浓甜而特殊。以片大、肉厚、质细软、色棕黄、半透明、味浓甜者为佳。"}]},{"ID":"20240612103839-adfj1al","Type":"NodeParagraph","Properties":{"id":"20240612103839-adfj1al","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612103839-oao3gpk","Type":"NodeParagraph","Properties":{"id":"20240612103839-oao3gpk","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 含葡萄糖、酒石酸、蔗糖、维生素B1、B2、P、C。"}]},{"ID":"20240612103839-batxh9t","Type":"NodeParagraph","Properties":{"id":"20240612103839-batxh9t","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612103839-2uh4yhp","Type":"NodeParagraph","Properties":{"id":"20240612103839-2uh4yhp","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 龙眼水浸剂（1：2）在试管内对奥杜盎氏小芽胞癣菌有抑制作用。"}]},{"ID":"20240612103839-g3e1s42","Type":"NodeParagraph","Properties":{"id":"20240612103839-g3e1s42","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612103839-oded29m","Type":"NodeParagraph","Properties":{"id":"20240612103839-oded29m","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 入心、脾经。"}]},{"ID":"20240612103839-9lx7g12","Type":"NodeParagraph","Properties":{"id":"20240612103839-9lx7g12","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"入足大阴、手少阴经。\""}]},{"ID":"20240612103839-lfsr891","Type":"NodeParagraph","Properties":{"id":"20240612103839-lfsr891","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入肝、心、脾三经。\""}]},{"ID":"20240612103839-2yxfm6h","Type":"NodeParagraph","Properties":{"id":"20240612103839-2yxfm6h","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入心、肾二经。\""}]},{"ID":"20240612103839-fgzn2u1","Type":"NodeParagraph","Properties":{"id":"20240612103839-fgzn2u1","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612103839-hncrpsi","Type":"NodeParagraph","Properties":{"id":"20240612103839-hncrpsi","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 甘，温，"}]},{"ID":"20240612103839-pg3xt2b","Type":"NodeParagraph","Properties":{"id":"20240612103839-pg3xt2b","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240612103839-hu4le8w","Type":"NodeParagraph","Properties":{"id":"20240612103839-hu4le8w","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240612103839-zate0v4","Type":"NodeParagraph","Properties":{"id":"20240612103839-zate0v4","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"味甘酸。\""}]},{"ID":"20240612103839-n6nlp46","Type":"NodeParagraph","Properties":{"id":"20240612103839-n6nlp46","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》：\"味甘，气温。\""}]},{"ID":"20240612103839-20in5t5","Type":"NodeParagraph","Properties":{"id":"20240612103839-20in5t5","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612103839-oszprox","Type":"NodeParagraph","Properties":{"id":"20240612103839-oszprox","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 内有痰火及湿滞停饮者忌服。"}]},{"ID":"20240612103839-16u4ayj","Type":"NodeParagraph","Properties":{"id":"20240612103839-16u4ayj","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"甘温而润，恐有滞气，如胃热有痰有火者；肺受风热，咳嗽有痰有血者，又非所宜。\""}]},{"ID":"20240612103839-q2aocpq","Type":"NodeParagraph","Properties":{"id":"20240612103839-q2aocpq","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"甘甜助火，亦能作痛，若心肺火盛，中满呕吐及气膈郁结者，皆宜忌用。\""}]},{"ID":"20240612103839-ypoosvn","Type":"NodeParagraph","Properties":{"id":"20240612103839-ypoosvn","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612103839-lw2ia6r","Type":"NodeParagraph","Properties":{"id":"20240612103839-lw2ia6r","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 益心脾，补气血，安神。治虚劳羸弱，失眠，健忘，惊悸，怔忡。"}]},{"ID":"20240612103839-21woqd1","Type":"NodeParagraph","Properties":{"id":"20240612103839-21woqd1","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五脏邪气，安志、厌食，久服强魂魄，聪明。\""}]},{"ID":"20240612103839-etkbfn8","Type":"NodeParagraph","Properties":{"id":"20240612103839-etkbfn8","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除虫，去毒。\""}]},{"ID":"20240612103839-z2ztmjm","Type":"NodeParagraph","Properties":{"id":"20240612103839-z2ztmjm","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"③《开宝本草》：\"归脾而能益智。\""}]},{"ID":"20240612103839-ru9m8xi","Type":"NodeParagraph","Properties":{"id":"20240612103839-ru9m8xi","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"④《日用本草》：\"益智宁心。\""}]},{"ID":"20240612103839-ikj7xll","Type":"NodeParagraph","Properties":{"id":"20240612103839-ikj7xll","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"养血安神，长智敛汗，开胃益脾。\""}]},{"ID":"20240612103839-vdniz17","Type":"NodeParagraph","Properties":{"id":"20240612103839-vdniz17","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"⑥《本草通玄》：\"润肺止咳。\""}]},{"ID":"20240612103839-62j9ljv","Type":"NodeParagraph","Properties":{"id":"20240612103839-62j9ljv","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"⑦《得配本草》：\"益脾胃，葆心血，润五脏，治怔忡。\""}]},{"ID":"20240612103839-g3dh3k4","Type":"NodeParagraph","Properties":{"id":"20240612103839-g3dh3k4","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"⑧《泉州本草》：\"壮阳益气，补脾胃。治妇人产后浮肿，气虚水肿，脾虚泄泻。\""}]},{"ID":"20240612103839-nrr3wet","Type":"NodeParagraph","Properties":{"id":"20240612103839-nrr3wet","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612103839-oowg0al","Type":"NodeParagraph","Properties":{"id":"20240612103839-oowg0al","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～5钱；熬膏、浸酒或入丸剂。"}]},{"ID":"20240612103839-7uod4ru","Type":"NodeParagraph","Properties":{"id":"20240612103839-7uod4ru","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612103839-s0zky70","Type":"NodeParagraph","Properties":{"id":"20240612103839-s0zky70","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" ①治思虑过度，劳伤心脾，健忘怔忡：白术、茯苓（去木）、黄芪（去芦）、龙眼肉、酸枣仁（炒，去壳）各一两，人参、木香（不见火）各半两，甘草（炙）二钱半。上细切，每服四钱，水一盏半，生姜五片，枣一枚，煎至七分，去滓温服，不拘时候。（《济生方》归脾汤）"}]},{"ID":"20240612103839-c0b05r2","Type":"NodeParagraph","Properties":{"id":"20240612103839-c0b05r2","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"②大补气血：以剥好龙眼肉，盛竹筒式瓷碗内，每肉一两，入白糖一钱，素体多火者，再加入西洋参片一钱，碗口罩以丝绵一层，日日于饭锅上蒸之，蒸至多次。凡衰羸老弱，别无痰火便滑之病者，每以开水瀹服一匙，大补气血，力胜参芪，产妇临盆，服之尤妙。（《随息居饮食谱》玉灵膏，一名代参膏）"}]},{"ID":"20240612103839-06egqh9","Type":"NodeParagraph","Properties":{"id":"20240612103839-06egqh9","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"③温补脾胃，助精神：龙眼肉不拘多少，上好烧酒内浸百日，常饮数杯。（《万氏家抄方》龙眼酒）"}]},{"ID":"20240612103839-pomsyj9","Type":"NodeParagraph","Properties":{"id":"20240612103839-pomsyj9","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"④治脾虚泄泻：龙眼干十四粒，生姜三片。煎汤服。（《泉州本草》）"}]},{"ID":"20240612103839-8l8w2r4","Type":"NodeParagraph","Properties":{"id":"20240612103839-8l8w2r4","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"⑤治妇人产后浮肿：龙眼干、生姜、大枣。煎汤服。（《泉州本草》）"}]},{"ID":"20240612103839-2873pi2","Type":"NodeParagraph","Properties":{"id":"20240612103839-2873pi2","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612103839-5q0qtgk","Type":"NodeParagraph","Properties":{"id":"20240612103839-5q0qtgk","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612103839-puwyh2p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103839-puwyh2p","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"《中华本草》：龙眼肉"}]},{"ID":"20240612103839-phz17lo","Type":"NodeParagraph","Properties":{"id":"20240612103839-phz17lo","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612103839-ytpb7p9","Type":"NodeParagraph","Properties":{"id":"20240612103839-ytpb7p9","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" Lónɡ Yǎn Ròu"}]},{"ID":"20240612103839-g41snu1","Type":"NodeParagraph","Properties":{"id":"20240612103839-g41snu1","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612103839-p9sn2lh","Type":"NodeParagraph","Properties":{"id":"20240612103839-p9sn2lh","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 龙眼、益智、比目、荔枝奴、亚荔枝、木弹、骊珠、燕卵、鲛泪、圆眼、蜜脾、桂圆、元眼肉、龙眼干。"}]},{"ID":"20240612103839-2ar39k0","Type":"NodeParagraph","Properties":{"id":"20240612103839-2ar39k0","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612103839-i19sz41","Type":"NodeParagraph","Properties":{"id":"20240612103839-i19sz41","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" Dried Longan Prlp"}]},{"ID":"20240612103839-eodtlwn","Type":"NodeParagraph","Properties":{"id":"20240612103839-eodtlwn","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612103839-li5t8op","Type":"NodeParagraph","Properties":{"id":"20240612103839-li5t8op","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 出自1.《开宝本草》：《本经》云一名益智者，盖甘味归脾而能益智，非今益智子尔。"}]},{"ID":"20240612103839-e82y6do","Type":"NodeParagraph","Properties":{"id":"20240612103839-e82y6do","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：龙眼正圆，《别录》、苏恭比之槟榔，殊不类也。其木性畏寒，白露后方可采摘，晒焙令干成朵，干者名龙眼锦。按范成大《桂海志》有山龙眼，出广中，色青，肉如龙眼，夏月实熟可啖，此亦龙眼之野生者欤？"}]},{"ID":"20240612103839-aytm9dw","Type":"NodeParagraph","Properties":{"id":"20240612103839-aytm9dw","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612103839-fne7iy1","Type":"NodeParagraph","Properties":{"id":"20240612103839-fne7iy1","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 药材基源：为无患子科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"龙眼"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"假种皮"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612103839-52jdz0f","Type":"NodeParagraph","Properties":{"id":"20240612103839-52jdz0f","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dimocarpus longan Lour.[Euphoria longan(Lour.)Steud.]"}]},{"ID":"20240612103839-d5pc07o","Type":"NodeParagraph","Properties":{"id":"20240612103839-d5pc07o","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"采收和储藏：果实应在充分成熟后采收。晴天倒于晒席上，晒至半干后再用焙灶焙干，到7-8成干时剥取假种皮，继续晒干或烘干，干燥适度为宜。或将果实放开水中煮10min，捞出摊放，使水分散失，再火烤一昼夜，剥取假种皮，晒干。"}]},{"ID":"20240612103839-vy9pm3i","Type":"NodeParagraph","Properties":{"id":"20240612103839-vy9pm3i","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612103839-jg16mrz","Type":"NodeParagraph","Properties":{"id":"20240612103839-jg16mrz","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 生态环境：喜温暖湿润。"}]},{"ID":"20240612103839-8aj02e0","Type":"NodeParagraph","Properties":{"id":"20240612103839-8aj02e0","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"资源分布：我国西南部至东南部栽培很广，以福建、台湾最盛，广东次之，多栽培于堤岸和园圃，广东、广西南部及云南亦见野生或半野生于疏林中。"}]},{"ID":"20240612103839-hacfaw0","Type":"NodeParagraph","Properties":{"id":"20240612103839-hacfaw0","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612103839-237q1zj","Type":"NodeParagraph","Properties":{"id":"20240612103839-237q1zj","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 龙眼 常绿乔木，高通常10m左右。具板根。小枝粗壮，被微柔毛，散生苍白色皮孔。偶数羽状复叶，互生；叶连柄长15-30cm，或更长；小叶4-5对，很少3或6对，小叶柄长通常不超过5mm；叶片薄革质，长圆状椭圆形至长圆状披针形，两侧常不对称，长6-15cm，宽2.5-5cm，先端渐尖，有时稍钝头，上面深绿色，有光泽，下面粉绿色，两面无毛。花序大型，多分枝，顶生和近枝腋生，密被星状毛；花梗短；萼片近革质，三角状卵形，长约2.5mm，两面均被黄褐色绒毛和成束的星状毛；萼片、花瓣各5，花瓣乳白色，披针形，与萼片近等长，仅外面被微柔毛；雄蕊8，花丝被短硬毛。果近球形，核果状，不开裂，直径1.2-2.5cm，通常黄褐色或有时灰黄色，外面稍粗糙，或少有微凸的小瘤体；种子茶褐色，光亮，全部被肉质的假种皮包裹。花期3-4月，果期7-9月。"}]},{"ID":"20240612103839-1ld9aqf","Type":"NodeParagraph","Properties":{"id":"20240612103839-1ld9aqf","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612103839-b5i647h","Type":"NodeParagraph","Properties":{"id":"20240612103839-b5i647h","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 生物学特性 龙眼是亚热带果树，喜高温多湿，温度是影响其生长、结实的主要因素，一般年平均温度超过20℃的地方，均能使龙眼生长发育良好。耐旱、耐酸、耐瘠、忌浸，在红壤丘陵地、旱平地生长良好，栽培容易，寿命长，产量高，经济收益大，群众喜种植。"}]},{"ID":"20240612103839-0j12d4i","Type":"NodeParagraph","Properties":{"id":"20240612103839-0j12d4i","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"栽培技术 先用实生繁殖培育砧木苗，然后用嫁接繁殖。7-8月龙眼成熟时，选取适应性强，粗生易长，病虫害少的母树采种，种子容易丧失发芽力，采种后，立即播种可提高种子发芽率。用点播或条播，按行距20cm开沟播种，每1hm2播种种量750kg左右。播种后要经常保持土壤湿润，当幼苗高度超过25cm时，进行摘顶，促进主干增粗，随时剪除基部分枝，保持主干离地面10-17cm光滑直立，利用嫁接的操作，经过1-2年培育的砧木苗可进行嫁接。春季嫁接4-6月，秋季嫁接以9-10月份较适宜。接穗应从经过鉴定的优良母树上选取。嫁接方法用芽片贴接法或舌接法。春、秋两季均可定植，多采用长方形或正方形栽植。定植行株距一般4m，每1hm2600株左右为宜。"}]},{"ID":"20240612103839-efudx5g","Type":"NodeParagraph","Properties":{"id":"20240612103839-efudx5g","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"田间管理 幼年树的管理应注重间作与覆盖、扩穴改土、及时施肥、合理整形修剪，形成良好的树形，培养强壮的骨干枝。成年树则着重增施肥料、培土、耕作、排灌和修剪。"}]},{"ID":"20240612103839-4aekdpw","Type":"NodeParagraph","Properties":{"id":"20240612103839-4aekdpw","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612103839-wuioh58","Type":"NodeParagraph","Properties":{"id":"20240612103839-wuioh58","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 假种皮为不规则块片，常粘结成团，长1-1.5cm，宽1-3.85cn，厚约1mm。黄棕色至棕色，半透明。外表面（近果皮的一面）皱缩不平；内表面（粘附种子的一面）光亮，有细纵皱纹。质柔润，有粘性。气微香，味甚甜。以片大而厚、色黄棕、半透明、甜味浓者为佳。"}]},{"ID":"20240612103839-7pa97qu","Type":"NodeParagraph","Properties":{"id":"20240612103839-7pa97qu","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"显微鉴别 假种皮表面观：外表皮细胞形状不一，垂周壁有时可见细小念珠状增厚。内表皮细胞垂周壁念珠状增厚较明显，平周壁有时有大的圆纹孔。内外表皮细胞可见少数杆状，棒状、针状、菱形或不规则形的草酸钙结晶，长5-17μm，直径1-3μm。"}]},{"ID":"20240612103839-8vok0v4","Type":"NodeParagraph","Properties":{"id":"20240612103839-8vok0v4","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612103839-8xc23ty","Type":"NodeParagraph","Properties":{"id":"20240612103839-8xc23ty","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 干果肉含可溶性部分79.77％，不溶性物质19.39％，灰分3.36％。其可溶性部分含葡萄糖（glucose）26.91％，蔗糖（sucrose）0.22％，酸类（以酒石酸计）1.26％，腺嘌吟（adenine）和胆碱（choline）等含氮物质6.309％等。此外，尚含蛋白质5.6%和脂肪杂质及残留的核壳。"}]},{"ID":"20240612103839-ceatlgg","Type":"NodeParagraph","Properties":{"id":"20240612103839-ceatlgg","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612103839-zdp1it3","Type":"NodeParagraph","Properties":{"id":"20240612103839-zdp1it3","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 龙眼水浸剂（1∶2）在试管内对奥杜盎氏小芽胞癣菌有抑制作用。有镇静和健胃作用。煎剂用纸片法对痢疾杆菌有抑制作用。龙眼肉和蛤蚧复合提取物，灌胃20ml／（kg·天）×10对小鼠遭受低温、高温、缺氧刺激有明显的保护作用，并可增加小鼠正常体重；灌胃5ml／（kg·天）×14对利血平化小鼠体重下降具有显着的对抗作用；灌胃15ml／（kg·天）×10可增加小鼠静脉注射碳拉的廓清速率；灌胃20ml／（kg·d）×7能增加小鼠脾重。"}]},{"ID":"20240612103839-tukuywl","Type":"NodeParagraph","Properties":{"id":"20240612103839-tukuywl","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612103839-skllpkl","Type":"NodeParagraph","Properties":{"id":"20240612103839-skllpkl","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 烘干或晒干，剥去果皮，取其假种皮。或将果实入开水中煮10分钟，捞出摊放，使水分散失，再烤一昼夜，然后剥取假种皮：晒干。"}]},{"ID":"20240612103839-qddtu2y","Type":"NodeParagraph","Properties":{"id":"20240612103839-qddtu2y","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612103839-370mwp4","Type":"NodeParagraph","Properties":{"id":"20240612103839-370mwp4","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱取本品0.1g，加70％乙醇1ml振摇，浸泡20min，放置，取上清液作供试液，另取葡萄糖、蔗糖为对照品。分别点样于桂胶G-1％CMC薄层板上，用正丁醇-冰醋酸-水（4：1：5）上层波展开10cm，重复1次。喷以邻苯二甲酸苯胶溶液，加热后葡萄糖显棕色；喷以a-萘酚硫酸液，加热后蔗糖显蓝紫色。"}]},{"ID":"20240612103839-z3r29ji","Type":"NodeParagraph","Properties":{"id":"20240612103839-z3r29ji","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612103839-j02501g","Type":"NodeParagraph","Properties":{"id":"20240612103839-j02501g","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 心；肾；肝；脾经"}]},{"ID":"20240612103839-hq8vq2d","Type":"NodeParagraph","Properties":{"id":"20240612103839-hq8vq2d","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612103839-1oxqm3u","Type":"NodeParagraph","Properties":{"id":"20240612103839-1oxqm3u","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 甘；温"}]},{"ID":"20240612103839-yq1qf0d","Type":"NodeParagraph","Properties":{"id":"20240612103839-yq1qf0d","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612103839-ri25clo","Type":"NodeParagraph","Properties":{"id":"20240612103839-ri25clo","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 内有痰火及湿滞停饮者忌服。"}]},{"ID":"20240612103839-xsn4d41","Type":"NodeParagraph","Properties":{"id":"20240612103839-xsn4d41","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612103839-5sx57kx","Type":"NodeParagraph","Properties":{"id":"20240612103839-5sx57kx","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 补心脾；益气血；安心神。主心脾两虚；气血不足所致的惊悸；怔忡；失眠；健忘；血虚萎黄；有经不调；崩漏"}]},{"ID":"20240612103839-yxtp5yb","Type":"NodeParagraph","Properties":{"id":"20240612103839-yxtp5yb","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612103839-gndk67b","Type":"NodeParagraph","Properties":{"id":"20240612103839-gndk67b","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g，大剂量30-60g；或熬膏；或浸酒；或入丸、散。"}]},{"ID":"20240612103839-3g400qw","Type":"NodeParagraph","Properties":{"id":"20240612103839-3g400qw","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612103839-g41nes0","Type":"NodeParagraph","Properties":{"id":"20240612103839-g41nes0","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" .《纲目》：食品以荔枝为贵，而资益则龙眼为良，盖荔枝性热，而龙眼性和平也。严用和《济生方》治思虑劳伤心脾有归脾汤，取甘味归脾，能益人智之义。"}]},{"ID":"20240612103839-j4ms0vv","Type":"NodeParagraph","Properties":{"id":"20240612103839-j4ms0vv","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"2.《药品化义》：桂圆，大补阴血，凡上部失血之后，入归脾汤同莲肉、芡实以补脾阴，使脾旺统血归经。如神思劳倦，心经血少，以此助生地、麦冬补养心血。又筋骨过劳，肝脏空虚，以此佐熟地、当归，滋补肝血。"}]},{"ID":"20240612103839-nt97m5s","Type":"NodeParagraph","Properties":{"id":"20240612103839-nt97m5s","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"3.《本经》：主五脏邪气，安志、厌食，久服强魂魄，聪明。"}]},{"ID":"20240612103839-khuyy85","Type":"NodeParagraph","Properties":{"id":"20240612103839-khuyy85","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"4.《别录》：除虫，去毒。"}]},{"ID":"20240612103839-p8z20uc","Type":"NodeParagraph","Properties":{"id":"20240612103839-p8z20uc","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"5.《开宝本草》：归脾而能益智。"}]},{"ID":"20240612103839-yqln1ql","Type":"NodeParagraph","Properties":{"id":"20240612103839-yqln1ql","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"6.《日用本草》：益智宁心。"}]},{"ID":"20240612103839-dw8ku69","Type":"NodeParagraph","Properties":{"id":"20240612103839-dw8ku69","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"7.《滇南本草》：养血安神，长智敛汗，开胃益脾。"}]},{"ID":"20240612103839-ycnm917","Type":"NodeParagraph","Properties":{"id":"20240612103839-ycnm917","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"8.《本草通玄》：润肺止咳。"}]},{"ID":"20240612103839-f1i4z29","Type":"NodeParagraph","Properties":{"id":"20240612103839-f1i4z29","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"9.《得配本草》：益脾胃，葆心血，润五脏，治怔忡。"}]},{"ID":"20240612103839-nuoxu3l","Type":"NodeParagraph","Properties":{"id":"20240612103839-nuoxu3l","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"10.《泉州本草》：壮阳益气，补脾胃。治妇人产后浮肿，气虚水肿，脾虚泄泻。"}]},{"ID":"20240612103839-7syf964","Type":"NodeParagraph","Properties":{"id":"20240612103839-7syf964","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612103839-4vpsh2n","Type":"NodeParagraph","Properties":{"id":"20240612103839-4vpsh2n","updated":"20240612103839"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612103840-a5qgemk","Type":"NodeThematicBreak","Properties":{"id":"20240612103840-a5qgemk"}},{"ID":"20240612103841-slanm5g","Type":"NodeParagraph","Properties":{"id":"20240612103841-slanm5g"}}]}