青葙子7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青葙子7-20240629085509-xgmyyh6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240629084847-2rvigkk","Type":"NodeParagraph","Properties":{"id":"20240629084847-2rvigkk","updated":"20240823104525"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 595px;","style":"width: 585px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青葙子9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青葙子9-20240629085742-nvj3ygt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 585px;\" parent-style=\"width: 595px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 668px;","style":"width: 658px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240629084847-92j5o0s.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 658px;\" parent-style=\"width: 668px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823104954-zcbl3bg","Type":"NodeParagraph","Properties":{"id":"20240823104954-zcbl3bg","updated":"20240823104954"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青葙子 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青葙子 5-20240823104954-fsoc8y2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613085804-w7qrywc","Type":"NodeThematicBreak","Properties":{"id":"20240613085804-w7qrywc"}},{"ID":"20240613085805-qcu8uef","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085805-qcu8uef","updated":"20240613085810"},"Children":[{"Type":"NodeText","Data":"青葙子《神农本草经》"}]},{"ID":"20240613085805-523wmvm","Type":"NodeParagraph","Properties":{"id":"20240613085805-523wmvm","updated":"20240613085805"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240613085805-adhkr70","Type":"NodeParagraph","Properties":{"id":"20240613085805-adhkr70","updated":"20240613085805"},"Children":[{"Type":"NodeText","Data":"主邪气，皮肤中热，风搔，身痒，杀三虫，子名草决明，疗唇口青。一名青蒿，一名萋蒿。生平谷。"}]},{"ID":"20240613085805-d9oriu9","Type":"NodeParagraph","Properties":{"id":"20240613085805-d9oriu9","updated":"20240613085805"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生道傍，三月三日采茎叶，阴干，五月六日，采子。"}]},{"ID":"20240613085805-f44mbfl","Type":"NodeParagraph","Properties":{"id":"20240613085805-f44mbfl","updated":"20240613085805"},"Children":[{"Type":"NodeText","Data":"案魏略云：初平中有青牛先生，常服青葙子，葙当作箱字。"}]},{"ID":"20240613085822-0b9b03e","Type":"NodeThematicBreak","Properties":{"id":"20240613085822-0b9b03e"}},{"ID":"20240613085824-63qjtwh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085824-63qjtwh","updated":"20240613085828"},"Children":[{"Type":"NodeText","Data":"青葙子《千金翼方》"}]},{"ID":"20240613085824-fr4aswd","Type":"NodeParagraph","Properties":{"id":"20240613085824-fr4aswd","updated":"20240613085824"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主邪气，皮肤中热，风瘙身痒，杀三虫，恶疮疥虱，痔蚀，下部疮。子∶名草决明，疗唇口青。一名草蒿，一名萎蒿。生平谷道旁，三月采茎叶阴干，五月六月采子。"}]},{"ID":"20240613085911-917k17l","Type":"NodeThematicBreak","Properties":{"id":"20240613085911-917k17l"}},{"ID":"20240613085930-w03lczi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085930-w03lczi","updated":"20240613085935"},"Children":[{"Type":"NodeText","Data":"青葙子《本草撮要》"}]},{"ID":"20240613085930-f3junko","Type":"NodeParagraph","Properties":{"id":"20240613085930-f3junko","updated":"20240613085930"},"Children":[{"Type":"NodeText","Data":"味苦微寒．入厥阴经．功专祛风热．镇肝明目．治青盲障翳虫疥恶疮．瞳子散大者忌服．一名草决明．"}]},{"ID":"20240613085953-4bzzruj","Type":"NodeThematicBreak","Properties":{"id":"20240613085953-4bzzruj"}},{"ID":"20240613085954-ww7w0nt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085954-ww7w0nt","updated":"20240613085959"},"Children":[{"Type":"NodeText","Data":"青葙子《药性切用》"}]},{"ID":"20240613085954-yzlczoe","Type":"NodeParagraph","Properties":{"id":"20240613085954-yzlczoe","updated":"20240613085954"},"Children":[{"Type":"NodeText","Data":"亦名草决明。味苦微寒，入厥阴而除风泄热，专治目疾。瞳子散大者忌。"}]},{"ID":"20240613085940-kb423u8","Type":"NodeThematicBreak","Properties":{"id":"20240613085940-kb423u8"}},{"ID":"20240613085942-cc5pch5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085942-cc5pch5","updated":"20240613085946"},"Children":[{"Type":"NodeText","Data":"青葙子《要药分剂》"}]},{"ID":"20240613085942-krtsp84","Type":"NodeParagraph","Properties":{"id":"20240613085942-krtsp84","updated":"20240613085942"},"Children":[{"Type":"NodeText","Data":"一名草决明。味苦。性微寒。无毒。"}]},{"ID":"20240613085942-rjiv69r","Type":"NodeParagraph","Properties":{"id":"20240613085942-rjiv69r","updated":"20240613085942"},"Children":[{"Type":"NodeText","Data":"【主治】主唇口青。（本经）治五脏邪气。益脑髓。镇肝。明耳目。坚筋骨。去风寒湿痹。"}]},{"ID":"20240613085942-jbx8ojx","Type":"NodeParagraph","Properties":{"id":"20240613085942-jbx8ojx","updated":"20240613085942"},"Children":[{"Type":"NodeText","Data":"（【归经】入肝经。为泻肝明目之品。（善祛风热）【前论】时珍曰。青葙子治眼。与决明子苋实同功。本经虽不言治眼而主唇口青。又云。"}]},{"ID":"20240613085930-0ckkp7p","Type":"NodeThematicBreak","Properties":{"id":"20240613085930-0ckkp7p"}},{"ID":"20240613085912-uofqv6d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085912-uofqv6d","updated":"20240613085917"},"Children":[{"Type":"NodeText","Data":"青葙子《本草衍义》"}]},{"ID":"20240613085912-dkspkx0","Type":"NodeParagraph","Properties":{"id":"20240613085912-dkspkx0","updated":"20240613085912"},"Children":[{"Type":"NodeText","Data":"经中并不言治眼，《药性论》始言之。能治肝藏热毒冲眼、赤障、青盲。萧炳可云∶“理眼。”日华子云∶“益脑髓，明耳目，镇肝。”今人多用之治眼，殊不与经意相当。"}]},{"ID":"20240613085856-f6icag1","Type":"NodeThematicBreak","Properties":{"id":"20240613085856-f6icag1"}},{"ID":"20240613085857-iyo85rs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085857-iyo85rs","updated":"20240613085904"},"Children":[{"Type":"NodeText","Data":"青葙子《本草图经》"}]},{"ID":"20240613085857-3qawxdv","Type":"NodeParagraph","Properties":{"id":"20240613085857-3qawxdv","updated":"20240613085900"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"青葙子"},{"Type":"NodeText","Data":"，生平谷道旁，今江淮州郡近道亦有之。二月内生青苗，长三、四尺；叶阔似柳，细软；茎似蒿，青红色；六月、七月内生花，上红下白；子黑光而扁，有似莨菪；根似蒿根而白，直下独茎生根。六月、八月采子。又有一种花黄，名陶珠术；苗亦相似，恐不堪用之。"}]},{"ID":"20240613085845-i7tehwp","Type":"NodeThematicBreak","Properties":{"id":"20240613085845-i7tehwp"}},{"ID":"20240613085846-daxv500","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085846-daxv500","updated":"20240613085850"},"Children":[{"Type":"NodeText","Data":"青葙子《神农本草经赞》"}]},{"ID":"20240613085846-w2bwack","Type":"NodeParagraph","Properties":{"id":"20240613085846-w2bwack","updated":"20240613085846"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主邪气。皮肤中热。风搔身痒。杀三虫。子名草决明。疗唇口青。一名草蒿。一名萋蒿。生平谷。"}]},{"ID":"20240613085846-lm16jrr","Type":"NodeParagraph","Properties":{"id":"20240613085846-lm16jrr","updated":"20240613085846"},"Children":[{"Type":"NodeText","Data":"邻接胡麻。葙音诡。高耸鸡冠。尖垂兔尾。雁过秋红。桃霏夏紫。披决光明。昭昭觉视。"}]},{"ID":"20240613085846-m2y3uo6","Type":"NodeParagraph","Properties":{"id":"20240613085846-m2y3uo6","updated":"20240613085846"},"Children":[{"Type":"NodeText","Data":"李时珍曰。此草多生于胡麻地中。胡麻叶亦名青。音相近。岂以其相似而然耶。花叶似鸡冠。苗似苋。故谓之鸡冠苋。梢间出花。穗尖长。如鼠尾。又一种名雁来红。其叶九月鲜红。望之如花。故名。陈藏器曰。又一种名桃朱术。花紫。五月五日。妇人收子带之。为夫所爱。急就篇。刃端可以披决。淮南子。觉视于昭昭之宇。"}]},{"ID":"20240613085833-ngpas92","Type":"NodeThematicBreak","Properties":{"id":"20240613085833-ngpas92"}},{"ID":"20240613085835-554o1aw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085835-554o1aw","updated":"20240613085839"},"Children":[{"Type":"NodeText","Data":"青葙子《冯氏锦囊秘录》"}]},{"ID":"20240613085835-z07c486","Type":"NodeParagraph","Properties":{"id":"20240613085835-z07c486","updated":"20240613085835"},"Children":[{"Type":"NodeText","Data":"味苦寒，入肝经。"}]},{"ID":"20240613085835-j2xgof2","Type":"NodeParagraph","Properties":{"id":"20240613085835-j2xgof2","updated":"20240613085835"},"Children":[{"Type":"NodeText","Data":"青葙子，多治眼科，去肝脏热毒上冲，青盲翳肿，除心经火邪暴发，赤障昏花。"}]},{"ID":"20240613085041-pkr5k3o","Type":"NodeThematicBreak","Properties":{"id":"20240613085041-pkr5k3o"}},{"ID":"20240613085428-v91x2f4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085428-v91x2f4","updated":"20240613085433"},"Children":[{"Type":"NodeText","Data":"青葙子《医学入门》"}]},{"ID":"20240613085428-muffn6t","Type":"NodeParagraph","Properties":{"id":"20240613085428-muffn6t","updated":"20240613085428"},"Children":[{"Type":"NodeText","Data":"青葙子苦治皮风，恶疮疥痔杀三虫，益脑髓能去目翳，风寒湿痹亦堪攻。"}]},{"ID":"20240613085428-ng9jk8d","Type":"NodeParagraph","Properties":{"id":"20240613085428-ng9jk8d","updated":"20240613085428"},"Children":[{"Type":"NodeText","Data":"葙，囊箧也。药虽贱而治眼功大，青囊箱中不可缺也。黑色似苋实而扁，即野鸡冠花子，旧以子名草决明者，误也。无毒。主皮肤中风热瘙痒，杀二虫诸疮虱，痔蚀下部 疮。益脑髓，去目翳。盖翳膜皆脑脂下流而成故也。一切肝风热毒冲眼，青盲赤障皆验。又坚筋骨，去风寒湿痹。微炒捣碎。"}]},{"ID":"20240613085439-vihhs8e","Type":"NodeThematicBreak","Properties":{"id":"20240613085439-vihhs8e"}},{"ID":"20240613085441-cc5thz2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085441-cc5thz2","updated":"20240613085447"},"Children":[{"Type":"NodeText","Data":"青葙子《证类本草》"}]},{"ID":"20240613085441-klcxfoe","Type":"NodeParagraph","Properties":{"id":"20240613085441-klcxfoe","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主邪气，皮肤中热，风瘙身痒，杀三虫，恶疮疥虱，痔蚀，下部疮。子名草决明，疗唇口青。一名草蒿，一名萋蒿。生平谷道旁。三月采茎叶，阴干。"}]},{"ID":"20240613085441-erliw4a","Type":"NodeParagraph","Properties":{"id":"20240613085441-erliw4a","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"五月、六月采子。"}]},{"ID":"20240613085441-qufkqj4","Type":"NodeParagraph","Properties":{"id":"20240613085441-qufkqj4","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶处处有。似麦闸极花，其子甚细。后又有草蒿，别本亦作草 。今即主疗殊相类，形名又相似极多，足为疑，而实两种也。唐本注云∶此草，苗高尺许，叶细软，花紫白色，实作角，子黑而扁光，似苋实而大，生下湿地，四月、五月采。荆、襄人名为昆仑草。捣汁单服，大疗温疠甘 。臣禹锡等谨按蜀本图经云∶叶细软长，亦为蔓。今所在下湿地有。"}]},{"ID":"20240613085441-y7zsxhr","Type":"NodeParagraph","Properties":{"id":"20240613085441-y7zsxhr","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"药性论云∶青葙子，一名草 ，味苦，平，无毒。能治肝脏热毒冲眼，赤障青盲翳肿，主恶疮疥瘙，治下部虫 疮。萧炳云∶今主理眼，有青葙子丸。又有一种花黄，名陶珠术，苗相似。日华子云∶治五脏邪气，益脑髓，明耳目，镇肝，坚筋骨，去风寒湿痹，苗止金疮血。"}]},{"ID":"20240613085441-nfv05xg","Type":"NodeParagraph","Properties":{"id":"20240613085441-nfv05xg","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"图经曰∶青葙子，生平谷道旁，今江淮州郡近道亦有之。二月内生青苗，长三、四尺。"}]},{"ID":"20240613085441-60fspam","Type":"NodeParagraph","Properties":{"id":"20240613085441-60fspam","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"叶阔似柳细软，茎似蒿，青红色。六月、七月内生花，上红下白。子黑光而扁，有似莨菪。根似蒿根而白，直下独茎生根。六月、八月采子。又有一种花黄，名陶珠术，苗亦相似，恐不堪用之。"}]},{"ID":"20240613085441-si8c552","Type":"NodeParagraph","Properties":{"id":"20240613085441-si8c552","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡用，勿使思 子并鼠 子。其二件真似青葙子，只是味不同。其思 子味粗，煎之有涎。凡用先烧铁臼杵，单捣用之。广利方治鼻衄出血不止。以青葙子汁三合，灌鼻中。三国志云∶《魏略》∶初平中有青牛先生，常服青葙子，年如五、六十者，人或识之，谓其已百岁有余尔。"}]},{"ID":"20240613085441-r6gzp2l","Type":"NodeParagraph","Properties":{"id":"20240613085441-r6gzp2l","updated":"20240613085441"},"Children":[{"Type":"NodeText","Data":"衍义曰∶青葙子，《经》中并不言治眼，《药性论》始言之。能治肝脏热毒冲眼、赤障、青盲。萧炳亦云∶理眼。日华子云∶益脑髓、明耳目，镇肝。今人多用治眼，殊不与《经》意相当。"}]},{"ID":"20240613085041-lqc78kw","Type":"NodeThematicBreak","Properties":{"id":"20240613085041-lqc78kw"}},{"ID":"20240613085417-pkhgfgy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085417-pkhgfgy","updated":"20240613085423"},"Children":[{"Type":"NodeText","Data":"青葙子《本草蒙筌》"}]},{"ID":"20240613085417-ax785y3","Type":"NodeParagraph","Properties":{"id":"20240613085417-ax785y3","updated":"20240613085417"},"Children":[{"Type":"NodeText","Data":"味苦，气平，微寒。无毒。园圃俱有，江淮独多。茎直似蒿青红，叶大如柳柔软。花上红下白，形类鸡冠；（即野鸡冠花纯白者胜。）子黑扁而光，粒同苋实。六月收取，多治眼科。去肝脏热毒上冲，青盲翳肿；除心经火邪暴发，赤障昏花。坚筋骨镇肝，益脑髓聪耳于下部。止金疮去血，塞鼻衄来红。"}]},{"ID":"20240613085417-gayearq","Type":"NodeParagraph","Properties":{"id":"20240613085417-gayearq","updated":"20240613085417"},"Children":[{"Type":"NodeText","Data":"（谟）按∶《本经》款内载曰∶子名草决明，意谓功专治眼，特假别名以美之，非真为决明子也。若以为然，则原揭诸简端，何不直书而但曰青葙子乎？正犹沙参一名知母，龙眼一名益智，名同而实异也。且别条所载决明子药，粒状稍大，主治尤优。世医弗明，或偏执一，不免得此失彼，大辜药味之能矣。幸而此曰草决明，彼曰决明子。两名虽一，上下字差略，此分别不同，读者不可不识也。"}]},{"ID":"20240613085041-9jnajzn","Type":"NodeThematicBreak","Properties":{"id":"20240613085041-9jnajzn"}},{"ID":"20240613085235-xc8w1t6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085235-xc8w1t6","updated":"20240613085243"},"Children":[{"Type":"NodeText","Data":"青葙子《新修本草》"}]},{"ID":"20240613085235-05g4ilw","Type":"NodeParagraph","Properties":{"id":"20240613085235-05g4ilw","updated":"20240613085235"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主邪气，皮肤中热，风瘙身痒，杀三虫。恶疮、疥虱、痔蚀，下部KT唇口青。一名草蒿，一名萋蒿。生平谷道旁。三月采茎叶，阴干。五月、六月采子。"}]},{"ID":"20240613085235-hs78tqh","Type":"NodeParagraph","Properties":{"id":"20240613085235-hs78tqh","updated":"20240613085235"},"Children":[{"Type":"NodeText","Data":"处处有。似麦闸极花，其子甚细。后又有草蒿，别本亦作草 。今主疗殊相类，形名又相似，极多足为疑，而实两种也。"}]},{"ID":"20240613085235-gh4wegi","Type":"NodeParagraph","Properties":{"id":"20240613085235-gh4wegi","updated":"20240613085715"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草，苗高尺许，叶细软，花紫白色，实作角，子黑而扁光，似苋实而大，生下湿地，四月、五月采。荆襄人名为昆仑草，捣汁单服，大疗温疠、kt也。"}]},{"ID":"20240613085747-4l79jp1","Type":"NodeThematicBreak","Properties":{"id":"20240613085747-4l79jp1"}},{"ID":"20240613085748-3iclerg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085748-3iclerg","updated":"20240613085753"},"Children":[{"Type":"NodeText","Data":"青葙子《本草求真》"}]},{"ID":"20240613085748-u6po3s4","Type":"NodeParagraph","Properties":{"id":"20240613085748-u6po3s4","updated":"20240613085748"},"Children":[{"Type":"NodeText","Data":"（隰草）泻肝经风热"}]},{"ID":"20240613085748-h77aaam","Type":"NodeParagraph","Properties":{"id":"20240613085748-h77aaam","updated":"20240613085748"},"Children":[{"Type":"NodeText","Data":"青葙子（专入肝）。即鸡冠花子者是也。备要又言即草决明。味苦微寒无毒。入足厥阴肝。凡人一身风痒。虫疥得蚀。口唇色青。青盲翳肿。多缘热盛风炽所致。（亦有不尽风热者。此则专就风热言。）书言服此目疾皆愈。唇青即散。三虫皆杀。风痒即绝。无非因其血热除。（寒能胜热。）血脉和。而病自可愈耳。无他义也。但瞳子散大者切忌。（以能助火。）类鸡冠而穗尖长。捣用。"}]},{"ID":"20240613085736-en77rgn","Type":"NodeThematicBreak","Properties":{"id":"20240613085736-en77rgn"}},{"ID":"20240613085737-eiik8wx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085737-eiik8wx","updated":"20240613085741"},"Children":[{"Type":"NodeText","Data":"青葙子《得配本草》"}]},{"ID":"20240613085737-zgl3ou0","Type":"NodeParagraph","Properties":{"id":"20240613085737-zgl3ou0","updated":"20240613085737"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名草决明"}]},{"ID":"20240613085737-nkhlo52","Type":"NodeParagraph","Properties":{"id":"20240613085737-nkhlo52","updated":"20240613085737"},"Children":[{"Type":"NodeText","Data":"味苦，微寒。入手少阴、足厥阴经。清肝火之上冲，祛心经之邪热。皮肤风湿，目中翳障，皆可施治。瞳子散大者禁用。（恐散阴气。）怪症∶眼见似有虫飞，以手捉之则无，此肝经病也。用青葙子合元明粉、羌活、枣仁为末，水送下。"}]},{"ID":"20240613085041-0ae6f8x","Type":"NodeThematicBreak","Properties":{"id":"20240613085041-0ae6f8x"}},{"ID":"20240613085112-u8lwk3j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085112-u8lwk3j","updated":"20240613085131"},"Children":[{"Type":"NodeText","Data":"青葙子《中药学》"}]},{"ID":"20240613085112-8ilx0ud","Type":"NodeParagraph","Properties":{"id":"20240613085112-8ilx0ud","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【药用】本品为苋科植物青葙的成熟种子。"}]},{"ID":"20240613085112-pbh62po","Type":"NodeParagraph","Properties":{"id":"20240613085112-pbh62po","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，微寒。入肝经。"}]},{"ID":"20240613085112-twz2kzw","Type":"NodeParagraph","Properties":{"id":"20240613085112-twz2kzw","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【功效】清肝火，退目翳。"}]},{"ID":"20240613085112-p6u0dxv","Type":"NodeParagraph","Properties":{"id":"20240613085112-p6u0dxv","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于肝热所引起的目赤肿痛、目生翳膜、视物昏暗等症。"}]},{"ID":"20240613085112-m9ggwfy","Type":"NodeParagraph","Properties":{"id":"20240613085112-m9ggwfy","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"本品为厥阴肝经之药，多用于目疾，对肝热所致的目赤肿痛等症，常与决明子、密蒙花、菊花等配合应用。"}]},{"ID":"20240613085112-f3pvolh","Type":"NodeParagraph","Properties":{"id":"20240613085112-f3pvolh","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"此外，本品近年来在临床上又用于高血压病而见肝火亢盛、头胀头晕等症，常与夏枯草、菊花等同用。"}]},{"ID":"20240613085112-rnryudz","Type":"NodeParagraph","Properties":{"id":"20240613085112-rnryudz","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【处方用名】青葙子（晒干用）"}]},{"ID":"20240613085112-1sc0s76","Type":"NodeParagraph","Properties":{"id":"20240613085112-1sc0s76","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】二钱至五钱，煎服。"}]},{"ID":"20240613085112-g4kwz9c","Type":"NodeParagraph","Properties":{"id":"20240613085112-g4kwz9c","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【按语】1.青葙子一药，在上海地区别名“草决明”。在广东等地区将决明子称为“草决明”。为了避免混淆，建议处方使用原植物名称，勿用“草决明”别名。"}]},{"ID":"20240613085112-8u78vnb","Type":"NodeParagraph","Properties":{"id":"20240613085112-8u78vnb","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"2.青葙子常于清肝降火，又有扩散瞳孔的作用，故对肝肾不足所致的目疾及瞳孔散大者，不宜应用。"}]},{"ID":"20240613085112-d8icsr6","Type":"NodeParagraph","Properties":{"id":"20240613085112-d8icsr6","updated":"20240613085112"},"Children":[{"Type":"NodeText","Data":"【方剂举例】青葙子散《证治准绳》：青箱子、红蓝实、枳壳、大黄、菊花、甘草、决明子、甘草、细辛、茺蔚子、麻黄、车前子、鲤鱼胆、鸭胆、羚羊角。治热毒翳障。"}]},{"ID":"20240613085041-j170dan","Type":"NodeThematicBreak","Properties":{"id":"20240613085041-j170dan"}},{"ID":"20240613085055-14z8j79","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085055-14z8j79","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"《中国药典》：青葙子"}]},{"ID":"20240613085055-qg4fqql","Type":"NodeParagraph","Properties":{"id":"20240613085055-qg4fqql","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613085055-ufym8wi","Type":"NodeParagraph","Properties":{"id":"20240613085055-ufym8wi","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Xiānɡ Zǐ"}]},{"ID":"20240613085055-z3zddw0","Type":"NodeParagraph","Properties":{"id":"20240613085055-z3zddw0","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613085055-vbzl7h5","Type":"NodeParagraph","Properties":{"id":"20240613085055-vbzl7h5","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 野鸡冠花、狗尾花、狗尾苋"}]},{"ID":"20240613085055-sa24zov","Type":"NodeParagraph","Properties":{"id":"20240613085055-sa24zov","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613085055-hzk8ybc","Type":"NodeParagraph","Properties":{"id":"20240613085055-hzk8ybc","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" SEMEN CELOSIAE"}]},{"ID":"20240613085055-ztkpxj8","Type":"NodeParagraph","Properties":{"id":"20240613085055-ztkpxj8","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613085055-ltbxrc4","Type":"NodeParagraph","Properties":{"id":"20240613085055-ltbxrc4","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 本品为苋科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"青葙"},{"Type":"NodeText","Data":"Celosia argentea L. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种子"},{"Type":"NodeText","Data":"。秋季果实成熟时采割植株或摘取果穗，晒干，收集种子，除去杂质。"}]},{"ID":"20240613085055-mv5skb4","Type":"NodeParagraph","Properties":{"id":"20240613085055-mv5skb4","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613085055-iqj5kr9","Type":"NodeParagraph","Properties":{"id":"20240613085055-iqj5kr9","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 本品呈扁圆形，少数呈圆肾形，直径1～1.5mm。表面黑色或红黑色，光亮，中间微隆起，侧边微凹处有种脐。种皮薄而脆。无臭，无味。"}]},{"ID":"20240613085055-01kyg7l","Type":"NodeParagraph","Properties":{"id":"20240613085055-01kyg7l","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613085055-mso9b8o","Type":"NodeParagraph","Properties":{"id":"20240613085055-mso9b8o","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240613085055-1vjg1f7","Type":"NodeParagraph","Properties":{"id":"20240613085055-1vjg1f7","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613085055-lyg0jgc","Type":"NodeParagraph","Properties":{"id":"20240613085055-lyg0jgc","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 归肝经。"}]},{"ID":"20240613085055-7w9o4lv","Type":"NodeParagraph","Properties":{"id":"20240613085055-7w9o4lv","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613085055-aa2tcjt","Type":"NodeParagraph","Properties":{"id":"20240613085055-aa2tcjt","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 苦，微寒。"}]},{"ID":"20240613085055-oyf9ojx","Type":"NodeParagraph","Properties":{"id":"20240613085055-oyf9ojx","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613085055-7vqhq1p","Type":"NodeParagraph","Properties":{"id":"20240613085055-7vqhq1p","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 清肝，明目，退翳。用于肝热目赤，眼生翳膜，视物昏花，肝火眩晕。"}]},{"ID":"20240613085055-tnhp8vt","Type":"NodeParagraph","Properties":{"id":"20240613085055-tnhp8vt","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613085055-7csv06o","Type":"NodeParagraph","Properties":{"id":"20240613085055-7csv06o","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240613085055-8eocmlh","Type":"NodeParagraph","Properties":{"id":"20240613085055-8eocmlh","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613085055-hiiqz2b","Type":"NodeParagraph","Properties":{"id":"20240613085055-hiiqz2b","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" （1）青葙子一药，在上海地区别名“草决明”。在广东等地区将决明子称为“草决明”。为了避免混淆，建议处方使用原植物名称，勿用“草决明”别名。"}]},{"ID":"20240613085055-wvoj3rg","Type":"NodeParagraph","Properties":{"id":"20240613085055-wvoj3rg","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"（2）青葙子常于清肝降火，又有扩散瞳孔的作用，故对肝肾不足所致的目疾及瞳孔散大者，不宜应用。"}]},{"ID":"20240613085055-1n8rpp9","Type":"NodeParagraph","Properties":{"id":"20240613085055-1n8rpp9","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613085055-2134rnl","Type":"NodeParagraph","Properties":{"id":"20240613085055-2134rnl","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613085055-7svz4ds","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085055-7svz4ds","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：青葙子"}]},{"ID":"20240613085055-doo6i8b","Type":"NodeParagraph","Properties":{"id":"20240613085055-doo6i8b","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613085055-3azebw1","Type":"NodeParagraph","Properties":{"id":"20240613085055-3azebw1","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Xiānɡ Zǐ"}]},{"ID":"20240613085055-blmm83k","Type":"NodeParagraph","Properties":{"id":"20240613085055-blmm83k","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613085055-it6tw87","Type":"NodeParagraph","Properties":{"id":"20240613085055-it6tw87","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 草决明（《本经》），牛尾花子（《中药材手册》），狗尾巴子（《四川中药志》）。"}]},{"ID":"20240613085055-hqv6kxn","Type":"NodeParagraph","Properties":{"id":"20240613085055-hqv6kxn","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613085055-nc5awhr","Type":"NodeParagraph","Properties":{"id":"20240613085055-nc5awhr","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613085055-kq3ajlf","Type":"NodeParagraph","Properties":{"id":"20240613085055-kq3ajlf","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613085055-br9grqe","Type":"NodeParagraph","Properties":{"id":"20240613085055-br9grqe","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 为苋科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"青葙"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。8～10月间采收，割取地上部分或花穗，晒干；搓出种子，除去杂质，晒干。"}]},{"ID":"20240613085055-x0sktst","Type":"NodeParagraph","Properties":{"id":"20240613085055-x0sktst","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613085055-sd9abbl","Type":"NodeParagraph","Properties":{"id":"20240613085055-sd9abbl","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 干燥种子扁圆形，中心较边缘稍厚，直径1～1.5毫米，厚约0.5毫米。表面平滑，黑色，有光泽，侧面有一微凹的脐点。种皮薄而脆，易破碎，内面白色，微臭。商品中常有残留的黄白色果壳包被于种子上端，果壳如帽状，顶端有一细丝状的花柱，长约4～5毫米。以色黑光亮、饱满者佳。全国各地均有生产。苋科植物鸡冠花的种子（鸡冠子）不少地区习惯作青葙子使用，并已有较长的历史。二者外形相似，区别点在于：鸡冠果壳上残留的花柱，长约0.2～0.3厘米，约比青葙短1／3左右；如以扩大镜观察，鸡冠子表面有细小的凹点，而青葙子则不甚显着。参见\"鸡冠子\"条。"}]},{"ID":"20240613085055-ar3tzm2","Type":"NodeParagraph","Properties":{"id":"20240613085055-ar3tzm2","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613085055-mdjdqtf","Type":"NodeParagraph","Properties":{"id":"20240613085055-mdjdqtf","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 含脂肪油和丰富的硝酸钾，尚含烟酸。"}]},{"ID":"20240613085055-uhz4dma","Type":"NodeParagraph","Properties":{"id":"20240613085055-uhz4dma","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613085055-x1vcj5p","Type":"NodeParagraph","Properties":{"id":"20240613085055-x1vcj5p","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" ①《滇南本草》：\"入肝经。\""}]},{"ID":"20240613085055-bfgga8a","Type":"NodeParagraph","Properties":{"id":"20240613085055-bfgga8a","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心、肝二经。\""}]},{"ID":"20240613085055-gyekydn","Type":"NodeParagraph","Properties":{"id":"20240613085055-gyekydn","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613085055-bp7entn","Type":"NodeParagraph","Properties":{"id":"20240613085055-bp7entn","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 苦，凉。"}]},{"ID":"20240613085055-8k5quj2","Type":"NodeParagraph","Properties":{"id":"20240613085055-8k5quj2","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"味苦，平，无毒。\""}]},{"ID":"20240613085055-it170dt","Type":"NodeParagraph","Properties":{"id":"20240613085055-it170dt","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"②《滇南本草》：\"性寒，味甘微苦。\""}]},{"ID":"20240613085055-yf94kmv","Type":"NodeParagraph","Properties":{"id":"20240613085055-yf94kmv","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"味苦，性微寒，无毒。\""}]},{"ID":"20240613085055-622i974","Type":"NodeParagraph","Properties":{"id":"20240613085055-622i974","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613085055-zw3qujy","Type":"NodeParagraph","Properties":{"id":"20240613085055-zw3qujy","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《本草备要》：\"瞳子散大者忌服。\""}]},{"ID":"20240613085055-94pnnsd","Type":"NodeParagraph","Properties":{"id":"20240613085055-94pnnsd","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613085055-lf9tti2","Type":"NodeParagraph","Properties":{"id":"20240613085055-lf9tti2","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 祛风热，清肝火。治目赤肿痛，障翳，高血压，鼻衄，皮肤风热瘙痒，疥癞。"}]},{"ID":"20240613085055-r386uo7","Type":"NodeParagraph","Properties":{"id":"20240613085055-r386uo7","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"疗唇口青。\""}]},{"ID":"20240613085055-gmstrpi","Type":"NodeParagraph","Properties":{"id":"20240613085055-gmstrpi","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"治肝脏热毒冲眼，赤障、青盲、翳肿。主恶疮疥瘙，治下部虫露疮。\""}]},{"ID":"20240613085055-2vxfo74","Type":"NodeParagraph","Properties":{"id":"20240613085055-2vxfo74","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治五脏邪气，益脑髓，明耳目，镇肝，坚筋骨，去风寒湿痹。\""}]},{"ID":"20240613085055-wri83se","Type":"NodeParagraph","Properties":{"id":"20240613085055-wri83se","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"④《滇南本草》：\"明目。治泪涩难开，白翳遮睛。\""}]},{"ID":"20240613085055-l96vjip","Type":"NodeParagraph","Properties":{"id":"20240613085055-l96vjip","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"⑤《本草原始》：\"除心经火邪。\""}]},{"ID":"20240613085055-fdo086z","Type":"NodeParagraph","Properties":{"id":"20240613085055-fdo086z","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"⑥《会约医镜》：\"去风热。\""}]},{"ID":"20240613085055-is9jspx","Type":"NodeParagraph","Properties":{"id":"20240613085055-is9jspx","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613085055-bjityfy","Type":"NodeParagraph","Properties":{"id":"20240613085055-bjityfy","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱。"}]},{"ID":"20240613085055-8qzwequ","Type":"NodeParagraph","Properties":{"id":"20240613085055-8qzwequ","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613085055-4lqxz25","Type":"NodeParagraph","Properties":{"id":"20240613085055-4lqxz25","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" ①治风热泪眼：青葙子五钱，鸡肝炖服。（《泉州本草》）"}]},{"ID":"20240613085055-rz078fd","Type":"NodeParagraph","Properties":{"id":"20240613085055-rz078fd","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"②治夜盲，目翳：青葙子五钱，乌枣一两。开水冲炖，饭前服。（《闽东本草》）"}]},{"ID":"20240613085055-nnvh5bd","Type":"NodeParagraph","Properties":{"id":"20240613085055-nnvh5bd","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"③治鼻衄出血不止：青葙子汁灌鼻中。（《广利方》）"}]},{"ID":"20240613085055-w89n1wb","Type":"NodeParagraph","Properties":{"id":"20240613085055-w89n1wb","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"④治头风痛：青葙子五钱至一两。煎水服。（《福建中草药》）"}]},{"ID":"20240613085055-1u65w89","Type":"NodeParagraph","Properties":{"id":"20240613085055-1u65w89","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613085055-texicb3","Type":"NodeParagraph","Properties":{"id":"20240613085055-texicb3","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 治疗高血压病：取青葙子1两，水煎2次，滤液混合，每日3次分服，临床试治5例，血压均在160～230／100～135毫米汞柱之间，经用药1周后，血压降至125～145／78～90毫米汞柱。"}]},{"ID":"20240613085055-p7ebr6u","Type":"NodeParagraph","Properties":{"id":"20240613085055-p7ebr6u","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613085055-cbn9jsj","Type":"NodeParagraph","Properties":{"id":"20240613085055-cbn9jsj","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"青葙子治眼，与决明子、苋实同功，《本经》虽不言治眼，而云一名草决明，主唇口青，则其明目之功可知矣。目者肝之窍，唇口青者，足厥阴经之证；古方除热亦多用之，青葙子之为厥阴药，又可知矣，况用之治目，往往有验，尤可征。\""}]},{"ID":"20240613085055-aiic2ee","Type":"NodeParagraph","Properties":{"id":"20240613085055-aiic2ee","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613085055-vxjmw9q","Type":"NodeParagraph","Properties":{"id":"20240613085055-vxjmw9q","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613085055-sl4eebv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613085055-sl4eebv","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"《中华本草》：青葙子"}]},{"ID":"20240613085055-rymjnx9","Type":"NodeParagraph","Properties":{"id":"20240613085055-rymjnx9","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613085055-ivhbkhs","Type":"NodeParagraph","Properties":{"id":"20240613085055-ivhbkhs","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Xiānɡ Zǐ"}]},{"ID":"20240613085055-ndzg41y","Type":"NodeParagraph","Properties":{"id":"20240613085055-ndzg41y","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613085055-4zpvrth","Type":"NodeParagraph","Properties":{"id":"20240613085055-4zpvrth","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 草决明、野鸡冠花子、狗尾巴子、牛尾巴花子"}]},{"ID":"20240613085055-oy5434x","Type":"NodeParagraph","Properties":{"id":"20240613085055-oy5434x","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613085055-e3u7n79","Type":"NodeParagraph","Properties":{"id":"20240613085055-e3u7n79","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613085055-v4ygh34","Type":"NodeParagraph","Properties":{"id":"20240613085055-v4ygh34","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613085055-5envzez","Type":"NodeParagraph","Properties":{"id":"20240613085055-5envzez","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 药材基源：为苋科植物青葙的种子。"}]},{"ID":"20240613085055-dawe0vs","Type":"NodeParagraph","Properties":{"id":"20240613085055-dawe0vs","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Celosia argentea L."}]},{"ID":"20240613085055-jkxj9xv","Type":"NodeParagraph","Properties":{"id":"20240613085055-jkxj9xv","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7～9月种子成熟，割取地上部分或摘取果穗晒干，搓出种子，过筛或簸净果壳等杂质即可。"}]},{"ID":"20240613085055-m5k23ah","Type":"NodeParagraph","Properties":{"id":"20240613085055-m5k23ah","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613085055-50sumol","Type":"NodeParagraph","Properties":{"id":"20240613085055-50sumol","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于坡地、路边、平原较干燥的向阳处。"}]},{"ID":"20240613085055-s9sc78q","Type":"NodeParagraph","Properties":{"id":"20240613085055-s9sc78q","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"资源分布：全国大部分地区均有野生或栽培。"}]},{"ID":"20240613085055-t01vpem","Type":"NodeParagraph","Properties":{"id":"20240613085055-t01vpem","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613085055-xgqqwm5","Type":"NodeParagraph","Properties":{"id":"20240613085055-xgqqwm5","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高30-90cm。全株无毛。茎直立，通常上部分枝，绿色或红紫色，具条纹。单叶互生；叶柄长2-15mm，或无柄；叶片纸质，披针形或长圆状披外形，长5-9cm，宽1-3cm，先端尖或长尖，基部渐狭且稍下延，全缘。花着生甚密，初为淡红色，后变为银白色，穗状花序单生于茎项或分枝顶，呈圆柱形或圆锥形，长3-10cm，苞片、小苞片和花被片子膜质，白色光亮；花被片5，白色或粉红色，披针形；雄蕊5，下部合生成杯状，花药紫色。胞果卵状椭圆形，盖裂，上部作帽状脱落，顶端有宿存花柱，包在宿存花被片内。种子扁圆形，黑色，光亮。花期5-8月.果期6-10月。"}]},{"ID":"20240613085055-n9dzcff","Type":"NodeParagraph","Properties":{"id":"20240613085055-n9dzcff","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613085055-pvc39fl","Type":"NodeParagraph","Properties":{"id":"20240613085055-pvc39fl","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候。对土壤要求不严，以肥沃、排水良好的砂质壤上栽培为宜。忌积水，低洼地不宜种植。"}]},{"ID":"20240613085055-3aljzci","Type":"NodeParagraph","Properties":{"id":"20240613085055-3aljzci","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种于繁殖。应选穗长、分枝多、产量高的植株采种子作种用。青葙与鸡冠花易杂交，显着影响产量，故留种应注意与鸡冠花隔离种植，以保证纯种。种子发芽率70％～80％，发芽适温为25℃，在20～30℃内发芽良好。春播3～4月，开1．3m的畦，条播，按行距30cm开浅沟，把种子均匀撒在沟内，覆土0．5cm，稍加镇压，浇水。每1hm2用种量4．5～6.0kg。穴播，按行株距各约25cm开穴，深5～6cm，做到穴浅底平，施人畜粪水后，拌少量火灰，作成种子灰，匀撒穴里，再盖火灰一层。每1hm2用种量3．75kg。"}]},{"ID":"20240613085055-qr8f1nv","Type":"NodeParagraph","Properties":{"id":"20240613085055-qr8f1nv","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"田间管理 出苗后，中耕除草3次，第1次在苗高4～7cm时，松土除草；第2次在苗高17cm左右时，浅薅除草，并进行匀苗、补苗，每穴苗3～4株；第3次在初现花时进行，结合培土，防止倒伏。在每次中耕除草后，结合追肥，施人粪尿、硫酸按、过磷酸钙。"}]},{"ID":"20240613085055-gmct199","Type":"NodeParagraph","Properties":{"id":"20240613085055-gmct199","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"病虫害防治 虫害有蚜虫等。"}]},{"ID":"20240613085055-6e6h28z","Type":"NodeParagraph","Properties":{"id":"20240613085055-6e6h28z","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613085055-bpna9va","Type":"NodeParagraph","Properties":{"id":"20240613085055-bpna9va","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 种子扁圆形，中央微隆起，直径1-1．8mm。表面黑色或红黑色，光亮，于扩大镜下观察，可见网状纹理，侧边微凹处为种脐。"}]},{"ID":"20240613085055-n6m9lxd","Type":"NodeParagraph","Properties":{"id":"20240613085055-n6m9lxd","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"种子易粘手，种皮薄而脆，胚乳类白色。气无，味淡。（图2）以粒饱满、色黑、光亮者为佳。"}]},{"ID":"20240613085055-cou5x9o","Type":"NodeParagraph","Properties":{"id":"20240613085055-cou5x9o","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：黑灰色。①种皮表皮细胞暗棕红色。断面现类方形，径向27-56μm，切向约至35μm，外壁色深，极厚，具垂直或稍斜向的条状增厚，径向壁稍厚，弯曲；表面观细胞多角形或长多角形，直径15-37μm，具致密网状增厚纹理。②种皮内表皮细胞多角形，具细密平行的角质纹理。另有色素层细胞、胚乳细胞及草酸钙方晶。（图3）"}]},{"ID":"20240613085055-ghl23ik","Type":"NodeParagraph","Properties":{"id":"20240613085055-ghl23ik","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613085055-tbj1nye","Type":"NodeParagraph","Properties":{"id":"20240613085055-tbj1nye","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 青葙子含脂肪油约15％、淀粉30．8％、烟酸约14μg/g及丰富的硝酸钾[1-4]。所含脂肪油称为青葙子油脂（celosia oil）[5]。"}]},{"ID":"20240613085055-1utrx6p","Type":"NodeParagraph","Properties":{"id":"20240613085055-1utrx6p","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613085055-jfl9qjd","Type":"NodeParagraph","Properties":{"id":"20240613085055-jfl9qjd","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用 品煎剂对绿脓杆菌有较强抑制作用，感染伤口经用10%煎剂，绿脓杆菌不再生长，对伤口无明显刺激。"}]},{"ID":"20240613085055-j18ceu6","Type":"NodeParagraph","Properties":{"id":"20240613085055-j18ceu6","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"2.干粉能缩短家兔血浆再钙化时间。"}]},{"ID":"20240613085055-05scl6h","Type":"NodeParagraph","Properties":{"id":"20240613085055-05scl6h","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"3.有降眼压作用 青葙子水煎液(每1ml相当于1g生药)对正常家兔瞳无明显影响，连续用药6天后，眼压有轻度下降，和对照组比较差异显着，但不能阻止水负荷后的眼压升高。"}]},{"ID":"20240613085055-9t53opg","Type":"NodeParagraph","Properties":{"id":"20240613085055-9t53opg","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613085055-c2je3dc","Type":"NodeParagraph","Properties":{"id":"20240613085055-c2je3dc","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240613085055-9epfw3y","Type":"NodeParagraph","Properties":{"id":"20240613085055-9epfw3y","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613085055-ftb8g9p","Type":"NodeParagraph","Properties":{"id":"20240613085055-ftb8g9p","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 苦；性寒"}]},{"ID":"20240613085055-mvuj757","Type":"NodeParagraph","Properties":{"id":"20240613085055-mvuj757","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613085055-k72aj5l","Type":"NodeParagraph","Properties":{"id":"20240613085055-k72aj5l","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《本草备要》：瞳子散大者忌服。"}]},{"ID":"20240613085055-sjppxsy","Type":"NodeParagraph","Properties":{"id":"20240613085055-sjppxsy","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613085055-9fbyjgy","Type":"NodeParagraph","Properties":{"id":"20240613085055-9fbyjgy","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 祛民热；清肝火；明目退翳。主目赤肿痛；眼生翳膜；视物昏花；高血压病；鼻衄；皮肤风热瘙痒；疮癣"}]},{"ID":"20240613085055-git7wew","Type":"NodeParagraph","Properties":{"id":"20240613085055-git7wew","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613085055-mofhapm","Type":"NodeParagraph","Properties":{"id":"20240613085055-mofhapm","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～15g。外用：适量，研末调敷；捣汁灌鼻。"}]},{"ID":"20240613085055-xtdrzaj","Type":"NodeParagraph","Properties":{"id":"20240613085055-xtdrzaj","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613085055-gnxuvyh","Type":"NodeParagraph","Properties":{"id":"20240613085055-gnxuvyh","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 1.《本草纲目》：青葙子治眼，与决明子、苋实同功，《本经》虽不言治眼，而云一名草决明，主唇口青，则其明目之功可知矣。目者肝之窍，唇口青者，足厥阴经之证，古方除热亦多用之，青葙子之为厥阴药，又可知矣，况用之治目，往往有验，尤可征。"}]},{"ID":"20240613085055-p4zfpcw","Type":"NodeParagraph","Properties":{"id":"20240613085055-p4zfpcw","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：青葙子，治风热目疾，与决明子功同。其治风瘙身痒，皮肤中热，以能散厥阴经中血脉之风热也。"}]},{"ID":"20240613085055-ibdjley","Type":"NodeParagraph","Properties":{"id":"20240613085055-ibdjley","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"3.《本草正义》：青葙，即鸡冠花之同类。其子苦寒滑利，善涤郁热，故目科风热肝火诸症统以治之。"}]},{"ID":"20240613085055-j7buu91","Type":"NodeParagraph","Properties":{"id":"20240613085055-j7buu91","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"4.《神农本草经》：疗唇口青。"}]},{"ID":"20240613085055-8gw97s3","Type":"NodeParagraph","Properties":{"id":"20240613085055-8gw97s3","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"5.《药性论》：治肝脏热毒冲眼，赤障、青盲、翳肿。主恶疮疥瘙，治下部虫?疮。"}]},{"ID":"20240613085055-hxptc2g","Type":"NodeParagraph","Properties":{"id":"20240613085055-hxptc2g","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：治五脏邪气，益脑髓，明耳目，镇肝，坚筋骨，去风寒湿痹。"}]},{"ID":"20240613085055-y772u9a","Type":"NodeParagraph","Properties":{"id":"20240613085055-y772u9a","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"7.《滇南本草》：明目。治泪涩难开，白翳遮睛。"}]},{"ID":"20240613085055-vk0q68s","Type":"NodeParagraph","Properties":{"id":"20240613085055-vk0q68s","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"8.《本草原始》：除心经火邪。"}]},{"ID":"20240613085055-v59eorf","Type":"NodeParagraph","Properties":{"id":"20240613085055-v59eorf","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"9.《会约医镜》：去风热。"}]},{"ID":"20240613085055-5npb6cs","Type":"NodeParagraph","Properties":{"id":"20240613085055-5npb6cs","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613085055-rkba6qt","Type":"NodeParagraph","Properties":{"id":"20240613085055-rkba6qt","updated":"20240613085055"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613085056-jhhofu3","Type":"NodeThematicBreak","Properties":{"id":"20240613085056-jhhofu3"}},{"ID":"20240613085057-rm0cm6i","Type":"NodeParagraph","Properties":{"id":"20240613085057-rm0cm6i"}}]}