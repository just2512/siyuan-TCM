:"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 6-20240808085645-rvei9zv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 445px;\" parent-style=\"width: 455px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 461px;","style":"width: 451px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿衔草 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 7-20240808085750-hxpb2jy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 451px;\" parent-style=\"width: 461px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808084913-5np8yxm","Type":"NodeParagraph","Properties":{"id":"20240808084913-5np8yxm","updated":"20240808091539"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 337px;","style":"width: 327px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿衔草 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 12-20240808091518-ac9yj5w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 327px;\" parent-style=\"width: 337px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 330px;","style":"width: 320px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿衔草 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 3-20240808085258-d91ue33.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 320px;\" parent-style=\"width: 330px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 651px;","style":"width: 641px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿衔草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 4-20240808085437-l1ff7n8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 641px;\" parent-style=\"width: 651px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808090948-l0wnkai","Type":"NodeParagraph","Properties":{"id":"20240808090948-l0wnkai","updated":"20240808091628"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 457px;","style":"width: 447px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿衔草 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 10-20240808090948-0tuyy9m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 447px;\" parent-style=\"width: 457px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 542px;","style":"width: 532px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿衔草 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿衔草 11-20240808091251-kbid6x6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 532px;\" parent-style=\"width: 542px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240617083051-0nsbuvb","Type":"NodeThematicBreak","Properties":{"id":"20240617083051-0nsbuvb"}},{"ID":"20240617083101-mjn27gs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083101-mjn27gs","updated":"20240617083106"},"Children":[{"Type":"NodeText","Data":"薇衔《神农本草经》"}]},{"ID":"20240617083101-86oqq46","Type":"NodeParagraph","Properties":{"id":"20240617083101-86oqq46","updated":"20240617083101"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240617083101-a9bw2eh","Type":"NodeParagraph","Properties":{"id":"20240617083101-a9bw2eh","updated":"20240617083101"},"Children":[{"Type":"NodeText","Data":"主风湿痹，历节痛，惊痫，吐舌，悸气，贼风，鼠瘘，痈肿。一名糜衔。生川泽。"}]},{"ID":"20240617083101-s5jh78k","Type":"NodeParagraph","Properties":{"id":"20240617083101-s5jh78k","updated":"20240617083101"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：薇，一名糜，一名无颠，一名承膏，一名丑，一名无心（《御览》）。"}]},{"ID":"20240617083101-k8cgl1z","Type":"NodeParagraph","Properties":{"id":"20240617083101-k8cgl1z","updated":"20240617083101"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名承膏，一名承肌，一名无心，一名无颠，生汉中及冤句邯郸，七月采茎。叶，阴干。"}]},{"ID":"20240617083110-10xfoo5","Type":"NodeThematicBreak","Properties":{"id":"20240617083110-10xfoo5"}},{"ID":"20240617083112-o8gar5d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083112-o8gar5d","updated":"20240617083116"},"Children":[{"Type":"NodeText","Data":"薇衔《神农本草经赞》"}]},{"ID":"20240617083112-5fr1jz6","Type":"NodeParagraph","Properties":{"id":"20240617083112-5fr1jz6","updated":"20240617083112"},"Children":[{"Type":"NodeText","Data":"味苦平。主风湿痹。历节痛。惊痫吐舌。悸气贼风。鼠痈肿。一名糜衔。生川泽。"}]},{"ID":"20240617083112-cw44qlm","Type":"NodeParagraph","Properties":{"id":"20240617083112-cw44qlm","updated":"20240617083112"},"Children":[{"Type":"NodeText","Data":"丛如茺蔚。瘥验鹿衔。有无风动。大小条芟。心平惊悸。气导和。撮量三指。后饭无。"}]},{"ID":"20240617083112-pbtid4f","Type":"NodeParagraph","Properties":{"id":"20240617083112-pbtid4f","updated":"20240617083112"},"Children":[{"Type":"NodeText","Data":"苏恭曰。此草丛生似茺蔚。一名鹿衔鹿。有疾衔此草即瘥。有大小二种。水经注。魏与锡山多生此草。有风不偃。"}]},{"ID":"20240617083112-y03xgvp","Type":"NodeParagraph","Properties":{"id":"20240617083112-y03xgvp","updated":"20240617083112"},"Children":[{"Type":"NodeText","Data":"无风独摇。岐伯曰。病名酒风。麋衔五分。合以三指。撮为后饭。李时珍曰。后饭者。先服药也。礼。无言。"}]},{"ID":"20240617083201-56sr6r4","Type":"NodeThematicBreak","Properties":{"id":"20240617083201-56sr6r4"}},{"ID":"20240617083203-yyn2uh3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083203-yyn2uh3","updated":"20240617083207"},"Children":[{"Type":"NodeText","Data":"薇衔《证类本草》"}]},{"ID":"20240617083203-d7if9lw","Type":"NodeParagraph","Properties":{"id":"20240617083203-d7if9lw","updated":"20240617083203"},"Children":[{"Type":"NodeText","Data":"味苦，平、微寒，无毒。主风湿痹历节痛，惊痫吐舌，悸气贼风，鼠痿痈肿，暴症，逐水，疗痿蹶。久服轻身明目。一名糜衔，一名承膏，一名承肌，一名无心，一名无颠。生汉中川泽及冤句、邯郸。七月采茎、叶，阴干。（得秦皮良。）"}]},{"ID":"20240617083203-hmib9sc","Type":"NodeParagraph","Properties":{"id":"20240617083203-hmib9sc","updated":"20240617083203"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶俗用亦少。唐本注云∶此草丛生，似茺蔚及白头翁，其叶有毛，茎赤。疗贼风大效。南人谓之吴风草，一名鹿衔草，言鹿有疾，衔此草瘥。又有大小二种，楚人犹谓大者为大吴风草，小者为小吴风草也。今按陈藏器本草云∶妇人服之，绝产无子。臣禹锡等谨按蜀本图经云∶叶似茺蔚，丛生，有毛，黄花，根赤黑也。"}]},{"ID":"20240617083203-ryl4e22","Type":"NodeParagraph","Properties":{"id":"20240617083203-ryl4e22","updated":"20240617083203"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶一名无心草，非草无心者。南人名吴风草，方药不用之。素问云黄帝曰∶有病者身热解堕，汗出如浴，恶风少气，此为何病？岐伯曰∶病名酒风。帝曰∶治之奈何？歧伯曰∶以泽泻、术各十分，麋衔五分，合以三指撮，为后饭。"}]},{"ID":"20240617083132-8ouplf4","Type":"NodeThematicBreak","Properties":{"id":"20240617083132-8ouplf4"}},{"ID":"20240617083133-8yjcjly","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083133-8yjcjly","updated":"20240617083138"},"Children":[{"Type":"NodeText","Data":"薇衔《千金翼方》"}]},{"ID":"20240617083133-alh9h9q","Type":"NodeParagraph","Properties":{"id":"20240617083133-alh9h9q","updated":"20240617083133"},"Children":[{"Type":"NodeText","Data":"味苦，平，微寒，无毒。主风湿痹，历节痛，惊痫吐舌，悸气，贼风鼠 ，痈肿，暴症。"}]},{"ID":"20240617083133-6o1syex","Type":"NodeParagraph","Properties":{"id":"20240617083133-6o1syex","updated":"20240617083133"},"Children":[{"Type":"NodeText","Data":"逐水疗痿蹶。久服轻身明目。一名麋衔，一名承膏，一名承肌，一名无心，一名无颠。生汉中川泽及冤句、邯郸，七月采茎叶，阴干。"}]},{"ID":"20240617083151-kte5s8u","Type":"NodeThematicBreak","Properties":{"id":"20240617083151-kte5s8u"}},{"ID":"20240617083153-9yeiboc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083153-9yeiboc","updated":"20240617083157"},"Children":[{"Type":"NodeText","Data":"薇衔《药性切用》"}]},{"ID":"20240617083153-knbhkx7","Type":"NodeParagraph","Properties":{"id":"20240617083153-knbhkx7","updated":"20240617083153"},"Children":[{"Type":"NodeText","Data":"一名鹿衔，南人名吴风草。味性苦平，理血中之湿，善治酒风湿痹，历节诸痛。"}]},{"ID":"20240617083142-zhzirkf","Type":"NodeThematicBreak","Properties":{"id":"20240617083142-zhzirkf"}},{"ID":"20240617083144-1s9fse4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083144-1s9fse4","updated":"20240617083147"},"Children":[{"Type":"NodeText","Data":"薇衔《得配本草》"}]},{"ID":"20240617083144-zgur91b","Type":"NodeParagraph","Properties":{"id":"20240617083144-zgur91b","updated":"20240617083144"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即鹿衔草"}]},{"ID":"20240617083144-svn43sc","Type":"NodeParagraph","Properties":{"id":"20240617083144-svn43sc","updated":"20240617083144"},"Children":[{"Type":"NodeText","Data":"得秦皮良。"}]},{"ID":"20240617083144-ou9b3aw","Type":"NodeParagraph","Properties":{"id":"20240617083144-ou9b3aw","updated":"20240617083144"},"Children":[{"Type":"NodeText","Data":"苦，微寒。入足阳明、厥阴、少阴经。治风湿痹痛痈肿。配泽泻、白术，治酒风自汗。"}]},{"ID":"20240617083144-6symt6s","Type":"NodeParagraph","Properties":{"id":"20240617083144-6symt6s","updated":"20240617083144"},"Children":[{"Type":"NodeText","Data":"（身热懈惰、汗出如浴、恶风少气、病名酒风。）配白附子末，薄荷汤下，疗破伤风。"}]},{"ID":"20240617083144-pp6hv3p","Type":"NodeParagraph","Properties":{"id":"20240617083144-pp6hv3p","updated":"20240617083144"},"Children":[{"Type":"NodeText","Data":"妇人服之，绝产无子。"}]},{"ID":"20240617083122-2p6f1jm","Type":"NodeThematicBreak","Properties":{"id":"20240617083122-2p6f1jm"}},{"ID":"20240617083123-8r9ezs7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083123-8r9ezs7","updated":"20240617083127"},"Children":[{"Type":"NodeText","Data":"薇衔《本经逢原》"}]},{"ID":"20240617083123-c52hdfl","Type":"NodeParagraph","Properties":{"id":"20240617083123-c52hdfl","updated":"20240617083123"},"Children":[{"Type":"NodeText","Data":"苦涩温，无毒。《素问》谓之麋衔，《唐本》曰鹿衔，《千金》曰鹿药草，言鹿有疾，衔此草即瘥也。其叶大而面绿背紫者为真。苏恭言有大小二种。保升言叶似茺蔚，丛生，有毛者，吴凤草也。"}]},{"ID":"20240617083123-vai4jif","Type":"NodeParagraph","Properties":{"id":"20240617083123-vai4jif","updated":"20240617083123"},"Children":[{"Type":"NodeText","Data":"《本经》主风湿痹，历节痛，惊痫吐血，悸气贼风，鼠 痈肿。"}]},{"ID":"20240617083123-m4wmscl","Type":"NodeParagraph","Properties":{"id":"20240617083123-m4wmscl","updated":"20240617083123"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"鹿衔《本经》专主风湿痹，历节痛，《素问》同泽术治酒风身热懈惰，汗出如浴，恶风少气之病，亦取其能除痹着血脉之风湿也。又治惊痫悸气，吐咯诸血，以其能走胃与肾肝血分，专理血中邪湿，而无留滞之患。近世治吐血、咯血用之，以其能温补冲督之精血也。陕人名为鹿胞草，言鹿食此，即能成胎。其性温，补下元可知。今吴兴山中间亦产此。"}]},{"ID":"20240617083123-m7a784b","Type":"NodeParagraph","Properties":{"id":"20240617083123-m7a784b","updated":"20240617083123"},"Children":[{"Type":"NodeText","Data":"每于初夏，群鹿引子衔食乃去，洵为确真无疑。采得晒干，一味浸酒最为有益。但性专助阳，力能走散阴精，故藏器云∶妇人服之绝产无子，良有见乎此也。其子名延寿果，味微涩而甘，惟秦地有之，不特有益于老人，而婴儿先天不足者尤为上药。惜乎，南方罕得也。"}]},{"ID":"20240617083051-gfdd0yt","Type":"NodeThematicBreak","Properties":{"id":"20240617083051-gfdd0yt"}},{"ID":"20240617083052-5ku6ap0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083052-5ku6ap0","updated":"20240617083056"},"Children":[{"Type":"NodeText","Data":"薇衔《名医别录》"}]},{"ID":"20240617083052-xf2w73z","Type":"NodeParagraph","Properties":{"id":"20240617083052-xf2w73z","updated":"20240617083052"},"Children":[{"Type":"NodeText","Data":"微寒，无毒．主暴症，逐水，治痿蹶．久服轻身，明目．一名承膏，一名承肌，一名心，一名无颠．生汉中及宛朐、邯郸．七月采茎、叶，阴干．（得秦皮良．）"}]},{"ID":"20240617083052-1pnzp6m","Type":"NodeParagraph","Properties":{"id":"20240617083052-1pnzp6m","updated":"20240617083052"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶薇衔，味苦，平．主风湿痹 节痛，惊痫吐舌，悸气贼风，鼠 痈肿．一名糜衔．生川泽．"}]},{"ID":"20240607132148-01yptiu","Type":"NodeThematicBreak","Properties":{"id":"20240607132148-01yptiu"}},{"ID":"20240617083032-f3xexx2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083032-f3xexx2","updated":"20240617083036"},"Children":[{"Type":"NodeText","Data":"薇衔《新修本草》"}]},{"ID":"20240617083032-79o9z12","Type":"NodeParagraph","Properties":{"id":"20240617083032-79o9z12","updated":"20240617083032"},"Children":[{"Type":"NodeText","Data":"味苦，平、微寒，无毒。主风湿痹历节痛，惊痫吐舌，悸气，贼风，鼠 ，痈肿，暴症，逐水，疗痿蹶。久服轻身明目。一名麋衔，一名承膏，一名承肌，一名无心，一名无颠。生汉中川泽及宛朐、邯郸。"}]},{"ID":"20240617083032-k529pn9","Type":"NodeParagraph","Properties":{"id":"20240617083032-k529pn9","updated":"20240617083032"},"Children":[{"Type":"NodeText","Data":"七月采茎、叶，阴干。"}]},{"ID":"20240617083032-try6gbj","Type":"NodeParagraph","Properties":{"id":"20240617083032-try6gbj","updated":"20240617083032"},"Children":[{"Type":"NodeText","Data":"得秦皮良。 俗用亦少。"}]},{"ID":"20240617083032-euc4zpn","Type":"NodeParagraph","Properties":{"id":"20240617083032-euc4zpn","updated":"20240617083032"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草丛生，似茺蔚及白头翁。其叶有毛，茎赤，疗贼风大效，南人谓之吴风草。"}]},{"ID":"20240617083032-w3z19um","Type":"NodeParagraph","Properties":{"id":"20240617083032-w3z19um","updated":"20240617083032"},"Children":[{"Type":"NodeText","Data":"一名鹿衔草，言鹿有疾，衔此草，瘥。又有大、小二种∶楚人犹谓大者为大吴风草，小者为小吴风草也。"}]},{"ID":"20240607132021-b7r6ziy","Type":"NodeThematicBreak","Properties":{"id":"20240607132021-b7r6ziy"}},{"ID":"20240607132136-cdevj84","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607132136-cdevj84","updated":"20240607132144"},"Children":[{"Type":"NodeText","Data":"薇衔《本草从新》"}]},{"ID":"20240607132136-9xy82vz","Type":"NodeParagraph","Properties":{"id":"20240607132136-9xy82vz","updated":"20240607132136"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通、祛风解毒．"}]},{"ID":"20240607132136-y73r5ft","Type":"NodeParagraph","Properties":{"id":"20240607132136-y73r5ft","updated":"20240607132136"},"Children":[{"Type":"NodeText","Data":"苦平．治风湿痹．历节痛．惊痫贼风．鼠 痈肿．（素问用治酒风、证见身热懈惰、汗出如浴、恶风少气、以泽泻术各十分、薇衔五分、合以三指撮为后饭．）一名麋衔．一名鹿衔．（麋鹿一类也、苏恭曰∶南人谓之吴风草、一名鹿衔草、言鹿有疾、衔此草、即瘥也．）"}]},{"ID":"20240607132058-i17b7wn","Type":"NodeThematicBreak","Properties":{"id":"20240607132058-i17b7wn"}},{"ID":"20240607132115-2fm1kfi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132115-2fm1kfi","updated":"20240607132126"},"Children":[{"Type":"NodeText","Data":"薇衔《本草崇原》"}]},{"ID":"20240607132115-5wv6hfy","Type":"NodeParagraph","Properties":{"id":"20240607132115-5wv6hfy","updated":"20240607132115"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主治风湿痹，历节痛，惊痫，吐舌，悸气，贼风，鼠 ，痈肿。（薇音眉。）"}]},{"ID":"20240607132115-fu08ys0","Type":"NodeParagraph","Properties":{"id":"20240607132115-fu08ys0","updated":"20240607132115"},"Children":[{"Type":"NodeText","Data":"（薇衔生汉中川泽及冤句，邯郸。丛生，叶似茺蔚。有毛赤茎，《本经》名麋衔，一名鹿衔，言麋鹿有疾，衔此草即瘥也。又名吴风草。李时珍曰∶按郦道元《水经注》云∶魏兴、锡山多生薇衔草，有风不偃，无风独摇，则吴风当作无风乃通。）"}]},{"ID":"20240607132115-kc75h86","Type":"NodeParagraph","Properties":{"id":"20240607132115-kc75h86","updated":"20240607132115"},"Children":[{"Type":"NodeText","Data":"按∶月令五月鹿角解，十一月麋角解，是麋鹿有阴阳之分矣。此草禀少阴水火之气，是以麋鹿咸宜，犹乌药之治猫狗也。《素问》黄帝问曰∶有病身热懈惰，汗出如浴，恶风少气，此为何病？岐伯曰∶病名酒风，治之以泽泻、术各三分，麋衔五分，合以三指撮，为后饭（后饭，先服药也）。此圣方也。而后世不知用之，诚缺典矣。"}]},{"ID":"20240607132059-pr7xqs1","Type":"NodeThematicBreak","Properties":{"id":"20240607132059-pr7xqs1"}},{"ID":"20240607132100-jkpxtlx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132100-jkpxtlx","updated":"20240607132105"},"Children":[{"Type":"NodeText","Data":"薇衔《本草经集注》"}]},{"ID":"20240607132100-pb5wm25","Type":"NodeParagraph","Properties":{"id":"20240607132100-pb5wm25","updated":"20240617082903"},"Children":[{"Type":"NodeText","Data":"味苦，平、微寒，无毒。主治风湿痹，历节痛，惊痫吐舌，悸气，贼风，鼠 ，痈肿，暴症，逐水，治痿蹶。久服轻身明目。一名麋衔，一名承膏，一名承肌，一名无心，一名无颠。生汉中川泽及宛朐、邯郸。七月采茎、叶，阴干。（得秦皮良。）世用亦少。（《大观》）"}]},{"ID":"20240607132021-dl35uyx","Type":"NodeThematicBreak","Properties":{"id":"20240607132021-dl35uyx"}},{"ID":"20240607132206-y3aqhou","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607132206-y3aqhou","updated":"20240607132214"},"Children":[{"Type":"NodeText","Data":"鹿衔草《医学入门》"}]},{"ID":"20240607132206-bxn7mdn","Type":"NodeParagraph","Properties":{"id":"20240607132206-bxn7mdn","updated":"20240607132206"},"Children":[{"Type":"NodeText","Data":"鹿有疾，衔此草则瘥，又名薇衔。味苦平，微寒。无毒。主风湿痹痛痿蹶，惊痫吐舌，贼风鼠 ，痈肿暴 ，逐水明目。岐伯治身热解惰，汗出如浴，恶风少气，名酒风，以泽泻十分，薇衔五分，饭后服。叶似茺蔚，丛生有毛，花黄根赤黑，七月采茎叶阴干，得秦皮良。"}]},{"ID":"20240617083302-dok1gvc","Type":"NodeThematicBreak","Properties":{"id":"20240617083302-dok1gvc"}},{"ID":"20240617083303-nvk9qug","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083303-nvk9qug","updated":"20240617083308"},"Children":[{"Type":"NodeText","Data":"鹿衔草《滇南本草》"}]},{"ID":"20240617083303-aohskzc","Type":"NodeParagraph","Properties":{"id":"20240617083303-aohskzc","updated":"20240617083305"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"鹿衔草"},{"Type":"NodeText","Data":"，紫背者好，叶团，高尺余，出落雪厂者效。味辛、凉，性温、平。无毒。走足少阴，添精补髓，延年益寿。治筋骨疼痛，痰火之症。煎点水酒服。"}]},{"ID":"20240607132206-vpsf19h","Type":"NodeThematicBreak","Properties":{"id":"20240607132206-vpsf19h"}},{"ID":"20240607132022-zo1rpg6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132022-zo1rpg6","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"《中国药典》：鹿衔草"}]},{"ID":"20240607132022-4snigao","Type":"NodeParagraph","Properties":{"id":"20240607132022-4snigao","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607132022-cevfzj0","Type":"NodeParagraph","Properties":{"id":"20240607132022-cevfzj0","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" Lù Xián Cǎo"}]},{"ID":"20240607132022-4192xf7","Type":"NodeParagraph","Properties":{"id":"20240607132022-4192xf7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607132022-49k3vy8","Type":"NodeParagraph","Properties":{"id":"20240607132022-49k3vy8","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 鹿蹄草、鹿含草、鹿安茶、鹿寿草、冬绿、破血丹、紫背金牛草[四川]"}]},{"ID":"20240607132022-0jx2r2e","Type":"NodeParagraph","Properties":{"id":"20240607132022-0jx2r2e","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607132022-a5nec9f","Type":"NodeParagraph","Properties":{"id":"20240607132022-a5nec9f","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" HERBA PYROLAE"}]},{"ID":"20240607132022-p08hxyj","Type":"NodeParagraph","Properties":{"id":"20240607132022-p08hxyj","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607132022-dfhk0zo","Type":"NodeParagraph","Properties":{"id":"20240607132022-dfhk0zo","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 本品为鹿蹄草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鹿蹄草"},{"Type":"NodeText","Data":"Pyrola calliantha H. Andres 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"卵叶鹿蹄草"},{"Type":"NodeText","Data":"Pyrola decorata H. Andres的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。全年均可采挖，除去杂质，晒至叶片较软时，堆置至叶片变紫褐色，晒干。"}]},{"ID":"20240607132022-lga2wqm","Type":"NodeParagraph","Properties":{"id":"20240607132022-lga2wqm","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607132022-fjj8gac","Type":"NodeParagraph","Properties":{"id":"20240607132022-fjj8gac","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 本品根茎细长。茎圆柱形或具纵棱，长10～30cm。叶基生，长卵圆形或近圆形，长2～8cm，暗绿色或紫褐色，先端圆或稍尖，全缘或有稀疏的小锯齿，边缘略反卷，上表面有时沿脉具白色的斑纹，下表面有时具白粉。总状花序有花4～10余朵；花半下垂，萼片5，舌形或卵状长圆形；花瓣5，早落，雄蕊10，花药基部有小角，顶孔开裂；花柱外露，有环状突起的柱头盘。蒴果扁球形，直径7～10mm，5纵裂，裂瓣边缘有蛛丝状毛。气微，味淡、微苦。"}]},{"ID":"20240607132022-pubg1qo","Type":"NodeParagraph","Properties":{"id":"20240607132022-pubg1qo","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607132022-ibg0kdw","Type":"NodeParagraph","Properties":{"id":"20240607132022-ibg0kdw","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防潮。"}]},{"ID":"20240607132022-r0d8htx","Type":"NodeParagraph","Properties":{"id":"20240607132022-r0d8htx","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607132022-xz00k44","Type":"NodeParagraph","Properties":{"id":"20240607132022-xz00k44","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 除去杂质，切段。"}]},{"ID":"20240607132022-uqqddpz","Type":"NodeParagraph","Properties":{"id":"20240607132022-uqqddpz","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607132022-vbgk8pz","Type":"NodeParagraph","Properties":{"id":"20240607132022-vbgk8pz","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 本品叶的横切面：上、下表皮细胞类方形，外被角质层。下表皮可见气孔，内方具厚角细胞5～7列。上表皮内方有厚角细胞1～3列。栅栏细胞不明显，海绵细胞类圆形，含草酸钙簇晶。主脉维管束外韧型，木质部呈新月形，韧皮部窄。薄壁细胞含红棕色或棕黄色物。"}]},{"ID":"20240607132022-kzokxrj","Type":"NodeParagraph","Properties":{"id":"20240607132022-kzokxrj","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607132022-44tbdaa","Type":"NodeParagraph","Properties":{"id":"20240607132022-44tbdaa","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607132022-tqlevtp","Type":"NodeParagraph","Properties":{"id":"20240607132022-tqlevtp","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607132022-rzv4m0n","Type":"NodeParagraph","Properties":{"id":"20240607132022-rzv4m0n","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 甘、苦，温。"}]},{"ID":"20240607132022-562uz8e","Type":"NodeParagraph","Properties":{"id":"20240607132022-562uz8e","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607132022-gkzvfuk","Type":"NodeParagraph","Properties":{"id":"20240607132022-gkzvfuk","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 祛风湿，强筋骨，止血。用于风湿痹痛，腰膝无力，月经过多，久咳劳嗽。"}]},{"ID":"20240607132022-gu10qgq","Type":"NodeParagraph","Properties":{"id":"20240607132022-gu10qgq","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607132022-kjvroe2","Type":"NodeParagraph","Properties":{"id":"20240607132022-kjvroe2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240607132022-63ouf2u","Type":"NodeParagraph","Properties":{"id":"20240607132022-63ouf2u","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607132022-ohsymff","Type":"NodeParagraph","Properties":{"id":"20240607132022-ohsymff","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" （1）用于风湿痹痛，可配独活、桑寄生、牛膝等同用。治肾虚腰痛、肝肾亏损、脚膝无力，可配合金雀根跟菟丝子等药。对于咯血、吐血、衄血以及月经过多等症，都可配合止血药物同用。如外伤出血，可用鲜草捣烂外敷。此外本品配芡实等，还可用于肾炎、蛋白尿。"}]},{"ID":"20240607132022-2uf2atn","Type":"NodeParagraph","Properties":{"id":"20240607132022-2uf2atn","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607132022-td6oh4r","Type":"NodeParagraph","Properties":{"id":"20240607132022-td6oh4r","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607132022-5lvfh9n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132022-5lvfh9n","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鹿衔草"}]},{"ID":"20240607132022-cout89m","Type":"NodeParagraph","Properties":{"id":"20240607132022-cout89m","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607132022-ahdmg79","Type":"NodeParagraph","Properties":{"id":"20240607132022-ahdmg79","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" Lù Xián Cǎo"}]},{"ID":"20240607132022-bpy9ev6","Type":"NodeParagraph","Properties":{"id":"20240607132022-bpy9ev6","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607132022-62rzxfh","Type":"NodeParagraph","Properties":{"id":"20240607132022-62rzxfh","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 破血丹（《植物名实图考》），纸背金牛草、大肺筋草、红肺筋草（《重庆草药》），鹿寿茶（《陕西中草药》），鹿安茶（《山西中草药》）。"}]},{"ID":"20240607132022-xa3dkju","Type":"NodeParagraph","Properties":{"id":"20240607132022-xa3dkju","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607132022-dgpj8eq","Type":"NodeParagraph","Properties":{"id":"20240607132022-dgpj8eq","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 《滇南本草》"}]},{"ID":"20240607132022-96w95ag","Type":"NodeParagraph","Properties":{"id":"20240607132022-96w95ag","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607132022-sg1ls5r","Type":"NodeParagraph","Properties":{"id":"20240607132022-sg1ls5r","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 为鹿蹄草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鹿蹄草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"圆叶鹿蹄草"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。全年可采。将全草连根挖出，洗净泥土，晒至叶片较软略抽缩时，堆压发热，使叶片两面变成紫红色或紫褐色，再晒干。"}]},{"ID":"20240607132022-68j6bht","Type":"NodeParagraph","Properties":{"id":"20240607132022-68j6bht","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607132022-tt184t8","Type":"NodeParagraph","Properties":{"id":"20240607132022-tt184t8","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" ①鹿蹄草，又名：冬绿。"}]},{"ID":"20240607132022-ii1gcam","Type":"NodeParagraph","Properties":{"id":"20240607132022-ii1gcam","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"多年生常绿草本，高20～30厘米。地下茎细长，匍匐或直伸，有不明显的节，每节具鳞片1枚，鳞腋生出分枝纤细的不定根。叶于基部丛生；叶片田形至卵圆形，长2～6厘米，宽2～5厘米，先端钝圆，基部圆形或楔圆形，全缘或具细疏圆齿，边缘向后反卷，侧脉近羽状，明显；下面常呈灰蓝绿色；叶柄长可2倍于叶片，花茎细圆柱形，具棱角，近上部有苞片1～2枚，苞片披针形；总状花序，花大，广开，直径15～20毫米，具短梗，基部有1披针形小苞片；萼片5深裂，裂片舌形，急尖或圆钝；花瓣5片，椭圆形，先端钝圆，基部稍窄，白色或稍带粉红色；雄蕊10，花丝略弯曲，扁平；雌蕊1，子房扁球形，花柱肉质，弯曲，柱头5裂，头状。蒴果扁球形，具5棱，成熟时开裂，花萼宿存。花期5～6月。果期9～10月。"}]},{"ID":"20240607132022-6rgadd7","Type":"NodeParagraph","Properties":{"id":"20240607132022-6rgadd7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"生长于山林中树下，或阴湿处。分布河北、河南、安徽、浙江、江苏、福建、江西、湖南、湖北、四川、贵州、云南、西藏、陕西、青海、甘肃等地。"}]},{"ID":"20240607132022-pidtgey","Type":"NodeParagraph","Properties":{"id":"20240607132022-pidtgey","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"②圆叶鹿蹄草"}]},{"ID":"20240607132022-eg7rdg4","Type":"NodeParagraph","Properties":{"id":"20240607132022-eg7rdg4","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"形态与上种相似，惟花较小，萼片披针形，渐尖头。分布东北、新疆、内蒙古等地。"}]},{"ID":"20240607132022-0u5ur5w","Type":"NodeParagraph","Properties":{"id":"20240607132022-0u5ur5w","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"除上述品种外，尚有同属多种植物的全草，在少数地区使用，如椭圆叶鹿蹄草使用于四川；普通鹿蹄草使用于西藏、云南、贵州；紫背鹿蹄草使用于西藏。"}]},{"ID":"20240607132022-bjkqbor","Type":"NodeParagraph","Properties":{"id":"20240607132022-bjkqbor","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607132022-4b7gube","Type":"NodeParagraph","Properties":{"id":"20240607132022-4b7gube","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 干燥全草，茎紫褐色，稍具棱，并有皱纹，无毛，微有光泽。叶柄长，扁平而中央凹下，两边呈膜质状，常弯曲，无毛。叶片皱缩，稍破碎，上面紫红色，少有呈棕绿色者，光滑，下面紫红色，无毛，叶脉微突；纸质，易碎。有时可见花茎，上有数朵小花或扁球形棕色蒴果。气无，味微苦。以紫红色或紫褐色、无杂质者为佳。"}]},{"ID":"20240607132022-povdsvm","Type":"NodeParagraph","Properties":{"id":"20240607132022-povdsvm","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"主产于浙江、安徽、贵州、陕西。此外，黑龙扛、四川、云南及海南等地亦产。以浙江产量大，浙江、安徽产者质量为佳。"}]},{"ID":"20240607132022-ucwwuct","Type":"NodeParagraph","Properties":{"id":"20240607132022-ucwwuct","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"云南以鹿衔草全草熬膏，商品为棕色方块状的固体，气清香，味甜，名\"鹿衔草膏\"，功能补气补血。"}]},{"ID":"20240607132022-i52ack0","Type":"NodeParagraph","Properties":{"id":"20240607132022-i52ack0","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607132022-tzplsu7","Type":"NodeParagraph","Properties":{"id":"20240607132022-tzplsu7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 圆叶鹿蹄草的全草含熊果酚甙7.93％，鞣质18％，及肾叶鹿蹄草甙、挥发油，还含蔗糖、蔗糖酶、苦杏仁酶等。干叶含高熊果酚甙、异高熊果酚甙。"}]},{"ID":"20240607132022-jvxm287","Type":"NodeParagraph","Properties":{"id":"20240607132022-jvxm287","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607132022-41d8tpx","Type":"NodeParagraph","Properties":{"id":"20240607132022-41d8tpx","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 圆叶鹿蹄草醚浸出液对衰弱的离体蛙心有强心作用，水及醇的浸出液作用较弱；对正常离体蛙心作用不显着。麻醉犬静脉注射鹿衔草的水、醇、醚3种浸出液皆有降压作用，兔耳灌流法证明有明显扩张血管的效力。鹿衔草各部分作用性质相似，但其叶比根、茎作用强。"}]},{"ID":"20240607132022-put5rjj","Type":"NodeParagraph","Properties":{"id":"20240607132022-put5rjj","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"熊果酚甙与根皮甙的作用一样，皆可产生糖尿。在体外试验中，还能抑制胰岛素的降解。口服后在体内很快水解而产生氢醌，与葡萄糖醛酸结合，在碱性尿中可释出游离氢醌而有杀菌作用，治尿路感染，唯效力不强。有人认为，如服用大量（1克，3～6次/日），在尿为碱性、低比重时则有效；如尿呈酸性则无效。田鼠、鸡雏的小肠中含有熊果酚甙及葡萄糖共同的主动转运载体系统，此系统对上述物质的亲和力受钠离子增强，钾离子抑制。"}]},{"ID":"20240607132022-qsd77ku","Type":"NodeParagraph","Properties":{"id":"20240607132022-qsd77ku","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"另有品种未定的鹿衔草作用如下："}]},{"ID":"20240607132022-2jrw9ga","Type":"NodeParagraph","Properties":{"id":"20240607132022-2jrw9ga","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"㈠避孕作用 雌性小鼠每日服煎剂共10天，第5日与雄鼠合笼共1月，抑制生育达100％。服药10～30天，可抑制发情期，引起子宫与卵巢的萎缩，对体重则无影响。"}]},{"ID":"20240607132022-lgv399x","Type":"NodeParagraph","Properties":{"id":"20240607132022-lgv399x","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"㈡其他 水煎浓缩加乙醇去沉淀后的水剂对离体兔心在小剂量时增加冠脉流量，但随着剂量增大，冠脉流量增加并不明显，有时反而减少。使心收缩力减弱，心跳频率减慢，常伴有节律不齐，个别尚有停搏、颤动等。"}]},{"ID":"20240607132022-jusbx52","Type":"NodeParagraph","Properties":{"id":"20240607132022-jusbx52","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607132022-uclbm5c","Type":"NodeParagraph","Properties":{"id":"20240607132022-uclbm5c","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，筛去泥沙，洗净，稍润，切细，晒干。"}]},{"ID":"20240607132022-ke22n96","Type":"NodeParagraph","Properties":{"id":"20240607132022-ke22n96","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607132022-1o350oj","Type":"NodeParagraph","Properties":{"id":"20240607132022-1o350oj","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 《植物名实图考》：\"入肝、肾二经。\""}]},{"ID":"20240607132022-tvxwep7","Type":"NodeParagraph","Properties":{"id":"20240607132022-tvxwep7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607132022-j3m03b1","Type":"NodeParagraph","Properties":{"id":"20240607132022-j3m03b1","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 甘苦，温。"}]},{"ID":"20240607132022-iboi3lg","Type":"NodeParagraph","Properties":{"id":"20240607132022-iboi3lg","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"性温平，味辛。\""}]},{"ID":"20240607132022-lq7rx8r","Type":"NodeParagraph","Properties":{"id":"20240607132022-lq7rx8r","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"②《陕西中草药》：\"苦涩，平。\""}]},{"ID":"20240607132022-8yq0oor","Type":"NodeParagraph","Properties":{"id":"20240607132022-8yq0oor","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"③《山西中草药》：\"甘，温。\""}]},{"ID":"20240607132022-2ewufix","Type":"NodeParagraph","Properties":{"id":"20240607132022-2ewufix","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607132022-t4gb3y6","Type":"NodeParagraph","Properties":{"id":"20240607132022-t4gb3y6","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 补虚，益肾，祛风除湿，活血调经，治虚弱咳嗽，劳伤吐血，风湿关节痛，崩漏，白带，外伤出血。"}]},{"ID":"20240607132022-bcv31cp","Type":"NodeParagraph","Properties":{"id":"20240607132022-bcv31cp","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"治筋骨疼痛、痰火之症，煎点水酒服。\""}]},{"ID":"20240607132022-uoi3cs2","Type":"NodeParagraph","Properties":{"id":"20240607132022-uoi3cs2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"②《植物名实图考》：\"治吐血，通经，强筋，健骨，补腰肾，生津液。\""}]},{"ID":"20240607132022-yqvtulj","Type":"NodeParagraph","Properties":{"id":"20240607132022-yqvtulj","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"③《中国药植志》：\"治虚痨，止咳。\""}]},{"ID":"20240607132022-5d9oiox","Type":"NodeParagraph","Properties":{"id":"20240607132022-5d9oiox","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"④《重庆草药》：\"治虚弱痨病，咳嗽，白带。\""}]},{"ID":"20240607132022-efwhzbj","Type":"NodeParagraph","Properties":{"id":"20240607132022-efwhzbj","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"⑤《四川常用中草药》：\"祛风除湿，止惊悸，盗汗。治痨伤吐血，筋骨酸软，风湿关节痛，惊痫吐舌，鼠漏痈肿。\""}]},{"ID":"20240607132022-xuck6g4","Type":"NodeParagraph","Properties":{"id":"20240607132022-xuck6g4","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"⑥《陕西中草药》：\"补肾壮阳，调经活血，收敛止血。治虚劳咳嗽，肾虚盗汗，腰膝无力，风湿及类风湿性关节炎，半身不遂，崩漏，白带，结膜炎，各种出血。\""}]},{"ID":"20240607132022-eapua4t","Type":"NodeParagraph","Properties":{"id":"20240607132022-eapua4t","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607132022-85obiis","Type":"NodeParagraph","Properties":{"id":"20240607132022-85obiis","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1两：研末或炖肉。外用：捣敷或研末撒。"}]},{"ID":"20240607132022-fu8zqqb","Type":"NodeParagraph","Properties":{"id":"20240607132022-fu8zqqb","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607132022-kx5xhcb","Type":"NodeParagraph","Properties":{"id":"20240607132022-kx5xhcb","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" ①治虚劳：鹿衔草一两，猪蹄一对。炖食。（《陕西中草药》）"}]},{"ID":"20240607132022-hen6a0w","Type":"NodeParagraph","Properties":{"id":"20240607132022-hen6a0w","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"②治肺结核咯血：鹿衔草、白及各四钱。水煎服。（《山西中草药》）"}]},{"ID":"20240607132022-zokxnm2","Type":"NodeParagraph","Properties":{"id":"20240607132022-zokxnm2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"③治慢性风湿性关节炎，类风湿性关节炎：鹿蹄草、白术各四钱，泽泻三钱。水煎服。（《陕甘宁青中草药选》）"}]},{"ID":"20240607132022-aseywxd","Type":"NodeParagraph","Properties":{"id":"20240607132022-aseywxd","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"④治慢性肠炎，痢疾：鹿蹄草五钱。水煎服。（《陕甘宁青中草药选》）"}]},{"ID":"20240607132022-t3bz6so","Type":"NodeParagraph","Properties":{"id":"20240607132022-t3bz6so","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"⑤治崩漏：㈠鹿衔草四两，猪肉一斤。炖热。加盐少许，两天吃完。（《陕西中草药》）㈡鹿衔草五钱，地榆炭一两。水煎，日服二次。（《吉林中草药》）"}]},{"ID":"20240607132022-fxxttut","Type":"NodeParagraph","Properties":{"id":"20240607132022-fxxttut","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"⑥治肾虚五淋白浊：鹿衔草二两，水煎服。（《云南中医验方》）"}]},{"ID":"20240607132022-kooc3ed","Type":"NodeParagraph","Properties":{"id":"20240607132022-kooc3ed","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"⑦治过敏性皮炎，疮痈肿毒，虫蛇咬伤：鹿蹄草适量。煎汤洗患处，一日二次。（《内蒙古中草药》）"}]},{"ID":"20240607132022-6ftqwc2","Type":"NodeParagraph","Properties":{"id":"20240607132022-6ftqwc2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"⑧治外伤出血，蛇咬伤：鲜鹿蹄草，捣烂或干品研末外敷。（《陕甘宁青中草药选》）"}]},{"ID":"20240607132022-basvbah","Type":"NodeParagraph","Properties":{"id":"20240607132022-basvbah","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607132022-gtt5ok1","Type":"NodeParagraph","Properties":{"id":"20240607132022-gtt5ok1","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607132022-2trjq6c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132022-2trjq6c","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鹿衔草"}]},{"ID":"20240607132022-veoq6mk","Type":"NodeParagraph","Properties":{"id":"20240607132022-veoq6mk","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607132022-u5vui5f","Type":"NodeParagraph","Properties":{"id":"20240607132022-u5vui5f","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" Lù Xián Cǎo"}]},{"ID":"20240607132022-i3ksg3n","Type":"NodeParagraph","Properties":{"id":"20240607132022-i3ksg3n","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607132022-vbewsf6","Type":"NodeParagraph","Properties":{"id":"20240607132022-vbewsf6","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 鹿蹄草、小秦王草、破血丹、纸背金牛草、大肺筋草、红肺筋草、鹿寿茶、鹿安茶、鹿含草"}]},{"ID":"20240607132022-tnbybke","Type":"NodeParagraph","Properties":{"id":"20240607132022-tnbybke","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607132022-jcgms01","Type":"NodeParagraph","Properties":{"id":"20240607132022-jcgms01","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 出自《滇南本草》"}]},{"ID":"20240607132022-0ru0zjv","Type":"NodeParagraph","Properties":{"id":"20240607132022-0ru0zjv","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607132022-s6l9o04","Type":"NodeParagraph","Properties":{"id":"20240607132022-s6l9o04","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鹿蹄草科植物普通鹿蹄草、鹿蹄草、日本鹿蹄草、红花鹿蹄草的全草。"}]},{"ID":"20240607132022-zmvs9rc","Type":"NodeParagraph","Properties":{"id":"20240607132022-zmvs9rc","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1．Pyrola deco－rata H．Andr．2．Pyrola calliantha H. Andr．[P．Rotundifolia L．Subsp．Chinensis H. Andr．」3．Py－rola japonica Klenze exAlef．4．Pyrola incarnata Fisch.ex Dc."}]},{"ID":"20240607132022-jr8bp1c","Type":"NodeParagraph","Properties":{"id":"20240607132022-jr8bp1c","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽后3～4年采收，在9～10月结合分株进行。采大留小，扯密留稀，每隔6～10cm留苗1株。以后每隔1年，又可采收1次，除去杂草，晒至发软，堆积发汗，盖麻袋等物，使叶片变紫红或紫褐色后，晒或炕干。"}]},{"ID":"20240607132022-2kayiy8","Type":"NodeParagraph","Properties":{"id":"20240607132022-2kayiy8","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607132022-8edp3la","Type":"NodeParagraph","Properties":{"id":"20240607132022-8edp3la","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔600-3000m的山地阔叶林或灌丛下。"}]},{"ID":"20240607132022-x9lgicw","Type":"NodeParagraph","Properties":{"id":"20240607132022-x9lgicw","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"2.生于海拔300-4100m山地针叶林、针阔叶混交林或阔叶林下。"}]},{"ID":"20240607132022-9uduyci","Type":"NodeParagraph","Properties":{"id":"20240607132022-9uduyci","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"3.生于海拔800-2000m的山地针阔叶混交林或阔叶林下。"}]},{"ID":"20240607132022-yvrd8ni","Type":"NodeParagraph","Properties":{"id":"20240607132022-yvrd8ni","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"4.生于海拔1000-2500m的针叶林、针阔叶混交林或阔叶林下。"}]},{"ID":"20240607132022-s056nig","Type":"NodeParagraph","Properties":{"id":"20240607132022-s056nig","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于西南及陕西、甘肃、安徽、浙江、江西、福建、台湾、河南、湖北、湖南、广东、广西等地。"}]},{"ID":"20240607132022-2ptxxjm","Type":"NodeParagraph","Properties":{"id":"20240607132022-2ptxxjm","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"2.分布于华东、西南及河北、山西、陕西、甘肃、青海、河南、湖北、湖南、西藏等地。"}]},{"ID":"20240607132022-lffafit","Type":"NodeParagraph","Properties":{"id":"20240607132022-lffafit","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"3.分布于东北及内蒙古、河北、河南。"}]},{"ID":"20240607132022-592bzwc","Type":"NodeParagraph","Properties":{"id":"20240607132022-592bzwc","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"4.分布于华北及吉林、辽宁、新疆、河南。"}]},{"ID":"20240607132022-x6oteol","Type":"NodeParagraph","Properties":{"id":"20240607132022-x6oteol","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607132022-npn1ges","Type":"NodeParagraph","Properties":{"id":"20240607132022-npn1ges","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 1.叶3-6，近基生，叶柄长1. 5-4cm；叶片薄革质，长圆形至倒卵状长圆形或匙形，稀为卵状长圆形，长3-7cm，宽2.5-4cm，先端钝尖，基部楔形或阔楔形，下延于叶柄，上面绿色，沿叶脉为淡绿白色或稍白色，下面色较淡，常带紫色，边缘有疏齿。花葶常带紫色，有1-2（-3）枚褐色鳞片状叶，先端渐尖，基部稍抱花葶。总状花序长2.5-4cm，有花4-10，半下垂；花冠碗形，淡绿色、黄绿色或近白色；花梗腋间有膜质苞片，与花梗近等长；等片先端急尖，边缘色较淡；花瓣倒卵状椭圆形，长达1cm，宽达7mm，先端圆形；雄蕊10，花丝无毛，花药黄色，具小角；花柱倾斜，上部弯曲，先端有环状突起稀不明显，伸出花冠，柱头5圆裂。葫果扁球形，直径7-10mm。花期6-7月，果期7-8月。"}]},{"ID":"20240607132022-orge48k","Type":"NodeParagraph","Properties":{"id":"20240607132022-orge48k","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"2.本品与普通鹿蹄草的区别在于：叶下面常有白霜；萼片较长，长（4-）5-7.5mm，边缘近全缘；花较大，直径1.5-2cm。花期6-8月，果期8-9月。"}]},{"ID":"20240607132022-d4payym","Type":"NodeParagraph","Properties":{"id":"20240607132022-d4payym","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"3.本品与前两种的区别在于：叶片椭圆形或卵状椭圆形，稀广椭圆形。萼片披针状三角形；苞片线状披针形；花冠白色；花瓣倒卵状椭圆形或卵状椭圆形，先端圆钝；花柱较长，长11-13mm。蒴果扁球形。花期6-7月，果期8-9月。"}]},{"ID":"20240607132022-zxblrnt","Type":"NodeParagraph","Properties":{"id":"20240607132022-zxblrnt","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"4.本品与前3种的区别在于：植株较大，高15-30cm。叶片较大，近圆形、圆卵形至卵状椭圆形，长3.5-6cm，宽2.5-5.5cm，两面有时带紫色。花葶上的鳞片状叶狭长圆形或长圆状卵形；萼片三角状宽披针形，长3.5-5mm；花冠紫色；花柱长6-10mm，伸出花冠。葫果带紫红色。花期6-7月，果期8-9月。"}]},{"ID":"20240607132022-bexd6br","Type":"NodeParagraph","Properties":{"id":"20240607132022-bexd6br","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607132022-df1zvwe","Type":"NodeParagraph","Properties":{"id":"20240607132022-df1zvwe","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜较冷凉阴湿。土壤以有较多枯朽落叶而排水良好的腐殖质上较好，可在林下栽培。"}]},{"ID":"20240607132022-td4bw2w","Type":"NodeParagraph","Properties":{"id":"20240607132022-td4bw2w","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"栽培技术 用分株繁殖。在9～10月，结合采收，连匍匐茎一齐扯起，分成单株，每株都要带有部分匍匐茎和须根。在选好的林下，把灌木杂草除去，不要翻动土层，开1．3m宽的畦，按行距25cm开小沟，深6～7cm，把幼苗放入沟里，每隔10cm放1株，斜靠沟壁，盖腐质上与地面齐平。栽后淋1次水。平时要勤除杂草，每年冬季要盖腐殖土拌石灰。"}]},{"ID":"20240607132022-bovanmn","Type":"NodeParagraph","Properties":{"id":"20240607132022-bovanmn","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607132022-6jcwafp","Type":"NodeParagraph","Properties":{"id":"20240607132022-6jcwafp","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 性状鉴别（1）普通鹿蹄草 全草长14-30cm，全体无毛，棕绿色或近浅红棕色。根茎细长，具细根及鳞叶；稍具纵棱，棱间有细纵皱纹。叶互生；基生叶3-6片，叶柄长2-4cm，具棱；叶片革质，较厚，长卵形、椭圆形或长椭圆形，长3．5-7cm，宽2．3-4cm，先端钝尖，有小突尖头，叶基广楔形，下延至叶柄，叶缘有稀疏小齿；表面枯绿色，背面紫红色。花葶高15-30cm；总状花序具花5-8朵；苞片线状披针形，花广钟状；萼5深裂。蒴果深棕色，扁球形。（2）鹿蹄草 全草长（10-）15-30cm。根茎细长，有分枝。基生叶4-7片，叶片椭圆形或卵圆形，稀近圆形，长达5．2cm，宽达3．5cm，叶背面常有白霜，有时带紫色。"}]},{"ID":"20240607132022-2xmmngk","Type":"NodeParagraph","Properties":{"id":"20240607132022-2xmmngk","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"（3）日本鹿蹄草 总状花序有花3-12朵；萼片宽披针形；叶宽卵圆形至宽卵形；花葶上无苞片或有1片。"}]},{"ID":"20240607132022-j06v34y","Type":"NodeParagraph","Properties":{"id":"20240607132022-j06v34y","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"（4）红花鹿蹄草 花深紫红色；萼片三角状披针形，渐尖头。"}]},{"ID":"20240607132022-eryzttm","Type":"NodeParagraph","Properties":{"id":"20240607132022-eryzttm","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607132022-r8f5uwp","Type":"NodeParagraph","Properties":{"id":"20240607132022-r8f5uwp","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 鹿蹄草素小鼠静脉注射半数致死量为0.227±0.037g／kg。犬每日静脉注射鹿蹄草素5或15mg／kg，连续14天，除犬剂量组可见轻度呕吐外，血象、尿常规、肝、肾功能、心电图及病理组织学检查均未发现异常。"}]},{"ID":"20240607132022-8g72te0","Type":"NodeParagraph","Properties":{"id":"20240607132022-8g72te0","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607132022-fx3w0ea","Type":"NodeParagraph","Properties":{"id":"20240607132022-fx3w0ea","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 1．普通鹿蹄草 含鹿蹄草素即2，5-二羟基甲苯（2，5-dihydroxytoluene）[1]，山奈酚-3-O-葡萄糖甙（kaempfer－ol-3-O-glucoside），槲皮素-3-O-葡萄糖甙（quercetin-3-O-gluco-Side）［2］。"}]},{"ID":"20240607132022-seor2ap","Type":"NodeParagraph","Properties":{"id":"20240607132022-seor2ap","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"2．鹿蹄草 含N-苯基-2-萘胺（N－phenyl-2-naphthylam-ine），伞形梅笠草素（chimaphilin），高熊果酚甙（homoarbutin），没食子酸（gallic acid），原儿茶酸（protocatechuic acid），鹿蹄草素，槲皮素（quercetin）[3]，没食子鞣质（gallotannin）[4]，肾叶鹿蹄草甙（renifolin），6－O-没食子酰高熊果酚甙（6－O-galloylhomoarbutin），金丝桃甙（hyperin），没食子酰金丝桃甙（galloylhyperin）[5]。"}]},{"ID":"20240607132022-i2r7smf","Type":"NodeParagraph","Properties":{"id":"20240607132022-i2r7smf","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"3．日本鹿蹄草 含鹿蹄草甙（pirolatin），高熊果酚甙，熊果酚甙（arbutin），甲基熊果酚甙（methyl arbutin）以及槲皮素（quercetin），十一烷（hentriacontane），β-谷甾醇（β-sitosterol），α3-谷甾醇（α-sitosterol），齐墩果酸（oleanolic acid），熊果酸（ursolicacid）[6]。"}]},{"ID":"20240607132022-p5usok0","Type":"NodeParagraph","Properties":{"id":"20240607132022-p5usok0","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"4．红花鹿蹄草 含高熊果酚甙、异高熊果酚甙（isohomoar-butin）［7］，6-O-没食子酰高熊果酚甙，右旋儿茶精（catechin），左旋表儿茶精没食子酸酯（epicatechin gallate），原矢车菊素（pro－cyanidin）B1及B3，原矢车菊素B2-3’－O-没食子酸酯（procyanid－inB2－3’－O-gallate），原矢车菊素B2-3,3’－O-没食子酸酯（procyani－din B2-3，3’－di－O-gallate），金丝桃甙，金丝桃甙-2”－O-没食子酸酯（hyperin-2”－O-gallate）［8］。"}]},{"ID":"20240607132022-u8mi5v0","Type":"NodeParagraph","Properties":{"id":"20240607132022-u8mi5v0","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607132022-mk6qzz2","Type":"NodeParagraph","Properties":{"id":"20240607132022-mk6qzz2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 1.对心血管的作用 鹿蹄草浸剂对衰弱的蛙心有增加心肌收缩力，抗心律不齐的作用，但对正常离体蛙心作用不显着。它还可使犬、兔心肌收缩力增强，血管显着扩张，血压下降，叶的作用比根、茎强。用鹿蹄草的注射剂(0.25g／ml)灌注离体兔耳、前后肢及心脏，都可增加心流量，其中对兔心冠状血管的扩张作用强于对兔耳及前后肢血管的作用。鹿蹄草的注射剂灌注还能对抗去甲肾上腺素的血管收缩作用，使之扩张。以小鼠心肌摄取86Rb多少为指标，观察到鹿蹄草醚提液、醇提液、醚提液Ⅲ号结晶和醚提液Ⅴ及Ⅵ号液均可不同程度地增加小鼠心肌86Rb摄取量，有改善心肌营养性血流的作用。另外，鹿衔草水煎液也能明显增加小鼠心肌营养性血流量和组织(肝、肾、脾、脑)血流量，并能明显升高血浆cAMP含量。"}]},{"ID":"20240607132022-1lydwkn","Type":"NodeParagraph","Properties":{"id":"20240607132022-1lydwkn","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用 鹿衔草水煎剂对金黄色葡萄球菌、溶血性链球菌、肺炎球菌、脑膜炎球菌、福氏痢疾杆菌、伤寒杆菌及绿脓杆菌等有抑制作用，鹿蹄草素对金黄色葡萄球菌、伤寒杆菌、绿脓杆菌、变形杆菌、宋内氏痢疾杆菌及大肠杆菌也均有抑制作用，其MIC分别为：12.5、12.5-50、20-50、50和100mcg／ml。"}]},{"ID":"20240607132022-237cknu","Type":"NodeParagraph","Properties":{"id":"20240607132022-237cknu","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"3.抗孕作用 雌性小鼠每日服鹿衔草煎剂共10天，第5天起与雄鼠合笼共1月，抑制生育达100%。服药10-30天，可抑制发情期，引起子宫与卵巢萎缩。"}]},{"ID":"20240607132022-ssyjnm7","Type":"NodeParagraph","Properties":{"id":"20240607132022-ssyjnm7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"4．免疫促进作用 鹿衔草50%水煎液能提高活性E一玫瑰花结形成，1：20时的玫瑰花结形成率为34.5±1.48%，正常对照的花结形成率为21.8±2.15%。鹿衔草水煎液还能促进淋巴细胞转化，1：20时的转化率达65．0±0．5%，而生理盐水对照组的转化率为1．0±0．5%，PHA对照组(50个血凝单位)的转化率为76.0±1.O%。"}]},{"ID":"20240607132022-4799y13","Type":"NodeParagraph","Properties":{"id":"20240607132022-4799y13","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"5.其它作用 熊果甙口服后在体内迅速水解产生氢酮，与葡萄糖醛酸结合，在碱性尿中可游离出氢醌而有杀菌作用。但治疗尿路感染效力不强。在田鼠和小鸡的小肠中含有熊果酚及葡萄糖的共同主动转运系统，此系统对上述物质的亲和力受Na+增强，K+抑制。"}]},{"ID":"20240607132022-ttxhau2","Type":"NodeParagraph","Properties":{"id":"20240607132022-ttxhau2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607132022-eee24eq","Type":"NodeParagraph","Properties":{"id":"20240607132022-eee24eq","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，筛去泥沙，洗净，稍润，切细，晒干。"}]},{"ID":"20240607132022-ua4vgl7","Type":"NodeParagraph","Properties":{"id":"20240607132022-ua4vgl7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607132022-mpfutz7","Type":"NodeParagraph","Properties":{"id":"20240607132022-mpfutz7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240607132022-cra1vk2","Type":"NodeParagraph","Properties":{"id":"20240607132022-cra1vk2","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607132022-xcsyf7t","Type":"NodeParagraph","Properties":{"id":"20240607132022-xcsyf7t","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 甘；苦；性温"}]},{"ID":"20240607132022-vrmnhwh","Type":"NodeParagraph","Properties":{"id":"20240607132022-vrmnhwh","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607132022-085b68h","Type":"NodeParagraph","Properties":{"id":"20240607132022-085b68h","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 补肾强骨；祛风除湿；止咳；止血。主肾虚腰痛；风湿痹痛；筋骨痿软；新久咳嗽；吐血；衄血；崩漏；外伤出血"}]},{"ID":"20240607132022-t5ujn8g","Type":"NodeParagraph","Properties":{"id":"20240607132022-t5ujn8g","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607132022-285otw7","Type":"NodeParagraph","Properties":{"id":"20240607132022-285otw7","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g；研末，6-9g。外用：适量，捣敷或研撒；或煎水洗。"}]},{"ID":"20240607132022-p25d392","Type":"NodeParagraph","Properties":{"id":"20240607132022-p25d392","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607132022-nzsw19n","Type":"NodeParagraph","Properties":{"id":"20240607132022-nzsw19n","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" ①治虚劳， 鹿衔草一两，猪蹄一对。炖食。(《陕西中草药》)②治肺结核咯血： 鹿衔草、白及各四钱。水煎服。(《山西中草药》)③治慢性风湿性关节炎，类风湿性关节炎；鹿蹄草、白术各四钱，泽泻三钱。水煎服。(《陕甘宁青中草药选》)④治慢性肠炎，痢疾： 鹿蹄草五钱。水煎服。(《陕甘宁青中草药选》)⑤治崩漏：一、鹿衔草四两，猪肉一斤。炖熟，加盐少许，两天吃完。(《陕西中草药》)。二、鹿衔草五钱，地榆炭一两。水煎，日服二次。(《吉林中草药》＞⑥治肾虚五淋白浊： 鹿街草二两，水煎服。(《云南中医验方》)。⑦治过敏性皮炎，疮痈肿毒，虫蛇咬伤： 鹿蹄草适量。煎汤洗患处，一日二次。(《内蒙古中草药》。⑧治外伤出血，蛇咬伤： 鲜鹿蹄草，捣烂或干品研末外敷。(《陕甘宁青中草药选》)"}]},{"ID":"20240607132022-kh358ib","Type":"NodeParagraph","Properties":{"id":"20240607132022-kh358ib","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607132022-wqe6hmg","Type":"NodeParagraph","Properties":{"id":"20240607132022-wqe6hmg","updated":"20240607132022"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607132024-5gq2cc8","Type":"NodeThematicBreak","Properties":{"id":"20240607132024-5gq2cc8"}},{"ID":"20240607132025-i2pbwvu","Type":"NodeParagraph","Properties":{"id":"20240607132025-i2pbwvu"}}]}