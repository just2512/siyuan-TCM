-p87khef.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 557px;\" parent-style=\"width: 567px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 695px;","style":"width: 685px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"通草 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/通草 2-20240813153228-xmyf2zv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 685px;\" parent-style=\"width: 695px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813153450-l5pp3cr","Type":"NodeParagraph","Properties":{"id":"20240813153450-l5pp3cr","updated":"20240813153542"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 624px;","style":"width: 614px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"通草 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/通草 3-20240813153450-dik9qqs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 614px;\" parent-style=\"width: 624px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 565px;","style":"width: 555px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"通草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/通草 4-20240813153541-xsafrn3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 555px;\" parent-style=\"width: 565px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813153650-rm9qsw2","Type":"NodeParagraph","Properties":{"id":"20240813153650-rm9qsw2","updated":"20240813154848"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 687px;","style":"width: 677px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"通草 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/通草 6-20240813153650-qmcte38.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 677px;\" parent-style=\"width: 687px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 441px;","style":"width: 431px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"通草 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/通草 7-20240813154514-h37wpx3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 431px;\" parent-style=\"width: 441px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813153802-rt6li88","Type":"NodeParagraph","Properties":{"id":"20240813153802-rt6li88","updated":"20240813153923"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：通脱木的茎是空心的，药用部位是茎里面包裹的白芯，质地轻软似海绵；"}]},{"ID":"20240813162319-4pvaqf7","Type":"NodeParagraph","Properties":{"id":"20240813162319-4pvaqf7","updated":"20240820114456"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"二注：该篇存疑；（据本草恒益考证，通草可能是五叶木通）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"}]},{"ID":"20240611140650-cuc67qy","Type":"NodeThematicBreak","Properties":{"id":"20240611140650-cuc67qy"}},{"ID":"20240611140701-oqvryus","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140701-oqvryus","updated":"20240611140707"},"Children":[{"Type":"NodeText","Data":"通草《神农本草经》"}]},{"ID":"20240611140701-846iram","Type":"NodeParagraph","Properties":{"id":"20240611140701-846iram","updated":"20240611140701"},"Children":[{"Type":"NodeText","Data":"（《御览》作蓪草）"}]},{"ID":"20240611140701-tgduk7w","Type":"NodeParagraph","Properties":{"id":"20240611140701-tgduk7w","updated":"20240611140701"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240611140701-e7wual9","Type":"NodeParagraph","Properties":{"id":"20240611140701-e7wual9","updated":"20240611140701"},"Children":[{"Type":"NodeText","Data":"主去恶虫，除脾胃寒热，通利九窍，血脉关节，今人不忘。一名附支。生山谷。"}]},{"ID":"20240611140701-oiktpki","Type":"NodeParagraph","Properties":{"id":"20240611140701-oiktpki","updated":"20240611140701"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：蓪草，一名丁翁，一名附支，神农黄帝辛，雷公苦，生石城山谷，叶菁蔓延，止汗，自正月采（《御览》）。"}]},{"ID":"20240611140701-rv6ylf9","Type":"NodeParagraph","Properties":{"id":"20240611140701-rv6ylf9","updated":"20240611140701"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名丁翁，生石城及山阳，正月采枝，阴干。"}]},{"ID":"20240611140701-xi8cjnc","Type":"NodeParagraph","Properties":{"id":"20240611140701-xi8cjnc","updated":"20240611140701"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：附支，蓪草也。《中山经》云：升山其草多寇脱。郭璞云：寇脱草，生南方，高丈许，似荷叶，而茎中有瓤，正白，零陵人植而日灌之，以为树也。《尔雅》云：离南活莌.郭璞注同，又倚商，活脱。郭璞云：即离南也。《范子计然》云：蓪草，出三辅。"}]},{"ID":"20240611140713-huxjwit","Type":"NodeThematicBreak","Properties":{"id":"20240611140713-huxjwit"}},{"ID":"20240611140715-qi8l5zm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140715-qi8l5zm","updated":"20240611140721"},"Children":[{"Type":"NodeText","Data":"通草《本草求真》"}]},{"ID":"20240611140715-3rl0p9l","Type":"NodeParagraph","Properties":{"id":"20240611140715-3rl0p9l","updated":"20240611140715"},"Children":[{"Type":"NodeText","Data":"（蔓草）清肺通乳利水"}]},{"ID":"20240611140715-eaxkysv","Type":"NodeParagraph","Properties":{"id":"20240611140715-eaxkysv","updated":"20240611140715"},"Children":[{"Type":"NodeText","Data":"通草（专入肺胃）。气味甘淡。体轻色白。有类灯心。（时珍曰。有细孔。两头皆通。故名通草。即今所谓木通也。今之通草。乃古之通脱木也。颂曰。古方所用通。皆今之木通。其通脱木。稀有用者。）功同入肺。引热下降。及利小便。通淋治肿。（杲曰。通草泻肺利小便。甘平以缓阴血也。与灯草同功。宜生用之。）然灯心质小气寒。则兼降心火。此则兼入胃通气上达而下乳汁之为异耳。（时珍曰。通草色白而气寒。疏淡而体轻。）况此体大气轻。渗淡殆甚。能升能降。既可入肺而清热。复能上行而通胃。东垣用此以治五种水肿癃闭。非取气寒能降。味淡能升之意乎？仲景用此合当归芍药桂枝细辛大枣甘草。名为当归四逆汤。以治伤寒邪入厥阴。非取通草以通营卫之意乎？但孕妇勿服。"}]},{"ID":"20240611140730-k21pq9m","Type":"NodeThematicBreak","Properties":{"id":"20240611140730-k21pq9m"}},{"ID":"20240611140731-dsimwtt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140731-dsimwtt","updated":"20240611140737"},"Children":[{"Type":"NodeText","Data":"通草《得配本草》"}]},{"ID":"20240611140731-s457hi9","Type":"NodeParagraph","Properties":{"id":"20240611140731-s457hi9","updated":"20240611140731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"古名通脱木"}]},{"ID":"20240611140731-jbc6c1x","Type":"NodeParagraph","Properties":{"id":"20240611140731-jbc6c1x","updated":"20240611140731"},"Children":[{"Type":"NodeText","Data":"甘、淡、微寒。入手太阴、足阳明经气分。泻肺气，利阴窍，下五淋，通乳汁。能使经络流行，营卫通畅。（以能开厥阴之关也。）佐琥珀、茯苓，泻火利水。"}]},{"ID":"20240611140731-p23akg1","Type":"NodeParagraph","Properties":{"id":"20240611140731-p23akg1","updated":"20240611140731"},"Children":[{"Type":"NodeText","Data":"中寒者勿用。"}]},{"ID":"20240611140742-co2eeo1","Type":"NodeThematicBreak","Properties":{"id":"20240611140742-co2eeo1"}},{"ID":"20240611140744-djoqf58","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140744-djoqf58","updated":"20240611140748"},"Children":[{"Type":"NodeText","Data":"通草《长沙药解》"}]},{"ID":"20240611140744-rujsk3o","Type":"NodeParagraph","Properties":{"id":"20240611140744-rujsk3o","updated":"20240611140744"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛平。主去恶虫，除脾胃寒热，通利九窍，血脉关节，今人不忘。一名附支。生山谷。"}]},{"ID":"20240611140744-dgosdp9","Type":"NodeParagraph","Properties":{"id":"20240611140744-dgosdp9","updated":"20240611140744"},"Children":[{"Type":"NodeText","Data":"味辛，入足厥阴肝、手少阴心、足太阳膀胱经。行血脉之瘀涩，利水道之淋癃。"}]},{"ID":"20240611140744-ohpt84o","Type":"NodeParagraph","Properties":{"id":"20240611140744-ohpt84o","updated":"20240611140744"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当归四逆汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在当归。"},{"Type":"NodeText","Data":"用之，治厥阴病，手足厥冷，脉细欲绝。以其通经络而开结涩也。"}]},{"ID":"20240611140744-2g5cys3","Type":"NodeParagraph","Properties":{"id":"20240611140744-2g5cys3","updated":"20240611140744"},"Children":[{"Type":"NodeText","Data":"通草疏利壅塞，开通隧道，善下乳汁，而通月水。故能治经络结涩，性尤长于泻水。其诸主治，通经闭，下乳汁，疗黄疸，消水肿，开淋涩，消痈疽，利鼻痈，除心烦。"}]},{"ID":"20240611140755-p9lsbb6","Type":"NodeThematicBreak","Properties":{"id":"20240611140755-p9lsbb6"}},{"ID":"20240611140757-s2hujrs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140757-s2hujrs","updated":"20240611140801"},"Children":[{"Type":"NodeText","Data":"通草《汤液本草》"}]},{"ID":"20240611140757-njgf68t","Type":"NodeParagraph","Properties":{"id":"20240611140757-njgf68t","updated":"20240611140757"},"Children":[{"Type":"NodeText","Data":"气平，味甘、辛，阳也。无毒。灯草同。"}]},{"ID":"20240611140757-5007b74","Type":"NodeParagraph","Properties":{"id":"20240611140757-5007b74","updated":"20240611140757"},"Children":[{"Type":"NodeText","Data":"《象》云∶治阴窍不利，行小水，除水肿闭，治五淋。生用。"}]},{"ID":"20240611140757-bpf7hp9","Type":"NodeParagraph","Properties":{"id":"20240611140757-bpf7hp9","updated":"20240611140757"},"Children":[{"Type":"NodeText","Data":"《珍》云∶泻肺，利小便。甘平，以缓阴血。"}]},{"ID":"20240611140757-m041p0x","Type":"NodeParagraph","Properties":{"id":"20240611140757-m041p0x","updated":"20240611140757"},"Children":[{"Type":"NodeText","Data":"《日华子》云∶明目退热，催生，下胞，下乳。"}]},{"ID":"20240611140821-ww4innf","Type":"NodeThematicBreak","Properties":{"id":"20240611140821-ww4innf"}},{"ID":"20240611140822-hpif4g0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140822-hpif4g0","updated":"20240611140826"},"Children":[{"Type":"NodeText","Data":"通草《本草撮要》"}]},{"ID":"20240611140822-do0la4s","Type":"NodeParagraph","Properties":{"id":"20240611140822-do0la4s","updated":"20240611140822"},"Children":[{"Type":"NodeText","Data":"味淡色白．入手太阴足阳明经．功专引热下行．下乳汁．治五淋水肿．目昏耳聋．鼻塞失音．退热催生．新通草瓦上烧存性研末．用二钱热酒冲服．治头痛牙关已闭者神效．"}]},{"ID":"20240611140832-wx1l3pd","Type":"NodeThematicBreak","Properties":{"id":"20240611140832-wx1l3pd"}},{"ID":"20240611140833-31n8zlb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140833-31n8zlb","updated":"20240611140843"},"Children":[{"Type":"NodeText","Data":"通草《本草图经》"}]},{"ID":"20240611140833-xqcglxo","Type":"NodeParagraph","Properties":{"id":"20240611140833-xqcglxo","updated":"20240611140838"},"Children":[{"Type":"NodeText","Data":"通草，生石城山谷及山阴，今泽、潞、汉中、江淮、湖南州郡亦有之。"}]},{"ID":"20240611140833-hakrf0g","Type":"NodeParagraph","Properties":{"id":"20240611140833-hakrf0g","updated":"20240611140833"},"Children":[{"Type":"NodeText","Data":"生作藤蔓，大如指；其茎秆大者径三寸，每节有二、三枝；枝头出五叶，颇类石韦；又似芍药，三叶相对，夏秋开紫花，亦有白花者；结实如小木瓜，核黑，瓤白，食之甘美，南人谓之燕 ，亦云乌 。"}]},{"ID":"20240611140833-3vhpubm","Type":"NodeParagraph","Properties":{"id":"20240611140833-3vhpubm","updated":"20240611140833"},"Children":[{"Type":"NodeText","Data":"正月、二月采枝，阴干用。或以为葡萄苗，非也。今人谓之木通。而俗间所谓通草，乃通脱木也。此木生山侧，叶如萆麻，心空，中有瓤，轻白可爱，女工取以饰物。《尔雅》云∶离南，活 （音脱）。释云∶离南，草也，一名活 。《山海经》又名寇脱，生江南，高丈许，大叶似荷而肥，茎中有瓤，正白者是也。又名倚商，主蛊毒。其花上粉，主诸虫 恶疮痔疾，取粉内疮中。正元广利方，疗瘰 ，及李绛兵部疗胸伏气攻胃咽不散方中，并用之。今京师园圃间亦有种莳者。又按张氏《燕吴行役记》∶扬州大仪甘泉东院两廊前，有通草，其形如椿，少叶，子垂梢际，如苦楝。与今所说殊别，不知是木通邪？通脱邪？或别是一种也。"}]},{"ID":"20240611140833-h5itosa","Type":"NodeParagraph","Properties":{"id":"20240611140833-h5itosa","updated":"20240611140833"},"Children":[{"Type":"NodeText","Data":"古方所用通草，皆今之木通。通脱稀有使者，近世医家多用利小便。南人或以蜜煎作果，食之甚美，兼解诸药毒。"}]},{"ID":"20240611140850-rkgndub","Type":"NodeThematicBreak","Properties":{"id":"20240611140850-rkgndub"}},{"ID":"20240611140851-eytqt2u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140851-eytqt2u","updated":"20240611140856"},"Children":[{"Type":"NodeText","Data":"通草《新修本草》"}]},{"ID":"20240611140851-3j38psf","Type":"NodeParagraph","Properties":{"id":"20240611140851-3j38psf","updated":"20240611140851"},"Children":[{"Type":"NodeText","Data":"味辛、甘、平，无毒。主去恶虫，除脾胃寒热，通利九窍血脉关节，令人不忘。疗脾疸，常疗耳聋，散痈肿诸结不消，及金疮恶疮，鼠 ， 折， 鼻，息肉，堕胎，去三虫。一名附支，一名丁翁。生石城山谷及山阳。正月采枝，阴干。"}]},{"ID":"20240611140851-8g19qab","Type":"NodeParagraph","Properties":{"id":"20240611140851-8g19qab","updated":"20240611140851"},"Children":[{"Type":"NodeText","Data":"今出近道。绕树藤生，汁白。茎有细孔，两头皆通。含一头吹之，则气出彼头者良。或云即 藤茎。"}]},{"ID":"20240611140851-i2by7ah","Type":"NodeParagraph","Properties":{"id":"20240611140851-i2by7ah","updated":"20240611140851"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物大者径三寸，每节有二、三枝，枝头有五叶。其子长三、四寸，核黑穣白，食之甘美。南人谓为燕覆，或名乌覆。今言 藤， 覆声相近尔。"}]},{"ID":"20240611140810-bg91d8u","Type":"NodeThematicBreak","Properties":{"id":"20240611140810-bg91d8u"}},{"ID":"20240611140812-yaewl9n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140812-yaewl9n","updated":"20240611140816"},"Children":[{"Type":"NodeText","Data":"通草《本经逢原》"}]},{"ID":"20240611140812-t7hoh9z","Type":"NodeParagraph","Properties":{"id":"20240611140812-t7hoh9z","updated":"20240611140812"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原名通脱木"}]},{"ID":"20240611140812-t25xvl3","Type":"NodeParagraph","Properties":{"id":"20240611140812-t25xvl3","updated":"20240611140812"},"Children":[{"Type":"NodeText","Data":"平淡，无毒。"}]},{"ID":"20240611140812-jz3iz6t","Type":"NodeParagraph","Properties":{"id":"20240611140812-jz3iz6t","updated":"20240611140812"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"通草轻虚色白，专入太阴肺经。引热下降而利小便，入阳明胃经，通气上达而下乳汁。东垣言，泻肺利小便，治五淋水肿癃闭，取气寒降味淡而升。仲景当归四逆汤，用以通在里之湿热也。妊妇勿服，以其通窍也。"}]},{"ID":"20240611140650-n4qehrm","Type":"NodeThematicBreak","Properties":{"id":"20240611140650-n4qehrm"}},{"ID":"20240611140651-z1tj5ev","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140651-z1tj5ev","updated":"20240611140655"},"Children":[{"Type":"NodeText","Data":"通草《神农本草经赞》"}]},{"ID":"20240611140651-62r4bbs","Type":"NodeParagraph","Properties":{"id":"20240611140651-62r4bbs","updated":"20240611140651"},"Children":[{"Type":"NodeText","Data":"味辛平。主去恶虫。除脾胃寒热。通利九窍血脉关节。令人不忘。一名附支。生山谷。（今名木通）藤支万年。中通营腠。引蔓浆流。解吹气透。甘受白藏。辛咀紫浓。活名同。根寻天寿。"}]},{"ID":"20240611140651-t0rl5lr","Type":"NodeParagraph","Properties":{"id":"20240611140651-t0rl5lr","updated":"20240611140651"},"Children":[{"Type":"NodeText","Data":"甄权曰。一名万年藤。韩愈诗。经纪肖营腠。陶弘景曰。绕树藤生。汁白。茎有细孔。"}]},{"ID":"20240611140651-vvthlb6","Type":"NodeParagraph","Properties":{"id":"20240611140651-vvthlb6","updated":"20240611140651"},"Children":[{"Type":"NodeText","Data":"含一头吹之。气出彼头者良。李时珍曰。有紫白二色。紫者皮浓味辛。白者皮薄味甘。皆能通利。苏颂曰。尔雅活即通脱水也。李杲曰。通脱木亦有通草之名。与木通同功用。苏颂曰。"}]},{"ID":"20240611140651-dth032o","Type":"NodeParagraph","Properties":{"id":"20240611140651-dth032o","updated":"20240611140651"},"Children":[{"Type":"NodeText","Data":"天寿根出台州。"}]},{"ID":"20240611140618-kdtq276","Type":"NodeThematicBreak","Properties":{"id":"20240611140618-kdtq276"}},{"ID":"20240611140640-5bvhzfg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140640-5bvhzfg","updated":"20240611140644"},"Children":[{"Type":"NodeText","Data":"通草《本草纲目》"}]},{"ID":"20240611140640-15tljjt","Type":"NodeParagraph","Properties":{"id":"20240611140640-15tljjt","updated":"20240611140640"},"Children":[{"Type":"NodeText","Data":"「释名」木通、附支、丁翁、万年藤，子名燕覆。"}]},{"ID":"20240611140640-owzt1ee","Type":"NodeParagraph","Properties":{"id":"20240611140640-owzt1ee","updated":"20240611140640"},"Children":[{"Type":"NodeText","Data":"「气味」辛、平、无毒。"}]},{"ID":"20240611140640-3pdbmsl","Type":"NodeParagraph","Properties":{"id":"20240611140640-3pdbmsl","updated":"20240611140640"},"Children":[{"Type":"NodeText","Data":"「主治」上能通心清肌、治头痛、利九窍，下能泄湿热、利小便、通大肠，治遍身拘痛。"}]},{"ID":"20240611140640-wkc0tq8","Type":"NodeParagraph","Properties":{"id":"20240611140640-wkc0tq8","updated":"20240611140640"},"Children":[{"Type":"NodeText","Data":"通草根：可治项下瘿瘤。"}]},{"ID":"20240611140640-2b3uoz6","Type":"NodeParagraph","Properties":{"id":"20240611140640-2b3uoz6","updated":"20240611140640"},"Children":[{"Type":"NodeText","Data":"通草子：厚肠胃，令人能食，止渴，利小便。"}]},{"ID":"20240611140618-pefymiq","Type":"NodeThematicBreak","Properties":{"id":"20240611140618-pefymiq"}},{"ID":"20240611140631-uo8cja6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140631-uo8cja6","updated":"20240611140636"},"Children":[{"Type":"NodeText","Data":"通草《本草蒙筌》"}]},{"ID":"20240611140631-or5j07o","Type":"NodeParagraph","Properties":{"id":"20240611140631-or5j07o","updated":"20240611140631"},"Children":[{"Type":"NodeText","Data":"味甘、淡，气平。味薄，降也，阳也，阳中阴也。无毒。产江淮山谷，如指大藤茎。"}]},{"ID":"20240611140631-11oqdyy","Type":"NodeParagraph","Properties":{"id":"20240611140631-11oqdyy","updated":"20240611140631"},"Children":[{"Type":"NodeText","Data":"正月采收，荫干入药。因孔节相贯，吹口气即通，故此得名。去皮咀片，泻小肠火郁不散，非他药可伦；利膀胱水闭不行，与琥珀相等。消痈疽作肿，疗脾疸嗜眠。解烦哕，开耳聋，出音声，通鼻塞。行经下乳，催产堕胎。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"结如小木瓜，名曰燕腹；（白瓤黑核。）亦能治翻胃证，除热三焦。"}]},{"ID":"20240611140631-zgsvrpr","Type":"NodeParagraph","Properties":{"id":"20240611140631-zgsvrpr","updated":"20240611140631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"治项下瘿瘤，多取绞汁顿服。又种心空有瓠，与灯草同；乃"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通脱木"},{"Type":"NodeText","Data":"立名，凭揉碎用。洁白轻虚可爱，女工每剪饰花。利水使阴窍通和，退肿令癃闭舒泰。更（谟）按∶通草、通脱木，经云∶行水专利小肠，且多他证之治。既为良药，当勿传讹。"}]},{"ID":"20240611140631-7bnyyqw","Type":"NodeParagraph","Properties":{"id":"20240611140631-7bnyyqw","updated":"20240611140631"},"Children":[{"Type":"NodeText","Data":"奈何时医每以通草认作别条木通，以通脱木反呼名曰通草。致使市家真伪混卖，误人甚多。殊不知本草立名，各有意寓。通脱木因瓠中藏脱木得之，名竟直述。通草藤茎不甚长大，故以草称。木通系俗指葡萄藤茎，且大且长，特加木字。总曰通者孔窍悉同，行水利肠固并建效，其治他证，虽百木通不能及一通草矣。齐驱并驾，安得谓乎？况木通栽多家园，皮薄坚确，实名葡萄。通草产自山谷，皮浓软柔，实名燕腹。通脱本轻虚洁白，皮木脱除。"}]},{"ID":"20240611140631-jurpdvo","Type":"NodeParagraph","Properties":{"id":"20240611140631-jurpdvo","updated":"20240611140631"},"Children":[{"Type":"NodeText","Data":"三者内似外殊，极易分别，名正言顺，何得悖违？只缘坚信耳闻，不复详考经意。错乱颠倒，莫觉其非。医误犹闲，病误深可悯也。"}]},{"ID":"20240611140619-cxm7szk","Type":"NodeThematicBreak","Properties":{"id":"20240611140619-cxm7szk"}},{"ID":"20240611140620-cf39iss","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140620-cf39iss","updated":"20240611140624"},"Children":[{"Type":"NodeText","Data":"通草《本草述钩元》"}]},{"ID":"20240611140620-7fjo14f","Type":"NodeParagraph","Properties":{"id":"20240611140620-7fjo14f","updated":"20240611140620"},"Children":[{"Type":"NodeText","Data":"即木通（古方通草。即今之木通。俗所谓通草。乃通脱木。）泽潞汉中江淮湖南州郡皆有之。绕树蔓藤。大者径三五寸。每节三二枝。枝即通草。通理细孔。含取一头吹之。气出彼头。色黄白者良。黑褐色者。用之无力。（此商人因其质轻易得。多致船篷上。为雨所浸。以致腐黑。）或谓木通即葡萄苗者。误。"}]},{"ID":"20240611140620-i8oym7a","Type":"NodeParagraph","Properties":{"id":"20240611140620-i8oym7a","updated":"20240611140620"},"Children":[{"Type":"NodeText","Data":"苦辛甘淡而微寒。气平味薄。降也。阳中阴也。入手厥阴手太阳。并及足太阳。主除脾胃寒浮大可去助西方湿热癃胫酸脚通大肠。治宜木通以周身表里之白虎历节风。遍木通服。不效。"}]},{"ID":"20240611140620-tx5xnp1","Type":"NodeParagraph","Properties":{"id":"20240611140620-tx5xnp1","updated":"20240611140620"},"Children":[{"Type":"NodeText","Data":"随手没去。出畅而痛除矣。"}]},{"ID":"20240611140620-4zmlpwy","Type":"NodeParagraph","Properties":{"id":"20240611140620-4zmlpwy","updated":"20240611140620"},"Children":[{"Type":"NodeText","Data":"面赤唇干。咬甘草。治尿血〔论〕木通主治。类知为利水。而本经所云通利九窍血脉关节。殊未深究。夫水与血。"}]},{"ID":"20240611140620-lyh9a44","Type":"NodeParagraph","Properties":{"id":"20240611140620-lyh9a44","updated":"20240611140620"},"Children":[{"Type":"NodeText","Data":"是二于肺知木贯。"}]},{"ID":"20240611140620-20o9oxj","Type":"NodeParagraph","Properties":{"id":"20240611140620-20o9oxj","updated":"20240611140620"},"Children":[{"Type":"NodeText","Data":"通原非则胸膈血散。膻中血聚。则小肠壅滞。是则血脉通利。即其通利其通利血脉之功也。上而火中之水。在小肠之气和而能化。则下而亦应之而化。故非利小肠而无与于膀胱。但病于因膀胱者。不得专以湿多属血分。不利之病也。至风热之病于血者亦用之。以风脏即脉关节之义。至女子妊娠养胎。自肝始。脏腑相滋。各三十日。惟养经之数。无胎则下为月水。有胎则凡精滑不梦自遗。及阳虚气弱。内无湿热者。禁用。妊娠忌之。（仲淳）〔修治〕去皮节。生用。"}]},{"ID":"20240611140605-r2g0s32","Type":"NodeThematicBreak","Properties":{"id":"20240611140605-r2g0s32"}},{"ID":"20240611140607-g1goebq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140607-g1goebq","updated":"20240611140613"},"Children":[{"Type":"NodeText","Data":"通草《证类本草》"}]},{"ID":"20240611140607-ir0nb7u","Type":"NodeParagraph","Properties":{"id":"20240611140607-ir0nb7u","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"味辛、甘，平，无毒。主去恶虫，除脾胃寒热，通利九窍、血脉关节，令人不忘，疗脾疸，常欲眠，心烦，哕出音声，疗耳聋，散痈肿、诸结不消，及金疮恶疮，鼠 ， 折，（音瓮）鼻息肉，堕胎，去三虫。一名附支，一名丁翁。生石城山谷及山阳。正月采枝，阴干。"}]},{"ID":"20240611140607-9v4eygq","Type":"NodeParagraph","Properties":{"id":"20240611140607-9v4eygq","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今出近道。绕树藤生，汁白。茎有细孔，两头皆通。含一头吹之，则气出彼头者良。或云即 （音福）藤茎。唐本注云∶此物大者径三寸，每节有二、三枝，枝头有五叶。"}]},{"ID":"20240611140607-gvzutkj","Type":"NodeParagraph","Properties":{"id":"20240611140607-gvzutkj","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"其子长三、四寸，核黑穣白，食之甘美。南人谓为燕 （芳服切），或名乌 今言 藤， 、声相近尔。臣禹锡等谨按药性论云∶木通，臣，微寒，一名王翁万年。主治五淋，利小便，开关格，治人多睡，主水肿浮大，除烦热。用根治项下瘤瘿。孟诜云∶燕 子，平。浓肠胃，令人能食，下三焦，除恶气。和子食之更好。江北人多不识，江南人多食。又，续五脏断绝气，使语声足气，通十二经脉。其茎名通草，食之通利诸经脉拥不通之气，北人但识通草，不委子之功。其皮不堪食。陈士良云∶燕 子，寒，无毒。主胃口热闭，反胃不下食，除三焦客热。此是木通，实名桴 子，茎名木通。主理风热淋疾，小便数急疼，小腹虚满。宜煎汤并葱食之，有效，野生。日华子云∶木通，安心除烦，止渴退热，治健忘，明耳目，治鼻寒，通小肠，下水，破积聚血块，排脓，治疮疖，止痛，催生下胞，女人血闭，月候不匀，天行时疾，头痛目眩，赢劣，乳结及下乳。子名 子，七、八月采。陈藏器云∶通脱木，无毒。花上粉，主诸虫疮，野鸡病，取粉纳疮中。生山侧，叶似蓖麻，心中有瓤，轻白可爱。"}]},{"ID":"20240611140607-1urz4oe","Type":"NodeParagraph","Properties":{"id":"20240611140607-1urz4oe","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"女工取以饰物。《尔雅》云∶离南，活脱也。一本云∶药草，生江南，主虫病，今俗亦名通草。"}]},{"ID":"20240611140607-8g1geno","Type":"NodeParagraph","Properties":{"id":"20240611140607-8g1geno","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"图经曰∶通草，生石城山谷及山阳，今泽、潞、汉中、江淮、湖南州郡亦有之。生作藤蔓，大如指，其茎秆大者径三寸。每节有二、三枝，枝头出五叶，颇类石苇，又似芍药，三叶相对。"}]},{"ID":"20240611140607-pvf8wet","Type":"NodeParagraph","Properties":{"id":"20240611140607-pvf8wet","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"夏秋开紫花，亦有白花者。结实如小木瓜，核黑瓤白，食之甘美。南人谓之燕 ，亦云乌，正月、二月采枝，阴干用。或以为葡萄苗，非也。今人谓之木通，而俗间所谓通草，乃通脱木也。此木生山侧，叶如蓖麻，心空中有瓤，轻白可爱，女工取以饰物。《尔雅》云∶离南，活（音脱）。释云∶离南，草也。一名活 。《山海经》又名寇脱，生江南，高丈许，大叶似荷而肥，茎中有瓤正白者是也。又名倚商，主蛊毒。其花上粉，主诸虫 恶疮痔疾，取粉纳疮中。《正元广利方》疗瘰 ，及李绛兵部疗胸伏气攻胃咽不散方中，并用之。今京师园圃间亦有种莳者。又按∶张氏《燕吴行役记》∶扬州大仪甘泉东院两廊前有通草，其形如椿，少叶，子垂梢际，如苦楝。与今所说殊别，不知是木通邪？通脱邪？或别是一种也。古方所用通草，皆今之木通，通脱稀有使者。近世医家多用利小便。南人或以蜜煎作果食之甚美，兼解诸药毒。"}]},{"ID":"20240611140607-dxt91pr","Type":"NodeParagraph","Properties":{"id":"20240611140607-dxt91pr","updated":"20240611140607"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶本功外，子味甘，利大小便，宣通去烦热，食之令人心宽，止渴下气，江东人呼为畜子，江西人呼为拿子，如算袋，穣黄子黑，食之当去其皮。苏云色白、乃猴 也。海药云∶谨按《徐表南州记》云∶生广州山谷。味温，平。主诸 疮，喉咙痛及喉痹，并宜煎服之，磨亦得急即含之。食疗云∶煮饮之，通妇人血气。浓煎三、五盏即便通。又除寒热不通之气，消鼠 ，金疮， 折，煮汁酿酒妙。"}]},{"ID":"20240611140554-awav700","Type":"NodeThematicBreak","Properties":{"id":"20240611140554-awav700"}},{"ID":"20240611140555-y2xpb1r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140555-y2xpb1r","updated":"20240611140558"},"Children":[{"Type":"NodeText","Data":"通草《本草备要》"}]},{"ID":"20240611140555-oo5rspd","Type":"NodeParagraph","Properties":{"id":"20240611140555-oo5rspd","updated":"20240611140555"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"古名通脱木"}]},{"ID":"20240611140555-e8dchis","Type":"NodeParagraph","Properties":{"id":"20240611140555-e8dchis","updated":"20240611140555"},"Children":[{"Type":"NodeText","Data":"轻、通、利水、退热"}]},{"ID":"20240611140555-mq04jkl","Type":"NodeParagraph","Properties":{"id":"20240611140555-mq04jkl","updated":"20240611140555"},"Children":[{"Type":"NodeText","Data":"色白气寒，体轻味淡。气寒则降，故入肺经，引热下行而利小便；味淡则升，故入胃经，通气上达而下乳汁。治五淋水肿，目昏耳聋，鼻塞失音（淡通窍，寒降火，利肺气），退热催生。"}]},{"ID":"20240611140528-iq7x01i","Type":"NodeThematicBreak","Properties":{"id":"20240611140528-iq7x01i"}},{"ID":"20240611140541-hsiq1ww","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140541-hsiq1ww","updated":"20240611140549"},"Children":[{"Type":"NodeText","Data":"通草《医学入门》"}]},{"ID":"20240611140541-42e6sto","Type":"NodeParagraph","Properties":{"id":"20240611140541-42e6sto","updated":"20240611140541"},"Children":[{"Type":"NodeText","Data":"通草辛甘泻小肠，利便故除脾疸黄，止烦哕疏九孔窍，散痈破血下乳房。"}]},{"ID":"20240611140541-0t3wwjw","Type":"NodeParagraph","Properties":{"id":"20240611140541-0t3wwjw","updated":"20240611140541"},"Children":[{"Type":"NodeText","Data":"即木通，心空有瓣，轻白可爱，女工取以饰物。无毒。阳也。赋云∶泻小肠火积不散，无他药可比；利小便热闭不通，与琥珀同功。惟其利便开关格，故疗脾疸及浮肿多睡，胃热反胃呕哕，一切脾胃寒热不通，小腹虚满，耳聋鼻塞声音不出，及妇人血闭血块，月水准匀，难产胞衣不下，乳汁不通。珍云∶甘平以缓阴血是也。惟其泻火，故治心烦躁闷，止肺热渴，散痈肿恶疮，金疮鼠 折，一切疮疖瘿瘤，排脓止痛俱效，兼杀恶虫三虫。要之，泻火则便溺自利，利便则火升自降。通行一十二经，故因名为通草。其花上粉，主恶疮痔 ，取粉掺疮中。去皮节生用。"}]},{"ID":"20240611140528-j3bf9f5","Type":"NodeThematicBreak","Properties":{"id":"20240611140528-j3bf9f5"}},{"ID":"20240611140529-al45lhc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140529-al45lhc","updated":"20240611140533"},"Children":[{"Type":"NodeText","Data":"通草《要药分剂》"}]},{"ID":"20240611140529-rw38kbl","Type":"NodeParagraph","Properties":{"id":"20240611140529-rw38kbl","updated":"20240611140529"},"Children":[{"Type":"NodeText","Data":"古名通脱木。味甘淡。性平。无毒。禀土之清气。兼得天之阳气以生。降也。阳中阴也。"}]},{"ID":"20240611140529-smpwyaj","Type":"NodeParagraph","Properties":{"id":"20240611140529-smpwyaj","updated":"20240611140529"},"Children":[{"Type":"NodeText","Data":"【主治】主利阴窍。治五淋。除水肿。癃闭。泻肺。（本经）解诸毒虫痛。（苏颂）明目退热。"}]},{"ID":"20240611140529-zbmtjyx","Type":"NodeParagraph","Properties":{"id":"20240611140529-zbmtjyx","updated":"20240611140529"},"Children":[{"Type":"NodeText","Data":"【归经】入肺胃二经。为利水退热之品。（兼轻剂入肺引热下行入胃通气上达）【前论】东垣曰。通草泻肺利小便。甘平以缓阴血也。与灯草同功。宜生用。佐番降香、红【禁忌】经疏曰。虚脱人。孕妇。均忌。"}]},{"ID":"20240611140518-eqzfuhp","Type":"NodeThematicBreak","Properties":{"id":"20240611140518-eqzfuhp"}},{"ID":"20240611140519-mfma7gr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140519-mfma7gr","updated":"20240611140523"},"Children":[{"Type":"NodeText","Data":"通草《本草择要纲目》"}]},{"ID":"20240611140519-uuv3acb","Type":"NodeParagraph","Properties":{"id":"20240611140519-uuv3acb","updated":"20240611140519"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611140519-q5lv56h","Type":"NodeParagraph","Properties":{"id":"20240611140519-q5lv56h","updated":"20240611140519"},"Children":[{"Type":"NodeText","Data":"甘淡寒无毒．阳中之阴．降也．"}]},{"ID":"20240611140519-49tj298","Type":"NodeParagraph","Properties":{"id":"20240611140519-49tj298","updated":"20240611140519"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611140519-33idc5e","Type":"NodeParagraph","Properties":{"id":"20240611140519-33idc5e","updated":"20240611140519"},"Children":[{"Type":"NodeText","Data":"色白而气寒．味淡而体轻．故入太阴肺经．引热下降而利小便．入阳明胃经．通气上达而下乳汁．"}]},{"ID":"20240611140355-sejvrws","Type":"NodeThematicBreak","Properties":{"id":"20240611140355-sejvrws"}},{"ID":"20240611140506-emcond5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140506-emcond5","updated":"20240611140513"},"Children":[{"Type":"NodeText","Data":"通草《本草从新》"}]},{"ID":"20240611140506-fc7zx52","Type":"NodeParagraph","Properties":{"id":"20240611140506-fc7zx52","updated":"20240611140506"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"古名通脱木．轻、通、利水退热．"}]},{"ID":"20240611140506-1df8u09","Type":"NodeParagraph","Properties":{"id":"20240611140506-1df8u09","updated":"20240611140506"},"Children":[{"Type":"NodeText","Data":"色白气寒．体轻味淡．气寒则降．故入肺经．引热下行而利小便．味淡则升．故入胃经．"}]},{"ID":"20240611140506-rajnv1l","Type":"NodeParagraph","Properties":{"id":"20240611140506-rajnv1l","updated":"20240611140506"},"Children":[{"Type":"NodeText","Data":"通气上达而下乳汁．治五淋水肿．目昏耳聋．鼻塞失音．（淡通窍、寒降火、利肺气．）退热催生．中寒者勿服．（百一选方、治洗头风痛、新通草瓦上烧存性、研末二钱、热酒下、牙关紧者、挖口灌之．）"}]},{"ID":"20240611140356-t7hkpvv","Type":"NodeThematicBreak","Properties":{"id":"20240611140356-t7hkpvv"}},{"ID":"20240611140411-wdyi7am","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140411-wdyi7am","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"《中国药典》：通草"}]},{"ID":"20240611140411-7p2c254","Type":"NodeParagraph","Properties":{"id":"20240611140411-7p2c254","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611140411-nexpvsl","Type":"NodeParagraph","Properties":{"id":"20240611140411-nexpvsl","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" Tōnɡ Cǎo"}]},{"ID":"20240611140411-71tz0kk","Type":"NodeParagraph","Properties":{"id":"20240611140411-71tz0kk","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611140411-vl28dm4","Type":"NodeParagraph","Properties":{"id":"20240611140411-vl28dm4","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 通花根、大通草、白通草、方通、泡通"}]},{"ID":"20240611140411-gg0gr6j","Type":"NodeParagraph","Properties":{"id":"20240611140411-gg0gr6j","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611140411-ydor42c","Type":"NodeParagraph","Properties":{"id":"20240611140411-ydor42c","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" MEDULLA TETRAPANACIS"}]},{"ID":"20240611140411-1bhycmf","Type":"NodeParagraph","Properties":{"id":"20240611140411-1bhycmf","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611140411-vn6w8pi","Type":"NodeParagraph","Properties":{"id":"20240611140411-vn6w8pi","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 本品为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通脱木"},{"Type":"NodeText","Data":"Tetrapanax papyriferus （Hook.）K. Koch 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎髓"},{"Type":"NodeText","Data":"。秋季割取茎，截成段，趁鲜取出髓部，理直，晒干。"}]},{"ID":"20240611140411-1wzi2k3","Type":"NodeParagraph","Properties":{"id":"20240611140411-1wzi2k3","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611140411-cd2levx","Type":"NodeParagraph","Properties":{"id":"20240611140411-cd2levx","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 本品呈圆柱形，长20～40cm，直径1～2.5cm。表面白色或淡黄色，有浅纵沟纹。体轻，质松软，稍有弹性，易折断，断面平坦，显银白色光泽，中部有直径0.3～1.5cm的空心或半透明的薄膜，纵剖面呈梯状排列，实心者少见。无臭，无味。"}]},{"ID":"20240611140411-8d37gav","Type":"NodeParagraph","Properties":{"id":"20240611140411-8d37gav","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611140411-vascino","Type":"NodeParagraph","Properties":{"id":"20240611140411-vascino","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240611140411-s9xtle3","Type":"NodeParagraph","Properties":{"id":"20240611140411-s9xtle3","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611140411-3v6dpo2","Type":"NodeParagraph","Properties":{"id":"20240611140411-3v6dpo2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 除去杂质，切厚片。"}]},{"ID":"20240611140411-9i4kpe6","Type":"NodeParagraph","Properties":{"id":"20240611140411-9i4kpe6","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611140411-zlt2l03","Type":"NodeParagraph","Properties":{"id":"20240611140411-zlt2l03","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 本品横切面：全部为薄壁细胞，椭圆形、类圆形或近多角形，外侧的细胞较小，纹孔明显，有的细胞含草酸钙簇晶，直径15～64μm 。"}]},{"ID":"20240611140411-yxil3b2","Type":"NodeParagraph","Properties":{"id":"20240611140411-yxil3b2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611140411-nlj5yha","Type":"NodeParagraph","Properties":{"id":"20240611140411-nlj5yha","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 归肺、胃经。"}]},{"ID":"20240611140411-14uu7j7","Type":"NodeParagraph","Properties":{"id":"20240611140411-14uu7j7","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611140411-dkea0a0","Type":"NodeParagraph","Properties":{"id":"20240611140411-dkea0a0","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 甘、淡，微寒。"}]},{"ID":"20240611140411-4jax7gm","Type":"NodeParagraph","Properties":{"id":"20240611140411-4jax7gm","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611140411-zaofmxc","Type":"NodeParagraph","Properties":{"id":"20240611140411-zaofmxc","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240611140411-4uuwmzr","Type":"NodeParagraph","Properties":{"id":"20240611140411-4uuwmzr","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611140411-loq4564","Type":"NodeParagraph","Properties":{"id":"20240611140411-loq4564","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 清热利尿，通气下乳。用于湿温尿赤，淋病涩痛，水肿尿少，乳汁不下。"}]},{"ID":"20240611140411-xytbc4p","Type":"NodeParagraph","Properties":{"id":"20240611140411-xytbc4p","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611140411-j97bu0r","Type":"NodeParagraph","Properties":{"id":"20240611140411-j97bu0r","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 3～5g。"}]},{"ID":"20240611140411-yn7r7qp","Type":"NodeParagraph","Properties":{"id":"20240611140411-yn7r7qp","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611140411-kgzwycv","Type":"NodeParagraph","Properties":{"id":"20240611140411-kgzwycv","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" （1）用于湿热内蕴，小便短赤或淋沥涩痛之症，但气味俱薄，作用缓弱，可配木通、滑石等同用；用治湿温病症，可配薏苡仁、蔻仁；竹叶等同用。用于乳汁稀少，可与猪蹄、穿山甲、川芎、甘草等煎汤服。"}]},{"ID":"20240611140411-mubp6kk","Type":"NodeParagraph","Properties":{"id":"20240611140411-mubp6kk","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611140411-qf6rgld","Type":"NodeParagraph","Properties":{"id":"20240611140411-qf6rgld","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611140411-8ibvajq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140411-8ibvajq","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：通草"}]},{"ID":"20240611140411-06i05oj","Type":"NodeParagraph","Properties":{"id":"20240611140411-06i05oj","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611140411-zpmo1jv","Type":"NodeParagraph","Properties":{"id":"20240611140411-zpmo1jv","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" Tōnɡ Cǎo"}]},{"ID":"20240611140411-5y0sqrf","Type":"NodeParagraph","Properties":{"id":"20240611140411-5y0sqrf","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611140411-ic28v2r","Type":"NodeParagraph","Properties":{"id":"20240611140411-ic28v2r","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 寇脱（《山海经》），离南、活菟、倚商（《尔雅》），葱草（《本草汇言》），白通草（《药性切用》），通花（《草木便方》），花草（《中国树木分类学》），大通草（《四川中药志》），通大海、泡通（《贵州民间方药集》），五加风、宽肠、大通塔、大木通、五角加皮、通花五加、大叶五加皮（《湖南药物志》）。"}]},{"ID":"20240611140411-piy7xm1","Type":"NodeParagraph","Properties":{"id":"20240611140411-piy7xm1","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611140411-zp5w18c","Type":"NodeParagraph","Properties":{"id":"20240611140411-zp5w18c","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 《本草拾遗》"}]},{"ID":"20240611140411-k4mi7w1","Type":"NodeParagraph","Properties":{"id":"20240611140411-k4mi7w1","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611140411-ee5as3q","Type":"NodeParagraph","Properties":{"id":"20240611140411-ee5as3q","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 为五加科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通脱木"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎髓"},{"Type":"NodeText","Data":"。秋季采收，选择生长2～3年的植株，割取地上茎，截成段，趁鲜时取出茎髓，理直，晒干。放置干燥处。将茎髓加工制成的方形薄片，称为\"方通草\"；加工时修切下来的边条，称为\"丝通草\"。"}]},{"ID":"20240611140411-i8pp2s6","Type":"NodeParagraph","Properties":{"id":"20240611140411-i8pp2s6","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611140411-6gc3svr","Type":"NodeParagraph","Properties":{"id":"20240611140411-6gc3svr","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 分布福建、台湾、广西、湖南、湖北、云南、贵州、四川等地。"}]},{"ID":"20240611140411-4710lsk","Type":"NodeParagraph","Properties":{"id":"20240611140411-4710lsk","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611140411-iz903fk","Type":"NodeParagraph","Properties":{"id":"20240611140411-iz903fk","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 通脱木（《本草拾遗》）"}]},{"ID":"20240611140411-2zdum7k","Type":"NodeParagraph","Properties":{"id":"20240611140411-2zdum7k","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"灌木，高可达6米。茎木质而不坚，中有白色的髓，幼时呈片状，老则渐次充实，幼枝密被星状毛，或稍具脱落性灰黄色绒毛。叶大、通常聚生于茎的上部.掌状分裂，长可达1米，基部心脏形，叶片5～7裂，裂片达于中部或仅为边裂，头锐尖，边缘有细锯齿，上面无毛，下面有白色星状绒毛；叶柄粗壮，长30～50厘米；托叶2，大形，膜质，披针状凿形，基部鞘状抱茎。花小，有柄，多数球状伞形花序排列成大圆锥花丛；苞片披针形；萼不明显；花瓣4，白色，卵形，头锐尖；雄蕊4；花盘微凸；子房下位，2室，花柱2，离生，柱头头状。核果状浆果近球形而扁，外果皮肉质，硬而脆。花期8月。果期9月。"}]},{"ID":"20240611140411-5xzl66e","Type":"NodeParagraph","Properties":{"id":"20240611140411-5xzl66e","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"本植物的根（通花根）、花蕾（通花花）、花粉（通脱木花上粉）亦供药用，各详专条。"}]},{"ID":"20240611140411-dogls4u","Type":"NodeParagraph","Properties":{"id":"20240611140411-dogls4u","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611140411-76c7mjx","Type":"NodeParagraph","Properties":{"id":"20240611140411-76c7mjx","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 干燥茎髓呈圆柱形，一般长0.3～0.6米，直径1.2～3厘米。洁白色，有浅纵沟纹。体轻，质柔软，有弹性，易折断，断面平坦，中部有直径0.5～1.5厘米的空心或白色半透明的薄膜，外圈银白色，纵剖之见有层层隔膜，无臭无味。以色洁白、心空、有弹性者为佳。"}]},{"ID":"20240611140411-fumc9fa","Type":"NodeParagraph","Properties":{"id":"20240611140411-fumc9fa","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"产贵州、云南、台湾、广西、四川等地。"}]},{"ID":"20240611140411-4sv17ia","Type":"NodeParagraph","Properties":{"id":"20240611140411-4sv17ia","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"方通草：呈方形的薄片，微透明、平滑、洁白、似纸质而轻软。丝通草：为不整齐之细长条片。"}]},{"ID":"20240611140411-s95sfeb","Type":"NodeParagraph","Properties":{"id":"20240611140411-s95sfeb","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611140411-pbb1mba","Type":"NodeParagraph","Properties":{"id":"20240611140411-pbb1mba","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 含灰分5.95％、脂肪1.07％、蛋白质1.11％、粗纤维48.73％、戊聚糖5.83％。尚含糖醛酸28.04％，其一部分存在于聚β-D-半乳糖醛酸（这种多糖溶于草酸铵溶液）。另含溶于入NaOH溶液的多糖，其水解产物中含半乳糖醛酸、半乳糖、葡萄糖和木糖。"}]},{"ID":"20240611140411-0tjtjnl","Type":"NodeParagraph","Properties":{"id":"20240611140411-0tjtjnl","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611140411-121airx","Type":"NodeParagraph","Properties":{"id":"20240611140411-121airx","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 通草：拣去杂质，切片。朱通草：取通草片，置盆内喷水少许，微润，加朱砂细粉，撒布均匀，并随时翻动，至外面挂匀朱砂为度，取出，晾干。（每通草片10斤，用朱砂10两）"}]},{"ID":"20240611140411-bq2bi2a","Type":"NodeParagraph","Properties":{"id":"20240611140411-bq2bi2a","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611140411-r09l04x","Type":"NodeParagraph","Properties":{"id":"20240611140411-r09l04x","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 入肺、胃经。"}]},{"ID":"20240611140411-2v6u1vn","Type":"NodeParagraph","Properties":{"id":"20240611140411-2v6u1vn","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"入太阴肺、阳明胃经。\""}]},{"ID":"20240611140411-02fjz10","Type":"NodeParagraph","Properties":{"id":"20240611140411-02fjz10","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺，大、小肠三经。\""}]},{"ID":"20240611140411-557ge7s","Type":"NodeParagraph","Properties":{"id":"20240611140411-557ge7s","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入足少阴、太阳，手少阴、太阳。\""}]},{"ID":"20240611140411-pocdpzx","Type":"NodeParagraph","Properties":{"id":"20240611140411-pocdpzx","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611140411-1vykuww","Type":"NodeParagraph","Properties":{"id":"20240611140411-1vykuww","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 甘淡，凉。"}]},{"ID":"20240611140411-2tdjp35","Type":"NodeParagraph","Properties":{"id":"20240611140411-2tdjp35","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"①《本草拾遗》：\"无毒。\""}]},{"ID":"20240611140411-l9k3h8h","Type":"NodeParagraph","Properties":{"id":"20240611140411-l9k3h8h","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"②《医学启源》：\"气平，味甘。\""}]},{"ID":"20240611140411-hfnsael","Type":"NodeParagraph","Properties":{"id":"20240611140411-hfnsael","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"③《本草蒙筌》：\"味甘淡，气平。\""}]},{"ID":"20240611140411-mnwixw3","Type":"NodeParagraph","Properties":{"id":"20240611140411-mnwixw3","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"甘淡，寒，无毒。\""}]},{"ID":"20240611140411-wv9l382","Type":"NodeParagraph","Properties":{"id":"20240611140411-wv9l382","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611140411-dmvx0my","Type":"NodeParagraph","Properties":{"id":"20240611140411-dmvx0my","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 气阴两虚，内无湿热及孕妇慎服。"}]},{"ID":"20240611140411-u6cy5pa","Type":"NodeParagraph","Properties":{"id":"20240611140411-u6cy5pa","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"虚脱人禁用，孕妇人勿服。\""}]},{"ID":"20240611140411-o8ngfn9","Type":"NodeParagraph","Properties":{"id":"20240611140411-o8ngfn9","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"阴阳两虚者禁用。\""}]},{"ID":"20240611140411-wg8cmfm","Type":"NodeParagraph","Properties":{"id":"20240611140411-wg8cmfm","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"中寒者勿服。\""}]},{"ID":"20240611140411-b2zmlv2","Type":"NodeParagraph","Properties":{"id":"20240611140411-b2zmlv2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611140411-it4mnek","Type":"NodeParagraph","Properties":{"id":"20240611140411-it4mnek","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 泻肺，利小便，下乳汁。治小便不利，淋病，水肿，产妇乳汁不通，目昏，鼻塞。"}]},{"ID":"20240611140411-wkzd5vm","Type":"NodeParagraph","Properties":{"id":"20240611140411-wkzd5vm","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"明目，退热，催生，下胞，下乳。\""}]},{"ID":"20240611140411-r2l0em9","Type":"NodeParagraph","Properties":{"id":"20240611140411-r2l0em9","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"利小便，兼解诸药毒。\""}]},{"ID":"20240611140411-kd908cn","Type":"NodeParagraph","Properties":{"id":"20240611140411-kd908cn","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"③《医学启源》：\"除水肿癃闭，治五淋。《主治秘诀》云，泻肺。\""}]},{"ID":"20240611140411-w0tsluh","Type":"NodeParagraph","Properties":{"id":"20240611140411-w0tsluh","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"④《本草缶要》：\"治目昏耳聋，鼻塞失音。\""}]},{"ID":"20240611140411-6rjub3x","Type":"NodeParagraph","Properties":{"id":"20240611140411-6rjub3x","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"⑤《长沙药解》：\"通经闭，疗黄疸，消痈疽，利鼻痈，除心烦。\""}]},{"ID":"20240611140411-6xigkg6","Type":"NodeParagraph","Properties":{"id":"20240611140411-6xigkg6","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611140411-85tyaji","Type":"NodeParagraph","Properties":{"id":"20240611140411-85tyaji","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1.5钱；或入丸、散。外用：研末绵裹塞鼻。"}]},{"ID":"20240611140411-ql9u7va","Type":"NodeParagraph","Properties":{"id":"20240611140411-ql9u7va","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611140411-0bz16k4","Type":"NodeParagraph","Properties":{"id":"20240611140411-0bz16k4","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" ①治热气淋涩，小便亦如红花汁者：通草三两，葵子一升，滑石四两（碎），石苇二两。上切，以水六升，煎取二升，去滓，分温三服；如人行八、九里，又进一服。忌食五腥、热面、炙煿等物。（《普济方》通草饮子）"}]},{"ID":"20240611140411-83syi9n","Type":"NodeParagraph","Properties":{"id":"20240611140411-83syi9n","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"②治一身黄肿透明。亦治肾肿：通草（蜜涂炙干）、木猪苓（去里皮）各等分。上为细末，并入研细去土地龙、麝香少许。每服半钱或一钱，米饮调下。（《小儿卫生总微论方》通草散）"}]},{"ID":"20240611140411-ejs98mz","Type":"NodeParagraph","Properties":{"id":"20240611140411-ejs98mz","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"③治伤寒后呕哕：通草三两，生芦根（切）一升，橘皮一两，粳米三合。上四味，以水五升煮，取二升随便稍饮；不差，更作，取差止。（《千金方》）"}]},{"ID":"20240611140411-ytzu9xr","Type":"NodeParagraph","Properties":{"id":"20240611140411-ytzu9xr","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"④治鼻痈，气息不通，不闻香臭，并有息肉：木通、细辛、附子（炮，去皮、脐）各等分。上为末，蜜和。绵裹少许，纳鼻中。（《三因方》通草散）"}]},{"ID":"20240611140411-cw7aj62","Type":"NodeParagraph","Properties":{"id":"20240611140411-cw7aj62","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"⑤催乳：通脱木、小人参，炖猪脚食。（《湖南药物志》）"}]},{"ID":"20240611140411-xvz9kcw","Type":"NodeParagraph","Properties":{"id":"20240611140411-xvz9kcw","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611140411-165gv60","Type":"NodeParagraph","Properties":{"id":"20240611140411-165gv60","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" ①李杲：\"通草泻肺利小便，甘平以缓阴血电，与灯草同功，宜生用之。\""}]},{"ID":"20240611140411-jikt1tp","Type":"NodeParagraph","Properties":{"id":"20240611140411-jikt1tp","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"通草，色白而气寒，味淡而体轻，故入太阴肺经，引热下降而利小便；入阳明胃经，通气上达而下乳汁；其气寒，降也，其味淡，升也。\""}]},{"ID":"20240611140411-cu4xhwe","Type":"NodeParagraph","Properties":{"id":"20240611140411-cu4xhwe","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"③《本草正义》：\"通草，其气味则李东垣《用药法象》谓甘淡无毒。案此甘字，非大甜之谓，实即淡字，如泉水、食米皆谓味甘之例。此物无气无味，以淡用事，故能通行经络，清热利水，性与木通相似，但无其苦，则泄降之力缓而无峻厉之弊，虽能通利，不甚伤阴，湿热之不甚者宜之。若热甚闭结之症，必不能及木通之捷效，东垣谓利阴窍，治五淋，除水肿癃，亦惟轻症乃能有功耳。又谓泻肺利小便，与灯草同功，盖皆色白而气味轻清，所以亦能上行，泄肺之热闭，宣其上窍，则下窍自利，说亦可取。\""}]},{"ID":"20240611140411-f46qrs3","Type":"NodeParagraph","Properties":{"id":"20240611140411-f46qrs3","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611140411-pghrwdl","Type":"NodeParagraph","Properties":{"id":"20240611140411-pghrwdl","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 药材小通草为旌节花科植物喜马拉雅旌节花等的茎髓，亦作通草使用，参见\"小通草\"条。"}]},{"ID":"20240611140411-s72mttr","Type":"NodeParagraph","Properties":{"id":"20240611140411-s72mttr","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611140411-8pj78fh","Type":"NodeParagraph","Properties":{"id":"20240611140411-8pj78fh","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611140411-67c4ltc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611140411-67c4ltc","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"《中华本草》：通草"}]},{"ID":"20240611140411-zprdmpa","Type":"NodeParagraph","Properties":{"id":"20240611140411-zprdmpa","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611140411-fykaqma","Type":"NodeParagraph","Properties":{"id":"20240611140411-fykaqma","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" Tōnɡ Cǎo"}]},{"ID":"20240611140411-qq7a8jk","Type":"NodeParagraph","Properties":{"id":"20240611140411-qq7a8jk","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611140411-xxb2i5w","Type":"NodeParagraph","Properties":{"id":"20240611140411-xxb2i5w","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 寇脱、离南、活莌、倚商、通脱木、葱草、白通草、通花、花草、大通草、通大海、泡通、五加风、宽肠、大通塔、大木通、五角加皮、通花五加、大叶五加皮"}]},{"ID":"20240611140411-yljeqlx","Type":"NodeParagraph","Properties":{"id":"20240611140411-yljeqlx","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611140411-kd6d9fv","Type":"NodeParagraph","Properties":{"id":"20240611140411-kd6d9fv","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" Ricepaperplant Pith"}]},{"ID":"20240611140411-6s44jx7","Type":"NodeParagraph","Properties":{"id":"20240611140411-6s44jx7","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611140411-ycfhqn6","Type":"NodeParagraph","Properties":{"id":"20240611140411-ycfhqn6","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 出自《本草纲目拾遗》。"}]},{"ID":"20240611140411-cp2dm3x","Type":"NodeParagraph","Properties":{"id":"20240611140411-cp2dm3x","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"1.《本草拾遗》：通脱木，生山侧。叶似萆麻，心中有瓤，轻白可爱，女工取以饰物。《尔雅》云离南、活脱也。一本云药草，生江南，主虫病，今俗亦名通草。"}]},{"ID":"20240611140411-5fo870q","Type":"NodeParagraph","Properties":{"id":"20240611140411-5fo870q","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：俗间所谓通草，乃通脱木也，今园圃间亦有种两者。古方所用通草，皆今之木通，通脱稀有使用者。近世医家多用利小便，南人或以蜜煎作果，食之甚美。"}]},{"ID":"20240611140411-4n22c2e","Type":"NodeParagraph","Properties":{"id":"20240611140411-4n22c2e","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611140411-nyklhus","Type":"NodeParagraph","Properties":{"id":"20240611140411-nyklhus","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 药材基源：为五加科植物通脱木的茎贿。"}]},{"ID":"20240611140411-ura7380","Type":"NodeParagraph","Properties":{"id":"20240611140411-ura7380","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Tetrapanax papyriferus (Hook.) K. Koch[Aralia papyrifera Hook.f.]"}]},{"ID":"20240611140411-99txmxj","Type":"NodeParagraph","Properties":{"id":"20240611140411-99txmxj","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季选择生长3年以上的植株，割取地上茎，切段，捅出贿心，理直，晒干。"}]},{"ID":"20240611140411-c3mjzk2","Type":"NodeParagraph","Properties":{"id":"20240611140411-c3mjzk2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611140411-68b9o6m","Type":"NodeParagraph","Properties":{"id":"20240611140411-68b9o6m","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔数10-2800m的向阳肥厚的土壤中，或栽培于庭园中。或栽培于庭圆中。"}]},{"ID":"20240611140411-2ggr4qy","Type":"NodeParagraph","Properties":{"id":"20240611140411-2ggr4qy","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及陕西、江苏、安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西等地。"}]},{"ID":"20240611140411-cebpzzq","Type":"NodeParagraph","Properties":{"id":"20240611140411-cebpzzq","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611140411-q3obuvo","Type":"NodeParagraph","Properties":{"id":"20240611140411-q3obuvo","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 常绿灌木或小乔木，高1-3.5m。茎粗壮，不分枝，幼稚时表面密被黄色星状毛或稍具脱落的灰黄色柔毛。茎贿大，白色，纸质；树皮深棕色，略有皱裂；新枝淡棕色或淡黄棕色，有明显的叶痕和大型皮孔。叶大，互生，聚生于茎顶；叶柄粗壮，圆筒形，长30-50cm；托叶膜质，锥形，基部与叶柄合生，有星状厚绒毛；叶片纸质或薄革质，掌状5-11裂，裂片通常为叶片全长的1/3-1/2，稀至2/3，倒卵状长圆形卵状长圆形，每一裂片常又有2-3个小裂片，全缘或有粗齿，上面深绿以，无毛，下面密被白色星状绒毛。伞形花序聚生成顶生或近顶生大型复圆锥花序，长达50cm以上；萼密被星状绒色，全缘或近全缘；花瓣4，稀4，三角状卵形，长2mm，外面密被星状厚绒毛；雄蕊5，与花瓣同数；子房下位，2室，花柱2，离生，先端反曲。果球形，趱戏约4mm，熟时紫黑色。花期10-12月，果期翌年1-2月。"}]},{"ID":"20240611140411-xearph0","Type":"NodeParagraph","Properties":{"id":"20240611140411-xearph0","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611140411-9y6p05o","Type":"NodeParagraph","Properties":{"id":"20240611140411-9y6p05o","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润而又有阳光照射的环境，不甚耐寒，越冬温度在5℃以上。适于肥沃的砂质壤土栽培。"}]},{"ID":"20240611140411-wuoddvy","Type":"NodeParagraph","Properties":{"id":"20240611140411-wuoddvy","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"栽培技术 用播种、扦插或早春根插，早春用种子育苗。通脱木的地下茎萌发力很强，冬季挖伤部分地下茎，刺激第2年生出新苗，到第3年早春萌芽前移栽这些新苗，按行株距各1.3m定植。"}]},{"ID":"20240611140411-8cfrudb","Type":"NodeParagraph","Properties":{"id":"20240611140411-8cfrudb","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611140411-k2zadyr","Type":"NodeParagraph","Properties":{"id":"20240611140411-k2zadyr","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 茎贿呈圆柱形，长20-40cm，直径1-2.5c,。表面白色或淡黄色，有浅纵沟纹。体轻，质松软，稍有弹性，易折断，断面平坦，显银白色光泽，中内有直径0.3-1.5cm的空心或半透明的薄膜，纵剖面呈梯状排列，实心者（仅在细小茎贿中的某小段）少见。无臭，无味。"}]},{"ID":"20240611140411-8na33mm","Type":"NodeParagraph","Properties":{"id":"20240611140411-8na33mm","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"以条粗壮、色洁白、有弹性、空心有隔膜者为佳。"}]},{"ID":"20240611140411-82uwf90","Type":"NodeParagraph","Properties":{"id":"20240611140411-82uwf90","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎髓横切面：全部为薄壁细胞，椭圆形、类圆形或近多角形，壁薄，偶见壁孔，外侧的细胞较小，壁薄，偶邮壁孔，外侧的细胞较小，有的细胞含草酸钙簇晶，直径15-64μm。"}]},{"ID":"20240611140411-1iz73lr","Type":"NodeParagraph","Properties":{"id":"20240611140411-1iz73lr","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611140411-l186ua1","Type":"NodeParagraph","Properties":{"id":"20240611140411-l186ua1","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 木髓中含灰分5.95%，脂肪1.07%，蛋白质1.11%，粗纤维48.73%，戊聚糖5%及糖醛酸28.04%，其多糖的氢氧化钠提取物经水解得到α-半乳糖（galactose)，葡萄糖（glucose)与木糖（xylose)，而用草酸铵提取的提取物水解后则得到半乳糖醛酸[1]；还含天冬氨酸、苏氨酸、侣氨酸、苯丙氨酸等13种氨基酸以及钙、钡、镁、铁等18种微量元素[2]；木部含木质素[3]。"}]},{"ID":"20240611140411-q81n6cf","Type":"NodeParagraph","Properties":{"id":"20240611140411-q81n6cf","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"叶含通脱木皂甙L-Ⅱa、L-Ⅱb、L-Ⅱc、L-Ⅱd(papyrioside L-Ⅱa、L-Ⅱb、L-Ⅱc、L-Ⅱd），其中L-Ⅱa是L-Ⅱc的后生产物，而L-Ⅱb也可能是L-Ⅱd的后生产物[4]，还含通脱木皂甙元A-J（paryriogenin A-J)，及原通脱木皂甙元A1、A2（propapyriogenin A1、A2)和槲皮甙（quercitrin)[5，6]。"}]},{"ID":"20240611140411-1uu3qcy","Type":"NodeParagraph","Properties":{"id":"20240611140411-1uu3qcy","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611140411-sxqo33q","Type":"NodeParagraph","Properties":{"id":"20240611140411-sxqo33q","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 用代谢笼法，给大鼠灌胃，给予药剂量均为4g-kg，观察7个品种通草对尿量及尿氮、尿钠、尿钾排出量的影响，结果表明通脱木、盘叶柏那参、青荚叶、棣棠花有明显的利尿效果，其中通脱木作用最强，罗伞、云南乡球、喜马山旌节花利尿作用不明显。通脱木等4种通草能明显增加大鼠尿中钾离子的排出，而对尿钠、尿氯无明显影响，故认为通草利尿与排钾有关[1]。"}]},{"ID":"20240611140411-tejj3rl","Type":"NodeParagraph","Properties":{"id":"20240611140411-tejj3rl","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611140411-fi3mih4","Type":"NodeParagraph","Properties":{"id":"20240611140411-fi3mih4","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 通草：拣去杂质，切片。朱通草：取通草片，置盆内喷水少许，微润，加朱砂细粉，撒布均匀，并随时翻动，至外面挂匀朱砂为度，取出，晾干。(每通草片10斤，用朱砂10两)"}]},{"ID":"20240611140411-spwge81","Type":"NodeParagraph","Properties":{"id":"20240611140411-spwge81","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611140411-xypco30","Type":"NodeParagraph","Properties":{"id":"20240611140411-xypco30","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 归肺；胃经"}]},{"ID":"20240611140411-h69a71r","Type":"NodeParagraph","Properties":{"id":"20240611140411-h69a71r","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611140411-8yvr4lx","Type":"NodeParagraph","Properties":{"id":"20240611140411-8yvr4lx","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 味甘；淡；性微寒"}]},{"ID":"20240611140411-rpb5ybl","Type":"NodeParagraph","Properties":{"id":"20240611140411-rpb5ybl","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611140411-vzoh5x6","Type":"NodeParagraph","Properties":{"id":"20240611140411-vzoh5x6","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 气阴两虚，内无湿热及孕妇慎服。"}]},{"ID":"20240611140411-lg98mn7","Type":"NodeParagraph","Properties":{"id":"20240611140411-lg98mn7","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"1.《本草经疏》：虚脱入禁用，孕妇人勿服。"}]},{"ID":"20240611140411-xwd0d8a","Type":"NodeParagraph","Properties":{"id":"20240611140411-xwd0d8a","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"2.《本草汇言》：阴阳两虚者禁用。"}]},{"ID":"20240611140411-39mv9t2","Type":"NodeParagraph","Properties":{"id":"20240611140411-39mv9t2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：中寒者勿服。"}]},{"ID":"20240611140411-z5pai4b","Type":"NodeParagraph","Properties":{"id":"20240611140411-z5pai4b","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611140411-akojs1z","Type":"NodeParagraph","Properties":{"id":"20240611140411-akojs1z","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 清势利水；通乳。主淋症涩痛；小便不利；水肿；黄疸；湿温病；小便短赤；产后乳少；经闭；带下"}]},{"ID":"20240611140411-15yfplu","Type":"NodeParagraph","Properties":{"id":"20240611140411-15yfplu","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611140411-fsehb4f","Type":"NodeParagraph","Properties":{"id":"20240611140411-fsehb4f","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2-5g。"}]},{"ID":"20240611140411-pt4yeon","Type":"NodeParagraph","Properties":{"id":"20240611140411-pt4yeon","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611140411-k7rlnlo","Type":"NodeParagraph","Properties":{"id":"20240611140411-k7rlnlo","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" ①治热气淋涩，小便赤如红花汁者：通草三两，葵子一升，滑石四两(碎)，石苇二两。上调，以水六升，煎取二升，去滓，分温三服；如人行八、九里，又进一服。忌食五腥、热面、炙煿等物。(《普济万》通草饮子)②治一身黄肿透明。亦治肾肿： 通草(蜜涂炙干)、木猪草(去里皮)各等分。上为细末，并入研细去土地龙、麝香少许。每服半钱或一钱，米饮调下。(《小儿卫生总微论方》通草散)③治伤寒后呕哕： 通草三两，生芦根(切)一升，橘皮一两，粳米三合。上四味，以水五升煮，取二升随便稍饮；不差，更作，取差止。(《千金方》)④治鼻痈，气息不通，不闻香臭，并有息肉： 木通、细辛、附子(炮，去皮、脐)各等分。上为末，蜜和。绵裹少许，纳鼻中。 (《三因方》通草散)⑤催乳： 通脱木、小人参，炖猪脚食。 (《湖南药物志》)"}]},{"ID":"20240611140411-k7e3u9s","Type":"NodeParagraph","Properties":{"id":"20240611140411-k7e3u9s","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611140411-1oaoptm","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611140411-1oaoptm","updated":"20240611140411"},"Children":[{"ID":"20240611140411-ayd0di2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611140411-ayd0di2","updated":"20240611140411"},"Children":[{"ID":"20240611140411-8ops8p4","Type":"NodeParagraph","Properties":{"id":"20240611140411-8ops8p4","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"李杲：通草泻肺利小便，甘平以缓阴血也，与灯草同功，宜生用之。"}]}]}]},{"ID":"20240611140411-rdvl24e","Type":"NodeParagraph","Properties":{"id":"20240611140411-rdvl24e","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"2.《纲目》： 通草，色白而气寒，味淡而体轻，故入太阴肺经，引热下降而利小便；入阳明胃经，通气上达而下乳汁；其气寒，降也，其味淡，开也。"}]},{"ID":"20240611140411-ssomap5","Type":"NodeParagraph","Properties":{"id":"20240611140411-ssomap5","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"3.《本草正义》： 通草，其气味则李东垣《用药法象》谓甘淡无毒。案此甘字，非大甜之谓，实即淡字，如泉水、食米皆谓味甘之例。此物无气无味，以淡用事，故能通行经络，清热利水，性与木通相似，但无其苫，则泄降之力缓而无峻厉之弊，虽能通利，不甚伤阴，湿热之不甚者宜之。若热甚闭结之症，必不能及木通之捷效，东垣谓利阴窍，治五淋，除水肿癃，亦惟轻症乃能有功耳。又谓泻肺利小便，与灯草同功，盖皆色白而气味轻清，所以亦能上行，泄肺之热切，宣其上窍，则下窍自利，说亦可取。"}]},{"ID":"20240611140411-0emm1s2","Type":"NodeParagraph","Properties":{"id":"20240611140411-0emm1s2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611140411-9x6jzh2","Type":"NodeParagraph","Properties":{"id":"20240611140411-9x6jzh2","updated":"20240611140411"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611140412-xjmyau6","Type":"NodeThematicBreak","Properties":{"id":"20240611140412-xjmyau6"}},{"ID":"20240611140413-lc8ffva","Type":"NodeParagraph","Properties":{"id":"20240611140413-lc8ffva"}}]}