:"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 845px;","style":"width: 835px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦-20240822174052-1kgn871.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 835px;\" parent-style=\"width: 845px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822175158-n2jc9qy","Type":"NodeParagraph","Properties":{"id":"20240822175158-n2jc9qy","updated":"20240822175304"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 458px;","style":"width: 448px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦 4-20240822175226-bhno48b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 448px;\" parent-style=\"width: 458px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 781px;","style":"width: 771px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦2-20240628130421-f39snkw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 771px;\" parent-style=\"width: 781px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822174953-s5my94h","Type":"NodeParagraph","Properties":{"id":"20240822174953-s5my94h","updated":"20240822175134"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 413px;","style":"width: 403px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦 1-20240822174953-efh7txe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 403px;\" parent-style=\"width: 413px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦 2-20240822175047-s1sagm6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦 3-20240822175134-00slbrp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 393px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822173928-kn36nog","Type":"NodeParagraph","Properties":{"id":"20240822173928-kn36nog","updated":"20240822173928"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 431px;","style":"width: 421px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦8-20240628131134-q659bz2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 421px;\" parent-style=\"width: 431px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 832px;","style":"width: 822px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"藜芦9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/藜芦9-20240628131318-dt0v4ld.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 822px;\" parent-style=\"width: 832px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612192753-xiauwgm","Type":"NodeParagraph","Properties":{"id":"20240612192753-xiauwgm","updated":"20240822175239"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：除痰药有很多，倪师称这个药能够清除血脉神经里的痰；"}]},{"ID":"20240822174827-c29fvw7","Type":"NodeThematicBreak","Properties":{"id":"20240822174827-c29fvw7"}},{"ID":"20240612193147-o0i6rgh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193147-o0i6rgh","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"藜芦《神农本草经》"}]},{"ID":"20240612193147-qv8fjgg","Type":"NodeParagraph","Properties":{"id":"20240612193147-qv8fjgg","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"（《御览》作梨芦）"}]},{"ID":"20240612193147-epfre7q","Type":"NodeParagraph","Properties":{"id":"20240612193147-epfre7q","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"味辛寒。"}]},{"ID":"20240612193147-79yykx9","Type":"NodeParagraph","Properties":{"id":"20240612193147-79yykx9","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"主蛊毒，咳逆，泄利，肠澼，头疡，疥搔，恶创，杀诸蛊毒，去死肌。一名葱苒。生山谷。"}]},{"ID":"20240612193147-fxvwhq3","Type":"NodeParagraph","Properties":{"id":"20240612193147-fxvwhq3","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：藜芦，一名葱葵，一名丰芦，一名蕙葵（《御览》引云，一名山葱，一名公苒），神农雷公辛有毒（《御览》引云：玄黄帝有毒），岐伯咸有毒，李氏太寒，大毒，扁鹊苦有毒，大寒，叶根小相连（《御览》引云：二月采根）。"}]},{"ID":"20240612193147-zvcbtvj","Type":"NodeParagraph","Properties":{"id":"20240612193147-zvcbtvj","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名葱菼，一名山葱，生太山，三月采根，阴干。"}]},{"ID":"20240612193147-k5x5yi1","Type":"NodeParagraph","Properties":{"id":"20240612193147-k5x5yi1","updated":"20240612193147"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：藜芦，葱（上艹下左日右冉）也。《范子计然》云：藜芦出河东，黄白者善。《尔雅》云：茖，山葱，疑非此。"}]},{"ID":"20240612193147-xouu4jf","Type":"NodeThematicBreak","Properties":{"id":"20240612193147-xouu4jf","updated":"20240612193147"}},{"ID":"20240612192906-pldatf2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192906-pldatf2","updated":"20240612193145"},"Children":[{"Type":"NodeText","Data":"藜芦《本草经集注》"}]},{"ID":"20240612192906-dzzixmc","Type":"NodeParagraph","Properties":{"id":"20240612192906-dzzixmc","updated":"20240612192906"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，有毒。主治蛊毒，咳逆，泄痢，肠 ，头疡，疥瘙，恶疮，杀诸虫毒，去死肌。治哕逆，喉痹不通，鼻中息肉，马刀，烂疮。不入汤。一名葱苒，一名葱 ，一名山葱。生太山山谷。三月采根。阴干。（黄连为之使，反细辛、芍药、五参，恶大近道处处有。本下极似葱而多毛。用之只剔取根，微炙之。"}]},{"ID":"20240612192912-uzc9dyz","Type":"NodeThematicBreak","Properties":{"id":"20240612192912-uzc9dyz"}},{"ID":"20240612192921-z0cfnj3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192921-z0cfnj3","updated":"20240612192928"},"Children":[{"Type":"NodeText","Data":"藜芦《本草述钩元》"}]},{"ID":"20240612192921-yu0m57q","Type":"NodeParagraph","Properties":{"id":"20240612192921-yu0m57q","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"黎黑色。其芦有黑皮裹之。故名。根际似葱。（犹葱之有须）俗名葱管藜芦。北人谓之须味辛苦。气寒。有毒。入手太阴足阳明经。黄连为之使。反细辛芍药人参沙参紫参丹参苦亦热生。其一二年饥。采约一二斗。汗出如洗。甚昏困。三日憨葱苗。即本草藜芦也。（子和）中一齿。浓煎藜芦汤灌之。少顷噫气。"}]},{"ID":"20240612192921-xcmhwo5","Type":"NodeParagraph","Properties":{"id":"20240612192921-xcmhwo5","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"如曳锯。口流涎沫。用葱管藜芦二两。"}]},{"ID":"20240612192921-4cdb8vt","Type":"NodeParagraph","Properties":{"id":"20240612192921-4cdb8vt","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"淬数次。滤净。将雄猪胆十个取汁。"}]},{"ID":"20240612192921-e8tmlpe","Type":"NodeParagraph","Properties":{"id":"20240612192921-e8tmlpe","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"分。装瓷罐内。黄蜡封口。每用黄豆大一若牙关紧闭。将口挖开。其痰得出。任熬黄研末。蜜丸小豆大。每空心服一丸。未发时结聚如骇。骇不去者。巴豆半两。去皮心炒。捣每吞一二丸。按藜芦用专于吐。而巴豆畏藜芦。后二方猛吐与峻下者。合而入胃。驱痰逐结。"}]},{"ID":"20240612192921-i0o0249","Type":"NodeParagraph","Properties":{"id":"20240612192921-i0o0249","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"使上下之壅为末〔论〕藜芦气寒。味辛而苦。发散涌泄。专主吐越风痰。盖风木以水为母。火为子。"}]},{"ID":"20240612192921-8u4y8oe","Type":"NodeParagraph","Properties":{"id":"20240612192921-8u4y8oe","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"寒者于下风甚气而大畅子气。俾风邪之壅而不下者。义取从治以上越之。要非其苦至极。则亦不能取效于俄顷。而几其必吐也。观其夏生冬凋。水生者便不入药。可以思其炎上之性矣。"}]},{"ID":"20240612192921-mobz077","Type":"NodeParagraph","Properties":{"id":"20240612192921-mobz077","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"服一匕。则令人胸中烦闷。吐逆不止。凡有痰饮。或中蛊毒恶气者。借其空吐上涌之力。"}]},{"ID":"20240612192921-xvjqee8","Type":"NodeParagraph","Properties":{"id":"20240612192921-xvjqee8","updated":"20240612192921"},"Children":[{"Type":"NodeText","Data":"获〔修治〕去芦头。止剔取根。糯米泔浸一宿。微炒用。不入汤药。"}]},{"ID":"20240612192922-8hgl6eo","Type":"NodeThematicBreak","Properties":{"id":"20240612192922-8hgl6eo"}},{"ID":"20240612192933-epjqolp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192933-epjqolp","updated":"20240612192938"},"Children":[{"Type":"NodeText","Data":"藜芦《本草备要》"}]},{"ID":"20240612192933-3fj2akl","Type":"NodeParagraph","Properties":{"id":"20240612192933-3fj2akl","updated":"20240612192933"},"Children":[{"Type":"NodeText","Data":"宣，引吐"}]},{"ID":"20240612192933-qm0vqa1","Type":"NodeParagraph","Properties":{"id":"20240612192933-qm0vqa1","updated":"20240612192933"},"Children":[{"Type":"NodeText","Data":"辛寒至苦，有毒。"}]},{"ID":"20240612192933-lexmh6t","Type":"NodeParagraph","Properties":{"id":"20240612192933-lexmh6t","updated":"20240612192933"},"Children":[{"Type":"NodeText","Data":"入口即吐，善通顶，令人嚏，风痫证多用之（张子和曰∶一妇病风痫，初一、二年一作，后渐日作，甚至一日数作，求死而已。值岁大饥，采百草食，见野草若葱，采蒸饱食，觉不安，吐胶涎数日，约一二斗，汗出如洗，甚昏困，后遂轻健如常人。以所食葱访人，乃憨葱苗，即藜芦是矣。时珍曰∶和王妃年七十，中风不省，牙关紧闭。先考太医吏目月池翁诊视，药不得入。不获已，打去一齿，浓煎藜芦汤灌之，少顷噫气，遂吐痰而苏。药不瞑眩，厥疾不瘳，诚然）。"}]},{"ID":"20240612192933-3affyht","Type":"NodeParagraph","Properties":{"id":"20240612192933-3affyht","updated":"20240612192933"},"Children":[{"Type":"NodeText","Data":"取根去头。用黄连为使。反细辛、芍药、诸参。恶大黄。畏葱白（吐者、服葱汤即止）。"}]},{"ID":"20240612192942-eflazu2","Type":"NodeThematicBreak","Properties":{"id":"20240612192942-eflazu2"}},{"ID":"20240612192944-7040hat","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192944-7040hat","updated":"20240612192953"},"Children":[{"Type":"NodeText","Data":"藜芦《千金翼方》"}]},{"ID":"20240612192944-kkh9n8p","Type":"NodeParagraph","Properties":{"id":"20240612192944-kkh9n8p","updated":"20240612192944"},"Children":[{"Type":"NodeText","Data":"味辛苦，寒，微寒，有毒。主蛊毒咳逆，泻痢肠 ，头疡疥瘙，恶疮。杀诸虫毒，去肌。"}]},{"ID":"20240612192944-t513oyt","Type":"NodeParagraph","Properties":{"id":"20240612192944-t513oyt","updated":"20240612192944"},"Children":[{"Type":"NodeText","Data":"疗哕逆，喉痹不通，鼻中息肉，马刀烂疮。不入汤。一名葱苒，一名葱 ，一名山葱。生太山山谷，三月采根，阴干。"}]},{"ID":"20240612192954-zi7ooey","Type":"NodeThematicBreak","Properties":{"id":"20240612192954-zi7ooey"}},{"ID":"20240612192959-v1fe61d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192959-v1fe61d","updated":"20240612193004"},"Children":[{"Type":"NodeText","Data":"藜芦《神农本草经百种录》"}]},{"ID":"20240612192959-qk3rvol","Type":"NodeParagraph","Properties":{"id":"20240612192959-qk3rvol","updated":"20240612192959"},"Children":[{"Type":"NodeText","Data":"味辛寒。主蛊毒，味烈杀虫。咳逆，泄痢肠 ，除湿热之疾。头疡，疥瘙，恶疮，杀诸虫毒，去死肌。皆杀虫之功。"}]},{"ID":"20240612192959-pssxfpr","Type":"NodeParagraph","Properties":{"id":"20240612192959-pssxfpr","updated":"20240612192959"},"Children":[{"Type":"NodeText","Data":"凡有毒之药，皆得五行刚暴偏杂之性以成。人身气血，乃天地中和之气所结，故服毒药者，往往受伤。疮疥等疾，久而生虫，亦与人身气血为类，故人服之，而有伤气血者，必能杀虫。惟用之得其法，乃有利而无弊，否则必至于两伤，不可不慎也。又毒之解毒，各有所宜。"}]},{"ID":"20240612192959-tgxipdz","Type":"NodeParagraph","Properties":{"id":"20240612192959-tgxipdz","updated":"20240612192959"},"Children":[{"Type":"NodeText","Data":"如燥毒之药，能去湿邪；寒毒之药，能去火邪。辨证施治，神而明之，非仅以毒攻毒四字，可了其义也。"}]},{"ID":"20240612192959-o2ci8vb","Type":"NodeThematicBreak","Properties":{"id":"20240612192959-o2ci8vb"}},{"ID":"20240612193009-xj238pc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193009-xj238pc","updated":"20240612193014"},"Children":[{"Type":"NodeText","Data":"藜芦《本草乘雅半偈》"}]},{"ID":"20240612193009-el49or4","Type":"NodeParagraph","Properties":{"id":"20240612193009-el49or4","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240612193009-zuo0iyb","Type":"NodeParagraph","Properties":{"id":"20240612193009-zuo0iyb","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"单属上焦，亦是一法。"}]},{"ID":"20240612193009-2x3w7ee","Type":"NodeParagraph","Properties":{"id":"20240612193009-2x3w7ee","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"【气味】辛寒，有毒。"}]},{"ID":"20240612193009-a5h1xvu","Type":"NodeParagraph","Properties":{"id":"20240612193009-a5h1xvu","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"【主治】主蛊毒咳逆，泄利肠 ，头疡疥瘙恶疮，杀诸蛊毒，去死肌。"}]},{"ID":"20240612193009-ws8o6dn","Type":"NodeParagraph","Properties":{"id":"20240612193009-ws8o6dn","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出太山山谷，高山者乃佳。今陕西、辽州、均州、解州亦有之。四月生苗，高五六寸，茎似葱白，色青紫多毛，外有黑皮裹茎，宛似棕榈，故初生之叶，亦若棕心。经久渐放，与郁金、秦艽、 荷等叶相类也。六七月开花，肉红色，立冬便凋。根似龙胆，及马肠根，长四五寸。一本二三十科，若百余科者，水藜芦也。水藜芦生近水溪涧石上，茎叶都相同，独不为药用。修事，去头，用糯米泔汁煮之，从巳至未，晒干用。黄连为之使。反细辛、芍药、人参、沙参、紫参、苦参。恶大黄。"}]},{"ID":"20240612193009-xtuhfot","Type":"NodeParagraph","Properties":{"id":"20240612193009-xtuhfot","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"先人云∶辛生在夏，犹金生在巳也。故入肺及大肠，而治咳逆肠 。盖肠 虽属下焦，其因之痰自愈矣。"}]},{"ID":"20240612193009-jg1lw67","Type":"NodeParagraph","Properties":{"id":"20240612193009-jg1lw67","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"【 】曰∶藜茨属，亦利器也，芦，苇属，亦食器也。然其形两相似矣。合入太阴肺，阳明大肠，以互相循属盘络而为雌雄腑脏者也。故主肺为是动，则病咳逆之脏气，与肺为所生，则病头疡疥瘙恶疮死肌之藏形。若泄利肠 ，蛊毒虫毒，此病大肠腑气之与形也。气味辛寒，施之风热，颇相宜耳。"}]},{"ID":"20240612193009-ivj659t","Type":"NodeParagraph","Properties":{"id":"20240612193009-ivj659t","updated":"20240612193009"},"Children":[{"Type":"NodeText","Data":"（手太阴肺脏之经脉，下络大肠，上膈，属肺；手阳明大肠腑之经脉，络肺，下膈，属大肠；彼此互相盘络，以为腑脏雌雄。内外表里，则手与手为腑脏之雌雄，足与足为腑脏之雌雄，非其腑脏雌雄，则彼此不相盘络。人多习而不察，竟不知手足腑脏雌雄之故。）"}]},{"ID":"20240612193010-8ji3tut","Type":"NodeThematicBreak","Properties":{"id":"20240612193010-8ji3tut"}},{"ID":"20240612193019-jhcct2h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193019-jhcct2h","updated":"20240612193025"},"Children":[{"Type":"NodeText","Data":"藜芦《本草图经》"}]},{"ID":"20240612193019-sxbeapg","Type":"NodeParagraph","Properties":{"id":"20240612193019-sxbeapg","updated":"20240612193030"},"Children":[{"Type":"NodeText","Data":"藜芦，生泰山山谷，今陕西、山南东西州郡皆有之。三月生苗；叶青，似初出棕心，又似车前；茎似葱白，青紫色，高五、六寸，上有黑皮裹茎，似棕皮；其花肉红色；根似马肠根，长四、五寸许，黄白色；二月、三月采根，阴干。此有二种∶一种水藜芦，茎叶大同，只是生在近水溪涧石上，根须百余茎，不中入药用。今用者名葱白藜芦，根须甚少，只是三、二十茎，生高山者为佳，均州土俗亦呼为鹿葱。此药大吐上膈风涎，暗风痫病，小儿 。"}]},{"ID":"20240612193019-nl7ahye","Type":"NodeParagraph","Properties":{"id":"20240612193019-nl7ahye","updated":"20240612193019"},"Children":[{"Type":"NodeText","Data":"用钱匕一字，则恶吐人。又用通顶，令人嚏。而古经本草云∶疗呕逆，其效未详。今萱草亦谓之鹿葱，其类全别，主疗亦不同耳。"}]},{"ID":"20240612193019-biteeb9","Type":"NodeThematicBreak","Properties":{"id":"20240612193019-biteeb9"}},{"ID":"20240612193034-xl9atf7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193034-xl9atf7","updated":"20240612193040"},"Children":[{"Type":"NodeText","Data":"藜芦《新修本草》"}]},{"ID":"20240612193034-dvb7950","Type":"NodeParagraph","Properties":{"id":"20240612193034-dvb7950","updated":"20240612193034"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，有毒。主蛊毒，咳逆，泄痢，肠 ，头疡，疥瘙，恶疮，杀诸虫毒，去死肌。疗 逆，喉痹不通，鼻中息肉，马刀，烘疮。不入汤。一名葱苒，一名葱 ，一名山葱。生太山山谷。三月采根，阴干。"}]},{"ID":"20240612193034-jjjq1tg","Type":"NodeParagraph","Properties":{"id":"20240612193034-jjjq1tg","updated":"20240612193034"},"Children":[{"Type":"NodeText","Data":"黄连为之使，反细辛、芍药、五参，恶大黄。近道处处有。根下极似葱而多毛。用之止剔取根，微炙之。"}]},{"ID":"20240612193035-5jheqc3","Type":"NodeThematicBreak","Properties":{"id":"20240612193035-5jheqc3"}},{"ID":"20240612193047-wpbitn6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193047-wpbitn6","updated":"20240612193054"},"Children":[{"Type":"NodeText","Data":"藜芦《医学入门》"}]},{"ID":"20240612193047-souyd8f","Type":"NodeParagraph","Properties":{"id":"20240612193047-souyd8f","updated":"20240612193047"},"Children":[{"Type":"NodeText","Data":"藜芦苦寒亦善吐，风痫蛊毒与喉痹，诸疮癣秃鼻 肉，止痢治疸除逆哕。"}]},{"ID":"20240612193047-z881hxn","Type":"NodeParagraph","Properties":{"id":"20240612193047-z881hxn","updated":"20240612193047"},"Children":[{"Type":"NodeText","Data":"藜，黑色；芦，虚也。茎中虚如葱管，故俗名鹿葱。有毒。大吐上膈风痰，中风不语，暗风痫病，喉痹及蛊毒，浓煎防风汤浴过，焙干微炒为末，温水下五分，以吐为度。兼治诸疮疥癣马刀，鼻中 肉头秃，及久痢肠，黄胆，咳逆哕逆，杀诸虫。去芦头，糯米泔浸一宿微炒，不入汤药。黄连为使，反细辛、芍药、五参，恶大黄。单方∶牙疼，为末，纳牙孔中勿咽。又烧灰煎膏点黑痣。"}]},{"ID":"20240612193048-pwhjs63","Type":"NodeThematicBreak","Properties":{"id":"20240612193048-pwhjs63"}},{"ID":"20240612193059-50bli6u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193059-50bli6u","updated":"20240612193105"},"Children":[{"Type":"NodeText","Data":"藜芦《证类本草》"}]},{"ID":"20240612193059-x2qmz66","Type":"NodeParagraph","Properties":{"id":"20240612193059-x2qmz66","updated":"20240612193059"},"Children":[{"Type":"NodeText","Data":"味辛、苦，寒、微寒，有毒。主蛊毒，咳逆，泄痢肠 ，头疡疥瘙恶疮，杀诸虫毒，去死肌，疗哕逆，喉痹不通，鼻中息肉，马刀烂疮。不入汤。一名葱苒，一名葱 （音毯），一名山葱。生泰山山谷。三月采根，阴干。（黄连为之使，反细辛、芍药、五参，恶大黄。）"}]},{"ID":"20240612193059-avq46wy","Type":"NodeParagraph","Properties":{"id":"20240612193059-avq46wy","updated":"20240612193059"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处有。根下极似葱而多毛。用之只剔取根，微炙之。臣禹锡等谨按蜀本图经云∶叶似郁金、秦艽、 荷等，根若龙胆，茎下多毛。夏生冬凋枯。今所在山谷皆有。八月采根，阴干。吴氏云∶藜芦，一名葱葵，一名 芦，一名蕙葵。神农、雷公；辛，有毒。"}]},{"ID":"20240612193059-ztdrqkc","Type":"NodeParagraph","Properties":{"id":"20240612193059-ztdrqkc","updated":"20240612193059"},"Children":[{"Type":"NodeText","Data":"歧伯∶咸，有毒。季氏∶大毒，大寒。扁鹊∶苦，有毒。大叶，根小相连。范子曰∶藜芦出河东，黄白者善。药性论云∶藜芦，使，有大毒。能主上气，去积年脓血，泄痢，治恶风疮疥癣头秃，杀虫。"}]},{"ID":"20240612193059-pxey5dm","Type":"NodeParagraph","Properties":{"id":"20240612193059-pxey5dm","updated":"20240612193059"},"Children":[{"Type":"NodeText","Data":"图经曰∶藜芦，生泰山山谷，今陕西、山南东西州郡皆有之。三月生苗。叶青，似初出棕心，又似车前。茎似葱白，青紫色，高五、六寸，上有黑皮裹茎，似棕皮。其花肉红色。根似马肠根，长四、五寸许，黄白色。二月、三月采根，阴干。此有二种∶一种水藜芦，茎叶大同，只是生在近水溪涧石上，根须百余茎，不中入药用。今用者名葱白藜芦，根须甚少，只是三、二十茎，生高山者为佳。均州土俗亦呼为鹿葱。此药大吐上膈风涎，暗风痫病，小儿 ，用钱匕一字，则恶吐人。又用通顶令人嚏，而古经本草云∶疗呕逆，其效未详。今萱草亦谓之鹿葱，其类全别。主疗亦不同耳。"}]},{"ID":"20240612193059-4uz3qvx","Type":"NodeParagraph","Properties":{"id":"20240612193059-4uz3qvx","updated":"20240612193059"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡采得去头，用糯米泔汁煮，从巳至未，出，晒干用之。圣惠方∶治黑痣生于身面上。用藜芦灰五两，水一大碗，淋灰汁于铜器中盛，以重汤煮令如黑膏，以针微拨破痣处点之，良。不过三遍，神验。千金翼治牙疼。纳藜芦末于牙孔中，勿咽汁，神效。经验后方∶治中风不语，喉中如拽锯声，口中涎沫。取藜芦一分，天南星一个，去浮皮，于脐子上陷一个坑子，纳入陈醋二橡斗子，四面用火逼令黄色，同一处捣，再研极细，用生面为丸如赤豆大。每服三丸，温酒下。百一方∶治黄胆。取藜芦着灰中炮之，小变色捣为末。水服半钱匕，小吐，不过数服。斗门方治疥癣。用藜芦细捣为末，以生油涂敷之。简要济众∶治中风不省人事，牙关紧急者。藜芦一两去芦头，浓煎防风汤浴过，焙干碎切，炒微褐色，捣为末。每服半钱，温水调下，以吐出风涎为效。如人行三里未吐，再服。"}]},{"ID":"20240612193059-myzm8p6","Type":"NodeParagraph","Properties":{"id":"20240612193059-myzm8p6","updated":"20240612193059"},"Children":[{"Type":"NodeText","Data":"衍义曰∶藜芦，为末，细调，治马疥痒。"}]},{"ID":"20240612193059-0k4a2a7","Type":"NodeThematicBreak","Properties":{"id":"20240612193059-0k4a2a7"}},{"ID":"20240612193111-ih1wkxe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193111-ih1wkxe","updated":"20240612193117"},"Children":[{"Type":"NodeText","Data":"藜芦《本草纲目》"}]},{"ID":"20240612193111-ikn6l7r","Type":"NodeParagraph","Properties":{"id":"20240612193111-ikn6l7r","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"「释名」山葱、葱苒、葱炎、葱葵、丰芦、憨葱、鹿葱。"}]},{"ID":"20240612193111-f5tpggb","Type":"NodeParagraph","Properties":{"id":"20240612193111-f5tpggb","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"「气味」辛、寒、有毒。"}]},{"ID":"20240612193111-mjnc686","Type":"NodeParagraph","Properties":{"id":"20240612193111-mjnc686","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612193111-f791uxf","Type":"NodeParagraph","Properties":{"id":"20240612193111-f791uxf","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"1、风痰。用藜芦十分、郁金一分，共研为末。每服二、三分，温浆水一碗送下。"}]},{"ID":"20240612193111-wsee5j8","Type":"NodeParagraph","Properties":{"id":"20240612193111-wsee5j8","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"2、中风，牙关紧闭。用藜芦一两，去苗头，在浓煎的防风汤中泡过，焙干，切细，炒成微褐色，研为末。每服半钱，小儿减半。温水调药灌下。以吐风涎为效，末吐财服。又方：治中风后口吐涎沫，喉中发拉锯声：取藜芦一分、天南星一个（去浮皮，挖一小坑，倒入醋少许，在火上烘成黄色），共研为末，加生面和成丸子，如小豆大。每服三丸，温酒送下。"}]},{"ID":"20240612193111-ymo39j2","Type":"NodeParagraph","Properties":{"id":"20240612193111-ymo39j2","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"3、痰疟。用藜芦末半钱，温齑水调下。引吐为好。又方：藜芦、皂荚（炙）各一两，巴豆二址五枚，熬黄，研成末，加蜜和成丸子，如小豆大。每空心服一丸，未发病时服一丸，临发病时又服一丸。宜暂时禁食。"}]},{"ID":"20240612193111-02eyl8l","Type":"NodeParagraph","Properties":{"id":"20240612193111-02eyl8l","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"4、黄疸肿疾。用藜芦在火灰中炮过，取出研细。每服小半匙，水送下。数服可愈。"}]},{"ID":"20240612193111-b231aq0","Type":"NodeParagraph","Properties":{"id":"20240612193111-b231aq0","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"5、牙齿虫痛。用藜芦研为末，填入病齿孔中，有特效。但不能吞汁。"}]},{"ID":"20240612193111-oe4b28g","Type":"NodeParagraph","Properties":{"id":"20240612193111-oe4b28g","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"6、头风白屑。甚痒。用藜芦末掺入头发中，把头包二天，避风。"}]},{"ID":"20240612193111-rzvyrnr","Type":"NodeParagraph","Properties":{"id":"20240612193111-rzvyrnr","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"7、疥癣虫疮。用藜芦末调生油涂搽。"}]},{"ID":"20240612193111-akzi2my","Type":"NodeParagraph","Properties":{"id":"20240612193111-akzi2my","updated":"20240612193111"},"Children":[{"Type":"NodeText","Data":"8、误吞水蛭。用藜芦炒过。研为末，水送服一钱刚愎自用将水蛭吐出。"}]},{"ID":"20240612193112-cagd7xa","Type":"NodeThematicBreak","Properties":{"id":"20240612193112-cagd7xa"}},{"ID":"20240612193200-bbyz7xi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193200-bbyz7xi","updated":"20240612193205"},"Children":[{"Type":"NodeText","Data":"藜芦《中药学》"}]},{"ID":"20240612193200-eczaaxc","Type":"NodeParagraph","Properties":{"id":"20240612193200-eczaaxc","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为百合科植物黑藜芦的根茎与根。"}]},{"ID":"20240612193200-5k75spf","Type":"NodeParagraph","Properties":{"id":"20240612193200-5k75spf","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦、辛，寒。有毒。入肝、肺、胃经。"}]},{"ID":"20240612193200-60vj3dv","Type":"NodeParagraph","Properties":{"id":"20240612193200-60vj3dv","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【功效】吐风痰，杀虫。"}]},{"ID":"20240612193200-wp28k8t","Type":"NodeParagraph","Properties":{"id":"20240612193200-wp28k8t","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【临床应用】1、用于风痰壅盛及缠喉风。"}]},{"ID":"20240612193200-5qes84k","Type":"NodeParagraph","Properties":{"id":"20240612193200-5qes84k","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"本品涌吐作用较强，如欲涌吐痰涎，作为急救，可用防风、瓜蒂、藜芦三味，研细末，取少量，温水送服以催吐。对于癫痫痰涎壅盛，或缠喉风见痰涎壅塞者，可偶一用之。本品有毒，用时宜慎。"}]},{"ID":"20240612193200-hhhfvkg","Type":"NodeParagraph","Properties":{"id":"20240612193200-hhhfvkg","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"2、外用治疥癣。"}]},{"ID":"20240612193200-824946g","Type":"NodeParagraph","Properties":{"id":"20240612193200-824946g","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"本品有杀虫之功，用治疥癣，可用藜芦研为细末，加生油调成软膏，外涂。"}]},{"ID":"20240612193200-al1o5cc","Type":"NodeParagraph","Properties":{"id":"20240612193200-al1o5cc","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【处方用名】藜芦（洗净，晒干，切片用）。"}]},{"ID":"20240612193200-shxlvyc","Type":"NodeParagraph","Properties":{"id":"20240612193200-shxlvyc","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一分至三分，宜作散剂。外用适量。有毒，用量不可过大。"}]},{"ID":"20240612193200-msah6fm","Type":"NodeParagraph","Properties":{"id":"20240612193200-msah6fm","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【方剂举例】通顶散《圣惠方》：藜芦、黄连。外治诸风头痛。"}]},{"ID":"20240612193200-hc67yr9","Type":"NodeParagraph","Properties":{"id":"20240612193200-hc67yr9","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「蛊毒欬逆，泄痢肠澼，头疡疥瘙恶疮，杀诸虫毒，去死肌。」"}]},{"ID":"20240612193200-aiapkfn","Type":"NodeParagraph","Properties":{"id":"20240612193200-aiapkfn","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"《别录》：「疗哕逆喉痹不通，鼻中瘜肉，马刀烂疮，不入汤用。」"}]},{"ID":"20240612193200-5lj03fc","Type":"NodeParagraph","Properties":{"id":"20240612193200-5lj03fc","updated":"20240612193200"},"Children":[{"Type":"NodeText","Data":"《图经本草》：「吐上隔风涎，暗风癫病，小儿[鼻葭]齁痰疾。」"}]},{"ID":"20240612193226-v2vlkdj","Type":"NodeThematicBreak","Properties":{"id":"20240612193226-v2vlkdj"}},{"ID":"20240612193227-rmkpr9o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193227-rmkpr9o","updated":"20240612193232"},"Children":[{"Type":"NodeText","Data":"藜芦《本草崇原》"}]},{"ID":"20240612193227-q763dcz","Type":"NodeParagraph","Properties":{"id":"20240612193227-q763dcz","updated":"20240612193227"},"Children":[{"Type":"NodeText","Data":"气味辛寒，有毒。主治蛊毒，咳逆，泄痢，肠 ，头疡，疥瘙，恶疮，杀诸虫毒，去死肌。"}]},{"ID":"20240612193227-thl0qe9","Type":"NodeParagraph","Properties":{"id":"20240612193227-thl0qe9","updated":"20240612193227"},"Children":[{"Type":"NodeText","Data":"（藜芦一名山葱，所在山谷有之。茎下多毛，三月生苗，高五六寸，茎似葱，根色青紫，外有黑皮裹茎，宛似棕榈，根长四五寸许，黄白色。）"}]},{"ID":"20240612193227-o0k38qs","Type":"NodeParagraph","Properties":{"id":"20240612193227-o0k38qs","updated":"20240612193227"},"Children":[{"Type":"NodeText","Data":"藜芦气味辛寒，其根黄白，外皮黑色，禀土金水相生之气化。土气营运，则能治蛊毒。"}]},{"ID":"20240612193227-0npgtii","Type":"NodeParagraph","Properties":{"id":"20240612193227-0npgtii","updated":"20240612193227"},"Children":[{"Type":"NodeText","Data":"金气气四布，则能治泄痢肠 也。治头疡疥瘙，金制其风也。治恶疮，水土胜湿而解毒也。土主肌肉，故又去死肌。"}]},{"ID":"20240612193302-ad4tlq0","Type":"NodeThematicBreak","Properties":{"id":"20240612193302-ad4tlq0"}},{"ID":"20240612193303-diuf057","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193303-diuf057","updated":"20240612193308"},"Children":[{"Type":"NodeText","Data":"藜芦《本草撮要》"}]},{"ID":"20240612193303-0e8557d","Type":"NodeParagraph","Properties":{"id":"20240612193303-0e8557d","updated":"20240612193303"},"Children":[{"Type":"NodeText","Data":"味辛寒．入手太阴足阳明经．功专吐膈上风痰．至苦有毒．入口即吐．善通顶．令人嚏．风证多用之．虚者忌用．头生虮虱．以末掺之．疥癣虫疮．以末搅生麻油涂之．取根去头用．黄连为使．反细辛、芍药、诸参．恶大黄．畏葱白．服之吐者．服葱白汤即止．与酒同服杀人．"}]},{"ID":"20240612193315-dxfk3pt","Type":"NodeThematicBreak","Properties":{"id":"20240612193315-dxfk3pt"}},{"ID":"20240612193316-ve1abbp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193316-ve1abbp","updated":"20240612193320"},"Children":[{"Type":"NodeText","Data":"藜芦《名医别录》"}]},{"ID":"20240612193316-m9ysjls","Type":"NodeParagraph","Properties":{"id":"20240612193316-m9ysjls","updated":"20240612193316"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，有毒．主治 逆，喉痹不通，鼻中息肉，马刀烂疮．不入汤．一名葱一名山葱．生太山．三月采根，阴干．（黄连为之使，反细辛、芍药、五参，恶大黄．）"}]},{"ID":"20240612193316-tv8jscd","Type":"NodeParagraph","Properties":{"id":"20240612193316-tv8jscd","updated":"20240612193316"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶藜芦，味辛，寒．主蛊毒咳逆，泄利肠 ，头疡疥瘙恶疮，杀诸虫毒，去死肌．一名葱苒．"}]},{"ID":"20240612193431-o8ar4z3","Type":"NodeThematicBreak","Properties":{"id":"20240612193431-o8ar4z3"}},{"ID":"20240612193432-4w13obm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193432-4w13obm","updated":"20240612193437"},"Children":[{"Type":"NodeText","Data":"藜芦《得配本草》"}]},{"ID":"20240612193432-iyzacbm","Type":"NodeParagraph","Properties":{"id":"20240612193432-iyzacbm","updated":"20240612193432"},"Children":[{"Type":"NodeText","Data":"黄连为之使。畏葱白。恶大黄。反人参、沙参、紫参、丹参、苦参、细辛、芍药。"}]},{"ID":"20240612193432-z8vsz2e","Type":"NodeParagraph","Properties":{"id":"20240612193432-z8vsz2e","updated":"20240612193432"},"Children":[{"Type":"NodeText","Data":"辛、苦、寒。吐上膈风涎，暗风痫病，去积年脓血泄痢，杀诸虫毒，去死肌，（服之吐不止，饮葱汤即止。）又能通顶令人嚏。得雄黄蜜调，点鼻中息肉。和猪脂调敷反花恶疮。晒干研末，入麝香少许，吹鼻，治诸风头痛。（或入黄连末少许。）生用令人吐。去头，糯米泔浸，煮透晒干用。气血虚者禁服。"}]},{"ID":"20240612193455-1sydwpi","Type":"NodeThematicBreak","Properties":{"id":"20240612193455-1sydwpi"}},{"ID":"20240612193456-6rgzidx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193456-6rgzidx","updated":"20240612193502"},"Children":[{"Type":"NodeText","Data":"藜芦《本草从新》"}]},{"ID":"20240612193456-n1kbclq","Type":"NodeParagraph","Properties":{"id":"20240612193456-n1kbclq","updated":"20240612193456"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、引吐．"}]},{"ID":"20240612193456-kyo2708","Type":"NodeParagraph","Properties":{"id":"20240612193456-kyo2708","updated":"20240612193456"},"Children":[{"Type":"NodeText","Data":"辛寒至苦．司蛊毒与喉痹．能杀虫．理疥癣．入口即吐．善通顶．令人嚏．风痫证多用之．（张子和儒门事亲曰∶一妇病风痫、初一二年一发、后渐日发、甚至一日数发、求死而已、值岁大饥、采百草食、见野草若葱、采蒸饱食、觉不安、吐胶涎数日、约一二斗、汗出如洗、甚昏困、后遂轻健如常人、以所食葱访人、乃憨葱苗、即藜芦是矣、时珍曰∶和王妃、年七十、中风不省、牙关紧闭、先考太医吏目月池翁诊视、浓煎藜芦汤灌之、少顷噫气、遂吐痰而苏、药不瞑眩、厥疾不瘳、诚然．）服之令人烦闷吐逆．大损津液．虚者慎之．取根去头．用黄连为使．反细辛、芍药、诸参．恶大黄．畏葱白．（吐者、服葱汤即止、与酒同用、杀人．头生虮虱、藜芦末掺之．疥癣虫疮、藜芦末生油涂．）"}]},{"ID":"20240612193443-lkk6so9","Type":"NodeThematicBreak","Properties":{"id":"20240612193443-lkk6so9"}},{"ID":"20240612193444-syg5031","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193444-syg5031","updated":"20240612193449"},"Children":[{"Type":"NodeText","Data":"藜芦《本经逢原》"}]},{"ID":"20240612193444-8qyrbs1","Type":"NodeParagraph","Properties":{"id":"20240612193444-8qyrbs1","updated":"20240612193444"},"Children":[{"Type":"NodeText","Data":"辛苦寒，有毒。反五参。服之吐不止者，饮葱汤即止。"}]},{"ID":"20240612193444-kvad14t","Type":"NodeParagraph","Properties":{"id":"20240612193444-kvad14t","updated":"20240612193444"},"Children":[{"Type":"NodeText","Data":"《本经》主蛊毒，咳逆，泄痢肠 ，头疡疥瘙，恶疮杀诸蛊毒，去死肌。"}]},{"ID":"20240612193444-et1ww8k","Type":"NodeParagraph","Properties":{"id":"20240612193444-et1ww8k","updated":"20240612193444"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"藜芦服钱匙则恶吐，而《本经》治蛊毒咳逆泄利肠 ，是指积气内盛者而言，积去则咳与利止矣。又通顶令人嚏。按∶常山吐疟痰，瓜蒂吐热痰，乌附尖吐湿痰，莱菔子吐气痰，藜芦则吐风痰者也。凡胸中有老痰或中蛊毒，只可借其宣吐，切勿沾口，大损胃中津液也。若咳逆泄利肠 等证，苟非实邪壅滞，慎勿轻试。不可因《本经》之言而致惑也。"}]},{"ID":"20240612193444-7s500vs","Type":"NodeParagraph","Properties":{"id":"20240612193444-7s500vs","updated":"20240612193444"},"Children":[{"Type":"NodeText","Data":"《别录》治喉痹不通、鼻中息肉并为散，吹鼻孔效。"}]},{"ID":"20240612193421-qyon4hb","Type":"NodeThematicBreak","Properties":{"id":"20240612193421-qyon4hb"}},{"ID":"20240612193422-mv9k0z6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193422-mv9k0z6","updated":"20240612193426"},"Children":[{"Type":"NodeText","Data":"藜芦《本草简要方》"}]},{"ID":"20240612193422-mgnri5n","Type":"NodeParagraph","Properties":{"id":"20240612193422-mgnri5n","updated":"20240612193422"},"Children":[{"Type":"NodeText","Data":"主治引吐疯痫上脑。风涎。黄胆肿疾。蛊毒杀头虱。及误吞水蛭。（为末服）此为吐药主。凡病在上焦属风痰须吐者宜用。藜芦甘草汤。藜芦甘草等分。水煎服。治痰入经络指臂肿动。身体不定。甘草之用。专在和胃。藜芦膏。藜芦松脂（细研）苦参雄黄研）白矾（枯）各二两。先捣藜芦苦参为粗末。入猪脂一斤相和。煎十余沸。绵滤去滓。次入他末搅匀。待冷瓷盒收贮。治诸疮生虫涂患处。"}]},{"ID":"20240612193338-mm6jgu3","Type":"NodeThematicBreak","Properties":{"id":"20240612193338-mm6jgu3"}},{"ID":"20240612193339-m94w16r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193339-m94w16r","updated":"20240612193343"},"Children":[{"Type":"NodeText","Data":"藜芦《神农本草经赞》"}]},{"ID":"20240612193339-90luyz3","Type":"NodeParagraph","Properties":{"id":"20240612193339-90luyz3","updated":"20240612193339"},"Children":[{"Type":"NodeText","Data":"味辛寒。主蛊毒。咳逆。泄利。肠。头疡。疥搔。恶创。杀诸蛊毒。去死肌。一名葱苒。生山谷。"}]},{"ID":"20240612193339-r99w8mv","Type":"NodeParagraph","Properties":{"id":"20240612193339-r99w8mv","updated":"20240612193339"},"Children":[{"Type":"NodeText","Data":"大叶微根。相连节短。黎裹棕心。白憨葱管。景仰山高。迟回水缓。吐嚏交通。顿驱风瘅。"}]},{"ID":"20240612193339-2xuoe9l","Type":"NodeParagraph","Properties":{"id":"20240612193339-2xuoe9l","updated":"20240612193339"},"Children":[{"Type":"NodeText","Data":"吴普曰。大叶小根相连。李时珍曰。黑色曰藜芦。裹黑皮故名。根际似葱。俗名葱管藜芦。"}]},{"ID":"20240612193339-vq2eava","Type":"NodeParagraph","Properties":{"id":"20240612193339-vq2eava","updated":"20240612193339"},"Children":[{"Type":"NodeText","Data":"北人谓之憨葱。苏颂曰。初生苗叶似棕心。又似葱白。此有二种。生高山者为佳。一种水藜芦。生溪涧石上。不中药用。"}]},{"ID":"20240612193339-ovyfoyt","Type":"NodeParagraph","Properties":{"id":"20240612193339-ovyfoyt","updated":"20240612193339"},"Children":[{"Type":"NodeText","Data":"凡使服钱许。则恶吐。又能通顶。令人嚏。李时珍曰。吐风痰者也。"}]},{"ID":"20240612193404-w33ixxg","Type":"NodeThematicBreak","Properties":{"id":"20240612193404-w33ixxg"}},{"ID":"20240612193408-ni1mwar","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193408-ni1mwar","updated":"20240612193413"},"Children":[{"Type":"NodeText","Data":"藜芦《本草分经》"}]},{"ID":"20240612193408-gqxs759","Type":"NodeParagraph","Properties":{"id":"20240612193408-gqxs759","updated":"20240612193408"},"Children":[{"Type":"NodeText","Data":"辛寒至苦，治蛊毒喉痹，杀虫，入口即吐，风痫症用之服后吐不止者饮葱汤即止，与酒同用杀人。"}]},{"ID":"20240612193350-pfmg57i","Type":"NodeThematicBreak","Properties":{"id":"20240612193350-pfmg57i"}},{"ID":"20240612193351-gfj2zbb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193351-gfj2zbb","updated":"20240612193359"},"Children":[{"Type":"NodeText","Data":"藜芦《本草便读》"}]},{"ID":"20240612193351-z411jwd","Type":"NodeParagraph","Properties":{"id":"20240612193351-z411jwd","updated":"20240612193351"},"Children":[{"Type":"NodeText","Data":"辛苦大寒．沉阴有毒．专司涌吐．能宣胸胃之风痰．善杀蛊虫．且愈肺脾之癣疥．（藜芦其芦有黑皮包之．其根如葱．辛苦大寒．有毒．入肺胃．入口即吐．凡风痰在膈．以及蛊毒等证．与夫癫痫不愈．久疟久哮者．皆可用之取吐．又能吹鼻取嚏．外敷疥癣．亦瞑眩之药耳．）"}]},{"ID":"20240612193327-gbfc2tr","Type":"NodeThematicBreak","Properties":{"id":"20240612193327-gbfc2tr"}},{"ID":"20240612193328-q576rmn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193328-q576rmn","updated":"20240612193333"},"Children":[{"Type":"NodeText","Data":"藜芦《吴普本草》"}]},{"ID":"20240612193328-7tb8rpl","Type":"NodeParagraph","Properties":{"id":"20240612193328-7tb8rpl","updated":"20240612193328"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百九十"}]},{"ID":"20240612193328-r0o25b7","Type":"NodeParagraph","Properties":{"id":"20240612193328-r0o25b7","updated":"20240612193328"},"Children":[{"Type":"NodeText","Data":"一名葱葵，一名山葱，一名丰芦，一名蕙葵，一名公苒。神农、雷公∶辛，有毒。黄帝∶有毒。岐伯∶咸，有毒。李氏∶大毒，大寒。扁鹊∶苦，有毒。大叶根小相连。二月采根。"}]},{"ID":"20240612193238-hw9v0q9","Type":"NodeThematicBreak","Properties":{"id":"20240612193238-hw9v0q9"}},{"ID":"20240612193249-siprfdo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193249-siprfdo","updated":"20240612193257"},"Children":[{"Type":"NodeText","Data":"藜芦《本草求真》"}]},{"ID":"20240612193249-9e17yg8","Type":"NodeParagraph","Properties":{"id":"20240612193249-9e17yg8","updated":"20240612193249"},"Children":[{"Type":"NodeText","Data":"（毒草）吐风痰在膈"}]},{"ID":"20240612193249-o4jwxps","Type":"NodeParagraph","Properties":{"id":"20240612193249-o4jwxps","updated":"20240612193249"},"Children":[{"Type":"NodeText","Data":"居。盖缘苦虽属降。而亦善涌。藜芦辛少苦多。故能入口即吐。是以风痰膈结。而见咳逆上气者。当用是药以投。使其膈部之邪。悉从上出也。但此宜作散剂以投。（散可达上。）切勿汤药以服。（儒门事亲云。一妇病风痫。初一二年一作。后渐日作。甚至一日数作。求死而已。值岁大饥。采百草食。见野草若葱。采蒸饱食。觉不安。吐胶涎数日。约一二斗。汗出如洗。甚昏困。后遂轻健如常人。以所食是葱访人。乃憨葱苗。即藜芦是已。时珍曰。我朝荆和王妃刘氏。年七十。中风不省。牙关紧闭。先考太医吏目月池翁诊视。药不能入。不获已打去一齿。浓煎藜芦汤灌之。少顷噫气。遂吐痰而苏。药勿瞑眩。厥疾勿瘳。诚然。）至于肠 泄痢如何。书载克治亦是因吐除其实积。积去而利与 亦可止矣！吐虽等于常山瓜蒂乌附尖莱菔子。但常山则吐疟痰。瓜蒂则吐热痰。乌附尖则吐湿痰。（亦吐风痰。）此则专吐风痰者也。况此气善通顶。治喉痹及鼻中息肉。为末吹效。然亦并非得已。即有中蛊等毒。及或老痰积块。止可借其宣泄。切勿沾口以自损其津液耳。取根去头用。黄连为使。反细辛芍药诸参。恶大黄。畏葱白。（服葱汤。吐即止。）"}]},{"ID":"20240612193201-1u4v1mi","Type":"NodeThematicBreak","Properties":{"id":"20240612193201-1u4v1mi"}},{"ID":"20240612193213-pbz90tn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193213-pbz90tn","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：藜芦"}]},{"ID":"20240612193213-hs51vbn","Type":"NodeParagraph","Properties":{"id":"20240612193213-hs51vbn","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612193213-gam8m8t","Type":"NodeParagraph","Properties":{"id":"20240612193213-gam8m8t","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" Lí Lú"}]},{"ID":"20240612193213-sqqyj9z","Type":"NodeParagraph","Properties":{"id":"20240612193213-sqqyj9z","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612193213-6rh490u","Type":"NodeParagraph","Properties":{"id":"20240612193213-6rh490u","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 黑藜芦、山葱、大叶藜芦、棕包头、人头发、七厘丹"}]},{"ID":"20240612193213-moafq66","Type":"NodeParagraph","Properties":{"id":"20240612193213-moafq66","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612193213-gc6dv5s","Type":"NodeParagraph","Properties":{"id":"20240612193213-gc6dv5s","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 百合科藜芦属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藜芦"},{"Type":"NodeText","Data":"Veratrum nigrum L.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"部或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带根全草"},{"Type":"NodeText","Data":"入药。5～6月末抽花茎前采挖根部，除去地上部分，洗净晒干。"}]},{"ID":"20240612193213-ztp5lrz","Type":"NodeParagraph","Properties":{"id":"20240612193213-ztp5lrz","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612193213-xh9trxr","Type":"NodeParagraph","Properties":{"id":"20240612193213-xh9trxr","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 辛、苦，寒。有毒。"}]},{"ID":"20240612193213-fnp2ob0","Type":"NodeParagraph","Properties":{"id":"20240612193213-fnp2ob0","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612193213-29kgfxf","Type":"NodeParagraph","Properties":{"id":"20240612193213-29kgfxf","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 内服宜慎，孕妇忌服。不宜与人参、沙参、丹参、玄参、苦参、细辛、芍药同用。"}]},{"ID":"20240612193213-je38rsn","Type":"NodeParagraph","Properties":{"id":"20240612193213-je38rsn","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612193213-xvv36ut","Type":"NodeParagraph","Properties":{"id":"20240612193213-xvv36ut","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 祛痰，催吐，杀虫。用于中风痰壅，癫痫，疟疾，骨折；外用治疥癣，灭蝇蛆。"}]},{"ID":"20240612193213-zmwymrw","Type":"NodeParagraph","Properties":{"id":"20240612193213-zmwymrw","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612193213-3k7ug8n","Type":"NodeParagraph","Properties":{"id":"20240612193213-3k7ug8n","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 0.5～1钱；外用适量，研末敷患处。"}]},{"ID":"20240612193213-lsjsed4","Type":"NodeParagraph","Properties":{"id":"20240612193213-lsjsed4","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612193213-xos9zj0","Type":"NodeParagraph","Properties":{"id":"20240612193213-xos9zj0","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612193213-f4udgn6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193213-f4udgn6","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：藜芦"}]},{"ID":"20240612193213-0y1hlpu","Type":"NodeParagraph","Properties":{"id":"20240612193213-0y1hlpu","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612193213-l8bpq6t","Type":"NodeParagraph","Properties":{"id":"20240612193213-l8bpq6t","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" Lí Lú"}]},{"ID":"20240612193213-s62n8mm","Type":"NodeParagraph","Properties":{"id":"20240612193213-s62n8mm","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612193213-pc9buhh","Type":"NodeParagraph","Properties":{"id":"20240612193213-pc9buhh","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 葱苒（《本经》），葱葵、山葱、丰芦、蕙葵、公苒（《吴普本草》），梨卢（《本草经集注》），葱菼（《别录》），葱白藜芦、鹿葱（《本草图经》），憨葱（《儒门事亲》），旱葱（《山东中药》），山棕榈（《农药植物手册》），山白菜、芦莲，药蝇子草、山苞米（《辽宁经济植物志》），人头发、毒药草（《四川中药志》），七厘丹（《南方主要有毒植物》）。"}]},{"ID":"20240612193213-xlwsgbo","Type":"NodeParagraph","Properties":{"id":"20240612193213-xlwsgbo","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612193213-hb33lqc","Type":"NodeParagraph","Properties":{"id":"20240612193213-hb33lqc","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612193213-x9p4dxy","Type":"NodeParagraph","Properties":{"id":"20240612193213-x9p4dxy","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612193213-ch8hspi","Type":"NodeParagraph","Properties":{"id":"20240612193213-ch8hspi","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黑藜芦"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。5～6月未抽花茎时采挖，除去苗叶，晒干或用开水浸烫后晒干。"}]},{"ID":"20240612193213-3u4ct02","Type":"NodeParagraph","Properties":{"id":"20240612193213-3u4ct02","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612193213-09ebowk","Type":"NodeParagraph","Properties":{"id":"20240612193213-09ebowk","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 生于山野、林内或灌木丛间。分布山西、河北、河南、山东、辽宁、陕西、四川、江苏等地。全国大部分地区有产。"}]},{"ID":"20240612193213-hkmhabe","Type":"NodeParagraph","Properties":{"id":"20240612193213-hkmhabe","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612193213-l8fuli4","Type":"NodeParagraph","Properties":{"id":"20240612193213-l8fuli4","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高60～100厘米。根多数，细长，带肉质。茎直立。叶互生，广卵形、椭圆形至卵状披针形，长达30厘米，宽约10厘米，先端渐尖，全缘式带微波状，基部渐狭而下沿呈鞘状，抱茎；上面青绿色，下面灰绿色，两面均无毛，平行脉隆起。顶生大圆锥花序，总轴及枝轴均密被灰白色绵毛；雄花常生于花序轴下部，两性花多生于中部以上；枝轴基部有披针形苞片1枚，背面及边缘密被细绵毛；花多数，花梗基部具1小苞片，背面有细绵毛；花被6，紫黑色，卵形，先端尖或钝，基部渐狭，长5～6毫米，宽约2毫米，上面光滑，下面被绵毛；雄蕊6，花丝丝状；子房卵形，3室，花柱3裂，先端外展。蒴果卵状三角形，长1.5～2厘米，熟时2裂。种子多数。花期7～8月。果期8～9月。"}]},{"ID":"20240612193213-992hi3e","Type":"NodeParagraph","Properties":{"id":"20240612193213-992hi3e","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612193213-7wtyyqo","Type":"NodeParagraph","Properties":{"id":"20240612193213-7wtyyqo","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 干燥根茎，短粗，表面褐色。上端残留叶基及棕色毛状的维管束。须根多数，簇生于根茎四周，长12～20厘米，粗约3毫米，表面黄白色或灰褐色，有细密的横皱，下端多纵皱。质脆易折断，断面白色、粉质，中心有一淡黄色纤细的木质部，易与皮部分离，味苦辛。以根粗坚实，断面粉性者为佳。"}]},{"ID":"20240612193213-au6m2pr","Type":"NodeParagraph","Properties":{"id":"20240612193213-au6m2pr","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612193213-kenqsn5","Type":"NodeParagraph","Properties":{"id":"20240612193213-kenqsn5","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 天目藜芦毒性甚大，其半数致死量与萱草根相似，但无蓄积中毒现象，黑藜芦浸出液的半数致死量为1.78±0.38克/公斤。兴安藜芦根的粉剂对口、鼻、眼粘膜有刺激作用，其中所含之藜芦定碱中毒时主要影响横纹肌，动物死于呼吸停止。"}]},{"ID":"20240612193213-oxc7j5r","Type":"NodeParagraph","Properties":{"id":"20240612193213-oxc7j5r","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"国外产绿藜芦（美国及加拿大），白藜芦（欧洲）根茎中的原藜芦碱A和B等均有降压作用，并应用于高血压的治疗。藜芦定碱（作用与原藜芦碱不完全相同）静脉注射于狗，可引起血压突然下降，在迷走神经切除后，更大剂量可释放肾上腺素引起心率加快、血压上升，在原藜芦碱降压的基础上，藜芦定碱可引起明显的升压作用。藜芦一类生物碱的降压原理系通过左心室、肺迷走神经纤维反射性引起血管运动中枢抑制，小剂量反射性抑制呼吸，大剂量直接抑制呼吸中枢，口服量为肌肉注射量的5～20倍，藜芦碱的治疗量与中毒量距离很小，最常见者为恶心、呕吐，有时引起心律不齐，低血压，用阿托品及麻黄碱可纠正之，小量藜芦和其他降压药物合用，可发挥协同作用，降低毒性。"}]},{"ID":"20240612193213-6wvrj90","Type":"NodeParagraph","Properties":{"id":"20240612193213-6wvrj90","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612193213-bzte8kp","Type":"NodeParagraph","Properties":{"id":"20240612193213-bzte8kp","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 黑藜芦根、根茎含介芬胺、假介芬胺、玉红介芬胺、秋水仙碱、计明胺及藜芦酰棋盘花碱等生物碱。"}]},{"ID":"20240612193213-ji8eu0s","Type":"NodeParagraph","Properties":{"id":"20240612193213-ji8eu0s","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"天目藜芦根含天目藜芦碱、天目藜芦宁碱等多种生物碱。"}]},{"ID":"20240612193213-vbv7vqv","Type":"NodeParagraph","Properties":{"id":"20240612193213-vbv7vqv","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"蒜藜芦根含藜芦胺、玉红介芬胺、龙葵胺、脱氧介芬胺等生物碱及β-谷甾醇。根茎含介芬胺、藜芦胺、棋盘花辛碱、玉红介芬胺及棋盘花酸δ-内酯-16-当归酸酯等生物碱。"}]},{"ID":"20240612193213-iliauae","Type":"NodeParagraph","Properties":{"id":"20240612193213-iliauae","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612193213-xpcu2ff","Type":"NodeParagraph","Properties":{"id":"20240612193213-xpcu2ff","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" ①降压作用"}]},{"ID":"20240612193213-cz5ratd","Type":"NodeParagraph","Properties":{"id":"20240612193213-cz5ratd","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"天目藜芦之总碱及天目藜芦宁碱，贵州产黑藜芦根的初提液，辽宁乌苏里藜芦混合碱，云南产小藜芦的提取成分，毛穗藜芦之总碱，毛叶藜芦之总碱，兴安藜芦根浸膏的水溶液及精制品的醇溶液，经过多种麻醉动物实验均证明具有明显而持久的降压作用，无急速耐受现象，在降压的同时伴有心率减慢、呼吸抑制或暂停（即Bezold-Jarisch效应）。天目藜芦的初提液乙较上海市中药行购得之藜芦（经鉴定为百合科藜芦属）的初提液甲降压作用强2～3倍，于麻醉猫的降压实验中，毛穗藜芦总碱较毛叶藜芦总碱作用强，天目藜芦总碱较前两者弱，肌肉注射量需大于静脉注射量10倍以上方有降压作用，可维持较长时间，口服需大于静注量15倍以上方有效，此时已有个别动物表现中毒症状（恶心、呕吐），甚至死亡，故肌肉注射与口服给药不太安全；预先应用氯丙嗪可防止发生恶心、呕吐。上海市中药行购得之藜芦的初提液甲对慢性肾型高血压犬（灌胃）表现降压作用，贵州产黑藜芦初提液对肾型高血压兔亦有降压作用。关于藜芦生物碱一类的降压原理，一般认为，由于颈动脉窦及心肺感受区经窦神经及迷走传入纤维反射性地抑制血管运动中枢，引起血压下降。离体兔耳及猫后肢灌流无直接扩张血管作用。毛穗藜芦碱的降压作用中，脑和肾血管舒张起一定的作用，但作用短暂。日本产蒜藜芦提取物亦有降压作用，并谓与绿藜芦相似。"}]},{"ID":"20240612193213-cv277o3","Type":"NodeParagraph","Properties":{"id":"20240612193213-cv277o3","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②其他作用"}]},{"ID":"20240612193213-6sbcikp","Type":"NodeParagraph","Properties":{"id":"20240612193213-6sbcikp","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"天目藜芦对感染日本血吸虫的小鼠无明显治疗作用。兴安藜芦对妊娠毒血症有良好的效果。黑藜芦对家蝇有强大的毒杀效力。"}]},{"ID":"20240612193213-j00o66g","Type":"NodeParagraph","Properties":{"id":"20240612193213-j00o66g","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612193213-mpr89l2","Type":"NodeParagraph","Properties":{"id":"20240612193213-mpr89l2","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"入手太阴、足阳明经。\""}]},{"ID":"20240612193213-7xdyzby","Type":"NodeParagraph","Properties":{"id":"20240612193213-7xdyzby","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②《本草再新》：\"入肝经。\""}]},{"ID":"20240612193213-xmdt98s","Type":"NodeParagraph","Properties":{"id":"20240612193213-xmdt98s","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612193213-5gixxrp","Type":"NodeParagraph","Properties":{"id":"20240612193213-5gixxrp","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒，有毒。"}]},{"ID":"20240612193213-gtvusyd","Type":"NodeParagraph","Properties":{"id":"20240612193213-gtvusyd","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，寒。\""}]},{"ID":"20240612193213-5vns3c9","Type":"NodeParagraph","Properties":{"id":"20240612193213-5vns3c9","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，微寒，有毒。\""}]},{"ID":"20240612193213-157d3oi","Type":"NodeParagraph","Properties":{"id":"20240612193213-157d3oi","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612193213-qqsc5vh","Type":"NodeParagraph","Properties":{"id":"20240612193213-qqsc5vh","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 体虚气弱及孕妇忌服。"}]},{"ID":"20240612193213-esm8vck","Type":"NodeParagraph","Properties":{"id":"20240612193213-esm8vck","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"黄连为之使；反细辛、芍药、五参，恶大黄。\""}]},{"ID":"20240612193213-ootwkrc","Type":"NodeParagraph","Properties":{"id":"20240612193213-ootwkrc","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"畏葱白。服之吐不止，饮葱汤即止。\""}]},{"ID":"20240612193213-btm8hh7","Type":"NodeParagraph","Properties":{"id":"20240612193213-btm8hh7","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"服之令人烦闷吐逆，大损津液，虚者慎之。\""}]},{"ID":"20240612193213-kt3qrbn","Type":"NodeParagraph","Properties":{"id":"20240612193213-kt3qrbn","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612193213-li3m27f","Type":"NodeParagraph","Properties":{"id":"20240612193213-li3m27f","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 吐风痰，杀虫毒。治中风痰涌，风痫癫疾，黄疸，久疟，泄痢，头痛，喉痹，鼻息，疥癣，恶疮。"}]},{"ID":"20240612193213-aextii5","Type":"NodeParagraph","Properties":{"id":"20240612193213-aextii5","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"用于中风、癫痫、喉痹症见痰涎涌盛。用于疥癣秃疮。此外，以本品研末外渗，有灭虱功效。又近用以杀灭蚊蝇及其幼虫，也作农药杀虫剂及兽医作催吐药使用。"}]},{"ID":"20240612193213-p0w9yfq","Type":"NodeParagraph","Properties":{"id":"20240612193213-p0w9yfq","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主蛊毒，咳逆，泄痢，肠澼，头疡，疥瘙，恶疮，杀诸虫毒，去死肌。\""}]},{"ID":"20240612193213-m3i5tm1","Type":"NodeParagraph","Properties":{"id":"20240612193213-m3i5tm1","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗哕逆，喉痹不通，鼻中息肉，马刀，烂疮。\""}]},{"ID":"20240612193213-r61wc8z","Type":"NodeParagraph","Properties":{"id":"20240612193213-r61wc8z","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主上气，去积年脓血泄痢。治恶风疮、疥癣、头秃，杀虫。\""}]},{"ID":"20240612193213-rj2v41c","Type":"NodeParagraph","Properties":{"id":"20240612193213-rj2v41c","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"④《本草图经》：\"大吐上膈风涎，暗风痫病，小儿鰕齁；用钱匕一字则恶吐人，又用通顶，令人嚏。\""}]},{"ID":"20240612193213-xqcu0hi","Type":"NodeParagraph","Properties":{"id":"20240612193213-xqcu0hi","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑤《四川武隆药植图志》：\"治毒蛇咬伤及杀虫用。\""}]},{"ID":"20240612193213-4hl4nx2","Type":"NodeParagraph","Properties":{"id":"20240612193213-4hl4nx2","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612193213-mtrrb2s","Type":"NodeParagraph","Properties":{"id":"20240612193213-mtrrb2s","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 内服：研末，1～2分；或入丸剂。外用：研末，搐鼻或调敷。"}]},{"ID":"20240612193213-62755lv","Type":"NodeParagraph","Properties":{"id":"20240612193213-62755lv","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612193213-ijung5i","Type":"NodeParagraph","Properties":{"id":"20240612193213-ijung5i","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" ①治诸风痰饮：藜芦十分，郁金一分，为末。每以一字，温浆水一盏，和服探吐。（《经验方》）"}]},{"ID":"20240612193213-p898si2","Type":"NodeParagraph","Properties":{"id":"20240612193213-p898si2","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②治中风不语，喉中如曳锯声，口中涎沫：藜芦一分，天南星一个（去浮皮，于脐子上陷一个坑子，纳入陈醋二橡斗子，四面用火逼令黄色）。同一处捣，再研极细，用生面为丸，如赤豆大，每服三丸，温酒下。（《经验后方》）"}]},{"ID":"20240612193213-sx9ml8z","Type":"NodeParagraph","Properties":{"id":"20240612193213-sx9ml8z","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"③治头痛不可忍：藜芦一茎，暴干，捣罗为散，入麝香麻子许，研匀吹鼻中。（《圣济总录》吹鼻麝香散）"}]},{"ID":"20240612193213-pvznhtk","Type":"NodeParagraph","Properties":{"id":"20240612193213-pvznhtk","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"④治头痛鼻塞脑闷：藜芦（研）半两，黄连（去须）三分。上二味，捣研为散，每用少许，搐入鼻中。（《圣济总录》通顶散）"}]},{"ID":"20240612193213-zixer2r","Type":"NodeParagraph","Properties":{"id":"20240612193213-zixer2r","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑤治黄疸：藜芦着灰中炮之，小变色，捣为末，水服半钱匕，小吐，不过数服。（《肘后方》）"}]},{"ID":"20240612193213-okzza2s","Type":"NodeParagraph","Properties":{"id":"20240612193213-okzza2s","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑥治老疟久不断者：藜芦、皂荚（炙）各一两，巴豆二十五枚（熬令黄）。依法捣，蜜丸如小豆。空心服一丸，未发时一丸，临发时又一丸，勿次食。（《补缺肘后方》）"}]},{"ID":"20240612193213-x1hk9ty","Type":"NodeParagraph","Properties":{"id":"20240612193213-x1hk9ty","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑦治久疟不能饮食，胸中郁郁如吐，欲吐不能吐者，宜吐，则已：大藜芦末半钱，温虀水调下，以吐为度。（《素问病机保命集》藜芦散）"}]},{"ID":"20240612193213-qlkwitc","Type":"NodeParagraph","Properties":{"id":"20240612193213-qlkwitc","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑧治诸瘑疮，经久则生虫：藜芦（去芦头）、白矾（烧灰细研）、松脂（细研）、雄黄（细研）、苦参各二两（锉）。上药，先捣藜芦、苦参为末，入猪脂一斤相和，煎十余沸，绵滤去滓，次入松脂、雄黄、白矾等末，搅令匀，待冷，收于瓷合中，旋取涂之，以瘥为度。（《圣惠方》藜芦散）"}]},{"ID":"20240612193213-wew70q9","Type":"NodeParagraph","Properties":{"id":"20240612193213-wew70q9","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑨治鼻中息肉渐大，气息不通：藜芦三分（去芦头，捣罗为末），雄黄一分（细研），雌黄一分（细研）。上药，同研令匀，每用时以蜜调敢，用纸拈子，展药，点于息肉上，每日三度，则自消化，不得涂药在于两畔，恐涕落于药上。（《圣惠方》）"}]},{"ID":"20240612193213-o6e7umj","Type":"NodeParagraph","Properties":{"id":"20240612193213-o6e7umj","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑩治牙疼：纳藜芦末于牙孔中，勿咽汁。（《千金翼方》）"}]},{"ID":"20240612193213-sgnvuno","Type":"NodeParagraph","Properties":{"id":"20240612193213-sgnvuno","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑾治白秃：末藜芦，以腊月猪膏和涂之，先用盐汤洗，乃敷。（《补缺肘后方》）"}]},{"ID":"20240612193213-82xqxhs","Type":"NodeParagraph","Properties":{"id":"20240612193213-82xqxhs","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑿治头生虮虱：藜芦末掺之。（《仁斋直指方》）"}]},{"ID":"20240612193213-yl9e24q","Type":"NodeParagraph","Properties":{"id":"20240612193213-yl9e24q","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⒀治疥癣：藜芦，细捣为末，以生油调敷之。（《斗门方》）"}]},{"ID":"20240612193213-b6bxh9i","Type":"NodeParagraph","Properties":{"id":"20240612193213-b6bxh9i","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⒁中风，牙关紧闭。用藜芦一两，去苗头，在浓煎的防风汤中泡过，焙干，切细，炒成微褐色，研为末。每服半钱，小儿减半。温水调药灌下。以吐风涎为效，末吐再服。"}]},{"ID":"20240612193213-70m2il8","Type":"NodeParagraph","Properties":{"id":"20240612193213-70m2il8","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⒂误吞水蛭。用藜芦炒过。研为末，水送服一钱将水蛭吐出。"}]},{"ID":"20240612193213-6isd6ef","Type":"NodeParagraph","Properties":{"id":"20240612193213-6isd6ef","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612193213-xohmp22","Type":"NodeParagraph","Properties":{"id":"20240612193213-xohmp22","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" ①治疗疟疾"}]},{"ID":"20240612193213-fxv8og0","Type":"NodeParagraph","Properties":{"id":"20240612193213-fxv8og0","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"取天目藜芦3根（1寸长），插入鸡蛋（1个）内烧熟。去药吃蛋。于发作前1～2小时服。忌鱼腥；孕妇及溃疡病患者忌服。治疗现症病人120例，痊愈100例，好转15例，无效5例；休止期患者36例，痊愈33例，无效3例。"}]},{"ID":"20240612193213-i0cxq7r","Type":"NodeParagraph","Properties":{"id":"20240612193213-i0cxq7r","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②治疗骨折"}]},{"ID":"20240612193213-bhy7xnu","Type":"NodeParagraph","Properties":{"id":"20240612193213-bhy7xnu","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"能促进骨折愈合，从而缩短治愈时间，尤以股骨干骨折最为突出，平均临床愈合日期为37天，但愈合时间长短与骨折类型及手法复位技术有明显关系。据认为，应用藜芦治疗，需在骨折两断端血运良好的条件下才能充分发挥其作用，用法：将黑藜芦根须洗净、晒干、研粉，加等量黄连素制成含量10毫克之片剂内服。成人每次30毫克，日服3次，用凉开水送下。用药时间依据临床愈合情况而定，一般约为2～4周。同时按常规予以复位及固定。服药后多数病例脉搏偏快，全身和局部有发热感；3例发现在肝功能正常情况下血清碱性磷酸酶均有所增高。"}]},{"ID":"20240612193213-bvpwrzo","Type":"NodeParagraph","Properties":{"id":"20240612193213-bvpwrzo","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612193213-blgvm5e","Type":"NodeParagraph","Properties":{"id":"20240612193213-blgvm5e","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"哕逆用吐药，亦反胃用吐法去痰积之义。吐药不一，常山吐疟痰，瓜蒂吐热痰，乌附尖吐湿痰，莱菔子吐气痰，藜芦则吐风痰也。\""}]},{"ID":"20240612193213-hug73a6","Type":"NodeParagraph","Properties":{"id":"20240612193213-hug73a6","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"藜芦，《本经》主蛊毒、咳逆及《别录》疗哕逆、喉痹不通者，皆取其宣壅导滞之力。苦为涌剂，故能使邪气痰热，胸膈部分之病，悉皆吐出也。辛能散结，故主鼻中息肉，苦能泄热杀虫，故主泄痢肠澼，头疡，疥瘙，杀诸虫毒也。疮疡皆湿热所生，湿热不去，则肌肉溃烂，苦寒能泻湿热，则马刀，恶疮，烂疮，死肌皆愈也。味至苦，入口即吐，故不入汤。\"\"藜芦辛苦有大毒，服一匕则令人胸中烦闷，吐逆不止，凡胸中有痰饮，或中蛊毒恶气者，止可借其上涌宣吐之力，获效一时，设病非关是证者，切勿沾唇，徒令人闷乱吐逆不止，亏损津液也。\""}]},{"ID":"20240612193213-y9hc900","Type":"NodeParagraph","Properties":{"id":"20240612193213-y9hc900","updated":"20240612193213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"附:"},{"Type":"NodeText","Data":"藜芦和常山都是驱痰药，但作用不同。李时珍说：\"吐药不一，常山吐疟痰。瓜丁吐热痰，乌附尖吐湿痰。莱菔子吐气痰。藜芦则吐风痰者也。\""}]},{"ID":"20240612193213-y083p7c","Type":"NodeParagraph","Properties":{"id":"20240612193213-y083p7c","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612193213-fd247yn","Type":"NodeParagraph","Properties":{"id":"20240612193213-fd247yn","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 此外。尚有下列几种同属植物，亦同供药用："}]},{"ID":"20240612193213-l8f82ww","Type":"NodeParagraph","Properties":{"id":"20240612193213-l8f82ww","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"①毛穗藜芦，基部叶长倒披针形或长圆状披针形，上部叶线状披针形，长约30厘米，宽1～5厘米。圆锥花序，花较稀疏；小花梗长1.5～2.5厘米；花被片6，黑紫色，椭圆形至长圆形，长5～6毫米，先端钝圆。分布辽宁、吉林等地."}]},{"ID":"20240612193213-rpeq6le","Type":"NodeParagraph","Properties":{"id":"20240612193213-rpeq6le","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"②毛叶藜芦，又名：岩棕、小棕。基部叶广卵形至广卵圆形，长达25厘米以上，宽达10厘米以上，茎部叶渐小，为披针形；叶背具灰白色绵毛。小花梗长2～5毫米；花被6，白色，椭圆形或矩圆形，长约10毫米，边缘有细锯齿及细柔毛。"}]},{"ID":"20240612193213-js0dogg","Type":"NodeParagraph","Properties":{"id":"20240612193213-js0dogg","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"生于高山草坡。分布湖北、四川、贵州等地。"}]},{"ID":"20240612193213-hbxo9ze","Type":"NodeParagraph","Properties":{"id":"20240612193213-hbxo9ze","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"③兴安藜芦，叶卵状椭圆形，下面密被白色绒毛。圆锥花序下枝较长，全形呈金字塔形；小花梗较花被短，花被淡黄绿色。分布东北、内蒙古、新疆等地。"}]},{"ID":"20240612193213-kk2w47p","Type":"NodeParagraph","Properties":{"id":"20240612193213-kk2w47p","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"④天目藜芦，基生叶阔长卵形至椭圆形，长28～36厘米，宽4～10厘米，茎部叶披针形，两面无毛。圆锥花序，花少数，褐绿色或褐黑色，花被片矩圆形或线状卵形。分布江苏、浙江、安徽、江西等地。"}]},{"ID":"20240612193213-zedrr3s","Type":"NodeParagraph","Properties":{"id":"20240612193213-zedrr3s","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑤蒜藜芦，叶广椭圆形至卵状矩圆形，长20～30厘米，宽7～12厘米，下面被短毛。小花梗与花被略等长，基部有卵形或椭圆形的小苞片；花被绿白色。生溪边、林下、山谷湿地。分布长江流域各地。"}]},{"ID":"20240612193213-ndupdre","Type":"NodeParagraph","Properties":{"id":"20240612193213-ndupdre","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"⑥小藜芦，参见\"小天蒜\"条。"}]},{"ID":"20240612193213-uaduziq","Type":"NodeParagraph","Properties":{"id":"20240612193213-uaduziq","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612193213-5joaytv","Type":"NodeParagraph","Properties":{"id":"20240612193213-5joaytv","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612193213-7pxyvkx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193213-7pxyvkx","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"《中华本草》：藜芦"}]},{"ID":"20240612193213-mxrtdiw","Type":"NodeParagraph","Properties":{"id":"20240612193213-mxrtdiw","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612193213-mcy47sg","Type":"NodeParagraph","Properties":{"id":"20240612193213-mcy47sg","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" Lí Lú"}]},{"ID":"20240612193213-epjl5d9","Type":"NodeParagraph","Properties":{"id":"20240612193213-epjl5d9","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612193213-zyrzzov","Type":"NodeParagraph","Properties":{"id":"20240612193213-zyrzzov","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 葱苒、葱葵、山葱、丰芦、蕙葵、公苒、葱苒、葱炎、藜卢、鹿白藜芦、鹿葱、憨葱、葱芦、葱管藜芦、旱葱、人头发、毒药草、七厘丹"}]},{"ID":"20240612193213-i2o1lek","Type":"NodeParagraph","Properties":{"id":"20240612193213-i2o1lek","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612193213-7e998cb","Type":"NodeParagraph","Properties":{"id":"20240612193213-7e998cb","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" Falsehellebore Root and Rhizome"}]},{"ID":"20240612193213-sd54w11","Type":"NodeParagraph","Properties":{"id":"20240612193213-sd54w11","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612193213-tc9ua56","Type":"NodeParagraph","Properties":{"id":"20240612193213-tc9ua56","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 出自《本草纲目》。"}]},{"ID":"20240612193213-4fi3elz","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612193213-4fi3elz","updated":"20240612193213"},"Children":[{"ID":"20240612193213-47ldtt1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612193213-47ldtt1","updated":"20240612193213"},"Children":[{"ID":"20240612193213-v8g0ymy","Type":"NodeParagraph","Properties":{"id":"20240612193213-v8g0ymy","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"陶弘景：藜芦近道处处有。根下极似葱而多毛。用之止剔取根，微炙之。"}]}]}]},{"ID":"20240612193213-l443bkb","Type":"NodeParagraph","Properties":{"id":"20240612193213-l443bkb","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：《图经》云，葬芦，叶似郁金、秦充、蔑荷等，根着龙胆，茎下多毛，夏生，冬雕估。今所在山谷皆有。八月采根，阴干。"}]},{"ID":"20240612193213-ggrtbdj","Type":"NodeParagraph","Properties":{"id":"20240612193213-ggrtbdj","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：黎芦，今陕西、山南东西州郡皆有之。三月生苗，叶青似初出棕心，又似车前，茎似葱白，青紫色，高五、六寸，上有黑皮褒茎，似棕皮，其花肉红色，根似马肠根，"}]},{"ID":"20240612193213-1dvpyxi","Type":"NodeParagraph","Properties":{"id":"20240612193213-1dvpyxi","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612193213-ege4o23","Type":"NodeParagraph","Properties":{"id":"20240612193213-ege4o23","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物藜芦、牯岭藜芦、毛穗藜芦、兴安藜芦及毛叶藜芦的根及根茎。"}]},{"ID":"20240612193213-gqlziue","Type":"NodeParagraph","Properties":{"id":"20240612193213-gqlziue","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Veratrum nigrum L. 2.Veratrum schindleri Loes.f. [V.cavaleriei Loes.f.；V.maximowiczii auct. Non Baker]. 3.Veratrum maackii Regel [V. mandschuricum Loes.f.]. 4.Veratrum dahuricum（Turcz.）Loes.f.[V.album L. var. dahuricum Turcz.]. 5.Veratrum grandiflorum （Maxim.）Loes.f.[V.puberulum Loes.f.]"}]},{"ID":"20240612193213-yqeugka","Type":"NodeParagraph","Properties":{"id":"20240612193213-yqeugka","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月未抽花葶前采挖，除去叶，晒干或烘干。"}]},{"ID":"20240612193213-nz3tz0m","Type":"NodeParagraph","Properties":{"id":"20240612193213-nz3tz0m","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612193213-kg4gezc","Type":"NodeParagraph","Properties":{"id":"20240612193213-kg4gezc","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.藜芦生于海拔1200-3000m的山坡林下或草丛中。 2.牯岭藜芦生于山坡林下荫湿处。 3.毛穗藜芦生于海拔400-1700m的山地林下或高山草甸。 4.兴安藜芦生于草甸和山坡湿草地。 5.生于海拔2600-400m的山坡林下或湿生草丛中。"}]},{"ID":"20240612193213-8f1p3ri","Type":"NodeParagraph","Properties":{"id":"20240612193213-8f1p3ri","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"资源分布：1.藜芦分布于东北、华北及陕西、甘肃、山东、河南、湖北、四川、贵州等地。 2.牯岭藜芦分布于江苏、安徽、浙江、江西、福建、湖北、湖南、广东和广西。 3.毛穗藜芦分布于黑龙江、吉林、辽宁、内蒙古和山东等地。 4.兴安藜芦分布于黑龙江、吉林和辽宁。 5.毛叶藜芦分布于浙江、江西、台湾、湖北、湖南、四川和云南。"}]},{"ID":"20240612193213-z571w3r","Type":"NodeParagraph","Properties":{"id":"20240612193213-z571w3r","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612193213-e1ay3q8","Type":"NodeParagraph","Properties":{"id":"20240612193213-e1ay3q8","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 1.藜芦，多年生草本，高60-100cm。植株粗壮，基部的鞘枯死后残留为有网眼的黑色纤维网。叶互生；无叶柄或茎上部叶具短柄；叶片薄革质，椭圆形、宽卵状椭圆形或卵状披针形，长22-25cm，宽约10cm，先端锐尖或渐尖，两面短毛。圆锥花序30-25cm，宽约10cm，先端锐尖或渐尖，两面短毛。圆锥花序30-50cm，侧生总状花序常具雄花，顶生总状花序常较偶生花序长2倍以上，几乎全部为两性化，总轴和枝轴密被白色绵状毛；花被片6，开展或略反折，长圆形，长5-8mm，宽约3mm，全缘，黑紫色；雄蕊6，花药肾形，背着，汇合为1室；子房卵形，3室，无毛，花柱3。蒴果卵圆形，具三钝棱，长1.5-2cm，宽1-1.3cm。种子扁平，具膜质翅。花、果期7-9月。 2.牯岭藜芦 多年生草本，高约1m。植株基部具棕褐色带网眼的纤维网。叶互生；叶柄长5-10cm；叶片宽椭圆形，有时狭长圆形，两面无毛。圆锥花序长而扩展，具多数近等长的侧生总状花序，总轴和枝轴具灰色白绵状毛，侧生花序的花梗长6-8mm；花被片6，淡黄绿色、绿白色或褐色，伸展或折反；雄蕊6，长约为花被片的2/3，花药近肾形，汇合成1室；蒴果椭圆形；种子扁平，具翅。花、果期6-10月。 3.毛穗藜芦 植株高60-160cm。茎较纤细，基部稍粗，中鞘直径约1cm，被棕褐色有网眼的纤维网。叶互生；叶柄长达10cm；叶片折扇状，长圆状披针形室狭长圆形，两面无毛。圆锥花序长25-50cm，常疏生较短的侧生花序，总轴和枝轴密生绵状毛；花梗长约为花被片的2倍，长可达1cm或更长，侧生花序上花梗明显短于主轴上花梗；花多数，疏生；花被片6，开展或反折，黑紫色；雄蕊6，长约为花被片的一半，花药近肾形，背着，汇合为1室。蒴果椭圆形；种子扁平，具膜质翅。花、果期7-9月。 4.兴安藜芦 植株高70-150cm。基部 具无网眼的纤维束。叶椭圆形或卵状椭圆形，基部无柄，抱茎，背面密被银白色短柔毛。圆锥花序近纺锤形，长20-60cm，具多数近等长的侧生总状花序，顶端总状花序近等长于侧生花序，总轴和枝轴密被白色短绵状毛；花被片6，近直立或稍开展，基部具柄，边缘啮状，背面具短毛；花被片淡黄绿色带苞，白色边缘；雄蕊6，长约为花被片的一半。蒴果椭圆形。种子扁平，具翅。花期6-8月。 5.毛叶藜芦 植株高大。基部 具无网眼的纤维束。叶宽椭圆形至长圆状披针形，基产抱茎，无柄，背面密被褐色或淡灰色短柔毛。圆锥花序塔状，长20-50cm，顶生总状花序较偶生总状花序长约1倍；花大，密集，花被片6，绿白色，基部略具柄，边缘具啮蚀状牙齿，外花被片背面密生短柔毛；雄蕊6，长约为花被片的3/5，花药近肾形，背着，汇合为1室；子房密被短柔毛，3室，花柱3。蒴果。种子扁平，具膜质翅。花、果期7-8月。"}]},{"ID":"20240612193213-xlx4pst","Type":"NodeParagraph","Properties":{"id":"20240612193213-xlx4pst","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612193213-wfj3jvl","Type":"NodeParagraph","Properties":{"id":"20240612193213-wfj3jvl","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）藜芦 根茎圆柱形或圆锥形，长2-4cm，直径0.5-1.5cm；表面棕黄色或土黄色，顶端残留叶基及黑色纤维，形如蓑衣，有的可见斜方形的网眼，下部着生10-30条细根。根细长略弯曲，长10-20cm，直径0.1-0.4cm；黄白色或黄褐色，具细密的横皱纹；体轻，质坚脆，断面类白色，中心有淡黄色细木心，与皮部分离。气微，味苦、辛，有刺喉感；粉末有强烈的催嚏性。 （2）牯岭藜芦 根茎呈圆柱形，长1-1.7cm，表面棕黄色，顶端残留叶柄残基及黑色纤维；下部着生10-20条细圆柱形根；长短不等，直径约0.2cm，微弯曲，表面暗褐色，并现皱缩条纹，质地坚脆，断面黄白色。味苦涩。 （3）毛重穗藜芦 根茎呈圆柱形，黄棕色，顶端残留叶柄残基及黑色纤维，下部密生20-30条。根细柱状，直径约0.2cm，长短不等，微弯曲，棕黄色，质脆，断面灰白色，叶苦涩。 （4）兴安藜芦 形似藜芦。根茎长1-1.5cm，直径1-2cm。根长5-8cm，直径1-2cm。 （5）毛叶藜芦 形似藜芦。根茎长1-2cm，直径0.8-1.3cm。根长4-12cm，直径1-3cm。 显微鉴别 （1）藜芦 根横切面：表皮细胞略径向延长，外壁稍厚，下皮为2-3列类圆形细胞，无细胞间隙。皮层占根绝大部分，外侧有大型切向裂隙，薄壁细胞含针晶束及淀粉粒。内皮层明显，内壁及侧壁增厚，胞腔成“V”字或“U”字形，通过细胞位于木质部束外方。中柱鞘为1列薄壁细胞，排列紧密。木质部发达，由木薄壁细胞和导管组成。导管类圆形，壁较厚，黄色微木化，原生导管较小，后生导管较大。韧皮部束位于木质部束弧角间，7-14原型，细胞较小。 根茎横切面：最外为黑褐色的后生皮层，约3-4列细胞；皮层约占半径的1/3，有周木型叶迹维管束散在；内皮层细胞内壁及侧壁增厚；中柱有多数维管束散在，近皮层处密，多为外韧型，内部者多为周木型，尚可见自中柱鞘发生的根迹组织。 （2）牯岭藜芦 根横切面 表皮细胞略径向延长；腔隙约占皮层宽度的1/3-1/4，针晶束较少；中柱甚小，初生木质部14-17原型。 （3）兴安藜芦 根横切面：表皮细胞略径向延长；腔隙约占皮层宽度的1/2-2/3，含草酸钲针晶束；中柱小，初生木质部8-12原型。"}]},{"ID":"20240612193213-zc9xbn3","Type":"NodeParagraph","Properties":{"id":"20240612193213-zc9xbn3","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612193213-u69grok","Type":"NodeParagraph","Properties":{"id":"20240612193213-u69grok","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 毒性：天目黎芦毒性甚大，其半数致死量与萱草根相似，但无蓄积中毒现象黑黎芦浸出液的半数致死量为1.78±0.38g/kg。兴安黎芦根的粉剂对口、鼻、眼脑膜有刺激作用，其中所含之黎芦定碱(Veratridine)中毒时主要影响横纹肌，动物死于呼吸停止国外产绿藜芦V．Viride (美国及加拿大)，白藜芦V．Alb-um (欧洲)根茎中的原藜芦碱 Protoveratrine A和 B等均有降压作用，并应用于高血压的治疗。藜芦定碱(作用与原藜芦碱不完全相同)静脉注射于狗，可引起血压突然下降，在迷走神经切除后，更大剂量可释放肾上腺索引起心率加快、血压上升，在原藜芦碱降压的基础上，蔡芦定碱可引起明显的升压作用。藜芦一类生物碱的降压原理系通过左心室、肺选走神经纤维反射性引起血管运动中枢抑制，小剂量反射性抑制呼吸，大剂量直接抑制呼吸中枢，口服量为肌肉注射量的5-20倍，黎芦碱的治疗量与中毒量距离很小，最常见者为恶心、呕吐，有的引起心律不齐，低血压，用阿托品及麻黄碱可纠正之，小量黎芦和其他降压药物合用，可发挥协同作用，降低毒性。"}]},{"ID":"20240612193213-tbh67d7","Type":"NodeParagraph","Properties":{"id":"20240612193213-tbh67d7","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612193213-7mvq2xi","Type":"NodeParagraph","Properties":{"id":"20240612193213-7mvq2xi","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 1.藜芦 根茎含去乙酰基原藜芦碱（deace-tylprotoveratrine）A，计默任碱（germerine），原藜芦碱（protoveratrine）A，藜芦马林碱（veramarine），计米定碱（germidine），双去乙酰基原藜芦碱（didesacetyl protoveratrine）A，藜芦嗪（verazine），新计布定碱（neogermbudine），芥芬胺（iervine），藜芦酰棋盘花碱（veratroylzygadenine），玉红芥芬胺（rubijervine），异玉红芥芬胺（isorubijervine），藜芦胺（veramine），藜芦碱胺（veratrum-alkamine）A、B、C、D，藜芦甾二烯胺（veratramine），藜芦米宁（veramiline），3，15-二当归酰基计明胺（3，15-diangeloylgermine），茄咪啶（solamidine），β-谷甾醇（β-sitosterol），β-谷甾醇硬脂酸酯（β-sitosterylstearate），胡萝卜甙（daucosterol），蜡酸（cerotic acid），硬脂酸（stearic acid）。 2.毛叶藜芦 根、根茎含棋盘花辛碱（zygacine），芥芬胺，藜芦甾二烯胺，藜芦嗪（verzine），茄啶（solanidine）。毛叶藜芦定碱（hakurirodine）及玉红芥芬碱（rubijervine）等。 3.兴安藜芦 地下部分含：伪芥芬胺（pseudojervng）藜芦碱甙（veratrosine），藜芦甾二烯胺，芥芬胺，藜芦定（verdine），玉红芥芬胺，藜芦马林碱（veramarine），藜芦酰棋盘花胺，异玉红芥芬胺，藜芦嗪，藜芦胺。4.毛穗藜芦 根茎含藜芦嗪，当归酰棋盘花胺（angeloylaygadenine），毛穗藜芦碱（maackinine），计马尼春碱（germanitrine），棋盘花碱（zygadenine），藜芦嗪宁（verazinine）。 5.天目藜芦 根及根茎含天目藜芦碱（tiemulilumine），天目藜芦宁碱（tiemuliluminine）。 6.光脉藜芦 根含藜芦碱甙，23-O-β-D-吡喃葡萄糖基-20-异藜芦甾二烯胺（23-O-β-Dglucopyranosyl-20-isoveratramine），（22S，23R，25S）-23-O-β-D-吡员葡萄糖基-5，11，13-藜芦甾三烯胺-3β，23-二醇[（22S，23R，25S）-23-O-β-D-glucopyranosyl-5，11，13-veratratrienine-3β，23-diol]。"}]},{"ID":"20240612193213-f2welxi","Type":"NodeParagraph","Properties":{"id":"20240612193213-f2welxi","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612193213-lsyheb2","Type":"NodeParagraph","Properties":{"id":"20240612193213-lsyheb2","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 1.降压作用：藜芦乙醇提取物0.05-0.15g/kg给麻醉狗静脉注射，能使血压降低，并伴有心率减慢，呼吸抑制。藜芦降压作用是反射性的，即药物作用于心、肺和颈动脉窦的感受区，通过迷走神经反射地引起血压下降。本品对慢性高血压狗口服用1-2.5g/kg，连服14天，亦有降压作用。藜芦所含总生物碱有反射性降压和减慢心率的作用，其中红藜芦碱（卢比介文胺）猫静脉注射的降压剂量为0.03mg/kg；计末林碱5-10μg/kg猫静脉注射可使血压下降70% ，维持数小时之久；藜芦碱（介文胺）小鼠静脉注射的半数致死量为9.3mg/kg。天目藜芦碱甲、乙均有降压作用。天目藜芦碱乙作用较强，猫静脉注射0.45-0.6mg/kg引起反射性降压32%-75% ，维持15-60分钟，无块速耐受性。"}]},{"ID":"20240612193213-2mfzvuj","Type":"NodeParagraph","Properties":{"id":"20240612193213-2mfzvuj","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"2.杀虫：藜芦1%-5%水浸液对蚊、蝇、蚤、虱有强烈的毒杀作用。"}]},{"ID":"20240612193213-bt37a97","Type":"NodeParagraph","Properties":{"id":"20240612193213-bt37a97","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"3.其它作用：藜芦所含总生物碱具强烈局部刺激作用，口服能催吐祛痰。"}]},{"ID":"20240612193213-nbzr7r3","Type":"NodeParagraph","Properties":{"id":"20240612193213-nbzr7r3","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"4.毒性：成人口服藜芦须根70mg即发生中毒。藜芦中毒，出现恶心，呕吐，抑制心肌的兴奋传导，可出现传导阻滞。藜芦煎剂小鼠灌胃的半数致死量为1.78g/kg。天目藜芦碱乙给小鼠皮下及静脉注射的半数致死量分别为26、3.2mg/kg。"}]},{"ID":"20240612193213-5e15o5y","Type":"NodeParagraph","Properties":{"id":"20240612193213-5e15o5y","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612193213-ml1l7ja","Type":"NodeParagraph","Properties":{"id":"20240612193213-ml1l7ja","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 取原药材，除去杂质。"}]},{"ID":"20240612193213-swna7b3","Type":"NodeParagraph","Properties":{"id":"20240612193213-swna7b3","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612193213-1gojl8a","Type":"NodeParagraph","Properties":{"id":"20240612193213-1gojl8a","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末0.2g，加3%稀盐酸5ml，水浴上加热5min，时时振摇，滤过。取滤液1ml，加碘化铋钾试剂1-2滴，有红棕色沉淀。另取滤液1ml，加碘化汞钾试液1-2滴。显淡黄色沉淀。"}]},{"ID":"20240612193213-cd8vnn8","Type":"NodeParagraph","Properties":{"id":"20240612193213-cd8vnn8","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612193213-hh9s98p","Type":"NodeParagraph","Properties":{"id":"20240612193213-hh9s98p","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 肺；胃；肝经"}]},{"ID":"20240612193213-7r7gxmw","Type":"NodeParagraph","Properties":{"id":"20240612193213-7r7gxmw","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612193213-fvy1rsv","Type":"NodeParagraph","Properties":{"id":"20240612193213-fvy1rsv","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 苦；辛；寒；有毒"}]},{"ID":"20240612193213-ftvm0k5","Type":"NodeParagraph","Properties":{"id":"20240612193213-ftvm0k5","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612193213-7ibibdt","Type":"NodeParagraph","Properties":{"id":"20240612193213-7ibibdt","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 体虚气弱及孕妇忌服。"}]},{"ID":"20240612193213-3y0nv3m","Type":"NodeParagraph","Properties":{"id":"20240612193213-3y0nv3m","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：黄连为之使；反细李、芍药、五参，恶大黄。"}]},{"ID":"20240612193213-l2c72qe","Type":"NodeParagraph","Properties":{"id":"20240612193213-l2c72qe","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：畏葱白。服之吐不止，钦葱汤即止。"}]},{"ID":"20240612193213-g9tm0an","Type":"NodeParagraph","Properties":{"id":"20240612193213-g9tm0an","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：服之令人烦闷吐逆，大损津液，虚者慎。"}]},{"ID":"20240612193213-j08jmzb","Type":"NodeParagraph","Properties":{"id":"20240612193213-j08jmzb","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612193213-1dkmdt3","Type":"NodeParagraph","Properties":{"id":"20240612193213-1dkmdt3","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 涌叶风痰；杀虫。主中风痰壅；癫痫；虐疾；疥癣；恶疮"}]},{"ID":"20240612193213-7z9qnfn","Type":"NodeParagraph","Properties":{"id":"20240612193213-7z9qnfn","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612193213-n3tnqfy","Type":"NodeParagraph","Properties":{"id":"20240612193213-n3tnqfy","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散，0.3-0.6g。外用：适量，研末，油或水调涂。"}]},{"ID":"20240612193213-j15v9xk","Type":"NodeParagraph","Properties":{"id":"20240612193213-j15v9xk","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612193213-ebmlcm9","Type":"NodeParagraph","Properties":{"id":"20240612193213-ebmlcm9","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" ①治诸风痰饮： 藜芦十分，郁金一分，为末。每以一字，温浆水一盏，各服探吐。(《经验方》)②治中风不语，喉中如曳锯声，口中涎沫： 藜芦一分，天南星一个(去浮皮，于脐子上陷一个坑子，纳入陈醋二橡斗子，四面用火逼令黄色)。同一处捣，再研极细，用生面为丸，如赤豆大，每服三丸，温酒下。(《经验后方》)③治头痛不可忍：藜芦一茎，暴干，捣罗为散，八麝香麻子许，研匀吹鼻中。(《圣济总录》吹鼻麝香散)④治头痛鼻塞脑闷：黎芦(研)半两，黄连(去须)三分。上二味，捣研为散，每用少许，入鼻中。(《圣济总录》通顶散)⑤治黄疸： 藜芦着灰中炮之，小变色，捣为末，水服半钱匕，小吐，不过数服。(《肘后方》)⑥治老疟久不断者：藜芦、皂荚(炙)各一两，巴豆二十五枚(熬令黄)。依法捣，蜜丸如小豆。空心服一九，未发时一九，临发时又一丸，匆饮食。(《补缺肘后方》)⑦治久疟不能饮食，胸中郁郁如吐，欲吐不能吐者，宜吐，则已：大藜芦末半钱，温水调下，以吐为度。(《素问病机保命集》藜芦散)⑧治诸疯疮，经久则生虫：藜芦(去芦头)、白矾(烧灰细研)、松脂(细研)、雄黄(纲研)、苦参各二两(锉)。上药，先捣藜芦、苦参为末，入猪脂一斤相和，煎十余沸，绵滤去滓，次入松脂、雄黄、自矾等末，搅令匀，待冷，收于瓷合中，旋取涂之，以瘥为度。(《圣惠方》藜芦菜散)⑨治鼻中肉渐大，气息不通：藜声三分(去芦头，捣罗为末)，雄黄一分(细研)，雌黄一分(细研)。上药，同研令匀，每用时以蜜调散，用纸拈干，展药，点于肉上，每日三度，则自消化，不得涂药在于两畔，恐涕落于药上。(《圣惠方》)⑩治牙疼：纳菱芦末于牙子L中，匆咽汁。(喀千金翼方》)(11)治自秃：末蓉芦，以腊月猪密和涂之，先用盐汤没，乃敷。(名补缺肘后方》)(12)治头生肌虱：葫芦末掺之。(《亿斋直招方》)⑩治疥癣：蓉芦，细捣为末，以生油调敷之。(《斗门方》)"}]},{"ID":"20240612193213-262kndg","Type":"NodeParagraph","Properties":{"id":"20240612193213-262kndg","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612193213-evcsx1q","Type":"NodeParagraph","Properties":{"id":"20240612193213-evcsx1q","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 1.治疗疟疾：取天目藜芦3根(1寸长)，插入鸡蛋(l个)内烧熟。去药吃蛋。于发作前 1-2小时服。忌鱼腥；孕妇及溃疡病患者忌服。治疗现症病人120例，痊愈100例，好转15例，无效5例；休止期患者36例，痊愈33例，无效3例。"}]},{"ID":"20240612193213-w3wy8qz","Type":"NodeParagraph","Properties":{"id":"20240612193213-w3wy8qz","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"2.治疗骨折：能促进骨折愈合，从而缩短治愈时间，尤以股骨干骨折最为突出，平均临床愈合日期为37天。但愈合时间长短与骨折类型及手法复位技术有明显关系。据认为，应用蔡芦治疗，需在骨折两断端血运良好的条件下才能充分发挥其作用。用法：将黑蓉芦根须统净、晒干、研粉，加等量黄连索制成含量10mg之片剂内服。成人每次30mg，曰服3次，用凉开水送下。用药时间依据临床愈合情况而定，一般约为2-4周。同时按常规予以复位及固定。服药后多数病例脉搏偏快，全身和局部有发热感；3例发现在肝功能正常情况下血清碱性磷酸酶均有所增高。"}]},{"ID":"20240612193213-njlu6az","Type":"NodeParagraph","Properties":{"id":"20240612193213-njlu6az","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612193213-b311xew","Type":"NodeParagraph","Properties":{"id":"20240612193213-b311xew","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：哕逆用吐药，亦反胃用吐法去痰积之义。吐药不一，常山吐疟痰，瓜蒂吐热痰，乌附尖吐湿痰，莱菔子吐气痰，藜芦则吐风痰也。"}]},{"ID":"20240612193213-pmk8w23","Type":"NodeParagraph","Properties":{"id":"20240612193213-pmk8w23","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：藜芦，《本经》主蛊毒、咳逆及《别录》疗哕逆、喉痹不通者，皆取其宣壅导滞之力。苦为涌剂，故能使邪气痰热，胸脯部分之病，悉皆吐出也。辛能散结，故主鼻中息肉，苦能泄热杀虫，故主泄痢肠，头疡，疥瘙，杀诸虫毒也。疮疡皆湿热所生，湿热不去，则肌肉溃烂，苦寒能泻湿热，则马刀，恶疮，烂淹，死肌皆愈也。味至苦，入口即吐，故不入汤。藜芦辛苦有大毒，服一匕则令人胸中烦闷，吐逆不止，凡脑中有痰次，或中蛊毒恶气者，止可借其上涌宣吐之力，获效一时，设病非关是证者，切匆沾唇，徒令人闷乱吐逆不止，亏损律液也。"}]},{"ID":"20240612193213-gqh8s8t","Type":"NodeParagraph","Properties":{"id":"20240612193213-gqh8s8t","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"3.《本经》：主蛊毒，咳逆，泄痢，肠游，头疡，疥瘤，恶疮，杀谐虫毒，去死肌。"}]},{"ID":"20240612193213-98fly5b","Type":"NodeParagraph","Properties":{"id":"20240612193213-98fly5b","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"4.《别录》：疗哕逆，喉痹不通，鼻中息肉，马刀，烂疮。"}]},{"ID":"20240612193213-1zgv354","Type":"NodeParagraph","Properties":{"id":"20240612193213-1zgv354","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"5.《药性论》：主上气，去积年脓血泄痢。治恶风疮、疥癣、头秃，杀虫。"}]},{"ID":"20240612193213-2jhgyrg","Type":"NodeParagraph","Properties":{"id":"20240612193213-2jhgyrg","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"6.《本草图经》：大吐上隔风涎，暗风痫病，小儿助。用钱匕一字则恶吐人，又用通顶，令人嚏。"}]},{"ID":"20240612193213-p0kxdad","Type":"NodeParagraph","Properties":{"id":"20240612193213-p0kxdad","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"7.《四川武隆药植图志》：治毒蛇咬伤及杀虫用。"}]},{"ID":"20240612193213-nsx4tsv","Type":"NodeParagraph","Properties":{"id":"20240612193213-nsx4tsv","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612193213-tqhb8pw","Type":"NodeParagraph","Properties":{"id":"20240612193213-tqhb8pw","updated":"20240612193213"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612193214-brvxlg9","Type":"NodeThematicBreak","Properties":{"id":"20240612193214-brvxlg9"}},{"ID":"20240612193215-vgubmvf","Type":"NodeParagraph","Properties":{"id":"20240612193215-vgubmvf"}}]}