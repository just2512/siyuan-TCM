{"ID":"20240504154425-9po50fz","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240504154425-9po50fz","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504154425-9po50fz\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504154425-fb2m0r3\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240614162145-9mr0v4a\u0026quot;,\u0026quot;scrollTop\u0026quot;:6047\u0026#125;","title":"016青石黄石白石黑石赤石脂","type":"doc","updated":"20240727125632"},"Children":[{"ID":"20240617171033-ugs5fg7","Type":"NodeParagraph","Properties":{"id":"20240617171033-ugs5fg7","updated":"20240617171036"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"青"}]},{"ID":"20240617170744-itat33o","Type":"NodeParagraph","Properties":{"id":"20240617170744-itat33o","updated":"20240617170744"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240617170744-9wb1s3u.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240617171037-e12w8g0","Type":"NodeParagraph","Properties":{"id":"20240617171037-e12w8g0","updated":"20240617171039"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄"}]},{"ID":"20240617170930-gvb07v1","Type":"NodeParagraph","Properties":{"id":"20240617170930-gvb07v1","updated":"20240617172525"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（缺）"}]},{"ID":"20240617170423-f6dv1gp","Type":"NodeParagraph","Properties":{"id":"20240617170423-f6dv1gp","updated":"20240617171045"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白"}]},{"ID":"20240617171337-14k8zfp","Type":"NodeParagraph","Properties":{"id":"20240617171337-14k8zfp","updated":"20240617171337"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240617171337-cuy71xg.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240617171148-qyoncjn","Type":"NodeParagraph","Properties":{"id":"20240617171148-qyoncjn","updated":"20240617171148"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240617171148-tv3akoa.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240617171152-cgbxyny","Type":"NodeParagraph","Properties":{"id":"20240617171152-cgbxyny","updated":"20240617172146"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黑"}]},{"ID":"20240617172150-2efp8g8","Type":"NodeParagraph","Properties":{"id":"20240617172150-2efp8g8"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（缺"},{"Type":"NodeText","Data":"）"}]},{"ID":"20240617171341-hq28gsj","Type":"NodeParagraph","Properties":{"id":"20240617171341-hq28gsj","updated":"20240617171343"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"赤"}]},{"ID":"20240617170527-cs6lle4","Type":"NodeParagraph","Properties":{"id":"20240617170527-cs6lle4","updated":"20240617171444"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240617170527-5l6q25m.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240617170532-hg33asd","Type":"NodeParagraph","Properties":{"id":"20240617170532-hg33asd","updated":"20240617170606"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240617170606-jkomnx0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727125631-dp9zphe","Type":"NodeParagraph","Properties":{"id":"20240727125631-dp9zphe","updated":"20240727125632"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"赤石脂"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/赤石脂-20240205165124-zd3gqqv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240614161709-gkva00j","Type":"NodeThematicBreak","Properties":{"id":"20240614161709-gkva00j","updated":"20240614161709"}},{"ID":"20240614161709-8ljcf4e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161709-8ljcf4e","updated":"20240614161709"},"Children":[{"Type":"NodeText","Data":"五石脂《吴普本草》"}]},{"ID":"20240614161709-ip5dtfk","Type":"NodeParagraph","Properties":{"id":"20240614161709-ip5dtfk","updated":"20240614161709"},"Children":[{"Type":"NodeText","Data":"《御览》卷九百八十七"}]},{"ID":"20240614161709-26q3jdm","Type":"NodeParagraph","Properties":{"id":"20240614161709-26q3jdm","updated":"20240614161709"},"Children":[{"Type":"NodeText","Data":"一名青、赤、黄、白、黑符。青符，神农∶甘。雷公∶酸，无毒。桐君∶辛，无毒。李氏∶小寒。生南山或海涯。采无时。"}]},{"ID":"20240614162228-4z0gmg9","Type":"NodeThematicBreak","Properties":{"id":"20240614162228-4z0gmg9"}},{"ID":"20240614162229-h4taamy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162229-h4taamy","updated":"20240614162233"},"Children":[{"Type":"NodeText","Data":"五石脂《神农本草经百种录》"}]},{"ID":"20240614162229-m5envvi","Type":"NodeParagraph","Properties":{"id":"20240614162229-m5envvi","updated":"20240614162229"},"Children":[{"Type":"NodeText","Data":"青石、赤石、黄石、白石、黑石脂等，味甘平。主黄胆，泄痢肠 ，脓血阴蚀，皆湿气在太阴、阳明之病也。下血赤白，收涩之功。邪气，正气敛则邪气除。痈肿，疽痔，恶疮，头疡，疥瘙。此皆湿郁所生之毒。能除湿则诸病亦退。久服，补髓益气，肥健不饥，轻身延年。敛精气而燥脾土，故有此效。五石脂各随五色补五脏。性治略同，而所补之脏各异。"}]},{"ID":"20240614162229-sv8qryw","Type":"NodeParagraph","Properties":{"id":"20240614162229-sv8qryw","updated":"20240614162229"},"Children":[{"Type":"NodeText","Data":"石脂得金土杂气以成，故湿土之质，而有燥金之用。脾恶湿，燥能补之。然其质属土，不至过燥，又得秋金敛藏之性，乃治湿之圣药也。"}]},{"ID":"20240614162313-daqkv56","Type":"NodeThematicBreak","Properties":{"id":"20240614162313-daqkv56"}},{"ID":"20240614162323-0an6q6q","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240614162323-0an6q6q","updated":"20240614162427"},"Children":[{"Type":"NodeText","Data":"五色石脂《本草纲目》"}]},{"ID":"20240614162323-42is8gw","Type":"NodeParagraph","Properties":{"id":"20240614162323-42is8gw","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"（《本经》上品）"}]},{"ID":"20240614162323-imbmuxw","Type":"NodeParagraph","Properties":{"id":"20240614162323-imbmuxw","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"校正：并入五种石脂。"}]},{"ID":"20240614162323-yepospg","Type":"NodeParagraph","Properties":{"id":"20240614162323-yepospg","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【释名】〔时珍曰〕膏之凝者曰脂。此物性粘，固济炉鼎甚良，盖兼体用而言也。"}]},{"ID":"20240614162323-oxdfu3d","Type":"NodeParagraph","Properties":{"id":"20240614162323-oxdfu3d","updated":"20240614162423"},"Children":[{"Type":"NodeText","Data":"【集解】〔别录曰〕五色石脂生南山之阳山谷中。又曰：青石脂生齐区山及海涯。黄石脂生嵩高山，色如莺雏。黑石脂生颍川阳城。白石脂生太山之阴。赤石脂生济南、射阳，又太山之阴。并采无时。〔普曰〕五色五脂一名五色符。青符生南山或海涯。黄符生嵩山，色如豘脑、雁雏。黑符生洛西山空地。白符生少室天娄山或太山。赤符生少室或太山，色绛滑如脂。〔弘景曰〕今俗惟用赤石、白石二脂。好者出吴郡，亦出武陵、建平、义阳。义阳者出【盟】县界东八十里，状如豘脑，赤者鲜红可爱，随采复生。余三色石脂无正用。但黑石脂入画用尔。〔恭曰〕义阳即申州，所出乃桃花石，非石脂也。白石脂今出慈阳诸山，胜于余处者。赤石脂今出虢州卢氏县，泽州陵川县，又慈州吕乡县，宜州诸山亦有，并色理鲜腻为佳。二脂太山不闻有之，旧出苏州、余杭山，今不收采。〔承曰〕今苏州见贡赤白二石脂，但入药不甚佳。惟延州山中所出最良，揭两石中取之。〔颂曰〕白石脂、赤石脂，今惟潞州出之，潞与慈州相近也。〔宗奭曰〕赤、白石脂四方皆有，以理腻粘舌缀唇者为上。"}]},{"ID":"20240614162323-c8mf2nl","Type":"NodeParagraph","Properties":{"id":"20240614162323-c8mf2nl","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【修治】〔敩曰〕凡使赤脂，研如粉，新汲水飞过三度，晒干用。〔时珍曰〕亦有火煅水飞者。"}]},{"ID":"20240614162323-bjrj99u","Type":"NodeParagraph","Properties":{"id":"20240614162323-bjrj99u","updated":"20240614162421"},"Children":[{"Type":"NodeText","Data":"【气味】五种石脂，并甘、平。（〔大明曰〕并温，无毒。畏黄芩、大黄、官桂）"}]},{"ID":"20240614162323-vr6fkuk","Type":"NodeParagraph","Properties":{"id":"20240614162323-vr6fkuk","updated":"20240614162418"},"Children":[{"Type":"NodeText","Data":"【主治】黄疸，泄痢肠澼脓血，阴蚀下血赤白，邪气痈肿，疽痔恶疮，头疡疥瘙。久服补髓益气，肥健不饥，轻身延年。五石脂各随五色，补五脏。（《本经》）治泄痢，血崩带下，吐血衄血，涩精淋沥，除烦，疗惊悸，壮筋骨，补虚损。久服悦色。治疮疖痔漏，排脓。（大明）"}]},{"ID":"20240614162323-h2lm9xx","Type":"NodeParagraph","Properties":{"id":"20240614162323-h2lm9xx","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"青石脂"}]},{"ID":"20240614162323-3y3adn6","Type":"NodeParagraph","Properties":{"id":"20240614162323-3y3adn6","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【气味】酸，平，无毒。（〔普曰〕青符：神农：甘。雷公：酸，无毒。桐君：辛，无毒。李当之：大寒）"}]},{"ID":"20240614162323-zuqxvfr","Type":"NodeParagraph","Properties":{"id":"20240614162323-zuqxvfr","updated":"20240614162416"},"Children":[{"Type":"NodeText","Data":"【主治】养肝胆气，明目，疗黄疸泄痢肠澼，女子带下百病，及疽痔恶疮。久服补髓益气，不饥延年。（《别录》）"}]},{"ID":"20240614162323-xfk5w5r","Type":"NodeParagraph","Properties":{"id":"20240614162323-xfk5w5r","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"黄石脂"}]},{"ID":"20240614162323-rqe5uij","Type":"NodeParagraph","Properties":{"id":"20240614162323-rqe5uij","updated":"20240614162412"},"Children":[{"Type":"NodeText","Data":"【气味】苦，平，无毒。（〔普曰〕黄符：雷公：苦。李当之：小寒。〔之才曰〕曾青为之使，恶细辛，畏蜚廉、黄连、甘草。〔敩曰〕服之忌卵味）"}]},{"ID":"20240614162323-ls7yxgz","Type":"NodeParagraph","Properties":{"id":"20240614162323-ls7yxgz","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【主治】养脾气，安五脏，调中，大人小儿泄痢肠澼下脓血，去白虫，除黄疸痈疽虫。久服轻身延年。（《别录》）"}]},{"ID":"20240614162323-vevgym7","Type":"NodeParagraph","Properties":{"id":"20240614162323-vevgym7","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"黑石脂（〔别录曰〕一名石墨，一名石涅。〔时珍曰〕此乃石脂之黑者，亦可为墨，其性粘舌，与石炭不同。南人谓之画眉石。许氏《说文》云：黛，画眉石也）"}]},{"ID":"20240614162323-h0h13eg","Type":"NodeParagraph","Properties":{"id":"20240614162323-h0h13eg","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【气味】咸，平，无毒。（〔普曰〕黑符：桐君：甘，无毒）"}]},{"ID":"20240614162323-61l2191","Type":"NodeParagraph","Properties":{"id":"20240614162323-61l2191","updated":"20240614162409"},"Children":[{"Type":"NodeText","Data":"【主治】养肾气，强阴，主阴蚀疮，止肠澼泄痢，疗口疮咽痛。久服益气不饥延年。（《别录》）"}]},{"ID":"20240614162323-7bjqdwe","Type":"NodeParagraph","Properties":{"id":"20240614162323-7bjqdwe","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"白石脂"}]},{"ID":"20240614162323-eh9nkq8","Type":"NodeParagraph","Properties":{"id":"20240614162323-eh9nkq8","updated":"20240614162408"},"Children":[{"Type":"NodeText","Data":"【气味】甘、酸，平，无毒。（〔普曰〕白符，一名随。岐伯、雷公：酸，无毒。桐君：甘，无毒。扁鹊：辛。李当之：小寒。〔权曰〕甘、辛。〔杲曰〕温。〔之才曰〕得厚朴、米汁饮，止便脓。燕屎为之使。恶松脂。畏黄芩。〔颂曰〕畏黄连、甘草、飞廉、马目毒公）"}]},{"ID":"20240614162323-kd9v10n","Type":"NodeParagraph","Properties":{"id":"20240614162323-kd9v10n","updated":"20240614162405"},"Children":[{"Type":"NodeText","Data":"【主治】养肺气，厚肠，补骨髓，疗五脏惊悸不足，心下烦，止腹痛下水，小肠澼，热溏便脓血，女子崩中漏下赤白沃，排痈疽疮痔。久服安心不饥，轻身延年。（《别录》）涩大肠。（甄权）"}]},{"ID":"20240614162323-hm4bc4z","Type":"NodeParagraph","Properties":{"id":"20240614162323-hm4bc4z","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【附方】（旧四，新二）"}]},{"ID":"20240614162323-ylz8xo4","Type":"NodeParagraph","Properties":{"id":"20240614162323-ylz8xo4","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"小儿水痢（形羸。不胜汤药。白石脂半两研粉，和白粥空肚食之。《子母秘录》）"}]},{"ID":"20240614162323-t787j9l","Type":"NodeParagraph","Properties":{"id":"20240614162323-t787j9l","updated":"20240614162402"},"Children":[{"Type":"NodeText","Data":"小儿滑泄（白龙丸（白石脂、白龙骨等分为末，水丸黍米大。每量大小，木瓜、紫苏汤下。《全幼心鉴》）"}]},{"ID":"20240614162323-s7xtuso","Type":"NodeParagraph","Properties":{"id":"20240614162323-s7xtuso","updated":"20240614162400"},"Children":[{"Type":"NodeText","Data":"久泄久痢（白石脂、干姜等分研，百沸汤和面为稀糊搜之，并手丸梧子大。每米饮下三十丸。《斗门方》）"}]},{"ID":"20240614162323-vdz5sx2","Type":"NodeParagraph","Properties":{"id":"20240614162323-vdz5sx2","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"儿脐汁出（赤肿，白石脂末熬温，白石脂末熬温，扑之，日三度。勿揭动。韦宙《独行方》）"}]},{"ID":"20240614162323-y7f56d6","Type":"NodeParagraph","Properties":{"id":"20240614162323-y7f56d6","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"儿脐血出多啼，方同上。《寇氏衍义》）"}]},{"ID":"20240614162323-1oqstn9","Type":"NodeParagraph","Properties":{"id":"20240614162323-1oqstn9","updated":"20240617115337"},"Children":[{"Type":"NodeText","Data":"粉滓面䵟（白石脂六两，白敛十二两，为末，鸡子白和。夜涂旦洗。《圣济录》）"}]},{"ID":"20240614162323-boxafks","Type":"NodeParagraph","Properties":{"id":"20240614162323-boxafks","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"赤石脂"}]},{"ID":"20240614162323-easxqm3","Type":"NodeParagraph","Properties":{"id":"20240614162323-easxqm3","updated":"20240614162356"},"Children":[{"Type":"NodeText","Data":"【气味】甘、酸、辛，大温，无毒。（〔普曰〕赤符：神农、雷公：甘。黄帝、扁鹊：无毒。李当之：小寒。〔之才曰〕畏芫花，恶大黄、松脂。〔颂曰〕古人亦单服食，云发则心痛，饮热酒不解。用绵裹葱、豉，煮水饮之）"}]},{"ID":"20240614162323-ysip4u2","Type":"NodeParagraph","Properties":{"id":"20240614162323-ysip4u2","updated":"20240614162352"},"Children":[{"Type":"NodeText","Data":"【主治】养心气，明目益精，疗腹痛肠澼，下痢赤白，小便利，及痈疽疮痔，女子崩中漏下，产难胞衣不出。久服补髓好颜色，益智不饥，轻身延年。（《别录》）补五脏虚乏。（甄权）补心血，生肌肉，厚肠胃，除水湿，收脱肛。（时珍）"}]},{"ID":"20240614162323-vqk2pwv","Type":"NodeParagraph","Properties":{"id":"20240614162323-vqk2pwv","updated":"20240614162349"},"Children":[{"Type":"NodeText","Data":"【发明】〔弘景曰〕五色石脂，《本经》疗体亦相似，《别录》分条具载，今俗惟用赤、白二脂断下痢耳。〔元素曰〕赤、白石脂俱甘、酸，阳中之阴，固脱。〔杲曰〕降也，阳中阴也。其用有二：固肠胃有收敛之能，下胎衣无推荡之峻。〔好古曰〕涩可去脱，石脂为收敛之剂，赤入丙，白入庚。〔时珍曰〕五石脂皆手足阳明药也。其味甘，其气温，其体重，其性涩。涩而重，故能收湿止血而固下；甘而温，故能益气生肌而调中。中者，肠胃肌肉惊悸黄疸是也；下者，肠澼泄痢崩带失精是也。五种主疗，大抵相同。故《本经》不分条目，但云各随五色补五脏。《别录》虽分五种，而性味主治亦不甚相远，但以五味配五色为异，亦是强分尔。赤白二种，一入气分，一入血分。故时用尚之。张仲景用桃花汤治下痢便脓血。取赤石脂之重涩，入下焦血分而固脱；干姜之辛温，暖下焦气分而补虚；粳米之甘温，佐石脂，干姜而润肠胃也。"}]},{"ID":"20240614162323-pkpvs7n","Type":"NodeParagraph","Properties":{"id":"20240614162323-pkpvs7n","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"【附方】（旧五，新七）"}]},{"ID":"20240614162323-o64kghx","Type":"NodeParagraph","Properties":{"id":"20240614162323-o64kghx","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"小儿疳泻（赤石脂末，米饮调服半钱，立瘥。加京芎等分，更妙。《斗门方》）"}]},{"ID":"20240614162323-da84j2l","Type":"NodeParagraph","Properties":{"id":"20240614162323-da84j2l","updated":"20240614162347"},"Children":[{"Type":"NodeText","Data":"大肠寒滑（小便精出。赤石脂、干姜各一两，胡椒半两。为末，醋糊丸梧子大。每空心米饮下五、七十丸。有人病此，热药服至一斗二升，不效；或教服此，终四剂而息。《寇氏衍义》）"}]},{"ID":"20240614162323-0kj8ces","Type":"NodeParagraph","Properties":{"id":"20240614162323-0kj8ces","updated":"20240614162345"},"Children":[{"Type":"NodeText","Data":"赤白下痢（赤石脂末，饮服一钱。《普济方》）"}]},{"ID":"20240614162323-0vhxu0c","Type":"NodeParagraph","Properties":{"id":"20240614162323-0vhxu0c","updated":"20240614162343"},"Children":[{"Type":"NodeText","Data":"冷痢腹痛（下白冻如鱼脑。桃花丸：赤石脂煅，干姜炮，等分为末，蒸饼和丸。量大小服，日三服。《和剂局方》）"}]},{"ID":"20240614162323-axmq4e0","Type":"NodeParagraph","Properties":{"id":"20240614162323-axmq4e0","updated":"20240614162341"},"Children":[{"Type":"NodeText","Data":"老人气痢（虚冷。赤石脂五两水飞，白面六两，水煮熟，入葱、酱作臛。空心食三、四次即愈。《养老方》）"}]},{"ID":"20240614162323-gpls3ng","Type":"NodeParagraph","Properties":{"id":"20240614162323-gpls3ng","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"伤寒下痢（便脓血不止。桃花汤主之。赤石脂一斤，一半全用，一半末用，干姜一两，粳米半升，水七升，煮米熟去滓。每服七合。纳末方寸匕，日三服，愈乃止。《张仲景方》）"}]},{"ID":"20240614162323-8mdso62","Type":"NodeParagraph","Properties":{"id":"20240614162323-8mdso62","updated":"20240614162339"},"Children":[{"Type":"NodeText","Data":"痢后脱肛（赤石脂、伏龙肝为末，傅之。一加白矾。《钱氏小儿方》）"}]},{"ID":"20240614162323-s8pdfjw","Type":"NodeParagraph","Properties":{"id":"20240614162323-s8pdfjw","updated":"20240614162338"},"Children":[{"Type":"NodeText","Data":"反胃吐食（绝好赤石脂为末。蜜丸梧子大。每空腹姜汤下一、二十丸。先以巴豆仁一枚，勿令破，以津吞之，后乃服药。《圣惠方》）"}]},{"ID":"20240614162323-y7tquzd","Type":"NodeParagraph","Properties":{"id":"20240614162323-y7tquzd","updated":"20240614162336"},"Children":[{"Type":"NodeText","Data":"痰饮吐水（无时节者，其原因冷饮过度，遂令脾胃气弱，不能消化饮食。饮食入胃，皆变成冷水，反吐不停，赤石脂散主之。赤石脂一斤，捣筛，服方寸匕，酒饮自任，稍加至三匕。服尽一斤，则终身不吐痰水，又不下痢，补五脏，令人肥健。有人痰饮，服诸药不效。用此遂愈。《千金翼方》）"}]},{"ID":"20240614162323-nmyx5uq","Type":"NodeParagraph","Properties":{"id":"20240614162323-nmyx5uq","updated":"20240614162329"},"Children":[{"Type":"NodeText","Data":"心痛彻背（赤石脂、干姜、蜀椒各四分，附子炮二分，乌头炮一分，为末，蜜丸梧子大。先食服一丸。不知，稍增之。张仲景《金匮方》）"}]},{"ID":"20240614162323-f7318xv","Type":"NodeParagraph","Properties":{"id":"20240614162323-f7318xv","updated":"20240614162323"},"Children":[{"Type":"NodeText","Data":"经水过多（赤石脂、破故纸一两，为末。每服二钱，米饮下。《普济方》）"}]},{"ID":"20240614162323-fxjbre5","Type":"NodeParagraph","Properties":{"id":"20240614162323-fxjbre5","updated":"20240614162327"},"Children":[{"Type":"NodeText","Data":"小便不禁（赤石脂煅，牡蛎煅，各三两，盐一两，为末，糊丸梧子大。每盐汤下十五丸。《普济方》）"}]},{"ID":"20240614162215-9vwy4fm","Type":"NodeThematicBreak","Properties":{"id":"20240614162215-9vwy4fm"}},{"ID":"20240614162217-nlro6aw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162217-nlro6aw","updated":"20240614162223"},"Children":[{"Type":"NodeText","Data":"五色石脂《本草述钩元》"}]},{"ID":"20240614162217-mxrvfy4","Type":"NodeParagraph","Properties":{"id":"20240614162217-mxrvfy4","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"皆揭两石中取之。（承）膏之凝者曰脂。此物性粘。固济炉鼎甚良。盖兼体用而名也。"}]},{"ID":"20240614162217-a63xjm8","Type":"NodeParagraph","Properties":{"id":"20240614162217-a63xjm8","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"（濒湖）今人惟用赤白二脂。余三色无正用。但黑石脂入画眉耳。（贞白）五种气味。俱甘平。各随五色补五脏。治黄胆泻痢。肠脓血。阴蚀。下血赤白。久服补髓益气。肥健不饥。膏释脂凝。皆肌肉中液也。肌肉有余则其气扬于外。凝中大有不凝义。"}]},{"ID":"20240614162217-pmnvqva","Type":"NodeParagraph","Properties":{"id":"20240614162217-pmnvqva","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"世人止知固济。未尽石脂大体。三复本经自见。（不远）赤石脂赤白皆以理腻粘舌缀唇者为上。（宗）赤者色如绛滑如脂者良。"}]},{"ID":"20240614162217-bjr555c","Type":"NodeParagraph","Properties":{"id":"20240614162217-bjr555c","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"味甘酸辛。气大温。气薄味浓。降而能收。阳中阴也。入手阳明大肠。兼入手足少阴经。"}]},{"ID":"20240614162217-562cvfb","Type":"NodeParagraph","Properties":{"id":"20240614162217-562cvfb","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"主养心气。益精神。五脏虚乏。疗腹痛肠。下痢赤白。小便利。收脱肛。并女子崩中漏下。"}]},{"ID":"20240614162217-tqq1fby","Type":"NodeParagraph","Properties":{"id":"20240614162217-tqq1fby","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"难产。胞衣不出。久服补髓。好颜色。益智不饥。白石脂味甘酸辛。气温平。性入同赤脂。"}]},{"ID":"20240614162217-pmadodi","Type":"NodeParagraph","Properties":{"id":"20240614162217-pmadodi","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"主养肺气。浓肠。补骨髓。疗五脏惊悸不足。心下烦。止腹痛。下水。小肠。热溏。便脓血。入大肠。止泻更良。并治女子崩中漏下。赤白淫。赤白石脂。俱阳中之阴。甘酸而固脱。"}]},{"ID":"20240614162217-68qvton","Type":"NodeParagraph","Properties":{"id":"20240614162217-68qvton","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"（洁白）其固肠胃。有收敛之能。而下胎衣。无推荡之峻。（东垣）赤入丙。白入庚。（海藏）三石脂皆手足阳明药。味甘气温。体重性涩。涩而重。故能收湿止血而固下。甘而温。"}]},{"ID":"20240614162217-iw753ei","Type":"NodeParagraph","Properties":{"id":"20240614162217-iw753ei","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"故能益气生肌而调中。中者肠胃肌肉惊悸黄胆是也。下者肠泄痢崩带失精是也。赤白二种。"}]},{"ID":"20240614162217-07xssxc","Type":"NodeParagraph","Properties":{"id":"20240614162217-07xssxc","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"一入气分。一入血分。故时用尚之。（濒湖）涩可去脱。凡大小肠下后虚脱。非涩剂无以固之。故石脂主肠冷痢。及女子崩漏之病。顾何以又主难产下胞衣。因其体重下降。而酸辛能化恶血。恶血化则胞胎无阻滞之患。东垣所谓胞衣不出。涩剂可以下之。此之谓也。凡久泻下焦虚脱。其他固涩之药。性多轻浮。不能达下。惟石脂体重而涩。直入下焦阴分。故为要药。（仲淳）反胃吐食。上好赤石脂为末。蜜丸梧子大。每空心姜汤下一二十丸。先以津吞巴豆仁一枚。勿令破。后乃服药。痰饮吐水无时。此缘饮冷过度。脾胃气弱。不能消化。"}]},{"ID":"20240614162217-6u2x8zo","Type":"NodeParagraph","Properties":{"id":"20240614162217-6u2x8zo","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"饮食入胃。变成冷水。反吐不停。赤石脂散主之。赤石脂一斤捣筛。服方寸匕。饮酒自任。"}]},{"ID":"20240614162217-o57s4wt","Type":"NodeParagraph","Properties":{"id":"20240614162217-o57s4wt","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"稍加至三七服。尽一斤则终身不吐痰水。又不下利。病患虚者宜之。心痛彻背。赤石脂干姜蜀椒各四分。附子炮二分。乌头炮一分。为末。蜜丸梧子大。先食。服一丸。不住。稍增之。"}]},{"ID":"20240614162217-ggmyt2f","Type":"NodeParagraph","Properties":{"id":"20240614162217-ggmyt2f","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"须知心痛彻背。皆太阳寒水上凌。非泛泛心痛之谓。经水过多。赤石脂破故纸一两。为末。"}]},{"ID":"20240614162217-7460pqg","Type":"NodeParagraph","Properties":{"id":"20240614162217-7460pqg","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"每服三钱。米饮下。"}]},{"ID":"20240614162217-9uwdngv","Type":"NodeParagraph","Properties":{"id":"20240614162217-9uwdngv","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"〔论〕石脂五色。各养五脏之气。而补髓之用。别录独以青白赤者当之。盖石中之脂。"}]},{"ID":"20240614162217-jtabncw","Type":"NodeParagraph","Properties":{"id":"20240614162217-jtabncw","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"如骨中之髓。故揭两石中取此。必以粘缀唇舌者为上。内经曰。人始生。先成精。精成而脑髓生。然则髓者精气之所化。气化之所凝。从阴中蓄阳。故上归于脑。本经取其补髓。非取其精气所化。气化所凝。如阴中蓄阳。以化而能归于凝。凝而未离于化者乎。（若是则焉得以涩能固脱尽之）今所用石脂。惟赤者居多。以其甘温合而得阳之化。又酸辛合而能散能收也。历观方书诸证之治。凡取其收涩者。未尝不有化之用存于其中。就以泻痢一证而言。如寒者温药散之。既借此以化血分之凝。而即为收涩。即热者用寒药祛热。而亦不舍此味。盖恐寒剂与热乖忤。更借此气化者。引寒导热。是亦因化为收也。明于一证之寒热皆宜。可推类以尽他证矣。又本经言其补髓。即继之以益气。不可谓其专入血分。但属血分之病。由阳中之阴能行其化耳。盖阳中之阴能行其化。是即可以益精而化髓。髓盈而气益盛矣。方书有专取其补髓益气者。如养气丹震灵丹可据也。兹味非取其能收。盖取其精气之所化。而得化之精气。有若凝为脂者。以对待涣散之气。不能翕聚以为病者。是则犹非取其脂也。取其化脂之气。能为涣散之气用耳。即其能疗腹痛肠下利。可以思能化能收之功。不然腹痛利。"}]},{"ID":"20240614162217-q9d4059","Type":"NodeParagraph","Properties":{"id":"20240614162217-q9d4059","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"可仅仅以收为功也乎。即此以推。则其治女子崩漏。真是妙剂。盖崩漏虽多属虚。然有挟瘀者。或有挟热者。此味可投之咸宜矣。本草别录本其精气之所凝为脂。遂明其有补髓之功。"}]},{"ID":"20240614162217-5kpll6x","Type":"NodeParagraph","Properties":{"id":"20240614162217-5kpll6x","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"修真者云。气盛则精盈。兹品由气化而脂凝。非由气盛精盈之义乎。经云。精成而脑髓生。"}]},{"ID":"20240614162217-5fy6cyg","Type":"NodeParagraph","Properties":{"id":"20240614162217-5fy6cyg","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"故别录首言益精。而后云久服补髓也。又本草别录。首云养心气。次即言益精。（心属阳中之太阳。虽离中有坎。而阳实其主也。故曰养心气。肾属阴中之至阴。虽坎中有离。而阴实其主也。故曰益精。）人身坎离交媾之乡。阴阳非涣然二也。修真者曰。气盛则精盈。精盈则气盛。是精与气合一之义。心肾第为主耳。不得以气专属心。精专属肾也。赤石脂能于阳中行阴之化以下归。即于阴中致阳之化以上济。阴阳不忒。而精乃益。甄氏故谓补五脏虚乏云。"}]},{"ID":"20240614162217-8w46shb","Type":"NodeParagraph","Properties":{"id":"20240614162217-8w46shb","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"缪氏。火热暴注者不宜。滞下非的受寒邪。下利白积者。不宜。"}]},{"ID":"20240614162217-fvnws7n","Type":"NodeParagraph","Properties":{"id":"20240614162217-fvnws7n","updated":"20240614162217"},"Children":[{"Type":"NodeText","Data":"〔修治〕凡使研如粉。新汲水飞过三次。晒干用。（）亦有火水飞者。（濒湖）"}]},{"ID":"20240614161624-nbrp5oy","Type":"NodeThematicBreak","Properties":{"id":"20240614161624-nbrp5oy"}},{"ID":"20240614161704-jk1lkhs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161704-jk1lkhs","updated":"20240614161718"},"Children":[{"Type":"NodeText","Data":"赤石脂《本草衍义》"}]},{"ID":"20240614161704-h7arnlq","Type":"NodeParagraph","Properties":{"id":"20240614161704-h7arnlq","updated":"20240614161704"},"Children":[{"Type":"NodeText","Data":"今四方皆有，以舌拭之，粘着者为佳。有人病大肠寒滑，小便精出，诸热药服及一斗二升，未甚效。后有人教服赤石脂、干姜各一两，胡椒半两，同为末，醋糊丸如梧桐子大，空心及饭前米饮下五七十丸。终四剂，遂愈。"}]},{"ID":"20240606180012-99qpwof","Type":"NodeThematicBreak","Properties":{"id":"20240606180012-99qpwof"}},{"ID":"20240614161515-035zxbi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161515-035zxbi","updated":"20240614161521"},"Children":[{"Type":"NodeText","Data":"赤石脂《本经逢原》"}]},{"ID":"20240614161515-3c1fuhu","Type":"NodeParagraph","Properties":{"id":"20240614161515-3c1fuhu","updated":"20240614161515"},"Children":[{"Type":"NodeText","Data":"甘酸辛温，无毒。五色石脂并温，无毒。"}]},{"ID":"20240614161515-8drm4q2","Type":"NodeParagraph","Properties":{"id":"20240614161515-8drm4q2","updated":"20240614161515"},"Children":[{"Type":"NodeText","Data":"《本经》养心气明目益精，疗腹痛肠 下痢赤白，小便利，及痈疽疮痔，女子崩中漏下，产难，胞衣不出。"}]},{"ID":"20240614161515-9hn5gdg","Type":"NodeParagraph","Properties":{"id":"20240614161515-9hn5gdg","updated":"20240614161515"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"赤石脂功专止血固下。仲景桃花汤治下利便脓血者，取石脂之重涩入下焦血分而固脱，干姜之辛温，暖下焦气分而补虚，粳米之甘温，佐石脂而固肠胃也。火热暴注；初痢有积热者勿用。《本经》养心气，明目益精，是指精血脱泄之病而言，用以固敛其脱，则目明精益矣。疗腹痛肠 等疾，以其开泄无度，日久不止，故取涩以固之也。治产难胞衣不出，乃指日久去血过多无力迸下，故取重以镇之也。东垣所谓胞衣不出，涩剂可以下之。"}]},{"ID":"20240614161515-9dk4qhw","Type":"NodeParagraph","Properties":{"id":"20240614161515-9dk4qhw","updated":"20240614161515"},"Children":[{"Type":"NodeText","Data":"设血气壅滞而胞衣不出，又非石脂所宜也。其白者敛肺气、涩大肠。《金匮》风引汤用之专取以杜虚风复入之路也。青者入肝，黄者入脾，黑者入肾，总取治崩利水之功，各随其色而用之。"}]},{"ID":"20240614161557-97t25xn","Type":"NodeThematicBreak","Properties":{"id":"20240614161557-97t25xn"}},{"ID":"20240614161559-iclic6n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161559-iclic6n","updated":"20240614161604"},"Children":[{"Type":"NodeText","Data":"赤石脂《本草图经》"}]},{"ID":"20240614161559-jfgkved","Type":"NodeParagraph","Properties":{"id":"20240614161559-jfgkved","updated":"20240614161601"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"赤石脂"},{"Type":"NodeText","Data":"，生济南、射阳及泰山之阴。苏恭云∶济南泰山不闻出者，惟虢州卢氏县、泽州陵川县、慈州吕乡县并有，及宜州诸山亦出，今出潞州。以色理鲜腻者为胜，采无时。古人亦有单服食者。《乳石论》载服赤石脂，发则心痛，饮热酒不解，治之用葱豉绵裹，水煮饮之。"}]},{"ID":"20240614161559-hoa2pgc","Type":"NodeParagraph","Properties":{"id":"20240614161559-hoa2pgc","updated":"20240614161559"},"Children":[{"Type":"NodeText","Data":"《千金翼》论曰治痰饮吐水无时节者，其源以冷冻饮料过度，遂令脾胃气羸，不能消于饮食，饮食入胃，则皆变成冷水，反吐不停，皆赤石脂散主之。赤石脂一斤，捣筛，服方寸匕，酒饮自任，稍稍加至三匕。服尽一斤，则终身不吐淡水，又不下痢，补五脏，令人肥健。有人淡饮，服诸药不效，用此方遂愈。其杂诸药用者，则张仲景治伤寒下痢不止，便脓血者，桃花汤主之。其方用赤石脂一斤，一半全用，一半末用，干姜一两，粳米半升，以水七升煮之，米熟为准，去滓，每饮七合，内赤石脂末一方寸匕服，日三愈。止后服，不尔尽之。又有乌头赤石脂丸，主心痛彻背者。乌头一分，附子二分，并炮，赤石脂、干姜、蜀椒各四分。五物同杵末，以蜜和丸，大如梧子，先食服一丸，不知，稍增之。"}]},{"ID":"20240614161444-bjf159j","Type":"NodeThematicBreak","Properties":{"id":"20240614161444-bjf159j"}},{"ID":"20240614161446-5bi6c7g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161446-5bi6c7g","updated":"20240614161451"},"Children":[{"Type":"NodeText","Data":"赤石脂《长沙药解》"}]},{"ID":"20240614161446-l6bwltb","Type":"NodeParagraph","Properties":{"id":"20240614161446-l6bwltb","updated":"20240614161446"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】青石、赤石、黄石、白石、黑石脂等。味甘平。主黄疸，泄利，肠癖，脓血，阴蚀，下血，赤白，邪气，痈肿，疽痔，恶创，头疡，疥搔。久服，补髓益气，肥健，不饥，轻身延年。五石脂，各随五色补五脏。生山谷中。"}]},{"ID":"20240614161446-vye4dq4","Type":"NodeParagraph","Properties":{"id":"20240614161446-vye4dq4","updated":"20240614161446"},"Children":[{"Type":"NodeText","Data":"味甘、酸、辛，性涩，入手少阴心、足太阴脾、手阳明大肠经。敛肠胃而断泄利，护心主而止痛楚。"}]},{"ID":"20240614161446-rgij4ro","Type":"NodeParagraph","Properties":{"id":"20240614161446-rgij4ro","updated":"20240614161446"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桃花汤，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"干姜三两，粳米一升，赤石脂一斤，用一半研末。水七升，煮米熟，去渣，温服七合，入赤石脂末方寸匕。"},{"Type":"NodeText","Data":"治少阴病，腹痛下利，小便不利，便脓血者。以水土湿寒，脾陷肝郁，二气逼迫，而腹为之痛。木愈郁而愈泄，水道不通，则谷道不敛，膏血脱陷，凝瘀腐败，风木摧剥，而下脓血。粳米补土而泻湿，干姜温中而驱寒，石脂敛肠而固脱也。"}]},{"ID":"20240614161446-cvtjx9a","Type":"NodeParagraph","Properties":{"id":"20240614161446-cvtjx9a","updated":"20240614161446"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"赤石脂禹余粮汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"赤石脂一斤，禹余粮一斤。"},{"Type":"NodeText","Data":"治伤寒下利不止，利在下焦，服理中汤，利益甚者。己土湿陷，庚金不敛，则为泄利。而己土湿陷之利，其病在中，理中可愈，庚金不敛之利，其病在下，理中不能愈。石脂、余粮，涩滑而断泄利也。"}]},{"ID":"20240614161446-5s6nyz8","Type":"NodeParagraph","Properties":{"id":"20240614161446-5s6nyz8","updated":"20240614161446"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌头赤石脂丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在乌头。"},{"Type":"NodeText","Data":"用之治心痛彻背，以其保宫城而护心君也。"}]},{"ID":"20240614161446-ymkvx0i","Type":"NodeParagraph","Properties":{"id":"20240614161446-ymkvx0i","updated":"20240614161446"},"Children":[{"Type":"NodeText","Data":"赤石脂酸收涩固，敛肠住泄，护心止痛，补血生肌，除崩收带，是其所长。最收湿气，燥脾土，治停痰吐水之病。更行瘀涩，破凝滞，有催生下衣之能。兼医痈疽、痔瘘、反胃、脱肛之证。"}]},{"ID":"20240614161833-mze82g7","Type":"NodeThematicBreak","Properties":{"id":"20240614161833-mze82g7"}},{"ID":"20240614161834-kzd3vo9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161834-kzd3vo9","updated":"20240614161838"},"Children":[{"Type":"NodeText","Data":"赤石脂《本草经解》"}]},{"ID":"20240614161834-cfetk0m","Type":"NodeParagraph","Properties":{"id":"20240614161834-cfetk0m","updated":"20240614161834"},"Children":[{"Type":"NodeText","Data":"气大温．味甘酸辛．无毒．主养心气．明目益精．疗腹痛肠 下痢赤白．小便利．及痈疽疮痔．女人崩中漏下．产难胞衣不出．久服补髓好颜色．益智不饥．轻身延年．（火）"}]},{"ID":"20240614161834-p77fjpa","Type":"NodeParagraph","Properties":{"id":"20240614161834-p77fjpa","updated":"20240614161834"},"Children":[{"Type":"NodeText","Data":"赤石脂气大温．禀天春夏木火之气．入足厥阴肝经、手厥阴心包络经．味甘酸辛无毒．得地中东西土木金之味．入足阳明燥金胃土、手阳明燥金大肠．气味升多于降．阳也．心包络者臣使之官．喜乐出焉．代心君行事之府也．石脂气味酸温．则条畅心包络．而心君之气得所养矣．肝开窍于目．辛温疏达．则肝和而目明．精者五脏阴气之华也．甘酸之味可以益阴．所以益精而补髓也．腹者太阴经行之地．太阴为湿土．土湿而寒则痛．石脂气温．温能行寒去湿．所以主之也．胃与大肠为阳明燥金．阳虚不燥．则肠 下利．石脂温辛收涩．故主下利及小便利．盖涩可以固脱也．诸痛痒疮疡．皆属心火．火有虚实．实火可泻．虚火可补．心包络代君行事．其气味酸温．可补心包络之火也．肝藏血．肝血不藏．则崩中漏下产难胞衣不出矣．味甘酸可以藏肝血．气温可以达肝气．所以主之也．久服补益阳明．阳明经行于面．所以好颜色．肾为悭藏而藏智．酸收益阴．所以益智．阳明胃气充益．所以不饥而延年也．"}]},{"ID":"20240614161834-xgqtun0","Type":"NodeParagraph","Properties":{"id":"20240614161834-xgqtun0","updated":"20240614161834"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240614161834-667dtzl","Type":"NodeParagraph","Properties":{"id":"20240614161834-667dtzl","updated":"20240614161834"},"Children":[{"Type":"NodeText","Data":"赤石脂同炮姜、粳米．名桃花汤．治痢下脓血．专为末酒服．治痰饮．同炮姜蒸饼丸．名桃花丸．治痢下白冻．"}]},{"ID":"20240614161945-rpjfv2v","Type":"NodeThematicBreak","Properties":{"id":"20240614161945-rpjfv2v"}},{"ID":"20240614161946-wmlf6lf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161946-wmlf6lf","updated":"20240614161951"},"Children":[{"Type":"NodeText","Data":"赤石脂《证类本草》"}]},{"ID":"20240614161946-4t222b9","Type":"NodeParagraph","Properties":{"id":"20240614161946-4t222b9","updated":"20240614161946"},"Children":[{"Type":"NodeText","Data":"味甘、酸、辛，大温，无毒。主养心气，明目益精，疗腹痛，泄 ，下痢赤白，小便利，及痈疽疮痔，女子崩中漏下，产难胞衣不出。久服补髓，好颜色，益智，不饥，轻身延年。生济南、射阳及泰山之阴。采无时。（恶大黄，畏芫花。）"}]},{"ID":"20240614161946-slaoo3f","Type":"NodeParagraph","Properties":{"id":"20240614161946-slaoo3f","updated":"20240614161946"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此石济南太山不闻出者，今虢州卢氏县、泽州陵川县及慈州吕乡县并有，色理鲜腻，宜州诸山亦有。此五石脂中，又有石骨，似骨，如玉坚润，服之力胜钟乳。臣禹锡等谨按药性论云∶赤石脂，君，恶松脂，补五脏虚乏。"}]},{"ID":"20240614161946-zb7zltu","Type":"NodeParagraph","Properties":{"id":"20240614161946-zb7zltu","updated":"20240614161946"},"Children":[{"Type":"NodeText","Data":"图经曰∶赤石脂，生济南、射阳及泰山之阴。苏恭云∶济南泰山不闻出者，唯虢州卢氏县、泽州陵川县、慈州吕乡县并有，及宜州诸山亦出，今出潞州。以色理鲜腻者为胜。采无时。古人亦有单服食者。《乳石论》载服赤石脂，发则心痛，饮热酒不解，治之用葱豉绵裹，水煮饮之。《千金翼》论曰∶治痰饮吐水无时节者，其源以冷冻饮料过度，遂令脾胃气羸，不能消于饮食，饮食入胃，则皆变成冷水，反吐不停，皆赤石脂散主之。赤石脂一斤，捣筛，服方寸匕，酒饮自任，稍稍加至三匕。服尽一斤，则终身不吐痰水。又不下痢，补五脏，令人肥健。有人淡饮，服诸药不效，用此方遂愈。其杂药用者，则张仲景治伤寒下痢不止，便脓血者，桃花汤主之。其方用赤石脂一斤，一半全用，一半末用，干姜一两，粳米半升，以水七升煮之，米熟为准，去滓，每饮七合，纳赤石脂末方寸匕服，日三愈。止后服，不尔，尽之。"}]},{"ID":"20240614161946-r46qp1p","Type":"NodeParagraph","Properties":{"id":"20240614161946-r46qp1p","updated":"20240614161946"},"Children":[{"Type":"NodeText","Data":"又有乌头赤石脂丸，主心痛彻背者。乌头一分，附子二分，并炮，赤石脂、干姜、蜀椒各四分，五物同杵末，以蜜和丸，大如梧子，先食服一丸，不知，稍增之。"}]},{"ID":"20240614161946-el8rmu1","Type":"NodeParagraph","Properties":{"id":"20240614161946-el8rmu1","updated":"20240614161946"},"Children":[{"Type":"NodeText","Data":"斗门经∶治小儿疳泻。用赤石脂杵罗为末如面，以粥饮调半钱服，立瘥。或以京芎等分同服，更妙。"}]},{"ID":"20240614161946-8kas3b3","Type":"NodeParagraph","Properties":{"id":"20240614161946-8kas3b3","updated":"20240614161946"},"Children":[{"Type":"NodeText","Data":"衍义曰∶赤石脂，今四方皆有，以舌试之，粘着者为佳。有人病大肠寒滑，小便精出，诸热药服及一斗二升，未甚效。后有人教服赤石脂、干姜各一两，胡椒半两，同为末，醋糊丸如梧桐子大，空心及饭前米饮下五、七十丸，终四剂，遂愈。"}]},{"ID":"20240614161851-q3k1c9o","Type":"NodeThematicBreak","Properties":{"id":"20240614161851-q3k1c9o"}},{"ID":"20240614161852-etbs3pc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161852-etbs3pc","updated":"20240614161855"},"Children":[{"Type":"NodeText","Data":"赤石脂《中药学》"}]},{"ID":"20240614161852-wr3qnlk","Type":"NodeParagraph","Properties":{"id":"20240614161852-wr3qnlk","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【药用】本品为单斜品系的多水高岭士。"}]},{"ID":"20240614161852-wy135ns","Type":"NodeParagraph","Properties":{"id":"20240614161852-wy135ns","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、酸、涩，温。入胃、大肠经。"}]},{"ID":"20240614161852-f561jpy","Type":"NodeParagraph","Properties":{"id":"20240614161852-f561jpy","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【功效】涩肠止泻，止血生肌。"}]},{"ID":"20240614161852-fody21z","Type":"NodeParagraph","Properties":{"id":"20240614161852-fody21z","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于虚寒性泄泻及久痢脱肛等症。"}]},{"ID":"20240614161852-67d3aqi","Type":"NodeParagraph","Properties":{"id":"20240614161852-67d3aqi","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"赤石脂酸涩收敛，有涩肠止泻之效，主要用于虚寒性泄泻或久痢不止，常与禹余粮、党参、焦白朮、干姜等配合同用，对久痢兼有出血症状者，更为适宜。"}]},{"ID":"20240614161852-9ejiz6j","Type":"NodeParagraph","Properties":{"id":"20240614161852-9ejiz6j","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"2.用于妇女月经过多，崩漏带下等症。"}]},{"ID":"20240614161852-gutrbzr","Type":"NodeParagraph","Properties":{"id":"20240614161852-gutrbzr","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"赤石脂能入血分，有止血之功，故可用治崩漏等症，常与侧柏叶、乌贼骨等同用。此外，本品还可外治疮痈久不敛合，有生肌收口作用。"}]},{"ID":"20240614161852-tw2agpj","Type":"NodeParagraph","Properties":{"id":"20240614161852-tw2agpj","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【处方用名】赤石脂。"}]},{"ID":"20240614161852-c4v2erh","Type":"NodeParagraph","Properties":{"id":"20240614161852-c4v2erh","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至八钱，煎服。外用适量。"}]},{"ID":"20240614161852-3f3orzq","Type":"NodeParagraph","Properties":{"id":"20240614161852-3f3orzq","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【方剂举例】桃花汤《伤寒论》：赤石脂、干姜、粳米。治伤寒下利便脓血不止。"}]},{"ID":"20240614161852-tqxkhi2","Type":"NodeParagraph","Properties":{"id":"20240614161852-tqxkhi2","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主泄痢，肠澼脓血，下血赤白。」"}]},{"ID":"20240614161852-td4peir","Type":"NodeParagraph","Properties":{"id":"20240614161852-td4peir","updated":"20240614161852"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「补心血....厚肠胃，除水湿，收脱肛。」"}]},{"ID":"20240614162011-0s88m60","Type":"NodeThematicBreak","Properties":{"id":"20240614162011-0s88m60"}},{"ID":"20240614162013-kmp3tpk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162013-kmp3tpk","updated":"20240614162017"},"Children":[{"Type":"NodeText","Data":"赤石脂《本草备要》"}]},{"ID":"20240614162013-jhh2jn5","Type":"NodeParagraph","Properties":{"id":"20240614162013-jhh2jn5","updated":"20240614162013"},"Children":[{"Type":"NodeText","Data":"重，涩，固大小肠"}]},{"ID":"20240614162013-wwf30cz","Type":"NodeParagraph","Properties":{"id":"20240614162013-wwf30cz","updated":"20240614162013"},"Children":[{"Type":"NodeText","Data":"甘而温，故益气生肌而调中。酸而涩，故收湿（《独行方》∶ 末，治小儿脐中汁出、赤肿）止血而固下（《经疏》云∶大、小肠下后虚脱，非涩剂无以固之。其他涩药轻浮，不能达下，惟赤石脂体重而涩，直入下焦阴分，故为久痢、泄癖要药。仲景桃花汤用之，加干姜、粳米）。疗肠癖泄痢，崩带遗精，痈痔溃疡，收口长肉，催生下胞（《经疏》云∶能去恶血，恶血化，则胞胎无阻。东垣云∶胞胎不出，涩剂可以下之。又云∶固肠、胃有收敛之能，下胎衣无推荡之峻）。细腻粘舌者良。赤入血分，白入气分（五色石脂入五脏）。研粉，水飞用。恶芫花。畏大黄。"}]},{"ID":"20240614162203-aoaib0d","Type":"NodeThematicBreak","Properties":{"id":"20240614162203-aoaib0d"}},{"ID":"20240614162201-2z4goez","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162201-2z4goez","updated":"20240614162201"},"Children":[{"Type":"NodeText","Data":"赤石脂《神农本草经读》"}]},{"ID":"20240614162201-9n2dzah","Type":"NodeParagraph","Properties":{"id":"20240614162201-9n2dzah","updated":"20240614162201"},"Children":[{"Type":"NodeText","Data":"气味甘、平，无毒。主黄胆，泄痢，肠脓血，阴浊下血赤白，邪气痈肿，疽痔恶疮，头疡疥瘙。久服补髓益气，肥健不饥，轻身延年。五色石脂，各随五色补五脏。"}]},{"ID":"20240614162201-qvv1j5w","Type":"NodeParagraph","Properties":{"id":"20240614162201-qvv1j5w","updated":"20240614162201"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶赤石脂气平禀金气，味甘得土味，手足太阴药也。太阴湿胜，在皮肤则为黄疸，在肠胃则为泄痢，甚则为肠脓血；下注于前阴，则为阴蚀并见赤白带下；下注于后阴，则为下血；皆湿邪之气为害也。石脂具湿土之质，而有燥金之用，所以主之。痈肿、疽痔恶疮、头疡疥瘙等证，皆湿气郁而为热，热盛生毒之患；石脂能燥湿化热，所以主之。久服补髓益气、肥健不饥、延年者，湿去则津生，自能补髓益气，补髓助精也、益气助神也；精神交会于中土，故有肥健不饥，轻身延年之效也。"}]},{"ID":"20240614162030-eb3v3sr","Type":"NodeThematicBreak","Properties":{"id":"20240614162030-eb3v3sr"}},{"ID":"20240614162031-srxljmm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162031-srxljmm","updated":"20240614162037"},"Children":[{"Type":"NodeText","Data":"赤石脂《医学入门》"}]},{"ID":"20240614162031-wsoq6p4","Type":"NodeParagraph","Properties":{"id":"20240614162031-wsoq6p4","updated":"20240614162031"},"Children":[{"Type":"NodeText","Data":"赤石脂甘酸且温，生肌敛口疮无痕，固肠胃又涩精血，下胎衣为入心源。白者性味俱相似，青黄黑各应脏论。"}]},{"ID":"20240614162031-t1osqx5","Type":"NodeParagraph","Properties":{"id":"20240614162031-t1osqx5","updated":"20240614162031"},"Children":[{"Type":"NodeText","Data":"赤以色言，脂乃石之膏粘也，无毒。降也，阳中之阴也。敷痈疽、疮疖、痔 ，排脓止痛，生肌敛口，固肠胃，疗腹痛泄 、寒滑疳泻、下痢赤白、涩精益精，止小便利及淋沥。又止吐血、衄血及女子崩中漏下，难产胞衣不下。经云∶涩可去脱。石脂为收敛涩剂，而又能催生下胞衣者，何也？盖赤脂入丙，白脂入庚故也。所以赤者主养心气，镇惊悸。凡使，色理鲜腻粘舌者佳。火通赤，放冷细研，水飞三次。晒干。恶大黄，畏芫花。白石脂，味甘、酸，平，无毒，主养肺。青石脂，味酸，平，无毒，主养肝胆气。黄石脂，味苦，平，无毒，主养脾气。黑石脂，味咸，平，无毒，主养肾气，强阴。"}]},{"ID":"20240614162031-i34jpx6","Type":"NodeParagraph","Properties":{"id":"20240614162031-i34jpx6","updated":"20240614162031"},"Children":[{"Type":"NodeText","Data":"《图经》云∶五色石脂，主治并同，后人分之，今惟用赤白二种，余不复识，制法同上。曾青、燕屎为使。恶松脂、细辛。畏黄芩、黄连、甘草。得浓朴并米饮，止便脓。"}]},{"ID":"20240614161917-lryxhu2","Type":"NodeThematicBreak","Properties":{"id":"20240614161917-lryxhu2"}},{"ID":"20240614161918-bgodj0n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161918-bgodj0n","updated":"20240614161922"},"Children":[{"Type":"NodeText","Data":"白石脂《本草衍义》"}]},{"ID":"20240614161918-dqg2m4o","Type":"NodeParagraph","Properties":{"id":"20240614161918-dqg2m4o","updated":"20240614161918"},"Children":[{"Type":"NodeText","Data":"有初生未盈月小儿，多啼叫，致脐中血出，以白石脂细末贴之，即愈。未愈，微微炒过，放冷再贴，仍不得剥揭。"}]},{"ID":"20240614162134-73cd5td","Type":"NodeThematicBreak","Properties":{"id":"20240614162134-73cd5td"}},{"ID":"20240614162136-zfpfag3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162136-zfpfag3","updated":"20240614162141"},"Children":[{"Type":"NodeText","Data":"白石脂《本草图经》"}]},{"ID":"20240614162136-y0r6ta5","Type":"NodeParagraph","Properties":{"id":"20240614162136-y0r6ta5","updated":"20240614162138"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"白石脂"},{"Type":"NodeText","Data":"，生泰山之阴。苏恭云∶出慈州诸山，泰山左侧不闻有之。今惟潞州有焉，潞与慈相近，此亦应可用。古断下方多用，而今医家亦稀使。采无时。五色石脂旧经同一条，并生南山之阳山谷中，主治并同，后人各分之，所出既殊，功用亦别，用之当依后条。然今惟用赤、白二种，余不复识者。唐·韦宙《独行方》治小儿脐中汁出不止，兼赤、肿，以白石脂细末，熬温，扑脐中，日三良。又《斗门方》治泻痢，用白石脂、干姜二物，停捣，治以百沸汤和面为稀糊，搜匀，并手丸如梧子，曝干，饮下三十丸。久痢不定，更加三十丸。霍乱煎浆水为使。"}]},{"ID":"20240614162145-9mr0v4a","Type":"NodeThematicBreak","Properties":{"id":"20240614162145-9mr0v4a"}},{"ID":"20240614162105-h4sz3cj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162105-h4sz3cj","updated":"20240614162110"},"Children":[{"Type":"NodeText","Data":"白石脂《本草择要纲目》"}]},{"ID":"20240614162105-6l6f97c","Type":"NodeParagraph","Properties":{"id":"20240614162105-6l6f97c","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240614162105-8zssaxu","Type":"NodeParagraph","Properties":{"id":"20240614162105-8zssaxu","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"甘酸平无毒．"}]},{"ID":"20240614162105-lgledk4","Type":"NodeParagraph","Properties":{"id":"20240614162105-lgledk4","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240614162105-zp5sfz8","Type":"NodeParagraph","Properties":{"id":"20240614162105-zp5sfz8","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"养肺气．浓肠．补骨髓．疗五脏惊悸不足．心下烦．止腹痛．下水．小肠 热溏便脓血．女子崩中漏下赤白沃．排痈疽疮痔．久服安心不饥．轻身延年．涩大肠．五色石脂本经疗体亦相似．别录分条具载．今俗惟用赤白二脂断下痢耳．其用有三．固肠胃有收敛之能．下胎衣无推荡之峻．涩可去脱．石脂为收敛之剂．赤入丙．白入庚．二石脂皆手足阳明药也．其味甘．其气温．其体重．其性涩．涩而重．故能收湿止血而固下．甘而温．故能益气生肌而调中．中者肠胃肌肉惊悸黄胆是也．下者肠 泄痢崩带失精是也．五种主疗．大抵相同．故本经不分条目．但云各随五色补五脏．别录虽分五种．而性味主治．亦不甚相远．但以五味配五色为异．亦是强分耳．赤白二种．一入气分．一入血分．故时用上之．张仲景用桃仁汤．治下痢便脓血．取赤石脂之重涩．入下焦血分而固脱．干姜之辛温暖下焦气分而补虚．粳米之甘温．佐石脂干姜而润肠胃也．赤"}]},{"ID":"20240614162105-ww4wfjk","Type":"NodeParagraph","Properties":{"id":"20240614162105-ww4wfjk","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"【畏】（芫花）"}]},{"ID":"20240614162105-tq87ivi","Type":"NodeParagraph","Properties":{"id":"20240614162105-tq87ivi","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"【恶】（大黄 松脂） 白"}]},{"ID":"20240614162105-z0cr9nj","Type":"NodeParagraph","Properties":{"id":"20240614162105-z0cr9nj","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"【畏】（黄芩 甘草 黄连）"}]},{"ID":"20240614162105-mq84yyg","Type":"NodeParagraph","Properties":{"id":"20240614162105-mq84yyg","updated":"20240614162105"},"Children":[{"Type":"NodeText","Data":"【恶】（松脂）"}]},{"ID":"20240614161816-y3da8lb","Type":"NodeThematicBreak","Properties":{"id":"20240614161816-y3da8lb"}},{"ID":"20240614161817-ohmq9wa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161817-ohmq9wa","updated":"20240614161823"},"Children":[{"Type":"NodeText","Data":"白石脂《证类本草》"}]},{"ID":"20240614161817-w9uintx","Type":"NodeParagraph","Properties":{"id":"20240614161817-w9uintx","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"味甘、酸，平，无毒。主养肺气，浓肠，补骨髓，疗五脏惊悸不足，心下烦，止腹痛下水，小肠 热溏，便脓血，女子崩中，漏下，赤白沃，排痈疽疮痔。久服安心，不饥，轻身，长年。生泰山之阴。采无时。（得浓朴并米汁饮，止便脓。燕屎为之使，恶松脂，畏黄芩。）"}]},{"ID":"20240614161817-jg8lzh8","Type":"NodeParagraph","Properties":{"id":"20240614161817-jg8lzh8","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"唐本注云∶白石脂，今出慈州诸山，胜于余处者。泰山左侧不闻有之。臣禹锡等谨按蜀本及箫炳云∶畏黄连、甘草、飞廉。药性论云∶白石脂，一名白符。（恶马目毒公。味甘、辛。"}]},{"ID":"20240614161817-wxwi2cp","Type":"NodeParagraph","Properties":{"id":"20240614161817-wxwi2cp","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"涩大肠。）"}]},{"ID":"20240614161817-tnqbqxk","Type":"NodeParagraph","Properties":{"id":"20240614161817-tnqbqxk","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"图经曰∶白石脂，生泰山之阴。苏恭云∶出慈州诸山，泰山左侧，不闻有之。今唯潞州有焉，潞与慈相近，此亦应可用，古断下方多用。而今医家亦稀使。采无时。五色石脂旧经同一条，并生南山之阳山谷中，主治并同，后人各分之，所出既殊，功用亦别，用之当根据后条。然今唯用赤、白二种，余不复识者。唐·韦宙《独行方》治小儿脐中汁出不止兼赤肿，以白石脂细末，熬温，扑脐中，日三，良。又，《斗门方》∶治泻痢。用白石脂、干姜二物停捣，以百沸汤和面为稀糊，搜匀，并手丸如梧子，曝干，饮下三十丸。久痢不定，更加三十丸。霍乱，煎浆水为使。"}]},{"ID":"20240614161817-zg0xolc","Type":"NodeParagraph","Properties":{"id":"20240614161817-zg0xolc","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"子母秘录∶治小儿水痢，形羸不胜大汤药。白石脂半大两研如粉，和白粥空肚与食。别说云∶谨按唐注云∶出苏州、余杭山，今不采。而苏州今乃见贡赤、白二种，然入药不甚佳。唯延州山中所出最良，揭两石中取之。延州每以蕃寇围城，苦无水，乃撅地深广三、五丈，以石脂密固贮水，得经时久不渗漏，宜以此为良。"}]},{"ID":"20240614161817-hdm76iy","Type":"NodeParagraph","Properties":{"id":"20240614161817-hdm76iy","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"衍义曰∶白石脂，有初生未盈月小儿，多啼叫，致脐中血出，以白石脂细末贴之，即愈。"}]},{"ID":"20240614161817-iq68jv6","Type":"NodeParagraph","Properties":{"id":"20240614161817-iq68jv6","updated":"20240614161817"},"Children":[{"Type":"NodeText","Data":"未愈，微微炒过，放冷再贴，仍不得剥揭。"}]},{"ID":"20240614162551-a8yz5te","Type":"NodeThematicBreak","Properties":{"id":"20240614162551-a8yz5te"}},{"ID":"20240614162553-5u5d4uu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162553-5u5d4uu","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"黑石脂《新修本草》"}]},{"ID":"20240614162553-4bzd9pd","Type":"NodeParagraph","Properties":{"id":"20240614162553-4bzd9pd","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"味咸，平，无毒。主养肾气，强阴，主阴蚀疮，止肠 泄痢，疗口疮咽痛。久服益气，不饥，延年。一名石涅，一名石墨。出颖川阳城，采无时。"}]},{"ID":"20240614162553-595pr8e","Type":"NodeParagraph","Properties":{"id":"20240614162553-595pr8e","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"此五石脂如《本经》，疗体亦相似。《别录》各条，所以具载，今俗用赤石、白石二脂尔。"}]},{"ID":"20240614162553-w3i4fy2","Type":"NodeParagraph","Properties":{"id":"20240614162553-w3i4fy2","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"《仙经》亦用白石脂，以涂丹釜。好者出吴郡，犹与赤石脂同源。赤石脂多赤而色好，惟可断下，不入五石散用。好者亦出武陵、建平、义阳。今五石散皆用义阳者，出 县界东八十里，状如豚脑，色鲜红可爱，随采随复而生，不能断痢，而不用之。余三色脂有，而无正有，黑石脂乃可画用尔。"}]},{"ID":"20240614162553-ua18gbu","Type":"NodeParagraph","Properties":{"id":"20240614162553-ua18gbu","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"〔谨案〕义阳即申州也，所出者，名桃花石，非五色脂，色如桃花，久服肥人。土人亦以疗下利，旧出苏州余杭山大有，今不收采尔。"}]},{"ID":"20240614162553-7mq4j2v","Type":"NodeThematicBreak","Properties":{"id":"20240614162553-7mq4j2v","updated":"20240614162553"}},{"ID":"20240614162553-yg8lry2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162553-yg8lry2","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"黑石脂《名医别录》"}]},{"ID":"20240614162553-ykgod7i","Type":"NodeParagraph","Properties":{"id":"20240614162553-ykgod7i","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"味咸，平，无毒．主养肾气，强阴，治阴蚀疮，止肠 泄痢，疗口疮、咽痛．久服不饥，延年．一名石涅．一名石墨．出 川阳城，采无时．"}]},{"ID":"20240614162553-4i2lxz8","Type":"NodeParagraph","Properties":{"id":"20240614162553-4i2lxz8","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶青石、赤石、黄石、白石、黑石脂等，味甘，平．主黄胆，泄利肠癖脓血，阴蚀下血赤白，五石脂各随五色，"}]},{"ID":"20240614162553-q832td9","Type":"NodeThematicBreak","Properties":{"id":"20240614162553-q832td9","updated":"20240614162553"}},{"ID":"20240614162553-u5c8pbw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162553-u5c8pbw","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"黑石脂《增广和剂局方药性总论》"}]},{"ID":"20240614162553-5eiafpd","Type":"NodeParagraph","Properties":{"id":"20240614162553-5eiafpd","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"味咸，平，无毒。主养肾气，强阴，主阴蚀疮，止肠 泄痢，疗口疮咽痛。久服益气不饥延年。日华子云∶五色石脂并温，无毒。畏∶黄芩、大黄。治泻痢，血崩，带下，吐血，衄血并涩精淋沥。安心，镇五脏，除烦，疗惊悸排脓，治疮疖，痔 ，养脾气，壮筋骨，补虚损，久服悦色，纹理腻。缀唇者为上。出∶ 川、阳城或生洛。"}]},{"ID":"20240614162553-vs2scob","Type":"NodeThematicBreak","Properties":{"id":"20240614162553-vs2scob","updated":"20240614162553"}},{"ID":"20240614162553-bboa7kk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162553-bboa7kk","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"黑石脂《千金翼方》"}]},{"ID":"20240614162553-60pkhvv","Type":"NodeParagraph","Properties":{"id":"20240614162553-60pkhvv","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"味咸，平，无毒。主养肾气，强阴，主阴蚀疮，止肠 泻痢，疗口疮咽痛。久服益气，不饥延年。一名石涅，一名石墨。出 川阳城，采无时。"}]},{"ID":"20240614162553-46h868j","Type":"NodeThematicBreak","Properties":{"id":"20240614162553-46h868j","updated":"20240614162553"}},{"ID":"20240614162553-c5ohu1o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162553-c5ohu1o","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"黑石脂《证类本草》"}]},{"ID":"20240614162553-kmw8jho","Type":"NodeParagraph","Properties":{"id":"20240614162553-kmw8jho","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"味咸，平，无毒。主养肾气，强阴，主阴蚀疮，止肠 泄痢，疗口疮咽痛。久服益气，不饥，延年。一名石涅，一名石墨。出 川阳城。采无时。"}]},{"ID":"20240614162553-mqj3hsw","Type":"NodeParagraph","Properties":{"id":"20240614162553-mqj3hsw","updated":"20240614162553"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此五石脂如《本经》，疗体亦相似，《别录》各条，所以具载，今俗用赤石、白石二脂尔，《仙经》亦用白石脂，以涂丹釜。好者出吴郡，犹与赤石脂同源。赤石脂多赤而色好，唯可断下，不入五石散用。好者亦出武陵、建平、义阳。今五石散皆用义阳者，出KT县界东八十里，状如豚脑，色鲜红可爱，随采复而生，不能断痢，而不用之。余三色脂有，而无正用，黑石脂乃可画用尔。唐本注云∶义阳即申州也，所出者，名桃花石，非五色脂，色如桃花，久服肥人。土人亦以疗下痢，旧出苏州、余杭山大有，今不收采尔。臣禹锡等谨按吴氏云∶五色石脂，一名青、赤、黄、白、黑符。青符，神农∶甘。雷公∶酸，无毒。桐君∶辛，无毒，李氏∶小寒。生南山或海崖。采无时。赤符，神农、雷公∶甘。黄帝、扁鹊∶无毒。李氏∶小寒。或生少室，或生泰山。色绛，滑如脂。黄符，季氏∶小寒。雷公∶苦。或生嵩山。色如豚脑、雁雏。采无时。白符，一名随。岐伯、雷公∶酸，无毒。季氏∶小寒。桐君∶甘，无毒。扁鹊∶辛。或生少室、天娄山，或泰山。黑符，一名石泥。桐君∶甘，无毒。生洛西山空地。日华子云∶五色石脂，并温，无毒。畏黄芩、大黄。治泻痢，血崩带下，吐血、衄血，并涩精、淋 ，安心，镇五脏，除烦，疗惊悸，排脓，治疮疖痔 ，养脾气，壮筋骨，补虚损。久服悦色，纹理腻，缀唇者为上也。"}]},{"ID":"20240614162707-k8yswc0","Type":"NodeThematicBreak","Properties":{"id":"20240614162707-k8yswc0"}},{"ID":"20240614162708-w6lbeb5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162708-w6lbeb5","updated":"20240614162712"},"Children":[{"Type":"NodeText","Data":"黄石脂《新修本草》"}]},{"ID":"20240614162708-tjem8wg","Type":"NodeParagraph","Properties":{"id":"20240614162708-tjem8wg","updated":"20240614162708"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主养脾气，安五脏，调中，大人小儿泄痢肠 ，下脓血，去白虫，除黄胆，痈疽虫。久服轻身延年。生嵩高山，色如莺雏，采无时。"}]},{"ID":"20240614162708-txqqfyx","Type":"NodeParagraph","Properties":{"id":"20240614162708-txqqfyx","updated":"20240614162708"},"Children":[{"Type":"NodeText","Data":"曾青为之使，恶细莘，畏蜚蠊。"}]},{"ID":"20240614162708-o90y6zh","Type":"NodeParagraph","Properties":{"id":"20240614162708-o90y6zh","updated":"20240614162708"},"Children":[{"Type":"NodeText","Data":"白石脂，味甘、酸、平，无毒。主养肺气，浓肠，补骨髓，疗五脏惊悸不足，心下烦，止腹痛下水，小肠 热溏，便脓血，女子崩中，漏下，赤白沃，排痈疽疮痔。久服安心，不饥，轻身，长年。生太山之阴，采无时。"}]},{"ID":"20240614162708-dx2rfe5","Type":"NodeParagraph","Properties":{"id":"20240614162708-dx2rfe5","updated":"20240614162708"},"Children":[{"Type":"NodeText","Data":"得浓朴并米汁饮，止便脓。燕屎为之使，恶松脂，畏黄芩。"}]},{"ID":"20240614162708-vekz0ql","Type":"NodeParagraph","Properties":{"id":"20240614162708-vekz0ql","updated":"20240614162708"},"Children":[{"Type":"NodeText","Data":"〔谨案〕白石脂，今出慈州诸山，胜于余处者。太山左侧，不闻有之。"}]},{"ID":"20240614162719-7tcayv0","Type":"NodeThematicBreak","Properties":{"id":"20240614162719-7tcayv0"}},{"ID":"20240614162720-cw9japj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162720-cw9japj","updated":"20240614162724"},"Children":[{"Type":"NodeText","Data":"黄石脂《千金翼方》"}]},{"ID":"20240614162720-f0faknv","Type":"NodeParagraph","Properties":{"id":"20240614162720-f0faknv","updated":"20240614162720"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主养脾气，安五脏，调中，大人小儿泻痢，肠 下脓血，去白虫，除黄胆，痈疽虫。久服轻身延年，生嵩高山。色如莺雏，采无时。"}]},{"ID":"20240614162801-p0q3wf7","Type":"NodeThematicBreak","Properties":{"id":"20240614162801-p0q3wf7"}},{"ID":"20240614162803-xa4xwds","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162803-xa4xwds","updated":"20240614162811"},"Children":[{"Type":"NodeText","Data":"黄石脂《名医别录》"}]},{"ID":"20240614162803-swa08lp","Type":"NodeParagraph","Properties":{"id":"20240614162803-swa08lp","updated":"20240614162803"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主养脾气，安五脏，调中，大人小儿泄痢肠，下脓血，去白虫黄胆，痈疽虫。久服轻身延年。生嵩高山，色如莺，采无时。（曾青为之使，恶细辛，畏蜚蠊。"}]},{"ID":"20240614162816-y089uwh","Type":"NodeThematicBreak","Properties":{"id":"20240614162816-y089uwh"}},{"ID":"20240614162817-px5q3go","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162817-px5q3go","updated":"20240614162822"},"Children":[{"Type":"NodeText","Data":"黄石脂《证类本草》"}]},{"ID":"20240614162817-rsisqqr","Type":"NodeParagraph","Properties":{"id":"20240614162817-rsisqqr","updated":"20240614162817"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主养脾气，安五脏，调中，大小、小儿泄痢肠 ，下脓血，去白虫，除黄胆，痈疽虫。久服轻身延年。生嵩高山。色如莺雏。采无时。（曾青为之使，恶细辛，畏蜚蠊。）"}]},{"ID":"20240614162817-etix5tv","Type":"NodeParagraph","Properties":{"id":"20240614162817-etix5tv","updated":"20240614162817"},"Children":[{"Type":"NodeText","Data":"唐本余畏黄连、甘草、蜚蠊。雷公云凡使，须研如粉，用新汲水投于器中，搅不住手，了，倾作一盆。如此飞过三度。澄者去之，取飞过者，任入药中使用，服之不问多少，不得食卵味。"}]},{"ID":"20240614162907-nh5t1ua","Type":"NodeThematicBreak","Properties":{"id":"20240614162907-nh5t1ua"}},{"ID":"20240614162908-u1ztpdu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162908-u1ztpdu","updated":"20240614162915"},"Children":[{"Type":"NodeText","Data":"青石脂《证类本草》"}]},{"ID":"20240614162908-zhl468v","Type":"NodeParagraph","Properties":{"id":"20240614162908-zhl468v","updated":"20240614162908"},"Children":[{"Type":"NodeText","Data":"味酸，平、无毒。主养肝胆气，明目，疗黄胆，泄痢肠 ，女子带下百病，及疽痔，恶疮。久服补髓，益气，不饥，延年。生齐区山及海崖。采无时。"}]},{"ID":"20240614162908-5nmg9o2","Type":"NodeParagraph","Properties":{"id":"20240614162908-5nmg9o2","updated":"20240614162908"},"Children":[{"Type":"NodeText","Data":"别说云∶谨按唐注云∶出苏州余杭山。今不采。而苏州今乃见贡赤、白二种，然入药不甚佳。唯延州山中所出最良。揭两石中取之。延州每以蕃寇围城，苦无水，乃撅地深广三、五丈，以石脂密固贮水，得经时久不渗漏，宜以此为良。"}]},{"ID":"20240614162916-ptsgc06","Type":"NodeThematicBreak","Properties":{"id":"20240614162916-ptsgc06"}},{"ID":"20240614162922-pxihvs9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162922-pxihvs9","updated":"20240614162926"},"Children":[{"Type":"NodeText","Data":"青石脂《名医别录》"}]},{"ID":"20240614162922-027ysg2","Type":"NodeParagraph","Properties":{"id":"20240614162922-027ysg2","updated":"20240614162922"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒．主养肝胆气，明目，治黄胆，泄痢，肠 ，女子带下百病，及疽恶疮．久服补髓，益气，不饥，延年．生齐区山及海崖，采无时．"}]},{"ID":"20240614162930-nho5qpw","Type":"NodeThematicBreak","Properties":{"id":"20240614162930-nho5qpw"}},{"ID":"20240614162931-0tc0zod","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614162931-0tc0zod","updated":"20240614162936"},"Children":[{"Type":"NodeText","Data":"青石脂《增广和剂局方药性总论》"}]},{"ID":"20240614162931-qg8nh3b","Type":"NodeParagraph","Properties":{"id":"20240614162931-qg8nh3b","updated":"20240614162931"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主养肝胆气，明目，疗黄胆，泄痢，肠癖，女子带下百病及疽痔，恶疮。补髓，益气。不饥延年。"}]},{"ID":"20240606175652-ms8e5s2","Type":"NodeThematicBreak","Properties":{"id":"20240606175652-ms8e5s2"}},{"ID":"20240606175728-wqw0h11","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240606175728-wqw0h11","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"《中国药典》：赤石脂"}]},{"ID":"20240606175728-the4f09","Type":"NodeParagraph","Properties":{"id":"20240606175728-the4f09","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240606175728-0iw59dz","Type":"NodeParagraph","Properties":{"id":"20240606175728-0iw59dz","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" Chì Shí Zhī"}]},{"ID":"20240606175728-dtlf172","Type":"NodeParagraph","Properties":{"id":"20240606175728-dtlf172","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240606175728-olib9md","Type":"NodeParagraph","Properties":{"id":"20240606175728-olib9md","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" HALLOYSITUM RUBRUM"}]},{"ID":"20240606175728-4hhe4et","Type":"NodeParagraph","Properties":{"id":"20240606175728-4hhe4et","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240606175728-b8h6mzn","Type":"NodeParagraph","Properties":{"id":"20240606175728-b8h6mzn","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 本品为硅酸盐类矿物多水高岭石族"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多水高岭石"},{"Type":"NodeText","Data":"，主含含水硅酸铝 ［Al4（Si4O10）（OH）8.4H2O]。采挖后，除去杂质。"}]},{"ID":"20240606175728-vtthryi","Type":"NodeParagraph","Properties":{"id":"20240606175728-vtthryi","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240606175728-fre1g1k","Type":"NodeParagraph","Properties":{"id":"20240606175728-fre1g1k","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 本品为块状集合体，呈不规则的块状。粉红色、红色至紫红色，或有红白相间的花纹。质软，易碎，断面有的具蜡样光泽。吸水性强。具黏土气，味淡，嚼之无沙粒感。"}]},{"ID":"20240606175728-tfjnsn5","Type":"NodeParagraph","Properties":{"id":"20240606175728-tfjnsn5","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240606175728-4x1720m","Type":"NodeParagraph","Properties":{"id":"20240606175728-4x1720m","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防潮。"}]},{"ID":"20240606175728-q7knfo1","Type":"NodeParagraph","Properties":{"id":"20240606175728-q7knfo1","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240606175728-q5pbblm","Type":"NodeParagraph","Properties":{"id":"20240606175728-q5pbblm","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"赤石脂"},{"Type":"NodeText","Data":"：除去杂质，打碎或研细粉。"}]},{"ID":"20240606175728-xjymp5o","Type":"NodeParagraph","Properties":{"id":"20240606175728-xjymp5o","updated":"20240606175728"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"煅赤石粉"},{"Type":"NodeText","Data":"：取赤石脂细粉，用醋调匀，搓条，切段，干燥，放无烟的炉火或坩锅内煅烧，煅至红透。用时捣碎。"}]},{"ID":"20240606175728-053f2xs","Type":"NodeParagraph","Properties":{"id":"20240606175728-053f2xs","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240606175728-aoh7mu8","Type":"NodeParagraph","Properties":{"id":"20240606175728-aoh7mu8","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 归胃、大肠经。"}]},{"ID":"20240606175728-frh1ha8","Type":"NodeParagraph","Properties":{"id":"20240606175728-frh1ha8","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240606175728-hdybm05","Type":"NodeParagraph","Properties":{"id":"20240606175728-hdybm05","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 甘、酸、涩，温。"}]},{"ID":"20240606175728-pmqpqnq","Type":"NodeParagraph","Properties":{"id":"20240606175728-pmqpqnq","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240606175728-ld69dbl","Type":"NodeParagraph","Properties":{"id":"20240606175728-ld69dbl","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 不宜与肉桂同用。"}]},{"ID":"20240606175728-8vkn0sn","Type":"NodeParagraph","Properties":{"id":"20240606175728-8vkn0sn","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240606175728-j1vac5d","Type":"NodeParagraph","Properties":{"id":"20240606175728-j1vac5d","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 涩肠，止血，生肌敛疮。用于久泻久痢，大便出血，崩漏带下；外治疮疡不敛，湿疹脓水浸淫。"}]},{"ID":"20240606175728-9iqiy7l","Type":"NodeParagraph","Properties":{"id":"20240606175728-9iqiy7l","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240606175728-nzyt9er","Type":"NodeParagraph","Properties":{"id":"20240606175728-nzyt9er","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 9～12g。外用适量，研末敷患处。"}]},{"ID":"20240606175728-hr943al","Type":"NodeParagraph","Properties":{"id":"20240606175728-hr943al","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240606175728-j7u665d","Type":"NodeParagraph","Properties":{"id":"20240606175728-j7u665d","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240606175728-npftbcp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240606175728-npftbcp","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：赤石脂"}]},{"ID":"20240606175728-ir8uu3j","Type":"NodeParagraph","Properties":{"id":"20240606175728-ir8uu3j","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240606175728-xy1vgqy","Type":"NodeParagraph","Properties":{"id":"20240606175728-xy1vgqy","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" Chì Shí Zhī"}]},{"ID":"20240606175728-a5tdak8","Type":"NodeParagraph","Properties":{"id":"20240606175728-a5tdak8","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240606175728-d6v3axu","Type":"NodeParagraph","Properties":{"id":"20240606175728-d6v3axu","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 赤符（《吴普本草》），红高岭（《增订伪药条辨》），赤石土（《中药形性经验鉴别法》），吃油脂（《中药志》），红土（《药材学》）。"}]},{"ID":"20240606175728-ihu3jre","Type":"NodeParagraph","Properties":{"id":"20240606175728-ihu3jre","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240606175728-hybpzso","Type":"NodeParagraph","Properties":{"id":"20240606175728-hybpzso","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240606175728-elos3uc","Type":"NodeParagraph","Properties":{"id":"20240606175728-elos3uc","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240606175728-vhd35vc","Type":"NodeParagraph","Properties":{"id":"20240606175728-vhd35vc","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 为硅酸盐类矿物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多水高岭土"},{"Type":"NodeText","Data":"的一种红色块状体。挖出后，选择红色滑腻如脂的块状体，拣去杂石、泥土。"}]},{"ID":"20240606175728-c8r3x5r","Type":"NodeParagraph","Properties":{"id":"20240606175728-c8r3x5r","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240606175728-b6bfyxv","Type":"NodeParagraph","Properties":{"id":"20240606175728-b6bfyxv","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 产福建、河南、江苏、陕西、湖北、山东、安徽、山西等地。"}]},{"ID":"20240606175728-iip354l","Type":"NodeParagraph","Properties":{"id":"20240606175728-iip354l","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240606175728-enjg2sa","Type":"NodeParagraph","Properties":{"id":"20240606175728-enjg2sa","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 单斜晶系。很少成结晶状态，多数为胶凝体。白色通常染有浅红、浅褐、浅黄、浅蓝、浅绿等色。新鲜断面具蜡样光泽，疏松多孔的则呈土状光泽。有平坦的贝壳状断口。硬度1～2。比重2.0～2.2，随水分子的含量而有变化。性脆。可塑性强。有土样气味，致密块状者在干燥时可裂成碎块。主要产于岩石的风化壳和粘土层中。"}]},{"ID":"20240606175728-0it6ul3","Type":"NodeParagraph","Properties":{"id":"20240606175728-0it6ul3","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240606175728-i3awyf0","Type":"NodeParagraph","Properties":{"id":"20240606175728-i3awyf0","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 为不规则的块状，大小不一。表面粉红色、红色至紫红色，或有红白相间的花纹，光滑如脂。质细腻，易砸碎，断面平滑，吸水性强，用舌舔之粘舌。有泥土气，味淡。以色红，光滑细腻，易碎，舌舔之粘性强者为佳。"}]},{"ID":"20240606175728-i5x222p","Type":"NodeParagraph","Properties":{"id":"20240606175728-i5x222p","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240606175728-k84fy3s","Type":"NodeParagraph","Properties":{"id":"20240606175728-k84fy3s","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 主要成分为水化硅酸铝，尚含相当多的氧化铁等物质，其组成如下：硅42.93％、铝36.58％、氧化铁及锰4.85％、镁及钙0.94％、水分14.75％。赤石脂与高岭土极其相似，事实上赤石脂在150～200℃，尚余二分子的水时，即成高岭土。普通的赤石脂是带红色的，但由于它所含氧化铁、氧化锰的多寡，故颜色可从白、灰，以至青绿、黄、红、褐等色；而高岭土则比较纯粹，故多为白、灰色。"}]},{"ID":"20240606175728-imsl4w5","Type":"NodeParagraph","Properties":{"id":"20240606175728-imsl4w5","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240606175728-hy16pv7","Type":"NodeParagraph","Properties":{"id":"20240606175728-hy16pv7","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 煅石脂：拣净杂质，碾成细粉，用醋和匀，搓条切段，晒干，置坩埚内，在无烟的炉火中煅红透，取出，放凉。"}]},{"ID":"20240606175728-hfm4265","Type":"NodeParagraph","Properties":{"id":"20240606175728-hfm4265","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"赤石脂，研如粉，新汲水飞过三度，晒干用。\""}]},{"ID":"20240606175728-ul94oz6","Type":"NodeParagraph","Properties":{"id":"20240606175728-ul94oz6","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240606175728-scu2ib2","Type":"NodeParagraph","Properties":{"id":"20240606175728-scu2ib2","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 入脾、胃、大肠经。"}]},{"ID":"20240606175728-of08weu","Type":"NodeParagraph","Properties":{"id":"20240606175728-of08weu","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"①《本草衍义补遗》：\"赤入小肠，白入大肠。\""}]},{"ID":"20240606175728-3dt20ny","Type":"NodeParagraph","Properties":{"id":"20240606175728-3dt20ny","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入心经。\""}]},{"ID":"20240606175728-r6jh6dg","Type":"NodeParagraph","Properties":{"id":"20240606175728-r6jh6dg","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入手阳明，兼入手、足少阴经。\""}]},{"ID":"20240606175728-f3lx8nc","Type":"NodeParagraph","Properties":{"id":"20240606175728-f3lx8nc","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"④《本草新编》：\"入脾与大肠。\""}]},{"ID":"20240606175728-2qddl5i","Type":"NodeParagraph","Properties":{"id":"20240606175728-2qddl5i","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240606175728-dq3kq9v","Type":"NodeParagraph","Properties":{"id":"20240606175728-dq3kq9v","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 甘涩，温。"}]},{"ID":"20240606175728-d1axmu5","Type":"NodeParagraph","Properties":{"id":"20240606175728-d1axmu5","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240606175728-tn0j4de","Type":"NodeParagraph","Properties":{"id":"20240606175728-tn0j4de","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"味甘酸辛，大温，无毒。\""}]},{"ID":"20240606175728-kuw5rpy","Type":"NodeParagraph","Properties":{"id":"20240606175728-kuw5rpy","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"温，无毒。\""}]},{"ID":"20240606175728-6ya4jlo","Type":"NodeParagraph","Properties":{"id":"20240606175728-6ya4jlo","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"④《长沙药解》：\"味甘酸辛，性涩。\""}]},{"ID":"20240606175728-0kxgh42","Type":"NodeParagraph","Properties":{"id":"20240606175728-0kxgh42","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240606175728-x5cojza","Type":"NodeParagraph","Properties":{"id":"20240606175728-x5cojza","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 有湿热积滞者忌服。孕妇慎服。"}]},{"ID":"20240606175728-yu7l9gr","Type":"NodeParagraph","Properties":{"id":"20240606175728-yu7l9gr","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶大黄。畏芫花。\""}]},{"ID":"20240606175728-0apj45h","Type":"NodeParagraph","Properties":{"id":"20240606175728-0apj45h","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"恶松脂。\""}]},{"ID":"20240606175728-qjsi1v2","Type":"NodeParagraph","Properties":{"id":"20240606175728-qjsi1v2","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"畏黄芩、大黄、官桂。\""}]},{"ID":"20240606175728-g8gfoxj","Type":"NodeParagraph","Properties":{"id":"20240606175728-g8gfoxj","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"火热暴注者不宜用。滞下全是湿热，于法当忌，自非的受寒邪，下痢白积者不宜用。崩中法当补阴清热，不可全仗收涩；滞下本属湿热积滞，法当祛暑除积，土涩之药，定非所宜，慎之慎之。\""}]},{"ID":"20240606175728-jnuk079","Type":"NodeParagraph","Properties":{"id":"20240606175728-jnuk079","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240606175728-z6cb3qt","Type":"NodeParagraph","Properties":{"id":"20240606175728-z6cb3qt","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 涩肠，止血，收湿，生肌。治久泻，久痢，便血，脱肛，遗精，崩漏，带下，溃疡不敛。"}]},{"ID":"20240606175728-f77w82b","Type":"NodeParagraph","Properties":{"id":"20240606175728-f77w82b","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主黄疸，泄痢，肠澼脓血，阴蚀下血赤白，邪气痈肿，疽痔恶疮，头疡疥瘙。\""}]},{"ID":"20240606175728-tceymua","Type":"NodeParagraph","Properties":{"id":"20240606175728-tceymua","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主养心气，明目，益精，疗腹痛泄澼，下痢赤白，小便利，及痈疽疮痔，女子崩中、漏下、产难、胞衣不出。\""}]},{"ID":"20240606175728-3nhik2c","Type":"NodeParagraph","Properties":{"id":"20240606175728-3nhik2c","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"补五脏虚乏。\""}]},{"ID":"20240606175728-wmr94cy","Type":"NodeParagraph","Properties":{"id":"20240606175728-wmr94cy","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治泻痢，血崩带下，吐血衄血，并涩精淋沥，安心，镇五脏，除烦，疗惊悸，排脓，治疮疖痔瘘，养脾气，壮筋骨，补虚损。\""}]},{"ID":"20240606175728-jrpnbvl","Type":"NodeParagraph","Properties":{"id":"20240606175728-jrpnbvl","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑤《珍珠囊》：\"固脱。\""}]},{"ID":"20240606175728-m3puilt","Type":"NodeParagraph","Properties":{"id":"20240606175728-m3puilt","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"补心血，生肌肉，厚肠胃，除水湿，收脱肛。\""}]},{"ID":"20240606175728-2yc9pd4","Type":"NodeParagraph","Properties":{"id":"20240606175728-2yc9pd4","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑦《本草汇言》：\"渗停水，去湿气，敛疮口，固滑脱，止泻痢肠澼，禁崩中淋带。\""}]},{"ID":"20240606175728-f0vtfve","Type":"NodeParagraph","Properties":{"id":"20240606175728-f0vtfve","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240606175728-qi4ps5l","Type":"NodeParagraph","Properties":{"id":"20240606175728-qi4ps5l","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～4钱；或入丸、散。外用：研末撒或调敷。"}]},{"ID":"20240606175728-lgt8yra","Type":"NodeParagraph","Properties":{"id":"20240606175728-lgt8yra","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240606175728-a7b6grn","Type":"NodeParagraph","Properties":{"id":"20240606175728-a7b6grn","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" ①治少阴病下利脓血者：赤石脂一斤（一半全用、一半筛末），干姜一两，粳米一升。上三味，以水七升，煮米令热，去滓，温服七合，内赤石脂末方寸匕，日三服，若一服愈，余勿服。（《伤寒论》桃花汤）"}]},{"ID":"20240606175728-znj99ki","Type":"NodeParagraph","Properties":{"id":"20240606175728-znj99ki","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"②伤寒服汤药，下利不止，心下痞鞕，服泻心汤已，复以他药下之，利不止，医以理中与之，利益甚，此利在下焦：赤石脂一斤（碎），太乙禹余粮一斤（碎）。上二味，以水六升，煮取二升，去滓，分温三服。（《伤寒论》赤石脂禹余粮汤）"}]},{"ID":"20240606175728-n0sqd5m","Type":"NodeParagraph","Properties":{"id":"20240606175728-n0sqd5m","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"③治大肠寒滑，小便精出：赤石脂、干姜各-两，胡椒半两。同为末，醋和丸梧子大。空心及饭前米饮下五、七十丸。（《本草衍义》）"}]},{"ID":"20240606175728-5e465tz","Type":"NodeParagraph","Properties":{"id":"20240606175728-5e465tz","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"④治小儿疳泻：赤石脂杵罗为末如面，以粥饮调半钱服。或以京芎等分同服。（《斗门方》）"}]},{"ID":"20240606175728-x4ncokm","Type":"NodeParagraph","Properties":{"id":"20240606175728-x4ncokm","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑤治痢后，躽气下，推出肛门不入：赤石脂（拣去土）、伏龙肝各等分。上为细末。每用半钱敷肠头上，频用。（《小儿药证直诀》赤石脂散）"}]},{"ID":"20240606175728-874mgui","Type":"NodeParagraph","Properties":{"id":"20240606175728-874mgui","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑥治妇人久赤白带下：赤石脂一两，白芍一两，干姜一两（炮裂，锉）。上药捣细罗为散。每于食前，以粥饮调下二钱。（《圣惠方》）"}]},{"ID":"20240606175728-nxy9tcd","Type":"NodeParagraph","Properties":{"id":"20240606175728-nxy9tcd","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑦治血痔下血至多：赤石脂、白矾（烧令汁尽）、龙骨各一两半，杏仁（汤浸，去皮、尖、双仁，炒，研）一百枚。上四味，捣罗为末，炼蜜丸如梧桐子大。空心枣汤下二十丸，日再，以差为度。（《圣济总录》赤石脂丸）"}]},{"ID":"20240606175728-5dmi6vg","Type":"NodeParagraph","Properties":{"id":"20240606175728-5dmi6vg","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑧治小便不禁：牡蛎（白者）三两，赤石脂三两（捣碎）。上同研匀，酒煮面和丸如梧桐子大。每服十五丸，空心，盐汤送下。（《普济方》牡蛎丸）"}]},{"ID":"20240606175728-izhoqse","Type":"NodeParagraph","Properties":{"id":"20240606175728-izhoqse","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑨治心痛彻背，背痛彻心：赤石脂一两，蜀椒一两。乌头一分（炮），附子半两，干姜一两。上五味，末之，蜜丸如悟子大。先食服一丸，日三服，不知，稍加服。（《金匮要略》赤石脂丸）"}]},{"ID":"20240606175728-hl14k64","Type":"NodeParagraph","Properties":{"id":"20240606175728-hl14k64","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑩治痰饮盛，吐水无时节，其源为冷饮过度，遂令痼冷，脾胃气羸，不能消于食饮，食饮入胃，皆变成冷水，反吐不停者：赤石脂三斤，捣筛为散，服方寸匕，日三，酒、饮并可下之，稍稍渐加之三匕，服尽三斤。（《千金翼方》赤石脂散）"}]},{"ID":"20240606175728-mgtajei","Type":"NodeParagraph","Properties":{"id":"20240606175728-mgtajei","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑾治反胃：赤石脂一升（好腻无砂者），捣罗研，以蜜和丸，如梧桐子大。每日空腹，以生姜汤下十丸，加至二十丸。（《圣惠方》赤石脂丸）"}]},{"ID":"20240606175728-rlngnx2","Type":"NodeParagraph","Properties":{"id":"20240606175728-rlngnx2","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"⑿治外伤出血：赤石脂八份，五倍子六份，松香六份。共研细末，撒于伤口，加压包扎。（内蒙古《中草药新医疗法资料选编》）"}]},{"ID":"20240606175728-8oytgun","Type":"NodeParagraph","Properties":{"id":"20240606175728-8oytgun","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240606175728-tii1vxz","Type":"NodeParagraph","Properties":{"id":"20240606175728-tii1vxz","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240606175728-69tv01o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240606175728-69tv01o","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"《中华本草》《中药大辞典》：赤石脂"}]},{"ID":"20240606175728-rss64f6","Type":"NodeParagraph","Properties":{"id":"20240606175728-rss64f6","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240606175728-kux5qat","Type":"NodeParagraph","Properties":{"id":"20240606175728-kux5qat","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" Chì Shí Zhī"}]},{"ID":"20240606175728-1y22ff4","Type":"NodeParagraph","Properties":{"id":"20240606175728-1y22ff4","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240606175728-tuyndic","Type":"NodeParagraph","Properties":{"id":"20240606175728-tuyndic","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 赤符、红高岭、赤石土、吃油脂、红土"}]},{"ID":"20240606175728-4m2w283","Type":"NodeParagraph","Properties":{"id":"20240606175728-4m2w283","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240606175728-fsshvvb","Type":"NodeParagraph","Properties":{"id":"20240606175728-fsshvvb","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" Halloysit，Red Halloysite"}]},{"ID":"20240606175728-sy6nuk0","Type":"NodeParagraph","Properties":{"id":"20240606175728-sy6nuk0","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240606175728-niy2qwl","Type":"NodeParagraph","Properties":{"id":"20240606175728-niy2qwl","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240606175728-ew9x1k0","Type":"NodeParagraph","Properties":{"id":"20240606175728-ew9x1k0","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240606175728-on4vzbd","Type":"NodeParagraph","Properties":{"id":"20240606175728-on4vzbd","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 药材基源：为硅酸盐类矿物多水高岭土的一种红色块状体。"}]},{"ID":"20240606175728-041m0bx","Type":"NodeParagraph","Properties":{"id":"20240606175728-041m0bx","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Halloysite"}]},{"ID":"20240606175728-o680m3g","Type":"NodeParagraph","Properties":{"id":"20240606175728-o680m3g","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"采收和储藏：挖出后，选择红色滑腻如脂的块状体，拣去杂石、泥土。"}]},{"ID":"20240606175728-7uh0ffs","Type":"NodeParagraph","Properties":{"id":"20240606175728-7uh0ffs","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240606175728-4op1e66","Type":"NodeParagraph","Properties":{"id":"20240606175728-4op1e66","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 生态环境：主要产于岩石的风化壳和粘土层中。"}]},{"ID":"20240606175728-vno94eu","Type":"NodeParagraph","Properties":{"id":"20240606175728-vno94eu","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"资源分布：主要产地有辽宁、内蒙古、河北、山西、陕西、甘肃、山东、江苏、安徽、浙江、江西、福建、河南、湖北、湖南、广东、四川等地，西藏羊八井也有分布。"}]},{"ID":"20240606175728-6bxgysc","Type":"NodeParagraph","Properties":{"id":"20240606175728-6bxgysc","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240606175728-eh7gxrk","Type":"NodeParagraph","Properties":{"id":"20240606175728-eh7gxrk","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 单斜晶系。很少成结晶状态，多数为胶凝体。白色通常染有浅红、浅褐、浅黄、浅蓝、浅绿等色。新鲜断面具蜡样光泽，疏松多孔的则呈土状光泽。有平坦的贝壳状断口。硬度1-2。比重2.0-2.2，随水分子的含量而有变化。性脆。可塑性强。有土样气味，致密块状者在干燥时可裂成碎块。"}]},{"ID":"20240606175728-i2a47rm","Type":"NodeParagraph","Properties":{"id":"20240606175728-i2a47rm","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240606175728-ffd1mob","Type":"NodeParagraph","Properties":{"id":"20240606175728-ffd1mob","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品为块状集合体，呈不规则块状，表面局部平坦，全体凹凸不平。浅红色、红色至紫红色，或红白相间呈花纹状。土状光泽或蜡样光泽；不透明。体较轻，质软，用指甲可刻划成痕；断面平坦，具蜡样光泽。吸水力强，舐灾害粘舌。微有粘土气，味淡，嚼之无沙粒感。以色红、光滑细腻、质软、易断、吸水力强者为佳。"}]},{"ID":"20240606175728-an4e09r","Type":"NodeParagraph","Properties":{"id":"20240606175728-an4e09r","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"显微鉴别 透射偏光镜下：薄片中无色透明，微带黄褐色。结晶极细，一般偏光显微镜的放大数倍根本不能分辩其晶粒界限；低负突起或低正突起，很不明显。干涉色很低。几乎似均质体。当用电子显微镜观察，多水高岭石呈棒状集合体。"}]},{"ID":"20240606175728-2s6pgn1","Type":"NodeParagraph","Properties":{"id":"20240606175728-2s6pgn1","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240606175728-fcspipu","Type":"NodeParagraph","Properties":{"id":"20240606175728-fcspipu","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 主要成分为水化硅酸铝[Al4(Si4O10)(OH)8·4H2O]，尚含相当多的氧化铁(Fe2O3)等物质，其组成如下：硅42.93%,铝36.58%,氧化亚铁(FeO)4.85%,锰4.85%,镁及钙0.94%,水分14.75%。另外，还含有钛、镍、锶、钡等微量元素。"}]},{"ID":"20240606175728-b15r7d3","Type":"NodeParagraph","Properties":{"id":"20240606175728-b15r7d3","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240606175728-j1u17fe","Type":"NodeParagraph","Properties":{"id":"20240606175728-j1u17fe","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 内服能吸着消化道内有毒物质及食物异常发酵的产物等。对发炎的胃肠粘膜有局部保护作用，并对胃肠道出血有止血作用。赤石脂20、40g/kg灌胃，可缩短小鼠(毛细管法)凝血时间和大鼠血浆复钙时间，对ADP诱导的兔、大鼠血小板聚集和小鼠体内ADP诱导的血小板血栓形成均有抑制作用。"}]},{"ID":"20240606175728-itxnlsz","Type":"NodeParagraph","Properties":{"id":"20240606175728-itxnlsz","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240606175728-i70j7oe","Type":"NodeParagraph","Properties":{"id":"20240606175728-i70j7oe","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 煅石脂：拣净杂质，碾成细粉，用醋和匀，搓条切段，晒干，置坩埚内，在无烟的炉火中煅红透，取出，放凉；赤石脂，研如粉，新汲水飞过三度，晒干用。"}]},{"ID":"20240606175728-8a8tdet","Type":"NodeParagraph","Properties":{"id":"20240606175728-8a8tdet","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240606175728-6od4q13","Type":"NodeParagraph","Properties":{"id":"20240606175728-6od4q13","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" (1)取本品1小块（约1g），置具有小孔软木寒的试管内，灼烧，管壁有较多水生成，小块颜色变深。（检查结晶水）(2)取本品粉末约1g，置瓷蒸发皿中，加水10ml与硫酸5ml，加热至产生白烟，冷却，缓缓加水20ml，煮沸2-3min，滤过，滤渣为淡紫棕色，滤液显铝盐的各种反应。详见“白石脂”条。"}]},{"ID":"20240606175728-y0cbi5x","Type":"NodeParagraph","Properties":{"id":"20240606175728-y0cbi5x","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"(3)取上述滤液1ml，加亚铁氰化钾试液，即发生深蓝色沉淀。（检查铁盐）"}]},{"ID":"20240606175728-npdnyv6","Type":"NodeParagraph","Properties":{"id":"20240606175728-npdnyv6","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240606175728-q7uubfb","Type":"NodeParagraph","Properties":{"id":"20240606175728-q7uubfb","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 脾；胃；心；大肠经"}]},{"ID":"20240606175728-n69undt","Type":"NodeParagraph","Properties":{"id":"20240606175728-n69undt","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240606175728-zllcr13","Type":"NodeParagraph","Properties":{"id":"20240606175728-zllcr13","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 甘；涩；酸；温；无毒"}]},{"ID":"20240606175728-wvdecri","Type":"NodeParagraph","Properties":{"id":"20240606175728-wvdecri","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240606175728-w3m80k7","Type":"NodeParagraph","Properties":{"id":"20240606175728-w3m80k7","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 有湿热积滞者忌服。孕妇慎服。《本草经集注》：恶大黄，畏芫花。《药性论》：恶松脂。《日华子本草》：畏黄芩、大黄、官桂。《本草经疏》：火热暴注者不宜用。滞下全是湿热，于法当忌，自非的受寒邪，下痢白积者不宜用。崩中法当补阴清热，不可全仗收涩；滞下本属湿热积滞，法当祛暑除积，止涩之药，定非所宜，慎之慎之。"}]},{"ID":"20240606175728-ah7rxlw","Type":"NodeParagraph","Properties":{"id":"20240606175728-ah7rxlw","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240606175728-ornfm2z","Type":"NodeParagraph","Properties":{"id":"20240606175728-ornfm2z","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 涩肠；收敛止血；收湿敛疮；生肌。主久泻；久痢；便血；脱肛；遗精；崩漏；带下；溃疡不敛；湿疹；外伤出血"}]},{"ID":"20240606175728-hqrur8e","Type":"NodeParagraph","Properties":{"id":"20240606175728-hqrur8e","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240606175728-1uh4jq0","Type":"NodeParagraph","Properties":{"id":"20240606175728-1uh4jq0","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-4钱；或入丸、散。外用：研末撒或调敷。"}]},{"ID":"20240606175728-pjmtgnv","Type":"NodeParagraph","Properties":{"id":"20240606175728-pjmtgnv","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240606175728-c7tq4xe","Type":"NodeParagraph","Properties":{"id":"20240606175728-c7tq4xe","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 1.桃花汤(《伤寒论》)，治久痢不愈，便脓血，色暗不鲜，小便不利，腹痛喜按喜温等。2.赤石脂禹余粮汤(《伤寒论》)，治泻痢日久，滑泄不禁等病。3.滋血汤(《太平惠民和剂局方》)，用治妇人劳伤太过，冲任气虚，不能约制经血，崩中下血，或鲜血，或瘀血，连日不止，淋漓不断。4.陀僧膏(《医宗金鉴·外科心法要诀》)，用治诸般恶疮，流注瘰疬，跌扑损伤，金刃伤等。5.赤石脂丸(《金匮要略》)，用治阴寒固结，心痛彻背，背痛彻心者。6.赤石脂散(《阎氏小儿方论》)，治小儿痢后脱肛。7.救母丹(《中华人民共和国药典》1977年版)，功效固涩冲任，止血定痛，主治崩漏，吐血，咳血，便血，尿血，功能性子宫出血等病。"}]},{"ID":"20240606175728-tsbza0f","Type":"NodeParagraph","Properties":{"id":"20240606175728-tsbza0f","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240606175728-t4ctqhe","Type":"NodeParagraph","Properties":{"id":"20240606175728-t4ctqhe","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主黄疸，泄痢，肠僻脓血，阴蚀下血赤白，邪气痈肿，疽痔恶疮，头疡疥瘙。"}]},{"ID":"20240606175728-purev2o","Type":"NodeParagraph","Properties":{"id":"20240606175728-purev2o","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：主养心气，明目，益精，疗腹痛泄僻，下痢赤白，小便利，及痈疽疮痔，女子崩中、漏下、产难、胞衣不出。"}]},{"ID":"20240606175728-m6fmf5v","Type":"NodeParagraph","Properties":{"id":"20240606175728-m6fmf5v","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：补五脏虚乏。"}]},{"ID":"20240606175728-rrd0zhc","Type":"NodeParagraph","Properties":{"id":"20240606175728-rrd0zhc","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：治泻痢，血崩带下，吐血衄血，并涩精淋沥，安心，镇五脏，除烦，疗惊悸，排脓，治疮疖痔痿，养脾气，壮筋骨，补虚损。"}]},{"ID":"20240606175728-c6amdhf","Type":"NodeParagraph","Properties":{"id":"20240606175728-c6amdhf","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"5.《珍珠囊》：固脱。"}]},{"ID":"20240606175728-60oa4sw","Type":"NodeParagraph","Properties":{"id":"20240606175728-60oa4sw","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"6.《本草纲目》：补心血，生肌肉，厚肠胃，除水湿，收脱肛。"}]},{"ID":"20240606175728-86v68et","Type":"NodeParagraph","Properties":{"id":"20240606175728-86v68et","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"7.《本草汇言》：渗停水，去湿气，敛疮口，固滑脱，止泻痢肠僻，禁崩中淋带。"}]},{"ID":"20240606175728-tfxllv4","Type":"NodeParagraph","Properties":{"id":"20240606175728-tfxllv4","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"8.李杲：赤石脂，其用有二，固肠胃有收敛之能，下胎衣无推荡之峻。"}]},{"ID":"20240606175728-4911x2t","Type":"NodeParagraph","Properties":{"id":"20240606175728-4911x2t","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"9.《本草纲目》：五色脂，涩而重，故能收湿止血而固下。甘而温，故能益气生肌而调中。中者，肠胃肌肉惊悸黄疸是也。下者，肠僻泄痢崩带失精是也。五种主疗，大抵相同，故《本经》不分条目。《别录》虽分五种，而性味主治亦不甚相远，但以五味配五色为异，亦是强分尔。赤白二种，一入气分，一入血分，故时用尚之。仲景桃花汤，治下利便脓血者，取石脂之重涩，入下焦血分而固脱，干姜之辛温，暖下焦气分而补虚，粳米之甘温，佐石脂而固肠胃也。10.《本经逢原》：赤石脂功专止血固下。《本经》养心气，明目益精，是指精血脱泄之病而言，用以固敛其脱，则目明精益矣。疗腹痛肠僻等疾，以其开泄无度，日久不止，故取涩以固之也。治产难胞衣不出，乃指日久去血过多，无力迸下，故以重以镇之也。东垣所谓胞衣不出，涩剂可以下之，设血气壅滞，而胞衣不出，又非石脂所宜也。"}]},{"ID":"20240606175728-xjc406d","Type":"NodeParagraph","Properties":{"id":"20240606175728-xjc406d","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"11.《本草求真》：赤石脂与禹余、粟壳皆属收涩固脱之剂，但粟壳体轻微寒，其功止入气分敛肺，此则甘温质重色赤，能入下焦血分固脱，及兼溃疡收口，长肉生肌也。禹余粮甘平性涩，其重过于石脂，此则功专主涩，其曰镇坠，终逊余粮之力耳。是以石脂之温，则能益气生肌；石脂之酸，则能止血固下。至云能以明目益精，亦是精血既脱，得此固敛，始见目明而精益矣。催生下胎，亦是味兼辛温，化其恶血，恶血去则胞与胎自无阻耳。故曰：固肠有收敛之能，下胎无推荡之峻。"}]},{"ID":"20240606175728-6j7g22b","Type":"NodeParagraph","Properties":{"id":"20240606175728-6j7g22b","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240606175728-bhd0i45","Type":"NodeParagraph","Properties":{"id":"20240606175728-bhd0i45","updated":"20240606175728"},"Children":[{"Type":"NodeText","Data":" 《中华本草》《中药大辞典》"}]},{"ID":"20240606175730-9aefpuz","Type":"NodeThematicBreak","Properties":{"id":"20240606175730-9aefpuz"}},{"ID":"20240614161614-t9tf8mw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161614-t9tf8mw","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：白石脂"}]},{"ID":"20240614161614-nq5h4wf","Type":"NodeParagraph","Properties":{"id":"20240614161614-nq5h4wf","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614161614-tnt32nm","Type":"NodeParagraph","Properties":{"id":"20240614161614-tnt32nm","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" Bái Shí Zhī"}]},{"ID":"20240614161614-bgyy99k","Type":"NodeParagraph","Properties":{"id":"20240614161614-bgyy99k","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614161614-ouhn4kx","Type":"NodeParagraph","Properties":{"id":"20240614161614-ouhn4kx","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 矿物硅酸盐的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白陶土"},{"Type":"NodeText","Data":"（Kaolin），与赤石脂类同，惟色白或带淡红、淡黄色。成分在比例上稍与赤石脂相异。一般认为以色白细腻粘舌无泥土、砂石等杂质为佳。"}]},{"ID":"20240614161614-t5jtyn8","Type":"NodeParagraph","Properties":{"id":"20240614161614-t5jtyn8","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614161614-6i73i9l","Type":"NodeParagraph","Properties":{"id":"20240614161614-6i73i9l","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 甘、酸，平。"}]},{"ID":"20240614161614-s5qc4p2","Type":"NodeParagraph","Properties":{"id":"20240614161614-s5qc4p2","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614161614-pg63sdk","Type":"NodeParagraph","Properties":{"id":"20240614161614-pg63sdk","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 为涩肠止泻药。现一般外用做吸收剂。"}]},{"ID":"20240614161614-2999jv0","Type":"NodeParagraph","Properties":{"id":"20240614161614-2999jv0","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614161614-hq89b28","Type":"NodeParagraph","Properties":{"id":"20240614161614-hq89b28","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240614161614-uj8d2ht","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161614-uj8d2ht","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：白石脂"}]},{"ID":"20240614161614-8tirng4","Type":"NodeParagraph","Properties":{"id":"20240614161614-8tirng4","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614161614-a3lx3uj","Type":"NodeParagraph","Properties":{"id":"20240614161614-a3lx3uj","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" Bái Shí Zhī"}]},{"ID":"20240614161614-p5e2jzj","Type":"NodeParagraph","Properties":{"id":"20240614161614-p5e2jzj","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614161614-7kjburn","Type":"NodeParagraph","Properties":{"id":"20240614161614-7kjburn","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 白符、随（《吴普本草》），白陶土、高岭土（《矿物药与丹药》）"}]},{"ID":"20240614161614-c9gl0mw","Type":"NodeParagraph","Properties":{"id":"20240614161614-c9gl0mw","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614161614-mrjawxc","Type":"NodeParagraph","Properties":{"id":"20240614161614-mrjawxc","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240614161614-e6yctzj","Type":"NodeParagraph","Properties":{"id":"20240614161614-e6yctzj","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614161614-1dbie3u","Type":"NodeParagraph","Properties":{"id":"20240614161614-1dbie3u","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 为硅酸盐类矿物。"}]},{"ID":"20240614161614-5bkv4fs","Type":"NodeParagraph","Properties":{"id":"20240614161614-5bkv4fs","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614161614-crlrfxf","Type":"NodeParagraph","Properties":{"id":"20240614161614-crlrfxf","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 主要成分为水化硅酸铝，含氧化硅46.5％，氧化铝39.5％，水14.0％。但常含铁、镁、钙等杂质；分析1例如下：氧化硅42～46，氧化铝37～40，氧化铁0.5～0.9，氧化锑0～1，氧化钙0～0.7，氧化镁0～0.3，氧化钾0～0.5，氧化钠0～0.6％。"}]},{"ID":"20240614161614-wi8sz3x","Type":"NodeParagraph","Properties":{"id":"20240614161614-wi8sz3x","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614161614-mq5n0ig","Type":"NodeParagraph","Properties":{"id":"20240614161614-mq5n0ig","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"手、足阳明。\""}]},{"ID":"20240614161614-kysatus","Type":"NodeParagraph","Properties":{"id":"20240614161614-kysatus","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"②《要药分剂》：\"入肺、大肠二经。\""}]},{"ID":"20240614161614-rc5mdk8","Type":"NodeParagraph","Properties":{"id":"20240614161614-rc5mdk8","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614161614-qyiq90i","Type":"NodeParagraph","Properties":{"id":"20240614161614-qyiq90i","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 甘酸，平。"}]},{"ID":"20240614161614-ndcl1qh","Type":"NodeParagraph","Properties":{"id":"20240614161614-ndcl1qh","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240614161614-0zojz5z","Type":"NodeParagraph","Properties":{"id":"20240614161614-0zojz5z","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"歧伯、雷公：酸，无毒。李氏：小寒。扁鹊：辛。\""}]},{"ID":"20240614161614-rwv9nos","Type":"NodeParagraph","Properties":{"id":"20240614161614-rwv9nos","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"味甘酸：平，无毒。\""}]},{"ID":"20240614161614-41hs30z","Type":"NodeParagraph","Properties":{"id":"20240614161614-41hs30z","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：：温，无毒。\""}]},{"ID":"20240614161614-8ro2wf0","Type":"NodeParagraph","Properties":{"id":"20240614161614-8ro2wf0","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614161614-66dzl7j","Type":"NodeParagraph","Properties":{"id":"20240614161614-66dzl7j","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 有湿热积滞者忌服."}]},{"ID":"20240614161614-mjgk9b3","Type":"NodeParagraph","Properties":{"id":"20240614161614-mjgk9b3","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"燕屎为之使。恶松脂。畏黄芩。\""}]},{"ID":"20240614161614-lfqf4ut","Type":"NodeParagraph","Properties":{"id":"20240614161614-lfqf4ut","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"恶马目毒公。\""}]},{"ID":"20240614161614-tc83bhk","Type":"NodeParagraph","Properties":{"id":"20240614161614-tc83bhk","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"③《蜀本草》：\"畏黄连、甘草、飞廉。\""}]},{"ID":"20240614161614-q38e3s8","Type":"NodeParagraph","Properties":{"id":"20240614161614-q38e3s8","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"畏黄芩、大黄、官桂。\""}]},{"ID":"20240614161614-9hrxjm9","Type":"NodeParagraph","Properties":{"id":"20240614161614-9hrxjm9","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614161614-r57o0l2","Type":"NodeParagraph","Properties":{"id":"20240614161614-r57o0l2","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 涩肠，止血。治久泻，久痢，崩漏带下，遗精。"}]},{"ID":"20240614161614-ke7bxvn","Type":"NodeParagraph","Properties":{"id":"20240614161614-ke7bxvn","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主黄疸泄痢，肠辩脓血，阴蚀下血亦白，邪气痈肿，疽痔恶疮，头疡疥瘙。\""}]},{"ID":"20240614161614-bqm3pco","Type":"NodeParagraph","Properties":{"id":"20240614161614-bqm3pco","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"养肺气，厚肠，补骨髓，疗五脏惊悸不足，心下烦，止腹痛，下水，小肠澼热溏便脓血，女子崩中漏下赤白沃。\""}]},{"ID":"20240614161614-zyh8cma","Type":"NodeParagraph","Properties":{"id":"20240614161614-zyh8cma","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"涩大肠。\""}]},{"ID":"20240614161614-4dqh93a","Type":"NodeParagraph","Properties":{"id":"20240614161614-4dqh93a","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治泻痢，血崩带下，吐血衄血，并涩精淋沥，安心镇五脏，除烦疗惊悸，排脓治疮疖痔漏，养脾气，壮筋骨，补虚损。\""}]},{"ID":"20240614161614-n5kmfzw","Type":"NodeParagraph","Properties":{"id":"20240614161614-n5kmfzw","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"⑤《珍珠囊》：\"固脱。\""}]},{"ID":"20240614161614-gl5z2n9","Type":"NodeParagraph","Properties":{"id":"20240614161614-gl5z2n9","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614161614-3q1musq","Type":"NodeParagraph","Properties":{"id":"20240614161614-3q1musq","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～4钱；或入丸、散。外用：研末撒或调敷。"}]},{"ID":"20240614161614-vexr9fy","Type":"NodeParagraph","Properties":{"id":"20240614161614-vexr9fy","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240614161614-trbp332","Type":"NodeParagraph","Properties":{"id":"20240614161614-trbp332","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" ①治小儿水痢，形羸不胜大汤药：白石脂半大两，研如粉，和白粥空肚与食。（《子母秘录》）"}]},{"ID":"20240614161614-58w05yn","Type":"NodeParagraph","Properties":{"id":"20240614161614-58w05yn","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"②治小儿泻清水不止：白石脂一分，白龙骨一分。上为细末，滴水为丸，如芥子大。每服三、四十丸至五十丸，紫苏木瓜汤下，日进三服，量儿大小，加减服之。（《百一选方》白龙丸）"}]},{"ID":"20240614161614-y2wfa9m","Type":"NodeParagraph","Properties":{"id":"20240614161614-y2wfa9m","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"③止便脓：白石脂，得厚朴并米汁饮。（《药对》）"}]},{"ID":"20240614161614-yikj4i6","Type":"NodeParagraph","Properties":{"id":"20240614161614-yikj4i6","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"④治冷痢，食不消化及有白脓，日夜无节度：白石脂、干姜各八分。上二味捣筛为末，以沸汤和少许面薄糊和药，并手捻作丸，如食法。（《外台》）"}]},{"ID":"20240614161614-ouoaliw","Type":"NodeParagraph","Properties":{"id":"20240614161614-ouoaliw","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"⑤治小儿脐中汁出不止，兼赤肿：白石脂细末，熬温扑脐中，日三。（《独行方》）"}]},{"ID":"20240614161614-rcd5g9a","Type":"NodeParagraph","Properties":{"id":"20240614161614-rcd5g9a","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614161614-ire8uvd","Type":"NodeParagraph","Properties":{"id":"20240614161614-ire8uvd","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240614161614-i4onkwa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614161614-i4onkwa","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"《中华本草》《中药大辞典》：白石脂"}]},{"ID":"20240614161614-qppcstk","Type":"NodeParagraph","Properties":{"id":"20240614161614-qppcstk","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614161614-0qotwp6","Type":"NodeParagraph","Properties":{"id":"20240614161614-0qotwp6","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" Bái Shí Zhī"}]},{"ID":"20240614161614-45ze50z","Type":"NodeParagraph","Properties":{"id":"20240614161614-45ze50z","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614161614-wlec18n","Type":"NodeParagraph","Properties":{"id":"20240614161614-wlec18n","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 白符、随、白陶土、高岭土"}]},{"ID":"20240614161614-gibd42j","Type":"NodeParagraph","Properties":{"id":"20240614161614-gibd42j","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240614161614-96mx3jq","Type":"NodeParagraph","Properties":{"id":"20240614161614-96mx3jq","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" Kaolinite"}]},{"ID":"20240614161614-9jszzd5","Type":"NodeParagraph","Properties":{"id":"20240614161614-9jszzd5","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614161614-dbm7hur","Type":"NodeParagraph","Properties":{"id":"20240614161614-dbm7hur","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 出自1.《本经》。"}]},{"ID":"20240614161614-rfnj2ff","Type":"NodeParagraph","Properties":{"id":"20240614161614-rfnj2ff","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"2.《吴普本草》：白符生少室天娄山，或太山。"}]},{"ID":"20240614161614-1qqag5p","Type":"NodeParagraph","Properties":{"id":"20240614161614-1qqag5p","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"3.《别录》：白石脂，生泰山之阴。采无时。"}]},{"ID":"20240614161614-rgfp85r","Type":"NodeParagraph","Properties":{"id":"20240614161614-rgfp85r","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"4.《唐本草》：按白石脂今出慈州诸山，胜于余处者。太山左侧，不闻有之。"}]},{"ID":"20240614161614-kgyj312","Type":"NodeParagraph","Properties":{"id":"20240614161614-kgyj312","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"5.《本草图经》：白石脂，今惟潞州有焉，潞与慈相近，此亦应可用。古断下方多用，而今医家亦稀使。五色石脂，旧经同一条，并生南山之阳山谷中，主治并同，后人各分之，所出既殊，功用亦别，然今惟用赤白二种"}]},{"ID":"20240614161614-wjemr8n","Type":"NodeParagraph","Properties":{"id":"20240614161614-wjemr8n","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614161614-4ekksrd","Type":"NodeParagraph","Properties":{"id":"20240614161614-4ekksrd","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 药材基源：为硅酸盐类矿物。"}]},{"ID":"20240614161614-g8y339q","Type":"NodeParagraph","Properties":{"id":"20240614161614-g8y339q","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Kaolinite"}]},{"ID":"20240614161614-tmrxecw","Type":"NodeParagraph","Properties":{"id":"20240614161614-tmrxecw","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614161614-jmrlzsd","Type":"NodeParagraph","Properties":{"id":"20240614161614-jmrlzsd","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 生态环境：高岭石是粘土矿物中最常见的一种，是粘土质沉积物的主要矿物成分。"}]},{"ID":"20240614161614-lt9n46l","Type":"NodeParagraph","Properties":{"id":"20240614161614-lt9n46l","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"资源分布：主产山西、河南、江苏、河北、山东。"}]},{"ID":"20240614161614-sc6668s","Type":"NodeParagraph","Properties":{"id":"20240614161614-sc6668s","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614161614-m9um7cx","Type":"NodeParagraph","Properties":{"id":"20240614161614-m9um7cx","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 晶体结构属三斜晶系或单斜晶系。单晶体呈片状，罕见，且个体极小，在电子显微镜下可看到片状晶体呈六方形、三角 形或切角的三角形。集合体成疏松鳞片状、土状或致密块状，偶见钟乳状。纯者白色，如被铁、锰等杂质混入可染成浅黄、浅灰、浅红、浅绿、浅褐等色。条痕白色或灰白色。致密块体无光泽或呈蜡状光泽，细薄鳞片可呈珍珠光泽。硬度1-3，相对密度2.61-2.68。具有滑腻感，土臭味，吸水粘舌，可塑性强，但不膨胀。"}]},{"ID":"20240614161614-yqvwi3k","Type":"NodeParagraph","Properties":{"id":"20240614161614-yqvwi3k","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614161614-d1nojub","Type":"NodeParagraph","Properties":{"id":"20240614161614-d1nojub","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品为不规则块状。粉白色或类白色，有的带有浅红色或很浅黄色斑纹或条纹；条良白色。体较轻，质软，用指甲可刻划成痕。断面土状光泽。吸水力强，舐之粘舌，嚼之无沙粒感；具土腥气，味微。以色白、细腻、吸水力强者为佳。"}]},{"ID":"20240614161614-q04kyry","Type":"NodeParagraph","Properties":{"id":"20240614161614-q04kyry","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"显微鉴别 透射偏光镜下：薄片中无色，正突起低。干涉色为Ⅰ级灰白色。于扫描电镜下成堆叠的假六方片状；于透射电镜下为假六方片状，厚度均匀，轮廓清楚。"}]},{"ID":"20240614161614-e1los0e","Type":"NodeParagraph","Properties":{"id":"20240614161614-e1los0e","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614161614-ntjijvk","Type":"NodeParagraph","Properties":{"id":"20240614161614-ntjijvk","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 主要成分为水化硅酸铝，其中二氧化硅（SiO2）46.5%，三氧化二铝（Al2O3）39.5%，水（H2O）14.0%；还常含锶、钡、锰、钛、锌、铅、铜、锂等元素。"}]},{"ID":"20240614161614-3uj14ul","Type":"NodeParagraph","Properties":{"id":"20240614161614-3uj14ul","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614161614-ezylrp5","Type":"NodeParagraph","Properties":{"id":"20240614161614-ezylrp5","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 取本品粉末约1g,置瓷蒸发皿中，加水10ml与硫酸5ml,加热至产生白烟，冷却，缓缓加水20ml,煮沸2-3min,滤过，滤渣为灰色。滤液照下述方法试验：①取滤液1ml，加氢氧化钠试液，即发生白色胶状沉淀；分离，沉淀能在过量的氢氧化钠试液中溶解。（检查铝盐）②取滤液1ml，加氨试液至生成白色胶状沉淀，滴加茜素磺酸钠指示液数滴，沉淀即显樱红色。（检查铝盐）"}]},{"ID":"20240614161614-xsqtvfb","Type":"NodeParagraph","Properties":{"id":"20240614161614-xsqtvfb","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614161614-m828yew","Type":"NodeParagraph","Properties":{"id":"20240614161614-m828yew","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 肺；大肠经"}]},{"ID":"20240614161614-28nye6q","Type":"NodeParagraph","Properties":{"id":"20240614161614-28nye6q","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614161614-q1c6vlv","Type":"NodeParagraph","Properties":{"id":"20240614161614-q1c6vlv","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 甘酸；平；无毒"}]},{"ID":"20240614161614-u8q6gmh","Type":"NodeParagraph","Properties":{"id":"20240614161614-u8q6gmh","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614161614-otac8bk","Type":"NodeParagraph","Properties":{"id":"20240614161614-otac8bk","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 有湿热积滞者忌服。"}]},{"ID":"20240614161614-t97hftg","Type":"NodeParagraph","Properties":{"id":"20240614161614-t97hftg","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614161614-xbcdw0c","Type":"NodeParagraph","Properties":{"id":"20240614161614-xbcdw0c","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 涩肠；止血；固脱；收湿敛疮。主久泻；久痢；崩漏带下；遗精；疮疡不敛"}]},{"ID":"20240614161614-cjn9wcx","Type":"NodeParagraph","Properties":{"id":"20240614161614-cjn9wcx","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614161614-y6owktm","Type":"NodeParagraph","Properties":{"id":"20240614161614-y6owktm","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-4钱；或入丸、散。外用：研末撒或调敷。"}]},{"ID":"20240614161614-8b22t82","Type":"NodeParagraph","Properties":{"id":"20240614161614-8b22t82","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614161614-gydmcum","Type":"NodeParagraph","Properties":{"id":"20240614161614-gydmcum","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 1.《本经逢原》：白石脂，敛肺气，涩大肠，《金匮》风引汤用之，专取其杜虚风复入之路也。"}]},{"ID":"20240614161614-7sz8k9q","Type":"NodeParagraph","Properties":{"id":"20240614161614-7sz8k9q","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"2.《本经》：主黄疸泄痢，肠bi脓血，阴蚀下血亦白，邪气痈肿，疽痔恶疮，头疡疥瘙。"}]},{"ID":"20240614161614-dj7xmy5","Type":"NodeParagraph","Properties":{"id":"20240614161614-dj7xmy5","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"3.《别录》：养肺气，厚肠，补骨髓，疗五脏惊悸不足，心下烦，止腹痛，下水，小肠bi热溏便脓血，女子崩中漏下赤白沃。"}]},{"ID":"20240614161614-3kpfw7v","Type":"NodeParagraph","Properties":{"id":"20240614161614-3kpfw7v","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：涩大肠。"}]},{"ID":"20240614161614-b0vkgtx","Type":"NodeParagraph","Properties":{"id":"20240614161614-b0vkgtx","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：治泻痢，血崩带下，吐血衄血，并涩精淋沥，安心镇五脏，除烦疗惊悸，排脓治疮疖痔漏，养脾气，壮筋骨，补虚损。"}]},{"ID":"20240614161614-em31413","Type":"NodeParagraph","Properties":{"id":"20240614161614-em31413","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"6.《珍珠囊》：固脱。"}]},{"ID":"20240614161614-i403xjz","Type":"NodeParagraph","Properties":{"id":"20240614161614-i403xjz","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614161614-k7m0p8g","Type":"NodeParagraph","Properties":{"id":"20240614161614-k7m0p8g","updated":"20240614161614"},"Children":[{"Type":"NodeText","Data":" 《中华本草》《中药大辞典》"}]},{"ID":"20240614161616-60lgkai","Type":"NodeThematicBreak","Properties":{"id":"20240614161616-60lgkai"}},{"ID":"20240614162604-v9jc1if","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240614162604-v9jc1if","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"黄石脂"}]},{"ID":"20240614162604-etlst5y","Type":"NodeParagraph","Properties":{"id":"20240614162604-etlst5y","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240614162604-11p8mz6","Type":"NodeParagraph","Properties":{"id":"20240614162604-11p8mz6","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" Huánɡ Shí Zhī"}]},{"ID":"20240614162604-okkygdm","Type":"NodeParagraph","Properties":{"id":"20240614162604-okkygdm","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240614162604-v6by3bn","Type":"NodeParagraph","Properties":{"id":"20240614162604-v6by3bn","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 黄符"}]},{"ID":"20240614162604-ful6n5u","Type":"NodeParagraph","Properties":{"id":"20240614162604-ful6n5u","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240614162604-ozqobo8","Type":"NodeParagraph","Properties":{"id":"20240614162604-ozqobo8","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 黄石脂始载于《本经》，列为上品。"}]},{"ID":"20240614162604-k00crpa","Type":"NodeParagraph","Properties":{"id":"20240614162604-k00crpa","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"1．《吴普本草》云：“或生嵩山(今河南登封县北)，色如豚脑、雁(《别录》作‘鹰’，一作‘莺’)雏。采无时。”2．《品汇精要》云：“黄石脂，文理腻，缀唇者为上。质类滑石酥软，色黄。”据古本草所述黄石脂与赤石脂、白石脂性状相同，性味功效亦相类似(见“赤石脂”条)，仅颜色不同而已，这是因五石脂的主矿物组分均为硅酸盐类"}]},{"ID":"20240614162604-kcx7yht","Type":"NodeParagraph","Properties":{"id":"20240614162604-kcx7yht","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240614162604-wwcrded","Type":"NodeParagraph","Properties":{"id":"20240614162604-wwcrded","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 药材基源：为硅酸盐类水云母族矿物水云母—伊利石(含氢氧化铁)或(和)高岭石族矿物高岭石一多水高岭石为主要组分的细分散多矿物集合体。"}]},{"ID":"20240614162604-xxp3eks","Type":"NodeParagraph","Properties":{"id":"20240614162604-xxp3eks","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Hydromica；Halloysite"}]},{"ID":"20240614162604-yychuba","Type":"NodeParagraph","Properties":{"id":"20240614162604-yychuba","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"采收和储藏：采挖后，除去杂质。"}]},{"ID":"20240614162604-3m27l5l","Type":"NodeParagraph","Properties":{"id":"20240614162604-3m27l5l","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240614162604-utyegp9","Type":"NodeParagraph","Properties":{"id":"20240614162604-utyegp9","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.主要是酸性火成岩或火山岩蚀变产物，山西、河北、河南及华南许多省区均有产出；在华南瓷土产区多与白石脂、赤石脂共存。风化带淋滤富集的水云母质黄石脂，多出现于赤石脂层之下。"}]},{"ID":"20240614162604-2tdv630","Type":"NodeParagraph","Properties":{"id":"20240614162604-2tdv630","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"2.高岭石-多水高岭石 参见“赤石脂”条。"}]},{"ID":"20240614162604-pbz1869","Type":"NodeParagraph","Properties":{"id":"20240614162604-pbz1869","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"资源分布：产黑龙江、四川、贵州。"}]},{"ID":"20240614162604-u08pvak","Type":"NodeParagraph","Properties":{"id":"20240614162604-u08pvak","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240614162604-zph9rcz","Type":"NodeParagraph","Properties":{"id":"20240614162604-zph9rcz","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 1.个体片状，集合体鳞片状、薄片状分散或呈致密到疏松的块体(呈胶体分散状态的水云母，特称伊利石Illite)；白色，因吸附有少量氢氧化铁而呈黄色；或带灰、红、绿色调。致密块体呈油脂状光泽，断口贝壳状到似贝壳状；疏松块体呈土状光泽，断口不平，有孔隙。硬度2-3。相对密度2.5-2.8。有滑感，粘舌。质纯者的离子交换能力和吸附性低于含多水高岭石或蒙脱石-囊脱石；粒度粗的不如粒度细的更具吸附力。"}]},{"ID":"20240614162604-ec7go4f","Type":"NodeParagraph","Properties":{"id":"20240614162604-ec7go4f","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"另含少量石英；微量元素种类与量比取决于原生矿物的成因类型。"}]},{"ID":"20240614162604-2bmpvma","Type":"NodeParagraph","Properties":{"id":"20240614162604-2bmpvma","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"2.高岭石一多水高岭石参见“赤石脂”条。"}]},{"ID":"20240614162604-pgnohls","Type":"NodeParagraph","Properties":{"id":"20240614162604-pgnohls","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240614162604-dd07rz1","Type":"NodeParagraph","Properties":{"id":"20240614162604-dd07rz1","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品为不规则块状。黄色或深黄色，有的带有深黄色花纹或斑点。油脂光泽或土状光泽。质较硬，轻砸可碎，断面不平坦，显层状。摸之较滑腻，微有吸水性，舐之略粘舌。微有土腥气，味淡。以色黄、有光泽、无杂质者为佳。"}]},{"ID":"20240614162604-r64ru2n","Type":"NodeParagraph","Properties":{"id":"20240614162604-r64ru2n","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240614162604-4hrvm0n","Type":"NodeParagraph","Properties":{"id":"20240614162604-4hrvm0n","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 主要为含水硅酸铝钾[KAl(Si4O10)(OH)8·4H2O]，并含有混入物Fe(OH)3·nH2O，因此显黄色。另外还含有镁、钙、钛、钡、锰等微量元素。"}]},{"ID":"20240614162604-77s80vz","Type":"NodeParagraph","Properties":{"id":"20240614162604-77s80vz","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240614162604-zdiy2ky","Type":"NodeParagraph","Properties":{"id":"20240614162604-zdiy2ky","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" (1)X射线衍射分析曲线 水云母9.98(2)，4.98(1)，4.46(1)；多水高岭石 2.45(1)；石英4.25(2)，3.34(10)，2.45(1)。由此表明黄石脂系由水云母、多水高岭石、石英等矿物组成。"}]},{"ID":"20240614162604-29pnm53","Type":"NodeParagraph","Properties":{"id":"20240614162604-29pnm53","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"(2)差热分析曲线 吸热170℃(小)， 315℃(小)，575℃(中)；放热285℃(微)。"}]},{"ID":"20240614162604-hp52v1r","Type":"NodeParagraph","Properties":{"id":"20240614162604-hp52v1r","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240614162604-xlzrpt2","Type":"NodeParagraph","Properties":{"id":"20240614162604-xlzrpt2","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 脾；大肠经"}]},{"ID":"20240614162604-aii5k8k","Type":"NodeParagraph","Properties":{"id":"20240614162604-aii5k8k","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240614162604-2h92q54","Type":"NodeParagraph","Properties":{"id":"20240614162604-2h92q54","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 苦；平；无毒"}]},{"ID":"20240614162604-o4mrxyp","Type":"NodeParagraph","Properties":{"id":"20240614162604-o4mrxyp","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240614162604-s61braw","Type":"NodeParagraph","Properties":{"id":"20240614162604-s61braw","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 有湿热积滞者慎服。"}]},{"ID":"20240614162604-knbad57","Type":"NodeParagraph","Properties":{"id":"20240614162604-knbad57","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：“不得食卵味。”2.《本草经集注》：“恶细辛，畏蜚镰。”3.《新修本草》：“畏黄连、甘草、蜚蠊。”4.《日华子》：“五色石脂：畏黄芩、大黄。”"}]},{"ID":"20240614162604-3ua2r2y","Type":"NodeParagraph","Properties":{"id":"20240614162604-3ua2r2y","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240614162604-lg8jz8h","Type":"NodeParagraph","Properties":{"id":"20240614162604-lg8jz8h","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 健脾涩肠；止血敛疮。主泄痢脓血；痈疽恶疮；久不收口"}]},{"ID":"20240614162604-6bu2dwc","Type":"NodeParagraph","Properties":{"id":"20240614162604-6bu2dwc","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240614162604-j45pdsp","Type":"NodeParagraph","Properties":{"id":"20240614162604-j45pdsp","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-20g，打碎先煎。"}]},{"ID":"20240614162604-wl0c01p","Type":"NodeParagraph","Properties":{"id":"20240614162604-wl0c01p","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240614162604-w1fcqv7","Type":"NodeParagraph","Properties":{"id":"20240614162604-w1fcqv7","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 《别录》：“黄石脂生嵩高山，色如莺雏。采无时。”"}]},{"ID":"20240614162604-wrc9n9o","Type":"NodeParagraph","Properties":{"id":"20240614162604-wrc9n9o","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240614162604-cl71hsf","Type":"NodeParagraph","Properties":{"id":"20240614162604-cl71hsf","updated":"20240614162604"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240614162605-uruhlma","Type":"NodeThematicBreak","Properties":{"id":"20240614162605-uruhlma"}},{"ID":"20240614162606-rigqyv2","Type":"NodeParagraph","Properties":{"id":"20240614162606-rigqyv2"}}]}