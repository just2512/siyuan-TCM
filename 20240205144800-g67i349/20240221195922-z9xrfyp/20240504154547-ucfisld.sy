deBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川穹苗3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川穹苗3-20240619103727-7i0nqje.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 373px;","style":"width: 363px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蘼芜 1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蘼芜 1-20240619102934-twdd4an.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 363px;\" parent-style=\"width: 373px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240806125303-26vhzhf","Type":"NodeParagraph","Properties":{"id":"20240806125303-26vhzhf","updated":"20240806125454"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240806125303-0vw4vya.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 506px;","style":"width: 496px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川穹 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川穹 24-20240806125454-7o1i341.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 496px;\" parent-style=\"width: 506px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616124606-z4fu501","Type":"NodeParagraph","Properties":{"id":"20240616124606-z4fu501","updated":"20240806125235"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：蘼芜，川芎的苗叶"}]},{"ID":"20240616124607-87eowge","Type":"NodeThematicBreak","Properties":{"id":"20240616124607-87eowge"}},{"ID":"20240616124651-pmmdis0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124651-pmmdis0","updated":"20240616124654"},"Children":[{"Type":"NodeText","Data":"蘼芜《神农本草经》"}]},{"ID":"20240616124651-3k6pd6b","Type":"NodeParagraph","Properties":{"id":"20240616124651-3k6pd6b","updated":"20240616124651"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240616124651-r9vpffy","Type":"NodeParagraph","Properties":{"id":"20240616124651-r9vpffy","updated":"20240616124651"},"Children":[{"Type":"NodeText","Data":"主咳逆，定惊气，辟邪恶，除蛊毒鬼注，去三虫，久服通神。一名薇芜。生川泽。"}]},{"ID":"20240616124651-7ysi8sb","Type":"NodeParagraph","Properties":{"id":"20240616124651-7ysi8sb","updated":"20240616124651"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：蘼芜，一名芎（《御览》）。"}]},{"ID":"20240616124651-89p6r0s","Type":"NodeParagraph","Properties":{"id":"20240616124651-89p6r0s","updated":"20240616124651"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名茳蓠，芎苗也，生雍州及冤句，四月五月，采叶暴干。"}]},{"ID":"20240616124651-csdt9xc","Type":"NodeParagraph","Properties":{"id":"20240616124651-csdt9xc","updated":"20240616124651"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蘪，蘪芜也，蓠，茳蓠，蓠芜；《尔雅》云：靳茞蘪芜；郭璞云：香草，叶小如委状；《淮南子》云：似蛇床；《山海经》云：臭如蘪芜，《司马相如赋》，有江离蘪芜；司马贞引樊光云：藁本，一名蘪芜，根名勒芷。"}]},{"ID":"20240616124607-71ou718","Type":"NodeThematicBreak","Properties":{"id":"20240616124607-71ou718"}},{"ID":"20240616124619-yt5g04z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124619-yt5g04z","updated":"20240616124622"},"Children":[{"Type":"NodeText","Data":"蘼芜《本草择要纲目》"}]},{"ID":"20240616124619-tc6zhhw","Type":"NodeParagraph","Properties":{"id":"20240616124619-tc6zhhw","updated":"20240616124619"},"Children":[{"Type":"NodeText","Data":"（一名蕲 ．其叶似当归．其香似白 ．故有蕲 江蓠之名．蓠草生江中．故又曰江蓠．）"}]},{"ID":"20240616124619-9ga7kda","Type":"NodeParagraph","Properties":{"id":"20240616124619-9ga7kda","updated":"20240616124619"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240616124619-jkktqzt","Type":"NodeParagraph","Properties":{"id":"20240616124619-jkktqzt","updated":"20240616124619"},"Children":[{"Type":"NodeText","Data":"辛温无毒．"}]},{"ID":"20240616124619-17t7kc2","Type":"NodeParagraph","Properties":{"id":"20240616124619-17t7kc2","updated":"20240616124619"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616124619-engb6ov","Type":"NodeParagraph","Properties":{"id":"20240616124619-engb6ov","updated":"20240616124619"},"Children":[{"Type":"NodeText","Data":"咳逆．定惊气．辟邪恶．除蛊毒鬼疰．去三虫．久服通神．主身中老风．头中久风风眩．作饮止泄泻．"}]},{"ID":"20240616124619-qvp0qn4","Type":"NodeParagraph","Properties":{"id":"20240616124619-qvp0qn4","updated":"20240616124619"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【花】"},{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240616124619-dlcfiv2","Type":"NodeParagraph","Properties":{"id":"20240616124619-dlcfiv2","updated":"20240616124619"},"Children":[{"Type":"NodeText","Data":"入面脂用．"}]},{"ID":"20240616124607-8iu039z","Type":"NodeThematicBreak","Properties":{"id":"20240616124607-8iu039z"}},{"ID":"20240616124608-yoslie1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124608-yoslie1","updated":"20240616124612"},"Children":[{"Type":"NodeText","Data":"蘼芜《名医别录》"}]},{"ID":"20240616124608-t1boykr","Type":"NodeParagraph","Properties":{"id":"20240616124608-t1boykr","updated":"20240616124608"},"Children":[{"Type":"NodeText","Data":"无毒．主治身中老风，头中久风，风眩．一名江蓠，芎 苗也．生雍州及宛朐．四月五月采叶，曝干．"}]},{"ID":"20240616124608-e6346oe","Type":"NodeParagraph","Properties":{"id":"20240616124608-e6346oe","updated":"20240616124701"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶蘼芜，味辛，温．主咳逆，定惊气，辟邪恶，除蛊毒鬼注，去三虫．久服通神。一名薇芜。生川泽。"}]},{"ID":"20240616124717-uqf34lb","Type":"NodeThematicBreak","Properties":{"id":"20240616124717-uqf34lb"}},{"ID":"20240616124718-h17mlcb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124718-h17mlcb","updated":"20240616124722"},"Children":[{"Type":"NodeText","Data":"蘼芜《本草经集注》"}]},{"ID":"20240616124718-l0cwknn","Type":"NodeParagraph","Properties":{"id":"20240616124718-l0cwknn","updated":"20240616124718"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主治咳逆，定惊气，辟邪恶，除蛊毒鬼疰，去三虫。久服通神。主身中老风，头中久风，风眩。一名薇芜，一名茳蓠，川芎苗也。生雍州川泽及宛朐。四月、五月采叶，曝干。"}]},{"ID":"20240616124718-zjc5nlq","Type":"NodeParagraph","Properties":{"id":"20240616124718-zjc5nlq","updated":"20240616124718"},"Children":[{"Type":"NodeText","Data":"今出历阳，处处亦有，人家多种之，叶似蛇床而香。骚人借以为譬，方药用甚稀。"}]},{"ID":"20240616124538-1c8ga4h","Type":"NodeThematicBreak","Properties":{"id":"20240616124538-1c8ga4h"}},{"ID":"20240616124556-x8yepp0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124556-x8yepp0","updated":"20240616124600"},"Children":[{"Type":"NodeText","Data":"蘼芜《本草纲目》"}]},{"ID":"20240616124556-f4vfccp","Type":"NodeParagraph","Properties":{"id":"20240616124556-f4vfccp","updated":"20240616124556"},"Children":[{"Type":"NodeText","Data":"「释名」亦名薇芜、蕲、江蓠。"}]},{"ID":"20240616124556-nn79wrf","Type":"NodeParagraph","Properties":{"id":"20240616124556-nn79wrf","updated":"20240616124556"},"Children":[{"Type":"NodeText","Data":"「气味」辛、温、无毒。"}]},{"ID":"20240616124556-ypiahu5","Type":"NodeParagraph","Properties":{"id":"20240616124556-ypiahu5","updated":"20240616124556"},"Children":[{"Type":"NodeText","Data":"「主治」头中久风、风眩、泄泻、咳逆等。"}]},{"ID":"20240616124538-tc2rfeh","Type":"NodeThematicBreak","Properties":{"id":"20240616124538-tc2rfeh"}},{"ID":"20240616124547-c91wpo4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124547-c91wpo4","updated":"20240616124551"},"Children":[{"Type":"NodeText","Data":"蘼芜《千金翼方》"}]},{"ID":"20240616124547-a3brojh","Type":"NodeParagraph","Properties":{"id":"20240616124547-a3brojh","updated":"20240616124547"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主咳逆，定惊气，辟邪恶，除蛊毒鬼疰，去三虫。久服通神，主身中老风，头中久风风眩。一名薇芜，一名茳蓠。芎 苗也。生雍州川泽及冤句，四月五月采叶，曝干。"}]},{"ID":"20240616124538-usjy918","Type":"NodeThematicBreak","Properties":{"id":"20240616124538-usjy918"}},{"ID":"20240616124539-956yj1v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616124539-956yj1v","updated":"20240616124543"},"Children":[{"Type":"NodeText","Data":"蘼芜《新修本草》"}]},{"ID":"20240616124539-wjamv21","Type":"NodeParagraph","Properties":{"id":"20240616124539-wjamv21","updated":"20240616124539"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主咳逆，定惊气，辟邪恶，除蛊毒鬼疰，去三虫。久服通神。主身中老风，头中久风，风眩。一名薇芜，一名茳蓠，芎 苗也。生雍州川泽及宛朐。四月、五月采叶，曝干。"}]},{"ID":"20240616124539-bizgmhl","Type":"NodeParagraph","Properties":{"id":"20240616124539-bizgmhl","updated":"20240616124539"},"Children":[{"Type":"NodeText","Data":"今出历阳，处处亦有，人家多种之，叶似蛇床而香。骚人借以为譬，方药用甚希。"}]},{"ID":"20240616124539-r3cwtjv","Type":"NodeParagraph","Properties":{"id":"20240616124539-r3cwtjv","updated":"20240616124539"},"Children":[{"Type":"NodeText","Data":"〔谨案叶，一种如蛇床。香气相似，用亦不殊尔。"}]},{"ID":"20240607114728-7qtkdvn","Type":"NodeThematicBreak","Properties":{"id":"20240607114728-7qtkdvn"}},{"ID":"20240607114729-68rnxc4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114729-68rnxc4","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蘼芜"}]},{"ID":"20240607114729-bsibu0v","Type":"NodeParagraph","Properties":{"id":"20240607114729-bsibu0v","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114729-57cr75n","Type":"NodeParagraph","Properties":{"id":"20240607114729-57cr75n","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" Mí Wú"}]},{"ID":"20240607114729-usbo0ym","Type":"NodeParagraph","Properties":{"id":"20240607114729-usbo0ym","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114729-yijsp9e","Type":"NodeParagraph","Properties":{"id":"20240607114729-yijsp9e","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 蕲莲、蘪芜（《尔雅》），薇芜（《本经》），江蒿（《上林赋》），芎藭苗（《别录》），川芎苗（《履巉岩本草》）。"}]},{"ID":"20240607114729-m5a5n6w","Type":"NodeParagraph","Properties":{"id":"20240607114729-m5a5n6w","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607114729-60bam1s","Type":"NodeParagraph","Properties":{"id":"20240607114729-60bam1s","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607114729-8j8aat8","Type":"NodeParagraph","Properties":{"id":"20240607114729-8j8aat8","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114729-ipr8pnm","Type":"NodeParagraph","Properties":{"id":"20240607114729-ipr8pnm","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"川芎"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苗叶"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607114729-2v5oimx","Type":"NodeParagraph","Properties":{"id":"20240607114729-2v5oimx","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114729-bzyyz6u","Type":"NodeParagraph","Properties":{"id":"20240607114729-bzyyz6u","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：\"入手少阴、足少阳、厥阴经。\""}]},{"ID":"20240607114729-122jzqk","Type":"NodeParagraph","Properties":{"id":"20240607114729-122jzqk","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114729-g7d8x8d","Type":"NodeParagraph","Properties":{"id":"20240607114729-g7d8x8d","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 辛，温。"}]},{"ID":"20240607114729-auu8je1","Type":"NodeParagraph","Properties":{"id":"20240607114729-auu8je1","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240607114729-zzag0vi","Type":"NodeParagraph","Properties":{"id":"20240607114729-zzag0vi","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607114729-xyr29ze","Type":"NodeParagraph","Properties":{"id":"20240607114729-xyr29ze","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114729-x40yq2b","Type":"NodeParagraph","Properties":{"id":"20240607114729-x40yq2b","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 祛脑中风寒。治头风头眩，流泪，多涕唾。"}]},{"ID":"20240607114729-m3d1bxm","Type":"NodeParagraph","Properties":{"id":"20240607114729-m3d1bxm","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主咳逆，定惊气，辟邪恶，去三虫。\""}]},{"ID":"20240607114729-dabvqz5","Type":"NodeParagraph","Properties":{"id":"20240607114729-dabvqz5","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主身中老风，头中久风风眩。\""}]},{"ID":"20240607114729-0hev7i9","Type":"NodeParagraph","Properties":{"id":"20240607114729-0hev7i9","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"作饮香，云可以已泄泻。\""}]},{"ID":"20240607114729-a7z3hyh","Type":"NodeParagraph","Properties":{"id":"20240607114729-a7z3hyh","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"④《履巉岩本草》：\"除脑中冷，治面上游风去来，目泪出，多涕唾及诸头风。食后取苗细嚼，茶清送下。\""}]},{"ID":"20240607114729-suifo5w","Type":"NodeParagraph","Properties":{"id":"20240607114729-suifo5w","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114729-fdnowhc","Type":"NodeParagraph","Properties":{"id":"20240607114729-fdnowhc","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱。"}]},{"ID":"20240607114729-5ogbnwb","Type":"NodeParagraph","Properties":{"id":"20240607114729-5ogbnwb","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607114729-3r6gt6j","Type":"NodeParagraph","Properties":{"id":"20240607114729-3r6gt6j","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 《本草汇言》：\"蘼芜，主头风风眩之药也，此药气味芳香清洁，故去风散湿，本草所称主咳逆，定惊气，作饮止泄泻，皆辛香发越郁遏不正之气欤。\""}]},{"ID":"20240607114729-pw2lffc","Type":"NodeParagraph","Properties":{"id":"20240607114729-pw2lffc","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114729-v0ghz2v","Type":"NodeParagraph","Properties":{"id":"20240607114729-v0ghz2v","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607114729-6qnai48","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607114729-6qnai48","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蘼芜"}]},{"ID":"20240607114729-6u6agu8","Type":"NodeParagraph","Properties":{"id":"20240607114729-6u6agu8","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607114729-mu46nsu","Type":"NodeParagraph","Properties":{"id":"20240607114729-mu46nsu","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" Mí Wú"}]},{"ID":"20240607114729-1x2x24r","Type":"NodeParagraph","Properties":{"id":"20240607114729-1x2x24r","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607114729-xmwl0k4","Type":"NodeParagraph","Properties":{"id":"20240607114729-xmwl0k4","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 蕲芜、薇芜、江蓠、芎穷苗、川芎苗"}]},{"ID":"20240607114729-gyrfh33","Type":"NodeParagraph","Properties":{"id":"20240607114729-gyrfh33","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607114729-laidojx","Type":"NodeParagraph","Properties":{"id":"20240607114729-laidojx","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" stem and leaf of Chuanxiong, stem and leaf of Wallich Ligusticum"}]},{"ID":"20240607114729-hgck6d3","Type":"NodeParagraph","Properties":{"id":"20240607114729-hgck6d3","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607114729-f8afgpd","Type":"NodeParagraph","Properties":{"id":"20240607114729-f8afgpd","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》1． 陶弘景：蘼芜今出历阳，处处亦有，人家多种之。叶似蛇床而香，方药用甚稀。"}]},{"ID":"20240607114729-rahllpy","Type":"NodeParagraph","Properties":{"id":"20240607114729-rahllpy","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"2．《唐本草》：蘼芜有二种，一种叶似芹叶，一种如蛇床，香气相似，用亦不殊尔。"}]},{"ID":"20240607114729-u40sd88","Type":"NodeParagraph","Properties":{"id":"20240607114729-u40sd88","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"3．《纲目》：蘼芜一作麋芜。其茎叶蘼弱而繁芜。故以名之。当归名蕲，白芷名篱，其叶似当归，其香似白芷，故有'江篱'之名。王逸云：'蓠草生江中'，故曰江篱是也，《别录》言蘼芜一名"}]},{"ID":"20240607114729-6qlirwm","Type":"NodeParagraph","Properties":{"id":"20240607114729-6qlirwm","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607114729-j3j1bpj","Type":"NodeParagraph","Properties":{"id":"20240607114729-j3j1bpj","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物川芎的幼嫩茎叶。"}]},{"ID":"20240607114729-08y4d43","Type":"NodeParagraph","Properties":{"id":"20240607114729-08y4d43","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Ligusticum chuanxiong Hort."}]},{"ID":"20240607114729-bzr6s6z","Type":"NodeParagraph","Properties":{"id":"20240607114729-bzr6s6z","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、夏季采收幼嫩茎叶，鲜用或晒干。"}]},{"ID":"20240607114729-egqsclr","Type":"NodeParagraph","Properties":{"id":"20240607114729-egqsclr","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607114729-2vefse0","Type":"NodeParagraph","Properties":{"id":"20240607114729-2vefse0","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高40-70cm。全株有浓烈香气。根茎呈不规则的结节状拳形团埠，下端有多数须根。茎直立，圆柱形，中空，表面有纵直沟纹。茎下部的节膨大成盘状（俗称苓子），中部以上的节不膨大。茎下部叶具柄，柄长3-10cm，基部扩大成鞘；叶片轮廓卵状三角形，长12-15cm，宽10-15cm，三至四回三出式羽状全裂，羽片4-5对，卵状披针形，长6-7cm，宽5-6cm，末回裂片线状披针形至长卵形，长2-5mm，宽1-2mm，顶端有小尖头，仅脉上有稀疏的短柔毛；茎上部叶渐简化。复伞形花序顶生或侧生，总苞片3-6，线形，长0.5-2.5cm；伞辐7-20，不等长，长2-4cm；小伞形花序有花10-24；小总苞片2-7，线形，略带紫色，被柔毛，长3-5mm；萼齿不发育；花瓣白以，倒卵形至椭圆形，先端有短尖状突起，内曲；雄蕊5，花药淡绿色；花柱2，长2-3mm，向下反曲。幼果两侧扁压，长2-3mm，宽约1mm；背棱槽内有油管1-5，侧棱槽内有油管2-3，合生面有油管6-8。花期7-8月，幼果期9-10月。"}]},{"ID":"20240607114729-rlhsqrl","Type":"NodeParagraph","Properties":{"id":"20240607114729-rlhsqrl","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607114729-km5f43z","Type":"NodeParagraph","Properties":{"id":"20240607114729-km5f43z","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 归肝；胆；心经"}]},{"ID":"20240607114729-cxklpbs","Type":"NodeParagraph","Properties":{"id":"20240607114729-cxklpbs","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607114729-qa8i6nt","Type":"NodeParagraph","Properties":{"id":"20240607114729-qa8i6nt","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 味辛；性温"}]},{"ID":"20240607114729-k2352hb","Type":"NodeParagraph","Properties":{"id":"20240607114729-k2352hb","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607114729-dckt2in","Type":"NodeParagraph","Properties":{"id":"20240607114729-dckt2in","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 阴虚内热者慎服。"}]},{"ID":"20240607114729-rfzttm6","Type":"NodeParagraph","Properties":{"id":"20240607114729-rfzttm6","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607114729-k5juiud","Type":"NodeParagraph","Properties":{"id":"20240607114729-k5juiud","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 疏风；平肝。主风眩；惊风；风眼流泪；头风头痛"}]},{"ID":"20240607114729-chuhca1","Type":"NodeParagraph","Properties":{"id":"20240607114729-chuhca1","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607114729-7oo35th","Type":"NodeParagraph","Properties":{"id":"20240607114729-7oo35th","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或嚼服。"}]},{"ID":"20240607114729-8oo1hl8","Type":"NodeParagraph","Properties":{"id":"20240607114729-8oo1hl8","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607114729-uyxojvl","Type":"NodeParagraph","Properties":{"id":"20240607114729-uyxojvl","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 1．《本经》：主咳逆，定惊气，辟邪恶，去三虫。"}]},{"ID":"20240607114729-zfjknwm","Type":"NodeParagraph","Properties":{"id":"20240607114729-zfjknwm","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"2．《别录》：主身中老风，头中久风风眩。"}]},{"ID":"20240607114729-8su8m89","Type":"NodeParagraph","Properties":{"id":"20240607114729-8su8m89","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"3．《本草图经》：作饮香，云可以已泄泻。"}]},{"ID":"20240607114729-c5s9i4s","Type":"NodeParagraph","Properties":{"id":"20240607114729-c5s9i4s","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"4．《履巉岩本草》：除脑中冷，治面上游风去来，目泪出，多涕唾及诸头风。食后取苗细嚼，茶清送下。"}]},{"ID":"20240607114729-9lvoxo6","Type":"NodeParagraph","Properties":{"id":"20240607114729-9lvoxo6","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"5．《本草汇言》：靡芜，主头风风眩之药也，此药气味芳香清洁，故去风散湿，本草所称主咳逆，定惊气，作饮止泄泻，皆辛香发越郁遏不正之气欤。"}]},{"ID":"20240607114729-o4gec9w","Type":"NodeParagraph","Properties":{"id":"20240607114729-o4gec9w","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607114729-08fmjf8","Type":"NodeParagraph","Properties":{"id":"20240607114729-08fmjf8","updated":"20240607114729"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607114730-ml76yij","Type":"NodeThematicBreak","Properties":{"id":"20240607114730-ml76yij"}},{"ID":"20240607114731-qdoo3yh","Type":"NodeParagraph","Properties":{"id":"20240607114731-qdoo3yh"}}]}