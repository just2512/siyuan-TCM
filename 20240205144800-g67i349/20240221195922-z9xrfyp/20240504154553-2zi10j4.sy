{"ID":"20240504154553-2zi10j4","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504154553-2zi10j4","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504154553-2zi10j4\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240618175851-gbkyxji\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240616112554-pai6rp7\u0026quot;,\u0026quot;scrollTop\u0026quot;:1000,\u0026quot;focusId\u0026quot;:\u0026quot;20240619080201-yoob1ph\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"048析蓂子（菥、菥子、菥蓂）","type":"doc","updated":"20240805173038"},"Children":[{"ID":"20240618175851-gbkyxji","Type":"NodeParagraph","Properties":{"id":"20240618175851-gbkyxji","updated":"20240618175851"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 383px;","style":"width: 373px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菥蓂子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菥蓂子-20240618175851-q7e6t3x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 373px;\" parent-style=\"width: 383px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619080201-yoob1ph","Type":"NodeParagraph","Properties":{"id":"20240619080201-yoob1ph","updated":"20240805171123"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 307px;","style":"width: 297px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"析蓂"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/析蓂-20240619080201-wowplyo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 297px;\" parent-style=\"width: 307px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805172108-dmlzfth","Type":"NodePar