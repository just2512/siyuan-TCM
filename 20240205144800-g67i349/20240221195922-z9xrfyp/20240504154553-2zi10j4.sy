age","Data":"span","Properties":{"parent-style":"width: 901px;","style":"width: 891px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"析溟子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/析溟子 2-20240805171810-i2izgjv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 891px;\" parent-style=\"width: 901px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805172739-qce07hw","Type":"NodeParagraph","Properties":{"id":"20240805172739-qce07hw","updated":"20240805172739"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"析溟子 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/析溟子 8-20240805172739-1f5i9qs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805172508-sy5ubq1","Type":"NodeParagraph","Properties":{"id":"20240805172508-sy5ubq1","updated":"20240805172508"}},{"ID":"20240616112350-vlajunm","Type":"NodeThematicBreak","Properties":{"id":"20240616112350-vlajunm"}},{"ID":"20240616112358-090nkdi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616112358-090nkdi","updated":"20240616112403"},"Children":[{"Type":"NodeText","Data":"析蓂子《神农本草经》"}]},{"ID":"20240616112358-fyky1rs","Type":"NodeParagraph","Properties":{"id":"20240616112358-fyky1rs","updated":"20240616112358"},"Children":[{"Type":"NodeText","Data":"味辛微湿。"}]},{"ID":"20240616112358-rfg5crs","Type":"NodeParagraph","Properties":{"id":"20240616112358-rfg5crs","updated":"20240616112358"},"Children":[{"Type":"NodeText","Data":"主明目，目痛泪出，除痹，补五脏，益精光。久服，轻易不老。一名蔑析，一名大蕺，一名马辛。生川泽及道旁。"}]},{"ID":"20240616112358-m5iw4qe","Type":"NodeParagraph","Properties":{"id":"20240616112358-m5iw4qe","updated":"20240616112358"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：析蓂一名析目，一名荣冥，一名马骍，雷公神农扁鹊辛，李氏小温，四月采干，二十日生道旁，得细辛良，畏干姜，苦参荠实，神农无毒，生野田，五月五日采阴干，治腹胀（《御览》）。"}]},{"ID":"20240616112358-umfm3le","Type":"NodeParagraph","Properties":{"id":"20240616112358-umfm3le","updated":"20240616112358"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名大荠，生咸阳，四月五月采，暴干。"}]},{"ID":"20240616112358-sa6tbxs","Type":"NodeParagraph","Properties":{"id":"20240616112358-sa6tbxs","updated":"20240616113330"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蓂，析蓂，大荠也；《广雅》云：析蓂，马辛也；《尔雅》云：析蓂大荠；郭璞云：荠叶细，俗呼之曰老荠，旧作菥，非。"}]},{"ID":"20240616113330-bfv0h4m","Type":"NodeThematicBreak","Properties":{"id":"20240616113330-bfv0h4m"}},{"ID":"20240616113331-pqgvgih","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616113331-pqgvgih","updated":"20240616113336"},"Children":[{"Type":"NodeText","Data":"菥子《名医别录》"}]},{"ID":"20240616113331-228z2bo","Type":"NodeParagraph","Properties":{"id":"20240616113331-228z2bo","updated":"20240616113331"},"Children":[{"Type":"NodeText","Data":"无毒．主治心腹腰痛．一名大荠．生咸阳．四月、五月采，曝干．（得荆实、细恶干姜、苦参．）"}]},{"ID":"20240616113331-4hdrozq","Type":"NodeParagraph","Properties":{"id":"20240616113331-4hdrozq","updated":"20240616113338"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶析 子，味辛，微温．主明目，目痛泪出，除痹，补五脏，益精光．久服轻身不老．一名蔑析，一名大蕺，一名马辛。生川泽及道旁。"}]},{"ID":"20240616113143-azd0olq","Type":"NodeThematicBreak","Properties":{"id":"20240616113143-azd0olq"}},{"ID":"20240616113143-hgwvval","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616113143-hgwvval","updated":"20240616113147"},"Children":[{"Type":"NodeText","Data":"菥子《新修本草》"}]},{"ID":"20240616113143-bj972wl","Type":"NodeParagraph","Properties":{"id":"20240616113143-bj972wl","updated":"20240616113143"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主明目，目痛，泪出，除痹，补五脏，益精光。疗心腹腰痛。久服轻身不老。一名 菥，一名大蕺，一名马辛，一名大荠。生咸阳川泽及道旁。四月、五月采，曝干。"}]},{"ID":"20240616113143-zbmnm34","Type":"NodeParagraph","Properties":{"id":"20240616113143-zbmnm34","updated":"20240616113143"},"Children":[{"Type":"NodeText","Data":"得荆实、细辛良，恶干姜、苦参。今处处有之，人乃言是大荠子，俗用甚稀。"}]},{"ID":"20240616113143-36frnv9","Type":"NodeParagraph","Properties":{"id":"20240616113143-36frnv9","updated":"20240616113143"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《尔雅》云∶是大荠，然验其味甘而不辛也。"}]},{"ID":"20240616113317-x3zoicl","Type":"NodeThematicBreak","Properties":{"id":"20240616113317-x3zoicl"}},{"ID":"20240616113318-ltkv74i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616113318-ltkv74i","updated":"20240616113323"},"Children":[{"Type":"NodeText","Data":"菥子《医学入门》"}]},{"ID":"20240616113318-5yub0k1","Type":"NodeParagraph","Properties":{"id":"20240616113318-5yub0k1","updated":"20240616113318"},"Children":[{"Type":"NodeText","Data":"味辛，微温。无毒。除风痹，治热胀痛泪出，为末点四十夜，当有热泪及恶物出，去 肉。兼治心腹痛，肝家积聚。实叶皆似芥，俗呼为老疥，处处有之。五月采阴干。恶干姜、苦参。得细辛、荆芥良。"}]},{"ID":"20240616113305-f6is465","Type":"NodeThematicBreak","Properties":{"id":"20240616113305-f6is465"}},{"ID":"20240616113306-3cb8gu8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616113306-3cb8gu8","updated":"20240616113312"},"Children":[{"Type":"NodeText","Data":"菥子《本经逢原》"}]},{"ID":"20240616113306-ytd1bi9","Type":"NodeParagraph","Properties":{"id":"20240616113306-ytd1bi9","updated":"20240616113306"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荠菜"}]},{"ID":"20240616113306-sktpl3g","Type":"NodeParagraph","Properties":{"id":"20240616113306-sktpl3g","updated":"20240616113306"},"Children":[{"Type":"NodeText","Data":"辛微温，无毒。"}]},{"ID":"20240616113306-vtup13k","Type":"NodeParagraph","Properties":{"id":"20240616113306-vtup13k","updated":"20240616113306"},"Children":[{"Type":"NodeText","Data":"《本经》明目治目痛泪出，除痹，补五脏，益精光。"}]},{"ID":"20240616113306-r72j769","Type":"NodeParagraph","Properties":{"id":"20240616113306-r72j769","updated":"20240616113306"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"菥 即荠之大而有毛者，与荠之性不甚相远。其子专于明目，《千金》治目暗去翳方用之，亦治目中 肉，捣筛为末，夜夜点之，久久其膜自落。甄权以荠治青盲不见物，补五脏不足，二荠之性总不出《本经》主治也。"}]},{"ID":"20240616113201-5edr9xu","Type":"NodeThematicBreak","Properties":{"id":"20240616113201-5edr9xu"}},{"ID":"20240616113202-i1hqzbn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616113202-i1hqzbn","updated":"20240616113213"},"Children":[{"Type":"NodeText","Data":"菥子《本草图经》"}]},{"ID":"20240616113202-yhiba6z","Type":"NodeParagraph","Properties":{"id":"20240616113202-yhiba6z","updated":"20240616113210"},"Children":[{"Type":"NodeText","Data":"菥子，生咸阳川泽及道旁，今处处有之。《尔雅》云∶菥 ，大荠。"}]},{"ID":"20240616113202-7gw4qun","Type":"NodeParagraph","Properties":{"id":"20240616113202-7gw4qun","updated":"20240616113202"},"Children":[{"Type":"NodeText","Data":"郭璞云∶似荠 ，细叶，俗呼之曰老荠。苏恭亦云∶是大荠。又云∶然菥 味辛，大荠味甘。陈藏器以大荠即是葶苈，非菥 ，菥 大而扁，葶苈细而圆，二物殊也。而《尔雅》自有葶苈，谓之 （音典）"}]},{"ID":"20240616113202-lrrav0g","Type":"NodeParagraph","Properties":{"id":"20240616113202-lrrav0g","updated":"20240616113202"},"Children":[{"Type":"NodeText","Data":"。注云∶实、叶皆似芥，一名狗荠。大抵二物皆荠类，故人多不能细分，乃尔致疑也。四月、五月采，曝干。古今眼目方中多用之。崔元亮《海上方》∶疗眼热痛泪不止，以菥 子一物，捣筛为末。欲卧，以铜箸点眼中，当有热泪及恶物出，并去 肉。可三、四十夜点之，甚佳。"}]},{"ID":"20240616113152-3n7jotu","Type":"NodeThematicBreak","Properties":{"id":"20240616113152-3n7jotu"}},{"ID":"20240616113153-xzbqj8z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616113153-xzbqj8z","updated":"20240616113158"},"Children":[{"Type":"NodeText","Data":"菥子《本草经集注》"}]},{"ID":"20240616113153-55561jl","Type":"NodeParagraph","Properties":{"id":"20240616113153-55561jl","updated":"20240616113153"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主明目，目痛，泪出，除痹，补五脏，益精光。治心腹腰痛。"}]},{"ID":"20240616113153-iink5am","Type":"NodeParagraph","Properties":{"id":"20240616113153-iink5am","updated":"20240616113153"},"Children":[{"Type":"NodeText","Data":"久服轻身，不老。一名 菥，一名大蕺，一名马辛，一名大荠。生咸阳川泽及道傍。四月、五月采，曝干。（得荆实、细辛良，恶干姜、苦参。）"}]},{"ID":"20240616113153-0a5l6li","Type":"NodeParagraph","Properties":{"id":"20240616113153-0a5l6li","updated":"20240616113153"},"Children":[{"Type":"NodeText","Data":"今处处有之，人乃言是大荠子，世用甚稀。"}]},{"ID":"20240616112635-83chk3v","Type":"NodeThematicBreak","Properties":{"id":"20240616112635-83chk3v"}},{"ID":"20240616112636-u47lum7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616112636-u47lum7","updated":"20240616112641"},"Children":[{"Type":"NodeText","Data":"菥《本草纲目》"}]},{"ID":"20240616112636-obi8gzc","Type":"NodeParagraph","Properties":{"id":"20240616112636-obi8gzc","updated":"20240616112636"},"Children":[{"Type":"NodeText","Data":"「释名」大荠、大蕺、马辛。"}]},{"ID":"20240616112636-tu8h9rm","Type":"NodeParagraph","Properties":{"id":"20240616112636-tu8h9rm","updated":"20240616112636"},"Children":[{"Type":"NodeText","Data":"「气味」（苗）甘、平、无毒。（子）辛、微温、无毒。"}]},{"ID":"20240616112636-vxgwue2","Type":"NodeParagraph","Properties":{"id":"20240616112636-vxgwue2","updated":"20240616112636"},"Children":[{"Type":"NodeText","Data":"「主治」和中益气，利肝明目。"}]},{"ID":"20240607112203-njt5yzc","Type":"NodeThematicBreak","Properties":{"id":"20240607112203-njt5yzc"}},{"ID":"20240607112204-su0cvnf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607112204-su0cvnf","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：菥蓂子"}]},{"ID":"20240607112204-y45c3ha","Type":"NodeParagraph","Properties":{"id":"20240607112204-y45c3ha","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607112204-063703l","Type":"NodeParagraph","Properties":{"id":"20240607112204-063703l","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" Xī Mínɡ Zǐ"}]},{"ID":"20240607112204-uxfrgpn","Type":"NodeParagraph","Properties":{"id":"20240607112204-uxfrgpn","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607112204-ru7lzgq","Type":"NodeParagraph","Properties":{"id":"20240607112204-ru7lzgq","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607112204-1b8k64k","Type":"NodeParagraph","Properties":{"id":"20240607112204-1b8k64k","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607112204-lj46bbr","Type":"NodeParagraph","Properties":{"id":"20240607112204-lj46bbr","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 为十字花科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菥蓂"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。5～6月果实成熟时采取全株，打下种子，晒干，扬净。"}]},{"ID":"20240607112204-ichv267","Type":"NodeParagraph","Properties":{"id":"20240607112204-ichv267","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607112204-uyb2b2v","Type":"NodeParagraph","Properties":{"id":"20240607112204-uyb2b2v","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 我国大部分地区均产。"}]},{"ID":"20240607112204-00oqtg9","Type":"NodeParagraph","Properties":{"id":"20240607112204-00oqtg9","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607112204-o5esyxb","Type":"NodeParagraph","Properties":{"id":"20240607112204-o5esyxb","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 植物形态详\"菥蓂\"条。"}]},{"ID":"20240607112204-o0snhvo","Type":"NodeParagraph","Properties":{"id":"20240607112204-o0snhvo","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607112204-k3b0mc3","Type":"NodeParagraph","Properties":{"id":"20240607112204-k3b0mc3","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 干燥种子黑褐色，细小，长约1.5毫米，宽1～1.5毫米，表面有向心隆起的环纹，无毛。以籽粒饱满、黑色、干燥、无灰土杂质者为佳。"}]},{"ID":"20240607112204-yv752gf","Type":"NodeParagraph","Properties":{"id":"20240607112204-yv752gf","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607112204-fe7bzle","Type":"NodeParagraph","Properties":{"id":"20240607112204-fe7bzle","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 含黑芥子甙。又含脂肪油34％，挥发油0.836％，蔗糖1.8％，卵磷脂1.6％。"}]},{"ID":"20240607112204-89hv5wa","Type":"NodeParagraph","Properties":{"id":"20240607112204-89hv5wa","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607112204-qw1krqf","Type":"NodeParagraph","Properties":{"id":"20240607112204-qw1krqf","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 辛，微温。"}]},{"ID":"20240607112204-0li2f0k","Type":"NodeParagraph","Properties":{"id":"20240607112204-0li2f0k","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，微温。\""}]},{"ID":"20240607112204-nlaxvee","Type":"NodeParagraph","Properties":{"id":"20240607112204-nlaxvee","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607112204-fvzsuix","Type":"NodeParagraph","Properties":{"id":"20240607112204-fvzsuix","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607112204-2342yqn","Type":"NodeParagraph","Properties":{"id":"20240607112204-2342yqn","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"得荆实、细辛良。恶干姜、苦参。\""}]},{"ID":"20240607112204-maob23x","Type":"NodeParagraph","Properties":{"id":"20240607112204-maob23x","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"苦参为使。\""}]},{"ID":"20240607112204-kigylji","Type":"NodeParagraph","Properties":{"id":"20240607112204-kigylji","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607112204-s18jkrj","Type":"NodeParagraph","Properties":{"id":"20240607112204-s18jkrj","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 治目赤肿痛流泪。"}]},{"ID":"20240607112204-xfa4i8t","Type":"NodeParagraph","Properties":{"id":"20240607112204-xfa4i8t","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主明目，目痛泪出，除痹，补五脏，益精光。\""}]},{"ID":"20240607112204-jeu6ve4","Type":"NodeParagraph","Properties":{"id":"20240607112204-jeu6ve4","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗心腹腰痛。\""}]},{"ID":"20240607112204-j4qigo0","Type":"NodeParagraph","Properties":{"id":"20240607112204-j4qigo0","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治肝家积聚，眼目赤肿。\""}]},{"ID":"20240607112204-fpa1br6","Type":"NodeParagraph","Properties":{"id":"20240607112204-fpa1br6","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607112204-nvq85yy","Type":"NodeParagraph","Properties":{"id":"20240607112204-nvq85yy","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱。外用：研末点眼。"}]},{"ID":"20240607112204-z56k8e9","Type":"NodeParagraph","Properties":{"id":"20240607112204-z56k8e9","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607112204-9wcrhqw","Type":"NodeParagraph","Properties":{"id":"20240607112204-9wcrhqw","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 治眼热痛，泪不止：菥蓂子，捣筛为末，欲卧，以铜箸点眼中，当有热泪及恶物出，并去胬肉，可三、四十夜点之。（《海上集验方》）"}]},{"ID":"20240607112204-wmx01w2","Type":"NodeParagraph","Properties":{"id":"20240607112204-wmx01w2","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607112204-8kvv7ox","Type":"NodeParagraph","Properties":{"id":"20240607112204-8kvv7ox","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607112204-fq8qosl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607112204-fq8qosl","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"《中华本草》：菥蓂子"}]},{"ID":"20240607112204-kqgp77j","Type":"NodeParagraph","Properties":{"id":"20240607112204-kqgp77j","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607112204-yujijmn","Type":"NodeParagraph","Properties":{"id":"20240607112204-yujijmn","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" Xī Mínɡ Zǐ"}]},{"ID":"20240607112204-bytgec6","Type":"NodeParagraph","Properties":{"id":"20240607112204-bytgec6","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607112204-u42i32v","Type":"NodeParagraph","Properties":{"id":"20240607112204-u42i32v","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" Seed of Boor's Mustard, Seed of Dish Mustard, Seed of Field Pennycress, Seed of Wild Cress"}]},{"ID":"20240607112204-tw5559u","Type":"NodeParagraph","Properties":{"id":"20240607112204-tw5559u","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607112204-f8yiyom","Type":"NodeParagraph","Properties":{"id":"20240607112204-f8yiyom","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240607112204-uc79elt","Type":"NodeParagraph","Properties":{"id":"20240607112204-uc79elt","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607112204-6h1iqvb","Type":"NodeParagraph","Properties":{"id":"20240607112204-6h1iqvb","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 药材基源：为十字花科植物菥蓂Thlaspi arvense L.的种子。"}]},{"ID":"20240607112204-87u2fbz","Type":"NodeParagraph","Properties":{"id":"20240607112204-87u2fbz","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Thlaspi arvense L."}]},{"ID":"20240607112204-gu5gte5","Type":"NodeParagraph","Properties":{"id":"20240607112204-gu5gte5","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月果实成熟时采取全株，打下种子，晒干，扬净。"}]},{"ID":"20240607112204-ca0yn8j","Type":"NodeParagraph","Properties":{"id":"20240607112204-ca0yn8j","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607112204-xifwsp0","Type":"NodeParagraph","Properties":{"id":"20240607112204-xifwsp0","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 生态环境：分布几乎遍及全国。"}]},{"ID":"20240607112204-wzq1ld9","Type":"NodeParagraph","Properties":{"id":"20240607112204-wzq1ld9","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"资源分布：我国大部分地区均有。"}]},{"ID":"20240607112204-zzzu20j","Type":"NodeParagraph","Properties":{"id":"20240607112204-zzzu20j","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607112204-8ctligy","Type":"NodeParagraph","Properties":{"id":"20240607112204-8ctligy","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 菥蓂 一年生草本，高9-60cm，无毛。茎直立，不分技或分枝，具棱。基生叶叶辆长1-3cm；叶片倒卵状长圆形，长3-5cm，宽l-1.5cm，先端圆钝或急尖，基部抱茎，两侧箭形，边缘具疏齿。总状花序顶生；花白色；萼片4，直立，卵形，先端圆钝；花瓣长圆状倒卵形，长2-4mm，先端圆钝或微凹；雄蕊6，分离；雌蕊1，子房2室，柱头头状，近2裂，花柱短或长。短角果近圆形或倒宽卵形，长8-16mm，扁平，周围有宽翅，先端有深凹缺。种子5-10颗，卵形，长约1。5mm，稍扁平，棕褐色，表面有颗粒状环纹。花果期5-7月。"}]},{"ID":"20240607112204-q57mb8o","Type":"NodeParagraph","Properties":{"id":"20240607112204-q57mb8o","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607112204-0x8mkqx","Type":"NodeParagraph","Properties":{"id":"20240607112204-0x8mkqx","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 种扁圆形，长约1.8mm，宽约1.2mm；表面棕黑色，两面各有5-7条突起偏心性环纹，基部尖，并有小凹。种皮薄，无胚乳，子叶直叠。气微，味淡。"}]},{"ID":"20240607112204-g82rx1t","Type":"NodeParagraph","Properties":{"id":"20240607112204-g82rx1t","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607112204-ikxh32u","Type":"NodeParagraph","Properties":{"id":"20240607112204-ikxh32u","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 种子含黑芥子甙（Sinigrin），芥子酶与挥发油，脂肪油，脂肪油中含有二十碳-11-烯酸甲酯（methyl eicos-11-enate）。"}]},{"ID":"20240607112204-86321eg","Type":"NodeParagraph","Properties":{"id":"20240607112204-86321eg","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607112204-duyyf5i","Type":"NodeParagraph","Properties":{"id":"20240607112204-duyyf5i","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 肝；脾；肾经"}]},{"ID":"20240607112204-x0lrc58","Type":"NodeParagraph","Properties":{"id":"20240607112204-x0lrc58","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607112204-sypyyoj","Type":"NodeParagraph","Properties":{"id":"20240607112204-sypyyoj","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 辛；微温"}]},{"ID":"20240607112204-nqww53l","Type":"NodeParagraph","Properties":{"id":"20240607112204-nqww53l","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607112204-u84vff1","Type":"NodeParagraph","Properties":{"id":"20240607112204-u84vff1","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 1.《本草经集注》：得荆实、细辛良。恶干姜、苦参。"}]},{"ID":"20240607112204-xdue7o5","Type":"NodeParagraph","Properties":{"id":"20240607112204-xdue7o5","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：苦参为使。"}]},{"ID":"20240607112204-j0nves3","Type":"NodeParagraph","Properties":{"id":"20240607112204-j0nves3","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607112204-7m8r2n4","Type":"NodeParagraph","Properties":{"id":"20240607112204-7m8r2n4","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 明目；祛风湿。主目赤肿痛；障翳胬肉；迎风流泪；风湿痹痛"}]},{"ID":"20240607112204-b72j8hn","Type":"NodeParagraph","Properties":{"id":"20240607112204-b72j8hn","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607112204-1iqjnbe","Type":"NodeParagraph","Properties":{"id":"20240607112204-1iqjnbe","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，5-15g。"}]},{"ID":"20240607112204-b8wdvub","Type":"NodeParagraph","Properties":{"id":"20240607112204-b8wdvub","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607112204-kpas4ct","Type":"NodeParagraph","Properties":{"id":"20240607112204-kpas4ct","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 治眼热痛，泪不止： 菥蓂子，捣筛为末，欲卧，以铜箸点眼中，当有热泪及恶物出，并去胬肉，可三、四十夜点之。(《海上集验方》)"}]},{"ID":"20240607112204-mo1pd5i","Type":"NodeParagraph","Properties":{"id":"20240607112204-mo1pd5i","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607112204-p89ih5c","Type":"NodeParagraph","Properties":{"id":"20240607112204-p89ih5c","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主明目，目痛泪出，除痹，补五脏，益精光。"}]},{"ID":"20240607112204-1zs58j1","Type":"NodeParagraph","Properties":{"id":"20240607112204-1zs58j1","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗心腹腰痛。"}]},{"ID":"20240607112204-ejv6baa","Type":"NodeParagraph","Properties":{"id":"20240607112204-ejv6baa","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：治肝家积聚，眼目赤肿。"}]},{"ID":"20240607112204-olf2vj3","Type":"NodeParagraph","Properties":{"id":"20240607112204-olf2vj3","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607112204-f4gwyz1","Type":"NodeParagraph","Properties":{"id":"20240607112204-f4gwyz1","updated":"20240607112204"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607112205-0k457kk","Type":"NodeThematicBreak","Properties":{"id":"20240607112205-0k457kk"}},{"ID":"20240616112551-8nc7aoa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616112551-8nc7aoa","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：菥蓂"}]},{"ID":"20240616112551-tuvnreq","Type":"NodeParagraph","Properties":{"id":"20240616112551-tuvnreq","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616112551-ncqa3vh","Type":"NodeParagraph","Properties":{"id":"20240616112551-ncqa3vh","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" Xī Mínɡ"}]},{"ID":"20240616112551-d2fl1fr","Type":"NodeParagraph","Properties":{"id":"20240616112551-d2fl1fr","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616112551-n5u63it","Type":"NodeParagraph","Properties":{"id":"20240616112551-n5u63it","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 败酱草、遏蓝菜"}]},{"ID":"20240616112551-n2gvrer","Type":"NodeParagraph","Properties":{"id":"20240616112551-n2gvrer","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616112551-92p4tc1","Type":"NodeParagraph","Properties":{"id":"20240616112551-92p4tc1","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 十字花科菥蓂属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菥蓂"},{"Type":"NodeText","Data":"Thlaspi arvense L.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"入药。春夏采集全草，晒干；夏秋采果枝，晒干，打下种子。"}]},{"ID":"20240616112551-mmznqur","Type":"NodeParagraph","Properties":{"id":"20240616112551-mmznqur","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616112551-6091au5","Type":"NodeParagraph","Properties":{"id":"20240616112551-6091au5","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 全草：苦、甘，平。"}]},{"ID":"20240616112551-28liug7","Type":"NodeParagraph","Properties":{"id":"20240616112551-28liug7","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"种子：辛、苦，微温。"}]},{"ID":"20240616112551-4pbj2k9","Type":"NodeParagraph","Properties":{"id":"20240616112551-4pbj2k9","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616112551-183lkkb","Type":"NodeParagraph","Properties":{"id":"20240616112551-183lkkb","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 全草：清热解毒，利湿消肿，和中开胃。用于阑尾炎，肺脓疡，痈疖肿毒，丹毒，子宫内膜炎，白带，肾炎，肝硬化腹水，小儿消化不良。"}]},{"ID":"20240616112551-7eri437","Type":"NodeParagraph","Properties":{"id":"20240616112551-7eri437","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"种子：祛风除湿，和胃止痛。用于风湿性关节炎，腰痛，急性结膜炎，胃痛，肝炎。"}]},{"ID":"20240616112551-mm0b8ey","Type":"NodeParagraph","Properties":{"id":"20240616112551-mm0b8ey","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616112551-8a3lukc","Type":"NodeParagraph","Properties":{"id":"20240616112551-8a3lukc","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 全草0.3～1两，种子3～4钱。"}]},{"ID":"20240616112551-xxzrnbn","Type":"NodeParagraph","Properties":{"id":"20240616112551-xxzrnbn","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616112551-94ad7ee","Type":"NodeParagraph","Properties":{"id":"20240616112551-94ad7ee","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240616112551-jb1vq9u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616112551-jb1vq9u","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：菥蓂"}]},{"ID":"20240616112551-a5k2uxn","Type":"NodeParagraph","Properties":{"id":"20240616112551-a5k2uxn","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616112551-chwymju","Type":"NodeParagraph","Properties":{"id":"20240616112551-chwymju","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" Xī Mínɡ"}]},{"ID":"20240616112551-imtsosi","Type":"NodeParagraph","Properties":{"id":"20240616112551-imtsosi","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616112551-10hb2d7","Type":"NodeParagraph","Properties":{"id":"20240616112551-10hb2d7","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 大荠（《尔雅》），蔑菥、大蕺、马辛（《本经》），析目、荣目、马驹（《吴普本草》），老荠（《尔雅》郭璞注），遏蓝菜（《救荒本草》），花叶荠、水荠（《植物名实图考》），老鼓草（《中国药植志》），瓜子草（《中药志》），洋辣罐（《辽宁经济植物志》），苏败酱、败酱草。"}]},{"ID":"20240616112551-am64nxs","Type":"NodeParagraph","Properties":{"id":"20240616112551-am64nxs","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240616112551-uh99dgh","Type":"NodeParagraph","Properties":{"id":"20240616112551-uh99dgh","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240616112551-ayh7pvr","Type":"NodeParagraph","Properties":{"id":"20240616112551-ayh7pvr","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616112551-yu8kkdw","Type":"NodeParagraph","Properties":{"id":"20240616112551-yu8kkdw","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 为十字花科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菥蓂"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。5～6月间果实成熟时采收，晒干。"}]},{"ID":"20240616112551-k4fycuq","Type":"NodeParagraph","Properties":{"id":"20240616112551-k4fycuq","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240616112551-6bfozu3","Type":"NodeParagraph","Properties":{"id":"20240616112551-6bfozu3","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 生于山坡、草地、路旁或田畔。我国大部分地区均有分布。产江苏、浙江、湖南等地。"}]},{"ID":"20240616112551-jvf0yi0","Type":"NodeParagraph","Properties":{"id":"20240616112551-jvf0yi0","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616112551-2fqaw81","Type":"NodeParagraph","Properties":{"id":"20240616112551-2fqaw81","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高20～40厘米，全体光滑无毛。茎直立，圆柱形，有分枝，表面粉绿色。单叶互生；根生叶有短柄，茎生叶无柄，基部抱茎；叶片椭圆形、倒卵形或披针形，长2.5～5厘米，宽1～2厘米，先端尖，基部箭形，边缘具稀疏浅齿或粗齿，两面粉绿色，中脉在背面隆起，侧脉不明显。总状花序腋生及顶生，长10～20厘米：花萼4片，卵形，长2～2.5毫米，宽1.5毫米，绿色，边缘白色膜质；花瓣4片，十字形排列，倒卵圆形，长约3.5毫米，宽1毫米，先端圆钝，基部渐狭，白色；雄蕊6，4强，花药卵形，背着，2室，纵裂，花丝粗壮；雌蕊1，子房卵圆形而扁，先端微凹，绿色，2室。短角果扁平，卵圆状，长8～13毫米，宽6～10毫米，具宽翅，先端深裂，熟时淡黄色，沿中央顶端向下开裂。种子小，卵圆形而扁。花期4～7月。果期5～8月。"}]},{"ID":"20240616112551-mz7766y","Type":"NodeParagraph","Properties":{"id":"20240616112551-mz7766y","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"本植物的种子（菥蓂子）亦供药用，另详专条。"}]},{"ID":"20240616112551-xt5o69t","Type":"NodeParagraph","Properties":{"id":"20240616112551-xt5o69t","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616112551-r8klduo","Type":"NodeParagraph","Properties":{"id":"20240616112551-r8klduo","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 干燥的带果全草，茎呈圆柱形，表面灰黄色；质脆，易断，中央有白色疏松的髓。叶大多碎落。顶端有总状果序，果实扁椭圆形，边缘有翅。"}]},{"ID":"20240616112551-29r8em3","Type":"NodeParagraph","Properties":{"id":"20240616112551-29r8em3","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"部分地区将本品作败酱使用，参见\"败酱\"条。"}]},{"ID":"20240616112551-u5gsfht","Type":"NodeParagraph","Properties":{"id":"20240616112551-u5gsfht","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616112551-mp2qb9l","Type":"NodeParagraph","Properties":{"id":"20240616112551-mp2qb9l","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 全草含黑芥子甙，经酶作用后产生芥子油。"}]},{"ID":"20240616112551-giqp2a9","Type":"NodeParagraph","Properties":{"id":"20240616112551-giqp2a9","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240616112551-f1kv4nz","Type":"NodeParagraph","Properties":{"id":"20240616112551-f1kv4nz","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 黑芥子甙本身无刺激性，一旦水解成芥子油后，刺激性很强，有杀菌作用。亦可用于痛风，以增加尿酸排泄。"}]},{"ID":"20240616112551-10767ap","Type":"NodeParagraph","Properties":{"id":"20240616112551-10767ap","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616112551-ovcetfz","Type":"NodeParagraph","Properties":{"id":"20240616112551-ovcetfz","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240616112551-lm2eb7y","Type":"NodeParagraph","Properties":{"id":"20240616112551-lm2eb7y","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"甘，平，无毒。\""}]},{"ID":"20240616112551-jwtlega","Type":"NodeParagraph","Properties":{"id":"20240616112551-jwtlega","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"②《福建中草药》：\"微苦，平。\""}]},{"ID":"20240616112551-ywdhg84","Type":"NodeParagraph","Properties":{"id":"20240616112551-ywdhg84","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616112551-qrvyc11","Type":"NodeParagraph","Properties":{"id":"20240616112551-qrvyc11","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 治肾炎，子宫内膜炎。"}]},{"ID":"20240616112551-bez7myv","Type":"NodeParagraph","Properties":{"id":"20240616112551-bez7myv","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"《纲目》：\"和中益气，利肝明目。\""}]},{"ID":"20240616112551-4ye5mm3","Type":"NodeParagraph","Properties":{"id":"20240616112551-4ye5mm3","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616112551-6itop86","Type":"NodeParagraph","Properties":{"id":"20240616112551-6itop86","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1两。"}]},{"ID":"20240616112551-drz4g1f","Type":"NodeParagraph","Properties":{"id":"20240616112551-drz4g1f","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240616112551-wfcwyvr","Type":"NodeParagraph","Properties":{"id":"20240616112551-wfcwyvr","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" ①治肾炎：菥蓂鲜全草一至二两。水煎服。（《福建中草药》）"}]},{"ID":"20240616112551-s60luyo","Type":"NodeParagraph","Properties":{"id":"20240616112551-s60luyo","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"②治产后子宫内膜炎：菥蓂干全草五钱。水煎，调红糖服。（《福建中草药》）"}]},{"ID":"20240616112551-9rfqxnn","Type":"NodeParagraph","Properties":{"id":"20240616112551-9rfqxnn","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616112551-eqlfcux","Type":"NodeParagraph","Properties":{"id":"20240616112551-eqlfcux","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240616112551-9y1gjpa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616112551-9y1gjpa","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"《中华本草》：菥蓂"}]},{"ID":"20240616112551-6eutroc","Type":"NodeParagraph","Properties":{"id":"20240616112551-6eutroc","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616112551-rfao3y7","Type":"NodeParagraph","Properties":{"id":"20240616112551-rfao3y7","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" Xī Mínɡ"}]},{"ID":"20240616112551-nle50ds","Type":"NodeParagraph","Properties":{"id":"20240616112551-nle50ds","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616112551-5f06stx","Type":"NodeParagraph","Properties":{"id":"20240616112551-5f06stx","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 大荠、蔑菥、大蕺、马辛、析目、荣目、马驹、老荠、郭璞注、遏蓝菜、花叶荠、水荠、老鼓草、瓜子草、苏败酱。"}]},{"ID":"20240616112551-xl2c8vb","Type":"NodeParagraph","Properties":{"id":"20240616112551-xl2c8vb","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240616112551-n1wsg11","Type":"NodeParagraph","Properties":{"id":"20240616112551-n1wsg11","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" Boor's Mustard Herb"}]},{"ID":"20240616112551-ytectjp","Type":"NodeParagraph","Properties":{"id":"20240616112551-ytectjp","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240616112551-vg7c6jt","Type":"NodeParagraph","Properties":{"id":"20240616112551-vg7c6jt","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240616112551-3t3x1pq","Type":"NodeParagraph","Properties":{"id":"20240616112551-3t3x1pq","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616112551-57oajmc","Type":"NodeParagraph","Properties":{"id":"20240616112551-57oajmc","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 药材基源：为十字花科植物菥蓂的全草。"}]},{"ID":"20240616112551-yr1pmma","Type":"NodeParagraph","Properties":{"id":"20240616112551-yr1pmma","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Thlaspi arvense L."}]},{"ID":"20240616112551-1bekfdz","Type":"NodeParagraph","Properties":{"id":"20240616112551-1bekfdz","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月间果实成熟时采收，晒干。"}]},{"ID":"20240616112551-tzt1gjr","Type":"NodeParagraph","Properties":{"id":"20240616112551-tzt1gjr","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240616112551-rfkbmd2","Type":"NodeParagraph","Properties":{"id":"20240616112551-rfkbmd2","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于平地路旁、沟边或村落附近。"}]},{"ID":"20240616112551-jzfpafb","Type":"NodeParagraph","Properties":{"id":"20240616112551-jzfpafb","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"资源分布：分布几乎遍及全国。"}]},{"ID":"20240616112551-2ioepus","Type":"NodeParagraph","Properties":{"id":"20240616112551-2ioepus","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616112551-0czuzec","Type":"NodeParagraph","Properties":{"id":"20240616112551-0czuzec","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 菥蓂 一年生草本，高9-60cm，无毛。茎直立，不分技或分枝，具棱。基生叶叶辆长1-3cm；叶片倒卵状长圆形，长3-5cm，宽l-1.5cm，先端圆钝或急尖，基部抱茎，两侧箭形，边缘具疏齿。总状花序顶生；花白色；萼片4，直立，卵形，先端圆钝；花瓣长圆状倒卵形，长2-4mm，先端圆钝或微凹；雄蕊6，分离；雌蕊1，子房2室，柱头头状，近2裂，花柱短或长。短角果近圆形或倒宽卵形，长8-16mm，扁平，周围有宽翅，先端有深凹缺。种子5-10颗，卵形，长约1。5mm，稍扁平，棕褐色，表面有颗粒状环纹。花果期5-7月。"}]},{"ID":"20240616112551-p16vpbg","Type":"NodeParagraph","Properties":{"id":"20240616112551-p16vpbg","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616112551-pimqn8f","Type":"NodeParagraph","Properties":{"id":"20240616112551-pimqn8f","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 全草长15-55cm。根细长圆锥形；表面灰黄色；质硬脆，易折断，折断面不平坦。茎圆柱形，直径l-5mm；表面灰黄色或灰绿色，有细纵棱；质脆易折断，折断面中央有白色疏松的髓。叶多碎落。总状花序生于整枝顶端及叶腋。短角果卵圆形而扁平，长0.8-1.5cm，宽0.5-1.3cm；表面灰黄色或灰绿色，中央略隆起，边缘有宽翅，宽1.5-3mm，两面中央各有1纵棱线，先端凹陷，基都有细果柄，长约1cm；假隔膜纵分成2室，每室有种子5-7粒，果实开裂后，留下一纺锤形的白色膜状中隔。气微，味淡。以果实完整、色黄绿者为佳。"}]},{"ID":"20240616112551-i6p1ufe","Type":"NodeParagraph","Properties":{"id":"20240616112551-i6p1ufe","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：表皮为1列类方形薄壁细胞，外平周壁增厚，棱背处尤厚。皮层为5-10余列薄壁细胞。中柱鞘纤维浅黄色，数个至十数个成群，壁微木化或非木化。韧皮部狭窄，木质部导管多角形，直径10-55μm，浅黄色，常数个成群。维管束间为浅黄色的木化纤维所充满，宽10-25列细胞。髓部宽阔，周围5-10列细胞壁稍厚，木化，具圆形或长形单纹孔。"}]},{"ID":"20240616112551-3g427l0","Type":"NodeParagraph","Properties":{"id":"20240616112551-3g427l0","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616112551-v4yhd8q","Type":"NodeParagraph","Properties":{"id":"20240616112551-v4yhd8q","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 全草含芥子油甙（glucosinolate），内有黑芥子甙（sinigrin）。"}]},{"ID":"20240616112551-orw697q","Type":"NodeParagraph","Properties":{"id":"20240616112551-orw697q","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240616112551-8f10r3k","Type":"NodeParagraph","Properties":{"id":"20240616112551-8f10r3k","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 黑芥子甙本身无刺激性，一旦水解成芥子油后，刺激性很强，有杀菌作用。亦可用于痛风，以增加尿酸排泄。"}]},{"ID":"20240616112551-pj3bfwn","Type":"NodeParagraph","Properties":{"id":"20240616112551-pj3bfwn","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240616112551-q8xbdt5","Type":"NodeParagraph","Properties":{"id":"20240616112551-q8xbdt5","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品果枝粉末1g，加石油醚（沸程30-60℃）5ml，冷渍24h，滤过。滤渣挥尽溶剂，加甲醇5ml，于70℃水溶中回流30min，趁热过滤。取滤液1-2滴于表面皿上，滴加3％碘一重氧化销试液（重氮化钠0.3g，溶解于01mol/L的碘试液10ml中即得）1-2滴，混匀，即有细小的气泡产生。（检查芥子甙）"}]},{"ID":"20240616112551-5tru23g","Type":"NodeParagraph","Properties":{"id":"20240616112551-5tru23g","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616112551-wohatnj","Type":"NodeParagraph","Properties":{"id":"20240616112551-wohatnj","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240616112551-gqqzafi","Type":"NodeParagraph","Properties":{"id":"20240616112551-gqqzafi","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616112551-nwpuh29","Type":"NodeParagraph","Properties":{"id":"20240616112551-nwpuh29","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 苦；甘；微寒"}]},{"ID":"20240616112551-vay9tqt","Type":"NodeParagraph","Properties":{"id":"20240616112551-vay9tqt","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616112551-s58jzew","Type":"NodeParagraph","Properties":{"id":"20240616112551-s58jzew","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 清热解毒，利水消肿。主目赤肿痛；肺痈；肠痈；泄泻；痢疾；白带；产后瘀血腹痛；消化不良；肾炎水肿；肝硬化腹水；痈疮肿毒"}]},{"ID":"20240616112551-imez7ju","Type":"NodeParagraph","Properties":{"id":"20240616112551-imez7ju","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616112551-h62oozt","Type":"NodeParagraph","Properties":{"id":"20240616112551-h62oozt","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-30g，鲜品加倍，鲜品加倍。"}]},{"ID":"20240616112551-zdcbfuc","Type":"NodeParagraph","Properties":{"id":"20240616112551-zdcbfuc","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240616112551-e0x5arr","Type":"NodeParagraph","Properties":{"id":"20240616112551-e0x5arr","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" ①治肾炎： 菥蓂鲜全草一至二两。水煎服。(《福建中草药》)②治产后子宫内膜炎： 菥蓂干全草五钱。水煎，调红糖服。 (《福建中草药》)"}]},{"ID":"20240616112551-qs9skqv","Type":"NodeParagraph","Properties":{"id":"20240616112551-qs9skqv","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240616112551-zickun9","Type":"NodeParagraph","Properties":{"id":"20240616112551-zickun9","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 《纲目》：和中益气，利肝明目。"}]},{"ID":"20240616112551-tubo222","Type":"NodeParagraph","Properties":{"id":"20240616112551-tubo222","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616112551-dzbe9nk","Type":"NodeParagraph","Properties":{"id":"20240616112551-dzbe9nk","updated":"20240616112551"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240616112553-80at0ge","Type":"NodeThematicBreak","Properties":{"id":"20240616112553-80at0ge"}},{"ID":"20240616112554-pai6rp7","Type":"NodeParagraph","Properties":{"id":"20240616112554-pai6rp7"}}]}