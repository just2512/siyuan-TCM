dated":"20240807130716"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 487px;","style":"width: 477px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240807130241-jj0me70.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 477px;\" parent-style=\"width: 487px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 603px;","style":"width: 593px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蔷薇 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蔷薇 5-20240807130716-0nxuo4g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 593px;\" parent-style=\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807115809-6m66x4r","Type":"NodeParagraph","Properties":{"id":"20240807115809-6m66x4r","updated":"20240807125521"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为野蔷薇的种子；"}]},{"ID":"20240616135831-gededb5","Type":"NodeThematicBreak","Properties":{"id":"20240616135831-gededb5"}},{"ID":"20240616135843-o3we29t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135843-o3we29t","updated":"20240616135847"},"Children":[{"Type":"NodeText","Data":"营实《神农本草经》"}]},{"ID":"20240616135843-lbq3stq","Type":"NodeParagraph","Properties":{"id":"20240616135843-lbq3stq","updated":"20240616135843"},"Children":[{"Type":"NodeText","Data":"味酸温。"}]},{"ID":"20240616135843-75udqxs","Type":"NodeParagraph","Properties":{"id":"20240616135843-75udqxs","updated":"20240616135843"},"Children":[{"Type":"NodeText","Data":"主痈疽恶创，结肉，跌筋，败创，热气，阴蚀不疗，利关节。一名墙薇，一名墙麻，一名牛棘。生川谷。"}]},{"ID":"20240616135843-46l8bf7","Type":"NodeParagraph","Properties":{"id":"20240616135843-46l8bf7","updated":"20240616135843"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：蔷薇，一名牛勒，一名牛膝，一名蔷薇，一名山枣（《御览》）。"}]},{"ID":"20240616135843-ny88pfp","Type":"NodeParagraph","Properties":{"id":"20240616135843-ny88pfp","updated":"20240616135843"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名牛勒，一名蔷蘼，一名山棘，生零陵及蜀郡，八月九月采，阴干。"}]},{"ID":"20240616135843-k1157pm","Type":"NodeParagraph","Properties":{"id":"20240616135843-k1157pm","updated":"20240616135843"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：即是墙薇子。"}]},{"ID":"20240616135920-24dfmkh","Type":"NodeThematicBreak","Properties":{"id":"20240616135920-24dfmkh"}},{"ID":"20240616135922-k6zyt7i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135922-k6zyt7i","updated":"20240616135926"},"Children":[{"Type":"NodeText","Data":"营实《新修本草》"}]},{"ID":"20240616135922-2wjbiv8","Type":"NodeParagraph","Properties":{"id":"20240616135922-2wjbiv8","updated":"20240616135922"},"Children":[{"Type":"NodeText","Data":"味酸，温、微寒，无毒。主痈疽，恶疮，结肉，跌筋，败疮，热气，阴蚀不瘳，利关节。"}]},{"ID":"20240616135922-7e3bscm","Type":"NodeParagraph","Properties":{"id":"20240616135922-7e3bscm","updated":"20240616135922"},"Children":[{"Type":"NodeText","Data":"久服轻身益气。根，止泄利腹痛，五脏客热，除邪逆气，疽癞，诸恶疮，金疮伤挞，生肉复肌。一名蔷薇，一名蔷麻，一名牛棘，一名牛勒，一名蔷蘼，一名山棘。生零陵川谷及蜀郡。八月、九月采，阴干。"}]},{"ID":"20240616135922-p4r1170","Type":"NodeParagraph","Properties":{"id":"20240616135922-p4r1170","updated":"20240616135922"},"Children":[{"Type":"NodeText","Data":"营实即是蔷薇子，以白花者为良。根亦可煮酿酒，茎、叶亦可煮作饮。"}]},{"ID":"20240616135911-9nrefkb","Type":"NodeThematicBreak","Properties":{"id":"20240616135911-9nrefkb"}},{"ID":"20240616135912-orp4ta6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135912-orp4ta6","updated":"20240616135916"},"Children":[{"Type":"NodeText","Data":"营实《得配本草》"}]},{"ID":"20240616135912-ror05s9","Type":"NodeParagraph","Properties":{"id":"20240616135912-ror05s9","updated":"20240616135912"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即蔷薇子"}]},{"ID":"20240616135912-4d6b9cm","Type":"NodeParagraph","Properties":{"id":"20240616135912-4d6b9cm","updated":"20240616135912"},"Children":[{"Type":"NodeText","Data":"酸，微寒。入阳明经，治上焦有热好瞑，疗疮疽，利关节。佐枸杞子、地肤子，治眼热昏暗。"}]},{"ID":"20240616135853-irckj8a","Type":"NodeThematicBreak","Properties":{"id":"20240616135853-irckj8a"}},{"ID":"20240616135854-8516cdc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135854-8516cdc","updated":"20240616135859"},"Children":[{"Type":"NodeText","Data":"营实《名医别录》"}]},{"ID":"20240616135854-matag5c","Type":"NodeParagraph","Properties":{"id":"20240616135854-matag5c","updated":"20240616135854"},"Children":[{"Type":"NodeText","Data":"微寒，无毒．久服轻身益气．根，止泄利腹痛，五脏客热，除邪逆气，疽癞，诸恶疮金疮，伤挞，生肉复肌．一名牛勒，一名蔷蘼，一名山棘．生零陵及蜀郡．八月、九月采阴干．"}]},{"ID":"20240616135854-7ipjfr2","Type":"NodeParagraph","Properties":{"id":"20240616135854-7ipjfr2","updated":"20240616135904"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶营实，味酸，温．主痈疽恶疮，结肉跌筋，败疮热气，阴蚀不瘳，利关节．一名墙薇，一名墙麻，一名牛棘。生川谷。"}]},{"ID":"20240616135831-fjtuzxn","Type":"NodeThematicBreak","Properties":{"id":"20240616135831-fjtuzxn"}},{"ID":"20240616135832-31s70l1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135832-31s70l1","updated":"20240616135837"},"Children":[{"Type":"NodeText","Data":"营实《医学入门》"}]},{"ID":"20240616135832-dfe7h0k","Type":"NodeParagraph","Properties":{"id":"20240616135832-dfe7h0k","updated":"20240616135832"},"Children":[{"Type":"NodeText","Data":"营实酸平即蔷薇，疗诸痈毒恶疮痍，根治金疮伤挞肉，血痢肠风疳瘦儿。"}]},{"ID":"20240616135832-nn7b0h2","Type":"NodeParagraph","Properties":{"id":"20240616135832-nn7b0h2","updated":"20240616135832"},"Children":[{"Type":"NodeText","Data":"即蔷薇子。白花者良，无毒。主痈疽发背，恶疮，疮疖溃烂疼痛，结肉趺筋，败疮热气，阴蚀不瘳，头疡白秃。利关节，久服益气轻身。根，味苦、涩，冷，无毒。主热毒风、痈疽、恶癞、疥癣、金疮伤挞，生肉复肌，及口舌生疮，箭镞鲠刺不出，牙齿疼痛。又治五脏客热，除邪逆气，通血脉，止赤白痢，肠风下血，小儿疳虫，腹痛疳痢。八九月采，去根，粗布拭去黄毛，细锉，浆水拌蒸一宿，晒干用。"}]},{"ID":"20240607124547-v1ufujc","Type":"NodeThematicBreak","Properties":{"id":"20240607124547-v1ufujc"}},{"ID":"20240616135819-d1v26a4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135819-d1v26a4","updated":"20240616135827"},"Children":[{"Type":"NodeText","Data":"营实《证类本草》"}]},{"ID":"20240616135819-kztodyp","Type":"NodeParagraph","Properties":{"id":"20240616135819-kztodyp","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"味酸，温、微寒，无毒。主痈疽，恶疮，结肉，跌筋，败疮，热气，阴蚀不瘳，利关节。"}]},{"ID":"20240616135819-cluepfc","Type":"NodeParagraph","Properties":{"id":"20240616135819-cluepfc","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"久服轻身益气。根止泄痢腹痛，五脏客热，除邪逆气，疽癞，诸恶疮，金疮伤挞，生肉复肌。一名蔷薇，一名蔷麻，一名牛棘，一名牛勒，一名蔷蘼，一名山棘。生零陵川谷及蜀郡。"}]},{"ID":"20240616135819-2ya5q9q","Type":"NodeParagraph","Properties":{"id":"20240616135819-2ya5q9q","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"八月、九月采，阴干。"}]},{"ID":"20240616135819-dh2qlee","Type":"NodeParagraph","Properties":{"id":"20240616135819-dh2qlee","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶营实即是蔷薇子，以白花者为良。根亦可煮酿酒，茎、叶亦可煮作饮。臣禹锡等谨按蜀本图经云∶即蔷薇也。茎间多刺，蔓生，子若杜棠子，其花有百，叶八出、六出，或赤，或白者，今所在有之。葛洪治金创方∶用蔷薇灰末一方寸匕，日三服之。药性论云∶蔷薇，使，味苦。子，治头疮白秃，主五脏客热。日华子云∶白蔷微根，味苦、涩，冷，无毒。治热毒风，痈疽，恶疮，牙齿痛，治邪气，通血经，止赤白痢，肠风泻血，恶疮疥癣，小儿疳虫肚痛。野白者用良。"}]},{"ID":"20240616135819-gdqpu7a","Type":"NodeParagraph","Properties":{"id":"20240616135819-gdqpu7a","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"雷公云∶今蔷薇也。凡采得，去根并用粗布拭黄毛了，用刀于槐砧上细锉，用浆水拌令湿。"}]},{"ID":"20240616135819-qevebz7","Type":"NodeParagraph","Properties":{"id":"20240616135819-qevebz7","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"蒸一宿，至明出，日干用。外台秘要∶治鲠及刺不出。蔷薇根末，水服方寸匕，日三。又方∶治折箭刺入肉，脓囊不出，坚惨及鼠仆。服十日，鲠刺皆穿皮出。又方∶治少小睡中遗尿不自觉。"}]},{"ID":"20240616135819-bdshcd3","Type":"NodeParagraph","Properties":{"id":"20240616135819-bdshcd3","updated":"20240616135819"},"Children":[{"Type":"NodeText","Data":"以根随多少，锉，以酒饮之。千金方∶治口疮久不瘥及胸中并生疮，三年以上不瘥。以根浓煮汁服之，稍稍咽效。冬取根，夏取茎、叶用之。又方∶治壅热，口中及舌生疮烂。锉根浓煮汁，含漱之。冬用根皮，夏用枝叶。又方∶诸痈肿发背及痈疖已溃烂，疼痛。蔷薇壳更炙熨之，即愈。又方∶治小儿疳痢，行数暴多。生蔷薇根洗净切，以适多少浓煎汁，稍稍饮之瘥。肘后方∶治口疮。以根避风打去土，煮浓汁温含，冷易。《圣惠》同。"}]},{"ID":"20240607124422-b042byv","Type":"NodeThematicBreak","Properties":{"id":"20240607124422-b042byv"}},{"ID":"20240616135716-8f3zp5j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616135716-8f3zp5j","updated":"20240616135721"},"Children":[{"Type":"NodeText","Data":"营实《千金翼方》"}]},{"ID":"20240616135716-i4l12rt","Type":"NodeParagraph","Properties":{"id":"20240616135716-i4l12rt","updated":"20240616135716"},"Children":[{"Type":"NodeText","Data":"味酸，温，微寒，无毒。主痈疽，恶疮结肉，跌筋败疮，热气，阴蚀不瘳，利关节。久服轻身益气。根∶止泻痢腹痛，五脏客热，除邪逆气，疽痈诸恶疮，金疮伤挞，生肉复肌。"}]},{"ID":"20240616135716-wbaxw04","Type":"NodeParagraph","Properties":{"id":"20240616135716-wbaxw04","updated":"20240616135716"},"Children":[{"Type":"NodeText","Data":"一名墙薇，一名墙麻，一名牛棘，一名牛勒，一名蔷蘼，一名山棘。生零陵川谷及蜀郡，八月九月采，阴干。"}]},{"ID":"20240607124422-8nv6xo6","Type":"NodeThematicBreak","Properties":{"id":"20240607124422-8nv6xo6"}},{"ID":"20240607124415-34bpl55","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124415-34bpl55","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：营实"}]},{"ID":"20240607124415-1xqgo33","Type":"NodeParagraph","Properties":{"id":"20240607124415-1xqgo33","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124415-g16hkn9","Type":"NodeParagraph","Properties":{"id":"20240607124415-g16hkn9","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" Yínɡ Shí"}]},{"ID":"20240607124415-o8qsns1","Type":"NodeParagraph","Properties":{"id":"20240607124415-o8qsns1","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124415-w2auyhp","Type":"NodeParagraph","Properties":{"id":"20240607124415-w2auyhp","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 蔷薇子（陶弘景），野蔷薇子（《东医宝鉴》），石珊瑚（《纲目拾遗》）。"}]},{"ID":"20240607124415-fx335ms","Type":"NodeParagraph","Properties":{"id":"20240607124415-fx335ms","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607124415-9ygog9p","Type":"NodeParagraph","Properties":{"id":"20240607124415-9ygog9p","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607124415-bmwd7ag","Type":"NodeParagraph","Properties":{"id":"20240607124415-bmwd7ag","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124415-hsjmhj9","Type":"NodeParagraph","Properties":{"id":"20240607124415-hsjmhj9","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多花蔷薇"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。8～9月采收，以半青半红未成熟之果实为佳，采得后阴干，密贮，勿泄气。"}]},{"ID":"20240607124415-h9imhef","Type":"NodeParagraph","Properties":{"id":"20240607124415-h9imhef","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607124415-la9hbk0","Type":"NodeParagraph","Properties":{"id":"20240607124415-la9hbk0","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 植物形态详\"蔷薇花\"条。"}]},{"ID":"20240607124415-mkop3u4","Type":"NodeParagraph","Properties":{"id":"20240607124415-mkop3u4","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607124415-jis671v","Type":"NodeParagraph","Properties":{"id":"20240607124415-jis671v","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 干燥果实呈卵圆形，长约6～8毫米，具果柄，顶端有宿存花托之裂片。果实外皮红褐色，内为肥厚肉质果皮。种子黄褐色，果肉与种子间有白毛，果肉味甜酸。以个大、均匀、肉厚、无杂质者为佳。"}]},{"ID":"20240607124415-gfgfm5d","Type":"NodeParagraph","Properties":{"id":"20240607124415-gfgfm5d","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607124415-9jrjcho","Type":"NodeParagraph","Properties":{"id":"20240607124415-9jrjcho","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 果实含蔷薇甙或芸香甙，脂肪油（内含棕榈酸、硬脂酸、亚油酸，亚麻酸）。果皮含西红柿烃、α-胡萝卜素。"}]},{"ID":"20240607124415-15hj9ad","Type":"NodeParagraph","Properties":{"id":"20240607124415-15hj9ad","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124415-u08s3ax","Type":"NodeParagraph","Properties":{"id":"20240607124415-u08s3ax","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"入阳明经。\""}]},{"ID":"20240607124415-riyla03","Type":"NodeParagraph","Properties":{"id":"20240607124415-riyla03","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124415-5ha2glv","Type":"NodeParagraph","Properties":{"id":"20240607124415-5ha2glv","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 酸，凉。"}]},{"ID":"20240607124415-cgiabtm","Type":"NodeParagraph","Properties":{"id":"20240607124415-cgiabtm","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味酸，温。\""}]},{"ID":"20240607124415-0n48z4r","Type":"NodeParagraph","Properties":{"id":"20240607124415-0n48z4r","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"②《别录》： \"微寒，无毒。\""}]},{"ID":"20240607124415-quk4xsp","Type":"NodeParagraph","Properties":{"id":"20240607124415-quk4xsp","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦。\""}]},{"ID":"20240607124415-5tbv6kb","Type":"NodeParagraph","Properties":{"id":"20240607124415-5tbv6kb","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124415-3nuqh82","Type":"NodeParagraph","Properties":{"id":"20240607124415-3nuqh82","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 利水除热，活血解毒。治水肿，脚气，疮毒痈肿，小便不利，经期腹痛。"}]},{"ID":"20240607124415-hrem20n","Type":"NodeParagraph","Properties":{"id":"20240607124415-hrem20n","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主痈疽，恶疮结肉。跌（趺?）筋败疮，热气、阴蚀不瘳。利关节。\""}]},{"ID":"20240607124415-npywov6","Type":"NodeParagraph","Properties":{"id":"20240607124415-npywov6","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"治头疮白秃，主五脏客热。\""}]},{"ID":"20240607124415-zdm776m","Type":"NodeParagraph","Properties":{"id":"20240607124415-zdm776m","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"治上焦有热好瞑。\""}]},{"ID":"20240607124415-5b6jw89","Type":"NodeParagraph","Properties":{"id":"20240607124415-5b6jw89","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"④《本草汇言》：\"凉血解毒。\""}]},{"ID":"20240607124415-wiwjnkb","Type":"NodeParagraph","Properties":{"id":"20240607124415-wiwjnkb","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"⑤《纲目拾遗》：\"治产后软瘫。\""}]},{"ID":"20240607124415-eru65fd","Type":"NodeParagraph","Properties":{"id":"20240607124415-eru65fd","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"⑥《现代实用中药》：\"除风湿。对于浮种、月经不调、小便不利、脚气肿满、霉疮结痂、癣疮等皮肤病而致肿满喘咳、二便不通，心腹胀闷者用此有效。\""}]},{"ID":"20240607124415-hipn7bl","Type":"NodeParagraph","Properties":{"id":"20240607124415-hipn7bl","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124415-8faft91","Type":"NodeParagraph","Properties":{"id":"20240607124415-8faft91","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；浸酒或入丸、散。外用：捣敷或煎水洗。"}]},{"ID":"20240607124415-zz71fyu","Type":"NodeParagraph","Properties":{"id":"20240607124415-zz71fyu","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607124415-c5cc335","Type":"NodeParagraph","Properties":{"id":"20240607124415-c5cc335","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" ①治壮实体质之肾脏炎，脚气、浮肿：营实（研碎）一钱，苞谷须二钱，接骨木花二钱，薏苡仁二钱，甘草一钱。煎服。（《本草推陈》）"}]},{"ID":"20240607124415-9x4z3vq","Type":"NodeParagraph","Properties":{"id":"20240607124415-9x4z3vq","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"②治血热痈肿及热疹暑毒，流连不已：营实子（炒燥、研）二两，金银花三两。晒干浸酒饮。（《千金方》）"}]},{"ID":"20240607124415-mmd6pwb","Type":"NodeParagraph","Properties":{"id":"20240607124415-mmd6pwb","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"③治眼热目暗：地肤子、枇杷子、营实各一两。上件药捣细罗为散。每服不计时侯，以温洒调下二钱。（《圣惠方》）"}]},{"ID":"20240607124415-nqr30vt","Type":"NodeParagraph","Properties":{"id":"20240607124415-nqr30vt","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"④治月经不调，经期腹痛：鲜蔷薇成熟果实三至四两。煎汁，冲红糖、黄酒服。（江西《草药手册》）"}]},{"ID":"20240607124415-zufqry2","Type":"NodeParagraph","Properties":{"id":"20240607124415-zufqry2","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124415-c0azziw","Type":"NodeParagraph","Properties":{"id":"20240607124415-c0azziw","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607124415-9z8cgrv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124415-9z8cgrv","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"《中华本草》：营实"}]},{"ID":"20240607124415-6eejebc","Type":"NodeParagraph","Properties":{"id":"20240607124415-6eejebc","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124415-836ydmv","Type":"NodeParagraph","Properties":{"id":"20240607124415-836ydmv","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" Yínɡ Shí"}]},{"ID":"20240607124415-v849rjp","Type":"NodeParagraph","Properties":{"id":"20240607124415-v849rjp","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124415-86hwb9k","Type":"NodeParagraph","Properties":{"id":"20240607124415-86hwb9k","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 蔷薇子、野蔷薇子、石珊瑚"}]},{"ID":"20240607124415-fvaze62","Type":"NodeParagraph","Properties":{"id":"20240607124415-fvaze62","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607124415-uukf247","Type":"NodeParagraph","Properties":{"id":"20240607124415-uukf247","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" Fruit of Fewflower Wildrice"}]},{"ID":"20240607124415-on7mfrz","Type":"NodeParagraph","Properties":{"id":"20240607124415-on7mfrz","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607124415-mhku5ib","Type":"NodeParagraph","Properties":{"id":"20240607124415-mhku5ib","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240607124415-jcl3s4u","Type":"NodeParagraph","Properties":{"id":"20240607124415-jcl3s4u","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124415-y0emdt6","Type":"NodeParagraph","Properties":{"id":"20240607124415-y0emdt6","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷微科植物野蔷薇的果实。"}]},{"ID":"20240607124415-9bji800","Type":"NodeParagraph","Properties":{"id":"20240607124415-9bji800","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Rosa multiflora Thunb."}]},{"ID":"20240607124415-g4qvwko","Type":"NodeParagraph","Properties":{"id":"20240607124415-g4qvwko","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收，以半青半红未成熟时为佳，鲜用或晒干。"}]},{"ID":"20240607124415-1c0p80q","Type":"NodeParagraph","Properties":{"id":"20240607124415-1c0p80q","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607124415-30nzq8z","Type":"NodeParagraph","Properties":{"id":"20240607124415-30nzq8z","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于路旁、田边或丘陵地的灌木丛中。"}]},{"ID":"20240607124415-d6bbwy1","Type":"NodeParagraph","Properties":{"id":"20240607124415-d6bbwy1","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于山东、江苏、河南等地。"}]},{"ID":"20240607124415-leds1wd","Type":"NodeParagraph","Properties":{"id":"20240607124415-leds1wd","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607124415-fi2qz58","Type":"NodeParagraph","Properties":{"id":"20240607124415-fi2qz58","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 野蔷薇 攀援灌木，小枝有短、粗稍弯曲皮刺。小叶5-9，近花序的小叶有时3，连叶柄长5-10cm；托叶篦齿状，大部贴生于叶柄；小叶片倒卵形，长圆形或卵形，长1.5-5cm，宽0.8-2.8cm，先端急尖或圆钝，基部近圆形或楔形，边缘有锯齿，上面无毛，下面有柔毛，小叶柄和轴有散生腺毛。花两性；多，朵簇排成圆锥状花序，花直径1.5-2cm；萼片5，披针形，有时中部具2个线形裂片；花瓣5，白色，宽倒卵形，先端微凹，基部楔形；雄蕊多数；花柱结合成束。果实近球形，直径6-8mm，红褐色或紫褐色，有光泽。花期5-6月。果期9-10月。"}]},{"ID":"20240607124415-hzgrv4n","Type":"NodeParagraph","Properties":{"id":"20240607124415-hzgrv4n","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607124415-vrwjym0","Type":"NodeParagraph","Properties":{"id":"20240607124415-vrwjym0","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 本品成卵圆形，长6-8mm，具果柄，顶端有宿存花萼之裂片。果实外皮红褐色，内为肥厚肉质果皮。种子黄褐色，果肉与种子间有白毛，果肉味甜酸。以个大、均匀、肉厚、无杂质者为佳。"}]},{"ID":"20240607124415-mm8whtx","Type":"NodeParagraph","Properties":{"id":"20240607124415-mm8whtx","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607124415-jnf1xc9","Type":"NodeParagraph","Properties":{"id":"20240607124415-jnf1xc9","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 果实含β-谷甾醇(β-sitosterol)，5a-豆甾烷-3，6-二酮(5a-stigmastan-3,6-dione)，蒿属香豆精(scoparone)，水杨酸(salicylic acid)，没食子酸(gallic acid)，槲皮素-3-β-D-吡喃葡萄糖基-（1→4）-a-L-吡喃鼠李糖甙[quercetin-3-β-D-glucopyranosyl-（1→4）-a-L-rhamnopyranoside]，槲皮素-3-β-D-吡喃葡萄糖基-(1→6)-β-D-吡喃葡萄糖基-（1→4）-a-L-吡喃鼠李糖甙[quercetin-3-β-D-glucopyranosyl-(1→6)-β-D-glucopyranosyl-（1→4）-a-L-rhamnopyranoside]，槲皮甙(quercitrin)山柰酚-3-a-L-吡喃鼠李糖甙(kaempferol-3-a-L-rhamnopyranoside)，没食子甲酯(methyl gallate)，种子含蔷薇甙(multiflorin)A、B。野蔷薇甙(multinoside)A、B，野蔷薇甙A乙酸酯(multinoside A acetate)，赤霉素(gibberellin)A/32。"}]},{"ID":"20240607124415-2ms15ul","Type":"NodeParagraph","Properties":{"id":"20240607124415-2ms15ul","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607124415-qg5fsiu","Type":"NodeParagraph","Properties":{"id":"20240607124415-qg5fsiu","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 营实的丁醇提取物小鼠灌胃给药有泻下作用，测得其ED/50为5.6g/kg，已从营实的假果中分离得泻下成分野蔷薇甙A乙酸酯，后者的泻下ED/50为150mg/kg。"}]},{"ID":"20240607124415-s2h8gi8","Type":"NodeParagraph","Properties":{"id":"20240607124415-s2h8gi8","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124415-0avyqlm","Type":"NodeParagraph","Properties":{"id":"20240607124415-0avyqlm","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 肺；脾；肝；膀胱经"}]},{"ID":"20240607124415-0fyc3xn","Type":"NodeParagraph","Properties":{"id":"20240607124415-0fyc3xn","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124415-3k2z2xp","Type":"NodeParagraph","Properties":{"id":"20240607124415-3k2z2xp","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 酸；凉；无毒"}]},{"ID":"20240607124415-um5rxvi","Type":"NodeParagraph","Properties":{"id":"20240607124415-um5rxvi","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124415-exyt69v","Type":"NodeParagraph","Properties":{"id":"20240607124415-exyt69v","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 清热解毒，祛风活血，利水消肿。主疮痈肿毒，风湿痹痛，关节不利，月经不调，水肿，小便不利"}]},{"ID":"20240607124415-lyqr5i4","Type":"NodeParagraph","Properties":{"id":"20240607124415-lyqr5i4","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124415-q1yqu46","Type":"NodeParagraph","Properties":{"id":"20240607124415-q1yqu46","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g，鲜品用量加倍。外用：适量，捣敷。"}]},{"ID":"20240607124415-90fcw0u","Type":"NodeParagraph","Properties":{"id":"20240607124415-90fcw0u","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607124415-x8d60sz","Type":"NodeParagraph","Properties":{"id":"20240607124415-x8d60sz","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" ①治壮实体质之肾炎、脚气、浮肿：营实(研碎)一钱，苞谷须二钱，接骨木花二钱，薏苡仁二钱，甘草一钱。煎服。(《本草推陈》)②治血热痈肿及热疹暑毒，流连不已：营实子(炒燥、研)二两，金银花三两。晒干浸酒饮。(《千金方》)③治眼热目暗：地肤子、批粑子、营实各一两。上件药捣细罗为散。每服不计时候，以温酒调下二钱。(《圣惠方》)④治月经不调，经期腹痛：鲜蔷薇成熟果实三至四两。煎汁，冲红糖、黄酒服。(江西《草药手册》)"}]},{"ID":"20240607124415-4pdv0ly","Type":"NodeParagraph","Properties":{"id":"20240607124415-4pdv0ly","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607124415-6ylu8bv","Type":"NodeParagraph","Properties":{"id":"20240607124415-6ylu8bv","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 1.《木经》：主痈疽，恶疮结肉，跌筋败疮，热气、阴蚀不瘳，利关节。"}]},{"ID":"20240607124415-2gwv4wt","Type":"NodeParagraph","Properties":{"id":"20240607124415-2gwv4wt","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：治头疮白秃，主五脏客热。"}]},{"ID":"20240607124415-3wtm0qm","Type":"NodeParagraph","Properties":{"id":"20240607124415-3wtm0qm","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：治上焦有热好瞑。"}]},{"ID":"20240607124415-5xpm0ca","Type":"NodeParagraph","Properties":{"id":"20240607124415-5xpm0ca","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"4.《本草汇言》：凉血解毒。"}]},{"ID":"20240607124415-74zjb96","Type":"NodeParagraph","Properties":{"id":"20240607124415-74zjb96","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"5.《纲目拾遗》：治产后软瘫。"}]},{"ID":"20240607124415-o92jum1","Type":"NodeParagraph","Properties":{"id":"20240607124415-o92jum1","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"6.《现代实用中药》：除风湿。对于浮肿、月经不调、小便不利、脚气肿满、霉疮结痂、癣疮等皮肤病而致肿满喘咳、二便不通、心腹胀闷者用此有效。"}]},{"ID":"20240607124415-6dbomru","Type":"NodeParagraph","Properties":{"id":"20240607124415-6dbomru","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124415-fo2w2lo","Type":"NodeParagraph","Properties":{"id":"20240607124415-fo2w2lo","updated":"20240607124415"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607124417-qqpgj9y","Type":"NodeThematicBreak","Properties":{"id":"20240607124417-qqpgj9y"}},{"ID":"20240607124418-ggiqkqq","Type":"NodeParagraph","Properties":{"id":"20240607124418-ggiqkqq"}}]}