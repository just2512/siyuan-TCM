Properties":{"id":"20240807095317-h9hol64","updated":"20240807095317"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 794px;","style":"width: 784px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒲黄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒲黄-20240807094627-lw13o79.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 784px;\" parent-style=\"width: 794px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 406px;","style":"width: 396px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水烛香蒲2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水烛香蒲2-20240619115658-v2045hv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 396px;\" parent-style=\"width: 406px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807095317-8n7pbn4","Type":"NodeParagraph","Properties":{"id":"20240807095317-8n7pbn4","updated":"20240807095317"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 648px;","style":"width: 638px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒲黄 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒲黄 1-20240807094745-w5ha7jq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 638px;\" parent-style=\"width: 648px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒲黄 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒲黄 3-20240807094839-so37c10.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807095317-bzw21ck","Type":"NodeParagraph","Properties":{"id":"20240807095317-bzw21ck","updated":"20240807095317"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 410px;","style":"width: 400px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒲黄 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒲黄 2-20240807094821-p8hliy4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 400px;\" parent-style=\"width: 410px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蒲黄 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蒲黄 4-20240807095113-04ntsrx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616134450-wa3530y","Type":"NodeThematicBreak","Properties":{"id":"20240616134450-wa3530y"}},{"ID":"20240616134521-15mj6qh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134521-15mj6qh","updated":"20240616134524"},"Children":[{"Type":"NodeText","Data":"香蒲《神农本草经》"}]},{"ID":"20240616134521-bcuslzv","Type":"NodeParagraph","Properties":{"id":"20240616134521-bcuslzv","updated":"20240616134521"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240616134521-d39hx3m","Type":"NodeParagraph","Properties":{"id":"20240616134521-d39hx3m","updated":"20240616134521"},"Children":[{"Type":"NodeText","Data":"主五脏，心下邪气，口中烂臭，坚齿明目聪耳。久服轻身耐老（《御览》作能老）。一名睢（《御览》云睢蒲）。生池泽。"}]},{"ID":"20240616134521-plqpp21","Type":"NodeParagraph","Properties":{"id":"20240616134521-plqpp21","updated":"20240616134521"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：睢，一名睢石，一名香蒲，神农雷公甘，生南海，池泽中（《御览》）。"}]},{"ID":"20240616134521-e6lkpxp","Type":"NodeParagraph","Properties":{"id":"20240616134521-e6lkpxp","updated":"20240616134521"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名醮，生南海。"}]},{"ID":"20240616134521-1f6fq1i","Type":"NodeParagraph","Properties":{"id":"20240616134521-1f6fq1i","updated":"20240616134521"},"Children":[{"Type":"NodeText","Data":"案《说文》云：菩，草也；玉篇云：菩，香草也，又音蒲；本草图经云：香蒲，蒲黄苗也，春初生嫩叶，未出水时，红白色茸茸然，《周礼》以为菹。"}]},{"ID":"20240616134528-a6i6v3t","Type":"NodeThematicBreak","Properties":{"id":"20240616134528-a6i6v3t"}},{"ID":"20240616134530-yrvigqy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134530-yrvigqy","updated":"20240616134554"},"Children":[{"Type":"NodeText","Data":"香蒲《名医别录》"}]},{"ID":"20240616134530-ryrwdon","Type":"NodeParagraph","Properties":{"id":"20240616134530-ryrwdon","updated":"20240616134530"},"Children":[{"Type":"NodeText","Data":"无毒．一名醮．生南海．"}]},{"ID":"20240616134530-92bl16j","Type":"NodeParagraph","Properties":{"id":"20240616134530-92bl16j","updated":"20240616134537"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶香蒲，味甘，平．主五脏心下邪气，口中烂臭，坚齿明目聪耳．久服轻身耐一名睢。生池泽。"}]},{"ID":"20240616134555-1ocse3c","Type":"NodeThematicBreak","Properties":{"id":"20240616134555-1ocse3c"}},{"ID":"20240616134556-e64p6um","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134556-e64p6um","updated":"20240616134602"},"Children":[{"Type":"NodeText","Data":"香蒲《证类本草》"}]},{"ID":"20240616134556-zouwxz6","Type":"NodeParagraph","Properties":{"id":"20240616134556-zouwxz6","updated":"20240616134556"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主五脏，心下邪气，口中烂臭，坚齿，明目，聪耳。久服轻身，耐老。一名睢（七余切），一名醮。生南海池泽。"}]},{"ID":"20240616134556-oj2vd7f","Type":"NodeParagraph","Properties":{"id":"20240616134556-oj2vd7f","updated":"20240616134556"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方药不复用，俗人无采，彼土人亦不复识者。江南贡菁茅，一名香茅，以供宗庙缩酒。或云是熏草，又云是燕麦，此蒲亦相类尔。唐本注云∶此即甘蒲，作荐者，春初生，用白为菹，亦堪蒸食。山南名此蒲为香蒲，谓菖蒲为臭蒲。陶隐居所引菁茅，乃三脊茅也。"}]},{"ID":"20240616134556-260o0os","Type":"NodeParagraph","Properties":{"id":"20240616134556-260o0os","updated":"20240616134556"},"Children":[{"Type":"NodeText","Data":"其燕麦、熏草、香茅，野俗皆识，都不为类此，并非例也。蒲黄，即此香蒲花是也。"}]},{"ID":"20240616134556-ugf8la4","Type":"NodeParagraph","Properties":{"id":"20240616134556-ugf8la4","updated":"20240616134556"},"Children":[{"Type":"NodeText","Data":"图经曰文具蒲黄条下。"}]},{"ID":"20240616134450-cibbdt9","Type":"NodeThematicBreak","Properties":{"id":"20240616134450-cibbdt9"}},{"ID":"20240616134508-n05fdvm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134508-n05fdvm","updated":"20240616134512"},"Children":[{"Type":"NodeText","Data":"香蒲《千金翼方》"}]},{"ID":"20240616134508-asuurwd","Type":"NodeParagraph","Properties":{"id":"20240616134508-asuurwd","updated":"20240616134508"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主五脏心下邪气，口中烂臭，坚齿明目，聪耳。久服轻身耐老。一名睢，一名醮。生南海池泽。"}]},{"ID":"20240616134450-n45xlqo","Type":"NodeThematicBreak","Properties":{"id":"20240616134450-n45xlqo"}},{"ID":"20240616134459-h507be4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134459-h507be4","updated":"20240616134503"},"Children":[{"Type":"NodeText","Data":"香蒲《神农本草经赞》"}]},{"ID":"20240616134459-kjtjsz3","Type":"NodeParagraph","Properties":{"id":"20240616134459-kjtjsz3","updated":"20240616134459"},"Children":[{"Type":"NodeText","Data":"味甘平。主五脏心下邪气。口中烂臭。坚齿明目聪耳。久服轻身耐老。一名睢。生池泽。"}]},{"ID":"20240616134459-t7d2t7a","Type":"NodeParagraph","Properties":{"id":"20240616134459-t7d2t7a","updated":"20240616134459"},"Children":[{"Type":"NodeText","Data":"冒水茸茸。丛生春乍。肥茁红浮。脂凝白亚。菡东西。蜻蜓高下。先攻心邪。神奇臭花。"}]},{"ID":"20240616134459-igr1ivb","Type":"NodeParagraph","Properties":{"id":"20240616134459-igr1ivb","updated":"20240616134459"},"Children":[{"Type":"NodeText","Data":"苏颂曰。春初生嫩叶。出水时红白茸茸然。谢诗。闲厕秋菡萏。姚合诗。东西分艳影相连。薛蕙诗。蜻蜓高下逐。荀子。我先攻其邪心。庄子。化臭腐为神奇。"}]},{"ID":"20240616134451-xzlzrut","Type":"NodeThematicBreak","Properties":{"id":"20240616134451-xzlzrut"}},{"ID":"20240616134452-80phv6p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616134452-80phv6p","updated":"20240616134455"},"Children":[{"Type":"NodeText","Data":"香蒲《新修本草》"}]},{"ID":"20240616134452-pme4czd","Type":"NodeParagraph","Properties":{"id":"20240616134452-pme4czd","updated":"20240616134452"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主五脏心下邪气，口中烂臭，坚齿，明目，聪耳。久服轻身，耐老。"}]},{"ID":"20240616134452-gik2jab","Type":"NodeParagraph","Properties":{"id":"20240616134452-gik2jab","updated":"20240616134452"},"Children":[{"Type":"NodeText","Data":"一名睢，一名醮。生南海池泽。"}]},{"ID":"20240616134452-dcp6xo2","Type":"NodeParagraph","Properties":{"id":"20240616134452-dcp6xo2","updated":"20240616134452"},"Children":[{"Type":"NodeText","Data":"方药不复用，俗人无采，彼土人亦不复识者。江南贡菁茅，一名香茅，以供宗庙缩酒。"}]},{"ID":"20240616134452-gwmd9wo","Type":"NodeParagraph","Properties":{"id":"20240616134452-gwmd9wo","updated":"20240616134452"},"Children":[{"Type":"NodeText","Data":"或云是熏草，又云是燕麦，此蒲亦相类耳。"}]},{"ID":"20240616134452-8a9sum0","Type":"NodeParagraph","Properties":{"id":"20240616134452-8a9sum0","updated":"20240616134452"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此即甘蒲，作荐者，春初生，用白为菹，亦堪蒸食。山南名此蒲为香蒲，谓菖蒲为臭蒲。陶隐居所引菁茅，乃三脊茅也。其燕麦、熏黄，即此香蒲花是也。"}]},{"ID":"20240607123609-wrup253","Type":"NodeThematicBreak","Properties":{"id":"20240607123609-wrup253"}},{"ID":"20240607123604-8dmqyb5","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607123604-8dmqyb5","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"香蒲"}]},{"ID":"20240607123604-qr08qfd","Type":"NodeParagraph","Properties":{"id":"20240607123604-qr08qfd","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607123604-qyuwldi","Type":"NodeParagraph","Properties":{"id":"20240607123604-qyuwldi","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" Xiānɡ Pú"}]},{"ID":"20240607123604-on82dgl","Type":"NodeParagraph","Properties":{"id":"20240607123604-on82dgl","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607123604-xm29s4w","Type":"NodeParagraph","Properties":{"id":"20240607123604-xm29s4w","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 蒲（《诗经》），睢、睢蒲（《本经》），醮、醮石（《吴普本草》），甘蒲（《唐本草》），蒲黄草（《经效产宝》），鬼蜡烛（《类证活人书》），水蜡烛（《广东新语》），蒲草、莎草、板枝（汪连仕《采药书》），蒲包草（《纲目拾遗》），随手香（《草木便方》），毛蜡烛（《天宝本草》），金簪草（《现代实用中药》），芦烛、芦油烛（《闽东本草》）。"}]},{"ID":"20240607123604-cv3uc9h","Type":"NodeParagraph","Properties":{"id":"20240607123604-cv3uc9h","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607123604-nd2wejp","Type":"NodeParagraph","Properties":{"id":"20240607123604-nd2wejp","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607123604-iwuwyrf","Type":"NodeParagraph","Properties":{"id":"20240607123604-iwuwyrf","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607123604-nuc03ax","Type":"NodeParagraph","Properties":{"id":"20240607123604-nuc03ax","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 为香蒲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长苞香蒲、狭叶香蒲、宽叶香蒲"},{"Type":"NodeText","Data":"或其同属多种植物的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607123604-0a1wmot","Type":"NodeParagraph","Properties":{"id":"20240607123604-0a1wmot","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607123604-x9mfw10","Type":"NodeParagraph","Properties":{"id":"20240607123604-x9mfw10","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" ①长苞香蒲"}]},{"ID":"20240607123604-kfkiw91","Type":"NodeParagraph","Properties":{"id":"20240607123604-kfkiw91","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"多年生草本，高1.5～3米。根茎横走，有须根。茎直立。叶狭线形，宽7～12毫米，有时宽达15～20毫米，叶鞘圆筒形，半抱茎。花小，单性，雌雄同株，集合成圆柱状肥厚的穗状花序；雌、雄花序离生，雄花序在上部，雌花序在下部，相隔约3厘米；雌、雄花的花被均退化成鳞片状或成茸毛；雄花具雄蕊3，毛长于花药，花粉粒单生；雌花有小苞，匙形，与柱头等长，小苞与花柱均较白毛为长。果穗长短变化很大，通常短于雄花序，长约15厘米，直径15～30毫米，赭褐色。坚果细小，无槽。花期8～9月。果期9～10月。"}]},{"ID":"20240607123604-d5klt3d","Type":"NodeParagraph","Properties":{"id":"20240607123604-d5klt3d","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"生池沼、水边。分布黑龙江、吉林、辽宁、河北、河南、山东、安徽、江苏、浙江、福建、台湾、江西、山西、陕西、内蒙古等地。"}]},{"ID":"20240607123604-424brzp","Type":"NodeParagraph","Properties":{"id":"20240607123604-424brzp","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"②狭叶香蒲"}]},{"ID":"20240607123604-xdr9sb0","Type":"NodeParagraph","Properties":{"id":"20240607123604-xdr9sb0","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"多年生草本，高1.5～3米。根茎匍匐，须根多。叶狭线形，宽5～8毫米，稀10毫米。花小，单性，雌雄同株，穗状花序，长圆柱形，褐色；雌雄花序离生，雄花序在上部，长20～30厘米，雌花序在下部，长9～28厘米，具叶状苞片，早落；雄花具雄蕊2～3枚，基生毛较花药长，顶端单一或2～5分叉，花粉粒单生；雌花具小苞片，匙形，较柱头短，茸毛早落，约与小苞片等长，柱头线形或线状长圆形。果穗直径10～15毫米，坚果细小无槽，不开裂，外果皮不分离。花期6～7月。果期7～8月。"}]},{"ID":"20240607123604-l32ia2m","Type":"NodeParagraph","Properties":{"id":"20240607123604-l32ia2m","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"生浅水中。分布黑龙江、吉林、辽宁、河南、河北、山东、安徽、江苏、浙江、福建、江西、湖北、四川、云南、山西、陕西、内蒙古等地。"}]},{"ID":"20240607123604-prj5j4n","Type":"NodeParagraph","Properties":{"id":"20240607123604-prj5j4n","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"③宽叶香蒲"}]},{"ID":"20240607123604-4cdbbsz","Type":"NodeParagraph","Properties":{"id":"20240607123604-4cdbbsz","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"多年生草本，高1～2.5米。根茎粗壮，横走。叶阔线形，长约1米，宽10～15毫米，先端长尖，基部鞘状，抱茎。花单性，雌雄同株，穗状花序圆柱形；雌雄花序紧相连接，雄花序在上，长8～15厘米，或稍短，成熟时直径1.5～2厘米；雌花序长约10厘米，直径约1.5厘米，具2～3片叶状苞片，早落；雄花具雄蕊3～4枚，花丝丝状，基生白毛较花药短，有时顶端分叉，花粉黄色，花粉粒集为4合体；雌花基部无小苞，具子房柄，基部的毛常较柱头稍短。果穗粗，直径约2厘米，坚果细小有槽，常于水中开裂，外种皮分离。花期7～8月。果期9月。"}]},{"ID":"20240607123604-pu4ts2o","Type":"NodeParagraph","Properties":{"id":"20240607123604-pu4ts2o","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"生河流两岸、池沼等地水边，以及沙漠地区的浅水滩中。分布黑龙江、辽宁、吉林、河北、河南、山西、陕西、内蒙古等地。"}]},{"ID":"20240607123604-7ti7lv4","Type":"NodeParagraph","Properties":{"id":"20240607123604-7ti7lv4","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"以上几种植物的带有部分嫩茎的根茎（蒲蒻）、花粉（蒲黄）、果穗（蒲棒）亦供药用，各详专条。"}]},{"ID":"20240607123604-zidnyk9","Type":"NodeParagraph","Properties":{"id":"20240607123604-zidnyk9","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607123604-legvzzy","Type":"NodeParagraph","Properties":{"id":"20240607123604-legvzzy","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 宽叶香蒲全草含多量维生索B1、B2和C。含钙量极低。"}]},{"ID":"20240607123604-kf2nja3","Type":"NodeParagraph","Properties":{"id":"20240607123604-kf2nja3","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607123604-p01bcgg","Type":"NodeParagraph","Properties":{"id":"20240607123604-p01bcgg","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 治小便不利，乳痈。"}]},{"ID":"20240607123604-qivhgfi","Type":"NodeParagraph","Properties":{"id":"20240607123604-qivhgfi","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"《本草汇言》：\"润燥凉血，去脾胃伏火。\""}]},{"ID":"20240607123604-rundn2l","Type":"NodeParagraph","Properties":{"id":"20240607123604-rundn2l","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607123604-5qzn1sw","Type":"NodeParagraph","Properties":{"id":"20240607123604-5qzn1sw","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；研末或烧灰入丸、散。外用：捣敷。"}]},{"ID":"20240607123604-g13ojcw","Type":"NodeParagraph","Properties":{"id":"20240607123604-g13ojcw","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607123604-iw44tdn","Type":"NodeParagraph","Properties":{"id":"20240607123604-iw44tdn","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" ①治小便不利：蒲灰七分，滑石三分。上二味杵为散。饮服方寸匕，日三服。（《金匮要略》蒲灰散）"}]},{"ID":"20240607123604-w9v4g32","Type":"NodeParagraph","Properties":{"id":"20240607123604-w9v4g32","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"②治关格上下不通，膈中觉有所碍，欲升不升，欲降不降，升降不行，饮食不下，大便不出：真香蒲末一两，半夏曲六钱，川贝母五钱，苏子四钱，茯苓三钱，白术二钱，枳实、沉香各一钱。俱为极细末，炼蜜丸，如黍米大。每空心服二钱，豆腐浆送下。（《本草汇言》）"}]},{"ID":"20240607123604-ltkwgso","Type":"NodeParagraph","Properties":{"id":"20240607123604-ltkwgso","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"③治产后妒乳并痈：蒲黄草，熟捣，敷肿上，日三度易之，并叶煎汁饮之亦佳，食之亦得。（《经效产宝》）"}]},{"ID":"20240607123604-nyrae6b","Type":"NodeParagraph","Properties":{"id":"20240607123604-nyrae6b","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607123604-y92eje2","Type":"NodeParagraph","Properties":{"id":"20240607123604-y92eje2","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 除上述品种外，尚有下列同属植物的全草亦同等入药："}]},{"ID":"20240607123604-9dw5pi6","Type":"NodeParagraph","Properties":{"id":"20240607123604-9dw5pi6","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"①线叶香蒲，雌雄花序不相连接，雄花序较雌花序为长；叶宽2～3毫米，叶鞘达茎中部以上。"}]},{"ID":"20240607123604-v998ois","Type":"NodeParagraph","Properties":{"id":"20240607123604-v998ois","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"②小香蒲，雌雄花序不连接，中间相距0.5～3厘米，雌花序长3～3.5厘米；叶宽2～3毫米，叶鞘多近茎基部。"}]},{"ID":"20240607123604-r8kjnxn","Type":"NodeParagraph","Properties":{"id":"20240607123604-r8kjnxn","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"③东方香蒲，雌雄花序紧相连接；叶狭长线形，宽6～8毫米。"}]},{"ID":"20240607123604-o8mb7h6","Type":"NodeParagraph","Properties":{"id":"20240607123604-o8mb7h6","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607123604-vjjrhy7","Type":"NodeParagraph","Properties":{"id":"20240607123604-vjjrhy7","updated":"20240607123604"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607123606-eb05ehu","Type":"NodeThematicBreak","Properties":{"id":"20240607123606-eb05ehu"}},{"ID":"20240607123607-95kycrg","Type":"NodeParagraph","Properties":{"id":"20240607123607-95kycrg"}}]}