},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 402px;\" parent-style=\"width: 412px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 412px;","style":"width: 402px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬 3-20240801114056-zy5k9kj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 402px;\" parent-style=\"width: 412px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801115505-t7k1nbt","Type":"NodeParagraph","Properties":{"id":"20240801115505-t7k1nbt","updated":"20240801115853"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 433px;","style":"width: 423px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬 6-20240801115702-temip7q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 423px;\" parent-style=\"width: 433px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 760px;","style":"width: 750px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬 7-20240801115823-enntluz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 750px;\" parent-style=\"width: 760px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801115206-ybl2w17","Type":"NodeParagraph","Properties":{"id":"20240801115206-ybl2w17","updated":"20240801115206"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 460px;","style":"width: 450px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬 2-20240801114001-yb400rc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 450px;\" parent-style=\"width: 460px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 811px;","style":"width: 801px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬 5-20240801114303-ra6487g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 801px;\" parent-style=\"width: 811px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801114759-jmja1pe","Type":"NodeParagraph","Properties":{"id":"20240801114759-jmja1pe","updated":"20240801114759"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬-20240618102224-ll8rps4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 470px;","style":"width: 460px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240618101916-t64f5rj.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 460px;\" parent-style=\"width: 470px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240801123829-x22ctig","Type":"NodeParagraph","Properties":{"id":"20240801123829-x22ctig","updated":"20240801123829"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1054px;","style":"width: 1044px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天门冬 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天门冬 9-20240801123829-24qlbga.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1044px;\" parent-style=\"width: 1054px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240801114906-8ri3qo1","Type":"NodeParagraph","Properties":{"id":"20240801114906-8ri3qo1","updated":"20240801125742"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：天门冬跟文竹较为相似，注意甄别；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240801125630-jgqd3df","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"文竹"}]},{"ID":"20240614170852-vau980v","Type":"NodeThematicBreak","Properties":{"id":"20240614170852-vau980v"}},{"ID":"20240614171238-5cvk1ei","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171238-5cvk1ei","updated":"20240614171244"},"Children":[{"Type":"NodeText","Data":"天门冬《神农本草经》"}]},{"ID":"20240614171238-5mii7gz","Type":"NodeParagraph","Properties":{"id":"20240614171238-5mii7gz","updated":"20240614171238"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240614171238-4dlt3dy","Type":"NodeParagraph","Properties":{"id":"20240614171238-4dlt3dy","updated":"20240614171238"},"Children":[{"Type":"NodeText","Data":"主诸暴风湿偏痹，强骨髓，杀三虫，去伏尸。久服轻身，益气延年。一名颠勒（《尔雅》注引云，门冬一名满冬，今无文）。生山谷。"}]},{"ID":"20240614171238-z8o2cit","Type":"NodeParagraph","Properties":{"id":"20240614171238-z8o2cit","updated":"20240614171238"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生奉高山，二月七月八月采根，暴干。"}]},{"ID":"20240614171238-522pztb","Type":"NodeParagraph","Properties":{"id":"20240614171238-522pztb","updated":"20240614171238"},"Children":[{"Type":"NodeText","Data":"案《说文》云墙，墙蘼，满冬也；《中山经》云：条谷之山，其草多宜冬；《尔雅》云：墙蘼，满冬；《列仙传》云：赤须子食天门冬；《抱朴子·仙药》云：天门冬，或名地门冬，或名筵门冬，或名颠棘，或名淫羊食，或名管松。"}]},{"ID":"20240614171251-964ee0d","Type":"NodeThematicBreak","Properties":{"id":"20240614171251-964ee0d"}},{"ID":"20240614171253-xgv63fs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171253-xgv63fs","updated":"20240614171301"},"Children":[{"Type":"NodeText","Data":"天门冬《本草纲目》"}]},{"ID":"20240614171253-5wpqn0k","Type":"NodeParagraph","Properties":{"id":"20240614171253-5wpqn0k","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"「释名」亦名门冬、颠勒、颠棘、天棘、万岁藤。"}]},{"ID":"20240614171253-8bq2wq1","Type":"NodeParagraph","Properties":{"id":"20240614171253-8bq2wq1","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、平、无毒。"}]},{"ID":"20240614171253-p6922sf","Type":"NodeParagraph","Properties":{"id":"20240614171253-p6922sf","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240614171253-zii7e4g","Type":"NodeParagraph","Properties":{"id":"20240614171253-zii7e4g","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"1、肺痿咳嗽，吐涎，回燥而不渴。用生天门冬捣汁一斗、酒一斗、饴一升、紫苑四合，浓煎成丸子。每服一丸，如杏仁大。一天服三次。"}]},{"ID":"20240614171253-bmibvxi","Type":"NodeParagraph","Properties":{"id":"20240614171253-bmibvxi","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"2、肺劳风热。用天门冬（去皮、心）煮食，或查干为末，加蜜做成丸子服下。"}]},{"ID":"20240614171253-hnp99xi","Type":"NodeParagraph","Properties":{"id":"20240614171253-hnp99xi","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"3、风颠发作（耳如蝉鸣，两胁牵痛）。用天门冬（去心、皮），晒干，捣为末。每服一匙，酒送下。一天服三次。宜久服。"}]},{"ID":"20240614171253-ergp1tb","Type":"NodeParagraph","Properties":{"id":"20240614171253-ergp1tb","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"4、小肠偏坠。用天门冬三钱、乌药五钱，水煎服。"}]},{"ID":"20240614171253-37xit08","Type":"NodeParagraph","Properties":{"id":"20240614171253-37xit08","updated":"20240614171253"},"Children":[{"Type":"NodeText","Data":"5、痈疽。用天门冬三、五两，洗净，捣细，以好酒滤取汁，一次服下。未效，可再次服药，必愈。"}]},{"ID":"20240614171146-709jpd6","Type":"NodeThematicBreak","Properties":{"id":"20240614171146-709jpd6"}},{"ID":"20240614171156-6gs07yj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171156-6gs07yj","updated":"20240614171200"},"Children":[{"Type":"NodeText","Data":"天门冬《新修本草》"}]},{"ID":"20240614171156-oatzvxa","Type":"NodeParagraph","Properties":{"id":"20240614171156-oatzvxa","updated":"20240614171156"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平、大寒，无毒。主诸暴风湿偏痹，强骨髓、杀三虫、去伏尸。保定肺气，去寒热，养肌肤，益气力，利小便，冷而能补。久服轻身益气，延年。不饥。一名颠勒。生奉高山谷。二月、三月、七月、八月采根，曝干。"}]},{"ID":"20240614171156-ze2xudv","Type":"NodeParagraph","Properties":{"id":"20240614171156-ze2xudv","updated":"20240614171156"},"Children":[{"Type":"NodeText","Data":"垣衣、地黄为之使，畏曾青。 奉高，太山下县名也。今处处有，以高地大根味甘者为好。张华《博物志》云∶天门冬逆捋有逆刺。若叶滑者名 休，一名颠棘。可以浣缣，素白如绒（ 类）。金城人名为浣草。擘其根，温汤中挪之，以浣衣胜灰。此非门冬相似尔。案如此说，今人所采，皆是有刺者，本名颠勒，亦粗相似，以浣垢衣则净。《桐君药录》"}]},{"ID":"20240614171156-gn7a9w5","Type":"NodeParagraph","Properties":{"id":"20240614171156-gn7a9w5","updated":"20240614171156"},"Children":[{"Type":"NodeText","Data":"又云∶叶有刺，蔓生，五月花白，十月实黑，根连数十枚。如此殊相乱，而不复更有门冬，恐门冬自一种，不即是浣草耶？又有百部，根亦相类，但苗异尔。门冬蒸剥去皮，食之甚甘美，止饥。虽曝干，犹脂润，难捣。必须薄切，曝于日中，或火烘之也。俗人呼苗为棘刺，煮作饮乃宜人，而终非真棘刺尔。服天门冬，禁食鲤鱼。"}]},{"ID":"20240614171156-x3vnugo","Type":"NodeParagraph","Properties":{"id":"20240614171156-x3vnugo","updated":"20240614171156"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此有二种∶苗有刺而涩者，无刺而滑者，俱是门冬。俗云颠刺、浣草者，形貌 之。虽作数名，终是一物。二根浣垢俱净，门冬、浣草，互名之也。"}]},{"ID":"20240614171146-oh9c9gh","Type":"NodeThematicBreak","Properties":{"id":"20240614171146-oh9c9gh"}},{"ID":"20240614171147-rb0e9ad","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171147-rb0e9ad","updated":"20240614171151"},"Children":[{"Type":"NodeText","Data":"天门冬《神农本草经读》"}]},{"ID":"20240614171147-6tg1n46","Type":"NodeParagraph","Properties":{"id":"20240614171147-6tg1n46","updated":"20240614171147"},"Children":[{"Type":"NodeText","Data":"气味苦、平，无毒。主诸暴风湿偏痹，强骨髓，杀三虫，去伏尸。久服轻身、益气、延年、不饥。"}]},{"ID":"20240614171147-m2p9pdh","Type":"NodeParagraph","Properties":{"id":"20240614171147-m2p9pdh","updated":"20240614171147"},"Children":[{"Type":"NodeText","Data":"【参】天门冬禀寒水之气，而上通于天，故有天冬之名。主治诸暴风湿偏痹者，言风湿之邪暴中于人身，而成半身不遂之偏痹。天冬禀水天之气，环转营运，故可治也。强骨髓者，得寒水之精也。三虫伏尸皆湿热所化，天冬味苦可以祛湿，气平可以清热，湿热下逐，三尸伏虫皆去也。太阳为诸阳主气，故久服轻身，益气。天气通贯于地中，故延年不饥。"}]},{"ID":"20240614171147-e950qro","Type":"NodeParagraph","Properties":{"id":"20240614171147-e950qro","updated":"20240614171147"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶天、麦门冬，皆禀少阴水精之气。麦门冬，禀水精而上通于阳明；天门冬，禀水精而上通于太阳。夫冬主闭藏，门主开转，咸名门冬者，咸能开转闭藏而上达也。后人有天门冬补中有泻，麦门冬泻中有补之说，不知何处引来，良可叹也。"}]},{"ID":"20240614171205-dq8kivc","Type":"NodeThematicBreak","Properties":{"id":"20240614171205-dq8kivc"}},{"ID":"20240614171206-rpgxl20","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171206-rpgxl20","updated":"20240614171210"},"Children":[{"Type":"NodeText","Data":"天门冬《顾松园医镜》"}]},{"ID":"20240614171206-bzh47mz","Type":"NodeParagraph","Properties":{"id":"20240614171206-bzh47mz","updated":"20240614171206"},"Children":[{"Type":"NodeText","Data":"〔甘苦寒，入肺肾、二经。忌鲤鱼，去心用。色白而甘多者佳。〕止嗽消痰，而喘促得宁；除烦解渴而诸血可止。〔阴虚火动，上炎灼肺，而为咳、为喘、为烦渴，煎熬津液而为痰，水不制火而为血妄行。清热保肺，而滋肾阴，故诸症自平。〕养肌肤，〔肺主皮毛，肺喜清润，则肌肤得养而滑泽。又伏热在中，饮食不泽肌肤，热清而肌肤得养。〕去寒热，〔补阴之力也。〕强骨髓，〔肾为作强之官，而主骨。湿热下注，使人骨痿。苦能软坚，寒能除热，热去则湿除，肾得滋补，而髓满骨强矣。〕疔疗痈。〔治肺痿、肺痈者，清金降火润燥之功。〕善杀三，〔虚而内热，三虫虫生焉，补虚去热。三虫杀矣。〕能利二便，〔肺清肃而气化及州都，性寒润而利大肠。〕润燥滋阴，清金降火。又下通于肾，为肺肾虚热之要药。"}]},{"ID":"20240614171206-pe963by","Type":"NodeParagraph","Properties":{"id":"20240614171206-pe963by","updated":"20240614171206"},"Children":[{"Type":"NodeText","Data":"性寒而滑，若脾胃虚而泄泻恶食者，人非所宜；即有前症，当同米仁、山药、白芍、甘、茯用，或用麦冬代之，盖阴虚之人脾胃久弱故也。"}]},{"ID":"20240614171226-g7j32xd","Type":"NodeThematicBreak","Properties":{"id":"20240614171226-g7j32xd"}},{"ID":"20240614171228-7bldhc3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171228-7bldhc3","updated":"20240614171232"},"Children":[{"Type":"NodeText","Data":"天门冬《本草备要》"}]},{"ID":"20240614171228-xb5gj6j","Type":"NodeParagraph","Properties":{"id":"20240614171228-xb5gj6j","updated":"20240614171228"},"Children":[{"Type":"NodeText","Data":"泻肺火，补肾水，润燥痰"}]},{"ID":"20240614171228-i1q389p","Type":"NodeParagraph","Properties":{"id":"20240614171228-i1q389p","updated":"20240614171228"},"Children":[{"Type":"NodeText","Data":"甘苦大寒，入手太阴（肺）气分，清金降火，益水之上源（肺为肾母），下通足少阴肾（苦能坚肾，寒能去肾家湿热，故亦治骨痿）。滋肾润燥，止渴消痰（《蒙筌》曰∶肾主津液，燥则凝而为痰，得润剂则痰化，所谓治痰之本也），泽肌肤，利二便。"}]},{"ID":"20240614171228-zu8f57m","Type":"NodeParagraph","Properties":{"id":"20240614171228-zu8f57m","updated":"20240614171228"},"Children":[{"Type":"NodeText","Data":"治肺痿肿痈（肺痿者，属于风寒咳嗽，短气鼻塞胸胀，久而成痿，有寒痿、热痿二证。"}]},{"ID":"20240614171228-d2d6g1o","Type":"NodeParagraph","Properties":{"id":"20240614171228-d2d6g1o","updated":"20240614171228"},"Children":[{"Type":"NodeText","Data":"肺痈者，热毒蕴结，咳吐脓血，胸中隐痛。痿重而痈稍轻。治痿宜养血、补气、保肺、清火；治痈宜泻热、豁痰、开提、升散。痈为邪实，痿为正虚，不可误治），吐脓吐血（苦泄血滞，甘益元气，寒止血妄行），痰嗽喘促，消渴嗌干（烦渴引饮，多食善饥，为消渴，由火盛津枯），足下热痛，虚劳骨蒸，阴虚有火之证。然性冷利，胃虚无热及泻者忌用。"}]},{"ID":"20240614171228-v1vq92b","Type":"NodeParagraph","Properties":{"id":"20240614171228-v1vq92b","updated":"20240614171228"},"Children":[{"Type":"NodeText","Data":"取肥大明亮者，去心皮，酒蒸。地黄、贝母为使，恶鲤鱼。二冬熬膏并良（天冬滋阴助元消肾痰，麦冬清心降火止肺咳）。"}]},{"ID":"20240614171215-0dgr1jt","Type":"NodeThematicBreak","Properties":{"id":"20240614171215-0dgr1jt"}},{"ID":"20240614171216-9m6n9ad","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171216-9m6n9ad","updated":"20240614171220"},"Children":[{"Type":"NodeText","Data":"天门冬《医学入门》"}]},{"ID":"20240614171216-dbwd981","Type":"NodeParagraph","Properties":{"id":"20240614171216-dbwd981","updated":"20240614171216"},"Children":[{"Type":"NodeText","Data":"天门冬苦寒润肺，泻火消痰定喘气，肺痿肺 多渴衄，通肾补虚及偏痹。"}]},{"ID":"20240614171216-u8f1qbc","Type":"NodeParagraph","Properties":{"id":"20240614171216-u8f1qbc","updated":"20240614171216"},"Children":[{"Type":"NodeText","Data":"天，颠也，一名颠棘。《尔雅》名门冬，冬月作实也。无毒。升也，阴也。入手太阴、足少阴经。东垣云∶保肺气，不被热扰，定喘促，徙得安宁。又云∶润肺肝。《日华》云∶润五脏。其实保与定皆润也。肺润而五脏自润，乃润肺之美药也。泻肺热肺火，消痰止嗽定喘，肺痿肺痈吐脓血，血热吐衄，消渴烦热。又治肺经津燥结为 瘕积聚。通肾气，补五劳七伤及诸暴风湿偏痹，热毒游风。性虽冷能补精枯血冷，益气填髓，养肌肤，利小便，杀三虫，去伏尸；久服颜色洁白，耐寒暑，身轻不饥，延年，令人多子。但专泄而不收，中寒肠滑者禁用。汤浸去皮心，焙热即当风凉之，如此二三次自干，不损药力。地黄、贝母为使。畏曾青、鲤鱼。外用浣衣洗面最洁。"}]},{"ID":"20240614170952-pwfv5cs","Type":"NodeThematicBreak","Properties":{"id":"20240614170952-pwfv5cs"}},{"ID":"20240614171037-qm9wnrh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171037-qm9wnrh","updated":"20240614171140"},"Children":[{"Type":"NodeText","Data":"天门冬《本草述钩元》"}]},{"ID":"20240614171037-iaivqi1","Type":"NodeParagraph","Properties":{"id":"20240614171037-iaivqi1","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"即天棘根也。"}]},{"ID":"20240614171037-uwm5o9m","Type":"NodeParagraph","Properties":{"id":"20240614171037-uwm5o9m","updated":"20240614171040"},"Children":[{"Type":"NodeText","Data":"麦须曰门。麦冬根似麦而有须，其叶如韭，凌冬不凋，故名天冬。草茂，以其功同麦冬，亦曰门冬。"}]},{"ID":"20240614171037-d09cvtb","Type":"NodeParagraph","Properties":{"id":"20240614171037-d09cvtb","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"味苦甘而带辛，性寒，味厚气薄，阳中之阴。入手太阴足少阴经气分。"}]},{"ID":"20240614171037-wr8ai2i","Type":"NodeParagraph","Properties":{"id":"20240614171037-wr8ai2i","updated":"20240614171041"},"Children":[{"Type":"NodeText","Data":"主治润燥滋阴，冷而能补。除虚热，通肾气，强骨髓。清金降火，保定肺气，治喘逆痰嗽，及吐血肺痿吐脓。止烦渴，疗痿躄嗜卧，足下热而痛。大润营卫枯涸，补五劳七伤。"}]},{"ID":"20240614171037-zwfy8br","Type":"NodeParagraph","Properties":{"id":"20240614171037-zwfy8br","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"正禀大寒初之气以生，得地之阴精独厚。味虽微苦，甘而带辛，要以甘多者为胜。（仲淳）"}]},{"ID":"20240614171037-3hp0yxb","Type":"NodeParagraph","Properties":{"id":"20240614171037-3hp0yxb","updated":"20240614171055"},"Children":[{"Type":"NodeText","Data":"患人五虚而热者，宜加用之，和地黄为使。（权）"}]},{"ID":"20240614171037-z35qvwp","Type":"NodeParagraph","Properties":{"id":"20240614171037-z35qvwp","updated":"20240614171056"},"Children":[{"Type":"NodeText","Data":"天冬为主，量加参芪。治血热侵肺，上气喘促，神效。以苦泄滞血，甘助元气也。（洁古）"}]},{"ID":"20240614171037-4887y9s","Type":"NodeParagraph","Properties":{"id":"20240614171037-4887y9s","updated":"20240614171058"},"Children":[{"Type":"NodeText","Data":"按血乘热妄行，不得归经而滞于上，遽以生地之属凉之，恐血滞，则反益其热而日郁生痰。须以天冬为主，加参芪，亦宜酌量。"}]},{"ID":"20240614171037-hgpnaqb","Type":"NodeParagraph","Properties":{"id":"20240614171037-hgpnaqb","updated":"20240614171100"},"Children":[{"Type":"NodeText","Data":"二冬并入手太阴，而麦冬兼行手少阴。清心降火，使肺不犯于贼邪，故止咳胜于天冬。天冬复走足少阴滋肾助元，令肺得全其母气，故消痰又胜于麦冬也。盖痰系津液凝成，肾司津液，燥盛则凝，润多则化。天冬润而走肾，津液纵凝，亦能化解。（嘉谟）"}]},{"ID":"20240614171037-kvray0e","Type":"NodeParagraph","Properties":{"id":"20240614171037-kvray0e","updated":"20240614171102"},"Children":[{"Type":"NodeText","Data":"同麦冬、百部、桑皮、枇杷叶、元参、贝母、童便、竹沥。能清肺消痰止嗽。"}]},{"ID":"20240614171037-4qfadbe","Type":"NodeParagraph","Properties":{"id":"20240614171037-4qfadbe","updated":"20240614171104"},"Children":[{"Type":"NodeText","Data":"同地黄、麦冬、五味、黄柏、车前、枸杞、牛膝为丸。补阴除热，滋肾家燥。脾弱，加山药、茯苓、砂仁以佐之。"}]},{"ID":"20240614171037-g9kysbm","Type":"NodeParagraph","Properties":{"id":"20240614171037-g9kysbm","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"同麦冬、五味，煮膏，入炼蜜。益肺甚妙，亦治消渴。"}]},{"ID":"20240614171037-p5xr28o","Type":"NodeParagraph","Properties":{"id":"20240614171037-p5xr28o","updated":"20240614171105"},"Children":[{"Type":"NodeText","Data":"同甘菊酿酒，除一切风，愈大风病。水煮，则除风热烦闷。"}]},{"ID":"20240614171037-cqztomj","Type":"NodeParagraph","Properties":{"id":"20240614171037-cqztomj","updated":"20240614171107"},"Children":[{"Type":"NodeText","Data":"同生地、麦冬、白芍、鳖甲、牛膝、杜仲、续断、童便。治吐血。"}]},{"ID":"20240614171037-aplyg7a","Type":"NodeParagraph","Properties":{"id":"20240614171037-aplyg7a","updated":"20240614171109"},"Children":[{"Type":"NodeText","Data":"同薏仁、桑黄、白芨、紫菀、百部、百合。除肺痿吐脓血。"}]},{"ID":"20240614171037-tzog1js","Type":"NodeParagraph","Properties":{"id":"20240614171037-tzog1js","updated":"20240614171111"},"Children":[{"Type":"NodeText","Data":"同青蒿、鳖甲、麦冬、牛膝、白芍、银柴胡、地骨皮、五味子。治妇人骨蒸。"}]},{"ID":"20240614171037-bexzdze","Type":"NodeParagraph","Properties":{"id":"20240614171037-bexzdze","updated":"20240614171114"},"Children":[{"Type":"NodeText","Data":"同麻仁、麦冬、生地、童便。除大肠热燥。胃强者，略加桃仁。"}]},{"ID":"20240614171037-qo7kp92","Type":"NodeParagraph","Properties":{"id":"20240614171037-qo7kp92","updated":"20240614171115"},"Children":[{"Type":"NodeText","Data":"阴虚火动有痰，不堪用燥药者。天冬一斤，水浸洗去心，取肉十二两，石臼捣烂。五味子水洗去核取肉四两。晒干，不见火，共捣丸梧子大。每服二十丸，茶下，日三服。"}]},{"ID":"20240614171037-mawfxqd","Type":"NodeParagraph","Properties":{"id":"20240614171037-mawfxqd","updated":"20240614171118"},"Children":[{"Type":"NodeText","Data":"肺痿，咳嗽吐涎沫，心中温温，咽燥而不渴。生天冬捣汁一斗，酒一斗，饴一升，紫菀四合。铜器煎至可丸，每服杏仁大一丸。日三服。"}]},{"ID":"20240614171037-j0nxx58","Type":"NodeParagraph","Properties":{"id":"20240614171037-j0nxx58","updated":"20240614171123"},"Children":[{"Type":"NodeText","Data":"三才丸。滋阴养血，温补下元。用天冬去心，生地二两。二味用柳甑箄，以酒洒之，九蒸九晒，待干秤之。人参一两为末，蒸枣肉，捣和丸梧子大。每服三十丸，食前温酒下，日三服。二方用天冬制不如法，则寒滞为害。"}]},{"ID":"20240614171037-iwllcq8","Type":"NodeParagraph","Properties":{"id":"20240614171037-iwllcq8","updated":"20240614171126"},"Children":[{"Type":"NodeText","Data":"〔论〕二冬皆由胃而或入心，或归肾，以同奏功于肺。麦冬味甘平而气微寒，阳中微阴也。天冬味甘苦，苦胜于甘而气寒，阳中之阴也。二冬之味俱厚，一则清心而复脉滋阴，一则通肾而润燥益精。以肾忌燥而喜润，又精不足者补之以味，故天冬力胜也。其能保定肺气者，丹溪有云：片芩泻肺火。若肺虚者，多用则伤肺。必先以天冬保定肺气而后用之。盖肺有火者，肺阴未虚为实，肺阴不足则为虚。虚者概以清火之味攻之，则其阴愈亡。天冬属足少阴气分药，本肾中阴气以至肺，故能保定肺中阴气，而后可攻其火也。《经》曰：二阴至肺。惟肾阴虚者，不能至于肺而肺虚。天冬不止苦寒除热，兼以润腻益精。俾虚火不烁于阴中，而阴气能极于上际，故肺气赖以保定。所以主喘逆急促，痰嗽吐血，并肺痿痈脓也。肾阴足而心火宁，故能镇心。肺阴下降入心，故主嗌干烦渴。肾气至于肺，肺气还至于肾，故治痿躄嗜卧，及足下热痛，更益气力而利小便也。但润滞之味，同于麦冬。而清冷之性，过于麦冬。于脾胃生发之气，大费酌量而投之。如缪氏所云与薏、苓、山药、甘、芍同用，诚知言哉。仲淳云：凡病因阴虚水涸，火起下焦，上炎于肺，而发痰喘，天冬诚为要药。然苦寒损胃，易致泄泻恶食。要知阴虚精绝之病，正赖脾胃气强，能纳能消，以滋精气。若脾胃先困，则生化之源绝矣，必不得已。当以薏苡、茯苓、山药、甘草、白芍同用，或用麦冬以代之。误必致泄。方书有云：天冬治痰之本，半夏治痰之标。意固谓肾主液，而脾主湿也。但天冬治火盛作燥之痰，本阴气之厚以化燥，而痰自清。半夏治湿盛作滞之痰，本辛燥之气以散湿，而痰自行。二者自是相反，标本之说，不知何见。"}]},{"ID":"20240614171037-fvu3kxg","Type":"NodeParagraph","Properties":{"id":"20240614171037-fvu3kxg","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"单饵，必病肠滑，性寒而润利故也。（濒湖）"}]},{"ID":"20240614171037-y5abhq4","Type":"NodeParagraph","Properties":{"id":"20240614171037-y5abhq4","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"〔修事〕择肥圆长大其味甘多者，汤浸去皮心，焙热，即当风凉之，如此二三次自干，不损药力。"}]},{"ID":"20240614171037-c6eyy21","Type":"NodeParagraph","Properties":{"id":"20240614171037-c6eyy21","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"或用柳甑箄蒸一伏时，洒酒令遍，更添火蒸一伏时，取出。用一小架，去地二尺，摊上晒干。"}]},{"ID":"20240614171037-bcpdv8u","Type":"NodeParagraph","Properties":{"id":"20240614171037-bcpdv8u","updated":"20240614171037"},"Children":[{"Type":"NodeText","Data":"又法，去心，捶扁极薄，晒干，隔纸焙焦用。"}]},{"ID":"20240614170953-8qllkby","Type":"NodeThematicBreak","Properties":{"id":"20240614170953-8qllkby"}},{"ID":"20240614171005-uqf4oji","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171005-uqf4oji","updated":"20240614171009"},"Children":[{"Type":"NodeText","Data":"天门冬《千金翼方》"}]},{"ID":"20240614171005-xeglvmd","Type":"NodeParagraph","Properties":{"id":"20240614171005-xeglvmd","updated":"20240614171005"},"Children":[{"Type":"NodeText","Data":"味苦甘，平，大寒，无毒。主诸暴风湿偏痹，强骨髓，杀三虫，去伏尸，保定肺气，去寒热，养肌肤，益气力，利小便，冷而能补。久服轻身，益气，延年不饥。一名颠勒。生奉高山谷，二月三月七月八月采根，曝干。"}]},{"ID":"20240614170953-x733atu","Type":"NodeThematicBreak","Properties":{"id":"20240614170953-x733atu"}},{"ID":"20240614170954-tfrdblr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170954-tfrdblr","updated":"20240614170958"},"Children":[{"Type":"NodeText","Data":"天门冬《本草求真》"}]},{"ID":"20240614170954-55rl74y","Type":"NodeParagraph","Properties":{"id":"20240614170954-55rl74y","updated":"20240614170954"},"Children":[{"Type":"NodeText","Data":"（蔓草）消肺火以为化源之自"}]},{"ID":"20240614170954-uza5vn3","Type":"NodeParagraph","Properties":{"id":"20240614170954-uza5vn3","updated":"20240614170954"},"Children":[{"Type":"NodeText","Data":"天门冬（专入肺）。甘苦大寒。据书载泻肺火及兼补肾。然究止属苦寒。安能滋肾而补水乎？"}]},{"ID":"20240614170954-el5fjtd","Type":"NodeParagraph","Properties":{"id":"20240614170954-el5fjtd","updated":"20240614170954"},"Children":[{"Type":"NodeText","Data":"（的解）所云能补水者。以肺本清虚。凉则气宁而不扰。热则气行而不生。且肺为肾母。肺金失养。则肾亦燥而不宁。肾气上攻。则肺益燥而受克。而凡咳嗽吐衄。痰结燥渴。肺痈肺痿等症。靡不因之毕呈。（肺痈本于五脏蕴火。及胃积热上蒸。与外感风寒。内伤营血。热结而成。痿则本于津液枯竭。不能上输于肺。及风热伤卫。而致气竭力疲。故痈则为阳实。而痿则为阴虚。痈则邪伤于营。故唾有血而无沫。而便多下脓垢。痿则邪伤于卫。故唾有沫而无血。而便多下浊沫。痈则口中辟辟作燥而渴。痿则口中不燥而步武喘鸣。冲击连声而痰始应。痈则胸中隐隐作痛。痿则胸中不痛而气馁不振。痈则脉数而实。痿则脉数而虚。痈则宜表宜下。痿则宜滋宜润。治法因于内者。从内酌治。因于外者。从外酌解。因于虚者。养血补气保肺。因于实者。豁痰。开提升降。）得此清肃之品。以为化源之自。则肾未必即补。而补肾之基。未必不于所清而先具也。是以又云补肾。但其性滑利。脾胃虚寒。及无热而泄者最忌。（苦泄热。寒胜热。若无热而泄。则不得用。）取肥大明亮者良。去心皮。酒蒸用。地黄贝母为使。恶鲤鱼二冬。熬膏良。"}]},{"ID":"20240614170921-4px5m7i","Type":"NodeThematicBreak","Properties":{"id":"20240614170921-4px5m7i"}},{"ID":"20240614170944-f6d7lm6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170944-f6d7lm6","updated":"20240614170948"},"Children":[{"Type":"NodeText","Data":"天门冬《本经逢原》"}]},{"ID":"20240614170944-gir3oxo","Type":"NodeParagraph","Properties":{"id":"20240614170944-gir3oxo","updated":"20240614170944"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即天棘根"}]},{"ID":"20240614170944-tu7jh4y","Type":"NodeParagraph","Properties":{"id":"20240614170944-tu7jh4y","updated":"20240614170944"},"Children":[{"Type":"NodeText","Data":"甘寒，无毒。焙热去心，用肥白者良。忌鲤鱼。"}]},{"ID":"20240614170944-j2icef2","Type":"NodeParagraph","Properties":{"id":"20240614170944-j2icef2","updated":"20240614170944"},"Children":[{"Type":"NodeText","Data":"《本经》主诸暴风湿偏痹，强骨髓，杀三虫，去伏尸，久服轻身益气，延年不饥。"}]},{"ID":"20240614170944-imm6bs9","Type":"NodeParagraph","Properties":{"id":"20240614170944-imm6bs9","updated":"20240614170944"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"天门冬手太阴肺经气分药。兼通肾气咳逆喘促，肺痿肺痈，吐血衄血，干咳痰结，其性寒润能滋肺，肺气热而燥者宜之。肺为清虚之脏，凉则气宁，热则气腾。天门冬能保肺，使气不受火扰。合地黄、麦门冬主心肺虚热咳吐脓血，又能治热淋。同参、 定虚喘，盖肺肃则气化，乃能出。若脾虚而泄泻恶食者，虽有前证，亦莫轻投，以其降泄太过也。时珍云，天门冬清金降火，益水之上源，故能下通肾气，入滋补方用之有效。若脾胃虚寒人久服，必致滑肠，反成痼疾，以性寒能利大肠故也。《本经》治诸暴风湿偏痹，盖热则生风，暴则属火，偏痹者湿热所致，故治风先清火，清火在养阴也。其三虫伏尸，皆脾肾湿热所化，清二经湿热，则无三虫伏尸之患矣。又能延年不饥，故辟谷方多用之。"}]},{"ID":"20240614171340-5duxu8b","Type":"NodeThematicBreak","Properties":{"id":"20240614171340-5duxu8b"}},{"ID":"20240614171342-kkvltuc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171342-kkvltuc","updated":"20240614171347"},"Children":[{"Type":"NodeText","Data":"天门冬《名医别录》"}]},{"ID":"20240614171342-0qpmnqp","Type":"NodeParagraph","Properties":{"id":"20240614171342-0qpmnqp","updated":"20240614171342"},"Children":[{"Type":"NodeText","Data":"味甘，大寒，无毒．保定肺气，去寒热，养肌肤，益气力，利小便，冷而能补．久饥．二月、三月、七月、八月采根，曝干．（垣衣、地黄为之使，畏曾青．）"}]},{"ID":"20240614171342-u50fq09","Type":"NodeParagraph","Properties":{"id":"20240614171342-u50fq09","updated":"20240614171408"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶天门冬，味苦，平．主诸暴风湿偏痹，强骨髓，杀三虫，去伏尸．久服，轻身益气延年．一名颠勒，生山谷。"}]},{"ID":"20240614170921-410jkpi","Type":"NodeThematicBreak","Properties":{"id":"20240614170921-410jkpi"}},{"ID":"20240614170935-9ze8683","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170935-9ze8683","updated":"20240614171436"},"Children":[{"Type":"NodeText","Data":"天门冬《本草便读》"}]},{"ID":"20240614170935-b4x9lmc","Type":"NodeParagraph","Properties":{"id":"20240614170935-b4x9lmc","updated":"20240614170935"},"Children":[{"Type":"NodeText","Data":"清金降火．苦寒味带余甘．壮水强阴．润泽性偏在腻．咳血可疗痈痿愈．尸虫尽化燥痰除．肠滑勿投．胃虚当禁．（天门冬甘苦而寒．色白润降．清肺金．壮肾水．是其本功．本经称其杀三虫．去伏尸鬼疰者．大抵亦为瘀热所化．热退则病除耳．天冬较麦冬苦多寒盛．沉降之性过之．故兼能入肾经．治诸病总宜于阴不足而有火邪者．若脾胃虚寒便溏之人．禁勿用．）"}]},{"ID":"20240614170921-slj058y","Type":"NodeThematicBreak","Properties":{"id":"20240614170921-slj058y"}},{"ID":"20240614170923-bs3edih","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170923-bs3edih","updated":"20240614170931"},"Children":[{"Type":"NodeText","Data":"天门冬《冯氏锦囊秘录》"}]},{"ID":"20240614170923-po9pr4b","Type":"NodeParagraph","Properties":{"id":"20240614170923-po9pr4b","updated":"20240614170923"},"Children":[{"Type":"NodeText","Data":"正禀大寒初之气以生，得地之阴精，独浓味，苦甘平，其气大寒，其性无毒，阴也、降也。凡采取阴干去心用。"}]},{"ID":"20240614170923-aqducm5","Type":"NodeParagraph","Properties":{"id":"20240614170923-aqducm5","updated":"20240614170923"},"Children":[{"Type":"NodeText","Data":"天冬，补虚损劳伤强髓，润五脏，悦颜色，养肌肤，解渴除烦消痰住嗽，保肺气不被热扰，通肾气能除热淋，止血溢妄行，润粪燥闭结，同参 煎饮，定虚喘神方。和姜蜜熬膏，破顽痰癖圣剂。肺痈肺痿能挽回垂绝，吐血吐脓诚夺命再生，苦泄止血，甘助真元，寒退肺经火热，三者天冬之功焉。虚热人神妙，虚寒人忌投，麦冬清心以保肺，天冬滋水以涵金，一以救上，一以滋下，其保肺同也。但上下寒热有殊，而天冬之宜禁亦异矣。"}]},{"ID":"20240614170923-8anez41","Type":"NodeParagraph","Properties":{"id":"20240614170923-8anez41","updated":"20240614170923"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 泻肺火保肺气，疗热毒上侵气分，吐衄咳逆喘促，兼能润燥而止消渴，镇心润五脏。然痘以脾胃为主；伤脾寒胃，切勿轻投。若皮虚胃弱之人，尤宜痛绝。"}]},{"ID":"20240614170923-hmi0f9t","Type":"NodeParagraph","Properties":{"id":"20240614170923-hmi0f9t","updated":"20240614170923"},"Children":[{"Type":"NodeText","Data":"按∶天冬清金降火，益水之源，故能下通肾气，而滋补肾，主五液燥则凝而为痰，得润剂则肺不苦燥，而痰自化，故湿火之痰，半夏主之；燥火之痰，天冬主之。若肺胃虚寒，单服久服，必病肠滑而成痼疾。"}]},{"ID":"20240614170852-p3ze0pv","Type":"NodeThematicBreak","Properties":{"id":"20240614170852-p3ze0pv"}},{"ID":"20240614170909-m1b61ir","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170909-m1b61ir","updated":"20240614170914"},"Children":[{"Type":"NodeText","Data":"天门冬《得配本草》"}]},{"ID":"20240614170909-86nikgc","Type":"NodeParagraph","Properties":{"id":"20240614170909-86nikgc","updated":"20240614170909"},"Children":[{"Type":"NodeText","Data":"地黄、贝母、垣衣为之使。畏曾青、浮萍。忌鲤鱼、铁器。制雄黄、 砂。"}]},{"ID":"20240614170909-7y4z4s1","Type":"NodeParagraph","Properties":{"id":"20240614170909-7y4z4s1","updated":"20240614170909"},"Children":[{"Type":"NodeText","Data":"甘、苦，寒。入手太阴、足少阴经气分。清金降火，滋阴润燥，治嗽消痰，祛烦解渴。"}]},{"ID":"20240614170909-it2isse","Type":"NodeParagraph","Properties":{"id":"20240614170909-it2isse","updated":"20240614170909"},"Children":[{"Type":"NodeText","Data":"疗肺痈，止吐血。除足下热痛，虚劳骨蒸。麦冬清心降火，天冬滋肾助元，其保肺阴则一也。得紫菀、饴糖，治肺痿咳嗽。得乌药，治小肠偏坠。"}]},{"ID":"20240614170909-uxolna8","Type":"NodeParagraph","Properties":{"id":"20240614170909-uxolna8","updated":"20240614170909"},"Children":[{"Type":"NodeText","Data":"得川贝，止吐血。配花粉，治痰热结胸。"}]},{"ID":"20240614170909-0tkggq5","Type":"NodeParagraph","Properties":{"id":"20240614170909-0tkggq5","updated":"20240614170909"},"Children":[{"Type":"NodeText","Data":"配人参，定虚喘。佐玄参，治口疮。佐熟地，补肾水。"}]},{"ID":"20240614170909-iue5x8l","Type":"NodeParagraph","Properties":{"id":"20240614170909-iue5x8l","updated":"20240614170909"},"Children":[{"Type":"NodeText","Data":"去心皮，酒拌蒸，晒用。服此误食鲤鱼者，浮萍汁解之。脾胃虚寒者禁用。"}]},{"ID":"20240614170852-l44v2ms","Type":"NodeThematicBreak","Properties":{"id":"20240614170852-l44v2ms"}},{"ID":"20240614170854-ujktxvp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170854-ujktxvp","updated":"20240614170858"},"Children":[{"Type":"NodeText","Data":"天门冬《本草害利》"}]},{"ID":"20240614170854-oxjer71","Type":"NodeParagraph","Properties":{"id":"20240614170854-oxjer71","updated":"20240614170854"},"Children":[{"Type":"NodeText","Data":"〔害〕大寒而苦，不利脾胃，虚而泄泻恶食者，大非所宜。阴虚精竭之病，全赖脾胃气强，能纳能消，以滋精气。若脾胃先困，后天源绝，丸饵虽佳。总仗于食，汤液虽妙，终属于饮。又以苦寒损其胃气，致泄泻恶食，则危殆矣。若脾胃虚寒人，单饵既久，必病肠滑，反成痼疾。以此物性寒而润，能利大肠故也。"}]},{"ID":"20240614170854-txw2cju","Type":"NodeParagraph","Properties":{"id":"20240614170854-txw2cju","updated":"20240614170854"},"Children":[{"Type":"NodeText","Data":"〔利〕甘寒，保肺润燥，补肾养阴，肺肾虚热之要药也。"}]},{"ID":"20240614170854-1i03lio","Type":"NodeParagraph","Properties":{"id":"20240614170854-1i03lio","updated":"20240614170854"},"Children":[{"Type":"NodeText","Data":"〔修治〕二三七八月采根，蒸剥去皮，四破去心，必须曝于日中，或火烘干用。"}]},{"ID":"20240607094505-0wda4q1","Type":"NodeThematicBreak","Properties":{"id":"20240607094505-0wda4q1"}},{"ID":"20240614170841-pjrx975","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170841-pjrx975","updated":"20240614170847"},"Children":[{"Type":"NodeText","Data":"天门冬《证类本草》"}]},{"ID":"20240614170841-dwutl8n","Type":"NodeParagraph","Properties":{"id":"20240614170841-dwutl8n","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平、大寒，无毒。主诸曝风湿偏痹，强骨髓，杀三虫，去伏尸，保定肺气，去寒热，养肌肤，益气力，利小便，冷而能补，久服轻身，益气延年，不饥。一名颠勒。生奉高山谷。二月、三月、七月、八月采根，曝干。（垣衣、地黄为之使，畏曾青。）"}]},{"ID":"20240614170841-upsjh7f","Type":"NodeParagraph","Properties":{"id":"20240614170841-upsjh7f","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶奉高，泰山下县名也。今处处有，以高地大根味甘者为好。张华《博物志》云∶天门冬，逆捋有逆刺。若叶滑者，名 休，一名颠棘。可以浣缣，素白如绒（音越 类）。"}]},{"ID":"20240614170841-tro6mcj","Type":"NodeParagraph","Properties":{"id":"20240614170841-tro6mcj","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"金城人名为浣草。擘其根，温汤中挪之，以浣衣胜灰。此非门冬，相似尔。按∶如此说，今人所采皆是有刺者，本名颠勒，亦粗相似，以浣垢衣则净。《桐君药录》又云∶叶有刺，蔓生，五月花白，十月实黑，根连数十枚。如此殊相乱，而不复更有门冬，恐门冬自一种，不即是浣草耶？又有百部，根亦相类，但苗异尔。门冬蒸，剥去皮，食之甚甘美，止饥。虽曝干，犹脂润难捣，必须薄切，曝于日中，或火烘之也。俗人呼苗为棘刺，煮作饮乃宜人，而终非真棘刺尔。服天门冬，禁食鲤鱼。唐本注云∶此有二种，苗有刺而涩者，无刺而滑者，俱是门冬。俗云颠刺、浣草者，形 （音瞑）之。虽作数名，终是一物。二根浣垢俱净，门冬、浣草，互名之也。今按陈藏器本草云∶天门冬，陶云百部根亦相类，苗异尔。按天门冬根有十余茎，百部多者五、六十茎，根长尖，内虚，味苦。天门冬根圆短实润，味甘不同，苗蔓亦别。如陶所说，乃是同类。今人或以门冬当百部者，说不明也。臣禹锡等谨按尔雅云∶蔷蘼，门冬。注云∶门冬，一名满冬。 （音门）。抱朴子云∶或名地门冬，或名 门冬，或名巅棘，或名淫羊食，或名管松。其生高地，根短味甜气香者上。其上水侧下地者，叶细似蕴而黄，根长而味多苦气臭者下。亦可服食，然善令人下气，为益又迟也。服之百日，皆丁壮兼倍，快于术及黄精也。入山便可蒸，若煮啖之，取足以断谷；若有力，可饵之。亦作散并捣绞其汁作液以服，散尤益。药性论云∶天门冬，君。主肺气咳逆，喘息促急，除热，通肾气。疗肺，生痈吐脓，治湿疥，止消渴，去热中风，宜久服。煮食之，令人肌体滑泽，除身中一切恶气，不洁之疾，令人白净。蜀人使浣衣如玉，和地黄为使，服之耐老，头不白，能冷补，患人体虚而热，加而用之。杨损之云∶服天门冬，误食鲤鱼中毒，浮萍解之。日华子云∶贝母为使。镇心，润五脏，益皮肤，悦颜色，补五劳七伤，治肺气并嗽，消痰，风痹，热毒游风，烦闷吐血，去心用。"}]},{"ID":"20240614170841-sk8v7qy","Type":"NodeParagraph","Properties":{"id":"20240614170841-sk8v7qy","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"图经曰∶天门冬，生奉高山谷，今处处有之。春生藤蔓，大如钗股，高至丈余，叶如茴香，尖细而疏滑，有逆刺，亦有涩而无刺者。其叶如丝杉而细散，皆名天门冬。夏生白花，亦有黄色者。秋结黑子，在其根枝旁。入伏后无花，暗结子。其根白或黄紫色，大如手指，长二、三寸，大者为胜，颇与百部根相类，然圆实而长，一、二十枚同撮。二月、三月、七月、八月采根，四破之，去心，先蒸半炊间，曝干，停留久仍湿润。入药时，重炕焙令燥。洛中出者，叶大干粗，殊不相类。岭南者无花，余无它异。谨按天门冬别名，《尔雅》谓之蘼（亡彼切），一名 （极闸同）冬。《山海经》云∶条谷之山，其草多芍药， 冬是也。《抱朴子》及《神仙服食方》云∶天门冬，一名颠棘。在东岳名淫羊食；在中岳名天门冬；在西岳名管松；在北岳名无不愈；在南岳名百部；在京陆山阜名颠棘。虽处处皆有，其名各异，其实一也，在北岳地阴者尤佳。欲服之，细切，阴干，捣下筛，酒调三钱匕，日五、六进之，二百日知，可以强筋髓，驻颜色，与炼成松脂同蜜丸益善。服者不可食鲤鱼，此方以颠棘为别名，而张茂先以为异类。《博物志》云∶天门冬茎间有刺，而叶滑者曰 休，一名颠枣，根以浣缣素令白。越人名为浣草，似天门冬而非也。凡服此，先试浣衣如法者，便非天门冬。若如所说，则有刺而叶滑，便不中服。然今所有，往往是此类，用者须详之。"}]},{"ID":"20240614170841-w8s5ohs","Type":"NodeParagraph","Properties":{"id":"20240614170841-w8s5ohs","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"雷公云∶采得了，去上皮一重，便劈破，去心，用柳木甑，烧柳木柴，蒸一伏时，洒酒令遍，更添火蒸，出曝，去地二尺以来，作小架，上铺天门叶，将蒸了天门冬，摊令干用。食疗补虚劳，治肺痨，止渴，去热风。可去皮、心，入蜜煮之，食后服之。若曝干，入蜜丸尤佳。"}]},{"ID":"20240614170841-omcgiyj","Type":"NodeParagraph","Properties":{"id":"20240614170841-omcgiyj","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"亦用洗面，甚佳。外台秘要∶治风癫引胁牵痛，发作则吐，耳如蝉鸣。天门冬去心、皮，曝干捣筛，酒服方寸匕。若人久服，亦能长生。经验后方∶服天门冬法∶不计多少，去心、皮为末，每服方寸匕，日三、四服不绝，甚益人，以酒饮之。又，治症瘕积聚，去三尸，轻身益气，延年耐老，百病不侵。孙真人枕中记∶天门冬，末，服方寸匕，日三。无问山中、人间，恒勿废，久服益。若酿酒服之，去症瘕积聚，风痰癫狂，三虫伏尸，除瘟痹，轻身益气，令人不饥，百日还年耐老。修真秘旨神仙∶服天门冬三十斤，细切，阴干，捣末。每服三钱，酒调下，日五、六服。二百日后怡泰，拘急者缓，羸劣者强；三百日身轻；三年走及奔马。道马八帝圣化经∶欲不畏寒，取天门冬、茯苓等分为末。服方寸匕，日再服。大寒时，单衣汗出。"}]},{"ID":"20240614170841-19fy0p6","Type":"NodeParagraph","Properties":{"id":"20240614170841-19fy0p6","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"抱朴子云∶杜紫微服天门冬，御八十外家，有男一百四十人，日行三百里。列仙传∶赤顶子食天门冬，齿落更生，细发复出。神仙传∶甘始者，太原人，服天门冬，在人间三百余年。"}]},{"ID":"20240614170841-nuchp72","Type":"NodeParagraph","Properties":{"id":"20240614170841-nuchp72","updated":"20240614170841"},"Children":[{"Type":"NodeText","Data":"衍义曰∶天门冬，麦门冬之类。虽曰去心，但以水渍漉使，周润，渗入肌，俟软，缓缓擘取，不可浸出脂液。其不知者，乃以汤浸一、二时，柔即柔矣，然气味都尽。用之不效，乃曰药不神，其可得乎？治肺热之功为多。其味苦，但专泄而不专收，寒多人禁服。余如二经。"}]},{"ID":"20240607094505-jqfbayo","Type":"NodeThematicBreak","Properties":{"id":"20240607094505-jqfbayo"}},{"ID":"20240614170828-nrubm66","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614170828-nrubm66","updated":"20240614170833"},"Children":[{"Type":"NodeText","Data":"天门冬《本草从新》"}]},{"ID":"20240614170828-95m8yh7","Type":"NodeParagraph","Properties":{"id":"20240614170828-95m8yh7","updated":"20240614170828"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻肺火、补肾水、润燥．"}]},{"ID":"20240614170828-eanlpkx","Type":"NodeParagraph","Properties":{"id":"20240614170828-eanlpkx","updated":"20240614170828"},"Children":[{"Type":"NodeText","Data":"甘苦大寒．入手太阴气分．（肺．）清金降火．益水之上源．（肺为肾母．）下通足少阴肾．（苦能坚肾、寒能去肾家湿热、故亦治骨痿．）滋阴润燥．杀虫消痰．（蒙筌曰∶肾主津液、燥则凝而为痰、得润剂则痰化、所谓治痰之本也．）泽肌肤．利二便．治肺痿肺痈．（肺痿者、感于风寒、咳嗽短气、鼻塞、胸胀、久而成痿、有寒痿热痿二证、肺痈者、热毒蕴结、咳吐脓血、胸中隐痛、痿重而痈稍轻、治痿宜养血补气、保肺清火、治痈宜泻热豁痰、开提升散、痈为邪实、痿为正虚、不得混治．）吐脓吐血．（苦泄血滞、甘益元气、寒止血妄行．）痰嗽喘促．嗌干消渴．（口燥多饮为消渴、由火盛津枯、宜润燥滋阴．）足下热痛．虚劳骨蒸．"}]},{"ID":"20240614170828-k63y2dy","Type":"NodeParagraph","Properties":{"id":"20240614170828-k63y2dy","updated":"20240614170828"},"Children":[{"Type":"NodeText","Data":"一切阴虚有火诸证．性寒而滑．脾胃虚而泄泻恶食者．大非所宜．取肥大明亮者．去心皮．"}]},{"ID":"20240614170828-8riz5yy","Type":"NodeParagraph","Properties":{"id":"20240614170828-8riz5yy","updated":"20240614170828"},"Children":[{"Type":"NodeText","Data":"酒蒸．熬膏良．（滋阴助元、消肾痰．）地黄、贝母为使．恶鲤鱼．（肺劳风热、天门冬煮食、止渴去热、或曝干为末、蜜丸服尤佳、亦可洗面．）"}]},{"ID":"20240614171316-wekcizz","Type":"NodeThematicBreak","Properties":{"id":"20240614171316-wekcizz"}},{"ID":"20240614171317-7pwlhw9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614171317-7pwlhw9","updated":"20240614171322"},"Children":[{"Type":"NodeText","Data":"天门冬《中药学》"}]},{"ID":"20240614171317-gy68dz0","Type":"NodeParagraph","Properties":{"id":"20240614171317-gy68dz0","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为百合科植物天门冬的块根。"}]},{"ID":"20240614171317-2n1zz8q","Type":"NodeParagraph","Properties":{"id":"20240614171317-2n1zz8q","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、苦，大寒。入肺、肾经。"}]},{"ID":"20240614171317-m7501n3","Type":"NodeParagraph","Properties":{"id":"20240614171317-m7501n3","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【功效】润肺止咳，养阴生津。"}]},{"ID":"20240614171317-kq29q0g","Type":"NodeParagraph","Properties":{"id":"20240614171317-kq29q0g","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肺阴受伤，燥咳、咯血等症。"}]},{"ID":"20240614171317-pi7towl","Type":"NodeParagraph","Properties":{"id":"20240614171317-pi7towl","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"天冬功能养阴清热而润肺，故可用于肺虚有热、干咳少痰、咯血等症，常与麦冬、沙参、生地等配伍。"}]},{"ID":"20240614171317-29qzdoi","Type":"NodeParagraph","Properties":{"id":"20240614171317-29qzdoi","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"2.用于阴虚内热，口渴等症。"}]},{"ID":"20240614171317-ka3xk5q","Type":"NodeParagraph","Properties":{"id":"20240614171317-ka3xk5q","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"天冬能滋阴生津，凡遇热病伤阴、阴虚内热、津少口渴等症，可与生地、麦冬、石斛等同用。"}]},{"ID":"20240614171317-r23dwqq","Type":"NodeParagraph","Properties":{"id":"20240614171317-r23dwqq","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【处方用名】天门冬、明天冬、天冬（洗净，晒干，切断用）。"}]},{"ID":"20240614171317-c2utzy7","Type":"NodeParagraph","Properties":{"id":"20240614171317-c2utzy7","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240614171317-tz9gy1t","Type":"NodeParagraph","Properties":{"id":"20240614171317-tz9gy1t","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【按语】天冬为一味甘寒清润的药物，善治肺肾虚热。用于上焦，能清肺热而养肺阴；用于下焦，能滋肾养阴，且可润燥滑肠。如属脾胃虚弱泄泻者，不宜应用。"}]},{"ID":"20240614171317-56a5v2o","Type":"NodeParagraph","Properties":{"id":"20240614171317-56a5v2o","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【方剂举例】二冬膏《张氏医通》：天门冬，麦门冬、白蜜。治肺胃燥热，咳嗽痰少。"}]},{"ID":"20240614171317-nly152b","Type":"NodeParagraph","Properties":{"id":"20240614171317-nly152b","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主诸暴风湿偏痹，强骨髓，杀三虫。」"}]},{"ID":"20240614171317-v708m8b","Type":"NodeParagraph","Properties":{"id":"20240614171317-v708m8b","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"《药性本草》：「治肺气咳逆，喘息促急，肺痿生痈吐脓，除热，通肾气，止消渴。」"}]},{"ID":"20240614171317-ocpwji4","Type":"NodeParagraph","Properties":{"id":"20240614171317-ocpwji4","updated":"20240614171317"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「润燥滋阴。」"}]},{"ID":"20240607094506-912304t","Type":"NodeThematicBreak","Properties":{"id":"20240607094506-912304t"}},{"ID":"20240607094507-fskiyoc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607094507-fskiyoc","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：天门冬"}]},{"ID":"20240607094507-ld37ngu","Type":"NodeParagraph","Properties":{"id":"20240607094507-ld37ngu","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607094507-u8ks969","Type":"NodeParagraph","Properties":{"id":"20240607094507-u8ks969","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" Tiān Mén Dōnɡ"}]},{"ID":"20240607094507-ftca5xc","Type":"NodeParagraph","Properties":{"id":"20240607094507-ftca5xc","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607094507-geq562l","Type":"NodeParagraph","Properties":{"id":"20240607094507-geq562l","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 大当门根（《石药尔雅》），天冬（《药品化义》）。"}]},{"ID":"20240607094507-w0r8csl","Type":"NodeParagraph","Properties":{"id":"20240607094507-w0r8csl","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607094507-encxn6y","Type":"NodeParagraph","Properties":{"id":"20240607094507-encxn6y","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607094507-h871108","Type":"NodeParagraph","Properties":{"id":"20240607094507-h871108","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094507-cirs3vo","Type":"NodeParagraph","Properties":{"id":"20240607094507-cirs3vo","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 为百合科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天门冬"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块根"},{"Type":"NodeText","Data":"。秋、冬采挖，但以冬季采者质量较好。挖出后洗净泥土，除去须根，按大小分开，入沸水中煮或蒸至外皮易剥落时为度。捞出浸入清水中，趁热除去外皮，洗净，微火烘干或用硫黄熏后再烘干。"}]},{"ID":"20240607094507-mvmvvgt","Type":"NodeParagraph","Properties":{"id":"20240607094507-mvmvvgt","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607094507-6vk536x","Type":"NodeParagraph","Properties":{"id":"20240607094507-6vk536x","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 生于山野，亦栽培于庭园。分布我国中部、西北、长江流域及南方各地。主产贵州、四川、广西。此外，浙江、云南、陕西、甘肃、安徽、湖北、河南、江西等地亦产。以贵州产量最大，品质亦佳。"}]},{"ID":"20240607094507-oidzgp1","Type":"NodeParagraph","Properties":{"id":"20240607094507-oidzgp1","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607094507-eg12dcs","Type":"NodeParagraph","Properties":{"id":"20240607094507-eg12dcs","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 天门冬，又名：颠勒（《本经》），万岁藤、婆罗树（《救荒本草》），天棘（《纲目》），白罗杉（《植物名实图考》），多儿母、八百崽、丝冬。"}]},{"ID":"20240607094507-d52xcr9","Type":"NodeParagraph","Properties":{"id":"20240607094507-d52xcr9","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"攀援状多年生草本。块根肉质，簇生，长椭圆形或纺锤形，长4～10厘米，灰黄色。茎细，长可达2米，有纵槽纹。叶状枝2～3枚束生叶腋，线形，扁平，长1～2.5（～3）厘米，宽1毫米左右，稍弯曲，先端锐尖。叶退化为鳞片，主茎上的鳞状叶常变为下弯的短刺。花1～3朵簇生叶腋，黄白色或白色，下垂；花被6，排成2轮，长卵形或卵状椭圆形，长约2毫米；雄蕊6，花药呈丁字形；雌蕊1，子房3室，柱头3歧。浆果球形，径约6毫米，熟时红色。花期5月。"}]},{"ID":"20240607094507-1553fpj","Type":"NodeParagraph","Properties":{"id":"20240607094507-1553fpj","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094507-d9zw3cg","Type":"NodeParagraph","Properties":{"id":"20240607094507-d9zw3cg","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 干燥的块根呈长圆纺锤形，中部肥满，两端渐细而钝，长6～20厘米，中部直径0.5～2厘米。表面黄白色或浅黄棕色，呈油润半透明状，有时有细纵纹或纵沟，偶有未除净的黄棕色外皮。干透者质坚硬而脆，未干透者质柔软，有粘性，断面蜡质样，黄白色，半透明，中间有不透明白心。臭微，味甘微苦。以肥满、致密、黄白色、半透明者为佳。条瘦长、色黄褐、不明亮者质次。"}]},{"ID":"20240607094507-0gp8a45","Type":"NodeParagraph","Properties":{"id":"20240607094507-0gp8a45","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607094507-p2yeu42","Type":"NodeParagraph","Properties":{"id":"20240607094507-p2yeu42","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 抗肿瘤作用"}]},{"ID":"20240607094507-o2t66wb","Type":"NodeParagraph","Properties":{"id":"20240607094507-o2t66wb","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"体外试验（美蓝法及瓦氏呼吸器测定），天门冬对急性淋巴细胞型白血病、慢性粒细胞型白血病及急性单核细胞型白血病患者白细胞的脱氢酶有一定的抑制作用，并能抑制急性淋巴细胞型白血病患者白细胞的呼吸。"}]},{"ID":"20240607094507-5x7hs79","Type":"NodeParagraph","Properties":{"id":"20240607094507-5x7hs79","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607094507-2hq4prp","Type":"NodeParagraph","Properties":{"id":"20240607094507-2hq4prp","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，水洗净J闷润至内外湿度均匀，切段，干燥。"}]},{"ID":"20240607094507-0cdjdpw","Type":"NodeParagraph","Properties":{"id":"20240607094507-0cdjdpw","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094507-ds05v5k","Type":"NodeParagraph","Properties":{"id":"20240607094507-ds05v5k","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 入肺、肾经。"}]},{"ID":"20240607094507-rbo0va0","Type":"NodeParagraph","Properties":{"id":"20240607094507-rbo0va0","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"入手太阴、足少阴经。\""}]},{"ID":"20240607094507-844i2d5","Type":"NodeParagraph","Properties":{"id":"20240607094507-844i2d5","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"②《本草经解》：\"入手太阴肺经、手少阴心经。\""}]},{"ID":"20240607094507-r2836w2","Type":"NodeParagraph","Properties":{"id":"20240607094507-r2836w2","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094507-2dorrv8","Type":"NodeParagraph","Properties":{"id":"20240607094507-2dorrv8","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 甘苦，寒。"}]},{"ID":"20240607094507-n2gs2xj","Type":"NodeParagraph","Properties":{"id":"20240607094507-n2gs2xj","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240607094507-rlf752u","Type":"NodeParagraph","Properties":{"id":"20240607094507-rlf752u","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，大寒，无毒。\""}]},{"ID":"20240607094507-1u7orie","Type":"NodeParagraph","Properties":{"id":"20240607094507-1u7orie","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"性寒，味甘微苦。\""}]},{"ID":"20240607094507-uu5r4dw","Type":"NodeParagraph","Properties":{"id":"20240607094507-uu5r4dw","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607094507-ka8xtxs","Type":"NodeParagraph","Properties":{"id":"20240607094507-ka8xtxs","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 虚寒泄泻及外感风寒致嗽者，皆忌服。"}]},{"ID":"20240607094507-y91ur6f","Type":"NodeParagraph","Properties":{"id":"20240607094507-y91ur6f","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"垣衣、地黄为之使。畏曾青。\""}]},{"ID":"20240607094507-fynhn7q","Type":"NodeParagraph","Properties":{"id":"20240607094507-fynhn7q","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"贝母为使。\""}]},{"ID":"20240607094507-khtorks","Type":"NodeParagraph","Properties":{"id":"20240607094507-khtorks","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"③《本草正》：\"虚寒假热，脾肾溏泄最忌。\""}]},{"ID":"20240607094507-uq9r1oc","Type":"NodeParagraph","Properties":{"id":"20240607094507-uq9r1oc","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094507-4zq9jjy","Type":"NodeParagraph","Properties":{"id":"20240607094507-4zq9jjy","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 滋阴，润燥，清肺，降火。治阴虚发热，咳嗽吐血，肺痿，肺痈，咽喉肿痛，消渴，便秘。"}]},{"ID":"20240607094507-qxjtvcr","Type":"NodeParagraph","Properties":{"id":"20240607094507-qxjtvcr","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主诸暴风湿偏痹，强骨髓，杀三虫。\""}]},{"ID":"20240607094507-9oc95tf","Type":"NodeParagraph","Properties":{"id":"20240607094507-9oc95tf","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"保定肺气，去寒热，养肌肤，益气力，利小便，冷而能补。\""}]},{"ID":"20240607094507-b6wjun9","Type":"NodeParagraph","Properties":{"id":"20240607094507-b6wjun9","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主肺气咳逆，喘息促急，除热，通肾气，疗肺痿生痈吐脓，治湿疥，止消渴，去热中风。宜久服。\""}]},{"ID":"20240607094507-zjm63yb","Type":"NodeParagraph","Properties":{"id":"20240607094507-zjm63yb","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"④《千金方》：\"治虚劳绝伤，老年衰损羸瘦，偏枯不随，风湿不仁，冷痹，心腹积聚，恶疮，痈疽肿癞，亦治阴痿、耳聋、目暗。\""}]},{"ID":"20240607094507-glgt0tg","Type":"NodeParagraph","Properties":{"id":"20240607094507-glgt0tg","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"镇心，润五脏，益皮肤，悦颜色，补五劳七伤，治肺气并嗽，消痰、风痹热毒、游风、烦闷吐血。\""}]},{"ID":"20240607094507-7wiocbh","Type":"NodeParagraph","Properties":{"id":"20240607094507-7wiocbh","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑥王好古：\"主心病嗌干，心痛，渴而欲饮，痿蹷嗜卧，足下热痛。\""}]},{"ID":"20240607094507-t1ynn75","Type":"NodeParagraph","Properties":{"id":"20240607094507-t1ynn75","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑦《本草蒙筌》：\"能除热淋，止血溢妄行，润粪燥秘结。\""}]},{"ID":"20240607094507-gron2x0","Type":"NodeParagraph","Properties":{"id":"20240607094507-gron2x0","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"润燥滋阴，清金降火。\""}]},{"ID":"20240607094507-ymwk2xt","Type":"NodeParagraph","Properties":{"id":"20240607094507-ymwk2xt","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑨《植物名实图考》：\"拔疔毒。\""}]},{"ID":"20240607094507-5lh4rqq","Type":"NodeParagraph","Properties":{"id":"20240607094507-5lh4rqq","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094507-ebtskmq","Type":"NodeParagraph","Properties":{"id":"20240607094507-ebtskmq","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～4钱；熬膏或入丸、散。"}]},{"ID":"20240607094507-bquxn5h","Type":"NodeParagraph","Properties":{"id":"20240607094507-bquxn5h","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607094507-h21cr3x","Type":"NodeParagraph","Properties":{"id":"20240607094507-h21cr3x","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" ①治嗽：人参、天门冬（去心）、熟干地黄各等分。为细末，炼蜜为丸如樱桃大，含化服之。（《儒门事亲》三才丸）"}]},{"ID":"20240607094507-6fomh49","Type":"NodeParagraph","Properties":{"id":"20240607094507-6fomh49","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"②治吐血咯血：天门冬一两（水泡，去心），甘草（炙）、杏仁（去皮、尖，炒熟）、贝母（去心，炒）、白茯苓（去皮）、阿胶僻之，蛤粉炒成珠子）各半两。上为细末，炼蜜丸如弹子大，含化一丸咽津，日夜可十丸。（《本事方》天门冬丸）"}]},{"ID":"20240607094507-wvn7ku8","Type":"NodeParagraph","Properties":{"id":"20240607094507-wvn7ku8","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"③治妇人喘，手足烦热，骨蒸寝汗，口干引饮，面目浮肿：天门冬十两，麦门冬（去心）八两，生地黄三斤（取汁为膏）。上二味为末，膏子和丸如梧子大。每服五十丸，煎逍遥散送下。逍遥散中去甘草加人参。（《素问病机保命集》天门冬丸）"}]},{"ID":"20240607094507-xh5z0m6","Type":"NodeParagraph","Properties":{"id":"20240607094507-xh5z0m6","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"④治肺瘙咳嗽，吐涎沫，心中温温，咽燥而不渴者：生天冬捣取汁一斗，酒一斗，饴一升，紫菀四合，入铜器煎至可丸，服如杏子大一丸，日可三服。（《补缺肘后方》）"}]},{"ID":"20240607094507-50o4kxw","Type":"NodeParagraph","Properties":{"id":"20240607094507-50o4kxw","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑤治血虚肺燥，皮肤拆裂，及肺痿咳脓血证：天门冬，新掘者不拘多少，净洗，去心、皮，细捣，绞取汁澄清，以布滤去粗滓，用银锅或砂锅慢火熬成膏，每用一、二匙，空心温酒调服。（《医学正传）天门冬膏）"}]},{"ID":"20240607094507-4ud0lm0","Type":"NodeParagraph","Properties":{"id":"20240607094507-4ud0lm0","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑥治扁桃体炎、咽喉肿痛：天冬、麦冬、板蓝根、桔梗、山豆根各三钱，甘草二钱，水煎服。（《山东中草药手册》）"}]},{"ID":"20240607094507-934t6yj","Type":"NodeParagraph","Properties":{"id":"20240607094507-934t6yj","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑦治老人大肠燥结不通：天门冬八两，麦门冬、当归、麻子仁、生地黄各四两。熬膏，炼蜜收。每早晚白汤调服十茶匙。（《方氏家珍》）"}]},{"ID":"20240607094507-u705ps4","Type":"NodeParagraph","Properties":{"id":"20240607094507-u705ps4","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑧治疝气：鲜天冬五钱至一两（去皮）。水煎，点酒为引内服。（《云南中草药》）"}]},{"ID":"20240607094507-r0afpw2","Type":"NodeParagraph","Properties":{"id":"20240607094507-r0afpw2","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"⑨催乳：天冬二两。炖肉服。（《云南中草药》）"}]},{"ID":"20240607094507-kvenzs0","Type":"NodeParagraph","Properties":{"id":"20240607094507-kvenzs0","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607094507-ax2mkok","Type":"NodeParagraph","Properties":{"id":"20240607094507-ax2mkok","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" ①沧疗乳房肿瘤"}]},{"ID":"20240607094507-o36ntpz","Type":"NodeParagraph","Properties":{"id":"20240607094507-o36ntpz","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"对一般良性乳房肿瘤，尤其是乳房小叶增生，不论肿块大小，奏效迅速，大多数可获治愈。52例乳腺小叶增生和纤维腺瘤患者，治疗后30例临床痊愈，16例显效，5例有效，1例无效。对乳腺癌也有一定的近期效果，表现为用药后肿块缩小，质地变软；但远期疗效尚不显着，表现为用药一段时间后，即呈相持状态，不再有明显进展（纤维瘤亦如此），个别病例虽加大剂量，亦未见明显改善。对开始溃烂出血的乳房肿瘤和广泛转移的晚期乳癌，效果不佳。用法：每日取鲜天门冬2两，剥去外皮，隔水蒸熟，3次分服。亦可制成片剂内服、或注射剂供肌肉或静脉注射。"}]},{"ID":"20240607094507-e2ly516","Type":"NodeParagraph","Properties":{"id":"20240607094507-e2ly516","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"②用于扩张宫颈"}]},{"ID":"20240607094507-4x1izyh","Type":"NodeParagraph","Properties":{"id":"20240607094507-4x1izyh","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"于人工流产前12小时，将天门冬插入子宫颈管，能使宫颈自然扩张与软化。据84例观察，效果良好者达94％，未发现1例感染。先兆流产病例应用后，可自行发动宫缩，排出宫腔内容物；对人工流产病例则无此现象。用法：选择大小及弯度适当（长5～7厘米，直径0.3～0.6厘米）、表面光滑完整的天门冬1条，末端系一纱线，浸泡于95％酒精中，4小时后即可应用。操作时按常规消毒，扩张阴道，暴露宫颈外口，以长镊子夹住天门冬的系线端，另一端对准宫颈口徐徐插入，达子宫颈管内口。阴道内填塞纱布1块，以防天门冬脱落。约12小时即可行刮宫术。"}]},{"ID":"20240607094507-i2afpyv","Type":"NodeParagraph","Properties":{"id":"20240607094507-i2afpyv","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607094507-5jcmf7n","Type":"NodeParagraph","Properties":{"id":"20240607094507-5jcmf7n","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 同属植物羊齿天门冬（参见\"土百部\"条）、小茎叶天冬（分布云南）的块根，在少数地区亦作天门冬入药。"}]},{"ID":"20240607094507-m5oim7r","Type":"NodeParagraph","Properties":{"id":"20240607094507-m5oim7r","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094507-9i7bsoe","Type":"NodeParagraph","Properties":{"id":"20240607094507-9i7bsoe","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607094507-m1llt0x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607094507-m1llt0x","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"《中华本草》：天门冬"}]},{"ID":"20240607094507-pdpfrfi","Type":"NodeParagraph","Properties":{"id":"20240607094507-pdpfrfi","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607094507-vieyhgw","Type":"NodeParagraph","Properties":{"id":"20240607094507-vieyhgw","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" Tiān Mén Dōnɡ"}]},{"ID":"20240607094507-usaad2r","Type":"NodeParagraph","Properties":{"id":"20240607094507-usaad2r","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607094507-82rmqgt","Type":"NodeParagraph","Properties":{"id":"20240607094507-82rmqgt","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 虋冬、大当门根、天冬"}]},{"ID":"20240607094507-jnvhnfy","Type":"NodeParagraph","Properties":{"id":"20240607094507-jnvhnfy","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607094507-xmc2dv0","Type":"NodeParagraph","Properties":{"id":"20240607094507-xmc2dv0","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" Cochinchinese Asparagus Root， Root of Cochinchinese Asparagus"}]},{"ID":"20240607094507-fusx8dn","Type":"NodeParagraph","Properties":{"id":"20240607094507-fusx8dn","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607094507-vc82yf3","Type":"NodeParagraph","Properties":{"id":"20240607094507-vc82yf3","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607094507-myd6l49","Type":"NodeParagraph","Properties":{"id":"20240607094507-myd6l49","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"1.《抱朴子》：天门冬生高地，根短而味甜气香者善，其生水侧下地者，叶细似蕴而微黄，根长而味多苦，气臭者下。"}]},{"ID":"20240607094507-o5bc704","Type":"NodeParagraph","Properties":{"id":"20240607094507-o5bc704","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：天门冬，虽暴干，犹滋润难捣，必须薄切，暴于日中，或火烘之也。"}]},{"ID":"20240607094507-41t01fz","Type":"NodeParagraph","Properties":{"id":"20240607094507-41t01fz","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：天门冬、麦门冬之类，虽曰去心，但以水渍漉使周，润渗入肌，俟软，缓缓擘取，不可浸出脂液。其不知者，乃以汤浸一、二时，柔即柔矣，然气味都尽，用之不效，乃曰药"}]},{"ID":"20240607094507-okf8l83","Type":"NodeParagraph","Properties":{"id":"20240607094507-okf8l83","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607094507-eel90iu","Type":"NodeParagraph","Properties":{"id":"20240607094507-eel90iu","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 药材基源：为百合科植物天门冬的块根。"}]},{"ID":"20240607094507-bjf2ees","Type":"NodeParagraph","Properties":{"id":"20240607094507-bjf2ees","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Asparagus cochin-chinensis(Lour.) Merr.[Melanthium cochinchinensis Lour.;A.lucidus Lindl.;A.gaudihaudiamus Kunth]"}]},{"ID":"20240607094507-eba8lw2","Type":"NodeParagraph","Properties":{"id":"20240607094507-eba8lw2","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植后2-3年即可采收，割去蔓茎，挖出块根，去掉泥土，用水煮或蒸至皮裂，捞出入清水中，趁热剥去外皮，烘干或用硫黄熏蒸。"}]},{"ID":"20240607094507-9rt015c","Type":"NodeParagraph","Properties":{"id":"20240607094507-9rt015c","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607094507-d7tpjry","Type":"NodeParagraph","Properties":{"id":"20240607094507-d7tpjry","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于阴湿的山野林边、草丛或灌木丛中，也有栽培。"}]},{"ID":"20240607094507-80gp0ov","Type":"NodeParagraph","Properties":{"id":"20240607094507-80gp0ov","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、中南、西南、及河北、山西、陕西、甘肃、台湾等地。"}]},{"ID":"20240607094507-djy86so","Type":"NodeParagraph","Properties":{"id":"20240607094507-djy86so","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607094507-meis5x1","Type":"NodeParagraph","Properties":{"id":"20240607094507-meis5x1","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 天门冬，多年生攀援草本，全株无毛。块根肉质，簇生，长椭圆形或纺锤形，长4-10cm，灰黄色。茎细，长可达2m，分枝具棱或狭翅；叶状枝通常每3枚成簇，扁平，长1-3cm，宽1-2mm，先端锐尖。叶退化成鳞片，先端长尖，基部有木质倒生刺，刺在茎上长2.5-3mm，在分枝上较短或不明显。花1-3朵簇生叶腋，单性，雌雄异株，淡绿色；花梗长2-6mm；雄花花被片6，雄蕊稍短于花被，花丝不贴生于花被片上，花药卵形，长约0.7mm；雌花与雄花大小相似，具6个退化雄蕊。浆果球形，直径6-7mm，成熟时红色；具种子1颗。花期5-7月，果期8月。"}]},{"ID":"20240607094507-rgeyr4c","Type":"NodeParagraph","Properties":{"id":"20240607094507-rgeyr4c","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607094507-xxnzxp9","Type":"NodeParagraph","Properties":{"id":"20240607094507-xxnzxp9","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，不耐严寒，忌干旱及积水。宜选深厚、肥沃、富含腐殖质、排水良好的壤土或砂质壤土栽培；不宜在粘土或瘠薄土及排水不良的地方种植。"}]},{"ID":"20240607094507-ywibn1d","Type":"NodeParagraph","Properties":{"id":"20240607094507-ywibn1d","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖或分株繁殖。种子繁殖，育苗移栽法：7-8月当果实由绿色变为黄色时采收，搓去果肉，清洗干净，选籽粒大、饱满、乌润发亮的作种。春播在3-4月；秋插在8-9月，在无霜或霜期短的地区，以秋播发芽率高，生长健壮。春播种子用2-3倍湿沙贮藏过冬。播种前选荫蔽度30%树下作畦，也可搭棚遮荫。于畦面开横沟，行距17-20cm，播幅8-10cm，深3.5cm，将种子匀撒沟中，盖细土或混有草木灰的土杂肥，再盖薄草保湿。培育1-2年，在10月或春季萌芽前移栽，行株距（30-40）cm×（20-25）cm。分株繁殖，3-4月植株未萌发前，将根挖出，分成3-5簇，每簇有芽1-2个，穴栽，每穴1簇，行株距30cm×（20-25）cm，保持湿润，10-15d出苗。"}]},{"ID":"20240607094507-ethsc9x","Type":"NodeParagraph","Properties":{"id":"20240607094507-ethsc9x","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"田间管理 每年进行中耕除草3次，第1次在3-4月；第2次在6-7月，追施人畜粪水，也可适当施用硫酸铵和尿素；第3次在9-10月，施土杂肥。当蔓茎长到50cm左右时，设支架或支柱，使其缠绕，以利生长。"}]},{"ID":"20240607094507-my7mv1p","Type":"NodeParagraph","Properties":{"id":"20240607094507-my7mv1p","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"病虫防治 短须螨，5-6月为害叶部，用40%水胺硫磷1500倍液或20%双甲脒乳油1000倍液喷雾防治。"}]},{"ID":"20240607094507-7i6wp9z","Type":"NodeParagraph","Properties":{"id":"20240607094507-7i6wp9z","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607094507-mbc0l18","Type":"NodeParagraph","Properties":{"id":"20240607094507-mbc0l18","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 块根呈长纺锤形或圆柱形，稍弯曲，长4-18cm，直径0.5-2cm。表面黄白色或黄棕色，半透明，有深浅不等的纵沟及细皱纹。质坚韧或柔润，断面黄白色，角质样，有粘性，皮部宽，中柱明显。气微，味甘、微苦。"}]},{"ID":"20240607094507-spuq3kq","Type":"NodeParagraph","Properties":{"id":"20240607094507-spuq3kq","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"以肥满、致密、色黄白、半透明者为佳。"}]},{"ID":"20240607094507-k2w2894","Type":"NodeParagraph","Properties":{"id":"20240607094507-k2w2894","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"显微鉴别 块根黄切面：根被有时残存。皮层宽广，外侧有石细胞断续排列成环；粘液细胞散在，内含草酸钙针晶束，针晶长40-99μm；内皮层明显。中柱鞘为1-2列薄壁细胞 ；木质部束及韧皮部束各31-135个，相互间隔排列，少数导管深入至髓部；髓部亦散有粘液细胞。 粉末特征：灰黄色。①石细胞极多，大多单个散在，长方形、长条形、类圆形或长梭形，长85-460μm，直径32-88μm，壁厚5-37μm，纹孔细密，孔沟细而短。②草酸钙针晶散在或成束存在于粘液细胞中，针晶长40-99μm。③导管多为具缘纹孔或梯状具缘纹孔，直径18-110μm。此外有傍管薄壁细胞、纤维管胞等。 商品规格 商品按产地分为川天冬、湖天冬，并根据根条粗细分为三等。一等：块根中部直径1.2cm以上，去净外皮；表面黄白色。二等：中部直径0.8cm以上，间有未剥净硬皮但不得超过5%。三等：中部直径0.5cm以上，稍有未去净硬皮，但不得超过15%。"}]},{"ID":"20240607094507-u77z26p","Type":"NodeParagraph","Properties":{"id":"20240607094507-u77z26p","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607094507-tm82b9q","Type":"NodeParagraph","Properties":{"id":"20240607094507-tm82b9q","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 块根含甾体皂甙：天冬呋甾醇寡糖甙Asp-Ⅳ，Asp-Ⅴ、Asp-Ⅵ、Asp-Ⅶ，甲基原薯蓣皂甙（methylprotodioscin），伪原薯蓣皂甙（pseudoprotodioscin），3-O（α-L-吡喃鼠李糖基（1→4）-β-D-吡喃葡萄糖基）-26-O-（β-D-吡喃葡萄糖基）-（25R）-5，20-呋甾二烯-3β，26二醇〔3-O-α-L-rhamnopyranosyl（1→4）-β-D-GLUCOPYRANOSYL-26-O-（β-D-glucopyranosyl）-（25R）-furosta-5，20-β，26-diol〕。近又从新鲜根茎分得6个甾体皂甙，其甙元为雅姆皂甙元（yamogenin），薯蓣皂甙元（diosgenin），菝葜皂甙元（sarsasapogenin），异菝葜皂甙元（smilagenin），糖部不含木糖（xylose），只含葡萄糖（glucose）和鼠李糖（rhamnose）。又含7个寡糖（oligosaccharide）Ⅰ-Ⅶ，分别为含有葡萄糖和果糖（fructose）的三聚糖、四聚糖、五聚糖、六聚糖、八聚糖、九聚糖和十聚糖。还含葡萄糖，果糖，蔗糖（sucrose），5-甲氧基甲基糖醛（5-methoxymethyl furfural），β-谷甾醇（β-sitosterol）以及瓜氨酸（citrulline），天冬酰胺（asparagine），丝氨酸（serine），苏氨酸（threonine），脯氨酸（proline），甘氨酸（glycine），丙氨酸（alanine），缬氨酸（valine），蛋氨酸（methionine），亮氨酸（leucine），异亮氨酸（isoleucine），苯丙氨酸（phenylalanine），酷氨酸（tyrosine），天冬氨酸（aspartic acid），谷氨酸（glutamic acid），精氨酸（arginine），组氨酸（histidine），赖氨酸（lysine）等多种氨基酸。近从块根抑瘤有效部位中分离出4种多糖：天冬多糖（asparagus -polysaccharide）A、B、C、D。"}]},{"ID":"20240607094507-vcapssb","Type":"NodeParagraph","Properties":{"id":"20240607094507-vcapssb","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607094507-mp4fk81","Type":"NodeParagraph","Properties":{"id":"20240607094507-mp4fk81","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用：煎剂体外试验对炭疽杆菌、甲型及乙型溶血性链球菌、白喉杆菌、类白喉杆菌、肺炎双球菌、金黄色葡萄球菌、柠檬色葡萄球菌、白色葡萄球菌及枯草杆菌均有不同程度的抑菌作用。"}]},{"ID":"20240607094507-g66yohx","Type":"NodeParagraph","Properties":{"id":"20240607094507-g66yohx","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"2.杀灭蚊、蝇幼虫的作用：将切碎的根置水中使成0.5-1%浓度，可使其中的孑孓于72-96小时后全部死亡，2-5%浓度时，经3-4天，可使其中的蛆死亡70-100%。"}]},{"ID":"20240607094507-75jhb4h","Type":"NodeParagraph","Properties":{"id":"20240607094507-75jhb4h","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"3.抗肿瘤作用：体外试验（美蓝法及瓦氏呼吸器测定），天门冬对急件淋巴细胞型白血病、慢性粒细胞型白血病及急性单核细胞型白血病患者白细胞的脱氢酶有一定的抑制作用，并能抑制急性淋巴细胞型白血病患者白细胞的呼吸。印度产同属植物Asparagusracemosus中所含皂甙，对动物子宫有抗催产素的作用。"}]},{"ID":"20240607094507-1ythrnf","Type":"NodeParagraph","Properties":{"id":"20240607094507-1ythrnf","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"4.镇咳去痰作用：经动物试验有镇咳和去痰作用。"}]},{"ID":"20240607094507-qa8de2k","Type":"NodeParagraph","Properties":{"id":"20240607094507-qa8de2k","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607094507-9f4ytk1","Type":"NodeParagraph","Properties":{"id":"20240607094507-9f4ytk1","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 拣去杂质，水洗净，闷润至内外湿度均匀，切段、干燥。"}]},{"ID":"20240607094507-jpkz884","Type":"NodeParagraph","Properties":{"id":"20240607094507-jpkz884","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607094507-m74c7l1","Type":"NodeParagraph","Properties":{"id":"20240607094507-m74c7l1","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 肺；肾经"}]},{"ID":"20240607094507-f7yekku","Type":"NodeParagraph","Properties":{"id":"20240607094507-f7yekku","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607094507-13w53ks","Type":"NodeParagraph","Properties":{"id":"20240607094507-13w53ks","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 味甘；苦；性寒"}]},{"ID":"20240607094507-m9cnge4","Type":"NodeParagraph","Properties":{"id":"20240607094507-m9cnge4","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607094507-ev4lywr","Type":"NodeParagraph","Properties":{"id":"20240607094507-ev4lywr","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 虚寒泄泻及风寒咳嗽者禁服。《本草正》：虚寒假热，脾肾溏泄最忌。"}]},{"ID":"20240607094507-bv9om34","Type":"NodeParagraph","Properties":{"id":"20240607094507-bv9om34","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607094507-aspz76f","Type":"NodeParagraph","Properties":{"id":"20240607094507-aspz76f","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 滋阴润燥；清肺降火。主燥热咳嗽；阴虚劳嗽；热病伤阴；内热消渴；肠燥便秘；咽喉肿痛"}]},{"ID":"20240607094507-ib0q7xe","Type":"NodeParagraph","Properties":{"id":"20240607094507-ib0q7xe","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607094507-8vpy6vu","Type":"NodeParagraph","Properties":{"id":"20240607094507-8vpy6vu","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；熬膏,或入丸、散。外用：适量，鲜品捣敷或捣烂绞汁涂。"}]},{"ID":"20240607094507-2080ckp","Type":"NodeParagraph","Properties":{"id":"20240607094507-2080ckp","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607094507-0i3ko5z","Type":"NodeParagraph","Properties":{"id":"20240607094507-0i3ko5z","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：天门冬，治肺热之功为多，其味苦，但专泄而不专收，寒多人禁服。"}]},{"ID":"20240607094507-m8yc4w2","Type":"NodeParagraph","Properties":{"id":"20240607094507-m8yc4w2","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"2.《本草蒙筌》：天、麦门冬，并入手太阴经，而能祛烦解渴，止咳消痰，功用似同，实亦有偏胜也。麦门冬兼行手少阴心，每每清心降火，使肺不犯于贼邪，故止咳立效；天门冬复走足少阴肾，屡屡滋肾助元，令肺得全其母气，故消痰殊功。盖痰系津液凝成，肾司津液者也，燥盛则凝，润多则化，天门冬润剂，且复走肾经，津液纵凝，亦能化解。麦门冬虽药剂滋润则一，奈经络兼行相殊，故上而止咳不胜于麦门冬，下而消痰必让于天门冬尔。先哲亦曰，痰之标在脾，痰之本在肾。又曰，半夏惟能治痰之标，不能治痰之本。以是观之，则天门冬惟能治痰之本，不能治痰之标，非但与麦门冬殊，亦与半夏异也。"}]},{"ID":"20240607094507-6f3m53j","Type":"NodeParagraph","Properties":{"id":"20240607094507-6f3m53j","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：天门冬，润燥滋阴，降火清肺之药也。统理肺肾火燥为病，如肺热叶焦，发为痿痈，吐血咳嗽，烦渴传为肾消，骨蒸热劳诸证，在所必需者也。前人有谓除偏痹、强骨髓者，因肺热成痿，肾热髓枯，筋槁不荣而成偏痹者也。天门冬阴润寒补，使燥者润，热者清，则骨髓坚强，偏痹可利矣。然必以元虚热胜者宜之。"}]},{"ID":"20240607094507-oqtfvpg","Type":"NodeParagraph","Properties":{"id":"20240607094507-oqtfvpg","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"4.《长沙药解》：天冬清金化水，止渴生津，消咽喉肿痛，除咳吐脓血。《伤寒》麻黄升麻汤用之，治厥阴伤寒，大下之后，咽喉不利，吐脓血、泄泻不止者，以其清火逆而利咽喉，疗肺痈而排脓血也。天冬润泽寒凉，清金化水之力，十倍麦冬，土燥水枯者甚为相宜。阳明伤寒之家，燥土贼水，肠胃焦涸；瘟疫斑疹之家，营热内郁，脏腑燔蒸；凡此闭涩不开，必用承气，方其燥结未甚，以之清金泄热，滋水滑肠，本元莫损，胜服大黄。又或疮疡热盛，大便秘塞，重剂酒煎，热饮亦良。其性寒滑湿濡，最败脾胃而泄大肠，阳亏阴旺，土湿便滑者宜切忌之。其有水亏宜饵者，亦必制以渗利之味，防其助湿。"}]},{"ID":"20240607094507-y57y3wz","Type":"NodeParagraph","Properties":{"id":"20240607094507-y57y3wz","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"5.《本草正义》：天门冬肥厚多脂，《本经》虽曰苦平，其实甚甘，气薄味厚，纯以柔润养液为功，《本经》主暴风，盖指液枯内动之风而言，滋润益阴，则风阳自息，此即治风先治血之义。痹亦血不养筋之病，正与风燥相因而至，故治风者亦能治痹，非以祛外来之风痹。惟湿为阴寒之邪，痹病固亦有因于湿者，然必无甘寒阴药，可治湿痹之理，盖传写者误衍之，天冬柔润，岂可以疗阴霾之湿邪痹着？《本经》又曰强骨髓，则固益液滋阴之正旨，三虫伏尸，即血枯液燥之劳瘵，甘寒清润，原以滋燥泽枯，是以治之。《别录》谓保定肺气，则以肺热叶焦、燥金受灼而言，甘寒润燥，本是补肺正将。去寒热，亦阴液耗之乍寒乍热，非外感邪甚之寒热可知。养肌肤，益气力，皆阴液充足之义。利小便者，肺金肃降，而水道之上源自清，亦津液霶霈，而膀胱之气化自旺，固非为湿热互阻之水道不利言也。而结之以冷而能补一句，则可知天冬偏于寒冷，惟燥火炽盛，灼烁阴液者宜之，而阳气式微者，即有不胜其任之意。此《别录》所以有大寒二字，而六朝以来诸家《本草》，固无一非以治燥火之症也。甄权谓治肺气咳逆，喘息促急，则以肺金枯燥，气促不舒而言，故宜此甘寒柔润以滋养之，则气逆可平，喘息可定，即《名医别录》保定肺气之意。张洁古亦谓治血热侵肺，上气喘促，皆为虚症一边着想，而浊痰窒塞之喘促咳逆，必非其治。甄权又谓治肺痿、生痈、吐脓，除热，则痿即肺热叶焦，甘寒润之宜也，而痈则痰火俱盛，咯吐脓血，只可苦寒清泄，断不宜此柔润多脂之药，一虚一实，大有径庭，连类及之，不无误会，而洁古因此遂有苦以泄滞血一语，实与此药性情不符，不可不辨。唯在肺痈欲愈，脓痰已减之时，浊垢既去，正气已伤，余焰尚盛，则天冬大寒，能泄余热，味清而不甚腻厚，庶几近之。此病情有始传末传之分，邪势有轻重缓急之辨，必不可浑而言之，漫无区别。王海藏谓治痿厥嗜卧，足下热而痛，是即肺热成萎，阴虚多火之侯，孙真人亦谓阳事不起，宜常服之，正以阴精消烁，废而不用，故宜益阴以滋其燥。"}]},{"ID":"20240607094507-pokf3gh","Type":"NodeParagraph","Properties":{"id":"20240607094507-pokf3gh","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"6.《本经》：主诸暴风湿偏痹，强骨髓，杀三虫。"}]},{"ID":"20240607094507-a7ifnol","Type":"NodeParagraph","Properties":{"id":"20240607094507-a7ifnol","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"7.《别录》：保定肺气，去寒热，养肌肤，益气力，利小便，冷而能补。"}]},{"ID":"20240607094507-xkh7hop","Type":"NodeParagraph","Properties":{"id":"20240607094507-xkh7hop","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：主肺气咳逆，喘息促急，除热，通肾气，疗肺痿生痈吐脓，治湿疥，止消渴，去热中风，宜久服。"}]},{"ID":"20240607094507-fia7r90","Type":"NodeParagraph","Properties":{"id":"20240607094507-fia7r90","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"9.《千金方》：治虚劳绝伤，老年衰损赢瘦，偏枯不随，风湿不仁，冷痹，心腹积聚，恶疮，痈疽肿癞，亦治阴痿、耳聋、目暗。"}]},{"ID":"20240607094507-oo2mlma","Type":"NodeParagraph","Properties":{"id":"20240607094507-oo2mlma","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"10.《日华子本草》：镇心，润五脏，益皮肤，悦颜色，补五劳七伤，治肺气并嗽，消痰、风痹热毒、游风、烦闷吐血。"}]},{"ID":"20240607094507-4cnmtan","Type":"NodeParagraph","Properties":{"id":"20240607094507-4cnmtan","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"11.王好古：主心病嗌干，心痛，渴而欲饮，痿蹶嗜卧，足下热痛。"}]},{"ID":"20240607094507-4xuj3nw","Type":"NodeParagraph","Properties":{"id":"20240607094507-4xuj3nw","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"12.《本草蒙筌》：能除热淋，止血溢妄行，润粪燥秘结。"}]},{"ID":"20240607094507-nr0tal4","Type":"NodeParagraph","Properties":{"id":"20240607094507-nr0tal4","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"13.《纲目》：润燥滋阴，清金降火。"}]},{"ID":"20240607094507-2mb5nve","Type":"NodeParagraph","Properties":{"id":"20240607094507-2mb5nve","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"14.《植物名实图考》：拔疔毒。"}]},{"ID":"20240607094507-1cfp2qh","Type":"NodeParagraph","Properties":{"id":"20240607094507-1cfp2qh","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607094507-asfz9lq","Type":"NodeParagraph","Properties":{"id":"20240607094507-asfz9lq","updated":"20240607094507"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607094509-kimx8lp","Type":"NodeThematicBreak","Properties":{"id":"20240607094509-kimx8lp"}},{"ID":"20240607094510-kd3tx7l","Type":"NodeParagraph","Properties":{"id":"20240607094510-kd3tx7l"}}]}