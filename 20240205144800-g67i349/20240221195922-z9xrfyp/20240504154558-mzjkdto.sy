px;\" parent-style=\"width: 654px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 587px;","style":"width: 577px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 15-20240805140735-jq8b1tb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 577px;\" parent-style=\"width: 587px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805135531-tjtb1a1","Type":"NodeParagraph","Properties":{"id":"20240805135531-tjtb1a1","updated":"20240805135543"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 580px;","style":"width: 570px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 9-20240805135014-t2wormi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 570px;\" parent-style=\"width: 580px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 628px;","style":"width: 618px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 3-20240805130713-bpmwz7h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 618px;\" parent-style=\"width: 628px;\"}"},{"Type":"NodeText","Data":"​​​​​"}]},{"ID":"20240805130635-o0frnu7","Type":"NodeParagraph","Properties":{"id":"20240805130635-o0frnu7","updated":"20240805135412"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 572px;","style":"width: 562px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 2-20240805130635-crjxr9g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 562px;\" parent-style=\"width: 572px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 672px;","style":"width: 662px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 10-20240805135114-qw3r9og.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 662px;\" parent-style=\"width: 672px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805131015-4g0vqyo","Type":"NodeParagraph","Properties":{"id":"20240805131015-4g0vqyo","updated":"20240805141547"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 675px;","style":"width: 665px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (17)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 17-20240805141547-iwnxjmb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 665px;\" parent-style=\"width: 675px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英 13-20240805135755-pghsdrh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805135139-sa3q471","Type":"NodeParagraph","Properties":{"id":"20240805135139-sa3q471","updated":"20240805135139"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 628px;","style":"width: 618px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英-20240619170658-m5zwrbe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 618px;\" parent-style=\"width: 628px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616110256-rfzsa3c","Type":"NodeThematicBreak","Properties":{"id":"20240616110256-rfzsa3c"}},{"ID":"20240616110310-9mt8okr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110310-9mt8okr","updated":"20240616110323"},"Children":[{"Type":"NodeText","Data":"白英《神农本草经》"}]},{"ID":"20240616110310-uigcoh1","Type":"NodeParagraph","Properties":{"id":"20240616110310-uigcoh1","updated":"20240616110310"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240616110310-yxy5wao","Type":"NodeParagraph","Properties":{"id":"20240616110310-yxy5wao","updated":"20240616110310"},"Children":[{"Type":"NodeText","Data":"主寒热，八疽，消渴，补中益气。久服，轻身延年。一名谷菜（元本误作黑字），生山谷。"}]},{"ID":"20240616110310-1uqanfk","Type":"NodeParagraph","Properties":{"id":"20240616110310-1uqanfk","updated":"20240616110310"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名白草，生益州，春采叶，夏采茎，秋采花，冬采根。"}]},{"ID":"20240616110310-ekfs0dw","Type":"NodeParagraph","Properties":{"id":"20240616110310-ekfs0dw","updated":"20240616110310"},"Children":[{"Type":"NodeText","Data":"案《尔雅》云：苻，鬼目；郭璞云：今江东有鬼目草茎似葛，叶圆而毛，子如耳珰也，赤色丛生，《唐本》注；白英云，此鬼目草也。"}]},{"ID":"20240616110328-to9ivn2","Type":"NodeThematicBreak","Properties":{"id":"20240616110328-to9ivn2"}},{"ID":"20240616110329-vlljrki","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110329-vlljrki","updated":"20240616110335"},"Children":[{"Type":"NodeText","Data":"白英《神农本草经赞》"}]},{"ID":"20240616110329-ej9yvpx","Type":"NodeParagraph","Properties":{"id":"20240616110329-ej9yvpx","updated":"20240616110329"},"Children":[{"Type":"NodeText","Data":"味甘寒。主寒热入疸。消渴补中益气。久服轻身延年。一名谷菜。生山谷。"}]},{"ID":"20240616110329-xxcq78c","Type":"NodeParagraph","Properties":{"id":"20240616110329-xxcq78c","updated":"20240616110329"},"Children":[{"Type":"NodeText","Data":"白幕排风。五丫蔓绕。叶展春妍。茎繁夏懊。花粲秋高。根蟠冬杪。杂缀珠。赤光目了。"}]},{"ID":"20240616110329-yjmaoko","Type":"NodeParagraph","Properties":{"id":"20240616110329-yjmaoko","updated":"20240616110329"},"Children":[{"Type":"NodeText","Data":"陈藏器曰。一名白幕。李时珍曰。俗名排风子。言其功用。苏恭曰。蔓生叶长而五丫。"}]},{"ID":"20240616110329-2bnxhdq","Type":"NodeParagraph","Properties":{"id":"20240616110329-2bnxhdq","updated":"20240616110329"},"Children":[{"Type":"NodeText","Data":"名医曰。春采叶。夏采茎。秋采花。冬采实。裴澄诗。映林初展叶。白居易诗。春妍景丽草树光。"}]},{"ID":"20240616110329-ikveuza","Type":"NodeParagraph","Properties":{"id":"20240616110329-ikveuza","updated":"20240616110329"},"Children":[{"Type":"NodeText","Data":"张协赋。繁茎密。谢灵运赋。夏凉寒燠。沈约诗。闲幌望高秋。蔡诗。乃复见冬杪。郭璞曰。子赤色如耳珠。苏恭曰。一名鬼目草。韩驹诗。但存双目了。"}]},{"ID":"20240616110404-8r56on3","Type":"NodeThematicBreak","Properties":{"id":"20240616110404-8r56on3"}},{"ID":"20240616110405-hgmbk99","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110405-hgmbk99","updated":"20240616110410"},"Children":[{"Type":"NodeText","Data":"白英《医学入门》"}]},{"ID":"20240616110405-ia791my","Type":"NodeParagraph","Properties":{"id":"20240616110405-ia791my","updated":"20240616110405"},"Children":[{"Type":"NodeText","Data":"生山谷，似葛叶有毛，实如龙葵子，一名白草。春采叶，夏采茎，秋采花，冬采根用。味甘，寒。"}]},{"ID":"20240616110405-mj6zkpu","Type":"NodeParagraph","Properties":{"id":"20240616110405-mj6zkpu","updated":"20240616110405"},"Children":[{"Type":"NodeText","Data":"无毒。主寒热八疸消渴，补中益气，故作羹饮，甚疗劳。夏月煮粥食，极解热毒。又主烦热风疹丹毒疟瘴寒热，小儿结热，煮汁饮之。"}]},{"ID":"20240616110352-a5a7772","Type":"NodeThematicBreak","Properties":{"id":"20240616110352-a5a7772"}},{"ID":"20240616110354-rqem4ye","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110354-rqem4ye","updated":"20240616110400"},"Children":[{"Type":"NodeText","Data":"白英《名医别录》"}]},{"ID":"20240616110354-tyo44cg","Type":"NodeParagraph","Properties":{"id":"20240616110354-tyo44cg","updated":"20240616110354"},"Children":[{"Type":"NodeText","Data":"无毒．一名白草．生益州．春采叶，夏采茎，秋采花，冬采根．"}]},{"ID":"20240616110354-ked5lzd","Type":"NodeParagraph","Properties":{"id":"20240616110354-ked5lzd","updated":"20240616110354"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶白英，味甘，寒．主寒热八疸消渴，补中益气．久服轻身延年．一名谷菜．"}]},{"ID":"20240616110340-6ki4ghg","Type":"NodeThematicBreak","Properties":{"id":"20240616110340-6ki4ghg"}},{"ID":"20240616110342-qvcjy1y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110342-qvcjy1y","updated":"20240616110347"},"Children":[{"Type":"NodeText","Data":"白英《新修本草》"}]},{"ID":"20240616110342-8tyzs28","Type":"NodeParagraph","Properties":{"id":"20240616110342-8tyzs28","updated":"20240616110342"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主寒热，八疸，消渴，补中益气。久服轻身延年。一名谷菜，一名白草。生益州山谷。春采叶，夏采茎，秋采花，冬采根。"}]},{"ID":"20240616110342-5y9ai46","Type":"NodeParagraph","Properties":{"id":"20240616110342-5y9ai46","updated":"20240616110342"},"Children":[{"Type":"NodeText","Data":"诸方药不用。此乃有斛菜，生水中，人蒸食之。此乃生山谷，当非是。又有白草，叶作羹饮，甚疗劳，而不用根华。"}]},{"ID":"20240616110342-70yqbo2","Type":"NodeParagraph","Properties":{"id":"20240616110342-70yqbo2","updated":"20240616110342"},"Children":[{"Type":"NodeText","Data":"益州乃有苦菜，土人专食之，皆充健无病，疑或者此。"}]},{"ID":"20240616110342-yxt7tie","Type":"NodeParagraph","Properties":{"id":"20240616110342-yxt7tie","updated":"20240616110342"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此瓜，小长而五丫。实圆，若龙葵子，生青，熟紫黑，煮汁饮，解劳。东人谓之白草。陶云白草，似识之，而不的辨。"}]},{"ID":"20240616110256-4bcyalw","Type":"NodeThematicBreak","Properties":{"id":"20240616110256-4bcyalw"}},{"ID":"20240616110258-3kxyr1h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110258-3kxyr1h","updated":"20240616110304"},"Children":[{"Type":"NodeText","Data":"白英《本草经集注》"}]},{"ID":"20240616110258-hae4ank","Type":"NodeParagraph","Properties":{"id":"20240616110258-hae4ank","updated":"20240616110258"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主治寒热，八疸，消渴，补中益气。久服轻身，延年，一名谷菜，一名白草。生益州山谷。春采叶，夏采茎，秋采花，冬采根。"}]},{"ID":"20240616110258-g9q9eag","Type":"NodeParagraph","Properties":{"id":"20240616110258-g9q9eag","updated":"20240616110258"},"Children":[{"Type":"NodeText","Data":"诸方药不用。此乃有 菜，生水中，人蒸食之。此乃生山谷，当非是。又有白草，叶作羹饮，甚治劳，而不用根、花。益州乃有苦菜，土人专食之，皆充健无病，疑或者此。"}]},{"ID":"20240616110236-mnumawb","Type":"NodeThematicBreak","Properties":{"id":"20240616110236-mnumawb"}},{"ID":"20240616110248-t6hc4yn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110248-t6hc4yn","updated":"20240616110251"},"Children":[{"Type":"NodeText","Data":"白英《千金翼方》"}]},{"ID":"20240616110248-rckoyoe","Type":"NodeParagraph","Properties":{"id":"20240616110248-rckoyoe","updated":"20240616110248"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主寒热，八疸，消渴，补中益气。久服轻身延年。一名谷菜，一名白草。生益州山谷，春采叶，夏采茎，秋采花，冬采根。"}]},{"ID":"20240616110236-u0iaqi2","Type":"NodeThematicBreak","Properties":{"id":"20240616110236-u0iaqi2"}},{"ID":"20240616110237-bpnjkj5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110237-bpnjkj5","updated":"20240616110243"},"Children":[{"Type":"NodeText","Data":"白英《本草纲目》"}]},{"ID":"20240616110237-lz28vhr","Type":"NodeParagraph","Properties":{"id":"20240616110237-lz28vhr","updated":"20240616110237"},"Children":[{"Type":"NodeText","Data":"「释名」谷菜、白草、白幕、排风，子名鬼目。"}]},{"ID":"20240616110237-q3cshs2","Type":"NodeParagraph","Properties":{"id":"20240616110237-q3cshs2","updated":"20240616110237"},"Children":[{"Type":"NodeText","Data":"「气味」（根、苗）甘、寒、无毒。"}]},{"ID":"20240616110237-l2l3d8i","Type":"NodeParagraph","Properties":{"id":"20240616110237-l2l3d8i","updated":"20240616110237"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240616110237-tw88f6h","Type":"NodeParagraph","Properties":{"id":"20240616110237-tw88f6h","updated":"20240616110237"},"Children":[{"Type":"NodeText","Data":"1、风疹、丹毒、瘴疟。用白英煮汁饮服。"}]},{"ID":"20240616110237-2ztivnd","Type":"NodeParagraph","Properties":{"id":"20240616110237-2ztivnd","updated":"20240616110237"},"Children":[{"Type":"NodeText","Data":"2、目赤头眩（风热上攻，眼花面肿）。用白英子（鬼目）（焙）、甘草（炙）、菊花（焙）各一两，共研为末。每服二钱，临醒时温水送下。"}]},{"ID":"20240616110143-i9yvstw","Type":"NodeThematicBreak","Properties":{"id":"20240616110143-i9yvstw"}},{"ID":"20240616110145-av6hedl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616110145-av6hedl","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"白英《中药学》"}]},{"ID":"20240616110145-caxechq","Type":"NodeParagraph","Properties":{"id":"20240616110145-caxechq","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"【药用】本品为茄科植物白英的全草。"}]},{"ID":"20240616110145-39am16s","Type":"NodeParagraph","Properties":{"id":"20240616110145-39am16s","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，微寒。入肝、胃经。"}]},{"ID":"20240616110145-7lutn5q","Type":"NodeParagraph","Properties":{"id":"20240616110145-7lutn5q","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"【功效】清热解毒，利尿，祛风湿。"}]},{"ID":"20240616110145-yfjmqyj","Type":"NodeParagraph","Properties":{"id":"20240616110145-yfjmqyj","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于感冒发热，乳痈、恶疮等症。"}]},{"ID":"20240616110145-rym8uub","Type":"NodeParagraph","Properties":{"id":"20240616110145-rym8uub","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"白英味苦微寒，功能清热解毒，用治感冒发热、乳痈等，可配合蒲公英、银花、一见喜等药同用。"}]},{"ID":"20240616110145-vz4ohyv","Type":"NodeParagraph","Properties":{"id":"20240616110145-vz4ohyv","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"2.用于湿热黄疸、腹水等症。"}]},{"ID":"20240616110145-zln87pv","Type":"NodeParagraph","Properties":{"id":"20240616110145-zln87pv","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"白英有利尿作用，治疗湿热黄疸或腹水肿痛、小便不利者，可配合金钱草、茵陈等药同用，使水湿之邪从小便排泄。"}]},{"ID":"20240616110145-r9tzdja","Type":"NodeParagraph","Properties":{"id":"20240616110145-r9tzdja","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"3.用于风湿痹痛。"}]},{"ID":"20240616110145-eke1uis","Type":"NodeParagraph","Properties":{"id":"20240616110145-eke1uis","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"白英有祛风湿作用，用于风湿痹痛，可与秦艽、枪活、独活等药同用。"}]},{"ID":"20240616110145-5rl3tnj","Type":"NodeParagraph","Properties":{"id":"20240616110145-5rl3tnj","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"近年来用本品配伍蛇莓、龙葵、白花蛇舌草等药，用于肺癌以及胃肠道癌肿等症。"}]},{"ID":"20240616110145-6yubnvs","Type":"NodeParagraph","Properties":{"id":"20240616110145-6yubnvs","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"【处方用名】白英、蜀洋泉（洗净，晒干，切碎用）"}]},{"ID":"20240616110145-b4q5kdm","Type":"NodeParagraph","Properties":{"id":"20240616110145-b4q5kdm","updated":"20240616110145"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，大剂量可用一两至二两，煎服。"}]},{"ID":"20240607111353-9ay86om","Type":"NodeThematicBreak","Properties":{"id":"20240607111353-9ay86om"}},{"ID":"20240607111354-m2ks33w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607111354-m2ks33w","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"白英"}]},{"ID":"20240607111354-8tbapec","Type":"NodeParagraph","Properties":{"id":"20240607111354-8tbapec","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607111354-gbdxpoi","Type":"NodeParagraph","Properties":{"id":"20240607111354-gbdxpoi","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" Bái Yīnɡ"}]},{"ID":"20240607111354-g1gwxsh","Type":"NodeParagraph","Properties":{"id":"20240607111354-g1gwxsh","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607111354-sdmaspj","Type":"NodeParagraph","Properties":{"id":"20240607111354-sdmaspj","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 白毛藤、白草、毛千里光、毛风藤、排风藤、毛秀才、葫芦草、金线绿毛龟"}]},{"ID":"20240607111354-n8g6vwi","Type":"NodeParagraph","Properties":{"id":"20240607111354-n8g6vwi","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607111354-subgafu","Type":"NodeParagraph","Properties":{"id":"20240607111354-subgafu","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 本品为茄科茄属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白英"},{"Type":"NodeText","Data":"Solanum lyratum Thunb. [S. dulcamara L. var. lyratum （Thunb.） Sieb. et Zucc., S. Dulcamara L. var. pubescens Blume, S.Dulcamara L. var. chinense Dunal]，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"入药。夏秋采收。洗净，晒干或鲜用。"}]},{"ID":"20240607111354-h4lulvx","Type":"NodeParagraph","Properties":{"id":"20240607111354-h4lulvx","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607111354-1x8va6e","Type":"NodeParagraph","Properties":{"id":"20240607111354-1x8va6e","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 入肝、胃经。"}]},{"ID":"20240607111354-2ttlk76","Type":"NodeParagraph","Properties":{"id":"20240607111354-2ttlk76","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607111354-ragp64j","Type":"NodeParagraph","Properties":{"id":"20240607111354-ragp64j","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 苦，微寒。有小毒。"}]},{"ID":"20240607111354-ligl2vh","Type":"NodeParagraph","Properties":{"id":"20240607111354-ligl2vh","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607111354-c9c984k","Type":"NodeParagraph","Properties":{"id":"20240607111354-c9c984k","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 清热解毒，利湿消肿，抗癌。全草：用于感冒发热，乳痈、恶疮，湿热黄疸、腹水，白带，肾炎水肿；外用治痈疖肿毒。根：风湿痹痛。"}]},{"ID":"20240607111354-n9hb6f3","Type":"NodeParagraph","Properties":{"id":"20240607111354-n9hb6f3","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607111354-k579vyr","Type":"NodeParagraph","Properties":{"id":"20240607111354-k579vyr","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 0.5～1两；外用适量，鲜全草捣烂敷患处。"}]},{"ID":"20240607111354-0c4sjg2","Type":"NodeParagraph","Properties":{"id":"20240607111354-0c4sjg2","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607111354-xwbafos","Type":"NodeParagraph","Properties":{"id":"20240607111354-xwbafos","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" （1）用治感冒发热、乳痈等，可配合蒲公英、银花、一见喜等药同用。治疗湿热黄疸或腹水肿痛、小便不利者，可配合金钱草、茵陈等药同用，使水湿之邪从小便排泄。用于风湿痹痛，可与秦艽、枪活、独活等药同用。本品配伍蛇莓、龙葵、白花蛇舌草等药，用于肺癌以及胃肠道癌肿等症。"}]},{"ID":"20240607111354-lm6hu9i","Type":"NodeParagraph","Properties":{"id":"20240607111354-lm6hu9i","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607111354-qs0paij","Type":"NodeParagraph","Properties":{"id":"20240607111354-qs0paij","updated":"20240607111354"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607111355-y7q34mn","Type":"NodeThematicBreak","Properties":{"id":"20240607111355-y7q34mn"}}]}