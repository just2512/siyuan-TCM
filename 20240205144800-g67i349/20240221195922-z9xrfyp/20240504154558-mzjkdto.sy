{"ID":"20240504154558-mzjkdto","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504154558-mzjkdto","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504154558-mzjkdto\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240618165331-lo5wadw\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607111355-y7q34mn\u0026quot;,\u0026quot;scrollTop\u0026quot;:2900,\u0026quot;focusId\u0026quot;:\u0026quot;20240618165703-wbk327s\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"044白英","type":"doc","updated":"20240805141547"},"Children":[{"ID":"20240618165331-lo5wadw","Type":"NodeParagraph","Properties":{"id":"20240618165331-lo5wadw","updated":"20240805140939"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240618165331-l56aleu.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240805135134-0v6x2fd","Type":"NodeParagraph","Properties":{"id":"20240805135134-0v6x2fd","updated":"20240805141005"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 560px;","style":"width: 550px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白英-20240805130459-hfzpo0e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 550px;\" parent-style=\"width: 560px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 568px;","style":"width: 558px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白英 (8)"},{"Type":"NodeClose