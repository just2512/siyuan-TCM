ed":"20240717140249"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 617px;","style":"width: 607px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 6-20240717140209-bbd688q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 607px;\" parent-style=\"width: 617px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 623px;","style":"width: 613px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 7-20240717140240-f63wirf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 613px;\" parent-style=\"width: 623px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717135828-oq5ynce","Type":"NodeParagraph","Properties":{"id":"20240717135828-oq5ynce","updated":"20240717140656"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 652px;","style":"width: 642px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 3-20240717135844-ezo8s5r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 642px;\" parent-style=\"width: 652px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 316px;","style":"width: 306px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 2-20240717135828-srr790w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 306px;\" parent-style=\"width: 316px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 248px;","style":"width: 238px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 10-20240717140656-wxuitg8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 238px;\" parent-style=\"width: 248px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807181224-1si448u","Type":"NodeParagraph","Properties":{"id":"20240807181224-1si448u","updated":"20240807181305"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 594px;","style":"width: 584px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 1-20240807181305-gx4pbmg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 584px;\" parent-style=\"width: 594px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 597px;","style":"width: 587px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若-20240807181217-6q0rm3c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 587px;\" parent-style=\"width: 597px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717140056-s7crqsh","Type":"NodeParagraph","Properties":{"id":"20240717140056-s7crqsh","updated":"20240717140420"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 5-20240717140056-k7hek64.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 843px;","style":"width: 833px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若 8-20240717140420-ogm9h2z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 833px;\" parent-style=\"width: 843px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616171435-blo96qn","Type":"NodeThematicBreak","Properties":{"id":"20240616171435-blo96qn"}},{"ID":"20240616171536-9v9zyyz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171536-9v9zyyz","updated":"20240616171541"},"Children":[{"Type":"NodeText","Data":"杜若《神农本草经》"}]},{"ID":"20240616171536-5zmh8cc","Type":"NodeParagraph","Properties":{"id":"20240616171536-5zmh8cc","updated":"20240616171536"},"Children":[{"Type":"NodeText","Data":"味辛微温。"}]},{"ID":"20240616171536-0clsvhk","Type":"NodeParagraph","Properties":{"id":"20240616171536-0clsvhk","updated":"20240616171536"},"Children":[{"Type":"NodeText","Data":"主胸胁下逆气，温中，风入脑户，头肿痛，多涕泪出。"}]},{"ID":"20240616171536-b4n2jg9","Type":"NodeParagraph","Properties":{"id":"20240616171536-b4n2jg9","updated":"20240616171536"},"Children":[{"Type":"NodeText","Data":"久服，益精（艺文类聚引作益气），明目轻身。一名杜衡（艺文类聚引作蘅，非）。生川泽。"}]},{"ID":"20240616171536-l641jw7","Type":"NodeParagraph","Properties":{"id":"20240616171536-l641jw7","updated":"20240616171536"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名杜连，一名白连，一名白苓，一名若芝，生武陵及冤句，二月八月采根，暴干。"}]},{"ID":"20240616171536-p4y9q55","Type":"NodeParagraph","Properties":{"id":"20240616171536-p4y9q55","updated":"20240616171536"},"Children":[{"Type":"NodeText","Data":"案《说文》云：若，杜若，香草；《广雅》云：楚蘅，杜蘅也；《西山经》云：天帝之上有草焉，其状如葵，其臭如蘼芜，名曰杜蘅；《尔雅》云：杜，土卤；郭璞云：杜蘅也，似葵而香；《楚词》云：采芳州兮杜若；《范子计然》云：杜若生南郡汉中又云秦蘅，出于陇西天水；沈括补笔谈云：杜若，即今之高良姜，后人不识，又别出高良姜条，按经云一名杜蘅，是《名医》别出杜蘅条，非也，衡正字，俗加草。"}]},{"ID":"20240616171435-vvem402","Type":"NodeThematicBreak","Properties":{"id":"20240616171435-vvem402"}},{"ID":"20240616171524-shg3r4u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171524-shg3r4u","updated":"20240616171529"},"Children":[{"Type":"NodeText","Data":"杜若《神农本草经赞》"}]},{"ID":"20240616171524-xhzlj3z","Type":"NodeParagraph","Properties":{"id":"20240616171524-xhzlj3z","updated":"20240616171524"},"Children":[{"Type":"NodeText","Data":"味辛微温。主胸隔。下逆气。温中。风入脑户。头痛多涕泪出。久服益精。明目轻身。一名杜衡。生川泽。"}]},{"ID":"20240616171524-rfjsopb","Type":"NodeParagraph","Properties":{"id":"20240616171524-rfjsopb","updated":"20240616171524"},"Children":[{"Type":"NodeText","Data":"葵状蘼馨。烟霏露。幽崇冈。素英绿叶。香逐马蹄。形猜鸭。悦茂兹荣。金芝邻接。"}]},{"ID":"20240616171524-dpftnnc","Type":"NodeParagraph","Properties":{"id":"20240616171524-dpftnnc","updated":"20240616171524"},"Children":[{"Type":"NodeText","Data":"山海经。天帝之山有草焉。状如葵。臭如蘼芜。名曰杜衡。杜甫诗。露思藤架。烟霏想柱丛。嵇康序。仰眺崇冈。俯察幽。刘圻父诗。素英绿叶纷可喜。尔雅疏。杜土卤形如马蹄。俗呼马蹄香。雷论。鸭蹀草根相似。味效不同。谢赋。览兹荣之茂悦。厕金芝于芳丛。名医曰。一名若芝。杜甫诗。邻接意如何。"}]},{"ID":"20240616171621-5b9bttr","Type":"NodeThematicBreak","Properties":{"id":"20240616171621-5b9bttr"}},{"ID":"20240616171622-qm3kmu0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171622-qm3kmu0","updated":"20240616171626"},"Children":[{"Type":"NodeText","Data":"杜若《新修本草》"}]},{"ID":"20240616171622-g8tx0ds","Type":"NodeParagraph","Properties":{"id":"20240616171622-g8tx0ds","updated":"20240616171622"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主胸胁下逆气，温中，风入脑户，头肿痛，多涕，泪出。眩倒目，止痛，除口臭气。久服益精明目，轻身，令人不忘。一名杜衡，一名杜莲，一名白莲，一名白芩，一名若芝。生武陵川泽及宛朐。二月、八月采根，曝干。"}]},{"ID":"20240616171622-galepjw","Type":"NodeParagraph","Properties":{"id":"20240616171622-galepjw","updated":"20240616171622"},"Children":[{"Type":"NodeText","Data":"得辛荑、细辛良，恶柴胡、前胡。 今处处有。叶似姜而有文理，根似高良姜而细，味辛香。又绝似旋 根，殆欲相乱，叶小异尔。《楚辞》云∶山中人兮芳杜若。此者一名杜衡，今复别有杜衡，不相似。"}]},{"ID":"20240616171622-o03vmnn","Type":"NodeParagraph","Properties":{"id":"20240616171622-o03vmnn","updated":"20240616171622"},"Children":[{"Type":"NodeText","Data":"〔谨案〕杜若，苗似廉姜，生阴地，根似高良姜，全少辛味。陶所注旋 根，即真杜若也。"}]},{"ID":"20240616171512-bmg9lbs","Type":"NodeThematicBreak","Properties":{"id":"20240616171512-bmg9lbs"}},{"ID":"20240616171513-hycf3q4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171513-hycf3q4","updated":"20240616171518"},"Children":[{"Type":"NodeText","Data":"杜若《医学入门》"}]},{"ID":"20240616171513-n95jfmj","Type":"NodeParagraph","Properties":{"id":"20240616171513-n95jfmj","updated":"20240616171513"},"Children":[{"Type":"NodeText","Data":"杜若微温气味辛，风脑头疼涕泪频，温中下气平胸胁，益精明目更轻身。"}]},{"ID":"20240616171513-b8dorm7","Type":"NodeParagraph","Properties":{"id":"20240616171513-b8dorm7","updated":"20240616171513"},"Children":[{"Type":"NodeText","Data":"杜，土也，处处土产，若细辛芳香，故又名土细辛。无毒。去皮蜜水浸，晒干用。"}]},{"ID":"20240616171338-8db65w1","Type":"NodeThematicBreak","Properties":{"id":"20240616171338-8db65w1"}},{"ID":"20240616171410-x3iyhhu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171410-x3iyhhu","updated":"20240616171424"},"Children":[{"Type":"NodeText","Data":"杜若《本草经集注》"}]},{"ID":"20240616171410-q1tc9mc","Type":"NodeParagraph","Properties":{"id":"20240616171410-q1tc9mc","updated":"20240616171410"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主治胸胁下逆气，温中，风入脑户，头肿痛，多涕泪出，眩倒目，止痛，除口臭气。久服益精，明目，轻身，令人不忘。一名杜蘅，一名杜莲，一名白莲，一名白芩，一名若芝。生武陵川泽及宛朐。二月、八月采根，曝干。（得辛夷、细辛良，恶茈胡、前胡。）"}]},{"ID":"20240616171410-arxwnuj","Type":"NodeParagraph","Properties":{"id":"20240616171410-arxwnuj","updated":"20240616171429"},"Children":[{"Type":"NodeText","Data":"今处处有。叶似姜而有文理，根似高良姜而细，味辛香。又绝似旋复根，殆欲相乱，叶小异尔。《楚词》云∶山中人兮芳杜若。此者一名杜蘅，今复别有杜蘅，不相似。（《大观》）"}]},{"ID":"20240616171339-mgygnrg","Type":"NodeThematicBreak","Properties":{"id":"20240616171339-mgygnrg"}},{"ID":"20240616171356-jveo6w1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171356-jveo6w1","updated":"20240616171404"},"Children":[{"Type":"NodeText","Data":"杜若《证类本草》"}]},{"ID":"20240616171356-s9s9i1u","Type":"NodeParagraph","Properties":{"id":"20240616171356-s9s9i1u","updated":"20240616171356"},"Children":[{"Type":"NodeText","Data":"味辛，微温，无毒。主胸胁下逆气，温中，风入脑户，头肿痛，多涕泪出，眩倒目（莫郎切），止痛，除口臭气。久服益精，明目，轻身，令人不忘。一名杜衡，一名杜莲，一名白连，一名白芩，一名若芝。生武陵川泽及冤句。二月、八月采根，曝干。（得辛夷、细辛良，恶柴胡、前胡。）"}]},{"ID":"20240616171356-g3xjt8w","Type":"NodeParagraph","Properties":{"id":"20240616171356-g3xjt8w","updated":"20240616171356"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今处处有。叶似姜而有文理，根似高良姜而细，味辛香。又绝似旋覆根，殆欲相乱，叶小异尔。《楚词》云∶山中人兮芳杜若。此者一名杜衡，今复别有杜衡，不相似。唐本注云∶杜若，苗似廉姜，生阴地，根似高良姜，全少辛味。陶所注旋覆根，即真杜若也。"}]},{"ID":"20240616171356-2ei00rw","Type":"NodeParagraph","Properties":{"id":"20240616171356-2ei00rw","updated":"20240616171356"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按蜀本图经云∶苗似山姜，花黄赤，子赤色，大如棘子，中似豆蔻。今出硖州、岭南者甚好。范子计然云∶杜衡、杜若，出南郡、汉中，大者大善。"}]},{"ID":"20240616171356-65dthak","Type":"NodeParagraph","Properties":{"id":"20240616171356-65dthak","updated":"20240616171356"},"Children":[{"Type":"NodeText","Data":"图经曰∶杜若，生武陵川泽及冤句，今江湖多有之。叶似姜花赤色，根似高良姜而小辛味，子如豆蔻。二月、八月采根曝干用。谨按此草一名杜衡，而中品自有杜衡条。杜衡，《尔雅》所谓土卤者也。杜若，《广雅》所谓楚衡者也。其类自别，然古人多相杂引用。《九歌》云∶采芳洲兮杜若。又《离骚》云∶杂杜衡与芳芷。王逸辈皆不分别。但云香草也。古方或用，而今人罕使，故亦少有识之者。"}]},{"ID":"20240616171356-ai9ok4v","Type":"NodeParagraph","Properties":{"id":"20240616171356-ai9ok4v","updated":"20240616171356"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用鸭喋草根，真相似，只是味效不同。凡修事，采得后，刀刮上黄赤皮了，细锉，用二、三重绢作袋盛，阴干。临使以蜜浸一夜，至明漉出用。尔雅一曰杜若，土卤，香草也。"}]},{"ID":"20240616171339-dz90cwr","Type":"NodeThematicBreak","Properties":{"id":"20240616171339-dz90cwr"}},{"ID":"20240616171340-cca5klb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171340-cca5klb","updated":"20240616171347"},"Children":[{"Type":"NodeText","Data":"杜若《千金翼方》"}]},{"ID":"20240616171340-fpash01","Type":"NodeParagraph","Properties":{"id":"20240616171340-fpash01","updated":"20240616171340"},"Children":[{"Type":"NodeText","Data":"味苦辛，微温，无毒。主胸胁下逆气，温中，风入脑户，头肿痛，多涕泪出，眩倒目，止痛，除口臭气。久服益精，明目轻身，令人不忘。一名杜衡，一名杜连，一名白连，一名白芩，一名若芝。生武陵川泽及冤句，二月八月采根，曝干。"}]},{"ID":"20240607130842-32e5h7e","Type":"NodeThematicBreak","Properties":{"id":"20240607130842-32e5h7e"}},{"ID":"20240607130843-7k6rwrv","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607130843-7k6rwrv","updated":"20240607130851"},"Children":[{"Type":"NodeText","Data":"杜若《本草纲目》"}]},{"ID":"20240607130843-zrz2suq","Type":"NodeParagraph","Properties":{"id":"20240607130843-zrz2suq","updated":"20240607130843"},"Children":[{"Type":"NodeText","Data":"「释名」杜蘅、杜莲、若芝、楚蘅、山姜。"}]},{"ID":"20240607130843-38u5jls","Type":"NodeParagraph","Properties":{"id":"20240607130843-38u5jls","updated":"20240607130843"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、微温、无毒。"}]},{"ID":"20240607130843-jlo76pu","Type":"NodeParagraph","Properties":{"id":"20240607130843-jlo76pu","updated":"20240607130843"},"Children":[{"Type":"NodeText","Data":"「主治」胸胁逆气，头痛流涕，皮间风热等。李时珍说：“杜若乃神农上品，治足少阴、太阳诸证要药，而世不知用，惜哉。”（意思是说，杜若在《神农本草经》里列为“上品”，是治肾、膀胱诸经的要药，但是人们不知道用它，这是很可惜的。）"}]},{"ID":"20240616171558-2qecqa6","Type":"NodeThematicBreak","Properties":{"id":"20240616171558-2qecqa6"}},{"ID":"20240616171559-qvq3gm4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171559-qvq3gm4","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"杜蘅《本草图经》"}]},{"ID":"20240616171559-wv4eauh","Type":"NodeParagraph","Properties":{"id":"20240616171559-wv4eauh","updated":"20240616171559"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"杜蘅"},{"Type":"NodeText","Data":"，旧不着所出州土，今江淮间皆有之。苗叶都似细辛，惟香气小异，而根亦粗，黄白色，叶似马蹄，故名马蹄香。三月三日采根，熟洗，曝干。谨按《山海经》云∶天帝之山，有草状如葵，其臭如蘼芜，名曰杜蘅，可以走马，食之已瘿。郭璞注云∶带之，可以走马。或曰马得之而健走。《尔雅》谓之杜，又名土卤，然杜若亦名杜蘅，或疑是杜若。据郭璞注云∶似葵而香，故知是此杜蘅也。今人用作浴汤及衣香，甚佳。"}]},{"ID":"20240616171559-9z0ftmd","Type":"NodeThematicBreak","Properties":{"id":"20240616171559-9z0ftmd","updated":"20240616171559"}},{"ID":"20240616171559-0fqk818","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616171559-0fqk818","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"杜衡《证类本草》"}]},{"ID":"20240616171559-w25syfs","Type":"NodeParagraph","Properties":{"id":"20240616171559-w25syfs","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主风寒咳逆。香人衣体。生山谷。三月三日采根，熟洗，曝干。"}]},{"ID":"20240616171559-ypkmsjb","Type":"NodeParagraph","Properties":{"id":"20240616171559-ypkmsjb","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶根、叶都似细辛，唯气小异尔。处处有之。方药少用，唯道家服之。令人身衣香。《山海经》云∶可疗瘿。唐本注云∶杜衡叶似葵，形如马蹄，故俗云马蹄香。生山之阴，水泽下湿地。根似细辛、白前等。今俗以及己代之，谬矣。及己独茎，茎端四叶，叶间白花，殊无芳气。有毒，服之令人吐，唯疗疮疥，不可乱杜衡也。臣禹锡等谨按尔雅云∶杜，土卤。注∶杜衡也。似葵而香。山海经云∶天帝山有草，状如葵，其臭如蘼芜，名曰杜衡，可以走马，食之已瘿。郭璞注云∶带之令人便马。或曰∶马得之而健走。药性论云∶杜衡，使。能止气奔喘促，消痰饮，破留血，主项间瘤瘿之疾。"}]},{"ID":"20240616171559-zjq25o3","Type":"NodeParagraph","Properties":{"id":"20240616171559-zjq25o3","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"图经曰∶杜衡，旧不着所出州土，今江淮间皆有之。苗、叶都似细辛，唯香气小异，而根亦粗，黄白色，叶似马蹄，故名马蹄香。三月三日采根，熟洗，曝干。谨按《山海经》云∶天帝之山有草，状如葵，其臭如蘼芜，名曰杜衡，可以走马，食之已瘿。郭璞注云∶带之可以走马，或曰∶马得之而健走。《尔雅》谓之杜，又名土卤。然杜若亦名杜蘅，或疑是杜若。据郭璞注云∶似葵而香，故知是此杜衡也。今人用作浴汤及衣香甚佳。"}]},{"ID":"20240616171559-t5zkfgv","Type":"NodeParagraph","Properties":{"id":"20240616171559-t5zkfgv","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"衍义曰∶杜衡，用根，似细辛，但根色白，叶如马蹄之下。市者往往乱细辛，须如此别之。"}]},{"ID":"20240616171559-ct99mby","Type":"NodeParagraph","Properties":{"id":"20240616171559-ct99mby","updated":"20240616171559"},"Children":[{"Type":"NodeText","Data":"《尔雅》以谓似葵而香是也。将杜衡与细辛相对，便见真伪。况细辛唯出华州者良。杜衡其色黄白，拳局而脆，干则作团。"}]},{"ID":"20240607130844-z6mmms7","Type":"NodeThematicBreak","Properties":{"id":"20240607130844-z6mmms7"}},{"ID":"20240607130950-qdgbheb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130950-qdgbheb","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：杜衡"}]},{"ID":"20240607130950-1zn5tej","Type":"NodeParagraph","Properties":{"id":"20240607130950-1zn5tej","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130950-ll8l7rq","Type":"NodeParagraph","Properties":{"id":"20240607130950-ll8l7rq","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" Dù Hénɡ"}]},{"ID":"20240607130950-mdm6k2j","Type":"NodeParagraph","Properties":{"id":"20240607130950-mdm6k2j","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130950-7zbjl9d","Type":"NodeParagraph","Properties":{"id":"20240607130950-7zbjl9d","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 怀、蘅薇香（《大戴札记》），牡、土卤（《尔稚》），楚蘅（《范子计然》），杜蘅（《广雅》），土杏（《博物志》），马蹄香（（唐本草》），榷香（洪刍《香蕾，），杜衡葵（《尔雅翼，），土细辛（《土宿本草》），钹儿草（《太仓州志》），杜葵（《纲目》），南细辛（《医林纂要》），马辛（《江苏药材志》），马蹄细辛、泥里花、土里开花（《浙江天目山药植志》）。"}]},{"ID":"20240607130950-3kwm3zx","Type":"NodeParagraph","Properties":{"id":"20240607130950-3kwm3zx","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607130950-9zzpjdk","Type":"NodeParagraph","Properties":{"id":"20240607130950-9zzpjdk","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240607130950-p266iij","Type":"NodeParagraph","Properties":{"id":"20240607130950-p266iij","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130950-5ylj0lm","Type":"NodeParagraph","Properties":{"id":"20240607130950-5ylj0lm","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 为马兜铃科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杜衡"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。4～6月间采挖，洗净，晒干。"}]},{"ID":"20240607130950-9wo6kqj","Type":"NodeParagraph","Properties":{"id":"20240607130950-9wo6kqj","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607130950-1y3d9zi","Type":"NodeParagraph","Properties":{"id":"20240607130950-1y3d9zi","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 生于阴湿有腐殖质的林下或草丛中。分布江苏、浙江、安徽、湖南、江西等地。产江苏、浙江。"}]},{"ID":"20240607130950-lcx2jy1","Type":"NodeParagraph","Properties":{"id":"20240607130950-lcx2jy1","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607130950-n58acy6","Type":"NodeParagraph","Properties":{"id":"20240607130950-n58acy6","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 多年生草本。根状茎的节间短，下端集生多数肉质根。茎端生1～2叶。叶宽心形至肾状心形，长和宽均3～8匣米，先端钝或圆，基部心形，两面略被毛，边缘及脉上密被细柔毛；叶柄长7～15厘米。单花顶生，径1～1.2厘米；花被墒钟状，顶端3裂，裂片宽卵形，暗紫色，脉纹明显；雄蕊12；花柱6，柱头2裂。蒴果肉质，具多数黑褐色种子。"}]},{"ID":"20240607130950-05bu9hr","Type":"NodeParagraph","Properties":{"id":"20240607130950-05bu9hr","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607130950-fytypal","Type":"NodeParagraph","Properties":{"id":"20240607130950-fytypal","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 根茎呈不规则圆柱形，长约2厘米，直径1.5～2厘米，表面淡棕色或淡黄棕色，有多数环形的节，顶端残留皱缩的叶柄或叶片，下部着生多数须根。根细圆柱形，弯曲，长约7匣米，直径1～2毫米，表面灰白色至淡棕色，具细纵皱，质毙易断，断面平坦，类白色。气芳香，味辛辣。"}]},{"ID":"20240607130950-8miu9a0","Type":"NodeParagraph","Properties":{"id":"20240607130950-8miu9a0","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607130950-r7aemny","Type":"NodeParagraph","Properties":{"id":"20240607130950-r7aemny","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 主要成分为黄樟醚及少量丁香油酚。"}]},{"ID":"20240607130950-7pw2zyb","Type":"NodeParagraph","Properties":{"id":"20240607130950-7pw2zyb","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607130950-9sb3jtj","Type":"NodeParagraph","Properties":{"id":"20240607130950-9sb3jtj","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 黄樟醚有麻痹作用，能使动物的呼吸中枢麻痹。长时间给猫及家畜以少量，则引起和磷中毒样的肝、肾脂肪变性；对犬给予0.75克则发生呕吐，犬的致死量，皮下注射或内服均为1克／公斤。"}]},{"ID":"20240607130950-02y5mq7","Type":"NodeParagraph","Properties":{"id":"20240607130950-02y5mq7","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607130950-jpakx0i","Type":"NodeParagraph","Properties":{"id":"20240607130950-jpakx0i","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 原药拣去杂质，拍去泥屑，用水洗净，稍润后切断，晒干。"}]},{"ID":"20240607130950-nvhblt0","Type":"NodeParagraph","Properties":{"id":"20240607130950-nvhblt0","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130950-j0s11b6","Type":"NodeParagraph","Properties":{"id":"20240607130950-j0s11b6","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 《别录》：\"味辛，温，无毒。\""}]},{"ID":"20240607130950-7tr4y9h","Type":"NodeParagraph","Properties":{"id":"20240607130950-7tr4y9h","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607130950-8ehi0ue","Type":"NodeParagraph","Properties":{"id":"20240607130950-8ehi0ue","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 体虚多汗、咳嗽咯血及孕妇忌服。"}]},{"ID":"20240607130950-8ag0tba","Type":"NodeParagraph","Properties":{"id":"20240607130950-8ag0tba","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130950-1pfd3su","Type":"NodeParagraph","Properties":{"id":"20240607130950-1pfd3su","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 散风逐寒，消痰行水，活血，平喘，定痛，治风寒感冒，痰饮喘咳，水肿，风湿，跌打损伤，头疼，龋齿痛，痧气腹痛。"}]},{"ID":"20240607130950-uj194hj","Type":"NodeParagraph","Properties":{"id":"20240607130950-uj194hj","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主风寒咳逆。\""}]},{"ID":"20240607130950-lrv95un","Type":"NodeParagraph","Properties":{"id":"20240607130950-lrv95un","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"止气奔喘促，消痰饮，破留血，主项间瘤瘿之疾。\""}]},{"ID":"20240607130950-qp59ssy","Type":"NodeParagraph","Properties":{"id":"20240607130950-qp59ssy","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"散风寒，下气清痰，行水破血，杀虫。\""}]},{"ID":"20240607130950-v33idvf","Type":"NodeParagraph","Properties":{"id":"20240607130950-v33idvf","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"④《广西中药志》：\"通经，散寒，祛痰，利尿。\""}]},{"ID":"20240607130950-rqx5jni","Type":"NodeParagraph","Properties":{"id":"20240607130950-rqx5jni","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑤《江苏药材志》：\"发汗，祛痰。治感冒头痛，牙痛，口舌生疮。\""}]},{"ID":"20240607130950-p234552","Type":"NodeParagraph","Properties":{"id":"20240607130950-p234552","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑥《浙江天目山药植志》：\"催吐，祛痰，利尿。治支气管炎及水肿。\""}]},{"ID":"20240607130950-ppa9985","Type":"NodeParagraph","Properties":{"id":"20240607130950-ppa9985","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607130950-m0bm5rd","Type":"NodeParagraph","Properties":{"id":"20240607130950-m0bm5rd","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1钱；浸酒或入散剂。外用：研末吹鼻或捣敷。"}]},{"ID":"20240607130950-f8m60lu","Type":"NodeParagraph","Properties":{"id":"20240607130950-f8m60lu","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607130950-2cd3uro","Type":"NodeParagraph","Properties":{"id":"20240607130950-2cd3uro","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" ①治风寒头痛，伤风伤寒，头痛、发热初觉者：马蹄香为末，每服一钱，热酒调下，少顷饮热茶一碗，催之出汗。（《杏林摘要》香汗散）"}]},{"ID":"20240607130950-x864htv","Type":"NodeParagraph","Properties":{"id":"20240607130950-x864htv","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"②治呼吸喘息，若犹觉停滞在心胸，膈中不和者：瓜蒂二分，杜衡三分，人参一分；捣、筛，以汤服一钱匕，日二、三服。（《补缺肘后方》）"}]},{"ID":"20240607130950-0x4lro1","Type":"NodeParagraph","Properties":{"id":"20240607130950-0x4lro1","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"③治哮呴：马蹄香，焙干研为细末，每服二、三钱。如正发时，用淡醋调下，少时吐出痰涎为效。（《普济方》黑马蹄香散）"}]},{"ID":"20240607130950-d8qwyhx","Type":"NodeParagraph","Properties":{"id":"20240607130950-d8qwyhx","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"④治暑天发疹：杜衡根（研粉）三至四分。开水吞服。"}]},{"ID":"20240607130950-9plaqfc","Type":"NodeParagraph","Properties":{"id":"20240607130950-9plaqfc","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑤治损伤疼痛及蛇咬伤：杜衡（研末）每次吞服二分；外用鲜杜衡，捣敷患处。"}]},{"ID":"20240607130950-73yn8bm","Type":"NodeParagraph","Properties":{"id":"20240607130950-73yn8bm","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑥治蛇咬伤：杜衡根一至二钱，青蓬（菊科牡蒿）叶、竹叶细青（兰科斑叶兰）各等量，金银花三至四钱，野刚子（马钱科醉鱼草）五至六钱，水煎，一日三次，饭前服。"}]},{"ID":"20240607130950-td9lepo","Type":"NodeParagraph","Properties":{"id":"20240607130950-td9lepo","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑦治疮毒：杜衡根、青蓬叶各一至二钱。捣烂敷患处。（④方以下出《浙江天目山药植志》）"}]},{"ID":"20240607130950-s97fd75","Type":"NodeParagraph","Properties":{"id":"20240607130950-s97fd75","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑧治无名肿毒，瓜藤疽初起，漫肿无头，木痛不红，连贯而生：杜衡鲜叶七片，酌冲开水，炖一小时，服后出微汗，日服一次；渣捣烂加热敷贴。（《福建民间草药》）"}]},{"ID":"20240607130950-do39rx0","Type":"NodeParagraph","Properties":{"id":"20240607130950-do39rx0","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"⑨治蛀齿疼痛：杜衡鲜叶捻烂，塞入蛀孔中。（《福建民间草药》）"}]},{"ID":"20240607130950-xu6ucai","Type":"NodeParagraph","Properties":{"id":"20240607130950-xu6ucai","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130950-juvxlsa","Type":"NodeParagraph","Properties":{"id":"20240607130950-juvxlsa","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607130950-i4c8kvo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130950-i4c8kvo","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"《中华本草》：杜衡"}]},{"ID":"20240607130950-lv7s998","Type":"NodeParagraph","Properties":{"id":"20240607130950-lv7s998","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607130950-l17w4e9","Type":"NodeParagraph","Properties":{"id":"20240607130950-l17w4e9","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" Dù Hénɡ"}]},{"ID":"20240607130950-kxchhna","Type":"NodeParagraph","Properties":{"id":"20240607130950-kxchhna","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607130950-8yhekhy","Type":"NodeParagraph","Properties":{"id":"20240607130950-8yhekhy","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 怀、蘅薇香、杜、土卤、楚蘅、杜蘅、土杏、马蹄香、蘹香、杜衡葵、土细辛、钹儿草、杜葵、南细辛、马辛、马蹄细辛、泥里花、土里开花。"}]},{"ID":"20240607130950-yo1gn7i","Type":"NodeParagraph","Properties":{"id":"20240607130950-yo1gn7i","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607130950-2qv79jj","Type":"NodeParagraph","Properties":{"id":"20240607130950-2qv79jj","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" Forbes Wildginger Herb，Herb of Forbes Wildginger"}]},{"ID":"20240607130950-z84ugty","Type":"NodeParagraph","Properties":{"id":"20240607130950-z84ugty","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607130950-89x99wt","Type":"NodeParagraph","Properties":{"id":"20240607130950-89x99wt","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》。"}]},{"ID":"20240607130950-4m633vf","Type":"NodeParagraph","Properties":{"id":"20240607130950-4m633vf","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"1.《山海经》：天帝之山有草焉，其状如葵，其臭如靡芜，名曰杜衡，食之已瘿。"}]},{"ID":"20240607130950-r9c3a3q","Type":"NodeParagraph","Properties":{"id":"20240607130950-r9c3a3q","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：杜衡，根、叶都似细辛，惟气小异尔。"}]},{"ID":"20240607130950-zkgusum","Type":"NodeParagraph","Properties":{"id":"20240607130950-zkgusum","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：杜衡，叶似葵，形如马蹄，故俗云马蹄香。生山之阴，水泽下湿地。根似细辛、白前等。今俗以及己代之，谬矣。及己独茎，茎端四叶，叶间白花，殊无芳气；有毒，服之令人吐，惟疗疮疥，不可乱杜蘅也。"}]},{"ID":"20240607130950-69cb72b","Type":"NodeParagraph","Properties":{"id":"20240607130950-69cb72b","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"4.《本草衍义》：杜衡用根，市者"}]},{"ID":"20240607130950-ny49ekr","Type":"NodeParagraph","Properties":{"id":"20240607130950-ny49ekr","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607130950-w0tbizi","Type":"NodeParagraph","Properties":{"id":"20240607130950-w0tbizi","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 药材基源：为马兜铃科植物杜衡的根茎及根或全草。"}]},{"ID":"20240607130950-rmj9n6t","Type":"NodeParagraph","Properties":{"id":"20240607130950-rmj9n6t","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Asarum forbesii Maxim."}]},{"ID":"20240607130950-ialwphi","Type":"NodeParagraph","Properties":{"id":"20240607130950-ialwphi","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"采收和储藏：4-6月间采挖，洗净，晒干。"}]},{"ID":"20240607130950-9akbu8b","Type":"NodeParagraph","Properties":{"id":"20240607130950-9akbu8b","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607130950-eu3b8rs","Type":"NodeParagraph","Properties":{"id":"20240607130950-eu3b8rs","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于林下或沟边阴湿地。"}]},{"ID":"20240607130950-wn42kwc","Type":"NodeParagraph","Properties":{"id":"20240607130950-wn42kwc","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2.竽于林下草丛或溪边阴湿处。"}]},{"ID":"20240607130950-mghofyy","Type":"NodeParagraph","Properties":{"id":"20240607130950-mghofyy","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于江苏、安徽、浙江、江西、河南、湖北、四川等地。"}]},{"ID":"20240607130950-7gtqo6x","Type":"NodeParagraph","Properties":{"id":"20240607130950-7gtqo6x","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2.分布于安徽、浙江、江西、福建、广东、广西等地。"}]},{"ID":"20240607130950-r2uuh54","Type":"NodeParagraph","Properties":{"id":"20240607130950-r2uuh54","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607130950-k75dkn9","Type":"NodeParagraph","Properties":{"id":"20240607130950-k75dkn9","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 1．杜衡 多年生草本。根茎短。叶柄长3-15cm；芽胞叶肾状心形或倒卵形，边缘有睫毛；叶片阔心形至肾状心形，长和宽各为3-8cm，先端钝或圆，基部心形，上面深绿色，中脉两旁有白色云斑，脉上及其近缘有短毛，下面浅绿色。花暗紫色；花便长1-2cm；花被管钟状或圆筒状，长1-1.5cm，直径8-10mm，喉都不缢缩，喉孔直径4-6mm，膜环极窄，宽不足lmm，内壁具明显格状网眼，花被裂片直立，卵形，平滑，无乳突皱褶；药隔稍伸出；子房半下位，花柱离生，先端2浅裂。柱头卵状，侧生。花期4-5月。"}]},{"ID":"20240607130950-9jwdvxs","Type":"NodeParagraph","Properties":{"id":"20240607130950-9jwdvxs","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2.小叶马蹄香 多年生草本。根茎短。叶柄长3-15cm；芽胞叶卵形或长卵形，边缘有睫毛；叶心形、卵心形、稀近戟形，长3-6cm，宽3.5-7.5cm，先端急尖或钝，基部心形，上面通常深绿色，有时在中脉两旁有白色云斑，脉上或近边缘处有短毛，下面浅绿色，或初呈紫色而逐渐消退，或紫色。花紫色；花梗长约1cm，有时向下弯垂；花被管球状，直径约1cm，喉部强度缢缩，膜环宽约1mm，内壁有格状网眼，花被裂片三角状卵形，基部乳突皱褶区；药隔伸出，圆形，中央微内凹；子房近上位，花柱6，柱头卵状，顶生。花期4-5月。"}]},{"ID":"20240607130950-l6m6itn","Type":"NodeParagraph","Properties":{"id":"20240607130950-l6m6itn","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607130950-3ed1itu","Type":"NodeParagraph","Properties":{"id":"20240607130950-3ed1itu","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）杜衡常卷曲成团。根茎圆柱形，长约1cm，直径2-3mm，表面浅棕色或灰黄色，粗糙节间长1-9mm。根细圆柱形，长7cm，直径1-2mm，表面灰白色或浅棕色，断面黄白色或类白色。叶片展平后呈宽心形肾状心形，长宽均为3-8cm，先端钝或圆，上面主脉两侧可见云斑，脉上及近叶缘有短毛。偶见花，1-2朵腋生，钟状，紫褐色。气芳香，有浓烈辛辣味，有麻舌感。（2）小叶马蹄香根茎短。根直径l-2mm，灰黄色，断面灰白色。完整叶展开后呈心形、卵。状心形，长3-6cm，宽3.5-7.5cm，先端急尖或钝，基部心形，上面主脉两例时有云斑，脉上及边缘有短毛；叶柄长3-15cm。气芳香，味麻辣，略麻舌。以根多、香气浓者为佳。"}]},{"ID":"20240607130950-5tk66n8","Type":"NodeParagraph","Properties":{"id":"20240607130950-5tk66n8","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"显微鉴别 （l）杜衡根横切面：表皮残存。外皮层细胞1列；皮层有油细胞散在；内皮层明显。初生木质部四原型或五原型。薄壁细胞含淀粉粒。"}]},{"ID":"20240607130950-sh2t5sj","Type":"NodeParagraph","Properties":{"id":"20240607130950-sh2t5sj","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"根茎横切面：表皮细胞内侧有厚角组织。皮层宽广，有油细胞散在；薄壁细胞含淀粉粒。维管束外韧型，常5-6个。髓部明显。"}]},{"ID":"20240607130950-mmgw802","Type":"NodeParagraph","Properties":{"id":"20240607130950-mmgw802","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"叶片表面观：上下表皮的气孔均为不定式，并具类图形油细胞。上表皮细胞类多角形，叶脉处可见由l-4个细胞组成的非腺毛，顶端尖而稍弯曲，具壁疣，长132-160μm，基部直径29.6-44.4μm。下表皮细胞不规则形，垂周壁波状弯曲，无毛。（2）小叶马蹄香根横切面：外皮层细胞切向延长；皮层细胞约19列，有油细胞散在，薄壁细胞含淀粉粒，初生木质部通常三原型。"}]},{"ID":"20240607130950-4o23s0n","Type":"NodeParagraph","Properties":{"id":"20240607130950-4o23s0n","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"根茎横切面：皮层细胞约21列，散有油细胞，薄壁细胞含淀粉粒。维管束常6个。"}]},{"ID":"20240607130950-x1rrdly","Type":"NodeParagraph","Properties":{"id":"20240607130950-x1rrdly","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607130950-5r4h1xm","Type":"NodeParagraph","Properties":{"id":"20240607130950-5r4h1xm","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 对小鼠灌胃的LD50为1.823g/kg，腹腔注射的LD50为0.672g/kg。"}]},{"ID":"20240607130950-x0j8fus","Type":"NodeParagraph","Properties":{"id":"20240607130950-x0j8fus","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607130950-17p9ti3","Type":"NodeParagraph","Properties":{"id":"20240607130950-17p9ti3","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 1.杜衡从全草中分离出杜衡素（asarumin）A、B、C、D，榄香脂素（elemicin），细辛脑（asarone）和亚油酸（linoleic acid）。全草（干品）含挥发油 2.6％，从挥发油中除分离出甲基丁香油酚（methyl eugenol），甲基异丁香油酚（methyl isoeugenol），榄香脂素（elemicin）和卡枯酸（kakuol）外，还含有：a-蒎烯（a-pinene），樟烯（camphene），β-蒎烯（β-pinene），月挂烯（nyrcene），香桧烯（sabinene），柠檬烯（limonene）,1,8-按叶素(1,8-cineole），对-聚伞花素（p-cymene），γ-松油烯（γ-terpinene），异松油烯（terpinolene），樟脑（camphor），龙脑（borneol），a-松油醇(a-terpineol），3，5-二甲氧基甲苯（3，5-dimethoxytouene），黄樟醚（safrole），反式-丁香烯（trans-caryophyllene），β-古芸烯（β-gur-junene），反式-β-金合欢烯（trans-β-faranesene），细辛醚（asaricin），肉豆寇醚（myristicin），异榄香脂素（isoelemicin）等。"}]},{"ID":"20240607130950-wkv99w8","Type":"NodeParagraph","Properties":{"id":"20240607130950-wkv99w8","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2．小叶马蹄香全草（干品）含挥发油0.6％，挥发油中的成分有:1,8-按叶素（l,8-cineole），芳樟醇（linalool），龙脑（bor-neol），a-松油醇（a-terpineol），萘（naphthalene），2-异丙基-5-甲基茴香醚（2-isopropyl-5methylanisole），乙酸龙脑酯（bornylacetate）3，5-二甲氧基甲苯（3，5-dimethoxytoxytoluene），黄樟醚（safrole），反式-丁香烯（trans-caryophyllene），β-古芸烯（β-gUr-junene），反式-β-金合欢烯（trans-β-farnesene），葎草烯（humulene），β-橄榄烯（β-maaliene），甲基丁香油酚（methyleugenol），2，3，5-三甲氧基甲苯（2，3，5-trimethoxytoluene），橙花叔醇（nerolidol），细辛醚（asaricin），甲基异丁香油酚（methylisoeugenol），肉豆蔻醚（myristicin），榄香脂素elemicin），异榄香脂素（isoelemicin）和2，4，5-三甲氧基丙烯基苯（2 4，5-trimethoxypropenylbenzene），樟烯（camphene），a-蒎烯（a-pinen），β-蒎烯（β-pinene），月桂烯（myrcene），β-水芹烯（β-phel-landrene)，β-松油烯（β-terpinen），3，4-二甲基-2，4，6-辛三烯（3，4，-dimethyl-2,4，6-octatriene），优葛缕酮（eucarvone），表樟脑（epicamphor），异龙脑（soborneol），爱草脑（estragole），十五烷（pentadecane），β-甜没药烯（β-bisabolene），2-甲氧基黄樟醚（croweacin），柠檬烯（limonene），金合欢醇（farnesol），卡枯醇 （kakuol），2，5-双叔丁基噻吩（2，5-itertbutylthiophene），反式细辛脑（trans-asarone）。"}]},{"ID":"20240607130950-5vqz46i","Type":"NodeParagraph","Properties":{"id":"20240607130950-5vqz46i","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607130950-6qb7lrx","Type":"NodeParagraph","Properties":{"id":"20240607130950-6qb7lrx","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 1.黄樟醚有麻痹作用，能使动物的呼吸中枢麻痹。长时间给猫及家畜以少量，则引起和磷中毒样的肝、肾脂肪变性，对犬给予0.75g则发生呕吐，犬的致死量，皮下注射或内服均为1g／kg。"}]},{"ID":"20240607130950-52rujrd","Type":"NodeParagraph","Properties":{"id":"20240607130950-52rujrd","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2.煎剂29g/kg灌胃，对小鼠有镇痛作用。"}]},{"ID":"20240607130950-z8s4ncr","Type":"NodeParagraph","Properties":{"id":"20240607130950-z8s4ncr","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"3.马辛挥发油0.15ml/kg腹腔注射，明显减少小鼠自发活动；0.025、0.03、0.05ml/kg腹腔注射，对小鼠阈下剂量戊巴比妥钠有协同睡眠作用；0.075、0.15ml/kg能延长小鼠硫喷妥钠的睡眠时间；0.25ml/kg可对抗戊四唑引起的小鼠惊厥，也对抗电休克惊厥；0.15、0.25ml/kg可增强小鼠对缺氧的耐受力；0.075、0.15ml/kg对大鼠有降温作用。"}]},{"ID":"20240607130950-7dvcbgy","Type":"NodeParagraph","Properties":{"id":"20240607130950-7dvcbgy","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"4.用0.02%-0.1%马辛挥发油0.2ml灌胃，可降低高胆甾醇血症小鼠的血脂，并呈量-效线性关系。"}]},{"ID":"20240607130950-zxrhep0","Type":"NodeParagraph","Properties":{"id":"20240607130950-zxrhep0","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607130950-jp9yy0d","Type":"NodeParagraph","Properties":{"id":"20240607130950-jp9yy0d","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 原药拣去杂质，拍去泥屑，用水洗净，稍润后切断，晒干。"}]},{"ID":"20240607130950-1b7muvn","Type":"NodeParagraph","Properties":{"id":"20240607130950-1b7muvn","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607130950-gysvr0t","Type":"NodeParagraph","Properties":{"id":"20240607130950-gysvr0t","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 理化鉴别取本品粉末1g；加乙醚5ml振摇后浸出15min，滤过。取滤液1ml置蒸发皿中，待乙醚挥散后加1％香草醛浓硫酸试剂，溶液由浅棕色变为紫棕色。（检查挥发油）"}]},{"ID":"20240607130950-4jodwj8","Type":"NodeParagraph","Properties":{"id":"20240607130950-4jodwj8","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607130950-ootdr87","Type":"NodeParagraph","Properties":{"id":"20240607130950-ootdr87","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 肺；肝；肾；膀胱经"}]},{"ID":"20240607130950-lllyz7y","Type":"NodeParagraph","Properties":{"id":"20240607130950-lllyz7y","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607130950-gvwfwa2","Type":"NodeParagraph","Properties":{"id":"20240607130950-gvwfwa2","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 辛；温；小毒"}]},{"ID":"20240607130950-mm2jzae","Type":"NodeParagraph","Properties":{"id":"20240607130950-mm2jzae","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607130950-84v0h6o","Type":"NodeParagraph","Properties":{"id":"20240607130950-84v0h6o","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 体虚多汗、咳嗽咯血及孕妇忌服。"}]},{"ID":"20240607130950-u1l0ev7","Type":"NodeParagraph","Properties":{"id":"20240607130950-u1l0ev7","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607130950-me7eab2","Type":"NodeParagraph","Properties":{"id":"20240607130950-me7eab2","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 疏风散寒；消痰利水；活血止痛。主风寒感冒；痰饮喘咳；水肿；风寒湿痹；跌打损伤；头痛；齿痛；胃痛；痧气腹痛；瘰疬；肿毒；蛇咬伤"}]},{"ID":"20240607130950-ek8yz5n","Type":"NodeParagraph","Properties":{"id":"20240607130950-ek8yz5n","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607130950-qqe9zlm","Type":"NodeParagraph","Properties":{"id":"20240607130950-qqe9zlm","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5-6g；研末，0.6-3g；或浸酒，外用：适量，研末吹鼻，或鲜品捣敷。"}]},{"ID":"20240607130950-ra1xvzw","Type":"NodeParagraph","Properties":{"id":"20240607130950-ra1xvzw","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607130950-9uwpzl6","Type":"NodeParagraph","Properties":{"id":"20240607130950-9uwpzl6","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 1.催吐方(《补缺肘后方》)，治呼吸喘息，犹觉膈中痞闷，顽痰壅滞心胸。2.治蛇伤方(《浙江天目山药植志》)，治蛇伤，局部红肿痛甚者。3.香汗散(《杏林摘要》)，治风寒头痛。"}]},{"ID":"20240607130950-1ns097a","Type":"NodeParagraph","Properties":{"id":"20240607130950-1ns097a","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607130950-ygemamk","Type":"NodeParagraph","Properties":{"id":"20240607130950-ygemamk","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 1.《名医别录》：治风寒咳逆。"}]},{"ID":"20240607130950-bbt4sod","Type":"NodeParagraph","Properties":{"id":"20240607130950-bbt4sod","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：止气奔喘促，消痰饮，破留血，主项间瘤瘿之疾。"}]},{"ID":"20240607130950-orwgdjy","Type":"NodeParagraph","Properties":{"id":"20240607130950-orwgdjy","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：散风寒，下气消痰，行水破血，杀虫。"}]},{"ID":"20240607130950-ejlt8ev","Type":"NodeParagraph","Properties":{"id":"20240607130950-ejlt8ev","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"4.《广西中药志》：通经，散寒，祛痰，利尿。"}]},{"ID":"20240607130950-2fcux19","Type":"NodeParagraph","Properties":{"id":"20240607130950-2fcux19","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"5.《江苏药材志》：发汗，祛痰。治感冒头痛，牙痛，口舌生疮。"}]},{"ID":"20240607130950-6d1tjww","Type":"NodeParagraph","Properties":{"id":"20240607130950-6d1tjww","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"6.《浙江天目山药植志》：催吐，祛痰，利尿。治支气管炎及水肿。"}]},{"ID":"20240607130950-9es6m7n","Type":"NodeParagraph","Properties":{"id":"20240607130950-9es6m7n","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"7.《本经逢原》：杜衡香窜，与细辛相似，故药肆以之代充细辛。但其气浊，不能搜涤少阴经中之寒，稍逊细辛一筹耳。"}]},{"ID":"20240607130950-alx3i1a","Type":"NodeParagraph","Properties":{"id":"20240607130950-alx3i1a","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607130950-qwupq7h","Type":"NodeParagraph","Properties":{"id":"20240607130950-qwupq7h","updated":"20240607130950"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607130952-uuwrtl8","Type":"NodeThematicBreak","Properties":{"id":"20240607130952-uuwrtl8"}},{"ID":"20240607130953-x9skz67","Type":"NodeParagraph","Properties":{"id":"20240607130953-x9skz67"}}]}