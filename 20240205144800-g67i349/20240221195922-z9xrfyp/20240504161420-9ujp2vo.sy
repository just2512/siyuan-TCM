{"ID":"20240504161420-9ujp2vo","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504161420-9ujp2vo","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504161420-9ujp2vo\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240620093434-sgxz927\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607130953-x9skz67\u0026quot;,\u0026quot;scrollTop\u0026quot;:700,\u0026quot;focusId\u0026quot;:\u0026quot;20240620093234-o391svu\u0026quot;,\u0026quot;focusStart\u0026quot;:12,\u0026quot;focusEnd\u0026quot;:12\u0026#125;","title":"078杜若（杜衡、杜蘅）","type":"doc","updated":"20240717135948"},"Children":[{"ID":"20240620093434-sgxz927","Type":"NodeParagraph","Properties":{"id":"20240620093434-sgxz927","updated":"20240620093434"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620093431-qu86s2f.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620091544-d2zu3xn","Type":"NodeParagraph","Properties":{"id":"20240620091544-d2zu3xn","updated":"20240717135948"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 431px;","style":"width: 421px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜若-20240620091544-fzpen6q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 421px;\" parent-style=\"width: 431px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 432px;","style":"width: 422px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜若 (4)"},{"Type":"Nod