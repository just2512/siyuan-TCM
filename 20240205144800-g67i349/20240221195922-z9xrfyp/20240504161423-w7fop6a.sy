,{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 590px;\" parent-style=\"width: 600px;\"}"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 671px;","style":"width: 661px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏7-20240704123259-4ihrv45.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 661px;\" parent-style=\"width: 671px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704124508-yx6uyrh","Type":"NodeParagraph","Properties":{"id":"20240704124508-yx6uyrh","updated":"20240704124508"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 380px;","style":"width: 370px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏3-20240704122857-84fzsk8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 370px;\" parent-style=\"width: 380px;\"}"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 753px;","style":"width: 743px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏4-20240704123106-wfnx757.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 743px;\" parent-style=\"width: 753px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704124508-xr9ew7x","Type":"NodeParagraph","Properties":{"id":"20240704124508-xr9ew7x","updated":"20240704124508"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1136px;","style":"width: 1126px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏5-20240704123206-jj5po90.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1126px;\" parent-style=\"width: 1136px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620144055-b03nfzx","Type":"NodeParagraph","Properties":{"id":"20240620144055-b03nfzx","updated":"20240809081949"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 517px;","style":"width: 507px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620144055-odn34an.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 507px;\" parent-style=\"width: 517px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620144307-fged52z.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240704124444-6fy233p","Type":"NodeParagraph","Properties":{"id":"20240704124444-6fy233p","updated":"20240704124445"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"侧柏11"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/侧柏11-20240704124220-g9uu3zh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240617101813-1u5jjaz","Type":"NodeThematicBreak","Properties":{"id":"20240617101813-1u5jjaz"}},{"ID":"20240617101957-ygkdvg0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101957-ygkdvg0","updated":"20240617101957"},"Children":[{"Type":"NodeText","Data":"柏实《神农本草经》"}]},{"ID":"20240617101957-ej4xc89","Type":"NodeParagraph","Properties":{"id":"20240617101957-ej4xc89","updated":"20240617101957"},"Children":[{"Type":"NodeText","Data":"味甘平。主惊悸，安五藏，益气，除湿痹。久服，令人悦泽美色，耳目聪明，不饥不老，轻身延年。生山谷。"}]},{"ID":"20240617101957-1uywl96","Type":"NodeParagraph","Properties":{"id":"20240617101957-1uywl96","updated":"20240617101957"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生太山，柏叶尤良，田四时各依方面采，阴干。"}]},{"ID":"20240617101957-yntt0z0","Type":"NodeParagraph","Properties":{"id":"20240617101957-yntt0z0","updated":"20240617102001"},"Children":[{"Type":"NodeText","Data":"案《说文》云：柏，鞠也；《广雅》云：栝柏也；《尔雅》云：柏椈；郭璞云：礼《记》曰，鬯，日以椈；《范子计然》云：柏脂出三辅，上升价七千，中三千一斗。"}]},{"ID":"20240617102007-sp7mgr2","Type":"NodeThematicBreak","Properties":{"id":"20240617102007-sp7mgr2"}},{"ID":"20240617102008-k5o0ias","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102008-k5o0ias","updated":"20240617102012"},"Children":[{"Type":"NodeText","Data":"柏实《名医别录》"}]},{"ID":"20240617102008-4i0it97","Type":"NodeParagraph","Properties":{"id":"20240617102008-4i0it97","updated":"20240617102008"},"Children":[{"Type":"NodeText","Data":"无毒．主治恍惚、虚损，吸吸历节，腰中重痛，益血，止汗．生太山．柏叶尤良．"}]},{"ID":"20240617102053-nnkgod4","Type":"NodeThematicBreak","Properties":{"id":"20240617102053-nnkgod4"}},{"ID":"20240617102054-9yyiqeb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102054-9yyiqeb","updated":"20240617102058"},"Children":[{"Type":"NodeText","Data":"柏实《千金翼方》"}]},{"ID":"20240617102054-2pe2qxg","Type":"NodeParagraph","Properties":{"id":"20240617102054-2pe2qxg","updated":"20240617102116"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主惊悸，安五脏，益气，除风湿痹，疗恍惚虚损，呼吸历节腰益血止汗。久服令人润泽美色，耳目聪明，不饥不老，轻身延年。生太山山谷，柏叶尤良。"}]},{"ID":"20240617101813-aui39wv","Type":"NodeThematicBreak","Properties":{"id":"20240617101813-aui39wv"}},{"ID":"20240617101814-yuic7jq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101814-yuic7jq","updated":"20240617101821"},"Children":[{"Type":"NodeText","Data":"柏实《本草图经》"}]},{"ID":"20240617101814-rmkijac","Type":"NodeParagraph","Properties":{"id":"20240617101814-rmkijac","updated":"20240617101816"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"柏实"},{"Type":"NodeText","Data":"，生泰山山谷，今处处有之，而干州者最佳。三月开花，九月结子，候成熟收采，蒸曝干，舂擂取熟人子用。其叶名侧柏，密州出者，尤佳。虽与他柏相类，而其叶皆侧向而生，功效殊别。采无时。张仲景方疗吐血不止者，柏叶汤主之。青柏叶一把，干姜三片，阿胶一挺炙，三味以水二升，煮一升，去滓，别绞马通汁一升相和，合煎取一升，绵滤，一服尽之。山东医工亦多用侧柏，然云性寒，止痛，其方采叶入臼中，湿捣，令极烂如泥，冷水调作膏，以治大人及小儿汤烫火烧，涂敷于伤处，用帛子系定，三两日疮当敛，仍灭瘢。又取叶焙干为末，与川黄连二味，同煎为汁，服之，以疗男子、妇人、小儿大腹下黑血茶脚色，或脓血如淀色，所谓蛊痢者，治之有殊效。又能杀五脏虫。道家多作柏叶汤，常点益人。古柏叶尤奇。今益州诸葛孔明庙中，有大柏木，相传是蜀世所植，故人多采收入作药。其味甘，香于常柏也。"}]},{"ID":"20240617102033-8r2tyln","Type":"NodeThematicBreak","Properties":{"id":"20240617102033-8r2tyln"}},{"ID":"20240617102034-w0dgemv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102034-w0dgemv","updated":"20240617102040"},"Children":[{"Type":"NodeText","Data":"柏实《证类本草》"}]},{"ID":"20240617102034-urnsbw0","Type":"NodeParagraph","Properties":{"id":"20240617102034-urnsbw0","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主惊悸，安五脏，益气，除风湿痹，疗恍惚，虚损吸吸，历节腰中重痛，益血，止汗。久服令人润泽美色，耳目聪明，不饥不老，轻身延年。生太山山谷。柏尤良。"}]},{"ID":"20240617102034-t7xrgow","Type":"NodeParagraph","Properties":{"id":"20240617102034-t7xrgow","updated":"20240617102034"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"柏叶"},{"Type":"NodeText","Data":"味苦，微温，无毒。主吐血、衄血，痢血，崩中赤白，轻身益气，令人耐寒暑，去湿痹，止饥。四时各根据方面采，阴干。柏白皮，主火灼，烂疮，长毛发。（牡蛎及桂、瓜子为之使，畏菊花、羊蹄、诸石及面曲。）"}]},{"ID":"20240617102034-g3ii4xq","Type":"NodeParagraph","Properties":{"id":"20240617102034-g3ii4xq","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶柏叶、实，亦为服饵所重，服饵别有法。柏处处有，当以太山为佳，并忌取冢墓上者。虽四时俱有，秋夏为好。其脂亦入用。此云恶曲，人有以酿酒无妨，恐酒米相和，异单用也。唐本注云∶柏枝节煮以酿酒，主风痹，历节风，烧取 ，疗 疥及癞疮良。今子仁有。八月收子叶，余采无时。药性论云∶柏子仁，君，恶菊花，畏羊蹄草，味甘，辛。能治腰肾中冷，膀胱冷，脓宿水，兴阳道，益寿，去头风，治百邪鬼魅，主小儿惊痫。又云侧柏叶，君，与酒相宜，止尿血。味苦、辛，性涩。能治冷风，历节疼痛。日华子云∶柏子仁，治风，润皮肤，此是侧柏子，入药，微炒用。又云柏叶灸 冻疮，烧取汁涂头，黑润鬓发。"}]},{"ID":"20240617102034-2tkuq9j","Type":"NodeParagraph","Properties":{"id":"20240617102034-2tkuq9j","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"又云柏白皮无毒。"}]},{"ID":"20240617102034-n3gnsp3","Type":"NodeParagraph","Properties":{"id":"20240617102034-n3gnsp3","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"图经曰∶柏实，生泰山山谷，今处处有之，而干州者最佳。三月开花，九月结子，候成熟收采，蒸曝干，春 取熟仁子用。其叶名侧柏。密州出者尤佳。虽与他柏相类，而其叶皆侧向而生，功效殊别。采无时。张仲景方疗吐血不止者，柏叶汤主之。青柏叶一把，干姜三片，阿胶一挺，炙，三味以水二升，煮一升，去滓，别绞马通汁一升相和，合煎取一升，绵滤，一服尽之。山东医工亦多用侧柏。然云性寒，止痛。其方采叶入臼中，湿捣，令极烂如泥，冷水调作膏，以治大人及小儿汤汤火烧，涂敷于伤处，用帛子系定，三、两日疮当敛，仍灭瘢。又取叶焙干为末，与川黄连二味，同煎为汁，服之，以疗男子、妇人、小儿大腹下黑血茶脚色，或脓血如淀色，所谓蛊痢者，治之有殊效。又能杀五脏虫。道家多作柏叶汤，常点益人。古柏叶尤奇。今益州诸葛孔明庙中，有大柏木，相传是蜀世所植，故人多采收以作药，其味甘，香于常柏也。"}]},{"ID":"20240617102034-0p65w6u","Type":"NodeParagraph","Properties":{"id":"20240617102034-0p65w6u","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，先以酒浸一宿，至明漉出，晒干，却用黄精自然汁于日中煎，手不住搅，若天久阴，即于铛中着水，用瓶器盛柏子仁，着火缓缓煮成煎为度。每煎三两柏子仁，用酒五两浸干为度。又云∶凡使，勿用花柏叶并丛柏叶。有子圆叶，其有子圆叶成片，如大片云母，叶叶皆侧，叶上有微赤毛。若花柏叶，其树浓叶成朵，无子；丛柏叶，其树绿色，不入药中用。若修事一斤，先拣去两畔并心枝了，用糯泔浸七日后漉出，用酒拌蒸一伏时，却用黄精自然汁浸了焙干，又浸又焙，待黄精汁干尽，然后用之。如修事一斤，用黄精自然汁十二两。圣惠方∶治时气瘴疫。用社中西南柏树东南枝，取曝干，捣罗为末，以水调下一钱匕。"}]},{"ID":"20240617102034-sqz4p9u","Type":"NodeParagraph","Properties":{"id":"20240617102034-sqz4p9u","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"日三、四服。《肘后方》同。又方∶治大风疾，令眉鬓再生。用侧柏叶九蒸九曝，捣罗为末，炼蜜和丸如梧桐子大。日三服，夜一服，熟水下五丸、十丸，百日即生。又方∶治忧恚呕血，烦满少气，胸中疼痛。用柏叶捣罗为散，不计时候。以粥饮调下二钱匕。又方∶小儿 啼惊痫，腹满不乳食，大便青白色。用柏子仁末，温水调下二钱。经验后方∶治霍乱转筋。先以暖物裹脚，然后以柏树木细锉，煮汤淋之。又方∶小儿洞下痢，煮柏叶服之。梅师方∶治中热油及火烧疮。以柏白皮、猪脂煎，涂疮上。《鬼遗方》同。孙真人食忌∶生发方取侧柏叶阴干作末，和油涂之。孙真人枕中记∶采松柏法∶尝以三月、四月采新生松叶，可长三、四寸许，并花蕊，取阴干，细捣为末。其柏叶，取深山岩谷中，采当年新生，可长三、四寸者，阴干，细捣为末，用白蜜丸如小豆大。常以月一十五日，日未出时，烧香东向，手持药八十一丸，以酒下。服一年，延十年命；服二年，延二十年命。欲得长肌肉，加大麻、巨胜；欲心力壮健者，加茯苓、人参。此药除百病，益元气添五脏六腑，清明耳目，强壮不衰老，延年益寿，神验。用七月七日露水丸之，更佳。服时乃咒曰∶神仙真药，体合自然。服药入腹，天地同年。咒讫服药。断诸杂肉、五辛。最切忌，慎之。姚氏方∶治鼠 肿核痛，未成脓。"}]},{"ID":"20240617102034-yiq9si6","Type":"NodeParagraph","Properties":{"id":"20240617102034-yiq9si6","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"以柏叶敷着肿上，熬盐着肿上熨，令热气下，即消。抱朴子∶汉成帝时，猎者于终南山见一人，无衣服，身皆生黑毛。跳坑越涧如飞，乃密伺其所在，合围取得，乃是一妇人。问之∶言我是秦之宫人，关东贼至，秦王出降，惊走入山，饥无所食，泊欲饿死。有一老公，教我吃松柏叶、实，初时苦涩，后稍便吃，遂不复饥。冬不寒，夏不热，此女是秦人。至成帝时，三百余载也。列仙传∶赤松子，好食柏实，齿落更生。别说云∶谨按陶隐居说∶柏忌取冢墓上者，今云干州者最佳。则干州柏茂大者，皆是乾陵所出，他处皆无大者，但取其州土所宜，子实气味丰美可也。乾陵之柏，异于他处，其木未有无纹理者，而其纹多为菩萨云气、人物鸟兽，状极分明可观。有盗得一株径尺者，可直万钱，关陕人家，多以为贵，宜其子实最佳也。又以其枝节烧油膏，敷恶疮久不瘥有虫者。牛马畜产有疮疥，名为重病，以敷之三、五次，无不愈也。"}]},{"ID":"20240617102034-ys6jcgi","Type":"NodeParagraph","Properties":{"id":"20240617102034-ys6jcgi","updated":"20240617102034"},"Children":[{"Type":"NodeText","Data":"衍义曰∶柏，取 以疗马 疥，今未见用松 者。老人虚秘，柏子仁、大麻子仁、松子仁等分，同研，溶白蜡丸桐子大。以少黄丹汤，服二、三十丸，食前。尝官陕西，每登高望之，虽千万株，皆一一西指。盖此木为至坚之木，不畏霜雪，得木之正气，他木不逮也。所以受金之正气所制，故一一向之。"}]},{"ID":"20240617102022-j234pbv","Type":"NodeThematicBreak","Properties":{"id":"20240617102022-j234pbv"}},{"ID":"20240617102023-uy5onbp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102023-uy5onbp","updated":"20240617102027"},"Children":[{"Type":"NodeText","Data":"柏实（柏叶）《本草新编》"}]},{"ID":"20240617102023-4vc49zw","Type":"NodeParagraph","Properties":{"id":"20240617102023-4vc49zw","updated":"20240617102023"},"Children":[{"Type":"NodeText","Data":"柏子仁，甘、辛，气平，无毒。入心、肝、肾、膀胱四经。聪耳目，却风痹，止疼，益气血，去恍惚虚损，敛汗。治肾冷、腰冷、膀胱冷。尤能润燥，腰肾身体颜面燥涩者，皆治之。"}]},{"ID":"20240617102023-nt2zh85","Type":"NodeParagraph","Properties":{"id":"20240617102023-nt2zh85","updated":"20240617102023"},"Children":[{"Type":"NodeText","Data":"兴阳道，杀百虫，止惊怪，安五脏，头风眩痛。亦可煎调，久服不饥，增寿耐老，此药尤佳，乃延生之妙品也。但必须去油用之，否则过润，反动大便。尤宜与补心、肾之药同用，则功用尤神。"}]},{"ID":"20240617102023-adal301","Type":"NodeParagraph","Properties":{"id":"20240617102023-adal301","updated":"20240617102023"},"Children":[{"Type":"NodeText","Data":"柏叶苦涩，只能敛肺，遏吐血、衄血，亦生须发。但非补阳要药，不可与柏子仁同类而并称也。"}]},{"ID":"20240617102023-lin78xl","Type":"NodeParagraph","Properties":{"id":"20240617102023-lin78xl","updated":"20240617102023"},"Children":[{"Type":"NodeText","Data":"或疑柏子仁益心而不益肾，以其必去油而用之也，油去则性燥，心喜燥而肾恶燥，非明验耶？噫！以此论药，失之凿矣。夫柏子仁最多油，去油者，恐过滑以动便，非欲其燥以入心，且柏子仁油去之，亦不能尽，肾得之，未尝燥也。凡药皆宜制其中和，何独于柏子仁疑之耶。"}]},{"ID":"20240617102023-ranmsai","Type":"NodeParagraph","Properties":{"id":"20240617102023-ranmsai","updated":"20240617102023"},"Children":[{"Type":"NodeText","Data":"或疑柏子仁补心之药，何以补肾火之药反用之耶？夫心肾相通，心虚而命门之火不能久闭，所以跃跃欲走也。用柏子仁以安心君，心君不动，而相火奉令惟谨，何敢轻泄乎。此补心之妙，胜于补肾也。世人但知补肾以兴阳，谁知补心以兴阳之更神哉。"}]},{"ID":"20240617101825-ttqe44s","Type":"NodeThematicBreak","Properties":{"id":"20240617101825-ttqe44s"}},{"ID":"20240617101826-x7p07ee","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101826-x7p07ee","updated":"20240617101831"},"Children":[{"Type":"NodeText","Data":"柏实《长沙药解》"}]},{"ID":"20240617101826-8olacaa","Type":"NodeParagraph","Properties":{"id":"20240617101826-8olacaa","updated":"20240617101826"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味甘平。主惊悸，安五藏，益气，除湿痹。久服，令人悦泽美色，耳目聪明，不饥不老，轻身延年。生山谷。"}]},{"ID":"20240617101826-gfadaii","Type":"NodeParagraph","Properties":{"id":"20240617101826-gfadaii","updated":"20240617101826"},"Children":[{"Type":"NodeText","Data":"味甘、微辛，气香，入手太阴肺经。润燥除烦，降逆止喘。"}]},{"ID":"20240617101826-n8wzjfx","Type":"NodeParagraph","Properties":{"id":"20240617101826-n8wzjfx","updated":"20240617101826"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"竹皮大丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在竹茹。"},{"Type":"NodeText","Data":"治乳妇中虚，烦乱呕逆。烦喘者，加柏实一分，以其清金降逆而止烦喘也。"}]},{"ID":"20240617101826-mprbwyu","Type":"NodeParagraph","Properties":{"id":"20240617101826-mprbwyu","updated":"20240617101826"},"Children":[{"Type":"NodeText","Data":"柏实清润降敛，宁神调气，善去烦躁，而止喘逆。缘其香甘入土，能行凝滞。开土郁，肺胃右行，神气下达，烦喘自定。其诸主治，安魂魄，止惊悸，润肠秘，泽发焦。"}]},{"ID":"20240617101826-gfsvjvl","Type":"NodeParagraph","Properties":{"id":"20240617101826-gfsvjvl","updated":"20240617101826"},"Children":[{"Type":"NodeText","Data":"蒸晒，炒，去皮，取仁用。"}]},{"ID":"20240617101841-uzbbm2j","Type":"NodeThematicBreak","Properties":{"id":"20240617101841-uzbbm2j"}},{"ID":"20240607141300-t6zgllv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141300-t6zgllv","updated":"20240607141304"},"Children":[{"Type":"NodeText","Data":"柏实《本草经集注》"}]},{"ID":"20240607141255-mrxuvzm","Type":"NodeParagraph","Properties":{"id":"20240607141255-mrxuvzm","updated":"20240607141255"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主治惊悸，安五脏，益气，除风湿痹。治恍惚、虚损，呼吸历节，腰中重痛，益血，止汗。久服令人润泽美色，耳目聪明，不饥，不老，轻身，延年。生太山山谷。柏叶尤良。柏叶，味苦，微温，无毒。主治吐血，衄血，痢血，崩中，赤白，轻身益气，令人耐风寒，去湿痹，止饥。四时各依方面采，阴干。柏白皮，主火灼，烂疮，长毛发。"}]},{"ID":"20240607141255-7nnes97","Type":"NodeParagraph","Properties":{"id":"20240607141255-7nnes97","updated":"20240607141255"},"Children":[{"Type":"NodeText","Data":"（牡蛎、桂、瓜子为之使，恶菊花、羊蹄、诸石及曲。）"}]},{"ID":"20240607141255-7lp0aa8","Type":"NodeParagraph","Properties":{"id":"20240607141255-7lp0aa8","updated":"20240607141255"},"Children":[{"Type":"NodeText","Data":"柏叶、实亦为服食所重，炼饵别有法。柏处处有，当以太山为佳，并忌取冢墓上也。虽四时俱有，而秋夏为好。其脂亦入用。此云恶曲，人有以酿酒无妨，恐酒米相和，异单用也。）"}]},{"ID":"20240607141305-9gxbjon","Type":"NodeThematicBreak","Properties":{"id":"20240607141305-9gxbjon"}},{"ID":"20240607141314-58pcy95","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141314-58pcy95","updated":"20240607141319"},"Children":[{"Type":"NodeText","Data":"柏实《医学入门》"}]},{"ID":"20240607141314-85z5lyo","Type":"NodeParagraph","Properties":{"id":"20240607141314-85z5lyo","updated":"20240607141314"},"Children":[{"Type":"NodeText","Data":"柏实甘辛平润心，滋肾兴阳腰痛深，利膀胱中冷脓水，安脏除风湿痹侵，叶苦涩温止诸血，益脾敛肺补真阴。"}]},{"ID":"20240607141314-496kemb","Type":"NodeParagraph","Properties":{"id":"20240607141314-496kemb","updated":"20240607141314"},"Children":[{"Type":"NodeText","Data":"万木向阳，惟柏西向，故字从白，禀金之正气，木之最坚者也。无毒。主养心神，润心血，止汗定惊。"}]},{"ID":"20240607141314-rzikzbk","Type":"NodeParagraph","Properties":{"id":"20240607141314-rzikzbk","updated":"20240607141314"},"Children":[{"Type":"NodeText","Data":"又滋肾水，兴阳道，疗虚损、历节、腰中重痛、腰肾中冷脓宿水。兼安五脏，益气血，除风湿痹，去头风，治百邪鬼魅，小儿惊痫。久服令人肌润聪明，不饥，延年。干州者佳。去壳取佳，微炒去油。牡蛎、肉桂为使。"}]},{"ID":"20240607141314-qp88a2y","Type":"NodeParagraph","Properties":{"id":"20240607141314-qp88a2y","updated":"20240607141314"},"Children":[{"Type":"NodeText","Data":"畏菊花、羊蹄、诸石、面曲。侧柏叶，无毒。主吐血、衄血、血痢、崩中赤白、尿血及七情呕血、胸中疼痛、冷风历节疼痛、大风眉发脱落。久服去湿痹，耐寒暑，止饥，益气轻身。丹溪云∶性善守多燥，大益脾土，涩肺补阴之要药也。又止小儿泄痢，杀五脏虫。为末和油涂头，生发。炙热 冻疮，鼠 ，肿核。凡采叶随月建方，以取得月令之气也。去梗，糯米泔浸七日，炒。坟墓上者不可用。柏白皮，主中热，油及火灼烂疮，长毛发。为末，猪脂煎涂。柏枝节煮以酿酒，治风痹，历节风，烧汁涂 疥癞疮。"}]},{"ID":"20240607141320-sbqgag9","Type":"NodeThematicBreak","Properties":{"id":"20240607141320-sbqgag9"}},{"ID":"20240607141329-5bxmjgw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141329-5bxmjgw","updated":"20240607141335"},"Children":[{"Type":"NodeText","Data":"柏实《神农本草经读》"}]},{"ID":"20240607141329-8kvjlbq","Type":"NodeParagraph","Properties":{"id":"20240607141329-8kvjlbq","updated":"20240607141329"},"Children":[{"Type":"NodeText","Data":"气味甘、平。主惊悸平，（清心经之游火），安五脏，（滋润之功）。益气，（壮火食气火宁，则气益也）。除风湿痹，（得秋金之令，能燥湿平肝也）。久服令人润泽美色，耳目不饥不老，轻身延年。（柏之性不假灌溉而能寿也。）徐灵胎曰∶柏得天地坚刚之性以生，不与物变迁，经冬弥翠，故能宁心神，敛心气，而不为邪风游火所侵克也。人之生理谓之仁，仁藏于心。物之生机在于实，故实亦谓之仁。凡草木之仁，皆能养心气，以类相应也。"}]},{"ID":"20240607141330-macjdck","Type":"NodeThematicBreak","Properties":{"id":"20240607141330-macjdck"}},{"ID":"20240607141341-h63jwhb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141341-h63jwhb","updated":"20240607141346"},"Children":[{"Type":"NodeText","Data":"柏实《新修本草》"}]},{"ID":"20240607141341-f2vey93","Type":"NodeParagraph","Properties":{"id":"20240607141341-f2vey93","updated":"20240607141341"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主惊悸，安五脏，益气，除风湿痹。疗恍惚、虚损，吸吸历节，腰中重痛，益血，止汗。久服令人润泽、美色，耳目聪明，不饥、不老，轻身、延年。生太山山谷。"}]},{"ID":"20240607141341-kn0217m","Type":"NodeParagraph","Properties":{"id":"20240607141341-kn0217m","updated":"20240607141341"},"Children":[{"Type":"NodeText","Data":"柏叶尤良。柏叶，味苦，微温，无毒。主吐血，衄血，痢血，崩中，赤白，轻身益气，令人耐风寒，去湿痹，止饥。"}]},{"ID":"20240607141341-g4sqhhb","Type":"NodeParagraph","Properties":{"id":"20240607141341-g4sqhhb","updated":"20240607141341"},"Children":[{"Type":"NodeText","Data":"四时各依方面采，阴干。柏白皮，主火灼，烂疮，长毛发。"}]},{"ID":"20240607141341-zk9u7xv","Type":"NodeParagraph","Properties":{"id":"20240607141341-zk9u7xv","updated":"20240607141341"},"Children":[{"Type":"NodeText","Data":"牡蛎、桂、瓜子为之使，恶菊华、羊蹄、诸石及曲。柏叶、实亦为服食所重，炼饵别有法。柏处处有，当以太山为佳，并忌取冢墓上也。虽四时俱有，而秋夏为好，其脂亦入用。此云恶曲，人有以酿酒无妨，恐酒米相和，异单用也。"}]},{"ID":"20240607141341-21gdpti","Type":"NodeParagraph","Properties":{"id":"20240607141341-21gdpti","updated":"20240607141341"},"Children":[{"Type":"NodeText","Data":"〔谨案〕柏枝节，煮以酿酒，主风痹、历节风。烧取 ，疗 疥及癞疮尤良。今子仁唯出陕州、宜州为胜。太山无复采者也。"}]},{"ID":"20240607141342-4ghvjnt","Type":"NodeThematicBreak","Properties":{"id":"20240607141342-4ghvjnt"}},{"ID":"20240607141358-ox685dw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607141358-ox685dw","updated":"20240607141410"},"Children":[{"Type":"NodeText","Data":"柏实《本草乘雅半偈》"}]},{"ID":"20240607141404-frtl9ba","Type":"NodeParagraph","Properties":{"id":"20240607141404-frtl9ba","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"【气味】甘平，无毒。"}]},{"ID":"20240607141404-u7t3f60","Type":"NodeParagraph","Properties":{"id":"20240607141404-u7t3f60","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"【主治】主惊悸，益气，除风湿痹，安五脏。久服令人肥泽美色，耳目聪明，不饥不老，轻身延年。"}]},{"ID":"20240607141404-j288vj2","Type":"NodeParagraph","Properties":{"id":"20240607141404-j288vj2","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"【核】曰∶处处有之，当以太山、陕州、宜州、干陵者为胜。四季长青，叶叶侧生，枝枝西向，有三种。一名丛柏，枝叶丛叠，今人呼为千头。一名浑柏，独叶丛茂，木心紫赤，唯堪作香，皆不结实，不为药用。一名扁柏，木心微白，芳香清烈，作花细小，结实有角，四裂子出，尖小介壳，霜后采取，中仁黄白，最多脂液。唯干陵者，木理旋绕，宛若人物鸟兽状，陆离可观。修治蒸熟去皮壳，捣作饼子，日干收用。"}]},{"ID":"20240607141404-flm3y4l","Type":"NodeParagraph","Properties":{"id":"20240607141404-flm3y4l","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"先人云∶万木皆向阳，而柏独西指者，顺受金制以为用，乃能成其贞固而可久，故字从白。干枝叶实，为用有别，实具全体，内含章美，故入五脏。叶如脉络，故治络不坚固而溃，脉不摄溢而崩。枝则气倍于叶，故入肢节。干则气烈于枝，故主全身矣。圣惠方，以实治惊痫，及大便青白色者，盖肝木受制，怒则乘其所胜，是以青白之色见于便，而惊从藏发，匪实奚宜。"}]},{"ID":"20240607141404-4qy4n5s","Type":"NodeParagraph","Properties":{"id":"20240607141404-4qy4n5s","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"【 】曰∶柏芳香高洁，文彩陆离，即 天直上，谁能禁之。乃俯焉西向，以秉制所天，可谓至德也已。巨擘乔木，作社稷栋梁。宜哉殷人以柏，其逆知后世之西向乎。味甘美，性和平，对待肝木失制，发为惊骇悸忡，质坚固，气条达，驱除风湿成痹也。德润于身，安藏乐道，耳目聪明，色泽长生矣。"}]},{"ID":"20240607141404-70p68rs","Type":"NodeParagraph","Properties":{"id":"20240607141404-70p68rs","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"（山书云∶木植三百六十，而松柏为之长。史记云∶松柏为百木长，而守宫闾。公羊注云∶松，犹容也，想见其容貌而事之。柏，犹迫也。取亲而不远之义。故坛 丘墓多植之。"}]},{"ID":"20240607141404-wfaluzq","Type":"NodeParagraph","Properties":{"id":"20240607141404-wfaluzq","updated":"20240607141404"},"Children":[{"Type":"NodeText","Data":"埤雅云∶柏，掬也。性坚致，有脂而香，故古人破为畅臼，用以捣郁。杂记云∶畅臼以掬，杵以梧。广志云∶柏有续柏，有汁柏。崔实云∶七月收柏实。列仙传云∶赤松子好食柏实，齿落更生。王修赋云∶既殊群而抗立，亦含真而挺正，岂春日之自芳，必霜下而为盛。烈风不能摧其枝，积雪不能改其性。诗云∶泛彼柏舟，在彼中流。言柏非不可以为舟，特非柏之所宜。故其姜守义，引以自况也。世以柏之指西，犹磁之指南也。先人云∶柏从白，即具秉制为用象，抑木以金为魄欤。）"}]},{"ID":"20240617101913-shmlvno","Type":"NodeThematicBreak","Properties":{"id":"20240617101913-shmlvno"}},{"ID":"20240617101915-sa2bshk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101915-sa2bshk","updated":"20240617101920"},"Children":[{"Type":"NodeText","Data":"柏实《冯氏锦囊秘录》"}]},{"ID":"20240617101915-bquv0n0","Type":"NodeParagraph","Properties":{"id":"20240617101915-bquv0n0","updated":"20240617101915"},"Children":[{"Type":"NodeText","Data":"柏感秋令，最深得金气独浓，固凌冬不凋，其质坚而气极芬芳，故其实味甘，平，无毒。入足厥阴少阴，亦入手少阴经，专治心肾两虚，且芬芳则脾胃所喜，润泽则肝肾俱宜，五脏皆安，气血自益，湿痹除而颜色美，自可轻身延年矣。叶味苦微温无毒，宜春采东，夏采南，秋采西，冬采北，补益用九蒸九晒，止血用宜炒黑，以苦温之性，则祛湿痰痹，除热止血之功、独擅其长矣。"}]},{"ID":"20240617101915-5f3asw8","Type":"NodeParagraph","Properties":{"id":"20240617101915-5f3asw8","updated":"20240617101915"},"Children":[{"Type":"NodeText","Data":"柏实，入心养神，入肝定志养气血。去恍惚虚损。敛汗聪耳，却风寒湿痹止痛，治肾冷腰冷，并膀胱冷脓宿水，润肾燥体燥，及面颜燥涩不光，历节腰中重痛，兴阳道，辟百邪，止惊悸，安五脏，头风眩痛，亦可煎调，久服润泽肌肤，不饥不老，延年轻身，惟肠胃滑利者勿用。侧柏叶须照令采方，止吐衄崩痢，系补阴要药，兼燥湿仙丹，若合黄连煎服，小儿虫痢立痊，肢节酿酒，主历节风痹，并人畜疥癞。"}]},{"ID":"20240617101915-e7ekvfu","Type":"NodeParagraph","Properties":{"id":"20240617101915-e7ekvfu","updated":"20240617101915"},"Children":[{"Type":"NodeText","Data":"按∶柏叶生而向西，禀兑金之正气，能制肝木，木主升，金主降，升降相配，夫妇之道和，则血得以归肝，故仲景治吐血不止。然气味与血分无情，不过仗金气以制木，借炒黑以止红耳，岂可用以调补气血，长养精神矣！"}]},{"ID":"20240617101945-p0s4qll","Type":"NodeThematicBreak","Properties":{"id":"20240617101945-p0s4qll"}},{"ID":"20240617101936-fm64wva","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101936-fm64wva","updated":"20240617101940"},"Children":[{"Type":"NodeText","Data":"柏实《本草思辨录》"}]},{"ID":"20240617101936-gqh31kd","Type":"NodeParagraph","Properties":{"id":"20240617101936-gqh31kd","updated":"20240617101936"},"Children":[{"Type":"NodeText","Data":"柏为百木之长，叶独西指，是为金木相媾。仁则色黄白而味辛甘气清香，有脂而燥，虽润不腻。故肝得之而风虚能去，脾得之而湿痹能通，肺得之而大肠虚秘能已。竹皮大丸喘加柏实者，肺病亦肝病也。盖妇人乳中烦呕，是肝气之逆，逆则不下归肾而上冲肺。柏实得西指之气，能降肺以辑肝，喘宁有不止。此与他喘证不同，故用药亦异也。"}]},{"ID":"20240617101925-89dv9vt","Type":"NodeThematicBreak","Properties":{"id":"20240617101925-89dv9vt"}},{"ID":"20240617101926-e0e2tqa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101926-e0e2tqa","updated":"20240617101930"},"Children":[{"Type":"NodeText","Data":"柏实《神农本草经赞》"}]},{"ID":"20240617101926-rdm2fvz","Type":"NodeParagraph","Properties":{"id":"20240617101926-rdm2fvz","updated":"20240617101926"},"Children":[{"Type":"NodeText","Data":"味甘平。主惊悸。安五脏。益气。除湿痹。久服令人悦。泽美色。耳目聪明。不饥不老。轻身延年。生山谷。"}]},{"ID":"20240617101926-eu8bqdw","Type":"NodeParagraph","Properties":{"id":"20240617101926-eu8bqdw","updated":"20240617101926"},"Children":[{"Type":"NodeText","Data":"秉阴西指。托向东尊。球捎星缀。麦裂霜繁。香霏闻妙。酿熟含温。赤松习服。后雕同论。"}]},{"ID":"20240617101926-pl4t4ft","Type":"NodeParagraph","Properties":{"id":"20240617101926-pl4t4ft","updated":"20240617101926"},"Children":[{"Type":"NodeText","Data":"许赞歌。秉阴吸阳。六书精蕴。木皆属阳。而柏向阴指西。名医曰。生太山尤良。旧唐书志。位当东向之尊。张诗。捎球紫袖轻。范成大诗。垂垂万星球。李时珍曰。其实成球。霜后四裂。中有数子。大如麦粒。萧祗诗。霜繁绿更滋。杜甫诗。心清闻妙香。苏轼诗。坐对柏子香。雷论。凡使柏子。先以酒浸。缓火煎成膏为度。杨侃赋。椒桂含温。列仙传。赤松子好食柏。论语。岁寒。然后知松柏之后雕也。"}]},{"ID":"20240607141405-z2uox5l","Type":"NodeThematicBreak","Properties":{"id":"20240607141405-z2uox5l"}},{"ID":"20240617101858-2cikv4h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617101858-2cikv4h","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"柏《本草纲目》"}]},{"ID":"20240617101858-17aowm7","Type":"NodeParagraph","Properties":{"id":"20240617101858-17aowm7","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"「释名」侧柏。"}]},{"ID":"20240617101858-hrq89er","Type":"NodeParagraph","Properties":{"id":"20240617101858-hrq89er","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"「气味」柏实：甘、平、无毒。柏叶：苦、微温、无毒。"}]},{"ID":"20240617101858-0yssd05","Type":"NodeParagraph","Properties":{"id":"20240617101858-0yssd05","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240617101858-vcn22th","Type":"NodeParagraph","Properties":{"id":"20240617101858-vcn22th","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"柏实："}]},{"ID":"20240617101858-900zya1","Type":"NodeParagraph","Properties":{"id":"20240617101858-900zya1","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"1、平肝润肾。延年壮神。用柏实晒干，去壳，研末。每服二钱，温酒送下。一天服三次。又方：加松子仁等分，以松脂和丸服。又方：加菊花等分，以蜜和丸服。又方：用柏子仁二斤，研为末，泡酒中成膏，加枣肉三斤，白蜜、白术末、地黄末各一斤，捣匀做成丸子，如弹子大。每嚼一丸，一日三服。"}]},{"ID":"20240617101858-6ppa1ft","Type":"NodeParagraph","Properties":{"id":"20240617101858-6ppa1ft","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"2、老人便秘。用柏子仁、松子仁、大麻仁，等分同研，加蜜、蜡做成丸子，如梧子大。每服二、三十丸，饭前服，少黄丹汤调下。一天服二次。"}]},{"ID":"20240617101858-xiqvo7y","Type":"NodeParagraph","Properties":{"id":"20240617101858-xiqvo7y","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"3、肠风下血。用柏子十四个，捶碎，贮布袋中，加入好酒三碗，煎至八成服下。"}]},{"ID":"20240617101858-yever2i","Type":"NodeParagraph","Properties":{"id":"20240617101858-yever2i","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"4、小儿惊明腹满，大便青白色。用柏子仁研为还想，温水落石出调服一钱。"}]},{"ID":"20240617101858-k0ptf8c","Type":"NodeParagraph","Properties":{"id":"20240617101858-k0ptf8c","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"柏叶："}]},{"ID":"20240617101858-4slfi67","Type":"NodeParagraph","Properties":{"id":"20240617101858-4slfi67","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"1、中风（涎潮口噤，语言不出，手足垂）。用柏叶一把去枝，葱白一把连根研如泥，加酒一程式，煎开多次后温服。"}]},{"ID":"20240617101858-7ez6fzu","Type":"NodeParagraph","Properties":{"id":"20240617101858-7ez6fzu","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"2、霍乱转筋。用柏叶捣烂裹脚上，另外再煎汁淋洗。"}]},{"ID":"20240617101858-egdold7","Type":"NodeParagraph","Properties":{"id":"20240617101858-egdold7","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"3、吐血。用青柏叶一把、干姜二片、阿胶一挺（炙），加水二升，煮成一程式，去渣，另加马通汁一升，再合煎为一升，滤过，一次服下。"}]},{"ID":"20240617101858-6aj7koi","Type":"NodeParagraph","Properties":{"id":"20240617101858-6aj7koi","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"4、鼻血不止。用柏叶、榴花，共研为末，吹入鼻中。"}]},{"ID":"20240617101858-x36sy2b","Type":"NodeParagraph","Properties":{"id":"20240617101858-x36sy2b","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"5、尿血。用柏叶、黄连焙过，研细，酒送服三钱。"}]},{"ID":"20240617101858-ipupbo9","Type":"NodeParagraph","Properties":{"id":"20240617101858-ipupbo9","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"6、大肠下血。用柏叶烧存性，研为还末。每服二钱，米汤送下。"}]},{"ID":"20240617101858-eosh7h1","Type":"NodeParagraph","Properties":{"id":"20240617101858-eosh7h1","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"7、月经不断。用侧柏叶（炙）、芍药等分，每取三钱，加水、酒各半煎服。对未婚妇女，用侧柏叶、木（炒至微焦），等分为末。每服二钱，米汤送下。"}]},{"ID":"20240617101858-vch8v93","Type":"NodeParagraph","Properties":{"id":"20240617101858-vch8v93","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"8、汤火伤。用柏叶生捣涂搽，二、三日后，止痛灭瘢。"}]},{"ID":"20240617101858-c30saws","Type":"NodeParagraph","Properties":{"id":"20240617101858-c30saws","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"9、大麻风（眉发脱落）。有侧柏叶九蒸九晒后研为末，加炼蜜做成丸子，如梧子大。每服五至十丸。白天服三次，晚间服一次。百日之后，眉中可再生。"}]},{"ID":"20240617101858-dls1bj4","Type":"NodeParagraph","Properties":{"id":"20240617101858-dls1bj4","updated":"20240617101858"},"Children":[{"Type":"NodeText","Data":"10、头发不生。用侧柏叶阴干研末，和麻油涂搽。"}]},{"ID":"20240617101858-ipe1rip","Type":"NodeThematicBreak","Properties":{"id":"20240617101858-ipe1rip","updated":"20240617101858"}},{"ID":"20240617102232-gv9e1nv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102232-gv9e1nv","updated":"20240617102238"},"Children":[{"Type":"NodeText","Data":"柏子仁《药性切用》"}]},{"ID":"20240617102232-uvfm8em","Type":"NodeParagraph","Properties":{"id":"20240617102232-uvfm8em","updated":"20240617102232"},"Children":[{"Type":"NodeText","Data":"辛甘性平，其气芳香，入心脾而安神益智，润燥舒脾。多服反能致燥。炒研去油，勿用。"}]},{"ID":"20240617102233-ixigaqz","Type":"NodeThematicBreak","Properties":{"id":"20240617102233-ixigaqz"}},{"ID":"20240617102241-ss981am","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102241-ss981am","updated":"20240617102247"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草害利》"}]},{"ID":"20240617102241-mmmh0f8","Type":"NodeParagraph","Properties":{"id":"20240617102241-mmmh0f8","updated":"20240617102241"},"Children":[{"Type":"NodeText","Data":"〔害〕仁体多油辛润，且滑肠，泄泻者勿服。膈间多痰，及阳道数举，肾家有热，暑湿作泻，法在咸禁。"}]},{"ID":"20240617102241-c7iqonv","Type":"NodeParagraph","Properties":{"id":"20240617102241-c7iqonv","updated":"20240617102241"},"Children":[{"Type":"NodeText","Data":"〔利〕甘辛香平，入心养神，入肾定志安神，定悸壮水，强阳，润血而容颜美少，补虚而耳目聪明。"}]},{"ID":"20240617102241-elyjqof","Type":"NodeParagraph","Properties":{"id":"20240617102241-elyjqof","updated":"20240617102241"},"Children":[{"Type":"NodeText","Data":"〔修治〕九月采子，蒸曝春 ，取仁，酒浸一宿，晒干炒研去油用，油透者，勿入药。"}]},{"ID":"20240617102242-l05swqv","Type":"NodeThematicBreak","Properties":{"id":"20240617102242-l05swqv"}},{"ID":"20240617102250-dc5kyi2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102250-dc5kyi2","updated":"20240617102255"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草撮要》"}]},{"ID":"20240617102250-myn11ht","Type":"NodeParagraph","Properties":{"id":"20240617102250-myn11ht","updated":"20240617102250"},"Children":[{"Type":"NodeText","Data":"味甘．入足厥阴经．功专养心平肝润肾．得远志能交通心肾．得松子、麻仁治老人虚秘．炒研去油用．捣涂黄水疮甚效．畏菊花．"}]},{"ID":"20240617102251-nxkp861","Type":"NodeThematicBreak","Properties":{"id":"20240617102251-nxkp861"}},{"ID":"20240617102259-ollwoen","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102259-ollwoen","updated":"20240617102304"},"Children":[{"Type":"NodeText","Data":"柏子仁《要药分剂》"}]},{"ID":"20240617102259-87a9w9p","Type":"NodeParagraph","Properties":{"id":"20240617102259-87a9w9p","updated":"20240617102259"},"Children":[{"Type":"NodeText","Data":"味辛甘。性平。无毒。畏菊花。"}]},{"ID":"20240617102259-swwiikk","Type":"NodeParagraph","Properties":{"id":"20240617102259-swwiikk","updated":"20240617102259"},"Children":[{"Type":"NodeText","Data":"【主治】主惊悸。安五脏。益气。除风湿痹。久服令人润泽。耳目聪明。（本经）疗恍惚虚损【归经】入心经。兼入肝肾二经。为滋润之品。（养心气润肾燥透心肾而悦脾助脾滋肝）【前论】苏颂曰。凡补脾药多燥。此润药而其气清香。大能舒脾。燥脾药中。兼用最良。"}]},{"ID":"20240617102259-lkousvz","Type":"NodeParagraph","Properties":{"id":"20240617102259-lkousvz","updated":"20240617102259"},"Children":[{"Type":"NodeText","Data":"此【禁忌】经疏曰。肠滑作泻。膈间多痰。阳道数举。肾家有热。暑湿作泻者。均忌。"}]},{"ID":"20240617102259-xjzyqn1","Type":"NodeParagraph","Properties":{"id":"20240617102259-xjzyqn1","updated":"20240617102259"},"Children":[{"Type":"NodeText","Data":"【炮制】雷公曰。酒浸一宿。晒干炒研去油用。油透者勿用。"}]},{"ID":"20240617102300-prvwcs3","Type":"NodeThematicBreak","Properties":{"id":"20240617102300-prvwcs3"}},{"ID":"20240617102308-chfoo2j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102308-chfoo2j","updated":"20240617102313"},"Children":[{"Type":"NodeText","Data":"柏子仁《玉楸药解》"}]},{"ID":"20240617102308-ir9evzb","Type":"NodeParagraph","Properties":{"id":"20240617102308-ir9evzb","updated":"20240617102308"},"Children":[{"Type":"NodeText","Data":"味甘、辛，气平，入足少阴脾、手阳明大肠、手少阴心、足厥阴肝经。润燥除湿，"}]},{"ID":"20240617102308-1uoog74","Type":"NodeParagraph","Properties":{"id":"20240617102308-1uoog74","updated":"20240617102308"},"Children":[{"Type":"NodeText","Data":"敛气宁神。"}]},{"ID":"20240617102308-crx99eg","Type":"NodeParagraph","Properties":{"id":"20240617102308-crx99eg","updated":"20240617102308"},"Children":[{"Type":"NodeText","Data":"柏子仁辛香甘涩，秉燥金敛肃之气，而体质则极滋润，能收摄神魂，宁安惊悸，滑肠开秘，荣肝起痿，明目聪耳，健膝强腰，泽润舒筋，敛血止汗。燥可泻湿，润亦清风，至善之品。"}]},{"ID":"20240617102308-660zab0","Type":"NodeParagraph","Properties":{"id":"20240617102308-660zab0","updated":"20240617102308"},"Children":[{"Type":"NodeText","Data":"蒸晒舂簸，取仁，炒研。烧沥取油，光泽须发。涂抹癣疥，搽黄水疮湿，最效。"}]},{"ID":"20240617102308-t03wpmu","Type":"NodeThematicBreak","Properties":{"id":"20240617102308-t03wpmu"}},{"ID":"20240617102316-dj065s1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102316-dj065s1","updated":"20240617102320"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草求真》"}]},{"ID":"20240617102316-1o6ggau","Type":"NodeParagraph","Properties":{"id":"20240617102316-1o6ggau","updated":"20240617102316"},"Children":[{"Type":"NodeText","Data":"（香木）养心血"}]},{"ID":"20240617102316-nli5lkl","Type":"NodeParagraph","Properties":{"id":"20240617102316-nli5lkl","updated":"20240617102316"},"Children":[{"Type":"NodeText","Data":"柏子仁（专入心）。辛甘平润。考书俱言四脏皆补。究之止属心药耳。盖香虽能补脾。而实可以通窍而入心。润虽可以补肝而益肾。而实可以宁神而定智。甘虽足以和胃而固中。而实足以益血而神守。是以风湿可除。惊痫可疗。邪魅可辟。皮肤可泽。惟见神恬气适。耳聪目明。而无枯槁燥涩之患矣。然性多润滑。（凡仁皆润。）阴寒泄泻者切忌。气多香泄。体虚火盛者亦忌。若云不饥不老。延年轻身。虽出经典。仍当活视。毋为书执。蒸熟曝干自裂。入药炒研去油用。畏菊花。"}]},{"ID":"20240617102316-es9dfq0","Type":"NodeThematicBreak","Properties":{"id":"20240617102316-es9dfq0"}},{"ID":"20240617102324-yw1ox9m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102324-yw1ox9m","updated":"20240617102329"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草分经》"}]},{"ID":"20240617102324-dz6fyhr","Type":"NodeParagraph","Properties":{"id":"20240617102324-dz6fyhr","updated":"20240617102324"},"Children":[{"Type":"NodeText","Data":"辛甘平，气香性润，透心脾滋肝肾，养血止汗除风湿，助脾药中惟此不燥。"}]},{"ID":"20240617102325-1ym15ng","Type":"NodeThematicBreak","Properties":{"id":"20240617102325-1ym15ng"}},{"ID":"20240617102332-a42t2v4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102332-a42t2v4","updated":"20240617102338"},"Children":[{"Type":"NodeText","Data":"柏子仁《汤液本草》"}]},{"ID":"20240617102332-poue68f","Type":"NodeParagraph","Properties":{"id":"20240617102332-poue68f","updated":"20240617102332"},"Children":[{"Type":"NodeText","Data":"气平，味甘、辛。无毒。"}]},{"ID":"20240617102332-cecob24","Type":"NodeParagraph","Properties":{"id":"20240617102332-cecob24","updated":"20240617102332"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主安五脏，除风湿痹，益气血。能长生，令人润泽，美颜色，耳目聪明。"}]},{"ID":"20240617102332-492cp14","Type":"NodeParagraph","Properties":{"id":"20240617102332-492cp14","updated":"20240617102332"},"Children":[{"Type":"NodeText","Data":"用之则润，肾之药也。"}]},{"ID":"20240617102332-bg8ror6","Type":"NodeParagraph","Properties":{"id":"20240617102332-bg8ror6","updated":"20240617102332"},"Children":[{"Type":"NodeText","Data":"《药性论》云∶柏子仁，君。恶菊花，畏羊蹄草。能治腰肾中冷，膀胱冷脓宿水；兴阳道，益寿；去头风，治百邪鬼魅，主小儿惊痫。柏子仁，古方十精丸用之。"}]},{"ID":"20240617102333-tejdcl7","Type":"NodeThematicBreak","Properties":{"id":"20240617102333-tejdcl7"}},{"ID":"20240617102341-dok0d0b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102341-dok0d0b","updated":"20240617102348"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草便读》"}]},{"ID":"20240617102341-u37iw7s","Type":"NodeParagraph","Properties":{"id":"20240617102341-u37iw7s","updated":"20240617102341"},"Children":[{"Type":"NodeText","Data":"补心脾而畅中快膈．味贵甘辛．定惊悸以益智安神．性平香润．（柏子仁味甘辛平．芳香而润．入心脾气分．以其入心．故能益智安神．疗惊悸．治健忘．以其入脾．故又能快膈调中．美颜色．泽肌肤．盖柏禀坚贞之气．而子乃柏之精英也．）"}]},{"ID":"20240617102342-n8sv3hx","Type":"NodeThematicBreak","Properties":{"id":"20240617102342-n8sv3hx"}},{"ID":"20240617102352-3f1mpgk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102352-3f1mpgk","updated":"20240617102357"},"Children":[{"Type":"NodeText","Data":"柏子仁《顾松园医镜》"}]},{"ID":"20240617102352-81vj7i6","Type":"NodeParagraph","Properties":{"id":"20240617102352-81vj7i6","updated":"20240617102352"},"Children":[{"Type":"NodeText","Data":"〔甘平，入心、肝、肾三经。蒸晒或炒研。〕安神定悸，〔心藏神，肾藏志，入心养神，入肾定志，则神安而惊悸自除。〕壮水强阳。〔肾藏精，肾恶燥，润肾补肾。则精足而阳强。〕益血而容颜美少，补虚而耳目聪明。〔悦颜聪明，皆心血与肾水互相灌溉耳。又心主五色，耳为肾窍，目为肝窍，三脏得补之功也。〕养心气，润肝肾，芳香能益脾胃，滋养之上品药也。"}]},{"ID":"20240617102352-07lfuul","Type":"NodeParagraph","Properties":{"id":"20240617102352-07lfuul","updated":"20240617102352"},"Children":[{"Type":"NodeText","Data":"多油而滑，作泻者勿服，多痰者亦忌。有油透者勿入药。"}]},{"ID":"20240617102352-q98aswl","Type":"NodeThematicBreak","Properties":{"id":"20240617102352-q98aswl"}},{"ID":"20240617102401-zk834dj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102401-zk834dj","updated":"20240617102406"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草备要》"}]},{"ID":"20240617102401-xrpe76a","Type":"NodeParagraph","Properties":{"id":"20240617102401-xrpe76a","updated":"20240617102401"},"Children":[{"Type":"NodeText","Data":"补心脾，润肝肾"}]},{"ID":"20240617102401-6wrox7j","Type":"NodeParagraph","Properties":{"id":"20240617102401-6wrox7j","updated":"20240617102401"},"Children":[{"Type":"NodeText","Data":"辛甘而润。其气清香，能透心肾而悦脾（昂按∶凡补脾药多燥，此润药而香能舒脾，燥脾药中兼用最良）。养心气，润肾燥，助脾滋肝（王好古曰∶肝经气分药），益智宁神（养心）"}]},{"ID":"20240617102401-e0lptme","Type":"NodeParagraph","Properties":{"id":"20240617102401-e0lptme","updated":"20240617102401"},"Children":[{"Type":"NodeText","Data":"，聪耳明目（甘益血，香通窍），益血止汗（心生血，汗为心液），除风湿。愈惊痫，泽皮肤，辟鬼魅。"}]},{"ID":"20240617102401-74x6nfx","Type":"NodeParagraph","Properties":{"id":"20240617102401-74x6nfx","updated":"20240617102401"},"Children":[{"Type":"NodeText","Data":"炒研去油，油透者勿用。畏菊花。"}]},{"ID":"20240617102401-0a94c75","Type":"NodeThematicBreak","Properties":{"id":"20240617102401-0a94c75"}},{"ID":"20240617102410-lvf6tod","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102410-lvf6tod","updated":"20240617102415"},"Children":[{"Type":"NodeText","Data":"柏子仁《本草经解》"}]},{"ID":"20240617102410-iplyjou","Type":"NodeParagraph","Properties":{"id":"20240617102410-iplyjou","updated":"20240617102410"},"Children":[{"Type":"NodeText","Data":"气平．味甘．无毒．主惊悸．益气除风湿．安五脏．久服令人润泽美色．耳目聪明．不饥不老．轻身延年．柏仁 气平．禀天秋平之金气．入手太阴肺经．味甘无毒．得地中正之土味．入足太阴脾经．以其仁也．兼入手少阴心经．气升味和．阳也．心者神之舍也．心神不宁．则病惊悸．柏仁入心．惊者平之．气平．平惊悸也．益气者．气平益肺气．味甘益脾气．滋润益心气也．治风先治血．血行风自灭．柏仁味甘益脾血．血行风息而脾健运．湿亦下逐矣．盖太阴乃湿土之经也．五脏藏阴者也．脾为阴气之原．心为生血之脏．肺为津液之腑．柏仁平甘益阴．阴足则五脏皆安矣．久服甘平益血．令面光华．心为君主．主明则十二官皆安．耳目聪明矣．味甘益脾．不饥不老．气平益肺．轻身延年也．"}]},{"ID":"20240617102410-04dj7z3","Type":"NodeParagraph","Properties":{"id":"20240617102410-04dj7z3","updated":"20240617102410"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240617102410-u80lep7","Type":"NodeParagraph","Properties":{"id":"20240617102410-u80lep7","updated":"20240617102410"},"Children":[{"Type":"NodeText","Data":"柏仁同松仁、麻仁．治老人虚闭．同白术、生地、枣肉丸．治心脾虚．"}]},{"ID":"20240617102411-9bf54bg","Type":"NodeThematicBreak","Properties":{"id":"20240617102411-9bf54bg"}},{"ID":"20240617102426-yl1p6pd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617102426-yl1p6pd","updated":"20240617102431"},"Children":[{"Type":"NodeText","Data":"柏子仁《中药学》"}]},{"ID":"20240617102426-8cxmmtv","Type":"NodeParagraph","Properties":{"id":"20240617102426-8cxmmtv","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【药用】本品为柏科植物侧柏的种仁。"}]},{"ID":"20240617102426-4op4tl3","Type":"NodeParagraph","Properties":{"id":"20240617102426-4op4tl3","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘、辛，平。入心、肝、肾经。"}]},{"ID":"20240617102426-wdpumcc","Type":"NodeParagraph","Properties":{"id":"20240617102426-wdpumcc","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【功效】养心安神，润肠通便。"}]},{"ID":"20240617102426-8znrz9r","Type":"NodeParagraph","Properties":{"id":"20240617102426-8znrz9r","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于虚烦失眼、心悸怔忡等症。"}]},{"ID":"20240617102426-m24ht32","Type":"NodeParagraph","Properties":{"id":"20240617102426-m24ht32","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"柏子仁滋养阴血，功能养心安神，常与酸枣仁、生地等药治疗血不养心、虚烦不眠之症。"}]},{"ID":"20240617102426-pahbn64","Type":"NodeParagraph","Properties":{"id":"20240617102426-pahbn64","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"2.用于肠燥便秘。"}]},{"ID":"20240617102426-zd5aq3c","Type":"NodeParagraph","Properties":{"id":"20240617102426-zd5aq3c","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"柏子仁质地滋润，有润肠之功，故可用于阴虚、年老、产后等肠燥便秘之症，临床多配合大麻仁、胡桃肉等同用。"}]},{"ID":"20240617102426-cc141ua","Type":"NodeParagraph","Properties":{"id":"20240617102426-cc141ua","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【处方用名】柏子仁（用时打碎）"}]},{"ID":"20240617102426-7jjsvf5","Type":"NodeParagraph","Properties":{"id":"20240617102426-7jjsvf5","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240617102426-yuiqx5k","Type":"NodeParagraph","Properties":{"id":"20240617102426-yuiqx5k","updated":"20240617102426"},"Children":[{"Type":"NodeText","Data":"【方剂举例】养心汤《证治准绳》：柏子仁、酸枣仁、远志、五味子、当归、川芎、人参、茯苓、黄耆、茯神、肉桂、半夏曲、甘草。治心血不足，怔忡惊悸。"}]},{"ID":"20240617102427-mgfw4br","Type":"NodeThematicBreak","Properties":{"id":"20240617102427-mgfw4br"}},{"ID":"20240617102428-nsaqd3f","Type":"NodeParagraph","Properties":{"id":"20240617102428-nsaqd3f"}}]}