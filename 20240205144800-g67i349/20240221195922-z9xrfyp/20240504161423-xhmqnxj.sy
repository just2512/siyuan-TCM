812130539-5ocfemx","Type":"NodeParagraph","Properties":{"id":"20240812130539-5ocfemx","updated":"20240812130539"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 466px;","style":"width: 456px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"胡麻 (24)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/胡麻 24-20240812130539-67r132b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 456px;\" parent-style=\"width: 466px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 352px;","style":"width: 342px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"胡麻 (26)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/胡麻 26-20240812131302-3v2vaa4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 342px;\" parent-style=\"width: 352px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 352px;","style":"width: 342px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"胡麻 (27)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/胡麻 27-20240812131600-y2dpt2o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 342px;\" parent-style=\"width: 352px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812131646-acj6k4u","Type":"NodeParagraph","Properties":{"id":"20240812131646-acj6k4u","updated":"20240812131657"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 344px;","style":"width: 334px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"胡麻 (28)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/胡麻 28-20240812131646-7czsynf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 334px;\" parent-style=\"width: 344px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 801px;","style":"width: 791px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"胡麻 (25)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/胡麻 25-20240812131036-d8ilv0j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 791px;\" parent-style=\"width: 801px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808141709-mopdh48","Type":"NodeParagraph","Properties":{"id":"20240808141709-mopdh48","updated":"20240812125810"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为胡麻叶；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240504164239-op19vvv","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"136胡麻"}]},{"ID":"20240607132654-ma5evb2","Type":"NodeThematicBreak","Properties":{"id":"20240607132654-ma5evb2","updated":"20240812125810"}},{"ID":"20240607132655-denztf2","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607132655-denztf2","updated":"20240607132700"},"Children":[{"Type":"NodeText","Data":"青蘘《神农本草经》"}]},{"ID":"20240607132655-gs1jxkj","Type":"NodeParagraph","Properties":{"id":"20240607132655-gs1jxkj","updated":"20240607132655"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240607132655-2lfluh1","Type":"NodeParagraph","Properties":{"id":"20240607132655-2lfluh1","updated":"20240607132655"},"Children":[{"Type":"NodeText","Data":"主五脏邪气，风寒湿痹，益气，补脑髓，坚筋骨。久服耳目聪明，不饥不老，增寿，巨胜苗也。生川谷（旧在米谷部，非）。"}]},{"ID":"20240607132655-qd59hrc","Type":"NodeParagraph","Properties":{"id":"20240607132655-qd59hrc","updated":"20240607132655"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：青襄，一名梦神，神农苦，雷公甘（《御览》）。"}]},{"ID":"20240607132655-4dgkbg8","Type":"NodeParagraph","Properties":{"id":"20240607132655-4dgkbg8","updated":"20240607132655"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生中原。"}]},{"ID":"20240607132655-2ho94c2","Type":"NodeParagraph","Properties":{"id":"20240607132655-2ho94c2","updated":"20240607132655"},"Children":[{"Type":"NodeText","Data":"案《抱朴子·仙药》云：孝经援神契曰，巨胜延年，又云巨胜，一名胡麻，饵服之不老，耐风湿，补衰老也。"}]},{"ID":"20240607132656-c8d84mh","Type":"NodeThematicBreak","Properties":{"id":"20240607132656-c8d84mh"}},{"ID":"20240617085610-jij9lw2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617085610-jij9lw2","updated":"20240617085624"},"Children":[{"Type":"NodeText","Data":"青蘘《新修本草》"}]},{"ID":"20240617085610-sfspg08","Type":"NodeParagraph","Properties":{"id":"20240617085610-sfspg08","updated":"20240617085610"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主五脏邪气，风寒湿痹，益气，补脑髓，坚筋骨。久服耳目聪明，不饥，不老，增寿。巨胜苗也。生中原川谷。"}]},{"ID":"20240617085610-abido0e","Type":"NodeParagraph","Properties":{"id":"20240617085610-abido0e","updated":"20240617085610"},"Children":[{"Type":"NodeText","Data":"胡麻叶。甚肥滑，亦可以沐头，但不知云何服之。仙方并无用此法，正当阴干，捣为丸散耳。既服其实，故不复假苗。五符巨胜丸方亦云：叶名青蘘。本生大宛，度来千年耳。"}]},{"ID":"20240617085610-dk1wm83","Type":"NodeParagraph","Properties":{"id":"20240617085610-dk1wm83","updated":"20240617085610"},"Children":[{"Type":"NodeText","Data":"〔谨案〕青蘘，《本经》在草部上品中，既堪啖，今从胡麻条下。"}]},{"ID":"20240617085611-e6r6vzv","Type":"NodeThematicBreak","Properties":{"id":"20240617085611-e6r6vzv"}},{"ID":"20240617085659-kci3tqe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617085659-kci3tqe","updated":"20240617085714"},"Children":[{"Type":"NodeText","Data":"青蘘《证类本草》"}]},{"ID":"20240617085659-vj9qgo6","Type":"NodeParagraph","Properties":{"id":"20240617085659-vj9qgo6","updated":"20240617085719"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主五脏邪气，风寒湿痹，益气，补脑髓，坚筋骨。久服耳目聪明，不饥，不老，增寿。巨胜苗也。生中原川谷。"}]},{"ID":"20240617085659-c3ef11o","Type":"NodeParagraph","Properties":{"id":"20240617085659-c3ef11o","updated":"20240617085724"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶胡麻叶也。甚肥滑，亦可以沐头，但不知云何服之。仙方∶并无用此法，正当阴干，捣为丸散尔。既服其实，故不复假苗。五符巨胜丸方∶亦云∶叶名青 。本生大宛，度来《本经》在草部上品中，既堪啖，今从胡麻条下。"}]},{"ID":"20240617085659-vuzcjj1","Type":"NodeParagraph","Properties":{"id":"20240617085659-vuzcjj1","updated":"20240617085659"},"Children":[{"Type":"NodeText","Data":"图经文具胡麻条下。"}]},{"ID":"20240617085659-cck6f3s","Type":"NodeParagraph","Properties":{"id":"20240617085659-cck6f3s","updated":"20240617085659"},"Children":[{"Type":"NodeText","Data":"食疗∶生杵汁，沐头发良。牛伤热亦灌之，立愈。"}]},{"ID":"20240617085659-kfc5doq","Type":"NodeParagraph","Properties":{"id":"20240617085659-kfc5doq","updated":"20240617085659"},"Children":[{"Type":"NodeText","Data":"衍义曰∶青 （音箱），即油麻叶也。陶隐居《注》亦曰∶胡麻叶也。胡地脂麻鹊色，子颇大日华子云∶叶作汤沐，润毛发，乃是今人所取胡麻叶。以汤浸之，良久涎出，汤遂稠黄色，妇人用之梳发。由是言之，胡麻与白油麻，今之所谓脂麻者是矣。青 即其叶无疑。"}]},{"ID":"20240617085659-x5caq2q","Type":"NodeThematicBreak","Properties":{"id":"20240617085659-x5caq2q"}},{"ID":"20240617085702-a1q7bsm","Type":"NodeParagraph","Properties":{"id":"20240617085702-a1q7bsm"}}]}