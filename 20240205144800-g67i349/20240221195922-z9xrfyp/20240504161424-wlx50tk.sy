":"width: 877px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树 7-20240808175854-9ou2jwv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 877px;\" parent-style=\"width: 887px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 398px;","style":"width: 388px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树 6-20240808175738-61ljvvs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 388px;\" parent-style=\"width: 398px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808175715-43ioskt","Type":"NodeParagraph","Properties":{"id":"20240808175715-43ioskt","updated":"20240808175715"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 492px;","style":"width: 482px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树-20240620141053-92n6h43.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 482px;\" parent-style=\"width: 492px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 784px;","style":"width: 774px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树 5-20240808175708-hbdrr5o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 774px;\" parent-style=\"width: 784px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808172232-kiw11td","Type":"NodeParagraph","Properties":{"id":"20240808172232-kiw11td","updated":"20240808175458"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 695px;","style":"width: 685px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树 3-20240808175458-qz31lee.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 685px;\" parent-style=\"width: 695px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 585px;","style":"width: 575px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树-20240808172232-nvogwe3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 575px;\" parent-style=\"width: 585px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808172301-98aroaf","Type":"NodeParagraph","Properties":{"id":"20240808172301-98aroaf","updated":"20240808175552"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 901px;","style":"width: 891px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树 1-20240808172301-ya2tw47.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 891px;\" parent-style=\"width: 901px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 386px;","style":"width: 376px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松树 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松树 4-20240808175552-iylxjnp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 376px;\" parent-style=\"width: 386px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607140247-hbj5xdb","Type":"NodeThematicBreak","Properties":{"id":"20240607140247-hbj5xdb"}},{"ID":"20240617095920-seudin0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095920-seudin0","updated":"20240617095925"},"Children":[{"Type":"NodeText","Data":"松脂《神农本草经》"}]},{"ID":"20240617095920-gdpj6oh","Type":"NodeParagraph","Properties":{"id":"20240617095920-gdpj6oh","updated":"20240617095920"},"Children":[{"Type":"NodeText","Data":"味苦温。"}]},{"ID":"20240617095920-nlrwvad","Type":"NodeParagraph","Properties":{"id":"20240617095920-nlrwvad","updated":"20240617095920"},"Children":[{"Type":"NodeText","Data":"主疽，恶创头疡，白秃，疥搔，风气，五藏，除热。久服，轻身不老，延年。一名松膏，一名松肪。生山谷。"}]},{"ID":"20240617095920-rvjmvuy","Type":"NodeParagraph","Properties":{"id":"20240617095920-rvjmvuy","updated":"20240617095920"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生太山，六月采。"}]},{"ID":"20240617095920-n9vcp4s","Type":"NodeParagraph","Properties":{"id":"20240617095920-n9vcp4s","updated":"20240617095920"},"Children":[{"Type":"NodeText","Data":"案《说文》云：松木也，或作；《范子计然》云：松脂出陇西，松胶者善。"}]},{"ID":"20240607140248-m86b4l9","Type":"NodeThematicBreak","Properties":{"id":"20240607140248-m86b4l9"}},{"ID":"20240607140249-5wlf5nq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140249-5wlf5nq","updated":"20240607140255"},"Children":[{"Type":"NodeText","Data":"松脂《证类本草》"}]},{"ID":"20240607140300-ypkh6ot","Type":"NodeParagraph","Properties":{"id":"20240607140300-ypkh6ot","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"味苦、甘，温，无毒。主疽，恶疮，头疡，白秃，疥瘙风气，安五脏，除热，胃中伏热，咽干，消渴，及风痹死肌。炼之令白。其赤者主恶痹。久服轻身，不老延年，一名松膏，一名松肪。生太山山谷。六月采。"}]},{"ID":"20240607140300-kqtzj9r","Type":"NodeParagraph","Properties":{"id":"20240607140300-kqtzj9r","updated":"20240607140300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"松实"},{"Type":"NodeText","Data":"味苦，温，无毒。主风痹寒气，虚羸少气，补不足。九月采，阴干。"}]},{"ID":"20240607140300-l8ozvib","Type":"NodeParagraph","Properties":{"id":"20240607140300-l8ozvib","updated":"20240607140300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"松叶"},{"Type":"NodeText","Data":"味苦，温。主风湿疮，生毛发，安五脏，守中，不饥延年。臣禹锡等谨按日华子云"}]},{"ID":"20240607140300-h1x8nnu","Type":"NodeParagraph","Properties":{"id":"20240607140300-h1x8nnu","updated":"20240607140300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"松节"},{"Type":"NodeText","Data":"温。主百节久风，风虚，脚痹疼痛。"}]},{"ID":"20240607140300-5zg2rdm","Type":"NodeParagraph","Properties":{"id":"20240607140300-5zg2rdm","updated":"20240607140300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"松根白皮"},{"Type":"NodeText","Data":"主辟谷不饥。"}]},{"ID":"20240607140300-i3wi9en","Type":"NodeParagraph","Properties":{"id":"20240607140300-i3wi9en","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶采炼松脂法，并在服食方中，以桑灰汁或酒煮软，挪内寒水中数十过，白滑则可用。其有自流出者，乃胜于凿树及煮用膏也。其实不可多得，唯叶只是断谷所宜，细切如粟，以水及面饮服之。亦有阴干捣为屑，丸服者。人患恶病，服此无不瘥。比来苦脚弱人，酿松节酒亦皆愈。松、柏皆有脂润，又凌冬不凋，理为佳物，但人多轻忽近易之尔。唐本注云∶松花，名松黄，拂取似蒲黄正尔，酒服身轻，疗病云胜皮、叶及脂。其子味甚甘。《经》直云味苦，非也。松取枝烧其上，下承取汁名 （音诣）。主牛马疮疥佳。树皮绿衣名艾，合和诸香烧之，其烟团聚，青白可爱也。臣禹锡等谨按药性论松脂，使，味甘，平。杀虫用之。主耳聋，牙有 孔，少许咬之不落，虫自死，能贴诸疮脓血，煎膏生肌止痛，抽风。"}]},{"ID":"20240607140300-frdpna8","Type":"NodeParagraph","Properties":{"id":"20240607140300-frdpna8","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"萧炳云∶又有五叶者，一丛五叶如钗，名五粒松，道家服食绝粒，子如巴豆，新罗往往进之。日华子云∶松脂，润心肺，下气，除邪，煎膏治 烂，排脓。又云松叶，暖，无毒。灸冻疮，风湿疮佳。又云松节，无毒。治脚软，骨节风。又云松根白皮，味苦，温，无毒。补五劳，益气。"}]},{"ID":"20240607140300-vdwssi5","Type":"NodeParagraph","Properties":{"id":"20240607140300-vdwssi5","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"图经曰∶松脂，生泰山山谷，今处处有之。其用以通明如薰陆香颗者为胜。道人服饵，或合茯苓、松柏实、菊花作丸，皆先炼治。其法用大釜加水置甑，用白茅藉甑底，又加黄砂于茅上，浓寸许可矣。然后布松脂于上，炊以桑薪，汤减即添热水，常令满。候松脂尽入釜中，乃出之，投于冷水，既凝又蒸，如此三过，其白如玉，然后入药，亦可单服。其实及根白皮，古亦有服食法，但今松实多作果品，余不闻堪入药。其花上黄粉名松黄，山人及时拂取，作汤点之甚佳，但不堪停久，故鲜用寄远。烧其枝上，下承取汁液，名松 （音诣）。"}]},{"ID":"20240607140300-efk5eua","Type":"NodeParagraph","Properties":{"id":"20240607140300-efk5eua","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"主牛马疮。皮上绿衣名艾 香，用合诸香烧之，其烟不散。方书言松为五粒，字当读为鬣，音之误也。言每五鬣为一叶，或有两鬣、七鬣者。松岁久则实繁，中原虽有，然不及塞上有佳好也。中品有墨条，不载所出州郡，然亦出于松，故附见于此。"}]},{"ID":"20240607140300-91be7r9","Type":"NodeParagraph","Properties":{"id":"20240607140300-91be7r9","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"圣惠方绝谷升仙不食法∶取松实捣为膏，酒调下三钱，日三。则不饥渴饮水，勿食他物，百日身轻，日行五百里。又方服松叶，令人不老，身生绿毛，轻身益气，久服不已。绝谷不饥渴，松叶不以多少，细切更研，每日食前以酒调下二钱，亦可粥汁服之。初服稍难，久自便矣。又方治牙龈历虫，齿根暗黑。用松节烧灰揩之，神效。又方治一切 。炼成松脂末填疮孔令满，日三、四度用之。又方神仙饵松实，用七月取松实，过时即落难收，去木皮，捣如膏。每服如鸡子大，日三服，服及百日，身轻，三百日，日行五百里，绝谷，久服升仙，渴即饮水，亦可以炼了松脂同服之。外台秘要集验疗龋齿。取松脂锐如锥， 龋孔内，须臾龋虫缘松脂出。《梅师方》同。又方治恶风疾。松脂炼，投冷水中，二十遍，蜜丸。服二两，饥松脂三十斤，炼五十遍。不能五十遍，亦可二十遍。用以炼酥三升温和松脂三升熟，搅令极稠。旦空腹以酒服方寸匕，日三。数食面粥为佳，慎血腥、生冷、酢物、果子，一百日瘥。"}]},{"ID":"20240607140300-d8197sk","Type":"NodeParagraph","Properties":{"id":"20240607140300-d8197sk","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"又方松节酒。主历节风，四肢疼痛。如解落。松脂二十斤，酒五斗，渍三七日，服一合，日五、六服。千金方治香港脚十二风痹，不能行，服更生散数剂及众疗不得力，服此一剂，更能行远，不过两剂。松叶酒∶松叶六十斤，细锉 咀，以水四石，煮取四斗九升，以酿五斗米如常法，别煮松叶汁以渍米并 饭泥酿，封头七日，发，澄。饮之取醉，得此酒力者甚众。"}]},{"ID":"20240607140300-jdud8tl","Type":"NodeParagraph","Properties":{"id":"20240607140300-jdud8tl","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"又方治历节风。松叶捣取一升，以酒三升浸七日，服一合，日三服。又方治口 。青松叶一斤，捣令汁出，精酒一升浸二宿，近火一宿，初且半升，渐至一升，头面汗即止。又方治三年中风不效者。松叶一斤，细切之，以酒一斗，煮取三升。顿服取汗出，立瘥。千金翼若齿黑。以松末灰揩之，末雄黄涂龈上百日，神效。梅师方治耳久聋。松脂三两，炼巴豆一两，相和熟捣可丸，通过以薄绵裹，内耳孔中塞之，日一度易。孙尚药治脚转筋，疼痛挛急者。"}]},{"ID":"20240607140300-kyqapnl","Type":"NodeParagraph","Properties":{"id":"20240607140300-kyqapnl","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"松节一两，细锉如米粒，乳香一钱，右件药用银、石器内慢火炒令焦，只留一、二分性，出火毒研细。每服一钱至二钱，热木瓜酒调下。应是筋病，皆治之。兵部手集疗刺入肉疼闷，百理不瘥方∶松脂流出如细乳头香者，敷疮上以帛裹三、五日，当有根出，不痛不痒，不觉自落。鬼遗方治疥癣。松胶香研细，约酌入少轻粉衮令匀，凡疥癣上先用油涂了，错末一日便干，顽者三、两度。伤寒类要治天行病。辟温方∶切松叶如米，酒服方寸匕，日三，辟五年瘟，抱朴子赵瞿病癞历年，医不瘥，家乃 粮弃送于山穴中。瞿自怨不幸，悲叹涕泣经月，有仙人经穴，见之哀之，具问其详，瞿知其异人也。叩头自陈，乞命。于是仙人取囊中药赐之。教其服百余日，疮愈，颜色悦，肌肤润。仙人再过视之，瞿谢活命之恩，乞遗其方。"}]},{"ID":"20240607140300-1j8rq5e","Type":"NodeParagraph","Properties":{"id":"20240607140300-1j8rq5e","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"仙人曰∶此是松脂，彼中极多。汝可炼服之，长服身转轻，力百倍，登危涉险，终日不困。"}]},{"ID":"20240607140300-v2xoeid","Type":"NodeParagraph","Properties":{"id":"20240607140300-v2xoeid","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"年百岁，齿不堕，发不白。夜卧常见有光。大如镜。列仙传 好食松实，能飞行健走及马，以松子遗尧，尧不能服。松者， 松也。野人闲话伏虎尊师篇炼松脂法∶十斤松脂，五度以水煮过，令苦味尽，取得后，每一斤炼了松脂，入四两茯苓末。每晨水下一刀圭，即终年不食，而复延龄，身轻清爽。"}]},{"ID":"20240607140300-hbthr2n","Type":"NodeParagraph","Properties":{"id":"20240607140300-hbthr2n","updated":"20240607140300"},"Children":[{"Type":"NodeText","Data":"衍义曰∶松黄一如蒲黄，但其味差淡。治产后壮热、头痛颊赤、口干唇焦、多烦燥渴、昏闷不爽。松花、川芎、当归、石膏、蒲黄五物等同为末。每服二钱，水二合，红花二捻，同煎七分，去滓，粥后温温细呷。松子，多海东来，今关右亦有，但细小味薄，与柏子仁同治虚秘。"}]},{"ID":"20240607140301-txm892w","Type":"NodeThematicBreak","Properties":{"id":"20240607140301-txm892w"}},{"ID":"20240607140326-es3stb0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140326-es3stb0","updated":"20240607140331"},"Children":[{"Type":"NodeText","Data":"松脂《本草经集注》"}]},{"ID":"20240607140326-v497o7m","Type":"NodeParagraph","Properties":{"id":"20240607140326-v497o7m","updated":"20240607140326"},"Children":[{"Type":"NodeText","Data":"味苦、甘，温，无毒。主治痈疽，恶疮，头疡，白秃，疥瘙，风气，安五脏，除热。"}]},{"ID":"20240607140326-12y0bgz","Type":"NodeParagraph","Properties":{"id":"20240607140326-12y0bgz","updated":"20240607140326"},"Children":[{"Type":"NodeText","Data":"胃中伏热，咽干，消渴，及风痹死肌。炼之令白。其赤者主恶风痹。久服轻身，不老延年。一名松膏，一名松肪。生大山山谷，六月采。松实，味苦，无毒，温。主风痹，寒气，虚羸、少气，补不足。九月采，阴干。松叶，味苦，温。主风湿痹疮气，生毛发，安五脏，守中，不饥、延年。松节，温。主百节久风、风虚，脚痹、疼痛。松根白皮，主辟谷不饥。"}]},{"ID":"20240607140326-xv5k30v","Type":"NodeParagraph","Properties":{"id":"20240607140326-xv5k30v","updated":"20240607140326"},"Children":[{"Type":"NodeText","Data":"采炼松脂法，并在服食方中，以桑灰汁若酒煮辄，纳寒水中数十过，白滑则可用。其有自出者，乃胜于凿树及煮膏也。其实不可多得，唯叶止是断谷所宜尔。细切如粟，以水及面饮服之。亦有阴干捣为屑、丸服者。人患恶病，服此无不瘥。比来苦脚弱人，酿松节酒，亦皆愈。松柏皆有脂润，又凌冬不凋，理为佳物，但人多轻忽近易之耳。（《新修》九○页，《大观》卷十二，《政和》二九一页）"}]},{"ID":"20240607140326-h71tyfu","Type":"NodeThematicBreak","Properties":{"id":"20240607140326-h71tyfu"}},{"ID":"20240607140359-sa1imcu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140359-sa1imcu","updated":"20240607140404"},"Children":[{"Type":"NodeText","Data":"松脂《本草从新》"}]},{"ID":"20240607140359-obcx7mp","Type":"NodeParagraph","Properties":{"id":"20240607140359-obcx7mp","updated":"20240607140359"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名松香、一名沥青、燥湿祛风．"}]},{"ID":"20240607140359-l15jj3c","Type":"NodeParagraph","Properties":{"id":"20240607140359-l15jj3c","updated":"20240607140359"},"Children":[{"Type":"NodeText","Data":"苦甘温燥．祛风去湿．化毒生肌止痛．熬膏而贴．崩中恶痹牙疼．研末而尝．（龋齿有孔、松脂 塞、虫即从齿出．）感太阳之气而生．燥可去湿．甘能除热．故外科取用极多．性温而燥．血虚者勿服．水煮百沸．白滑方可用．（圣惠方、治小儿紧唇、松脂炙化贴之．）"}]},{"ID":"20240607140359-nerrrew","Type":"NodeParagraph","Properties":{"id":"20240607140359-nerrrew","updated":"20240607140359"},"Children":[{"Type":"NodeText","Data":"松节（燥湿祛风．）苦温而燥．治骨节间之风湿．（丹溪曰∶能燥血中之湿．）燥性过于松脂．"}]},{"ID":"20240607140359-cogtjgg","Type":"NodeParagraph","Properties":{"id":"20240607140359-cogtjgg","updated":"20240607140359"},"Children":[{"Type":"NodeText","Data":"血虚尤忌．杵碎浸酒良．"}]},{"ID":"20240607140359-55znq97","Type":"NodeParagraph","Properties":{"id":"20240607140359-55znq97","updated":"20240607140359"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"松毛"},{"Type":"NodeText","Data":"（祛风生毛发．）苦温．可生毛发．宜敷冻疮及风湿诸疮．忌同松脂．切细用．（简便方、治阴囊湿痒、松毛煎汤频洗．）"}]},{"ID":"20240607140359-cv9tjn1","Type":"NodeParagraph","Properties":{"id":"20240607140359-cv9tjn1","updated":"20240607140359"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"松花"},{"Type":"NodeText","Data":"（润、益气祛风．）甘温．润心肺益气．止血除风．亦可酿酒．（须及时取用、不堪久停、今人和白沙糖、印为糕饼、颇佳．）善糁诸痘疮伤损．并湿烂不痂．多食发上焦热病．"}]},{"ID":"20240607140404-sdwlz3f","Type":"NodeThematicBreak","Properties":{"id":"20240607140404-sdwlz3f"}},{"ID":"20240617100057-rmb9vx1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617100057-rmb9vx1","updated":"20240617100102"},"Children":[{"Type":"NodeText","Data":"松脂《本草述钩元》"}]},{"ID":"20240617100057-yc299ho","Type":"NodeParagraph","Properties":{"id":"20240617100057-yc299ho","updated":"20240617100106"},"Children":[{"Type":"NodeText","Data":"俗名松香。"}]},{"ID":"20240617100057-62y2znv","Type":"NodeParagraph","Properties":{"id":"20240617100057-62y2znv","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"味苦甘，气温平。"}]},{"ID":"20240617100057-8vziibs","Type":"NodeParagraph","Properties":{"id":"20240617100057-8vziibs","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"主治痈疽恶疮，头疡白秃，疥瘙风气。（《本经》）"}]},{"ID":"20240617100057-f2tuo0i","Type":"NodeParagraph","Properties":{"id":"20240617100057-f2tuo0i","updated":"20240617100108"},"Children":[{"Type":"NodeText","Data":"除胃中伏热，咽干消渴，除邪下气，润心肺，古方多用辟谷。"}]},{"ID":"20240617100057-nqxj530","Type":"NodeParagraph","Properties":{"id":"20240617100057-nqxj530","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"〔附方〕历节诸风，百节酸痛不可忍。松脂三十斤，炼五十遍，以炼酥三升，和脂三升，搅令极稠。每旦，空心酒服方寸匕，日三服。数食面粥为佳，慎血腥生冷酢物果子，一百日瘥。"}]},{"ID":"20240617100057-5xyrqdr","Type":"NodeParagraph","Properties":{"id":"20240617100057-5xyrqdr","updated":"20240617100110"},"Children":[{"Type":"NodeText","Data":"服食松脂得仙，须以桑柴灰淋汁煮十遍，又以酒煮二遍，去苦涩，倾入冷水中，候凝为末，酒服。然多致肠塞而死，不可轻信。惟为散熬膏，贴疮良。"}]},{"ID":"20240617100057-r9cwccz","Type":"NodeParagraph","Properties":{"id":"20240617100057-r9cwccz","updated":"20240617100111"},"Children":[{"Type":"NodeText","Data":"●松节"}]},{"ID":"20240617100057-bhol4rt","Type":"NodeParagraph","Properties":{"id":"20240617100057-bhol4rt","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"气味苦温。"}]},{"ID":"20240617100057-gh0er78","Type":"NodeParagraph","Properties":{"id":"20240617100057-gh0er78","updated":"20240617100114"},"Children":[{"Type":"NodeText","Data":"主治百节久风风虚，脚痹疼痛。炒焦，治筋骨间病，能燥血中之湿，疗风蛀牙痛。（煎水含漱，或烧灰日揩，效。）历节风痛，四肢如解脱，松节酒，用节二十，酒五斗，浸三七日，每服一合，日五六服。"}]},{"ID":"20240617100057-udu0wb2","Type":"NodeParagraph","Properties":{"id":"20240617100057-udu0wb2","updated":"20240617100120"},"Children":[{"Type":"NodeText","Data":"转筋挛急，松节一两，锉如米大，乳香一钱，银石器慢火炒焦，存一二分性，出火毒，研末。每服一二钱，熟木瓜酒调下，一应筋病皆治之。"}]},{"ID":"20240617100057-vckq8b9","Type":"NodeParagraph","Properties":{"id":"20240617100057-vckq8b9","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"〔合论松脂松节〕松禀真阳之质，凌冬不凋。松之有脂，如人有血，其主治痈疽疮秃疥瘙风气，皆血中眚也。惟兹味出于真阳，《本经》故举在上在表者言之。丹溪曰：松脂属阳金，伏汞制砂。是则为真阳中之阴，犹之砂中汞火中液，与人身肺阴入心而生血者同。粗工乃以燥言，亦知《别录》所云除胃中伏热咽干消渴，日华子所言除邪下气润心肺者，可以燥目之乎。（阳中化阴，则胃中自无伏热，而咽干消渴自除。阳中阴化，则上焦之邪除。而气自下，心肺自润。）"}]},{"ID":"20240617100057-9nq6qdg","Type":"NodeParagraph","Properties":{"id":"20240617100057-9nq6qdg","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"方书历节风之治，松脂与松节并施。第松脂治血中之风，松节则纯乎阳，能燥血中之湿。夫血中之风，阳中之阴不足，血中之湿，阴中之阳不足也。松节燥湿，何以又云治风，盖湿不化则风生，是为阳虚之风。《别录》言疗风虚，其有确见哉。"}]},{"ID":"20240617100057-brcr2zn","Type":"NodeParagraph","Properties":{"id":"20240617100057-brcr2zn","updated":"20240617100122"},"Children":[{"Type":"NodeText","Data":"●松花"}]},{"ID":"20240617100057-losmasa","Type":"NodeParagraph","Properties":{"id":"20240617100057-losmasa","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"气味甘温。"}]},{"ID":"20240617100057-96la6oo","Type":"NodeParagraph","Properties":{"id":"20240617100057-96la6oo","updated":"20240617100123"},"Children":[{"Type":"NodeText","Data":"润心肺，益气，除风止血。"}]},{"ID":"20240617100057-052nuoq","Type":"NodeParagraph","Properties":{"id":"20240617100057-052nuoq","updated":"20240617100126"},"Children":[{"Type":"NodeText","Data":"治吐血久不止，有松花散。（《准绳》）"}]},{"ID":"20240617100057-9ebio7f","Type":"NodeParagraph","Properties":{"id":"20240617100057-9ebio7f","updated":"20240617100127"},"Children":[{"Type":"NodeText","Data":"松花即松黄，拂取正似蒲黄，酒服令轻身，疗病胜似皮叶及脂也。（恭）"}]},{"ID":"20240617100057-8w4wok3","Type":"NodeParagraph","Properties":{"id":"20240617100057-8w4wok3","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"不堪停久，故鲜用寄远。（颂）"}]},{"ID":"20240617100057-8ovgaod","Type":"NodeParagraph","Properties":{"id":"20240617100057-8ovgaod","updated":"20240617100057"},"Children":[{"Type":"NodeText","Data":"多食，发上焦热病。（丹溪）"}]},{"ID":"20240607140422-y3g7he1","Type":"NodeThematicBreak","Properties":{"id":"20240607140422-y3g7he1"}},{"ID":"20240607140435-tgjilzl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140435-tgjilzl","updated":"20240607140440"},"Children":[{"Type":"NodeText","Data":"松脂《名医别录》"}]},{"ID":"20240607140435-9gy070n","Type":"NodeParagraph","Properties":{"id":"20240607140435-9gy070n","updated":"20240607140435"},"Children":[{"Type":"NodeText","Data":"味甘，无毒，主治胃中伏热，咽干，消渴，及风痹、死肌．炼之令白．其赤者治恶风生太山，六月采．"}]},{"ID":"20240617100153-c4qqjlp","Type":"NodeThematicBreak","Properties":{"id":"20240617100153-c4qqjlp"}},{"ID":"20240617100154-nz0zyg6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617100154-nz0zyg6","updated":"20240617100157"},"Children":[{"Type":"NodeText","Data":"松脂《新修本草》"}]},{"ID":"20240617100154-nk6i1yl","Type":"NodeParagraph","Properties":{"id":"20240617100154-nk6i1yl","updated":"20240617100154"},"Children":[{"Type":"NodeText","Data":"味苦、甘，温，无毒。主痈疽、恶疮，头疡、白秃，疥瘙、风气，安五脏，除热，胃中伏热，咽干，消渴，及风痹死肌。练之令白。其赤者主恶风痹，久服轻身，不老、延年。一名松膏，一名松肪。生大山山谷。六月采。松实，味苦，无毒温。主风痹，寒气，虚羸、少气，补不足。九月采，阴干。松叶，味苦，温。主风湿痹疮气，生毛发，安五脏，守中，不饥、延年。松节，温。主百节久风、风虚，脚痹、疼痛。松根白皮，主辟谷不饥。"}]},{"ID":"20240617100154-5672gxf","Type":"NodeParagraph","Properties":{"id":"20240617100154-5672gxf","updated":"20240617100154"},"Children":[{"Type":"NodeText","Data":"采炼松脂法，并在服食方中，以桑灰汁苦酒煮辄，内寒水中数十过，白滑则可用。其有自流出者，乃胜于凿树及煮膏也。其实不可多得，唯叶止是断谷所宜尔。细切如粟，以水及面饮服之。亦有阴干捣为屑、丸服者。人患恶病，服此无不瘥。比来苦脚弱人，酿松节酒，亦皆愈。松柏皆有脂润，又凌冬不凋，理为佳物，但人多轻忽近易之耳。"}]},{"ID":"20240617100154-hi3837e","Type":"NodeParagraph","Properties":{"id":"20240617100154-hi3837e","updated":"20240617100210"},"Children":[{"Type":"NodeText","Data":"〔谨案〕松花，名松黄，拂取似蒲黄，正尔酒服轻身，疗病云胜皮、叶及脂。其子味甚甘，经直云味苦，非也。松取枝烧其上，下承取汁名 ，主牛马疮疥为佳。树皮绿衣名艾纳，合和诸香烧之，其烟团聚,青白可爱也。"}]},{"ID":"20240607140440-z5les35","Type":"NodeThematicBreak","Properties":{"id":"20240607140440-z5les35"}},{"ID":"20240607140459-sxjy7ns","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140459-sxjy7ns","updated":"20240607140503"},"Children":[{"Type":"NodeText","Data":"松脂《本草崇原》"}]},{"ID":"20240607140459-g770fsa","Type":"NodeParagraph","Properties":{"id":"20240607140459-g770fsa","updated":"20240607140459"},"Children":[{"Type":"NodeText","Data":"气味苦甘温，无毒。主治痈疽恶疮，头疮白秃，疥瘙风气，安五脏，除热。久服轻身，不老延年。"}]},{"ID":"20240607140459-46gewe1","Type":"NodeParagraph","Properties":{"id":"20240607140459-46gewe1","updated":"20240607140459"},"Children":[{"Type":"NodeText","Data":"（松木之脂，俗名松香，处处山中有之，其木修耸多节，其皮粗浓有鳞，其叶有两鬣、五鬣、七鬣，其花蕊为松黄，结实状如猪心，木之余气结为茯苓，松脂入土，年深化成琥珀。其脂以通明如熏陆香颗者为胜，乃服食辟谷之品，神仙不老之妙药也。熬化滤过即为沥青。）"}]},{"ID":"20240607140459-hkytt48","Type":"NodeParagraph","Properties":{"id":"20240607140459-hkytt48","updated":"20240607140459"},"Children":[{"Type":"NodeText","Data":"松脂生于松木之中，禀木质而有火土金水之用。气味苦温，得火气也。得火气，故治肌肉之痈，经脉之疽，以及阴寒之恶疮。入土成珀，坚洁如金，裕金气也。裕金气，故治头疡白秃，以及疥瘙之风气。色黄臭香，味苦而甘，备土气也。备土气，故安五脏。木耐岁寒，经冬不凋，具水气也。具水气，故除热。久服则五运全精，故轻身，不老延年。"}]},{"ID":"20240607140503-vt5o499","Type":"NodeThematicBreak","Properties":{"id":"20240607140503-vt5o499"}},{"ID":"20240607140509-8aww8eq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140509-8aww8eq","updated":"20240607140513"},"Children":[{"Type":"NodeText","Data":"松脂《冯氏锦囊秘录》"}]},{"ID":"20240607140509-zof6jk8","Type":"NodeParagraph","Properties":{"id":"20240607140509-zof6jk8","updated":"20240607140509"},"Children":[{"Type":"NodeText","Data":"感天太阳之气，得地火土之化，故味苦兼甘，气温无毒。甘能解毒，苦能泄热，温能祛风除湿，所以外贴疮毒，长肉杀虫，内服逐诸风，主恶痹，安五脏，除伏热，总祛风散湿则有功，血虚有火切忌。"}]},{"ID":"20240607140509-kegn28i","Type":"NodeParagraph","Properties":{"id":"20240607140509-kegn28i","updated":"20240607140509"},"Children":[{"Type":"NodeText","Data":"松脂，阳脂补阳，阴脂补阴，照方制炼，如五加、茯苓、柏实、甘菊为丸，酒吞，或为单服，逐诸风，安五脏，除伏热胃脘，解消渴咽喉，轻身延年通神，熬膏贴疮毒长肉，作散治齿痛杀虫。实，味甘气温性和无毒，精不足者补之以味，形不足者温之以气，味甘气温故主少气虚羸，兼驱风痹，久服延年轻身，惟此足以当之。花虽轻身益气，发热上焦。节性温，乃松之骨也。质坚气劲，以类相从，故功专于肢节，舒筋止肢节之痛，去湿搜骨内之风，燥血中之湿，却脚痹软症， 节诸风，渍酒可服。叶味苦温，能生毛发，捣烂敷风湿疮毒，悬挂辟瘟疫气。"}]},{"ID":"20240607140509-z943cmg","Type":"NodeParagraph","Properties":{"id":"20240607140509-z943cmg","updated":"20240607140509"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 松花善掺诸痘疮伤损，及湿料烂不痂。"}]},{"ID":"20240607140513-tuzwrr4","Type":"NodeThematicBreak","Properties":{"id":"20240607140513-tuzwrr4"}},{"ID":"20240607140526-s83qu6l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140526-s83qu6l","updated":"20240607140533"},"Children":[{"Type":"NodeText","Data":"松脂《增广和剂局方药性总论》"}]},{"ID":"20240607140526-ixk97mq","Type":"NodeParagraph","Properties":{"id":"20240607140526-ixk97mq","updated":"20240607140526"},"Children":[{"Type":"NodeText","Data":"味苦甘，温，无毒。主痈疽恶疮，头疡白秃，疥瘙风气，安五脏，除热，胃中伏热，干，消渴及风痹死肌。实∶主风痹寒气。虚羸少气，补不足。叶∶主风湿疮，安五脏，不节∶主百节久风风虚，脚痹疼痛。根白皮∶主辟谷。《药性论》云∶使。杀虫，主耳聋。日华子云∶润心肺，下气，除邪。煎膏治 烂，排脓。"}]},{"ID":"20240607140527-gts8nvr","Type":"NodeThematicBreak","Properties":{"id":"20240607140527-gts8nvr"}},{"ID":"20240607140538-nz2vk4d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140538-nz2vk4d","updated":"20240607140551"},"Children":[{"Type":"NodeText","Data":"松脂《本草乘雅半偈》"}]},{"ID":"20240607140546-nj6wv9o","Type":"NodeParagraph","Properties":{"id":"20240607140546-nj6wv9o","updated":"20240607140546"},"Children":[{"Type":"NodeText","Data":"【气味】苦甘温，无毒。"}]},{"ID":"20240607140546-lchhz6s","Type":"NodeParagraph","Properties":{"id":"20240607140546-lchhz6s","updated":"20240607140546"},"Children":[{"Type":"NodeText","Data":"【主治】主痈疽恶疮，头疡白秃，疥瘙风气，安五脏，除热。久服轻身，不老延年。"}]},{"ID":"20240607140546-mqnu8bg","Type":"NodeParagraph","Properties":{"id":"20240607140546-mqnu8bg","updated":"20240607140546"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出太山山谷，处处亦有。今以塞上、衡山者为良。其树修耸多节，其皮粗浓有鳞，其叶凌冬不凋。二三月抽蕤，长三五寸，谓之松黄。放花结实，状如荔枝，叠成鳞砌，秋老则子长鳞裂，随风飞散，着土便生。其脂通明，宛如熏陆香，以松皮内自然凝聚，及流结根底，不见日月者为第一，凿取者次之，煮成者不堪用，宜六月采。修治∶用一大釜，釜中置水，釜上置甑，甑中用白茅藉甑底，更置黄沙于茅上，浓寸许。然后布脂，炊以桑薪，汤减频加热水。俟脂尽入釜中，乃出之，投于冷水，既凝又蒸，凡三度，则色白如玉，入钵徐研，钵底置水，方易细。陶贞白云∶采炼松脂法，并在服食方中，以桑灰汁，或酒，煮软，纳寒水中，数十过，白滑则可用。震亨云∶松脂属阳金，伏汞，制砂，粉银可作匮也。"}]},{"ID":"20240607140546-s0xfbpf","Type":"NodeParagraph","Properties":{"id":"20240607140546-s0xfbpf","updated":"20240607140546"},"Children":[{"Type":"NodeText","Data":"【 】曰∶松有脂，如人有血，血余则发华不槁，脂余则叶华不凋。松针上指，宛如须发，心之血分药也。痈疽恶疮，头疡白秃，疥瘙风气，此血中眚，因于血液枯涸，致火气流亢合五行，色黄可入脾，坚凝可入肺，长生可入肝，不凋可入肾，味苦气温可入心，五行周备，故安五脏。若苦能除热，假阴润丽泽之质耳。"}]},{"ID":"20240607140546-ovjw6ek","Type":"NodeParagraph","Properties":{"id":"20240607140546-ovjw6ek","updated":"20240607140546"},"Children":[{"Type":"NodeText","Data":"（百木夭，其气与液，仅自周其急也。松木寿，岂其自周。其气之余为苓，其液之余为脂，为珀，咸成不朽。）"}]},{"ID":"20240607140546-yv4mfux","Type":"NodeThematicBreak","Properties":{"id":"20240607140546-yv4mfux"}},{"ID":"20240607140556-pylqeed","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607140556-pylqeed","updated":"20240607140601"},"Children":[{"Type":"NodeText","Data":"松脂《神农本草经百种录》"}]},{"ID":"20240607140556-o5a2zmd","Type":"NodeParagraph","Properties":{"id":"20240607140556-o5a2zmd","updated":"20240607140556"},"Children":[{"Type":"NodeText","Data":"味苦温。主疽恶疮，头疡白秃，疥瘙除湿火所化之病。风气，香散风。安五脏，补脂液。除热。性耐寒暑。久服，轻身，不老延年。松多脂而寿故也。"}]},{"ID":"20240607140556-okak3hp","Type":"NodeParagraph","Properties":{"id":"20240607140556-okak3hp","updated":"20240607140556"},"Children":[{"Type":"NodeText","Data":"松之精气在皮，故其脂皆生于皮。其质粘腻似湿，而性极燥，故凡湿热之在皮肤者，皆能治之。凡痈疽疮疥之疾，皆皮肤湿火所郁，必腐肉伤皮，流脓结痂而后愈。松之皮，日易月新，脂从皮出，全无伤损，感其气者，即成脓脱痂而愈。义取其象之肖也。"}]},{"ID":"20240607140556-v6fmwio","Type":"NodeThematicBreak","Properties":{"id":"20240607140556-v6fmwio"}},{"ID":"20240617095816-fltiqie","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240617095816-fltiqie","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松"}]},{"ID":"20240617095816-p0upqvf","Type":"NodeParagraph","Properties":{"id":"20240617095816-p0upqvf","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"「释名」松膏、松肪、松胶、松香、沥青。"}]},{"ID":"20240617095816-hewtoum","Type":"NodeParagraph","Properties":{"id":"20240617095816-hewtoum","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"「气味」"}]},{"ID":"20240617095816-zbjrefd","Type":"NodeParagraph","Properties":{"id":"20240617095816-zbjrefd","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松脂：苦、甘、温、无毒。"}]},{"ID":"20240617095816-znn79ua","Type":"NodeParagraph","Properties":{"id":"20240617095816-znn79ua","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松节：苦、温、无毒。"}]},{"ID":"20240617095816-78c925s","Type":"NodeParagraph","Properties":{"id":"20240617095816-78c925s","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松叶：苦、温、无毒。"}]},{"ID":"20240617095816-qll0ojp","Type":"NodeParagraph","Properties":{"id":"20240617095816-qll0ojp","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松花：甘、温、无毒。"}]},{"ID":"20240617095816-5uais5l","Type":"NodeParagraph","Properties":{"id":"20240617095816-5uais5l","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240617095816-gdb8pmh","Type":"NodeParagraph","Properties":{"id":"20240617095816-gdb8pmh","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"1、关节酸疼。用松脂三十斤，炼五十遍，每取三升，和炼酥三升，搅稠。每天清晨空心服一匙。一天服在次。服药期间，以面食为好。忌食血腥、生冷、酸物。百日病愈。"}]},{"ID":"20240617095816-hy9khpn","Type":"NodeParagraph","Properties":{"id":"20240617095816-hy9khpn","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"2、肝虚目泪。用炼过的松脂一斤、米二斗、水七斗、曲二斗造酒频饮。"}]},{"ID":"20240617095816-slfbtt3","Type":"NodeParagraph","Properties":{"id":"20240617095816-slfbtt3","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"3、妇女白带。用松香五两、酒二升，煮干，捣烂，加酒、糊做成丸子，如梧子大。每服百丸，温酒送下。"}]},{"ID":"20240617095816-bqiwies","Type":"NodeParagraph","Properties":{"id":"20240617095816-bqiwies","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"4、风虫牙痛。把松脂在滚水中泡化，漱口，痛即止。"}]},{"ID":"20240617095816-3wluu2j","Type":"NodeParagraph","Properties":{"id":"20240617095816-3wluu2j","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"5、龋齿有孔。有棉裹松脂塞孔中。"}]},{"ID":"20240617095816-picfb2z","Type":"NodeParagraph","Properties":{"id":"20240617095816-picfb2z","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"6、久聋不听。用炼松脂三两，巴豆一两，和捣成丸，薄棉裹定塞耳中，一天二次。"}]},{"ID":"20240617095816-6dludh4","Type":"NodeParagraph","Properties":{"id":"20240617095816-6dludh4","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"7、一切肿毒。用松香八两、铜青二钱、蓖麻仁五钱，同捣作膏，摊贴患处。"}]},{"ID":"20240617095816-opa0fbc","Type":"NodeParagraph","Properties":{"id":"20240617095816-opa0fbc","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"8、疥癣湿疮。有松香研为末，加轻粉少许，先以油涂疮上，再撒上药末。几次即见效。"}]},{"ID":"20240617095816-emco5qv","Type":"NodeParagraph","Properties":{"id":"20240617095816-emco5qv","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"9、阴事宜湿痒。用松香末卷入纸筒内，每筒加花椒三粒，油浸三日，令纸筒燃烧滴油，取油搽患处。搽油前，以淘米水把患处洗净。"}]},{"ID":"20240617095816-vzagf37","Type":"NodeParagraph","Properties":{"id":"20240617095816-vzagf37","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松节："}]},{"ID":"20240617095816-37fa9w7","Type":"NodeParagraph","Properties":{"id":"20240617095816-37fa9w7","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"1、关节风痛。用松节（按：即松的茎干上的瘤状节）泡酒，每服一俣，一天服五、六次。"}]},{"ID":"20240617095816-iz6tm4l","Type":"NodeParagraph","Properties":{"id":"20240617095816-iz6tm4l","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"2、转筋挛急。用松节一两，锉细，加乳香一钱，慢火炒焦，出火毒，研为末，每服一、二钱，热木瓜酒调下。"}]},{"ID":"20240617095816-veujgic","Type":"NodeParagraph","Properties":{"id":"20240617095816-veujgic","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"3、风热牙痛。有油松节如枣大一块，切碎，加胡椒七个，浸热酒中，乘热再加飞过的白矾少许，即取以漱口，一、五次后见交。又方：用松节二两、槐白皮、地骨皮各一两，煎汤漱口，热漱冷吐。"}]},{"ID":"20240617095816-1ura28u","Type":"NodeParagraph","Properties":{"id":"20240617095816-1ura28u","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"4、反胃吐食。用松节煎酒细饮。"}]},{"ID":"20240617095816-kkrrrke","Type":"NodeParagraph","Properties":{"id":"20240617095816-kkrrrke","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"5、跌扑伤损。用松节煎酒服。"}]},{"ID":"20240617095816-36t9azd","Type":"NodeParagraph","Properties":{"id":"20240617095816-36t9azd","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松叶："}]},{"ID":"20240617095816-updcfkk","Type":"NodeParagraph","Properties":{"id":"20240617095816-updcfkk","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"1、预防瘟疫。有松叶切细，每服一匙，酒送下，一天服三次，能防时疫。"}]},{"ID":"20240617095816-0m71utk","Type":"NodeParagraph","Properties":{"id":"20240617095816-0m71utk","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"2、中风口邪。有箐松叶一斤，捣成汁，放酒中浸两宿，又在火旁取温一宿，初服半升，渐加至一升，以头面出汗为度。"}]},{"ID":"20240617095816-9q31atw","Type":"NodeParagraph","Properties":{"id":"20240617095816-9q31atw","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"3、关节风痛。用松叶捣汁一升，在酒在升中浸七日，每服一合。一天服三次。"}]},{"ID":"20240617095816-p8t0m2i","Type":"NodeParagraph","Properties":{"id":"20240617095816-p8t0m2i","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"4、脚气风疮。用松叶六十斤，锉细，加水四石，煮成五斗，和米五斗照常法酿酒。七日后，取酒饮，以醉为度。"}]},{"ID":"20240617095816-v8fqwk0","Type":"NodeParagraph","Properties":{"id":"20240617095816-v8fqwk0","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"5、风牙肿痛。有松叶一把、盐一合、酒二升，共煎含漱。"}]},{"ID":"20240617095816-ncs72pi","Type":"NodeParagraph","Properties":{"id":"20240617095816-ncs72pi","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"6、大风恶疮。用松叶二斤、麻黄（去节）五两，锉细，泡酒二斗中。几日后，每次温服一小碗，服至见效为止。"}]},{"ID":"20240617095816-41rbwqh","Type":"NodeParagraph","Properties":{"id":"20240617095816-41rbwqh","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"7、阴囊湿痒。用松叶煎汤多洗。"}]},{"ID":"20240617095816-pjyaai1","Type":"NodeParagraph","Properties":{"id":"20240617095816-pjyaai1","updated":"20240617095816"},"Children":[{"Type":"NodeText","Data":"松花：润心肺、益气、除风、止血。"}]},{"ID":"20240617100021-3ydmhgw","Type":"NodeThematicBreak","Properties":{"id":"20240617100021-3ydmhgw"}},{"ID":"20240617100022-l8np428","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617100022-l8np428","updated":"20240617100026"},"Children":[{"Type":"NodeText","Data":"松脂《医学入门》"}]},{"ID":"20240617100022-gbja0bl","Type":"NodeParagraph","Properties":{"id":"20240617100022-gbja0bl","updated":"20240617100022"},"Children":[{"Type":"NodeText","Data":"松脂苦甘温无毒，风痹恶癞并头秃，清胃伏热润心肺，生津固齿明耳目。"}]},{"ID":"20240617100022-z0d4jef","Type":"NodeParagraph","Properties":{"id":"20240617100022-z0d4jef","updated":"20240617100022"},"Children":[{"Type":"NodeText","Data":"松液流地凝成。主恶风，历节酸痛，风痹死肌，痈疽，恶风癞疮瘙疥，头疡白秃。煎膏贴诸疮 烂，排脓生肌止痛，抽风杀虫，除胃中伏热，润心肺，生津止渴，固齿，聪耳明目。入滋补药和服，壮阳实阴茎，令人有子，久服轻身延年。通明者佳。用河水煮化，投冷水内，令两人扯拔，既凝再煮，如此三次，再用酒煮三次，仍前扯拔，以白如饴糖为度。煎膏药用桃、柳、桑、槐、芙蓉叶煎水煮拔。凡用，入石臼内另捣为末，不可晒焙，亦不可单服，塞实肠胃。"}]},{"ID":"20240617095817-ravcux3","Type":"NodeThematicBreak","Properties":{"id":"20240617095817-ravcux3"}},{"ID":"20240617095822-wevwj6i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095822-wevwj6i","updated":"20240617095827"},"Children":[{"Type":"NodeText","Data":"松脂《本草简要方》"}]},{"ID":"20240617095822-6jtf0mt","Type":"NodeParagraph","Properties":{"id":"20240617095822-6jtf0mt","updated":"20240617095822"},"Children":[{"Type":"NodeText","Data":"主治。清热。燥湿。祛风。安五脏强筋骨。润心肺。消胃中伏热。风痹。恶痹。疗痈疽。"}]},{"ID":"20240617095822-rj26j2h","Type":"NodeParagraph","Properties":{"id":"20240617095822-rj26j2h","updated":"20240617095822"},"Children":[{"Type":"NodeText","Data":"恶疮。疥痒头疡。生肌化脓止痛消毒。节叶根皮。功用略同。花主治。润心肺。益气止血除脓。四圣不老丹。明松脂一斤。以无灰酒砂锅内桑柴火煮数沸。竹枝搅稠。住火倾入水结块。复以酒煮九遍。其脂如玉。不苦不涩乃止。研末。用十二两入白茯苓末。黄菊花末。"}]},{"ID":"20240617095822-hospg9j","Type":"NodeParagraph","Properties":{"id":"20240617095822-hospg9j","updated":"20240617095822"},"Children":[{"Type":"NodeText","Data":"柏子仁去油取霜各半斤。蜜丸梧子大。空腹好酒下七十二丸。能强筋补髓。松梅丸。松脂用水桑柴火煮。拔三次。再以桑灰滴汁煮。七次扯拔。更以好酒煮二次。仍以水煮二次。色白不苦为度。每一斤入九蒸地黄末十两。乌梅末六两。蜜丸梧子大。每服七十丸。空腹盐汤下。健阳补中。强筋润肌。小金丝膏。白胶香沥青各二两。乳香二钱。没药一两。黄蜡三钱。以香油三钱同熬。至滴水不散。倾入水中。扯千遍。收贮。每用捻饼贴之。治一切疮疖肿痛。松脂膏。松脂黄连各七钱五分。黄芩苦参各一两。蛇床子二钱五分。大黄枯白矾胡粉（合下水银入水少许同研。以无星为度）各五钱。水银一两五钱。研末和匀。腊猪油调敷。"}]},{"ID":"20240617095822-1sqkib4","Type":"NodeParagraph","Properties":{"id":"20240617095822-1sqkib4","updated":"20240617095822"},"Children":[{"Type":"NodeText","Data":"治头疮久不瘥。又方。松香八两。铜青二钱。蓖麻仁五钱。同捣作膏摊贴。治一切肿毒。松节酒。松节二十斤。酒五斗。浸二七日。每服一合。日五六服。治历节风痛。（或煎松节松叶取汁。和曲米酿造服之。）又方。油松节一块如枣大。碎切。胡椒七粒。烧酒二三盏煮。"}]},{"ID":"20240617095822-ae1si0e","Type":"NodeParagraph","Properties":{"id":"20240617095822-ae1si0e","updated":"20240617095822"},"Children":[{"Type":"NodeText","Data":"乘热入飞过白矾少许。噙漱三五口。治风热牙痛立瘥。松花散。松花一两五钱。生地鹿角胶（炒黄）薯蓣各一两。艾叶二钱五分。茜草根白茯苓紫菀人参百合刺蓟炙草各五钱。研末每服二钱。米饮调下。治咳血久不止。又方。松脂马勃木香花胭脂各二钱五分。枯矾五钱。"}]},{"ID":"20240617095822-xvgqkfo","Type":"NodeParagraph","Properties":{"id":"20240617095822-xvgqkfo","updated":"20240617095822"},"Children":[{"Type":"NodeText","Data":"研末。先以绵拭净。再以药末吹患处。治耳流脓水。"}]},{"ID":"20240617095823-0m2a3g6","Type":"NodeThematicBreak","Properties":{"id":"20240617095823-0m2a3g6"}},{"ID":"20240617095834-r942f8a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095834-r942f8a","updated":"20240617095838"},"Children":[{"Type":"NodeText","Data":"松脂《本经逢原》"}]},{"ID":"20240617095834-vf1op8c","Type":"NodeParagraph","Properties":{"id":"20240617095834-vf1op8c","updated":"20240617095834"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名松膏，俗名松香"}]},{"ID":"20240617095834-szmppou","Type":"NodeParagraph","Properties":{"id":"20240617095834-szmppou","updated":"20240617095834"},"Children":[{"Type":"NodeText","Data":"苦甘温，无毒。"}]},{"ID":"20240617095834-w0wrxtz","Type":"NodeParagraph","Properties":{"id":"20240617095834-w0wrxtz","updated":"20240617095834"},"Children":[{"Type":"NodeText","Data":"《本经》主痈疽恶疮，头疡白秃，疥瘙风气，安五脏除热，久服轻身不老延年。"}]},{"ID":"20240617095834-ubue70p","Type":"NodeParagraph","Properties":{"id":"20240617095834-ubue70p","updated":"20240617095834"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"松脂得风木坚劲之气，其津液流行皮干之中，积岁结成芳香燥烈，允为方士辟谷延龄之上药。然必蒸炼始堪服食。《本经》所主诸病皆取风燥以祛湿热之患耳。今生肌药中用之者，取其涩以敛之也。"}]},{"ID":"20240617095834-cnh3g2x","Type":"NodeThematicBreak","Properties":{"id":"20240617095834-cnh3g2x"}},{"ID":"20240617095844-3kecujd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095844-3kecujd","updated":"20240617095849"},"Children":[{"Type":"NodeText","Data":"松脂《神农本草经赞》"}]},{"ID":"20240617095844-4nxmpsf","Type":"NodeParagraph","Properties":{"id":"20240617095844-4nxmpsf","updated":"20240617095844"},"Children":[{"Type":"NodeText","Data":"味苦温。主疽恶创。头疡白秃疥搔风气。安五脏。除热。久服轻身。不老延年。一名松膏。一名松肪。生山谷。"}]},{"ID":"20240617095844-ogr5z0p","Type":"NodeParagraph","Properties":{"id":"20240617095844-ogr5z0p","updated":"20240617095844"},"Children":[{"Type":"NodeText","Data":"当暑凌寒。流英沥液。飞状龙形。沉凝虎魄。香泛烟清。灯明光射。苓菊功同。和丸丽泽。"}]},{"ID":"20240617095844-ahi1mv3","Type":"NodeParagraph","Properties":{"id":"20240617095844-ahi1mv3","updated":"20240617095844"},"Children":[{"Type":"NodeText","Data":"宋高宗赞。凌寒逾茂。当暑阴森。张衡赋。漱飞泉之沥液。咀石菌之流英。抱朴子。松树之三千岁者。聚脂状如龙形。名曰飞节芝。博物志。松脂沦入地中。千岁化为虎魄。苏轼诗。"}]},{"ID":"20240617095844-uxs4eka","Type":"NodeParagraph","Properties":{"id":"20240617095844-uxs4eka","updated":"20240617095844"},"Children":[{"Type":"NodeText","Data":"缥缈松香泛蜡烟。戴石屏诗。松明夜当灯。苏颂曰。道人服饵。或合茯苓菊花为丸。易疏。"}]},{"ID":"20240617095844-3m37wlx","Type":"NodeParagraph","Properties":{"id":"20240617095844-3m37wlx","updated":"20240617095844"},"Children":[{"Type":"NodeText","Data":"两泽相连。润说之盛。故曰丽泽。"}]},{"ID":"20240617095844-r29w038","Type":"NodeThematicBreak","Properties":{"id":"20240617095844-r29w038"}},{"ID":"20240617095855-w3us2rd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095855-w3us2rd","updated":"20240617095902"},"Children":[{"Type":"NodeText","Data":"松脂《本草图经》"}]},{"ID":"20240617095855-e0vc2k1","Type":"NodeParagraph","Properties":{"id":"20240617095855-e0vc2k1","updated":"20240617095857"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"松脂"},{"Type":"NodeText","Data":"，生泰山山谷，今处处有之。其用以通明如熏陆香颗者为胜。道人服饵，或合茯苓、松、柏实、菊花作丸，皆先炼治。其法∶用大釜加水置甄，用白茅藉甄底，又加黄砂于茅上，浓寸许可矣，然后布松脂于上，炊以桑薪，汤减即添热水，常令满。候松脂尽入釜中，乃出之，投于冷水，既凝又蒸，如此三过，其白如玉，然后入药，亦可单服。其实及根白皮，古亦有服食法，但今松实，多作果品，余不闻堪入药。其花上黄粉，名松黄，山人及时拂取，作汤点之，甚佳。但不堪停久，故鲜用寄远。烧其枝上，下承取汁液，名松 （音 ），主牛马疮。皮上绿衣，名艾纳香，用合诸香，烧之，其烟不散。方书言松为五粒，字当读为∶音之误也。言每五 为一叶，或有两 七 者。松岁久则实繁，中原虽有，然不及塞上者佳好也。中品有墨条，不载所出州郡，然亦出于松，故附见于此。"}]},{"ID":"20240617095855-hspfvao","Type":"NodeThematicBreak","Properties":{"id":"20240617095855-hspfvao"}},{"ID":"20240617095906-qv7vo94","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095906-qv7vo94","updated":"20240617095912"},"Children":[{"Type":"NodeText","Data":"松脂《本草求真》"}]},{"ID":"20240617095906-eqnbpkc","Type":"NodeParagraph","Properties":{"id":"20240617095906-eqnbpkc","updated":"20240617095906"},"Children":[{"Type":"NodeText","Data":"（香木）祛风除湿生肌杀虫"}]},{"ID":"20240617095906-0lumec3","Type":"NodeParagraph","Properties":{"id":"20240617095906-0lumec3","updated":"20240617095906"},"Children":[{"Type":"NodeText","Data":"松脂（专入肝脾）。即属松木津液。流于皮干之中。经久结成。其液如脂。芳香燥结。内可祛风除湿去痹。外可贴疮长肉杀虫。缘人风湿内淫。则气血受阻。故疮疥痈肿身重痹痛等症。靡不因是而生。得此苦以泄热。温以祛风除湿。则病悉愈。然必蒸炼得法。始堪服食。至云久服轻身延年。虽出经解。未可尽信。其亦过为称誉之意也乎！但火实有热者。忌服。"}]},{"ID":"20240617095906-kvhnw5n","Type":"NodeThematicBreak","Properties":{"id":"20240617095906-kvhnw5n"}},{"ID":"20240617095939-yr1skyf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095939-yr1skyf","updated":"20240617095948"},"Children":[{"Type":"NodeText","Data":"松脂《本草征要》"}]},{"ID":"20240617095939-gd954qb","Type":"NodeParagraph","Properties":{"id":"20240617095939-gd954qb","updated":"20240617095939"},"Children":[{"Type":"NodeText","Data":"味苦、甘，性温，无毒。入肺、胃二经。水煮百沸，白滑方可用。"}]},{"ID":"20240617095939-yshyuw7","Type":"NodeParagraph","Properties":{"id":"20240617095939-yshyuw7","updated":"20240617095939"},"Children":[{"Type":"NodeText","Data":"祛肺金之风，清胃土之热，除邪下气，壮骨强筋。排脓止痛生肌，煎膏而用。牙疼恶痹崩中，研末而尝。咽干含化，耳聋丸吞。"}]},{"ID":"20240617095939-dd8uj46","Type":"NodeParagraph","Properties":{"id":"20240617095939-dd8uj46","updated":"20240617095939"},"Children":[{"Type":"NodeText","Data":"松脂感太阳之气而生，燥可去湿，甘能除热，故外科取用极多也。"}]},{"ID":"20240617095939-foawxsi","Type":"NodeParagraph","Properties":{"id":"20240617095939-foawxsi","updated":"20240617095939"},"Children":[{"Type":"NodeText","Data":"松脂性燥而温，血虚者勿服。"}]},{"ID":"20240617095950-c9fxpwm","Type":"NodeThematicBreak","Properties":{"id":"20240617095950-c9fxpwm"}},{"ID":"20240617095955-6r5inl5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617095955-6r5inl5","updated":"20240617100003"},"Children":[{"Type":"NodeText","Data":"松脂《本草崇原》"}]},{"ID":"20240617095955-dcx2qfk","Type":"NodeParagraph","Properties":{"id":"20240617095955-dcx2qfk","updated":"20240617095955"},"Children":[{"Type":"NodeText","Data":"气味苦甘温，无毒。主治痈疽恶疮，头疮白秃，疥瘙风气，安五脏，除热。久服轻身，不老延年。"}]},{"ID":"20240617095955-h76q5o3","Type":"NodeParagraph","Properties":{"id":"20240617095955-h76q5o3","updated":"20240617095955"},"Children":[{"Type":"NodeText","Data":"（松木之脂，俗名松香，处处山中有之，其木修耸多节，其皮粗浓有鳞，其叶有两鬣、五鬣、七鬣，其花蕊为松黄，结实状如猪心，木之余气结为茯苓，松脂入土，年深化成琥珀。其脂以通明如熏陆香颗者为胜，乃服食辟谷之品，神仙不老之妙药也。熬化滤过即为沥青。）"}]},{"ID":"20240617095955-kdqvut5","Type":"NodeParagraph","Properties":{"id":"20240617095955-kdqvut5","updated":"20240617095955"},"Children":[{"Type":"NodeText","Data":"松脂生于松木之中，禀木质而有火土金水之用。气味苦温，得火气也。得火气，故治肌肉之痈，经脉之疽，以及阴寒之恶疮。入土成珀，坚洁如金，裕金气也。裕金气，故治头疡白秃，以及疥瘙之风气。色黄臭香，味苦而甘，备土气也。备土气，故安五脏。木耐岁寒，经冬不凋，具水气也。具水气，故除热。久服则五运全精，故轻身，不老延年。"}]},{"ID":"20240617095956-ysk8pas","Type":"NodeThematicBreak","Properties":{"id":"20240617095956-ysk8pas"}},{"ID":"20240617100008-lct9v26","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617100008-lct9v26","updated":"20240617100013"},"Children":[{"Type":"NodeText","Data":"松脂《本草乘雅半偈》"}]},{"ID":"20240617100008-42iniv0","Type":"NodeParagraph","Properties":{"id":"20240617100008-42iniv0","updated":"20240617100008"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240617100008-oxqar33","Type":"NodeParagraph","Properties":{"id":"20240617100008-oxqar33","updated":"20240617100008"},"Children":[{"Type":"NodeText","Data":"【气味】苦甘温，无毒。"}]},{"ID":"20240617100008-rdlf9he","Type":"NodeParagraph","Properties":{"id":"20240617100008-rdlf9he","updated":"20240617100008"},"Children":[{"Type":"NodeText","Data":"【主治】主痈疽恶疮，头疡白秃，疥瘙风气，安五脏，除热。久服轻身，不老延年。"}]},{"ID":"20240617100008-axb0inh","Type":"NodeParagraph","Properties":{"id":"20240617100008-axb0inh","updated":"20240617100008"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出太山山谷，处处亦有。今以塞上、衡山者为良。其树修耸多节，其皮粗浓有鳞，其叶凌冬不凋。二三月抽蕤，长三五寸，谓之松黄。放花结实，状如荔枝，叠成鳞砌，秋老则子长鳞裂，随风飞散，着土便生。其脂通明，宛如熏陆香，以松皮内自然凝聚，及流结根底，不见日月者为第一，凿取者次之，煮成者不堪用，宜六月采。修治∶用一大釜，釜中置水，釜上置甑，甑中用白茅藉甑底，更置黄沙于茅上，浓寸许。然后布脂，炊以桑薪，汤减频加热水。俟脂尽入釜中，乃出之，投于冷水，既凝又蒸，凡三度，则色白如玉，入钵徐研，钵底置水，方易细。陶贞白云∶采炼松脂法，并在服食方中，以桑灰汁，或酒，煮软，纳寒水中，数十过，白滑则可用。震亨云∶松脂属阳金，伏汞，制砂，粉银可作匮也。"}]},{"ID":"20240617100008-3sjseun","Type":"NodeParagraph","Properties":{"id":"20240617100008-3sjseun","updated":"20240617100008"},"Children":[{"Type":"NodeText","Data":"【 】曰∶松有脂，如人有血，血余则发华不槁，脂余则叶华不凋。松针上指，宛如须发，心之血分药也。痈疽恶疮，头疡白秃，疥瘙风气，此血中眚，因于血液枯涸，致火气流亢合五行，色黄可入脾，坚凝可入肺，长生可入肝，不凋可入肾，味苦气温可入心，五行周备，故安五脏。若苦能除热，假阴润丽泽之质耳。"}]},{"ID":"20240617100008-0qn4e5x","Type":"NodeParagraph","Properties":{"id":"20240617100008-0qn4e5x","updated":"20240617100008"},"Children":[{"Type":"NodeText","Data":"（百木夭，其气与液，仅自周其急也。松木寿，岂其自周。其气之余为苓，其液之余为脂，为珀，咸成不朽。）"}]},{"ID":"20240617100009-eiau73y","Type":"NodeThematicBreak","Properties":{"id":"20240617100009-eiau73y"}},{"ID":"20240617100010-zdqokd2","Type":"NodeParagraph","Properties":{"id":"20240617100010-zdqokd2"}}]}