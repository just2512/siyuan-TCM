{"ID":"20240504161424-wlx50tk","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240504161424-wlx50tk","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504161424-wlx50tk\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240620134145-915y0wb\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240617100010-zdqokd2\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240620141306-x79kr7a\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"094松脂","type":"doc","updated":"20240809080739"},"Children":[{"ID":"20240620134145-915y0wb","Type":"NodeParagraph","Properties":{"id":"20240620134145-915y0wb","updated":"20240808171959"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620134222-m6e3a9b.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808171949-tyk6zzm","Type":"NodeParagraph","Properties":{"id":"20240808171949-tyk6zzm","updated":"20240808171949"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松脂 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松脂 1-20240808171949-9tpb29c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808171854-02ctcbg","Type":"NodeParag