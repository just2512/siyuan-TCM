{"ID":"20240504161424-yg5mw4k","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504161424-yg5mw4k","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504161424-yg5mw4k\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504161424-6fo4ldg\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607125204-9mhel5o\u0026quot;,\u0026quot;scrollTop\u0026quot;:1800,\u0026quot;focusId\u0026quot;:\u0026quot;20240619145850-i9o0s7t\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"070飞廉","type":"doc","updated":"20240807154114"},"Children":[{"ID":"20240607125228-jw128za","Type":"NodeParagraph","Properties":{"id":"20240607125228-jw128za","updated":"20240619145616"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240607125228-km48n0c.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 202px;","style":"width: 192px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240607125240-5jcne0f.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 192px;\" parent-style=\"width: 202px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 277px;","style":"width: 267px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"飞廉7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/飞廉7-20240619145616-477vp7n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data"