52158-dqnfntd","updated":"20240807152158"}},{"ID":"20240711141101-6edxizk","Type":"NodeParagraph","Properties":{"id":"20240711141101-6edxizk","updated":"20240711141453"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"飞廉、大蓟、小蓟对比"}]},{"ID":"20240711141101-ladhspi","Type":"NodeParagraph","Properties":{"id":"20240711141101-ladhspi","updated":"20240711141434"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为飞廉（茎有刺）"}]},{"ID":"20240711141101-iw6cp8c","Type":"NodeParagraph","Properties":{"id":"20240711141101-iw6cp8c","updated":"20240711141101"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"飞廉8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/飞廉8-20240619145850-4wgalwt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240711141101-2uo6gc7","Type":"NodeParagraph","Properties":{"id":"20240711141101-2uo6gc7","updated":"20240711141101"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为大蓟（茎无刺，叶片羽状裂开）"}]},{"ID":"20240711141101-xls00hl","Type":"NodeParagraph","Properties":{"id":"20240711141101-xls00hl","updated":"20240711141353"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240711135811-pjp4eib.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 447px;","style":"width: 437px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大蓟 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大蓟 4-20240711141353-bfx5emr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 437px;\" parent-style=\"width: 447px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240711141101-pq0ahp9","Type":"NodeParagraph","Properties":{"id":"20240711141101-pq0ahp9","updated":"20240711141101"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为小蓟（叶片有刺无裂）"}]},{"ID":"20240711141101-wmldcsm","Type":"NodeParagraph","Properties":{"id":"20240711141101-wmldcsm","updated":"20240711141101"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 565px;","style":"width: 555px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"小蓟"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/小蓟-20240711141042-ccm65j1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 555px;\" parent-style=\"width: 565px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240616161444-mkt1crm","Type":"NodeThematicBreak","Properties":{"id":"20240616161444-mkt1crm"}},{"ID":"20240616161658-4p7i23z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161658-4p7i23z","updated":"20240616161703"},"Children":[{"Type":"NodeText","Data":"飞廉《神农本草经》"}]},{"ID":"20240616161658-8duefbz","Type":"NodeParagraph","Properties":{"id":"20240616161658-8duefbz","updated":"20240616161658"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240616161658-jt8eio4","Type":"NodeParagraph","Properties":{"id":"20240616161658-jt8eio4","updated":"20240616161658"},"Children":[{"Type":"NodeText","Data":"主骨节热，胫重酸疼。久服，令人身轻。一名飞轻（已上四字，原本黑字）。生川泽。"}]},{"ID":"20240616161658-9su7aib","Type":"NodeParagraph","Properties":{"id":"20240616161658-9su7aib","updated":"20240616161658"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名伏兔，一名飞雉，一名木禾，生河内，正月采根，七月八月采花，阴干。"}]},{"ID":"20240616161658-kcxyiqk","Type":"NodeParagraph","Properties":{"id":"20240616161658-kcxyiqk","updated":"20240616161658"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：伏猪，木禾也，飞廉，漏芦也；陶宠景云：今既别有漏芦，则非，此别名耳。"}]},{"ID":"20240616161720-s3wvpl8","Type":"NodeThematicBreak","Properties":{"id":"20240616161720-s3wvpl8"}},{"ID":"20240616161721-70ljf1j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161721-70ljf1j","updated":"20240616161726"},"Children":[{"Type":"NodeText","Data":"飞廉《神农本草经赞》"}]},{"ID":"20240616161721-8j4vrlf","Type":"NodeParagraph","Properties":{"id":"20240616161721-8j4vrlf","updated":"20240616161721"},"Children":[{"Type":"NodeText","Data":"味苦平。主骨节热。胫重酸疼。久服令人身轻。一名飞轻。生川泽。"}]},{"ID":"20240616161721-xy7qney","Type":"NodeParagraph","Properties":{"id":"20240616161721-xy7qney","updated":"20240616161721"},"Children":[{"Type":"NodeText","Data":"取象神禽。飞走名伙。箭羽轻扬。绵茸旁裹。叶刻残棱。毛浮碎颗。顿洗清凉。百骸安妥。"}]},{"ID":"20240616161721-coj0ns9","Type":"NodeParagraph","Properties":{"id":"20240616161721-coj0ns9","updated":"20240616161721"},"Children":[{"Type":"NodeText","Data":"李时珍曰。飞廉神禽之名。能致风气。名医曰。一名飞雉。一名伏兔。一名伏猪。陶弘景曰。茎轻有皮似箭羽。叶多刻缺。梦溪笔谈。根如牛蒡而绵。头有白茸。韩保升曰。花紫色子毛白。苏轼诗。清凉洗烦煎。"}]},{"ID":"20240616161742-5t8fyz4","Type":"NodeThematicBreak","Properties":{"id":"20240616161742-5t8fyz4"}},{"ID":"20240616161743-brzdbph","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161743-brzdbph","updated":"20240616161747"},"Children":[{"Type":"NodeText","Data":"飞廉《证类本草》"}]},{"ID":"20240616161743-rpk4ij2","Type":"NodeParagraph","Properties":{"id":"20240616161743-rpk4ij2","updated":"20240616161743"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主骨节热，胫重酸疼，头眩顶重，皮间邪风如蜂螫针刺，鱼子细起，热疮痈疽痔，湿痹，止风邪咳嗽，下乳汁。久服令人身轻，益气，明目，不老，可煮可干。一名漏芦，一名天荠，一名伏猪，一名飞轻，一名伏菟，一名飞雉，一名木禾。生河内川泽。正月采根，七月、八月采花，阴干。（得乌大良，恶麻黄。）"}]},{"ID":"20240616161743-amvh9t2","Type":"NodeParagraph","Properties":{"id":"20240616161743-amvh9t2","updated":"20240616161743"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶处处有，极似苦 （乌老切），唯叶下附茎，轻有皮起似箭羽，叶又多刻缺，花紫色。俗方殆无用，而道家服其枝茎，可得长生，又入神枕方。今既别有漏芦，则非此别名尔。唐本注云∶此有两种∶一是陶证，生平泽中者。其生山岗上者，叶颇相似，而无疏缺，且多毛，茎亦无羽，根直下，更无旁枝，生则肉白皮黑，中有黑脉，日干则黑如玄参。用叶茎及根，疗疳蚀，杀虫，与平泽者俱有验。今俗以马蓟以苦 为漏芦，并非是也。臣禹锡等谨按蜀本图经云∶叶似苦 ，茎似软羽，紫花，子毛白。今所在平泽皆有，五月、六月采，日干。药性论云∶飞廉，使，味苦，咸，有毒。主留血。萧炳云∶小儿疳痢，为散，以浆水下之，大效。"}]},{"ID":"20240616161743-l7q34rt","Type":"NodeParagraph","Properties":{"id":"20240616161743-l7q34rt","updated":"20240616161743"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用赤脂蔓，与飞廉形状相似，只赤脂蔓见酒色便如血色，可表之。凡修事，先刮去粗皮了，杵，用苦酒拌之一夜，至明漉出，日干，细杵用之。千金翼∶治疳 食口齿及下部。飞廉蒿烧灰捣筛，以两钱匕着痛处，甚痛忍之；若不痛，非疳也。下部虫如马尾大，相缠出无数。十日瘥，二十日平复。"}]},{"ID":"20240616161732-git2cmt","Type":"NodeThematicBreak","Properties":{"id":"20240616161732-git2cmt"}},{"ID":"20240616161733-e5b3poe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161733-e5b3poe","updated":"20240616161737"},"Children":[{"Type":"NodeText","Data":"飞廉《雷公炮炙论》"}]},{"ID":"20240616161733-daw8rim","Type":"NodeParagraph","Properties":{"id":"20240616161733-daw8rim","updated":"20240616161733"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用赤脂蔓，与飞廉形状相似，只赤脂蔓见酒，色使如血，色可表之。"}]},{"ID":"20240616161733-0ddia94","Type":"NodeParagraph","Properties":{"id":"20240616161733-0ddia94","updated":"20240616161733"},"Children":[{"Type":"NodeText","Data":"凡修事，先刮去粗皮，了，杵，用苦酒拌之一夜，至明漉出，日干，细杵用之。"}]},{"ID":"20240616161708-jsdvyz3","Type":"NodeThematicBreak","Properties":{"id":"20240616161708-jsdvyz3"}},{"ID":"20240616161709-u2mpwok","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161709-u2mpwok","updated":"20240616161716"},"Children":[{"Type":"NodeText","Data":"飞廉《名医别录》"}]},{"ID":"20240616161709-fhi3p7e","Type":"NodeParagraph","Properties":{"id":"20240616161709-fhi3p7e","updated":"20240616161709"},"Children":[{"Type":"NodeText","Data":"无毒．主治头眩顶重，皮间邪风如蜂螫针刺，鱼子细起，热疮，痈疽，痔，湿痹，止邪，咳嗽，下乳汁．久服益气，明目，不老．可煮可干．一名漏芦，一名天荠，一名伏猪一名伏兔，一名飞雉，一名木禾．生河内．正月采根；七月、八月采花，阴干．（得乌头恶麻黄．）"}]},{"ID":"20240616161709-8ennyuo","Type":"NodeParagraph","Properties":{"id":"20240616161709-8ennyuo","updated":"20240616161709"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶飞廉，味苦，平．主骨节热，胫重酸疼．久服令人身轻．一名飞轻．生川泽．"}]},{"ID":"20240616161444-b84wqka","Type":"NodeThematicBreak","Properties":{"id":"20240616161444-b84wqka"}},{"ID":"20240616161648-socjszs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161648-socjszs","updated":"20240616161653"},"Children":[{"Type":"NodeText","Data":"飞廉《千金翼方》"}]},{"ID":"20240616161648-l3sxe9e","Type":"NodeParagraph","Properties":{"id":"20240616161648-l3sxe9e","updated":"20240616161648"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主骨节热，胫重酸疼，头眩项重，皮间邪风，如蜂螫针刺，鱼子细起，热疮痈疽痔，湿痹，止风邪咳嗽，下乳汁。久服令人身轻，益气，明目不老，可煮可干。一名漏芦，一名天荠，一名伏猪，一名飞轻，一名伏兔，一名飞雉，一名木禾。生河内川泽，正月采根，七月八月采花，阴干。"}]},{"ID":"20240616161444-c4tugst","Type":"NodeThematicBreak","Properties":{"id":"20240616161444-c4tugst"}},{"ID":"20240616161620-p3egz7g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161620-p3egz7g","updated":"20240616161626"},"Children":[{"Type":"NodeText","Data":"飞廉《本草纲目》"}]},{"ID":"20240616161620-xu7u4z0","Type":"NodeParagraph","Properties":{"id":"20240616161620-xu7u4z0","updated":"20240616161629"},"Children":[{"Type":"NodeText","Data":"（《本经》上品）【释名】漏芦（《别录》）、木禾（《别录》）、（《别录》）、伏猪（同）、天荠（同）。尾，有角，能致风气。此草附茎有皮如箭羽，复疗风邪，故有飞廉、飞雉、飞轻诸名。【集解】《别录》曰∶飞廉生河内川泽，正月采根，七月、八月采花，阴干。弘景曰∶处处有之。极似苦，惟叶多刻缺，叶下附茎，轻有皮起似箭羽，其花紫色。俗方殆无用，而道家服其枝茎，可得长生，又入神枕方。今既别有漏芦，则此漏芦乃别名尔。恭曰∶此有两种∶一种生平泽中，是陶氏所说者。一种生山冈上者，叶颇相似，而无刻缺，且多毛，其茎亦无羽，其根直下，更无旁枝，生则肉白皮黑，中有黑脉，日干则黑如玄参。用茎叶及根，疗疳蚀杀虫，与平泽者俱有验。今俗以马蓟似苦者为漏芦，并非是也。保升曰∶叶似苦，茎似软羽，花紫色，子色白。所在平泽皆有，曰∶凡使，勿用赤脂蔓，与飞廉形状相似，只赤脂蔓见酒则色便如血，以此可表识之颂曰∶今秦州所图漏芦，花似单叶寒菊，紫色，五、七枝同一干。海州所图漏芦，花紫碧色，如单叶莲花，花萼下及根旁有白茸裹之，根黑色，如蔓荆而细，又类葱本，与陶苏所说飞廉相近，然彼但谓之漏芦。今医家罕有用飞廉者，不能的识。时珍曰∶飞廉，亦蒿类也。苏颂《图经》疑海州所图之漏芦是飞廉。沈存中《笔谈》亦言飞廉根如牛蒡而绵头。古方漏芦散下云，用有白茸者则是有白茸者，乃飞廉无疑矣。今考二物气、味、功、用俱不相远，似可通用，岂或一类有数种，而古今名称各处不同乎？"}]},{"ID":"20240616161620-467gqrj","Type":"NodeParagraph","Properties":{"id":"20240616161620-467gqrj","updated":"20240616161620"},"Children":[{"Type":"NodeText","Data":"根及花"}]},{"ID":"20240616161620-ho7fs00","Type":"NodeParagraph","Properties":{"id":"20240616161620-ho7fs00","updated":"20240616161632"},"Children":[{"Type":"NodeText","Data":"【修治】曰∶凡用根，先刮去粗皮，杵细，以苦酒拌一夜，漉出，日干细杵用。【气味】苦，平，无毒。权曰∶苦、咸，有毒。【主治】骨节热，胫重酸疼。久服令人身轻（《本经》）。螫针刺，鱼子细起，热疮痈疽痔，湿痹，止风邪咳嗽，下乳汁。久服益气明目不老，可煮可干用（《别录》）。主留血（《甄权》）。疗疳蚀，杀虫（苏恭）。小儿疳痢，为散，浆水服，大效（萧炳）。治头风旋晕（时珍）。【发明】时珍曰∶葛洪《抱朴子》书，言飞廉单服可轻身延寿。又言服飞廉煎，可远涉疾行，力数倍于常。《本经》、《别录》所列亦是良药，而后人不知用，何哉？【附方】旧一。若不痛，非疳也。下部虫如马尾大，相缠出无数。十日瘥，二十日平复。（《千金翼方》）"}]},{"ID":"20240616161443-hlsi14y","Type":"NodeThematicBreak","Properties":{"id":"20240616161443-hlsi14y"}},{"ID":"20240616161602-92j7oit","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616161602-92j7oit","updated":"20240616161607"},"Children":[{"Type":"NodeText","Data":"飞廉《新修本草》"}]},{"ID":"20240616161602-bprmcdd","Type":"NodeParagraph","Properties":{"id":"20240616161602-bprmcdd","updated":"20240616161602"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主骨节热，胫重酸疼。头眩顶重，皮间邪风如蜂螫针刺，鱼子细起，热疮咳嗽，下乳汁。久服令人身轻，益气明目不老。可煮可干。一名漏芦，一名天荠，一名伏猪，一名飞轻，一名伏兔，一名飞雉，一名木禾。生河内川泽。正月采根，七月、八月采花，阴干。"}]},{"ID":"20240616161602-n2s5aob","Type":"NodeParagraph","Properties":{"id":"20240616161602-n2s5aob","updated":"20240616161602"},"Children":[{"Type":"NodeText","Data":"得乌头良，恶麻黄。 处处有。极似苦 ，惟叶下附茎，轻有皮起似箭羽，叶又多刻缺，花紫色。俗方殆无用，而道家服其枝茎，可得长生，又入神枕方。今既别有漏芦，则非此别名尔。"}]},{"ID":"20240616161602-qckji26","Type":"NodeParagraph","Properties":{"id":"20240616161602-qckji26","updated":"20240616161602"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此有两种∶一是陶证生平泽中者；其生山岗上者，叶颇相似，而无疏缺，且多毛，茎亦无羽，根直下，更无旁枝。生则肉白皮黑，中有黑脉；晒干则黑如玄参。用叶、茎及根，疗疳蚀杀虫，与平泽者俱有验。今俗以马蓟似苦为漏芦，并非是也。"}]},{"ID":"20240607125201-csrvbl8","Type":"NodeThematicBreak","Properties":{"id":"20240607125201-csrvbl8"}},{"ID":"20240607125202-o4pgu10","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607125202-o4pgu10","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：飞廉"}]},{"ID":"20240607125202-d7nx8xn","Type":"NodeParagraph","Properties":{"id":"20240607125202-d7nx8xn","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607125202-l49zbb9","Type":"NodeParagraph","Properties":{"id":"20240607125202-l49zbb9","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" Fēi Lián"}]},{"ID":"20240607125202-c0zwsu8","Type":"NodeParagraph","Properties":{"id":"20240607125202-c0zwsu8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607125202-15a2yjs","Type":"NodeParagraph","Properties":{"id":"20240607125202-15a2yjs","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 大蓟、刺盖"}]},{"ID":"20240607125202-h3x4ug6","Type":"NodeParagraph","Properties":{"id":"20240607125202-h3x4ug6","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607125202-ptuz6u3","Type":"NodeParagraph","Properties":{"id":"20240607125202-ptuz6u3","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 为菊科飞廉属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"飞廉"},{"Type":"NodeText","Data":"Carduus crispus L.和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藏飞廉"},{"Type":"NodeText","Data":"C. acanthoides L.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"入药。夏、秋季花盛开时采割全草；春、秋挖根，去杂质，鲜用或晒干用。"}]},{"ID":"20240607125202-hbg1btu","Type":"NodeParagraph","Properties":{"id":"20240607125202-hbg1btu","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607125202-7dk2cuw","Type":"NodeParagraph","Properties":{"id":"20240607125202-7dk2cuw","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 1."},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"飞廉"},{"Type":"NodeText","Data":"（老牛锉、大力王）：二年生多刺草本，高50～120厘米。主根肥厚，伸直或偏斜。茎直立，具纵棱，棱有绿色间歇的三角形刺齿状翼。单叶互生，通常无柄，抱茎；下部叶椭圆状披针形，长5～20厘米，羽状深裂，裂片常大小相对而生，边缘有刺，刺长3～10毫米，上面绿色，具细毛或近乎光滑，下面初具蛛丝状毛，后渐变光滑；上部叶渐小。夏秋开花，头状花序2～3个簇生于枝端，或单生叶腋，较柔软，常略下垂，直径1.5～2.5厘米；总苞钟形，苞片多层，外层较内层逐渐变短，中层苞片条状披针形，先端长尖成刺状，向外反曲，内层苞片条形，膜质，捎带紫色。花全为管状花，紫红色，长15～16毫米，花瓣5裂，花丝有毛，花药合生，基部箭头状或耳廓状，尾纤长。花柱细长，柱头2裂。瘦果长椭圆形，冠毛白色或灰白色，呈刺毛状。"}]},{"ID":"20240607125202-avz1kha","Type":"NodeParagraph","Properties":{"id":"20240607125202-avz1kha","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"生于田野、路旁草丛中。全国大部分省区有分布。"}]},{"ID":"20240607125202-gbdb579","Type":"NodeParagraph","Properties":{"id":"20240607125202-gbdb579","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"2."},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藏飞廉"},{"Type":"NodeText","Data":"：与前种主要区别为全株被白色蛛丝状毛，叶片羽状浅裂，裂片近等大，整齐对生；头状花序多单生，较大。花序下有宽条形叶状总苞片，长超过头状花序。"}]},{"ID":"20240607125202-j19441y","Type":"NodeParagraph","Properties":{"id":"20240607125202-j19441y","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"生于山坡、路旁草丛中。分布于云南和西藏地区。"}]},{"ID":"20240607125202-pum3zsu","Type":"NodeParagraph","Properties":{"id":"20240607125202-pum3zsu","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607125202-wln96zz","Type":"NodeParagraph","Properties":{"id":"20240607125202-wln96zz","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 适宜温暖或凉爽气候，耐寒和干旱。对土壤要求不严，一般土壤均可栽种。种子繁殖，春季3、4月播种，条播或穴播，行株距1.5×1尺，每穴播种5、6粒，覆土1寸左右。播种后约10天左右出苗，苗出齐后需行间苗一次，每穴可留壮苗1～2株。雨季注意排水以防烂根。‘"}]},{"ID":"20240607125202-jqaqxum","Type":"NodeParagraph","Properties":{"id":"20240607125202-jqaqxum","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607125202-2x6b1qh","Type":"NodeParagraph","Properties":{"id":"20240607125202-2x6b1qh","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 藏飞廉干草中含有生物碱类：强碱性生物碱部分由降压作用；其中有藏飞廉碱（acanthoidine，C"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"16"},{"Type":"NodeText","Data":"H"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"24"},{"Type":"NodeText","Data":"O"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"N"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"）盐酸藏飞廉次碱（acanthoidine hydrochloride，C"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"16"},{"Type":"NodeText","Data":"H"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"22"},{"Type":"NodeText","Data":"O"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"2"},{"Type":"NodeText","Data":"N"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"4"},{"Type":"NodeText","Data":"）。此外，尚含有两种弱碱性生物碱。"}]},{"ID":"20240607125202-aznhbd3","Type":"NodeParagraph","Properties":{"id":"20240607125202-aznhbd3","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607125202-wk3n3zc","Type":"NodeParagraph","Properties":{"id":"20240607125202-wk3n3zc","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 微苦，平。"}]},{"ID":"20240607125202-0o2656e","Type":"NodeParagraph","Properties":{"id":"20240607125202-0o2656e","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607125202-v6wgb62","Type":"NodeParagraph","Properties":{"id":"20240607125202-v6wgb62","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 散瘀止血，清热利湿。用于吐血，鼻衄，尿血，功能性子宫出血，白帝，乳糜尿，泌尿系感染；外用治痈疖、疔疮。"}]},{"ID":"20240607125202-zgxtfsz","Type":"NodeParagraph","Properties":{"id":"20240607125202-zgxtfsz","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607125202-b6jc9n1","Type":"NodeParagraph","Properties":{"id":"20240607125202-b6jc9n1","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 3～5钱；外用适量，鲜品捣烂敷患处。"}]},{"ID":"20240607125202-yhqhfrq","Type":"NodeParagraph","Properties":{"id":"20240607125202-yhqhfrq","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607125202-s8sc5y3","Type":"NodeParagraph","Properties":{"id":"20240607125202-s8sc5y3","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 鼻衄、功能性子宫出血、尿血：飞廉、茜草、地榆各3钱，水煎服。"}]},{"ID":"20240607125202-jt92505","Type":"NodeParagraph","Properties":{"id":"20240607125202-jt92505","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607125202-trjv4o6","Type":"NodeParagraph","Properties":{"id":"20240607125202-trjv4o6","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 飞廉瘦果制成酊剂，有利胆作用，可治黄疸，对于轻度胆绞痛有效。"}]},{"ID":"20240607125202-wow8plg","Type":"NodeParagraph","Properties":{"id":"20240607125202-wow8plg","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607125202-gc8qduj","Type":"NodeParagraph","Properties":{"id":"20240607125202-gc8qduj","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607125202-qjksy5e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607125202-qjksy5e","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：飞廉"}]},{"ID":"20240607125202-94ctv71","Type":"NodeParagraph","Properties":{"id":"20240607125202-94ctv71","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607125202-unfdxzu","Type":"NodeParagraph","Properties":{"id":"20240607125202-unfdxzu","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" Fēi Lián"}]},{"ID":"20240607125202-rsxn15y","Type":"NodeParagraph","Properties":{"id":"20240607125202-rsxn15y","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607125202-u0ck7tr","Type":"NodeParagraph","Properties":{"id":"20240607125202-u0ck7tr","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 飞轻（《本经》），天荠、伏猪、伏兔、飞雉、木禾（《别录》），飞廉蒿（《千金翼方》），老牛错（《黑龙江中药》），红花草、刺打草，雷公菜（《湖南药物志》），大力王、枫头棵。飞帘（苏医《中草药手册》）。"}]},{"ID":"20240607125202-96iw2k8","Type":"NodeParagraph","Properties":{"id":"20240607125202-96iw2k8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607125202-1g0gtxv","Type":"NodeParagraph","Properties":{"id":"20240607125202-1g0gtxv","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607125202-fw3i4ij","Type":"NodeParagraph","Properties":{"id":"20240607125202-fw3i4ij","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607125202-rlmejxg","Type":"NodeParagraph","Properties":{"id":"20240607125202-rlmejxg","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"飞廉"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。冬、春季采根，夏季采茎；叶及花，鲜用或晒干用。"}]},{"ID":"20240607125202-vbg24d5","Type":"NodeParagraph","Properties":{"id":"20240607125202-vbg24d5","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607125202-9if8yvo","Type":"NodeParagraph","Properties":{"id":"20240607125202-9if8yvo","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 生于荒野道旁。分布全国各地。"}]},{"ID":"20240607125202-p5eyaes","Type":"NodeParagraph","Properties":{"id":"20240607125202-p5eyaes","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607125202-rzh5sxr","Type":"NodeParagraph","Properties":{"id":"20240607125202-rzh5sxr","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 二年生草本。茎直立，高70～100厘米，具纵条棱，并附有绿色的翼，翼有齿刺。下部叶椭圆状披针形，长5～20厘米，羽状深裂，裂片的边缘具刺，上面绿色，具细毛或近平光滑，下面初具蛛丝状毛，后渐变光滑；上部叶渐小。头状花序2～3枚，着生于枝端，直径1.5～2.5厘米；总苞钟形，长约2厘米，宽1.5～3厘米，苞片多层，外层较内层逐渐变短，中层苞片线状披针形，先端长尖成刺状。向外反曲，内层苞片线形，膜质，稍带紫色。花全部为管状花，两性，紫红色，花管长15～16毫米，先端5裂；雄蕊5，花药合生；雌蕊1，花柱细长，柱头2裂。瘦果长椭圆形，长3毫米，顶端平截，基部收缩；冠毛白色或灰白色，长约15毫米，呈刺毛状。花期6、7月。"}]},{"ID":"20240607125202-rcstrwv","Type":"NodeParagraph","Properties":{"id":"20240607125202-rcstrwv","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607125202-f30wayr","Type":"NodeParagraph","Properties":{"id":"20240607125202-f30wayr","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240607125202-5xcnymt","Type":"NodeParagraph","Properties":{"id":"20240607125202-5xcnymt","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240607125202-ro1pu7a","Type":"NodeParagraph","Properties":{"id":"20240607125202-ro1pu7a","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607125202-ukb8wio","Type":"NodeParagraph","Properties":{"id":"20240607125202-ukb8wio","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦咸，有毒。\""}]},{"ID":"20240607125202-huolyw2","Type":"NodeParagraph","Properties":{"id":"20240607125202-huolyw2","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"④《西藏常用中草药》：\"苦，凉。\""}]},{"ID":"20240607125202-u6y5cp8","Type":"NodeParagraph","Properties":{"id":"20240607125202-u6y5cp8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607125202-e0wv230","Type":"NodeParagraph","Properties":{"id":"20240607125202-e0wv230","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：\"得乌头良。恶麻黄。\""}]},{"ID":"20240607125202-0wkwjdi","Type":"NodeParagraph","Properties":{"id":"20240607125202-0wkwjdi","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607125202-hehrwog","Type":"NodeParagraph","Properties":{"id":"20240607125202-hehrwog","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 祛风，清热，利湿，凉血散瘀。治风热感冒，头风眩晕，风热痹痛，皮肤刺痒，尿路感染，乳糜尿，尿血，带下，跌打瘀肿，疔疮肿毒，汤火伤。"}]},{"ID":"20240607125202-crtcsym","Type":"NodeParagraph","Properties":{"id":"20240607125202-crtcsym","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主骨节热，胫重酸疼。\""}]},{"ID":"20240607125202-khbq0dn","Type":"NodeParagraph","Properties":{"id":"20240607125202-khbq0dn","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"治头眩顶重，皮间风邪如蜂螫针刺，鱼子细起。热疮、痈、疽、痔，湿痹，止风邪咳嗽，下乳汁。益气明目。\""}]},{"ID":"20240607125202-cn3fri5","Type":"NodeParagraph","Properties":{"id":"20240607125202-cn3fri5","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"③《药性沦》：\"主留血。\""}]},{"ID":"20240607125202-xfccf38","Type":"NodeParagraph","Properties":{"id":"20240607125202-xfccf38","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"疗疳蚀，杀虫。\""}]},{"ID":"20240607125202-5swbjrp","Type":"NodeParagraph","Properties":{"id":"20240607125202-5swbjrp","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"⑤《四声本草》：\"小儿疳痢，为散，以浆水下。\""}]},{"ID":"20240607125202-ocx3bh8","Type":"NodeParagraph","Properties":{"id":"20240607125202-ocx3bh8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治头风旋运。\""}]},{"ID":"20240607125202-fimwlx9","Type":"NodeParagraph","Properties":{"id":"20240607125202-fimwlx9","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"⑦《西藏常用中草药》：\"凉血，止血，散瘀消肿。治各种出血，跌打瘀肿，恶疮，烧伤，烫伤。\""}]},{"ID":"20240607125202-6xt37zw","Type":"NodeParagraph","Properties":{"id":"20240607125202-6xt37zw","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"⑧苏医《中草药手册》：\"祛风，利湿，清热，消肿。治乳糜尿；尿血，尿路感染，流感，白带过多，月经过多；外用治疔疮肿毒，痔疮肿痛。\""}]},{"ID":"20240607125202-rx7pj78","Type":"NodeParagraph","Properties":{"id":"20240607125202-rx7pj78","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607125202-5j4zm4i","Type":"NodeParagraph","Properties":{"id":"20240607125202-5j4zm4i","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，鲜者1～2两；入散剂或浸酒。外用：捣敷或烧存性研末掺。"}]},{"ID":"20240607125202-jrf8wbb","Type":"NodeParagraph","Properties":{"id":"20240607125202-jrf8wbb","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607125202-ec3qxup","Type":"NodeParagraph","Properties":{"id":"20240607125202-ec3qxup","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" ①治关节炎：老牛错（全草）一斤，何首乌三两，生地半斤。用酒浸泡一周，每天服一小杯。（《黑龙江中药》）"}]},{"ID":"20240607125202-3tggmnu","Type":"NodeParagraph","Properties":{"id":"20240607125202-3tggmnu","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"②治无名肿毒，痔疮，外伤肿痛：老牛错茎叶，捣成泥状，敷患处。（《黑龙江中药》）"}]},{"ID":"20240607125202-fu3cpei","Type":"NodeParagraph","Properties":{"id":"20240607125202-fu3cpei","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"③治疳匿蚀口齿及下部：飞廉蒿烧作灰，捣筛，以两钱匕服（每次煎两小时），每日服二次。（江苏《中草药新医疗法》）"}]},{"ID":"20240607125202-zp5nwrn","Type":"NodeParagraph","Properties":{"id":"20240607125202-zp5nwrn","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607125202-7byn8pk","Type":"NodeParagraph","Properties":{"id":"20240607125202-7byn8pk","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 西藏以同属植物科刺飞廉作飞廉入药，其特征：茎具翼，有刺，幼时被白色柔毛。下部叶具短柄，上部叶无柄抱茎；叶片披针形或倒披针形，羽状浅裂，边缘有齿，齿上有针刺。头状花序单生；总苞片数层，先端具刺；花紫红色。瘦果椭圆形，稍扁，具光泽；冠毛白色多层，基部合生。"}]},{"ID":"20240607125202-l3kod29","Type":"NodeParagraph","Properties":{"id":"20240607125202-l3kod29","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607125202-tc7huez","Type":"NodeParagraph","Properties":{"id":"20240607125202-tc7huez","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607125202-zbnehce","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607125202-zbnehce","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"《中华本草》：飞廉"}]},{"ID":"20240607125202-7rmb1ud","Type":"NodeParagraph","Properties":{"id":"20240607125202-7rmb1ud","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607125202-fllhnwr","Type":"NodeParagraph","Properties":{"id":"20240607125202-fllhnwr","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" Fēi Lián"}]},{"ID":"20240607125202-acz427q","Type":"NodeParagraph","Properties":{"id":"20240607125202-acz427q","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607125202-az2msx8","Type":"NodeParagraph","Properties":{"id":"20240607125202-az2msx8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 飞轻、天荠、伏猪、伏兔、飞雉、木禾、飞廉蒿、老牛错、红花草、刺打草、雷公菜、大力王、枫头棵、飞帘、红马刺、刺盖、刺萝卜、大蓟、老牛锉"}]},{"ID":"20240607125202-8jz8ufm","Type":"NodeParagraph","Properties":{"id":"20240607125202-8jz8ufm","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607125202-r1wub2s","Type":"NodeParagraph","Properties":{"id":"20240607125202-r1wub2s","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" Curly Bristlethistle Herb, Herb or root of Curly Bristlethistle"}]},{"ID":"20240607125202-t6kx8w8","Type":"NodeParagraph","Properties":{"id":"20240607125202-t6kx8w8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607125202-4q7lebp","Type":"NodeParagraph","Properties":{"id":"20240607125202-4q7lebp","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607125202-5f4gdnb","Type":"NodeParagraph","Properties":{"id":"20240607125202-5f4gdnb","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"1.陶弘景：飞廉，处处有，极似苦芺，惟叶下附茎，轻有皮起似箭羽，叶又多刻缺，花紫色。今既别有漏卢，则非此别名尔。"}]},{"ID":"20240607125202-pbyolyu","Type":"NodeParagraph","Properties":{"id":"20240607125202-pbyolyu","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：飞廉有两种，一是陶证，生平泽中者；其生山岗上者，叶颇相似，而无疏缺，且多毛，茎亦无羽，根直下，更无旁枝，生则肉白皮黑，中有黑脉，日干则黑如玄参，用茎、叶及根，疗疳蚀杀虫，与平泽者俱有验。今俗以马蓟、以苦芺为漏卢，并非是也。"}]},{"ID":"20240607125202-32aoan2","Type":"NodeParagraph","Properties":{"id":"20240607125202-32aoan2","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607125202-69ebcgj","Type":"NodeParagraph","Properties":{"id":"20240607125202-69ebcgj","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物丝毛飞廉与节毛飞廉的全草或根。"}]},{"ID":"20240607125202-ltlgp9l","Type":"NodeParagraph","Properties":{"id":"20240607125202-ltlgp9l","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Carduus crispus L.2.Carduus acanthoids L."}]},{"ID":"20240607125202-4vi2hxt","Type":"NodeParagraph","Properties":{"id":"20240607125202-4vi2hxt","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、夏季采收全草及花，秋季挖根，鲜用或除花阴干外，其余切段晒干。"}]},{"ID":"20240607125202-qebqj0e","Type":"NodeParagraph","Properties":{"id":"20240607125202-qebqj0e","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607125202-f062b8z","Type":"NodeParagraph","Properties":{"id":"20240607125202-f062b8z","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡草丛中及路旁。"}]},{"ID":"20240607125202-ip9er4j","Type":"NodeParagraph","Properties":{"id":"20240607125202-ip9er4j","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"资源分布：1.生于田野、路旁或山地草丛中。我国大部分省区有分布。"}]},{"ID":"20240607125202-unhmtne","Type":"NodeParagraph","Properties":{"id":"20240607125202-unhmtne","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"2.分布于支南及西藏。"}]},{"ID":"20240607125202-tzi0dpt","Type":"NodeParagraph","Properties":{"id":"20240607125202-tzi0dpt","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607125202-h4isv6m","Type":"NodeParagraph","Properties":{"id":"20240607125202-h4isv6m","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 1.丝毛飞廉 二年生草本，高50-120cm。主根肥厚，伸直或偏斜。茎直立，具纵棱，棱有绿色间歇的三角形刺齿状翼。叶互生；通常无柄而抱茎；下部叶椭圆状披针形，长5-20cm，羽状深裂，裂片常大小相对而生，边缘刺，上面绿色，具细毛或近乎光滑，下面初具蛛丝状毛，后渐变光滑；上部叶渐小。头状花序2-3个簇生枝端，直径1.5-2.5cm，总苞钟状，长约2cm，宽1.5-3cm；总苞片多层，外层较内层逐变短，中层条状披针形，先端长尖成刺状，向外反曲，内层条形，膜质，稍带紫色；花全为管状花，两性，紫红色，长15-16mm。瘦果长椭圆形，长约3mm，先端平截，基部收缩；冠毛白色或灰白色，长约15mm，呈刺毛状，稍粗糙。花期5-7月。"}]},{"ID":"20240607125202-htrc65h","Type":"NodeParagraph","Properties":{"id":"20240607125202-htrc65h","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"2.节毛飞廉 本种与前种之区别，在于本种全株被白色蛛丝状毛。茎具翼，有刺。叶片披针形或倒披针形，羽状浅裂，裂片近等大，整齐对生，边缘有齿，齿上有针刺；下部叶具短柄，上部叶无柄抱茎。头状花序多为单生，较大；花序下有宽条形叶状总苞片，长超过头状花序；总苞片数层，先端具刺；花紫红色。瘦果椭圆形，稍扁，具光泽；冠毛白色，多层，基部合生。"}]},{"ID":"20240607125202-0pzfjlh","Type":"NodeParagraph","Properties":{"id":"20240607125202-0pzfjlh","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607125202-gh414e4","Type":"NodeParagraph","Properties":{"id":"20240607125202-gh414e4","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 茎圆柱形，直径0.2-1cm，具纵棱，并附有绿色的翅，翅有针刺，质脆，断面髓部白色，常呈空洞。叶椭圆状披针形，长5-20cm，羽状深裂，裂片边缘具刺，上面绿色，具细毛或近乎光滑，下面具蛛丝状毛。头状花序干缩，总苞钟形，黄褐色，苞片数层，线状披针形，先端长尖成刺向外反卷，内层苞片膜质，带紫色。花紫红色，冠毛刺状，黄白色。气味微弱。"}]},{"ID":"20240607125202-i58xorq","Type":"NodeParagraph","Properties":{"id":"20240607125202-i58xorq","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：呈类圆形，表皮、皮层于叶状翅处向外突出，棱脊处的表皮下方有厚角组织，外韧维管束环列，韧皮纤维束微木化，木质部内侧具微木化纤维群；髓常呈空洞。"}]},{"ID":"20240607125202-sjya4ps","Type":"NodeParagraph","Properties":{"id":"20240607125202-sjya4ps","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"叶表面观：上表皮细胞类多角形，下表皮细胞不规则形，垂周壁波状变曲。气孔不定式或不等式，非腺毛多断碎，由5-10余个细胞组成，基部细胞直径21-40（-83）μm，顶端细胞极细长并扭曲。"}]},{"ID":"20240607125202-ylz4xh9","Type":"NodeParagraph","Properties":{"id":"20240607125202-ylz4xh9","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607125202-lpw4m3a","Type":"NodeParagraph","Properties":{"id":"20240607125202-lpw4m3a","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 节毛飞廉新鲜茎含去氢飞廉碱（acanthoine）和去氢飞廉定（acanthodine）[11]等。"}]},{"ID":"20240607125202-azoh69o","Type":"NodeParagraph","Properties":{"id":"20240607125202-azoh69o","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607125202-6r2x7m8","Type":"NodeParagraph","Properties":{"id":"20240607125202-6r2x7m8","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 味微苦；性凉"}]},{"ID":"20240607125202-idainqu","Type":"NodeParagraph","Properties":{"id":"20240607125202-idainqu","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607125202-c7se21s","Type":"NodeParagraph","Properties":{"id":"20240607125202-c7se21s","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 血虚及脾胃功能弱者慎服。"}]},{"ID":"20240607125202-ut7b9nc","Type":"NodeParagraph","Properties":{"id":"20240607125202-ut7b9nc","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607125202-gvnxtnj","Type":"NodeParagraph","Properties":{"id":"20240607125202-gvnxtnj","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 祛风；清热；利湿；凉血止血；活血消肿。主感冒咳嗽；头痛眩晕；泌尿系感染；乳糜尿；白带；黄疸；风湿痹痛；吐血；衄血；尿血；月经过多；功能性子宫出血；跌打损伤；疔疮疖肿；痔疮肿痛；烧伤"}]},{"ID":"20240607125202-824gz08","Type":"NodeParagraph","Properties":{"id":"20240607125202-824gz08","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607125202-s3zdfy1","Type":"NodeParagraph","Properties":{"id":"20240607125202-s3zdfy1","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-30g，鲜品30-60g；或入丸、散，或浸酒。外用，适量，煎水洗，或鲜品捣敷，或烧存性，研末掺"}]},{"ID":"20240607125202-z79jsqx","Type":"NodeParagraph","Properties":{"id":"20240607125202-z79jsqx","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607125202-np2km8v","Type":"NodeParagraph","Properties":{"id":"20240607125202-np2km8v","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 1.治关节炎：老牛错(全草)一斤，何首乌三两，生地半斤。用酒浸泡一周，每天服一小杯。(《黑龙江中药》)2.治无名肿毒，痔疮，外伤肿痛：老牛错茎叶，捣成泥状，敷患处。(《黑龙江中药》)"}]},{"ID":"20240607125202-xbczjgb","Type":"NodeParagraph","Properties":{"id":"20240607125202-xbczjgb","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607125202-ou27ogm","Type":"NodeParagraph","Properties":{"id":"20240607125202-ou27ogm","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主骨节热，胫重酸疼。"}]},{"ID":"20240607125202-ofstxds","Type":"NodeParagraph","Properties":{"id":"20240607125202-ofstxds","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"2.《别录》：治头眩顶重，皮间风邪如蜂螫针刺，鱼子细起，热疮、痈、疽、痔，湿痹，止风邪咳嗽，下乳汁。益气明目。"}]},{"ID":"20240607125202-dox5x5b","Type":"NodeParagraph","Properties":{"id":"20240607125202-dox5x5b","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：主留血。"}]},{"ID":"20240607125202-p5uadqo","Type":"NodeParagraph","Properties":{"id":"20240607125202-p5uadqo","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"4.《唐本草》：疗疳蚀，杀虫。"}]},{"ID":"20240607125202-klc04zn","Type":"NodeParagraph","Properties":{"id":"20240607125202-klc04zn","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"5.《四声本草》：小儿疳痢，为散，以浆水下。"}]},{"ID":"20240607125202-uyejg1o","Type":"NodeParagraph","Properties":{"id":"20240607125202-uyejg1o","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：治头风旋运。"}]},{"ID":"20240607125202-pyze1yi","Type":"NodeParagraph","Properties":{"id":"20240607125202-pyze1yi","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"7.《西藏常用中草药》：凉血，止血，散瘀消肿。治各种出血，跌打瘀肿，恶疮，烧伤，烫伤。"}]},{"ID":"20240607125202-j5o9db3","Type":"NodeParagraph","Properties":{"id":"20240607125202-j5o9db3","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"8.苏医《中草药手册》：祛风，利湿，清热，消肿。治乳糜尿，尿血，尿路感染，流感，白带过多，月经过多;外用治疗疮肿毒，痔疮肿痛。"}]},{"ID":"20240607125202-7ptimw3","Type":"NodeParagraph","Properties":{"id":"20240607125202-7ptimw3","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607125202-ry7ly49","Type":"NodeParagraph","Properties":{"id":"20240607125202-ry7ly49","updated":"20240607125202"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607125203-7ozo9uk","Type":"NodeThematicBreak","Properties":{"id":"20240607125203-7ozo9uk"}},{"ID":"20240607125204-9mhel5o","Type":"NodeParagraph","Properties":{"id":"20240607125204-9mhel5o"}}]}