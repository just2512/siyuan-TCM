width: 490px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"兰草 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/兰草 7-20240807170025-d05ccrm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 490px;\" parent-style=\"width: 500px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 657px;","style":"width: 647px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"兰草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/兰草 9-20240807170208-qn4psv1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 647px;\" parent-style=\"width: 657px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807163904-0ed1h25","Type":"NodeParagraph","Properties":{"id":"20240807163904-0ed1h25","updated":"20240807163904"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 955px;","style":"width: 945px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"兰草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/兰草-20240807163904-mn451et.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 945px;\" parent-style=\"width: 955px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807163944-oyz681q","Type":"NodeParagraph","Properties":{"id":"20240807163944-oyz681q","updated":"20240807163944"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 955px;","style":"width: 945px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"兰草 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/兰草 1-20240807163944-5qxp4eg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 945px;\" parent-style=\"width: 955px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240807164611-0tu04ak","Type":"NodeParagraph","Properties":{"id":"20240807164611-0tu04ak","updated":"20240807170102"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 506px;","style":"width: 496px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"兰草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/兰草 4-20240807164704-akxm3qi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 496px;\" parent-style=\"width: 506px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 618px;","style":"width: 608px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"兰草 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/兰草 8-20240807170102-dkwzflv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 608px;\" parent-style=\"width: 618px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607130022-wqzrta5","Type":"NodeThematicBreak","Properties":{"id":"20240607130022-wqzrta5"}},{"ID":"20240607130128-xvacv2c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607130128-xvacv2c","updated":"20240607130136"},"Children":[{"Type":"NodeText","Data":"兰草《神农本草经》"}]},{"ID":"20240607130128-ghrnsiu","Type":"NodeParagraph","Properties":{"id":"20240607130128-ghrnsiu","updated":"20240607130128"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240607130128-tat6cov","Type":"NodeParagraph","Properties":{"id":"20240607130128-tat6cov","updated":"20240607130128"},"Children":[{"Type":"NodeText","Data":"主利水道，杀蛊毒，辟不祥。久服，益气轻身，不老，通神明。一名水香。生池泽。"}]},{"ID":"20240607130128-eyc3p9o","Type":"NodeParagraph","Properties":{"id":"20240607130128-eyc3p9o","updated":"20240607130128"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生大吴，四月五月采。"}]},{"ID":"20240607130128-k233yhy","Type":"NodeParagraph","Properties":{"id":"20240607130128-k233yhy","updated":"20240607130128"},"Children":[{"Type":"NodeText","Data":"案《说文》云：兰，香草也；《广雅》云：蕳，兰也，易，其臭如兰，郑云兰，香草也，《夏小正》，五月蓄兰；《毛诗》云：方秉蕳分，《传》云蕳，兰也；陆玑云：蕳即兰，香草也，其茎叶似药草泽兰；《范子计然》云：大兰出汉中三辅，兰出河东，宏农，白者善，元杨齐贤注李白诗，引本草云：兰草，泽兰，二物同名，兰草一名水香，云，都梁是也，水经，零陵郡，都梁县西，小山上，有渟水，其中悉生兰草，绿叶紫茎，泽兰，如薄荷，微香，荆湘岭南人家多种之，与兰大抵相类，颜师古以兰草为泽兰，非也。"}]},{"ID":"20240607130201-f4uovv5","Type":"NodeThematicBreak","Properties":{"id":"20240607130201-f4uovv5"}},{"ID":"20240607130203-2ey2qbm","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607130203-2ey2qbm","updated":"20240607130207"},"Children":[{"Type":"NodeText","Data":"兰草《千金翼方》"}]},{"ID":"20240607130203-ebpzy5l","Type":"NodeParagraph","Properties":{"id":"20240607130203-ebpzy5l","updated":"20240607130203"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主利水道，杀蛊毒，辟不祥，除胸中痰癖。久服益气，轻身不老，通神明。一名水香，生大吴池泽，四月五月采。"}]},{"ID":"20240607130022-xp017sj","Type":"NodeThematicBreak","Properties":{"id":"20240607130022-xp017sj"}},{"ID":"20240607130023-0l6kfoy","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607130023-0l6kfoy","updated":"20240607130032"},"Children":[{"Type":"NodeText","Data":"兰草《本草纲目》"}]},{"ID":"20240607130023-9zdijcb","Type":"NodeParagraph","Properties":{"id":"20240607130023-9zdijcb","updated":"20240607130023"},"Children":[{"Type":"NodeText","Data":"「释名」（闲）、木香、香水兰、女兰、香草、燕尾香、大泽兰、兰泽草、煎泽草、省头草、都梁香、孩儿菊、千金草。"}]},{"ID":"20240607130023-v7v4oxz","Type":"NodeParagraph","Properties":{"id":"20240607130023-v7v4oxz","updated":"20240607130023"},"Children":[{"Type":"NodeText","Data":"「气味」（叶）辛、平、无毒。"}]},{"ID":"20240607130023-vgq6yge","Type":"NodeParagraph","Properties":{"id":"20240607130023-vgq6yge","updated":"20240607130023"},"Children":[{"Type":"NodeText","Data":"「主治」除胸中痰癖，治消渴，消痈肿，生血、调气，煮水，可以洗风病，可以解食牛马肉中毒。"}]},{"ID":"20240616164317-q65uhjm","Type":"NodeThematicBreak","Properties":{"id":"20240616164317-q65uhjm"}},{"ID":"20240616164318-7p8w5u0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164318-7p8w5u0","updated":"20240616164322"},"Children":[{"Type":"NodeText","Data":"兰草《名医别录》"}]},{"ID":"20240616164318-5unggzc","Type":"NodeParagraph","Properties":{"id":"20240616164318-5unggzc","updated":"20240616164318"},"Children":[{"Type":"NodeText","Data":"无毒．除胸中痰癖．生大吴．四月、五月采．"}]},{"ID":"20240616164318-mffswji","Type":"NodeParagraph","Properties":{"id":"20240616164318-mffswji","updated":"20240616164326"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶兰草，味辛，平．主利水道，杀蛊毒，辟不祥．久服，益气轻身不老，通神明。一名水香。生池泽。"}]},{"ID":"20240607130024-vv2er0y","Type":"NodeThematicBreak","Properties":{"id":"20240607130024-vv2er0y"}},{"ID":"20240607130043-8fqf0ul","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607130043-8fqf0ul","updated":"20240607130047"},"Children":[{"Type":"NodeText","Data":"兰草《医学入门》"}]},{"ID":"20240607130043-b8bpmnh","Type":"NodeParagraph","Properties":{"id":"20240607130043-b8bpmnh","updated":"20240607130043"},"Children":[{"Type":"NodeText","Data":"兰草芳平辛更甘，止渴生津去癖痰，利水散郁消诸痹，久服可与神明参。"}]},{"ID":"20240607130043-m0uhm0x","Type":"NodeParagraph","Properties":{"id":"20240607130043-m0uhm0x","updated":"20240607130043"},"Children":[{"Type":"NodeText","Data":"叶似马栏，故名兰草。即今人栽植座右，花开时满室清香者，无毒。善止消渴，除胸中痰癖。丹溪云∶散久积陈郁之气甚有力，利水道。经云∶消诸痹，治之以兰是也。兼杀蛊毒，辟不祥。和油煎膏，泽头长发。久服，益气润肌，轻身不老，可通神明。盖禀金水清气而似有火，方药俗人并不识用，惟东垣常用之。五六月采，阴干。入药煎煮。"}]},{"ID":"20240607130047-z6hp342","Type":"NodeThematicBreak","Properties":{"id":"20240607130047-z6hp342"}},{"ID":"20240616164129-aakwdmx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164129-aakwdmx","updated":"20240616164134"},"Children":[{"Type":"NodeText","Data":"兰草《神农本草经赞》"}]},{"ID":"20240616164129-s4aqrik","Type":"NodeParagraph","Properties":{"id":"20240616164129-s4aqrik","updated":"20240616164129"},"Children":[{"Type":"NodeText","Data":"味辛平。主利水道。杀蛊毒。辟不祥。久服益气轻身。不老通神明。一名水香。生池泽。"}]},{"ID":"20240616164129-23qqhb7","Type":"NodeParagraph","Properties":{"id":"20240616164129-23qqhb7","updated":"20240616164129"},"Children":[{"Type":"NodeText","Data":"沅湘纫。溱洧湔裾。斜抛燕剪。初浴鸡苏。福祥云集。毒蛊风除。千金良是。九畹息诬。"}]},{"ID":"20240616164129-hrrn7h8","Type":"NodeParagraph","Properties":{"id":"20240616164129-hrrn7h8","updated":"20240616164129"},"Children":[{"Type":"NodeText","Data":"九歌。浩浩沅湘。离骚。纫秋兰以为。诗疏。秉即兰香草。梁简文帝诗。湔裾出乐游。"}]},{"ID":"20240616164129-vyth6h1","Type":"NodeParagraph","Properties":{"id":"20240616164129-vyth6h1","updated":"20240616164129"},"Children":[{"Type":"NodeText","Data":"马志曰。其叶有歧。俗呼燕尾香。李时珍曰。开花成穗。如鸡苏。花红白色。梁简文帝序。"}]},{"ID":"20240616164129-tcrqmir","Type":"NodeParagraph","Properties":{"id":"20240616164129-tcrqmir","updated":"20240616164129"},"Children":[{"Type":"NodeText","Data":"云集雾会。唐书传赞。霆扫风除。方回说。古之兰草。即今之千金草。陆游诗。洛阳二顷言良是。杨慎曰。世以如萱蒲者为兰。九畹之受诬久矣。"}]},{"ID":"20240616164130-tgud86t","Type":"NodeThematicBreak","Properties":{"id":"20240616164130-tgud86t"}},{"ID":"20240616164138-vou8tn1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164138-vou8tn1","updated":"20240616164143"},"Children":[{"Type":"NodeText","Data":"兰草《本草经集注》"}]},{"ID":"20240616164138-v3dyrrd","Type":"NodeParagraph","Properties":{"id":"20240616164138-v3dyrrd","updated":"20240616164138"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主利水道，杀蛊毒，辟不祥。除胸中痰癖。久服益气，轻身。不老，通神明。一名水香。生大吴池泽，四月、五月采。"}]},{"ID":"20240616164138-cx2pbaa","Type":"NodeParagraph","Properties":{"id":"20240616164138-cx2pbaa","updated":"20240616164138"},"Children":[{"Type":"NodeText","Data":"方药世人并不复识用。大吴即应是吴国尔，太伯所居，故呼大吴。今东间有煎泽草名兰香，亦或者此也，生湿地。李云∶是今人所种，似都梁香草。"}]},{"ID":"20240616164139-0xpuw7c","Type":"NodeThematicBreak","Properties":{"id":"20240616164139-0xpuw7c"}},{"ID":"20240616164147-hppejow","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164147-hppejow","updated":"20240616164153"},"Children":[{"Type":"NodeText","Data":"兰草《得配本草》"}]},{"ID":"20240616164147-v3qd8kn","Type":"NodeParagraph","Properties":{"id":"20240616164147-v3qd8kn","updated":"20240616164147"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名省头草，一名孩儿菊，亦名香草。"}]},{"ID":"20240616164147-w0igvoa","Type":"NodeParagraph","Properties":{"id":"20240616164147-w0igvoa","updated":"20240616164147"},"Children":[{"Type":"NodeText","Data":"辛，平。入手足太阴、足阳明经气分。除陈气，（肥甘积滞不化之气。）止消渴，利水道，消痰癖，疗胆疸，辟恶气，散痈肿，调月经，解中牛马蛊毒。"}]},{"ID":"20240616164147-hnjr7gk","Type":"NodeParagraph","Properties":{"id":"20240616164147-hnjr7gk","updated":"20240616164147"},"Children":[{"Type":"NodeText","Data":"兰草、泽兰，一类二种，俱生水旁下湿处。紫茎、素枝、赤节、绿叶，叶对节生，有细齿，但以茎圆节长，叶光有歧者为兰草。茎微方，节短，叶有毛者为泽兰。嫩时并可采而佩之。"}]},{"ID":"20240616164147-qgnsrff","Type":"NodeParagraph","Properties":{"id":"20240616164147-qgnsrff","updated":"20240616164147"},"Children":[{"Type":"NodeText","Data":"胃气虚者禁用。"}]},{"ID":"20240616164148-svxmoof","Type":"NodeThematicBreak","Properties":{"id":"20240616164148-svxmoof"}},{"ID":"20240616164158-piqfcsi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164158-piqfcsi","updated":"20240616164202"},"Children":[{"Type":"NodeText","Data":"兰草《本草衍义》"}]},{"ID":"20240616164158-cakzuiu","Type":"NodeParagraph","Properties":{"id":"20240616164158-cakzuiu","updated":"20240616164158"},"Children":[{"Type":"NodeText","Data":"诸家之说异同，是曾未的识，故无定论。叶不香，惟花香。今江陵、鼎、澧州山谷之间颇有，山外平田即无。多生阴地，生于幽谷，益可验矣。叶如麦门冬而阔且韧，长及一、二尺，四时常青，花黄，中间叶上有细紫点。有春芳者，为春兰，色深；秋芳者为秋兰，色淡。秋兰稍难得，二兰移植小槛中，置座上，花开时满室尽香，与他花香又别。唐白乐天有种兰不种艾之诗，正为此兰矣。今未见用者。《本经》苏注∶“八月花白。”此即泽兰也。"}]},{"ID":"20240616164236-2j3otf8","Type":"NodeThematicBreak","Properties":{"id":"20240616164236-2j3otf8"}},{"ID":"20240616164237-oqxgkz1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164237-oqxgkz1","updated":"20240616164241"},"Children":[{"Type":"NodeText","Data":"兰草《证类本草》"}]},{"ID":"20240616164237-dfq66p0","Type":"NodeParagraph","Properties":{"id":"20240616164237-dfq66p0","updated":"20240616164237"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主利水道，杀蛊毒，辟不祥，除胸中痰癖。久服益气，轻身，不老，通神明。一名水香。生大吴池泽。四月、五月采。"}]},{"ID":"20240616164237-tpahws5","Type":"NodeParagraph","Properties":{"id":"20240616164237-tpahws5","updated":"20240616164237"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方药、俗人并不复识用。大吴，即应是吴国尔，太伯所居，故呼大吴。今东间有煎泽草，名兰香。亦或者此也，生湿地。李云∶是今人所种，似都梁香草。唐本注云∶此是兰泽香草也。八月花白，人间多种之以饰庭池，溪水涧旁往往亦有。陶云不识，又言煎泽草，或称李云都梁香近之，终非的识也。今按别本注云∶叶似马兰，故名兰草，俗呼为燕尾香。时人皆煮水以浴，疗风。故又名香水兰。陶云煎泽草，唐注云兰泽香，并非也。臣禹锡等谨按蜀本图经云∶叶似泽兰，尖长有歧，花红白色而香，生下湿地。陈藏器云∶兰草与泽兰，二物同名。陶公竟不能知，苏亦强有分别。按兰草本功外，主恶气，香泽可作膏涂发。生泽畔，叶光润，阴小紫，五月、六月采阴干，妇人和油泽头，故云兰泽。李云都梁是也。苏注兰草云∶八月花白，人多种于庭池，此即泽兰，非兰草也。泽兰叶尖，微有毛，不光润，方茎紫节，初采微辛，干亦辛，入产后补虚用之。已别出中品之下。苏乃将泽兰注于兰草之中，殊误也。《广志》云∶都梁香出淮南，亦名煎泽草，盛洪之《荆州记》曰∶都梁县有山，山下有水清浅，其中生兰草，因名为都梁，亦因山为号也。"}]},{"ID":"20240616164237-bs13c5c","Type":"NodeParagraph","Properties":{"id":"20240616164237-bs13c5c","updated":"20240616164237"},"Children":[{"Type":"NodeText","Data":"衍义曰∶兰草，诸家之说异，同是曾未的识，故无定论。叶不香，唯花香。今江陵、鼎、澧州山谷之间颇有，山外平田即无，多生阴地，生于幽谷，益可验矣。叶如麦门冬而阔，且韧，长及一、二尺，四时常青，花黄，中间叶上有细紫点，有春芳者，为春兰，色深。秋芳者，为秋兰，色淡。秋兰稍难得，二兰移植小槛中，置座右，花开时，满室尽香，与他花香又别。唐·白乐天有种兰不种艾之诗，正谓此兰矣。今未见用者。《本经》苏注∶八月花白，此即泽兰也。"}]},{"ID":"20240616164259-9diizp8","Type":"NodeThematicBreak","Properties":{"id":"20240616164259-9diizp8"}},{"ID":"20240616164300-xqjg8gr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164300-xqjg8gr","updated":"20240616164307"},"Children":[{"Type":"NodeText","Data":"兰草《要药分剂》"}]},{"ID":"20240616164300-gna7vi5","Type":"NodeParagraph","Properties":{"id":"20240616164300-gna7vi5","updated":"20240616164300"},"Children":[{"Type":"NodeText","Data":"即省头草。一名都梁香。味辛。性平。无毒。禀天地清芬之气以生。可升可降。阴中阳也。防己为使。"}]},{"ID":"20240616164300-d65173z","Type":"NodeParagraph","Properties":{"id":"20240616164300-d65173z","updated":"20240616164300"},"Children":[{"Type":"NodeText","Data":"【主治】主利水道。杀蛊毒。辟不祥。（本经）除胸中痰癖。（别录）其气清香。生津止渴。润【归经】入肺胃二经。为消痰除恶。散郁解结之品。（功专清肺开胃）【前论】元素曰。肺主气。肺气郁结。则上窍闭而下窍不通。胃主纳水谷。胃气郁滞。"}]},{"ID":"20240616164300-l0rjehe","Type":"NodeParagraph","Properties":{"id":"20240616164300-l0rjehe","updated":"20240616164300"},"Children":[{"Type":"NodeText","Data":"则水能利瘀。"}]},{"ID":"20240616164300-e3wjkk2","Type":"NodeParagraph","Properties":{"id":"20240616164300-e3wjkk2","updated":"20240616164303"},"Children":[{"Type":"NodeText","Data":"能除陈气。可知兰草固以不祥之气。亦胃中受病也。"}]},{"ID":"20240616164225-fi1aspr","Type":"NodeThematicBreak","Properties":{"id":"20240616164225-fi1aspr"}},{"ID":"20240616164227-he2xg1a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164227-he2xg1a","updated":"20240616164230"},"Children":[{"Type":"NodeText","Data":"兰草《本草乘雅半偈》"}]},{"ID":"20240616164227-ka0u9zm","Type":"NodeParagraph","Properties":{"id":"20240616164227-ka0u9zm","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240616164227-mnd3828","Type":"NodeParagraph","Properties":{"id":"20240616164227-mnd3828","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"【气味】辛平，无毒。"}]},{"ID":"20240616164227-et8nr3m","Type":"NodeParagraph","Properties":{"id":"20240616164227-et8nr3m","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"【主治】主利水道，杀蛊毒，辟不祥。久服益气，轻身，不老，通神明。"}]},{"ID":"20240616164227-qkr9osn","Type":"NodeParagraph","Properties":{"id":"20240616164227-qkr9osn","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"【核】曰∶兰草，香草也。别名都梁香、千金草，即孩儿菊、醒头草也。礼记佩 兰 。"}]},{"ID":"20240616164227-jpy4sef","Type":"NodeParagraph","Properties":{"id":"20240616164227-jpy4sef","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"楚辞纫秋兰以为佩。西京杂记载∶汉时池苑，种兰以降神，或杂粉藏书衣中，主辟蠹者，皆此兰也。出太吴池畔，及溪涧水旁下湿地。荆州记云∶都梁有山，下有水，清浅之中，生兰草。诗疏云∶郑俗，三月男女秉 于水际，以自祓除者是也。二月宿根再发，紫茎素枝，赤节绿叶，叶对节生，光泽有岐，嫩时可 ，可佩。八九月渐老，枝头成穗，作花红白，状似鸡苏，久之花瓣转白，绒裂如球，球中有子一粒，绒着子上，色黑，味苦，臭香气烈，即千金花也。一种山兰，即兰草之生山中者，茎叶花实都同，但山泽有分，功用亦异。与泽兰同类异种，故兰草名大泽兰，泽兰名小泽兰，二种皆生水旁。但泽兰茎方节短，叶上有涩毛，气味俱疏淡，功用则迥别矣。近世之所谓兰，非古之所谓兰草。兰生山谷，叶如麦冬而稍长，四季长青，不畏霜雪，迎春开花，花出根底，一干一朵，亦有一干数朵者，小兰也。若生闽、广，叶似菅茅而稍短，四季长青，畏霜雪，及春风。入夏开花，花出根底，一干数朵，亦有一干一朵者，秋兰也。朱子离骚辨证云∶古之香草，花叶俱香，燥湿不变，今之兰类，花萼虽香，干则腐臭，叶又不香，不识何时以幽兰误兰草也。方虚谷订兰说云∶古之所谓兰，即今之孩儿菊，千金草。今之所谓兰，其叶如茅，根名土续断，花萼馥郁，故得兰名。杨升庵云∶世以蒲宣者为兰，九畹之受诬久矣。吴草庐兰说云∶兰草有枝有茎，草之植者也。幽兰无枝无茎，草之芳者也。因山谷称之，置之座右，世遂谬指为离骚所称之兰以此。"}]},{"ID":"20240616164227-jxgybjq","Type":"NodeParagraph","Properties":{"id":"20240616164227-jxgybjq","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"【 】曰∶臭香，味辛，气化中药也。故主益气，利水道。经云∶膀胱者，州都之官，津液藏焉，气化则能出矣。"}]},{"ID":"20240616164227-h4jv1ns","Type":"NodeParagraph","Properties":{"id":"20240616164227-h4jv1ns","updated":"20240616164227"},"Children":[{"Type":"NodeText","Data":"故兰，阑也，泛阑流离也。又兰，阑也。阑辟不祥也。主杀蛊毒，通神明，令轻身不老也。花即千金花，苗即千金草，以花煮酒，臭类木香，苦甚黄连。用治滞痢，获效颇捷，正阑辟不祥，利水道，宣气四达之功耳。"}]},{"ID":"20240616164158-5t2jd44","Type":"NodeThematicBreak","Properties":{"id":"20240616164158-5t2jd44"}},{"ID":"20240616164214-cfzur4j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616164214-cfzur4j","updated":"20240616164219"},"Children":[{"Type":"NodeText","Data":"兰《本草述钩元》"}]},{"ID":"20240616164214-1tqgvht","Type":"NodeParagraph","Properties":{"id":"20240616164214-1tqgvht","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"兰草泽兰合考兰草。香草也。（非今世兰蕙花）别名都梁香。（都梁有山。即今武冈州。"}]},{"ID":"20240616164214-7o3acu4","Type":"NodeParagraph","Properties":{"id":"20240616164214-7o3acu4","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"又盱眙县亦有都梁山。皆产此。）又名千金草。即孩儿菊醒头草也。出溪涧水旁下湿地。二月宿根再发。紫茎素枝。赤节绿叶。叶对节生。光泽有歧。八九月枝头成穗。作花红白似鸡苏。久之转白。绒裂如球。球中有子。绒着子上。色黑味苦。臭香气烈。即千金花也。兰草与泽兰同类异种。但以茎圆节长。而叶光有歧者为兰草。茎微方节短。而叶有毛者为泽兰。"}]},{"ID":"20240616164214-83od1yu","Type":"NodeParagraph","Properties":{"id":"20240616164214-83od1yu","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"气味俱疏淡。而功用则迥别。（核）"}]},{"ID":"20240616164214-74ghfwl","Type":"NodeParagraph","Properties":{"id":"20240616164214-74ghfwl","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"叶气味辛平。东垣曰甘寒。其气清香。入手太阴足阳明经。主治利水道。除胸中痰癖。"}]},{"ID":"20240616164214-v43w5uc","Type":"NodeParagraph","Properties":{"id":"20240616164214-v43w5uc","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"生津止渴。治消渴胆痹。调气养营。久服益气轻身。煮水浴风病。浸油涂发。去风垢令香润。"}]},{"ID":"20240616164214-7ag5qhq","Type":"NodeParagraph","Properties":{"id":"20240616164214-7ag5qhq","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"方书治齿疾。素问云。五味入口。藏于脾胃。以行其精气。津液在脾。令人口甘。此肥美所发也。其气上溢。转为消渴。治之以兰。除陈气也。东垣治消渴生津饮。用兰叶本于此。（濒湖）臭香味辛。气化中药也。故主益气利水道。（之颐）肺气郁结。则上窍闭而下窍不通。"}]},{"ID":"20240616164214-bx85u76","Type":"NodeParagraph","Properties":{"id":"20240616164214-bx85u76","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"胃气郁滞。则水谷不以时化而为痰癖。此草辛平芬芳。能散结滞。大都开胃除恶。清肺消痰。"}]},{"ID":"20240616164214-wi1az6i","Type":"NodeParagraph","Properties":{"id":"20240616164214-wi1az6i","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"为散郁结之圣药。（仲淳）以花煮酒。臭类木香。苦甚黄连。用治滞痢。获效颇捷。（之颐）同藿香枇杷叶石斛竹茹橘红。为开胃气之神品。加入沉香郁金白蔻苏子芦根汁下气开郁。治噎膈之将成者。同栝蒌根麦冬黄连竹叶芦根汁。治消渴。"}]},{"ID":"20240616164214-cl455bv","Type":"NodeParagraph","Properties":{"id":"20240616164214-cl455bv","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"叶味苦辛甘酸。气微温。阴中之阳。足太阴厥阴经药也。苦辛泄热。甘能和血。酸能入肝。温通营血。行而带补。妇人方中最为急用。防己为之使。主治养血气。破宿血。利关节。通九窍。消身面水肿。并痈肿及头风目痛。女子频产血气衰冷。成痨羸瘦。及血沥腰痛产后诸病。气香而温。味辛而散。脾喜芳香。肝宜辛散。脾气舒则三焦通利而正气和。肝郁散则营卫流行而病邪解。故为女子方中所急用。（濒湖）补而不滞。行而不峻。为产科要药。"}]},{"ID":"20240616164214-qc50yvx","Type":"NodeParagraph","Properties":{"id":"20240616164214-qc50yvx","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"得炒黑豆炮姜芎归地芍牛膝蒲黄五灵脂益母草。治产后恶露不尽。少腹作痛。寒月加桂。多火及内热虚劳人。去桂加童便。去五灵脂加人参鳖甲香附麦冬。治产后诸虚百病。肺热者去人参。月候不通。结块发热者。泽兰一束。捣烂酒浸。温饮之。日二三次。当通。产后水肿。血虚浮肿。泽兰防己等分。为末。每服二钱。醋酒下。水肿肾沉膀胱浮者。同泽泻茯苓猪苓白术木通灯草通草牡蛎滑石附子葶苈瞿麦车前防己用。"}]},{"ID":"20240616164214-gq170o1","Type":"NodeParagraph","Properties":{"id":"20240616164214-gq170o1","updated":"20240616164214"},"Children":[{"Type":"NodeText","Data":"〔总论〕濒湖言兰草泽兰功用。有气血之分。兰草走气道。故能利水。除痰癖。杀蛊辟恶。而为消渴良药。泽兰走血分。故治水肿。涂痈毒。破瘀血。消症瘕。而为妇人要药。虽是一类。而功用稍殊。正如赤白茯苓芍药补泻不同也。按二药分气血之治是矣。第本经久服兰草何以益气。而甄权于泽兰何以治频产血气衰冷成痨羸瘦。此义未经发明。犹未免与他味之利气血者例视也。"}]},{"ID":"20240616164215-v464fiz","Type":"NodeThematicBreak","Properties":{"id":"20240616164215-v464fiz"}},{"ID":"20240616164352-sunhsvz","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240616164352-sunhsvz","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"兰花"}]},{"ID":"20240616164352-f06mzea","Type":"NodeParagraph","Properties":{"id":"20240616164352-f06mzea","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240616164352-h2npu33","Type":"NodeParagraph","Properties":{"id":"20240616164352-h2npu33","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" Lán Huā"}]},{"ID":"20240616164352-8daq9x0","Type":"NodeParagraph","Properties":{"id":"20240616164352-8daq9x0","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240616164352-zb4veky","Type":"NodeParagraph","Properties":{"id":"20240616164352-zb4veky","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 幽兰、蕙、兰蕙"}]},{"ID":"20240616164352-mvj9dg6","Type":"NodeParagraph","Properties":{"id":"20240616164352-mvj9dg6","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240616164352-nye0wdk","Type":"NodeParagraph","Properties":{"id":"20240616164352-nye0wdk","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" Flower of Swordleaf Cymbidium"}]},{"ID":"20240616164352-9y8g9ym","Type":"NodeParagraph","Properties":{"id":"20240616164352-9y8g9ym","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240616164352-61hbpnl","Type":"NodeParagraph","Properties":{"id":"20240616164352-61hbpnl","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 出自《本草纲目拾遗》。"}]},{"ID":"20240616164352-7chyt13","Type":"NodeParagraph","Properties":{"id":"20240616164352-7chyt13","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"1.《本草衍义》：兰草叶不香，惟花香，今江陵、鼎、澧州山谷之间颇有，山外平田即无。多生阴地，生于幽谷。叶如麦门冬而阔且韧，长及一、二尺，四时常青，花黄，中间叶上有细紫点。有春芳者为春兰，色深；秋芳者为秋兰，色淡。秋兰稍难得，二兰移植小槛中，置座右，花开时，满室尽香，与他花香又别。"}]},{"ID":"20240616164352-tqdj7rw","Type":"NodeParagraph","Properties":{"id":"20240616164352-tqdj7rw","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：兰花生近处者，叶如麦门冬而春花；生福建者，叶如管茅而秋花。"}]},{"ID":"20240616164352-hrsfpkh","Type":"NodeParagraph","Properties":{"id":"20240616164352-hrsfpkh","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"3"}]},{"ID":"20240616164352-37oovmz","Type":"NodeParagraph","Properties":{"id":"20240616164352-37oovmz","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240616164352-ibc3yg6","Type":"NodeParagraph","Properties":{"id":"20240616164352-ibc3yg6","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 药材基源：为兰科植物建兰、春兰、蕙兰、多花兰或台兰的花"}]},{"ID":"20240616164352-vn0rlqq","Type":"NodeParagraph","Properties":{"id":"20240616164352-vn0rlqq","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Cymbidium ensifolium(L.)Sw.[Eidendrum ensifolium L.]2.Cymbidium goeringii(Reichb.f.)Reichb.f.[C.virescens Lindl.;Maxillaria goeringii Reichb.f.]3.Cymbidium faberi Rolfe4.Cymbidium kanran Makino5.Cymbidium floribumdum Lindl.6.Cymbidium floribundum Lindl.var.pumilum(Rolfe)Y.S.Wu et S.C.Chen[C.pumilum Rolfe]"}]},{"ID":"20240616164352-l0oj1pt","Type":"NodeParagraph","Properties":{"id":"20240616164352-l0oj1pt","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"采收和储藏：花将开放时采收，鲜用或晒干。"}]},{"ID":"20240616164352-tu6iugy","Type":"NodeParagraph","Properties":{"id":"20240616164352-tu6iugy","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240616164352-lc5dklm","Type":"NodeParagraph","Properties":{"id":"20240616164352-lc5dklm","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山坡林下。"}]},{"ID":"20240616164352-9k976yh","Type":"NodeParagraph","Properties":{"id":"20240616164352-9k976yh","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"2.生于山坡林下或溪边。3.生于林下阴湿处。"}]},{"ID":"20240616164352-92wcfdc","Type":"NodeParagraph","Properties":{"id":"20240616164352-92wcfdc","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"4.生于山坡林下。"}]},{"ID":"20240616164352-qzzendt","Type":"NodeParagraph","Properties":{"id":"20240616164352-qzzendt","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"5.生于山坡林下岩石或附生树上。"}]},{"ID":"20240616164352-1k4u6f2","Type":"NodeParagraph","Properties":{"id":"20240616164352-1k4u6f2","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"6.于山坡地生或树上半附生。"}]},{"ID":"20240616164352-20g24ig","Type":"NodeParagraph","Properties":{"id":"20240616164352-20g24ig","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于华东、中南、西南。各地有栽培，变种、变型及栽培品种很多。"}]},{"ID":"20240616164352-2yc090v","Type":"NodeParagraph","Properties":{"id":"20240616164352-2yc090v","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"2.分布于华东、中南、西南及甘肃、陕西。各地有栽培，变型及栽培品处很多。"}]},{"ID":"20240616164352-i3mc73c","Type":"NodeParagraph","Properties":{"id":"20240616164352-i3mc73c","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"3.分布于华东、中南、西南及陕西。各地有栽培，变种、变型及栽培品种较多。"}]},{"ID":"20240616164352-1gbqz7e","Type":"NodeParagraph","Properties":{"id":"20240616164352-1gbqz7e","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"4.分布于华东、华南及云南。各地有栽培，变种及栽培品种较多。"}]},{"ID":"20240616164352-tsznike","Type":"NodeParagraph","Properties":{"id":"20240616164352-tsznike","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"5.分布于华东、中南、西南及西藏。各地有栽培。变种、变型及栽培品种较多。"}]},{"ID":"20240616164352-az9q5dz","Type":"NodeParagraph","Properties":{"id":"20240616164352-az9q5dz","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"6.分布于浙江、福建、台湾、广东、广西、湖北、湖南、江西、四川、云南、贵州等地。"}]},{"ID":"20240616164352-gkuniqu","Type":"NodeParagraph","Properties":{"id":"20240616164352-gkuniqu","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240616164352-9uxw8mm","Type":"NodeParagraph","Properties":{"id":"20240616164352-9uxw8mm","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 1.建兰，陆生植物。叶2-6枚丛生，薄革质，带形，较柔软，弯曲而下垂，长30-50cm，宽1-1.7cm，略有光泽，先端渐尖，边缘有不不甚明显的钝齿。花葶直立，高20-35cm，较叶为短。通常有4-7花，最多达13朵花；花苞片在花序轴中上部者长不及1cm，最下1枚达1.5cm；花浅黄绿色，有清香气；萼片狭长圆状披针形，长3cm左右，宽5-7mm，浅绿色，先端较绿，基部较淡，具5条较深色的脉；花瓣较短，互相靠拢，色浅而有紫色斑纹；唇瓣不明显3裂，侧裂片浅黄褐色，唇盘中央具2条半月形裼片，白色，中裂片反卷，浅黄色带紫红色斑点。花期7-10月。"}]},{"ID":"20240616164352-dlk7hma","Type":"NodeParagraph","Properties":{"id":"20240616164352-dlk7hma","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"2.春兰，陆生植物。假鳞茎集生成丛。叶4-6枚丛生，狭带形，长20-40cm，宽6-11mm，先端渐尖，边缘具细锯齿。花葶直立，远比叶短，被4-5枚长鞘；花苞片长而宽，比子房连花梗长；花单生，少为2朵，直径4-5cm，浅黄绿色，有清香气；萼片近相等。狭长圆形，长3.5cm左右，通常宽6-8mm，先端急尖，中脉基部具紫褐色条纹；花瓣卵状披针形，比萼片略短；唇瓣不明显3裂，比花瓣短，浅黄色带紫褐色斑点，先端反卷，唇盘中央从基部至中部具2条褶片。花期2-3月。"}]},{"ID":"20240616164352-rz31kc6","Type":"NodeParagraph","Properties":{"id":"20240616164352-rz31kc6","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"3.蕙兰，陆生植物。叶7-9枚丛生，直立性强，长25-80cm，宽约1cm，中下部常对裼，先端渐尖，基部关节不明显，边缘有细锯齿；具明显透明的脉。花葶直立，高30-80cm，绿白色或紫褐色，被数枚长鞘；总状花序具6-12余朵花；花葶片常比子房连花梗短，最下面1枚较长，长达3cm；花浅黄绿色；萼片近相等，狭披针形，长3-4cm，宽6-8mm，先端锐尖；花瓣略小于萼片；唇瓣不不明显3裂，短于萼片，侧裂片直立，有紫色斑点，中裂片椭圆形，上面具透明乳突状毛，边缘具缘毛，有白色带紫红色斑点，唇盘从基部至中闸有2条稍弧曲的褶片。花期4-5月。"}]},{"ID":"20240616164352-y1spc12","Type":"NodeParagraph","Properties":{"id":"20240616164352-y1spc12","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"4.寒兰，陆生植物。叶3-7枚丛生，带形，直立性强，长35-70cm，宽10-17mm，先端渐尖，全缘或有时近先端具细齿，薄革质略带光泽。花葶直立，近等于或长于叶，心生5-10余朵花；花苞片狭披针形，通常长13-28mm，在最下面者长达4cm；花梗连子房长2.5-4cm；花色多变，有浓香气；萼片狭长圆状披针形，长4cm左右，宽4-7mm，先端渐尖；花瓣较短而宽，向上外伸，中脉紫红色，基部有紫晕；唇瓣不明显3裂，侧裂片直立，半圆形，有紫红色斜纹，中裂片乳白色，中间黄绿色紫孩子，唇盘从基部至中部具2条平行的褶片，褶片黄色，光滑无毛。花期10-12月。"}]},{"ID":"20240616164352-ia0udz8","Type":"NodeParagraph","Properties":{"id":"20240616164352-ia0udz8","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"5.多花兰，附生植物。假鳞茎粗壮，叶3-6枚丛生，直立性强，带形通常长40cm左右，宽1.5-3cm，先端稍钩转或尖裂，基部关节明显，全缘。花葶直立，比叶短，花密集，多至50朵花；花苞片长约5mm；花梗连子房长1.6-3cm；花红褐色，无香气；萼片近相等，狭长圆状披针形，长2cm左右，宽约5mm，红褐色，中部略带黄褐色，边缘稍向后反卷；花瓣近等长于萼片，向两边开展，紫褐色带黄色边缘；唇瓣3裂，约等长于花瓣，上面具乳突，侧裂片近半圆形，直立，有紫褐色条纹，边缘紫红色，中裂片近圆形，稍反折，紫红色，中部有浅黄色晕，唇盘从基部至中部具2条平行的褶片，褶片黄色。花期5-6月。"}]},{"ID":"20240616164352-kwn498f","Type":"NodeParagraph","Properties":{"id":"20240616164352-kwn498f","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"6.台兰，台兰与多花兰相似，但本种较矮小，叶片厚而光泽，花茎长15-30cm，着花15-40朵，花形较小，深紫褐色，唇瓣白色，无香气。"}]},{"ID":"20240616164352-isp6ji9","Type":"NodeParagraph","Properties":{"id":"20240616164352-isp6ji9","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240616164352-37x7i6j","Type":"NodeParagraph","Properties":{"id":"20240616164352-37x7i6j","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 建兰品种甚多，其中以花色纯白者为上，称为素心兰。此外，同属植物春兰CymbidiumvirescensLindl．及夏兰C. Pumilum Rolfe的花、根、叶亦同等入药。春兰1茎1花，花期春季；夏兰1茎7-10余花，花期初夏。"}]},{"ID":"20240616164352-avlgt30","Type":"NodeParagraph","Properties":{"id":"20240616164352-avlgt30","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240616164352-d6ps5w6","Type":"NodeParagraph","Properties":{"id":"20240616164352-d6ps5w6","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 蕙兰花含挥发组分，由茉莉酮酸甲酯(methyl jasmonate)，表茉莉酮酸甲酯(methyl epijasmonate)等33个化合物组成。"}]},{"ID":"20240616164352-rt2uv7v","Type":"NodeParagraph","Properties":{"id":"20240616164352-rt2uv7v","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"春兰花含酸性磷酸酶(acidic phosphatase)，酯化酶(esterase)，天冬氨酸转氨酶同工酶(aspartate aminotransferase isoenzymes)。"}]},{"ID":"20240616164352-xd2mxyw","Type":"NodeParagraph","Properties":{"id":"20240616164352-xd2mxyw","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240616164352-mdc3jwd","Type":"NodeParagraph","Properties":{"id":"20240616164352-mdc3jwd","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 肺；脾；肝经"}]},{"ID":"20240616164352-n0yszh5","Type":"NodeParagraph","Properties":{"id":"20240616164352-n0yszh5","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240616164352-jy36as6","Type":"NodeParagraph","Properties":{"id":"20240616164352-jy36as6","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 味辛；性平"}]},{"ID":"20240616164352-5qmeoqi","Type":"NodeParagraph","Properties":{"id":"20240616164352-5qmeoqi","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240616164352-az1kdbr","Type":"NodeParagraph","Properties":{"id":"20240616164352-az1kdbr","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 调气和中；止咳；明目。主胸闷；腹泻；久咳；青盲内障"}]},{"ID":"20240616164352-iftyfhx","Type":"NodeParagraph","Properties":{"id":"20240616164352-iftyfhx","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240616164352-d2c54tp","Type":"NodeParagraph","Properties":{"id":"20240616164352-d2c54tp","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 内服：泡茶或水炖，3-9g。"}]},{"ID":"20240616164352-rp51uns","Type":"NodeParagraph","Properties":{"id":"20240616164352-rp51uns","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240616164352-0oy7iq2","Type":"NodeParagraph","Properties":{"id":"20240616164352-0oy7iq2","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 1.《纲目拾遗》：素心建兰花除宿气，解郁。蜜渍青兰花点茶饮，调和气血，宽中醒酒。黄花者名蜜兰，可以止泻。色黑者名墨兰、治青盲最效。"}]},{"ID":"20240616164352-fm233gi","Type":"NodeParagraph","Properties":{"id":"20240616164352-fm233gi","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"2.《分类草药性》：明目。"}]},{"ID":"20240616164352-tu9dv0x","Type":"NodeParagraph","Properties":{"id":"20240616164352-tu9dv0x","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"3.《泉州本草》；治久嗽。"}]},{"ID":"20240616164352-fbugdrn","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240616164352-fbugdrn","updated":"20240616164352"},"Children":[{"ID":"20240616164352-inxwr3y","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240616164352-inxwr3y","updated":"20240616164352"},"Children":[{"ID":"20240616164352-po8q0r2","Type":"NodeParagraph","Properties":{"id":"20240616164352-po8q0r2","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"厦门《新疗法与中草药选编》：清肺除热，消痰止咳。"}]}]}]},{"ID":"20240616164352-6bg866z","Type":"NodeParagraph","Properties":{"id":"20240616164352-6bg866z","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240616164352-k718g1m","Type":"NodeParagraph","Properties":{"id":"20240616164352-k718g1m","updated":"20240616164352"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240616164353-o9risbb","Type":"NodeThematicBreak","Properties":{"id":"20240616164353-o9risbb"}},{"ID":"20240616164354-vevaioy","Type":"NodeParagraph","Properties":{"id":"20240616164354-vevaioy"}}]}