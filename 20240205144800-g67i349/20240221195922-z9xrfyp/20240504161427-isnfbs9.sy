tyle":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜仲 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜仲 7-20240715090836-f1yp3lt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 592px;","style":"width: 582px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜仲 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜仲 4-20240811093339-racoti4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 582px;\" parent-style=\"width: 592px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715090659-33lgmfs","Type":"NodeParagraph","Properties":{"id":"20240715090659-33lgmfs","updated":"20240811093259"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 585px;","style":"width: 575px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜仲 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜仲 5-20240715090659-gzj05xi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 575px;\" parent-style=\"width: 585px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 522px;","style":"width: 512px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杜仲 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/杜仲 6-20240715090742-6lfe3zm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 512px;\" parent-style=\"width: 522px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607150216-7r987yi","Type":"NodeParagraph","Properties":{"id":"20240607150216-7r987yi","updated":"20240620165656"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：杜仲是杜仲科杜仲属植物的树皮。"}]},{"ID":"20240811092849-hm7jt7h","Type":"NodeParagraph","Properties":{"id":"20240811092849-hm7jt7h","updated":"20240811092907"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：杜仲为雌雄异株植物，雄树开花，雌树结子。"}]},{"ID":"20240607150229-kc0aty7","Type":"NodeThematicBreak","Properties":{"id":"20240607150229-kc0aty7"}},{"ID":"20240607150230-q5vt7lp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150230-q5vt7lp","updated":"20240607150235"},"Children":[{"Type":"NodeText","Data":"杜仲《神农本草经》"}]},{"ID":"20240607150230-yaxgpwp","Type":"NodeParagraph","Properties":{"id":"20240607150230-yaxgpwp","updated":"20240607150230"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240607150230-c2rgew1","Type":"NodeParagraph","Properties":{"id":"20240607150230-c2rgew1","updated":"20240607150230"},"Children":[{"Type":"NodeText","Data":"主腰脊痛，补中，益精气，坚筋骨，强志，除阴下痒湿，小便余沥。久服轻身耐老。一名思仙。生山谷。"}]},{"ID":"20240607150230-kq8lvqu","Type":"NodeParagraph","Properties":{"id":"20240607150230-kq8lvqu","updated":"20240607150230"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：杜仲，一名木绵，一名思仲。（《御览》）"}]},{"ID":"20240607150230-e5ouxd6","Type":"NodeParagraph","Properties":{"id":"20240607150230-e5ouxd6","updated":"20240607150230"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名思仲，一名木绵，生上虞及上党汉中，二月五月六月九月采皮。"}]},{"ID":"20240607150230-5ojr4bh","Type":"NodeParagraph","Properties":{"id":"20240607150230-5ojr4bh","updated":"20240607150230"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：杜仲，曼榆也。《博物志》云：杜仲，皮中有丝，折之则见。"}]},{"ID":"20240617111138-3050v3a","Type":"NodeThematicBreak","Properties":{"id":"20240617111138-3050v3a"}},{"ID":"20240617111144-wx45d8c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111144-wx45d8c","updated":"20240617111148"},"Children":[{"Type":"NodeText","Data":"杜仲《名医别录》"}]},{"ID":"20240617111144-4df4suu","Type":"NodeParagraph","Properties":{"id":"20240617111144-4df4suu","updated":"20240617111144"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒．主治脚中酸疼痛，不欲践地．一名思仲，一名木绵．生上虞及上党汉中．二月、五月、六月、九月采皮，阴干．（畏蛇蜕皮、玄参．）"}]},{"ID":"20240617111144-pxw4oqs","Type":"NodeParagraph","Properties":{"id":"20240617111144-pxw4oqs","updated":"20240617111155"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶杜仲，味辛，平．主要脊痛，补中，益精气，坚筋骨，强志，除阴下痒湿，小便余沥．久服轻身耐老。一名思仙。生山谷。"}]},{"ID":"20240607150648-9kek8ig","Type":"NodeThematicBreak","Properties":{"id":"20240607150648-9kek8ig"}},{"ID":"20240607150649-mj3xqw6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150649-mj3xqw6","updated":"20240607150654"},"Children":[{"Type":"NodeText","Data":"杜仲《本草述钩元》"}]},{"ID":"20240607150649-8nxxtof","Type":"NodeParagraph","Properties":{"id":"20240607150649-8nxxtof","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"味辛甘微苦。气平而温。气薄味浓。降也。入足少阴厥阴经。肝经气分药。主治腰膝痛。补中益精气。坚筋骨强志。除阴下痒湿。小便余。治肾劳腰脊挛。脚中酸疼。不欲践地。（此阴不得阳以运者）除肾冷。润肝燥。补肝经风虚。能使筋骨相着。（东垣）虽温而不助火。（士材）色紫而润。气温平而和阳。味辛甘而裕阴。故能由肾而致肝之功用若此。（濒湖）肾苦燥。急食辛以润之。肝苦急。急食甘以缓之。杜仲辛甘具足。正能解肝肾之所苦。而补其不足者。同牛膝枸杞子续断白胶地黄山药五味子菟丝子黄柏。治肾虚腰痛。及下部软弱无力。胎孕三四月惯堕者。于两月前。以杜仲八两。糯米煎汤浸透。"}]},{"ID":"20240607150649-3ewl3xp","Type":"NodeParagraph","Properties":{"id":"20240607150649-3ewl3xp","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"炒去丝。续断二两。酒浸焙干。为末。以山药末五六两糊丸。梧子大。空心米饮下。少年新娶得脚软病疼甚。作香港脚治不效。用杜仲一两。每半酒半水煎服。取愈。"}]},{"ID":"20240607150649-ew8kgi2","Type":"NodeParagraph","Properties":{"id":"20240607150649-ew8kgi2","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"〔论〕杜仲味先辛。次甘。又次苦。甘不敌辛。而苦则微甚。以辛始而以苦终。是苦乃辛甘归宿之地。而引辛甘致其用者。固在苦也。苦属火。苦所就下之火。即元气。兹味由辛甘而苦。是其归于中五之冲气者。皆降而浓育乎阴中之阳也。即其色紫。非下就相火之一证乎。夫三焦元气。上下际蟠。（水中有火。乃肾中元气。而三焦布之。）兹何以独致其用于下。盖中土之甘。化归于肾。而天气之辛化。又因中土而归之。则所谓益元阳。致津液者。"}]},{"ID":"20240607150649-5yl9pni","Type":"NodeParagraph","Properties":{"id":"20240607150649-5yl9pni","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"其总之。此味功用。全以元气为本。（身半以下。腰膝与脚。皆借此阴中元阳以为张弛之主。"}]},{"ID":"20240607150649-g6mkn3h","Type":"NodeParagraph","Properties":{"id":"20240607150649-g6mkn3h","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"至于疗堕胎。尤以化为主。不徒恃形器之相维也。）本经所谓益精气强志。皆不离元气而言。但于阴中生阳。即于阳中含阴。非偏于阳者。（非偏于补阳。故兹味以益精气为主。精气益则筋骨自坚。）经故谓其气平。李氏亦云温而不助火也。抑三焦元气即肾气。乃又言其为肝经气分药者。以肝本肾为化原。而还为肾畅其化育之用。试参东垣能使筋骨相着一语。"}]},{"ID":"20240607150649-00radfa","Type":"NodeParagraph","Properties":{"id":"20240607150649-00radfa","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"则可见肝之化原在肾。而肾之资益在肝。此味由肾益肝。即由肝资肾。故得筋骨相着。肝之借以致其气化者此耳。非谓其更入肝也。（能补肾中元气。即是肝经气分药。即是能补风虚润肝燥药。肝燥者何。元阳虚而风木之真气不达。故燥急也。）藉非本于三焦之元气。阴中生阳。阳中含阴。其能使风虚肝燥胥以受益乎。至如阴下痒湿。小便余沥。皆阳气之不周于阴也。虽贵其脂润。而取用在皮。亦可以思矣。审此则凡阴虚以为腰痛者。犹当酌而施之矣。甄权疗肾冷腰痛。日华子治肾劳腰脊挛。夫冷与劳。皆属肾气之虚。肾中元阳虚。即有腰痛脊挛之证。亦即有阳虚而病于风之证。盖阳虚而并。不能达阴。故病于风。即海藏所谓风虚也。又所谓肝燥者。即阳不得致于肝。而阴亦不得随之以至肝也。阴阳合一之义。可于兹味见一班。惟由益肾以致肝。比于石枣（即山萸肉）之先温肝以助肾者有异耳。"}]},{"ID":"20240607150649-5sfbdhx","Type":"NodeParagraph","Properties":{"id":"20240607150649-5sfbdhx","updated":"20240607150649"},"Children":[{"Type":"NodeText","Data":"肾虚火炽者。不宜用。即用当与知柏同入。（仲淳）〔修治〕削去粗皮。每一斤。用酥一两。蜜三两。和涂火炙。以尽为度。一法。用酒炒断丝。以渐取屑。方不焦。浓而实者。能强筋骨。用面炒去丝。童便浸七日。新瓦焙干为末。"}]},{"ID":"20240607150216-zyedflh","Type":"NodeThematicBreak","Properties":{"id":"20240607150216-zyedflh"}},{"ID":"20240607150256-6wdxy8z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150256-6wdxy8z","updated":"20240607150305"},"Children":[{"Type":"NodeText","Data":"杜仲《神农本草经百种录》"}]},{"ID":"20240607150256-rr4ia9c","Type":"NodeParagraph","Properties":{"id":"20240607150256-rr4ia9c","updated":"20240607150256"},"Children":[{"Type":"NodeText","Data":"味辛平。主腰脊痛，补中益精气，坚筋骨，强志，其质坚韧者，其精气必足，故亦能坚定人身之筋骨气血也。除阴下痒湿，补皮利湿。小便余沥。坚溺管之气。久服，轻身耐老。强健肢体。杜仲木之皮，木皮之韧且浓者此为最，故能补人之皮。又其中有丝连属不断，有筋之象焉，故又能续筋骨。因形以求理，则其效可知矣。"}]},{"ID":"20240607150715-kb08zk9","Type":"NodeThematicBreak","Properties":{"id":"20240607150715-kb08zk9"}},{"ID":"20240607150753-p57iz71","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150753-p57iz71","updated":"20240607150804"},"Children":[{"Type":"NodeText","Data":"杜仲《本草便读》"}]},{"ID":"20240607150753-b0c9icp","Type":"NodeParagraph","Properties":{"id":"20240607150753-b0c9icp","updated":"20240607150759"},"Children":[{"Type":"NodeText","Data":"杜仲"}]},{"ID":"20240607150753-jyc926g","Type":"NodeParagraph","Properties":{"id":"20240607150753-jyc926g","updated":"20240607150753"},"Children":[{"Type":"NodeText","Data":"气温而浓．味甘且辛．益肾培肝．腰膝虚疼用取治．除寒胜湿．筋皮连续类相求．（杜仲其树一名木绵．杜仲即其皮也．折之有丝不断．色紫独入肝经．味辛甘而温．善祛逐下焦寒湿．邪去则肝得温养．以遂其生发之性．乙癸同源．子实则母不虚．故又能补肾也．须知杜仲祛邪之力有余．补养之功不足耳．）"}]},{"ID":"20240607150753-h4y0odh","Type":"NodeThematicBreak","Properties":{"id":"20240607150753-h4y0odh"}},{"ID":"20240607150734-mqmqdab","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150734-mqmqdab","updated":"20240607150743"},"Children":[{"Type":"NodeText","Data":"杜仲《神农本草经赞》"}]},{"ID":"20240607150734-yp0euob","Type":"NodeParagraph","Properties":{"id":"20240607150734-yp0euob","updated":"20240607150734"},"Children":[{"Type":"NodeText","Data":"味辛平。主腰脊痛。补中益精气。坚筋骨。强志。除阴下痒湿。小便余沥。久服轻身耐老。一名思仙。生山谷。"}]},{"ID":"20240607150734-tz4of60","Type":"NodeParagraph","Properties":{"id":"20240607150734-tz4of60","updated":"20240607150734"},"Children":[{"Type":"NodeText","Data":"杜父仙去。嘉荫翘思。紫封巨植。白折轻丝。足知为屦。牙效烹葵。形兼榆柘。酥蜜相宜。"}]},{"ID":"20240607150734-0qnslwl","Type":"NodeParagraph","Properties":{"id":"20240607150734-0qnslwl","updated":"20240607150734"},"Children":[{"Type":"NodeText","Data":"李时珍曰。昔有杜仲。服此得道。因以名之。晋书传。杜预众庶赖之。号曰杜父。苏轼诗。"}]},{"ID":"20240607150734-nej71cj","Type":"NodeParagraph","Properties":{"id":"20240607150734-nej71cj","updated":"20240607150734"},"Children":[{"Type":"NodeText","Data":"幽人得嘉荫。曹植诗。翘思远退人。令狐楚诗。犹识紫泥封。苏轼诗。不尽长林与巨植。群芳谱。皮色紫而润。陶弘景曰。折之多白丝者佳。孟子。不知足而为屦。苏颂曰。木可为履。益脚。初生嫩叶。可食。谓之牙。叶亦类柘。诗。七月烹葵及菽。尔雅。杜仲曼榆也。"}]},{"ID":"20240607150734-kzjz5fo","Type":"NodeParagraph","Properties":{"id":"20240607150734-kzjz5fo","updated":"20240607150734"},"Children":[{"Type":"NodeText","Data":"雷论。凡使用酥蜜和涂。"}]},{"ID":"20240607150734-qvkpbqg","Type":"NodeThematicBreak","Properties":{"id":"20240607150734-qvkpbqg"}},{"ID":"20240607150716-zgcajtu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150716-zgcajtu","updated":"20240607150721"},"Children":[{"Type":"NodeText","Data":"杜仲《本草害利》"}]},{"ID":"20240607150716-jw7vzja","Type":"NodeParagraph","Properties":{"id":"20240607150716-jw7vzja","updated":"20240607150716"},"Children":[{"Type":"NodeText","Data":"〔害〕肾虽虚，而火炽者不用。"}]},{"ID":"20240607150716-5ygkvzn","Type":"NodeParagraph","Properties":{"id":"20240607150716-5ygkvzn","updated":"20240607150716"},"Children":[{"Type":"NodeText","Data":"〔利〕甘辛温，入肝肾。强筋壮骨，益肾添精，治腰膝疼痛，利遍体机关，亦治阴下湿痒，小便淋沥。"}]},{"ID":"20240607150716-o8q4o2n","Type":"NodeParagraph","Properties":{"id":"20240607150716-o8q4o2n","updated":"20240607150716"},"Children":[{"Type":"NodeText","Data":"〔修治〕二、五、六、九月采皮，凡使削去粗皮锉，或酥炙、酒炙、蜜炙、盐酒炒、姜汁炒、断丝用。产湖广，湖南者佳。色黄，皮薄，肉浓，如色黑、皮浓、肉薄，不堪用。"}]},{"ID":"20240607150309-5b2tw6a","Type":"NodeThematicBreak","Properties":{"id":"20240607150309-5b2tw6a"}},{"ID":"20240607150351-rhz0rde","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150351-rhz0rde","updated":"20240607150357"},"Children":[{"Type":"NodeText","Data":"杜仲《神农本草经读》"}]},{"ID":"20240607150351-929jcat","Type":"NodeParagraph","Properties":{"id":"20240607150351-929jcat","updated":"20240607150351"},"Children":[{"Type":"NodeText","Data":"气味辛、平，无毒。主腰膝痛，补中益精气，坚筋骨，强志，除阴下痒湿，小便余沥。久服轻身耐老。"}]},{"ID":"20240607150351-y73k4t7","Type":"NodeParagraph","Properties":{"id":"20240607150351-y73k4t7","updated":"20240607150351"},"Children":[{"Type":"NodeText","Data":"（参张隐庵）杜仲气味辛平，得金之气味；而其皮黑色而属水，是禀阳明、少阴金水之精气而为用也。腰为肾府，少阴主之；膝属大筋，阳明主之；杜仲禀少阴、阳明之气，故腰膝之痛可治也。补中者，补阳明之中土也；益阴者，益少阴之精气也；坚筋骨者，坚阳明所属之筋，少阴所主之骨也；强志者，肾藏志，肾气得补而壮，气壮而志自强也。阳明燥气下行，故除阴下湿痒，小便余沥也。久服则水金相生，精气充足，故轻身耐老也。"}]},{"ID":"20240607150430-cawy762","Type":"NodeThematicBreak","Properties":{"id":"20240607150430-cawy762"}},{"ID":"20240607150431-22bv7c6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150431-22bv7c6","updated":"20240607150435"},"Children":[{"Type":"NodeText","Data":"杜仲《本草经集注》"}]},{"ID":"20240607150431-ok093i3","Type":"NodeParagraph","Properties":{"id":"20240607150431-ok093i3","updated":"20240607150431"},"Children":[{"Type":"NodeText","Data":"味辛、甘，平、温，无毒。主治腰脊痛，补中，益精气，坚筋骨，强志，除阴下痒湿，小便余沥。脚中酸疼痛，不欲践地。久服轻身，耐老。一名思仙，一名思仲，一名木绵。生上虞山谷又上党及汉中。二月、五月、六月、九月采皮，阴干。（畏蛇蜕皮、玄参。）"}]},{"ID":"20240607150431-xc14sy6","Type":"NodeParagraph","Properties":{"id":"20240607150431-xc14sy6","updated":"20240607150431"},"Children":[{"Type":"NodeText","Data":"上虞在豫州，虞、号之虞，非会稽上虞县也。今用出建平、宜都者，状如浓朴，折之多白》三○五页）"}]},{"ID":"20240607150411-gk4s8nw","Type":"NodeThematicBreak","Properties":{"id":"20240607150411-gk4s8nw"}},{"ID":"20240607150413-8ylol0j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150413-8ylol0j","updated":"20240607150416"},"Children":[{"Type":"NodeText","Data":"杜仲《本草崇原》"}]},{"ID":"20240607150413-z5ichyv","Type":"NodeParagraph","Properties":{"id":"20240607150413-z5ichyv","updated":"20240607150413"},"Children":[{"Type":"NodeText","Data":"气味辛平，无毒。主腰膝痛，补中，盖精气，坚筋骨，强志，除阴下痒湿，小便余沥。久服轻身耐老。"}]},{"ID":"20240607150413-kgmp0rb","Type":"NodeParagraph","Properties":{"id":"20240607150413-kgmp0rb","updated":"20240607150413"},"Children":[{"Type":"NodeText","Data":"（杜仲木皮，状如浓朴，折之有白绵相连，故一名木绵。杜字从土，仲者中也，此木始出豫州山谷，得中土之精，《本经》所以名杜仲也。李时珍曰∶有杜仲，服此得道，因以名之谬矣。在唐宋本草或有之矣，《神农本经》未必然也。）"}]},{"ID":"20240607150413-ju0awg9","Type":"NodeParagraph","Properties":{"id":"20240607150413-ju0awg9","updated":"20240607150413"},"Children":[{"Type":"NodeText","Data":"杜仲皮色黑而味辛平，禀阳明、少阴金水之精气。腰膝痛者，腰乃肾府，少阴主之。膝属大筋，阳明主之。杜仲禀少阴、阳明之气，故腰膝之痛可治也。补中者，补阳明之中土也。益精气者，益少阴肾精之气也。坚筋骨者，坚阳明所属之筋，少阴所主之骨也。强志者，所以补肾也。阳明燥气下行，故除阴下痒湿，小便余沥。久服则金水相生，精气充足，故轻身耐老。"}]},{"ID":"20240607150413-q5ndjao","Type":"NodeParagraph","Properties":{"id":"20240607150413-q5ndjao","updated":"20240607150413"},"Children":[{"Type":"NodeText","Data":"愚按∶桑皮、桑叶有丝，蚕食桑而结茧，其色洁白，其质坚牢，禀金气也。藕与莲梗有丝，"}]},{"ID":"20240607150502-r93ta4k","Type":"NodeThematicBreak","Properties":{"id":"20240607150502-r93ta4k"}},{"ID":"20240607150503-qvzpl4q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150503-qvzpl4q","updated":"20240607150511"},"Children":[{"Type":"NodeText","Data":"杜仲《汤液本草》"}]},{"ID":"20240607150503-a5elp8c","Type":"NodeParagraph","Properties":{"id":"20240607150503-a5elp8c","updated":"20240607150503"},"Children":[{"Type":"NodeText","Data":"味辛、甘，平、温，无毒。阳也，降也。"}]},{"ID":"20240607150503-h20zho6","Type":"NodeParagraph","Properties":{"id":"20240607150503-h20zho6","updated":"20240607150503"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主腰脊痛。补中、益精气，坚筋骨，强志；除阴下湿痒，小便余沥，脚中酸疼，不欲践地。久服，轻身、耐老。恶蛇蜕皮、玄参。"}]},{"ID":"20240607150503-pwcjtdu","Type":"NodeParagraph","Properties":{"id":"20240607150503-pwcjtdu","updated":"20240607150503"},"Children":[{"Type":"NodeText","Data":"《日华子》云∶暖，治肾劳，腰脊挛，入药炙用。"}]},{"ID":"20240607150513-lgmf9dy","Type":"NodeThematicBreak","Properties":{"id":"20240607150513-lgmf9dy"}},{"ID":"20240607150540-crmn9p1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150540-crmn9p1","updated":"20240607150546"},"Children":[{"Type":"NodeText","Data":"杜仲《中药炮制》"}]},{"ID":"20240607150540-5gai5vz","Type":"NodeParagraph","Properties":{"id":"20240607150540-5gai5vz","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『来源』本品为杜仲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杜仲"},{"Type":"NodeText","Data":"的干燥树皮。"}]},{"ID":"20240607150540-9q2afg6","Type":"NodeParagraph","Properties":{"id":"20240607150540-9q2afg6","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『常用名』川杜仲、厚杜仲、棉杜仲、思仲。"}]},{"ID":"20240607150540-0ixm7mi","Type":"NodeParagraph","Properties":{"id":"20240607150540-0ixm7mi","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『产地』四川、云南、贵州、河南、陕西、湖北等地。"}]},{"ID":"20240607150540-kxnlq4m","Type":"NodeParagraph","Properties":{"id":"20240607150540-kxnlq4m","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『采收季节』春夏采挖。"}]},{"ID":"20240607150540-35lwye6","Type":"NodeParagraph","Properties":{"id":"20240607150540-35lwye6","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『炮制方法』放入清水中，用板刷刷去灰尘或泥土刮去粗皮，捞起滤干水份，上盖湿布，润1夜，取出切六分长方块，晒干或烘干。取其入肾则用盐水炒（每斤药用盐10克化水）将药投入锅内，随炒随洒盐水，炒至带黑色断丝为度。"}]},{"ID":"20240607150540-nragqqz","Type":"NodeParagraph","Properties":{"id":"20240607150540-nragqqz","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『用量』9～15克。"}]},{"ID":"20240607150540-wyel8s8","Type":"NodeParagraph","Properties":{"id":"20240607150540-wyel8s8","updated":"20240607150540"},"Children":[{"Type":"NodeText","Data":"『贮存』装木箱内加盖，防潮。"}]},{"ID":"20240607150540-vf8fazu","Type":"NodeThematicBreak","Properties":{"id":"20240607150540-vf8fazu"}},{"ID":"20240607150520-116s7up","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150520-116s7up","updated":"20240607150530"},"Children":[{"Type":"NodeText","Data":"杜仲《本草图经》"}]},{"ID":"20240607150520-ha7kfm6","Type":"NodeParagraph","Properties":{"id":"20240607150520-ha7kfm6","updated":"20240607150526"},"Children":[{"Type":"NodeText","Data":"杜仲，生上虞山谷及上党、汉中。今出商州、成州、峡州近处大山中亦有之。木高数丈，叶如辛夷，亦类柘；其皮类浓朴，折之内有白丝相连。二月、五月、六月、九月采皮用。江南人谓之 。初生叶嫩时，采食，主风毒香港脚，及久积风冷、肠痔、下血。亦宜干末作汤，谓之芽。花、实苦涩，亦堪入药。木作屐，亦主益脚。箧中方主腰痛补肾汤，杜仲一大斤，五味子半大升，二物细切，分十四剂，每夜取一剂，以水一大升，浸至五更，煎三分减一，滤取汁；以羊肾三、四枚，切，下之，再煮三、五沸，如作羹法，空腹顿服。用盐酢和之，亦得，此亦见崔元亮《海上方》。但崔方不用五味子耳。"}]},{"ID":"20240607150352-g4uxm5x","Type":"NodeThematicBreak","Properties":{"id":"20240607150352-g4uxm5x"}},{"ID":"20240607150338-jb6jld8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150338-jb6jld8","updated":"20240607150344"},"Children":[{"Type":"NodeText","Data":"杜仲《新修本草》"}]},{"ID":"20240607150338-bnyvl08","Type":"NodeParagraph","Properties":{"id":"20240607150338-bnyvl08","updated":"20240607150338"},"Children":[{"Type":"NodeText","Data":"味辛、甘，平、温，无毒。主腰脊痛，补中，益精气，坚筋骨，强志，除阴下痒湿，小便余沥。脚中酸疼痛，不欲践地，久服轻身能老。一名思仙，一名思仲，一名木绵。生上虞山谷又上党及汉中。二月、五月、六月、九月采皮，阴干。"}]},{"ID":"20240607150338-t5qaec5","Type":"NodeParagraph","Properties":{"id":"20240607150338-t5qaec5","updated":"20240607150338"},"Children":[{"Type":"NodeText","Data":"畏蛇蜕皮、玄参。上虞在豫州，虞、虢之虞，非会稽上虞县也。今用出建平、宜都者，状如浓朴，折之多白丝为佳。"}]},{"ID":"20240607150338-6tp43ev","Type":"NodeParagraph","Properties":{"id":"20240607150338-6tp43ev","updated":"20240607150338"},"Children":[{"Type":"NodeText","Data":"用之薄削去上甲皮横理，切令丝断也。"}]},{"ID":"20240607150338-w50cw1v","Type":"NodeThematicBreak","Properties":{"id":"20240607150338-w50cw1v"}},{"ID":"20240607150316-t930pig","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150316-t930pig","updated":"20240607150321"},"Children":[{"Type":"NodeText","Data":"杜仲《证类本草》"}]},{"ID":"20240607150316-pgywfmj","Type":"NodeParagraph","Properties":{"id":"20240607150316-pgywfmj","updated":"20240607150316"},"Children":[{"Type":"NodeText","Data":"味辛、甘，平、温，无毒。主腰脊痛，补中益精气，坚筋骨，强志，除阴下痒湿，小便余沥，脚中酸疼不欲践地。久服轻身耐老。一名思仙，一名思仲，一名木绵。生上虞山谷及上党、汉中。二月、五月、六月、九月采皮。（恶蛇蜕皮、玄参。）"}]},{"ID":"20240607150316-tmowrha","Type":"NodeParagraph","Properties":{"id":"20240607150316-tmowrha","updated":"20240607150316"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶上虞在豫州，虞、虢之虞，非会稽上虞县也。今用出建平、宜都者。状如浓朴，折之多白丝为佳。用之，薄削去上皮，横理切令丝断也。臣禹锡等谨按蜀本图经云∶生深山大谷。树高数丈，叶似辛夷。折其皮多白绵者好。今所在大山皆有。药性论云∶杜仲，味苦。能治肾冷 （公对切）腰痛也。腰病患虚而身强直，风也。腰不利，加而用之。日华子云∶暖。治肾劳腰脊挛。入药炙用。"}]},{"ID":"20240607150316-enolyj0","Type":"NodeParagraph","Properties":{"id":"20240607150316-enolyj0","updated":"20240607150316"},"Children":[{"Type":"NodeText","Data":"图经曰∶杜仲，生上虞山谷及上党、汉中，今出商州、成州、峡州近处大山中亦有之。"}]},{"ID":"20240607150316-wwz9ptw","Type":"NodeParagraph","Properties":{"id":"20240607150316-wwz9ptw","updated":"20240607150316"},"Children":[{"Type":"NodeText","Data":"木高数丈，叶如辛夷，亦类柘，其皮类浓朴，折之内有白丝相连。二月、五月、六月、九月采皮用。江南人谓之 。初生叶嫩时采食。主风毒香港脚及久积风冷，肠痔下血亦宜。干末作汤。谓之 芽。花、实苦涩，亦堪入药。木作屐。亦主益脚。《箧中方》主腰痛补肾汤∶杜仲一大斤，五味子半大升，二物切，分十四剂，每夜取一剂，以水一大升，浸至五更，煎三分减一，滤取汁，以羊肾三、四枚切下之，再煮三、五沸，如作羹法。空腹顿服，用盐、酢和之亦得。此亦见崔元亮《海上方》，但崔方不用五味子耳。"}]},{"ID":"20240607150316-yupll7b","Type":"NodeParagraph","Properties":{"id":"20240607150316-yupll7b","updated":"20240607150316"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，先须削去粗皮，用酥蜜和作一两炙之尽为度，炙干了细锉用。凡修事一斤，酥二两，蜜三两，二味相和，令一处用也。圣惠方治卒患腰脚疼痛，补肾。杜仲一两去粗皮，炙微黄锉，以水二大盏，煎至一盏去滓，用羊肾二对，细切去脂膜，入药中煮，次入薤白七茎，盐、花椒、姜、醋等如作羹吃。空腹食之。肘后方腰背痛。杜仲一斤，切，酒二升，渍十日。服三合。胜金方治妇人胎脏不安，并产后诸疾，宜服杜仲丸。瓦上干，于木臼中捣为末，煮枣为丸，如弹子大。每服一丸，烂嚼以糯米饮下。"}]},{"ID":"20240607150252-e5bgo0s","Type":"NodeThematicBreak","Properties":{"id":"20240607150252-e5bgo0s"}},{"ID":"20240607150217-hbxithm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150217-hbxithm","updated":"20240607150222"},"Children":[{"Type":"NodeText","Data":"杜仲《本草纲目》"}]},{"ID":"20240607150217-zsconeg","Type":"NodeParagraph","Properties":{"id":"20240607150217-zsconeg","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"「释名」思仲、思仙、木棉。"}]},{"ID":"20240607150217-qw2vlni","Type":"NodeParagraph","Properties":{"id":"20240607150217-qw2vlni","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"「气味」辛、平、无毒。"}]},{"ID":"20240607150217-wc6eb91","Type":"NodeParagraph","Properties":{"id":"20240607150217-wc6eb91","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240607150217-f7lgsjz","Type":"NodeParagraph","Properties":{"id":"20240607150217-f7lgsjz","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"1、肾虚腰痛。用杜仲去皮，炙黄，取一大斤，分作十剂。每夜用一剂，在水一升中浸至五更，煎成三分之二，去渣留汁，放入羊肾三、四片，煮开几次，加上椒盐作羹，空心一次服下。此方中再加薤白工茎，或五味子半斤亦可。"}]},{"ID":"20240607150217-p19fbyt","Type":"NodeParagraph","Properties":{"id":"20240607150217-p19fbyt","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"2、风冷伤肾，腰背虚痛。用杜仲一斤，切细，炒过，放酒二程序中浸十日。每日服三合。又方：用杜仲研为末，每日清晨以温酒送服二钱。"}]},{"ID":"20240607150217-l7v7ljv","Type":"NodeParagraph","Properties":{"id":"20240607150217-l7v7ljv","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"3、病后虚汗及自流汗。用杜仲、牡蛎，等分为末，卧时以水送服五小匙。不止，再服。"}]},{"ID":"20240607150217-hg9qzoo","Type":"NodeParagraph","Properties":{"id":"20240607150217-hg9qzoo","updated":"20240607150217"},"Children":[{"Type":"NodeText","Data":"4、产后诸疾及胎体不安。有杜仲去皮，瓦上焙干，捣为末，煮枣肉调末为丸，如弹子在。每服一丸，糯米汤送下。一天服二次。"}]},{"ID":"20240504164136-yov81fb","Type":"NodeThematicBreak","Properties":{"id":"20240504164136-yov81fb"}},{"ID":"20240607150158-jfvgakn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150158-jfvgakn","updated":"20240607150208"},"Children":[{"Type":"NodeText","Data":"杜仲《本草经解》"}]},{"ID":"20240607150158-v2qj2gb","Type":"NodeParagraph","Properties":{"id":"20240607150158-v2qj2gb","updated":"20240607150158"},"Children":[{"Type":"NodeText","Data":"气平．味辛．无毒．主腰膝痛．补中益精气．坚筋骨强志．除阴下痒湿．小便余沥．久服轻身耐老．（盐水炒）"}]},{"ID":"20240607150158-81hatz6","Type":"NodeParagraph","Properties":{"id":"20240607150158-81hatz6","updated":"20240607150158"},"Children":[{"Type":"NodeText","Data":"杜仲气平．禀天秋降之金气．味辛无毒．得地润泽之金味．专入手太阴肺经．气味升多于降．阴也．腰者肾之腑．膝者肾所主也．杜仲辛平益肺．肺金生肾水．所以腰膝痛自止也．中者阴之守也．辛平益肺．肺乃津液之化源．所以阴足而补中也．初生之水谓之精．天一之水也．杜仲入肺．肺主气而生水．所以益精气．精气益则肝有血以养筋．肾有髓以填骨．所以筋骨坚也．肺主气．辛平益肺．则气刚大．所以志强．阴下者即篡间．任脉别络也．痒湿者湿也．杜仲辛平润肺．则水道通而湿行也．小便气化乃出．有余沥气不收摄也．杜仲益肺气．气固则能摄精也．久服辛平益气．气充则身轻．辛润滋血．血旺则耐老也．盐水炒则入肾．醋炒则入肝．以类从也．"}]},{"ID":"20240607150158-ub8eo6u","Type":"NodeParagraph","Properties":{"id":"20240607150158-ub8eo6u","updated":"20240607150158"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240607150158-9z13ksy","Type":"NodeParagraph","Properties":{"id":"20240607150158-9z13ksy","updated":"20240607150158"},"Children":[{"Type":"NodeText","Data":"杜仲同续断、砂仁．治胎前杂症．同续断、山药糊丸．治频堕胎．专一味酒炒丸．治腰背痛．"}]},{"ID":"20240617111039-z9h3ybo","Type":"NodeThematicBreak","Properties":{"id":"20240617111039-z9h3ybo"}},{"ID":"20240617111041-clih6ie","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111041-clih6ie","updated":"20240617111045"},"Children":[{"Type":"NodeText","Data":"杜仲《中药学》"}]},{"ID":"20240617111041-a8aj77l","Type":"NodeParagraph","Properties":{"id":"20240617111041-a8aj77l","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为杜仲科植物杜仲的树皮。"}]},{"ID":"20240617111041-er6rl7l","Type":"NodeParagraph","Properties":{"id":"20240617111041-er6rl7l","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，温。入肝、肾经。"}]},{"ID":"20240617111041-yfenb64","Type":"NodeParagraph","Properties":{"id":"20240617111041-yfenb64","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【功效】补肝肾，强筋骨，安胎。"}]},{"ID":"20240617111041-io9b1og","Type":"NodeParagraph","Properties":{"id":"20240617111041-io9b1og","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于肝肾不足，腰膝瘦痛，乏力，眩晕，阳痿，小便频数等症。"}]},{"ID":"20240617111041-sgfdt17","Type":"NodeParagraph","Properties":{"id":"20240617111041-sgfdt17","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"肝主筋，肾主骨，肾充则骨强，肝充则筋健。杜仲可补肝肾，故有强筋骨的功效，常用于肝肾不足、腰膝酸痛乏力等症，在临床应用时，可视症情需要，或与续断、狗脊等配伍，或与补骨脂、胡桃等同用。本品性偏温补，宜于下元虚冷之症，故又可用治肾虚阳痿、小便频数，常与补骨脂、菟丝子等配伍。至于用治肝肾不足所致的眩晕，宜合滋养肝肾的药品如女贞子等同用。"}]},{"ID":"20240617111041-509tapm","Type":"NodeParagraph","Properties":{"id":"20240617111041-509tapm","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"2.用于孕妇体虚，胎元不固，腰酸、胎动。"}]},{"ID":"20240617111041-8g2v39z","Type":"NodeParagraph","Properties":{"id":"20240617111041-8g2v39z","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"本品用以安胎，如孕妇胎动不安兼有肝肾不足病症者，可与桑寄生、白朮、续断等配伍同用。"}]},{"ID":"20240617111041-lxnzojo","Type":"NodeParagraph","Properties":{"id":"20240617111041-lxnzojo","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【处方用名】杜仲、厚杜仲、绵杜仲（洗净，晒干，切片用）。炙杜仲、炒杜仲、焦杜仲（用盐水炒至微焦，取它补肾作用较好）。"}]},{"ID":"20240617111041-83jgozk","Type":"NodeParagraph","Properties":{"id":"20240617111041-83jgozk","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。]"}]},{"ID":"20240617111041-dcgj7d9","Type":"NodeParagraph","Properties":{"id":"20240617111041-dcgj7d9","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【按语】1.杜仲能补肝肾而强筋骨，在临床上主要用于肾虚腰部酸痛，这是它的特长。至于它又可用于胎动不安，也是由于肝肾不足、冲任不固所致。"}]},{"ID":"20240617111041-vw327zc","Type":"NodeParagraph","Properties":{"id":"20240617111041-vw327zc","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"2.据近代研究，本品又有降血压作用，这是它在临床应用上新的发展。"}]},{"ID":"20240617111041-a48mmga","Type":"NodeParagraph","Properties":{"id":"20240617111041-a48mmga","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【方剂举例】杜仲丸《证治准绳》：杜仲、续断。治妊娠胎动，腰痛欲堕。"}]},{"ID":"20240617111041-sarvjyf","Type":"NodeParagraph","Properties":{"id":"20240617111041-sarvjyf","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"金刚丸《活法机要》：杜仲、苁蓉、菟丝子、萆薢、猪腰。治筋骨痿软。"}]},{"ID":"20240617111041-snwnscs","Type":"NodeParagraph","Properties":{"id":"20240617111041-snwnscs","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主腰脊痛，补中，益精气，坚筋骨，强志，除阴下痒湿，小便余沥。」"}]},{"ID":"20240617111041-pxjagbv","Type":"NodeParagraph","Properties":{"id":"20240617111041-pxjagbv","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"《别录》：「治脚中疫疼，不欲践地。」"}]},{"ID":"20240617111041-r3u58nk","Type":"NodeParagraph","Properties":{"id":"20240617111041-r3u58nk","updated":"20240617111041"},"Children":[{"Type":"NodeText","Data":"《药性本草》：「治肾冷，肾腰痛；人虚而身强直，风也，腰不利，加而用之。"}]},{"ID":"20240607150115-8eok5zt","Type":"NodeThematicBreak","Properties":{"id":"20240607150115-8eok5zt"}},{"ID":"20240607150117-0n9yufv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150117-0n9yufv","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"《中国药典》：杜仲"}]},{"ID":"20240607150117-aj9ai4r","Type":"NodeParagraph","Properties":{"id":"20240607150117-aj9ai4r","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607150117-a7g1syq","Type":"NodeParagraph","Properties":{"id":"20240607150117-a7g1syq","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" Dù Zhònɡ"}]},{"ID":"20240607150117-5o1mnya","Type":"NodeParagraph","Properties":{"id":"20240607150117-5o1mnya","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607150117-dg2wi6m","Type":"NodeParagraph","Properties":{"id":"20240607150117-dg2wi6m","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 扯丝皮、思仲、丝棉皮、玉丝皮"}]},{"ID":"20240607150117-hmiha76","Type":"NodeParagraph","Properties":{"id":"20240607150117-hmiha76","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607150117-r45stvm","Type":"NodeParagraph","Properties":{"id":"20240607150117-r45stvm","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" CORTEX EUCOMMIAE"}]},{"ID":"20240607150117-e1gynoo","Type":"NodeParagraph","Properties":{"id":"20240607150117-e1gynoo","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607150117-09cuc5n","Type":"NodeParagraph","Properties":{"id":"20240607150117-09cuc5n","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 本品为杜仲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杜仲"},{"Type":"NodeText","Data":"Eucommia ulmoides Oliv. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"。4～6月剥取，刮去粗皮，堆置“发汗”至内皮呈紫褐色，晒干。"}]},{"ID":"20240607150117-54qwbxo","Type":"NodeParagraph","Properties":{"id":"20240607150117-54qwbxo","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607150117-oss9oi2","Type":"NodeParagraph","Properties":{"id":"20240607150117-oss9oi2","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 本品呈板片状或两边稍向内卷，大小不一，厚3～7mm。外表面淡棕色或灰褐色，有明显的皱纹或纵裂槽纹；有的树皮较薄，未去粗皮，可见明显的皮孔；内表面暗紫色，光滑。质脆，易折断，断面有细密、银白色、富弹性的橡胶丝相连。气微，味稍苦。"}]},{"ID":"20240607150117-9zlmn92","Type":"NodeParagraph","Properties":{"id":"20240607150117-9zlmn92","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607150117-6it3fc8","Type":"NodeParagraph","Properties":{"id":"20240607150117-6it3fc8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240607150117-4pvifon","Type":"NodeParagraph","Properties":{"id":"20240607150117-4pvifon","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607150117-4ssgycx","Type":"NodeParagraph","Properties":{"id":"20240607150117-4ssgycx","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杜仲"},{"Type":"NodeText","Data":"：刮去残留粗皮，洗净，切块或丝，干燥。"}]},{"ID":"20240607150117-1y2ge3a","Type":"NodeParagraph","Properties":{"id":"20240607150117-1y2ge3a","updated":"20240607150117"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"盐杜仲"},{"Type":"NodeText","Data":"：取杜仲块或丝，照盐水炙法（附录Ⅱ D）炒至断丝、表面焦黑色（每100斤加盐3斤用开水化开）。本品为块或丝。表面呈焦黑色，折断时橡胶丝弹性较差。味微咸。"}]},{"ID":"20240607150117-37wur8h","Type":"NodeParagraph","Properties":{"id":"20240607150117-37wur8h","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607150117-86w4zao","Type":"NodeParagraph","Properties":{"id":"20240607150117-86w4zao","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末棕色。橡胶丝成条或扭曲成团，表面呈颗粒性。石细胞甚多，大多成群，类长方形、类圆形、长条形或形状不规则，长约至180μm，直径20～80μm,壁厚，有的胞腔内含橡胶团块。木栓细胞表面观多角形，直径15～40μm,壁不均匀增厚，木化，有细小纹孔；侧面观长方形，壁三面增厚，一面薄，孔沟明显。"}]},{"ID":"20240607150117-kcx1ttg","Type":"NodeParagraph","Properties":{"id":"20240607150117-kcx1ttg","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末1g，加氯仿10ml，浸渍2 小时，滤过。滤液挥干，加乙醇1ml,产生具弹性的胶膜。"}]},{"ID":"20240607150117-7amr2x2","Type":"NodeParagraph","Properties":{"id":"20240607150117-7amr2x2","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607150117-goe8wrd","Type":"NodeParagraph","Properties":{"id":"20240607150117-goe8wrd","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 归肝、肾经。"}]},{"ID":"20240607150117-15oqprp","Type":"NodeParagraph","Properties":{"id":"20240607150117-15oqprp","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607150117-nzxxvxh","Type":"NodeParagraph","Properties":{"id":"20240607150117-nzxxvxh","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 甘，温。"}]},{"ID":"20240607150117-5sa9mxx","Type":"NodeParagraph","Properties":{"id":"20240607150117-5sa9mxx","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607150117-trkwjva","Type":"NodeParagraph","Properties":{"id":"20240607150117-trkwjva","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强筋骨，安胎。用于肾虚腰痛，筋骨无力，妊娠漏血，胎动不安；高血压。"}]},{"ID":"20240607150117-adtvx5w","Type":"NodeParagraph","Properties":{"id":"20240607150117-adtvx5w","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607150117-da3g9dq","Type":"NodeParagraph","Properties":{"id":"20240607150117-da3g9dq","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 6～9g。"}]},{"ID":"20240607150117-9se2hdd","Type":"NodeParagraph","Properties":{"id":"20240607150117-9se2hdd","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607150117-122v51p","Type":"NodeParagraph","Properties":{"id":"20240607150117-122v51p","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607150117-r49ofpv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150117-r49ofpv","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：杜仲"}]},{"ID":"20240607150117-efkb6ri","Type":"NodeParagraph","Properties":{"id":"20240607150117-efkb6ri","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607150117-f5483um","Type":"NodeParagraph","Properties":{"id":"20240607150117-f5483um","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" Dù Zhònɡ"}]},{"ID":"20240607150117-pzwsnmp","Type":"NodeParagraph","Properties":{"id":"20240607150117-pzwsnmp","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607150117-i4u5km1","Type":"NodeParagraph","Properties":{"id":"20240607150117-i4u5km1","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 思仙（《本经》），木绵、思仲（《别录》），檰（《本草图经》），石思仙（《本草衍义补遗》），丝连皮、丝楝树皮（《中药志》），扯丝皮（《湖南药物志》），丝棉皮（苏医《中草药手册》）。"}]},{"ID":"20240607150117-6epy84s","Type":"NodeParagraph","Properties":{"id":"20240607150117-6epy84s","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607150117-a02rxri","Type":"NodeParagraph","Properties":{"id":"20240607150117-a02rxri","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607150117-vct8a3d","Type":"NodeParagraph","Properties":{"id":"20240607150117-vct8a3d","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607150117-dylve45","Type":"NodeParagraph","Properties":{"id":"20240607150117-dylve45","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 为杜仲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"杜仲"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"。为了保护资源，一般采用局部剥皮法。在清明至夏至间，选取生长15～20年以上的植株，按药材规格大小，剥下树皮，刨去粗皮，晒干。置通风干燥处。"}]},{"ID":"20240607150117-w34g0il","Type":"NodeParagraph","Properties":{"id":"20240607150117-w34g0il","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607150117-iamixay","Type":"NodeParagraph","Properties":{"id":"20240607150117-iamixay","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 生于山地林中或栽培。分布长江中游及南部各省，河南、陕西，甘肃等地均有栽培。主产于四川、陕西、湖北、河南、贵州、云南。此外，江西、甘肃、湖南、广西等地亦产。"}]},{"ID":"20240607150117-qlkxjhc","Type":"NodeParagraph","Properties":{"id":"20240607150117-qlkxjhc","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607150117-k07such","Type":"NodeParagraph","Properties":{"id":"20240607150117-k07such","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 落叶乔木，高达20米。小枝光滑，黄褐色或较淡，具片状髓。皮、枝及叶均含胶质。单叶互生；椭圆形或卵形，长7～15厘米，宽3.5～6.5厘米，先端渐尖，基部广楔形，边缘有锯齿，幼叶上面疏被柔毛，下面毛较密，老叶上面光滑，下面叶脉处疏被毛；叶柄长1～2厘米。花单性，雌雄异株，与叶同时开放，或先叶开放，生于一年生枝基部苞片的腋内，有花柄；无花被；雄花有雄蕊6～10枚；雌花有一裸露而延长的子房，子房1室，顶端有2叉状花柱。翅果卵状长椭圆形而扁，先端下凹，内有种子1粒。花期4～5月。果期9月。"}]},{"ID":"20240607150117-gf3n1as","Type":"NodeParagraph","Properties":{"id":"20240607150117-gf3n1as","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607150117-4x4xs47","Type":"NodeParagraph","Properties":{"id":"20240607150117-4x4xs47","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 干燥树皮，为平坦的板片状或卷片状，大小厚薄不一，一般厚约3～10毫米，长约40～100厘米。外表面灰棕色，粗糙，有不规则纵裂槽纹及斜方形横裂皮孔，有时可见淡灰色地衣斑。但商品多已削去部分糙皮，故外表面淡棕色，较平滑。内表面光滑，暗紫色。质脆易折断，断面有银白色丝状物相连，细密，略有伸缩性。气微，味稍苦，嚼之有胶状残余物。以皮厚而大，糙皮刮净，外面黄棕色，内面黑褐色而光，折断时白丝多者为佳。皮薄、断面丝少或皮厚带粗皮者质次。"}]},{"ID":"20240607150117-eo3ff0j","Type":"NodeParagraph","Properties":{"id":"20240607150117-eo3ff0j","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607150117-zmkopv8","Type":"NodeParagraph","Properties":{"id":"20240607150117-zmkopv8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 树皮含杜仲胶6～10％，根皮约含10～12％，为易溶于乙醇，难溶于水的硬性树胶。此外，还含糖甙0.142毫克％、生物碱0.066毫克％、果胶6.5毫克％、脂肪2.9毫克％、树脂1.76毫克％、有机酸0.25毫克％、酮糖（水解前2.15毫克％、水解后3.5毫克％）、维生素C20.7毫克％、醛糖、绿原酸。"}]},{"ID":"20240607150117-qdyfqkj","Type":"NodeParagraph","Properties":{"id":"20240607150117-qdyfqkj","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"种子所含脂肪油的脂肪酸组成为亚麻酸67.38％、亚油酸9.97％、油酸15.81％、硬脂酸2.15％.棕榈酸4.68％。果实含胶量可达27％，易溶于乙醇、丙酮等有机溶剂。"}]},{"ID":"20240607150117-hqwqr47","Type":"NodeParagraph","Properties":{"id":"20240607150117-hqwqr47","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607150117-xwnn18p","Type":"NodeParagraph","Properties":{"id":"20240607150117-xwnn18p","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" ①降压作用"}]},{"ID":"20240607150117-9o0s645","Type":"NodeParagraph","Properties":{"id":"20240607150117-9o0s645","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"树皮的提取物及煎剂对动物有持久的降压作用。用其浸膏5毫升（生药1～2克）给麻醉犬静脉注射后产生显着的降压作用，可持续2～3小时，呈\"快速耐受\"现象。在3只肾型高血压狗，每天以煎剂5～8克／公斤灌胃，共4周，收缩压降低最多时只有8～22毫米汞柱（4～10％），因此疗效不够满意。杜仲的炮制与剂型对降压作用有一定影响，煎剂作用强于酊剂，炒杜仲的降压作用较生杜仲为大。杜仲对猫有降压作用，但持续较短，\"快速耐受\"现象不显着。对胆甾醇动脉硬化家兔之降压作用较对正常家兔更为显著，但亦能产生\"快速耐受\"。至于降压原理，因尚未确定有效成分，故属于初步性质，已证明急性降压与迷走神经无大关系，亦不受阿托品之影响。对离体兔心，杜仲小量时先兴奋，后略呈抑制；也有报告其对心脏的抑制作用与其pH有关（pH在4～5之间），经调整后，对大鼠与家兔离体心脏皆呈兴奋作用。杜仲对正常兔耳血管有直接扩张作用，但同样浓度却使实验性胆甾醇动脉硬化兔耳血管呈收缩作用，对正常家兔的冠状血管与肾血管在低浓度时多呈扩张作用，高浓度时则相反，对动脉硬化家兔的冠状血管在低浓度时亦呈收缩作用。因其降压与心及血管的直接关系不大，故推论其为中枢性者。"}]},{"ID":"20240607150117-pkoq3hk","Type":"NodeParagraph","Properties":{"id":"20240607150117-pkoq3hk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②利尿作用"}]},{"ID":"20240607150117-iex8cov","Type":"NodeParagraph","Properties":{"id":"20240607150117-iex8cov","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"杜仲的各种制剂对麻醉犬均有利尿作用，且无\"快速耐受\"现象。对正常大鼠、小鼠亦有利尿作用。杜仲中含钾0.4％，故推论利尿可能与钾有关。"}]},{"ID":"20240607150117-55w7mne","Type":"NodeParagraph","Properties":{"id":"20240607150117-55w7mne","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240607150117-qx0h4ue","Type":"NodeParagraph","Properties":{"id":"20240607150117-qx0h4ue","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"临床使用杜仲浸剂，能使高血压患者血压有所降低，并改善头晕、失眠等症状，大剂量（20～25克／公斤/日）杜仲煎剂给狗灌胃，能使其安静、贪睡，不易接受外界刺激。大剂量对小鼠亦有抑制中枢神经系统的作用，杜仲对大鼠和兔的离体子宫，均能抑制脑垂体后叶所引起的兴奋作用，而使子宫松弛，但对猫的离体子宫反呈兴奋作用。曾有人报告杜仲煎剂在试管中对结核杆菌有某些抑制作用。其醇浸剂似能减少大鼠肠道中胆甾醇的吸收。"}]},{"ID":"20240607150117-xaq5b66","Type":"NodeParagraph","Properties":{"id":"20240607150117-xaq5b66","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607150117-lqehjpv","Type":"NodeParagraph","Properties":{"id":"20240607150117-lqehjpv","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 杜仲：除去粗皮，洗净，润透，切成方块或丝条，晒干。盐杜仲：先用食盐加适量开水溶化，取杜仲块或丝条，使与盐水充分拌透吸收，然后置锅内，用文火炒至微有焦斑为度，取出晾干。（每杜仲100斤，用食盐3斤）杜仲经炒制后，则杜仲胶被破坏，有效成分易于煎出。"}]},{"ID":"20240607150117-t5vm4qn","Type":"NodeParagraph","Properties":{"id":"20240607150117-t5vm4qn","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使杜仲，先须削去粗皮。用酥、蜜炙之。凡修事一斤，酥二两，蜜三两，二味相和令一处用。\""}]},{"ID":"20240607150117-eryi8su","Type":"NodeParagraph","Properties":{"id":"20240607150117-eryi8su","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②《本草述钩元》：\"杜仲，用酒炒断丝。\""}]},{"ID":"20240607150117-b596mjx","Type":"NodeParagraph","Properties":{"id":"20240607150117-b596mjx","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607150117-9vptout","Type":"NodeParagraph","Properties":{"id":"20240607150117-9vptout","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 入肝、肾经。"}]},{"ID":"20240607150117-d0t6tsw","Type":"NodeParagraph","Properties":{"id":"20240607150117-d0t6tsw","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"①王好古：\"肝经气分。\""}]},{"ID":"20240607150117-yxyr4qq","Type":"NodeParagraph","Properties":{"id":"20240607150117-yxyr4qq","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肾经。\""}]},{"ID":"20240607150117-os3469o","Type":"NodeParagraph","Properties":{"id":"20240607150117-os3469o","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入手太阴肺经。\""}]},{"ID":"20240607150117-s5asljg","Type":"NodeParagraph","Properties":{"id":"20240607150117-s5asljg","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607150117-lg64qql","Type":"NodeParagraph","Properties":{"id":"20240607150117-lg64qql","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 甘微辛，温。"}]},{"ID":"20240607150117-7njpkz4","Type":"NodeParagraph","Properties":{"id":"20240607150117-7njpkz4","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240607150117-pqti02p","Type":"NodeParagraph","Properties":{"id":"20240607150117-pqti02p","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，温，无毒。\""}]},{"ID":"20240607150117-4i0tor4","Type":"NodeParagraph","Properties":{"id":"20240607150117-4i0tor4","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦。\""}]},{"ID":"20240607150117-kaw9zqm","Type":"NodeParagraph","Properties":{"id":"20240607150117-kaw9zqm","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607150117-73b8wio","Type":"NodeParagraph","Properties":{"id":"20240607150117-73b8wio","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 阴虚火旺者慎服。"}]},{"ID":"20240607150117-mha4yo3","Type":"NodeParagraph","Properties":{"id":"20240607150117-mha4yo3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶蛇皮、元参。\""}]},{"ID":"20240607150117-julpkb2","Type":"NodeParagraph","Properties":{"id":"20240607150117-julpkb2","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"肾虚火炽者不宜用。即用当与黄柏、知母同入。\""}]},{"ID":"20240607150117-7skzqkz","Type":"NodeParagraph","Properties":{"id":"20240607150117-7skzqkz","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"内热。精血燥二者禁用。\""}]},{"ID":"20240607150117-qhds3tz","Type":"NodeParagraph","Properties":{"id":"20240607150117-qhds3tz","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607150117-8bp1uxo","Type":"NodeParagraph","Properties":{"id":"20240607150117-8bp1uxo","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 补肝肾，强筋骨，安胎。治腰脊酸疼，足膝痿弱，小便余沥，阴下湿痒，胎漏欲堕，胎动不安，高血压。"}]},{"ID":"20240607150117-lh9zjn9","Type":"NodeParagraph","Properties":{"id":"20240607150117-lh9zjn9","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主腰脊痛，补中益精气，坚筋骨，强志，除阴下痒湿，小便余沥。\""}]},{"ID":"20240607150117-ge6wb3j","Type":"NodeParagraph","Properties":{"id":"20240607150117-ge6wb3j","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主脚中酸痛，不欲践地。\""}]},{"ID":"20240607150117-vg7ynng","Type":"NodeParagraph","Properties":{"id":"20240607150117-vg7ynng","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治肾冷臀腰痛，腰病人虚而身强直，风也。腰不利加而用之。\""}]},{"ID":"20240607150117-gzhtflj","Type":"NodeParagraph","Properties":{"id":"20240607150117-gzhtflj","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治肾劳，腰脊挛。入药炙用。\""}]},{"ID":"20240607150117-gboujo0","Type":"NodeParagraph","Properties":{"id":"20240607150117-gboujo0","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑤王好古：\"润肝燥，补肝经风虚。\""}]},{"ID":"20240607150117-g8as2ge","Type":"NodeParagraph","Properties":{"id":"20240607150117-g8as2ge","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑥《本草正》：\"止小水梦遗，暖子宫，安胎气。\""}]},{"ID":"20240607150117-qcys1rg","Type":"NodeParagraph","Properties":{"id":"20240607150117-qcys1rg","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑦《玉楸药解》：\"益肝肾，养筋骨，去关节湿淫。治腰膝酸痛，腿足拘挛。\""}]},{"ID":"20240607150117-sk0bgem","Type":"NodeParagraph","Properties":{"id":"20240607150117-sk0bgem","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑧《本草再新》：\"充筋力，强阳道。\""}]},{"ID":"20240607150117-9eqe8ao","Type":"NodeParagraph","Properties":{"id":"20240607150117-9eqe8ao","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607150117-4rtjnj3","Type":"NodeParagraph","Properties":{"id":"20240607150117-4rtjnj3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；浸酒或入丸、散。"}]},{"ID":"20240607150117-ra8yl8i","Type":"NodeParagraph","Properties":{"id":"20240607150117-ra8yl8i","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607150117-qrvgpbk","Type":"NodeParagraph","Properties":{"id":"20240607150117-qrvgpbk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" ①治腰痛：杜仲一斤，五味子半升。二物切，分十四剂，每夜取一剂，以水一升，浸至五更，煎三分减一，滤取汁，以羊肾三、四枚，切下之，再煮三、五沸，如作羹法，空服顿服。用盐、醋和之亦得。（《箧中方》）"}]},{"ID":"20240607150117-c18t2py","Type":"NodeParagraph","Properties":{"id":"20240607150117-c18t2py","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②治腰痛：川木香一钱，八角茴香三钱，杜仲（炒去丝）三钱。水一钟，酒半钟，煎服，渣再煎。（《活人心统》思仙散）"}]},{"ID":"20240607150117-opon3k2","Type":"NodeParagraph","Properties":{"id":"20240607150117-opon3k2","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"③治卒腰痛不可忍：杜仲二两（去粗皮，炙微黄，锉），丹参二两，芎藭一两半，桂心一两，细辛三分。上药捣粗罗为散，每服四钱，以水一中盏，煎至五分，去滓，次入酒二分，更煎三、两沸，每于食前温服。（《圣惠方》杜仲散）"}]},{"ID":"20240607150117-crmeksz","Type":"NodeParagraph","Properties":{"id":"20240607150117-crmeksz","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"④治中风筋脉挛急，腰膝无力：杜仲（去粗皮，炙，锉）一两半，芎藭一两，附子（炮裂，去皮。脐）半两；上三味，锉如麻豆，每服五钱匕，水二盏，入生姜一枣大，拍碎，煎至一盏，去滓，空心温服。如人行五里再服，汗出慎外风。（《圣济总录》杜仲饮）"}]},{"ID":"20240607150117-qqrcd7h","Type":"NodeParagraph","Properties":{"id":"20240607150117-qqrcd7h","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑤治小便余沥，阴下湿痒：川杜仲四两，小茴香二两（俱盐、酒浸炒），车前子一两五钱，山茱萸肉三两（俱炒）。共为末；炼蜜丸，梧桐子大。每早服五钱，白汤下。（《本草汇言》）"}]},{"ID":"20240607150117-x7ljzaq","Type":"NodeParagraph","Properties":{"id":"20240607150117-x7ljzaq","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑥治妇人胞胎不安：杜仲不计多少，去粗皮细锉，瓦上焙干，捣罗为末，煮枣肉糊丸，如弹子大，每服一丸，嚼烂，糯米汤下。（《圣济总录》杜仲丸）"}]},{"ID":"20240607150117-f40vhr8","Type":"NodeParagraph","Properties":{"id":"20240607150117-f40vhr8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑦治频惯堕胎或三、四月即堕者：于两月前，以杜仲八两（糯米煎汤，浸透，炒去丝），续断二两（酒浸，焙干；为末），以山药五，六两为末，作糊丸，梧子大。每服五十丸，空心米饮下。（《简便单方》）"}]},{"ID":"20240607150117-t9a6nbd","Type":"NodeParagraph","Properties":{"id":"20240607150117-t9a6nbd","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"⑧治高血压：㈠杜仲、夏枯草各五钱，红牛膝三钱，水芹菜三两，鱼鳅串一两。煨水服，一日三次。（《贵州草药》）㈡杜仲、黄芩、夏枯草各五钱。水煎服。（《陕西中草药》）"}]},{"ID":"20240607150117-8f8wygu","Type":"NodeParagraph","Properties":{"id":"20240607150117-8f8wygu","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607150117-wpdiy1x","Type":"NodeParagraph","Properties":{"id":"20240607150117-wpdiy1x","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" ①治疗高血压病"}]},{"ID":"20240607150117-vdzmnmt","Type":"NodeParagraph","Properties":{"id":"20240607150117-vdzmnmt","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"以10％杜仲酊每次30滴，日服3次。共治119例，经1～23个月的观察，疗效满意者51例（42.8％），平均治疗9.1个月；稍进步者15例（12.6％）；无效者53例（44.6％）。未发现不良反应。另有以5％杜仲酊每次5毫升，日服3次，治疗124例，对早期高血压病的疗效较好，在治疗1个半月内有4例血压降至正常；对重症高血压则不能遏制其发展。有人认为杜仲对自觉症状的改善较其它药物显着。曾用杜仲、利血平、利血平合并肼苯哒嗪三组进行疗效对照，结果降压效果以杜仲最差，有效率为50％，其它两组分别为90％、95％；但自觉症状的减轻则以杜仲为最佳，占82.5％，其它两组分别为65.1％：61.3％。实验观察证明，炒杜仲的降压作用比生杜仲的降压作用大，醇浸液比水煎液的降压作用小。"}]},{"ID":"20240607150117-94ovuz3","Type":"NodeParagraph","Properties":{"id":"20240607150117-94ovuz3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"②治疗小儿麻痹后遗症"}]},{"ID":"20240607150117-lnitxqi","Type":"NodeParagraph","Properties":{"id":"20240607150117-lnitxqi","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"用杜仲1.5两，猪脚1只；加水适量，文火熬4小时，取药汁每日2次分服；次日将药渣另加猪脚1只再行煎服，隔日1剂，共服10剂。治疗1例病史二年的患儿，用过中、西医及新医疗法均无效，经用上方，同时进行肌肉按摩及功能训练，1周后，肌力开始有进步，可独立行走30米；2周后能独立行走200米，步态较稳，肌力显著进步；第3周已能独立行走600米，步态稳健有力。"}]},{"ID":"20240607150117-xuf8s2r","Type":"NodeParagraph","Properties":{"id":"20240607150117-xuf8s2r","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607150117-zl4lyko","Type":"NodeParagraph","Properties":{"id":"20240607150117-zl4lyko","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607150117-6e8maht","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607150117-6e8maht","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"《中华本草》：杜仲"}]},{"ID":"20240607150117-0cv21su","Type":"NodeParagraph","Properties":{"id":"20240607150117-0cv21su","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607150117-714jx4y","Type":"NodeParagraph","Properties":{"id":"20240607150117-714jx4y","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" Dù Zhònɡ"}]},{"ID":"20240607150117-ayoqfq6","Type":"NodeParagraph","Properties":{"id":"20240607150117-ayoqfq6","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607150117-dys1nfp","Type":"NodeParagraph","Properties":{"id":"20240607150117-dys1nfp","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 思仙、思仲、木绵、檰、石思仙、扯丝皮、丝连皮、玉丝皮、丝棉皮"}]},{"ID":"20240607150117-xf8xxxz","Type":"NodeParagraph","Properties":{"id":"20240607150117-xf8xxxz","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607150117-poj7ixi","Type":"NodeParagraph","Properties":{"id":"20240607150117-poj7ixi","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607150117-lkrqscd","Type":"NodeParagraph","Properties":{"id":"20240607150117-lkrqscd","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"《本草图经》：杜仲，江南人谓之檰，初生叶嫩时采食，谓之檰芽。花实苦涩，亦堪入药；木作屐，亦主益脚。"}]},{"ID":"20240607150117-95v7m02","Type":"NodeParagraph","Properties":{"id":"20240607150117-95v7m02","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607150117-0tddouk","Type":"NodeParagraph","Properties":{"id":"20240607150117-0tddouk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 药材基源：为杜仲科植物杜仲的树皮。"}]},{"ID":"20240607150117-yv9l6kj","Type":"NodeParagraph","Properties":{"id":"20240607150117-yv9l6kj","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Eucommia ulmoides Oliv."}]},{"ID":"20240607150117-9ig3pdg","Type":"NodeParagraph","Properties":{"id":"20240607150117-9ig3pdg","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽培10～20年，用半环剥法剥取树皮。6～7月高温湿润季节，此时杜仲树形成层细胞分裂比较旺盛，在离地面10cm以上树干，切树干的一半或三分之一，注意割至韧皮部时不伤形成层，然后剥取树皮。经2～3年后树皮重新长成。环剥法，用芽接刀在树干分技处的下方，绕树干环切一刀，再在离地面10cm处再环切一刀，再垂直向下纵切一刀，只切断韧皮部，不伤木质部，然后剥取树皮。剥皮直选多云或阴天，不宜在雨天及炎热的晴天进行。加工：剥下树皮用开水烫泡，将皮展平，把树皮内面相对叠平，压紧，四周上、下用稻草包住，使其发汗，经1星期后，内皮略成紫褐色，取出，晒干，刮去粗皮，修切整齐，贮藏。"}]},{"ID":"20240607150117-ihpkqcn","Type":"NodeParagraph","Properties":{"id":"20240607150117-ihpkqcn","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607150117-pphj2e1","Type":"NodeParagraph","Properties":{"id":"20240607150117-pphj2e1","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔300-500m的低山、谷地或疏林中。"}]},{"ID":"20240607150117-8z2n61d","Type":"NodeParagraph","Properties":{"id":"20240607150117-8z2n61d","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于陕西、甘肃、浙江、河南、湖北、四川、贵州、云南等地。"}]},{"ID":"20240607150117-uvcd981","Type":"NodeParagraph","Properties":{"id":"20240607150117-uvcd981","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607150117-r0ero6f","Type":"NodeParagraph","Properties":{"id":"20240607150117-r0ero6f","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 落叶乔木，高达20m。树皮灰褐色，粗糙，折断拉开有多数细丝。幼枝有黄褐色毛，后变无毛，老枝有皮孔。单叶互生；叶柄长1-2cm，上面有槽，被散生长毛；叶片椭圆形、卵形或长圆形，长6-15cm，宽3.5-6.5cm，先端渐尖，基部圆形或阔楔形，上面暗绿色，下面淡绿，老叶略有皱纹，边缘有锯齿；侧脉6-9对。花单性，雌雄异株，花生于当年枝基部，雄花无花被，花梗无毛；雄蕊长约1cm，无毛，无退化雌蕊；雌花单生，花梗长约8mm，子房1室，先端2裂，子房柄极短。翅果扁平，长椭圆形，先端2裂，基部楔形，周围具薄翅；坚果位于中央，与果梗相接处有关节。早春开花，秋后果实成熟。"}]},{"ID":"20240607150117-qayvv4q","Type":"NodeParagraph","Properties":{"id":"20240607150117-qayvv4q","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607150117-jro4ho8","Type":"NodeParagraph","Properties":{"id":"20240607150117-jro4ho8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候，耐寒性较强。自然分布区年平均温度13-17℃，年降水量500-1500mm。以阳光充足，土层深厚肥沃、富含腐殖质的砂质壤土、粘质壤土栽培为宜。"}]},{"ID":"20240607150117-a88l9ol","Type":"NodeParagraph","Properties":{"id":"20240607150117-a88l9ol","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、扦插、压条、分蘖、嫁接繁殖。以种子繁殖为主。从杜仲树皮的形态特征可分为粗皮杜仲（青冈皮）与光皮杜仲（白杨皮）两种类型，栽培以光皮杜仲为优。种子繁殖：选20-40年生的生长发育健壮、树皮光滑、无病虫害和未剥过树皮的植株，9-10月果实成熟后采摘，晾干，扬净，切忌曝晒。尤以有光泽、饱满、新鲜、色呈淡褐色者为优。种子寿命短，不宜用陈种。千粒重57-130g。播种期为冬播（11-12月）或春播（2-3月），以冬播为宜。春播因种子外皮含胶质，干燥后会影响发芽，播前将种子在20-25℃温水中浸泡2-3d，每日换水1次，待种子膨胀后再湿砂拌匀，每隔2-3d，每日换水1次，待种子膨胀后再用湿砂拌匀，每隔2-3d翻动1次，约经15d左右种子即可萌动。每1hm/2用种量75-150kg.播种方法用条播法，按行距20-30cm开条沟，沟深4cm，将种子均匀播入沟内，覆土1-1.5cm，稍加镇压，烧水，覆盖草，以防霜冻。出苗后，幼苗5-7cm时，选阴天时行第1次间苗，苗高15-20cm时进行第2次间苗或定苗。苗期适量灌水，保持土壤湿润，7-8月生长旺盛时，加强施肥，全年施肥6-8次，有机肥和无机肥交替施用。培育1-2年移植。穴栽，行、株距各2.5m×3m.扦插繁殖：剪取一年生嫩枝，剪成5-6cm长的插穗，5月初按行、株距 20cm X 10cm开穴扦插，插入土中三分之二，留三分之一于地面，扦插后搭棚遮荫，保持土壤湿润，待生根后第2年移栽。亦可用50 X10－6萘乙酸处理24h，可提高插条成活率。压条繁殖：用普通压条或高空压条。普通压条在早春（l～2月）植株未萌动前，将母株近根部的健壮枝条，压人土中20cm左右，使枝梢露出地面，1年后即可生根成苗，与母体分离后栽种。高空压条，3～4月或6～7月，选2～3年生，直径1cm粗的枝条，割伤后用塑料薄膜或对半开竹筒盛装肥土，包裹于枝条割伤部位，经常检查湿度，生根后与母株分离栽种。分蘖繁殖，用砍树后的技桩培土，促进萌生新芽，初冬劈开分株栽种。嫁接繁殖：取二年生苗作砧木，选优良品种的一年生枝条作接穗，用切接法于早春进行嫁接。"}]},{"ID":"20240607150117-8pzlzet","Type":"NodeParagraph","Properties":{"id":"20240607150117-8pzlzet","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有立枯病，4月下旬至6月中旬病苗近茎基部腐烂变褐，收缩腐烂，倒伏干枯。防治方法，实行轮作和注意田间排除积水，发病时拔除病株，并用50％多菌灵1000倍液浇灌。叶枯病，为害叶片，出现褐色病斑或破裂穿孔，发病期间，可喷50 ％多菌灵1000倍液。另有根腐病为害。虫害有六星黑点木蠢蛾、褐蓑蛾、黄刺蛾、扁刺蛾。在杜仲剥皮后再生新皮时遭受相夜蛾、樱桃双斜带卷叶蛾、黑色甲虫为害。可用5o％西维因可湿性粉剂1：400倍液或50％西维因1：50倍液，加入一定量牛胶（约0．5％）涂剧在新皮上、下两端的树干上，形成两个“保护圈”，可防虫害袭击。其他还有蚜虫等为害"}]},{"ID":"20240607150117-2vewgwq","Type":"NodeParagraph","Properties":{"id":"20240607150117-2vewgwq","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607150117-o69s7nr","Type":"NodeParagraph","Properties":{"id":"20240607150117-o69s7nr","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 树皮呈扁平的板块状、卷筒状，或两边稍向内卷的块片，大小不一，厚2-7mm。外表面淡灰棕色或灰褐色，平坦或粗糙，有明显的纵皱纹或不规则的纵裂槽纹，未刮去粗皮者有斜方形、横裂皮孔，有时并可见淡灰色地衣斑。内表面暗紫褐色或红褐色，光滑。质脆，易折断，折断面粗糙，有细密银白色并富弹性的橡胶丝相连。气微，味稍苦，嚼之有胶状残余物。"}]},{"ID":"20240607150117-jvsshuc","Type":"NodeParagraph","Properties":{"id":"20240607150117-jvsshuc","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"以皮厚而大、粗色刮净、内表面色暗紫、断面银白色橡胶丝多者为佳。"}]},{"ID":"20240607150117-kelogj1","Type":"NodeParagraph","Properties":{"id":"20240607150117-kelogj1","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"显微鉴别 树皮横切面：老树皮有较厚的落皮层，韧皮部极厚，有5-7条断续的石细胞环带，每一环带为3-55列石细胞，并偶伴有少数纤维，近石细胞环带处尚可见橡胶质团块。纵切面观，此种橡胶质存在于粉末特征：棕色。①石细胞众多，大多成群，类长方形、类圆形、长条形或不规则形，直径20-80μm，长约180μm，壁厚，孔沟明显，有的胞腔中含有胶丝团块。②木栓细胞成群或单个散在，表面观多角，直径15-40μm，壁不均匀增厚，木化，有明显的细小纹孔；侧面观长方形，壁-面薄，三面增厚、孔沟明显。③橡胶丝成条或扭曲成团，表面观颗粒性。"}]},{"ID":"20240607150117-oabt6lq","Type":"NodeParagraph","Properties":{"id":"20240607150117-oabt6lq","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"④淀粉粒极少，类球形，直径3-8μm。"}]},{"ID":"20240607150117-ysyu5vt","Type":"NodeParagraph","Properties":{"id":"20240607150117-ysyu5vt","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"理化鉴别（1）取本品粉末1g，加氯仿10ml，浸渍2h，滤过，滤液挥干，加乙醇10ml，产生具弹性的胶膜。"}]},{"ID":"20240607150117-ap7w8zk","Type":"NodeParagraph","Properties":{"id":"20240607150117-ap7w8zk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"（2）本品在紫外光灯下，外表面显暗紫褐色荧光，内表面显黄棕色荧光，断面显紫色荧光。"}]},{"ID":"20240607150117-kkysw24","Type":"NodeParagraph","Properties":{"id":"20240607150117-kkysw24","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"（3）取杜仲粉末2g，加蒸馏水20ml，在50-60℃水浴上加热1h，滤过。滤液滴在滤纸上，喷以三氯化铁一铁氰化钾试液，显蓝色斑点（酚酸反应）。"}]},{"ID":"20240607150117-8v3ucvk","Type":"NodeParagraph","Properties":{"id":"20240607150117-8v3ucvk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"（4）取杜仲粉末2g加乙醇20ml，在水浴上回流30min后滤过。滤液滴在滤纸上，喷以20％氢氧化钠溶液，显浅黄色斑点。（红杜仲显紫色斑点，丝棉木不显色）品质标志 《中华人民共和国药典》1995年版规定：本品用热浸法测定，75％乙醇浸出物不得少于11．0 ％。"}]},{"ID":"20240607150117-8a61rx1","Type":"NodeParagraph","Properties":{"id":"20240607150117-8a61rx1","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607150117-j4ps27h","Type":"NodeParagraph","Properties":{"id":"20240607150117-j4ps27h","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 杜仲煎剂15-25g／kg给兔灌胃，仅有轻度抑制，并无中毒症状。小鼠连服同样剂量共5天，亦未见死亡。给小鼠静脉注射的LD50为574.1±1.0g(原生药)／kg。小鼠腹腔注射600g(原生药)／kgl次，动物出现伏卧、安静，2小时后恢复正常活动，有时出现歪扭反应，观察7天未出现死亡。小鼠腹腔注射500g(原生药)／kg，每天1次，连续6次，动物未出现死亡。对于豚鼠，腹腔注射10-15g/kg后，3-5天内半数动物死亡。亚急性试验，杜仲煎剂对大鼠、豚鼠、兔及犬的肾组织有轻度的水肿变性，对心、肝以及脾的组织无病变。"}]},{"ID":"20240607150117-ckpmn3b","Type":"NodeParagraph","Properties":{"id":"20240607150117-ckpmn3b","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607150117-ymasvpk","Type":"NodeParagraph","Properties":{"id":"20240607150117-ymasvpk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 树皮含多种木脂素及其甙类成分：右旋丁香树脂酚（syringaresinol）[1]，右旋了香树脂酚葡萄糖甙（sy－ringaresinol-O-β-D-glucopyranoside)[2],丁香丙三醇-β-丁香树脂酚醚4”，4″′-双葡萄糖甙（syringylglycerol-β-syringaresinol ether 4″，4″′-di-O-β-D-glucopyranoseid］;右旋松脂酚（pinnoresinol），右旋表松脂酚（epipinoresinol)[1],右旋松脂酚葡萄糖甙（pinoresinol-O-β-D-glucopyranoside）,右旋松脂酚双葡萄糖甙（pinoresinol-di-O-β-D-glucopyranoside）,右旋1-羟基松脂酚(l－hydroxypinore-sinol)[1]，右旋 1一羟基松脂酚-4′-葡萄糖甙（1－hydroxypinol－4′-O-β-D-glucopyranoside），右旋1-羟基松脂酚-4”-葡萄糖甙（1-hydroxypinoresinol-4″-O-β-D-glucopyranside］，右旋1-羟基松脂酚-4′， 4″-双葡萄糖甙（ l－hydroxypinoresinol- 4’，4″－di－O-β-D-glu-copyranoside）[2],二氢去氢二松柏醇(dihydrodehydrodiconiferylalcohol)，苏式二羟基去氢二松柏醇(threo-dihydroxydehydro di－coniferyl alcohol），赤式二羟基去氢二松柏醇（erytho-dihydroxy-dehyrodiconiferyl alcohol）[1]，去氢二松柏醇-4，r′-二葡萄糖甙（dehydrodiconiferyl alcohol-4，r′-di-O-β-D-glucopyranoside）[3]，左旋橄榄树脂素（olivil），左旋橄榄树脂素-4′-葡萄糖甙（olivil-4′-O-β-D-glucopyranoside），左旋橄榄树脂素-4″-葡萄糖甙（olivil-4″-O-β-D-glucopyranoside）[6]，左旋橄榄树脂素-4′，4″-双葡萄糖甙（olivil-4′，4″-di-O-β-D-glucopyranoside）[2]，右旋环橄榄树脂素（cycloolivil）[5]，右旋杜仲树脂酚（medioresinol）[1]，杜仲素（eu-commin）A就是右旋杜仲树脂酚一4′-葡萄糖甙（medioresinol－4－O-β-D-glucopyranoside)，右旋杜仲树脂酚双葡萄糖甙（medioresinol－di－O-β-D-glucopyranoside）[4];耳草脂醇C－4”，4”-双葡萄糖甙（hedyotol C-4″，4″-di-O-β-D-glucopyranoside）[6],鹅掌楸甙（liriodendrn）[4],柑属甙B（citrusin B）[3].还含多种环烯醚萜类成分：桃叶珊瑚甙（aucubin）[2]，杜仲甙（ulmoside）即是桃叶珊瑚甙元-1-β-异麦芽糖甙（aucubigenin－1-β-isomaltosde）[7],都桷子素（ genipin）[1]，都桷子甙（geniposide），都桷子甙酸（ geniposidicacid）[6]，筋骨草甙（ajugoside），哈帕甙乙酸酯（harpagide acetate），匍匐筋骨草甙（reptoside）[8]，杜仲醇（eucommiol），杜仲醇甙I（eucommioside I)[6]等。又含酚性成分：消旋的苏式 1－(4-愈创木酚基）甘油（threo－guaiacylglycerol），消旋的赤式l－(4-愈创木酚基）甘油（erythro-guaiacyl glycerol］[5]，赤式1-(4一愈创木酚基）甘油-β-松柏醛醚（erythro-guaiacyl glycerol－β-coniferyl aldehydeether），苏式1－（4-愈创木酚基）甘油-β-松柏醛醚（threo-guaiacylglycerol-β-coniferylaldehyde ether），咖啡酸（caffeic acid），绿原酸（chlorogenic acid），绿原酸甲酯（methyl chlorogenate）[1]，香草酸(vanillic acid)[9]。三萜成分：白桦脂醇（betulin），白桦脂酸（be－tulic acid），熊果酸（ursolic acid），β-谷甾醇（β-sitosterol），胡萝卜甙（dancosterol),[9]以及包括苯丙氨酸（phenylalanine）、赖氨酸（ly－sine）、色氨酸（tryptophan）、蛋氨酸（methionine）、苏氨酸（threo－nine）、缬氨酸（valine）、亮氨酸（leucine）、异亮氨酸（isoleucine）、谷氨酸（glutamic acid）、胱氨酸（cystine）、组氨酸（histidine）在内的 17种游离氨基酸和锗、硒等15种微量元素[10]。另含杜仲烯醇（ulmoprenol）[11]，山柰酚（kaempferol），酒石酸（tartaric acid），半乳糖醇(galactitol）[2]，正三十烷醇（n－triacontanol），正二十九烷（n－nonacosane）[9]。树皮还含杜仲胶，其结构与马来乳胶即固塔波橡胶（guttapercha）相同，为反式异戊二烯聚合物，属硬橡胶类，含量约22. 5％［12］."}]},{"ID":"20240607150117-pr60il7","Type":"NodeParagraph","Properties":{"id":"20240607150117-pr60il7","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607150117-030pqet","Type":"NodeParagraph","Properties":{"id":"20240607150117-030pqet","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 1.中枢镇静作用 取18-22g小白鼠，雌雄不拘，随机分成3组，顺次放入与药理生理多用仪相连的测试盒内，记录鼠活动次数。给药前先测试5分钟的活动次数，然后分别以杜仲皮、叶煎剂及生理盐水灌胃，于1、2、3h测试5分钟内活动次数，并与给药前比较：杜仲皮煎剂15g／kg、杜仲叶煎20g／kg灌胃后，在3个不同测试时间内，小白鼠活动次数均显着减少(P＜0.01)；生理盐水0.1ml／kg灌胃，小白鼠活动次数无明显减少(P＞0.05)，见表3。"}]},{"ID":"20240607150117-g3b08zm","Type":"NodeParagraph","Properties":{"id":"20240607150117-g3b08zm","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.对免疫功能的影响：。"}]},{"ID":"20240607150117-18y2uy3","Type":"NodeParagraph","Properties":{"id":"20240607150117-18y2uy3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.1.对细胞免疫功能的影响：。"}]},{"ID":"20240607150117-2jge2hc","Type":"NodeParagraph","Properties":{"id":"20240607150117-2jge2hc","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.1.1.对DNCB(2，4-二硝基氯苯)所致小鼠迟发型超敏反应的影响：昆明种小鼠，体重18-22g，分成六组，每组25只，药物组灌胃杜仲液(10ml／kg／d)共10次，对照组分别灌胃去离子水和间日皮下注射环磷酰胺(30mg／kg／d)共3次。空白和药物组在给药第3天，环磷酰胺组在给药后第2天皮下注射7%DNCB丙酮溶液(0.02ml／只)致敏，间隔2天同剂量再致敏1次，于第一次致敏后第10天，用1%DNCB丙酮液0.02ml，涂布左耳攻击，右耳作对照，24小时后处死动物，煎取两耳称重，以两耳重量之差值进行统计处理。两次结果一致。表明灌胃杜仲皮、叶、枝、再生皮均能抑制DNCB所致小鼠的迟发型超敏反应。"}]},{"ID":"20240607150117-w2jnf5u","Type":"NodeParagraph","Properties":{"id":"20240607150117-w2jnf5u","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.1.2.对小鼠外周血液中T细胞百分比的影响：动物分组，每组10只，药物组分别按10ml／kg体重灌胃药物，对照组给以同体积去离子水，连续8次，于末次给药后lh鼠尾取血涂片，孵育、染色、镜检，每只动物血片标本均查100个淋巴细胞，计算T和B淋巴细胞的百分比。结果杜仲对正常小鼠T淋巴细胞百分比均未见有影响。用同样方法，除空白组外，其余各组小鼠在给药的同时均皮下注射氢化可的松40mg／kg，测定药物并用氢化可的松对外周血中T细胞百分比的影响。由于氢化可的松抑制细胞免疫，使T细胞百分比与空白组比较明显降低(P＜0.001)，但服用黄芪和杜仲各组的T细胞百分比与正常组比较均无明显差别(P＞0.05)，而与氢化可的松组比较侧均有非常显着的差异(P＜0.001)，表明杜仲同黄芪一样，能对抗氢化可的松免疫抑制作用，具有调节细胞免疫平衡的功能。动物分组，每组10只，除空白组外，各组动物均分别在前腋下移植民S180细胞悬液(l：3)0.2ml，4天后开始灌胃药液(20ml／kg.d)，连续8天，空白和带瘤对照组灌胃同体积去离子水，于末次给药后lh，取血同前法制作血片，镜检。荷瘤动物的细胞免疫水平比正常动物低下，两者T细胞百分比有显着差别(P＜0.05)，而服用杜仲各组的荷瘤动物的T细胞百分比明显回升，与正常动物组比较无显着差异(P＞0.05)，与未服药的荷瘤动物组比较则有显着差别(P＜0.05)，重复一次实验，结果一致，表明杜仲叶、皮、枝、再生皮均有增强荷瘤小鼠细胞免疫功能的作用。但药物各组的肿瘤重量与带瘤对照组比较未见明显差别(P＞0.05)。"}]},{"ID":"20240607150117-xnwex3a","Type":"NodeParagraph","Properties":{"id":"20240607150117-xnwex3a","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.对体液免疫功能的影响：。"}]},{"ID":"20240607150117-s9dyiot","Type":"NodeParagraph","Properties":{"id":"20240607150117-s9dyiot","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.1.对小鼠血清溶血素形成的影响小鼠依窝别、性别、体重均分于各组，连续给杜仲水煎剂10ml／kg／d灌胃8天后，眼眶取血测定HC50，结果空白组、药物组的HC50分别为179.91，162.24，两组间无显着差别(P＞0.05)，环磷酰胺组于致敏当天一次肌肉注射(20mg／kg体重)的HC50为96.43，非常显着的抑制正常小鼠血清溶血素的形成。以环磷酰胺20mg／kg体重于致敏的前一天、同天和间隔l天共3次颈部皮下注射造成小鼠溶血素形成低下。上述小鼠给予杜仲水煎剂10ml／(kg.d)10天，取血测定HC50。结果空白组、环磷酰胺对照组和药物组的HC50分别为242.83、34.04和29.460表明杜仲对环磷酰胺所致血清溶血素形成低下小鼠无明显影响(P＞0.05)。"}]},{"ID":"20240607150117-vbjm9v3","Type":"NodeParagraph","Properties":{"id":"20240607150117-vbjm9v3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.2.2.对天花粉所致小鼠速发型超敏反应的影响以天花粉0.1mg／每鼠和0.2mg／每鼠间日颈部皮下注射致敏共2次。于致敏前一天开始给小鼠灌胃杜仲水煎剂10ml/kg，每天1次，连续5天后改为间日给药1次，共给药10次。另以天花粉50mg／每鼠(溶于5%氢氧化铝液内)一次腹腔注射致敏，并同时按上法给药，共给药9次。实验于致敏后第15天每鼠静脉注射天花粉0.3mg攻击，记录动物死亡数。结果杜仲对天花粉可致小鼠速发型超敏反应均未见明显影响(P＞0.05)。"}]},{"ID":"20240607150117-hn7znh0","Type":"NodeParagraph","Properties":{"id":"20240607150117-hn7znh0","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.2.3.对蛋清所致豚鼠过敏性休克的影响：按邓文龙方法，给药方法同上述天花粉实验不加致敏后第15天进行攻击。结果杜仲对蛋清所致豚鼠过敏性休克无保护作用(P＞0.05)。"}]},{"ID":"20240607150117-wbl6kdk","Type":"NodeParagraph","Properties":{"id":"20240607150117-wbl6kdk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.3.对非特异性免疫功能的影响：。"}]},{"ID":"20240607150117-58yr21p","Type":"NodeParagraph","Properties":{"id":"20240607150117-58yr21p","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.3.1.对小鼠血中炭末廊清率的影响小白鼠100只，体重25-28g，雌雄并用。均分为药物组和对照组。药物组按6g／kg，每天口服杜仲水煎剂1次，连续6天。对照组分别口服同容积常水和党参一黄芪煎剂(各3g／kg)。于末次给药后24小时，各组小鼠分别由尾静脉注射印度墨汁0.2ml，注射后2分钟和20分钟分别从眶静脉取血25ul，吸洗至0.1%Na2CO2，2ml溶液中，摇匀，用72型分光光度计测定650mm的光密度，按公式计算吞噬指数K，K=(logC1-logC2)/(T2-T1)，式中C1为2分钟(T1)血样的光密度，C2为20分钟(T2)血样的光密度。K值与小鼠网状内皮系统吞噬功能成正比。可见杜仲皮、叶、枝、再生皮及党参-黄芪组的吞噬指数增大，与常水组比较相差显着，P＜0.05或0.001，表明它们能激活单核巨噬细胞系统的吞噬活血，提高小鼠网状内皮系统的吞噬功能。"}]},{"ID":"20240607150117-kgbou00","Type":"NodeParagraph","Properties":{"id":"20240607150117-kgbou00","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.3.2.对小鼠腹腔巨噬细胞吞噬功能的影响：小白鼠129只，分两批进行试验。药物组按12g／kg，每天口服杜仲水煎剂1次，连续6天，对照组分别口服同容积生理盐水和党参-黄芪煎剂(各6g／kg)，各组于给药6天后分别腹腔注射鲜牛肉汤1ml／只，24小时后再腹腔注射2%鸡红细胞生理盐水悬浮液0.5ml，40分钟后处死动物，取腹腔炎性渗出物涂片，瑞氏染色，镜检，计算吞噬百分率和吞噬指数(两批实验结果一致，合并计算)。杜仲皮、叶、枝、再生皮的吞噬百分率和吞噬指数显着增大，表明杜仲具有增强小鼠腹腔巨噬细胞吞噬功能的作用。小鼠168只，分两批实验，方法同前，只是从第3天给药起，除空白组外，各组小鼠每天分别再肌肉注射氢化可的松20mg／kg，连续给药3天。两批实验结果一致，并计算见表9。可见由于氢化可的松的抑制巨噬细胞对抗原的处理和摄取，使氢化可的松组的吞噬百分率和吞噬指数非常显着减少、而杜仲皮、叶、枝和再生皮组的吞噬百分率和吞噬指数比生理盐水+氢化可的松组非常显着增高。而且其值比空白生理盐水组还大。表明杜仲能调整机体的免疫功能，对抗氢化可的松的免疫抑制作用。动物分组、每组10只，除空白组外，各组动物均分别右前腋下移植S180细胞悬液(l：3)0.2ml，并分别开始口服杜仲水煎剂(12ml／kg／d)，连续12次，对照组灌服同体积去离子水，于末次给药后24小时按上法测定腹腔噬细胞的吞噬百分率和吞噬指数。荷瘤小鼠腹腔巨噬细胞功能与正常动物组比较明显降低，其吞噬百分率和吞噬指数显着减少(P＜0.01)。但服用杜仲的荷瘤小鼠无论是吞噬百分率和吞噬指数与带瘤对照组比较，均明显升高(P＜0.001或0.01)，并使之恢复到正常水平，表明杜仲皮、叶、枝、再生皮有增强荷瘤小鼠腹腔巨噬细胞吞噬功能的作用。"}]},{"ID":"20240607150117-e26n2e0","Type":"NodeParagraph","Properties":{"id":"20240607150117-e26n2e0","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.对垂体-肾上腺皮质系统功能的影响：。"}]},{"ID":"20240607150117-a3qt3sw","Type":"NodeParagraph","Properties":{"id":"20240607150117-a3qt3sw","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.1.对大鼠蛋白性足肿胀的影响：大鼠60只，体重115-170g，按体重和性别均分为药物组和对照组。药物组按6g／kg／d，口服给予醇沉杜仲水煎液，连续给药8天，对照组予生理盐水。用容积法测量鼠足肿胀值；结果致炎3小时后，服用杜仲皮、叶、再生皮组的鼠足肿胀值减小，与对照组比较，相差显着(P＜0.05)，但杜仲枝的作用则不明显(P＜0.05)。"}]},{"ID":"20240607150117-yt1accp","Type":"NodeParagraph","Properties":{"id":"20240607150117-yt1accp","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.2.对大鼠外周血液中嗜酸性粒细胞的影响：大鼠96只，体重为50-80g，按体重和性别均匀分组。药物组按6g／kg／d，分别口服给予杜仲皮、叶、枝、再生皮水煎剂，连续给药6天，另用口服同体积生理盐水，并于实验前4小时肌注醋酸可的松50mg／kg作对照。用直接计数法测定大鼠外周血中嗜酸性粒细胞数，分别与各自给药前测定2天的平均正常值比较，计算嗜酸性粒细胞降低百分率。可见杜仲皮、叶、枝、再生皮和醋酸可的松一样能使大鼠外周血液中嗜酸性粒细胞减少。另用95只摘除肾上腺大鼠，同上服药后，杜仲各组大鼠的外周血液中嗜酸性粒细胞未见减少，鼠生存期亦未见有延长。两相比较说明杜仲的作用依赖于肾上腺的存在。"}]},{"ID":"20240607150117-mdxzhba","Type":"NodeParagraph","Properties":{"id":"20240607150117-mdxzhba","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.3.对小鼠外周血液中淋巴细胞的影响：小鼠170只。体重18-22g，均匀分组，分二批进行实验，按10g／kg／d口服给予杜仲皮、叶、枝、再生皮水煎剂，连续给药5天，另用口服生理盐水和肌注氢化可的松(20mg/kg)组作对照，鼠尾部取血涂片，记录每100个白细胞中的淋巴细胞数。两批实验结果一致，合并计算。可见杜仲皮、叶、枝、再生皮均可使小鼠血中淋巴细胞百分率降低，与生理盐水组比较相差非常显着(P＜0.001)，与氢化可的松组比较相差则不显着(P＜0.05)，表明杜仲(皮、叶、枝和再生皮)和氢化可的松一样均具有使小鼠血中淋巴细胞减少的作用。"}]},{"ID":"20240607150117-rdgalsk","Type":"NodeParagraph","Properties":{"id":"20240607150117-rdgalsk","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.4.对糖代谢的影响：。"}]},{"ID":"20240607150117-penci9a","Type":"NodeParagraph","Properties":{"id":"20240607150117-penci9a","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.4.1.对小鼠肝糖元的影响雄性小鼠122只，体重25-30g，均匀分组，分2批进行实验，药物组按10g／kg给予杜仲皮、叶、枝、再生皮水煎剂，连续给药8次，另用口服常水和肌注氢化可的松40mg／kg(末两天注射)组作对照。实验各组小鼠停食14小时后，每鼠口服葡萄糖(10g/kg)，3小时后处死动物，取肝脏测定肝糖元。两批实验结果趋势一致，合并计算，可见，杜仲皮、叶、枝、再生皮和氢化可的松一样均使小鼠肝糖元含量增高，与常用组比较，相差非常显着(P＜0.001)。表明杜仲有促进肝糖元堆积的作用。"}]},{"ID":"20240607150117-fzw4hcu","Type":"NodeParagraph","Properties":{"id":"20240607150117-fzw4hcu","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.4.2.对小鼠血糖的影响小鼠130只，体重25-27g，均匀分组。分二批进行实验，药物按10g／kg次，每日口服给药2次，连续给药9次。另用口服常水和肌肉注射氢化可的松30mg／kg(实验前2小时注射)组作对照，实验前24小时各组动物禁食，于末次给药后2小时取血浆测定血糖，两批实验趋势一致，合并计算。可见杜仲皮、叶、枝、再生皮和氢化可的松一样均使小鼠血糖含量增高。与常水组比较相差非常显着(P＜0.01或0.001)。表明杜仲皮、叶、枝、再生皮均有使血糖增高的作用。"}]},{"ID":"20240607150117-xahamlv","Type":"NodeParagraph","Properties":{"id":"20240607150117-xahamlv","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.5.对幼年小鼠胸腺的影响：仿AC-TH生物检定法，将体重8-l1g断乳的幼年小鼠，按窝别和体重，随机分组。药物分10g／(kg.d)和20g／(kg.d)两个剂量进行实验，皮下注射给药，连续给药5天。另用皮下注射同体积生理盐水和ACTH0.5单位／只鼠(末3次每天注射1次)作对照，将鼠处死，称重，取胸腺准确称量(I0.5mg)，计算每100g体重的胸腺重量(mg)的平方根值。可见在剂量为10g／kg时，杜仲皮和ACTH组的小鼠胸腺萎缩，与生理盐水组比较相差显着(P＜0.05)，而枝叶则不明显(P＞0.05)；但当剂量增加为20g／kg，杜仲皮、叶、枝、再生皮，均使小鼠胸腺显着萎缩(P＜0.01或0.001)，表明杜仲与ACTH同样具有使小鼠胸腺萎缩的作用。但枝、叶剂量要大。"}]},{"ID":"20240607150117-tfhf2j3","Type":"NodeParagraph","Properties":{"id":"20240607150117-tfhf2j3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.6.对大鼠肾上腺中维生素C含量的影响：体重60-90g的雄性大鼠37只，均匀分组，药理组按10g／(kg·d)口服给药，连续给药8天。另用口服生理盐水组作对照。动物断头处死，取肾上腺测定其中维生素C含量。实验结果杜仲皮、叶、枝组大鼠肾上腺中维生素C含量与生理盐水组比较，虽有降低，但无显着差异(P＞0.05)。"}]},{"ID":"20240607150117-6km95ta","Type":"NodeParagraph","Properties":{"id":"20240607150117-6km95ta","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.7.对大鼠血浆皮质醇的影响:大鼠69只，均匀分组。药物组按10g／kg，每日口服给药2次，连续给药8天。另用口服常水和肌肉注射醋酸可的松(实验前4小时肌注50mg／kg)和皮下注射ACTH组(实验前3小时皮下注射2单位／100g)对照。于末次给药后1小时将鼠断头处死，收集血液，离心取血浆测定皮质醇含量。可见杜仲皮、叶、枝、再生皮和ACTH一样，能使大鼠血浆皮质醇含量增加，与常水组比较，差异非常显着(P＜0.01或(0.001)。表明杜仲使皮质醇分泌增加，并释放入血液中。"}]},{"ID":"20240607150117-bmf6a17","Type":"NodeParagraph","Properties":{"id":"20240607150117-bmf6a17","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"4.抗肿瘤作用：制备红杜仲的水提醇沉液A及注射液B，按照筛选规程对此两制剂进行体内抗肿瘤试验。制剂A对小鼠S180实体瘤的生长有明显抑制，经3次实验重复有效，抑制率31-52%。对小鼠U14实体瘤的生长也有抑制作用。制剂B对民S180实体瘤的作用不稳定，三次实验仅一次抑制率为45%，制剂B为制剂A除去鞣质后所得制剂，因此可推测制剂A的抗肿瘤作用可能为鞣质或与明胶一起结合或沉淀的物质所致。"}]},{"ID":"20240607150117-0epvel8","Type":"NodeParagraph","Properties":{"id":"20240607150117-0epvel8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"5.抗炎作用：给大鼠灌胃或皮下注射红杜仲注射液400g(原生药)／kg后，能减轻蛋清所致的足肿胀。皮下注射给药作用强于灌胃给药。在前2小时的作用比25mg／kg的氢化考的松的作用强，以后作用相当，均能维持6小时以上。皮下注射200g(原生药)／kg红社仲注射液也能抑制醋酸所致小鼠腹腔毛细血管通透性增高，腹腔冲洗液的光密度为0.116±0.055，与对照组0.212±0.047相比显着为低(P＜0.01)。"}]},{"ID":"20240607150117-r7s55tv","Type":"NodeParagraph","Properties":{"id":"20240607150117-r7s55tv","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"6.降压作用：实验动物兔(2.5-3.2kg)7只，狗(15kg)2只，雌雄兼用。动物麻醉后，按常规方法分离颈总动脉及气管并插管，联接于水银检压计，用JL-3三道生理记录仪记录其血压及呼吸。以100%生杜仲、炒杜仲和砂烫杜仲的水煎剂分别由颈静脉给药，剂量为1ml／kg。3种杜仲水煎剂对家兔和狗都有明显的降压作用，但生杜仲降压作用较弱，炒杜仲炭和砂烫杜仲的作用几乎完全相同，其降压的绝对值数相当于生杜仲的两倍。"}]},{"ID":"20240607150117-x3ezbne","Type":"NodeParagraph","Properties":{"id":"20240607150117-x3ezbne","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"7.对子宫的抑制作用：将150-220g的雌性大白鼠猛击头部致死后，立即取出子宫分叉处外的一段，洗去血液，悬挂于YSD-离体器官测定仪上、营养液为洛氏液，调节恒温至31℃±0.2℃，通入空气，在10ml营养液中加入100%杜仲水煎液0.5ml，保证给药、记录时间的一致性，记录3种不同杜仲样品对子宫的影响和对抗垂体后叶素的作用。结果见表20，可见3种杜仲均能显着抑制大白鼠离体子宫的自发活动，降低其频率。同时，还可见到其收缩强度降低。另外，3种杜仲均能对抗垂体后叶素对离体子宫的作用。另盐炙杜仲对中孕小白鼠离体子宫自主收缩的抑制作用增强。"}]},{"ID":"20240607150117-owz56tb","Type":"NodeParagraph","Properties":{"id":"20240607150117-owz56tb","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"8.强壮作用：。"}]},{"ID":"20240607150117-fhu2qvz","Type":"NodeParagraph","Properties":{"id":"20240607150117-fhu2qvz","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"8.1.对动物活动能力的影响：取体重22±2g的小白鼠，雌雄不拘，随机分成给药组和对照组，按小白鼠游泳法进行抗疲劳试验。实验时，置小白鼠于水温28℃±1℃、容积为64×34×40cm的游泳槽内，测试鼠沉入水面下7秒所需时间。结果自饮组：7天组(n=22)和14天组(n=18)，自饮100%杜仲皮和150%杜仲叶煎剂，并与对照组比较，游泳时间差异无显着意义(P＞0.05)。给药组：21天组给予杜仲皮煎剂15g／kg，杜仲叶煎剂20g／kg灌胃，并与常水对照组相比，皮煎剂组差异有显着意义(P＜0.05)，叶煎剂组差异无显着性意义(P＞0.05)。"}]},{"ID":"20240607150117-x2fi2q6","Type":"NodeParagraph","Properties":{"id":"20240607150117-x2fi2q6","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"8.2.对动物抵抗能力的影响：。"}]},{"ID":"20240607150117-waglg8r","Type":"NodeParagraph","Properties":{"id":"20240607150117-waglg8r","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"8.2.1.小白鼠抗冻实验:取体重22±2g的小白鼠，雌雄不拘，随机分成给药组和对照组，实验前禁食10小时，分别给以杜仲皮、叶煎剂及叶冲剂，以常水对照，按性别将体重相近的小白鼠，每2只置于同一铁笼中，放入-3℃的冰箱中，测试动物生存时间(X±SD)。结果：自饮30天：10%杜仲皮煎剂组小白鼠生存时间为242.0±74.0分钟(n=14)；10%杜仲叶煎剂组为249.0±59.0分钟(n=20)；常水对照组为175.0±58分钟(n=17)。用药组和对照组之间有显着差异(P＜0.01)。自饮28天，20%杜仲叶冲剂组生存时间为261.0±41.0分钟(n=7)，常水对照组为174.0±53分钟(n=14)，两组差异有显着意义(P＜0.05)。"}]},{"ID":"20240607150117-tco9wi8","Type":"NodeParagraph","Properties":{"id":"20240607150117-tco9wi8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"8.2.2.小白鼠耐缺氧实验小白鼠分别给予杜仲皮煎剂和杜仲时冲剂，以生理盐水或常水对照，受试鼠以只为单位，放入容量为250ml的广口瓶内，瓶口涂凡士林密封，测试动物在瓶内的成活时间(X±SD)。结果：100%杜仲皮煎剂10g／kg灌胃组，小白鼠成活时间为46.0±12.0分钟(n＝7)，生理盐水0.1ml／kg组为32.0±12.0分钟(n=9)，两组差异有显着意义(P＜0.05)；20%杜仲叶冲剂自饮28天组，小白鼠成活时间为34.0±6.0分钟(n=7)，常水对照组为27.0±5.0分钟(n＝11)，两组差异有显着意义(P＜0.05)。"}]},{"ID":"20240607150117-q8z3sfn","Type":"NodeParagraph","Properties":{"id":"20240607150117-q8z3sfn","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"9.对血浆cAMP和cGMP含量的影响：昆明种小鼠，按窝别、性别和体重，每2只为1对，均分对照组和实验组，每给10对。按10ml／kg体重灌胃杜仲醇沉水煎液，对照组予等量去离子水，每天组药1次，连续5天，于末次给药后1h，断头取血，以每一对2只动物血样合为1个样本，用放射免疫法测定血浆中cAMP和cGMP含量、结果对照组cAMP含量为70.88±4.53(X±SE下同)，杜仲皮组cAMP含量为100.39±15.45(P＜0.05)；cGMP含量，对照组为54.50±16.42，杜仲皮组137·84±25.08(P＜0.05)，表明杜仲可同时使血浆中cAMP和cGMP含量升高，显示杜仲对环核苷酸代谢有调节作用。同时实验证明杜仲叶、枝、再生皮亦可引起血浆中cAMP和cGMP含量升高。"}]},{"ID":"20240607150117-8i5a21v","Type":"NodeParagraph","Properties":{"id":"20240607150117-8i5a21v","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607150117-zxay5up","Type":"NodeParagraph","Properties":{"id":"20240607150117-zxay5up","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 1.杜仲：除去粗皮，洗净，润透，切成方块或丝条，晒干。"}]},{"ID":"20240607150117-5uk15si","Type":"NodeParagraph","Properties":{"id":"20240607150117-5uk15si","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.盐杜仲：先用食盐加适量开水溶化，取杜仲块或丝条，使与盐水充分拌透吸收，然后置锅内，用文火炒至微有焦斑为度，取出晾干。(每杜仲100斤，用食盐3斤)杜仲经炒制后，则杜仲胶被破坏，有效成分易于煎出。"}]},{"ID":"20240607150117-3dj1bph","Type":"NodeParagraph","Properties":{"id":"20240607150117-3dj1bph","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.取杜仲块，置锅内用武火炒至黑色并断丝，但须存性，用盐水喷洒，取出，防止复燃，晾干即得，每杜仲块100kg，用食盐3kg，或取杜仲块，先用盐水拌匀吸尽后置锅中，用武火炒至黑色并断丝存性，用水喷灭火星，取出晾干。每杜仲块100kg，用食盐3kg。"}]},{"ID":"20240607150117-bp0lck9","Type":"NodeParagraph","Properties":{"id":"20240607150117-bp0lck9","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607150117-ks5tm8b","Type":"NodeParagraph","Properties":{"id":"20240607150117-ks5tm8b","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240607150117-nqfgmg3","Type":"NodeParagraph","Properties":{"id":"20240607150117-nqfgmg3","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607150117-vgtgyhb","Type":"NodeParagraph","Properties":{"id":"20240607150117-vgtgyhb","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 甘；微辛；性温"}]},{"ID":"20240607150117-9o2zywj","Type":"NodeParagraph","Properties":{"id":"20240607150117-9o2zywj","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607150117-iq1g221","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607150117-iq1g221","updated":"20240607150117"},"Children":[{"ID":"20240607150117-4ezfio8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240607150117-4ezfio8","updated":"20240607150117"},"Children":[{"ID":"20240607150117-hov63to","Type":"NodeParagraph","Properties":{"id":"20240607150117-hov63to","updated":"20240607150117"}}]}]},{"ID":"20240607150117-d9mvznm","Type":"NodeParagraph","Properties":{"id":"20240607150117-d9mvznm","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：恶蛇皮、元参。"}]},{"ID":"20240607150117-3nq5uoa","Type":"NodeParagraph","Properties":{"id":"20240607150117-3nq5uoa","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.《本草经疏》：肾虚火炽者不宜用。即用当与黄柏、知母同入。"}]},{"ID":"20240607150117-xkpvghw","Type":"NodeParagraph","Properties":{"id":"20240607150117-xkpvghw","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"4.《得配本草》：内热、精血燥二者禁用。"}]},{"ID":"20240607150117-rbi4jqp","Type":"NodeParagraph","Properties":{"id":"20240607150117-rbi4jqp","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607150117-fj8exw7","Type":"NodeParagraph","Properties":{"id":"20240607150117-fj8exw7","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 补肝肾；强筋骨；安胎。主腰脊酸疼；阳痿；尿频；小便余沥；风湿痹痛；胎动不安；习惯性流产。"}]},{"ID":"20240607150117-7z0c6ha","Type":"NodeParagraph","Properties":{"id":"20240607150117-7z0c6ha","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607150117-rwmcu4x","Type":"NodeParagraph","Properties":{"id":"20240607150117-rwmcu4x","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或浸酒；或入丸、散。"}]},{"ID":"20240607150117-t7mor4p","Type":"NodeParagraph","Properties":{"id":"20240607150117-t7mor4p","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607150117-6uahbpc","Type":"NodeParagraph","Properties":{"id":"20240607150117-6uahbpc","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 1.杜仲丸(《证治准绳·女科》)，治妊娠二、三月，胎动不安。2.杜仲散(《圣惠方》)，治卒腰痛不可忍者。3.青蛾丸(《太平惠民和剂局方》)，功能温肾阳，止腹痛，治肾虚腰痛如折，起坐艰难，俯仰不利，转侧不能。4.右归丸(《景岳全书·新方八阵》)，治元阳不足，命门火衰。5.杜仲汤(《伤科补要》)，治腰脊伤痛。6.独活寄生汤(《备急千金要方》)，功能祛风湿，止痹痛，益肝肾，补气血，治肝肾两亏，气血不足，感受风寒湿邪，腰膝冷痛，肢节屈伸不利，或麻痹不仁，畏寒喜温。7.温胞饮(《傅青主女科》)，治妇人下部寒冷不孕。"}]},{"ID":"20240607150117-8tvexr4","Type":"NodeParagraph","Properties":{"id":"20240607150117-8tvexr4","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607150117-owr0mze","Type":"NodeParagraph","Properties":{"id":"20240607150117-owr0mze","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主腰脊痛，补中益精气，坚筋骨，强志，除阴下痒湿，小便余沥。2.《名医别录》：主脚中酸痛，不欲践地。"}]},{"ID":"20240607150117-jlssxqh","Type":"NodeParagraph","Properties":{"id":"20240607150117-jlssxqh","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：主肾冷JI腰痛，腰病人虚而身强直，风也。腰不利加而用之。"}]},{"ID":"20240607150117-g2ku5by","Type":"NodeParagraph","Properties":{"id":"20240607150117-g2ku5by","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：治肾劳，腰脊挛。入药炙用。"}]},{"ID":"20240607150117-6916xc8","Type":"NodeParagraph","Properties":{"id":"20240607150117-6916xc8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"5.王好古：润肝燥，补肝经风虚。"}]},{"ID":"20240607150117-n51idww","Type":"NodeParagraph","Properties":{"id":"20240607150117-n51idww","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"6.《本草正》：止小水梦遗，暖子宫，安胎气。"}]},{"ID":"20240607150117-enz8678","Type":"NodeParagraph","Properties":{"id":"20240607150117-enz8678","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"7.《玉楸药解》：益肝肾，养筋骨，去关节湿淫，治腰膝酸痛，腿足拘挛。"}]},{"ID":"20240607150117-77qyad5","Type":"NodeParagraph","Properties":{"id":"20240607150117-77qyad5","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"8.《本草再新》：充筋力，强阳道。"}]},{"ID":"20240607150117-qwzh5ze","Type":"NodeParagraph","Properties":{"id":"20240607150117-qwzh5ze","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"9.《本草纲目》：杜仲，古方只知滋肾，惟王好古言是肝经气分药，润肝燥，补肝虚，发昔人所未发也。盖肝主筋，肾主骨，肾充则骨强，肝充则筋健，屈伸利用，皆属于筋。杜仲色紫而润，味甘微辛，其气温平，甘温能补，微辛能润，故能入肝而补肾，子能令母实也。按庞元英《谈薮》：一少年得脚软病，且疼甚，医作脚气治不效。路钤孙琳诊之，用杜仲一味，寸断片折，每以一两，用半酒半水一大盏煎服，三日能行，又三日痊愈。琳曰，此乃肾虚，非脚气也，杜仲能治腰膝痛，以酒行之，则为效容易矣。"}]},{"ID":"20240607150117-8hegdza","Type":"NodeParagraph","Properties":{"id":"20240607150117-8hegdza","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"10.李中梓：杜仲，虽温而不助火。"}]},{"ID":"20240607150117-fqt61p8","Type":"NodeParagraph","Properties":{"id":"20240607150117-fqt61p8","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"11.《本草经疏》：杜仲，按《本经》所主腰脊痛，益精气，坚筋骨，脚中酸痛，不欲践地者，盖腰为肾之府，经曰，动摇不能，肾将惫矣。又肾藏精而主骨，肝藏血而主筋，二经虚，则腰脊痛而精气乏，筋骨软而脚不能践地也。《五脏苦欲补泻》云，肾苦燥，急食辛以润之，肝苦急，急食甘以缓之。杜仲辛甘具足，正能解肝肾之所苦，而补其不足者也。强志者，肾藏志，益肾故也。除阴下痒湿，小便余沥者，祛肾家之湿热也。益肾补肝，则精血自足，其主补中者，肝肾在下，脏中之阴也，阴足则中亦补矣。"}]},{"ID":"20240607150117-0plmo0h","Type":"NodeParagraph","Properties":{"id":"20240607150117-0plmo0h","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"12.《本草汇言》：方氏《直指》云：凡下焦之虚，非杜仲不补；下焦之湿，非杜仲不利；足胫之酸，非杜仲不去；腰膝之疼，非杜仲不除。然色紫而燥，质绵而韧，气温而补，补肝益肾，诚为要剂。如肝肾阳虚而有风湿病者，以盐酒浸炙，为效甚捷；如肝肾阴虚，而无风湿病，乃因精乏髓枯，血燥液干而成痿痹，成伛偻，以致俯仰屈伸不用者，又忌用之。"}]},{"ID":"20240607150117-yho9b1i","Type":"NodeParagraph","Properties":{"id":"20240607150117-yho9b1i","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"13.《药品化义》：杜仲，沉下入肾，盖肾欲坚，以苦坚之，用此坚肾气，强壮筋骨，主治腰脊酸疼，脚膝行痛，阴下湿痒，小便余沥。东垣云功效如神应，良不爽也。牛膝主下部分，杜仲主下部气分，相须而用。"}]},{"ID":"20240607150117-sduip39","Type":"NodeParagraph","Properties":{"id":"20240607150117-sduip39","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"14.《本草求真》：杜仲，入肝而补肾，子能令母实也，且性辛温，能除阴痒，去囊湿，痿痹瘫软必需，脚气疼痛必用，胎滑梦遗切要。若使遗精有痛，用此益见精脱不已，以其气味辛温，能助肝肾旺气也。胎因气虚而血不固，用此益见血脱不止，以其气不上升，反引下降也。功与牛膝、地黄、续断相佐而成，但杜仲性补肝肾，直达下部筋骨气血，不似牛膝达下，走于经络血分之中，熟地滋补肝肾，竟入筋骨精髓之内，续断调补筋骨，在于曲节气血之间为异耳。独怪今世安胎，不审气有虚实，辄以杜仲、牛膝、续断等药，引血下行。在肾经虚寒者，固可用此温补以固胎元。若气陷不升，血随气脱而胎不固者，用此则气益陷不升，其血必致愈脱不已。"}]},{"ID":"20240607150117-bmsay8h","Type":"NodeParagraph","Properties":{"id":"20240607150117-bmsay8h","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607150117-nu6taw0","Type":"NodeParagraph","Properties":{"id":"20240607150117-nu6taw0","updated":"20240607150117"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607150118-hbsu454","Type":"NodeThematicBreak","Properties":{"id":"20240607150118-hbsu454"}},{"ID":"20240607150119-abr580q","Type":"NodeParagraph","Properties":{"id":"20240607150119-abr580q"}}]}