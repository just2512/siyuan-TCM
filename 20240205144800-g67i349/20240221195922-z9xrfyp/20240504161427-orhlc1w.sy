nkDest","Data":"assets/天名精 8-20240731090617-imtk23x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 353px;\" parent-style=\"width: 363px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731090442-5a9vijq","Type":"NodeParagraph","Properties":{"id":"20240731090442-5a9vijq","updated":"20240731090445"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以下为蛤蟆草"}]},{"ID":"20240731090434-mhqfn1s","Type":"NodeParagraph","Properties":{"id":"20240731090434-mhqfn1s","updated":"20240731090659"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 639px;","style":"width: 629px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精 6-20240731090434-l2ch52x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 629px;\" parent-style=\"width: 639px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 635px;","style":"width: 625px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精 9-20240731090659-7l1lk7z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 625px;\" parent-style=\"width: 635px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240731090717-wjhyi0d","Type":"NodeParagraph","Properties":{"id":"20240731090717-wjhyi0d","updated":"20240731090734"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：天名精与蛤蟆草较为相似，注意甄别；"}]},{"ID":"20240730173117-3c46eem","Type":"NodeParagraph","Properties":{"id":"20240730173117-3c46eem","updated":"20240731084509"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：该本草全草名为天名精，果实名为鹤虱，根名为杜牛膝，苗名为活鹿草；"}]},{"ID":"20240616140235-s8tiwff","Type":"NodeThematicBreak","Properties":{"id":"20240616140235-s8tiwff"}},{"ID":"20240616140236-x13zsa6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140236-x13zsa6","updated":"20240616140240"},"Children":[{"Type":"NodeText","Data":"天名精《神农本草经》"}]},{"ID":"20240616140236-x10qxl3","Type":"NodeParagraph","Properties":{"id":"20240616140236-x10qxl3","updated":"20240616140236"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240616140236-li6n2t0","Type":"NodeParagraph","Properties":{"id":"20240616140236-li6n2t0","updated":"20240616140236"},"Children":[{"Type":"NodeText","Data":"主淤血，血瘕欲死，下血，止血，利小便。久服轻身耐老。一名麦句姜，一名虾蟆蓝，一名豕首。生川泽。"}]},{"ID":"20240616140236-p0b2svn","Type":"NodeParagraph","Properties":{"id":"20240616140236-p0b2svn","updated":"20240616140236"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名天门精，一名玉门精，一名彘颅，一名蟾蜍兰，一名觐。生平原，五月采。"}]},{"ID":"20240616140236-28z0jck","Type":"NodeParagraph","Properties":{"id":"20240616140236-28z0jck","updated":"20240616140236"},"Children":[{"Type":"NodeText","Data":"案《说文》云：薽，豕首也；《尔雅》云：茢薽豕首；郭璞云：今江东呼豨首，可以焰蚕蛹；陶宏景云：此即今人呼为豨莶；《唐本》云：鹿活草是也，别录一名天蔓菁，南文呼为地松；掌禹锡云：陈藏器别立地菘条，后人不当仍其谬。"}]},{"ID":"20240616140246-ra93h6y","Type":"NodeThematicBreak","Properties":{"id":"20240616140246-ra93h6y"}},{"ID":"20240616140247-1tz9pjb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140247-1tz9pjb","updated":"20240616140250"},"Children":[{"Type":"NodeText","Data":"天名精《名医别录》"}]},{"ID":"20240616140247-soal6uc","Type":"NodeParagraph","Properties":{"id":"20240616140247-soal6uc","updated":"20240616140247"},"Children":[{"Type":"NodeText","Data":"无毒．主逐水，大吐下．一名天门精，一名玉门精．一名彘颅，一名蟾蜍兰，一生平原．五月采．（垣衣为之使．）"}]},{"ID":"20240616140247-8zr03nu","Type":"NodeParagraph","Properties":{"id":"20240616140247-8zr03nu","updated":"20240616140247"},"Children":[{"Type":"NodeText","Data":"又，天名精，一名天蔓菁．"}]},{"ID":"20240616140105-038gavf","Type":"NodeThematicBreak","Properties":{"id":"20240616140105-038gavf"}},{"ID":"20240616140226-jfzi1e6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140226-jfzi1e6","updated":"20240616140230"},"Children":[{"Type":"NodeText","Data":"天名精《冯氏锦囊秘录》"}]},{"ID":"20240616140226-5t9uxjf","Type":"NodeParagraph","Properties":{"id":"20240616140226-5t9uxjf","updated":"20240616140226"},"Children":[{"Type":"NodeText","Data":"禀天地清阴之气，故味甘、辛，气寒而无毒。"}]},{"ID":"20240616140226-60gffni","Type":"NodeParagraph","Properties":{"id":"20240616140226-60gffni","updated":"20240616140226"},"Children":[{"Type":"NodeText","Data":"天名精，又名地菘，又名麦姜，又名蟾蜍兰，又名虾蟆兰，又名天蔓青，又名天门精，又名活鹿草，又名刘烬草。专疗伤折金疮，拔肿毒恶疔，下瘀血血瘕，利小便以逐积水，除热结而止渴烦，追小虫去湿痹，逐痰涎，定吐衄，敷治蛇虫螫毒，噙疗缠喉风肿。根名土牛膝，功用相同。子名鹤虱，任合丸散。大能杀虫追毒，蛔烧虫咬，心腹卒痛者，肥肉汁调下即安。砒霜毒吞，肠胃未裂者，浓齑汁送下立吐。"}]},{"ID":"20240616140142-bvbm0fl","Type":"NodeThematicBreak","Properties":{"id":"20240616140142-bvbm0fl"}},{"ID":"20240616140213-c1fbako","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140213-c1fbako","updated":"20240616140218"},"Children":[{"Type":"NodeText","Data":"天名精《本草从新》"}]},{"ID":"20240616140213-o8eq7sn","Type":"NodeParagraph","Properties":{"id":"20240616140213-o8eq7sn","updated":"20240616140213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名地松、一名活鹿草、一名虾蟆蓝．泻热吐痰、破血解毒．"}]},{"ID":"20240616140213-vlu0tak","Type":"NodeParagraph","Properties":{"id":"20240616140213-vlu0tak","updated":"20240616140213"},"Children":[{"Type":"NodeText","Data":"辛甘而寒．能破血．（一妇产后、口渴气喘、面赤有斑、大便泄、小便闭、用行血利水药不效、用天名精根叶、浓煎膏饮、下血一桶、小便通而愈．）能止血．吐痰除热、解毒杀虫．"}]},{"ID":"20240616140213-peyzgyz","Type":"NodeParagraph","Properties":{"id":"20240616140213-peyzgyz","updated":"20240616140213"},"Children":[{"Type":"NodeText","Data":"治乳蛾喉痹．砂淋血淋．（苏沈良方云∶浓煎加乳麝少许、神效．）小儿牙关紧闭．急慢惊风．（不省人事者、绞汁入好酒灌之、即苏、以醋拌渣、敷项下．）服汁吐疟痰．（喉蛾及惊风服之、亦取其吐痰．）漱汁止牙痛．捣敷蛇虫螫毒．根名杜牛膝．功用相同．色白如短牛膝．（煎汤洗痔、渣塞患处良．）地黄为使．（男女吐血、地松晒干为末、茅花汤调服二钱、效．）"}]},{"ID":"20240616140213-kaufu22","Type":"NodeParagraph","Properties":{"id":"20240616140213-kaufu22","updated":"20240616140213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鹤虱"},{"Type":"NodeText","Data":"（泻、杀虫．）苦辛．杀五脏虫．治蛔咬腹痛．（面白唇红、时发时止、为虫痛、肥肉汁调末服．）即天名精子．最黏人衣．有狐气．炒熟则香．（怪疾奇方、大肠虫出不断、断之复生、行坐不得、鹤虱末水调半两服、自愈．）"}]},{"ID":"20240616140142-154kysa","Type":"NodeThematicBreak","Properties":{"id":"20240616140142-154kysa"}},{"ID":"20240616140204-86qgblk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140204-86qgblk","updated":"20240616140207"},"Children":[{"Type":"NodeText","Data":"天名精《药性切用》"}]},{"ID":"20240616140204-iuvdl5a","Type":"NodeParagraph","Properties":{"id":"20240616140204-iuvdl5a","updated":"20240616140204"},"Children":[{"Type":"NodeText","Data":"一名地松，一名活鹿草，一名虾蟆蓝。辛甘性寒，能除热吐痰，破血解毒。根∶名膝，功用相同。鹤虱∶即天名精子，性味苦寒，杀虫治蛇，为蛔咬腹痛专药。"}]},{"ID":"20240616140142-8hmvu5z","Type":"NodeThematicBreak","Properties":{"id":"20240616140142-8hmvu5z"}},{"ID":"20240616140155-p9ynncu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140155-p9ynncu","updated":"20240616140159"},"Children":[{"Type":"NodeText","Data":"天名精《本草撮要》"}]},{"ID":"20240616140155-htlalca","Type":"NodeParagraph","Properties":{"id":"20240616140155-htlalca","updated":"20240616140155"},"Children":[{"Type":"NodeText","Data":"味甘寒微毒．入手足阳明厥阴经．功专破血．治砂淋血淋．得乳麝少许共为末．吹治乳娥喉痹．若小儿急慢惊风．牙关紧闭．绞汁入好酒灌之即醒．以渣用醋拌敷项下神效．根名杜牛膝．男女吐血．晒干为末．茅花汤调服二钱．虫痛以肥肉汁调服．子名鹤虱．大肠虫出不断．断之复生．行坐不得．炒研为末．水调服半两许即愈．以之煎汤洗痔．渣敷患处．或捣敷蛇虫螫毒尤良．地黄为使．一名地松．一名活鹿草．一名虾蟆蓝．"}]},{"ID":"20240616140142-xw8d1rb","Type":"NodeThematicBreak","Properties":{"id":"20240616140142-xw8d1rb"}},{"ID":"20240616140143-x9o6tjy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140143-x9o6tjy","updated":"20240616140150"},"Children":[{"Type":"NodeText","Data":"天名精《本草图经》"}]},{"ID":"20240616140143-428kfhq","Type":"NodeParagraph","Properties":{"id":"20240616140143-428kfhq","updated":"20240616140145"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"天名精"},{"Type":"NodeText","Data":"，生平原川泽，今江湖间皆有之。夏秋抽条，颇如薄荷，花紫白色，叶如菘菜而小，故南人谓之地菘。香气似兰，故名蟾蜍兰。状如蓝，故名虾蟆蓝。其味甘、辛，故名麦句姜，一名豕首。《尔雅》所谓 （音列） （音真），豕首是也。江东人用此以 （音炒）蚕蛹。"}]},{"ID":"20240616140143-pzjnxsh","Type":"NodeParagraph","Properties":{"id":"20240616140143-pzjnxsh","updated":"20240616140143"},"Children":[{"Type":"NodeText","Data":"五月采此草，既名地菘，下品又有地菘条。陶隐居云∶钓樟条说地菘，事见《异苑》。宋·元嘉（公元424～452年）中，刘 为青州，射一獐，既剖五脏，以此草塞之，蹶然而起，怪而拔草，便倒，如此者三。 密录以种之，主折伤多愈，因名刘 草。陈藏器以谓此草既有鹿活之名，雅与獐事相会，当便是一物不疑矣，故并于此见之。"}]},{"ID":"20240616140105-gtlvkuh","Type":"NodeThematicBreak","Properties":{"id":"20240616140105-gtlvkuh"}},{"ID":"20240616140134-833rtmi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140134-833rtmi","updated":"20240616140137"},"Children":[{"Type":"NodeText","Data":"天名精《本经逢原》"}]},{"ID":"20240616140134-vgm3y8i","Type":"NodeParagraph","Properties":{"id":"20240616140134-vgm3y8i","updated":"20240616140134"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名蛤蟆蓝，一名地菘，子名鹤虱"}]},{"ID":"20240616140134-7it22yp","Type":"NodeParagraph","Properties":{"id":"20240616140134-7it22yp","updated":"20240616140134"},"Children":[{"Type":"NodeText","Data":"甘寒，无毒。"}]},{"ID":"20240616140134-2g1unkx","Type":"NodeParagraph","Properties":{"id":"20240616140134-2g1unkx","updated":"20240616140134"},"Children":[{"Type":"NodeText","Data":"《本经》主瘀血，血瘕欲死，下血止血，利小便。"}]},{"ID":"20240616140134-k9movyf","Type":"NodeParagraph","Properties":{"id":"20240616140134-k9movyf","updated":"20240616140134"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"天名精功专散血，有破宿生新之功，故《本经》言下血止血，又能涌吐风痰，杀虫解毒。擂汁服之，能止痰疟，漱之止牙痛，捣之敷蛇伤，煎服除淫秽邪毒，从小便泄出。凡乳蛾喉咙肿痛，及小儿急慢惊风，牙关紧急，不省人事者，捣绞和酒灌之。咽喉肿塞，痰涎壅滞，捣汁鹅翎扫入，去痰立效。亦治猪瘟。"}]},{"ID":"20240616140105-l6ke38k","Type":"NodeThematicBreak","Properties":{"id":"20240616140105-l6ke38k"}},{"ID":"20240616140119-rccqp48","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140119-rccqp48","updated":"20240616140128"},"Children":[{"Type":"NodeText","Data":"天名精《得配本草》"}]},{"ID":"20240616140119-694vf88","Type":"NodeParagraph","Properties":{"id":"20240616140119-694vf88","updated":"20240616140119"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名皱面草，一名活鹿草，一名虾蟆蓝。"}]},{"ID":"20240616140119-kmzt9jt","Type":"NodeParagraph","Properties":{"id":"20240616140119-kmzt9jt","updated":"20240616140119"},"Children":[{"Type":"NodeText","Data":"垣衣、地黄为之使。"}]},{"ID":"20240616140119-jpkfsgt","Type":"NodeParagraph","Properties":{"id":"20240616140119-jpkfsgt","updated":"20240616140119"},"Children":[{"Type":"NodeText","Data":"甘、辛，寒。破血瘕，泻邪热，吐痰疟，开喉闭，止牙疼，敷疮痈。捣汁，和猪肉汁，治虫痛。捣汁独服，吐痰疟。"}]},{"ID":"20240616140119-wdn2zey","Type":"NodeParagraph","Properties":{"id":"20240616140119-wdn2zey","updated":"20240616140119"},"Children":[{"Type":"NodeText","Data":"配酒糟，捣和敷疔疮。入青矾少许，点喉肿。"}]},{"ID":"20240616140119-f7ppvo7","Type":"NodeParagraph","Properties":{"id":"20240616140119-f7ppvo7","updated":"20240616140119"},"Children":[{"Type":"NodeText","Data":"捣生汁用，令人吐。"}]},{"ID":"20240616140105-5wqi72p","Type":"NodeThematicBreak","Properties":{"id":"20240616140105-5wqi72p"}},{"ID":"20240616140106-poei5y8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140106-poei5y8","updated":"20240616140112"},"Children":[{"Type":"NodeText","Data":"天名精《本草崇原》"}]},{"ID":"20240616140106-g2iew0z","Type":"NodeParagraph","Properties":{"id":"20240616140106-g2iew0z","updated":"20240616140106"},"Children":[{"Type":"NodeText","Data":"气味甘寒，无毒。主治瘀血，血瘕欲死，下血，止血，利小便。久服轻身耐老。"}]},{"ID":"20240616140106-e80c1cc","Type":"NodeParagraph","Properties":{"id":"20240616140106-e80c1cc","updated":"20240616140106"},"Children":[{"Type":"NodeText","Data":"（天名精合根苗花实而言也，根名土牛膝，苗名活鹿草。实名鹤虱。所以名活鹿者，《异苑云∶宋元嘉中青州刘懵射一鹿，剖五藏以此草塞之，蹶然而起。懵怪而拔草便倒，如此三度，懵因密录，此草种之，治折伤愈多人，因以名之。始出平原川泽，今江湖间皆有之，路旁阴湿处甚多。春生苗，高二三尺，叶如紫苏叶而尖长，七月开黄白花，如小野菊，结实如茼蒿子，最黏人衣，狐气尤甚。炒熟则香，因名鹤虱，俗名鬼虱，其根黄白色，如牛膝而稍短，故名土牛膝。）"}]},{"ID":"20240616140106-sg6cays","Type":"NodeParagraph","Properties":{"id":"20240616140106-sg6cays","updated":"20240616140106"},"Children":[{"Type":"NodeText","Data":"鹿乃纯阳之兽，得此天名精而复活，盖禀水天之气而多阴精，故能治纯阳之鹿。主治瘀血，血瘕欲死，得水天之精气。阴中有阳，阳中有阴，故瘀久成瘕之积血，至欲死而可治，亦死而能生之义也。又曰∶下血、止血者，申明所以能治瘀血血瘕欲死，以其能下积血，而复止新血也。水精之气，上合于天，则小便自利。久服则精气足，故轻身耐老。"}]},{"ID":"20240607124647-usm1gne","Type":"NodeThematicBreak","Properties":{"id":"20240607124647-usm1gne"}},{"ID":"20240616140056-wr9ql1o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140056-wr9ql1o","updated":"20240616140101"},"Children":[{"Type":"NodeText","Data":"天名精《新修本草》"}]},{"ID":"20240616140056-rwd8rl7","Type":"NodeParagraph","Properties":{"id":"20240616140056-rwd8rl7","updated":"20240616140056"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主瘀血，血瘕欲死，下血，止血，利小便，除小虫，去痹，除胸中结热，止烦渴。逐水大吐下。"}]},{"ID":"20240616140056-wd9oud5","Type":"NodeParagraph","Properties":{"id":"20240616140056-wd9oud5","updated":"20240616140056"},"Children":[{"Type":"NodeText","Data":"久服轻身，耐老。一名麦句姜，一名虾蟆蓝，一名豕首，一名天门精，一名玉门精，一名彘颅，一名蟾蜍兰，一名觐。"}]},{"ID":"20240616140056-8g6fsb6","Type":"NodeParagraph","Properties":{"id":"20240616140056-8g6fsb6","updated":"20240616140056"},"Children":[{"Type":"NodeText","Data":"生平原川泽，五月采。"}]},{"ID":"20240616140056-y4w9c1a","Type":"NodeParagraph","Properties":{"id":"20240616140056-y4w9c1a","updated":"20240616140056"},"Children":[{"Type":"NodeText","Data":"垣衣为之使。此即今人呼为 ，亦名 首。夏月捣汁服之，以除热病。味至苦，而云甘，恐或非是。"}]},{"ID":"20240616140056-v95tdzf","Type":"NodeParagraph","Properties":{"id":"20240616140056-v95tdzf","updated":"20240616140056"},"Children":[{"Type":"NodeText","Data":"〔谨案〕鹿活草是也。《别录》一名天蔓菁，南人名为地松，味甘、辛，故有姜称；状如蓝，故名虾蟆蓝，香气似兰，故名蟾蜍兰。"}]},{"ID":"20240616140056-v7b5rrg","Type":"NodeParagraph","Properties":{"id":"20240616140056-v7b5rrg","updated":"20240616140056"},"Children":[{"Type":"NodeText","Data":"主破血，生肌，止渴，利小便，杀三虫，除诸毒肿，疔疮， 痔，金疮内射，身痒瘾疹不止者，揩之立已。其 苦而臭，名精乃辛而香，全不相类也。"}]},{"ID":"20240616135941-4dgxcvk","Type":"NodeThematicBreak","Properties":{"id":"20240616135941-4dgxcvk"}},{"ID":"20240616140046-h1dl8t7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140046-h1dl8t7","updated":"20240616140050"},"Children":[{"Type":"NodeText","Data":"天名精《医学入门》"}]},{"ID":"20240616140046-yb4z3fb","Type":"NodeParagraph","Properties":{"id":"20240616140046-yb4z3fb","updated":"20240616140046"},"Children":[{"Type":"NodeText","Data":"天名精寒甘且芳，杀虫消肿敷诸疮，破血止血除诸痹，便难烦渴可煎汤，子如鹤虱平苦味，主蛔咬心痛莫当。"}]},{"ID":"20240616140046-v3hfnoc","Type":"NodeParagraph","Properties":{"id":"20240616140046-v3hfnoc","updated":"20240616140046"},"Children":[{"Type":"NodeText","Data":"此草得天之精所生，大有灵异。昔人射一麂，剖五脏，以草塞之，蹶然而起，故又名活鹿草。南人呼为火炊，花实全类 ，但 苦而臭，名精辛且芳，故又名麦句姜，在处有之。夏秋抽条，颇似薄荷，花紫白色，叶似崧菜而小，无毒。杀小虫，除诸毒，疔疮痔 ，金疮内射，身痒瘾疹不止，揩之立已。主瘀血瘕欲死，下血止血，利小便，去痹，除胸中结热，止烦渴，逐水大吐下。五月采，阴干。垣衣为使。子，形如鹤虱，黄黑色，微毒。主蛔虫、蛲虫咬心腹痛，杀虫丸散中为最要药，兼止疟，敷恶疮，入药微炒。"}]},{"ID":"20240616135941-hg8i29b","Type":"NodeThematicBreak","Properties":{"id":"20240616135941-hg8i29b"}},{"ID":"20240616140038-wru4o4u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140038-wru4o4u","updated":"20240616140041"},"Children":[{"Type":"NodeText","Data":"天名精《千金翼方》"}]},{"ID":"20240616140038-t4vrdol","Type":"NodeParagraph","Properties":{"id":"20240616140038-t4vrdol","updated":"20240616140038"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主瘀血，血瘕欲死，下血止血，利小便，除小虫，去痹，除胸中结热，止烦渴，逐水大吐下。久服轻身耐老。一名麦句姜，一名虾蟆蓝，一名豕首，一名天门精，一名玉门精，一名彘颅，一名蟾蜍兰，一名觐。生平原川泽，五月采。"}]},{"ID":"20240616135941-eakg32v","Type":"NodeThematicBreak","Properties":{"id":"20240616135941-eakg32v"}},{"ID":"20240616140029-pmsvffh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240616140029-pmsvffh","updated":"20240616140033"},"Children":[{"Type":"NodeText","Data":"天名精《本草述钩元》"}]},{"ID":"20240616140029-xyhhq1x","Type":"NodeParagraph","Properties":{"id":"20240616140029-xyhhq1x","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"即皱面草。一名蚵草。根名杜牛膝。子名鹤虱。并根苗而言。则为天名精。嫩苗绿色。似皱叶菘芥。微有狐气。长则起茎。开小黄花如野菊。结实如茼蒿。子亦相似。最粘人衣。狐气尤甚。炒熟则香。其根白色。如短牛膝。一名地菘。（菘即白菜）与易混。"}]},{"ID":"20240616140029-67z4sly","Type":"NodeParagraph","Properties":{"id":"20240616140029-67z4sly","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"但草反面叶筋三条。毛多而软。天名精叶反面筋多。毛少而带硬。为异。"}]},{"ID":"20240616140029-qdoyof7","Type":"NodeParagraph","Properties":{"id":"20240616140029-qdoyof7","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"叶"}]},{"ID":"20240616140029-imydc5t","Type":"NodeParagraph","Properties":{"id":"20240616140029-imydc5t","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"（根苗同）味苦微辛。微甘。气寒。有小毒。生汁吐人。除胸中结热。去痹。下血止血瘕欲死。利小便。擂汁服之。吐痰止疟。杀三虫。之敷诸肿毒及蛇咬。亦治疗口紧喉痹。取汁漱之。止牙痛。（诸本草）凡男妇乳蛾肿痛。小儿急慢惊风。牙不省人事者。取皱面草连根。（即杜牛膝）洗净捣烂。入好酒。绞汁灌之。良久即苏渣敷项下。或醋调搽亦可。咽喉肿塞。痰涎壅滞。水不可下者。地菘连根叶捣汁。"}]},{"ID":"20240616140029-vblci67","Type":"NodeParagraph","Properties":{"id":"20240616140029-vblci67","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"入。去痰最妙。缠喉风肿。蚵草细研。生蜜和丸弹子大。每噙一二丸即愈。干者蜜丸亦可。恶疮肿毒。地菘捣汁。日服三四次。"}]},{"ID":"20240616140029-wz16zdu","Type":"NodeParagraph","Properties":{"id":"20240616140029-wz16zdu","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"〔论〕天名精味苦胜于辛。辛又胜于甘。苦下泄。辛横散。辛苦合于甘。则入血而逐热散之所"}]},{"ID":"20240616140029-o3kxiop","Type":"NodeParagraph","Properties":{"id":"20240616140029-o3kxiop","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"鹤虱"}]},{"ID":"20240616140029-07qgg11","Type":"NodeParagraph","Properties":{"id":"20240616140029-07qgg11","updated":"20240616140029"},"Children":[{"Type":"NodeText","Data":"气味苦辛凉。有小毒。杀虫方中。最为要药。"}]},{"ID":"20240607124621-zpilaye","Type":"NodeThematicBreak","Properties":{"id":"20240607124621-zpilaye"}},{"ID":"20240607124615-5fehla8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124615-5fehla8","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：天名精"}]},{"ID":"20240607124615-ylvgbdh","Type":"NodeParagraph","Properties":{"id":"20240607124615-ylvgbdh","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124615-r48i5lg","Type":"NodeParagraph","Properties":{"id":"20240607124615-r48i5lg","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" Tiān Mínɡ Jīnɡ"}]},{"ID":"20240607124615-rcngbxp","Type":"NodeParagraph","Properties":{"id":"20240607124615-rcngbxp","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124615-sdtti4v","Type":"NodeParagraph","Properties":{"id":"20240607124615-sdtti4v","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 茢薽、豕首（《尔雅》），麦句姜、虾蟆蓝（《本经》），天芜菁（叫、品方》），天门精、玉门精、彘颅、蟾蜍兰、觐、地菘、天蔓菁（《别录》），葵松、鹿活草（《唐本草》），杜牛膝（《圣济总录》），皱面草（《履巉岩本草》），皱面地菘草（《卫生家宝方》），鹤虱草（《伤寒蕴要》），母猪芥（《孙天仁集效方》），蚵蚾草（《经效济世良方》），土牛膝（《本草崇原》），鸡踝子草（《本草正义》），野烟、山烟、野叶子烟、癞格宝草（《贵州民间方药集》），癞蟖草（《中国植物图鉴》），挖耳草、额头草、癞蛤蟆草、臭草（《上海常用中草"}]},{"ID":"20240607124615-w4z4cg2","Type":"NodeParagraph","Properties":{"id":"20240607124615-w4z4cg2","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607124615-jfbwsta","Type":"NodeParagraph","Properties":{"id":"20240607124615-jfbwsta","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607124615-8wd6qo7","Type":"NodeParagraph","Properties":{"id":"20240607124615-8wd6qo7","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124615-2nbnf4n","Type":"NodeParagraph","Properties":{"id":"20240607124615-2nbnf4n","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 为菊种植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天名精"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎叶"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607124615-3rw7kws","Type":"NodeParagraph","Properties":{"id":"20240607124615-3rw7kws","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607124615-7dwkjwd","Type":"NodeParagraph","Properties":{"id":"20240607124615-7dwkjwd","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 生长于山野草丛中。分布河南、湖南、湖北、四川、云南，江苏、浙江、福建、台湾、江西、贵州、陕西等地。"}]},{"ID":"20240607124615-6h4tcg7","Type":"NodeParagraph","Properties":{"id":"20240607124615-6h4tcg7","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607124615-lb2ksob","Type":"NodeParagraph","Properties":{"id":"20240607124615-lb2ksob","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高30～100厘米，有臭味。茎直立，上部多分枝，有细软毛。茎下部叶互生；稍有柄；叶片广椭圆形或长椭圆形，长10～15厘米，宽5～8厘米，先端尖或钝，全缘，或有不规则的锯齿，上面绿色较深，光滑，下面有细软毛和腺点；茎上部叶近于无柄；长椭圆形，向上逐渐变小。头状花序多数，腋生，近乎无柄，有时下垂；总苞钟形或稍带圆形，外层苞片稍短，卵圆形，中层和内层苞片长椭圆形；花序中全为管状花，黄色；花序外围为雌花，花冠先端3～5齿裂，花后柱头外露；中央数层为两性花，花冠先端4～5齿裂，花后雌雄蕊均外露，花药基部箭形，柱头2深裂，裂片线形。瘦果长约3～5毫米，有纵沟多条，顶端有线形短喙，无冠毛。花期6～8月。果期9～10月。"}]},{"ID":"20240607124615-0tvaaaa","Type":"NodeParagraph","Properties":{"id":"20240607124615-0tvaaaa","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"本植物的果实（鹤虱）亦供药用，另详专条。"}]},{"ID":"20240607124615-9du0a5j","Type":"NodeParagraph","Properties":{"id":"20240607124615-9du0a5j","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124615-3lj0uh0","Type":"NodeParagraph","Properties":{"id":"20240607124615-3lj0uh0","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 入肝、肺经。"}]},{"ID":"20240607124615-1lxnhay","Type":"NodeParagraph","Properties":{"id":"20240607124615-1lxnhay","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"①《本草再新》：\"入肺经。\""}]},{"ID":"20240607124615-jddr31s","Type":"NodeParagraph","Properties":{"id":"20240607124615-jddr31s","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"入手足阳明、厥阴经。\""}]},{"ID":"20240607124615-ef0ovye","Type":"NodeParagraph","Properties":{"id":"20240607124615-ef0ovye","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124615-nhp3uwm","Type":"NodeParagraph","Properties":{"id":"20240607124615-nhp3uwm","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 辛，寒。"}]},{"ID":"20240607124615-7e5ew9q","Type":"NodeParagraph","Properties":{"id":"20240607124615-7e5ew9q","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，寒。\""}]},{"ID":"20240607124615-ogs4s3f","Type":"NodeParagraph","Properties":{"id":"20240607124615-ogs4s3f","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"味辛，无毒。\""}]},{"ID":"20240607124615-7hl7gi8","Type":"NodeParagraph","Properties":{"id":"20240607124615-7hl7gi8","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑧《开宝本草》：\"味咸。\""}]},{"ID":"20240607124615-45ea2sg","Type":"NodeParagraph","Properties":{"id":"20240607124615-45ea2sg","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"微辛甘，有小毒。\""}]},{"ID":"20240607124615-zlreq47","Type":"NodeParagraph","Properties":{"id":"20240607124615-zlreq47","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607124615-l3kr3sw","Type":"NodeParagraph","Properties":{"id":"20240607124615-l3kr3sw","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"垣衣为之使。\""}]},{"ID":"20240607124615-qct625d","Type":"NodeParagraph","Properties":{"id":"20240607124615-qct625d","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"②《蜀本草》：\"地黄为使。\""}]},{"ID":"20240607124615-s5k4vp1","Type":"NodeParagraph","Properties":{"id":"20240607124615-s5k4vp1","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"脾胃寒薄，性不喜食冷，易泄无渴者勿服。\""}]},{"ID":"20240607124615-cqvvm3h","Type":"NodeParagraph","Properties":{"id":"20240607124615-cqvvm3h","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124615-6k2ygyp","Type":"NodeParagraph","Properties":{"id":"20240607124615-6k2ygyp","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 祛痰，清热，破血，止血，解毒，杀虫。治乳蛾，喉痹，疟疾，急性肝炎，急慢惊风，虫积，血瘕，衄血，血淋，疔肿疮毒，皮肤痒疹。"}]},{"ID":"20240607124615-3uwq94a","Type":"NodeParagraph","Properties":{"id":"20240607124615-3uwq94a","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主瘀血、血瘕。下血、止血，利小便。\""}]},{"ID":"20240607124615-svuodce","Type":"NodeParagraph","Properties":{"id":"20240607124615-svuodce","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"除小虫，去痹，除胸中结热，止烦渴，逐水，大吐下。\""}]},{"ID":"20240607124615-6v0xr0t","Type":"NodeParagraph","Properties":{"id":"20240607124615-6v0xr0t","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治疮，止血及鼻衄不止。\""}]},{"ID":"20240607124615-1sn8p4z","Type":"NodeParagraph","Properties":{"id":"20240607124615-1sn8p4z","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"主破血，生肌，止渴，利小便，杀三虫。除诸毒肿疔疮，瘘痔，金疮内射。身痒瘾疹不止者，揩之立已。\""}]},{"ID":"20240607124615-onxkfs3","Type":"NodeParagraph","Properties":{"id":"20240607124615-onxkfs3","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑤《开宝本草》：\"主金疮，止血，解恶虫蛇螫毒，按以敷之。\""}]},{"ID":"20240607124615-t0ymu34","Type":"NodeParagraph","Properties":{"id":"20240607124615-t0ymu34","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"吐痰止疟。治牙痛口紧，喉痹。\""}]},{"ID":"20240607124615-3vrrcdu","Type":"NodeParagraph","Properties":{"id":"20240607124615-3vrrcdu","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑦《本草备要》：\"治乳蛾喉痹，砂淋血淋。\""}]},{"ID":"20240607124615-4l7gd8l","Type":"NodeParagraph","Properties":{"id":"20240607124615-4l7gd8l","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑧《野生药植图说》：\"嫩叶捣烂治脚癣。\""}]},{"ID":"20240607124615-b14sg6t","Type":"NodeParagraph","Properties":{"id":"20240607124615-b14sg6t","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑨《杭州药植志》：\"强力杀虫药，可以杀蛔虫及绦虫，并治失力黄疸。\""}]},{"ID":"20240607124615-z6ejmkw","Type":"NodeParagraph","Properties":{"id":"20240607124615-z6ejmkw","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124615-dhw1qeo","Type":"NodeParagraph","Properties":{"id":"20240607124615-dhw1qeo","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；捣汁或入丸、散。外用：捣敷或煎水熏洗。"}]},{"ID":"20240607124615-fayz8a4","Type":"NodeParagraph","Properties":{"id":"20240607124615-fayz8a4","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607124615-w8fpri8","Type":"NodeParagraph","Properties":{"id":"20240607124615-w8fpri8","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" ①治咽喉肿塞，痰涎壅滞，喉肿水不可下者：地菘捣汁。鹅翎扫入，去痰最妙。（《伤寒蕴要》）"}]},{"ID":"20240607124615-donzs5l","Type":"NodeParagraph","Properties":{"id":"20240607124615-donzs5l","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"②治缠喉风：蚵蚾草，细研，用生蜜和丸弹子大，噙化一、二丸。如无新者，只用干者为末，以生蜜为丸，不必成弹子，但如弹子大一块。（《经效济世良方》救生丸）"}]},{"ID":"20240607124615-5w0b94q","Type":"NodeParagraph","Properties":{"id":"20240607124615-5w0b94q","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"③治吐血疾：皱面草，不以多少，为细末。每服一，二钱，用茅花泡汤调服，不以时候。（《履巉岩本草》）"}]},{"ID":"20240607124615-s3spsa5","Type":"NodeParagraph","Properties":{"id":"20240607124615-s3spsa5","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"④治产后口渴气喘，面赤有斑，大便泄，小便闭，用行血利水药不效：天名精根叶，浓煎膏饮。下血，小便通而愈。（《本草从新》）"}]},{"ID":"20240607124615-udc2w4h","Type":"NodeParagraph","Properties":{"id":"20240607124615-udc2w4h","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑤治疔疮肿毒：鹤虱草叶、浮酒糟。同捣敷。（《孙天仁集效方》）"}]},{"ID":"20240607124615-wcgwd6o","Type":"NodeParagraph","Properties":{"id":"20240607124615-wcgwd6o","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑥治风毒瘰疬，赤肿痛硬：地菘一斤。捣如泥，敷瘰疬上，干即易之，以差为度。（《圣惠方》）"}]},{"ID":"20240607124615-tbaygpp","Type":"NodeParagraph","Properties":{"id":"20240607124615-tbaygpp","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑦治发背初起：地菘，杵汁一升，日再服，瘥乃止。（《伤寒类要》）"}]},{"ID":"20240607124615-iyc62aj","Type":"NodeParagraph","Properties":{"id":"20240607124615-iyc62aj","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"⑧治恶疮：捣地菘汁服之，每日两三服。（孟诜《必效方》）"}]},{"ID":"20240607124615-lubyyq8","Type":"NodeParagraph","Properties":{"id":"20240607124615-lubyyq8","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607124615-wy6hrrs","Type":"NodeParagraph","Properties":{"id":"20240607124615-wy6hrrs","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" ①治疗急性黄疸型传染性肝炎"}]},{"ID":"20240607124615-fic8iaa","Type":"NodeParagraph","Properties":{"id":"20240607124615-fic8iaa","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"取新鲜天名精（包括根枝叶）4两，生姜2片（约1钱），加水1000毫升，煎至300毫升，上下午空腹时分服。服药期间，忌食酸，辣、肥肉。治疗10例，经服药9～41剂，平均20剂后，9例痊愈，1例好转。服药后可见尿量增多，自觉症状改善。平均服药15.4天黄疸指数降至7单位以下，19.4天谷丙转氨酶恢复正常，11天自觉症状（除乏力外）消失，肝脾肿大与压痛亦有不同程度改善。治程中未见副作用出现。"}]},{"ID":"20240607124615-p29dmm7","Type":"NodeParagraph","Properties":{"id":"20240607124615-p29dmm7","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"②治疗急性肾炎"}]},{"ID":"20240607124615-wacxe0x","Type":"NodeParagraph","Properties":{"id":"20240607124615-wacxe0x","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"取鲜草2～3两洗净捣烂，加少许红糖或食盐拌匀，外敷脐部，上覆油纸以防药气外溢。每天更换1次，4～7天为一疗程，必要时可连敷二个疗程。治疗期间须卧床休息，进低盐饮食。治疗急性肾炎患儿31例，其中29例水肿在3天内消退，2例在5～7天内消退；小便检查在2～7天内蛋白及管型消失，红白细胞减少；血压于4天内绝大多数降至正常。经1～6个月的追踪观察，临床症状无一例复发，仅有3例尿中仍发现红白细胞及透明管型。治程中，少数患儿敷药6天后，局部发生皮炎，有的起泡，糜烂；故在局部皮肤出现潮红时即应停止敷药。"}]},{"ID":"20240607124615-abp6c1g","Type":"NodeParagraph","Properties":{"id":"20240607124615-abp6c1g","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"③用于皮肤消毒"}]},{"ID":"20240607124615-dbieqcw","Type":"NodeParagraph","Properties":{"id":"20240607124615-dbieqcw","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"用100％鲜野烟煎液作术前洗手和术野皮肤消毒，先后成功地进行了胆囊造瘘术、腹部探查术、疝修补术、脂肪瘤切除以及割脂、埋线等中、小手术共297例，其中292例切口一期愈合，占98.3％。"}]},{"ID":"20240607124615-s3mgy8w","Type":"NodeParagraph","Properties":{"id":"20240607124615-s3mgy8w","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"④治疗慢性下肢溃疡"}]},{"ID":"20240607124615-nuu2kwq","Type":"NodeParagraph","Properties":{"id":"20240607124615-nuu2kwq","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"取50％野烟煎液100毫升，加温浸洗患处，每次10～30分钟，每日3次。治疗11例，其中有2例曾加用\"920\"农药湿敷，1例慢性骨髓炎患者手术取出死骨。病程最长者30多年，最短为2个月；溃疡面积最大者为23x4厘米，最小者为1x1厘米。疗程最长为4个月，最短仅5天，多数在1～3个月之内。计治愈6例，其余各例均有不同程度的好转。治疗后创面分泌物明显减少.对慢性骨髓炎和大隐静脉曲张引起的慢性下肢溃疡，宜取出死骨和剥脱大隐静脉；否则，即使治愈，亦易复发。溃疡面积较大者，植皮可以缩短疗程。个别病人用野烟液湿敷时有痛感，可略加稀释。"}]},{"ID":"20240607124615-8kx2m2d","Type":"NodeParagraph","Properties":{"id":"20240607124615-8kx2m2d","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124615-nbmbpif","Type":"NodeParagraph","Properties":{"id":"20240607124615-nbmbpif","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607124615-5luhsvw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607124615-5luhsvw","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"《中华本草》：天名精"}]},{"ID":"20240607124615-afzjw3a","Type":"NodeParagraph","Properties":{"id":"20240607124615-afzjw3a","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607124615-bdgy9dx","Type":"NodeParagraph","Properties":{"id":"20240607124615-bdgy9dx","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" Tiān Mínɡ Jīnɡ"}]},{"ID":"20240607124615-fnz7njv","Type":"NodeParagraph","Properties":{"id":"20240607124615-fnz7njv","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607124615-0cf5lsb","Type":"NodeParagraph","Properties":{"id":"20240607124615-0cf5lsb","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 茢甄、豕首、麦句姜、虾蟆蓝、天芜菁、天门精、玉门精、彘颅、蟾蜍兰、觐、地菘、天蔓菁、葵松、鹿活草、杜牛膝、皱面草、皱面地菘草、鹤虱草、母猪芥、蚵蚾草、土牛膝、鸡踝子草、野烟、山烟、野叶子烟、癞格宝草、癞蟖草、挖耳草、癞头草、癞蛤蟆草、臭草"}]},{"ID":"20240607124615-sddi0tl","Type":"NodeParagraph","Properties":{"id":"20240607124615-sddi0tl","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607124615-gx1rg8f","Type":"NodeParagraph","Properties":{"id":"20240607124615-gx1rg8f","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" root of Common carpesium"}]},{"ID":"20240607124615-i956ntm","Type":"NodeParagraph","Properties":{"id":"20240607124615-i956ntm","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607124615-2m5o6gc","Type":"NodeParagraph","Properties":{"id":"20240607124615-2m5o6gc","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 1.出自《唐本草》：天名精，鹿活草是也。味甘辛，故有姜称，状如蓝，故名虾？蓝，香气似兰，故名蟾蜍兰。"}]},{"ID":"20240607124615-31kr51g","Type":"NodeParagraph","Properties":{"id":"20240607124615-31kr51g","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"2.《梦溪笔谈》：地菘，即天名精也。世人既不识天名精，又妄认地菘为火蔹，《本草》又出鹤虱一条，都成纷乱。今按，地菘即天名精，盖其叶似菘，又似蔓菁，蔓菁即蔓精也，故有二名，鹤虱即其实也。世间有单服火蔹法，乃是服地菘耳。不当用火蔹，火蔹《本草》名莶，即是猪膏苗，后人不识，亦重复出之。"}]},{"ID":"20240607124615-6t6enzz","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607124615-6t6enzz","updated":"20240607124615"},"Children":[{"ID":"20240607124615-bq52us5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240607124615-bq52us5","updated":"20240607124615"},"Children":[{"ID":"20240607124615-w83klrt","Type":"NodeParagraph","Properties":{"id":"20240607124615-w83klrt","updated":"20240607124615"}}]}]},{"ID":"20240607124615-pb9d05k","Type":"NodeParagraph","Properties":{"id":"20240607124615-pb9d05k","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607124615-hf4jm0w","Type":"NodeParagraph","Properties":{"id":"20240607124615-hf4jm0w","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物天名精的全草。"}]},{"ID":"20240607124615-iyv8uxv","Type":"NodeParagraph","Properties":{"id":"20240607124615-iyv8uxv","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Carpesium abrotanoides L."}]},{"ID":"20240607124615-iowe0hn","Type":"NodeParagraph","Properties":{"id":"20240607124615-iowe0hn","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7-8月采收，洗净，鲜用或晒干。"}]},{"ID":"20240607124615-12v6o4g","Type":"NodeParagraph","Properties":{"id":"20240607124615-12v6o4g","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607124615-zi39bd7","Type":"NodeParagraph","Properties":{"id":"20240607124615-zi39bd7","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 生于山坡、路旁或草坪上。广布于我国各地。"}]},{"ID":"20240607124615-7tsl2ih","Type":"NodeParagraph","Properties":{"id":"20240607124615-7tsl2ih","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607124615-6nvqb52","Type":"NodeParagraph","Properties":{"id":"20240607124615-6nvqb52","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 天名精 多年生草本，高50-100cm。茎直立，上部多分枝，密生短柔毛，下部近无毛。叶互生；下部叶片宽椭圆形或长圆形，长10-15cm，宽5-8cm，先端尖或钝，基部狭成具翅的叶柄，边缘有不规则的锯齿或全缘，上面有贴生短毛，下面有短柔毛和腺点，上部叶片渐小，长圆形，无柄。头关花序多数，沿茎枝腋生，有短梗或近无梗，直径6-8mm，平立或梢下垂；总苞钟状球形，总苞片3层，外层极短，卵形，先端尖，有短柔毛，中层和内层长圆形，先端圆钝，无毛；花黄色，外围的雌花花冠丝状，3-5齿先端有短喙，有腺点，无冠毛。药期6-8月，果期9-10月。"}]},{"ID":"20240607124615-al7wxrb","Type":"NodeParagraph","Properties":{"id":"20240607124615-al7wxrb","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607124615-hsz72vi","Type":"NodeParagraph","Properties":{"id":"20240607124615-hsz72vi","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 性物学特性 喜温暖湿润气候和阴湿环境、山区、平原等地均可栽培。"}]},{"ID":"20240607124615-mnztb0m","Type":"NodeParagraph","Properties":{"id":"20240607124615-mnztb0m","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。9-10月采集成熟种子，春季3-4月播种，条播，覆土仅盖没种子为度，浇水，保持土壤湿润，约经15-20d出苗。"}]},{"ID":"20240607124615-je3vvmn","Type":"NodeParagraph","Properties":{"id":"20240607124615-je3vvmn","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"田间管理 苗具4-6片真叶时间苗，按株距15cm定苗，苗高30cm进行松土除草，并延施人粪尿1次，适当增施过磷酸钙。"}]},{"ID":"20240607124615-nwc8nc4","Type":"NodeParagraph","Properties":{"id":"20240607124615-nwc8nc4","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607124615-oo40fa3","Type":"NodeParagraph","Properties":{"id":"20240607124615-oo40fa3","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎不明显，有多数细长的棕色须根。茎表面黄绿色或黄棕色，有纵条纹，上部多分枝；质较硬，易折断，断面类白色，髓白色、疏松。叶多皱缩或脱落，完整叶片卵状椭圆形或长椭圆形，长10-15cm，宽5-8cm，先端尖或钝，基部狭成具翅的短柄，边缘有不规则锯齿或全缘，上面有贴生短毛，下面有短柔毛或腺点；质脆易碎。头状花序多数，腋生，花序梗极短；花黄色。气特异，味淡微辛。"}]},{"ID":"20240607124615-3d94e29","Type":"NodeParagraph","Properties":{"id":"20240607124615-3d94e29","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607124615-yjmefeh","Type":"NodeParagraph","Properties":{"id":"20240607124615-yjmefeh","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 全草含倍半匝萜内酯：天名精内酯酮（carab-rone），鹤虱内酯（carpesiolin）[1]，大叶土木香内酯（granilin）[2]，依瓦菊素（ivalin）[3]，天名精内酯醇（carabrol），依生依瓦菊素（ivax-illin），11（13）-去氢腋生依瓦菊素[11（13）-dehydroivaxillin][4]，特勒内酯（telekin），异腋生依瓦菊素（isoivaxillin）及11（13）-二氢特勒内酯[11（13）-dihydrotelekin][5]。"}]},{"ID":"20240607124615-4lepard","Type":"NodeParagraph","Properties":{"id":"20240607124615-4lepard","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607124615-z26ak7a","Type":"NodeParagraph","Properties":{"id":"20240607124615-z26ak7a","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 天名精内酯对中枢神经系统有较显着的作用，给予小鼠，在短暂兴奋后即转入抑制，四肢肌肉松弛，并呈麻醉状态。大量则引起阵发性痉挛而致死。对小鼠腹腔注射之半数致死量约为0.1mg/g。能对抗可拉明（A分钟o-cordin）和士的宁（但不如Myanesin）的致痉作用。与巴比妥类有显着的协同作用。对神经末梢无箭毒样作用，对猫的脊髓中间神经原亦无作用。主要作用部位可能在延脑及脑干部分。此外，尚有降温、退热作用（正常及菌液引起发热之兔）。静脉注射20-30mg/kg于兔、猫可引起血压降低，阿托品不能阻断此作用，对犬、鼠脑组织的呼吸有抑制作用。"}]},{"ID":"20240607124615-q47k7ab","Type":"NodeParagraph","Properties":{"id":"20240607124615-q47k7ab","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607124615-z2lj4x5","Type":"NodeParagraph","Properties":{"id":"20240607124615-z2lj4x5","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 归肚；肺经"}]},{"ID":"20240607124615-edszfbd","Type":"NodeParagraph","Properties":{"id":"20240607124615-edszfbd","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607124615-edaxuez","Type":"NodeParagraph","Properties":{"id":"20240607124615-edaxuez","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性寒"}]},{"ID":"20240607124615-d8l1qut","Type":"NodeParagraph","Properties":{"id":"20240607124615-d8l1qut","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607124615-epopkle","Type":"NodeParagraph","Properties":{"id":"20240607124615-epopkle","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 1.《本草经集注》：垣衣为之使。"}]},{"ID":"20240607124615-ehcjh6z","Type":"NodeParagraph","Properties":{"id":"20240607124615-ehcjh6z","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：脾胃寒薄，性不喜食冷，易泄无渴者勿服。"}]},{"ID":"20240607124615-q5k4o9e","Type":"NodeParagraph","Properties":{"id":"20240607124615-q5k4o9e","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607124615-j40pzte","Type":"NodeParagraph","Properties":{"id":"20240607124615-j40pzte","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 清热；化痰；解毒；杀虫；破瘀；止血。主乳蛾、喉痹、急慢惊风、牙痛、疔疮肿毒、痔瘘、皮肤痒疹；毒蛇咬伤；虫积；血瘕；吐血；衄血；血淋；创伤出血。"}]},{"ID":"20240607124615-gm46roy","Type":"NodeParagraph","Properties":{"id":"20240607124615-gm46roy","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607124615-71by9u0","Type":"NodeParagraph","Properties":{"id":"20240607124615-71by9u0","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g；或研末，3-6g；或捣汁；或入丸、散。外用：适量，捣敷；或煎水熏洗及含漱。"}]},{"ID":"20240607124615-v6zf5dl","Type":"NodeParagraph","Properties":{"id":"20240607124615-v6zf5dl","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607124615-13060lp","Type":"NodeParagraph","Properties":{"id":"20240607124615-13060lp","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：天名精，并根苗而言也，地菘言其苗叶也，鹤虱言其子也。具功大抵只是吐痰，止血，杀虫，解毒，故擂汁服之，能止痰疟，漱之止牙疼，挼之敷蛇咬，亦治猪瘟病也。"}]},{"ID":"20240607124615-31mossz","Type":"NodeParagraph","Properties":{"id":"20240607124615-31mossz","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：天名精，辛能散结，寒能除热，故主瘀血，血瘕欲死，下血止血。小便不利，由于内热，除热则小便自利也。辛寒能散湿祛热，则小虫自除也。除痹者，去湿之功也。除胸中结热，止烦渴，祛热散结，益阴之功也。逐水者，湿热散，则水自消矣。其主破血，生肌，利小便，杀三虫，除诸毒肿，疔疮痿痔，金疮内射，身痒瘾疹不止者，揩之立已，凉血除热散结之力也。"}]},{"ID":"20240607124615-4tpckxh","Type":"NodeParagraph","Properties":{"id":"20240607124615-4tpckxh","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"3.《本草述》：天名精，似以能除胸中结热为主。盖痰乃热之所聚，毒乃痰热之所壅，风乃痰聚热壅之所化，病此数者，皆病平血，且凝或溢之不一，投此味得其能行能止而胥益也。"}]},{"ID":"20240607124615-zsym47s","Type":"NodeParagraph","Properties":{"id":"20240607124615-zsym47s","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"4.《本草正义》：天名精，其性寒凉，能滑利下行，据古籍则破血利水之力极大，《本经》、《别录》所载主治是也。后人则惟用以解毒降火，《唐本草》以下诸书，所载主治是也。今则以治喉风肿塞，甚至腐烂危险之候，取茎叶捣汁灌之。冬令草枯，无从取汁，则于夏秋之间预收茎叶捣汁，澄定，俟其将干凝结之时，作为丸子，阴干密贮，临用以清水化开，灌之亦效，甚者屡进之，探吐稠痰，大可转危为安，微贱药中之极有灵验者。盖消痰解毒，清热降火，开结利窍，合数者之功用，兼而有之，宜其投之辄效。其余诸证之应用此物者，大旨亦不外此十二字之作用矣。"}]},{"ID":"20240607124615-b71ts50","Type":"NodeParagraph","Properties":{"id":"20240607124615-b71ts50","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主瘀血、血瘕。下血、止血，利小便。"}]},{"ID":"20240607124615-ud75j7s","Type":"NodeParagraph","Properties":{"id":"20240607124615-ud75j7s","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"6.《别录》：除小虫，去痹，除胸中结热，止烦渴，逐水，大吐下。"}]},{"ID":"20240607124615-0w3yrej","Type":"NodeParagraph","Properties":{"id":"20240607124615-0w3yrej","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：治疮，止血及鼻衄不止。"}]},{"ID":"20240607124615-ufqz3wc","Type":"NodeParagraph","Properties":{"id":"20240607124615-ufqz3wc","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"8.《唐本草》：主破血，生肌，止渴，利小便，杀三虫。除诸毒肿疔疮，瘘痔，金疮内射。身痒瘾疹不止者，揩之立己。"}]},{"ID":"20240607124615-r9fwu5q","Type":"NodeParagraph","Properties":{"id":"20240607124615-r9fwu5q","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"9.《开宝本草》：主金疮，止血，解恶虫蛇螫毒，挼以敷之。"}]},{"ID":"20240607124615-6w6negu","Type":"NodeParagraph","Properties":{"id":"20240607124615-6w6negu","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"10.《纲目》：吐痰止疟。治牙痛口紧，喉痹。"}]},{"ID":"20240607124615-8xdi9wy","Type":"NodeParagraph","Properties":{"id":"20240607124615-8xdi9wy","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"11.《本草备要》：治乳蛾喉痹，砂淋血淋。"}]},{"ID":"20240607124615-2b34xvq","Type":"NodeParagraph","Properties":{"id":"20240607124615-2b34xvq","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"12.《野生植物图说》：嫩叶捣烂治脚癣。"}]},{"ID":"20240607124615-tih9skj","Type":"NodeParagraph","Properties":{"id":"20240607124615-tih9skj","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"13.《杭州药植志》：强力杀虫药，可以杀蛔虫及绦虫，并治失力黄疸。"}]},{"ID":"20240607124615-mnngb16","Type":"NodeParagraph","Properties":{"id":"20240607124615-mnngb16","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607124615-86ae667","Type":"NodeParagraph","Properties":{"id":"20240607124615-86ae667","updated":"20240607124615"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607124625-weqoqpj","Type":"NodeThematicBreak","Properties":{"id":"20240607124625-weqoqpj"}},{"ID":"20240607124626-pnods1p","Type":"NodeParagraph","Properties":{"id":"20240607124626-pnods1p"}}]}