{"ID":"20240504161427-orhlc1w","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504161427-orhlc1w","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504161427-orhlc1w\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240619140122-6b33xnd\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607124615-wy6hrrs\u0026quot;,\u0026quot;scrollTop\u0026quot;:3200\u0026#125;","title":"066天名精（野烟）","type":"doc","updated":"20240807132247"},"Children":[{"ID":"20240619140122-6b33xnd","Type":"NodeParagraph","Properties":{"id":"20240619140122-6b33xnd","updated":"20240619140122"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 469px;","style":"width: 459px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精9-20240619140122-vn8hzor.webp"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 459px;\" parent-style=\"width: 469px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619135159-otgd86b","Type":"NodeParagraph","Properties":{"id":"20240619135159-otgd86b","updated":"20240619135218"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 368px;","style":"width: 358px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天名精"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天名精-20240619135159-pa9d8cq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 358px;\" parent-style=\"width: 368px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 720px;","style":"width: 710px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data