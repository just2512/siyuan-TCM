pe":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"云实 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/云实 11-20240808100005-7gh18gi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 420px;\" parent-style=\"width: 430px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 361px;","style":"width: 351px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"云实 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/云实 14-20240808103807-krbhlle.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 351px;\" parent-style=\"width: 361px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808100159-l7q41l7","Type":"NodeParagraph","Properties":{"id":"20240808100159-l7q41l7","updated":"20240808103829"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 387px;","style":"width: 377px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"云实 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/云实 13-20240808100159-nqj2q73.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 377px;\" parent-style=\"width: 387px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 816px;","style":"width: 806px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"云实5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/云实5-20240620112538-90uijkt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 806px;\" parent-style=\"width: 816px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240808095714-sps7sjr","Type":"NodeParagraph","Properties":{"id":"20240808095714-sps7sjr","updated":"20240808095714"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 703px;","style":"width: 693px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"云实 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/云实 9-20240808095714-go2ldvg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 693px;\" parent-style=\"width: 703px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607132307-ktf1l7k","Type":"NodeThematicBreak","Properties":{"id":"20240607132307-ktf1l7k"}},{"ID":"20240617083437-v1qx0rg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083437-v1qx0rg","updated":"20240617083441"},"Children":[{"Type":"NodeText","Data":"云实《神农本草经》"}]},{"ID":"20240617083437-ecogqoc","Type":"NodeParagraph","Properties":{"id":"20240617083437-ecogqoc","updated":"20240617083437"},"Children":[{"Type":"NodeText","Data":"味辛温。主泄利（旧作痢，《御览》作泄利），肠澼，杀虫，蛊毒，去邪毒结气，止痛除热，平主见鬼精物，多食令人狂走。久服，轻身通神明。生川谷。"}]},{"ID":"20240617083437-g8nhghl","Type":"NodeParagraph","Properties":{"id":"20240617083437-g8nhghl","updated":"20240617083437"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：云实，一名员实，一名天豆，神农辛小温，黄帝咸，雷公苦，叶如麻，两两相值，高四五尺，大茎空中，六月花，八月九月实，十月采（《御览》）。"}]},{"ID":"20240617083437-9hm5oql","Type":"NodeParagraph","Properties":{"id":"20240617083437-9hm5oql","updated":"20240617083437"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名员实，一名云英，一名天豆，生河间，十月采，暴干。案《广雅》云：天豆，云实也。"}]},{"ID":"20240617083610-horq980","Type":"NodeThematicBreak","Properties":{"id":"20240617083610-horq980"}},{"ID":"20240617083612-l3qtxj4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083612-l3qtxj4","updated":"20240617083618"},"Children":[{"Type":"NodeText","Data":"云实《名医别录》"}]},{"ID":"20240617083612-9s7ljp8","Type":"NodeParagraph","Properties":{"id":"20240617083612-9s7ljp8","updated":"20240617083612"},"Children":[{"Type":"NodeText","Data":"味苦，无毒．主治消渴．花，杀精物，下水，烧之致鬼．久服益寿．一名员实，一名英，一名天豆．生河间．十月采，曝干．"}]},{"ID":"20240617083612-bufackn","Type":"NodeParagraph","Properties":{"id":"20240617083612-bufackn","updated":"20240617083809"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶云实，味辛，温．主泄利肠 ，杀虫盅毒，去邪恶结气，止痛，除寒热．"}]},{"ID":"20240617083528-tqj50vx","Type":"NodeThematicBreak","Properties":{"id":"20240617083528-tqj50vx"}},{"ID":"20240617083529-i9f9mch","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083529-i9f9mch","updated":"20240617083535"},"Children":[{"Type":"NodeText","Data":"云实《证类本草》"}]},{"ID":"20240617083529-7qouuur","Type":"NodeParagraph","Properties":{"id":"20240617083529-7qouuur","updated":"20240617083529"},"Children":[{"Type":"NodeText","Data":"味辛、苦，温，无毒。主泄痢肠 ，杀虫蛊毒，去邪恶结气，止痛，除寒热，消渴。"}]},{"ID":"20240617083529-8vd4sr0","Type":"NodeParagraph","Properties":{"id":"20240617083529-8vd4sr0","updated":"20240617083529"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"主见鬼精物，多食令人狂走，杀精物，下水。烧之致鬼。久服轻身通神明，益寿。一名陶隐居云∶今处处有。子细如葶苈子而小黑，其实亦类莨菪。烧之致鬼，未见其法术。"}]},{"ID":"20240617083529-1vwpd8u","Type":"NodeParagraph","Properties":{"id":"20240617083529-1vwpd8u","updated":"20240617083529"},"Children":[{"Type":"NodeText","Data":"唐本注云∶云实大如黍及大麻子等，黄黑似豆，故名天豆。丛生泽旁，高五、六尺。叶如细槐，亦如苜蓿。枝间微刺。俗谓苗为草云母。陶云似葶苈，非也。臣禹锡等谨按蜀本图经云∶叶似细槐，花黄白。其荚如大豆，实青黄色，大若麻子。今所在平泽中有。五月、六月采实。"}]},{"ID":"20240617083529-rnh0fmg","Type":"NodeParagraph","Properties":{"id":"20240617083529-rnh0fmg","updated":"20240617083529"},"Children":[{"Type":"NodeText","Data":"图经曰∶云实，生河间川谷。高五、六尺，叶如槐而狭长，枝上有刺。苗名臭草，又名羊石子草。花黄白色，实若麻子大，黄黑色，俗名马豆。十月采，曝干用。今三月、四月采苗，五月、六月采实，实过时即枯落。治疟药中多用之。"}]},{"ID":"20240617083529-afay0iq","Type":"NodeParagraph","Properties":{"id":"20240617083529-afay0iq","updated":"20240617083529"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，采得后粗捣，相对拌浑颗橡实，蒸一日后出用。"}]},{"ID":"20240617083600-7xjop0y","Type":"NodeThematicBreak","Properties":{"id":"20240617083600-7xjop0y"}},{"ID":"20240617083601-t3zwpfb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083601-t3zwpfb","updated":"20240617083605"},"Children":[{"Type":"NodeText","Data":"云实《医学入门》"}]},{"ID":"20240617083601-jiiwc0g","Type":"NodeParagraph","Properties":{"id":"20240617083601-jiiwc0g","updated":"20240617083601"},"Children":[{"Type":"NodeText","Data":"俗呼马豆。川谷处处有之。丛生，叶如细槐，枝间微刺，花黄白，荚中子大如麻子，黄黑色。味辛、苦，温，无毒。主泄痢肠 ，杀蛊毒，去邪恶结气，止痛，除寒热消渴，治疟药中多用之。五月采，和豫实蒸一日，晒干用。"}]},{"ID":"20240617083549-vr79017","Type":"NodeThematicBreak","Properties":{"id":"20240617083549-vr79017"}},{"ID":"20240617083550-5hgpz3s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083550-5hgpz3s","updated":"20240617083556"},"Children":[{"Type":"NodeText","Data":"云实《本草图经》"}]},{"ID":"20240617083550-mg7fbkk","Type":"NodeParagraph","Properties":{"id":"20240617083550-mg7fbkk","updated":"20240617083553"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"云实"},{"Type":"NodeText","Data":"，生河间川谷。高五、六尺，叶如槐而狭长，枝上有刺。苗名臭草，又名羊石子草。花黄白色，实若麻子大，黄黑色，俗名马豆。十月采，曝干用。今三月、四月采苗；五月、六月采实，实过时即枯落。治疟药中多用之。"}]},{"ID":"20240617083539-8wo9tw0","Type":"NodeThematicBreak","Properties":{"id":"20240617083539-8wo9tw0"}},{"ID":"20240617083540-qr91d5v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083540-qr91d5v","updated":"20240617083544"},"Children":[{"Type":"NodeText","Data":"云实《濒湖炮炙法》"}]},{"ID":"20240617083540-3i7qb0s","Type":"NodeParagraph","Properties":{"id":"20240617083540-3i7qb0s","updated":"20240617083540"},"Children":[{"Type":"NodeText","Data":"〔曰〕凡采得，粗捣，相对拌浑颗橡实，蒸一日，拣出曝干。"}]},{"ID":"20240617083503-xjl32ie","Type":"NodeThematicBreak","Properties":{"id":"20240617083503-xjl32ie"}},{"ID":"20240617083504-nzsb2va","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083504-nzsb2va","updated":"20240617083508"},"Children":[{"Type":"NodeText","Data":"云实《千金翼方》"}]},{"ID":"20240617083504-8uzognp","Type":"NodeParagraph","Properties":{"id":"20240617083504-8uzognp","updated":"20240617083504"},"Children":[{"Type":"NodeText","Data":"味辛苦，温，无毒。主泻痢肠 ，杀蛊毒。去邪恶结气，止痛，除寒热，消渴。"}]},{"ID":"20240617083504-mkho6iu","Type":"NodeParagraph","Properties":{"id":"20240617083504-mkho6iu","updated":"20240617083504"},"Children":[{"Type":"NodeText","Data":"见鬼精物，多食令人狂走。杀精物，下水，烧之致鬼。久服轻身，通神明，益寿。一名员实，一名云英，一名夭豆。生河间川谷，十月采，曝干。"}]},{"ID":"20240617083513-250cr9w","Type":"NodeThematicBreak","Properties":{"id":"20240617083513-250cr9w"}},{"ID":"20240617083514-99tln63","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083514-99tln63","updated":"20240617083519"},"Children":[{"Type":"NodeText","Data":"云实《神农本草经赞》"}]},{"ID":"20240617083514-uzfyyje","Type":"NodeParagraph","Properties":{"id":"20240617083514-uzfyyje","updated":"20240617083514"},"Children":[{"Type":"NodeText","Data":"味辛温。主泄利肠。杀虫蛊毒。去邪恶结气。止痛除热。华。主见鬼精物。多食令人狂走。久服轻身通神明。生川谷。"}]},{"ID":"20240617083514-evyef5y","Type":"NodeParagraph","Properties":{"id":"20240617083514-evyef5y","updated":"20240617083514"},"Children":[{"Type":"NodeText","Data":"绿荚黄华。实蕃平泽。粘刺空中。高丛累尺。坚裹纹斑。醒含粒白。祝哽根。声通嗌。"}]},{"ID":"20240617083514-asctf4i","Type":"NodeParagraph","Properties":{"id":"20240617083514-asctf4i","updated":"20240617083514"},"Children":[{"Type":"NodeText","Data":"李时珍曰。三月开黄花。荚长三寸许。有子五六粒。黄黑斑纹。浓壳白仁。极坚有腥气。"}]},{"ID":"20240617083514-tiqxc76","Type":"NodeParagraph","Properties":{"id":"20240617083514-tiqxc76","updated":"20240617083514"},"Children":[{"Type":"NodeText","Data":"茎中空有刺。韩保升曰。所在平泽有之。苏恭曰。丛生高五六尺。后汉书纪。祝哽在前陈旅吟。根蔫鲜玉生汗。方言。嗌。噎也。李时珍曰。根治骨哽及喉痛。"}]},{"ID":"20240617083446-yuwmnqb","Type":"NodeThematicBreak","Properties":{"id":"20240617083446-yuwmnqb"}},{"ID":"20240617083447-9qoa0o2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617083447-9qoa0o2","updated":"20240617083455"},"Children":[{"Type":"NodeText","Data":"云实《新修本草》"}]},{"ID":"20240617083447-0ht8v9m","Type":"NodeParagraph","Properties":{"id":"20240617083447-0ht8v9m","updated":"20240617083447"},"Children":[{"Type":"NodeText","Data":"味辛、苦，温，无毒。主泄痢肠 ，杀虫蛊毒，去邪恶结气，止痛，除寒热。消渴。花，主见鬼精物，多食令人狂走。杀精物，下水，烧之致鬼。久服轻身，通神明，益寿。一名员实，一名云英，一名天豆。生河间川谷。十月采，曝干。"}]},{"ID":"20240617083447-l8m2072","Type":"NodeParagraph","Properties":{"id":"20240617083447-l8m2072","updated":"20240617083447"},"Children":[{"Type":"NodeText","Data":"今处处有，子细如葶苈子而小黑，其实亦类莨菪。烧之致鬼，未见其法术。"}]},{"ID":"20240617083447-nxyfk5e","Type":"NodeParagraph","Properties":{"id":"20240617083447-nxyfk5e","updated":"20240617083447"},"Children":[{"Type":"NodeText","Data":"〔谨案〕云实，大如黍及大麻子等，黄墨似豆，故名天豆。丛生泽旁，高五、六尺。叶如细槐，亦如苜蓿，枝间微刺。俗谓苗为草云母。陶云似葶苈，非也。"}]},{"ID":"20240607132307-k3tb06k","Type":"NodeThematicBreak","Properties":{"id":"20240607132307-k3tb06k"}},{"ID":"20240607132314-ow91sx2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132314-ow91sx2","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：云实"}]},{"ID":"20240607132314-2e5jq9s","Type":"NodeParagraph","Properties":{"id":"20240607132314-2e5jq9s","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607132314-8vgd1oi","Type":"NodeParagraph","Properties":{"id":"20240607132314-8vgd1oi","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" Yún Shí"}]},{"ID":"20240607132314-m3offgl","Type":"NodeParagraph","Properties":{"id":"20240607132314-m3offgl","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607132314-va84mn9","Type":"NodeParagraph","Properties":{"id":"20240607132314-va84mn9","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 百鸟不停、老虎刺尖、到钩刺、黄牛刺、马豆、牛王刺、药王子"}]},{"ID":"20240607132314-ojhgilk","Type":"NodeParagraph","Properties":{"id":"20240607132314-ojhgilk","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607132314-3zv80wx","Type":"NodeParagraph","Properties":{"id":"20240607132314-3zv80wx","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 为豆科云实属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"云实"},{"Type":"NodeText","Data":"Caesalpinis scpiaria Roxb.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。栽后4～5年采收，秋冬挖根，洗净切斜片，晒干或炕干；秋季采果实，除去果皮，取种子晒干。"}]},{"ID":"20240607132314-8kkn77f","Type":"NodeParagraph","Properties":{"id":"20240607132314-8kkn77f","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607132314-ye9ealc","Type":"NodeParagraph","Properties":{"id":"20240607132314-ye9ealc","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 攀援灌木，长3～4米，幼枝密被棕色短柔毛，老即脱落，刺多倒钩状，淡棕红色。二回羽状复叶互生。春末开花，总状花序侧生，花冠黄色，有光泽。荚果长椭圆形，偏斜，长6～12厘米，有喙，沿腹缝有宽约3～4毫米的窄翅。种子6～9粒，矩形，黑棕色。"}]},{"ID":"20240607132314-wvu88e7","Type":"NodeParagraph","Properties":{"id":"20240607132314-wvu88e7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607132314-j33krx8","Type":"NodeParagraph","Properties":{"id":"20240607132314-j33krx8","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 辛，温。种子有毒。"}]},{"ID":"20240607132314-po1dgfg","Type":"NodeParagraph","Properties":{"id":"20240607132314-po1dgfg","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607132314-fbaelu8","Type":"NodeParagraph","Properties":{"id":"20240607132314-fbaelu8","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 种子：止痢，驱虫。用于痢疾，钩虫病，蛔虫病。根：发表散寒，祛风活络。用于风寒感冒，风湿疼痛，跌打损伤，蛇咬伤。"}]},{"ID":"20240607132314-d8buddb","Type":"NodeParagraph","Properties":{"id":"20240607132314-d8buddb","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607132314-p5kwmix","Type":"NodeParagraph","Properties":{"id":"20240607132314-p5kwmix","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 种子1～3钱；根0.5～1两。水煎或泡酒服。"}]},{"ID":"20240607132314-dogl94a","Type":"NodeParagraph","Properties":{"id":"20240607132314-dogl94a","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607132314-jhcvqcu","Type":"NodeParagraph","Properties":{"id":"20240607132314-jhcvqcu","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607132314-pr6ar0d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132314-pr6ar0d","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：云实"}]},{"ID":"20240607132314-ej3peyh","Type":"NodeParagraph","Properties":{"id":"20240607132314-ej3peyh","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607132314-e905y2z","Type":"NodeParagraph","Properties":{"id":"20240607132314-e905y2z","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" Yún Shí"}]},{"ID":"20240607132314-mtksmgz","Type":"NodeParagraph","Properties":{"id":"20240607132314-mtksmgz","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607132314-4ug6zj7","Type":"NodeParagraph","Properties":{"id":"20240607132314-4ug6zj7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 马豆（《本草图经》）。"}]},{"ID":"20240607132314-bdgyzh0","Type":"NodeParagraph","Properties":{"id":"20240607132314-bdgyzh0","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607132314-yj9iazy","Type":"NodeParagraph","Properties":{"id":"20240607132314-yj9iazy","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607132314-y8u1cz9","Type":"NodeParagraph","Properties":{"id":"20240607132314-y8u1cz9","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607132314-858ucej","Type":"NodeParagraph","Properties":{"id":"20240607132314-858ucej","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"云实"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240607132314-g00epu1","Type":"NodeParagraph","Properties":{"id":"20240607132314-g00epu1","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607132314-7f3ch77","Type":"NodeParagraph","Properties":{"id":"20240607132314-7f3ch77","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 生长于平原、丘陵地、山谷及河边。分布广东、广西、湖南、湖北、云南、贵州、四川、福建、浙江、江苏、安徽、江西等地。"}]},{"ID":"20240607132314-0oqb4gc","Type":"NodeParagraph","Properties":{"id":"20240607132314-0oqb4gc","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607132314-1wd3di1","Type":"NodeParagraph","Properties":{"id":"20240607132314-1wd3di1","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 云实，又名：员实、天豆（《吴普本草》），云英（《别录》），草云母（《唐本草》），臭草、羊石子草（《本草图经》），老虎刺尖（《滇南本草》），杉刺（《纲目》），水皂角（《植物名实图考》），阎王刺、牛王茨、药王子、铁场豆、猫爪刺、倒挂刺、鸟不落、黄牛刺、蛇不过、芽皮刀、百鸟不宿、鸟不栖、黄花刺、红总管、翻天云、刺皂角、拦蛇刺、小霸王。"}]},{"ID":"20240607132314-elz04k8","Type":"NodeParagraph","Properties":{"id":"20240607132314-elz04k8","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"攀援灌木，具散生钩刺。2回羽状复时，长20～30厘米，羽片3～10对，有柄；每羽片有小叶12～24片，膜质，长圆形，长10～25毫米，宽6～10毫米，基部钝，先端近圆形，两边均被短柔毛，老时毛脱落；托叶阔，半边箭头状，早落或缺。总状花序，长15～30厘米；花左右对称，亮黄色；花梗长2～4厘米，劲直，萼下具关节，花易脱落；萼片5，被短柔毛；花瓣5，膜质，圆形或倒卵形；雄蕊10，分离，花丝中部以下密生茸毛；子房上位，，室，有胚珠数颗。荚果近木质，短舌状，偏斜，长6～12厘米，宽2～3厘米，稍膨胀，先端延伸成1刺尖，沿腹缝线膨胀成狭翅，并沿腹缝线开裂，栗色，无毛。种子6～9颗，长圆形，褐色。花、果期4～10月。"}]},{"ID":"20240607132314-uylhl5o","Type":"NodeParagraph","Properties":{"id":"20240607132314-uylhl5o","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"本植物的根或根皮（云实根）、叶（四时青）亦供药用，各详专条。"}]},{"ID":"20240607132314-amgy0fq","Type":"NodeParagraph","Properties":{"id":"20240607132314-amgy0fq","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607132314-z0jyjlq","Type":"NodeParagraph","Properties":{"id":"20240607132314-z0jyjlq","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 《雷公炮炙论》：\"凡使云实，采得后，粗捣，相对拌浑颗橡实，蒸一日后出用。\""}]},{"ID":"20240607132314-o35yy8s","Type":"NodeParagraph","Properties":{"id":"20240607132314-o35yy8s","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607132314-1pydhm3","Type":"NodeParagraph","Properties":{"id":"20240607132314-1pydhm3","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味辛，温。\""}]},{"ID":"20240607132314-2w3h22c","Type":"NodeParagraph","Properties":{"id":"20240607132314-2w3h22c","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"神农：辛，小温。黄帝：咸。雷公：苦。\""}]},{"ID":"20240607132314-384nfcu","Type":"NodeParagraph","Properties":{"id":"20240607132314-384nfcu","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607132314-bu0lll4","Type":"NodeParagraph","Properties":{"id":"20240607132314-bu0lll4","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 清热除湿，杀虫。治痢疾，疟疾，消渴，小儿疳积。"}]},{"ID":"20240607132314-luj3dtt","Type":"NodeParagraph","Properties":{"id":"20240607132314-luj3dtt","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主泄痢肠澼，去邪恶结气，止痛，除寒热。\""}]},{"ID":"20240607132314-4vga7g7","Type":"NodeParagraph","Properties":{"id":"20240607132314-4vga7g7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主消渴。\""}]},{"ID":"20240607132314-xjxaju8","Type":"NodeParagraph","Properties":{"id":"20240607132314-xjxaju8","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"③《本草图经》：\"治疟药中多用之。\""}]},{"ID":"20240607132314-47074vp","Type":"NodeParagraph","Properties":{"id":"20240607132314-47074vp","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"主下匿脓血。\""}]},{"ID":"20240607132314-00n64qx","Type":"NodeParagraph","Properties":{"id":"20240607132314-00n64qx","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"⑤《温岭县药物资源名录》：\"杀虫，除湿热。治小儿疳积，麻疹不透；妇女乳痈。\""}]},{"ID":"20240607132314-psi4c09","Type":"NodeParagraph","Properties":{"id":"20240607132314-psi4c09","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607132314-utts1ar","Type":"NodeParagraph","Properties":{"id":"20240607132314-utts1ar","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5饯：或入丸剂。"}]},{"ID":"20240607132314-iga7t34","Type":"NodeParagraph","Properties":{"id":"20240607132314-iga7t34","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607132314-xc92kok","Type":"NodeParagraph","Properties":{"id":"20240607132314-xc92kok","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" ①治疟疾：云实三钱，水煎服。（江西《草药手册》）"}]},{"ID":"20240607132314-s9awe4l","Type":"NodeParagraph","Properties":{"id":"20240607132314-s9awe4l","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"②治痢疾：阎王刺种子三钱炒焦，红糖五钱。水煎服。（《贵州草药》）"}]},{"ID":"20240607132314-od1sotc","Type":"NodeParagraph","Properties":{"id":"20240607132314-od1sotc","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"③治匿下不止者：鸟头二两，女荽、云实各一两，桂三分。蜜丸如桐子，水服五丸，一日三服。（《补缺肘后力》）"}]},{"ID":"20240607132314-cc22jrd","Type":"NodeParagraph","Properties":{"id":"20240607132314-cc22jrd","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607132314-yv3zgte","Type":"NodeParagraph","Properties":{"id":"20240607132314-yv3zgte","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607132314-scy7km3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607132314-scy7km3","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"《中华本草》：云实"}]},{"ID":"20240607132314-n94vqr1","Type":"NodeParagraph","Properties":{"id":"20240607132314-n94vqr1","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607132314-6rjuftc","Type":"NodeParagraph","Properties":{"id":"20240607132314-6rjuftc","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" Yún Shí"}]},{"ID":"20240607132314-n1pg8wt","Type":"NodeParagraph","Properties":{"id":"20240607132314-n1pg8wt","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607132314-5zhn916","Type":"NodeParagraph","Properties":{"id":"20240607132314-5zhn916","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 员实、天豆、马豆、朝天子、药王子、云实子、云实籽、铁场豆"}]},{"ID":"20240607132314-pwc0mh2","Type":"NodeParagraph","Properties":{"id":"20240607132314-pwc0mh2","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607132314-h91zys8","Type":"NodeParagraph","Properties":{"id":"20240607132314-h91zys8","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" Seed of Mysorethorn"}]},{"ID":"20240607132314-n77zqa1","Type":"NodeParagraph","Properties":{"id":"20240607132314-n77zqa1","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607132314-c4ap4j5","Type":"NodeParagraph","Properties":{"id":"20240607132314-c4ap4j5","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240607132314-aar6c6g","Type":"NodeParagraph","Properties":{"id":"20240607132314-aar6c6g","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607132314-ric094h","Type":"NodeParagraph","Properties":{"id":"20240607132314-ric094h","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物云实的种子。"}]},{"ID":"20240607132314-00usrza","Type":"NodeParagraph","Properties":{"id":"20240607132314-00usrza","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Caesalpinia decapetala(Roth)Alston[Reichrdia decapetala Roth;Caesalpinia sepiaria Roxb.]"}]},{"ID":"20240607132314-zs0o6ce","Type":"NodeParagraph","Properties":{"id":"20240607132314-zs0o6ce","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季果实成熟时采收，剥取种子，晒干。"}]},{"ID":"20240607132314-mn887bq","Type":"NodeParagraph","Properties":{"id":"20240607132314-mn887bq","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607132314-1lnzyyt","Type":"NodeParagraph","Properties":{"id":"20240607132314-1lnzyyt","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于平原、丘陵地、山谷及河边。"}]},{"ID":"20240607132314-v7z225v","Type":"NodeParagraph","Properties":{"id":"20240607132314-v7z225v","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、中南、西南及河北、陕西、甘肃。"}]},{"ID":"20240607132314-2bb7gzh","Type":"NodeParagraph","Properties":{"id":"20240607132314-2bb7gzh","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607132314-6h7o5lp","Type":"NodeParagraph","Properties":{"id":"20240607132314-6h7o5lp","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 云实 攀援灌木。树皮暗红色，密生倒钩刺。托叶阔，半边箭头状，早落；二回羽状复叶，长20-30cm，羽片3-10对，对生，有柄，基部有刺1对，每羽片有小叶7-15对，膜质，长圆形，长10-25mm，宽6-10mm，先端圆，微缺，基部钝，两边均被短柔毛，有时毛脱落。总状花序顶生，长15-30cm；总花梗多刺；花左右对称，花梗长2-4cm，劲直，萼下具关节，花易脱落；萼片5，长圆形，被短柔毛；花瓣5，黄色，盛开时反卷；雄蕊10，分离，花丝中部以下密生茸毛；子房上位，无毛。荚果近木质，短舌状，偏斜，长6-12cm，宽2-3cm，稍膨胀，先端具尖喙，沿腹缝线膨大成狭翅，成熟时沿腹缝开裂，无毛，栗褐色，有光泽；种子6-9颗，长圆形，褐色。花、果期4-10月。"}]},{"ID":"20240607132314-8d6lhyh","Type":"NodeParagraph","Properties":{"id":"20240607132314-8d6lhyh","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607132314-mdpu0oo","Type":"NodeParagraph","Properties":{"id":"20240607132314-mdpu0oo","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：喜温暖向阳，以排水良好、土层深厚的砂质壤土较好。亦可在河边、林边或作篱笆栽培。"}]},{"ID":"20240607132314-me3czjv","Type":"NodeParagraph","Properties":{"id":"20240607132314-me3czjv","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"2.种植：用种子繁殖，育苗移栽。四川地区3-4月育苗、先把种子浸泡2-3天，然后播种。在整好的土地上，开1.3m宽的高畦，按沟心距24-30cm开横沟，深3-6cm，每沟播40-50粒，每亩用种子15-20斤，施人畜粪水，盖草木灰1cm厚，最后覆土与畦面平。10月左右挖苗移栽，在选好的土地上，按行株距各1m开穴，穴深12-18cm。每穴栽1-2株，盖土压紧，再盖土与畦面平，最后浇水定根。"}]},{"ID":"20240607132314-fo4788v","Type":"NodeParagraph","Properties":{"id":"20240607132314-fo4788v","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"3.：幼苗出土后，施清淡人粪尿提苗，以后勤除杂草；移栽后第2年当新芽发出时，施人畜粪水，促使生长。"}]},{"ID":"20240607132314-8phxer7","Type":"NodeParagraph","Properties":{"id":"20240607132314-8phxer7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607132314-wsexriy","Type":"NodeParagraph","Properties":{"id":"20240607132314-wsexriy","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 种子长圆形，长约1cm，宽约6mm。外皮棕黑色，有纵向灰黄色纹理及横向裂缝状环圈。种皮坚硬，剥开后，内有棕黄色子叶2枚。气微，味苦。"}]},{"ID":"20240607132314-vq5tg7y","Type":"NodeParagraph","Properties":{"id":"20240607132314-vq5tg7y","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607132314-i0a8b9v","Type":"NodeParagraph","Properties":{"id":"20240607132314-i0a8b9v","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 种子含油量35%，油色金黄。果实含鞣质30-40%。"}]},{"ID":"20240607132314-qkqrq30","Type":"NodeParagraph","Properties":{"id":"20240607132314-qkqrq30","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607132314-opdy9y7","Type":"NodeParagraph","Properties":{"id":"20240607132314-opdy9y7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 1.止咳、祛痰与平喘作用：小鼠腹腔注射其水煎液（台州产）2g/kg能明显延长咳嗽潜伏期，诸暨产者效果很差（二氧化硫引咳法）。小鼠口服其水煎液60g/kg或腹腔注射2g/kg能显着增加呼吸道酚红排出量；诸暨产者不论口服或腹腔注射均无效（酚红法）。豚鼠口服水煎剂（诸暨产）60g/kg无平喘作用（组织胺喷雾引喘法）。"}]},{"ID":"20240607132314-vktw5u7","Type":"NodeParagraph","Properties":{"id":"20240607132314-vktw5u7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"2.抑菌作用：水煎液（台州产）1：256浓度时，对金黄色葡萄球菌有抑菌作用。同属植物大托叶云实Caesalpiniabonducella的酒精提取物对麻醉狗有降压作用，水提取物在同剂量时则无影响；前者对在位蛙心有抑制作用并减少收缩幅度，后者作用相似但较弱。二者对化脓性球菌、大肠杆菌、某些痢疾杆菌有抗菌作用。"}]},{"ID":"20240607132314-j6908ye","Type":"NodeParagraph","Properties":{"id":"20240607132314-j6908ye","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607132314-mf481l0","Type":"NodeParagraph","Properties":{"id":"20240607132314-mf481l0","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 《雷公炮炙论》：凡使云实，采得后，粗捣，相对拌浑颗橡实，蒸一日后出用。"}]},{"ID":"20240607132314-g03w2jq","Type":"NodeParagraph","Properties":{"id":"20240607132314-g03w2jq","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607132314-3szegrg","Type":"NodeParagraph","Properties":{"id":"20240607132314-3szegrg","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 肺；大肠经"}]},{"ID":"20240607132314-5fxsqm6","Type":"NodeParagraph","Properties":{"id":"20240607132314-5fxsqm6","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607132314-j6ndd3n","Type":"NodeParagraph","Properties":{"id":"20240607132314-j6ndd3n","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 辛；苦；温"}]},{"ID":"20240607132314-7gs06x5","Type":"NodeParagraph","Properties":{"id":"20240607132314-7gs06x5","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607132314-zmirn8y","Type":"NodeParagraph","Properties":{"id":"20240607132314-zmirn8y","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 解毒除湿，止咳化痰，杀虫。主痢疾，疟疾慢性气管炎，小儿疳积，虫积"}]},{"ID":"20240607132314-jv9g7j6","Type":"NodeParagraph","Properties":{"id":"20240607132314-jv9g7j6","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607132314-dgpl8fu","Type":"NodeParagraph","Properties":{"id":"20240607132314-dgpl8fu","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g；或入丸、散。"}]},{"ID":"20240607132314-r6rkjhc","Type":"NodeParagraph","Properties":{"id":"20240607132314-r6rkjhc","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607132314-aft7hk7","Type":"NodeParagraph","Properties":{"id":"20240607132314-aft7hk7","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主泄痢肠澼，去邪恶结气，止痛，除寒热。"}]},{"ID":"20240607132314-r5qx3rm","Type":"NodeParagraph","Properties":{"id":"20240607132314-r5qx3rm","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主消渴。"}]},{"ID":"20240607132314-xvmte1x","Type":"NodeParagraph","Properties":{"id":"20240607132314-xvmte1x","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：治疟药中多用之。"}]},{"ID":"20240607132314-k4yfr3s","Type":"NodeParagraph","Properties":{"id":"20240607132314-k4yfr3s","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：主下NI脓血。"}]},{"ID":"20240607132314-aur406v","Type":"NodeParagraph","Properties":{"id":"20240607132314-aur406v","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"5.《温岭县药物资源名录》：杀虫，除湿热。治小儿疳积，麻疹不透：妇女乳痈。"}]},{"ID":"20240607132314-bkinc73","Type":"NodeParagraph","Properties":{"id":"20240607132314-bkinc73","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607132314-uqdlcwj","Type":"NodeParagraph","Properties":{"id":"20240607132314-uqdlcwj","updated":"20240607132314"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607132317-1bqighe","Type":"NodeThematicBreak","Properties":{"id":"20240607132317-1bqighe"}},{"ID":"20240607132318-uqmmob6","Type":"NodeParagraph","Properties":{"id":"20240607132318-uqmmob6"}}]}