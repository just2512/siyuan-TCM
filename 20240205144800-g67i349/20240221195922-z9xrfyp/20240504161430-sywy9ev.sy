{"ID":"20240504161430-sywy9ev","Spec":"1","Type":"NodeDocument","Properties":{"id":"20240504161430-sywy9ev","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504161430-sywy9ev\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240620154737-5lna5ed\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607143043-45t7h9y\u0026quot;,\u0026quot;scrollTop\u0026quot;:1555,\u0026quot;focusId\u0026quot;:\u0026quot;20240620155701-ncb9k9f\u0026quot;,\u0026quot;focusStart\u0026quot;:5,\u0026quot;focusEnd\u0026quot;:5\u0026#125;","title":"102干漆","type":"doc","updated":"20240809134302"},"Children":[{"ID":"20240620154737-5lna5ed","Type":"NodeParagraph","Properties":{"id":"20240620154737-5lna5ed","updated":"20240620154756"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 397px;","style":"width: 387px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620154756-4ix3dbe.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 387px;\" parent-style=\"width: 397px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240620155217-i77w7ar","Type":"NodeParagraph","Properties":{"id":"20240620155217-i77w7ar","updated":"20240809113651"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 359px;","style":"width: 349px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"158227918_45_20190407111608550"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/158227918_45_20190407111608550-20240221194612-gs5qigk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 349px;\" parent-style=\"width: 359px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 443px;","style":"width: 433px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树-20240620154502-rl5kur3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 433px;\" parent-style=\"width: 443px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 334px;","style":"width: 324px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树2-20240620155146-46zktre.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 324px;\" parent-style=\"width: 334px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809113955-tyr73a6","Type":"NodeParagraph","Properties":{"id":"20240809113955-tyr73a6","updated":"20240809113955"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 734px;","style":"width: 724px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树 1-20240809113955-yvtj5j9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 724px;\" parent-style=\"width: 734px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 453px;","style":"width: 443px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树-20240809113908-02dydbt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: