es":{"parent-style":"width: 341px;","style":"width: 331px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620160248-n7d1yke.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 331px;\" parent-style=\"width: 341px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 758px;","style":"width: 748px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树 5-20240716123859-xqy1koo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 748px;\" parent-style=\"width: 758px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809114146-gcgmtw0","Type":"NodeParagraph","Properties":{"id":"20240809114146-gcgmtw0","updated":"20240809115300"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 372px;","style":"width: 362px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树 2-20240809114146-qvfnagq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 362px;\" parent-style=\"width: 372px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 719px;","style":"width: 709px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"漆树 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/漆树 9-20240716124726-z512vul.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 709px;\" parent-style=\"width: 719px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809115413-j0h5236","Type":"NodeParagraph","Properties":{"id":"20240809115413-j0h5236","updated":"20240809134302"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：漆树种类较多，以上取图未按品种分类；"}]},{"ID":"20240620154811-67luhsu","Type":"NodeParagraph","Properties":{"id":"20240620154811-67luhsu","updated":"20240809115411"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：干漆来源于漆树科植物漆树的树脂经加工后的干燥品。"}]},{"ID":"20240716124041-9u1r6ze","Type":"NodeParagraph","Properties":{"id":"20240716124041-9u1r6ze","updated":"20240809115412"},"Children":[{"Type":"NodeText","Data":"三"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：漆树是雌雄异株的植物，广泛分布于中国热带、亚热带和温带地区。它的叶子形状很像一片羽毛，叶片呈左右相对螺旋互生状态生长，在顶端又会多生出一片叶子，总数永远为奇数，因此又叫做奇数羽状复叶。"}]},{"ID":"20240607143325-eaoyxvf","Type":"NodeThematicBreak","Properties":{"id":"20240607143325-eaoyxvf"}},{"ID":"20240607143329-uog1rck","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143329-uog1rck","updated":"20240607143335"},"Children":[{"Type":"NodeText","Data":"干漆《神农本草经》"}]},{"ID":"20240607143329-14sff4v","Type":"NodeParagraph","Properties":{"id":"20240607143329-14sff4v","updated":"20240607143329"},"Children":[{"Type":"NodeText","Data":"味辛温无毒。"}]},{"ID":"20240607143329-983qbjh","Type":"NodeParagraph","Properties":{"id":"20240607143329-983qbjh","updated":"20240607143329"},"Children":[{"Type":"NodeText","Data":"主绝伤补中，续筋骨填髓脑，安五藏，五缓六急，风寒湿痹，生漆去长虫。久服轻身耐老。生川谷。"}]},{"ID":"20240607143329-j2h2yek","Type":"NodeParagraph","Properties":{"id":"20240607143329-j2h2yek","updated":"20240607143329"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汉中，夏至后采，干之。"}]},{"ID":"20240607143329-go2cwly","Type":"NodeParagraph","Properties":{"id":"20240607143329-go2cwly","updated":"20240607143329"},"Children":[{"Type":"NodeText","Data":"案《说文》云：桼木汁可以物，象形，如水滴而下，以漆为漆水字；《周礼》载师云：漆林之征，郑元云：故书漆林为桼林；杜子春云：当为漆林。"}]},{"ID":"20240617105046-73pzwdf","Type":"NodeThematicBreak","Properties":{"id":"20240617105046-73pzwdf"}},{"ID":"20240617105047-gj8y5va","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105047-gj8y5va","updated":"20240617105051"},"Children":[{"Type":"NodeText","Data":"干漆《新修本草》"}]},{"ID":"20240617105047-5ukuoyx","Type":"NodeParagraph","Properties":{"id":"20240617105047-5ukuoyx","updated":"20240617105047"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒、有毒。主绝伤，补中，续筋骨，填髓脑，安五脏，五缓六急，风寒湿痹，疗咳嗽，消瘀血，痞结，腰痛，女子疝瘕，利小肠，去蛔虫。生漆去长虫。久服轻身能老。生汉中川谷。夏至后采，干之。"}]},{"ID":"20240617105047-0f9rnh9","Type":"NodeParagraph","Properties":{"id":"20240617105047-0f9rnh9","updated":"20240617105113"},"Children":[{"Type":"NodeText","Data":"半夏为之使，畏鸡子，今又忌油脂。今梁州漆最胜，益州亦有，广州漆性急易燥。其诸处漆桶上盖裹，自然有干者，状如蜂房，孔孔隔者为佳。生漆毒烈，人以鸡子白和服之，去虫。犹有啮肠胃者，畏漆人乃致死。外气亦能使身肉疮肿，自别有疗法。仙方用蟹消之为水，炼服长生。"}]},{"ID":"20240607143729-dnh76jp","Type":"NodeThematicBreak","Properties":{"id":"20240607143729-dnh76jp"}},{"ID":"20240607143730-mby076a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143730-mby076a","updated":"20240607143736"},"Children":[{"Type":"NodeText","Data":"干漆《雷公炮制药性解》"}]},{"ID":"20240607143730-b0f2ay8","Type":"NodeParagraph","Properties":{"id":"20240607143730-b0f2ay8","updated":"20240607143730"},"Children":[{"Type":"NodeText","Data":"味辛，性温有毒，入胃大小肠三经。主年深坚结之沉积，日久秘结之瘀血，杀三虫，绝传尸，损咳嗽，止崩漏，除九种心疼，疗风寒湿痹，炒令烟尽用，半夏为使，畏鸡子、油脂、铁浆、黄栌汁、蟹。"}]},{"ID":"20240607143730-bszgh4w","Type":"NodeParagraph","Properties":{"id":"20240607143730-bszgh4w","updated":"20240607143730"},"Children":[{"Type":"NodeText","Data":"按∶干漆专主行化，胃与二肠，宜其入已。然攻坚消积之剂，终损元神，不宜过用。中其毒者，以所畏之物解之。"}]},{"ID":"20240607143807-qc8ib7u","Type":"NodeThematicBreak","Properties":{"id":"20240607143807-qc8ib7u"}},{"ID":"20240607143809-mnrkhn5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143809-mnrkhn5","updated":"20240607143813"},"Children":[{"Type":"NodeText","Data":"干漆《本经逢原》"}]},{"ID":"20240607143809-wac03aa","Type":"NodeParagraph","Properties":{"id":"20240607143809-wac03aa","updated":"20240607143809"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"漆叶漆子"}]},{"ID":"20240607143809-ub65omw","Type":"NodeParagraph","Properties":{"id":"20240607143809-ub65omw","updated":"20240607143809"},"Children":[{"Type":"NodeText","Data":"辛苦咸温有毒。炒令烟尽，否则损人肠胃。今人多用漆渣伪充，必凝结如砖者佳。"}]},{"ID":"20240607143809-x9isb1n","Type":"NodeParagraph","Properties":{"id":"20240607143809-x9isb1n","updated":"20240607143809"},"Children":[{"Type":"NodeText","Data":"《本经》主绝伤，补中续筋骨，填髓脑，安五脏，五缓六急，风寒湿痹。生漆去长虫。"}]},{"ID":"20240607143809-ylfihy0","Type":"NodeParagraph","Properties":{"id":"20240607143809-ylfihy0","updated":"20240607143809"},"Children":[{"Type":"NodeText","Data":"久服轻身耐老。"}]},{"ID":"20240607143809-fluzsoi","Type":"NodeParagraph","Properties":{"id":"20240607143809-fluzsoi","updated":"20240607143809"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"干漆灰辛温，性善下降而破血，故消肿杀虫，通月闭，皆取去恶血之用。而《本经》治绝伤补中，是取其破宿生新之力也。盖胃中有瘀积留滞，则阳气竭绝。不能敷布中外，故脏腑筋骨髓脑皆失营养，乃致健运失常，肢体缓 ，用此以铲除瘀积。中气得复，绝伤皆续，而缓急和矣。生漆去长虫，故《千金》去三虫，方以之为君，三虫去，轻身长年所不待言，但恒人艰于久服耳。元素云，削年深坚结之积滞，破日久凝结之瘀血，斯言尽干漆之用矣。无积血者切忌，以大伤营血。损胃气，故胃虚人服之，往往作呕，此与《本经》之义似乎相背，而实不相违。产后血晕，以旧漆器烧烟薰之即醒。盖亦取下血之义，而破经络中血滞，用真漆涂，鲮鲤甲 入药，破血最捷。妇人血虚、经闭为之切禁。凡畏漆者，嚼椒涂口鼻免生漆疮。误中其毒，以生蟹捣汁或紫苏解之。漆叶涂紫云风，面生紫肿，取其散瘀之功也。漆子专主下血，《千金方》用之。审无瘀滞，慎勿漫投。"}]},{"ID":"20240607143314-ucgx4lr","Type":"NodeThematicBreak","Properties":{"id":"20240607143314-ucgx4lr"}},{"ID":"20240607143317-5n38qxl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143317-5n38qxl","updated":"20240607143322"},"Children":[{"Type":"NodeText","Data":"干漆《神农本草经百种录》"}]},{"ID":"20240607143317-6ro3yg0","Type":"NodeParagraph","Properties":{"id":"20240607143317-6ro3yg0","updated":"20240607143317"},"Children":[{"Type":"NodeText","Data":"味辛温。主绝伤，补中，续筋骨，填髓脑，补续筋骨中之脂膏。安五脏，实脏中之脂膏。五缓六急，调和筋骨。风寒湿痹，漆得寒反坚，得湿反燥，故能除寒热也。生漆去长虫。生漆着人肌肤即腐烂，故亦能腐虫。久服，轻身耐老。漆入地不朽，其质耐久，故有此效。"}]},{"ID":"20240607143317-b99lhuq","Type":"NodeParagraph","Properties":{"id":"20240607143317-b99lhuq","updated":"20240607143317"},"Children":[{"Type":"NodeText","Data":"此以质为治。漆，树脂也。凡草木之服最韧而不朽者，莫如漆。人身中非气非血而能充养筋骨者，皆脂膏也。气血皆有补法，而脂膏独无补法，则以树之脂膏力最浓者补之。而脂膏之中，凡风寒湿热之邪，留而不去者，得其气以相助，亦并能驱而涤之也。"}]},{"ID":"20240607143257-fuw9my4","Type":"NodeThematicBreak","Properties":{"id":"20240607143257-fuw9my4"}},{"ID":"20240607143348-ap54861","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143348-ap54861","updated":"20240607143355"},"Children":[{"Type":"NodeText","Data":"干漆《名医别录》"}]},{"ID":"20240607143348-gst1539","Type":"NodeParagraph","Properties":{"id":"20240607143348-gst1539","updated":"20240607143348"},"Children":[{"Type":"NodeText","Data":"有毒．主治咳嗽，消瘀血，痞结，腰痛，女子疝瘕，利小肠，去蛔虫．生汉中．夏采，干之．（半夏为之使，畏鸡子．）"}]},{"ID":"20240607143348-5vgrauh","Type":"NodeParagraph","Properties":{"id":"20240607143348-5vgrauh","updated":"20240607143348"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶干漆，味辛，温，无毒．主绝伤，补中，续筋骨，填髓脑，安五脏，五缓六急，风寒湿痹．"}]},{"ID":"20240617104834-6s20omx","Type":"NodeThematicBreak","Properties":{"id":"20240617104834-6s20omx"}},{"ID":"20240617104835-ob1o7wb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104835-ob1o7wb","updated":"20240617104841"},"Children":[{"Type":"NodeText","Data":"干漆《顾松园医镜》"}]},{"ID":"20240617104835-6fc1zax","Type":"NodeParagraph","Properties":{"id":"20240617104835-6fc1zax","updated":"20240617104835"},"Children":[{"Type":"NodeText","Data":"〔辛温有毒，入肝经。炒至烟尽为度。中其毒者，多食蟹及甘豆汤解之。〕行瘀血之神丹，〔瘀血见之，即化为水。〕杀诸虫之上品。"}]},{"ID":"20240617104835-fpw8bmp","Type":"NodeParagraph","Properties":{"id":"20240617104835-fpw8bmp","updated":"20240617104835"},"Children":[{"Type":"NodeText","Data":"虚者及惯生漆疮者大忌。孕妇戒投。"}]},{"ID":"20240617104845-5ehst26","Type":"NodeThematicBreak","Properties":{"id":"20240617104845-5ehst26"}},{"ID":"20240617104846-0h1ttqq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104846-0h1ttqq","updated":"20240617104849"},"Children":[{"Type":"NodeText","Data":"干漆《长沙药解》"}]},{"ID":"20240617104846-8ce6kht","Type":"NodeParagraph","Properties":{"id":"20240617104846-8ce6kht","updated":"20240617104846"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味辛温无毒。主绝伤补中，续筋骨填髓脑，安五藏，五缓六急，风寒湿痹，生漆去长虫。久服轻身耐老。生川谷。"}]},{"ID":"20240617104846-vonn39x","Type":"NodeParagraph","Properties":{"id":"20240617104846-vonn39x","updated":"20240617104846"},"Children":[{"Type":"NodeText","Data":"味辛，入足厥阴肝经。专通经脉，善破瘕癥。"}]},{"ID":"20240617104846-62vxcg1","Type":"NodeParagraph","Properties":{"id":"20240617104846-62vxcg1","updated":"20240617104846"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄（庶/虫）虫丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治虚劳腹满，内有干血，以其化坚癥而破干血也。"}]},{"ID":"20240617104846-zz2irss","Type":"NodeParagraph","Properties":{"id":"20240617104846-zz2irss","updated":"20240617104846"},"Children":[{"Type":"NodeText","Data":"干漆辛烈之性，善破瘀血，其力甚捷。而尤杀诸虫，肝气遏抑，血瘀虫化者宜之。"}]},{"ID":"20240617104846-ivm9yeu","Type":"NodeParagraph","Properties":{"id":"20240617104846-ivm9yeu","updated":"20240617104846"},"Children":[{"Type":"NodeText","Data":"炒枯存性，研细。"}]},{"ID":"20240617104932-iif81vm","Type":"NodeThematicBreak","Properties":{"id":"20240617104932-iif81vm"}},{"ID":"20240617104933-t0l4sa2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104933-t0l4sa2","updated":"20240617104938"},"Children":[{"Type":"NodeText","Data":"干漆《本草分经》"}]},{"ID":"20240617104933-opm5b3r","Type":"NodeParagraph","Properties":{"id":"20240617104933-opm5b3r","updated":"20240617104933"},"Children":[{"Type":"NodeText","Data":"辛温毒烈，功专行血杀虫，破年深积滞瘀血，炒至烟尽用，得蟹则成水。"}]},{"ID":"20240617104953-ddkk9l9","Type":"NodeThematicBreak","Properties":{"id":"20240617104953-ddkk9l9"}},{"ID":"20240617104954-vyd02u3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104954-vyd02u3","updated":"20240617104958"},"Children":[{"Type":"NodeText","Data":"干漆《本草衍义》"}]},{"ID":"20240617104954-wf0gblm","Type":"NodeParagraph","Properties":{"id":"20240617104954-wf0gblm","updated":"20240617104954"},"Children":[{"Type":"NodeText","Data":"若湿漆，药中未见用。凡用者，皆干漆耳。其湿者，在燥热及霜冷时则难干，得阴湿，虽寒月亦易干。亦物之性也。若沾渍人，以油治之。凡验漆，惟稀者以物蘸起细而不断，断而急收起，又涂于干竹上，荫之速干者，并佳。余如经。"}]},{"ID":"20240617105018-1lp0ahn","Type":"NodeThematicBreak","Properties":{"id":"20240617105018-1lp0ahn"}},{"ID":"20240617105019-njccj4l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105019-njccj4l","updated":"20240617105024"},"Children":[{"Type":"NodeText","Data":"干漆《本草乘雅半偈》"}]},{"ID":"20240617105019-xkwyofy","Type":"NodeParagraph","Properties":{"id":"20240617105019-xkwyofy","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240617105019-1pirgkm","Type":"NodeParagraph","Properties":{"id":"20240617105019-1pirgkm","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"【气味】辛温，无毒。"}]},{"ID":"20240617105019-2ygt5c8","Type":"NodeParagraph","Properties":{"id":"20240617105019-2ygt5c8","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"【主治】主绝伤，补中，续筋骨，填髓脑，安五脏，五缓六急，风寒湿痹。生漆去长虫。"}]},{"ID":"20240617105019-1t1lj2w","Type":"NodeParagraph","Properties":{"id":"20240617105019-1t1lj2w","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"久"}]},{"ID":"20240617105019-nfyt5py","Type":"NodeParagraph","Properties":{"id":"20240617105019-nfyt5py","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"【核】曰∶出汉中、金州、梁州者最善，益州、广州、浙中者次之。木高数丈，干如柿，叶如椿，花如槐，实如牛柰子。五六月刻取汁液，干之即曰干漆，状如蜂房，孔孔间隔，但性急易燥，热则难干，无风阴润，虽严寒亦易燥，否则不堪入药。修治，捣碎，炒熟，不尔损人肠胃。半夏为之使。畏鸡卵，忌油脂。得蟹则化而成水。"}]},{"ID":"20240617105019-kkxljuv","Type":"NodeParagraph","Properties":{"id":"20240617105019-kkxljuv","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"【 】曰∶夏三月，漆液始足，当入心，以色朱明而性燥急，半夏为使可知矣。干之当入肾，以色玄英而喜阴润，蟹化成水可知矣。入肾为肾之心药；入心为心之肾药。补中者，补中焦血液，血液皆繇中焦变化所成也。心主血，肾主液故尔。则凡血液燥涸，致筋脉缓急断伤，及髓脑不满，五脏不安，痹闭不通，罔不有功。而接续填满，奠安周痹，皆克成血液之濡润流通者。生漆去长虫，以其入心，则得心君火大之令。如大火聚，长虫自无 类矣。"}]},{"ID":"20240617105019-mbm1ca3","Type":"NodeParagraph","Properties":{"id":"20240617105019-mbm1ca3","updated":"20240617105019"},"Children":[{"Type":"NodeText","Data":"（水泻欲流之谓漆，即具水之体，火之用矣。）"}]},{"ID":"20240617105004-znrgmap","Type":"NodeThematicBreak","Properties":{"id":"20240617105004-znrgmap"}},{"ID":"20240617105006-z5buf8j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617105006-z5buf8j","updated":"20240617105012"},"Children":[{"Type":"NodeText","Data":"干漆《药性切用》"}]},{"ID":"20240617105006-q11xane","Type":"NodeParagraph","Properties":{"id":"20240617105006-q11xane","updated":"20240617105006"},"Children":[{"Type":"NodeText","Data":"辛温毒烈，功专破血杀虫。血见干漆，即化为水。炒令烟尽，血非陈年久积勿用。漆蟹汁，亦化为水，其蟹黄尤胜。"}]},{"ID":"20240617104942-0pbilke","Type":"NodeThematicBreak","Properties":{"id":"20240617104942-0pbilke"}},{"ID":"20240617104943-v3oun7q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104943-v3oun7q","updated":"20240617104946"},"Children":[{"Type":"NodeText","Data":"干漆《本草求真》"}]},{"ID":"20240617104943-oqrjsk6","Type":"NodeParagraph","Properties":{"id":"20240617104943-oqrjsk6","updated":"20240617104943"},"Children":[{"Type":"NodeText","Data":"（乔木）铲除老血久积伏蛊"}]},{"ID":"20240617104943-9orajdf","Type":"NodeParagraph","Properties":{"id":"20240617104943-9orajdf","updated":"20240617104943"},"Children":[{"Type":"NodeText","Data":"干漆（专入肝脾）。味辛气温。有毒。（弘景曰。生漆毒烈。人以鸡子和服之去蛊。犹自啮肠胃也。）有降无升。专破日久凝结之血。及削年深坚结之积。缘人感受风寒暑湿。郁而为病。则中外不舒。胃中有物。留滞不消。久而生虫。血积不化。结而为瘀。由是阳气竭泽。津液枯槁。瘫痪风痹。因之不免用此辛温毒烈之性。铲除瘀积。中气得复。绝伤皆续。而缓急和矣。按血见漆化水。故能化蛊破血。千金三蛊方皆赖以之为君。（震亨曰。漆性急而飞。用之中节。积滞去后。补性内行。人不知也。）本经言能轻身者。以其蛊去而身自轻之谓也。所谓中气可复。绝伤可续者。亦因瘀去而中自复。与伤自续之谓也。但无积血者切忌。以其伤营血。损胃气耳。炒令烟尽为度。（试漆诀云。微扇光如镜。悬丝急似钩。撼成琥珀色。打着有浮沤。）若患漆疮。以生蟹汁紫苏解之。（相感志云。漆得蟹而成水。盖物性相制也。凡人畏漆者。嚼蜀椒涂口鼻则可免。）"}]},{"ID":"20240617104906-0gjx2ct","Type":"NodeThematicBreak","Properties":{"id":"20240617104906-0gjx2ct"}},{"ID":"20240617104907-ouw9mml","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104907-ouw9mml","updated":"20240617104911"},"Children":[{"Type":"NodeText","Data":"干漆《汤液本草》"}]},{"ID":"20240617104907-v0j1jcm","Type":"NodeParagraph","Properties":{"id":"20240617104907-v0j1jcm","updated":"20240617104907"},"Children":[{"Type":"NodeText","Data":"气温、平，味辛。无毒。有毒。《本草》云∶主绝伤，补中，续筋骨，填髓脑，安五脏。治五缓六急，风寒湿痹。疗咳嗽，消瘀血痞结腰痛，女子疝瘕，利小肠，去蛔虫。"}]},{"ID":"20240617104907-oisdp64","Type":"NodeParagraph","Properties":{"id":"20240617104907-oisdp64","updated":"20240617104907"},"Children":[{"Type":"NodeText","Data":"生漆，去长虫，半夏为之使。畏鸡子。忌油脂。"}]},{"ID":"20240617104855-qwhe1h2","Type":"NodeThematicBreak","Properties":{"id":"20240617104855-qwhe1h2"}},{"ID":"20240617104857-1erx7dy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104857-1erx7dy","updated":"20240617104901"},"Children":[{"Type":"NodeText","Data":"干漆《本草从新》"}]},{"ID":"20240617104857-fiko68c","Type":"NodeParagraph","Properties":{"id":"20240617104857-fiko68c","updated":"20240617104857"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻、破血消积杀虫．"}]},{"ID":"20240617104857-acm9xp7","Type":"NodeParagraph","Properties":{"id":"20240617104857-acm9xp7","updated":"20240617104857"},"Children":[{"Type":"NodeText","Data":"辛温毒烈．功专行血杀虫，破年深凝结之积滞瘀血，续筋骨绝伤．（损伤必有瘀血停滞．）"}]},{"ID":"20240617104857-yzeu5fk","Type":"NodeParagraph","Properties":{"id":"20240617104857-yzeu5fk","updated":"20240617104857"},"Children":[{"Type":"NodeText","Data":"血见干漆．即化为水．其能损新血可知．虚人及惯生大疮者戒之．勿为丹溪兼补之说所误．（中汤俱可解之、生漆疮者浴之．）炒令烟尽为度．或烧存性．半夏为使．畏川椒、紫苏、鸡子、蟹．（漆得蟹而成水．）"}]},{"ID":"20240607143402-a5dqcf4","Type":"NodeThematicBreak","Properties":{"id":"20240607143402-a5dqcf4"}},{"ID":"20240607143403-um1saki","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143403-um1saki","updated":"20240607143411"},"Children":[{"Type":"NodeText","Data":"干漆《本草述钩元》"}]},{"ID":"20240607143403-32ci4lv","Type":"NodeParagraph","Properties":{"id":"20240607143403-32ci4lv","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"出汉中金州梁州者最善。益州广州浙中者次之。五六月。刻木取汁液干之。即曰干漆。状如蜂房。但性急易燥。热则难干。无风阴润。虽严寒亦易燥也。"}]},{"ID":"20240607143403-w2uzi1l","Type":"NodeParagraph","Properties":{"id":"20240607143403-w2uzi1l","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"味辛苦咸。气温。有毒。气味俱浓。通行肠胃。入肝行血。降也。阳中阴也。本经主绝伤。续筋骨。填髓脑。安五脏。（丹溪言其性急而飞补。用之中节则积滞去后。补性内行。）疗五缓六急。风寒湿痹。诸本草消瘀血痞结。（削年深坚积。破日久凝瘀。）治腰痛。女子疝瘕。经脉不通。利小肠。杀三虫。方书于虚劳传尸。反胃蓄血。心痛胃脘痛。胀满着痹。拘挛盗汗等证用之。凡瘀血得之。即化成水。（仲淳）大抵损伤一证。专从血论。血属有形。形质受病。为痞结。为绝伤。惟兹味捷入血分而消之。则绝伤自和。绝伤和则筋骨自续。而髓脑自足矣。凡风寒湿痹。多病于血滞。此痿缓痹急所由成也。至于腰痛疝瘕。何一非此味通行经脉之治乎。（仲淳）同虫桃仁当归红花苏木丹皮灵脂延胡牛膝。治腹中瘀血作痛。或产后感寒。恶露未尽。结成痞块作痛者。加入干姜泽兰。同楝根鹤虱槟榔锡灰薏苡根乌梅龙胆草。能杀肠胃诸虫。同牛膝丹皮续断赤芍桃仁红花乳香没药延胡鳖甲。治女子月闭因于瘀血。脐腹作痛。其畏寒而不发热口渴者。可加桂。同叶半枝莲生地胡麻荆芥首乌天冬苦参。疗紫云风。入大黄虫丸。治五劳虚极羸瘦。腹满不能饮食。"}]},{"ID":"20240607143403-y0fn12c","Type":"NodeParagraph","Properties":{"id":"20240607143403-y0fn12c","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"肌为末。米饮服一字至一钱。女人月水不通。脐下坚如杯。时发热往来。下痢羸瘦。此为血瘕。（若是肉症。不可治也。）千金方用干漆一斤烧研。生地黄二十斤取汁。和煎。至可丸丸梧子大。每服三丸。空心酒下。"}]},{"ID":"20240607143403-mpvp3v8","Type":"NodeParagraph","Properties":{"id":"20240607143403-mpvp3v8","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"〔论〕漆之味甚辛而属金。第其湿者在燥热则难干。得阴湿则易干。似兼乎水火之用。"}]},{"ID":"20240607143403-6z08rhz","Type":"NodeParagraph","Properties":{"id":"20240607143403-6z08rhz","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"而有得于水为火用。火为水用。以成其气化者。丹溪谓属金而有水与火。良不谬也。其治瘀血而破坚积。由积之坚者皆属阴。不外于血之属也。夫血原于水而成于火。恃有金为水母。"}]},{"ID":"20240607143403-oolmcms","Type":"NodeParagraph","Properties":{"id":"20240607143403-oolmcms","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"又为火妻。水火合于金。然后水为火用。而血之生机在此。火为水用。而血之化机亦在此。"}]},{"ID":"20240607143403-kg2iew8","Type":"NodeParagraph","Properties":{"id":"20240607143403-kg2iew8","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"兹物取其活血。只取其化机之流畅尔。以属金之物而有水火。火为之夫。水为之用。液之所以化血者在是。故遇燥热则难干。火金之化气俱胜也。如以金水值水。斯化机为之息而易干矣。（漆遇蟹则化水。可以征其化机之息。盖蟹固全得其气于金水者。）要惟兹物得乎化机之全。能化即能生。所以活瘀血。破坚积。而便为补益。不然何以异于破血诸味。而本经且谓其治绝伤续筋骨乎。至于用之必须炒熟者。以其禀火金之兼气以达水。不能无毒。（火金相搏。则未免有毒。）炒用所以去毒耳。"}]},{"ID":"20240607143403-ugrp0xg","Type":"NodeParagraph","Properties":{"id":"20240607143403-ugrp0xg","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"缪氏云。瘀血得干漆即化水。其消散之功可知。凡经闭非有瘀血结块阻塞者。切勿轻饵。"}]},{"ID":"20240607143403-fpzdwaa","Type":"NodeParagraph","Properties":{"id":"20240607143403-fpzdwaa","updated":"20240607143403"},"Children":[{"Type":"NodeText","Data":"〔修治〕须捣碎炒熟入药。不尔损人肠胃。若是湿漆煎干更好。亦有烧存性者。"}]},{"ID":"20240607143347-d6q03x8","Type":"NodeThematicBreak","Properties":{"id":"20240607143347-d6q03x8"}},{"ID":"20240607143305-8jxf1uc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143305-8jxf1uc","updated":"20240607143311"},"Children":[{"Type":"NodeText","Data":"干漆《本草崇原》"}]},{"ID":"20240607143305-1737iyf","Type":"NodeParagraph","Properties":{"id":"20240607143305-1737iyf","updated":"20240607143305"},"Children":[{"Type":"NodeText","Data":"气味辛温，无毒。主治绝伤，补中，续筋骨，填髓脑，安五脏，五缓六急，风寒湿痹。生漆去长虫。久服轻身耐老。"}]},{"ID":"20240607143305-tgdl298","Type":"NodeParagraph","Properties":{"id":"20240607143305-tgdl298","updated":"20240607143305"},"Children":[{"Type":"NodeText","Data":"（漆树始出汉中山谷，今梁州、益州、广东、金州、歙州、陆州皆有。树高二三丈，干如柿，叶如椿，花如槐，实如牛柰子，木心色黄，六七月刻取滋汁，或以斧凿取干漆，不假日爆，乃自然干者，状如蜂房孔，孔间隔者为佳。）"}]},{"ID":"20240607143305-cy6fyst","Type":"NodeParagraph","Properties":{"id":"20240607143305-cy6fyst","updated":"20240607143305"},"Children":[{"Type":"NodeText","Data":"漆木生于西北，凿取滋汁而为漆，日曝则反润，阴湿则易干，如人胃府水谷所化之津液，奉心则化赤为血，即日曝反润之义也。入肾脏则凝结为精，即阴湿易干之义也。干漆气味辛温，先白后赤，生干则黑，禀阳明金精之质，而上奉于心，以资经脉，下交于肾，以凝精髓之药也。主治绝伤，资经脉也。补中，阳明居中土也。续筋骨者，治绝伤，则筋骨亦可续也。"}]},{"ID":"20240607143305-meeminp","Type":"NodeParagraph","Properties":{"id":"20240607143305-meeminp","updated":"20240607143305"},"Children":[{"Type":"NodeText","Data":"填髓脑者，凝精髓也。阳明水谷之精，滋灌五脏，故安五脏。驰纵曰缓，拘掣曰急，皆不和之意，五脏不和而驰纵，是为五缓，六腑不和而拘掣，是为六急。五缓六急，乃风寒湿之痹证，故曰风寒湿痹也。《素问·痹论》云∶五脏皆有外合，六腑亦各有俞。皮肌脉筋骨之痹，各以其时，重感于风寒湿之气，则内舍五脏。五脏之痹，犹五缓也。风寒湿气中其俞，而食饮应之。循俞而入，各舍其腑。六腑之痹，犹六急也。是五缓六急，乃风寒湿痹也。生漆色白属金，金能制风，故生漆去长虫。久服则中土之精，四布营运，故轻身耐老。"}]},{"ID":"20240607143039-vlgggqw","Type":"NodeThematicBreak","Properties":{"id":"20240607143039-vlgggqw"}},{"ID":"20240607143507-rzatrrp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143507-rzatrrp","updated":"20240607143515"},"Children":[{"Type":"NodeText","Data":"干漆《本草便读》"}]},{"ID":"20240607143518-llg8ge4","Type":"NodeParagraph","Properties":{"id":"20240607143518-llg8ge4","updated":"20240607143521"},"Children":[{"Type":"NodeText","Data":"破血消瘀．能续绝和伤．通行肝络．辛温有毒．除痹风寒湿．善杀虫疮．（干漆．漆乃树之津液．干漆者．即漆店中桶内所结之漆也．辛苦咸温．有大毒．观其能烂人肌肤．或生漆疮．可知．本经称其能续绝伤．安五脏．久服轻身延年等语．盖荡炼邪滞．则脏腑安．犹除暴即所以安良也．总之干漆乃破血化积之品．杀虫尤其余事耳．）"}]},{"ID":"20240607143530-m6awx1p","Type":"NodeThematicBreak","Properties":{"id":"20240607143530-m6awx1p"}},{"ID":"20240607143531-82ua5w5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143531-82ua5w5","updated":"20240607143549"},"Children":[{"Type":"NodeText","Data":"干漆《本草图经》"}]},{"ID":"20240607143531-x5b1n9k","Type":"NodeParagraph","Properties":{"id":"20240607143531-x5b1n9k","updated":"20240607143535"},"Children":[{"Type":"NodeText","Data":"生漆，出汉中川谷，今蜀、汉、金、峡、襄、歙州皆有之。木高二、三丈，皮白，叶似椿，花似槐，子若牛李，木心黄。六月、七月以竹筒钉入木中取之。崔豹《古今注》曰∶以刚斧斫其皮开，以竹管承之，汁滴则成漆是也。干漆，旧云用漆桶中自然干者，状如蜂房，孔孔隔者。今多用筒子内干者，以黑如 ，坚若铁石为佳。漆叶中药，见《华佗传》，彭城樊阿，少师事佗，求服食法。佗授以漆叶青粘散方，云服之去三虫，利五脏，轻身益气，使人头不白。阿从其言，年五百余岁。漆叶所在有之。青粘生丰沛、彭城及朝歌。一名城节，一名黄芝。主理五脏，益精气。本出于迷人入山者，见仙人服之，以告佗。佗以为佳，语阿。阿秘之。近者人见阿之寿而气力强盛，怪之，以问所服食，阿因醉乱误说，人服多验。其后无复有人识青粘。或云即黄精之正叶者。神仙方乃有单服淳漆法，传于世云。"}]},{"ID":"20240607143503-guc86tx","Type":"NodeThematicBreak","Properties":{"id":"20240607143503-guc86tx"}},{"ID":"20240607143452-opbuzk2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143452-opbuzk2","updated":"20240607143458"},"Children":[{"Type":"NodeText","Data":"干漆《千金翼方》"}]},{"ID":"20240607143452-mvqiew1","Type":"NodeParagraph","Properties":{"id":"20240607143452-mvqiew1","updated":"20240607143452"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒，有毒。主绝伤，补中，续筋骨，填脑髓，安五脏，五缓六急，风寒湿痹。疗咳嗽，消瘀血，痞结，腰痛，女子疝瘕，利小肠，去蛔虫。生漆∶去长虫。久服轻身耐老。生汉中川谷，夏至后采，干之。"}]},{"ID":"20240607143448-gilhm3g","Type":"NodeThematicBreak","Properties":{"id":"20240607143448-gilhm3g"}},{"ID":"20240607143252-j8o4ymj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143252-j8o4ymj","updated":"20240607143300"},"Children":[{"Type":"NodeText","Data":"干漆《医学入门》"}]},{"ID":"20240607143252-apceiwj","Type":"NodeParagraph","Properties":{"id":"20240607143252-apceiwj","updated":"20240607143252"},"Children":[{"Type":"NodeText","Data":"干漆辛温毒而益，破久瘀血年深积，治痹止咳及心痛，利疝祛虫通经脉。"}]},{"ID":"20240607143252-eomol59","Type":"NodeParagraph","Properties":{"id":"20240607143252-eomol59","updated":"20240607143252"},"Children":[{"Type":"NodeText","Data":"木汁如水滴下，可以漆物，阴干如蜂房，孔孔隔者佳。有毒。降也。阳中阴也。东垣云∶破日久闭结之瘀血，削年深坚固之沉积。兼治五缓六急、风寒湿痹，止咳嗽及九种心痛、腹肋积滞气、小肠膀胱疝痛，去蛔虫，通经脉。丹溪云∶属金而有水与火，性急能飞，补用之中节，积去后补性内行。故经曰∶补中续筋填髓。《日华》云∶治传尸，生者去长虫。凡使，干者须捣碎炒烟出，不尔，损人肠胃，湿者煎干。素畏漆者忌服。或毒发，饮铁浆及甘豆汤并蟹解之。半夏为使，畏鸡子，忌油腻。验漆以物蘸起，细而不断，断而急收，又涂干竹上阴之，速干者得真。二圣丸∶干漆末一两，湿漆一两，熬食饭久，和丸如梧子大。每一丸，酒下无时。治妇人不曾生长气血，脏腑痛甚，男子疝痛牙紧，灌下即安。"}]},{"ID":"20240607143235-j56ggbh","Type":"NodeThematicBreak","Properties":{"id":"20240607143235-j56ggbh"}},{"ID":"20240607143241-izgtjme","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143241-izgtjme","updated":"20240607143247"},"Children":[{"Type":"NodeText","Data":"干漆《本草经集注》"}]},{"ID":"20240607143241-33riu6x","Type":"NodeParagraph","Properties":{"id":"20240607143241-33riu6x","updated":"20240607143241"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒、有毒。主治绝伤，补中，续筋骨，填髓脑，安五脏。五缓六急，风寒湿痹，治咳嗽，消瘀血，痞结，腰痛，女子疝瘕，利小肠，去蛔虫。生漆∶去长虫。久服轻身，耐老。生汉中川谷。夏至后采，干之。（半夏为之使，畏鸡子，今又忌油脂。）"}]},{"ID":"20240607143241-lqet79v","Type":"NodeParagraph","Properties":{"id":"20240607143241-lqet79v","updated":"20240607143241"},"Children":[{"Type":"NodeText","Data":"今梁州漆最胜，益州亦有，广州漆性急易燥。其诸处漆桶上盖里，自然有干者，状如蜂房，孔孔隔者为佳。生漆毒烈，人以鸡子白和服之，去虫。犹有啮肠胃者，畏漆人乃致死。"}]},{"ID":"20240607143241-2n36t1p","Type":"NodeParagraph","Properties":{"id":"20240607143241-2n36t1p","updated":"20240607143241"},"Children":[{"Type":"NodeText","Data":"外气亦能使身肉疮肿，自别有治法。仙方用蟹消之为水，炼服长生。（《新修》九九页，《大观》"}]},{"ID":"20240607143039-lr1os8p","Type":"NodeThematicBreak","Properties":{"id":"20240607143039-lr1os8p"}},{"ID":"20240607143223-3xa6h7p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143223-3xa6h7p","updated":"20240607143233"},"Children":[{"Type":"NodeText","Data":"干漆《本草蒙筌》"}]},{"ID":"20240607143223-0hkx8tw","Type":"NodeParagraph","Properties":{"id":"20240607143223-0hkx8tw","updated":"20240607143223"},"Children":[{"Type":"NodeText","Data":"味辛、咸，气温。属金，有水与火。降也，阴中阳也。无毒。汉蜀多生，歙州（属南直隶）亦产。待季夏方取，得阴湿才干。（在燥热晴日反难干，得阴湿雨天却易干，亦物之性也。）凡欲买求，须验好歹。湿者以物蘸起，细而不断，断而急收，涂诸干竹，荫地速干者才佳；干者着目视之，如 （音医）莹黑，若铁坚刚，状类蜂房，孔孔相隔者方美。湿堪饰器皿，干仅入医方。捣作碎砂，炒以文火。畏鸡蛋，忌油脂。又畏蟹黄，见则化水。（漆疮涂即愈。）资半夏为使，合汤散随宜。追积杀三虫，补中安五脏。疗男子风寒湿痹，时作痒疼；治女人疝症瘕坚，不通经脉。续筋骨及填髓脑，消瘀血专主绝伤。痞结腰痛可驱，血气心痛能止。丹溪云∶性急而能飞补，近用为去积滞之药。若用之中节，积去后，补性内行，人不知也。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生漆"},{"Type":"NodeText","Data":"向树吸之，（小竹筒插树皮内，口含吸之，温酒下。）立下长虫住痛。"}]},{"ID":"20240607143223-x2cu0dc","Type":"NodeParagraph","Properties":{"id":"20240607143223-x2cu0dc","updated":"20240607143229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"合青粘作散，华佗曾载方中。利五脏杀虫，黑髭发益气。挤汁涂癣，疮晕渐收。"}]},{"ID":"20240607143040-8vt3scx","Type":"NodeThematicBreak","Properties":{"id":"20240607143040-8vt3scx"}},{"ID":"20240607143126-sqjrn64","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143126-sqjrn64","updated":"20240607143136"},"Children":[{"Type":"NodeText","Data":"干漆《证类本草》"}]},{"ID":"20240607143132-kyoc61e","Type":"NodeParagraph","Properties":{"id":"20240607143132-kyoc61e","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒、有毒。主绝伤，补中，续筋骨，填髓脑，安五脏，五缓六急，风寒痹，疗咳嗽，消瘀血，痞结，腰痛，女子疝瘕，利小肠，去蛔虫。"}]},{"ID":"20240607143132-5kwz4kh","Type":"NodeParagraph","Properties":{"id":"20240607143132-5kwz4kh","updated":"20240607143132"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"生漆"},{"Type":"NodeText","Data":"去长虫。久服轻身耐老。生汉中川谷。夏至后采，干之。（半夏为之使，畏鸡子，今又忌油脂。）"}]},{"ID":"20240607143132-k1lkdqq","Type":"NodeParagraph","Properties":{"id":"20240607143132-k1lkdqq","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今梁州漆最胜，益州亦有，广州漆性急易燥。其诸处漆桶上盖里，自然有干者，状如蜂房，孔孔隔者为佳。生漆毒烈，人以鸡子和服之去虫，犹有啮肠胃者。畏漆人乃致死。外气亦能使身肉疮肿，自别有疗法。仙方用蟹消之，为水炼服，长生。臣禹锡等谨按蜀本注云∶按漆性并急。凡取时须荏油解破，淳者难得，可重重别制试之，上等清漆，色黑如，若铁石者好，黄嫩若蜂窠者不佳。《图经》云∶树高二丈余，皮白，叶似椿樗，皮似槐，花、子若牛李，木心黄。六月、七月刻取滋汁。出金州者最善也。药性论云∶干漆，臣，味辛、咸。能杀三虫，主女人经脉不通。日华子云∶治敷尸劳，除风。入药须捣碎炒熟，不尔损人肠胃，若是湿漆，煎干更好，或毒发，饮铁浆并黄栌汁及甘豆汤，吃蟹并可制。"}]},{"ID":"20240607143132-45upyhx","Type":"NodeParagraph","Properties":{"id":"20240607143132-45upyhx","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"图经曰∶干漆、生漆，出汉中川谷，今蜀、汉、金、峡、襄、歙州皆有之。木高三、二丈，皮白，叶似椿，花似槐子若牛李，木心黄。六月、七月以竹筒钉入木中取之。崔豹《古今注》曰∶以刚斧斫其皮开，以竹管承之。汁滴则成漆是也。干漆，旧云用漆桶中自然干者，状如蜂房，孔孔隔者。今多用筒子内干者，以黑如 ，坚若铁石为佳。漆叶中药，见《华佗传》。彭城樊阿，少师事佗，求服食法。佗授以漆叶青粘散方，云服之去三虫，利五脏，轻身益气，使人头不白。阿从其言，年五百余岁。漆叶所在有之。青粘生丰沛、彭城及朝歌。"}]},{"ID":"20240607143132-al2hvl2","Type":"NodeParagraph","Properties":{"id":"20240607143132-al2hvl2","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"一名地节，一名黄芝。主理五脏，益精气。本出于迷人入山者，见仙人服之，以告佗，佗以为佳，语阿，阿秘之。近者人见阿之寿而气力强盛，怪之，以问所服食，阿因醉乱误说，人服多验。其后无复有人识青粘。或云即黄精之正叶者。神仙方乃有单服淳漆法，传于世云。"}]},{"ID":"20240607143132-0jhuq8f","Type":"NodeParagraph","Properties":{"id":"20240607143132-0jhuq8f","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"外台秘要∶疗蛔虫，心痛，恶心吐水。干漆熬捣蜜和丸。服十五丸，日再服。经验方治妇人不曾生长，血气，脏腑疼痛不可忍，及治丈气元气、小肠气撮痛者。并宜服二圣丸∶干漆一两为末，湿漆一两，先将湿漆入铫子内，熬如一食饭间以来住火，与干漆末一处拌和丸如半皂子大。每服一丸，温酒吞下，无时。如元气、小肠、膀胱气痛，牙关紧急，但斡开牙关，温酒化一丸灌下必安。怕漆人不可服。简要济众∶治九种心痛及腹胁积聚滞气。筒子干漆二两，捣碎炒烟出，细研，醋煮面糊和丸如梧桐子大。每服五丸至七丸，热酒下，醋汤亦得，无时服。杜壬∶治小儿胃寒，虫上诸证，危恶与痫相似。干漆捣炒烟尽，白芜荑等分，为细末。米饮调下一字至一钱。席延赏∶治女人经血不行及诸症瘕等病。室女万瘕丸∶干漆一两为粗末，炒令烟尽，牛膝末一两，以生地黄汁一升入银器中熬，俟可丸，丸如梧子大。每服一丸，加至三、五丸，酒饮下，以通利为度。抱朴子∶内篇∶淳漆不枯者，服之通神长生法。"}]},{"ID":"20240607143132-had1sy4","Type":"NodeParagraph","Properties":{"id":"20240607143132-had1sy4","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"或以大蟹投其中，或以云母水，或以玉水合之服，九虫悉下，恶血从鼻出。一年六甲，行厨至也。淮南子∶漆见蟹而不干。"}]},{"ID":"20240607143132-x6340n2","Type":"NodeParagraph","Properties":{"id":"20240607143132-x6340n2","updated":"20240607143132"},"Children":[{"Type":"NodeText","Data":"衍义曰∶干漆，苦湿漆，药中未见用，凡用者，皆干漆耳。其湿者，在燥热及霜冷时，则难干。得阴湿，虽寒月亦易干。亦物之性也。苦沾渍人，以油治之。凡验漆，唯稀者以物蘸起，细而不断，断而急收起。又涂于干竹上，荫之速干者，并佳。余如《经》。"}]},{"ID":"20240607143040-0444r3r","Type":"NodeThematicBreak","Properties":{"id":"20240607143040-0444r3r"}},{"ID":"20240607143424-pkc9j52","Type":"NodeParagraph","Properties":{"id":"20240607143424-pkc9j52"}},{"ID":"20240607143041-y3ly2oz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143041-y3ly2oz","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"《中国药典》：干漆"}]},{"ID":"20240607143041-mt7c654","Type":"NodeParagraph","Properties":{"id":"20240607143041-mt7c654","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607143041-s9lsghi","Type":"NodeParagraph","Properties":{"id":"20240607143041-s9lsghi","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" Gàn Qī"}]},{"ID":"20240607143041-c8q155o","Type":"NodeParagraph","Properties":{"id":"20240607143041-c8q155o","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607143041-54fj2l0","Type":"NodeParagraph","Properties":{"id":"20240607143041-54fj2l0","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 漆树"}]},{"ID":"20240607143041-m7j590l","Type":"NodeParagraph","Properties":{"id":"20240607143041-m7j590l","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607143041-6w2t1gi","Type":"NodeParagraph","Properties":{"id":"20240607143041-6w2t1gi","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 本品为漆树科漆树属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"漆树"},{"Type":"NodeText","Data":"Toxicodendron vernicifluum（Stokes）F.A.Barkl. 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树脂经加工后的干燥品"},{"Type":"NodeText","Data":"。一般收集盛漆器具底留下的漆渣，干燥。"}]},{"ID":"20240607143041-hyv3ymq","Type":"NodeParagraph","Properties":{"id":"20240607143041-hyv3ymq","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607143041-cyiopze","Type":"NodeParagraph","Properties":{"id":"20240607143041-cyiopze","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 本品呈不规则块状，黑褐色或棕褐色，表面粗糙，有蜂窝状细小孔洞或呈颗粒状。质坚硬，不易折断，断面不平坦。具特殊臭气。"}]},{"ID":"20240607143041-30fr97s","Type":"NodeParagraph","Properties":{"id":"20240607143041-30fr97s","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607143041-ifj4ion","Type":"NodeParagraph","Properties":{"id":"20240607143041-ifj4ion","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 密闭保存，防火。"}]},{"ID":"20240607143041-mu80lrc","Type":"NodeParagraph","Properties":{"id":"20240607143041-mu80lrc","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607143041-x4ewkuo","Type":"NodeParagraph","Properties":{"id":"20240607143041-x4ewkuo","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 取干漆，置火上烧枯；或敲成小块，置锅中炒至焦枯黑烟尽，取出，放凉。"}]},{"ID":"20240607143041-2q7fmp4","Type":"NodeParagraph","Properties":{"id":"20240607143041-2q7fmp4","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607143041-7jofdr5","Type":"NodeParagraph","Properties":{"id":"20240607143041-7jofdr5","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" （1）取本品一小块，置瓷蒸发皿中，点火即燃烧，产生黑烟并发出强烈漆臭。"}]},{"ID":"20240607143041-f1w90s9","Type":"NodeParagraph","Properties":{"id":"20240607143041-f1w90s9","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加乙醇10ml，置热水浴中加热5分钟，放冷，滤过。取滤液1ml，加三氯化铁试液1～2滴，显墨绿色。"}]},{"ID":"20240607143041-3jkcdpp","Type":"NodeParagraph","Properties":{"id":"20240607143041-3jkcdpp","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607143041-jpnssx7","Type":"NodeParagraph","Properties":{"id":"20240607143041-jpnssx7","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 归肝、脾经。"}]},{"ID":"20240607143041-6vql5wl","Type":"NodeParagraph","Properties":{"id":"20240607143041-6vql5wl","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607143041-afjhumb","Type":"NodeParagraph","Properties":{"id":"20240607143041-afjhumb","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 辛，温；有毒。"}]},{"ID":"20240607143041-74f3h32","Type":"NodeParagraph","Properties":{"id":"20240607143041-74f3h32","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607143041-8e4ymtw","Type":"NodeParagraph","Properties":{"id":"20240607143041-8e4ymtw","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 孕妇及体虚无瘀者慎用。"}]},{"ID":"20240607143041-6dhx1nz","Type":"NodeParagraph","Properties":{"id":"20240607143041-6dhx1nz","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607143041-i2m73y9","Type":"NodeParagraph","Properties":{"id":"20240607143041-i2m73y9","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 破瘀血，消积，杀虫。用于妇女闭经，瘀血症瘕，虫积腹痛。"}]},{"ID":"20240607143041-rduin7g","Type":"NodeParagraph","Properties":{"id":"20240607143041-rduin7g","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607143041-9bvprh5","Type":"NodeParagraph","Properties":{"id":"20240607143041-9bvprh5","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 2.4～4.5g。"}]},{"ID":"20240607143041-v066sk3","Type":"NodeParagraph","Properties":{"id":"20240607143041-v066sk3","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607143041-pzws6h0","Type":"NodeParagraph","Properties":{"id":"20240607143041-pzws6h0","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607143041-rzj8034","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143041-rzj8034","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：干漆"}]},{"ID":"20240607143041-py7x4me","Type":"NodeParagraph","Properties":{"id":"20240607143041-py7x4me","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607143041-a9trxjt","Type":"NodeParagraph","Properties":{"id":"20240607143041-a9trxjt","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" Gān Qī"}]},{"ID":"20240607143041-sv41e18","Type":"NodeParagraph","Properties":{"id":"20240607143041-sv41e18","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607143041-cajt1c9","Type":"NodeParagraph","Properties":{"id":"20240607143041-cajt1c9","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 漆渣、漆底、漆脚（《中药材手册》）。"}]},{"ID":"20240607143041-jtqsdj7","Type":"NodeParagraph","Properties":{"id":"20240607143041-jtqsdj7","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607143041-mh8d3ue","Type":"NodeParagraph","Properties":{"id":"20240607143041-mh8d3ue","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607143041-hpoxvir","Type":"NodeParagraph","Properties":{"id":"20240607143041-hpoxvir","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607143041-zx5eq33","Type":"NodeParagraph","Properties":{"id":"20240607143041-zx5eq33","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 为漆树科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"漆树树脂经加工后的干燥品"},{"Type":"NodeText","Data":"。一般取漆桶内用剩的漆脚，晒干。密闭保存，防火。"}]},{"ID":"20240607143041-qqai2po","Type":"NodeParagraph","Properties":{"id":"20240607143041-qqai2po","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607143041-bfupyrh","Type":"NodeParagraph","Properties":{"id":"20240607143041-bfupyrh","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 多生于向阳避风山坡。分布甘肃、陕西、山西、河南、山东、江苏、浙江、安徽、江西、湖北、四川、云南、贵州、广东等地。"}]},{"ID":"20240607143041-3ec9449","Type":"NodeParagraph","Properties":{"id":"20240607143041-3ec9449","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607143041-ynvc1qk","Type":"NodeParagraph","Properties":{"id":"20240607143041-ynvc1qk","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 漆树（《蜀本草》）又名：山漆、渣苗。"}]},{"ID":"20240607143041-7d5l4n1","Type":"NodeParagraph","Properties":{"id":"20240607143041-7d5l4n1","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高达20米。树皮幼时灰白色，平滑，者则深灰色，粗糙，成不规则之纵裂。幼枝有柔毛，后渐脱落。冬芽生枝顶。单数羽状复叶，螺旋状互生，长22～75厘米；叶柄长5～9厘米，基部膨大；小叶11～15，卵形或长方状卵形，长7～15厘米，宽3～7厘米，先端长尖，基部广楔形或不整齐圆形，全缘；上面无毛或中脉生微毛，下面初有细毛，老时沿脉密生淡褐色毛；小叶柄短。花单性或两性；雌雄异株或杂生；花序圆锥状，腋生；花梗具短柔毛；花密而小，黄绿色；雄花花萼5，长圆形，花瓣5，长方状卵形，有紫纹，雄蕊5，着生于花盘边缘，花丝短，具退化子房；雌花雄蕊较小，子房1室，花柱短，柱头3裂。果序下垂，核果扁圆，直径6～8毫米，黄色。花期5～6月。果熟期11月。"}]},{"ID":"20240607143041-jyspgqe","Type":"NodeParagraph","Properties":{"id":"20240607143041-jyspgqe","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607143041-qtb82cn","Type":"NodeParagraph","Properties":{"id":"20240607143041-qtb82cn","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 干燥树脂呈不规则块状。表面黑褐色或棕褐色，粗糙，呈颗粒状或蜂窝状，有光泽。质坚硬，不易折断，断面不平坦。微有漆臭。用火点燃能燃烧，发黑烟，漆臭更强，以块整、色黑、坚硬、漆臭重者为佳。"}]},{"ID":"20240607143041-o58e5fd","Type":"NodeParagraph","Properties":{"id":"20240607143041-o58e5fd","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607143041-ryp255i","Type":"NodeParagraph","Properties":{"id":"20240607143041-ryp255i","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 干漆是生漆中的漆酚在虫漆酶的作用下在空气中氧化生成的黑色树脂物质。"}]},{"ID":"20240607143041-10exnks","Type":"NodeParagraph","Properties":{"id":"20240607143041-10exnks","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607143041-9tzzsoe","Type":"NodeParagraph","Properties":{"id":"20240607143041-9tzzsoe","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 取擦净的干漆砸成小块，置煅锅内，上覆一口径较小的锅，上贴白纸，两锅沿的接合处，用黄泥封固，加热煅至白纸呈焦黄色为度。停火焖凉，取出打碎即成。或置锅内炒至烟尽、焦黑存性亦可。"}]},{"ID":"20240607143041-bxl4hc7","Type":"NodeParagraph","Properties":{"id":"20240607143041-bxl4hc7","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"《日华子本草》：\"入药须捣碎炒熟，不尔，损人肠胃。若是湿漆煎干更好。\""}]},{"ID":"20240607143041-n4dn9ow","Type":"NodeParagraph","Properties":{"id":"20240607143041-n4dn9ow","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607143041-e612so8","Type":"NodeParagraph","Properties":{"id":"20240607143041-e612so8","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 入肝、脾经。"}]},{"ID":"20240607143041-1psv7v2","Type":"NodeParagraph","Properties":{"id":"20240607143041-1psv7v2","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入胃、大小肠三经。\""}]},{"ID":"20240607143041-l2ukysp","Type":"NodeParagraph","Properties":{"id":"20240607143041-l2ukysp","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入肝、脾。\""}]},{"ID":"20240607143041-o4pjowa","Type":"NodeParagraph","Properties":{"id":"20240607143041-o4pjowa","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607143041-psltzfd","Type":"NodeParagraph","Properties":{"id":"20240607143041-psltzfd","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 辛，温，有毒。"}]},{"ID":"20240607143041-egl9t4p","Type":"NodeParagraph","Properties":{"id":"20240607143041-egl9t4p","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240607143041-6kexj86","Type":"NodeParagraph","Properties":{"id":"20240607143041-6kexj86","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味辛，咸。\""}]},{"ID":"20240607143041-4i51tbv","Type":"NodeParagraph","Properties":{"id":"20240607143041-4i51tbv","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"③张元素：\"辛，平，有毒。\""}]},{"ID":"20240607143041-1akdaia","Type":"NodeParagraph","Properties":{"id":"20240607143041-1akdaia","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607143041-blarhjd","Type":"NodeParagraph","Properties":{"id":"20240607143041-blarhjd","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 孕妇及体虚无瘀者均宜慎服。"}]},{"ID":"20240607143041-okcrea8","Type":"NodeParagraph","Properties":{"id":"20240607143041-okcrea8","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"半夏为之使。畏鸡子。\""}]},{"ID":"20240607143041-2uflhkd","Type":"NodeParagraph","Properties":{"id":"20240607143041-2uflhkd","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"②《经验方》：\"怕漆人不可服。\""}]},{"ID":"20240607143041-pnzq81t","Type":"NodeParagraph","Properties":{"id":"20240607143041-pnzq81t","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"虚人及惯生大疮者戒之。\""}]},{"ID":"20240607143041-ce1fpff","Type":"NodeParagraph","Properties":{"id":"20240607143041-ce1fpff","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"④《本草求原》：\"胃虚人忌之。\""}]},{"ID":"20240607143041-4ss1ng7","Type":"NodeParagraph","Properties":{"id":"20240607143041-4ss1ng7","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607143041-fjpyajk","Type":"NodeParagraph","Properties":{"id":"20240607143041-fjpyajk","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 破瘀，消积，杀虫。治妇女经闭，症瘕，瘀血，虫积。"}]},{"ID":"20240607143041-hhplh3y","Type":"NodeParagraph","Properties":{"id":"20240607143041-hhplh3y","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主绝伤，续筋骨，五缓六急，风寒湿痹。\""}]},{"ID":"20240607143041-xj6c8b2","Type":"NodeParagraph","Properties":{"id":"20240607143041-xj6c8b2","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗咳嗽，消瘀血痞结腰痛，女子疝瘕，利小肠，去蛔虫。\""}]},{"ID":"20240607143041-2me5gk0","Type":"NodeParagraph","Properties":{"id":"20240607143041-2me5gk0","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能杀三虫，主女人经脉不通。\""}]},{"ID":"20240607143041-8ao6xmp","Type":"NodeParagraph","Properties":{"id":"20240607143041-8ao6xmp","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"④张元素：\"削年深坚结之积滞，破日久凝结之瘀血。\""}]},{"ID":"20240607143041-lsfo1hw","Type":"NodeParagraph","Properties":{"id":"20240607143041-lsfo1hw","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"⑤《本草原始》：\"妇人产后血运，多用干漆火烧熏鼻。\""}]},{"ID":"20240607143041-4cl14o9","Type":"NodeParagraph","Properties":{"id":"20240607143041-4cl14o9","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607143041-rbxqh17","Type":"NodeParagraph","Properties":{"id":"20240607143041-rbxqh17","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散，0.8～1.5钱。外用：烧烟熏。"}]},{"ID":"20240607143041-qxezgt1","Type":"NodeParagraph","Properties":{"id":"20240607143041-qxezgt1","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607143041-02n5oo6","Type":"NodeParagraph","Properties":{"id":"20240607143041-02n5oo6","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" ①治妇人血气疼痛不可忍，丈夫小肠气撮痛：干漆一两（为末），湿漆一两。先将湿漆入铫子内熬，如一食饭间已来住火，与干漆末一处拌和，丸如半皂子大；每服一九，温酒吞下，无时。如小肠膀胱气痛，牙关紧急，但斡开牙关，温酒化一丸灌下。（《经验方》二圣丸）"}]},{"ID":"20240607143041-drd8kb7","Type":"NodeParagraph","Properties":{"id":"20240607143041-drd8kb7","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"②治妇人脐下结物，大如杯升，月经不通，发作往来，下痢羸瘦，此为气瘕，按之若牢强肉症者不可治，末者可治：末干漆一斤，生地黄三十斤（捣绞取汁），火煎干漆，令可丸，食后服，如梧子大三丸，日三服。（《补缺肘后方》）"}]},{"ID":"20240607143041-kzd00ft","Type":"NodeParagraph","Properties":{"id":"20240607143041-kzd00ft","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"③治胞衣不出，及恶血不行：干漆（碎，炒令烟），当归（切，焙）一两。上二味捣罗为散。每服二钱匕，用荆芥酒调下，时一服，以下为度。（《圣济总录》干漆散）"}]},{"ID":"20240607143041-qsjmq5y","Type":"NodeParagraph","Properties":{"id":"20240607143041-qsjmq5y","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"④治九种心痛，及腹胁积聚滞气：筒子干漆二两。捣碎，炒烟出，细研，醋煮面糊和丸，如梧桐子大，每服五丸至七丸，热酒下，醋汤亦得，无时服。（《简要济众方》）"}]},{"ID":"20240607143041-06n8di7","Type":"NodeParagraph","Properties":{"id":"20240607143041-06n8di7","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"⑤治小儿蛔虫心痛：干漆一两（捣碎，炒令烟出）。捣细，罗为散，每服以新汲水一合，生油一橡斗子，空心调下一字，不过三服，当取下虫。（《圣惠方》）"}]},{"ID":"20240607143041-xcm0cme","Type":"NodeParagraph","Properties":{"id":"20240607143041-xcm0cme","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"⑥治五劳七伤：干漆、柏子人、山茱萸、酸枣仁各等分。为末蜜丸，如梧子大。服二七丸，温酒下，日二服。（《千金方》）"}]},{"ID":"20240607143041-wdka9aj","Type":"NodeParagraph","Properties":{"id":"20240607143041-wdka9aj","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"⑦治喉痹欲绝不可针药者：干漆烧烟，以筒吸之。（《圣济总录》）"}]},{"ID":"20240607143041-e495yvx","Type":"NodeParagraph","Properties":{"id":"20240607143041-e495yvx","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607143041-ru2x8gc","Type":"NodeParagraph","Properties":{"id":"20240607143041-ru2x8gc","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607143041-n0h9vho","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607143041-n0h9vho","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"《中华本草》：干漆"}]},{"ID":"20240607143041-6dm6rbi","Type":"NodeParagraph","Properties":{"id":"20240607143041-6dm6rbi","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607143041-4y0yxur","Type":"NodeParagraph","Properties":{"id":"20240607143041-4y0yxur","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" Gān Qī"}]},{"ID":"20240607143041-htgoks8","Type":"NodeParagraph","Properties":{"id":"20240607143041-htgoks8","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607143041-2muim57","Type":"NodeParagraph","Properties":{"id":"20240607143041-2muim57","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 漆渣、漆底、漆脚、续合筒、黑漆。"}]},{"ID":"20240607143041-l79jkmw","Type":"NodeParagraph","Properties":{"id":"20240607143041-l79jkmw","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607143041-q4opg7m","Type":"NodeParagraph","Properties":{"id":"20240607143041-q4opg7m","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" Dried Lacquer"}]},{"ID":"20240607143041-ihn627d","Type":"NodeParagraph","Properties":{"id":"20240607143041-ihn627d","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607143041-qrmb552","Type":"NodeParagraph","Properties":{"id":"20240607143041-qrmb552","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240607143041-xgpqg8w","Type":"NodeParagraph","Properties":{"id":"20240607143041-xgpqg8w","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607143041-hbtg8m2","Type":"NodeParagraph","Properties":{"id":"20240607143041-hbtg8m2","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 药材基源：为漆树科植物漆树树脂经加工后的干燥品。"}]},{"ID":"20240607143041-0ppl9mt","Type":"NodeParagraph","Properties":{"id":"20240607143041-0ppl9mt","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Toxicodendron vernicifluum (Stokes)F.A.Barkl.[Rhus verniciflua Stokes]"}]},{"ID":"20240607143041-fytmoic","Type":"NodeParagraph","Properties":{"id":"20240607143041-fytmoic","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"采收和储藏：割伤漆树树皮，收集自行流出的树脂为生漆，干固后凝成的团块即为干漆。但商品多收集漆缸壁或底部粘着的干渣，经缎制后入药。"}]},{"ID":"20240607143041-a0leckh","Type":"NodeParagraph","Properties":{"id":"20240607143041-a0leckh","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607143041-r597ovu","Type":"NodeParagraph","Properties":{"id":"20240607143041-r597ovu","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔800-2 800（-3800）m的向阳山坡林内，亦有栽培。"}]},{"ID":"20240607143041-9r2okm8","Type":"NodeParagraph","Properties":{"id":"20240607143041-9r2okm8","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"资源分布：全国除黑龙江、吉林、内蒙古、新疆以外，各地均有分布。"}]},{"ID":"20240607143041-snms92o","Type":"NodeParagraph","Properties":{"id":"20240607143041-snms92o","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607143041-0g70si2","Type":"NodeParagraph","Properties":{"id":"20240607143041-0g70si2","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 漆树 落叶乔木，高达20m。树皮灰白色，粗糙，呈不规则纵裂，小枝粗壮，被棕色柔毛；冬芽生枝顶，大而显着，被棕黄色绒毛。奇数羽状复叶螺旋状，互生，长22-75cm；叶柄长7-14cm，被微柔毛，近基部膨大，半圆形，上面平；小叶4-6对，小叶柄长4-7mm，卵形、卵状椭圆形或长圆形，长6-13cm，宽3-6cm，先端渐尖或急尖，基部偏斜，圆形或阔楔形，全缘，上面无毛或中脉被微毛，下面初有细毛，老时沿脉密被淡褐色柔毛；例脉10-15对，两面略凸，膜质至薄纸质。圆锥花序长15-30cm，被灰黄色微柔毛；花杂性或雌雄异株，花黄绿色；雄花花萼5，卵形，长约0.8mm；花瓣5，长圆形，开花外卷；雄蕊5，长约2.5mm，着生于花盘边缘，花丝线形，花药长圆形；雌花较雄蕊小，子房球形，1室，径约1.5mm，花柱3。果序稍下垂，核果肾形或椭圆形，不偏斜，略压扁，长5-6mm，宽7-8mm，外果皮黄色，无毛，具光泽，成熟后不裂，中果皮错质，具树脂条纹，果核棕色，与果同形，长约3mm，宽约5mm，坚硬。花期5-6月，果期7-10月。"}]},{"ID":"20240607143041-j8j7jmk","Type":"NodeParagraph","Properties":{"id":"20240607143041-j8j7jmk","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607143041-eurx4po","Type":"NodeParagraph","Properties":{"id":"20240607143041-eurx4po","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品呈不规则块状，黑褐色或棕褐色，表面粗糙，有蜂窝状细小孔洞或呈颗粒状，有光泽。质坚硬，不易折断，断面不平坦，具特殊臭气。遇火燃烧，发黑烟，漆臭更强烈。以块整、色黑、坚硬、漆臭重者为佳。"}]},{"ID":"20240607143041-uabw26n","Type":"NodeParagraph","Properties":{"id":"20240607143041-uabw26n","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607143041-9in17w6","Type":"NodeParagraph","Properties":{"id":"20240607143041-9in17w6","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 干漆是生漆中的漆酚在虫漆酶的作用下，在空气中氧化生成的黑色树脂状物质。"}]},{"ID":"20240607143041-x8lntkj","Type":"NodeParagraph","Properties":{"id":"20240607143041-x8lntkj","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607143041-m7rpa8w","Type":"NodeParagraph","Properties":{"id":"20240607143041-m7rpa8w","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 取擦净的千漆砸成小块，置煅锅内，上覆一口径较小的锅，上贴白纸，两锅沿的接合处，用黄泥封固，加热煅至白纸呈焦黄色为度。停火焖凉，取出打碎即成。或置锅内炒至烟尽、焦黑存性亦可。《日华子本草》：入药须捣碎炒熟，不尔，损人肠胃。若是湿漆煎干更好。"}]},{"ID":"20240607143041-8wlepzk","Type":"NodeParagraph","Properties":{"id":"20240607143041-8wlepzk","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607143041-2fhpzit","Type":"NodeParagraph","Properties":{"id":"20240607143041-2fhpzit","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末1g，加乙醇10ml，置热水浴中加热5min，放冷，滤过。取滤液1ml，加三氯化铁试液1-2滴，显墨绿色。（检查酚类）"}]},{"ID":"20240607143041-9vm1q5p","Type":"NodeParagraph","Properties":{"id":"20240607143041-9vm1q5p","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607143041-wqf63lt","Type":"NodeParagraph","Properties":{"id":"20240607143041-wqf63lt","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 肝；脾；胃；大肠；小肠经"}]},{"ID":"20240607143041-szr33h8","Type":"NodeParagraph","Properties":{"id":"20240607143041-szr33h8","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607143041-rscncfr","Type":"NodeParagraph","Properties":{"id":"20240607143041-rscncfr","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 辛；温；小毒"}]},{"ID":"20240607143041-dymwy3b","Type":"NodeParagraph","Properties":{"id":"20240607143041-dymwy3b","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607143041-fa9wa9c","Type":"NodeParagraph","Properties":{"id":"20240607143041-fa9wa9c","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 孕妇及体虚无瘀者均宜慎服。《本草经集注》：半夏为之使。畏鸡子。《经验方》：怕漆人不可服。《本草从新》：虚人及惯生大疮者戒之。《本草求原》：胃虚人忌之。"}]},{"ID":"20240607143041-uxj9ubx","Type":"NodeParagraph","Properties":{"id":"20240607143041-uxj9ubx","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607143041-oftzald","Type":"NodeParagraph","Properties":{"id":"20240607143041-oftzald","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 破瘀；消积；杀虫。主妇女瘀血阴滞；经闭；症瘕；虫积"}]},{"ID":"20240607143041-03bydh9","Type":"NodeParagraph","Properties":{"id":"20240607143041-03bydh9","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607143041-r378ape","Type":"NodeParagraph","Properties":{"id":"20240607143041-r378ape","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 内服：入丸、散，2-4.5g。外用：烧烟熏。内服宜炒或煅后用。"}]},{"ID":"20240607143041-mxcspji","Type":"NodeParagraph","Properties":{"id":"20240607143041-mxcspji","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607143041-andvc7l","Type":"NodeParagraph","Properties":{"id":"20240607143041-andvc7l","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：今广、浙中出一种漆树，似小榎而大，六月取汁漆物，黄泽如金，即《唐书》所谓黄漆者也。入药仍当用黑漆，广南漆作饴糖气，沾沾无力。凡人畏漆者，嚼蜀椒涂口鼻则可免。生漆疮者，杉木汤、紫苏汤、漆姑草汤、蟹汤浴之皆良。漆花，治小儿解颅、腹胀、交胫不行方中用之。......漆，性毒而杀虫，降而行血，所主诸证虽繁，其功只在二者而已。"}]},{"ID":"20240607143041-pycicor","Type":"NodeParagraph","Properties":{"id":"20240607143041-pycicor","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：干漆，能杀虫消散，逐肠胃一切有形之积滞，肠胃既清，则五脏自安，痿缓痹结自调矣。又损伤一证，专从血论，盖血者有形者也，形质受病，惟辛温散结而兼咸味者，可入血分而消之，瘀血消则绝伤自和，筋骨自续，而髓脑自足矣。其主痞结腰痛，女子疝瘕者，亦指下焦血分受寒，血凝所致，利小肠者，取其通行经脉之功耳。至于疗咳嗽，虽非正治，然亦有瘀血停积，发为骨蒸劳瘵，以致咳嗽者，得其消散瘀血之力，则骨蒸退而咳嗽亦除也。"}]},{"ID":"20240607143041-143ycms","Type":"NodeParagraph","Properties":{"id":"20240607143041-143ycms","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：干漆灰，性善下降而破血，故消肿杀虫通月闭，皆取去恶血之用，而《本经》治绝伤，是取其破宿生新之力也。元素云，削年深坚结之积滞，破日久凝结之瘀血，斯言尽干漆之用矣。无积血者切忌，以大伤营血，损胃气，故胃虚人服之，往往作呕，此与《本经》之义，似乎相背，而实不相违。产后血晕，以旧漆器烧烟熏之即醒，盖亦取下血之义，而破经络中血滞。"}]},{"ID":"20240607143041-2xi017e","Type":"NodeParagraph","Properties":{"id":"20240607143041-2xi017e","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"4.其他《本经》：主绝伤，续筋骨，五缓六急，风寒湿痹。《别录》疗咳嗽，消瘀血痞结腰痛，女子疝瘕，利小肠，去蛔虫。《药性论》：能杀三虫，主女人经脉不通。张元素：削年深坚结之积滞，破日久凝结之瘀血。《本草原始》：妇人产后血运，多用干漆火烧熏鼻。陶弘景：今梁州漆最胜，益州亦有，广州漆性急易燥。其诸处漆桶上盖里自然有干者，状如蜂房，孔孔隔者为佳。《蜀本草》：上等清漆色黑如？，若铁石者好，黄嫩若蜂窝者不佳。《日华子本草》：漆毒发，饮铁浆并黄栌汁及甘豆汤，吃蟹，并可制。《医学正传》：性畏漆者，入鸡子清和药（干漆）内。"}]},{"ID":"20240607143041-4ntdsbw","Type":"NodeParagraph","Properties":{"id":"20240607143041-4ntdsbw","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607143041-h856s2d","Type":"NodeParagraph","Properties":{"id":"20240607143041-h856s2d","updated":"20240607143041"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607143042-4lw651c","Type":"NodeThematicBreak","Properties":{"id":"20240607143042-4lw651c"}},{"ID":"20240607143043-45t7h9y","Type":"NodeParagraph","Properties":{"id":"20240607143043-45t7h9y"}}]}