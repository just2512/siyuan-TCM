":{"parent-style":"width: 761px;","style":"width: 751px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川黄柏关黄柏对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川黄柏关黄柏对比-20240709175651-7zuvn3g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 751px;\" parent-style=\"width: 761px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 342px;","style":"width: 332px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄柏 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄柏 4-20240809101231-0rxh5p4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 332px;\" parent-style=\"width: 342px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809101027-h124let","Type":"NodeParagraph","Properties":{"id":"20240809101027-h124let","updated":"20240809101400"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"（川黄柏比关黄柏皮更厚，经济价值会更高，所以通常为种植首选；川黄柏的树叶更圆润）"}]},{"ID":"20240620153033-z4mlz22","Type":"NodeParagraph","Properties":{"id":"20240620153033-z4mlz22","updated":"20240620153048"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：黄柏用的是黄柏植物的树皮。"}]},{"ID":"20240809100840-j4dtmf4","Type":"NodeParagraph","Properties":{"id":"20240809100840-j4dtmf4","updated":"20240809100940"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：川黄柏比关黄柏皮厚；"}]},{"ID":"20240809101946-161kdfs","Type":"NodeParagraph","Properties":{"id":"20240809101946-161kdfs","updated":"20240809101959"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：黄柏很苦，比黄连还苦；"}]},{"ID":"20240607142939-uwwv3ra","Type":"NodeThematicBreak","Properties":{"id":"20240607142939-uwwv3ra"}},{"ID":"20240607142943-0e5c925","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142943-0e5c925","updated":"20240607142948"},"Children":[{"Type":"NodeText","Data":"黄柏《本草分经》"}]},{"ID":"20240607142943-qgo96n1","Type":"NodeParagraph","Properties":{"id":"20240607142943-qgo96n1","updated":"20240607142943"},"Children":[{"Type":"NodeText","Data":"苦寒微辛，沉阴下降，泻膀胱相火，为足太阳引经药，除湿清热退火而固肾，治瘫痿骨蒸泻痢诸疮，尺脉有力者方可用，生用降实火，炒黑止崩带，酒制治上，蜜制治中，盐制治下。"}]},{"ID":"20240607142921-jqtfo0p","Type":"NodeThematicBreak","Properties":{"id":"20240607142921-jqtfo0p"}},{"ID":"20240607142928-7cjjrrt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142928-7cjjrrt","updated":"20240607142937"},"Children":[{"Type":"NodeText","Data":"黄柏《本草经解》"}]},{"ID":"20240607142928-q3olgfj","Type":"NodeParagraph","Properties":{"id":"20240607142928-q3olgfj","updated":"20240607142928"},"Children":[{"Type":"NodeText","Data":"气寒．味苦．无毒．主五脏肠胃中结热．黄胆．肠痔．止泄痢．女子漏下赤白．阴伤蚀疮．（盐水炒）"}]},{"ID":"20240607142928-fwr6owv","Type":"NodeParagraph","Properties":{"id":"20240607142928-fwr6owv","updated":"20240607142928"},"Children":[{"Type":"NodeText","Data":"黄柏气寒．禀天冬寒之水气．入足少阴肾经．味苦无毒．得地南方之火味．入手少阴心经．气味俱降．阴也．五脏六腑．心为君主．心属火．结热．火气结也．味苦泄热．所以主之．黄胆．胃经湿热之症．肠痔．大肠火结之病．泄痢．大肠湿热之症．其主之者．黄柏入肾．肾者胃之关．大肠肾所主也．气寒能清．味苦能燥．故治以上诸症也．漏下赤白．胎漏下血及赤白带也．一因血热妄行．一因湿热下注．黄柏入肾．寒能清热．苦可燥湿．所以主之．阴阳蚀疮．阴户伤蚀成疮也．诸疮皆属心火．其主之者．苦寒泻火也．"}]},{"ID":"20240607142928-dt75kqn","Type":"NodeParagraph","Properties":{"id":"20240607142928-dt75kqn","updated":"20240607142928"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240607142928-84ic61j","Type":"NodeParagraph","Properties":{"id":"20240607142928-84ic61j","updated":"20240607142928"},"Children":[{"Type":"NodeText","Data":"黄柏同知母．滋阴降火．同茅术．除湿清热．治痿要药．同细辛．泻膀胱火．用蜜炙成末．煨大蒜丸．治妊娠下痢白色．同木瓜、白茯、二术、石斛、生地．治痿．同白芍、甘草．治火热腹痛．"}]},{"ID":"20240607142903-gdyg11q","Type":"NodeThematicBreak","Properties":{"id":"20240607142903-gdyg11q"}},{"ID":"20240607142908-8vv7qff","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142908-8vv7qff","updated":"20240607142920"},"Children":[{"Type":"NodeText","Data":"黄柏《本草述钩元》"}]},{"ID":"20240607142908-d54hh6u","Type":"NodeParagraph","Properties":{"id":"20240607142908-d54hh6u","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"性寒味苦。气味俱浓。沉而降。阴也。入足少阴经。为足太阳引经药。属金而有水与火。并走手厥阴经。（丹溪）主泻膀胱相火。补肾水不足。壮肾坚骨髓。治男子阴痿。下焦诸由湿利。治也。黄柏上能洗不离土数丈。"}]},{"ID":"20240607142908-4e9s54s","Type":"NodeParagraph","Properties":{"id":"20240607142908-4e9s54s","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"阳之气最聚而发生内热诸证。"}]},{"ID":"20240607142908-37lritg","Type":"NodeParagraph","Properties":{"id":"20240607142908-37lritg","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"可以湿伏。可以水灭。用黄连之属直折之。相火者。天火也。龙雷之火也。（火出水中。故名。）阴火也。不湿药中不可缺。"}]},{"ID":"20240607142908-72i0tyg","Type":"NodeParagraph","Properties":{"id":"20240607142908-72i0tyg","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"者。（又）凡邪热在下焦血分。不渴而小足膝气力涌出。和苍术谟）黄柏固为肾药。然下。佐牛膝枸杞地黄五得猪胆汁水银粉。主诸热虫疮久不合口。得铅丹。生肌止痛。得木瓜茯苓二术石斛地黄。除湿健步。佐白芍甘草。主火热腹痛。脏毒痔漏。下血不止。川蜜人乳糯米泔各浸透。炙干。切研。廪米饭丸。每空心温酒下三五十行。用柏根黄浓者。蜜炒令焦。为末。大蒜煨熟。去皮米饮下三五十丸。日三服。清心丸。主积日梦遗。心忪恍惚。"}]},{"ID":"20240607142908-z98wwvv","Type":"NodeParagraph","Properties":{"id":"20240607142908-z98wwvv","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"一钱。炼蜜丸梧子大。每服十五丸。麦冬汤下。（大智师）凤髓甘草五钱。为泻相火益肾水之妙剂。疮热疮。黄柏末一两。轻〔论〕丹溪谓黄柏有补阴泻火之功。然非阴中之火。不可用。夫阴火即水中之火。"}]},{"ID":"20240607142908-stxqlcn","Type":"NodeParagraph","Properties":{"id":"20240607142908-stxqlcn","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"乃人身元气之根蒂。宜温养。不宜寒泻者也。如先天元阴虚而相火炽。不独恃此味以获济。"}]},{"ID":"20240607142908-9uohl8s","Type":"NodeParagraph","Properties":{"id":"20240607142908-9uohl8s","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"惟是后天气血。或六淫七情以伤之。致累及元阴。元阴受伤。则水不配火。元阳不得元阴以宅之。于是少火化为壮火。举三焦元气。尽为之病矣。所谓阴虚则无气是也。此味本北方寒水所化。藉其同气相求。以助阴。而即以伏阳。（丹溪所谓从其性而伏之）助阴以育阳。则气食少火。元气回而肾阳自壮。骨髓自坚。所以能疗下焦痿厥也。不宁惟是。凡阴伤而阳亢。"}]},{"ID":"20240607142908-so5002h","Type":"NodeParagraph","Properties":{"id":"20240607142908-so5002h","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"亢阳即还以蚀阴。如骨蒸遗精失血等证。胥借此为要药矣。至于湿热之治。观本经首言五脏肠胃中结热。此便可参。盖水土合德以立地。而胃之三脘。皆根于任脉。肾之阴气不足。则热自结于胃。胃壅结热。则湿土之阴气无从施化。而还病于湿。是阴气不足。由肾及脾。肾与脾合病。斯五脏肠胃病于湿热之证多矣。本经所列黄胆肠痔泄痢及漏下赤白。固为病于湿热。即下焦痿厥瘫痪诸证。亦未有不合于中土之湿以为患者。丹溪治痿独取阳明。正为此也。"}]},{"ID":"20240607142908-066xxd3","Type":"NodeParagraph","Properties":{"id":"20240607142908-066xxd3","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"故味丹溪就其性而伏之一语。则知用黄柏非以水胜火。乃以水养火。味丹溪治痿独取阳明之义。则知用黄柏非止以肾阴得达于胃。更欲使胃阳得化于肾也。（盖热之结者。胃阳不得化。"}]},{"ID":"20240607142908-qt9nh2v","Type":"NodeParagraph","Properties":{"id":"20240607142908-qt9nh2v","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"肾阴达于胃。而胃阳化矣。）由肾合脾。何以取责于胃。盖柏皮达肾阴于脾。脾得为胃行三阳三阴之气。而肠胃之结热乃清。但三阳三阴之气。脾固为胃行之。而能行三阳三阴之气者。"}]},{"ID":"20240607142908-17bj64u","Type":"NodeParagraph","Properties":{"id":"20240607142908-17bj64u","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"则属之胃。故取责于胃耳。又元阴乃后天营血之母气。故丹溪酒炒末为潜行散入血分。最妙。"}]},{"ID":"20240607142908-xvzpgj2","Type":"NodeParagraph","Properties":{"id":"20240607142908-xvzpgj2","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"罗周彦曰。有先天元气之阴。即肾水母气所禀。元精之气是也。其真阴本体。则深藏于左肾之中。而真阴妙用。则默运于精神之内。是谓无形者也。后天元气之阴。即身中所化营血之母气。先天有形元气之阴也。此亦天赋自然之真。其体附藏于脾胃中。化见于人迎。故其脉在心部。而其用则见于血也。又曰。元阴不甚损。其有形肾水之阴暴伤。致相火动而乘于阴精之分为患者。知柏滋阴降火之法。可任用之。至于肾水中母气。先天元阴之精受伤。以致无根虚火为病。若妄投之。必反损其元而绝其生机矣。合二论观之。所谓损其元阴者。由伤其生身之精。损其肾水之母气也。肾水之阴暴伤。由病于后天之气血。而暴伤有形营血之母气也。盖肾水之阴。即营血之母。此处分晰极确。而后黄柏之可用不可用。庶乎无误。不至久用而寒中。亦不至当投而敛手。以致剂不中病也。"}]},{"ID":"20240607142908-yg1yyh1","Type":"NodeParagraph","Properties":{"id":"20240607142908-yg1yyh1","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"缪氏云。阴阳两虚之人。病兼脾胃薄弱。或泄泻恶冷。上热下寒。小便不禁者。咸忌。"}]},{"ID":"20240607142908-jsrptnt","Type":"NodeParagraph","Properties":{"id":"20240607142908-jsrptnt","updated":"20240607142908"},"Children":[{"Type":"NodeText","Data":"〔辨治〕蜀产皮浓二三分。色鲜黄者良。生用降实火。熟用不伤胃。酒制治上。盐制治"}]},{"ID":"20240607142843-3dua904","Type":"NodeThematicBreak","Properties":{"id":"20240607142843-3dua904"}},{"ID":"20240607142856-tkdc3vv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142856-tkdc3vv","updated":"20240607142901"},"Children":[{"Type":"NodeText","Data":"黄柏《本草备要》"}]},{"ID":"20240607142856-9tpbgxq","Type":"NodeParagraph","Properties":{"id":"20240607142856-9tpbgxq","updated":"20240607142856"},"Children":[{"Type":"NodeText","Data":"泻相火，补肾水"}]},{"ID":"20240607142856-6m4ts2z","Type":"NodeParagraph","Properties":{"id":"20240607142856-6m4ts2z","updated":"20240607142856"},"Children":[{"Type":"NodeText","Data":"苦寒微辛，沉阴下降。泻膀胱相火（足太阳引经药），补肾水不足，坚肾润燥（《发明》曰∶非真能补也。肾苦燥，急食辛以润之，肾欲坚，急食苦以坚之也，相火退而肾固，则无狂荡之患矣。按∶肾本属水，虚则热矣；心本属火，虚则寒矣），除湿清热。"}]},{"ID":"20240607142856-42ydoge","Type":"NodeParagraph","Properties":{"id":"20240607142856-42ydoge","updated":"20240607142856"},"Children":[{"Type":"NodeText","Data":"疗下焦虚，骨蒸劳热（阴虚生内热），诸痿瘫痪（热胜则伤血，血不荣筋，则软短而为拘。湿胜则伤筋，筋不束骨，则弛长而为痿。合苍术名二妙散，清热利湿，为治痿要药。或兼气虚、血虚、脾虚、肾虚、湿痰、死血者，当随证加治），目赤耳鸣（肾火），消渴便闭，黄胆水肿（王善夫病便闭，腹坚如石，腿裂出水，饮食不下，治以利小便药，遍服不效。东垣曰∶此奉养太过，膏梁积热，损伤肾水，致膀胱干涸，小便不化，火又逆上，而为呕哕，《难经》所谓关则不得小便，格则吐逆者。《内经》所谓无阴则阳无以化也。遂处以北方大苦寒之剂，黄柏、知母各一两，酒洗焙研，桂一钱为引，名滋肾丸，每服二百丸，未几，前阴如刀刺火烧，溺出床下成流，肿胀遂消）。水泻热痢，痔血肠风，漏下赤白（皆湿热为病），诸疮痛痒，头疮（研末敷之）口疮（蜜炒研含。凡口疮用凉药不效者，乃中气不足，虚火上炎。宜用反治之法，参、术、甘草补上之虚，干姜散火之际。甚者加附子，或噙官桂，引火归元），杀虫安蛔。久服伤胃，尺脉弱者禁用（若虚火上炎，服此苦寒之剂，有寒中之变。"}]},{"ID":"20240607142856-swj6w7l","Type":"NodeParagraph","Properties":{"id":"20240607142856-swj6w7l","updated":"20240607142856"},"Children":[{"Type":"NodeText","Data":"时珍曰∶知母佐黄柏，滋阴降火，有金水相生之义。古云黄柏无知母，犹水母之无虾也。盖黄柏能制命门、膀胱阴中之火，知母能清肺金、滋肾水之化源。丹溪曰∶君火者，人火也，心火也。可以水灭，可以直折，黄连之属，可以制之。相火者，天火也，龙雷之火也。阴火也，不可以水湿制之，当从其性而伏之，惟黄柏之属，可以降之。按∶火有虚火、实火、燥火、湿火、郁火、相火之异。虚火宜补，实火宜泻，燥火宜滋润，郁火宜升发。湿火由湿郁为热，多病 肿。经所谓诸腹胀大，皆属于热；诸病 肿，皆属于火是也。宜利湿清热而兼补脾。相火寄于肝肾，乃龙雷之火，非苦寒所能胜，宜滋阴养血，壮水之主，以制阳光。又按∶诸病之中，火证为多，有本经自病者，如忿怒生肝火，焦思生心火之类是也；有子母相克者，如金火克肺金，肝木克脾火之类是也；有脏腑相移者，如肺火咳嗽，久则移热于大肠而泄泻，心火烦焦，久则移热于小肠，而为淋闭之类是也。又有别经相移者，有数经合病者，当从其重者而治之）。"}]},{"ID":"20240607142856-6w2fnn5","Type":"NodeParagraph","Properties":{"id":"20240607142856-6w2fnn5","updated":"20240607142856"},"Children":[{"Type":"NodeText","Data":"川产、肉浓色深者良。生用降实火，蜜炙则不伤胃，炒黑能止崩带。酒制治上，蜜制治中，盐制治下（又末乳调，能涂冻疮）。"}]},{"ID":"20240607142722-bjuavs6","Type":"NodeThematicBreak","Properties":{"id":"20240607142722-bjuavs6"}},{"ID":"20240607142838-tib7e3f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142838-tib7e3f","updated":"20240607142846"},"Children":[{"Type":"NodeText","Data":"黄柏《神农本草经读》"}]},{"ID":"20240607142838-7md8ulr","Type":"NodeParagraph","Properties":{"id":"20240607142838-7md8ulr","updated":"20240607142838"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主五脏肠胃中结热，黄胆，肠痔，止泄痢，女子漏下赤白，阴伤蚀疮。"}]},{"ID":"20240607142838-tnrtydd","Type":"NodeParagraph","Properties":{"id":"20240607142838-tnrtydd","updated":"20240607142838"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶黄柏气寒，禀天冬寒之水气。味苦无毒，得地南方之火味；皮浓色黄，得太阴中土之化。五脏为阴，凡经言主五脏者，皆主阴之药也。治肠胃中热结者，寒能清热也。治黄疸、肠痔者，苦能胜湿也。止泄利者，湿热泄痢，唯苦寒能除之，而且能坚之也。"}]},{"ID":"20240607142838-ci3dtn3","Type":"NodeParagraph","Properties":{"id":"20240607142838-ci3dtn3","updated":"20240607142838"},"Children":[{"Type":"NodeText","Data":"女子胎漏下血，因血热妄行；赤白带下，及阴户伤蚀成疮，皆因湿热下注；黄柏寒能清热，苦可燥湿，所以主之。然皆正气未伤，热毒内盛，有余之病，可以暂用，否则不可姑试也。"}]},{"ID":"20240607142838-bvg3ven","Type":"NodeParagraph","Properties":{"id":"20240607142838-bvg3ven","updated":"20240607142838"},"Children":[{"Type":"NodeText","Data":"凡药之燥者，未有不热；而寒者，未有不湿；黄柏于清热之中，而兼燥湿之效。"}]},{"ID":"20240607142801-o9sxk3i","Type":"NodeThematicBreak","Properties":{"id":"20240607142801-o9sxk3i"}},{"ID":"20240607142828-j9wmyds","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142828-j9wmyds","updated":"20240607142833"},"Children":[{"Type":"NodeText","Data":"黄柏《医学入门》"}]},{"ID":"20240607142828-lfyvyha","Type":"NodeParagraph","Properties":{"id":"20240607142828-lfyvyha","updated":"20240607142828"},"Children":[{"Type":"NodeText","Data":"黄柏苦解五脏热，疸痢痔崩诸疮疖，安蛔除痿小腹疼，无非火泻水不越。"}]},{"ID":"20240607142828-6rymdgj","Type":"NodeParagraph","Properties":{"id":"20240607142828-6rymdgj","updated":"20240607142828"},"Children":[{"Type":"NodeText","Data":"柏，巨也。木大而皮浓实鲜黄者佳，俗名黄柏。气寒，无毒。沉而降，阴也。足少阴手厥阴本药，足太阳引经药。主五脏肠胃中结热，黄胆，肠中痔，止泄痢，女子崩中，带下赤白。阴伤蚀疮，男子茎上疮，煮汁洗，更为末敷之。蜜炙为末治口疮，佐以细辛尤神。又蜜炙入青黛、龙脑一字，治颊舌疮，吐涎而愈。眼赤、鼻、喉痹及痈疽、发背、乳痈、脐疮亦用。东垣云∶泻下焦隐伏之龙火，安上出虚哕之蛔虫。单制而能补肾不足，生用而能补阴痿厥。凡下体有湿，瘫痪肿痛，及膀胱有火，小便黄，小腹虚痛者，必用之。兼治外感肌热，内伤骨热，失血遗精阴痿。抑考黄连入心，栀、芩入肺，黄柏入肾，肾苦燥停湿，柏味微辛而能润燥，性利下而能除湿，故为肾经主药。然《本经》谓其主五脏热者，盖相火狂越上冲，肠胃干涸，五脏皆火。以上诸证，皆火之所为，湿亦火之郁而成也。用以泻火，则肾水自固而无狂越漏泄之患。所谓补肾者，亦此意也。"}]},{"ID":"20240607142828-rem182c","Type":"NodeParagraph","Properties":{"id":"20240607142828-rem182c","updated":"20240607142828"},"Children":[{"Type":"NodeText","Data":"丹溪谓肾家无火而两尺脉微，或左尺独旺者，皆不宜用。惟两尺脉俱旺者最宜。铜刀削去粗皮，生蜜水浸半日，取出炙干，再涂蜜慢火炙之，每两炙尽生蜜六钱为度。入下部盐酒炒，火盛者童便浸蒸。恶干漆。"}]},{"ID":"20240617104254-yud4gmg","Type":"NodeThematicBreak","Properties":{"id":"20240617104254-yud4gmg"}},{"ID":"20240617104256-1zrhyk3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104256-1zrhyk3","updated":"20240617104301"},"Children":[{"Type":"NodeText","Data":"黄柏《汤液本草》"}]},{"ID":"20240617104256-xoudg9y","Type":"NodeParagraph","Properties":{"id":"20240617104256-xoudg9y","updated":"20240617104256"},"Children":[{"Type":"NodeText","Data":"气寒，味苦。苦浓微辛，阴中之阳，降也。无毒。"}]},{"ID":"20240617104256-134z3tf","Type":"NodeParagraph","Properties":{"id":"20240617104256-134z3tf","updated":"20240617104256"},"Children":[{"Type":"NodeText","Data":"足太阳经引经药，足少阴经之《象》云∶治肾水膀胱不足，诸痿厥，脚膝无力，于黄 汤中少加用之，使两膝中气力涌出，痿即去矣。蜜炒此一味，为细末，治口疮如神。瘫痪必用之药。"}]},{"ID":"20240617104256-rlclsw2","Type":"NodeParagraph","Properties":{"id":"20240617104256-rlclsw2","updated":"20240617104256"},"Children":[{"Type":"NodeText","Data":"《珍》云∶泻膀胱之热，利下窍。"}]},{"ID":"20240617104256-ezidu5d","Type":"NodeParagraph","Properties":{"id":"20240617104256-ezidu5d","updated":"20240617104256"},"Children":[{"Type":"NodeText","Data":"《心》云∶太阳经引经药，泻膀胱经火，补本经及肾不足。苦寒安蛔，疗下焦虚，坚肾。经曰∶苦以坚之。"}]},{"ID":"20240617104256-r0c12uw","Type":"NodeParagraph","Properties":{"id":"20240617104256-r0c12uw","updated":"20240617104256"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主五脏，肠胃中结热，黄胆，肠痔；止泄痢，女子漏下赤白，阴伤蚀疮，疗惊气，在皮间肌肤热，赤起，目热赤痛，口疮。久服，通神。"}]},{"ID":"20240617104256-a1t16hk","Type":"NodeParagraph","Properties":{"id":"20240617104256-a1t16hk","updated":"20240617104256"},"Children":[{"Type":"NodeText","Data":"《液》云∶足少阴剂，肾苦燥，故肾停湿也，栀子、黄芩入肺，黄连入心，黄柏入肾，燥湿所归，各从其类也。《活人书》解毒汤，上下内外通治之。恶干漆。"}]},{"ID":"20240617104420-gn8lj0w","Type":"NodeThematicBreak","Properties":{"id":"20240617104420-gn8lj0w"}},{"ID":"20240617104421-kejxnxo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104421-kejxnxo","updated":"20240617104425"},"Children":[{"Type":"NodeText","Data":"黄柏《长沙药解》"}]},{"ID":"20240617104421-sav7eoa","Type":"NodeParagraph","Properties":{"id":"20240617104421-sav7eoa","updated":"20240617104421"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】蘖木。味苦寒。主五藏，肠胃中结热，黄疸，肠痔，止泄利，女子漏下赤白，阴阳蚀创。一名檀桓。生山谷。"}]},{"ID":"20240617104421-nwc8b4l","Type":"NodeParagraph","Properties":{"id":"20240617104421-nwc8b4l","updated":"20240617104421"},"Children":[{"Type":"NodeText","Data":"味苦，气寒，入足厥阴肝、足太阴脾经。泻己土之湿热，清乙木之郁蒸，调热利下重，理黄疸腹满。"}]},{"ID":"20240617104421-alfe6vg","Type":"NodeParagraph","Properties":{"id":"20240617104421-alfe6vg","updated":"20240617104421"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌梅丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在乌梅。"},{"Type":"NodeText","Data":"用之治厥阴伤寒，气上撞心，心中疼热，食即吐蛔。以木郁则虫化，郁冲而生上热，黄柏泻郁升之上热而杀蛔虫也。"}]},{"ID":"20240617104421-3gajn9u","Type":"NodeParagraph","Properties":{"id":"20240617104421-3gajn9u","updated":"20240617104421"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"白头翁汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在白头翁。"},{"Type":"NodeText","Data":"用之治厥阴病，热利下重者。以木郁则利作，郁陷而生下热，黄柏泻郁陷之下热而举重坠也。"}]},{"ID":"20240617104421-uxaij6a","Type":"NodeParagraph","Properties":{"id":"20240617104421-uxaij6a","updated":"20240617104421"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栀子柏皮汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在栀子。"},{"Type":"NodeText","Data":"用之治太阴病，身黄发热者。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大黄硝石汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在大黄。"},{"Type":"NodeText","Data":"用之治黄疸腹满，小便不利者。以乙木湿陷，不能疏泄，郁生下热，传于膀胱，水窍不开，溢于经络，则身黄腹满而发热，黄柏泻湿热而清膀胱也。"}]},{"ID":"20240617104421-fwjyulv","Type":"NodeParagraph","Properties":{"id":"20240617104421-fwjyulv","updated":"20240617104421"},"Children":[{"Type":"NodeText","Data":"阳衰土湿，乙木不达，抑遏而生湿热。冲于胃口，则心中疼热，陷于大肠，则热利下重，郁于膀胱，淫于肌肤，则腹满身黄。黄柏苦寒迅利，疏肝脾而泻湿热，清膀胱而排瘀浊，殊有捷效，最泻肝肾脾胃之阳。后世庸工，以此为滋阴补水之剂，著书立说，传流不息，误人多矣。"}]},{"ID":"20240617104421-brzvsyk","Type":"NodeParagraph","Properties":{"id":"20240617104421-brzvsyk","updated":"20240617104421"},"Children":[{"Type":"NodeText","Data":"黄柏清脏腑之湿热，柏皮清经络之湿热，故发热身黄用柏皮。"}]},{"ID":"20240617104440-lrld1y9","Type":"NodeThematicBreak","Properties":{"id":"20240617104440-lrld1y9"}},{"ID":"20240617104441-cb9gz0o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104441-cb9gz0o","updated":"20240617104445"},"Children":[{"Type":"NodeText","Data":"黄柏《顾松园医镜》"}]},{"ID":"20240617104441-dituvo8","Type":"NodeParagraph","Properties":{"id":"20240617104441-dituvo8","updated":"20240617104441"},"Children":[{"Type":"NodeText","Data":"〔苦寒，入肾经。〕生用则降实火，丸用则不伤胃。治上酒炒，治中蜜炒，治下盐炒。肥浓鲜黄者佳。〕泻龙火而救肾水，〔伏火煎熬，则肾水渐涸、丹溪谓其滋阴降火者，以其泻阴中之火、而阴不受伤也。〕止梦遗而止下消。利水窍涩痛，〔皆肾阴虚而相火旺之所致。〕除目赤肿疼。〔阴虚血热之故。〕治阴疮而理带下，〔皆湿热乘阴虚流客下部而成。阴疮有二种∶一者阴饮作旧脓出，一者只生热疮，煎汤洗之，仍同芩、连为末涂之。男女俱患之。凡热病遗毒，手足肿痛欲断，取五斤，煎汤渍之。冬月向火，火毒入内，两股生疮，其汁淋漓，糊之立愈。诸疮大痛宜用之。。〕止便血而杀疳虫，〔止便血者清肠之力，味苦故能杀虫。〕疝疼香港脚皆堪疗，〔善治下焦湿热作肿及痛，故香港脚最效，病疼因肾虚湿热邪乘者宜之。〕痢疾疸家尽可医。〔亦皆除湿热之功。〕口舌生疮至效，〔蜜水浸之，时时噙嗽兼饮之甚良。〕足膝痿软如神。〔元素谓诸痿瘫痪必用之药。〕泻阴火，除湿热，是其本功。"}]},{"ID":"20240617104441-kpdcaye","Type":"NodeParagraph","Properties":{"id":"20240617104441-kpdcaye","updated":"20240617104441"},"Children":[{"Type":"NodeText","Data":"苦寒之性，利于实热，不利于虚热，凡胃虚食少，脾虚泻多忌之，肾虚五更溏泄勿用。"}]},{"ID":"20240617104430-w3gm2zg","Type":"NodeThematicBreak","Properties":{"id":"20240617104430-w3gm2zg"}},{"ID":"20240617104431-b7azhh4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104431-b7azhh4","updated":"20240617104435"},"Children":[{"Type":"NodeText","Data":"黄柏《本草崇原》"}]},{"ID":"20240617104431-1vg64v7","Type":"NodeParagraph","Properties":{"id":"20240617104431-1vg64v7","updated":"20240617104431"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治五脏肠胃结热，黄胆，肠痔，止泄痢，女子漏下赤白，阴伤蚀疮。（柏，音百，俗作黄柏，省笔之讹。）"}]},{"ID":"20240617104431-f4uz0kh","Type":"NodeParagraph","Properties":{"id":"20240617104431-f4uz0kh","updated":"20240617104431"},"Children":[{"Type":"NodeText","Data":"（黄柏木出汉中山谷及永昌、邵陵、房商、山东诸处皆有。今以蜀中出者，皮浓色深为佳，树高数丈，叶似紫椿，经冬不凋，皮外白里深黄色，入药用其根结块，如松下茯苓。）"}]},{"ID":"20240617104431-xvpxgfw","Type":"NodeParagraph","Properties":{"id":"20240617104431-xvpxgfw","updated":"20240617104431"},"Children":[{"Type":"NodeText","Data":"黄柏气味苦寒，冬不落叶，禀太阳寒水之精。皮浓色黄，质润稠粘，得太阴中土之化。"}]},{"ID":"20240617104431-9bir5q6","Type":"NodeParagraph","Properties":{"id":"20240617104431-9bir5q6","updated":"20240617104431"},"Children":[{"Type":"NodeText","Data":"盖水在地之下，水由地中行，故主治五脏肠胃中之结热，黄胆，肠痔。治结热者，寒能清热也。"}]},{"ID":"20240617104431-55i9hk1","Type":"NodeParagraph","Properties":{"id":"20240617104431-55i9hk1","updated":"20240617104431"},"Children":[{"Type":"NodeText","Data":"治黄胆、肠痔者，苦能胜湿也。止泄痢者，先热泄而后下痢，黄柏苦寒，能止之也。女子漏下赤白，阴伤蚀疮，皆湿热下注之病。苦胜湿而寒清热，故黄柏皆能治之也。以上主治，皆正气无亏，热毒内盛，所谓下者举之，结者散之，热者寒之，强者泻之，各安其气，必清必静，则病气衰气，归其所宗，此黄柏之治皆有余之病也。如正气稍虚，饮食不强，盒饭禁用。"}]},{"ID":"20240617104431-oahvyzf","Type":"NodeParagraph","Properties":{"id":"20240617104431-oahvyzf","updated":"20240617104431"},"Children":[{"Type":"NodeText","Data":"愚按∶黄柏禀寒水之精，得中土之化，有交济阴阳，调和水火之功，所治至广。而《珍珠囊药性》云∶黄柏疮用，一言蔽之。后人徒事歌括者，信为疮药而已。其曰珍珠，殆以鱼目欺世尔。"}]},{"ID":"20240617104408-q1rjo7r","Type":"NodeThematicBreak","Properties":{"id":"20240617104408-q1rjo7r"}},{"ID":"20240617104409-e1qwlug","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104409-e1qwlug","updated":"20240617104413"},"Children":[{"Type":"NodeText","Data":"黄柏《本草思辨录》"}]},{"ID":"20240617104409-90asm2m","Type":"NodeParagraph","Properties":{"id":"20240617104409-90asm2m","updated":"20240617104409"},"Children":[{"Type":"NodeText","Data":"黄柏为五脏肠胃清湿热之药，表里上下俱到。表有热可治，表不热而里热亦可治。色黄入肠胃，皮入肺，微辛亦入肺，气味俱浓，性寒而沉入肝肾，入胃则亦入脾，入肾则亦入心。"}]},{"ID":"20240617104409-qy6nr8u","Type":"NodeParagraph","Properties":{"id":"20240617104409-qy6nr8u","updated":"20240617104409"},"Children":[{"Type":"NodeText","Data":"本经所以主五脏肠胃中结热也。性寒已热，燥则除湿，故本经所列黄胆、肠痔、泄痢、女子漏下赤白、阴伤蚀疮，皆属湿热之 别录又补出惊气在皮间、肌肤热赤起、目热赤痛、口疮，则所谓五脏肠胃者悉备矣。大抵湿下溜而火上出，别录所主虽不属湿，而其因未始非湿。观仲圣栀子柏皮汤、大黄硝石汤治黄胆，为阳明病。白头翁汤治热痢，乌梅丸治呕吐久痢，为阳明兼厥阴病。外台大黄汤，更治天行壮热，黄柏一味，实赅五脏肠胃，故其用颇广。若以治少阴与萸地知母为伍，则肾中不必有湿，否则如其分以施之，必得如二妙散为当。盖苦燥之物，无不劫阴，以黄柏为滋阴之剂者非也。"}]},{"ID":"20240617104359-95olwxl","Type":"NodeThematicBreak","Properties":{"id":"20240617104359-95olwxl"}},{"ID":"20240617104400-p3fyfmt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104400-p3fyfmt","updated":"20240617104404"},"Children":[{"Type":"NodeText","Data":"黄柏《本草求真》"}]},{"ID":"20240617104400-xmxptbw","Type":"NodeParagraph","Properties":{"id":"20240617104400-xmxptbw","updated":"20240617104400"},"Children":[{"Type":"NodeText","Data":"（乔木）大泻肾火及除膀胱湿邪"}]},{"ID":"20240617104400-jvfpj9g","Type":"NodeParagraph","Properties":{"id":"20240617104400-jvfpj9g","updated":"20240617104400"},"Children":[{"Type":"NodeText","Data":"黄柏（专入肾。兼入膀胱）。昔人同知母用于六味丸中。名为知柏八味丸。又同知柏各一两。酒洗焙研。入桂。名为滋肾丸。（时珍曰。知佐黄柏。滋阴降火。有金水相生之义。古云黄柏无知母。犹水母之无虾也。盖黄柏能制命门膀胱阴中之火。知母能清肺金。滋肾水之化源。）谓其可滋真阴。此说一出。而天下翕然宗之。以至于今。牢不可破。讵知黄柏性禀至阴。味苦性寒。行隆冬肃杀之令。故独入少阴。入膀胱。（好古曰。黄芩栀子入肺。黄连入心。黄柏入肾燥湿。所归各从其类也。震亨曰。火有二。君火者人火也。心火也。可以湿伏。可以水灭。可以直折。黄连之属可以制之。相火者天火也。龙雷之火也。阴火也。不可以水湿折之。当从其性而伏之。惟黄柏之属可以降之。）凡人病因火亢而见骨蒸劳热。目赤耳鸣。消渴便闭。及湿热为病而见诸痿瘫痪。（瘫痪本有气虚血虚脾虚肾虚湿痰死血之别。但因热伤血。血不养筋。而致 短而拘。湿则伤筋。筋不束骨而致弛长而痿。宜用苍术黄柏。名二妙散以治。）水利。黄胆水肿。（杲曰。长安王善夫病小便不通。渐成中满。腹坚如石。脚腿裂破出水。双睛凸出。饮食不下。痛苦莫可名状。治通利小便渗泄之药。服遍矣。予诊之曰。此乃奉养太过。膏粱积热。损伤肾水。致膀胱久而干枯涸。小便不化。火又逆上而为呕哕。难经所谓关则不得小便。格则吐逆者。遂处以北方大苦寒之剂。黄柏知母各一两。酒洗焙研。入桂一钱为引。为丸。每服二百丸。少焉前阴如刀刺火烧。涌如瀑泉涌出。床下成流。顾盼之间。肿胀消散矣！）痔血疡风。漏下赤白。（皆湿热为病。）与夫诸痛疮痒。蛔虫内攻。（外台治口舌生疮。用黄柏含之良。深师用蜜渍取汁含之。吐蛔。寇氏衍义治心脾有热。舌颊生疮。用蜜炙黄柏青黛各一分为末。入生龙脑一字掺之吐涎。越筵散用黄柏细辛等分为末掺。或用黄柏干姜等分亦良。但用良药不效者。须察脉症。或因中气不足。虚火上炎。宜用参术甘草干姜附子之类。或噙官桂引火归元。）诊其尺果洪大。按之有力。可炒黑暂用。使其湿热顺流而下。阴火因尔潜伏。则阴不受煎熬。而阴乃得长矣。非谓真阴虚损。服此即有滋润之力也。（发明曰。非真能补也。肾苦燥。急食辛以润之。肾欲坚。急食苦以坚之也。相火退而肾固。则无狂荡之患矣。按肾本属水。虚则热。心本属火。虚则寒。）故于实热实火则宜。（时珍曰。东垣丹溪皆以黄柏为滋肾降火要药。上古所未言也。盖气为阳。血为阴。邪火煎熬。则阴血渐涸。故阴虚火动之病须之。然必少壮气盛能食者。用之相宜。）而于虚热虚火。则徒有损而无益。（时珍曰。若中气不足，而邪火炽盛者。久服则有寒中之变。近时虚损及纵欲求嗣之人。用补阴药。往往以此二味为君。日日服饵。降令太过。脾胃受伤。真阳暗损。精气不暖。致生他病。盖不知此苦寒而滑泄。且苦味久服。有反从火化之害。故叶氏医学统旨有四物加知母黄柏。久服伤胃不能生阴之戒。汪昂曰。按火有虚火实火燥火湿火相火郁火之异。虚火宜补。实火宜泻。燥火宜滋润。郁火宜升发。湿火由湿郁为热。多病 肿。经所谓诸腹胀大。皆属于热。诸病 肿。皆属于火是也。宜利湿清热而兼补脾。相火寄于肝肾。乃龙雷之火。非苦寒所能胜。宜滋肾养血。壮水之主。以制阳光。又按诸病之中。火症为多。有本经自病者。如忿怒生肝火。焦思生心火之类是也。有子母相克者。如心火克肺金。肝火克脾土之类是也。有脏腑相移者。如肺火咳嗽。久则移热于大肠而泄泻。心火烦焦。久则移热于小肠而为淋闭之类是也。又有别经相移者。有数经合病者。当从其重者而治之。）奈今天下人。不问虚实。竟有为去热治劳之妙药。而不知阴寒之性。能损人气。减人食。命门真元之火。一见而消亡。脾胃营运之职。一见而沮丧。元气既虚。又用苦寒。遏绝生机。莫此为甚。川产肉浓色深者良。生用降实火。蜜炙则不伤胃。炒黑能止崩带。酒制治上。蜜制治中。盐制治下。"}]},{"ID":"20240617104348-kel3po3","Type":"NodeThematicBreak","Properties":{"id":"20240617104348-kel3po3"}},{"ID":"20240617104349-wvkwrn7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104349-wvkwrn7","updated":"20240617104353"},"Children":[{"Type":"NodeText","Data":"黄柏《本草新编》"}]},{"ID":"20240617104349-pzi4y6a","Type":"NodeParagraph","Properties":{"id":"20240617104349-pzi4y6a","updated":"20240617104349"},"Children":[{"Type":"NodeText","Data":"黄柏，味苦、微辛，气寒，阴中之阴，降也。无毒。乃足少阴妙药，又入足太阳。专能退火解热，消渴最效，去肠风，止血痢，逐膀胱结热，治赤带，泻肾中相火，亦能平肝明目，其余《本草》所载功效，俱不可尽信也。盖黄柏乃至阴之物，其性寒冷，只可暂用以降火，而不可长用以退热。试思阴寒之地，不生草木，岂阴寒之药，反生精髓。黄柏有泻而无补，此可必信者也。如遇阴虚火动之人，用黄柏以泻火，不若用元参以降火也。万不得已而用黄柏，亦宜与肉桂同用，一寒一热，水火有相济之妙，庶不致为阴寒之气所逼，至于损胃而伤脾也。"}]},{"ID":"20240617104349-qlxndr4","Type":"NodeParagraph","Properties":{"id":"20240617104349-qlxndr4","updated":"20240617104349"},"Children":[{"Type":"NodeText","Data":"或疑丹溪朱公，专以阴虚火动立论，其补阴，丹溪以黄柏、肉桂同用，未尝教人尽用黄柏、知母也。而吾子讥其太过，毋乃已甚乎？嗟乎。人生于火，原宜培火，不宜损火也。火之有余，实水之不足。因水之不足，乃现火之有余。火盛者，补水而火自息，不必去泻火也。自丹溪创阴虚火动之说，其立论为千古之不磨，而其立方不能无弊，用黄柏、知母于肉桂之中，不用熟地、山茱为君，乌可为训乎。"}]},{"ID":"20240617104349-h7z0upu","Type":"NodeParagraph","Properties":{"id":"20240617104349-h7z0upu","updated":"20240617104349"},"Children":[{"Type":"NodeText","Data":"或疑黄柏苦寒泻火，是泻火有余，而补水不足，入于大补阴之内，少用之，以退阴虚之火，不识亦可乎？曰∶不可也。黄柏泻火而不补水也。惟是阴虚火大动，用黄柏于大补真阴之药，如熟地、山茱萸、北五味之类，可暂用以退火。倘阴虚而火微动者，亦断不可用。盖阴火之大盛者，退火而火少息；阴火之微动者，退火而火愈起。总之，虚火旺宜泻，而虚火衰宜补也。"}]},{"ID":"20240617104349-02fckvl","Type":"NodeParagraph","Properties":{"id":"20240617104349-02fckvl","updated":"20240617104349"},"Children":[{"Type":"NodeText","Data":"或问知母、黄柏，同是苦寒之药，用一味以泻虚火，未必无功，必要加用二味，与仲景张公并驾齐驱，反致误事，使后人讥之，是则丹溪之失也。嗟乎！虚火之沸腾，乃真水之亏损，用六味以生水制火，尚恐水不能以遽生，而火不可遽制。况用苦寒之黄柏、知母，使水之不生，又何以制火哉。在丹溪欲制火以生水，谁知制火而水愈不生耶。用知母、黄柏之一味，似乎轻于二味并用，然而，水一遇寒凉即不生，正不必二味之兼用也。"}]},{"ID":"20240617104338-8fezmim","Type":"NodeThematicBreak","Properties":{"id":"20240617104338-8fezmim"}},{"ID":"20240617104340-kb5j3ip","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104340-kb5j3ip","updated":"20240617104343"},"Children":[{"Type":"NodeText","Data":"黄柏《本经逢原》"}]},{"ID":"20240617104340-mpy6g2k","Type":"NodeParagraph","Properties":{"id":"20240617104340-mpy6g2k","updated":"20240617104340"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根名檀桓"}]},{"ID":"20240617104340-jbac57l","Type":"NodeParagraph","Properties":{"id":"20240617104340-jbac57l","updated":"20240617104340"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。生用降实火。酒制治阴火上炎。盐制治下焦之火。姜制治中焦痰火，姜汁炒黑治湿热。盐酒炒黑治虚火。阴虚火盛，面赤戴阳，附子汁制。"}]},{"ID":"20240617104340-bc6c32w","Type":"NodeParagraph","Properties":{"id":"20240617104340-bc6c32w","updated":"20240617104340"},"Children":[{"Type":"NodeText","Data":"《本经》主五脏肠胃中结热，黄瘅肠痔，止泄痢，女子漏下赤白，阴伤蚀疮。檀桓主心腹百病，安魂魄，不饥渴，久服轻身延年通神。"}]},{"ID":"20240617104340-fwvjd4z","Type":"NodeParagraph","Properties":{"id":"20240617104340-fwvjd4z","updated":"20240617104340"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"黄柏苦燥，为治三阴湿热之专药。详《本经》主治皆湿热伤阴之候，即漏下赤白，亦必因热邪伤阴，火气有余之患，非崩中久漏之比。其根治心腹百病，魂魄不安，皆火内亢之候。仲景栀子柏皮汤治身黄发热得其旨矣。按∶黄柏味浓而降，入肾经血分。凡肾水膀胱不足，诸痿厥无力，于黄 汤中加用，使两足膝中气力涌出，痿弱即愈。黄柏、苍术乃治痿要药。凡下焦湿热肿痛，并膀胱火邪，小便不利及黄涩者并宜，黄柏、知母为君，茯苓、泽泻为佐。凡小便不通而渴者，邪热在气分，主治在肺不能生水。不渴者，邪热在血分，主治在膀胱不能化气，亦宜黄柏、知母。昔人病小便不通，腹坚如石，脚腿裂水，双睛凸出，遍服治满利小便药不效，此高粱积热损伤肾水，致膀胱不化火气，上逆而为呕哕，遂以滋肾丸主之。方用黄柏、知母，入桂为引导，服少时，前阴如火烧，溺即涌出，顾盼肿消。《金匮》治误食自死，六畜肉中毒，用黄柏屑捣服方寸匕解之，不特治高粱积热。盖苦以解毒，寒以泄热也。大抵苦寒之性利于实热，不利于虚热。凡脾虚少食，或呕或泻或好热恶寒，或肾虚五更泄泻，小便不禁，少腹冷痛，阳虚发热，瘀血停止，产后血虚发热，痈疽肿后发热，阴虚小便不利，痘后脾虚小便不利，血虚烦躁不眠等证，法皆忌之。一种小而实如酸石榴者名曰小柏。性亦不甚相远，《千金翼》阿伽佗丸用之。"}]},{"ID":"20240617104316-550f04i","Type":"NodeThematicBreak","Properties":{"id":"20240617104316-550f04i"}},{"ID":"20240617104318-iby2w31","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104318-iby2w31","updated":"20240617104322"},"Children":[{"Type":"NodeText","Data":"黄柏《本草便读》"}]},{"ID":"20240617104318-pf6bs4y","Type":"NodeParagraph","Properties":{"id":"20240617104318-pf6bs4y","updated":"20240617104318"},"Children":[{"Type":"NodeText","Data":"苦寒坚肾．泻相火以制阳光．辛燥入阴．除湿热而安下部．（黄柏其质虽皮．其气味皆苦寒沉降．故独入肾与膀胱．清泄下焦湿火．而安肾水．至所以治口疮．清肺部上焦之热者．即用皮意．究非专治之药．虽清上而仍赖其降下耳．）"}]},{"ID":"20240617104327-npat11i","Type":"NodeThematicBreak","Properties":{"id":"20240617104327-npat11i"}},{"ID":"20240617104328-uge69eg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104328-uge69eg","updated":"20240617104332"},"Children":[{"Type":"NodeText","Data":"黄柏《冯氏锦囊秘录》"}]},{"ID":"20240617104328-1c620kw","Type":"NodeParagraph","Properties":{"id":"20240617104328-1c620kw","updated":"20240617104328"},"Children":[{"Type":"NodeText","Data":"禀至阴之气，得清寒之性，味苦，性寒，无毒。入足少阴肾经，阴虚内热之要药。以至阴之气，补至阴之不足也。然实热阳强之症则有功，虚热阳虚之症所切忌。入剂宜蜜浸一宿，炙黄，若入肾经药，宜盐酒浸透，炒褐色。若入口疳敷药，晒燥不见火。"}]},{"ID":"20240617104328-l7n9pt0","Type":"NodeParagraph","Properties":{"id":"20240617104328-l7n9pt0","updated":"20240617104328"},"Children":[{"Type":"NodeText","Data":"黄柏，使下焦湿热散行，泻阴伏龙火，除骨蒸补肾强阴，洗肝明目，五脏肠胃中结热，黄胆肠痔泄痢，泻相火有余，救肾水不足。得知母滋阴降火，为治痨之需；得苍术除湿清热，为治痿之要。口疮虫疥，并堪敷治。肠风连下血者殊功，热痢先见血者神效，膀胱中结热，女人带漏阴伤蚀疮，然云补阴者，以火退而阴长，非有补功也，况实火可治，虚火宜补，人非此火，不能有生，用此以泻火者，是伤其生气也，惟湿热实热暂用之。若肾虚脾薄之人，所当痛绝也。"}]},{"ID":"20240617104328-gnvnadh","Type":"NodeParagraph","Properties":{"id":"20240617104328-gnvnadh","updated":"20240617104328"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 宜酒制炒，用主五脏，肠胃中结热，目痛口疮，泻膀胱热。清小便，降相火，入肾定燥，解诸毒瓦斯，然痘疮中非常用也，脾虚泻泄者切忌。"}]},{"ID":"20240617104328-i8nf2in","Type":"NodeParagraph","Properties":{"id":"20240617104328-i8nf2in","updated":"20240617104328"},"Children":[{"Type":"NodeText","Data":"按∶黄柏性寒，行隆冬肃杀之令，故独入少阴，泻有余之相火。必尺中洪大，按之有力，可炒黑暂用。昔人称其补阴者，非其性也，盖热去则阴不受伤耳，利于实热而不利于虚热耳。奈今天下不问虚实，竟以为去热治劳之妙药，而不知阴寒之性，能伤人气，减人食，命门真元之火一见而消亡。脾胃营运之职一见而阻丧。元气既虚又用苦寒，遏绝生机，莫此为甚。"}]},{"ID":"20240617104306-2n30fup","Type":"NodeThematicBreak","Properties":{"id":"20240617104306-2n30fup"}},{"ID":"20240617104308-dhj4tbu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104308-dhj4tbu","updated":"20240617104312"},"Children":[{"Type":"NodeText","Data":"黄柏《本草简要方》"}]},{"ID":"20240617104308-4wjnp78","Type":"NodeParagraph","Properties":{"id":"20240617104308-4wjnp78","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"主治。滋阴。降火。清热。杀虫。壮骨髓。利下焦。泻膀胱相火。补肾水不足。肌肤赤热。气逆脉波黄胆。骨蒸。时行赤目。目昏耳鸣。鼻衄。喉肿。喉痹。心热。心痛。五脏结热肠风。痔血。血痢下血。阴痿消渴。尿多。小便不通。妇人妊娠下痢。阴蚀。小儿囟肿。"}]},{"ID":"20240617104308-c6ii81c","Type":"NodeParagraph","Properties":{"id":"20240617104308-c6ii81c","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"脐疮。诸疮作痛。痈疽。乳发。冻疮。火毒疮。热泡疮。头疮虫疮。口疮。阴茎疮。黄柏丸。"}]},{"ID":"20240617104308-um869ur","Type":"NodeParagraph","Properties":{"id":"20240617104308-um869ur","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"黄柏五钱。赤芍四钱。研末。米饭和丸麻子大。每服一二十丸。食前米饮下。治小儿热痢下血。又方。黄柏（微炒锉）当归（微炒锉）各一两。研末。煨大蒜和丸绿豆大。每服七丸。"}]},{"ID":"20240617104308-vrat7hm","Type":"NodeParagraph","Properties":{"id":"20240617104308-vrat7hm","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"日三四次。治小儿久白痢。腹胀痛。黄柏散。黄柏一两。五倍子二钱。密陀僧甘草各一钱。"}]},{"ID":"20240617104308-0vhg8ag","Type":"NodeParagraph","Properties":{"id":"20240617104308-0vhg8ag","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"除柏外余均研末。清水调敷柏上。火炙三五次。将柏切片。临卧贴之。天明即愈。治茧唇。又方。黄柏（蜜涂炙干）白僵蚕（炒去丝）各等分。研末掺患处治湿疮。又方。黄柏大黄朴硝鸡子壳寒水石各等分。研末水调涂。治汤火伤。又方。黄柏黄连防风各四钱。胡椒五钱大枫肉枯矾各二钱。大茴香花椒各三钱。雄黄硫黄各五分。槟榔二枚。斑蝥十个。潮脑一钱五分。"}]},{"ID":"20240617104308-495bo5f","Type":"NodeParagraph","Properties":{"id":"20240617104308-495bo5f","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"研末腊猪油调涂。麻木者亦可擦。痒而搔破者擦破处。治手足皮枯。破则如水窠。或痒如疥癞。并治雁来风。黄柏汤。黄柏黄连白头翁升麻当归牡蛎石榴皮黄芩寄生炙草各二分。犀角艾叶各一分。咀。水煎服。治小儿下赤白痢如鱼脑。头痛身热。或心烦壮热及温病热盛。"}]},{"ID":"20240617104308-0hk3fcf","Type":"NodeParagraph","Properties":{"id":"20240617104308-0hk3fcf","updated":"20240617104308"},"Children":[{"Type":"NodeText","Data":"下血如鱼脑者。"}]},{"ID":"20240617104529-jhh5dcr","Type":"NodeThematicBreak","Properties":{"id":"20240617104529-jhh5dcr"}},{"ID":"20240617104530-1h7l9cv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104530-1h7l9cv","updated":"20240617104551"},"Children":[{"Type":"NodeText","Data":"黄柏《要药分剂》"}]},{"ID":"20240617104530-8fmp454","Type":"NodeParagraph","Properties":{"id":"20240617104530-8fmp454","updated":"20240617104530"},"Children":[{"Type":"NodeText","Data":"味苦。性寒。无毒。禀至阴之气。而得清寒之性以生。降也。阴也。恶干漆。"}]},{"ID":"20240617104530-xl6gllw","Type":"NodeParagraph","Properties":{"id":"20240617104530-xl6gllw","updated":"20240617104530"},"Children":[{"Type":"NodeText","Data":"【主治】主五脏肠胃中结热。黄胆。肠痔。止泄痢。女子漏下赤白。阴伤蚀疮。（本经）疗惊气在皮间。肌肤热权）治骨蒸。洗肝胱相火。补肾水不足。坚冲脉气逆不渴而小便不痛。诸疮【归经】入肾膀胱二经。为除热益阴之品。（肾家要药膀胱引经药专治阴虚生内热诸症）【前论】元素曰。瘫痪必用之药。东垣曰。黄柏、苍术乃治痿要药。时珍曰。黄柏能制上虚气不心久合【禁忌】经疏曰。阴阳两虚。脾胃薄弱者。均忌。"}]},{"ID":"20240617104530-awn9m5j","Type":"NodeParagraph","Properties":{"id":"20240617104530-awn9m5j","updated":"20240617104547"},"Children":[{"Type":"NodeText","Data":"【炮制】纲目曰。黄柏性寒而沉。生用则降实火。熟用则不伤胃。酒制则治上。盐制则治下。蜜制则治中。"}]},{"ID":"20240617104459-9z5tkzu","Type":"NodeThematicBreak","Properties":{"id":"20240617104459-9z5tkzu"}},{"ID":"20240617104500-sg7xeod","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617104500-sg7xeod","updated":"20240617104504"},"Children":[{"Type":"NodeText","Data":"黄柏《中药学》"}]},{"ID":"20240617104500-jpxim1t","Type":"NodeParagraph","Properties":{"id":"20240617104500-jpxim1t","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【药用】本品为云香科植物黄蘗或黄皮数除去外皮的树皮。"}]},{"ID":"20240617104500-dnvjxmr","Type":"NodeParagraph","Properties":{"id":"20240617104500-dnvjxmr","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒。入肾、膀胱、大肠经。"}]},{"ID":"20240617104500-h4uma33","Type":"NodeParagraph","Properties":{"id":"20240617104500-h4uma33","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【功效】清热燥湿，泻火解毒，清虚热。"}]},{"ID":"20240617104500-y8w9v8k","Type":"NodeParagraph","Properties":{"id":"20240617104500-y8w9v8k","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于湿热泻痢、湿热黄疸，以及小便淋沥涩痛、赤白带下，阴部肿痛、足膝肿痛、萎软无力等症。"}]},{"ID":"20240617104500-fddkhrz","Type":"NodeParagraph","Properties":{"id":"20240617104500-fddkhrz","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"黄柏清热燥湿之力，与黄芩、黄连相似，但以除下焦之湿热为佳。治泻痢合黄芩、黄连；疗黄疸合栀子、茵陈；如配苍朮、牛膝，可用于足膝肿痛、下肢萎软无力、配合知母、生地、竹叶、木通，可用于小便淋涩热痛；配合白芷、龙胆草，可用于带下阴肿。"}]},{"ID":"20240617104500-vnb1h6e","Type":"NodeParagraph","Properties":{"id":"20240617104500-vnb1h6e","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"2.用于热毒疮疡，湿疹等症。"}]},{"ID":"20240617104500-6ew6m9t","Type":"NodeParagraph","Properties":{"id":"20240617104500-6ew6m9t","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"黄柏燥湿泻火解毒的功效颇好，用治湿热疮疡、湿疹之症，既可内服，又可外用；内服配黄芩、栀子等药同用，外用可配大黄、滑石等研末撒敷。"}]},{"ID":"20240617104500-535fnj5","Type":"NodeParagraph","Properties":{"id":"20240617104500-535fnj5","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"3.用于阴虚发热，或梦遗滑精等症。"}]},{"ID":"20240617104500-w4rtly5","Type":"NodeParagraph","Properties":{"id":"20240617104500-w4rtly5","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"黄柏除清实热外，尚能清虚热以疗潮热骨蒸，泻肾火以疗梦遗滑精，常合知母、地黄等同用。"}]},{"ID":"20240617104500-hkpwa0e","Type":"NodeParagraph","Properties":{"id":"20240617104500-hkpwa0e","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【处方用名】川柏、川黄柏（生用，泻实火）、盐水炒黄柏（盐水炒，清虚热，泻肾火）"}]},{"ID":"20240617104500-idd6f1l","Type":"NodeParagraph","Properties":{"id":"20240617104500-idd6f1l","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。外用适量。"}]},{"ID":"20240617104500-k8v6ij6","Type":"NodeParagraph","Properties":{"id":"20240617104500-k8v6ij6","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【按语】黄柏、黄芩、黄连三药，都是苦寒的药品，均能清热燥湿、泻火解毒。但黄柏泻肾火而退虚热，且能除下焦湿热；黄芩则以清肺热为专长，又能安胎；黄连泻心火而除烦，善止呕逆。这是三药不同之点。因此，一般所谓黄芩治上焦、黄连治中焦、黄柏治下焦的说法，就是根据黄芩清肺火、黄连止呕逆、黄柏泻肾火的特点而来的。但是，现在临床上作为清热解毒药应用时，芩、连、柏三药都是通用的，没有上述这样严格的区分。"}]},{"ID":"20240617104500-brddg84","Type":"NodeParagraph","Properties":{"id":"20240617104500-brddg84","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"【方剂举例】栀子柏皮汤《伤寒论》：黄柏、栀子、甘草。治伤寒身黄发热。"}]},{"ID":"20240617104500-rfdqxgr","Type":"NodeParagraph","Properties":{"id":"20240617104500-rfdqxgr","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"易黄散《傅青主女科》：黄柏、山药、车前子、芡实、白果。治下焦湿热，白浊带下。"}]},{"ID":"20240617104500-3rocpub","Type":"NodeParagraph","Properties":{"id":"20240617104500-3rocpub","updated":"20240617104500"},"Children":[{"Type":"NodeText","Data":"滋肾丸《兰室秘藏》：黄柏、知母、肉桂。治下焦邪热，口不渴而小便秘。"}]},{"ID":"20240607142722-tf4rcz2","Type":"NodeThematicBreak","Properties":{"id":"20240607142722-tf4rcz2"}},{"ID":"20240607142735-ajrmiof","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607142735-ajrmiof","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"黄柏"}]},{"ID":"20240607142735-bvewn9w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142735-bvewn9w","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"《中国药典》：黄柏"}]},{"ID":"20240607142735-ajs11tk","Type":"NodeParagraph","Properties":{"id":"20240607142735-ajs11tk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607142735-2o3n267","Type":"NodeParagraph","Properties":{"id":"20240607142735-2o3n267","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" Huánɡ Bò"}]},{"ID":"20240607142735-e1vdgez","Type":"NodeParagraph","Properties":{"id":"20240607142735-e1vdgez","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607142735-zcnz4b0","Type":"NodeParagraph","Properties":{"id":"20240607142735-zcnz4b0","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 黄檗、元柏、檗木"}]},{"ID":"20240607142735-4yq9tf2","Type":"NodeParagraph","Properties":{"id":"20240607142735-4yq9tf2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607142735-52so94r","Type":"NodeParagraph","Properties":{"id":"20240607142735-52so94r","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" CORTEX PHELLODENDRI"}]},{"ID":"20240607142735-eqyrzor","Type":"NodeParagraph","Properties":{"id":"20240607142735-eqyrzor","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607142735-p9mam9j","Type":"NodeParagraph","Properties":{"id":"20240607142735-p9mam9j","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 本品为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄皮树"},{"Type":"NodeText","Data":"Phellodendron chinense Schneid.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄檗"},{"Type":"NodeText","Data":"Phellodendron amurense Rupr.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"。前者习称“川黄柏”，后者习称“关黄柏”。剥取树皮后，除去粗皮，晒干。"}]},{"ID":"20240607142735-ntjluba","Type":"NodeParagraph","Properties":{"id":"20240607142735-ntjluba","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607142735-fhysr22","Type":"NodeParagraph","Properties":{"id":"20240607142735-fhysr22","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 川黄柏：呈板片状或浅槽状，长宽不一，厚3～6mm。外表面黄褐色或黄棕色，平坦或具纵沟纹，有的可见皮孔痕及残存的灰褐色粗皮。内表面暗黄色或淡棕色，具细密的纵棱纹。体轻，质硬，断面纤维性，呈裂片状分层，深黄色。气微，味甚苦，嚼之有黏性。"}]},{"ID":"20240607142735-4236for","Type":"NodeParagraph","Properties":{"id":"20240607142735-4236for","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"关黄柏：厚2～4mm。外表面黄绿色或淡棕黄色，较平坦，有不规则的纵裂纹，皮孔痕小而少见，偶有灰白色的粗皮残留。内表面黄色或黄棕色。体轻，质较硬，断面鲜黄色或黄绿色。"}]},{"ID":"20240607142735-brdaow6","Type":"NodeParagraph","Properties":{"id":"20240607142735-brdaow6","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607142735-pc1m0es","Type":"NodeParagraph","Properties":{"id":"20240607142735-pc1m0es","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处，防潮。"}]},{"ID":"20240607142735-2rp39cz","Type":"NodeParagraph","Properties":{"id":"20240607142735-2rp39cz","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607142735-05nrpdh","Type":"NodeParagraph","Properties":{"id":"20240607142735-05nrpdh","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄柏"},{"Type":"NodeText","Data":"：除去杂质，喷淋清水，润透，切丝，干燥。"}]},{"ID":"20240607142735-rowtvy1","Type":"NodeParagraph","Properties":{"id":"20240607142735-rowtvy1","updated":"20240607142735"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"盐黄柏"},{"Type":"NodeText","Data":"：取黄柏丝，照盐水炙法（附录Ⅱ D）炒干。"}]},{"ID":"20240607142735-7sa8wrl","Type":"NodeParagraph","Properties":{"id":"20240607142735-7sa8wrl","updated":"20240607142735"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄柏炭"},{"Type":"NodeText","Data":"：取黄柏丝，照炒炭法（附录Ⅱ D）炒至表面焦黑色。"}]},{"ID":"20240607142735-ibsp4e8","Type":"NodeParagraph","Properties":{"id":"20240607142735-ibsp4e8","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607142735-y840ws7","Type":"NodeParagraph","Properties":{"id":"20240607142735-y840ws7","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末绿黄色或黄色。纤维鲜黄色，直径16～38μm，常成束，周围细胞含草酸钙方晶，形成晶纤维；含晶细胞壁木化增厚。石细胞鲜黄色，类圆形或纺锤形，直径35～128 μm，有的呈分枝状，枝端锐尖，壁厚，层纹明显。草酸钙方晶直径约至24μm。"}]},{"ID":"20240607142735-s3th8a6","Type":"NodeParagraph","Properties":{"id":"20240607142735-s3th8a6","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末1g，加乙醚10ml，振摇后，滤过，滤液挥干，残渣加冰醋酸1ml使溶解，再加硫酸1滴，放置，溶液显紫棕色。"}]},{"ID":"20240607142735-vhc8exf","Type":"NodeParagraph","Properties":{"id":"20240607142735-vhc8exf","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（3） 取本品粉末0.1g，加甲醇5ml，加热回流15分钟，滤过，滤液补充甲醇至5ml，作为供试品溶液。另取黄柏对照药材0.1g，同法制成对照药材溶液。再取盐酸小檗碱对照品，加甲醇制成每1ml含 0.5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述三种溶液各 1μl，分别点于同一硅胶Ｇ薄层板上，以苯－醋酸乙酯－异丙醇-甲醇－浓氨试液（6:3:1.5:1.5:0.5） 为展开剂，置氨蒸气饱和的展开缸内，展开，取出，晾干，置紫外光灯（365nm） 下检视。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的荧光斑点；在与对照品色谱相应的位置上，显相同的一个黄色荧光斑点。"}]},{"ID":"20240607142735-jibnxkk","Type":"NodeParagraph","Properties":{"id":"20240607142735-jibnxkk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607142735-1nrhwxq","Type":"NodeParagraph","Properties":{"id":"20240607142735-1nrhwxq","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 归肾、膀胱经。"}]},{"ID":"20240607142735-pljghuz","Type":"NodeParagraph","Properties":{"id":"20240607142735-pljghuz","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607142735-nwncime","Type":"NodeParagraph","Properties":{"id":"20240607142735-nwncime","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240607142735-0jamcax","Type":"NodeParagraph","Properties":{"id":"20240607142735-0jamcax","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607142735-om1gtgj","Type":"NodeParagraph","Properties":{"id":"20240607142735-om1gtgj","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 清热燥湿，泻火除蒸，解毒疗疮。用于湿热泻痢，黄疸，带下，热淋，脚气，痿{辟}，骨蒸劳热，盗汗，遗精，疮疡肿毒，湿疹瘙痒。盐黄柏滋阴降火。用于阴虚火旺，盗汗骨蒸。"}]},{"ID":"20240607142735-vvx7jpk","Type":"NodeParagraph","Properties":{"id":"20240607142735-vvx7jpk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607142735-4soc6if","Type":"NodeParagraph","Properties":{"id":"20240607142735-4soc6if","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 3～12g；外用适量。"}]},{"ID":"20240607142735-exuf67c","Type":"NodeParagraph","Properties":{"id":"20240607142735-exuf67c","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607142735-b8b2l94","Type":"NodeParagraph","Properties":{"id":"20240607142735-b8b2l94","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" （1）黄柏清热燥湿之力，与黄芩、黄连相似，但以除下焦之湿热为佳。治泻痢合黄芩、黄连；疗黄疸合栀子、茵陈；如配苍朮、牛膝，可用于足膝肿痛、下肢萎软无力、配合知母、生地、竹叶、木通，可用于小便淋涩热痛；配合白芷、龙胆草，可用于带下阴肿。用治湿热疮疡、湿疹之症，既可内服，又可外用；内服配黄芩、栀子等药同用，外用可配大黄、滑石等研末撒敷。清虚热以疗潮热骨蒸，泻肾火以疗梦遗滑精，常合知母、地黄等同用。"}]},{"ID":"20240607142735-7dwc0cl","Type":"NodeParagraph","Properties":{"id":"20240607142735-7dwc0cl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607142735-dxndesu","Type":"NodeParagraph","Properties":{"id":"20240607142735-dxndesu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607142735-y7oxi2l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142735-y7oxi2l","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：黄柏"}]},{"ID":"20240607142735-sjuxnpb","Type":"NodeParagraph","Properties":{"id":"20240607142735-sjuxnpb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607142735-kn648hq","Type":"NodeParagraph","Properties":{"id":"20240607142735-kn648hq","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" Huánɡ Bò"}]},{"ID":"20240607142735-oq86rjn","Type":"NodeParagraph","Properties":{"id":"20240607142735-oq86rjn","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607142735-vwrr23h","Type":"NodeParagraph","Properties":{"id":"20240607142735-vwrr23h","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 檗木（《本经》），檗皮（《伤寒论》），黄檗（《本草经集注》）。"}]},{"ID":"20240607142735-5ua6x61","Type":"NodeParagraph","Properties":{"id":"20240607142735-5ua6x61","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607142735-gmov6kg","Type":"NodeParagraph","Properties":{"id":"20240607142735-gmov6kg","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 《纲目》"}]},{"ID":"20240607142735-8dtyqyw","Type":"NodeParagraph","Properties":{"id":"20240607142735-8dtyqyw","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607142735-yhnsecz","Type":"NodeParagraph","Properties":{"id":"20240607142735-yhnsecz","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄柏"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄皮树"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"。3～6月间采收。选十年以上的黄柏，轮流剥取部分树皮。不能一次剥尽，以保持原树继续生长。剥去后，即自行生长新皮，未割部分可在下年采收。将剩下的树皮晒至半干，压平，刮净粗皮（栓皮），至显黄色为度，不可伤及内皮，刷净晒干，放置干燥通风处，防霉变色。"}]},{"ID":"20240607142735-54t07oo","Type":"NodeParagraph","Properties":{"id":"20240607142735-54t07oo","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607142735-v1172ro","Type":"NodeParagraph","Properties":{"id":"20240607142735-v1172ro","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①黄柏，又名：黄波罗、黄伯栗。"}]},{"ID":"20240607142735-odhidsk","Type":"NodeParagraph","Properties":{"id":"20240607142735-odhidsk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高10～25米；树皮外层灰色，有甚厚的木栓层，表面有纵向沟裂，内皮鲜黄色。小枝通常灰褐色或淡棕色，罕为红橙色。叶对生，单数羽状复叶，小叶5～13片，小叶柄短，小叶片长圆状披针形、卵状披针形或近卵形，长5～11厘米，宽2～3.8厘米，先端长渐尖，基部通常为不等的广楔形或近圆形，边缘有细圆锯齿或近无齿，常被缘毛；上面暗绿色，幼时沿脉被柔毛，老时则光滑无毛。下面苍白色，幼时沿脉被柔毛，老时仅中脉基部被白色长柔毛。花序圆锥状，花轴及花枝幼时被毛；花单性，雌雄异株，较小；花萼5，卵形；花瓣5，长圆形，带黄绿色；雄花雄蕊5，伸出花瓣外.花丝基部被毛；雌花的退化雄蕊呈鳞片状，雌蕊1，子房上位，花柱甚短，柱头头状，5裂。浆果状核果圆球形，直径约8～10毫米，成熟时紫黑色，有5核。花期5～6月。果期9～10月。"}]},{"ID":"20240607142735-yl1do6o","Type":"NodeParagraph","Properties":{"id":"20240607142735-yl1do6o","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"生于山地杂木林中或山谷洪流附近。分布东北及华北。"}]},{"ID":"20240607142735-wk23rw3","Type":"NodeParagraph","Properties":{"id":"20240607142735-wk23rw3","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"本植物的果实（黄波罗果）亦供药用，另详专条。"}]},{"ID":"20240607142735-oltkd1m","Type":"NodeParagraph","Properties":{"id":"20240607142735-oltkd1m","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②黄皮树，又名：灰皮柏、华黄柏。"}]},{"ID":"20240607142735-yvzsiab","Type":"NodeParagraph","Properties":{"id":"20240607142735-yvzsiab","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"落叶乔木，高10～12米。树皮外层灰褐色，甚薄，无加厚的木栓层，内层黄色；小枝通常暗红褐色或紫棕色，光滑无毛。叶对生；单敷羽状复叶，小叶7～15片，有短柄；叶片长圆状披针形至长圆状卵形，长9～14厘米，宽3～5厘米，先端渐尖，基部广楔形或近圆形，通常两侧不等，上面暗绿色，仅中脉被毛，下面淡绿色，被长柔毛。花序圆锥状，花轴及花枝密被短毛；花单性，雌雄异株；萼片5，卵形；花瓣6，长圆形；雄花雄蕊6，超出花瓣之外甚多，花丝甚长，基部有白色长柔毛；雌花退化雄蕊短小，雌蕊1，子房上位，5室，花柱短；柱头5裂。浆果状核果球形，直径1～1.2厘米，密集成团，熟后紫黑色，通常具5核。花期5～6月。果熟期10月。"}]},{"ID":"20240607142735-slhnt9r","Type":"NodeParagraph","Properties":{"id":"20240607142735-slhnt9r","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"生于山上沟边的杂木林中。分布四川、湖北、贵州、云南、江西、浙江等地。"}]},{"ID":"20240607142735-wx7mcmb","Type":"NodeParagraph","Properties":{"id":"20240607142735-wx7mcmb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607142735-uucfas5","Type":"NodeParagraph","Properties":{"id":"20240607142735-uucfas5","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①东黄柏"}]},{"ID":"20240607142735-7kamm75","Type":"NodeParagraph","Properties":{"id":"20240607142735-7kamm75","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"又名：关柏、关黄柏。为植物黄柏的干燥树皮。呈稍弯曲的板片状，边缘不整齐，长宽不一，厚约2～4毫米。栓皮留存或已剥离，栓皮较厚，表面灰白色；栓皮剥离者，表面棕黄色，平坦或有抽皱及皮孔；内表面灰黄色。质较松，易折断，断面纤维性，淡黄色稍带绿。气微，味苦。粉末遇水即带粘性，并使水染成黄色。以片张厚大、鲜黄色、无栓皮者为佳。"}]},{"ID":"20240607142735-ewbyx59","Type":"NodeParagraph","Properties":{"id":"20240607142735-ewbyx59","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"主产辽宁、吉林、河北。此外，黑龙江、内蒙古亦产。以辽宁产量最大。"}]},{"ID":"20240607142735-w6y9la6","Type":"NodeParagraph","Properties":{"id":"20240607142735-w6y9la6","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②川黄柏（《得配本草》）"}]},{"ID":"20240607142735-ojwstns","Type":"NodeParagraph","Properties":{"id":"20240607142735-ojwstns","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"为植物黄皮树及其变型变种的干燥树皮。呈稍弯曲的板片状，边缘不整齐，长宽不一，厚约3～5毫米，栓皮多已剥离。外表面深黄色，较平坦，有纵棱线及棕色皮孔；内表面灰黄色或黄色。质坚硬而轻，易折断，折断面纤维性，呈片状分裂，鲜黄色。气微，味苦，嚼之有粘滑性，能使水染黄色。以片张厚大、鲜黄色、无栓皮者为佳。"}]},{"ID":"20240607142735-quodh89","Type":"NodeParagraph","Properties":{"id":"20240607142735-quodh89","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"主产四川、贵州、湖北、云南。此外，湖南、甘肃、广西亦产。以四川、贵州产量最大。"}]},{"ID":"20240607142735-crcoiar","Type":"NodeParagraph","Properties":{"id":"20240607142735-crcoiar","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607142735-cy0tb47","Type":"NodeParagraph","Properties":{"id":"20240607142735-cy0tb47","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①黄柏"}]},{"ID":"20240607142735-6zn61sk","Type":"NodeParagraph","Properties":{"id":"20240607142735-6zn61sk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"树皮含小檗碱、药根碱、木兰花碱、黄柏碱、N-甲基大麦芽碱、掌叶防己碱、蝙蝠葛碱等生物碱；另含黄柏酮、黄柏内酯、白鲜交酯、黄柏酮酸、青萤光酸、7-脱氢豆甾醇、β-谷甾醇、菜油甾醇。根皮含小檗碱、药根碱、黄柏碱、N-甲基大麦芽碱。木材也含小檗碱。新鲜叶含黄柏甙、脱氢黄柏甙、脱氢异黄柏甙、异黄柏甙。干燥叶含金丝桃甙，不含黄柏甙。"}]},{"ID":"20240607142735-1dsfblt","Type":"NodeParagraph","Properties":{"id":"20240607142735-1dsfblt","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②黄皮树"}]},{"ID":"20240607142735-6c00idh","Type":"NodeParagraph","Properties":{"id":"20240607142735-6c00idh","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"树皮含小檗碱、木兰花碱、黄柏碱、掌叶防己碱等多种生物碱及内酯、甾醇、粘液质等。"}]},{"ID":"20240607142735-41vtqms","Type":"NodeParagraph","Properties":{"id":"20240607142735-41vtqms","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③秃叶黄皮树"}]},{"ID":"20240607142735-6aoar5a","Type":"NodeParagraph","Properties":{"id":"20240607142735-6aoar5a","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"树皮含四氢小檗碱、四氢掌叶防己碱、四氢药根碱、黄柏碱、木兰花碱及β-谷甾醇。"}]},{"ID":"20240607142735-vct3p37","Type":"NodeParagraph","Properties":{"id":"20240607142735-vct3p37","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607142735-icthzzk","Type":"NodeParagraph","Properties":{"id":"20240607142735-icthzzk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 黄柏与黄连同样含较多的小檗碱，故其药理作用亦大体相似，参见\"黄连\"条。但含量较黄连低，并含有其他成分，作用亦有些差异。"}]},{"ID":"20240607142735-ssgvw7f","Type":"NodeParagraph","Properties":{"id":"20240607142735-ssgvw7f","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"①抗菌作用"}]},{"ID":"20240607142735-9yfc9tl","Type":"NodeParagraph","Properties":{"id":"20240607142735-9yfc9tl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"黄柏抗菌有效成分为小檗碱。体外试验对金黄色葡萄球菌、肺炎球菌、白喉杆菌、草绿色链球菌、痢疾杆菌（宋内氏除外）等均有效，对大肠杆菌、伤寒杆菌几乎无效，有报告对大肠杆菌、绿脓杆菌有效者。就生药而言，黄连抗菌作用较黄柏强1倍。对H37Rv、鸟型结核杆菌无直接抑制作用，但可使菌数减少，或很高浓度（1/100）时呈现抑菌作用，但也有报告获得良好结果的。在用豚鼠接种人型结核菌作实验治疗时，口服或注射的疗效均很差。对接种牛型结核菌的豚鼠，从黄柏提取的盐酸结晶物作肌肉注射，有一定疗效。据称，黄柏对结核病人的临床症状及X线检查有好转，且优于黄连。"}]},{"ID":"20240607142735-tkbx7z9","Type":"NodeParagraph","Properties":{"id":"20240607142735-tkbx7z9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"在试管中，黄柏煎剂或浸剂对若干常见的致病性真菌有不同程度的抑菌作用。其水煎剂还能杀死钩端螺旋体（剂量需较黄连大一倍）。在体外对阴道滴虫，也有较弱的作用。"}]},{"ID":"20240607142735-xbutml7","Type":"NodeParagraph","Properties":{"id":"20240607142735-xbutml7","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②降压作用"}]},{"ID":"20240607142735-6a81cr8","Type":"NodeParagraph","Properties":{"id":"20240607142735-6a81cr8","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"黄柏对麻醉动物静脉或腹腔注射，可产生显著而持久的降压作用，颈动脉注射较静脉注射的更强，因此降压可能是中枢性的。对季铵型的黄柏碱加以改变而合成的叔胺型的化合物名昔罗匹林亦可引起迅速、显著之降压；在Ⅰ～Ⅱ颈椎间切断脊髓则降压消失，因而也证明降压属中枢性的。此外，昔罗匹林有较强的抗肾上腺素样作用，对压迫颈动脉、窒息、电刺激大内脏神经引起的升压反应及注射肾上腺素或电刺激颈上交感神经节引起的瞬膜收缩反应均受到抑制。苯苄胺、妥拉苏林、利血平等皆可减弱其降压反应。"}]},{"ID":"20240607142735-93zptsx","Type":"NodeParagraph","Properties":{"id":"20240607142735-93zptsx","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③其他作用"}]},{"ID":"20240607142735-etlhf5t","Type":"NodeParagraph","Properties":{"id":"20240607142735-etlhf5t","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"黄柏碱或昔罗匹林对中枢神经系统有抑制作用，小鼠的自发活动、各种反射均受到抑制；给予未麻醉家兔昔罗匹林，脑电波可出现高振幅慢波。黄柏碱有轻度的箭毒样作用，对蛙腹直肌紧张度无影响，但能抑制由乙酰胆碱引起的收缩反应。对离体兔肠，黄柏粉可增强其振幅，黄柏酮可增强其张力及振幅；黄柏内酯则抑制肠管。在带有胰瘘的家兔身上，黄柏有促进胰腺分泌的作用。黄柏内酯在接近致死量（0.05～0.1克/公斤）时，可降低兔血糖，黄柏酮无此作用。据称黄柏有保护血小板的作用，尚待证实。另据报道，黄柏对孑孓（10P.P.M.在18小时内可杀死62％）、家蝇有杀灭作用。在小鼠身上，与萱草根同服，可降低后者之毒性。"}]},{"ID":"20240607142735-e21suia","Type":"NodeParagraph","Properties":{"id":"20240607142735-e21suia","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607142735-pv6gl8v","Type":"NodeParagraph","Properties":{"id":"20240607142735-pv6gl8v","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 黄柏：拣去杂质，用水洗净，捞出，润进，切片成切丝，晒干。黄柏炭：取黄柏片，用武火炒至表面焦黑色（但须存性），喷淋清水，取出放凉，晒干。盐黄柏：取黄柏片，用盐水喷洒，拌匀，置锅内用文火微炒，取出放凉，晾干（每黄柏片100斤用食盐2斤半，加适量开水溶化澄清）。酒黄柏：取黄柏片，用黄酒喷洒拌炒如盐黄柏法（每黄柏片100斤用黄酒10斤）。"}]},{"ID":"20240607142735-7kd0g7o","Type":"NodeParagraph","Properties":{"id":"20240607142735-7kd0g7o","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"《雷公炮炙论》：\"凡使（黄檗），用刀削上粗皮了，用生蜜水浸半日，漉出晒干，用蜜涂，文武火炙令蜜尽为度。凡修事五两，用蜜三两。\""}]},{"ID":"20240607142735-o451zk9","Type":"NodeParagraph","Properties":{"id":"20240607142735-o451zk9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607142735-r44vqwt","Type":"NodeParagraph","Properties":{"id":"20240607142735-r44vqwt","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 入肾、膀胱经。"}]},{"ID":"20240607142735-p93bccb","Type":"NodeParagraph","Properties":{"id":"20240607142735-p93bccb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"①《汤液本草》：\"足大阳经引经药，足少阴经之剂。\""}]},{"ID":"20240607142735-ff5ea7f","Type":"NodeParagraph","Properties":{"id":"20240607142735-ff5ea7f","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②《医学入门》：\"足少阴、手厥阴本药，足大阳引经药。\""}]},{"ID":"20240607142735-6khahon","Type":"NodeParagraph","Properties":{"id":"20240607142735-6khahon","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③《本草经解》：\"入足少阴肾经、手少阴心经。\""}]},{"ID":"20240607142735-nyopu4v","Type":"NodeParagraph","Properties":{"id":"20240607142735-nyopu4v","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607142735-lkz67cx","Type":"NodeParagraph","Properties":{"id":"20240607142735-lkz67cx","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240607142735-5ytzgp5","Type":"NodeParagraph","Properties":{"id":"20240607142735-5ytzgp5","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240607142735-txrpz6y","Type":"NodeParagraph","Properties":{"id":"20240607142735-txrpz6y","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607142735-tdriwx4","Type":"NodeParagraph","Properties":{"id":"20240607142735-tdriwx4","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"平。\""}]},{"ID":"20240607142735-8onkgib","Type":"NodeParagraph","Properties":{"id":"20240607142735-8onkgib","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"④《珍珠囊》：\"苦辛。\""}]},{"ID":"20240607142735-hn7b9ip","Type":"NodeParagraph","Properties":{"id":"20240607142735-hn7b9ip","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607142735-2ya0qdy","Type":"NodeParagraph","Properties":{"id":"20240607142735-2ya0qdy","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 脾虚泄泻，胃弱食少者忌服。"}]},{"ID":"20240607142735-igd6ibe","Type":"NodeParagraph","Properties":{"id":"20240607142735-igd6ibe","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"恶干漆。\""}]},{"ID":"20240607142735-8zmw03a","Type":"NodeParagraph","Properties":{"id":"20240607142735-8zmw03a","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"阴阳两虚之人，病兼脾胃薄弱，饮食少进及食不消，或兼泄泻，或恶冷物及好热食；肾虚天明作泄；上热下寒，小便不禁；少腹冷痛，子宫寒；血虚不孕，阳虚发热，瘀血停滞，产后血虚发热，金疮发热；痈疽溃后发热，伤食发热，阴虚小水不利，痘后脾虚小水不利，血虚不得眠，血虚烦躁，脾阴不足作泄等证，法咸忌之。\""}]},{"ID":"20240607142735-3z97v2y","Type":"NodeParagraph","Properties":{"id":"20240607142735-3z97v2y","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607142735-dba9vp5","Type":"NodeParagraph","Properties":{"id":"20240607142735-dba9vp5","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 清热。燥湿，泻火，解毒。治热痢，泄泻，消渴，黄疸，痿躄，梦遗，淋浊，痔疮，便血，亦白带下，骨蒸劳热，目赤肿痛，口舌生疮，疮疡肿毒。"}]},{"ID":"20240607142735-0nno3qm","Type":"NodeParagraph","Properties":{"id":"20240607142735-0nno3qm","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五脏肠胃中结热，黄疸，肠痔；止泄痢，女子漏下赤白，阴伤蚀疮。\""}]},{"ID":"20240607142735-1z9720b","Type":"NodeParagraph","Properties":{"id":"20240607142735-1z9720b","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗惊气在皮间，肌肤热赤起，目热赤痛，口疮。\""}]},{"ID":"20240607142735-g5oeydx","Type":"NodeParagraph","Properties":{"id":"20240607142735-g5oeydx","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主男子阴痿。治下血如鸡鸭肝片；及男子茎上疮，屑末敷之。\""}]},{"ID":"20240607142735-gquxb5z","Type":"NodeParagraph","Properties":{"id":"20240607142735-gquxb5z","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"主热疮疱起，虫疮，痢，下血，杀蛀虫；煎服，主消渴。\""}]},{"ID":"20240607142735-mv68s5p","Type":"NodeParagraph","Properties":{"id":"20240607142735-mv68s5p","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"安心除劳，治骨蒸，洗肝，明目，多泪，口干，心热，杀疳虫，治蛔心痛，疥癣，蜜炙治鼻洪，肠风，泻血，后分急热肿痛。\""}]},{"ID":"20240607142735-pfisd82","Type":"NodeParagraph","Properties":{"id":"20240607142735-pfisd82","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑥《珍珠囊》：\"治肾水。膀胱不足，诸痿厥，腰膝无力。\""}]},{"ID":"20240607142735-tqykttr","Type":"NodeParagraph","Properties":{"id":"20240607142735-tqykttr","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑦《医学启源》：\"《主治秘诀》云，泻膀胱龙火，利结小便，下焦湿肿，痢疾先见血，脐中痛，补肾水不足。\""}]},{"ID":"20240607142735-l6gio4t","Type":"NodeParagraph","Properties":{"id":"20240607142735-l6gio4t","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑧《用药心法》：\"治疮痛不可忍者。\""}]},{"ID":"20240607142735-xzaxe47","Type":"NodeParagraph","Properties":{"id":"20240607142735-xzaxe47","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑨《兰室秘藏》：\"泻冲脉之邪。治夏月气上冲咽不得息而喘息有音不得卧。\""}]},{"ID":"20240607142735-t9pez29","Type":"NodeParagraph","Properties":{"id":"20240607142735-t9pez29","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑩《纲目》：\"敷小儿头疮。\""}]},{"ID":"20240607142735-wrg00b9","Type":"NodeParagraph","Properties":{"id":"20240607142735-wrg00b9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑾《现代实用中药》：\"打扑挫筋等，磨粉调如泥状涂贴。\""}]},{"ID":"20240607142735-0ro2ynj","Type":"NodeParagraph","Properties":{"id":"20240607142735-0ro2ynj","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607142735-myjdu68","Type":"NodeParagraph","Properties":{"id":"20240607142735-myjdu68","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外用：研末调敷或煎水浸渍。"}]},{"ID":"20240607142735-85es5et","Type":"NodeParagraph","Properties":{"id":"20240607142735-85es5et","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607142735-byvlsox","Type":"NodeParagraph","Properties":{"id":"20240607142735-byvlsox","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①治小儿热痢下血：黄檗半两，赤芍药四钱。上同为细末，饭和丸，麻子大。每服一、二十丸，食前米饮下，大者加丸数。（《阎氏小儿方论》）"}]},{"ID":"20240607142735-zox4wtk","Type":"NodeParagraph","Properties":{"id":"20240607142735-zox4wtk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②治痢疾：黄柏300克，翻白草450克，秦皮300克。将翻白草、秦皮全部及黄柏200克，共水煎两次，合并煎液，用文火浓缩成膏状，将剩余100克黄柏研细粉加入膏中，搅匀，低温烘干，研细粉。每服一、二克，日三次。（辽宁《中草药新医疗法资料选编》）"}]},{"ID":"20240607142735-nxao9nj","Type":"NodeParagraph","Properties":{"id":"20240607142735-nxao9nj","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③治妊娠及产后寒热下痢：黄檗一斤，黄连一升，栀子二十枚。上三味，细切，以水五升，渍一宿，煮三拂，服一升，一日一夜令尽。呕者加橘皮一把，生姜二两。（《千金翼方》）"}]},{"ID":"20240607142735-iq7py6k","Type":"NodeParagraph","Properties":{"id":"20240607142735-iq7py6k","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"④治小儿热泻：黄檗，焙为末，用米汤和丸粟米大，每服一、二十丸，米汤下。（《十全博救方》）"}]},{"ID":"20240607142735-swt9zw2","Type":"NodeParagraph","Properties":{"id":"20240607142735-swt9zw2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑤治消渴尿多能食：黄檗一斤，水一升，煮三、五沸，渴即饮之，恣饮数日。（《独行方》）"}]},{"ID":"20240607142735-ve39yxm","Type":"NodeParagraph","Properties":{"id":"20240607142735-ve39yxm","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑥治伤寒身黄，发热：肥栀子十五个（擘），甘草一两（炙），黄柏二两。上三味，以水四升，煮取一升半，去滓，分温再服。（《伤寒论》栀子柏皮汤）"}]},{"ID":"20240607142735-h2pnuax","Type":"NodeParagraph","Properties":{"id":"20240607142735-h2pnuax","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑦治筋骨疼痛，因湿热者：黄檗（炒）、苍术（米泔浸、炒）。上二味为末，沸汤入姜汁调服。二物皆有雄壮之气，表实气实省，加酒少许佐之。（《丹溪心法》二妙散）"}]},{"ID":"20240607142735-vh3g7h7","Type":"NodeParagraph","Properties":{"id":"20240607142735-vh3g7h7","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑧治热甚梦泄，怔忪恍忽，膈壅舌干：黄檗（去粗皮）一两。搀罗为末，入龙脑一钱匕，同研匀，炼蜜和丸如梧桐子大。每服一丸至十九丸，浓煎麦冬汤下。（《圣济总录》清心丸）"}]},{"ID":"20240607142735-jnia54w","Type":"NodeParagraph","Properties":{"id":"20240607142735-jnia54w","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑨治白淫，梦泄遗精及滑出而不收：黄檗一斤（放新瓦上烧令通赤为度），真蛤粉一斤。上为细末，滴水为丸，如桐子大。每服一百丸，空心酒下。（《素问病机保命集》珍珠粉丸）"}]},{"ID":"20240607142735-caht8xs","Type":"NodeParagraph","Properties":{"id":"20240607142735-caht8xs","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑩治下阴自汗，头晕腰酸：黄柏三钱，苍术四钱，川椒三十粒，加水2000毫升，煎至600毫升。每次100毫升，一日三次，二日服完。（《中级医刊》（3）：177，1966）"}]},{"ID":"20240607142735-6ivq6pe","Type":"NodeParagraph","Properties":{"id":"20240607142735-6ivq6pe","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑾降阴火、补肾水：黄檗（炒褐色）、知毋（洒浸，炒）各四两，热地黄（酒蒸）、龟板（酥炙）各六两。上为末，猪脊髓、蜜丸。服七十丸，空心盐白汤下。（《丹溪心法》大补丸）"}]},{"ID":"20240607142735-hhbwlr2","Type":"NodeParagraph","Properties":{"id":"20240607142735-hhbwlr2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑿降心火，益肾水：黄檗三两，砂仁一两半，甘草一两。上为细末，稀糊为丸，如梧棍子大。每服五个丸，用肉苁蓉半两，切碎，用酒一大盏，浸一宿，次日早空心煎三、四沸，去滓，以清酒送下。（《奇效良方》封髓丹）"}]},{"ID":"20240607142735-0nm8hs1","Type":"NodeParagraph","Properties":{"id":"20240607142735-0nm8hs1","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒀治时行赤目：黄檗，去粗皮，为末，湿纸包裹，黄泥固，煨干。每用一弹子大，纱帕包之，浸水一盏，饭上蒸熟，乘热熏洗。一丸可用三、五次。（《眼科龙木论》五行汤）"}]},{"ID":"20240607142735-2mwhm34","Type":"NodeParagraph","Properties":{"id":"20240607142735-2mwhm34","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒁治小儿蓐内赤眼：黄檗，以乳浸，点之。（《小品方》）"}]},{"ID":"20240607142735-67s18nr","Type":"NodeParagraph","Properties":{"id":"20240607142735-67s18nr","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒂治口中及舌上生疮：捣黄檗含之。（《千金方》）"}]},{"ID":"20240607142735-ht8mck1","Type":"NodeParagraph","Properties":{"id":"20240607142735-ht8mck1","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒃治小儿重舌：黄檗，以竹沥渍取，细细点舌上。（《千金方》）"}]},{"ID":"20240607142735-suoyt81","Type":"NodeParagraph","Properties":{"id":"20240607142735-suoyt81","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒄治口疳臭烂：黄檗五钱，铜绿三钱。共为末掺之，去涎，愈。（《小品方》）"}]},{"ID":"20240607142735-rajr4t5","Type":"NodeParagraph","Properties":{"id":"20240607142735-rajr4t5","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒅治唇疮痛痒：黄檗末，以野蕾薇根捣汁调涂。（《圣济总录》）"}]},{"ID":"20240607142735-91ah744","Type":"NodeParagraph","Properties":{"id":"20240607142735-91ah744","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒆治肺壅，鼻中生疮，肿痛：黄檗、槟榔等分。捣罗为末，以猪脂调敷之。（《圣惠方》）"}]},{"ID":"20240607142735-vo3mfw8","Type":"NodeParagraph","Properties":{"id":"20240607142735-vo3mfw8","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒇治奶发，诸痈疽发背及妒乳：捣黄檗末，筛，鸡子白和，厚涂之。干，复易。（《补缺肘后方》）"}]},{"ID":"20240607142735-136pt25","Type":"NodeParagraph","Properties":{"id":"20240607142735-136pt25","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（21）治痈疽肿毒；黄檗皮（炒）、川乌头（炮）等分。为末调涂之，留头，频以米泔水润湿。（《濒湖集简方》）"}]},{"ID":"20240607142735-byy97m9","Type":"NodeParagraph","Properties":{"id":"20240607142735-byy97m9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（22）治男子阴疮损烂：㈠煮黄檗洗之，又白蜜涂之。㈡黄连、黄檗等分，末之，煮肥猪肉汁，渍疮讫，粉之。（《补缺肘后方》）"}]},{"ID":"20240607142735-rqkavo1","Type":"NodeParagraph","Properties":{"id":"20240607142735-rqkavo1","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（23）治小儿脐疮不合：黄檗末涂之。（《子母秘录》）"}]},{"ID":"20240607142735-vxi59x2","Type":"NodeParagraph","Properties":{"id":"20240607142735-vxi59x2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（24）治小儿脓疮，遍身不干：黄檗末，入枯矾少许掺之。（《简便单方》）"}]},{"ID":"20240607142735-kzur5ex","Type":"NodeParagraph","Properties":{"id":"20240607142735-kzur5ex","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607142735-r710xsw","Type":"NodeParagraph","Properties":{"id":"20240607142735-r710xsw","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①治疗流行性脑脊髓膜炎"}]},{"ID":"20240607142735-a9qubu3","Type":"NodeParagraph","Properties":{"id":"20240607142735-a9qubu3","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用黄柏制成的流浸膏（每毫升相当生药黄柏1克），3岁以下每6小时服3毫升，3岁以上4～6毫升，成人6～10毫升。治疗20例，年龄最大24岁，最小4岁，病程最短1天，最长18天，全部治愈。轻症治疗后1天即好转，一般约在治疗8天后症状与体征消失，约10天后脑脊液转为正常。治疗同时仍应于水分、营养及常规护理，并辅以一般对症处理。对于呕吐剧烈的患者，有人试用黄柏甘草汤（黄柏1两，甘草4钱，加水煎成100毫升）作保留灌肠，首次50毫升，以后每次30毫升，每6小时1次。待呕吐停止后，改为内服。治疗10余例，其中4例自始至终均采用保留灌肠法，疗效与内服相同。"}]},{"ID":"20240607142735-0gslaii","Type":"NodeParagraph","Properties":{"id":"20240607142735-0gslaii","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②治疗细菌性痢疾"}]},{"ID":"20240607142735-69ies4r","Type":"NodeParagraph","Properties":{"id":"20240607142735-69ies4r","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"内服黄柏干浸膏（0.13克=生药1克），每次0.4克，每日3～4次，治疗31例，全部治愈。又采用黄柏干浸膏（0.2克=生药1克）每次0.9克，每日4次，连服2～3日，治疗25例，治愈24例。退热平均为2.3天，腹痛及乙状结肠部压痛消失为4天，里急后重消失为3.3天，大便性状恢复正常肉眼为4天，镜检为4.7天，粪培养转阴为4.4天。有用盐酸黄柏小檗碱片（每片含盐酸小檗碱0.04克，相当于生药1克），首剂服0.24～0.32克，以后每4小时服0.12～0.16克，临床症状好转后，改为每6小时给药1次。治疗菌痢83例，痊愈82例。体温降至正常平均为1.6天；腹痛消失为4天；里急后重消失为3.8天，便次恢复正常为3.8天；粪检恢复正常为4.8天；粪培养阴性为5.4天。多数病例的临床症状、粪检及细菌培养，均在1周内恢复正常。对于慢性细菌性痢疾，可用黄柏皮切碎晒干，研粉过筛，再用10％酒精泛丸。每次4克，日服2次，7天为-疗程。观察40例，经乙状结肠镜检查结果：3例肠腔粘膜糜烂经2～4疗程治愈2例；16例溃疡经第一疗程愈合者10例，第二疗程愈合者5例，第三疗程愈合者1例；3例重度充血者，经第一疗程治愈者2例，第二疗程治愈者1例；14例一般充血者，第一疗程治愈10例，第二疗程治愈3例，第三疗程治愈1例；仅有出血点者4例，于第一疗程全部治愈。采用黄柏生药每次1.5～2钱，每日3次，煎服，疗程8～10天。治疗菌痢156例，痊愈者90％，基本痊愈者4.9％，大便培养转阴率为96％，阴转时间多为2～6天。其近期疗效似较磺胺为优。"}]},{"ID":"20240607142735-uo5np8s","Type":"NodeParagraph","Properties":{"id":"20240607142735-uo5np8s","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③治疗肺炎"}]},{"ID":"20240607142735-nr04e93","Type":"NodeParagraph","Properties":{"id":"20240607142735-nr04e93","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用0.2％黄柏碱注射液，每次肌肉注射3毫升，每8小时1次，体温降至正常后2～3天，减为每日注射2次。治疗儿童小病灶性肺炎6例、大叶性肺炎1例，患儿热度均于用药后12～72小时内下降至正常，炎症吸收消散平均为9天。实验证明，黄柏碱在试管内对肺炎双球菌、金黄色葡萄球菌均有显著的抑菌作用。"}]},{"ID":"20240607142735-cbzjpr2","Type":"NodeParagraph","Properties":{"id":"20240607142735-cbzjpr2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"④治疗肺结核"}]},{"ID":"20240607142735-lj9vkog","Type":"NodeParagraph","Properties":{"id":"20240607142735-lj9vkog","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用0.2％黄柏碱注射液3～6毫升，肌肉注射，每日2次，2个月为一疗程。治疗30例（其中浸润型26例、血行播散型4例；有空洞者古17例），治后病灶吸收好转者24例，无变化者6例，8例空洞缩小。血沉增高的23例，治后均见减低。副作用有轻微腹泻，注射局部的疼痛，经调整注射液的pH至6.5左右即仅有酸胀感。一般认为黄柏碱注射液对浸润型渗出为主的炎性病灶有良好的效果，对增殖性病灶则疗效不显。亦有用黄柏干浸膏每日3克，分3饮食后服，3个月为一疗程。治疗12例，治愈8例，进步和显著进步各2例。一般服药后热度很快恢复正常，咯痰减少，食欲增进，体重增加。"}]},{"ID":"20240607142735-zne8tqj","Type":"NodeParagraph","Properties":{"id":"20240607142735-zne8tqj","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑤治疗肝硬化、慢性肝炎"}]},{"ID":"20240607142735-h9hfwxj","Type":"NodeParagraph","Properties":{"id":"20240607142735-h9hfwxj","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用黄柏小檗碱注射液治疗肝硬化40例，临床治愈6例，显效20例，有效10例，无效1例，死亡3例；慢性肝炎19例，临床治愈12例，显效5例，无效2例，治疗期间未见副作用。"}]},{"ID":"20240607142735-zpfez8t","Type":"NodeParagraph","Properties":{"id":"20240607142735-zpfez8t","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑥治疗滴虫性阴道炎"}]},{"ID":"20240607142735-vab0y50","Type":"NodeParagraph","Properties":{"id":"20240607142735-vab0y50","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"每晚清洗阴道后，塞黄柏栓剂1枚（每枚重7克，含黄柏碱0.5克），4次为一疗程；对阴道宫颈炎患者，隔日使用1枚。治疗滴虫性阴道炎14例，13例转为阴性；单纯宫颈炎6人，全部治愈。本药对妊娠及未婚者，均可使用。"}]},{"ID":"20240607142735-pdrerpd","Type":"NodeParagraph","Properties":{"id":"20240607142735-pdrerpd","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑦治疗急性结膜炎"}]},{"ID":"20240607142735-z5f2jqy","Type":"NodeParagraph","Properties":{"id":"20240607142735-z5f2jqy","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用10％黄柏煎液滴眼，治疗儿童患者474例，每次用1～2毫升冲滴，每日2～3次。由于黄柏质量不同，疗效亦有差别。优质黄柏的治愈率100％（78例），3～4日治愈；劣质黄柏的治愈率为55.8％（158例），在3日内治愈者仅23.96％。"}]},{"ID":"20240607142735-5b2jjg1","Type":"NodeParagraph","Properties":{"id":"20240607142735-5b2jjg1","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑧治疗慢性化脓性中耳炎"}]},{"ID":"20240607142735-xayvwpn","Type":"NodeParagraph","Properties":{"id":"20240607142735-xayvwpn","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"采用20％或30％黄柏煎液（滤过冷藏）滴耳。用时先以双氧水洗净外耳道脓液，拭干，而后滴入药液5～10滴，侧卧15分钟。所治76例，有41例合并鼓膜中央性穿孔。治疗效果：痊愈59例，进步13例，无效4例。与0.5％金霉素甘油溶液及4％硼酸酒精溶液作对照，疗效相似。"}]},{"ID":"20240607142735-t3j7hxq","Type":"NodeParagraph","Properties":{"id":"20240607142735-t3j7hxq","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑨治疗慢性上颌窦炎"}]},{"ID":"20240607142735-ka31h21","Type":"NodeParagraph","Properties":{"id":"20240607142735-ka31h21","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"局部穿刺冲洗后，用黄柏流浸膏的30％稀释液徐徐注入，每侧隔4日注入1次。治疗10例，治愈8例，好转2例。"}]},{"ID":"20240607142735-mcr40i4","Type":"NodeParagraph","Properties":{"id":"20240607142735-mcr40i4","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑩治疗耳部湿疹"}]},{"ID":"20240607142735-voyiw54","Type":"NodeParagraph","Properties":{"id":"20240607142735-voyiw54","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用黄柏粉（含小檗碱1.6％）1份，香油1.2份，调成糊状，每日涂药1次。共治疗30例，涂药1～2次后85％以上患者湿烂面干燥结痂，5～7次后均基本好转或痊愈。"}]},{"ID":"20240607142735-1pfclsv","Type":"NodeParagraph","Properties":{"id":"20240607142735-1pfclsv","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑾黄柏所致过敏性药疹"}]},{"ID":"20240607142735-h3qtdhb","Type":"NodeParagraph","Properties":{"id":"20240607142735-h3qtdhb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"曾有1例患者用开水冲服黄柏1钱左右，于服药5～6小时后，胸部发痒，继起多个小疙瘩，并蔓延全身，经脱敏常规治疗而愈。事后再用黄柏煎液行皮肤划痕试验，呈强阳性反应。"}]},{"ID":"20240607142735-45h9x3m","Type":"NodeParagraph","Properties":{"id":"20240607142735-45h9x3m","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607142735-tdvz7l9","Type":"NodeParagraph","Properties":{"id":"20240607142735-tdvz7l9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①《医学启源》：\"黄檗，治肾水膀胱不足，诸瘘厥，腰无力，于黄芪汤中加用，使两膝中气力涌出，痿软即时去矣\"\"二制治上焦，单制治中焦，不制治下焦也。\""}]},{"ID":"20240607142735-r172jlu","Type":"NodeParagraph","Properties":{"id":"20240607142735-r172jlu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"②李杲：\"黄檗、苍术，乃治痿要药，凡去下焦湿热作肿及痛，并膀胱有火邪，并小便不利及黄涩者，并用酒洗黄檗，知母为君，茯苓，泽泻为佐。凡小便不通而口渴者，邪热在气分，肺中伏热不能生水，是绝小便之源也，法当用气味俱薄淡渗之药，猪苓、泽泻之类，泻肺火而清肺金，滋水之化源。若邪热在下焦血分，不渴而小便不通者，乃《素问》所谓无阴则阳无以生，无阳则阴无以化，膀胱者州都之官，津浓藏焉，气化则能出矣。法当用气味俱厚，阴中之阴药治之，黄檗、知母是也。长安王善夫病小便不通，渐成中满，腹坚如石，脚腿裂破出水，双睛凸出，饮食不下，痛苦不可名状，治满利小便渗泄之药服遍矣，予诊之曰，此乃奉养太过，膏粱积热损伤肾水，致膀胱久而干涸，小便不化，火又逆上，而为呕哕。《难经》所谓关则不得小便，格则吐逆者。洁古老人言热在下焦，但治下焦，其病必愈。遂处以北方寒水所化大苦寒之药，黄檗、知母各一两，酒洗焙碾，肉桂一钱为引，热水丸如芡子大，每服二百丸，沸汤下，少时如刀刺前阴火烧之状，溺如瀑泉涌出，床下成流，顾盼之间，肿胀消散。《内经》云，热者寒之，肾恶燥，急食辛以润之。以黄檗之苦寒泻热补水润燥为君，知母之苦寒泻肾火为佐，肉桂辛热为使，寒因热用也。\""}]},{"ID":"20240607142735-fpeujrc","Type":"NodeParagraph","Properties":{"id":"20240607142735-fpeujrc","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"③《本草衍义补遗》：\"檗皮，走手厥阴，而有泻火补阴之功。配细辛，治口疮有奇功。\""}]},{"ID":"20240607142735-63mr5xl","Type":"NodeParagraph","Properties":{"id":"20240607142735-63mr5xl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"④朱震亨：\"黄檗，走至阴，有泻火补阴之功，非阴中之火，不可用也。\"\"得知母滋阴降火，得苍术除湿清热。\""}]},{"ID":"20240607142735-t9hd57x","Type":"NodeParagraph","Properties":{"id":"20240607142735-t9hd57x","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑤《汤液本草》：\"黄檗，足少阴剂，肾苦燥，故肾停湿也，栀子、黄芩入肺，黄连入心，黄檗入肾，燥湿所归，各从其类也。《活人书》解毒汤，上下内外通治之。\""}]},{"ID":"20240607142735-x6da82c","Type":"NodeParagraph","Properties":{"id":"20240607142735-x6da82c","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑥《医学入门》：\"黄檗，治眼赤、鼻齄、喉痹及痈疽发背，乳痈脐疮亦用。东垣云，泻下焦隐伏之龙火，安上出虚哕之蛔虫，单治而能补肾不足，生用而能补阴痿厥，凡下体有湿，瘫痪肿痛，及膀胱有水，小便黄，小腹虚痛者，必用之，兼治外感肌热，内伤骨热，失血遗精阴痿。抑考黄连入心，栀、芩入肺，黄柏入肾，肾苦燥停湿，柏味微辛而能淘燥，性利下而能除湿，故为肾经主药。然《本经》谓其主五脏热者，盖相火狂越上冲，肠胃干涸，五脏皆火，以上诸症，皆火之所为，湿亦火之郁而成也，用以泻火则肾水自固，而无狂越漏泄之患，所谓补肾者，亦此意也。丹溪谓肾家无火，而两尺脉微或左尺独旺者，皆不宜用，惟两尺脉俱旺者最宜。\""}]},{"ID":"20240607142735-tzjlyir","Type":"NodeParagraph","Properties":{"id":"20240607142735-tzjlyir","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"古书言知母佐黄檗滋阴降火，有金水相生之义，黄檗无知母，犹水母之无虾也。盖黄檗能治膀胱命门中之火，知母能清肺金，滋肾水之化源，故洁古、东垣、丹溪皆以为滋阴降火要药，上古所未言也。盖气为阳，血为阴，邪火煎熬，则阴血渐涸，故阴虚火动之病须之，然必少壮气盛能食者，用之相宜，若中气不足，而邪火炽盛者，久服则有寒中之变。近时虚损及纵欲求嗣之人用补阴药，往往以此二味为君，日日服饵，降令太过，脾胃受伤，真阳暗损，精气不暖，致生他病。盖不知此物苦寒而滑渗，且苦味久服，有反从火化之害，故叶氏《医学统旨》有四物加知母、黄檗，久服伤胃，不能生阴之戒。\"\"生用则降实火，熟用则不伤胃，酒制则治上，盐制则治下，蜜制则治中。\""}]},{"ID":"20240607142735-c0bb8mb","Type":"NodeParagraph","Properties":{"id":"20240607142735-c0bb8mb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑧《本草经疏》：\"黄檗，主五脏肠胃中结热。盖阴不足，则热始结于肠胃；黄瘅虽由湿热，然必发于真阴不足之人；肠澼痔漏，亦皆湿热伤血所致；泄痢者，滞下也，亦湿热干犯肠胃之病；女子漏下赤白，阴伤蚀疮，皆湿热乘阴虚流客下部而成；肤热赤起，目热赤痛口疮，皆阴虚血热所生病也。以至阴之气，补至阴之不足，虚则补之，以类相从，故阴回热解，湿燥而诸证自除矣。乃足少阴肾经之要药，专治阴虚生内热诸证，功烈甚伟，非常药可比也。\""}]},{"ID":"20240607142735-m29i3qg","Type":"NodeParagraph","Properties":{"id":"20240607142735-m29i3qg","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑨《本草正》：\"黄檗，性寒润降，去火最速，丹溪言其制伏龙火，补肾强阴，然龙火岂沉寒可除，水枯岂苦劣可补，阴虚水竭，得降愈亡，扑灭元阳，莫此为甚，水未枯而火盛者，用以抽薪则可，水既竭而枯热者，用以补阴实难，当局者慎勿认为补剂。予尝闻之丹溪曰，君火，……可以直折，黄连之属可以制之；相火，……当从其性而伏之，惟黄柏之属可以降之。按此议论若有高见，而实矫强之甚。夫所谓从其性者，即《内经》从治之说也，《经》曰：正者正治，从者反治。正治者，谓以水制火，以寒治热也；从治者，谓以火济火，以热治热也；亦所谓甘温除大热也，岂以黄连便是正治，黄柏便是从治乎?即曰黄连主心火，黄柏主肾火，然以便血、溺血者，俱宜黄连，又岂非膀胱、大肠下部药乎?治舌疮口疮者，俱宜黄柏，又岂非心、脾上部药乎?总之，黄连、黄柏均以大苦大寒之性，而曰黄连为水，黄柏非水，黄连为泻，黄柏为补，岂理也哉?\""}]},{"ID":"20240607142735-jnrjrk4","Type":"NodeParagraph","Properties":{"id":"20240607142735-jnrjrk4","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑩《药品化义》：\"黄柏，味苦入骨，是以降火能自顶至踵，沦肤彻髓，无不周到，专泻肾与膀胱之火。盖肾属寒水，水多则渐消，涸竭则变热。若气从脐下起者。阴火也。《内经》曰，肾欲坚，以苦坚之，坚即为补，丹溪以此一味名大补丸，用盐水制，使盐以入肾，主降阴火以救肾水。用蜜汤拌炒，取其恋膈而不骤下，治五心烦热、目痛口疮诸症。单炒褐色，治肠红痔漏，遗精白浊，湿热黄疸。又膀胱热，脐腹内痛，凡属相火，用此折之，肾自坚固，而无旁荡之患。因味苦能走骨，能沉下，用酒拌炒，四物汤调服，领入血分，治四肢骨节走痛，足膝酸疼无力，遍身恶疮及脚气攻冲，呕逆恶心，阴虚血热，火气于足者，盖此一味，名潜行散，能散阴中之火，亦能安蛔虫，以苦降之之义也。\""}]},{"ID":"20240607142735-46l5w2e","Type":"NodeParagraph","Properties":{"id":"20240607142735-46l5w2e","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑾《本经逢原》：\"黄柏，生用降实火，酒制治阴火上炎，盐制治下焦之火，姜制治中焦痰火，姜汁炒黑治湿热，盐酒炒黑制虚火，阴虚火盛面赤戴阳，附子汁制。\""}]},{"ID":"20240607142735-x773eeg","Type":"NodeParagraph","Properties":{"id":"20240607142735-x773eeg","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⑿《长沙药解》：\"黄柏，泄己土之湿热，清乙木之郁蒸，调热利下重，理黄疸、腹满、伤寒。乌梅丸用之治厥阴伤寒，气上撞心，心中疼热，食即吐蛔，以木郁则虫化，郁冲而生上热，黄柏泄郁升之上热，而杀蛔虫也。白头翁汤用主治厥阴病热利下重者，以木郁则利作，郁陷而生下热，黄柏泄郁陷之下热，而举重坠也。《金匮》栀子柏皮汤用之治太阴病，身黄发热者；大黄硝石汤用之治黄疸腹满小便不利者；以乙木湿陷，不能疏泄，郁生下热，传于膀胱，水窍不开，溢于经络，则身黄腹满而发热，黄柏泄湿热而清膀胱也。阳衰土湿，乙木不达，抑遏而生湿热，冲于胃口，则心中疼热；陷于大肠，则热利下重；郁于膀胱，淫于肌肤，则腹满身黄。黄柏苦寒迅利，疏肝脾而泄湿热，清膀胱而排瘀浊，殊有捷效。最泻肝、肾、脾、胃之阳，后世以此为滋阴补水之剂，误人多矣。\""}]},{"ID":"20240607142735-jfl3l0d","Type":"NodeParagraph","Properties":{"id":"20240607142735-jfl3l0d","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒀《得配本草》：\"以黄柏补水，以其能清自下泛上之阴火，火清则水得坚凝，不补而补也。盖阴中邪火，本非命门之真火，不妨用苦寒者除之，若肾中真水不足，水中之真火虚浮于上，宜用二地以滋之，水足火自归脏也。如误服知、柏，水愈燥而火愈炎，反成孤阳飞越，莫可救矣。\"\"命门之火，安其位为生生之少火，出其位则为烁阴食气之壮火，是畏火也，非急除之不可，川柏、丹皮在所必需。然少火出位，失水之源，用川柏之苦燥，不若丹皮之辛润，为无伤于真阴也。\""}]},{"ID":"20240607142735-m5llg0b","Type":"NodeParagraph","Properties":{"id":"20240607142735-m5llg0b","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒁《本草求真》：\"黄檗，昔人同知母用于六味丸中，名为知檗八味丸，又用知、檗各一两，酒洗焙研入桂，名为滋肾丸，谓其可滋真阴，此说一出，而天下翕然宗之，以至于今，牢不可破。讵知黄檗性禀至阴，味苦性寒，行隆冬肃杀之令，故独入少阴泻火，入膀胱泻热。凡病人因火亢而见骨蒸劳热，目赤耳鸣，消渴便闭，及湿热为病而见诸痿瘫痪，水泻热利，黄疸水肿，痔血肠风，漏下赤白，与乎诸痛疮痒，蛔虫内攻，诊其尺果洪大，按之而有力，可炒黑暂用，使其湿热顺流而下，阴火因而潜伏，则阴不受煎熬，而阴乃得长矣，非谓真阴虚损，服此即有滋润之力也。故于实热实火则宜，而于虚热虚火，则徒有损而无益。阴寒之性，能损人气，减人食，命门真元之火，一见而消亡，脾胃运行之职，一见而沮丧，元气既虚，又用苦寒，遏绝生机，莫此为甚。\""}]},{"ID":"20240607142735-1tf7dt6","Type":"NodeParagraph","Properties":{"id":"20240607142735-1tf7dt6","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"⒂《重庆堂随笔》：\"黄檗之功，昔人已详之矣，或竟视为毒药，痛戒勿用，毋乃议药不议病之陋习耶?《经》言肾欲坚，急食苦以坚之。凡下部不坚之病多矣，如茎痿、遗浊、带漏、痿躄、便血、泻痢诸症，今人不察病情，但从虚寒治之，而不知大半属于虚热也。盖下焦多湿，始因阴虚火盛而湿渐化热，继则湿热阻夫气化，反耗精液，遂成不坚之病，皆黄檗之专司也，去其蚀阴之病，正是保全生气，谁谓苦寒无益于生气哉?盖黄檗治下焦湿热诸证，正与蛇床子治下焦寒湿诸证为对待。\""}]},{"ID":"20240607142735-k4h7gyl","Type":"NodeParagraph","Properties":{"id":"20240607142735-k4h7gyl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607142735-9m7xmsg","Type":"NodeParagraph","Properties":{"id":"20240607142735-9m7xmsg","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 黄皮树的变种秃叶黄皮树（分布湖北、四川、贵州、陕西）、峨嵋黄皮树（分布四川）、云南黄皮树（分布云南）、镰刀叶黄皮树（分布云南）等也同等入药。"}]},{"ID":"20240607142735-rxtimty","Type":"NodeParagraph","Properties":{"id":"20240607142735-rxtimty","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607142735-t6yur5c","Type":"NodeParagraph","Properties":{"id":"20240607142735-t6yur5c","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607142735-jrxmncg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142735-jrxmncg","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"《中华本草》：黄柏"}]},{"ID":"20240607142735-bf27ewz","Type":"NodeParagraph","Properties":{"id":"20240607142735-bf27ewz","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607142735-7o9mz7t","Type":"NodeParagraph","Properties":{"id":"20240607142735-7o9mz7t","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" Huánɡ Bò"}]},{"ID":"20240607142735-5y6cp1r","Type":"NodeParagraph","Properties":{"id":"20240607142735-5y6cp1r","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607142735-1gu4p8x","Type":"NodeParagraph","Properties":{"id":"20240607142735-1gu4p8x","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 檗木、檗皮、黄檗。"}]},{"ID":"20240607142735-gmfoohd","Type":"NodeParagraph","Properties":{"id":"20240607142735-gmfoohd","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607142735-b4qbo48","Type":"NodeParagraph","Properties":{"id":"20240607142735-b4qbo48","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" Bark of Chinese Corktree, Amur Corktree Bark"}]},{"ID":"20240607142735-yn8khu4","Type":"NodeParagraph","Properties":{"id":"20240607142735-yn8khu4","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607142735-aezjlsh","Type":"NodeParagraph","Properties":{"id":"20240607142735-aezjlsh","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 出自《本草纲目》。"}]},{"ID":"20240607142735-p1spx1y","Type":"NodeParagraph","Properties":{"id":"20240607142735-p1spx1y","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"1.《别录》：黄檗，生汉中山谷及永昌。"}]},{"ID":"20240607142735-b3dey63","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607142735-b3dey63","updated":"20240607142735"},"Children":[{"ID":"20240607142735-a0kc7ty","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240607142735-a0kc7ty","updated":"20240607142735"},"Children":[{"ID":"20240607142735-dtmhbfx","Type":"NodeParagraph","Properties":{"id":"20240607142735-dtmhbfx","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"陶弘景： (黄檗)，今出邵陵者，轻薄色深为胜。 出东山者，厚而色浅，其根于道家入木芝品，今人不知取服之。又有一种小树，状如石榴，其皮黄而苦，俗呼为子檗，亦主口疮。又一种小树，多刺，皮亦黄，亦主口疮。"}]}]}]},{"ID":"20240607142735-m1yfd1k","Type":"NodeParagraph","Properties":{"id":"20240607142735-m1yfd1k","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》：《图经》云，黄檗，树高数文，叶似吴茱萸，亦如紫椿，皮黄，其根如松下茯苓。今所在有，本出房、商、合等"}]},{"ID":"20240607142735-0cy10kf","Type":"NodeParagraph","Properties":{"id":"20240607142735-0cy10kf","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607142735-1d7bum1","Type":"NodeParagraph","Properties":{"id":"20240607142735-1d7bum1","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芸香科植物黄檗或黄皮树的树皮。"}]},{"ID":"20240607142735-ihxdzl2","Type":"NodeParagraph","Properties":{"id":"20240607142735-ihxdzl2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Phellodendron amurense Rupr.2.Phellodendron chinense Schneid."}]},{"ID":"20240607142735-1e5kvc1","Type":"NodeParagraph","Properties":{"id":"20240607142735-1e5kvc1","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"采收和储藏：定植15-20年采收，5月上旬至6月上旬，用半环剥或环剥、砍树剥皮等方法剥皮。目前多用环剥，可在夏初的阴天，日平均温度在22-26℃左右，此时形成层活动旺盛，再生树皮容易。选健壮无病虫害的植株，用刀在树段的上下两端分别围绕树干坏割一圈，再纵割一刀，切割深度以不损伤形成层为度，然后将树皮剥下，喷10×10－6吲哚乙酸，再把略长于树段的小竹竿缚在树段上，以免塑料薄膜接触形成层，外面再包塑料薄膜两层，可促使再生新树皮；第2、3年连续剥皮，但产量略低于第1年。注意剥皮后一定要加强培育管理，使树势很快复壮，否则会出现衰退现象。剥下的皮，趁鲜刮掉粗皮，晒至半干，再叠成堆，用石板压平，再晒至全干。"}]},{"ID":"20240607142735-vh46u5j","Type":"NodeParagraph","Properties":{"id":"20240607142735-vh46u5j","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607142735-qmqprwn","Type":"NodeParagraph","Properties":{"id":"20240607142735-qmqprwn","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于山地杂木林中或山谷溪流附近。"}]},{"ID":"20240607142735-8nttg5b","Type":"NodeParagraph","Properties":{"id":"20240607142735-8nttg5b","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.生于杂木林中。"}]},{"ID":"20240607142735-f4debq4","Type":"NodeParagraph","Properties":{"id":"20240607142735-f4debq4","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于东北及华北。"}]},{"ID":"20240607142735-uva1azi","Type":"NodeParagraph","Properties":{"id":"20240607142735-uva1azi","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.分布于陕西南部、浙江、江西、湖北、四川、贵州、云南、广西等地。"}]},{"ID":"20240607142735-g3t7tfs","Type":"NodeParagraph","Properties":{"id":"20240607142735-g3t7tfs","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240607142735-jiqnwvn","Type":"NodeParagraph","Properties":{"id":"20240607142735-jiqnwvn","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 1．黄檗 落叶乔木，高10-25m。树皮厚，外皮灰褐色，木栓发达，不规则网状纵沟裂，内皮鲜黄色。小枝通常灰褐色或淡棕色，罕为红棕色，有小皮孔。奇数羽状复叶对生，小叶柄短；小叶5-15枚，披针形至卵状长圆形，长3-11cm，宽1.5-4cm，先端长渐尖，叶基不等的广楔形或近圆形，边缘有细钝齿，齿缝有腺点，上面暗绿色无毛，下面苍白色，仅中脉基部两侧密被柔毛，薄纸质。雌雄异株；圆锥状聚伞花序，花轴及花枝幼时被毛；花小，黄绿色；雄花雄蕊5，伸出花瓣外，花丝基部有毛；雌花的退化雄蕊呈小鳞片状；雌蕊1，子房有短柄，5室，花枝短，柱头5浅裂。浆果状核果呈球形，直径8-10mm，密集成团，熟后紫黑色，内有种子2-5颗。花期5-6月，果期9-10月。"}]},{"ID":"20240607142735-dp6zx9h","Type":"NodeParagraph","Properties":{"id":"20240607142735-dp6zx9h","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.黄皮树 落叶乔木，高10-12m。树皮外观棕褐色，可见唇形皮孔，外层木栓较薄。奇数羽状复叶对生；小叶7-15，长圆状披针形至长圆状卵形，长9-15cm，宽3-5cm，先端长渐尖，基部宽楔形或圆形，不对称，近全缘，上面中脉上具有锈色短毛，下面密被锈色长柔毛，小叶厚纸质。花单性，雌雄异株；排成顶生圆锥花序，花序轴密被短毛。花紫色；雄花有雄蕊5-6，长于花瓣，退化雌蕊钻形；雌花有退化雄蕊5-6，子房上位，有短柄，5室，花柱短，柱头5浅裂。果轴及果皮粗大，常密被短毛；浆果状核果近球形，直径l-1.5cm，密集成团，熟后黑色，内有种子5-6颗。花期5-6月，果期10-11月。"}]},{"ID":"20240607142735-76hx19k","Type":"NodeParagraph","Properties":{"id":"20240607142735-76hx19k","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240607142735-9skl1jy","Type":"NodeParagraph","Properties":{"id":"20240607142735-9skl1jy","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜凉爽气候，抗风力强，怕干旱、怕涝。苗期稍耐阴，成年树喜阳光，耐严寒。幼树易遭冻害，嫩梢易受晚霜为害，致使分叉，干形不良。以选上层深厚，疏松肥沃，富含腐殖质的微酸性或中性壤土栽培为宜。"}]},{"ID":"20240607142735-l69jlbo","Type":"NodeParagraph","Properties":{"id":"20240607142735-l69jlbo","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、根繁殖。以种子繁殖为主。10-11月果实呈青黑色较硬尚未开裂时即可采收，堆放，盖稻草，约经10-15d果实变黑有臭味时，取出，捣烂果皮，淘洗种子，阴干或晒干。千粒重1.5-16g。用育苗移栽法，南方3月，东北4月下旬至5月上旬，华北3月下旬。秋播可随采随播；春播要在播前1-2月用湿沙保藏种子或用温水浸泡3-5d，按行距30cm开沟，浇水，将种子均匀播火，覆土，稍加镇压，用稻草覆盖。用种量每1hm2约30-45kg。经40-50d出苗。出苗后进行间苗，松土除草，结合追施人畜粪尿，培育12年，苗高约60cm移栽。在落叶至新芽萌发前定植为宜。幼苗挖掘后，将根部过长者适当修剪，按行株距4m ×3m开穴，穴径0.5-1m，深40-60cm，每穴栽1株，填一半士后，将幼苗向上稍提一下，使根部舒展，再填土压实，浇水。"}]},{"ID":"20240607142735-u2kc5tw","Type":"NodeParagraph","Properties":{"id":"20240607142735-u2kc5tw","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"田间管理 定植半月内要经常浇水，保持土壤湿润，每年夏、秋季除草2-3次；春、冬季各追施腐熟饼肥或人畜粪肥，开沟环施，结合培土壅根。"}]},{"ID":"20240607142735-qnp6pxc","Type":"NodeParagraph","Properties":{"id":"20240607142735-qnp6pxc","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有锈病，可在5-6月喷敌锈钢400倍液或波美0.2-0.3度石灰硫黄合剂或25％粉锈宁700倍液。立枯病，5月喷退菌特50％可湿性粉剂500倍液。另有煤污病等。虫害有花椒凤蝶幼虫，可用90％晶体敌百虫800倍液喷杀；牡蛎蚧，可在4、6、9月喷16-18倍松脂合剂或4％杀朴磷酸剂100倍液加上海机油乳剂150倍液或喷20-25倍的机油乳剂。另有黄褐天幕毛虫、地老虎、蚜虫、蝼蛄等为害。"}]},{"ID":"20240607142735-6myl192","Type":"NodeParagraph","Properties":{"id":"20240607142735-6myl192","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607142735-eazlnlu","Type":"NodeParagraph","Properties":{"id":"20240607142735-eazlnlu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）关黄柏树皮呈板片状，略弯曲，长宽不一，厚1-7mm。外表面黄绿或淡黄棕色，平滑，残留栓皮呈发棕色或灰白色，稍有弹性。内表面暗黄色或浅黄棕色，有细密的纵行纹理。体轻，质硬脆，断面绿黄色或淡黄色，皮层部位颗粒状，韧皮部纤维状，呈裂片状分层。气微，味极苦，嚼之有粘性。"}]},{"ID":"20240607142735-betmd85","Type":"NodeParagraph","Properties":{"id":"20240607142735-betmd85","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（2）川黄柏树皮呈浅槽状或板片状，略弯曲，长宽不一，厚1-6mm，外表面黄褐色或黄棕色，平坦，具纵沟纹，残存栓皮厚约0.2mm，灰褐色，无弹性，有唇形横生皮孔，内表面暗黄色或淡棕色，具细密的纵棱纹。体轻，质硬，断面皮层部位略呈颗粒状，韧皮部纤维状，呈裂片状分层，鲜黄色。气微，味极苦，嚼之有粘性。均以皮厚、断面色黄者为佳。"}]},{"ID":"20240607142735-odxebw9","Type":"NodeParagraph","Properties":{"id":"20240607142735-odxebw9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"显微鉴别 树皮横切面：（1）关黄柏栓皮未除尽者可见木栓层细胞数列，栓内层为数列长方形或近圆形的细胞。皮层狭窄，不及皮厚的1/5，石细胞鲜黄色，成群或单个散在，多呈不规则类多角形，有的分枝状，细胞壁极厚，孔沟可见，层纹明显，胞腔小，纤维群较少，散在。韧皮部射线宽2-4列细胞，稍弯曲；韧皮纤维束众多，与韧皮薄壁细胞和筛管群交互排列成层带，纤维黄色，壁极厚，周围薄壁细胞含草酸钙方晶。粘液细胞众多。薄壁细胞中含草酸钙方晶及淀粉粒。"}]},{"ID":"20240607142735-k1u0ag5","Type":"NodeParagraph","Properties":{"id":"20240607142735-k1u0ag5","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（2）川黄柏（黄皮树）树皮横切面构造同关黄柏，区别点为木栓细胞约10余列，部分木栓细胞含棕色物；皮层占皮厚的1/5-1/3，无大型纤维状石细胞。"}]},{"ID":"20240607142735-ihjhowl","Type":"NodeParagraph","Properties":{"id":"20240607142735-ihjhowl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"粉末特征：（1）川黄柏粉末金黄色。①纤维及晶纤维较多，呈鲜黄色，成束或单个散在，多碎断，纤维边缘微波状，直径18-32μm，壁极厚，有的较薄，纤维束周围的薄壁细胞中含有草酸钙方晶，形成晶纤维。②石细胞鲜黄色，成群或单个散在，多为不规则分技状，较大，长至200μm，也有类多角形或短梭形，壁极厚，层纹细密，少数较薄。③草酸钙方晶较多，呈类双锥形、多面体或方形、长方形，直径8-25μm。④粘液细胞类圆形。⑤淀粉粒单粒呈球形，直径3-8μm，复粒稀少，由2-4分粒组成。⑥筛管分子端壁斜，有复筛板，通常由6-7个筛域组成。⑦木栓细胞有时残存，壁稍波状弯曲。"}]},{"ID":"20240607142735-nr7vt9g","Type":"NodeParagraph","Properties":{"id":"20240607142735-nr7vt9g","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"（2）关黄柏粉末呈绿黄色或黄色。特征同川黄柏，但石细胞类圆形、类长方形、纺锤形或略作不规则分枝状，长约至170μm，壁极厚，层纹极细密，少数分枝状石细胞壁较薄。"}]},{"ID":"20240607142735-gf3hh8p","Type":"NodeParagraph","Properties":{"id":"20240607142735-gf3hh8p","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240607142735-utbom6r","Type":"NodeParagraph","Properties":{"id":"20240607142735-utbom6r","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 黄柏流浸膏腹腔注射，对小鼠的半数致死量为2.7g/kg。黄柏碱 腹腔注射 对小鼠的半数致死量为 69.5mg/kg。黄柏果挥发油 灌胃 对小鼠的 半数致死量为 6.683±0.656g/kg。"}]},{"ID":"20240607142735-c43pm49","Type":"NodeParagraph","Properties":{"id":"20240607142735-c43pm49","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607142735-nb1fay4","Type":"NodeParagraph","Properties":{"id":"20240607142735-nb1fay4","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 1．黄檗树皮含小檗碱（berberine）约1.6％，并合少量黄柏碱（phellodendrine），木兰花碱（magnoflorine），药根碱（jatrorrhizine），掌叶防已碱（palmatine），白栝楼碱（candicine），蝙蝠葛任碱（menisperine），胍（guanidine）；另含柠檬苦素（limonin）即黄柏内酯（obaculactone），黄柏酮（obacunone）及γ-，β-谷甾醇（γ-，β-sitosterol），菜油甾醇（campesterol），豆甾醇（stigmasterol），7-去氢豆甾醇（7-dehydrostigmasterol），白鲜交酯（dictamnolide），黄柏酮酸（obacunonic acid），青萤光酸（lumicaeruleic acid），24-亚甲基环木菠萝醇（24-methylenecycloartanol），γ-羟基丁烯内酯衍生物（黄柏）Ⅰ、Ⅱ（γ-hydroxybutenolidederivatives Ⅰ、Ⅱ），牛奶树醇-B（hispiol B），小檗红碱（berberrubine）。根皮中分离出小檗碱约9％，尚有药根碱，白栝楼碱，黄柏碱。果实中含少量小檗碱，掌叶防己碱；另含挥发油约2.16％，油中主要成分为月桂烯（myrcene）约92％，还有少量甲基王酮，微量甲基庚酮以及可能是牻牛儿醇的物质。此外还含有南美花椒酸胺（herculin），5，5’-二甲基糠醛醚（5，5’-dimethylfurfural ether）。叶含黄酮类化合物达10％，从中分离出黄柏甙（phellamurin，鲜叶中约1％），去氢黄柏甙（amurensin，鲜叶中约0.04％），黄柏环合甙（phellodendroside，干叶中约0.14％），黄柏双糖甙（dihydrophelloside），去氢黄柏双糖甙（phelloside），去甲淫羊霍异黄酮次甙（nor-icariside），异黄柏甙（phellavin），去氢异黄柏甙（phellatin），金丝桃甙（hypero-side）。黄柏的叶还含有生物碱。此外还含有多糖，多糖经水解后阿拉伯糖含量约22％-23％，鼠李糖约30％，半乳糖和半乳糖醛酸约占47％左右。另外还分得a-（1-4）-链（半乳糖醛酸）半乳糖[a-（1-4）-linked（galactosyluronic acid）galactose]。"}]},{"ID":"20240607142735-c3mze5p","Type":"NodeParagraph","Properties":{"id":"20240607142735-c3mze5p","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2．黄皮树树皮含小檗碱，木兰花碱，黄柏碱，掌叶防已碱，内酯，甾醇等。果实含赛奥林-NP36（cneorin-NP36），匹西狄醇-A（piscidinol-A），尼洛替星（niloticin），尼洛替星乙酸酯（niloticin acetate），二氢尼洛替星（dihydroniloticin），N-甲基弗林德碱（N-methylflindersine），黄柏呈（phellochin），苦楝子酮（melianone），无羁萜（friedelin），4，10-二亚甲基-7-异丙基-5（E）环癸烯酸[4，10-dimethylene-7-isopropyl-5（E）cyclodecenol]。叶含儿茶糖类化合物。另有报道从黄皮树皮中分离得到线型呋喃香豆精类化合物。同属植物秃叶黄皮树树皮含四氢小檗碱（tetrahydroberberine），四氢掌叶防已碱（tetrahydropalmatine），四氢药根碱（tetrahydrojatrorrhizine），黄柏碱，木兰花碱，β-谷自甾醇。从其愈伤组织中分得小檗碱。台湾黄檗茎和树皮含小檗碱，非洲防已碱（columbamine），药根碱，掌叶防己碱，黄柏碱，芬氏唐松草定碱（thalifendine），木兰花碱和唐松草芬宁碱（thalphenine）。"}]},{"ID":"20240607142735-vfr6xnu","Type":"NodeParagraph","Properties":{"id":"20240607142735-vfr6xnu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607142735-ab9sxi2","Type":"NodeParagraph","Properties":{"id":"20240607142735-ab9sxi2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 黄柏与黄连同样含较多的小檗碱，故其药理作用亦大体相似，参见黄连条。但含量较黄连低，并含有其他成分，作用亦有些差异。"}]},{"ID":"20240607142735-gkbscea","Type":"NodeParagraph","Properties":{"id":"20240607142735-gkbscea","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"1.抗菌作用：黄柏抗菌有效成分为小檗碱，故其药理作用与黄连大体相似，但含量较黄连低。体外试验对金黄色葡萄球菌、肺炎球菌、白喉杆菌、草绿色链球菌、痢疾杆菌（宋内氏除外）、溶血性链球菌、脑膜炎球菌、霍乱弧菌、炭疽杆菌均有效或有较强的抑制作用；对枯草杆菌、百日咳杆菌、破伤风杆菌亦有抑制作用；对H37Rv、鸟型结核杆菌无直接抑制作用，但可使菌数减少，但浓度达1%时呈现抑菌作用。在用豚鼠接种人型结核菌（H37Rv）作实验治疗时，口服或注射的疗效均很差。对接种牛型结核菌的豚鼠，黄柏提取物的盐酸结晶物肌肉注射时，有一定疗效。黄柏对结核病人的临床症状及X线检查有好转，且优于黄连。在试管中，黄柏煎剂或浸剂对常见的致病性真菌有不同程度的抑菌作用。其水煎剂不能杀死钩端螺旋体（剂量需较黄连大I倍）。在体外对阴道滴虫也有弱的作用。据报道，黄柏酸碱法提取物制成1：1黄柏液，用灌肠法可治疗菌痢，一般2-4天可痊愈。黄柏理疗液用直流电导入治疗慢性前列腺炎，总有效率达97.3%。"}]},{"ID":"20240607142735-jvear58","Type":"NodeParagraph","Properties":{"id":"20240607142735-jvear58","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用：关黄柏和川黄柏的乙醚浸提物对新型隐球菌和红色发癣菌具有较强的抑菌作用，其作用比制霉菌素强，但对白色念珠菌的抑制作用比制霉菌享弱。"}]},{"ID":"20240607142735-u7qlqka","Type":"NodeParagraph","Properties":{"id":"20240607142735-u7qlqka","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"3.镇咳作用：黄柏果实的挥发具有镇咳作用，其镇咳成分主要为香叶烯。并从挥发油中分得小檗碱和5，5'－二甲基糠醛醚。"}]},{"ID":"20240607142735-8qf7a4w","Type":"NodeParagraph","Properties":{"id":"20240607142735-8qf7a4w","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"4.降压作用：黄柏对麻醉动物静脉注射或腹腔注射，可产生显着而持久的降压作用，颈动脉注射较静脉注射的更强，因此降压可能是中枢性的。对季铵型的黄柏碱加以改变而合成的叔胺型的化合物名昔罗匹林（Xylopinin）亦可引起迅速、显着之降压；在Ⅰ-Ⅱ颈椎间切断脊髓则降压消失，因而也证明降压属中枢性的。此外，昔罗匹林有较强的抗肾上腺素样作用，对压迫颈动脉、窒息、电刺激大内脏神经引起的升压反应及注射肾上腺素或电刺激颈上交感神经节引起的瞬膜收缩反应均受到抑制。"}]},{"ID":"20240607142735-y5aze2t","Type":"NodeParagraph","Properties":{"id":"20240607142735-y5aze2t","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"5.抗滴虫作用：黄柏煎剂，10%浓度与滴虫液1：1混和培养，对阴道毛滴虫有抑制作用。"}]},{"ID":"20240607142735-mwtthkl","Type":"NodeParagraph","Properties":{"id":"20240607142735-mwtthkl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"6.抗肝炎作用：黄柏煎剂6.25-100%体外试验，对乙型肝炎抗原有抑制作用。黄柏碱对慢性肝炎有一定作用。"}]},{"ID":"20240607142735-k4rglyy","Type":"NodeParagraph","Properties":{"id":"20240607142735-k4rglyy","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"7.对免疫功能的影响：黄柏煎剂，100%浓度，0.3ml/只灌胃，连续7天，能增加小鼠脾空斑形成细胞数。"}]},{"ID":"20240607142735-bqeclt9","Type":"NodeParagraph","Properties":{"id":"20240607142735-bqeclt9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"8.抗溃疡作用：黄柏提取物（去小檗碱）100mg/kg 皮下注射，100、1000mg/kg 灌胃或皮内注射，对乙醇、阿斯匹林或幽门结扎诱发的大鼠胃溃疡有抑制作用。"}]},{"ID":"20240607142735-zeownp9","Type":"NodeParagraph","Properties":{"id":"20240607142735-zeownp9","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"9.其它作用：黄柏碱和昔罗匹林对中枢神经系统有抑制作用，小鼠的自发活动、各种反射均受到抑制；给予未麻醉家兔昔罗匹林，脑电波可出现振幅慢波。黄柏碱有轻度的箭毒样作用，对蛙腹直肌紧张度无影响，但能抑制由乙酰胆碱引起的收缩反应。对离体兔肠，黄柏粉可增强其振幅，黄柏酮可增强其张力及振幅；黄柏内酯则抑制肠管。在带有胰瘘的家兔身上，黄柏有促进胰腺分泌的作用。黄柏内酯在接近致死量（0.05-0.1g/kg）时，可降低兔血糖，黄柏酮无此作用。据称黄柏酮有保护血小板的作用。黄柏对孑孓（10ppm在18小时内可杀死62%）、家蝇有杀灭作用。此外，还有利尿、健胃、外用促进皮下溢血吸收等作用。"}]},{"ID":"20240607142735-5c68kag","Type":"NodeParagraph","Properties":{"id":"20240607142735-5c68kag","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607142735-p2j0oah","Type":"NodeParagraph","Properties":{"id":"20240607142735-p2j0oah","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 1.黄柏：拣去杂质，用水洗净，捞出，润透，切片或切丝，晒干。"}]},{"ID":"20240607142735-nivyue2","Type":"NodeParagraph","Properties":{"id":"20240607142735-nivyue2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.黄柏炭：取黄相片，用武火炒至表面焦黑色(但须存性)，喷淋清水，取出放凉，晒干。"}]},{"ID":"20240607142735-xo9il0n","Type":"NodeParagraph","Properties":{"id":"20240607142735-xo9il0n","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"3.盐黄柏：取黄相片，用盐水喷洒，拌匀，置锅内用文火微炒，取出放凉，晾干(每黄柏片100斤用食盐2斤半，加适量开水溶化澄清)。"}]},{"ID":"20240607142735-87o4vli","Type":"NodeParagraph","Properties":{"id":"20240607142735-87o4vli","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"4.酒黄柏：取黄柏片，用黄酒喷洒拌炒如盐黄柏法(每黄柏片10O斤用黄酒10斤)。"}]},{"ID":"20240607142735-tw3a40d","Type":"NodeParagraph","Properties":{"id":"20240607142735-tw3a40d","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"5.《雷公炮炙论》：凡使(黄檗)，用刀削上粗皮了，用生蜜水浸半日，漉出晒干，用蜜涂，文武火炙令蜜尽为度。凡修事五两，用蜜三两。"}]},{"ID":"20240607142735-oe302ek","Type":"NodeParagraph","Properties":{"id":"20240607142735-oe302ek","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607142735-jgwhojb","Type":"NodeParagraph","Properties":{"id":"20240607142735-jgwhojb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末0.5g，加甲醇10ml，水浴温热数分钟，放冷，滤过，取滤液1ml，加稀盐酸lml与漂白粉少量，显樱红色。（检查小檗碱）（2）取本品粉末少量，置载玻片上，加乙醇2-3滴，加稀盐酸或30％硝酸1-2滴，加盖玻片，片刻后镜检，见黄色针晶簇。（检查小檗碱）（3）取本品粉末1g，加乙醚10ml，冷浸，浸出液蒸去乙醚，残渣以lml冰醋酸溶解，加硫酸1滴，放置，溶液显紫棕色。（检查黄柏酮）（4）薄层色谱取本品粉末0.2g，加甲醇5ml，密塞，振摇30min，滤过，滤液作供试品液；另取盐酸小檗碱，加甲醇制成每1ml含0.5g的溶液作对照品溶液。吸取二溶液分别点样子同一桂胶G薄层板上，以正丁醇-冰醋酸-水（7：1：2）展开，取出，晾干，紫外灯（365nm）下检视。供试品色谱在与对照品色谱的相应位置上，显相同的黄色荧光斑点。"}]},{"ID":"20240607142735-610va68","Type":"NodeParagraph","Properties":{"id":"20240607142735-610va68","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"商品规格 商品按产区分为关黄柏和川黄柏。川黄柏分二个等级，一等：呈平板状，去净粗栓皮，长40cm，宽15cm以上；二等：长、宽大小不分，厚度不得薄于0.2cm，间有栓皮，余同一等。"}]},{"ID":"20240607142735-dqewn8q","Type":"NodeParagraph","Properties":{"id":"20240607142735-dqewn8q","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607142735-ajc88vw","Type":"NodeParagraph","Properties":{"id":"20240607142735-ajc88vw","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 肾；膀胱经"}]},{"ID":"20240607142735-wf39wg0","Type":"NodeParagraph","Properties":{"id":"20240607142735-wf39wg0","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607142735-uavj3q7","Type":"NodeParagraph","Properties":{"id":"20240607142735-uavj3q7","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 苦；寒"}]},{"ID":"20240607142735-26s636k","Type":"NodeParagraph","Properties":{"id":"20240607142735-26s636k","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607142735-ii8midg","Type":"NodeParagraph","Properties":{"id":"20240607142735-ii8midg","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 脾虚泄泻，胃弱食少者忌服。"}]},{"ID":"20240607142735-bc2y5uk","Type":"NodeParagraph","Properties":{"id":"20240607142735-bc2y5uk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"1.《本草经集注》：恶干漆。"}]},{"ID":"20240607142735-ju8x2vh","Type":"NodeParagraph","Properties":{"id":"20240607142735-ju8x2vh","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：阴阳两虚之入，病兼脾胃薄弱，饮食少进及食不消，或兼泄泻，或恶冷物及好热食；肾虚天明作泄；上热下寒，小便不禁；少腹冷痛，子宫寒；血虚不孕，阳虚发热，瘀血停滞，产后血虚发热，金疮发热；痈疽溃后发热，伤食发热，阴虚小水不利，痘后脾虚小水不利，血虚不得眠，血虚烦躁，脾阴不足作泄等证，法咸忌之。"}]},{"ID":"20240607142735-zu9iphn","Type":"NodeParagraph","Properties":{"id":"20240607142735-zu9iphn","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607142735-4bop4r5","Type":"NodeParagraph","Properties":{"id":"20240607142735-4bop4r5","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 清热燥湿；泻火解毒。主湿热痢疾、泄泻、黄疸；梦遗、淋浊、带下；骨蒸劳热；以及口舌生疮；目赤肿痛；痈疽疮毒；皮肤湿疹"}]},{"ID":"20240607142735-vw8se06","Type":"NodeParagraph","Properties":{"id":"20240607142735-vw8se06","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607142735-31std0a","Type":"NodeParagraph","Properties":{"id":"20240607142735-31std0a","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或入丸、散。外用：适量，研末调敷，或煎水浸洗。"}]},{"ID":"20240607142735-78o55ec","Type":"NodeParagraph","Properties":{"id":"20240607142735-78o55ec","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607142735-ptlnv29","Type":"NodeParagraph","Properties":{"id":"20240607142735-ptlnv29","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" ①治小儿热痢下血： 黄檗半两，赤芍药四钱。上同为细末，饭和丸，麻子大。每服一、二十丸，食前米饮下，大者加丸数。 (《阎氏小儿方论》)②治痢疾： 黄柏300克，翻白草450克，秦皮300克。将翻白草、秦皮全部及黄柏200克，共水煎两次，合并煎液，用文火浓缩成膏状，将剩余100克黄柏研细粉加入膏中，搅匀，低温烘干，研细粉。每服一、二克，日三次。(辽宁《中草药新医疗法资料选编》)③治妊娠及产后寒热下痢： 黄檗一斤，黄连一升，栀子二十枚。上三味，细切，以水五升，渍一宿，煮三沸，服一升，一日一夜令尽。呕者加橘皮一把，生姜二两。 (《千金翼方》)④治小儿热泻： 黄檗，焙为末，用米汤和丸粟米大。每服一、二十丸，米汤下。(《十全博救方》)⑤治消渴尿多能食： 黄檗一斤，水一升，煮三、五沸，渴即饮之，恣饮数日。(《独行方》)⑥治伤寒身黄，发热： 肥子十五个(擘)，甘草一两(炙)，黄柏二两。上三味，以水四升，煮取一升半，去滓，分温再服。 (《伤寒论》栀子柏皮汤)⑦治筋骨疼痛，因湿热者： 黄檗(炒)、苍术(米泔浸、炒)。上二味为末，沸汤入姜汁调服。二物皆有雄壮之气，表实气实者，加酒少许佐之。(《丹溪心法》二妙散)⑧治热甚梦泄，怔忪恍忽，膈壅舌干：黄檗(去粗皮)一两。捣罗为末，入龙脑一钱匕，同研匀，炼蜜和丸如梧桐子大。每服一丸至十九丸，浓煎麦冬汤下。(《圣济总录》清心丸)⑨治白淫，梦泄遗精及滑出而不收： 黄檗一斤(放新瓦上烧令通赤为度)，真蛤粉一斤。上为细末，滴水为丸，如桐子大。每服一百丸， 空心酒下。 (《素问病机保命集》珍珠粉丸)⑩治下阴自汗，头晕腰酸： 黄柏三钱，苍术四钱，川椒三十粒，加水2000毫升，煎至600毫升。每次100毫升，一日三次，二日服完。〔《中级医刊》(3)∶177，1966〕11.降阴火、补肾水： 黄檗(炒褐色)、知母(酒浸，炒)各四两，熟地黄(酒蒸)、龟板(酥炙)各六两。上为末，猪脊髓、密丸。服七十丸，空心盐白汤下。(《丹溪心法》大补丸)12.降心火，益肾水： 黄檗三两，砂仁一两半，甘草一两。上为细末，稀糊为丸，如梧桐子大。每服五十丸，用肉苁蓉半两，切碎，用酒一大盏，浸一宿，次日早空心煎三、四沸，去滓，以清酒送下。 (《奇效良方》封髓丹)13.治时行赤目： 黄檗，去粗皮，为末，湿纸包裹，黄泥固，煨干。每用一弹子大，纱帕包之，浸水一盏，饭上蒸熟，乘热熏洗。一丸可用三、五次。(《眼科龙木论》五行汤)14.治小儿蓐内赤眼：黄檗，以乳浸，点之。(《小品方》)15.治口中及舌上生疮： 捣黄檗含之。 (《千金方》)16.治小儿重舌： 黄檗，以竹沥渍取，细细点舌上。(《千金方》)17.治口疳臭烂： 黄檗五钱，铜绿三钱。共为未掺之，去涎，愈。 (《小品方》)18.治唇疮痛痒： 黄檗末， 以野蔷薇根捣汁调涂。 (《圣济总录》)19.治肺壅，鼻中生疮，肿痛： 黄檗、槟榔等分。捣罗为末，以猪脂调敷之。(《圣惠方》)20、治奶发，诸痈疽发背及妒乳： 捣黄檗末，筛，鸡子白和，厚涂之。干，复易。(《补缺肘后方》)21.治痈疽肿毒： 黄檗皮(炒)、川乌头(炮)等分。为未调涂之，留头，频以米浴泔润湿。 (《濒湖集简方》)22.治男子阴疮损烂： 一、煮黄檗洗之，又白蜜涂之。二、黄连、黄檗等分，末之，煮肥猪肉汁，渍疮讫，粉之。 (《补缺肘后方》)23.治小儿脐疮不合： 黄檗末涂之。 (《子母秘录》)24.治小儿脓疮，遍身不干： 黄檗末， 入桔矾少许掺之。(《简便单方》)"}]},{"ID":"20240607142735-gocy4i3","Type":"NodeParagraph","Properties":{"id":"20240607142735-gocy4i3","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607142735-b2texhn","Type":"NodeParagraph","Properties":{"id":"20240607142735-b2texhn","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 1.治疗流行性脑脊髓膜炎： 用黄柏制成的流浸膏(每毫升相当生药黄柏1g)，3岁以下每6小时服3ml，3岁以上4-6ml，成人6-lOml。治疗2O例，年龄最大24岁，最小4岁，病程最短1天，最长18天，全部治愈。轻症治疗后1天即好转，一般约在治疗8天后症状与体征消失，约10天后脑脊液转为正常。治疗同时仍应予水分、营养及常规护理，并辅以一般对症处理。对于呕吐剧烈的患者，有人试用黄柏甘草汤(黄柏1两，甘草4钱，加水煎成100ml)作保留灌肠，首次50ml，以后每次30ml，每6小时1次。待呕吐停止后，改为内服。治疗10余例，其中4例自始至终均采用保留灌肠法，疗效与内服相同。"}]},{"ID":"20240607142735-4zqh67m","Type":"NodeParagraph","Properties":{"id":"20240607142735-4zqh67m","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.治疗细菌性痢疾： 内服黄柏干浸冒(0.13g＝生药1g)，每次0.4g，每日3-4次，治疗31例，全部治愈。又采用黄柏干浸膏(0.2g＝生药 1g)每次0.9g，每日4次，连服2-3日，治疗25例，治愈24例。退热平均为2.3天，腹痛及乙状结肠部压痛消失为4天，里急后重消失为3.3天，大便性状恢复正常肉眼为4天，镜检为4.7天，粪培养转阴为4.4天。有用盐酸黄柏小檗碱片(每片含盐酸小檗碱0.04g，相当于生药1g)，首剂服0.24-0.32g，以后每4小时服0.12-0.16g，临床症状好转后，改为每6小时给药1次。治疗菌痢83例，痊愈82例。体温降至正常平均为1.6天；腹痛消失为4天；里急后重消失为3.8天，便次恢复正常为3.8天；粪检恢复正常为4.8天；粪培养阴性为5.4天。多数病例的临床症状、粪检及细菌培养，均在 1周内恢复正常。对于慢性细菌性痢疾，可用黄柏皮切碎晒干，研粉过筛，再用10%酒精泛丸。每次4g，日服2次，7天为一疗程。观察40例，经乙状结肠镜检查结果：3例肠腔粘膜糜烂经2-4疗程治愈2例；16例溃疡经第一疗程愈合者10例，第二疗程愈合者5例，第三疗程愈合者1例；3例重度充血者，经第一疗程治愈者2例，第二疗程治愈看 1例；14例一般充血者，第一疗程治愈10例，第二疗程治愈3例，第三疗程治愈 1例；仅有出血点者4例，于第一疗程全部治愈。采用黄柏生药每次1.5-2钱，每日3次，煎服，疗程8-10天。治疗菌痢156例，痊愈者90%，基本痊愈者4.9%，大便培养转阴率为96%，阴转时间多为2-6天。其近期疗效似较磺胺为优。"}]},{"ID":"20240607142735-l46zwoa","Type":"NodeParagraph","Properties":{"id":"20240607142735-l46zwoa","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"3.治疗肺炎： 用0.2%黄柏碱注射液，每次肌肉注射3ml，每8小时1次，体温降至正常后2-3天，减为每日注射2次。治疗儿童小病灶性肺炎6例、大叶性肺炎1例，患儿热度均干用药后12-72小时内下降至正常，炎症吸收消散平均为9天。实验证明，黄柏碱在试管内对肺炎双球菌、金黄色葡萄球菌均有显着的抑菌作用。"}]},{"ID":"20240607142735-nxepixl","Type":"NodeParagraph","Properties":{"id":"20240607142735-nxepixl","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"4.治疗肺结核：用0.2%黄柏碱注射液3-6ml，肌肉注射，每日2次，2个月为一疗程。治疗30例(其中浸润型26例，血行播散型4例；有空洞者占17例)，治后病灶吸收好转者24例，无变化者6例，8例空洞缩小。血沉增高的23例，治后均见减低。副作用有轻微腹泻，注射局部的疼痛，经调整注射液的 PH至6.5左右即仅有酸胀感。一般认为黄柏碱注射液对浸润型渗出为主的炎性病灶有良好的效果，对增殖性病灶则疗效不显。亦有用黄柏干浸膏每日3g，分3次食后服，3个月为一疗程。治疗12例，治愈8例，进步和显着进步各2例。一般服药后热度很快恢复正常，咯痰减少，食欲增进，体重增加。"}]},{"ID":"20240607142735-6qyxyeu","Type":"NodeParagraph","Properties":{"id":"20240607142735-6qyxyeu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"5.治疗肝硬化、慢性肝炎：用黄柏小檗碱注射液治疗肝硬化40例，临床治愈6例，显效20例，有效10例，无效 1例，死亡3例；慢性肝炎19例，临床治愈12例，显效5例，无效2例，治疗期间未见副作用。"}]},{"ID":"20240607142735-fptst8x","Type":"NodeParagraph","Properties":{"id":"20240607142735-fptst8x","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"6.治疗滴虫性阴道炎：每晚清洗阴道后，塞黄柏栓剂 1枚(每枚重7g，含黄柏碱0.5g)，4次为一疗程；对阴道宫颈炎患者，隔日使用1枚。治疗滴虫性阴道炎14例，13例转为阴性；单纯宫颈炎6人，全部治愈。本药对妊娠及未婚吝，均可使用。"}]},{"ID":"20240607142735-nxyw3u2","Type":"NodeParagraph","Properties":{"id":"20240607142735-nxyw3u2","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"7.治疗急性结膜炎：用10%黄柏煎液滴眼，治疗儿童患者474例，每次用1-2ml冲滴，每日2-3次。由于黄柏质量不同，疗效亦有差别。优质黄柏的治愈率100%(78例)，3-4日治愈；劣质黄柏的治愈率为55.8%(158例)，在3日内治愈者汉23.96%。"}]},{"ID":"20240607142735-gy7tx2w","Type":"NodeParagraph","Properties":{"id":"20240607142735-gy7tx2w","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"8.治疗慢性化脓性中耳炎：采用20%或30%黄柏煎液(滤过冷藏)滴耳。用时先以双氧水洗净外耳道脓液，拭干，而后滴入药液5-10滴，侧卧15分钟。所治76例，有41例合并鼓膜中央性穿孔。治疗效果：痊愈59例，进步13例，无效4例。与0.5%金霉素甘油溶液及4%硼酸酒精溶液作对照，疗效相似。"}]},{"ID":"20240607142735-ev25f4n","Type":"NodeParagraph","Properties":{"id":"20240607142735-ev25f4n","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"9.治疗慢性上颌窦炎：局部穿刺冲洗后，用黄柏流浸膏的30%稀释液徐徐注入，每侧隔4日注入1次。治疗10例，治愈8例，好转2例。"}]},{"ID":"20240607142735-cqd3ded","Type":"NodeParagraph","Properties":{"id":"20240607142735-cqd3ded","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"10.治疗耳部湿疹： 用黄柏粉(含小菜碱 1.6%) 1份，香油1.2份，调成糊状，每日涂药1次。共治疗30例，涂药1-2次后85%以上患者湿烂面干燥结痂，5-7次后均基本好转或痊愈。"}]},{"ID":"20240607142735-mxo2ljf","Type":"NodeParagraph","Properties":{"id":"20240607142735-mxo2ljf","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"11.黄柏所致过敏性药疹：曾有1例患者用开水冲服黄柏1钱左右，于服药5-6小时后，胸部发痒，继起多个小疙瘩，并蔓延全身，经脱敏常规治疗而愈。事后再用黄柏煎液行皮肤划痕试验，呈强阳性反应。"}]},{"ID":"20240607142735-etxgnxf","Type":"NodeParagraph","Properties":{"id":"20240607142735-etxgnxf","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607142735-zgwukt3","Type":"NodeParagraph","Properties":{"id":"20240607142735-zgwukt3","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 1.《医学启源》：黄檗，治肾水膀胱不足，诸痿厥，腰无力，于黄芪汤中加用，使两膝中气力涌出，痿软即时去矣二制治上焦，单制治中焦，不制治下焦也。"}]},{"ID":"20240607142735-7sa4jkw","Type":"NodeParagraph","Properties":{"id":"20240607142735-7sa4jkw","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"2.李杲：黄檗、苍术，乃治痿要药，凡去下焦湿热作肿及痛，并膀胱有火邪，并小便不利及黄涩者，并用酒洗黄檗、知母为君，茯苓、泽泻为佐。凡小便不通而口渴者，邪热在气分，肺中伏热不能生水，是绝小便之源也，法当用气味俱薄淡渗之药，猪苓、泽泻之类，泻肺火而清肺金，滋水之化源。若邪热在下焦血分，不渴而小便不通者，乃《素问》所谓无阴则阳无以生，无阳则阴无以化，膀胱者州都之官，津液藏焉，气化则能出矣。法当用气味俱厚，阴中之阴药治之，黄檗、知母是也。长安王善夫病小便不通，渐成中满，腹坚如石，脚腿裂破出水，双睛凸出，饮食不下，痛苦不可名状，治满利小便渗泄之药服遍矣，予诊之曰，此乃毒养太过，膏粱积热损伤肾水，致膀胱久而干涸，小便不化，火又逆上，而为呕哕。《难经》所谓关则不得小便，格则吐逆者。洁古老人言热在下焦，但治下焦，其病必愈。遂处以北方寒水所化大苦寒之药，黄檗、知母各一两，酒洗焙碾，肉桂一钱为引，熟水丸如芡子大，每服二百丸，沸汤下，少时如刀刺前阴火烧之状，溺如瀑泉涌出，床下成流，顾盼之间，肿胀消散。《内经》云，热者寒之，肾恶燥，急食辛以润之。以黄檗之苦寒泻热补水涸燥为君，知母之苦寒泻肾火为佐，肉桂辛热为使，寒因热用也。"}]},{"ID":"20240607142735-z93uqcm","Type":"NodeParagraph","Properties":{"id":"20240607142735-z93uqcm","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义补遗》：檗皮，走手厥阴，而有泻火补阴之功。配细辛，治口疮有奇功。"}]},{"ID":"20240607142735-b61vnbr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240607142735-b61vnbr","updated":"20240607142735"},"Children":[{"ID":"20240607142735-fjqvlad","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20240607142735-fjqvlad","updated":"20240607142735"},"Children":[{"ID":"20240607142735-6kyv3ev","Type":"NodeParagraph","Properties":{"id":"20240607142735-6kyv3ev","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"朱震亨：黄檗，走至阴，有泻火补阴之功，非阴中之火，不可用也。得知母滋阴降火，得苍术除湿清热。"}]}]}]},{"ID":"20240607142735-292joe6","Type":"NodeParagraph","Properties":{"id":"20240607142735-292joe6","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"5.《汤液本草》：黄檗，足少阴剂，肾苦燥，故肾停湿也，栀子、黄芩入肺，黄连入心，黄檗入肾，燥湿所归，各从其类也。《活人书》解毒汤，上下内外通治之。"}]},{"ID":"20240607142735-3d109gu","Type":"NodeParagraph","Properties":{"id":"20240607142735-3d109gu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"6.《医学入门》：黄檗，治眼赤、鼻皶、喉痹及痈疽发背，乳痈脐疮亦用。东垣云，泻下焦隐伏之龙火，安上出虚哕之蛔虫，单治而能补肾不足，生用而能补阴痿厥，凡下体有湿，瘫痪肿痛，及膀胱有水，小便黄，小腹虚痛者，必用之，兼治外感肌热，内伤骨热，失血遗精阴痿。抑考黄连入心，栀、芩入肺，黄柏入肾，肾苦燥停湿，柏味微辛而能润燥，性利下面能除湿，故为肾经主药。然《本经》谓其主五脏热者，盖相火狂越上冲，肠胃干涸，五脏皆火，以上诸症，皆火之所为，湿亦火之郁而成也，用以泻火则肾水自固，而无狂越漏泄之患，所谓补肾者，亦此意也。丹溪谓肾家无火，而两尺脉微或左尺独旺者，皆不宜用，惟两尺脉俱旺者最宜。"}]},{"ID":"20240607142735-r2bcz2r","Type":"NodeParagraph","Properties":{"id":"20240607142735-r2bcz2r","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"7.《纲目》：古书言知母佐黄檗滋阴降火，有金水相生之义，黄檗无知母，犹水母之无虾也。盖黄檗能治膀胱命门中之火，知母能清肺金，滋肾水之化源，故洁古、东垣、丹溪皆以为滋阴降火要药，上古所未言也。盖气为阳，血为阴，邪火煎熬，则阴血渐涸，故阴虚火动之病须之，然必少壮气盛能食者，用之相宜，若中气不足，而邪火炽盛者，久服则有寒中之变。近时虚损及纵欲求嗣之人用补阴药，往往以此二味为君，日日服饵，降令太过，脾胃受伤，真阳暗损，精气不暖，致生他病。盖不知此物苦寒而滑渗，且苦味久服，有反从火化之害，故叶氏《医学统旨》有四物加知母、黄檗，久服伤胃，不能生阴之戒。生用则降实火，熟用则不伤胃，酒制则治上，盐制则治下，蜜制则治中。"}]},{"ID":"20240607142735-xhrnekc","Type":"NodeParagraph","Properties":{"id":"20240607142735-xhrnekc","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"8.《本草经疏》：黄檗，主五脏肠胃中结热。盖阴不足，则热始结于肠胃；黄瘅虽由湿热，然必发于真阴不足之人；肠痔漏，亦皆湿热伤血所致；泄痢者，滞下也，亦湿热干犯肠胃之病；女子漏下赤白，阴伤蚀疮，皆湿热乘阴虚流客下部而成；肤热赤起，目热赤痛口疮，皆阴虚血热所生病也。以至阴之气，补至阴之不足，虚则补之，以类相从，故阴回热解，湿燥而诸证自除矣。乃足少阴肾经之要药，专治明虚生内热诸证，功烈甚伟，非常药可比也。"}]},{"ID":"20240607142735-11k6pqb","Type":"NodeParagraph","Properties":{"id":"20240607142735-11k6pqb","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"9.《本草正》：黄檗，性寒润降，去火最速，丹溪言其制伏龙火，补肾强阴，然龙火岂沉寒可除，水枯岂苦劣可补，阴虚水竭，得降愈亡，扑灭元阳，莫此为甚，水未枯而火盛者，用以抽薪则可，水既竭而枯热者，用以补阴实难，当局者慎勿认为补剂。予尝闻之丹溪曰，君火，可以直折，黄连之属可以制之；相火，当从其性而伏之，惟黄柏之属可以降之。按此议论若有高见，而实矫强之甚。夫所谓从其性者，即《内经》从治之说也，《经》曰：正者正治，从者反治。正治者，谓以水制火，以寒治热也；从治者，谓以火济火，以热治热也；亦所谓甘温除大热也，岂以黄连便是正治，黄柏便是从治乎?即曰黄连主心火，黄柏主肾火，然以便血、溺血者，俱宜黄连，又岂非膀胱、大肠下部药乎?治舌疮口疮者，俱宜黄拍，又岂非心、脾上部药乎?总之，黄连、黄柏均以大苦大寒之性，而曰黄连为水，黄柏非水，黄连为泻，黄柏为补，岂理也哉?10.《药品化义》：黄柏，味苦入骨，是以降火能自顶至踵，沦肤彻髓，无不周到，专泻肾与膀胱之火。盖肾属寒水，水多则惭消，涸竭则变热。若气从脐下起者，阴火也。《内经》曰，肾欲坚，以苦坚之，坚即为补，丹溪以此一味名大补丸，用盐水制，使盐以入肾，主降阴火以救肾水。用蜜汤拌炒，取其恋膈而不骤下，治五心烦热、目痛口疮诸症。单炒褐色，治肠红痔漏，遗精白浊，湿热黄疸。又膀胱热，脐腹内痛，凡属相火，用此折之，肾自坚固，而无旁荡之患。因味苦能走骨，能沉下，用酒拌炒，四物汤调服，领入血分，治四肢骨节走痛，足膝酸疼无力，遍身恶疮及脚气攻冲。呕逆恶心，阴虚血热，火气于足者，盖此一味，名潜行散，能散阴中之火，亦能安蛔虫，以苦降之之义也。"}]},{"ID":"20240607142735-7lfofpu","Type":"NodeParagraph","Properties":{"id":"20240607142735-7lfofpu","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"11.《本经逢原》：黄柏，生用降实火，酒制治阴火上炎，盐制治下焦之火，姜制治中焦痰火，姜汁炒黑治湿热，盐酒炒黑制虚火，阴虚火盛面赤戴阳，附子汁制。"}]},{"ID":"20240607142735-u87lwxc","Type":"NodeParagraph","Properties":{"id":"20240607142735-u87lwxc","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"12.《长沙药解》：黄柏，泄己土之湿热，清乙木之郁蒸，调热利下重，理黄疸、腹满、伤寒。乌梅丸用之治厥阴伤寒，气上撞心，心中疼热，食即吐蛔，以木郁则虫化，郁冲而生上热，黄柏泄郁升之上热，而杀蛔虫也。白头翁汤用之治厥阴病热利下重者，以木郁则利作，郁陷而生下热，黄柏泄郁陷之下热，而举重坠也。《金匮》栀子柏皮汤用之治太阴病，身黄发热者；大黄硝石汤用之治黄疸腹满小便不利者；以乙木湿陷，不能疏泄，郁生下热，传于膀胱，水窍不开，溢于经络，则身黄腹满而发热，黄柏泄湿热而清膀胱也。阳衰土湿，乙木不达，抑遏面生湿热，冲于胃口，则心中疼热；陷于大肠，则热利下重；郁于膀胱，淫于肌肤，则腹满身黄。黄柏苦寒迅利，疏肝脾而泄湿热，清膀胱而排瘀浊，殊有捷效。最泻肝、肾、脾、胃之阳，后世以此为滋阴补水之剂，误人多。"}]},{"ID":"20240607142735-rszouwd","Type":"NodeParagraph","Properties":{"id":"20240607142735-rszouwd","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"13.《得配本草》：以黄柏补水，以其能清自下泛上之阴火，火清则水得坚凝，不补而补也。盖阴中邪火，本非命门之真火，不妨用苦寒者除之，若肾中真水不足，水中之真火虚浮于上，宜用二地以滋之，水足火自归脏也。如误服知、相，水愈燥而火愈炎，反成孤阳飞越，莫可救矣。命门之火，安其位为生生之少火，出其位则为烁阴食气之壮火，是畏火也，非急除之不可，川柏、丹皮在所必需。然少火出位，失水之源，用川柏之苦燥，不若丹皮之辛润，为无伤于真阴也。"}]},{"ID":"20240607142735-x3iz030","Type":"NodeParagraph","Properties":{"id":"20240607142735-x3iz030","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"14.《本草求真》：黄檗，昔人同知母用于六味丸中，名为知檗八味丸，又用知、檗各一两，酒洗焙研入桂，名为滋肾丸，谓其可滋真阴，此说一出，而天下翕然宗之，以至于今，牢不可破。返知黄檗性禀至阴，味苦性寒，行隆冬肃杀之令，故独入少阴泻火，入膀胱泻热。凡病人团火亢而见骨蒸劳热，目赤耳鸣，消渴便闭，及湿热为病而见诸痿瘫痪，水泻热利，黄疸水肿，痔血肠风，漏下赤白，与乎诸痛疮痒，蛔虫内攻，诊其尺果洪大，按之而有力，可炒黑暂用，使其湿热顺流而下，阴火因而潜伏，则阴不受煎熬，而阴乃得长矣，非谓真阴虚损，服此即有滋润之力也。故于实热实火财宜，而于虚热虚火，则徒有损而无益。阴寒之性，能损人气，减人食，命门真元之火，一见而消亡，脾胃运行之职，一见而沮丧，元气既虚，又用蓄寒，遏绝生机，莫此为甚。"}]},{"ID":"20240607142735-s54s42o","Type":"NodeParagraph","Properties":{"id":"20240607142735-s54s42o","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"15.《重庆堂随笔》：黄檗之功，昔人已详之矣，或竟视力毒药，痛戒勿用， 毋乃议药不议病之陋习耶?《经》言肾欲坚，急食苦以坚之。凡下部不坚之病多矣，如茎痿、遗浊、带漏、痿躄、便血、泻痢诸症，今人不察病情，但从虚寒治之，而不知大半属于虚热也。盖下焦多湿， 始因阴虚火盛而湿渐化热，继则湿热阻夫气化，反耗精液，遂成不坚之病，皆黄檗之专司也，去其蚀阴之病，正是保全生气，谁谓苦寒无益于生气哉盖黄檗治下焦湿热诸证，正与蛇床子治下焦寒湿诸证为对待。"}]},{"ID":"20240607142735-47wednk","Type":"NodeParagraph","Properties":{"id":"20240607142735-47wednk","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607142735-y1asgke","Type":"NodeParagraph","Properties":{"id":"20240607142735-y1asgke","updated":"20240607142735"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240607142737-qla1tw2","Type":"NodeThematicBreak","Properties":{"id":"20240607142737-qla1tw2"}},{"ID":"20240607142738-923sg2d","Type":"NodeParagraph","Properties":{"id":"20240607142738-923sg2d"}}]}