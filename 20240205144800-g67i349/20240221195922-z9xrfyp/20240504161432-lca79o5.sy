{"ID":"20240504161432-lca79o5","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504161432-lca79o5","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504161432-lca79o5\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240620145959-9m4cfvk\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240617103414-z8hjnm0\u0026quot;,\u0026quot;scrollTop\u0026quot;:1800,\u0026quot;focusId\u0026quot;:\u0026quot;20240620150300-iyhiizf\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"099榆皮（榆白皮）","type":"doc","updated":"20240809093529"},"Children":[{"ID":"20240620145959-9m4cfvk","Type":"NodeParagraph","Properties":{"id":"20240620145959-9m4cfvk","updated":"20240620145959"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 428px;","style":"width: 418px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620145959-gq6ew7e.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 418px;\" parent-style=\"width: 428px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809090940-nal86ci","Type":"NodeParagraph","Properties":{"id":"20240809090940-nal86ci","updated":"20240809091400"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 358px;","style":"width: 348px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"榆树 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/榆树 4-20240809091352-614s324.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 348px;\" parent-style=\"width: 358px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809091521-1hv9xbr","Type":"No