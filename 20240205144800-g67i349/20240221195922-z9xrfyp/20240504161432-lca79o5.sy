th: 489px;","style":"width: 479px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240620151517-qgrt1p7.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 479px;\" parent-style=\"width: 489px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 598px;","style":"width: 588px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"榆树 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/榆树 11-20240809092251-czzvs18.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240809093518-0l27w7p","Type":"NodeParagraph","Properties":{"id":"20240809093518-0l27w7p","updated":"20240809093529"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：榆白皮是榆树的树皮；"}]},{"ID":"20240809090721-hrxxqjv","Type":"NodeParagraph","Properties":{"id":"20240809090721-hrxxqjv","updated":"20240809093517"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：榆钱是榆树的翅果；"}]},{"ID":"20240617103202-zbzeejg","Type":"NodeThematicBreak","Properties":{"id":"20240617103202-zbzeejg"}},{"ID":"20240617103159-5rxhcxa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103159-5rxhcxa","updated":"20240617103159"},"Children":[{"Type":"NodeText","Data":"榆皮《神农本草经》"}]},{"ID":"20240617103159-gya4sg3","Type":"NodeParagraph","Properties":{"id":"20240617103159-gya4sg3","updated":"20240617103159"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240617103159-ks0j6xj","Type":"NodeParagraph","Properties":{"id":"20240617103159-ks0j6xj","updated":"20240617103159"},"Children":[{"Type":"NodeText","Data":"主大小便不通，利水道，除邪气，久服，轻身不饥，其实尤良。一名零榆。生山谷。"}]},{"ID":"20240617103159-aaarjaq","Type":"NodeParagraph","Properties":{"id":"20240617103159-aaarjaq","updated":"20240617103159"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生颍川，三月采皮，取白，暴干，八月采实。"}]},{"ID":"20240617103159-rwzciyq","Type":"NodeParagraph","Properties":{"id":"20240617103159-rwzciyq","updated":"20240617103159"},"Children":[{"Type":"NodeText","Data":"案《说文》云：榆，白枌，榆也；《广雅》云：柘榆，梗榆也；《尔雅》云：榆，白枌；郭璞云：枌榆先生叶，却着荚，皮色白，又工荎.郭璞云：令云刺榆；《毛诗》云：东门之枌，《传》云枌，白榆也；又山有《传》云：枢荎也；陆玑云：其针刺如柘，其叶如榆。渝为茹，美滑如白榆之类，有十种，叶皆相似，皮及木理异矣。"}]},{"ID":"20240617103159-6bgr61o","Type":"NodeThematicBreak","Properties":{"id":"20240617103159-6bgr61o","updated":"20240617103159"}},{"ID":"20240607142254-vx71646","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142254-vx71646","updated":"20240607142257"},"Children":[{"Type":"NodeText","Data":"榆皮《本草衍义》"}]},{"ID":"20240607142254-dw4czec","Type":"NodeParagraph","Properties":{"id":"20240607142254-dw4czec","updated":"20240607142254"},"Children":[{"Type":"NodeText","Data":"今初春先生荚者是。去上皱涩干枯者，将中间嫩处，锉、干、 为粉。当歉岁，农将以代食。叶青嫩时收贮，亦用以为羹茹。嘉 年，过丰、沛，人阙食，乡民多食此。"}]},{"ID":"20240617103450-7qmpt5t","Type":"NodeThematicBreak","Properties":{"id":"20240617103450-7qmpt5t"}},{"ID":"20240617103452-245h8w5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103452-245h8w5","updated":"20240617103457"},"Children":[{"Type":"NodeText","Data":"榆皮《名医别录》"}]},{"ID":"20240617103452-296gfky","Type":"NodeParagraph","Properties":{"id":"20240617103452-296gfky","updated":"20240617103452"},"Children":[{"Type":"NodeText","Data":"无毒．主治肠胃邪热气，消肿．性滑利．治小儿头疮痂 ．花，主治小儿痫，小便不伤热．生 川．二月采皮，取白曝干．八月采实，并勿令中湿，湿则伤人．"}]},{"ID":"20240617103452-v1mb4v2","Type":"NodeParagraph","Properties":{"id":"20240617103452-v1mb4v2","updated":"20240617103459"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶榆皮，味甘，平．主大小便不通，利水道，除邪气．久服轻身不饥．其实尤良。一名零榆。生山谷。"}]},{"ID":"20240607142208-nqhcebw","Type":"NodeThematicBreak","Properties":{"id":"20240607142208-nqhcebw"}},{"ID":"20240607142233-3xxevg2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142233-3xxevg2","updated":"20240607142241"},"Children":[{"Type":"NodeText","Data":"榆皮《千金翼方》"}]},{"ID":"20240607142233-0xonn2x","Type":"NodeParagraph","Properties":{"id":"20240607142233-0xonn2x","updated":"20240607142233"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主大小便不通，利水道，除邪气，肠胃邪热气，消肿。性滑利。久服轻身不饥。其实尤良，疗小儿头疮痂 。花∶主小儿痫，小便不利，伤热。一名零榆。生川山谷，二月采皮取白，曝干，八月采实。并勿令中湿，湿则伤人。"}]},{"ID":"20240607142209-830rshb","Type":"NodeThematicBreak","Properties":{"id":"20240607142209-830rshb"}},{"ID":"20240607142214-yebpm7q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142214-yebpm7q","updated":"20240607142218"},"Children":[{"Type":"NodeText","Data":"榆皮《本草图经》"}]},{"ID":"20240607142214-1d92p4s","Type":"NodeParagraph","Properties":{"id":"20240607142214-1d92p4s","updated":"20240607142214"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"榆皮（图缺）"},{"Type":"NodeText","Data":"，生 川山谷，今处处有之。三月生荚仁，古人采以为糜羹，今无复食者，惟用陈老实作酱耳。然榆之类有十数种，叶皆相似，但皮及木理有异耳。白榆，皮先生叶，却着荚，皮白色，剥之，刮去上粗皴，中极滑白，即《尔雅》所谓榆白粉也。此皮入药，今孕妇滑胎方多用之。小儿白秃，发不生，捣末，苦酒调涂之。刺榆，有针刺如柘，则古人所茹者，云美于白榆。《尔雅》所谓枢，茎，《诗·唐风》云∶山有枢是也。二月采皮，取白曝干。四月采实，并勿令中湿。榆皮，荒岁农人食之，以当粮不损人。"}]},{"ID":"20240607142131-1m6mz40","Type":"NodeThematicBreak","Properties":{"id":"20240607142131-1m6mz40"}},{"ID":"20240607142159-a8q7a1m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142159-a8q7a1m","updated":"20240607142208"},"Children":[{"Type":"NodeText","Data":"榆皮《本草蒙筌》"}]},{"ID":"20240607142159-0fc4jxr","Type":"NodeParagraph","Properties":{"id":"20240607142159-0fc4jxr","updated":"20240607142159"},"Children":[{"Type":"NodeText","Data":"味甘，气平。性滑利，降也。无毒。多生山谷，处处有之。取向里白皮，旋晒干入药。勿令中湿，湿则伤人。通水道，除五淋，压丹石，利关节。捣和酽醋，凡赤肿薄敷；煎成膏饴，但寒鼽连服。老人服久多睡，孕妇服即滑胎。新剥捣烂如糊，用粘瓦石甚固。"}]},{"ID":"20240607142159-mjdepix","Type":"NodeParagraph","Properties":{"id":"20240607142159-mjdepix","updated":"20240607142159"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"皮涎"},{"Type":"NodeText","Data":"敷癣，杀虫立差。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"压石丹尤灵，生服一两顿效。为羹日饮，水肿即消。"}]},{"ID":"20240607142159-7kh35ef","Type":"NodeParagraph","Properties":{"id":"20240607142159-7kh35ef","updated":"20240607142159"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"主小儿惊痫，亦利尿管闭涩。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"生有荚，作酱甚香。因味微辛，肺气能助。杀诸虫，消心腹恶气并卒心疼；疗小儿，涂痂 头疮及诸癣疥。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荚"},{"Type":"NodeText","Data":"作羹少和牛肉，妇人食即止带崩。"}]},{"ID":"20240607142031-kzcv44w","Type":"NodeThematicBreak","Properties":{"id":"20240607142031-kzcv44w"}},{"ID":"20240607142033-bgaa5nn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142033-bgaa5nn","updated":"20240607142044"},"Children":[{"Type":"NodeText","Data":"榆皮《新修本草》"}]},{"ID":"20240607142033-xhzxpte","Type":"NodeParagraph","Properties":{"id":"20240607142033-xhzxpte","updated":"20240607142033"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主大小便不通，利水道，除邪气。肠胃邪热气，消肿。性滑利。久服轻身不饥，其实尤良。疗小儿头疮痂 。华，主小儿痫，小便不利，伤热。一名零榆。生 川山谷。二月采皮，取白曝干。八月采实，并勿令中湿，湿则伤人。"}]},{"ID":"20240607142033-fod8ali","Type":"NodeParagraph","Properties":{"id":"20240607142033-fod8ali","updated":"20240607142033"},"Children":[{"Type":"NodeText","Data":"此即今榆树耳，剥取皮，刮除上赤皮，亦可临时用之。性至滑利，初生叶，人以作糜羹辈，令人睡眠。嵇公所谓∶榆，令人瞑也。断谷乃屑其皮，并檀皮服之，即所谓不饥者也。"}]},{"ID":"20240607142033-jvztwnu","Type":"NodeParagraph","Properties":{"id":"20240607142033-jvztwnu","updated":"20240607142033"},"Children":[{"Type":"NodeText","Data":"〔谨案〕榆三月实熟，寻即落矣，今称八月采实，恐《本经》误也。"}]},{"ID":"20240607142033-bmrxarm","Type":"NodeThematicBreak","Properties":{"id":"20240607142033-bmrxarm"}},{"ID":"20240607142054-6yq0mug","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607142054-6yq0mug","updated":"20240607142059"},"Children":[{"Type":"NodeText","Data":"榆皮《医学入门》"}]},{"ID":"20240607142054-9v4r8pu","Type":"NodeParagraph","Properties":{"id":"20240607142054-9v4r8pu","updated":"20240607142054"},"Children":[{"Type":"NodeText","Data":"榆皮滑利性甘平，利水通便产易生，心痛头疮当采实，小儿痫热用花清。"}]},{"ID":"20240607142054-s7k1fcd","Type":"NodeParagraph","Properties":{"id":"20240607142054-s7k1fcd","updated":"20240607142054"},"Children":[{"Type":"NodeText","Data":"俞，合也。三月生荚相合。无毒。利水道，消肿满，通大小便，治五淋。除肠胃邪热气，治不眠。疗 通经，治子死腹中，滑胎方多用之。兼治暴患赤肿，妇人妒乳。小儿白秃，和醋渣封之。五丹火疮，鸡清调涂。"}]},{"ID":"20240607142054-db3cie6","Type":"NodeParagraph","Properties":{"id":"20240607142054-db3cie6","updated":"20240607142054"},"Children":[{"Type":"NodeText","Data":"实，味微辛。能助肺气，杀诸虫下气，令人能食，消心腹间恶气，卒冷心痛，疗小儿头痂 及诸疮癣。花，主小儿痫，伤热，小便不利。荚，和牛肉作羹食，治妇人带下。嫩叶作羹食，消水肿，压丹石，利关节。二月采树皮去赤皮焙干，八月采实，并勿令中湿，湿即伤人。"}]},{"ID":"20240617103438-f3jvejy","Type":"NodeThematicBreak","Properties":{"id":"20240617103438-f3jvejy"}},{"ID":"20240617103439-ildos0k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103439-ildos0k","updated":"20240617103444"},"Children":[{"Type":"NodeText","Data":"榆皮《冯氏锦囊秘录》"}]},{"ID":"20240617103439-7zb5sea","Type":"NodeParagraph","Properties":{"id":"20240617103439-7zb5sea","updated":"20240617103439"},"Children":[{"Type":"NodeText","Data":"榆皮，除五淋，通水道，压丹石，利关节，敷赤肿，能滑胎。皮涎敷癣杀虫，立瘥。"}]},{"ID":"20240607142100-f5osnvi","Type":"NodeThematicBreak","Properties":{"id":"20240607142100-f5osnvi"}},{"ID":"20240617103332-csjro5g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103332-csjro5g","updated":"20240617103340"},"Children":[{"Type":"NodeText","Data":"榆皮《证类本草》"}]},{"ID":"20240617103332-cqe172v","Type":"NodeParagraph","Properties":{"id":"20240617103332-cqe172v","updated":"20240617103332"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主大小便不通，利水道，除邪气，肠胃邪热气，消肿。性滑利。久服轻身不饥，其实尤良。疗小儿头疮痂 。"}]},{"ID":"20240617103332-8zamabu","Type":"NodeParagraph","Properties":{"id":"20240617103332-8zamabu","updated":"20240617103332"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花"},{"Type":"NodeText","Data":"主小儿痫，小便不利，伤热。一名零榆。生 川山谷。二月采皮，取白曝干，八月采实，并勿令中湿，湿则伤人。"}]},{"ID":"20240617103332-tlu2vll","Type":"NodeParagraph","Properties":{"id":"20240617103332-tlu2vll","updated":"20240617103332"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此即今榆树，剥取皮，刮除上赤皮，亦可临时用之，性至滑利。初生荚仁以作糜羹，令人多睡。嵇公所谓榆令人瞑也。断谷，乃屑其皮并檀皮服之，即令人不饥。唐本注云∶榆，三月实熟，寻即落矣。今称八月采实，恐《本经》误也。今按 陈藏器本草云∶榆荚，主妇人带下，和牛肉作羹食之。四月收实作酱，似芜荑杀虫，以陈者良。嫩叶作羹食之，压丹石，消水肿。江东有刺榆，无大榆。皮入用，不滑。刺榆，秋实。故陶错误也。臣禹锡等谨按尔雅疏云∶榆之类有十种，叶皆相似，皮及木理异尔。而刺榆有针刺如柘，其叶如榆，瀹为蔬美，滑于白榆。《诗》云∶山有枢是也。药性论云∶榆白皮，滑。能主利五淋，治不眠，疗 。取白皮阴干后，焙杵为末。每日朝夜用水五合，末二钱，煎如胶服，瘥。孟诜云∶生皮主暴患赤肿，以皮三两捣，和三年醋滓，封之，日六、七易，亦治妇人妒乳肿。"}]},{"ID":"20240617103332-1l1w89a","Type":"NodeParagraph","Properties":{"id":"20240617103332-1l1w89a","updated":"20240617103332"},"Children":[{"Type":"NodeText","Data":"眼丹石人采叶生服一、两顿佳。子作酱食，能助肺，杀诸虫下气，令人能食，消心腹间恶气，卒图经曰∶榆皮，生 川山谷，今处处有之。三月生荚仁，古人采以为糜羹，今无复食者，唯用陈老实作酱耳。然榆之类有十数种，叶皆相似，但皮及木理有异耳。白榆先生叶，却着荚，皮白色，剥之，刮去上粗 ，中极滑白，即《尔雅》所谓榆白粉也。此皮入药，今孕妇滑胎方多用之。小儿白秃，发不生，捣末苦酒调涂之。刺榆有针刺如柘，则古人所茹者，云美于白榆。《尔雅》所谓枢， 。《诗·唐风》云∶山有枢是也。二月采皮，取白曝干，四月采食疗生榆皮，利小便，主石淋。又，取叶煮食之，时复食一顿，尤良。高昌人多捣白皮为末，和菜菹食之，甚美。令人能食，仙家长服，服丹石人亦食之。取利关节故也。又，榆仁，可作酱食之，亦甚香美。有少辛味，能助肺气，杀诸虫，下气，令人能食。又，心腹间恶气，内消之。尘者尤良。又，涂诸疮癣，妙。又，卒患冷气心痛，食之瘥。并主小儿痫，小便不利。外台秘要∶治渴，小便利非淋方∶榆皮二片去黑皮，以水一斗，煮取五升。一服三合，日三服。千金方∶五色丹，俗名油肿。若犯多致死，不可轻之。以榆白皮末和鸡子白敷之。"}]},{"ID":"20240617103332-h1rzplb","Type":"NodeParagraph","Properties":{"id":"20240617103332-h1rzplb","updated":"20240617103332"},"Children":[{"Type":"NodeText","Data":"杂米作粥食，小便利。子母秘录∶疗妊娠胎死腹中，或母病欲下胎。榆白皮煮汁服二升。又方∶小儿白秃疮。捣榆白皮末，醋和涂之，虫当出。杨氏产乳∶疗身体及头悉生疮。取榆白皮炒令黄，捣为散，以好苦酒和涂上。又以绵裹覆上，虫出即瘥。嵇叔夜《养生论》云∶榆令人瞑。别说云∶谨按榆白皮焙干为末，妇人妊娠临月，日三服方寸匕。令产极易，产下儿身尚皆涂之，信其验也。又湿捣治如糊，用粘瓦石极有力，京东西北人，以石为碓觜，每用此以胶之。"}]},{"ID":"20240617103332-8hqhgv2","Type":"NodeParagraph","Properties":{"id":"20240617103332-8hqhgv2","updated":"20240617103332"},"Children":[{"Type":"NodeText","Data":"衍义曰∶榆皮，今初春先生荚者是。去上皱涩干枯者，将中间嫩处，锉、干、 为粉，当歉岁，农将以代食，叶青嫩时收贮，亦用以为羹茹。嘉 年，过丰、沛，人阙食，乡民多食此。"}]},{"ID":"20240617103332-maamyo2","Type":"NodeThematicBreak","Properties":{"id":"20240617103332-maamyo2"}},{"ID":"20240617103345-41vmldo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103345-41vmldo","updated":"20240617103351"},"Children":[{"Type":"NodeText","Data":"榆皮《本草经集注》"}]},{"ID":"20240617103345-k63f87e","Type":"NodeParagraph","Properties":{"id":"20240617103345-k63f87e","updated":"20240617103345"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主治大小便不通，利水道，除邪气。肠胃邪热气，消肿，性滑利。"}]},{"ID":"20240617103345-dsjw5vj","Type":"NodeParagraph","Properties":{"id":"20240617103345-dsjw5vj","updated":"20240617103345"},"Children":[{"Type":"NodeText","Data":"久服轻身，不饥，其实尤良。治小儿头疮 。华∶主小儿痫，小便不利，伤热。一名零榆。生 川山谷。二月采皮，取白曝干。八月采实，并勿令中湿，湿则伤人。"}]},{"ID":"20240617103345-y1i9mkd","Type":"NodeParagraph","Properties":{"id":"20240617103345-y1i9mkd","updated":"20240617103345"},"Children":[{"Type":"NodeText","Data":"此即今榆树尔，剥取皮，刮除上赤皮，亦可临时用之。性至滑利，初生叶，人以作糜羹辈，令人睡眠。嵇公所谓∶“榆，令人眠也”。断谷乃屑其皮，并檀皮服之，即所谓不饥者也。"}]},{"ID":"20240617103346-8iiyd8a","Type":"NodeThematicBreak","Properties":{"id":"20240617103346-8iiyd8a"}},{"ID":"20240617103354-e6fw2bh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103354-e6fw2bh","updated":"20240617103400"},"Children":[{"Type":"NodeText","Data":"榆白皮《本草分经》"}]},{"ID":"20240617103354-i0fcjnm","Type":"NodeParagraph","Properties":{"id":"20240617103354-i0fcjnm","updated":"20240617103354"},"Children":[{"Type":"NodeText","Data":"甘平滑利，入大小肠膀胱，利诸窍，渗湿热，滑胎，下有形滞物，治嗽喘不眠。"}]},{"ID":"20240617103355-tf1t2hu","Type":"NodeThematicBreak","Properties":{"id":"20240617103355-tf1t2hu"}},{"ID":"20240617103403-9t0pxak","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103403-9t0pxak","updated":"20240617103408"},"Children":[{"Type":"NodeText","Data":"榆白皮《本草从新》"}]},{"ID":"20240617103403-4m8iklx","Type":"NodeParagraph","Properties":{"id":"20240617103403-4m8iklx","updated":"20240617103403"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滑、利窍、下有形滞物．"}]},{"ID":"20240617103403-xoeeamb","Type":"NodeParagraph","Properties":{"id":"20240617103403-xoeeamb","updated":"20240617103403"},"Children":[{"Type":"NodeText","Data":"甘平滑利．入大小肠膀胱经．通二便．利诸窍．行经脉．渗湿热．滑胎产．（或胎死腹中、服汁亦可下．）下有形留着之物．治五淋肿满．（屑作粥食、小便利瘥．）嗽喘不眠．（嵇康养生论云∶榆令人瞑．）疗疥癣秃疮，消赤肿妒乳．（和陈醋滓封、日六七易效、十剂曰∶滑可去着、冬葵子、榆白皮之属是也．）有赤白二种．采皮为面．荒年当粮可食．香料用之．粘滑胜于胶漆．去粗皮取白．（小儿虫疮、榆皮末和猪脂、涂绵上复之、立瘥、火灼烂疮、榆皮嚼涂之．）"}]},{"ID":"20240617103425-7cnhyci","Type":"NodeThematicBreak","Properties":{"id":"20240617103425-7cnhyci"}},{"ID":"20240617103427-kikhsqc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103427-kikhsqc","updated":"20240617103432"},"Children":[{"Type":"NodeText","Data":"榆白皮《本草求真》"}]},{"ID":"20240617103427-9gw2rw4","Type":"NodeParagraph","Properties":{"id":"20240617103427-9gw2rw4","updated":"20240617103427"},"Children":[{"Type":"NodeText","Data":"（乔木）润燥利窍滑肠赤榆皮"}]},{"ID":"20240617103427-yva3o7i","Type":"NodeParagraph","Properties":{"id":"20240617103427-yva3o7i","updated":"20240617103427"},"Children":[{"Type":"NodeText","Data":"榆白皮（专入胃大小肠）。与冬葵子性皆滑利。味亦相同。故五淋肿满及胎产不下。皆宜服此以治。（诜曰。高昌人多捣白皮为末。和菜菹食甚美。令人能食。仙家长服。服丹石人亦服之。取利关节故也。）但榆有二种。曰赤曰白。白榆皮服能止喘除咳而使人睡。较之赤榆皮之除邪气。稍有不同。然其滑利则一。若脾胃虚寒。服之恐损真耳。（李时珍曰。本经所谓久服轻身不饥。苏颂所谓榆粉多食不损人者。恐非确论也。）"}]},{"ID":"20240617103403-jdw9jji","Type":"NodeThematicBreak","Properties":{"id":"20240617103403-jdw9jji"}},{"ID":"20240617103413-bg5gi04","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617103413-bg5gi04","updated":"20240617103419"},"Children":[{"Type":"NodeText","Data":"榆《本草纲目》"}]},{"ID":"20240617103413-ba57uy0","Type":"NodeParagraph","Properties":{"id":"20240617103413-ba57uy0","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"「释名」零榆。白者名粉。"}]},{"ID":"20240617103413-qlkb1d6","Type":"NodeParagraph","Properties":{"id":"20240617103413-qlkb1d6","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"「气味」（白皮）甘、平、滑利、无毒。"}]},{"ID":"20240617103413-g6xaq3a","Type":"NodeParagraph","Properties":{"id":"20240617103413-g6xaq3a","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240617103413-5s17rrz","Type":"NodeParagraph","Properties":{"id":"20240617103413-5s17rrz","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"1、喘不止。用榆白皮阴干，焙为末，每天清晨和晚上用末二钱、水五合，煎成胶状服下。"}]},{"ID":"20240617103413-greokti","Type":"NodeParagraph","Properties":{"id":"20240617103413-greokti","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"2、虚劳白浊。用榆白皮二升，加水二斗，煮成五升，分五次服下。"}]},{"ID":"20240617103413-4ixrnhc","Type":"NodeParagraph","Properties":{"id":"20240617103413-4ixrnhc","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"3、小便气淋（按：指小便时觉气胀面排尿困难）。用榆枝，石燕子煎水，每日饮服。"}]},{"ID":"20240617103413-0zp2gsx","Type":"NodeParagraph","Properties":{"id":"20240617103413-0zp2gsx","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"4、五淋涩痛。用榆白皮阴干、焙研，每取五我，加水五合，煎如胶，一天服二次"}]},{"ID":"20240617103413-t3u1qtm","Type":"NodeParagraph","Properties":{"id":"20240617103413-t3u1qtm","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"5、口渴多尿。用榆皮二斤，去黑皮，加水一斗，煮成一升。每服三合，一天服三次。"}]},{"ID":"20240617103413-6qvq2gx","Type":"NodeParagraph","Properties":{"id":"20240617103413-6qvq2gx","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"6、身体突然浮肿。用榆皮捣为末，同米煮粥吃，以小便能畅为效。"}]},{"ID":"20240617103413-qv2yavm","Type":"NodeParagraph","Properties":{"id":"20240617103413-qv2yavm","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"7、早产后流血不止。用榆白皮、当归（焙）各半两，加生姜水煎服。"}]},{"ID":"20240617103413-bgokrnv","Type":"NodeParagraph","Properties":{"id":"20240617103413-bgokrnv","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"8、胎死腹中或母因病欲堕胎。用榆白皮煮汁服二升。"}]},{"ID":"20240617103413-mlfm4jl","Type":"NodeParagraph","Properties":{"id":"20240617103413-mlfm4jl","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"9、头、身长疮。用榆白皮研为末，调油涂搽。"}]},{"ID":"20240617103413-k61govi","Type":"NodeParagraph","Properties":{"id":"20240617103413-k61govi","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"10、火伤成疮。嚼榆白皮敷涂。"}]},{"ID":"20240617103413-dg23thl","Type":"NodeParagraph","Properties":{"id":"20240617103413-dg23thl","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"11、五色丹毒（又名游肿）。榆白皮研为末，调鸡蛋白涂搽。"}]},{"ID":"20240617103413-3z20ilt","Type":"NodeParagraph","Properties":{"id":"20240617103413-3z20ilt","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"12、背疽。用榆根白皮，切细，清水洗净，捣至极烂，调香油敷搽，留出疮头透气。药干则以苦茶润湿，若药已不粘，须另换新调的药。"}]},{"ID":"20240617103413-nvwmtsp","Type":"NodeParagraph","Properties":{"id":"20240617103413-nvwmtsp","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"13、小儿瘰疬。用榆白皮生捣如泥，封涂患处。经常换药。榆叶："}]},{"ID":"20240617103413-m4d13w9","Type":"NodeParagraph","Properties":{"id":"20240617103413-m4d13w9","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"1、消水肿，利小便，下石淋。用榆树嫩叶作汤或炒吃。"}]},{"ID":"20240617103413-72d7v07","Type":"NodeParagraph","Properties":{"id":"20240617103413-72d7v07","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"2、胆热虚劳不眠。用榆叶、酸枣仁等分。加蜜做成丸子，每日服适量。"}]},{"ID":"20240617103413-l2qq2gj","Type":"NodeParagraph","Properties":{"id":"20240617103413-l2qq2gj","updated":"20240617103413"},"Children":[{"Type":"NodeText","Data":"3、酒鼻。用榆叶煎汁常洗。"}]},{"ID":"20240617103413-ip0ryt5","Type":"NodeThematicBreak","Properties":{"id":"20240617103413-ip0ryt5"}},{"ID":"20240617103414-z8hjnm0","Type":"NodeParagraph","Properties":{"id":"20240617103414-z8hjnm0"}}]}