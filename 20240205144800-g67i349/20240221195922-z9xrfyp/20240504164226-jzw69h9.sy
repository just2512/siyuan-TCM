{"ID":"20240504164226-jzw69h9","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164226-jzw69h9","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164226-jzw69h9\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240621095926-ysivjz7\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240607172812-zpzap1f\u0026quot;,\u0026quot;scrollTop\u0026quot;:900,\u0026quot;focusId\u0026quot;:\u0026quot;20240621100000-cj1apep\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"120雁肪","type":"doc","updated":"20240811154101"},"Children":[{"ID":"20240621095926-ysivjz7","Type":"NodeParagraph","Properties":{"id":"20240621095926-ysivjz7","updated":"20240621100344"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621095926-8cce3e8.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 570px;","style":"width: 560px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"雁肪2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/雁肪2-20240621100344-z6sd15y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 560px;\" parent-style=\"width: 570px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240621100000-cj1apep","Type":"NodeParagraph","Properties":{"id":"20240621100000-cj1apep","updated":"20240621100037"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 714px;","style":"width: 704px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621100000-z18vazq.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 704px;\" parent-style=\"width: 714px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 553px;","style":"width: 543px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621100037-dfwj9p7.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 543px;\" parent-style=\"width: 553px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240621100117-j2imcyp","Type":"NodeParagraph","Properties":{"id":"20240621100117-j2imcyp","updated":"20240811154101"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621100117-qq95fq4.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 688px;","style":"width: 678px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白额雁 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白额雁 1-20240811154101-i0bclbs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 678px;\" parent-style=\"width: 688px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607172619-9p5oad7","Type":"NodeParagraph","Properties":{"id":"20240607172619-9p5oad7","updated":"20240621095621"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为鸭科动物白额雁、鸿雁等的脂肪。"}]},{"ID":"20240607172619-d90xy54","Type":"NodeThematicBreak","Properties":{"id":"20240607172619-d90xy54"}},{"ID":"20240614173237-7j0fi2v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240614173237-7j0fi2v","updated":"20240614173241"},"Children":[{"Type":"NodeText","Data":"雁肪《神农本草经》"}]},{"ID":"20240614173237-o7vc095","Type":"NodeParagraph","Properties":{"id":"20240614173237-o7vc095","updated":"20240614173237"},"Children":[{"Type":"NodeText","Data":"味甘平。主风挛，拘急，偏枯，气不通利，久服，益气不饥，轻身耐老。一名鹜肪。生池泽。"}]},{"ID":"20240614173237-hwj13ql","Type":"NodeParagraph","Properties":{"id":"20240614173237-hwj13ql","updated":"20240614173237"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：雁肪神农岐伯雷公甘无毒（《御览》有鹜肪二字，当作一名鹜肪），杀诸石药毒。（《御览》引云：采无时）"}]},{"ID":"20240614173237-ve4jfrm","Type":"NodeParagraph","Properties":{"id":"20240614173237-ve4jfrm","updated":"20240614173237"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生江南，取无时。"}]},{"ID":"20240614173237-8dzw3n3","Type":"NodeParagraph","Properties":{"id":"20240614173237-8dzw3n3","updated":"20240614173237"},"Children":[{"Type":"NodeText","Data":"案《说文》云：雁，鹅也。鹜，舒凫，也。《广雅》云：鹅，仓雁也。凫，鹜鸭也。《尔雅》云：舒雁，鹅。郭璞云：礼《记》曰，出如舒雁。今江东呼，又舒凫，鹜。郭璞"}]},{"ID":"20240614173237-1njkvxz","Type":"NodeParagraph","Properties":{"id":"20240614173237-1njkvxz","updated":"20240614173237"},"Children":[{"Type":"NodeText","Data":"云：鸭也。方言云：雁，自关而东，谓之鹅。南楚之外，谓之鹅，或谓之仓。据《说文》云：别有雁，以为鸿雁字无鸭字，鸭，即雁之急音，此雁肪，即鹅鸭脂也。当作雁字，《名医》不晓，别出鹜肪条，又出白鸭鹅条，反疑此为鸿雁，何其谬也。陶苏皆乱说之。"}]},{"ID":"20240614173237-rmzuist","Type":"NodeParagraph","Properties":{"id":"20240614173237-rmzuist","updated":"20240614173237"},"Children":[{"Type":"NodeText","Data":"上禽，上品二种，旧同。"}]},{"ID":"20240607172619-o6v8wks","Type":"NodeThematicBreak","Properties":{"id":"20240607172619-o6v8wks"}},{"ID":"20240607172620-sgxbltc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172620-sgxbltc","updated":"20240607172626"},"Children":[{"Type":"NodeText","Data":"雁肪《医学入门》"}]},{"ID":"20240607172620-nnzaw4p","Type":"NodeParagraph","Properties":{"id":"20240607172620-nnzaw4p","updated":"20240607172620"},"Children":[{"Type":"NodeText","Data":"雁肪无毒味甘平，拘急风挛气不盈，血滞偏枯须久服，肉性相同食不轻。"}]},{"ID":"20240607172620-k64ajja","Type":"NodeParagraph","Properties":{"id":"20240607172620-k64ajja","updated":"20240607172620"},"Children":[{"Type":"NodeText","Data":"雁，阳鸟也。从佳，在厂下，宿于水 也。从人何也？取执挚奠挚为意也。肪，浓脂也。主风挛拘急，偏枯麻痹，血气不通利。取四两炼烊滤过，每日空心暖酒调服一匙，久服益气力，壮筋骨，长须发，聪耳轻身耐老，杀诸药石毒。又和黄豆作丸，补劳瘦，肥白人。六七月食之伤神。《衍义》云∶人不轻易食者，谓其知阴阳之升降，分长少之行序，热则即北，寒则即南，以就中和之气。所以为礼币者，取其信也。其毛自落者，小儿带之疗惊痫。"}]},{"ID":"20240607172620-xkb9998","Type":"NodeThematicBreak","Properties":{"id":"20240607172620-xkb9998"}},{"ID":"20240607172633-21ckipe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172633-21ckipe","updated":"20240607172639"},"Children":[{"Type":"NodeText","Data":"雁肪《本草经集注》"}]},{"ID":"20240607172633-3rkzb83","Type":"NodeParagraph","Properties":{"id":"20240607172633-3rkzb83","updated":"20240607172633"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主治风击，拘急，偏枯，气不通利。久服长毛发须眉，益气，不饥，轻身，耐老。一名 肪。生江南池泽。取无时。"}]},{"ID":"20240607172633-xt9s16r","Type":"NodeParagraph","Properties":{"id":"20240607172633-xt9s16r","updated":"20240607172633"},"Children":[{"Type":"NodeText","Data":"诗云∶大曰鸿，小曰雁。今雁类亦有大小，皆同一形又别有野鹅大于雁，犹似家仓鹅，谓之驾鹅。雁肪自不多食，其肉应亦好。 作木音，云是野鸭。今此一名 肪，则雁、 皆相类尔。此后又有鸭事别注在后。夫雁乃住江湖，而夏应产伏皆往北，恐雁门北人不食此鸟故也，中原亦重之尔。虽采无时，以冬月为好。"}]},{"ID":"20240607172634-s79ot46","Type":"NodeThematicBreak","Properties":{"id":"20240607172634-s79ot46"}},{"ID":"20240607172649-znk9jsm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172649-znk9jsm","updated":"20240607172701"},"Children":[{"Type":"NodeText","Data":"雁肪《本草述钩元》"}]},{"ID":"20240607172649-dm1kbjz","Type":"NodeParagraph","Properties":{"id":"20240607172649-dm1kbjz","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"雁脂也。"}]},{"ID":"20240607172649-ua1k1ov","Type":"NodeParagraph","Properties":{"id":"20240607172649-ua1k1ov","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"气味甘平。主治风挛拘急偏枯。血气不通利。（本经）又治热结胸痞呕吐。更疗耳聋。"}]},{"ID":"20240607172649-l7t65df","Type":"NodeParagraph","Properties":{"id":"20240607172649-l7t65df","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"和鹑（无斑者鹌也。此则有斑。）鹑始以化成。（虾蟆得瓜化为鹑。"}]},{"ID":"20240607172649-3whsrhr","Type":"NodeParagraph","Properties":{"id":"20240607172649-3whsrhr","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"九月变为鹑。）终以卵生。故四时常有之。"}]},{"ID":"20240607172649-6nmtufv","Type":"NodeParagraph","Properties":{"id":"20240607172649-6nmtufv","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"肉"}]},{"ID":"20240607172649-0upyhhc","Type":"NodeParagraph","Properties":{"id":"20240607172649-0upyhhc","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"气味甘平。补五脏。益中续气。实筋骨。耐寒暑。消结热。小儿患疳。下痢五色。"}]},{"ID":"20240607172649-kjcogc5","Type":"NodeParagraph","Properties":{"id":"20240607172649-kjcogc5","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"旦旦食之有效。和小豆生姜煮食。止泻痢。酥煎食。令人下焦肥。湿热臌胀腹大。四肢骨立。不能贴席。谷食不下者。取鹑肉食之。昏晕。少顷。雨汗莫能言。但有更衣状。扶而圊。小便突出白液。凝如鹅脂。数次。下尽遂起。此中焦湿热积久所致也。"}]},{"ID":"20240607172649-bt0ch7l","Type":"NodeParagraph","Properties":{"id":"20240607172649-bt0ch7l","updated":"20240607172649"},"Children":[{"Type":"NodeText","Data":"〔论〕鹑乃蛙化。气性相同。蛙与虾蟆。皆解热治疳。利水消肿。鹑之功用。约略似之。"}]},{"ID":"20240607172649-xs6om5y","Type":"NodeThematicBreak","Properties":{"id":"20240607172649-xs6om5y"}},{"ID":"20240607172708-orfdvfx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172708-orfdvfx","updated":"20240607172715"},"Children":[{"Type":"NodeText","Data":"雁肪《千金翼方》"}]},{"ID":"20240607172708-qvjbdz9","Type":"NodeParagraph","Properties":{"id":"20240607172708-qvjbdz9","updated":"20240607172708"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主风挛，拘急偏枯，气不通利。久服长毛发须眉，益气不饥，轻身耐老。一名 肪，生江南池泽，取无时。"}]},{"ID":"20240607172709-zqnyr5o","Type":"NodeThematicBreak","Properties":{"id":"20240607172709-zqnyr5o"}},{"ID":"20240607172735-w1v7dp8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172735-w1v7dp8","updated":"20240607172740"},"Children":[{"Type":"NodeText","Data":"雁肪《本草衍义》"}]},{"ID":"20240607172735-tq6obbs","Type":"NodeParagraph","Properties":{"id":"20240607172735-tq6obbs","updated":"20240607172735"},"Children":[{"Type":"NodeText","Data":"人多不食者，谓其知阴阳之升降，分长少之行序。世或谓之天厌，亦道家之一说尔。"}]},{"ID":"20240607172735-ldk0e4o","Type":"NodeParagraph","Properties":{"id":"20240607172735-ldk0e4o","updated":"20240607172735"},"Children":[{"Type":"NodeText","Data":"食之则治诸风。《唐本》注曰∶“雁为阳鸟”。其义未尽，兹盖得中和之气，热则即北，寒则即南，以就和气。所以为礼币者，一以取其信，二取其和。"}]},{"ID":"20240607172735-5cj3ubh","Type":"NodeThematicBreak","Properties":{"id":"20240607172735-5cj3ubh"}},{"ID":"20240607172744-d8svfm0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172744-d8svfm0","updated":"20240607172750"},"Children":[{"Type":"NodeText","Data":"雁肪《冯氏锦囊秘录》"}]},{"ID":"20240607172744-mehxzhf","Type":"NodeParagraph","Properties":{"id":"20240607172744-mehxzhf","updated":"20240607172744"},"Children":[{"Type":"NodeText","Data":"雁肪，小曰雁，大曰鸿，能补劳瘦。善逐风挛，多服长毛发生须，久服壮筋膏助气。"}]},{"ID":"20240607172745-stxernb","Type":"NodeThematicBreak","Properties":{"id":"20240607172745-stxernb"}},{"ID":"20240607172754-fp46tiq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607172754-fp46tiq","updated":"20240607172802"},"Children":[{"Type":"NodeText","Data":"雁肪《神农本草经赞》"}]},{"ID":"20240607172754-8bzpa7o","Type":"NodeParagraph","Properties":{"id":"20240607172754-8bzpa7o","updated":"20240607172754"},"Children":[{"Type":"NodeText","Data":"味甘平。主风挛拘急。偏枯气不通利。久服益气不饥。轻身耐老。一名肪。生池泽北乡南翔。知时识序。烹舍能鸣。缴加何取。截玉雪凝。酿松泉煮。强健筋骸。蹑风高举。"}]},{"ID":"20240607172754-mlqoo70","Type":"NodeParagraph","Properties":{"id":"20240607172754-mlqoo70","updated":"20240607172754"},"Children":[{"Type":"NodeText","Data":"礼。季冬之月。雁北乡。魏文帝歌。行群燕辞。归雁南翔。成公绥赋序。奇其应气而知时。"}]},{"ID":"20240607172754-87sn8kq","Type":"NodeParagraph","Properties":{"id":"20240607172754-87sn8kq","updated":"20240607172754"},"Children":[{"Type":"NodeText","Data":"庄子。命竖子杀雁而烹之。主人曰。杀不能鸣者。史记世家。楚人有好以弱弓微缴加归雁之上者。顷襄王召而问之。对曰。见鸟六双。以王何取。魏文帝书。美玉白如截肪。李损之诗。凝阶似截肪。陆游诗。汲泉小瓮酿松肪。陈鉴赋。筋骸强健。陶潜诗。愿言蹑清风。高举寻吾契。"}]},{"ID":"20240617124101-ciyvken","Type":"NodeThematicBreak","Properties":{"id":"20240617124101-ciyvken"}},{"ID":"20240617124102-v7i81ty","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617124102-v7i81ty","updated":"20240617124107"},"Children":[{"Type":"NodeText","Data":"肪《新修本草》"}]},{"ID":"20240617124102-sil3sos","Type":"NodeParagraph","Properties":{"id":"20240617124102-sil3sos","updated":"20240617124102"},"Children":[{"Type":"NodeText","Data":"味甘，无毒。主风虚，寒热。白鸭屎，名鸭通。主杀石药毒，解结缚蓄热。肉，补虚，除热，和脏腑，利水道。"}]},{"ID":"20240617124102-oljspp6","Type":"NodeParagraph","Properties":{"id":"20240617124102-oljspp6","updated":"20240617124102"},"Children":[{"Type":"NodeText","Data":"即是鸭，鸭有家、有野，前《本经》雁肪，一名 肪，其疗小异，此说则专是家鸭耳。"}]},{"ID":"20240617124102-3n2kby4","Type":"NodeParagraph","Properties":{"id":"20240617124102-3n2kby4","updated":"20240617124102"},"Children":[{"Type":"NodeText","Data":"黄雌鸭为补最胜。鸭卵不可合鳖肉食之。凡鸟自死口不闭者，皆不可食之，食之杀人。"}]},{"ID":"20240617124102-v1b17zk","Type":"NodeParagraph","Properties":{"id":"20240617124102-v1b17zk","updated":"20240617124102"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶鸭肪，主水肿。血，解诸毒。肉，主小儿惊痫。头，主水肿，通利小便，古方疗水，用鸭头丸也。"}]},{"ID":"20240607172755-qcu6l23","Type":"NodeThematicBreak","Properties":{"id":"20240607172755-qcu6l23"}},{"ID":"20240607172809-60w84l1","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607172809-60w84l1","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"雁脂"}]},{"ID":"20240607172809-e0kfkhy","Type":"NodeParagraph","Properties":{"id":"20240607172809-e0kfkhy","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607172809-vqpdnfc","Type":"NodeParagraph","Properties":{"id":"20240607172809-vqpdnfc","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" Yàn Zhī"}]},{"ID":"20240607172809-hymqc9o","Type":"NodeParagraph","Properties":{"id":"20240607172809-hymqc9o","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607172809-50j8v6u","Type":"NodeParagraph","Properties":{"id":"20240607172809-50j8v6u","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" 大雁油、鸿雁油"}]},{"ID":"20240607172809-xdsdpin","Type":"NodeParagraph","Properties":{"id":"20240607172809-xdsdpin","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607172809-r132uxc","Type":"NodeParagraph","Properties":{"id":"20240607172809-r132uxc","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" 雁行目鸭科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鸿雁"},{"Type":"NodeText","Data":"Anser cygnoides （L.），以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脂肪"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240607172809-gzk7rbh","Type":"NodeParagraph","Properties":{"id":"20240607172809-gzk7rbh","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607172809-zz3v7qw","Type":"NodeParagraph","Properties":{"id":"20240607172809-zz3v7qw","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" 分布于西伯利亚，冬迁我国沿海一带。"}]},{"ID":"20240607172809-6wen74b","Type":"NodeParagraph","Properties":{"id":"20240607172809-6wen74b","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607172809-5dp44mr","Type":"NodeParagraph","Properties":{"id":"20240607172809-5dp44mr","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" 益气解毒，舒筋活血。主治气血不足，筋挛，肾虚脱发，痈肿疮毒。"}]},{"ID":"20240607172809-8laqbf7","Type":"NodeParagraph","Properties":{"id":"20240607172809-8laqbf7","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607172809-oq2v7ja","Type":"NodeParagraph","Properties":{"id":"20240607172809-oq2v7ja","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" 每服1匙，外用适量。"}]},{"ID":"20240607172809-526tjmu","Type":"NodeParagraph","Properties":{"id":"20240607172809-526tjmu","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607172809-zyrkw7l","Type":"NodeParagraph","Properties":{"id":"20240607172809-zyrkw7l","updated":"20240607172809"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240607172811-npmei5o","Type":"NodeThematicBreak","Properties":{"id":"20240607172811-npmei5o"}},{"ID":"20240607172812-zpzap1f","Type":"NodeParagraph","Properties":{"id":"20240607172812-zpzap1f"}}]}