ta":"​"}]},{"ID":"20240812171020-uomv6v4","Type":"NodeParagraph","Properties":{"id":"20240812171020-uomv6v4","updated":"20240812171735"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苋菜 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苋菜 4-20240812171020-cusl8yl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 573px;","style":"width: 563px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苋菜 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苋菜 5-20240812171735-4l3d9n5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 563px;\" parent-style=\"width: 573px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621143938-mmkuyk2","Type":"NodeParagraph","Properties":{"id":"20240621143938-mmkuyk2","updated":"20240812172142"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：为野苋（刺苋）的种子。"}]},{"ID":"20240611105655-wdn77kb","Type":"NodeThematicBreak","Properties":{"id":"20240611105655-wdn77kb","updated":"20240812170553"}},{"ID":"20240611105759-iwewj3q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611105759-iwewj3q","updated":"20240611105809"},"Children":[{"Type":"NodeText","Data":"苋实《神农本草经》"}]},{"ID":"20240611105759-9s07ijn","Type":"NodeParagraph","Properties":{"id":"20240611105759-9s07ijn","updated":"20240611105759"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240611105759-6cq5yc2","Type":"NodeParagraph","Properties":{"id":"20240611105759-6cq5yc2","updated":"20240611105759"},"Children":[{"Type":"NodeText","Data":"主青盲，明目除邪，利大小便，去寒热。久服，益气力，不饥，轻身。一名马苋。"}]},{"ID":"20240611105759-5v6o923","Type":"NodeParagraph","Properties":{"id":"20240611105759-5v6o923","updated":"20240611105759"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名莫实，生淮阳及田中，叶如蓝，十一月采。"}]},{"ID":"20240611105759-u6578tt","Type":"NodeParagraph","Properties":{"id":"20240611105759-u6578tt","updated":"20240611105759"},"Children":[{"Type":"NodeText","Data":"案《说文》云：苋，苋菜也。《尔雅》云蒉，赤苋。郭璞云：今苋叶之赤茎者。"}]},{"ID":"20240611105759-gzpr3lh","Type":"NodeParagraph","Properties":{"id":"20240611105759-gzpr3lh","updated":"20240611105759"},"Children":[{"Type":"NodeText","Data":"李当之云：苋实，当是今白苋，《唐本》注云：赤苋一名苋，今名莫实字误。"}]},{"ID":"20240611105903-uwtqxig","Type":"NodeThematicBreak","Properties":{"id":"20240611105903-uwtqxig"}},{"ID":"20240611105940-ogqdj5q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611105940-ogqdj5q","updated":"20240611105945"},"Children":[{"Type":"NodeText","Data":"苋实《新修本草》"}]},{"ID":"20240611105940-omapkrc","Type":"NodeParagraph","Properties":{"id":"20240611105940-omapkrc","updated":"20240611105940"},"Children":[{"Type":"NodeText","Data":"味甘，寒、大寒，无毒。主青盲，白翳，明目，除邪，利大小便，去寒热，杀蛔虫。久服益气力，不饥轻身。一名马苋，一名莫实，细苋亦同。生淮阳川泽及田中，叶如蓝，十一月李云即苋菜也。今马苋别一种，布地生，实至微细，俗呼为马齿苋，亦可食，小酸，恐非今苋实。其苋实当是白苋，所以云细苋亦同，叶如蓝也。细苋即是糠苋，食之乃胜，而并冷利，被霜乃熟，故云十一月采。又有赤苋，茎纯紫，能疗赤下，而不堪食。药方用苋实甚稀，断谷方中时用之。"}]},{"ID":"20240611105940-jcvgrsw","Type":"NodeParagraph","Properties":{"id":"20240611105940-jcvgrsw","updated":"20240611105940"},"Children":[{"Type":"NodeText","Data":"〔谨案〕赤苋，一名KT 。今苋实，亦名莫实，疑莫字误矣。赤苋，味辛，寒，无毒。主赤痢，又主射工、沙虱，此是赤叶苋也。马苋，亦名马齿草，味辛，寒，无毒。主诸肿 、疣目，捣揩之饮汁，主反胃，诸淋，金疮，血流，破血，症癖，小儿尤良；用汁洗紧唇，面 、马汁射工毒，涂之瘥。"}]},{"ID":"20240611105948-yrggkfs","Type":"NodeThematicBreak","Properties":{"id":"20240611105948-yrggkfs"}},{"ID":"20240611105958-62uf0tv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611105958-62uf0tv","updated":"20240611110004"},"Children":[{"Type":"NodeText","Data":"苋实《医学入门》"}]},{"ID":"20240611105958-frdtrp9","Type":"NodeParagraph","Properties":{"id":"20240611105958-frdtrp9","updated":"20240611105958"},"Children":[{"Type":"NodeText","Data":"苋实甘寒入血分，能除寒热利二便，散肝风热青盲翳，叶补阴气益产前。"}]},{"ID":"20240611105958-9u1ah5l","Type":"NodeParagraph","Properties":{"id":"20240611105958-9u1ah5l","updated":"20240611105958"},"Children":[{"Type":"NodeText","Data":"言其茎、叶皆高硕可见，故字从见，指事也。或云其子去翳膜，眼有所见也。苋有六种，惟白苋入药，无毒。丹溪云∶下血而又入血分，且善走，散寒热，利大小便，性寒滑故也。治肝风客热、青盲赤瞎、白翳黑花，为末，每夜茶下方寸匕；又杀蛔虫，益气益精。叶，补阴分气虚，除热通九窍。多食动气，令人烦闷，冷中损腹。若与鳖同食，生鳖瘕。又素难产者，取苋和马齿苋临月常食，令滑胎易产。赤苋，茎纯紫，味辛，寒，无毒。主赤痢，气痢，射工砂虱虫毒。"}]},{"ID":"20240611110033-w9v4xhb","Type":"NodeThematicBreak","Properties":{"id":"20240611110033-w9v4xhb"}},{"ID":"20240611110034-xkkz0z4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110034-xkkz0z4","updated":"20240611110038"},"Children":[{"Type":"NodeText","Data":"苋实《冯氏锦囊秘录》"}]},{"ID":"20240611110034-zksr0r7","Type":"NodeParagraph","Properties":{"id":"20240611110034-zksr0r7","updated":"20240611110034"},"Children":[{"Type":"NodeText","Data":"马齿苋，禀天之阴寒，兼得地中之金气，故叶节间有水银得金气多也。味辛，苦，气寒，无毒。其性辛寒，故能凉血散热，所以 结痈疮，疔肿白秃三十六肿风结疔疮捣敷，则肿散疔根拔出，绞汁服则恶物当下，二便能利，虫热能除，目翳能返，胎孕能滑，皆辛寒滑利之功也。凡脾胃虚寒，肠滑者禁之。勿与鳖甲同用，能化小鳖伤人。治赤白下痢，不问老幼、孕妇，捣汁三合，和鸡子白一杖，微温顿服之，不过再作则愈。治多年恶疮，百方不瘥，或痛 走不已者，并捣敷上，不过三两遍即愈，治疔疮肿毒，马齿苋二分，锻石三分，为末，鸡子白和敷之即愈。"}]},{"ID":"20240611110034-50ejrr6","Type":"NodeParagraph","Properties":{"id":"20240611110034-50ejrr6","updated":"20240611110034"},"Children":[{"Type":"NodeText","Data":"苋实除邪，利大便小水，明目退白翳青盲，杀疣虫，去寒热。叶入血分、通经，逐瘀血殊功，下胎孕最捷，孕妇临产，煮食易来，勿多食之，冷中损腹，忌与鳖同食。马齿苋，性滑，主治与苋实颇同，疮科尤善，杖疮敷散血，疔疮敷出根，痈疮痘毒结疮，悉用敷愈，马咬马汗射工毒，并取涂痊。"}]},{"ID":"20240611110034-9zn539f","Type":"NodeParagraph","Properties":{"id":"20240611110034-9zn539f","updated":"20240611110034"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 马齿苋，主痈疮毒，利大小便，不宜多服，恐损胃气，治痘后牙疳疮，宜 存性吹之。"}]},{"ID":"20240611110043-0ctgy5n","Type":"NodeThematicBreak","Properties":{"id":"20240611110043-0ctgy5n"}},{"ID":"20240611110044-pgkq2q8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110044-pgkq2q8","updated":"20240611110048"},"Children":[{"Type":"NodeText","Data":"苋实《玉楸药解》"}]},{"ID":"20240611110044-2g47idl","Type":"NodeParagraph","Properties":{"id":"20240611110044-2g47idl","updated":"20240611110044"},"Children":[{"Type":"NodeText","Data":"味甘，性寒，入手阳明大肠、足太阳膀胱、足厥阴肝经。去翳明目，杀蛔清风。"}]},{"ID":"20240611110044-n0szalz","Type":"NodeParagraph","Properties":{"id":"20240611110044-n0szalz","updated":"20240611110044"},"Children":[{"Type":"NodeText","Data":"苋实清利肝肺，治青盲瞽目、白翳黑花，疏木杀虫，滑肠利水，通利大小二便。"}]},{"ID":"20240611110053-8oj5foa","Type":"NodeThematicBreak","Properties":{"id":"20240611110053-8oj5foa"}},{"ID":"20240611110054-r83f5xw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110054-r83f5xw","updated":"20240611110059"},"Children":[{"Type":"NodeText","Data":"苋实《本草衍义》"}]},{"ID":"20240611110054-36kaw39","Type":"NodeParagraph","Properties":{"id":"20240611110054-36kaw39","updated":"20240611110054"},"Children":[{"Type":"NodeText","Data":"入药亦稀，苗又谓之人苋，人多食之。茎高而叶红黄二色者，谓之红人苋，可淹菜用。"}]},{"ID":"20240611110021-mo4pluz","Type":"NodeThematicBreak","Properties":{"id":"20240611110021-mo4pluz"}},{"ID":"20240611110022-v4c7yp8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110022-v4c7yp8","updated":"20240611110027"},"Children":[{"Type":"NodeText","Data":"苋实《神农本草经赞》"}]},{"ID":"20240611110022-p02qi5z","Type":"NodeParagraph","Properties":{"id":"20240611110022-p02qi5z","updated":"20240611110022"},"Children":[{"Type":"NodeText","Data":"味甘寒。主青盲明目。除邪。利大小便。去寒热。久服益气力。不饥轻身。一名马苋标高易见。指事深论。种需雨候。老怯风掀。丹还跛鳖。格压膏。荇呼哂误。韭化机存。"}]},{"ID":"20240611110022-k1i8acd","Type":"NodeParagraph","Properties":{"id":"20240611110022-k1i8acd","updated":"20240611110022"},"Children":[{"Type":"NodeText","Data":"王十朋诗。标高语更妙。埤雅。苋之茎叶高硕易见。其字从苋。指事也。陆游诗。农事更深论洛阳。花木记。谷雨栽五色苋。王安石诗。紫苋凌风怯。贵耳集。红苋为跛鳖之还丹。方岳诗。琉璃蒸乳压膏。未抵斋厨格调高。颜氏家训诗。参差荇菜。博士皆以参差者。苋菜也。呼人苋为人荇。可笑之甚。淮南子。老韭之为苋也。万物皆出于机。皆入于机。"}]},{"ID":"20240611110010-bgnllny","Type":"NodeThematicBreak","Properties":{"id":"20240611110010-bgnllny"}},{"ID":"20240611110011-8vfzsmi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110011-8vfzsmi","updated":"20240611110016"},"Children":[{"Type":"NodeText","Data":"苋实《千金翼方》"}]},{"ID":"20240611110011-t7ryx7o","Type":"NodeParagraph","Properties":{"id":"20240611110011-t7ryx7o","updated":"20240611110011"},"Children":[{"Type":"NodeText","Data":"味甘，寒，大寒，无毒。主青盲白翳，明目除邪，利大小便，去寒热，杀蛔虫。久服益气力，不饥轻身。一名马苋，一名莫实。细苋亦同，生淮阳川泽及田中，叶如蓝，十一月采。"}]},{"ID":"20240611110107-h3me6zi","Type":"NodeThematicBreak","Properties":{"id":"20240611110107-h3me6zi"}},{"ID":"20240611110109-zt5m144","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110109-zt5m144","updated":"20240611110113"},"Children":[{"Type":"NodeText","Data":"苋《本草纲目》"}]},{"ID":"20240611110109-pg9q0dz","Type":"NodeParagraph","Properties":{"id":"20240611110109-pg9q0dz","updated":"20240611110109"},"Children":[{"Type":"NodeText","Data":"「气味」（菜）甘、冷利、无毒。（苋实）甘、寒、无毒。"}]},{"ID":"20240611110109-afjoddn","Type":"NodeParagraph","Properties":{"id":"20240611110109-afjoddn","updated":"20240611110109"},"Children":[{"Type":"NodeText","Data":"「主治」产后下痢，蛇虫螫伤，漆疮搔痒等。苋实治翳、明目、利大小便。根晒干，烧存性，研末治牙痛。"}]},{"ID":"20240611110119-phce4qk","Type":"NodeThematicBreak","Properties":{"id":"20240611110119-phce4qk"}},{"ID":"20240611110121-4f2txzv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110121-4f2txzv","updated":"20240611110130"},"Children":[{"Type":"NodeText","Data":"苋实《本草蒙筌》"}]},{"ID":"20240611110121-cnc0d8n","Type":"NodeParagraph","Properties":{"id":"20240611110121-cnc0d8n","updated":"20240611110121"},"Children":[{"Type":"NodeText","Data":"味甘，气寒。无毒。园圃多种，夏月才生。入剂拯疴，惟取其实。除邪利大便小水，明目退白翳青盲。杀蛔虫，去寒热。叶忌与鳖同食，又入血分通经。逐瘀血殊功，下胎孕最捷。孕妇临产，煮食易来。勿多食之，冷中损腹。　一种马齿苋性滑，野地最多；主治与苋实颇同，疮科尤善。杖疮敷散血，疔疮敷出根。（和梳垢封患处。一方：用烧灰和陈醋滓先灸后封，根即出。）痈疮、痘疮、风结疮，悉用敷愈；马咬、马汗、射工毒，并取涂痊。种有两般，惟小叶节间有水银者妙（叶大者不堪用；）感多阴气，倘生食捣蒜先拌制过佳。"}]},{"ID":"20240611105800-s5p2uhb","Type":"NodeThematicBreak","Properties":{"id":"20240611105800-s5p2uhb"}},{"ID":"20240611105857-9zgo83q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611105857-9zgo83q","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：苋实"}]},{"ID":"20240611105857-tsnmr1z","Type":"NodeParagraph","Properties":{"id":"20240611105857-tsnmr1z","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611105857-37q9pcw","Type":"NodeParagraph","Properties":{"id":"20240611105857-37q9pcw","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" Xiàn Shí"}]},{"ID":"20240611105857-i6wufee","Type":"NodeParagraph","Properties":{"id":"20240611105857-i6wufee","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611105857-mtg3gys","Type":"NodeParagraph","Properties":{"id":"20240611105857-mtg3gys","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 苋子（《饮膳正要》），苋菜子（《得配本草》）。"}]},{"ID":"20240611105857-gvc2non","Type":"NodeParagraph","Properties":{"id":"20240611105857-gvc2non","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611105857-onmna7n","Type":"NodeParagraph","Properties":{"id":"20240611105857-onmna7n","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611105857-3rhxjd0","Type":"NodeParagraph","Properties":{"id":"20240611105857-3rhxjd0","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611105857-arjltdl","Type":"NodeParagraph","Properties":{"id":"20240611105857-arjltdl","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 为苋科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苋"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。9～11月采。"}]},{"ID":"20240611105857-wdbvlln","Type":"NodeParagraph","Properties":{"id":"20240611105857-wdbvlln","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611105857-0gkoll3","Type":"NodeParagraph","Properties":{"id":"20240611105857-0gkoll3","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 植物形态详\"苋\"条。"}]},{"ID":"20240611105857-xgyaavk","Type":"NodeParagraph","Properties":{"id":"20240611105857-xgyaavk","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611105857-r2roav4","Type":"NodeParagraph","Properties":{"id":"20240611105857-r2roav4","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 《玉楸药解》：\"入手阳明大肠、足太阳膀胱、足厥阴肝经。\""}]},{"ID":"20240611105857-ykvcwuh","Type":"NodeParagraph","Properties":{"id":"20240611105857-ykvcwuh","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611105857-7sxmn1t","Type":"NodeParagraph","Properties":{"id":"20240611105857-7sxmn1t","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240611105857-e85qvir","Type":"NodeParagraph","Properties":{"id":"20240611105857-e85qvir","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，寒。\""}]},{"ID":"20240611105857-3nwwe05","Type":"NodeParagraph","Properties":{"id":"20240611105857-3nwwe05","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"大寒，无毒。\""}]},{"ID":"20240611105857-3e6uwwo","Type":"NodeParagraph","Properties":{"id":"20240611105857-3e6uwwo","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"③《千金·食治》：\"味甘，寒，涩，无毒。\""}]},{"ID":"20240611105857-0cw6hho","Type":"NodeParagraph","Properties":{"id":"20240611105857-0cw6hho","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611105857-wfxc6sz","Type":"NodeParagraph","Properties":{"id":"20240611105857-wfxc6sz","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 清肝明目，通利二便。治青盲翳障，目雾不明，乳糜血尿，二便不利。"}]},{"ID":"20240611105857-2sg1a93","Type":"NodeParagraph","Properties":{"id":"20240611105857-2sg1a93","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主青盲，明目，除邪，利大小便，去寒热。\""}]},{"ID":"20240611105857-s378l3w","Type":"NodeParagraph","Properties":{"id":"20240611105857-s378l3w","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主白翳，杀蛔虫。\""}]},{"ID":"20240611105857-i51frn8","Type":"NodeParagraph","Properties":{"id":"20240611105857-i51frn8","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"益精。\""}]},{"ID":"20240611105857-ot2qp2t","Type":"NodeParagraph","Properties":{"id":"20240611105857-ot2qp2t","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"④《本草图经》：\"主翳目黑花，肝风客热等。\""}]},{"ID":"20240611105857-mr8xz6e","Type":"NodeParagraph","Properties":{"id":"20240611105857-mr8xz6e","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"⑤《民间常用草药汇编》：\"治伤风咳嗽。\""}]},{"ID":"20240611105857-skch3l9","Type":"NodeParagraph","Properties":{"id":"20240611105857-skch3l9","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611105857-5f5tnhu","Type":"NodeParagraph","Properties":{"id":"20240611105857-5f5tnhu","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～3钱；或研末。"}]},{"ID":"20240611105857-ipyp77s","Type":"NodeParagraph","Properties":{"id":"20240611105857-ipyp77s","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611105857-9lglawp","Type":"NodeParagraph","Properties":{"id":"20240611105857-9lglawp","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" ①治眼雾不明及白翳：苋菜子、青葙子、蝉花，炖猪肝服。（《四川中药志》）"}]},{"ID":"20240611105857-7h82bs4","Type":"NodeParagraph","Properties":{"id":"20240611105857-7h82bs4","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"②治红崩：苋菜子、红鸡冠花、红绫子，炖肉服。（《四川中药志》）"}]},{"ID":"20240611105857-x75ihps","Type":"NodeParagraph","Properties":{"id":"20240611105857-x75ihps","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"③治大小便难：苋实末半两。分二服，以新汲水调下。（《圣惠方》）"}]},{"ID":"20240611105857-cu8q7b6","Type":"NodeParagraph","Properties":{"id":"20240611105857-cu8q7b6","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"④治乳糜血尿：红苋菜种子炒至炸花，研成细末。每服三钱，糖水送服，每日三次。服几次后，如小便仍混浊不清，可用委陵菜一两，水煎服。（徐州《单方验方新医疗法选编》）"}]},{"ID":"20240611105857-anxxcfs","Type":"NodeParagraph","Properties":{"id":"20240611105857-anxxcfs","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611105857-q2f0f6v","Type":"NodeParagraph","Properties":{"id":"20240611105857-q2f0f6v","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611105857-lhbr9em","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611105857-lhbr9em","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"《中华本草》：苋实"}]},{"ID":"20240611105857-t93xrv2","Type":"NodeParagraph","Properties":{"id":"20240611105857-t93xrv2","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611105857-dw2szjf","Type":"NodeParagraph","Properties":{"id":"20240611105857-dw2szjf","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" Xiàn Shí"}]},{"ID":"20240611105857-jzgmvnn","Type":"NodeParagraph","Properties":{"id":"20240611105857-jzgmvnn","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611105857-3f7k1m2","Type":"NodeParagraph","Properties":{"id":"20240611105857-3f7k1m2","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 莫实、苋子、苋菜子"}]},{"ID":"20240611105857-tdiqagr","Type":"NodeParagraph","Properties":{"id":"20240611105857-tdiqagr","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611105857-treqj76","Type":"NodeParagraph","Properties":{"id":"20240611105857-treqj76","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611105857-twhkbi1","Type":"NodeParagraph","Properties":{"id":"20240611105857-twhkbi1","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"陶弘景：苋实当是白苋，所以云细苋亦同，叶如蓝也。细苋即是糠苋，食之乃胜，而并冷利。被霜乃熟，故云十一月采。药方用苋实甚稀。"}]},{"ID":"20240611105857-32za75j","Type":"NodeParagraph","Properties":{"id":"20240611105857-32za75j","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611105857-nwr7pti","Type":"NodeParagraph","Properties":{"id":"20240611105857-nwr7pti","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 药材基源：为苋科植物苋种子。"}]},{"ID":"20240611105857-mfqishc","Type":"NodeParagraph","Properties":{"id":"20240611105857-mfqishc","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Amaranthus tricolor L.[Amaranthus man-gostanus L．； A． gangeticus L.」。"}]},{"ID":"20240611105857-37pz49c","Type":"NodeParagraph","Properties":{"id":"20240611105857-37pz49c","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收地上部分，晒后搓揉脱下种子，扬净，晒干。"}]},{"ID":"20240611105857-k4fsw1c","Type":"NodeParagraph","Properties":{"id":"20240611105857-k4fsw1c","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611105857-2bj6ehn","Type":"NodeParagraph","Properties":{"id":"20240611105857-2bj6ehn","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 全国各地均有栽培，有时逸为半野生。"}]},{"ID":"20240611105857-981e5x9","Type":"NodeParagraph","Properties":{"id":"20240611105857-981e5x9","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611105857-rz6jzmj","Type":"NodeParagraph","Properties":{"id":"20240611105857-rz6jzmj","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 一年生草本。茎直立，粗壮，绿色或红色，分枝较少，高80-150cm。叶互生；叶辆长3-10cm，绿色或红色；叶片卵形、菱状卵形或披针形，长4-12cm，宽3-7cm，绿色或常成红色、紫色或黄色，或部分绿色加杂其他颜色，钝头或微凹，基部广楔形，全缘或波状，无毛。花簇腋生，球形，花序在下部者呈球形，上都呈稍断续的穗状花序，花黄绿色，单性，雌雄同株；苞片及小苞片卵状披针形，先端芒状，长约4mm，膜质，透明；等片3，披针形，膜质，先端芒状；雄蕊3；雌蕊1，柱头3裂。胞果卵状长圆形，长于果实，熟时环状开裂，上半部成盖状脱落，包干宿存花被片内。种子黑褐色，近于扁圆形，两面凸，平滑有光泽，边缘钝。花期5-8月，果期7-9月。"}]},{"ID":"20240611105857-5bojf0j","Type":"NodeParagraph","Properties":{"id":"20240611105857-5bojf0j","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611105857-6tx6th0","Type":"NodeParagraph","Properties":{"id":"20240611105857-6tx6th0","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 种子近圆形或倒卵形，黑褐色，平滑，有光泽。气微，味淡。"}]},{"ID":"20240611105857-0jr9qzv","Type":"NodeParagraph","Properties":{"id":"20240611105857-0jr9qzv","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611105857-qr8pvhi","Type":"NodeParagraph","Properties":{"id":"20240611105857-qr8pvhi","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 肝；大肠；膀脱经"}]},{"ID":"20240611105857-ayt6p5k","Type":"NodeParagraph","Properties":{"id":"20240611105857-ayt6p5k","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611105857-4bttwr7","Type":"NodeParagraph","Properties":{"id":"20240611105857-4bttwr7","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 甘；性寒"}]},{"ID":"20240611105857-ozyzesm","Type":"NodeParagraph","Properties":{"id":"20240611105857-ozyzesm","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611105857-rbux7cu","Type":"NodeParagraph","Properties":{"id":"20240611105857-rbux7cu","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 清肝明目；通利二便。主青盲翳障；视物昏暗；白浊血尿；二便不"}]},{"ID":"20240611105857-3wph1fq","Type":"NodeParagraph","Properties":{"id":"20240611105857-3wph1fq","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611105857-b7gvgj8","Type":"NodeParagraph","Properties":{"id":"20240611105857-b7gvgj8","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6～9g;或研末。"}]},{"ID":"20240611105857-acu0klg","Type":"NodeParagraph","Properties":{"id":"20240611105857-acu0klg","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611105857-8v9aa2j","Type":"NodeParagraph","Properties":{"id":"20240611105857-8v9aa2j","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主青盲，明目，除邪，利大小便，去寒热。"}]},{"ID":"20240611105857-70bt55n","Type":"NodeParagraph","Properties":{"id":"20240611105857-70bt55n","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：主白翳，杀蛔虫。"}]},{"ID":"20240611105857-k2myf7t","Type":"NodeParagraph","Properties":{"id":"20240611105857-k2myf7t","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：益精。"}]},{"ID":"20240611105857-y90wt0a","Type":"NodeParagraph","Properties":{"id":"20240611105857-y90wt0a","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：主翳目黑花，肝风客热等。"}]},{"ID":"20240611105857-mza1f16","Type":"NodeParagraph","Properties":{"id":"20240611105857-mza1f16","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"5.《民间常用草药汇编》：治伤风咳嗽。"}]},{"ID":"20240611105857-2agh6hg","Type":"NodeParagraph","Properties":{"id":"20240611105857-2agh6hg","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"6.《本草纲目》：苋实与青葙子同类异种，故其治目之功，亦相仿佛也。"}]},{"ID":"20240611105857-k207keq","Type":"NodeParagraph","Properties":{"id":"20240611105857-k207keq","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611105857-393vrur","Type":"NodeParagraph","Properties":{"id":"20240611105857-393vrur","updated":"20240611105857"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611105858-vhsa149","Type":"NodeThematicBreak","Properties":{"id":"20240611105858-vhsa149"}},{"ID":"20240611110144-e7ajjf0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110144-e7ajjf0","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：苋"}]},{"ID":"20240611110144-4gdyoif","Type":"NodeParagraph","Properties":{"id":"20240611110144-4gdyoif","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611110144-o4rkn8u","Type":"NodeParagraph","Properties":{"id":"20240611110144-o4rkn8u","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" Xiàn"}]},{"ID":"20240611110144-zdhbf2y","Type":"NodeParagraph","Properties":{"id":"20240611110144-zdhbf2y","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611110144-erv1tm6","Type":"NodeParagraph","Properties":{"id":"20240611110144-erv1tm6","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 苋菜（李当之《药录》），青香苋（《湖南药物志》）。"}]},{"ID":"20240611110144-pssh3hf","Type":"NodeParagraph","Properties":{"id":"20240611110144-pssh3hf","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611110144-5cas6tx","Type":"NodeParagraph","Properties":{"id":"20240611110144-5cas6tx","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611110144-vo7a7em","Type":"NodeParagraph","Properties":{"id":"20240611110144-vo7a7em","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611110144-f3cj3sg","Type":"NodeParagraph","Properties":{"id":"20240611110144-f3cj3sg","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 为苋科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苋"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎叶"},{"Type":"NodeText","Data":"。春、夏采收。"}]},{"ID":"20240611110144-2whzgx4","Type":"NodeParagraph","Properties":{"id":"20240611110144-2whzgx4","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611110144-a3150e0","Type":"NodeParagraph","Properties":{"id":"20240611110144-a3150e0","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 各地均有栽植。"}]},{"ID":"20240611110144-nma02wv","Type":"NodeParagraph","Properties":{"id":"20240611110144-nma02wv","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611110144-9f0ddd3","Type":"NodeParagraph","Properties":{"id":"20240611110144-9f0ddd3","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 一年生草本，茎直立，分枝较少，枝绿色，高80～150厘米。叶互生；叶柄长3～10厘米；叶片菱状广卵形或三角状广卵形，长4～12厘米，宽3～7厘米，钝头或微凹，基部广楔形，叶有绿色、红色、暗紫色或带紫斑等。花序在下部者呈球形，上部呈稍断续的穗状花序，花黄绿色，单性，雌雄同株；苞片卵形，先端芒状，长约4毫米，膜质；萼片3，披针形，膜质，先端芒状，雄花有雄蕊3，雌花有雌蕊1，柱头3裂。胞果椭圆形，萼片宿存，长于果实，熟时环状开裂，上半部成盖状脱落。种子黑褐色，近于扁圆形，两面凸，平滑有光泽。花期5～7月。"}]},{"ID":"20240611110144-46o2wgp","Type":"NodeParagraph","Properties":{"id":"20240611110144-46o2wgp","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"本植物的根（苋根）、种子（苋实）亦供药用。各详专条。"}]},{"ID":"20240611110144-tyeivdx","Type":"NodeParagraph","Properties":{"id":"20240611110144-tyeivdx","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611110144-o4ckmri","Type":"NodeParagraph","Properties":{"id":"20240611110144-o4ckmri","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 叶含维生素C，嫩叶含99～121毫克％，较老叶含119～178毫克％。"}]},{"ID":"20240611110144-e588vl3","Type":"NodeParagraph","Properties":{"id":"20240611110144-e588vl3","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611110144-wzbqnka","Type":"NodeParagraph","Properties":{"id":"20240611110144-wzbqnka","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 甘，凉。"}]},{"ID":"20240611110144-n1lsdgs","Type":"NodeParagraph","Properties":{"id":"20240611110144-n1lsdgs","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"冷利。\""}]},{"ID":"20240611110144-nx34md0","Type":"NodeParagraph","Properties":{"id":"20240611110144-nx34md0","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"赤苋：辛，寒。\""}]},{"ID":"20240611110144-7wxbgw7","Type":"NodeParagraph","Properties":{"id":"20240611110144-7wxbgw7","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"③《日用本草》：\"甘，寒，无毒。\""}]},{"ID":"20240611110144-xh3u99b","Type":"NodeParagraph","Properties":{"id":"20240611110144-xh3u99b","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"④《饮膳正要》：\"味苦，寒，无毒。\""}]},{"ID":"20240611110144-mricazj","Type":"NodeParagraph","Properties":{"id":"20240611110144-mricazj","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611110144-8ywjote","Type":"NodeParagraph","Properties":{"id":"20240611110144-8ywjote","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 脾弱便溏者慎服。"}]},{"ID":"20240611110144-godfvrv","Type":"NodeParagraph","Properties":{"id":"20240611110144-godfvrv","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"①《本草求原》：\"脾弱易泻勿用。恶蕨粉。\""}]},{"ID":"20240611110144-5q89mdm","Type":"NodeParagraph","Properties":{"id":"20240611110144-5q89mdm","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"②《随息居饮食谱》：\"痧胀滑泻者忌之。\""}]},{"ID":"20240611110144-zotn7jc","Type":"NodeParagraph","Properties":{"id":"20240611110144-zotn7jc","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611110144-qcai0f9","Type":"NodeParagraph","Properties":{"id":"20240611110144-qcai0f9","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 清热，利窍。治赤白痢疾，二便不通。"}]},{"ID":"20240611110144-j21n75s","Type":"NodeParagraph","Properties":{"id":"20240611110144-j21n75s","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"①陶弘景：\"赤苋：能疗赤下。\""}]},{"ID":"20240611110144-x6sxxe3","Type":"NodeParagraph","Properties":{"id":"20240611110144-x6sxxe3","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"赤苋：主赤痢，又主射工沙虱。\""}]},{"ID":"20240611110144-790lo41","Type":"NodeParagraph","Properties":{"id":"20240611110144-790lo41","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"③孟诜：\"补气除热。\""}]},{"ID":"20240611110144-kjw1h22","Type":"NodeParagraph","Properties":{"id":"20240611110144-kjw1h22","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"紫苋：杀虫毒。\""}]},{"ID":"20240611110144-6twt35v","Type":"NodeParagraph","Properties":{"id":"20240611110144-6twt35v","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"通九窍。\""}]},{"ID":"20240611110144-qnvjkiz","Type":"NodeParagraph","Properties":{"id":"20240611110144-qnvjkiz","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"⑥《本草图经》：\"紫苋：主气痢。赤苋：主血痢。\""}]},{"ID":"20240611110144-us9fi2l","Type":"NodeParagraph","Properties":{"id":"20240611110144-us9fi2l","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"⑦《滇南本草》：\"治大小便不通，化虫去寒热，能通血脉，逐瘀血。\""}]},{"ID":"20240611110144-0x126w7","Type":"NodeParagraph","Properties":{"id":"20240611110144-0x126w7","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"⑧《纲目》：\"六苋，并利大小肠。治初痢，滑胎。\""}]},{"ID":"20240611110144-4ngjf5h","Type":"NodeParagraph","Properties":{"id":"20240611110144-4ngjf5h","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611110144-un71uk7","Type":"NodeParagraph","Properties":{"id":"20240611110144-un71uk7","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤、煮粥或捣汁。外用：煎水洗或捣敷。"}]},{"ID":"20240611110144-pipbgm1","Type":"NodeParagraph","Properties":{"id":"20240611110144-pipbgm1","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611110144-5tsf081","Type":"NodeParagraph","Properties":{"id":"20240611110144-5tsf081","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" ①治产前后赤白痢：紫苋叶（细锉）一握，粇米三合。上先以水煎苋叶，取汁去滓，下米煮粥，空心食之。（《寿亲养老新书》紫苋粥）"}]},{"ID":"20240611110144-rp5zl5v","Type":"NodeParagraph","Properties":{"id":"20240611110144-rp5zl5v","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"②治小儿紧唇：赤苋捣汁洗之。（《圣惠方》）"}]},{"ID":"20240611110144-ernzfyn","Type":"NodeParagraph","Properties":{"id":"20240611110144-ernzfyn","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"③治漆疮瘙痒：苋菜煎汤洗之。（《纲目》）"}]},{"ID":"20240611110144-x6vbwb1","Type":"NodeParagraph","Properties":{"id":"20240611110144-x6vbwb1","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611110144-86298qq","Type":"NodeParagraph","Properties":{"id":"20240611110144-86298qq","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611110144-nv146pd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611110144-nv146pd","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"《中华本草》：苋"}]},{"ID":"20240611110144-ykznz39","Type":"NodeParagraph","Properties":{"id":"20240611110144-ykznz39","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611110144-3xtpjvm","Type":"NodeParagraph","Properties":{"id":"20240611110144-3xtpjvm","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" Xiàn"}]},{"ID":"20240611110144-memcvcm","Type":"NodeParagraph","Properties":{"id":"20240611110144-memcvcm","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611110144-78q8tpb","Type":"NodeParagraph","Properties":{"id":"20240611110144-78q8tpb","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 苋菜、人苋、红人苋、雁来红、老少年、十样锦、老来少、三色苋、青香苋、老来变、秋红"}]},{"ID":"20240611110144-uwu0onh","Type":"NodeParagraph","Properties":{"id":"20240611110144-uwu0onh","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611110144-usllybt","Type":"NodeParagraph","Properties":{"id":"20240611110144-usllybt","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240611110144-i0tesq6","Type":"NodeParagraph","Properties":{"id":"20240611110144-i0tesq6","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"1.《蜀本草》：《图经》说有赤苋、白苋、人苋、马苋、紫苋、五色苋，凡六种，惟人、白二苋实入药用，按人苋小，白苋大，马苋如马齿，赤苋味辛，俱别有功，紫及五色二苋不入药。"}]},{"ID":"20240611110144-19zbfxq","Type":"NodeParagraph","Properties":{"id":"20240611110144-19zbfxq","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：人、白二苋，亦谓之糠苋，亦谓之胡苋，亦谓之细苋，其实一也，但人苋小而白苋大耳。霜后方熟，实细而黑。紫苋茎叶通紫，吴人用染菜瓜(一作染爪)者。诸苋中此无毒。赤苋，亦谓之花苋，茎叶深赤"}]},{"ID":"20240611110144-mth9d5h","Type":"NodeParagraph","Properties":{"id":"20240611110144-mth9d5h","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611110144-as6ebn0","Type":"NodeParagraph","Properties":{"id":"20240611110144-as6ebn0","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 药材基源：为苋科植物苋的茎叶。"}]},{"ID":"20240611110144-6yxjx8k","Type":"NodeParagraph","Properties":{"id":"20240611110144-6yxjx8k","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Amaranthus tricolor L.[Amaranthus man-gostanus L．； A． gangeticus L.」。"}]},{"ID":"20240611110144-zrxf4hf","Type":"NodeParagraph","Properties":{"id":"20240611110144-zrxf4hf","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、夏季采收，洗净，鲜用或晒干。"}]},{"ID":"20240611110144-ee37rwo","Type":"NodeParagraph","Properties":{"id":"20240611110144-ee37rwo","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611110144-3l3tmd5","Type":"NodeParagraph","Properties":{"id":"20240611110144-3l3tmd5","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 全国各地均有栽培，有时逸为半野生。"}]},{"ID":"20240611110144-1q6un6i","Type":"NodeParagraph","Properties":{"id":"20240611110144-1q6un6i","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611110144-8071p9n","Type":"NodeParagraph","Properties":{"id":"20240611110144-8071p9n","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 一年生草本。茎直立，粗壮，绿色或红色，分枝较少，高80-150cm。叶互生；叶辆长3-10cm，绿色或红色；叶片卵形、菱状卵形或披针形，长4-12cm，宽3-7cm，绿色或常成红色、紫色或黄色，或部分绿色加杂其他颜色，钝头或微凹，基部广楔形，全缘或波状，无毛。花簇腋生，球形，花序在下部者呈球形，上都呈稍断续的穗状花序，花黄绿色，单性，雌雄同株；苞片及小苞片卵状披针形，先端芒状，长约4mm，膜质，透明；等片3，披针形，膜质，先端芒状；雄蕊3；雌蕊1，柱头3裂。胞果卵状长圆形，长于果实，熟时环状开裂，上半部成盖状脱落，包干宿存花被片内。种子黑褐色，近于扁圆形，两面凸，平滑有光泽，边缘钝。花期5-8月，果期7-9月。"}]},{"ID":"20240611110144-34z51k7","Type":"NodeParagraph","Properties":{"id":"20240611110144-34z51k7","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611110144-291pof2","Type":"NodeParagraph","Properties":{"id":"20240611110144-291pof2","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜高温、强光，要求短日照。对土壤要求不严，耐碱、耐旱。"}]},{"ID":"20240611110144-8dted02","Type":"NodeParagraph","Properties":{"id":"20240611110144-8dted02","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖。春季播种，种子发芽最适宜温度为21-22℃，苗高10～15cm时定植，择阴天或傍晚进行，株、行距40～50cm。"}]},{"ID":"20240611110144-ajq8ewt","Type":"NodeParagraph","Properties":{"id":"20240611110144-ajq8ewt","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611110144-fbmyz2b","Type":"NodeParagraph","Properties":{"id":"20240611110144-fbmyz2b","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 茎长80-150cm，绿色或红色，常分枝。叶互生，叶片皱缩，展平后呈菱状卵形至披针形，长4-10cm，宽2-7cm，先端钝或尖凹，具凸尖，绿色或红色、紫色、黄色，或绿色带有彩斑；叶柄长2-6cm。穗状花序。胞果卵状矩圆形，盖裂。气微，味淡。"}]},{"ID":"20240611110144-np65w8u","Type":"NodeParagraph","Properties":{"id":"20240611110144-np65w8u","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611110144-2lvlxc4","Type":"NodeParagraph","Properties":{"id":"20240611110144-2lvlxc4","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 茎含亚油酸（linoleic acid）为主要成分的不饱和脂肪酸及棕榈酸（palmitic acid）[1]。叶中有苋菜红甙（amaran－thin)[2],棕榈酸，亚麻酸（linolenic acid），二十四烷酸（lignocericacid），花生酸（arachic acid），菠菜甾醇（spinasterol)[1]，单半乳糖基甘油二酯（monogalactosyldiglyceride），二半乳糖基甘油二酯（digalactosyldiglyceride），三半乳糖基甘油二酯（trigalacto-syldiglyceride），三酰甘油（triglycerides），甾醇（sterols），游离脂肪酸（free fatty acid）[3]，维生素（vitamin）A、C、B和核黄素（ri-boflavine）[4]。地上部分含正烷烃（n－alkanes），正烷醇（n－alka－nols）和甾醇类（sterols）等[5]。全草挥发油分析存在56个化学成分，包括15个醇（alchols），5个酯（esters），13个醛（aldehydes），8个酮（ketones），3个碳氢化合物（hydrocarbons），9个酸（acids）和5个其他成分[6]。"}]},{"ID":"20240611110144-jo4w5hc","Type":"NodeParagraph","Properties":{"id":"20240611110144-jo4w5hc","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611110144-k5y1tc3","Type":"NodeParagraph","Properties":{"id":"20240611110144-k5y1tc3","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 本品石油醚提取物中的正烷烃类、正烷醇类、16-三十一烷酮、甾醇类对金黄色葡萄球菌、白色葡萄球菌、草绿色链球菌（皆为革兰阳性菌）、大肠杆菌、绿脓假单胞菌和克雷白杆菌（皆为革兰阴性菌）有较强的抗菌作用。其中，16-三十一烷酮及甾醇类的抗菌作用强于正烷烃类[1，2]。"}]},{"ID":"20240611110144-ucl1d20","Type":"NodeParagraph","Properties":{"id":"20240611110144-ucl1d20","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611110144-ck6kxvu","Type":"NodeParagraph","Properties":{"id":"20240611110144-ck6kxvu","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 大肠；小肠经"}]},{"ID":"20240611110144-vrb5pif","Type":"NodeParagraph","Properties":{"id":"20240611110144-vrb5pif","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611110144-nlfhmyu","Type":"NodeParagraph","Properties":{"id":"20240611110144-nlfhmyu","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 甘；性微寒"}]},{"ID":"20240611110144-z92h7k7","Type":"NodeParagraph","Properties":{"id":"20240611110144-z92h7k7","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611110144-uln9btx","Type":"NodeParagraph","Properties":{"id":"20240611110144-uln9btx","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 1.脾弱便溏者慎服。"}]},{"ID":"20240611110144-mwkkrwl","Type":"NodeParagraph","Properties":{"id":"20240611110144-mwkkrwl","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"2.《本草求原》：脾弱易泻勿用。恶蕨粉。"}]},{"ID":"20240611110144-r9sy0v2","Type":"NodeParagraph","Properties":{"id":"20240611110144-r9sy0v2","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"3.《随息居饮食谱》：痧胀滑泻者忌之。"}]},{"ID":"20240611110144-zp6yvvb","Type":"NodeParagraph","Properties":{"id":"20240611110144-zp6yvvb","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611110144-2l9isuf","Type":"NodeParagraph","Properties":{"id":"20240611110144-2l9isuf","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 清热解毒；通利二便。主痢疾；二便不通；蛇虫螫伤；疮毒"}]},{"ID":"20240611110144-cce122t","Type":"NodeParagraph","Properties":{"id":"20240611110144-cce122t","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611110144-yik6yia","Type":"NodeParagraph","Properties":{"id":"20240611110144-yik6yia","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤30-60g;或煮粥。外用：适量，捣敷或煎液熏洗。"}]},{"ID":"20240611110144-th2i5ur","Type":"NodeParagraph","Properties":{"id":"20240611110144-th2i5ur","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611110144-i5t2ac7","Type":"NodeParagraph","Properties":{"id":"20240611110144-i5t2ac7","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 1.陶弘景：赤苋：能疗赤下。"}]},{"ID":"20240611110144-e0ztn87","Type":"NodeParagraph","Properties":{"id":"20240611110144-e0ztn87","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：赤苋：主赤痢，又主射工沙虱。"}]},{"ID":"20240611110144-5nxtsx0","Type":"NodeParagraph","Properties":{"id":"20240611110144-5nxtsx0","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"3.孟诜：补气除热。"}]},{"ID":"20240611110144-44b2phk","Type":"NodeParagraph","Properties":{"id":"20240611110144-44b2phk","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"4.《本草拾遗》：紫苋：杀虫毒。"}]},{"ID":"20240611110144-oi0ukzh","Type":"NodeParagraph","Properties":{"id":"20240611110144-oi0ukzh","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"5.《日华子本草》：通九窍。"}]},{"ID":"20240611110144-x1po91c","Type":"NodeParagraph","Properties":{"id":"20240611110144-x1po91c","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"6.《本草图经》：紫苋：主气痢。赤苋：主血痢。"}]},{"ID":"20240611110144-s3f0jhc","Type":"NodeParagraph","Properties":{"id":"20240611110144-s3f0jhc","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"7.《滇南本草》：治大小便不通，化虫去寒热，能通血脉，逐瘀血。"}]},{"ID":"20240611110144-q2f7gvo","Type":"NodeParagraph","Properties":{"id":"20240611110144-q2f7gvo","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"8.《本草纲目》：六苋，并利大小肠。治初痢，滑胎。"}]},{"ID":"20240611110144-21jncc8","Type":"NodeParagraph","Properties":{"id":"20240611110144-21jncc8","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"9.《本草衍义补遗》：苋，下血而又入血分，且善走，与马齿苋同服下胎，妙，临产时者食，易产。"}]},{"ID":"20240611110144-lhbwjg0","Type":"NodeParagraph","Properties":{"id":"20240611110144-lhbwjg0","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611110144-rq2xy8u","Type":"NodeParagraph","Properties":{"id":"20240611110144-rq2xy8u","updated":"20240611110144"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611110145-j3j8a8d","Type":"NodeThematicBreak","Properties":{"id":"20240611110145-j3j8a8d"}},{"ID":"20240611110146-vki0zwe","Type":"NodeParagraph","Properties":{"id":"20240611110146-vki0zwe"}}]}