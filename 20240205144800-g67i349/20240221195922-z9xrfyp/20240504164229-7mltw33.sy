":"span","Properties":{"parent-style":"width: 740px;","style":"width: 730px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"橘子树 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/橘子树 1-20240715154140-cgs4yy1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 730px;\" parent-style=\"width: 740px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"橘子树 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/橘子树 2-20240715154216-q45d77s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240903091138-tmluy7f","Type":"NodeParagraph","Properties":{"id":"20240903091138-tmluy7f","updated":"20240903091138"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 740px;","style":"width: 730px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"橘树"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/橘树-20240621084745-3aanbe8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 730px;\" parent-style=\"width: 740px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621084756-biodigo","Type":"NodeParagraph","Properties":{"id":"20240621084756-biodigo","updated":"20240715154449"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：陈皮即为成熟的橘子皮陈放而成，放置越久药效越显著。"}]},{"ID":"20240715154848-5amb5lc","Type":"NodeParagraph","Properties":{"id":"20240715154848-5amb5lc","updated":"20240903091219"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：还有一种青皮，是由未成熟的橘子皮晒干制成；点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205153732-ykkw2re","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"青皮"}]},{"ID":"20240607161754-zk13u5r","Type":"NodeThematicBreak","Properties":{"id":"20240607161754-zk13u5r"}},{"ID":"20240607161759-tama2e4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161759-tama2e4","updated":"20240607161805"},"Children":[{"Type":"NodeText","Data":"橘柚《神农本草经》"}]},{"ID":"20240607161759-tg256cp","Type":"NodeParagraph","Properties":{"id":"20240607161759-tg256cp","updated":"20240607161759"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240607161759-jmlqyvu","Type":"NodeParagraph","Properties":{"id":"20240607161759-jmlqyvu","updated":"20240607161759"},"Children":[{"Type":"NodeText","Data":"主胸中瘕热逆气，利水谷。久服，去臭下气通神，一名橘皮。生川谷。（旧在果部，非）"}]},{"ID":"20240607161759-fc9p10e","Type":"NodeParagraph","Properties":{"id":"20240607161759-fc9p10e","updated":"20240607161759"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生南山，江南，十月采。"}]},{"ID":"20240607161759-0hcirkz","Type":"NodeParagraph","Properties":{"id":"20240607161759-0hcirkz","updated":"20240607161759"},"Children":[{"Type":"NodeText","Data":"案《说文》云：橘果出江南，柚条也。似橙而酢。《尔雅》云：柚条。郭璞云：似橙实酢，生江南。禹贡云：厥包橘柚。伪孔云：大曰橘，小曰柚。列子汤问篇云：吴楚之国有木焉，其名为，碧树而冬生，实丹而"}]},{"ID":"20240607161759-lk14cmd","Type":"NodeParagraph","Properties":{"id":"20240607161759-lk14cmd","updated":"20240607161759"},"Children":[{"Type":"NodeText","Data":"味酸，食其皮汁，已愤厥之疾，《司马相如赋》，有橘柚。张揖曰：柚，即橙也。似橘而大，味酢皮厚。"}]},{"ID":"20240607161759-kpyc0u8","Type":"NodeParagraph","Properties":{"id":"20240607161759-kpyc0u8","updated":"20240607161759"},"Children":[{"Type":"NodeText","Data":"上木，上品二十种，旧一十九种，考果部，橘柚当入此。"}]},{"ID":"20240607162058-dhm2lhz","Type":"NodeThematicBreak","Properties":{"id":"20240607162058-dhm2lhz"}},{"ID":"20240607162059-vuvmv5y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607162059-vuvmv5y","updated":"20240607162105"},"Children":[{"Type":"NodeText","Data":"橘柚《神农本草经赞》"}]},{"ID":"20240607162059-opsft3e","Type":"NodeParagraph","Properties":{"id":"20240607162059-opsft3e","updated":"20240607162059"},"Children":[{"Type":"NodeText","Data":"味辛温。主胸中瘕热。逆气。利水谷。久服去臭下气。通神。一名橘皮。生山谷。"}]},{"ID":"20240607162059-m0511sp","Type":"NodeParagraph","Properties":{"id":"20240607162059-m0511sp","updated":"20240607162059"},"Children":[{"Type":"NodeText","Data":"识小识大。相保岁寒。珠胎郁。镭斗霜攒。贞心荣丽。仁崽甘酸。璇枢散采。云梦翘观。"}]},{"ID":"20240607162059-00k7maa","Type":"NodeParagraph","Properties":{"id":"20240607162059-00k7maa","updated":"20240607162059"},"Children":[{"Type":"NodeText","Data":"书传。小曰橘。大曰柚。论语。贤者识其大者。不贤者识其小者。白居易诗。应能保岁寒。"}]},{"ID":"20240607162059-nakgidx","Type":"NodeParagraph","Properties":{"id":"20240607162059-nakgidx","updated":"20240607162059"},"Children":[{"Type":"NodeText","Data":"刘克庄诗。淡月珠胎明璀璨。李时珍曰。橘从。内赤外黄。香雾纷郁。有似乎云。广州记。镭柚实大如斗。方回诗。满颐霜雪攒。李绅诗。不随寒暑换贞心。虞羲诗。荣丽在中州。"}]},{"ID":"20240607162059-gleib8r","Type":"NodeParagraph","Properties":{"id":"20240607162059-gleib8r","updated":"20240607162059"},"Children":[{"Type":"NodeText","Data":"群芳谱。名仁崽者。柚类也。黄庭坚诗。如食橘柚知甘酸。春秋运斗枢。璇枢星散为橘。吕氏春秋。果之美者。有云梦之柚。"}]},{"ID":"20240617112114-elsz8zn","Type":"NodeThematicBreak","Properties":{"id":"20240617112114-elsz8zn"}},{"ID":"20240617112115-pqluujq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112115-pqluujq","updated":"20240617112119"},"Children":[{"Type":"NodeText","Data":"橘柚《名医别录》"}]},{"ID":"20240617112115-g5bo41c","Type":"NodeParagraph","Properties":{"id":"20240617112115-g5bo41c","updated":"20240617112115"},"Children":[{"Type":"NodeText","Data":"无毒．主下气，止呕咳，除膀胱留热，下停水，五淋，利小便，治脾不能消谷，气冲胸中，吐逆，霍乱，止泄，去寸白．久服轻身长年．生南山，生江南．十月采．"}]},{"ID":"20240617112115-3hlkfzp","Type":"NodeParagraph","Properties":{"id":"20240617112115-3hlkfzp","updated":"20240617112123"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶橘柚，味辛，温．主胸中瘕热逆气，利水谷．久服去臭，下气通神．一名橘皮。生川谷。"}]},{"ID":"20240617111853-24mt1nv","Type":"NodeThematicBreak","Properties":{"id":"20240617111853-24mt1nv"}},{"ID":"20240617111854-8b8i3nx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111854-8b8i3nx","updated":"20240617111900"},"Children":[{"Type":"NodeText","Data":"橘柚《新修本草》"}]},{"ID":"20240617111854-ti9gjo5","Type":"NodeParagraph","Properties":{"id":"20240617111854-ti9gjo5","updated":"20240617111854"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主胸中瘕热逆气，利水谷，下气，止呕咳，除膀胱留热，下停水，五淋，利小便，主脾不能消谷，气冲胸中吐逆，霍乱，止泄，去寸白。久服去臭，下气通神，轻身长年。一名橘皮。生南山川谷，生江南，十月采。"}]},{"ID":"20240617111854-ihjzlm4","Type":"NodeParagraph","Properties":{"id":"20240617111854-ihjzlm4","updated":"20240617111854"},"Children":[{"Type":"NodeText","Data":"此是说其皮功耳，以东橘为好，西江亦有而不如。其皮小冷，疗气乃言欲胜东橘，北人亦用之。以陈者为良。其肉味甘、酸，食之多痰，恐非益人也。今此虽用皮，既是果类，所以犹宜相从。柚子皮乃可食，而不复入药用，此亦应下气。"}]},{"ID":"20240617111854-9k4x8cc","Type":"NodeParagraph","Properties":{"id":"20240617111854-9k4x8cc","updated":"20240617111854"},"Children":[{"Type":"NodeText","Data":"〔谨案〕柚皮浓，味甘，不如橘皮味辛而苦，其肉亦如橘，有甘有酸，酸者名胡甘。"}]},{"ID":"20240617111854-m2bslk0","Type":"NodeParagraph","Properties":{"id":"20240617111854-m2bslk0","updated":"20240617111854"},"Children":[{"Type":"NodeText","Data":"今俗人或谓橙为柚，非也。"}]},{"ID":"20240617111854-rlwyngm","Type":"NodeParagraph","Properties":{"id":"20240617111854-rlwyngm","updated":"20240617111947"},"Children":[{"Type":"NodeText","Data":"案《吕氏春秋》云∶“果之美者。有云梦之柚。”郭璞曰∶“柚似橙而大于橘。”孔安国云∶“小曰橘，大曰柚。"}]},{"ID":"20240607162133-g7b4sca","Type":"NodeThematicBreak","Properties":{"id":"20240607162133-g7b4sca"}},{"ID":"20240607161847-byu9p09","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161847-byu9p09","updated":"20240607161853"},"Children":[{"Type":"NodeText","Data":"橘柚《本草衍义》"}]},{"ID":"20240607161847-ysqkote","Type":"NodeParagraph","Properties":{"id":"20240607161847-ysqkote","updated":"20240607161847"},"Children":[{"Type":"NodeText","Data":"自是两种，故曰一名橘皮，是元无柚字也。岂有两等之物，而治疗无一字别者，即知柚字为误。后人不深求其意，为柚字所惑，妄生分别，亦以过矣。且青橘与黄橘，治疗尚别，矧柚为别种也。郭璞云∶柚似橙而大于橘”，此即是识橘柚者也。今若不如此言之，恐后世亦以柚皮为橘皮，是贻无穷之患矣。去古既远，后之贤者，亦可以意逆之耳。橘惟用皮与核。皮，天下甚所须也。仍汤浸去穣。余如经与《注》。核、皮二者须自收为佳。有人患气嗽将期，或教以橘皮、生姜焙干、神曲等分为末，丸桐子大，食后、夜卧，米饮服三五十丸。兼旧患膀胱，缘服此偕愈。然亦取其陈皮入药，此六陈中一陈也。肾疰腰痛、膀胱气痛，微炒核，去壳为末，酒调服，愈。"}]},{"ID":"20240607161847-59nc0be","Type":"NodeThematicBreak","Properties":{"id":"20240607161847-59nc0be"}},{"ID":"20240607161829-amol5pa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161829-amol5pa","updated":"20240607161835"},"Children":[{"Type":"NodeText","Data":"橘柚《本草乘雅半偈》"}]},{"ID":"20240607161829-4ru0v7i","Type":"NodeParagraph","Properties":{"id":"20240607161829-4ru0v7i","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"（本经上品）"}]},{"ID":"20240607161829-gef6b6q","Type":"NodeParagraph","Properties":{"id":"20240607161829-gef6b6q","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"【气味】辛温平，无毒。"}]},{"ID":"20240607161829-pwphi30","Type":"NodeParagraph","Properties":{"id":"20240607161829-pwphi30","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"【主治】主胸中瘕热逆气，利水谷。久服去臭，下气，通神。"}]},{"ID":"20240607161829-arlsaj8","Type":"NodeParagraph","Properties":{"id":"20240607161829-arlsaj8","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"【核】曰∶橘柚生江南，及山南山谷，今以广中者称胜。素华丹实，皮既馨香，又有善味，尤生于洞庭之包山。过江北则无，故曰江南种橘，江北为枳函。考工记云∶逾淮而北为枳，则有异同矣。橘颂云∶后皇嘉树，橘徕服兮，受命不迁，生南国兮。屈原比之夷齐，愿置以为像，取其贞介似有志也。春秋运斗枢云∶璇星散为橘，弓人以橘为干也。柚似橘而大，其味尤酸。孔安国云∶小曰橘，大曰柚。郭璞云∶柚似橙而大于橘，禹贡扬州，厥包橘柚锡贡。橘柚，皆不耐寒，故包裹而致之也。锡贡者，须锡命而献之，言不尝来也。列子云∶吴楚之国，有大木焉，其名为 ，碧木而冬生，实丹而味酸，食其皮汁，已愤厥之疾，齐州珍之，渡淮而北，化为枳焉，则是其类矣。子虚赋云∶橘柚芬芳。蜀都赋云∶家有盐井之泉，户有橘柚之园。广志云∶成都有柚，大如斗。吕氏春秋云∶果之美者，江浦之橘，云梦之柚。"}]},{"ID":"20240607161829-8u10x0q","Type":"NodeParagraph","Properties":{"id":"20240607161829-8u10x0q","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"然则橘柚，类虽同而种则异。本经合称之，功力无优劣矣。考古方书，用橘不用柚，今遵本经橘柚并用为正。修事橘柚，各去白膜锉细，鲤鱼皮裹一宿，至明取用。"}]},{"ID":"20240607161829-oyqzrd2","Type":"NodeParagraph","Properties":{"id":"20240607161829-oyqzrd2","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"先人云∶橘柚通呼，以本经命名为正。类有橙柑 枳之异；树有高下小大，有刺无刺，有刻、无刻之别；实有圆扁长锐，大小光累之殊。大都色象深绿，凌冬不雕则一也。实皮布窍，色深于皮，皮里有膜，囊上有脉，囊中裹瓤，瓤内裹汁以养核也。种类虽多，但以皮肉气味，互为分析。橘皮苦不可食，肉甘可食。橙皮甘可食，肉酸不可食。柑皮肉酸甘皆可食。"}]},{"ID":"20240607161829-lmzni02","Type":"NodeParagraph","Properties":{"id":"20240607161829-lmzni02","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"枳皮肉皆不可食。柚则形长，皮肉与橘同味矣。大段橘之美者皆接生，子种者不结实；纵结实，亦形长而味不美。今人指此为柚子，此则橘柚合称之本义。柚子不用接生，亦取本有色味，不从人力为也。广中柚子极大可食，永嘉呼之为苞，此又似 ，名虽同柚，种则异矣。"}]},{"ID":"20240607161829-if4idxo","Type":"NodeParagraph","Properties":{"id":"20240607161829-if4idxo","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"韩彦直有橘谱，列十有四种，以温州者称上品。近衢州航埠，沿溪三十里，夹岸树橘，花朝香雪弥空，果熟金星缀碧，种有巨细，色有红赭，约二十余种。唯 橘最美，武林栖水出蜜橘，凡数十品，名金钱穿心者，虽秀色可观，又不如佛肚脐，形小皮癞，甘美可口也。霜降采取，气足味足；密藏至春，剖皮抽脉，破囊吮汁，亦可振精醒神。为得句破疑之助，若欲择皮，用充药饵，不若广中者，皮薄而香，愈陈则愈善也。"}]},{"ID":"20240607161829-lkgvwk7","Type":"NodeParagraph","Properties":{"id":"20240607161829-lkgvwk7","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"又云∶橘从 。 者，锥有所穿，满有所出，兼已出未出义。 云二色，黄赤郁纷，从取象者以此。专胜在皮，虽年深日久，不但芳辛不改，转更清烈，他果万不能及。此以木实之皮，秋成得辛，禀从革作金之用，故可存可久。诚肝藏之用分气分药也。盖人水谷入胃，具升出降入之妙，而游溢精气，先及皮毛，转输五脏，此正水谷变现春夏秋冬耳。合 之已出未出，如穿如满之象，真不待言语形容矣。经云∶上焦开发，宣五谷味，熏肤充身泽毛，若雾露之溉，橘皮有焉。再读本经，及诸家法，乃知橘义真实不虚。客曰∶陈皮留白补肾和中；去白消痰泄气。从古所称，奉为律令，今以 义合之，似觉未当。曰∶此正证明八字义耳。果能达 义而用之，的是橘皮四法。不知此义而用之，宁不溷他药之四法乎。若果可混，性便移易，必非本有之真性矣。"}]},{"ID":"20240607161829-8ho3ena","Type":"NodeParagraph","Properties":{"id":"20240607161829-8ho3ena","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"（水谷入胃，具升出降入之妙。即东垣得悟法门，从此纵横应变，莫不繇此贯通。可见读书不贵博，只要实悟得古人一言一字，便终身受用无穷。）"}]},{"ID":"20240607161829-3rdlkte","Type":"NodeParagraph","Properties":{"id":"20240607161829-3rdlkte","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"【 】曰∶木命在皮，各有专精。以具全木之体，橘柚专精者实；实复专精者皮；皮布细窍，宛如人肤，即脉络肉理，筋膜子核，各有属焉。橘谐 ，与 同。云间五色曰庆，三色曰 。橘间青黄丹色之如 也。 者锥有所穿，取象肤间窍也；及满有所出，取象气中机也。柚谐由，与由同。书云∶若颠木之有由 。徐云∶已到之木，更生孙枝，象枝条华菡之形也。经云∶垂枝布叶，皆下曲如钩。又云∶夏日在肤，泛泛乎万物之有余也，故橘柚力能转入为升，转升为出，即转阖为开也。种种形证，悉从人从阖，致胸中瘕热，水谷失宣，神明不通，气逆及气臭耳。下气者，出已而降，玉衡机转之妙用也。经云∶秋日下肤，蛰虫将去，其斯之谓欤。"}]},{"ID":"20240607161829-3c4sgvd","Type":"NodeParagraph","Properties":{"id":"20240607161829-3c4sgvd","updated":"20240607161829"},"Children":[{"Type":"NodeText","Data":"（夏日在肤，泛泛乎万物之有余；秋日下肤，蛰虫将去，即转入为升，转升为出，转出为降之气中机也。）"}]},{"ID":"20240607161807-r7muzm1","Type":"NodeThematicBreak","Properties":{"id":"20240607161807-r7muzm1"}},{"ID":"20240607161812-vfwyhqx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161812-vfwyhqx","updated":"20240607161818"},"Children":[{"Type":"NodeText","Data":"橘柚《神农本草经百种录》"}]},{"ID":"20240607161812-3lhx1zi","Type":"NodeParagraph","Properties":{"id":"20240607161812-3lhx1zi","updated":"20240607161812"},"Children":[{"Type":"NodeText","Data":"味辛温。主胸中瘕热逆气，开达上焦之气。利水谷。通利中焦之滞。久服，去臭，下气，通神。芳香辛烈，自能辟秽邪而通正气也。"}]},{"ID":"20240607161812-v5cevt6","Type":"NodeParagraph","Properties":{"id":"20240607161812-v5cevt6","updated":"20240607161812"},"Children":[{"Type":"NodeText","Data":"橘柚通体皆香，而皮辛肉酸，乃肝脾通气之药也。故凡肝气不舒，克贼脾土之疾，皆能已之凡辛香之药皆上升，橘柚实酸，酸主敛，故又能降气，不专于散气也。"}]},{"ID":"20240607152407-1yszeg9","Type":"NodeThematicBreak","Properties":{"id":"20240607152407-1yszeg9"}},{"ID":"20240607161744-kl36v3m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161744-kl36v3m","updated":"20240607161752"},"Children":[{"Type":"NodeText","Data":"橘柚《千金翼方》"}]},{"ID":"20240607161744-zc9gusc","Type":"NodeParagraph","Properties":{"id":"20240607161744-zc9gusc","updated":"20240607161744"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主胸中瘕热逆气，利水谷，下气，止呕咳，除膀胱留热，停水利小便。主脾不能消谷，气充胸中，吐逆霍乱，止泻，去寸白。久服之，去臭气，通神明长年。一名橘皮。生于南山川谷及生江南，十月采。"}]},{"ID":"20240617111659-l8fqjzx","Type":"NodeThematicBreak","Properties":{"id":"20240617111659-l8fqjzx"}},{"ID":"20240617111700-gmp5tnh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111700-gmp5tnh","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"桔柚《证类本草》"}]},{"ID":"20240617111700-52d5wjx","Type":"NodeParagraph","Properties":{"id":"20240617111700-52d5wjx","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主胸中瘕热逆气，利水谷，下气，止呕咳，除膀胱留热，停水，五淋，利小便，主脾不能消谷，气冲胸中，吐逆，霍乱，止泄，去寸白。久服去臭，下气通神，轻身长年。一名桔皮。生南山川谷，生江南。十月采。"}]},{"ID":"20240617111700-ioz3d5y","Type":"NodeParagraph","Properties":{"id":"20240617111700-ioz3d5y","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此是说其皮功尔。以东桔为好，西江亦有而不如。其皮小冷，疗气，乃言胜桔。"}]},{"ID":"20240617111700-14m9in0","Type":"NodeParagraph","Properties":{"id":"20240617111700-14m9in0","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"北人亦用之，并以陈者为良。其肉，味甘、酸，食之多痰，恐非益也。今此虽用皮，既是果类，所以犹宜相从。柚子皮乃可服，而不复入药。用此应亦下气。唐本注云∶柚皮浓，味甘，不如桔皮味辛而苦。其肉亦如桔，有甘有酸，酸者名胡甘。今俗人或谓橙为柚，非也。按《吕氏春秋》云∶果之美者，有云梦之柚。郭璞云∶柚似橙，而大于桔。孔安国云∶小曰桔，大曰柚，皆为甘也。今注自木部今移。臣禹锡等谨按药性论云∶桔皮，臣，味苦、辛。"}]},{"ID":"20240617111700-1y77y97","Type":"NodeParagraph","Properties":{"id":"20240617111700-1y77y97","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"能治胸膈间气，开胃，主气痢，消痰涎，治上气咳嗽。陈藏器云∶桔、柚本功外，中实冷。"}]},{"ID":"20240617111700-bdo25jl","Type":"NodeParagraph","Properties":{"id":"20240617111700-bdo25jl","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"酸者聚痰，甜者润肺。皮堪入药，子非宜人。其类有朱柑、乳柑、黄柑、石柑、沙柑。桔类有朱桔、乳桔、塌桔、山桔、黄淡子。此辈皮皆去气调中，实总堪食。就中以乳柑为上。《本经》合入果部，宜加实字，入木部非也。岭南有柚，大如冬瓜。孟诜云∶桔，止泄痢。食之下食，开胸膈痰实结气。下气不如皮。穣不可多食，止气。性虽温，止渴。又，干皮一斤，捣为末，蜜为丸。每食前酒下三十丸，治下焦冷气。又，取陈皮一斤，和杏仁五两，去皮、尖熬，加少蜜为丸。每日食前饮下三十丸，下腹脏间虚冷气。香港脚冲心，心下结硬，悉主之。日华子云∶桔，味甘、酸。止消渴，开胃，除胸中隔气。又云皮，暖，消痰止嗽，破症瘕癖。又云核，治腰痛，膀胱气，肾冷，炒去壳，酒服，良。桔囊上筋膜，治渴及吐酒。炒，煎汤饮，甚验也。又云柚子，无毒。治妊孕人吃食少并口淡，去胃中恶气，消食，去肠胃气。解酒毒，治饮酒人口气。"}]},{"ID":"20240617111700-bov7ame","Type":"NodeParagraph","Properties":{"id":"20240617111700-bov7ame","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"图经曰∶桔、柚，生南山川谷及江南，今江浙、荆襄、湖岭皆有之。木高一、二丈，叶与枳无辨，刺出于茎间。夏初生白花，六月、七月而成实，至冬而黄熟，乃可啖。旧说小者为桔，大者为柚。又云∶柚似橙而实酢，大于桔。孔安国注《尚书》∶厥包桔柚。郭璞注《尔雅》柚条皆如此说。又闽中、岭外、江南皆有柚，比桔黄白色而大；襄、唐间柚，色青黄而实小。皆味酢，皮浓，不堪入药。今医方∶乃用黄桔、青桔两物，不言柚。岂青桔是柚之类乎？"}]},{"ID":"20240617111700-jquz8ap","Type":"NodeParagraph","Properties":{"id":"20240617111700-jquz8ap","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"然黄桔味辛，青桔味苦。《本经》二物通云味辛。又云一名桔皮。又云十月采，都是今黄桔也。而今之青桔似黄桔而小，与旧说大小、苦辛不类，则别是一种耳。收之并去肉，曝干。黄桔以陈久者入药良，古今方∶书用之最多。亦有单服者，取陈皮捣末，蜜和丸，食前酒吞三十丸，梧子大，主下焦积冷。亦可并杏子仁合丸，治肠间虚冷，香港脚冲心，心下结硬者，悉主之。而青桔主气滞，下食，破积结及膈气方∶用之，与黄桔全别。凡桔核皆治腰及膀胱肾气，炒去皮，酒服之良。肉不宜多食，令人痰滞。又乳柑、橙子性皆冷，并其类也，多食亦不宜人。今人但取其核作涂面药，余亦稀用，故不悉载。又有一种枸（音矩亦音钩）橼（音沿），如小瓜状，皮若橙而光泽可爱，肉甚浓，切如萝卜，虽味短而香氛，大胜柑桔之类，置衣笥中，则数日香不歇。古作五和糁（素感切）所用。陶隐居云∶性温宜人。今闽、广、江西皆有，彼人但谓之香橼子，或将至都下，亦贵之。"}]},{"ID":"20240617111700-3zqvkx5","Type":"NodeParagraph","Properties":{"id":"20240617111700-3zqvkx5","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"雷公曰凡使，勿用柚皮、皱子皮，其二件用不得。凡修事，须去白膜一重，细锉，用鲤鱼皮裹一宿，到明，出，用。其桔皮，年深者最妙。肘后方∶治猝失声，声咽不出。桔皮五两，水三升，煮取一升，去滓顿服。又方∶治食鱼中毒，浓煮桔皮饮汁。经验后方∶治膈下冷气及酒食穣，又用盐三分，一处拌和匀，候良久，铫子内炒微焦，为末。每服一钱半，茶末半钱，水一盏，煎至七分，放温常服，不用入茶，煎沸汤点亦妙。又方∶治妇人产后气逆。以青桔皮为末，葱白、童子小便煎服之。食医心镜云∶主胸中伏热，下气消痰，化食。桔皮半两，微熬作末，如茶法，煎呷之。又方∶治猝食噎。以陈皮一两，汤浸去穣，焙为末。以水一大盏，煎取半盏，热酒下，神服。"}]},{"ID":"20240617111700-v8lenvs","Type":"NodeParagraph","Properties":{"id":"20240617111700-v8lenvs","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"更加钱，食皮、汁，止愤厥之疾。尚书注小曰桔，大曰柚，扬州者为善，故锡贡也。"}]},{"ID":"20240617111700-j0z7mly","Type":"NodeParagraph","Properties":{"id":"20240617111700-j0z7mly","updated":"20240617111700"},"Children":[{"Type":"NodeText","Data":"衍义曰∶桔、柚，自是两种，故曰一名桔皮，是元无柚字也。岂有两等之物，而治疗无一字别者，即知柚一字为误。后人不深求其意，谓柚字所惑，妄生分别，亦以过矣。且青桔与黄桔，治疗尚别，矧柚为别种也。郭璞云∶柚似橙而大于桔，此即是识桔、柚者也。今若不如此言之，恐后世亦以柚皮为桔皮，是贻无穷之患矣。去古既远，后之贤者亦可以意逆之耳。桔惟用皮与核。皮，天下甚所须也，仍汤浸去穣，余如《经》与《注》。核、皮二者须自收为佳。有人患气嗽将期，或教以桔皮、生姜焙干，神曲等分为末，丸桐子大，食后、夜卧，米饮服三、五十丸。兼旧患膀胱，缘服此皆愈。然亦取其陈皮入药，此六陈中一陈也。肾疰、腰痛、膀胱气痛，微炒核，去壳为末，酒调服，愈。"}]},{"ID":"20240617113001-4q4ns7q","Type":"NodeThematicBreak","Properties":{"id":"20240617113001-4q4ns7q"}},{"ID":"20240617113002-woofglm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617113002-woofglm","updated":"20240617113007"},"Children":[{"Type":"NodeText","Data":"橘皮《本草求真》"}]},{"ID":"20240617113002-iljgkfm","Type":"NodeParagraph","Properties":{"id":"20240617113002-iljgkfm","updated":"20240617113002"},"Children":[{"Type":"NodeText","Data":"（山果）宣肺气燥脾湿"}]},{"ID":"20240617113002-slc38ga","Type":"NodeParagraph","Properties":{"id":"20240617113002-slc38ga","updated":"20240617113002"},"Children":[{"Type":"NodeText","Data":"橘皮（专入脾肺。兼入大肠）。味辛而温。治虽专主脾肺。（时珍曰。脾乃元气之母。肺乃摄气之签。故橘皮为二经气分药。）调中快膈。导痰消滞。利水破症。宣五脏理气燥湿。（汪自曰。大法治痰以健脾顺气为主。洁古曰。陈皮枳壳利其气而痰目下。）然同补剂则补。同泻剂则泻。同升剂则升。同降剂则降。各随所配而得其宜。（凡补药涩药。必佐陈皮以利气。）且同生姜。则能止呕。（十剂篇云。宣可去壅。生姜橘皮之属是也。）同半夏则豁痰。同杏仁则治大肠气闭。同桃仁则治大肠血闭。至其利气。虽有类于青皮。但此气味辛温。则入脾肺而宣壅。不如青皮专入肝疏泄。而无入脾燥湿。入肺理气之故也。（诸湿皆属于脾。诸气皆属于肺。）然多服亦能损气。（胃气亦赖痰养。不可用此尽攻。）用补留白。下气消痰除白。（出圣济）即书所名橘红。（今人有以色红形小如枳实者代充。其破气实甚。）然亦寓有发表之意。（以皮治皮意。）核治疝痛偏坠。（凡核多入肾。而橘核尤入囊核。亦物类相感意。时珍曰。橘核入足厥阴肝。与青皮同功。故治腰痛 疝痛。及内 卵肿偏坠。或硬如石。或肿至溃。有极核丸。用之有效。）叶散痈肿。（莫强中为丰城令时得疾。凡食已。辄胸满不下。百方不效。偶家人合橘红汤。因取尝之。似相宜。连日饮之。一日。忽觉胸中有物坠下。大惊目瞪。自汗如雨。须臾腹痛。下数块如铁弹子。臭不可闻。自此胸次廓然。其疾顿愈。盖脾之冷积也。其方用橘皮一斤去穣。甘草盐花各四两。为末。煮干点服。名二肾散。丹溪变为润下丸。用治痰气有效。惟气实人服之相宜。气不足者。不宜用之也。）取广陈久者良。（陈则烈气消散。故名陈皮。与半夏同用。名为二陈。）治火痰童便制。寒痰姜汁制。治下焦盐水制。核去皮炒用。"}]},{"ID":"20240617112951-ht5qq4o","Type":"NodeThematicBreak","Properties":{"id":"20240617112951-ht5qq4o"}},{"ID":"20240617112952-lcmlwni","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112952-lcmlwni","updated":"20240617112956"},"Children":[{"Type":"NodeText","Data":"橘皮《医学入门》"}]},{"ID":"20240617112952-nemrco6","Type":"NodeParagraph","Properties":{"id":"20240617112952-nemrco6","updated":"20240617112952"},"Children":[{"Type":"NodeText","Data":"橘皮辛温利膀胱，主除痰气逆胸膛，消导脾胃止呕泻，发表寒湿佐生姜。"}]},{"ID":"20240617112952-t2dp062","Type":"NodeParagraph","Properties":{"id":"20240617112952-t2dp062","updated":"20240617112952"},"Children":[{"Type":"NodeText","Data":"橘，色如 ，上有文。无毒。味浓。可升可降，阳中之阴也。除膀胱留热停水、五淋，利小便。主胸中痰热，逆气客气，消痰止气嗽，润肺。和胃健脾，轻则水谷不化，冲胸作呕，或下泄，或气痢，或霍乱；重则 瘕积滞，皆能消导。兼去白虫，解酒毒。治下焦冷气，脏间虚冷气，香港脚冲心。久服去臭，下气通神。丹溪云∶与白术、半夏同用，则渗湿而健脾胃；与甘草、白术同用，少用则补脾胃，无甘草、白术而多用、独用，则泻脾胃；与苍术、浓朴同用，去中脘以上至胸膈之邪；再加生姜、葱白、麻黄之类，则能散肉分至皮表有余之邪。陈久者良，隔年者亦可用。留白略炒，健脾胃和中；去白日橘红，消痰泻肺发表；入下焦用盐水浸，肺燥者，童便浸晒。白檀为使。又有一种曰柚，比橘差大，不堪入药。青橘叶，导胸胁逆气，行肝气乳肿痛及胁痈，药中用之以行经。橘核，治肾注腰疼，膀胱疝痛，肾冷，炒去壳为末，酒调服。"}]},{"ID":"20240607161610-6mugnd7","Type":"NodeThematicBreak","Properties":{"id":"20240607161610-6mugnd7"}},{"ID":"20240607161619-s4j8y18","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161619-s4j8y18","updated":"20240607161627"},"Children":[{"Type":"NodeText","Data":"橘皮《本草从新》"}]},{"ID":"20240607161619-hl5v19r","Type":"NodeParagraph","Properties":{"id":"20240607161619-hl5v19r","updated":"20240607161619"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、理气调中、泻、燥湿、消痰．"}]},{"ID":"20240607161619-qnedkry","Type":"NodeParagraph","Properties":{"id":"20240607161619-qnedkry","updated":"20240607161619"},"Children":[{"Type":"NodeText","Data":"辛能散，温能和，苦能燥能泻．为脾、肺气分之药．（脾为气母、肺为气龠、凡用补药涩药、有宜佐陈皮以利气者．）调中快膈．导滞消痰．（大法治痰、以健脾顺气为主、洁古曰∶陈皮定呕止嗽．利水破症．宣通五脏．统治百病．皆取其理气燥湿之功．入和中药．则留白．入疏通药．则去白．去白名橘红．兼能除寒发表．（皮能发散皮肤．）气虽中和．亦损真元．无滞勿用．广产为胜．皮浓不脆．有猪棕纹．（福建产者、名建皮、力薄、浙江衢州出者、名衢皮、更恶劣矣．）陈久者良．故又名陈皮．（陈则烈气消、无燥散之患、半夏亦然、故同用、名二陈汤．）治痰咳．童便浸晒．治痰积．姜汁炒．入下焦．"}]},{"ID":"20240607161619-ly4azpp","Type":"NodeParagraph","Properties":{"id":"20240607161619-ly4azpp","updated":"20240607161619"},"Children":[{"Type":"NodeText","Data":"盐水炒．（化州陈皮、消痰甚灵、然消伐太峻、不宜轻用、况此物真者绝少、无非柚皮而已．）"}]},{"ID":"20240617112627-k9uw3db","Type":"NodeThematicBreak","Properties":{"id":"20240617112627-k9uw3db"}},{"ID":"20240617112722-3jfl3x2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112722-3jfl3x2","updated":"20240617112726"},"Children":[{"Type":"NodeText","Data":"橘皮《药笼小品》"}]},{"ID":"20240617112722-5ooms88","Type":"NodeParagraph","Properties":{"id":"20240617112722-5ooms88","updated":"20240617112722"},"Children":[{"Type":"NodeText","Data":"脾肺肠胃之气药，旧有国老之称，谓其于补于表于疏剂中皆能相助成功。"}]},{"ID":"20240617112722-p16f76h","Type":"NodeParagraph","Properties":{"id":"20240617112722-p16f76h","updated":"20240617112722"},"Children":[{"Type":"NodeText","Data":"同杏仁能治老人便闭。"}]},{"ID":"20240617112722-go2sxb5","Type":"NodeParagraph","Properties":{"id":"20240617112722-go2sxb5","updated":"20240617112722"},"Children":[{"Type":"NodeText","Data":"去白入肺达表。橘白和中止胃痛。《清异录》名橘皮为贵老，取陈而紫色者佳。"}]},{"ID":"20240617112938-v4e1tkt","Type":"NodeThematicBreak","Properties":{"id":"20240617112938-v4e1tkt"}},{"ID":"20240617112939-mn9fp1g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112939-mn9fp1g","updated":"20240617112944"},"Children":[{"Type":"NodeText","Data":"橘皮《神农本草经读》"}]},{"ID":"20240617112939-rkrwlhb","Type":"NodeParagraph","Properties":{"id":"20240617112939-rkrwlhb","updated":"20240617112939"},"Children":[{"Type":"NodeText","Data":"气味苦辛、温，无毒。主胸中瘕热逆气，利水谷。久服去臭，下气通神。"}]},{"ID":"20240617112939-2xclisz","Type":"NodeParagraph","Properties":{"id":"20240617112939-2xclisz","updated":"20240617112939"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶橘皮气温，禀春气而入肝；味苦入心；味辛入肺。胸中为肺之部位，唯其入肺，所以主胸中之瘕热逆气；疏泄为肝之专长，唯其入肝，所以能利水谷；心为君主之官，唯其入心，则君火明而浊阴之臭气自去。又推其所以得效之神者，皆其下气之功也。总结上三句，古人多误解。"}]},{"ID":"20240617112939-if5k60a","Type":"NodeParagraph","Properties":{"id":"20240617112939-if5k60a","updated":"20240617112939"},"Children":[{"Type":"NodeText","Data":"又曰∶橘皮筋膜似脉络，皮形似肌肉，宗眼似毛孔。人之伤风咳嗽，不外肺经；肺主皮毛，风之伤人，先于皮毛，次入经络而渐深；治以橘皮之苦以降气，辛以发散；俾从脾胃之大络，而外转于肌肉毛孔之外，微微从汗而解也。若削去筋膜，只留外皮，名曰橘红，意欲解肌止嗽，不知汗本由内而外，岂能离肌肉经络而直走于外？雷去白留白之分，东垣因之，何不通之甚也！至于以橘皮制造为酱，更属无知妄作。查其制法∶橘皮用水煮三次极烂，嚼之无辛苦味，晒干，外用甘草、麦冬、青盐、乌梅、元明粉、硼砂，熬浓汁浸晒多次，以汁干为度。又以人参、贝母研末拌匀，收贮数月后用之。据云能化痰疗嗽，顺气止渴生津。而不知全失橘皮之功用。橘皮治嗽，妙在辛以散之，今以乌梅之酸收乱之；橘皮顺气，妙在苦以降之，今以麦冬、人参、甘草之甘壅乱之；橘皮妙在温燥，故能去痰宽胀，今以麦冬、贝母、元明、硼砂、青盐之咸寒乱之；试问橘皮之本色何在乎？余尝究俗人喜服之由，总由入口之时得甘酸之味，则满口生津；得咸寒之性，则坚痰暂化；一时有验，彼此相传，而阴被其害者不少也。法制半夏，亦用此药浸造，罨发黄衣收贮，贻害则一。"}]},{"ID":"20240617112727-xjomvtd","Type":"NodeThematicBreak","Properties":{"id":"20240617112727-xjomvtd"}},{"ID":"20240617112733-b78lugk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112733-b78lugk","updated":"20240617112737"},"Children":[{"Type":"NodeText","Data":"橘皮《药征》"}]},{"ID":"20240617112733-h6hfsas","Type":"NodeParagraph","Properties":{"id":"20240617112733-h6hfsas","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"主治呃逆也。旁治胸痹停痰。"}]},{"ID":"20240617112733-wh0u0kt","Type":"NodeParagraph","Properties":{"id":"20240617112733-wh0u0kt","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240617112733-jo6d5jv","Type":"NodeParagraph","Properties":{"id":"20240617112733-jo6d5jv","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"橘皮竹茹汤证曰∶哕逆。（哕者呃之谓也）"}]},{"ID":"20240617112733-x1t2pvt","Type":"NodeParagraph","Properties":{"id":"20240617112733-x1t2pvt","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"以上一方，橘皮二斤。"}]},{"ID":"20240617112733-kkny9ce","Type":"NodeParagraph","Properties":{"id":"20240617112733-kkny9ce","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"橘皮枳实生姜汤证曰∶胸痹。（说在杏仁部中）"}]},{"ID":"20240617112733-mp136o7","Type":"NodeParagraph","Properties":{"id":"20240617112733-mp136o7","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"以上一方，橘皮一斤。"}]},{"ID":"20240617112733-0uqdrsb","Type":"NodeParagraph","Properties":{"id":"20240617112733-0uqdrsb","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"橘皮汤证曰∶哕。"}]},{"ID":"20240617112733-dc43zl8","Type":"NodeParagraph","Properties":{"id":"20240617112733-dc43zl8","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"以上一方，橘皮四两。"}]},{"ID":"20240617112733-1ci2mvi","Type":"NodeParagraph","Properties":{"id":"20240617112733-1ci2mvi","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"茯苓饮证曰∶心胸中有停痰。"}]},{"ID":"20240617112733-7i3lj7b","Type":"NodeParagraph","Properties":{"id":"20240617112733-7i3lj7b","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"以上一方，橘皮二两半。"}]},{"ID":"20240617112733-qbeatj1","Type":"NodeParagraph","Properties":{"id":"20240617112733-qbeatj1","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"上历观此诸方，主治呃逆也明。胸痹者，停痰者，其有呃逆之证，则橘皮所能治也。"}]},{"ID":"20240617112733-rfab8rl","Type":"NodeParagraph","Properties":{"id":"20240617112733-rfab8rl","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240617112733-70hmvgj","Type":"NodeParagraph","Properties":{"id":"20240617112733-70hmvgj","updated":"20240617112733"},"Children":[{"Type":"NodeText","Data":"橘皮 近世间以柑子代橘皮，非也，可选用焉。真橘树者，余观之于和州春日祠前，于远州见附驿也。"}]},{"ID":"20240617112741-0z3i32h","Type":"NodeThematicBreak","Properties":{"id":"20240617112741-0z3i32h"}},{"ID":"20240617112742-dmwfveh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112742-dmwfveh","updated":"20240617112746"},"Children":[{"Type":"NodeText","Data":"橘皮《本经逢原》"}]},{"ID":"20240617112742-vp4fhx3","Type":"NodeParagraph","Properties":{"id":"20240617112742-vp4fhx3","updated":"20240617112742"},"Children":[{"Type":"NodeText","Data":"苦辛温，无毒。产粤东新会，陈久者良。阴虚干咳，蜜水制用。妇人乳房壅癖，醋拌炒用。"}]},{"ID":"20240617112742-wgj34p7","Type":"NodeParagraph","Properties":{"id":"20240617112742-wgj34p7","updated":"20240617112742"},"Children":[{"Type":"NodeText","Data":"《本经》主胸中痰热逆气，利水谷，久服去口臭，下气通神。"}]},{"ID":"20240617112742-57ky57l","Type":"NodeParagraph","Properties":{"id":"20240617112742-57ky57l","updated":"20240617112742"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"橘禀东南阳气而生，故以闽粤者最胜。其逾淮而北则变为枳，此地气使然，与人之乡音习俗无异。橘之文采焕发于外，故其功用都在于皮，专行脾肺二经气分。《本经》主治胸中痰热逆气，为消痰运食之要药。留白则补脾胃，去白则理肺气。同人参、白术则补脾胃。同人参、甘草则补肺。独用则泻肺损脾。其治百病，总是取其理气燥湿之功。同补药则补，同泻药则泻，同升药则升，同降药则降。脾乃元气之母，肺乃摄气之龠，故为二经气分药，但随所配而补泻升降也。同生姜则止呕，同半夏则豁痰，同杏仁治大肠气秘，同桃仁治大肠血秘，皆取其通滞也。橘红专主肺寒咳嗽多痰，虚损方多用之。然久嗽气泄又非所宜。"}]},{"ID":"20240617112742-2vyztik","Type":"NodeParagraph","Properties":{"id":"20240617112742-2vyztik","updated":"20240617112742"},"Children":[{"Type":"NodeText","Data":"按∶橘皮下气消痰，其瓤生痰聚饮，一物而性之殊异如此。"}]},{"ID":"20240617112750-lws97ef","Type":"NodeThematicBreak","Properties":{"id":"20240617112750-lws97ef"}},{"ID":"20240617112751-84iq79s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112751-84iq79s","updated":"20240617112755"},"Children":[{"Type":"NodeText","Data":"橘皮《侣山堂类辩》"}]},{"ID":"20240617112751-d46ujnj","Type":"NodeParagraph","Properties":{"id":"20240617112751-d46ujnj","updated":"20240617112751"},"Children":[{"Type":"NodeText","Data":"橘皮臭香色黄，味甘而带辛，甘、香、黄主土，辛主金。夫胃土主脉络，（胃又属阳明，秋金其色白。）脾土主肌肉，肺金主皮毛，橘皮在内之白膜，如胃腑所主之络脉，皮内之白若肌肉，皮外之宗眼如毛孔，是从中达外，由脉而络，络而肌，肌而皮也。橘皮能宣发阳明之汗，解胃气之逆呃，盖能宣达胃气，外出于皮毛，若夫皮腠之邪，逆于内而为喘急，膈上之痰，结于上而为咳嗽，欲消痰降气而从下解者，是又从肌而络，络而脉，脉而胃也。是邪正之气，欲出欲入，而用橘皮为导引者，皆藉皮内之白膜，如去其膜白，则断截出入之道路，故本经止曰橘皮，而并无留白、去白之分。"}]},{"ID":"20240617112800-o677qtg","Type":"NodeThematicBreak","Properties":{"id":"20240617112800-o677qtg"}},{"ID":"20240617112801-enxjp0b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112801-enxjp0b","updated":"20240617112806"},"Children":[{"Type":"NodeText","Data":"橘皮《顾松园医镜》"}]},{"ID":"20240617112801-3z9zoly","Type":"NodeParagraph","Properties":{"id":"20240617112801-3z9zoly","updated":"20240617112801"},"Children":[{"Type":"NodeText","Data":"〔辛苦温，入肺、脾、胃三经。和中补脾胃，留白用；消痰理肺气，去白用。广中者最佳，福建者次之，陈久愈良。去蒂及浮膜。〕理气通滞，宽胸快膈，〔能去胸中滞气冷气，皆理气之功。〕开胃进食，助脾消谷，〔香以醒之，温以行之。〕宁嗽消痰，〔气利而嗽自止，痰自下，治湿痰寒痰痰饮，尤为最宜。〕止呕定泄。〔和胃调脾，理气通滞之效。〕治大肠气闭，〔人之一身，三焦相通，不过一气，故气闭脉浮佐杏仁用，血闭脉浮佐桃仁用。〕疗妇人乳痈。同补气药则益气，同泄气药则破气，同消痰药则祛痰，同消食药则化食，各从其类以为用。"}]},{"ID":"20240617112801-789seq3","Type":"NodeParagraph","Properties":{"id":"20240617112801-789seq3","updated":"20240617112801"},"Children":[{"Type":"NodeText","Data":"中气虚者，勿同耗耗气药用；胃热呕者，勿同辛温药用；阴虚痰嗽，勿同星、夏等药用。橘肉生痰聚气。一物也，而相背如此。"}]},{"ID":"20240617112801-3yt70x9","Type":"NodeParagraph","Properties":{"id":"20240617112801-3yt70x9","updated":"20240617112801"},"Children":[{"Type":"NodeText","Data":"橘叶〔苦平〕治乳痈。〔能散阳明厥阴经滞气。〕橘核〔苦平〕疗诸疝〔下气故也。〕"}]},{"ID":"20240617112823-bvf9fpt","Type":"NodeThematicBreak","Properties":{"id":"20240617112823-bvf9fpt"}},{"ID":"20240617112824-p2vzbpi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112824-p2vzbpi","updated":"20240617112828"},"Children":[{"Type":"NodeText","Data":"橘皮《本草从新》"}]},{"ID":"20240617112824-tizi3ks","Type":"NodeParagraph","Properties":{"id":"20240617112824-tizi3ks","updated":"20240617112824"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、理气调中、泻、燥湿、消痰．"}]},{"ID":"20240617112824-qg9pg7l","Type":"NodeParagraph","Properties":{"id":"20240617112824-qg9pg7l","updated":"20240617112824"},"Children":[{"Type":"NodeText","Data":"辛能散，温能和，苦能燥能泻．为脾、肺气分之药．（脾为气母、肺为气龠、凡用补药涩药、有宜佐陈皮以利气者．）调中快膈．导滞消痰．（大法治痰、以健脾顺气为主、洁古曰∶陈皮定呕止嗽．利水破症．宣通五脏．统治百病．皆取其理气燥湿之功．入和中药．则留白．入疏通药．则去白．去白名橘红．兼能除寒发表．（皮能发散皮肤．）气虽中和．亦损真元．无滞勿用．广产为胜．皮浓不脆．有猪棕纹．（福建产者、名建皮、力薄、浙江衢州出者、名衢皮、更恶劣矣．）陈久者良．故又名陈皮．（陈则烈气消、无燥散之患、半夏亦然、故同用、名二陈汤．）治痰咳．童便浸晒．治痰积．姜汁炒．入下焦．"}]},{"ID":"20240617112824-art54b3","Type":"NodeParagraph","Properties":{"id":"20240617112824-art54b3","updated":"20240617112824"},"Children":[{"Type":"NodeText","Data":"盐水炒．（化州陈皮、消痰甚灵、然消伐太峻、不宜轻用、况此物真者绝少、无非柚皮而已．）"}]},{"ID":"20240617112834-rolimj7","Type":"NodeThematicBreak","Properties":{"id":"20240617112834-rolimj7"}},{"ID":"20240617112836-iutqhux","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112836-iutqhux","updated":"20240617112841"},"Children":[{"Type":"NodeText","Data":"橘皮《本草便读》"}]},{"ID":"20240617112836-fkdxxzc","Type":"NodeParagraph","Properties":{"id":"20240617112836-fkdxxzc","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"入脾胃以和中．燥可消痰理气滞．味苦辛而散逆．温能快膈逐寒凝．留白则宣补中州．去白则流行肺部．核乃入肝疗疝．理寒滞以颇灵．叶则治乳消痈．味苦平而无毒．络能通络甘寒用．瓤可生痰酸冷多．（橘皮种类甚多．惟广产者最胜．陈者良．味苦辛．性温．气香．质燥．入脾胃气分．燥湿理气．散逆和中．同补药则补．同表药则表．同泻药则泻．用盐水炒极能治痰．以其能燥湿理气．亦治痰之本也．"}]},{"ID":"20240617112836-gsu5zfj","Type":"NodeParagraph","Properties":{"id":"20240617112836-gsu5zfj","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"○橘白去外一层红皮．其味带甘．其功固不如橘皮．而补脾胃药中用之．自无燥散之咎．"}]},{"ID":"20240617112836-7y4a6n9","Type":"NodeParagraph","Properties":{"id":"20240617112836-7y4a6n9","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"○橘红则去尽内白．有轻浮之意．故能入肺．主治亦相似．"}]},{"ID":"20240617112836-bb2795k","Type":"NodeParagraph","Properties":{"id":"20240617112836-bb2795k","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"○橘核苦温．色青入肝．形类肾丸．故能治一切疝疾之因于寒者．用此宣散之．亦气分药也．"}]},{"ID":"20240617112836-q3ro7rh","Type":"NodeParagraph","Properties":{"id":"20240617112836-q3ro7rh","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"○橘叶苦平气香．轻扬上达．入肝胃．宣胸膈逆气．消肿散毒．凡妇人一切乳证．皆可用之．"}]},{"ID":"20240617112836-8mk3m2j","Type":"NodeParagraph","Properties":{"id":"20240617112836-8mk3m2j","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"○橘络甘寒入络．无甚功用．或可清络中之余热耳．"}]},{"ID":"20240617112836-c0s9wso","Type":"NodeParagraph","Properties":{"id":"20240617112836-c0s9wso","updated":"20240617112836"},"Children":[{"Type":"NodeText","Data":"○橘瓤性寒．甘者可以润肺．酸者即能生痰．一物之性各异．主治不同．岂可不省察哉．）"}]},{"ID":"20240617112922-lfizmcr","Type":"NodeThematicBreak","Properties":{"id":"20240617112922-lfizmcr"}},{"ID":"20240617112923-a0yfeti","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112923-a0yfeti","updated":"20240617112927"},"Children":[{"Type":"NodeText","Data":"橘皮《本草择要纲目》"}]},{"ID":"20240617112923-lrmk3sk","Type":"NodeParagraph","Properties":{"id":"20240617112923-lrmk3sk","updated":"20240617112923"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240617112923-gc7dxza","Type":"NodeParagraph","Properties":{"id":"20240617112923-gc7dxza","updated":"20240617112923"},"Children":[{"Type":"NodeText","Data":"苦辛温无毒．又气薄味浓．阳中之阴也．可升可降．"}]},{"ID":"20240617112923-1ruoktw","Type":"NodeParagraph","Properties":{"id":"20240617112923-1ruoktw","updated":"20240617112923"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240617112923-7n61yvq","Type":"NodeParagraph","Properties":{"id":"20240617112923-7n61yvq","updated":"20240617112923"},"Children":[{"Type":"NodeText","Data":"橘皮苦能泻能燥．辛能散能温．能补能和．化痰治嗽．顺气理中．调脾快膈．通五淋．疗酒病．其功当在诸药之上．皆是取其理气燥湿之功．同补药则补．同泻药则泻．同升药则升．同降药则降．脾乃元气之母．肺乃摄气之仑．故橘皮为二经气分之药．但随所配而补泻升降也．故洁古张氏云．陈皮枳壳利其气而痰自下．盖此义也．同杏仁治大肠气 ．同桃仁治大肠血 ．皆取其通滞也．"}]},{"ID":"20240617112910-u6w2rqt","Type":"NodeThematicBreak","Properties":{"id":"20240617112910-u6w2rqt"}},{"ID":"20240617112912-q1kfbrn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112912-q1kfbrn","updated":"20240617112916"},"Children":[{"Type":"NodeText","Data":"橘皮《本草害利》"}]},{"ID":"20240617112912-r902bk0","Type":"NodeParagraph","Properties":{"id":"20240617112912-r902bk0","updated":"20240617112912"},"Children":[{"Type":"NodeText","Data":"〔害〕气味辛温，能耗真气。凡中气虚，气不归元，忌与耗气药同用。胃虚有火呕吐，不宜与温热香燥药同用。阴虚咳嗽生痰，不宜与半夏、南星等同用。"}]},{"ID":"20240617112912-ebie2xr","Type":"NodeParagraph","Properties":{"id":"20240617112912-ebie2xr","updated":"20240617112912"},"Children":[{"Type":"NodeText","Data":"化州陈皮，消伐太峻，不宜滥用。"}]},{"ID":"20240617112912-oyq7dif","Type":"NodeParagraph","Properties":{"id":"20240617112912-oyq7dif","updated":"20240617112912"},"Children":[{"Type":"NodeText","Data":"〔利〕苦辛温，入肺、脾、胃三经。止嗽定呕清痰，理气和中妙品。留白补胃偏宜，去白疏通专掌。化州陈皮，苦能泄气，又能燥湿，辛能散气，温能和气，同补气药则补，同泻药则泻，同升药则升，同降药则降。"}]},{"ID":"20240617112912-ncy67k1","Type":"NodeParagraph","Properties":{"id":"20240617112912-ncy67k1","updated":"20240617112912"},"Children":[{"Type":"NodeText","Data":"橘络辛温，宣气通络，治络用为引经，酒炒用。橘红以皮行皮，兼能治表寒。橘皮性温，柑柚皮性冷。"}]},{"ID":"20240617112912-t2ndfsk","Type":"NodeParagraph","Properties":{"id":"20240617112912-t2ndfsk","updated":"20240617112912"},"Children":[{"Type":"NodeText","Data":"〔修治〕广东新会皮为胜，陈久者良，故名陈皮。福建产者名建皮，力薄。浙江衢州出者名衢皮，更次矣。去白名橘红，痰嗽童便浸晒，痰积姜汁拌，入下焦盐水炒济，和蜜炙。去红曰橘白，疏通滞气，盐水炒用。化州陈皮，消痰甚灵，真者绝少，无非柚皮而已。橘皮下气行痰，橘肉生痰聚气，一物也，而相反如此。橘皮纹细，色红而薄，内多筋络，其味苦辛。"}]},{"ID":"20240617112912-nopgq9c","Type":"NodeParagraph","Properties":{"id":"20240617112912-nopgq9c","updated":"20240617112912"},"Children":[{"Type":"NodeText","Data":"柑皮纹粗色黄而浓，内多白膜，其味辛甘。柚皮最浓而虚，纹更粗色黄，内多膜无筋，其味甘多辛少。但以此别之，则不差矣。柑皮犹可用，柚皮则悬绝矣。"}]},{"ID":"20240617112901-pmh2uqs","Type":"NodeThematicBreak","Properties":{"id":"20240617112901-pmh2uqs"}},{"ID":"20240617112902-7yavd4n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112902-7yavd4n","updated":"20240617112905"},"Children":[{"Type":"NodeText","Data":"橘皮（陈皮、青皮）《本草新编》"}]},{"ID":"20240617112902-90i3dpu","Type":"NodeParagraph","Properties":{"id":"20240617112902-90i3dpu","updated":"20240617112902"},"Children":[{"Type":"NodeText","Data":"橘皮，味辛、苦，气温，沉也，阴中之阳，无毒。陈皮治高，青皮治低，亦以功力大小不同也。入少阳三焦、胆腑，又入厥阴肝脏、太阴脾脏。"}]},{"ID":"20240617112902-hetxud3","Type":"NodeParagraph","Properties":{"id":"20240617112902-hetxud3","updated":"20240617112902"},"Children":[{"Type":"NodeText","Data":"青皮，消坚辟，消瘟疟滞气，尤胁下郁怒痛甚者须投，却疝疏肝，消食宽胃。橘红名陈皮，气味相同，而功用少缓，和中消痰，宽胁利膈，用之补，则佐补以健脾；用之攻，则尚攻以损肺。宜于补药同行，忌于攻剂共享。倘欲一味出奇，未有不倒戈而自败者也。"}]},{"ID":"20240617112902-jjy1tqi","Type":"NodeParagraph","Properties":{"id":"20240617112902-jjy1tqi","updated":"20240617112902"},"Children":[{"Type":"NodeText","Data":"或问陈皮留白为补，去白为攻，然乎？此齐东之语也。陈皮与青皮，同为消痰利气之药，但青皮味浓于陈皮，不可谓陈皮是补而青皮是泻也。"}]},{"ID":"20240617112902-rrukf9x","Type":"NodeParagraph","Properties":{"id":"20240617112902-rrukf9x","updated":"20240617112902"},"Children":[{"Type":"NodeText","Data":"或问陈皮即橘红也，子何以取陈皮而不取橘红？夫陈皮之妙，全在用白，用白则宽中消，若去白而用红，与青皮何异哉，此世所以“留白为补，去白为攻”之误也。其实，留白非补，和解则有之耳。"}]},{"ID":"20240617112902-7mc2rt1","Type":"NodeParagraph","Properties":{"id":"20240617112902-7mc2rt1","updated":"20240617112902"},"Children":[{"Type":"NodeText","Data":"或问世人竟尚法制陈皮，不知吾子亦有奇方否？曰∶陈皮制之得法，实可消痰，兼生津液，更能顺气以化饮食。市上贸易者非佳，惟姑苏尤胜。然又过于多制，惟取生津，而不能顺气。余有方更妙，用陈皮一斤，切，不可去白，清水净洗，去其陈秽即取起。用生姜一两，煎汤一碗，拌陈皮晒干。又用白芥子一两，煮汤一碗，拌陈皮晒干，饭锅蒸熟，又晒干。又用甘草、薄荷一两三钱，煎汤，拌陈皮，又晒干，又蒸熟晒干。又用五味子三钱、百合一两，煎汤二碗，拌匀又蒸晒。又用青盐五钱、白矾二钱，滚水半碗拌匀，又蒸熟晒干。又用人参三钱，煎汤二碗，拌匀蒸熟晒干。又用麦门冬、橄榄各一两煎汤，照前晒干，收藏于磁器内。此方含在口中，津液自生，饮食自化，气自平而痰自消，咳嗽顿除矣。修合时，切忌行经妇人矣。"}]},{"ID":"20240617112902-srf0xkq","Type":"NodeParagraph","Properties":{"id":"20240617112902-srf0xkq","updated":"20240617112902"},"Children":[{"Type":"NodeText","Data":"或问陈皮用之于补中益气汤中，前人虽有发明，然非定论，不识先生之可发其奇否？夫补中益气汤中用陈皮也，实有妙义，非取其能宽中也。气陷至阴，得升麻、柴胡以提之矣。然提出于至阴之上，而参、 、归、术，未免尽助其阳，而反不能遽受。得陈皮，以分消于其间，则补不绝补，而气转得益。东垣以益气名汤者，谓陈皮而非谓参、 、归、术也。"}]},{"ID":"20240617112848-vond22m","Type":"NodeThematicBreak","Properties":{"id":"20240617112848-vond22m"}},{"ID":"20240617112849-7ugu5ic","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112849-7ugu5ic","updated":"20240617112854"},"Children":[{"Type":"NodeText","Data":"橘皮《本草崇原》"}]},{"ID":"20240617112849-mvn27ne","Type":"NodeParagraph","Properties":{"id":"20240617112849-mvn27ne","updated":"20240617112849"},"Children":[{"Type":"NodeText","Data":"气味苦辛温，无毒。主治胸中瘕热逆气，利水谷。久服去臭，下气，通神。"}]},{"ID":"20240617112849-izkdgve","Type":"NodeParagraph","Properties":{"id":"20240617112849-izkdgve","updated":"20240617112849"},"Children":[{"Type":"NodeText","Data":"（橘生江南及山南山谷，今江浙荆襄湖 皆有。枝多坚刺，叶色青翠，经冬不凋，结实青圆橘实形圆色黄，臭香肉甘，脾之果也。其皮气味苦辛，性主温散，筋膜似络脉，皮形若肌肉，宗眼如毛孔，乃从脾脉之大络而外出于肌肉毛孔之药也。胸中瘕热逆气者，谓胃上郛郭之间，浊气留聚，则假气成形，而为瘕热逆气之病。橘皮能达胃络之气，出于肌腠，故胸中之瘕热逆气可治也。利水谷者，水谷入胃，藉脾气之散精，橘皮能达脾络之气，上通于胃，故水谷可利也。久服去臭者，去中焦腐秽之臭气，而整肃脾胃也。下气通神者，下肺主之气，通心主之神，橘皮气味辛苦，辛入肺，而苦入心也。"}]},{"ID":"20240617112849-umtcwh5","Type":"NodeParagraph","Properties":{"id":"20240617112849-umtcwh5","updated":"20240617112849"},"Children":[{"Type":"NodeText","Data":"愚按∶上古诸方，只曰橘皮个用不切，并无去白之说。李东垣不参经义，不礼物性，承《嗽。"}]},{"ID":"20240617112849-175cux3","Type":"NodeParagraph","Properties":{"id":"20240617112849-175cux3","updated":"20240617112849"},"Children":[{"Type":"NodeText","Data":"夫咳嗽非只肺病，有肝气上逆而咳嗽者，有胃气壅滞而咳嗽者，有肾气奔迫而咳嗽者，有心火上炎而咳嗽者，有皮毛闭拒而咳嗽者，有脾肺不和而咳嗽者。《经》云∶五脏六腑皆令人咳，非独肺也。橘皮里有筋膜，外黄内白，其味先甘后辛，其性从络脉而外达于肌肉、毛孔，以之治咳，有从内达外之义。若去其白，其味但辛，只行皮毛，风寒咳嗽似乎相宜，虚劳不足，益辛散矣。后人袭方书糟粕，不穷物性本原，无怪以讹传讹，而莫之止。须知雷 乃宋人，非黄帝时雷公也。业医者当以上古方制为准绳，如《金匮要略》用橘皮汤治干呕哕，义可知矣。日华子谓∶橘瓤上筋膜，治口渴吐酒，煎汤饮甚效。以其能行胸中之饮而行于皮肤也。夫橘皮从内达外，凡汗多里虚，阳气外浮者，宜禁用之。"}]},{"ID":"20240617112812-n8ng883","Type":"NodeThematicBreak","Properties":{"id":"20240617112812-n8ng883"}},{"ID":"20240617112814-sahfu46","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112814-sahfu46","updated":"20240617112818"},"Children":[{"Type":"NodeText","Data":"橘皮《长沙药解》"}]},{"ID":"20240617112814-fujcp6c","Type":"NodeParagraph","Properties":{"id":"20240617112814-fujcp6c","updated":"20240617112814"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】橘柚。味辛温。主胸中瘕热逆气，利水谷。久服，去臭下气通神，一名橘皮。生川谷。"}]},{"ID":"20240617112814-20vuunn","Type":"NodeParagraph","Properties":{"id":"20240617112814-20vuunn","updated":"20240617112814"},"Children":[{"Type":"NodeText","Data":"味辛、苦，入手太阴肺经。降浊阴而止呕哕，行滞气而泻郁满，善开胸膈，最扫痰涎。"}]},{"ID":"20240617112814-05zjul6","Type":"NodeParagraph","Properties":{"id":"20240617112814-05zjul6","updated":"20240617112814"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"橘皮汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"橘皮四两，生姜八两。"},{"Type":"NodeText","Data":"用以治干呕哕，而手足厥者。以胃土上逆，浊气熏冲，故生呕哕。中气堙郁，不能四达，故手足厥冷。橘皮破壅塞而扫瘀浊，生姜降冲逆而行凝滞也。"}]},{"ID":"20240617112814-h3cg4sy","Type":"NodeParagraph","Properties":{"id":"20240617112814-h3cg4sy","updated":"20240617112814"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"橘皮竹茹汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"橘皮一斤，竹茹二升，生姜半斤，甘草五两，人参一两，大枣三十枚。"},{"Type":"NodeText","Data":"治哕逆者。以土衰胃逆，浊阴不降，甘、枣、人参，补中气以培土。橘、姜、竹茹，降浊阴而行滞也。"}]},{"ID":"20240617112814-3soqi8g","Type":"NodeParagraph","Properties":{"id":"20240617112814-3soqi8g","updated":"20240617112814"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"橘枳生姜汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"橘皮一斤，生姜半斤，枳实三两。"},{"Type":"NodeText","Data":"治胸中痹塞，短气。以胃土逆升，浊气痞塞，肺无降路，是以短气。橘、姜破壅塞而降浊阴。枳实泻痞满而扫瘀腐也。《外台》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茯苓饮"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在茯苓。"},{"Type":"NodeText","Data":"即于橘枳生姜汤加参、术、茯苓，以治痰饮，补泻并行，可谓妙矣。"}]},{"ID":"20240617112814-3wp68ls","Type":"NodeParagraph","Properties":{"id":"20240617112814-3wp68ls","updated":"20240617112814"},"Children":[{"Type":"NodeText","Data":"橘皮辛散之性，疏利通畅，长于降浊止呕，行滞消痰，而和平条达，不至破气而损正，行郁理气之佳药也。其诸主治，疗吹奶，调乳痈，除痎疟，消癥瘕，行胶痰，磨宿谷，利小便，通大肠，理嘈杂，治淋痢，下鱼骨鲠，杀寸白虫，总缘善行滞气也。"}]},{"ID":"20240607152428-js5loa3","Type":"NodeThematicBreak","Properties":{"id":"20240607152428-js5loa3"}},{"ID":"20240607161602-8hn0e77","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607161602-8hn0e77","updated":"20240607161608"},"Children":[{"Type":"NodeText","Data":"陈皮《本草备要》"}]},{"ID":"20240607161602-01rx8o0","Type":"NodeParagraph","Properties":{"id":"20240607161602-01rx8o0","updated":"20240607161602"},"Children":[{"Type":"NodeText","Data":"能燥能宣，有补有泻，可升可降"}]},{"ID":"20240607161602-fko2kdu","Type":"NodeParagraph","Properties":{"id":"20240607161602-fko2kdu","updated":"20240607161602"},"Children":[{"Type":"NodeText","Data":"辛能散，苦能燥、能泻，温能补、能和。同补药则补，泻药则泻，升药则升，降药则降。为脾、肺气分之药（脾为气母，肺为气龠。凡补药涩药，必佐陈皮以利气）。调中快膈，导滞消痰（大法治痰，以健脾顺气为主。洁古曰∶陈皮、枳壳利其气，而痰自下），利水破症，宣通五脏，统治百病，皆取其理气燥湿之功（人身以气为主，气顺湿除，则百病散。《金匮》云∶能解鱼毒、食毒）。多服久服，损人元气。入补养药则留白，入下气消痰药则去白（《圣济》云∶不去白，反生痰）。"}]},{"ID":"20240607161602-vb6otoe","Type":"NodeParagraph","Properties":{"id":"20240607161602-vb6otoe","updated":"20240607161602"},"Children":[{"Type":"NodeText","Data":"去白名橘红，兼能除寒发表（皮能发散皮肤）。核治疝痛。叶散乳痈（皆能入厥阴，行肝气，消肿散毒。腰肾冷痛，橘核炒酒服良。《十剂》曰∶宣可去壅，生姜橘皮之属是也。《泊宅编》曰∶莫强中，食已辄胸满不下，百治不效。偶家人合橘皮汤，尝之似有味，连日饮之。一日坐厅事，觉胸中有物坠下，目瞪汗濡，大惊扶归，腹疼痛，下数块如铁弹，臭不可闻，自此胸次廓然。盖脾之冷积也，半年服药不知，功乃在橘皮。方用橘皮一斤，甘草、盐各四两，煮干点服，名二贤散。蒸饼丸，名润下丸。治痰特有验。世医惟知半夏、南星、枳壳、茯苓之属，何足语此哉！丹溪曰∶治痰，利药过多则脾虚，痰易生而反多。又曰∶胃气亦赖痰以养，不可攻尽，攻尽则虚而愈剧）。广中陈久者良，故名陈皮（陈则烈气消，无燥散之患。半夏亦然，故同用名二陈汤）。治痰咳，童便浸晒。治痰积，姜汁炒。治下焦，盐水炒。去核、皮，炒用。"}]},{"ID":"20240617112343-iqngf6o","Type":"NodeThematicBreak","Properties":{"id":"20240617112343-iqngf6o"}},{"ID":"20240617112344-pd55t5n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112344-pd55t5n","updated":"20240617112348"},"Children":[{"Type":"NodeText","Data":"陈皮《珍珠囊补遗药性赋》"}]},{"ID":"20240617112344-b9v0lz3","Type":"NodeParagraph","Properties":{"id":"20240617112344-b9v0lz3","updated":"20240617112344"},"Children":[{"Type":"NodeText","Data":"陈皮，味辛苦性温无毒。可升可降，阳中之阴也。其用有二∶留白补胃和中；去白消痰泄气。"}]},{"ID":"20240617112422-aj9i4ch","Type":"NodeThematicBreak","Properties":{"id":"20240617112422-aj9i4ch"}},{"ID":"20240617112423-8szbtkd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112423-8szbtkd","updated":"20240617112426"},"Children":[{"Type":"NodeText","Data":"陈皮《要药分剂》"}]},{"ID":"20240617112423-cl5f5l4","Type":"NodeParagraph","Properties":{"id":"20240617112423-cl5f5l4","updated":"20240617112423"},"Children":[{"Type":"NodeText","Data":"味苦辛。性温。无毒。色红日久者佳。"}]},{"ID":"20240617112423-pyn1huw","Type":"NodeParagraph","Properties":{"id":"20240617112423-pyn1huw","updated":"20240617112506"},"Children":[{"Type":"NodeText","Data":"【主治】主调中快膈。导滞消痰。利水止呕。破症瘕癖。除膀胱留热。宣通五脏。统治百主除寒【归经】入肺肝脾胃四经。为宣通疏利之品。（兼泻剂燥剂宣剂脾肺气分之药）【前论】丹溪曰。治痰利药过多则脾虚。痰易生而反多。又曰。胃气亦赖痰以养。不可攻尽陈皮因所【禁忌】经疏曰。凡中气虚。气不归元者。忌与耗气药同用。胃虚有火呕吐。忌与温热香燥药同用，阴虚咳嗽生痰,不宜与半夏、南星等同用。"}]},{"ID":"20240617112547-6a39n6d","Type":"NodeThematicBreak","Properties":{"id":"20240617112547-6a39n6d"}},{"ID":"20240617112548-udkwnjq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112548-udkwnjq","updated":"20240617112552"},"Children":[{"Type":"NodeText","Data":"陈皮《雷公炮制药性解》"}]},{"ID":"20240617112548-zw1ox40","Type":"NodeParagraph","Properties":{"id":"20240617112548-zw1ox40","updated":"20240617112548"},"Children":[{"Type":"NodeText","Data":"味辛苦，性温无毒，入肺肝脾胃四经。主下气消食，化痰破结，止呕咳，定霍乱，疗吐泻，利小便，通五淋，逐膀胱留热，杀寸白诸虫，核治腰痛疝痛，叶治乳痈胁痈，肉能止渴，多食令人气逆生痰。去白者兼能除寒发表，留白者兼能补胃和中，微炒用，产广中，陈久者良。"}]},{"ID":"20240617112548-oxra46m","Type":"NodeParagraph","Properties":{"id":"20240617112548-oxra46m","updated":"20240617112605"},"Children":[{"Type":"NodeText","Data":"按∶陈皮辛苦之性，能泄肺部。金能制水，故入肝家，土不受侮，故入脾胃，采时性已极热，如人至老成，则酷性渐减，收藏又复陈久，则多历梅夏，而烈气全消，温中而无燥热之患，行气而无峻削之虞。"}]},{"ID":"20240617112514-7npj986","Type":"NodeThematicBreak","Properties":{"id":"20240617112514-7npj986"}},{"ID":"20240617112515-wzkpz6k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112515-wzkpz6k","updated":"20240617112520"},"Children":[{"Type":"NodeText","Data":"陈皮《冯氏锦囊秘录》"}]},{"ID":"20240617112515-wn7enex","Type":"NodeParagraph","Properties":{"id":"20240617112515-wn7enex","updated":"20240617112515"},"Children":[{"Type":"NodeText","Data":"橘皮，花开于夏，实成于秋，得火气少金气多，故味辛苦、气温、无毒。味薄气浓，降多升少，阳中之阴也。入手足太阴、足阳明经。其主胸中瘕热逆气，气冲胸中呕咳者，以肺主气，气常则顺，气变则逆，逆则热聚于胸中而成瘕，瘕者假也，假物象形，如痞满郁闷之类也，辛散苦泄温能通行，则气利而瘕热，诸症消矣。脾为运动磨物之脏，气滞则不能消化水谷，为吐逆霍乱泻泄等症，苦温能燥脾家之湿，使滞气运行，霍乱诸症自平矣。肺为运之上源，肺得所养，津液贯输，气化运动，故膀胱留热停水，五淋皆通也。去臭下气及寸白虫，辛能散邪苦能杀虫也。橘核味苦温而下气，所以入肾与膀胱，除因寒所生之病，凡腰痛肾冷膀胱气疝，诸方中必用之药。橘叶能散阳明厥阴经滞气，故妇人妒乳，内外吹，乳岩乳痈用之皆效。一方治妇人乳痈，未成者，即散，已成者即溃，痛极者不痛，神验。用真橘皮汤浸去白面，炒微黄为末，每服二钱属香油下，初发一服即效，总皆散结之功也。"}]},{"ID":"20240617112515-w88ge5r","Type":"NodeParagraph","Properties":{"id":"20240617112515-w88ge5r","updated":"20240617112515"},"Children":[{"Type":"NodeText","Data":"陈皮，气味辛烈，凡青皮治低，陈皮治高，痰实气壅者服妙，然留白则补胃和中，而理脾，去白则消痰利滞而理肺，脾为元气之母，肺为摄气之龠，故专调诸气不离二经。君白术则益脾，单则损脾，佐甘草则补肺，否则泻肺，同竹茹治呃逆因热，同干姜治呃逆因寒，止香港脚冲心，除膀胱留热，利水道通五淋，消酒毒去寸白，消食消痰，开胃下气，霍乱吐泻，能温能补能和，功在诸药之上，同补气药则益气，同泄气药则破气，同消痰药则去痰，同消食药则化食，各从其类以为用也。"}]},{"ID":"20240617112515-q4rcdib","Type":"NodeParagraph","Properties":{"id":"20240617112515-q4rcdib","updated":"20240617112515"},"Children":[{"Type":"NodeText","Data":"核研调酒饮，腰痛疝痛神丹。叶引经以肝气行，散乳痈胁痈圣药。肉生痰聚气。"}]},{"ID":"20240617112515-167jdcj","Type":"NodeParagraph","Properties":{"id":"20240617112515-167jdcj","updated":"20240617112515"},"Children":[{"Type":"NodeText","Data":"主治（痘疹合参） 健脾温中，消食化痰，同参 散滞气，痘始终俱用，但气虚症候，兼在灌浆之时，不可过多。若自汗吐血气弱，皆所禁用，以其辛散走泄也。"}]},{"ID":"20240617112352-bbctazv","Type":"NodeThematicBreak","Properties":{"id":"20240617112352-bbctazv"}},{"ID":"20240617112354-uxgzqk5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617112354-uxgzqk5","updated":"20240617112357"},"Children":[{"Type":"NodeText","Data":"陈皮《汤液本草》"}]},{"ID":"20240617112354-v1cacen","Type":"NodeParagraph","Properties":{"id":"20240617112354-v1cacen","updated":"20240617112354"},"Children":[{"Type":"NodeText","Data":"气温，味微苦。辛而苦，味浓，阴也。无毒。"}]},{"ID":"20240617112354-hyth11m","Type":"NodeParagraph","Properties":{"id":"20240617112354-hyth11m","updated":"20240617112354"},"Children":[{"Type":"NodeText","Data":"《象》云∶能益气，加青皮，减半，去滞气，推陈致新。若补脾胃，不去白；若调理胸中肺气，须去白。"}]},{"ID":"20240617112354-xpihhhk","Type":"NodeParagraph","Properties":{"id":"20240617112354-xpihhhk","updated":"20240617112354"},"Children":[{"Type":"NodeText","Data":"《心》云∶导胸中滞气，除客气。有白术，则补脾胃；无白术，则泻脾胃。然勿多用也。"}]},{"ID":"20240617112354-kbsp06p","Type":"NodeParagraph","Properties":{"id":"20240617112354-kbsp06p","updated":"20240617112354"},"Children":[{"Type":"NodeText","Data":"《珍》云∶益气利肺。有甘草，则补肺；无甘草，则泻肺。"}]},{"ID":"20240617112354-uftet6q","Type":"NodeParagraph","Properties":{"id":"20240617112354-uftet6q","updated":"20240617112354"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主胸中痰热、逆气，利水谷。下气，止呕咳。除膀胱留热、停水、五淋，利小便。主脾不能消谷，气冲胸中，吐逆霍乱。止泻，去寸白虫。能除痰，解酒毒。海藏治酒毒，葛根陈皮茯苓甘草生姜汤。手太阴气逆，上而不下，宜以此顺之。陈皮、白檀为之使。其芳香之气，清奇之味，可以夺橙也。"}]},{"ID":"20240607152407-3sh88ad","Type":"NodeThematicBreak","Properties":{"id":"20240607152407-3sh88ad"}},{"ID":"20240607152423-0kwh222","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240607152423-0kwh222","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"橘皮"}]},{"ID":"20240607152423-diaeihy","Type":"NodeParagraph","Properties":{"id":"20240607152423-diaeihy","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607152423-4j3tusv","Type":"NodeParagraph","Properties":{"id":"20240607152423-4j3tusv","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" Jú Pí"}]},{"ID":"20240607152423-hqdtzch","Type":"NodeParagraph","Properties":{"id":"20240607152423-hqdtzch","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607152423-acsijmv","Type":"NodeParagraph","Properties":{"id":"20240607152423-acsijmv","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 陈皮（孟诜），贵老（侯宁极《药谱》），黄橘皮（《鸡峰普济方》），红皮（《汤液本草》）。"}]},{"ID":"20240607152423-5rhxnfx","Type":"NodeParagraph","Properties":{"id":"20240607152423-5rhxnfx","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240607152423-eq6fxr9","Type":"NodeParagraph","Properties":{"id":"20240607152423-eq6fxr9","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240607152423-hn33dc2","Type":"NodeParagraph","Properties":{"id":"20240607152423-hn33dc2","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607152423-y2zx9ge","Type":"NodeParagraph","Properties":{"id":"20240607152423-y2zx9ge","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"福橘"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"朱橘"},{"Type":"NodeText","Data":"等多种橘类的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果皮"},{"Type":"NodeText","Data":"。10月以后采摘成熟果实，剥取果皮，阴干或晒干。"}]},{"ID":"20240607152423-reaw07l","Type":"NodeParagraph","Properties":{"id":"20240607152423-reaw07l","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240607152423-nt0ely5","Type":"NodeParagraph","Properties":{"id":"20240607152423-nt0ely5","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 主产四川、浙江、福建。此外，江西、湖南等地亦产。"}]},{"ID":"20240607152423-01yn8ts","Type":"NodeParagraph","Properties":{"id":"20240607152423-01yn8ts","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607152423-a4t6lsb","Type":"NodeParagraph","Properties":{"id":"20240607152423-a4t6lsb","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 完整的果皮常剖成4瓣，每瓣多呈椭圆形，在果柄处连在一起。有时破碎分离，或呈不规则形的碎片状。片厚1～2毫米，通常向内眷曲：外表面鲜橙红色、黄棕色至棕褐色，有无数细小而凹入的油室；内表面淡黄白色，海绵状，并有短线状的维管束（橘络）痕，果蒂处较密。质柔软，干燥后质脆，易折断，断面不平。气芳香，味苦。以皮薄、片大、色红、油润、香气浓者为佳。"}]},{"ID":"20240607152423-b7f300m","Type":"NodeParagraph","Properties":{"id":"20240607152423-b7f300m","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240607152423-lsvdz87","Type":"NodeParagraph","Properties":{"id":"20240607152423-lsvdz87","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 福橘果皮含挥发油，其中主要为柠檬烯。"}]},{"ID":"20240607152423-yv8h380","Type":"NodeParagraph","Properties":{"id":"20240607152423-yv8h380","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"温州蜜橘果皮亦含挥发油，油中含异丙烯基甲苯、δ-榄香烯、α-玷巴烯、α-葎草烯、β-葎草烯、β-倍半水芹烯、乙酸-α-葎草烯醇酯和甜香味极佳的乙酸孟二烯-1，8-醇-10-酯。果皮中另含橙皮甙、胡萝卜素1毫克、隐黄素12毫克、维生素C150毫克、维生素B1_76微克％和果胶。"}]},{"ID":"20240607152423-lc6fdm7","Type":"NodeParagraph","Properties":{"id":"20240607152423-lc6fdm7","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"各种橘皮均含挥发油，且多含黄酮甙（如橙皮甙）等成分。"}]},{"ID":"20240607152423-boyvpyu","Type":"NodeParagraph","Properties":{"id":"20240607152423-boyvpyu","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240607152423-6ma2wnv","Type":"NodeParagraph","Properties":{"id":"20240607152423-6ma2wnv","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" ①对心血管的作用"}]},{"ID":"20240607152423-yny9pas","Type":"NodeParagraph","Properties":{"id":"20240607152423-yny9pas","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"小量陈皮煎剂使离体及在位蟾蜍心脏收缩力增强，输出量增加，对心率影响不大，加大剂量则出现心脏抑制，离体兔心灌流可使冠状血管扩张，蟾蜍全身灌流使流量减少，陈皮煎剂静脉注射可使犬肾容积减小，肾血管收缩，尿量减少，对犬及兔可使动脉压上升，在血压恢复后有短时间的下降现象，其作用与肾上腺素极为相似，反复用药亦不产生耐受性。"}]},{"ID":"20240607152423-j4h8683","Type":"NodeParagraph","Properties":{"id":"20240607152423-j4h8683","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"陈皮中含有橙皮甙，能使兔耳灌流量增加，可拮抗肾上腺素引起的血管收缩。人工合成的甲基橙皮甙，为多种双氢黄酮型及查耳酮型的甲基橙皮甙混合物，降低血管通透性的效力较其他黄酮甙强，对狗冠状血管有扩张作用，在心肺装置及离体兔心灌流实验上，不影响心收缩力及心率，但整体实验时由于血压下降可引起反射性心率加速，0.5～1毫克的甲基橙皮甙对离体兔心的冠状血管扩张作用为茶碱效力的1/2～1/4，但持续时间较久，剂量增至10毫克时，对冠状血管的扩张作用增强，对心收缩力及心率仍无影响。对麻醉兔、猫、犬静脉注射有缓慢的降压作用，其降压原理是由于直接作用于血管平滑肌。研究甲基橙皮甙混合物中的各单体，对家兔的降压作用，离体兔心冠状血管扩张作用，动物在位后胺灌流（股动脉注射）增加流量的作用，以双氢黄酮型的3’-甲基-7-鼠李糖-2-甲基葡萄糖-橙皮素作用最强。"}]},{"ID":"20240607152423-y7pe640","Type":"NodeParagraph","Properties":{"id":"20240607152423-y7pe640","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②对平滑肌的作用"}]},{"ID":"20240607152423-wiwhm2u","Type":"NodeParagraph","Properties":{"id":"20240607152423-wiwhm2u","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"陈皮煎剂对家兔及小白鼠离体肠管，麻醉兔、犬之在位胃及肠运动，小白鼠离体子宫均表现抑制，对麻醉兔在位子宫则呈强直性收缩，其作用与肾上腺素相似。甲基橘皮甙对豚鼠、家兔的肠管、气管、子宫及大白鼠胸部主动脉片均有松弛作用，但作用较弱，为罂粟碱的1/100以下。"}]},{"ID":"20240607152423-gl52k74","Type":"NodeParagraph","Properties":{"id":"20240607152423-gl52k74","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③抗炎、抗溃疡、利胆作用"}]},{"ID":"20240607152423-ci3qxph","Type":"NodeParagraph","Properties":{"id":"20240607152423-ci3qxph","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"橙皮甙不能减轻大鼠后肢脚爪因甲醛引起的浮肿，柑橘属植物中顺式香豆素则有抗炎作用。甲基橙皮甙（以二氢黄酮型为主的混合物）对毛细管的通透性（家兔氯仿法及小白鼠蛇毒法）也有抑制作用，并能防止蛇毒引起的出血，在甲基橙皮甙单体中，3’-甲基-7-鼠李糖-2-甲基葡萄糖-橙皮素抗炎作用最强，毒性最低。甲基橙皮甙对结扎幽门引起的大白鼠溃疡，有明显的抗溃疡作用，与维生素C及K合用能增强其效力，口服则无效，给大白鼠腹腔注射，迅速表现利胆作用，维生素C及K亦可增强此作用。"}]},{"ID":"20240607152423-ezilyky","Type":"NodeParagraph","Properties":{"id":"20240607152423-ezilyky","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240607152423-rt5tzfu","Type":"NodeParagraph","Properties":{"id":"20240607152423-rt5tzfu","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"橙皮甙对大白鼠分别饲以\"致血栓塞\"及\"致动脉粥样硬化\"的饮食，能延长其存活时间。用氯乙烷喷射法在家兔耳部造成的人工冻伤，在冻伤前或后连续给予橙皮甙可减轻冻伤症状，并用维生素C不能增强其预防冻伤的效果。广陈皮在试管内能抑制葡萄球菌、卡他奈氏菌、溶血性嗜血杆菌的生长，陈皮与小叶榕的合剂在试管内亦有抑菌作用。陈皮、干姜煎剂（1：1）对洋地黄引起的鸽呕吐无镇吐作用。研究中药中治疗脚气病的药物，发现陈皮（蕉柑的果皮）及广陈皮（甜橙的果皮）中含有大量维生素B1。前者每100克生药中含65微克，后者约100微克。"}]},{"ID":"20240607152423-vrz58c3","Type":"NodeParagraph","Properties":{"id":"20240607152423-vrz58c3","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607152423-mk6tcqf","Type":"NodeParagraph","Properties":{"id":"20240607152423-mk6tcqf","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 刷去泥土，拣净杂质，喷淋清水，闷润后切丝或切片，晾干。"}]},{"ID":"20240607152423-23s3h9e","Type":"NodeParagraph","Properties":{"id":"20240607152423-23s3h9e","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607152423-6tae1a5","Type":"NodeParagraph","Properties":{"id":"20240607152423-6tae1a5","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 入脾、肺经。"}]},{"ID":"20240607152423-cnxhcf3","Type":"NodeParagraph","Properties":{"id":"20240607152423-cnxhcf3","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"①《品汇精要》：\"行手太阴、足太阴经。\""}]},{"ID":"20240607152423-e6ifi6f","Type":"NodeParagraph","Properties":{"id":"20240607152423-e6ifi6f","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、肝、脾、胃四经。\""}]},{"ID":"20240607152423-fylqphc","Type":"NodeParagraph","Properties":{"id":"20240607152423-fylqphc","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入脾、大肠。\""}]},{"ID":"20240607152423-c3zmsmk","Type":"NodeParagraph","Properties":{"id":"20240607152423-c3zmsmk","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607152423-mu9at2t","Type":"NodeParagraph","Properties":{"id":"20240607152423-mu9at2t","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 辛苦，温。"}]},{"ID":"20240607152423-3f4mlqn","Type":"NodeParagraph","Properties":{"id":"20240607152423-3f4mlqn","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240607152423-j7zzlkh","Type":"NodeParagraph","Properties":{"id":"20240607152423-j7zzlkh","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240607152423-53ao4md","Type":"NodeParagraph","Properties":{"id":"20240607152423-53ao4md","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③崔禹锡《食经》：\"味辛苦。\""}]},{"ID":"20240607152423-epzbies","Type":"NodeParagraph","Properties":{"id":"20240607152423-epzbies","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240607152423-sly3eoj","Type":"NodeParagraph","Properties":{"id":"20240607152423-sly3eoj","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 气虚及阴虚燥咳患者不宜。吐血证慎服。"}]},{"ID":"20240607152423-q3xy75c","Type":"NodeParagraph","Properties":{"id":"20240607152423-q3xy75c","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"①《本草经疏》：\"中气虚，气不归元者，忌与耗气药同用；胃虚有火呕吐，不宜与温热香燥药同用；阴虚咳嗽生痰，不宜与半夏、南星等同用；疟非寒甚者，亦勿使。\""}]},{"ID":"20240607152423-6qocz6i","Type":"NodeParagraph","Properties":{"id":"20240607152423-6qocz6i","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"亡液之证，自汗之证，元虚之人，吐血之证不可用。\""}]},{"ID":"20240607152423-3tpc8lp","Type":"NodeParagraph","Properties":{"id":"20240607152423-3tpc8lp","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③《本草从新》：\"无滞勿用。\""}]},{"ID":"20240607152423-3ijztf6","Type":"NodeParagraph","Properties":{"id":"20240607152423-3ijztf6","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"④《得配本草》：\"痘疹灌浆时禁用。\""}]},{"ID":"20240607152423-3l6h90b","Type":"NodeParagraph","Properties":{"id":"20240607152423-3l6h90b","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607152423-n6s1qhq","Type":"NodeParagraph","Properties":{"id":"20240607152423-n6s1qhq","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 理气，调中，燥湿，化痰。治胸腹胀满，不思饮食，呕吐哕逆，咳嗽痰多。亦解鱼、蟹毒。"}]},{"ID":"20240607152423-jmd13ov","Type":"NodeParagraph","Properties":{"id":"20240607152423-jmd13ov","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主胸中瘕热、逆气，利水谷，久服去臭，下气。\""}]},{"ID":"20240607152423-yer23kt","Type":"NodeParagraph","Properties":{"id":"20240607152423-yer23kt","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"下气，止呕咳，除膀胱留热、停水、五琳，利小便，主脾不能消谷，气冲胸中，吐逆霍乱，止泄，去寸白。\""}]},{"ID":"20240607152423-u1ebo6c","Type":"NodeParagraph","Properties":{"id":"20240607152423-u1ebo6c","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治胸膈间气，开胃，主气痢，消痰涎，治上气咳嗽。\""}]},{"ID":"20240607152423-k8oqhwz","Type":"NodeParagraph","Properties":{"id":"20240607152423-k8oqhwz","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"去气，调中。\""}]},{"ID":"20240607152423-ap0bj2a","Type":"NodeParagraph","Properties":{"id":"20240607152423-ap0bj2a","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"消痰止嗽，破症瘕痃癣。\""}]},{"ID":"20240607152423-t37tkyr","Type":"NodeParagraph","Properties":{"id":"20240607152423-t37tkyr","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑥《医学启源》：\"去胸中寒邪，破滞气，益脾胃。\""}]},{"ID":"20240607152423-2c459jp","Type":"NodeParagraph","Properties":{"id":"20240607152423-2c459jp","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"疗呕哕反胃嘈杂，时吐清水，痰痞，痎疟，大肠闭塞，妇人乳痈。入食料解鱼腥毒。\""}]},{"ID":"20240607152423-shuq1cl","Type":"NodeParagraph","Properties":{"id":"20240607152423-shuq1cl","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑧《随息居饮食谱》：\"解鱼、蟹毒。治噫噎，胀闷，疳疟。泻痢，便秘，脚气。\""}]},{"ID":"20240607152423-rzifly9","Type":"NodeParagraph","Properties":{"id":"20240607152423-rzifly9","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607152423-8881ife","Type":"NodeParagraph","Properties":{"id":"20240607152423-8881ife","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。"}]},{"ID":"20240607152423-d2o6877","Type":"NodeParagraph","Properties":{"id":"20240607152423-d2o6877","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240607152423-oq44q72","Type":"NodeParagraph","Properties":{"id":"20240607152423-oq44q72","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" ①治脾胃不调，冷气暴折，客乘于中，寒则气收聚，聚则壅遏不通，是以胀满，其脉弦迟：黄橘皮四两，白术二两。上为细末，酒糊和丸如桐子大，煎木香汤下三十丸，食前。（《鸡蜂普济方》宽中丸）"}]},{"ID":"20240607152423-jo8fh0z","Type":"NodeParagraph","Properties":{"id":"20240607152423-jo8fh0z","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②治胸痹，胸中气塞短气：橘皮一斤，枳实三两，生姜半斤。上三味，以水五升，煮取二升，分温再服。（橘皮枳实生姜汤）"}]},{"ID":"20240607152423-q0ioyjq","Type":"NodeParagraph","Properties":{"id":"20240607152423-q0ioyjq","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③治干呕哕，手足厥者：橘皮四两，生姜半斤。上二味，以水七升，煮取三升，温服一升。（橘皮汤）"}]},{"ID":"20240607152423-i5kwxhe","Type":"NodeParagraph","Properties":{"id":"20240607152423-i5kwxhe","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"④治哕逆：橘皮二升，竹茹二升，大枣三十枚，生姜半斤，甘草五两，人参一两。上六味，以水一斗，煮取三升，温服一升，日三服。（橘皮竹茹汤。②方以下出《金匮要略》）"}]},{"ID":"20240607152423-3spcqvj","Type":"NodeParagraph","Properties":{"id":"20240607152423-3spcqvj","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑤治反胃吐食：真橘皮，以壁土炒香为末，每服二钱，生姜三片，枣肉一枚，水二钟，煎一钟，温服。（《仁斋直指方》）"}]},{"ID":"20240607152423-cvam7xs","Type":"NodeParagraph","Properties":{"id":"20240607152423-cvam7xs","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑥治痰膈气胀：陈皮三钱。水煎热服。（《简便单方》）"}]},{"ID":"20240607152423-c8k2nsy","Type":"NodeParagraph","Properties":{"id":"20240607152423-c8k2nsy","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑦治大便秘结：陈皮（不去白，酒浸）煮至软，焙干为末，复以温酒调服二钱。（《普济方》）"}]},{"ID":"20240607152423-wvd911k","Type":"NodeParagraph","Properties":{"id":"20240607152423-wvd911k","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑧治卒食噎：橘皮一两（汤浸去瓤）。焙为末，以水一大盏，煎取半盏，热服。（《食医心镜》）"}]},{"ID":"20240607152423-qiri0sv","Type":"NodeParagraph","Properties":{"id":"20240607152423-qiri0sv","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑨治疳瘦：陈橘皮一两，黄连一两五钱（去须，米泔浸一日）。上为细末，研入麝香五分，用猪胆七个，分药入在胆内，浆水煮，候临熟，以针微扎破，以熟为度，取出以粟米粥和丸绿豆大，每服十丸至二、三十丸，米饮下，量儿大小与之，无时。久服消食和气，长肌肉。（《小儿药证直诀》橘连丸）"}]},{"ID":"20240607152423-oa9xy0a","Type":"NodeParagraph","Properties":{"id":"20240607152423-oa9xy0a","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑩治产后吹奶：陈皮一两，甘草一钱。水煎服，即散。（《纲目》）"}]},{"ID":"20240607152423-n0ksqfi","Type":"NodeParagraph","Properties":{"id":"20240607152423-n0ksqfi","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑾治鱼骨鲠在喉中：常含橘皮即下。（《圣惠方》）"}]},{"ID":"20240607152423-ypw1ly4","Type":"NodeParagraph","Properties":{"id":"20240607152423-ypw1ly4","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240607152423-q8xif1l","Type":"NodeParagraph","Properties":{"id":"20240607152423-q8xif1l","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 治疗急性乳腺炎:取陈皮1两，甘草2钱，每日1剂，煎服2次；严重者可每日2剂，煎服4次。据临床观察，发病在1～2天内治疗者，大都获得良好效果，治愈率在70％以上.一般2～3天即愈。发病时间愈长，疗效愈差。已化脓者无效。"}]},{"ID":"20240607152423-49gthgp","Type":"NodeParagraph","Properties":{"id":"20240607152423-49gthgp","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240607152423-l7tcm68","Type":"NodeParagraph","Properties":{"id":"20240607152423-l7tcm68","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" ①《医学启源》：\"橘皮能益气，加青皮减半，去滞气，推陈致新。若补脾胃，不去白，若理胸中滞气，去包。《主治秘要》云，苦辛益气，利肺，有甘草则补肺，无则泻肺。\""}]},{"ID":"20240607152423-s7vy5lx","Type":"NodeParagraph","Properties":{"id":"20240607152423-s7vy5lx","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"②《日用本草》：\"橘皮，能散能泻，能温能补，能消膈气，化痰涎，和脾止嗽，通五淋。中酒呕吐恶心，煎饮之效。\""}]},{"ID":"20240607152423-ggmtl3f","Type":"NodeParagraph","Properties":{"id":"20240607152423-ggmtl3f","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"橘皮，苦能泻能燥，辛能散，温能和。其治百病，总是取其理气噪湿之功，同补药则补，同泻药则泻，同升药则升，同降药则降。脾乃元气之母，肺乃摄气之钥，故橘皮为二经气分之药，但随所配市补泻升降也。洁古张氏云，陈皮、枳壳，利其气而痰自下，盖此义也。同杏仁治大肠气闷，同桃仁治大肠血閟，皆取其通滞也。按方勺《泊宅编》云，橘皮宽膈降气、消痰饮极有殊功。他药贵新，惟此贵陈。\""}]},{"ID":"20240607152423-vf4tvkh","Type":"NodeParagraph","Properties":{"id":"20240607152423-vf4tvkh","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"橘皮，主胸中瘕热逆气，气冲胸中呕咳者，以肺主气，气常则顺，气变则逆，逆则热聚于胸中而成瘕，瘕者假也，如痞满郁闷之类也，辛能散，苦能泄，温能通行，则逆气下，呕咳止，胸中瘕热消矣。脾为运动磨物主脏，气滞则不能消化水谷，为吐逆、霍乱、泄泻等证，苦温能燥脾家之湿，使滞气运行，诸证自瘳矣。肺为水之上源，源竭则下流不利，热结膀胱，肺得所养而津液贯输，气化运动，故膀胱留热，停水、五淋皆通也。去臭及寸白者，辛能散邪，苦能杀虫也。\""}]},{"ID":"20240607152423-exx9kqe","Type":"NodeParagraph","Properties":{"id":"20240607152423-exx9kqe","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑤《木草正》：\"陈皮，气实痰滞必用。留白者微甘而性缓，去白者用辛而性速。\""}]},{"ID":"20240607152423-22fg1ps","Type":"NodeParagraph","Properties":{"id":"20240607152423-22fg1ps","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑥《本草汇言》：\"顾朽匏曰，橘皮总属理气之珍，若霍乱呕吐，气之逆也：泄泻下利，气之寒也；关格中满，气之闭也；食积痰涎，气之滞也；风寒暑湿，气之搏也；七情之部，气之结也；橘皮统能治之。其去白开痰，留白和脾。盖味辛善散，故能开气；味苦善泄，故能行痰；其气温平，善于通达，故能止呕、止咳，健胃和脾者也。东垣曰，夫人以脾胃为主，而治病以调气为先，如欲调气健脾者，橘皮之功居其首焉。然君白术则益脾，单则利脾，佐甘草则和气，否则损气。同竹茹、芩、连治呃逆，因热也：同干姜、桂、附治呃逆，因寒也。补中用之以益气，二陈用之以除痰，干葛用之以清胃解酲，平胃用之以消食去湿。\""}]},{"ID":"20240607152423-ua6kn4c","Type":"NodeParagraph","Properties":{"id":"20240607152423-ua6kn4c","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑦《本草崇原》：\"按上古诸方，止曰橘皮个用不切，并无去白之说，李东垣不参经义，不体物性，承雷孜炮制，谓留白则理脾健胃，去白则消痰止嗽。后人习以为法，每用橘红治虚劳咳嗽。……若去其白，其味但辛，止行皮毛，风寒咳嗽，似乎相宜，虚劳不足，益辛散矣。\""}]},{"ID":"20240607152423-s6aa2yb","Type":"NodeParagraph","Properties":{"id":"20240607152423-s6aa2yb","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑧《本草经百种录》：\"橘柚通体皆香，而皮辛肉酸，乃肝胆通气之药也。故凡肝气不舒，克贼脾土之痴，皆能已之。\""}]},{"ID":"20240607152423-pc3n8mo","Type":"NodeParagraph","Properties":{"id":"20240607152423-pc3n8mo","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑨《医林纂要》：\"橘皮，上则泻肺邪，降逆气；中则燥脾湿，和中气；下则舒肝木，润肾命。主于顺气、消痰、去郁。\""}]},{"ID":"20240607152423-5n0y53i","Type":"NodeParagraph","Properties":{"id":"20240607152423-5n0y53i","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"⑩《本草求真》：\"橘皮，利气，虽有类于青皮，但此气味辛温，则入脾、肺而宣壅，不如青皮考入肝疏泄，而无入脾燥湿，入肺理气之故也。……治火痰童便制，寒痰姜汁制，治下焦盐水制。\""}]},{"ID":"20240607152423-56jh738","Type":"NodeParagraph","Properties":{"id":"20240607152423-56jh738","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240607152423-h1wl6xz","Type":"NodeParagraph","Properties":{"id":"20240607152423-h1wl6xz","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 橘皮药材，除上述橘类的果皮外，柑类及甜橙的果皮，有时亦作橘皮使用，商品名前者习称\"广陈皮\"，参见\"柑皮\"条；后者习称\"土陈皮\"，参见\"橙皮\"条。"}]},{"ID":"20240607152423-qcioyof","Type":"NodeParagraph","Properties":{"id":"20240607152423-qcioyof","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607152423-xt5then","Type":"NodeParagraph","Properties":{"id":"20240607152423-xt5then","updated":"20240607152423"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240607152325-n4r3bmo","Type":"NodeThematicBreak","Properties":{"id":"20240607152325-n4r3bmo"}},{"ID":"20240607152403-dc30sbh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607152403-dc30sbh","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"陈皮"}]},{"ID":"20240607152403-7lxmt1c","Type":"NodeParagraph","Properties":{"id":"20240607152403-7lxmt1c","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240607152403-10qbgb6","Type":"NodeParagraph","Properties":{"id":"20240607152403-10qbgb6","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" Chén Pí"}]},{"ID":"20240607152403-uj4ugjb","Type":"NodeParagraph","Properties":{"id":"20240607152403-uj4ugjb","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240607152403-m419k0g","Type":"NodeParagraph","Properties":{"id":"20240607152403-m419k0g","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 橘皮"}]},{"ID":"20240607152403-apx15xg","Type":"NodeParagraph","Properties":{"id":"20240607152403-apx15xg","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240607152403-mna5gow","Type":"NodeParagraph","Properties":{"id":"20240607152403-mna5gow","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" PERICARPIUM CITRI RETICULATAE"}]},{"ID":"20240607152403-5o0bae7","Type":"NodeParagraph","Properties":{"id":"20240607152403-5o0bae7","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240607152403-p1pmr88","Type":"NodeParagraph","Properties":{"id":"20240607152403-p1pmr88","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 本品为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"橘"},{"Type":"NodeText","Data":"Citrus reticulata Blanco 及其栽培变种的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果皮"},{"Type":"NodeText","Data":"。药材分为“陈皮”和“广陈皮”。采摘成熟果实，剥取果皮，晒干或低温干燥。"}]},{"ID":"20240607152403-djwc3la","Type":"NodeParagraph","Properties":{"id":"20240607152403-djwc3la","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240607152403-ppon9g1","Type":"NodeParagraph","Properties":{"id":"20240607152403-ppon9g1","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 陈皮：常剥成数瓣，基部相连，有的呈不规则的片状，厚1～4mm。外表面橙红色或红棕色，有细皱纹及凹下的点状油室；内表面浅黄白色，粗糙，附黄白色或黄棕色筋络状维管束。质稍硬而脆。气香，味辛、苦。"}]},{"ID":"20240607152403-tz9nkae","Type":"NodeParagraph","Properties":{"id":"20240607152403-tz9nkae","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"广陈皮：常3瓣相连，形状整齐，厚度均匀，约1mm。点状油室较大，对光照视，透明清晰。质较柔软。"}]},{"ID":"20240607152403-mh0fcom","Type":"NodeParagraph","Properties":{"id":"20240607152403-mh0fcom","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240607152403-s9oonrt","Type":"NodeParagraph","Properties":{"id":"20240607152403-s9oonrt","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防霉，防蛀。"}]},{"ID":"20240607152403-9dwclev","Type":"NodeParagraph","Properties":{"id":"20240607152403-9dwclev","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240607152403-pyu3k26","Type":"NodeParagraph","Properties":{"id":"20240607152403-pyu3k26","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 除去杂质，喷淋水，润透，切丝，阴干。"}]},{"ID":"20240607152403-ojajv16","Type":"NodeParagraph","Properties":{"id":"20240607152403-ojajv16","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240607152403-gu2yvum","Type":"NodeParagraph","Properties":{"id":"20240607152403-gu2yvum","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" （1）本品粉末黄白色至黄棕色。中果皮薄壁组织众多，细胞形状不规则，壁不均匀增厚，有的作连珠状。果皮表皮细胞表面观多角形、类方形或长方形，垂周壁增厚，气孔类圆形，直径18～26μｍ，副卫细胞不清晰；侧面观外被角质层，靠外方的径向壁增厚。草酸钙方晶成片存在于中果皮薄壁细胞中，呈多面形、菱形或双锥形，直径3～34μm，长5～53μm，有的一个细胞内含有由两个多面体构成的平行双晶或3～5个方晶。橙皮苷结晶大多存在于薄壁细胞中，黄色或无色，呈圆形或无定形团块，有的可见放射状条纹。螺纹、孔纹和网纹导管及管胞较小。"}]},{"ID":"20240607152403-95yugzu","Type":"NodeParagraph","Properties":{"id":"20240607152403-95yugzu","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末0.3g，加甲醇10ml，加热回流20分钟，滤过，取滤液5ml，浓缩至约1ml，作为供试品溶液。另取橙皮苷对照品，加甲醇制成饱和溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一用0.5％氢氧化钠溶液制备的硅胶Ｇ薄层板上，以醋酸乙酯－甲醇－水（100:17:13）为展开剂，展开约3cm，取出，晾干，再以甲苯－醋酸乙酯－甲酸－水（20:10:1:1）的上层溶液为展开剂，展至约 8cm，取出，晾干，喷以三氯化铝试液，置紫外光灯（365nm）下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240607152403-pzwgmuh","Type":"NodeParagraph","Properties":{"id":"20240607152403-pzwgmuh","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240607152403-i79gisz","Type":"NodeParagraph","Properties":{"id":"20240607152403-i79gisz","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 归肺、脾经。"}]},{"ID":"20240607152403-tip33ev","Type":"NodeParagraph","Properties":{"id":"20240607152403-tip33ev","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240607152403-och87zk","Type":"NodeParagraph","Properties":{"id":"20240607152403-och87zk","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 苦、辛，温。"}]},{"ID":"20240607152403-wxexwj4","Type":"NodeParagraph","Properties":{"id":"20240607152403-wxexwj4","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240607152403-aufs597","Type":"NodeParagraph","Properties":{"id":"20240607152403-aufs597","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 理气健脾，燥湿化痰。用于胸脘胀满，食少吐泻，咳嗽痰多。"}]},{"ID":"20240607152403-mo6km7m","Type":"NodeParagraph","Properties":{"id":"20240607152403-mo6km7m","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240607152403-3p7jilf","Type":"NodeParagraph","Properties":{"id":"20240607152403-3p7jilf","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240607152403-vmsovmg","Type":"NodeParagraph","Properties":{"id":"20240607152403-vmsovmg","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240607152403-hm961kn","Type":"NodeParagraph","Properties":{"id":"20240607152403-hm961kn","updated":"20240607152403"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240607152404-uhbtmvp","Type":"NodeThematicBreak","Properties":{"id":"20240607152404-uhbtmvp"}},{"ID":"20240607152405-xe296w7","Type":"NodeParagraph","Properties":{"id":"20240607152405-xe296w7"}}]}