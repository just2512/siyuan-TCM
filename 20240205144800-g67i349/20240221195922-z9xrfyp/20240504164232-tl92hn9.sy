{"ID":"20240504164232-tl92hn9","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164232-tl92hn9","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164232-tl92hn9\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504164232-24veqlk\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240617111458-8dg0rnd\u0026quot;,\u0026quot;scrollTop\u0026quot;:2015,\u0026quot;focusId\u0026quot;:\u0026quot;20240617111457-dwzqcmq\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"109木兰（木兰皮）","type":"doc","updated":"20240811141943"},"Children":[{"ID":"20240811101202-3nj2d2f","Type":"NodeParagraph","Properties":{"id":"20240811101202-3nj2d2f","updated":"20240811141258"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰-20240811101203-tfn6o0o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811141109-76n7hhi","Type":"NodeParagraph","Properties":{"id":"20240811141109-76n7hhi","updated":"20240811141916"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 629px;","style":"width: 619px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 13-20240811141906-jwqd5ge.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 619px;\" parent-style=\"width: 629px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 561px;","style":"width: 551px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 11-20240811141109-3vvvtw7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 551px;\" parent-style=\"width: 561px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811141140-zwu9gl4","Type":"NodeParagraph","Properties":{"id":"20240811141140-zwu9gl4","updated":"20240811141207"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 608px;","style":"width: 598px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 12-20240811141207-qrczkrv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 598px;\" parent-style=\"width: 608px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 594px;","style":"width: 584px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 10-20240811135152-cd5h3w5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 584px;\" parent-style=\"width: 594px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811134937-7gk9xn3","Type":"NodeParagraph","Properties":{"id":"20240811134937-7gk9xn3","updated":"20240811135007"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 799px;","style":"width: 789px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 7-20240811134937-vuo0tfs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 789px;\" parent-style=\"width: 799px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 404px;","style":"width: 394px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 8-20240811135007-u77n40l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 394px;\" parent-style=\"width: 404px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811135040-bug3ygr","Type":"NodeParagraph","Properties":{"id":"20240811135040-bug3ygr","updated":"20240811135040"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1203px;","style":"width: 1193px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 9-20240811135040-w1rjl69.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1193px;\" parent-style=\"width: 1203px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811140123-sbnmfe3","Type":"NodeParagraph","Properties":{"id":"20240811140123-sbnmfe3","updated":"20240811140123"}},{"ID":"20240811140123-iq17jb7","Type":"NodeParagraph","Properties":{"id":"20240811140123-iq17jb7","updated":"20240811140128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"木兰、玉兰对比"}]},{"ID":"20240811140148-1cuj7is","Type":"NodeParagraph","Properties":{"id":"20240811140148-1cuj7is","updated":"20240811140501"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 565px;","style":"width: 555px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 玉兰对比"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 玉兰对比-20240811140454-l4s2r4l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 555px;\" parent-style=\"width: 565px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811140605-3o5zagb","Type":"NodeParagraph","Properties":{"id":"20240811140605-3o5zagb","updated":"20240811140605"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 567px;","style":"width: 557px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 玉兰对比 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 玉兰对比 1-20240811140605-qfnl7b3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 557px;\" parent-style=\"width: 567px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240811140245-zshvpjd","Type":"NodeParagraph","Properties":{"id":"20240811140245-zshvpjd","updated":"20240811140707"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 565px;","style":"width: 555px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"木兰 玉兰对比 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/木兰 玉兰对比 2-20240811140701-78zm8e9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 555px;\" parent-style=\"width: 565px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240607151550-9loylsa","Type":"NodeParagraph","Properties":{"id":"20240607151550-9loylsa","updated":"20240811141943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：木兰取图较难，如有错误烦请指正；"}]},{"ID":"20240607151550-jsonvb0","Type":"NodeThematicBreak","Properties":{"id":"20240607151550-jsonvb0"}},{"ID":"20240607151600-el4crgw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151600-el4crgw","updated":"20240607151607"},"Children":[{"Type":"NodeText","Data":"木兰《神农本草经》"}]},{"ID":"20240607151600-mzoit3b","Type":"NodeParagraph","Properties":{"id":"20240607151600-mzoit3b","updated":"20240607151600"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240607151600-efz5cqq","Type":"NodeParagraph","Properties":{"id":"20240607151600-efz5cqq","updated":"20240607151600"},"Children":[{"Type":"NodeText","Data":"主身大热在皮肤中，去面热，赤疱，酒皶，恶风瘨疾，阴下痒湿，明耳目。一名林兰。生川谷。"}]},{"ID":"20240607151600-44lm2fy","Type":"NodeParagraph","Properties":{"id":"20240607151600-44lm2fy","updated":"20240607151600"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名杜兰，皮似桂而香，生零陵及太山，十二月采皮，阴干。"}]},{"ID":"20240607151600-3c3nlwr","Type":"NodeParagraph","Properties":{"id":"20240607151600-3c3nlwr","updated":"20240607151600"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：木栏桂栏也。刘逵注蜀都赋云：木兰，大树也，叶似长生，冬夏荣，常以冬华，其实如小柿，甘美。南人以为梅，其皮可食。颜师古注汉书云："}]},{"ID":"20240607151600-zg1g9g7","Type":"NodeParagraph","Properties":{"id":"20240607151600-zg1g9g7","updated":"20240607151600"},"Children":[{"Type":"NodeText","Data":"皮似椒而香，可作面膏药。"}]},{"ID":"20240617111443-3wmpi4q","Type":"NodeThematicBreak","Properties":{"id":"20240617111443-3wmpi4q"}},{"ID":"20240617111444-k25pl93","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111444-k25pl93","updated":"20240617111450"},"Children":[{"Type":"NodeText","Data":"木兰《神农本草经赞》"}]},{"ID":"20240617111444-fs8srkb","Type":"NodeParagraph","Properties":{"id":"20240617111444-fs8srkb","updated":"20240617111444"},"Children":[{"Type":"NodeText","Data":"味苦寒。主身大热在皮肤中。去面热赤。酒。恶风疾。阴下痒湿。明耳目。一名林兰。生山谷。"}]},{"ID":"20240617111444-jegtzma","Type":"NodeParagraph","Properties":{"id":"20240617111444-jegtzma","updated":"20240617111444"},"Children":[{"Type":"NodeText","Data":"利通舟楫。分剂刀圭。兰如同臭。莲不污泥冰坚雪白。鹤唳猿啼。花身依旧。惭愧黎。"}]},{"ID":"20240617111444-umgagw7","Type":"NodeParagraph","Properties":{"id":"20240617111444-umgagw7","updated":"20240617111444"},"Children":[{"Type":"NodeText","Data":"述异记。浔阳七里洲。有鲁班刻木兰舟。庾信诗。量药用刀圭。李时珍曰。其香如兰。其花如莲。易。同心之言。其臭如兰。周敦颐说。出污泥而不染。成公绥赋。峨峨坚冰。霏霏白雪。李华赋。鹤既唳兮猿复啼。陆龟蒙诗。几度木兰舟上望。不知原是此花身。王播诗。惭愧黎饭后钟。"}]},{"ID":"20240617111329-jimgyzq","Type":"NodeThematicBreak","Properties":{"id":"20240617111329-jimgyzq"}},{"ID":"20240617111330-z18esma","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111330-z18esma","updated":"20240617111334"},"Children":[{"Type":"NodeText","Data":"木兰《名医别录》"}]},{"ID":"20240617111330-la1uk6i","Type":"NodeParagraph","Properties":{"id":"20240617111330-la1uk6i","updated":"20240617111330"},"Children":[{"Type":"NodeText","Data":"无毒．主治中风、伤寒，及痈疽、水肿，去臭气．一名杜兰，皮似桂而香．生零陵及山．十二月采皮，阴干．"}]},{"ID":"20240617111330-dg8w3n4","Type":"NodeParagraph","Properties":{"id":"20240617111330-dg8w3n4","updated":"20240620171312"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶木兰，味苦，寒．主身大热在皮肤中，去面热赤 酒渣，恶风癫疾，阴下痒湿，明耳目．一名林兰。生川谷。"}]},{"ID":"20240607151616-303fc1q","Type":"NodeThematicBreak","Properties":{"id":"20240607151616-303fc1q","updated":"20240607151616"}},{"ID":"20240607151616-wm23z47","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151616-wm23z47","updated":"20240607151616"},"Children":[{"Type":"NodeText","Data":"木兰《医学入门》"}]},{"ID":"20240607151616-a9a4hte","Type":"NodeParagraph","Properties":{"id":"20240607151616-a9a4hte","updated":"20240607151616"},"Children":[{"Type":"NodeText","Data":"木兰寒苦采皮干，皮风痈癞面满丹，赤鼻酒 除湿痒，又消水肿治伤寒。"}]},{"ID":"20240607151616-d3pbhm2","Type":"NodeParagraph","Properties":{"id":"20240607151616-d3pbhm2","updated":"20240607151616"},"Children":[{"Type":"NodeText","Data":"木香如兰，状如浓朴、桂皮。无毒。主风热在皮肤中，面上 黯，及痈疽癞风等疾。"}]},{"ID":"20240607151616-lhqkh7o","Type":"NodeThematicBreak","Properties":{"id":"20240607151616-lhqkh7o","updated":"20240607151616"}},{"ID":"20240607151635-axgsnhp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151635-axgsnhp","updated":"20240607151639"},"Children":[{"Type":"NodeText","Data":"木兰《本草经集注》"}]},{"ID":"20240607151635-l2bgq9n","Type":"NodeParagraph","Properties":{"id":"20240607151635-l2bgq9n","updated":"20240607151635"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主治身有大热在皮肤中，去面热赤 、酒 ，恶风、癞疾，阴下痒湿明目。治中风伤寒，及痈疽水肿，去臭气。一名林兰，一名杜兰。皮似桂而香。生零陵山谷，生太山。十二月采皮，阴干。"}]},{"ID":"20240607151635-44xl2qo","Type":"NodeParagraph","Properties":{"id":"20240607151635-44xl2qo","updated":"20240607151635"},"Children":[{"Type":"NodeText","Data":"零陵诸处皆有，状如楠树，皮甚薄而味辛香。今益州有，皮浓，状如浓朴，而气味为胜。"}]},{"ID":"20240607151635-sfuannu","Type":"NodeThematicBreak","Properties":{"id":"20240607151635-sfuannu"}},{"ID":"20240607151643-1wywbf5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151643-1wywbf5","updated":"20240607151648"},"Children":[{"Type":"NodeText","Data":"木兰《证类本草》"}]},{"ID":"20240607151652-s25w8ko","Type":"NodeParagraph","Properties":{"id":"20240607151652-s25w8ko","updated":"20240607151652"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主身大热在皮肤中，去面热赤 酒 ，恶风癫疾，阴下痒湿，明耳目，疗中风伤寒，及痈疽水肿，去臭气。一名林兰，一名杜兰。皮似桂而香。生零陵山谷及太山。十二月采皮，阴干。"}]},{"ID":"20240607151652-euzjd59","Type":"NodeParagraph","Properties":{"id":"20240607151652-euzjd59","updated":"20240607151652"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶零陵诸处皆有。状如楠树，皮甚薄而味辛香。今益州有皮浓，状如浓朴，而气味为胜。今东人皆以山桂皮当之，亦相类。道家用合香亦好。唐本注云∶木兰似菌桂叶，其叶气味辛香不及桂也。臣禹锡等谨按蜀本图经云∶树高数仞，叶似菌桂叶，有三道纵纹，皮图经曰∶木兰，生零陵山谷及泰山，今湖、岭、蜀、川诸州皆有之。木高数丈，叶似菌桂叶，亦有三道纵纹，皮如板桂，有纵横纹，香味劣于桂。此与桂枝全别，而韶州所生，乃云与桂同是一种。取外皮为木兰，中肉为桂心。盖是桂中之一种耳。十一月、十二月采，阴干用。任 《述异记》云∶木兰川，在浔阳江中，多木兰。又七里洲中有鲁班刻木兰舟，至今在洲中。今诗家云木兰舟，出于此。"}]},{"ID":"20240607151652-sjrbwu3","Type":"NodeParagraph","Properties":{"id":"20240607151652-sjrbwu3","updated":"20240607151652"},"Children":[{"Type":"NodeText","Data":"外台秘要∶疗面上 方∶木兰皮一斤，细切，以三年酢浆渍之百日，出，于日中晒捣末。浆水服方寸匕，日三。子母秘录∶疗小儿重舌。木兰皮一尺，广四寸，削去粗皮，用醋一升渍取汁，注重舌上。"}]},{"ID":"20240607151653-zq09ehn","Type":"NodeThematicBreak","Properties":{"id":"20240607151653-zq09ehn"}},{"ID":"20240607151658-gk95m8v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151658-gk95m8v","updated":"20240607151702"},"Children":[{"Type":"NodeText","Data":"木兰《千金翼方》"}]},{"ID":"20240607151658-oduoc9i","Type":"NodeParagraph","Properties":{"id":"20240607151658-oduoc9i","updated":"20240607151658"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主身大热在皮肤中，去面热赤 、酒 ，恶风癫疾，阴下痒湿。明耳目。疗中风伤寒及痈疽水肿，去臭气。一名林兰，一名杜兰。皮似桂而香。生零陵山谷及太山，十二月采皮，阴干。"}]},{"ID":"20240607151703-lj4dicl","Type":"NodeThematicBreak","Properties":{"id":"20240607151703-lj4dicl"}},{"ID":"20240607151708-f9m2jij","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151708-f9m2jij","updated":"20240607151713"},"Children":[{"Type":"NodeText","Data":"木兰《本草纲目》"}]},{"ID":"20240607151708-46v2zlv","Type":"NodeParagraph","Properties":{"id":"20240607151708-46v2zlv","updated":"20240607151708"},"Children":[{"Type":"NodeText","Data":"「释名」杜兰、林兰、木莲、黄心。"}]},{"ID":"20240607151708-va3vam2","Type":"NodeParagraph","Properties":{"id":"20240607151708-va3vam2","updated":"20240607151708"},"Children":[{"Type":"NodeText","Data":"「气味」（皮）苦、寒、无毒。"}]},{"ID":"20240607151708-d3hgj9f","Type":"NodeParagraph","Properties":{"id":"20240607151708-d3hgj9f","updated":"20240607151708"},"Children":[{"Type":"NodeText","Data":"「主治」赤疱酒、痈疽水肿，治酒疸，利小便，疗重舌。"}]},{"ID":"20240607151714-shw15of","Type":"NodeThematicBreak","Properties":{"id":"20240607151714-shw15of"}},{"ID":"20240607151719-6yu9nck","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240607151719-6yu9nck","updated":"20240607151725"},"Children":[{"Type":"NodeText","Data":"木兰《新修本草》"}]},{"ID":"20240607151719-m4ikox1","Type":"NodeParagraph","Properties":{"id":"20240607151719-m4ikox1","updated":"20240607151719"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主身有大热在皮肤中，去面热赤 、酒 ，恶风、癞疾，阴下痒湿，明水肿，去臭气。一名林兰，一名杜兰，皮似桂而香。生零陵山谷，生干。"}]},{"ID":"20240607151719-t5qfph9","Type":"NodeParagraph","Properties":{"id":"20240607151719-t5qfph9","updated":"20240607151719"},"Children":[{"Type":"NodeText","Data":"零陵诸处皆有，状如楠树，皮甚薄而味辛香。今益州有，皮浓，状如浓朴，而气味为胜。"}]},{"ID":"20240607151719-hg4eowl","Type":"NodeParagraph","Properties":{"id":"20240607151719-hg4eowl","updated":"20240607151719"},"Children":[{"Type":"NodeText","Data":"故今东人皆以山桂皮当之，亦相类，道家用合香，亦好也。"}]},{"ID":"20240607151719-5ycnfp0","Type":"NodeParagraph","Properties":{"id":"20240607151719-5ycnfp0","updated":"20240607151719"},"Children":[{"Type":"NodeText","Data":"〔谨案〕木兰叶似菌桂叶，其叶气味辛香，不及桂也。"}]},{"ID":"20240607151725-mu1e3yx","Type":"NodeThematicBreak","Properties":{"id":"20240607151725-mu1e3yx"}},{"ID":"20240617111457-dwzqcmq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240617111457-dwzqcmq","updated":"20240617111505"},"Children":[{"Type":"NodeText","Data":"木兰《本草图经》"}]},{"ID":"20240617111457-d3ggb52","Type":"NodeParagraph","Properties":{"id":"20240617111457-d3ggb52","updated":"20240617111500"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"木兰"},{"Type":"NodeText","Data":"，生零陵山谷及泰山，今湖、岭、蜀川诸州皆有之。木高数丈，叶似菌桂叶，亦有三道纵纹；皮如板桂，有纵横纹；香味劣于桂，此与桂枝全别。而韶州所生，乃云与桂同是一种，取外皮为木兰，中肉为桂心，盖是桂中之一种耳。十一月、十二月采，阴干用。任 《述异记》云∶木兰川，在浔阳江中，多木兰。又七里州中有鲁班刻木兰舟，至今在州中。今诗家云木兰舟，出于此。"}]},{"ID":"20240617111457-rbcu1ac","Type":"NodeThematicBreak","Properties":{"id":"20240617111457-rbcu1ac"}},{"ID":"20240617111458-8dg0rnd","Type":"NodeParagraph","Properties":{"id":"20240617111458-8dg0rnd"}}]}