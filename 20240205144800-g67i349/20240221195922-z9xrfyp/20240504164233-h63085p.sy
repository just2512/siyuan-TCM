{"ID":"20240504164233-h63085p","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164233-h63085p","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164233-h63085p\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504164233-3swn13u\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611111407-rkbpeaj\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240611111709-kq5va26\u0026quot;,\u0026quot;focusStart\u0026quot;:2,\u0026quot;focusEnd\u0026quot;:2\u0026#125;","title":"141白瓜子","type":"doc","updated":"20240813092948"},"Children":[{"ID":"20240812175434-ow5g1r0","Type":"NodeParagraph","Properties":{"id":"20240812175434-ow5g1r0","updated":"20240812175434"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"白瓜子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/白瓜子-20240812175434-1dk90be.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621152414-kk5s7vq","Type":"NodeParagraph","Properties":{"id":"20240621152414-kk5s7vq","updated":"20240812175534"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬瓜"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬瓜-20240812175529-kzf2mrm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812175615-dcetwu2","Type":"NodeParagraph","Properties":{"id":"20240812175615-dcetwu2","updated":"20240813091219"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-st