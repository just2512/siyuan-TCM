:{"parent-style":"width: 775px;","style":"width: 765px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬瓜 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬瓜 15-20240813092730-z857mqx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 765px;\" parent-style=\"width: 775px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 416px;","style":"width: 406px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬瓜 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬瓜 16-20240813092836-9aab86n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 406px;\" parent-style=\"width: 416px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611111602-aecv9hr","Type":"NodeThematicBreak","Properties":{"id":"20240611111602-aecv9hr"}},{"ID":"20240611111654-1zttpou","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111654-1zttpou","updated":"20240611111659"},"Children":[{"Type":"NodeText","Data":"瓜子《神农本草经》"}]},{"ID":"20240611111654-4u92ryw","Type":"NodeParagraph","Properties":{"id":"20240611111654-4u92ryw","updated":"20240611111654"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240611111654-pidap3o","Type":"NodeParagraph","Properties":{"id":"20240611111654-pidap3o","updated":"20240611111654"},"Children":[{"Type":"NodeText","Data":"主令人说泽，好颜色，益气不饥。久服轻身耐老。一名水芝。（《御览》作土芝）生平泽。"}]},{"ID":"20240611111654-gegtzf6","Type":"NodeParagraph","Properties":{"id":"20240611111654-gegtzf6","updated":"20240611111654"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：瓜子一名瓣，七月七日采，可作面脂。（《御览》）"}]},{"ID":"20240611111654-0ys6seu","Type":"NodeParagraph","Properties":{"id":"20240611111654-0ys6seu","updated":"20240611111654"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名白瓜子，生蒿高，冬瓜仁也，八月采。"}]},{"ID":"20240611111654-ejzuv13","Type":"NodeParagraph","Properties":{"id":"20240611111654-ejzuv13","updated":"20240611111654"},"Children":[{"Type":"NodeText","Data":"案《说文》云：瓣，瓜中实。《广雅》云：冬瓜（上艹下左立右瓜）也，其子谓之瓤。陶宏景云：白当为甘，旧有白字。据《名医》云：一名白瓜子，则本名当无。"}]},{"ID":"20240611111707-ifosv6o","Type":"NodeThematicBreak","Properties":{"id":"20240611111707-ifosv6o"}},{"ID":"20240611111709-kq5va26","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111709-kq5va26","updated":"20240611111716"},"Children":[{"Type":"NodeText","Data":"白瓜子《证类本草》"}]},{"ID":"20240611111709-dya2mdq","Type":"NodeParagraph","Properties":{"id":"20240611111709-dya2mdq","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"味甘，平、寒，无毒。主令人悦泽，好颜色，益气不饥。久服轻身耐老。主除烦满不乐，久服寒中。可用面脂，令面悦泽。一名水芝，一名白爪（侧绞切）子。生嵩高平泽。"}]},{"ID":"20240611111709-cbbhhej","Type":"NodeParagraph","Properties":{"id":"20240611111709-cbbhhej","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"冬唐本注云∶《经》云冬瓜仁也，八月采之。以下为冬瓜仁说，非谓冬瓜别名。据《经》及下条瓜蒂，并生嵩高平泽，此即一物，但以甘字似白字，后人误以为白也。若其不是甘瓜，何因一名白瓜？此即甘瓜不惑。且朱书论白瓜之效，墨书说冬瓜之功，功异条同，陶为深误。"}]},{"ID":"20240611111709-0ciu2eo","Type":"NodeParagraph","Properties":{"id":"20240611111709-0ciu2eo","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"按《广雅》∶冬瓜一名地芝，与甘瓜全别，墨书宜附冬瓜科下。瓜蒂与甘瓜共条。《别录》云∶甘瓜子，主腹内结聚，破溃脓血，最为肠胃脾内壅要药。本草以为冬瓜，但用蒂，不云俗人或用冬瓜子也。又按本草云∶瓜子或云甘瓜子，今此本误作白字，当改从甘也。今按∶此即冬瓜子也。唐注称是甘瓜子。谓甘字似白字，后人误以为白。"}]},{"ID":"20240611111709-qv1nf8b","Type":"NodeParagraph","Properties":{"id":"20240611111709-qv1nf8b","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"且《本经》云∶主令人悦泽。《别录》云∶可作面脂，令人悦泽。"}]},{"ID":"20240611111709-4e56oyr","Type":"NodeParagraph","Properties":{"id":"20240611111709-4e56oyr","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"仁，不见用甘瓜子，按此即是冬瓜子明矣。故陶于后条注中云∶取核水洗，燥乃檑取仁用之。且此物与甘瓜全别。其甘瓜有青、白二种，子色皆黄，主疗与白瓜经霜亦有白衣，其中子白，白瓜子之号，因斯而得。况陶居以《别录》白冬瓜附于白瓜子之下，白瓜子更不加注，足明一物而不能显辨尔。《别录》瓜字，侧绞切，今以读作瓜字。唐注谬误，都不可凭。臣禹锡等谨按蜀本注∶苏云是甘瓜子也。《图经》云∶别有胡瓜，黄赤，无味。今据此两说，俱不可凭矣。《本经》云∶冬瓜仁也。苏注者。且甘瓜自有青、白二种，只合云白甘瓜也。今据《本经》云∶白瓜子即冬瓜仁无疑也。按∶冬瓜虽色青，而其中子甚白，谓如白瓜子者，犹如虫部有白龙骨焉，人但看骨之白而不知龙之色也。若以甘瓜子为之，则甘瓜青、白二种，其子并黄色，冬瓜仁，信苏注为妄，《图经》难凭矣！孟诜云∶取冬瓜仁七升，以绢袋盛之，投三沸汤中，须臾出曝干，如此三度止。又，与清苦酒渍，经一宿，曝干为末悦，明目，延年不老。又，取子三、五升，退去皮，捣为丸。空腹服三十丸，令人白净如玉。日华子云∶冬瓜仁，去皮肤风剥，黑 ，润肌肤。"}]},{"ID":"20240611111709-8asvqzk","Type":"NodeParagraph","Properties":{"id":"20240611111709-8asvqzk","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"图经曰∶白瓜子，即冬瓜仁也。生嵩高平泽，今处处有之，皆园圃所莳。其实生苗蔓下，大者如斗而更长，皮浓而有毛，初生正青绿，经霜则白如涂粉。其中肉及子亦白，故谓之白瓜仁入药须霜后合取，置之经年，破出核洗，燥乃擂取仁用之。亦堪单作服饵。又有末作汤饮，又作面药，并令人颜色光泽。宗懔《荆楚岁时记》云∶七月采瓜犀，以为面脂。犀，瓣也。瓤亦堪作澡豆。其肉主三消渴疾，解积热，利大小肠，压丹石毒。《广雅》一名地芝是也。皮可作丸服，亦入面脂中，功用与上等。"}]},{"ID":"20240611111709-mf4u46m","Type":"NodeParagraph","Properties":{"id":"20240611111709-mf4u46m","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"外台秘要∶补肝散∶治男子五劳七伤，明目。白瓜子七升，绢袋盛，绞沸汤中，三遍讫，以酢五升，渍一宿，曝干，捣下筛，酒服方寸匕，日三，久服瘥。孙真人∶治多年损伤不瘥。"}]},{"ID":"20240611111709-utkvmgq","Type":"NodeParagraph","Properties":{"id":"20240611111709-utkvmgq","updated":"20240611111709"},"Children":[{"Type":"NodeText","Data":"衍义曰∶白瓜子实，冬瓜仁也，服食中亦稀用。"}]},{"ID":"20240611111440-yzys2st","Type":"NodeThematicBreak","Properties":{"id":"20240611111440-yzys2st"}},{"ID":"20240611111556-8k514nt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111556-8k514nt","updated":"20240611111601"},"Children":[{"Type":"NodeText","Data":"白瓜子《本草衍义》"}]},{"ID":"20240611111556-r935ujq","Type":"NodeParagraph","Properties":{"id":"20240611111556-r935ujq","updated":"20240611111556"},"Children":[{"Type":"NodeText","Data":"实冬瓜仁也，服食中亦稀用。"}]},{"ID":"20240611111538-pu879ko","Type":"NodeThematicBreak","Properties":{"id":"20240611111538-pu879ko"}},{"ID":"20240611111538-uxmmgwr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111538-uxmmgwr","updated":"20240611111546"},"Children":[{"Type":"NodeText","Data":"白瓜子《千金翼方》"}]},{"ID":"20240611111538-co1upvb","Type":"NodeParagraph","Properties":{"id":"20240611111538-co1upvb","updated":"20240611111538"},"Children":[{"Type":"NodeText","Data":"味甘，平，寒，无毒。主令人悦泽，好颜色，益气不肌。久服轻身耐老，主除烦满不乐。"}]},{"ID":"20240611111538-hcpmh10","Type":"NodeParagraph","Properties":{"id":"20240611111538-hcpmh10","updated":"20240611111538"},"Children":[{"Type":"NodeText","Data":"久服寒中。可作面脂，令面悦泽。一名水芝，一名白瓜（则绞切）子。生蒿高平泽，冬瓜仁也，八月采。"}]},{"ID":"20240611111440-jzkfc87","Type":"NodeThematicBreak","Properties":{"id":"20240611111440-jzkfc87"}},{"ID":"20240611111525-nly7n49","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111525-nly7n49","updated":"20240611111525"},"Children":[{"Type":"NodeText","Data":"白瓜子"}]},{"ID":"20240611111525-xo73uxy","Type":"NodeParagraph","Properties":{"id":"20240611111525-xo73uxy","updated":"20240611111525"},"Children":[{"Type":"NodeText","Data":"寒，无毒．主除烦满不乐，久服寒中．可作面脂，令悦泽．一名白瓜子．生嵩高．仁也，八月采之．"}]},{"ID":"20240611111403-ta4zu1q","Type":"NodeThematicBreak","Properties":{"id":"20240611111403-ta4zu1q"}},{"ID":"20240611111414-aq7eiyu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111414-aq7eiyu","updated":"20240611111426"},"Children":[{"Type":"NodeText","Data":"白瓜子《名医别录》"}]},{"ID":"20240611111414-ifg9evg","Type":"NodeParagraph","Properties":{"id":"20240611111414-ifg9evg","updated":"20240611111414"},"Children":[{"Type":"NodeText","Data":"寒，无毒。主除烦满不乐，久服寒中。可作面脂，令悦泽。一名白瓜子。生嵩高。冬瓜仁也，八月采之。"}]},{"ID":"20240611111404-sj0t0hf","Type":"NodeThematicBreak","Properties":{"id":"20240611111404-sj0t0hf"}},{"ID":"20240611111405-gmas697","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111405-gmas697","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：冬瓜子"}]},{"ID":"20240611111405-l4es4ac","Type":"NodeParagraph","Properties":{"id":"20240611111405-l4es4ac","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611111405-jlercz6","Type":"NodeParagraph","Properties":{"id":"20240611111405-jlercz6","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" Dōnɡ Guā Zǐ"}]},{"ID":"20240611111405-3jz6z56","Type":"NodeParagraph","Properties":{"id":"20240611111405-3jz6z56","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611111405-tt6ozpk","Type":"NodeParagraph","Properties":{"id":"20240611111405-tt6ozpk","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 即"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"冬瓜"},{"Type":"NodeText","Data":"的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟种子"},{"Type":"NodeText","Data":"。洗净晒干（有先用明矾水浸泡1日后再洗净晒干者）。"}]},{"ID":"20240611111405-cc3e1nc","Type":"NodeParagraph","Properties":{"id":"20240611111405-cc3e1nc","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611111405-h9t1ihs","Type":"NodeParagraph","Properties":{"id":"20240611111405-h9t1ihs","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 炒冬瓜子：将冬瓜子筛净泥屑，炒至黄色，取出晾凉。"}]},{"ID":"20240611111405-cvrr775","Type":"NodeParagraph","Properties":{"id":"20240611111405-cvrr775","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611111405-d597spb","Type":"NodeParagraph","Properties":{"id":"20240611111405-d597spb","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240611111405-rgltbku","Type":"NodeParagraph","Properties":{"id":"20240611111405-rgltbku","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611111405-08r5oxy","Type":"NodeParagraph","Properties":{"id":"20240611111405-08r5oxy","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 清肺、化痰、排脓。适用于肺热咳嗽、肺痈、肠痈等症。"}]},{"ID":"20240611111405-acypbbq","Type":"NodeParagraph","Properties":{"id":"20240611111405-acypbbq","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611111405-89futfh","Type":"NodeParagraph","Properties":{"id":"20240611111405-89futfh","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 0.5～1两。"}]},{"ID":"20240611111405-7yg3sna","Type":"NodeParagraph","Properties":{"id":"20240611111405-7yg3sna","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611111405-ww98gzj","Type":"NodeParagraph","Properties":{"id":"20240611111405-ww98gzj","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611111405-h0pxadf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111405-h0pxadf","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：冬瓜子"}]},{"ID":"20240611111405-pa2dofl","Type":"NodeParagraph","Properties":{"id":"20240611111405-pa2dofl","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611111405-i0n0ci6","Type":"NodeParagraph","Properties":{"id":"20240611111405-i0n0ci6","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" Dōnɡ Guā Zǐ"}]},{"ID":"20240611111405-50wzayi","Type":"NodeParagraph","Properties":{"id":"20240611111405-50wzayi","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611111405-n0ettr1","Type":"NodeParagraph","Properties":{"id":"20240611111405-n0ettr1","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 白瓜子（《本经》），瓜子、瓜瓣（《金匮要略》），冬瓜仁（《别录》），瓜犀（《荆楚岁时记》）。"}]},{"ID":"20240611111405-r516b7m","Type":"NodeParagraph","Properties":{"id":"20240611111405-r516b7m","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611111405-2g6t4ct","Type":"NodeParagraph","Properties":{"id":"20240611111405-2g6t4ct","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《唐本草》"}]},{"ID":"20240611111405-x98bm9z","Type":"NodeParagraph","Properties":{"id":"20240611111405-x98bm9z","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611111405-iqjboe5","Type":"NodeParagraph","Properties":{"id":"20240611111405-iqjboe5","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 为葫芦科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"冬瓜"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子"},{"Type":"NodeText","Data":"。食用冬瓜时，收集种子，洗净，选成熟者，晒干。"}]},{"ID":"20240611111405-e81k543","Type":"NodeParagraph","Properties":{"id":"20240611111405-e81k543","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611111405-nzv6k79","Type":"NodeParagraph","Properties":{"id":"20240611111405-nzv6k79","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 全国大部地区均产。以四川、浙江、江苏、河南、河北、安徽等地，产量较大。"}]},{"ID":"20240611111405-r5kar6c","Type":"NodeParagraph","Properties":{"id":"20240611111405-r5kar6c","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611111405-14q2ihh","Type":"NodeParagraph","Properties":{"id":"20240611111405-14q2ihh","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 干燥种子呈扁平的长卵圆形或长椭圆形，长1厘米左右，宽约6毫米。外皮黄白色，有时有裂纹，一端纯圆，另一端尖，尖端有2个小突起，其一较小者为种脐；另一突起较大，上有一明显的珠孔。边缘光滑（单边冬瓜子）或两面边缘均有一环形的边（双边冬瓜子）。剥去种皮后，可见乳白色的种仁，有油性。气微，味微甜。以白色、粒饱满、无杂质者为佳。"}]},{"ID":"20240611111405-10sa5x7","Type":"NodeParagraph","Properties":{"id":"20240611111405-10sa5x7","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611111405-1y6kj0j","Type":"NodeParagraph","Properties":{"id":"20240611111405-1y6kj0j","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 种子含皂甙0.68％、脂肪、尿素、瓜氨酸等。"}]},{"ID":"20240611111405-qkc0ab2","Type":"NodeParagraph","Properties":{"id":"20240611111405-qkc0ab2","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"同属植物Benincasa ccrifera种子的脂肪油中含亚油酸62.3％，油酸21.9％，饱和脂肪酸15.6％，种子中并分离出少量腺嘌呤，胡芦巴碱等。"}]},{"ID":"20240611111405-li8ckc3","Type":"NodeParagraph","Properties":{"id":"20240611111405-li8ckc3","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611111405-tz3s59u","Type":"NodeParagraph","Properties":{"id":"20240611111405-tz3s59u","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，用时捣碎。或用文火微炒至黄白色。置干燥处，防虫蛀及鼠咬。"}]},{"ID":"20240611111405-kvn4csv","Type":"NodeParagraph","Properties":{"id":"20240611111405-kvn4csv","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611111405-juxrr39","Type":"NodeParagraph","Properties":{"id":"20240611111405-juxrr39","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《得配本草》：\"入足厥阴经。\""}]},{"ID":"20240611111405-0ijxzau","Type":"NodeParagraph","Properties":{"id":"20240611111405-0ijxzau","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611111405-qq7n1v2","Type":"NodeParagraph","Properties":{"id":"20240611111405-qq7n1v2","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 甘，凉。"}]},{"ID":"20240611111405-9dedwjg","Type":"NodeParagraph","Properties":{"id":"20240611111405-9dedwjg","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240611111405-l0thn10","Type":"NodeParagraph","Properties":{"id":"20240611111405-l0thn10","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"寒，无毒。\""}]},{"ID":"20240611111405-82mrumt","Type":"NodeParagraph","Properties":{"id":"20240611111405-82mrumt","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"③《陆川本草》：\"甘，凉。\""}]},{"ID":"20240611111405-fyryxvo","Type":"NodeParagraph","Properties":{"id":"20240611111405-fyryxvo","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611111405-mfz0hi3","Type":"NodeParagraph","Properties":{"id":"20240611111405-mfz0hi3","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《别录》：\"久服寒中。\""}]},{"ID":"20240611111405-q452yd5","Type":"NodeParagraph","Properties":{"id":"20240611111405-q452yd5","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611111405-lgyxwwv","Type":"NodeParagraph","Properties":{"id":"20240611111405-lgyxwwv","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 润肺，化痰，消痈，利水。治痰热咳嗽，肺痈，肠痈，淋病，水肿，脚气，痔疮，鼻面酒皶。"}]},{"ID":"20240611111405-uxwd906","Type":"NodeParagraph","Properties":{"id":"20240611111405-uxwd906","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"益气。\""}]},{"ID":"20240611111405-4o0aeq3","Type":"NodeParagraph","Properties":{"id":"20240611111405-4o0aeq3","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主烦满不乐。\""}]},{"ID":"20240611111405-n9t968u","Type":"NodeParagraph","Properties":{"id":"20240611111405-n9t968u","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"③崔禹锡《食经》：\"利水道，去淡水。\""}]},{"ID":"20240611111405-oyq45qw","Type":"NodeParagraph","Properties":{"id":"20240611111405-oyq45qw","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"去皮肤风剥黑皯，润肌肤。\""}]},{"ID":"20240611111405-t6l1i7l","Type":"NodeParagraph","Properties":{"id":"20240611111405-t6l1i7l","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑤《纲目》：\"治肠痈。\""}]},{"ID":"20240611111405-yngnyxt","Type":"NodeParagraph","Properties":{"id":"20240611111405-yngnyxt","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑥《本草经疏》：\"能开胃醒睥。\""}]},{"ID":"20240611111405-fokouso","Type":"NodeParagraph","Properties":{"id":"20240611111405-fokouso","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑦《本草述》：\"主治心经蕴热，小水淋痛，并鼻面酒渣如麻豆，疼痛，黄水出。\""}]},{"ID":"20240611111405-0ikxjso","Type":"NodeParagraph","Properties":{"id":"20240611111405-0ikxjso","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑧《本草从新》：\"补肝明目。\""}]},{"ID":"20240611111405-i2n7nnh","Type":"NodeParagraph","Properties":{"id":"20240611111405-i2n7nnh","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑨《本草述钩元》：\"主腹内结聚，破溃脓血，凡肠胃内壅，最为要药。\""}]},{"ID":"20240611111405-yr61vf6","Type":"NodeParagraph","Properties":{"id":"20240611111405-yr61vf6","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑩陈念祖：\"能润肺化痰，兼益胃气。\""}]},{"ID":"20240611111405-20kzejw","Type":"NodeParagraph","Properties":{"id":"20240611111405-20kzejw","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑾《山东中药》：\"治肾脏炎，尿道炎，小便不利，脚气，水肿。\""}]},{"ID":"20240611111405-s8xahoj","Type":"NodeParagraph","Properties":{"id":"20240611111405-s8xahoj","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑿《中国药植图鉴》：\"罨痔疾肿痛，或洗涤。\""}]},{"ID":"20240611111405-vy02n49","Type":"NodeParagraph","Properties":{"id":"20240611111405-vy02n49","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611111405-gg46ea5","Type":"NodeParagraph","Properties":{"id":"20240611111405-gg46ea5","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～4钱；或研末。外用：煎水洗或研膏涂敷。"}]},{"ID":"20240611111405-i8uj04r","Type":"NodeParagraph","Properties":{"id":"20240611111405-i8uj04r","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611111405-sln04i8","Type":"NodeParagraph","Properties":{"id":"20240611111405-sln04i8","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" ①治咳有微热，烦满，胸中甲错，是为肺痈：苇茎（切，二升，以水二斗煮取五升去滓），薏苡仁半升，桃仁三十枚，瓜瓣（目前多用冬瓜仁）半升。上四味细切，内苇汁中煮取二升，服一升，当吐如脓。（《金匮要略》千金苇茎汤）"}]},{"ID":"20240611111405-l0lxdkx","Type":"NodeParagraph","Properties":{"id":"20240611111405-l0lxdkx","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"②治肠痈脓未成，少腹肿痞，按之即痛，如淋，小便自调，时时发热，自汗出，复恶寒，其脉迟紧者：大黄四两，牡丹皮一两，桃仁五十个，瓜子半斤，芒硝三合。上五味，以水六升，煮取一升，去滓，内芒硝；再煎沸，顿服之。有脓当下，如无脓当下血。（《金匮要略》大黄牡丹汤）"}]},{"ID":"20240611111405-ot6q48c","Type":"NodeParagraph","Properties":{"id":"20240611111405-ot6q48c","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"③治男子白浊，女子白带：陈冬瓜仁炒为末。每空心米饮服五钱。（《救急易方》）"}]},{"ID":"20240611111405-iv00imu","Type":"NodeParagraph","Properties":{"id":"20240611111405-iv00imu","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"④治消渴不止，小便多：干冬瓜子、麦门冬、黄连各二两。水煎饮之。《摘元方》"}]},{"ID":"20240611111405-p3w14iy","Type":"NodeParagraph","Properties":{"id":"20240611111405-p3w14iy","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"⑤治男子五劳七伤，明目：白瓜子七升，绢袋盛，搅沸汤中三遍，暴干；以酢五升浸一宿，暴干；治下筛。酒服方寸匕，日三服之。（《千金方》）"}]},{"ID":"20240611111405-yqfeatk","Type":"NodeParagraph","Properties":{"id":"20240611111405-yqfeatk","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611111405-u4adz8w","Type":"NodeParagraph","Properties":{"id":"20240611111405-u4adz8w","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611111405-00x8q0b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111405-00x8q0b","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"《中华本草》：冬瓜子"}]},{"ID":"20240611111405-gp5tvs7","Type":"NodeParagraph","Properties":{"id":"20240611111405-gp5tvs7","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611111405-v8ydfjg","Type":"NodeParagraph","Properties":{"id":"20240611111405-v8ydfjg","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" Dōnɡ Guā Zǐ"}]},{"ID":"20240611111405-ifduq81","Type":"NodeParagraph","Properties":{"id":"20240611111405-ifduq81","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611111405-o985qhm","Type":"NodeParagraph","Properties":{"id":"20240611111405-o985qhm","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 白瓜子、瓜子、瓜瓣、冬瓜仁、瓜犀"}]},{"ID":"20240611111405-w0ced8k","Type":"NodeParagraph","Properties":{"id":"20240611111405-w0ced8k","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611111405-i1xfjbu","Type":"NodeParagraph","Properties":{"id":"20240611111405-i1xfjbu","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 1.出自《唐本草》。"}]},{"ID":"20240611111405-yvcb7j7","Type":"NodeParagraph","Properties":{"id":"20240611111405-yvcb7j7","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：白瓜子，入药须霜后合取，置之经年，破出核，洗、燥，乃擂取仁用之。"}]},{"ID":"20240611111405-kb23zxv","Type":"NodeParagraph","Properties":{"id":"20240611111405-kb23zxv","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611111405-7j64cnb","Type":"NodeParagraph","Properties":{"id":"20240611111405-7j64cnb","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 药材基源：为葫芦科植物冬瓜的种子。"}]},{"ID":"20240611111405-xw7ujtm","Type":"NodeParagraph","Properties":{"id":"20240611111405-xw7ujtm","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Benincasa hispida(Thunb.) Cogn."}]},{"ID":"20240611111405-72bquci","Type":"NodeParagraph","Properties":{"id":"20240611111405-72bquci","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"采收和储藏：食用冬瓜时；收集成熟种子；洗净；晒干"}]},{"ID":"20240611111405-6t2jh0u","Type":"NodeParagraph","Properties":{"id":"20240611111405-6t2jh0u","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611111405-0o7ljic","Type":"NodeParagraph","Properties":{"id":"20240611111405-0o7ljic","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 一年生蔓生或架生草本。茎被黄褐色硬毛及长柔毛，有棱沟，长约6m。单叶互生；叶柄粗壮，长5-20cm，被黄褐色硬毛及长柔毛；叶片肾状近圆形，宽15-30cm5-7浅裂或有时中裂，裂片宽卵形，先端急尖，边缘有小齿，基部深心形，两面均被粗毛，叶脉网状，在叶背面稍隆起，密被毛。郑须生于叶腋，2-3歧，被粗硬毛和长柔毛。花单性，雌雄同株；花单生于叶腋，花梗被硬毛；花萼管大辩论，裂片三角卵形，边缘有锯齿，反折；花冠黄色，5裂至基部，外展；雄花有雄蕊3，花丝分生，花药卵形，药室呈S形折曲；雌花子房长圆筒形或长卵形，密被黄褐色长硬毛，柱头3，略扭曲。瓠果大型，肉质，长圆柱状或近球形，长25-60cm，径10-25cm，表面有硬毛和蜡质白粉。种子多数，卵形，白色或淡黄色，压扁。花期5-6月，果期6-8月。"}]},{"ID":"20240611111405-2943emc","Type":"NodeParagraph","Properties":{"id":"20240611111405-2943emc","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611111405-xlkx6dj","Type":"NodeParagraph","Properties":{"id":"20240611111405-xlkx6dj","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 种子长椭圆形或卵圆形，扁平，长1-1.5cm，宽0.5-1cm厚约0.2cm。表面黄白色，略粗糙，边缘光滑（单边冬瓜子）或两面外缘各有1环纹（双边冬瓜子）。一端稍尖，有2个小突起，较大的突起上有珠孔，较小的为种脐，另一端圆钝。种皮稍硬而脆，剥去种皮，可见子叶2枚，白色，肥厚，胚根短小。体轻，富油性。气无，味微甜。"}]},{"ID":"20240611111405-wnoomg0","Type":"NodeParagraph","Properties":{"id":"20240611111405-wnoomg0","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"以颗粒饱满、色白者为佳。"}]},{"ID":"20240611111405-gdmiahp","Type":"NodeParagraph","Properties":{"id":"20240611111405-gdmiahp","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"显微鉴别 种子横切面：种皮外表皮细胞1列，近栅状，壁稍厚，微木化；下皮层10余列薄壁细胞，壁微木化，具纹孔；内侧为2-3列石细胞；通气薄壁组织1列细胞，紧靠石细胞，细胞间隙较大；两端有维管束；内表皮1列细胞。珠心表皮1列细胞，外被角质层，内侧为残存的珠心及胚乳。中央有2枚子叶，细胞含脂肪油及糊粉粒。"}]},{"ID":"20240611111405-1cwsta3","Type":"NodeParagraph","Properties":{"id":"20240611111405-1cwsta3","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"理化鉴别 取本品粗粉1g，加水20ml煮沸10min，放冷，滤过。取滤液，置带塞的试管中，激烈振摇，产生持久笥泡沫。（检查皂甙）"}]},{"ID":"20240611111405-uu3qj3f","Type":"NodeParagraph","Properties":{"id":"20240611111405-uu3qj3f","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611111405-j5p2zdp","Type":"NodeParagraph","Properties":{"id":"20240611111405-j5p2zdp","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 冬瓜子含油14%，其中酰甘油（triglyce-ride)的含量在72%-96%之间，所含主要脂肪酸为亚油酸（linoleic acid),油酸（oleic acid)，硬脂酸（stearicacid),棕榈酸（palmitic acid)[1]，以及十八碳二烯酸（octadecadienoic acid),十八碳三烯酸（octdecatrienoic acid)[2]等。又含脂类（lipid).内有磷脂酰胆碱（phosphatidyl choline),磷脂酰已醇胺（pholphatidyl ethanolamine)，磷脂酰丝氨酸（phosphatidyl serine),磷脂酰肌醇（phosphatityl inolitol)，神经鞘磷脂（sphingomyelin)，脑苷脂（cerebroside)[2]。还含甾醇类化合物：β谷甾醇（β-sitosterol)，菜油甾醇（campesterol)，豆甾醇（stigmasterol)[2]，24-已基胆甾-7，25-二烯醇（24-ethylcholesta-7，25-dienol)，24-已基胆甾-7，22，25-三烯醇（24-ethylcholesta-7，22，25-trienol),24-已基胆甾-7-烯醇（24-ethylcholesta-7-enlo),24-已基胆甾-7，22-二烯醇（24-ethy-lcholesta-7，22-dienol)[3],24α-已基α-胆甾-8，22-二烯醇（24β-ethyl-5α-cholesta-8，22β-已基α胆甾-8，22，25（27）-三烯醇[24β-ethyl-5α-cholesta-8，22，25（27）-simiarenol][4]。又含三萜类化合物；粘霉烯醇（glutinol),西米杜鹃醇（simiarenol)，5，24-葫芦二烯醇（cucurbita-5，24-dienol)[5]。去脂肪后的种子中含蛋白酷活力的组分[7]以及硒、铬等无机元素[8]。"}]},{"ID":"20240611111405-t4i1wzg","Type":"NodeParagraph","Properties":{"id":"20240611111405-t4i1wzg","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611111405-35r3065","Type":"NodeParagraph","Properties":{"id":"20240611111405-35r3065","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 1、免疫促进作用 冬瓜子热水提取后，经透析得透析内液，此液对小鼠淋巴细胞的致丝裂活性呈浓度依赖性。透析内液为B细胞致丝裂剂，有PBA（无性系B细胞激活剂）活性及佐剂活性，使PFC（宽斑形成细胞）数显着增高，呈现免疫促进作用[1]。"}]},{"ID":"20240611111405-z5mu6ly","Type":"NodeParagraph","Properties":{"id":"20240611111405-z5mu6ly","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"2、对胰蛋白酶的抑制作用 从冬瓜子中分离纯化出胰蛋白酶抑制剂，得到4个具有抑制胰蛋白酶活力的组分，其中两个组分属小分子胰蛋白酶抑制剂[2]。"}]},{"ID":"20240611111405-qfq8gso","Type":"NodeParagraph","Properties":{"id":"20240611111405-qfq8gso","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611111405-ewt3dpj","Type":"NodeParagraph","Properties":{"id":"20240611111405-ewt3dpj","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，用时捣碎。或用文火微炒至黄白色。置干燥处，防虫蛀及鼠咬。"}]},{"ID":"20240611111405-8cdex3l","Type":"NodeParagraph","Properties":{"id":"20240611111405-8cdex3l","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611111405-289mxmx","Type":"NodeParagraph","Properties":{"id":"20240611111405-289mxmx","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粗粉1g，加水20ml，煮沸10min，放冷，滤过。取滤液，置带塞的试管中，激烈振摇，产生持久性泡沫。（检查皂甙）"}]},{"ID":"20240611111405-ppb8s7v","Type":"NodeParagraph","Properties":{"id":"20240611111405-ppb8s7v","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611111405-bvzyolg","Type":"NodeParagraph","Properties":{"id":"20240611111405-bvzyolg","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 归肺；大肠经"}]},{"ID":"20240611111405-r05he1k","Type":"NodeParagraph","Properties":{"id":"20240611111405-r05he1k","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611111405-z48n54t","Type":"NodeParagraph","Properties":{"id":"20240611111405-z48n54t","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 味甘；性微寒"}]},{"ID":"20240611111405-x1511x8","Type":"NodeParagraph","Properties":{"id":"20240611111405-x1511x8","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611111405-71530ym","Type":"NodeParagraph","Properties":{"id":"20240611111405-71530ym","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《别录》：久服寒中。"}]},{"ID":"20240611111405-a2pklbe","Type":"NodeParagraph","Properties":{"id":"20240611111405-a2pklbe","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611111405-xan5rak","Type":"NodeParagraph","Properties":{"id":"20240611111405-xan5rak","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 清肺化痰；消痈排脓；利湿。主痰热咳嗽；肺痈；肠痈；白浊；带下；脚气；水肿；淋证"}]},{"ID":"20240611111405-57d5pxz","Type":"NodeParagraph","Properties":{"id":"20240611111405-57d5pxz","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611111405-6ttz1hr","Type":"NodeParagraph","Properties":{"id":"20240611111405-6ttz1hr","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g；或研末服。外用：适量，研膏涂敷"}]},{"ID":"20240611111405-ovs1wj2","Type":"NodeParagraph","Properties":{"id":"20240611111405-ovs1wj2","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611111405-35xdfd1","Type":"NodeParagraph","Properties":{"id":"20240611111405-35xdfd1","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：益气。"}]},{"ID":"20240611111405-kppbmp3","Type":"NodeParagraph","Properties":{"id":"20240611111405-kppbmp3","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"2.《别录》：主烦满不乐。"}]},{"ID":"20240611111405-m5zr7b3","Type":"NodeParagraph","Properties":{"id":"20240611111405-m5zr7b3","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"3.崔禹锡《食经》：利水道，去淡水。"}]},{"ID":"20240611111405-fynxpbg","Type":"NodeParagraph","Properties":{"id":"20240611111405-fynxpbg","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：去皮肤风剥黑GAN，润肌肤。"}]},{"ID":"20240611111405-3qklv62","Type":"NodeParagraph","Properties":{"id":"20240611111405-3qklv62","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"5.《纲目》：治肠痈。"}]},{"ID":"20240611111405-l2qy9di","Type":"NodeParagraph","Properties":{"id":"20240611111405-l2qy9di","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"6.《本草经疏》：能开胃醒脾。"}]},{"ID":"20240611111405-9ctqc40","Type":"NodeParagraph","Properties":{"id":"20240611111405-9ctqc40","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"7.《本草述》：主治心经蕴热，小水淋痛，并鼻面酒渣如麻豆，疼痛，黄水出。"}]},{"ID":"20240611111405-j8m8712","Type":"NodeParagraph","Properties":{"id":"20240611111405-j8m8712","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"8.《本草从新》：补肝明目。"}]},{"ID":"20240611111405-ab0fhpp","Type":"NodeParagraph","Properties":{"id":"20240611111405-ab0fhpp","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"9.《本草述钩元》：主腹内结聚，破溃脓血，凡肠胃内壅，最为要药。"}]},{"ID":"20240611111405-3cuczvi","Type":"NodeParagraph","Properties":{"id":"20240611111405-3cuczvi","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"10.陈念祖：能润肺化痰，兼益胃气。"}]},{"ID":"20240611111405-fx2ig0b","Type":"NodeParagraph","Properties":{"id":"20240611111405-fx2ig0b","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"11.《山东中药》:治肾脏炎，尿道炎,小便不利，脚气，水肿。"}]},{"ID":"20240611111405-kclw4s9","Type":"NodeParagraph","Properties":{"id":"20240611111405-kclw4s9","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"12.《中国药植图鉴》：罨痔疾肿痛，或洗涤。"}]},{"ID":"20240611111405-8z31qri","Type":"NodeParagraph","Properties":{"id":"20240611111405-8z31qri","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611111405-z6h4t2i","Type":"NodeParagraph","Properties":{"id":"20240611111405-z6h4t2i","updated":"20240611111405"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611111406-g0uhual","Type":"NodeThematicBreak","Properties":{"id":"20240611111406-g0uhual"}},{"ID":"20240611111407-rkbpeaj","Type":"NodeParagraph","Properties":{"id":"20240611111407-rkbpeaj"}}]}