:"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦菜 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦菜 14-20240813095909-pwdqfmf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 373px;\" parent-style=\"width: 383px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 791px;","style":"width: 781px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦菜 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦菜 1-20240813094439-r2os03y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 781px;\" parent-style=\"width: 791px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813094410-7005oc8","Type":"NodeParagraph","Properties":{"id":"20240813094410-7005oc8","updated":"20240813100009"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 502px;","style":"width: 492px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦菜"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦菜-20240813094410-q0b3qpo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 492px;\" parent-style=\"width: 502px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 653px;","style":"width: 643px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苦菜 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苦菜 15-20240813100009-c9edp76.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 643px;\" parent-style=\"width: 653px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621164612-nz8fmgu","Type":"NodeParagraph","Properties":{"id":"20240621164612-nz8fmgu","updated":"20240813103451"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：苦菜又名北败酱；"}]},{"ID":"20240611112046-8d2nyhz","Type":"NodeThematicBreak","Properties":{"id":"20240611112046-8d2nyhz"}},{"ID":"20240611112108-jre4v7s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112108-jre4v7s","updated":"20240611112108"},"Children":[{"Type":"NodeText","Data":"苦菜《神农本草经》"}]},{"ID":"20240611112108-9bxq42c","Type":"NodeParagraph","Properties":{"id":"20240611112108-9bxq42c","updated":"20240611112108"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240611112108-j4a7f03","Type":"NodeParagraph","Properties":{"id":"20240611112108-j4a7f03","updated":"20240611112108"},"Children":[{"Type":"NodeText","Data":"主五脏邪气，厌谷，胃痹。久服，安心益气，聪察少卧，轻身耐老。一名荼草，一名选。生川谷。"}]},{"ID":"20240611112108-xoz9gaj","Type":"NodeParagraph","Properties":{"id":"20240611112108-xoz9gaj","updated":"20240611112108"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名游冬，生益州山陵道旁，凌冬不死，三月三日采，阴干。"}]},{"ID":"20240611112108-7awunv9","Type":"NodeParagraph","Properties":{"id":"20240611112108-7awunv9","updated":"20240611112108"},"Children":[{"Type":"NodeText","Data":"案《说文》云：荼，苦菜也。《广雅》云：游冬，苦菜也。《尔雅》云：荼，苦菜，又槚，苦荼。郭璞云：树小如栀子，冬生叶，可煮作羹，今呼早莱者为荼，晚取者为茗，一名荈，蜀人名之苦菜。陶宏景云：此即是今茗，茗一名荼又令人不眠，亦凌冬不凋而兼其止，生益州，《唐本》注驳之非矣，选与荈，音相近。"}]},{"ID":"20240611112108-908blrg","Type":"NodeParagraph","Properties":{"id":"20240611112108-908blrg","updated":"20240611112108"},"Children":[{"Type":"NodeText","Data":"上菜，上品五种旧同。"}]},{"ID":"20240611112046-c42j9p0","Type":"NodeThematicBreak","Properties":{"id":"20240611112046-c42j9p0"}},{"ID":"20240611112052-bmo84aq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112052-bmo84aq","updated":"20240611112056"},"Children":[{"Type":"NodeText","Data":"苦菜《神农本草经赞》"}]},{"ID":"20240611112052-tdgl0l5","Type":"NodeParagraph","Properties":{"id":"20240611112052-tdgl0l5","updated":"20240611112052"},"Children":[{"Type":"NodeText","Data":"味苦寒。主五脏邪气。厌谷。胃痹。久服安心。益气聪察。少卧。轻身耐老。一名荼草。一名选。生山谷。"}]},{"ID":"20240611112052-9r63hu7","Type":"NodeParagraph","Properties":{"id":"20240611112052-9r63hu7","updated":"20240611112052"},"Children":[{"Type":"NodeText","Data":"菜美天香。游冬景迈。黄讹龙葵。白猜马薤。和米炊香。浮羹嚼快。如荠如饴。苦甘深喟。"}]},{"ID":"20240611112052-r8w4i2q","Type":"NodeParagraph","Properties":{"id":"20240611112052-r8w4i2q","updated":"20240611112052"},"Children":[{"Type":"NodeText","Data":"李时珍曰。一名天香菜。埤雅。此草经冬不凋。故名游冬。傅休弈歌。岁晏景迈。颜氏家训。江南别有苦菜。乃尔雅黄也。河北谓之龙葵。梁世讲礼者。以此当之大误。兼明书月令。孟夏苦菜秀。孔颖达云。菜似马薤而花白。味极苦。今验四月秀者。野人呼为苦。"}]},{"ID":"20240611112052-mmmtda0","Type":"NodeParagraph","Properties":{"id":"20240611112052-mmmtda0","updated":"20240611112052"},"Children":[{"Type":"NodeText","Data":"春初取煮和米粉作饼食之。月令所书苦菜。即苦也。颖达所见。别是一物。不可引以解此。黄正色诗。嫩绿浮羹让滑。王恽诗。今朝过喜一嚼快。诗。谁谓荼苦。其甘如荠。又堇荼如饴。李祁诗。幽然发深喟。"}]},{"ID":"20240611112118-9q3b27v","Type":"NodeThematicBreak","Properties":{"id":"20240611112118-9q3b27v"}},{"ID":"20240611112119-7vfj3pc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112119-7vfj3pc","updated":"20240611112122"},"Children":[{"Type":"NodeText","Data":"苦菜《本草衍义》"}]},{"ID":"20240611112119-utzw0ew","Type":"NodeParagraph","Properties":{"id":"20240611112119-utzw0ew","updated":"20240611112119"},"Children":[{"Type":"NodeText","Data":"四方皆有，在北道则冬方凋毙，生南方则冬夏常青。此《月令》小满节后，所谓苦菜秀者是此。叶如苦苣更狭，其绿色差淡，折之白乳汁出，常常点瘊子，自落。味苦，花与野菊相似，春、夏、秋皆旋开花。去中热，安心神。"}]},{"ID":"20240611112018-5ers9fg","Type":"NodeThematicBreak","Properties":{"id":"20240611112018-5ers9fg"}},{"ID":"20240611112040-5m0oqby","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112040-5m0oqby","updated":"20240611112044"},"Children":[{"Type":"NodeText","Data":"苦菜《冯氏锦囊秘录》"}]},{"ID":"20240611112040-2no62x6","Type":"NodeParagraph","Properties":{"id":"20240611112040-2no62x6","updated":"20240611112040"},"Children":[{"Type":"NodeText","Data":"与苦苣一物而形稍异，功用则相同也。禀天地之阴气，故味苦、气寒、无毒。入心、脾、肾三经。其主五脏邪气者，邪热容于心也，胃腑渴热中疾者，热在胃也。肠癖者热在大肠也，恶疮者热瘀伤血肉也，苦寒总除诸热，故主之也。热去则神自清，故久服安心益气，聪察少卧也。耐饥耐寒轻身不老者，总言其热退阴生。安心益气之机动也。"}]},{"ID":"20240611112040-asbme8f","Type":"NodeParagraph","Properties":{"id":"20240611112040-asbme8f","updated":"20240611112040"},"Children":[{"Type":"NodeText","Data":"苦菜，味苦，寒，无毒。主五脏邪气，厌谷胃痹肠 ，渴热中疾恶疮，久服安心益气，聪察少卧，耐饥耐寒轻身不老。"}]},{"ID":"20240611112018-ssw2i9f","Type":"NodeThematicBreak","Properties":{"id":"20240611112018-ssw2i9f"}},{"ID":"20240611112029-1nrw6pd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112029-1nrw6pd","updated":"20240611112035"},"Children":[{"Type":"NodeText","Data":"苦菜《千金翼方》"}]},{"ID":"20240611112029-5pu8odt","Type":"NodeParagraph","Properties":{"id":"20240611112029-5pu8odt","updated":"20240611112029"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主五脏邪气，厌谷，胃痹肠 ，渴，热中疾，恶疮。久服安心益气，聪察，少卧，轻身耐老，耐饥寒，高气不老。一名荼苦，一名选，一名游冬。生益州川谷山陵道旁，凌冬不死，三月三日采，阴干。"}]},{"ID":"20240611112029-bembaf1","Type":"NodeParagraph","Properties":{"id":"20240611112029-bembaf1","updated":"20240611112029"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荠"}]},{"ID":"20240611112029-cprv6tw","Type":"NodeParagraph","Properties":{"id":"20240611112029-cprv6tw","updated":"20240611112029"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主利肝气，和中。其实主明目，目痛。"}]},{"ID":"20240611112019-86hpi20","Type":"NodeThematicBreak","Properties":{"id":"20240611112019-86hpi20"}},{"ID":"20240611112020-ktsgab7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112020-ktsgab7","updated":"20240611112023"},"Children":[{"Type":"NodeText","Data":"苦菜《本草求真》"}]},{"ID":"20240611112020-wugo3gs","Type":"NodeParagraph","Properties":{"id":"20240611112020-wugo3gs","updated":"20240611112020"},"Children":[{"Type":"NodeText","Data":"（柔滑）解心胃大肠热"}]},{"ID":"20240611112020-wx5xyjh","Type":"NodeParagraph","Properties":{"id":"20240611112020-wx5xyjh","updated":"20240611112020"},"Children":[{"Type":"NodeText","Data":"苦菜（专入心胃大肠）。禀气至阴。故味苦寒而不温。而经所列病症。有言能治五脏邪气者。邪热客于心也。胃痹渴热中痰者。热在胃也。肠 者。热在大肠也。恶疮者。热瘀伤血肉也。苦寒总除诸热。故主之也。热去则神自清。故久服安心益气。聪明少卧也。耐饥耐寒。轻身不老者。总言其热去阴生。心安气益之神功也。此与苦苣同为一物。而形色稍异。治与苦苣相同。（宗 曰。苦苣捣汁。敷疔疮殊验。青茵阴干。以备冬月。为末水调敷之。杂记云。凡病痔者。宜用苦苣菜。或鲜或干。煮至熟烂。连汤置器中。横安一板坐之。先熏后洗。冷即止。日洗数次。屡用有效。）但脾胃虚人切忌。（张机曰。野苣不可共蜜食。令人作肉痔。士良曰。蚕蛾出时不可 取。令蛾子青烂。蚕妇亦忌食之。）"}]},{"ID":"20240611111949-7yu2ovo","Type":"NodeThematicBreak","Properties":{"id":"20240611111949-7yu2ovo"}},{"ID":"20240611112002-m8y2umx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611112002-m8y2umx","updated":"20240611112008"},"Children":[{"Type":"NodeText","Data":"苦菜《新修本草》"}]},{"ID":"20240611112002-z35rok8","Type":"NodeParagraph","Properties":{"id":"20240611112002-z35rok8","updated":"20240611112002"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主五脏邪气，厌谷胃痹，肠 ，渴热中疾，恶疮。久服安心益气，聪察，少卧，轻身耐老，耐饥寒，高气不老。一名荼草，一名选，一名游冬。生益州川谷，生山陵道旁，凌冬不死。三月三日采，阴干。"}]},{"ID":"20240611112002-w1jg4mk","Type":"NodeParagraph","Properties":{"id":"20240611112002-w1jg4mk","updated":"20240611112002"},"Children":[{"Type":"NodeText","Data":"疑此则是今茗。茗一名荼，又令人不眠，亦凌冬不凋，而嫌其止生益州。益州乃有苦菜，正英下，以注之。《桐君药录》云∶苦菜叶三月生扶疏，六月华从叶出，茎直花黄，八月实黑；实落根复生，冬不枯。今茗极似此，西阳武昌及庐江晋熙茗皆好，东人止作青茗。茗皆有 ，饮之宜人。凡所饮物，有茗及木叶天门冬苗，并菝 ，皆益人，余物并冷利。又巴东间别有真荼，火 作卷结，为饮亦令人不眠，恐或者此。俗中多煮檀叶及大皂李作荼饮，并冷。又南方有瓜芦木，亦似茗，至苦涩。取其叶作屑，煮饮汁，即通夜不眠；煮盐人唯资此饮尔，交广最所重，客来先设，乃加以香 辈耳。"}]},{"ID":"20240611112002-34kku8q","Type":"NodeParagraph","Properties":{"id":"20240611112002-34kku8q","updated":"20240611112002"},"Children":[{"Type":"NodeText","Data":"〔谨案〕苦菜，《诗》云∶谁谓荼苦；又云∶堇荼如饴，皆苦菜异名也。陶谓之茗，茗乃木类，殊非菜流。茗，春采为苦 。 音迟遐反，非途音也。案《尔雅·释草》云∶荼，苦菜。释木云∶ ，苦。二物全别，不得为例。又《颜氏家训》案《易统通卦验玄图》曰∶苦菜生于寒秋，经冬历春，得夏乃成。一名游冬。叶似苦苣而细，断之而有白汁，花黄似菊。此则与桐君略同，今所在有之也。苦 乃龙葵耳，俗亦名苦菜，非荼也。"}]},{"ID":"20240611111829-1vm3u16","Type":"NodeThematicBreak","Properties":{"id":"20240611111829-1vm3u16"}},{"ID":"20240611111946-o36jh81","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111946-o36jh81","updated":"20240611111955"},"Children":[{"Type":"NodeText","Data":"苦菜《医学入门》"}]},{"ID":"20240611111946-bjlj4xx","Type":"NodeParagraph","Properties":{"id":"20240611111946-bjlj4xx","updated":"20240611111946"},"Children":[{"Type":"NodeText","Data":"即小满节后苦菜秀者是也。茎似苦苣而细，折之白汁出，常常点瘊子自落。花黄似菊，凌冬不死。"}]},{"ID":"20240611111946-y7pkf5m","Type":"NodeParagraph","Properties":{"id":"20240611111946-y7pkf5m","updated":"20240611111946"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主五脏邪气，厌谷胃痹，肠 渴热，中疾恶疮，久服安心益气，聪察少卧。三月三日采，阴干。"}]},{"ID":"20240611111932-a19wahx","Type":"NodeThematicBreak","Properties":{"id":"20240611111932-a19wahx"}},{"ID":"20240611111937-jli0nov","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111937-jli0nov","updated":"20240611111942"},"Children":[{"Type":"NodeText","Data":"苦菜《证类本草》"}]},{"ID":"20240611111937-grd89q7","Type":"NodeParagraph","Properties":{"id":"20240611111937-grd89q7","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主五脏邪气，厌（于协切）伏也谷胃痹，肠 ，渴热中疾，恶疮。久服安心益气，聪察，少卧，轻身耐老，耐饥寒，高气不老。一名荼草，一名选，一名游冬。"}]},{"ID":"20240611111937-v98ykp3","Type":"NodeParagraph","Properties":{"id":"20240611111937-v98ykp3","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"生益州川谷，山陵道旁，凌冬不死。三月三日采，阴干。"}]},{"ID":"20240611111937-n0la544","Type":"NodeParagraph","Properties":{"id":"20240611111937-n0la544","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶疑此即是今茗。茗一名荼，又令人不眠，亦凌冬不凋，而嫌其只生益州。益州乃有苦菜，正是苦 （音式）尔。上卷上品白英下已注之。《桐君录》云∶苦菜，三月生扶疏，六月花从叶出，茎直黄，八月实黑；实落根复生，冬不枯。今茗极似此，西阳、武昌及庐江、晋熙皆好，东人正作青茗。茗皆有 ，饮之宜人。凡所饮物，有茗及木叶、天门冬苗，并菝，皆益人，余物并冷利。又巴东间别有真茶，火 作卷结，为饮亦令人不眠，恐或者此。俗中多煮檀叶及大皂李作茶，并冷。又南方∶有瓜芦木，亦似茗，苦涩。取其叶作屑，煮饮汁，即通夜不睡。煮盐人唯资此饮，而交、广最所重，客来先设，乃加以香 （音耄）辈。"}]},{"ID":"20240611111937-et6uwai","Type":"NodeParagraph","Properties":{"id":"20240611111937-et6uwai","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"唐谁谓荼苦。又云∶堇荼如饴，皆苦菜异名也。陶谓之茗，茗乃木类，殊非菜流。茗，春采为苦荼。音迟遐反，非途音也。按∶《尔雅》释草云∶荼，苦菜。"}]},{"ID":"20240611111937-l3itll2","Type":"NodeParagraph","Properties":{"id":"20240611111937-l3itll2","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"释木云∶ 、苦荼，二物全别，不得为例。又《颜氏家训》按《易通卦验玄图》曰∶苦菜，生乃成。一名游冬。叶似苦苣而细，断之有白汁，花黄似菊。此则与桐君略同，今所在有之。苦 乃龙葵尔，俗亦名苦菜，非荼也。臣禹锡等谨按蜀本图经云∶春花夏实，至秋复生，花而不实，经冬不凋。陈藏器云∶苦 ，味苦，寒，有小毒。捣叶敷小儿闪癖，煮汁服，去暴热目黄，秘塞。叶极似龙葵，但龙葵子无壳，苦 子有壳，苏云是龙葵，误也。人亦呼为小苦耽。崔豹《古今注》云∶苦 ，一名 子，有实形如皮弁，子圆如珠。"}]},{"ID":"20240611111937-u8j6frs","Type":"NodeParagraph","Properties":{"id":"20240611111937-u8j6frs","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"月令王瓜生，苦菜秀。"}]},{"ID":"20240611111937-9z813fk","Type":"NodeParagraph","Properties":{"id":"20240611111937-9z813fk","updated":"20240611111937"},"Children":[{"Type":"NodeText","Data":"衍义曰∶苦菜，四方∶皆有，在北道则冬方∶雕毙，生南方∶则冬夏常青。此《月令》小满节后，所谓苦菜秀者是此。叶如苦苣，更狭，其绿色差淡，折之白乳汁出，常常点瘊子，自落。味苦，花与野菊相似，春、夏、秋皆旋开花。去中热，安心神。"}]},{"ID":"20240611111905-matsjmo","Type":"NodeThematicBreak","Properties":{"id":"20240611111905-matsjmo"}},{"ID":"20240611111909-318xp11","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111909-318xp11","updated":"20240611111920"},"Children":[{"Type":"NodeText","Data":"苦菜《名医别录》"}]},{"ID":"20240611111909-979bxu9","Type":"NodeParagraph","Properties":{"id":"20240611111909-979bxu9","updated":"20240611111909"},"Children":[{"Type":"NodeText","Data":"无毒。主治肠澼，渴热，中疾，恶疮。久服耐饥寒，高气不老。一名游冬。生益州，生山陵道旁，凌冬不死。三月三日采，阴干。"}]},{"ID":"20240611111909-sk0mff8","Type":"NodeParagraph","Properties":{"id":"20240611111909-sk0mff8","updated":"20240611111909"},"Children":[{"Type":"NodeText","Data":"《本经》原文：苦菜，味苦，寒。主五脏邪气，厌谷胃痹。久服，安心益气，聪察少卧，轻身耐老。一名荼草。一名选。生川谷。"}]},{"ID":"20240611111829-kgxk1q6","Type":"NodeThematicBreak","Properties":{"id":"20240611111829-kgxk1q6"}},{"ID":"20240611111842-0ypwtmw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111842-0ypwtmw","updated":"20240611111903"},"Children":[{"Type":"NodeText","Data":"苦菜《本草纲目》"}]},{"ID":"20240611111842-uzms7ts","Type":"NodeParagraph","Properties":{"id":"20240611111842-uzms7ts","updated":"20240611111842"},"Children":[{"Type":"NodeText","Data":"「释名」名荼、苦苣、苦荬、游冬、褊巨、老鹳菜、天香菜。"}]},{"ID":"20240611111842-4x9je81","Type":"NodeParagraph","Properties":{"id":"20240611111842-4x9je81","updated":"20240611111842"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611111842-5iz1axz","Type":"NodeParagraph","Properties":{"id":"20240611111842-5iz1axz","updated":"20240611111842"},"Children":[{"Type":"NodeText","Data":"1、血淋、尿血。用苦荬一把，加酒、水各半煎服。"}]},{"ID":"20240611111842-fffrhqt","Type":"NodeParagraph","Properties":{"id":"20240611111842-fffrhqt","updated":"20240611111842"},"Children":[{"Type":"NodeText","Data":"2、喉痹。用若荬捣汁半碗，加开水泡灯心取汁半碗，调匀服。"}]},{"ID":"20240611111842-pwyban2","Type":"NodeParagraph","Properties":{"id":"20240611111842-pwyban2","updated":"20240611111842"},"Children":[{"Type":"NodeText","Data":"3、对口恶疮。用苦荬捣汁一碗，加姜汁一匙，酒送服。同时以药渣敷沧一、二次，即愈。"}]},{"ID":"20240611111842-to1qwhe","Type":"NodeParagraph","Properties":{"id":"20240611111842-to1qwhe","updated":"20240611111842"},"Children":[{"Type":"NodeText","Data":"4、赤白痢。用苦荬根煮服。"}]},{"ID":"20240611111830-nelzmr5","Type":"NodeThematicBreak","Properties":{"id":"20240611111830-nelzmr5"}},{"ID":"20240611111831-vuulmuw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111831-vuulmuw","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：苦菜"}]},{"ID":"20240611111831-22t039z","Type":"NodeParagraph","Properties":{"id":"20240611111831-22t039z","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611111831-2aj4h6a","Type":"NodeParagraph","Properties":{"id":"20240611111831-2aj4h6a","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" Kǔ Cài"}]},{"ID":"20240611111831-zdss0y0","Type":"NodeParagraph","Properties":{"id":"20240611111831-zdss0y0","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611111831-nlk8s00","Type":"NodeParagraph","Properties":{"id":"20240611111831-nlk8s00","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 败酱草[东北]、苦叶苗、活血草、苦丁菜、苦麻菜、小苦苣、黄鼠草"}]},{"ID":"20240611111831-k6fq47f","Type":"NodeParagraph","Properties":{"id":"20240611111831-k6fq47f","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611111831-0y0xai4","Type":"NodeParagraph","Properties":{"id":"20240611111831-0y0xai4","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 菊科野苦荬属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"山苦荬"},{"Type":"NodeText","Data":"Ixeris chinensis （Thunb.）Nakai，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。春夏秋均可采收，鲜用或晒干。"}]},{"ID":"20240611111831-ppvlpm5","Type":"NodeParagraph","Properties":{"id":"20240611111831-ppvlpm5","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611111831-ijnf75q","Type":"NodeParagraph","Properties":{"id":"20240611111831-ijnf75q","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611111831-orbxcz9","Type":"NodeParagraph","Properties":{"id":"20240611111831-orbxcz9","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611111831-npz2ir3","Type":"NodeParagraph","Properties":{"id":"20240611111831-npz2ir3","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 清热解毒，破瘀活血，排脓。用于阑尾炎，腹腔脓肿，肠炎，痢疾，急、慢性盆腔炎，肺热咳嗽，肺结核，吐血，衄血；外用治跌打损伤，疮疖肿痛，黄水疮，阴囊湿疹。"}]},{"ID":"20240611111831-hi8iend","Type":"NodeParagraph","Properties":{"id":"20240611111831-hi8iend","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611111831-zp32uwg","Type":"NodeParagraph","Properties":{"id":"20240611111831-zp32uwg","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 3～5钱。外用适量，鲜品捣烂敷，或干品研粉，香油调敷患处。"}]},{"ID":"20240611111831-ra6nbo1","Type":"NodeParagraph","Properties":{"id":"20240611111831-ra6nbo1","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611111831-rjsn39m","Type":"NodeParagraph","Properties":{"id":"20240611111831-rjsn39m","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611111831-jo2vk2k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111831-jo2vk2k","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：苦菜"}]},{"ID":"20240611111831-h8fapb9","Type":"NodeParagraph","Properties":{"id":"20240611111831-h8fapb9","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611111831-8vi17g7","Type":"NodeParagraph","Properties":{"id":"20240611111831-8vi17g7","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" Kǔ Cài"}]},{"ID":"20240611111831-ymwciov","Type":"NodeParagraph","Properties":{"id":"20240611111831-ymwciov","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611111831-ue5tzv0","Type":"NodeParagraph","Properties":{"id":"20240611111831-ue5tzv0","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 荼、芑（《诗经》），荼草、选（《本经》），游冬（《别录》），野苦马（《普济方》），青菜、紫苦菜（《滇南本草》），堇菜（《品汇精要》），苦苣、苦荬、天香菜（《纲目》），老鸦苦荬（《医林纂要》），滇苦菜、苦马菜（《植物名实图考》）。"}]},{"ID":"20240611111831-bxfb85o","Type":"NodeParagraph","Properties":{"id":"20240611111831-bxfb85o","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611111831-svmpj5u","Type":"NodeParagraph","Properties":{"id":"20240611111831-svmpj5u","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611111831-9cohd7c","Type":"NodeParagraph","Properties":{"id":"20240611111831-9cohd7c","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611111831-6nyidd0","Type":"NodeParagraph","Properties":{"id":"20240611111831-6nyidd0","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苦苣菜"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240611111831-esrnumc","Type":"NodeParagraph","Properties":{"id":"20240611111831-esrnumc","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611111831-guunlro","Type":"NodeParagraph","Properties":{"id":"20240611111831-guunlro","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 生长于路边及田野间，我国大部地区均有分布。"}]},{"ID":"20240611111831-p5edva9","Type":"NodeParagraph","Properties":{"id":"20240611111831-p5edva9","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611111831-1fi6xzs","Type":"NodeParagraph","Properties":{"id":"20240611111831-1fi6xzs","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 苦苣菜（《纲目》）"}]},{"ID":"20240611111831-jrjgbay","Type":"NodeParagraph","Properties":{"id":"20240611111831-jrjgbay","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"一年至二年生草本，高50～100厘米。茎直立，中空，具乳汁；基部无毛，顶端及中上部或具有稀疏的腺毛。叶互生；长椭圆状广披针形，长15～28厘米，宽3～6厘米，羽裂或提琴状羽裂，边缘具不整齐的刺状尖齿；基部叶有短柄，茎上叶无柄、呈耳廓状抱茎。头状花序数枚，顶生，直径约2厘米。总苞圆筒状，长12～15毫米，基部具有脱落性的绢状毛，内层苞片线状披针形，先端尖锐，具疏生的长毛；花全部为舌状，黄色；雄蕊5；子房下位，花柱细长，柱头2深裂。瘦果倒卵状椭圆形，扁平，每面除有3条明显的纵纹外，并有粗糙的横纹，成熟后红褐色。冠毛白色，细软。花期4～6月。"}]},{"ID":"20240611111831-m73zrko","Type":"NodeParagraph","Properties":{"id":"20240611111831-m73zrko","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611111831-bno12vn","Type":"NodeParagraph","Properties":{"id":"20240611111831-bno12vn","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 全草（产于澳大利亚者）含抗肿瘤成分，在小鼠大腿肌肉接种肉瘤-37后第6天，皮下注射苦菜的酸性提取物，6～8小时后杀死小鼠，肉眼及显微镜观察，均可见到肉瘤受到明显的伤害（出血、坏死等）。"}]},{"ID":"20240611111831-twwn7f0","Type":"NodeParagraph","Properties":{"id":"20240611111831-twwn7f0","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611111831-mnxrt62","Type":"NodeParagraph","Properties":{"id":"20240611111831-mnxrt62","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"入心、脾、胃三经。\""}]},{"ID":"20240611111831-8ymh274","Type":"NodeParagraph","Properties":{"id":"20240611111831-8ymh274","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入心、胃、大肠。\""}]},{"ID":"20240611111831-rerrc8p","Type":"NodeParagraph","Properties":{"id":"20240611111831-rerrc8p","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611111831-gejicir","Type":"NodeParagraph","Properties":{"id":"20240611111831-gejicir","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240611111831-0e267gl","Type":"NodeParagraph","Properties":{"id":"20240611111831-0e267gl","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240611111831-dxdbyre","Type":"NodeParagraph","Properties":{"id":"20240611111831-dxdbyre","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611111831-0yjfjdw","Type":"NodeParagraph","Properties":{"id":"20240611111831-0yjfjdw","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611111831-rny76r2","Type":"NodeParagraph","Properties":{"id":"20240611111831-rny76r2","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" ①《本草经疏》：\"脾胃虚寒者忌之。\""}]},{"ID":"20240611111831-ehk6hid","Type":"NodeParagraph","Properties":{"id":"20240611111831-ehk6hid","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"②《随息居饮食谱》：\"不可共蜜食。\""}]},{"ID":"20240611111831-5grj5nr","Type":"NodeParagraph","Properties":{"id":"20240611111831-5grj5nr","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611111831-beknp1j","Type":"NodeParagraph","Properties":{"id":"20240611111831-beknp1j","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 清热，凉血，解毒。治痢疾，黄疸，血淋，痔瘘，疔肿，蛇咬。"}]},{"ID":"20240611111831-1frau0k","Type":"NodeParagraph","Properties":{"id":"20240611111831-1frau0k","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五藏邪气，厌谷胃痹。\""}]},{"ID":"20240611111831-772gctj","Type":"NodeParagraph","Properties":{"id":"20240611111831-772gctj","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗肠澼，渴，热中疾，恶疮。耐饥寒。\""}]},{"ID":"20240611111831-5awc8d5","Type":"NodeParagraph","Properties":{"id":"20240611111831-5awc8d5","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"敷蛇咬。\""}]},{"ID":"20240611111831-f7ok7mg","Type":"NodeParagraph","Properties":{"id":"20240611111831-f7ok7mg","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"④《本草衍义》：\"折之白乳汁出，常常点瘊子自落。\""}]},{"ID":"20240611111831-xckjipa","Type":"NodeParagraph","Properties":{"id":"20240611111831-xckjipa","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"凉血热，寒胃，发肚腹中诸积，利小便。\""}]},{"ID":"20240611111831-p604yc9","Type":"NodeParagraph","Properties":{"id":"20240611111831-p604yc9","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑥《本草会编》：\"明目，主诸痢。\""}]},{"ID":"20240611111831-uof02gd","Type":"NodeParagraph","Properties":{"id":"20240611111831-uof02gd","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"治血淋痔瘘。\""}]},{"ID":"20240611111831-es411r5","Type":"NodeParagraph","Properties":{"id":"20240611111831-es411r5","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑧《医林纂要》：\"泻心解暑，去热除烦，通乳。\""}]},{"ID":"20240611111831-8tc4m9x","Type":"NodeParagraph","Properties":{"id":"20240611111831-8tc4m9x","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611111831-gp9tfme","Type":"NodeParagraph","Properties":{"id":"20240611111831-gp9tfme","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤、打汁或研末。外用：捣汁涂或煎水熏洗。"}]},{"ID":"20240611111831-h6f0hij","Type":"NodeParagraph","Properties":{"id":"20240611111831-h6f0hij","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611111831-1dg0p6p","Type":"NodeParagraph","Properties":{"id":"20240611111831-1dg0p6p","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" ①治肝硬化：苦莱、酢浆草各一两。同猪肉炖服。（江西）"}]},{"ID":"20240611111831-pw96q2q","Type":"NodeParagraph","Properties":{"id":"20240611111831-pw96q2q","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"②治朴蛇瘴：野苦马汁、灯心（浸水良久捻其末）。和朋之。（《普济方》）"}]},{"ID":"20240611111831-a4op501","Type":"NodeParagraph","Properties":{"id":"20240611111831-a4op501","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"③治慢性气管炎：苦菜一斤，大枣二十个。苦菜煎烂，取煎液煮大枣，待枣皮展开后取出，余液熬成膏。早晚各服药膏一匙，大枣一枚。（内蒙古《中草药新医疗法资料选编》："}]},{"ID":"20240611111831-3c2oqfu","Type":"NodeParagraph","Properties":{"id":"20240611111831-3c2oqfu","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"④治小儿疳积：苦菜一两，同猪肝炖服。（江西）"}]},{"ID":"20240611111831-eq98yyz","Type":"NodeParagraph","Properties":{"id":"20240611111831-eq98yyz","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑤治对口恶疮：野苦荬擂汁一钟，入姜汁一匙，酒和服以渣敷。（《唐瑶经验方》）"}]},{"ID":"20240611111831-u8inc6q","Type":"NodeParagraph","Properties":{"id":"20240611111831-u8inc6q","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑥治壶蜂叮螫：苦菜汁涂之。（《摘元方》）"}]},{"ID":"20240611111831-5n81n7p","Type":"NodeParagraph","Properties":{"id":"20240611111831-5n81n7p","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"⑦治妇人乳结红肿疼痛：紫苦菜捣汁水煎，点水酒服。（《滇南本草》）"}]},{"ID":"20240611111831-1fyb1so","Type":"NodeParagraph","Properties":{"id":"20240611111831-1fyb1so","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611111831-dvikdj7","Type":"NodeParagraph","Properties":{"id":"20240611111831-dvikdj7","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611111831-0sd903k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611111831-0sd903k","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"《中华本草》：苦菜"}]},{"ID":"20240611111831-9eqq2b5","Type":"NodeParagraph","Properties":{"id":"20240611111831-9eqq2b5","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611111831-sv9946o","Type":"NodeParagraph","Properties":{"id":"20240611111831-sv9946o","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" Kǔ Cài"}]},{"ID":"20240611111831-m4we65g","Type":"NodeParagraph","Properties":{"id":"20240611111831-m4we65g","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611111831-5o6o23o","Type":"NodeParagraph","Properties":{"id":"20240611111831-5o6o23o","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 荼草、选、游冬、苦马菜、老鸦苦荬、滇苦菜"}]},{"ID":"20240611111831-7omffjk","Type":"NodeParagraph","Properties":{"id":"20240611111831-7omffjk","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611111831-vxva7eo","Type":"NodeParagraph","Properties":{"id":"20240611111831-vxva7eo","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" Herb of Common sowthistle"}]},{"ID":"20240611111831-hyke40j","Type":"NodeParagraph","Properties":{"id":"20240611111831-hyke40j","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611111831-so3syqj","Type":"NodeParagraph","Properties":{"id":"20240611111831-so3syqj","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》。"}]},{"ID":"20240611111831-u8gof4i","Type":"NodeParagraph","Properties":{"id":"20240611111831-u8gof4i","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：苦菜，生益州川谷、山陵、道旁。凌冬不死。三月三日采，阴干。"}]},{"ID":"20240611111831-7ywfve6","Type":"NodeParagraph","Properties":{"id":"20240611111831-7ywfve6","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：《桐君录》云，苦菜三月生，扶疏，六月花从叶出，茎直花黄，八月实黑，实落根复生，冬不枯。今茗极似此。"}]},{"ID":"20240611111831-wrcnwkd","Type":"NodeParagraph","Properties":{"id":"20240611111831-wrcnwkd","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：茗乃木类，殊非菜流，茗春采为苦荼。按《尔雅·释草》云，荼，苦菜。《释木》云，槚，苦荼。二物全别，不得比例。又《颜氏家训》按《易通卦验·玄图》曰，苦菜生于寒秋"}]},{"ID":"20240611111831-8oea1rt","Type":"NodeParagraph","Properties":{"id":"20240611111831-8oea1rt","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611111831-qbnhye1","Type":"NodeParagraph","Properties":{"id":"20240611111831-qbnhye1","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物苦苣菜的全草。"}]},{"ID":"20240611111831-6gpp8si","Type":"NodeParagraph","Properties":{"id":"20240611111831-6gpp8si","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Sonchus oleraceus L."}]},{"ID":"20240611111831-84mvoc8","Type":"NodeParagraph","Properties":{"id":"20240611111831-84mvoc8","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"采收和储藏：冬、春、夏三季均可采收，鲜用或晒干。"}]},{"ID":"20240611111831-nl8yy0z","Type":"NodeParagraph","Properties":{"id":"20240611111831-nl8yy0z","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611111831-ls26lwx","Type":"NodeParagraph","Properties":{"id":"20240611111831-ls26lwx","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于田边、山野、路旁。"}]},{"ID":"20240611111831-bdqfgwk","Type":"NodeParagraph","Properties":{"id":"20240611111831-bdqfgwk","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于全国各地。"}]},{"ID":"20240611111831-njf6hx5","Type":"NodeParagraph","Properties":{"id":"20240611111831-njf6hx5","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611111831-0gj6r78","Type":"NodeParagraph","Properties":{"id":"20240611111831-0gj6r78","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 苦蕊菜 一或二年生草本，高30-100cm。根纺锤状。茎直立，中空，不分枝或上部分枝，无毛或上部有腺毛，具乳汁。叶互生；下部叶叶柄有翅，基部扩大抱茎，中上部无柄，基部宽大戟耳形，叶柔软无毛，大头状羽状全裂或羽状半裂，顶裂片大或先端裂片与侧生裂片等大，少有不分裂叶，边缘有刺状尖齿，长10-18（-22）cm，宽5-7（-12）cm。头状花序，顶生，数枚，排列成伞房状；梗或总苞下部初期有蛛丝状毛，有时有疏腺毛；总苞钟状，长10-12mm，宽6-10(-25)mm，暗绿色，总苞片2-3列；舌状花黄色，两性结实；雄蕊5；子房下位花柱细长，柱头2深裂。瘦果，长椭圆状倒卵形，压扁，亮褐色、褐色或肉色，边缘有微齿，两面各有3条高起的纵肋，肋间有细皱纹；成熟后红褐色，冠毛白色，毛状，细状，细软。花期4-6月。"}]},{"ID":"20240611111831-xk8m1js","Type":"NodeParagraph","Properties":{"id":"20240611111831-xk8m1js","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611111831-qhu6k74","Type":"NodeParagraph","Properties":{"id":"20240611111831-qhu6k74","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根呈纺锤形，灰褐色，有多数须根。茎呈圆柱形，上部呈压扁状，长45-95cm，直径4-8mm，表面黄绿色，茎基部略带淡紫色，具纵棱，上部有暗褐色腺毛；质脆，易折断，断面中空。叶互生，皱缩破碎，完整叶展平后呈椭圆状广披针形，琴状羽裂，裂片边缘有不整齐的短刺状齿。有的在茎顶可见头状花序，舌状花天酒地淡黄色，或有的已结果。气微，味微咸。"}]},{"ID":"20240611111831-ljoskbv","Type":"NodeParagraph","Properties":{"id":"20240611111831-ljoskbv","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611111831-ahdpll1","Type":"NodeParagraph","Properties":{"id":"20240611111831-ahdpll1","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 本品地上部分含一新二糖类化合物，还含苦苣菜甙（sonchuside）A、B、C、D，葡萄糖中美菊素（glucoza-luzanin）C，9-羟基葡萄糖中美菊素（macroliniside）A，假还阳参甙（crepidiaside）A及毛连菜甙（picriside）B、C。木犀草素-7-O-吡喃葡萄糖甙（cinaroside），金丝桃甙（hyperoside），蒙花甙（linarin），芹菜素（apigenin），槲皮素（quercetin），山柰酚（kaempferol）。"}]},{"ID":"20240611111831-eu9fs8t","Type":"NodeParagraph","Properties":{"id":"20240611111831-eu9fs8t","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"花中分到木犀草素（luteolin），槲皮素，槲皮黄甙（quercimer-itrin），木犀草素-7-O-吡喃葡萄糖甙，木犀草素-7-O-呋喃葡萄糖甙（isocynaroside）及木犀草素-7-β-D-glucuronopyranoside。"}]},{"ID":"20240611111831-n3rdhgo","Type":"NodeParagraph","Properties":{"id":"20240611111831-n3rdhgo","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"种子油中含玟鸠菊酸（vernolic acid ）13.7%。"}]},{"ID":"20240611111831-rcist28","Type":"NodeParagraph","Properties":{"id":"20240611111831-rcist28","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"叶中还含维生素（vitamin）C。"}]},{"ID":"20240611111831-63rklxr","Type":"NodeParagraph","Properties":{"id":"20240611111831-63rklxr","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611111831-nn9y29n","Type":"NodeParagraph","Properties":{"id":"20240611111831-nn9y29n","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 全草（产于澳大利亚者）含抗肿瘤成分，在小鼠大腿肌肉接种肉瘤-37后第六天，皮下注射苦茶的酸性提取物，6-48小时后杀死小鼠，肉眼及显微及显微镜观察，均可见到肉瘤受到明显的伤害（出血、坏死）。"}]},{"ID":"20240611111831-7gxpkml","Type":"NodeParagraph","Properties":{"id":"20240611111831-7gxpkml","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611111831-ropzmbf","Type":"NodeParagraph","Properties":{"id":"20240611111831-ropzmbf","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 归心；脾；胃；大肠经"}]},{"ID":"20240611111831-n91k2uz","Type":"NodeParagraph","Properties":{"id":"20240611111831-n91k2uz","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611111831-lz4eq8a","Type":"NodeParagraph","Properties":{"id":"20240611111831-lz4eq8a","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒"}]},{"ID":"20240611111831-kzxp7l8","Type":"NodeParagraph","Properties":{"id":"20240611111831-kzxp7l8","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611111831-sgnhgvm","Type":"NodeParagraph","Properties":{"id":"20240611111831-sgnhgvm","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 1.《本草经疏》：脾胃虚寒者忌之。"}]},{"ID":"20240611111831-ef8otp6","Type":"NodeParagraph","Properties":{"id":"20240611111831-ef8otp6","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"2.《随息居饮食谱》：不可共蜜食。"}]},{"ID":"20240611111831-e905t9e","Type":"NodeParagraph","Properties":{"id":"20240611111831-e905t9e","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611111831-v9c0ptl","Type":"NodeParagraph","Properties":{"id":"20240611111831-v9c0ptl","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 清热解毒；凉血止血。主肠炎；痢疾；黄疸；淋证；咽喉肿痛；痈疮肿毒；乳腺炎；痔瘘；吐血；衄血；咯血；尿血；便血；崩漏"}]},{"ID":"20240611111831-stohqby","Type":"NodeParagraph","Properties":{"id":"20240611111831-stohqby","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611111831-fflsh97","Type":"NodeParagraph","Properties":{"id":"20240611111831-fflsh97","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g。外用：适量，鲜品捣敷；或煎汤熏洗；或取汁涂搽。"}]},{"ID":"20240611111831-gm6f2b1","Type":"NodeParagraph","Properties":{"id":"20240611111831-gm6f2b1","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611111831-9m59r6l","Type":"NodeParagraph","Properties":{"id":"20240611111831-9m59r6l","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主五藏邪气，厌谷胃痹。"}]},{"ID":"20240611111831-hnwp85b","Type":"NodeParagraph","Properties":{"id":"20240611111831-hnwp85b","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：疗肠澼，渴，热中疾，恶疮。耐饥寒。"}]},{"ID":"20240611111831-s5krah5","Type":"NodeParagraph","Properties":{"id":"20240611111831-s5krah5","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：敷蛇咬。"}]},{"ID":"20240611111831-otl57e6","Type":"NodeParagraph","Properties":{"id":"20240611111831-otl57e6","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"4.《本草衍义》：折之白乳汁出，常常点瘊子自落。"}]},{"ID":"20240611111831-vm4rmxd","Type":"NodeParagraph","Properties":{"id":"20240611111831-vm4rmxd","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：凉血热，寒胃，发肚腹中诸积，利小便。"}]},{"ID":"20240611111831-xxmc4vi","Type":"NodeParagraph","Properties":{"id":"20240611111831-xxmc4vi","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"6.《本草会编》：明目，主诸痢。"}]},{"ID":"20240611111831-r21giq3","Type":"NodeParagraph","Properties":{"id":"20240611111831-r21giq3","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"7.《本草纲目》：治血淋痔瘘。"}]},{"ID":"20240611111831-sbow9a1","Type":"NodeParagraph","Properties":{"id":"20240611111831-sbow9a1","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"8.《医林纂要》：泻心解暑，去热除烦，通乳。"}]},{"ID":"20240611111831-haynwbi","Type":"NodeParagraph","Properties":{"id":"20240611111831-haynwbi","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611111831-h0hzz0b","Type":"NodeParagraph","Properties":{"id":"20240611111831-h0hzz0b","updated":"20240611111831"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611111832-xeo0ocu","Type":"NodeThematicBreak","Properties":{"id":"20240611111832-xeo0ocu"}},{"ID":"20240611111833-3iadic3","Type":"NodeParagraph","Properties":{"id":"20240611111833-3iadic3"}}]}