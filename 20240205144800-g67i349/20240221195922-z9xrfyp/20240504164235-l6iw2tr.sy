{"ID":"20240504164235-l6iw2tr","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164235-l6iw2tr","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164235-l6iw2tr\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504164235-e05ibfg\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611111833-3iadic3\u0026quot;,\u0026quot;scrollTop\u0026quot;:500,\u0026quot;focusId\u0026quot;:\u0026quot;20240611112119-7vfj3pc\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"142苦菜（苣荬菜、苦苣菜）","type":"doc","updated":"20240813100009"},"Children":[{"ID":"20240621171628-tr21yjh","Type":"NodeParagraph","Properties":{"id":"20240621171628-tr21yjh","updated":"20240621171628"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"北败酱（苣荬菜、苦荬菜、苦菜）"}]},{"ID":"20240813093102-bspnfj8","Type":"NodeParagraph","Properties":{"id":"20240813093102-bspnfj8","updated":"20240813100738"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 333px;","style":"width: 323px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"败酱 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/败酱 1-20240813093140-nh5gkxx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 323px;\" parent-style=\"width: 333px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 343px;","style":"width: 333px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"败酱"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/败酱-20240813093102-ncwcm0m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 333px;\" parent-style=\"width: 343px;\"}"},{"Type":"NodeText","