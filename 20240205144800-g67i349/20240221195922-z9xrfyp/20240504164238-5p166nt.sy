{"ID":"20240504164238-5p166nt","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164238-5p166nt","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164238-5p166nt\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240621135441-hi10tvt\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611105102-pl1krzi\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240621135441-df980ef\u0026quot;,\u0026quot;focusStart\u0026quot;:6,\u0026quot;focusEnd\u0026quot;:6\u0026#125;","title":"138冬葵子","type":"doc","updated":"20240812163633"},"Children":[{"ID":"20240621135441-hi10tvt","Type":"NodeParagraph","Properties":{"id":"20240621135441-hi10tvt","updated":"20240621135441"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产于四川、云南、贵州、湖南、湖北、陕西等地区。\n【性状】\t干燥果实呈扁球状盘形，由1012枚分果瓣组成，果梗细短。分果瓣类扁圆形，具环向细脉纹，表面黄白或黄棕色。种子呈圆形扁平之橘瓣状，或微呈肾形，细小，直径约1.52mm，较薄的一边中央凹下，外表为棕黄色的包壳 (果皮)，具环形细皱纹，搓去皮壳后，种子呈棕褐色。质坚硬，破碎后微有香味。\n【性味】\t甘，寒。\n【功效】\t行水滑肠，通乳，清热排脓。"}]},{"ID":"20240621135441-av35y9d","Type":"NodeParagraph","Properties":{"id":"20240621135441-av35y9d","updated":"20240621135441"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206095348-nst9cdo.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162931-2380j8n","Type":"NodeParagraph","Properties":{"id":"20240812162931-2380j8n","updated":"20240812162931"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 254px;","style":"width: 244px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 10-20240808151756-4zrpw7j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 244px;\" parent-style=\"width: 254px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 441px;","style":"width: 431px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 1-20240808142912-hgajm4o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 431px;\" parent-style=\"width: 441px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 481px;","style":"width: 471px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 3-20240808143053-10bucb5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 471px;\" parent-style=\"width: 481px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162932-n169epx","Type":"NodeParagraph","Properties":{"id":"20240812162932-n169epx","updated":"20240812162932"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 746px;","style":"width: 736px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (18)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 18-20240808155239-tyc6b6h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 736px;\" parent-style=\"width: 746px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 421px;","style":"width: 411px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 19-20240808155649-gb5zyll.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 411px;\" parent-style=\"width: 421px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162932-3mt7tww","Type":"NodeParagraph","Properties":{"id":"20240812162932-3mt7tww","updated":"20240812162932"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 397px;","style":"width: 387px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 14-20240808152943-tneynjm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 387px;\" parent-style=\"width: 397px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 388px;","style":"width: 378px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 15-20240808153036-dou532y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 378px;\" parent-style=\"width: 388px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 399px;","style":"width: 389px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬葵子 (16)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬葵子 16-20240808153127-q04dan3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 389px;\" parent-style=\"width: 399px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812162932-tlcmkzp","Type":"NodeParagraph","Propertie