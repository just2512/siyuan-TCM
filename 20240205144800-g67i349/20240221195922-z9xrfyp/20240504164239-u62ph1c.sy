{"ID":"20240504164239-u62ph1c","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164239-u62ph1c","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164239-u62ph1c\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240621125338-o2sr923\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611100312-14duws2\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240621130350-c1u1odq\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"133蒲萄（葡萄）","type":"doc","updated":"20240812085048"},"Children":[{"ID":"20240621125338-o2sr923","Type":"NodeParagraph","Properties":{"id":"20240621125338-o2sr923","updated":"20240812083730"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 497px;","style":"width: 487px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葡萄 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葡萄 1-20240812083727-0u9fdfs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 487px;\" parent-style=\"width: 497px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812083814-wywskhe","Type":"NodeParagraph","Properties":{"id":"20240812083814-wywskhe","updated":"20240812083822"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 618px;","style":"width: 608px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葡萄 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葡萄 2-20240812083814-nnquwgd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 608px;\" parent-style=\"width: 618px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":