084436-kk1b61b.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 452px;\" parent-style=\"width: 462px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812083630-br193yh","Type":"NodeParagraph","Properties":{"id":"20240812083630-br193yh","updated":"20240812084239"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 625px;","style":"width: 615px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葡萄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葡萄-20240812083630-gf59471.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 615px;\" parent-style=\"width: 625px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 625px;","style":"width: 615px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葡萄 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葡萄 6-20240812084238-bm79pg1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 615px;\" parent-style=\"width: 625px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621125838-x7qxaas","Type":"NodeParagraph","Properties":{"id":"20240621125838-x7qxaas","updated":"20240812084046"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 627px;","style":"width: 617px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"紫葡萄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/紫葡萄-20240621125838-5vbgnbi.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 617px;\" parent-style=\"width: 627px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 625px;","style":"width: 615px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621130004-bozbhxb.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 615px;\" parent-style=\"width: 625px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240812084204-go7vwdc","Type":"NodeParagraph","Properties":{"id":"20240812084204-go7vwdc","updated":"20240812085048"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葡萄 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葡萄 10-20240812085034-8j4idhw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"葡萄 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/葡萄 5-20240812084204-kzs0qtx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240611100512-fpnii5d","Type":"NodeThematicBreak","Properties":{"id":"20240611100512-fpnii5d"}},{"ID":"20240611100513-7ri64f4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100513-7ri64f4","updated":"20240611100517"},"Children":[{"Type":"NodeText","Data":"葡萄《神农本草经》"}]},{"ID":"20240611100513-fics2oc","Type":"NodeParagraph","Properties":{"id":"20240611100513-fics2oc","updated":"20240611100513"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240611100513-f8eg8zu","Type":"NodeParagraph","Properties":{"id":"20240611100513-f8eg8zu","updated":"20240611100513"},"Children":[{"Type":"NodeText","Data":"主筋骨湿痹，益气，倍力，强志，令人肥健，耐饥忍风寒。久食轻身，不老延年，可作酒。生山谷。《名医》曰：生陇西五原敦煌。"}]},{"ID":"20240611100513-kjagy0b","Type":"NodeParagraph","Properties":{"id":"20240611100513-kjagy0b","updated":"20240611100513"},"Children":[{"Type":"NodeText","Data":"案史纪大宛列《传》云：大宛左右，以葡萄为酒，汉使取其实来，于是天子始种苜蓿，葡萄，肥饶地，或疑此本经不合有葡萄，《名医》所增，当为黑字。"}]},{"ID":"20240611100513-n8sxgug","Type":"NodeParagraph","Properties":{"id":"20240611100513-n8sxgug","updated":"20240611100513"},"Children":[{"Type":"NodeText","Data":"然《周礼》场人云：树之查蓏，珍异之物。郑元云：珍异，葡萄枇杷之属，则古中国本有此，大宛种类殊常，故汉特取来植之，旧作葡，据《史记》作蒲。"}]},{"ID":"20240611100544-bxmtunz","Type":"NodeThematicBreak","Properties":{"id":"20240611100544-bxmtunz"}},{"ID":"20240611100546-5uhp33a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100546-5uhp33a","updated":"20240611100550"},"Children":[{"Type":"NodeText","Data":"葡萄《千金翼方》"}]},{"ID":"20240611100546-sc39980","Type":"NodeParagraph","Properties":{"id":"20240611100546-sc39980","updated":"20240611100546"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主筋骨湿痹，益气，倍力，强志。令人肥健，耐饥，忍风寒。久食轻身，不老延年。可作酒，逐水，利小便，生陇西五原敦煌山谷。"}]},{"ID":"20240611100558-irisv7g","Type":"NodeThematicBreak","Properties":{"id":"20240611100558-irisv7g"}},{"ID":"20240611100601-matmo3b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100601-matmo3b","updated":"20240611100609"},"Children":[{"Type":"NodeText","Data":"葡萄《神农本草经百种录》"}]},{"ID":"20240611100601-18laf57","Type":"NodeParagraph","Properties":{"id":"20240611100601-18laf57","updated":"20240611100601"},"Children":[{"Type":"NodeText","Data":"味甘平。主筋骨湿痹，益气倍力，强筋燥湿。强志，肝藏魂。令人肥健耐饥，忍风寒。久服轻身，不老延年。皆培补肝脾之效。可作酒。"}]},{"ID":"20240611100601-lz6s0z2","Type":"NodeParagraph","Properties":{"id":"20240611100601-lz6s0z2","updated":"20240611100601"},"Children":[{"Type":"NodeText","Data":"此以形为治，葡萄屈曲蔓延，冬卷春舒，与筋相似，故能补益筋骨。其实甘美，得土之正味，故又能滋养肌肉。肝主筋，脾主肉，乃肝脾交补之药也。"}]},{"ID":"20240611100647-0b44cs6","Type":"NodeThematicBreak","Properties":{"id":"20240611100647-0b44cs6"}},{"ID":"20240611100649-t7p4iw4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100649-t7p4iw4","updated":"20240611100652"},"Children":[{"Type":"NodeText","Data":"葡萄《得配本草》"}]},{"ID":"20240611100649-sxhzoxl","Type":"NodeParagraph","Properties":{"id":"20240611100649-sxhzoxl","updated":"20240611100649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名蒲桃"}]},{"ID":"20240611100649-03nh9f9","Type":"NodeParagraph","Properties":{"id":"20240611100649-03nh9f9","updated":"20240611100649"},"Children":[{"Type":"NodeText","Data":"甘、平、酸、涩。入手太阳经。治胎上冲心，疗筋骨湿痹，除肠水，发痘疮。配生藕、生地，捣汁和白蜜，治热淋涩痛。"}]},{"ID":"20240611100649-2zbrfgo","Type":"NodeParagraph","Properties":{"id":"20240611100649-2zbrfgo","updated":"20240611100649"},"Children":[{"Type":"NodeText","Data":"多服令人烦闷目暗。"}]},{"ID":"20240611100649-h2bin0k","Type":"NodeParagraph","Properties":{"id":"20240611100649-h2bin0k","updated":"20240611100649"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根、藤、叶"}]},{"ID":"20240611100649-rui6hkp","Type":"NodeParagraph","Properties":{"id":"20240611100649-rui6hkp","updated":"20240611100649"},"Children":[{"Type":"NodeText","Data":"甘、平，涩。治呕哕，利小肠，消肿满及霍乱后恶心。"}]},{"ID":"20240611100635-g062mh2","Type":"NodeThematicBreak","Properties":{"id":"20240611100635-g062mh2"}},{"ID":"20240611100636-kwvxxvl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100636-kwvxxvl","updated":"20240611100642"},"Children":[{"Type":"NodeText","Data":"葡萄《本草求真》"}]},{"ID":"20240611100636-lv9vymt","Type":"NodeParagraph","Properties":{"id":"20240611100636-lv9vymt","updated":"20240611100636"},"Children":[{"Type":"NodeText","Data":"（ ）摄精气归宿肾"}]},{"ID":"20240611100636-5mv3azx","Type":"NodeParagraph","Properties":{"id":"20240611100636-5mv3azx","updated":"20240611100636"},"Children":[{"Type":"NodeText","Data":"葡萄（专入肾）。种类不一。此以 名者。因其形似葡萄。琐细不大。故以 名也。张璐论之甚详。言此生于漠北。南方亦间有之。其干类木。而系藤木。其子生青熟赤。干则紫黑。气味甘咸而温。能摄精气。归宿肾脏。与五味子功用不甚相远。凡藤蔓之类。皆属于筋。（形类相似。有感而通。）草木之实。皆达于脏。（实则重着下行。实则气重内入。故多入脏。）不独此味为然。此物向供食品。不入汤药。故本草不载。近时北人以之强肾。南人以之稀痘。各有攸宜。强肾方用 葡萄人参各一钱。火酒浸一宿。清晨涂手心。摩擦腰脊。能助筋力强壮。若卧时摩擦腰脊。力助阳事坚强。服之尤为得力。稀痘方用 葡萄一岁一钱。神黄豆一岁一粒。杵为细末。一昼夜蜜水调服。并擦心窝腰眼。能助肾祛邪。以北地方物。专助东南生气之不足也。然秉质素弱宜服。反是则不免有助火之害矣！"}]},{"ID":"20240611100618-wyabk96","Type":"NodeThematicBreak","Properties":{"id":"20240611100618-wyabk96"}},{"ID":"20240611100619-os9j24l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100619-os9j24l","updated":"20240611100628"},"Children":[{"Type":"NodeText","Data":"葡萄《滇南本草》"}]},{"ID":"20240611100619-8bi034i","Type":"NodeParagraph","Properties":{"id":"20240611100619-8bi034i","updated":"20240611100623"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"葡萄"},{"Type":"NodeText","Data":"，色有绛、绿二种，绿者佳。味甘，性平。服之轻身延年。老人大补气血，舒经活络。泡酒服之。治阴阳脱症，又治盗汗虚症。"}]},{"ID":"20240611100619-5hywuv2","Type":"NodeParagraph","Properties":{"id":"20240611100619-5hywuv2","updated":"20240611100619"},"Children":[{"Type":"NodeText","Data":"叶治火眼；根治蛇头疮；汁治咳嗽。"}]},{"ID":"20240611100619-4ej5gz8","Type":"NodeParagraph","Properties":{"id":"20240611100619-4ej5gz8","updated":"20240611100619"},"Children":[{"Type":"NodeText","Data":"熬膏和蜜，治脑漏百病，每服一钱，开水下。又治小儿急慢惊风，苏叶汤下。"}]},{"ID":"20240611100619-v1zbmjr","Type":"NodeParagraph","Properties":{"id":"20240611100619-v1zbmjr","updated":"20240611100619"},"Children":[{"Type":"NodeText","Data":"熬膏服方∶葡萄（一斤） 苹果（六十个去皮） 大黄桃（二十个去皮） 花红果（十个去皮） 共捣熬成膏，入酒内，埋土地二十一日取饮。然须上好谷酒二十斤。忌荤菜同食。"}]},{"ID":"20240611100619-7pqssua","Type":"NodeParagraph","Properties":{"id":"20240611100619-7pqssua","updated":"20240611100619"},"Children":[{"Type":"NodeText","Data":"──务本卷一下"}]},{"ID":"20240611100619-i3f6pl5","Type":"NodeParagraph","Properties":{"id":"20240611100619-i3f6pl5","updated":"20240611100619"},"Children":[{"Type":"NodeText","Data":"葡萄，味甘、酸，性微温，无毒。主治筋骨湿痹，益气为，令人肥健，治痘症毒，其走下之性，渗水道，利小便。胎气上冲，煎汤饮之即下。不宜多食。昔李太白酿酒，常饮此可轻身耐老，但服而有益者，惟每日临卧时饮三杯，多则不效。采叶贴无名肿毒，最良。"}]},{"ID":"20240611100533-9efi6ai","Type":"NodeThematicBreak","Properties":{"id":"20240611100533-9efi6ai"}},{"ID":"20240611100534-w1am89o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100534-w1am89o","updated":"20240611100538"},"Children":[{"Type":"NodeText","Data":"葡萄《新修本草》"}]},{"ID":"20240611100534-p7grp7i","Type":"NodeParagraph","Properties":{"id":"20240611100534-p7grp7i","updated":"20240611100534"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主筋骨湿痹，益气倍力，强志，令人肥健，耐饥，忍风寒，久服轻身不老，延年。可作酒，逐水，利小便。生陇西五原敦煌山谷。"}]},{"ID":"20240611100534-qtxpivq","Type":"NodeParagraph","Properties":{"id":"20240611100534-qtxpivq","updated":"20240611100534"},"Children":[{"Type":"NodeText","Data":"魏国使人多 来，状如五味子而甘美，可作酒，云用其藤汁殊美好。北国人多肥健耐寒，盖橘之变于河北矣。人说即是此间 ，恐如彼之枳类橘耶？"}]},{"ID":"20240611100534-66p0sdm","Type":"NodeParagraph","Properties":{"id":"20240611100534-66p0sdm","updated":"20240611100534"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240611100534-9il4bd4","Type":"NodeParagraph","Properties":{"id":"20240611100534-9il4bd4","updated":"20240611100534"},"Children":[{"Type":"NodeText","Data":"与葡萄亦同，然 是千岁 。葡萄作酒法，总收取子汁酿之自成酒。 ，山葡萄，亦堪为酒。陶景言用藤汁为酒，谬矣。"}]},{"ID":"20240611100353-fqqtipb","Type":"NodeThematicBreak","Properties":{"id":"20240611100353-fqqtipb"}},{"ID":"20240611100449-a80r0nk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100449-a80r0nk","updated":"20240611100454"},"Children":[{"Type":"NodeText","Data":"葡萄《医学入门》"}]},{"ID":"20240611100449-b1fx34j","Type":"NodeParagraph","Properties":{"id":"20240611100449-b1fx34j","updated":"20240611100449"},"Children":[{"Type":"NodeText","Data":"葡萄味甘平渗下，利便通淋水气化，更治筋骨湿痹疼，酿酒调中味不亚，根止呕哕达小肠，能安胎气冲心罅。"}]},{"ID":"20240611100449-kin6fu5","Type":"NodeParagraph","Properties":{"id":"20240611100449-kin6fu5","updated":"20240611100449"},"Children":[{"Type":"NodeText","Data":"无毒。丹溪云∶属土而有水木火，东南人食之多病烦热眼暗，西北人禀气浓，服之健力耐寒，盖性能下走渗道也。故经云∶通小便，治淋涩，逐肠间水气，主筋骨间湿痹。兼治痘疹不出，研和酒饮之。酒，甘温，收其子汁酿之自成。除湿调中，利小便，多饮亦动痰火。魏文帝云∶醉酒宿醒掩露而食，甘而不饮，酸而不酢，冷而不寒，味长汁多，除烦解渴，他方之果，宁有配乎？根，主呕哕及胎气上冲，煮浓汁饮之。俗呼其苗为土木通。逐水利小肠尤佳。又一种山葡萄，亦堪为酒，性亦大同。"}]},{"ID":"20240611100501-rh0u4dk","Type":"NodeThematicBreak","Properties":{"id":"20240611100501-rh0u4dk"}},{"ID":"20240611100502-dl71uel","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100502-dl71uel","updated":"20240611100507"},"Children":[{"Type":"NodeText","Data":"葡萄《本草纲目》"}]},{"ID":"20240611100502-m627ius","Type":"NodeParagraph","Properties":{"id":"20240611100502-m627ius","updated":"20240611100502"},"Children":[{"Type":"NodeText","Data":"「释名」蒲桃、草龙珠。"}]},{"ID":"20240611100502-vjdhkr7","Type":"NodeParagraph","Properties":{"id":"20240611100502-vjdhkr7","updated":"20240611100502"},"Children":[{"Type":"NodeText","Data":"「气味」甘、平、涩、无毒。"}]},{"ID":"20240611100502-8x2n7wv","Type":"NodeParagraph","Properties":{"id":"20240611100502-8x2n7wv","updated":"20240611100502"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611100502-cm78gpp","Type":"NodeParagraph","Properties":{"id":"20240611100502-cm78gpp","updated":"20240611100502"},"Children":[{"Type":"NodeText","Data":"1、热淋涩痛。取葡萄捣取自然汁，生藕捣取自然汁，生地黄捣取自然汁，各五合，再加白沙蜜五合，和匀，每次温服一碗。"}]},{"ID":"20240611100502-rdt3q4x","Type":"NodeParagraph","Properties":{"id":"20240611100502-rdt3q4x","updated":"20240611100502"},"Children":[{"Type":"NodeText","Data":"2、胎上冲心。用葡萄汤饮服，好不上冲。"}]},{"ID":"20240611100502-srb8mgs","Type":"NodeParagraph","Properties":{"id":"20240611100502-srb8mgs","updated":"20240611100502"},"Children":[{"Type":"NodeText","Data":"3、水肿。用葡萄嫩心十四个、蝼蛄七个（去头尾），同研烂，露七日，晒干研为末。每服半钱，淡酒调下。暑天服此方，效果更好。"}]},{"ID":"20240611100309-ig4dpgx","Type":"NodeThematicBreak","Properties":{"id":"20240611100309-ig4dpgx"}},{"ID":"20240611100349-90u8utw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100349-90u8utw"},"Children":[{"Type":"NodeText","Data":"葡萄《神农本草经赞》"}]},{"ID":"20240611100337-l4fu1jj","Type":"NodeParagraph","Properties":{"id":"20240611100337-l4fu1jj","updated":"20240611100337"},"Children":[{"Type":"NodeText","Data":"味甘平。主筋骨湿痹。益气倍力。强志。令人肥健。耐饥忍风寒。久食轻身不老延年。可作酒。生山谷。"}]},{"ID":"20240611100337-37g2fwz","Type":"NodeParagraph","Properties":{"id":"20240611100337-37g2fwz","updated":"20240611100337"},"Children":[{"Type":"NodeText","Data":"托根福地。引竹交穿。青纷绶结。紫莹珠悬。云浆清滑。玉盏凉鲜。荔枝同嚼。风月无边。"}]},{"ID":"20240611100337-82jwnuu","Type":"NodeParagraph","Properties":{"id":"20240611100337-82jwnuu","updated":"20240611100337"},"Children":[{"Type":"NodeText","Data":"宋祁赋。托崤函之福地。韩愈诗。莫辞添竹引龙须。刘禹锡歌。繁葩组绶结。唐彦谦诗。"}]},{"ID":"20240611100337-t5qq9fi","Type":"NodeParagraph","Properties":{"id":"20240611100337-t5qq9fi","updated":"20240611100337"},"Children":[{"Type":"NodeText","Data":"珠帐高悬夜不收。刘禹锡诗。味敌五云浆。洪希又诗。醍醐纵美输清滑。顾阿瑛诗。葡萄玉盏酌西凉。李梦阳诗。酒酣试取冰丸嚼。不说天南有荔枝。张词。风月无边是醉乡。"}]},{"ID":"20240611100309-b4ibvco","Type":"NodeThematicBreak","Properties":{"id":"20240611100309-b4ibvco"}},{"ID":"20240611100310-yxchhq0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100310-yxchhq0","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：葡萄"}]},{"ID":"20240611100310-0atqyzu","Type":"NodeParagraph","Properties":{"id":"20240611100310-0atqyzu","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611100310-fs2xp5y","Type":"NodeParagraph","Properties":{"id":"20240611100310-fs2xp5y","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" Pú Tɑo"}]},{"ID":"20240611100310-83dijwx","Type":"NodeParagraph","Properties":{"id":"20240611100310-83dijwx","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611100310-mwww9j2","Type":"NodeParagraph","Properties":{"id":"20240611100310-mwww9j2","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 索索葡萄、草龙珠、葡萄秧"}]},{"ID":"20240611100310-dhc1yn8","Type":"NodeParagraph","Properties":{"id":"20240611100310-dhc1yn8","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611100310-90obmx4","Type":"NodeParagraph","Properties":{"id":"20240611100310-90obmx4","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 葡萄科葡萄属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葡萄"},{"Type":"NodeText","Data":"Vitis vinifera L.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果、根、藤"},{"Type":"NodeText","Data":"入药。秋季采，晒干或鲜用。"}]},{"ID":"20240611100310-2e4fbm0","Type":"NodeParagraph","Properties":{"id":"20240611100310-2e4fbm0","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611100310-5qzrvvr","Type":"NodeParagraph","Properties":{"id":"20240611100310-5qzrvvr","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 果：甘，平。"}]},{"ID":"20240611100310-917sare","Type":"NodeParagraph","Properties":{"id":"20240611100310-917sare","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611100310-rwi1pks","Type":"NodeParagraph","Properties":{"id":"20240611100310-rwi1pks","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 果：解表透疹，利尿，安胎。用于麻疹不透，小便不利，胎动不安。"}]},{"ID":"20240611100310-mfji2md","Type":"NodeParagraph","Properties":{"id":"20240611100310-mfji2md","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"根、藤：祛风湿，利尿。用于风湿骨痛，水肿；外用治骨折。"}]},{"ID":"20240611100310-obohj9c","Type":"NodeParagraph","Properties":{"id":"20240611100310-obohj9c","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611100310-5h6kzzb","Type":"NodeParagraph","Properties":{"id":"20240611100310-5h6kzzb","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 果、根、藤0.5～1.5两；外用鲜根适量，手法复位后，捣烂敷患处。"}]},{"ID":"20240611100310-lwbwqot","Type":"NodeParagraph","Properties":{"id":"20240611100310-lwbwqot","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611100310-7hpfv02","Type":"NodeParagraph","Properties":{"id":"20240611100310-7hpfv02","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" （1）"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"玫瑰香葡萄秧"},{"Type":"NodeText","Data":"：为玫瑰香葡萄每年利用修剪下来的藤、叶、梢作药用，制成注射剂，用于治疗坐骨神经痛，效果较好。同时对三叉神经的剧烈疼痛也有缓解作用。注射剂每毫升相当1克新鲜葡萄秧，每支2毫升，肌肉注射，每次注射1支，每日1次或遵医嘱，两周为一个疗程。"}]},{"ID":"20240611100310-cq4kaxx","Type":"NodeParagraph","Properties":{"id":"20240611100310-cq4kaxx","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611100310-u0ya4v0","Type":"NodeParagraph","Properties":{"id":"20240611100310-u0ya4v0","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611100310-918xn1q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100310-918xn1q","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：葡萄"}]},{"ID":"20240611100310-tzita4a","Type":"NodeParagraph","Properties":{"id":"20240611100310-tzita4a","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611100310-ck4t43v","Type":"NodeParagraph","Properties":{"id":"20240611100310-ck4t43v","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" Pú Tɑo"}]},{"ID":"20240611100310-ktyd8ow","Type":"NodeParagraph","Properties":{"id":"20240611100310-ktyd8ow","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611100310-bnkqtxd","Type":"NodeParagraph","Properties":{"id":"20240611100310-bnkqtxd","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 草龙珠（《纲目》），山葫芦（《中国树木分类学》）。"}]},{"ID":"20240611100310-wouu2m5","Type":"NodeParagraph","Properties":{"id":"20240611100310-wouu2m5","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611100310-6t44gxf","Type":"NodeParagraph","Properties":{"id":"20240611100310-6t44gxf","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611100310-ruj0hhi","Type":"NodeParagraph","Properties":{"id":"20240611100310-ruj0hhi","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611100310-kji5mnu","Type":"NodeParagraph","Properties":{"id":"20240611100310-kji5mnu","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 为葡萄科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"葡萄"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实"},{"Type":"NodeText","Data":"。夏末秋初果熟时采收，阴干。多数制成葡萄干用。"}]},{"ID":"20240611100310-vfa0d1i","Type":"NodeParagraph","Properties":{"id":"20240611100310-vfa0d1i","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611100310-cc4jqep","Type":"NodeParagraph","Properties":{"id":"20240611100310-cc4jqep","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 长江流域以北各地均有栽培，主要产于新疆、甘肃、陕西、山西、河北、山东等地。产新疆。"}]},{"ID":"20240611100310-ul451hh","Type":"NodeParagraph","Properties":{"id":"20240611100310-ul451hh","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611100310-h2vyflu","Type":"NodeParagraph","Properties":{"id":"20240611100310-h2vyflu","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 高大缠绕藤本，幼茎秃净或略被绵毛。叶纸质，互生，圆形或圆卵形，宽10～20厘米，常3～5裂，基部心形，边缘有粗而稍尖锐的齿缺，下面常密被蛛丝状绵毛；叶柄长达4～8厘米。花杂性，异株，圆锥花序大而长，与叶对生；花序柄无卷须；萼极小，杯状，全缘或不明显的5齿裂；花瓣5，黄绿色，先端粘合不展开，基部分离，开花时呈帽状整块脱落；雄蕊5；花盘隆起，由5个腺体所成，基部与子房合生；子房2室，每室有胚珠2，花柱短，圆锥形。浆果卵圆形至卵状矩圆形，富汁液，熟时紫黑色或红而带青色，外被蜡粉。花期6月。果期9～10月。"}]},{"ID":"20240611100310-s9q3ivb","Type":"NodeParagraph","Properties":{"id":"20240611100310-s9q3ivb","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611100310-xb6tzcl","Type":"NodeParagraph","Properties":{"id":"20240611100310-xb6tzcl","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 琐琐葡萄：干燥的果实外皮红褐色，小颗粒，果皮有皱纹，味甜。以色红褐、粒整齐、无杂质者为佳，粒瘦破烂者为次。"}]},{"ID":"20240611100310-slb62en","Type":"NodeParagraph","Properties":{"id":"20240611100310-slb62en","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611100310-fbgm28b","Type":"NodeParagraph","Properties":{"id":"20240611100310-fbgm28b","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 葡萄含葡萄糖、果糖，少量蔗糖、木糖，酒石酸、草酸、柠檬酸、苹果酸。又含各种花色素的单葡萄糖甙和双葡萄糖甙。每100克含蛋白质0.2克，钙4毫克，磷15毫克，铁0.6毫克，胡萝卜素0.04毫克，硫胺素0.04毫克，核黄素0.01毫克，尼克酸0.1毫克，维生素C 4毫克。"}]},{"ID":"20240611100310-2gzm7kl","Type":"NodeParagraph","Properties":{"id":"20240611100310-2gzm7kl","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"葡萄皮含矢车菊素、芍药素、飞燕草素、矮牵牛素、锦葵花素、锦葵花素-3-β-葡萄糖甙。"}]},{"ID":"20240611100310-5bjh5zs","Type":"NodeParagraph","Properties":{"id":"20240611100310-5bjh5zs","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"种子含油量9.58％。又含焦性儿茶酚、没食子儿茶精、没食子酸盐等。"}]},{"ID":"20240611100310-gtm4qg8","Type":"NodeParagraph","Properties":{"id":"20240611100310-gtm4qg8","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611100310-ao7w3w0","Type":"NodeParagraph","Properties":{"id":"20240611100310-ao7w3w0","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 在作用方面葡萄有某种维生素P的活性。种子油15克口服可降低胃酸度；12克可利胆（胆绞痛发作时无效）；40～50克有致泻作用。叶、茎有收敛作用，但无抗菌效力。"}]},{"ID":"20240611100310-c1ebjub","Type":"NodeParagraph","Properties":{"id":"20240611100310-c1ebjub","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611100310-e8qu4tm","Type":"NodeParagraph","Properties":{"id":"20240611100310-e8qu4tm","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 入肺、脾、肾经。"}]},{"ID":"20240611100310-wtkwdec","Type":"NodeParagraph","Properties":{"id":"20240611100310-wtkwdec","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入手太阳经。\""}]},{"ID":"20240611100310-b6eu0cm","Type":"NodeParagraph","Properties":{"id":"20240611100310-b6eu0cm","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"②《本草求真》：\"入肾。\""}]},{"ID":"20240611100310-w5tiai1","Type":"NodeParagraph","Properties":{"id":"20240611100310-w5tiai1","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入脾、肺二经。\""}]},{"ID":"20240611100310-y2t7513","Type":"NodeParagraph","Properties":{"id":"20240611100310-y2t7513","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611100310-cvxp15x","Type":"NodeParagraph","Properties":{"id":"20240611100310-cvxp15x","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 甘酸，平。"}]},{"ID":"20240611100310-52heeiw","Type":"NodeParagraph","Properties":{"id":"20240611100310-52heeiw","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240611100310-o7sykgc","Type":"NodeParagraph","Properties":{"id":"20240611100310-o7sykgc","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"②孟诜：\"甘酸，温。\""}]},{"ID":"20240611100310-4e0w8s7","Type":"NodeParagraph","Properties":{"id":"20240611100310-4e0w8s7","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"甘涩，平，无毒。\""}]},{"ID":"20240611100310-4aroq69","Type":"NodeParagraph","Properties":{"id":"20240611100310-4aroq69","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611100310-99w13hd","Type":"NodeParagraph","Properties":{"id":"20240611100310-99w13hd","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" ①孟诜：\"不堪多食，令人卒烦闷眼暗。\""}]},{"ID":"20240611100310-vaak7ml","Type":"NodeParagraph","Properties":{"id":"20240611100310-vaak7ml","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"食多令人泄泻。\""}]},{"ID":"20240611100310-uol5llw","Type":"NodeParagraph","Properties":{"id":"20240611100310-uol5llw","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"③《医林纂要》：\"多食生内热。\""}]},{"ID":"20240611100310-dxt9l1o","Type":"NodeParagraph","Properties":{"id":"20240611100310-dxt9l1o","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611100310-zmgti6q","Type":"NodeParagraph","Properties":{"id":"20240611100310-zmgti6q","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 补气血，强筋骨，利小便。治气血虚弱，肺虚咳嗽，心悸盗汗，风湿痹病，淋病，浮肿。"}]},{"ID":"20240611100310-pbbwxwf","Type":"NodeParagraph","Properties":{"id":"20240611100310-pbbwxwf","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主筋骨湿痹，益气倍力，强志，令人肥健耐饥，忍风寒。可作酒。\""}]},{"ID":"20240611100310-1zn3qmi","Type":"NodeParagraph","Properties":{"id":"20240611100310-1zn3qmi","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"逐水，利小便。\""}]},{"ID":"20240611100310-gup3whe","Type":"NodeParagraph","Properties":{"id":"20240611100310-gup3whe","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"除肠间水气，调中治淋，通小便。\""}]},{"ID":"20240611100310-lb3kl21","Type":"NodeParagraph","Properties":{"id":"20240611100310-lb3kl21","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"④《本草图经》：\"治时气发疮疹不出者，研酒饮。\""}]},{"ID":"20240611100310-cdflc2p","Type":"NodeParagraph","Properties":{"id":"20240611100310-cdflc2p","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"大补气血，舒筋活络，泡酒服之。治阴阳脱症，又治盗汗虚证。汁，治咳嗽。\""}]},{"ID":"20240611100310-iq7l1td","Type":"NodeParagraph","Properties":{"id":"20240611100310-iq7l1td","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草图说》：\"治痘症毒，胎气上冲，煎汤饮之即下。\""}]},{"ID":"20240611100310-4kyaf3m","Type":"NodeParagraph","Properties":{"id":"20240611100310-4kyaf3m","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑦《百草镜》：\"治筋骨湿痛。利水甚捷，除遍身浮肿。\""}]},{"ID":"20240611100310-3pa5d5n","Type":"NodeParagraph","Properties":{"id":"20240611100310-3pa5d5n","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑧《本耳再新》：\"暖胃健脾，治肺虚寒嗽，破血积疽瘤。\""}]},{"ID":"20240611100310-k1fpcjw","Type":"NodeParagraph","Properties":{"id":"20240611100310-k1fpcjw","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑨《随息居饮食谱》：\"补气，滋肾液，益肝阴，强筋骨，止渴，安胎。\""}]},{"ID":"20240611100310-k9okmky","Type":"NodeParagraph","Properties":{"id":"20240611100310-k9okmky","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑩《新疆药材》：\"解毒，散表。\""}]},{"ID":"20240611100310-8i3847r","Type":"NodeParagraph","Properties":{"id":"20240611100310-8i3847r","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑾《陆川本草》：\"滋养强壮，补血，强心利尿。治腰痛，胃痛，精神疲惫，血虚心跳。\""}]},{"ID":"20240611100310-e5nmcmr","Type":"NodeParagraph","Properties":{"id":"20240611100310-e5nmcmr","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611100310-l7plm5y","Type":"NodeParagraph","Properties":{"id":"20240611100310-l7plm5y","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤、捣汁或浸酒。"}]},{"ID":"20240611100310-atfixdm","Type":"NodeParagraph","Properties":{"id":"20240611100310-atfixdm","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611100310-m8nvkuu","Type":"NodeParagraph","Properties":{"id":"20240611100310-m8nvkuu","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" ①强肾：琐琐葡萄、人参各一钱。火酒浸-宿，侵晨涂手心，摩擦腰脊，能助膂力强壮，若卧时摩擦腰脊，力能助肾坚强，服之尤为得力。（《本经逢原》）"}]},{"ID":"20240611100310-av9t8ud","Type":"NodeParagraph","Properties":{"id":"20240611100310-av9t8ud","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"②治热淋，小便涩少，碜痛沥血：葡萄（绞取汁）五合，藕汁五合，生地黄汁五合，蜜五两。上相和，煎为稀饧，每于食前服二合。（《圣惠方》葡萄煎）"}]},{"ID":"20240611100310-cmhvhpw","Type":"NodeParagraph","Properties":{"id":"20240611100310-cmhvhpw","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"③除烦止渴：生葡萄捣滤取汁，以瓦器熬稠，入熟蜜少许，同收，点汤饮。（《居家必用率类全集》）"}]},{"ID":"20240611100310-kdc2bpj","Type":"NodeParagraph","Properties":{"id":"20240611100310-kdc2bpj","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"④治吹乳：葡萄一枚，于灯焰上燎过，研细，热酒调服。（《圣济总录》葡萄洒）"}]},{"ID":"20240611100310-4yi85p4","Type":"NodeParagraph","Properties":{"id":"20240611100310-4yi85p4","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"⑤治牙龈肿痛，势欲成痈者：葡萄干去核，填满焰硝煅之。焰过，取置地上成炭，研末擦之，涎出，任吐自瘥。（《医级》葡硝散）"}]},{"ID":"20240611100310-fdenlmh","Type":"NodeParagraph","Properties":{"id":"20240611100310-fdenlmh","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611100310-54d6cae","Type":"NodeParagraph","Properties":{"id":"20240611100310-54d6cae","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 葡萄的品种甚多，其中新疆栽培的琐琐葡萄（又名：索索葡萄、豆粒葡萄）在《本草纲目》即有记载，一般认为入药者以该种为佳。"}]},{"ID":"20240611100310-08ved44","Type":"NodeParagraph","Properties":{"id":"20240611100310-08ved44","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611100310-mp2gyk5","Type":"NodeParagraph","Properties":{"id":"20240611100310-mp2gyk5","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611100310-jjdzb6b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611100310-jjdzb6b","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"《中华本草》：葡萄"}]},{"ID":"20240611100310-xzy8izv","Type":"NodeParagraph","Properties":{"id":"20240611100310-xzy8izv","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611100310-izt2mpl","Type":"NodeParagraph","Properties":{"id":"20240611100310-izt2mpl","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" Pú Tɑo"}]},{"ID":"20240611100310-4hdbxqd","Type":"NodeParagraph","Properties":{"id":"20240611100310-4hdbxqd","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611100310-m7q1skf","Type":"NodeParagraph","Properties":{"id":"20240611100310-m7q1skf","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 蒲陶、草龙珠、赐紫樱桃、琐琐葡萄、山葫芦、菩提子、索索葡萄、乌珠玛、葡萄秋。"}]},{"ID":"20240611100310-vxc09qy","Type":"NodeParagraph","Properties":{"id":"20240611100310-vxc09qy","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611100310-wz2m18g","Type":"NodeParagraph","Properties":{"id":"20240611100310-wz2m18g","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" European Grape Fruit"}]},{"ID":"20240611100310-0icjfbt","Type":"NodeParagraph","Properties":{"id":"20240611100310-0icjfbt","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611100310-10v88k0","Type":"NodeParagraph","Properties":{"id":"20240611100310-10v88k0","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 1.《名医别录》：葡萄，生陇西五原炖煌山谷。"}]},{"ID":"20240611100310-717dzi7","Type":"NodeParagraph","Properties":{"id":"20240611100310-717dzi7","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：葡萄，其圆者名草龙殊，长者名马乳葡萄，白者名水晶葡萄，黑看名紫葡萄。《汉书》言张骞使西域还，始得此种，而《神农本草》已有葡萄，则汉前陇西旧有，但未入关耳。葡萄折藤压之最易生，春月萌苞生叶，颇似栝楼叶，而有五尖，生须延蔓，引数十丈，三月开小花，成穗，黄白色。乃连着实，星编珠聚，七、八月熟，有紫、白二色，西人及太原、平阳皆作葡萄干，货之"}]},{"ID":"20240611100310-nrgeqbs","Type":"NodeParagraph","Properties":{"id":"20240611100310-nrgeqbs","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611100310-ixcc7w6","Type":"NodeParagraph","Properties":{"id":"20240611100310-ixcc7w6","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 药材基源：为葡萄科植物葡萄的果实。"}]},{"ID":"20240611100310-fyz6ae7","Type":"NodeParagraph","Properties":{"id":"20240611100310-fyz6ae7","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Vitis vinifera L."}]},{"ID":"20240611100310-hbkvu4j","Type":"NodeParagraph","Properties":{"id":"20240611100310-hbkvu4j","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋果实成熟时采收，鲜用或风干。"}]},{"ID":"20240611100310-g4ynjge","Type":"NodeParagraph","Properties":{"id":"20240611100310-g4ynjge","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611100310-t3thsev","Type":"NodeParagraph","Properties":{"id":"20240611100310-t3thsev","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 原产亚洲西部。现我国各地普遍栽培。"}]},{"ID":"20240611100310-kht94rw","Type":"NodeParagraph","Properties":{"id":"20240611100310-kht94rw","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611100310-6xo581q","Type":"NodeParagraph","Properties":{"id":"20240611100310-6xo581q","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 葡萄 高大缠绕藤本。幼茎秃净或略被绵毛；卷须二叉状分枝，与叶对生。叶互生；叶柄长4-8cm；叶片纸质，圆卵形或圆形，宽10-20cm，常3-5裂，基部心形，边缘有粗而稍尖锐的齿缺，下面常密被蛛丝状绵毛；花杂性，异株；圆锥花序大而长，与叶对生，被疏蛛丝状柔毛；花序柄无卷须；萼极小，杯状，全缘或不明显的5齿裂；花瓣5，黄绿色，先端粘合不展开，基部分离，开花时呈帽状整块脱落；雄蕊5；花盘隆起，由5个腺体组成，基部与子房合生；子房2室，花柱短，圆锥形。浆果卵圆形至卵状长圆形，富汁液，熟时紫黑色或红而带青色，外被蜡粉。花期6月，果期9-10月。"}]},{"ID":"20240611100310-tsq1geh","Type":"NodeParagraph","Properties":{"id":"20240611100310-tsq1geh","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611100310-aijukum","Type":"NodeParagraph","Properties":{"id":"20240611100310-aijukum","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品鲜品为圆形或椭圆形，干品均皱缩，长3-7mm，直径2-6mm，表面淡黄绿色至暗红色。顶端有残存柱基，微凸尖，基部有果柄痕，有的残存果柄。质稍柔软，易被撕裂，富糖质，气微，味甜微酸。"}]},{"ID":"20240611100310-m2nxfx6","Type":"NodeParagraph","Properties":{"id":"20240611100310-m2nxfx6","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"显微鉴别 果实横切面：外果皮表皮细胞1层，排列整齐切向延长，壁稍厚，外被角质层。中果皮广阔，中果皮内侧细胞有众多草酸钙簇晶，排列成断续的环带。中果皮细胞还有散在的簇晶、柱晶、不规则状的晶体以及棕黄色内含物。果皮外测维管束为外韧型，果实中心的维管来倒转为内韧型，常4个在一起。"}]},{"ID":"20240611100310-cew0j5k","Type":"NodeParagraph","Properties":{"id":"20240611100310-cew0j5k","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611100310-0bngge9","Type":"NodeParagraph","Properties":{"id":"20240611100310-0bngge9","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 果含葡萄糖（glucose），果糖（fructose），少量蔗糖（sucrose），木糖（xylose），酒石酸（tartaric acid），苹果酸（malic acid）。并含各种花色素的单葡萄糖甙和双葡萄糖甙。果皮含矢车菊素（cyanidin），芍药花素（peonidin），飞燕草素（delphinidin），矮牵牛素（petunidin），锦葵花素（malvidin），锦葵花素-3-β-葡萄糖甙（oenin）。此外，本品还含原矢车菊酚低聚物（procyanidol oligomers）。"}]},{"ID":"20240611100310-4b6zwjv","Type":"NodeParagraph","Properties":{"id":"20240611100310-4b6zwjv","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611100310-z7gv5lt","Type":"NodeParagraph","Properties":{"id":"20240611100310-z7gv5lt","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 在作用方面葡萄有某种维生素P的活性。种子油15g口服可降低胃酸度；12g可利胆(胆绞痛发作时无效)；40-50g有致泻作用。叶、茎有收敛作用，但无杭菌效力。"}]},{"ID":"20240611100310-uz58p55","Type":"NodeParagraph","Properties":{"id":"20240611100310-uz58p55","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611100310-wzduv7z","Type":"NodeParagraph","Properties":{"id":"20240611100310-wzduv7z","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粗粉2g，加50％乙醇10ml，浸渍30min，滤液照下述方法试验：①取滤液1ml，加碱性酒石酸铜试液2ml，发生棕红色沉淀。（检查还原糖）②纸色谱：用上述滤液点样于新华滤纸（1号），用正丁醇-醋酸-水（4：1：5）上层液15ml，加甲醇3ml为展开剂，展距15cm，用a-萘酚硫酸试剂显色，显2个蓝色斑点，其中1个与果糖对照品一致。"}]},{"ID":"20240611100310-c8hdsmh","Type":"NodeParagraph","Properties":{"id":"20240611100310-c8hdsmh","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611100310-aq5fnn8","Type":"NodeParagraph","Properties":{"id":"20240611100310-aq5fnn8","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 肺；脾；肾经"}]},{"ID":"20240611100310-ldabjo6","Type":"NodeParagraph","Properties":{"id":"20240611100310-ldabjo6","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611100310-rs1amb8","Type":"NodeParagraph","Properties":{"id":"20240611100310-rs1amb8","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 甘；酸；平"}]},{"ID":"20240611100310-1btgcx8","Type":"NodeParagraph","Properties":{"id":"20240611100310-1btgcx8","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611100310-x6a7d2v","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611100310-x6a7d2v","updated":"20240611100310"},"Children":[{"ID":"20240611100310-wcoq5fv","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611100310-wcoq5fv","updated":"20240611100310"},"Children":[{"ID":"20240611100310-vny5gnj","Type":"NodeParagraph","Properties":{"id":"20240611100310-vny5gnj","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"孟诜：不堪多食，令人卒烦闷眼暗。"}]}]}]},{"ID":"20240611100310-tp6vtfe","Type":"NodeParagraph","Properties":{"id":"20240611100310-tp6vtfe","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：食多令人泄泻。"}]},{"ID":"20240611100310-3p61mnn","Type":"NodeParagraph","Properties":{"id":"20240611100310-3p61mnn","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"3.《医林纂要》：多食生内热。"}]},{"ID":"20240611100310-5uwyktx","Type":"NodeParagraph","Properties":{"id":"20240611100310-5uwyktx","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611100310-bhcjspg","Type":"NodeParagraph","Properties":{"id":"20240611100310-bhcjspg","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 补气血；强筋骨；利小便。主气血虚弱；肺虚咳嗽；心悸盗汗；烦渴；风湿痹痛；淋病；不肿；痘疹不透"}]},{"ID":"20240611100310-wk9367x","Type":"NodeParagraph","Properties":{"id":"20240611100310-wk9367x","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611100310-k8iqwpq","Type":"NodeParagraph","Properties":{"id":"20240611100310-k8iqwpq","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g；或捣汁；或熬膏；或浸酒。外用：适量，浸酒涂擦；或捣汁含咽；或研末撒。"}]},{"ID":"20240611100310-d9maznw","Type":"NodeParagraph","Properties":{"id":"20240611100310-d9maznw","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611100310-eij4xnd","Type":"NodeParagraph","Properties":{"id":"20240611100310-eij4xnd","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" ①强肾： SUOXUO葡萄、人参各一钱。火酒浸一宿，侵晨涂手心，摩擦腰脊，能助力强壮，劳卧时摩擦腰脊，力能助肾坚强，服之尤为得力。 (《本经逢原》)②治热淋，小便涩少，碜痛沥血： 葡萄(绞取汁)五合，藕汁五合，生地黄汁五合，蜜五两。上相和，煎为稀饧，每于食前服二合。 (《圣惠方》葡萄煎)③除烦止渴：生葡萄捣滤取汁，以瓦器熬稠，入熟蜜少许，同收，点汤饮。 (《居家必用事类全集》)④治吹乳： 葡萄一枚，于灯焰上燎过，研细，热酒调服。(《圣济总录》葡萄酒)⑤治牙龈肿痛， 势欲成痈者： 葡萄干去核，填满焰硝煅之。焰过，取置地上成炭，研末擦之，涎出，任吐自瘥。 (《医级》葡硝散)"}]},{"ID":"20240611100310-mulwrwe","Type":"NodeParagraph","Properties":{"id":"20240611100310-mulwrwe","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611100310-9kzfasl","Type":"NodeParagraph","Properties":{"id":"20240611100310-9kzfasl","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主筋骨湿痹，益气倍力，强志，令人肥健耐饥，忍风寒。可作酒。"}]},{"ID":"20240611100310-0pqql2z","Type":"NodeParagraph","Properties":{"id":"20240611100310-0pqql2z","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"2.《别录》：逐水，利小便。"}]},{"ID":"20240611100310-lnysjug","Type":"NodeParagraph","Properties":{"id":"20240611100310-lnysjug","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：除肠阎水气，调中治淋，通小便。"}]},{"ID":"20240611100310-cts6tc8","Type":"NodeParagraph","Properties":{"id":"20240611100310-cts6tc8","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：治时气发疮疹不出者，研酒饮。"}]},{"ID":"20240611100310-fnpuy37","Type":"NodeParagraph","Properties":{"id":"20240611100310-fnpuy37","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：大补气血，舒筋活络，泡酒服之。治阴阳脱症，又治盗汗虚证。汁，治咳嗽。"}]},{"ID":"20240611100310-c2wxg2m","Type":"NodeParagraph","Properties":{"id":"20240611100310-c2wxg2m","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"6.《滇南本草图说》：治痘症毒，胎气上冲，煎汤饮之即下。"}]},{"ID":"20240611100310-jrqe3ds","Type":"NodeParagraph","Properties":{"id":"20240611100310-jrqe3ds","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"7.《百草镜》：治筋骨湿痛。利水甚捷，除遍身浮肿。"}]},{"ID":"20240611100310-tjggax2","Type":"NodeParagraph","Properties":{"id":"20240611100310-tjggax2","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"8.《本草再新》：暖胃健脾，治肺虚寒嗽，贩血积疽瘤。"}]},{"ID":"20240611100310-0j6p313","Type":"NodeParagraph","Properties":{"id":"20240611100310-0j6p313","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"9.《随息居饮食谱》：补气，滋肾液，益肝阴，强筋骨，止渴，安胎。"}]},{"ID":"20240611100310-gzl4lsc","Type":"NodeParagraph","Properties":{"id":"20240611100310-gzl4lsc","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"10.《新疆药材》：解毒，散表。"}]},{"ID":"20240611100310-zi9vtj0","Type":"NodeParagraph","Properties":{"id":"20240611100310-zi9vtj0","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"11.《陆川本草》：滋养强壮，补血，强心利尿。治腰痛，胃病，精神疲惫，血虚心跳。"}]},{"ID":"20240611100310-gz1tga3","Type":"NodeParagraph","Properties":{"id":"20240611100310-gz1tga3","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611100310-r1xyqm9","Type":"NodeParagraph","Properties":{"id":"20240611100310-r1xyqm9","updated":"20240611100310"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611100311-o70ttss","Type":"NodeThematicBreak","Properties":{"id":"20240611100311-o70ttss"}},{"ID":"20240611100312-14duws2","Type":"NodeParagraph","Properties":{"id":"20240611100312-14duws2"}}]}