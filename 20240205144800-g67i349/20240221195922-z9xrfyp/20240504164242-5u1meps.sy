odeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 398px;","style":"width: 388px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 11-20240724160429-a2y5mkg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 388px;\" parent-style=\"width: 398px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 403px;","style":"width: 393px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 12-20240724160507-qs9wu3r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 393px;\" parent-style=\"width: 403px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724160052-59wrp51","Type":"NodeParagraph","Properties":{"id":"20240724160052-59wrp51","updated":"20240724161118"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 227px;","style":"width: 217px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 14-20240724161038-moewq4a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 217px;\" parent-style=\"width: 227px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 498px;","style":"width: 488px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (13)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 13-20240724160721-fqu6pns.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 488px;\" parent-style=\"width: 498px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 554px;","style":"width: 544px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 15-20240724161118-xgcu7fj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 544px;\" parent-style=\"width: 554px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621115734-chgs5aj","Type":"NodeParagraph","Properties":{"id":"20240621115734-chgs5aj","updated":"20240724155148"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"莲藕"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/莲藕-20240621115734-erwam2l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 553px;","style":"width: 543px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621115903-l36gque.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 543px;\" parent-style=\"width: 553px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724155706-treztaq","Type":"NodeParagraph","Properties":{"id":"20240724155706-treztaq","updated":"20240724155737"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 7-20240724155706-fopuwcu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 721px;","style":"width: 711px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 8-20240724155737-t3yiio5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 711px;\" parent-style=\"width: 721px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724155553-bodv2kv","Type":"NodeParagraph","Properties":{"id":"20240724155553-bodv2kv","updated":"20240811170611"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荷花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荷花 6-20240724155553-f41agfl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611095138-q2ykegr","Type":"NodeParagraph","Properties":{"id":"20240611095138-q2ykegr","updated":"20240621124220"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：即莲藕。"}]},{"ID":"20240611095138-nxtq7rv","Type":"NodeThematicBreak","Properties":{"id":"20240611095138-nxtq7rv"}},{"ID":"20240611095244-5q00fe4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095244-5q00fe4","updated":"20240611095252"},"Children":[{"Type":"NodeText","Data":"藕实茎《神农本草经》"}]},{"ID":"20240611095244-psvl46y","Type":"NodeParagraph","Properties":{"id":"20240611095244-psvl46y","updated":"20240611095244"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240611095244-tkn58xr","Type":"NodeParagraph","Properties":{"id":"20240611095244-tkn58xr","updated":"20240611095244"},"Children":[{"Type":"NodeText","Data":"主补中养神，益气力，除百疾。久服，轻身耐老，不饥延年。一名水芝丹。生池泽。"}]},{"ID":"20240611095244-aijjfx3","Type":"NodeParagraph","Properties":{"id":"20240611095244-aijjfx3","updated":"20240611095244"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名莲，生汝南，八月采。"}]},{"ID":"20240611095244-ra55ppd","Type":"NodeParagraph","Properties":{"id":"20240611095244-ra55ppd","updated":"20240611095244"},"Children":[{"Type":"NodeText","Data":"案《说文》云：藕，夫渠根。莲，夫渠之实也。茄，夫渠茎。《尔雅》云：荷，芙渠。郭璞云：别名芙蓉，江东呼荷，又其茎茄，其实莲。郭璞云：莲谓房也，又其根藕。"}]},{"ID":"20240611095256-jjx6zeo","Type":"NodeThematicBreak","Properties":{"id":"20240611095256-jjx6zeo"}},{"ID":"20240611095306-i7by6xn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095306-i7by6xn","updated":"20240611095311"},"Children":[{"Type":"NodeText","Data":"藕实茎《神农本草经读》"}]},{"ID":"20240611095306-atdtryx","Type":"NodeParagraph","Properties":{"id":"20240611095306-atdtryx","updated":"20240611095306"},"Children":[{"Type":"NodeText","Data":"气味甘、平。主补中养神，益气力，除百疾。久服轻身耐老，不饥延年。"}]},{"ID":"20240611095316-dq7e2w4","Type":"NodeThematicBreak","Properties":{"id":"20240611095316-dq7e2w4"}},{"ID":"20240611095333-pm0fq2d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095333-pm0fq2d","updated":"20240611095338"},"Children":[{"Type":"NodeText","Data":"藕实茎《神农本草经赞》"}]},{"ID":"20240611095333-8rmzupc","Type":"NodeParagraph","Properties":{"id":"20240611095333-8rmzupc","updated":"20240611095333"},"Children":[{"Type":"NodeText","Data":"味甘平。主补中养神。益气力。除百疾。久服轻身耐老。不饥延年。一名水芝丹。"}]},{"ID":"20240611095333-l4kpwzl","Type":"NodeParagraph","Properties":{"id":"20240611095333-l4kpwzl","updated":"20240611095333"},"Children":[{"Type":"NodeText","Data":"生池泽。"}]},{"ID":"20240611095333-cnqaigj","Type":"NodeParagraph","Properties":{"id":"20240611095333-cnqaigj","updated":"20240611095333"},"Children":[{"Type":"NodeText","Data":"冰丝玉节。蛰卧川阿。红裳独立。翠扇交摩。中藏鱼目。仰露蜂窠。水羞相辈。痊起沉。"}]},{"ID":"20240611095333-566g7sl","Type":"NodeParagraph","Properties":{"id":"20240611095333-566g7sl","updated":"20240611095333"},"Children":[{"Type":"NodeText","Data":"于慎行诗。冰丝欲断鲛人缕。陶弼诗。谁将玉节栽。冯璧诗。蛰卧时奋迅。王勃赋。誓毕赏于川阿。李纲赋。红裳影斜。韩诗。香囊独立红。许浑诗。烟开翠扇清风晓。京房易传。"}]},{"ID":"20240611095333-ruvvd66","Type":"NodeParagraph","Properties":{"id":"20240611095333-ruvvd66","updated":"20240611095333"},"Children":[{"Type":"NodeText","Data":"相摩而鸣。高启联句。鱼目微光皎。张楫诗。飞尽黄蜂露蜜房。刘孝威启。凡厥水羞。莫敢相辈。谢诗。已觉沉痊。"}]},{"ID":"20240611095154-ptjcdjl","Type":"NodeThematicBreak","Properties":{"id":"20240611095154-ptjcdjl"}},{"ID":"20240611095156-rvtz0mg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095156-rvtz0mg","updated":"20240611095200"},"Children":[{"Type":"NodeText","Data":"藕实茎《神农本草经百种录》"}]},{"ID":"20240611095156-kporvkt","Type":"NodeParagraph","Properties":{"id":"20240611095156-kporvkt","updated":"20240611095156"},"Children":[{"Type":"NodeText","Data":"一气相通，茎与实无异，非若他药之根实各殊也。味甘平。主补中，味甘淡得中土之性。养神，气香而中虚。益气力，脾肾旺则气血强。除百疾。中和之性无偏杂之害也。久服，轻身耐老，不饥延年。和平之效。"}]},{"ID":"20240611095156-31onned","Type":"NodeParagraph","Properties":{"id":"20240611095156-31onned","updated":"20240611095156"},"Children":[{"Type":"NodeText","Data":"藕者水土之精也，故能养脾胃之阴。生水底污泥之中，而无处不香，无节不通，故又能疏达脾胃之气，而滋其血脉。湿而不滞，香而不燥，果中之圣品也。"}]},{"ID":"20240611095506-wd6snf5","Type":"NodeThematicBreak","Properties":{"id":"20240611095506-wd6snf5"}},{"ID":"20240611095507-rz4foa6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095507-rz4foa6","updated":"20240611095511"},"Children":[{"Type":"NodeText","Data":"藕实茎《新修本草》"}]},{"ID":"20240611095507-rkvvun3","Type":"NodeParagraph","Properties":{"id":"20240611095507-rkvvun3","updated":"20240611095507"},"Children":[{"Type":"NodeText","Data":"味甘，平、寒，无毒。主补中养神，益气力，除百疾，久服轻身耐老，不饥，延年。一名水芝丹，一名莲。生汝南池泽，八月采。"}]},{"ID":"20240611095507-6a0mzvf","Type":"NodeParagraph","Properties":{"id":"20240611095507-6a0mzvf","updated":"20240611095507"},"Children":[{"Type":"NodeText","Data":"即今莲子，八月、九月取坚黑者，干捣破之。花及根并入神仙用。今云茎，恐即是根，不尔不应言甘也。宋帝时，太官作羊血KT ，庖人削藕皮误落血中，遂皆散不凝，医仍用藕疗血多效也。"}]},{"ID":"20240611095507-dalyrkg","Type":"NodeParagraph","Properties":{"id":"20240611095507-dalyrkg","updated":"20240611095507"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶藕，主热渴，散血，生肌。久服令人心欢。"}]},{"ID":"20240611095138-eio4ogq","Type":"NodeThematicBreak","Properties":{"id":"20240611095138-eio4ogq"}},{"ID":"20240611095140-oeks5ut","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095140-oeks5ut","updated":"20240611095147"},"Children":[{"Type":"NodeText","Data":"藕实茎《证类本草》"}]},{"ID":"20240611095140-vufnioq","Type":"NodeParagraph","Properties":{"id":"20240611095140-vufnioq","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"味甘，平、寒，无毒。主补中养神，益气力，除百疾。久服轻身耐老，不饥延年。"}]},{"ID":"20240611095140-xw36tl4","Type":"NodeParagraph","Properties":{"id":"20240611095140-xw36tl4","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"一名水芝丹，一名莲。生汝南池泽。八月采。"}]},{"ID":"20240611095140-f9ds4f8","Type":"NodeParagraph","Properties":{"id":"20240611095140-f9ds4f8","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此即今莲子，八月、九月取坚黑者，干捣破之。花及根并入神仙用。今云茎，恐即是根，不尔不应言甘也。宋帝时，太官作血 （音勘），庖人削藕皮误落血中，遂皆散不凝，医乃用藕疗血多效也。唐本注云∶《别录》云，藕，主热渴，散血，生肌。久服令人心欢。臣禹锡等谨按蜀本图经云∶此生水中。叶名荷，圆径尺余。《尔雅》云∶荷，芙蕖。其茎茄，其叶 ，其本 ，其华菡萏，其实莲，其根藕，其中的，的中薏是也。《尔雅》释曰∶芙蕖，其总名也，别名芙蓉，江东人呼荷。菡萏，莲花也。的，莲实也。薏，中心也。郭云∶，茎下白 在泥中者。今江东人呼荷华为芙蓉，北方∶人便以藕为荷，亦以莲为荷。蜀人以藕为茄，或用其母为华名，或用根子为母叶号。此皆名相错，习俗传误，失其正体也。"}]},{"ID":"20240611095140-ylgvwzp","Type":"NodeParagraph","Properties":{"id":"20240611095140-ylgvwzp","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"陆机疏云∶莲，青皮里白，子为的，的中有青为薏，味甚苦，故俚语云苦如薏，是也。药性论云∶藕汁亦单用，味甘，能消瘀血不散。节捣汁，主吐血不止，口鼻并皆治之。孟诜云∶藕，生食之，主霍乱后虚渴、烦闷、不能食。其产后忌生冷物，惟藕不同生冷，为能破血故也。又蒸食甚补五脏，实下焦。与蜜同食，令人腹脏肥，不生诸虫。亦可休粮。仙家有贮石莲子及干藕经千年者，食之到妙矣。又云∶莲子，性寒，主五脏不足，伤中气绝，利益十二经脉血气。生食微动气，蒸食之良。又熟去心，为末，蜡蜜和丸。日服三十丸，令人不饥。此方∶仙家用尔。又雁腹中者，空腹食十枚，身轻，能登高涉远。雁食，粪于田野中，经年尚生。"}]},{"ID":"20240611095140-a75fz1n","Type":"NodeParagraph","Properties":{"id":"20240611095140-a75fz1n","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"又或于山岩之中止息，不逢阴雨，经久不坏。又诸鸟、猿猴不食，藏之石室内，有得三百余年者，逢此食，永不老矣。其房、荷叶，皆破血。陈藏器云∶藕实，莲也。本功外，食之宜蒸，生则胀人腹。中薏，令人吐，食当去之。经秋正黑者名石莲，入水必沉，惟煎盐卤能浮之。石莲，山海间经百年不坏，取得食之，令发黑不老。藕，本功外，消食止泄，除烦解酒毒，压食，及病后热渴。又云∶荷鼻，味苦，平，无毒。主安胎，去恶血，留好血，血痢，煮服之。即荷叶蒂也。又叶及房，主血胀腹痛，产后胎衣不下，酒煮服之。又主食野菌毒，水煮服之。郑玄云∶芙蕖之茎曰荷。的中薏，食之令人霍乱。陈士良云∶莲子心，生取为末，以米饮调下三钱，疗血、渴疾。产后渴疾，服之立愈。日华子云∶藕，温。止霍乱，开胃消食，除烦止闷，口干渴疾。止怒，令人喜。破产后血闷，生研服亦不妨。捣罾金疮并伤折，止暴痛。蒸煮食，大开胃。节，冷。解热毒，消瘀血。产后血闷，合地黄生研汁，热酒并小便服，并得。又云∶莲子，温，并石莲。益气止渴，助心，止痢。治腰痛，治泄精，安心，多食令人喜，又名莲的。莲子心，止霍乱。又云莲花，暖，无毒。镇心，轻身，益色，驻颜。"}]},{"ID":"20240611095140-u4dx219","Type":"NodeParagraph","Properties":{"id":"20240611095140-u4dx219","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"入香甚妙。忌地黄、蒜。又云荷叶，止渴，落胞，杀蕈毒，并产后口干，心肺燥，烦闷，入药炙用之。"}]},{"ID":"20240611095140-9y3vftp","Type":"NodeParagraph","Properties":{"id":"20240611095140-9y3vftp","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"图经曰∶藕实茎，生汝南池泽，今处处有之。生水中，其叶名荷。谨按《尔雅》及陆机疏谓∶荷为芙蕖，江东呼荷。其茎茄；其叶 （加遐二音或作葭）；其本 （土笔切），茎下白（音若）在泥中者；其花未发为菡萏，已发为芙蓉；其实莲，莲，谓房也；其根藕，幽州人谓之光旁，至深益大，如人臂；其中的。莲中子，谓青皮白子也。中有青，长二分，为薏，中心苦者是也。凡此数物，今人皆以中药。藕，生食其茎，主霍乱后虚渴烦闷，不能食及解酒食毒。花，镇心，益颜色，入香尤佳。荷叶，止渴，杀蕈毒。今妇人药多有用荷叶者。叶中蒂，谓之荷鼻。主安胎，去恶血，留好血。实，主益气。其的至秋表皮黑而沉水者，谓之石莲。陆机云∶可磨为豉，如米饭，轻身益气，令人强健。医人炒末以止痢，治腰痛。又治哕逆，以实仁六枚，炒赤黄色，研末，冷熟水半盏，和服，便止。惟苦薏不可食，能令霍乱。"}]},{"ID":"20240611095140-cufgzl0","Type":"NodeParagraph","Properties":{"id":"20240611095140-cufgzl0","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"大抵功用主血多效。乃因宋太官作血 ，庖人削藕皮，误落血中，遂散不凝，自此医家方∶用主血也。"}]},{"ID":"20240611095140-csntjc6","Type":"NodeParagraph","Properties":{"id":"20240611095140-csntjc6","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治时气烦渴。用生藕汁一中盏，入生蜜一合，令匀，分为二服。又方∶治食蟹中毒。以以火干荷叶五斤，烧令烟尽，细研。食前以童子热小便一小盏，调三钱匕，日三服。又方∶益耳目，补中，聪明强志。莲实半两，去皮心细研，先煮令熟；次以粳米三合作粥，候熟，入莲实，搅匀食之。千金方∶治坠马，积血心腹，唾血无数。干藕根末，酒服方寸匕，日三。肘后方∶令易产。莲花一叶，书\"人\"字吞之，立产。经验后方∶主吐血咯血。以荷叶焙干为末，米汤下二钱匕。梅师方∶治产后余血不尽，奔上冲心，烦闷腹痛。以生藕汁二升饮之。孙真人∶莲子不去心食，成霍乱。食医心镜∶藉实，味甘，平，无毒。主补中养神，益气力，除百病。久服令人欢心，止渴去热，轻身耐老，不饥延年。其根止热渴，破留血，生肌。久服令人悦泽矣。救急方∶治产后血不尽，疼闷心痛。荷叶熬令香，为末，煎水下方寸匕。集验方∶治漆疮。取莲叶干者的成可食，可摩以为饭，如粟饭。轻身养气，令人强健。又可为粥。唐书姜抚言服常春藤，使曰发还须，则长生可致。藤生太湖最良。终南往往有之，不及也。帝遣使者至太湖，多取以赐中朝老臣。又言终南山有旱藕，饵之延年。状类葛粉。帝作汤饼赐大臣。右骁卫将军甘守诚，能订药石，曰∶常春者，千岁 也；旱藕，牡蒙也。方∶家久不用，抚易名以神之。太清诸草木方∶七月七日采莲花七分，八月八日采根八分，九月九日采实九分，阴干捣筛，服方寸匕，令人不老。华山记华山顶有池，生千叶莲花，服之羽化。"}]},{"ID":"20240611095140-q2zstpa","Type":"NodeParagraph","Properties":{"id":"20240611095140-q2zstpa","updated":"20240611095140"},"Children":[{"Type":"NodeText","Data":"衍义曰∶藕实，就蓬中干者为石莲子，取其肉，于砂盆中干，擦去浮上赤色，留青心为末，少入龙脑为汤点，宁心志，清神。然亦有粉红千叶、白千叶者皆不实。如此是有四等也。其根惟白莲为佳。今禁中又生碧莲，亦一瑞也。"}]},{"ID":"20240611095140-t1n5egk","Type":"NodeThematicBreak","Properties":{"id":"20240611095140-t1n5egk"}},{"ID":"20240611095353-jpnn0sp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095353-jpnn0sp","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：藕"}]},{"ID":"20240611095353-owknwxz","Type":"NodeParagraph","Properties":{"id":"20240611095353-owknwxz","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095353-hgqm696","Type":"NodeParagraph","Properties":{"id":"20240611095353-hgqm696","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" ǒu"}]},{"ID":"20240611095353-nyjnntb","Type":"NodeParagraph","Properties":{"id":"20240611095353-nyjnntb","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095353-8q216ox","Type":"NodeParagraph","Properties":{"id":"20240611095353-8q216ox","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 本品为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"莲"},{"Type":"NodeText","Data":"Nelumbo nucifera Gaertn. 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根状茎"},{"Type":"NodeText","Data":"。秋冬采挖，多生用。"}]},{"ID":"20240611095353-6ta7l31","Type":"NodeParagraph","Properties":{"id":"20240611095353-6ta7l31","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095353-l476jzq","Type":"NodeParagraph","Properties":{"id":"20240611095353-l476jzq","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240611095353-s7eyevk","Type":"NodeParagraph","Properties":{"id":"20240611095353-s7eyevk","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095353-kv73p23","Type":"NodeParagraph","Properties":{"id":"20240611095353-kv73p23","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 凉血散瘀，止渴除烦。用于热病烦渴，咯血，衄血，吐血，便血，尿血。"}]},{"ID":"20240611095353-ykrk68f","Type":"NodeParagraph","Properties":{"id":"20240611095353-ykrk68f","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095353-wkpagbd","Type":"NodeParagraph","Properties":{"id":"20240611095353-wkpagbd","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 0.5～1斤，分数次生吃，或捣汁去渣分服，或煎浓汁服。"}]},{"ID":"20240611095353-vxaiu20","Type":"NodeParagraph","Properties":{"id":"20240611095353-vxaiu20","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095353-yrwyvt8","Type":"NodeParagraph","Properties":{"id":"20240611095353-yrwyvt8","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611095353-33f7kpz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095353-33f7kpz","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：藕"}]},{"ID":"20240611095353-jsg5qvz","Type":"NodeParagraph","Properties":{"id":"20240611095353-jsg5qvz","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095353-0m0jbs5","Type":"NodeParagraph","Properties":{"id":"20240611095353-0m0jbs5","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" ǒu"}]},{"ID":"20240611095353-n6st5i3","Type":"NodeParagraph","Properties":{"id":"20240611095353-n6st5i3","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095353-fdy0r1f","Type":"NodeParagraph","Properties":{"id":"20240611095353-fdy0r1f","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 光旁（陆玑《诗疏》）。"}]},{"ID":"20240611095353-2b6153h","Type":"NodeParagraph","Properties":{"id":"20240611095353-2b6153h","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611095353-klv26h0","Type":"NodeParagraph","Properties":{"id":"20240611095353-klv26h0","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611095353-tslqo1p","Type":"NodeParagraph","Properties":{"id":"20240611095353-tslqo1p","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095353-k28fln2","Type":"NodeParagraph","Properties":{"id":"20240611095353-k28fln2","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"莲"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肥大根茎"},{"Type":"NodeText","Data":"。秋、冬及春初采挖。"}]},{"ID":"20240611095353-eyxkvwc","Type":"NodeParagraph","Properties":{"id":"20240611095353-eyxkvwc","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611095353-xitvzmn","Type":"NodeParagraph","Properties":{"id":"20240611095353-xitvzmn","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 藕（根茎）含淀粉、蛋白质、天门冬素、维生素C。还含焦性儿茶酚、d-没食子儿茶精、新绿原酸、无色矢车菊素、无色飞燕草素等多酚化合物共约0.3％，以及过氧化物酶。"}]},{"ID":"20240611095353-t2ys87t","Type":"NodeParagraph","Properties":{"id":"20240611095353-t2ys87t","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095353-f58np2x","Type":"NodeParagraph","Properties":{"id":"20240611095353-f58np2x","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 入心、脾、胃经。"}]},{"ID":"20240611095353-avpkevb","Type":"NodeParagraph","Properties":{"id":"20240611095353-avpkevb","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入脾经。\""}]},{"ID":"20240611095353-nczdg6p","Type":"NodeParagraph","Properties":{"id":"20240611095353-nczdg6p","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入心、脾、胃三经。\""}]},{"ID":"20240611095353-688k10n","Type":"NodeParagraph","Properties":{"id":"20240611095353-688k10n","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"③《要药分剂》：\"入心、肝、脾、胃四经。\""}]},{"ID":"20240611095353-wm8a0yv","Type":"NodeParagraph","Properties":{"id":"20240611095353-wm8a0yv","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入心、肝、肺三经。\""}]},{"ID":"20240611095353-rcdl08i","Type":"NodeParagraph","Properties":{"id":"20240611095353-rcdl08i","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095353-bb5soi6","Type":"NodeParagraph","Properties":{"id":"20240611095353-bb5soi6","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 甘，寒。"}]},{"ID":"20240611095353-bp8btfr","Type":"NodeParagraph","Properties":{"id":"20240611095353-bp8btfr","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"寒，无毒。\""}]},{"ID":"20240611095353-dszseek","Type":"NodeParagraph","Properties":{"id":"20240611095353-dszseek","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"②《本草蒙筌》：\"甘，寒。\""}]},{"ID":"20240611095353-c5usxm5","Type":"NodeParagraph","Properties":{"id":"20240611095353-c5usxm5","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"生者甘，寒；熟者甘，温。\""}]},{"ID":"20240611095353-s9v1sj8","Type":"NodeParagraph","Properties":{"id":"20240611095353-s9v1sj8","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611095353-nkztvor","Type":"NodeParagraph","Properties":{"id":"20240611095353-nkztvor","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 赞宁《物类相感志》：\"忌铁器。\""}]},{"ID":"20240611095353-4cqjo6w","Type":"NodeParagraph","Properties":{"id":"20240611095353-4cqjo6w","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095353-k9et844","Type":"NodeParagraph","Properties":{"id":"20240611095353-k9et844","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 生用：清热，凉血，散瘀。治热病烦渴，吐血，衄血，热淋。熟用：健脾，开胃，益血，生肌，止泻。"}]},{"ID":"20240611095353-ehemgzc","Type":"NodeParagraph","Properties":{"id":"20240611095353-ehemgzc","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"藕汁，解射罔毒、蟹毒。\""}]},{"ID":"20240611095353-kikdzks","Type":"NodeParagraph","Properties":{"id":"20240611095353-kikdzks","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主热渴，散血，生肌。\""}]},{"ID":"20240611095353-cmn4xqf","Type":"NodeParagraph","Properties":{"id":"20240611095353-cmn4xqf","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"藕汁，能消瘀血不散。\""}]},{"ID":"20240611095353-nmb94h6","Type":"NodeParagraph","Properties":{"id":"20240611095353-nmb94h6","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"④崔禹锡《食经》：\"主烦热鼻血不止。\""}]},{"ID":"20240611095353-174jh0s","Type":"NodeParagraph","Properties":{"id":"20240611095353-174jh0s","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑤孟诜：\"生食之，主霍乱后虚渴、烦闷、不能食；蒸食甚补五脏，实下焦。\""}]},{"ID":"20240611095353-0ofpayc","Type":"NodeParagraph","Properties":{"id":"20240611095353-0ofpayc","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑥《本草拾遗》：\"消食止泄，除烦，解酒毒，压食及病后热渴。\""}]},{"ID":"20240611095353-642dbat","Type":"NodeParagraph","Properties":{"id":"20240611095353-642dbat","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑦《日华子本草》：\"破产后血闷，生研服亦不妨；捣罯金疮并伤折，止暴痛；蒸煮食，大开胃。\""}]},{"ID":"20240611095353-it0kjlj","Type":"NodeParagraph","Properties":{"id":"20240611095353-it0kjlj","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑧《日用本草》：\"清热除烦，凡呕血、吐血、瘀血、败血，一切血症宜食之。\""}]},{"ID":"20240611095353-vjrnyec","Type":"NodeParagraph","Properties":{"id":"20240611095353-vjrnyec","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑨《滇南本草》：\"多服润肠肺，生津液。\""}]},{"ID":"20240611095353-84hz47l","Type":"NodeParagraph","Properties":{"id":"20240611095353-84hz47l","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095353-5msbds3","Type":"NodeParagraph","Properties":{"id":"20240611095353-5msbds3","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 内服：生食、打汁或煮食。外用：捣敷。"}]},{"ID":"20240611095353-3giu6p2","Type":"NodeParagraph","Properties":{"id":"20240611095353-3giu6p2","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611095353-69fmz9u","Type":"NodeParagraph","Properties":{"id":"20240611095353-69fmz9u","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" ①治时气烦渴不止：生藕，捣绞取汁一中盏，入生蜜一合，搅令匀，不计时候，分为二服。（《圣惠方》）"}]},{"ID":"20240611095353-zt4l8am","Type":"NodeParagraph","Properties":{"id":"20240611095353-zt4l8am","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"②治霍乱吐不止，兼渴：生藕一两（洗，切），生姜一分（洗，切）。上二味，研绞取汁，分三服，不拘时。（《圣济总录》姜藕饮）"}]},{"ID":"20240611095353-lj8w8au","Type":"NodeParagraph","Properties":{"id":"20240611095353-lj8w8au","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"③治上焦痰热：藕汁、梨汁各半盏，和服。（《简便单方》）"}]},{"ID":"20240611095353-oqz8ang","Type":"NodeParagraph","Properties":{"id":"20240611095353-oqz8ang","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"④治红白痢：藕一斤，捣汁，和蜜糖，隔水炖成膏服。（《岭南采药录》）"}]},{"ID":"20240611095353-4tmoc4k","Type":"NodeParagraph","Properties":{"id":"20240611095353-4tmoc4k","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑤治小便热淋：生藕汁、地黄汁、葡萄汁各等分。每服半盏，入蜜温服。（《纲目》）"}]},{"ID":"20240611095353-ycm5jgv","Type":"NodeParagraph","Properties":{"id":"20240611095353-ycm5jgv","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑥治冻脚裂坼：蒸熟藕捣烂涂之。（《纲目》）"}]},{"ID":"20240611095353-yamn3hw","Type":"NodeParagraph","Properties":{"id":"20240611095353-yamn3hw","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑦治麦芒及尘土并物入眼不出：大藕一截，洗净捣烂，以帛子裹于眼上，挹取汁，落眼中。（《普济方》）"}]},{"ID":"20240611095353-u02yers","Type":"NodeParagraph","Properties":{"id":"20240611095353-u02yers","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑧治眼热赤痛：取莲藕一个，连节，以绿豆入满其中空处，水数碗，煎至半碗，连藕食之。（《岭南采药录》）"}]},{"ID":"20240611095353-5h14sgl","Type":"NodeParagraph","Properties":{"id":"20240611095353-5h14sgl","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611095353-41t58ld","Type":"NodeParagraph","Properties":{"id":"20240611095353-41t58ld","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" ①孟诜：\"产后忌食生冷物，惟藕不同生冷，为能破血故也。\""}]},{"ID":"20240611095353-vgyjho7","Type":"NodeParagraph","Properties":{"id":"20240611095353-vgyjho7","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"藕，生者甘寒，能凉血止血，除热清胃，故主消散瘀血，吐血、口鼻出血，产后血闷，罯金疮伤折及止热渴，霍乱，烦闷，解酒等功。熟者甘温，能健脾开胃，益血补心，故主补五脏，实下焦，消食，止泄，生肌，及久服令人心欢止怒也。\""}]},{"ID":"20240611095353-hbdtykz","Type":"NodeParagraph","Properties":{"id":"20240611095353-hbdtykz","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"藕，凉血散血，清热解暑之药也。其所主，皆心脾血分之疾。如陈氏方，治热渴烦闷，大氏方，治产后瘀血，孟氏治霍乱水泄，皆属热邪为患者，取此清芳寒洁、甘淡之味以凉解之，如血热血滞之病，悉潜消而默化矣。第生食过多，不免有动冷气，不无腹痛肠滑之虞耳。如煮熟食，能养脏腑，和脾胃。\""}]},{"ID":"20240611095353-ryoaxew","Type":"NodeParagraph","Properties":{"id":"20240611095353-ryoaxew","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"④《重庆堂随笔》：\"藕以仁和产者为良。熬浓汁服，既能补血，亦能通气，故无腻滞之偏。\""}]},{"ID":"20240611095353-vd31ier","Type":"NodeParagraph","Properties":{"id":"20240611095353-vd31ier","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"⑤《随息居饮食谱》：\"藕以肥白纯甘者良。生食宜鲜嫩，煮食宜壮老，用砂锅桑柴缓火煨极烂，入炼白蜜收干食之，最补心脾。若阴虚、肝旺、内热、血少及诸失血证，但日熬浓藕汤饮之，久久自愈，不服他药可也。\""}]},{"ID":"20240611095353-z4rxv88","Type":"NodeParagraph","Properties":{"id":"20240611095353-z4rxv88","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095353-kue03ma","Type":"NodeParagraph","Properties":{"id":"20240611095353-kue03ma","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611095353-0q66ivp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095353-0q66ivp","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"《中华本草》：藕"}]},{"ID":"20240611095353-xyfh4g6","Type":"NodeParagraph","Properties":{"id":"20240611095353-xyfh4g6","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095353-a5mq7ms","Type":"NodeParagraph","Properties":{"id":"20240611095353-a5mq7ms","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" ǒu"}]},{"ID":"20240611095353-i56xvdv","Type":"NodeParagraph","Properties":{"id":"20240611095353-i56xvdv","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095353-s4kroic","Type":"NodeParagraph","Properties":{"id":"20240611095353-s4kroic","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 光旁。"}]},{"ID":"20240611095353-vr7t1wf","Type":"NodeParagraph","Properties":{"id":"20240611095353-vr7t1wf","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611095353-fnth3tg","Type":"NodeParagraph","Properties":{"id":"20240611095353-fnth3tg","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" Lotus rhizome"}]},{"ID":"20240611095353-ztpfpgj","Type":"NodeParagraph","Properties":{"id":"20240611095353-ztpfpgj","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611095353-6b8noxi","Type":"NodeParagraph","Properties":{"id":"20240611095353-6b8noxi","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240611095353-aiox1a3","Type":"NodeParagraph","Properties":{"id":"20240611095353-aiox1a3","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095353-0r8euaq","Type":"NodeParagraph","Properties":{"id":"20240611095353-0r8euaq","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 药材基源：为睡莲科植物莲Nelumbo nucifera Gaerth.的肥大根茎。"}]},{"ID":"20240611095353-oj54qty","Type":"NodeParagraph","Properties":{"id":"20240611095353-oj54qty","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Nelumbo nucifera Gaertn."}]},{"ID":"20240611095353-vxnfuvl","Type":"NodeParagraph","Properties":{"id":"20240611095353-vxnfuvl","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬及春初采挖。"}]},{"ID":"20240611095353-pwhj9hu","Type":"NodeParagraph","Properties":{"id":"20240611095353-pwhj9hu","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611095353-g2j4mls","Type":"NodeParagraph","Properties":{"id":"20240611095353-g2j4mls","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于水泽、池塘、湖沼或水田内，野生或栽培。"}]},{"ID":"20240611095353-e65w2h9","Type":"NodeParagraph","Properties":{"id":"20240611095353-e65w2h9","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"资源分布：广布于南北各地。"}]},{"ID":"20240611095353-9okus10","Type":"NodeParagraph","Properties":{"id":"20240611095353-9okus10","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611095353-d5xwojm","Type":"NodeParagraph","Properties":{"id":"20240611095353-d5xwojm","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 莲 多年生水生草本。根茎横生，肥厚，节间膨大，内有多数纵行通气孔洞，外生须状不定根。节上生叶，露出水面；叶柄着生于叶背中央，粗壮，圆柱形，多刺；叶片圆形，直径25-90cm，全缘或稍呈波状，上面粉绿色，下面叶脉从中央射出，有1-2次叉状分枝。花单生于花梗顶端，花梗与叶柄等长或稍长，也散生小刺；花直径10-20cm，芳香，红色、粉红色或白色；花瓣椭圆形或倒卵形，长5-10cm，宽3-5cm；雄蕊多数，花药条形，花丝细长，着生于托之一；心皮多数埋藏于膨大的花托内，子房椭圆形，花柱极短。花后结“莲蓬”，倒锥形，直径5-10cm，有小孔20-30个，每孔内含果实1枚；坚果椭圆形或卵形，长1.5-2.5cm，果皮革质，坚硬，熟时黑褐色。种子卵形，或椭圆形，长1.2-1.7cm，种皮红色或白色。花期6-8月，果期8-10月。"}]},{"ID":"20240611095353-77nifq1","Type":"NodeParagraph","Properties":{"id":"20240611095353-77nifq1","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095353-v0yzfo8","Type":"NodeParagraph","Properties":{"id":"20240611095353-v0yzfo8","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 根茎肥厚横生，外皮黄白色，节部缢缩，生有腋芽及不定根，节间膨大，大小不等。质脆，断面白色，有许多大小不等的纵行管道，有白色细丝状物。无臭，味微甘而涩。"}]},{"ID":"20240611095353-2x8ikln","Type":"NodeParagraph","Properties":{"id":"20240611095353-2x8ikln","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611095353-g0feif9","Type":"NodeParagraph","Properties":{"id":"20240611095353-g0feif9","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 藕含儿茶酚（catechol），右旋没食子儿茶精（dgallocatechol），新氯原酸（necochlorogenic acid）以及过氧化物酶（peroxidase0）。此外，尚含天冬酰胺（asparagine），维生素C，淀粉及蛋白质。"}]},{"ID":"20240611095353-zseuj3q","Type":"NodeParagraph","Properties":{"id":"20240611095353-zseuj3q","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095353-wm9lg8b","Type":"NodeParagraph","Properties":{"id":"20240611095353-wm9lg8b","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 心；脾；胃；肝；肺经"}]},{"ID":"20240611095353-s10gb76","Type":"NodeParagraph","Properties":{"id":"20240611095353-s10gb76","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095353-1w0p0m4","Type":"NodeParagraph","Properties":{"id":"20240611095353-1w0p0m4","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 甘；寒"}]},{"ID":"20240611095353-lmpdqle","Type":"NodeParagraph","Properties":{"id":"20240611095353-lmpdqle","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611095353-oyr92f5","Type":"NodeParagraph","Properties":{"id":"20240611095353-oyr92f5","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 赞宁《物类相感志》：忌铁器。"}]},{"ID":"20240611095353-b5iec56","Type":"NodeParagraph","Properties":{"id":"20240611095353-b5iec56","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095353-f1j2847","Type":"NodeParagraph","Properties":{"id":"20240611095353-f1j2847","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 清热生津；凉血；散瘀；止血。主热病烦渴；吐衄；下血"}]},{"ID":"20240611095353-ah9zydf","Type":"NodeParagraph","Properties":{"id":"20240611095353-ah9zydf","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095353-l5mci42","Type":"NodeParagraph","Properties":{"id":"20240611095353-l5mci42","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 内服：生食、捣汁或煮食，适量。外用：适量，捣敷。"}]},{"ID":"20240611095353-r5u4nf6","Type":"NodeParagraph","Properties":{"id":"20240611095353-r5u4nf6","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611095353-gd9zne6","Type":"NodeParagraph","Properties":{"id":"20240611095353-gd9zne6","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" ①治时气烦渴不止：生藕，捣绞取计一中盏，入生蜜一合，搅令匀，不计时候，分为二服。(《圣惠方》)②治霍乱吐不止，兼渴：生藕一两(洗，切)，生姜一分(洗，切)。上二味，研绞取汁，分三服，不拘时。(《圣济总录》姜藕钦)③治上焦痰热：藕汁、梨汁各半盏，和服。(《简便单方》)④治红白痢：藕一厅，捣汗，和蜜糖，隔水婉成膏服。(《岭南采药录》)⑤治小便热琳：生藕汁、地黄汁、葡萄汁各等分。每服半盏，人蜜温服。(《纲目》)⑥治冻脚裂拆：蒸熟藕搞烂涂之。(《纲目》)⑦治麦芒及尘土并物入眼不出：大藕一截，洗净捣烂，以帛子裹于眼上，摄取汁，落眼中。(喀普济方》)⑧治眼热赤痛：取莲藕一个，连节，以绿豆入满其中空处，水数碗，煎至半碗，连藕食之。(名岭南采药录》)"}]},{"ID":"20240611095353-nmue3bs","Type":"NodeParagraph","Properties":{"id":"20240611095353-nmue3bs","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611095353-h7psts8","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611095353-h7psts8","updated":"20240611095353"},"Children":[{"ID":"20240611095353-qq39ezb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240611095353-qq39ezb","updated":"20240611095353"},"Children":[{"ID":"20240611095353-tde9sju","Type":"NodeParagraph","Properties":{"id":"20240611095353-tde9sju","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"孟说：产后忌食生冷物，惟藕不同生冷，为能被血故也。"}]}]}]},{"ID":"20240611095353-4b84g1a","Type":"NodeParagraph","Properties":{"id":"20240611095353-4b84g1a","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"2.《本草经疏》：藕，生者甘寒，能凉血止血，除热清胃，故主消散疵血，吐血、口鼻出血，产后血闷，署金疮伤折及止热渴，霍乱，烦闷，解酒等功。熟看甘温，能健脾开胃，益血补心，故主补五脏，实下焦，消食，止泄，生肌，及久服令人心欢止怒也。"}]},{"ID":"20240611095353-h299qx2","Type":"NodeParagraph","Properties":{"id":"20240611095353-h299qx2","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：藕；凉血散血，清热解暑之药也。其所主，留心脾血分之疾。如陈氏方，治热渴烦闷，大氏方，治产后疯血，孟氏治霍乱水泄，皆属热邪为患者，取此渭芳寒洁、甘淡之味以凉解之，如血热血滞之病，悉潜消而默化矣。第生食过多，不免有动冷气，不无腹痛肠滑之虞耳。如煮熟食，能养赃腑，和脾胃。"}]},{"ID":"20240611095353-lj2toun","Type":"NodeParagraph","Properties":{"id":"20240611095353-lj2toun","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"4.《重庆堂随笔》：藕以仁和产者为良。熬浓汁服，既能补血，亦能通气，故无腻滞之偏。"}]},{"ID":"20240611095353-9v99zqy","Type":"NodeParagraph","Properties":{"id":"20240611095353-9v99zqy","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"5.《随息居饮食谱》：藕以肥白纯甘者良。生食宜鲜嫩，煮食宜壮老，用砂锅桑柴缓火爆极烂，入炼白蜜收干食之，最补心脾。若阴虚、肝旺、内热、血少及诸失血证，但日熬浓藕汤饮之，久久自愈，不服他药可也。"}]},{"ID":"20240611095353-8ax3frx","Type":"NodeParagraph","Properties":{"id":"20240611095353-8ax3frx","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"6.《本草经集注》：藕汁，解射罔毒、蟹毒。"}]},{"ID":"20240611095353-lgrkdh3","Type":"NodeParagraph","Properties":{"id":"20240611095353-lgrkdh3","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"7.《别录》：主热渴，散血，生肌。"}]},{"ID":"20240611095353-sqp4h1l","Type":"NodeParagraph","Properties":{"id":"20240611095353-sqp4h1l","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"8.《药性论》：藕汁，能消痰血不散。"}]},{"ID":"20240611095353-za5qlhb","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240611095353-za5qlhb","updated":"20240611095353"},"Children":[{"ID":"20240611095353-cx1botn","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OS4=","Num":9},"Properties":{"id":"20240611095353-cx1botn","updated":"20240611095353"},"Children":[{"ID":"20240611095353-dg8a6ai","Type":"NodeParagraph","Properties":{"id":"20240611095353-dg8a6ai","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"崔禹锡《食经》：主烦热鼻血不止。"}]}]},{"ID":"20240611095353-22yng7q","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTAu","Num":10},"Properties":{"id":"20240611095353-22yng7q","updated":"20240611095353"},"Children":[{"ID":"20240611095353-vkug7t2","Type":"NodeParagraph","Properties":{"id":"20240611095353-vkug7t2","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"盂说：生食之，主霍乱后虚渴、烦闷、不能食；蒸食甚补五脏，实下焦。"}]}]}]},{"ID":"20240611095353-buf03tg","Type":"NodeParagraph","Properties":{"id":"20240611095353-buf03tg","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"11.《本草拾遗》：消食止泄，除烦，解酒毒，压食及病后热混。"}]},{"ID":"20240611095353-9tgoecv","Type":"NodeParagraph","Properties":{"id":"20240611095353-9tgoecv","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：破产后血闷，生斯服亦不妨；捣患金疮并伤折，止暴痛；蒸煮食，大开胃。"}]},{"ID":"20240611095353-zreivrt","Type":"NodeParagraph","Properties":{"id":"20240611095353-zreivrt","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"13.《日用本草》：清热除烦，凡呕血、吐血、出血、败血，一切血症宜食之。"}]},{"ID":"20240611095353-rub2eu0","Type":"NodeParagraph","Properties":{"id":"20240611095353-rub2eu0","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"14.《滇南本草》：多服润肠肺，生津液。"}]},{"ID":"20240611095353-6ghnrc1","Type":"NodeParagraph","Properties":{"id":"20240611095353-6ghnrc1","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095353-oe0oq1t","Type":"NodeParagraph","Properties":{"id":"20240611095353-oe0oq1t","updated":"20240611095353"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611095355-482nv37","Type":"NodeThematicBreak","Properties":{"id":"20240611095355-482nv37"}},{"ID":"20240611095418-43wukre","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095418-43wukre","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"《中国药典》：藕节"}]},{"ID":"20240611095418-hdp14kt","Type":"NodeParagraph","Properties":{"id":"20240611095418-hdp14kt","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095418-n1wca2g","Type":"NodeParagraph","Properties":{"id":"20240611095418-n1wca2g","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" ǒu Jié"}]},{"ID":"20240611095418-dmne1g7","Type":"NodeParagraph","Properties":{"id":"20240611095418-dmne1g7","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095418-qzjkpaa","Type":"NodeParagraph","Properties":{"id":"20240611095418-qzjkpaa","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 藕节巴"}]},{"ID":"20240611095418-5rnd44v","Type":"NodeParagraph","Properties":{"id":"20240611095418-5rnd44v","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611095418-bbiblkw","Type":"NodeParagraph","Properties":{"id":"20240611095418-bbiblkw","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" NODUS NELUMBINIS RHIZOMATIS"}]},{"ID":"20240611095418-w8h6sek","Type":"NodeParagraph","Properties":{"id":"20240611095418-w8h6sek","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095418-5ng0wmw","Type":"NodeParagraph","Properties":{"id":"20240611095418-5ng0wmw","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 本品为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"莲"},{"Type":"NodeText","Data":"Nelumbo nucifera Gaertn. 的干燥根茎节部。秋、冬二季采挖根茎（藕），切取节部，洗净，晒干，除去须根。"}]},{"ID":"20240611095418-8fxfo67","Type":"NodeParagraph","Properties":{"id":"20240611095418-8fxfo67","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095418-vcaebmm","Type":"NodeParagraph","Properties":{"id":"20240611095418-vcaebmm","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 本品呈短圆柱形，中部稍膨大，长2～4cm，直径约2cm。表面灰黄色至灰棕色，有残存的须根及须根痕，偶见暗红棕色的鳞叶残基。两端有残留的藕，表面皱缩有纵纹。质硬，断面有多数类圆形的孔。气微，味微甘、涩。"}]},{"ID":"20240611095418-4phppex","Type":"NodeParagraph","Properties":{"id":"20240611095418-4phppex","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611095418-gy4qehh","Type":"NodeParagraph","Properties":{"id":"20240611095418-gy4qehh","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藕节"},{"Type":"NodeText","Data":"：除去杂质，洗净，干燥。"}]},{"ID":"20240611095418-6pehct5","Type":"NodeParagraph","Properties":{"id":"20240611095418-6pehct5","updated":"20240611095418"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藕节炭"},{"Type":"NodeText","Data":"：取净藕节，照炒炭法（附录Ⅱ D）炒至表面焦黑色、内部黄褐色。"}]},{"ID":"20240611095418-ycrwyfo","Type":"NodeParagraph","Properties":{"id":"20240611095418-ycrwyfo","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095418-ti3zllb","Type":"NodeParagraph","Properties":{"id":"20240611095418-ti3zllb","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 归肝、肺、胃经。"}]},{"ID":"20240611095418-7l912hj","Type":"NodeParagraph","Properties":{"id":"20240611095418-7l912hj","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095418-p8yc7xo","Type":"NodeParagraph","Properties":{"id":"20240611095418-p8yc7xo","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 甘、涩，平。"}]},{"ID":"20240611095418-zyxwct1","Type":"NodeParagraph","Properties":{"id":"20240611095418-zyxwct1","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095418-bxnam7q","Type":"NodeParagraph","Properties":{"id":"20240611095418-bxnam7q","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 止血，消瘀。用于吐血，咯血，尿血，崩漏。"}]},{"ID":"20240611095418-s9am2kj","Type":"NodeParagraph","Properties":{"id":"20240611095418-s9am2kj","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095418-ypoeuoz","Type":"NodeParagraph","Properties":{"id":"20240611095418-ypoeuoz","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 9～15g。"}]},{"ID":"20240611095418-i75uu41","Type":"NodeParagraph","Properties":{"id":"20240611095418-i75uu41","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095418-22c7be0","Type":"NodeParagraph","Properties":{"id":"20240611095418-22c7be0","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611095418-65tzhz3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095418-65tzhz3","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：藕节"}]},{"ID":"20240611095418-rhbp6se","Type":"NodeParagraph","Properties":{"id":"20240611095418-rhbp6se","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095418-11l7wpa","Type":"NodeParagraph","Properties":{"id":"20240611095418-11l7wpa","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" ǒu Jié"}]},{"ID":"20240611095418-xtad6i4","Type":"NodeParagraph","Properties":{"id":"20240611095418-xtad6i4","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095418-1qxh9dz","Type":"NodeParagraph","Properties":{"id":"20240611095418-1qxh9dz","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 光藕节（《江苏植药志》），藕节疤（《中药志》）。"}]},{"ID":"20240611095418-0e0m6f0","Type":"NodeParagraph","Properties":{"id":"20240611095418-0e0m6f0","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611095418-khx6jcb","Type":"NodeParagraph","Properties":{"id":"20240611095418-khx6jcb","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 《药性论》"}]},{"ID":"20240611095418-pcepp49","Type":"NodeParagraph","Properties":{"id":"20240611095418-pcepp49","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095418-ip0hdu0","Type":"NodeParagraph","Properties":{"id":"20240611095418-ip0hdu0","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 为睡莲科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"莲"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎的节部"},{"Type":"NodeText","Data":"。秋、冬或春初挖取根茎（藕），洗净泥土，切下节部，除去须根，晒干。"}]},{"ID":"20240611095418-l6q445i","Type":"NodeParagraph","Properties":{"id":"20240611095418-l6q445i","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611095418-68dtcoq","Type":"NodeParagraph","Properties":{"id":"20240611095418-68dtcoq","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 主产浙江、江苏、安徽。此外，湖北、湖南、山东、河南、江西、福建、河北等地亦产。"}]},{"ID":"20240611095418-yhgpd3f","Type":"NodeParagraph","Properties":{"id":"20240611095418-yhgpd3f","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095418-jhh8mr4","Type":"NodeParagraph","Properties":{"id":"20240611095418-jhh8mr4","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 干燥的藕节，呈短圆柱形，长约2～4厘米，直径约2厘米。表面黄棕色至灰棕色，中央节部稍膨大，上有多数残留的须根及根痕，有时可见暗红棕色的鳞叶残基；节两端残留的节间部表面有纵纹，横切面中央可见较小的圆孔，其周围约有8个大孔。体轻，节部质坚硬，难折断。气无，蛛微甘涩。以节部黑褐色、两头白色、干燥、无须根泥土者为佳。"}]},{"ID":"20240611095418-najqofr","Type":"NodeParagraph","Properties":{"id":"20240611095418-najqofr","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611095418-q649wvd","Type":"NodeParagraph","Properties":{"id":"20240611095418-q649wvd","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 藕节含鞣质、天门冬素。"}]},{"ID":"20240611095418-t2up9ww","Type":"NodeParagraph","Properties":{"id":"20240611095418-t2up9ww","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611095418-5avvxpl","Type":"NodeParagraph","Properties":{"id":"20240611095418-5avvxpl","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 藕节炭：取净藕节置锅内炒至外面呈黑色，内部呈老黄色，稍洒清水，取出，干燥即成。"}]},{"ID":"20240611095418-6bd1vrn","Type":"NodeParagraph","Properties":{"id":"20240611095418-6bd1vrn","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095418-22d7ioj","Type":"NodeParagraph","Properties":{"id":"20240611095418-22d7ioj","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 《本草撮要》：\"入手少阴，足阳明、厥阴经。\""}]},{"ID":"20240611095418-wteo5ef","Type":"NodeParagraph","Properties":{"id":"20240611095418-wteo5ef","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095418-nd38il1","Type":"NodeParagraph","Properties":{"id":"20240611095418-nd38il1","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 甘涩，平。"}]},{"ID":"20240611095418-o67luxf","Type":"NodeParagraph","Properties":{"id":"20240611095418-o67luxf","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"①《日华子本草》：\"冷。\""}]},{"ID":"20240611095418-qhcx383","Type":"NodeParagraph","Properties":{"id":"20240611095418-qhcx383","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"涩，平，无毒。\""}]},{"ID":"20240611095418-g4y0cv7","Type":"NodeParagraph","Properties":{"id":"20240611095418-g4y0cv7","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"味苦涩，气平，无毒。\""}]},{"ID":"20240611095418-g4gbvpb","Type":"NodeParagraph","Properties":{"id":"20240611095418-g4gbvpb","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"④《纲目拾遗》：\"藕节粉：味甘微苦，性平。\""}]},{"ID":"20240611095418-9na4tmy","Type":"NodeParagraph","Properties":{"id":"20240611095418-9na4tmy","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095418-ff29qax","Type":"NodeParagraph","Properties":{"id":"20240611095418-ff29qax","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 止血，散瘀。治咳血，吐血，衄血，尿血，便血，血痢，血崩。"}]},{"ID":"20240611095418-xi23bb0","Type":"NodeParagraph","Properties":{"id":"20240611095418-xi23bb0","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"①《药性论》：\"捣汁，主吐血不止，口鼻并皆治之。\""}]},{"ID":"20240611095418-92s99jb","Type":"NodeParagraph","Properties":{"id":"20240611095418-92s99jb","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》）：\"解热毒，消瘀血、产后血闷。合地黄生研汁，（入）热酒并小便服。\""}]},{"ID":"20240611095418-ih9xj0b","Type":"NodeParagraph","Properties":{"id":"20240611095418-ih9xj0b","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"治妇人血崩，冷浊。\""}]},{"ID":"20240611095418-g9da4xu","Type":"NodeParagraph","Properties":{"id":"20240611095418-g9da4xu","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"能止咳血，唾血，血淋，溺血，下血，血痢，血崩。\""}]},{"ID":"20240611095418-rg1svv7","Type":"NodeParagraph","Properties":{"id":"20240611095418-rg1svv7","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"⑤《纲目拾遗》：\"藕节粉：开膈，补腰肾，和血脉，散瘀血，生新血；产后及吐血者食之尤佳。\""}]},{"ID":"20240611095418-yauiqlf","Type":"NodeParagraph","Properties":{"id":"20240611095418-yauiqlf","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》：\"凉血养血，利水通经。\""}]},{"ID":"20240611095418-eh7h7nh","Type":"NodeParagraph","Properties":{"id":"20240611095418-eh7h7nh","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095418-d9ut8ey","Type":"NodeParagraph","Properties":{"id":"20240611095418-d9ut8ey","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱：捣汁或入散剂。"}]},{"ID":"20240611095418-4k7znkc","Type":"NodeParagraph","Properties":{"id":"20240611095418-4k7znkc","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611095418-f0zrbmg","Type":"NodeParagraph","Properties":{"id":"20240611095418-f0zrbmg","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" ①治卒暴吐血：藕节七个，荷叶顶七个。上同蜜擂细，水二钟，煎八分，去滓温服。或研末，蜜调下。（《圣惠方》双荷散）"}]},{"ID":"20240611095418-eaaaho6","Type":"NodeParagraph","Properties":{"id":"20240611095418-eaaaho6","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"②治坠马血瘀，积在胸腹，唾血无数者：用生藕节捣烂，和酒绞汁饮，随量用。（《本草汇言》）"}]},{"ID":"20240611095418-aroisrt","Type":"NodeParagraph","Properties":{"id":"20240611095418-aroisrt","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"③治鼻衄不止：藕节捣汁饮，并滴鼻中。（《纲目》）"}]},{"ID":"20240611095418-prj4cqr","Type":"NodeParagraph","Properties":{"id":"20240611095418-prj4cqr","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"④治大便下血：藕节晒干研末，人参、白蜜煎汤调服二钱，日二服。（《全幼心鉴》）"}]},{"ID":"20240611095418-f7dhh1s","Type":"NodeParagraph","Properties":{"id":"20240611095418-f7dhh1s","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611095418-9kyn5tb","Type":"NodeParagraph","Properties":{"id":"20240611095418-9kyn5tb","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" ①《本草汇言》：\"藕节，消瘀血，止血妄行之药也。邢元璧曰，《日华子》治产后血闷腹胀，捣汁，和热童便饮，有效，盖止中有行散之意。又时珍方治咳血、唾血、呕血、吐血及便血、溺血、血淋、血崩等证，入四生次、调营汤中，亦行止互通之妙用也。\""}]},{"ID":"20240611095418-eodh5by","Type":"NodeParagraph","Properties":{"id":"20240611095418-eodh5by","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"②《医林纂要》：\"藕节，止吐、衄，淋、痢诸血证。甘能补中，咸能软坚去瘀，涩能敛散固精。又取其通而有节也。\""}]},{"ID":"20240611095418-jywd08q","Type":"NodeParagraph","Properties":{"id":"20240611095418-jywd08q","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095418-95lsfjl","Type":"NodeParagraph","Properties":{"id":"20240611095418-95lsfjl","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611095418-dmn0gny","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611095418-dmn0gny","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"《中华本草》：藕节"}]},{"ID":"20240611095418-k0reqqt","Type":"NodeParagraph","Properties":{"id":"20240611095418-k0reqqt","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611095418-y4m8z66","Type":"NodeParagraph","Properties":{"id":"20240611095418-y4m8z66","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" ǒu Jié"}]},{"ID":"20240611095418-l4v5155","Type":"NodeParagraph","Properties":{"id":"20240611095418-l4v5155","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611095418-vu903ec","Type":"NodeParagraph","Properties":{"id":"20240611095418-vu903ec","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 光藕节、藕节巴。"}]},{"ID":"20240611095418-2iecp70","Type":"NodeParagraph","Properties":{"id":"20240611095418-2iecp70","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611095418-s89olcr","Type":"NodeParagraph","Properties":{"id":"20240611095418-s89olcr","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" Lotus Rhizome Node"}]},{"ID":"20240611095418-mqhfo1k","Type":"NodeParagraph","Properties":{"id":"20240611095418-mqhfo1k","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611095418-catgje7","Type":"NodeParagraph","Properties":{"id":"20240611095418-catgje7","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 出自《药性论》"}]},{"ID":"20240611095418-vf2g0jq","Type":"NodeParagraph","Properties":{"id":"20240611095418-vf2g0jq","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611095418-kwbuvl9","Type":"NodeParagraph","Properties":{"id":"20240611095418-kwbuvl9","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 药材基源：为睡莲科植物莲Nelumbo nucifera Gaertn根茎的节部。"}]},{"ID":"20240611095418-rdolwh5","Type":"NodeParagraph","Properties":{"id":"20240611095418-rdolwh5","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Nelumbo nucifera Gaertn."}]},{"ID":"20240611095418-eo57rzq","Type":"NodeParagraph","Properties":{"id":"20240611095418-eo57rzq","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋、冬或春初挖取根茎(藕)，洗净泥土，切下节部，除去须根，晒干。"}]},{"ID":"20240611095418-al7hkw9","Type":"NodeParagraph","Properties":{"id":"20240611095418-al7hkw9","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611095418-qyai9sv","Type":"NodeParagraph","Properties":{"id":"20240611095418-qyai9sv","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于水泽、池塘、湖沼或水田内，野生或栽培。"}]},{"ID":"20240611095418-kibgpc9","Type":"NodeParagraph","Properties":{"id":"20240611095418-kibgpc9","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"资源分布：广布于南北各地。"}]},{"ID":"20240611095418-ibhc2c7","Type":"NodeParagraph","Properties":{"id":"20240611095418-ibhc2c7","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611095418-s1nzcqg","Type":"NodeParagraph","Properties":{"id":"20240611095418-s1nzcqg","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 莲 多年生水生草本。根茎横生，肥厚，节间膨大，内有多数纵行通气孔洞，外生须状不定根。节上生叶，露出水面；叶柄着生于叶背中央，粗壮，圆柱形，多刺；叶片圆形，直径25-90cm，全缘或稍呈波状，上面粉绿色，下面叶脉从中央射出，有1-2次叉状分枝。花单生于花梗顶端，花梗与叶柄等长或稍长，也散生小刺；花直径10-20cm，芳香，红色、粉红色或白色；花瓣椭圆形或倒卵形，长5-10cm，宽3-5cm；雄蕊多数，花药条形，花丝细长，着生于托之一；心皮多数埋藏于膨大的花托内，子房椭圆形，花柱极短。花后结“莲蓬”，倒锥形，直径5-10cm，有小孔20-30个，每孔内含果实1枚；坚果椭圆形或卵形，长1.5-2.5cm，果皮革质，坚硬，熟时黑褐色。种子卵形，或椭圆形，长1.2-1.7cm，种皮红色或白色。花期6-8月，果期8-10月。"}]},{"ID":"20240611095418-25qtzwu","Type":"NodeParagraph","Properties":{"id":"20240611095418-25qtzwu","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611095418-pekeczq","Type":"NodeParagraph","Properties":{"id":"20240611095418-pekeczq","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 性状鉴定 本品呈圆柱形，长2-4cm，直径约2cm。表面灰黄色或灰棕色，节膨大，有多数残留须根或圆形须根痕，节两端残留部分的表面有纵纹。体轻而质硬，不易折断，横断而中央有较大的圆孔7-9个，大小不等。气无，味甘、涩。"}]},{"ID":"20240611095418-hijixd9","Type":"NodeParagraph","Properties":{"id":"20240611095418-hijixd9","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611095418-rmtposq","Type":"NodeParagraph","Properties":{"id":"20240611095418-rmtposq","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 藕节含天酰胺（asparagine）及鞣质。"}]},{"ID":"20240611095418-jd8p9es","Type":"NodeParagraph","Properties":{"id":"20240611095418-jd8p9es","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611095418-bk47k2t","Type":"NodeParagraph","Properties":{"id":"20240611095418-bk47k2t","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 止血：藕节热水提取物1g/kg腹腔注射，可以缩短小鼠切尾出血的时间。"}]},{"ID":"20240611095418-pa506j9","Type":"NodeParagraph","Properties":{"id":"20240611095418-pa506j9","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611095418-ytzcmqk","Type":"NodeParagraph","Properties":{"id":"20240611095418-ytzcmqk","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 藕节炭：取净藕节置锅内炒至外面呈黑色，内部呈老黄色，稍洒清水，取出，干燥即成。"}]},{"ID":"20240611095418-k1hbck0","Type":"NodeParagraph","Properties":{"id":"20240611095418-k1hbck0","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611095418-122t4pz","Type":"NodeParagraph","Properties":{"id":"20240611095418-122t4pz","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 肾；胃；肝经"}]},{"ID":"20240611095418-utc5kot","Type":"NodeParagraph","Properties":{"id":"20240611095418-utc5kot","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611095418-r02kbr1","Type":"NodeParagraph","Properties":{"id":"20240611095418-r02kbr1","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 甘；涩；平"}]},{"ID":"20240611095418-pw3zyjb","Type":"NodeParagraph","Properties":{"id":"20240611095418-pw3zyjb","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611095418-jxsatt9","Type":"NodeParagraph","Properties":{"id":"20240611095418-jxsatt9","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 忌铁器"}]},{"ID":"20240611095418-8tsn6ai","Type":"NodeParagraph","Properties":{"id":"20240611095418-8tsn6ai","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611095418-ygufdni","Type":"NodeParagraph","Properties":{"id":"20240611095418-ygufdni","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 散瘀止血。主吐血；咯血；尿血；便血；血痢；血崩"}]},{"ID":"20240611095418-ezmo7wr","Type":"NodeParagraph","Properties":{"id":"20240611095418-ezmo7wr","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611095418-dnvrzzz","Type":"NodeParagraph","Properties":{"id":"20240611095418-dnvrzzz","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-30g；鲜用捣汁，可用60g左右取汁冲服；或入散剂。"}]},{"ID":"20240611095418-2rghct1","Type":"NodeParagraph","Properties":{"id":"20240611095418-2rghct1","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611095418-wzorx6q","Type":"NodeParagraph","Properties":{"id":"20240611095418-wzorx6q","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" ①治卒暴吐血：藕节七个，荷叶顶七个。上同蜜擂细，水二钟，煎八分，去滓温服。或研末，蜜调下。(《圣惠方》双荷散)②治坠马血疯，积在胸腹，唾血无数者：用生藕节捣烂，调酒绞汁钦，随量用。(名本草汇言》)③治鼻舰不止： 藕节捣汁饮，并滴鼻中。(《纲目》)④治大便下血： 藕节晒干研末，人参、 自蜜煎汤调服二露，日二服。(喀全幼心鉴》)"}]},{"ID":"20240611095418-pyt35nh","Type":"NodeParagraph","Properties":{"id":"20240611095418-pyt35nh","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611095418-877f6cc","Type":"NodeParagraph","Properties":{"id":"20240611095418-877f6cc","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 1.《本草汇言》：藕节，消瘦血，止血妄行之药也。邢元壁曰，《日华子》治产后血闷腹胀，捣汁，和热童便饮，有效，盖止中有行散之意。又时珍方治咳血、唾血、区血、吐血及便血、溺血、血淋、血崩等证，入四生钦、调营汤户，亦行止互通之妙用也。"}]},{"ID":"20240611095418-g0b9iy1","Type":"NodeParagraph","Properties":{"id":"20240611095418-g0b9iy1","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"2.《医林纂要》：藕节，止吐、舰、淋、痢诸血证。甘能补氏咸能软坚去疯，涩能敛散固精，又取其通而有节也。"}]},{"ID":"20240611095418-g24tqjh","Type":"NodeParagraph","Properties":{"id":"20240611095418-g24tqjh","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：捣汁，主吐血不止，口鼻并皆治之。"}]},{"ID":"20240611095418-4t2bb3s","Type":"NodeParagraph","Properties":{"id":"20240611095418-4t2bb3s","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：解热毒，消瘀血、产后血闷。合地黄主研汁，(入)热酒并小便服。"}]},{"ID":"20240611095418-w95j85j","Type":"NodeParagraph","Properties":{"id":"20240611095418-w95j85j","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：治妇人血崩，冷浊。"}]},{"ID":"20240611095418-egg76vk","Type":"NodeParagraph","Properties":{"id":"20240611095418-egg76vk","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：能止咳血，唾血，血淋，溺血，下血，血痢，血崩。"}]},{"ID":"20240611095418-trmdwk8","Type":"NodeParagraph","Properties":{"id":"20240611095418-trmdwk8","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"7.《纲目拾遗》：藕节粉：开隔，补腰肾，和血脉，散疯级，生新血；产后及吐血者食之尤佳。"}]},{"ID":"20240611095418-qexid85","Type":"NodeParagraph","Properties":{"id":"20240611095418-qexid85","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"8.《本草再新》：凉血养血，利水通经。"}]},{"ID":"20240611095418-2nqmqof","Type":"NodeParagraph","Properties":{"id":"20240611095418-2nqmqof","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611095418-ycsj1zs","Type":"NodeParagraph","Properties":{"id":"20240611095418-ycsj1zs","updated":"20240611095418"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611095420-4hyhu5e","Type":"NodeThematicBreak","Properties":{"id":"20240611095420-4hyhu5e"}},{"ID":"20240611095421-bm9zzzf","Type":"NodeParagraph","Properties":{"id":"20240611095421-bm9zzzf"}}]}