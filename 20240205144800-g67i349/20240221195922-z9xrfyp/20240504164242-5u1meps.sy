{"ID":"20240504164242-5u1meps","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504164242-5u1meps","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504164242-5u1meps\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240621115931-7zhd2qs\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611095353-2x8ikln\u0026quot;,\u0026quot;scrollTop\u0026quot;:1700,\u0026quot;focusId\u0026quot;:\u0026quot;20240621124353-317gyhw\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"131藕实茎（藕节、莲藕）","type":"doc","updated":"20240811170611"},"Children":[{"ID":"20240621115931-7zhd2qs","Type":"NodeParagraph","Properties":{"id":"20240621115931-7zhd2qs","updated":"20240811170559"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621115931-2wrybw2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724160929-zvstng8","Type":"NodeParagraph","Properties":{"id":"20240724160929-zvstng8","updated":"20240811170602"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 679px;","style":"width: 669px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621124146-oi1ku82.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 669px;\" parent-style=\"width: 679px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724160926-74l418g","Type":"NodeParagraph","Properties":{"id":"20240724160926-74l418g","updated":"20240724160926"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240724160926-oubnbhh.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240621115618-8rc6me3","Type":"NodeParagraph","Properties":{"id":"20240621115618-8rc6me3","updated":"20240621124313"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621115618-6nq1xik.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 443px;","style":"width: 433px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621115625-x18qwzp.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 433px;\" parent-style=\"width: 443px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 346px;","style":"width: 336px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240621124313-1g6qc7s.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 336px;\" parent-style=\"width: 346px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724155143-xa176ub","Type":"NodeParagraph","Properties":{"id":"20240724155143-xa176ub","updated":"20240724160248"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 375px;","style":"wi