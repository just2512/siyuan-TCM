{"ID":"20240504170621-38fj7z1","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504170621-38fj7z1","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504170621-38fj7z1\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240625154156-t66pizd\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611173748-gdq8n7a\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240625154735-owc79bp\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"198积雪草（雷公根）","type":"doc","updated":"20240820161818"},"Children":[{"ID":"20240625154156-t66pizd","Type":"NodeParagraph","Properties":{"id":"20240625154156-t66pizd","updated":"20240820161140"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 523px;","style":"width: 513px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240625154156-ieqxjuf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 513px;\" parent-style=\"width: 523px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820161324-sxl8j91","Type":"NodeParagraph","Properties":{"id":"20240820161324-sxl8j91","updated":"20240820161402"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 406px;","style":"width: 396px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"积雪草 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/积雪草 9-20240820161324-4fuzsac.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 396px;\" parent-style=\"width: 406px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properti