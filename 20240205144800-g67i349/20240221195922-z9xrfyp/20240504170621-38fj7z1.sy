s":{"id":"20240727170938-3zoce9x","updated":"20240727170938"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"易混淆品种（连钱草、铜钱草、金钱草、破铜钱、积雪草）"}]},{"ID":"20240727170938-ndqzc35","Type":"NodeParagraph","Properties":{"id":"20240727170938-ndqzc35","updated":"20240820161818"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240727153805-5gddcod.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240727171031-mys64dl","Type":"NodeParagraph","Properties":{"id":"20240727171031-mys64dl","updated":"20240727171249"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240727165400-e6mtczx","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"连钱草（活血丹、透骨消、金钱艾、十八缺）"}]},{"ID":"20240727171031-vi16803","Type":"NodeParagraph","Properties":{"id":"20240727171031-vi16803","updated":"20240727171254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240727163626-r6qt16y","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"铜钱草（香菇草、水金钱）"}]},{"ID":"20240727171031-jao4kjr","Type":"NodeParagraph","Properties":{"id":"20240727171031-jao4kjr","updated":"20240727171259"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240205153748-igsdarp","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"金钱草"}]},{"ID":"20240727171031-dx02gb6","Type":"NodeParagraph","Properties":{"id":"20240727171031-dx02gb6","updated":"20240727171304"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"点我跳转→"},{"Type":"NodeTextMark","TextMarkType":"strong block-ref","TextMarkBlockRefID":"20240727164422-zgnnfe2","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"破铜钱（天胡荽）"}]},{"ID":"20240611173900-0bjs8nj","Type":"NodeThematicBreak","Properties":{"id":"20240611173900-0bjs8nj"}},{"ID":"20240611173911-d18rkl0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173911-d18rkl0","updated":"20240611173917"},"Children":[{"Type":"NodeText","Data":"积雪草《神农本草经》"}]},{"ID":"20240611173911-68mf5lr","Type":"NodeParagraph","Properties":{"id":"20240611173911-68mf5lr","updated":"20240611173911"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240611173911-javl7vy","Type":"NodeParagraph","Properties":{"id":"20240611173911-javl7vy","updated":"20240611173911"},"Children":[{"Type":"NodeText","Data":"主大热，恶创痈疽，浸淫，赤熛，皮肤赤，身热。生川谷。"}]},{"ID":"20240611173911-fwtgddx","Type":"NodeParagraph","Properties":{"id":"20240611173911-fwtgddx","updated":"20240611173911"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生荆州。"}]},{"ID":"20240611173911-69wdov0","Type":"NodeParagraph","Properties":{"id":"20240611173911-69wdov0","updated":"20240611173911"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：荆楚人以叶如钱，谓为地钱草，徐仪药图名连钱草。本草图经云：咸洛二京亦有，或名胡薄荷。"}]},{"ID":"20240611173938-m0wf8mq","Type":"NodeThematicBreak","Properties":{"id":"20240611173938-m0wf8mq"}},{"ID":"20240611173939-3509gm1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173939-3509gm1","updated":"20240611173944"},"Children":[{"Type":"NodeText","Data":"积雪草《名医别录》"}]},{"ID":"20240611173939-u501fqi","Type":"NodeParagraph","Properties":{"id":"20240611173939-u501fqi","updated":"20240611173939"},"Children":[{"Type":"NodeText","Data":"无毒．生荆州．"}]},{"ID":"20240611173939-4i9ct2u","Type":"NodeParagraph","Properties":{"id":"20240611173939-4i9ct2u","updated":"20240611173939"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶积雪草，味苦，寒．主大热，恶疮痈疽，浸淫赤 皮肤赤，身热．生川谷．"}]},{"ID":"20240611174045-dqs6ulv","Type":"NodeThematicBreak","Properties":{"id":"20240611174045-dqs6ulv"}},{"ID":"20240611174046-l4cp0db","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611174046-l4cp0db","updated":"20240611174050"},"Children":[{"Type":"NodeText","Data":"积雪草《本草衍义》"}]},{"ID":"20240611174046-za0jnhq","Type":"NodeParagraph","Properties":{"id":"20240611174046-za0jnhq","updated":"20240611174046"},"Children":[{"Type":"NodeText","Data":"今南方多有，生阴湿地，不必荆楚。形如水荇而小，面亦光洁，微尖为异。今人谓之连钱草，盖取象也。其叶各生。捣烂，贴一切热毒痈疽等。秋后收之，荫干为末，水调。"}]},{"ID":"20240611174036-9ly4gud","Type":"NodeThematicBreak","Properties":{"id":"20240611174036-9ly4gud"}},{"ID":"20240611174037-3agf622","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611174037-3agf622","updated":"20240611174041"},"Children":[{"Type":"NodeText","Data":"积雪草《本草经集注》"}]},{"ID":"20240611174037-5mfz8mo","Type":"NodeParagraph","Properties":{"id":"20240611174037-5mfz8mo","updated":"20240611174037"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主治大热，恶疮，痈疽，浸淫赤 ，皮肤赤，身热。生荆州川谷。"}]},{"ID":"20240611174037-bh5u51b","Type":"NodeParagraph","Properties":{"id":"20240611174037-bh5u51b","updated":"20240611174037"},"Children":[{"Type":"NodeText","Data":"方药亦不用，想此草当寒冷尔。"}]},{"ID":"20240611174025-r3wgp1z","Type":"NodeThematicBreak","Properties":{"id":"20240611174025-r3wgp1z"}},{"ID":"20240611174026-29kmi8z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611174026-29kmi8z","updated":"20240611174030"},"Children":[{"Type":"NodeText","Data":"积雪草《千金翼方》"}]},{"ID":"20240611174026-9rdmrqk","Type":"NodeParagraph","Properties":{"id":"20240611174026-9rdmrqk","updated":"20240611174026"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主大热恶疮，痈疽浸淫，赤 皮肤赤，身热。生荆州川谷。"}]},{"ID":"20240611173926-ekl7xlj","Type":"NodeThematicBreak","Properties":{"id":"20240611173926-ekl7xlj"}},{"ID":"20240611173927-h0am2yl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173927-h0am2yl","updated":"20240611173931"},"Children":[{"Type":"NodeText","Data":"积雪草《本草图经》"}]},{"ID":"20240611173927-oxs7tro","Type":"NodeParagraph","Properties":{"id":"20240611173927-oxs7tro","updated":"20240611173932"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"积雪草"},{"Type":"NodeText","Data":"，生荆州川谷，今处处有之。叶圆如钱大，茎细而劲蔓延，生溪涧之侧，荆楚人以叶如钱，谓为地钱草。徐仪《药图》名连钱草。八月、九月采苗叶，阴干用。段成式《酉阳杂俎》云∶地钱，叶圆茎细，有蔓，一曰积雪草，一曰连钱草。谨按《天宝单行方》云∶连钱草，味甘、平，无毒。元生咸阳下湿地，亦生临淄郡、济阳郡池泽中，甚香。俗间或云圆叶似薄荷，江东、吴越丹阳郡极多，彼人常充生菜食之。河北柳城郡尽呼为海苏，好近水生，经冬不死，咸、洛二京亦有。或名胡薄荷，所在有之。单服疗女子小腹痛。又云∶女子忽得小腹中痛，月经初来，便觉腰中切痛连脊间，如刀锥所刺，忍不可堪者。众医不别，谓是鬼疰，妄服诸药，终无所益，其疾转增。审察前状相当，即用此药。其药夏五月正放花时，即采取，曝干，捣筛为散。女子有患前件病者，取二方寸匕，和好醋二小合，搅令匀，平旦空腹顿服之。每日一服，以知为度。如女子先冷者，即取前件药五两，加桃仁二百枚，去尖皮，熬捣为散，以蜜为丸如梧子大。每日空腹以饮及酒下三十丸，日再服。以疾愈为度。忌麻子、荞麦。"}]},{"ID":"20240611173901-aqzlb06","Type":"NodeThematicBreak","Properties":{"id":"20240611173901-aqzlb06"}},{"ID":"20240611173902-q8f5lmx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173902-q8f5lmx","updated":"20240611173907"},"Children":[{"Type":"NodeText","Data":"积雪草《新修本草》"}]},{"ID":"20240611173902-6w8lav0","Type":"NodeParagraph","Properties":{"id":"20240611173902-6w8lav0","updated":"20240611173902"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主大热，恶疮，痈疽，浸淫赤 ，皮肤赤，身热。生荆州川谷。"}]},{"ID":"20240611173902-04ra87q","Type":"NodeParagraph","Properties":{"id":"20240611173902-04ra87q","updated":"20240611173902"},"Children":[{"Type":"NodeText","Data":"方药亦不用，想此草当寒冷尔。"}]},{"ID":"20240611173902-ngdp4qh","Type":"NodeParagraph","Properties":{"id":"20240611173902-ngdp4qh","updated":"20240611173902"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草，叶圆如钱大，茎细劲，蔓延生溪涧侧。捣敷热肿丹毒，不入药用。荆楚人以叶如钱，谓为地钱草，《徐仪药图》名连钱草，生处亦稀。"}]},{"ID":"20240611173744-4sc6zh2","Type":"NodeThematicBreak","Properties":{"id":"20240611173744-4sc6zh2"}},{"ID":"20240611173847-c738syx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173847-c738syx","updated":"20240611173852"},"Children":[{"Type":"NodeText","Data":"积雪草《神农本草经赞》"}]},{"ID":"20240611173847-7wwhrzn","Type":"NodeParagraph","Properties":{"id":"20240611173847-7wwhrzn","updated":"20240611173847"},"Children":[{"Type":"NodeText","Data":"味苦寒。主大热恶创痈疽。浸淫赤。皮肤赤身热。生川谷。"}]},{"ID":"20240611173847-daj3u64","Type":"NodeParagraph","Properties":{"id":"20240611173847-daj3u64","updated":"20240611173847"},"Children":[{"Type":"NodeText","Data":"叶叶特生。沿溪萦碧。海挹苏融。雪霏寒积。重叠钱圆。参差荇坼。茶饮辛香。风生两腋。"}]},{"ID":"20240611173847-ceprcbd","Type":"NodeParagraph","Properties":{"id":"20240611173847-ceprcbd","updated":"20240611173847"},"Children":[{"Type":"NodeText","Data":"苏恭曰。此草蔓生溪涧侧。倪瓒诗。冷文萦碧暮烟和。苏颂曰。一名海苏。陶弘景曰。"}]},{"ID":"20240611173847-pwee27p","Type":"NodeParagraph","Properties":{"id":"20240611173847-pwee27p","updated":"20240611173847"},"Children":[{"Type":"NodeText","Data":"积雪草。以寒凉得名。寇宗曰。形如水荇。叶叶各生。今人谓之连钱草。蔡邕表。前后重叠。"}]},{"ID":"20240611173847-ykol9yi","Type":"NodeParagraph","Properties":{"id":"20240611173847-ykol9yi","updated":"20240611173847"},"Children":[{"Type":"NodeText","Data":"诗。参差荇菜。苏颂曰。江浙人多以作茶饮。庚辛玉册。引蔓抟地。香如细辛。卢仝诗。惟觉两腋习习清风生。"}]},{"ID":"20240611173744-1lyc8dd","Type":"NodeThematicBreak","Properties":{"id":"20240611173744-1lyc8dd"}},{"ID":"20240611173833-xqwjorw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173833-xqwjorw","updated":"20240611173838"},"Children":[{"Type":"NodeText","Data":"积雪草《医学入门》"}]},{"ID":"20240611173833-kpwt4o8","Type":"NodeParagraph","Properties":{"id":"20240611173833-kpwt4o8","updated":"20240611173833"},"Children":[{"Type":"NodeText","Data":"处处有之。蔓生溪涧侧，叶圆如钱，又谓之地钱草。味苦，寒，无毒。主一切热毒，痈疽肿毒，恶疮鼠 ，风疹疥癣，浸淫赤 ，皮肤暴热，小儿丹毒寒热，腹内热结，内服外敷。八九月采苗叶，阴干。"}]},{"ID":"20240611173744-ilpmhbm","Type":"NodeThematicBreak","Properties":{"id":"20240611173744-ilpmhbm"}},{"ID":"20240611173759-uffazq3","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240611173759-uffazq3","updated":"20240611173825"},"Children":[{"Type":"NodeText","Data":"积雪草《证类本草》"}]},{"ID":"20240611173759-tw04nez","Type":"NodeParagraph","Properties":{"id":"20240611173759-tw04nez","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主大热，恶疮痈疽，浸淫赤 ，皮肤赤，身热。生荆州川谷。"}]},{"ID":"20240611173759-jh3ygy0","Type":"NodeParagraph","Properties":{"id":"20240611173759-jh3ygy0","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方药亦不用，想此草当寒冷尔。唐本注云∶此草叶圆如钱大，茎细劲，蔓延生溪涧侧。捣敷热肿丹毒，不入药用。荆楚人以叶如钱，谓为地钱草，《徐仪药图》名连钱草，生处亦稀。今按陈藏器本草云∶积雪草，主暴热，小儿丹毒，寒热，腹内热结，捣绞汁服之。又按别本注云∶今处处有，并入药用。生阴湿地，八月、九月采苗、叶，阴干。臣禹锡等谨按药性论云∶连钱草亦可单用。能治瘰 鼠漏，寒热时节来往。日华子云∶味苦、辛。"}]},{"ID":"20240611173759-1drfhiu","Type":"NodeParagraph","Properties":{"id":"20240611173759-1drfhiu","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"以盐挪贴，消肿毒并风疹疥癣。"}]},{"ID":"20240611173759-p7ncldd","Type":"NodeParagraph","Properties":{"id":"20240611173759-p7ncldd","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"图经曰∶积雪草，生荆州川谷，今处处有之。叶圆如钱大，茎细而劲，蔓延生溪涧之侧，荆楚人以叶如钱，谓为地钱草，《徐仪药图》名连钱草。八月、九月采苗叶，阴干用。段成式《酉阳杂俎》云∶地钱叶圆，茎细有蔓。一曰积雪草，一曰连钱草。谨按《天宝单行方》云淄郡、济阳郡池泽中，甚香。"}]},{"ID":"20240611173759-yb6cevz","Type":"NodeParagraph","Properties":{"id":"20240611173759-yb6cevz","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"俗间或云圆叶似薄荷，江东吴越丹阳郡极多，彼人常充生菜食之。河北柳城郡尽呼为海苏，好近水生，经冬不死，咸、洛二京亦有。或名胡薄荷，所在有之。单服疗女子小腹痛。又云∶女子忽得小腹中痛，月经初来，便觉腰中切痛连脊间，如刀锥所刺，忍不可堪者。众医不别，谓是鬼疰，妄服诸药，终无所益，其疾转增。审察前状相当，即用此药。其药，夏五月正放花时，即采取曝干，捣筛为散。女子有患前件病者，取二方寸匕，和好醋二小合，搅令匀，平旦空腹顿服之。"}]},{"ID":"20240611173759-4hqclv3","Type":"NodeParagraph","Properties":{"id":"20240611173759-4hqclv3","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"每日一服，以知为度。如女子先冷者，即取前件药五两，加桃仁二百枚，去尖、皮，熬捣为散，及蜜为丸如梧子大。每日空腹饮及酒下三十丸，日再服，以疾愈为度。忌麻子陈藏器云∶东人呼为连钱，生阴处，蔓延地，叶如钱。"}]},{"ID":"20240611173759-sr2eot2","Type":"NodeParagraph","Properties":{"id":"20240611173759-sr2eot2","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"衍义曰∶积雪草，今南方多有，生阴湿地，不必荆楚。形如水荇而小，面亦光洁，微尖为异。"}]},{"ID":"20240611173759-bezbzst","Type":"NodeParagraph","Properties":{"id":"20240611173759-bezbzst","updated":"20240611173759"},"Children":[{"Type":"NodeText","Data":"今人谓之连钱草，盖取象也。叶叶各生，捣烂，贴一切热毒痈疽等。秋后收之，荫干为末，水调敷。"}]},{"ID":"20240611173744-e7himzr","Type":"NodeThematicBreak","Properties":{"id":"20240611173744-e7himzr"}},{"ID":"20240611173745-rcrairn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173745-rcrairn","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"《中国药典》：积雪草"}]},{"ID":"20240611173745-7q5npel","Type":"NodeParagraph","Properties":{"id":"20240611173745-7q5npel","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173745-xxix72i","Type":"NodeParagraph","Properties":{"id":"20240611173745-xxix72i","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" Jī Xuě Cǎo"}]},{"ID":"20240611173745-88vu2c3","Type":"NodeParagraph","Properties":{"id":"20240611173745-88vu2c3","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173745-hvqhu3y","Type":"NodeParagraph","Properties":{"id":"20240611173745-hvqhu3y","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 崩大碗、马蹄草、雷公根、蚶壳草、铜钱草、落得打"}]},{"ID":"20240611173745-hr2bs7i","Type":"NodeParagraph","Properties":{"id":"20240611173745-hr2bs7i","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611173745-nqbjugk","Type":"NodeParagraph","Properties":{"id":"20240611173745-nqbjugk","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" HERBA CENTELLAE"}]},{"ID":"20240611173745-ai9h2y5","Type":"NodeParagraph","Properties":{"id":"20240611173745-ai9h2y5","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173745-322dmr4","Type":"NodeParagraph","Properties":{"id":"20240611173745-322dmr4","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 本品为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"积雪草"},{"Type":"NodeText","Data":"Centella asiatica （L.）Urb. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。夏、秋二季采收，除去泥沙，晒干。"}]},{"ID":"20240611173745-y345gkd","Type":"NodeParagraph","Properties":{"id":"20240611173745-y345gkd","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611173745-uvf4cbf","Type":"NodeParagraph","Properties":{"id":"20240611173745-uvf4cbf","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 本品常卷缩成团状。根圆柱形，长2～4cm，直径1～1.5mm，表面浅黄色或灰黄色。茎细长弯曲，黄棕色，有细纵皱纹，节上常着生须状根。叶片多皱缩、破碎，完整者展平后呈近圆形或肾形，直径1～4cm，灰绿色，边缘有粗钝齿；叶柄长3～6cm，扭曲。伞形花序腋生，短小。双悬果扁圆形，有明显隆起的纵棱及细网纹，果梗甚短。气微，味淡。"}]},{"ID":"20240611173745-oyupj5h","Type":"NodeParagraph","Properties":{"id":"20240611173745-oyupj5h","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611173745-cfqvnil","Type":"NodeParagraph","Properties":{"id":"20240611173745-cfqvnil","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240611173745-ebtzv5i","Type":"NodeParagraph","Properties":{"id":"20240611173745-ebtzv5i","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611173745-86ko1mb","Type":"NodeParagraph","Properties":{"id":"20240611173745-86ko1mb","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，切段，晒干。"}]},{"ID":"20240611173745-fed1k5o","Type":"NodeParagraph","Properties":{"id":"20240611173745-fed1k5o","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611173745-mludqib","Type":"NodeParagraph","Properties":{"id":"20240611173745-mludqib","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 归肝、脾、肾经。"}]},{"ID":"20240611173745-n9pwghs","Type":"NodeParagraph","Properties":{"id":"20240611173745-n9pwghs","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173745-6csw97n","Type":"NodeParagraph","Properties":{"id":"20240611173745-6csw97n","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 苦、辛，寒。"}]},{"ID":"20240611173745-xzk7tzr","Type":"NodeParagraph","Properties":{"id":"20240611173745-xzk7tzr","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173745-b95m8d2","Type":"NodeParagraph","Properties":{"id":"20240611173745-b95m8d2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 清热利湿，解毒消肿。用于湿热黄疸，中暑腹泻，砂淋血淋，痈肿疮毒，跌扑损伤。"}]},{"ID":"20240611173745-9xxvwpt","Type":"NodeParagraph","Properties":{"id":"20240611173745-9xxvwpt","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173745-rdwkjky","Type":"NodeParagraph","Properties":{"id":"20240611173745-rdwkjky","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 15～30g；鲜品加倍。"}]},{"ID":"20240611173745-pf6l1ly","Type":"NodeParagraph","Properties":{"id":"20240611173745-pf6l1ly","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173745-n583c7y","Type":"NodeParagraph","Properties":{"id":"20240611173745-n583c7y","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611173745-5kwqsxa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173745-5kwqsxa","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：积雪草"}]},{"ID":"20240611173745-4t5wqr9","Type":"NodeParagraph","Properties":{"id":"20240611173745-4t5wqr9","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173745-2lx567c","Type":"NodeParagraph","Properties":{"id":"20240611173745-2lx567c","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" Jī Xuě Cǎo"}]},{"ID":"20240611173745-sy0lboh","Type":"NodeParagraph","Properties":{"id":"20240611173745-sy0lboh","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173745-sywrygi","Type":"NodeParagraph","Properties":{"id":"20240611173745-sywrygi","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 连钱草（《徐仪药图》），地钱草（《唐本草》），马蹄草（《滇南本草》），老公根、葵蓬菜、崩口碗（《生草药性备要》），地棠草（《植物名实图考》），大马蹄草、土细辛《草木便方》），崩大碗，钱凿口（《广州植物志》），复箸碗草、蚶壳草、鲎圭草（《福建民间草药》），铜钱草、遍地香（《浙江中药手册》），雷公根（《江苏植药志》），灯盏菜、牛浴菜（《南宁市药物志》），野荠菜、马脚迹、遍地金钱草、半边月（《江西民间草药》），老鸦碗（《滇南本草》整理本），酒杯菜（《广西中药志》），破铜钱、半边钱、地浮萍、野冬苋菜、盘"}]},{"ID":"20240611173745-cjfowxj","Type":"NodeParagraph","Properties":{"id":"20240611173745-cjfowxj","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611173745-qaaoxc8","Type":"NodeParagraph","Properties":{"id":"20240611173745-qaaoxc8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611173745-996a6ar","Type":"NodeParagraph","Properties":{"id":"20240611173745-996a6ar","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173745-9jsswwi","Type":"NodeParagraph","Properties":{"id":"20240611173745-9jsswwi","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 为伞形科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"积雪草"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带根全草"},{"Type":"NodeText","Data":"。夏、秋采收，去净泥杂，晒干。"}]},{"ID":"20240611173745-tbfz8cm","Type":"NodeParagraph","Properties":{"id":"20240611173745-tbfz8cm","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611173745-23l3fs5","Type":"NodeParagraph","Properties":{"id":"20240611173745-23l3fs5","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 多生于路旁、沟边、田坎边稍湿润而肥沃的土地。分布江苏、安徽、浙江、江西、湖南、湖北、四川、贵州、云南、福建、广东、广西等地。产广东、四川、广西、江苏、浙江、江西、福建、湖南等地。"}]},{"ID":"20240611173745-p2hi6bf","Type":"NodeParagraph","Properties":{"id":"20240611173745-p2hi6bf","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611173745-fwpdokl","Type":"NodeParagraph","Properties":{"id":"20240611173745-fwpdokl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 多年生匍匐草本。茎光滑或稍被疏毛，节上生根。单叶互生，叶片圆形或肾形，直径2～4厘米，边缘有钝齿，上面光滑，下面有细毛；叶有长柄，长1.5～7厘米。伞形花序单生，伞梗生于叶腋，短于叶柄；每一花梗的顶端有花3～6朵，通常聚生成头状花序，花序又为2枚卵形苞片所包围；花萼截头形；花瓣5，红紫色，卵形；雄蕊5，短小，与花瓣互生；子房下位，花柱2，较短，花柱基不甚明显。双悬果扁圆形，光滑，主棱和次梭同等明显，主棱间有网状纹相连。花期夏季。"}]},{"ID":"20240611173745-164fibd","Type":"NodeParagraph","Properties":{"id":"20240611173745-164fibd","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611173745-nm2g5kv","Type":"NodeParagraph","Properties":{"id":"20240611173745-nm2g5kv","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 干燥全草多皱缩成团，根圆柱形，长3～4.5厘米，直径约1～1.5毫米，淡黄色或灰黄色，有纵皱纹。茎细长、弯曲、淡黄色，在节处有明显的细根残迹或残留之细根。叶多皱缩，淡绿色，圆形或肾形，径2～4厘米，边缘有钝齿，下面有细毛。叶柄长1.5～7厘米，常扭曲，基部具膜质叶鞘。气特异，味微辛。"}]},{"ID":"20240611173745-h5ijurx","Type":"NodeParagraph","Properties":{"id":"20240611173745-h5ijurx","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611173745-l6nraq2","Type":"NodeParagraph","Properties":{"id":"20240611173745-l6nraq2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 醇提取物对大鼠腹腔注射的半数致死量为1.93克/公斤。甙部分毒性较小，大鼠腹腔注射2克/公斤也不引起死亡。积雪草甙对小鼠、兔皮下注射0.04～0.05克/公斤能产生中毒症状；0.2～0.25克/公斤则增加出血时间，导致出血。口服1克/公斤对小鼠、兔皆能耐受。"}]},{"ID":"20240611173745-4phm4ld","Type":"NodeParagraph","Properties":{"id":"20240611173745-4phm4ld","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611173745-bbbwcj2","Type":"NodeParagraph","Properties":{"id":"20240611173745-bbbwcj2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 含多种α-香树脂醇型的三萜成分，其中有积雪草甙、参枯尼甙、异参枯尼甙、羟基积雪草甙、玻热模甙、玻热米甙和玻热米酸等，以及马达积雪草酸。此外，尚含内消旋肌醇、积雪草糖、蜡、胡萝卜烃类、叶绿素，以及山柰酚、槲皮素和葡萄糖、鼠李糖的黄酮甙。"}]},{"ID":"20240611173745-bzpxqwk","Type":"NodeParagraph","Properties":{"id":"20240611173745-bzpxqwk","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611173745-kipi44x","Type":"NodeParagraph","Properties":{"id":"20240611173745-kipi44x","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" ①中枢作用"}]},{"ID":"20240611173745-rm2yx06","Type":"NodeParagraph","Properties":{"id":"20240611173745-rm2yx06","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"其中所含的甙对小鼠、大鼠有镇静、安定作用，此作用主要是对中枢神经系统中的胆碱能系统的影响。醇提取物无镇痛作用。"}]},{"ID":"20240611173745-3uv7d77","Type":"NodeParagraph","Properties":{"id":"20240611173745-3uv7d77","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"②对皮肤组织的作用"}]},{"ID":"20240611173745-v8dziwf","Type":"NodeParagraph","Properties":{"id":"20240611173745-v8dziwf","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"积雪草甙能治疗皮肤溃疡，如顽固性创伤、皮肤结核、麻风等。对小鼠，豚鼠、兔肌肉注射或皮下植入可促进皮肤生长，局部白细胞增多、结缔组织盘管网增生、粘液分泌增加、毛及尾的生长加速等。曾有报告用含积雪草0.25～1％醇提取物（含积雪草酸、积雪草甙）的乳霜剂（其中尚含胚胎的或年幼的牛、猪或羊皮肤、肝、脑的水醇提取物）治疗皮肤病，获良好效果。"}]},{"ID":"20240611173745-0hlsku6","Type":"NodeParagraph","Properties":{"id":"20240611173745-0hlsku6","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"③抗菌作用"}]},{"ID":"20240611173745-qolitca","Type":"NodeParagraph","Properties":{"id":"20240611173745-qolitca","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"幼芽的水提取物有抗菌作用。积雪草甙能治疗麻风，有人认为其作用为溶解细菌的蜡膜，从而被其他药物或机体防御机能所消灭。"}]},{"ID":"20240611173745-uy3er8f","Type":"NodeParagraph","Properties":{"id":"20240611173745-uy3er8f","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240611173745-p0l7c8a","Type":"NodeParagraph","Properties":{"id":"20240611173745-p0l7c8a","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"醇提取物能松弛大鼠离体回肠。甙部分能降低家兔及大鼠离体回肠的张力及收缩幅度，并能轻度抑制乙酰胆碱的作用。对麻醉犬，静脉注射可轻度兴奋呼吸，心率变慢及中度的降低血压，后二者不能被阿托品阻断。"}]},{"ID":"20240611173745-l9hrzdd","Type":"NodeParagraph","Properties":{"id":"20240611173745-l9hrzdd","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611173745-5lg4rp1","Type":"NodeParagraph","Properties":{"id":"20240611173745-5lg4rp1","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 入肝、脾、肾经。"}]},{"ID":"20240611173745-c7n9t2p","Type":"NodeParagraph","Properties":{"id":"20240611173745-c7n9t2p","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"①《泉州本草》：\"入肝、脾、肾三经。\""}]},{"ID":"20240611173745-tklhpqt","Type":"NodeParagraph","Properties":{"id":"20240611173745-tklhpqt","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"②《闽东本草》：\"入心、肺、脾、胃、大肠五经。\""}]},{"ID":"20240611173745-ddjps0i","Type":"NodeParagraph","Properties":{"id":"20240611173745-ddjps0i","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173745-3mo6ql5","Type":"NodeParagraph","Properties":{"id":"20240611173745-3mo6ql5","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒。"}]},{"ID":"20240611173745-brs8mpd","Type":"NodeParagraph","Properties":{"id":"20240611173745-brs8mpd","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240611173745-9i9cyfl","Type":"NodeParagraph","Properties":{"id":"20240611173745-9i9cyfl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240611173745-ibog139","Type":"NodeParagraph","Properties":{"id":"20240611173745-ibog139","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"味苦辛。\""}]},{"ID":"20240611173745-ivitstc","Type":"NodeParagraph","Properties":{"id":"20240611173745-ivitstc","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"④《本草求原》：\"甘淡辛，寒。\""}]},{"ID":"20240611173745-dj0zb4w","Type":"NodeParagraph","Properties":{"id":"20240611173745-dj0zb4w","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611173745-igcv94t","Type":"NodeParagraph","Properties":{"id":"20240611173745-igcv94t","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 《植物名实图考》：\"虚寒者不宜。\""}]},{"ID":"20240611173745-a5zrcxp","Type":"NodeParagraph","Properties":{"id":"20240611173745-a5zrcxp","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173745-6ysgytb","Type":"NodeParagraph","Properties":{"id":"20240611173745-6ysgytb","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 清热利湿，消肿解毒。治痧气腹痛，暑泻，痢疾，湿热黄疸，砂淋，血淋，吐、衄、咳血，目赤，喉肿，风疹，疥癣，疔痈肿毒，跌打损伤。"}]},{"ID":"20240611173745-8uhfrsl","Type":"NodeParagraph","Properties":{"id":"20240611173745-8uhfrsl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主大热，恶疮，痈疽，浸淫，赤熛，皮肤赤，身热。\""}]},{"ID":"20240611173745-9jdm7cz","Type":"NodeParagraph","Properties":{"id":"20240611173745-9jdm7cz","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"治瘰疬鼠漏，寒热时节来往。\""}]},{"ID":"20240611173745-n4ofgjs","Type":"NodeParagraph","Properties":{"id":"20240611173745-n4ofgjs","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"③《唐本草》：\"捣敷热肿丹毒。\""}]},{"ID":"20240611173745-zqs5s3t","Type":"NodeParagraph","Properties":{"id":"20240611173745-zqs5s3t","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"以盐挪贴，消肿毒并风疹疥癣。\""}]},{"ID":"20240611173745-45tqopr","Type":"NodeParagraph","Properties":{"id":"20240611173745-45tqopr","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"治子午潮热，眩晕，怕冷，肢体酸困，饮食无味，男妇童疳，虚劳发热不退者用之，利小便，水牛肉为引。\""}]},{"ID":"20240611173745-4bv0a99","Type":"NodeParagraph","Properties":{"id":"20240611173745-4bv0a99","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"研汁点暴赤眼。\""}]},{"ID":"20240611173745-cxxqlrr","Type":"NodeParagraph","Properties":{"id":"20240611173745-cxxqlrr","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑦《本草求原》：\"除热毒，治白浊，浸疳疮，理小肠气。\""}]},{"ID":"20240611173745-zxmlzyw","Type":"NodeParagraph","Properties":{"id":"20240611173745-zxmlzyw","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑧《民间常用草药汇编》：\"利水和脾。治水泻及赤白痢。\""}]},{"ID":"20240611173745-y3g01c7","Type":"NodeParagraph","Properties":{"id":"20240611173745-y3g01c7","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑨《陆川本草》：\"解毒，泻火，利小便。治热性病，头痛，身热，口渴，小便黄赤。\""}]},{"ID":"20240611173745-8pryx1b","Type":"NodeParagraph","Properties":{"id":"20240611173745-8pryx1b","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑩《四川中药志》：\"祛风散寒。治肺热咳嗽，消瘿瘤，涂痈疮肿毒，消食积饱胀。\""}]},{"ID":"20240611173745-yass3cg","Type":"NodeParagraph","Properties":{"id":"20240611173745-yass3cg","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑾《闽东本草》：\"治暑热痧气，腹痛腹胀。\""}]},{"ID":"20240611173745-772oihl","Type":"NodeParagraph","Properties":{"id":"20240611173745-772oihl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑿《广东中药》Ⅱ：\"清暑热，去湿热。治肝肿大，肋膜炎，双单喉蛾，防治麻疹，并解钩吻中毒。\""}]},{"ID":"20240611173745-7ds8qoy","Type":"NodeParagraph","Properties":{"id":"20240611173745-7ds8qoy","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173745-6bpqwr3","Type":"NodeParagraph","Properties":{"id":"20240611173745-6bpqwr3","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱（鲜者0.5～1两）；或捣汁。外用：捣敷或捣汁涂。"}]},{"ID":"20240611173745-1js5s8s","Type":"NodeParagraph","Properties":{"id":"20240611173745-1js5s8s","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611173745-bb3dshe","Type":"NodeParagraph","Properties":{"id":"20240611173745-bb3dshe","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" ①治湿热黄疸：积雪草一两，冰糖一两。水煎服。（《江西民间草药》）"}]},{"ID":"20240611173745-e8x9ch6","Type":"NodeParagraph","Properties":{"id":"20240611173745-e8x9ch6","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"②治中暑腹泻：积雪草鲜叶搓成小团，嚼细开水吞服一、二团。（《浙江民间常用草药》）"}]},{"ID":"20240611173745-5qpz6p9","Type":"NodeParagraph","Properties":{"id":"20240611173745-5qpz6p9","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"③治砂淋：积雪草一两。第二次的淘米水煎服。（《江西民间草药验方》）"}]},{"ID":"20240611173745-j0fo47i","Type":"NodeParagraph","Properties":{"id":"20240611173745-j0fo47i","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"④治血淋：积雪草头、草益根各-把。捣烂绞汁和冰糖一两，一次炖服。（《闽东本草》）"}]},{"ID":"20240611173745-i0op05a","Type":"NodeParagraph","Properties":{"id":"20240611173745-i0op05a","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑤治小便不通：鲜积雪草一两，捣烂贴肚脐，小便通即去药。（《闽东本草》）"}]},{"ID":"20240611173745-to1wbtw","Type":"NodeParagraph","Properties":{"id":"20240611173745-to1wbtw","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑥治肝脏肿大：崩大碗每次约八两至一斤。煎水服。（《岭南草药志》）"}]},{"ID":"20240611173745-vahxciu","Type":"NodeParagraph","Properties":{"id":"20240611173745-vahxciu","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑦治麻疹：积雪草一至二两。水煎服。（广州部队《常用中草药手册》）"}]},{"ID":"20240611173745-zriq2qp","Type":"NodeParagraph","Properties":{"id":"20240611173745-zriq2qp","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑧治乳痈初起：老公根茎叶和槟梅衣一个。酒煎服。（《岭南采药录》）"}]},{"ID":"20240611173745-fycw0vh","Type":"NodeParagraph","Properties":{"id":"20240611173745-fycw0vh","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑨治疔疮：㈠鲜积霄草，洗净，捣烂敷患处。（《江西民间草药》）㈡鲜积雪草一至二两。水煎服。（《福建中草药》）"}]},{"ID":"20240611173745-mo51gvs","Type":"NodeParagraph","Properties":{"id":"20240611173745-mo51gvs","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑩治缠腰火丹：鲜积雪草，洗净，捣烂绞汁，同适量的生糯米粉调成稀糊状，搽患处。（《江西民间草药》）"}]},{"ID":"20240611173745-dag5nqt","Type":"NodeParagraph","Properties":{"id":"20240611173745-dag5nqt","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑾治跌打损伤：积雪草八钱至一两，和红酒半斤至十二两，炖一小时，内服；渣捣烂后贴伤部。（《福建民间草药》）"}]},{"ID":"20240611173745-6vgrhpp","Type":"NodeParagraph","Properties":{"id":"20240611173745-6vgrhpp","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⑿治刀伤出血：崩大碗，酌量，捣烂外敷伤口。（《岭南草药志》）"}]},{"ID":"20240611173745-svwdpch","Type":"NodeParagraph","Properties":{"id":"20240611173745-svwdpch","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒀治臁疮：鲜积雪草洗净，捣烂敷患处，一日一换。（《江西民间草药》）"}]},{"ID":"20240611173745-23dyzem","Type":"NodeParagraph","Properties":{"id":"20240611173745-23dyzem","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒁治目赤肿痛：鲜积雪草捣烂敷寸口处，或捣烂绞汁点患眼，一日三、四次。（《江西民间草药》）"}]},{"ID":"20240611173745-op50clj","Type":"NodeParagraph","Properties":{"id":"20240611173745-op50clj","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒂治麦粒肿：鲜积雪草洗净捣烂，掺红糖敷之。（《泉州本草》）"}]},{"ID":"20240611173745-9xrnb09","Type":"NodeParagraph","Properties":{"id":"20240611173745-9xrnb09","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒃治咽喉肿痛：鲜积雪草二两。洗净，放碗中捣烂，开水冲出汁，侯温，频频含咽。（《江西民间草药》）"}]},{"ID":"20240611173745-wm2k98y","Type":"NodeParagraph","Properties":{"id":"20240611173745-wm2k98y","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒄治百日咳：崩大碗三两，瘦猪肉一两。同煎一小时，分两次服，连服数天。"}]},{"ID":"20240611173745-5k219k3","Type":"NodeParagraph","Properties":{"id":"20240611173745-5k219k3","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒅治误食砒霜或其他食物中毒：老公根四两，胆矾一钱。煎水服。此方亦治钩吻及蕈中毒。"}]},{"ID":"20240611173745-2hqcqhl","Type":"NodeParagraph","Properties":{"id":"20240611173745-2hqcqhl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒆治骨鲠：老公根煎水内服，服时须慢慢咽下。（⒄方以下出《岭南草药志》）"}]},{"ID":"20240611173745-89ql9zg","Type":"NodeParagraph","Properties":{"id":"20240611173745-89ql9zg","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"⒇解大茶药中毒：取崩大碗捣烂，加茶油灌服。"}]},{"ID":"20240611173745-wqbapg7","Type":"NodeParagraph","Properties":{"id":"20240611173745-wqbapg7","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"（21）解木薯中毒：取崩大碗捣烂，温开水冲服。"}]},{"ID":"20240611173745-j0tjqyt","Type":"NodeParagraph","Properties":{"id":"20240611173745-j0tjqyt","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"（22）解毒蕈中毒：崩大碗四两，片糖二两，煎水内服；或崩大碗四两，萝卜一斤，捣烂榨汁内服。（⒇方以下出《南方主要有毒植物》）"}]},{"ID":"20240611173745-p86fva7","Type":"NodeParagraph","Properties":{"id":"20240611173745-p86fva7","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"（23）治咳血、吐血、鼻出血：鲜积雪草二至三两，水煎或捣汁服。（《福建中草药》）"}]},{"ID":"20240611173745-o18ergh","Type":"NodeParagraph","Properties":{"id":"20240611173745-o18ergh","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"（24）治跌打肿痛：鲜积雪草捣烂绞汁一两，调酒，炖温服；渣敷患处。（《福建中草药》）"}]},{"ID":"20240611173745-ir0k8tk","Type":"NodeParagraph","Properties":{"id":"20240611173745-ir0k8tk","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611173745-kcsqzr2","Type":"NodeParagraph","Properties":{"id":"20240611173745-kcsqzr2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" ①用于止痛"}]},{"ID":"20240611173745-apbazhv","Type":"NodeParagraph","Properties":{"id":"20240611173745-apbazhv","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"取积雪草晒干研细，每日1～1.5钱，3次分服。治疗胸、背及腰部外伤性疼痛42例，27例止痛，14例好转，1例无效。"}]},{"ID":"20240611173745-lgivxjf","Type":"NodeParagraph","Properties":{"id":"20240611173745-lgivxjf","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"②治疗传染性肝炎"}]},{"ID":"20240611173745-0w12dj2","Type":"NodeParagraph","Properties":{"id":"20240611173745-0w12dj2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"取鲜积雪草4两，加水500毫升，浓煎成250毫升，趁热加入冰糖2两溶化，分2次空腹服，7天为一疗程。治疗10例，服药4天黄疸消退、食欲改善、恶心呕吐消失者3例，服药1周黄疸消退、消化道症状好转、胃纳增进者5例。肝肿大于服药二疗程消退2例，三疗程消退5例，四疗程消退3例。"}]},{"ID":"20240611173745-jlxezkj","Type":"NodeParagraph","Properties":{"id":"20240611173745-jlxezkj","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"③处理流行性脑脊髓膜炎带菌者"}]},{"ID":"20240611173745-zufd1mq","Type":"NodeParagraph","Properties":{"id":"20240611173745-zufd1mq","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"取积雪草（干）1000克，水煎2次，合并滤液，浓缩至1000毫升，加防腐剂，pH调至8左右。每服10毫升，5岁以下儿童减半，每日3次，空腹服，连服3天。处理30例流脑带菌者，3天后连续3次作鼻咽分泌物采样培养，结果转阴24例，较磺胺噻唑对照组的转阴率高。"}]},{"ID":"20240611173745-uzi2y68","Type":"NodeParagraph","Properties":{"id":"20240611173745-uzi2y68","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611173745-2ysd3uw","Type":"NodeParagraph","Properties":{"id":"20240611173745-2ysd3uw","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 江苏、浙江等地区以本品作\"落得打\"使用。"}]},{"ID":"20240611173745-yh9t5jg","Type":"NodeParagraph","Properties":{"id":"20240611173745-yh9t5jg","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173745-0rgyreq","Type":"NodeParagraph","Properties":{"id":"20240611173745-0rgyreq","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611173745-tm5c8yl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173745-tm5c8yl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"《中华本草》：积雪草"}]},{"ID":"20240611173745-7rgr44d","Type":"NodeParagraph","Properties":{"id":"20240611173745-7rgr44d","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173745-icm7e7s","Type":"NodeParagraph","Properties":{"id":"20240611173745-icm7e7s","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" Jī Xuě Cǎo"}]},{"ID":"20240611173745-j2ur1r9","Type":"NodeParagraph","Properties":{"id":"20240611173745-j2ur1r9","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173745-gg2g4p8","Type":"NodeParagraph","Properties":{"id":"20240611173745-gg2g4p8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 连钱草、地钱草、马蹄草、老公根、葵蓬菜、崩口碗、落得打、地棠草、大马蹄草、土细辛、崩大碗、雷公根、刚果龙、缺碗草芋子草、马脚迹、芽黄草、草如意、蚶壳草、含壳草、乞食碗、老豺碗、大水钱、破铜钱草、铜钱草、老鸭确定、铁灯盏、半边碗、透骨草、跳破碗、雷公碗、地细辛、地排草"}]},{"ID":"20240611173745-52i87df","Type":"NodeParagraph","Properties":{"id":"20240611173745-52i87df","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611173745-tyl1bvb","Type":"NodeParagraph","Properties":{"id":"20240611173745-tyl1bvb","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" Asiatic Pennywort Herb"}]},{"ID":"20240611173745-yj9yfev","Type":"NodeParagraph","Properties":{"id":"20240611173745-yj9yfev","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611173745-cmwrji2","Type":"NodeParagraph","Properties":{"id":"20240611173745-cmwrji2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240611173745-luxmxh7","Type":"NodeParagraph","Properties":{"id":"20240611173745-luxmxh7","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173745-301e09r","Type":"NodeParagraph","Properties":{"id":"20240611173745-301e09r","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 药材基源：为伞形科植物积雪草的全草。"}]},{"ID":"20240611173745-c8j7bl4","Type":"NodeParagraph","Properties":{"id":"20240611173745-c8j7bl4","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Centella asiatica (L.) Urban[Hydro-cotyle asiatica L.]"}]},{"ID":"20240611173745-2a68kwy","Type":"NodeParagraph","Properties":{"id":"20240611173745-2a68kwy","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季采收全草，晒干或鲜用。"}]},{"ID":"20240611173745-nqoqpxx","Type":"NodeParagraph","Properties":{"id":"20240611173745-nqoqpxx","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611173745-9edryh1","Type":"NodeParagraph","Properties":{"id":"20240611173745-9edryh1","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔200-1990m的阴湿草地、田边、沟边。"}]},{"ID":"20240611173745-23bl57i","Type":"NodeParagraph","Properties":{"id":"20240611173745-23bl57i","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及陕西、江苏、安徽、浙江、江西、福建、台湾、湖北、湖北、湖南、广东、广西等地。"}]},{"ID":"20240611173745-lj042li","Type":"NodeParagraph","Properties":{"id":"20240611173745-lj042li","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611173745-n0hcxf1","Type":"NodeParagraph","Properties":{"id":"20240611173745-n0hcxf1","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 多年生草本，茎葡萄，细长，节上生根，无毛或稍有毛。单叶互生；叶柄长2-15cm，基部鞘状；叶片肾形或近圆形，长1-3cm，宽1.5-5cm，基部阔心形，边缘有钝锯齿，两面无毛或在背面脉上疏生柔毛；常状脉5-7。单伞形花序单生，或2-4个聚状；花瓣卵形，紫红色或乳白色。果实圆球形，基部心形或平截，长2-3m，宽2-3.5mm，每侧有纵棱数条，棱间有明显的小横脉，网状，平滑或稍有毛。花、果期4-10月。"}]},{"ID":"20240611173745-7etmhb7","Type":"NodeParagraph","Properties":{"id":"20240611173745-7etmhb7","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611173745-lfi88h3","Type":"NodeParagraph","Properties":{"id":"20240611173745-lfi88h3","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 生物学特性 生于旷、路旁、沟边等阴湿处，喜阳光和较湿润的环境。"}]},{"ID":"20240611173745-nbl3qs2","Type":"NodeParagraph","Properties":{"id":"20240611173745-nbl3qs2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子分株繁殖。种子繁殖：于春、秋季条播，覆土2-3cm。分株繁殖：在早春进行。苗期勤除杂草，旱季注意浇水。"}]},{"ID":"20240611173745-fojffgu","Type":"NodeParagraph","Properties":{"id":"20240611173745-fojffgu","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611173745-de8qr9k","Type":"NodeParagraph","Properties":{"id":"20240611173745-de8qr9k","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 干燥全草多皱缩成团，根圆柱形，长3-4.5cm，直径1-1.5mm，淡黄色或灰黄色，有纹皱纹。茎细长、弯曲、淡黄色、在节处有明显的细根残迹或残留的细根、叶多皱缩破碎，灰绿色，完整的叶圆形或肾形，直径2-6cm，边缘有钝齿，下面有细毛；叶柄长1.5-7cm，常扭曲，基部具膜质叶鞘。气特异，叶淡微辛。"}]},{"ID":"20240611173745-g7fpcus","Type":"NodeParagraph","Properties":{"id":"20240611173745-g7fpcus","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：表皮细胞类圆形或近方形。皮层为7-9列薄壁细胞，外侧数列细胞的壁呈不均匀增厚。外韧维管束6-7个，排列成环；韧皮部外侧国微木化的纤维群；木质部导管约6-10个；束内形成层为2-3列细小细胞。髓部由较大的类圆形薄壁细胞组成。皮层和射线中分布圆形的油管，直径24-24μm，周围分泌细胞5-7个。"}]},{"ID":"20240611173745-j1sqwzl","Type":"NodeParagraph","Properties":{"id":"20240611173745-j1sqwzl","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611173745-xfss6i3","Type":"NodeParagraph","Properties":{"id":"20240611173745-xfss6i3","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 醇提取物对大鼠腹腔注射的半数致死量为1.93g/kg。甙部分毒性较小，大鼠腹腔注射2g/kg也不引起死亡。积雪草甙对小鼠、兔皮下注射0.04-0.05g/kg能产生中毒症状；0.2-0.25g/kg则增加出血时间，导致出血。口服1g/kg对小鼠、兔皆能耐受。毒性：乙醇提取物大鼠腹腔注射的半数致死量为1.93g/kg。"}]},{"ID":"20240611173745-gf2vuur","Type":"NodeParagraph","Properties":{"id":"20240611173745-gf2vuur","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611173745-exq50aa","Type":"NodeParagraph","Properties":{"id":"20240611173745-exq50aa","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 含多种α-香树脂醇型的三萜成分，其中有积雪草甙(Asiaticoside)、参枯尼甙(Thankuniside)、异参枯尼甙(Isothankuniside)，羟基积雪草甙(Madecas-soside)，玻热模甙(Brahmoside)、破热米甙(Brah-minoside)和破热米酸(Brahmic acid)等，以及马达积雪草酸(Madasiatic acid)。此外，尚含内消旋肌醇(Meso-inositol)、积雪草糖(Centellose,一种寡糖)、蜡、胡萝卜烃类(Carotenoids)、叶绿素，以及山柰酚、槲皮素和葡萄糖、鼠李糖的黄酮甙。全草主要含三萜酸和三萜皂甙。三萜有积雪草酸(asiatic acid)、羟基积雪草酸(brahmic acid)、异羟基积雪草酸(isobrahmic acid)及桦皮酸(be-tulinic acid)等。三萜皂甙有积雪草甙(asiaticoside,madecassol)、羟基积雪草甙(madecassoside)、落得打三糖甙(brahmoside)及落得打四糖甙(brahminoside)，又谓含参枯甙(thankuniside)及异参枯甙(isothankuniside)。另含山柰素和槲皮素及其甙、积雪草碱(hydrocotyline)、内消旋肌醇(inositol)、积雪草低聚糖(centellose)、谷甾醇、维生素C、胡萝卜素、绿色挥发油及树脂状物质。"}]},{"ID":"20240611173745-xoxwkbi","Type":"NodeParagraph","Properties":{"id":"20240611173745-xoxwkbi","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611173745-3q45i7b","Type":"NodeParagraph","Properties":{"id":"20240611173745-3q45i7b","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 1.中枢作用：其中所含的甙对小鼠、大鼠有镇静、安定作用，此作用主要是对中枢神经系统中的胆碱能系统的影响。醇提取物无镇痛作用。"}]},{"ID":"20240611173745-p8zgrpd","Type":"NodeParagraph","Properties":{"id":"20240611173745-p8zgrpd","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"2.对皮肤组织的作用：积雪草甙能治疗皮肤溃疡，如顽固性创伤、皮肤结核、麻风等。对小鼠、豚鼠、兔肌肉注射或皮下植入可促进皮肤生长、局部白细胞增多、结缔组织血管网增生、粘液分泌增加、毛及尾的生长加速等。曾有报告用含积雪草0.25-1%醇提取物(含积雪草酸、积雪草甙)的乳霜剂(其中尚含胚胎的或年幼的牛、猪或羊皮肤、肝、脑的水醇提取物)治疗皮肤病，获良好效果。"}]},{"ID":"20240611173745-g3q4cr0","Type":"NodeParagraph","Properties":{"id":"20240611173745-g3q4cr0","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"3.抗菌作用：幼芽的水提取物有抗菌作用。积雪草甙能治疗麻风，有人认为其作用为溶解细菌的蜡膜，从而被其他药物或机体防御机能所消灭。"}]},{"ID":"20240611173745-pvzmgms","Type":"NodeParagraph","Properties":{"id":"20240611173745-pvzmgms","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"4.其他作用：醇提取物能松弛大鼠离体回肠。甙部分能降低家兔及大鼠离体回肠的张力及收缩幅度，并能轻度抑制乙酰胆碱的作用。对麻醉犬，静脉注射可轻度兴奋呼吸，心率变慢及中度的降低血压，后二者不能被阿托品阻断。有报道积雪甙对麻风病有治疗作用。"}]},{"ID":"20240611173745-abf8lt6","Type":"NodeParagraph","Properties":{"id":"20240611173745-abf8lt6","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611173745-hffoln2","Type":"NodeParagraph","Properties":{"id":"20240611173745-hffoln2","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末1g，加已醇适量，热提10分钟，滤过，滤液浓缩至干，残潭用氯仿溶解至约1ml，加1ml硫酸，氯仿层显红棕色。（检查三萜类化合物）（2）取本品粉末1g，加已醇适量，热提10min，滤过，滤液浓缩至干，残潭溶于醋酐中，加入1滴硫酸，醋酐层显绿以。（检查三萜类化合物）"}]},{"ID":"20240611173745-khl6u3d","Type":"NodeParagraph","Properties":{"id":"20240611173745-khl6u3d","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611173745-k5xxlsg","Type":"NodeParagraph","Properties":{"id":"20240611173745-k5xxlsg","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 归肺；脾‘肾；膀胱经"}]},{"ID":"20240611173745-636bxzp","Type":"NodeParagraph","Properties":{"id":"20240611173745-636bxzp","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173745-kkuhw80","Type":"NodeParagraph","Properties":{"id":"20240611173745-kkuhw80","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性寒"}]},{"ID":"20240611173745-77c1qnh","Type":"NodeParagraph","Properties":{"id":"20240611173745-77c1qnh","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611173745-62fkoe8","Type":"NodeParagraph","Properties":{"id":"20240611173745-62fkoe8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 《植物名实图考》：虚寒者不宜。"}]},{"ID":"20240611173745-ith2b2u","Type":"NodeParagraph","Properties":{"id":"20240611173745-ith2b2u","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173745-58v70ud","Type":"NodeParagraph","Properties":{"id":"20240611173745-58v70ud","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 清热利湿；活血止血；解毒消肿。主发热；咳喘；咽喉肿痛；肠为为；痢疾；湿热黄疸；水肿；淋证；尿血；衄血；痛经；崩漏；丹毒；瘰疬；亲疮肿毒；带状疱疹；跌打肿痛；外伤出血；蛇虫咬伤"}]},{"ID":"20240611173745-4cty2ew","Type":"NodeParagraph","Properties":{"id":"20240611173745-4cty2ew","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173745-id8wu18","Type":"NodeParagraph","Properties":{"id":"20240611173745-id8wu18","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g（鲜者15-30g）；或捣汁。外用：适量，捣敷或绞汁涂。"}]},{"ID":"20240611173745-f4cjp9r","Type":"NodeParagraph","Properties":{"id":"20240611173745-f4cjp9r","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611173745-wox5xjv","Type":"NodeParagraph","Properties":{"id":"20240611173745-wox5xjv","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" ①治湿热黄疸：积雪草一两，冰糖一两。水煎服。(《江西民间草药》)②治中暑腹泻：积雪草鲜叶搓成小团，嚼细开水吞服一、二切。(《浙江民间常用草药》)③治砂淋：积雪草一两。第二次的淘米水煎服。(《江西民间草药验方》)④治血淋：积雪草头、草益根各一把。捣烂绞汁和冰糖一两，一次炖服。(《闽东本草》)⑤治小便不通：鲜积雪草一两，捣烂贴肚脐，小便通即去药。(《闽东本草》)⑥治肝脏肿大：崩大碗每次约八两至一斤。煎水服。(《岭南草药志》)⑦治麻疹：积雪草一至二两。水煎服。(广州部队《常用中草药手册》)⑧治乳痈初起：老公很茎叶和槟榔衣一个。酒煎服。(《岭南采药录》)⑨治疔疮： 一、鲜积雪草，洗净，捣烂敷患处。(《江西民间草药》)二、鲜积雪草一至二两。水煎服。(《福建中草药》)⑩治缠腰火丹：鲜积雪草，洗净，捣烂绞汁，同适量的生糯米粉碉成稀糊状，搽患处。(《江西民间草药》)11.治跌打损伤：积雪草八钱至一两，和红酒半斤至十二两，炖一小时，内服；渣捣烂后贴伤部。(《福建民间草药》)12.治刀伤出血：崩大碗，酌量，捣烂外敷伤口。(《岭南草药志》)13.治臁疮：鲜积雪草洗净，捣烂敷患处，一日一换。(《江西民间草药》)14.治目赤肿痛：鲜积雪草捣烂敷寸口处，或捣烂绞汁点患眼，一日三、四次。(《江西民间草药》)15.治麦粒肿：鲜积雪草洗净捣烂，掺红糖敷之。(《泉州本草》)16.治咽喉肿痛：鲜积雪草二两。洗净，放碗中捣烂，开水冲出汁，候温，频频含咽。(《江西民间草药》)17.治百日咳：崩大碗三两，瘦猪肉一两。同煎一小时，分两次服，连服数天。18.治误食砒霜或其他食物中毒：老公根四两，胆矾一钱。煎水服。此方亦治钩吻及蕈中毒。19.治骨鲠：老公根煎水内服，服时须慢慢咽下。(17-19方均出《岭南草药志》)20、解大茶药中毒：取崩大碗捣烂，加茶油灌服。21.解木薯中毒：取崩大碗捣烂，温开水冲服。22.解毒蕈中毒：崩大碗四两，片糖二两。煎水内服；或崩大碗四两，萝卜一斤，捣烂榨汁内服。(20-22方均出《南方主要有毒植物》)23.治咳血、吐血、鼻出血：鲜积雪草二至三两。水煎或捣汁服。(《福建中草药》)24.治跌打肿痛：鲜积雪草捣烂绞汁一两，调酒，炖温服；渣敷患处。(《福建中草药》)"}]},{"ID":"20240611173745-a45tqw0","Type":"NodeParagraph","Properties":{"id":"20240611173745-a45tqw0","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611173745-uomuoea","Type":"NodeParagraph","Properties":{"id":"20240611173745-uomuoea","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 1.用于止痛：取积雪草晒干研细，每日 1-1.5钱，3次分服。治疗脑、背及腰部外伤性疼痛42例，27例止痛，14例好转， 1例无效。"}]},{"ID":"20240611173745-2yx94m8","Type":"NodeParagraph","Properties":{"id":"20240611173745-2yx94m8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"2.治疗传染性肝炎：取鲜积雪草4两，加水500ml，浓煎成250ml，趁热加入冰糖2两溶化，分2次空腹服，7天为一疗程。治疗10例，服药4天黄疸消退、食欲改善、恶心呕吐消失者3例，服药1同黄疸消退、消化道症状好转、胃纳增进者5例。肝肿大于服药二疗程消退2例，三疗程消退5例，四疗程消退3例。"}]},{"ID":"20240611173745-84m4kce","Type":"NodeParagraph","Properties":{"id":"20240611173745-84m4kce","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"3.处理流行性脑脊髓膜炎：带菌者取积雪草(干)1000g，水煎2次，合并滤液，浓缩至1000ml，加防腐剂，pH调至6左右。每服10ml，5岁以下儿童减半，每日3次，空腹服，连服3天。处理30例流脑带菌者，3天后连续3次作鼻咽分泌物采样培养，结果转阴24例，较磺胺噻唑对照组的转阴率高。"}]},{"ID":"20240611173745-154n2yz","Type":"NodeParagraph","Properties":{"id":"20240611173745-154n2yz","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611173745-xu6eahv","Type":"NodeParagraph","Properties":{"id":"20240611173745-xu6eahv","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主大热，恶疮，痈疽，浸淫，赤熛，皮肤赤，身热。"}]},{"ID":"20240611173745-cefybty","Type":"NodeParagraph","Properties":{"id":"20240611173745-cefybty","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：治瘰疬鼠漏，寒热时节来往。"}]},{"ID":"20240611173745-htng4w8","Type":"NodeParagraph","Properties":{"id":"20240611173745-htng4w8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：捣敷热肿丹毒。"}]},{"ID":"20240611173745-6duhrt8","Type":"NodeParagraph","Properties":{"id":"20240611173745-6duhrt8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：以盐挪贴，消肿毒并风疹疥癣。"}]},{"ID":"20240611173745-2g77dzv","Type":"NodeParagraph","Properties":{"id":"20240611173745-2g77dzv","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：治子午潮热，眩晕，怕冷，肢体酸困，饮食无味，男妇童疳，虚劳发热不退者用之，利小便，水牛肉为引。"}]},{"ID":"20240611173745-zgvmkx8","Type":"NodeParagraph","Properties":{"id":"20240611173745-zgvmkx8","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：研汁点暴赤眼。"}]},{"ID":"20240611173745-82kw9ml","Type":"NodeParagraph","Properties":{"id":"20240611173745-82kw9ml","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"7.《本草求原》：除热毒，治白浊，浸疳疮，理小肠气。"}]},{"ID":"20240611173745-vruj5er","Type":"NodeParagraph","Properties":{"id":"20240611173745-vruj5er","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"8.《民间常用草药汇编》：利水和脾。治水泻及赤白痢。"}]},{"ID":"20240611173745-hbq12sp","Type":"NodeParagraph","Properties":{"id":"20240611173745-hbq12sp","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"9.《陆川本草》：解毒，泻火，利小便。治热性病，头痛，身热，口渴，小便黄赤。"}]},{"ID":"20240611173745-p5vcpt1","Type":"NodeParagraph","Properties":{"id":"20240611173745-p5vcpt1","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"10.《四川中药志》：祛风散寒。治肺热咳嗽，消瘿瘤，涂痈疮肿毒，消食积饱胀。"}]},{"ID":"20240611173745-329lwrd","Type":"NodeParagraph","Properties":{"id":"20240611173745-329lwrd","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"11．《闽东本草》：治暑热痧气，腹痛腹胀。"}]},{"ID":"20240611173745-qifmsi7","Type":"NodeParagraph","Properties":{"id":"20240611173745-qifmsi7","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"12．《广东中药》Ⅱ：清暑热，去湿热。治肝肿大，肋膜炎，双单喉蛾，防治麻疹，并解钩吻中毒。"}]},{"ID":"20240611173745-zjoataw","Type":"NodeParagraph","Properties":{"id":"20240611173745-zjoataw","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173745-kj8zn87","Type":"NodeParagraph","Properties":{"id":"20240611173745-kj8zn87","updated":"20240611173745"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611173747-pwy8ne5","Type":"NodeThematicBreak","Properties":{"id":"20240611173747-pwy8ne5"}},{"ID":"20240611173748-gdq8n7a","Type":"NodeParagraph","Properties":{"id":"20240611173748-gdq8n7a"}}]}