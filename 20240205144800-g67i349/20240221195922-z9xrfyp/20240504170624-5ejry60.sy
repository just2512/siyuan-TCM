Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍耳子 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍耳子 7-20240813142452-13hzqqs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 410px;\" parent-style=\"width: 420px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 829px;","style":"width: 819px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍耳子 (10)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍耳子 10-20240813143237-iznfk9v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 819px;\" parent-style=\"width: 829px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240813145137-l4v66g0","Type":"NodeParagraph","Properties":{"id":"20240813145137-l4v66g0","updated":"20240813145137"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 485px;","style":"width: 475px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"苍耳子 (19)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/苍耳子 19-20240813145137-g5l98ni.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 475px;\" parent-style=\"width: 485px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611125939-yzi9iem","Type":"NodeThematicBreak","Properties":{"id":"20240611125939-yzi9iem"}},{"ID":"20240611125940-sdaw8w6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611125940-sdaw8w6","updated":"20240611125945"},"Children":[{"Type":"NodeText","Data":"枲耳实《神农本草经》"}]},{"ID":"20240611125940-j3lji1x","Type":"NodeParagraph","Properties":{"id":"20240611125940-j3lji1x","updated":"20240611125940"},"Children":[{"Type":"NodeText","Data":"味甘温。"}]},{"ID":"20240611125940-7marl8d","Type":"NodeParagraph","Properties":{"id":"20240611125940-7marl8d","updated":"20240611125940"},"Children":[{"Type":"NodeText","Data":"主风头，寒痛，风湿，周痹，四肢拘挛，痛，恶肉死肌。久服益气，耳目聪明，强志轻身。一名胡枲，一名地葵。生川谷。"}]},{"ID":"20240611125940-k1nr38h","Type":"NodeParagraph","Properties":{"id":"20240611125940-k1nr38h","updated":"20240611125940"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名葹，一名常思，生安陆及六安田野，实熟时采。"}]},{"ID":"20240611125940-r4aubu4","Type":"NodeParagraph","Properties":{"id":"20240611125940-r4aubu4","updated":"20240611125940"},"Children":[{"Type":"NodeText","Data":"案《说文》云：荪，卷耳也。苓，卷耳也。《广雅》云：苓，耳葹，常枲，胡枲，枲耳也。《尔雅》云：苍耳，苓耳。郭璞云：江东呼为常枲，形似鼠耳，丛生如盘。《毛诗》云：采采卷耳。《传》云：卷耳，苓耳也。陆玑云：叶青，白色，似胡荽，白华，细茎蔓生，可煮为茹，滑而少味，四月中生子，正如妇人耳珰，今或谓之耳珰草，郑康成谓是白胡荽，幽州人谓之爵耳。《淮南子》览冥训云：位贱尚枲。高诱云：枲者，枲耳，菜名也。幽冀谓之檀菜，雒下谓之胡枲。"}]},{"ID":"20240611130124-pn5v59a","Type":"NodeThematicBreak","Properties":{"id":"20240611130124-pn5v59a"}},{"ID":"20240611130211-amh82fh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130211-amh82fh","updated":"20240611130217"},"Children":[{"Type":"NodeText","Data":"苍耳《本经逢原》"}]},{"ID":"20240611130211-8qcdpi9","Type":"NodeParagraph","Properties":{"id":"20240611130211-8qcdpi9","updated":"20240611130222"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"古名 枲耳"}]},{"ID":"20240611130211-wypy2t7","Type":"NodeParagraph","Properties":{"id":"20240611130211-wypy2t7","updated":"20240611130211"},"Children":[{"Type":"NodeText","Data":"实甘温，叶苦辛，小毒。酒浸炒用，忌猪肉。"}]},{"ID":"20240611130211-infwkv5","Type":"NodeParagraph","Properties":{"id":"20240611130211-infwkv5","updated":"20240611130312"},"Children":[{"Type":"NodeTextMark","TextMarkType":"b","TextMarkTextContent":"主"},{"Type":"NodeText","Data":"治头风脑痛，风湿周痹，四肢拘挛，恶肉死肌，皮肤瘙痒，脚膝寒痛，久服亦能益气。其叶久服去风湿有效。服苍耳人最忌猪肉及风邪，触犯则遍身发出赤丹也。妇人血风攻脑，头旋闷绝，忽倒不知人事者，用苍耳草嫩心阴干为末，酒服甚效。此味善通顶门连脑，能走督脉也。"}]},{"ID":"20240611130124-jthjre4","Type":"NodeThematicBreak","Properties":{"id":"20240611130124-jthjre4"}},{"ID":"20240611130413-1wxu6mf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130413-1wxu6mf","updated":"20240611130417"},"Children":[{"Type":"NodeText","Data":"苍耳子《本草分经》"}]},{"ID":"20240611130413-giwbalr","Type":"NodeParagraph","Properties":{"id":"20240611130413-giwbalr","updated":"20240611130413"},"Children":[{"Type":"NodeText","Data":"甘苦温，发汗散风湿，上通脑顶，下行足膝，外达皮肤，治头面诸疾、遍身瘙痒、去刺用。采根煎熬名万应膏，功用略同。"}]},{"ID":"20240611130419-tov6npw","Type":"NodeThematicBreak","Properties":{"id":"20240611130419-tov6npw"}},{"ID":"20240611130424-4c7qyhm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130424-4c7qyhm","updated":"20240611130430"},"Children":[{"Type":"NodeText","Data":"苍耳子《本草便读》"}]},{"ID":"20240611130424-ttz7a0g","Type":"NodeParagraph","Properties":{"id":"20240611130424-ttz7a0g","updated":"20240611130424"},"Children":[{"Type":"NodeText","Data":"上通脑顶．外达皮肤．因能发汗以祛风．故可宣痹而散湿．鼻渊头痛．均因苦降功能．疥疾痒疮．又赖疏辛温润．（苍耳子此物能升能降．善发汗．辛苦温润．专入肺脾．治风湿痹痛死肌疥疮等疾．洗服皆良．鼻渊初起属上焦湿热者．用此辛散苦泄．故可治之．）"}]},{"ID":"20240611130435-1lvtjl2","Type":"NodeThematicBreak","Properties":{"id":"20240611130435-1lvtjl2"}},{"ID":"20240611130437-dn39jkl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130437-dn39jkl","updated":"20240611130443"},"Children":[{"Type":"NodeText","Data":"苍耳子《本草择要纲目》"}]},{"ID":"20240611130437-ma1ci38","Type":"NodeParagraph","Properties":{"id":"20240611130437-ma1ci38","updated":"20240611130437"},"Children":[{"Type":"NodeText","Data":"（入药炒熟捣去刺用．或酒拌蒸过用．）"}]},{"ID":"20240611130437-7o5g20x","Type":"NodeParagraph","Properties":{"id":"20240611130437-7o5g20x","updated":"20240611130437"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240611130437-idp1tbk","Type":"NodeParagraph","Properties":{"id":"20240611130437-idp1tbk","updated":"20240611130437"},"Children":[{"Type":"NodeText","Data":"甘温有小毒．又曰甘无毒．"}]},{"ID":"20240611130437-d1kadql","Type":"NodeParagraph","Properties":{"id":"20240611130437-d1kadql","updated":"20240611130437"},"Children":[{"Type":"NodeText","Data":"【主治】"}]},{"ID":"20240611130437-pkhfdkw","Type":"NodeParagraph","Properties":{"id":"20240611130437-pkhfdkw","updated":"20240611130437"},"Children":[{"Type":"NodeText","Data":"风头寒痛．风湿周痹．四肢拘挛痛．恶肉死肌．膝痛．久服益气．治肝热明目．治一切风气．填髓．暖腰脚．治瘰 疮疥及瘙痒．炒香浸酒服．去风补益．"}]},{"ID":"20240611130437-d99s0y6","Type":"NodeParagraph","Properties":{"id":"20240611130437-d99s0y6","updated":"20240611130437"},"Children":[{"Type":"NodeText","Data":"【忌】（猪肉 马肉 米泔害人）"}]},{"ID":"20240611130528-yea3u7z","Type":"NodeThematicBreak","Properties":{"id":"20240611130528-yea3u7z"}},{"ID":"20240611130529-6ua5n86","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130529-6ua5n86","updated":"20240611130534"},"Children":[{"Type":"NodeText","Data":"苍耳子《本草求真》"}]},{"ID":"20240611130529-2341c6d","Type":"NodeParagraph","Properties":{"id":"20240611130529-2341c6d","updated":"20240611130529"},"Children":[{"Type":"NodeText","Data":"（隰草）祛肝风除脾湿活血通气"}]},{"ID":"20240611130529-t4irfuv","Type":"NodeParagraph","Properties":{"id":"20240611130529-t4irfuv","updated":"20240611130529"},"Children":[{"Type":"NodeText","Data":"苍耳子（专入肝脾）。味苦而甘。气温无毒。凡人风湿内淫。气血阻滞。（肝受风则血阻。脾受湿则气滞。）则上而脑顶。下而足膝。内而骨髓。外而皮肤。靡不病症悉形。而致症见疥癣。通身周痹。四肢拘挛。骨节痈肿。顶巅风痛。疳虫湿 。恶肉死肌。疔肿痔漏。腰重膝屈。按此苦能燥湿。温能通活。为祛风疗湿之圣药。或作膏。（如采根叶。根名万应膏。）或作汤浴。自然风除湿祛。血活气行。而病即愈。但此通顶连脑。下达督脉。服此最忌猪肉。（猪肉动风助湿。）及风邪触犯。则遍身发出赤丹。而致病益增甚耳。去刺。酒拌蒸用。"}]},{"ID":"20240611130505-ncka9k4","Type":"NodeThematicBreak","Properties":{"id":"20240611130505-ncka9k4"}},{"ID":"20240611130506-v1p4e4k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130506-v1p4e4k","updated":"20240611130511"},"Children":[{"Type":"NodeText","Data":"苍耳子《本草备要》"}]},{"ID":"20240611130506-beysh2q","Type":"NodeParagraph","Properties":{"id":"20240611130506-beysh2q","updated":"20240611130512"},"Children":[{"Type":"NodeText","Data":"一名 耳，即诗卷耳"}]},{"ID":"20240611130506-3hyj618","Type":"NodeParagraph","Properties":{"id":"20240611130506-3hyj618","updated":"20240611130506"},"Children":[{"Type":"NodeText","Data":"轻，发汗，散风湿"}]},{"ID":"20240611130506-4x5zmo3","Type":"NodeParagraph","Properties":{"id":"20240611130506-4x5zmo3","updated":"20240611130506"},"Children":[{"Type":"NodeText","Data":"甘苦性温。善发汗散风湿，上通脑顶，下行足膝，外达皮肤。"}]},{"ID":"20240611130506-xt8vueh","Type":"NodeParagraph","Properties":{"id":"20240611130506-xt8vueh","updated":"20240611130506"},"Children":[{"Type":"NodeText","Data":"治头痛目暗，齿痛鼻渊，肢挛痹痛，瘰 疮疥（采根叶熬，名万应膏），遍身瘙痒（作浴汤佳）。"}]},{"ID":"20240611130506-ommw0pz","Type":"NodeParagraph","Properties":{"id":"20240611130506-ommw0pz","updated":"20240611130506"},"Children":[{"Type":"NodeText","Data":"去刺，酒拌蒸。忌猪肉（《圣惠方》云∶叶捣汁，治产后痢）。"}]},{"ID":"20240611130448-r7spbm2","Type":"NodeThematicBreak","Properties":{"id":"20240611130448-r7spbm2"}},{"ID":"20240611130449-ni1yzac","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130449-ni1yzac","updated":"20240611130454"},"Children":[{"Type":"NodeText","Data":"苍耳子《本草崇原》"}]},{"ID":"20240611130449-8eun0ww","Type":"NodeParagraph","Properties":{"id":"20240611130449-8eun0ww","updated":"20240611130449"},"Children":[{"Type":"NodeText","Data":"气味甘温，有小毒。主治风头寒痛，风湿周痹，四肢拘挛痛，恶肉死肌，膝痛。久服益气。"}]},{"ID":"20240611130449-pzykfa9","Type":"NodeParagraph","Properties":{"id":"20240611130449-pzykfa9","updated":"20240611130449"},"Children":[{"Type":"NodeText","Data":"（《诗》名卷耳。《本经》名 耳。处处有之，七八月开细白花，结实如妇女珥 ，外壳坚韧，刺毛密布，生青熟黄，中列两仁，其色黄白，嫩苗熟食可以救饥，其仁炒，去皮研为面，可作烧饼食。）"}]},{"ID":"20240611130449-hr1sr6m","Type":"NodeParagraph","Properties":{"id":"20240611130449-hr1sr6m","updated":"20240611130449"},"Children":[{"Type":"NodeText","Data":"苍耳《本经》名 耳，该茎叶而言也。今时用实，名苍耳子，子内仁肉，气味甘温，外多毛刺，故有小毒，花白实黄，禀阳明燥金之气。金能制风，故主治风头寒痛，谓头受风邪，为寒为痛也。燥能胜湿，故主治风湿周痹，四肢拘挛痛，谓风湿之邪，伤周身血脉而为痹，淫于四肢而为拘挛疼痛也。夫周痹，则周身血脉不和，周痹可治，则恶肉死肌，亦可治也。四肢拘挛痛可治，则膝痛亦可治也。久服则风湿外散，经脉流通，故益气。"}]},{"ID":"20240611125941-apomfg7","Type":"NodeThematicBreak","Properties":{"id":"20240611125941-apomfg7"}},{"ID":"20240611130117-pd770vn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130117-pd770vn","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"《中国药典》：苍耳子"}]},{"ID":"20240611130117-eekqphq","Type":"NodeParagraph","Properties":{"id":"20240611130117-eekqphq","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611130117-2uwkohn","Type":"NodeParagraph","Properties":{"id":"20240611130117-2uwkohn","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" Cānɡ ěr Zǐ"}]},{"ID":"20240611130117-is8xcq6","Type":"NodeParagraph","Properties":{"id":"20240611130117-is8xcq6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611130117-cb6afyf","Type":"NodeParagraph","Properties":{"id":"20240611130117-cb6afyf","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 苍耳、老苍子、苍子、葈耳、苍刺头、毛苍子、痴头猛、羊带归"}]},{"ID":"20240611130117-gs7dzew","Type":"NodeParagraph","Properties":{"id":"20240611130117-gs7dzew","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611130117-r7qc774","Type":"NodeParagraph","Properties":{"id":"20240611130117-r7qc774","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" FRUCTUS XANTHII"}]},{"ID":"20240611130117-1vklcz6","Type":"NodeParagraph","Properties":{"id":"20240611130117-1vklcz6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611130117-9t8agok","Type":"NodeParagraph","Properties":{"id":"20240611130117-9t8agok","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苍耳"},{"Type":"NodeText","Data":"Xanthium sibiricum Patr.的干燥成熟"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带总苞的果实"},{"Type":"NodeText","Data":"。秋季果实成熟时采收，干燥，除去梗、叶等杂质。全草亦可入药。"}]},{"ID":"20240611130117-x174w4i","Type":"NodeParagraph","Properties":{"id":"20240611130117-x174w4i","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611130117-jgo4ncf","Type":"NodeParagraph","Properties":{"id":"20240611130117-jgo4ncf","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 本品呈纺锤形或卵圆形，长1～1.5cm，直径0.4～0.7cm。表面黄棕色或黄绿色，全体有钩刺，顶端有2枚较粗的刺，分离或相连，基部有果梗痕。质硬而韧，横切面中央有纵隔膜，2室，各有1枚瘦果。瘦果略呈纺锤形，一面较平坦，顶端具1突起的花柱基，果皮薄，灰黑色，具纵纹。种皮膜质，浅灰色，子叶2，有油性。气微，味微苦。"}]},{"ID":"20240611130117-i3acn07","Type":"NodeParagraph","Properties":{"id":"20240611130117-i3acn07","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611130117-ze1ynfx","Type":"NodeParagraph","Properties":{"id":"20240611130117-ze1ynfx","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 苍耳幼苗有剧毒！切勿采食。苍耳的茎叶中皆有对神经及肌肉有毒的物质。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中毒后"},{"Type":"NodeText","Data":"全身无力、头晕、恶心、呕吐、腹痛、便闭、呼吸困难、烦躁不安、手脚发凉、脉搏慢。严重者出现黄疸、鼻衄，甚至昏迷，体温下降，血压忽高忽低，或者有广泛性出血，最后因呼吸、循环衰竭而死亡。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解救方法："},{"Type":"NodeText","Data":"轻度中毒者应暂停饮食数小时至一天，在此期间大量喝糖水。严重者早期可洗胃，导泻及用2％生理盐水高位贯肠，同时注射25％葡萄糖液，加维生素C500毫升；预防出血，可注射维生素K及芦丁；必要时考虑输血浆；保护肝脏；可服枸橼酸胆碱，肌肉注射甲硫氨基酸；低脂饮食。民间也有用甘草绿豆汤解毒的可配合使用。"}]},{"ID":"20240611130117-flwmfva","Type":"NodeParagraph","Properties":{"id":"20240611130117-flwmfva","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611130117-ctd9yjy","Type":"NodeParagraph","Properties":{"id":"20240611130117-ctd9yjy","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240611130117-g779kvi","Type":"NodeParagraph","Properties":{"id":"20240611130117-g779kvi","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611130117-rm3puzi","Type":"NodeParagraph","Properties":{"id":"20240611130117-rm3puzi","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苍耳子"},{"Type":"NodeText","Data":"：除去杂质。"}]},{"ID":"20240611130117-pm8o8xj","Type":"NodeParagraph","Properties":{"id":"20240611130117-pm8o8xj","updated":"20240611130117"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒苍耳子"},{"Type":"NodeText","Data":"：取净苍耳子，照清炒法（附录Ⅱ D）炒至黄褐色，去刺，筛净。"}]},{"ID":"20240611130117-l03l0dd","Type":"NodeParagraph","Properties":{"id":"20240611130117-l03l0dd","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611130117-3v4sdn0","Type":"NodeParagraph","Properties":{"id":"20240611130117-3v4sdn0","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 归肺经。"}]},{"ID":"20240611130117-mqdm7p2","Type":"NodeParagraph","Properties":{"id":"20240611130117-mqdm7p2","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611130117-uh3p7rl","Type":"NodeParagraph","Properties":{"id":"20240611130117-uh3p7rl","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 辛、苦，温；有毒。"}]},{"ID":"20240611130117-naxp84i","Type":"NodeParagraph","Properties":{"id":"20240611130117-naxp84i","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611130117-98tj767","Type":"NodeParagraph","Properties":{"id":"20240611130117-98tj767","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 苍耳子：散风除湿，通鼻窍。用于风寒头痛，鼻渊流涕，风疹瘙痒，湿痹拘挛。"}]},{"ID":"20240611130117-oqqgb0b","Type":"NodeParagraph","Properties":{"id":"20240611130117-oqqgb0b","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"苍耳草：子宫出血，深部脓肿，麻风，皮肤湿疹。"}]},{"ID":"20240611130117-6sexd5m","Type":"NodeParagraph","Properties":{"id":"20240611130117-6sexd5m","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611130117-tl2eun5","Type":"NodeParagraph","Properties":{"id":"20240611130117-tl2eun5","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 苍耳子3～9g；苍耳草1～2两。"}]},{"ID":"20240611130117-9pjmisp","Type":"NodeParagraph","Properties":{"id":"20240611130117-9pjmisp","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611130117-fukh9fg","Type":"NodeParagraph","Properties":{"id":"20240611130117-fukh9fg","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苍耳蠹虫"},{"Type":"NodeText","Data":"为寄生于苍耳草茎中髓部的一种小虫。外用治疔疮。取苍耳蠹虫浸麻油中，用时取出虫2～3条，捣烂外敷。"}]},{"ID":"20240611130117-zqnmrrx","Type":"NodeParagraph","Properties":{"id":"20240611130117-zqnmrrx","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611130117-la5k3ow","Type":"NodeParagraph","Properties":{"id":"20240611130117-la5k3ow","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240611130117-363zdve","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130117-363zdve","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：苍耳子"}]},{"ID":"20240611130117-ex8bk22","Type":"NodeParagraph","Properties":{"id":"20240611130117-ex8bk22","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611130117-gv73jpw","Type":"NodeParagraph","Properties":{"id":"20240611130117-gv73jpw","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" Cānɡ ěr Zǐ"}]},{"ID":"20240611130117-b0luym5","Type":"NodeParagraph","Properties":{"id":"20240611130117-b0luym5","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611130117-ozn90go","Type":"NodeParagraph","Properties":{"id":"20240611130117-ozn90go","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 枱耳实（《本经》），牛虱子（《贵州民间方药集》），胡寝子（《药材资料汇编》），苍郎种、棉螳螂（《江苏植药志》），苍子、胡苍子（《东北药植志》），饿虱子（《广西中药志》），苍棵子、苍耳蒺藜（《陕西中草药》）。"}]},{"ID":"20240611130117-xone6dl","Type":"NodeParagraph","Properties":{"id":"20240611130117-xone6dl","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611130117-3kwyi5a","Type":"NodeParagraph","Properties":{"id":"20240611130117-3kwyi5a","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 《千金·食治》"}]},{"ID":"20240611130117-y0sjznz","Type":"NodeParagraph","Properties":{"id":"20240611130117-y0sjznz","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611130117-ycsy1gj","Type":"NodeParagraph","Properties":{"id":"20240611130117-ycsy1gj","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"苍耳"},{"Type":"NodeText","Data":"带"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"总苞的果实"},{"Type":"NodeText","Data":"。8～9月间果实成熟时摘下晒干；或割取全株，打下果实，除净杂质，晒干。"}]},{"ID":"20240611130117-hkx3h4y","Type":"NodeParagraph","Properties":{"id":"20240611130117-hkx3h4y","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611130117-004evva","Type":"NodeParagraph","Properties":{"id":"20240611130117-004evva","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 全国各地均产。主产山东、江西、湖北、江苏等地。"}]},{"ID":"20240611130117-cg3al3i","Type":"NodeParagraph","Properties":{"id":"20240611130117-cg3al3i","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611130117-mro1fwj","Type":"NodeParagraph","Properties":{"id":"20240611130117-mro1fwj","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 干燥带总苞的果实呈纺锤形成椭圆形，长约1～1.7厘米，直径4～7毫米。表面黄绿色、棕绿色或暗棕色，着生多数长约2毫米的钩刺。一端有2根较粗大的尖刺，分离或相连，外皮（总苞）坚韧，内分2室，各藏1个小瘦果。瘦果略呈纺锤形，一面较平坦，果皮灰黑色，纸质，一端具1刺状突起的柱基；种子浅灰色，种皮膜质，内有子叶2片，胚根位于尖端。气微弱，味微苦、油样。以粒大饱满色黄绿者为佳。"}]},{"ID":"20240611130117-2j5nk0y","Type":"NodeParagraph","Properties":{"id":"20240611130117-2j5nk0y","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611130117-hnghcid","Type":"NodeParagraph","Properties":{"id":"20240611130117-hnghcid","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 我国北方某些地区，偶有误食苍耳子或苍耳子芽而引起中毒者。服苍耳子有生吃的，有炒熟或煮热的，也有、水煮后喝汤的。服食量最少的仅5～6粒（儿童），多的达3000克；服苍耳子芽50～2000克不等。中毒反应轻重不一。一般有头晕、头痛、懒动、食欲减退、恶心、呕吐、腹痛、腹泻，或发热、颜面潮红、结膜充血、荨麻疹等；严重者可出现烦躁不安或终日昏沉嗜睡，进而昏迷、抽搐，心动过缓，血压升高，黄疸，肝肿大，肝功能损害，出血，尿常规改变或少尿，眼睑浮肿等。乃因中枢神经系统、心血管系统及肝脏、肾脏损害所致。中毒者如能及时而有效的进行救治，大多能迅速恢复。少数中毒严重或抢救不及时者，可因肝细胞大量坏死而致肝昏迷，以及肾功能衰竭或呼吸衰竭而死亡。"}]},{"ID":"20240611130117-y6kbuxv","Type":"NodeParagraph","Properties":{"id":"20240611130117-y6kbuxv","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611130117-e8wyo1z","Type":"NodeParagraph","Properties":{"id":"20240611130117-e8wyo1z","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 果实含苍耳子甙1.2％、树脂3.3％，以及脂肪油、生物碱、维生素C和色素等。干燥果实含脂肪油9.2％，其脂肪酸中亚油酸占64.20％、油酸26.8％，棕榈酸5.32％、硬脂酸3.63％。不皂化物中有蜡醇，β-，γ-，和ε-谷甾醇，丙酮不溶脂中卵磷脂占33.2％，脑磷脂占66.8％。"}]},{"ID":"20240611130117-qh4aqr0","Type":"NodeParagraph","Properties":{"id":"20240611130117-qh4aqr0","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"种仁含水6～7％，脂肪油40％，其脂肪酸组成为亚油酸64.8％、油酸26.7％、硬脂酸7.0～7.5％、棕榈酸1.5～2.0％，并含β-谷甾醇和豆甾醇。种壳含戊聚糖15.86％，可作制糠醛的原料。"}]},{"ID":"20240611130117-x5atosi","Type":"NodeParagraph","Properties":{"id":"20240611130117-x5atosi","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611130117-sgceuwx","Type":"NodeParagraph","Properties":{"id":"20240611130117-sgceuwx","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 苍耳子有毒。经分析，苍耳子油（曾加热到120’C）及其所含蛋白质（不溶于水且在提取过程中变性者）无明显毒性，而从脱脂部分制得的水浸剂毒性很大。从水浸剂中分离出一种甙类，可能是苍耳子的主要毒性成分。水浸泡后之残渣则毒性减少或无毒性。经高热处理后，如炒焦炭化，可破坏其毒性。小鼠1次腹腔注射半数致死量为0.93克／公斤，大鼠、小鼠、豚鼠及家兔对不同途径给药的中毒表现基本相同，如活动减少，对外界刺激反应迟钝，呼吸不规则，死前呼吸极度困难，伴有阵发性惊厥。病理组织学检查，发现各种动物中毒后损害的主要脏器，除程度上的差异外，基本病变相同。肝脏退行性变或坏死；肾脏曲管上皮浊肿，管腔内有蛋白管型；肺和脑充血、水肿，心脏轻度浊肿。其中肝损害最为严重，与四氯化碳损害相似，故认为种仁浸剂中毒的主要原因为肝脏坏死，继发的脑组织水肿所致的惊厥，可能为死亡的直接原因。异丙嗪对中毒的家兔及豚鼠有预防及治疗的效果。磷脂、dl-甲硫氨基酸、胱氨酸、维生素C，维生素K3、维生素B12、苯海拉明、氨茶碱或葡萄糖亦有一定的效果。士的宁对家兔亦有一定疗效。阿托品、可拉明、氯丙嗪、巴比妥及去甲肾上腺素等则无效。也有人认为，动物中毒后发生的强烈阵发性惊厥，与苍耳子中所含的甙类物质使血糖显著的降低有关，注射大量葡萄糖，可缓解惊厥并延长寿命。苍耳子作成的酊剂能增强蛙的呼吸运动。大量即抑制呼吸。"}]},{"ID":"20240611130117-ix4w8ja","Type":"NodeParagraph","Properties":{"id":"20240611130117-ix4w8ja","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"苍耳子煎剂在体外对金黄色葡萄球菌有某些抑菌作用，其丙酮或乙醇提取物在体外对红色毛癣菌也有抑菌作用。"}]},{"ID":"20240611130117-ml1m9by","Type":"NodeParagraph","Properties":{"id":"20240611130117-ml1m9by","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611130117-w7wuk7m","Type":"NodeParagraph","Properties":{"id":"20240611130117-w7wuk7m","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 拣尽杂质，去刺，筛去灰屑，微炒至黄色，取出放凉。"}]},{"ID":"20240611130117-glv88oa","Type":"NodeParagraph","Properties":{"id":"20240611130117-glv88oa","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611130117-jn3uhck","Type":"NodeParagraph","Properties":{"id":"20240611130117-jn3uhck","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 入肺、肝经。"}]},{"ID":"20240611130117-e7rlfqd","Type":"NodeParagraph","Properties":{"id":"20240611130117-e7rlfqd","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肺经。\""}]},{"ID":"20240611130117-8pfpqwy","Type":"NodeParagraph","Properties":{"id":"20240611130117-8pfpqwy","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"②《玉楸药解》：\"入足厥阴肝经。\""}]},{"ID":"20240611130117-uehyv3e","Type":"NodeParagraph","Properties":{"id":"20240611130117-uehyv3e","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"③《本草求真》：\"入肝、脾。\""}]},{"ID":"20240611130117-xxu78q1","Type":"NodeParagraph","Properties":{"id":"20240611130117-xxu78q1","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"④《会约医镜》：\"入肝、肾二经。\""}]},{"ID":"20240611130117-r1ekf1f","Type":"NodeParagraph","Properties":{"id":"20240611130117-r1ekf1f","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611130117-kuguevo","Type":"NodeParagraph","Properties":{"id":"20240611130117-kuguevo","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 甘，温，有毒。"}]},{"ID":"20240611130117-3m35uf6","Type":"NodeParagraph","Properties":{"id":"20240611130117-3m35uf6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，温。\""}]},{"ID":"20240611130117-7h3z0s0","Type":"NodeParagraph","Properties":{"id":"20240611130117-7h3z0s0","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦。\""}]},{"ID":"20240611130117-j14aj1y","Type":"NodeParagraph","Properties":{"id":"20240611130117-j14aj1y","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"③《品汇精要》：\"味苦甘，性温，有小毒。\""}]},{"ID":"20240611130117-z93rp3z","Type":"NodeParagraph","Properties":{"id":"20240611130117-z93rp3z","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611130117-iu7we93","Type":"NodeParagraph","Properties":{"id":"20240611130117-iu7we93","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 血虚之头痛、痹痛忌服。"}]},{"ID":"20240611130117-3ls8ptk","Type":"NodeParagraph","Properties":{"id":"20240611130117-3ls8ptk","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"①《唐本草》：\"忌猪肉、马肉、米泔。\""}]},{"ID":"20240611130117-4v55npr","Type":"NodeParagraph","Properties":{"id":"20240611130117-4v55npr","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"散气耗血，虚人勿服。\""}]},{"ID":"20240611130117-5eimum5","Type":"NodeParagraph","Properties":{"id":"20240611130117-5eimum5","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611130117-rgmfxth","Type":"NodeParagraph","Properties":{"id":"20240611130117-rgmfxth","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 散风，止痛，祛湿，杀虫。治风寒头痛，鼻渊，齿痛，风寒湿痹，四肢挛痛，疥癞，瘙痒。"}]},{"ID":"20240611130117-cf140z6","Type":"NodeParagraph","Properties":{"id":"20240611130117-cf140z6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"①《本经》；\"主风头寒痛，风湿周痹，四肢拘挛痛，恶肉死肌。\""}]},{"ID":"20240611130117-yydhm1o","Type":"NodeParagraph","Properties":{"id":"20240611130117-yydhm1o","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"②《本草拾遗》：\"浸酒去风，补益。\""}]},{"ID":"20240611130117-xnbcn9e","Type":"NodeParagraph","Properties":{"id":"20240611130117-xnbcn9e","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治一切风气，填髓，暖腰脚。治瘰疬、疥癣及瘙痒。\""}]},{"ID":"20240611130117-pqcwfpy","Type":"NodeParagraph","Properties":{"id":"20240611130117-pqcwfpy","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"④《本草蒙筌》：\"止头痛善通顶门，追风毒任在骨髓，杀疳虫湿匿。\""}]},{"ID":"20240611130117-ac6rkuw","Type":"NodeParagraph","Properties":{"id":"20240611130117-ac6rkuw","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"治鼻渊。\""}]},{"ID":"20240611130117-o1r6ehv","Type":"NodeParagraph","Properties":{"id":"20240611130117-o1r6ehv","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑥《本草备要》：\"善发汗，散风湿，上通脑顶，下行足膝，外达皮肤。治头痛，目暗，齿痛，鼻渊，去刺，\""}]},{"ID":"20240611130117-fpbn8bj","Type":"NodeParagraph","Properties":{"id":"20240611130117-fpbn8bj","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑦《玉楸药解》：\"消肿开痹，泄风去湿。治疥疠风瘙瘾疹。\""}]},{"ID":"20240611130117-645xwsm","Type":"NodeParagraph","Properties":{"id":"20240611130117-645xwsm","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑧《要药分剂》：\"治鼻息。\""}]},{"ID":"20240611130117-bapnguu","Type":"NodeParagraph","Properties":{"id":"20240611130117-bapnguu","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑨《会约医镜》：\"疗诸痔。\""}]},{"ID":"20240611130117-xueoq5p","Type":"NodeParagraph","Properties":{"id":"20240611130117-xueoq5p","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑩《本草再新》：\"治目痛。\""}]},{"ID":"20240611130117-4co24px","Type":"NodeParagraph","Properties":{"id":"20240611130117-4co24px","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611130117-nr2xl0h","Type":"NodeParagraph","Properties":{"id":"20240611130117-nr2xl0h","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 煎汤，1.5～3钱；或入丸、散。"}]},{"ID":"20240611130117-lry2y9c","Type":"NodeParagraph","Properties":{"id":"20240611130117-lry2y9c","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611130117-ywghu6x","Type":"NodeParagraph","Properties":{"id":"20240611130117-ywghu6x","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" ①治诸风眩晕，或头脑攻痛：苍耳仁三两，天麻、白菊花各三钱。（《本草汇言》）"}]},{"ID":"20240611130117-3fbybf5","Type":"NodeParagraph","Properties":{"id":"20240611130117-3fbybf5","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"②除风湿痹，四肢拘挛：苍耳子三两。捣末，以水一升半，煎取七合，去滓呷。（《食医心镜》）"}]},{"ID":"20240611130117-c7t1kh2","Type":"NodeParagraph","Properties":{"id":"20240611130117-c7t1kh2","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"③治大麻风：苍术一斤，苍耳子三两。各为末，米饭为丸，如梧子大。日三服，每服二钱。忌房事三月。（《洞天奥旨》）"}]},{"ID":"20240611130117-3uuwjw5","Type":"NodeParagraph","Properties":{"id":"20240611130117-3uuwjw5","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"④治疥癞，消风散毒：苍耳子炒蚬肉食。（《生草药性备要》）"}]},{"ID":"20240611130117-716g413","Type":"NodeParagraph","Properties":{"id":"20240611130117-716g413","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑤治妇人风瘙瘾疹，身痒不止：苍耳花、叶、子等分，捣细罗为末。每服以豆淋酒调下二钱。（《圣惠方》）"}]},{"ID":"20240611130117-v66m84w","Type":"NodeParagraph","Properties":{"id":"20240611130117-v66m84w","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑥治鼻流浊涕不止：辛夷半两，苍耳子二钱半，香白芷一两，薄荷叶半钱。上并晒干，为细末。每服二钱，用葱、茶清食后调服。（《济生方》苍耳散）"}]},{"ID":"20240611130117-xk6d5ms","Type":"NodeParagraph","Properties":{"id":"20240611130117-xk6d5ms","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑦治目睹、耳鸣：苍耳子半分。捣烂，以水二升，绞滤取汁，和粳米半两煮粥食之，或作散煎服。（《圣惠方》苍耳子粥）"}]},{"ID":"20240611130117-z2mbuhx","Type":"NodeParagraph","Properties":{"id":"20240611130117-z2mbuhx","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑧治牙疼：苍耳子五升，以水一斗，煮取五升，热含之，疼则吐，吐复含。无子，茎、叶皆得用之。（《千金翼方》）"}]},{"ID":"20240611130117-9rlf74k","Type":"NodeParagraph","Properties":{"id":"20240611130117-9rlf74k","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑨治疔疮恶毒：苍耳子五钱。微炒为末，黄酒冲服；并用鸡子清涂患处，疔根拔出。（《经验广集》苍耳酒）"}]},{"ID":"20240611130117-do9l2wb","Type":"NodeParagraph","Properties":{"id":"20240611130117-do9l2wb","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611130117-afm0tr4","Type":"NodeParagraph","Properties":{"id":"20240611130117-afm0tr4","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" ①治疗腰腿痛"}]},{"ID":"20240611130117-cnez6t4","Type":"NodeParagraph","Properties":{"id":"20240611130117-cnez6t4","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"将苍耳子制成30％针剂，每次用2～4毫升于痛点注射，隔日1次，10次为一疗程。用于腰部扭伤、腰肌劳损，坐骨神经痛、肥大性腰椎炎、腰椎隐裂等引起的腰腿痛计163例，总有效率达89％。奏效快者1次注射后即减轻，一般3～5次奏效。对急性腰部扭伤或腰肌苈损疗效较好；对由于骶椎隐裂及肥大性腰椎炎所致的腰痛，疗效不稳定。"}]},{"ID":"20240611130117-6k2jz6l","Type":"NodeParagraph","Properties":{"id":"20240611130117-6k2jz6l","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"②治疗变态反应性鼻炎"}]},{"ID":"20240611130117-o8bh1r7","Type":"NodeParagraph","Properties":{"id":"20240611130117-o8bh1r7","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"用药后多数患者症状消失或改善，或发作减少。鼻腔粘膜除少数由苍白变为轻度充血外，多数未发现明显变化。用法：苍耳子焙成深棕色后研粉，每次3～5克，日服3次，连服2周。或将粉末与蜂蜜混合制成丸剂（每丸含药粉3克），每次1～2丸，日服3次，连服2周，必要时可服3周至2个月。亦可将药粉用酒精浸提制成片剂（每片相当于原生药1.5克左右），每服2片，每日3次，连服2周左右。少数患者服药后有轻度腹泻、腹胀痛，以及轻微头痛、全身无力等。"}]},{"ID":"20240611130117-yfnd5v5","Type":"NodeParagraph","Properties":{"id":"20240611130117-yfnd5v5","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"③治疗慢性鼻炎"}]},{"ID":"20240611130117-yqr6377","Type":"NodeParagraph","Properties":{"id":"20240611130117-yqr6377","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"取苍耳子30～40个，轻轻捶破，放入清洁小铝杯中，加麻油1两，文火煮开，去苍耳，待冷后，倾入小瓶中备用。用时以棉签饱蘸药油涂鼻腔，每日2～3次，两周为一疗程。治疗207例，除3例无效、12例未坚持用药外，余均治愈，临床症状完全消失。随访时间最长的已达3年，未见复发。"}]},{"ID":"20240611130117-761wfe8","Type":"NodeParagraph","Properties":{"id":"20240611130117-761wfe8","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"④治疗疟疾"}]},{"ID":"20240611130117-7msujmk","Type":"NodeParagraph","Properties":{"id":"20240611130117-7msujmk","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"鲜苍耳子3两，洗净捣烂，加水煎15分钟，去渣，打入鸡蛋2～3个于药液内煮熟。于疟疾发作前将蛋与药液一次服下。如1次未愈，可按上法再服。"}]},{"ID":"20240611130117-4he09qc","Type":"NodeParagraph","Properties":{"id":"20240611130117-4he09qc","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑤治疗腮腺炎"}]},{"ID":"20240611130117-cw4zrgb","Type":"NodeParagraph","Properties":{"id":"20240611130117-cw4zrgb","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"苍耳子加水煎服，每日4次，连服3天。新生儿每天1钱，1～2岁1.5钱，以后每大2岁增加1.5钱，14岁以上1～1.5两。一般轻症服2～3天即可，重症可配合苍耳草叶捣敷患处。有合并症者宜配合其它疗法处理"}]},{"ID":"20240611130117-d41vzvp","Type":"NodeParagraph","Properties":{"id":"20240611130117-d41vzvp","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"⑥治疗下肢溃疡"}]},{"ID":"20240611130117-c5dzyjo","Type":"NodeParagraph","Properties":{"id":"20240611130117-c5dzyjo","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"苍耳子炒黄研末2～4两，生猪板油4～6两，共捣如糊状。用时先用石灰水（石灰1斤，加开水8斤冲泡，静置1小时吸取上清液）洗净创面，揩干后涂上药膏，外用绷带包扎。冬季5～7天；夏季3天更换敷料"}]},{"ID":"20240611130117-x3vlg60","Type":"NodeParagraph","Properties":{"id":"20240611130117-x3vlg60","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611130117-88ilvpz","Type":"NodeParagraph","Properties":{"id":"20240611130117-88ilvpz","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611130117-zaw45fm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611130117-zaw45fm","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"《中华本草》：苍耳子"}]},{"ID":"20240611130117-fw0q68v","Type":"NodeParagraph","Properties":{"id":"20240611130117-fw0q68v","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611130117-c5zgydn","Type":"NodeParagraph","Properties":{"id":"20240611130117-c5zgydn","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" Shēnɡ ěr Zǐ"}]},{"ID":"20240611130117-v4u7odm","Type":"NodeParagraph","Properties":{"id":"20240611130117-v4u7odm","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611130117-irvnzt6","Type":"NodeParagraph","Properties":{"id":"20240611130117-irvnzt6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 葈耳实、牛虱子、胡寝子、苍郎种、棉螳螂、苍子、胡苍子、饿虱子、苍棵子、苍耳蒺藜、苍浪子、老苍子"}]},{"ID":"20240611130117-iac9qou","Type":"NodeParagraph","Properties":{"id":"20240611130117-iac9qou","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611130117-zpepzfw","Type":"NodeParagraph","Properties":{"id":"20240611130117-zpepzfw","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" Siberian Cocklour Fruit, Fruit of Siberian Cocklebur"}]},{"ID":"20240611130117-e96s0nr","Type":"NodeParagraph","Properties":{"id":"20240611130117-e96s0nr","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611130117-9htlv2k","Type":"NodeParagraph","Properties":{"id":"20240611130117-9htlv2k","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 出自《千金·食治》。"}]},{"ID":"20240611130117-1ezbylj","Type":"NodeParagraph","Properties":{"id":"20240611130117-1ezbylj","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"《南方主要有毒植物》：苍耳，有毒部位，全株；以果实为最毒；鲜叶比干叶毒，嫩叶比老叶毒。中毒解救方法：轻度中毒者应暂停饮食数小时至一天，在此期间大量喝糖水。严重者早期可洗胃、导泻及用2%生理盐水高位灌肠，同时注射25%葡萄糖液，加维生素C500mg；预防出血可注射维生素K；必要时考虑输血浆；保护肝脏，可服枸橼酸胆碱，肌肉注射甲硫氨基酸；低脂饮食。民间用甘草绿豆汤解毒。"}]},{"ID":"20240611130117-5gt90zh","Type":"NodeParagraph","Properties":{"id":"20240611130117-5gt90zh","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611130117-bw4wibr","Type":"NodeParagraph","Properties":{"id":"20240611130117-bw4wibr","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 药材基源：为菊科植物苍耳工蒙古苍耳带总苞的果实。"}]},{"ID":"20240611130117-ilyx773","Type":"NodeParagraph","Properties":{"id":"20240611130117-ilyx773","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Xanthium sibiricum Patrin.ex Widder Xanthium mongolicum Kitag."}]},{"ID":"20240611130117-zs6qwvm","Type":"NodeParagraph","Properties":{"id":"20240611130117-zs6qwvm","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"采收和储藏：9-10月果实成熟，由青转黄，叶已大部分枯萎脱攻时，选晴天，割下全株，脱粒，扬将，晒干。"}]},{"ID":"20240611130117-yrpocw7","Type":"NodeParagraph","Properties":{"id":"20240611130117-yrpocw7","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611130117-s1dl60o","Type":"NodeParagraph","Properties":{"id":"20240611130117-s1dl60o","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于平原、丘陵、低山、荒野、路边、沟旁、田边、草地、村旁等处。"}]},{"ID":"20240611130117-53jucjc","Type":"NodeParagraph","Properties":{"id":"20240611130117-53jucjc","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.生于干旱山坡或砂质荒地。"}]},{"ID":"20240611130117-axzea55","Type":"NodeParagraph","Properties":{"id":"20240611130117-axzea55","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于全国各地。"}]},{"ID":"20240611130117-1j1i8kf","Type":"NodeParagraph","Properties":{"id":"20240611130117-1j1i8kf","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.分布于黑龙江、辽宁、内蒙古及河北。"}]},{"ID":"20240611130117-bvdr9st","Type":"NodeParagraph","Properties":{"id":"20240611130117-bvdr9st","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611130117-pbrnon2","Type":"NodeParagraph","Properties":{"id":"20240611130117-pbrnon2","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 1.苍耳 一年生草本，高20-90cm。根纺锤状，分枝或不分枝。茎直立不分枝或少有分枝，下部圆柱形， 上部有纵沟，被灰白以糙伏毛。叶互生；有长柄，长3-11cm；叶片三角状卵形或心表，长4-9cm，宽5-10cm，的全缘，或有3-5不明显浅裂，先尖或钝，基出三脉，上面绿色，下面苍白色，被粗糙或短白伏毛。头状花序近于无柄，聚生，单性同株；雄花序球形，，总苞片，总苞片小，1列，密生柔生，花托柱状，托片倒披针表，小花管状，先端5齿裂，雄蕊5，花药长圆状线形；雌花序卵形，总苞片2-3列，外列苞片小，内列苞片大，结成囊状卵形，2室的硬体，外面有倒刺毛，顶有2圆锥状的尖端，小花2朵，无花冠，子房在总苞内，每室有1花，花柱线形，突出在总苞外。成熟具瘦果的总苞变墅坚硬，卵形或椭圆形，边同喙部长12-15mm，宽4-7mm，绿色，淡黄色或红褐色，喙长1.5-2.5mm；瘦果2，倒卵形，瘦果内含1颗种子。花花期7-8月，果期9-10月。"}]},{"ID":"20240611130117-r1ymdep","Type":"NodeParagraph","Properties":{"id":"20240611130117-r1ymdep","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.蒙古苍耳 本种与苍耳的区别是：成离的具瘦果的总苞椭圆形，连喙长18-20mm，宽8-10mm，外面具较疏的总苞刺，总苞刺坚硬，刺长2-5.5mm（通常5mm），基部增粗。"}]},{"ID":"20240611130117-dtrdkqm","Type":"NodeParagraph","Properties":{"id":"20240611130117-dtrdkqm","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611130117-5kb6bcx","Type":"NodeParagraph","Properties":{"id":"20240611130117-5kb6bcx","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 果产包在总苞内，呈纺锤形或卵圆形，长1-1.5cm，直径0.4-0.7cm。表面黄棕色或黄绿色，全体有钩刺，先端有较粗的刺2枚，分离或连生，基产有梗痕。质硬而韧，横切面中间有一隔膜，2室，各有1枚瘦果。瘦果略呈纺锤形，一面较平坦，先端具一突起的花柱基，果皮薄，灰黑色，具纵纹。种皮膜质，浅灰色，有纵纹；子叶2，有油性。气微，味微苦。"}]},{"ID":"20240611130117-0cstm07","Type":"NodeParagraph","Properties":{"id":"20240611130117-0cstm07","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"以粒大、饱满、色黄棕者为佳。"}]},{"ID":"20240611130117-0hn3fv2","Type":"NodeParagraph","Properties":{"id":"20240611130117-0hn3fv2","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：在黄色。①纤维众多，成束或单个散在，多数呈细长棱形，长约425μm，直径17μm，壁较薄；少数较短，长约255μm，壁稍厚，有明显的纹孔。②木薄壁细胞（存在于导附近）长方形，长96-120μm,，贡19-24μm，具单孔。③导和少见，网纹导和直径约34μm，螺纹导管直径约12μm。④子叶薄壁细胞含糊粉粒及油滴。⑤种皮薄壁细胞类圆形或长方形，淡黄色。"}]},{"ID":"20240611130117-fbsrwps","Type":"NodeParagraph","Properties":{"id":"20240611130117-fbsrwps","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611130117-g1yh59w","Type":"NodeParagraph","Properties":{"id":"20240611130117-g1yh59w","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 种仁浸剂各种不同途径红药，对大鼠、小鼠、豚鼠及兔的中素表现基本相同，如反应迟钝，死前呼吸极度困难，伴有阵发性惊厥，主要病理改变为肝损害及肾变性，肺和脑充血、水肿，异丙嗪对中毒有解救作用；种仁浸剂对小鼠腹腔注射的LD50为0.93g/kg；苍耳子油及苍耳子蛋白毒性甚小，毒性成分系一种黄色结晶性甙(AA2)，其对小鼠腹腔注射的LD50为100mg/kg。"}]},{"ID":"20240611130117-p86f99u","Type":"NodeParagraph","Properties":{"id":"20240611130117-p86f99u","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611130117-gko0848","Type":"NodeParagraph","Properties":{"id":"20240611130117-gko0848","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 1.苍耳 果产含脂肪油9.2%，其中脂肪酸有：棕榈酸（palmitic acid）5.32%，硬脂酸（stearic acid）3.68%，油酸（oleic acid）26.8%，亚油酸（linoleic acd）64.20%。不皂化物中含蜡醇（ceryl alcohol），βγ及ξ-谷甾醇（sitosterol）。丙酮不溶脂中有卵磷脂（lecithin)33.2%，脑磷脂（cephalin）66.8%。还含苍耳子甙（strumaroside），即是β-谷甾醇-β-D-葡萄糖甙（β-sitos-terol-β-D-glucoside）；葡萄糖（glucose），果糖（fructose），蔗糖（su-crose）；酒石酸（tartaric acid），琥珀酸（succinic acid），延胡索酸（fumaric acid），苹果酸（malic acid），亮氨酸（leucine），苯丙氨酸（phenylalnine），甙氨酸（glycine），天冬氨酸（aspartic acid），天冬酰胺（asparagine）。又含蛋白质，其中氨基酸有：甘氨酸，丝氨酸（serine），天冬氨酸，谷氨酸（glucamic acid），丙氨酸（alanine），缬氨酸（valine），亮氨酸，赖氨酸（lysibne），天冬酰胺，酪氨酸（tyro-sine），苏氨酸（threonine），脯氨酸（proline），粗氨酸（arginine），苯丙氨酸。近又从果中得到1，2，5-三-O-咖啡酰基奎宁酸（1，3，5-tri-O-caffeoylquinic acid），3，5-二-O-咖啡酰基奎宁酸（3，5-di-O-caffeoylquinic acid）。"}]},{"ID":"20240611130117-tcpfk0z","Type":"NodeParagraph","Properties":{"id":"20240611130117-tcpfk0z","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"种仁含脂肪油40%，其中脂肪酸有：棕榈酸1.5%-2.0%，硬脂酸7.0%-7.5%，油酸26.7%，亚油酸64.8%，还含氨醌（hydroquinone），苍术甙（atracyloside）。"}]},{"ID":"20240611130117-ez0xj1l","Type":"NodeParagraph","Properties":{"id":"20240611130117-ez0xj1l","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"种子壳含羟基苍术甙（carboxyatracyloside）。"}]},{"ID":"20240611130117-9njsw8v","Type":"NodeParagraph","Properties":{"id":"20240611130117-9njsw8v","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.蒙古苍耳 种仁中含苍术甙。"}]},{"ID":"20240611130117-6vcv9z6","Type":"NodeParagraph","Properties":{"id":"20240611130117-6vcv9z6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611130117-mgci10o","Type":"NodeParagraph","Properties":{"id":"20240611130117-mgci10o","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 1.降血糖：所含白色结晶性甙(C31H-48O24S2)1mg/kg，可使正常家兔血糖下降。"}]},{"ID":"20240611130117-vg7r2al","Type":"NodeParagraph","Properties":{"id":"20240611130117-vg7r2al","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.对呼吸系统作用：苍耳子100%煎剂0.3ml/只灌胃，对小鼠有镇咳作用；15ml/kg对兔无祛痰作用。酊剂注射，对蛙有呼吸兴奋作用，大剂量则为抑制作用。"}]},{"ID":"20240611130117-x0u1n4t","Type":"NodeParagraph","Properties":{"id":"20240611130117-x0u1n4t","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"3.对心血管作用：苍耳子注射液静注，对兔、犬均有短暂降压作用。"}]},{"ID":"20240611130117-k8xu094","Type":"NodeParagraph","Properties":{"id":"20240611130117-k8xu094","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"4.抗炎作用：本品所含的二萜羟酸苍术甙经大鼠角叉菜胶水肿试验表明有抗炎作用。腹腔注射、皮下注射和口服LD50分别为2.9，5.3和350mg／kg。"}]},{"ID":"20240611130117-8lghmnr","Type":"NodeParagraph","Properties":{"id":"20240611130117-8lghmnr","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"4.苍耳子煎剂在体外对金黄色葡萄球菌有某些抑菌作用，其丙酮或乙醇提取物在体外对红色毛癣菌也有抑菌作用。"}]},{"ID":"20240611130117-30ibrp7","Type":"NodeParagraph","Properties":{"id":"20240611130117-30ibrp7","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"5.毒性：经分析，苍耳子油（曾加热到120℃）及其所含蛋白质（不溶于水且在提取过程中变性者）无明显毒性，而从脱脂部分制得的水浸剂毒性很大。从水浸剂中分离出一种甙类，可能是苍耳子的主要毒性成分。水浸泡后之残渣则毒性减少或无毒性。经高热处理后，如炒焦炭化，可破坏其毒性。小鼠1次腹腔注射半数致死量为0.93g／kg，大鼠、小鼠、豚鼠及家兔对不同途径给药的中毒表现基本相同，如活动减少，对外界刺激反应迟钝，呼吸不规则，死前呼吸极度困难，伴有阵发性惊厥。病理组织学检查，发现各种动物中毒后损害的主要脏器，除程度上的差异外，基本病变相同。肝脏退行性变或坏死；肾脏曲管上皮浊肿，管腔内有蛋白管型；肺和脑充血、水肿，心脏轻度浊肿。其中肝损害最为严重，与四氯化碳损害相似，故认为种仁浸剂中毒的主要原因为肝脏坏死，继发的脑组织水肿所致的惊厥，可能为死亡的直接原因。异丙嗪对中毒的家兔及豚鼠有预防及治疗的效果。磷脂、dl-甲硫氨基酸、胱氨酸、维生素C、维生素K3、维生素B12、苯海拉明、氨茶碱或葡萄糖亦有一定的效果。士的宁对家兔亦有一定疗效。阿托品、可拉明、氯丙嗪、巴比妥及去甲肾上腺素等则无效。也有人认为，动物中毒后发生的强烈阵发性惊厥，与苍耳子中所含的甙类物质使血糖显着的降低有关，注射大量葡萄糖，可缓解惊厥并延长寿命。苍耳子作成的酊剂能增强蛙的呼吸运动，大量即抑制呼吸。"}]},{"ID":"20240611130117-1w5ski7","Type":"NodeParagraph","Properties":{"id":"20240611130117-1w5ski7","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611130117-mg0maqu","Type":"NodeParagraph","Properties":{"id":"20240611130117-mg0maqu","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 拣尽杂质，去刺，筛去灰屑，微炒至黄色，取出放凉。"}]},{"ID":"20240611130117-palqume","Type":"NodeParagraph","Properties":{"id":"20240611130117-palqume","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611130117-cr4uoy6","Type":"NodeParagraph","Properties":{"id":"20240611130117-cr4uoy6","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 归肺；肝经"}]},{"ID":"20240611130117-r8sjgde","Type":"NodeParagraph","Properties":{"id":"20240611130117-r8sjgde","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611130117-ccz5t88","Type":"NodeParagraph","Properties":{"id":"20240611130117-ccz5t88","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 味苦；甘；辛；性温；小毒"}]},{"ID":"20240611130117-xolbbhd","Type":"NodeParagraph","Properties":{"id":"20240611130117-xolbbhd","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611130117-lcngty4","Type":"NodeParagraph","Properties":{"id":"20240611130117-lcngty4","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 1.血虚之头痛、痹痛忌服。"}]},{"ID":"20240611130117-q703u36","Type":"NodeParagraph","Properties":{"id":"20240611130117-q703u36","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：忌猪肉、马肉、米泔。"}]},{"ID":"20240611130117-x2g87h3","Type":"NodeParagraph","Properties":{"id":"20240611130117-x2g87h3","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：散气耗血，虚人勿服。"}]},{"ID":"20240611130117-36vlvfw","Type":"NodeParagraph","Properties":{"id":"20240611130117-36vlvfw","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611130117-ltq5lax","Type":"NodeParagraph","Properties":{"id":"20240611130117-ltq5lax","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 散风寒；通鼻窍；祛风湿；止痒。主鼻渊；风寒头痛；风湿痹痛；风疹；湿疹；疥癣"}]},{"ID":"20240611130117-hak51ai","Type":"NodeParagraph","Properties":{"id":"20240611130117-hak51ai","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611130117-htakhd9","Type":"NodeParagraph","Properties":{"id":"20240611130117-htakhd9","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。外用：适量，捣敷；或煎水洗。"}]},{"ID":"20240611130117-ozomsvg","Type":"NodeParagraph","Properties":{"id":"20240611130117-ozomsvg","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611130117-ngn1d57","Type":"NodeParagraph","Properties":{"id":"20240611130117-ngn1d57","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 1.苍耳子散(《济生方》)，功能散风寒，通利鼻窍，治鼻渊，流黄浊鼻涕，鼻塞不通。2.治麻风方(《洞天和奥旨》)：苍术、苍耳子，各为末，米粒为丸。3.治头痛方(《本草汇言》)：天麻，白菊花，苍耳子，水煎服，治诸风眩晕，或头脑攻痛。4.苍耳子粥(《圣惠方》)：苍耳子，粳米，煮粥或研散煎服，治目暗，耳鸣。"}]},{"ID":"20240611130117-bbxvjhf","Type":"NodeParagraph","Properties":{"id":"20240611130117-bbxvjhf","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611130117-xmn0l1w","Type":"NodeParagraph","Properties":{"id":"20240611130117-xmn0l1w","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主风头寒痛，风湿周痹，四肢拘挛痛，恶肉死肌。"}]},{"ID":"20240611130117-q9zbtvd","Type":"NodeParagraph","Properties":{"id":"20240611130117-q9zbtvd","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：浸酒去风，补益。"}]},{"ID":"20240611130117-968ykhl","Type":"NodeParagraph","Properties":{"id":"20240611130117-968ykhl","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：治一切风气，填髓，暖腰脚。治瘰疬、疥癣及瘙痒。"}]},{"ID":"20240611130117-5asigs7","Type":"NodeParagraph","Properties":{"id":"20240611130117-5asigs7","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"4.《本草蒙筌》：止头痛善通顶门，追风毒任在骨髓，杀疳虫湿NI。"}]},{"ID":"20240611130117-6x3k714","Type":"NodeParagraph","Properties":{"id":"20240611130117-6x3k714","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"5.《本草正》：治鼻渊。"}]},{"ID":"20240611130117-us05dhk","Type":"NodeParagraph","Properties":{"id":"20240611130117-us05dhk","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"6.《本草备要》：善发汗，散风湿，上通脑顶，下行足膝，外达皮肤。治头痛，目暗，齿痛，鼻渊，去刺。"}]},{"ID":"20240611130117-mzcqatd","Type":"NodeParagraph","Properties":{"id":"20240611130117-mzcqatd","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"7.《玉楸药解》：消肿开痹，泄风去湿。治疥疠风瘙瘾疹。"}]},{"ID":"20240611130117-1mo9reg","Type":"NodeParagraph","Properties":{"id":"20240611130117-1mo9reg","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"8.《要药分剂》：治鼻瘜。"}]},{"ID":"20240611130117-y3jepzd","Type":"NodeParagraph","Properties":{"id":"20240611130117-y3jepzd","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"9.《会约医镜》：疗诸痔。"}]},{"ID":"20240611130117-g3oj1nn","Type":"NodeParagraph","Properties":{"id":"20240611130117-g3oj1nn","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"10.《本草再新》：治目痛。"}]},{"ID":"20240611130117-1fh7jur","Type":"NodeParagraph","Properties":{"id":"20240611130117-1fh7jur","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"11.《本草汇言》：枲耳实，通巅顶，去风湿之药也。甘能益血，苦能燥湿，温能通畅，故上中下一身风湿众病不可缺也。"}]},{"ID":"20240611130117-ccmvv7z","Type":"NodeParagraph","Properties":{"id":"20240611130117-ccmvv7z","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"12.《本草正义》：苍耳子，温和疏达，流利关节，宣通脉络，遍及孔窍肌肤而不偏干燥烈，乃主治风寒湿三气痹着之最有力而驯良者。又独能上达巅顶，疏通脑户之风寒，为头风病之要药。而无辛香走窜，升泄过度，耗散正气之虑。以视细辛、羌活等味，功用近似，而异其态度；即例以川芎、白芷等物之以气为胜者，犹难同日而语，但和缓有余，恐未易克日奏功耳。"}]},{"ID":"20240611130117-5wk72pr","Type":"NodeParagraph","Properties":{"id":"20240611130117-5wk72pr","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611130117-r01kn12","Type":"NodeParagraph","Properties":{"id":"20240611130117-r01kn12","updated":"20240611130117"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611130119-54ve510","Type":"NodeThematicBreak","Properties":{"id":"20240611130119-54ve510"}},{"ID":"20240611130120-4oh53o9","Type":"NodeParagraph","Properties":{"id":"20240611130120-4oh53o9"}}]}