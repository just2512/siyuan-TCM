{"ID":"20240504170627-dbshdwf","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504170627-dbshdwf","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504170627-dbshdwf\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504170627-em6ajyx\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240504170627-em6ajyx\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240504170627-em6ajyx\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"199女菀","type":"doc","updated":"20240820165401"},"Children":[{"ID":"20240625160859-vjyekxj","Type":"NodeHeading","HeadingLevel":5,"Properties":{"fold":"1","id":"20240625160859-vjyekxj","updated":"20240820165401"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"错录"}]},{"ID":"20240820164511-t02do1c","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240820164511-t02do1c","updated":"20240820164542"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一年蓬"}]},{"ID":"20240820162058-tpc2692","Type":"NodeParagraph","Properties":{"heading-fold":"1","id":"20240820162058-tpc2692","updated":"20240820164618"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"女菀 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/女菀 1-20240820162252-8i4kpje.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 356px;","style":"width: 346px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"女菀 (3)"},{"Type":"