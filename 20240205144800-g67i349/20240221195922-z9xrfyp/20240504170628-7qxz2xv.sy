{"ID":"20240504170628-7qxz2xv","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504170628-7qxz2xv","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504170628-7qxz2xv\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504170628-o3zwcj1\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611162656-scuqhpa\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240611162921-d0lxku8\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"186石苇（石韦）","type":"doc","updated":"20240820095036"},"Children":[{"ID":"20240625102904-0009dc3","Type":"NodeParagraph","Properties":{"id":"20240625102904-0009dc3","updated":"20240820093940"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石苇"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石苇-20240625102904-zq5m67n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 286px;","style":"width: 276px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240625102759-wjkcfyi.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 276px;\" parent-style=\"width: 286px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240820094818-etavdz8","Type":"NodeParagraph","Properties":{"id":"20240820094818-etavdz8","updated":"20240820094818"}},{"ID":"20240820094551-wk0110g","Type":"NodeParagraph","Properties":{"id":"20240820094551-wk0110g","updated":"20240820094551"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小石韦"}]},{"ID":"20240820094551-e8ribiv","Type":"NodePar