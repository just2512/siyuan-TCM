pe":"NodeText","Data":"​"}]},{"ID":"20240820094726-4oj3k48","Type":"NodeParagraph","Properties":{"id":"20240820094726-4oj3k48","updated":"20240820094726"}},{"ID":"20240820094551-1k6so6o","Type":"NodeParagraph","Properties":{"id":"20240820094551-1k6so6o","updated":"20240820094551"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有柄石韦"}]},{"ID":"20240820094551-50fhnch","Type":"NodeParagraph","Properties":{"id":"20240820094551-50fhnch","updated":"20240820094551"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 5-20240718150910-1zg6c9x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 464px;","style":"width: 454px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 4-20240718150821-jfbsju2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 454px;\" parent-style=\"width: 464px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820094551-pvle4zy","Type":"NodeParagraph","Properties":{"id":"20240820094551-pvle4zy","updated":"20240820095036"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 875px;","style":"width: 865px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 7-20240718151422-l3rqjrq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 865px;\" parent-style=\"width: 875px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820094551-10gbd6z","Type":"NodeParagraph","Properties":{"id":"20240820094551-10gbd6z","updated":"20240820095035"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 872px;","style":"width: 862px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 6-20240718151203-m7e6jef.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 862px;\" parent-style=\"width: 872px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820094551-b979qj0","Type":"NodeParagraph","Properties":{"id":"20240820094551-b979qj0","updated":"20240820094551"}},{"ID":"20240820094551-ubwec7p","Type":"NodeParagraph","Properties":{"id":"20240820094551-ubwec7p","updated":"20240820094551"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"庐山石韦"}]},{"ID":"20240820094551-uc1qs9f","Type":"NodeParagraph","Properties":{"id":"20240820094551-uc1qs9f","updated":"20240820094551"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产华东、华中以及东北地区。\n【性状】\t庐山石韦：叶片略皱缩，展平后呈披针形，长1025cm，宽35cm。先端渐尖，基部耳状偏斜，全缘，边缘常向内卷曲；上表面黄绿色或灰绿色，散布有黑色圆形小凹点；下表面密生红棕色星状毛，有的侧脉间布满棕色圆点状的孢子囊群。叶柄具四棱，长1020cm，直径1.53mm，略扭曲，有纵槽。叶片革质。气微，味微涩苦。\n石韦：叶片披针形或长圆披针形，长812cm，宽13cm。基部楔形，对称。孢子囊群在侧脉间，排列紧密而整齐。叶柄长510cm，直径约1.5mm。有柄石韦：叶片多卷曲呈筒状，展平后呈长圆形或卵状长圆形，长38cm，宽12.5cm。基部楔形，对称。下表面侧脉不明显，布满孢子囊群。叶柄长312cm，直径约1mm。\n【性味】\t甘、苦，微寒。\n【功效】\t利尿通淋，清热止血。用于热淋，血淋，石淋，小便不通，淋沥涩痛，吐血，衄血，尿血，崩漏，肺热喘咳。\n【注解】\t“红星点”：指石韦药材叶片背面所具有的红色的孢子囊。"}]},{"ID":"20240820094551-vrk6szs","Type":"NodeParagraph","Properties":{"id":"20240820094551-vrk6szs","updated":"20240820094551"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206115406-8zwzjfk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820094551-09umzol","Type":"NodeParagraph","Properties":{"id":"20240820094551-09umzol","updated":"20240820095020"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 507px;","style":"width: 497px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 9-20240718151852-x98j7eq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 497px;\" parent-style=\"width: 507px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 698px;","style":"width: 688px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 5-20240820095020-4muxudh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 688px;\" parent-style=\"width: 698px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820094551-u5w066y","Type":"NodeParagraph","Properties":{"id":"20240820094551-u5w066y","updated":"20240820095031"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 11-20240718152127-5ui7tew.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 654px;","style":"width: 644px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 12-20240718152235-bncw52w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 644px;\" parent-style=\"width: 654px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820094551-mrvrp2g","Type":"NodeParagraph","Properties":{"id":"20240820094551-mrvrp2g","updated":"20240820094935"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 459px;","style":"width: 449px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"石韦 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/石韦 8-20240718151711-ade39th.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 449px;\" parent-style=\"width: 459px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611162920-9bputuw","Type":"NodeThematicBreak","Properties":{"id":"20240611162920-9bputuw"}},{"ID":"20240611162921-d0lxku8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162921-d0lxku8","updated":"20240611162925"},"Children":[{"Type":"NodeText","Data":"石韦《长沙药解》"}]},{"ID":"20240611162921-cwpkbeq","Type":"NodeParagraph","Properties":{"id":"20240611162921-cwpkbeq","updated":"20240611162921"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦平。主劳热邪气，五癃闭不通，利小便水道。一名石。生山谷石上。"}]},{"ID":"20240611162921-re80f2g","Type":"NodeParagraph","Properties":{"id":"20240611162921-re80f2g","updated":"20240611162921"},"Children":[{"Type":"NodeText","Data":"味苦，入足太阳膀胱经。清金泻热，利水开癃。"}]},{"ID":"20240611162921-zbj5c6c","Type":"NodeParagraph","Properties":{"id":"20240611162921-zbj5c6c","updated":"20240611162921"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳖甲煎丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在鳖甲"},{"Type":"NodeText","Data":"。用之治疟日久，结为癥瘕，以其泻水而消瘀也。"}]},{"ID":"20240611162921-5rlu9kb","Type":"NodeParagraph","Properties":{"id":"20240611162921-5rlu9kb","updated":"20240611162921"},"Children":[{"Type":"NodeText","Data":"石韦清肺除烦，利水泻湿，专治淋涩之证，并疗崩漏金疮，发背痈肿。"}]},{"ID":"20240611162858-w2pluon","Type":"NodeThematicBreak","Properties":{"id":"20240611162858-w2pluon"}},{"ID":"20240611162908-2hf3sp6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162908-2hf3sp6","updated":"20240611162913"},"Children":[{"Type":"NodeText","Data":"石韦《本草备要》"}]},{"ID":"20240611162908-40mj6sd","Type":"NodeParagraph","Properties":{"id":"20240611162908-40mj6sd","updated":"20240611162908"},"Children":[{"Type":"NodeText","Data":"通淋，补劳"}]},{"ID":"20240611162908-qagty6i","Type":"NodeParagraph","Properties":{"id":"20240611162908-qagty6i","updated":"20240611162908"},"Children":[{"Type":"NodeText","Data":"甘苦微寒。清肺金以滋化源（凡行水之药，必皆能先清肺火），通膀胱而利水道。益精气，补五劳（利湿清热之功。高阳生对宣帝治劳伤，用石韦计）。治淋崩发背（炒末，冷调，酒服）。"}]},{"ID":"20240611162908-h1jkefq","Type":"NodeParagraph","Properties":{"id":"20240611162908-h1jkefq","updated":"20240611162908"},"Children":[{"Type":"NodeText","Data":"生石阴，柔韧如皮，背有黄毛。去毛，微炙用。杏仁、滑石、射干为使，得菖蒲良。生古瓦上者名瓦韦，治淋。"}]},{"ID":"20240611162858-aq5nu81","Type":"NodeThematicBreak","Properties":{"id":"20240611162858-aq5nu81"}},{"ID":"20240611162859-fb2d2ez","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162859-fb2d2ez","updated":"20240611162903"},"Children":[{"Type":"NodeText","Data":"石苇《本草述钩元》"}]},{"ID":"20240611162859-loneajj","Type":"NodeParagraph","Properties":{"id":"20240611162859-loneajj","updated":"20240611162859"},"Children":[{"Type":"NodeText","Data":"多生阴崖险罅处。其叶长者近尺。阔寸余。柔韧如皮。背有黄毛。故名石苇。（濒湖）味苦平。气微寒。主治劳热邪气。癃闭不通。（本经）止烦下气。通膀胱满。补五劳。"}]},{"ID":"20240611162859-ffzm7s1","Type":"NodeParagraph","Properties":{"id":"20240611162859-ffzm7s1","updated":"20240611162859"},"Children":[{"Type":"NodeText","Data":"安五脏捷于影〔论〕石苇生于石旁。及阴崖险罅。得阴气最专。似于肾气有即补以为通之用。故统治五淋结而成〔修治〕刷去黄毛。免射肺作咳。并宜去梗。微炙用。"}]},{"ID":"20240611162652-htnxhwc","Type":"NodeThematicBreak","Properties":{"id":"20240611162652-htnxhwc"}},{"ID":"20240611162845-msih6zx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162845-msih6zx","updated":"20240611162853"},"Children":[{"Type":"NodeText","Data":"石韦《冯氏锦囊秘录》"}]},{"ID":"20240611162845-ga8pvwn","Type":"NodeParagraph","Properties":{"id":"20240611162845-ga8pvwn","updated":"20240611162845"},"Children":[{"Type":"NodeText","Data":"石韦用须，拭去背上黄毛，治遗尿成淋，通膀胱利水，疗痈疽发背，去恶风止烦，益精气补五劳，除邪热安五脏。生瓦上者名为瓦韦，治淋亦佳。"}]},{"ID":"20240611162652-f075xs7","Type":"NodeThematicBreak","Properties":{"id":"20240611162652-f075xs7"}},{"ID":"20240611162835-yq7v8oq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162835-yq7v8oq","updated":"20240611162839"},"Children":[{"Type":"NodeText","Data":"石韦《本草纲目》"}]},{"ID":"20240611162835-3lpha3q","Type":"NodeParagraph","Properties":{"id":"20240611162835-3lpha3q","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"「释名」石革、石皮、石兰。"}]},{"ID":"20240611162835-fheknuu","Type":"NodeParagraph","Properties":{"id":"20240611162835-fheknuu","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、无毒。"}]},{"ID":"20240611162835-c8aa4dk","Type":"NodeParagraph","Properties":{"id":"20240611162835-c8aa4dk","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611162835-9d3p78z","Type":"NodeParagraph","Properties":{"id":"20240611162835-9d3p78z","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"1、小便淋痛。用石韦、滑石，等分为末，每取一小撮，水送服。"}]},{"ID":"20240611162835-ab50y09","Type":"NodeParagraph","Properties":{"id":"20240611162835-ab50y09","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"2、便前有血。用石韦研为末，以茄子枝煎汤送服二钱。"}]},{"ID":"20240611162835-uwolnak","Type":"NodeParagraph","Properties":{"id":"20240611162835-uwolnak","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"3、气热咳嗽。用石韦、槟榔，等分为末，每服二钱，姜汤送下。"}]},{"ID":"20240611162835-i5fgr3p","Type":"NodeParagraph","Properties":{"id":"20240611162835-i5fgr3p","updated":"20240611162835"},"Children":[{"Type":"NodeText","Data":"4、崩中漏下。用石韦研为末，每服三钱，温酒送下。"}]},{"ID":"20240611162652-hl3bmfb","Type":"NodeThematicBreak","Properties":{"id":"20240611162652-hl3bmfb"}},{"ID":"20240611162824-t6h0650","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162824-t6h0650","updated":"20240611162830"},"Children":[{"Type":"NodeText","Data":"石苇《新修本草》"}]},{"ID":"20240611162824-ixuau81","Type":"NodeParagraph","Properties":{"id":"20240611162824-ixuau81","updated":"20240611162824"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主劳热邪气，五癃闭不通，利小便水道。止烦，下气，通膀胱满，补益精气。一名石 ，一名石皮。用之去黄毛，毛射人肺，令人咳，不闻水及人声者良。二月采叶，阴干。"}]},{"ID":"20240611162824-0yizlr8","Type":"NodeParagraph","Properties":{"id":"20240611162824-0yizlr8","updated":"20240611162824"},"Children":[{"Type":"NodeText","Data":"滑石、杏仁、射干为之使，得菖蒲良。蔓延石上，生叶如皮，故名石苇。今处处有，以不闻水声、人声者为佳。出建平者，叶长大而浓。"}]},{"ID":"20240611162824-o0v952o","Type":"NodeParagraph","Properties":{"id":"20240611162824-o0v952o","updated":"20240611162824"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物丛生石旁阴处，不蔓延生。生疗淋亦好也。"}]},{"ID":"20240611162652-uhh2ani","Type":"NodeThematicBreak","Properties":{"id":"20240611162652-uhh2ani"}},{"ID":"20240611162814-ldefqis","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162814-ldefqis","updated":"20240611162820"},"Children":[{"Type":"NodeText","Data":"石苇《本草崇原》"}]},{"ID":"20240611162814-w5o0t1e","Type":"NodeParagraph","Properties":{"id":"20240611162814-w5o0t1e","updated":"20240611162814"},"Children":[{"Type":"NodeText","Data":"气味苦平，无毒。主治劳热邪气，五癃闭不通，利小便水道。"}]},{"ID":"20240611162814-b5onv2n","Type":"NodeParagraph","Properties":{"id":"20240611162814-b5onv2n","updated":"20240611162814"},"Children":[{"Type":"NodeText","Data":"（石苇始出华阴山谷，今晋绛、滁海、福州、江宁皆有，丛生石旁及阴崖险罅处。其叶长者近尺，阔寸余，背有黄毛，亦有成金星者，凌冬不凋，柔韧如皮，故《别录》名石皮，采处以不闻水声及人声者良。）"}]},{"ID":"20240611162814-nfqp4xl","Type":"NodeParagraph","Properties":{"id":"20240611162814-nfqp4xl","updated":"20240611162814"},"Children":[{"Type":"NodeText","Data":"水草、石草皆主在肾。石苇生于石上，凌冬不凋，盖禀少阴之精气，叶背有金星，有黄毛，乃金水相生。肾上连肺也，主治劳热邪气者，劳热在骨，邪气在皮，肺肾之所主也。五癃者，五液癃闭，小便不利也。石苇助肺肾之精气，上下相交，水津上濡，则上窍外窍皆通。肺气不化，则水道行而小便利矣。夫水声泄肾气，人声泄肺气，不闻水声、人声者，藏水天之精，以助人之肺肾也。"}]},{"ID":"20240611162652-lly3pwi","Type":"NodeThematicBreak","Properties":{"id":"20240611162652-lly3pwi"}},{"ID":"20240611162704-bq6b6ag","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162704-bq6b6ag","updated":"20240611162728"},"Children":[{"Type":"NodeText","Data":"石苇《中药学》"}]},{"ID":"20240611162704-pn6706j","Type":"NodeParagraph","Properties":{"id":"20240611162704-pn6706j","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【药用】水龙骨科草本植物庐山石苇Pyrrosiasheareri（BAK）Ching,石苇P.lingua（Thumb.）farwell或有柄石苇P.petiolosa（Christ）Ching的叶。"}]},{"ID":"20240611162704-0ebqraw","Type":"NodeParagraph","Properties":{"id":"20240611162704-0ebqraw","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，甘，微寒。归肺，膀胱经。"}]},{"ID":"20240611162704-sailyuq","Type":"NodeParagraph","Properties":{"id":"20240611162704-sailyuq","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【功效】清热利水通淋，清肺化痰。"}]},{"ID":"20240611162704-oqg5a2e","Type":"NodeParagraph","Properties":{"id":"20240611162704-oqg5a2e","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【淋床应用】1.用于热淋，石淋，血淋等症。"}]},{"ID":"20240611162704-3h0wibk","Type":"NodeParagraph","Properties":{"id":"20240611162704-3h0wibk","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"石苇有清热利水通淋的作用，为治疗热淋、石淋所常用，可与滑石、海金沙、茅根等同用；因其又能止血，故治血淋亦有效验，可与蒲黄同用。"}]},{"ID":"20240611162704-g5u0a7s","Type":"NodeParagraph","Properties":{"id":"20240611162704-g5u0a7s","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"2.用于肺热咳嗽痰多。"}]},{"ID":"20240611162704-zw3u5yg","Type":"NodeParagraph","Properties":{"id":"20240611162704-zw3u5yg","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"石苇能清肺化痰止咳，用于肺热咳嗽痰多，单用有效。亦可与清肺化痰之品配伍，目前还用于急、慢性支气管炎。"}]},{"ID":"20240611162704-dqa1cjj","Type":"NodeParagraph","Properties":{"id":"20240611162704-dqa1cjj","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【处方用名】石苇石韦（洗净，晒干，切碎用）"}]},{"ID":"20240611162704-croj5wd","Type":"NodeParagraph","Properties":{"id":"20240611162704-croj5wd","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240611162704-67az2bx","Type":"NodeParagraph","Properties":{"id":"20240611162704-67az2bx","updated":"20240611162704"},"Children":[{"Type":"NodeText","Data":"【方剂举例】石苇散（《证治准绳》）：石苇、瞿麦、车前、木通、冬葵子、赤苓桑皮、滑石、甘草。治癃闭淋沥。"}]},{"ID":"20240611162652-nbis0yp","Type":"NodeThematicBreak","Properties":{"id":"20240611162652-nbis0yp"}},{"ID":"20240611162653-5g7kpnu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162653-5g7kpnu","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：石韦"}]},{"ID":"20240611162653-8z9z7fd","Type":"NodeParagraph","Properties":{"id":"20240611162653-8z9z7fd","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162653-3v0x68z","Type":"NodeParagraph","Properties":{"id":"20240611162653-3v0x68z","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" Shí Wéi"}]},{"ID":"20240611162653-j960k3g","Type":"NodeParagraph","Properties":{"id":"20240611162653-j960k3g","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162653-716wfpe","Type":"NodeParagraph","Properties":{"id":"20240611162653-716wfpe","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 小石韦、飞刀剑、石皮、石剑、石兰、金茶匙"}]},{"ID":"20240611162653-p3te6k9","Type":"NodeParagraph","Properties":{"id":"20240611162653-p3te6k9","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611162653-fl4vx34","Type":"NodeParagraph","Properties":{"id":"20240611162653-fl4vx34","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" FOLIUM PYRROSIAE"}]},{"ID":"20240611162653-o7nlwsd","Type":"NodeParagraph","Properties":{"id":"20240611162653-o7nlwsd","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162653-tr8j6w3","Type":"NodeParagraph","Properties":{"id":"20240611162653-tr8j6w3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 本品为水龙骨科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"庐山石韦"},{"Type":"NodeText","Data":"Pyrrosia sheareri （Bak.）Ching、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石韦"},{"Type":"NodeText","Data":"Pyrrosia lingua （Thunb.）Farwell 或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有柄石韦"},{"Type":"NodeText","Data":"Pyrrosia petiolosa （Christ）Ching 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"。全年均可采收，除去根茎及根，晒干或阴干。"}]},{"ID":"20240611162653-9vf0dmr","Type":"NodeParagraph","Properties":{"id":"20240611162653-9vf0dmr","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162653-xg7e92g","Type":"NodeParagraph","Properties":{"id":"20240611162653-xg7e92g","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 庐山石韦：叶片略皱缩，展平后呈披针形，长10～25cm，宽3～5cm。先端渐尖，基部耳状偏斜，全缘，边缘常向内卷曲；上表面黄绿色或灰绿色，散布有黑色圆形小凹点；下表面密生红棕色星状毛，有的侧脉间布满棕色圆点状的孢子囊群。叶柄具四棱，长10～20cm，直径1。5～3mm，略扭曲，有纵槽。叶片革质。气微，味微涩苦。"}]},{"ID":"20240611162653-aqqhngk","Type":"NodeParagraph","Properties":{"id":"20240611162653-aqqhngk","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"石韦：叶片披针形或长圆披针形，长8～12cm，宽1～3cm。基部楔形，对称。孢子囊群在侧脉间，排列紧密而整齐。叶柄长5～10cm，直径约1。5mm。"}]},{"ID":"20240611162653-crv5rxf","Type":"NodeParagraph","Properties":{"id":"20240611162653-crv5rxf","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"有柄石韦：叶片多卷曲呈筒状，展平后呈长圆形或卵状长圆形，长3～8cm，宽1～2。5cm。基部楔形，对称。下表面侧脉不明显，布满孢子囊群。叶柄长3～12cm，直径约1mm。"}]},{"ID":"20240611162653-bt00w0b","Type":"NodeParagraph","Properties":{"id":"20240611162653-bt00w0b","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240611162653-71btnxj","Type":"NodeParagraph","Properties":{"id":"20240611162653-71btnxj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240611162653-aokbwwy","Type":"NodeParagraph","Properties":{"id":"20240611162653-aokbwwy","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611162653-bcbomk9","Type":"NodeParagraph","Properties":{"id":"20240611162653-bcbomk9","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，切段，晒干，筛去细屑。"}]},{"ID":"20240611162653-6ovj3kh","Type":"NodeParagraph","Properties":{"id":"20240611162653-6ovj3kh","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611162653-rl0dy90","Type":"NodeParagraph","Properties":{"id":"20240611162653-rl0dy90","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 本品粉末黄棕色。星状毛体部6～12 细胞，作辐射状排列成上、下两轮，有的表面光滑，有的有纵向或不规则网状纹理；柄部1～9细胞。孢子极面观椭圆形，赤道面观肾形，外壁具疣状突起。孢子囊环带细胞，表面观扁长方形。叶下表皮细胞多角形，垂周壁连珠状增厚，气孔类圆形。纤维长梭形，胞腔内充满红棕色或棕色块状物。"}]},{"ID":"20240611162653-zycdkr5","Type":"NodeParagraph","Properties":{"id":"20240611162653-zycdkr5","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162653-0hh1a29","Type":"NodeParagraph","Properties":{"id":"20240611162653-0hh1a29","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 归肺、膀胱经。"}]},{"ID":"20240611162653-hf9f89b","Type":"NodeParagraph","Properties":{"id":"20240611162653-hf9f89b","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162653-71wj04z","Type":"NodeParagraph","Properties":{"id":"20240611162653-71wj04z","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 甘、苦，微寒。"}]},{"ID":"20240611162653-xf9sovr","Type":"NodeParagraph","Properties":{"id":"20240611162653-xf9sovr","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162653-4puprbl","Type":"NodeParagraph","Properties":{"id":"20240611162653-4puprbl","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 利尿通淋，清热止血。用于热淋，血淋，石淋，小便不通，淋沥涩痛，吐血，衄血，尿血，崩漏，肺热喘咳。"}]},{"ID":"20240611162653-xp1bf32","Type":"NodeParagraph","Properties":{"id":"20240611162653-xp1bf32","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162653-gseqd5q","Type":"NodeParagraph","Properties":{"id":"20240611162653-gseqd5q","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240611162653-mka5wlb","Type":"NodeParagraph","Properties":{"id":"20240611162653-mka5wlb","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240611162653-gw53jkx","Type":"NodeParagraph","Properties":{"id":"20240611162653-gw53jkx","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" （1）治疗热淋、石淋所常用，可与滑石、海金沙、茅根等同用；故治血淋亦有效验，可与蒲黄同用。用于肺热咳嗽痰多，单用有效。亦可与清肺化痰之品配伍，目前还用于急、慢性支气管炎。"}]},{"ID":"20240611162653-ro9bfgj","Type":"NodeParagraph","Properties":{"id":"20240611162653-ro9bfgj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162653-ldz12m3","Type":"NodeParagraph","Properties":{"id":"20240611162653-ldz12m3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611162653-yuiq8z3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162653-yuiq8z3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：石韦"}]},{"ID":"20240611162653-md6thv2","Type":"NodeParagraph","Properties":{"id":"20240611162653-md6thv2","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162653-unx41m4","Type":"NodeParagraph","Properties":{"id":"20240611162653-unx41m4","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" Shí Wéi"}]},{"ID":"20240611162653-6epd6s3","Type":"NodeParagraph","Properties":{"id":"20240611162653-6epd6s3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162653-mrxmc18","Type":"NodeParagraph","Properties":{"id":"20240611162653-mrxmc18","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 石樜（《本经》），石皮（《别录》），石苇（《滇南本草》），金星草、石兰（《纲目》），生扯拢（《分类草药性》），虹霓剑草、石剑、潭剑（《福建民间草药》），金汤匙、石背柳（《中药材手册》）。"}]},{"ID":"20240611162653-t3fu5bl","Type":"NodeParagraph","Properties":{"id":"20240611162653-t3fu5bl","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611162653-s8imjl8","Type":"NodeParagraph","Properties":{"id":"20240611162653-s8imjl8","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611162653-2a7cxro","Type":"NodeParagraph","Properties":{"id":"20240611162653-2a7cxro","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162653-y2uhdl7","Type":"NodeParagraph","Properties":{"id":"20240611162653-y2uhdl7","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 为水龙骨科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"石韦，庐山石韦、毡毛石韦、有柄石韦、北京石韦"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"西南石韦"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"。春、夏、秋均可采收，除去根茎及须根，晒干。"}]},{"ID":"20240611162653-3n8khqe","Type":"NodeParagraph","Properties":{"id":"20240611162653-3n8khqe","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611162653-bsc0l2w","Type":"NodeParagraph","Properties":{"id":"20240611162653-bsc0l2w","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" ①石韦，又名：飞刀剑（《植物名实图考》），肺心草、蜈蚣七、铺地娱蚣七、七星剑、大号七星剑、一枝箭、山柴刀、木上蜈蚣、肺筋草、蛇舌风。"}]},{"ID":"20240611162653-xjtiqzk","Type":"NodeParagraph","Properties":{"id":"20240611162653-xjtiqzk","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"多年生草本，高13～30厘米。根茎细长，横走，密被深褐色披针形的鳞片；根须状，深褐色，密生鳞毛。叶疏生；叶柄长6～15厘米，略呈四棱形，基部有关节，被星状毛；叶片披针形、线状披针形或长圆状披针形，长7～20厘米，宽1.5～3厘米，先端渐尖，基部渐狭，略下延，全缘，革质，上面绿色，有细点，疏被星状毛或无毛，下面密被淡褐色星芒状毛，主脉明显，侧脉略可见，细脉不明显。孢子囊群椭圆形，散生在叶下面的全部或上部，在侧脉之间排成效行，每孢子囊群间隔有星状毛，孢子囊群隐没在星状毛中，淡褐色，无囊群盖；孢子囊有长柄；孢子两面形。"}]},{"ID":"20240611162653-7eci8dt","Type":"NodeParagraph","Properties":{"id":"20240611162653-7eci8dt","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生于山野的岩石上，或树上。分布安徽、江苏、浙江、福建、台湾、广东、广西、江西、湖北、四川、贵州、云南等地。"}]},{"ID":"20240611162653-wjui7e0","Type":"NodeParagraph","Properties":{"id":"20240611162653-wjui7e0","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②庐山石韦，又名：肺金草、大连天草、箭戟蕨。"}]},{"ID":"20240611162653-dk74uwx","Type":"NodeParagraph","Properties":{"id":"20240611162653-dk74uwx","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"高25～60厘米。根茎肥厚而短，密被细小长披针形的鳞片，边缘具纤毛叶近于簇生；叶柄长10～80厘米，粗壮，幼时被褐色或淡褐色的星状毛；叶片广披针形，长10～30屋米，宽3～6.5厘米，先端渐尖，基部稍宽，呈荫侧不等的耳形、圆形、心形、圆楔形或斜截形，有时上侧有尖耳，全缘，上面绿色，有黑色斑点，初时疏被星状毛，后渐光滑，下面密生淡褐色星芒状毛，星芒状毛的芒为短披针形，排列在同一平面上，中脉及侧脉均明显，细脉不甚明显。抱子囊群散生在叶的下面，淡褐色或深褐色，无囊群盖；孢子两面形。"}]},{"ID":"20240611162653-97hw0ye","Type":"NodeParagraph","Properties":{"id":"20240611162653-97hw0ye","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生于山野岩石上。分布安徽、浙江、福建、台湾、广东、广西、江西、湖南、湖北、四川、贵州、云南等地。"}]},{"ID":"20240611162653-piz66jc","Type":"NodeParagraph","Properties":{"id":"20240611162653-piz66jc","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③毡毛石韦"}]},{"ID":"20240611162653-o67q60x","Type":"NodeParagraph","Properties":{"id":"20240611162653-o67q60x","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"与庐山石韦极相似，主要不同点：本种的叶下面被较厚而松的深褐色的星芒状毛，其芒细长针状或线状凿形，且不在同一平面上；叶柄通常较叶片为长。"}]},{"ID":"20240611162653-fn4b1tf","Type":"NodeParagraph","Properties":{"id":"20240611162653-fn4b1tf","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生于山野岩石上。分布湖北、四川、陕西、云南、西藏等地。"}]},{"ID":"20240611162653-h4ilrlg","Type":"NodeParagraph","Properties":{"id":"20240611162653-h4ilrlg","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"④有柄石韦，又名：长柄石韦、石茶。"}]},{"ID":"20240611162653-648wr5k","Type":"NodeParagraph","Properties":{"id":"20240611162653-648wr5k","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"高仅6～17厘米。根茎细长，密被披针形鳞片，边缘具稍卷曲的纤毛。叶柄长3.5～11厘米，被星状毛；叶片披针形、长圆状披针形、广披针形或长椭圆形，长2.5～9.5厘米，宽9～28毫米，先端钝，基部下延至叶柄，全缘，上面绿色，有黑色斑点，疏被星状毛，下面密被灰色的星芒状毛，其芒短，叶脉不甚明显；孢子叶较营养叶为长，通常内卷使叶片呈圆筒状。孢子囊群融合，满布于叶的下面，深褐色，无囊群盖。"}]},{"ID":"20240611162653-kk1yhai","Type":"NodeParagraph","Properties":{"id":"20240611162653-kk1yhai","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生于山野岩石上。分布黑龙江、吉林、辽宁、河北、河南、山东、安徽、江苏、四川、贵州、云南、陕西等地。"}]},{"ID":"20240611162653-ab9yj0q","Type":"NodeParagraph","Properties":{"id":"20240611162653-ab9yj0q","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑤北京石韦"}]},{"ID":"20240611162653-skj1p8q","Type":"NodeParagraph","Properties":{"id":"20240611162653-skj1p8q","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"高10～25厘米。根茎细瘦，被黑褐色鳞片。叶柄长2.5～9厘米，被星状毛；叶片线形或线状披针形，长6～15厘米，宽6～15毫米，先端渐尖，基部渐狭，上面绿色，有细点，疏被白色星状毛或无毛，下面密被灰色或淡褐色星芒状毛；叶稍内卷，但不呈筒状。孢子囊群多散生于叶下面的较上部分，深褐色，无囊群盖。"}]},{"ID":"20240611162653-x7xwkzn","Type":"NodeParagraph","Properties":{"id":"20240611162653-x7xwkzn","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生于山野岩石上。分布河北、山东、湖北、山西、陕西、内蒙古等地。"}]},{"ID":"20240611162653-shsr87v","Type":"NodeParagraph","Properties":{"id":"20240611162653-shsr87v","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑥西南石韦"}]},{"ID":"20240611162653-wrjl4o4","Type":"NodeParagraph","Properties":{"id":"20240611162653-wrjl4o4","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"与北京石韦极为相似，主要不同点：本种叶的下面被较厚而松的深褐色星芒状毛，其芒较长呈针状，略有光泽。"}]},{"ID":"20240611162653-j1z57et","Type":"NodeParagraph","Properties":{"id":"20240611162653-j1z57et","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生于山野岩石上。分布云南、四川、湖北等地。"}]},{"ID":"20240611162653-u6xp02f","Type":"NodeParagraph","Properties":{"id":"20240611162653-u6xp02f","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"以上几种植物的根茎（石韦根）、叶上的毛茸（石韦毛）亦供药用，各详专条。"}]},{"ID":"20240611162653-i4agtu7","Type":"NodeParagraph","Properties":{"id":"20240611162653-i4agtu7","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162653-se8fxp0","Type":"NodeParagraph","Properties":{"id":"20240611162653-se8fxp0","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" ①大叶石韦"}]},{"ID":"20240611162653-nnkuo5p","Type":"NodeParagraph","Properties":{"id":"20240611162653-nnkuo5p","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"㈠石韦：叶柄近圆柱形，棕色或棕黑色，长6～15厘米，有纵沟，无毛或疏被星状毛；叶片扭曲皱卷，平展后呈披针形，长7～20厘米，宽1.5～3厘米，先端渐尖，叶基楔形至圆形，全缘，叶面棕色或灰棕色，无毛或疏具星状毛，布有黑色圆形小凹点，背面密被中心具红色圆点的粉棕色星状毛，毛的分枝较粗短，有的叶表面几乎全部布有孢子囊群。叶片革质，稍脆易折。气无，味淡。㈡庐山石韦：与石韦相似，惟叶柄较长，无毛；叶片皱缩，较大，长圆状披针形，叶基阔楔形、圆形、近心形或稍呈耳形，显着不对称，背面星状毛的分枝较粗，有的叶片具棕色圆形孢子囊群，与中脉约成60°角斜出平行排列，分布近乎整个叶面，其内常见红色光泽的孢子囊环带。厚革质，坚硬而脆。气无，味微苦。㈢毡毛石韦：叶柄有数条纵槽，有毛；叶片扭曲卷皱，披针形，基部楔形至阔楔形，对称，背面密布灰棕色星状毛，毛的分枝细长，有的叶上半部布有孢子囊群。革质，稍硬。气无，味淡。"}]},{"ID":"20240611162653-jo9g446","Type":"NodeParagraph","Properties":{"id":"20240611162653-jo9g446","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②小叶石韦"}]},{"ID":"20240611162653-0xz3bla","Type":"NodeParagraph","Properties":{"id":"20240611162653-0xz3bla","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"㈠有柄石韦：叶柄被棕色星状毛，有1纵浅槽，内密生毛；叶片卷曲成筒状，广披针形至长圆状披针形，长3～9厘米，先端钝，叶基楔形，全缘，叶面灰棕色，无毛或疏被星状毛，散布黑色圆形小凹点，背面密生粉棕色的中心有红点的星状毛，毛的分枝较短粗，中脉明显，侧细脉均不显。薄革质。气无，味微苦。㈡北京石韦：叶柄扁平，细长扭曲，有毛；叶片扭曲卷皱，线状披针形或近线形，叶基窄楔形下延成叶柄边缘；叶面浅黄绿色，无毛，背面密被较薄的灰棕色星状毛，毛的分枝细长，叶片背面几乎全部或大部生有孢子囊群。薄革质。气无，味微苦。㈢西南石韦：与北京石韦相似，惟叶的背面被较厚而松的星状毛，毛的分枝较长，呈长针状，深褐色，略有光泽。"}]},{"ID":"20240611162653-cig0qeo","Type":"NodeParagraph","Properties":{"id":"20240611162653-cig0qeo","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"上述两类药材，大叶石韦以叶大、质厚、背面有毛为佳；小叶石韦以叶厚、整齐、洁净为佳。"}]},{"ID":"20240611162653-lscem3w","Type":"NodeParagraph","Properties":{"id":"20240611162653-lscem3w","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"主产浙江、湖北、河南、河北、江苏等地。此外，山东、辽宁、广西、江西、福建、云南、贵州、四川、陕西、山西、安徽等地亦产。其中以浙江、湖北、江苏所产的大叶石韦质量为佳。"}]},{"ID":"20240611162653-n29q8bt","Type":"NodeParagraph","Properties":{"id":"20240611162653-n29q8bt","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611162653-ho7ehh9","Type":"NodeParagraph","Properties":{"id":"20240611162653-ho7ehh9","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 含绵马三萜（diploptene）、皂甙、蒽醌、黄酮、β-谷甾醇。"}]},{"ID":"20240611162653-gy405rn","Type":"NodeParagraph","Properties":{"id":"20240611162653-gy405rn","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611162653-ldh6o30","Type":"NodeParagraph","Properties":{"id":"20240611162653-ldh6o30","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 拣净杂质，洗去泥沙，刷净茸毛，切段晒干。"}]},{"ID":"20240611162653-2khuo7b","Type":"NodeParagraph","Properties":{"id":"20240611162653-2khuo7b","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"用之须去黄毛。\""}]},{"ID":"20240611162653-cpf44og","Type":"NodeParagraph","Properties":{"id":"20240611162653-cpf44og","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"入药去梗，须微炙用。一法以羊脂炒干用。\""}]},{"ID":"20240611162653-y51jn6k","Type":"NodeParagraph","Properties":{"id":"20240611162653-y51jn6k","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162653-3uhxj9r","Type":"NodeParagraph","Properties":{"id":"20240611162653-3uhxj9r","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 入肺、膀胱经。"}]},{"ID":"20240611162653-c22gqa3","Type":"NodeParagraph","Properties":{"id":"20240611162653-c22gqa3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"①《滇南本草》：\"入小肠经。\""}]},{"ID":"20240611162653-1ubifq3","Type":"NodeParagraph","Properties":{"id":"20240611162653-1ubifq3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、膀胱二经。\""}]},{"ID":"20240611162653-sj2u951","Type":"NodeParagraph","Properties":{"id":"20240611162653-sj2u951","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162653-it82n0i","Type":"NodeParagraph","Properties":{"id":"20240611162653-it82n0i","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 苦甘，凉。"}]},{"ID":"20240611162653-502wqgv","Type":"NodeParagraph","Properties":{"id":"20240611162653-502wqgv","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240611162653-6ueyg2a","Type":"NodeParagraph","Properties":{"id":"20240611162653-6ueyg2a","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240611162653-s6xhrpj","Type":"NodeParagraph","Properties":{"id":"20240611162653-s6xhrpj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"微寒。\""}]},{"ID":"20240611162653-l9yso9g","Type":"NodeParagraph","Properties":{"id":"20240611162653-l9yso9g","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"④《贵州草药》：\"味辛，性平。\""}]},{"ID":"20240611162653-i9l1hx4","Type":"NodeParagraph","Properties":{"id":"20240611162653-i9l1hx4","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611162653-3nwpjxs","Type":"NodeParagraph","Properties":{"id":"20240611162653-3nwpjxs","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 阴虚及无湿热者忌服。"}]},{"ID":"20240611162653-rje4o2s","Type":"NodeParagraph","Properties":{"id":"20240611162653-rje4o2s","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"①《本草经集注》：\"滑石、杏仁为之使。得昌蒲良。\""}]},{"ID":"20240611162653-utb3ffz","Type":"NodeParagraph","Properties":{"id":"20240611162653-utb3ffz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"无湿热者勿与。\""}]},{"ID":"20240611162653-2x2j6e3","Type":"NodeParagraph","Properties":{"id":"20240611162653-2x2j6e3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"真阴虚者禁用。\""}]},{"ID":"20240611162653-us1g430","Type":"NodeParagraph","Properties":{"id":"20240611162653-us1g430","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162653-78ejxbg","Type":"NodeParagraph","Properties":{"id":"20240611162653-78ejxbg","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 利水通淋，清肺泄热。治淋痛，尿血，尿路结石，肾炎，崩漏，痢疾，肺热咳嗽，慢性气管炎，金疮，痈疽。"}]},{"ID":"20240611162653-jay5e2b","Type":"NodeParagraph","Properties":{"id":"20240611162653-jay5e2b","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主劳热邪气，五癃闭不通，利小便水道。\""}]},{"ID":"20240611162653-g76d2ps","Type":"NodeParagraph","Properties":{"id":"20240611162653-g76d2ps","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"止烦下气，通膀胱满，补五劳，安五藏，去恶风，益精气。\""}]},{"ID":"20240611162653-9w5oil1","Type":"NodeParagraph","Properties":{"id":"20240611162653-9w5oil1","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"治淋沥遗溺。\""}]},{"ID":"20240611162653-n56vz34","Type":"NodeParagraph","Properties":{"id":"20240611162653-n56vz34","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"④《本草图经》：\"炒末，冷酒调服，疗发背。\""}]},{"ID":"20240611162653-aykvnjk","Type":"NodeParagraph","Properties":{"id":"20240611162653-aykvnjk","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"止玉茎痛。\""}]},{"ID":"20240611162653-qroe16x","Type":"NodeParagraph","Properties":{"id":"20240611162653-qroe16x","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"主崩漏，金疮，清肺气。\""}]},{"ID":"20240611162653-hi2d1ba","Type":"NodeParagraph","Properties":{"id":"20240611162653-hi2d1ba","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑦《植物名实图考》：\"治痰火，同瘦肉蒸服。\""}]},{"ID":"20240611162653-hlyydfq","Type":"NodeParagraph","Properties":{"id":"20240611162653-hlyydfq","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑧《闽东本草》：\"治痢疾。\""}]},{"ID":"20240611162653-aurwrkd","Type":"NodeParagraph","Properties":{"id":"20240611162653-aurwrkd","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162653-k0sjzw6","Type":"NodeParagraph","Properties":{"id":"20240611162653-k0sjzw6","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入散剂。"}]},{"ID":"20240611162653-j5ale3s","Type":"NodeParagraph","Properties":{"id":"20240611162653-j5ale3s","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611162653-5mdhxmk","Type":"NodeParagraph","Properties":{"id":"20240611162653-5mdhxmk","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" ①治血淋：石韦、当归、蒲黄、芍药各等分。上四味治下筛，酒服方寸匕，日三服。（《千金方》石韦散）"}]},{"ID":"20240611162653-aqvjt68","Type":"NodeParagraph","Properties":{"id":"20240611162653-aqvjt68","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②治淋浊尿血：石韦、猪鬃草、连钱草各五钱，煨水服。（《贵州草药》）"}]},{"ID":"20240611162653-hrctrx5","Type":"NodeParagraph","Properties":{"id":"20240611162653-hrctrx5","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③治石淋：石韦（去毛）、滑石各三分。上二味，捣筛为散，用米汁若蜜服一刀圭，日二服。（《古今录验》石韦散）"}]},{"ID":"20240611162653-xsqrebg","Type":"NodeParagraph","Properties":{"id":"20240611162653-xsqrebg","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"④治尿路结石：石韦、车前草各一两，生栀子五钱，甘草三钱。水煎二次，早、晚各服一次。（《南昌医药》（1）：14,1972）"}]},{"ID":"20240611162653-rbges90","Type":"NodeParagraph","Properties":{"id":"20240611162653-rbges90","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑤治心经蕴热，传于小肠，始觉小便微涩赤黄，渐渐不通，小腹膨脝：石韦（去毛，锉）、车前子（车前叶亦可）等分。上浓煮汁饮之。（《全生指迷方》石韦汤）"}]},{"ID":"20240611162653-q5j8jh1","Type":"NodeParagraph","Properties":{"id":"20240611162653-q5j8jh1","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③治痢疾：石韦全草一荫，水煎，调冰糖五钱，饭前服。（《闽东本草》）"}]},{"ID":"20240611162653-og76x4e","Type":"NodeParagraph","Properties":{"id":"20240611162653-og76x4e","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑦治崩中漏下：石韦为末，每服三钱，温酒服。（《纲目》）"}]},{"ID":"20240611162653-v320m4e","Type":"NodeParagraph","Properties":{"id":"20240611162653-v320m4e","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑧治咳嗽：石韦（去毛）、槟榔（锉）等分。上二味，罗为细散，生姜汤调下二钱匕，（《圣济总录》石韦散）"}]},{"ID":"20240611162653-o3o0ur6","Type":"NodeParagraph","Properties":{"id":"20240611162653-o3o0ur6","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑨治慢性气管炎：石韦、蒲公英、佛耳草、一枝黄花各-两。水煎浓缩，分二次服。（中医研究院《攻克慢性气管炎资料选编》30，1971）"}]},{"ID":"20240611162653-1iwvmh7","Type":"NodeParagraph","Properties":{"id":"20240611162653-1iwvmh7","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑩小便淋痛。用石韦、滑石，等分为末，每取一小撮，水送服。"}]},{"ID":"20240611162653-wkwlwbc","Type":"NodeParagraph","Properties":{"id":"20240611162653-wkwlwbc","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑾便前有血。用石韦研为末，以茄子枝煎汤送服二钱。"}]},{"ID":"20240611162653-57mdgtj","Type":"NodeParagraph","Properties":{"id":"20240611162653-57mdgtj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⑿气热咳嗽。用石韦、槟榔，等分为末，每服二钱，姜汤送下。"}]},{"ID":"20240611162653-7bk90mh","Type":"NodeParagraph","Properties":{"id":"20240611162653-7bk90mh","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"⒀崩中漏下。用石韦研为末，每服三钱，温酒送下。"}]},{"ID":"20240611162653-dyos8x6","Type":"NodeParagraph","Properties":{"id":"20240611162653-dyos8x6","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240611162653-wnk8joy","Type":"NodeParagraph","Properties":{"id":"20240611162653-wnk8joy","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" ①治疗支气管哮喘"}]},{"ID":"20240611162653-7l8gjwl","Type":"NodeParagraph","Properties":{"id":"20240611162653-7l8gjwl","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"4～9岁每日用石韦全草5钱，10～15岁1两，16岁以上1.5两。每两加水1000毫升，煎成300毫升，趁热加入冰糖1两，分3次服，3天为一疗程。观察11例，服药后喘息消失者7例，减轻者2例，无改变者2例。多数在服药的当天哮喘症状即开始平息，其他症状于次日或第3天消失，但停药后往往仍有复发，复发时间最短者为2周。复发时再用同法治疗，仍然有效。"}]},{"ID":"20240611162653-o1huh52","Type":"NodeParagraph","Properties":{"id":"20240611162653-o1huh52","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"②治疗慢性气管炎"}]},{"ID":"20240611162653-th0mk9y","Type":"NodeParagraph","Properties":{"id":"20240611162653-th0mk9y","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"曾采用庐山石韦单味煎剂、冲剂、提纯石韦\"410\"糖浆及复方庐山石韦冲剂进行临床观察，均取得不同程度疗效，其中以石韦\"410\"糖浆的效果较为满意。㈠煎剂：鲜庐山石韦全草每天1.6两（第一疗程用全草，第二疗程去毛、叶柄及主脉），头煎加水300毫升，沸后再煎20分钟；二煎加水150毫升，沸后煎20分钟。混合2次煎液，以8层纱布过滤，分2次服。疗效：第1疗程服药人数计21例，有效率为47.6％，其中显效1例。服药2个疗程的16例，有效率为87.5％，其中显效1例。副作用主要有心馆，胸骨后不适，饥饿感，尿量增多及头晕，停药后症状即消失。㈡冲剂：日服3次，每次1包，相当于生药1两。治疗117例，服药一个疗程的有效率为47％，其中显效12例，好转43例，无效62例；两个疗程的有效率为57.6％，其中近期控制者3例，显效22例，好转39例，无效47例。继续服用到3、4个疗程时，有效率可增至87.5％与82％，显效率增为46.2～51％。说明延长疗程，可提高疗效。㈢提纯石韦\"410\"糖浆：每天2次，每次15毫升（相当生药1.5两），10天为一疗程，共服二个疗程。治疗40例，第一疗程有效者31例（78.2％），其中显效16例（40％）；继续服用第二疗程的36人，有效率为88.9％，显效率为55.6％。个别患者每天服3次，疗效更为显著。㈣复方石韦冲剂：用庐山石韦15两，江剪刀草1两，煎成浓汁，焙干，制成粉末，加适量糖粉，每天分3次，开水冲服。10天为一疗程。共治疗278例，有效者200例（72％）；其中近期控制13例，显效51例（23％）。大多数患者在服药2～3天后见效。在使用石韦各种剂型，特别是提纯石韦\"410\"糖浆过程中看出，石韦具有良好的消痰作用，一般治疗1～2天后，痰量减少，粘稠度减低，咯痰转爽。这对改善通气功能，防止继发感染，从而减少对组织细胞的损害，促进病变的愈合创造了有利条件。复方石韦（与江剪刀草合用）镇咳作用较单味石韦为佳，平喘作用两者均较差，消炎效果也不佳。"}]},{"ID":"20240611162653-2tlz9mo","Type":"NodeParagraph","Properties":{"id":"20240611162653-2tlz9mo","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"用有柄石韦全草，压榨去毛及孢子，水煎制成糖浆。第1～4日，按每天含生药1两分3次服。第5～10日，每天剂量加倍。第11～15日照第1～4日剂量服。治疗50岁以上的重症患者12例，其中喘息型8例，有效5例，基本治愈2例，显效1例，进步2例；单纯型4例，仅有1例显效。说明石韦糖浆对喘息型患者疗效较好。"}]},{"ID":"20240611162653-v1ot2l3","Type":"NodeParagraph","Properties":{"id":"20240611162653-v1ot2l3","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"③治疗急、慢性肾炎及肾盂肾炎"}]},{"ID":"20240611162653-0daai1x","Type":"NodeParagraph","Properties":{"id":"20240611162653-0daai1x","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"㈠煎剂：取有柄石韦叶20片左右（相当于2～3克），加水500～1000毫升，每日1剂，煎分2次服。亦可用开水浸泡，当茶饮。㈡片剂：每片含生药0.5克，每次2～3片，日服3次。治疗急性肾小球肾炎39例，36例有效；肾盂肾炎20例，17例有效。据观察，服药2～3天后，尿量即增多，浮肿逐渐消退。对于慢性肾小球肾炎，一般以3个月左右为一疗程，急性肾小球肾炎疗程为10天左右。"}]},{"ID":"20240611162653-624svxy","Type":"NodeParagraph","Properties":{"id":"20240611162653-624svxy","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162653-87sqaw6","Type":"NodeParagraph","Properties":{"id":"20240611162653-87sqaw6","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611162653-gb3w3b9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611162653-gb3w3b9","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"《中华本草》：石韦"}]},{"ID":"20240611162653-sve0a38","Type":"NodeParagraph","Properties":{"id":"20240611162653-sve0a38","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611162653-n4mvk8h","Type":"NodeParagraph","Properties":{"id":"20240611162653-n4mvk8h","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" Shí Wéi"}]},{"ID":"20240611162653-t38xo4j","Type":"NodeParagraph","Properties":{"id":"20240611162653-t38xo4j","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611162653-qy6skyq","Type":"NodeParagraph","Properties":{"id":"20240611162653-qy6skyq","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 石zhe、石皮、石苇、金星草、石兰、生扯拢、虹霓剑草、石剑、虹霓剑草、金汤匙、肺心草、会全草、石耳朵、蛇舌风、小叶下红"}]},{"ID":"20240611162653-3zfap0g","Type":"NodeParagraph","Properties":{"id":"20240611162653-3zfap0g","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240611162653-zwlwlci","Type":"NodeParagraph","Properties":{"id":"20240611162653-zwlwlci","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" Pyrrosia Leaf， Leaf of Shearer's Pyrrosia， Leaf of Japanese Felt Fern"}]},{"ID":"20240611162653-u5ito4s","Type":"NodeParagraph","Properties":{"id":"20240611162653-u5ito4s","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611162653-k0qx22h","Type":"NodeParagraph","Properties":{"id":"20240611162653-k0qx22h","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 出自1.《别录》：石韦，生华阴山谷石上。二月采叶，阴干。"}]},{"ID":"20240611162653-xlr08f9","Type":"NodeParagraph","Properties":{"id":"20240611162653-xlr08f9","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：石韦，今晋、绛、滁、海、福州、江宁府皆有之。丛生石上，叶如柳，背有毛，而斑点如皮，故以名。二月、七月采叶，阴干用。石韦一名石皮。而福州自有一种石皮，三月有花，其月采叶煎浴汤，主风。"}]},{"ID":"20240611162653-gn1ok1t","Type":"NodeParagraph","Properties":{"id":"20240611162653-gn1ok1t","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：石韦，柔皮曰韦，zhe亦皮也。多生阴崖险罅处。其叶长者近尺，阔寸余，柔韧如皮，背有黄毛，亦有金星者名金星草，叶凌冬不"}]},{"ID":"20240611162653-eyyk5w4","Type":"NodeParagraph","Properties":{"id":"20240611162653-eyyk5w4","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611162653-rn5xi31","Type":"NodeParagraph","Properties":{"id":"20240611162653-rn5xi31","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 药材基源：为水龙骨科植物石韦、庐山石韦、西南石韦、华北石韦和有柄韦等的全草。"}]},{"ID":"20240611162653-zl8oyhn","Type":"NodeParagraph","Properties":{"id":"20240611162653-zl8oyhn","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Pyrrosia lingua(Thunb.)Farw.[Acrostichum lingua Thunb.]2.Pyrrosia sheaeri(Bak.)Ching[Polypodium sheareri Bak.]3.Pyrrosia gralla(Gies.)Ching4.Pyrrosia davidii(Bak.)Ching[Polypodium davidii Bak.]5.Pyrrosia petiolosa(Christ)Ching[Polypodium petiolosum Christ]"}]},{"ID":"20240611162653-y29fpmh","Type":"NodeParagraph","Properties":{"id":"20240611162653-y29fpmh","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采收，洗净，晒干。"}]},{"ID":"20240611162653-q9ym3kt","Type":"NodeParagraph","Properties":{"id":"20240611162653-q9ym3kt","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611162653-4rnot4a","Type":"NodeParagraph","Properties":{"id":"20240611162653-4rnot4a","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.石韦附生于海拔100-1800m的林中树干或溪边石上。"}]},{"ID":"20240611162653-jxqyqt6","Type":"NodeParagraph","Properties":{"id":"20240611162653-jxqyqt6","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.庐山石韦生于海拔500-2200m的林中树干或石上。"}]},{"ID":"20240611162653-5u2z5fc","Type":"NodeParagraph","Properties":{"id":"20240611162653-5u2z5fc","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.西南石韦生于林中岩石上。"}]},{"ID":"20240611162653-vp5ofdd","Type":"NodeParagraph","Properties":{"id":"20240611162653-vp5ofdd","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"4.华北石韦生于海拔300-1800m的岩石上。"}]},{"ID":"20240611162653-03bsnis","Type":"NodeParagraph","Properties":{"id":"20240611162653-03bsnis","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"5.有柄石韦生于海拔200-2200m的山地干旱岩石上。"}]},{"ID":"20240611162653-vhwsj1e","Type":"NodeParagraph","Properties":{"id":"20240611162653-vhwsj1e","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"资源分布：1.石韦分布于华东、中南、西南地区。"}]},{"ID":"20240611162653-ccefjsp","Type":"NodeParagraph","Properties":{"id":"20240611162653-ccefjsp","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.庐山石韦分布于西南及安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西。"}]},{"ID":"20240611162653-vp20jmz","Type":"NodeParagraph","Properties":{"id":"20240611162653-vp20jmz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.西南石韦分布于湖北、四川、云南。"}]},{"ID":"20240611162653-2orwklz","Type":"NodeParagraph","Properties":{"id":"20240611162653-2orwklz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"4.华北石韦分布于东北、华北及陕西、甘肃、宁夏、山东、湖北、湖南、四川。"}]},{"ID":"20240611162653-s3q717m","Type":"NodeParagraph","Properties":{"id":"20240611162653-s3q717m","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"5.有柄石韦分布于西南及吉林、辽宁、河北、陕西、山东、江苏、安徽、河南、湖北、广西。"}]},{"ID":"20240611162653-vr7f820","Type":"NodeParagraph","Properties":{"id":"20240611162653-vr7f820","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611162653-bho4gbr","Type":"NodeParagraph","Properties":{"id":"20240611162653-bho4gbr","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 1.石韦，植株高10-30cm。根状茎细长，横生，与叶柄密被棕色披针形鳞片，顶端渐尖，盾状着生，中央深褐色，边缘淡棕色，有睫毛。叶远生，近二型；叶柄长3-10cm，深棕色，有浅沟，幼时被星芒状毛，以关节着生于根状茎上；叶片革质，披针形至长圆状披针形，长6-20cm，宽2-5cm，先端渐尖，基部渐狭并不延于叶柄，全缘；上面绿色，偶有星状毛和凹点，下面密被灰棕色的星芒状毛；不育叶和能育叶同型或略短而阔；中脉上面稍凹，下面隆起，侧脉多少可见，小脉网状。孢子囊群满布于叶背面或上部，幼时密被星芒状毛，成熟时露出；无囊群盖。"}]},{"ID":"20240611162653-u2gdvdz","Type":"NodeParagraph","Properties":{"id":"20240611162653-u2gdvdz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.庐山石韦，植株高20-60cm。根状茎横生，密被披针形鳞片，边缘有锯齿。叶簇生；叶柄粗壮，长10-30cm，以关节着生于根状茎上；叶片坚革质，阔披针形，长20-40cm，宽3-5cm，向顶部渐狭，锐尖头，基部稍变宽，为不等圆耳形或心形，不下延；侧脉两面略下凹。孢子囊群小，在侧脉间排成多行；无囊群盖。"}]},{"ID":"20240611162653-f3g2abe","Type":"NodeParagraph","Properties":{"id":"20240611162653-f3g2abe","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.西南石韦，植株高达25cm。根状茎长而横生，密被褐色鳞片，披针形，长渐尖头，全缘。叶近生；叶柄长2-5cm，以关节着生于根状茎上；叶片软革质，长3-10cm，中部宽6-15mm，狭披针形，向两端渐变狭，下面的星状毛较长，有时叶片较大，侧脉不明显。孢子囊群在侧脉间紧密而整齐的排列；无囊群盖。"}]},{"ID":"20240611162653-bky9jvd","Type":"NodeParagraph","Properties":{"id":"20240611162653-bky9jvd","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"4.华北石韦，植株高达25cm。根茎长而横生，密被披针形鳞片，长渐尖，全缘。叶远生；叶柄长2-5cm，以关节着生；叶片软革质，线形至狭披针形，长3-8cm，中部宽6-15mm，上面幼时疏被星状毛，老时脱落，有凹点，下面密被短而细的橙褐色星状毛，干后有时向上内卷；侧脉不明显。孢子囊群在叶背面整齐地排列成数行。无囊群盖。"}]},{"ID":"20240611162653-45f3y29","Type":"NodeParagraph","Properties":{"id":"20240611162653-45f3y29","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"5.有柄石韦，植株高5-20cm。根状茎长而横生，密被褐棕色的卵状披针形鳞片，边缘有锯齿。叶远生，二型，厚革质，上面无毛，有排列整齐的小凹点，下面密被灰棕星状行；孢子叶柄远长于叶片，长约3-12cm，营养叶柄与叶等长；叶片长圆表或卵状长圆形，先端锐尖或钝头，基部略下延，孢子叶干后通常内卷，几成筒状；叶脉不明显。孢子囊群成熟时满布叶片背面；孢子囊呈圆的两面形，无盖，隐没于星状毛中。"}]},{"ID":"20240611162653-yrcsuxm","Type":"NodeParagraph","Properties":{"id":"20240611162653-yrcsuxm","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240611162653-hdvvq2o","Type":"NodeParagraph","Properties":{"id":"20240611162653-hdvvq2o","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜阴凉干燥的气候，生于岩石上。"}]},{"ID":"20240611162653-pdgdroj","Type":"NodeParagraph","Properties":{"id":"20240611162653-pdgdroj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"栽培技术 分株敏殖：3月栽种，栽前选营养叶片较多的老株，连根挖起，每3-4节剪成1段，放水中浸1昼夜，吸足水分后栽种。应选树下岩石有苔藓植物的地主才易栽活。栽时按行株距23-27cm，把苔藓植物刨开，放入1-2段根茎，用湿润的腐殖质土压紧。亦可利用石坎壁栽种，将种苗放在缝隙里，用湿润的腐殖质土塞稳。"}]},{"ID":"20240611162653-1bz7ppz","Type":"NodeParagraph","Properties":{"id":"20240611162653-1bz7ppz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"田间管理 栽后每年冬季撒1次腐殖质土，厚约1cm。干旱时应浇水。"}]},{"ID":"20240611162653-82onsvi","Type":"NodeParagraph","Properties":{"id":"20240611162653-82onsvi","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240611162653-dqesdzq","Type":"NodeParagraph","Properties":{"id":"20240611162653-dqesdzq","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）石韦 叶向内卷或平展，二型，革质。叶片均为披针形或矩圆披针形，长6-20cm，宽2-5cm。上表面黄棕色；下表面主、侧脉明显，用放大镜观察可见密被浅棕色的星状毛。能育叶下表面除有星状毛外，尚有孢子囊群。叶柄长3-10cm。气微，味淡。"}]},{"ID":"20240611162653-gtprknr","Type":"NodeParagraph","Properties":{"id":"20240611162653-gtprknr","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（2）庐山石韦 叶一型，坚革质。叶片阔披针形，长20-40cm，宽3-5cm，先端渐尖，基部呈耳状偏斜，全缘；上表面黄绿色或黄棕色，在黑色凹点，下表面密布短阔的星状毛。孢子囊群呈星点状，在侧脉间排列成行。叶柄粗壮，长10-30cm，直径3-5mm。"}]},{"ID":"20240611162653-hj9dc9i","Type":"NodeParagraph","Properties":{"id":"20240611162653-hj9dc9i","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（3）西南石韦 叶一型，软革质。叶片披针形，长5-10cm；下表面被厚而疏松的星状毛，毛的分枝长，呈长针状，深褐色，略有光泽。孢子囊群多行。叶柄长约5cm。"}]},{"ID":"20240611162653-0vec1rs","Type":"NodeParagraph","Properties":{"id":"20240611162653-0vec1rs","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（4）华北石韦 叶向内卷成筒状或平展，一型，软革质。叶片披针形或线状披针形，向两端渐狭，长3-8cm，宽0.6-1.5cm；下表面密生短而细的星状毛。孢子囊群多行。叶柄长2-5cm，直径1.5-3mm。"}]},{"ID":"20240611162653-1cz2sj8","Type":"NodeParagraph","Properties":{"id":"20240611162653-1cz2sj8","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（5）有柄石韦 叶向内卷几成筒状，二型，革质。叶片矩圆形或矩圆披针形，基部下延至叶柄，长3-6cm，宽0.5-2cm；能育叶下表面布满棕色孢子囊群。叶柄长3.5-11cm，长于叶片，直径1-2mm。"}]},{"ID":"20240611162653-1ppkqgj","Type":"NodeParagraph","Properties":{"id":"20240611162653-1ppkqgj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"显微鉴别 （1）石韦 叶表面观：下表皮可见星状毛，具7-11个分枝，分枝长150-180μm，宽34-45μm，柄由2-3个细胞组成，长120-180μm。叶横切面：正中分体中柱下方常有1个小分体中柱；靠近上表皮有下皮细胞；主脉上下表皮内侧的厚壁组织较少。叶柄基部横切面：分体中柱4-6个。"}]},{"ID":"20240611162653-a2skkwn","Type":"NodeParagraph","Properties":{"id":"20240611162653-a2skkwn","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（2）庐山石韦 叶表面观：下表皮的星状毛，具8-11个分枝，分枝长100-200μm，宽22-34μm；柄由2-6细胞组成，长110-330μm。叶横切面：正中分体中柱下方有数个小分体中柱；靠近上表皮有下皮细胞；主脉上下表皮内侧的厚壁组织较发达，横长排列。叶柄基部横切面：分体中柱11-15个，其中2个较大，其余略呈马蹄形排列。"}]},{"ID":"20240611162653-67d5ebg","Type":"NodeParagraph","Properties":{"id":"20240611162653-67d5ebg","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（3）西南石韦 显微特征与华北石韦基本相同；但星状毛的分枝较长，一般在600μm以上。"}]},{"ID":"20240611162653-3e0ws1i","Type":"NodeParagraph","Properties":{"id":"20240611162653-3e0ws1i","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（4）华北石韦 叶表面观：下表皮的星状毛具6-10个分枝，分枝长200-560μm，宽12-45μm；柄由3-5个细胞组成，长160-280μm。叶横切面：正中分体中柱下方无小分体中柱。靠近上表皮无下皮细胞；主脉下表皮内侧无厚壁组织。叶柄基部横切面：分体中柱6-10个。"}]},{"ID":"20240611162653-mc6wjy5","Type":"NodeParagraph","Properties":{"id":"20240611162653-mc6wjy5","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"（5）有柄石韦 叶表面观：下表皮的星状毛具8-11个分枝，分枝长260-370μm，宽50-70μm；柄由3-9细胞组成，长180-600μm。叶横切面：正中分体中柱下方内侧具很少的厚壁组织。叶柄基部横切面：分体中柱6-9个。"}]},{"ID":"20240611162653-nwfl10q","Type":"NodeParagraph","Properties":{"id":"20240611162653-nwfl10q","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240611162653-ivm9rfs","Type":"NodeParagraph","Properties":{"id":"20240611162653-ivm9rfs","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 1.小鼠灌服各种提取物，半数致死量（g/kg）如下：101为90；410为48；411为17。"}]},{"ID":"20240611162653-xx79quw","Type":"NodeParagraph","Properties":{"id":"20240611162653-xx79quw","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.小鼠灌胃有柄石韦的各种提取液其LD50为17-90g／kg，异芒果甙为4.65g／kg。"}]},{"ID":"20240611162653-n8bozhn","Type":"NodeParagraph","Properties":{"id":"20240611162653-n8bozhn","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240611162653-jag6o1z","Type":"NodeParagraph","Properties":{"id":"20240611162653-jag6o1z","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 1.石韦全草含里白烯（diploptene），杧果甙（mangiferin），异杧果甙（isomangiferin），绿原酸（chlorogenic acid），β-谷甾醇（β-sitosterol）。又从叶中分离得到：山柰酚（kaempferol），槲皮素（quercetin），异槲皮素（isoquercitrin），三叶豆甙（trifolin），绿原酸，β-谷甾酸，蔗糖（sucrose）。"}]},{"ID":"20240611162653-kvcp564","Type":"NodeParagraph","Properties":{"id":"20240611162653-kvcp564","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.庐山石韦全草含里白烯，杧果甙，香草酸（vanillic acid），原儿茶酸（protocatechuic acid），延胡索酸（fumaric acid），咖啡酸（caffeic acid），β-谷甾醇，蔗糖，异杧果甙，绿原酸。"}]},{"ID":"20240611162653-neeor9u","Type":"NodeParagraph","Properties":{"id":"20240611162653-neeor9u","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.华北石韦全草含绿原酸。"}]},{"ID":"20240611162653-ndri2kg","Type":"NodeParagraph","Properties":{"id":"20240611162653-ndri2kg","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"4.有柄石韦全草含绿原酸。北京产者还含杧果甙，而四川产者不含杧果甙。"}]},{"ID":"20240611162653-g6bf1im","Type":"NodeParagraph","Properties":{"id":"20240611162653-g6bf1im","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240611162653-fzwrk9a","Type":"NodeParagraph","Properties":{"id":"20240611162653-fzwrk9a","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 1.庐山石韦：1.1.镇咳、祛痰、平喘作用：小鼠口服庐山石韦提取物101（水煎浓缩液）、410、411、1A母及晶1均有明显镇咳作用（二氧化硫引咳法），但均不及可待因。从小鼠半数致死量和镇咳有效剂量的比值来看，410用半数致死量的1／10即有明显镇咳效应，其效价高于原生药和其他成分。小鼠口服410，腹腔注射410、411、411-1C、1A母、晶4均有明显的祛痰作用（酚红法）。在位气管袋的狗每天服410，连服3或6周，气管袋内的痰量未有明显变化，但临床用于治疗慢性气管炎，可使痰量减少，可能由于气管袋没有慢性炎症，痰液没有病理性增高之故。但各种提取物均无明显平喘作用（豚鼠组织胺喷雾法）。"}]},{"ID":"20240611162653-ggwofcu","Type":"NodeParagraph","Properties":{"id":"20240611162653-ggwofcu","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"1.2.对大鼠慢性气管炎的治疗作用：用二氧化硫刺激产生慢性气管炎后，每天口服410，10天为一疗程，共两个疗程，用药组浆液腺和粘液腺腺泡的体积都比对照组小，大、小支气管的杯状细胞均比对照组少，尤以小支气管中的减少较为明显。这与临床上用药后痰液减少的现象是符合的。此外，用药组的炎症以及上皮细胞的病变也比对照组轻，这可能和支气管内粘液的分泌、积聚减少，改善了局部及全身情况有关。是否庐山石韦本身有非特异性抗炎作用，有待进一步研究。"}]},{"ID":"20240611162653-q9w12ll","Type":"NodeParagraph","Properties":{"id":"20240611162653-q9w12ll","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.有柄石韦：2.1.镇咳平喘作用：小鼠口服庐山石韦提取物（水煎液）及异芒果甙均有明显的镇咳作用（二氧化硫引咳法），但不及可待因的作用明显。有柄石韦水煎浓缩后之乙醇提取液，用石灰乳调节至pH＝9，滤液先后通过阳离子和阴离子交换树脂，流出浓减压蒸干得浓缩Ⅰ号，阴离子应用5%氢氧化钠洗涤，洗脱液经中和，冷冻，去盐，蒸干得浓缩Ⅱ号。小鼠口服浓缩Ⅰ号及Ⅱ号均有明显的镇咳作用（氨水喷雾引咳法），Ⅰ号的镇咳效果与可待因相近。经药理筛选延胡索酸2g/kg、咖啡酸0.3g/kg，或异芒果甙0.8g/kg灌胃，对小鼠SO2引咳均有镇咳作用。经小鼠酚红法试验，异芒果甙0.4g/kg或咖啡酸0.8g/kg腹腔注射或异芒果甙3.1g/kg灌胃，均有祛痰作用，但庐山石韦水煎浓缩液15g／kg腹腔注射和50g／kg灌胃均无祛痰作用，可能是剂量不够。也有减少支气管液的分泌作用。"}]},{"ID":"20240611162653-t7ia35k","Type":"NodeParagraph","Properties":{"id":"20240611162653-t7ia35k","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.2.抗菌作用：100%石韦煎剂用平板打洞法、对金黄色葡萄球菌及变形杆菌有抑制作用。"}]},{"ID":"20240611162653-0lze0ie","Type":"NodeParagraph","Properties":{"id":"20240611162653-0lze0ie","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.3.抗病原微生物作用：异芒果甙具有显着的抗单纯疱疹病毒作用，在原代人胚肌皮单层细胞培养上25-250ug/ml的异芒果甙与Ⅰ型单纯疱疹病毒（HSV-Ⅰ）直接作用、药物在病毒感谢同时以及先感染病后给药或先给药后感染均能显着抑制HSV-Ⅰ所致细胞病变，在同样浓度时，其作用较其它药为强；异亡果甙\u003e碘苷\u003e无环鸟苷\u003e亡果甙\u003e环胞苷（平均空斑减数率分别为69.5%、67.6%、63.3%、56.8%及56.6%）。阻止病毒复制的动力学研究表明，异芒果甙2.4.其它作用：石韦能增强机体吞噬细胞的吞噬活性，并有某些抗癌作用。将石韦以热水浸出再冷冻干燥，使浓度为样品的750mg／ml浓度时，在体外试验中，对前列腺素生物合成的抑制率为42%。"}]},{"ID":"20240611162653-tfcp23f","Type":"NodeParagraph","Properties":{"id":"20240611162653-tfcp23f","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240611162653-dfr2wba","Type":"NodeParagraph","Properties":{"id":"20240611162653-dfr2wba","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 1.拣净杂质，洗去泥沙，刷净茸毛，切段晒干。"}]},{"ID":"20240611162653-3fw6igc","Type":"NodeParagraph","Properties":{"id":"20240611162653-3fw6igc","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.《别录》：用之须去黄毛。"}]},{"ID":"20240611162653-wrtjs7i","Type":"NodeParagraph","Properties":{"id":"20240611162653-wrtjs7i","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：入药去梗，须微炙用。一法以羊脂炒干用。"}]},{"ID":"20240611162653-xhrb6ph","Type":"NodeParagraph","Properties":{"id":"20240611162653-xhrb6ph","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240611162653-th6rrya","Type":"NodeParagraph","Properties":{"id":"20240611162653-th6rrya","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" （1）取石韦、庐山石韦、华北石韦、有柄石韦粉末各5g，置索氏提取器中，用甲醇提取至提取液近无色。取提取液各2ml分置试管中，加镁粉少许，再加浓盐酸1-2滴，除有柄石韦外，其余3种石韦提取液均沿管壁出现粉红色。（检查黄酮类）（2）薄层色谱 取石韦、庐山石韦、华北石韦、有柄石韦粉末各5g，置索氏提取器中用石油醚（沸程60-90℃）-氯仿（3：1）适量提取，至提取液近无色，浓缩提取液至2.5ml作为供试品溶液。取4种供试品溶液及里白烯对照品溶液，分别点样于同一硅胶G（青岛）薄层板上，以正己烷上行展开，取出晾干，喷5%磷钼酸乙醇溶液，120℃烘10min，供试品层析色谱中，在与对照品色谱相同位置上，显相同的色斑。"}]},{"ID":"20240611162653-bjkvhuh","Type":"NodeParagraph","Properties":{"id":"20240611162653-bjkvhuh","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"以同样方法进行薄层色谱，以β-谷甾醇为对照品，用正己烷-丙酮（5：1）展开，喷5%浓硫酸的乙醇溶液，于120℃烘10min，供试品层析色谱中，在与对照品色谱相同位置上，显相同的色斑。"}]},{"ID":"20240611162653-mny117a","Type":"NodeParagraph","Properties":{"id":"20240611162653-mny117a","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240611162653-1y8waaz","Type":"NodeParagraph","Properties":{"id":"20240611162653-1y8waaz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 肺；肾；膀胱经"}]},{"ID":"20240611162653-iijx2oj","Type":"NodeParagraph","Properties":{"id":"20240611162653-iijx2oj","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611162653-7x5mfbf","Type":"NodeParagraph","Properties":{"id":"20240611162653-7x5mfbf","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 苦；甘；寒"}]},{"ID":"20240611162653-ckvtn9x","Type":"NodeParagraph","Properties":{"id":"20240611162653-ckvtn9x","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240611162653-cfslora","Type":"NodeParagraph","Properties":{"id":"20240611162653-cfslora","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 阴虚及无湿热者忌服。"}]},{"ID":"20240611162653-4m1prkd","Type":"NodeParagraph","Properties":{"id":"20240611162653-4m1prkd","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611162653-lmv619j","Type":"NodeParagraph","Properties":{"id":"20240611162653-lmv619j","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 利水通淋；清肺化痰；凉血止血。主淋病；水肿；小便不利；痰热咳喘；咯血；吐血；衄血；崩漏；外伤出血"}]},{"ID":"20240611162653-4qk402u","Type":"NodeParagraph","Properties":{"id":"20240611162653-4qk402u","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611162653-bb3fgql","Type":"NodeParagraph","Properties":{"id":"20240611162653-bb3fgql","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g；或研末。外用：适量，研末涂敷。"}]},{"ID":"20240611162653-8hyr07u","Type":"NodeParagraph","Properties":{"id":"20240611162653-8hyr07u","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611162653-y24zd5z","Type":"NodeParagraph","Properties":{"id":"20240611162653-y24zd5z","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 石韦散《千金要方》：通淋止血。石韦汤《全生指迷方》：小便不利；小腹胀痛；"}]},{"ID":"20240611162653-pdndkjv","Type":"NodeParagraph","Properties":{"id":"20240611162653-pdndkjv","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240611162653-sifkup2","Type":"NodeParagraph","Properties":{"id":"20240611162653-sifkup2","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 1.《本草崇原》：石韦，主治劳热邪气者，劳热在骨，邪气在皮，肺肾之所主也。五癃者，五液癃闭，小便不利也。石韦助肺肾之精气，上下相交，水精上濡，则上窍外窍皆通，肺气下化，则水道行而小便利矣。"}]},{"ID":"20240611162653-m8sdfhu","Type":"NodeParagraph","Properties":{"id":"20240611162653-m8sdfhu","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"2.《本经逢原》：石韦，其性寒利，故《本经》治劳热邪气，指劳力伤津，癃闭不通之热邪而言，非虚劳之谓。治妊娠转胞，同车前煎服。"}]},{"ID":"20240611162653-l6lx8iz","Type":"NodeParagraph","Properties":{"id":"20240611162653-l6lx8iz","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"3.《长沙药解》：石韦，清金泄热，利水开癃，《金匮》鳖甲煎丸用之治疟日久结为症瘕，以其泄水而消瘀也。"}]},{"ID":"20240611162653-4v84wxa","Type":"NodeParagraph","Properties":{"id":"20240611162653-4v84wxa","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"4.《本经》：主劳热邪气，五癃闭不通，利小便水道。"}]},{"ID":"20240611162653-gv7jnwi","Type":"NodeParagraph","Properties":{"id":"20240611162653-gv7jnwi","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"5.《别录》：止烦下气，通膀胱满，补五劳，安五藏，去恶风，益精气。"}]},{"ID":"20240611162653-5cw7y68","Type":"NodeParagraph","Properties":{"id":"20240611162653-5cw7y68","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：治淋沥遗溺。"}]},{"ID":"20240611162653-civq6ee","Type":"NodeParagraph","Properties":{"id":"20240611162653-civq6ee","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"7.《本草图经》：炒末，冷酒调服，疗发背。"}]},{"ID":"20240611162653-2nn2onr","Type":"NodeParagraph","Properties":{"id":"20240611162653-2nn2onr","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"8.《滇南本草》：止玉茎痛。"}]},{"ID":"20240611162653-z9m3mgg","Type":"NodeParagraph","Properties":{"id":"20240611162653-z9m3mgg","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"9.《纲目》：主崩漏，金疮，清肺气。"}]},{"ID":"20240611162653-ydbhyxo","Type":"NodeParagraph","Properties":{"id":"20240611162653-ydbhyxo","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"10.《植物名实图考》：治痰火，同瘦肉蒸服。"}]},{"ID":"20240611162653-gemt1fu","Type":"NodeParagraph","Properties":{"id":"20240611162653-gemt1fu","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"11.《闽东本草》：治痢疾。"}]},{"ID":"20240611162653-8u9vxyw","Type":"NodeParagraph","Properties":{"id":"20240611162653-8u9vxyw","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611162653-ffi0aks","Type":"NodeParagraph","Properties":{"id":"20240611162653-ffi0aks","updated":"20240611162653"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611162655-j4qaa8p","Type":"NodeThematicBreak","Properties":{"id":"20240611162655-j4qaa8p"}},{"ID":"20240611162656-scuqhpa","Type":"NodeParagraph","Properties":{"id":"20240611162656-scuqhpa"}}]}