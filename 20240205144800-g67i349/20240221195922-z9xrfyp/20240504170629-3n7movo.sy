{"ID":"20240504170629-3n7movo","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240504170629-3n7movo","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504170629-3n7movo\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504170629-oez8mu2\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612082948-30kesj6\u0026quot;,\u0026quot;scrollTop\u0026quot;:38,\u0026quot;focusId\u0026quot;:\u0026quot;20240612083212-xugc3tg\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"201蜀羊泉（青杞）","type":"doc","updated":"20240820171455"},"Children":[{"ID":"20240625164002-lw1wdzu","Type":"NodeParagraph","Properties":{"id":"20240625164002-lw1wdzu","updated":"20240625164005"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 416px;","style":"width: 406px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240625164002-xv48j0j.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 406px;\" parent-style=\"width: 416px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820170429-inda88z","Type":"NodeParagraph","Properties":{"id":"20240820170429-inda88z","updated":"20240820170551"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜀羊泉 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜀羊泉 8-20240820170515-lsdg305.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properti