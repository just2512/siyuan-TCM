"},{"Type":"NodeLinkDest","Data":"assets/蜀羊泉 12-20240820171015-v1cbqgl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820170611-1zuwvw6","Type":"NodeParagraph","Properties":{"id":"20240820170611-1zuwvw6","updated":"20240820170923"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 435px;","style":"width: 425px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜀羊泉 (9)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜀羊泉 9-20240820170611-e3t0tl6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 425px;\" parent-style=\"width: 435px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 860px;","style":"width: 850px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蜀羊泉 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蜀羊泉 11-20240820170923-0on1q8f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 850px;\" parent-style=\"width: 860px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612083115-lfnb42w","Type":"NodeThematicBreak","Properties":{"id":"20240612083115-lfnb42w"}},{"ID":"20240612083125-gk1eo6o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083125-gk1eo6o","updated":"20240612083132"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《神农本草经》"}]},{"ID":"20240612083125-8ngifxg","Type":"NodeParagraph","Properties":{"id":"20240612083125-8ngifxg","updated":"20240612083125"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240612083125-vc9efyy","Type":"NodeParagraph","Properties":{"id":"20240612083125-vc9efyy","updated":"20240612083125"},"Children":[{"Type":"NodeText","Data":"主头秃恶创，热气，疥搔，痂癣虫，疗龋齿。生川谷。"}]},{"ID":"20240612083125-b666roo","Type":"NodeParagraph","Properties":{"id":"20240612083125-b666roo","updated":"20240612083125"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名羊泉，一名饴，生蜀郡。"}]},{"ID":"20240612083125-xoivxwn","Type":"NodeParagraph","Properties":{"id":"20240612083125-xoivxwn","updated":"20240612083125"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：桼姑，艾但鹿何，泽也。《唐本》注云：此草，一名漆姑。"}]},{"ID":"20240612083136-q6y1dsb","Type":"NodeThematicBreak","Properties":{"id":"20240612083136-q6y1dsb"}},{"ID":"20240612083137-z4c3yj5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083137-z4c3yj5","updated":"20240612083142"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《千金翼方》"}]},{"ID":"20240612083137-6uq7pds","Type":"NodeParagraph","Properties":{"id":"20240612083137-6uq7pds","updated":"20240612083137"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主头秃恶疮，热气，疥瘙痂癣虫，疗龋齿，女子阴中内伤，皮间实积。一名羊泉，一名羊饴。生蜀郡川谷。"}]},{"ID":"20240612083211-a8m61lu","Type":"NodeThematicBreak","Properties":{"id":"20240612083211-a8m61lu"}},{"ID":"20240612083212-xugc3tg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083212-xugc3tg","updated":"20240612083217"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《证类本草》"}]},{"ID":"20240612083212-n8gqpyd","Type":"NodeParagraph","Properties":{"id":"20240612083212-n8gqpyd","updated":"20240612083212"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主头秃恶疮，热气，疥瘙痂癣虫，疗龋齿，女子阴中内伤，皮间实积。一名羊泉，一名羊饴。生蜀郡川谷。"}]},{"ID":"20240612083212-9e98q9j","Type":"NodeParagraph","Properties":{"id":"20240612083212-9e98q9j","updated":"20240612083212"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方药亦不复用，彼土人时有采识者。唐本注云∶此草俗名漆姑。叶似菊，花紫色，子类枸杞子，根如远志，无心有糁。苗主小儿惊，兼疗漆疮，生毛发，所在平泽皆有之。"}]},{"ID":"20240612083212-k1dgqk9","Type":"NodeParagraph","Properties":{"id":"20240612083212-k1dgqk9","updated":"20240612083212"},"Children":[{"Type":"NodeText","Data":"今按别本注云∶今处处有，生阴湿地，三月、四月采苗、叶、阴干之。"}]},{"ID":"20240612083152-dnj61f2","Type":"NodeThematicBreak","Properties":{"id":"20240612083152-dnj61f2"}},{"ID":"20240612083153-s8gkoko","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083153-s8gkoko","updated":"20240612083157"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《名医别录》"}]},{"ID":"20240612083153-21w4zk3","Type":"NodeParagraph","Properties":{"id":"20240612083153-21w4zk3","updated":"20240612083153"},"Children":[{"Type":"NodeText","Data":"无毒．主治龋齿，女子阴中内伤，皮间实积．一名羊泉，一名羊饴．生蜀郡．"}]},{"ID":"20240612083153-0nti812","Type":"NodeParagraph","Properties":{"id":"20240612083153-0nti812","updated":"20240612083153"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶蜀羊泉，味苦，微寒．主头秃恶疮热气，疥瘙痂癣虫．生川谷．"}]},{"ID":"20240612083115-lergrza","Type":"NodeThematicBreak","Properties":{"id":"20240612083115-lergrza"}},{"ID":"20240612083116-4lwvshd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083116-4lwvshd","updated":"20240612083121"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《医学入门》"}]},{"ID":"20240612083116-znubh5h","Type":"NodeParagraph","Properties":{"id":"20240612083116-znubh5h","updated":"20240612083116"},"Children":[{"Type":"NodeText","Data":"俗名漆姑叶，似菊花，紫色。子类枸杞子，根如远志，无心有糁。味苦、寒，无毒。主头秃，恶疮，热气，疥痂癣虫，漆疮，龋齿，女子阴中内伤，皮间实积，小儿惊痫。三四月采苗叶，阴干用。"}]},{"ID":"20240612082944-zxyrdt9","Type":"NodeThematicBreak","Properties":{"id":"20240612082944-zxyrdt9"}},{"ID":"20240612083104-klkwuhd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083104-klkwuhd","updated":"20240612083109"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《神农本草经赞》"}]},{"ID":"20240612083104-zhe9k79","Type":"NodeParagraph","Properties":{"id":"20240612083104-zhe9k79","updated":"20240612083104"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主头秃。恶创热气。疥搔痂癣。虫疗龋齿。生川谷。"}]},{"ID":"20240612083104-3488sh8","Type":"NodeParagraph","Properties":{"id":"20240612083104-3488sh8","updated":"20240612083104"},"Children":[{"Type":"NodeText","Data":"沃饶西蜀。阴湿萌生。蚓吹流肿。蜂缀坚茎。细区鼠迹。滑误鸦睛。功收漆啮。涂浴兼营。"}]},{"ID":"20240612083104-s4olh6o","Type":"NodeParagraph","Properties":{"id":"20240612083104-s4olh6o","updated":"20240612083104"},"Children":[{"Type":"NodeText","Data":"卢思道诗。西蜀称天府。由来擅沃饶。苏恭曰。俗名漆姑。生阴湿地。颜延之诗。惠浸萌生。摘元方。蚯蚓气吹者。捣入黄丹之。李时珍曰。黄蜂作窠。漆姑草为蒂。陈藏器曰。"}]},{"ID":"20240612083104-a00ei6s","Type":"NodeParagraph","Properties":{"id":"20240612083104-a00ei6s","updated":"20240612083104"},"Children":[{"Type":"NodeText","Data":"漆姑叶细。多生石边。苏恭曰。捣涂漆疮。羊泉乃大草。漆姑草如鼠迹大。生阶墀间。乃同名也。苏颂曰。或言老鸦眼睛草。李时珍谓此乃龙葵也。性滑如葵。苏误认。耳生漆疮者。"}]},{"ID":"20240612083104-jnjgp5o","Type":"NodeParagraph","Properties":{"id":"20240612083104-jnjgp5o","updated":"20240612083104"},"Children":[{"Type":"NodeText","Data":"煎汤浴之。"}]},{"ID":"20240612082944-kkffluj","Type":"NodeThematicBreak","Properties":{"id":"20240612082944-kkffluj"}},{"ID":"20240612083053-xow8ow9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083053-xow8ow9","updated":"20240612083059"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《新修本草》"}]},{"ID":"20240612083053-qvp4i8r","Type":"NodeParagraph","Properties":{"id":"20240612083053-qvp4i8r","updated":"20240612083053"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主头秃，恶疮，热气，疥瘙痂癣虫。疗龋齿，女子阴中内伤，皮间实积。一名羊泉，一名羊饴。"}]},{"ID":"20240612083053-rgmyhnl","Type":"NodeParagraph","Properties":{"id":"20240612083053-rgmyhnl","updated":"20240612083053"},"Children":[{"Type":"NodeText","Data":"生蜀郡川谷。"}]},{"ID":"20240612083053-5x6724s","Type":"NodeParagraph","Properties":{"id":"20240612083053-5x6724s","updated":"20240612083053"},"Children":[{"Type":"NodeText","Data":"方药亦不复用，彼土人时有采识者。"}]},{"ID":"20240612083053-80t3r5h","Type":"NodeParagraph","Properties":{"id":"20240612083053-80t3r5h","updated":"20240612083053"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草，俗名漆姑，叶似菊，花紫色。子类枸杞子，根如远志，无心有糁。苗主小儿惊，兼疗漆疮，生毛发。所在平泽皆有之。"}]},{"ID":"20240612082944-nnl0mj2","Type":"NodeThematicBreak","Properties":{"id":"20240612082944-nnl0mj2"}},{"ID":"20240612083002-k4halol","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083002-k4halol","updated":"20240612083008"},"Children":[{"Type":"NodeText","Data":"蜀羊泉《本草纲目》"}]},{"ID":"20240612083002-7hond75","Type":"NodeParagraph","Properties":{"id":"20240612083002-7hond75","updated":"20240612083002"},"Children":[{"Type":"NodeText","Data":"「释名」羊泉、羊饴、漆姑草。"}]},{"ID":"20240612083002-lo385e7","Type":"NodeParagraph","Properties":{"id":"20240612083002-lo385e7","updated":"20240612083002"},"Children":[{"Type":"NodeText","Data":"「气味」苦、微寒、无毒。"}]},{"ID":"20240612083002-zbdyi7s","Type":"NodeParagraph","Properties":{"id":"20240612083002-zbdyi7s","updated":"20240612083002"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612083002-c3wkaol","Type":"NodeParagraph","Properties":{"id":"20240612083002-c3wkaol","updated":"20240612083002"},"Children":[{"Type":"NodeText","Data":"1、黄疸。用蜀羊泉的把，捣汁和酒服，三、五次之后，即可见效。"}]},{"ID":"20240612083002-l9elibe","Type":"NodeParagraph","Properties":{"id":"20240612083002-l9elibe","updated":"20240612083002"},"Children":[{"Type":"NodeText","Data":"2、漆疮。用蜀羊泉捣烂涂搽。漆姑之名，由此而来。"}]},{"ID":"20240612082944-0fckvom","Type":"NodeThematicBreak","Properties":{"id":"20240612082944-0fckvom"}},{"ID":"20240612082945-zlyxo0k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612082945-zlyxo0k","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：蜀羊泉"}]},{"ID":"20240612082945-1r0bndj","Type":"NodeParagraph","Properties":{"id":"20240612082945-1r0bndj","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612082945-g1q204q","Type":"NodeParagraph","Properties":{"id":"20240612082945-g1q204q","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" Shǔ Yánɡ Quán"}]},{"ID":"20240612082945-jv1jf84","Type":"NodeParagraph","Properties":{"id":"20240612082945-jv1jf84","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612082945-a1j3jyf","Type":"NodeParagraph","Properties":{"id":"20240612082945-a1j3jyf","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 青杞、红葵、野苏子、野辣子、药人豆、野枸杞"}]},{"ID":"20240612082945-a36orp2","Type":"NodeParagraph","Properties":{"id":"20240612082945-a36orp2","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612082945-02j72l8","Type":"NodeParagraph","Properties":{"id":"20240612082945-02j72l8","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 茄科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜀羊泉"},{"Type":"NodeText","Data":"Solanum septemlobum Bunge，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240612082945-nmyx81l","Type":"NodeParagraph","Properties":{"id":"20240612082945-nmyx81l","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612082945-k8nk28c","Type":"NodeParagraph","Properties":{"id":"20240612082945-k8nk28c","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 吉林、辽宁、内蒙古、陕西、宁夏、甘肃。"}]},{"ID":"20240612082945-6kk7nkw","Type":"NodeParagraph","Properties":{"id":"20240612082945-6kk7nkw","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612082945-yx0tiu4","Type":"NodeParagraph","Properties":{"id":"20240612082945-yx0tiu4","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612082945-btkpwq8","Type":"NodeParagraph","Properties":{"id":"20240612082945-btkpwq8","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612082945-yimrvnk","Type":"NodeParagraph","Properties":{"id":"20240612082945-yimrvnk","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 清热解毒。主治咽喉肿痛。"}]},{"ID":"20240612082945-3rcsiw5","Type":"NodeParagraph","Properties":{"id":"20240612082945-3rcsiw5","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612082945-uop90lv","Type":"NodeParagraph","Properties":{"id":"20240612082945-uop90lv","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 鲜草2两，水煎服。"}]},{"ID":"20240612082945-arythek","Type":"NodeParagraph","Properties":{"id":"20240612082945-arythek","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612082945-2kumsml","Type":"NodeParagraph","Properties":{"id":"20240612082945-2kumsml","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612082945-dumywdr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612082945-dumywdr","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蜀羊泉"}]},{"ID":"20240612082945-8gc6zte","Type":"NodeParagraph","Properties":{"id":"20240612082945-8gc6zte","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612082945-bcnei8j","Type":"NodeParagraph","Properties":{"id":"20240612082945-bcnei8j","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" Shǔ Yánɡ Quán"}]},{"ID":"20240612082945-t7vhm09","Type":"NodeParagraph","Properties":{"id":"20240612082945-t7vhm09","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612082945-jkhjzrv","Type":"NodeParagraph","Properties":{"id":"20240612082945-jkhjzrv","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 羊泉、羊饴、漆姑、青杞、野茄、小孩拳、红葵、野茄子、野枸杞、野辣子、药人豆"}]},{"ID":"20240612082945-sdm6855","Type":"NodeParagraph","Properties":{"id":"20240612082945-sdm6855","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612082945-ymszdh4","Type":"NodeParagraph","Properties":{"id":"20240612082945-ymszdh4","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 蜀羊泉始录于《本经》。《别录》载：\"一名羊泉,一名羊饴,生蜀郡川谷。\"《新修本草》云：\"此草……叶似菊,花紫色,子类构杞子,根如远志,无心有糁。\"《救荒本草》青杞条说：\"青杞,《本草》名蜀羊泉。\"描述形态多同《新修本草》,并补记：\"苗高二尺余,叶似菊叶稍长,子生青熟红。\"与本种形态基本相符。《植物名实图考》蜀羊泉图与本种也相似。"}]},{"ID":"20240612082945-ser9tmq","Type":"NodeParagraph","Properties":{"id":"20240612082945-ser9tmq","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612082945-axk8ano","Type":"NodeParagraph","Properties":{"id":"20240612082945-axk8ano","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 药材基源：为茄科植物青杞的全草或果实。"}]},{"ID":"20240612082945-llegjzb","Type":"NodeParagraph","Properties":{"id":"20240612082945-llegjzb","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Solanum septemlobum Bunge"}]},{"ID":"20240612082945-t8brkui","Type":"NodeParagraph","Properties":{"id":"20240612082945-t8brkui","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季割取全草,洗净,切段,鲜用或晒干。"}]},{"ID":"20240612082945-j3gxslp","Type":"NodeParagraph","Properties":{"id":"20240612082945-j3gxslp","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612082945-1blhj9f","Type":"NodeParagraph","Properties":{"id":"20240612082945-1blhj9f","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 生态环境：生长于山坡向阳处。"}]},{"ID":"20240612082945-pcj6d18","Type":"NodeParagraph","Properties":{"id":"20240612082945-pcj6d18","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于内蒙古、山西、陕西、甘肃、新疆、山东、江苏、安徽、河南及四川等地。"}]},{"ID":"20240612082945-qf1xgek","Type":"NodeParagraph","Properties":{"id":"20240612082945-qf1xgek","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612082945-4bby3ae","Type":"NodeParagraph","Properties":{"id":"20240612082945-4bby3ae","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 多年生直立草本，高约50cm。茎具棱角，多分枝。叶互生；叶柄长1-2cm；叶往卵形，长3-7cm，宽2-5cm，为不整齐的羽状分裂，裂片阔线形或披针形，先端渐尖，基部突窄，延为叶柄。二歧聚伞花序，顶生或腋外生；总花梗长约1-2.5cm；花梗长5-8mm，基部具关节；萼小，杯状，5裂，萼齿三角形；花冠青紫色，先端深5裂，裂片长圆形；雄蕊5；子房卵形，2室，柱头头状。浆果近球形，熟时红色；种子扁圆形。花期夏秋间，果熟期秋末冬初。"}]},{"ID":"20240612082945-t65sv4k","Type":"NodeParagraph","Properties":{"id":"20240612082945-t65sv4k","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612082945-p7xpz7w","Type":"NodeParagraph","Properties":{"id":"20240612082945-p7xpz7w","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 味苦；性寒；小毒"}]},{"ID":"20240612082945-bc6b4e7","Type":"NodeParagraph","Properties":{"id":"20240612082945-bc6b4e7","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612082945-dscpa62","Type":"NodeParagraph","Properties":{"id":"20240612082945-dscpa62","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 清热解毒。主咽喉肿痛；目昏赤；乳腺炎；肋腺炎；疥癣；疥癣瘙痒"}]},{"ID":"20240612082945-t047jl6","Type":"NodeParagraph","Properties":{"id":"20240612082945-t047jl6","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612082945-ndqf0mt","Type":"NodeParagraph","Properties":{"id":"20240612082945-ndqf0mt","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g。外用：适量，捣敷；或煎水熏洗。"}]},{"ID":"20240612082945-vb9c3d7","Type":"NodeParagraph","Properties":{"id":"20240612082945-vb9c3d7","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612082945-6r16pvw","Type":"NodeParagraph","Properties":{"id":"20240612082945-6r16pvw","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 蜀羊泉,《本草经考注》:“羊泉为羊涎之假借……作蜀羊泉者,谓生蜀郡也。”“此物茎叶有粘液如漆,故有羊涎及漆姑之名也。”"}]},{"ID":"20240612082945-c35zsg1","Type":"NodeParagraph","Properties":{"id":"20240612082945-c35zsg1","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612082945-bqo7wld","Type":"NodeParagraph","Properties":{"id":"20240612082945-bqo7wld","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 1.《救荒本草》：\"青杞,《本草》名蜀羊泉,今祥符县西田野中有之。苗高二尺余,叶似菊叶稍长,花开紫色。子类枸杞子,生青熟红。根如远志,无心有椮。采嫩叶煠熟,水浸去苦味,淘洗净,油盐调食。\"2.《纲目》：\"漆姑有二种：苏恭所说是羊泉,陶陈所说是小草。苏颂所说老鸦眼睛草,乃龙葵也。又黄蜂作窠,衔漆姑草汁为蒂,即此草也。\""}]},{"ID":"20240612082945-4t4tlck","Type":"NodeParagraph","Properties":{"id":"20240612082945-4t4tlck","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612082945-807qxx7","Type":"NodeParagraph","Properties":{"id":"20240612082945-807qxx7","updated":"20240612082945"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612082947-wigpnbq","Type":"NodeThematicBreak","Properties":{"id":"20240612082947-wigpnbq"}},{"ID":"20240612082948-30kesj6","Type":"NodeParagraph","Properties":{"id":"20240612082948-30kesj6"}}]}