pe":"NodeLinkDest","Data":"assets/栝楼 1-20240717195447-b9ub8ih.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717113031-qhicuru","Type":"NodeParagraph","Properties":{"id":"20240717113031-qhicuru","updated":"20240813151247"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 661px;","style":"width: 651px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"瓜蒌 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/瓜蒌 5-20240717114258-actbrkr.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 651px;\" parent-style=\"width: 661px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 594px;","style":"width: 584px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栝楼根"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栝楼根-20240624124018-j363hwo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 584px;\" parent-style=\"width: 594px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717114347-9um8yzg","Type":"NodeParagraph","Properties":{"id":"20240717114347-9um8yzg","updated":"20240813151252"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1087px;","style":"width: 1077px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"瓜蒌 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/瓜蒌 6-20240717114347-6wf6vuj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1077px;\" parent-style=\"width: 1087px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717195322-hfwli8o","Type":"NodeParagraph","Properties":{"id":"20240717195322-hfwli8o","updated":"20240813151259"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"栝楼"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/栝楼-20240717195322-ckldc94.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611131436-xi5ehtl","Type":"NodeThematicBreak","Properties":{"id":"20240611131436-xi5ehtl"}},{"ID":"20240611131438-xrrnomv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131438-xrrnomv","updated":"20240611131443"},"Children":[{"Type":"NodeText","Data":"栝蒌根《本经逢原》"}]},{"ID":"20240611131438-mezpit0","Type":"NodeParagraph","Properties":{"id":"20240611131438-mezpit0","updated":"20240611131438"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即天花粉"}]},{"ID":"20240611131438-jvt4rth","Type":"NodeParagraph","Properties":{"id":"20240611131438-jvt4rth","updated":"20240611131438"},"Children":[{"Type":"NodeText","Data":"苦寒，无毒。反乌附。"}]},{"ID":"20240611131438-okz2ful","Type":"NodeParagraph","Properties":{"id":"20240611131438-okz2ful","updated":"20240611131438"},"Children":[{"Type":"NodeText","Data":"《本经》主消渴身热、烦满大热，补虚安中，续绝伤。"}]},{"ID":"20240611131438-7zqucku","Type":"NodeParagraph","Properties":{"id":"20240611131438-7zqucku","updated":"20240611131438"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"栝蒌根性寒，降膈上热痰，润心中烦渴，除时疾狂热，祛酒瘅湿黄，治痈疡解毒排脓。《本经》有安中补虚，续绝伤之称，以其有清胃祛热之功，火去则中气安，津液复，则血气和，而绝伤续矣。其性寒降，凡胃虚吐逆，阴虚劳咳误用，反伤胃气，久必泄泻喘咳，病根愈固矣。凡痰饮色白清稀者，皆当忌用。"}]},{"ID":"20240611131345-9u2q02u","Type":"NodeThematicBreak","Properties":{"id":"20240611131345-9u2q02u"}},{"ID":"20240611131421-zdy99xb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131421-zdy99xb","updated":"20240611131428"},"Children":[{"Type":"NodeText","Data":"栝蒌根《名医别录》"}]},{"ID":"20240611131421-7afbo09","Type":"NodeParagraph","Properties":{"id":"20240611131421-7afbo09","updated":"20240611131421"},"Children":[{"Type":"NodeText","Data":"无毒．主除肠胃中痼热，八疸，身面黄，唇干口燥，短气，通月水，止小便利，一裸，一名天瓜，一名泽姑．实，名黄瓜，治胸痹，悦泽人面．茎叶，治中热伤暑．生洪山阴地，入土深者良，生卤地者有毒．二月、八月采根，曝干，三十日成．（枸杞为之恶干姜，畏牛膝、干漆，反乌头．）"}]},{"ID":"20240611131421-xb3wb2i","Type":"NodeParagraph","Properties":{"id":"20240611131421-xb3wb2i","updated":"20240611131421"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶栝蒌根，味苦，寒．主消渴身热，烦满大热，补虚安中，续绝伤．一名地蒌．生川谷．"}]},{"ID":"20240611131356-3uh1jov","Type":"NodeThematicBreak","Properties":{"id":"20240611131356-3uh1jov"}},{"ID":"20240611131408-t92ue0d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131408-t92ue0d","updated":"20240611131414"},"Children":[{"Type":"NodeText","Data":"栝蒌根《神农本草经赞》"}]},{"ID":"20240611131408-pb3r526","Type":"NodeParagraph","Properties":{"id":"20240611131408-pb3r526","updated":"20240611131408"},"Children":[{"Type":"NodeText","Data":"味苦寒。主消渴身热。烦满大热。补虚安中。续绝伤。一名地蒌。生川谷及山阴。"}]},{"ID":"20240611131408-vo3wv2p","Type":"NodeParagraph","Properties":{"id":"20240611131408-vo3wv2p","updated":"20240611131408"},"Children":[{"Type":"NodeText","Data":"果兼名。幽根蟠结。粉沁秋霜。花霏瑞雪。枯润津回。阴纯体洁。入夏筋凝。毒防卤啮。"}]},{"ID":"20240611131408-t4le04r","Type":"NodeParagraph","Properties":{"id":"20240611131408-t4le04r","updated":"20240611131408"},"Children":[{"Type":"NodeText","Data":"李时珍曰。栝蒌即果裸转音。木上曰果。地下曰。此物蔓生附木。故得兼名。洁白如雪。"}]},{"ID":"20240611131408-d147qrs","Type":"NodeParagraph","Properties":{"id":"20240611131408-d147qrs","updated":"20240611131408"},"Children":[{"Type":"NodeText","Data":"故名瑞雪。苏颂曰。一名天花粉。沈约诗。幽根未蟠结。成无己曰。润枯燥而通行津液。"}]},{"ID":"20240611131408-zc88z6q","Type":"NodeParagraph","Properties":{"id":"20240611131408-zc88z6q","updated":"20240611131408"},"Children":[{"Type":"NodeText","Data":"李杲曰。纯阴解烦渴。傅咸赋。体洁性真。李时珍曰。夏月掘者有筋无粉。不堪用。名医曰。"}]},{"ID":"20240611131408-69zwnea","Type":"NodeParagraph","Properties":{"id":"20240611131408-69zwnea","updated":"20240611131408"},"Children":[{"Type":"NodeText","Data":"生卤地者有毒。"}]},{"ID":"20240611131526-946qh1x","Type":"NodeThematicBreak","Properties":{"id":"20240611131526-946qh1x"}},{"ID":"20240611131527-bbcp1pm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131527-bbcp1pm","updated":"20240611131539"},"Children":[{"Type":"NodeText","Data":"栝蒌《证类本草》"}]},{"ID":"20240611131527-y9o6nqc","Type":"NodeParagraph","Properties":{"id":"20240611131527-y9o6nqc","updated":"20240611131527"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴，身热烦满，大热，补虚安中，续绝伤，除肠胃中痼热八疸，身面黄，唇干口燥，短气，通月水，止小便利。一名地楼，一名果裸，一名天瓜，一名泽姑。"}]},{"ID":"20240611131527-gziafbd","Type":"NodeParagraph","Properties":{"id":"20240611131527-gziafbd","updated":"20240611131527"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实"},{"Type":"NodeText","Data":"名黄瓜，主胸痹，悦泽人面。"}]},{"ID":"20240611131527-7zmdx7d","Type":"NodeParagraph","Properties":{"id":"20240611131527-7zmdx7d","updated":"20240611131527"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎、叶"},{"Type":"NodeText","Data":"疗中热伤暑。生洪农川谷及山阴地，入土深者良，生卤地者有毒。二月、八月采根陶隐居云∶出近道，藤生，状如土瓜而叶有叉。《毛诗》云∶果裸之实，亦施于宇。其实，今以杂作手膏用。根入土六、七尺，大二、三围者，服食亦用之。唐本注云∶今用根作粉，大宜服石，虚热人食之。作粉如作葛粉法，洁白美好。今出陕州者，白实最佳。臣禹锡等谨按尔雅云∶果裸之实，栝蒌。释曰∶果裸之草，其实名栝蒌。郭云∶今齐人谓之天瓜。日华子云∶栝蒌子，味苦，冷，无毒。补虚劳，口干，润心肺，疗手面皱，吐血，肠风泻血，赤白痢，并炒用。又栝蒌根，通小肠，排脓，消肿毒，生肌长肉，消扑损瘀血，治热狂时疾，乳痈，发背，痔 ，疮疖。"}]},{"ID":"20240611131527-k9tdhl0","Type":"NodeParagraph","Properties":{"id":"20240611131527-k9tdhl0","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"图经曰∶栝蒌，生洪农山谷及山阴地，今所在有之。实名黄瓜。《诗》所谓果裸之实是也。"}]},{"ID":"20240611131527-eetxz1y","Type":"NodeParagraph","Properties":{"id":"20240611131527-eetxz1y","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"根亦名白药，皮黄肉白。三、四月内生苗，引藤蔓。叶如甜瓜叶，作叉，有细毛。七月开花，似葫芦花，浅黄色。实在花下，大如拳，生青，至九月熟，赤黄色。二月、八月采根，刮去皮，曝干，三十日成。其实有正圆者，有锐而长者，功用皆同。其根唯岁久入土深者佳，卤地生者有毒。谨按栝蒌主消渴，古方亦单用之。孙思邈作粉法∶深掘大根，浓削皮至白处，寸切之，水浸，一日一易水，经五日取出，烂捣研，以绢袋盛之，澄滤令极细如粉，去水。服方寸匕，日三、四服，亦可作粉粥，乳酪中食之，并宜。卒患胸痹痛，取大实一枚切，薤白半升，以白酒七升，煮取二升，分再服。一方∶加半夏四两，汤洗去滑，同煮服更善。"}]},{"ID":"20240611131527-vl1xqqw","Type":"NodeParagraph","Properties":{"id":"20240611131527-vl1xqqw","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"又唐·崔元亮疗箭镞不出。捣根敷疮，日三易，自出。又疗时疾发黄，心狂烦热，闷不认人者。取大实一枚黄者，以新汲水九合，浸淘取汁，下蜜半大合，朴硝八分，合搅令消尽，分再服，便瘥。"}]},{"ID":"20240611131527-phvtxg8","Type":"NodeParagraph","Properties":{"id":"20240611131527-phvtxg8","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"雷公云∶栝蒌，凡使皮、子、茎、根，效各别。其栝并蒌样全别。若栝，自圆，黄皮浓蒂小。"}]},{"ID":"20240611131527-gfjtrfk","Type":"NodeParagraph","Properties":{"id":"20240611131527-gfjtrfk","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"若蒌，唯形长，赤皮蒂粗，是阴人服。若修事，去上壳皮革膜并油了。使根，待构二、三围，去皮细捣作煎搅取汁，冷冻饮料任用也。食疗子，下乳汁。又，治痈肿。栝蒌根苦酒中熬燥，捣筛之，苦酒和，涂纸上摊贴。服金石人宜用。圣惠方∶治热病头疼发热进退方∶用栝蒌一枚大者，取其瓤细锉，置瓷碗中，用热汤一盏沃之，盖却良久，去滓，不计时候顿服。又方∶治中风口眼 斜。用栝蒌绞取汁，和大麦面搜作饼，炙令热熨。正便止，勿令太过。外台秘要∶治消渴利方∶生栝蒌三十斤，以水一硕，煮取一斗半，去滓，以牛脂五合，煎取水尽。以暖酒先食服如鸡子大，日三服，即炒。又方∶主伤寒渴饮。栝蒌根三两，以水五升，煮取一升。"}]},{"ID":"20240611131527-17ol0d3","Type":"NodeParagraph","Properties":{"id":"20240611131527-17ol0d3","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"分二服。清淡竹沥一升，水二升，煮好银二两半，去银。先与病患饮之，然后服栝蒌汤，其银汁须冷服。肘后方∶治耳卒得风，觉耳中KT KT 。栝蒌根削令可入耳，以腊月猪脂煎三沸，出，塞耳，每用三、七日即愈。又方∶消渴，小便多。栝蒌薄切，炙取五两，水五升，煮取四升，随意饮之良。又方∶折伤。取栝蒌根以涂之，重布裹之，热除，痛即止。又方∶治二、三年聋耳方∶栝蒌根三十斤细切之，以水煮，用酿酒如常法。久久服之，甚良。又方∶若肠随肛出，转久不可收入。捣生栝蒌取汁，温之猪肉汁中洗手随挪之令暖，自得入。梅师方∶治诸痈发背，乳房初起微赤。捣栝蒌作末，以井华水调方寸匕。胜金方∶治太阳伤寒。栝蒌根二两，水五升，煮取一升半，分二服，小便利即瘥。广利方∶治小儿忽发黄，面目皮肉并黄，生栝蒌根捣取汁二合，蜜一大匙，二味暖相和，分再服。集验方∶下乳汁。栝蒌子淘洗控干，炒令香熟，瓦上焙令白色为末。酒调下一匕，合面卧少时，杜壬治胸膈痛彻背，心腹痞满，气不得通及治痰嗽。大栝蒌去穣取子熟炒，别研和子皮，面糊为丸，如梧桐子大，米饮下十五丸。伤寒类要∶治脾瘅溺赤出少，惕惕若恐，栝蒌主之。子母秘录∶治乳肿痛。栝蒌黄色老大者一枚熟捣，以白酒一斗煮取四升，去滓温一升，日三服。若无大者，小者二枚黄熟为上。杨氏产乳∶治热游丹赤肿。栝蒌末二大两，酽醋调涂之。又方∶治乳无汁。栝蒌根烧灰，米饮服方寸匕。产宝∶治产后乳无汁。栝蒌末，井花水服方寸匕，日二服，夜流出。杨文蔚治痰嗽，利胸膈方∶栝蒌肥实大者，割开，子净洗，捶破括皮，细切焙干，半夏四十九个，汤洗十遍，捶破焙干，捣罗为末，用洗栝蒌熟水并瓤同熬成膏，研细为丸如梧子大，生姜汤下二十丸。又方∶治痈未溃。栝蒌根、赤小豆，等分为末，醋调涂。"}]},{"ID":"20240611131527-sjp838b","Type":"NodeParagraph","Properties":{"id":"20240611131527-sjp838b","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"衍义曰∶栝蒌，实，九月、十月间取穣，以干葛粉拌，焙干。银石器中慢火炒熟为末。"}]},{"ID":"20240611131527-z1rm8fm","Type":"NodeParagraph","Properties":{"id":"20240611131527-z1rm8fm","updated":"20240611131527"},"Children":[{"Type":"NodeText","Data":"食后、夜卧，以沸汤点一、二钱服，治肺燥、热渴、大肠秘。其根与贝母、知母、秦艽、黄芩之类，皆治马热。"}]},{"ID":"20240611131514-3tpa7nz","Type":"NodeThematicBreak","Properties":{"id":"20240611131514-3tpa7nz"}},{"ID":"20240611131515-s5cyj5d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131515-s5cyj5d","updated":"20240611131519"},"Children":[{"Type":"NodeText","Data":"瓜蒌根《本草崇原》"}]},{"ID":"20240611131515-i5ggm0k","Type":"NodeParagraph","Properties":{"id":"20240611131515-i5ggm0k","updated":"20240611131515"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治消渴，身热，烦满大热，补虚，安中，续绝伤。"}]},{"ID":"20240611131515-iyeyqil","Type":"NodeParagraph","Properties":{"id":"20240611131515-iyeyqil","updated":"20240611131515"},"Children":[{"Type":"NodeText","Data":"（瓜蒌所在皆有之，三四月生苗，延引藤蔓，七月开花浅黄色，实在花下，大如拳，生青至九月熟黄，形如柿，内有扁子，壳色褐，仁色绿，其根直下，生年久者，长数尺，皮黄肉白，入土深者良。《本经》气味主治合根实而概言之。至陶弘景以根名天花粉，又名瑞雪。后人又分实名瓜蒌，子名瓜蒌仁，功用遂有异同。）"}]},{"ID":"20240611131515-024xt1t","Type":"NodeParagraph","Properties":{"id":"20240611131515-024xt1t","updated":"20240611131515"},"Children":[{"Type":"NodeText","Data":"瓜蒌根入土最深，外黄内白，气味苦寒，盖得地水之精气，而上达之药也，其实黄色，内如重楼，其仁色绿多脂，性能从上而下，主治消渴、身热者，谓启在下之水精上滋，此根之功能也。治烦满大热者，谓降在上之火热下泄，此实之功能也。补虚安中，续绝伤，合根实而言也。水火上下交济，则补虚而安中，藤蔓之药能资经脉，故续绝伤。"}]},{"ID":"20240611131515-cym34op","Type":"NodeParagraph","Properties":{"id":"20240611131515-cym34op","updated":"20240611131515"},"Children":[{"Type":"NodeText","Data":"（《乘雅》云∶瓜蒌根实补虚安中者，热却则中安，亦即所以补液之虚耳。）"}]},{"ID":"20240611131357-95kez5d","Type":"NodeThematicBreak","Properties":{"id":"20240611131357-95kez5d"}},{"ID":"20240611131358-190r86e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131358-190r86e","updated":"20240611131402"},"Children":[{"Type":"NodeText","Data":"栝蒌根《神农本草经读》"}]},{"ID":"20240611131358-nznlhf4","Type":"NodeParagraph","Properties":{"id":"20240611131358-nznlhf4","updated":"20240611131358"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主消渴身热，烦满大热，补虚安中，续绝伤。"}]},{"ID":"20240611131358-gacu0js","Type":"NodeParagraph","Properties":{"id":"20240611131358-gacu0js","updated":"20240611131358"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶栝蒌根气寒，禀天冬寒之水气而入肾与膀胱；味苦无毒，得地南方之火味而入心。火盛烁液则消渴，火浮于表则身热，火盛于里则烦满，大热火盛则阴虚，阴虚则中失守而不安，栝蒌根之苦寒清火，可以统主之。其主续绝伤者，以其蔓延能通阴络而续其绝也。实名栝蒌，《金匮》取治胸痹，《伤寒论》取治结胸，盖以能开胸前之结也。"}]},{"ID":"20240611131358-wnr9r18","Type":"NodeParagraph","Properties":{"id":"20240611131358-wnr9r18","updated":"20240611131358"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶半夜起阴气于脉外，上与阳明相合而成火土之燥。花粉起阴津于脉中，天癸相合而能滋其燥金。《伤寒》、《金匮》诸方，用半夏以助阳明之气，渴者燥热太过，即去半夏易花粉以滋之。圣贤立加减之方，必推物理所以然。"}]},{"ID":"20240611131345-2c7unex","Type":"NodeThematicBreak","Properties":{"id":"20240611131345-2c7unex"}},{"ID":"20240611131347-1037vtk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131347-1037vtk","updated":"20240611131351"},"Children":[{"Type":"NodeText","Data":"栝蒌根《千金翼方》"}]},{"ID":"20240611131347-my17mf7","Type":"NodeParagraph","Properties":{"id":"20240611131347-my17mf7","updated":"20240611131347"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴，身热，烦满，大热，补虚安中，续绝伤，除肠胃中固热，八疸，身面黄，唇干口燥，短气，通月水，止小便利。一名地蒌，一名果裸，一名天瓜，一名泽姑。实∶名黄瓜，主胸痹，悦泽人面；茎叶∶疗中热伤暑。生弘农川谷及山阴地。入土深者良，生卤地者有毒，二月八月采根，曝干。三十日成。"}]},{"ID":"20240611131322-y4v734b","Type":"NodeThematicBreak","Properties":{"id":"20240611131322-y4v734b"}},{"ID":"20240611131334-qjs5gno","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131334-qjs5gno","updated":"20240611131341"},"Children":[{"Type":"NodeText","Data":"栝蒌根《长沙药解》"}]},{"ID":"20240611131334-5gt45ct","Type":"NodeParagraph","Properties":{"id":"20240611131334-5gt45ct","updated":"20240611131334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主消渴，身热，烦满，大热，补虚安中，续绝伤。一名地楼。生川谷，及山阴。"}]},{"ID":"20240611131334-5eetx09","Type":"NodeParagraph","Properties":{"id":"20240611131334-5eetx09","updated":"20240611131334"},"Children":[{"Type":"NodeText","Data":"味甘、微苦，微寒，入手太阴肺经。清肺生津，止渴润燥，舒痉病之挛急，解渴家之淋癃。"}]},{"ID":"20240611131334-73n0ubm","Type":"NodeParagraph","Properties":{"id":"20240611131334-73n0ubm","updated":"20240611131334"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栝蒌桂枝汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"栝蒌根三两，桂枝三两，芍药三两，甘草二两，大枣十二枚，生姜三两。"},{"Type":"NodeText","Data":"治太阳痉病，其证备，身体强，几几然，脉沉迟者。太阳之经，外感风寒，发汗太多，因成痉病。其证身热足寒，颈强项急，头摇口噤，背反张，面目赤。发热汗出，而不恶寒者，是得之中风，名曰柔痉。以厥阴风木，藏血而舒筋，筋脉枯燥，曲而不伸，是以项强而背反。木枯风动，振荡不宁，是以头摇而齿齘。太阳行身之背，故并在脊背。此因汗多血燥，重感风邪，郁其营气，故病如此。甘、枣补脾精而益营血，姜、桂达经气而泻营郁，芍药、栝蒌，清风木而生津液也。"}]},{"ID":"20240611131334-tkqeyte","Type":"NodeParagraph","Properties":{"id":"20240611131334-tkqeyte","updated":"20240611131334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栝蒌瞿麦丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"栝蒌根三两，薯蓣二两，瞿麦一两，茯苓三两，附子一枚。"},{"Type":"NodeText","Data":"治内有水气，渴而小便不利者。阳衰土湿，寒水停留，乙木郁遏，不能疏泄，故小便不利。木郁风动，肺津伤耗，是以发渴。瞿麦、苓、附，泻水而温寒，薯蓣、栝蒌，敛肺而生津也。"}]},{"ID":"20240611131334-7fc4x9o","Type":"NodeParagraph","Properties":{"id":"20240611131334-7fc4x9o","updated":"20240611131334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栝蒌牡蛎散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"栝蒌根、牡蛎等分。为散，饮服方寸匕，日三服。"},{"Type":"NodeText","Data":"治百合病，渴而不差者。百合之病，肺热津伤，必变渴证。津液枯燥，故渴久不止。栝蒌、牡蛎，清金敛肺，生津润燥而止渴也。"}]},{"ID":"20240611131334-7s2qrnx","Type":"NodeParagraph","Properties":{"id":"20240611131334-7s2qrnx","updated":"20240611131334"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小青龙汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在麻黄。"},{"Type":"NodeText","Data":"治太阳伤寒，内有水气，渴者，去半夏，加栝蒌根三两。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小柴胡汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在柴胡。"},{"Type":"NodeText","Data":"治少阳伤寒。渴者，去半夏，加人参、栝蒌根，以其凉肃润泽，清金止渴，轻清而不败脾气也。"}]},{"ID":"20240611131334-fw5317q","Type":"NodeParagraph","Properties":{"id":"20240611131334-fw5317q","updated":"20240611131334"},"Children":[{"Type":"NodeText","Data":"清肺之药，最为上品，又有通达凝瘀，清利湿热之长。其诸主治，下乳汁，通月水，医吹奶，疗乳痈，治黄疸，消囊肿，行扑损瘀血，理疮疡肿痛。"}]},{"ID":"20240611131322-l15j22l","Type":"NodeThematicBreak","Properties":{"id":"20240611131322-l15j22l"}},{"ID":"20240611131323-kb7q2qh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131323-kb7q2qh","updated":"20240611131328"},"Children":[{"Type":"NodeText","Data":"栝蒌根《新修本草》"}]},{"ID":"20240611131323-q9l1seg","Type":"NodeParagraph","Properties":{"id":"20240611131323-q9l1seg","updated":"20240611131323"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴身热，烦满大热，补虚安中，续绝伤。除肠胃中痼热，八疸身面黄，唇干口燥，短气，通月水，止小便利。一名地蒌，一名果裸，一名天瓜，一名泽姑。实，名黄瓜，主胸痹，悦泽人面。茎叶，疗中热伤暑。"}]},{"ID":"20240611131323-d91kuuv","Type":"NodeParagraph","Properties":{"id":"20240611131323-d91kuuv","updated":"20240611131323"},"Children":[{"Type":"NodeText","Data":"生弘农川谷及山阴地。入土深者良。生卤地者有毒。二月、八月采根曝干，三十日成。"}]},{"ID":"20240611131323-nn2ibja","Type":"NodeParagraph","Properties":{"id":"20240611131323-nn2ibja","updated":"20240611131323"},"Children":[{"Type":"NodeText","Data":"枸杞为之使，恶干姜，畏牛膝、干漆，反乌头。 出近道，藤生，状如土瓜，而叶有叉。"}]},{"ID":"20240611131323-f2irznw","Type":"NodeParagraph","Properties":{"id":"20240611131323-f2irznw","updated":"20240611131323"},"Children":[{"Type":"NodeText","Data":"《毛诗》云∶果裸之实，亦施于宇。其实今以杂作手膏，用根，入土六、七尺，大二、三围者，服食亦用之。"}]},{"ID":"20240611131323-qa6nl8t","Type":"NodeParagraph","Properties":{"id":"20240611131323-qa6nl8t","updated":"20240611131323"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240611131323-qase3dm","Type":"NodeParagraph","Properties":{"id":"20240611131323-qase3dm","updated":"20240611131323"},"Children":[{"Type":"NodeText","Data":"今用根作粉，大宜服石，虚热人食之。作粉如作葛粉法，洁白美好。今出陕州者，白实最佳。"}]},{"ID":"20240611131323-9evjldc","Type":"NodeThematicBreak","Properties":{"id":"20240611131323-9evjldc"}},{"ID":"20240611131500-3ayhlgj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131500-3ayhlgj","updated":"20240611131506"},"Children":[{"Type":"NodeText","Data":"栝楼根《药征续编》"}]},{"ID":"20240611131500-j9rckvz","Type":"NodeParagraph","Properties":{"id":"20240611131500-j9rckvz","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"主治渴。"}]},{"ID":"20240611131500-pwvd6z5","Type":"NodeParagraph","Properties":{"id":"20240611131500-pwvd6z5","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"【考证】"}]},{"ID":"20240611131500-iyxeh70","Type":"NodeParagraph","Properties":{"id":"20240611131500-iyxeh70","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"柴胡桂枝干姜汤证曰∶渴而不呕。"}]},{"ID":"20240611131500-d2qupxs","Type":"NodeParagraph","Properties":{"id":"20240611131500-d2qupxs","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"小柴胡去半夏加栝蒌汤证曰∶发渴者。"}]},{"ID":"20240611131500-lhftb2k","Type":"NodeParagraph","Properties":{"id":"20240611131500-lhftb2k","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"上二方，栝蒌根各四两。"}]},{"ID":"20240611131500-4zdqsvn","Type":"NodeParagraph","Properties":{"id":"20240611131500-4zdqsvn","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"栝蒌桂枝汤，证不具。"}]},{"ID":"20240611131500-65virbh","Type":"NodeParagraph","Properties":{"id":"20240611131500-65virbh","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"栝蒌瞿麦丸证曰∶其人若渴。"}]},{"ID":"20240611131500-qs06zkr","Type":"NodeParagraph","Properties":{"id":"20240611131500-qs06zkr","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"上二方，栝蒌根各二两。"}]},{"ID":"20240611131500-ityzl6i","Type":"NodeParagraph","Properties":{"id":"20240611131500-ityzl6i","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"栝蒌牡蛎散证曰∶渴不差者。"}]},{"ID":"20240611131500-orxjwjf","Type":"NodeParagraph","Properties":{"id":"20240611131500-orxjwjf","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"牡蛎泽泻散证不具。"}]},{"ID":"20240611131500-p1eao6t","Type":"NodeParagraph","Properties":{"id":"20240611131500-p1eao6t","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"上二方，栝蒌根诸药等分。"}]},{"ID":"20240611131500-pd2xn8b","Type":"NodeParagraph","Properties":{"id":"20240611131500-pd2xn8b","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"据此诸方，则栝蒌根治渴明矣。凡渴有二证。烦渴者，石膏主之，但渴者，栝蒌根主之。"}]},{"ID":"20240611131500-u40fxbr","Type":"NodeParagraph","Properties":{"id":"20240611131500-u40fxbr","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"是宜分别而治之。按栝蒌根者，盖兼治口中燥渴及粘者，然是非栝蒌根一味之主治也。合用而后见其妙，要宜考之于柴胡桂枝干姜汤，栝蒌桂枝汤二方。"}]},{"ID":"20240611131500-xskqktg","Type":"NodeParagraph","Properties":{"id":"20240611131500-xskqktg","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"【互考】"}]},{"ID":"20240611131500-r2ec7hp","Type":"NodeParagraph","Properties":{"id":"20240611131500-r2ec7hp","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"栝蒌桂枝汤证，不具。然太阳病，其证备云，则是全备桂枝汤证之谓也。但身体强几几然云者，岂独栝蒌根所主乎？几几然，是项背强急之状也。故桂枝加葛根汤证曰∶此方盖于桂枝加葛根汤证曰∶项背强，几几然，则几几然，是为葛根之证明矣，余故曰∶此方盖于桂枝加葛根汤方内，加栝蒌根二两，煮法水率，亦皆根据桂枝加葛根汤法，而不根据桂枝汤法也。岂不其征乎？然则益知此方者，是桂枝加葛根汤证全备而渴者主之。《类聚方》不载此方，水率煮法者误也。"}]},{"ID":"20240611131500-lefp8i1","Type":"NodeParagraph","Properties":{"id":"20240611131500-lefp8i1","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"牡蛎泽泻散，证不具。此方七味等分之剂，而不知何以为主药也？然今此谓大病瘥后，从腰以下有水气，则必有渴证明矣。故有栝蒌根也。"}]},{"ID":"20240611131500-qwqwf61","Type":"NodeParagraph","Properties":{"id":"20240611131500-qwqwf61","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"【辨误】"}]},{"ID":"20240611131500-nsyh8oj","Type":"NodeParagraph","Properties":{"id":"20240611131500-nsyh8oj","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"《尔雅》曰∶果 之实栝蒌。郭璞曰∶今齐人呼之为天瓜。李巡曰∶栝蒌子名也。据此说，则根名果 ，子名栝蒌。凡仲景之方，栝蒌桂枝汤，栝蒌瞿麦丸，柴胡去半夏加栝蒌汤，及牡蛎泽泻散，柴胡桂枝干姜汤二方内，栝蒌皆当作果 。若作栝蒌，则当须加根字。不然，与子相混，不可不改焉。又小陷胸汤，瓜蒌薤白白酒汤，瓜蒌薤白半夏汤，枳实薤白桂枝汤方内，瓜蒌实皆当作栝蒌也，实字当削之。李时珍曰∶栝蒌即果 二字音转也，亦作KT，后人又转为瓜蒌，愈转愈失其真矣。时珍之说非也，栝蒌决非果 音转也，《尔雅》岂以音转注之乎？瓜蒌 KT ，后世假栝蒌之音者也。 KT 本见《灵枢经》，盖俗字，误见于经，后"}]},{"ID":"20240611131500-0s78bl8","Type":"NodeParagraph","Properties":{"id":"20240611131500-0s78bl8","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"【品考】"}]},{"ID":"20240611131500-p6wn3tk","Type":"NodeParagraph","Properties":{"id":"20240611131500-p6wn3tk","updated":"20240611131500"},"Children":[{"Type":"NodeText","Data":"栝蒌二品，其色赤，一其色黄，但其根不异，通用而可也。雷 曰∶圆者为栝，长者为蒌，亦属牵强。今药肆所有者，土瓜根混卖，不可不择也。盖土瓜根，短如甘薯，味苦。天瓜长如薯蓣，最大，味甘微苦，宜以此分别也。若无此物，则天花粉可权用。其色如雪，握之又作雪声，不贴银器者佳。"}]},{"ID":"20240611131501-6kf2him","Type":"NodeThematicBreak","Properties":{"id":"20240611131501-6kf2him"}},{"ID":"20240611131634-cb3cl7k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131634-cb3cl7k","updated":"20240611131639"},"Children":[{"Type":"NodeText","Data":"栝蒌《本草述钩元》"}]},{"ID":"20240611131627-mdwm4tx","Type":"NodeParagraph","Properties":{"id":"20240611131627-mdwm4tx","updated":"20240611131641"},"Children":[{"Type":"NodeText","Data":"别名瑞雪。根即天花粉。所在有之，出弘农陕州者最胜。六月开花，结实花下。九月黄熟如柿，形有正圆长锐，功用并同。内有扁子，色绿脂多，作青气。根直下生，年久者长数尺。秋后采者，结实有粉，他时便多筋络矣。（核）"}]},{"ID":"20240611131627-76wpngo","Type":"NodeParagraph","Properties":{"id":"20240611131627-76wpngo","updated":"20240611131642"},"Children":[{"Type":"NodeText","Data":"根、实功力，稍有异同。实主郁遏不能分解，根主烦渴，失于容平。靡不以热为因，以燥为证。（子繇）。"}]},{"ID":"20240611131627-jn007pe","Type":"NodeParagraph","Properties":{"id":"20240611131627-jn007pe","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"●实"}]},{"ID":"20240611131627-7nlau73","Type":"NodeParagraph","Properties":{"id":"20240611131627-7nlau73","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"味大甘微苦，气寒。性润缓，味厚气薄，阴也。"}]},{"ID":"20240611131627-yimuxi2","Type":"NodeParagraph","Properties":{"id":"20240611131627-yimuxi2","updated":"20240611131644"},"Children":[{"Type":"NodeText","Data":"主治润肺燥，除热，涤痰结，止嗽。宽胸痹，利咽喉，疗燥渴肠秘。"}]},{"ID":"20240611131627-qw7dfg3","Type":"NodeParagraph","Properties":{"id":"20240611131627-qw7dfg3","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"栝蒌属土而有水，味甘性润，补肺降气。凡胸中有痰者，乃肺受火逼，失其降下之令。今得甘缓润下之助，则痰自降，宜其为治嗽要药。又能洗涤胸膈中垢腻郁热，为治消渴之神品。（丹溪）"}]},{"ID":"20240611131627-dllih5e","Type":"NodeParagraph","Properties":{"id":"20240611131627-dllih5e","updated":"20240611131646"},"Children":[{"Type":"NodeText","Data":"解胸中郁热，是其所长，故热郁汤内用之。且寒而大甘，甘虽缓而润则通，不同于栀仁辈，苦寒降折，伤其上升之阳也。"}]},{"ID":"20240611131627-noqfazw","Type":"NodeParagraph","Properties":{"id":"20240611131627-noqfazw","updated":"20240611131648"},"Children":[{"Type":"NodeText","Data":"仲景治胸痹痛引心背，咳唾喘息，及结胸满痛，皆用栝蒌。乃取其甘寒不犯胃气，能降上焦之火，非以苦寒泻热也。（濒湖）。"}]},{"ID":"20240611131627-0btppib","Type":"NodeParagraph","Properties":{"id":"20240611131627-0btppib","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"栝蒌通肺中郁热，又云降气者，总因甘合于寒，能和能降能润故也。夫气属阳，同乎火体。燥则炎上，润则降下。和而且润，以缓为降，又况寒以导之，有不热郁通而气痹降乎。（《类明》）"}]},{"ID":"20240611131627-7kneu69","Type":"NodeParagraph","Properties":{"id":"20240611131627-7kneu69","updated":"20240611131650"},"Children":[{"Type":"NodeText","Data":"胸中痹痛引背，喘息咳唾，短气。寸脉沉迟，关上紧数。用大栝蒌一枚切，薤白半斤，以白酒七升，煮二升。分再服。加半夏四两更善。"}]},{"ID":"20240611131627-erf4d1g","Type":"NodeParagraph","Properties":{"id":"20240611131627-erf4d1g","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"清痰利膈治嗽。用大栝蒌取子切焙，制半夏四十九个捶焙，等分为末。即以栝蒌皮瓤熬膏和丸，梧子大。每姜汤下三五十丸。"}]},{"ID":"20240611131627-ti8l16x","Type":"NodeParagraph","Properties":{"id":"20240611131627-ti8l16x","updated":"20240611131652"},"Children":[{"Type":"NodeText","Data":"干咳无痰。熟栝蒌捣烂绞汁，入蜜等分，加白矾一钱。熬膏频含，咽汁。"}]},{"ID":"20240611131627-s36sjcn","Type":"NodeParagraph","Properties":{"id":"20240611131627-s36sjcn","updated":"20240611131654"},"Children":[{"Type":"NodeText","Data":"咳嗽有痰。熟瓜蒌十个，明矾二两。捣和饼，阴干，研末，糊丸梧子大。每姜汤下五、七十丸。"}]},{"ID":"20240611131627-qon2zk1","Type":"NodeParagraph","Properties":{"id":"20240611131627-qon2zk1","updated":"20240611131655"},"Children":[{"Type":"NodeText","Data":"酒痰咳嗽，用此救肺。栝蒌仁、青黛等分。研末，姜汁蜜丸，芡子大。每噙一丸。"}]},{"ID":"20240611131627-76xoyh0","Type":"NodeParagraph","Properties":{"id":"20240611131627-76xoyh0","updated":"20240611131657"},"Children":[{"Type":"NodeText","Data":"小儿痰喘，咳嗽膈热，久不瘥。栝蒌一枚，去子为末，以寒食面和作饼子，炙黄，再研末。每服一钱，温水化下，日三服，效乃止。"}]},{"ID":"20240611131627-v26a9ah","Type":"NodeParagraph","Properties":{"id":"20240611131627-v26a9ah","updated":"20240611131659"},"Children":[{"Type":"NodeText","Data":"妇人夜热痰嗽，月经不调形瘦者。用栝蒌仁一两，青黛、香附、童便浸晒一两五钱。为末，蜜调，噙化之。"}]},{"ID":"20240611131627-m9jogzn","Type":"NodeParagraph","Properties":{"id":"20240611131627-m9jogzn","updated":"20240611131701"},"Children":[{"Type":"NodeText","Data":"燥渴肠秘。取九、十月熟栝蒌瓤，拌干葛粉。银石器中，慢火炒为末。食后夜卧，各以沸汤点服二钱。"}]},{"ID":"20240611131627-u27z0ha","Type":"NodeParagraph","Properties":{"id":"20240611131627-u27z0ha","updated":"20240611131704"},"Children":[{"Type":"NodeText","Data":"按栝蒌实阴厚而脂润，故于热燥之痰，为对待的剂。若寒痰湿痰，气虚所结，及饮食积聚之痰，皆用之有害。所录用实数方，或助以辛散，或间以燥湿，或和以敛水，或佐以开郁。不如是无以竟其润下之功，而致于贻濡滞之害，则亦用剂者之过也。"}]},{"ID":"20240611131627-hovi1yf","Type":"NodeParagraph","Properties":{"id":"20240611131627-hovi1yf","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"●根（即天花粉）"}]},{"ID":"20240611131627-d2p0n3v","Type":"NodeParagraph","Properties":{"id":"20240611131627-d2p0n3v","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"味微甘而苦，气寒纯阴。入心肺二经。"}]},{"ID":"20240611131627-gstj23m","Type":"NodeParagraph","Properties":{"id":"20240611131627-gstj23m","updated":"20240617115526"},"Children":[{"Type":"NodeText","Data":"主益津，治消渴。（治渴，有坚肾水而止者，有利小便而愈者。坚肾用天花粉之属，利小便用二苓之类。先哲）"}]},{"ID":"20240611131627-hyvu17d","Type":"NodeParagraph","Properties":{"id":"20240611131627-hyvu17d","updated":"20240617115531"},"Children":[{"Type":"NodeText","Data":"身热烦满，心中枯涸者，非此不除。去肠胃中痼热，及时疾热狂，并虚热咳嗽。退八疸身面黄，唇干口燥，短气。通月水，通小肠，亦止小便利。与辛酸同用。导肿气，能补虚安中，续绝伤。"}]},{"ID":"20240611131627-cnhhfii","Type":"NodeParagraph","Properties":{"id":"20240611131627-cnhhfii","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"禀天地清寒之气，故能解烦渴，行津液，大宜虚热人。"}]},{"ID":"20240611131627-rueyfh0","Type":"NodeParagraph","Properties":{"id":"20240611131627-rueyfh0","updated":"20240611131709"},"Children":[{"Type":"NodeText","Data":"同贝母、竹沥、竹茹、荆沥、天冬。则消痰。"}]},{"ID":"20240611131627-j3rjir1","Type":"NodeParagraph","Properties":{"id":"20240611131627-j3rjir1","updated":"20240611131711"},"Children":[{"Type":"NodeText","Data":"同银花、连翘、贝母、白芨、甘草。消一切肿毒。"}]},{"ID":"20240611131627-q6kzt6i","Type":"NodeParagraph","Properties":{"id":"20240611131627-q6kzt6i","updated":"20240611131714"},"Children":[{"Type":"NodeText","Data":"消渴饮水。用栝蒌根三十斤，入水一石，煮取一斗半，去渣。以牛脂五合，煎至水尽。用暖酒先食服，如鸡子大，日三服最妙。"}]},{"ID":"20240611131627-bc5lwqc","Type":"NodeParagraph","Properties":{"id":"20240611131627-bc5lwqc","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"伤寒烦渴思饮。栝蒌根三两，水五升，煮一升，分二服。先以淡竹沥一斗，水二升，煮好银二两，半冷饮汁，然后服此。"}]},{"ID":"20240611131627-8ads0xt","Type":"NodeParagraph","Properties":{"id":"20240611131627-8ads0xt","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"黑疸危疾。栝蒌根一斤，捣汁六合。顿服，随有黄水随小便出。如不出，再服。"}]},{"ID":"20240611131627-4bm4bg8","Type":"NodeParagraph","Properties":{"id":"20240611131627-4bm4bg8","updated":"20240611131716"},"Children":[{"Type":"NodeText","Data":"虚热咳嗽。天花粉一两，人参三钱。为末。每服一钱，米汤下。又方，栝蒌根水泡切片，用竹沥拌，晒干。如是三次，再同乳汁浸，饭上蒸，晒干，煎服效。"}]},{"ID":"20240611131627-z9kaa38","Type":"NodeParagraph","Properties":{"id":"20240611131627-z9kaa38","updated":"20240611131719"},"Children":[{"Type":"NodeText","Data":"〔总论〕栝蒌实黄熟于九月，而采以霜降后，根色洁白。采于秋后乃实，则知所禀金水之气为专。但实味大甘，后有微苦。是金孕于土，水孕于金。味厚脂多，不类苦寒之直折，有伤上升阳气。惟本土金水之相孕，以育阴而退阳。阴气蕴则热退，阴气蕴而脂润则燥化。故凡热淫燥气之结于胸次，与结而为痰为垢腻者，皆能利之。至根则味苦，而先有微甘。苦下泄，是金直致其气化于水矣。金水合以致用，先哲所谓纯阴而润下者也。子繇云：或液燥涸致热结聚，或热结聚致液燥涸，惟此为中的之剂。据此则内伤外淫，凡致中热而为燥者，可推类以尽之，不独在胸膈间矣。抑何以能通月水，通小肠，并止小便利？盖心主血，肺阴下降入心，以肾阴之至于肺者，还合于离中之坎，故血生。小肠非火化之腑乎？小肠通利，则胸膈血散。膻中血裹，则小肠壅滞。即此思之，为血为水，是一是二，可知此味本金水之相含，使气能化液，液之清者化血，浊者化小水也。东垣谓心中枯涸，非此不除，是则虽为纯阴，亦异乎他味之苦寒，而只以降火为功者矣。（《本经》谓其安中续绝伤者以此）惟苦寒与甘寒，不得例论。若热淫而兼乎阴之湿，根与实皆宜慎用。至热结而本乎阳之郁，是固木火不达以为病，与金水不达者，证或相类，此际实则可投。而根之纯阴者，可漫施乎哉？"}]},{"ID":"20240611131627-11kos3p","Type":"NodeParagraph","Properties":{"id":"20240611131627-11kos3p","updated":"20240611131721"},"Children":[{"Type":"NodeText","Data":"缪氏：脾胃虚寒作泻者，弗宜服根。按栝蒌根得金水之厚，凡病于木火之真，气不升不达者（此患最多），在所禁用。"}]},{"ID":"20240611131627-f2bmqlz","Type":"NodeParagraph","Properties":{"id":"20240611131627-f2bmqlz","updated":"20240617115537"},"Children":[{"Type":"NodeText","Data":"〔修治〕古方全用，连子连皮细切。后世乃分子、瓤各用。（濒湖）然不可执一，有全用者，有用皮瓤而去子者。又有只用瓤者，有只用子者。用子剥壳，用仁渗油，免人恶心。（只一度，毋多次，失药润性。）"}]},{"ID":"20240611131627-yc5xga0","Type":"NodeParagraph","Properties":{"id":"20240611131627-yc5xga0","updated":"20240611131627"},"Children":[{"Type":"NodeText","Data":"其根，去皮捣细，罗粉用。"}]},{"ID":"20240611131721-xy33bz7","Type":"NodeThematicBreak","Properties":{"id":"20240611131721-xy33bz7"}},{"ID":"20240611131733-mcvzlcg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611131733-mcvzlcg","updated":"20240611131740"},"Children":[{"Type":"NodeText","Data":"栝楼《本草纲目》"}]},{"ID":"20240611131733-q0gh11r","Type":"NodeParagraph","Properties":{"id":"20240611131733-q0gh11r","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"「释名」果裸、瓜蒌、天瓜、黄瓜、地楼、泽姑，根名白药、天花粉、瑞雪。"}]},{"ID":"20240611131733-xxidv6s","Type":"NodeParagraph","Properties":{"id":"20240611131733-xxidv6s","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"「气味」苦、寒、无毒。"}]},{"ID":"20240611131733-3ukrtcx","Type":"NodeParagraph","Properties":{"id":"20240611131733-3ukrtcx","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611131733-a0x4fi6","Type":"NodeParagraph","Properties":{"id":"20240611131733-a0x4fi6","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"1、痰咳不止。用栝楼仁一两、文蛤七分，共研为末，以浓姜汁调成丸子，如弹子大，噙口中咽汁。又方：熟栝楼十个、明矾二两，共捣成饼，阴干，研为末，加糊做成丸子，如梧子大。每服五十至七十丸，姜汤送下。"}]},{"ID":"20240611131733-ok4l1d9","Type":"NodeParagraph","Properties":{"id":"20240611131733-ok4l1d9","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"2、干咳。用熟栝楼捣烂，加蜜等分，再加白矾一钱，共熬成膏，随时口含回汁。"}]},{"ID":"20240611131733-th6ay2z","Type":"NodeParagraph","Properties":{"id":"20240611131733-th6ay2z","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"3、痰喘气急。用栝楼二个、明矾如枣大一块，同烧存性，研细，以熟萝卜蘸食。药尽病除。"}]},{"ID":"20240611131733-ee49sjn","Type":"NodeParagraph","Properties":{"id":"20240611131733-ee49sjn","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"4、肺痿咳血。用栝楼五十个（连瓤瓦焙）、乌梅肉五十个（焙过）、杏仁（去皮尖，炒）二十一个，共研为末；另将猪肺一片切薄，掺末一小撮入内，炙熟，冷嚼回下。一天二次。"}]},{"ID":"20240611131733-lwrih95","Type":"NodeParagraph","Properties":{"id":"20240611131733-lwrih95","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"5、妇女夜热（痰嗽，月经不调，形瘦）。用栝楼仁一两，青黛、香附（童便浸，晒）各一两五钱，共研为末，加蜜调匀，口中噙化。"}]},{"ID":"20240611131733-qvc59tm","Type":"NodeParagraph","Properties":{"id":"20240611131733-qvc59tm","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"6、黄疸。用青栝楼焙过，研为末。每取一钱，加水半碗，煎至七成，临睡时服，五更有黄物泻下，即为见效。此方名为“逐黄散”。"}]},{"ID":"20240611131733-l2arozu","Type":"NodeParagraph","Properties":{"id":"20240611131733-l2arozu","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"7、小便不通，腹胀。用栝楼焙过，研为末。每服二钱，热酒送下。服至病愈为止。"}]},{"ID":"20240611131733-xwf6qvi","Type":"NodeParagraph","Properties":{"id":"20240611131733-xwf6qvi","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"8、吐血。泥封栝楼，煅存性，研为末。每服三钱，糯米汤送下。一天服二次。"}]},{"ID":"20240611131733-zh345ak","Type":"NodeParagraph","Properties":{"id":"20240611131733-zh345ak","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"8、屙血。用栝楼一个，烧灰，加赤小豆半两，共为末。每服一钱，空心服，酒送下。"}]},{"ID":"20240611131733-1cjhbpr","Type":"NodeParagraph","Properties":{"id":"20240611131733-1cjhbpr","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"10、咽喉肿痛，不能发声。用栝楼皮、白僵蚕（炒）、甘草（炒）各二钱半，共研为末。每服三钱半，姜汤送下。一天服二次。或以棉裹半钱含咽亦可。此方名“发声散”。"}]},{"ID":"20240611131733-26isf8r","Type":"NodeParagraph","Properties":{"id":"20240611131733-26isf8r","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"11、诸痈发背。用栝楼捣为末，每服一匙，水送下。"}]},{"ID":"20240611131733-y23tmdj","Type":"NodeParagraph","Properties":{"id":"20240611131733-y23tmdj","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"12、风疮疥癣。用生栝楼一、二个，打碎、酒泡一日夜，取酒热饮。"}]},{"ID":"20240611131733-wdfcpbn","Type":"NodeParagraph","Properties":{"id":"20240611131733-wdfcpbn","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"13消渴。取大栝楼根（天花粉），去皮，切细，水泡五天，每天换水。五天后取出捣碎，过滤，澄粉，晒干。每服一匙，水化下。一天服三次。亦可将药加入粥中及乳酪中吃下。又方：用栝楼根切薄，炙过，取五两加水五升煮至四升，随意饮服。"}]},{"ID":"20240611131733-05w9nl2","Type":"NodeParagraph","Properties":{"id":"20240611131733-05w9nl2","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"14、小儿热病。用栝楼根末半钱，乳汁调服半钱。"}]},{"ID":"20240611131733-u69yb68","Type":"NodeParagraph","Properties":{"id":"20240611131733-u69yb68","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"15、天泡湿疮。用天花粉、滑石，等分为末，水调搽涂。"}]},{"ID":"20240611131733-xbgzss7","Type":"NodeParagraph","Properties":{"id":"20240611131733-xbgzss7","updated":"20240611131733"},"Children":[{"Type":"NodeText","Data":"16、折伤肿痛。用栝楼根捣烂涂患处，厚布包住，热除，痛即止。"}]},{"ID":"20240611131734-mm7qci2","Type":"NodeThematicBreak","Properties":{"id":"20240611131734-mm7qci2"}},{"ID":"20240611131735-pa561np","Type":"NodeParagraph","Properties":{"id":"20240611131735-pa561np"}}]}