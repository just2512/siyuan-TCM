ta":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马先蒿 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马先蒿 5-20240820160015-0gidbzq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 382px;","style":"width: 372px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马先蒿 (12)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马先蒿 12-20240820160810-qdaq1ai.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 372px;\" parent-style=\"width: 382px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820160038-2kr3mq9","Type":"NodeParagraph","Properties":{"id":"20240820160038-2kr3mq9","updated":"20240820161125"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240820160038-0y7d3l1.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 460px;","style":"width: 450px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马先蒿 (15)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马先蒿 15-20240820161125-q5iwtt7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 450px;\" parent-style=\"width: 460px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240625151708-17cmj35","Type":"NodeParagraph","Properties":{"id":"20240625151708-17cmj35","updated":"20240820155632"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：马先蒿种类过多，以上取图未按品种分类；"}]},{"ID":"20240611173327-2hbui4r","Type":"NodeThematicBreak","Properties":{"id":"20240611173327-2hbui4r"}},{"ID":"20240611173350-y9c53tp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173350-y9c53tp","updated":"20240611173355"},"Children":[{"Type":"NodeText","Data":"马先蒿《神农本草经》"}]},{"ID":"20240611173350-lmlxoik","Type":"NodeParagraph","Properties":{"id":"20240611173350-lmlxoik","updated":"20240611173350"},"Children":[{"Type":"NodeText","Data":"味平。"}]},{"ID":"20240611173350-luquwx0","Type":"NodeParagraph","Properties":{"id":"20240611173350-luquwx0","updated":"20240611173350"},"Children":[{"Type":"NodeText","Data":"主寒热，鬼注，中风湿痹，女子带下病，无子。一名马尿蒿。生川泽。"}]},{"ID":"20240611173350-cldk81o","Type":"NodeParagraph","Properties":{"id":"20240611173350-cldk81o","updated":"20240611173350"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生南阳。"}]},{"ID":"20240611173350-495jq9x","Type":"NodeParagraph","Properties":{"id":"20240611173350-495jq9x","updated":"20240611173350"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蔚，牡蒿也。《广雅》云：因尘，马先也。《尔雅》云：蔚，牡菣。"}]},{"ID":"20240611173350-ss538ma","Type":"NodeParagraph","Properties":{"id":"20240611173350-ss538ma","updated":"20240611173350"},"Children":[{"Type":"NodeText","Data":"郭璞云：无子者。《毛诗》云：匪莪伊蔚。《传》云：菣，牡菣也。陆玑云：三月始生，七月华，华似胡麻华而紫赤，八月为角，角似小豆，角锐而长，一名马新蒿，案新先声相近。"}]},{"ID":"20240611173504-6y7l3xl","Type":"NodeThematicBreak","Properties":{"id":"20240611173504-6y7l3xl"}},{"ID":"20240611173506-fgfa04v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173506-fgfa04v","updated":"20240611173510"},"Children":[{"Type":"NodeText","Data":"马先蒿《证类本草》"}]},{"ID":"20240611173506-dvsm3m7","Type":"NodeParagraph","Properties":{"id":"20240611173506-dvsm3m7","updated":"20240611173506"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主寒热鬼疰，中风湿痹，女子带下病，无子。一名马屎蒿。生南阳川泽。"}]},{"ID":"20240611173506-f4n2pck","Type":"NodeParagraph","Properties":{"id":"20240611173506-f4n2pck","updated":"20240611173506"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方云一名烂石草。主恶疮。方药亦不复用。唐本注云∶此叶大如茺蔚，花红白色。实，八月、九月熟。俗谓之虎麻是也。一名马新蒿。所在有之。茺蔚苗短小，子夏中熟。"}]},{"ID":"20240611173506-6je1pbo","Type":"NodeParagraph","Properties":{"id":"20240611173506-6je1pbo","updated":"20240611173506"},"Children":[{"Type":"NodeText","Data":"而初生，二种极相似也。今按别本注云∶近道处处有。三月、八月采茎、叶，阴干。臣禹锡等谨按尔雅云∶蔚，牡 。释曰∶蔚，即蒿之雄无子者。又曰∶蔚，一名牡 。《诗·蓼莪》云∶匪莪伊芳蔚。陆机云∶牡蒿也。三月始生，七月华，华似胡麻华而紫赤，八月为角，角似小豆角，锐而长。一名马新蒿是也。"}]},{"ID":"20240611173506-ghatgu3","Type":"NodeParagraph","Properties":{"id":"20240611173506-ghatgu3","updated":"20240611173506"},"Children":[{"Type":"NodeText","Data":"图经文具第六卷中白蒿条下。"}]},{"ID":"20240611173506-kv8tx15","Type":"NodeParagraph","Properties":{"id":"20240611173506-kv8tx15","updated":"20240611173506"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治大风癞疾，骨肉疽败，百节疼酸，眉鬓堕落，身体习习痒痛。以马先蒿细锉，炒为末。每空心及晚食前，温酒调下二钱匕。外台秘要∶治癞。马先蒿一名马矢蒿。捣末服方寸匕，日三服，如更赤起，一年都瘥。"}]},{"ID":"20240611173448-snieaae","Type":"NodeThematicBreak","Properties":{"id":"20240611173448-snieaae"}},{"ID":"20240611173451-g9bpgyr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173451-g9bpgyr","updated":"20240611173456"},"Children":[{"Type":"NodeText","Data":"马先蒿《神农本草经赞》"}]},{"ID":"20240611173451-797xr9o","Type":"NodeParagraph","Properties":{"id":"20240611173451-797xr9o","updated":"20240611173451"},"Children":[{"Type":"NodeText","Data":"味平。主寒热。鬼注。中风湿痹。女子带下病无子。一名马屎蒿。生川泽。"}]},{"ID":"20240611173451-t29rxsm","Type":"NodeParagraph","Properties":{"id":"20240611173451-t29rxsm","updated":"20240611173451"},"Children":[{"Type":"NodeText","Data":"先缘新近。蓝以高瞻。麻花紫艳。豆角青尖。牡因子辨。邪远名嫌。马通臭味。炼石炎炎。"}]},{"ID":"20240611173451-vy0ix5w","Type":"NodeParagraph","Properties":{"id":"20240611173451-vy0ix5w","updated":"20240611173451"},"Children":[{"Type":"NodeText","Data":"苏恭曰。一名马新蒿。晏子蒿。草之高者也。掌禹锡曰。七月开花。似胡麻花而紫赤。"}]},{"ID":"20240611173451-oilp8ed","Type":"NodeParagraph","Properties":{"id":"20240611173451-oilp8ed","updated":"20240611173451"},"Children":[{"Type":"NodeText","Data":"八月生角。似豆角锐而长。李时珍曰。马先蒿。牡嵩。原是二种。诗疏。所谓有子者。乃马先蒿。而复引无子之牡蒿释之。误矣。蒿气如马矢。先乃矢之讹。新又先之讹也。北史传。"}]},{"ID":"20240611173451-rcqdmx1","Type":"NodeParagraph","Properties":{"id":"20240611173451-rcqdmx1","updated":"20240611173451"},"Children":[{"Type":"NodeText","Data":"食采有邪蒿。邢峙令去之曰。此菜有不正之名。礼。礼不讳嫌名。汉书传注。以马通熏之马矢也。名医曰。一名炼石草。陶弘景曰。又名烂石。诗赫赫炎炎。"}]},{"ID":"20240611173437-6csvu7g","Type":"NodeThematicBreak","Properties":{"id":"20240611173437-6csvu7g"}},{"ID":"20240611173439-2m07fgd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173439-2m07fgd","updated":"20240611173443"},"Children":[{"Type":"NodeText","Data":"马先蒿《本草经集注》"}]},{"ID":"20240611173439-9qj3ih3","Type":"NodeParagraph","Properties":{"id":"20240611173439-9qj3ih3","updated":"20240611173439"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主治寒热鬼疰，中风，湿痹，女子带下病，无子。一名马屎蒿。生南阳川泽。方云一名烂石草，主恶疮，方药亦不复用。（《大观》卷九，《政和》二三○页）"}]},{"ID":"20240611173439-pyxhslf","Type":"NodeParagraph","Properties":{"id":"20240611173439-pyxhslf","updated":"20240611173439"},"Children":[{"Type":"NodeText","Data":"蜀羊泉，味苦，微寒，无毒。主治头秃，恶疮，热气，疥瘙痂癣虫。治龋齿，女子阴中内伤，皮间实积。一名羊泉，一名羊饴。生蜀郡川谷。"}]},{"ID":"20240611173439-qqhecal","Type":"NodeParagraph","Properties":{"id":"20240611173439-qqhecal","updated":"20240611173439"},"Children":[{"Type":"NodeText","Data":"方药亦不复用，彼土人时有采识者。"}]},{"ID":"20240611173424-x9rpwmr","Type":"NodeThematicBreak","Properties":{"id":"20240611173424-x9rpwmr"}},{"ID":"20240611173426-uyoad48","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173426-uyoad48","updated":"20240611173430"},"Children":[{"Type":"NodeText","Data":"马先蒿《名医别录》"}]},{"ID":"20240611173426-c9dx2us","Type":"NodeParagraph","Properties":{"id":"20240611173426-c9dx2us","updated":"20240611173426"},"Children":[{"Type":"NodeText","Data":"味苦，无毒．生南阳．"}]},{"ID":"20240611173426-vgod8vy","Type":"NodeParagraph","Properties":{"id":"20240611173426-vgod8vy","updated":"20240611173426"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶马先蒿，味平．主寒热鬼注，中风湿痹，女子带下病，无子．一名马屎蒿．生川泽．"}]},{"ID":"20240611173412-o6wo8zy","Type":"NodeThematicBreak","Properties":{"id":"20240611173412-o6wo8zy"}},{"ID":"20240611173414-x7z08oi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173414-x7z08oi","updated":"20240611173419"},"Children":[{"Type":"NodeText","Data":"马先蒿《医学入门》"}]},{"ID":"20240611173414-u09yeac","Type":"NodeParagraph","Properties":{"id":"20240611173414-u09yeac","updated":"20240611173414"},"Children":[{"Type":"NodeText","Data":"味苦平。无毒。主中风湿痹，女子带下无子。又治马疥。八月采，角似小豆而锐长。"}]},{"ID":"20240611173400-a0y38b1","Type":"NodeThematicBreak","Properties":{"id":"20240611173400-a0y38b1"}},{"ID":"20240611173401-h5f4kvb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173401-h5f4kvb","updated":"20240611173407"},"Children":[{"Type":"NodeText","Data":"马先蒿《新修本草》"}]},{"ID":"20240611173401-vly29ns","Type":"NodeParagraph","Properties":{"id":"20240611173401-vly29ns","updated":"20240611173401"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主寒热鬼疰，中风湿痹，女子带下病，无子。一名马屎蒿，生南阳川泽。方云一名烂石草，主恶疮，方药亦不复用。"}]},{"ID":"20240611173401-g3ttj43","Type":"NodeParagraph","Properties":{"id":"20240611173401-g3ttj43","updated":"20240611173401"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此叶大如茺蔚，花红白色，实，八月、九月熟，俗谓之虎麻是也。一名马新蒿，所在有之。"}]},{"ID":"20240611173401-a76g2qd","Type":"NodeParagraph","Properties":{"id":"20240611173401-a76g2qd","updated":"20240611173401"},"Children":[{"Type":"NodeText","Data":"茺蔚苗短小，子夏中熟。而初生二种，极相似也。"}]},{"ID":"20240611173327-71vqy9e","Type":"NodeThematicBreak","Properties":{"id":"20240611173327-71vqy9e"}},{"ID":"20240611173337-opbvan9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173337-opbvan9","updated":"20240611173346"},"Children":[{"Type":"NodeText","Data":"马先蒿《千金翼方》"}]},{"ID":"20240611173337-6b82tpv","Type":"NodeParagraph","Properties":{"id":"20240611173337-6b82tpv","updated":"20240611173337"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主寒热鬼疰，中风湿痹，女子带下病，无子。一名马屎蒿，生南阳川泽。"}]},{"ID":"20240611173327-54sv72r","Type":"NodeThematicBreak","Properties":{"id":"20240611173327-54sv72r"}},{"ID":"20240611173329-nt6kgxj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173329-nt6kgxj","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：马先蒿"}]},{"ID":"20240611173329-7pzemjl","Type":"NodeParagraph","Properties":{"id":"20240611173329-7pzemjl","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173329-p5cg7y1","Type":"NodeParagraph","Properties":{"id":"20240611173329-p5cg7y1","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" Mǎ Xiān Hāo"}]},{"ID":"20240611173329-noxfe7j","Type":"NodeParagraph","Properties":{"id":"20240611173329-noxfe7j","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173329-3sf9mst","Type":"NodeParagraph","Properties":{"id":"20240611173329-3sf9mst","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 广布马先蒿"}]},{"ID":"20240611173329-oxvrnrm","Type":"NodeParagraph","Properties":{"id":"20240611173329-oxvrnrm","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173329-q4k62bj","Type":"NodeParagraph","Properties":{"id":"20240611173329-q4k62bj","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 玄参科马先蒿属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"华马先蒿"},{"Type":"NodeText","Data":"Pedicularis oederi Vahl var. sinensis （Maxim.）Hurus.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"入药。春秋采挖，除净泥土，晒干。"}]},{"ID":"20240611173329-b2q5qdx","Type":"NodeParagraph","Properties":{"id":"20240611173329-b2q5qdx","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"正种"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"藏新马先蒿"},{"Type":"NodeText","Data":"Pedicularis oederi Vahl，分布于西藏、新疆。根亦供药用。"}]},{"ID":"20240611173329-7ui3i9a","Type":"NodeParagraph","Properties":{"id":"20240611173329-7ui3i9a","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173329-p7gl1l4","Type":"NodeParagraph","Properties":{"id":"20240611173329-p7gl1l4","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240611173329-oxd9m75","Type":"NodeParagraph","Properties":{"id":"20240611173329-oxd9m75","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173329-chlc7ih","Type":"NodeParagraph","Properties":{"id":"20240611173329-chlc7ih","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 祛风利湿，杀虫。用于风湿性关节炎，尿路结石，小便不利。外用治疥疮。"}]},{"ID":"20240611173329-dz757bs","Type":"NodeParagraph","Properties":{"id":"20240611173329-dz757bs","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173329-l68vhh8","Type":"NodeParagraph","Properties":{"id":"20240611173329-l68vhh8","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 2～3钱；外用适量，煎水洗患处。"}]},{"ID":"20240611173329-p9qxt53","Type":"NodeParagraph","Properties":{"id":"20240611173329-p9qxt53","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173329-bewm44y","Type":"NodeParagraph","Properties":{"id":"20240611173329-bewm44y","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240611173329-9f6sn4z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173329-9f6sn4z","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：马先蒿"}]},{"ID":"20240611173329-lajz95k","Type":"NodeParagraph","Properties":{"id":"20240611173329-lajz95k","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173329-1j1bvuo","Type":"NodeParagraph","Properties":{"id":"20240611173329-1j1bvuo","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" Mǎ Xiān Hāo"}]},{"ID":"20240611173329-biyd6sz","Type":"NodeParagraph","Properties":{"id":"20240611173329-biyd6sz","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173329-w0f514g","Type":"NodeParagraph","Properties":{"id":"20240611173329-w0f514g","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 马屎蒿（《本经》），马新蒿（陆玑《诗疏》），烂石草（《肘后方》），练石草（《别录》），虎麻（《唐本草》），马尿泡（《山西中草药》）。"}]},{"ID":"20240611173329-sqwh39j","Type":"NodeParagraph","Properties":{"id":"20240611173329-sqwh39j","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240611173329-jgq7dcx","Type":"NodeParagraph","Properties":{"id":"20240611173329-jgq7dcx","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240611173329-s2ayr1q","Type":"NodeParagraph","Properties":{"id":"20240611173329-s2ayr1q","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173329-zzddbr0","Type":"NodeParagraph","Properties":{"id":"20240611173329-zzddbr0","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 为玄参科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"返顾马先蒿"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎叶"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋季采挖，去净茎叶及泥土，晒干。"}]},{"ID":"20240611173329-363t72j","Type":"NodeParagraph","Properties":{"id":"20240611173329-363t72j","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611173329-nvfij7o","Type":"NodeParagraph","Properties":{"id":"20240611173329-nvfij7o","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 生于草地及林缘。分布东北及内蒙古、山东、河北、山西、陕西、安徽、甘肃、四川、贵州等地。"}]},{"ID":"20240611173329-evnt4uk","Type":"NodeParagraph","Properties":{"id":"20240611173329-evnt4uk","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611173329-2svqxe1","Type":"NodeParagraph","Properties":{"id":"20240611173329-2svqxe1","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 多年生草本，高30～70厘米，直立。根多数丛生，细长纤维状。茎粗壮中空，方形有棱。叶互生或有时对生，卵形至长圆状披针形，长2.5～5.5厘米，宽1～2厘米，先端渐狭，基部广楔形或圆形，边缘有钝圆的重齿，两面无毛或有疏毛；叶柄短。花单生于茎枝上部的叶腋；萼长卵圆形，前方深裂，齿2枚；花冠长2～2.5厘米，淡紫红花，冠管向右扭旋，上唇盔状，扭向后方，下唇大，有缘毛，3裂，中裂较小；雄蕊花丝前面1对有毛；柱头伸出于喙端。蒴果斜长圆状披针形，长1～1.5匣米。花期6～8月。果期?～9月。"}]},{"ID":"20240611173329-7oal9tt","Type":"NodeParagraph","Properties":{"id":"20240611173329-7oal9tt","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173329-qlpffk5","Type":"NodeParagraph","Properties":{"id":"20240611173329-qlpffk5","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240611173329-ky8ifut","Type":"NodeParagraph","Properties":{"id":"20240611173329-ky8ifut","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味平。\""}]},{"ID":"20240611173329-cmwkklu","Type":"NodeParagraph","Properties":{"id":"20240611173329-cmwkklu","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"苦，无毒。\""}]},{"ID":"20240611173329-gkpqizs","Type":"NodeParagraph","Properties":{"id":"20240611173329-gkpqizs","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173329-quagzwf","Type":"NodeParagraph","Properties":{"id":"20240611173329-quagzwf","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 祛风，胜湿，利水。治风湿关节疼痛，小便不利，尿路结石，妇女白带，疥疮。"}]},{"ID":"20240611173329-6vawrc8","Type":"NodeParagraph","Properties":{"id":"20240611173329-6vawrc8","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主寒热，中风湿痹，女子带下病，无子。\""}]},{"ID":"20240611173329-odtvstg","Type":"NodeParagraph","Properties":{"id":"20240611173329-odtvstg","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"治五癃，破石淋，膀胱中结气，利水道小便。\""}]},{"ID":"20240611173329-37vy4wu","Type":"NodeParagraph","Properties":{"id":"20240611173329-37vy4wu","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"主恶疮。\""}]},{"ID":"20240611173329-bjtjs9u","Type":"NodeParagraph","Properties":{"id":"20240611173329-bjtjs9u","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"④《山西中草药》：\"祛风胜湿。\""}]},{"ID":"20240611173329-u2u40sw","Type":"NodeParagraph","Properties":{"id":"20240611173329-u2u40sw","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173329-saogdtx","Type":"NodeParagraph","Properties":{"id":"20240611173329-saogdtx","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～3钱；或研末为散。外用：煎水洗。"}]},{"ID":"20240611173329-3h0qqvz","Type":"NodeParagraph","Properties":{"id":"20240611173329-3h0qqvz","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240611173329-4vhtibl","Type":"NodeParagraph","Properties":{"id":"20240611173329-4vhtibl","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" ①治大疯癞疾，骨肉疽败，眉须堕落，身体痒痛：马先蒿，炒捣末，每服方寸匕，食前温酒下，一日三服，一年都瘥。（《肘后方》）"}]},{"ID":"20240611173329-toio900","Type":"NodeParagraph","Properties":{"id":"20240611173329-toio900","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"②治风湿性关节炎，关节疼寤，小便少：马先蒿根五钱，水煎服。"}]},{"ID":"20240611173329-lz7kg2q","Type":"NodeParagraph","Properties":{"id":"20240611173329-lz7kg2q","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"③治尿路结石，小便不畅：马先蒿根四两，研末，每服二钱，开水送服，每天二次。"}]},{"ID":"20240611173329-j7pd8jx","Type":"NodeParagraph","Properties":{"id":"20240611173329-j7pd8jx","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"④治疥疮：马先蒿根适量，煎汤洗患部。（②方以下出《河北中草药手册》）"}]},{"ID":"20240611173329-gblp50n","Type":"NodeParagraph","Properties":{"id":"20240611173329-gblp50n","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173329-cc56m9c","Type":"NodeParagraph","Properties":{"id":"20240611173329-cc56m9c","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240611173329-uwyh6sx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611173329-uwyh6sx","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"《中华本草》：马先蒿"}]},{"ID":"20240611173329-0kanvqn","Type":"NodeParagraph","Properties":{"id":"20240611173329-0kanvqn","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240611173329-6j4iir0","Type":"NodeParagraph","Properties":{"id":"20240611173329-6j4iir0","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" Mǎ Xiān Hāo"}]},{"ID":"20240611173329-dh0x6w4","Type":"NodeParagraph","Properties":{"id":"20240611173329-dh0x6w4","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240611173329-ix0jk6z","Type":"NodeParagraph","Properties":{"id":"20240611173329-ix0jk6z","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 马屎蒿、马新蒿、烂石草、练石草、虎麻、马尿泡、芝麻七"}]},{"ID":"20240611173329-nriqycm","Type":"NodeParagraph","Properties":{"id":"20240611173329-nriqycm","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240611173329-p25y7af","Type":"NodeParagraph","Properties":{"id":"20240611173329-p25y7af","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 药材基源：为玄参科植物返顾马先蒿的根。"}]},{"ID":"20240611173329-asfgvnb","Type":"NodeParagraph","Properties":{"id":"20240611173329-asfgvnb","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Pedicularis resupinata L"}]},{"ID":"20240611173329-ocmi96t","Type":"NodeParagraph","Properties":{"id":"20240611173329-ocmi96t","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采挖，去净茎叶及泥土，晒干。"}]},{"ID":"20240611173329-tg3uif3","Type":"NodeParagraph","Properties":{"id":"20240611173329-tg3uif3","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240611173329-c1d6t53","Type":"NodeParagraph","Properties":{"id":"20240611173329-c1d6t53","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于草地及林缘。"}]},{"ID":"20240611173329-kkdispc","Type":"NodeParagraph","Properties":{"id":"20240611173329-kkdispc","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、内蒙古、河北、山西、陕西、甘肃、山东、安徽、四川、贵州等地。"}]},{"ID":"20240611173329-19y5f6s","Type":"NodeParagraph","Properties":{"id":"20240611173329-19y5f6s","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240611173329-hgpg3u2","Type":"NodeParagraph","Properties":{"id":"20240611173329-hgpg3u2","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 返顾马先蒿，多年生30-70cm。根多数丛生，细长而纤维状。茎常单生，直立，上部分枝，粗壮，中空，方形有棱。叶互生或对生；叶柄知，上部叶近无柄，无毛；叶片膜质至纸质；卵形至长圆状披针形，长2.5-5.5cm，宽1-2cm，先端渐窄，基部楔形或圆形，边缘有钝圆的重锯齿，两面无毛或有疏毛。花单生于茎枝顶端的叶腋中；无梗或有短梗；萼长圆卵形，膜质，前方深裂，齿仅2枚，宽三角形，全缘或略有齿，光滑或有微缘毛；z花冠淡紫红色，长2-2.5cm，管长1.2-1.5cm，向右扭旋，上唇盔状，扭向右方，下唇大，有缘毛，3裂，中裂较小；雄蕊花丝前面一对有毛；花柱伸出喙端。蒴果斜长圆状披针形，长1-1.6cm。花期6-8月，果期7-9月。"}]},{"ID":"20240611173329-mdspiwp","Type":"NodeParagraph","Properties":{"id":"20240611173329-mdspiwp","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240611173329-ik957bj","Type":"NodeParagraph","Properties":{"id":"20240611173329-ik957bj","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 味苦；性平"}]},{"ID":"20240611173329-xuo4bfw","Type":"NodeParagraph","Properties":{"id":"20240611173329-xuo4bfw","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240611173329-asn0hdi","Type":"NodeParagraph","Properties":{"id":"20240611173329-asn0hdi","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 祛风湿；利小便。主风湿关节疼痛；尿路结石；小便不利；妇女白带；大风瘌疾；疥疮"}]},{"ID":"20240611173329-b7lmnfc","Type":"NodeParagraph","Properties":{"id":"20240611173329-b7lmnfc","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240611173329-dlrtut1","Type":"NodeParagraph","Properties":{"id":"20240611173329-dlrtut1","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g，或研末。外用：适量，煎水洗。"}]},{"ID":"20240611173329-4cboc93","Type":"NodeParagraph","Properties":{"id":"20240611173329-4cboc93","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240611173329-si7a0y9","Type":"NodeParagraph","Properties":{"id":"20240611173329-si7a0y9","updated":"20240611173329"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240611173329-u3i19bk","Type":"NodeThematicBreak","Properties":{"id":"20240611173329-u3i19bk"}},{"ID":"20240611173331-nuue60l","Type":"NodeParagraph","Properties":{"id":"20240611173331-nuue60l"}}]}