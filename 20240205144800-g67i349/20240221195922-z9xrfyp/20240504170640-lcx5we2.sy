{"ID":"20240504170640-lcx5we2","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240504170640-lcx5we2","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240504170640-lcx5we2\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240504170640-y0xl6rg\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240611164626-v7wm0z3\u0026quot;,\u0026quot;scrollTop\u0026quot;:1715,\u0026quot;focusId\u0026quot;:\u0026quot;20240611165006-gomhanq\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"190王瓜（王瓜根、土瓜根）","type":"doc","updated":"20240820114141"},"Children":[{"ID":"20240710162028-33pg8a4","Type":"NodeParagraph","Properties":{"id":"20240710162028-33pg8a4","updated":"20240710162441"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"土瓜根 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/土瓜根 4-20240710162439-mqco9yh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240625112134-zamsg91","Type":"NodeParagraph","Properties":{"id":"20240625112134-zamsg91","updated":"20240820111326"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 378px;","style":"width: 368px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜-20240625112134-r0gr9rc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 368px;\" parent-style=\"width: 378px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 626px;","style":"width: 616px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜7"},{"Type":"NodeCloseBracket"},{"Type":"NodeO