 593px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 595px;","style":"width: 585px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜 7-20240820114141-kzcbjmj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 585px;\" parent-style=\"width: 595px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240625113825-yn964kd","Type":"NodeParagraph","Properties":{"id":"20240625113825-yn964kd","updated":"20240820111553"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 284px;","style":"width: 274px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜9-20240625113953-881mmrj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 274px;\" parent-style=\"width: 284px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 363px;","style":"width: 353px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜-20240820111508-w0kkbiy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 353px;\" parent-style=\"width: 363px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 597px;","style":"width: 587px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜 1-20240820111553-xhosizw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 587px;\" parent-style=\"width: 597px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820111639-hhr7ubi","Type":"NodeParagraph","Properties":{"id":"20240820111639-hhr7ubi","updated":"20240820111714"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 662px;","style":"width: 652px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜 2-20240820111639-rk6drrg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 652px;\" parent-style=\"width: 662px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 602px;","style":"width: 592px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜 3-20240820111714-tvu3140.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 592px;\" parent-style=\"width: 602px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240625113115-3qi2p7t","Type":"NodeParagraph","Properties":{"id":"20240625113115-3qi2p7t","updated":"20240820113642"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 447px;","style":"width: 437px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜5-20240625113115-5w24fv7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 437px;\" parent-style=\"width: 447px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 408px;","style":"width: 398px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜10-20240625114247-g51nomp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 398px;\" parent-style=\"width: 408px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240820111925-g6cjk3q","Type":"NodeParagraph","Properties":{"id":"20240820111925-g6cjk3q","updated":"20240820111925"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"王瓜 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/王瓜 5-20240820111925-a65ayyu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240611164622-je6dz13","Type":"NodeThematicBreak","Properties":{"id":"20240611164622-je6dz13"}},{"ID":"20240611164657-po2j13d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164657-po2j13d","updated":"20240611164703"},"Children":[{"Type":"NodeText","Data":"王瓜《神农本草经》"}]},{"ID":"20240611164657-ictqlju","Type":"NodeParagraph","Properties":{"id":"20240611164657-ictqlju","updated":"20240611164657"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240611164657-55r9pg8","Type":"NodeParagraph","Properties":{"id":"20240611164657-55r9pg8","updated":"20240611164657"},"Children":[{"Type":"NodeText","Data":"主消渴内痹淤血，月闭，寒热，酸疼，益气，俞聋。一名土瓜。生平泽。"}]},{"ID":"20240611164657-v0f1oqw","Type":"NodeParagraph","Properties":{"id":"20240611164657-v0f1oqw","updated":"20240611164657"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生鲁地田野，及人家垣墙间，三月采根，阴干。"}]},{"ID":"20240611164657-ssif2gh","Type":"NodeParagraph","Properties":{"id":"20240611164657-ssif2gh","updated":"20240611164657"},"Children":[{"Type":"NodeText","Data":"案《说文》云：萯，王萯也。《广雅》云：葵菇，瓜（娄瓜），王瓜也。《夏小正》云：四月王萯秀。《尔雅》云：钩葵菇。郭璞云：钩，（娄瓜）也。一名王瓜，实如瓝瓜，正赤，味苦，月令，王瓜生。郑元云：月令云，王萯生，孔颖连云：疑王萯，则王瓜也。《管子·地员篇》，剽土之次，曰：五沙：其种大萯细萯，白茎青秀以蔓。本草图经云：大，即王萯也。亦谓之土瓜，自别是一物。"}]},{"ID":"20240611164704-cbk352e","Type":"NodeThematicBreak","Properties":{"id":"20240611164704-cbk352e"}},{"ID":"20240611164751-f4wbvbp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164751-f4wbvbp","updated":"20240611164757"},"Children":[{"Type":"NodeText","Data":"王瓜《本草纲目》"}]},{"ID":"20240611164751-ryqx8um","Type":"NodeParagraph","Properties":{"id":"20240611164751-ryqx8um","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"「释名」土瓜、钩、老鸦瓜、马瓞瓜、赤雹子、野甜瓜、师姑草、公公须。"}]},{"ID":"20240611164751-0q5c9ei","Type":"NodeParagraph","Properties":{"id":"20240611164751-0q5c9ei","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。（子）酸、苦、平、无毒。"}]},{"ID":"20240611164751-o5qqfsi","Type":"NodeParagraph","Properties":{"id":"20240611164751-o5qqfsi","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240611164751-lf6dhfx","Type":"NodeParagraph","Properties":{"id":"20240611164751-lf6dhfx","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"1、小儿发黄。用王瓜根生捣汁，每服三合。服三次即可见效。"}]},{"ID":"20240611164751-k92v4i1","Type":"NodeParagraph","Properties":{"id":"20240611164751-k92v4i1","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"2、黄疸变黑。用王瓜根捣汁，清晨温服一小升，午刻黄水从小便排出。如未排出，可再次服药。"}]},{"ID":"20240611164751-ub705q2","Type":"NodeParagraph","Properties":{"id":"20240611164751-ub705q2","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"3、大便不通。用上方吹入肛门内。"}]},{"ID":"20240611164751-xbcphmp","Type":"NodeParagraph","Properties":{"id":"20240611164751-xbcphmp","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"4、乳汁不下。用王瓜根为末，每服一钱，酒送下。一天服二次。"}]},{"ID":"20240611164751-2rvt46g","Type":"NodeParagraph","Properties":{"id":"20240611164751-2rvt46g","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"5、月经不利（小腹胀痛、带下或一月两次月经）。用王瓜根、芍药、桂枝虫各三两，共研为末，每服一匙酒送。一天服三次。此方名“土瓜根散”。"}]},{"ID":"20240611164751-9gdq2oc","Type":"NodeParagraph","Properties":{"id":"20240611164751-9gdq2oc","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"6、反胃吐食。用王瓜烧存性，取一钱加枣肉、平胃散二钱，酒送下。"}]},{"ID":"20240611164751-pslyt4s","Type":"NodeParagraph","Properties":{"id":"20240611164751-pslyt4s","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"7、筋骨痛。用王瓜子炒开口，研为末。每服一钱，酒送下。一天服二次。"}]},{"ID":"20240611164751-svgk546","Type":"NodeParagraph","Properties":{"id":"20240611164751-svgk546","updated":"20240611164751"},"Children":[{"Type":"NodeText","Data":"8、大肠下血。用王瓜一两（烧存性）、地黄二两、黄连半两，黄研为末，加蜜做成丸子，如梧子大。米汤冲服三十丸。"}]},{"ID":"20240611164807-t7m4ju2","Type":"NodeThematicBreak","Properties":{"id":"20240611164807-t7m4ju2"}},{"ID":"20240611164808-cv29lbl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164808-cv29lbl","updated":"20240611164815"},"Children":[{"Type":"NodeText","Data":"王瓜《新修本草》"}]},{"ID":"20240611164808-r3e319u","Type":"NodeParagraph","Properties":{"id":"20240611164808-r3e319u","updated":"20240611164808"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴，内痹，瘀血，月闭，寒热，酸疼，益气，愈聋。疗诸邪气，热结，鼠 ，散痈肿留血，妇人带下不通，下乳汁，止小便数不禁，逐四肢骨节中水，疗马骨刺人疮。一名土瓜。生鲁地平泽田野，及人家垣墙间。"}]},{"ID":"20240611164808-1yhn1ro","Type":"NodeParagraph","Properties":{"id":"20240611164808-1yhn1ro","updated":"20240611164808"},"Children":[{"Type":"NodeText","Data":"三月采根，阴干。"}]},{"ID":"20240611164808-rjpmqjf","Type":"NodeParagraph","Properties":{"id":"20240611164808-rjpmqjf","updated":"20240611164808"},"Children":[{"Type":"NodeText","Data":"今土瓜生篱院间亦有，子熟时赤，如弹丸大。根今多不预干，临用时乃掘取，不堪入大方，正单行小小尔。《礼记·月令》云∶王瓜生，此之谓也。郑玄云菝 ，殊为谬矣。"}]},{"ID":"20240611164808-rzewj6e","Type":"NodeParagraph","Properties":{"id":"20240611164808-rzewj6e","updated":"20240611164808"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240611164808-15tbgwn","Type":"NodeParagraph","Properties":{"id":"20240611164808-15tbgwn","updated":"20240611164808"},"Children":[{"Type":"NodeText","Data":"北间者，累累相连，大如枣，皮黄肉白。苗子相似，根状不同。试疗黄胆、破血，南者大胜也。"}]},{"ID":"20240611164830-6gwgarh","Type":"NodeThematicBreak","Properties":{"id":"20240611164830-6gwgarh"}},{"ID":"20240611164831-ya3u9ae","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164831-ya3u9ae","updated":"20240611164838"},"Children":[{"Type":"NodeText","Data":"王瓜《本草述钩元》"}]},{"ID":"20240611164831-1eizxm4","Type":"NodeParagraph","Properties":{"id":"20240611164831-1eizxm4","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"三月生苗。其蔓多须。其叶圆。如马蹄而有尖。面青背淡。涩而不光。六七月开五出小黄花。成簇。结子累累。熟时有红黄二色。皮亦粗涩。根如栝蒌根之小者。澄粉甚白腻。"}]},{"ID":"20240611164831-cchu14y","Type":"NodeParagraph","Properties":{"id":"20240611164831-cchu14y","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"须下尖长"}]},{"ID":"20240611164831-bt3fwr9","Type":"NodeParagraph","Properties":{"id":"20240611164831-bt3fwr9","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"根"}]},{"ID":"20240611164831-xhxk2nk","Type":"NodeParagraph","Properties":{"id":"20240611164831-xhxk2nk","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"气味苦寒。有小毒。能吐下人。主治消渴内痹。血月闭。寒热酸疼。益气愈聋。疗诸邪气下乳能除湿黄胆变黑。用土瓜根汁。平旦温服一小升。午刻黄水当从小便出。不出。再服。小便如泔。"}]},{"ID":"20240611164831-flhn8re","Type":"NodeParagraph","Properties":{"id":"20240611164831-flhn8re","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"末。"}]},{"ID":"20240611164831-b2es2tz","Type":"NodeParagraph","Properties":{"id":"20240611164831-b2es2tz","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"王瓜〔论〕经云。寒泣血。王瓜乃以苦寒而效活血之用。知其所治之瘀血。皆因于热者。第细绎又或用于再以实于六"}]},{"ID":"20240611164831-c50qudv","Type":"NodeParagraph","Properties":{"id":"20240611164831-c50qudv","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"子"}]},{"ID":"20240611164831-cv4d6xa","Type":"NodeParagraph","Properties":{"id":"20240611164831-cv4d6xa","updated":"20240611164831"},"Children":[{"Type":"NodeText","Data":"即赤雹子味酸苦。气平。生用。润心肺。治黄病。炒用。治肺痿吐血。肠风泻血赤白痢。疗反胃吐食赤雹儿半两。"}]},{"ID":"20240611164843-udgk524","Type":"NodeThematicBreak","Properties":{"id":"20240611164843-udgk524"}},{"ID":"20240611164845-9wpm60u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164845-9wpm60u","updated":"20240611164853"},"Children":[{"Type":"NodeText","Data":"王瓜《本草备要》"}]},{"ID":"20240611164845-ikigrwz","Type":"NodeParagraph","Properties":{"id":"20240611164845-ikigrwz","updated":"20240611164850"},"Children":[{"Type":"NodeText","Data":"即土瓜根"}]},{"ID":"20240611164845-6hdgw9h","Type":"NodeParagraph","Properties":{"id":"20240611164845-6hdgw9h","updated":"20240611164845"},"Children":[{"Type":"NodeText","Data":"泻热，利水，行血"}]},{"ID":"20240611164845-0fuhmnq","Type":"NodeParagraph","Properties":{"id":"20240611164845-0fuhmnq","updated":"20240611164845"},"Children":[{"Type":"NodeText","Data":"苦寒。泻热利水。治天行热疾，黄胆消渴（捣汁饮），便数带下，月闭瘀血。利大、小肠，排脓消肿，下乳（通乳药多用之，单服亦可）堕胎。"}]},{"ID":"20240611164845-3zxkkth","Type":"NodeParagraph","Properties":{"id":"20240611164845-3zxkkth","updated":"20240611164845"},"Children":[{"Type":"NodeText","Data":"根如栝蒌之小者，味如山药，根、子通用（《经疏》曰∶主治略似栝蒌。伤寒发斑，用王瓜捣汁，和伏龙肝末服，甚效）。"}]},{"ID":"20240611164943-sic3yrt","Type":"NodeThematicBreak","Properties":{"id":"20240611164943-sic3yrt"}},{"ID":"20240611164944-tuvxbad","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164944-tuvxbad","updated":"20240611164948"},"Children":[{"Type":"NodeText","Data":"王瓜《本草撮要》"}]},{"ID":"20240611164944-wrvmp7u","Type":"NodeParagraph","Properties":{"id":"20240611164944-wrvmp7u","updated":"20240611164944"},"Children":[{"Type":"NodeText","Data":"味苦寒．入手足太阴经．功专泻热利水．治天行热疾．黄胆消渴．便数带下．月闭瘀血．利大小肠．排脓消肿．下乳．得伏龙肝捣汁调和服．治伤寒发斑．即土瓜根子．名赤雹子．治肺痿吐血．肠风泻血赤白痢．得枣肉平胃散酒服．治反胃．"}]},{"ID":"20240611165005-yadg1ia","Type":"NodeThematicBreak","Properties":{"id":"20240611165005-yadg1ia"}},{"ID":"20240611165006-gomhanq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611165006-gomhanq","updated":"20240611165014"},"Children":[{"Type":"NodeText","Data":"王瓜《本草图经》"}]},{"ID":"20240611165006-nj5y6vt","Type":"NodeParagraph","Properties":{"id":"20240611165006-nj5y6vt","updated":"20240611165008"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"王瓜"},{"Type":"NodeText","Data":"，生鲁地平泽田野及人家垣墙间，今处处有之。《月令》∶四月王瓜生，即此也。叶似栝蒌，圆无叉缺，有刺如毛。五月开黄花；花下结子如弹丸，生青熟赤；根似葛，细而多糁，谓之土瓜根。北间者，其实累累相连，大如枣，皮黄肉白，苗叶都相似；但根状不同耳。"}]},{"ID":"20240611165006-4t05gde","Type":"NodeParagraph","Properties":{"id":"20240611165006-4t05gde","updated":"20240611165006"},"Children":[{"Type":"NodeText","Data":"三月采根，阴干。均房间人，呼为老鸦瓜，亦曰菟瓜。谨按《尔雅》曰∶ （羊善切），菟瓜。郭璞注云∶似土瓜。而土瓜自谓之 （与睽同）菇（与姑同），又名钩菇，盖菟瓜别是一种也。又云∶芴（音物）菲，亦谓之土瓜，自别是一物。《诗》所谓采葑采菲者，非此土瓜也。"}]},{"ID":"20240611165006-klyp2vi","Type":"NodeParagraph","Properties":{"id":"20240611165006-klyp2vi","updated":"20240611165006"},"Children":[{"Type":"NodeText","Data":"大凡物有异类同名甚多，不可不辨也。葛氏疗面上痱瘰子用之，仍得光润皮急，以土瓜根捣筛，浆水匀和，入夜先浆水洗面，傅药，旦复洗之，百日光华射人。小儿四岁发黄，生捣绞汁三合，与饮，不过三饮，已。"}]},{"ID":"20240611164954-9a89db2","Type":"NodeThematicBreak","Properties":{"id":"20240611164954-9a89db2"}},{"ID":"20240611164955-tmww1tm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164955-tmww1tm","updated":"20240611164959"},"Children":[{"Type":"NodeText","Data":"土瓜根《长沙药解》"}]},{"ID":"20240611164955-or69a8h","Type":"NodeParagraph","Properties":{"id":"20240611164955-or69a8h","updated":"20240611164955"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】王瓜。味苦寒。主消渴内痹淤血，月闭，寒热，酸疼，益气，俞聋。一名土瓜。生平泽。"}]},{"ID":"20240611164955-79gzanx","Type":"NodeParagraph","Properties":{"id":"20240611164955-79gzanx","updated":"20240611164955"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，入足厥阴肝经。调经脉而破瘀涩，润肠燥而清阴癞。"}]},{"ID":"20240611164955-75fjhem","Type":"NodeParagraph","Properties":{"id":"20240611164955-75fjhem","updated":"20240611164955"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"土瓜根散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"土瓜根、（庶/虫）虫、桂枝、芍药等分。为散，酒服方寸匕，日进三服。"},{"Type":"NodeText","Data":"治女子经水不利，一月再见，少腹满痛者。以肝主藏血而性疏泄，木郁不能疏泄，血脉凝涩，故经水不利。木郁风动而愈欲疏泄，故一月再见。风木遏陷，郁塞冲突，故少腹满痛。从此郁盛而不泄，则病经闭，泄多而失藏，则病血崩。桂枝、芍药，疏木而清风，土瓜根、（庶/虫）虫，破瘀而行血也。又治阴门癞肿者，以其行血而达木也。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"肝气郁陷，则病癞肿。"},{"Type":"NodeText","Data":"又导大便结硬者，以其泻热而润燥也。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"阳明伤寒，自汗出，小便利，津液内竭，而便硬者，当须自欲大便，蜜煎导而通之，土瓜根、猪胆汁皆可为导。《肘后方》：土瓜根汁，入少水，内筒，吹入肛门内，取通。"}]},{"ID":"20240611164955-6xdry0h","Type":"NodeParagraph","Properties":{"id":"20240611164955-6xdry0h","updated":"20240611164955"},"Children":[{"Type":"NodeText","Data":"土瓜根苦寒滑利，善行经脉，破瘀行血，化癖消癥。其诸主治，通经闭，下乳汁，消瘰疬，散痈肿，排脓血，利小便，滑大肠，疗黄疸，坠胎孕。"}]},{"ID":"20240611164931-g1stp1b","Type":"NodeThematicBreak","Properties":{"id":"20240611164931-g1stp1b"}},{"ID":"20240611164932-t2wxdbq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164932-t2wxdbq","updated":"20240611164936"},"Children":[{"Type":"NodeText","Data":"王瓜《神农本草经赞》"}]},{"ID":"20240611164932-2na81m2","Type":"NodeParagraph","Properties":{"id":"20240611164932-2na81m2","updated":"20240611164932"},"Children":[{"Type":"NodeText","Data":"味苦寒。主消渴内痹。瘀血。月闭。寒热酸疼。益气愈聋。一名土瓜。生平泽。"}]},{"ID":"20240611164932-kuztkxn","Type":"NodeParagraph","Properties":{"id":"20240611164932-kuztkxn","updated":"20240611164932"},"Children":[{"Type":"NodeText","Data":"俯瞩篱垣。蔓牵瓞濯。花小黄匀。叶圆青濯。甫降青霜。纷垂赤雹。三五根连。壅培。"}]},{"ID":"20240611164932-8tzxmzu","Type":"NodeParagraph","Properties":{"id":"20240611164932-8tzxmzu","updated":"20240611164932"},"Children":[{"Type":"NodeText","Data":"名医曰。生鲁地田野。及人家墙垣。诗笺。瓜瓞。瓜小状似。故谓之瓞。李时珍曰。"}]},{"ID":"20240611164932-d1xnulr","Type":"NodeParagraph","Properties":{"id":"20240611164932-d1xnulr","updated":"20240611164932"},"Children":[{"Type":"NodeText","Data":"其蔓多须。叶圆如蹄有尖。面青背淡。江西人栽之沃土。六七月开小黄花成簇。王勃序。紫电青霜。寇宗曰。瓜壳径寸。长二寸许。七八月熟。红赤色。今人谓之赤雹子。细根上又生淡黄根。三五相连。汉书传注。瘠薄之地。"}]},{"ID":"20240611164920-w5klsaf","Type":"NodeThematicBreak","Properties":{"id":"20240611164920-w5klsaf"}},{"ID":"20240611164921-bwrfto6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164921-bwrfto6","updated":"20240611164926"},"Children":[{"Type":"NodeText","Data":"王瓜《千金翼方》"}]},{"ID":"20240611164921-k7axa6z","Type":"NodeParagraph","Properties":{"id":"20240611164921-k7axa6z","updated":"20240611164921"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴内痹，瘀血月闭，寒热酸疼，益气愈聋。疗诸邪气，热散痈肿留血，妇人带下不通，下乳汁，止小便数不禁，逐四肢骨节中水，疗马骨刺人疮名土瓜。生鲁地平泽田野及人家垣墙间，三月采根，阴干。"}]},{"ID":"20240611164910-ydxphsq","Type":"NodeThematicBreak","Properties":{"id":"20240611164910-ydxphsq"}},{"ID":"20240611164911-r36qgiz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164911-r36qgiz","updated":"20240611164915"},"Children":[{"Type":"NodeText","Data":"王瓜《本草从新》"}]},{"ID":"20240611164911-njl6yuc","Type":"NodeParagraph","Properties":{"id":"20240611164911-njl6yuc","updated":"20240611164911"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即土瓜根．泻热、通、利水行血．"}]},{"ID":"20240611164911-be1r2qs","Type":"NodeParagraph","Properties":{"id":"20240611164911-be1r2qs","updated":"20240611164911"},"Children":[{"Type":"NodeText","Data":"苦寒．泻热利水．治天行热疾．黄胆消渴．（捣汁饮．）便数带下．月闭瘀血．利大小肠．"}]},{"ID":"20240611164911-39mrm25","Type":"NodeParagraph","Properties":{"id":"20240611164911-39mrm25","updated":"20240611164911"},"Children":[{"Type":"NodeText","Data":"排脓消肿．下乳．（通乳药多用之、单服亦可．）堕胎．唯实热壅滞者宜之．稍稍挟虚．切勿妄投．根如栝蒌之小者．味如山药．根子通用．（经疏曰∶主治略似栝蒌、伤寒发斑、用王瓜捣汁、和伏龙肝末服、甚效．黄胆变黑、医所不能治、用土瓜根汁、平旦温服一小升、午刻黄水当从小便出、愈．）"}]},{"ID":"20240611164859-wcnk0by","Type":"NodeThematicBreak","Properties":{"id":"20240611164859-wcnk0by"}},{"ID":"20240611164900-smdxqvc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164900-smdxqvc","updated":"20240611164905"},"Children":[{"Type":"NodeText","Data":"王瓜《冯氏锦囊秘录》"}]},{"ID":"20240611164900-6z0mwxq","Type":"NodeParagraph","Properties":{"id":"20240611164900-6z0mwxq","updated":"20240611164900"},"Children":[{"Type":"NodeText","Data":"禀土中清肃阴寒之气，故味苦，气寒，无毒，而除湿热热毒。"}]},{"ID":"20240611164900-nl4mu6q","Type":"NodeParagraph","Properties":{"id":"20240611164900-nl4mu6q","updated":"20240611164900"},"Children":[{"Type":"NodeText","Data":"王瓜，一名土瓜，根子两用，治小便遗尿不禁，润心肺解虫毒，却黄病黄胆，用子宜生；疗下痢，赤白杂来，驱肠风，除肺痿，止血溢血，治用子须炒。根捣汁，去小儿闪癖痞满，及天行热疾发狂，痰疟暴生，并取服效，惟少为奇，多则吐下；根煎汤服，破妇人血瘕坚 并扑损瘀血作痛，乳汁不下，俱当饮之，过多不妙。仍逐骨节中伏水，更消顶颈上 疮，去湿痹酸痛，散痈疽 肿，通经堕孕，益气愈聋。"}]},{"ID":"20240611164819-2yo6ca1","Type":"NodeThematicBreak","Properties":{"id":"20240611164819-2yo6ca1"}},{"ID":"20240611164820-kudcdlz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164820-kudcdlz","updated":"20240611164824"},"Children":[{"Type":"NodeText","Data":"王瓜《本草蒙筌》"}]},{"ID":"20240611164820-1keo8na","Type":"NodeParagraph","Properties":{"id":"20240611164820-1keo8na","updated":"20240611164820"},"Children":[{"Type":"NodeText","Data":"味苦，气寒。无毒。一云有小毒。生平泽田野，及篱堑垣墙。一名土瓜，处处俱有。"}]},{"ID":"20240611164820-881un32","Type":"NodeParagraph","Properties":{"id":"20240611164820-881un32","updated":"20240611164820"},"Children":[{"Type":"NodeText","Data":"《月令》∶四月王瓜生，即此是也。作藤蔓发叶，多刺微圆。逢夏至开花，深黄单瓣。实结一二寸许，成熟七八月间。外壳红黄如栝蒌状，中子紫赤似螳螂头。采入医方，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根子"},{"Type":"NodeText","Data":"两用。"}]},{"ID":"20240611164820-nnxebq3","Type":"NodeParagraph","Properties":{"id":"20240611164820-nnxebq3","updated":"20240611164820"},"Children":[{"Type":"NodeText","Data":"治小便数遗不禁，润心肺，解蛊毒，却黄病黄胆，用子宜生；疗下痢赤白杂来，驱肠风，除肺痿，止血溢血泄，用子须炒。根捣汁，去小儿闪癖痞满及天行热疾发狂，痰疟暴生，并可服也，但少为奇；（多服则吐下。）根煎汤，破妇人血瘕坚症，并扑损瘀血作痛，乳汁不下，俱当饮之，过多不妙。仍逐骨节中伏水，更消项颈上 疮。去湿痹酸疼，散痈疽 肿。"}]},{"ID":"20240611164820-gvxl4cj","Type":"NodeParagraph","Properties":{"id":"20240611164820-gvxl4cj","updated":"20240611164820"},"Children":[{"Type":"NodeText","Data":"通经堕孕，益气愈聋。"}]},{"ID":"20240611164622-x5rr8wu","Type":"NodeThematicBreak","Properties":{"id":"20240611164622-x5rr8wu"}},{"ID":"20240611164647-ix3m022","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164647-ix3m022","updated":"20240611164652"},"Children":[{"Type":"NodeText","Data":"王瓜《医学入门》"}]},{"ID":"20240611164647-pgue5oi","Type":"NodeParagraph","Properties":{"id":"20240611164647-pgue5oi","updated":"20240611164647"},"Children":[{"Type":"NodeText","Data":"王瓜寒苦除邪热，愈聋止渴清诸血，利疸肿兮消痈毒，带溺不禁尤堪啮。"}]},{"ID":"20240611164647-xz2vk6o","Type":"NodeParagraph","Properties":{"id":"20240611164647-xz2vk6o","updated":"20240611164647"},"Children":[{"Type":"NodeText","Data":"王，大也，独生于诸瓜之前，月令四月王瓜生，即此也，一名土瓜根。处处有之，生田野及人家垣墙间，藤蔓，叶圆无缺，有刺如毛，闽人谓之毛桃。五月开黄花，花下结子如弹丸，如栝蒌，小如栀子，无棱，色黄，根如葛，细而多粘。三月采根，阴干。无毒。主诸邪气热结，及天行热疾，愈耳聋益气。止消渴，内痹瘀血，月闭寒热酸疼。破 癖，落胎。逐四肢骨节中水。散痈肿留血鼠 ，疗马骨刺入疮，妇人带下及小便遗溺不禁。"}]},{"ID":"20240611164647-8xu03vn","Type":"NodeParagraph","Properties":{"id":"20240611164647-8xu03vn","updated":"20240611164647"},"Children":[{"Type":"NodeText","Data":"又治黄胆变黑疸，生捣汁顿服，当有黄水随小便出。汁和酒服，吐蛊毒；为末酒下，下乳汁。子，润心肺，治黄病生用；肺痿、吐血、肠风下血、赤白痢疾炒用。"}]},{"ID":"20240611164623-d9d93hu","Type":"NodeThematicBreak","Properties":{"id":"20240611164623-d9d93hu"}},{"ID":"20240611164636-fzidpw2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164636-fzidpw2","updated":"20240611164642"},"Children":[{"Type":"NodeText","Data":"王瓜《名医别录》"}]},{"ID":"20240611164636-52m9xyj","Type":"NodeParagraph","Properties":{"id":"20240611164636-52m9xyj","updated":"20240611164636"},"Children":[{"Type":"NodeText","Data":"无毒．主治诸邪气，热结，鼠 ，散痈肿、留血，妇人带下不通，下乳汁，止小便数禁，逐四肢骨节中水，治马骨刺人疮，生鲁地田野，及人家垣墙间．三月采根，阴干．"}]},{"ID":"20240611164636-xw2hk8d","Type":"NodeParagraph","Properties":{"id":"20240611164636-xw2hk8d","updated":"20240611164636"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶王瓜，味苦，寒．主消渴内痹，瘀血月闭，寒热酸疼，益气愈聋．一名土瓜．生平泽．"}]},{"ID":"20240611164623-ms45x76","Type":"NodeThematicBreak","Properties":{"id":"20240611164623-ms45x76"}},{"ID":"20240611164624-2z2c4jc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240611164624-2z2c4jc","updated":"20240611164629"},"Children":[{"Type":"NodeText","Data":"王瓜《证类本草》"}]},{"ID":"20240611164624-h38n41p","Type":"NodeParagraph","Properties":{"id":"20240611164624-h38n41p","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主消渴，内痹，瘀血，月闭寒热，酸疼，益气，愈聋，疗诸邪气，热结，鼠 ，散痈肿留血，妇人带下不通，下乳汁，止小便数不禁，逐四肢骨节中水，疗马骨刺人疮。一名土瓜。生鲁地平泽田野及人家垣墙间。三月采根，阴干。"}]},{"ID":"20240611164624-owblcaj","Type":"NodeParagraph","Properties":{"id":"20240611164624-owblcaj","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今土瓜生篱院间亦有，子熟时赤，如弹丸大。根今多不预干，临用时乃掘取。"}]},{"ID":"20240611164624-nde8jsz","Type":"NodeParagraph","Properties":{"id":"20240611164624-nde8jsz","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"不堪入大方，正单行小小尔。《礼记·月令》云∶王瓜生，此之谓也。郑玄云∶菝 ，殊为缪矣。唐本注云∶此物蔓生，叶似栝蒌，圆无叉缺，子如栀子，生青熟赤，但无棱尔。根似葛，细而多糁。北间者累累相连，大如枣，皮黄肉白，苗子相似，根状不同。试疗黄胆，破血。"}]},{"ID":"20240611164624-2i2z53s","Type":"NodeParagraph","Properties":{"id":"20240611164624-2i2z53s","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"南者大胜也。今按陈藏器本草云∶王瓜，主蛊毒，小儿闪癖，痞满并疟。取根及叶，捣绞汁服，当吐下。宜少进之，有小毒故也。臣禹锡等谨按尔雅云∶钩， 姑。释曰∶钩，一名姑。郭云∶钩，薮也。一名王瓜。实如 瓜，正赤味苦。药性论云∶土瓜根，使，平，一名王瓜子，主蛊毒。治小便数，遗不禁。日华子云∶王瓜子，润心肺，治黄病，生用。肺痿，吐血，肠风泻血，赤白痢，炒用。又云∶土瓜根，通血脉，天行热疾，酒黄病，壮热，心烦闷，吐痰痰疟，排脓，热劳，治扑损，消瘀血，破症癖，落胎。"}]},{"ID":"20240611164624-0xipjli","Type":"NodeParagraph","Properties":{"id":"20240611164624-0xipjli","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"图经曰∶王瓜，生鲁地平泽田野及人家垣墙间，今处处有之。《月令》四月王瓜生。即此也。"}]},{"ID":"20240611164624-euo145t","Type":"NodeParagraph","Properties":{"id":"20240611164624-euo145t","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"叶似栝蒌，圆无叉缺，有刺如毛。五月开黄花。花下结子如弹丸，生青熟赤。根似葛，细而多糁，谓之土瓜根。北间者，其实累累相连，大如枣，皮黄肉白。苗叶都相似，但根状不同耳。三月采根，阴干。均、房间人呼为老鸦瓜，亦白菟瓜。谨按《尔雅》曰∶ （羊善切）"}]},{"ID":"20240611164624-haxrpwi","Type":"NodeParagraph","Properties":{"id":"20240611164624-haxrpwi","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"，菟瓜。郭璞注云∶似土瓜。而土瓜自谓之 （与睽同）菇（与姑同），又名钩菇，盖菟瓜别是一种也。又云∶芴（音物），菲，亦谓之土瓜，自别是一物。《诗》所谓采葑采菲者，非此土瓜也。大凡物有异类，同名甚多，不可不辨也。葛氏疗面上痱瘰子用之，仍得光润皮急。以土瓜根捣筛，浆水匀和，入夜先浆水洗面敷药，旦复洗之。百日光华射人。小儿四岁发黄。生捣绞汁三合与饮，不过三饮已。"}]},{"ID":"20240611164624-jdst6om","Type":"NodeParagraph","Properties":{"id":"20240611164624-jdst6om","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治黑疸多死，宜急治。用瓜根一斤，捣绞汁六合，顿服。当有黄水随小便出。"}]},{"ID":"20240611164624-dqujn3w","Type":"NodeParagraph","Properties":{"id":"20240611164624-dqujn3w","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"如未出，更服之。外台秘要∶治蛊。土瓜根大如拇指，长三寸，切。以酒半升渍一宿，一服，当吐下。肘后方∶治黄胆变成黑疸，医所不能治。土瓜根汁，顿服一小升。平旦服食后须病汗，当小便出，愈。不尔，再服。又方∶治小便不通及关格方∶生土瓜根捣取汁，以少水解之筒中，吹下部取通。产书下乳汁。土瓜根为末，酒服一钱，一日三次。"}]},{"ID":"20240611164624-czjzff4","Type":"NodeParagraph","Properties":{"id":"20240611164624-czjzff4","updated":"20240611164624"},"Children":[{"Type":"NodeText","Data":"衍义曰∶王瓜，体如栝蒌，其壳径寸。一种长二寸许，上微圆，下尖长，七、八月间熟，红赤色。壳中子如螳螂头者。今人又谓之赤雹子，其根即土瓜根也。于细根上又生淡黄根，三、五相连，如大指许。根与子两用。红子同白土子治头风。"}]},{"ID":"20240611164625-3zqiv41","Type":"NodeThematicBreak","Properties":{"id":"20240611164625-3zqiv41"}},{"ID":"20240611164626-v7wm0z3","Type":"NodeParagraph","Properties":{"id":"20240611164626-v7wm0z3"}}]}