t-style":"width: 534px;","style":"width: 524px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菘萝"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菘萝-20240821132344-plsvxtq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 524px;\" parent-style=\"width: 534px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 305px;","style":"width: 295px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松萝3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松萝3-20240626151349-iskwutn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 295px;\" parent-style=\"width: 305px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626151611-xg2x6jh","Type":"NodeParagraph","Properties":{"id":"20240626151611-xg2x6jh","updated":"20240821132436"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 381px;","style":"width: 371px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菘萝 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菘萝 1-20240821132436-3nsgege.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 371px;\" parent-style=\"width: 381px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 842px;","style":"width: 832px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松萝5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松萝5-20240626151611-5rwq8ky.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 832px;\" parent-style=\"width: 842px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821133013-aniz6un","Type":"NodeParagraph","Properties":{"id":"20240821133013-aniz6un","updated":"20240821133040"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 607px;","style":"width: 597px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菘萝 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菘萝 3-20240821133031-58pkh4s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 597px;\" parent-style=\"width: 607px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 603px;","style":"width: 593px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"菘萝 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/菘萝 2-20240821133013-25m0hrv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 593px;\" parent-style=\"width: 603px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626151209-04kyd6t","Type":"NodeParagraph","Properties":{"id":"20240626151209-04kyd6t","updated":"20240821132402"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 816px;","style":"width: 806px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"松萝1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/松萝1-20240626151209-otw7x2f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 806px;\" parent-style=\"width: 816px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821132811-04xe68d","Type":"NodeParagraph","Properties":{"id":"20240821132811-04xe68d","updated":"20240821132859"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：菘萝并不是树，而是附在树上的一种丝状植物；"}]},{"ID":"20240612104443-k25q5oq","Type":"NodeThematicBreak","Properties":{"id":"20240612104443-k25q5oq"}},{"ID":"20240612104444-5clbfm3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104444-5clbfm3","updated":"20240612104448"},"Children":[{"Type":"NodeText","Data":"松萝《本经逢原》"}]},{"ID":"20240612104444-yujn6i3","Type":"NodeParagraph","Properties":{"id":"20240612104444-yujn6i3","updated":"20240612104444"},"Children":[{"Type":"NodeText","Data":"苦甘平无毒。"}]},{"ID":"20240612104444-mz0vbt7","Type":"NodeParagraph","Properties":{"id":"20240612104444-mz0vbt7","updated":"20240612104444"},"Children":[{"Type":"NodeText","Data":"《本经》治 怒邪气，止虚汗头风，女子阴寒肿痛。"}]},{"ID":"20240612104444-ozivca6","Type":"NodeParagraph","Properties":{"id":"20240612104444-ozivca6","updated":"20240612104444"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"松萝是松上女萝，又名兔丝，能平肝怒，去寒热邪气。其去头风、止虚汗者，本乎天者亲上也。《别录》疗痰热温疟，可为吐汤利水道，故《肘后方》同瓜蒂、杜蘅酒渍再宿，且饮一合，取吐胸中痰热头痛。《千金方》同瓜蒂、恒山、甘草，水酒和煎，取吐胸膈痰癖，以其轻清上涌，故吐药用之。"}]},{"ID":"20240612104432-aqcjxf3","Type":"NodeThematicBreak","Properties":{"id":"20240612104432-aqcjxf3"}},{"ID":"20240612104433-htshh1o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104433-htshh1o","updated":"20240612104438"},"Children":[{"Type":"NodeText","Data":"松萝《本草纲目拾遗》"}]},{"ID":"20240612104433-3uqhwrb","Type":"NodeParagraph","Properties":{"id":"20240612104433-3uqhwrb","updated":"20240612104433"},"Children":[{"Type":"NodeText","Data":"山川志∶出武当山，生尖峰古木上，长者丈余。"}]},{"ID":"20240612104433-a0fewkm","Type":"NodeParagraph","Properties":{"id":"20240612104433-a0fewkm","updated":"20240612104433"},"Children":[{"Type":"NodeText","Data":"治蛇虎伤，汤火烙伤，及顽疮等症药性考∶松萝甘平，能平肝气，怒痰热，温疟吐痢，头能探吐膈痰，去热。"}]},{"ID":"20240612104421-oao9mr7","Type":"NodeThematicBreak","Properties":{"id":"20240612104421-oao9mr7"}},{"ID":"20240612104423-m16z9in","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104423-m16z9in","updated":"20240612104428"},"Children":[{"Type":"NodeText","Data":"松萝《千金翼方》"}]},{"ID":"20240612104423-g989rgg","Type":"NodeParagraph","Properties":{"id":"20240612104423-g989rgg","updated":"20240612104423"},"Children":[{"Type":"NodeText","Data":"味苦甘，平，无毒。主嗔怒邪气，主虚汗头风。女子子阴寒肿痛，疗痰热，温疟，可为吐汤，利水道。一名女萝。生熊耳山川谷松树上。五月采，阴干。"}]},{"ID":"20240612104245-1nv1kow","Type":"NodeThematicBreak","Properties":{"id":"20240612104245-1nv1kow"}},{"ID":"20240612104409-1hrrhvd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104409-1hrrhvd","updated":"20240612104412"},"Children":[{"Type":"NodeText","Data":"松萝《名医别录》"}]},{"ID":"20240612104409-sbyzd2a","Type":"NodeParagraph","Properties":{"id":"20240612104409-sbyzd2a","updated":"20240612104409"},"Children":[{"Type":"NodeText","Data":"味甘，无毒．主治淡热，温疟，可为吐汤，利水道．生熊耳山松树上．五月采，阴干"}]},{"ID":"20240612104409-83lzlc0","Type":"NodeParagraph","Properties":{"id":"20240612104409-83lzlc0","updated":"20240612104409"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶松萝，味苦，平．主 怒邪气，止虚汗，头风，女子阴寒肿痛．一名女萝．生山谷．"}]},{"ID":"20240612104245-as4276d","Type":"NodeThematicBreak","Properties":{"id":"20240612104245-as4276d"}},{"ID":"20240612104354-3jg2k2b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104354-3jg2k2b","updated":"20240612104359"},"Children":[{"Type":"NodeText","Data":"松萝《医学入门》"}]},{"ID":"20240612104354-jymow2z","Type":"NodeParagraph","Properties":{"id":"20240612104354-jymow2z","updated":"20240612104354"},"Children":[{"Type":"NodeText","Data":"松萝甘苦平无毒，主治头风破瘿瘤，解怒消痰止虚汗，吐疟利水也堪求。"}]},{"ID":"20240612104354-vo6xat0","Type":"NodeParagraph","Properties":{"id":"20240612104354-vo6xat0","updated":"20240612104354"},"Children":[{"Type":"NodeText","Data":"即松树上寄生，五月采阴干。兼治女子阴寒肿痛，令人得眠。"}]},{"ID":"20240612104624-98ywl4b","Type":"NodeThematicBreak","Properties":{"id":"20240612104624-98ywl4b","updated":"20240612104624"}},{"ID":"20240612104624-nq97b9e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104624-nq97b9e","updated":"20240612104624"},"Children":[{"Type":"NodeText","Data":"菘萝《新修本草》"}]},{"ID":"20240612104624-7y8zhmm","Type":"NodeParagraph","Properties":{"id":"20240612104624-7y8zhmm","updated":"20240612104624"},"Children":[{"Type":"NodeText","Data":"味苦、甘，平，无毒。主 怒邪气，止虚汗，出风头，女子阴寒肿痛，疗痰热，温疟，可为吐汤，利水道。一名女萝。生熊耳山川谷松树上。五月采，阴干。"}]},{"ID":"20240612104624-69pl4eo","Type":"NodeParagraph","Properties":{"id":"20240612104624-69pl4eo","updated":"20240612104624"},"Children":[{"Type":"NodeText","Data":"东山甚多，生杂树上，而以松上者为真。《毛诗》云∶茑与女萝，施于松上。茑是寄生，今以桑上者为真，不用松上者，此互有异同耳。"}]},{"ID":"20240612104245-zto56m3","Type":"NodeThematicBreak","Properties":{"id":"20240612104245-zto56m3"}},{"ID":"20240612104246-k41f3wy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104246-k41f3wy","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：松萝"}]},{"ID":"20240612104246-g57qljx","Type":"NodeParagraph","Properties":{"id":"20240612104246-g57qljx","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612104246-5k9q1kj","Type":"NodeParagraph","Properties":{"id":"20240612104246-5k9q1kj","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" Sōnɡ Luó"}]},{"ID":"20240612104246-fzhmzph","Type":"NodeParagraph","Properties":{"id":"20240612104246-fzhmzph","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612104246-zkpv1bs","Type":"NodeParagraph","Properties":{"id":"20240612104246-zkpv1bs","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 树挂、云雾草、海风藤[西北、中南、西南]、金线草、老君须"}]},{"ID":"20240612104246-2itd36i","Type":"NodeParagraph","Properties":{"id":"20240612104246-2itd36i","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612104246-jut1ms0","Type":"NodeParagraph","Properties":{"id":"20240612104246-jut1ms0","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 为松萝科松萝属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"节松萝"},{"Type":"NodeText","Data":"（女萝、接筋草）Usnea diffracta Vain.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长松萝"},{"Type":"NodeText","Data":"（蜈蚣松萝、天蓬草）U. longissima Ach.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地衣体"},{"Type":"NodeText","Data":"（叶状体）入药。全年可采，去杂质，晒干备用。"}]},{"ID":"20240612104246-zprjx5t","Type":"NodeParagraph","Properties":{"id":"20240612104246-zprjx5t","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612104246-gr2o7as","Type":"NodeParagraph","Properties":{"id":"20240612104246-gr2o7as","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 甘，平。有小毒。"}]},{"ID":"20240612104246-0d7igtb","Type":"NodeParagraph","Properties":{"id":"20240612104246-0d7igtb","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612104246-v6hmuj2","Type":"NodeParagraph","Properties":{"id":"20240612104246-v6hmuj2","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 清热解毒，止咳化痰。用于肺结核（多用松萝酸的钠盐），慢性支气管炎；外用治创伤感染，术后刀口感染，化脓性中耳炎，疮疖，淋巴结结核，乳腺炎，烧伤，子宫颈糜烂，阴道滴虫。"}]},{"ID":"20240612104246-06f61ra","Type":"NodeParagraph","Properties":{"id":"20240612104246-06f61ra","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612104246-dwkml57","Type":"NodeParagraph","Properties":{"id":"20240612104246-dwkml57","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 1～3钱；外用适量，研末外敷或煎水洗患处。"}]},{"ID":"20240612104246-6t2nm33","Type":"NodeParagraph","Properties":{"id":"20240612104246-6t2nm33","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612104246-rg72zv3","Type":"NodeParagraph","Properties":{"id":"20240612104246-rg72zv3","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" （1）松萝属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"花松萝"},{"Type":"NodeText","Data":"Usnea florida （L.）Wigg.功效类似。"}]},{"ID":"20240612104246-v5pkpi1","Type":"NodeParagraph","Properties":{"id":"20240612104246-v5pkpi1","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612104246-t5l8kxw","Type":"NodeParagraph","Properties":{"id":"20240612104246-t5l8kxw","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612104246-0zhwayn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104246-0zhwayn","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：松萝"}]},{"ID":"20240612104246-ihtzwxb","Type":"NodeParagraph","Properties":{"id":"20240612104246-ihtzwxb","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612104246-rna7qpp","Type":"NodeParagraph","Properties":{"id":"20240612104246-rna7qpp","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" Sōnɡ Luó"}]},{"ID":"20240612104246-voogv9s","Type":"NodeParagraph","Properties":{"id":"20240612104246-voogv9s","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612104246-d1zescy","Type":"NodeParagraph","Properties":{"id":"20240612104246-d1zescy","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 女萝（《诗经》），松上寄生（《纲目》），松落（《国药的药理学》），树挂（《黑龙江中药》），天棚草、雪风藤、山挂面、龙须草（《四川中药志》），天蓬草（《陕西中草药》）。"}]},{"ID":"20240612104246-zjkxg43","Type":"NodeParagraph","Properties":{"id":"20240612104246-zjkxg43","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612104246-1no7gew","Type":"NodeParagraph","Properties":{"id":"20240612104246-1no7gew","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612104246-bbe7ich","Type":"NodeParagraph","Properties":{"id":"20240612104246-bbe7ich","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612104246-a9b5iki","Type":"NodeParagraph","Properties":{"id":"20240612104246-a9b5iki","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 为松萝科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长松萝、破茎松萝"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"丝状体"},{"Type":"NodeText","Data":"。春、秋采收，晒干。"}]},{"ID":"20240612104246-og3j21k","Type":"NodeParagraph","Properties":{"id":"20240612104246-og3j21k","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612104246-q3y0rbo","Type":"NodeParagraph","Properties":{"id":"20240612104246-q3y0rbo","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 生于阴湿的林中，附生在针叶树上。全国各地均有分布。"}]},{"ID":"20240612104246-nb1lv6v","Type":"NodeParagraph","Properties":{"id":"20240612104246-nb1lv6v","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612104246-uvvljrn","Type":"NodeParagraph","Properties":{"id":"20240612104246-uvvljrn","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" ①长松萝"}]},{"ID":"20240612104246-jqw4sp6","Type":"NodeParagraph","Properties":{"id":"20240612104246-jqw4sp6","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"全体成线状，长可达100厘米左右。基部着生于树皮上，下垂。不分歧，密生细小而短的侧枝，长约1厘米左右。全体灰绿色，外皮部质粗松，中心质坚密。子器稀少，皿状，生于枝的先端。"}]},{"ID":"20240612104246-ilj48fi","Type":"NodeParagraph","Properties":{"id":"20240612104246-ilj48fi","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"②破茎松萝，又名：节松萝、云雾草。"}]},{"ID":"20240612104246-1l8q2hk","Type":"NodeParagraph","Properties":{"id":"20240612104246-1l8q2hk","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"长约30厘米，呈二歧分枝，愈分愈细密，枝表面有明显的环状裂口。"}]},{"ID":"20240612104246-7gfvj4b","Type":"NodeParagraph","Properties":{"id":"20240612104246-7gfvj4b","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612104246-b1d14k0","Type":"NodeParagraph","Properties":{"id":"20240612104246-b1d14k0","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 长松萝和破茎松萝均含巴尔巴地衣酸、松萝酸、地弗地衣酸。长松萝尚含拉马酸、地衣聚糖。破茎松萝尚含不同于巴尔巴地衣酸的另一种酸（3.6％），溶点189～190℃。此外，还含碳水化物。"}]},{"ID":"20240612104246-8rbxt2f","Type":"NodeParagraph","Properties":{"id":"20240612104246-8rbxt2f","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612104246-f6pqxsx","Type":"NodeParagraph","Properties":{"id":"20240612104246-f6pqxsx","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" ①抗菌作用"}]},{"ID":"20240612104246-tddycbz","Type":"NodeParagraph","Properties":{"id":"20240612104246-tddycbz","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"松萝属等许多地衣类都含有抗菌物质，其中松萝酸之抗菌作用尤为突出。其抗菌谱主要为革兰氏阳性细菌及结核杆菌。在试管中松萝酸对肺炎球菌、溶血性链球菌、白喉杆菌、结核杆菌都有很强的抑菌作用，抑菌浓度为1～5微克／毫升，至50微克／毫升可完全抑制细菌的生长。对金黄色葡萄球菌之抑制较上述细菌稍弱，但强于对革兰氏阴性细菌之作用。右旋与左旋型的抗菌作用无大差别。但也有报告对革兰氏阴性的百日咳杆菌、枯草杆菌、肺炎杆菌乃至大肠杆菌、变形杆菌有效者，对痢疾杆菌、伤寒杆菌则无效。在体外试验中，松萝酸对人型结核杆菌有显著的抑制作用，20～50微克／毫升可获得完全抑制，血清略能降低其效力。在体内试验中（对豚鼠的实验性结核的治疗），一般认为口服或腹腔注射有较好的疗效，能限制结核病变的发展；也有人报告单用松萝酸，对豚鼠实验性结核并无影响，但可增强链霉素的作用。在试管中，它与链霉素或异烟肼也有轻度的协同作用。对人的肺、肠结核，每日口服0.1～1.0克松萝酸钠盐或Evosin（一种含松萝酸及缩式橡藓酸的制剂）0.1～0.5克，可使结核病的某些症状如咳嗽、食欲减退、发热或肠结核性腹泻等，获得好转，甚至使结核菌的镜检转阴，但观察尚不够完善，不能下最后结论。上述症状的好转，似乎并非药物对结核菌的直接作用，因口服后，血中达不到抑菌浓度的水平。有人认为，它对人的结核病并无明显疗效。国内用松萝酸治疗肺结核，曾观察到有一定疗效。"}]},{"ID":"20240612104246-8ol4wbx","Type":"NodeParagraph","Properties":{"id":"20240612104246-8ol4wbx","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"对松萝酸的抑菌作用原理，曾进行过不少研究，有人认为它能抑制蛋白质的合成，也有认为它与氧化磷酸化的斥联有关。"}]},{"ID":"20240612104246-wwugha6","Type":"NodeParagraph","Properties":{"id":"20240612104246-wwugha6","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"②对细菌毒素及噬菌体的影响"}]},{"ID":"20240612104246-c651sra","Type":"NodeParagraph","Properties":{"id":"20240612104246-c651sra","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"以0.2～0.4％松萝酸与破伤风毒素或白喉毒素混合或在毒素注射后10分钟内注射，可使小鼠耐受2倍的毒素致死量。对豚鼠接种白喉杆菌后2小时，皮下注射松萝酸2毫克／公斤，或事先将二者混合培养再接种于豚鼠，均有明显的保护作用。小鼠实验性破伤风杆菌感染，以松萝酸与青霉素联合应用的效果最好。用纸碟法证明，d-松萝酸0.5～5毫克／毫升有对抗噬菌体的作用。"}]},{"ID":"20240612104246-se9yv4p","Type":"NodeParagraph","Properties":{"id":"20240612104246-se9yv4p","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"③对其他病原体的作用"}]},{"ID":"20240612104246-abdfb3u","Type":"NodeParagraph","Properties":{"id":"20240612104246-abdfb3u","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"松萝酸对原虫、阴道滴虫也有抑制作用。口服松萝酸钠100～150毫克／公斤对羊的血吸虫、肝片吸虫均有伤害及杀灭作用，肌肉注射可获更好效果；对兔血吸虫，由于其毒性较大，而用其衍生物-松萝酸苯胺，口服200毫克／公斤／天，连服9天，亦获得良好效果。"}]},{"ID":"20240612104246-16b2tx5","Type":"NodeParagraph","Properties":{"id":"20240612104246-16b2tx5","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240612104246-ecdor3c","Type":"NodeParagraph","Properties":{"id":"20240612104246-ecdor3c","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"对部分肝切除的大鼠，喂食松萝酸有促进肝再生的作用。能降低离体大鼠横膈对葡萄糖的利用及其糖元含量。麻醉猫静脉注射松萝酸钠30毫克／公斤，可使血糖升高。d-松萝酸能显著抑制海星受精卵的分裂及磷的摄取，而对氧消耗则几无影响。它还能抑制大鼠腹水瘤细胞的粒线体内α-甘油磷酸新四唑还原酶的活性。d-松萝酸对离体豚鼠、蛙心均有抑制作用；对离体兔耳及蟾蜍下肢灌流，均有扩张血管之作用；对离体兔肠有罂粟碱样作用，麻痹肠管并拮抗氯化钡、乙酰胆碱引起的痉挛；对兔、牛的子宫、支气管及肠管亦有松弛作用。麻醉猫静脉注射10毫克/公斤松萝酸钠，能迅速而显著的增强其呼吸、较长时间的提高通气量、增加氧耗、升高体温，这些都说明代谢增进，有类似二硝基酚的作用，且毒性大于二硝基酚。"}]},{"ID":"20240612104246-m11gvk0","Type":"NodeParagraph","Properties":{"id":"20240612104246-m11gvk0","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612104246-jh3pkrr","Type":"NodeParagraph","Properties":{"id":"20240612104246-jh3pkrr","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 苦甘，平。"}]},{"ID":"20240612104246-q007hh0","Type":"NodeParagraph","Properties":{"id":"20240612104246-q007hh0","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240612104246-mduyjxt","Type":"NodeParagraph","Properties":{"id":"20240612104246-mduyjxt","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，无毒。\""}]},{"ID":"20240612104246-ocmq3c1","Type":"NodeParagraph","Properties":{"id":"20240612104246-ocmq3c1","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"③《陕西中草药》：\"味淡微苦，性凉。\""}]},{"ID":"20240612104246-mf6rq85","Type":"NodeParagraph","Properties":{"id":"20240612104246-mf6rq85","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612104246-rt22ysw","Type":"NodeParagraph","Properties":{"id":"20240612104246-rt22ysw","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 清肝，化痰，止血，解毒。治头痛，目赤，咳嗽痰多，疟疾，瘰疬，白带，崩漏，外伤出血，痈肿，毒蛇咬伤。"}]},{"ID":"20240612104246-ckgy0ex","Type":"NodeParagraph","Properties":{"id":"20240612104246-ckgy0ex","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主嗔怒邪气，止虚汗，头风，女子阴寒肿痛。\""}]},{"ID":"20240612104246-zea0diz","Type":"NodeParagraph","Properties":{"id":"20240612104246-zea0diz","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗痰热温疟，可为吐汤，利水道。\""}]},{"ID":"20240612104246-8t7s7kn","Type":"NodeParagraph","Properties":{"id":"20240612104246-8t7s7kn","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治寒热，吐胸中客痰涎，去头疮，主项上瘤瘿。\""}]},{"ID":"20240612104246-t09fskc","Type":"NodeParagraph","Properties":{"id":"20240612104246-t09fskc","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"令人得眠。\""}]},{"ID":"20240612104246-ywn84f5","Type":"NodeParagraph","Properties":{"id":"20240612104246-ywn84f5","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"⑤《纲目拾遗》：\"治蛇虎伤、汤火烙伤及顽疮等症。\""}]},{"ID":"20240612104246-h474y7m","Type":"NodeParagraph","Properties":{"id":"20240612104246-h474y7m","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"⑥《陕西中草药》：\"止血生肌，止痛，清肝明目，退云翳，降血压，调经。治外伤出血，大便下血，急性结膜炎，角膜云翳，头痛，高血压症，月经不调，崩漏，白带，痈肿，无名肿毒。\""}]},{"ID":"20240612104246-vkh36pn","Type":"NodeParagraph","Properties":{"id":"20240612104246-vkh36pn","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"⑦《西藏常用中草药》：\"清热解毒，止咳化痰。治外伤感染，化脓性感染，毒蛇咬伤，肺结核咳嗽痰多，颈淋巴腺炎，乳腺炎。\""}]},{"ID":"20240612104246-22g5736","Type":"NodeParagraph","Properties":{"id":"20240612104246-22g5736","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612104246-23rdyzl","Type":"NodeParagraph","Properties":{"id":"20240612104246-23rdyzl","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～3钱。外用：煎水洗或研末调敷。"}]},{"ID":"20240612104246-c7uyv59","Type":"NodeParagraph","Properties":{"id":"20240612104246-c7uyv59","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612104246-oftnlkt","Type":"NodeParagraph","Properties":{"id":"20240612104246-oftnlkt","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" ①治角膜云翳：天蓬草五钱。水煎，外洗及内服各半。"}]},{"ID":"20240612104246-saoc9f2","Type":"NodeParagraph","Properties":{"id":"20240612104246-saoc9f2","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"②治刀伤，外伤出血：天蓬草适量。捣烂，敷伤处。"}]},{"ID":"20240612104246-iduynoj","Type":"NodeParagraph","Properties":{"id":"20240612104246-iduynoj","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"③治白带：天蓬草四两。烧灰，甜酒冲服。"}]},{"ID":"20240612104246-ygyxkly","Type":"NodeParagraph","Properties":{"id":"20240612104246-ygyxkly","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"④治痈肿，无名肿毒：天蓬草三钱，楤木根皮五钱，细辛二钱。共研细粉，水或酒调敷。（选方出《陕西中草药》）"}]},{"ID":"20240612104246-hqpyyfu","Type":"NodeParagraph","Properties":{"id":"20240612104246-hqpyyfu","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612104246-niydgko","Type":"NodeParagraph","Properties":{"id":"20240612104246-niydgko","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" ①治疗肺结核"}]},{"ID":"20240612104246-mbt9odc","Type":"NodeParagraph","Properties":{"id":"20240612104246-mbt9odc","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"用松萝（品种未详）中提取的松萝酸钠片剂或粉剂内服，成人每次30毫克，每日3次；或按1.5毫克／公斤／天计算。用药3个月左右，需停药1周，再继续使用。治疗浸润型肺结核30例，24例治愈，平均治愈天数为71.1天；而化疗组的30例中仅17例治愈，平均治愈天数达110.9天。用药过程中约，20％患者有胃部不适，个别发生胃痛；部分患者由于药物不纯、服药时间较长，出现视力不佳反应。上述副作用可用健胃药及鱼肝油解除，不影响继续服药。有两例经检查发现单项转氨酶升高，经停药行保肝治疗15～30天后恢复正常。"}]},{"ID":"20240612104246-i1sm6oc","Type":"NodeParagraph","Properties":{"id":"20240612104246-i1sm6oc","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"②治疗慢性气管炎"}]},{"ID":"20240612104246-wihuwwu","Type":"NodeParagraph","Properties":{"id":"20240612104246-wihuwwu","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"采用松萝煎剂和3种化学提出物片剂，共观察91例，有效率为60％左右，平均生效时间为5～7天。其中以松萝酸粗晶（Ⅰ、Ⅱ号混合物）疗效较好，治疗的56例中，8例显效，26例好转。其主要作用为镇咳祛痰，平喘较差；对单纯型比喘息型或有合并症者疗效为好。制剂及用法：㈠煎剂：松萝1两，加水煎至200毫升，每日2次分服。㈡松萝酸粗晶（Ⅰ、Ⅱ号混合物）：制成片剂，每片30毫克。日服3次，每次1片。㈢松萝酸钠片：每片15毫克。日服3次，每次2片。㈣松萝Ⅲ号提取物：制成片剂，每片50毫克。日服3次，每次2片。上述制剂均以10天为一疗程。副作用：服后有口干、头昏、胃部嘈杂感，停药后能自行消失。毒性试验发现，大剂量松萝酸及其钠盐的毒性主要损害心脏和肝脏，可引起心率减慢，血压下降。"}]},{"ID":"20240612104246-2ddt9h8","Type":"NodeParagraph","Properties":{"id":"20240612104246-2ddt9h8","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612104246-ta91lmr","Type":"NodeParagraph","Properties":{"id":"20240612104246-ta91lmr","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"松萝，能平肝邪，去寒热，同瓜蒂诸药则能吐痰，非松萝能吐人也。\""}]},{"ID":"20240612104246-99572rp","Type":"NodeParagraph","Properties":{"id":"20240612104246-99572rp","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612104246-4s0zw0p","Type":"NodeParagraph","Properties":{"id":"20240612104246-4s0zw0p","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612104246-4ofcg76","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104246-4ofcg76","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"《中华本草》：松萝"}]},{"ID":"20240612104246-t6tfnxp","Type":"NodeParagraph","Properties":{"id":"20240612104246-t6tfnxp","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612104246-42bnd7h","Type":"NodeParagraph","Properties":{"id":"20240612104246-42bnd7h","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" Sōnɡ Luó"}]},{"ID":"20240612104246-05cq36j","Type":"NodeParagraph","Properties":{"id":"20240612104246-05cq36j","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612104246-rdvncbv","Type":"NodeParagraph","Properties":{"id":"20240612104246-rdvncbv","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 女萝、松上寄生、松落、天棚草、雪风藤、山挂面、龙须草、金钱草、关公须、天蓬草、树挂、飞天蜈蚣、松毛、海风藤、石丝线、飞山翅、仙人头发、金丝藤、云雾草、老君须、胡须草、荼须、过山龙、石须"}]},{"ID":"20240612104246-3sixavp","Type":"NodeParagraph","Properties":{"id":"20240612104246-3sixavp","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612104246-66q9j4f","Type":"NodeParagraph","Properties":{"id":"20240612104246-66q9j4f","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》。"}]},{"ID":"20240612104246-va4g9sn","Type":"NodeParagraph","Properties":{"id":"20240612104246-va4g9sn","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：松萝，生熊耳山川谷松树上。五月采，阴干。"}]},{"ID":"20240612104246-rgjvl25","Type":"NodeParagraph","Properties":{"id":"20240612104246-rgjvl25","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：松萝，东山甚多，生杂树上，而以松上者为真。《毛诗传》云，茑与女萝，施于松上。茑是寄生，以桑上者为真，不用松上者，互有异同尔。"}]},{"ID":"20240612104246-dpvb6ww","Type":"NodeParagraph","Properties":{"id":"20240612104246-dpvb6ww","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"3.《本草纲目》：按毛苌《诗》注云，女萝，兔丝也。《吴普本草》兔丝一名松萝。陶弘景谓茑是桑上寄生，松萝是松上寄生。陆佃《埤雅》言茑是松柏上寄生，女萝是松上浮蔓，又言"}]},{"ID":"20240612104246-byuvqkd","Type":"NodeParagraph","Properties":{"id":"20240612104246-byuvqkd","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612104246-9dj7q7v","Type":"NodeParagraph","Properties":{"id":"20240612104246-9dj7q7v","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 药材基源：为松萝平植物长松萝、环裂松萝的地衣体。"}]},{"ID":"20240612104246-uj417ko","Type":"NodeParagraph","Properties":{"id":"20240612104246-uj417ko","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Usnea longissina Ach.2.Usnea diffracta Vain"}]},{"ID":"20240612104246-19ygq7r","Type":"NodeParagraph","Properties":{"id":"20240612104246-19ygq7r","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春、秋采收，洗净，切段，晒干。"}]},{"ID":"20240612104246-1cdifdu","Type":"NodeParagraph","Properties":{"id":"20240612104246-1cdifdu","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612104246-z68ymxn","Type":"NodeParagraph","Properties":{"id":"20240612104246-z68ymxn","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于树干和树枝上。"}]},{"ID":"20240612104246-r5ofi65","Type":"NodeParagraph","Properties":{"id":"20240612104246-r5ofi65","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"2.生于树干上、树干上。"}]},{"ID":"20240612104246-yhjw27z","Type":"NodeParagraph","Properties":{"id":"20240612104246-yhjw27z","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"资源分布：1.分布于黑龙江、吉林、内蒙古、陕西、甘肃、浙江、福建、台湾、四川、云南、西藏等地。"}]},{"ID":"20240612104246-r0jre93","Type":"NodeParagraph","Properties":{"id":"20240612104246-r0jre93","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"2.分布于东北及山西、内蒙古、陕西、甘肃、安徽、浙江、江西、福建、台湾等地。"}]},{"ID":"20240612104246-aacbbrt","Type":"NodeParagraph","Properties":{"id":"20240612104246-aacbbrt","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612104246-7a1o35p","Type":"NodeParagraph","Properties":{"id":"20240612104246-7a1o35p","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 1.表面灰绿色、草绿色、老枝灰草黄色。主枝具有皮层，二级分枝缺乏皮层。"}]},{"ID":"20240612104246-fdd4f8z","Type":"NodeParagraph","Properties":{"id":"20240612104246-fdd4f8z","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"2.淡绿色至淡黄绿色。枝体基部直径约3mm，主枝粗3-4mm，次生分枝整齐或不整齐多回二叉分枝，枝圆柱形，少数末端稍扁平或棱角。枝干具环状裂隙，如脊椎状。"}]},{"ID":"20240612104246-3disffk","Type":"NodeParagraph","Properties":{"id":"20240612104246-3disffk","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612104246-8en37mt","Type":"NodeParagraph","Properties":{"id":"20240612104246-8en37mt","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （1）地衣体丝状，柔软，浅黄绿色。主枝短，具皮层，有环裂；次生分枝极长，无皮层，有稠密的小纤毛，表面常有颗粒状小疣。"}]},{"ID":"20240612104246-dgi9wc4","Type":"NodeParagraph","Properties":{"id":"20240612104246-dgi9wc4","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"（2）地衣体丝状，较粗壮，淡灰绿色或淡黄棕色。枝体表面有多数环状裂沟。横断面可见中央有线状强韧性的中轴，具弹性，由菌丝组成；其外为藻环，常由环状沟纹分离成短筒状。"}]},{"ID":"20240612104246-517r5mv","Type":"NodeParagraph","Properties":{"id":"20240612104246-517r5mv","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612104246-28yoelo","Type":"NodeParagraph","Properties":{"id":"20240612104246-28yoelo","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 长松萝的地衣丝状体含巴尔巴地衣酸（bar-batic acid）,松萝酸（usnic acid）,地弗地衣酸（diffractaic acid）,拉马酸（ramalic acid）,地衣聚糖（lichenin）,长松萝多糖，扁枝衣酸乙酯（ethyl everninate）.环裂松萝的地衣丝状体含巴尔巴地衣酸，松萝酸，地弗地衣酸。"}]},{"ID":"20240612104246-ol3k0zd","Type":"NodeParagraph","Properties":{"id":"20240612104246-ol3k0zd","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612104246-ub5l9f8","Type":"NodeParagraph","Properties":{"id":"20240612104246-ub5l9f8","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 1.抗菌作用 松萝属等许多地衣类都含有抗菌物质，其中松萝酸之抗菌作用尤为突出。其抗菌谱主要为革兰氏阳性细菌及结核杆菌。在试管中松萝酸对肺炎球菌、溶血性链球菌、白喉杆菌、结核杆菌都有很强的抑菌作用，抑菌浓度为1-5μg、ml，至50μg／ml可完全抑制细菌的生长。对金黄色葡萄球菌之抑制较上述细菌稍弱，但强于对革兰氏阴性细菌之作用。右旋与左旋型的抗菌作用无大差别。但也有报告对革兰氏阴性的百日咳杆菌、枯草杆菌、肺炎杆菌乃至大肠杆菌、变形杆菌有效者，对痢疾杆菌、伤寒杆菌则无效。在体外试验中，松萝酸对人型结核杆菌有显着的抑制作用，20-50μg/ml可获得完全抑制，血清略能降低其效力。在体内试验中(对豚鼠的实验性结核的治疗)，一般认为口服或腹腔注射有较好的疗效，能限制结核病变的发展；也有人报告单用松萝酸，对豚鼠实验性结核并无影响，但可增强链霉素的作用。在试管中，它与链霉素或异烟肼也有轻度的协同作用。对人的肺、肠结核，每日口服0.1-1.0g松萝酸钠盐或Evosin(一种含松萝酸及缩式橡藓酸的制剂)0.1-0.5g，可使结核病的某些症状如咳嗽、食欲减退、发热或肠结核性腹泻等，获得好转，甚至使结核菌的镜检转阴，但观察尚不够完善，不能下最后结论。上述症状的好转，似乎并非药物对结核菌的直接作用，因口服后，血中达不到抑菌浓度的水平。有人认为，它对人的结核病并无明显疗效。国内用松萝酸治疗肺结核，曾观察到有一定疗效。对松萝酸的抑菌作用原理，曾进行过不少研究，有人认为它能抑制蛋白质的合成，也有认为它与氧化磷酸化的斥联有关。"}]},{"ID":"20240612104246-l3ymeul","Type":"NodeParagraph","Properties":{"id":"20240612104246-l3ymeul","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"2.对细菌毒素及噬菌体的影响 以0.2-0.4%松萝酸与破伤风毒素或白喉毒素混合或在毒素注射后10分钟内注射，可使小鼠耐受2倍的毒素致死量。对豚鼠接种白喉秆菌后2小时，皮下注射松萝酸2mg/kg，或事先将二者混合培养再接种于豚鼠，均有明显的保护作用。小鼠实验性破伤风杆菌感染，以松萝酸与青霉素联合应用的效果最好。用纸碟法证明，d-松萝酸0.5-5mg/ml有对抗噬菌体的作用。"}]},{"ID":"20240612104246-1fcmzd8","Type":"NodeParagraph","Properties":{"id":"20240612104246-1fcmzd8","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"3.对其他病原体的作用 松萝酸对原虫、阴道滴虫也有抑制作用。口服松萝酸钠100-150mg／kg对羊的血吸虫、肝片吸虫均有伤害及杀灭作用，肌肉注射可获更好效果；对兔血吸虫，由于其毒性较大，而用其衍生物——松萝酸苯胺，口服200mg／kg/天，连服9天，亦获得良好效果。"}]},{"ID":"20240612104246-ovv9b62","Type":"NodeParagraph","Properties":{"id":"20240612104246-ovv9b62","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"4.其他作用 对部分肝切除的大鼠，喂食松萝酸有促进肝再生的作用。能降低离体大鼠横膈对葡萄糖的利用及其糖元含量。麻醉猫静脉注射松萝酸钠30mg/kg，可使血糖升高。D-松萝酸能显着抑制海星(Ar-bacia)受精卵的分裂及磷的摄取，而对氧消耗则几无影响。它还能抑制大鼠腹水瘤细胞(AH13AH7974)的粒线体内α-甘油磷酸新四唑还原酶的活性。D-松萝酸对离体豚鼠、蛙心均有抑制作用；对离体兔耳及蟾蜍下肢灌流，均有扩张血管之作用；对离体兔肠有罂粟碱样作用，麻痹肠管并拮抗氯化钡、乙酰胆碱引起的痉挛；对兔、牛的子宫、支气管及肠管亦有松弛作用。麻醉猫静脉注射10mg/kg松萝酸钠，能迅速而显着的增强其呼吸、较长时间的提高通气量、增加氧耗、升高体温，这些都说明代谢增进，有类似二硝基酚的作用，且毒性大于二硝基酚。"}]},{"ID":"20240612104246-0yup7h3","Type":"NodeParagraph","Properties":{"id":"20240612104246-0yup7h3","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612104246-85a4uu1","Type":"NodeParagraph","Properties":{"id":"20240612104246-85a4uu1","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 心；肾；肺经"}]},{"ID":"20240612104246-n6n4547","Type":"NodeParagraph","Properties":{"id":"20240612104246-n6n4547","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612104246-xbjewzp","Type":"NodeParagraph","Properties":{"id":"20240612104246-xbjewzp","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 甘；苦；性平；"}]},{"ID":"20240612104246-eohj8m7","Type":"NodeParagraph","Properties":{"id":"20240612104246-eohj8m7","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612104246-qkexq6v","Type":"NodeParagraph","Properties":{"id":"20240612104246-qkexq6v","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 祛痰止咳；清热解毒；除湿通络；止血调经；驱虫。。主痰热温疟；咳喘；肺痨；头痛；目赤云翳，痈肿疮毒；瘰疠；乳痈；烫火伤；毒蛇咬伤，风温痹痛，跌打损伤，骨折；外伤出血，吐血；便血；崩漏，月经不调；白带；蛔虫病；血吸虫病。"}]},{"ID":"20240612104246-xi8rnhj","Type":"NodeParagraph","Properties":{"id":"20240612104246-xi8rnhj","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612104246-9vcevl7","Type":"NodeParagraph","Properties":{"id":"20240612104246-9vcevl7","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-9g。外用：适量，煎汤洗；或研末调敷。"}]},{"ID":"20240612104246-lhfb8xb","Type":"NodeParagraph","Properties":{"id":"20240612104246-lhfb8xb","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612104246-6ulk7xe","Type":"NodeParagraph","Properties":{"id":"20240612104246-6ulk7xe","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 《本草纲目》：松萝，能平肝邪，去寒热，同瓜蒂诸药则能吐痰，非松萝能吐人也。1.《神农本草经》：主瞋怒邪气，止虚汗，头风，女子阴寒肿痛。"}]},{"ID":"20240612104246-3zu5zva","Type":"NodeParagraph","Properties":{"id":"20240612104246-3zu5zva","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：疗痰热温疟，可为吐汤，利水道。"}]},{"ID":"20240612104246-0nutlj7","Type":"NodeParagraph","Properties":{"id":"20240612104246-0nutlj7","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：治寒热，吐胸中客痰涎，去头疮，主项上瘤瘿。"}]},{"ID":"20240612104246-ipblk8w","Type":"NodeParagraph","Properties":{"id":"20240612104246-ipblk8w","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：令人得眠。"}]},{"ID":"20240612104246-c7g4057","Type":"NodeParagraph","Properties":{"id":"20240612104246-c7g4057","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"5.《本草纲目拾遗》：治蛇虎伤、汤火烙伤及顽疮等症。"}]},{"ID":"20240612104246-eif7064","Type":"NodeParagraph","Properties":{"id":"20240612104246-eif7064","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"6.《陕西中草药》：止血生肌，止痛，清肝明目，退云翳，降血压，调经。治外伤出血，大便下血，急性结膜炎，角膜云翳，头痛，高血压症，月经不调，崩漏，白带，痈肿，无名肿毒。"}]},{"ID":"20240612104246-83i4q82","Type":"NodeParagraph","Properties":{"id":"20240612104246-83i4q82","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"7.《西藏常用中草药》：清热解毒，止咳化痰。治外伤感染，化脓性感染，毒蛇咬伤，肺结核咳嗽痰多，颈淋巴腺炎，乳腺炎。"}]},{"ID":"20240612104246-95iaaff","Type":"NodeParagraph","Properties":{"id":"20240612104246-95iaaff","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612104246-enwxfzs","Type":"NodeParagraph","Properties":{"id":"20240612104246-enwxfzs","updated":"20240612104246"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612104248-yroawjv","Type":"NodeThematicBreak","Properties":{"id":"20240612104248-yroawjv"}},{"ID":"20240612104249-419khhb","Type":"NodeParagraph","Properties":{"id":"20240612104249-419khhb"}}]}