}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 651px;","style":"width: 641px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"卫矛2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/卫矛2-20240626152314-vzklth0.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 641px;\" parent-style=\"width: 651px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821134433-zo3o0jn","Type":"NodeParagraph","Properties":{"id":"20240821134433-zo3o0jn","updated":"20240821135415"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 677px;","style":"width: 667px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"卫矛 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/卫矛 2-20240821135402-e2bguzh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 667px;\" parent-style=\"width: 677px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 510px;","style":"width: 500px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鬼箭羽7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鬼箭羽7-20240626153905-5o9syc7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 500px;\" parent-style=\"width: 510px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626152701-bc0l3hn","Type":"NodeParagraph","Properties":{"id":"20240626152701-bc0l3hn","updated":"20240626153326"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鬼箭羽"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鬼箭羽-20240626152657-ih5uyeo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 608px;","style":"width: 598px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626152933-aq6ft35.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 598px;\" parent-style=\"width: 608px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821135524-pzkdh76","Type":"NodeParagraph","Properties":{"id":"20240821135524-pzkdh76","updated":"20240821135816"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 562px;","style":"width: 552px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"卫矛 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/卫矛 3-20240821135524-t3ssmaw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 552px;\" parent-style=\"width: 562px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 628px;","style":"width: 618px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"卫矛 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/卫矛 4-20240821135816-f0vhbma.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 618px;\" parent-style=\"width: 628px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717192116-a7etkdg","Type":"NodeParagraph","Properties":{"id":"20240717192116-a7etkdg","updated":"20240821135554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1000px;","style":"width: 990px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鬼箭羽"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鬼箭羽-20240717192013-2hraqhe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 990px;\" parent-style=\"width: 1000px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821135532-4jszmty","Type":"NodeParagraph","Properties":{"id":"20240821135532-4jszmty","updated":"20240821135539"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图未按品种分类；"}]},{"ID":"20240612105105-8i9t8qq","Type":"NodeThematicBreak","Properties":{"id":"20240612105105-8i9t8qq"}},{"ID":"20240612105109-xulwkjv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105109-xulwkjv","updated":"20240612105115"},"Children":[{"Type":"NodeText","Data":"卫矛《神农本草经》"}]},{"ID":"20240612105109-wapthd1","Type":"NodeParagraph","Properties":{"id":"20240612105109-wapthd1","updated":"20240612105109"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240612105109-pcqpifv","Type":"NodeParagraph","Properties":{"id":"20240612105109-pcqpifv","updated":"20240612105109"},"Children":[{"Type":"NodeText","Data":"主女子崩中下血，腹满汗出，除邪，杀鬼毒虫注。一名鬼箭。生山谷。"}]},{"ID":"20240612105109-lk0bmil","Type":"NodeParagraph","Properties":{"id":"20240612105109-lk0bmil","updated":"20240612105109"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：鬼箭一名卫矛，神农黄帝桐君苦无毒，叶如桃如羽，正月二月七月采，阴干，或生野田（《御览》）。"}]},{"ID":"20240612105109-iorxz98","Type":"NodeParagraph","Properties":{"id":"20240612105109-iorxz98","updated":"20240612105109"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生霍山，八月采，阴干。"}]},{"ID":"20240612105109-loqjxdw","Type":"NodeParagraph","Properties":{"id":"20240612105109-loqjxdw","updated":"20240612105109"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：鬼箭，神箭也。陶宏景云：其茎有三羽，状如箭羽。"}]},{"ID":"20240612105158-t5ep4f5","Type":"NodeThematicBreak","Properties":{"id":"20240612105158-t5ep4f5"}},{"ID":"20240612105159-af7ysjr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105159-af7ysjr","updated":"20240612105159"},"Children":[{"Type":"NodeText","Data":"卫矛"}]},{"ID":"20240612105159-nu5fmmg","Type":"NodeParagraph","Properties":{"id":"20240612105159-nu5fmmg","updated":"20240612105159"},"Children":[{"Type":"NodeText","Data":"所在山谷皆有之，然未尝于平陆地见也。叶绝少，其茎黄褐色，若柏皮，三面如锋刃，人家多燔之遣祟。方家用之亦少。"}]},{"ID":"20240612105146-wuva903","Type":"NodeThematicBreak","Properties":{"id":"20240612105146-wuva903"}},{"ID":"20240612105147-qy2ync0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105147-qy2ync0","updated":"20240612105150"},"Children":[{"Type":"NodeText","Data":"卫矛《本草思辨录》"}]},{"ID":"20240612105147-bfdrv8g","Type":"NodeParagraph","Properties":{"id":"20240612105147-bfdrv8g","updated":"20240612105147"},"Children":[{"Type":"NodeText","Data":"卫矛以甄权破陈血落胎，与日华子通月经破症结两说按之，自属善败恶血，故和剂局方用以治产后败血。但其三面如箭羽，古惟燔之以遣祟，方药少用。则用之于除邪杀鬼，乃为合宜。考千金外台诸方，疗恶疰心痛，卒暴心痛，忽中恶气毒痛，鬼疟日发，及务成子萤火丸，非善取其长者欤。"}]},{"ID":"20240612105137-1jwa505","Type":"NodeThematicBreak","Properties":{"id":"20240612105137-1jwa505"}},{"ID":"20240612105138-xsr91mq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105138-xsr91mq","updated":"20240612105142"},"Children":[{"Type":"NodeText","Data":"卫矛《千金翼方》"}]},{"ID":"20240612105138-sv83pii","Type":"NodeParagraph","Properties":{"id":"20240612105138-sv83pii","updated":"20240612105138"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主女子崩中下血，腹满汗出，除邪，杀鬼毒蛊疰，中恶腹痛，去白虫，消皮肤风毒肿，令阴中解。一名鬼箭。生霍山山谷，八月采，阴干。"}]},{"ID":"20240612105128-j6j98k2","Type":"NodeThematicBreak","Properties":{"id":"20240612105128-j6j98k2"}},{"ID":"20240612105129-70qvxlb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105129-70qvxlb","updated":"20240612105133"},"Children":[{"Type":"NodeText","Data":"卫矛《本经逢原》"}]},{"ID":"20240612105129-dnkm1c2","Type":"NodeParagraph","Properties":{"id":"20240612105129-dnkm1c2","updated":"20240612105129"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即鬼箭羽"}]},{"ID":"20240612105129-8y0f3md","Type":"NodeParagraph","Properties":{"id":"20240612105129-8y0f3md","updated":"20240612105129"},"Children":[{"Type":"NodeText","Data":"苦寒无毒。生山石间，小株成丛，叶似野茶，三四月生小黄绿花。实如冬青子，条上有羽如箭，视之若三羽，故名。"}]},{"ID":"20240612105129-65u3roz","Type":"NodeParagraph","Properties":{"id":"20240612105129-65u3roz","updated":"20240612105129"},"Children":[{"Type":"NodeText","Data":"《本经》主女子崩中下血，腹满汗出，除邪杀鬼毒蛊疰。"}]},{"ID":"20240612105129-0h1t8vw","Type":"NodeParagraph","Properties":{"id":"20240612105129-0h1t8vw","updated":"20240612105129"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"鬼箭专散恶血，故《本经》有崩中下血之治。《别录》治中恶腹痛，去白虫，消皮肤风毒肿，即腹满汗出，除邪杀鬼毒蛊疰之治。今人治贼风历节诸痹，妇人产后血晕血结聚于胸中，或偏于胁肋少腹者，四物倍归加鬼箭羽、红花、玄胡索煎服，以其性专破血。力能堕胎，妊娠禁用。"}]},{"ID":"20240612105119-46lk3tc","Type":"NodeThematicBreak","Properties":{"id":"20240612105119-46lk3tc"}},{"ID":"20240612105120-d9kclv8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105120-d9kclv8","updated":"20240612105124"},"Children":[{"Type":"NodeText","Data":"卫矛《本草蒙筌》"}]},{"ID":"20240612105120-0y8y0s7","Type":"NodeParagraph","Properties":{"id":"20240612105120-0y8y0s7","updated":"20240612105120"},"Children":[{"Type":"NodeText","Data":"（一名鬼箭羽） 味苦，气寒。无毒。深山谷多产，平陆地绝无。茎类柏皮褐黄，叶似山茶青绿。干有三羽，状似箭翎。削取皮羽阴干，拭净赤毛酥炙。（一说只使箭头，每两用酥一分，缓炒酥尽为度。）任煎汤液，专治女科。能堕妊娠，善疗血气。遣邪祟，杀蛊毒，破症结，通月经。腹满汗出立瘳，崩中下漏即止。消皮肤风肿，去腹脏白虫。产后血绞痛殊功，恶疰卒暴心痛捷效。"}]},{"ID":"20240612105212-qj7sior","Type":"NodeThematicBreak","Properties":{"id":"20240612105212-qj7sior"}},{"ID":"20240612105213-9b67kzo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105213-9b67kzo","updated":"20240612105218"},"Children":[{"Type":"NodeText","Data":"卫矛《本草备要》"}]},{"ID":"20240612105213-4yh55la","Type":"NodeParagraph","Properties":{"id":"20240612105213-4yh55la","updated":"20240612105213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"一名鬼箭羽"}]},{"ID":"20240612105213-ac0duk6","Type":"NodeParagraph","Properties":{"id":"20240612105213-ac0duk6","updated":"20240612105213"},"Children":[{"Type":"NodeText","Data":"泻，破血苦寒（时珍曰∶酸涩）。破陈血，通经落胎，杀虫祛祟。干有三羽，叶似野茶。酥炙用。"}]},{"ID":"20240612105233-0c4b37x","Type":"NodeThematicBreak","Properties":{"id":"20240612105233-0c4b37x"}},{"ID":"20240612105234-n9jcec5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105234-n9jcec5","updated":"20240612105239"},"Children":[{"Type":"NodeText","Data":"卫矛《得配本草》"}]},{"ID":"20240612105234-x9pdw9q","Type":"NodeParagraph","Properties":{"id":"20240612105234-x9pdw9q","updated":"20240612105234"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即鬼箭羽"}]},{"ID":"20240612105234-r4dht9q","Type":"NodeParagraph","Properties":{"id":"20240612105234-r4dht9q","updated":"20240612105234"},"Children":[{"Type":"NodeText","Data":"苦，寒。破血杀虫。去蛊疰，消风毒之肤肿。得归尾、延胡，治儿枕硬痛。配穿山甲，治疟日发。去赤毛，酥炙。"}]},{"ID":"20240612105243-jmgmq3o","Type":"NodeThematicBreak","Properties":{"id":"20240612105243-jmgmq3o"}},{"ID":"20240612105245-u4evee5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105245-u4evee5","updated":"20240612105248"},"Children":[{"Type":"NodeText","Data":"卫矛《新修本草》"}]},{"ID":"20240612105245-0jn8cls","Type":"NodeParagraph","Properties":{"id":"20240612105245-0jn8cls","updated":"20240612105245"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主女子崩中，下血，腹满，汗出，除邪，杀鬼毒蛊疰，中恶，腹痛，去白虫，消皮肤风毒肿，令阴中解。一名鬼箭。生霍山山谷。八月采，阴干。"}]},{"ID":"20240612105245-umvsmxb","Type":"NodeParagraph","Properties":{"id":"20240612105245-umvsmxb","updated":"20240612105245"},"Children":[{"Type":"NodeText","Data":"山野处处有。其茎有三羽，状如箭羽，俗皆呼为鬼箭。而为用甚希，用之削取皮及羽也。"}]},{"ID":"20240612105223-hx4re7s","Type":"NodeThematicBreak","Properties":{"id":"20240612105223-hx4re7s"}},{"ID":"20240612105224-s4rbh6r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105224-s4rbh6r","updated":"20240612105227"},"Children":[{"Type":"NodeText","Data":"卫矛《冯氏锦囊秘录》"}]},{"ID":"20240612105224-ecben3h","Type":"NodeParagraph","Properties":{"id":"20240612105224-ecben3h","updated":"20240612105224"},"Children":[{"Type":"NodeText","Data":"卫矛，一名鬼箭羽，任煎汤液，专治女科，能堕妊娠，善疗血气，遣邪祟，杀虫毒，破 结，通月经，腹满汗出立瘳，崩中下漏即止，消皮肤风肿，去腹脏白虫，产后血绞肚痛殊功，恶疰卒暴心痛捷效。"}]},{"ID":"20240612104921-k4hgjsd","Type":"NodeThematicBreak","Properties":{"id":"20240612104921-k4hgjsd"}},{"ID":"20240612105054-u0u9k4u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105054-u0u9k4u","updated":"20240612105103"},"Children":[{"Type":"NodeText","Data":"卫矛《证类本草》"}]},{"ID":"20240612105054-zxg86ec","Type":"NodeParagraph","Properties":{"id":"20240612105054-zxg86ec","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主女子崩中下血，腹满汗出，除邪，杀鬼毒蛊疰，中恶腹痛，去白虫，消皮肤风毒肿，令阴中解。一名鬼箭。生霍山山谷。八月采，阴干。"}]},{"ID":"20240612105054-r29slxi","Type":"NodeParagraph","Properties":{"id":"20240612105054-r29slxi","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶山野处处有。其茎有三羽，状如箭羽，俗皆呼为鬼箭。而为用甚稀，用之削取皮羽。今注医家用鬼箭，疗妇人血气，大效。臣禹锡等谨按药性论云∶鬼箭，使，一名卫矛，有小毒。能破陈血，能落胎，主中恶腰腹痛及百邪鬼魅。日华子云∶鬼箭羽，味甘、涩。"}]},{"ID":"20240612105054-m62us1b","Type":"NodeParagraph","Properties":{"id":"20240612105054-m62us1b","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"通月经，破症结，止血崩带下，杀腹脏虫及产后血咬肚痛。"}]},{"ID":"20240612105054-xvdj025","Type":"NodeParagraph","Properties":{"id":"20240612105054-xvdj025","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"图经曰∶卫矛，鬼箭也。出霍山山谷，今江淮州郡或有之。三月以后生茎，苗长四、五尺许。其干有三羽，状如箭翎。叶亦似山茶，青色。八月、十一月、十二月采条茎，阴干。"}]},{"ID":"20240612105054-6dz8wu8","Type":"NodeParagraph","Properties":{"id":"20240612105054-6dz8wu8","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"其木亦名狗骨。《崔氏方》疗恶疰在心，痛不可忍，有鬼箭羽汤。《集验方》疗卒暴心痛，或中恶气毒痛，大黄汤亦用鬼箭，皆大方∶也。"}]},{"ID":"20240612105054-cicxkff","Type":"NodeParagraph","Properties":{"id":"20240612105054-cicxkff","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，勿用石茆，根头真似鬼箭，只是上叶不同，味各别。采得后只使箭头用，拭上赤毛，用酥缓炒过用之。每修事一两，用酥一分，炒酥尽为度。外台秘要∶治乳无汁。"}]},{"ID":"20240612105054-um7hpix","Type":"NodeParagraph","Properties":{"id":"20240612105054-um7hpix","updated":"20240612105054"},"Children":[{"Type":"NodeText","Data":"鬼箭五两，水六升，煮取四升。一服八合，日三，亦可作灰水服方寸匕，日三，大效。"}]},{"ID":"20240612105054-i1um6kb","Type":"NodeParagraph","Properties":{"id":"20240612105054-i1um6kb","updated":"20240612105206"},"Children":[{"Type":"NodeText","Data":"衍义曰∶卫矛，所在山谷皆有之，然未尝于平陆地见也，叶绝少，其茎黄褐色，若柏皮，三面如锋刃，人家多燔之遣祟。方家用之亦少。"}]},{"ID":"20240612104921-01nbt1l","Type":"NodeThematicBreak","Properties":{"id":"20240612104921-01nbt1l"}},{"ID":"20240612105025-6fpom60","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105025-6fpom60","updated":"20240612105031"},"Children":[{"Type":"NodeText","Data":"卫矛《医学入门》"}]},{"ID":"20240612105025-o4xzsmq","Type":"NodeParagraph","Properties":{"id":"20240612105025-o4xzsmq","updated":"20240612105025"},"Children":[{"Type":"NodeText","Data":"卫矛气寒苦且涩，通经止崩下乳汁，破 结除心腹疼，杀虫祛风邪难入。"}]},{"ID":"20240612105025-wkwywkz","Type":"NodeParagraph","Properties":{"id":"20240612105025-wkwywkz","updated":"20240612105025"},"Children":[{"Type":"NodeText","Data":"在处有之。茎长四五尺许，其干上三面如锋刃箭羽，故又名鬼箭羽，人家多蟠之以卫祟。无毒。主通月经，止血崩带下，能堕胎，下乳汁及产后血绞腹痛，破陈血 结、蛊疰中恶，腰腹心胸胀满，去白虫，消皮肤风毒，令阴中解，杀百邪鬼魅。八月采，阴干，只用箭头，拭去赤毛，酥炒用。"}]},{"ID":"20240612104952-ryaxjyk","Type":"NodeThematicBreak","Properties":{"id":"20240612104952-ryaxjyk"}},{"ID":"20240612104953-vyze46s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104953-vyze46s","updated":"20240612104957"},"Children":[{"Type":"NodeText","Data":"卫矛《本草纲目》"}]},{"ID":"20240612104953-ixvzdls","Type":"NodeParagraph","Properties":{"id":"20240612104953-ixvzdls","updated":"20240612104953"},"Children":[{"Type":"NodeText","Data":"「释名」鬼箭、神箭。"}]},{"ID":"20240612104953-ixs6yew","Type":"NodeParagraph","Properties":{"id":"20240612104953-ixs6yew","updated":"20240612104953"},"Children":[{"Type":"NodeText","Data":"「气味」苦、寒、无毒。"}]},{"ID":"20240612104953-xsriosg","Type":"NodeParagraph","Properties":{"id":"20240612104953-xsriosg","updated":"20240612104953"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612104953-hvh1c70","Type":"NodeParagraph","Properties":{"id":"20240612104953-hvh1c70","updated":"20240612104953"},"Children":[{"Type":"NodeText","Data":"1、产后败血（脐腹坚胀，恶露不快）。用当归（炒）、卫矛（去中心木）、红蓝花各一两。每服三钱，以酒一大碗，煎至七成，饭前温服。"}]},{"ID":"20240612104953-oi1f1k5","Type":"NodeParagraph","Properties":{"id":"20240612104953-oi1f1k5","updated":"20240612104953"},"Children":[{"Type":"NodeText","Data":"2、疟疾。用卫矛、鲮鲤甲（煤灰）各二钱半，共研为末。每取二、三分，病发时鼻中。又方：用卫矛末一分，砒霜一钱、五灵脂一两，共研为末。病发时冷水冲服一钱。"}]},{"ID":"20240612104921-jy3i8zd","Type":"NodeThematicBreak","Properties":{"id":"20240612104921-jy3i8zd"}},{"ID":"20240612104942-66sr5um","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104942-66sr5um","updated":"20240612104947"},"Children":[{"Type":"NodeText","Data":"卫矛《本草经集注》"}]},{"ID":"20240612104942-kuuuqeq","Type":"NodeParagraph","Properties":{"id":"20240612104942-kuuuqeq","updated":"20240612104942"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。主治女子崩中，下血，腹满，汗出，除邪，杀鬼毒蛊疰，中恶，腹痛，去白虫，消皮肤风毒肿，令阴中解。一名鬼箭。生霍山山谷。八月采，阴干。"}]},{"ID":"20240612104942-48fjamg","Type":"NodeParagraph","Properties":{"id":"20240612104942-48fjamg","updated":"20240612104942"},"Children":[{"Type":"NodeText","Data":"山野处处有。其茎有三羽，状如箭羽，世皆呼为鬼箭。而为用甚稀，用之削取皮及羽也。"}]},{"ID":"20240612104922-1rleodn","Type":"NodeThematicBreak","Properties":{"id":"20240612104922-1rleodn"}},{"ID":"20240612104923-xyy8i7o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612104923-xyy8i7o","updated":"20240612104929"},"Children":[{"Type":"NodeText","Data":"卫矛《名医别录》"}]},{"ID":"20240612104923-e4dou2a","Type":"NodeParagraph","Properties":{"id":"20240612104923-e4dou2a","updated":"20240612104935"},"Children":[{"Type":"NodeText","Data":"无毒．主治中恶，腹痛，去白虫，消皮肤风毒肿，令阴中解．生霍山．八月采，阴干。"}]},{"ID":"20240612104923-5x5f11h","Type":"NodeParagraph","Properties":{"id":"20240612104923-5x5f11h","updated":"20240612104923"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶卫矛，味苦，寒．主女子崩中下血，腹满汗出，除邪，杀鬼毒蛊注．一名鬼箭．生山谷．"}]},{"ID":"20240612105014-uctbq73","Type":"NodeThematicBreak","Properties":{"id":"20240612105014-uctbq73","updated":"20240612105014"}},{"ID":"20240612105014-pxc88g5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612105014-pxc88g5","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"卫矛"}]},{"ID":"20240612105014-v2rxbm5","Type":"NodeParagraph","Properties":{"id":"20240612105014-v2rxbm5","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612105014-rahf54e","Type":"NodeParagraph","Properties":{"id":"20240612105014-rahf54e","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" Wèi Máo"}]},{"ID":"20240612105014-4kbvy36","Type":"NodeParagraph","Properties":{"id":"20240612105014-4kbvy36","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612105014-q2bw16e","Type":"NodeParagraph","Properties":{"id":"20240612105014-q2bw16e","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" 鬼箭羽、麻药[广东]、八树[陕西]、篦梳风[湖南]"}]},{"ID":"20240612105014-r3f51nq","Type":"NodeParagraph","Properties":{"id":"20240612105014-r3f51nq","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612105014-f6j0h4q","Type":"NodeParagraph","Properties":{"id":"20240612105014-f6j0h4q","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" 卫矛科卫矛属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"卫矛"},{"Type":"NodeText","Data":"Euonymus alatus （Thunb.） Sieb.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带翅的枝"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"入药。全年采根，夏秋采带翅的枝及叶，晒干。"}]},{"ID":"20240612105014-4w1qm78","Type":"NodeParagraph","Properties":{"id":"20240612105014-4w1qm78","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612105014-yqacnhv","Type":"NodeParagraph","Properties":{"id":"20240612105014-yqacnhv","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612105014-vabnav9","Type":"NodeParagraph","Properties":{"id":"20240612105014-vabnav9","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612105014-mug5liw","Type":"NodeParagraph","Properties":{"id":"20240612105014-mug5liw","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" 行血通经，散瘀止痛。用于月经不调，产后淤血腹痛，跌打损伤肿痛。"}]},{"ID":"20240612105014-kx90qxg","Type":"NodeParagraph","Properties":{"id":"20240612105014-kx90qxg","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612105014-lasgsf8","Type":"NodeParagraph","Properties":{"id":"20240612105014-lasgsf8","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" 1～3钱。"}]},{"ID":"20240612105014-vx329ur","Type":"NodeParagraph","Properties":{"id":"20240612105014-vx329ur","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612105014-63iawaz","Type":"NodeParagraph","Properties":{"id":"20240612105014-63iawaz","updated":"20240612105014"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612105021-jht84nx","Type":"NodeThematicBreak","Properties":{"id":"20240612105021-jht84nx"}},{"ID":"20240612105022-as544yf","Type":"NodeParagraph","Properties":{"id":"20240612105022-as544yf"}}]}