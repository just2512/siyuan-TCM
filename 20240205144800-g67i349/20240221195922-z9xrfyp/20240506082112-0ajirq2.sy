ted":"20240821125105"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"酸枣 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/酸枣 2-20240809094508-lqxk25m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"酸枣 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/酸枣 3-20240809094526-hgnl1pm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612103612-sbt1iom","Type":"NodeParagraph","Properties":{"id":"20240612103612-sbt1iom","updated":"20240821125045"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：取图为酸枣刺，该篇存疑；"}]},{"ID":"20240612103612-6ot495y","Type":"NodeThematicBreak","Properties":{"id":"20240612103612-6ot495y"}},{"ID":"20240612103613-ta1p4um","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103613-ta1p4um","updated":"20240612103617"},"Children":[{"Type":"NodeText","Data":"白棘《本草经集注》"}]},{"ID":"20240612103613-0cb0u1d","Type":"NodeParagraph","Properties":{"id":"20240612103613-0cb0u1d","updated":"20240612103613"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主治心腹痛，痈肿，溃脓，止痛。决刺结，治丈夫虚损，阴痿，精自出，补肾气，益精髓。一名棘针，一名棘刺。生雍州川谷。"}]},{"ID":"20240612103613-eqoyy4t","Type":"NodeParagraph","Properties":{"id":"20240612103613-eqoyy4t","updated":"20240612103613"},"Children":[{"Type":"NodeText","Data":"李云此是酸枣树针，今人用天门冬苗代之，非真也。"}]},{"ID":"20240612103558-jcszo2y","Type":"NodeThematicBreak","Properties":{"id":"20240612103558-jcszo2y"}},{"ID":"20240612103559-9mfc5pc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103559-9mfc5pc","updated":"20240612103604"},"Children":[{"Type":"NodeText","Data":"白棘《名医别录》"}]},{"ID":"20240612103559-xp0nuoj","Type":"NodeParagraph","Properties":{"id":"20240612103559-xp0nuoj","updated":"20240612103559"},"Children":[{"Type":"NodeText","Data":"无毒．主决刺结，治丈夫虚损，阴痿，精自出，补肾气，益精髓．一名棘刺．生雍州"}]},{"ID":"20240612103559-aq2hnze","Type":"NodeParagraph","Properties":{"id":"20240612103559-aq2hnze","updated":"20240612103559"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶白棘，味辛，寒．主心腹痛，痈肿溃脓，止痛．一名棘针．生川谷．"}]},{"ID":"20240612103352-c9izjtf","Type":"NodeThematicBreak","Properties":{"id":"20240612103352-c9izjtf"}},{"ID":"20240612103537-q568rg2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103537-q568rg2","updated":"20240612103540"},"Children":[{"Type":"NodeText","Data":"白棘《神农本草经》"}]},{"ID":"20240612103537-evch7kp","Type":"NodeParagraph","Properties":{"id":"20240612103537-evch7kp","updated":"20240612103537"},"Children":[{"Type":"NodeText","Data":"味辛寒。"}]},{"ID":"20240612103537-9egbqnx","Type":"NodeParagraph","Properties":{"id":"20240612103537-9egbqnx","updated":"20240612103537"},"Children":[{"Type":"NodeText","Data":"主心腹痛，痈肿渍脓，止痛。一名棘针。生川谷。"}]},{"ID":"20240612103537-grzxsk0","Type":"NodeParagraph","Properties":{"id":"20240612103537-grzxsk0","updated":"20240612103537"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名棘刺，生雍州。"}]},{"ID":"20240612103537-6ndeysh","Type":"NodeParagraph","Properties":{"id":"20240612103537-6ndeysh","updated":"20240612103537"},"Children":[{"Type":"NodeText","Data":"案《说文》云：棘，小枣丛生者。《尔雅》云：髦颠棘。孙炎云：一名白棘。李当之云：此是酸枣树针，今人用天门冬苗代之，非是真也。案经云：天门冬一名颠勒，勒棘声相近，则今人用此，亦非无因也。"}]},{"ID":"20240612103548-2uo6as6","Type":"NodeThematicBreak","Properties":{"id":"20240612103548-2uo6as6"}},{"ID":"20240612103549-s4tws32","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103549-s4tws32","updated":"20240612103553"},"Children":[{"Type":"NodeText","Data":"白棘《本经逢原》"}]},{"ID":"20240612103549-pebns5s","Type":"NodeParagraph","Properties":{"id":"20240612103549-pebns5s","updated":"20240612103549"},"Children":[{"Type":"NodeText","Data":"辛寒无毒。"}]},{"ID":"20240612103549-zvsbz8e","Type":"NodeParagraph","Properties":{"id":"20240612103549-zvsbz8e","updated":"20240612103549"},"Children":[{"Type":"NodeText","Data":"《本经》主心腹痛，痈肿溃脓，止痛决刺结。"}]},{"ID":"20240612103549-c51gang","Type":"NodeParagraph","Properties":{"id":"20240612103549-c51gang","updated":"20240612103549"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"白棘乃小枣树上针，故能决刺破结。《本经》主痈肿溃脓，与皂刺不甚相远。《别录》治丈夫虚损、阴痿、精自出，补肾气，益精髓，疗喉痹不通。又治腹胁刺痛，尿血痔漏，皆取其透达肝肾二经也。"}]},{"ID":"20240612103352-152wzss","Type":"NodeThematicBreak","Properties":{"id":"20240612103352-152wzss"}},{"ID":"20240612103353-sdrf14r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103353-sdrf14r","updated":"20240612103358"},"Children":[{"Type":"NodeText","Data":"白棘《医学入门》"}]},{"ID":"20240612103353-c8h8cki","Type":"NodeParagraph","Properties":{"id":"20240612103353-c8h8cki","updated":"20240612103353"},"Children":[{"Type":"NodeText","Data":"味辛、寒，无毒。然有钩直二种，直者主虚损阴痿，精自出，补肾气，益精髓，止尿血；钩者主心腹痛，喉痹，痈疽痔漏，疮肿溃脓，止痛，决刺结。或煮，或烧灭存性用。"}]},{"ID":"20240612103353-aubg4bq","Type":"NodeThematicBreak","Properties":{"id":"20240612103353-aubg4bq"}},{"ID":"20240612103403-mpwx2je","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103403-mpwx2je","updated":"20240612103409"},"Children":[{"Type":"NodeText","Data":"白棘《本草纲目》"}]},{"ID":"20240612103403-b8man86","Type":"NodeParagraph","Properties":{"id":"20240612103403-b8man86","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"「释名」棘刺、棘针、赤龙爪。花名刺原。"}]},{"ID":"20240612103403-5kr8xaa","Type":"NodeParagraph","Properties":{"id":"20240612103403-5kr8xaa","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"「气味」（白棘）辛、寒、无毒。"}]},{"ID":"20240612103403-hezfjkb","Type":"NodeParagraph","Properties":{"id":"20240612103403-hezfjkb","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612103403-j5arx4w","Type":"NodeParagraph","Properties":{"id":"20240612103403-j5arx4w","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"1、小便尿血。用白棘三升，加水五程序，煮取二升，分三次服。"}]},{"ID":"20240612103403-chtx80s","Type":"NodeParagraph","Properties":{"id":"20240612103403-chtx80s","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"2、明脏虚冷，腹胁刺痛。用白棘一合（焙过）、槟榔二钱半，加水一碗，煎至五分，再加好酒半碗，煮开几次后，分二次服。"}]},{"ID":"20240612103403-pty93zj","Type":"NodeParagraph","Properties":{"id":"20240612103403-pty93zj","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"3、睫毛倒生。用白棘一百二十个、地龙二条、木贼一百二十节、木鳖子仁二个，共炒为末，摘去倒毛，每日以药末吸入鼻内三、五次。睫毛即不再倒生。"}]},{"ID":"20240612103403-i5cle4e","Type":"NodeParagraph","Properties":{"id":"20240612103403-i5cle4e","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"4、龋齿腐朽。用白棘二百枚（朽落地者），加水三程序，煮成一升，含漱。或烧棘涂病齿，再敷雄黄末。"}]},{"ID":"20240612103403-y0qabxu","Type":"NodeParagraph","Properties":{"id":"20240612103403-y0qabxu","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"5、小儿口噤，惊风不乳。用白棘烧为末，水送服一钱。"}]},{"ID":"20240612103403-4ixq90h","Type":"NodeParagraph","Properties":{"id":"20240612103403-4ixq90h","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"6、小儿丹肿。用水煮白棘根汁洗搽。"}]},{"ID":"20240612103403-625k7lc","Type":"NodeParagraph","Properties":{"id":"20240612103403-625k7lc","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"7、痈前痔漏。治方同上。"}]},{"ID":"20240612103403-4m9w9qz","Type":"NodeParagraph","Properties":{"id":"20240612103403-4m9w9qz","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"8、疔疮。用白棘（倒钩者）三枚、丁香七枚，是入瓶中烧存性，加未满月的婴儿粪和匀，每日涂疮三次。"}]},{"ID":"20240612103403-ldnkuer","Type":"NodeParagraph","Properties":{"id":"20240612103403-ldnkuer","updated":"20240612103403"},"Children":[{"Type":"NodeText","Data":"9、诸肿有脓。用白棘烧灰，水送服一钱。一夜之间，肿即可出头。"}]},{"ID":"20240612103457-saa21u4","Type":"NodeThematicBreak","Properties":{"id":"20240612103457-saa21u4"}},{"ID":"20240612103458-hfmqsv6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103458-hfmqsv6","updated":"20240612103502"},"Children":[{"Type":"NodeText","Data":"白棘《神农本草经赞》"}]},{"ID":"20240612103458-hybo3dh","Type":"NodeParagraph","Properties":{"id":"20240612103458-hybo3dh","updated":"20240612103458"},"Children":[{"Type":"NodeText","Data":"味辛寒。主心腹痛。痈肿溃脓止痛。一名棘针。生川谷。茎如粉白。低列思名。针穿直刺。爪利钩萦。鸨来肃肃。"}]},{"ID":"20240612103458-gvjnga7","Type":"NodeParagraph","Properties":{"id":"20240612103458-gvjnga7","updated":"20240612103458"},"Children":[{"Type":"NodeText","Data":"蝇止营营。景风至。赤实心诚。"}]},{"ID":"20240612103458-68hu5gh","Type":"NodeParagraph","Properties":{"id":"20240612103458-68hu5gh","updated":"20240612103458"},"Children":[{"Type":"NodeText","Data":"苏恭曰。白棘根如粉白。李时珍曰。列生而低者。为棘。观名可辨。名医曰。一名棘针。"}]},{"ID":"20240612103458-1j0njy0","Type":"NodeParagraph","Properties":{"id":"20240612103458-1j0njy0","updated":"20240612103458"},"Children":[{"Type":"NodeText","Data":"尔雅翼。棘刺有直者。钩者。群芳谱。一名赤龙爪。诗。肃肃鸨翼。集于苞棘。又营营青蝇。"}]},{"ID":"20240612103458-25q90ot","Type":"NodeParagraph","Properties":{"id":"20240612103458-25q90ot","updated":"20240612103458"},"Children":[{"Type":"NodeText","Data":"止于棘。白虎通德论。景风至棘造实。陈留耆旧传。夫棘中心赤。外有刺。象我言有棘。而赤心之至诚也。"}]},{"ID":"20240612103523-wdvfchs","Type":"NodeThematicBreak","Properties":{"id":"20240612103523-wdvfchs"}},{"ID":"20240612103524-eyuk743","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103524-eyuk743","updated":"20240612103529"},"Children":[{"Type":"NodeText","Data":"白棘《本草述钩元》"}]},{"ID":"20240612103524-iuoimu3","Type":"NodeParagraph","Properties":{"id":"20240612103524-iuoimu3","updated":"20240612103524"},"Children":[{"Type":"NodeText","Data":"一名棘刺棘针。独生而高者为枣。列生而低者为棘。白棘肥盛紫色枝。有皱薄白膜。先剥起者。厥名取白。义当在此。"}]},{"ID":"20240612103524-vlexusx","Type":"NodeParagraph","Properties":{"id":"20240612103524-vlexusx","updated":"20240612103524"},"Children":[{"Type":"NodeText","Data":"气味辛寒。本经主心腹痛。痈肿溃脓。止痛。决刺结。别录疗丈夫虚损阴痿。精自出。补肾气。益精髓。棘针疗腰痛喉痹不通。"}]},{"ID":"20240612103524-2dmxfs9","Type":"NodeParagraph","Properties":{"id":"20240612103524-2dmxfs9","updated":"20240612103524"},"Children":[{"Type":"NodeText","Data":"附方腹胁刺痛不可忍。因肾脏虚冷者。棘针钩子一合焙。槟榔二钱半。水一盏。煎五分。入好酒半盏。更煎三五沸。分二服。疔疮恶肿。外治棘针倒钩烂者三枚。丁香七枚。同入瓶烧存性。以月内孩子粪和涂。日三上之。又内服方。曲头棘刺三百枚。陈皮二两。水五升。煎一升半。分服。"}]},{"ID":"20240612103524-pihu2jx","Type":"NodeParagraph","Properties":{"id":"20240612103524-pihu2jx","updated":"20240612103524"},"Children":[{"Type":"NodeText","Data":"〔论〕准绳治溲血有鹿茸丸。中用棘刺。且合桂附。是则此味补益。乃有为之前导而致其功者。抑更行而且补。在诸药味。或未有如斯之兼善者也。"}]},{"ID":"20240612103507-ewlbg8n","Type":"NodeThematicBreak","Properties":{"id":"20240612103507-ewlbg8n"}},{"ID":"20240612103508-8besry6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103508-8besry6","updated":"20240612103514"},"Children":[{"Type":"NodeText","Data":"白棘《新修本草》"}]},{"ID":"20240612103508-86gg3uo","Type":"NodeParagraph","Properties":{"id":"20240612103508-86gg3uo","updated":"20240612103508"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主心腹痛，痈肿，溃脓，止痛。决刺结，疗丈夫虚损，阴痿，精自出，补针，一名棘刺。生雍州川谷。"}]},{"ID":"20240612103508-stvs1i0","Type":"NodeParagraph","Properties":{"id":"20240612103508-stvs1i0","updated":"20240612103508"},"Children":[{"Type":"NodeText","Data":"李云此是酸枣树针，今人用天门冬苗代之，非真也。"}]},{"ID":"20240612103508-6jpud2a","Type":"NodeParagraph","Properties":{"id":"20240612103508-6jpud2a","updated":"20240612103508"},"Children":[{"Type":"NodeText","Data":"〔谨案〕白棘，茎白如粉KT 子，叶与之，亦为难得也。"}]},{"ID":"20240612103404-uvn8585","Type":"NodeThematicBreak","Properties":{"id":"20240612103404-uvn8585"}},{"ID":"20240612103414-0yg0k07","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103414-0yg0k07","updated":"20240612103421"},"Children":[{"Type":"NodeText","Data":"白棘《千金翼方》"}]},{"ID":"20240612103414-4ph1it3","Type":"NodeParagraph","Properties":{"id":"20240612103414-4ph1it3","updated":"20240612103414"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主心腹痛，痈肿溃脓，止痛，决刺结。疗丈夫虚损阴痿，精自出。补肾气，益精髓。一名棘针，一名棘刺。生雍州川谷。"}]},{"ID":"20240612103415-58bxnzv","Type":"NodeThematicBreak","Properties":{"id":"20240612103415-58bxnzv"}},{"ID":"20240612103425-8rays4n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103425-8rays4n","updated":"20240612103431"},"Children":[{"Type":"NodeText","Data":"白棘《本草衍义》"}]},{"ID":"20240612103425-yn8dyrv","Type":"NodeParagraph","Properties":{"id":"20240612103425-yn8dyrv","updated":"20240612103425"},"Children":[{"Type":"NodeText","Data":"一名棘针，一名棘刺。按经如此甚明，诸家之意强生疑惑，今掠不取，求其经而可矣。其白棘，乃是取其肥盛紫色，枝上有皱薄白膜先剥起者，故曰白棘。取白之意，不过如此。其棘刺花，乃是棘上所开花也，余无他义。今人烧枝取油，涂垢发，使垢解。"}]},{"ID":"20240612103425-tel2ytf","Type":"NodeThematicBreak","Properties":{"id":"20240612103425-tel2ytf"}},{"ID":"20240612103441-ih9mq23","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612103441-ih9mq23","updated":"20240612103451"},"Children":[{"Type":"NodeText","Data":"白棘《证类本草》"}]},{"ID":"20240612103441-ewev1yh","Type":"NodeParagraph","Properties":{"id":"20240612103441-ewev1yh","updated":"20240612103441"},"Children":[{"Type":"NodeText","Data":"味辛，寒，无毒。主心腹痛，痈肿溃脓，止痛，决刺结，疗丈夫虚损，阴痿精自出，补肾气，益精髓。一名棘针，一名棘刺。生雍州川谷。"}]},{"ID":"20240612103441-dz11te1","Type":"NodeParagraph","Properties":{"id":"20240612103441-dz11te1","updated":"20240612103441"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶李云∶此是酸枣树针。今人用天门冬苗代之，非是真也。唐本注云∶白棘，茎白图经曰∶白棘，棘针也。生雍州，棘刺花生道旁，今近京皆有之。棘，小枣也。丛高三、四尺，花、叶、茎、实都似枣，而有赤白二种。苏恭云∶白棘，茎白如粉，子、叶与赤棘同，赤棘中时复有之，亦为难得耳。然有钩、直二种∶直者宜入补药，钩者入痈肿药。针，采无时。花，冬至后百二十日采。实，四月采。又枣针，疗喉痹不通，药中亦用。陈子昂《观玉篇》云∶在张掖郡时，有人以仙人杖为白棘，同旅皆信之，二物都不相类，不知何故疑惑若此，其说见枸杞条。"}]},{"ID":"20240612103441-oz648j7","Type":"NodeParagraph","Properties":{"id":"20240612103441-oz648j7","updated":"20240612103441"},"Children":[{"Type":"NodeText","Data":"外台秘要∶治齿虫腐。棘针二百枚，以水三升，煮取一升，含之。又方∶治尿血。棘刺三升，水五升，煮取二升，分三服。千金方∶治诸恶肿，失治有脓。烧棘针作灰，水服之，经宿头出。又方∶虫食齿根肉黑。烧腐棘取沥，敷之十遍，雄黄末敷之，即愈。子母秘录∶小儿天风口噤，乳不下。白棘烧末，水服一钱匕。又方∶痈疸痔漏疮及小儿丹，水煮棘根汁洗之。出《千金》。"}]},{"ID":"20240612103441-gwo28hp","Type":"NodeParagraph","Properties":{"id":"20240612103441-gwo28hp","updated":"20240612103448"},"Children":[{"Type":"NodeText","Data":"衍义曰∶白棘，一名棘针，一名棘刺。按《经》如此甚明。诸家之意，强生疑惑，今掠不取，求其《经》而可矣。其白棘，乃是取其肥盛，紫色，枝土有皱薄白膜先剥起者，故曰白棘。取白之意，不过如此。其棘刺花，乃是棘上所开花也，余无他义。今人烧枝取油，涂垢发，使垢解。"}]},{"ID":"20240612103448-xhacc6y","Type":"NodeThematicBreak","Properties":{"id":"20240612103448-xhacc6y"}},{"ID":"20240626140041-y8u8wmv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240626140041-y8u8wmv","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：棘针"}]},{"ID":"20240626140041-kbz230b","Type":"NodeParagraph","Properties":{"id":"20240626140041-kbz230b","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240626140041-u1jb5i8","Type":"NodeParagraph","Properties":{"id":"20240626140041-u1jb5i8","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" Jí Zhēn"}]},{"ID":"20240626140041-vw74fl0","Type":"NodeParagraph","Properties":{"id":"20240626140041-vw74fl0","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240626140041-8tt20ml","Type":"NodeParagraph","Properties":{"id":"20240626140041-8tt20ml","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 白棘（《本经》），棘刺、枣针（《别录》），赤龙爪（《普济方》）。"}]},{"ID":"20240626140041-ggyokj0","Type":"NodeParagraph","Properties":{"id":"20240626140041-ggyokj0","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240626140041-9hcbxei","Type":"NodeParagraph","Properties":{"id":"20240626140041-9hcbxei","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240626140041-1p4a9mk","Type":"NodeParagraph","Properties":{"id":"20240626140041-1p4a9mk","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240626140041-zf7t6e2","Type":"NodeParagraph","Properties":{"id":"20240626140041-zf7t6e2","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 为鼠李科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酸枣"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"棘刺"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240626140041-sm2ty49","Type":"NodeParagraph","Properties":{"id":"20240626140041-sm2ty49","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240626140041-1aljthi","Type":"NodeParagraph","Properties":{"id":"20240626140041-1aljthi","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味辛，寒。\""}]},{"ID":"20240626140041-67h8iu7","Type":"NodeParagraph","Properties":{"id":"20240626140041-67h8iu7","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240626140041-wygpqlm","Type":"NodeParagraph","Properties":{"id":"20240626140041-wygpqlm","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240626140041-3vix0n7","Type":"NodeParagraph","Properties":{"id":"20240626140041-3vix0n7","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 消肿，溃脓，止痛。治痈肿有脓，心腹痛，尿血，喉痹。"}]},{"ID":"20240626140041-nar8ath","Type":"NodeParagraph","Properties":{"id":"20240626140041-nar8ath","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹痛，痈肿，溃脓，止痛。\""}]},{"ID":"20240626140041-j70e6ot","Type":"NodeParagraph","Properties":{"id":"20240626140041-j70e6ot","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"决刺结，疗丈夫虚损，阴痿，精自出。补肾气，益精髓。\"\"疗腰痛，喉痹不通。\""}]},{"ID":"20240626140041-jdgdd99","Type":"NodeParagraph","Properties":{"id":"20240626140041-jdgdd99","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240626140041-phdhlmb","Type":"NodeParagraph","Properties":{"id":"20240626140041-phdhlmb","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～2钱；或入丸、散。外用：煎汁涂或研末搐鼻。"}]},{"ID":"20240626140041-djyrlwg","Type":"NodeParagraph","Properties":{"id":"20240626140041-djyrlwg","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240626140041-jxug5w8","Type":"NodeParagraph","Properties":{"id":"20240626140041-jxug5w8","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" ①治诸恶肿失治有脓：烧棘针作灰，水服之，经宿头出。（《千金方》）"}]},{"ID":"20240626140041-ju0hq8c","Type":"NodeParagraph","Properties":{"id":"20240626140041-ju0hq8c","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"②治丁肿：曲头棘刺四百枚，橘皮三两。上二味，以水三升，煮取半升，服一合。涂肿上亦得。（《古今录验方》）"}]},{"ID":"20240626140041-d1lvmwy","Type":"NodeParagraph","Properties":{"id":"20240626140041-d1lvmwy","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"③治肾脏冷气卒攻，脐腹疼痛拘撮甚者：槟榔一分（弼），棘针钩子一合（微炒）。上药，捣粗罗为散，都作一服，以水一大盏，煎至五分，又入好酒半中盏，更煎三、五沸，去滓，不计时侯，稍热分为二服。（《圣惠方》）"}]},{"ID":"20240626140041-9ahsxcq","Type":"NodeParagraph","Properties":{"id":"20240626140041-9ahsxcq","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"④治头风疼痛：倒钩棘针四十九个（烧存性），丁香一个，麝香一皂子。为末，随左，右塞鼻。（《圣惠方》）"}]},{"ID":"20240626140041-q84t8vo","Type":"NodeParagraph","Properties":{"id":"20240626140041-q84t8vo","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"⑤治尿血：刺针二升。水三升，煮取二升，分三服。（《外台》）"}]},{"ID":"20240626140041-vnb0fkg","Type":"NodeParagraph","Properties":{"id":"20240626140041-vnb0fkg","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"⑥治小儿一切疳：棘针、瓜蒂等分。捣细罗为散，每用黍粒大，吹入鼻中，日二度佳。（《圣惠方》吹鼻散）"}]},{"ID":"20240626140041-i5rpetf","Type":"NodeParagraph","Properties":{"id":"20240626140041-i5rpetf","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"⑦治小儿喉痹：棘针烧灰，水服半钱。（《圣惠方》）"}]},{"ID":"20240626140041-6p1t8tw","Type":"NodeParagraph","Properties":{"id":"20240626140041-6p1t8tw","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"⑧治小儿天风口噤，乳不下：白棘烧末，水服一钱匕。（《子母秘录》）"}]},{"ID":"20240626140041-55zz0fc","Type":"NodeParagraph","Properties":{"id":"20240626140041-55zz0fc","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"⑨治倒睫拳毛：木鳖子二个（令炒），木贼一百二十节，地龙二条（去土），赤龙爪一百二十个。上为细末，摘去倒睫，每日以纸捻蘸药搐之，一日三、五次。（《普济方》）"}]},{"ID":"20240626140041-zf337ow","Type":"NodeParagraph","Properties":{"id":"20240626140041-zf337ow","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"⑩治齿虫：腐烂棘针二百枚（即是枣木刺朽落地者）。以水二升，煎取一升含之，日四、五度，以瘥为度。（《小品方》腐棘刺漱汤）"}]},{"ID":"20240626140041-5a9j5ic","Type":"NodeParagraph","Properties":{"id":"20240626140041-5a9j5ic","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240626140041-i8sxsxu","Type":"NodeParagraph","Properties":{"id":"20240626140041-i8sxsxu","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 《本草述》：\"《准绳》治溲血，有鹿茸丸，用棘刺逐队于诸补剂中，且有桂、附，是则《别录》所云疗丈夫虚损云云，非无据也。第如《本经》之治，似以溃脓止痛决刺结为先者，得非此味补益，乃有为之前导而致其功乎?是则行而补者，在诸药味中，或未有如斯之兼善也。惟是白棘、棘针，在《别录》主治，若有稍别，更当以寇氏之说明之。\""}]},{"ID":"20240626140041-99vd61z","Type":"NodeParagraph","Properties":{"id":"20240626140041-99vd61z","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240626140041-03h01x8","Type":"NodeParagraph","Properties":{"id":"20240626140041-03h01x8","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240626140041-fczxu14","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240626140041-fczxu14","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"《中华本草》：棘针"}]},{"ID":"20240626140041-txinp3d","Type":"NodeParagraph","Properties":{"id":"20240626140041-txinp3d","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240626140041-bqtetes","Type":"NodeParagraph","Properties":{"id":"20240626140041-bqtetes","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" Jí Zhēn"}]},{"ID":"20240626140041-hbrvwxo","Type":"NodeParagraph","Properties":{"id":"20240626140041-hbrvwxo","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240626140041-p6tm0l4","Type":"NodeParagraph","Properties":{"id":"20240626140041-p6tm0l4","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 白棘、棘刺、赤龙爪。"}]},{"ID":"20240626140041-ybjz5ky","Type":"NodeParagraph","Properties":{"id":"20240626140041-ybjz5ky","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240626140041-fb2ggup","Type":"NodeParagraph","Properties":{"id":"20240626140041-fb2ggup","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" Spine of Common Jujube, Spine of Chinese Date"}]},{"ID":"20240626140041-s18o3ou","Type":"NodeParagraph","Properties":{"id":"20240626140041-s18o3ou","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240626140041-7bcjqp7","Type":"NodeParagraph","Properties":{"id":"20240626140041-7bcjqp7","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 1.《唐本草》：棘有赤、白两种，亦犹诸枣色类非一，后条用花，斯不足怪。 以江南无棘，李云用枣针。今用棘刺， 当取白针为胜。花即棘花，定无别物。然刺有两种，有钩者，有直者，补益宜用直者，疗肿宜用钩者。"}]},{"ID":"20240626140041-wc9ps31","Type":"NodeParagraph","Properties":{"id":"20240626140041-wc9ps31","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：《切韵》曰，棘，小枣也，田野间多有之。丛高三、二尺，花叶茎实俱似枣也。"}]},{"ID":"20240626140041-xvr887l","Type":"NodeParagraph","Properties":{"id":"20240626140041-xvr887l","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"3.《本草衍义》：白棘，乃是酸枣未长大时枝上刺也。白棘，一名棘针，一名棘刺，按《经》如此甚明，诸"}]},{"ID":"20240626140041-qk0o9tq","Type":"NodeParagraph","Properties":{"id":"20240626140041-qk0o9tq","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240626140041-mi6zfi6","Type":"NodeParagraph","Properties":{"id":"20240626140041-mi6zfi6","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鼠李科植物酸枣Ziziphus jujuba Mill.var.spinosa (Bunge)Hu ex H.F.Chow 的棘刺。"}]},{"ID":"20240626140041-5ae6u4v","Type":"NodeParagraph","Properties":{"id":"20240626140041-5ae6u4v","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Ziziphus jujuba Mill.var.spinosa (Bunge)Hu ex H.F.Chow [Z.vulgaris Lam.var.spinosa Bunge]"}]},{"ID":"20240626140041-ld1c48p","Type":"NodeParagraph","Properties":{"id":"20240626140041-ld1c48p","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"采收和储藏：常年均可采，晒干。"}]},{"ID":"20240626140041-pt7ccim","Type":"NodeParagraph","Properties":{"id":"20240626140041-pt7ccim","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240626140041-qlfcwcs","Type":"NodeParagraph","Properties":{"id":"20240626140041-qlfcwcs","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于向阳或干燥的山坡、山谷、丘陵、平原、路旁以及荒地。性耐干旱，常形成灌木丛。"}]},{"ID":"20240626140041-yaaax88","Type":"NodeParagraph","Properties":{"id":"20240626140041-yaaax88","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华北、西北及辽宁、山东、江苏、安徽、河南、湖北、四川。"}]},{"ID":"20240626140041-n9duei1","Type":"NodeParagraph","Properties":{"id":"20240626140041-n9duei1","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240626140041-m25rkus","Type":"NodeParagraph","Properties":{"id":"20240626140041-m25rkus","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 酸枣 落叶灌木，稀为小乔木，高1-3m。老枝灰褐色，幼枝绿色；于分枝基部处具刺1对，1枚针形直立，长达3cm，另1枚向下弯曲，长约0.7cm。单叶互生；托叶针状；叶片长圆状卵形至卵状披针形，先端钝，基部圆形，稍偏斜，边缘具细锯齿。花小，2-3朵簇生于叶腋；花萼5裂，裂片卵状三角形；花瓣5，黄绿色，与萼片互生，雄蕊5，与花瓣对生；花盘明显，10浅裂；子房椭圆形，埋于花盘中，花柱2裂。核果肉质，近球形，成熟时暗红褐色，果皮薄，有酸味。花期6-7月，果期9-10月。"}]},{"ID":"20240626140041-sx7kw2t","Type":"NodeParagraph","Properties":{"id":"20240626140041-sx7kw2t","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240626140041-ctxst6p","Type":"NodeParagraph","Properties":{"id":"20240626140041-ctxst6p","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 心；肝经"}]},{"ID":"20240626140041-dofz7jk","Type":"NodeParagraph","Properties":{"id":"20240626140041-dofz7jk","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240626140041-7jtt0fa","Type":"NodeParagraph","Properties":{"id":"20240626140041-7jtt0fa","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 辛；寒"}]},{"ID":"20240626140041-tdp7rjl","Type":"NodeParagraph","Properties":{"id":"20240626140041-tdp7rjl","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240626140041-kms1qp2","Type":"NodeParagraph","Properties":{"id":"20240626140041-kms1qp2","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 清热解毒；消肿止痛。主痈肿；喉痹；尿血；腹痛；腰痛"}]},{"ID":"20240626140041-qi3m05i","Type":"NodeParagraph","Properties":{"id":"20240626140041-qi3m05i","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240626140041-ltbyl2i","Type":"NodeParagraph","Properties":{"id":"20240626140041-ltbyl2i","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-6g；或入丸、散。外用：适量，煎汁涂；或研末蓄鼻。"}]},{"ID":"20240626140041-zbb800k","Type":"NodeParagraph","Properties":{"id":"20240626140041-zbb800k","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240626140041-mfm1ij5","Type":"NodeParagraph","Properties":{"id":"20240626140041-mfm1ij5","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" ①治诸恶肿失治有脓： 烧棘针作灰，水服之，经宿头出。 (《干金方》)②治丁肿： 曲头棘刺四百枚，橘皮三两。上二味，以水三升，煮取半升，服一合。涂肿上亦得。(《古今录验方》)③治肾脏冷气卒攻，脐腹疼痛拘撮甚者： 槟榔一分(两)，棘针钩子一合(微炒)。上药，捣粗罗为散，都作一服，以水一大盏，煎至五分，又入好酒半中盏，更煎三、五沸，去滓，不计时候，稍热分为二服。 (《圣惠方》)④治头风疼痛： 倒钩棘针四十九个(烧存性)，丁香一个，麝香一皂子。为末，随左、右塞鼻 (《圣惠方》)⑤治尿血： 刺针二升。水三升，煮取二升，分三服。 (《外台》)⑥治小儿一切疳： 棘针、瓜蒂等分。捣细罗为散，每用黍粒大，吹入鼻中，日二度佳。 (《圣惠方》吹鼻散)⑦治小儿喉痹： 棘针烧灰，水服半钱。(《圣惠方》)⑧治小儿天风口噤，乳不下： 白棘烧末，水服一钱匕。(《子母秘录》)⑨治倒睫拳毛： 木鳖子二个(令炒)，木贼一百二十节，地龙二条(去土)，赤龙爪一百二十个。上为细末，摘去倒睫，每日以纸捻蘸药之，一日三、五次。 (《普济方》)⑩治齿虫： 腐烂棘针二百枚(即是枣木刺朽落地者)。 以水二升，煎取一升含之，日四、五度，以瘥为度。(《小品方》腐棘刺漱汤)"}]},{"ID":"20240626140041-chxprpa","Type":"NodeParagraph","Properties":{"id":"20240626140041-chxprpa","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240626140041-u3qedcg","Type":"NodeParagraph","Properties":{"id":"20240626140041-u3qedcg","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 1.《本草述》：《准绳》治溲血，有鹿茸丸，用棘刺逐队于诸补剂中，且有桂、附，是则《别录》所云疗丈夫虚损云云，非无据也。第如《本经》之治，似以溃脓止痛决刺结为先者，得非此味补益，乃有为之前导而致其功乎?是则行而补者，在诸药味中，或未有如斯之兼善也。惟是白棘、棘针，在《别录》主治，若有稍别，更当以寇氏之说明之。"}]},{"ID":"20240626140041-pn83csv","Type":"NodeParagraph","Properties":{"id":"20240626140041-pn83csv","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"2.《本经》：主心腹痛，痈肿，溃脓，止痛。"}]},{"ID":"20240626140041-rh4a0a3","Type":"NodeParagraph","Properties":{"id":"20240626140041-rh4a0a3","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"3.《别录》：决刺结，疗丈夫虚损，阴痿，精自出。补肾气，益精髓。疗腰痛，喉痹不通。"}]},{"ID":"20240626140041-x6wc2c7","Type":"NodeParagraph","Properties":{"id":"20240626140041-x6wc2c7","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240626140041-p7i2t5o","Type":"NodeParagraph","Properties":{"id":"20240626140041-p7i2t5o","updated":"20240626140041"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240626140042-502795n","Type":"NodeThematicBreak","Properties":{"id":"20240626140042-502795n"}},{"ID":"20240626140043-fm1h8je","Type":"NodeParagraph","Properties":{"id":"20240626140043-fm1h8je"}}]}