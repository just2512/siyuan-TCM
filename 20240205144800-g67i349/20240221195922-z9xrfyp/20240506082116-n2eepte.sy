aren"},{"Type":"NodeLinkDest","Data":"assets/爵床 11-20240820173132-fa0f2np.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612083243-8qmkpkg","Type":"NodeThematicBreak","Properties":{"id":"20240612083243-8qmkpkg"}},{"ID":"20240612083312-xnq713x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083312-xnq713x","updated":"20240612083319"},"Children":[{"Type":"NodeText","Data":"爵床《神农本草经》"}]},{"ID":"20240612083312-yls4ce2","Type":"NodeParagraph","Properties":{"id":"20240612083312-yls4ce2","updated":"20240612083312"},"Children":[{"Type":"NodeText","Data":"味咸寒。"}]},{"ID":"20240612083312-3gwulbt","Type":"NodeParagraph","Properties":{"id":"20240612083312-3gwulbt","updated":"20240612083312"},"Children":[{"Type":"NodeText","Data":"主腰脊痛，不得着床，俯仰艰难，除热，可作浴汤。生川谷及田野。"}]},{"ID":"20240612083312-z5xggdh","Type":"NodeParagraph","Properties":{"id":"20240612083312-z5xggdh","updated":"20240612083312"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：爵床，一名爵卿。（《御览》）"}]},{"ID":"20240612083312-tu3l891","Type":"NodeParagraph","Properties":{"id":"20240612083312-tu3l891","updated":"20240612083312"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汉中。"}]},{"ID":"20240612083312-ca05qle","Type":"NodeParagraph","Properties":{"id":"20240612083312-ca05qle","updated":"20240612083312"},"Children":[{"Type":"NodeText","Data":"案别本注云：今人名为香苏。"}]},{"ID":"20240612083337-jatuvh3","Type":"NodeThematicBreak","Properties":{"id":"20240612083337-jatuvh3"}},{"ID":"20240612083338-0wzkgs8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083338-0wzkgs8","updated":"20240612083343"},"Children":[{"Type":"NodeText","Data":"爵床《千金翼方》"}]},{"ID":"20240612083338-vnznbau","Type":"NodeParagraph","Properties":{"id":"20240612083338-vnznbau","updated":"20240612083338"},"Children":[{"Type":"NodeText","Data":"味咸，寒，无毒。主腰脊痛，不得着床。俯仰艰难，除热。可作浴汤。生汉中川谷及田野。"}]},{"ID":"20240612083522-70k8crt","Type":"NodeThematicBreak","Properties":{"id":"20240612083522-70k8crt"}},{"ID":"20240612083523-03ckh2b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083523-03ckh2b","updated":"20240612083527"},"Children":[{"Type":"NodeText","Data":"爵床《名医别录》"}]},{"ID":"20240612083523-hcsq4bn","Type":"NodeParagraph","Properties":{"id":"20240612083523-hcsq4bn","updated":"20240612083523"},"Children":[{"Type":"NodeText","Data":"无毒．生汉中及田野．"}]},{"ID":"20240612083523-domlpmh","Type":"NodeParagraph","Properties":{"id":"20240612083523-domlpmh","updated":"20240612083523"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶爵床，味咸，寒．主腰脊痛不得着床，俯仰艰难，除热；可作浴汤．生川谷．"}]},{"ID":"20240612083730-khpbxv4","Type":"NodeThematicBreak","Properties":{"id":"20240612083730-khpbxv4"}},{"ID":"20240612083732-nxa46to","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083732-nxa46to","updated":"20240612083740"},"Children":[{"Type":"NodeText","Data":"爵床《证类本草》"}]},{"ID":"20240612083732-35riude","Type":"NodeParagraph","Properties":{"id":"20240612083732-35riude","updated":"20240612083732"},"Children":[{"Type":"NodeText","Data":"味咸，寒，无毒。主腰脊痛，不得着床，俯仰艰难，除热，可作浴汤。生汉中川谷及田野。"}]},{"ID":"20240612083732-8qjroh0","Type":"NodeParagraph","Properties":{"id":"20240612083732-8qjroh0","updated":"20240612083732"},"Children":[{"Type":"NodeText","Data":"唐本注云∶此草似香 ，叶长而大，或如荏且细。生平泽熟田近道旁，甚疗血胀下气。"}]},{"ID":"20240612083732-c40dy5q","Type":"NodeParagraph","Properties":{"id":"20240612083732-c40dy5q","updated":"20240612083732"},"Children":[{"Type":"NodeText","Data":"又主杖疮，汁涂立瘥。俗名赤眼老母草。今按别本注云∶今人名为香苏。"}]},{"ID":"20240612083713-od6u6fo","Type":"NodeThematicBreak","Properties":{"id":"20240612083713-od6u6fo"}},{"ID":"20240612083714-o9rljc8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083714-o9rljc8","updated":"20240612083723"},"Children":[{"Type":"NodeText","Data":"爵床《神农本草经赞》"}]},{"ID":"20240612083714-mxuf0l8","Type":"NodeParagraph","Properties":{"id":"20240612083714-mxuf0l8","updated":"20240612083714"},"Children":[{"Type":"NodeText","Data":"微咸寒，主腰脊痛，不得著床，俯仰艰难，除热可作浴汤，生川谷及田野。"}]},{"ID":"20240612083714-fq5qko0","Type":"NodeParagraph","Properties":{"id":"20240612083714-fq5qko0","updated":"20240612083714"},"Children":[{"Type":"NodeText","Data":"错认香葇，挼搓气劣，平泽熟田，方茎对节，纵竖脊坚，引伸腰折，麻直苏舒，澡身止热。"}]},{"ID":"20240612083714-3gzfvt6","Type":"NodeParagraph","Properties":{"id":"20240612083714-3gzfvt6","updated":"20240612083714"},"Children":[{"Type":"NodeText","Data":"李时珍曰：原野甚多，方茎对节，大叶似香葇，搓之不香。苏恭曰：此草生平泽熟田。沈约赋：既纵竖而横构。刘因诗：曾经坚脊度危关。易：引而伸之。晋书传：陶潜曰，我岂能为五斗米折腰。吴普曰：一名爵麻。别录曰：一名香苏。颜延之颂：类麻能直。李时珍曰：苏性舒畅，故谓之苏。礼：儒有澡身而浴德。"}]},{"ID":"20240612083701-pzzs53m","Type":"NodeThematicBreak","Properties":{"id":"20240612083701-pzzs53m"}},{"ID":"20240612083702-ob2afqx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083702-ob2afqx","updated":"20240612083707"},"Children":[{"Type":"NodeText","Data":"爵床《本经逢原》"}]},{"ID":"20240612083702-dymeqz4","Type":"NodeParagraph","Properties":{"id":"20240612083702-dymeqz4","updated":"20240612083702"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"俗名赤眼老母草"}]},{"ID":"20240612083702-7sxebrr","Type":"NodeParagraph","Properties":{"id":"20240612083702-7sxebrr","updated":"20240612083702"},"Children":[{"Type":"NodeText","Data":"咸寒，无毒。"}]},{"ID":"20240612083702-yflecm8","Type":"NodeParagraph","Properties":{"id":"20240612083702-yflecm8","updated":"20240612083702"},"Children":[{"Type":"NodeText","Data":"《本经》主腰脊痛不得着床，俯仰艰难。除热可作汤浴。"}]},{"ID":"20240612083702-5u941zw","Type":"NodeParagraph","Properties":{"id":"20240612083702-5u941zw","updated":"20240612083702"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"爵床善通血脉。苏恭言，疗血胀下气，杖疮，捣汁涂之立瘥。观《本经》诸品，不出活血舒筋之用也。"}]},{"ID":"20240612083643-izqi88a","Type":"NodeThematicBreak","Properties":{"id":"20240612083643-izqi88a"}},{"ID":"20240612083644-nboghjq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083644-nboghjq","updated":"20240612083650"},"Children":[{"Type":"NodeText","Data":"爵床《医学入门》"}]},{"ID":"20240612083644-4gzrp7o","Type":"NodeParagraph","Properties":{"id":"20240612083644-4gzrp7o","updated":"20240612083644"},"Children":[{"Type":"NodeText","Data":"生田野，似香薷叶长而大，今人谓之香苏。味咸寒。无毒。主腰脊痛不得着床，俯仰艰难。除热可作浴汤。"}]},{"ID":"20240612083532-c6rtn25","Type":"NodeThematicBreak","Properties":{"id":"20240612083532-c6rtn25"}},{"ID":"20240612083534-g250pgv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083534-g250pgv","updated":"20240612083544"},"Children":[{"Type":"NodeText","Data":"爵床《新修本草》"}]},{"ID":"20240612083534-ytxlg4s","Type":"NodeParagraph","Properties":{"id":"20240612083534-ytxlg4s","updated":"20240612083534"},"Children":[{"Type":"NodeText","Data":"味咸，寒，无毒。主腰脊痛，不得着床，俯仰艰难，除热，可作浴汤。生汉中川谷及田野〔谨案〕此草似香 ，叶长而大，或如荏且细，生平泽熟田近道旁，甚疗血胀，下气，又主杖疮，汁涂立瘥，俗名赤眼老母草。"}]},{"ID":"20240612083421-qsb53qc","Type":"NodeThematicBreak","Properties":{"id":"20240612083421-qsb53qc"}},{"ID":"20240612083423-tkh47hx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083423-tkh47hx","updated":"20240612083432"},"Children":[{"Type":"NodeText","Data":"爵床《中药学》"}]},{"ID":"20240612083423-pofb9hg","Type":"NodeParagraph","Properties":{"id":"20240612083423-pofb9hg","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"【药用】本品为爵床科植物爵床的全草。"}]},{"ID":"20240612083423-d8q81c4","Type":"NodeParagraph","Properties":{"id":"20240612083423-d8q81c4","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"【性味与归经】咸，寒。"}]},{"ID":"20240612083423-ru4vr31","Type":"NodeParagraph","Properties":{"id":"20240612083423-ru4vr31","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"【功效】清热解毒，利尿消肿，活血止痛，截疟。"}]},{"ID":"20240612083423-pqy4tvu","Type":"NodeParagraph","Properties":{"id":"20240612083423-pqy4tvu","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于感冒发热、咳嗽、咽痛，以及水肿等症。"}]},{"ID":"20240612083423-y36bdh5","Type":"NodeParagraph","Properties":{"id":"20240612083423-y36bdh5","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"小青草有清热解毒的功效，故可用于外感发热、咳嗽、咽痛，可与蒲公英、白英、野菊花、枇杷叶等同用。本品又有利尿退肿作用，可用于小儿肾炎水肿，可每天用鲜草一至二两，煎服，连续服用，肿退后，再根据辩证，服药调治。"}]},{"ID":"20240612083423-sfc9tl6","Type":"NodeParagraph","Properties":{"id":"20240612083423-sfc9tl6","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"2.用于疟疾等症"}]},{"ID":"20240612083423-05z2gki","Type":"NodeParagraph","Properties":{"id":"20240612083423-05z2gki","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"本品有截疟作用，治疗疟疾，可单用本品一两（或鲜草三两），煎服，于疟发前3～4小时服下。"}]},{"ID":"20240612083423-wcfs60a","Type":"NodeParagraph","Properties":{"id":"20240612083423-wcfs60a","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"3.用于疔疮痈肿，扭伤肿痛等症。"}]},{"ID":"20240612083423-3yj4q1m","Type":"NodeParagraph","Properties":{"id":"20240612083423-3yj4q1m","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"本品既能清热解毒，又有活血止痛功效，对于疔疮痈肿，或扭伤肿痛等症，既可煎汤内服，有可捣烂外敷。"}]},{"ID":"20240612083423-4oxfe9i","Type":"NodeParagraph","Properties":{"id":"20240612083423-4oxfe9i","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"【处方用名】爵床、小青草（洗净，晒干，切碎用）"}]},{"ID":"20240612083423-w6fu972","Type":"NodeParagraph","Properties":{"id":"20240612083423-w6fu972","updated":"20240612083423"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至一两；鲜草一两至三两，煎服。外用适量。"}]},{"ID":"20240612083243-lm0s9xo","Type":"NodeThematicBreak","Properties":{"id":"20240612083243-lm0s9xo"}},{"ID":"20240612083244-5sd5617","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083244-5sd5617","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：爵床"}]},{"ID":"20240612083244-rvhmpfu","Type":"NodeParagraph","Properties":{"id":"20240612083244-rvhmpfu","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612083244-s1ozt1k","Type":"NodeParagraph","Properties":{"id":"20240612083244-s1ozt1k","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" Jué Chuánɡ"}]},{"ID":"20240612083244-5k2xof2","Type":"NodeParagraph","Properties":{"id":"20240612083244-5k2xof2","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612083244-aym5669","Type":"NodeParagraph","Properties":{"id":"20240612083244-aym5669","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 小青草、六角英、赤眼老母草、麦穗癀、鼠尾癀、孩儿草、野万年青、节节寒、大鸭草、毛泽兰[四川]"}]},{"ID":"20240612083244-spmiph4","Type":"NodeParagraph","Properties":{"id":"20240612083244-spmiph4","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612083244-txylvvb","Type":"NodeParagraph","Properties":{"id":"20240612083244-txylvvb","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 本品为爵床科爵床属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"爵床"},{"Type":"NodeText","Data":"Rostellularia procumbens （L.） Ness的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。夏秋采集，鲜用或晒干。"}]},{"ID":"20240612083244-y8zvkua","Type":"NodeParagraph","Properties":{"id":"20240612083244-y8zvkua","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612083244-gmcu0ms","Type":"NodeParagraph","Properties":{"id":"20240612083244-gmcu0ms","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 微苦，寒。"}]},{"ID":"20240612083244-fk74ycq","Type":"NodeParagraph","Properties":{"id":"20240612083244-fk74ycq","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612083244-s5vtasm","Type":"NodeParagraph","Properties":{"id":"20240612083244-s5vtasm","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 清热解毒，利尿消肿，截疟。用于感冒发热，疟疾，咽喉肿痛，小儿疳积，痢疾，肠炎，肾炎水肿，泌尿系感染，乳糜尿；外用治痈疮疖肿，跌打损伤。"}]},{"ID":"20240612083244-1xqzikz","Type":"NodeParagraph","Properties":{"id":"20240612083244-1xqzikz","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612083244-u3odb2j","Type":"NodeParagraph","Properties":{"id":"20240612083244-u3odb2j","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 0.5～1两；外用适量，鲜品捣烂敷患处。"}]},{"ID":"20240612083244-f0wzxtq","Type":"NodeParagraph","Properties":{"id":"20240612083244-f0wzxtq","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612083244-3rjh9c4","Type":"NodeParagraph","Properties":{"id":"20240612083244-3rjh9c4","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" （1）用于外感发热、咳嗽、咽痛，可与蒲公英、白英、野菊花、枇杷叶等同用。可用于小儿肾炎水肿，可每天用鲜草一至二两，煎服，连续服用，肿退后，再根据辩证，服药调治。治疗疟疾，可单用本品一两（或鲜草三两），煎服，于疟发前3～4小时服下。对于疔疮痈肿，或扭伤肿痛等症，既可煎汤内服，有可捣烂外敷。"}]},{"ID":"20240612083244-gu8ailf","Type":"NodeParagraph","Properties":{"id":"20240612083244-gu8ailf","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612083244-zuvkgk1","Type":"NodeParagraph","Properties":{"id":"20240612083244-zuvkgk1","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612083244-25gebzl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083244-25gebzl","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：爵床"}]},{"ID":"20240612083244-0qus72r","Type":"NodeParagraph","Properties":{"id":"20240612083244-0qus72r","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612083244-8aq6nii","Type":"NodeParagraph","Properties":{"id":"20240612083244-8aq6nii","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" Jué Chuánɡ"}]},{"ID":"20240612083244-k4ed48b","Type":"NodeParagraph","Properties":{"id":"20240612083244-k4ed48b","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612083244-q3kb947","Type":"NodeParagraph","Properties":{"id":"20240612083244-q3kb947","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 爵卿（《吴普本草》），香苏（《别录》），赤眼老母草（《唐本草》），赤眼（《品汇精要》），小青草（《百草镜》），蜻蜒草、苍蝇翅（《纲目拾遗》），鼠尾红（《台湾植物名录》），瓦子草（《中国药植志》），五累草（《南京民间药草》），六角仙草（《福建民间草药》），观音草、疳积草、肝火草、倒花草（《江西民间草药》），山苏麻（《贵州民间药物》），四季青、蚱蜢腿（《浙江民间草药》），野万年青、毛泽兰（《四川中药志》），屈胶仔、麦穗红（《闽东本草》），六角英、大鸭草（广州部队《常用中草药手册》），六方疳积草（《江"}]},{"ID":"20240612083244-vagcsc7","Type":"NodeParagraph","Properties":{"id":"20240612083244-vagcsc7","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612083244-i54rsoq","Type":"NodeParagraph","Properties":{"id":"20240612083244-i54rsoq","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612083244-w5aes30","Type":"NodeParagraph","Properties":{"id":"20240612083244-w5aes30","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612083244-muvxw7i","Type":"NodeParagraph","Properties":{"id":"20240612083244-muvxw7i","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 为爵床科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"爵床"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。立秋后采收，晒干。"}]},{"ID":"20240612083244-hnq1qrc","Type":"NodeParagraph","Properties":{"id":"20240612083244-hnq1qrc","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612083244-xy73t8t","Type":"NodeParagraph","Properties":{"id":"20240612083244-xy73t8t","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 生于旷野草地和路旁的阴湿处。分布山东、浙江、江苏、江西、湖北、四川、云南、广东、福建及台湾等地。"}]},{"ID":"20240612083244-bj4xdnd","Type":"NodeParagraph","Properties":{"id":"20240612083244-bj4xdnd","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612083244-z8vaj2i","Type":"NodeParagraph","Properties":{"id":"20240612083244-z8vaj2i","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 一年生匍匐草本，高15～30厘米。茎方形，或具4～6梭，绿色，表面被灰白色细柔毛，尤以棱上较密，节稍膨大。叶对生；卵形、长椭圆形或广披针形，全缘，先端尖，上面暗绿色，下面淡绿色，两面均有短柔毛；叶柄长5～10毫米。穗状花序顶生或腋生，长约2.5厘米；花小，萼片5，线状披针形或线形，边缘呈白色薄膜状，外围有苞片2枚，形状与萼同；花冠淡红色或带紫红色，较萼略长，上部唇形，上唇先瑞2浅裂，下唇先端3裂较深；雄蕊2枚着生于花筒部，花丝基部及着生处四周有细绒毛，药2室，1室不孕，并呈距状而下垂；雌蕊1，有毛，子房卵形，2室，花柱丝状，柱头头状，不明显。蒴果线形，先端短尖，基部惭狭，全体呈压扁状，淡棕色，表面上部具有白色短柔毛。种子卵圆形而微扁，径约1毫米，黑褐色，表面具有网状纹凸起。花期8～11月。"}]},{"ID":"20240612083244-zb6rjpo","Type":"NodeParagraph","Properties":{"id":"20240612083244-zb6rjpo","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612083244-zi2kp6w","Type":"NodeParagraph","Properties":{"id":"20240612083244-zi2kp6w","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 全草含生物碱。还含有爵床定C和D等木脂体。"}]},{"ID":"20240612083244-00ccsif","Type":"NodeParagraph","Properties":{"id":"20240612083244-00ccsif","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"Justicia procumbens L.var. leucantha Honda含爵床定A、B，山荷叶素，新爵床辛A、B，台湾杉素E甲醚，爵床辛，异爵床辛。"}]},{"ID":"20240612083244-3zidpj3","Type":"NodeParagraph","Properties":{"id":"20240612083244-3zidpj3","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612083244-8lj549m","Type":"NodeParagraph","Properties":{"id":"20240612083244-8lj549m","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 《闽东本草》：\"入肝、胆二经。\""}]},{"ID":"20240612083244-0jipwru","Type":"NodeParagraph","Properties":{"id":"20240612083244-0jipwru","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612083244-iowx219","Type":"NodeParagraph","Properties":{"id":"20240612083244-iowx219","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 咸辛，寒。"}]},{"ID":"20240612083244-m5bhk0b","Type":"NodeParagraph","Properties":{"id":"20240612083244-m5bhk0b","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"咸，寒。\""}]},{"ID":"20240612083244-d7immzp","Type":"NodeParagraph","Properties":{"id":"20240612083244-d7immzp","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240612083244-gwbylg4","Type":"NodeParagraph","Properties":{"id":"20240612083244-gwbylg4","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"微辛。\""}]},{"ID":"20240612083244-gn43b11","Type":"NodeParagraph","Properties":{"id":"20240612083244-gn43b11","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612083244-9lzr5e5","Type":"NodeParagraph","Properties":{"id":"20240612083244-9lzr5e5","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" ①《本草汇言》：\"过服亦克脾气。\""}]},{"ID":"20240612083244-rkrnzkn","Type":"NodeParagraph","Properties":{"id":"20240612083244-rkrnzkn","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"②《闽东本草》：\"脾胃虚寒，气血两虚者不宜。\""}]},{"ID":"20240612083244-ryew9nb","Type":"NodeParagraph","Properties":{"id":"20240612083244-ryew9nb","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612083244-o4sz8gc","Type":"NodeParagraph","Properties":{"id":"20240612083244-o4sz8gc","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 清热解毒，利湿消滞，活血止痛。治感冒发热，咳嗽，喉痛，疟疾，痢疾，黄疸，肾炎浮肿，筋骨疼痛，小儿疳积，痈疽疔疮，跌打损伤。"}]},{"ID":"20240612083244-o8apl5r","Type":"NodeParagraph","Properties":{"id":"20240612083244-o8apl5r","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主腰脊痛不可着床，俯仰艰难，除热，可作浴汤。\""}]},{"ID":"20240612083244-if3hn43","Type":"NodeParagraph","Properties":{"id":"20240612083244-if3hn43","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"②《唐本草》：\"疗血胀下气。\""}]},{"ID":"20240612083244-820v924","Type":"NodeParagraph","Properties":{"id":"20240612083244-820v924","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"③《本草汇言》：\"解毒，杀疳，清热。治疳热，退小儿疹后骨蒸，止血痢，疗男子酒积肠红。\""}]},{"ID":"20240612083244-hh8th0v","Type":"NodeParagraph","Properties":{"id":"20240612083244-hh8th0v","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"④《纲目拾遗》：\"理小肠火。治小儿疳积，赤目肿痛，伤寒热症，时行咽痛。\""}]},{"ID":"20240612083244-xaar9fp","Type":"NodeParagraph","Properties":{"id":"20240612083244-xaar9fp","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑤《福建民间草药》：\"解疔疮痈疽毒。\""}]},{"ID":"20240612083244-kvpvr3g","Type":"NodeParagraph","Properties":{"id":"20240612083244-kvpvr3g","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑥《四爪中药志》：\"除风清热，止咳嗽。治风湿头痛及腰痛。\""}]},{"ID":"20240612083244-43t2ovu","Type":"NodeParagraph","Properties":{"id":"20240612083244-43t2ovu","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑦《闽东本草》：\"退寒热，利水湿，截疟疾，疗淋疝，解烦热。\""}]},{"ID":"20240612083244-wx13i8m","Type":"NodeParagraph","Properties":{"id":"20240612083244-wx13i8m","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑧广州部队《常用中草药手册》：\"清热解毒，消滞散瘀。治感冒发烧，咽喉肿痛，小儿疳积，乳痈，肝炎，跌打损伤。\""}]},{"ID":"20240612083244-mrvdsao","Type":"NodeParagraph","Properties":{"id":"20240612083244-mrvdsao","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612083244-l0gnuqg","Type":"NodeParagraph","Properties":{"id":"20240612083244-l0gnuqg","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱（鲜者1～1.5两）。外用：捣敷或煎水洗。"}]},{"ID":"20240612083244-hf0m5mb","Type":"NodeParagraph","Properties":{"id":"20240612083244-hf0m5mb","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612083244-fzyn22g","Type":"NodeParagraph","Properties":{"id":"20240612083244-fzyn22g","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" ①治感冒发热，咳嗽，喉痛：爵床五钱至一两。煎服。（《上海常用中草药》）"}]},{"ID":"20240612083244-gjaef81","Type":"NodeParagraph","Properties":{"id":"20240612083244-gjaef81","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"②治疟疾：爵床一两。煎汁，于疟疾发作前三至四小时服下。（《上海常用中草药》）"}]},{"ID":"20240612083244-io0epx1","Type":"NodeParagraph","Properties":{"id":"20240612083244-io0epx1","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"③治钩端螺旋体病：爵床（鲜）八两。捣烂，敷腓肠肌。（《云南中草药》）"}]},{"ID":"20240612083244-86qs625","Type":"NodeParagraph","Properties":{"id":"20240612083244-86qs625","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"④治酒毒血痢，肠红：小青草、秦艽各三钱，陈皮、甘草各一钱。水煎服。（《本草汇言》）"}]},{"ID":"20240612083244-073onwk","Type":"NodeParagraph","Properties":{"id":"20240612083244-073onwk","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑤治黄疸，劳疟发热，翳障初起：小青草五钱，煮豆腐食。（《百草镜》）"}]},{"ID":"20240612083244-5k6vnh4","Type":"NodeParagraph","Properties":{"id":"20240612083244-5k6vnh4","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑥治肾盂肾炎：爵床三钱，地菍、凤尾草、海金砂各五钱，艾棉桃（寄生艾叶上的虫蛀球）十个。水煎服，每日一剂。（《江西草药》）"}]},{"ID":"20240612083244-g7v7wzo","Type":"NodeParagraph","Properties":{"id":"20240612083244-g7v7wzo","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑦治乳糜尿：爵床二至三两，地锦草、龙泉草各二两，车前草一两半，小号野花生、狗肝菜各一两（后二味可任选一味，如龙泉草缺，狗肝菜必用）。上药加水1500～2000毫升，文火煎成400～600毫升，其渣再加水1000毫升，文火煎取300～400毫升，供患者多次分服，每日一剂，至少以连续三个月为一个疗程，或于尿转正常后改隔日一剂，维持三个月，以巩固疗效。（《全展选编·传染病》）"}]},{"ID":"20240612083244-iy4qpi1","Type":"NodeParagraph","Properties":{"id":"20240612083244-iy4qpi1","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑧治肝硬化腹水：小青草五钱。加猪肝或羊肝同煎服。（《浙江民间草药》）"}]},{"ID":"20240612083244-rby3uyx","Type":"NodeParagraph","Properties":{"id":"20240612083244-rby3uyx","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑨治筋骨疼痛：爵床一两。水煎服。（《湖南药物志》）"}]},{"ID":"20240612083244-g9lm0ca","Type":"NodeParagraph","Properties":{"id":"20240612083244-g9lm0ca","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑩治疳积：小青草煮牛肉、田鸡、鸡肝食之。（《纲目拾遗》）"}]},{"ID":"20240612083244-n83had2","Type":"NodeParagraph","Properties":{"id":"20240612083244-n83had2","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑾治雀目：鸡肝或羊肝一具（不落水），小青草五钱。安碗内，加酒浆蒸熟，去草吃肝。加明雄黄五分尤妙。（《百草镜》）"}]},{"ID":"20240612083244-ohx73qp","Type":"NodeParagraph","Properties":{"id":"20240612083244-ohx73qp","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⑿治口舌生疮：爵床一两，水煎服。（《湖南药物志》）"}]},{"ID":"20240612083244-t03htt9","Type":"NodeParagraph","Properties":{"id":"20240612083244-t03htt9","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⒀治痈疽疮疖：小青草捣烂敷。（《本草汇言》）"}]},{"ID":"20240612083244-4gd00ht","Type":"NodeParagraph","Properties":{"id":"20240612083244-4gd00ht","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⒁治瘰疬：爵床三钱，夏枯草五钱。水煎服，每日一剂。（《江西民间草药》）"}]},{"ID":"20240612083244-q9ximhf","Type":"NodeParagraph","Properties":{"id":"20240612083244-q9ximhf","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"⒂治跌打损伤：爵床鲜草适量。洗净，捣敷患处。（《上海常用中草药》）"}]},{"ID":"20240612083244-ltpdn25","Type":"NodeParagraph","Properties":{"id":"20240612083244-ltpdn25","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612083244-wrb5r1u","Type":"NodeParagraph","Properties":{"id":"20240612083244-wrb5r1u","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" ①治疗小儿肾炎"}]},{"ID":"20240612083244-3ee4kcm","Type":"NodeParagraph","Properties":{"id":"20240612083244-3ee4kcm","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"取鲜麦穗红煎汤分次频服。1～5岁每日1～1.5两，5～10岁1.5～2.5两；10岁以上3两。如用干品可减至50～70％。观察10例，痊愈9例，好转1例。一般2～3天小便即见清利，浮肿逐渐消退。"}]},{"ID":"20240612083244-e75e5t4","Type":"NodeParagraph","Properties":{"id":"20240612083244-e75e5t4","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"②治疗结核性肛瘘"}]},{"ID":"20240612083244-ke1vxkc","Type":"NodeParagraph","Properties":{"id":"20240612083244-ke1vxkc","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"用六角仙草0.5～1两，苦刺（五加科三叶五加）1两（均为干品），加水约600毫升，煎至300～400毫升，顿服，每日1次。如瘘管分泌物很多，须每日清洁局部，并用0.2％黄连素纱布条填塞管口。经治12例，7例痊愈，5例好转。据观察，一般服药后即觉肛门疼痛减轻，分泌物减少；每日换药时，可见瘘管口周围的红肿现象日见消退，脓液逐渐减少，管壁渐渐变软，管道由深变浅，新鲜肉芽组织由管底向上慢慢生长，最后外口盖以上皮，形成瘢痕。"}]},{"ID":"20240612083244-5ot3tx2","Type":"NodeParagraph","Properties":{"id":"20240612083244-5ot3tx2","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612083244-2slaa2v","Type":"NodeParagraph","Properties":{"id":"20240612083244-2slaa2v","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612083244-mjz8tv5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612083244-mjz8tv5","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"《中华本草》：爵床"}]},{"ID":"20240612083244-4yv34ya","Type":"NodeParagraph","Properties":{"id":"20240612083244-4yv34ya","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612083244-5qjstfr","Type":"NodeParagraph","Properties":{"id":"20240612083244-5qjstfr","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" Jué Chuánɡ"}]},{"ID":"20240612083244-jeyqa96","Type":"NodeParagraph","Properties":{"id":"20240612083244-jeyqa96","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612083244-ihoyps6","Type":"NodeParagraph","Properties":{"id":"20240612083244-ihoyps6","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 爵卿、香苏、工业区眼老母草、赤眼、小青草、晴蜓草、苍蝇翅、鼠尾红、瓦子草、五累草、六角仙、观音草、肝炎草、倒花草、四季青、昨蜢腿、野万年青、毛泽兰、屈胶仔、麦穗红、山苏麻焦梅术、假辣椒、狗尾草、细路边青、六角英、六方疳积草、麦穗癀、蛇食草、水竹笋、阴牛郎、节节寒草、癞子草"}]},{"ID":"20240612083244-3tz5nm1","Type":"NodeParagraph","Properties":{"id":"20240612083244-3tz5nm1","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612083244-oq9nye7","Type":"NodeParagraph","Properties":{"id":"20240612083244-oq9nye7","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" Creeping Rostellularia Herb"}]},{"ID":"20240612083244-mx9fbqc","Type":"NodeParagraph","Properties":{"id":"20240612083244-mx9fbqc","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612083244-1ukndx3","Type":"NodeParagraph","Properties":{"id":"20240612083244-1ukndx3","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612083244-1t50ehx","Type":"NodeParagraph","Properties":{"id":"20240612083244-1t50ehx","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：爵床，似香荣，叶长而大，或如茬且细。生平泽熟田近道旁。"}]},{"ID":"20240612083244-4mqx9yx","Type":"NodeParagraph","Properties":{"id":"20240612083244-4mqx9yx","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：爵床，原野甚多，方茎对节，与大叶香蕾一样，但香蕾搓之气香，而爵床搓之不香，微臭，以此为别。"}]},{"ID":"20240612083244-ylo3heq","Type":"NodeParagraph","Properties":{"id":"20240612083244-ylo3heq","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"3.《纲目拾遗》：小青草，五月生苗，叶短小，多茎，不甚高，开花成簇，红色两瓣，与大青同，但细小耳。《纲目》'小青'条集解下引《图经》，生福州，三月生花，亦不载其形"}]},{"ID":"20240612083244-xr78gby","Type":"NodeParagraph","Properties":{"id":"20240612083244-xr78gby","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612083244-88xzyq1","Type":"NodeParagraph","Properties":{"id":"20240612083244-88xzyq1","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 药材基源：为爵床科植物爵床的全草。"}]},{"ID":"20240612083244-efr03tr","Type":"NodeParagraph","Properties":{"id":"20240612083244-efr03tr","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Rostellularia procumbens (L.) Nees [Jus-ticia procumbens L.]"}]},{"ID":"20240612083244-qs19cue","Type":"NodeParagraph","Properties":{"id":"20240612083244-qs19cue","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"采收和储藏：8-9月盛花期采收，割取地上部分，晒干。"}]},{"ID":"20240612083244-m1a6m93","Type":"NodeParagraph","Properties":{"id":"20240612083244-m1a6m93","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612083244-yj5018q","Type":"NodeParagraph","Properties":{"id":"20240612083244-yj5018q","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于旷野草了、路旁、水沟边较阴湿处。"}]},{"ID":"20240612083244-edzhb7x","Type":"NodeParagraph","Properties":{"id":"20240612083244-edzhb7x","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于山东、江苏、浙江、江西、福建、台湾、湖北、广东、广西、四川、云南等地。"}]},{"ID":"20240612083244-3n1w1op","Type":"NodeParagraph","Properties":{"id":"20240612083244-3n1w1op","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612083244-obyiw2e","Type":"NodeParagraph","Properties":{"id":"20240612083244-obyiw2e","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 爵床 一年生草本；高10-60cm。茎柔弱，基部呈匍伏状，茎方形，被灰白色细柔毛，节稍膨大。叶对生；柄长5-10mm；叶片卵形、长椭圆形或阔披针形，长2-6cm，宽1-2cm，先端尖或钝，基部楔形，全缘，上面暗绿色，叶脉明显，两面均被短柔毛。穗状花序顶生或生于上部叶腋，圆柱形，长1-4cm，密生多数小花；苞片2；萼4深裂，裂片线状披针形或线形，边缘白色；薄膜状，外药室不等大，被毛，下面的药室有距；雌蕊1，子房卵形，2室，被毛，花柱丝状。蒴果线形，长约6mm，被毛。具种子4颗，下部实心似柄状，种子表面有瘤状皱纹。花期8-11月，果期10-11月。"}]},{"ID":"20240612083244-ebkxcib","Type":"NodeParagraph","Properties":{"id":"20240612083244-ebkxcib","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612083244-satu4b2","Type":"NodeParagraph","Properties":{"id":"20240612083244-satu4b2","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜湿暖湿润的气候，不耐严寒，忌盐碱地，宜选肥沃、疏松的砂壤土种植。栽培技术 用种子每殖。北方多用条播，南方用穴播。条播作平畦，在畦上按30cm开浅沟，将种子均匀撒入沟内，覆土0.5cm左右，保持土壤湿润，10-30d可出苗，当苗高7-10cm时，可按10cm株距定苗。穴播，在整好的地上，按窝距25cm，左右开穴，要求穴浅、土细、底平，将种子拌成种子灰，匀撒穴内，每1hm2用种子7.5kg左右，保持土壤湿润，1个月左右可出苗。"}]},{"ID":"20240612083244-5fa9qlo","Type":"NodeParagraph","Properties":{"id":"20240612083244-5fa9qlo","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"田间管理 苗出齐后施清淡人畜粪水提苗，苗高10cm可匀苗补菌，每穴留壮苗4-5株，生长期注意中耕、除草、追施两次肥，促使多分枝，提高产量。"}]},{"ID":"20240612083244-xftiv72","Type":"NodeParagraph","Properties":{"id":"20240612083244-xftiv72","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"病虫害防治整顿 虫害有地龙虎，可人工捕杀或用化学度剂防治。"}]},{"ID":"20240612083244-t15el6t","Type":"NodeParagraph","Properties":{"id":"20240612083244-t15el6t","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612083244-2enrc27","Type":"NodeParagraph","Properties":{"id":"20240612083244-2enrc27","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 全草长10-60cm。根细而弯曲。茎具纵棱，直径2-4mm，基部节上常有不定根；表面黄绿色；被毛，节膨大成膝状；质脆，易折断，断面可见白色的髓。叶对生，具柄；叶片多皱缩，展平后呈卵形或狼状披针形，两面及叶缘有毛。穗状花序顶生或腋生、苞片及宿存花萼均被粗毛；偶见花冠，淡红色。蒴果棒状，长约6mm。种子4颗，黑褐色，扁三角形。气微，味淡。"}]},{"ID":"20240612083244-nqga8s2","Type":"NodeParagraph","Properties":{"id":"20240612083244-nqga8s2","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"以茎叶色绿者为佳。"}]},{"ID":"20240612083244-4drgsgk","Type":"NodeParagraph","Properties":{"id":"20240612083244-4drgsgk","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"显微鉴别 叶表面观：上表皮细胞垂周壁波状弯曲；含钟乳体细胞甚多，棱形，稍弯曲，两端渐尖或钝圆，长200-800μm，直径33-58μm；气孔直崭式；腺鳞头部4细胞，直径33-43μm，柄短，单细胞；非腺毛2-5细胞，长230-700μm，基部直径约至60μm，表面有角质条纹，有的可见疣状突起。下表皮细胞垂周壁波状弯曲；含钟乳体细胞较小，长200-500μm，直径11-58μm；气孔密布；腺鳞颇多；非腺毛着生于叶脉及叶缘处。"}]},{"ID":"20240612083244-xkdfvq3","Type":"NodeParagraph","Properties":{"id":"20240612083244-xkdfvq3","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612083244-vxsax2a","Type":"NodeParagraph","Properties":{"id":"20240612083244-vxsax2a","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 爵床全草含爵床脂定（justicidin）A，山荷叶素（diphyllin），爵床脂定（justiscidin）E，新爵床脂纱（neojusticin）A、B、C、D[1]。"}]},{"ID":"20240612083244-xbvkk6b","Type":"NodeParagraph","Properties":{"id":"20240612083244-xbvkk6b","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612083244-gan84og","Type":"NodeParagraph","Properties":{"id":"20240612083244-gan84og","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 抑菌试验表明：爵床素煎剂对金黄色葡菌有较强的抑菌作用。"}]},{"ID":"20240612083244-dbayhev","Type":"NodeParagraph","Properties":{"id":"20240612083244-dbayhev","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612083244-51hi9kf","Type":"NodeParagraph","Properties":{"id":"20240612083244-51hi9kf","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 采得后，除去泥土、杂质等，鲜用；或晒干用。"}]},{"ID":"20240612083244-bymvow8","Type":"NodeParagraph","Properties":{"id":"20240612083244-bymvow8","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612083244-x8luw21","Type":"NodeParagraph","Properties":{"id":"20240612083244-x8luw21","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 归肺；肝；膀胱经"}]},{"ID":"20240612083244-fccgwng","Type":"NodeParagraph","Properties":{"id":"20240612083244-fccgwng","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612083244-n8ajjrx","Type":"NodeParagraph","Properties":{"id":"20240612083244-n8ajjrx","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 味苦；咸；辛；性寒"}]},{"ID":"20240612083244-i193nlt","Type":"NodeParagraph","Properties":{"id":"20240612083244-i193nlt","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612083244-w8qf74g","Type":"NodeParagraph","Properties":{"id":"20240612083244-w8qf74g","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 过服亦克脾气、脾胃虚寒、气血两虚者不宜。"}]},{"ID":"20240612083244-n821zpg","Type":"NodeParagraph","Properties":{"id":"20240612083244-n821zpg","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612083244-7iuz37i","Type":"NodeParagraph","Properties":{"id":"20240612083244-7iuz37i","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 清热解毒；利湿消积；活血止痛。主感冒发热；咳嗽；咽喉肿痛；目赤肿痛；疳积；湿热泻痢；疟疾；黄疸；浮肿；小便淋浊；筋肌疼痛；跌打损伤；痈疽疔疮；湿疹。"}]},{"ID":"20240612083244-rtieiyg","Type":"NodeParagraph","Properties":{"id":"20240612083244-rtieiyg","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612083244-bplmnuf","Type":"NodeParagraph","Properties":{"id":"20240612083244-bplmnuf","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，10-15g，鲜品30-60g；或捣汁；或研末。外用：鲜品适量、捣敷；或汤洗浴。"}]},{"ID":"20240612083244-rthudqj","Type":"NodeParagraph","Properties":{"id":"20240612083244-rthudqj","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612083244-350ls9p","Type":"NodeParagraph","Properties":{"id":"20240612083244-350ls9p","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" ①治感冒发热，咳嗽，喉痛：爵床五钱至一两。煎服。(《上海常用中草药》)②治疟疾：爵床一两。煎汁，于疟疾发作前三至四小时服下。(《上海常用中草药》)③治钩端螺旋体病：爵床(鲜)八两。捣烂，敷跳肠肌。(名云南中草药》)④治酒毒血痢，肠红：小青草、秦苑各三钱，陈皮、甘草各一钱。水煎服。(《本草汇言》)⑤治黄痘，劳疟发热，缓障初起：小青草五钱，煮豆腐食。(《百草镜》)⑥治肾孟肾炎：爵床三钱，地葱、风尾草、海金砂各五钱，艾棉挑(寄生艾叶上的虫蛀球)十个。水煎服，每日一剂。(《江西草药》)⑦治乳糜尿：爵床二至三两，地锦草、龙泉草各二两，车前草一两半，小号野花生、狗肝菜各一两(后二味可任选一味，如龙泉草缺，狗肝菜必用)。上药加水1500"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"2000毫升，文火煎成400"},{"Type":"NodeText","Data":"600毫升，其渣再加水1000毫升，文火煎取300~400毫升，供患者多次分服，每日一剂，至少以连续三个月为一个疗程，或于尿转正常后改隔日一剂，维持三个月，以巩固疗效。(《全展选编·传染病》)⑧治肝硬化腹水：小青草五钱。加猪肝或羊肝同煎服。(《浙江民间草药》)⑨治筋骨疼痛：爵床一两。水煎服。(《湖南药物志》)⑩治府积：小青草煮牛肉、田鸡、鸡肝食之。(名纲目拾遗》)(11)治雀目：鸡肝或羊肝一具(不落水)p4.青草五钱。安碗内，加酒浆蒸熟，去草吃肝。加阴雄黄五分尤妙。(《百草镜》)(12)治口舌生疮：爵床一两，水煎服。(《湖南药物志》)(13)治痈疽疮宛：小青草捣烂敷。(《本草汇言☆)(14)治撬疯：爵床三钱，夏枯草五钱。水煎服，每日一剂。(《江西民间草药》)(15)治跌打损伤：爵床鲜草适量。洗净，捣敷患处。(《上海常用中草药》)"}]},{"ID":"20240612083244-9nwdsjq","Type":"NodeParagraph","Properties":{"id":"20240612083244-9nwdsjq","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612083244-2hx6p3r","Type":"NodeParagraph","Properties":{"id":"20240612083244-2hx6p3r","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 1.治疗小儿肾炎：取鲜麦穗红煎汤分次频服。1-5岁每日1-1．5两，5-10岁1.5-2.5两；10岁以上3两。如用干品可减至50-70%。观察10例，痊愈9例，好转 1例。一般2-3天小便即见清利，浮肿逐渐消退。"}]},{"ID":"20240612083244-fwr40d9","Type":"NodeParagraph","Properties":{"id":"20240612083244-fwr40d9","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"2.治疗结核性肛癣：用六角仙草0.5-1两，苦刺(五加科三叶五加)1两(均为干品)加水约600ml，煎至300-400ml，顿服，每日1次。如澳管分泌物很多，须每日清洁局部，并用0.2%黄连素纱布条填塞管口。经治12例，7例痊愈，5例好转。据观察，一般服药后即觉肛门疼痛减轻，分泌物减少；每日换药时，可见接管口周围的红肿现象日见消退，脓液逐渐减少，管壁渐渐变软，管道由深变浅，新鲜肉芽组织由管底向上慢慢生长，最后外口盖以上皮，形成摄痕。"}]},{"ID":"20240612083244-3jz8dwg","Type":"NodeParagraph","Properties":{"id":"20240612083244-3jz8dwg","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612083244-fkdyu93","Type":"NodeParagraph","Properties":{"id":"20240612083244-fkdyu93","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主腰脊痛不可着床，俯仰艰难，除热，可作浴汤。"}]},{"ID":"20240612083244-cvds0lw","Type":"NodeParagraph","Properties":{"id":"20240612083244-cvds0lw","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：疗血胀下气。"}]},{"ID":"20240612083244-c5p75n5","Type":"NodeParagraph","Properties":{"id":"20240612083244-c5p75n5","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"3.《本草汇言》：解毒，杀府，清热。治瘤热，退小儿疹后骨蒸，止血痢，疗男子酒积肠红。"}]},{"ID":"20240612083244-r8skt30","Type":"NodeParagraph","Properties":{"id":"20240612083244-r8skt30","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"4.《纲目拾遗》：理小肠火。治小儿府积，赤目肿痛，伤寒热症，时行咽痛。"}]},{"ID":"20240612083244-gpohf7w","Type":"NodeParagraph","Properties":{"id":"20240612083244-gpohf7w","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"5.《福建民间草药》：解疗疮痈疽毒。"}]},{"ID":"20240612083244-5558vfe","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612083244-5558vfe","updated":"20240612083244"},"Children":[{"ID":"20240612083244-gjub87m","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240612083244-gjub87m","updated":"20240612083244"},"Children":[{"ID":"20240612083244-dc67dvx","Type":"NodeParagraph","Properties":{"id":"20240612083244-dc67dvx","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"《四川中药志》：除风清热，止咳嗽。治风湿头痛及腰痛。"}]}]}]},{"ID":"20240612083244-k5g2xfa","Type":"NodeParagraph","Properties":{"id":"20240612083244-k5g2xfa","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"7.《闽东本草》：退寒热，利水湿，截疟疾，疗淋疵，解烦热。"}]},{"ID":"20240612083244-jxvsix8","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612083244-jxvsix8","updated":"20240612083244"},"Children":[{"ID":"20240612083244-iqdbf7x","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OC4=","Num":8},"Properties":{"id":"20240612083244-iqdbf7x","updated":"20240612083244"},"Children":[{"ID":"20240612083244-dkzzd4f","Type":"NodeParagraph","Properties":{"id":"20240612083244-dkzzd4f","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"广州部队《常用中草药手册》：清热解毒，消滞散疯。治感冒发烧，咽喉肿痛，小儿府积，乳痈，肝炎，跌打损伤。"}]}]}]},{"ID":"20240612083244-j3isg3z","Type":"NodeParagraph","Properties":{"id":"20240612083244-j3isg3z","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612083244-ryt9kxu","Type":"NodeParagraph","Properties":{"id":"20240612083244-ryt9kxu","updated":"20240612083244"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612083246-6nyxk5z","Type":"NodeThematicBreak","Properties":{"id":"20240612083246-6nyxk5z"}},{"ID":"20240612083247-9mq3yw4","Type":"NodeParagraph","Properties":{"id":"20240612083247-9mq3yw4"}}]}