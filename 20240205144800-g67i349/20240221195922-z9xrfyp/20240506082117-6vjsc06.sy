odeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 609px;","style":"width: 599px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸橘树3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸橘树3-20240708095504-5c2ti11.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 599px;\" parent-style=\"width: 609px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 609px;","style":"width: 599px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸橘"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸橘-20240912162859-r18act2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 599px;\" parent-style=\"width: 609px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240708095517-o07n3sp","Type":"NodeParagraph","Properties":{"id":"20240708095517-o07n3sp","updated":"20240708100241"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 590px;","style":"width: 580px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240708093525-c3wf8m7.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 580px;\" parent-style=\"width: 590px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 436px;","style":"width: 426px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"枸橘树7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/枸橘树7-20240708100241-e62lc8o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 426px;\" parent-style=\"width: 436px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240708081148-u1xa3u9","Type":"NodeParagraph","Properties":{"id":"20240708081148-u1xa3u9","updated":"20240821101343"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"一注："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有说法橘生于淮南则为橘，生于淮北则为枳。（实际上橘和枳不是同一种东西，只是长得像，是误传）"}]},{"ID":"20240708083514-tr7q0ho","Type":"NodeParagraph","Properties":{"id":"20240708083514-tr7q0ho","updated":"20240708092624"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"二注："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"网络较多说法称枳实为芸香科植物酸橙或甜橙的幼果，经考证该说法是错的。实际上是枸橘的果实。"}]},{"ID":"20240705172219-9a1ru6t","Type":"NodeParagraph","Properties":{"id":"20240705172219-9a1ru6t","updated":"20240821101500"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"三注："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄帝内经有记载‘黄如枳实者死’，说明古时枳实是成熟的果实。（现代有说法枳实为幼果，枳壳为成熟果实，应该是后代的细分）"}]},{"ID":"20240708090545-vgourde","Type":"NodeParagraph","Properties":{"id":"20240708090545-vgourde","updated":"20240708092647"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"四注："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"延伸：汉代无枳壳之说，所以只有枳实，枳壳是后来人加的——沈括指出“六朝以前医方，唯有枳实，无枳壳，故《本草》也只有枳实。后人用枳之小嫩者为枳实，大者为枳壳，主疗各有所宜，遂别出枳売一条，以附枳实之后。然两条主疗，亦相出人。古人言枳売条，便是枳壳，《本草》中枳实主疗，便是枳壳主疗。后人即别出枳壳条，便合于枳实条内摘出枳壳主疗，别为一条；旧条内只合留枳实主疗，后人以《神农本草》不敢摘破，不免两条相犯，互有出入。”"}]},{"ID":"20240708090745-7jo0kwd","Type":"NodeParagraph","Properties":{"id":"20240708090745-7jo0kwd","updated":"20240708092705"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"五注："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"现代如果要买古方所记载的枳实，应该买枳壳（且不能买酸橙幼果，应该买枸橘成熟果实）。"}]},{"ID":"20240612092708-p2huyyd","Type":"NodeThematicBreak","Properties":{"id":"20240612092708-p2huyyd"}},{"ID":"20240612092719-kufjlk1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092719-kufjlk1","updated":"20240612092724"},"Children":[{"Type":"NodeText","Data":"枳实《神农本草经》"}]},{"ID":"20240612092719-o2wrv5g","Type":"NodeParagraph","Properties":{"id":"20240612092719-o2wrv5g","updated":"20240612092719"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240612092719-snqy6nw","Type":"NodeParagraph","Properties":{"id":"20240612092719-snqy6nw","updated":"20240612092719"},"Children":[{"Type":"NodeText","Data":"主大风在皮肤中，如麻豆苦痒（《御览》作痰，非），除寒热结，止利（旧作痢，《御览》作利，是），长肌肉，利五脏，益气轻身。生川泽。"}]},{"ID":"20240612092719-kustais","Type":"NodeParagraph","Properties":{"id":"20240612092719-kustais","updated":"20240612092719"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：枳实苦，雷公酸无毒，李氏大寒，九月十月采，阴干。（《御览》）"}]},{"ID":"20240612092719-2j8e3hp","Type":"NodeParagraph","Properties":{"id":"20240612092719-2j8e3hp","updated":"20240612092719"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生河内，九月十月采，阴干。"}]},{"ID":"20240612092719-ev9182n","Type":"NodeParagraph","Properties":{"id":"20240612092719-ev9182n","updated":"20240612092719"},"Children":[{"Type":"NodeText","Data":"案《说文》云：枳木似橘。《周礼》云：橘逾淮而化为枳。沈括补笔谈云：六朝以前，医方，唯有枳实，无枳壳，后人用枳之小嫩者为枳实，大者为枳壳。"}]},{"ID":"20240612092729-dh8p352","Type":"NodeThematicBreak","Properties":{"id":"20240612092729-dh8p352"}},{"ID":"20240612092731-uv3n2tc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092731-uv3n2tc","updated":"20240612092736"},"Children":[{"Type":"NodeText","Data":"枳实《长沙药解》"}]},{"ID":"20240612092731-at0dl6l","Type":"NodeParagraph","Properties":{"id":"20240612092731-at0dl6l","updated":"20240612092731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦寒。主大风在皮肤中，如麻豆苦痒，除寒热结，止利，长肌肉，利五脏，益气轻身。生川泽。"}]},{"ID":"20240612092731-5koclco","Type":"NodeParagraph","Properties":{"id":"20240612092731-5koclco","updated":"20240612092731"},"Children":[{"Type":"NodeText","Data":"味苦、酸、辛，性寒，入足阳明胃经。泻痞满而去湿，消陈腐而还清。"}]},{"ID":"20240612092731-zzxlcf7","Type":"NodeParagraph","Properties":{"id":"20240612092731-zzxlcf7","updated":"20240612092731"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳术汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"枳实七枚，白术二两。煎，分三服。腹中软，即当散。"},{"Type":"NodeText","Data":"治心下坚，大如盘，边如旋杯，水饮所作。以水停中脘，胃气郁阻，胆经隔碍，不得下行，痞结心下，坚硬不消。枳实泻水而消痞，白术燥土而补中也。"}]},{"ID":"20240612092731-4ao8gil","Type":"NodeParagraph","Properties":{"id":"20240612092731-4ao8gil","updated":"20240612092731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳实薤白桂枝汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"枳实四枚，厚朴四两，栝蒌一枚，薤白半斤，桂枝一两。"},{"Type":"NodeText","Data":"治胸痹心痞，胸中满结，胁下逆抢心。以胆胃上逆，胸膈填塞。枳、朴、薤白，破壅塞而消痹结，栝蒌、桂枝，涤浊瘀而下冲逆也。"}]},{"ID":"20240612092731-zisdm0u","Type":"NodeParagraph","Properties":{"id":"20240612092731-zisdm0u","updated":"20240612092731"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳实栀子汤"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"，枳实三枚，栀子十四枚，香豉一两。清浆水煎，分二服，覆令微似汗。"},{"Type":"NodeText","Data":"治大病差后，劳复者。大病新差，中气尚弱，因劳而复。浊阴上逆，中宫堙塞，经郁热作。枳实降浊而消滞，栀子泻热而清烦，香豉和中而散郁也。"}]},{"ID":"20240612092731-yorxkpz","Type":"NodeParagraph","Properties":{"id":"20240612092731-yorxkpz","updated":"20240612092731"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳实芍药散"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"枳实、芍药等分。为散，服方寸匕。日三服，并主痈脓，以大麦粥下之。"},{"Type":"NodeText","Data":"治产后腹痛，烦满不得卧。以产后血亡肝燥，风木克土，是以腹痛。肝脾郁结，则胆胃壅塞，而生烦满。芍药清风而止痛，枳实泻满而除烦也。"}]},{"ID":"20240612092731-j8o1oj9","Type":"NodeParagraph","Properties":{"id":"20240612092731-j8o1oj9","updated":"20240612092731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栀子大黄汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在栀子。"},{"Type":"NodeText","Data":"用之治伤寒下后，心烦腹满者，治酒疸懊憹热痛者，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"橘枳生姜汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在橘皮。"},{"Type":"NodeText","Data":"用之治胸中痹塞，短气，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"桂姜枳实汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在桂枝。"},{"Type":"NodeText","Data":"用之治心中痞塞悬痛，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大小承气汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"二方在大黄。"},{"Type":"NodeText","Data":"用之治阳明胃燥便难，皆以其泻痞满而破壅塞也。"}]},{"ID":"20240612092731-ozjppi7","Type":"NodeParagraph","Properties":{"id":"20240612092731-ozjppi7","updated":"20240612092731"},"Children":[{"Type":"NodeText","Data":"枳实酸苦迅利，破结开瘀，泻痞消满，除停痰流饮，化宿谷坚癥。涤荡郁陈，功力峻猛，一切腐败壅阻之物，非此不消。"}]},{"ID":"20240612092731-nowdsbg","Type":"NodeParagraph","Properties":{"id":"20240612092731-nowdsbg","updated":"20240612092731"},"Children":[{"Type":"NodeText","Data":"麸炒黑，勿令焦，研用。"}]},{"ID":"20240612092941-lfxsdrf","Type":"NodeThematicBreak","Properties":{"id":"20240612092941-lfxsdrf"}},{"ID":"20240612092942-ldom7w8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092942-ldom7w8","updated":"20240612092948"},"Children":[{"Type":"NodeText","Data":"枳实、枳壳《本草备要》"}]},{"ID":"20240612092942-cd02t3d","Type":"NodeParagraph","Properties":{"id":"20240612092942-cd02t3d","updated":"20240612092942"},"Children":[{"Type":"NodeText","Data":"泻，破气，行痰。枳实小，枳壳大"}]},{"ID":"20240612092942-ghpdz2c","Type":"NodeParagraph","Properties":{"id":"20240612092942-ghpdz2c","updated":"20240612092942"},"Children":[{"Type":"NodeText","Data":"苦酸微寒。其功皆能破气。气行则痰行喘止，痞胀消（脾无积血；心下不痞；浊气在上，则生腹胀。东垣曰∶枳实治下而主血，枳壳治上而主气），痛刺息，后重除。"}]},{"ID":"20240612092942-q1umpv9","Type":"NodeParagraph","Properties":{"id":"20240612092942-q1umpv9","updated":"20240612092942"},"Children":[{"Type":"NodeText","Data":"治胸痹结胸，食积五膈，痰癖症结，呕逆咳嗽，水肿胁胀（肝郁），泻痢淋闭，痔肿肠风。除风去痹（辛散风），开胃健脾。所主略同，但枳实利胸膈，枳壳宽肠胃。枳实力猛（大、小承气汤皆用之。丹溪曰∶枳实泻痰，能冲墙倒壁），枳壳力缓为少异。孕妇及气虚人忌用（按∶《本草》壳、实皆云明目。思之不得其解，然目疾方中多用之，岂以其破浊气？即能升清气乎？《本经》又言枳实益气，想亦同此理也。故浓朴调中，亦有益气明目之文。王好古曰∶枳实佐以参、术、干姜则益气，佐以硝、黄、牵牛则破气，此本经所以言益气，而复言消痞也。张元素曰∶枳壳泄肺、走大肠，多用损胸中至高之气。昔湖阳公主难产，方士进瘦胎饮，用枳壳四两，甘草三两，五月后日服一钱。张洁古改以枳术名束胎丸。寇宗 明其不然，盖孕妇全赖血气以养胎，血气充实，胎乃易生。彼公主奉养太过，气实有余，故可服之，若概施则误矣。时珍曰∶八九月胎，气盛壅滞，用枳壳、苏梗以顺气，胎前无滞，则产后无虚也。气弱者，大非所宜矣）。"}]},{"ID":"20240612092942-ln8r8bl","Type":"NodeParagraph","Properties":{"id":"20240612092942-ln8r8bl","updated":"20240612092942"},"Children":[{"Type":"NodeText","Data":"皮浓而小为枳实，壳薄虚大为枳壳。陈者良。麸炒用（时珍曰∶壳、实上世未分，魏、晋始分用。洁古、东垣，始分壳治上，实治下。海藏始分壳主气，实主血。然仲景治上焦胸痹、痞满用枳实；诸方治下血、痢、痔、肠秘、后重用枳壳，则实不独治下，而壳不独治高也。盖自飞门至魄门，皆肺主之，三焦相通，一气而已。飞门，口也。魄门，即肛门）。"}]},{"ID":"20240612092754-6pcmk9l","Type":"NodeThematicBreak","Properties":{"id":"20240612092754-6pcmk9l"}},{"ID":"20240612092755-ejhh9zu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092755-ejhh9zu","updated":"20240612092759"},"Children":[{"Type":"NodeText","Data":"枳实《医学入门》"}]},{"ID":"20240612092755-wxt2x3v","Type":"NodeParagraph","Properties":{"id":"20240612092755-wxt2x3v","updated":"20240612092755"},"Children":[{"Type":"NodeText","Data":"枳实比壳性更酷，主治大同下胁腹，更消脾瘀破坚 ，溏泻阴痿莫误服。"}]},{"ID":"20240612092755-6lbjyhu","Type":"NodeParagraph","Properties":{"id":"20240612092755-6lbjyhu","updated":"20240612092755"},"Children":[{"Type":"NodeText","Data":"与枳壳一种。大而色黄紫多瓤曰壳，小而色青中实少瓤曰实。无毒。浮而降，纯阴。逐停水，消痰饮，宽胸胁，安胃气，止喘逆，破积聚，利五脏，除寒热结，功同枳壳。但枳壳性祥而缓，枳实性酷而速。更能去脾间瘀血，瘀血去而痞自消。去日久稠痰，消年深坚积。丹溪云∶脾胃湿热生痰有积者，入白术中四分之一。脾用枳实，有推墙倒壁之功，故治下，主血在心腹之分；胃用枳壳，损至高之气，故治高，主气在胸膈之分。皆疏通决泻滑窍破结实之剂。本草云∶止溏泄，益气明目，亦谓积去而脾健神清也。《药性论》云∶肾内伤冷，阴痿而有气，加而用之，借以达下耳。要之实证可用，虚而久病慎不可误服。海藏云∶益气佐以参、术、干姜，破气佐以牵牛、硝、黄，其善用枳实者乎！又与黄 等分糊丸服，治肠风下血；单用蜜丸服，治五痔；为末饮调服，治胸痹气壅，心膈不利及小儿久痢淋沥，水谷不调；炒熟熨妇人阴肿痛。壳、实俱宜商州陈久者，水浸软去瓤，麸炒。"}]},{"ID":"20240612092926-yd9l0tf","Type":"NodeThematicBreak","Properties":{"id":"20240612092926-yd9l0tf"}},{"ID":"20240612092927-f63321p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092927-f63321p","updated":"20240612092931"},"Children":[{"Type":"NodeText","Data":"枳实《神农本草经赞》"}]},{"ID":"20240612092927-m2utzxf","Type":"NodeParagraph","Properties":{"id":"20240612092927-m2utzxf","updated":"20240612092927"},"Children":[{"Type":"NodeText","Data":"味苦寒。主大风在皮肤中。如麻豆苦痒。除寒热结。止利。长肌肉。利五脏。益气轻身。生川泽。"}]},{"ID":"20240612092927-unoss8j","Type":"NodeParagraph","Properties":{"id":"20240612092927-unoss8j","updated":"20240612092927"},"Children":[{"Type":"NodeText","Data":"种枳编篱。鸾栖讵拟。碧移情。枫红着美。大小殊功。速详具理。山叩崇吾。食宜孙子。"}]},{"ID":"20240612092927-1df66d0","Type":"NodeParagraph","Properties":{"id":"20240612092927-1df66d0","updated":"20240612092927"},"Children":[{"Type":"NodeText","Data":"陆游诗。种枳为篱草结庐。李商隐诗。枳嫩栖鸾叶。列子。有大木焉。其名为。树碧而冬生。渡淮而北化而为枳。王逢诗。枫叶殷红枳实肥。寇宗曰。枳实小。则其性酷而速。大则其性详而缓。山海经。崇吾之山有木焉。其实如枳。食之宜子孙。"}]},{"ID":"20240612092916-i18yc77","Type":"NodeThematicBreak","Properties":{"id":"20240612092916-i18yc77"}},{"ID":"20240612092917-ues0i2a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092917-ues0i2a","updated":"20240612092922"},"Children":[{"Type":"NodeText","Data":"枳实《本草衍义》"}]},{"ID":"20240612092917-00yppcn","Type":"NodeParagraph","Properties":{"id":"20240612092917-00yppcn","updated":"20240612092917"},"Children":[{"Type":"NodeText","Data":"枳实、枳壳一物也。小则其性酷而速，大则其性详而缓。故张仲景治伤寒仓猝之病，承气汤中用枳实，此其意也。皆取其疏通决泄、破结实之义。他方但导败风壅之气，可常服者，故用枳壳，其意如此。"}]},{"ID":"20240612092906-lizpdse","Type":"NodeThematicBreak","Properties":{"id":"20240612092906-lizpdse"}},{"ID":"20240612092907-wjn2ur9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092907-wjn2ur9","updated":"20240612092911"},"Children":[{"Type":"NodeText","Data":"枳实《本草求真》"}]},{"ID":"20240612092907-31x5waw","Type":"NodeParagraph","Properties":{"id":"20240612092907-31x5waw","updated":"20240612092907"},"Children":[{"Type":"NodeText","Data":"（灌木）"}]},{"ID":"20240612092907-k9dqm6j","Type":"NodeParagraph","Properties":{"id":"20240612092907-k9dqm6j","updated":"20240612092907"},"Children":[{"Type":"NodeText","Data":"枳实（专入脾胃）。气味与枳壳苦酸微寒无异。但实小性酷。较壳最迅。故书载有推墙倒壁之功。不似枳壳体大气散。而仅为利肺开胸宽肠之味耳。是以气在胸中。则用枳壳。气在胸下。则用枳实。气滞则用枳壳。气坚则用枳实。虽古有云枳壳治气。枳实治血。然气行则血自通。究皆利气之品。而非通血之剂耳。故同白术则可调脾。同大黄则可推荡。（时珍曰。盖自飞门至魄门。皆肺主之。三焦相通。一气而已。）若气虚痞满而用枳实枳壳。则与抱薪救火者无异矣！"}]},{"ID":"20240612092855-s6x6bd3","Type":"NodeThematicBreak","Properties":{"id":"20240612092855-s6x6bd3"}},{"ID":"20240612092857-tgm9yan","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092857-tgm9yan","updated":"20240612092901"},"Children":[{"Type":"NodeText","Data":"枳实《本草分经》"}]},{"ID":"20240612092857-et4nb0a","Type":"NodeParagraph","Properties":{"id":"20240612092857-et4nb0a","updated":"20240612092857"},"Children":[{"Type":"NodeText","Data":"苦酸微寒，破气行痰，消痞止喘，利胸膈宽肠胃。"}]},{"ID":"20240612092842-tpkw39m","Type":"NodeThematicBreak","Properties":{"id":"20240612092842-tpkw39m"}},{"ID":"20240612092843-6mxofze","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092843-6mxofze","updated":"20240612092850"},"Children":[{"Type":"NodeText","Data":"枳实《本草害利》"}]},{"ID":"20240612092843-rmyvvwi","Type":"NodeParagraph","Properties":{"id":"20240612092843-rmyvvwi","updated":"20240612092843"},"Children":[{"Type":"NodeText","Data":"〔害〕惟专消导，破气损真。丹溪云∶泻痰，有冲墙倒壁之力，其为勇悍之气可知。凡中气虚弱，劳倦伤脾发为痞满者，法当调中益气，则食自化，痞自消，若再用此破气，是速其毙也。胀满，非实邪结于中下焦，手不可按，七八日不更衣者，必不可用。挟热下利，亦非燥粪留结者，必不可用。伤食停积，多因脾胃虚，不能运化所致，慎勿妄投。如元气壮实，有积滞者，不得已用一二剂，病已即去之。若不识病之虚实，一概施用，损人真气，为厉不浅。误投，虽多服参 补剂，亦难挽其克削之害也。故特表以为戒。孕妇尤忌。"}]},{"ID":"20240612092843-8yx2qix","Type":"NodeParagraph","Properties":{"id":"20240612092843-8yx2qix","updated":"20240612092843"},"Children":[{"Type":"NodeText","Data":"〔利〕苦酸微寒，入肺、脾、胃、肝、大肠五经。破积有雷厉风行之势，泻痰有推墙倒壁之威。解伤寒结胸，除心下急痞。按枳实枳壳，性效不同。"}]},{"ID":"20240612092843-qqhoask","Type":"NodeParagraph","Properties":{"id":"20240612092843-qqhoask","updated":"20240612092843"},"Children":[{"Type":"NodeText","Data":"〔修治〕皮浓而小者为枳实，完大者为枳壳，皆以翻肚如盆口状，陈者为良。采破，除核，微炙令干，切片，小麦麸炒焦去麸用。"}]},{"ID":"20240612092829-sc8oj2w","Type":"NodeThematicBreak","Properties":{"id":"20240612092829-sc8oj2w"}},{"ID":"20240612092830-cfv3pyj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092830-cfv3pyj","updated":"20240612092838"},"Children":[{"Type":"NodeText","Data":"枳实《本草便读》"}]},{"ID":"20240612092830-59diz26","Type":"NodeParagraph","Properties":{"id":"20240612092830-59diz26","updated":"20240612092830"},"Children":[{"Type":"NodeText","Data":"性味与枳壳相同．功力较老者更猛．泻痰破积．承气赖之以先声．导水行瘀．金匮取之而下达．治痞坚之峻剂．攻气分之神丹．（枳实即枳壳之初生而未熟者．如青皮陈皮之类．性味主治皆同．而功力颇猛．故破积行血．消食消痰．皆赖之以承其气．或与补药同用．或与泻药并投．在人之运用耳．）"}]},{"ID":"20240612092818-cha46ub","Type":"NodeThematicBreak","Properties":{"id":"20240612092818-cha46ub"}},{"ID":"20240612092820-6qz1ial","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092820-6qz1ial","updated":"20240612092824"},"Children":[{"Type":"NodeText","Data":"枳实《本经逢原》"}]},{"ID":"20240612092820-htwxhlk","Type":"NodeParagraph","Properties":{"id":"20240612092820-htwxhlk","updated":"20240612092820"},"Children":[{"Type":"NodeText","Data":"辛苦平，无毒。"}]},{"ID":"20240612092820-q9vw4kq","Type":"NodeParagraph","Properties":{"id":"20240612092820-q9vw4kq","updated":"20240612092820"},"Children":[{"Type":"NodeText","Data":"《本经》止痢长肌肉，利五脏，益气轻身。"}]},{"ID":"20240612092820-t3qri41","Type":"NodeParagraph","Properties":{"id":"20240612092820-t3qri41","updated":"20240612092820"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"枳实入肝脾血分，消食泻痰，滑窍破气，心下痞及宿食不消并宜枳术。故洁古枳术丸以调脾胃，实祖《金匮》治心下坚大如盘。用枳实白术汤之法，腹即软消。洁古曰，心下痞及宿食不消发热并宜枳实、黄连。好古曰，益气则佐之以参、术、干姜，破气则佐之以大黄、芒硝，此《本经》所以言益气，而洁古复言消瘀也。李士材云，自东垣分枳壳治高，枳实治下。好古分枳壳治气，枳实治血。然究其功用皆利气也。凡气弱脾虚致停食痞满，治当补中益气，则食自化，痞自散。若用枳壳、枳实是抱薪救火也。"}]},{"ID":"20240612092808-t6wd1ke","Type":"NodeThematicBreak","Properties":{"id":"20240612092808-t6wd1ke"}},{"ID":"20240612092809-4s79idv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092809-4s79idv","updated":"20240612092814"},"Children":[{"Type":"NodeText","Data":"枳实《要药分剂》"}]},{"ID":"20240612092809-c6tmhja","Type":"NodeParagraph","Properties":{"id":"20240612092809-c6tmhja","updated":"20240612092809"},"Children":[{"Type":"NodeText","Data":"味苦。性寒。无毒。感天地苦寒之气而生。降也。阴也。"}]},{"ID":"20240612092809-4dxra80","Type":"NodeParagraph","Properties":{"id":"20240612092809-4dxra80","updated":"20240612092809"},"Children":[{"Type":"NodeText","Data":"【主治】主大风在皮肤中。如麻豆苦痒。除寒热结。止痢。利五脏。（本经）除胸胁痰癖。"}]},{"ID":"20240612092809-x80ajae","Type":"NodeParagraph","Properties":{"id":"20240612092809-x80ajae","updated":"20240612092809"},"Children":[{"Type":"NodeText","Data":"伤寒结积。去胃【归经】入脾胃二经。为破气行痰之品。（滑窍降实）【前论】凡溪曰。枳实泻痰。能冲墙倒壁。元素曰。心下痞。及宿食不消。并宜枳实黄连也。"}]},{"ID":"20240612092742-ue5fjrh","Type":"NodeThematicBreak","Properties":{"id":"20240612092742-ue5fjrh"}},{"ID":"20240612092744-pnavvjy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092744-pnavvjy","updated":"20240612092748"},"Children":[{"Type":"NodeText","Data":"枳实《本草经解》"}]},{"ID":"20240612092744-ujrqlnq","Type":"NodeParagraph","Properties":{"id":"20240612092744-ujrqlnq","updated":"20240612092744"},"Children":[{"Type":"NodeText","Data":"气寒．味苦．无毒．主大风在皮肤中如麻豆苦痒．除寒热结．止痢．长肌肉．利五脏．益气轻身．（麸炒）"}]},{"ID":"20240612092744-jvwe2se","Type":"NodeParagraph","Properties":{"id":"20240612092744-jvwe2se","updated":"20240612092744"},"Children":[{"Type":"NodeText","Data":"枳实气寒．禀天冬寒之水气．入手太阳寒水膀胱经、手太阳寒水小肠经．味苦无毒．得地南方之火味．入手少阳相火三焦．气味俱降．阴也．太阳主表．经行身表．为外藩者也．大风在皮肤中如麻豆苦痒者．皮毛患大麻风也．其主之者．枳实入太阳．苦寒清湿热也．小肠为寒水之经．丙火之腑．寒热结者．寒热之邪结于小肠也．其主之者．苦以泄结也．小肠为受盛之腑．化物出焉．受物不化．则滞而成痢．枳实苦寒下泄．所以止痢．太阴脾主肌肉．乃湿土之脏也．土湿则脾困．而肌肉不生．枳实入小肠膀胱．苦寒湿热．所以脾土燥而肌肉长也．三焦人身一大腔子也．苦寒清三焦之相火．火息则阴足．而五脏皆安也．益气者．枳实泄滞气．而正气受益也．轻身者．邪去积消．则正气流通而身轻也．"}]},{"ID":"20240612092744-vp0bn2v","Type":"NodeParagraph","Properties":{"id":"20240612092744-vp0bn2v","updated":"20240612092744"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612092744-5hhkdv8","Type":"NodeParagraph","Properties":{"id":"20240612092744-5hhkdv8","updated":"20240612092744"},"Children":[{"Type":"NodeText","Data":"枳实同白术．名枳术汤．治心下坚．水饮痞满．同白芍．治产后腹大满痛．同川芎、甘草．治左胁痛胀．"}]},{"ID":"20240612094720-d3f3kkk","Type":"NodeThematicBreak","Properties":{"id":"20240612094720-d3f3kkk"}},{"ID":"20240612092709-3ap7qy1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092709-3ap7qy1","updated":"20240612092713"},"Children":[{"Type":"NodeText","Data":"枳实《新修本草》"}]},{"ID":"20240612092709-mrl1h8r","Type":"NodeParagraph","Properties":{"id":"20240612092709-mrl1h8r","updated":"20240612092709"},"Children":[{"Type":"NodeText","Data":"味苦、酸，寒、微寒，无毒。主大风在皮肤中如麻豆苦痒，除寒热热结，止痢。长肌肉，利胸胁淡癖，逐停水，破结实，消胀满、心下急、痞痛、逆气、胁风痛，安胃气，止溏泄，明目。生河内川泽。九月、十月采，阴干。"}]},{"ID":"20240612092709-ovk2dwr","Type":"NodeParagraph","Properties":{"id":"20240612092709-ovk2dwr","updated":"20240612092709"},"Children":[{"Type":"NodeText","Data":"今处处有，采破令干。用之除中核，微炙令香，亦如橘皮，以陈者为良。枳树枝茎及皮，疗水胀、暴风、骨节疼急。"}]},{"ID":"20240612092709-kb25fq2","Type":"NodeParagraph","Properties":{"id":"20240612092709-kb25fq2","updated":"20240612092709"},"Children":[{"Type":"NodeText","Data":"枳实俗方多用，道家不须也。"}]},{"ID":"20240612092709-qycaxhb","Type":"NodeParagraph","Properties":{"id":"20240612092709-qycaxhb","updated":"20240612092709"},"Children":[{"Type":"NodeText","Data":"〔谨案〕枳实，晒干乃得，阴便湿烂也。用当去核及中瓤乃佳。"}]},{"ID":"20240612092709-avofs0u","Type":"NodeParagraph","Properties":{"id":"20240612092709-avofs0u","updated":"20240612092709"},"Children":[{"Type":"NodeText","Data":"今云用枳壳乃尔。若称枳实，须合核瓤用者，殊不然也，误矣。"}]},{"ID":"20240612093113-ztzmzqr","Type":"NodeThematicBreak","Properties":{"id":"20240612093113-ztzmzqr"}},{"ID":"20240612093114-i419ef4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093114-i419ef4","updated":"20240612093118"},"Children":[{"Type":"NodeText","Data":"枳实枳壳《本草从新》"}]},{"ID":"20240612093114-9rp2p64","Type":"NodeParagraph","Properties":{"id":"20240612093114-9rp2p64","updated":"20240612093114"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泻、破气行痰．"}]},{"ID":"20240612093114-u3j4kdb","Type":"NodeParagraph","Properties":{"id":"20240612093114-u3j4kdb","updated":"20240612093114"},"Children":[{"Type":"NodeText","Data":"苦酸微寒．皆能破气．气顺则痰行喘止．痞胀消．（脾无积血、心下不痞、浊气在上、则生胀、东垣曰∶枳实治下而主血、枳壳治上而主气．）刺痛息．后重除．治胸痹结胸．食积五膈．痰癖症结．呕逆咳嗽．水肿胁胀．泻痢淋闭．痔肿肠风．所主略同．但枳实利胸膈．"}]},{"ID":"20240612093114-xql2hb5","Type":"NodeParagraph","Properties":{"id":"20240612093114-xql2hb5","updated":"20240612093114"},"Children":[{"Type":"NodeText","Data":"枳壳宽肠胃．枳实力猛．（丹溪曰∶枳实泻痰、能冲墙倒壁．）枳壳力缓为少异．（时珍曰∶壳实、上世未分、魏晋始分用、洁古东垣始分壳治上、实治下、海藏始分壳主气、实主血、然仲景治上焦胸痹痞满、用枳实、古方治下血痢痔、肠秘后重、用枳壳、则实不独治下、而壳不独治上也、盖自飞门至魄门、皆肺主之、三焦相通、一气而已．）大损真元．胀满因于邪实者可用．若因土虚不能制水．肺虚不能行气．而误用之．则祸不旋踵．气弱脾虚．以致停食痞满．法当补中益气．则食自化痞自消．若再用此破气．是抱薪救火矣．孕妇虚者尤忌．（元素曰∶枳壳泄气、走大肠、损胸中至高之气．昔湖阳公主难产、方士进瘦胎饮、用枳壳四两、甘草二两、五月后日服一钱、洁古改以枳术、名束胎丸、寇宗 明其不然、盖孕妇全赖血气以养胎、血气充实、胎乃易生、彼公主奉养太过、气实有余、故可服之、若概施则误矣．吕用晦曰∶瘦胎束胎名目、亦启粗工攻伐之门．时珍曰∶八九月胎气盛、壅滞用枳壳苏梗以顺气、胎前无滞、则产后无虚也、气弱者、大非所宜矣．）皮浓而小为枳实．"}]},{"ID":"20240612093114-nzuuswu","Type":"NodeParagraph","Properties":{"id":"20240612093114-nzuuswu","updated":"20240612093114"},"Children":[{"Type":"NodeText","Data":"壳薄虚大为枳壳．陈者良．麸炒用．（今人于六七月采小香栾、伪为枳实枳壳、又有采枸橘伪为者．）"}]},{"ID":"20240612093101-srz4r2r","Type":"NodeThematicBreak","Properties":{"id":"20240612093101-srz4r2r"}},{"ID":"20240612093102-39yi6ca","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093102-39yi6ca","updated":"20240612093106"},"Children":[{"Type":"NodeText","Data":"枳实《汤液本草》"}]},{"ID":"20240612093102-75jwv7g","Type":"NodeParagraph","Properties":{"id":"20240612093102-75jwv7g","updated":"20240612093102"},"Children":[{"Type":"NodeText","Data":"气寒，味苦、酸、咸，纯阳。无毒。"}]},{"ID":"20240612093102-n40qh89","Type":"NodeParagraph","Properties":{"id":"20240612093102-n40qh89","updated":"20240612093102"},"Children":[{"Type":"NodeText","Data":"《象》云∶除寒热，破结实，消痰癖，治心下痞，逆气胁痛。麸炒用。"}]},{"ID":"20240612093102-dd3i5ru","Type":"NodeParagraph","Properties":{"id":"20240612093102-dd3i5ru","updated":"20240612093102"},"Children":[{"Type":"NodeText","Data":"《心》云∶洁古用去脾经积血。故能去心下痞，脾无积血，则心下不痞。治心下痞，散气消宿食。苦寒，炙用，破水积，以泄里除气。"}]},{"ID":"20240612093102-m2qwrs6","Type":"NodeParagraph","Properties":{"id":"20240612093102-m2qwrs6","updated":"20240612093102"},"Children":[{"Type":"NodeText","Data":"《珍》云∶去胃中湿。"}]},{"ID":"20240612093102-srkyg8u","Type":"NodeParagraph","Properties":{"id":"20240612093102-srkyg8u","updated":"20240612093102"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主大风在皮肤中，如麻豆，苦痒。除寒热结，止痢，长肌肉，利五脏，益气轻身。除胸胁痰癖，逐停水，破结实，消胀满，心下急，痞痛，逆气，胁风痛。安胃气，止溏泄，明目。生河内川泽，商州者，佳。益气，则佐之以人参、干姜、白术。破气，则佐之以大黄、牵牛、芒硝。此《本经》所以言益气，而复言消痞也。非白术，不能去湿；非枳实，不能除痞。壳主高而实主下。高者主气；下者主血。主气者，在胸膈；主血者，在心腹。仲景治心下坚大如盘，水饮所作，枳实白术汤主之。枳实七枚，术三两，水一斗，煎取三升，分三服。腹中软即消。"}]},{"ID":"20240612093102-rfpxtfw","Type":"NodeParagraph","Properties":{"id":"20240612093102-rfpxtfw","updated":"20240612093102"},"Children":[{"Type":"NodeText","Data":"《衍义》云∶枳实、枳壳，一物也。小即性酷而速，大则性详而缓。故仲景治伤寒仓卒之病，承气汤中用枳实，此其意也。皆取其疏通决泄，破结实之意。他方但导败风壅之气，可常用者，故用枳壳。故胸中痞，有桔梗枳壳汤；心下痞，有枳实白术汤。高低之分，易老详定为的也。"}]},{"ID":"20240612093051-nsrwyvf","Type":"NodeThematicBreak","Properties":{"id":"20240612093051-nsrwyvf"}},{"ID":"20240612093052-x0qc5ej","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093052-x0qc5ej","updated":"20240612093056"},"Children":[{"Type":"NodeText","Data":"枳实《本草崇原》"}]},{"ID":"20240612093052-1ojf0ek","Type":"NodeParagraph","Properties":{"id":"20240612093052-1ojf0ek","updated":"20240612093052"},"Children":[{"Type":"NodeText","Data":"气味苦寒，无毒。主治大风在皮肤中，如麻豆苦痒，除寒热结，止痢，长肌肉，利五脏，益气，轻身。"}]},{"ID":"20240612093052-ch8wjja","Type":"NodeParagraph","Properties":{"id":"20240612093052-ch8wjja","updated":"20240612093052"},"Children":[{"Type":"NodeText","Data":"（枳实出河内洛西及江湖州郡皆有。近时出于江西者为多，其木如橘而小，高五七尺，叶如橙，多刺，春开白花结实，至秋始成。《周礼》云∶橘逾淮而北为枳，今江南枳橘皆有，江北有枳无橘，此是种类各别，非逾淮而变也。七八月采者为枳实，九十月采者为枳壳。愚按∶实者乃果实之通称，言实壳亦在其中矣。）"}]},{"ID":"20240612093052-oay9ayl","Type":"NodeParagraph","Properties":{"id":"20240612093052-oay9ayl","updated":"20240612093052"},"Children":[{"Type":"NodeText","Data":"枳实气味苦寒，冬不落叶，禀少阴标本之气化，臭香形圆，花白多刺，穣肉黄白。又得阳明金土之气化，主治大风在皮肤中。如麻豆苦痒者，得阳明金气而制风，禀少阴水气而清热也。除寒热结者，禀少阴本热之气而除寒，标阴之气而除热也。止痢，长肌肉者，得阳明中土之气也。五脏发原于先天之少阴，生长于后天之阳明，故主利五脏，得少阴之阴，故益气，得阳明之气，故轻身。"}]},{"ID":"20240612093052-58fe0pt","Type":"NodeParagraph","Properties":{"id":"20240612093052-58fe0pt","updated":"20240612093052"},"Children":[{"Type":"NodeText","Data":"仲祖本论，有大承气汤，用炙浓朴，炙枳实。小承气汤，用生浓朴，生枳实，生熟之间，有意存焉。学人不可不参。"}]},{"ID":"20240612093036-s32gkzz","Type":"NodeThematicBreak","Properties":{"id":"20240612093036-s32gkzz"}},{"ID":"20240612093037-zzwbe2v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612093037-zzwbe2v","updated":"20240612093041"},"Children":[{"Type":"NodeText","Data":"枳实《本草蒙筌》"}]},{"ID":"20240612093037-n28zs65","Type":"NodeParagraph","Properties":{"id":"20240612093037-n28zs65","updated":"20240612093037"},"Children":[{"Type":"NodeText","Data":"味苦、酸，气寒。味薄气浓，阴也，阴中微阳。无毒。商州（属河南）所生，似橘极小。择如鹅眼，色黑陈者良。（近道亦生。一种俗呼臭橘，其皮微绿，不堪药用。今市家每采指为绿衣者，欺世谋利无益有损。故凡入药剂，必求黑色为真也。）剜净内瓤，锉片麸炒用。本与枳壳一物，因收迟早异名。枳实秋收，枳壳冬采。今医者不以此泥，惟视皮浓小者实，完大者为壳也。壳大则性详而缓治高，高者主气，治在胸膈；实小则性酷而速治下，下者主血，治在心腹。故胸中痞，肺气结也，有桔梗枳壳汤之煎；心下痞，脾血积也，有白术枳实汤之用。（白术补脾，枳实去脾经积血，脾无积血，则不痞也。）此高下缓急之分，易老详定以为准的也。除胀满，消宿食，削坚积，化稠痰。破气佐牵牛大黄芒硝，益气佐人参干姜白术。仲景加承气汤内，取疏通破结之功。丹溪入泻痰药中，有倒壁冲墙之捷。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树皮"},{"Type":"NodeText","Data":"治风中身直，久不能屈伸。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根皮"},{"Type":"NodeText","Data":"主痔来红，及肠风脏毒。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"树茎"},{"Type":"NodeText","Data":"并皮收采，水胀风痛齐驱。其大"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳壳"},{"Type":"NodeText","Data":"，亦贵陈年。取翻肚如盆口唇，制剜瓤锉片麸炒。"}]},{"ID":"20240612093037-f796jnw","Type":"NodeParagraph","Properties":{"id":"20240612093037-f796jnw","updated":"20240612093037"},"Children":[{"Type":"NodeText","Data":"泻肺脏，宽大肠。结气胸中，两胁关节并利；破痰癖积聚，宿食亦推。同甘草瘦胎，（即枳壳散。）和黄连灭痔。（即连壳丸。）能损至高之气，不宜接迹服多。虚怯劳伤，尤当全禁。"}]},{"ID":"20240612093037-xz7t0bv","Type":"NodeParagraph","Properties":{"id":"20240612093037-xz7t0bv","updated":"20240612093037"},"Children":[{"Type":"NodeText","Data":"第七卷青橘皮款后（谟）按∶宜参看。"}]},{"ID":"20240612092550-lqtqnaj","Type":"NodeThematicBreak","Properties":{"id":"20240612092550-lqtqnaj"}},{"ID":"20240612092657-mztabk4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092657-mztabk4","updated":"20240612092702"},"Children":[{"Type":"NodeText","Data":"枳实《神农本草经读》"}]},{"ID":"20240612092657-u5o7dfy","Type":"NodeParagraph","Properties":{"id":"20240612092657-u5o7dfy","updated":"20240612092657"},"Children":[{"Type":"NodeText","Data":"气味苦、寒，无毒。主大风在皮肤中，如麻豆苦痒，除寒热结，止痢，长肌肉，利五脏，益气。"}]},{"ID":"20240612092657-2oeuq74","Type":"NodeParagraph","Properties":{"id":"20240612092657-2oeuq74","updated":"20240612092657"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶枳壳气味苦寒，冬不落叶，禀少阴标本之气化。臭香形园，花白多刺，瓤肉黄白，又得阳明金土之气化。主治大风在皮肤中，如麻豆苦痒者，得阳明金气而制风，禀少阴水气而清热也。除寒热结者，禀少阴本热之气而除寒，标阴之气而除热也。止痢、长肌肉者，得阳明中土之气也。五脏发原于先天之少阴，生长于后天之阳明，故主利五脏。得少阴之阴故益气，得阳明之气故轻身。仲祖本论，有大承气汤，用炙浓朴、炙枳实；小承气汤，用生浓朴、生枳实；生熟之间，有意存焉，学人不可不参。"}]},{"ID":"20240612092657-ibb4z88","Type":"NodeParagraph","Properties":{"id":"20240612092657-ibb4z88","updated":"20240612092657"},"Children":[{"Type":"NodeText","Data":"按《本经》有枳实，无枳壳，唐《开宝》始分之。然枳壳即枳实之大者，性宣发而气散，不如枳实之完结，然既是一种，亦不必过分。"}]},{"ID":"20240612092550-stzbgyw","Type":"NodeThematicBreak","Properties":{"id":"20240612092550-stzbgyw"}},{"ID":"20240612092548-elvqt80","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092548-elvqt80","updated":"20240612092559"},"Children":[{"Type":"NodeText","Data":"枳实《中药学》"}]},{"ID":"20240612092548-6ovqk6y","Type":"NodeParagraph","Properties":{"id":"20240612092548-6ovqk6y","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【药用】云相科小聊木酸橙CitrusaurantiumL.及其摘陪变种或甜橙C.sinensis Osbeck的幼果。"}]},{"ID":"20240612092548-zdasn1g","Type":"NodeParagraph","Properties":{"id":"20240612092548-zdasn1g","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，微寒。归脾、胃、大肠经。"}]},{"ID":"20240612092548-jjkuysm","Type":"NodeParagraph","Properties":{"id":"20240612092548-jjkuysm","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【功效】行气除胀满，化痰开痹，消积导滞。"}]},{"ID":"20240612092548-7n8cfjy","Type":"NodeParagraph","Properties":{"id":"20240612092548-7n8cfjy","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于胸腹胀满"}]},{"ID":"20240612092548-xks1ifr","Type":"NodeParagraph","Properties":{"id":"20240612092548-xks1ifr","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"枳实理气行气作用较强，故一般认为本品有破气作用，功用行气滞、除胀满，用于胸腹胀满，常与木香、橘皮等同用。此外，对食积不化、脘腹胀满者，可配山渣、神曲等同用；脾虚而见脘腹胀满闷塞者，常配合白朮同用；对病后劳复、身热、心下痞闷者，可配栀子、豆豉等同用；寒凝气滞而见胃痛者，可配合橘皮、生姜同用。"}]},{"ID":"20240612092548-kee0tub","Type":"NodeParagraph","Properties":{"id":"20240612092548-kee0tub","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"2.用于胸痹结胸，以及痰多咳嗽，风痰眩晕等症。"}]},{"ID":"20240612092548-agc85zf","Type":"NodeParagraph","Properties":{"id":"20240612092548-agc85zf","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"本品既能理气，又能化痰，对痰湿遏阻胸阳、胸阳不振、胸痹疼痛，可配瓜蒌，薤白、桂枝等品同用；用治痰热互结、胸痞按之疼痛，可配黄连、瓜蒌等同用；对于痰多咳嗽、风痰眩晕等可配陈皮、半夏、天麻等同用。"}]},{"ID":"20240612092548-e70cs44","Type":"NodeParagraph","Properties":{"id":"20240612092548-e70cs44","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"3.用于食积停滞、便秘腹痛及泻痢不畅、里急后重等症。"}]},{"ID":"20240612092548-i31f5nm","Type":"NodeParagraph","Properties":{"id":"20240612092548-i31f5nm","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"枳实苦降下行，功能消积导滞，治便秘腹痛，常配合大黄、厚朴等同用；治泻痢后重，常配合木香、槟榔等同用。"}]},{"ID":"20240612092548-slllcrt","Type":"NodeParagraph","Properties":{"id":"20240612092548-slllcrt","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"此外，本品还可用于胃下垂、脱肛、子宫脱垂等症，宜与补气生阳之品同用；近年来发现本品又有升压作用，可用于休克。"}]},{"ID":"20240612092548-ub0h8ka","Type":"NodeParagraph","Properties":{"id":"20240612092548-ub0h8ka","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【处方用名】枳实、江枳实、生枳实（生用作用较猛）、炒枳实（麸皮炒至为焦为度）"}]},{"ID":"20240612092548-i2cktna","Type":"NodeParagraph","Properties":{"id":"20240612092548-i2cktna","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"枳实炭（清炒至外成焦黑色）"}]},{"ID":"20240612092548-cteyl35","Type":"NodeParagraph","Properties":{"id":"20240612092548-cteyl35","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240612092548-u6fvtwf","Type":"NodeParagraph","Properties":{"id":"20240612092548-u6fvtwf","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【附药】枳壳：及云香科小桥木香橼、酸橙等植物的成熟果实。性味效用与枳实相似，但力薄性缓，以行气宽中除胀为主，适用于胸胁胀痛、脘腹痞闷为主。一般用量一钱至三钱，煎服。"}]},{"ID":"20240612092548-zb5ntby","Type":"NodeParagraph","Properties":{"id":"20240612092548-zb5ntby","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【按语】1.枳实苦而微寒，入脾、胃、大肠经，苦泄力大，行气力强，故为破气之药，性沉降而下行，功能理气除痞，以除胸腹痞满，兼能化痰以开痹，消积以导滞，实乃破气结之峻剂，治痞满、导积滞之要药。又具升高血压之能，治阴挺脱肛之用。"}]},{"ID":"20240612092548-401n55i","Type":"NodeParagraph","Properties":{"id":"20240612092548-401n55i","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"2.枳实与枳壳皆为果实，因老幼不同而区分。两者功效略同，但枳实力强枳壳力缓。破气除痞，消积导滞多用枳实；理气宽中消胀除满多用枳壳。"}]},{"ID":"20240612092548-yu7539l","Type":"NodeParagraph","Properties":{"id":"20240612092548-yu7539l","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"3.厚朴与枳实行气导滞常配合应用，但厚朴苦辛性温，行气力缓，长于燥湿散满，且能下气平喘；枳实味苦性寒，破气力强，长于化痰除痞，且有消积导滞作用。"}]},{"ID":"20240612092548-2x9j79c","Type":"NodeParagraph","Properties":{"id":"20240612092548-2x9j79c","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【方剂举例】枳实导滞丸（《内外伤辨惑论》）：枳实、白朮、黄芩、泽泻、茯苓、大黄、六曲。治脾胃湿热，胸闷腹痛，积滞泄泻。"}]},{"ID":"20240612092548-83rvw2w","Type":"NodeParagraph","Properties":{"id":"20240612092548-83rvw2w","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"枳朮丸（《内外伤辨惑论》）：枳实、白朮。治脾胃虚，运化弱，食后脘腹痞满作胀者。"}]},{"ID":"20240612092548-9y4fc5p","Type":"NodeParagraph","Properties":{"id":"20240612092548-9y4fc5p","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"小结胸加枳实汤（《温病条辨》）：黄连、瓜蒌、枳实。治阳明暑温，水结在胸，面赤身热头晕，渴欲凉饮，得水则呕，按之胸下痛。"}]},{"ID":"20240612092548-vne18k3","Type":"NodeParagraph","Properties":{"id":"20240612092548-vne18k3","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"导痰汤（《济生方》）：半夏、橘红、枳实、茯苓、甘草、人参、远志、酸枣仁、北五味、熟地。治心虚胆怯，短气乏力，心烦不眠，惊悸或癫狂等。"}]},{"ID":"20240612092548-h9ojcqn","Type":"NodeParagraph","Properties":{"id":"20240612092548-h9ojcqn","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本草衍义》：「枳实、枳壳，一物也。小则其性酷而速，大则其性和而缓也。」"}]},{"ID":"20240612092548-2fn7ei6","Type":"NodeParagraph","Properties":{"id":"20240612092548-2fn7ei6","updated":"20240612092548"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：「枳乃木名，实乃其子，故曰枳实。后人因小者性速，又呼老者为枳壳。生则皮厚而实，熟则壳薄而虚，正如青橘皮、陈橘皮之意，宋人复出枳壳一条，非矣。寇氏以为破结实而名，亦未必然。」"}]},{"ID":"20240612092535-j22s5mo","Type":"NodeThematicBreak","Properties":{"id":"20240612092535-j22s5mo"}},{"ID":"20240612092536-1lzrqsm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092536-1lzrqsm","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"《中国药典》：枳实"}]},{"ID":"20240612092536-gx19qc8","Type":"NodeParagraph","Properties":{"id":"20240612092536-gx19qc8","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612092536-cn5wiv6","Type":"NodeParagraph","Properties":{"id":"20240612092536-cn5wiv6","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" Zhǐ Shí"}]},{"ID":"20240612092536-c52opkl","Type":"NodeParagraph","Properties":{"id":"20240612092536-c52opkl","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612092536-mwaxor0","Type":"NodeParagraph","Properties":{"id":"20240612092536-mwaxor0","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" FRUCTUS AURANTII IMMATURUS"}]},{"ID":"20240612092536-r1fck1c","Type":"NodeParagraph","Properties":{"id":"20240612092536-r1fck1c","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612092536-kxopb49","Type":"NodeParagraph","Properties":{"id":"20240612092536-kxopb49","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 本品为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"酸橙"},{"Type":"NodeText","Data":"Citrus aurantium L. 及其栽培变种或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"甜橙"},{"Type":"NodeText","Data":"Citrus sinensis Osbeck 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼果"},{"Type":"NodeText","Data":"。5～6月收集自落的果实，除去杂质，自中部横切为两半，晒干或低温干燥，较小者直接晒干或低温干燥。"}]},{"ID":"20240612092536-alkjp3p","Type":"NodeParagraph","Properties":{"id":"20240612092536-alkjp3p","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612092536-kb9qjkk","Type":"NodeParagraph","Properties":{"id":"20240612092536-kb9qjkk","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 本品呈半球形，少数为球形，直径0.5～2.5cm。外果皮黑绿色或暗棕绿色，具颗粒状突起和皱纹，有明显的花柱残迹或果梗痕。切面中果皮略隆起，黄白色或黄褐色，厚0.3～1.2cm，边缘有1～2列油室，瓤囊棕褐色。质坚硬。气清香，味苦、微酸。"}]},{"ID":"20240612092536-tghqpij","Type":"NodeParagraph","Properties":{"id":"20240612092536-tghqpij","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612092536-uebw4bp","Type":"NodeParagraph","Properties":{"id":"20240612092536-uebw4bp","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防蛀。"}]},{"ID":"20240612092536-6gf0ld8","Type":"NodeParagraph","Properties":{"id":"20240612092536-6gf0ld8","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612092536-oaixkm8","Type":"NodeParagraph","Properties":{"id":"20240612092536-oaixkm8","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枳实"},{"Type":"NodeText","Data":"：除去杂质，洗净，润透，切薄片，干燥。本品为不规则弧状条形或圆形薄片，条片长达2.5cm，宽达1.2cm，圆片直径0.3～1.5cm。切面外果皮黑绿色至暗棕色，中果皮部分黄白色至黄棕色，近外缘有1～2列点状油室，条片内侧或圆片中央具棕褐色瓤囊。"}]},{"ID":"20240612092536-1uluyis","Type":"NodeParagraph","Properties":{"id":"20240612092536-1uluyis","updated":"20240612092536"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"麸炒枳实"},{"Type":"NodeText","Data":"：取枳实片，照麸炒法（附录Ⅱ D）炒至色变深。本品为不规则弧状条形或圆形薄片，色较深，有的有焦斑。"}]},{"ID":"20240612092536-tub4g69","Type":"NodeParagraph","Properties":{"id":"20240612092536-tub4g69","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612092536-t15j8vn","Type":"NodeParagraph","Properties":{"id":"20240612092536-t15j8vn","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末淡黄色或棕黄色。中果皮细胞类圆形或形状不规则，壁大多呈不均匀增厚。果皮表皮细胞表面观多角形、类方形或长方形，气孔近环式，直径18～26μｍ，副卫细胞5～9个；侧面观外被角质层。草酸钙方晶存在于果皮和汁囊细胞中，呈斜方形、多面形或双锥形，直径2～24μm。橙皮苷结晶存在于薄壁细胞中，黄色或无色，呈圆形或无定形团块，有的显放射状纹理。油室碎片多见，分泌细胞狭长而弯曲。螺纹、网纹导管和管胞细小。"}]},{"ID":"20240612092536-aq2haaf","Type":"NodeParagraph","Properties":{"id":"20240612092536-aq2haaf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末0.5g，加甲醇10ml，加热回流10分钟，滤过。取滤液1ml,加四氢硼钾约5mg，摇匀，加盐酸数滴，溶液显樱红色至紫红色。"}]},{"ID":"20240612092536-i231vfp","Type":"NodeParagraph","Properties":{"id":"20240612092536-i231vfp","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"（3） 取本品粉末0.5g，加甲醇10ml，超声处理20分钟，滤过，滤液蒸干，残渣加甲醇0.5ml使溶解，作为供试品溶液。另取辛弗林对照品，加甲醇制成每1ml含0.5mg的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各2μl，分别点于同一以含1％氢氧化钠的羧甲基纤维素钠溶液为黏合剂的硅胶G薄层板上，以正丁醇－冰醋酸－水（4:1:5）的上层溶液为展开剂，展开，取出，晾干，喷以0.5％茚三酮乙醇溶液，在105℃加热至斑点显色清晰。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的斑点。"}]},{"ID":"20240612092536-rumkb0t","Type":"NodeParagraph","Properties":{"id":"20240612092536-rumkb0t","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612092536-q45wc95","Type":"NodeParagraph","Properties":{"id":"20240612092536-q45wc95","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 归脾、胃经。"}]},{"ID":"20240612092536-d796wsz","Type":"NodeParagraph","Properties":{"id":"20240612092536-d796wsz","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612092536-c2zgfrj","Type":"NodeParagraph","Properties":{"id":"20240612092536-c2zgfrj","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 苦、辛、酸，温。"}]},{"ID":"20240612092536-mbukqqu","Type":"NodeParagraph","Properties":{"id":"20240612092536-mbukqqu","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612092536-oa1l20q","Type":"NodeParagraph","Properties":{"id":"20240612092536-oa1l20q","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 孕妇慎用。"}]},{"ID":"20240612092536-ubky00b","Type":"NodeParagraph","Properties":{"id":"20240612092536-ubky00b","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612092536-jr881q3","Type":"NodeParagraph","Properties":{"id":"20240612092536-jr881q3","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 破气消积，化痰散痞。用于积滞内停，痞满胀痛，泻痢后重，大便不通，痰滞气阻胸痹，结胸；胃下垂，脱肛，子宫脱垂。"}]},{"ID":"20240612092536-l95d37m","Type":"NodeParagraph","Properties":{"id":"20240612092536-l95d37m","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612092536-15vnd4z","Type":"NodeParagraph","Properties":{"id":"20240612092536-15vnd4z","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 3～9g。"}]},{"ID":"20240612092536-i8amdk1","Type":"NodeParagraph","Properties":{"id":"20240612092536-i8amdk1","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612092536-u6bk7ko","Type":"NodeParagraph","Properties":{"id":"20240612092536-u6bk7ko","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612092536-1qqq9i9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092536-1qqq9i9","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：枳实"}]},{"ID":"20240612092536-1rcn86m","Type":"NodeParagraph","Properties":{"id":"20240612092536-1rcn86m","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612092536-7jkorl1","Type":"NodeParagraph","Properties":{"id":"20240612092536-7jkorl1","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" Zhǐ Shí"}]},{"ID":"20240612092536-i2hxo65","Type":"NodeParagraph","Properties":{"id":"20240612092536-i2hxo65","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612092536-uiir4b6","Type":"NodeParagraph","Properties":{"id":"20240612092536-uiir4b6","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612092536-zlzyuoz","Type":"NodeParagraph","Properties":{"id":"20240612092536-zlzyuoz","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612092536-a8wiqh2","Type":"NodeParagraph","Properties":{"id":"20240612092536-a8wiqh2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 为芸香科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"枸橘、酸橙"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"香圆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幼果"},{"Type":"NodeText","Data":"。5～6月间摘取，晒干；略大者横切成两半，晒干。"}]},{"ID":"20240612092536-k1wk5ga","Type":"NodeParagraph","Properties":{"id":"20240612092536-k1wk5ga","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612092536-d56dn15","Type":"NodeParagraph","Properties":{"id":"20240612092536-d56dn15","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" ①枸橘，详\"枸橘\"条。"}]},{"ID":"20240612092536-b9xdep1","Type":"NodeParagraph","Properties":{"id":"20240612092536-b9xdep1","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②酸橙"}]},{"ID":"20240612092536-tfqu3qz","Type":"NodeParagraph","Properties":{"id":"20240612092536-tfqu3qz","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"小乔木。茎枝三棱形，光滑，有长刺，长5～20毫米。叶退化成单叶状，互生，革质；叶柄有狭长形或倒心脏形的翼，长0.8～1.5厘米，宽3～6毫米；叶片长椭圆形，长5～8厘米，宽2.5～4厘米，先端短而钝，渐尖，或微凹头，基部阔楔形或钝圆形，全缘或有不明显的波状锯齿，两面无毛而有油点，背脉明显。花排列成总状花序，亦有单生或簇生于叶腋内；花萼皿状，5裂，裂片阔三角状，外面疏被短毛；花瓣5，白色，长椭圆形，长约1.8厘米，宽6～7毫米，略反卷；雄蕊多数，在20以上，花丝分离，长出于柱头；子房上位，球形，约12室，每室内含胚珠多数，花柱圆柱形，柱头头状。柑果圆形而稍扁，成熟时橙黄色，果皮粗糙，花期4～5月。11月果熟。"}]},{"ID":"20240612092536-rbk5t12","Type":"NodeParagraph","Properties":{"id":"20240612092536-rbk5t12","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"野生或栽培。分布江苏、浙江、广东、贵州、四川、江西等地。"}]},{"ID":"20240612092536-i2otmla","Type":"NodeParagraph","Properties":{"id":"20240612092536-i2otmla","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"本植物的将近成熟果实（枳壳）亦供药用，另详专条。"}]},{"ID":"20240612092536-xz592gy","Type":"NodeParagraph","Properties":{"id":"20240612092536-xz592gy","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③香圆，详\"香橼\"条。"}]},{"ID":"20240612092536-4u4y7qb","Type":"NodeParagraph","Properties":{"id":"20240612092536-4u4y7qb","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612092536-vf11fzt","Type":"NodeParagraph","Properties":{"id":"20240612092536-vf11fzt","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" ①绿衣枳实"}]},{"ID":"20240612092536-hfbdiex","Type":"NodeParagraph","Properties":{"id":"20240612092536-hfbdiex","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"为植物枸橘的幼果，呈圆球形，直径2～3厘米，商品多横切成半球形。果实表面绿黄色，散有众多小油点及微隆起的皱纹，被有细柔毛。顶端有明显的花柱基，基部有短果柄或果柄脱落后的痕迹。横断面果皮厚3～6毫米，边缘外侧散有1～2列棕黄色油点，瓤囊6～8瓣，囊内汁胞干缩，呈棕褐色:近成熟的果实内每瓤内有种子数粒，呈长椭圆形；中心柱坚实，宽4～6毫米，约占断面直径的1／6。气香，汁胞味微酸苦。"}]},{"ID":"20240612092536-gx3qtpw","Type":"NodeParagraph","Properties":{"id":"20240612092536-gx3qtpw","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"产福建、陕西、广西等地。"}]},{"ID":"20240612092536-embqg9t","Type":"NodeParagraph","Properties":{"id":"20240612092536-embqg9t","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②酸橙枳实"}]},{"ID":"20240612092536-ffqytzz","Type":"NodeParagraph","Properties":{"id":"20240612092536-ffqytzz","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"为植物酸橙的幼果，完整者呈圆球形，直径0.3～3厘米。外表灰绿色或黑绿色，密被多数油点及微隆起的皱纹，并散有少数不规则的黄白色小斑点。顶端微凸出，基部有环状果柄的痕迹。横切面中果皮光滑，淡黄棕色，厚3～7毫米，外果皮下方散有1～2列点状油室，果皮不易剥离；中央褐色，有7～12瓤囊，每瓤内含种子约10粒:中心柱径宽2～3毫米。有强烈的香气，味苦而后微酸。"}]},{"ID":"20240612092536-fmhjacz","Type":"NodeParagraph","Properties":{"id":"20240612092536-fmhjacz","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"主产四川、江西、浙江。此外，广西、湖南等地亦产。产四川者称川枳实，产江西者称江枳实。"}]},{"ID":"20240612092536-pnkbqla","Type":"NodeParagraph","Properties":{"id":"20240612092536-pnkbqla","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③香圆枳实"}]},{"ID":"20240612092536-3o0vwh2","Type":"NodeParagraph","Properties":{"id":"20240612092536-3o0vwh2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"为植物香圆的幼果，呈球形、矩圆形或倒卵球形，商品多剖成二半，直径0.5～3厘米。较小的幼果表面密被黄白色的绒毛，渐大则渐秃净而粗糙，灰红棕色或暗棕绿色，有时可见不规则的黄白龟斑点，并密生多数油点及网状隆起的粗皱纹。大的果实顶端有环状的金钱环，基部有环状的果柄痕迹。横切面中果皮粗糙，黄白色，厚4～8毫米，外果皮下方散有1～2列点状的油室，果皮不易剥离；中央棕褐色，有10～12瓤囊，每瓤内有种子数枚；中心柱径宽2～5毫米。有强烈的香气，味酸而后苦。主产江西、四川等地。商品枳实除上述三种外，尚有以甜橙（福建）；枸橼（云南）；柚（广西、陕西、四川、江西）等的幼果作枳实用。参见\"甜橙\"、\"香橼\"、\"柚\"条。"}]},{"ID":"20240612092536-meo3kry","Type":"NodeParagraph","Properties":{"id":"20240612092536-meo3kry","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612092536-00cbe7t","Type":"NodeParagraph","Properties":{"id":"20240612092536-00cbe7t","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 置阴凉干燥处，防蛀。"}]},{"ID":"20240612092536-bqcevi9","Type":"NodeParagraph","Properties":{"id":"20240612092536-bqcevi9","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612092536-hkb2kpc","Type":"NodeParagraph","Properties":{"id":"20240612092536-hkb2kpc","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 枸橘和橘属植物的果皮均含挥发油，且多含黄酮甙等。川枳实含生物碱0.09％、甙类20.49％，皂甙5.86％。酸橙幼果中含维生素C-23.2～60.3毫克％；其未熟果实的果皮中，含新橙皮甙5.6～14.18％、柚皮甙1.5～4.0％、野漆树甙和忍冬甙等黄酮甙（当果实成熟时新橙皮甙消失）。"}]},{"ID":"20240612092536-6gu3buj","Type":"NodeParagraph","Properties":{"id":"20240612092536-6gu3buj","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612092536-dpxmhqf","Type":"NodeParagraph","Properties":{"id":"20240612092536-dpxmhqf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" ①对子宫的作用"}]},{"ID":"20240612092536-wuf8hl2","Type":"NodeParagraph","Properties":{"id":"20240612092536-wuf8hl2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"用三个不同产地（四川、江西、湖南）的枳壳和枳实煎液，对小鼠离体子宫（已孕及未孕）皆呈抑制作用；对兔在体和离体子宫（已孕及未孕）皆为兴奋。对兔子宫瘘亦证明能使子宫收缩有力，张力增加，甚至出现强直收缩。枳壳酊和枳壳流浸膏，对兔子宫（在体和离体）也有兴奋作用；对小鼠子宫（离体）则抑制。自香圆枳壳和枸橘中分离出的一种生物碱样物质，对兔离体子宫也有一定收缩作用，尤以垂体后叶素兴奋过的子宫肌更显着:除去生物碱的部分，对兔离体子宫却有松弛作用，经垂体后叶素兴奋后，子宫的弛缓作用更明显。从枳实果皮中分离出的Cirantin，能抑制卵巢周围透明质酸酶的活性，这可能与其避孕作用有关（阻止受精）。"}]},{"ID":"20240612092536-fzvewzb","Type":"NodeParagraph","Properties":{"id":"20240612092536-fzvewzb","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②对肠管的影响"}]},{"ID":"20240612092536-4olbqo5","Type":"NodeParagraph","Properties":{"id":"20240612092536-4olbqo5","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"三个不同产地的枳壳和枳实，对小鼠和兔的离体肠管皆呈抑制；兔在体肠管多数为抑制，少数无变化。枳壳酊及其流浸膏，对小鼠（离体）、兔（在体和离体）肠管均抑制。高浓度（1:1000）对离体兔、豚鼠小肠均呈抑制，且能抑制乙酰胆碱、组织胺之作用；低浓度（1:10000）则在短暂抑制后，可呈现兴奋作用，振幅加大，频率加快。麻醉犬的在位肠，用煎剂也有明显抑制；但对胃肠造瘘的犬，则呈一定兴奋作用，能使胃肠运动收缩节律有力。"}]},{"ID":"20240612092536-oh57vx0","Type":"NodeParagraph","Properties":{"id":"20240612092536-oh57vx0","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③对心、血管的作用"}]},{"ID":"20240612092536-nuro0r2","Type":"NodeParagraph","Properties":{"id":"20240612092536-nuro0r2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"对蟾蜍离体心是小量兴奋，大量抑制。枳壳和枳实水煎液，枳壳酊与流浸膏皆如此。用枳壳煎液或醇提液给犬静脉注射，可致显著升压作用。三个不同产地的枳壳和枫实煎液，用蟾蜍全身血管灌溉法证明，有轻度收缩血管的作用；对麻醉犬，有显著而迅速的升压作用，它没有肾上腺素升压时引起的\"呼吸抑制\"、\"后降压\"现象，心率亦无明显增快。升压机理与下列因素有关:㈠兴奋α受体，致部分器官血管收缩（苯胺唑啉可将\"升压\"翻转为\"降压\"反应）；㈡心肌收缩加强，心输出量增加（豚鼠离体心脏灌流及心肺制备）。利血平化后，枳实的升压作用更加显著。对麻醉狗枳实有非常显著的增加冠脉流量的作用（气泡流量计，冠脉流量可增加289.4％），脑、肾血流量亦平均增加86.4％及64.5％，与去甲肾上脓素有显著不同；股动脉血流量则有减少，心肌耗氧量略有增加，但不明显，与冠脉流量的显著增加不相平行。在犬及豚鼠的心电图试验中，大剂量枳实引起的心律紊乱（室性心动过速或房室传导阻滞）并不严重，根据以上作用特点，有人建议可用于治疗心源性休克。自香圆枳壳和枸橘中分离的生物碱亦能使血管平滑肌的紧张度有短暂增强，尤其当垂体后叶素作用后更明显。"}]},{"ID":"20240612092536-qn0ddvm","Type":"NodeParagraph","Properties":{"id":"20240612092536-qn0ddvm","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240612092536-e9226qh","Type":"NodeParagraph","Properties":{"id":"20240612092536-e9226qh","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"柑橙属植物粘胶质能使大鼠（用含胆甾醇的饲料喂养）的血清及肝中胆甾醇含量降低。枳实的醇浸液在试管内对结核杆菌H27Rv有抑制作用，其抑菌浓度为1:1000。其水煎剂对豚鼠灾气管无影响。有人报告，柑柚属的果汁能促进（面包）酵母菌之发酵速度，煮沸后活性并不下降，故非酶成分橘汁主要之医疗用途在其含有丰富的维生素C，并含相当量的维生素A、B，皮则不含维生素C，而富于维生素A，味苦，可健胃。小儿如服入大量果皮，可致中毒（腹痛、痉挛）。"}]},{"ID":"20240612092536-v61qujk","Type":"NodeParagraph","Properties":{"id":"20240612092536-v61qujk","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612092536-qzrqswf","Type":"NodeParagraph","Properties":{"id":"20240612092536-qzrqswf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 枳实:拣净杂质，用水浸泡至八成透，捞出，润至内无硬心，切片，晾干。炒枳实:先将麸皮撒匀于加热的锅内，俟烟冒出时，加入枳实片，拌炒至微呈焦黄色，取出，筛去麸皮，放凉。（每枳实片100斤，用麸皮10斤）"}]},{"ID":"20240612092536-kmx0yc4","Type":"NodeParagraph","Properties":{"id":"20240612092536-kmx0yc4","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612092536-ax02enp","Type":"NodeParagraph","Properties":{"id":"20240612092536-ax02enp","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240612092536-3cezt8m","Type":"NodeParagraph","Properties":{"id":"20240612092536-3cezt8m","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》:\"入心、脾二经。\""}]},{"ID":"20240612092536-h5j1tyu","Type":"NodeParagraph","Properties":{"id":"20240612092536-h5j1tyu","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》:\"入足阳明、太阴经。\""}]},{"ID":"20240612092536-2fa4mjm","Type":"NodeParagraph","Properties":{"id":"20240612092536-2fa4mjm","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③《本草再新》:\"入肝、脾二经。\""}]},{"ID":"20240612092536-0xtxztd","Type":"NodeParagraph","Properties":{"id":"20240612092536-0xtxztd","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612092536-k42pfly","Type":"NodeParagraph","Properties":{"id":"20240612092536-k42pfly","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240612092536-8xopvcf","Type":"NodeParagraph","Properties":{"id":"20240612092536-8xopvcf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"味苦，寒。\""}]},{"ID":"20240612092536-4mldipm","Type":"NodeParagraph","Properties":{"id":"20240612092536-4mldipm","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》:\"雷公:酸，无毒。李当之:大寒。\""}]},{"ID":"20240612092536-u19kcts","Type":"NodeParagraph","Properties":{"id":"20240612092536-u19kcts","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③《别录》:\"酸，微寒，无毒。\""}]},{"ID":"20240612092536-kq85ob6","Type":"NodeParagraph","Properties":{"id":"20240612092536-kq85ob6","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"④《药性论》:\"味苦辛。\""}]},{"ID":"20240612092536-m9ovm35","Type":"NodeParagraph","Properties":{"id":"20240612092536-m9ovm35","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612092536-yug2y36","Type":"NodeParagraph","Properties":{"id":"20240612092536-yug2y36","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 脾胃虚弱及孕妇慎服，"}]},{"ID":"20240612092536-bad7op2","Type":"NodeParagraph","Properties":{"id":"20240612092536-bad7op2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"①《医学入门》:\"虚而久病，不可惧服。\""}]},{"ID":"20240612092536-wo4yzv7","Type":"NodeParagraph","Properties":{"id":"20240612092536-wo4yzv7","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②《本草备要》:\"孕妇及气虚人忌用。\""}]},{"ID":"20240612092536-6lylzmg","Type":"NodeParagraph","Properties":{"id":"20240612092536-6lylzmg","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③《得配本草》:\"大损真元，非邪实者，不可误用。\""}]},{"ID":"20240612092536-gri52fu","Type":"NodeParagraph","Properties":{"id":"20240612092536-gri52fu","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612092536-mwoj503","Type":"NodeParagraph","Properties":{"id":"20240612092536-mwoj503","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 破气，散痞，泻痰，消积。治胸腹胀满，胸痹，痞痛，痰癖，水肿，食积，便秘，胃下垂，子宫下垂，脱肛。"}]},{"ID":"20240612092536-rp93wxo","Type":"NodeParagraph","Properties":{"id":"20240612092536-rp93wxo","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"主大风在皮肤中，如麻豆苦痒，除寒热结，止痢，长肌肉，利五脏。\""}]},{"ID":"20240612092536-4ks88wh","Type":"NodeParagraph","Properties":{"id":"20240612092536-4ks88wh","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"除胸胁痰癖，逐停水，破结实，消胀满，心下急痞痛，逆气，胁风痛，安胃气，止溏泄，明目。\""}]},{"ID":"20240612092536-nf61rid","Type":"NodeParagraph","Properties":{"id":"20240612092536-nf61rid","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③《药性论》:\"解伤寒结胸，入陷胸汤用；主上气喘咳。肾内伤冷，阴痿而有气，加而用之。\""}]},{"ID":"20240612092536-bopk7fa","Type":"NodeParagraph","Properties":{"id":"20240612092536-bopk7fa","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"④《珍珠囊》:\"去胃中湿热。\""}]},{"ID":"20240612092536-yh0lhdc","Type":"NodeParagraph","Properties":{"id":"20240612092536-yh0lhdc","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑤《医学启源》:\"《主治秘诀》云，主心痞，化心胸痰，消食，散败血，破积坚。\""}]},{"ID":"20240612092536-3bfsmyt","Type":"NodeParagraph","Properties":{"id":"20240612092536-3bfsmyt","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑥《本草再新》:\"破气，化痰，消食宽肠，杀虫，败毒。\""}]},{"ID":"20240612092536-rgeun2m","Type":"NodeParagraph","Properties":{"id":"20240612092536-rgeun2m","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑦《现代实用中药》:\"治咳嗽，水肿，便秘，子宫下垂及脱肛。\""}]},{"ID":"20240612092536-vvu6t7l","Type":"NodeParagraph","Properties":{"id":"20240612092536-vvu6t7l","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612092536-1g88r9q","Type":"NodeParagraph","Properties":{"id":"20240612092536-1g88r9q","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 内服:煎汤，1～2钱；或入丸、散。外用:研末调涂或炒热熨。"}]},{"ID":"20240612092536-x0lsb8j","Type":"NodeParagraph","Properties":{"id":"20240612092536-x0lsb8j","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612092536-dcqc1e3","Type":"NodeParagraph","Properties":{"id":"20240612092536-dcqc1e3","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" ①治痞，消食，强胃:白术二两，枳实（麸炒黄色，去瓤）一两。上同为极细末，荷叶裹炒，饭为丸，如梧桐子大。每服五十丸，多用白汤下，无时。（《内外伤辨》枳术丸）"}]},{"ID":"20240612092536-vs83d2l","Type":"NodeParagraph","Properties":{"id":"20240612092536-vs83d2l","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②治胸痹心中痞气，气结在胸，胸满胁下逆抢心:枳实四枚，厚朴四两，薤白半升，桂枝一两，栝楼实一枚（捣）。上五味，以水五升，先煮枳实、厚朴，取二升，去滓，纳诸药，煮数沸，分温三服。（《金匮要略》枳实薤白桂枝汤）"}]},{"ID":"20240612092536-206sv02","Type":"NodeParagraph","Properties":{"id":"20240612092536-206sv02","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③治卒患胸痹痛:枳实捣（末），宜服方寸匕，日三，夜一服。（《补缺肘后方》）"}]},{"ID":"20240612092536-425qarc","Type":"NodeParagraph","Properties":{"id":"20240612092536-425qarc","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"④治伤寒后，卒胸膈闭痛:枳实，麸炒为末。米饮服二钱，日二服。（《简要济众方》）"}]},{"ID":"20240612092536-g99098p","Type":"NodeParagraph","Properties":{"id":"20240612092536-g99098p","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑤治大便不通:枳实、皂荚等分。为末，饭丸，米饮下。（《世医得效方》）"}]},{"ID":"20240612092536-qrr3uhs","Type":"NodeParagraph","Properties":{"id":"20240612092536-qrr3uhs","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑥治伤湿热之物，不得施化而作痞满，闷乱不安:大黄一两，枳实（麸炒，去瓤）、神曲（炒）各五钱，茯苓（去皮）、黄芩（去腐）、黄连（拣净）、白术各三钱，泽泻二钱。上件为细末，汤浸蒸饼为丸，如梧桐子大。每服五十丸至七十九温水送下，食远，量虚实加减服之。（《内外伤辨》枳实导滞丸）"}]},{"ID":"20240612092536-yjpqtsi","Type":"NodeParagraph","Properties":{"id":"20240612092536-yjpqtsi","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑦治少小久痢淋沥，水谷不调，形羸不堪大汤药者:枳实二两。治下筛。三岁已上饮服方寸匕，若儿小以意服，日三。（《千金方》枳实散）"}]},{"ID":"20240612092536-yb0djju","Type":"NodeParagraph","Properties":{"id":"20240612092536-yb0djju","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑧治肠风下血:枳实半斤（麸炒，去瓤），绵黄耆半斤（洗，锉，为末），米饮非时下二钱匕，若难服，以糊丸，汤下三五十丸。（《经验方》）"}]},{"ID":"20240612092536-oho82o1","Type":"NodeParagraph","Properties":{"id":"20240612092536-oho82o1","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑨治积冷利脱肛:枳实一枚。石上磨令滑泽，钻安柄，蜜涂、炙令暖熨之，冷更易之，取缩入止。（《千金方》）"}]},{"ID":"20240612092536-nxigegf","Type":"NodeParagraph","Properties":{"id":"20240612092536-nxigegf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑩治产后腹痛，烦满不得卧:枳实（烧令黑，勿太过）、芍药等分。杵为散。服方寸匕，日三服。并主痈脓，以麦粥下之。（《金匮要略》）枳实芍药散）"}]},{"ID":"20240612092536-m1964fc","Type":"NodeParagraph","Properties":{"id":"20240612092536-m1964fc","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑾治大病瘥后劳复:枳实三枚（炙），柜子十四个（擘），豉一升（绵裹）。上三味以清浆水七升，空煮取四升，纳枳实、栀子，煮取二升，下豉，更煮五六沸，去滓，温分再服，覆令微似汗。若有宿食者，加大黄如博棋子大五、六枚。（《伤寒论》枳实栀子豉汤）"}]},{"ID":"20240612092536-zzkz3ux","Type":"NodeParagraph","Properties":{"id":"20240612092536-zzkz3ux","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑿治风疹:枳实以醋渍令湿，火炙令热，适寒温用熨上。（《延年方》）"}]},{"ID":"20240612092536-fk6k4g7","Type":"NodeParagraph","Properties":{"id":"20240612092536-fk6k4g7","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⒀治妇人阴肿坚痛:枳实半斤。碎，炒，令熟帛裹熨之，冷即易。（《子母秘录》）"}]},{"ID":"20240612092536-o2afu2n","Type":"NodeParagraph","Properties":{"id":"20240612092536-o2afu2n","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⒁治小儿头疮:枳实烧灰，猪脂调涂。（《圣惠方》）"}]},{"ID":"20240612092536-ogr8qyv","Type":"NodeParagraph","Properties":{"id":"20240612092536-ogr8qyv","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612092536-d31vo9j","Type":"NodeParagraph","Properties":{"id":"20240612092536-d31vo9j","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 治疗胃下垂：将川枳实洗净，加2倍量的水，浸泡24小时，待发胀变软取出，剪为细块，再放原液中煮沸1.5小时，过滤，滤渣加水再煎，共煎3次，最后将滤渣挤压弃去；3次滤液，微火浓缩使成66％或132％浓度的煎剂。每日3次，每次10～20毫升，饭前半小时服。治疗21例，经服药15～45天，痊愈8例，X线钡餐检查胃下极位置较未服药前有显着升高，胃运动功能正常，临床自觉和他觉症状消失；好转6例，X线钡餐检查胃下极位置较未服药前有一定升高，胃运动机能有一定改善，临床自觉和他觉症状消失或减轻，或X线检查虽无明显进步，但临床症状消失:有效6例，X线钡餐检查无明显进步，临床自觉和他觉症状减轻；1例无效。又有用川枳实、蓖麻仁等量制成10％之溶液，行游子透入疗法，每日1次，每次10～20分钟，15天为一疗程。治疗18例，痊愈13例，显著好转2例，好转2例，无效1例。治后多数患者之腹胀、腹痛、便秘、胃纳不佳、失眠、头昏、乏力等症状消失；体重有不同程度的增加。"}]},{"ID":"20240612092536-ecltskt","Type":"NodeParagraph","Properties":{"id":"20240612092536-ecltskt","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612092536-w8c28du","Type":"NodeParagraph","Properties":{"id":"20240612092536-w8c28du","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义》:\"枳实、枳壳，一物也。小则其性酷而速，大则其性和而缓。故张仲景治伤寒仓卒之病，承气汤中用枳实，此其意也；皆取其疏通、决泄、破结实主义。他方但导败风壅之气，可常服者，故用枳壳，其意如此。\""}]},{"ID":"20240612092536-uarz11e","Type":"NodeParagraph","Properties":{"id":"20240612092536-uarz11e","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"②张洁古:\"治心下痞及宿食不消，并用枳实、黄连。\""}]},{"ID":"20240612092536-4fo3pqy","Type":"NodeParagraph","Properties":{"id":"20240612092536-4fo3pqy","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"③《用药心法》:\"枳实，洁古用去脾经积血，故能去心下痞，睥无积血，则心下不痞。\""}]},{"ID":"20240612092536-wrnuql9","Type":"NodeParagraph","Properties":{"id":"20240612092536-wrnuql9","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"④《汤液本草》:\"枳实，益气则佐之以人参、干姜、白术；破气则佐之以大黄、牵牛、芒硝；此《本经》所以言益气而复言消痞也。非白术不能去湿，非枳实不能除痞。壳主高而实主下，高者主气，下者主血，主气者在胸膈，主血者在心腹。\""}]},{"ID":"20240612092536-067eoin","Type":"NodeParagraph","Properties":{"id":"20240612092536-067eoin","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"⑤《药品化义》:\"枳实专泄胃实，开导坚结，故主中脘以治血分，疗脐腹间实满，消痰癖，祛停水，逐宿食，破结胸，通便闭，非此不能也。若皮肤作痒，因积血滞于中，不能营养肌表，若饮食不思，因脾郁结不能运化，皆取其辛散苦泻之力也，为血分中之气药，惟此称最。\""}]},{"ID":"20240612092536-52m7z1f","Type":"NodeParagraph","Properties":{"id":"20240612092536-52m7z1f","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612092536-98ddqby","Type":"NodeParagraph","Properties":{"id":"20240612092536-98ddqby","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612092536-jy74k9r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092536-jy74k9r","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"《中华本草》：枳实"}]},{"ID":"20240612092536-lmfzcli","Type":"NodeParagraph","Properties":{"id":"20240612092536-lmfzcli","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612092536-bpyfome","Type":"NodeParagraph","Properties":{"id":"20240612092536-bpyfome","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" Zhǐ Shí"}]},{"ID":"20240612092536-i0fsbpm","Type":"NodeParagraph","Properties":{"id":"20240612092536-i0fsbpm","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612092536-pmz553e","Type":"NodeParagraph","Properties":{"id":"20240612092536-pmz553e","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 鹅眼枳实。"}]},{"ID":"20240612092536-382vryn","Type":"NodeParagraph","Properties":{"id":"20240612092536-382vryn","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612092536-r3do0f2","Type":"NodeParagraph","Properties":{"id":"20240612092536-r3do0f2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" Immature Bitter Orange, Immature Sweet Orange"}]},{"ID":"20240612092536-jzfhhzu","Type":"NodeParagraph","Properties":{"id":"20240612092536-jzfhhzu","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612092536-lkpbg33","Type":"NodeParagraph","Properties":{"id":"20240612092536-lkpbg33","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612092536-s1tdih2","Type":"NodeParagraph","Properties":{"id":"20240612092536-s1tdih2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"1.《本草拾遗》：枳实，《本经》采实用，九月、十月，不如七月、八月，既厚且辛。旧云江南为橘，江北为枳，今江南俱有枳橘，江北有枳无橘，此自是别种，非关变也。"}]},{"ID":"20240612092536-fb8zb8d","Type":"NodeParagraph","Properties":{"id":"20240612092536-fb8zb8d","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：枳实，生河内川泽，枳壳生商州山谷，今京西江湖州郡皆有之，以商州者为佳。如橘而小，高亦五、七尺，叶如根，多刺。春生白花，至秋成实。九月、十月采，阴干。旧说，七月、八月采者为实，九月、十月采者为壳"}]},{"ID":"20240612092536-mlsr447","Type":"NodeParagraph","Properties":{"id":"20240612092536-mlsr447","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612092536-mmzcde7","Type":"NodeParagraph","Properties":{"id":"20240612092536-mmzcde7","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 药材基源：为芸香科种植物酸橙及其栽培变种或甜橙的的幼果。"}]},{"ID":"20240612092536-3jwcuve","Type":"NodeParagraph","Properties":{"id":"20240612092536-3jwcuve","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Citrus aurantium L.2.Citrus sinensis （L.）Osbeck"}]},{"ID":"20240612092536-qx47xtb","Type":"NodeParagraph","Properties":{"id":"20240612092536-qx47xtb","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"采收和储藏：种子繁殖在栽后8-10年开花结果，嫁接苗栽后4-5年结果。于5-6月间采摘幼果或待其自然脱落后拾其幼果，大者横切成两半，晒干。"}]},{"ID":"20240612092536-vsdsk09","Type":"NodeParagraph","Properties":{"id":"20240612092536-vsdsk09","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612092536-bx7927e","Type":"NodeParagraph","Properties":{"id":"20240612092536-bx7927e","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 生态环境：栽培于丘陵、低山地带和江河湖泊的沿岸。"}]},{"ID":"20240612092536-9q7vkgv","Type":"NodeParagraph","Properties":{"id":"20240612092536-9q7vkgv","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"资源分布：1.我国长江流域及其以南各省区均有栽培。常见的栽培品种有：朱栾（小红橙）、枸头橙、江津酸橙等。"}]},{"ID":"20240612092536-ej1halr","Type":"NodeParagraph","Properties":{"id":"20240612092536-ej1halr","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"2.江苏、浙江、江西、福建、台湾、湖北、湖南、广东、广西、四川、贵州、云南等地。"}]},{"ID":"20240612092536-7av71k9","Type":"NodeParagraph","Properties":{"id":"20240612092536-7av71k9","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612092536-kl21iny","Type":"NodeParagraph","Properties":{"id":"20240612092536-kl21iny","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 1．酸橙 常绿小乔木。枝三棱形，有长刺。叶互生；叶柄有狭长形或狭长倒心形的叶翼，长8-15mm，宽3-6mm；叶片革质，倒卵状椭圆形或卵状长圆形，长3.5-10cm，宽1.5-5cm，先端短而钝，渐尖或微凹，基部楔形或圆形，全缘或微波状，具半透明油点。花单生或数朵簇生于叶腋及当年生枝条的顶端，白色，芳香；花萼杯状，5裂；花瓣5，长圆形；雄蕊20以上；子房上位，雌蕊短于雄蕊，柱头头状。柑果近球形，熟时橙黄色；味酸。花期4-5月，果期6-11月。"}]},{"ID":"20240612092536-1ltnctf","Type":"NodeParagraph","Properties":{"id":"20240612092536-1ltnctf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"2.甜橙 常绿小乔木，高3-8m。树冠圆形，分枝多，无毛，有刺或无刺，幼枝有棱角。叶互生，单身复叶；叶柄长0.6-2cm，叶翼狭窄，宽2-3mm，顶端有关节；叶片质较厚，椭圆形或卵圆形，长6-12cm，宽2.3-5.5cm，先端短尖或渐尖，微凹，基部阔楔形或圆形，波状全缘，或有不明显的波状锯齿，有半透明油腺点。花1至数朵簇生叶液，白色，有柄；花萼3-5裂，裂片三角形；花瓣5，舌形，长约1.5cm，宽约7mm，向外反卷；雄蕊19-28，花丝下部连合成5-12束，雌蕊1，子房近球形，10-13室，柱头头状，花柱细，不脱落。柑果扁圆形或近球形，直径6-9cm，橙黄色或橙红色，果皮较厚，不易剥离，瓤囊8-13，果汁黄色，味甜。种子楔状卵形，表面平滑。花期4月，果熟期11-12月。"}]},{"ID":"20240612092536-1g12y7k","Type":"NodeParagraph","Properties":{"id":"20240612092536-1g12y7k","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612092536-qpf35ko","Type":"NodeParagraph","Properties":{"id":"20240612092536-qpf35ko","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜温暖湿润气候。耐荫性强。年平均气温要求在15℃以上，发芽有效温度为10℃以上，生长适宜温度为20-25℃，在-5℃以上能安全生长，最低温度为-9℃，最高温度40℃。年降雨量1000-2000mm，相对湿度75％。以选阳光充足，土层深厚，疏松肥沃，富含腐殖质，排水良好的微酸性冲积土或酸性黄壤、红壤栽培为宜。"}]},{"ID":"20240612092536-8qkgnjb","Type":"NodeParagraph","Properties":{"id":"20240612092536-8qkgnjb","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子、嫁接繁殖。种子繁殖：11月果实充分成熟时采摘，堆放，取出种子洗净后冬播；或用湿河沙混合贮藏，以待春播。条播育苗，按行距30cm开沟，株距3-6cm，盖肥土，再覆草。出苗前要保持床上湿润，出苗后及时揭去盖草。苗高10cm进行间苗、补苗、松土除草、追施人粪尿或尿素等，夏秋季再追肥1次，冬季需防霜盖草。遇旱及时浇水，保持苗床湿润，苗高1m即可移栽。嫁接繁殖：用种子繁殖的幼苗作砧木，接穗选自优良母树的内膛春梢，于清晨或傍晚随采随用。一般可在2月、5-6月、9-11月进行嫁接。可用单芽切接法或丁字形芽接法。成活后在早春萌芽前于芽的上方10-15cm处剪断，移栽。3月下旬按行株距5m×5m开穴，穴径70cm，深50cm，开穴呈三角形排列，每穴栽1株，使根部舒展，填土压实，浇透水。"}]},{"ID":"20240612092536-pdx2a1c","Type":"NodeParagraph","Properties":{"id":"20240612092536-pdx2a1c","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"田间管理 幼树栽种后要勤除草松土，结合施肥，以氮肥为主。结果树每年施肥3-4次，可于3月上旬、5-6月、7月下旬至8月上旬和11月各施肥1次。花谢后可施（8-10）×10-‘的2，4-D、0.5％尿素、1％过磷酸钙浸出液、3％草木灰浸出液、敌百虫1000倍液等混合液进行叶面喷射。幼果期施过磷酸铐进行根外追肥。4-6月多雨季节要注意排水；7-9月干旱季节要浇水。整形修剪：幼树整形，主要培养骨干架，形成高产稳产树型，定植后1-2年冬季，将1m高以上的部分剪去，留3-4个分枝作骨干枝，逐年培养分枝与侧枝，使树冠生长旺盛，骨干枝可选夏梢或秋梢，长约30-35cm，过长要摘心或短截，保留8-10片叶，在1-2年内可定型。早年始花要摘除全部花蕾，以后可适当疏去树冠中、上部枝条上的花蕾，使在下部着生适量的果实。修剪宜轻，主要剪去密生枝、荫蔽的细弱枝，适当短截长枝。结果树修剪，主要删密留疏，除去弱枝、病虫枝、枯枝、丛生枝、下垂技、徒长技、衰老枝等。大年结果树修剪宜重，以疏删修剪为主，短截为辅。小年树修剪以轻剪为主，尽量保留强壮枝，结果母枝不宜修剪。衰老树更新，3-5月换砧更新或修剪主枝更新。"}]},{"ID":"20240612092536-5e7bwg3","Type":"NodeParagraph","Properties":{"id":"20240612092536-5e7bwg3","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"病虫害防治 病害有溃疡病，为害叶及果实，可在芽萌动时喷1：1：200的波尔多液1-2次。疮痂病，为害叶、枝梢及果实，可在落花时喷1：1：200的波尔多液或50％退菌特可湿性粉剂500倍液。"}]},{"ID":"20240612092536-04spmam","Type":"NodeParagraph","Properties":{"id":"20240612092536-04spmam","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"立枯病，为害幼苗，用70％敌克松300倍液灌根。还有煤烟病为害叶、枝及果实。虫害有星天牛、锈壁虱、介壳虫、桔细潜蛾等。"}]},{"ID":"20240612092536-f4ruqxb","Type":"NodeParagraph","Properties":{"id":"20240612092536-f4ruqxb","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612092536-0ucvgsw","Type":"NodeParagraph","Properties":{"id":"20240612092536-0ucvgsw","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 （l）酸橙权实果实呈半球形、球形或卵圆形，直径0.5-2.5cm。外表面黑绿色或暗棕绿色，具颗粒状突起和皱纹。顶部有明显的花柱基痕，基部有花盘残留或果梗脱落痕。切面光滑而稍隆起，灰白色，厚3-7mm，边缘散有1-2列凹陷油点，瓤囊7-12瓣，中心有棕褐色的囊，呈车轮纹。质坚硬。气清香，味苦、微酸。"}]},{"ID":"20240612092536-uyrtgpx","Type":"NodeParagraph","Properties":{"id":"20240612092536-uyrtgpx","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"（2）甜橙权实外皮黑褐色，较平滑，具微小颗粒状突起。切面类白色，厚2-4mm，瓤囊8-11瓣，味酸、苦。均以外果皮绿褐色、果肉厚、色白、瓤小、质坚实、香气浓者为佳。"}]},{"ID":"20240612092536-4f5fl58","Type":"NodeParagraph","Properties":{"id":"20240612092536-4f5fl58","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：（l）酸橙积实淡黄色或棕黄色。①中果皮细胞类圆形或形状不规则，壁大多不均匀增厚呈连珠状。②果皮表皮细胞表面观多角形、类方形或长方形，气孔类圆形，直径18-26μm，副卫细胞5-9个；侧面观外被角质层。③草酸钙方晶存在于果皮和汁囊细胞中，以邻近表皮的细胞中为多见，呈斜方形、多面形或双锥形，直径2-24μm。④油室碎片多见，分泌细胞狭长而弯曲。⑤螺纹、网纹导管和管胞细小。（2）甜橙枳实粉末特征与酸橙枳实类似，橙皮甙结晶存在于薄壁细胞中，黄色或无色，呈圆形或无定形团块，有的观放射状纹理。"}]},{"ID":"20240612092536-oh8yfy6","Type":"NodeParagraph","Properties":{"id":"20240612092536-oh8yfy6","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612092536-16cprh3","Type":"NodeParagraph","Properties":{"id":"20240612092536-16cprh3","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 1．酸橙果实含检皮甙（hesperidin），新橙皮甙（neohesperidin），油皮甙（naringin），辛弗林（synephrine），N-甲基酪胺（N-methyltyramine）。果实未成熟时含柚皮甙，野漆树甙（rhoifolin），忍冬甙（lonicerin），新橙皮甙，在果实成熟时新橙皮甙消失。另有报道果皮还含川陈皮素（nobiletin）即5，6，7， 8，3’，4＇-六甲氧基黄酮（5，6，7，8，3’，4＇hexamethoxy flavone），橙皮甙，5，6，7，8，4＇-五甲氧基黄酮（5，6，7，8，4＇-pentamethoxy flavone）即福橘素（tangeritin）、5，7，4＇-三甲氧基黄酮（5，7，4＇-trimethoxy flavone）、5，6，7，3＇，4＇-五甲氧基黄酮即甜橙素（sinensitin）、5，7，8，4＇-四甲氧基黄酮（5，7，8，4＇-tetramethoxy flavone）及5，7，8，4＇-五甲氧基黄酮。种子含柠檬苦素类（limonoids）：宜昌橙苦素（ichangin），去乙酸闹米林（deacetyl nomilin），柠檬苦素（limonin），闹米林（nomilin），黄柏酮（obacunone），去乙酰闹米林酸（deacetylnomilinic acid），异柠檬尼酸（isolimonic acid），闹米林酸（nomilinic acid）及它们的17-β-D-葡萄糖甙，还含19-羟基去乙酰闹米林酸-17-β-D-葡萄糖甙（19-hydroxydeacetylnomilinic acid-17-β-D-glucoside）。"}]},{"ID":"20240612092536-2bmpugr","Type":"NodeParagraph","Properties":{"id":"20240612092536-2bmpugr","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"2．甜橙果实含油皮素-7-芸香糖甙（naringenin-7-ruti-noside）即柚皮芸香甙（narirutin），异樱花素-7-芸香糖甙（isosaku-ranetin-7-rutinoside），圣草枸楷甙（eriocitrin），柚皮素-4＇-葡萄糖甙-7-芸香糖甙（naringenin-4’-glucoside-7-rutinoside），辛弗林，N-甲基酪胺。果皮含橙皮甙、柚皮甙，柑属甙（citrusin）A、B、C，松柏甙（coniferin），丁香甙（syringin），去氢二松柏醇-4-β-D-葡萄糖甙（dehydrodiconiferyl alcohol-4-β-D-glucoside），2”-O--β-木糖基牡荆素（2”-O-β-xylosylvitexin），3-羟基-5，6，7，8，3’，4＇-六甲氧基黄酮-3β-葡萄糖甙（3-hydroxy-5，6，7，8，3＇，4＇-hexamethoxyflavone-3β-glucoside）即川陈皮素-3-O-β-葡萄糖甙（nobiletin-3-O-β-glucoside），3，8-二葡萄糖基芹菜素（3，8-di-C-glucosylapigenin），3，8-二葡萄糖基香叶木素（3，8-di-C-glucosyldiosmetin），反香苇醇-6β-吡喃葡萄糖甙（trans-carveol-6β-glucopyranoside），a-松油醇-8-β-D-吡喃葡萄糖甙（a-terpineol-8-β-D-glucopyranoside），9-羟基芳樟醇-9β-吡喃葡萄糖甙（9-hydroxylinalool-9-β-glucopyranoside），催吐萝芙木醇-9-O-D吡喃葡萄糖甙（vomifoliol-9-O-β-D-glucopyranoside），柚皮芸香甙等甙类。还含福橘素，）川陈皮素，5，7，4＇-三甲氧基黄酮，5，7，3＇，4’-四甲氧基黄酮及5，7，8，3’，4’-五甲氧基黄酮，柑属环肽（citrusin）Ⅱ、Ⅲ、Ⅳ。"}]},{"ID":"20240612092536-0yrc1ld","Type":"NodeParagraph","Properties":{"id":"20240612092536-0yrc1ld","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"3．桐橘果实含橙皮甙，柚皮甙，新橙皮甙，枳属甙（poncirin），棕榈酸（palmitic acid），硬脂酸（stearoc acid），油酸（oleic acid），亚油酸（linoleic acid），亚麻酸（linolenic acid），辛弗林，N-甲基酪胺。未成熟果实含构橘香豆精（poncimarin），异枸橘香豆精（iso-poncimarin），7-牻牛儿醇基香豆精（7-geranyloxycoumarin）即葡萄内酯（aurapten），6-甲氧基葡萄内酯（6-methyoxyaurapten），香柑内酯（bergapten）、欧前胡内酯（imperatorin）。种子含异茴芹香豆精（isopimpinellin），栓翅芹内酯（prangenin）即独活内酯（heraclenin），栓翅芹内酯水合物（prangeninhydrate），香柑内酯，欧前胡内酯，葡萄内酯，6-甲氧基葡萄内酯及柠檬苦素，去乙酸闹米林，宜昌橙苦素，去乙酸闹米林酸，异柠檬尼酸等柠檬苦素类似物。"}]},{"ID":"20240612092536-rfs8kc6","Type":"NodeParagraph","Properties":{"id":"20240612092536-rfs8kc6","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"果皮含挥发油（0.469％），其成分有a-蒎烯（a-pinene），β-蒎烯，月桂烯（myrcene），柠檬烯（limonene），樟烯（camphene），γ-松油烯（γ-terpinene），对聚伞花素（p-cymene）及丁香烯（caryophyllene）。"}]},{"ID":"20240612092536-98mlb8q","Type":"NodeParagraph","Properties":{"id":"20240612092536-98mlb8q","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612092536-yzxhq43","Type":"NodeParagraph","Properties":{"id":"20240612092536-yzxhq43","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 1.对子宫的作用：用三个不同产地(四川、江西、湖南)的枳壳和枳实煎液，对小鼠离体子宫(已孕及未孕)皆呈抑制作用；对兔在体和离体子宫(已孕及未孕)皆为兴奋。对兔子宫瘘亦证明能使子宫收缩有力，张力增加，甚至出现强直收缩。枳壳酊和枳壳流浸膏，对兔子宫(在体和离体)也有兴奋作用；对小鼠子宫(离体)则抑制。自香圆枳壳和枸橘中分离出的一种生物碱样物质，对兔离体子宫也有一定收缩作用，尤以垂体后叶素兴奋过的子宫肌更显着；除去生物碱的部分，对兔离体子宫却有松弛作用，经垂体后叶素兴奋后，子宫的弛缓作用更明显。从枳实果皮中分离出的Cirantin，能抑制卵巢周围透明质酸酶的活性，这可能与其避孕作用有关(阻止受精)。"}]},{"ID":"20240612092536-z8judfv","Type":"NodeParagraph","Properties":{"id":"20240612092536-z8judfv","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"2.对肠管的影响：三个不同产地的枳壳和枳实，对小鼠和兔的离体肠管皆呈抑制；兔在体肠管多数为抑制，少数无变化。枳壳酊及其流浸膏，对小鼠(离体)、兔(在体和离体)肠管均抑制。高浓度(1：1000)对离体兔、豚鼠小肠均呈抑制，且能抑制乙酰胆碱、组织胺之作用；低浓度(1：10000)则在短暂抑制后，可呈现兴奋作用，振幅加大，频率加快。麻醉犬的在位肠，用煎剂也有明显抑制；但对胃肠造瘘的犬，则呈一定兴奋作用，能使胃肠运动收缩节律有力。"}]},{"ID":"20240612092536-5q5zvbd","Type":"NodeParagraph","Properties":{"id":"20240612092536-5q5zvbd","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"3.对心、血管的作用：对蟾蜍离体心是小量兴奋，大量抑制。枳壳和枳实水煎液，枳壳酊与流浸膏皆如此。用枳壳煎液或醇提液给犬静脉注射，可致显着升压作用。三个不同产地的枳壳和枳实煎液，用蟾蜍全身血管灌流法证明，有轻度收缩血管的作用；对麻醉犬，有显着而迅速的升压作用，它没有肾上腺素升压时引起的呼吸抑制、后降压现象，心率亦无明显增快。"}]},{"ID":"20240612092536-444rt11","Type":"NodeParagraph","Properties":{"id":"20240612092536-444rt11","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"升压机理与下列因素有关：3.1.兴奋α受体，致部分器官血管收缩(苯胺唑啉可将升压翻转为降压反应)。"}]},{"ID":"20240612092536-xv0ahzf","Type":"NodeParagraph","Properties":{"id":"20240612092536-xv0ahzf","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"3.2.心肌收缩加强，心输出量增加(豚鼠离体心脏灌流及心肺制备)。利血平化后，枳实的升压作用更加显着。对麻醉狗枳实有非常显着的增加冠脉流量的作用(气泡流量计，冠脉流量可增加289.4%)，脑、肾血流量亦平均增加86.4%及64.5%，与去甲肾上腺素有显着不同；股动脉血流量则有减少，心肌耗氧量略有增加，但不明显，与冠脉流量的显着增加不相平行。在犬及豚鼠的心电图试验中，大剂量枳实引起的心律紊乱(室性心动过速或房室传导阻滞)并不严重，根据以上作用特点，有人建议可用于治疗心源性休克。自香圆枳壳和枸橘中分离的生物碱亦能使血管平滑肌的紧张度有短暂增强，尤其当垂体后叶素作用后更明显。"}]},{"ID":"20240612092536-gp7ky4m","Type":"NodeParagraph","Properties":{"id":"20240612092536-gp7ky4m","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"4.抗血栓：枳实水煎液0.1g/ml体外试验，均有明显抗血栓形成作用。"}]},{"ID":"20240612092536-jilvqp4","Type":"NodeParagraph","Properties":{"id":"20240612092536-jilvqp4","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"5.抗变态反应：枳实水提物100mg/kg静脉搏注射，对大鼠被动皮肤过敏反应(PCA)有抑制作用，50μg/ml对大鼠腹腔肥大细胞释放组胺有抑制作用。"}]},{"ID":"20240612092536-6z85dsi","Type":"NodeParagraph","Properties":{"id":"20240612092536-6z85dsi","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"6.其他作用：柑橙属(Citrus)植物粘胶质能使大鼠(用含胆甾醇的饲料喂养)的血清及肝中胆甾醒含量降低。枳实的醇浸液在试管内对结核杆菌 H37Rv有抑制作用，其抑菌浓度为1：1000。其水煎剂对豚鼠支气管无影响。有人报告，柑柚属的果汁能促进(面包)酵母菌之发酵速度，煮沸后活性并不下降，故非酶成分。橘汁主要之医疗用途在其含有丰富的维生素 C，并含相当量的维素 A、B，皮则不含维生素 C，而富于维生素 A，味苦，可健胃。小儿如服入大量果皮，可致中毒(腹痛、痉挛)。"}]},{"ID":"20240612092536-x0sbcoe","Type":"NodeParagraph","Properties":{"id":"20240612092536-x0sbcoe","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612092536-8st5c5j","Type":"NodeParagraph","Properties":{"id":"20240612092536-8st5c5j","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 生枳实：拣净杂质，用水浸泡至八成透，捞出，润至内无硬心，切片，晾干。炒枳实：先将麸皮撤匀于加热的锅内，侯烟冒出时，加入枳实片，拌炒至微呈焦黄色，取出，筛去麸皮，放凉。(每枳实片100斤，用麸皮10斤)"}]},{"ID":"20240612092536-wzosqjx","Type":"NodeParagraph","Properties":{"id":"20240612092536-wzosqjx","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612092536-qgdkol4","Type":"NodeParagraph","Properties":{"id":"20240612092536-qgdkol4","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 （1）取本品粉末0.5g加甲醇10ml，加热回流10min，滤过。取滤液1ml，加四氢硼钾约5mg摇匀，加盐酸数滴，溶液显樱红色至紫红色。（检查二氢黄酮类成分）（2）薄层色谱取样品粉末0.5g，加甲醇10ml，回流1h，滤过。滤液蒸干，残渣加甲醇4ml溶解，放置30min，滤过，滤液作为供试品溶液。取辛弗林（对羟福林）如甲醇溶解，制成每1ml含3mg的对照品溶液。分别点于硅胶H-CMC板上，以甲醇-丙酮-氯仿-浓氨水（3：3：3：1）展开15cm，取出，晾干，喷以0.5％ 茚三酮乙醇溶液，于105℃加热约10min，供试品色谱中在与对照品色谱相应的位置上，显相同的紫色斑点。"}]},{"ID":"20240612092536-qch3aap","Type":"NodeParagraph","Properties":{"id":"20240612092536-qch3aap","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"商品规格 一等：幼果横切两瓣，直径1.5-2.0cm。呈扁圆片形，隆起，表面青黑色或黑褐色，具颗粒状突起和皱纹。切面果肉黄白色。肉果瓤小，质坚硬。气清香，味苦微酸。二等：直径1.5cm以下。未切的个子不得超过30％。余同一等。出口商品质量要求同上。"}]},{"ID":"20240612092536-ay8hx7t","Type":"NodeParagraph","Properties":{"id":"20240612092536-ay8hx7t","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612092536-x8riost","Type":"NodeParagraph","Properties":{"id":"20240612092536-x8riost","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 脾；胃；肝；心经"}]},{"ID":"20240612092536-5qrbsol","Type":"NodeParagraph","Properties":{"id":"20240612092536-5qrbsol","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612092536-drbf7du","Type":"NodeParagraph","Properties":{"id":"20240612092536-drbf7du","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 苦；辛；寒"}]},{"ID":"20240612092536-oo5im88","Type":"NodeParagraph","Properties":{"id":"20240612092536-oo5im88","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612092536-514gl43","Type":"NodeParagraph","Properties":{"id":"20240612092536-514gl43","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 脾胃虚弱及孕妇慎服。"}]},{"ID":"20240612092536-lb9ltvs","Type":"NodeParagraph","Properties":{"id":"20240612092536-lb9ltvs","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"1.《医学入门》：虚而久病，不可误服。"}]},{"ID":"20240612092536-ctnc1ig","Type":"NodeParagraph","Properties":{"id":"20240612092536-ctnc1ig","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"2.《本草备要》：孕妇及气虚人忌用。"}]},{"ID":"20240612092536-5mv9a8k","Type":"NodeParagraph","Properties":{"id":"20240612092536-5mv9a8k","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"3.《得配本草》：大损真元，非邪实者，不可误用。"}]},{"ID":"20240612092536-1ydl4ll","Type":"NodeParagraph","Properties":{"id":"20240612092536-1ydl4ll","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612092536-fujhfur","Type":"NodeParagraph","Properties":{"id":"20240612092536-fujhfur","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 破气消积；化痰除痞。主积滞内停；痞满胀痛；大便秘结；泻痢后重；结胸；胃下垂；子宫脱垂；脱肛"}]},{"ID":"20240612092536-17gie4q","Type":"NodeParagraph","Properties":{"id":"20240612092536-17gie4q","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612092536-49rlg49","Type":"NodeParagraph","Properties":{"id":"20240612092536-49rlg49","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 内服：水煎，3-10g；或入丸、散。外用：适量，研末调涂；或炒热熨。"}]},{"ID":"20240612092536-nn0ult2","Type":"NodeParagraph","Properties":{"id":"20240612092536-nn0ult2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612092536-2wth4aw","Type":"NodeParagraph","Properties":{"id":"20240612092536-2wth4aw","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" ①治痞，消食，强胃：白术)二两，枳实(麸炒黄色，去瓤)一两。上同为极细末，荷叶裹炒，饭为丸，如梧桐子大。每服五十丸，多用白汤下，无时。(《内外伤辨》枳术丸)；②治胸痹心中痞气，气结在胸，胸满胁下逆抢心：枳实四枚，厚朴四两，薤白半升，桂枝一两，枳楼实一枚(捣)。上五昧，以水五升，先煮枳实、厚朴，取二升，去滓，纳诸药，煮数沸，分温三服。(《金匮要略》枳实薤白桂枝汤)；③治率患胸痹痛：枳实捣(末)，宜服方寸匕，日三，夜一服。(《补缺肘后方》)；④治伤寒后，卒胸膈闭痛：枳实，麸炒为末。米饮服二钱，日二服。(《简要济众方》)；⑤治大便不通：枳实、皂荚等分。为末，饭丸，米饮下。(《世医得效方》)；⑥治伤湿热之物，不得施化而作痞满，闷乱不安：大黄一两，枳实(麸炒，去瓤)、神曲(炒)各五钱，茯苓(去皮)、黄芩(去腐)、黄连(拣净)、白术各三钱，泽泻二钱。上件为细末，汤浸蒸饼为丸，如梧桐子大。每服五十丸至七十丸，温水送下，食远，量虚实加减服之。(《内外伤辨》枳实导滞丸)；⑦治少小久痢淋沥，水谷不调，形羸不堪大汤药者：枳实二两。治下筛。三岁已上钦服方寸匕，若儿小以意服，日三。(《千金方》枳实散)；⑧治肠风下血：枳实半斤(麸炒，去瓤)，绵黄耆半斤(洗，挫，为末)。米钦非时下二钱匕，若难服，以糊丸，汤下三五十丸。(《经验方》)；⑨治积冷利脱肛：枳实一枚。石上磨令滑泽，钻安柄，蜜涂、炙令暖熨之，冷更易之，取缩入止。(《干金方》)；⑩治产后腹痛，烦满不得卧：枳实(烧令黑，匆太过)、芍药等分。杵为散。服方寸匕，日三服。并主痈脓，以麦粥下之。(《金匮要略》)枳实芍药散)；⑾治大病瘥后劳复：枳实三枚(炙)，栀子十四个(擘)，豉一升(绵裹)。上三味以清浆水七升，空煮取四升，纳积实、栀子，煮取二升，下豉，更煮五六沸，去滓。温分再服，覆令微似汗。若有宿食者，加大黄如博QI子大五、六枚。(《伤寒论》枳实栀子豉汤)；⑿治风疹：枳实以醋渍令湿，火炙令热，适寒温用熨上。(《延年方》)；⒀治妇人阴肿坚痛：枳实半斤。碎，炒，令熟帛裹熨之，冷即易。(《子母秘录》)；⒁治小儿头疮： 枳实烧灰，猪脂调涂。(《圣惠方》)"}]},{"ID":"20240612092536-w1t7ox2","Type":"NodeParagraph","Properties":{"id":"20240612092536-w1t7ox2","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612092536-ebrs6et","Type":"NodeParagraph","Properties":{"id":"20240612092536-ebrs6et","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 治疗胃下垂。将川枳实洗净，加2倍量的水，浸泡24小时，待发胀变软取出，剪为细块，再放原液中煮沸1.5小时，过滤，滤渣加水再煎，共煎3次，最后将滤渣挤压弃去；3次滤液，微火浓缩使成66%或132%浓度的煎剂。每日3次，每次10-20ml，饭前半小时服。治疗21例，经服药15-45天，痊愈8例，X线钡餐检查胃下极位置较未服药前有显着升高，胃运动功能正常，临床自觉和他觉症状消失；好转6例，X线钡餐检查胃下极位置较未服药前有一定升高，胃运动机能有一定改善，临床自觉和他觉症状消失或减轻，或X线检查虽无明显进步，但临床症状消失；有效6例，X线钡餐检查无明显进步，临床自觉和他觉症状减轻；1例无效。又有用川枳实、蓖麻仁等量制成10%之溶液，行游子透入疗法，每日1次，每次 lO-20分钟，15天为一疗程。治疗18例，痊愈13例，显着好转2例，好转2例，无效l例。治后多数患者之腹胀、腹痛、便秘、胃纳不佳、失眠、头昏、乏力等症状消失；体重有不同程度的增加。"}]},{"ID":"20240612092536-ioc3eh5","Type":"NodeParagraph","Properties":{"id":"20240612092536-ioc3eh5","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612092536-aeab5uz","Type":"NodeParagraph","Properties":{"id":"20240612092536-aeab5uz","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：枳实、枳壳，一物也。小则其性酷而速，大则其性和而缓。故张仲景治伤寒仓卒之病，承气汤中用枳实，此其意也；皆取其疏通、决泄、破结实之义。他方但导败风壅之气，可常服者，故用积壳，其意如此。"}]},{"ID":"20240612092536-bju4ljg","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612092536-bju4ljg","updated":"20240612092536"},"Children":[{"ID":"20240612092536-pufa6fg","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240612092536-pufa6fg","updated":"20240612092536"},"Children":[{"ID":"20240612092536-jv1c7c9","Type":"NodeParagraph","Properties":{"id":"20240612092536-jv1c7c9","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"张洁古：治心下痞及宿食不消，并用枳实、黄连。"}]}]}]},{"ID":"20240612092536-9cxwxtu","Type":"NodeParagraph","Properties":{"id":"20240612092536-9cxwxtu","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"3.《用药心法》：枳实，洁古用去脾经积血，故能去心下痞，脾无积血，则心下不痞。"}]},{"ID":"20240612092536-2ohuc5g","Type":"NodeParagraph","Properties":{"id":"20240612092536-2ohuc5g","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"4.《汤液本草》：枳实，益气则佐之以人参、干姜、白术；破气则佐之以大黄、牵牛、芒硝；此《本经》所以言益气而复言消痞也。非白术不能去湿，非枳实不能除痞。壳主高而实主下，高者主气，下者主血，主气者在胸隔，主血者在心腹。"}]},{"ID":"20240612092536-aold5rn","Type":"NodeParagraph","Properties":{"id":"20240612092536-aold5rn","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"5.《本草衍义补遗》：枳实泻痰，能冲墙倒壁，滑窍泻气之药也。"}]},{"ID":"20240612092536-np3uxqy","Type":"NodeParagraph","Properties":{"id":"20240612092536-np3uxqy","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"6.《本草经疏》：枳实，细详神农主治，与本药气味大不相侔，究其所因，必是积壳所主，盖二物古文原同一条，后人分出时误入耳。其《别录》所主除胸胁痰癖，逐停水，破结实，消胀满，心下急痞痛，逆气，胁风痛，安胃气，止溏泄者，是其本分内事，皆足阳明、太阴受病，二经气滞，则不能运化精微，而痰癖停水，结实胀满所自来矣。胃之上口名曰贲门，贲门与心相连，胃气壅则心下亦自急痞痛。邪塞中焦，则升降不舒，而气上逆，肝木郁于地下，则不能条达而胁痛，得其破散冲走之力，则诸证悉除。所以仲景下伤寒腹胀实结者，有承气汤，胸中病痛者，有陷胸汤。洁古疗心下痞满者，有枳术丸。壅滞既去，则胃气自安而溏泄亦止矣。末云明目者，《经》曰，目得血而能视，气旺乃能生血，损气破散之性，岂能明目哉，无是理也。此药性专消导，破气损真，观朱震亨云，泻痰有冲墙倒壁之力，其为勇悍之气可知。凡中气虚弱，劳倦伤脾，发为痞满者，当用补中益气汤补其不足，则痞自除，此法所当忌也。胀满非实邪结于中下焦，手不可按，七、八日不更衣者，必不可用。挟热下痢，亦非燥粪留结者，必不可用。伤食停积，多因脾胃虚，不能运化所致，慎勿轻饵。如元气壮实，有积滞者，不得巳用一、二剂，病巳即去之。即洁古所制枳术丸，亦为脾胃有积滞者设，积滞去则脾胃自健，故谓之益脾胃之药，非消导之外，复有补益之功也。"}]},{"ID":"20240612092536-ad6e53d","Type":"NodeParagraph","Properties":{"id":"20240612092536-ad6e53d","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"7.《药品化义》：枳实专泄胃实，开导坚结，故主中脘以治血分，疗脐腹间实满，消痰癖，祛停水，逐宿食，破结胸，通便闭，非此不能也。若皮肤作痒，因积血滞于中，不能营养肌表，若饮食不思，因脾郁结不能运化，皆取其辛散苦泻之力也。为血分中之气药，惟此称最。"}]},{"ID":"20240612092536-fdd6snd","Type":"NodeParagraph","Properties":{"id":"20240612092536-fdd6snd","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612092536-qaxtm0x","Type":"NodeParagraph","Properties":{"id":"20240612092536-qaxtm0x","updated":"20240612092536"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612092537-8q77389","Type":"NodeThematicBreak","Properties":{"id":"20240612092537-8q77389"}},{"ID":"20240612092539-dwonfec","Type":"NodeParagraph","Properties":{"id":"20240612092539-dwonfec"}}]}