{"ID":"20240506082118-fwes3gp","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506082118-fwes3gp","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506082118-fwes3gp\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240627101935-437uql9\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612133442-xq4iwde\u0026quot;,\u0026quot;scrollTop\u0026quot;:2200,\u0026quot;focusId\u0026quot;:\u0026quot;20240627102841-d6b6hbu\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"239鮀鱼甲（鼍甲、扬子鳄鳞甲）","type":"doc","updated":"20240627102205"},"Children":[{"ID":"20240627101935-437uql9","Type":"NodeParagraph","Properties":{"id":"20240627101935-437uql9","updated":"20240627101935"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 804px;","style":"width: 794px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"扬子鳄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/扬子鳄-20240627101935-mn1yr8j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 794px;\" parent-style=\"width: 804px;\"}"}]},{"ID":"20240627102204-8jgmzlv","Type":"NodeParagraph","Properties":{"id":"20240627102204-8jgmzlv","updated":"20240627102205"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 805px;","style":"width: 795px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"扬子鳄3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/扬子鳄3-20240627102204-y7v6q2t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 795px;\" parent-style=\"width: 805px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240627102136-2zq6j30","Type":"NodeParagraph","Properties":{"id":"20240627102136-2zq6j30","updated":"20240627102136"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 805px;","style":"width: 795px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"扬子鳄2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/扬子鳄2-20240627102136-yasny3o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 795px;\" parent-style=\"width: 805px;\"}"}]},{"ID":"20240627102841-d6b6hbu","Type":"NodeParagraph","Properties":{"id":"20240627102841-d6b6hbu","updated":"20240627102841"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 806px;","style":"width: 796px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"扬子鳄7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/扬子鳄7-20240627102841-fyvqynu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 796px;\" parent-style=\"width: 806px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240627102313-hj5ppdu","Type":"NodeParagraph","Properties":{"id":"20240627102313-hj5ppdu","updated":"20240627102354"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 605px;","style":"width: 595px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627102313-nvpcu2t.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 595px;\" parent-style=\"width: 605px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 663px;","style":"width: 653px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"扬子鳄5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/扬子鳄5-20240627102354-6ojle9w.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 653px;\" parent-style=\"width: 663px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240627102327-3p8yvlm","Type":"NodeParagraph","Properties":{"id":"20240627102327-3p8yvlm","updated":"20240627102605"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 673px;","style":"width: 663px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627102327-39d43ky.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 663px;\" parent-style=\"width: 673px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 581px;","style":"width: 571px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627102605-ygnpl0d.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 571px;\" parent-style=\"width: 581px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240612133737-281qs0s","Type":"NodeThematicBreak","Properties":{"id":"20240612133737-281qs0s"}},{"ID":"20240612133738-ldea5hn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133738-ldea5hn","updated":"20240612133745"},"Children":[{"Type":"NodeText","Data":"鮀鱼甲《神农本草经》"}]},{"ID":"20240612133738-egnynx7","Type":"NodeParagraph","Properties":{"id":"20240612133738-egnynx7","updated":"20240612133738"},"Children":[{"Type":"NodeText","Data":"味辛微温。"}]},{"ID":"20240612133738-kk99yar","Type":"NodeParagraph","Properties":{"id":"20240612133738-kk99yar","updated":"20240612133738"},"Children":[{"Type":"NodeText","Data":"主心腹症瘕，伏坚，积聚，寒热，女子崩中，下血五色，小腹阴中相引痛，创疥，死肌。生池泽。"}]},{"ID":"20240612133738-ecqbs0v","Type":"NodeParagraph","Properties":{"id":"20240612133738-ecqbs0v","updated":"20240612133738"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生南海，取无时。"}]},{"ID":"20240612133738-eq4ynuw","Type":"NodeParagraph","Properties":{"id":"20240612133738-eq4ynuw","updated":"20240612133738"},"Children":[{"Type":"NodeText","Data":"案《说文》云：鳝、鱼名，皮可为鼓鼍，鼍、水虫似蜥，易长大。陶宏景云：蛇即鼍甲也。"}]},{"ID":"20240612133439-o13t4nv","Type":"NodeThematicBreak","Properties":{"id":"20240612133439-o13t4nv"}},{"ID":"20240612133727-ztrmmnx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133727-ztrmmnx","updated":"20240612133732"},"Children":[{"Type":"NodeText","Data":"鼍鱼甲《医学入门》"}]},{"ID":"20240612133727-pli80rj","Type":"NodeParagraph","Properties":{"id":"20240612133727-pli80rj","updated":"20240612133727"},"Children":[{"Type":"NodeText","Data":"鱼甲酸性微温，主心腹积有热烦，肠风崩痔引阴痛，涕泣惊腰独可食。"}]},{"ID":"20240612133727-stq99a9","Type":"NodeParagraph","Properties":{"id":"20240612133727-stq99a9","updated":"20240612133727"},"Children":[{"Type":"NodeText","Data":"性嗜睡，恒闭目，形如龙，长一二丈。能吐气致雨，力猛能攻江岸。有毒。主心腹 瘕、伏坚积聚、寒热，女子崩中下血五色，小腹阴中相引痛，疮疥死肌，五邪涕泣时惊，腰中重痛，小儿气癃皆渍。用之当炙，蜀漆为使，畏狗胆、芫花、甘遂。肉至补益，主小气呼吸，足不立地，能发痼疾。皮可贯鼓，膏摩恶疮。鼍骨散，用皮及骨烧灰，入红鸡冠花、白矾灰为末，空心米饮调服，治肠风痔疾甚效。"}]},{"ID":"20240612133813-hp1ma1p","Type":"NodeThematicBreak","Properties":{"id":"20240612133813-hp1ma1p"}},{"ID":"20240612133814-rlk4pcp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133814-rlk4pcp","updated":"20240612133822"},"Children":[{"Type":"NodeText","Data":"鮀鱼甲《新修本草》"}]},{"ID":"20240612133814-znynx3k","Type":"NodeParagraph","Properties":{"id":"20240612133814-znynx3k","updated":"20240612133814"},"Children":[{"Type":"NodeText","Data":"味辛，微温，有毒。主心腹症瘕，伏坚，积聚，寒热，女子崩中，下血五色，小腹、阴中引相痛，疮疥死肌。疗五邪涕泣时惊，腰中重痛，小儿气癃 溃。肉，主少气吸吸，足不立地。生南海池泽，取无时。"}]},{"ID":"20240612133814-l4l7p32","Type":"NodeParagraph","Properties":{"id":"20240612133814-l4l7p32","updated":"20240612133814"},"Children":[{"Type":"NodeText","Data":"蜀漆为之使，畏狗胆、芫花、甘遂。 ，即今鼍甲也，用之当炙。皮可以贯鼓，肉至补益。于物难死，沸汤沃口入腹良久乃剥尔。鼋肉亦补，食之如鼍法。此等老者，多能变化为邪魅，自非急勿食之。"}]},{"ID":"20240612133439-sj6uhlo","Type":"NodeThematicBreak","Properties":{"id":"20240612133439-sj6uhlo"}},{"ID":"20240612133711-y2funiq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133711-y2funiq","updated":"20240612133720"},"Children":[{"Type":"NodeText","Data":"鮀鱼甲《证类本草》"}]},{"ID":"20240612133711-cvx7aev","Type":"NodeParagraph","Properties":{"id":"20240612133711-cvx7aev","updated":"20240612133711"},"Children":[{"Type":"NodeText","Data":"味辛，微温，有毒。主心腹症瘕，伏坚积聚，寒热，女子崩中，下血五色，小腹阴中相引痛，疮疥死肌，五邪涕泣时惊，腰中重痛，小儿气癃 溃。"}]},{"ID":"20240612133711-yinem6i","Type":"NodeParagraph","Properties":{"id":"20240612133711-yinem6i","updated":"20240612133711"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"},{"Type":"NodeText","Data":"主少气吸吸，足不立地。生南海池泽。取无时。（蜀漆为之使，畏狗胆、芫花、甘遂。）"}]},{"ID":"20240612133711-phfduqm","Type":"NodeParagraph","Properties":{"id":"20240612133711-phfduqm","updated":"20240612133711"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶ ，即今鼍甲也，用之当炙。皮可以贯鼓，肉至补益。于物难死，沸汤沃口入腹良久乃剥尔。鼋肉亦补，食之如鼍法。此等老者多能变化为邪魅，自非急勿食之。今按陈藏器本草云∶主恶疮，腹内症瘕。甲更佳，炙，浸酒服之，口内涎有毒也。臣禹锡等谨按蜀本图经云∶生湖畔土窟中，形似守宫而大，长丈余，背尾俱有鳞甲，今江南诸州皆有之。药性论云∶鼍甲，臣，味甘，平，有小毒。主百邪鬼魅，治妇人带下，除腹内血积聚伏坚相引结痛。孟诜云∶鼍，疗惊恐及小腹气疼。日华子云∶鼍，治齿，疳 ，宣露。甲用同功，入药炙。又云鼋甲，臣，平，无毒。主五脏邪气，杀百虫毒，消百药毒，续人筋骨，又脂涂铁烧之便明。准南王方∶术内用之。陈藏器云∶鼋甲功用同鳖甲，炙烧浸酒。主瘰 ，杀虫风，疮，风顽疥瘙。肉，主湿气，邪气，诸蛊。张鼎云∶膏，摩风及恶疮。"}]},{"ID":"20240612133711-srvrtgr","Type":"NodeParagraph","Properties":{"id":"20240612133711-srvrtgr","updated":"20240612133711"},"Children":[{"Type":"NodeText","Data":"图经文具鳖甲条下。"}]},{"ID":"20240612133711-23a22ag","Type":"NodeParagraph","Properties":{"id":"20240612133711-23a22ag","updated":"20240612133711"},"Children":[{"Type":"NodeText","Data":"陈藏器∶按 鱼合作鼍字，《本经》作鼍。鱼之别名，已出《本经》。今以鼍为 ，非也，宜能吐气成雾致雨，力至猛，能攻陷江岸，性嗜睡，恒目闭，形如龙，大长者，自啮其尾，极难死，声甚可畏。人于穴中掘之，百人掘亦须百人牵，一人掘亦须一人牵，不然终不可出。梁周兴嗣常食其肉，后为鼍所喷，便为恶疮，此物灵强，不可食。既是龙类，宜去其鱼。肘后方∶治五尸。鼍肝一具，熟煮切食尽，亦用蒜齑食之。"}]},{"ID":"20240612133439-6fckfi5","Type":"NodeThematicBreak","Properties":{"id":"20240612133439-6fckfi5"}},{"ID":"20240612133609-4qeaol6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133609-4qeaol6","updated":"20240612133616"},"Children":[{"Type":"NodeText","Data":"鼍甲《本经逢原》"}]},{"ID":"20240612133609-pd9m3g1","Type":"NodeParagraph","Properties":{"id":"20240612133609-pd9m3g1","updated":"20240612133609"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名鼍鱼"}]},{"ID":"20240612133609-r30o8xm","Type":"NodeParagraph","Properties":{"id":"20240612133609-r30o8xm","updated":"20240612133609"},"Children":[{"Type":"NodeText","Data":"酸微温小毒。"}]},{"ID":"20240612133609-zi3tya8","Type":"NodeParagraph","Properties":{"id":"20240612133609-zi3tya8","updated":"20240612133609"},"Children":[{"Type":"NodeText","Data":"《本经》治心腹症瘕伏坚、积聚寒热，女子小腹阴中相引痛，崩中下血五色及疮疥死肌。"}]},{"ID":"20240612133609-s2q2o55","Type":"NodeParagraph","Properties":{"id":"20240612133609-s2q2o55","updated":"20240612133609"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"《本经》鼍甲所主之证多属厥阴，其功在平肝木。治血杀虫与鳖相类，亦能治阴疟。《千金》有 甲煎，今药肆多悬之。云能辟蠹，亦杀虫之意。"}]},{"ID":"20240612133439-3ieyua0","Type":"NodeThematicBreak","Properties":{"id":"20240612133439-3ieyua0"}},{"ID":"20240612133440-7w44kta","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133440-7w44kta","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鼍甲"}]},{"ID":"20240612133440-wcxict3","Type":"NodeParagraph","Properties":{"id":"20240612133440-wcxict3","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612133440-3mkmde5","Type":"NodeParagraph","Properties":{"id":"20240612133440-3mkmde5","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" Tuó Jiǎ"}]},{"ID":"20240612133440-hguk3yi","Type":"NodeParagraph","Properties":{"id":"20240612133440-hguk3yi","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612133440-yv19hgw","Type":"NodeParagraph","Properties":{"id":"20240612133440-yv19hgw","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 鮀鱼甲（《本经》）。"}]},{"ID":"20240612133440-5eogoo3","Type":"NodeParagraph","Properties":{"id":"20240612133440-5eogoo3","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612133440-im8ctf3","Type":"NodeParagraph","Properties":{"id":"20240612133440-im8ctf3","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240612133440-c2fxz07","Type":"NodeParagraph","Properties":{"id":"20240612133440-c2fxz07","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612133440-ajwqnrm","Type":"NodeParagraph","Properties":{"id":"20240612133440-ajwqnrm","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 为鼍科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"扬子鳄"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鳞甲"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612133440-cfnenx2","Type":"NodeParagraph","Properties":{"id":"20240612133440-cfnenx2","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612133440-ildwyur","Type":"NodeParagraph","Properties":{"id":"20240612133440-ildwyur","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 分布安徽、江苏、浙江、江西一带。"}]},{"ID":"20240612133440-7ongiu3","Type":"NodeParagraph","Properties":{"id":"20240612133440-7ongiu3","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612133440-spscbkm","Type":"NodeParagraph","Properties":{"id":"20240612133440-spscbkm","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 扬子鳄，又名：鮀鱼（《本经》），鼍（陶弘景），土龙（《续博物志》），鼍龙（《纲目》），猪婆龙。"}]},{"ID":"20240612133440-hx729es","Type":"NodeParagraph","Properties":{"id":"20240612133440-hx729es","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"形如蜥蜴而体极长大，大者全长达2米余。全体被有鳞甲。头部扁平；吻短而宽，钝圆；上颌海侧有圆锥状齿18枚，下颌海侧齿为19枚。眼大，有上下眼睑及瞬膜，瞳孔垂直。耳孔呈裂缝状，有瓣膜可合闭。鼻孔1对，开口于吻前端上方，有活瓣，能自由开闭。颈部较细，有2对具纵棱的鳞片。躯干部较扁平。背面近黑绿色，散有黄色斑纹，背部由前至后有17排矩形鳞片，横贯于背部的有6行，鳞上有纵棱。腹面灰色。腹部鳞片28排，略成矩形。前肢5指，无蹼；后肢较长，具4趾，趾间有蹼；指、趾端均有爪。尾长而侧扁，有灰黑色相间的环纹，近尾端甲片锋利。"}]},{"ID":"20240612133440-e88dgyd","Type":"NodeParagraph","Properties":{"id":"20240612133440-e88dgyd","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"栖于江河沿岸，掘穴而居。以鱼、蛙、鼠、龟、鳖及鸟类等动物为食。10月至翌年3月底冬眠。"}]},{"ID":"20240612133440-ptu41qb","Type":"NodeParagraph","Properties":{"id":"20240612133440-ptu41qb","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"本动物的肉（鼍肉）亦供药用，另详专条。"}]},{"ID":"20240612133440-3vmf2bk","Type":"NodeParagraph","Properties":{"id":"20240612133440-3vmf2bk","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612133440-re73n28","Type":"NodeParagraph","Properties":{"id":"20240612133440-re73n28","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"酥炙或酒炙用。\""}]},{"ID":"20240612133440-poesyip","Type":"NodeParagraph","Properties":{"id":"20240612133440-poesyip","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612133440-59qc6nk","Type":"NodeParagraph","Properties":{"id":"20240612133440-59qc6nk","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 辛，温，有毒。"}]},{"ID":"20240612133440-br3dpy6","Type":"NodeParagraph","Properties":{"id":"20240612133440-br3dpy6","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，微温。\""}]},{"ID":"20240612133440-5j9bith","Type":"NodeParagraph","Properties":{"id":"20240612133440-5j9bith","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"有毒。\""}]},{"ID":"20240612133440-vasv881","Type":"NodeParagraph","Properties":{"id":"20240612133440-vasv881","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"甘，平。有小毒。\""}]},{"ID":"20240612133440-6go6gql","Type":"NodeParagraph","Properties":{"id":"20240612133440-6go6gql","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"酸，微温，有毒。\""}]},{"ID":"20240612133440-bgvhyvm","Type":"NodeParagraph","Properties":{"id":"20240612133440-bgvhyvm","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612133440-bfkdior","Type":"NodeParagraph","Properties":{"id":"20240612133440-bfkdior","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：\"蜀漆为之使。畏狗胆、甘遂、芫花。\""}]},{"ID":"20240612133440-fc42vyd","Type":"NodeParagraph","Properties":{"id":"20240612133440-fc42vyd","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612133440-90u4snz","Type":"NodeParagraph","Properties":{"id":"20240612133440-90u4snz","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 逐瘀，消积，杀虫，治症瘕积聚，崩中带下，疮疥，恶疮。"}]},{"ID":"20240612133440-nbs8z64","Type":"NodeParagraph","Properties":{"id":"20240612133440-nbs8z64","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主心腹症瘕、伏坚、积聚、寒热，女子崩中下血五色，小腹阴中相引痛，疮疥死肌。\""}]},{"ID":"20240612133440-fb8dqck","Type":"NodeParagraph","Properties":{"id":"20240612133440-fb8dqck","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"主五邪涕泣时惊，腰中重痛，小儿气癃，眦溃。\""}]},{"ID":"20240612133440-tb9uiif","Type":"NodeParagraph","Properties":{"id":"20240612133440-tb9uiif","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治妇人带下，除腹内血，积聚伏坚相引结痛。\""}]},{"ID":"20240612133440-l15gd4n","Type":"NodeParagraph","Properties":{"id":"20240612133440-l15gd4n","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"主恶疮，腹内症瘕。\"\"炙烧浸酒，主瘰疬，杀虫，瘘疮，风顽疥瘙。功用同鳖甲。\""}]},{"ID":"20240612133440-fq6odgr","Type":"NodeParagraph","Properties":{"id":"20240612133440-fq6odgr","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"⑤《日华子太草》；\"治齿疳匿宣露。\""}]},{"ID":"20240612133440-lyaw56u","Type":"NodeParagraph","Properties":{"id":"20240612133440-lyaw56u","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治阴疟。\""}]},{"ID":"20240612133440-rdzx0ma","Type":"NodeParagraph","Properties":{"id":"20240612133440-rdzx0ma","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"⑦《本草图经》：\"皮及骨，烧灰研末，米饮服，主肠风痔疾。甚者加入红鸡冠花末，白矾灰末和之，空腹服。\""}]},{"ID":"20240612133440-haxnlv3","Type":"NodeParagraph","Properties":{"id":"20240612133440-haxnlv3","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612133440-0wqn61s","Type":"NodeParagraph","Properties":{"id":"20240612133440-0wqn61s","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《纲目》：\"鼍甲，所主诸证，多属厥阴，其功只在平肝木、治血、杀虫也。《千金方》治风癞有鼍甲汤；今药肆多悬之，云能辟蠹，亦杀虫之意。\""}]},{"ID":"20240612133440-m0m7kcy","Type":"NodeParagraph","Properties":{"id":"20240612133440-m0m7kcy","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612133440-yleom4t","Type":"NodeParagraph","Properties":{"id":"20240612133440-yleom4t","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612133440-txl41hm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612133440-txl41hm","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鼍甲"}]},{"ID":"20240612133440-ikluf15","Type":"NodeParagraph","Properties":{"id":"20240612133440-ikluf15","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612133440-co6rwyi","Type":"NodeParagraph","Properties":{"id":"20240612133440-co6rwyi","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" Tuó Jiǎ"}]},{"ID":"20240612133440-ryggn6y","Type":"NodeParagraph","Properties":{"id":"20240612133440-ryggn6y","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612133440-p2vg7nf","Type":"NodeParagraph","Properties":{"id":"20240612133440-p2vg7nf","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" （鱼它）鱼甲"}]},{"ID":"20240612133440-h89vd64","Type":"NodeParagraph","Properties":{"id":"20240612133440-h89vd64","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612133440-in7c1ey","Type":"NodeParagraph","Properties":{"id":"20240612133440-in7c1ey","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" Chinese alligator scales"}]},{"ID":"20240612133440-elo3dya","Type":"NodeParagraph","Properties":{"id":"20240612133440-elo3dya","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612133440-b1pry8n","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612133440-b1pry8n","updated":"20240612133440"},"Children":[{"ID":"20240612133440-eudguqb","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612133440-eudguqb","updated":"20240612133440"},"Children":[{"ID":"20240612133440-vg4tlvw","Type":"NodeParagraph","Properties":{"id":"20240612133440-vg4tlvw","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"陆矾《诗疏》：鼍形似蜥蝎，四足，长丈余，生卵大如鹅卵，甲如铠，今合药鼍鱼甲是也。其皮坚厚，可以冒鼓。"}]}]}]},{"ID":"20240612133440-zcalg3g","Type":"NodeParagraph","Properties":{"id":"20240612133440-zcalg3g","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"2.《本草拾遗》：鼍，口内涎有毒。"}]},{"ID":"20240612133440-lbq1ixo","Type":"NodeParagraph","Properties":{"id":"20240612133440-lbq1ixo","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》：《图经》云，（鼍）生湖畔土窟中，形似守宫而大，长丈余，背尾俱有鳞甲。今江南诸州皆有之。"}]},{"ID":"20240612133440-6phro8z","Type":"NodeParagraph","Properties":{"id":"20240612133440-6phro8z","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612133440-op017mx","Type":"NodeParagraph","Properties":{"id":"20240612133440-op017mx","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鼍科动物扬子鳄的甲片。"}]},{"ID":"20240612133440-c2c97qj","Type":"NodeParagraph","Properties":{"id":"20240612133440-c2c97qj","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Alligator sinensis Fauvel"}]},{"ID":"20240612133440-yjikc5p","Type":"NodeParagraph","Properties":{"id":"20240612133440-yjikc5p","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612133440-p7067qq","Type":"NodeParagraph","Properties":{"id":"20240612133440-p7067qq","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 生态环境：生活于江河、湖泊附近沿岩芦苇及小竹丛的地方。掘穴而居。吃鱼、虾、螺、蛙、鼠等。"}]},{"ID":"20240612133440-9g4h5m7","Type":"NodeParagraph","Properties":{"id":"20240612133440-9g4h5m7","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江苏、安徽、浙江、江西等地。"}]},{"ID":"20240612133440-zilx2zm","Type":"NodeParagraph","Properties":{"id":"20240612133440-zilx2zm","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612133440-nw3ksgg","Type":"NodeParagraph","Properties":{"id":"20240612133440-nw3ksgg","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 扬子鳄，全长2m左右。头及躯干部较扁平，吻钝而宽圆，项部较细，尾长而侧扁。背面近于黑绿色，散有黄斑，幼时列为明显。腹面灰色，尾部有灰黑相间的环纹，颈部有2对具纵棱的鳞片。背部由前至后有17横行方形鳞片，每行4-6枚，形成4-6纵行排列整齐的棱鳞；腹面有26-28横行略呈方形的平滑鳞片，每行8-10枚；尾鳞方形，由前向后约35排，尾背前段有两行纵鳞，后半段纵鳞合为1行，四肢较短，后肢较前肢略长，均枯木逢春以鳞片，指5，无蹼；趾4，半蹼；内侧3指、趾具爪。泄殖孔纵置，雄性交接器成单。"}]},{"ID":"20240612133440-x749vx5","Type":"NodeParagraph","Properties":{"id":"20240612133440-x749vx5","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612133440-yl3rivu","Type":"NodeParagraph","Properties":{"id":"20240612133440-yl3rivu","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 外壳表皮由β-角蛋白质（β-keratin）组成。鳞甲含大量骨胶原。"}]},{"ID":"20240612133440-gtij68v","Type":"NodeParagraph","Properties":{"id":"20240612133440-gtij68v","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612133440-4bv6nai","Type":"NodeParagraph","Properties":{"id":"20240612133440-4bv6nai","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《纲目》：酥炙或酒炙用。"}]},{"ID":"20240612133440-lrndo2q","Type":"NodeParagraph","Properties":{"id":"20240612133440-lrndo2q","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612133440-1muos7l","Type":"NodeParagraph","Properties":{"id":"20240612133440-1muos7l","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240612133440-726r84a","Type":"NodeParagraph","Properties":{"id":"20240612133440-726r84a","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612133440-8syxhax","Type":"NodeParagraph","Properties":{"id":"20240612133440-8syxhax","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 味辛；性温；有毒"}]},{"ID":"20240612133440-cul9pae","Type":"NodeParagraph","Properties":{"id":"20240612133440-cul9pae","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612133440-r0se38v","Type":"NodeParagraph","Properties":{"id":"20240612133440-r0se38v","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：“畏狗胆、甘遂、芫花。”"}]},{"ID":"20240612133440-vr9easg","Type":"NodeParagraph","Properties":{"id":"20240612133440-vr9easg","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612133440-r92ycwl","Type":"NodeParagraph","Properties":{"id":"20240612133440-r92ycwl","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 化瘀；消积；杀虫。主症瘕积聚；崩中带下；疮疥；恶疮；肠风痔疾"}]},{"ID":"20240612133440-fmy7vir","Type":"NodeParagraph","Properties":{"id":"20240612133440-fmy7vir","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612133440-8rq1808","Type":"NodeParagraph","Properties":{"id":"20240612133440-8rq1808","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240612133440-i2e62vr","Type":"NodeParagraph","Properties":{"id":"20240612133440-i2e62vr","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612133440-tb6ho65","Type":"NodeParagraph","Properties":{"id":"20240612133440-tb6ho65","updated":"20240612133440"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612133441-ub4v1b4","Type":"NodeThematicBreak","Properties":{"id":"20240612133441-ub4v1b4"}},{"ID":"20240612133442-xq4iwde","Type":"NodeParagraph","Properties":{"id":"20240612133442-xq4iwde"}}]}