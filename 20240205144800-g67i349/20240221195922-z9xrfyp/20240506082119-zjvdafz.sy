{"ID":"20240506082119-zjvdafz","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506082119-zjvdafz","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506082119-zjvdafz\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506082119-1rpjqcl\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240506082119-1rpjqcl\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240506082119-1rpjqcl\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"229燕屎","type":"doc","updated":"20240821145923"},"Children":[{"ID":"20240626181141-07vbau2","Type":"NodeParagraph","Properties":{"id":"20240626181141-07vbau2","updated":"20240626181141"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626181141-fl147tz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821145747-563g7di","Type":"NodeParagraph","Properties":{"id":"20240821145747-563g7di","updated":"20240821145747"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 576px;","style":"width: 566px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"燕子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/燕子-20240821145747-hmpm9zj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 566px;\" parent-style=\"width: 576px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821145830-y0mlsjq","Type":"NodeParagraph","Properties":{"id":"20240821145830-y0mlsjq","updated":"20240821145835"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"燕子 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/燕子 1-20240821145830-uf2m4ag.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 348px;","style":"width: 338px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"燕子5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/燕子5-20240626182455-i29co9j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 338px;\" parent-style=\"width: 348px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626182244-ejyrv9e","Type":"NodeParagraph","Properties":{"id":"20240626182244-ejyrv9e","updated":"20240821145923"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626182244-f143qpl.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"燕子 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/燕子 2-20240821145922-20sa00f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626182006-dg1ypcj","Type":"NodeParagraph","Properties":{"id":"20240626182006-dg1ypcj","updated":"20240821145939"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"燕子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/燕子-20240626182006-n6rur6r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 588px;","style":"width: 578px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"燕子2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/燕子2-20240626182117-akf2goz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 578px;\" parent-style=\"width: 588px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612115820-wlvhfla","Type":"NodeThematicBreak","Properties":{"id":"20240612115820-wlvhfla"}},{"ID":"20240626180511-v2kdlrx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240626180511-v2kdlrx","updated":"20240626180520"},"Children":[{"Type":"NodeText","Data":"燕屎《神农本草经》"}]},{"ID":"20240626180511-40afiep","Type":"NodeParagraph","Properties":{"id":"20240626180511-40afiep","updated":"20240626180511"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240626180511-bng07ak","Type":"NodeParagraph","Properties":{"id":"20240626180511-bng07ak","updated":"20240626180511"},"Children":[{"Type":"NodeText","Data":"主蛊毒鬼注，逐不样邪气，破五癃，利小便。生平谷。"}]},{"ID":"20240626180511-0ji31qn","Type":"NodeParagraph","Properties":{"id":"20240626180511-0ji31qn","updated":"20240626180511"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生高山。"}]},{"ID":"20240626180511-57kq08v","Type":"NodeParagraph","Properties":{"id":"20240626180511-57kq08v","updated":"20240626180511"},"Children":[{"Type":"NodeText","Data":"案《说文》云：燕、元鸟也，尔口、布翅枝尾，象形作巢，避戊已，乙元鸟也，齐鲁谓之乙，取其名自呼，象形或作乱。《尔雅》云：燕乱。《夏小正》云，二月来降，燕乃睇。《传》云：燕、乙也，九月陟元鸟，蛰，《传》云：元鸟者，燕也。"}]},{"ID":"20240612115820-tlupjw8","Type":"NodeThematicBreak","Properties":{"id":"20240612115820-tlupjw8"}},{"ID":"20240612115821-mf81gz0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115821-mf81gz0","updated":"20240612115825"},"Children":[{"Type":"NodeText","Data":"燕屎《本草经集注》"}]},{"ID":"20240612115821-qlwebb1","Type":"NodeParagraph","Properties":{"id":"20240612115821-qlwebb1","updated":"20240612115821"},"Children":[{"Type":"NodeText","Data":"味辛，平，有毒。主治蛊毒，鬼疰，逐不祥邪气，破五癃，利小便。生高谷山平谷。"}]},{"ID":"20240612115821-uw8mfys","Type":"NodeParagraph","Properties":{"id":"20240612115821-uw8mfys","updated":"20240612115821"},"Children":[{"Type":"NodeText","Data":"燕有两种，有胡、有越。紫胸轻小者是越燕，不入药用，胸斑黑声大者是胡燕。世呼胡燕为夏候，其作窠喜长，人言有容一匹绢者，令家富。窠亦入药用，与屎同，多以作汤洗浴，治小儿惊邪也。窠户有北向及尾倔色白者，皆数百岁燕，食之延年。凡燕肉不可食，令人入水为蛟龙所吞，亦不宜杀之。"}]},{"ID":"20240612115759-jtxltg4","Type":"NodeThematicBreak","Properties":{"id":"20240612115759-jtxltg4"}},{"ID":"20240612115810-ob9lvtl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115810-ob9lvtl","updated":"20240612115814"},"Children":[{"Type":"NodeText","Data":"燕屎《本草蒙筌》"}]},{"ID":"20240612115810-liy01qv","Type":"NodeParagraph","Properties":{"id":"20240612115810-liy01qv","updated":"20240612115810"},"Children":[{"Type":"NodeText","Data":"味辛，气平。有毒。种有两般，用宜细认。胸紫赤而轻小者名"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"越燕"},{"Type":"NodeText","Data":"，入剂不宜；胸斑黑而声大者名"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胡燕"},{"Type":"NodeText","Data":"，治病方效。春夏则巢屋舍梁楣而孳育，秋冬乃入树孔土穴以蛰藏。"}]},{"ID":"20240612115810-nb5gnhy","Type":"NodeParagraph","Properties":{"id":"20240612115810-nb5gnhy","updated":"20240612115810"},"Children":[{"Type":"NodeText","Data":"作窠喜长，堪容疋绢。屎积地上，依时采收。治久疟最灵，临发日搅酒一升，捧两手，取气渐熏鼻中，疟即禁止；驱蛊毒尤验，空心时炒香三合，丸独蒜，（独蒜捣烂丸之。）用汤竟送腹内，蛊立泄除。杀鬼疰而逐不祥，破五癃以利小水。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"},{"Type":"NodeText","Data":"捣敷痔，亦能出虫。杀则不宜，死者方可。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"窠"},{"Type":"NodeText","Data":"取哺雏处所，作汤可浴小儿。悉逐惊痫，尽除疮疥。"}]},{"ID":"20240612115759-wvnbg8o","Type":"NodeThematicBreak","Properties":{"id":"20240612115759-wvnbg8o"}},{"ID":"20240612115800-1ym0n2p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115800-1ym0n2p","updated":"20240612115805"},"Children":[{"Type":"NodeText","Data":"燕屎《证类本草》"}]},{"ID":"20240612115800-dd0rf8d","Type":"NodeParagraph","Properties":{"id":"20240612115800-dd0rf8d","updated":"20240612115800"},"Children":[{"Type":"NodeText","Data":"味辛，平，有毒。主蛊毒鬼疰，逐不祥邪气，破五癃，利小便。生高山平谷。"}]},{"ID":"20240612115800-604w1nj","Type":"NodeParagraph","Properties":{"id":"20240612115800-604w1nj","updated":"20240612115800"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶燕有两种，有胡、有越。紫胸轻小者是越燕，不入药用；胸斑黑，声大者是胡燕。俗呼胡燕为夏候，其作窠喜长，人言有容一疋绢者，令家富。窠亦入药用，与屎同，多以作汤洗浴，疗小儿惊邪也。窠户有北向及尾倔（求勿切）色白者，皆是数百岁燕，食之延年。"}]},{"ID":"20240612115800-hzn96n3","Type":"NodeParagraph","Properties":{"id":"20240612115800-hzn96n3","updated":"20240612115800"},"Children":[{"Type":"NodeText","Data":"凡燕肉不可食，令人入水为蛟所吞。亦不宜杀之。唐本注云∶《别录》云，胡燕卵，主水浮肿。肉，出痔虫。越燕屎亦疗痔，杀虫，去目翳也。今按陈藏器草云∶燕屎，有毒。主疟。"}]},{"ID":"20240612115800-jqbdqan","Type":"NodeParagraph","Properties":{"id":"20240612115800-jqbdqan","updated":"20240612115800"},"Children":[{"Type":"NodeText","Data":"取方寸匕，令患者发日平旦，和酒一升，搅调。病患两手捧碗当鼻下承取气，慎勿入口，毒人。又，主蛊毒。取屎三合，熬令香，独头蒜十枚，去皮，和捣为丸。服三丸，如梧桐子，蛊当随痢下而出。臣禹锡等谨按孟诜云∶石燕，在乳穴石洞中者，冬月采之，堪食。余者不中，只可治病，食如常法，取二十枚，投酒一斗中渍之，三日后取饮。每服一、二盏，随性多少，甚益气力。日华子云∶石燕，暖，无毒。壮阳，暖腰膝，添精补髓，益气，润皮肤，缩小便，御风寒，岚瘴，瘟疫气。"}]},{"ID":"20240612115800-ckrvqrq","Type":"NodeParagraph","Properties":{"id":"20240612115800-ckrvqrq","updated":"20240612115800"},"Children":[{"Type":"NodeText","Data":"图经文具雀卵条下。"}]},{"ID":"20240612115800-lyrwjup","Type":"NodeParagraph","Properties":{"id":"20240612115800-lyrwjup","updated":"20240612115800"},"Children":[{"Type":"NodeText","Data":"外台秘要治蠼 尿疮，绕身匝即死。以燕巢中土、猪脂、苦酒和敷之。肘后方∶治卒大腹水病。取胡燕卵中黄，顿吞十枚。葛氏方∶卒得浸淫疮，有汁，多发于心，不早疗，周匝身则杀人。胡燕窠中土，水和敷之。又方∶若石淋者，取燕屎末，以冷水服五钱匕，旦服至食时当尿石水。贾相公牛经牛有非时吃着杂虫，腹胀满。取燕子粪一合，以水浆二升相和，灌之，效。"}]},{"ID":"20240612115801-tlzltdf","Type":"NodeThematicBreak","Properties":{"id":"20240612115801-tlzltdf"}},{"ID":"20240612115851-7ci2lbb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115851-7ci2lbb","updated":"20240612115855"},"Children":[{"Type":"NodeText","Data":"燕屎《新修本草》"}]},{"ID":"20240612115851-gvbie4z","Type":"NodeParagraph","Properties":{"id":"20240612115851-gvbie4z","updated":"20240612115851"},"Children":[{"Type":"NodeText","Data":"味辛，平，有毒。主蛊毒鬼疰，逐不祥邪气，破五癃，利小便。生高山平谷。"}]},{"ID":"20240612115851-i4s1v4u","Type":"NodeParagraph","Properties":{"id":"20240612115851-i4s1v4u","updated":"20240612115851"},"Children":[{"Type":"NodeText","Data":"燕有两种，有胡、有越。紫胸，轻小者是越燕，不入药用；胸斑黑，声大者是胡燕。俗呼胡燕为夏侯，其作窠喜长，人言有容一匹绢者，令家富。窠亦入药用，与屎同，多以作汤洗浴，疗向及尾屈色白者，皆是数百岁燕，食之延年。凡燕肉不可食，令人入水为蛟龙所吞，亦不宜杀之。"}]},{"ID":"20240612115851-r395ywl","Type":"NodeParagraph","Properties":{"id":"20240612115851-r395ywl","updated":"20240612115851"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶胡燕卵，主水浮肿。肉，出痔虫。越燕屎，亦疗痔，杀虫，去目翳也。"}]},{"ID":"20240612115857-8lflatl","Type":"NodeThematicBreak","Properties":{"id":"20240612115857-8lflatl"}},{"ID":"20240612115903-nmurhnc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115903-nmurhnc","updated":"20240612115908"},"Children":[{"Type":"NodeText","Data":"燕屎《名医别录》"}]},{"ID":"20240612115903-g559qyz","Type":"NodeParagraph","Properties":{"id":"20240612115903-g559qyz","updated":"20240612115903"},"Children":[{"Type":"NodeText","Data":"有毒．又，胡燕卵，主治水浮肿．肉，出痔虫．"}]},{"ID":"20240612115903-nsp8hmc","Type":"NodeParagraph","Properties":{"id":"20240612115903-nsp8hmc","updated":"20240612115903"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶燕屎，味辛，平．主蛊毒鬼注，逐不祥邪气，破五癃，利小便．生高山平谷．"}]},{"ID":"20240612115903-p8xhme2","Type":"NodeThematicBreak","Properties":{"id":"20240612115903-p8xhme2"}},{"ID":"20240612115912-tx72tlc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115912-tx72tlc","updated":"20240612115919"},"Children":[{"Type":"NodeText","Data":"燕屎《千金翼方》"}]},{"ID":"20240612115912-e5g6w9s","Type":"NodeParagraph","Properties":{"id":"20240612115912-e5g6w9s","updated":"20240612115912"},"Children":[{"Type":"NodeText","Data":"味辛平，有毒。主蛊毒鬼疰，逐不祥邪气，破五癃，利小便，生高山平谷。"}]},{"ID":"20240612115912-953r593","Type":"NodeThematicBreak","Properties":{"id":"20240612115912-953r593"}},{"ID":"20240612115923-8hw6c1w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612115923-8hw6c1w","updated":"20240612115928"},"Children":[{"Type":"NodeText","Data":"燕屎《冯氏锦囊秘录》"}]},{"ID":"20240612115923-8bm6vrc","Type":"NodeParagraph","Properties":{"id":"20240612115923-8bm6vrc","updated":"20240612115923"},"Children":[{"Type":"NodeText","Data":"燕屎，治久疟最灵，临发日搅酒熏鼻即止，驱蛊毒尤验，空心时炒三合，丸独蒜。"}]},{"ID":"20240612115923-z9p2ry7","Type":"NodeParagraph","Properties":{"id":"20240612115923-z9p2ry7","updated":"20240612115923"},"Children":[{"Type":"NodeText","Data":"用汤送服，蛊即泄除，杀鬼疰不详，破五癃利水。窠作汤，可浴小儿，悉逐惊痫，尽除疮疥。"}]},{"ID":"20240612115924-19agbos","Type":"NodeThematicBreak","Properties":{"id":"20240612115924-19agbos"}},{"ID":"20240612115925-93hygpt","Type":"NodeParagraph","Properties":{"id":"20240612115925-93hygpt"}}]}