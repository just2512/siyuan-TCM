nkDest","Data":"assets/image-20240821163059-sta577n.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 602px;\" parent-style=\"width: 612px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌贼 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌贼 4-20240821163336-s834gyz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627095115-3t66odg","Type":"NodeParagraph","Properties":{"id":"20240627095115-3t66odg","updated":"20240821163946"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 657px;","style":"width: 647px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌贼 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌贼 7-20240821163946-mwvb8ai.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 647px;\" parent-style=\"width: 657px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 526px;","style":"width: 516px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌贼 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌贼 3-20240821163013-ou3iwbt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 516px;\" parent-style=\"width: 526px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821163028-haolnlf","Type":"NodeParagraph","Properties":{"id":"20240821163028-haolnlf","updated":"20240821163028"}},{"ID":"20240821162634-9yved8x","Type":"NodeParagraph","Properties":{"id":"20240821162634-9yved8x","updated":"20240821162927"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"章鱼、墨鱼（乌贼）、鱿鱼分辨"}]},{"ID":"20240821162913-03kqz03","Type":"NodeParagraph","Properties":{"id":"20240821162913-03kqz03","updated":"20240821162913"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 435px;","style":"width: 425px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"章鱼、墨鱼、鱿鱼"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/章鱼、墨鱼、鱿鱼-20240821162913-gouly9p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 425px;\" parent-style=\"width: 435px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612132625-1gvs0s7","Type":"NodeThematicBreak","Properties":{"id":"20240612132625-1gvs0s7"}},{"ID":"20240612132626-cw7geob","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132626-cw7geob","updated":"20240612132631"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《神农本草经》"}]},{"ID":"20240612132626-thd7f2r","Type":"NodeParagraph","Properties":{"id":"20240612132626-thd7f2r","updated":"20240612132626"},"Children":[{"Type":"NodeText","Data":"味咸微温。"}]},{"ID":"20240612132626-etbs7ds","Type":"NodeParagraph","Properties":{"id":"20240612132626-etbs7ds","updated":"20240612132626"},"Children":[{"Type":"NodeText","Data":"主女子漏下，赤白经汁，血闭，阴蚀，肿痛，寒热，症瘕，无子。生池泽。"}]},{"ID":"20240612132626-2ya07rt","Type":"NodeParagraph","Properties":{"id":"20240612132626-2ya07rt","updated":"20240612132626"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生东海，取无时。"}]},{"ID":"20240612132626-y7b79al","Type":"NodeParagraph","Properties":{"id":"20240612132626-y7b79al","updated":"20240612132626"},"Children":[{"Type":"NodeText","Data":"案《说文》云：鲗、鸟鲗，鱼名，或作鲫，左思赋，有乌贼。刘逵注云：乌贼鱼，腹中有墨。陶宏景云：此是（暴鸟）乌所化作，今其口脚具存，犹相似尔。"}]},{"ID":"20240612132514-4gmtsc7","Type":"NodeThematicBreak","Properties":{"id":"20240612132514-4gmtsc7"}},{"ID":"20240612132531-awcnyiq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132531-awcnyiq","updated":"20240612132535"},"Children":[{"Type":"NodeText","Data":"乌贼骨《本草便读》"}]},{"ID":"20240612132531-bu42szy","Type":"NodeParagraph","Properties":{"id":"20240612132531-bu42szy","updated":"20240612132531"},"Children":[{"Type":"NodeText","Data":"入肝经治血分之 ．带下崩中．经方有考．去湿浊味咸温兼涩．虫疳下痢．审证随施．点眼则去翳摩星．贴疮可燥脓收水．（乌贼骨一名海螵蛸．乃乌贼鱼中之骨也．味咸性温．乃肝经血分药．虽系血药．而其质又燥．故能治女人崩带淋浊．一切下部虫疳淫 之疾．内经虽云治血枯．然观其经文全旨．毕竟非肝经之血枯．是肝经之湿浊．故又能点目翳．燥脓疮．自可想见其功用耳．）"}]},{"ID":"20240612132514-je3sst2","Type":"NodeThematicBreak","Properties":{"id":"20240612132514-je3sst2"}},{"ID":"20240612132516-2oszeba","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132516-2oszeba","updated":"20240612132524"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《本草思辨录》"}]},{"ID":"20240612132516-dqhipnv","Type":"NodeParagraph","Properties":{"id":"20240612132516-dqhipnv","updated":"20240612132516"},"Children":[{"Type":"NodeText","Data":"乌贼鱼由寒乌入水而化，其骨白，骨为肾之合，而色白则属肺，是为摄气入血，故能化血中之气。肉腴润而骨独燥，又能燥血中之湿。血闭症瘕、惊气入腹、腹痛环脐者，血为气郁也。漏下赤白、阴蚀、肿痛、疮多脓汁者，血为湿乱也。治以乌贼鱼骨，如磁石之引针，琥珀之拾芥矣。"}]},{"ID":"20240612132516-hox00gh","Type":"NodeParagraph","Properties":{"id":"20240612132516-hox00gh","updated":"20240612132516"},"Children":[{"Type":"NodeText","Data":"再以惊气入腹之旨绎之，惊则气乱，入腹则气下趋而靡所止。乌贼鱼能于水中下碇粘石，又何患惊气之不止哉。"}]},{"ID":"20240612132503-fd8xpc3","Type":"NodeThematicBreak","Properties":{"id":"20240612132503-fd8xpc3"}},{"ID":"20240612132504-keersav","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132504-keersav","updated":"20240612132509"},"Children":[{"Type":"NodeText","Data":"海螵蛸《本草从新》"}]},{"ID":"20240612132504-9grxus3","Type":"NodeParagraph","Properties":{"id":"20240612132504-9grxus3","updated":"20240612132504"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名乌贼骨．宣、通血脉、祛寒湿．"}]},{"ID":"20240612132504-kpjb777","Type":"NodeParagraph","Properties":{"id":"20240612132504-kpjb777","updated":"20240612132504"},"Children":[{"Type":"NodeText","Data":"咸走血．温和血．入肝肾血分．通血脉．祛寒湿．治血枯．（内经、血枯治之以乌 骨．）"}]},{"ID":"20240612132504-kt47tf6","Type":"NodeParagraph","Properties":{"id":"20240612132504-kt47tf6","updated":"20240612132504"},"Children":[{"Type":"NodeText","Data":"止吐衄．肠风崩漏．涩久虚泻痢．腹痛环脐．阴蚀肿痛．（烧末酒服．）疟证疳虫．目翳泪出．"}]},{"ID":"20240612132504-nyttd6h","Type":"NodeParagraph","Properties":{"id":"20240612132504-nyttd6h","updated":"20240612132504"},"Children":[{"Type":"NodeText","Data":"耳出脓．（性能燥脓收水、为末、加麝少许、掺入．）厥阴、少阴（肝、肾．）经病．肉、酸平．益气．强志益人．通月经．出东海．亦名墨鱼．（腹中有墨、书字逾年乃灭、常吐黑水、自罩其身、捕者、即于水黑处取之．）取骨．鱼卤浸．炙黄．恶附子、白芨、白蔹．能淡盐．（舌肿出血如泉、蒲黄等分．为细末、涂之、跌破出血、乌贼骨末敷．）"}]},{"ID":"20240612132319-o57dkf9","Type":"NodeThematicBreak","Properties":{"id":"20240612132319-o57dkf9"}},{"ID":"20240612132437-32ac71x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132437-32ac71x","updated":"20240612132441"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《千金翼方》"}]},{"ID":"20240612132437-e961b60","Type":"NodeParagraph","Properties":{"id":"20240612132437-e961b60","updated":"20240612132437"},"Children":[{"Type":"NodeText","Data":"味咸，微温，无毒。主女子漏下赤白，经汁血闭，阴蚀肿痛，寒热症瘕，无子，惊气入腹，腹痛环脐，阴中寒肿，令人有子。又止疮多脓汁不燥。"}]},{"ID":"20240612132437-u1u84b5","Type":"NodeParagraph","Properties":{"id":"20240612132437-u1u84b5","updated":"20240612132437"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"}]},{"ID":"20240612132437-i0ryr0f","Type":"NodeParagraph","Properties":{"id":"20240612132437-i0ryr0f","updated":"20240612132437"},"Children":[{"Type":"NodeText","Data":"味酸，平。主益气，强志。生东海池泽，取无时。"}]},{"ID":"20240612132343-fqtsmux","Type":"NodeThematicBreak","Properties":{"id":"20240612132343-fqtsmux"}},{"ID":"20240612132427-ae8xxq7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132427-ae8xxq7","updated":"20240612132432"},"Children":[{"Type":"NodeText","Data":"海螵蛸《本草新编》"}]},{"ID":"20240612132427-dl20hha","Type":"NodeParagraph","Properties":{"id":"20240612132427-dl20hha","updated":"20240612132427"},"Children":[{"Type":"NodeText","Data":"海螵蛸，味咸，微温，无毒。主女子漏下赤白，经行血闭，阴蚀肿痛。又治妇人寒热瘕症，惊风入腹，环腹痛，去目肿浮翳，收疮口腐脓，治哮症最神效。亦药笼中宜备之物。"}]},{"ID":"20240612132427-fnqvskj","Type":"NodeParagraph","Properties":{"id":"20240612132427-fnqvskj","updated":"20240612132427"},"Children":[{"Type":"NodeText","Data":"或问海螵蛸即乌贼鱼骨，他本云服之令人有子，先生何不言也？曰∶男子肾虚则精涸，女子肝伤则血枯，皆非有子之兆。乌贼鱼骨虽入肝肾，不能大补其精血，徒借此物，即终年饱食，又何能生子哉。（〔批〕翻前人旧案，实有至理，非好辨也。）"}]},{"ID":"20240612132343-2r52ag9","Type":"NodeThematicBreak","Properties":{"id":"20240612132343-2r52ag9"}},{"ID":"20240612132403-3utg9p7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132403-3utg9p7","updated":"20240612132421"},"Children":[{"Type":"NodeText","Data":"乌贼骨《本经逢原》"}]},{"ID":"20240612132403-hm6vmcf","Type":"NodeParagraph","Properties":{"id":"20240612132403-hm6vmcf","updated":"20240612132453"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即乌贼骨，俗名海鳔蛸"}]},{"ID":"20240612132403-ljpv137","Type":"NodeParagraph","Properties":{"id":"20240612132403-ljpv137","updated":"20240612132403"},"Children":[{"Type":"NodeText","Data":"咸微温无毒。"}]},{"ID":"20240612132403-2b5332r","Type":"NodeParagraph","Properties":{"id":"20240612132403-2b5332r","updated":"20240612132455"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"乌贼骨，厥阴血分之药，兼入少阴，其味咸而走血，故治血枯血瘕，经闭崩带，阴蚀肿痛，丈夫阴肿，下痢疳疾，厥阴本药也。寒热疟疾，聋瘿，少腹痛，阴痛，厥阴经病也。目翳流泪，厥阴窍病也。厥阴为藏血室，少阴为隐曲之地，故诸血病、阴病皆治之。按∶《素问》云，有病胸胁支满妨于食，病至则先闻腥臊臭，出清液，吐血，四肢软，目眩，时时前后血病，名曰血枯。得之年少时有所大脱血，或醉入房中气竭肝伤，月事衰少不来，治之以四乌 骨、一 茹为末。丸以雀卵，大如小豆，每服五丸，饮以鲍鱼汁，所以利肠中及伤肝也，观此入厥阴血分可知。"}]},{"ID":"20240612132343-jyd91y1","Type":"NodeThematicBreak","Properties":{"id":"20240612132343-jyd91y1"}},{"ID":"20240612132345-5inhupm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132345-5inhupm","updated":"20240612132351"},"Children":[{"Type":"NodeText","Data":"乌贼骨《医学入门》"}]},{"ID":"20240612132345-wjr2mm8","Type":"NodeParagraph","Properties":{"id":"20240612132345-wjr2mm8","updated":"20240612132345"},"Children":[{"Type":"NodeText","Data":"乌贼骨温燥脓汁，阴痈耳聋目翳泣，止痢杀虫心腹疼，消肿更治崩漏急，通经破癖令生儿，肉味酸平志气立。"}]},{"ID":"20240612132345-soklm71","Type":"NodeParagraph","Properties":{"id":"20240612132345-soklm71","updated":"20240612132345"},"Children":[{"Type":"NodeText","Data":"又名墨鱼，性嗜乌， 出腹中墨以混水自卫，乌见以为死，往喙之，乃卷取入水而食之，故谓之乌贼，骨名海鳔蛸。味咸，微温，无毒。止疮多脓汁不燥，丈夫阴头痈久不愈者，为末敷之良。妇人阴蚀肿痛，烧末酒调服之。又治耳聋有水、目中赤白、浮翳泪出、小儿疳眼。止下痢，为末，粥中调食之。杀小虫并水中虫，惊气入腹，腹痛环脐，水肿。主女子崩漏赤白。血枯经闭寒热，血 血瘕，阴寒无子。凡使，水煮一时，炙令黄，去皮，细研，水飞，日干。恶白蔹、白芨、附子。腹中墨，主血刺心痛，醋磨服之，甚者醋炒服之。肉，味酸、平，益气强志，常服令人有子。有无骨者谓之柔鱼，须长直，味尤佳，风浪稍急，即以须粘石为缆。"}]},{"ID":"20240612132319-s4cjc74","Type":"NodeThematicBreak","Properties":{"id":"20240612132319-s4cjc74"}},{"ID":"20240612132332-t2es4pv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132332-t2es4pv","updated":"20240612132337"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《本草述钩元》"}]},{"ID":"20240612132332-s6c94rq","Type":"NodeParagraph","Properties":{"id":"20240612132332-s6c94rq","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"鱼性嗜乌。每自浮水上。飞乌啄之。乃卷取入水而食之。故名。其骨即海螵蛸。"}]},{"ID":"20240612132332-rrn5f4t","Type":"NodeParagraph","Properties":{"id":"20240612132332-rrn5f4t","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"出近海州郡。形若革囊。口在腹下。八足聚生。口旁无鳞。有长须。血色及胆。正黑如墨。"}]},{"ID":"20240612132332-moabjxa","Type":"NodeParagraph","Properties":{"id":"20240612132332-moabjxa","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"书字逾年则减。外皮亦黑。内肉则白。只背上有骨。形如樗蒲子而稍长。两头尖。色白轻脆。重重有纹。指甲刮之。可为末也。"}]},{"ID":"20240612132332-5kwuvos","Type":"NodeParagraph","Properties":{"id":"20240612132332-5kwuvos","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"味咸。气微温。入足厥阴少阴经。为血证要药。主治女子赤白漏下经汁。及血枯伤肝。"}]},{"ID":"20240612132332-38ilonq","Type":"NodeParagraph","Properties":{"id":"20240612132332-38ilonq","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"吐血下血。并疗血闭血瘕。治惊气入腹。腹痛环脐。丈夫阴中肿痛。女子小户嫁痛。其味咸而走血。为厥阴血分药。故血枯血瘕经闭崩带下痢疳疾。厥阴本病也。寒热疟疾聋瘿少腹痛阴痛。厥阴经病也。目翳流泪。厥阴窍病也。毒问有病胸胁支满者。妨于食。病至则先闻腥臊臭。出清液。先唾血。四肢清。目眩。时时前后血。病名血枯。得之年少时有所大脱血。"}]},{"ID":"20240612132332-4mp3366","Type":"NodeParagraph","Properties":{"id":"20240612132332-4mp3366","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"或醉入房中。气竭肝伤。故月事衰少不来。治之以四乌贼骨一茹为末。丸以雀卵。大如小豆。每服五丸。饮以鲍鱼汁。所以利肠中及伤肝也。观此则其入厥阴血分无疑。（濒湖）眼中热泪。及一切浮翳。研末和蜜点之。同蒲黄末。敷舌肿出血如泉。同槐花末吹鼻。止衄血。"}]},{"ID":"20240612132332-zgp48a9","Type":"NodeParagraph","Properties":{"id":"20240612132332-zgp48a9","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"治诸目翳。乌贼骨五灵脂等分。为细末。熟猪肝切片蘸食。日二。鼻疮疳。乌贼骨白芨各一钱。轻粉二字。为脏毒肠风。及内痔下血。日久一钱。木贼汤下。三日后。服〔论〕乌贼骨既治女子赤白漏下经汁。及血崩唾血下血矣。而又主血闭月事衰少不来。"}]},{"ID":"20240612132332-dvjdo1w","Type":"NodeParagraph","Properties":{"id":"20240612132332-dvjdo1w","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"症所用冲任足。"}]},{"ID":"20240612132332-m9w5hq9","Type":"NodeParagraph","Properties":{"id":"20240612132332-m9w5hq9","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"之益书概本病化血。"}]},{"ID":"20240612132332-gn05sql","Type":"NodeParagraph","Properties":{"id":"20240612132332-gn05sql","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"寒乌入方书多而实。"}]},{"ID":"20240612132332-irgg9z5","Type":"NodeParagraph","Properties":{"id":"20240612132332-irgg9z5","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"脏。血岂独耳聋亦能疗之。即如惊气痛腹。缪氏谓肝主惊。惊入肝胆。则营气不和。"}]},{"ID":"20240612132332-gf8kied","Type":"NodeParagraph","Properties":{"id":"20240612132332-gf8kied","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"缪氏云。血病多热者。勿用。"}]},{"ID":"20240612132332-cnhmvsw","Type":"NodeParagraph","Properties":{"id":"20240612132332-cnhmvsw","updated":"20240612132332"},"Children":[{"Type":"NodeText","Data":"〔辨治〕勿用沙鱼骨。其形极似。但以上文顺者是真。横者为假。水煮一时。炙令黄。"}]},{"ID":"20240612132319-v7t8nyj","Type":"NodeThematicBreak","Properties":{"id":"20240612132319-v7t8nyj"}},{"ID":"20240612132321-7y8iuc8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132321-7y8iuc8","updated":"20240612132325"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《本草崇原》"}]},{"ID":"20240612132321-b12jzul","Type":"NodeParagraph","Properties":{"id":"20240612132321-b12jzul","updated":"20240612132321"},"Children":[{"Type":"NodeText","Data":"气味咸，微温，无毒。主治女子赤白漏下经汁，血闭，阴蚀肿痛，寒热症瘕，无子。"}]},{"ID":"20240612132321-pge7lgg","Type":"NodeParagraph","Properties":{"id":"20240612132321-pge7lgg","updated":"20240612132321"},"Children":[{"Type":"NodeText","Data":"（乌贼鱼生海中，形若革囊，口在腹下，八足聚生于口旁，无鳞有须，皮黑肉白。其背上只生一骨，浓三四分，两头小，中央阔，色洁白，质轻脆，如通草，重重有纹，以指甲可刮为末。腹中血及胆正黑如墨汁，可以书字，但逾年则迹灭，唯存空纸尔。其骨《素问》名写骨，今名海螵蛸。）"}]},{"ID":"20240612132321-nm47388","Type":"NodeParagraph","Properties":{"id":"20240612132321-nm47388","updated":"20240612132321"},"Children":[{"Type":"NodeText","Data":"乌贼骨禀金水之精，金能平木，故治血闭肿痛，寒热症瘕。水能益髓，故治赤白漏下，女子无子。《素问》∶治年少时，有所大脱血，或醉入房，中气竭肝伤，故月事衰少不来，病名血枯，治以四乌 骨，一茹 为末，丸以雀卵，大如小豆，每服五丸，饮以鲍鱼汁。"}]},{"ID":"20240612132251-8m4gs6j","Type":"NodeThematicBreak","Properties":{"id":"20240612132251-8m4gs6j"}},{"ID":"20240612132307-r7ls4cp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132307-r7ls4cp","updated":"20240612132314"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《证类本草》"}]},{"ID":"20240612132307-7uzaroq","Type":"NodeParagraph","Properties":{"id":"20240612132307-7uzaroq","updated":"20240612132307"},"Children":[{"Type":"NodeText","Data":"味咸，微温。无毒。主女子漏下赤白经汁，血闭，阴蚀肿痛，寒热，症瘕，无子，惊气入腹，腹痛环脐，阴中寒肿，令人有子。又止疮多脓汁不燥。"}]},{"ID":"20240612132307-2s9k9e4","Type":"NodeParagraph","Properties":{"id":"20240612132307-2s9k9e4","updated":"20240612132307"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"},{"Type":"NodeText","Data":"味酸，平，主益气强志。生东海池泽。取无时。（恶白蔹、白芨、附子。）"}]},{"ID":"20240612132307-fambmzm","Type":"NodeParagraph","Properties":{"id":"20240612132307-fambmzm","updated":"20240612132307"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此是 （音剥）乌所化作，今其口脚具存，犹相似尔。用其骨亦炙之。其鱼腹中有墨，今作好墨用之。唐本注云∶此鱼骨，疗牛、马目中障翳，亦疗人目中翳，用之良也。今按陈藏器本草云∶乌贼鱼骨，主小儿痢下，细研为末，饮下之。亦主妇人血瘕，杀小虫并水中虫，投骨于井中，虫死。腹中墨，主血刺心痛，醋摩服之。海人云∶昔秦王东游，弃算袋于海，化为此鱼。其形一如算袋，两带极长，墨犹在腹也。臣禹锡等谨按蜀本图经云∶ 乌所化也，今目口尚在背上，骨浓三、四分，今出越州。苏恭引《音义》云∶无 字，言是鸭字，乃以《尔雅》中鹎 。一名雅乌，小而多群，腹下白者为之。《图经》又云∶背上骨浓三、四分，则非水乌也。今据《尔雅》中自有 、乌 ，是水乌。似 ，短颈，腹翅紫白，背上绿色，名字既与《图经》相符，则 乌所化明矣。药性论云∶乌贼鱼骨，使，有小毒。止妇人漏血，主耳聋。孟诜云∶乌贼骨，主目中一切浮翳。细研和蜜点之。又，骨末治眼中热泪。日华子云∶乌贼鱼，通月经。骨疗血崩，杀虫。心痛甚者，炒其墨，醋调服也。又名缆鱼，须脚悉在眼前，风波稍急，即以须粘石为缆。"}]},{"ID":"20240612132307-0y3zkkp","Type":"NodeParagraph","Properties":{"id":"20240612132307-0y3zkkp","updated":"20240612132307"},"Children":[{"Type":"NodeText","Data":"图经曰∶乌贼鱼，出东海池泽，今近海州郡皆有之。云是 （音剥）乌所化，今其口脚犹存，颇相似，故名乌贼，能吸波 墨以溷水，所以自卫，使水匿不能为人所害。又云∶性嗜乌，每暴水上，有飞乌过，谓其已死，便啄其腹，则卷取而食之，以此得名，言为乌之贼害也。形若革囊，口在腹下，八足聚生口旁。只一骨，浓三、四分，似小舟轻虚而白。又有两须如带，可以自缆，故别名缆鱼。《南越志》云∶乌贼有碇，遇风便虬前一须下碇而住碇，亦缆之义也。腹中血及胆，正如墨，中以书也，世谓乌贼怀墨而知礼，故俗谓是海若白事小吏。其肉食之益人，取无时。其无骨者名柔鱼。又更有章举、石距二物，与此相类而差大，味更珍好，食品所贵重，然不入药用，故略焉。"}]},{"ID":"20240612132307-53h5mnt","Type":"NodeParagraph","Properties":{"id":"20240612132307-53h5mnt","updated":"20240612132307"},"Children":[{"Type":"NodeText","Data":"食疗云∶骨，主小儿、大人下痢，炙令黄，去皮细研成粉，粥中调服之良。其骨能消目中一切浮翳。细研和蜜点之，妙。又，点马眼热泪甚良。久食之，主绝嗣无子，益精。其鱼腹中有墨一片，堪用书字。雷公云∶凡使，勿用沙鱼骨，缘真相似，只是上纹横，不入药中用。凡使，要上纹顺，浑用血卤作水浸，并煮一伏时了，漉出，于屋下掘一地坑，可盛得前件乌贼鱼骨多少，先烧坑子，去炭灰了，盛药一宿，至明取出用之，其效倍多。圣惠方∶治伤寒热毒瓦斯攻眼，生赤白翳。用乌贼鱼骨一两，不用大皮，杵末，入龙脑少许令细，日三、四度，取少许点之。外台秘要∶治 疡风及三年。酢磨乌贼鱼骨，先布磨肉赤，即敷之。千金方∶治妇人小户嫁痛。乌贼骨烧末，酒下方寸匕，日三服。又方∶治丈夫阴头痈，师不能治。乌贼骨末粉敷之，良。经验方∶治疳眼。乌贼鱼骨、牡蛎并等分，为末糊丸，如皂子大。每服用猪子肝内煮，肝熟为度，和肝食，用煮肝泔水下，三、两服。子母秘录∶治小儿重舌。烧乌贼鱼骨和鸡子黄，敷之喉及舌上。南越记∶乌贼鱼自浮于水上，乌见以为死，往啄之，乃卷取入水，故谓乌贼。今鸦乌化为之也。素问云∶乌贼鱼，主女子血枯。丹房镜源∶乌贼鱼骨，淡盐。"}]},{"ID":"20240612132307-vdwwvi2","Type":"NodeParagraph","Properties":{"id":"20240612132307-vdwwvi2","updated":"20240612132307"},"Children":[{"Type":"NodeText","Data":"衍义曰∶乌贼鱼，干置。四方∶人炙食之。又取骨镂为细。研细，水飞，澄下，比去水，晒干之，熟蜜和得所，点目中翳，缓取效。"}]},{"ID":"20240612132251-cb7lu5a","Type":"NodeThematicBreak","Properties":{"id":"20240612132251-cb7lu5a"}},{"ID":"20240612132253-gswjw1r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132253-gswjw1r","updated":"20240612132258"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《新修本草》"}]},{"ID":"20240612132253-sdngvu5","Type":"NodeParagraph","Properties":{"id":"20240612132253-sdngvu5","updated":"20240612132253"},"Children":[{"Type":"NodeText","Data":"味咸，微温，无毒。主女子漏下赤白经汁，血闭，阴蚀，肿痛，寒热，症瘕，无子。疗惊气入腹，腹痛环脐，阴中寒肿，令人有子，又止疮多脓汁不燥。肉，味酸，平，主益气强志。生东海池泽，取无时。"}]},{"ID":"20240612132253-qgtix70","Type":"NodeParagraph","Properties":{"id":"20240612132253-qgtix70","updated":"20240612132253"},"Children":[{"Type":"NodeText","Data":"恶白蔹、白芨。此是 乌所化作，今其口脚具存，犹相似尔。用其骨亦炙之。其鱼腹中有墨，今作好墨用之。"}]},{"ID":"20240612132253-3v5rzii","Type":"NodeParagraph","Properties":{"id":"20240612132253-3v5rzii","updated":"20240612132253"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240612132253-wb9jtiw","Type":"NodeParagraph","Properties":{"id":"20240612132253-wb9jtiw","updated":"20240612132253"},"Children":[{"Type":"NodeText","Data":"此鱼骨，疗牛马目中障翳，亦疗人目翳，用之良也。"}]},{"ID":"20240612132013-m5kehtw","Type":"NodeThematicBreak","Properties":{"id":"20240612132013-m5kehtw"}},{"ID":"20240612132231-lkk6br7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132231-lkk6br7","updated":"20240612132236"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《要药分剂》"}]},{"ID":"20240612132231-cjspv7t","Type":"NodeParagraph","Properties":{"id":"20240612132231-cjspv7t","updated":"20240612132231"},"Children":[{"Type":"NodeText","Data":"一名海螵蛸。味咸。性微温。无毒。禀水中之阳气以生。可升可降。阴中阳也。"}]},{"ID":"20240612132231-f9171f3","Type":"NodeParagraph","Properties":{"id":"20240612132231-f9171f3","updated":"20240612132231"},"Children":[{"Type":"NodeText","Data":"恶白芨、白蔹、附子。又名墨鱼。"}]},{"ID":"20240612132231-vd5sa2w","Type":"NodeParagraph","Properties":{"id":"20240612132231-vd5sa2w","updated":"20240612132231"},"Children":[{"Type":"NodeText","Data":"【主治】主赤白漏下。经汁血闭。阴蚀肿痛。寒热症瘕。无子。（本经）惊气入腹。腹痛环脐治妇人疟。消瘿出如泉。（【归经】入肝肾二经。为通经络祛寒湿之品。（肝经血分药）【前论】丹溪曰。经闭有有余不足二症。有余者血滞。不足者肝伤。乌贼骨所治。是肝伤血时珍曰。此厥阴血分药也。味咸走血。故血枯。血瘕。经闭崩带。下痢疳疾。"}]},{"ID":"20240612132231-mbxfqk2","Type":"NodeParagraph","Properties":{"id":"20240612132231-mbxfqk2","updated":"20240612132231"},"Children":[{"Type":"NodeText","Data":"也。寒热疟疾。聋瘿。少腹痛阴痛。厥阴经病也。目翳流泪。厥阴窍病也。厥阴属血。故诸血病皆治之。"}]},{"ID":"20240612132231-omyy7rf","Type":"NodeParagraph","Properties":{"id":"20240612132231-omyy7rf","updated":"20240612132231"},"Children":[{"Type":"NodeText","Data":"【禁忌】经疏曰。其气味咸温。血病多热者。勿用。"}]},{"ID":"20240612132231-8yxqqd1","Type":"NodeParagraph","Properties":{"id":"20240612132231-8yxqqd1","updated":"20240612132231"},"Children":[{"Type":"NodeText","Data":"【炮制】备要曰。凡使。以鱼卤浸。炙黄用。"}]},{"ID":"20240612132013-ysrglqp","Type":"NodeThematicBreak","Properties":{"id":"20240612132013-ysrglqp"}},{"ID":"20240612132221-54z8gv5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132221-54z8gv5","updated":"20240612132226"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《神农本草经赞》"}]},{"ID":"20240612132221-65oog7i","Type":"NodeParagraph","Properties":{"id":"20240612132221-65oog7i","updated":"20240612132221"},"Children":[{"Type":"NodeText","Data":"味咸微温。主女子漏下赤白经汁。血闭阴蚀肿痛。寒热症瘕。无子。生池泽。"}]},{"ID":"20240612132221-e7y09z2","Type":"NodeParagraph","Properties":{"id":"20240612132221-e7y09z2","updated":"20240612132221"},"Children":[{"Type":"NodeText","Data":"东游弃袋。海畔浮漂。化由。骨类螵蛸。缆风须劲。墨腹消。纵横纹辨。白胜英瑶。"}]},{"ID":"20240612132221-8fmhwej","Type":"NodeParagraph","Properties":{"id":"20240612132221-8fmhwej","updated":"20240612132221"},"Children":[{"Type":"NodeText","Data":"陈藏器曰。海人云是秦王东游弃算袋于海所化。曹操乐府。流澌浮漂。苏颂曰。陶隐居言。此是鸟所化。尔雅。鸟。李时珍曰。骨名海螵蛸。色白脆。尔雅疏。螵蛸螳螂卵也。日华子曰。鱼遇风波。即以两须下注粘石如缆。故名缆鱼。苏颂曰。鱼腹中有墨。能吸波墨。令水溷黑以自卫。雷论。沙鱼骨亦相似。纹顺者真。横者假。宋史志。有美英瑶。"}]},{"ID":"20240612132013-dlxhogy","Type":"NodeThematicBreak","Properties":{"id":"20240612132013-dlxhogy"}},{"ID":"20240612132113-ylfdzqx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132113-ylfdzqx","updated":"20240612132119"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨《本草经解》"}]},{"ID":"20240612132113-0hxxzde","Type":"NodeParagraph","Properties":{"id":"20240612132113-0hxxzde","updated":"20240612132113"},"Children":[{"Type":"NodeText","Data":"气微温．味咸．无毒．主女子赤白漏下．经汁血闭．阴蚀肿痛．寒热症瘕．无子．（ ）"}]},{"ID":"20240612132113-g6xb8gn","Type":"NodeParagraph","Properties":{"id":"20240612132113-g6xb8gn","updated":"20240612132113"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨气微温．禀天春和之木气．入足厥阴肝经．味咸无毒．得地北方之水味．入足少阴肾经．气味升多于降．阳也．女子以血为主．肝为藏血之脏．肝血不藏．则赤白漏下．其主之者．气温以达之也．肝藏血．血枯则血闭．其主之者．味咸以通之也．肾为藏精之脏．主阴户隐曲之地．肝为厥阴．其经络阴器．其筋结阴器．二经湿浊下注．则阴蚀肿痛．其主之者．气温可以燥湿．味咸可以消肿也．寒热症瘕者．症瘕而发寒热也．乌贼骨．咸可软坚．温可散寒热也．男子肾虚．则精竭无子．女子肝伤．则血枯无子．咸温入肝肾．通血益精．令人有子也．"}]},{"ID":"20240612132113-2cc1j5v","Type":"NodeParagraph","Properties":{"id":"20240612132113-2cc1j5v","updated":"20240612132113"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612132113-larnkcs","Type":"NodeParagraph","Properties":{"id":"20240612132113-larnkcs","updated":"20240612132113"},"Children":[{"Type":"NodeText","Data":"乌贼鱼骨同芦茹雀卵丸．治肝伤血枯．同橘红末．寒食面丸．治骨鲠．同蒲黄末．治舌肿出血不止．同北味、杞子、淫羊藿、归身丸．久服令人多子．"}]},{"ID":"20240612132611-tchfj4u","Type":"NodeThematicBreak","Properties":{"id":"20240612132611-tchfj4u"}},{"ID":"20240612132612-8vrzhpy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132612-8vrzhpy","updated":"20240612132617"},"Children":[{"Type":"NodeText","Data":"乌贼鱼《本草纲目》"}]},{"ID":"20240612132612-ok8jkea","Type":"NodeParagraph","Properties":{"id":"20240612132612-ok8jkea","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"「释名」墨鱼、缆鱼，干者名鲞。骨名海螵蛸。"}]},{"ID":"20240612132612-jhzmw4w","Type":"NodeParagraph","Properties":{"id":"20240612132612-jhzmw4w","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"「气味」肉：酸、平、无毒。骨：咸、微温、无毒辣"}]},{"ID":"20240612132612-59qarv1","Type":"NodeParagraph","Properties":{"id":"20240612132612-59qarv1","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612132612-zzmjvd1","Type":"NodeParagraph","Properties":{"id":"20240612132612-zzmjvd1","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"肉：益气强体；益人，通月经。"}]},{"ID":"20240612132612-8r4z54t","Type":"NodeParagraph","Properties":{"id":"20240612132612-8r4z54t","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"骨："}]},{"ID":"20240612132612-nh8opgo","Type":"NodeParagraph","Properties":{"id":"20240612132612-nh8opgo","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"1、赤白目翳（伤寒之后热毒攻眼所致）。用乌贼骨一两，去皮，研为末，加龙脑少许点眼。一天三次。又方，用乌贼骨、五灵脂，等分，把熟猪肝切成片，蘸药末吃。一天吃二次。"}]},{"ID":"20240612132612-sek7xej","Type":"NodeParagraph","Properties":{"id":"20240612132612-sek7xej","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"2、夜盲。用乌贼骨半斤，研为末，化黄蜡三两，调末捏成铜钱大的饼子。每次取一饼，夹入切开的二片猪肝中，扎定，加淘米水半确定煮熟吃下"}]},{"ID":"20240612132612-t8kv93i","Type":"NodeParagraph","Properties":{"id":"20240612132612-t8kv93i","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"3、疳眼流泪。用乌贼骨、牡蛎，等分为末，加糊做成丸了，如皂角子大。每次用一丸同猪肝一具，以淘米水煮熟吃。"}]},{"ID":"20240612132612-fzvwssv","Type":"NodeParagraph","Properties":{"id":"20240612132612-fzvwssv","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"4、耳底出脓。用乌贼骨半钱、麝香二分，共研为末，吹入耳中。"}]},{"ID":"20240612132612-pa9exxs","Type":"NodeParagraph","Properties":{"id":"20240612132612-pa9exxs","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"5、小儿脐高。用乌贼骨、胭脂为末，油调敷搽。"}]},{"ID":"20240612132612-2qpay0c","Type":"NodeParagraph","Properties":{"id":"20240612132612-2qpay0c","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"6、疔疮恶肿。先刺出血。用乌贼骨研末敷上，疔即出头。"}]},{"ID":"20240612132612-602f3fk","Type":"NodeParagraph","Properties":{"id":"20240612132612-602f3fk","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"7、小儿痰。用多年的乌贼骨末，米汤送服一钱。"}]},{"ID":"20240612132612-plk0e9l","Type":"NodeParagraph","Properties":{"id":"20240612132612-plk0e9l","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"8、小便血淋。用乌贼骨末一钱，生地黄汁调服。又方；用乌贼骨、生地黄赤茯苓等分为末，每服一次，柏叶、四前汤送下。"}]},{"ID":"20240612132612-0oglj2l","Type":"NodeParagraph","Properties":{"id":"20240612132612-0oglj2l","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"9、突然吐血。用乌贼骨末，米汤送服二钱。"}]},{"ID":"20240612132612-14b7shn","Type":"NodeParagraph","Properties":{"id":"20240612132612-14b7shn","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"10、跌破出血。用乌贼骨研末敷上。"}]},{"ID":"20240612132612-mmn1d84","Type":"NodeParagraph","Properties":{"id":"20240612132612-mmn1d84","updated":"20240612132612"},"Children":[{"Type":"NodeText","Data":"11、有囊湿痒。用乌贼骨、蒲黄研末扑敷。"}]},{"ID":"20240612132547-kbedppf","Type":"NodeThematicBreak","Properties":{"id":"20240612132547-kbedppf"}},{"ID":"20240612132548-l80rfn7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132548-l80rfn7","updated":"20240612132552"},"Children":[{"Type":"NodeText","Data":"海螵蛸《中药炮制》"}]},{"ID":"20240612132548-au6rq8q","Type":"NodeParagraph","Properties":{"id":"20240612132548-au6rq8q","updated":"20240612132548"},"Children":[{"Type":"NodeText","Data":"『来源』本品为乌贼科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无针乌贼"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"金乌贼"},{"Type":"NodeText","Data":"的干燥内壳。"}]},{"ID":"20240612132548-3a810c1","Type":"NodeParagraph","Properties":{"id":"20240612132548-3a810c1","updated":"20240612132548"},"Children":[{"Type":"NodeText","Data":"『常用名』乌贼骨、墨鱼骨、黑鱼骨。"}]},{"ID":"20240612132548-yk6c449","Type":"NodeParagraph","Properties":{"id":"20240612132548-yk6c449","updated":"20240612132548"},"Children":[{"Type":"NodeText","Data":"『产地』浙江、福建。"}]},{"ID":"20240612132548-ycwp8r8","Type":"NodeParagraph","Properties":{"id":"20240612132548-ycwp8r8","updated":"20240612132548"},"Children":[{"Type":"NodeText","Data":"『炮制方法』拣去杂质，用水浸漂3～5天，每天换水一次，捞起滤干，日晒夜露3天，干后用小刀削去硬壳，切段使用。取其止血作用，取净海螵蛸放入铁罐内，放入武火中煅呈焦黑色即可。"}]},{"ID":"20240612132548-pgg7did","Type":"NodeParagraph","Properties":{"id":"20240612132548-pgg7did","updated":"20240612132548"},"Children":[{"Type":"NodeText","Data":"『用量』6～9克。"}]},{"ID":"20240612132557-1o2srg1","Type":"NodeThematicBreak","Properties":{"id":"20240612132557-1o2srg1"}},{"ID":"20240612132559-36ihmwu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132559-36ihmwu","updated":"20240612132604"},"Children":[{"Type":"NodeText","Data":"海螵蛸《本草简要方》"}]},{"ID":"20240612132559-82wt2ly","Type":"NodeParagraph","Properties":{"id":"20240612132559-82wt2ly","updated":"20240612132559"},"Children":[{"Type":"NodeText","Data":"（乌贼鱼骨）主治。通血脉。去风湿。止吐衄。喉痹。耳聋。舌肿。出血。鼻血。环脐腹痛。泻痢。"}]},{"ID":"20240612132559-v5j7yfb","Type":"NodeParagraph","Properties":{"id":"20240612132559-v5j7yfb","updated":"20240612132559"},"Children":[{"Type":"NodeText","Data":"小便淋血。阴囊湿痒。（和蒲黄扑）阴中肿痛妇人气竭肝伤寒热症瘕。吐血。下血。血枯。"}]},{"ID":"20240612132559-r78c4nv","Type":"NodeParagraph","Properties":{"id":"20240612132559-r78c4nv","updated":"20240612132559"},"Children":[{"Type":"NodeText","Data":"血崩。赤白漏下。经闭阴蚀肿痛疳疮。脐疮。耳。出脓。久服益精。乌贼骨散。乌贼骨冰片各一钱。研末。点日三四次。治目肤翳。又方。海螵蛸末一钱。生地汁调服。治小便血淋。"}]},{"ID":"20240612132013-c261nex","Type":"NodeThematicBreak","Properties":{"id":"20240612132013-c261nex"}},{"ID":"20240612132014-of0f1i8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612132014-of0f1i8","updated":"20240612132022"},"Children":[{"Type":"NodeText","Data":"乌贼骨《中药学》"}]},{"ID":"20240612132014-n75w4n4","Type":"NodeParagraph","Properties":{"id":"20240612132014-n75w4n4","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【科属与药用部分】本品为软件动物乌贼科乌贼鱼的骨状内壳。"}]},{"ID":"20240612132014-ucj8fkn","Type":"NodeParagraph","Properties":{"id":"20240612132014-ucj8fkn","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【性味与归经】咸，微温。入肝、肾经。"}]},{"ID":"20240612132014-07r2z83","Type":"NodeParagraph","Properties":{"id":"20240612132014-07r2z83","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【功效】收敛止血，固精止带，制酸，敛疮。"}]},{"ID":"20240612132014-4bh13ji","Type":"NodeParagraph","Properties":{"id":"20240612132014-4bh13ji","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于崩漏下血，创伤出血等症。"}]},{"ID":"20240612132014-h3idi6x","Type":"NodeParagraph","Properties":{"id":"20240612132014-h3idi6x","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"乌贼骨有良好的止血作用，对崩漏下血，可与茜草合用；如体虚的常和黄耆、白朮、党参、阿胶、熟地等同用。对外伤出血，可用乌贼骨粉搽敷，也有止血的功效。"}]},{"ID":"20240612132014-vapt8mv","Type":"NodeParagraph","Properties":{"id":"20240612132014-vapt8mv","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"2.用于遗精及妇女赤白带下等症。"}]},{"ID":"20240612132014-1orqfn3","Type":"NodeParagraph","Properties":{"id":"20240612132014-1orqfn3","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"乌贼骨长于收敛，故能涩精、止带，常合山茱萸、沙苑子、菟丝子等用于遗精；合白芷、牡蛎等用于带下。"}]},{"ID":"20240612132014-90gdet3","Type":"NodeParagraph","Properties":{"id":"20240612132014-90gdet3","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"3.用于胃脘疼痛、泛吐酸水等症。"}]},{"ID":"20240612132014-z7lt23x","Type":"NodeParagraph","Properties":{"id":"20240612132014-z7lt23x","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"乌贼骨功能收敛止血，且能中和胃酸，以疗胃及十二指肠溃疡病，泛吐酸水，或溃疡病出血，常合象贝、甘草研末同用。"}]},{"ID":"20240612132014-1k8xm5c","Type":"NodeParagraph","Properties":{"id":"20240612132014-1k8xm5c","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"4.用于疮疡、湿疹、溃疡久不愈合等症。"}]},{"ID":"20240612132014-q0cdaoa","Type":"NodeParagraph","Properties":{"id":"20240612132014-q0cdaoa","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"乌贼骨外用又能收湿生肌，可与黄连、黄柏、青焦等研末外敷，以疗疮疡湿疹。"}]},{"ID":"20240612132014-ome5xuk","Type":"NodeParagraph","Properties":{"id":"20240612132014-ome5xuk","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【处方用名】炙乌贼骨、海螵蛸（用麸皮炒至微黄色用）。"}]},{"ID":"20240612132014-rmmelld","Type":"NodeParagraph","Properties":{"id":"20240612132014-rmmelld","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。如研粉吞服，每次五分至一钱。外用适量。"}]},{"ID":"20240612132014-d7vvm59","Type":"NodeParagraph","Properties":{"id":"20240612132014-d7vvm59","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【按语】乌贼骨又名海螵蛸，它与桑螵蛸虽同称为螵蛸，且都有收涩作用，但海螵蛸具有止血、制酸的特长，也能固精止带，然无补益作用；而桑螵蛸则以固精缩尿为特长，具有益肾的功效。乌贼骨功专收涩，多服久服，常有引起大便秘结的现象。"}]},{"ID":"20240612132014-38zhmop","Type":"NodeParagraph","Properties":{"id":"20240612132014-38zhmop","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【方剂举例】固冲汤《衷中参西录》：乌贼骨、茜草、棕炭，五倍子，龙骨、牡蛎、萸肉，白朮，黄耆，杭芍。治血崩。"}]},{"ID":"20240612132014-ggrf7tt","Type":"NodeParagraph","Properties":{"id":"20240612132014-ggrf7tt","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"【文献摘录】《本经》：「主女子赤白漏下，经汁血闭，阴蚀肿痛，寒热症瘕。」"}]},{"ID":"20240612132014-fsn6ue5","Type":"NodeParagraph","Properties":{"id":"20240612132014-fsn6ue5","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"《别录》：「止疮多脓汁不燥。」"}]},{"ID":"20240612132014-by3ux0a","Type":"NodeParagraph","Properties":{"id":"20240612132014-by3ux0a","updated":"20240612132014"},"Children":[{"Type":"NodeText","Data":"《大明本草》：「疗血崩。」"}]},{"ID":"20240612132015-gv2ouxm","Type":"NodeThematicBreak","Properties":{"id":"20240612132015-gv2ouxm"}},{"ID":"20240612132016-ll5lvhn","Type":"NodeParagraph","Properties":{"id":"20240612132016-ll5lvhn"}}]}