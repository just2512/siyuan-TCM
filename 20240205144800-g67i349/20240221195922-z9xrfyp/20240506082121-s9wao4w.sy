\"width: 513px;\" parent-style=\"width: 523px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821142137-3uc2ubm","Type":"NodeParagraph","Properties":{"id":"20240821142137-3uc2ubm","updated":"20240821142137"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 591px;","style":"width: 581px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄牛 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄牛 2-20240821142137-frnp6qh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 581px;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 664px;","style":"width: 654px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黄牛3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黄牛3-20240626162539-ta8wz2z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 654px;\" parent-style=\"width: 664px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626161702-b4gdzwl","Type":"NodeParagraph","Properties":{"id":"20240626161702-b4gdzwl","updated":"20240821142053"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 620px;","style":"width: 610px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水牛"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水牛-20240716153754-93uvlco.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 610px;\" parent-style=\"width: 620px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 663px;","style":"width: 653px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水牛"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水牛-20240626161702-eu8m8mg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 653px;\" parent-style=\"width: 663px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612112350-8153i6t","Type":"NodeParagraph","Properties":{"id":"20240612112350-8153i6t","updated":"20240612112359"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：（牛角腮为牛科动物黄牛或水牛角中的骨质角髓）"}]},{"ID":"20240612111238-rnrsgov","Type":"NodeThematicBreak","Properties":{"id":"20240612111238-rnrsgov"}},{"ID":"20240612111238-fnmileo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111238-fnmileo","updated":"20240612111905"},"Children":[{"Type":"NodeText","Data":"牛角鳃《神农本草经》"}]},{"ID":"20240612111900-lpu0mj0","Type":"NodeParagraph","Properties":{"id":"20240612111900-lpu0mj0"},"Children":[{"Type":"NodeText","Data":"牛黄味苦，平，有小毒。治惊痫，寒热，热盛， 狂，痉，除邪，逐鬼。生平泽。 牛角鳃，温，无毒。下闭血，瘀血疼痛，女人带下血。 髓，补中，填骨髓，久服增年。 胆，治惊，寒热，可丸药。"}]},{"ID":"20240612111306-5qtv6j3","Type":"NodeThematicBreak","Properties":{"id":"20240612111306-5qtv6j3"}},{"ID":"20240612111307-z1yf58w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111307-z1yf58w","updated":"20240612111311"},"Children":[{"Type":"NodeText","Data":"牛角鳃《千金翼方》"}]},{"ID":"20240612111307-7p1x9yo","Type":"NodeParagraph","Properties":{"id":"20240612111307-7p1x9yo","updated":"20240612111307"},"Children":[{"Type":"NodeText","Data":"下闭血，瘀血疼痛，女人带下血。燔之。味苦，无毒。"}]},{"ID":"20240612112213-4l3n9ae","Type":"NodeThematicBreak","Properties":{"id":"20240612112213-4l3n9ae"}},{"ID":"20240612112214-f795bvj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612112214-f795bvj","updated":"20240612112219"},"Children":[{"Type":"NodeText","Data":"牛角《新修本草》"}]},{"ID":"20240612112214-jhkf57l","Type":"NodeParagraph","Properties":{"id":"20240612112214-jhkf57l","updated":"20240612112214"},"Children":[{"Type":"NodeText","Data":"下闭血，瘀血，疼痛，女人带下，下血。燔之，味苦，无毒。水牛角，疗时气寒热头痛；髓，补中，填骨髓，久服增年。髓，味甘，温，无毒。主安五脏，平三焦，温骨髓，补中，续绝伤，益气，止泄痢，消渴，以酒服之。胆可丸药。胆，味苦，大寒。除心腹热渴，利口焦燥，益目精。"}]},{"ID":"20240612112214-uv2e5hp","Type":"NodeParagraph","Properties":{"id":"20240612112214-uv2e5hp","updated":"20240612112214"},"Children":[{"Type":"NodeText","Data":"此朱书牛角 、髓，其胆《本经》附出牛黄条中，此以类相从耳，非上品之药，今拨出随例在此，不关件数，犹黑书，别品之限耳。心，主虚忘。肝，主明目。肾，主补肾气，益精。"}]},{"ID":"20240612112214-gi49bte","Type":"NodeParagraph","Properties":{"id":"20240612112214-gi49bte","updated":"20240612112214"},"Children":[{"Type":"NodeText","Data":"齿，主小儿牛痫。肉，味甘，平，无毒。主消渴，止 泄，安中益气，养脾胃，自死者不良。屎，寒，主水肿，恶气，用涂门户着壁者。燔之，主鼠 ，恶疮。黄犍牛、乌牯牛溺，主水肿腹胀脚满，利小便。"}]},{"ID":"20240612112214-4j87xqr","Type":"NodeParagraph","Properties":{"id":"20240612112214-4j87xqr","updated":"20240612112214"},"Children":[{"Type":"NodeText","Data":"此牛亦以 牛为好，青牛最良，水牛为可充食尔。自死谓疫死，肉多毒。青牛肠不可共犬肉犬血食之，令人成病也。"}]},{"ID":"20240612112214-kawaqse","Type":"NodeParagraph","Properties":{"id":"20240612112214-kawaqse","updated":"20240612112214"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶牛鼻中木卷，疗小儿痫。草卷烧灰，疗小儿鼻下疮。耳中垢，疗蛇伤恶 毒。脐中毛，疗小儿久不行。白牛悬蹄，疗妇人崩中漏下赤白。屎，主霍乱。屎中大豆，疗小儿痫，妇人难产。特牛茎，疗妇人漏下赤白，无子。乌牛胆，主明目及疳湿，以酿槐子服之弥佳。脑，主消渴，风眩。齿，主小儿惊痫。尿，主消渴，黄胆，水肿，香港脚，小便不通也。"}]},{"ID":"20240612112228-zyjt6zh","Type":"NodeThematicBreak","Properties":{"id":"20240612112228-zyjt6zh"}},{"ID":"20240612112229-pu4490v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612112229-pu4490v","updated":"20240612112233"},"Children":[{"Type":"NodeText","Data":"牛角《本草经集注》"}]},{"ID":"20240612112229-bkgwop4","Type":"NodeParagraph","Properties":{"id":"20240612112229-bkgwop4","updated":"20240612112229"},"Children":[{"Type":"NodeText","Data":"主下闭血，瘀血，疼痛，女人带下，下血。燔之，味苦，无毒。"}]},{"ID":"20240612112229-8oc4d36","Type":"NodeParagraph","Properties":{"id":"20240612112229-8oc4d36","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛角"},{"Type":"NodeText","Data":"∶主治时气寒热头痛。"}]},{"ID":"20240612112229-55ifw8h","Type":"NodeParagraph","Properties":{"id":"20240612112229-55ifw8h","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"髓"},{"Type":"NodeText","Data":"∶补中，填骨髓，久服增年。髓∶味甘，温，无毒。主安五脏。平三焦，温骨髓，补中，续绝伤，益气，止泄痢，消渴，以酒服之。"}]},{"ID":"20240612112229-jeghfbp","Type":"NodeParagraph","Properties":{"id":"20240612112229-jeghfbp","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆"},{"Type":"NodeText","Data":"∶可丸药。胆∶味苦，大寒。主此朱书牛角 、髓，其胆《本经》附出牛黄条中，此以类相从尔，非上品之药，今拨出随"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心"},{"Type":"NodeText","Data":"∶主治虚忘。"}]},{"ID":"20240612112229-ql7frnm","Type":"NodeParagraph","Properties":{"id":"20240612112229-ql7frnm","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肝"},{"Type":"NodeText","Data":"∶主明目。"}]},{"ID":"20240612112229-80jm24e","Type":"NodeParagraph","Properties":{"id":"20240612112229-80jm24e","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾"},{"Type":"NodeText","Data":"∶主补肾气，益精。"}]},{"ID":"20240612112229-6tr2mfl","Type":"NodeParagraph","Properties":{"id":"20240612112229-6tr2mfl","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"齿"},{"Type":"NodeText","Data":"∶主治小儿牛痫。"}]},{"ID":"20240612112229-3p01jg4","Type":"NodeParagraph","Properties":{"id":"20240612112229-3p01jg4","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"},{"Type":"NodeText","Data":"∶味甘，平，无毒。主治消渴，止吐泄，安中益气，养脾胃，自死者不良。"}]},{"ID":"20240612112229-74m40rq","Type":"NodeParagraph","Properties":{"id":"20240612112229-74m40rq","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"屎"},{"Type":"NodeText","Data":"∶寒，主治水肿，恶气，用涂门户着壁者。燔之，主治鼠 ，恶疮。"}]},{"ID":"20240612112229-w2zs7cs","Type":"NodeParagraph","Properties":{"id":"20240612112229-w2zs7cs","updated":"20240612112229"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄犍牛、乌牯牛溺"},{"Type":"NodeText","Data":"∶主治水肿腹胀脚满，利小便。"}]},{"ID":"20240612112229-7m4tbgs","Type":"NodeParagraph","Properties":{"id":"20240612112229-7m4tbgs","updated":"20240612112229"},"Children":[{"Type":"NodeText","Data":"此牛亦以 牛为好，青牛最良，水牛为可充食尔。自死谓疫死，肉多毒。青牛肠不可共犬肉犬血食之，令人成病也。"}]},{"ID":"20240612111256-i3kiz79","Type":"NodeThematicBreak","Properties":{"id":"20240612111256-i3kiz79"}},{"ID":"20240612111257-8ickjs1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111257-8ickjs1","updated":"20240612111301"},"Children":[{"Type":"NodeText","Data":"牛角腮《本草衍义》"}]},{"ID":"20240612111257-25msgr3","Type":"NodeParagraph","Properties":{"id":"20240612111257-25msgr3","updated":"20240612111257"},"Children":[{"Type":"NodeText","Data":"此则黄牛角腮。用尖，烧为黑灰，微存性，治妇人血崩、大便血及冷痢。又白水牛鼻，干湿皆可用。治偏风口 斜，以火炙热，于不患处一边熨之，渐正。"}]},{"ID":"20240612111247-wrzz8v8","Type":"NodeThematicBreak","Properties":{"id":"20240612111247-wrzz8v8"}},{"ID":"20240612111248-nxeaar5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111248-nxeaar5","updated":"20240612111252"},"Children":[{"Type":"NodeText","Data":"牛角腮《医学入门》"}]},{"ID":"20240612111248-v744swp","Type":"NodeParagraph","Properties":{"id":"20240612111248-v744swp","updated":"20240612111248"},"Children":[{"Type":"NodeText","Data":"即黄牛角尖，烧存性用。味苦温，性涩，无毒。主下闭血瘀，血疼痛。止妇人血崩、赤白带下及肠风下血、冷痢泻血、鼠乳疟疾。"}]},{"ID":"20240612112034-rf3dams","Type":"NodeThematicBreak","Properties":{"id":"20240612112034-rf3dams"}},{"ID":"20240612112035-w95t8xm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612112035-w95t8xm","updated":"20240612112041"},"Children":[{"Type":"NodeText","Data":"水牛角《千金翼方》"}]},{"ID":"20240612112035-c4in5p7","Type":"NodeParagraph","Properties":{"id":"20240612112035-c4in5p7","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"疗时气寒热头痛。髓∶补中，填骨髓，久服增年。"}]},{"ID":"20240612112035-e4ko3nj","Type":"NodeParagraph","Properties":{"id":"20240612112035-e4ko3nj","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛髓"}]},{"ID":"20240612112035-ddaju4o","Type":"NodeParagraph","Properties":{"id":"20240612112035-ddaju4o","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"味甘，温，无毒。主安五脏，平三焦，温骨髓，补中，续绝伤，益气，止泻痢，消渴，以酒服之。"}]},{"ID":"20240612112035-hb49bdq","Type":"NodeParagraph","Properties":{"id":"20240612112035-hb49bdq","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛胆"}]},{"ID":"20240612112035-o1z2669","Type":"NodeParagraph","Properties":{"id":"20240612112035-o1z2669","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"可丸药。胆味苦，大寒。除心腹热渴，利口焦燥，益目精。"}]},{"ID":"20240612112035-k4b4jjy","Type":"NodeParagraph","Properties":{"id":"20240612112035-k4b4jjy","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛心"}]},{"ID":"20240612112035-mb5o4up","Type":"NodeParagraph","Properties":{"id":"20240612112035-mb5o4up","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"主虚忘。"}]},{"ID":"20240612112035-6u8vpg6","Type":"NodeParagraph","Properties":{"id":"20240612112035-6u8vpg6","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛肝"}]},{"ID":"20240612112035-xzwvkzh","Type":"NodeParagraph","Properties":{"id":"20240612112035-xzwvkzh","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"主明目。"}]},{"ID":"20240612112035-6cj5x3t","Type":"NodeParagraph","Properties":{"id":"20240612112035-6cj5x3t","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛肾"}]},{"ID":"20240612112035-3bn61sh","Type":"NodeParagraph","Properties":{"id":"20240612112035-3bn61sh","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"主补肾气，益精。"}]},{"ID":"20240612112035-k9r87lt","Type":"NodeParagraph","Properties":{"id":"20240612112035-k9r87lt","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛齿"}]},{"ID":"20240612112035-oq5fs86","Type":"NodeParagraph","Properties":{"id":"20240612112035-oq5fs86","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"主小儿牛痫。"}]},{"ID":"20240612112035-4x0ul5b","Type":"NodeParagraph","Properties":{"id":"20240612112035-4x0ul5b","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛肉"}]},{"ID":"20240612112035-2sj2su2","Type":"NodeParagraph","Properties":{"id":"20240612112035-2sj2su2","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"味咸，平，无毒。主消渴，止吐泻，安中益气，养脾胃。自死者不良。"}]},{"ID":"20240612112035-mljzfzx","Type":"NodeParagraph","Properties":{"id":"20240612112035-mljzfzx","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛屎"}]},{"ID":"20240612112035-tfyl0qq","Type":"NodeParagraph","Properties":{"id":"20240612112035-tfyl0qq","updated":"20240612112035"},"Children":[{"Type":"NodeText","Data":"寒。主水肿恶气，用涂门户着壁者，燔之，主鼠 恶疮。"}]},{"ID":"20240612112035-8xed79e","Type":"NodeParagraph","Properties":{"id":"20240612112035-8xed79e","updated":"20240612112035"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄犍牛、乌牯牛溺"},{"Type":"NodeText","Data":"∶主水肿腹胀脚满，利小便。"}]},{"ID":"20240612111348-l25b3pv","Type":"NodeThematicBreak","Properties":{"id":"20240612111348-l25b3pv"}},{"ID":"20240612111349-hmp2dqr","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612111349-hmp2dqr","updated":"20240612111504"},"Children":[{"Type":"NodeText","Data":"牛角《证类本草》"}]},{"ID":"20240612111349-koj5lzb","Type":"NodeParagraph","Properties":{"id":"20240612111349-koj5lzb","updated":"20240612111507"},"Children":[{"Type":"NodeText","Data":"下闭血，瘀血疼痛，女人带下血。燔之。味苦，无毒。"}]},{"ID":"20240612111349-zloae8r","Type":"NodeParagraph","Properties":{"id":"20240612111349-zloae8r","updated":"20240612111509"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按蜀本云∶沙牛角 ，味苦，温，无毒。主下闭瘀血，女子带下下血。烧以为灰赤白带下，止冷痢泻血。"}]},{"ID":"20240612111349-kzf2y8b","Type":"NodeParagraph","Properties":{"id":"20240612111349-kzf2y8b","updated":"20240612111511"},"Children":[{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeBackslashContent","Data":"*"}]},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeBackslashContent","Data":"*"}]},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeBackslashContent","Data":"*"}]},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeBackslashContent","Data":"*"}]},{"Type":"NodeText","Data":" 疗时气，寒热头痛。"}]},{"ID":"20240612111349-dz5ip0x","Type":"NodeParagraph","Properties":{"id":"20240612111349-dz5ip0x","updated":"20240612111349"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按药对云∶水牛角，平。药决云∶水牛角，味苦，冷，无毒。"}]},{"ID":"20240612111349-0l1ouhp","Type":"NodeParagraph","Properties":{"id":"20240612111349-0l1ouhp","updated":"20240612111513"},"Children":[{"Type":"NodeText","Data":"髓 补中，填骨髓。久服增年。髓，味甘，温，无毒。主安五脏，平三焦，温骨髓，补中，续绝益气，止泄痢，消渴。以酒服之。"}]},{"ID":"20240612111349-8jfmm0o","Type":"NodeParagraph","Properties":{"id":"20240612111349-8jfmm0o","updated":"20240612111514"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按孟诜云∶黑牛髓和地黄汁、白蜜等分作煎服，治瘦病。"}]},{"ID":"20240612111349-h60oxtc","Type":"NodeParagraph","Properties":{"id":"20240612111349-h60oxtc","updated":"20240612111349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胆"},{"Type":"NodeText","Data":" 可丸药。胆，味苦，大寒。除心腹热渴，利口焦燥，益目精。"}]},{"ID":"20240612111349-8j7vpwx","Type":"NodeParagraph","Properties":{"id":"20240612111349-8j7vpwx","updated":"20240612111519"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此朱书牛角 、髓、其胆，《本经》附出牛黄条中，此以类相从耳，非上品之药，今拔出随例在此，不关件数，犹是黑书别品之限也。臣禹锡等谨按药性论云∶青牛胆，君，无毒。主消渴，利大小肠。腊月牯牛胆，中盛黑豆一百粒，后一百日开取，食后、夜间吞二七枚，镇肝明目。黑豆盛浸不计多少。"}]},{"ID":"20240612111349-cq1w264","Type":"NodeParagraph","Properties":{"id":"20240612111349-cq1w264","updated":"20240612111349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心"},{"Type":"NodeText","Data":" 主虚忘。"}]},{"ID":"20240612111349-h3akmb0","Type":"NodeParagraph","Properties":{"id":"20240612111349-h3akmb0","updated":"20240612111349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肝"},{"Type":"NodeText","Data":" 主明目。"}]},{"ID":"20240612111349-sapi3q6","Type":"NodeParagraph","Properties":{"id":"20240612111349-sapi3q6","updated":"20240612111524"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肾"},{"Type":"NodeText","Data":" 主补肾气，益精。"}]},{"ID":"20240612111349-fvkxkcu","Type":"NodeParagraph","Properties":{"id":"20240612111349-fvkxkcu","updated":"20240612111349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"齿"},{"Type":"NodeText","Data":" 主小儿牛痫。"}]},{"ID":"20240612111349-iksrlak","Type":"NodeParagraph","Properties":{"id":"20240612111349-iksrlak","updated":"20240612111349"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"肉"},{"Type":"NodeText","Data":" 味甘，平，无毒。主消渴，止 泄，安中益气，养脾胃，自死者不良。"}]},{"ID":"20240612111349-y312j8n","Type":"NodeParagraph","Properties":{"id":"20240612111349-y312j8n","updated":"20240612111527"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"屎"},{"Type":"NodeText","Data":" 寒。主水肿，恶气。用涂门户，着壁者。燔之，主鼠 ，恶疮。"}]},{"ID":"20240612111349-wbrjl9j","Type":"NodeParagraph","Properties":{"id":"20240612111349-wbrjl9j","updated":"20240612111529"},"Children":[{"Type":"NodeText","Data":"臣禹锡等谨按孟诜云∶乌牛粪为上。又小儿夜啼，取干牛粪如手大，安卧席下，勿令母知，子、母俱吉。"}]},{"ID":"20240612111349-cn1tk6o","Type":"NodeParagraph","Properties":{"id":"20240612111349-cn1tk6o","updated":"20240612111530"},"Children":[{"Type":"NodeText","Data":"黄犍牛、乌牯牛溺 主水肿，腹胀脚满，利小便。"}]},{"ID":"20240612111349-7ga6cij","Type":"NodeParagraph","Properties":{"id":"20240612111349-7ga6cij","updated":"20240612111533"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此牛，亦 牛为胜，青牛最良，水牛为可充食尔。自死谓疫死，肉多毒。青牛肠不可共犬肉、犬血食之，令人成病也。唐本注云∶《别录》云，牛鼻中木卷，疗小儿痫。草卷烧之为屑，主小儿鼻下疮。耳中垢，主蛇伤，恶 毒。脐中毛，主小儿久不行。白牛悬蹄，主妇人崩中，漏赤白。屎，主霍乱。屎中大豆，主小儿痫，妇人产难。特牛茎，主妇人漏下赤白，无子。乌牛胆，主明目及疳湿，以酿槐子服之弥佳。脑，主消渴，风眩。齿，主小儿惊痫。尿，主消渴，黄胆，水肿，香港脚，小理不通也。今按陈藏器本草云∶牛肉，平。消水肿，除湿气，补虚，令人强筋骨，壮健。鼻和石燕煮汁服，主消渴。肝和腹内百叶，作生姜、醋食之，主热气，水气，丹毒，压丹石发热，解酒劳。五脏，主人五脏。黄牛肉，小温。补益腰脚。独肝者有大毒，食之，痢血至死。北人牛瘦，多以蛇从鼻灌之，则为独肝也。"}]},{"ID":"20240612111349-9qviiob","Type":"NodeParagraph","Properties":{"id":"20240612111349-9qviiob","updated":"20240612111536"},"Children":[{"Type":"NodeText","Data":"水牛则无之。以前二色牛肉，自死者发痼疾 癖，令人成疰病。落崖死者良。黄牛乳，生服利人，下热气，冷补，润肌，止渴。和蒜煎三、五沸食之，主冷气 癖，羸瘦。凡服乳，必煮一、二沸，停冷啜之，热食则壅。不欲顿服，欲得渐消。与酸物相反，令人腹中结症。凡以乳及溺、屎去病者，黑牛强于黄牛。酥堪合诸膏，摩风肿 跌，血瘀。醍醐更佳，性滑，以物盛之皆透，唯鸡子壳及葫芦盛之不出。屎热灰敷炙疮不瘥者。水牛、黄牛角 及在粪土中烂白者，烧为黑灰末服，主赤白痢。口中涎，主反胃。又取老牛涎沫如枣核大，置水中服之，终身不噎。口中 （丑之反）草，绞取汁服，止哕。《本经》不言黄牛、乌牛、水牛，但言牛。牛有数种，南人以水牛为牛，北人以黄牛、乌牛为牛。牛种既殊，入用亦别也。臣禹锡等谨按大腹水肿通用药云∶黄牛溺，寒。蜀本云∶黄犍牛溺，味苦、辛，微温，无毒。"}]},{"ID":"20240612111349-7kl4m58","Type":"NodeParagraph","Properties":{"id":"20240612111349-7kl4m58","updated":"20240617115446"},"Children":[{"Type":"NodeText","Data":"孟诜云∶牛者，稼穑之资，不多屠杀，自死者，血脉已绝，骨髓已竭，不堪食。黄牛发药动病，黑牛尤不可食。黑牛尿及屎只入药。又头、蹄，下热风，患冷人不可食。其肝，醋煮食之治瘦。日华子云∶水牛肉，冷，微毒。角，煎治热毒风并壮热。角 ，烧焦治肠风泻血痢，崩中带下，水泻。涎，止反胃呕吐。治噎，要取即以水洗口后，盐涂之，则重吐出。黄牛肉，温，微毒。益腰脚。大都食之发药毒动病，不如水牛也。唯酥乳佳。骨髓，温，无毒。治吐血，鼻洪，崩中带下，肠风泻血并水泻。烧灰用。"}]},{"ID":"20240612111349-ajay7fm","Type":"NodeParagraph","Properties":{"id":"20240612111349-ajay7fm","updated":"20240612111349"},"Children":[{"Type":"NodeText","Data":"图经文具第十六卷中牛黄条下。"}]},{"ID":"20240612111349-1u4lfk5","Type":"NodeParagraph","Properties":{"id":"20240612111349-1u4lfk5","updated":"20240612111546"},"Children":[{"Type":"NodeText","Data":"食疗云∶肚，主消渴，风眩，补五脏，以醋煮食之。肝，治痢。肾，主补肾。髓，安五脏，平三焦，温中。久服增年。以酒送之。和地黄汁、白蜜作煎，服之治瘦病。恐是牛脂也。粪，主霍乱，煮饮之。又，妇人无乳汁，取牛鼻作羹，空心食之。不过三、两日，有汁下无限。若中年壮盛者，食之良。又，宰之尚不堪食，非论自死者。其牛肉取三斤，烂切，将啖解槽咬人恶马，只两啖后，颇甚驯良。若三、五顿后，其马狞豚不堪骑。十二月勿食，伤神。"}]},{"ID":"20240612111349-i46yaxt","Type":"NodeParagraph","Properties":{"id":"20240612111349-i46yaxt","updated":"20240612111548"},"Children":[{"Type":"NodeText","Data":"外台秘要大病后不足，病虚劳，补虚。取七岁以下，五岁以上黄牛乳一升，水四升，煎取一升，如人饥，稍稍饮，不得多，十日服不住，佳。又方∶必效治上吐下利者，为湿霍乱。黄牛屎半升，水一升，煮三、两沸，和牛屎滤过取汁，服半升则止。牛子屎亦得，又方∶治久患气胀。乌牛尿，空心温服一升，日一服，气散则止。千金方∶鼻中生疮，黑牛耳垢敷之良。"}]},{"ID":"20240612111349-14m2n0t","Type":"NodeParagraph","Properties":{"id":"20240612111349-14m2n0t","updated":"20240612111550"},"Children":[{"Type":"NodeText","Data":"又方∶治痔。腊月牛脾一具，熟食之尽，瘥。勿与盐、酱，未瘥再作。又方∶主喉痹。烧牛角末，酒服方寸匕。又方∶五色丹名油肿，若犯多致死，不可轻之。以屎敷之，干即易。千金翼主症癖及主鼓胀满。黑牛尿一升，微火煎如稠糖。空心饮服一大枣许，当转病出，隔日更服之。"}]},{"ID":"20240612111349-a1t3crv","Type":"NodeParagraph","Properties":{"id":"20240612111349-a1t3crv","updated":"20240612111552"},"Children":[{"Type":"NodeText","Data":"又方∶治甘虫蚀鼻生疮。取乌牛耳中垢敷之，良。肘后方∶治伤寒时气，毒攻手足肿，疼痛欲断，牛肉裹肿处止。《外台秘要》同。又方∶风毒香港脚，若经已满，捻之没指。但勤饮乌牛溺二取牛耳中垢封之，愈。又方∶治鼠 肿核痛，若已有疮口脓血出者，以热屎敷之。日三。经验方∶痔漏张用方∶犍牛儿胆、 胆各一个，用腻粉五十文，麝香二十文，将 胆汁、腻粉、麝香和是验，疮口渐合，生面盖疮内一遍，出恶物。经验后方∶治冷痢。沙角 烧灰，粥饮调下两钱。"}]},{"ID":"20240612111349-cmwclrp","Type":"NodeParagraph","Properties":{"id":"20240612111349-cmwclrp","updated":"20240612111555"},"Children":[{"Type":"NodeText","Data":"梅师方∶治卒阴肾痛。烧牛屎末，和酒敷之，干即易。又方∶治霍乱，吐痢不止，心烦，四肢逆冷，黄牛屎一升，以水二升，煎取一升，以绵滤过，去滓顿服。又方∶治水肿，小便涩。"}]},{"ID":"20240612111349-fwxroiy","Type":"NodeParagraph","Properties":{"id":"20240612111349-fwxroiy","updated":"20240612111557"},"Children":[{"Type":"NodeText","Data":"黄牛以鸡子白和敷之，干即易。食医心镜主水浮气肿，腹肚胀满，小便涩少。水牛蹄一只，汤洗去毛如食法，隔夜煮令烂熟取汁作羹。蹄切，空心饱食。又主水气，大腹浮肿，小便涩少。"}]},{"ID":"20240612111349-jq97cjc","Type":"NodeParagraph","Properties":{"id":"20240612111349-jq97cjc","updated":"20240612111600"},"Children":[{"Type":"NodeText","Data":"水牛尾涤洗，去毛细切，作 KT 极熟吃之。煮食亦佳。又，牛肉一斤熟蒸，以姜、醋，空心食。水牛皮烂煮熟蒸切于豉汁中食之。又乌犍牛尿半升，空心饮之利小便。又牛盛热时卒死，其脑食之生肠痈。集验方∶治淋。取牛耳中毛，烧取半钱，水服瘥。孙用和方∶治赤白带下。牛角 烧令烟断，附子以盐水浸泡七度去皮，右件等分，捣罗为末。每空心酒下二钱匕。"}]},{"ID":"20240612111349-kmybte1","Type":"NodeParagraph","Properties":{"id":"20240612111349-kmybte1","updated":"20240612111602"},"Children":[{"Type":"NodeText","Data":"兵部手集治水病初得危急。乌牛尿，每服一合，瘥。塞上方∶主鼠奶痔。牛角 烧作灰末，空心酒服方寸匕。姚氏方∶卒得淋。取牛尾烧灰，水服半钱，瘥。又方∶汤火烧灼疮，单敷湿屎，立痛止，常日用良。又方∶治毒蛇螫人，牛耳垢敷之佳。子母秘录∶治血气逆，心烦闷满，心痛。烧水牛角末，酒服方寸匕。又方∶小儿白秃疮，头上疮团团白色。以牛屎敷之。产书主难产。牛粪中大豆一枚，擘作两片，一片书父，一片书子，却合，以少水吞之，立产。耳珠先生固牙齿法良。杀牛齿三十枚，固济瓶中， 令通赤，取细研为末。水一盏，末二钱匕，煎令热，含浸牙齿，冷即吐却，永坚牢。或有损动者，末揩之。礼记牛夜鸣则 ，不可食。丹房镜源云∶牛屎，抽铜晕。"}]},{"ID":"20240612111349-09lsrat","Type":"NodeParagraph","Properties":{"id":"20240612111349-09lsrat","updated":"20240612111604"},"Children":[{"Type":"NodeText","Data":"衍义曰∶牛角 ，此则黄牛角 。用尖烧为黑灰，微存性，治妇人血崩，大便血及冷痢。"}]},{"ID":"20240612111349-pcpfe2b","Type":"NodeParagraph","Properties":{"id":"20240612111349-pcpfe2b","updated":"20240612111349"},"Children":[{"Type":"NodeText","Data":"又白水牛鼻，干、湿皆可用，治偏风口 斜，以火炙热，于不患处一边熨之，渐正。"}]},{"ID":"20240612111238-x6pquyw","Type":"NodeThematicBreak","Properties":{"id":"20240612111238-x6pquyw"}},{"ID":"20240612111240-dn1c94x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111240-dn1c94x","updated":"20240612111243"},"Children":[{"Type":"NodeText","Data":"牛角鳃《名医别录》"}]},{"ID":"20240612111240-686a3sb","Type":"NodeParagraph","Properties":{"id":"20240612111240-686a3sb","updated":"20240612111240"},"Children":[{"Type":"NodeText","Data":"燔之，味苦，无毒．水牛角，治时气寒热头痛．髓，味甘，温，无毒．主安五脏，焦，温骨髓，补中，续绝伤，益气，止泄利，消渴，以酒服之．胆，味苦，大寒．除心腹热渴，利，口焦燥，益目精．心，治虚忘．肝，主明目．肾，主补肾气，益精．齿，治小痫．肉，味甘，平，无毒．治消渴，止 泄安中益气，养脾胃，自死者不良．屎，寒肿，恶气，用涂门户着壁者．燔之，治鼠 ，恶疮．黄犍牛、乌牯牛溺，治水肿，腹胀满，利小便．又，牛鼻中木卷，治小儿痫．草卷烧灰，主治小儿鼻下疮．"}]},{"ID":"20240612111240-d9l65ci","Type":"NodeParagraph","Properties":{"id":"20240612111240-d9l65ci","updated":"20240612111240"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶牛角 ，下闭血瘀血疼痛，女人带下血．髓，补中，填骨髓．久服增年．胆，可丸药．"}]},{"ID":"20240612111211-a421ywz","Type":"NodeThematicBreak","Properties":{"id":"20240612111211-a421ywz"}},{"ID":"20240612111227-hadpy87","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111227-hadpy87","updated":"20240612111234"},"Children":[{"Type":"NodeText","Data":"牛角腮《本草乘雅半偈》"}]},{"ID":"20240612111227-9rus0yl","Type":"NodeParagraph","Properties":{"id":"20240612111227-9rus0yl","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240612111227-e683srg","Type":"NodeParagraph","Properties":{"id":"20240612111227-e683srg","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"【气味】苦平，无毒。"}]},{"ID":"20240612111227-k9iomcj","Type":"NodeParagraph","Properties":{"id":"20240612111227-k9iomcj","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"【主治】主下闭血，瘀血疼痛，女子带下血。燔之酒服。髓，气味甘平，主补中，填骨髓，"}]},{"ID":"20240612111227-5vmql4e","Type":"NodeParagraph","Properties":{"id":"20240612111227-5vmql4e","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"【核】曰∶古者牛唯服车。易云∶服牛乘马。书云∶肇牵车牛，其力在肩，其用以角。"}]},{"ID":"20240612111227-l12jxtf","Type":"NodeParagraph","Properties":{"id":"20240612111227-l12jxtf","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"抱朴子云∶牛结阵以却虎，环其角外触，虎虽猛，巧不能制也。其类有三∶沈牛、 牛，牛也。沈牛大， 牛小， 牛尤其卑小者。尔雅谓之 （音悲）牛，会编谓之纨牛，广南谓之果下牛者是也。 牛色黄、黑、赤、白、驳杂数种。沈牛喜没水中，其状如豕，大腹锐角，角若担矛，色青苍，亦有白色者，俗谓之水牛，郁林人谓之洲留牛者是也。牝曰 ，曰 ；"}]},{"ID":"20240612111227-rz5gacy","Type":"NodeParagraph","Properties":{"id":"20240612111227-rz5gacy","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"牡曰特，曰 ，曰牯，曰 ，曰 。子曰犊，曰 ，曰 。三岁曰 ，四岁曰 ，五岁曰 ，六岁曰KT 。察其齿以知其岁，其齿有下而无上也。三岁者二齿，四岁者四齿，五岁者六齿，六岁以后者，岁接骨节一节也。牛之形色，白曰 ；黑曰 ；赤曰 ；驳曰犁，曰荦；"}]},{"ID":"20240612111227-idhb6yp","Type":"NodeParagraph","Properties":{"id":"20240612111227-idhb6yp","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"纯色曰 ；纯黑曰牺；白黑杂毛曰 ；黄白曰 ，驳如星曰 ；黄牛虎文曰 ；黄牛黑唇曰；黑 曰 ；黑耳曰 ；黑腹曰牧；黑脚曰 ；体长曰 ；脊长曰 ；白脊曰KT ，曰将；领如橐驼曰 ；髀膝尾皆有长毛曰 ；角一俯一仰曰 ；角长二尺有五寸，三色不失曰载；重千斤，出巴中曰 ；重数千斤，出岷山曰 ，曰 ；去势曰犍，曰 ；无子曰 ；"}]},{"ID":"20240612111227-cgaf7zg","Type":"NodeParagraph","Properties":{"id":"20240612111227-cgaf7zg","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"绝有力曰欣 。项垂曰胡；蹄肉曰 ；百叶曰 ；角胎曰腮；鼻木曰 ；嚼草复出曰 ；腹草未化曰圣 。相牛者，璧堂欲暗，膺廷欲广，豪筋欲就，隽骨欲垂，插颈欲高，排骨欲密，尾不用至地，头不用多肉，角欲得细，身欲得圆，眼欲得大，口方易饲，鼻广易牵，倚欲如绊马，行欲如麟趾，蹄欲如八字，形欲如卷悬。乱睫好触，龙颈突目善跳。毛拳角冷有疾；"}]},{"ID":"20240612111227-6co6lcb","Type":"NodeParagraph","Properties":{"id":"20240612111227-6co6lcb","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"毛少骨多有力；岐胡有寿；尝鸣有黄；目脉且赤而体瘦也。牛之为物，病则耳燥，安则温润而泽，故古之视牛者以耳。诗云∶尔牛来思，其耳湿湿；湿湿，言润泽也。牛耳无窍，以角听也。易林云∶牛龙耳聩，龙亦聋者矣。牛，畜之有力而顺者。但有竖瞳，而无横瞳，见一物，辄长造天，故童子得而制之。声曰牟，音曰宫。管子云∶凡听宫如牛鸣， 中，牛含宫声，故柳子以为黄钟在 也。牛夜鸣则 。 ，久屋朽木也。古称牛膏曰香，故其臭朽，则不可食矣。"}]},{"ID":"20240612111227-ktdt052","Type":"NodeParagraph","Properties":{"id":"20240612111227-ktdt052","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"造化权舆云∶干为马，坤为牛。干，阳物也，马故蹄圆；坤，阴物也，牛故蹄坼。阳病则阴胜，故马疾则卧，阴病则阳胜，故牛疾则立。马，阳物也，故起先前足，卧先后足；牛，阴物也，故起先后足，卧先前足。马尝立，马病则卧；牛尝卧，牛病则立。牛走风顺，马走风逆，牛马风逸，往往不相及也。山海经云∶稷后曰叔均，是始耕。郭氏云∶用牛犁也。许叔重以为牛者所植谷，谷者民之命，是以王法禁杀牛，民犯禁，杀之者诛。周官牛人掌国之公牛，以待政令；祭祀供享牛、求牛；宾客供 牛、膳牛，飨食供膳羞牛；军士供犒牛；丧事供奠牛；军旅供兵军之牛。祭礼云∶一元大武，祭天地之牛，角茧栗。宗庙之牛，角握；"}]},{"ID":"20240612111227-k7ewa2w","Type":"NodeParagraph","Properties":{"id":"20240612111227-k7ewa2w","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"宾客之牛，角尺；帝牛不吉，以为 牛，帝牛必在涤三月，稷牛唯具也。又云∶天子以牺牛，诸侯以肥牛，大夫以索牛。周礼云∶牧人掌六牲，凡阳祀用 牲，阴祀用 牲，望祀各以其方之色，外祭毁事用 可也。周礼疏云∶牛宜 。 ，土谷，牛土畜，故牛宜 。藏器云∶牛自死者，血脉已绝，骨髓已竭，不可食。病死者，令人 癖洞下。白首者、独肝者，有大毒。啖蛇者杀人。仲景云∶啖蛇牛，毛发白而后顺者是也。时珍云∶角腮，角内坚骨也。"}]},{"ID":"20240612111227-u8qth30","Type":"NodeParagraph","Properties":{"id":"20240612111227-u8qth30","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"角为筋之精，骨之余，腮为角之粹也。故腮在角中，一名角胎。"}]},{"ID":"20240612111227-9ifxfig","Type":"NodeParagraph","Properties":{"id":"20240612111227-9ifxfig","updated":"20240612111227"},"Children":[{"Type":"NodeText","Data":"【 】曰∶牛者，稼穑之资，五畜之土，脾藏之畜也。律书冬至曰牵牛，言阳气牵同万物出之也。故本经取用在角，腮则又为角木之胚兆耳。盖土爰稼穑，稼穑作甘，所以俾全土化之体用者也。经云∶脾统血，闭瘀，则具体失用，带血，则显用无体，咸忘所统，而体用分之。燔之以火，转藉母气，功力始备。髓填髓者为象形；胆丸药者，为十一脏，皆取决于胆也。"}]},{"ID":"20240612112126-d4mcjwe","Type":"NodeThematicBreak","Properties":{"id":"20240612112126-d4mcjwe"}},{"ID":"20240612112129-w3hzxgu","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612112129-w3hzxgu","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"牛角（角思）"}]},{"ID":"20240612112129-tn3s47y","Type":"NodeParagraph","Properties":{"id":"20240612112129-tn3s47y","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612112129-ufjkv7j","Type":"NodeParagraph","Properties":{"id":"20240612112129-ufjkv7j","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" Niú Jiǎo （ Jiǎo Sī ）"}]},{"ID":"20240612112129-p7g0td0","Type":"NodeParagraph","Properties":{"id":"20240612112129-p7g0td0","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612112129-9c7hv3q","Type":"NodeParagraph","Properties":{"id":"20240612112129-9c7hv3q","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 牛角胎、牛角笋"}]},{"ID":"20240612112129-zp3b3fc","Type":"NodeParagraph","Properties":{"id":"20240612112129-zp3b3fc","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612112129-94iq431","Type":"NodeParagraph","Properties":{"id":"20240612112129-94iq431","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" osteoid marrow in ox horn, osteoid marrow in buffalo horn"}]},{"ID":"20240612112129-mcrqma5","Type":"NodeParagraph","Properties":{"id":"20240612112129-mcrqma5","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612112129-ymz07pz","Type":"NodeParagraph","Properties":{"id":"20240612112129-ymz07pz","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240612112129-kg784l4","Type":"NodeParagraph","Properties":{"id":"20240612112129-kg784l4","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612112129-40k4i4r","Type":"NodeParagraph","Properties":{"id":"20240612112129-40k4i4r","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 药材基源：为牛科动物黄牛或水牛角中的骨质角髓。"}]},{"ID":"20240612112129-jf8xi6d","Type":"NodeParagraph","Properties":{"id":"20240612112129-jf8xi6d","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Bos taurus domesticus Gmelin2.Bubalusbubalis Linnaeus."}]},{"ID":"20240612112129-1vpowbl","Type":"NodeParagraph","Properties":{"id":"20240612112129-1vpowbl","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"采收和储藏：加工牛角时，将取出的骨质角（角思）用清水浸泡数日，再洗净，晒或烘干。"}]},{"ID":"20240612112129-7tytlb3","Type":"NodeParagraph","Properties":{"id":"20240612112129-7tytlb3","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612112129-9z8ygjm","Type":"NodeParagraph","Properties":{"id":"20240612112129-9z8ygjm","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.其性格温驯，生长较快。食植物性饲料。"}]},{"ID":"20240612112129-yx2h28n","Type":"NodeParagraph","Properties":{"id":"20240612112129-yx2h28n","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"资源分布：1.全国各地均有饲养。"}]},{"ID":"20240612112129-283qpzw","Type":"NodeParagraph","Properties":{"id":"20240612112129-283qpzw","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"2.全国大部分地区均饲养，以南方水稻田地区为多。"}]},{"ID":"20240612112129-sbqja0o","Type":"NodeParagraph","Properties":{"id":"20240612112129-sbqja0o","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612112129-klb960r","Type":"NodeParagraph","Properties":{"id":"20240612112129-klb960r","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 1.黄牛，体第1.5-2m，体重一般在280kg左右。体格强壮结实，头大额广，鼻阔口大，上唇上部有两个大鼻孔，基间皮肤硬而光滑，无毛，称为鼻镜。眼、耳都较大。头上有角1对，左右分开，角之长短、大小随品种而异弯曲无分枝，中空，内有骨质角髓。四肢匀称，4路，均有蹄甲，其后方2趾不着地，称悬蹄。尾较长，尾端具丛毛，毛色大部分为黄色，无杂毛掺混。"}]},{"ID":"20240612112129-u419ywc","Type":"NodeParagraph","Properties":{"id":"20240612112129-u419ywc","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"2.角较长大面扁，上有很多任务发纹，颈短，腰腹隆凸。四肢较短，蹄较大。皮厚无汗腺，毛粗而短，体前部较密，后背及胸腹各部较疏。体色大多灰黑色，但亦有黄褐色或白色的。"}]},{"ID":"20240612112129-f1xmrk1","Type":"NodeParagraph","Properties":{"id":"20240612112129-f1xmrk1","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612112129-qfu0b9z","Type":"NodeParagraph","Properties":{"id":"20240612112129-qfu0b9z","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，本品呈圆锥形，微弯曲，基部较粗，上部渐尖，长红15cm，底径约5cm。外表粗糙，灰白色或灰黄色，满布骨质细孔，并有少数浅纵沟。质坚硬。横切面中空，外壁厚约6mm，灰白色，较细致，内层有粗大髓样组织。气微腥，味淡。"}]},{"ID":"20240612112129-md7l9n6","Type":"NodeParagraph","Properties":{"id":"20240612112129-md7l9n6","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612112129-s6036iw","Type":"NodeParagraph","Properties":{"id":"20240612112129-s6036iw","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 含碳酸钙、磷酸钙等。"}]},{"ID":"20240612112129-6dyf8rc","Type":"NodeParagraph","Properties":{"id":"20240612112129-6dyf8rc","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612112129-g6p0jny","Type":"NodeParagraph","Properties":{"id":"20240612112129-g6p0jny","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 生牛角鳃：牛角鳃洗净后，劈成小条，日晒夜露至无腥为度，再晒干。炒牛角鳃：先将砂子入锅炒热，再入生牛角鳃拌炒至黄色为度，取出、筛去砂子,放凉即可。"}]},{"ID":"20240612112129-rus4sc8","Type":"NodeParagraph","Properties":{"id":"20240612112129-rus4sc8","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612112129-9ywm0cx","Type":"NodeParagraph","Properties":{"id":"20240612112129-9ywm0cx","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 肝；肾经"}]},{"ID":"20240612112129-x8dmrg8","Type":"NodeParagraph","Properties":{"id":"20240612112129-x8dmrg8","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612112129-sh5hjh4","Type":"NodeParagraph","Properties":{"id":"20240612112129-sh5hjh4","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 味苦；必温"}]},{"ID":"20240612112129-55xn68a","Type":"NodeParagraph","Properties":{"id":"20240612112129-55xn68a","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612112129-ha1wkft","Type":"NodeParagraph","Properties":{"id":"20240612112129-ha1wkft","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 化瘀止血；收涩止痢。主瘀血疼痛；吐血；衄血；肠风便血；崩漏；带下；痢下赤白；水泻；浮肿"}]},{"ID":"20240612112129-uqbubxx","Type":"NodeParagraph","Properties":{"id":"20240612112129-uqbubxx","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612112129-jkkksdc","Type":"NodeParagraph","Properties":{"id":"20240612112129-jkkksdc","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或入丸、散。外用：适量，烧灰调敷。"}]},{"ID":"20240612112129-ai823rd","Type":"NodeParagraph","Properties":{"id":"20240612112129-ai823rd","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612112129-uxp7wi8","Type":"NodeParagraph","Properties":{"id":"20240612112129-uxp7wi8","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：下闭血，瘀血疼痛，女人带下血。"}]},{"ID":"20240612112129-zc0jg9a","Type":"NodeParagraph","Properties":{"id":"20240612112129-zc0jg9a","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：黄牛角鳃灰，能止妇人血崩不止，赤白带下，止冷痢、泻血。"}]},{"ID":"20240612112129-z9z90vy","Type":"NodeParagraph","Properties":{"id":"20240612112129-z9z90vy","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"3.《本草拾遗》：烧为黑灰，末服，主赤白痢。"}]},{"ID":"20240612112129-7pvavch","Type":"NodeParagraph","Properties":{"id":"20240612112129-7pvavch","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"4.《日华子本草》：烧焦，治肠风泻血，水泻。"}]},{"ID":"20240612112129-mk6r32s","Type":"NodeParagraph","Properties":{"id":"20240612112129-mk6r32s","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"5.《本草蒙筌》：除吐衄。"}]},{"ID":"20240612112129-brkwk39","Type":"NodeParagraph","Properties":{"id":"20240612112129-brkwk39","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：治水肿。"}]},{"ID":"20240612112129-ox3uohx","Type":"NodeParagraph","Properties":{"id":"20240612112129-ox3uohx","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"7.《医林纂要》：长筋力。"}]},{"ID":"20240612112129-dm0i4bx","Type":"NodeParagraph","Properties":{"id":"20240612112129-dm0i4bx","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"8.《纲目》：牛角鳃，筋之粹，骨之余、而鳃又角之精也。烧之则性涩，故止血痢、崩中诸病。"}]},{"ID":"20240612112129-53g1nwm","Type":"NodeParagraph","Properties":{"id":"20240612112129-53g1nwm","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"9.《本草经疏》：牛角鳃，乃角中嫩骨也。苦能泄，温能通行，故主妇人带下及闭血、瘀血疼痛也。"}]},{"ID":"20240612112129-q2yrlrn","Type":"NodeParagraph","Properties":{"id":"20240612112129-q2yrlrn","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612112129-rpm3c77","Type":"NodeParagraph","Properties":{"id":"20240612112129-rpm3c77","updated":"20240612112129"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612111211-frb4lwa","Type":"NodeThematicBreak","Properties":{"id":"20240612111211-frb4lwa"}},{"ID":"20240612111213-h3rpe4h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111213-h3rpe4h","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：牛角腮"}]},{"ID":"20240612111213-mj909lb","Type":"NodeParagraph","Properties":{"id":"20240612111213-mj909lb","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612111213-s3434ms","Type":"NodeParagraph","Properties":{"id":"20240612111213-s3434ms","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" Niú Jiǎo Sāi"}]},{"ID":"20240612111213-x1ugmzw","Type":"NodeParagraph","Properties":{"id":"20240612111213-x1ugmzw","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612111213-xoq6obf","Type":"NodeParagraph","Properties":{"id":"20240612111213-xoq6obf","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 偶蹄目牛科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄牛"},{"Type":"NodeText","Data":"Bos taurus domesticus Gmelin，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛角内部坚硬骨心"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240612111213-41w3cw5","Type":"NodeParagraph","Properties":{"id":"20240612111213-41w3cw5","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612111213-gczs8ea","Type":"NodeParagraph","Properties":{"id":"20240612111213-gczs8ea","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 全国各地。"}]},{"ID":"20240612111213-gfgpefg","Type":"NodeParagraph","Properties":{"id":"20240612111213-gfgpefg","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612111213-pl0lfoe","Type":"NodeParagraph","Properties":{"id":"20240612111213-pl0lfoe","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 牛角腮为杀牛时取角内坚硬的骨心，用水漂3～5天，刮去粘附的腐肉，锯成2～3厘米小段，劈开，日晒野露至无臭气为度，打碎，用铁砂炒至黄色，趁热洒少许醋既得。"}]},{"ID":"20240612111213-282m3s2","Type":"NodeParagraph","Properties":{"id":"20240612111213-282m3s2","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612111213-6v88a7u","Type":"NodeParagraph","Properties":{"id":"20240612111213-6v88a7u","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 止血。主治血崩，便血，血痢，赤白带下。"}]},{"ID":"20240612111213-6hc1z6r","Type":"NodeParagraph","Properties":{"id":"20240612111213-6hc1z6r","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612111213-ldi7ssw","Type":"NodeParagraph","Properties":{"id":"20240612111213-ldi7ssw","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 2～4钱。"}]},{"ID":"20240612111213-1t7arq0","Type":"NodeParagraph","Properties":{"id":"20240612111213-1t7arq0","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612111213-ej473og","Type":"NodeParagraph","Properties":{"id":"20240612111213-ej473og","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612111213-vu1woom","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612111213-vu1woom","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：牛角腮"}]},{"ID":"20240612111213-s7w9km1","Type":"NodeParagraph","Properties":{"id":"20240612111213-s7w9km1","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612111213-fymqzb4","Type":"NodeParagraph","Properties":{"id":"20240612111213-fymqzb4","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" Niú Jiǎo Sāi"}]},{"ID":"20240612111213-5ykzwur","Type":"NodeParagraph","Properties":{"id":"20240612111213-5ykzwur","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612111213-9dug5z0","Type":"NodeParagraph","Properties":{"id":"20240612111213-9dug5z0","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 牛角胎（《纲目》），牛角笋（《医林纂要》）。"}]},{"ID":"20240612111213-s0jap4n","Type":"NodeParagraph","Properties":{"id":"20240612111213-s0jap4n","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612111213-ivcsys6","Type":"NodeParagraph","Properties":{"id":"20240612111213-ivcsys6","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612111213-zylyz7x","Type":"NodeParagraph","Properties":{"id":"20240612111213-zylyz7x","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612111213-upczpps","Type":"NodeParagraph","Properties":{"id":"20240612111213-upczpps","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 为牛科动物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄牛"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水牛角中的骨质角髓"},{"Type":"NodeText","Data":"。由宰牛场收集。从牛角中取得后，用清水浸泡数天，刮去残肉，再洗净、晒干。"}]},{"ID":"20240612111213-35ecicg","Type":"NodeParagraph","Properties":{"id":"20240612111213-35ecicg","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612111213-f2cqvcb","Type":"NodeParagraph","Properties":{"id":"20240612111213-f2cqvcb","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 主产江苏，其他各地亦产。"}]},{"ID":"20240612111213-fcvv3qx","Type":"NodeParagraph","Properties":{"id":"20240612111213-fcvv3qx","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612111213-2aw7jmk","Type":"NodeParagraph","Properties":{"id":"20240612111213-2aw7jmk","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 呈圆锥形，微弯，中空，基部较粗，上部渐尖，长约15厘米，底部径约5厘米。外表粗糙，灰白色或灰黄色，满布骨质细孔，并有少数浅纵沟。质坚硬。横切面中空，外壁厚约6毫米，灰白色，较细致，内层有粗大髓样组织。气微腥，味淡。以干净，无头丬骨，形状粗短者为佳。"}]},{"ID":"20240612111213-40fzsek","Type":"NodeParagraph","Properties":{"id":"20240612111213-40fzsek","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612111213-3ti1rd6","Type":"NodeParagraph","Properties":{"id":"20240612111213-3ti1rd6","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 生牛角腮：牛角腮洗净后，劈成小条，日晒夜露至无腥为度，再晒干。炒牛角鳃：先将砂子入锅炒热，再入生牛角鳃拌炒至黄色为度，取出、筛去砂子，放凉即可。"}]},{"ID":"20240612111213-988wcxp","Type":"NodeParagraph","Properties":{"id":"20240612111213-988wcxp","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612111213-4zg7xef","Type":"NodeParagraph","Properties":{"id":"20240612111213-4zg7xef","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"厥阴，少阴血分。\""}]},{"ID":"20240612111213-2cr4koa","Type":"NodeParagraph","Properties":{"id":"20240612111213-2cr4koa","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"入足默阴、少阴血分，兼入手阳明经。\""}]},{"ID":"20240612111213-fpyst9n","Type":"NodeParagraph","Properties":{"id":"20240612111213-fpyst9n","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612111213-cywlrdn","Type":"NodeParagraph","Properties":{"id":"20240612111213-cywlrdn","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 苦，温。"}]},{"ID":"20240612111213-thmq766","Type":"NodeParagraph","Properties":{"id":"20240612111213-thmq766","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味苦，无毒。\""}]},{"ID":"20240612111213-uho72o8","Type":"NodeParagraph","Properties":{"id":"20240612111213-uho72o8","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"黄牛角腮，味苦甘，无毒。\""}]},{"ID":"20240612111213-6t6aqqs","Type":"NodeParagraph","Properties":{"id":"20240612111213-6t6aqqs","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"③《蜀本草》：\"沙牛角腮，味苦，温，无毒。\""}]},{"ID":"20240612111213-dlvnbpg","Type":"NodeParagraph","Properties":{"id":"20240612111213-dlvnbpg","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612111213-u54gubk","Type":"NodeParagraph","Properties":{"id":"20240612111213-u54gubk","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 止血，止痢。治便血，衄血，妇女崩漏，带下，赤白痢，水泻。"}]},{"ID":"20240612111213-sdzhjgk","Type":"NodeParagraph","Properties":{"id":"20240612111213-sdzhjgk","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"下闭血，瘀血疼痛，女人带下血。\""}]},{"ID":"20240612111213-xaghrsm","Type":"NodeParagraph","Properties":{"id":"20240612111213-xaghrsm","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"黄牛角腮灰，能止妇人血崩不止，赤白带下，止冷痢、泻血。\""}]},{"ID":"20240612111213-3enozg6","Type":"NodeParagraph","Properties":{"id":"20240612111213-3enozg6","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"③《本草拾遗》：\"烧为黑灰，末服，主亦白痢。\""}]},{"ID":"20240612111213-fzxa1wy","Type":"NodeParagraph","Properties":{"id":"20240612111213-fzxa1wy","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"烧焦，治肠风泻血，水泻。\""}]},{"ID":"20240612111213-nghrk1z","Type":"NodeParagraph","Properties":{"id":"20240612111213-nghrk1z","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"⑤《本草蒙筌》：\"除吐衄。\""}]},{"ID":"20240612111213-jhphjjb","Type":"NodeParagraph","Properties":{"id":"20240612111213-jhphjjb","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治水肿。\""}]},{"ID":"20240612111213-e6kyc6n","Type":"NodeParagraph","Properties":{"id":"20240612111213-e6kyc6n","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"⑦《医林纂要》：\"长筋力。\""}]},{"ID":"20240612111213-inpjpf8","Type":"NodeParagraph","Properties":{"id":"20240612111213-inpjpf8","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612111213-7kwox8m","Type":"NodeParagraph","Properties":{"id":"20240612111213-7kwox8m","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入散剂。"}]},{"ID":"20240612111213-bb7sm9u","Type":"NodeParagraph","Properties":{"id":"20240612111213-bb7sm9u","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612111213-gyj760k","Type":"NodeParagraph","Properties":{"id":"20240612111213-gyj760k","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" ①治妇人崩中下血不止：牛角鳃二两（烧灰），白矾二两（烧汁尽），橡实一两，木贼-两，芎藭一两。上件药，捣细罗为散。不计时候，以热酒调下二钱。（《圣惠方》牛角腮散）"}]},{"ID":"20240612111213-1jtpo52","Type":"NodeParagraph","Properties":{"id":"20240612111213-1jtpo52","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"②治亦白带下：牛角腮（烧令烟断），附子（以盐水浸泡七度，去皮），上件等分，捣罗为末。每空心酒下二钱匕。（孙用和）"}]},{"ID":"20240612111213-v90ie5n","Type":"NodeParagraph","Properties":{"id":"20240612111213-v90ie5n","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"③治卒下血：黄牛角腮一具（烧赤色，出火即青碧）。上一味为细散，食前浓煮豉汁，和二钱匕，重者日三。（《近效方》）"}]},{"ID":"20240612111213-b3ivtdn","Type":"NodeParagraph","Properties":{"id":"20240612111213-b3ivtdn","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"④治鼠奶痔：牛角腮烧作灰末，空心酒服方寸匕。（《塞上方》）"}]},{"ID":"20240612111213-fe9hwfs","Type":"NodeParagraph","Properties":{"id":"20240612111213-fe9hwfs","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"⑤治痢色白，食不消者，为寒下：牛角腮烧灰。上一味捣筛，白饮服方寸匕，日三。（《肘后方》）"}]},{"ID":"20240612111213-z9cceds","Type":"NodeParagraph","Properties":{"id":"20240612111213-z9cceds","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"⑥治蜂虿整疮：牛角腮烧灰，醋和敷之。（《肘后方》）"}]},{"ID":"20240612111213-v4simbo","Type":"NodeParagraph","Properties":{"id":"20240612111213-v4simbo","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612111213-fizyrce","Type":"NodeParagraph","Properties":{"id":"20240612111213-fizyrce","updated":"20240612111213"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612111214-qvtb4xg","Type":"NodeThematicBreak","Properties":{"id":"20240612111214-qvtb4xg"}},{"ID":"20240612111215-4tw7vol","Type":"NodeParagraph","Properties":{"id":"20240612111215-4tw7vol"}}]}