{"ID":"20240506082123-41n4ike","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506082123-41n4ike","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506082123-41n4ike\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240626090619-jhnb6ui\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612091935-c0jos8b\u0026quot;,\u0026quot;scrollTop\u0026quot;:3000,\u0026quot;focusId\u0026quot;:\u0026quot;20240626090831-9iz2hj2\u0026quot;,\u0026quot;focusStart\u0026quot;:4,\u0026quot;focusEnd\u0026quot;:4\u0026#125;","title":"209芜荑（芜菇）","type":"doc","updated":"20240821101112"},"Children":[{"ID":"20240626090619-jhnb6ui","Type":"NodeParagraph","Properties":{"id":"20240626090619-jhnb6ui","updated":"20240626090619"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 423px;","style":"width: 413px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626090619-nwo3bl1.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 413px;\" parent-style=\"width: 423px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626085754-b09zrij","Type":"NodeParagraph","Properties":{"id":"20240626085754-b09zrij","updated":"20240821100816"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240626085842-3cpw4za.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 356px;","style":"width: 346px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芜荑"},{"Type":"Node