rent-style=\"width: 618px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 599px;","style":"width: 589px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芜荑2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芜荑2-20240626091437-mhbpfzy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 589px;\" parent-style=\"width: 599px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821100944-d1wxmc4","Type":"NodeParagraph","Properties":{"id":"20240821100944-d1wxmc4","updated":"20240821101014"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 634px;","style":"width: 624px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芜荑 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芜荑 3-20240821100944-o2l132v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 624px;\" parent-style=\"width: 634px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芜荑 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芜荑 4-20240821101014-ilh1qb3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821101105-cxdbpmj","Type":"NodeParagraph","Properties":{"id":"20240821101105-cxdbpmj","updated":"20240821101112"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 598px;","style":"width: 588px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芜荑 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芜荑 5-20240821101105-ukmdv3j.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 588px;\" parent-style=\"width: 598px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 609px;","style":"width: 599px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"芜荑3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/芜荑3-20240626091600-xzvc8ec.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 599px;\" parent-style=\"width: 609px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240626092013-rl02v2w","Type":"NodeParagraph","Properties":{"id":"20240626092013-rl02v2w","updated":"20240626092452"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 436px;","style":"width: 426px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大果榆1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大果榆1-20240626092446-mnn4ixj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 426px;\" parent-style=\"width: 436px;\"}"},{"Type":"NodeText","Data":"​​​​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大果榆2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大果榆2-20240626092452-r1l6oey.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 436px;","style":"width: 426px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大果榆树7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大果榆树7-20240626092313-eq071l1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 426px;\" parent-style=\"width: 436px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240612092138-1tl43uq","Type":"NodeParagraph","Properties":{"id":"20240612092138-1tl43uq","updated":"20240626090432"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：芜荑是榆科榆属植物大果榆的种子加工后的成品。"}]},{"ID":"20240612092138-nouw7ys","Type":"NodeThematicBreak","Properties":{"id":"20240612092138-nouw7ys"}},{"ID":"20240612092150-o4if61b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092150-o4if61b","updated":"20240612092155"},"Children":[{"Type":"NodeText","Data":"芜荑《神农本草经》"}]},{"ID":"20240612092150-hzuxtub","Type":"NodeParagraph","Properties":{"id":"20240612092150-hzuxtub","updated":"20240612092150"},"Children":[{"Type":"NodeText","Data":"味辛。"}]},{"ID":"20240612092150-jwlha63","Type":"NodeParagraph","Properties":{"id":"20240612092150-jwlha63","updated":"20240612092150"},"Children":[{"Type":"NodeText","Data":"主五内邪气散，皮肤骨节中，淫，淫温行毒，去三虫，化食。一名无姑，一名殿塘（《御览》引云：逐寸白，散雒中，温温喘息，《大观本》作黑字）。生川谷。"}]},{"ID":"20240612092150-gm6kfdt","Type":"NodeParagraph","Properties":{"id":"20240612092150-gm6kfdt","updated":"20240612092150"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名殿塘，生晋山，三月采实，阴干。"}]},{"ID":"20240612092150-4gl0l2b","Type":"NodeParagraph","Properties":{"id":"20240612092150-4gl0l2b","updated":"20240612092150"},"Children":[{"Type":"NodeText","Data":"案《说文》云：梗，山枌榆，有束荚可为芜荑者。《广雅》云：山榆，母估也。"}]},{"ID":"20240612092150-70pimdf","Type":"NodeParagraph","Properties":{"id":"20240612092150-70pimdf","updated":"20240612092150"},"Children":[{"Type":"NodeText","Data":"《尔雅》云：莁荑（上艹下左杀右殳）（上艹下墙）。郭璞云：一名白蒉，又无姑，其实夷。郭璞云：无姑，姑榆也。生山中，叶圆而厚，剥取皮合渍之，其味辛香，所谓芜荑。《范子计然》云：芜荑在地，赤心者善。"}]},{"ID":"20240612092203-op5ung0","Type":"NodeThematicBreak","Properties":{"id":"20240612092203-op5ung0"}},{"ID":"20240612092205-050ivwk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092205-050ivwk","updated":"20240612092209"},"Children":[{"Type":"NodeText","Data":"芜荑《本草纲目》"}]},{"ID":"20240612092205-s15x6ul","Type":"NodeParagraph","Properties":{"id":"20240612092205-s15x6ul","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"「释名」荑．无姑．木名。"}]},{"ID":"20240612092205-rvsfnk2","Type":"NodeParagraph","Properties":{"id":"20240612092205-rvsfnk2","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"「气味」辛、平、无毒。"}]},{"ID":"20240612092205-hm4vd5r","Type":"NodeParagraph","Properties":{"id":"20240612092205-hm4vd5r","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612092205-ukmjm6g","Type":"NodeParagraph","Properties":{"id":"20240612092205-ukmjm6g","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"1、脾胃有虫，食即痛。面黄无色。用芜荑仁二两，和面炒成黄色，研为末。每服二匙，米汤送下"}]},{"ID":"20240612092205-1p5v4t8","Type":"NodeParagraph","Properties":{"id":"20240612092205-1p5v4t8","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"2、杀体内寄生虫。用生芜荑、生槟榔各四两，研为末，加蒸饼做成丸子，如梧子大。每服二十丸，开水送下。"}]},{"ID":"20240612092205-bn1rlak","Type":"NodeParagraph","Properties":{"id":"20240612092205-bn1rlak","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"3、久泄，气多粪少。用鞠荑五两，捣为还想，加饭做成丸子，如梧子大。每日空心于饭前服三十丸，久服能安神保健。"}]},{"ID":"20240612092205-u89snvg","Type":"NodeParagraph","Properties":{"id":"20240612092205-u89snvg","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"4、婴孩惊风后失声。用芜荑、神曲、麦蘖、黄连各一钱，分别炒过，共研为还想，加猪胆汁调糊做成丸子。如黍米大。每服十丸，木通汤送下。"}]},{"ID":"20240612092205-vnrf296","Type":"NodeParagraph","Properties":{"id":"20240612092205-vnrf296","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"5、虫牙作痛。作芜荑仁放蛀齿孔中，很有效。"}]},{"ID":"20240612092205-pbicsgd","Type":"NodeParagraph","Properties":{"id":"20240612092205-pbicsgd","updated":"20240612092205"},"Children":[{"Type":"NodeText","Data":"6、腹中鳖瘕（平时好酒，血入于酒，则为酒鳖；平时多气，血凝于气，则为气鳖；虚劳痼冷，败血杂痰，则为血鳖。摇头掉尾，如虫之行，上侵人咽，下蚀人肛，或附胁背，或隐胸腹，大则如鳖，小或如钱）。用芜荑炒过煎汤服，同时服暖胃、益血、理中的药物乃可治。若服雷丸、锡灰之类，是不会见效的。"}]},{"ID":"20240612092215-abn9nn1","Type":"NodeThematicBreak","Properties":{"id":"20240612092215-abn9nn1"}},{"ID":"20240612092216-xy03ae3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092216-xy03ae3","updated":"20240612092220"},"Children":[{"Type":"NodeText","Data":"芜荑《本草崇原》"}]},{"ID":"20240612092216-hn815g4","Type":"NodeParagraph","Properties":{"id":"20240612092216-hn815g4","updated":"20240612092216"},"Children":[{"Type":"NodeText","Data":"气味辛平，无毒。主治五内邪气，散皮肤骨节中淫淫温行毒，去三虫，化食。"}]},{"ID":"20240612092216-qnydqgs","Type":"NodeParagraph","Properties":{"id":"20240612092216-qnydqgs","updated":"20240612092216"},"Children":[{"Type":"NodeText","Data":"（芜荑生晋山川谷，今河东、河西近道处处皆有，而太原、延州、同州者良。其木名 ，《说文》曰∶ ，山 榆也，有刺，实为芜荑。叶圆而浓，其实早成，亦如榆荚，但气臭如，土人作酱食之，则味香美。性能杀虫，置物中亦能辟蛀。）"}]},{"ID":"20240612092216-fbw624s","Type":"NodeParagraph","Properties":{"id":"20240612092216-fbw624s","updated":"20240612092216"},"Children":[{"Type":"NodeText","Data":"芜荑，山榆仁也，榆受东方甲乙之精，得先春发陈之气，禀木气也。其味辛，其臭腥，其色黄白，其本有刺，禀金气也。木能平土，故主治五内之邪气。五内者，中土也。金能制风，故散皮肤骨节中淫淫温行毒。淫淫温行者，风动之邪也。风胜则生虫，去三虫，亦金能制木也。火衰则食不化，化食，乃木能生火也。"}]},{"ID":"20240612092358-4et29dr","Type":"NodeThematicBreak","Properties":{"id":"20240612092358-4et29dr"}},{"ID":"20240612092359-r5x9sc8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092359-r5x9sc8","updated":"20240612092403"},"Children":[{"Type":"NodeText","Data":"芜荑《药笼小品》"}]},{"ID":"20240612092359-tgt9zt6","Type":"NodeParagraph","Properties":{"id":"20240612092359-tgt9zt6","updated":"20240612092359"},"Children":[{"Type":"NodeText","Data":"辛苦散满。"}]},{"ID":"20240612092359-j9pwb4f","Type":"NodeParagraph","Properties":{"id":"20240612092359-j9pwb4f","updated":"20240612092359"},"Children":[{"Type":"NodeText","Data":"祛五脏皮肤肢节风湿。"}]},{"ID":"20240612092359-648rt5a","Type":"NodeParagraph","Properties":{"id":"20240612092359-648rt5a","updated":"20240612092359"},"Children":[{"Type":"NodeText","Data":"凡腹中有酒、血、气所化成鳖者，惟芜荑同暖胃理气补血之药，乃可杀虫。"}]},{"ID":"20240612092347-ttpeu2j","Type":"NodeThematicBreak","Properties":{"id":"20240612092347-ttpeu2j"}},{"ID":"20240612092348-o9qdam0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092348-o9qdam0","updated":"20240612092352"},"Children":[{"Type":"NodeText","Data":"芜荑《本草撮要》"}]},{"ID":"20240612092348-7rmbuuy","Type":"NodeParagraph","Properties":{"id":"20240612092348-7rmbuuy","updated":"20240612092348"},"Children":[{"Type":"NodeText","Data":"味辛苦．入足厥阴经．功专杀虫．得诃子治小儿冷痢．加豆蔻尤良．得槟榔能杀诸虫．陈久气膻者佳．"}]},{"ID":"20240612092337-h0sw1hn","Type":"NodeThematicBreak","Properties":{"id":"20240612092337-h0sw1hn"}},{"ID":"20240612092338-bhfgtn7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092338-bhfgtn7","updated":"20240612092343"},"Children":[{"Type":"NodeText","Data":"芜荑《得配本草》"}]},{"ID":"20240612092338-sh35y81","Type":"NodeParagraph","Properties":{"id":"20240612092338-sh35y81","updated":"20240612092338"},"Children":[{"Type":"NodeText","Data":"辛、苦、温。入手足太阴经气分。除皮肤骨节中邪气，淫淫如虫行。祛五内风湿，止大肠冷滑，杀虫化食，在所必需。（虫因湿而生，食因寒而滞。）得槟榔，杀诸虫。配干漆，治虫痫。配诃子、豆蔻，治小儿疳泻冷痢。配川连，治疳热生虫。（加猪胆汁、麝香，更效。）配川连末，猪胆汁丸，疗惊喑。（风热去也。）配暖胃益血理中等药，治鳖瘕。（大如鳖，小如钱，上侵咽，下蚀肛。）君猪脂，涂热疮。拌蜂蜜，搽湿癣。"}]},{"ID":"20240612092338-g9hicb3","Type":"NodeParagraph","Properties":{"id":"20240612092338-g9hicb3","updated":"20240612092338"},"Children":[{"Type":"NodeText","Data":"去壳，炒。杀虫，和面炒。脾肺燥热者禁用。"}]},{"ID":"20240612092315-0zhuc4o","Type":"NodeThematicBreak","Properties":{"id":"20240612092315-0zhuc4o"}},{"ID":"20240612092317-q9dk5w7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092317-q9dk5w7","updated":"20240612092321"},"Children":[{"Type":"NodeText","Data":"芜荑《本草便读》"}]},{"ID":"20240612092317-9yni6po","Type":"NodeParagraph","Properties":{"id":"20240612092317-9yni6po","updated":"20240612092317"},"Children":[{"Type":"NodeText","Data":"治肺经虫积疳痨．辛平无毒．去子脏风邪垢腻．洗服均良．（芜荑其树类榆．结实似榆荚．一名 树．芜荑即其子也．辛平臭膻．入肺与大肠．专杀诸虫．除一切郁热垢腻．以杜其生虫之源耳．）"}]},{"ID":"20240612092325-5qcn828","Type":"NodeThematicBreak","Properties":{"id":"20240612092325-5qcn828"}},{"ID":"20240612092327-km734mp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092327-km734mp","updated":"20240612092332"},"Children":[{"Type":"NodeText","Data":"芜荑《千金翼方》"}]},{"ID":"20240612092327-p74knzq","Type":"NodeParagraph","Properties":{"id":"20240612092327-p74knzq","updated":"20240612092327"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主五内邪气，散皮肤、骨节中淫淫温行毒，去三虫化食，逐寸白，散肠中 喘息。一名无姑，一名 。生晋山川谷，三月采实，阴干。"}]},{"ID":"20240612092259-pcl5wz0","Type":"NodeThematicBreak","Properties":{"id":"20240612092259-pcl5wz0"}},{"ID":"20240612092300-ennkcie","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092300-ennkcie","updated":"20240612092310"},"Children":[{"Type":"NodeText","Data":"芜荑《本经逢原》"}]},{"ID":"20240612092300-xpirqog","Type":"NodeParagraph","Properties":{"id":"20240612092300-xpirqog","updated":"20240612092300"},"Children":[{"Type":"NodeText","Data":"辛平无毒。去壳取仁，微炒用。"}]},{"ID":"20240612092300-b2lhoqk","Type":"NodeParagraph","Properties":{"id":"20240612092300-b2lhoqk","updated":"20240612092300"},"Children":[{"Type":"NodeText","Data":"《本经》主五内邪气，散皮肤、骨节中淫淫湿，行毒，去三虫化食。"}]},{"ID":"20240612092300-oujdt2r","Type":"NodeParagraph","Properties":{"id":"20240612092300-oujdt2r","updated":"20240612092300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"芜荑辛散，能祛五内、皮肤、骨节湿热之病。近世但知其有去疳杀虫及肠风痔、恶疮疥癣之用。殊失《本经》之旨。《千金》治妇人经带崩淋之病，每同泽兰、浓朴、本、白芷、细辛、防风、柏仁、石斛辈用之，取其去子脏中风热垢腻也。和猪脂捣涂疮。和蜜治湿癣。及治腹中气血痰酒诸癖，以芜荑仁炒香，兼暖胃活血理气药为散服之。"}]},{"ID":"20240612092250-04njvab","Type":"NodeThematicBreak","Properties":{"id":"20240612092250-04njvab"}},{"ID":"20240612092251-o6gh7rb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092251-o6gh7rb","updated":"20240612092255"},"Children":[{"Type":"NodeText","Data":"芜荑《本草衍义》"}]},{"ID":"20240612092251-qg2kri6","Type":"NodeParagraph","Properties":{"id":"20240612092251-qg2kri6","updated":"20240612092251"},"Children":[{"Type":"NodeText","Data":"有大小两种，小芜荑即榆荚也。揉取仁， 为酱，味尤辛。入药，当用大芜荑，别有种。然小芜荑 造多假，以外物相和，切须择去也。治大肠寒滑及多冷气，不可缺。"}]},{"ID":"20240612092240-gdw51mw","Type":"NodeThematicBreak","Properties":{"id":"20240612092240-gdw51mw"}},{"ID":"20240612092241-aoh12j3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092241-aoh12j3","updated":"20240612092245"},"Children":[{"Type":"NodeText","Data":"芜荑《神农本草经赞》"}]},{"ID":"20240612092241-46i6jbb","Type":"NodeParagraph","Properties":{"id":"20240612092241-46i6jbb","updated":"20240612092241"},"Children":[{"Type":"NodeText","Data":"味辛。主五内邪气。散皮肤骨节中淫淫温行毒。去三虫。化食。一名无姑。一名塘。生川谷。"}]},{"ID":"20240612092241-6kf9tbp","Type":"NodeParagraph","Properties":{"id":"20240612092241-6kf9tbp","updated":"20240612092241"},"Children":[{"Type":"NodeText","Data":"山榆束荚。心赤维嘉。盐香溢。酝酱辛加。臭攻齿。蛀。暖化腹瘕。潭山径。箭羽槎丫说文。梗山榆有束荚可为芜荑者。范子计然云芜荑在地。赤心者善。诗。维其嘉矣。"}]},{"ID":"20240612092241-ozdv5pk","Type":"NodeParagraph","Properties":{"id":"20240612092241-ozdv5pk","updated":"20240612092241"},"Children":[{"Type":"NodeText","Data":"苏颂曰。此榆乃大气臭。今人采实。以盐渍则失气味。仪礼。盐振祭。李时珍曰。酝为酱味尤辛。危氏得效方。虫牙。以芜荑安蛀孔即除。仁斋直指方。腹中鳖瘕。用芜荑及暖胃理中之剂。五代史。胡峤自契丹归。入大山。一大林长二三里皆芜荑。枝叶有芒刺如箭羽。岑参文。"}]},{"ID":"20240612092241-wdgma87","Type":"NodeParagraph","Properties":{"id":"20240612092241-wdgma87","updated":"20240612092241"},"Children":[{"Type":"NodeText","Data":"如戟槎丫。"}]},{"ID":"20240612092228-vwj4t9u","Type":"NodeThematicBreak","Properties":{"id":"20240612092228-vwj4t9u"}},{"ID":"20240612092229-37vb1w2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092229-37vb1w2","updated":"20240612092235"},"Children":[{"Type":"NodeText","Data":"芜荑《本草述钩元》"}]},{"ID":"20240612092229-nsxuy76","Type":"NodeParagraph","Properties":{"id":"20240612092229-nsxuy76","updated":"20240612092229"},"Children":[{"Type":"NodeText","Data":"山榆仁也。气膻者良。"}]},{"ID":"20240612092229-kl12g4m","Type":"NodeParagraph","Properties":{"id":"20240612092229-kl12g4m","updated":"20240612092229"},"Children":[{"Type":"NodeText","Data":"气味苦辛温平。主皮肤肢节中风毒淫淫如虫行。杀虫止痛。治积冷气心腹症痛。妇人子宫风虚。小儿疳泻冷痢。得诃子豆蔻良。和猪胆脂。涂热疮。和蜜。治湿癣。和牛酪或马酪。治一切疮。其功长于走肠胃杀诸虫。消食积。为小儿疳泻冷痢必资之药。（仲淳）脾胃有虫。食即作痛。面黄无色。以芜荑二两和面。炒黄色为末。不拘时。米饮服二钱匕。疳热有虫瘦悴。久服充肥。用芜荑一两黄连一两为末。猪胆汁七枚和入碗内。饭上蒸之。日一次。九蒸后。入麝香五分。汤浸蒸饼和丸。绿豆大。每服五七丸至一二十丸。米饮下。结阴下血。芜荑一两捣烂。纸压去油。为末。以雄猪胆汁丸梧子大。每服九丸。甘草汤下。日五服。三日断根。脾胃气泄。久患不止。芜荑五两捣末。饭丸梧子大。每空心午饭前。陈米饮下三十丸。腹中鳖瘕。嗜酒者。血入于酒为酒鳖。多气者。血凝于气为气鳖。虚劳痼冷。败血杂痰为血鳖。摇头摆尾。如虫之行。上侵人咽。下蚀人肛。或附胁背。或隐胸腹。"}]},{"ID":"20240612092229-218v3n4","Type":"NodeParagraph","Properties":{"id":"20240612092229-218v3n4","updated":"20240612092229"},"Children":[{"Type":"NodeText","Data":"大则如鳖。小或如钱。治法惟用芜荑炒煎服之。兼用暖胃益血理中药。乃可杀之。若徒事雷丸锡灰之类。无益也（直指方）多服发热心痛。为辛故也。（孟诜）〔论〕芜荑先百木而青。逗春生之端。当入肝以宣肝用。其味辛。是木以金为主。而得宣之用也。其气温。正得春阳之气也。辛温更合于苦味。而宣散乃有功。世但知其散风杀虫。不知从极阴之脏而宣阳。故气之凝者能散。血之结者皆宣耳。夫脾胃为后天气血之源。"}]},{"ID":"20240612092229-iulnuse","Type":"NodeParagraph","Properties":{"id":"20240612092229-iulnuse","updated":"20240612092229"},"Children":[{"Type":"NodeText","Data":"而以肝为主。仁斋谓治虫独取此味。兼之能理气血者。诚为有见。即其所治妇人子宫风虚。"}]},{"ID":"20240612092229-48b1ge8","Type":"NodeParagraph","Properties":{"id":"20240612092229-48b1ge8","updated":"20240612092229"},"Children":[{"Type":"NodeText","Data":"非亦根于气血之虚乎。（肾受五脏六腑之精而藏之。然胞宫为之行其化。亦本于厥阴风木之化。气血虚则胞宫无所藏。而风木亦无所养以行其化也。）〔辨治〕当用大者。（小者即榆荚仁）陈久乃良。炒去壳。其气膻。"}]},{"ID":"20240612092138-ey0yqav","Type":"NodeThematicBreak","Properties":{"id":"20240612092138-ey0yqav"}},{"ID":"20240612092139-1e2vxxa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092139-1e2vxxa","updated":"20240612092145"},"Children":[{"Type":"NodeText","Data":"芜荑《新修本草》"}]},{"ID":"20240612092139-3sg2j5n","Type":"NodeParagraph","Properties":{"id":"20240612092139-3sg2j5n","updated":"20240612092139"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主五内邪气，散皮肤骨节中淫淫行毒，去三虫，化食，逐寸白，散腹中温温喘息。一名无姑，一名 。生晋山川谷。三月采实，阴干。"}]},{"ID":"20240612092139-zvbzw1f","Type":"NodeParagraph","Properties":{"id":"20240612092139-zvbzw1f","updated":"20240612092139"},"Children":[{"Type":"NodeText","Data":"今唯出高丽，状如榆荚，气臭如 ，彼人皆以作酱食之。性杀虫，以置物中，亦辟蛀。"}]},{"ID":"20240612092139-7q1rgvj","Type":"NodeParagraph","Properties":{"id":"20240612092139-7q1rgvj","updated":"20240612092139"},"Children":[{"Type":"NodeText","Data":"但患其臭耳。"}]},{"ID":"20240612092139-7rqopmw","Type":"NodeParagraph","Properties":{"id":"20240612092139-7rqopmw","updated":"20240612092139"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《尔雅》"}]},{"ID":"20240612092139-da0ze15","Type":"NodeParagraph","Properties":{"id":"20240612092139-da0ze15","updated":"20240612092139"},"Children":[{"Type":"NodeText","Data":"云∶芜荑一名 KT ，今名 ，字之误也。今出延州、同州者，最好。"}]},{"ID":"20240612092128-v6d62ty","Type":"NodeThematicBreak","Properties":{"id":"20240612092128-v6d62ty"}},{"ID":"20240612092129-ha2p5xo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092129-ha2p5xo","updated":"20240612092133"},"Children":[{"Type":"NodeText","Data":"芜荑《本草经集注》"}]},{"ID":"20240612092129-ugsi4fz","Type":"NodeParagraph","Properties":{"id":"20240612092129-ugsi4fz","updated":"20240612092129"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主治五内邪气，散皮肤骨节中淫淫温行毒，去三虫，化食，逐寸白，散腹中 喘息。一名无姑，一名 。生晋山川谷。三月采实，阴干。"}]},{"ID":"20240612092129-wge8n1z","Type":"NodeParagraph","Properties":{"id":"20240612092129-wge8n1z","updated":"20240612092129"},"Children":[{"Type":"NodeText","Data":"今唯出高丽，状如榆荚，气臭如 ，彼人皆以作酱食之。性杀虫，以置物中，亦辟蛀。"}]},{"ID":"20240612092129-xdlonxc","Type":"NodeParagraph","Properties":{"id":"20240612092129-xdlonxc","updated":"20240612092129"},"Children":[{"Type":"NodeText","Data":"但患其臭尔。"}]},{"ID":"20240612092111-bv3tpjf","Type":"NodeThematicBreak","Properties":{"id":"20240612092111-bv3tpjf"}},{"ID":"20240612092112-dl3vcvx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092112-dl3vcvx","updated":"20240612092122"},"Children":[{"Type":"NodeText","Data":"芜荑《本草图经》"}]},{"ID":"20240612092112-zeialsh","Type":"NodeParagraph","Properties":{"id":"20240612092112-zeialsh","updated":"20240612092118"},"Children":[{"Type":"NodeText","Data":"芜荑，生晋山川谷，今近道山川谷，今近道亦有之，大抵榆类而差小，其实亦早成，比榆乃大，气臭如 ，《尔雅·释木》云∶无姑，其实夷。郭璞云∶无姑，姑榆也，生山中，叶圆而浓，剥取皮，合渍之。其味辛香，所谓芜荑也。又《释草》云∶ 荑， 。注云∶一名白蒉，而与《本经》一名 （音殿） （音唐）相近。苏恭云∶ ， 。字之误也。然荑草类，无荑乃木也。明是二物，或气类之相近欤。三月采实，阴干。杀虫方中多用之。今人又多取作屑，以 五味，其用陈者良。人收藏之，多以盐渍，则失气味。此等不堪入药，但可作食品耳。秋后尤宜食之。《续传信方》治久患脾胃气泄不止，芜荑五两，捣末，以饭丸，每日空心午饭前，各用陈米饮下三十丸，增至四十丸。久服去三尸，益神，驻颜。云得之章镣曾得力。"}]},{"ID":"20240612092100-aa1v70j","Type":"NodeThematicBreak","Properties":{"id":"20240612092100-aa1v70j"}},{"ID":"20240612092101-mv3kbll","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092101-mv3kbll","updated":"20240612092106"},"Children":[{"Type":"NodeText","Data":"芜荑《医学入门》"}]},{"ID":"20240612092101-5zckf4u","Type":"NodeParagraph","Properties":{"id":"20240612092101-5zckf4u","updated":"20240612092101"},"Children":[{"Type":"NodeText","Data":"芜荑无毒味辛平，疗风治疥杀虫灵，积 肠滑不可缺，腹心冷气痛堪凭。"}]},{"ID":"20240612092101-nprom30","Type":"NodeParagraph","Properties":{"id":"20240612092101-nprom30","updated":"20240612092101"},"Children":[{"Type":"NodeText","Data":"芜，秽也；荑，伤也，其气臭如伤败之物也。疗皮肤骨节中风毒，淫淫如虫行，又治恶疮、疥癣、痔 、一切疮，多用外敷。性杀虫，去三虫，逐寸白芨脾胃有虫。食即痛， 结积聚，肠鸣腹痛，冷痢滑泻及冷气心痛不可缺也。兼治妇人子宫风虚，小儿疳积，中恶蛊毒。孟诜云∶多用发热心痛，为辛故也。陈久者良，小者即榆荚仁，止堪为酱及治鸡病，入药当用大者，面炒黄，得诃子、豆蔻良。"}]},{"ID":"20240612092050-dzuypp3","Type":"NodeThematicBreak","Properties":{"id":"20240612092050-dzuypp3"}},{"ID":"20240612092051-dw633dy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092051-dw633dy","updated":"20240612092055"},"Children":[{"Type":"NodeText","Data":"芜荑《本草从新》"}]},{"ID":"20240612092051-d6zxrqs","Type":"NodeParagraph","Properties":{"id":"20240612092051-d6zxrqs","updated":"20240612092051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、散风湿、泻、消积杀虫．"}]},{"ID":"20240612092051-4919cyf","Type":"NodeParagraph","Properties":{"id":"20240612092051-4919cyf","updated":"20240612092051"},"Children":[{"Type":"NodeText","Data":"辛散满．苦杀虫．温燥湿化食．（诸虫皆因湿而生、气食皆因寒而滞．）祛五脏皮肤肢节风湿．心腹积冷．症痛鳖瘕．（直指方云∶嗜酒人血入于酒、为酒鳖、多气人血入于气、为气鳖、虚劳人败血杂痰、为血鳖、如虫之行、上侵入咽、下蚀入肛、或附胁背、或隐胸腹、唯用芜荑炒、兼暖胃理气益血之药、乃可杀之．）痔 疮癣．小儿惊疳冷痢．（得诃子豆蔻良．）胃中虫痛．（和面炒黄为末、米饮下．）脾胃虚者．虽有积．勿概投．形类榆荚．陈久气膻者良．（牙虫作痛、以芜荑仁安蛀孔中及缝中、甚效．）"}]},{"ID":"20240612092040-ee8c2s2","Type":"NodeThematicBreak","Properties":{"id":"20240612092040-ee8c2s2"}},{"ID":"20240612092041-fqpcl7d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612092041-fqpcl7d","updated":"20240612092045"},"Children":[{"Type":"NodeText","Data":"芜荑《本草求真》"}]},{"ID":"20240612092041-u12llhc","Type":"NodeParagraph","Properties":{"id":"20240612092041-u12llhc","updated":"20240612092041"},"Children":[{"Type":"NodeText","Data":"（乔木）燥脾杀虫散皮肤骨节湿热"}]},{"ID":"20240612092041-s7xhpeo","Type":"NodeParagraph","Properties":{"id":"20240612092041-s7xhpeo","updated":"20240612092041"},"Children":[{"Type":"NodeText","Data":"芜荑（专入脾。兼入肝）。味辛而苦。（时珍曰。芜荑有大小两种。小者即榆荚也。揉取仁。酝为酱。味尤辛。人多以外物相和。不可不择去之。入药皆用大芜荑。别有种。）气温无毒。功专燥脾。去风化食杀虫。缘虫生于人腹。多因湿为之兆。滞为之得。风为之助。寒为之成。上侵人咽。下蚀人肛。或附胁背。或隐胸腹。大则如鳖。小则如钱。治法惟当用此煎服。兼用暖胃益血理中之类。乃可杀之。且不独杀虫如是。即其皮肤骨节。湿热内入。留连不解。以致秽垢不清。得以合其辛散等药。亦能去风除湿。而使气血调和。肢节安养。而无瘫痪痿痹之候矣！柰世仅知扫虫杀蛊。（蛊牙作痛。以芜荑仁安蛀孔中。及缝中甚效。）而不知此更散皮肤骨节淫湿。其亦未达本经之旨耳。形类榆荚。陈久气膻者良。"}]},{"ID":"20240612091944-wf5tmox","Type":"NodeThematicBreak","Properties":{"id":"20240612091944-wf5tmox"}},{"ID":"20240612091945-2g8w3mu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091945-2g8w3mu","updated":"20240612091955"},"Children":[{"Type":"NodeText","Data":"芜荑《中药学》"}]},{"ID":"20240612091945-ndnxvs9","Type":"NodeParagraph","Properties":{"id":"20240612091945-ndnxvs9","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【药用】本品为榆树科植物大果榆树的经加工的果实。"}]},{"ID":"20240612091945-40jzoh1","Type":"NodeParagraph","Properties":{"id":"20240612091945-40jzoh1","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，温。入脾、胃经。"}]},{"ID":"20240612091945-r3jygmx","Type":"NodeParagraph","Properties":{"id":"20240612091945-r3jygmx","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【功效】杀虫消疳。"}]},{"ID":"20240612091945-q0dhf9v","Type":"NodeParagraph","Properties":{"id":"20240612091945-q0dhf9v","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【临床应用】用于虫积腹痛，泻痢等症。"}]},{"ID":"20240612091945-cneszwi","Type":"NodeParagraph","Properties":{"id":"20240612091945-cneszwi","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"本品功能杀虫消积，主要用于治蛔虫病、绦虫病，常与鹤虱、使君子、槟榔等配合应用。对小儿疳积、泻痢日久，也可配合诃子、肉豆蔻等同用。"}]},{"ID":"20240612091945-49axopd","Type":"NodeParagraph","Properties":{"id":"20240612091945-49axopd","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【处方用名】芜荑、臭芜荑、白芜荑（洗净，晒干用）"}]},{"ID":"20240612091945-nmv0gcp","Type":"NodeParagraph","Properties":{"id":"20240612091945-nmv0gcp","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，煎服。"}]},{"ID":"20240612091945-4ei1i0q","Type":"NodeParagraph","Properties":{"id":"20240612091945-4ei1i0q","updated":"20240612091945"},"Children":[{"Type":"NodeText","Data":"【方剂举例】芜荑散《证治准绳》：芜荑、干漆。治蛔虫咬心痛，牙虫作痛。"}]},{"ID":"20240612091932-l8akvxx","Type":"NodeThematicBreak","Properties":{"id":"20240612091932-l8akvxx"}},{"ID":"20240612091933-i9kz6l1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091933-i9kz6l1","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：芜荑"}]},{"ID":"20240612091933-81kifzj","Type":"NodeParagraph","Properties":{"id":"20240612091933-81kifzj","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612091933-pzqwco1","Type":"NodeParagraph","Properties":{"id":"20240612091933-pzqwco1","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" Wú Yí"}]},{"ID":"20240612091933-oq0dywa","Type":"NodeParagraph","Properties":{"id":"20240612091933-oq0dywa","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612091933-nq0tlij","Type":"NodeParagraph","Properties":{"id":"20240612091933-nq0tlij","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 臭芜荑、黄榆、毛榆、山榆"}]},{"ID":"20240612091933-w6fs8tc","Type":"NodeParagraph","Properties":{"id":"20240612091933-w6fs8tc","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612091933-mq3zx9s","Type":"NodeParagraph","Properties":{"id":"20240612091933-mq3zx9s","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 榆科榆属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大果榆"},{"Type":"NodeText","Data":"Ulmus macrocarpa Hance的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子经加工后的成品"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612091933-opgveko","Type":"NodeParagraph","Properties":{"id":"20240612091933-opgveko","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612091933-jwun8uf","Type":"NodeParagraph","Properties":{"id":"20240612091933-jwun8uf","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 药材呈扁平方块状。表面棕黄色或棕褐色，有多数孔洞和孔隙，杂有多数纤维及种子。质地松脆而粗糙，易起层剥离。具特异的恶骚臭气。"}]},{"ID":"20240612091933-1849j2j","Type":"NodeParagraph","Properties":{"id":"20240612091933-1849j2j","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612091933-p8pnx7r","Type":"NodeParagraph","Properties":{"id":"20240612091933-p8pnx7r","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 夏季果实成熟采下，晒干，搓去膜翅取出种子。取种子55斤浸入温水中，待发酵后，加入榆树皮面10斤，红土30斤，菊花末5斤，加适量温开水混合均匀，如糊状，摊平约4分厚，切约2寸方块，晒干，即为成品。另一用法是在5月间采果，阴干。"}]},{"ID":"20240612091933-4o0v8ux","Type":"NodeParagraph","Properties":{"id":"20240612091933-4o0v8ux","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612091933-g2y2uvd","Type":"NodeParagraph","Properties":{"id":"20240612091933-g2y2uvd","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 辛、苦，平。"}]},{"ID":"20240612091933-e59v17e","Type":"NodeParagraph","Properties":{"id":"20240612091933-e59v17e","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612091933-ntuu97n","Type":"NodeParagraph","Properties":{"id":"20240612091933-ntuu97n","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 消积杀虫。用于小儿疳积，蛔虫病，蛲虫病。"}]},{"ID":"20240612091933-yrc53e9","Type":"NodeParagraph","Properties":{"id":"20240612091933-yrc53e9","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612091933-ixc4uqp","Type":"NodeParagraph","Properties":{"id":"20240612091933-ixc4uqp","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 1～3钱。"}]},{"ID":"20240612091933-h87f18d","Type":"NodeParagraph","Properties":{"id":"20240612091933-h87f18d","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612091933-qtaplnw","Type":"NodeParagraph","Properties":{"id":"20240612091933-qtaplnw","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612091933-10rtv13","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091933-10rtv13","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：芜荑"}]},{"ID":"20240612091933-nzzu4lo","Type":"NodeParagraph","Properties":{"id":"20240612091933-nzzu4lo","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612091933-sxnpyrj","Type":"NodeParagraph","Properties":{"id":"20240612091933-sxnpyrj","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" Wú Yí"}]},{"ID":"20240612091933-end8yuo","Type":"NodeParagraph","Properties":{"id":"20240612091933-end8yuo","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612091933-ekucdcf","Type":"NodeParagraph","Properties":{"id":"20240612091933-ekucdcf","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 殿蓎（《本经》），无夷（《尔雅》郭璞注），芜荑仁（《千金方》），山榆子（《千金·食治》），山榆仁（《本草拾遗》），白芜荑（《圣惠方》），大果榆糊（《药材学》）。"}]},{"ID":"20240612091933-m2bcoba","Type":"NodeParagraph","Properties":{"id":"20240612091933-m2bcoba","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612091933-0o3yjcz","Type":"NodeParagraph","Properties":{"id":"20240612091933-0o3yjcz","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612091933-fq6d7xt","Type":"NodeParagraph","Properties":{"id":"20240612091933-fq6d7xt","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612091933-kcdcmay","Type":"NodeParagraph","Properties":{"id":"20240612091933-kcdcmay","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 为榆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大果榆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"果实的加工品"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612091933-f3m6pau","Type":"NodeParagraph","Properties":{"id":"20240612091933-f3m6pau","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612091933-ig0bse5","Type":"NodeParagraph","Properties":{"id":"20240612091933-ig0bse5","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 生长于山地、山麓及岩石地。分布辽宁、吉林、黑龙江、内蒙古、河北、山西、陕西等地。主产山西、河北。东北各地亦产。"}]},{"ID":"20240612091933-35mpss6","Type":"NodeParagraph","Properties":{"id":"20240612091933-35mpss6","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612091933-jgl7wb6","Type":"NodeParagraph","Properties":{"id":"20240612091933-jgl7wb6","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 大果榆，又名：无姑（《尔雅》），山粉榆（《说文》），山榆（《广雅》），姑榆（《尔雅》郭璞注），迸榆、黄榆、扁榆、毛榆、柳榆。"}]},{"ID":"20240612091933-kvmfch5","Type":"NodeParagraph","Properties":{"id":"20240612091933-kvmfch5","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"落叶小乔木或灌木状，高15～30米。大枝斜向，开展，小枝淡黄褐色或带淡红褐色，有粗毛，枝上常有发达的木栓质翅。叶互生；叶柄长2～6毫米，密生短柔毛；叶片阔倒卵形，长5～9厘米，宽4～5厘米，先端突尖，基部狭，两边不对称或浅心形，边缘具钝单锯齿或重锯齿，两面粗糙，有粗毛。花5～9朵簇生，先叶开放；花大，长达15毫米，两性，花被4～5裂，绿色；雄蕊与花被片同数，花药大，带黄玫瑰色；雌蕊1，绿色，柱头2裂。翅果大形，倒卵形成近卵形，长2.5～3.5厘米，宽2～3厘米，全部有毛，有短柄。种子位于翅果中部。花期春季。"}]},{"ID":"20240612091933-d2iskso","Type":"NodeParagraph","Properties":{"id":"20240612091933-d2iskso","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612091933-ywce6fu","Type":"NodeParagraph","Properties":{"id":"20240612091933-ywce6fu","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 呈方块状，表面褐黄色，有多数小孔.体轻质松脆。断面黄黑色，易成鳞片状剥离。气特臭，味微酸涩。"}]},{"ID":"20240612091933-5a9dq71","Type":"NodeParagraph","Properties":{"id":"20240612091933-5a9dq71","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612091933-82q5b4e","Type":"NodeParagraph","Properties":{"id":"20240612091933-82q5b4e","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" ①驱虫作用"}]},{"ID":"20240612091933-53cio13","Type":"NodeParagraph","Properties":{"id":"20240612091933-53cio13","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"芜荑醇浸提取物在体外对猪蛔虫、蚯蚓、蚂蝗皆有显着治虫效力；以乙醚提取的挥发油，予兔口服1克／公斤未见毒性。用于感染肺吸虫的猫，口服10％芜荑煎液24毫升／公斤／日，未见治疗效果，且有一猫在疗程结束后五天死亡，可能是量大中毒所致。"}]},{"ID":"20240612091933-8mrpk33","Type":"NodeParagraph","Properties":{"id":"20240612091933-8mrpk33","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"②抗真菌作用"}]},{"ID":"20240612091933-3sa3wzn","Type":"NodeParagraph","Properties":{"id":"20240612091933-3sa3wzn","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"芜荑浸液（1：2）在试管内对堇色毛癣菌、奥杜盎氏小芽胞癣菌等12种皮肤真菌有不同程度的抑制作用。"}]},{"ID":"20240612091933-ds0s4f9","Type":"NodeParagraph","Properties":{"id":"20240612091933-ds0s4f9","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612091933-f7eneav","Type":"NodeParagraph","Properties":{"id":"20240612091933-f7eneav","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经，"}]},{"ID":"20240612091933-29qiyi7","Type":"NodeParagraph","Properties":{"id":"20240612091933-29qiyi7","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肺、脾二经。\""}]},{"ID":"20240612091933-0a1r356","Type":"NodeParagraph","Properties":{"id":"20240612091933-0a1r356","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"②《玉楸药解》：\"入厥阴肝经。\""}]},{"ID":"20240612091933-boqne9s","Type":"NodeParagraph","Properties":{"id":"20240612091933-boqne9s","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"③《要药分剂》：\"入脾、胃二经。\""}]},{"ID":"20240612091933-byuz4lo","Type":"NodeParagraph","Properties":{"id":"20240612091933-byuz4lo","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"④《本草再新》：\"入心、脾二经。\""}]},{"ID":"20240612091933-2z7h8kx","Type":"NodeParagraph","Properties":{"id":"20240612091933-2z7h8kx","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612091933-qidtiea","Type":"NodeParagraph","Properties":{"id":"20240612091933-qidtiea","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 苦辛，温。"}]},{"ID":"20240612091933-3o82506","Type":"NodeParagraph","Properties":{"id":"20240612091933-3o82506","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，平。\""}]},{"ID":"20240612091933-r4xwe9j","Type":"NodeParagraph","Properties":{"id":"20240612091933-r4xwe9j","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味苦辛。\""}]},{"ID":"20240612091933-z525p8g","Type":"NodeParagraph","Properties":{"id":"20240612091933-z525p8g","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"③《海药本草》：\"味辛，温，无毒。\""}]},{"ID":"20240612091933-zmphjtx","Type":"NodeParagraph","Properties":{"id":"20240612091933-zmphjtx","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612091933-9kns0ec","Type":"NodeParagraph","Properties":{"id":"20240612091933-9kns0ec","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 脾胃虚弱者慎服，"}]},{"ID":"20240612091933-6fe2ue7","Type":"NodeParagraph","Properties":{"id":"20240612091933-6fe2ue7","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"①《海药本草》：\"得诃子、豆蔻良。\""}]},{"ID":"20240612091933-fautek0","Type":"NodeParagraph","Properties":{"id":"20240612091933-fautek0","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"②《本草从新》：\"脾胃虚者，虽有积，勿概投。\""}]},{"ID":"20240612091933-p7zz2z5","Type":"NodeParagraph","Properties":{"id":"20240612091933-p7zz2z5","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"③《得配本草》：\"脾、肺燥热者禁用。\""}]},{"ID":"20240612091933-sz3owf0","Type":"NodeParagraph","Properties":{"id":"20240612091933-sz3owf0","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612091933-y39so1q","Type":"NodeParagraph","Properties":{"id":"20240612091933-y39so1q","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 杀虫，消积。治虫积腹痛。小儿疳泻、冷痢，疥癣，恶疮。"}]},{"ID":"20240612091933-4221rfo","Type":"NodeParagraph","Properties":{"id":"20240612091933-4221rfo","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主五内邪气，散皮肤骨节中淫淫温行毒，去三虫，化食。\""}]},{"ID":"20240612091933-fuhp98a","Type":"NodeParagraph","Properties":{"id":"20240612091933-fuhp98a","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"逐寸白，散肠中嗢嗢喘息。\""}]},{"ID":"20240612091933-pg0mkxd","Type":"NodeParagraph","Properties":{"id":"20240612091933-pg0mkxd","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能主积冷气，心腹症痛，除肌肤节中风淫淫如虫行。\""}]},{"ID":"20240612091933-c1wgfym","Type":"NodeParagraph","Properties":{"id":"20240612091933-c1wgfym","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"④孟诜：\"治热疮，捣和猪脂涂。又和白蜜治湿癣。和沙牛酪疗一切疮。长食治五痔。\""}]},{"ID":"20240612091933-kzyht8f","Type":"NodeParagraph","Properties":{"id":"20240612091933-kzyht8f","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑤《食疗本草》：\"散腹中气痛。又和马酪可治癣。又杀中恶虫毒。\""}]},{"ID":"20240612091933-h8pe9nr","Type":"NodeParagraph","Properties":{"id":"20240612091933-h8pe9nr","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑥《海药本草》：\"治冷痢心气，杀虫止痛。又治妇人子宫风虚，孩子疳泻。\""}]},{"ID":"20240612091933-taqq6wa","Type":"NodeParagraph","Properties":{"id":"20240612091933-taqq6wa","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑦《日华子本草》：\"治肠风痔漏，恶疮疥癣。\""}]},{"ID":"20240612091933-d9e9h5s","Type":"NodeParagraph","Properties":{"id":"20240612091933-d9e9h5s","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑧《医林纂要》：\"泻肺法风湿，燥脾消寒食，治疸黄，杀虫去蛔。\""}]},{"ID":"20240612091933-h140nzt","Type":"NodeParagraph","Properties":{"id":"20240612091933-h140nzt","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑨《中国药植图鉴》：\"祛痰利尿。\""}]},{"ID":"20240612091933-omfoc04","Type":"NodeParagraph","Properties":{"id":"20240612091933-omfoc04","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612091933-n73c51y","Type":"NodeParagraph","Properties":{"id":"20240612091933-n73c51y","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240612091933-tjeab45","Type":"NodeParagraph","Properties":{"id":"20240612091933-tjeab45","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612091933-pv9n69d","Type":"NodeParagraph","Properties":{"id":"20240612091933-pv9n69d","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" ①治脾胃有虫，食即痛，面黄五色，疼痛无时：芜荑仁二两，和面炒令黄色，为末，非时，米饮调二钱匕。（《千金方》）"}]},{"ID":"20240612091933-4y7auvd","Type":"NodeParagraph","Properties":{"id":"20240612091933-4y7auvd","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"②治大人小儿蛔痛，大痛不可忍，或吐青黄绿水涎沫，或吐虫出，发有休止：芜荑、雷丸各半两，干漆（捶碎，炒烟尽）一两。上为细末，每服三钱，温水七分盏，调和服，不拘时，甚者不过三服。小儿每服半钱。（《奇效良方》芜荑散）"}]},{"ID":"20240612091933-eeie77p","Type":"NodeParagraph","Properties":{"id":"20240612091933-eeie77p","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"③治久患脾胃气泄不止：芜荑五两，捣末，以饭丸。每日空心午饭前，各用陈米饮下三十丸，增至四十丸。（《续传信方》）"}]},{"ID":"20240612091933-1va5912","Type":"NodeParagraph","Properties":{"id":"20240612091933-1va5912","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"④治久痢不瘥，有虫，兼下部脱肛：芜荑二两（微炒），黄连一两（去须，微炒），蚺蛇胆半两。上药，捣罗为末，炼蜜和丸，如梧桐子大。每服，以杏仁扬下三十丸，日再服。（《圣惠方，芜荑丸）"}]},{"ID":"20240612091933-913spet","Type":"NodeParagraph","Properties":{"id":"20240612091933-913spet","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑤治小儿虫痫，胃寒虫上，诸证危恶，与痫相似：白芜荑、干漆（烧存性）等分。为末，米饮调服一字至一钱。（《医准》）"}]},{"ID":"20240612091933-ala8imd","Type":"NodeParagraph","Properties":{"id":"20240612091933-ala8imd","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑥治下血结阴：芜荑一两。捣碎，研令细，用纸裹压去油，再研为末，用雄猪胆丸梧桐子大。每服九丸，甘草汤下，日五、六服。（《普济方》芜荑丸）"}]},{"ID":"20240612091933-gke9kfa","Type":"NodeParagraph","Properties":{"id":"20240612091933-gke9kfa","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑦治虫牙作痛：芜荑仁安蛀孔中及缝中。（《世医得效方》）"}]},{"ID":"20240612091933-p4z15kh","Type":"NodeParagraph","Properties":{"id":"20240612091933-p4z15kh","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"⑧治诸积冷气：芜荑一两（炒），大茴香，木香各五钱。共为末，红曲打糊为丸，梧桐子大。每早服三钱，白汤下。（《本草汇言》）"}]},{"ID":"20240612091933-yvf1zka","Type":"NodeParagraph","Properties":{"id":"20240612091933-yvf1zka","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"制法"}]},{"ID":"20240612091933-c02t2dw","Type":"NodeParagraph","Properties":{"id":"20240612091933-c02t2dw","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 夏季当大果榆的果实成熟时采下，晒干，搓去膜翅，取出种子。将种子55斤浸入水中，待发酵后，加入家榆树皮面10斤，红土30斤，菊花末5斤，加适量温开水混合均匀，如糊状，放板上摊平约四分厚，切约2寸方块晒干，即为成品。亦可在农历4～5月采实取仁。用种子60％、异叶败酱20％，家榆树皮10％，灶心土10％，混合制成扁平方形，置于日光下晒干即成。"}]},{"ID":"20240612091933-6vozezk","Type":"NodeParagraph","Properties":{"id":"20240612091933-6vozezk","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612091933-43sp2sy","Type":"NodeParagraph","Properties":{"id":"20240612091933-43sp2sy","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612091933-tebmqbr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612091933-tebmqbr","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"《中华本草》：芜荑"}]},{"ID":"20240612091933-ktyzg50","Type":"NodeParagraph","Properties":{"id":"20240612091933-ktyzg50","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612091933-4jh0f1d","Type":"NodeParagraph","Properties":{"id":"20240612091933-4jh0f1d","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" Wú Yí"}]},{"ID":"20240612091933-tuayooc","Type":"NodeParagraph","Properties":{"id":"20240612091933-tuayooc","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612091933-5hj7pna","Type":"NodeParagraph","Properties":{"id":"20240612091933-5hj7pna","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 无荑、无姑、（艹殿）（艹塘）、芜荑仁、山榆子、山榆仁、白芜荑、大果榆树"}]},{"ID":"20240612091933-uulucfd","Type":"NodeParagraph","Properties":{"id":"20240612091933-uulucfd","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612091933-1s31np9","Type":"NodeParagraph","Properties":{"id":"20240612091933-1s31np9","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612091933-g750x2x","Type":"NodeParagraph","Properties":{"id":"20240612091933-g750x2x","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"《本草衍义》：芜荑，有大小两种，小芜荑即榆荚也。揉取仁，酝为酱，味尤辛。入药当用大芜荑，别有种。然小芜荑酝造，多假以外物相和，切须择取也。"}]},{"ID":"20240612091933-qqtkknt","Type":"NodeParagraph","Properties":{"id":"20240612091933-qqtkknt","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612091933-0kyh91o","Type":"NodeParagraph","Properties":{"id":"20240612091933-0kyh91o","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 药材基源：为榆科植物大果榆果实的加工品。"}]},{"ID":"20240612091933-ryt1w7o","Type":"NodeParagraph","Properties":{"id":"20240612091933-ryt1w7o","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Ulmus macrocarpa Hance"}]},{"ID":"20240612091933-80yswzf","Type":"NodeParagraph","Properties":{"id":"20240612091933-80yswzf","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏季当果实成熟时采下，晒干，搓去膜翅，取出种子。将种子55kg浸入水中，待发酵后，加入家榆树皮面5kg，红土15kg，菊花末2.5kg，加适量温开水混全均匀，如糊状，放板上摊平约1.3cm厚，节成径约6.7cm的方块，晒干，即为成品。亦可在5-6月采实取仁，用种子60%，异叶败酱20%，家榆树皮10%，混合制成扁平方形，晒干。"}]},{"ID":"20240612091933-c8kax9s","Type":"NodeParagraph","Properties":{"id":"20240612091933-c8kax9s","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612091933-ds29imf","Type":"NodeParagraph","Properties":{"id":"20240612091933-ds29imf","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔1000-1300m的向阳山坡、丘陵及固定沙丘上，在林区多生于林缘及河岸。"}]},{"ID":"20240612091933-8jy1dh4","Type":"NodeParagraph","Properties":{"id":"20240612091933-8jy1dh4","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于东北、华北及陕西、甘肃、青海、江苏、安徽、河南等地。"}]},{"ID":"20240612091933-0gqf9a3","Type":"NodeParagraph","Properties":{"id":"20240612091933-0gqf9a3","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612091933-5wgqwej","Type":"NodeParagraph","Properties":{"id":"20240612091933-5wgqwej","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 落叶小乔木或灌木，高15-30m。枝常有具木栓质翅，当年生枝绿褐色或褐色，有粗毛；老枝褐色无毛。叶互生；叶柄长2-6mm，有短柔毛；托叶早落；叶片宽倒卵形或椭圆状倒卵形，长5-10cm，宽3-7cm，中上部最宽，先端突尖，基部狭或浅心形，两边不对称，两面粗糙，有粗毛，边缘具钝单锯齿或重锯齿。花先叶开放，数朵簇生于去年枝的叶腋或散生于当年枝的基部；花大，长达15mm，两性；花被4-5裂，绿色；雄蕊与花被片同数，花药大，带黄玫瑰色；雌蕊1，子房1室，绿色，柱头2裂。翅果特大，长2.5-3.5cm，宽2.2-2.5cm，被毛，花被宿存，种子位于翅果的中部。花期4-5月，果熟期5-6月。"}]},{"ID":"20240612091933-e8k74i8","Type":"NodeParagraph","Properties":{"id":"20240612091933-e8k74i8","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612091933-c3nd0sm","Type":"NodeParagraph","Properties":{"id":"20240612091933-c3nd0sm","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 加工品呈扁平方块状，表面黄褐色，有多数小孔和空隙，杂有纤维和种子。体质松脆而粗糙，断面黄黑色，易成鳞片状剥离。气特异，味微酸涩。"}]},{"ID":"20240612091933-kkdemww","Type":"NodeParagraph","Properties":{"id":"20240612091933-kkdemww","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：①淀粉粒众多，单粒淀粉圆球形，直径4μm左右；复粒由2-8个分粒组成。②纤维壁厚，壁孔不明显。③花粉粒圆球形，表面有刺状突起，萌发孔3个。④花瓣表面碎片上表皮细胞呈毛茸状突起。"}]},{"ID":"20240612091933-jjyyobu","Type":"NodeParagraph","Properties":{"id":"20240612091933-jjyyobu","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612091933-v4bnmj9","Type":"NodeParagraph","Properties":{"id":"20240612091933-v4bnmj9","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 1.驱虫作用 芜荑醇浸提取物在体外对猪蛔虫、蚯蚓、蚂蝗皆有显着治虫效力；以乙醚提取的挥发油，予兔口服1g/kg未见毒性。用于感染肺吸虫的猫，口服10%芜荑煎液24ml／kg／日，未见治疗效果，且有一猫在疗程结束后五天死亡，可能是量大中毒所致。"}]},{"ID":"20240612091933-aumo1mb","Type":"NodeParagraph","Properties":{"id":"20240612091933-aumo1mb","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"2.抗真菌作用 芜荑浸液(1：2)在试管内对堇色毛癣菌、奥杜盎氏小芽胞癣菌等12种皮肤真菌有不同程度的抑制作用。"}]},{"ID":"20240612091933-hgwtqrk","Type":"NodeParagraph","Properties":{"id":"20240612091933-hgwtqrk","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612091933-56gglea","Type":"NodeParagraph","Properties":{"id":"20240612091933-56gglea","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 脾；胃经"}]},{"ID":"20240612091933-crdnjk1","Type":"NodeParagraph","Properties":{"id":"20240612091933-crdnjk1","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612091933-6yjskoi","Type":"NodeParagraph","Properties":{"id":"20240612091933-6yjskoi","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 苦；辛；性温"}]},{"ID":"20240612091933-8axo1u4","Type":"NodeParagraph","Properties":{"id":"20240612091933-8axo1u4","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612091933-5hqtz85","Type":"NodeParagraph","Properties":{"id":"20240612091933-5hqtz85","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 1.脾胃虚弱者慎服。"}]},{"ID":"20240612091933-vhdfoej","Type":"NodeParagraph","Properties":{"id":"20240612091933-vhdfoej","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"2.《海药本草》：得诃子、豆蔻良。"}]},{"ID":"20240612091933-u0z7z6j","Type":"NodeParagraph","Properties":{"id":"20240612091933-u0z7z6j","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"3.《本草从新》：脾胃虚者，虽有积，勿概投。"}]},{"ID":"20240612091933-m4gvppb","Type":"NodeParagraph","Properties":{"id":"20240612091933-m4gvppb","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"4.《得配本草》：脾、肺燥热者禁用。"}]},{"ID":"20240612091933-don8687","Type":"NodeParagraph","Properties":{"id":"20240612091933-don8687","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612091933-8guql4g","Type":"NodeParagraph","Properties":{"id":"20240612091933-8guql4g","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 杀虫消积；除湿止痢。主虫积腹痛；小儿疳积；久泻久痢；疮汤；疥癣"}]},{"ID":"20240612091933-wmhl1us","Type":"NodeParagraph","Properties":{"id":"20240612091933-wmhl1us","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612091933-aryjcug","Type":"NodeParagraph","Properties":{"id":"20240612091933-aryjcug","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-10g；或入丸、散。外用：适量，研末调敷。"}]},{"ID":"20240612091933-nd4vz4x","Type":"NodeParagraph","Properties":{"id":"20240612091933-nd4vz4x","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612091933-jh7ma2d","Type":"NodeParagraph","Properties":{"id":"20240612091933-jh7ma2d","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 1.芜荑散(《仁斋直指方论》)，治肠中诸虫。2.芜荑丸(《圣惠方》)，治久痢不瘥，有虫，兼脱肛。3.芦荟肥儿丸(《医宗金鉴·幼科心法要诀》)，治小儿疳证。"}]},{"ID":"20240612091933-tm3owhk","Type":"NodeParagraph","Properties":{"id":"20240612091933-tm3owhk","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612091933-vz7ranr","Type":"NodeParagraph","Properties":{"id":"20240612091933-vz7ranr","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主五内邪气，散皮肤骨节中淫淫温行毒，去三虫，化食。"}]},{"ID":"20240612091933-kdvwok8","Type":"NodeParagraph","Properties":{"id":"20240612091933-kdvwok8","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：逐寸白。"}]},{"ID":"20240612091933-keiukx6","Type":"NodeParagraph","Properties":{"id":"20240612091933-keiukx6","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：能主积冷气，心腹症痛，除肌肤节中风淫淫如虫行。"}]},{"ID":"20240612091933-vi5pino","Type":"NodeParagraph","Properties":{"id":"20240612091933-vi5pino","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"4.孟诜：治热疮，捣和猪脂涂，又和白蜜治湿癣，和沙牛酪疗一切疮。长食治五痔。"}]},{"ID":"20240612091933-mdu1jx8","Type":"NodeParagraph","Properties":{"id":"20240612091933-mdu1jx8","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"5.《食疗本草》：散腹中气痛。又和马酪可治癣。又杀中恶虫毒。"}]},{"ID":"20240612091933-ao7jqzw","Type":"NodeParagraph","Properties":{"id":"20240612091933-ao7jqzw","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"6.《海药本草》：治冷痢心气，杀虫止痛。又治妇人子宫风虚，孩子疳泻。"}]},{"ID":"20240612091933-sbx73a6","Type":"NodeParagraph","Properties":{"id":"20240612091933-sbx73a6","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"7.《日华子本草》：治肠风痔漏，恶疮疥癣。"}]},{"ID":"20240612091933-1lahzvc","Type":"NodeParagraph","Properties":{"id":"20240612091933-1lahzvc","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"8.《医林纂要》：泻肺祛风湿，燥脾消寒食，治疸黄，杀虫去蛔。"}]},{"ID":"20240612091933-neytxtu","Type":"NodeParagraph","Properties":{"id":"20240612091933-neytxtu","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"9.《中国药植图鉴》：祛痰利尿。"}]},{"ID":"20240612091933-718c63j","Type":"NodeParagraph","Properties":{"id":"20240612091933-718c63j","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"10.《雷公炮制药性解》：按芜荑辛宜于肺，温宜于脾，故两入之，风寒湿痹，大肠冷滑者，此为要剂。夫气食皆因寒而滞，诸虫皆因湿而生，得芜荑以温之燥之，而证犹不痊者，未之有也。"}]},{"ID":"20240612091933-osx1v8c","Type":"NodeParagraph","Properties":{"id":"20240612091933-osx1v8c","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"11.《本草经疏》：芜荑，《本经》味辛，气平，无毒；甄权加苦，李珣加温，详其功用，应是苦辛温平之药。非辛温则不能散五脏、皮肤、骨节中邪毒气，非苦平则不能去三虫、化食、逐寸白，疗肠中WENWEN喘息。然察其所主，虽能除风淫邪气之为害，而其功则长于走肠胃，杀诸虫，消食积也。故小儿疳泻冷痢为必资之药。"}]},{"ID":"20240612091933-9qtkr75","Type":"NodeParagraph","Properties":{"id":"20240612091933-9qtkr75","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"12.《本草汇言》：芜荑，杀三虫，散五疳，治小儿百病之药也，前古诸书，主诸积冷气，肠胃虫癖，食症血痞，及皮肤骨节中风毒诸疾，缘其气臭，辛XIN难闻，性专走逐，故诸滞成疾，食积虫血，皆可荡化。凡诸疾赢瘦，结气发热，疳劳疳胀，疳痢疳积，嗜食与不能食，咸宜服之。中病即止，如久服多服，不免有伤胃气，司业者当自量之。"}]},{"ID":"20240612091933-agi1l5g","Type":"NodeParagraph","Properties":{"id":"20240612091933-agi1l5g","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"13.《本经逢原》：芜荑辛散，能祛五内皮肤骨节湿热之病。近世但知其有去疳杀虫及治肠风痔痿、恶疮疥癣之用，殊失《本经》之旨。《千金》治妇人经带崩淋之病，每同泽兰、厚朴、藁本、白芷、细辛、防风、柏仁、石斛辈用之，取其去子脏中风热垢腻也。"}]},{"ID":"20240612091933-wbatzw9","Type":"NodeParagraph","Properties":{"id":"20240612091933-wbatzw9","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612091933-7caspye","Type":"NodeParagraph","Properties":{"id":"20240612091933-7caspye","updated":"20240612091933"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612091934-zislxhi","Type":"NodeThematicBreak","Properties":{"id":"20240612091934-zislxhi"}},{"ID":"20240612091935-c0jos8b","Type":"NodeParagraph","Properties":{"id":"20240612091935-c0jos8b"}}]}