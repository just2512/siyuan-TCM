{"ID":"20240506082124-3xi99wc","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506082124-3xi99wc","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506082124-3xi99wc\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240627102944-qfohtw2\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612134104-wpvxgze\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240627103821-d8a72f4\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"240樗鸡（龙眼鸡、绿孔雀）","type":"doc","updated":"20240821165202"},"Children":[{"ID":"20240627102944-qfohtw2","Type":"NodeParagraph","Properties":{"id":"20240627102944-qfohtw2","updated":"20240821165122"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 535px;","style":"width: 525px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"樗鸡"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/樗鸡-20240627102944-w98r203.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 525px;\" parent-style=\"width: 535px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"樗鸡2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/樗鸡2-20240627103105-n6f08fm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627103700-ewcmvxm","Type":"NodeParagraph","Properties":{"id":"20240627103700-ewcmvxm"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 535px;","style":"width: 525px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"樗鸡4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/樗鸡4-20240627103248-wprnbpn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 525px;\" parent-style=\"width: 535px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 574px;","style":"width: 564px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"樗鸡3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/樗鸡3-20240627103212-6rzyy59.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 564px;\" parent-style=\"width: 574px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627103821-d8a72f4","Type":"NodeParagraph","Properties":{"id":"20240627103821-d8a72f4","updated":"20240821165202"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 509px;","style":"width: 499px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"樗鸡5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/樗鸡5-20240627103651-r4xsq8d.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 499px;\" parent-style=\"width: 509px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 615px;","style":"width: 605px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"樗鸡7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/樗鸡7-20240627103821-4o1ppd7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 605px;\" parent-style=\"width: 615px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612134101-kqiz44r","Type":"NodeThematicBreak","Properties":{"id":"20240612134101-kqiz44r"}},{"ID":"20240612134257-us1la9l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134257-us1la9l","updated":"20240612134301"},"Children":[{"Type":"NodeText","Data":"樗鸡《神农本草经》"}]},{"ID":"20240612134257-sp6mzem","Type":"NodeParagraph","Properties":{"id":"20240612134257-sp6mzem","updated":"20240612134257"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240612134257-bbyfxuq","Type":"NodeParagraph","Properties":{"id":"20240612134257-bbyfxuq","updated":"20240612134257"},"Children":[{"Type":"NodeText","Data":"主心腹邪气，阴痿，益精，强志，生子好色，补中轻身。生川谷。"}]},{"ID":"20240612134257-jlp0dxl","Type":"NodeParagraph","Properties":{"id":"20240612134257-jlp0dxl","updated":"20240612134257"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生河内樗树上，七月采，暴干。"}]},{"ID":"20240612134257-dzub3gz","Type":"NodeParagraph","Properties":{"id":"20240612134257-dzub3gz","updated":"20240612134257"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：樗鸠，樗鸡也。《尔雅》云：螒、天鸡。李巡云：一名酸鸡。郭璞云：小虫，黑身赤头，一名莎鸡，又曰樗鸡。《毛诗》云：六月莎鸡振羽。陆玑云：莎鸡，如蝗而班色，毛翅数重，某翅正赤，或谓之天鸡，六月中，飞而振羽，索索作声，幽州人谓之蒲错，是也。"}]},{"ID":"20240612134101-3kglbol","Type":"NodeThematicBreak","Properties":{"id":"20240612134101-3kglbol"}},{"ID":"20240612134306-czhezes","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134306-czhezes","updated":"20240612134311"},"Children":[{"Type":"NodeText","Data":"樗鸡《神农本草经赞》"}]},{"ID":"20240612134306-3gh85a0","Type":"NodeParagraph","Properties":{"id":"20240612134306-3gh85a0","updated":"20240612134306"},"Children":[{"Type":"NodeText","Data":"味苦平。主心腹邪气。阴痿。益精强志。生子。好色。补中。轻身。生川谷。行列秋梢。寒同候时协鸡鸣。气含樗臭。六足鳞差。双飞斑糅。莎羽樊中。声烦色陋。"}]},{"ID":"20240612134306-8qm8k3s","Type":"NodeParagraph","Properties":{"id":"20240612134306-8qm8k3s","updated":"20240612134306"},"Children":[{"Type":"NodeText","Data":"名医曰。生河内樗树上。七月采。陶弘景曰。形似寒而小。李时珍曰。其鸣以时。故以鸡名。此物六足重翼。翼灰黄有斑点。居樗树上。布列成行。苏颂曰。一名莎鸡。飞而振羽。"}]},{"ID":"20240612134306-b42u04v","Type":"NodeParagraph","Properties":{"id":"20240612134306-b42u04v","updated":"20240612134306"},"Children":[{"Type":"NodeText","Data":"索索有声。人或蓄之樊中。李时珍曰。莎鸡居草间。如蟋蟀之类。苏颂所引殊误。"}]},{"ID":"20240612134306-i3hpt7d","Type":"NodeThematicBreak","Properties":{"id":"20240612134306-i3hpt7d"}},{"ID":"20240612134406-8lz5jxz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134406-8lz5jxz","updated":"20240612134412"},"Children":[{"Type":"NodeText","Data":"樗鸡《本草衍义》"}]},{"ID":"20240612134406-348ot89","Type":"NodeParagraph","Properties":{"id":"20240612134406-348ot89","updated":"20240612134406"},"Children":[{"Type":"NodeText","Data":"东、西京界尤多，形类蚕蛾，但头足微黑。翅两重，外一重灰色，下一重深红，五色皆具，腹大，此即樗鸡也。今人又用之行瘀血月闭。"}]},{"ID":"20240612134406-e6lczl5","Type":"NodeThematicBreak","Properties":{"id":"20240612134406-e6lczl5"}},{"ID":"20240612134356-7qdg72i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134356-7qdg72i","updated":"20240612134401"},"Children":[{"Type":"NodeText","Data":"樗鸡《本经逢原》"}]},{"ID":"20240612134356-xmpldrf","Type":"NodeParagraph","Properties":{"id":"20240612134356-xmpldrf","updated":"20240612134356"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"即红娘子"}]},{"ID":"20240612134356-vw2ziza","Type":"NodeParagraph","Properties":{"id":"20240612134356-vw2ziza","updated":"20240612134356"},"Children":[{"Type":"NodeText","Data":"苦平有毒。不可近目。去翅足同糯米炒，去米用。"}]},{"ID":"20240612134356-57snixe","Type":"NodeParagraph","Properties":{"id":"20240612134356-57snixe","updated":"20240612134356"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"樗鸡，厥阴经药也。能活血散血，治目翳。拨云膏中与芫青、斑蝥同用，亦是活血散结之义。能通血闭，行瘀血，主瘰 ，辟邪气，疗 犬伤。治偏头风用红娘子、青娘子各七枚，去翅足炒为末，同葱茎捣涂痛处，周时起泡去之。孙一奎治血蛊用抵当丸以樗鸡易水蛭三服，血下胀消，形神自复。与薛新甫治水肿，椒仁丸中芫青不殊。一走血而下瘀，一走气而破水，皆峻剂也。《纲目》以《本经》原蚕蛾主治误列于此，今正之。"}]},{"ID":"20240612134356-cfizu4d","Type":"NodeThematicBreak","Properties":{"id":"20240612134356-cfizu4d"}},{"ID":"20240612134346-nms6rxt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134346-nms6rxt","updated":"20240612134351"},"Children":[{"Type":"NodeText","Data":"樗鸡《新修本草》"}]},{"ID":"20240612134346-g5qzv8x","Type":"NodeParagraph","Properties":{"id":"20240612134346-g5qzv8x","updated":"20240612134346"},"Children":[{"Type":"NodeText","Data":"味苦，平，有小毒。主心腹邪气阴痿，益精强志，生子，好色，补中轻身，又疗腰痛，下气，强阴多精，不可近目。"}]},{"ID":"20240612134346-b00wm2x","Type":"NodeParagraph","Properties":{"id":"20240612134346-b00wm2x","updated":"20240612134346"},"Children":[{"Type":"NodeText","Data":"生河内川谷樗树上。七月采，曝干。"}]},{"ID":"20240612134346-b0wxsen","Type":"NodeParagraph","Properties":{"id":"20240612134346-b0wxsen","updated":"20240612134346"},"Children":[{"Type":"NodeText","Data":"形似寒 而小，今出梁州，方用至希，惟合大麝香丸用之。樗树似漆而臭，今以此树上为好，亦如芫青、亭长，必以芫、葛上为良矣。"}]},{"ID":"20240612134346-p69y1z7","Type":"NodeParagraph","Properties":{"id":"20240612134346-p69y1z7","updated":"20240612134346"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物有二种，以五色具者为雄，良；青黑质白斑者是雌，不入药用。今出歧州，河内无此物也。"}]},{"ID":"20240612134346-3hj75lp","Type":"NodeThematicBreak","Properties":{"id":"20240612134346-3hj75lp"}},{"ID":"20240612134335-lhuslfo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134335-lhuslfo","updated":"20240612134340"},"Children":[{"Type":"NodeText","Data":"樗鸡《千金翼方》"}]},{"ID":"20240612134335-tssvald","Type":"NodeParagraph","Properties":{"id":"20240612134335-tssvald","updated":"20240612134335"},"Children":[{"Type":"NodeText","Data":"味苦，平，有小毒。主心腹邪气，阴痿，益精强志，生子，好色，补中，轻身。又疗腰痛，下气，强阴多精，不可近目。生河内川谷樗树上，七月采，曝干。"}]},{"ID":"20240612134335-2ze5ux1","Type":"NodeThematicBreak","Properties":{"id":"20240612134335-2ze5ux1"}},{"ID":"20240612134319-y0heibs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134319-y0heibs","updated":"20240612134324"},"Children":[{"Type":"NodeText","Data":"樗鸡《名医别录》"}]},{"ID":"20240612134319-xp05hfq","Type":"NodeParagraph","Properties":{"id":"20240612134319-xp05hfq","updated":"20240612134319"},"Children":[{"Type":"NodeText","Data":"有小毒．主治腰痛，下气，强阴多精，不可近目．生河内樗树上．七月采，曝干．"}]},{"ID":"20240612134319-okv7b3d","Type":"NodeParagraph","Properties":{"id":"20240612134319-okv7b3d","updated":"20240612134319"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶樗鸡，味苦，平．主心腹邪气，阴痿，益精强志，生子，好色，补中轻身．生川谷．"}]},{"ID":"20240612134319-vmib0c0","Type":"NodeThematicBreak","Properties":{"id":"20240612134319-vmib0c0"}},{"ID":"20240612134226-69toujz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134226-69toujz","updated":"20240612134236"},"Children":[{"Type":"NodeText","Data":"樗鸡《证类本草》"}]},{"ID":"20240612134226-0mt9rtn","Type":"NodeParagraph","Properties":{"id":"20240612134226-0mt9rtn","updated":"20240612134226"},"Children":[{"Type":"NodeText","Data":"味苦平，有小毒。主心腹邪气，阴痿，益精强志，生子好色，补中轻身。又疗腰痛，下气，强阴多精，不可近目。生河内川谷樗树上。七月采，曝干。"}]},{"ID":"20240612134226-73qxnr3","Type":"NodeParagraph","Properties":{"id":"20240612134226-73qxnr3","updated":"20240612134226"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶形似寒 而小，今出梁州，方∶用至稀，唯合大麝香丸用之。樗树似漆而臭，今以此树上为好，亦如芫菁、亭长，必以芫、葛上为良矣。唐本注云∶此物有二种，以五色具者为雄，良；青黑质白斑者是雌，不入药用。今出歧州，河内无此物也。"}]},{"ID":"20240612134226-hyv6wy9","Type":"NodeParagraph","Properties":{"id":"20240612134226-hyv6wy9","updated":"20240612134226"},"Children":[{"Type":"NodeText","Data":"图经曰∶樗鸡，生河内川谷樗木上，今近都皆有之。形似寒 而小，七月采，曝干。谨按《尔雅》云∶ （音翰），天鸡。郭璞注云∶小虫，黑身赤头。一名莎鸡，又曰樗鸠。李巡曰∶一名酸鸡。《广雅》谓之樗鸡。苏恭云∶五色具者为雄，良；青黑质白斑者是雌，不入药。然今所谓莎鸡者，亦生樗木上，六月后出飞，而振羽索索作声，人或畜之樊中。但头方∶腹大，翅羽外青内红，而身不黑，头不赤，此殊不类，盖别一种而同名也。今在樗木上者，人呼为红娘子，头、翅皆赤，乃如旧说，然不名樗鸡，疑即是此，盖古今称不同耳。古今大麝香丸用之，近人少用，故亦鲜别。"}]},{"ID":"20240612134226-8et950l","Type":"NodeParagraph","Properties":{"id":"20240612134226-8et950l","updated":"20240612134226"},"Children":[{"Type":"NodeText","Data":"衍义曰∶樗鸡，东、西京界尤多。形类蚕蛾，但头、足微黑，翅两重，外一重灰色，下一重深红，五色皆具。腹大，此即樗鸡也。今人又用之，行瘀血、血闭。"}]},{"ID":"20240612134101-bfkl417","Type":"NodeThematicBreak","Properties":{"id":"20240612134101-bfkl417"}},{"ID":"20240612134215-zeeslir","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134215-zeeslir","updated":"20240612134219"},"Children":[{"Type":"NodeText","Data":"樗鸡《医学入门》"}]},{"ID":"20240612134215-w8ouhps","Type":"NodeParagraph","Properties":{"id":"20240612134215-w8ouhps","updated":"20240612134215"},"Children":[{"Type":"NodeText","Data":"生樗木上。形类蚕蛾，但头足微黑。翅有一重灰色，一重深红，五色俱，腹大者佳。又名红娘子。"}]},{"ID":"20240612134215-bu6m9gq","Type":"NodeParagraph","Properties":{"id":"20240612134215-bu6m9gq","updated":"20240612134215"},"Children":[{"Type":"NodeText","Data":"味苦，平，小毒。主阴痿益精，补中下气，强志轻身，生子好色；又治心腹邪气，腰痛，行瘀血血闭。不可近目。"}]},{"ID":"20240612134215-7bsdl2b","Type":"NodeParagraph","Properties":{"id":"20240612134215-7bsdl2b","updated":"20240612134215"},"Children":[{"Type":"NodeText","Data":"七月采，晒干，微炒。"}]},{"ID":"20240612134101-evqm2wr","Type":"NodeThematicBreak","Properties":{"id":"20240612134101-evqm2wr"}},{"ID":"20240612134204-j59cr3k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134204-j59cr3k","updated":"20240612134210"},"Children":[{"Type":"NodeText","Data":"樗鸡《本草崇原》"}]},{"ID":"20240612134204-tty9776","Type":"NodeParagraph","Properties":{"id":"20240612134204-tty9776","updated":"20240612134204"},"Children":[{"Type":"NodeText","Data":"气味苦平，有小毒。主治心腹邪气，阴痿，益精强志，生子好色，补中轻身。（樗音话。）"}]},{"ID":"20240612134204-1ehsxra","Type":"NodeParagraph","Properties":{"id":"20240612134204-1ehsxra","updated":"20240612134204"},"Children":[{"Type":"NodeText","Data":"（樗鸡出梁州、岐州、汴洛诸界尤多。生樗树上，形类蚕蛾而腹大，六足、重翼，外一重灰黄有斑点，内一重深红，五色相间。有一种头翅皆赤者，名红娘子。今樗鸡未之用也，而红娘子间有用者。）"}]},{"ID":"20240612134204-54dvp0y","Type":"NodeParagraph","Properties":{"id":"20240612134204-54dvp0y","updated":"20240612134204"},"Children":[{"Type":"NodeText","Data":"樗鸡生于木上，味苦色赤，禀木火之气化。主治心腹邪气者，禀火气以治心，禀木气以治腹也。益精强志者，水火相济也。生子好色者，木生火也。补中轻身者，火生土也。"}]},{"ID":"20240612134102-uerzacd","Type":"NodeThematicBreak","Properties":{"id":"20240612134102-uerzacd"}},{"ID":"20240612134110-yrx4ex4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612134110-yrx4ex4","updated":"20240612134114"},"Children":[{"Type":"NodeText","Data":"樗鸡《本草纲目》"}]},{"ID":"20240612134110-bjqq93t","Type":"NodeParagraph","Properties":{"id":"20240612134110-bjqq93t","updated":"20240612134110"},"Children":[{"Type":"NodeText","Data":"「释名」红娘子、灰花蛾。"}]},{"ID":"20240612134110-ysoxull","Type":"NodeParagraph","Properties":{"id":"20240612134110-ysoxull","updated":"20240612134110"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、有小毒。（不可近目）"}]},{"ID":"20240612134110-6w8mvcj","Type":"NodeParagraph","Properties":{"id":"20240612134110-6w8mvcj","updated":"20240612134110"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612134110-tloji34","Type":"NodeParagraph","Properties":{"id":"20240612134110-tloji34","updated":"20240612134110"},"Children":[{"Type":"NodeText","Data":"1、子宫虚寒，月经不调。用樗鸡六十枚，大黄、皂荚、葶苈各一两，巴豆一百二十枚，共研为末，加枣肉做成丸子，如弹子大。棉裹塞阴道内，三日取出。每日以鸡蛋三枚、胡椒末二分，同炒吃，酒送下。久则子宫变暖。"}]},{"ID":"20240612134110-ncrm0sy","Type":"NodeParagraph","Properties":{"id":"20240612134110-ncrm0sy","updated":"20240612134110"},"Children":[{"Type":"NodeText","Data":"2、瘰疬结核。用樗鸡十四枚，乳香、砒霜各一钱，硇砂残半，黄丹五分，共研为末，加糯米粥和药作饼，贴患处。一月病愈。"}]},{"ID":"20240612134110-bbplm9u","Type":"NodeParagraph","Properties":{"id":"20240612134110-bbplm9u","updated":"20240612134110"},"Children":[{"Type":"NodeText","Data":"3、横痃便毒。用鸡蛋一个，开孔，放入樗鸡六个，纸饮煨熟。去樗鸡，只吃鸡蛋，酒送下。"}]},{"ID":"20240612134102-bfursc0","Type":"NodeThematicBreak","Properties":{"id":"20240612134102-bfursc0"}},{"ID":"20240612134103-d6e13xb","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612134103-d6e13xb","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"樗鸡"}]},{"ID":"20240612134103-ajoj51e","Type":"NodeParagraph","Properties":{"id":"20240612134103-ajoj51e","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612134103-y9nji9b","Type":"NodeParagraph","Properties":{"id":"20240612134103-y9nji9b","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" Chū Jī"}]},{"ID":"20240612134103-mppg6cb","Type":"NodeParagraph","Properties":{"id":"20240612134103-mppg6cb","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612134103-w41qwdd","Type":"NodeParagraph","Properties":{"id":"20240612134103-w41qwdd","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 红娘子、灰花蛾"}]},{"ID":"20240612134103-quuxg63","Type":"NodeParagraph","Properties":{"id":"20240612134103-quuxg63","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612134103-603o1pn","Type":"NodeParagraph","Properties":{"id":"20240612134103-603o1pn","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蜡蝉科动物樗鸡的成虫。"}]},{"ID":"20240612134103-iwkj916","Type":"NodeParagraph","Properties":{"id":"20240612134103-iwkj916","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Lycorma delicatula White"}]},{"ID":"20240612134103-cg6zipx","Type":"NodeParagraph","Properties":{"id":"20240612134103-cg6zipx","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7-8月捕捉，捕后蒸死或烤死，晒干。"}]},{"ID":"20240612134103-elad2hd","Type":"NodeParagraph","Properties":{"id":"20240612134103-elad2hd","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612134103-c8y8qgk","Type":"NodeParagraph","Properties":{"id":"20240612134103-c8y8qgk","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 生态环境：多九栖于樗、榆、刺槐、女贞及多种果树上。"}]},{"ID":"20240612134103-7a0hdd4","Type":"NodeParagraph","Properties":{"id":"20240612134103-7a0hdd4","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"资源分布：盛发于我国北方。"}]},{"ID":"20240612134103-j88e2b5","Type":"NodeParagraph","Properties":{"id":"20240612134103-j88e2b5","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612134103-ocuvph7","Type":"NodeParagraph","Properties":{"id":"20240612134103-ocuvph7","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 樗鸡，体长14-22mm，宽6-8mm。头狭小，复眼黑褐色。额延长如象鼻。前胸背板浅褐色；腹部大，黑褐色，腹部背面黑色，间被白色粉霜。前翅基半部淡褐色而稍带绿色，有黑斑20余个，端半部黑色，翅脉白色；后翅基部呈红色，有黑斑7-8个，翅端黑色。红色与黑色交界处有白带，体翅常有粉状白蜡。尾端逐渐狭小。"}]},{"ID":"20240612134103-ztf0pg5","Type":"NodeParagraph","Properties":{"id":"20240612134103-ztf0pg5","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612134103-2q68jvm","Type":"NodeParagraph","Properties":{"id":"20240612134103-2q68jvm","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 给小鼠一次性灌胃鲜樗鸡匀浆20g/kg、干樗鸡煎剂25g/kg，观察7天，小鼠无死亡发生。给小鼠按4.2g/kg给药连续4星期，小鼠体重增长，红细胞数、白细胞数、血色素及血清AST和ALT与对照组比较无差异用40%鲜樗鸡匀浆和40%樗鸡乙醇浸液泡过的滤纸片贴于人体上壁皮肤，4-8h取下，结果40%鲜樗鸡匀浆组无红肿反应，40%樗鸡乙醇浸液组有一人局部微红，12h内消失。用樗鸡乙醇浸液3g/10ml，涂小鼠耳，4h后观察，樗鸡可引起小鼠耳水肿，但无发泡现象。0.14g/ml的樗鸡头足翅混悬液、0.12g/ml去头足翅混悬液小鼠灌胃的最大耐受量分别为7.59g/kg，6.44g/kg。"}]},{"ID":"20240612134103-8y6egoi","Type":"NodeParagraph","Properties":{"id":"20240612134103-8y6egoi","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612134103-6j3vio2","Type":"NodeParagraph","Properties":{"id":"20240612134103-6j3vio2","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 肝经"}]},{"ID":"20240612134103-8zlyyef","Type":"NodeParagraph","Properties":{"id":"20240612134103-8zlyyef","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612134103-cpocfy9","Type":"NodeParagraph","Properties":{"id":"20240612134103-cpocfy9","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；性平；有毒"}]},{"ID":"20240612134103-12wi20m","Type":"NodeParagraph","Properties":{"id":"20240612134103-12wi20m","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612134103-s4b2jcy","Type":"NodeParagraph","Properties":{"id":"20240612134103-s4b2jcy","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 活血通经；玫毒散结。主血瘀经闭；腰伤疼痛；阳痿；不孕瘰疬；癣疮；狂犬咬伤"}]},{"ID":"20240612134103-y9rf4hl","Type":"NodeParagraph","Properties":{"id":"20240612134103-y9rf4hl","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612134103-whopuj7","Type":"NodeParagraph","Properties":{"id":"20240612134103-whopuj7","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 内服：研末，入丸、散，0.1-0.2g。外用：适量，研末敷贴或调涂。"}]},{"ID":"20240612134103-pkhyncf","Type":"NodeParagraph","Properties":{"id":"20240612134103-pkhyncf","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612134103-9bhunjz","Type":"NodeParagraph","Properties":{"id":"20240612134103-9bhunjz","updated":"20240612134103"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612134103-uf25hqy","Type":"NodeThematicBreak","Properties":{"id":"20240612134103-uf25hqy"}},{"ID":"20240612134104-wpvxgze","Type":"NodeParagraph","Properties":{"id":"20240612134104-wpvxgze"}}]}