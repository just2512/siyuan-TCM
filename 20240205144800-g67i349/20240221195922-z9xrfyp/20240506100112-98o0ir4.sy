e=\"width: 356px;\" parent-style=\"width: 366px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821184933-7v7zf4j","Type":"NodeParagraph","Properties":{"id":"20240821184933-7v7zf4j","updated":"20240821184946"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 851px;","style":"width: 841px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黑大豆4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黑大豆4-20240627132223-5s9aafm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 841px;\" parent-style=\"width: 851px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821184720-t2bp80d","Type":"NodeParagraph","Properties":{"id":"20240821184720-t2bp80d","updated":"20240821184720"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 340px;","style":"width: 330px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704132724-7y7gme8.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 330px;\" parent-style=\"width: 340px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 504px;","style":"width: 494px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704132634-ic3ukpe.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 494px;\" parent-style=\"width: 504px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821190534-pqnd7ad","Type":"NodeParagraph","Properties":{"id":"20240821190534-pqnd7ad","updated":"20240821190534"}},{"ID":"20240821184720-nj507wl","Type":"NodeParagraph","Properties":{"id":"20240821184720-nj507wl","updated":"20240821190532"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黑大豆、黑豆对比"}]},{"ID":"20240821184720-upe598k","Type":"NodeParagraph","Properties":{"id":"20240821184720-upe598k","updated":"20240821184720"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"-黑大豆"}]},{"ID":"20240821184720-xdvghw3","Type":"NodeParagraph","Properties":{"id":"20240821184720-xdvghw3","updated":"20240821184720"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 650px;","style":"width: 640px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704133650-7jeyeu4.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 640px;\" parent-style=\"width: 650px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 423px;","style":"width: 413px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黑大豆5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黑大豆5-20240704132333-eefcl7k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 413px;\" parent-style=\"width: 423px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821184720-3em57ei","Type":"NodeParagraph","Properties":{"id":"20240821184720-3em57ei","updated":"20240821184720"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"-黑豆"}]},{"ID":"20240821184720-tw0oq6l","Type":"NodeParagraph","Properties":{"id":"20240821184720-tw0oq6l","updated":"20240821184720"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704134557-j83qxa0.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 321px;","style":"width: 311px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240704134656-02spyx6.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 311px;\" parent-style=\"width: 321px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240627130307-qc8mwn8","Type":"NodeParagraph","Properties":{"id":"20240627130307-qc8mwn8","updated":"20240821190220"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：大豆黄卷为黑大豆发芽晒干而成，市售中药也有以黄豆制成，再而"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"黑大豆不等于黑豆"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，故实际不好分辨，药性差异不祥。"}]},{"ID":"20240821190323-a5hdo3e","Type":"NodeParagraph","Properties":{"id":"20240821190323-a5hdo3e","updated":"20240821190323"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注：黑大豆不等于黑豆，黑大豆跟黑豆相比，黑大豆表面不亮且颜色比较灰，形态比较圆，黑豆的表面则更光亮。"}]},{"ID":"20240821185016-najt9zr","Type":"NodeParagraph","Properties":{"id":"20240821185016-najt9zr","updated":"20240821190400"},"Children":[{"Type":"NodeText","Data":"三"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：黑大豆是中国本土的大豆（易招虫害，产量低，市面上很难买到，抖音平台有部分创作者有留种），市面上混淆品较多；"}]},{"ID":"20240821185235-5pyc3nb","Type":"NodeParagraph","Properties":{"id":"20240821185235-5pyc3nb","updated":"20240821190411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四注：黑大豆虽然产量低，但其打成的豆浆所含的能量比市面上的豆浆会高许多，喝完全身能持续暖和一段时间；"}]},{"ID":"20240612145233-9k745e7","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-9k745e7"}},{"ID":"20240612145730-m9kxl0o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145730-m9kxl0o","updated":"20240612145734"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《神农本草经》"}]},{"ID":"20240612145730-9nlauo1","Type":"NodeParagraph","Properties":{"id":"20240612145730-9nlauo1","updated":"20240612145730"},"Children":[{"Type":"NodeText","Data":"味甘平。"}]},{"ID":"20240612145730-j6y0w50","Type":"NodeParagraph","Properties":{"id":"20240612145730-j6y0w50","updated":"20240612145730"},"Children":[{"Type":"NodeText","Data":"主湿痹，筋挛，膝痛。生大豆，涂痈肿。煮汁，饮，杀鬼毒，止痛，赤小豆。主下水，排痈肿脓血。生平泽。"}]},{"ID":"20240612145730-if15wn3","Type":"NodeParagraph","Properties":{"id":"20240612145730-if15wn3","updated":"20240612145730"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：大豆黄卷，神农黄帝雷公无毒，采无时，去面（黑干），得前胡，乌啄，杏子，牡蛎，天雄，鼠屎，共蜜和佳，不欲海藻龙胆，此法，大豆初出黄土芽是也。生大豆，神农岐伯生熟寒，九月采，杀乌豆毒，并不用元参。"}]},{"ID":"20240612145818-7hc4yem","Type":"NodeThematicBreak","Properties":{"id":"20240612145818-7hc4yem"}},{"ID":"20240612145819-8hjorq0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145819-8hjorq0","updated":"20240612145831"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《本草纲目》"}]},{"ID":"20240612145819-8wjxe0z","Type":"NodeParagraph","Properties":{"id":"20240612145819-8wjxe0z","updated":"20240612145819"},"Children":[{"Type":"NodeText","Data":"（《本经》中品）"}]},{"ID":"20240612145819-nv4my6g","Type":"NodeParagraph","Properties":{"id":"20240612145819-nv4my6g","updated":"20240612145819"},"Children":[{"Type":"NodeText","Data":"〖释名〗豆蘖（〔弘景曰〕黑大豆为蘖牙，生五寸长，便干之，名为黄卷，用之熬过，服食所须。〔时珍曰〕一法：壬癸日以井华水浸大豆，候生芽，取皮，阴干用）"}]},{"ID":"20240612145819-xlxbd73","Type":"NodeParagraph","Properties":{"id":"20240612145819-xlxbd73","updated":"20240612145819"},"Children":[{"Type":"NodeText","Data":"〖气味〗甘，平，无毒。（〔普曰〕得前胡、杏子、牡蛎、乌喙、天雄、鼠屎，共蜜和良。恶海藻、龙胆）"}]},{"ID":"20240612145819-sqh0y9q","Type":"NodeParagraph","Properties":{"id":"20240612145819-sqh0y9q","updated":"20240612145819"},"Children":[{"Type":"NodeText","Data":"〖主治〗湿痹，筋挛膝痛。（《本经》）。五脏不足，胃气结积，益气止痛，去黑皯，润肌肤皮毛。（《别录》）。破妇人恶血。（孟诜。〔颂曰〕古方蓐妇药中多用之）宜肾。（思邈）除胃中积热，消水病胀满。（时珍）"}]},{"ID":"20240612145819-59bcbx8","Type":"NodeParagraph","Properties":{"id":"20240612145819-59bcbx8","updated":"20240612145819"},"Children":[{"Type":"NodeText","Data":"〖附方〗（新四）大豆蘖散（治周痹邪在血脉之中，本痹不痛，上下周身故名。此药注五脏留滞，胃中结聚，益气出毒，润皮毛，补肾气。用大豆蘖一斤炒香，为末。每服半钱，温酒调下，日三服。《宣明方》）头风湿痹（筋挛膝痛，胃中积热，大便秘涩。黄卷散：用大豆黄卷炒一升，酥半两为末，食前温水服一匙，日二服。《普济方》）水病肿满（喘急，大小便涩。大豆黄卷醋炒、大黄炒等分，为细末。葱、橘皮汤服二钱，平明以利为度。《圣济总录》）小儿撮口（初生豆芽研烂，绞汁和乳，灌少许良。《普济方》）"}]},{"ID":"20240612145749-9xsv9up","Type":"NodeThematicBreak","Properties":{"id":"20240612145749-9xsv9up"}},{"ID":"20240612145751-3hy6m0g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145751-3hy6m0g","updated":"20240612145755"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《千金翼方》"}]},{"ID":"20240612145751-ehxqqwi","Type":"NodeParagraph","Properties":{"id":"20240612145751-ehxqqwi","updated":"20240612145751"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主湿痹，筋挛，膝痛，五脏胃气结积，益气，止毒，去黑 ，润泽皮毛。"}]},{"ID":"20240612145800-t89vk9j","Type":"NodeThematicBreak","Properties":{"id":"20240612145800-t89vk9j"}},{"ID":"20240612145801-b2l5sl6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145801-b2l5sl6","updated":"20240612145805"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《神农本草经赞》"}]},{"ID":"20240612145801-xko0we6","Type":"NodeParagraph","Properties":{"id":"20240612145801-xko0we6","updated":"20240612145801"},"Children":[{"Type":"NodeText","Data":"味甘平。主湿痹。筋挛膝痛。生大豆。涂痈肿。煮汁饮。杀鬼毒止痛。赤小豆。"}]},{"ID":"20240612145801-xy3l5ni","Type":"NodeParagraph","Properties":{"id":"20240612145801-xy3l5ni","updated":"20240612145801"},"Children":[{"Type":"NodeText","Data":"主下水。排痈肿脓血。生平泽。（黄卷豆也）吉陬壬癸。罨豆孚生。玉攒磔。冰脆牙萌。粥分口数。算布心精。殊形慧辨。荚谷通名。"}]},{"ID":"20240612145801-5l19ybq","Type":"NodeParagraph","Properties":{"id":"20240612145801-5l19ybq","updated":"20240612145801"},"Children":[{"Type":"NodeText","Data":"李时珍曰。壬癸日以井华水浸大豆。候生芽用。诗疏。既方既皂。谓孚甲始生。方岳诗。"}]},{"ID":"20240612145801-yq4csu8","Type":"NodeParagraph","Properties":{"id":"20240612145801-yq4csu8","updated":"20240612145801"},"Children":[{"Type":"NodeText","Data":"平明先视玉磔。一夜怒长堪冰苴。田家五行。煮赤豆粥。大小人口皆食之。谓之口数粥。以驱疫。吴志传。赵达治九宫一算之术。取小豆数升。播席上。立处其数。吴志传。顾谭心精体密。左传。周子有兄而无慧。不能辨菽麦。注。豆麦殊形易别。群芳谱。豆荚谷之总名也。"}]},{"ID":"20240612145739-ibmgsx1","Type":"NodeThematicBreak","Properties":{"id":"20240612145739-ibmgsx1"}},{"ID":"20240612145740-5xar2qo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145740-5xar2qo","updated":"20240612145744"},"Children":[{"Type":"NodeText","Data":"豆黄卷《长沙药解》"}]},{"ID":"20240612145740-1lhl5he","Type":"NodeParagraph","Properties":{"id":"20240612145740-1lhl5he","updated":"20240612145740"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】大豆黄卷。味甘平。主湿痹，筋挛，膝痛。生大豆，涂痈肿。煮汁，饮，杀鬼毒，止痛，赤小豆。主下水，排痈肿脓血。生平泽。"}]},{"ID":"20240612145740-n751dl2","Type":"NodeParagraph","Properties":{"id":"20240612145740-n751dl2","updated":"20240612145740"},"Children":[{"Type":"NodeText","Data":"味甘，气平。利水泻湿，达木舒筋。"}]},{"ID":"20240612145740-g6ub1e4","Type":"NodeParagraph","Properties":{"id":"20240612145740-g6ub1e4","updated":"20240612145740"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"薯蓣丸"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"方在薯蓣。"},{"Type":"NodeText","Data":"用之，以其泻湿而疏木也。"}]},{"ID":"20240612145740-cxx1rh6","Type":"NodeParagraph","Properties":{"id":"20240612145740-cxx1rh6","updated":"20240612145740"},"Children":[{"Type":"NodeText","Data":"大豆黄卷专泻水湿，善达木郁，通腠理而逐湿痹，行经脉而破血癥，疗水郁腹胀之病，治筋挛膝痛之疾。黑大豆长于利水而行血，及其芽生而为黄卷，更能破瘀而舒筋，以其发舒通达，秉之天性也。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"黑豆芽生五寸，干之为黄卷。"}]},{"ID":"20240612145233-9lxcvpq","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-9lxcvpq"}},{"ID":"20240612145721-vx597v1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145721-vx597v1","updated":"20240612145725"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《名医别录》"}]},{"ID":"20240612145721-qcakcb5","Type":"NodeParagraph","Properties":{"id":"20240612145721-qcakcb5","updated":"20240612145721"},"Children":[{"Type":"NodeText","Data":"无毒．主治五脏胃气结积，益气，止毒，去黑 ，润泽皮毛．"}]},{"ID":"20240612145233-99pr5vl","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-99pr5vl"}},{"ID":"20240612145708-mz9wh6m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145708-mz9wh6m","updated":"20240612145713"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《得配本草》"}]},{"ID":"20240612145708-3nq6qdj","Type":"NodeParagraph","Properties":{"id":"20240612145708-3nq6qdj","updated":"20240612145708"},"Children":[{"Type":"NodeText","Data":"得前胡、杏仁、牡蛎、天雄、鼠屎、石蜜、诸胆汁良。恶海藻龙胆、五参。"}]},{"ID":"20240612145708-jyt7azi","Type":"NodeParagraph","Properties":{"id":"20240612145708-jyt7azi","updated":"20240612145708"},"Children":[{"Type":"NodeText","Data":"甘，平。入足少阴经气分。除胃热，疗湿痹。配大黄、橘皮、青葱，治水肿喘急。以井华水浸黑大豆，候生芽五寸，阴干用。"}]},{"ID":"20240612145708-sfhqx2b","Type":"NodeParagraph","Properties":{"id":"20240612145708-sfhqx2b","updated":"20240612145708"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黑壳"}]},{"ID":"20240612145708-o8abpex","Type":"NodeParagraph","Properties":{"id":"20240612145708-o8abpex","updated":"20240612145708"},"Children":[{"Type":"NodeText","Data":"研末，调香油，敷皮疮。"}]},{"ID":"20240612145421-4weqgn7","Type":"NodeThematicBreak","Properties":{"id":"20240612145421-4weqgn7"}},{"ID":"20240612145610-4xyake1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145610-4xyake1","updated":"20240612145616"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《吴普本草》"}]},{"ID":"20240612145610-a0do7ek","Type":"NodeParagraph","Properties":{"id":"20240612145610-a0do7ek","updated":"20240612145610"},"Children":[{"Type":"NodeText","Data":"《御览》卷八百四十一"}]},{"ID":"20240612145610-g2h3w7f","Type":"NodeParagraph","Properties":{"id":"20240612145610-g2h3w7f","updated":"20240612145610"},"Children":[{"Type":"NodeText","Data":"神农、黄帝、雷公∶无毒。采无时。去面 ，得前胡、乌喙、杏子、牡蛎、天雄、鼠屎共蜜和佳，不欲海藻、龙胆。此法大豆初出土黄芽是也。"}]},{"ID":"20240612145421-k2fidw2","Type":"NodeThematicBreak","Properties":{"id":"20240612145421-k2fidw2"}},{"ID":"20240612145529-qeoa3wm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145529-qeoa3wm","updated":"20240612145550"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《本草乘雅半偈》"}]},{"ID":"20240612145529-wdl1i66","Type":"NodeParagraph","Properties":{"id":"20240612145529-wdl1i66","updated":"20240612145529"},"Children":[{"Type":"NodeText","Data":"（本经中品）"}]},{"ID":"20240612145529-a50o4ck","Type":"NodeParagraph","Properties":{"id":"20240612145529-a50o4ck","updated":"20240612145529"},"Children":[{"Type":"NodeText","Data":"【气味】甘平，无毒。"}]},{"ID":"20240612145529-81ka3z1","Type":"NodeParagraph","Properties":{"id":"20240612145529-81ka3z1","updated":"20240612145529"},"Children":[{"Type":"NodeText","Data":"【主治】主湿痹筋挛，膝痛不可屈伸。"}]},{"ID":"20240612145529-8yvb7b0","Type":"NodeParagraph","Properties":{"id":"20240612145529-8yvb7b0","updated":"20240612145529"},"Children":[{"Type":"NodeText","Data":"【核】曰∶造黄卷法，壬癸曰，以井华水浸黑大豆，候芽长五寸，干之即为黄卷。用时熬过"}]},{"ID":"20240612145656-amxv5i1","Type":"NodeParagraph","Properties":{"id":"20240612145656-amxv5i1","updated":"20240612145704"},"Children":[{"Type":"NodeText","Data":"[ ]曰∶大豆作黄卷，比之区萌而达 者，长十数倍矣。从艮而震，震而巽矣。自癸而甲，甲而乙矣。始生之曰黄，黄而卷，曲直之木性备矣。木为肝脏，藏真通于肝，肝脏筋膜之气也。大筋聚于膝，膝属溪谷之府也。故主湿痹筋挛，膝痛不可屈伸。屈伸为曲直，象形从治法也。"}]},{"ID":"20240612145421-kelc49z","Type":"NodeThematicBreak","Properties":{"id":"20240612145421-kelc49z"}},{"ID":"20240612145422-n0rni3h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145422-n0rni3h","updated":"20240612145428"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《医学入门》"}]},{"ID":"20240612145422-su21sj4","Type":"NodeParagraph","Properties":{"id":"20240612145422-su21sj4","updated":"20240612145422"},"Children":[{"Type":"NodeText","Data":"大豆黄卷味甘平，湿痹痉挛膝痛疼，更除气聚并积结，蓐妇瘀血实时行，绿豆作者堪为茹，解热醒酒心自清。"}]},{"ID":"20240612145422-jajtacv","Type":"NodeParagraph","Properties":{"id":"20240612145422-jajtacv","updated":"20240612145422"},"Children":[{"Type":"NodeText","Data":"即豆芽也。以生豆为之，芽出便晒干，名为黄卷。无毒。主湿痹筋挛膝疼，破妇人恶血及蓐妇药中多用之。又除五脏胃气结积，去黑痣面黯，润皮毛，益气解毒。入药微炒。"}]},{"ID":"20240612145233-btzbfql","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-btzbfql"}},{"ID":"20240612145410-w9zkokk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145410-w9zkokk","updated":"20240612145414"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《新修本草》"}]},{"ID":"20240612145410-9u75cpe","Type":"NodeParagraph","Properties":{"id":"20240612145410-9u75cpe","updated":"20240612145410"},"Children":[{"Type":"NodeText","Data":"味甘，平，无毒。主湿痹，筋挛，膝痛。五脏胃气结积，益气，止毒，去黑 ，润泽皮毛。生大豆，味甘，平；涂痈肿，煮饮汁，杀鬼毒，止痛，逐水胀，除胃中热痹，伤中，淋露，下瘀血，散五脏结积、内寒，杀乌头毒。久服令人身重。熬屑，味甘。主胃中热，去肿，除恶五参、龙胆，得前胡、乌喙、杏仁、牡蛎良。"}]},{"ID":"20240612145233-uyc20ze","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-uyc20ze"}},{"ID":"20240612145358-5116tpl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145358-5116tpl","updated":"20240612145402"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《本草从新》"}]},{"ID":"20240612145358-n77b185","Type":"NodeParagraph","Properties":{"id":"20240612145358-n77b185","updated":"20240612145358"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名豆 ．理胃消水．"}]},{"ID":"20240612145358-jqffw50","Type":"NodeParagraph","Properties":{"id":"20240612145358-jqffw50","updated":"20240612145358"},"Children":[{"Type":"NodeText","Data":"甘平．除胃中积热．消水病胀满．破妇人恶血．疗湿痹筋挛膝痛．黑大豆为 牙．生五寸长．便干之．名为黄卷．用之熬过．服食所须．一法、壬癸日以井华水浸大豆．候生芽．取皮阴干．（小儿撮口、初生豆芽、研烂绞汁、和乳灌少许、良．）"}]},{"ID":"20240612145233-tgzf31n","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-tgzf31n"}},{"ID":"20240612145343-4gpe2of","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145343-4gpe2of","updated":"20240612145348"},"Children":[{"Type":"NodeText","Data":"大豆黄卷《本草崇原》"}]},{"ID":"20240612145343-47xmotl","Type":"NodeParagraph","Properties":{"id":"20240612145343-47xmotl","updated":"20240612145343"},"Children":[{"Type":"NodeText","Data":"气味甘平，无毒。主治湿痹、筋挛、膝痛，不可屈伸。"}]},{"ID":"20240612145343-4lgehyr","Type":"NodeParagraph","Properties":{"id":"20240612145343-4lgehyr","updated":"20240612145343"},"Children":[{"Type":"NodeText","Data":"（黑大豆水浸出芽，约五寸长，使干之，名为黄卷。李时珍曰∶一法壬癸日以井华水浸大豆《金匮》薯蓣丸治虚劳不足，风气百疾，内用大豆黄卷，义可知矣。"}]},{"ID":"20240612145624-tyjcv8l","Type":"NodeThematicBreak","Properties":{"id":"20240612145624-tyjcv8l"}},{"ID":"20240612145625-yg1othz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145625-yg1othz","updated":"20240612145630"},"Children":[{"Type":"NodeText","Data":"豆卷《中药学》"}]},{"ID":"20240612145625-1r8fam9","Type":"NodeParagraph","Properties":{"id":"20240612145625-1r8fam9","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【药用】本品为豆科植物大豆黑色的种子（即黑大豆）发芽者。"}]},{"ID":"20240612145625-o2lhipc","Type":"NodeParagraph","Properties":{"id":"20240612145625-o2lhipc","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【性味与归经】甘，平。入脾、胃经。"}]},{"ID":"20240612145625-rj2850y","Type":"NodeParagraph","Properties":{"id":"20240612145625-rj2850y","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【功效】透邪解表，清利湿热。"}]},{"ID":"20240612145625-98hubf0","Type":"NodeParagraph","Properties":{"id":"20240612145625-98hubf0","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于湿温、暑湿初起，发热、恶寒、身重、胸闷、苔腻等症。"}]},{"ID":"20240612145625-5u5cc62","Type":"NodeParagraph","Properties":{"id":"20240612145625-5u5cc62","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"豆卷为发表之轻剂，外可透发表邪、内可化除水湿，用于湿热兼有表症者，常与藿香、佩兰等配合应用。"}]},{"ID":"20240612145625-sx8rqwi","Type":"NodeParagraph","Properties":{"id":"20240612145625-sx8rqwi","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"2.用于湿热内蕴、发热烦燥、胸闷不舒、身重体痛等症"}]},{"ID":"20240612145625-04z0wl0","Type":"NodeParagraph","Properties":{"id":"20240612145625-04z0wl0","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"豆卷善于通达宣利，用于湿温、暑湿等湿热病症，每与茯苓、滑石、黄芩等配合应用。"}]},{"ID":"20240612145625-pcyhjt8","Type":"NodeParagraph","Properties":{"id":"20240612145625-pcyhjt8","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【处方用名】清水豆卷、大豆黄卷、大豆卷（为清水浸泡发芽者〈外地也有用麻黄水拌浸者，则药性偏温〉。）"}]},{"ID":"20240612145625-al12429","Type":"NodeParagraph","Properties":{"id":"20240612145625-al12429","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服。"}]},{"ID":"20240612145625-8wwv0g4","Type":"NodeParagraph","Properties":{"id":"20240612145625-8wwv0g4","updated":"20240612145625"},"Children":[{"Type":"NodeText","Data":"【方剂举例】治水病肿满方《圣剂总录》：大豆黄卷、大黄。治水病肿满。"}]},{"ID":"20240612145233-kyy14r3","Type":"NodeThematicBreak","Properties":{"id":"20240612145233-kyy14r3"}},{"ID":"20240612145234-fy9rc5j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145234-fy9rc5j","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：大豆黄卷"}]},{"ID":"20240612145234-5mcqdsd","Type":"NodeParagraph","Properties":{"id":"20240612145234-5mcqdsd","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145234-us0gq60","Type":"NodeParagraph","Properties":{"id":"20240612145234-us0gq60","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" Dà Dòu Huánɡ Juǎn"}]},{"ID":"20240612145234-rxhzury","Type":"NodeParagraph","Properties":{"id":"20240612145234-rxhzury","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145234-d3xk0kk","Type":"NodeParagraph","Properties":{"id":"20240612145234-d3xk0kk","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 大豆卷"}]},{"ID":"20240612145234-vqoekkk","Type":"NodeParagraph","Properties":{"id":"20240612145234-vqoekkk","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145234-fnlc7h4","Type":"NodeParagraph","Properties":{"id":"20240612145234-fnlc7h4","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 豆科大豆属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大豆"},{"Type":"NodeText","Data":"Glycine max （L.） Merr.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子发芽后晒干"},{"Type":"NodeText","Data":"而得。"}]},{"ID":"20240612145234-77ndfc4","Type":"NodeParagraph","Properties":{"id":"20240612145234-77ndfc4","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612145234-dwxe5ba","Type":"NodeParagraph","Properties":{"id":"20240612145234-dwxe5ba","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 通常在10月间种子成熟后采收。选择肥壮饱满的种子，于冷水中泡涨后，用湿布盖好，或放入麻袋、蒲包中，置于温暖处，经常翻动和洒少量的水，促其发芽。待芽长约1厘米时，用清水洗净晒干。"}]},{"ID":"20240612145234-1oqfvl5","Type":"NodeParagraph","Properties":{"id":"20240612145234-1oqfvl5","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145234-96xsbiw","Type":"NodeParagraph","Properties":{"id":"20240612145234-96xsbiw","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 甘，平。"}]},{"ID":"20240612145234-9d2wku5","Type":"NodeParagraph","Properties":{"id":"20240612145234-9d2wku5","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612145234-cnnw8op","Type":"NodeParagraph","Properties":{"id":"20240612145234-cnnw8op","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 无湿热者忌用。"}]},{"ID":"20240612145234-fg8678j","Type":"NodeParagraph","Properties":{"id":"20240612145234-fg8678j","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145234-sv1mn73","Type":"NodeParagraph","Properties":{"id":"20240612145234-sv1mn73","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 清热，除湿，解表。用于暑湿发热，麻疹不透，胸闷不舒，骨节疼痛，水肿胀满。"}]},{"ID":"20240612145234-tbem002","Type":"NodeParagraph","Properties":{"id":"20240612145234-tbem002","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145234-isj0i91","Type":"NodeParagraph","Properties":{"id":"20240612145234-isj0i91","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 5钱～1两。"}]},{"ID":"20240612145234-1vbc1oh","Type":"NodeParagraph","Properties":{"id":"20240612145234-1vbc1oh","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612145234-3qmcsqc","Type":"NodeParagraph","Properties":{"id":"20240612145234-3qmcsqc","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" （1）用于湿温、暑湿初起，发热、恶寒、身重、胸闷、苔腻等症。豆卷为发表之轻剂，外可透发表邪、内可化除水湿，用于湿热兼有表症者，常与藿香、佩兰等配合应用。"}]},{"ID":"20240612145234-0y5j049","Type":"NodeParagraph","Properties":{"id":"20240612145234-0y5j049","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"（2）用于湿热内蕴、发热烦燥、胸闷不舒、身重体痛等症。豆卷善于通达宣利，用于湿温、暑湿等湿热病症，每与茯苓、滑石、黄芩等配合应用。"}]},{"ID":"20240612145234-bybcy12","Type":"NodeParagraph","Properties":{"id":"20240612145234-bybcy12","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145234-51y3xkm","Type":"NodeParagraph","Properties":{"id":"20240612145234-51y3xkm","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612145234-0c7bkif","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145234-0c7bkif","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：大豆黄卷"}]},{"ID":"20240612145234-x7mmqb8","Type":"NodeParagraph","Properties":{"id":"20240612145234-x7mmqb8","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145234-nolrp5a","Type":"NodeParagraph","Properties":{"id":"20240612145234-nolrp5a","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" Dà Dòu Huánɡ Juǎn"}]},{"ID":"20240612145234-0bv722k","Type":"NodeParagraph","Properties":{"id":"20240612145234-0bv722k","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145234-qq47ovc","Type":"NodeParagraph","Properties":{"id":"20240612145234-qq47ovc","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 大豆卷（《本草经集注》）；大豆蘖，黄卷（崔禹锡《食经》），卷蘖（《食疗本草》），黄卷皮（《本草图经》），豆蘖（《纲目》），豆黄卷（《长沙药解》），菽蘖（《本经疏证》）。"}]},{"ID":"20240612145234-p6e2fmj","Type":"NodeParagraph","Properties":{"id":"20240612145234-p6e2fmj","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612145234-i7a089z","Type":"NodeParagraph","Properties":{"id":"20240612145234-i7a089z","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612145234-vlapmd6","Type":"NodeParagraph","Properties":{"id":"20240612145234-vlapmd6","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145234-is7yeyw","Type":"NodeParagraph","Properties":{"id":"20240612145234-is7yeyw","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大豆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种子（黑大豆）发芽后晒干"},{"Type":"NodeText","Data":"而成。"}]},{"ID":"20240612145234-ta5rff7","Type":"NodeParagraph","Properties":{"id":"20240612145234-ta5rff7","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612145234-re7m7j5","Type":"NodeParagraph","Properties":{"id":"20240612145234-re7m7j5","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 干燥种子呈椭圆形，稍扁，长0.7～1.2厘米，直径5～7毫米，种皮黑褐色或紫褐色，有横向皱纹或纵裂，多数破裂，露出黄白色的子叶。子叶两片，肥厚；胚根细长，伸出于种皮之外，长5～10毫米，极弯，淡褐色，硬脆易断。气无，味淡，有油腻感。以粒大饱满、色黑褐、有皱纹及短芽者为佳。"}]},{"ID":"20240612145234-4bxu9m8","Type":"NodeParagraph","Properties":{"id":"20240612145234-4bxu9m8","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145234-cpcg67l","Type":"NodeParagraph","Properties":{"id":"20240612145234-cpcg67l","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 入脾、胃经。"}]},{"ID":"20240612145234-5wmtwbg","Type":"NodeParagraph","Properties":{"id":"20240612145234-5wmtwbg","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入足少阴经气分。\""}]},{"ID":"20240612145234-yson44l","Type":"NodeParagraph","Properties":{"id":"20240612145234-yson44l","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"②《要药分剂》：\"入胃经。\""}]},{"ID":"20240612145234-s1tsr4j","Type":"NodeParagraph","Properties":{"id":"20240612145234-s1tsr4j","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入肝、脾二经。\""}]},{"ID":"20240612145234-w51y4k8","Type":"NodeParagraph","Properties":{"id":"20240612145234-w51y4k8","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145234-3cduszv","Type":"NodeParagraph","Properties":{"id":"20240612145234-3cduszv","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 甘，平."}]},{"ID":"20240612145234-1gl54fk","Type":"NodeParagraph","Properties":{"id":"20240612145234-1gl54fk","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味甘，平。\""}]},{"ID":"20240612145234-zklro57","Type":"NodeParagraph","Properties":{"id":"20240612145234-zklro57","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"②崔禹锡《食经》：\"味苦，生温。\""}]},{"ID":"20240612145234-b7odbuf","Type":"NodeParagraph","Properties":{"id":"20240612145234-b7odbuf","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612145234-qfspqwj","Type":"NodeParagraph","Properties":{"id":"20240612145234-qfspqwj","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：\"恶五参、龙胆。得前胡，乌喙、杏仁、牡蛎良。杀乌头毒。\""}]},{"ID":"20240612145234-fzgx99s","Type":"NodeParagraph","Properties":{"id":"20240612145234-fzgx99s","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145234-vaq4htz","Type":"NodeParagraph","Properties":{"id":"20240612145234-vaq4htz","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 清解表邪，分利湿热。治湿温初起，湿热不化，汗少，胸痞，水肿胀满，小便不利，湿痹，筋挛，骨节烦疼。"}]},{"ID":"20240612145234-u5yncqy","Type":"NodeParagraph","Properties":{"id":"20240612145234-u5yncqy","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主湿痹，筋挛，膝痛。\""}]},{"ID":"20240612145234-41wuzyy","Type":"NodeParagraph","Properties":{"id":"20240612145234-41wuzyy","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"五藏（一作‘五藏不足’），胃气结积，益气，止毒（一作‘止痛’）。去黑皯，润泽皮毛。\""}]},{"ID":"20240612145234-mb5lmjg","Type":"NodeParagraph","Properties":{"id":"20240612145234-mb5lmjg","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"③《食疗本草》：\"破妇人恶血。\""}]},{"ID":"20240612145234-c1xveam","Type":"NodeParagraph","Properties":{"id":"20240612145234-c1xveam","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"除胃中积热，消水病胀满。\""}]},{"ID":"20240612145234-jv3ctgl","Type":"NodeParagraph","Properties":{"id":"20240612145234-jv3ctgl","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"⑤《中药志》：\"发表利湿。治湿热内蕴，汗少，小便不利。\""}]},{"ID":"20240612145234-brqdjsg","Type":"NodeParagraph","Properties":{"id":"20240612145234-brqdjsg","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145234-3031rdg","Type":"NodeParagraph","Properties":{"id":"20240612145234-3031rdg","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3～5钱；捣汁或入散剂。"}]},{"ID":"20240612145234-g32zvha","Type":"NodeParagraph","Properties":{"id":"20240612145234-g32zvha","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612145234-gfegl6w","Type":"NodeParagraph","Properties":{"id":"20240612145234-gfegl6w","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" ①治水病，通身肿满，喘急，大小便涩：大豆黄卷（醋拌炒干），大黄（微煨去皮）各-两。捣罗为散。每服二钱匕，临卧时，煎葱、橘皮汤调下，平明以利大肠为度。（《圣济总录》大豆散）"}]},{"ID":"20240612145234-e55nqb5","Type":"NodeParagraph","Properties":{"id":"20240612145234-e55nqb5","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"②治头风，湿痹，筋挛膝痛，胃中积热，大便结涩：大豆黄卷（炒）一升，酥半两。为末，食前温水服一匙，日二服。（《普济方》黄卷散）"}]},{"ID":"20240612145234-k7dksqw","Type":"NodeParagraph","Properties":{"id":"20240612145234-k7dksqw","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"③治周痹注，五脏留滞，胃中结聚，益气出毒，润皮毛，补肾气：大豆蘖一斤。炒香熟，为末。每服半钱，温酒调下,空心，加至一钱，日三服。（《宣明论方》）"}]},{"ID":"20240612145234-cbh05ps","Type":"NodeParagraph","Properties":{"id":"20240612145234-cbh05ps","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"④治小儿撮口及发噤：以初生时豆芽，烂研，以乳汁调与儿吃，或生研绞取汁，少许与服亦得。（《圣惠方》）"}]},{"ID":"20240612145234-rsua976","Type":"NodeParagraph","Properties":{"id":"20240612145234-rsua976","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"制法"}]},{"ID":"20240612145234-k8ow8w8","Type":"NodeParagraph","Properties":{"id":"20240612145234-k8ow8w8","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 大豆黄卷：取黑大豆洗净，浸泡至外皮微皱，捞出，置竹箩内，上盖湿蒲包，每日淋水1～2次，促使发芽。至芽长1厘米时，取出摊在筐内，先置有风处吹至半干（防止脱壳）。再行晒干即成。制大豆黄卷：取大豆黄卷置锅内，加入用淡竹叶、灯芯草煎成之药汁共煮，至药汁吸尽后，取出晒干（每大豆黄卷100斤，用淡竹叶20两，灯芯草10两）。"}]},{"ID":"20240612145234-jrkae9x","Type":"NodeParagraph","Properties":{"id":"20240612145234-jrkae9x","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145234-9ymm5ir","Type":"NodeParagraph","Properties":{"id":"20240612145234-9ymm5ir","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612145234-j5ifn1w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145234-j5ifn1w","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"《中华本草》：大豆黄卷"}]},{"ID":"20240612145234-206f262","Type":"NodeParagraph","Properties":{"id":"20240612145234-206f262","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145234-hq1jjnv","Type":"NodeParagraph","Properties":{"id":"20240612145234-hq1jjnv","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" Dà Dòu Huánɡ Juǎn"}]},{"ID":"20240612145234-dmg61l8","Type":"NodeParagraph","Properties":{"id":"20240612145234-dmg61l8","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145234-z91f0e9","Type":"NodeParagraph","Properties":{"id":"20240612145234-z91f0e9","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 大豆卷、大豆蘖、黄卷、卷蘖、黄卷皮、豆蘖、豆黄卷、菽蘖。"}]},{"ID":"20240612145234-8qesp6f","Type":"NodeParagraph","Properties":{"id":"20240612145234-8qesp6f","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612145234-76omb57","Type":"NodeParagraph","Properties":{"id":"20240612145234-76omb57","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" dried black soybean sprout"}]},{"ID":"20240612145234-v4wo54d","Type":"NodeParagraph","Properties":{"id":"20240612145234-v4wo54d","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612145234-57as3m2","Type":"NodeParagraph","Properties":{"id":"20240612145234-57as3m2","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240612145234-8eqkyqv","Type":"NodeParagraph","Properties":{"id":"20240612145234-8eqkyqv","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145234-wbkv9ph","Type":"NodeParagraph","Properties":{"id":"20240612145234-wbkv9ph","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物大豆Glycine max（L.）Merr.的种子发芽后晒干而成。"}]},{"ID":"20240612145234-gars0vy","Type":"NodeParagraph","Properties":{"id":"20240612145234-gars0vy","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Glycine max(L.)Merr.[Phaseolus max L.]"}]},{"ID":"20240612145234-246td5i","Type":"NodeParagraph","Properties":{"id":"20240612145234-246td5i","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采收，脱壳后放阴凉干燥处，备用。"}]},{"ID":"20240612145234-rubdes4","Type":"NodeParagraph","Properties":{"id":"20240612145234-rubdes4","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612145234-stkfe0m","Type":"NodeParagraph","Properties":{"id":"20240612145234-stkfe0m","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 大豆 一年生直立草本，高60-180cm。茎粗壮，密生褐色长硬毛。叶柄长，密生黄色长硬毛；托叶小，披针形；三出复叶，顶生小叶菱状卵形，长7-13cm，宽3-6cm，先端渐尖，基部宽楔形或圆形，两面均有白色长柔毛，侧生小叶较小，斜卵形；叶轴及小叶柄密生黄色长硬毛。总状花序腋生；苞片及小苞片披针形，有毛；花萼钏状，萼齿5，披针形，下面1齿最长，均密被白色长柔毛；花冠小，白色或淡紫色，稍较萼长；旗瓣先端微凹，翼瓣具1耳，龙骨瓣镰形；雄蕊10，二体；子房线形，被毛。荚果带状长圆形，略弯，下垂，黄绿色，密生黄色长硬毛。种子2-5颗，黄绿色或黑色，卵形至近球形，长约1cm。花期6-7月，果期8-10月。"}]},{"ID":"20240612145234-92phl1x","Type":"NodeParagraph","Properties":{"id":"20240612145234-92phl1x","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612145234-jnefna3","Type":"NodeParagraph","Properties":{"id":"20240612145234-jnefna3","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 全国各地广泛栽培。"}]},{"ID":"20240612145234-3193n05","Type":"NodeParagraph","Properties":{"id":"20240612145234-3193n05","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612145234-wz8biw0","Type":"NodeParagraph","Properties":{"id":"20240612145234-wz8biw0","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 种子椭圆形或肾形，稍扁，长0.7-1.4cm，宽5-8mm；表面灰黄色、黑褐色或紫褐色，光亮，有横向皱纹，一侧有长圆形种脐，长2-3mm。种皮常裂开、破碎或脱落。子叶黄色，肥厚，胚根细长，伸出种皮之外，弯曲，长0.5-1cm；质脆易断。也有少数未发芽的种子，种皮完整。气无，昧淡，有油腻感。以粒大饱满、有皱纹及短芽者为佳。"}]},{"ID":"20240612145234-ku3ehsp","Type":"NodeParagraph","Properties":{"id":"20240612145234-ku3ehsp","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"显微鉴别 粉末特征：黄白色或黄褐色。①栅状细胞顶面观呈长多角形，壁甚厚，孔沟明显；底面观胞腔内含棕黄色或棕黑色物；断面观呈长柱形，长48-102μm，直径9-10μm，壁自内向外渐增厚。②支柱细胞哑铃状或骨状，长26-170μm，宽20-73μm，缢缩部宽12-26μm，其顶面观呈类圆形，胞腔明显③糊粉层细胞形小，呈类方形，壁较厚。④种脐部位栅状细胞内侧的星状组织碎片少见，细胞类圆形、圆多角形或不规则形，壁较厚，有大型的细胞间隙。"}]},{"ID":"20240612145234-u55bp0k","Type":"NodeParagraph","Properties":{"id":"20240612145234-u55bp0k","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612145234-n6qnvxp","Type":"NodeParagraph","Properties":{"id":"20240612145234-n6qnvxp","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 含天门冬酰胺、胆碱、黄嘌呤(xanthine)及次黄嘌呤(hypoxanthine)，另含钙、钾、硅等。此外，含有丰富的蛋白质、脂肪、碳水化合物，以及甘氨酸、亮氨酸、异亮氨酸等。"}]},{"ID":"20240612145234-garosn1","Type":"NodeParagraph","Properties":{"id":"20240612145234-garosn1","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612145234-9ce965i","Type":"NodeParagraph","Properties":{"id":"20240612145234-9ce965i","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 1.抑菌作用：对肺炎球菌、金黄色葡萄球菌等均有抑制作用。2.抗病毒作用：用于病毒性感冒、流感。"}]},{"ID":"20240612145234-2flh3jm","Type":"NodeParagraph","Properties":{"id":"20240612145234-2flh3jm","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612145234-m8nhbf8","Type":"NodeParagraph","Properties":{"id":"20240612145234-m8nhbf8","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 大豆黄卷：取黑大豆洗净，浸泡至外皮微皱，捞出，置竹箩内，上盖湿蒲包，每日淋水1-2次，促使发芽；至芽长1cm时，取出摊在内，先置有风处吹至半干（防止脱壳），再行晒干即成。制大豆黄卷：取大豆黄卷置锅内，加入用淡竹叶、灯芯草煎成之药汁共煮，至药汁吸尽后，取出晒干（每大豆黄卷100斤，用淡竹叶20两，灯芯草10两）。"}]},{"ID":"20240612145234-vxhthv5","Type":"NodeParagraph","Properties":{"id":"20240612145234-vxhthv5","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612145234-a2jpzxp","Type":"NodeParagraph","Properties":{"id":"20240612145234-a2jpzxp","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 薄层色谱：取样品粗粉g.5g，加70％乙醇7ml沸水浴上加热20min，放冷滤过，滤液浓缩至0.2mL，吸取20μl点样。以脯氨酸、亮氨酸和天冬酰胺坡作对照，点于硅胶G（青岛）板上。展开剂：Ⅰ．正丁醇一醋酸-水（3：1：1）；Ⅱ．酚-水（75：25）作双向展开，展距10cm。用1％三酮丙酮液喷雾后，于105℃烤5min。样品色谱中在与对照品色谱相对应的位置上可见紫红色斑点。"}]},{"ID":"20240612145234-jhbboba","Type":"NodeParagraph","Properties":{"id":"20240612145234-jhbboba","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145234-7rtc1zd","Type":"NodeParagraph","Properties":{"id":"20240612145234-7rtc1zd","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 脾；肝；胃经"}]},{"ID":"20240612145234-u8da52n","Type":"NodeParagraph","Properties":{"id":"20240612145234-u8da52n","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145234-shc3v3u","Type":"NodeParagraph","Properties":{"id":"20240612145234-shc3v3u","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 甘；平"}]},{"ID":"20240612145234-8oa6lfs","Type":"NodeParagraph","Properties":{"id":"20240612145234-8oa6lfs","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145234-ocpmsyb","Type":"NodeParagraph","Properties":{"id":"20240612145234-ocpmsyb","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 清热透表；除湿利气。主湿温初起；暑湿发热；食滞脘痞；湿痹；筋挛；骨节烦疼；水肿胀满；小便不利"}]},{"ID":"20240612145234-swjrg54","Type":"NodeParagraph","Properties":{"id":"20240612145234-swjrg54","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145234-eqvybma","Type":"NodeParagraph","Properties":{"id":"20240612145234-eqvybma","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或捣汁；或入散剂。"}]},{"ID":"20240612145234-tuzh3zm","Type":"NodeParagraph","Properties":{"id":"20240612145234-tuzh3zm","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612145234-xtj4tej","Type":"NodeParagraph","Properties":{"id":"20240612145234-xtj4tej","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 薯蓣丸《金匮要略》：外感风寒、自汗；牛黄清心丸《太平惠民和剂局方》：清心开窍、熄风通络；大豆散《圣济总录》：水病、大小便涩；黄卷《普济方》：头风、湿痹"}]},{"ID":"20240612145234-nvz1u1s","Type":"NodeParagraph","Properties":{"id":"20240612145234-nvz1u1s","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612145234-ahbdwle","Type":"NodeParagraph","Properties":{"id":"20240612145234-ahbdwle","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 1.《本草汇言》：大豆黄卷，活血气，消水胀之药也。蓐妇药中多用之，有行瘀血之妙也；水肿方中多用之，有行水之功也。仰思前古治湿痹久着与筋挛膝痛，皆血与水气之所结也。《局方》牛黄清心丸，用此以去风痰，解烦郁，通心气，安神明昏乱，亦借此开通发越之意云。"}]},{"ID":"20240612145234-mtd6bul","Type":"NodeParagraph","Properties":{"id":"20240612145234-mtd6bul","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"2.《长沙药解》：大豆黄卷，专泄水湿，善达木郁，通腠理而逐湿痹，行经脉而破血檗，疗水郁腹胀之病，治筋挛膝痛之疾。"}]},{"ID":"20240612145234-7waibfg","Type":"NodeParagraph","Properties":{"id":"20240612145234-7waibfg","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"3.《吴医汇讲》：周思哲曰：大豆黄卷，古人罕用。《本草》载其性曰，治湿痹筋挛膝痛，五脏不足，益气宣胃，破妇人恶血，除胃中积热，消水气胀满。即《金匮》虚劳门薯蓣丸于气血并补方中佐之。后之着方解者，有宣发肾气之论，亦未谓其发表也。近来误作表药者，其故何欤？盖因吾吴人喜服轻方，而昔之治病，俱于医家取药，有云马元仪预用麻黄汤浸豆发檗，凡遇应用麻黄者，方开豆卷，俾病家无所疑惧，渠得药投中病，曲以两全，此心亦良苦矣。后医不明细底，竟认豆卷与豆豉同类，公然影射作为表剂，但肆中豆卷岂亦有麻黄汤浸发者乎？即以格致之理论之，豆得水而发檗，或能些微宣湿，亦不能力通表药也。若用二、三钱之豆卷，即可表汗，世人以此为蔬菜者，每食盈簋，何不汗至亡阳耶？"}]},{"ID":"20240612145234-u5n08e4","Type":"NodeParagraph","Properties":{"id":"20240612145234-u5n08e4","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"4.《本经疏证》：夫湿痹而筋挛膝痛，湿闭于下者宜升，湿不闭则筋自舒，筋既舒则膝自不痛。舒筋之物，有薏苡、木瓜、牛膝，何以独取大豆黄卷？夫木瓜治转筋，非治筋挛，薏苡治筋急拘挛，不治筋挛，牛膝治筋挛，能降而不能升。既治筋挛，又欲其湿升者，舍大豆黄卷别无物矣。所以者何？湿流关节，关节之大者如膝，而又最近于腹，湿既痹于此，势不能下，又不能升，与其逐而下之，仍无出路，莫若就近使上于腹，或从小便，或从汗出而解。仲景薯蓣丸治风气百疾，取此与柴胡、桂枝、防风、白敛为伍，亦岂不以其能发耶？"}]},{"ID":"20240612145234-cbjbj5d","Type":"NodeParagraph","Properties":{"id":"20240612145234-cbjbj5d","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"5.《本草便读》：豆卷，即黑豆浸水中生芽者也，其性味功用，与黑豆大同。然其浸水生芽，则有生发之气，故亦能解表。至于宣风解毒，乃豆之本性，能舒筋者，亦因水湿所困耳。"}]},{"ID":"20240612145234-3f4no7k","Type":"NodeParagraph","Properties":{"id":"20240612145234-3f4no7k","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"6.张寿颐：豆黄卷，孟诜谓破妇人恶血，濒湖除胃中积热，消水病胀满，则此药之性情效用，盖与豆豉大同小异，本不在发表解肌之例，但今之江浙市中，则亦以麻黄汤浸过，发汗又确有证验，是因制法之变迁，而药物性情，今非昔比矣。用药分量，随其人体质，酌量轻重，亦如豆豉之例。"}]},{"ID":"20240612145234-o8cukhe","Type":"NodeParagraph","Properties":{"id":"20240612145234-o8cukhe","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"7.其他：《本经》：主湿痹，筋挛，膝痛。《别录》：五藏（一作‘五藏不足’），胃气结积，益气，止毒（一作‘止痛’）。去黑，润泽皮毛。《食疗本草》：破妇人恶血。《纲目》：除胃中积热，消水病胀满。《中药志》：发表利湿。治湿热内蕴，汗少，小便不利。"}]},{"ID":"20240612145234-kdkziuv","Type":"NodeParagraph","Properties":{"id":"20240612145234-kdkziuv","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145234-jo118pz","Type":"NodeParagraph","Properties":{"id":"20240612145234-jo118pz","updated":"20240612145234"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612145235-08ti875","Type":"NodeThematicBreak","Properties":{"id":"20240612145235-08ti875"}},{"ID":"20240612145236-brj01ty","Type":"NodeParagraph","Properties":{"id":"20240612145236-brj01ty"}}]}