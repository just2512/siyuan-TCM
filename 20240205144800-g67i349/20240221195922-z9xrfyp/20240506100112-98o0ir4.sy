{"ID":"20240506100112-98o0ir4","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100112-98o0ir4","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100112-98o0ir4\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240627130700-0yanjbf\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612145234-mb5lmjg\u0026quot;,\u0026quot;scrollTop\u0026quot;:1300,\u0026quot;focusId\u0026quot;:\u0026quot;20240627131326-agfns7c\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"249大豆黄卷","type":"doc","updated":"20240821190534"},"Children":[{"ID":"20240627130700-0yanjbf","Type":"NodeParagraph","Properties":{"id":"20240627130700-0yanjbf","updated":"20240821185138"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 512px;","style":"width: 502px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"大豆黄卷"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/大豆黄卷-20240821185130-1tmt67o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 502px;\" parent-style=\"width: 512px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627130840-0vxxx9u","Type":"NodeParagraph","Properties":{"id":"20240627130840-0vxxx9u","updated":"20240821184323"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 525px;","style":"width: 515px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黑豆"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黑豆-20240627130841-ju7nnox.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 515px;\" parent-style=\"width: 525px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240627130752-5jlmxps","Type":"NodeParagraph","Properties":{"id":"20240627