{"ID":"20240506100113-gravi17","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100113-gravi17","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100113-gravi17\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506100113-ug7ck84\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612161137-wft1owx\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240704081120-p1k03ho\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"260卤咸（卤碱、卤盐）","type":"doc","updated":"20240822094622"},"Children":[{"ID":"20240506100113-ug7ck84","Type":"NodeParagraph","Properties":{"id":"20240506100113-ug7ck84","updated":"20240627161212"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"青盐"}]},{"ID":"20240704081120-p1k03ho","Type":"NodeParagraph","Properties":{"id":"20240704081120-p1k03ho","updated":"20240822094156"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 408px;","style":"width: 398px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青盐"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青盐-20240822094149-zfujm3g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 398px;\" parent-style=\"width: 408px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627161343-fxk64ww","Type":"NodeParagraph","Properties":{"id":"20240627161343-fxk64ww","updated":"20240822094234"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青盐 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青盐 1-20240822094232-sids16v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822094310-i61obfj","Type":"NodeParagraph","Properties":{"id":"20240822094310-i61obfj","updated":"20240822094310"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青盐 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青盐 2-20240822094310-jndctx2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822094351-fhd889y","Type":"NodeParagraph","Properties":{"id":"20240822094351-fhd889y","updated":"20240822094351"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 672px;","style":"width: 662px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青盐 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青盐 3-20240822094351-1dzozt8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 662px;\" parent-style=\"width: 672px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627161327-1v7zxa8","Type":"NodeParagraph","Properties":{"id":"20240627161327-1v7zxa8","updated":"20240822094400"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 856px;","style":"width: 846px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青盐5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青盐5-20240627162211-ee9dms8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 846px;\" parent-style=\"width: 856px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240627162210-v6a0mze","Type":"NodeParagraph","Properties":{"id":"20240627162210-v6a0mze","updated":"20240704080907"},"Children":[{"Type":"NodeText","Data":"​​"}]},{"ID":"20240704080904-1iasoo1","Type":"NodeParagraph","Properties":{"id":"20240704080904-1iasoo1"}},{"ID":"20240627161213-4sou5tm","Type":"NodeParagraph","Properties":{"id":"20240627161213-4sou5tm","updated":"20240627161216"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"海盐"}]},{"ID":"20240627161524-m413vrh","Type":"NodeParagraph","Properties":{"id":"20240627161524-m413vrh","updated":"20240822094443"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 428px;","style":"width: 418px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海盐"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海盐-20240627161524-ohi1csj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 418px;\" parent-style=\"width: 428px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627161626-gy0qb9u","Type":"NodeParagraph","Properties":{"id":"20240627161626-gy0qb9u","updated":"20240822094542"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 429px;","style":"width: 419px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海盐"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海盐-20240822094540-fpit91d.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 419px;\" parent-style=\"width: 429px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822094622-27puboc","Type":"NodeParagraph","Properties":{"id":"20240822094622-27puboc","updated":"20240822094622"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"海盐 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/海盐 1-20240822094622-mfz0wxa.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612161132-731cnfs","Type":"NodeThematicBreak","Properties":{"id":"20240612161132-731cnfs"}},{"ID":"20240612161132-og5f8u1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161132-og5f8u1","updated":"20240612161645"},"Children":[{"Type":"NodeText","Data":"卤咸《神农本草经》"}]},{"ID":"20240612161132-fmiin4l","Type":"NodeParagraph","Properties":{"id":"20240612161132-fmiin4l","updated":"20240612161638"},"Children":[{"Type":"NodeText","Data":"味苦，寒，无毒。治大热，消渴，狂烦，除邪及吐 下蛊毒，柔肌肤。一名寒石。生盐池。大盐，一名胡盐。寒，无毒。 治肠胃结热，令人吐。生池泽。戎盐。主明目，目痛，益气，坚肌 骨，去毒蛊。生北地。"}]},{"ID":"20240612161132-u7i3jfi","Type":"NodeThematicBreak","Properties":{"id":"20240612161132-u7i3jfi"}},{"ID":"20240612161449-m4j5oj4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161449-m4j5oj4","updated":"20240612161453"},"Children":[{"Type":"NodeText","Data":"卤碱《本经逢原》"}]},{"ID":"20240612161449-gcynv6w","Type":"NodeParagraph","Properties":{"id":"20240612161449-gcynv6w","updated":"20240612161449"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名石碱"}]},{"ID":"20240612161449-klb7td7","Type":"NodeParagraph","Properties":{"id":"20240612161449-klb7td7","updated":"20240612161449"},"Children":[{"Type":"NodeText","Data":"苦咸微寒，无毒。"}]},{"ID":"20240612161449-1matne9","Type":"NodeParagraph","Properties":{"id":"20240612161449-1matne9","updated":"20240612161449"},"Children":[{"Type":"NodeText","Data":"《本经》主大热消渴，狂烦，除邪及下蛊毒，柔肌肤。"}]},{"ID":"20240612161449-352n1fp","Type":"NodeParagraph","Properties":{"id":"20240612161449-352n1fp","updated":"20240612161449"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"碱味咸性走，故能消痰磨积，祛热烦。蛊毒、消渴，属实热者宜之。肌肤粗者，以汤洗之，顽皮渐退，是即柔肌肤之谓也。水碱乃灶灰淋汤，冲银黝脚所造，性能发面，故面铺中无不用之，病患食之多发浮肿，故方后每忌湿面。观其善涤衣垢，克削可知。"}]},{"ID":"20240612161132-xc4lmd2","Type":"NodeThematicBreak","Properties":{"id":"20240612161132-xc4lmd2"}},{"ID":"20240612161336-pius12h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161336-pius12h","updated":"20240612161341"},"Children":[{"Type":"NodeText","Data":"卤咸《新修本草》"}]},{"ID":"20240612161336-bmijtig","Type":"NodeParagraph","Properties":{"id":"20240612161336-bmijtig","updated":"20240612161336"},"Children":[{"Type":"NodeText","Data":"味苦、咸，寒，无毒。主大热，消渴，狂烦，除邪，及吐下蛊毒，柔肌肤。去五脏肠胃留热，结气，心下坚，食已呕逆，喘满，明目，目痛。生河东盐池。"}]},{"ID":"20240612161336-t6g88rk","Type":"NodeParagraph","Properties":{"id":"20240612161336-t6g88rk","updated":"20240612161336"},"Children":[{"Type":"NodeText","Data":"云是煎盐釜下凝滓。"}]},{"ID":"20240612161336-e06ux75","Type":"NodeParagraph","Properties":{"id":"20240612161336-e06ux75","updated":"20240612161336"},"Children":[{"Type":"NodeText","Data":"〔谨案〕卤咸即生河东，河东盐不釜煎，明非凝滓也。此是碱土名卤咸，今人熟皮用之，字作古陷反，斯则于碱地掘取之。"}]},{"ID":"20240612161132-k9asj8f","Type":"NodeThematicBreak","Properties":{"id":"20240612161132-k9asj8f"}},{"ID":"20240612161322-7ygr9qo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161322-7ygr9qo","updated":"20240612161326"},"Children":[{"Type":"NodeText","Data":"卤咸《千金翼方》"}]},{"ID":"20240612161322-eikdyf7","Type":"NodeParagraph","Properties":{"id":"20240612161322-eikdyf7","updated":"20240612161322"},"Children":[{"Type":"NodeText","Data":"味苦咸，寒，无毒。主大热，消渴狂烦，除邪，及下蛊毒，柔肌肤，去五脏肠胃留热，结气，心下坚，食已呕逆，喘满，明目，目痛。生河东盐池。"}]},{"ID":"20240612161132-r73p6i3","Type":"NodeThematicBreak","Properties":{"id":"20240612161132-r73p6i3"}},{"ID":"20240612161206-mxdeol4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161206-mxdeol4","updated":"20240612161213"},"Children":[{"Type":"NodeText","Data":"卤咸《证类本草》"}]},{"ID":"20240612161206-4420bfv","Type":"NodeParagraph","Properties":{"id":"20240612161206-4420bfv","updated":"20240612161206"},"Children":[{"Type":"NodeText","Data":"味苦、咸，寒，无毒。主大热、消渴、狂烦，除邪及下蛊毒，柔肌肤。去五脏肠胃留热结气，心下坚，食已呕逆喘满，明目目痛。生河东盐池。"}]},{"ID":"20240612161206-3tmee4s","Type":"NodeParagraph","Properties":{"id":"20240612161206-3tmee4s","updated":"20240612161206"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶是煎盐釜下凝滓。唐本注云∶卤咸既生河东，河东盐不釜煎，明非凝滓。此是碱土名卤咸，今人熟皮用之，斯则于碱地掘取之。"}]},{"ID":"20240612161206-ivzqq38","Type":"NodeParagraph","Properties":{"id":"20240612161206-ivzqq38","updated":"20240612161206"},"Children":[{"Type":"NodeText","Data":"图经文具食盐条下。"}]},{"ID":"20240612161206-xzfqio1","Type":"NodeParagraph","Properties":{"id":"20240612161206-xzfqio1","updated":"20240612161206"},"Children":[{"Type":"NodeText","Data":"丹房镜源云∶卤盐纯制四黄，作焊药。"}]},{"ID":"20240612161802-pvhipx1","Type":"NodeThematicBreak","Properties":{"id":"20240612161802-pvhipx1"}},{"ID":"20240612161803-cdq92bn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161803-cdq92bn","updated":"20240612161809"},"Children":[{"Type":"NodeText","Data":"卤咸《本草纲目》"}]},{"ID":"20240612161823-36w8w7r","Type":"NodeParagraph","Properties":{"id":"20240612161823-36w8w7r","updated":"20240612161831"},"Children":[{"Type":"NodeText","Data":"释名：亦名卤盐、寒石、石碱。从碱地掘取，用作硝皮。"}]},{"ID":"20240612161823-3fvunty","Type":"NodeParagraph","Properties":{"id":"20240612161823-3fvunty","updated":"20240612161835"},"Children":[{"Type":"NodeText","Data":"气味：苦、寒、无毒。"}]},{"ID":"20240612161823-imsmznb","Type":"NodeParagraph","Properties":{"id":"20240612161823-imsmznb","updated":"20240612161839"},"Children":[{"Type":"NodeText","Data":"主治：风热赤眼，虚肿涩痛。用卤碱一升、青梅二十七个、古钱二十一文，密封于新瓶中，开水煮一顿饭时间，取出静放三天。点眼，一天点三、五次。"}]},{"ID":"20240612161823-1qf7ne6","Type":"NodeParagraph","Properties":{"id":"20240612161823-1qf7ne6","updated":"20240612161841"},"Children":[{"Type":"NodeText","Data":"牙齿腐烂。取上好碱土，热水淋之，去渣留汁，瓦罐熬干。刮下，加麝香少许，研细，搽患处。"}]},{"ID":"20240612161132-79my128","Type":"NodeThematicBreak","Properties":{"id":"20240612161132-79my128"}},{"ID":"20240612161133-nh7jnty","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161133-nh7jnty","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：卤碱"}]},{"ID":"20240612161133-pq13t6s","Type":"NodeParagraph","Properties":{"id":"20240612161133-pq13t6s","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612161133-nniyemi","Type":"NodeParagraph","Properties":{"id":"20240612161133-nniyemi","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" Lǔ Jiǎn"}]},{"ID":"20240612161133-ib7fztf","Type":"NodeParagraph","Properties":{"id":"20240612161133-ib7fztf","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612161133-cxe7cj0","Type":"NodeParagraph","Properties":{"id":"20240612161133-cxe7cj0","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"卤水块"},{"Type":"NodeText","Data":"经过加工制成的粉剂。"}]},{"ID":"20240612161133-e00urdr","Type":"NodeParagraph","Properties":{"id":"20240612161133-e00urdr","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612161133-ppx42jq","Type":"NodeParagraph","Properties":{"id":"20240612161133-ppx42jq","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 取河北塘沽或汉沽产的卤水块，洗净，打碎，放容器内，约加等量水溶解，用6～8层纱布过滤，将滤液放在容器内加热，经过蒸发，烘干至成为疏松、洁白的块状物，取出放凉，轧成细粉即得。"}]},{"ID":"20240612161133-gxvuvte","Type":"NodeParagraph","Properties":{"id":"20240612161133-gxvuvte","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612161133-84ls1qd","Type":"NodeParagraph","Properties":{"id":"20240612161133-84ls1qd","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 咸、苦，温。"}]},{"ID":"20240612161133-hhxifkd","Type":"NodeParagraph","Properties":{"id":"20240612161133-hhxifkd","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612161133-iwjs0e0","Type":"NodeParagraph","Properties":{"id":"20240612161133-iwjs0e0","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 必须用开水溶化，放冷后再服。"}]},{"ID":"20240612161133-wupkxid","Type":"NodeParagraph","Properties":{"id":"20240612161133-wupkxid","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612161133-zsodwv0","Type":"NodeParagraph","Properties":{"id":"20240612161133-zsodwv0","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 强心，利尿，镇静，消炎，降血压。用于克山病，大骨节病，地方性甲状腺肿，风湿性关节炎，硅肺，高血压病。"}]},{"ID":"20240612161133-ncfj1um","Type":"NodeParagraph","Properties":{"id":"20240612161133-ncfj1um","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612161133-ixinkgj","Type":"NodeParagraph","Properties":{"id":"20240612161133-ixinkgj","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 成人每次1～2克，每日2～3次。小儿6～10岁，每次0.3～0.5克；10～15岁，每次0.5～1.0克；15岁以上同成人量。用开水溶化后冷服。"}]},{"ID":"20240612161133-pqwmoc3","Type":"NodeParagraph","Properties":{"id":"20240612161133-pqwmoc3","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612161133-7u734mx","Type":"NodeParagraph","Properties":{"id":"20240612161133-7u734mx","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" （1）必须用开水溶化，放冷后再服。以免药粉沾于口腔造成腐蚀。应用时宜由小量开始，视反应情况而逐渐增加，不宜超过最大剂量。"}]},{"ID":"20240612161133-tvva3aq","Type":"NodeParagraph","Properties":{"id":"20240612161133-tvva3aq","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"（2）常用剂量下部分病人出现胃部有烧灼感，口干，恶心，肠鸣增加，轻度腹泻，皮肤瘙痒，一般情况下可继续给药，如症状不减甚至加重时，可酌情减量或停药，并对症治疗。"}]},{"ID":"20240612161133-gt4e0ah","Type":"NodeParagraph","Properties":{"id":"20240612161133-gt4e0ah","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612161133-ec9gsdq","Type":"NodeParagraph","Properties":{"id":"20240612161133-ec9gsdq","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612161133-95sbva0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161133-95sbva0","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：卤碱"}]},{"ID":"20240612161133-mghnvd7","Type":"NodeParagraph","Properties":{"id":"20240612161133-mghnvd7","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612161133-vyo3q0t","Type":"NodeParagraph","Properties":{"id":"20240612161133-vyo3q0t","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" Lǔ Jiǎn"}]},{"ID":"20240612161133-ph12oky","Type":"NodeParagraph","Properties":{"id":"20240612161133-ph12oky","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612161133-xwllett","Type":"NodeParagraph","Properties":{"id":"20240612161133-xwllett","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 卤咸（《本经》），卤盐、寒石（《吴普本草》）。"}]},{"ID":"20240612161133-fmioit4","Type":"NodeParagraph","Properties":{"id":"20240612161133-fmioit4","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612161133-tbbqmxs","Type":"NodeParagraph","Properties":{"id":"20240612161133-tbbqmxs","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 《纲目》"}]},{"ID":"20240612161133-n58pz13","Type":"NodeParagraph","Properties":{"id":"20240612161133-n58pz13","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612161133-uwsme9k","Type":"NodeParagraph","Properties":{"id":"20240612161133-uwsme9k","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"盐卤凝结而成的氯化镁等物质的结晶"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612161133-xznrwvd","Type":"NodeParagraph","Properties":{"id":"20240612161133-xznrwvd","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612161133-c1nuj3d","Type":"NodeParagraph","Properties":{"id":"20240612161133-c1nuj3d","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 为无色结晶体。玻璃样光泽，有潮解性。"}]},{"ID":"20240612161133-pb79u0s","Type":"NodeParagraph","Properties":{"id":"20240612161133-pb79u0s","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612161133-3ufcaq6","Type":"NodeParagraph","Properties":{"id":"20240612161133-3ufcaq6","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 主要含氯、镁、钠、钾、钙和硫酸根离子，其次为二氧化硅、氟、锶、铁、硼、溴，微量的有锂、铝、锰、锌、铜、钛、铬、硒、镍、碘、汞、银、钍、锗等。"}]},{"ID":"20240612161133-rpc6ozb","Type":"NodeParagraph","Properties":{"id":"20240612161133-rpc6ozb","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"海盐、湖盐、井盐和盐碱地盐四种卤水和卤碱的成分有所不同。4种的主要化学成分均为镁和氯，但镁的含量在海盐卤水中最高，依次为盐碱地卤水、湖盐卤水和井盐卤水。熬制成卤碱后，前二者的镁含量较接近，均大于后二者。氯的含量在井盐和海盐卤水中较高，另两种较低；井盐卤水和卤碱的钙含量显着高于其余3种；盐碱地卤水和卤碱的硫酸根和氟的含量显着高于其余3种；盐碱地卤水和卤碱中均未检出锰，而其余3种均有相当量的锰。井盐卤水和卤碱中锂含量显着高于其余3种。"}]},{"ID":"20240612161133-izvdca7","Type":"NodeParagraph","Properties":{"id":"20240612161133-izvdca7","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612161133-cfaahq0","Type":"NodeParagraph","Properties":{"id":"20240612161133-cfaahq0","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" ①利尿作用"}]},{"ID":"20240612161133-4g90wl2","Type":"NodeParagraph","Properties":{"id":"20240612161133-4g90wl2","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"对正常大鼠有利尿作用，去除镁离子后仍保留一定效力，因此口服卤碱后尿量的增加，可能是卤碱中多种盐类综合作用的结果。"}]},{"ID":"20240612161133-e05e9w4","Type":"NodeParagraph","Properties":{"id":"20240612161133-e05e9w4","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"②对心血管的作用"}]},{"ID":"20240612161133-mix32zl","Type":"NodeParagraph","Properties":{"id":"20240612161133-mix32zl","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"对离体兔心及整体狗心都有明显的冠状动脉扩张作用；对垂体后叶素引起的急性心肌缺血有一定的预防作用；此作用与其中含有大量镁离子有关。这可能是卤碱能改善慢性克山病和其他心脏病患者的功能的作用之一。它还能使高血压狗的血压轻度下降，脉搏减慢；对麻醉狗的肢体动脉有直接扩张作用，镁离子是引起这些作用的重要成分。它无强心作用（蛙、兔实验），也无镇静作用（小鼠的戊巴比妥睡眠时间及自发活动实验）。"}]},{"ID":"20240612161133-49fzocp","Type":"NodeParagraph","Properties":{"id":"20240612161133-49fzocp","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612161133-4hkdtrs","Type":"NodeParagraph","Properties":{"id":"20240612161133-4hkdtrs","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 苦咸，寒。"}]},{"ID":"20240612161133-jj42cif","Type":"NodeParagraph","Properties":{"id":"20240612161133-jj42cif","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240612161133-8k1xcfl","Type":"NodeParagraph","Properties":{"id":"20240612161133-8k1xcfl","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240612161133-03hvbsm","Type":"NodeParagraph","Properties":{"id":"20240612161133-03hvbsm","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612161133-vtxvb19","Type":"NodeParagraph","Properties":{"id":"20240612161133-vtxvb19","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 治克山病，大骨节病，甲状腺肿，高血压，风湿性心脏病，慢性支气管炎，皮炎，风热赤眼。"}]},{"ID":"20240612161133-6cbboy8","Type":"NodeParagraph","Properties":{"id":"20240612161133-6cbboy8","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主大热、消渴、狂烦，除邪，柔肌肤。\""}]},{"ID":"20240612161133-z2gov93","Type":"NodeParagraph","Properties":{"id":"20240612161133-z2gov93","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"去五脏肠胃留热结气，心下坚，食已呕逆，喘满，明目，目痛。\""}]},{"ID":"20240612161133-5g4z4b5","Type":"NodeParagraph","Properties":{"id":"20240612161133-5g4z4b5","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"③《吉林中草药》：\"强心，镇静，助消化，抗痉厥，消炎。治慢性克山病，甲状腺肿，大骨节病，慢性胃炎，慢性肾炎，肝炎，慢性支气管炎，高血压，皮炎，肿瘤。\""}]},{"ID":"20240612161133-mk6vz39","Type":"NodeParagraph","Properties":{"id":"20240612161133-mk6vz39","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612161133-cdvmvih","Type":"NodeParagraph","Properties":{"id":"20240612161133-cdvmvih","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 内服：溶化为水，0.3～1钱。外用：制成膏剂涂搽；溶液点眼或洗涤。"}]},{"ID":"20240612161133-rfhwo89","Type":"NodeParagraph","Properties":{"id":"20240612161133-rfhwo89","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612161133-okzanw8","Type":"NodeParagraph","Properties":{"id":"20240612161133-okzanw8","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 治风热赤眼，虚肿涩痛：卤碱一升，青梅二十七个，古钱二十一文。新瓶盛，密封，汤中煮一炊时，三日后取点，日三、五度。（《圣惠方》）"}]},{"ID":"20240612161133-84myszk","Type":"NodeParagraph","Properties":{"id":"20240612161133-84myszk","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612161133-o5ye1t3","Type":"NodeParagraph","Properties":{"id":"20240612161133-o5ye1t3","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" ①防治克山病"}]},{"ID":"20240612161133-xxlx9f6","Type":"NodeParagraph","Properties":{"id":"20240612161133-xxlx9f6","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"㈠预防：在10升水中加入卤碱粉、生石膏粉各3克及药用浓硫酸0.1毫升，可以改进病区水质。㈡治疗：急性型以0.5～2％浓度（浓度过高会引起头晕、发热、口干心慌、烦躁甚至抽搐等不良反应）注射液行静脉注射或静脉滴注。成人每日总量3～4克，2～5岁0.5～1克，6～10岁1～2克；11～16岁2～3克，用25％葡萄糖液稀释后静注或5％葡萄糖液稀释后静滴。病情不见好转时，可于3～4小时后重复用药，但不能超过每天用药总量。病情好转后；可改为口服每次1～2克。慢性型一般口服卤碱粉（须用水溶化后服）或片。成人每日6～9克，分3次饭后服；10～15岁3～5克，10岁以下2～3克，疗程约2个月。对于增进食欲，改善睡眠和周身状态等有一定作用，尤其对心力衰竭较轻的患者疗效较好。绝大多数病例在2～4周出现疗效。潜在型亦采用口服法。据81例观察，治疗3个月大部分病例自觉症状有不同程度的改善，但体征和心电图均未见显著改变。停药2～3个月后，部分病例症状有反复。"}]},{"ID":"20240612161133-y43tmbj","Type":"NodeParagraph","Properties":{"id":"20240612161133-y43tmbj","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"②治疗大骨节病"}]},{"ID":"20240612161133-770n2x2","Type":"NodeParagraph","Properties":{"id":"20240612161133-770n2x2","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"一般采用口服法，用量同前。据观察，多数患者用药2月左右，关节疼痛减轻或消除，尤以指、腕、肘等关节最为显著，从而得以改善功能障碍，增进劳动能力。X线检查，部分患者骨质获得不同程度的修复，年龄愈小疗效愈高。因为12岁以下小孩正是骨骺生长发育的过程，故卤碱的治疗可以直接影响病变的发生和发展；所以早期发现、早期治疗，对大骨节病的防治具有重要意义。"}]},{"ID":"20240612161133-uiukhms","Type":"NodeParagraph","Properties":{"id":"20240612161133-uiukhms","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"③治疗氟骨症"}]},{"ID":"20240612161133-beugs5r","Type":"NodeParagraph","Properties":{"id":"20240612161133-beugs5r","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用20％卤碱注射液20毫升与10～25％葡萄糖注射液20毫升混合静脉缓注，每天1次；10～20％卤碱上清液50毫升，每天3次口服。治疗64例，痊愈49例，显效10例，好转4例。"}]},{"ID":"20240612161133-ez4xxry","Type":"NodeParagraph","Properties":{"id":"20240612161133-ez4xxry","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"④治疗地方性甲状腺肿"}]},{"ID":"20240612161133-2pyivjp","Type":"NodeParagraph","Properties":{"id":"20240612161133-2pyivjp","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"以卤碱制剂口服。据数百例观察，大部分患者用药后症状消失或减轻，腺肿消失或缩小。显效病例服药1个月后便能屈颈，呼吸不感吃力，腺肿变软缩小，体力增强。"}]},{"ID":"20240612161133-q3vud56","Type":"NodeParagraph","Properties":{"id":"20240612161133-q3vud56","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑤治疗高血压病"}]},{"ID":"20240612161133-2nj9az7","Type":"NodeParagraph","Properties":{"id":"20240612161133-2nj9az7","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"口服卤碱粉每日6～9克；或每次250毫克加入25％葡萄糖20～40毫升中缓慢静脉推注，每日1～2次。据观察，多数病例能获得近期疗效，其中以I期患者疗效较佳。"}]},{"ID":"20240612161133-li64xsq","Type":"NodeParagraph","Properties":{"id":"20240612161133-li64xsq","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑥治疗脑血管意外"}]},{"ID":"20240612161133-pfwebzp","Type":"NodeParagraph","Properties":{"id":"20240612161133-pfwebzp","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用于高血压病合并的脑溢血、脑血管血栓形成、脑血管痉挛，及蜘蛛膜下腔出血。用法：㈠10％卤碱葡萄糖液20～40毫升，每日1～2次静脉缓注。重者昏迷期间用10％卤碱葡萄糖液60毫升与10％葡萄糖液500～1000毫升静滴。㈡10％卤碱30毫升加10％葡萄糖500毫升，每日1次静脉滴注（滴注时间不得少于3小时）。昏迷较深的危重病人并用抗菌药及其他中、西医疗法。对于轻型的脑动脉血栓形成，亦可采用口服法。"}]},{"ID":"20240612161133-9lfmfun","Type":"NodeParagraph","Properties":{"id":"20240612161133-9lfmfun","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑦治疗风湿性心脏病"}]},{"ID":"20240612161133-pbjkjmi","Type":"NodeParagraph","Properties":{"id":"20240612161133-pbjkjmi","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"卤碱粉剂，每日6克，溶于水中分3次服，具有利尿、止喘、镇静、增进食欲等作用，据32例观察，多数患者用药后心慌、气喘、水肿等有不同程度的改善，心率亦有下降。I、Ⅱ级心功能不全者可单独使用，Ⅲ级者须合并其它强心药。据治疗复合瓣膜病疗效较好的结果推断，卤碱治疗心脏病的作用可能以增加冠状动脉血流量，改善心肌营养为主。"}]},{"ID":"20240612161133-v2qh4yb","Type":"NodeParagraph","Properties":{"id":"20240612161133-v2qh4yb","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑧治疗风湿性关节炎"}]},{"ID":"20240612161133-u5mqjii","Type":"NodeParagraph","Properties":{"id":"20240612161133-u5mqjii","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"口服每日3次，每次1克，逐渐增加至每次2～3克。或肌肉注射每次250毫克（5％溶液5毫升），每天1～2次。静脉注射用量同高血压病。初步观察有镇痛、消肿、退热、振奋精神、改善食欲和安眠等作用。一般服药30～60克后，疼痛即开始减轻，服药至120克后，局部肿胀即开始消退，强直部位能开始活动，关节活动功能逐渐加大或恢复正常。用药过程中，部分患者疼痛减轻后又忽反复，甚至较前加重，如坚持继续服药，则又逐渐好转。对类风湿性等其它类型的关节炎亦有一定效果。"}]},{"ID":"20240612161133-l7te8kh","Type":"NodeParagraph","Properties":{"id":"20240612161133-l7te8kh","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑨治疗慢性气管炎"}]},{"ID":"20240612161133-l7d0eoa","Type":"NodeParagraph","Properties":{"id":"20240612161133-l7d0eoa","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"据436例观察，总有效率在85％上下。用法和剂量须因人因病而异。一般采用10％卤碱水口服，每日3次，每次15～20毫升，疗程2～4周不等。多数服药2周左右即可收效，首先表现为咳嗽、咯痰的减少，其后为呼吸困难的好转。对某些疗效迟缓的病例，在口服的基础上，可加用针剂肌肉注射，每日1～2次，每次200～400毫克，疗程14天，可使症状较快改善。静脉注射或滴注奏效较快，故对伴有喘息的患者较为合适，用药后可使气喘症状很快缓解。静脉注射每次600～800毫克，每日1～2次；静脉滴注每日800～1500毫克；7～10天为一疗程。对合并感染病情较重的患者，应适当配合其它药物治疗。"}]},{"ID":"20240612161133-zuezxp2","Type":"NodeParagraph","Properties":{"id":"20240612161133-zuezxp2","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑩治疗小儿喘息性支气管炎"}]},{"ID":"20240612161133-8gdokyo","Type":"NodeParagraph","Properties":{"id":"20240612161133-8gdokyo","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"可使喘息症状获得不同程度的缓解。据114例观察，有效率达96.4％。但有效时间较短，达到完全缓解的只占43.8％，经一段时间后有的病人又出现了反复；另外，对于少数炎症严重的病人，治疗效果不显著。但如配合脐带块组织穴位埋藏及内科中药等综合处理，则疗效可得到进一步巩固和提高。用法：第1次取10％卤碱注射液6毫升加10％葡萄糖14毫升，缓缓由静脉注入（20～25分钟注完）。以后卤碱注射液每次递增2毫升，总量可增至16～20毫升，随年龄而异；10％葡萄糖液逐次减量。每次注射总量为20毫升。每天1次，每周休息1天，连续注射2～4周。此外，曾用1％卤碱注射液静脉点滴治疗小儿重症肺炎，亦取得一定效果。"}]},{"ID":"20240612161133-x9i61q0","Type":"NodeParagraph","Properties":{"id":"20240612161133-x9i61q0","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑾治疗血液病"}]},{"ID":"20240612161133-e0lge2c","Type":"NodeParagraph","Properties":{"id":"20240612161133-e0lge2c","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"取卤碱潮解后的卤水（比重71.3）1000毫升，加入乌梅1两（敲碎），于半小时内熬成600毫升；另以红花1.2斤，乌梅8两，加水5000毫升熬成1800毫升，与上述600毫升乌梅卤水混合。成人每服10毫升，儿童酌减，每日3～6次。治疗颗粒性白细胞减少症31例，治前白细胞数少于4000和5000者分别为25例和6例；治后除5例＜4000、2例＜5000外，其余24例白细胞数均有明显升高。对6例血小板减少症，治后4例恢复正常，2例临床症状改善，血小板数有所增高；2例再生障碍性贫血，治后血红蛋白分别从3.2克和6克增至6.5克和7克；1例红细胞数从131万增加到270万，1例网织红细胞从0.25％增到1.4％。"}]},{"ID":"20240612161133-hhgv58z","Type":"NodeParagraph","Properties":{"id":"20240612161133-hhgv58z","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⑿治疗慢性前列腺炎"}]},{"ID":"20240612161133-dr2k5gf","Type":"NodeParagraph","Properties":{"id":"20240612161133-dr2k5gf","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用5％卤碱20毫升加10％葡萄糖注射液20毫升，缓缓静脉推注（5～10分钟内注完），每天1次，7～10天为一疗程。治疗25例，5例治愈，8例显效，7例好转。初步观察，对以泌尿症状及性功能障碍为主的类型，疗效较好，对感染型的效果不满意。且卤碱还不能完全代替其它疗法，有时抗菌素的应用还是必要的。"}]},{"ID":"20240612161133-8k9m4vs","Type":"NodeParagraph","Properties":{"id":"20240612161133-8k9m4vs","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⒀治疗麻风和麻风反应"}]},{"ID":"20240612161133-zm5b6rz","Type":"NodeParagraph","Properties":{"id":"20240612161133-zm5b6rz","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"将卤碱粉溶于温水中服，用量自0.5克开始，每日3次，连服10天为一疗程，疗程间停药3日。第二疗程每天剂量增加0.5～1克。以后每疗程逐个增加。最高剂量每次1.5～2克，每日3次。治疗中、晚期瘤型麻风50例（其中39例并用氨苯砜等抗麻风药），经两个多月观察，多数病例皮损有所消退，细菌指数亦有不同程度的下降。卤碱单独应用与合并抗麻风药物综合治疗，疗效无明显差别。治疗麻风反应28例，结果结核样型皮疹反应者大多服药1周后有所进步，表现为隆起之红肿皮疹变平，颜色变淡，局部皮肤紧张、灼热、麻木等自觉症状大为减轻，但神经粗大无明显改变。疣型麻风反应患者，一般服药3～5天后绝大多数反应症状消退，表现为结节性红斑变软变平，颜色变淡，坏死之干酪样变吸收，神经、关节疼痛减轻，全身症状改善。"}]},{"ID":"20240612161133-cobfpvn","Type":"NodeParagraph","Properties":{"id":"20240612161133-cobfpvn","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⒁治疗宫颈糜烂"}]},{"ID":"20240612161133-9xv1kp7","Type":"NodeParagraph","Properties":{"id":"20240612161133-9xv1kp7","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"将卤碱研成细末，加凡士林和适量液体石蜡调制成3％软膏。用时以带线棉球涂上药膏塞入阴道，置于宫颈糜烂处，5～10小时取出。治疗中、重度单纯性宫颈糜烂100例，痊愈20例，好转79例。有将卤碱制成10％霜剂局部涂搽，据50余例观察，经3～10次治疗后，均有效果。"}]},{"ID":"20240612161133-132bwzd","Type":"NodeParagraph","Properties":{"id":"20240612161133-132bwzd","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"⒂治疗慢性鼻炎"}]},{"ID":"20240612161133-bkuptei","Type":"NodeParagraph","Properties":{"id":"20240612161133-bkuptei","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用10％卤碱液于下鼻甲前端缓慢注入，每侧1～2毫升。对慢性单纯性鼻炎、过敏性鼻炎，行鼻甲粘膜下浅注射；对肥厚性鼻炎行鼻甲海绵体内深注射。隔日1次，4次为一疗程，一般2～3次即可见效。共治疗单纯性、过敏性及肥厚性鼻炎45例，结果临床痊愈30例，显效12例，有效1例，总有效率为95.6％。其中33例经0.5～7个月观察，除1例外均维持原有疗效。据临床观察，治疗后慢性单纯性鼻炎可见消肿、消炎、下鼻甲粘膜转为正常；而肥厚性鼻炎主要显示硬化剂作用，使下鼻甲缩小，顽固性鼻阻塞症状解除；过敏性鼻炎可见消肿，苍白的粘膜转为淡红，自觉症状消失。另外，亦有用25％卤碱溶液每2毫升加1％普鲁卡因2.5毫升，作局部注射。慢性单纯性、肥厚性鼻炎注于鼻下甲粘膜下，每侧1～1.5毫升；过敏性、药物性鼻炎注于鼻丘部位，每侧0.5～1毫升。3～5天1次，3次为一疗程。治疗700余人次，除个别外，均有不同程度的效果。一般病例经1～2疗程即可治愈，通过一年观察，复发极少。注射后鼻咽部或全身有发热感，轻微头晕，局部或有轻微疼痛。"}]},{"ID":"20240612161133-4d7ey1p","Type":"NodeParagraph","Properties":{"id":"20240612161133-4d7ey1p","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"据各地资料介绍，卤碱应用范围颇为广泛，且有多种不同剂型和用法。除用于上述疾病外，临床还曾用于治疗矽肺、三叉神经痛、神经衰弱、内科出血、慢性肾炎、心肌疾病、妊娠毒血症、骨髓炎，及肺癌、宫颈癌等各种癌症。但多系初步试用，尚须深入观察，加以总结。"}]},{"ID":"20240612161133-5eypymo","Type":"NodeParagraph","Properties":{"id":"20240612161133-5eypymo","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"卤碱的副作用：口服常用量一般不会发生重大不良反应。部分病人服药后心窝部有灼热感，肠鸣增强，或出现轻度腹泻，少则1天，多则4～5天即自愈，若久不消失可酌情减量或停药。静脉注射，偶可发生过敏反应现象，如荨麻疹、发烧等；少数患者沿注射血管有疼痛感。个别由于体弱、空腹或月经期，注射后出现颜面苍白、出冷汗，甚至发生呕吐，停药后稍事休息即可恢复。卤碱制剂注射速度过快或浓度过高，均可造成中毒甚至引起严重后果。主要是中枢神经系统受抑制（呼吸中枢的抑制尤为明显）和横纹肌松弛，呼吸肌的麻痹又可加重呼吸抑制程度。其次是心脏机能的抑制和血压下降。因此，角膜反射的消失和呼吸数的明显减少应看做是中毒的早期指征。"}]},{"ID":"20240612161133-5kyj5j7","Type":"NodeParagraph","Properties":{"id":"20240612161133-5kyj5j7","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"制法"}]},{"ID":"20240612161133-gac7j5s","Type":"NodeParagraph","Properties":{"id":"20240612161133-gac7j5s","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 取卤块用水洗净，打碎，入盆内，每盆以2～3斤为宜，稍加热溶化，用6层纱布或两层白布过滤后，将滤液煎熬，再加等量水，用急火煎熬，保持沸腾状态，切勿搅拌。待水分蒸干，刺激性气体基本挥发，并由深褐色液体变成白色固体，即为卤碱。煎熬约需1.5～2小时。每斤卤水可熬卤碱3.5两左右。将卤碱压成粉末，装瓶密闭，干燥封存。"}]},{"ID":"20240612161133-ztzeozp","Type":"NodeParagraph","Properties":{"id":"20240612161133-ztzeozp","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612161133-3mfjtcu","Type":"NodeParagraph","Properties":{"id":"20240612161133-3mfjtcu","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612161133-zjm8wgq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612161133-zjm8wgq","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"《中华本草》《中药大辞典》：卤碱"}]},{"ID":"20240612161133-mppateb","Type":"NodeParagraph","Properties":{"id":"20240612161133-mppateb","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612161133-t1o7y3r","Type":"NodeParagraph","Properties":{"id":"20240612161133-t1o7y3r","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" Lǔ Jiǎn"}]},{"ID":"20240612161133-e6vyz9j","Type":"NodeParagraph","Properties":{"id":"20240612161133-e6vyz9j","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612161133-k7en519","Type":"NodeParagraph","Properties":{"id":"20240612161133-k7en519","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 卤盐、寒石、卤咸、石碱、卤水、盐卤"}]},{"ID":"20240612161133-0o5cq9t","Type":"NodeParagraph","Properties":{"id":"20240612161133-0o5cq9t","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612161133-z6sj54a","Type":"NodeParagraph","Properties":{"id":"20240612161133-z6sj54a","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" Salt Alkali， Bittern product"}]},{"ID":"20240612161133-iqfukbe","Type":"NodeParagraph","Properties":{"id":"20240612161133-iqfukbe","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612161133-1ck1jrs","Type":"NodeParagraph","Properties":{"id":"20240612161133-1ck1jrs","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 出自《吉林中草药》。"}]},{"ID":"20240612161133-tq85ggg","Type":"NodeParagraph","Properties":{"id":"20240612161133-tq85ggg","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：卤碱，生河东盐池。"}]},{"ID":"20240612161133-x9k3md7","Type":"NodeParagraph","Properties":{"id":"20240612161133-x9k3md7","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"2.陶弘景：卤碱，云是煎盐釜下凝滓。今俗中不复见卤碱，惟魏国所献虏盐即是。"}]},{"ID":"20240612161133-vt3vqtt","Type":"NodeParagraph","Properties":{"id":"20240612161133-vt3vqtt","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"3.《唐本草》：卤碱即生河东，河东盐不釜煎，明非凝滓也，此是碱土，名卤碱，今人熟皮用之。"}]},{"ID":"20240612161133-r0ag0uo","Type":"NodeParagraph","Properties":{"id":"20240612161133-r0ag0uo","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"4.《本草纲目》：卤盐与卤碱不同，山西诸州平野及大谷榆次高亢处，秋间皆生卤，望之如水，近之如积雪，土人刮而熬之为盐，微有苍黄色者即卤盐也。《尔雅》所谓"}]},{"ID":"20240612161133-8v1mq5a","Type":"NodeParagraph","Properties":{"id":"20240612161133-8v1mq5a","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612161133-npqrzjb","Type":"NodeParagraph","Properties":{"id":"20240612161133-npqrzjb","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 药材基源：为卤块(固体卤水)经加工煎熬制成的白色结晶体。"}]},{"ID":"20240612161133-blo3c17","Type":"NodeParagraph","Properties":{"id":"20240612161133-blo3c17","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名："}]},{"ID":"20240612161133-zfa1qq1","Type":"NodeParagraph","Properties":{"id":"20240612161133-zfa1qq1","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612161133-ap901y6","Type":"NodeParagraph","Properties":{"id":"20240612161133-ap901y6","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 生态环境：主产于天津汉沽和塘沽地区；沿海诸省及内陆湖泊、盐井亦产。"}]},{"ID":"20240612161133-cno6qao","Type":"NodeParagraph","Properties":{"id":"20240612161133-cno6qao","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612161133-80vi6l5","Type":"NodeParagraph","Properties":{"id":"20240612161133-80vi6l5","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 本品为团块状。可见到分层现象，一般分为三层：上层较薄，表面皱缩不平；灰色或灰褐色。中层较厚，呈垂直柱状或蜂窝状；白色或灰白色；具弱玻璃光泽。底层较中层薄，呈致密土状物；主为灰白色；光泽暗淡。用手调皮之有空声，触之有疏松感。有潮解性。气微，味苦咸。以色白、有玻璃光泽、未潮解、结晶者为佳。"}]},{"ID":"20240612161133-f0aqx4x","Type":"NodeParagraph","Properties":{"id":"20240612161133-f0aqx4x","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"2.理化鉴别 取本品约1g，加水10ml溶解，滤过。滤液照下述方法试验。取滤液1ml，加硝酸使成酸性后，加硝酸银试液，即生成白色凝乳状沉淀。(检查氯化物)镁盐检查参见“金精石”条“药材鉴别”项理化鉴别(2)。"}]},{"ID":"20240612161133-6mt9lco","Type":"NodeParagraph","Properties":{"id":"20240612161133-6mt9lco","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612161133-zrin3kg","Type":"NodeParagraph","Properties":{"id":"20240612161133-zrin3kg","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 主要为氯化镁(MgCl2)；其次还含有钠(Na),钾(K),钙(Ca),硫酸根(SO2-/4),二氧化硅(SiO2),氟(F),锶(Sr),铁(Fe),硼(B),溴(Br);以及微量的锂(Li),铝(Al),锰(Mn),锌(Zn),铜(Cu),钛(Ti),铬(Cr)，硒(Se),镍(Ni),碘(I),汞(Hg),银(Ag),钍(Th),锗(Ge)等。"}]},{"ID":"20240612161133-5366w9i","Type":"NodeParagraph","Properties":{"id":"20240612161133-5366w9i","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"海盐、湖盐、井盐和盐碱地盐四种卤水和卤碱的成分有所不同。4种的主要化学成分均都为氯化镁，但镁的含量不同，依次为海盐、盐碱地盐、湖盐和井盐；氯的含量依次为井盐、海盐、湖盐和盐碱地盐；井盐卤水和卤碱中钙的含量显着高于另外三者；盐碱地盐卤水和卤碱中硫酸根和氟的含量显着高于其余三者，但未检出锰，而另外三种均有相当量的锰；井盐卤水和卤碱中锂含量明显高于其余三种。"}]},{"ID":"20240612161133-ghd3xw8","Type":"NodeParagraph","Properties":{"id":"20240612161133-ghd3xw8","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612161133-fclme82","Type":"NodeParagraph","Properties":{"id":"20240612161133-fclme82","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 1.利尿作用:对正常大鼠有利尿作用，去除镁离子后仍保留一定效力，因此口服卤碱后尿量的增加，可能是卤碱中多种盐类综合作用的结果。"}]},{"ID":"20240612161133-vjn0w44","Type":"NodeParagraph","Properties":{"id":"20240612161133-vjn0w44","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"2.对心血管的作用:对离体兔心及整体狗心都有明显的冠状动脉扩张作用；对垂体后叶素引起的急性心肌缺血有一定的预防作用；此作用与其中含有大量镁离子有关。这可能是卤碱能改善慢性克山病和其他心脏病患者的功能的作用之一。它还能使高血压狗的血压轻度下降，脉搏减慢；对麻醉狗的肢体动脉有直接扩张作用，镁离子是引起这些作用的重要成分。它无强心作用(蛙、兔实验)，也无镇静作用(小鼠的戊巴比妥睡眠时间及自发活动实验)。"}]},{"ID":"20240612161133-11c77yz","Type":"NodeParagraph","Properties":{"id":"20240612161133-11c77yz","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612161133-c7fkqng","Type":"NodeParagraph","Properties":{"id":"20240612161133-c7fkqng","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 取卤块用水洗净，打碎，入盆内，每盆以2-3斤为宜，稍加热溶化，用6层纱布或两层白布过滤后，将滤液煎熬，再加等量水，用急火煎熬，保持沸腾状态，切勿搅拌。待水分蒸干，刺激性气体基本挥发，并由深褐色液体变成白色固体，即为卤碱。煎熬约需1.5-2小时。每斤卤水可熬卤碱3.5两左右。将卤碱压成粉末，装瓶密闭，干燥封存。"}]},{"ID":"20240612161133-93c6no8","Type":"NodeParagraph","Properties":{"id":"20240612161133-93c6no8","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612161133-fzchxmm","Type":"NodeParagraph","Properties":{"id":"20240612161133-fzchxmm","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 心；肺；肾经"}]},{"ID":"20240612161133-3zg0yoj","Type":"NodeParagraph","Properties":{"id":"20240612161133-3zg0yoj","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612161133-x4cqqw4","Type":"NodeParagraph","Properties":{"id":"20240612161133-x4cqqw4","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 苦咸；寒；无毒"}]},{"ID":"20240612161133-luuuovv","Type":"NodeParagraph","Properties":{"id":"20240612161133-luuuovv","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612161133-k501r6f","Type":"NodeParagraph","Properties":{"id":"20240612161133-k501r6f","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 1.脏腑虚寒者慎用。"}]},{"ID":"20240612161133-h4emfwf","Type":"NodeParagraph","Properties":{"id":"20240612161133-h4emfwf","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"2.孕妇慎用。"}]},{"ID":"20240612161133-jk5wb0s","Type":"NodeParagraph","Properties":{"id":"20240612161133-jk5wb0s","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612161133-5zuhk9w","Type":"NodeParagraph","Properties":{"id":"20240612161133-5zuhk9w","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 清热泻火；化痰；软坚；明目。主大热烦渴；风热目赤涩痛；克山病；大骨节病；甲状腺肿；高血压；风湿性心脏病；慢性支气管炎；风湿性关节炎"}]},{"ID":"20240612161133-dpf0r2k","Type":"NodeParagraph","Properties":{"id":"20240612161133-dpf0r2k","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612161133-us4xivg","Type":"NodeParagraph","Properties":{"id":"20240612161133-us4xivg","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 内服：溶化为水，0.3-1钱。外用：制成膏剂涂搽；溶液点眼或洗涤。"}]},{"ID":"20240612161133-ec7gk5l","Type":"NodeParagraph","Properties":{"id":"20240612161133-ec7gk5l","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612161133-g3ppa4a","Type":"NodeParagraph","Properties":{"id":"20240612161133-g3ppa4a","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主大热、消渴、狂烦，除邪，柔肌肤。"}]},{"ID":"20240612161133-2rwqy5l","Type":"NodeParagraph","Properties":{"id":"20240612161133-2rwqy5l","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：去五脏肠胃留热结气，心下坚，食已呕逆，喘满，明目，目痛。"}]},{"ID":"20240612161133-288ck62","Type":"NodeParagraph","Properties":{"id":"20240612161133-288ck62","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"3.《吉林中草药》：强心，镇静，助消化，抗痉厥，消炎。治慢性克山病，甲状腺肿，大骨节病，慢性胃炎，慢性肾炎，肝炎，慢性支气管炎，高血压，皮炎，肿瘤。"}]},{"ID":"20240612161133-njrs0kg","Type":"NodeParagraph","Properties":{"id":"20240612161133-njrs0kg","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612161133-9v21hxk","Type":"NodeParagraph","Properties":{"id":"20240612161133-9v21hxk","updated":"20240612161133"},"Children":[{"Type":"NodeText","Data":" 《中华本草》《中药大辞典》"}]},{"ID":"20240612161135-cb4q65q","Type":"NodeThematicBreak","Properties":{"id":"20240612161135-cb4q65q"}},{"ID":"20240612161137-wft1owx","Type":"NodeParagraph","Properties":{"id":"20240612161137-wft1owx"}}]}