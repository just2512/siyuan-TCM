{"ID":"20240506100114-vj54alo","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100114-vj54alo","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100114-vj54alo\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506100114-zc6g40f\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240506100114-zc6g40f\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240506100114-zc6g40f\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"250粟米","type":"doc","updated":"20240821190848"},"Children":[{"ID":"20240627134001-5i8ab41","Type":"NodeParagraph","Properties":{"id":"20240627134001-5i8ab41","updated":"20240627134001"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 465px;","style":"width: 455px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粟米3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粟米3-20240627134001-xmzpbu4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 455px;\" parent-style=\"width: 465px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627133923-6tvinr6","Type":"NodeParagraph","Properties":{"id":"20240627133923-6tvinr6","updated":"20240627133923"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627133610-rpex75w.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240627141854-ngkfhhn","Type":"NodeParagraph","Properties":{"id":"20240627141854-ngkfhhn","updated":"20240627141855"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 647px;","style":"width: 637px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"黍米2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/黍米2-20240627135853-4ifyovq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 637px;\" parent-style=\"width: 647px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240726164732-b3fe399","Type":"NodeParagraph","Properties":{"id":"20240726164732-b3fe399","updated":"20240726164732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粟米 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粟米 3-20240726164449-4i2a87y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 877px;","style":"width: 867px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粟米 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粟米 2-20240726164358-7i9uk6a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 867px;\" parent-style=\"width: 877px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627133923-m95se2v","Type":"NodeParagraph","Properties":{"id":"20240627133923-m95se2v","updated":"20240821190837"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 645px;","style":"width: 635px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粟米"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粟米-20240726164022-fbo0sgt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 635px;\" parent-style=\"width: 645px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 633px;","style":"width: 623px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627133631-d86td6s.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 623px;\" parent-style=\"width: 633px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627133923-6g83ep8","Type":"NodeParagraph","Properties":{"id":"20240627133923-6g83ep8","updated":"20240821190848"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 643px;","style":"width: 633px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粟米 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粟米 1-20240726164147-ypiaf52.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 633px;\" parent-style=\"width: 643px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 601px;","style":"width: 591px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"粟米5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/粟米5-20240627134249-7d6d8vs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 591px;\" parent-style=\"width: 601px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627134636-gct1nj8","Type":"NodeParagraph","Properties":{"id":"20240627134636-gct1nj8","updated":"20240627134636"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：粟米和黍米虽然外观上都是鲜黄色的颗粒状米粒,但粟米的个头要比黍米更小一点。黍的种子表面以红褐色为多，也有少量为浅黄色；粟以浅黄色为主，均为黄色，粟颜色较浅。"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240612145851-xktugzb","Type":"NodeThematicBreak","Properties":{"id":"20240612145851-xktugzb"}},{"ID":"20240612145948-tc8m185","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145948-tc8m185","updated":"20240612145954"},"Children":[{"Type":"NodeText","Data":"粟米《神农本草经》"}]},{"ID":"20240612145948-o5yq94r","Type":"NodeParagraph","Properties":{"id":"20240612145948-o5yq94r","updated":"20240612145948"},"Children":[{"Type":"NodeText","Data":"味咸微寒。"}]},{"ID":"20240612145948-l6qcd3i","Type":"NodeParagraph","Properties":{"id":"20240612145948-l6qcd3i","updated":"20240612145948"},"Children":[{"Type":"NodeText","Data":"主养肾气，去胃脾中热，益气。陈者，味苦，主胃热，消渴，利小便（《大观本草》，作黑字，据《吴普》增）。"}]},{"ID":"20240612145948-886rk4p","Type":"NodeParagraph","Properties":{"id":"20240612145948-886rk4p","updated":"20240612145948"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：陈粟，神农黄帝苦无毒，治脾热，渴，粟养肾气（《御览》）。"}]},{"ID":"20240612145948-46y77b3","Type":"NodeParagraph","Properties":{"id":"20240612145948-46y77b3","updated":"20240612145948"},"Children":[{"Type":"NodeText","Data":"案《说文》云：粟、嘉谷实也。孙炎注《尔雅》粢稷云：粟也，今关中人呼小米为粟米，是。"}]},{"ID":"20240612150234-1nqiirw","Type":"NodeThematicBreak","Properties":{"id":"20240612150234-1nqiirw"}},{"ID":"20240612150235-eu80wo2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150235-eu80wo2","updated":"20240612150239"},"Children":[{"Type":"NodeText","Data":"粟《本草纲目》"}]},{"ID":"20240612150235-oc3u5zf","Type":"NodeParagraph","Properties":{"id":"20240612150235-oc3u5zf","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"「气味」粟米：咸、微寒、无毒"}]},{"ID":"20240612150235-qf7nscp","Type":"NodeParagraph","Properties":{"id":"20240612150235-qf7nscp","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612150235-pglejn9","Type":"NodeParagraph","Properties":{"id":"20240612150235-pglejn9","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"粟米："}]},{"ID":"20240612150235-9agojys","Type":"NodeParagraph","Properties":{"id":"20240612150235-9agojys","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"1、胃热消渴。用陈粟米煮饭吃。"}]},{"ID":"20240612150235-9vmy0k5","Type":"NodeParagraph","Properties":{"id":"20240612150235-9vmy0k5","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"2、反胃吐食（脾胃气弱，食不消化）。用粟米半升，捣成粉，加水做成丸子，如梧子大。取七枚煮熟，放一点盐，连汁穿梭心吞服，或加少许醋吞下。"}]},{"ID":"20240612150235-89yjpo7","Type":"NodeParagraph","Properties":{"id":"20240612150235-89yjpo7","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"3、鼻血不止。用粟米粉小煮服。"}]},{"ID":"20240612150235-to1q9np","Type":"NodeParagraph","Properties":{"id":"20240612150235-to1q9np","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"4、汤火伤。用粟米焦，投不中，澄取汁，浓煎如糖，频搽伤上，能止痛，灭瘢痕。又方：粟米，半生半炒，研为末，酒调敷伤处。"}]},{"ID":"20240612150235-cb6hg4i","Type":"NodeParagraph","Properties":{"id":"20240612150235-cb6hg4i","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"粟泔汁："}]},{"ID":"20240612150235-yp0oa22","Type":"NodeParagraph","Properties":{"id":"20240612150235-yp0oa22","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"1、眼热赤肿。用粟泔汁（淘粟水）发酸的沉淀，加生地黄等分，研匀摊于布上，方圆约二寸，贴目上熨热。药干即换。"}]},{"ID":"20240612150235-gsdvzpa","Type":"NodeParagraph","Properties":{"id":"20240612150235-gsdvzpa","updated":"20240612150235"},"Children":[{"Type":"NodeText","Data":"2、疳疮月蚀。用粟泔汁沉淀敷涂。"}]},{"ID":"20240612150245-kjvfyfg","Type":"NodeThematicBreak","Properties":{"id":"20240612150245-kjvfyfg"}},{"ID":"20240612150246-6svvnph","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150246-6svvnph","updated":"20240612150250"},"Children":[{"Type":"NodeText","Data":"粟米《药性切用》"}]},{"ID":"20240612150246-c3gc5uq","Type":"NodeParagraph","Properties":{"id":"20240612150246-c3gc5uq","updated":"20240612150246"},"Children":[{"Type":"NodeText","Data":"即小米。咸淡微凉，补虚益损，开胃利溲。粱之细者为粟。"}]},{"ID":"20240612150309-9utnd7w","Type":"NodeThematicBreak","Properties":{"id":"20240612150309-9utnd7w"}},{"ID":"20240612150310-n2gorw9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150310-n2gorw9","updated":"20240612150317"},"Children":[{"Type":"NodeText","Data":"粟米《滇南本草》"}]},{"ID":"20240612150310-4q6yj7t","Type":"NodeParagraph","Properties":{"id":"20240612150310-4q6yj7t","updated":"20240612150313"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"粟米"},{"Type":"NodeText","Data":"，味咸，微寒。主滋阴、养肾气、健脾胃、暖中，反胃服之如神。"}]},{"ID":"20240612150310-x2dfor1","Type":"NodeParagraph","Properties":{"id":"20240612150310-x2dfor1","updated":"20240612150310"},"Children":[{"Type":"NodeText","Data":"治小儿肝虫或霍乱吐泻，肚疼变痢疾或水泻不止，服之即效。用草连根，治转食冷吐。"}]},{"ID":"20240612150310-ef9rtje","Type":"NodeParagraph","Properties":{"id":"20240612150310-ef9rtje","updated":"20240612150310"},"Children":[{"Type":"NodeText","Data":"青粱米，味甘，性微寒。无毒。主治补中益气，治胃痹热中、消渴，止泻痢、滑精，久食可辟谷长年。"}]},{"ID":"20240612150310-zxfpm28","Type":"NodeParagraph","Properties":{"id":"20240612150310-zxfpm28","updated":"20240612150310"},"Children":[{"Type":"NodeText","Data":"黄粱米，气味甘，性微寒。无毒。和中、止霍乱泻痢、除热烦、利小便、祛风、解表，久服延年。"}]},{"ID":"20240612150258-y3wkrzg","Type":"NodeThematicBreak","Properties":{"id":"20240612150258-y3wkrzg"}},{"ID":"20240612150259-1veqyvh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150259-1veqyvh","updated":"20240612150304"},"Children":[{"Type":"NodeText","Data":"粟米《本草衍义》"}]},{"ID":"20240612150259-y7kifq7","Type":"NodeParagraph","Properties":{"id":"20240612150259-y7kifq7","updated":"20240612150259"},"Children":[{"Type":"NodeText","Data":"利小便，故益脾胃。"}]},{"ID":"20240612145959-v3th2mx","Type":"NodeThematicBreak","Properties":{"id":"20240612145959-v3th2mx"}},{"ID":"20240612150000-a33pl3v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150000-a33pl3v","updated":"20240612150004"},"Children":[{"Type":"NodeText","Data":"粟米《名医别录》"}]},{"ID":"20240612150000-b4wsz66","Type":"NodeParagraph","Properties":{"id":"20240612150000-b4wsz66","updated":"20240612150000"},"Children":[{"Type":"NodeText","Data":"味咸，微寒，无毒．主养肾气，去胃脾中热，益气．陈者，味苦，主治胃热、消渴，小便．"}]},{"ID":"20240612145851-dw3viou","Type":"NodeThematicBreak","Properties":{"id":"20240612145851-dw3viou"}},{"ID":"20240612150009-hx4y6wj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150009-hx4y6wj","updated":"20240612150015"},"Children":[{"Type":"NodeText","Data":"粟米《本草求真》"}]},{"ID":"20240612150009-fmpn67l","Type":"NodeParagraph","Properties":{"id":"20240612150009-fmpn67l","updated":"20240612150009"},"Children":[{"Type":"NodeText","Data":"（稷粟）养肾气消胃热"}]},{"ID":"20240612150009-ooo1699","Type":"NodeParagraph","Properties":{"id":"20240612150009-ooo1699","updated":"20240612150009"},"Children":[{"Type":"NodeText","Data":"粟米（专入肾。兼入脾胃）。味咸气寒。（时珍曰。粟即粱也。穗大而毛长粒粗者为粱。穗小而毛短粒细者为粟。苗俱似芽。种类甚多。）功专入肾养气。及消胃热。凡人病因肾邪。而见小便不利。消渴泄痢。与脾胃虚热。而见反胃吐食。鼻衄不止者。须当用此调治。以寒能疗热。咸能入肾。淡能。粟为谷类。谷又能养脾胃故也。（千金方粟米粉丸。纳七粒。治反胃吐食。）但此生者硬而难化。（得浆水即化。）熟者滞而难消。故书言此雁食则有足重难飞之虞。与杏仁同食则有吐泻之虑。不可不熟悉而明辨也。陈者良。"}]},{"ID":"20240612150009-u89fh8l","Type":"NodeThematicBreak","Properties":{"id":"20240612150009-u89fh8l"}},{"ID":"20240612150046-phl0eii","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150046-phl0eii","updated":"20240612150053"},"Children":[{"Type":"NodeText","Data":"粟米《千金翼方》"}]},{"ID":"20240612150046-dxe2cbs","Type":"NodeParagraph","Properties":{"id":"20240612150046-dxe2cbs","updated":"20240612150046"},"Children":[{"Type":"NodeText","Data":"味咸，微寒，无毒。主养肾气，去胃脾中热，益气。陈者∶味苦，主胃热，消渴，利小便。"}]},{"ID":"20240612150125-6erttt2","Type":"NodeThematicBreak","Properties":{"id":"20240612150125-6erttt2"}},{"ID":"20240612150126-mvw020o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150126-mvw020o","updated":"20240612150130"},"Children":[{"Type":"NodeText","Data":"粟米《神农本草经赞》"}]},{"ID":"20240612150126-ocztw8t","Type":"NodeParagraph","Properties":{"id":"20240612150126-ocztw8t","updated":"20240612150126"},"Children":[{"Type":"NodeText","Data":"味咸微寒。主养肾气。去胃脾中热。益气。陈者味苦。主胃热消渴。利小便。"}]},{"ID":"20240612150126-rwjggfv","Type":"NodeParagraph","Properties":{"id":"20240612150126-rwjggfv","updated":"20240612150126"},"Children":[{"Type":"NodeText","Data":"比德阳精。粱甘谷续。冠凤游龙。升金斗玉。天雨书成。地藏兵足。一穗三千。新田绥福。"}]},{"ID":"20240612150126-qdu6baz","Type":"NodeParagraph","Properties":{"id":"20240612150126-qdu6baz","updated":"20240612150126"},"Children":[{"Type":"NodeText","Data":"管子。粟可以比君子之德。春秋说题辞。米者阳精。李时珍曰。粱即粟也。周礼疏。犬宜粱者。味甘而微寒。说文。粟之为言续也。续于谷也。拾遗记。背明国有凤冠粟。游龙粟。闽志。唐时泉人客洛阳为羽衣。寄书遗以粟米半升。还家视之。金粟也。李白诗。虽有数斗玉。不如一盘粟。淮南子。仓颉作书而天雨粟。周礼注。九谷俱藏。以粟为主。神农之教曰。"}]},{"ID":"20240612150126-eley56z","Type":"NodeParagraph","Properties":{"id":"20240612150126-eley56z","updated":"20240612150126"},"Children":[{"Type":"NodeText","Data":"带甲百万。无粟弗能守也。北方水土深浓。窖地而藏。群芳谱。谚云谷三千。一穗之实。至三千颗。言多也。易林。新田宜粟。以绥百福。"}]},{"ID":"20240612150112-5nl0cx5","Type":"NodeThematicBreak","Properties":{"id":"20240612150112-5nl0cx5"}},{"ID":"20240612150113-z0yxmgc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150113-z0yxmgc","updated":"20240612150118"},"Children":[{"Type":"NodeText","Data":"粟米《冯氏锦囊秘录》"}]},{"ID":"20240612150113-hte7paf","Type":"NodeParagraph","Properties":{"id":"20240612150113-hte7paf","updated":"20240612150113"},"Children":[{"Type":"NodeText","Data":"粟米即北地小米。属水与土，养肾调脾，须分新陈。新粟米，养肾气不亏，去脾热常益中脘。"}]},{"ID":"20240612150113-6rzg7ou","Type":"NodeParagraph","Properties":{"id":"20240612150113-6rzg7ou","updated":"20240612150113"},"Children":[{"Type":"NodeText","Data":"陈粟米，止泄痢，分渗却胃热，大解渴消。秫米，即小米之糯者。解寒热，利肠胃，杀疥毒，疗漆疮，煮粥炊饮最粘，捣饧造酒极妙。但动风壅气，不宜多食。一黍米，甘温肺家谷也。性最粘滞，同秫米，能捣饧造酒，益气补中。但食多令人多热，昏五脏贪眠，食久缓筋骨。小儿食，足难健步。猫犬食，脚忽偏邪。稷米，甘寒，亦宜脾胃，益气补不足，多食发冷病。相类又有三米，青粱、白粱、黄粱。粒比粟大，调胃和脾，益中止泄，力倍诸谷，青白略次，而黄独优，盖得中和之正气，古称膏粱之家，缘食美而养浓也。其甚益脾养胃者，无过粳与粟也，故南人食粳，北人食粟，虽地方种时相宜，实亦本于此也。"}]},{"ID":"20240612150205-tpjnwhk","Type":"NodeThematicBreak","Properties":{"id":"20240612150205-tpjnwhk"}},{"ID":"20240612150206-4ggra56","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150206-4ggra56","updated":"20240612150211"},"Children":[{"Type":"NodeText","Data":"粟米《冯氏锦囊秘录》"}]},{"ID":"20240612150206-wzgn6ce","Type":"NodeParagraph","Properties":{"id":"20240612150206-wzgn6ce","updated":"20240612150206"},"Children":[{"Type":"NodeText","Data":"粟米即北地小米。属水与土，养肾调脾，须分新陈。新粟米，养肾气不亏，去脾热常益中脘。"}]},{"ID":"20240612150206-2ozb0nq","Type":"NodeParagraph","Properties":{"id":"20240612150206-2ozb0nq","updated":"20240612150206"},"Children":[{"Type":"NodeText","Data":"陈粟米，止泄痢，分渗却胃热，大解渴消。秫米，即小米之糯者。解寒热，利肠胃，杀疥毒，疗漆疮，煮粥炊饮最粘，捣饧造酒极妙。但动风壅气，不宜多食。一黍米，甘温肺家谷也。性最粘滞，同秫米，能捣饧造酒，益气补中。但食多令人多热，昏五脏贪眠，食久缓筋骨。小儿食，足难健步。猫犬食，脚忽偏邪。稷米，甘寒，亦宜脾胃，益气补不足，多食发冷病。相类又有三米，青粱、白粱、黄粱。粒比粟大，调胃和脾，益中止泄，力倍诸谷，青白略次，而黄独优，盖得中和之正气，古称膏粱之家，缘食美而养浓也。其甚益脾养胃者，无过粳与粟也，故南人食粳，北人食粟，虽地方种时相宜，实亦本于此也。"}]},{"ID":"20240612150058-lvrq9w0","Type":"NodeThematicBreak","Properties":{"id":"20240612150058-lvrq9w0"}},{"ID":"20240612150059-r70lknx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150059-r70lknx","updated":"20240612150158"},"Children":[{"Type":"NodeText","Data":"粟米《本草易读》"}]},{"ID":"20240612150059-m6iwns4","Type":"NodeParagraph","Properties":{"id":"20240612150059-m6iwns4","updated":"20240612150059"},"Children":[{"Type":"NodeText","Data":"甘，平，无毒。行风气而逐邪热，治反胃而开胸疾。甚止泻痢，尤润燥枯。"}]},{"ID":"20240612150046-xxkn5et","Type":"NodeThematicBreak","Properties":{"id":"20240612150046-xxkn5et"}},{"ID":"20240612150033-gggzg7y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150033-gggzg7y","updated":"20240612150038"},"Children":[{"Type":"NodeText","Data":"粟米《新修本草》"}]},{"ID":"20240612150033-my61up5","Type":"NodeParagraph","Properties":{"id":"20240612150033-my61up5","updated":"20240612150033"},"Children":[{"Type":"NodeText","Data":"味咸，微寒，无毒。主养肾气，去胃痹，中热，益气；陈者，味苦，主胃热，消渴，利小便。"}]},{"ID":"20240612150033-bk6312a","Type":"NodeParagraph","Properties":{"id":"20240612150033-bk6312a","updated":"20240612150033"},"Children":[{"Type":"NodeText","Data":"江东所种及西间皆是，其粒细于粱米，熟舂令白，亦以当白粱，呼为白粱粟。陈者谓经三、五年者，或呼为粢米，以作粉，尤解烦闷，服食家亦将食之。"}]},{"ID":"20240612150033-rzw05ma","Type":"NodeParagraph","Properties":{"id":"20240612150033-rzw05ma","updated":"20240612150033"},"Children":[{"Type":"NodeText","Data":"〔谨案〕粟有多种，而并细于诸粱，北土恒食，与粱有别。"}]},{"ID":"20240612150033-wu790ve","Type":"NodeParagraph","Properties":{"id":"20240612150033-wu790ve","updated":"20240612150033"},"Children":[{"Type":"NodeText","Data":"陶云∶当白粱，又云或呼为粢，粢则是稷，稷乃 之异名也。其米泔汁，主霍乱，猝热，心烦渴，饮数升立瘥。臭泔，止消渴优良。"}]},{"ID":"20240612150033-61nu1o2","Type":"NodeThematicBreak","Properties":{"id":"20240612150033-61nu1o2"}},{"ID":"20240612150021-bgplphk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150021-bgplphk","updated":"20240612150027"},"Children":[{"Type":"NodeText","Data":"粟米《医学入门》"}]},{"ID":"20240612150021-mnuza15","Type":"NodeParagraph","Properties":{"id":"20240612150021-mnuza15","updated":"20240612150021"},"Children":[{"Type":"NodeText","Data":"粟米咸寒养肾气，胃虚呕吐作为丸，若除胃热须陈者，更治消中利小便。"}]},{"ID":"20240612150021-0hli7c3","Type":"NodeParagraph","Properties":{"id":"20240612150021-0hli7c3","updated":"20240612150021"},"Children":[{"Type":"NodeText","Data":"粟，从卤，从米，象形也。即今之小米，山东最多。五谷中最硬，谓之硬粟，得浆水即易化。无毒。丹溪云∶属水与土，陈者难化。《衍义》云∶生者难化，熟者滞气，隔食生虫。所谓养肾补骨者，味咸故也。去脾胃虚热气弱，食不消化，呕逆反胃，汤饮不下，用粟米粉作丸梧子大，煮熟入盐少许，并汁食之，和中益气；兼治腹痛，鼻衄，解诸毒。陈者味苦，除胃热消渴，利小便，止泄痢，压丹石热。《衍义》云∶利小便，故益脾胃。又粟粉炒黑，鸡子白调贴痈肿。泔汁，主霍乱转筋，卒热心烦，饮之立瘥，胃冷者不宜多食。臭疳，止消渴、五痔、疳痢，洗皮肤疮疥。下淀酸脚，杀虫涂恶疮。"}]},{"ID":"20240612150021-33dm2v4","Type":"NodeThematicBreak","Properties":{"id":"20240612150021-33dm2v4"}},{"ID":"20240612145937-cmpqmtq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145937-cmpqmtq","updated":"20240612145942"},"Children":[{"Type":"NodeText","Data":"粟米《证类本草》"}]},{"ID":"20240612145937-x46wu8a","Type":"NodeParagraph","Properties":{"id":"20240612145937-x46wu8a","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"味咸，微寒，无毒。主养肾气，去胃脾中热，益气。陈者味苦，主胃热，消渴，利小便。"}]},{"ID":"20240612145937-lgfyzq0","Type":"NodeParagraph","Properties":{"id":"20240612145937-lgfyzq0","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶江东所种及西间皆是，其粒细于粱米，熟舂令白，亦以当白粱呼为白粱粟。"}]},{"ID":"20240612145937-pycjp7s","Type":"NodeParagraph","Properties":{"id":"20240612145937-pycjp7s","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"陈者谓经三、五年者，或呼为粢（音咨）米，以作粉尤解烦闷，服食家亦将食之。唐本注云∶粟类多种，而并细于诸粱，北土常食，与粱有别。陶云当白粱，又云或呼为粢，粢则是稷，稷乃（音祭）之异名也。其米泔汁，主霍乱，卒热，心烦渴，饮数升立瘥。臭泔，止消渴尤良。"}]},{"ID":"20240612145937-3dpd4st","Type":"NodeParagraph","Properties":{"id":"20240612145937-3dpd4st","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"米麦 ，味甘、苦，寒，无毒。主寒中，除热渴，解烦，硝石气。蒸米麦熬磨作之，一名糗也。臣禹锡等谨按孟诜云∶粟米，陈者止痢，甚压丹石热。颗粒小者是。今人间多不识耳。粱米粒粗大，随色别之。南方∶多 田，种之极易。舂粒细，香美，少虚怯，只为灰中种之种之，若不锄之，即草翳死；若锄之，即难舂。都由土地使然耳。但熟犁。又细锄，即得滑实。"}]},{"ID":"20240612145937-anp9zsb","Type":"NodeParagraph","Properties":{"id":"20240612145937-anp9zsb","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶粉解诸毒，主卒得鬼打，水搅服之。亦主热腹痛，鼻衄，并水煮服之。粳粟总堪为粉，粟强浸米至败者损人。又云泔，主霍乱，新研米清水和滤取汁服，亦主转筋入腹。胃冷者不宜多食。酸泔，洗皮肤疮疥，服主五野病及消渴。下淀酸者，杀虫及恶疮，和臭樗皮煎服，主疳痢。樗皮一名武目树。又云糗，一名KT （昌少切），味酸，寒。和水服之，解烦热，止泄，实大肠，压石热，止渴。河东人以麦为之，粗者为干糗粮，东人以粳米为之，炒干磨成也。陈士良云∶粳粟米，五谷中最硬，得浆水即易化解。小麦虚热。"}]},{"ID":"20240612145937-xl3a36h","Type":"NodeParagraph","Properties":{"id":"20240612145937-xl3a36h","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"图经文具青粱米条下。"}]},{"ID":"20240612145937-xkeb5c4","Type":"NodeParagraph","Properties":{"id":"20240612145937-xkeb5c4","updated":"20240612145937"},"Children":[{"Type":"NodeText","Data":"千金方∶治反胃，食即吐。捣粟米作粉，和水丸如梧桐子大。七枚烂煮纳醋中，细吞之，得下便已。面亦得用之。良医心镜∶主脾胃气弱，食不消化，呕逆反胃，汤饮不下。粟米半升杵煮令熟，点少盐，空心和汁吞下。又方∶主消渴口干，粟米炊饭食之，良。又方∶主胃中热，消渴，利小便，以陈粟米炊饭食。兵部手集∶治孩子赤丹不止，初生七日，助谷神以导达肠胃。研粟米煮粥饮，浓薄如乳，每日研与小儿重舌，用粟哺之。产宝方∶粢米粉熬令黑。以鸡子白和如泥，以涂帛上贴之，帛作穴，以泄痈毒瓦斯，易之，效。博物志云∶雁食，足重不能飞。丹房镜源云∶衍义曰∶粟米，利小便，故益脾胃。"}]},{"ID":"20240612150221-bezudgy","Type":"NodeThematicBreak","Properties":{"id":"20240612150221-bezudgy"}},{"ID":"20240612150222-ptwykuh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150222-ptwykuh","updated":"20240612150226"},"Children":[{"Type":"NodeText","Data":"粟《本草述钩元》"}]},{"ID":"20240612150222-x4sbuev","Type":"NodeParagraph","Properties":{"id":"20240612150222-x4sbuev","updated":"20240612150222"},"Children":[{"Type":"NodeText","Data":"古者粟为黍稷粱秫之总称。今之粟。古时但呼为粱。后人又专以粱之细者名粟。（粟即粱也。穗大而毛长粒粗者。为粱。穗小而毛短粒细者。为粟。（又）粟米即小米。味咸而淡。气微寒。主养肾气。去脾胃中热。治反胃益气。益丹田。补虚损。"}]},{"ID":"20240612150222-x9f1mzg","Type":"NodeParagraph","Properties":{"id":"20240612150222-x9f1mzg","updated":"20240612150222"},"Children":[{"Type":"NodeText","Data":"难化降胃火消化。汤饮不下。用粟米半升。杵粉水丸。梧子大七枚。煮熟。入少盐云。纳醋中吞之。得下便已。〔论〕粟之味咸而淡。在诸谷中。有水土合德之义。内经言脾宜食咸。盖谓脾合于肾之阴。"}]},{"ID":"20240612150222-f3vqq8c","Type":"NodeParagraph","Properties":{"id":"20240612150222-f3vqq8c","updated":"20240612150222"},"Children":[{"Type":"NodeText","Data":"由胃以归于肾乎。所云能养肾为胜。以其赋有阳气。则淡渗胃冷者。不宜多食。（藏器）"}]},{"ID":"20240612145851-ir3f80q","Type":"NodeThematicBreak","Properties":{"id":"20240612145851-ir3f80q"}},{"ID":"20240612145852-7aj5vs2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145852-7aj5vs2","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：粟米"}]},{"ID":"20240612145852-6jodhbn","Type":"NodeParagraph","Properties":{"id":"20240612145852-6jodhbn","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145852-mwfvm9j","Type":"NodeParagraph","Properties":{"id":"20240612145852-mwfvm9j","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" Sù Mǐ"}]},{"ID":"20240612145852-zr64iqx","Type":"NodeParagraph","Properties":{"id":"20240612145852-zr64iqx","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145852-3msis1b","Type":"NodeParagraph","Properties":{"id":"20240612145852-3msis1b","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 白梁粟、粢米（陶弘景），粟谷（《齐民要术》），小米（《本草蒙筌》），硬粟（《医学入门》），籼粟（《纲目》），谷子、寒粟（《植物名实图考》），黄粟（《陆川本草》），稞子（《滇南本草》整理本）。"}]},{"ID":"20240612145852-m21d30p","Type":"NodeParagraph","Properties":{"id":"20240612145852-m21d30p","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612145852-xjluc9k","Type":"NodeParagraph","Properties":{"id":"20240612145852-xjluc9k","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 《别录》"}]},{"ID":"20240612145852-0k7hbvv","Type":"NodeParagraph","Properties":{"id":"20240612145852-0k7hbvv","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145852-3tibi60","Type":"NodeParagraph","Properties":{"id":"20240612145852-3tibi60","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 为禾本科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"粟"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"种仁"},{"Type":"NodeText","Data":"。其储存陈久者名陈粟米。"}]},{"ID":"20240612145852-nue5yln","Type":"NodeParagraph","Properties":{"id":"20240612145852-nue5yln","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612145852-06a3bxm","Type":"NodeParagraph","Properties":{"id":"20240612145852-06a3bxm","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 我国北方广为栽培。"}]},{"ID":"20240612145852-vjh693w","Type":"NodeParagraph","Properties":{"id":"20240612145852-vjh693w","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612145852-n7dbf3b","Type":"NodeParagraph","Properties":{"id":"20240612145852-n7dbf3b","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 粟（《尚书》）"}]},{"ID":"20240612145852-sczqppr","Type":"NodeParagraph","Properties":{"id":"20240612145852-sczqppr","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"一年生草本，高60～150厘米。秆直立，粗壮。叶片披针形或线状披针形，长约25～60厘米，宽2～3厘米，先端尖长，基部近圆形，下面较秃净，上面粗糙；叶鞘无毛，鞘口处有柔毛；叶舌长1.5～5毫米，具纤毛。顶生圆锥花序穗状，通常下垂，长约20～30厘米，径2～5厘米，穗轴密被细毛；小穗椭圆形，长约3毫米，基部有刚毛1～3条，刚毛通常褐色或浅紫色，稀有绿色，其长约小穗的2～3倍；第一卵形，长约为小穗的1/3，3脉；第二颖椭圆形，与不孕小花的外稃等长，5～7脉；不孕小花的外稃椭圆形，结实小花的外稃平凸状椭圆形，长2.5毫米，3脉，表面有皱纹，边缘内卷，包着内稃。谷粒与第一外稃等长，卵状或圆球状，具细点状皱纹，成熟后与其他小穗部分脱离。花期夏、秋季。"}]},{"ID":"20240612145852-d7tedq9","Type":"NodeParagraph","Properties":{"id":"20240612145852-d7tedq9","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"本植物发芽的颗果（粟芽）、种子的加工品（粟糖）亦供药用，各详专条。"}]},{"ID":"20240612145852-i6lerc4","Type":"NodeParagraph","Properties":{"id":"20240612145852-i6lerc4","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"栽培植物中的粱，与粟为同种。李时珍谓：\"粱即粟也，大而毛长者为梁，细而毛短者为粟。\"参见\"青粱米\"、\"黄檗米\"、\"白梁米\"各条。"}]},{"ID":"20240612145852-u009h8j","Type":"NodeParagraph","Properties":{"id":"20240612145852-u009h8j","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612145852-w99esrh","Type":"NodeParagraph","Properties":{"id":"20240612145852-w99esrh","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 脱壳种子和带壳种子的干品分别含脂肪1.41、1.68％，总氮2.48％、2.79％，蛋白氮2.41、2.72％，灰分3.15、1.85％，淀粉63.27、77.58％，还原糖2.03、1.98％。另有谓种子含油3％；油中含不皂化物2.39％，固体脂肪酸15.05％，液体脂肪酸70.03％。蛋白质有谷蛋白、醇溶蛋白、球蛋白等多类。种子蛋白质含多量谷氨酸、脯氨酸、丙氨酸和蛋氨酸。"}]},{"ID":"20240612145852-hkzei49","Type":"NodeParagraph","Properties":{"id":"20240612145852-hkzei49","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"此外，新鲜植物并含β-丙氨酸和γ-丁氨酸，少量β-胡萝卜素、叶黄素。茎含白瑞香甙类，有毒。"}]},{"ID":"20240612145852-2nj9pef","Type":"NodeParagraph","Properties":{"id":"20240612145852-2nj9pef","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612145852-3t2gvd0","Type":"NodeParagraph","Properties":{"id":"20240612145852-3t2gvd0","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 白瑞香甙的作用参见\"瑞香花\"条。其甙元有抗菌作用，1：10000能抑制金黄色葡萄球菌（青霉素耐药株），1：5000能抑制葡萄球菌及大肠杆菌，1：2000抑制绿脓杆菌，但对枯草杆菌无效。"}]},{"ID":"20240612145852-z31bbh6","Type":"NodeParagraph","Properties":{"id":"20240612145852-z31bbh6","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145852-cgtadpc","Type":"NodeParagraph","Properties":{"id":"20240612145852-cgtadpc","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" ①《本草求真》：\"专入肾，兼入脾、胃。\""}]},{"ID":"20240612145852-364dpmr","Type":"NodeParagraph","Properties":{"id":"20240612145852-364dpmr","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"入手足太阴、少阴经。\""}]},{"ID":"20240612145852-ofqs1oi","Type":"NodeParagraph","Properties":{"id":"20240612145852-ofqs1oi","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145852-ge4n24p","Type":"NodeParagraph","Properties":{"id":"20240612145852-ge4n24p","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 甘咸，凉。陈粟米：苦，寒。"}]},{"ID":"20240612145852-8rr9zre","Type":"NodeParagraph","Properties":{"id":"20240612145852-8rr9zre","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"味咸，微寒，无毒。陈粟米：味苦。\""}]},{"ID":"20240612145852-rsavl15","Type":"NodeParagraph","Properties":{"id":"20240612145852-rsavl15","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"②《本草衍义》：\"陈粟米：性冷。\""}]},{"ID":"20240612145852-vh96tfv","Type":"NodeParagraph","Properties":{"id":"20240612145852-vh96tfv","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"③《纲目》：\"咸淡。\""}]},{"ID":"20240612145852-ks4g613","Type":"NodeParagraph","Properties":{"id":"20240612145852-ks4g613","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"④《本草备要》：\"甘咸，微寒。\""}]},{"ID":"20240612145852-2a95voa","Type":"NodeParagraph","Properties":{"id":"20240612145852-2a95voa","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"⑤《陆川本草》：\"甘，平。\""}]},{"ID":"20240612145852-zkc0axa","Type":"NodeParagraph","Properties":{"id":"20240612145852-zkc0axa","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612145852-1ps7e1f","Type":"NodeParagraph","Properties":{"id":"20240612145852-1ps7e1f","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 《日用本草》：\"与杏仁同食，令人吐泻。\""}]},{"ID":"20240612145852-2hp2xcn","Type":"NodeParagraph","Properties":{"id":"20240612145852-2hp2xcn","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145852-k4w1yao","Type":"NodeParagraph","Properties":{"id":"20240612145852-k4w1yao","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 和中，益肾，除热，解毒。治脾胃虚热，反胃呕吐，消渴，泄泻。陈粟米：止痢，解烦闷。"}]},{"ID":"20240612145852-mcrv836","Type":"NodeParagraph","Properties":{"id":"20240612145852-mcrv836","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"①《别录》：\"主养肾气，去胃脾中热，益气。陈粟米：主胃热，消渴，利小便。\""}]},{"ID":"20240612145852-182273g","Type":"NodeParagraph","Properties":{"id":"20240612145852-182273g","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"②陶弘景：\"陈粟米：作粉尤解烦闷。\""}]},{"ID":"20240612145852-pderlgy","Type":"NodeParagraph","Properties":{"id":"20240612145852-pderlgy","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"③孟诜：\"陈粟米：止痢。\""}]},{"ID":"20240612145852-30bcsiu","Type":"NodeParagraph","Properties":{"id":"20240612145852-30bcsiu","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"粟米粉解诸毒，水搅服之；亦主热腹痛，鼻衄，并水煮服之。\""}]},{"ID":"20240612145852-46kpg5u","Type":"NodeParagraph","Properties":{"id":"20240612145852-46kpg5u","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"⑤《日用本草》：\"和中益气，止痢，治消渴，利小便，陈者更良。\""}]},{"ID":"20240612145852-vs31rj8","Type":"NodeParagraph","Properties":{"id":"20240612145852-vs31rj8","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"主滋阴，养肾气，健脾胃，暖中。治反胃，小儿肝虫，或霍乱吐泻，肚疼痢疾，水泻不止。\""}]},{"ID":"20240612145852-u63vru4","Type":"NodeParagraph","Properties":{"id":"20240612145852-u63vru4","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"⑦《纲目》：\"煮粥食益丹田，补虚损，开肠胃。\""}]},{"ID":"20240612145852-2sezvy0","Type":"NodeParagraph","Properties":{"id":"20240612145852-2sezvy0","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145852-xut69kg","Type":"NodeParagraph","Properties":{"id":"20240612145852-xut69kg","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.5～1两；或煮粥。外用：研末撒或熬汁涂。"}]},{"ID":"20240612145852-ykimcnn","Type":"NodeParagraph","Properties":{"id":"20240612145852-ykimcnn","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612145852-vkch3dg","Type":"NodeParagraph","Properties":{"id":"20240612145852-vkch3dg","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" ①治脾胃气弱，食不消化，呕逆反胃，汤饮不下：粟米半升，杵如粉，水和丸如梧子，煮令熟，点少盐，空心和汁吞下。（《食医心镜》）"}]},{"ID":"20240612145852-1hckrbp","Type":"NodeParagraph","Properties":{"id":"20240612145852-1hckrbp","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"②治消渴口干：粟米炊饭，食之良。（《食医心镜》）"}]},{"ID":"20240612145852-k0h63xa","Type":"NodeParagraph","Properties":{"id":"20240612145852-k0h63xa","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"③治孩子赤丹不止：研粟米敷之。（《兵部手集方》）"}]},{"ID":"20240612145852-uxbow11","Type":"NodeParagraph","Properties":{"id":"20240612145852-uxbow11","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"④治汤火灼伤：粟米炒焦，投水，澄取汁，煎稠如糖，频涂之。能止痛，灭瘢痕。一方半生半炒，研末，酒调敷之。（《崔氏纂要方》）"}]},{"ID":"20240612145852-dcdz6sl","Type":"NodeParagraph","Properties":{"id":"20240612145852-dcdz6sl","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612145852-0d5t4e3","Type":"NodeParagraph","Properties":{"id":"20240612145852-0d5t4e3","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义补遗》：\"粟，陈者难化。《衍义》云，生者难化，熟者滞气，隔食生虫。所谓补肾者，以其味咸之故也。\""}]},{"ID":"20240612145852-314uxsy","Type":"NodeParagraph","Properties":{"id":"20240612145852-314uxsy","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"粟之味咸淡，气寒下渗，肾之谷也。肾病宜食之，虚热消渴泄痢，皆肾病也，渗利小便，所以泄肾邪也。降胃火，故脾胃之病宜食之。\"\"按罗天益《宝鉴》云，粳粟米粥，气薄味淡，阳中之阴也，所以淡渗下行，利小便。韩愗《医通》云：一人病淋，素不服药，予教以专啖粟米粥，绝他味，旬余减，月余痊，此五谷治病之理。\""}]},{"ID":"20240612145852-v8qqp6v","Type":"NodeParagraph","Properties":{"id":"20240612145852-v8qqp6v","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145852-refqwg6","Type":"NodeParagraph","Properties":{"id":"20240612145852-refqwg6","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612145852-p5fj978","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145852-p5fj978","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"《中华本草》：粟米"}]},{"ID":"20240612145852-5kt4k20","Type":"NodeParagraph","Properties":{"id":"20240612145852-5kt4k20","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145852-v90upx9","Type":"NodeParagraph","Properties":{"id":"20240612145852-v90upx9","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" Sù Mǐ"}]},{"ID":"20240612145852-p1193fq","Type":"NodeParagraph","Properties":{"id":"20240612145852-p1193fq","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145852-g4fmtcr","Type":"NodeParagraph","Properties":{"id":"20240612145852-g4fmtcr","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 白粱粟、粢米、粟谷、小米、硬粟、籼粟、谷子、寒粟、黄粟、稞子"}]},{"ID":"20240612145852-w87fkbj","Type":"NodeParagraph","Properties":{"id":"20240612145852-w87fkbj","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612145852-9vtvzyt","Type":"NodeParagraph","Properties":{"id":"20240612145852-9vtvzyt","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" Millet"}]},{"ID":"20240612145852-ylqbx93","Type":"NodeParagraph","Properties":{"id":"20240612145852-ylqbx93","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612145852-4ec2hp0","Type":"NodeParagraph","Properties":{"id":"20240612145852-4ec2hp0","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 出自《名医别录》。"}]},{"ID":"20240612145852-kw55qhz","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612145852-kw55qhz","updated":"20240612145852"},"Children":[{"ID":"20240612145852-abjmqfq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612145852-abjmqfq","updated":"20240612145852"},"Children":[{"ID":"20240612145852-zfrs3b6","Type":"NodeParagraph","Properties":{"id":"20240612145852-zfrs3b6","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"陶弘景：粟米，江东所种及西间皆是，其粒细于粱米，熟舂令白，亦以当白梁，呼为白梁粟。 或呼为粢米。"}]}]}]},{"ID":"20240612145852-nv134p6","Type":"NodeParagraph","Properties":{"id":"20240612145852-nv134p6","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：粟有多种，而并细于诸梁。北土常食，与梁有别。陶云当白粱，又云或呼为粢。粢则是稷，稷乃之异名也。"}]},{"ID":"20240612145852-rkvam9g","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612145852-rkvam9g","updated":"20240612145852"},"Children":[{"ID":"20240612145852-yzren85","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240612145852-yzren85","updated":"20240612145852"},"Children":[{"ID":"20240612145852-1p985rc","Type":"NodeParagraph","Properties":{"id":"20240612145852-1p985rc","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"孟诜：粟，颗粒小者是，今人间多不识耳。其梁米粒粗大，随色别之。 陈粟米：止痢，解烦闷。"}]}]}]},{"ID":"20240612145852-dt3qflx","Type":"NodeParagraph","Properties":{"id":"20240612145852-dt3qflx","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145852-senu4hk","Type":"NodeParagraph","Properties":{"id":"20240612145852-senu4hk","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 药材基源：为禾本科植物粱或粟的种仁。其储存陈久者名陈粟米、粢。"}]},{"ID":"20240612145852-2xue8pk","Type":"NodeParagraph","Properties":{"id":"20240612145852-2xue8pk","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Setaria italica (L.) Beauv. [Panicum italicum L.]2.Setaria italica (L.) Beauv.var.germanica(Mill.)Schred"}]},{"ID":"20240612145852-mxgi1de","Type":"NodeParagraph","Properties":{"id":"20240612145852-mxgi1de","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612145852-6q3kkcu","Type":"NodeParagraph","Properties":{"id":"20240612145852-6q3kkcu","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 我国南北各地均有栽培。"}]},{"ID":"20240612145852-rw0mact","Type":"NodeParagraph","Properties":{"id":"20240612145852-rw0mact","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612145852-jyn2t2l","Type":"NodeParagraph","Properties":{"id":"20240612145852-jyn2t2l","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 1.粱，一年生栽培作物，须根粗大。秆粗装，直立，高0.1-1m。叶鞘松裹茎秆，密具疣毛或无毛，先以近边缘及叶片接处的背面为密，边缘密具纤毛；叶舌为1圈纤毛；呀片长披针形或线状披针形，长10-45cm，宽5-33mm，先端尖，基部钝圆，上面粗糙，下面稍光滑。圆锥花序呈圆柱状或近纺锤状，通常下垂，基部多少有间断，长10-40cm，宽1-5cm，常因品种的不同而变异主轴密被柔毛，刚毛显着长于或稍长于小穗，黄色，褐色或紫色；小穗椭圆形或近圆球形，长2-3mm，黄色，褐色或紫色；第1颖长为小穗的1/3-1/2，具3脉，第2颖稍短于或长为小穗的3/4，先端钝，具5-9脉；第1外稃与小穗等长，具5-7脉，基内稃薄纸质，披针形，长为其2/3，第2外稃等长于第1外稃，卵圆形或圆球形，质坚硬，平滑或具细点状皱纹，成熟后，自第1外稃基部和颖分离脱落；鳞被先端不平，呈微波状；花柱基部分离。花、果期夏、秋季。"}]},{"ID":"20240612145852-gq414lj","Type":"NodeParagraph","Properties":{"id":"20240612145852-gq414lj","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"2.粟，本变种的主要特征在于：植物体细弱矮小，高20-70cm。圆锥花序呈圆柱形，紧密，长6-12cm，宽5-10mm；小穗卵形或卵状披针形，长2-2.5mm，黄色，刚毛长约小穗的1-3倍，小枝不延伸。"}]},{"ID":"20240612145852-ilke313","Type":"NodeParagraph","Properties":{"id":"20240612145852-ilke313","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612145852-c6f78xk","Type":"NodeParagraph","Properties":{"id":"20240612145852-c6f78xk","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 栽培植物中的梁，与粟为同种。李时珍谓：梁即粟也，大而毛长者为粱，细而毛短者为粟。参见青粱米、黄粱米、白梁米各条。"}]},{"ID":"20240612145852-zbobp0t","Type":"NodeParagraph","Properties":{"id":"20240612145852-zbobp0t","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612145852-4qdy2yz","Type":"NodeParagraph","Properties":{"id":"20240612145852-4qdy2yz","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 本品脱壳种子和带壳种子的干品分别含脂肪1.41%、1.68%，总氮2.48%、2.79%，蛋白氮2.41%、2.72%，灰分3.15%、1.85%，淀粉63.27%、77.58%，还原糖2.03%、1.98%。另有谓种子含油3%；油中含不皂化物2.39%，固体脂肪酸15.05%，液体脂肪酸70.03%。蛋白质有谷蛋白、醇溶蛋白、球蛋白等多类。种子蛋白质含多量谷氨酸(glutamic acid)，脯氨酸(proline)，丙氨酸(alanine)，蛋氨酸(methionine)和少赖氨酸(lysine) ，另外种子中还发现1种a-淀粉酶抑制剂。"}]},{"ID":"20240612145852-9l6xxbm","Type":"NodeParagraph","Properties":{"id":"20240612145852-9l6xxbm","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"另外带从本品中分得α-和β-粟素(setarin)，甘油单葡萄糖酯(monoglucosylglyceride)，甘油二葡萄糖酯(diglucosylglyceride)，非淀粉多糖(nonstarchy polysaccharicdes)及蔗糖(sucrose)，棉子糖(raffinose)，葡萄糖(glucose)，果糖(fructose)和半乳糖(galactose)。此外，本品还含无机元素钼。"}]},{"ID":"20240612145852-b4ukbmq","Type":"NodeParagraph","Properties":{"id":"20240612145852-b4ukbmq","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612145852-uf75420","Type":"NodeParagraph","Properties":{"id":"20240612145852-uf75420","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 白端香甙的作用参见瑞香花条。其甙元有抗菌作用，1∶10000能抑制金黄色葡萄球菌(青霉素耐药株)，1∶5000能抑制葡萄球菌及大肠杆菌，1∶2000抑制绿脓杆菌，但对枯草杆菌无效。"}]},{"ID":"20240612145852-eytjdec","Type":"NodeParagraph","Properties":{"id":"20240612145852-eytjdec","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145852-pusp7yh","Type":"NodeParagraph","Properties":{"id":"20240612145852-pusp7yh","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 肾；脾；胃经"}]},{"ID":"20240612145852-3r6k2mp","Type":"NodeParagraph","Properties":{"id":"20240612145852-3r6k2mp","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145852-egirabr","Type":"NodeParagraph","Properties":{"id":"20240612145852-egirabr","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 味甘；咸；性凉"}]},{"ID":"20240612145852-j8wmpda","Type":"NodeParagraph","Properties":{"id":"20240612145852-j8wmpda","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612145852-7gkg0l8","Type":"NodeParagraph","Properties":{"id":"20240612145852-7gkg0l8","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 《日用本草》：与杏仁同食，令人吐泻。"}]},{"ID":"20240612145852-ley9e40","Type":"NodeParagraph","Properties":{"id":"20240612145852-ley9e40","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145852-zbtr01b","Type":"NodeParagraph","Properties":{"id":"20240612145852-zbtr01b","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 和中益肾；除热；解毒。主脾胃虚热；反胃呕吐；腹满食少；消渴；泻痢；烫火伤"}]},{"ID":"20240612145852-ug8hqi4","Type":"NodeParagraph","Properties":{"id":"20240612145852-ug8hqi4","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145852-yiowr3f","Type":"NodeParagraph","Properties":{"id":"20240612145852-yiowr3f","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，15-30g；或煮粥。外用：适量，研末撒；或熬汁涂。"}]},{"ID":"20240612145852-h5iykei","Type":"NodeParagraph","Properties":{"id":"20240612145852-h5iykei","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612145852-28vplv0","Type":"NodeParagraph","Properties":{"id":"20240612145852-28vplv0","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" ①治脾胃气弱，食不消化，呕逆反胃，汤饮不下：粟米半升，杵如粉，水和丸如梧子，煮令熟，点少盐，空心和汁吞下。 (《食医心镜》)②治消渴口干： 粟米炊饭，食之良。 (《食医心镜》)③治孩子赤丹不止： 研粟米敷之。(《兵部手集方》)④治汤火灼伤： 粟米炒焦，投水，澄取汁，煎稠如糖，频涂之。能止痛，灭瘢痕。一方半生半炒，研末，酒调敷之。(《崔氏纂要方》)"}]},{"ID":"20240612145852-4rp6wbu","Type":"NodeParagraph","Properties":{"id":"20240612145852-4rp6wbu","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612145852-ucp0g52","Type":"NodeParagraph","Properties":{"id":"20240612145852-ucp0g52","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：粟，陈者难化。《衍义》云，生者难化，熟者滞气，隔食生虫。所谓补肾者，以其味咸之故也。"}]},{"ID":"20240612145852-wega6x1","Type":"NodeParagraph","Properties":{"id":"20240612145852-wega6x1","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：粟之味咸淡，气寒下渗，肾之谷也。肾病宜食之，虚热消渴泄痢，皆肾病也，渗利小便，所以泄肾邪也。降胃火，故脚胃之病宜食之。按罗天益《宝鉴》云，粳粟米粥，气薄味淡，阳中之阴也，所以淡渗下行，利小便。韩《医通》云： 一人病淋，素不服药，予教以专啖粟米粥，绝他味，旬余减，月余痊，此五谷治病之理。"}]},{"ID":"20240612145852-j47875g","Type":"NodeParagraph","Properties":{"id":"20240612145852-j47875g","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"3.《随息居饮食谱》：粟米功用与二米略同，而性较凉，病人食之为宜。"}]},{"ID":"20240612145852-cwzo1hw","Type":"NodeParagraph","Properties":{"id":"20240612145852-cwzo1hw","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"4.《医学入门》：粟，即今之小米。山东最多。五谷中最硬，谓之硬粟，得浆水即易化。无毒。"}]},{"ID":"20240612145852-4h67fs1","Type":"NodeParagraph","Properties":{"id":"20240612145852-4h67fs1","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"5.《别录》：主养肾气，去胃脾中热，益气。"}]},{"ID":"20240612145852-3yvywed","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612145852-3yvywed","updated":"20240612145852"},"Children":[{"ID":"20240612145852-rdqo46u","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20240612145852-rdqo46u","updated":"20240612145852"},"Children":[{"ID":"20240612145852-cgnok25","Type":"NodeParagraph","Properties":{"id":"20240612145852-cgnok25","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"陈粟米：主胃热，消渴，利小便。"}]}]},{"ID":"20240612145852-kio39hx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ny4=","Num":7},"Properties":{"id":"20240612145852-kio39hx","updated":"20240612145852"},"Children":[{"ID":"20240612145852-6vzrte5","Type":"NodeParagraph","Properties":{"id":"20240612145852-6vzrte5","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"陶弘景：陈粟米：作粉尤解烦闷。"}]}]},{"ID":"20240612145852-fvc3394","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OC4=","Num":8},"Properties":{"id":"20240612145852-fvc3394","updated":"20240612145852"},"Children":[{"ID":"20240612145852-m0zkbwx","Type":"NodeParagraph","Properties":{"id":"20240612145852-m0zkbwx","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"孟诜：陈粟米：止痢。"}]}]}]},{"ID":"20240612145852-ho45129","Type":"NodeParagraph","Properties":{"id":"20240612145852-ho45129","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"9.《本草拾遗》：粟米粉解诸毒，水搅服之；亦主热腹痛，鼻衄，并水煮服之。"}]},{"ID":"20240612145852-qp4drkw","Type":"NodeParagraph","Properties":{"id":"20240612145852-qp4drkw","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"10.《日用本草》：和中益气，止痢，治消渴，利小便，陈者更良。"}]},{"ID":"20240612145852-5fou6b6","Type":"NodeParagraph","Properties":{"id":"20240612145852-5fou6b6","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"11.《滇南本草》：主滋阴，养肾气，健脾胃，暖中。治反胃，小儿肝虫，或霍乱吐泻，肚疼痢疾，水泻不止。"}]},{"ID":"20240612145852-jg51007","Type":"NodeParagraph","Properties":{"id":"20240612145852-jg51007","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"12.《纲目》：煮粥食益丹田，补虚损，开肠胃。"}]},{"ID":"20240612145852-2xxurjw","Type":"NodeParagraph","Properties":{"id":"20240612145852-2xxurjw","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145852-x1bvy70","Type":"NodeParagraph","Properties":{"id":"20240612145852-x1bvy70","updated":"20240612145852"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612145853-hnb0o5a","Type":"NodeThematicBreak","Properties":{"id":"20240612145853-hnb0o5a"}},{"ID":"20240612145854-pihevwt","Type":"NodeParagraph","Properties":{"id":"20240612145854-pihevwt"}}]}