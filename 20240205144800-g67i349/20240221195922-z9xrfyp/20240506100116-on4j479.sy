{"ID":"20240506100116-on4j479","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100116-on4j479","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100116-on4j479\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506100116-avew6sa\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240506100116-avew6sa\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240506100116-avew6sa\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"252蓼实（红蓼花子）","type":"doc","updated":"20240822090031"},"Children":[{"ID":"20240715175115-pzorfo7","Type":"NodeParagraph","Properties":{"id":"20240715175115-pzorfo7","updated":"20240715175115"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产东北、华北地区。\n【性状】\t呈扁圆形，直径23mm，厚11.5mm。表面棕黑色，或红棕色，有光泽，两侧面微凹入，其中央呈微隆起的线状，先端有刺状突起的柱基，基部有浅棕色略突起的果柄痕，有时残留膜质花被。果皮厚而坚硬。种子扁圆形，种皮浅棕色膜质；胚乳粉质，类白色，胚细小弯曲，略成环状。气微弱，味淡。\n【性味】\t咸，微寒。\n【功效】\t散血消症，消积止痛。用于症瘕痞块，瘿瘤，食积不消，胃脘胀痛，水肿腹水。"}]},{"ID":"20240715175115-9n2h27p","Type":"NodeParagraph","Properties":{"id":"20240715175115-9n2h27p","updated":"20240715175115"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206103052-whyjv3h.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240715175115-6zzba3w","Type":"NodeParagraph","Properties":{"id":"20240715175115-6zzba3w","updated":"20240715175115"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"红蓼 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/红蓼 1-20240715174208-j1s3u4z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627143654-bqv6ebn","Type":"NodeParagraph","Properties":{"id":"20240627143654-bqv6ebn","updated":"20240821193832"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 496px;","style":"width: 486px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蓼实2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蓼实2-20240627143654-z5j1bfs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 486px;\" parent-style=\"width: 496px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821193834-un581ld","Type":"NodeParagraph","Properties":{"id":"20240821193834-un581ld","updated":"20240821193839"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红蓼"}]},{"ID":"20240715174904-7q4wf73","Type":"NodeParagraph","Properties":{"id":"20240715174904-7q4wf73","updated":"20240821192244"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 341px;","style":"width: 331px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水红花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水红花-20240715174249-cq9jm12.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 331px;\" parent-style=\"width: 341px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 878px;","style":"width: 868px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水红花 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水红花 1-20240715174320-njdudyu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 868px;\" parent-style=\"width: 878px;\"}"},{"Type":"NodeText","