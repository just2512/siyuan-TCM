85619-rhgr3md.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 579px;\" parent-style=\"width: 589px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822084146-rae2uyt","Type":"NodeParagraph","Properties":{"id":"20240822084146-rae2uyt","updated":"20240822090009"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 511px;","style":"width: 501px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"马蓼 (11)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/马蓼 11-20240822085727-jc1b9v7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 501px;\" parent-style=\"width: 511px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821192118-v3lxrws","Type":"NodeParagraph","Properties":{"id":"20240821192118-v3lxrws","updated":"20240822090031"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：以上取图为红蓼、马蓼，实际上不止这两种蓼的种子能入药；"}]},{"ID":"20240612150758-6ditx5h","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-6ditx5h"}},{"ID":"20240627144409-m1ns8ap","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240627144409-m1ns8ap","updated":"20240627144416"},"Children":[{"Type":"NodeText","Data":"蓼实《神农本草经》"}]},{"ID":"20240627144409-ugvt7t1","Type":"NodeParagraph","Properties":{"id":"20240627144409-ugvt7t1","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240627144409-f4x0asy","Type":"NodeParagraph","Properties":{"id":"20240627144409-f4x0asy","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"主明目温中，耐风寒，下水气，面目浮肿，痈疡，马蓼，去肠中蛭虫，轻身。生川泽。"}]},{"ID":"20240627144409-p0d78zk","Type":"NodeParagraph","Properties":{"id":"20240627144409-p0d78zk","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"《吴普》曰，蓼实一名天蓼，一名野蓼，一名泽蓼。（艺文类聚）。"}]},{"ID":"20240627144409-v0o78m5","Type":"NodeParagraph","Properties":{"id":"20240627144409-v0o78m5","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生雷泽。"}]},{"ID":"20240627144409-krytz9n","Type":"NodeParagraph","Properties":{"id":"20240627144409-krytz9n","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"案《说文》云：蓼、辛菜蔷虞也，蔷，蔷虞，蓼。《广雅》云：荭、茏、（上艹下左吉右页）、马蓼也。《尔雅》云：蔷虞，蓼。郭璞云：虞蓼，泽蓼，又荭，茏古，其大者，归。"}]},{"ID":"20240627144409-jinrltd","Type":"NodeParagraph","Properties":{"id":"20240627144409-jinrltd","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"郭璞云：俗呼荭草为茏鼓，语转耳。《毛诗》云：隰有游龙，《传》云：龙，红草也。"}]},{"ID":"20240627144409-rslhapp","Type":"NodeParagraph","Properties":{"id":"20240627144409-rslhapp","updated":"20240627144409"},"Children":[{"Type":"NodeText","Data":"陆玑云：一名马蓼，叶大而赤色生水中，高丈余，又以薅杀蓼。《传》云：蓼，水草也。"}]},{"ID":"20240612150936-ufanmfb","Type":"NodeThematicBreak","Properties":{"id":"20240612150936-ufanmfb"}},{"ID":"20240612150950-9ydtn6s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150950-9ydtn6s","updated":"20240612150955"},"Children":[{"Type":"NodeText","Data":"蓼实《证类本草》"}]},{"ID":"20240612150950-c392e79","Type":"NodeParagraph","Properties":{"id":"20240612150950-c392e79","updated":"20240612150950"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主明目，温中，耐风寒，下水气，面目浮肿，痈疡。叶，归舌，除大小肠邪气，利中益志。"}]},{"ID":"20240612150950-3unb3z6","Type":"NodeParagraph","Properties":{"id":"20240612150950-3unb3z6","updated":"20240612150950"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"马蓼"},{"Type":"NodeText","Data":"去肠中蛭虫，轻身。生雷泽川泽。"}]},{"ID":"20240612150950-syte8e4","Type":"NodeParagraph","Properties":{"id":"20240612150950-syte8e4","updated":"20240612150950"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此类又多，人所食有三种∶一是紫蓼，相似而紫色；名香蓼，亦相似而香，并不甚辛而好食；一是青蓼，人家常有，其叶有园者、尖者，以园者为胜，所用即是此。干之以酿酒，主风冷，大良。马蓼，生下湿地，茎斑，叶大有黑点。亦有两三种，其最大者名笼（音鼓），即是荭草，已在上卷中品。唐本注云∶《尔雅》云，荭，一名茏 ，大者名 （丘轨切），则最大者不名笼 ，陶误呼之。又有水蓼，叶大似马蓼而味辛。主被蛇伤，捣敷之；绞取汁服，止蛇毒入腹心闷者。又水煮渍脚捋之，消香港脚肿。生下湿水旁。今按∶ 陈藏器本草云∶蓼，主 癖。每日取一握煮服之，人霍乱转筋，多取煮汤及热捋脚。叶，捣敷狐刺疮，亦主小儿头疮。又云∶蓼、蕺俱弱阳。人为蜗牛子浸之，立瘥。不可近阴，令弱也。诸蓼并冬死，唯香蓼宿根重生。人为生菜，最能入腰脚也。臣禹锡等谨按蜀本图经云∶蓼类甚多，有紫蓼、赤蓼、青蓼、马蓼、水蓼、香蓼、木蓼等，其类有七种。紫、赤二蓼，叶小狭而浓；青、香二蓼，叶亦相叶俱阔大，上有黑点。木蓼一名天蓼，蔓生，叶似柘叶，诸蓼花皆红白，子皆赤黑；木蓼，花黄白，子皮青滑。尔雅云∶蔷，虞蓼。释曰∶蔷，一名虞蓼，即蓼之生水泽者也。《周颂·良KT 》云∶以薅，荼蓼。《毛传》曰∶蓼，水草是也。药性论云∶蓼实，使，归鼻。除肾气，兼能去 阳。叶主邪气。又云∶食之多发心痛，令人寒热，损骨髓。小儿头疮，捣末和白蜜（一云和鸡子白）涂上，虫出不作瘢。若霍乱转筋，取子一把，香豉一升，先切叶，以水三升，煮取二升，纳豉汁中，更煮取一升半，分三服。又与大麦面相宜。孟诜云∶蓼子，多食令人吐水。亦通五脏拥气，损阳气。日华子云∶水蓼，性冷，无毒。蛇咬捣敷，根茎并用。又云∶赤蓼，暖，暴脚软人，烧灰淋汁浸，持以蒸桑叶 ，立愈。"}]},{"ID":"20240612150950-u9z9lcf","Type":"NodeParagraph","Properties":{"id":"20240612150950-u9z9lcf","updated":"20240612150950"},"Children":[{"Type":"NodeText","Data":"图经曰∶蓼实，生雷泽川泽，今在处有之。蓼类甚多，有紫蓼、赤蓼（一名红蓼）、青蓼、香蓼、马蓼、水蓼、木蓼等，凡七种。紫、赤二种，叶俱小狭而浓；青、香二种，叶亦相似而惧大，上有黑点。此六种花皆黄白，子皆青黑。木蓼一名天蓼，亦有大，小二种，蔓生，叶似柘叶，花黄白，子皮青滑。陶隐居以青蓼入药，然其蓼俱堪食，又以马蓼为荭草，已见上条，余亦无用。苏恭以水蓼亦入药，水煮捋脚者，多生水泽中。《周颂》所谓以薅（大羔切），荼蓼。《尔雅》所谓蔷，虞蓼是也。又《三茅君传》有作白蓼酱方。白蓼，《药谱》无闻，疑即青蓼也。或云红蓼亦可作酱。"}]},{"ID":"20240612150950-5o9yfem","Type":"NodeParagraph","Properties":{"id":"20240612150950-5o9yfem","updated":"20240612150950"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治肝虚转筋。用赤蓼茎、叶切三合，水一盏，酒三合，煎至四合去滓，温分二服。又方∶治热 心闷。用浓煮蓼汁一大盏，分为二服饮之。外台秘要∶治夏月 死，取浓煮汁痛成疮。先锉浆蓼煮汤，令温热得所，频频淋洗，候疮干自安。孙真人食之伤肾。合鱼脍食之，则令人阴冷疼，气欲绝。斗门方∶治血气攻心，今录验∶治霍乱转筋。取蓼一手把，去两头，以水二也。"}]},{"ID":"20240612150950-97wr4ub","Type":"NodeParagraph","Properties":{"id":"20240612150950-97wr4ub","updated":"20240612150950"},"Children":[{"Type":"NodeText","Data":"衍义曰∶蓼实，即《神农本经》第十一卷中水蓼之子也。彼言蓼则用茎，此言实即用子，故此复论子之功，故分为二条。春初以葫芦盛水浸湿，高挂于火上，昼夜使暖，遂生红芽，取以种水红，与此相类，但苗茎高及丈。取子，微炒，碾为细末，薄酒调二、三钱服，治瘰 。久则效，效则已。"}]},{"ID":"20240612150936-sq6nlib","Type":"NodeThematicBreak","Properties":{"id":"20240612150936-sq6nlib"}},{"ID":"20240612150937-3nu68rl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150937-3nu68rl","updated":"20240612150942"},"Children":[{"Type":"NodeText","Data":"蓼实《本草撮要》"}]},{"ID":"20240612150937-95l0w31","Type":"NodeParagraph","Properties":{"id":"20240612150937-95l0w31","updated":"20240612150937"},"Children":[{"Type":"NodeText","Data":"味辛温．入手足太阴足厥阴经．功专温中明目．下水气．"}]},{"ID":"20240612150911-b4wd62n","Type":"NodeThematicBreak","Properties":{"id":"20240612150911-b4wd62n"}},{"ID":"20240612150927-tog1tvr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150927-tog1tvr","updated":"20240612150931"},"Children":[{"Type":"NodeText","Data":"蓼实《得配本草》"}]},{"ID":"20240612150927-3mxxm66","Type":"NodeParagraph","Properties":{"id":"20240612150927-3mxxm66","updated":"20240612150927"},"Children":[{"Type":"NodeText","Data":"辛，温。明目温中，消肿下水，能消酒积。配香薷，治霍乱烦渴。调白蜜、鸡子白，涂头疮。炒用，消散之气稍缓。多食损阳。"}]},{"ID":"20240612150927-9vtzit4","Type":"NodeParagraph","Properties":{"id":"20240612150927-9vtzit4","updated":"20240612150927"},"Children":[{"Type":"NodeText","Data":"苗、叶。辛，温。入手太阳、阳明经气分。除邪气，理中焦。配香豉，治霍乱转筋。"}]},{"ID":"20240612150927-zbxx7el","Type":"NodeParagraph","Properties":{"id":"20240612150927-zbxx7el","updated":"20240612150927"},"Children":[{"Type":"NodeText","Data":"久服令人寒热，损髓减气。"}]},{"ID":"20240612150911-gnyva0o","Type":"NodeThematicBreak","Properties":{"id":"20240612150911-gnyva0o"}},{"ID":"20240612150913-wq59dz9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150913-wq59dz9","updated":"20240612150917"},"Children":[{"Type":"NodeText","Data":"蓼实《本草备要》"}]},{"ID":"20240612150913-bdqk3rz","Type":"NodeParagraph","Properties":{"id":"20240612150913-bdqk3rz","updated":"20240612150913"},"Children":[{"Type":"NodeText","Data":"宣，温中"}]},{"ID":"20240612150913-7owyxci","Type":"NodeParagraph","Properties":{"id":"20240612150913-7owyxci","updated":"20240612150913"},"Children":[{"Type":"NodeText","Data":"辛温。温中明目，耐风寒，下水气（时珍曰∶古人种蓼为蔬，收子入药，今为酒曲用其汁耳。以香蓼、青蓼、紫蓼为良）。"}]},{"ID":"20240612150913-yi0tvjl","Type":"NodeParagraph","Properties":{"id":"20240612150913-yi0tvjl","updated":"20240612150913"},"Children":[{"Type":"NodeText","Data":"有香蓼、青蓼、紫蓼、赤蓼、木蓼、水蓼、马蓼。"}]},{"ID":"20240612150758-5ooxlgw","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-5ooxlgw"}},{"ID":"20240612150854-kusysas","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150854-kusysas","updated":"20240612150906"},"Children":[{"Type":"NodeText","Data":"蓼实《本草衍义》"}]},{"ID":"20240612150854-qiahwil","Type":"NodeParagraph","Properties":{"id":"20240612150854-qiahwil","updated":"20240612150854"},"Children":[{"Type":"NodeText","Data":"即《神农本经》第十一卷中“水蓼”之子也。彼言蓼，则用茎；此言实，即用子。故此复论子之功，故分为二条。春初，以葫芦盛水浸湿，高挂于火上，昼夜使暖，遂生红芽，取以为蔬，以备五辛盘。又一种水红，与此相类，但苗茎高及丈。取子微炒，碾为细末，薄酒调二三钱服，治瘰 。久则效，效则已。"}]},{"ID":"20240612150758-aqib2u8","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-aqib2u8"}},{"ID":"20240612150841-4xmyd4c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150841-4xmyd4c","updated":"20240612150845"},"Children":[{"Type":"NodeText","Data":"蓼实《千金翼方》"}]},{"ID":"20240612150841-ra61tlf","Type":"NodeParagraph","Properties":{"id":"20240612150841-ra61tlf","updated":"20240612150841"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主明目，温中，耐风寒，下水气，面目浮肿，痈疡。叶∶归于舌，除大小肠邪气，利中益志。马蓼∶去肠中蛭虫，轻身。生雷泽川泽。"}]},{"ID":"20240612150758-m8k5uk9","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-m8k5uk9"}},{"ID":"20240612150831-leppma4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150831-leppma4","updated":"20240612150835"},"Children":[{"Type":"NodeText","Data":"蓼实《本草崇原》"}]},{"ID":"20240612150831-laiyjdc","Type":"NodeParagraph","Properties":{"id":"20240612150831-laiyjdc","updated":"20240612150831"},"Children":[{"Type":"NodeText","Data":"气味辛温，无毒。主治明目，温中，耐风寒，下水气，面浮肿，痈疡。"}]},{"ID":"20240612150831-jdw83yn","Type":"NodeParagraph","Properties":{"id":"20240612150831-jdw83yn","updated":"20240612150831"},"Children":[{"Type":"NodeText","Data":"（蓼近水滨及下湿处皆有，其类甚多，有青蓼、香蓼、水蓼、马蓼、紫蓼、赤蓼、木蓼七种。又一种味极辛辣，谓之辣蓼。今时浸水和面， 面是为神曲，又取燥末拌糯米饭一团，作之者鲜矣。）"}]},{"ID":"20240612150758-rcny5lg","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-rcny5lg"}},{"ID":"20240612150821-18b6nmp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150821-18b6nmp","updated":"20240612150826"},"Children":[{"Type":"NodeText","Data":"蓼实《神农本草经赞》"}]},{"ID":"20240612150821-e7hlsd6","Type":"NodeParagraph","Properties":{"id":"20240612150821-e7hlsd6","updated":"20240612150821"},"Children":[{"Type":"NodeText","Data":"味辛温。主明目温中。耐风寒。下水气。面目浮肿。痈疡。马蓼。去肠中蛭虫。轻身。生川泽。"}]},{"ID":"20240612150821-la5hmuv","Type":"NodeParagraph","Properties":{"id":"20240612150821-la5hmuv","updated":"20240612150821"},"Children":[{"Type":"NodeText","Data":"间白分红。垂珠穗密。辛佐盘陈。香濡腹实。茎矗涂斑。叶标记墨。安故蠕虫。葵甘不食。"}]},{"ID":"20240612150821-xd1tbsp","Type":"NodeParagraph","Properties":{"id":"20240612150821-xd1tbsp","updated":"20240612150821"},"Children":[{"Type":"NodeText","Data":"刘克庄诗。分红间白汀洲晚。梅尧臣诗。无香结珠穗。寇宗日。春初以水浸湿。悬火上使暖。生红芽。备五辛盘。礼疏。濡豚包苦实。谓破其腹。实蓼于中。陶弘景曰。马蓼茎斑叶大。李时珍曰。每叶中间有黑迹如墨点。方士呼为墨记草。楚辞芳草谱。蓼虫不知徙乎葵菜。言蓼辛葵甘。虫各安其故。不知迁也。易。井渫不食。"}]},{"ID":"20240612150758-si5am0h","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-si5am0h"}},{"ID":"20240612150812-5w2ccdl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150812-5w2ccdl","updated":"20240612150816"},"Children":[{"Type":"NodeText","Data":"蓼实《医学入门》"}]},{"ID":"20240612150812-wdgp4ry","Type":"NodeParagraph","Properties":{"id":"20240612150812-wdgp4ry","updated":"20240612150812"},"Children":[{"Type":"NodeText","Data":"蓼实辛温能下水，明目温中去寒暑，霍乱转筋腹内疼，破癖消痈及疮瘰，叶洗脚肿敷蛇伤，肠蛭马蓼独可取。"}]},{"ID":"20240612150812-klxr28m","Type":"NodeParagraph","Properties":{"id":"20240612150812-klxr28m","updated":"20240612150812"},"Children":[{"Type":"NodeText","Data":"蓼，蓼也，至秋柯枝高硕寥寥然。茎赤叶大，上有黑点，生水泽中。《衍义》云∶即水蓼之实也。无毒。"}]},{"ID":"20240612150812-ml0h27r","Type":"NodeParagraph","Properties":{"id":"20240612150812-ml0h27r","updated":"20240612150812"},"Children":[{"Type":"NodeText","Data":"下水气、面目浮肿，明目温中，治风寒及夏月中 心闷欲死，霍乱转筋，心腹疼痛，并水煮服之。又治 癖、痈疮、瘰 ，久服则效，效则已。小儿头疮敷之良，除大小肠邪气，通五脏壅。多食令人吐水，损肾阳气。二月食之发心痛寒热；合鱼 食，令人阴冷疼，气欲绝。入药微炒研碎。叶，煮汤捋脚，消气肿及脚痛成疮；生绞汁服，治蛇毒入内心闷，仍捣敷伤处。马蓼，去肠中蛭虫。抑考蓼有七种∶香蓼可作菜食，治腰脚。青蓼，可酿酒，主风冷。红蓼，可作酱。水蓼，一名大蓼，即水红蓼，主恶疮，去痹气，诸蓼叶俱狭小，惟马、水二种阔大。花皆黄白，子皆青黑。"}]},{"ID":"20240612150758-ne4evyh","Type":"NodeThematicBreak","Properties":{"id":"20240612150758-ne4evyh"}},{"ID":"20240612150800-08wz4tl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612150800-08wz4tl","updated":"20240612150805"},"Children":[{"Type":"NodeText","Data":"蓼实《新修本草》"}]},{"ID":"20240612150800-7q2zzgo","Type":"NodeParagraph","Properties":{"id":"20240612150800-7q2zzgo","updated":"20240612150800"},"Children":[{"Type":"NodeText","Data":"味辛，温，无毒。主明目，温中，耐风寒，下水气，面目浮肿，痈疡。叶归舌，除大小肠邪气，利中益志。马蓼，去肠中蛭虫，轻身。生雷泽川泽。"}]},{"ID":"20240612150800-s3ujwnx","Type":"NodeParagraph","Properties":{"id":"20240612150800-s3ujwnx","updated":"20240612150800"},"Children":[{"Type":"NodeText","Data":"此类又多，人所食有三种∶一是紫蓼，相似而紫色；一是香蓼，亦相似而香，并不甚辛，而常有，其叶有圆、有尖，以圆者为胜，所用即是此。干之以酿酒，主疗风冷，大良。马蓼生下湿地，茎斑，叶大有黑点。亦有两三种，其最大者名茏古，即是荭草，以在上卷中品。"}]},{"ID":"20240612150800-ff3j1vp","Type":"NodeParagraph","Properties":{"id":"20240612150800-ff3j1vp","updated":"20240612150800"},"Children":[{"Type":"NodeText","Data":"〔谨案〕"}]},{"ID":"20240612150800-q8mqcux","Type":"NodeParagraph","Properties":{"id":"20240612150800-q8mqcux","updated":"20240612150800"},"Children":[{"Type":"NodeText","Data":"《尔雅》云∶荭，一名茏古，大者名 则，最大者，不名茏古，陶误呼之。又有水蓼，叶大似马蓼，而味辛。主被蛇伤，捣敷之；绞汁服，止蛇毒入腹心闷者；又水煮渍脚捋之，消香港脚肿。生下湿地水旁。"}]},{"ID":"20240612150801-fuehcj7","Type":"NodeThematicBreak","Properties":{"id":"20240612150801-fuehcj7"}},{"ID":"20240612150802-sg6ddcw","Type":"NodeParagraph","Properties":{"id":"20240612150802-sg6ddcw"}}]}