,{"Type":"NodeLinkDest","Data":"assets/鸢尾 5-20240822110415-tf2jiwy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 815px;\" parent-style=\"width: 825px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612170831-rr8jbry","Type":"NodeParagraph","Properties":{"id":"20240612170831-rr8jbry","updated":"20240628085144"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：鸢尾用的是其根茎。"}]},{"ID":"20240612170831-b5gg0bd","Type":"NodeThematicBreak","Properties":{"id":"20240612170831-b5gg0bd"}},{"ID":"20240612171033-6pfxcsc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171033-6pfxcsc","updated":"20240612171038"},"Children":[{"Type":"NodeText","Data":"鸢尾《神农本草经》"}]},{"ID":"20240612171033-hrcvyfa","Type":"NodeParagraph","Properties":{"id":"20240612171033-hrcvyfa","updated":"20240612171033"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240612171033-tkfnp02","Type":"NodeParagraph","Properties":{"id":"20240612171033-tkfnp02","updated":"20240612171033"},"Children":[{"Type":"NodeText","Data":"主蛊毒邪气，鬼注，诸毒，破症瘕积聚，去水，下三虫。生山谷。"}]},{"ID":"20240612171033-jmpjt6u","Type":"NodeParagraph","Properties":{"id":"20240612171033-jmpjt6u","updated":"20240612171033"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：鸢尾，治蛊毒（《御览》）。"}]},{"ID":"20240612171033-1sc3l46","Type":"NodeParagraph","Properties":{"id":"20240612171033-1sc3l46","updated":"20240612171033"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名乌园，生九疑山，五月采。"}]},{"ID":"20240612171033-m9r9wck","Type":"NodeParagraph","Properties":{"id":"20240612171033-m9r9wck","updated":"20240612171033"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：鸢尾，乌萐，射干也（疑当作鸢尾乌园也，乌萐射干也，是二物）。《唐本》注云：与射干全别。"}]},{"ID":"20240612171056-5kq76gw","Type":"NodeThematicBreak","Properties":{"id":"20240612171056-5kq76gw"}},{"ID":"20240612171058-z0c45yq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171058-z0c45yq","updated":"20240612171102"},"Children":[{"Type":"NodeText","Data":"鸢尾《千金翼方》"}]},{"ID":"20240612171058-ubkrxhu","Type":"NodeParagraph","Properties":{"id":"20240612171058-ubkrxhu","updated":"20240612171058"},"Children":[{"Type":"NodeText","Data":"味苦，平，有毒。主蛊毒邪气，鬼疰诸毒，破症瘕积聚大水，下三虫。疗头眩，杀鬼魅。"}]},{"ID":"20240612171058-auuo6lb","Type":"NodeParagraph","Properties":{"id":"20240612171058-auuo6lb","updated":"20240612171058"},"Children":[{"Type":"NodeText","Data":"一名乌圆。生九疑山谷，五月采。"}]},{"ID":"20240612171117-c6ajqvf","Type":"NodeThematicBreak","Properties":{"id":"20240612171117-c6ajqvf"}},{"ID":"20240612171118-2vuku8z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171118-2vuku8z","updated":"20240612171122"},"Children":[{"Type":"NodeText","Data":"鸢尾《神农本草经赞》"}]},{"ID":"20240612171118-fx2k6ar","Type":"NodeParagraph","Properties":{"id":"20240612171118-fx2k6ar","updated":"20240612171118"},"Children":[{"Type":"NodeText","Data":"味苦平。主蛊毒邪气。鬼注诸毒。破症瘕积聚。去水。下三虫。生山谷。"}]},{"ID":"20240612171118-5le0dl5","Type":"NodeParagraph","Properties":{"id":"20240612171118-5le0dl5","updated":"20240612171118"},"Children":[{"Type":"NodeText","Data":"乌鸢于止。挟势如飞。碧分尾断。黄裹头垂。殖区修短。壤异硗肥。纷敷花色。强利从违。"}]},{"ID":"20240612171118-fano1r2","Type":"NodeParagraph","Properties":{"id":"20240612171118-fano1r2","updated":"20240612171118"},"Children":[{"Type":"NodeText","Data":"吴普曰。一名乌鸢。大学。于止知其所止。诗。如飞如翰。苏恭曰。阔短不抽长茎。花紫碧色。根皮黄。肉白。左传。雄鸡自断其尾。韩保升曰。草名鸢尾。根名鸢头。李时珍曰。此即射干之苗。非别种也。肥地者。茎长根粗。瘠地者。茎短根瘦。其花自有数色。诸家皆是强分耳。"}]},{"ID":"20240612171106-gj56p3k","Type":"NodeThematicBreak","Properties":{"id":"20240612171106-gj56p3k"}},{"ID":"20240612171107-yrcw81h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171107-yrcw81h","updated":"20240612171112"},"Children":[{"Type":"NodeText","Data":"鸢尾《增广和剂局方药性总论》"}]},{"ID":"20240612171107-6iinelw","Type":"NodeParagraph","Properties":{"id":"20240612171107-6iinelw","updated":"20240612171107"},"Children":[{"Type":"NodeText","Data":"味苦，平，有毒。主蛊毒邪气，鬼疰诸毒，破症瘕积聚大水，下三虫，疗头眩，杀陈脏器云∶主飞尸游蛊着喉中，气欲绝者。以根削去皮，纳喉中摩病处，血出佳。"}]},{"ID":"20240612171044-kv72cxb","Type":"NodeThematicBreak","Properties":{"id":"20240612171044-kv72cxb"}},{"ID":"20240612171045-cxlifps","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171045-cxlifps","updated":"20240612171050"},"Children":[{"Type":"NodeText","Data":"鸢尾《本草经集注》"}]},{"ID":"20240612171045-nffhukc","Type":"NodeParagraph","Properties":{"id":"20240612171045-nffhukc","updated":"20240612171045"},"Children":[{"Type":"NodeText","Data":"味苦，平，有毒。主治蛊毒，邪气，鬼疰诸毒，破症瘕积聚，大水，下三虫。治头眩，杀鬼魅。一名乌园。生九嶷山谷，五月 。方家皆云，是夜干苗，无鸢尾之名，主治亦异，此当别一种物。方亦有用，鸢头者即应是其根，治体相似，而本草不显之。"}]},{"ID":"20240612170831-fubinvx","Type":"NodeThematicBreak","Properties":{"id":"20240612170831-fubinvx"}},{"ID":"20240612171022-q5mr1m1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171022-q5mr1m1","updated":"20240612171028"},"Children":[{"Type":"NodeText","Data":"鸢尾《新修本草》"}]},{"ID":"20240612171022-fz8dosw","Type":"NodeParagraph","Properties":{"id":"20240612171022-fz8dosw","updated":"20240612171022"},"Children":[{"Type":"NodeText","Data":"味苦，平，有毒。主蛊毒，邪气，鬼疰诸毒，破症瘕积聚大水，下三虫。疗头眩，杀鬼魅。一名乌园。生九嶷山谷，五月采。"}]},{"ID":"20240612171022-baq6qka","Type":"NodeParagraph","Properties":{"id":"20240612171022-baq6qka","updated":"20240612171022"},"Children":[{"Type":"NodeText","Data":"方家皆云，是夜干苗，无鸢尾之名，主疗亦异，此当别一种物。方亦有用，鸢头者即应是其根，疗体相似，而本草不显之。"}]},{"ID":"20240612171022-bhuwcnv","Type":"NodeParagraph","Properties":{"id":"20240612171022-bhuwcnv","updated":"20240612171022"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草叶似夜干而阔短，不抽长茎，花紫碧色，根有小毒，嚼之戟人咽喉，与夜干全别。人家亦种，所在有之。夜干花红，抽茎长，根黄有臼。今陶云由跋，正说鸢尾根茎也。"}]},{"ID":"20240612170831-3dq1uj7","Type":"NodeThematicBreak","Properties":{"id":"20240612170831-3dq1uj7"}},{"ID":"20240612171010-h1vxv48","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612171010-h1vxv48","updated":"20240612171015"},"Children":[{"Type":"NodeText","Data":"鸢尾《证类本草》"}]},{"ID":"20240612171010-047roya","Type":"NodeParagraph","Properties":{"id":"20240612171010-047roya","updated":"20240612171010"},"Children":[{"Type":"NodeText","Data":"味苦，平，有毒，主蛊毒邪气，鬼疰诸毒，破症瘕积聚，大水，下三虫，疗头眩，杀鬼魅。一名乌园。生九疑山谷。五月采。"}]},{"ID":"20240612171010-2pt9wp6","Type":"NodeParagraph","Properties":{"id":"20240612171010-2pt9wp6","updated":"20240612171010"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方家云是射干苗，无鸢尾之名。主疗亦异，当别一种物。方亦有用鸢头者，即应是其根。疗体相似，而本草不显之。唐本注云∶此草叶似射干而阔短，不抽长茎，花紫碧色。根似高良姜，皮黄肉白，有小毒。嚼之戟人咽喉，与射干全别。人家亦种，所在有之。射干花红，抽茎长，根黄有臼。今陶云由跋，正说鸢尾根、茎。臣禹锡等谨按蜀本云∶此草叶名鸢尾，根名鸢头，亦谓之鸢根。又《图经》云∶叶似射干，布地生。黑根似高良姜而节大，数个相连。今所在皆有。九月、十月采根，日干。"}]},{"ID":"20240612171010-apk0rqf","Type":"NodeParagraph","Properties":{"id":"20240612171010-apk0rqf","updated":"20240612171010"},"Children":[{"Type":"NodeText","Data":"图经文具射干条下。"}]},{"ID":"20240612171010-swv245n","Type":"NodeParagraph","Properties":{"id":"20240612171010-swv245n","updated":"20240612171010"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶鸢尾，主飞尸，游蛊着喉中，气欲绝者。以根削去皮，纳喉中，摩病处，令血出为佳。"}]},{"ID":"20240612171010-5izc0yk","Type":"NodeParagraph","Properties":{"id":"20240612171010-5izc0yk","updated":"20240612171010"},"Children":[{"Type":"NodeText","Data":"右鸢尾一种，古本所有，政和监本脱漏不载，今照根据嘉 监本补之于此。"}]},{"ID":"20240612170831-vg1dmzp","Type":"NodeThematicBreak","Properties":{"id":"20240612170831-vg1dmzp"}},{"ID":"20240612170958-v94p4d0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170958-v94p4d0","updated":"20240612171005"},"Children":[{"Type":"NodeText","Data":"鸢尾《医学入门》"}]},{"ID":"20240612170958-x1osczh","Type":"NodeParagraph","Properties":{"id":"20240612170958-x1osczh","updated":"20240612170958"},"Children":[{"Type":"NodeText","Data":"叶似射干而阔短，不抽长茎，布地而生。花紫碧色，根似良姜，皮黄肉白。味苦，平，有毒。主飞尸蛊毒，邪气鬼疰诸毒。破 瘕，积聚，去水，下三虫，疗头眩，杀鬼魅。十月采根，日干。"}]},{"ID":"20240612170831-ow61qcr","Type":"NodeThematicBreak","Properties":{"id":"20240612170831-ow61qcr"}},{"ID":"20240612170832-22cok2p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170832-22cok2p","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：鸢尾"}]},{"ID":"20240612170832-icq8nh3","Type":"NodeParagraph","Properties":{"id":"20240612170832-icq8nh3","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612170832-air4htx","Type":"NodeParagraph","Properties":{"id":"20240612170832-air4htx","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" Yuān Wěi"}]},{"ID":"20240612170832-d8yuk7k","Type":"NodeParagraph","Properties":{"id":"20240612170832-d8yuk7k","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612170832-n4oa9ky","Type":"NodeParagraph","Properties":{"id":"20240612170832-n4oa9ky","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 蓝蝴蝶、蛤蟆七、青蛙七、蜞马七、搜山狗、冷水丹、豆豉叶、扁竹叶、燕子花、中搜山虎、鸭屁股、土知母[四川]"}]},{"ID":"20240612170832-6bryse6","Type":"NodeParagraph","Properties":{"id":"20240612170832-6bryse6","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612170832-2g1smmr","Type":"NodeParagraph","Properties":{"id":"20240612170832-2g1smmr","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 鸢尾科鸢尾属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鸢尾"},{"Type":"NodeText","Data":"Iris tectorum Maxim.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根状茎"},{"Type":"NodeText","Data":"。全年可采，挖出根状茎，除去茎叶及须根，洗净，晒干，切段备用。"}]},{"ID":"20240612170832-9jlaet9","Type":"NodeParagraph","Properties":{"id":"20240612170832-9jlaet9","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612170832-hezbr9k","Type":"NodeParagraph","Properties":{"id":"20240612170832-hezbr9k","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 苦、辛，平。有小毒。"}]},{"ID":"20240612170832-dvvx23c","Type":"NodeParagraph","Properties":{"id":"20240612170832-dvvx23c","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612170832-u2stc20","Type":"NodeParagraph","Properties":{"id":"20240612170832-u2stc20","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 活血祛瘀，祛风利湿，解毒，消积。用于跌打损伤，风湿疼痛，咽喉肿痛，食积腹胀，疟疾；外用治痈疖肿毒，外伤出血。"}]},{"ID":"20240612170832-tfg5361","Type":"NodeParagraph","Properties":{"id":"20240612170832-tfg5361","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612170832-jz6gziv","Type":"NodeParagraph","Properties":{"id":"20240612170832-jz6gziv","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 3～5钱；外用适量，鲜根状茎捣烂外敷，或干品研末敷患处。"}]},{"ID":"20240612170832-jsv4142","Type":"NodeParagraph","Properties":{"id":"20240612170832-jsv4142","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612170832-unw2qtl","Type":"NodeParagraph","Properties":{"id":"20240612170832-unw2qtl","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612170832-otrev80","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170832-otrev80","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鸢尾"}]},{"ID":"20240612170832-yqijoj3","Type":"NodeParagraph","Properties":{"id":"20240612170832-yqijoj3","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612170832-ovltpvo","Type":"NodeParagraph","Properties":{"id":"20240612170832-ovltpvo","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" Yuān Wěi"}]},{"ID":"20240612170832-fgc0vfi","Type":"NodeParagraph","Properties":{"id":"20240612170832-fgc0vfi","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612170832-v9i62yj","Type":"NodeParagraph","Properties":{"id":"20240612170832-v9i62yj","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 乌园（《别录》），乌鸢（《纲目》），扁竹（《植物名实图考》），蓝蝴蝶（《广州植物志》），亦利麻（《广西中兽医药植》），扇把草（《民间常用草药汇编》），土知母（《四川中药志》），冷水丹、蛤蟆跳缺（江西《中草药学》），铁扁担（苏医《中草药手册》）。"}]},{"ID":"20240612170832-tzsfbfw","Type":"NodeParagraph","Properties":{"id":"20240612170832-tzsfbfw","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612170832-9l9zeto","Type":"NodeParagraph","Properties":{"id":"20240612170832-9l9zeto","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612170832-3s471ak","Type":"NodeParagraph","Properties":{"id":"20240612170832-3s471ak","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612170832-vg4rzq6","Type":"NodeParagraph","Properties":{"id":"20240612170832-vg4rzq6","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 为鸢尾科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鸢尾"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。夏、秋采收。"}]},{"ID":"20240612170832-ew7laxq","Type":"NodeParagraph","Properties":{"id":"20240612170832-ew7laxq","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612170832-li6p9b0","Type":"NodeParagraph","Properties":{"id":"20240612170832-li6p9b0","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 生于林下、山脚及溪边的潮湿地。我国大部分地区均有栽培。产广东、广西、四川、贵州等地。"}]},{"ID":"20240612170832-mjae83x","Type":"NodeParagraph","Properties":{"id":"20240612170832-mjae83x","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612170832-hfej4zx","Type":"NodeParagraph","Properties":{"id":"20240612170832-hfej4zx","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 多年生草本。根茎匍匐多节，节间短，浅黄色。叶互生，2列，剑形，长约30～45厘米，宽约2厘米。花青紫色，1～3朵排列成总状花序，花柄基部有一佛焰花苞，覆船状，长4～5厘米；远比花柄为长；花被6，2轮，筒部纤弱，长约3厘米，外轮3片圆形，直径可达5厘米，上面有鸡冠状突起，白色或蓝色，内轮3片较小，常为横形；雄蕊3，着生于外轮花被的基部，药线形；雌蕊1，子房下位，3室；花柱3分枝，花瓣状。蒴果长椭圆形，有6棱，长3～4厘米。种子多数，圆形，黑色。花期4～5月。果期10～11月。"}]},{"ID":"20240612170832-blq0n8z","Type":"NodeParagraph","Properties":{"id":"20240612170832-blq0n8z","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612170832-uxa51lq","Type":"NodeParagraph","Properties":{"id":"20240612170832-uxa51lq","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 干燥根茎呈扁圆柱形，表面灰棕色，有节，节上常有分歧，节间部分一端膨大，另一端缩小，膨大部分密生同心环纹，愈近顶端愈密。"}]},{"ID":"20240612170832-mvkws0u","Type":"NodeParagraph","Properties":{"id":"20240612170832-mvkws0u","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612170832-uo9xv3k","Type":"NodeParagraph","Properties":{"id":"20240612170832-uo9xv3k","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 叶含维生素C很多。花含恩比宁。"}]},{"ID":"20240612170832-dgkrbns","Type":"NodeParagraph","Properties":{"id":"20240612170832-dgkrbns","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"根茎含鸢尾黄酮甙、鸢尾黄酮新甙A、B、香荚兰己酮二葡萄糖甙。"}]},{"ID":"20240612170832-iw0bvg7","Type":"NodeParagraph","Properties":{"id":"20240612170832-iw0bvg7","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612170832-igjtsmr","Type":"NodeParagraph","Properties":{"id":"20240612170832-igjtsmr","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 辛苦，寒，有毒。"}]},{"ID":"20240612170832-3pvlaxh","Type":"NodeParagraph","Properties":{"id":"20240612170832-3pvlaxh","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240612170832-y9nw8ik","Type":"NodeParagraph","Properties":{"id":"20240612170832-y9nw8ik","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"有毒。\""}]},{"ID":"20240612170832-d98wjoe","Type":"NodeParagraph","Properties":{"id":"20240612170832-d98wjoe","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"③《贵阳民间药草》：\"辛，寒，微毒。\""}]},{"ID":"20240612170832-tln5wme","Type":"NodeParagraph","Properties":{"id":"20240612170832-tln5wme","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612170832-41ptbxl","Type":"NodeParagraph","Properties":{"id":"20240612170832-41ptbxl","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 体虚者慎服。"}]},{"ID":"20240612170832-2s4j1sm","Type":"NodeParagraph","Properties":{"id":"20240612170832-2s4j1sm","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612170832-u8wixzb","Type":"NodeParagraph","Properties":{"id":"20240612170832-u8wixzb","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 消积，破瘀，行水，解毒。治食滞胀满，症瘕积聚，臌胀，肿毒，痔瘘，跌打损伤。"}]},{"ID":"20240612170832-uig83n6","Type":"NodeParagraph","Properties":{"id":"20240612170832-uig83n6","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主破症瘕积聚，去水，下三虫。\""}]},{"ID":"20240612170832-l1925ba","Type":"NodeParagraph","Properties":{"id":"20240612170832-l1925ba","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗头眩。\""}]},{"ID":"20240612170832-fqhunyj","Type":"NodeParagraph","Properties":{"id":"20240612170832-fqhunyj","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"③《贵州民间方药集》：\"治臌胀病。\""}]},{"ID":"20240612170832-nt3ou9p","Type":"NodeParagraph","Properties":{"id":"20240612170832-nt3ou9p","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"④《民间常用草药汇编》：\"疗痔疮及狂犬病。\""}]},{"ID":"20240612170832-27qyv5c","Type":"NodeParagraph","Properties":{"id":"20240612170832-27qyv5c","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"⑤《中国药植图鉴》：\"敷肿毒。\""}]},{"ID":"20240612170832-epvyfgx","Type":"NodeParagraph","Properties":{"id":"20240612170832-epvyfgx","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"⑥江西《中草药学》：\"通便泄热，活血法瘀。\""}]},{"ID":"20240612170832-n47tl6n","Type":"NodeParagraph","Properties":{"id":"20240612170832-n47tl6n","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612170832-4nm043p","Type":"NodeParagraph","Properties":{"id":"20240612170832-4nm043p","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.3～1钱；或研末。外用：捣敷。"}]},{"ID":"20240612170832-6mtg5mi","Type":"NodeParagraph","Properties":{"id":"20240612170832-6mtg5mi","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612170832-kagtcjp","Type":"NodeParagraph","Properties":{"id":"20240612170832-kagtcjp","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" ①治食积饱胀：土知母一钱。研细，用白开水或兑酒吞服。（《贵阳民间药草》）"}]},{"ID":"20240612170832-udqwe01","Type":"NodeParagraph","Properties":{"id":"20240612170832-udqwe01","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"②治喉症、食积、血积：鸢尾根一至三钱。煎服。（江西《中草药学》）"}]},{"ID":"20240612170832-pkhxdkn","Type":"NodeParagraph","Properties":{"id":"20240612170832-pkhxdkn","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"③治水道不通：扁竹根（水边生，紫花者为佳）研自然汁一盏服，通即止药。不可便服补药。（《普济方》）"}]},{"ID":"20240612170832-e8zg10g","Type":"NodeParagraph","Properties":{"id":"20240612170832-e8zg10g","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"④治跌打损伤：鸢尾根一至三钱。研末或磨汁，冷水送服，故又名\"冷水丹\"。（江西《中草药学》）"}]},{"ID":"20240612170832-dh5xt1j","Type":"NodeParagraph","Properties":{"id":"20240612170832-dh5xt1j","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612170832-1rv3jot","Type":"NodeParagraph","Properties":{"id":"20240612170832-1rv3jot","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612170832-0ik40oe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612170832-0ik40oe","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鸢尾"}]},{"ID":"20240612170832-zwijj2f","Type":"NodeParagraph","Properties":{"id":"20240612170832-zwijj2f","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612170832-0ovlw9i","Type":"NodeParagraph","Properties":{"id":"20240612170832-0ovlw9i","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" Yuān Wěi"}]},{"ID":"20240612170832-3l9vfcs","Type":"NodeParagraph","Properties":{"id":"20240612170832-3l9vfcs","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612170832-ows781v","Type":"NodeParagraph","Properties":{"id":"20240612170832-ows781v","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 乌园、乌鸢、紫蝴蝶、蓝蝴蝶、老鸦扇、扁竹叶、九把刀、燕子花、扁竹兰、扁竹、蒲扇风、老君扇、扁柄草、铁扁担、交剪七、鲤鱼尾"}]},{"ID":"20240612170832-vxqj5yr","Type":"NodeParagraph","Properties":{"id":"20240612170832-vxqj5yr","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612170832-gdetmss","Type":"NodeParagraph","Properties":{"id":"20240612170832-gdetmss","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" Rhizome of Roof Iris"}]},{"ID":"20240612170832-35bse4a","Type":"NodeParagraph","Properties":{"id":"20240612170832-35bse4a","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612170832-x3l4civ","Type":"NodeParagraph","Properties":{"id":"20240612170832-x3l4civ","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612170832-l6b94xs","Type":"NodeParagraph","Properties":{"id":"20240612170832-l6b94xs","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：鸢尾，叶似射干而阔短，不抽长茎，花紫碧色，根似高良姜，皮黄肉白。有小毒，嚼之戟人咽喉，与射干全别。人家亦种，所在有之，射干花红，抽茎长，根黄有臼。"}]},{"ID":"20240612170832-tsbmlqa","Type":"NodeParagraph","Properties":{"id":"20240612170832-tsbmlqa","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"2.《蜀本草》：此草叶名鸢尾，根名鸢头，亦谓之鸢根。"}]},{"ID":"20240612170832-x8l3x4z","Type":"NodeParagraph","Properties":{"id":"20240612170832-x8l3x4z","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"3.《本草图经》：鸢尾布地而生，叶扁，阔于射干。今在处有，大类蛮姜也。"}]},{"ID":"20240612170832-wmm9w3w","Type":"NodeParagraph","Properties":{"id":"20240612170832-wmm9w3w","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612170832-kybn95x","Type":"NodeParagraph","Properties":{"id":"20240612170832-kybn95x","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鸢尾科植物鸢尾的叶或全草。"}]},{"ID":"20240612170832-manqsea","Type":"NodeParagraph","Properties":{"id":"20240612170832-manqsea","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Iris tectorum Maxim.[I.chinensis Bunge]"}]},{"ID":"20240612170832-iyi2tyd","Type":"NodeParagraph","Properties":{"id":"20240612170832-iyi2tyd","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"采收和储藏：夏、秋季采收，洗净，切碎鲜用。"}]},{"ID":"20240612170832-v81emla","Type":"NodeParagraph","Properties":{"id":"20240612170832-v81emla","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612170832-5hu8erc","Type":"NodeParagraph","Properties":{"id":"20240612170832-5hu8erc","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于林缘、水边湿地及向阳坡地。"}]},{"ID":"20240612170832-i7juirn","Type":"NodeParagraph","Properties":{"id":"20240612170832-i7juirn","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于西南及山西、陕西、甘肃、江苏、安徽、浙江、江西、福建、湖北、湖南、广西等地。"}]},{"ID":"20240612170832-0t09wvt","Type":"NodeParagraph","Properties":{"id":"20240612170832-0t09wvt","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612170832-96nlc7l","Type":"NodeParagraph","Properties":{"id":"20240612170832-96nlc7l","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 鸢尾，多年生草本。高35-80cm。植株基部围有老叶残留的膜质叶鞘及纤维。根茎较短，肥厚，常呈蛇头状，少为不规则的块状，环纹较密。叶基生；叶片剑形，长15-50cm，宽1.5-3.5cm，先端渐尖，基部鞘状，套叠排成2列，有数条不明显的纵脉。花茎高20-40cm，与叶近等长，中下部有1-2片茎生叶，顶端有1-2个分枝；苞片2-3；花梗长1-2cm；花蓝紫色，直径达10cm，花被裂片6，2轮排列，外轮裂片倒卵形或近圆形，外折，中脉具不整齐橘黄色的鸡冠状突起，内轮裂片较小，倒卵形，拱形直立，花被管长3-4cm，雄蕊3，长2.5-3cm，花药黄色；子房下位，3室，花柱分枝3，花瓣状，蓝色，覆盖着雄蕊，先端2裂，边缘流苏状。蒴果，椭圆状至倒卵状，长4-6cm，直径2-2.5cm，有6条明显的肋；种子梨形，黑褐色，种皮皱裼。花期4-5月，果期6-7月。"}]},{"ID":"20240612170832-q2l8xc1","Type":"NodeParagraph","Properties":{"id":"20240612170832-q2l8xc1","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612170832-8ro8dt1","Type":"NodeParagraph","Properties":{"id":"20240612170832-8ro8dt1","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 生物学特性 喜向阳，耐半荫，对湿润而排水良好的各种土壤均能适应。春季旺盛期需湿润。 栽培技术 以分株繁殖为主，也可用种子繁殖。分株繁殖：宜于花后休眠期内即新根萌发前进行，于9月初将一、二年生根茎横切成段，每段带2-3个芽，株距25-30cm，栽时根要压紧，不宜过深，根茎的上部宜暴露于上表以获得充足的阳光。生育期要注意供应充足的水分，4月开花前和6月花凋后各施1次追肥，但花凋后地下部休眠时应暂停浇水。种子繁殖：春、秋均可，于露地冷床中播种，4-6星期出苗，种子发芽不整齐，需细致管理。幼苗4-5片叶带土移栽。"}]},{"ID":"20240612170832-vazba0v","Type":"NodeParagraph","Properties":{"id":"20240612170832-vazba0v","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612170832-kg8b0yg","Type":"NodeParagraph","Properties":{"id":"20240612170832-kg8b0yg","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 叶含大量维生素（belamcandaquinone），鸢尾烯（iristectorene）A-H，鸢尾酮（iristectorone）A-H及单环三萜酯类化合物。挥发油含十四酸甲酯（irisquinone），射干醌（belamcandaquinone），鸢尾烯（tetradecanoic acid），5-庚基二氢-2（3H）-呋喃酮[5-heptyldihydro-2（3H）-furanone]，6-庚基四氢-2H-吡喃-2-酮（6-heptyltetrahydro-2H-pyran-2-one），二十一烷（heneicosane），3-羟基-苯甲醛肟（3-hydroxyl-benfromoxine）。"}]},{"ID":"20240612170832-f17p4n3","Type":"NodeParagraph","Properties":{"id":"20240612170832-f17p4n3","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612170832-zfyu803","Type":"NodeParagraph","Properties":{"id":"20240612170832-zfyu803","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 1.消炎作用：鸢尾黄酮甙，在试管中有抗透明质酸酶的作用，而且不为半胱氨酸所阻断，它还能抑制大鼠的透明质酸性的浮肿而不抑制角叉菜胶性浮肿，对鼠因腹腔注射氮芥引起的腹水渗出亦有抑制作用。"}]},{"ID":"20240612170832-iga8mj4","Type":"NodeParagraph","Properties":{"id":"20240612170832-iga8mj4","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"2.其他作用：鸢尾黄酮甙，能促进家兔唾液分泌，注射较口服的作用更快而强。"}]},{"ID":"20240612170832-skqhotg","Type":"NodeParagraph","Properties":{"id":"20240612170832-skqhotg","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612170832-0bsfro5","Type":"NodeParagraph","Properties":{"id":"20240612170832-0bsfro5","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 辛；苦；凉；有毒"}]},{"ID":"20240612170832-qjx10vq","Type":"NodeParagraph","Properties":{"id":"20240612170832-qjx10vq","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612170832-k1foxjd","Type":"NodeParagraph","Properties":{"id":"20240612170832-k1foxjd","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 体虚便溏及孕妇禁服。"}]},{"ID":"20240612170832-nwhg8qw","Type":"NodeParagraph","Properties":{"id":"20240612170832-nwhg8qw","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612170832-ouqr3xk","Type":"NodeParagraph","Properties":{"id":"20240612170832-ouqr3xk","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 清热解毒；祛风利湿；消肿止痛。主咽喉肿痛；肝炎；肝肿大；膀胱炎；风湿痛；跌打肿痛；疮疖；皮肤瘙痒"}]},{"ID":"20240612170832-pup6jci","Type":"NodeParagraph","Properties":{"id":"20240612170832-pup6jci","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612170832-nofi9t9","Type":"NodeParagraph","Properties":{"id":"20240612170832-nofi9t9","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g；或绞汁，或研末。外用：适量，捣敷；或煎汤洗。"}]},{"ID":"20240612170832-57csjzp","Type":"NodeParagraph","Properties":{"id":"20240612170832-57csjzp","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612170832-oiaw884","Type":"NodeParagraph","Properties":{"id":"20240612170832-oiaw884","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 1.《神农本草经》：主破症瘕积聚，去水，下三虫。"}]},{"ID":"20240612170832-r8d3tse","Type":"NodeParagraph","Properties":{"id":"20240612170832-r8d3tse","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"2.《名医别录》：疗头眩。"}]},{"ID":"20240612170832-m6sdjon","Type":"NodeParagraph","Properties":{"id":"20240612170832-m6sdjon","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"3.《贵州民间方药集》：治臌胀病。"}]},{"ID":"20240612170832-hf0caml","Type":"NodeParagraph","Properties":{"id":"20240612170832-hf0caml","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"4.《民间常用草药汇编》：疗痔疮及狂犬病。"}]},{"ID":"20240612170832-7jpinyn","Type":"NodeParagraph","Properties":{"id":"20240612170832-7jpinyn","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"5.《中国药植图鉴》：敷肿毒。"}]},{"ID":"20240612170832-0rfkgma","Type":"NodeParagraph","Properties":{"id":"20240612170832-0rfkgma","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"6.江西《中草药学》：通便泄热，活血祛瘀。"}]},{"ID":"20240612170832-p7kh11p","Type":"NodeParagraph","Properties":{"id":"20240612170832-p7kh11p","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612170832-h673wdb","Type":"NodeParagraph","Properties":{"id":"20240612170832-h673wdb","updated":"20240612170832"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612170834-n8ifboh","Type":"NodeThematicBreak","Properties":{"id":"20240612170834-n8ifboh"}},{"ID":"20240612170835-vzh2177","Type":"NodeParagraph","Properties":{"id":"20240612170835-vzh2177"}}]}