 9-20240724132832-cxxvrnk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 407px;\" parent-style=\"width: 417px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724133638-gt0guu7","Type":"NodeParagraph","Properties":{"id":"20240724133638-gt0guu7","updated":"20240724133638"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 412px;","style":"width: 402px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"附子2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/附子2-20240627164649-vxu80wj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 402px;\" parent-style=\"width: 412px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 460px;","style":"width: 450px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240619182307-i0rz9nm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 450px;\" parent-style=\"width: 460px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 395px;","style":"width: 385px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川乌 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川乌 5-20240724132343-qysc350.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 385px;\" parent-style=\"width: 395px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724133638-gzsr227","Type":"NodeParagraph","Properties":{"id":"20240724133638-gzsr227","updated":"20240724133638"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 833px;","style":"width: 823px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627165647-2itbuyq.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 823px;\" parent-style=\"width: 833px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 357px;","style":"width: 347px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川乌 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川乌 4-20240724132006-fxxd1lw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 347px;\" parent-style=\"width: 357px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724133638-caa49r7","Type":"NodeParagraph","Properties":{"id":"20240724133638-caa49r7","updated":"20240724133638"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 590px;","style":"width: 580px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川乌 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川乌 1-20240724131431-4kx6gl2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 580px;\" parent-style=\"width: 590px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"川乌 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/川乌 2-20240724131817-9xa407l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240724133638-5oqkpi1","Type":"NodeParagraph","Properties":{"id":"20240724133638-5oqkpi1","updated":"20240724133638"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1098px;","style":"width: 1088px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"附子"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/附子-20240724133243-jfvcvmd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1088px;\" parent-style=\"width: 1098px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627165500-9my8x4r","Type":"NodeParagraph","Properties":{"id":"20240627165500-9my8x4r","updated":"20240627165500"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 465px;","style":"width: 455px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"附子6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/附子6-20240627164943-dlt5r0x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 455px;\" parent-style=\"width: 465px;\"}"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 742px;","style":"width: 732px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"附子3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/附子3-20240627164746-t9cj01f.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 732px;\" parent-style=\"width: 742px;\"}"}]},{"ID":"20240627170630-welbfma","Type":"NodeParagraph","Properties":{"id":"20240627170630-welbfma","updated":"20240822100335"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：天雄外形偏瘦；根据谭杰中解释，附子本草种久以后，根下附子不把营养散开分生出去，继续保持不变即为天雄；（详情可参考笔记-谭杰中-伤寒杂病论-药势-搜索“天雄”）；也有说法为三年附子,四年乌头,五年天雄；"}]},{"ID":"20240612165032-qbjp09g","Type":"NodeThematicBreak","Properties":{"id":"20240612165032-qbjp09g"}},{"ID":"20240612165212-b5env3l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165212-b5env3l","updated":"20240612165216"},"Children":[{"Type":"NodeText","Data":"天雄《神农本草经》"}]},{"ID":"20240612165212-myd6j27","Type":"NodeParagraph","Properties":{"id":"20240612165212-myd6j27","updated":"20240612165212"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240612165212-sc6dpmy","Type":"NodeParagraph","Properties":{"id":"20240612165212-sc6dpmy","updated":"20240612165212"},"Children":[{"Type":"NodeText","Data":"主大风，寒湿痹，沥节痛，拘挛，缓急，破积聚，邪气，金创，强筋骨，轻身健行。一名白幕。（《御览》引云，长阴气，强志，令人武勇，力作不倦，《大观本》，作黑字）生山谷。"}]},{"ID":"20240612165212-xray1fu","Type":"NodeParagraph","Properties":{"id":"20240612165212-xray1fu","updated":"20240612165212"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生少室，二月采根，阴干。"}]},{"ID":"20240612165212-k7fxivc","Type":"NodeParagraph","Properties":{"id":"20240612165212-k7fxivc","updated":"20240612165212"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：（上艹下左米右焦），奚毒，附子也，一岁为萴子，二岁为乌喙，三岁为附子，四岁为乌头，五岁为天雄。《淮南子》缪称训云：天雄，乌喙，药之凶毒也，良医以活人。"}]},{"ID":"20240612165223-bxe5v9l","Type":"NodeThematicBreak","Properties":{"id":"20240612165223-bxe5v9l"}},{"ID":"20240612165224-pq55v7f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165224-pq55v7f","updated":"20240612165229"},"Children":[{"Type":"NodeText","Data":"天雄《新修本草》"}]},{"ID":"20240612165224-2hvuh54","Type":"NodeParagraph","Properties":{"id":"20240612165224-2hvuh54","updated":"20240612165224"},"Children":[{"Type":"NodeText","Data":"味辛、甘，温、大温，有大毒。主大风，寒湿痹，历节痛，拘挛缓急，破积聚，邪气，金创，强筋骨，轻身，健行。"}]},{"ID":"20240612165224-2qrma06","Type":"NodeParagraph","Properties":{"id":"20240612165224-2qrma06","updated":"20240612165224"},"Children":[{"Type":"NodeText","Data":"疗头面风去来疼痛，心腹结积，关节重，不能行步，除骨间痛，长作不倦，又堕胎。一名白幕。"}]},{"ID":"20240612165224-eao4ybs","Type":"NodeParagraph","Properties":{"id":"20240612165224-eao4ybs","updated":"20240612165224"},"Children":[{"Type":"NodeText","Data":"生少室山谷。二月采根，阴干。"}]},{"ID":"20240612165224-1969vdp","Type":"NodeParagraph","Properties":{"id":"20240612165224-1969vdp","updated":"20240612165224"},"Children":[{"Type":"NodeText","Data":"远志为之使，恶腐婢。今采用八月中旬。天雄似附子，细而长者便是，长者乃至三、四寸许，此与乌头、附子三种，本并出建平，谓为三建。今宜都 山最好，谓为西建。钱塘间者相似，故曰西水犹胜东白也。"}]},{"ID":"20240612165224-4qpwcvh","Type":"NodeParagraph","Properties":{"id":"20240612165224-4qpwcvh","updated":"20240612165224"},"Children":[{"Type":"NodeText","Data":"其用灰杀之时，有冰强者并不佳。"}]},{"ID":"20240612165224-9vzmgn7","Type":"NodeParagraph","Properties":{"id":"20240612165224-9vzmgn7","updated":"20240612165224"},"Children":[{"Type":"NodeText","Data":"〔谨案〕天雄、附子、乌头等，并以蜀道绵州、龙州出者佳。余处纵有造得者，气力劣弱，都不相似。江南来者，全不堪用。陶以三物俱出建平故名之，非也。按国语置堇于肉，注云乌头也。《尔雅》云∶芨，堇草。郭注云∶乌头苗也，此物本出蜀汉，其本名堇，今讹为建，遂以建平释之。又石龙芮叶似堇草，故名水堇。今复说为水茛，亦作建音，此岂复生建平耶言《本草音义》亦论之。天雄、附子、侧子并同用八月采造。其乌头四月上旬，今云二月采，恐非时也。"}]},{"ID":"20240612165326-7l0kdqx","Type":"NodeThematicBreak","Properties":{"id":"20240612165326-7l0kdqx"}},{"ID":"20240612165327-n700vbo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165327-n700vbo","updated":"20240612165334"},"Children":[{"Type":"NodeText","Data":"天雄《本经逢原》"}]},{"ID":"20240612165327-yvnmwi6","Type":"NodeParagraph","Properties":{"id":"20240612165327-yvnmwi6","updated":"20240612165327"},"Children":[{"Type":"NodeText","Data":"辛温，大毒。即附子之独颗无附，大倍附子者，制法与附子同。"}]},{"ID":"20240612165327-2yl15wi","Type":"NodeParagraph","Properties":{"id":"20240612165327-2yl15wi","updated":"20240612165327"},"Children":[{"Type":"NodeText","Data":"《本经》主大风寒湿痹，历节痛拘挛缓急，破积聚邪气金疮，强骨髓，轻身健行。"}]},{"ID":"20240612165327-ce3pfky","Type":"NodeParagraph","Properties":{"id":"20240612165327-ce3pfky","updated":"20240612165327"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"天雄禀纯阳之性，补命门三焦，壮阳精，强肾气过于附子，故《本经》用以治大风寒开湿痹历节拘挛诸病，阳气衰痿者佐人参用之。天雄、附子性皆下行，若上焦阳虚者，当用参、 ，不当用此也。且乌、附之尖皆是向下生者，其脐乃向上生苗处。宗 、元素皆误认尖为上，惟震亨以为下部之佐者得之。《肘后》三建汤治元阳素虚，寒邪外入，厥冷脉沉及伤寒阴毒，川乌、附子、天雄炮制等分，每服四钱，加生姜十五片温服。《金匮》治男子失精，用天雄、龙骨、桂枝、白术为散，酒服半钱；淮南用天雄一枚，纳雄鸡腹中，煮烂捣，食之令人勇，取壮肝肾之气也。"}]},{"ID":"20240612165416-k0int3e","Type":"NodeThematicBreak","Properties":{"id":"20240612165416-k0int3e"}},{"ID":"20240612165417-nqbynfd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165417-nqbynfd","updated":"20240612165423"},"Children":[{"Type":"NodeText","Data":"天雄《药性切用》"}]},{"ID":"20240612165417-rro5ut6","Type":"NodeParagraph","Properties":{"id":"20240612165417-rro5ut6","updated":"20240612165417"},"Children":[{"Type":"NodeText","Data":"独颗无附，即雄附子。性味虽雄，但能温经逐冷，不能顷刻回阳，湿痹寒甚宜之。"}]},{"ID":"20240612165352-y30m37b","Type":"NodeThematicBreak","Properties":{"id":"20240612165352-y30m37b"}},{"ID":"20240612165354-7usp1sv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165354-7usp1sv","updated":"20240612165359"},"Children":[{"Type":"NodeText","Data":"天雄《本草撮要》"}]},{"ID":"20240612165354-kj0vvuo","Type":"NodeParagraph","Properties":{"id":"20240612165354-kj0vvuo","updated":"20240612165354"},"Children":[{"Type":"NodeText","Data":"味辛温．入手厥阴少阳经．功专治一切风．得乌头、附子治元阳虚惫．得白术、桂枝、龙骨疗男子失精．得乌头、黑豆．治大风恶癞．"}]},{"ID":"20240612165340-98jx318","Type":"NodeThematicBreak","Properties":{"id":"20240612165340-98jx318"}},{"ID":"20240612165341-jh1oe05","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165341-jh1oe05","updated":"20240612165346"},"Children":[{"Type":"NodeText","Data":"天雄《得配本草》"}]},{"ID":"20240612165341-els5g0l","Type":"NodeParagraph","Properties":{"id":"20240612165341-els5g0l","updated":"20240612165341"},"Children":[{"Type":"NodeText","Data":"远志为之使。恶腐婢。忌豉汁。"}]},{"ID":"20240612165341-fdmuufn","Type":"NodeParagraph","Properties":{"id":"20240612165341-fdmuufn","updated":"20240612165341"},"Children":[{"Type":"NodeText","Data":"辛，热，有大毒。通九窍，利皮肤。治风痰冷痹，发汗，又能止阴汗，亦风家之要药。"}]},{"ID":"20240612165341-bv96r87","Type":"NodeParagraph","Properties":{"id":"20240612165341-bv96r87","updated":"20240612165341"},"Children":[{"Type":"NodeText","Data":"始种不生附子、侧子，经年独长大者，为天雄。制法与附子同。"}]},{"ID":"20240612165313-oanzubp","Type":"NodeThematicBreak","Properties":{"id":"20240612165313-oanzubp"}},{"ID":"20240612165314-92ftin0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165314-92ftin0","updated":"20240612165319"},"Children":[{"Type":"NodeText","Data":"天雄《医学入门》"}]},{"ID":"20240612165314-6es5w1g","Type":"NodeParagraph","Properties":{"id":"20240612165314-6es5w1g","updated":"20240612165314"},"Children":[{"Type":"NodeText","Data":"天雄壮阳散寒湿，上疗头面风邪急，侧子专治偏痹风，疮 痈肿效可立。"}]},{"ID":"20240612165314-ns3w1mk","Type":"NodeParagraph","Properties":{"id":"20240612165314-ns3w1mk","updated":"20240612165314"},"Children":[{"Type":"NodeText","Data":"东垣云∶天雄散寒，为去湿助精阳之药。凡上焦虚阳，头面风去来疼痛，喉痹，背脊伛偻，胸膈痰水，气喘促急，霍乱，必用之。久服令人心雄，力作不倦，故名。余与乌、附同，但天雄走上，乌、附达下。取身全、短、无尖，周匝有附子孕十一个，皮苍色者佳。凡丸，炮去皮尖、底须，汤药和皮生用亦佳。远志为使。恶腐婢，忌豉汁。侧子，专治腰脚冷痹，半身不遂及遍身风疹，颈上鼠 ，一如痈肿皆验。余与乌、附相同。"}]},{"ID":"20240612165303-eb9maig","Type":"NodeThematicBreak","Properties":{"id":"20240612165303-eb9maig"}},{"ID":"20240612165304-cv8s2vv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165304-cv8s2vv","updated":"20240612165309"},"Children":[{"Type":"NodeText","Data":"天雄《增广和剂局方药性总论》"}]},{"ID":"20240612165304-6wlnlib","Type":"NodeParagraph","Properties":{"id":"20240612165304-6wlnlib","updated":"20240612165304"},"Children":[{"Type":"NodeText","Data":"味辛甘，温，大温，有大毒。主大风，寒湿痹，历节痛，拘挛缓急，破积聚邪气，强筋骨，轻身健行，疗头面风去来疼痛，心腹结积，关节重不能行步，除骨间痛，长强志，令人武勇，力作不倦，又堕胎。《药性论》云∶君。忌∶豉汁。大热，有制用之。能治风痰冷痹，软脚毒风，能止气喘促急。杀∶禽虫毒。日华子云∶治一切阳道，暖水脏，补腰膝，益精明目，通九窍，利皮肤，调血脉，四肢不遂，破 癖症结脓止痛，续骨，消瘀血，补冷气虚损，霍乱转筋，背脊偻伛，消风痰，下胸膈水，发汗阴汗，炮含治喉痹。远志为之使。恶∶腐婢。"}]},{"ID":"20240612165249-anbcfe0","Type":"NodeThematicBreak","Properties":{"id":"20240612165249-anbcfe0"}},{"ID":"20240612165251-ovecosy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165251-ovecosy","updated":"20240612165258"},"Children":[{"Type":"NodeText","Data":"天雄《玉楸药解》"}]},{"ID":"20240612165251-ubdynkn","Type":"NodeParagraph","Properties":{"id":"20240612165251-ubdynkn","updated":"20240612165251"},"Children":[{"Type":"NodeText","Data":"味辛，性温，入足少阴肾、足厥阴肝经。驱寒泻湿，秘精壮阳，温肾荣筋，治阳痿精滑、膝挛腰痛，心腹疼痛、胸膈痰水，续筋接骨，化癖消癥，排痈疽脓血，起风痹瘫痪，治霍乱转筋。"}]},{"ID":"20240612165251-w3o3uxd","Type":"NodeParagraph","Properties":{"id":"20240612165251-w3o3uxd","updated":"20240612165251"},"Children":[{"Type":"NodeText","Data":"天雄即附子长大者，制法与附子同，煨，去皮脐，切片，隔纸焙干。稍生服之，则麻木昏晕。"}]},{"ID":"20240612165235-218ocwh","Type":"NodeThematicBreak","Properties":{"id":"20240612165235-218ocwh"}},{"ID":"20240612165236-8xuubik","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165236-8xuubik","updated":"20240612165241"},"Children":[{"Type":"NodeText","Data":"天雄《本草纲目》"}]},{"ID":"20240612165236-v7whfj1","Type":"NodeParagraph","Properties":{"id":"20240612165236-v7whfj1","updated":"20240612165236"},"Children":[{"Type":"NodeText","Data":"「释名」白幕。"}]},{"ID":"20240612165236-m3gumfn","Type":"NodeParagraph","Properties":{"id":"20240612165236-m3gumfn","updated":"20240612165236"},"Children":[{"Type":"NodeText","Data":"「气味」辛、温、有大毒。"}]},{"ID":"20240612165236-d6cdrw2","Type":"NodeParagraph","Properties":{"id":"20240612165236-d6cdrw2","updated":"20240612165236"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612165236-q1jk7vk","Type":"NodeParagraph","Properties":{"id":"20240612165236-q1jk7vk","updated":"20240612165236"},"Children":[{"Type":"NodeText","Data":"1、元阳虚损（寒邪外攻，手足厥冷，大便滑数，小便白浑，六脉沉微）。用乌头、附子、天雄一起炮制并去皮脐，等分咬细，每服四钱，加水二碗、姜十五片，煎至成，温服。此方名“三建汤”。"}]},{"ID":"20240612165236-ozv33ei","Type":"NodeParagraph","Properties":{"id":"20240612165236-ozv33ei","updated":"20240612165236"},"Children":[{"Type":"NodeText","Data":"2、男子失精。用天雄三两（炮）、白术八两、桂枝六两、龙骨三两，共三细。每服半钱，酒送下。"}]},{"ID":"20240612165236-1fb05st","Type":"NodeParagraph","Properties":{"id":"20240612165236-1fb05st","updated":"20240612165236"},"Children":[{"Type":"NodeText","Data":"3、大风癞。用天雄、乌头的苗及根，去土勿洗，捣成汁。另取细粒黑豆（不脱皮者）浸叶中一夜。次日取豆晒干，如此七浸七晒，可供服用。开始时每次吞服三枚，以后渐加至六七枚。禁忌猪鸡肉及蒜，犯之即死。"}]},{"ID":"20240612165032-qaku6b8","Type":"NodeThematicBreak","Properties":{"id":"20240612165032-qaku6b8"}},{"ID":"20240612165202-6a1wfe8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165202-6a1wfe8","updated":"20240612165207"},"Children":[{"Type":"NodeText","Data":"天雄《本草乘雅半偈》"}]},{"ID":"20240612165202-edjy7wm","Type":"NodeParagraph","Properties":{"id":"20240612165202-edjy7wm","updated":"20240612165202"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240612165202-x4ol6mq","Type":"NodeParagraph","Properties":{"id":"20240612165202-x4ol6mq","updated":"20240612165202"},"Children":[{"Type":"NodeText","Data":"【气味】辛温，有大毒。"}]},{"ID":"20240612165202-3g3u12c","Type":"NodeParagraph","Properties":{"id":"20240612165202-3g3u12c","updated":"20240612165202"},"Children":[{"Type":"NodeText","Data":"【主治】主大风寒，湿痹，历节痛，拘挛缓急，破积聚邪气，金疮，强筋骨，轻身，健行。"}]},{"ID":"20240612165202-h946fbf","Type":"NodeParagraph","Properties":{"id":"20240612165202-h946fbf","updated":"20240612165202"},"Children":[{"Type":"NodeText","Data":"【核】曰∶不生附侧，经年独长而大者，天雄也。生成已具附子条内。修事如附子法。"}]},{"ID":"20240612165202-7hvrsw1","Type":"NodeParagraph","Properties":{"id":"20240612165202-7hvrsw1","updated":"20240612165202"},"Children":[{"Type":"NodeText","Data":"远志先人云∶合名与形，当属阳中之阳，只能助长，不能化育，命门之用药也。"}]},{"ID":"20240612165202-cwgyc12","Type":"NodeParagraph","Properties":{"id":"20240612165202-cwgyc12","updated":"20240612165202"},"Children":[{"Type":"NodeText","Data":"【 】曰∶天以体言，雄以用言，不杂于阴柔，不惑于邪乱者也。一名白幕，幕者，军旅行舍，喻天行健，自强不息之象也。主轻身健行，望见其雄武矣。若大风、寒湿痹证，及积聚邪气金疮，嫌于无阳者，乃得行险而不失其正。"}]},{"ID":"20240612165032-0qw6wd6","Type":"NodeThematicBreak","Properties":{"id":"20240612165032-0qw6wd6"}},{"ID":"20240612165152-stvjs0v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165152-stvjs0v","updated":"20240612165157"},"Children":[{"Type":"NodeText","Data":"天雄《本草崇原》"}]},{"ID":"20240612165152-xgmq99l","Type":"NodeParagraph","Properties":{"id":"20240612165152-xgmq99l","updated":"20240612165152"},"Children":[{"Type":"NodeText","Data":"气味辛温，有大毒。主治大风，寒湿痹，历节痛，拘挛缓急，破积聚邪气，金疮，强筋骨，轻身健行。"}]},{"ID":"20240612165152-2cc2lpm","Type":"NodeParagraph","Properties":{"id":"20240612165152-2cc2lpm","updated":"20240612165152"},"Children":[{"Type":"NodeText","Data":"（附子种在土中，不生侧子，经年独长大者，故曰雄也。土人种附子，地出天雄，便为不利，如养蚕而成白僵也。时俗咸谓一两外者为天雄，不知天雄长三四寸许，旁不生子，形状各异。）"}]},{"ID":"20240612165152-sz1h7ta","Type":"NodeParagraph","Properties":{"id":"20240612165152-sz1h7ta","updated":"20240612165152"},"Children":[{"Type":"NodeText","Data":"天雄、附子，《本经》主治稍异，而旨则同，故不加释。"}]},{"ID":"20240612165152-w4qqor0","Type":"NodeParagraph","Properties":{"id":"20240612165152-w4qqor0","updated":"20240612165152"},"Children":[{"Type":"NodeText","Data":"（李士材曰∶天雄之用，与附子相仿，但功力略逊耳。李时珍曰∶乌头、附子、天雄皆是补下焦命门阳虚之药，补下所以益上也。若是上焦阳虚，即属心脾之分，当用参 ，不当用天雄也。乌附天雄之尖皆是向下，其气下行，其脐乃向上，生苗之处。寇宗 言其不肯就下，张元素言其补上焦阳虚，皆是误认尖为上耳。唯朱震亨以为下部之佐者得之，而未发出此义。卢子由曰∶天以体言，雄以用言，不杂于阴柔，不惑于邪乱。若夫风寒湿痹证，及积聚邪气、金疮，嫌于无阳者，乃得行险而不失其正。）"}]},{"ID":"20240612165032-czpy80o","Type":"NodeThematicBreak","Properties":{"id":"20240612165032-czpy80o"}},{"ID":"20240612165138-e7vurrw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165138-e7vurrw","updated":"20240612165144"},"Children":[{"Type":"NodeText","Data":"天雄《证类本草》"}]},{"ID":"20240612165138-m8y0760","Type":"NodeParagraph","Properties":{"id":"20240612165138-m8y0760","updated":"20240612165138"},"Children":[{"Type":"NodeText","Data":"味辛、甘，温，大温，有大毒。主大风，寒湿痹，历节痛，拘挛缓急，破积聚邪气，金疮，强筋骨，轻身健行，疗头面风去来疼痛，心腹结积，关节重，不能行步，除骨间痛，长阴气，强志，令人武勇力作不倦。又堕胎。一名白幕。生少室山谷。二月采根，阴干。（远志为之使，恶腐婢。）"}]},{"ID":"20240612165138-zxilaxq","Type":"NodeParagraph","Properties":{"id":"20240612165138-zxilaxq","updated":"20240612165138"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶今采用八月中旬。天雄似附子，细而长便是。长者乃至三、四寸许。此与乌头、附子三种，本并出建平，故谓之三建。今宜都 山最好，谓为西建。钱塘间者谓之东建，气力劣弱不相似。故曰西冰犹胜东白也。其用灰杀之，时有冰强（巨两切）者，不佳。唐本注云∶天雄、附子、乌头等，并以蜀道绵州、龙州出者佳。余处纵有造得者，力弱，都不相似。"}]},{"ID":"20240612165138-g7nxyoa","Type":"NodeParagraph","Properties":{"id":"20240612165138-g7nxyoa","updated":"20240612165138"},"Children":[{"Type":"NodeText","Data":"江南来者，全不堪用。陶以三物俱出建平故名之，非也。按国语置堇于肉，注云∶乌头也。"}]},{"ID":"20240612165138-k7c6xw9","Type":"NodeParagraph","Properties":{"id":"20240612165138-k7c6xw9","updated":"20240612165138"},"Children":[{"Type":"NodeText","Data":"为建，遂以建平释之。又石龙芮叶似堇，故名水堇。今复为水莨，赤作建音。此岂复生建平耶，检字书，又无莨字，甄立言《本草音义》亦论之。天雄、附子、侧子并同用。八月采造，其乌头四月上旬，今云二月采，恐非时也。臣禹锡等谨按淮南子云∶天雄，雄鸡志气益注云，取天雄三枚，纳雄鸡肠中，捣生食之，令人勇。药性论云∶天雄，君，忌豉汁，大热，有大毒。干姜制，用之能治风痰，冷痹，软脚，毒风，能止气喘促急，杀禽虫毒。日华子云∶治一切风，一切气，助阳道，暖水脏，补腰膝，益精，明目，通九窍，利皮肤，调血脉，四肢不遂，破癖症结，排脓止痛，续骨消瘀血，补冷气虚损，霍乱转筋，背脊偻伛，消风痰，下胸膈水，发汗，止阴汗，炮含喉痹。凡丸散，炮去皮脐用，饮药即和皮生使，甚佳。可以便验。又云∶天雄，大长少角刺而虚，乌喙似天雄，而附子大短有角，平稳而实。乌头次于附子，侧子小于乌头，连聚生者，名为虎掌，并是天雄一裔，子母之类，力气乃有殊等，即宿根与嫩者耳。以上并忌豉汁。"}]},{"ID":"20240612165138-sh6ghzg","Type":"NodeParagraph","Properties":{"id":"20240612165138-sh6ghzg","updated":"20240612165138"},"Children":[{"Type":"NodeText","Data":"图经文具侧子条下。"}]},{"ID":"20240612165138-wab5yp2","Type":"NodeParagraph","Properties":{"id":"20240612165138-wab5yp2","updated":"20240612165138"},"Children":[{"Type":"NodeText","Data":"陈藏器∶天雄，身全短无尖，周匝四面有附子，孕十一个，皮苍色即是。天雄宜炮皴坼后，去皮尖底用之。不然，阴制用，并得。别说云∶谨按此数条，说前项悉备。但天雄者始种乌头，而不生诸附子、侧子之类。经年独生长大者是也。蜀人种之忌生。此以为不利。如养蚕而为白姜之类也。"}]},{"ID":"20240612165032-gfyow15","Type":"NodeThematicBreak","Properties":{"id":"20240612165032-gfyow15"}},{"ID":"20240612165124-fyd6o4f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165124-fyd6o4f","updated":"20240612165130"},"Children":[{"Type":"NodeText","Data":"天雄《千金翼方》"}]},{"ID":"20240612165124-9kevu5u","Type":"NodeParagraph","Properties":{"id":"20240612165124-9kevu5u","updated":"20240612165124"},"Children":[{"Type":"NodeText","Data":"味辛甘，温，大温，有大毒。主大风，寒湿痹，历节痛，拘挛缓急，破积聚，邪气金疮，强筋骨，轻身健行。疗头面风去来疼痛，心腹结积，关节重，不能行步，除骨节痛，长阴气，强志，令人武勇，力作不倦，又堕胎。一名白幕。生少室山谷，二月采根，阴干。"}]},{"ID":"20240612165032-nodebp8","Type":"NodeThematicBreak","Properties":{"id":"20240612165032-nodebp8"}},{"ID":"20240612165025-2rowc0b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165025-2rowc0b","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：天雄"}]},{"ID":"20240612165025-p1vvkk3","Type":"NodeParagraph","Properties":{"id":"20240612165025-p1vvkk3","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612165025-xxbwqrq","Type":"NodeParagraph","Properties":{"id":"20240612165025-xxbwqrq","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" Tiān Xiónɡ"}]},{"ID":"20240612165025-njsw0sm","Type":"NodeParagraph","Properties":{"id":"20240612165025-njsw0sm","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612165025-jbx6uec","Type":"NodeParagraph","Properties":{"id":"20240612165025-jbx6uec","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 白幕（《本经》）。"}]},{"ID":"20240612165025-mrgmv5r","Type":"NodeParagraph","Properties":{"id":"20240612165025-mrgmv5r","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612165025-boq6pp1","Type":"NodeParagraph","Properties":{"id":"20240612165025-boq6pp1","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612165025-yx8e3ev","Type":"NodeParagraph","Properties":{"id":"20240612165025-yx8e3ev","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612165025-i2l1u4f","Type":"NodeParagraph","Properties":{"id":"20240612165025-i2l1u4f","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"附子"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"草乌头"},{"Type":"NodeText","Data":"之"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"形长而细者"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240612165025-tidkz65","Type":"NodeParagraph","Properties":{"id":"20240612165025-tidkz65","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612165025-i6saap0","Type":"NodeParagraph","Properties":{"id":"20240612165025-i6saap0","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 植物形态详\"川乌头\"及\"草乌头\"条。"}]},{"ID":"20240612165025-urze9ud","Type":"NodeParagraph","Properties":{"id":"20240612165025-urze9ud","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612165025-k9gtwni","Type":"NodeParagraph","Properties":{"id":"20240612165025-k9gtwni","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" ①《雷公炮炙论））：\"宜炮皴坼后去皮尖底用，不然阴制用并得。\""}]},{"ID":"20240612165025-4nf724y","Type":"NodeParagraph","Properties":{"id":"20240612165025-4nf724y","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"干姜制用之。\""}]},{"ID":"20240612165025-rm95i3x","Type":"NodeParagraph","Properties":{"id":"20240612165025-rm95i3x","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"③《日华子本草））：\"凡丸、散炮去皮脐用，饮药即和皮生使甚佳。\""}]},{"ID":"20240612165025-7c56cft","Type":"NodeParagraph","Properties":{"id":"20240612165025-7c56cft","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"熟用。一法，每十两，以酒浸七日，掘土坑，用炭半枰煅赤，去火，以醋二升沃之，侯干，趁热入天雄在内，小盆合一夜，取出，去脐用之。\""}]},{"ID":"20240612165025-99wv05e","Type":"NodeParagraph","Properties":{"id":"20240612165025-99wv05e","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612165025-i3c10cd","Type":"NodeParagraph","Properties":{"id":"20240612165025-i3c10cd","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 辛，热，有毒。"}]},{"ID":"20240612165025-l5yj8m2","Type":"NodeParagraph","Properties":{"id":"20240612165025-l5yj8m2","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240612165025-hc5tu93","Type":"NodeParagraph","Properties":{"id":"20240612165025-hc5tu93","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"甘，大温，有大毒。\""}]},{"ID":"20240612165025-ozcpwdo","Type":"NodeParagraph","Properties":{"id":"20240612165025-ozcpwdo","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"大热，有大毒。\""}]},{"ID":"20240612165025-afhjv9q","Type":"NodeParagraph","Properties":{"id":"20240612165025-afhjv9q","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612165025-nw77ddg","Type":"NodeParagraph","Properties":{"id":"20240612165025-nw77ddg","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 阴虚阳盛及孕妇禁服。"}]},{"ID":"20240612165025-fjrq0lw","Type":"NodeParagraph","Properties":{"id":"20240612165025-fjrq0lw","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"《本草经集注》：\"远志为之使。恶腐婢。\""}]},{"ID":"20240612165025-tnjv6vw","Type":"NodeParagraph","Properties":{"id":"20240612165025-tnjv6vw","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612165025-rc3v85y","Type":"NodeParagraph","Properties":{"id":"20240612165025-rc3v85y","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 祛风，散寒，燥湿，益火助阳。治风寒湿痹，历节风痛，四肢拘挛，心腹冷痛，痃癖症瘕。"}]},{"ID":"20240612165025-qqcqao9","Type":"NodeParagraph","Properties":{"id":"20240612165025-qqcqao9","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主大风，寒湿痹，历节痛，拘挛缓急，破积聚邪气，金疮，强筋骨，轻身健行。\""}]},{"ID":"20240612165025-bzl20zx","Type":"NodeParagraph","Properties":{"id":"20240612165025-bzl20zx","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗头面风去来疼痛，心腹结积，关节重，不能行步，除骨间痛，长阴气，强志，令人武勇，力作不倦。又堕胎。\""}]},{"ID":"20240612165025-noqqf0p","Type":"NodeParagraph","Properties":{"id":"20240612165025-noqqf0p","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能治风痰，冷痹，软脚毒风，能止气喘促急。杀禽、虫毒。\""}]},{"ID":"20240612165025-o2munwa","Type":"NodeParagraph","Properties":{"id":"20240612165025-o2munwa","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》：\"治一切风、一切气，助阳道，暖水藏，补腰膝，益精明目，通九窍，利皮肤，调血脉，四肢不遂，破痃癖癥结，排脓止痛，续骨，消瘀血，补冷气虚损，霍乱转筋，背脊偻伛，消风痰，下胸膈水，发汗，止阴汗，炮含治喉痹。\""}]},{"ID":"20240612165025-34g11jq","Type":"NodeParagraph","Properties":{"id":"20240612165025-34g11jq","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612165025-jum3bfo","Type":"NodeParagraph","Properties":{"id":"20240612165025-jum3bfo","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.8～2钱；或入丸、散。外用：研末调敷。"}]},{"ID":"20240612165025-7z1bw4k","Type":"NodeParagraph","Properties":{"id":"20240612165025-7z1bw4k","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612165025-8yg7hya","Type":"NodeParagraph","Properties":{"id":"20240612165025-8yg7hya","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" ①治元阳素虚，寒邪外攻，手足厥冷，大、小便滑数，小便白浑，六脉沉微，除痼冷，扶元气及伤寒阴毒：乌头、附子、天雄（并炮裂、去皮脐）等分。为租末，每服四钱，水二盏，姜十五片，煎八分，温服。（《肘后方》三建汤）"}]},{"ID":"20240612165025-votgtjn","Type":"NodeParagraph","Properties":{"id":"20240612165025-votgtjn","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"②治肾脏虚积，冷气攻腹疼痛，少力，行步难，不思饮食：天雄（炮裂、去皮脐）二两，茴香子（炒）、山芋、蜀椒（去目及口合者，炒出汗）各-两。上四味，捣罗为末，用羊肾一对，切去皮膜细研，酒、面同煮成膏，候冷拌前药为丸，如梧桐子大。每服二十丸至三十丸，温酒盐汤任下，空心食前服。（《圣济总录》天雄丸）"}]},{"ID":"20240612165025-wv53vuv","Type":"NodeParagraph","Properties":{"id":"20240612165025-wv53vuv","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"③治风湿痹皮肉不仁，骨髓疼痛不可忍者：天雄（炮裂，去皮脐）、附子（炮裂、去皮脐）各一两，桂（去粗皮）一两半，干姜（炮）三两，防风（去叉）三两。上五味，为细末，炼蜜丸，如梧桐子大。每服二十丸，温酒下，日三夜一。（《圣济总录》天雄丸）"}]},{"ID":"20240612165025-ajw7dk1","Type":"NodeParagraph","Properties":{"id":"20240612165025-ajw7dk1","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612165025-hjko2ib","Type":"NodeParagraph","Properties":{"id":"20240612165025-hjko2ib","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612165025-av41507","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612165025-av41507","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"《中华本草》《中药大辞典》：天雄"}]},{"ID":"20240612165025-a6pkb4v","Type":"NodeParagraph","Properties":{"id":"20240612165025-a6pkb4v","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612165025-74isftv","Type":"NodeParagraph","Properties":{"id":"20240612165025-74isftv","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" Tiān Xiónɡ"}]},{"ID":"20240612165025-77r10v7","Type":"NodeParagraph","Properties":{"id":"20240612165025-77r10v7","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612165025-1l4p872","Type":"NodeParagraph","Properties":{"id":"20240612165025-1l4p872","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 白幕"}]},{"ID":"20240612165025-4pgr2qa","Type":"NodeParagraph","Properties":{"id":"20240612165025-4pgr2qa","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612165025-g4eiv6o","Type":"NodeParagraph","Properties":{"id":"20240612165025-g4eiv6o","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" slender root of Common Monkshood or slender root of kusnezoff Monkshood"}]},{"ID":"20240612165025-o9zppz2","Type":"NodeParagraph","Properties":{"id":"20240612165025-o9zppz2","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612165025-u5g7mf8","Type":"NodeParagraph","Properties":{"id":"20240612165025-u5g7mf8","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612165025-svx1yxy","Type":"NodeParagraph","Properties":{"id":"20240612165025-svx1yxy","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：天雄、附子、乌头等，并以蜀道绵州、龙州出者佳。余处纵有造得者，力弱都不相似。江南来者，全不堪用。"}]},{"ID":"20240612165025-l39wu3l","Type":"NodeParagraph","Properties":{"id":"20240612165025-l39wu3l","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：天雄有二种。一种是蜀人种附子而生出长者，或种附子而尽变成长者，即如种芋形状不一之类；一种是他处草乌头之类，自生成者。故《别录》注乌喙云，长三寸以上者，为天雄是也。入药须用蜀产曾经酿制者，或云须重一两半，有象眼者乃佳。"}]},{"ID":"20240612165025-r37qeeg","Type":"NodeParagraph","Properties":{"id":"20240612165025-r37qeeg","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612165025-l8b7tsy","Type":"NodeParagraph","Properties":{"id":"20240612165025-l8b7tsy","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 药材基源：为毛茛科植物乌头。"}]},{"ID":"20240612165025-v60l78o","Type":"NodeParagraph","Properties":{"id":"20240612165025-v60l78o","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Aconitum carmichaeli Debx."}]},{"ID":"20240612165025-gux4y0b","Type":"NodeParagraph","Properties":{"id":"20240612165025-gux4y0b","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612165025-ze2adv4","Type":"NodeParagraph","Properties":{"id":"20240612165025-ze2adv4","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山地草坡或灌木丛中。"}]},{"ID":"20240612165025-9lvd0cz","Type":"NodeParagraph","Properties":{"id":"20240612165025-9lvd0cz","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于辽宁南部、陕西、甘肃、山东、江苏、安徽、浙江、江西、河南、湖北、湖南、广东北部、广西、四川、贵州、云南。主要栽培于四川。陕西、湖北、湖南、云南等地也有栽培。"}]},{"ID":"20240612165025-jgmdf95","Type":"NodeParagraph","Properties":{"id":"20240612165025-jgmdf95","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612165025-4yiml8e","Type":"NodeParagraph","Properties":{"id":"20240612165025-4yiml8e","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 乌头，多年生草本，高60-120cm。块根通常2个连生，纺锤形至倒卵形，外皮黑褐色；栽培品的侧根（子根）甚肥大，直径达5cm。茎直立或稍倾斜，下部光滑无毛，上部散生贴伏柔毛。叶互生，革质，有柄；叶片卵圆形，宽5-12cm，3裂几达基部，两侧裂片再2裂，中央裂片菱状楔形，先端再3浅裂，裂片边缘有粗齿或缺刻。总状圆锥花序，花序轴有贴伏的柔毛；萼片5，蓝紫色，外被微柔毛，上萼片盔形，长15-18mm，宽约20mm，侧萼片近圆形；花瓣2，无毛；雄蕊多数，花丝下半部扩张成宽线形的翅；心皮3-5个，离生，密被灰黄色的短绒毛。蓇葖果长圆形，具横脉，花柱宿存，芒尖状。花期6-7月。果期7-8月。"}]},{"ID":"20240612165025-1dbh9rx","Type":"NodeParagraph","Properties":{"id":"20240612165025-1dbh9rx","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612165025-ooleivk","Type":"NodeParagraph","Properties":{"id":"20240612165025-ooleivk","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：天雄喜温暖、湿润和向阳环境，宜选土层深厚肥沃、土质疏松、排水良好的土壤栽种。"}]},{"ID":"20240612165025-brk6y8f","Type":"NodeParagraph","Properties":{"id":"20240612165025-brk6y8f","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"2.种植：根块繁殖，选大的子根或野生乌头作种。在冬至前6-10天栽种，行距1尺，株距5寸，种前施足底肥，开2寸深沟，使芽向上栽入沟内，覆土1-2寸，每亩用种根240-300斤，地冻前浇水，并盖土粪一层越冬。等二年苗高1尺左右，摘除顶。一般留6-8片叶，并随时去腋芽。"}]},{"ID":"20240612165025-2svretc","Type":"NodeParagraph","Properties":{"id":"20240612165025-2svretc","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"3.生长时间，有根腐病和霜霉病害，应加强管理，注意排水通风。霜霉病发病初期可喷射波尔多液或代森铵防治。"}]},{"ID":"20240612165025-03mdnaq","Type":"NodeParagraph","Properties":{"id":"20240612165025-03mdnaq","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"4.采集加工：于6月底7月初时挖取根部，洗净泥土，晒干。"}]},{"ID":"20240612165025-rvhk4b0","Type":"NodeParagraph","Properties":{"id":"20240612165025-rvhk4b0","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612165025-7z1uhpx","Type":"NodeParagraph","Properties":{"id":"20240612165025-7z1uhpx","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 块根长圆锥形，稍弯曲，顶端常有短残茎，中部多向一侧略膨大，长2.5-7.5cm，直径1.2-3cm。表面棕褐色或灰棕色，有小瘤状突起的支根。质坚实，断面类白色或淡灰黄色，形成层环多角形。气微，味辛辣，麻舌。"}]},{"ID":"20240612165025-revydcj","Type":"NodeParagraph","Properties":{"id":"20240612165025-revydcj","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 母根横切面：后生皮层为棕色木栓化细胞，皮层薄壁组织偶见石细胞单个散在或数个成群；内皮层不甚明显韧皮部散有筛管群，内侧偶见纤维束。形成层环状多角形。其内外侧偶有1至数个异型维管束。木质部导管多列，径向或略呈“V”形排列。髓部明显。薄壁细胞充满淀粉粒。"}]},{"ID":"20240612165025-gleg2wu","Type":"NodeParagraph","Properties":{"id":"20240612165025-gleg2wu","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612165025-kut5ujq","Type":"NodeParagraph","Properties":{"id":"20240612165025-kut5ujq","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 生块根含乌头碱(aconitine)约0.01%，次乌头碱(hypacoitine)约0.048%，中乌头碱(mesaconitine)约0.006%，经炮制后生物碱含量降低。"}]},{"ID":"20240612165025-h8zjpy9","Type":"NodeParagraph","Properties":{"id":"20240612165025-h8zjpy9","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612165025-woyq4k5","Type":"NodeParagraph","Properties":{"id":"20240612165025-woyq4k5","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 1.天雄对垂体-肾上腺皮质系统有兴奋作用，能显着降低大白鼠肾上腺内维生素C的含量，增加尿中17-酮类固醇的排泄，减少末梢血液中嗜酸性白细胞数。此外，对某些肾上腺皮质功能不全的患者，具有肾腺皮质激素样作用。"}]},{"ID":"20240612165025-c0l2tn0","Type":"NodeParagraph","Properties":{"id":"20240612165025-c0l2tn0","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"2.天雄能兴奋迷走神经中枢，而有强心作用。"}]},{"ID":"20240612165025-vy0ocau","Type":"NodeParagraph","Properties":{"id":"20240612165025-vy0ocau","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"3.乌头碱对小鼠有镇痛作用。"}]},{"ID":"20240612165025-aqyq6iz","Type":"NodeParagraph","Properties":{"id":"20240612165025-aqyq6iz","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"4.乌头碱及乌头次碱均有麻醉作用。"}]},{"ID":"20240612165025-4yb068c","Type":"NodeParagraph","Properties":{"id":"20240612165025-4yb068c","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"5.对动物甲醛性和蛋清性关节炎有明显的消炎、退肿作用。"}]},{"ID":"20240612165025-3i8l0uq","Type":"NodeParagraph","Properties":{"id":"20240612165025-3i8l0uq","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612165025-z93lwuv","Type":"NodeParagraph","Properties":{"id":"20240612165025-z93lwuv","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 1.《雷公炮炙论》：宜炮皴坼后去皮尖底用，不然阴制用并得。"}]},{"ID":"20240612165025-ltss2ni","Type":"NodeParagraph","Properties":{"id":"20240612165025-ltss2ni","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：干姜制用之。"}]},{"ID":"20240612165025-ga27f12","Type":"NodeParagraph","Properties":{"id":"20240612165025-ga27f12","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"3.《日华子本草》：凡丸、散炮去皮脐用，饮药即和皮生使甚佳。"}]},{"ID":"20240612165025-x1hhlhs","Type":"NodeParagraph","Properties":{"id":"20240612165025-x1hhlhs","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"4.《纲目》：熟用。一法，每十两，以酒浸七日，掘土坑，用炭半枰煅赤，去火，以醋二升沃之，候干，趁热入天雄在内，小盆合一夜，取出，去脐用之。"}]},{"ID":"20240612165025-ptrr3h8","Type":"NodeParagraph","Properties":{"id":"20240612165025-ptrr3h8","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612165025-xpyh6o6","Type":"NodeParagraph","Properties":{"id":"20240612165025-xpyh6o6","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 肾经"}]},{"ID":"20240612165025-v8ow14c","Type":"NodeParagraph","Properties":{"id":"20240612165025-v8ow14c","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612165025-dhx4fqe","Type":"NodeParagraph","Properties":{"id":"20240612165025-dhx4fqe","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 辛；热；大毒"}]},{"ID":"20240612165025-pry57sv","Type":"NodeParagraph","Properties":{"id":"20240612165025-pry57sv","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612165025-5pvk3np","Type":"NodeParagraph","Properties":{"id":"20240612165025-5pvk3np","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 阴虚阳盛者及孕妇禁服。"}]},{"ID":"20240612165025-4jynzl8","Type":"NodeParagraph","Properties":{"id":"20240612165025-4jynzl8","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612165025-rm2obac","Type":"NodeParagraph","Properties":{"id":"20240612165025-rm2obac","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 祛风散寒；益火助阳。主风寒湿痹；历节风痛；四肢拘挛；心腹冷痛；痃癖症瘕"}]},{"ID":"20240612165025-z7u566g","Type":"NodeParagraph","Properties":{"id":"20240612165025-z7u566g","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612165025-zqcnwys","Type":"NodeParagraph","Properties":{"id":"20240612165025-zqcnwys","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2-6g；或入丸、散。外用：适量，研末调敷。内服宜炮制后用。"}]},{"ID":"20240612165025-c5hgnh3","Type":"NodeParagraph","Properties":{"id":"20240612165025-c5hgnh3","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612165025-mvs5qm7","Type":"NodeParagraph","Properties":{"id":"20240612165025-mvs5qm7","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：乌、附、天雄，皆是补下焦命门阳虚之药，补下所以益上也，若是上焦阳虚，即属心、脾之分，当用参、芪，不当用天雄也，朱震亨以为下部之佐者，得之而未发出此义。《雷斅炮炙论》序云：咳逆数数，酒服熟雄，谓以天雄炮研，酒服一钱也。"}]},{"ID":"20240612165025-t97kky5","Type":"NodeParagraph","Properties":{"id":"20240612165025-t97kky5","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"2.《本草述》：天雄，亦能补阳，但力大减于附子耳。且难与乌头同论，以其不兼散风也。"}]},{"ID":"20240612165025-47y91ct","Type":"NodeParagraph","Properties":{"id":"20240612165025-47y91ct","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"3.《本经逢原》：天雄，禀纯阳之性，补命门、三焦，壮阳精，强肾气，过于附子，故《本经》用以治大风寒，开湿痹、历节、拘挛诸病，阳气衰者，佐人参用之。"}]},{"ID":"20240612165025-l6nlucz","Type":"NodeParagraph","Properties":{"id":"20240612165025-l6nlucz","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"4.《本草求真》：天雄，能补下焦命门阳虚，然辛热走窜，止属主治风寒湿痹之品。"}]},{"ID":"20240612165025-5hq8813","Type":"NodeParagraph","Properties":{"id":"20240612165025-5hq8813","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"5.《本经》：主大风，寒湿痹，历节痛，拘挛缓急，破积聚邪气，金疮，强筋骨，轻身健行。"}]},{"ID":"20240612165025-xlfx0he","Type":"NodeParagraph","Properties":{"id":"20240612165025-xlfx0he","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"6.《别录》：疗头面风去来疼痛，心腹结积，关节重，不能行步，除骨间痛，长阴气，强志，令人武勇，力作不倦，又堕胎。"}]},{"ID":"20240612165025-v62x782","Type":"NodeParagraph","Properties":{"id":"20240612165025-v62x782","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"7.《药性论》：能治风痰，冷痹，软脚毒风，能止气喘促急。杀禽、虫毒。"}]},{"ID":"20240612165025-k40t509","Type":"NodeParagraph","Properties":{"id":"20240612165025-k40t509","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"8.《日华子本草》：治一切风、一切气，助阳道，暖水藏，补腰膝，益精明目，通九窍，利皮肤，调血脉，四肢不遂，破痃癖症结，排脓止痛，续骨，消瘀血，补冷气虚损，霍乱转筋，背脊偻伛，消风痰，下胸膈水，发汗，止阴汗，炮含治喉痹。"}]},{"ID":"20240612165025-7p1t9g2","Type":"NodeParagraph","Properties":{"id":"20240612165025-7p1t9g2","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612165025-gwk71iv","Type":"NodeParagraph","Properties":{"id":"20240612165025-gwk71iv","updated":"20240612165025"},"Children":[{"Type":"NodeText","Data":" 《中华本草》《中药大辞典》"}]},{"ID":"20240612165027-42kjl9b","Type":"NodeThematicBreak","Properties":{"id":"20240612165027-42kjl9b"}},{"ID":"20240612165028-ymxj6j5","Type":"NodeParagraph","Properties":{"id":"20240612165028-ymxj6j5","updated":"20240612165029"}}]}