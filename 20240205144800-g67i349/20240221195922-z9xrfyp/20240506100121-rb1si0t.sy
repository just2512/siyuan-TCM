{"ID":"20240506100121-rb1si0t","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100121-rb1si0t","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100121-rb1si0t\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240612165031-gi4qx1q\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612165028-ymxj6j5\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240612165417-nqbynfd\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"266天雄","type":"doc","updated":"20240822100335"},"Children":[{"ID":"20240627170442-rxcugv5","Type":"NodeParagraph","Properties":{"id":"20240627170442-rxcugv5","updated":"20240627170442"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 378px;","style":"width: 368px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"天雄"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/天雄-20240627170442-5gqf520.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 368px;\" parent-style=\"width: 378px;\"}"}]},{"ID":"20240627171710-86zfamv","Type":"NodeParagraph","Properties":{"id":"20240627171710-86zfamv","updated":"20240627171744"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 379px;","style":"width: 369px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240627171744-do8j7ln.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 369px;\" parent-style=\"width: 379px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240627165500-fjk1xrg","Type":"NodeParagraph","Properties":{"id":"2024062716