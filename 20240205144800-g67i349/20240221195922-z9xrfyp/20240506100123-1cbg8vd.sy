181359"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 614px;","style":"width: 604px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青梅 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青梅 6-20240821181359-e005mzq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 604px;\" parent-style=\"width: 614px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 613px;","style":"width: 603px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青梅 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青梅 4-20240821180908-mpyl4if.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 603px;\" parent-style=\"width: 613px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627124559-visyezt","Type":"NodeParagraph","Properties":{"id":"20240627124559-visyezt","updated":"20240821181536"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1162px;","style":"width: 1152px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青梅2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青梅2-20240627124559-xnx86nu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1152px;\" parent-style=\"width: 1162px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240821184153-ggwmep7","Type":"NodeParagraph","Properties":{"id":"20240821184153-ggwmep7","updated":"20240821184153"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1164px;","style":"width: 1154px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青梅 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青梅 14-20240821184153-dwj647x.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1154px;\" parent-style=\"width: 1164px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612144712-zj6wb7o","Type":"NodeParagraph","Properties":{"id":"20240612144712-zj6wb7o","updated":"20240821183532"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"text strong","TextMarkTextContent":"乌梅并非天生乌黑色，也不是一个植物品种；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"而是由青梅树的果实经果木熏炙加工而成。做乌梅选用的是半熟而生涩的青梅（青中带淡黄色），因而须在“梅雨”前夕进行采摘。"}]},{"ID":"20240612144712-pyt4cwm","Type":"NodeThematicBreak","Properties":{"id":"20240612144712-pyt4cwm"}},{"ID":"20240612144746-zfmbzqp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612144746-zfmbzqp","updated":"20240612144752"},"Children":[{"Type":"NodeText","Data":"梅实《增广和剂局方药性总论》"}]},{"ID":"20240612144746-vwzqoce","Type":"NodeParagraph","Properties":{"id":"20240612144746-vwzqoce","updated":"20240612144746"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主下气，除热烦满，安心，肢体痛偏枯不仁，死肌，去青黑痣，恶疾，止下痢，好唾口干。《药性论》云∶梅核仁可单用，能除烦热。陈藏器云∶止渴，令人膈上热。乌梅∶去痰，主疟瘴，止渴，调中，除冷热痢，止吐逆。日华子云∶止渴。多啖，伤骨蚀脾胃。根叶浓煎汤治休息痢并霍乱。"}]},{"ID":"20240612144712-jertnrl","Type":"NodeThematicBreak","Properties":{"id":"20240612144712-jertnrl"}},{"ID":"20240612144734-pjb2ugi","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612144734-pjb2ugi","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"梅实"}]},{"ID":"20240612144734-90oxavf","Type":"NodeParagraph","Properties":{"id":"20240612144734-90oxavf","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主下气，除热烦满，安心，肢体痛，偏枯不仁，死肌，去青黑痣，恶疾，止下痢，好唾，口干。生汉中川谷。五月采，火干。"}]},{"ID":"20240612144734-21juupz","Type":"NodeParagraph","Properties":{"id":"20240612144734-21juupz","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此亦是今乌梅也，用当去核，微熬之。伤寒烦热，水渍饮汁。生梅子及白梅亦应相似，今人多用白梅和药，以点痣，蚀恶肉也。服黄精人，云禁食梅实。唐本注云∶《别录》云，梅根，疗风痹，出土者杀人。梅实，利筋脉，去痹。臣禹锡等谨按药性论云∶梅核仁亦可单用，味酸，无毒。能除烦热。萧炳云∶今人多用烟熏为乌梅。孟诜云∶乌梅，多食损齿。又，刺在肉中，嚼白梅封之，刺即出。又，大便不通，气奔欲死。以乌梅十颗置汤中，须臾挪去核，杵为丸如枣大，纳下部，少时即通。谨按擘破水渍，以少蜜相和，止渴，霍乱心腹不安及痢赤。治疟方∶多用之。陈藏器云∶梅实本功外，止渴。令人膈上热。乌梅去痰，主疟瘴，止渴调中，除冷热痢，止吐逆。梅叶捣碎汤洗，衣易脱也。嵩阳子云∶清水揉梅叶，洗蕉葛衣，经夏不脆。余试之验。日华子云∶梅子，暖。止渴。多啖伤骨，蚀脾胃，令人发热。根、叶煎浓汤，治休息痢并霍乱。又云白梅，暖，无毒。治刀箭，止血，研敷之。又云乌梅，暖，无毒。除劳，治骨蒸，去烦闷。涩肠止痢，消酒毒。治偏枯、皮肤麻痹。去黑点。令人得睡。又入建茶、干姜为丸，止休息痢，大验也。"}]},{"ID":"20240612144734-3nxlffb","Type":"NodeParagraph","Properties":{"id":"20240612144734-3nxlffb","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"图经曰∶梅实，生汉中川谷，今襄汉、川蜀、江湖、淮岭皆有之。其生实酢而损齿，伤骨，发虚热，不宜多食之，服黄精人尤不相宜。其叶煮浓汁服之，已休息痢。根，主风痹。出土者不可用。五月采其黄实，火熏干作乌梅。主伤寒烦热及霍乱躁渴。虚劳瘦羸，产妇气痢等方∶中多用之。南方∶疗劳疟劣弱者，用乌梅十四枚，豆豉二合，桃、柳枝各一虎口握，甘草三寸长，生姜一块，以童子小便二升，煎七合，温服。其余药使用之尤多。又以盐杀为白梅，亦入除痰药中用。又，下有杨梅条，亦生江南、岭南。其木若荔枝，而叶细阴浓，其实生青熟红，肉在核上，无皮壳。南人淹藏以为果，寄至北方∶甚多，今医方∶鲜用，故附于此。"}]},{"ID":"20240612144734-x12h3zx","Type":"NodeParagraph","Properties":{"id":"20240612144734-x12h3zx","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"圣惠方∶主伤寒，下部生 疮。用乌梅肉三两，炒令燥，杵为末，炼蜜丸如梧桐子大。"}]},{"ID":"20240612144734-m7841op","Type":"NodeParagraph","Properties":{"id":"20240612144734-m7841op","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"以至七煎取作极热，纳小水五升，寒。以三十为伐指。以乌打碎，水二升，煮渐自消。经验方∶但出紫血，有红血出，胸中烦痛。乌梅十四以乌梅肉二两，微炒为去滓，临卧时服。鬼氏本草∶梅核明目，与军士失道，大渴而无水衍义曰∶梅实，食梅则津液泄，水生木也。津液泄，故伤齿。肾属水，外为齿，故也。"}]},{"ID":"20240612144734-w248gn2","Type":"NodeParagraph","Properties":{"id":"20240612144734-w248gn2","updated":"20240612144734"},"Children":[{"Type":"NodeText","Data":"王叔和曰∶膀胱、肾合为津府，此语虽鄙，然理存焉。熏之为乌梅，曝干藏密器中，为白梅。"}]},{"ID":"20240612145037-at9f0hr","Type":"NodeThematicBreak","Properties":{"id":"20240612145037-at9f0hr"}},{"ID":"20240612145038-qpwm5op","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145038-qpwm5op","updated":"20240612145042"},"Children":[{"Type":"NodeText","Data":"乌梅《长沙药解》"}]},{"ID":"20240612145038-j0rosf0","Type":"NodeParagraph","Properties":{"id":"20240612145038-j0rosf0","updated":"20240612145038"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】梅实。味酸平。主下气，除热，烦满，安心，肢体痛，偏枯不仁，死肌，去青黑志，恶疾。生川谷。"}]},{"ID":"20240612145038-djyk84r","Type":"NodeParagraph","Properties":{"id":"20240612145038-djyk84r","updated":"20240612145038"},"Children":[{"Type":"NodeText","Data":"味酸，性涩，入足厥阴肝经，下冲气而止呕，敛风木而杀蛔。"}]},{"ID":"20240612145038-nqyjot5","Type":"NodeParagraph","Properties":{"id":"20240612145038-nqyjot5","updated":"20240612145038"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌梅丸"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"乌梅三百个，干姜十两，细辛六两，人参六两，桂枝六两，当归四两，川椒四兩，附子六两，黄连一斤，黄柏六两。"},{"Type":"NodeText","Data":"治厥阴病，气上冲心，心中疼热，消渴，食即烦生，而吐蛔者。以水寒土湿，木气郁遏，则生蛔虫。木郁风动，肺津伤耗，则病消渴。木郁为热，冲击心君，则生疼热。脏腑下寒，蛔移膈上，则生烦呕。呕而气逆，冲动蛔虫，则病吐蛔。乌梅、姜、辛，杀蛔止呕而降冲气，人参、桂、归，补中疏木而润风燥，椒、附暖水而温下寒，连、柏泻火而清上热也。"}]},{"ID":"20240612145038-9nf18aj","Type":"NodeParagraph","Properties":{"id":"20240612145038-9nf18aj","updated":"20240612145038"},"Children":[{"Type":"NodeText","Data":"乌梅酸涩收敛，泻风木而降冲气，止呕吐而杀蛔虫，善医蛔厥之证。其诸主治，止咳嗽，住泄利，消肿痛，涌痰涎，泻烦满，润燥渴，散乳痈，通喉痹，点黑痣，蚀瘀肉，收便尿下血，止刀箭流血，松霍乱转筋，开痰厥牙闭。"}]},{"ID":"20240612145038-znk1nzh","Type":"NodeParagraph","Properties":{"id":"20240612145038-znk1nzh","updated":"20240612145038"},"Children":[{"Type":"NodeText","Data":"醋浸一宿，去核，米蒸。"}]},{"ID":"20240612145025-8r9wzdl","Type":"NodeThematicBreak","Properties":{"id":"20240612145025-8r9wzdl"}},{"ID":"20240612145026-mmb94rb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145026-mmb94rb","updated":"20240612145031"},"Children":[{"Type":"NodeText","Data":"梅实《本草衍义》"}]},{"ID":"20240612145026-o45dc3e","Type":"NodeParagraph","Properties":{"id":"20240612145026-o45dc3e","updated":"20240612145026"},"Children":[{"Type":"NodeText","Data":"食梅则津液泄，水生木也。津液泄，故伤齿。肾属水，外为齿，故也。王叔和曰∶膀胱、肾，合为津府。此语虽鄙，然理存焉。熏之为乌梅，曝干藏密器中为白梅。"}]},{"ID":"20240612145011-7ujhkbn","Type":"NodeThematicBreak","Properties":{"id":"20240612145011-7ujhkbn"}},{"ID":"20240612145012-0vsef8m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145012-0vsef8m","updated":"20240612145017"},"Children":[{"Type":"NodeText","Data":"梅实《千金翼方》"}]},{"ID":"20240612145012-61ac4p0","Type":"NodeParagraph","Properties":{"id":"20240612145012-61ac4p0","updated":"20240612145012"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主下气，除烦满，安心，肢体痛，偏枯不仁，死肌，去青黑志，恶疾，止下痢，好唾口干。生汉中川谷，五月采，火干。"}]},{"ID":"20240612144712-fxymva8","Type":"NodeThematicBreak","Properties":{"id":"20240612144712-fxymva8"}},{"ID":"20240612144713-d3wvxgx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612144713-d3wvxgx","updated":"20240612144719"},"Children":[{"Type":"NodeText","Data":"梅实《新修本草》"}]},{"ID":"20240612144713-yxifdzj","Type":"NodeParagraph","Properties":{"id":"20240612144713-yxifdzj","updated":"20240612144713"},"Children":[{"Type":"NodeText","Data":"味酸，平，无毒。主下气，除热烦满，安心，肢体痛，偏枯不仁，死肌，去青黑志，恶疾。止下痢，好唾，口干。"}]},{"ID":"20240612144713-tiarrhp","Type":"NodeParagraph","Properties":{"id":"20240612144713-tiarrhp","updated":"20240612144713"},"Children":[{"Type":"NodeText","Data":"生汉中川谷，五月采，火干。"}]},{"ID":"20240612144713-pz6bji1","Type":"NodeParagraph","Properties":{"id":"20240612144713-pz6bji1","updated":"20240612144713"},"Children":[{"Type":"NodeText","Data":"此亦是今乌梅也，用之去核，微熬之。伤寒烦热，水渍饮汁。生梅子及白梅亦应相似，今人多用白梅和药，以点志蚀恶肉也。服黄精人，去禁食梅实。"}]},{"ID":"20240612144713-yt7m96w","Type":"NodeParagraph","Properties":{"id":"20240612144713-yt7m96w","updated":"20240612144713"},"Children":[{"Type":"NodeText","Data":"〔谨案〕《别录》云∶梅根，疗利筋脉，去痹。"}]},{"ID":"20240612144714-6a8n2ub","Type":"NodeThematicBreak","Properties":{"id":"20240612144714-6a8n2ub"}},{"ID":"20240612144759-2qzt5z3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612144759-2qzt5z3","updated":"20240612144806"},"Children":[{"Type":"NodeText","Data":"梅实《本草述钩元》"}]},{"ID":"20240612144759-p26wtc6","Type":"NodeParagraph","Properties":{"id":"20240612144759-p26wtc6","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"入药以野生及未经就接者为贵。"}]},{"ID":"20240612144759-d5qngag","Type":"NodeParagraph","Properties":{"id":"20240612144759-d5qngag","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"味酸。气平。花开于冬。而实熟于夏。得木之全气。故其味最酸。（濒湖）经云。味过于酸。"}]},{"ID":"20240612144759-75bnxir","Type":"NodeParagraph","Properties":{"id":"20240612144759-75bnxir","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"乌梅"}]},{"ID":"20240612144759-dyypt50","Type":"NodeParagraph","Properties":{"id":"20240612144759-dyypt50","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"味酸涩。气温平。入厥阴肝及脾肺二经血分。主治下气。除烦热满闷。止肢体痛。偏不仁。去死肌恶肉。青黑痣蚀。恶疮肉。（此收而能化之故）去痹利筋脉。（能吮肾液以筋膜）除冷热痢。止休息痢。调中去痰。治疟瘴。止吐逆霍乱。好唾口干。疗久嗽。（能收肺阳一味作汤代茶。治火炎头痛。痢血日久。用盐水梅肉一枚。研烂。合腊茶。入醋服之。一啜而安。或用乌梅胡黄连灶下土等分。为末。茶调服亦效。盖血得酸则敛。得寒则止。得苦则涩故也。蚀恶疮肉。乌梅肉烧存性。研敷疮上。一夜立尽。同黄连白芍滑石甘草莲肉扁豆葛根升麻红曲橘红作丸。治滞下如神。便血及酒痢。久痢不止。用乌梅三两。烧存性为末。"}]},{"ID":"20240612144759-vpo7viz","Type":"NodeParagraph","Properties":{"id":"20240612144759-vpo7viz","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"醋煮米糊和丸。梧子大。每空心米饮服二十丸。日三。尿血。乌梅烧存性。研末。醋糊丸梧子大。"}]},{"ID":"20240612144759-8wuf4d9","Type":"NodeParagraph","Properties":{"id":"20240612144759-8wuf4d9","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"不通。气约下行者而化于阳化阳即并阳中之阴而化之。"}]},{"ID":"20240612144759-al4c4yy","Type":"NodeParagraph","Properties":{"id":"20240612144759-al4c4yy","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"因收得化。是即下气以为固脱。原非止涩之剂也。若为止涩之剂。何以大便不通者纳之下部。乃反得通哉。"}]},{"ID":"20240612144759-g7rmaa0","Type":"NodeParagraph","Properties":{"id":"20240612144759-g7rmaa0","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"〔论〕世俗类以乌梅为酸收耳。观本经首主下气。次及肢体痛。偏枯不仁。死肌肉等证。"}]},{"ID":"20240612144759-s6slgz9","Type":"NodeParagraph","Properties":{"id":"20240612144759-s6slgz9","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"津。"}]},{"ID":"20240612144759-t9z7haq","Type":"NodeParagraph","Properties":{"id":"20240612144759-t9z7haq","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"液应。）致其行之止谓为酸所为聚精毓气之全。具阴原具有阳溢。可以思原于津液之化。以肝者。是其治皆不外于敛前义概之乎。曰。此味药矣。今痢之病于热伤久痢断后。用涩药为君而绝不根于血也。再如于血药用矣。然亦未有离于气不能还其一降一收之元）为得当。若乌梅者。胥能合阳中之阴。举阴之滞阴之虚而阴不化。宜大补元阳化阴以益使阴清。遂导阳中之阴而使阳化湿热合则化脓血而烦痛。宜收下燥湿守中养胃之剂兼之。俾中焦未易获效也。盖收阴中之阳。则阴所以调天气地气之枢也。由阴完而首言下气者。正其调血之功耳。大抵肝乃能四应。（但有主剂以为合应分应行不离收者。至本经别录所主治多不及"}]},{"ID":"20240612144759-3lj03bh","Type":"NodeParagraph","Properties":{"id":"20240612144759-3lj03bh","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"白梅"}]},{"ID":"20240612144759-vvv2qca","Type":"NodeParagraph","Properties":{"id":"20240612144759-vvv2qca","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"又名盐梅霜梅。气味酸咸平。主喉痹。他治与乌梅仿佛一二。而乌梅较良。资用更痰厥僵仆。牙关紧闭者。取白梅肉指擦牙根。涎出即开。喉痹乳蛾。冰梅丸。用青梅二十盐十二两。腌五日。取梅汁。入明矾三两。桔梗白芷防风各二两。牙皂三十条。俱为细末。"}]},{"ID":"20240612144759-uks0pvs","Type":"NodeParagraph","Properties":{"id":"20240612144759-uks0pvs","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"拌汁和梅。入瓶收之。每用一枚。噙咽津液。凡中风痰厥。牙关不开。用此擦之。尤佳。梅核膈气。取半青半黄梅子。每个用盐一两。腌一日夜。晒干。又浸又晒。至水尽乃止。用青钱三个。夹二梅。麻线缚定。通装瓷罐内。封埋地下。百日取出。每用一枚含之。咽汁入喉。"}]},{"ID":"20240612144759-zn8sizu","Type":"NodeParagraph","Properties":{"id":"20240612144759-zn8sizu","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"即消。收一年者。治一人。二年者。治二人。其妙绝伦。暑气霍乱。白梅一个。和仁捣碎。"}]},{"ID":"20240612144759-infh475","Type":"NodeParagraph","Properties":{"id":"20240612144759-infh475","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"入丝瓜叶一片。或扁豆叶。再捣烂。用新汲水调。灌下即解。"}]},{"ID":"20240612144759-9cnahph","Type":"NodeParagraph","Properties":{"id":"20240612144759-9cnahph","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"〔论〕乌梅白梅。气味致有不同。乌梅因制以达火气。所以收而能化。白梅同盐汁渍。"}]},{"ID":"20240612144759-an7zj4d","Type":"NodeParagraph","Properties":{"id":"20240612144759-an7zj4d","updated":"20240612144759"},"Children":[{"Type":"NodeText","Data":"则其同用风寒初起。疟痢未久者。弗遽用。（士材）〔修治〕造乌梅法。取青梅篮盛。于突上熏黑。若以稻灰淋汁润湿蒸过。则肥泽不蠹。"}]},{"ID":"20240612144800-ll19syd","Type":"NodeThematicBreak","Properties":{"id":"20240612144800-ll19syd"}},{"ID":"20240612145104-or2eco6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145104-or2eco6","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"《中国药典》：乌梅"}]},{"ID":"20240612145104-pm9cw1g","Type":"NodeParagraph","Properties":{"id":"20240612145104-pm9cw1g","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145104-w5ai6rc","Type":"NodeParagraph","Properties":{"id":"20240612145104-w5ai6rc","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" Wū Méi"}]},{"ID":"20240612145104-cn5s5hn","Type":"NodeParagraph","Properties":{"id":"20240612145104-cn5s5hn","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145104-dolp06b","Type":"NodeParagraph","Properties":{"id":"20240612145104-dolp06b","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 酸梅、黄仔、合汉梅、干枝梅"}]},{"ID":"20240612145104-66v729v","Type":"NodeParagraph","Properties":{"id":"20240612145104-66v729v","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612145104-70zipje","Type":"NodeParagraph","Properties":{"id":"20240612145104-70zipje","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" FRUCTUS MUME"}]},{"ID":"20240612145104-8a96vfu","Type":"NodeParagraph","Properties":{"id":"20240612145104-8a96vfu","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145104-o9k9erc","Type":"NodeParagraph","Properties":{"id":"20240612145104-o9k9erc","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 本品为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"梅"},{"Type":"NodeText","Data":"Prunus mume （Sieh.）Sieb .et Zucc. 的干燥近"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"成熟果实"},{"Type":"NodeText","Data":"。夏季果实近成熟时采收，低温烘干后闷至色变黑。"}]},{"ID":"20240612145104-k8q01k4","Type":"NodeParagraph","Properties":{"id":"20240612145104-k8q01k4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612145104-ixhlzz0","Type":"NodeParagraph","Properties":{"id":"20240612145104-ixhlzz0","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 本品呈类环形或扁球形，直径1.5～3cm。表面乌黑色或棕黑色，皱缩不平，基部有圆形果梗痕。果核坚硬，椭圆形，棕黄色，表面有凹点；种子扁卵形，淡黄色。气微，味极酸。"}]},{"ID":"20240612145104-wipwdjd","Type":"NodeParagraph","Properties":{"id":"20240612145104-wipwdjd","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612145104-2cjl19n","Type":"NodeParagraph","Properties":{"id":"20240612145104-2cjl19n","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乌梅肉"},{"Type":"NodeText","Data":"：取净乌梅，水润使软或蒸软，去核。乌梅炭：取净乌梅，照炒炭法（附录Ⅱ D）炒至皮肉鼓起。"}]},{"ID":"20240612145104-22xkay4","Type":"NodeParagraph","Properties":{"id":"20240612145104-22xkay4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145104-hj01b2w","Type":"NodeParagraph","Properties":{"id":"20240612145104-hj01b2w","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 归肝、脾、肺、大肠经。"}]},{"ID":"20240612145104-187njj3","Type":"NodeParagraph","Properties":{"id":"20240612145104-187njj3","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145104-owruc6h","Type":"NodeParagraph","Properties":{"id":"20240612145104-owruc6h","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 酸、涩，平。"}]},{"ID":"20240612145104-vtj38qh","Type":"NodeParagraph","Properties":{"id":"20240612145104-vtj38qh","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145104-qe8iwo1","Type":"NodeParagraph","Properties":{"id":"20240612145104-qe8iwo1","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 敛肺，涩肠，生津，安蛔。用于肺虚久咳，久痢滑肠，虚热消渴，蛔厥呕吐腹痛，胆道蛔虫症。"}]},{"ID":"20240612145104-p1us3x8","Type":"NodeParagraph","Properties":{"id":"20240612145104-p1us3x8","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145104-lz6e5gu","Type":"NodeParagraph","Properties":{"id":"20240612145104-lz6e5gu","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 6～12g。"}]},{"ID":"20240612145104-5gamllv","Type":"NodeParagraph","Properties":{"id":"20240612145104-5gamllv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145104-vthwnm8","Type":"NodeParagraph","Properties":{"id":"20240612145104-vthwnm8","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612145104-dxhl1ct","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145104-dxhl1ct","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：乌梅"}]},{"ID":"20240612145104-1uycirz","Type":"NodeParagraph","Properties":{"id":"20240612145104-1uycirz","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145104-lbbb7he","Type":"NodeParagraph","Properties":{"id":"20240612145104-lbbb7he","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" Wū Méi"}]},{"ID":"20240612145104-23hp8a0","Type":"NodeParagraph","Properties":{"id":"20240612145104-23hp8a0","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145104-gxmxykz","Type":"NodeParagraph","Properties":{"id":"20240612145104-gxmxykz","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 梅实（《本经》），熏梅、桔梅肉（《现代实用中药》）。"}]},{"ID":"20240612145104-w689185","Type":"NodeParagraph","Properties":{"id":"20240612145104-w689185","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612145104-bdgasao","Type":"NodeParagraph","Properties":{"id":"20240612145104-bdgasao","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》"}]},{"ID":"20240612145104-b89g49x","Type":"NodeParagraph","Properties":{"id":"20240612145104-b89g49x","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145104-hy4zxs6","Type":"NodeParagraph","Properties":{"id":"20240612145104-hy4zxs6","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"梅"},{"Type":"NodeText","Data":"的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未成熟果实"},{"Type":"NodeText","Data":"。5月间采摘将成熟的绿色果实（青梅），按大小分开，分别炕焙，火力不宜过大，温度保持在40℃左右。当梅子焙至六成干时，须上下翻动（勿翻破表皮），使其干燥均匀。一般炕焙2～3昼夜，至果肉呈黄褐色起皱皮为度，焙后再焖2～3天，待变成黑色即成。"}]},{"ID":"20240612145104-othnwfv","Type":"NodeParagraph","Properties":{"id":"20240612145104-othnwfv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612145104-7xe7jxh","Type":"NodeParagraph","Properties":{"id":"20240612145104-7xe7jxh","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 全国各地均有栽培。主产四川、浙江、福建、湖南、贵州。此外，广东、湖北、云南、陕西、安徽、江苏、广西、江西、河南等地亦产。"}]},{"ID":"20240612145104-y4zrda8","Type":"NodeParagraph","Properties":{"id":"20240612145104-y4zrda8","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612145104-4ez4lib","Type":"NodeParagraph","Properties":{"id":"20240612145104-4ez4lib","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 梅（《诗经，），又名：春梅（《本草再新》）。"}]},{"ID":"20240612145104-c034gq6","Type":"NodeParagraph","Properties":{"id":"20240612145104-c034gq6","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"落叶小乔木，高可达10米。树皮淡灰色或淡绿色，多分枝。单叶互生；有叶柄，通常有腺体；嫩枝上叶柄基部有线形托叶2片，托叶边缘具不整齐细锐锯齿；叶片卵形至长圆状卵形，长4～9厘米，宽2.4～4厘米，先端长尾尖，基部阔楔形，边缘具细锐锯齿，沿脉背有黄褐色毛。花单生或2朵簇生，白色或粉红色，芳香，通常先叶开放，有短梗；苞片鳞片状，褐色；萼筒钟状，裂片5，墓部与花托合生；花瓣单瓣或重瓣，通常5片，阔倒卵形，雄蕊多数，生于花托边缘；雌蕊1，子房密被毛，花柱细长，弯曲。核果球形，直径约2～3厘米，一侧有浅槽，被毛，绿色，熟时黄色，核硬，有槽纹。花期1～2月。果期5月。"}]},{"ID":"20240612145104-ga9b1fg","Type":"NodeParagraph","Properties":{"id":"20240612145104-ga9b1fg","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"本植物的根（梅根）、枝（梅梗）、叶（梅叶）、花蕾（白梅花）、未成熟果实的盐渍品（白梅）、种仁（梅核仁）亦供药用，各详专条。"}]},{"ID":"20240612145104-spnly21","Type":"NodeParagraph","Properties":{"id":"20240612145104-spnly21","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612145104-tj1h5f4","Type":"NodeParagraph","Properties":{"id":"20240612145104-tj1h5f4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 干燥果实呈扁圆形或不规则球形，直径1.5～3厘米。表面棕黑色至乌黑色，皱缩、凹凸不平。有的外皮已破碎，核露于外。果实一端有明显的凹陷（即果柄脱落处），果肉质柔软。核坚硬，棕黄色，内含淡黄色种仁1粒，形状及气味极似杏仁。气特异，味极酸。以个大、肉厚、核小、外皮乌黑色、不破裂露核、柔润、味极酸者为佳。"}]},{"ID":"20240612145104-zwywxis","Type":"NodeParagraph","Properties":{"id":"20240612145104-zwywxis","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612145104-hrr5c07","Type":"NodeParagraph","Properties":{"id":"20240612145104-hrr5c07","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 乌梅：拣净杂质，筛去灰屑，洗净，晒干。乌梅肉：取净乌梅微淋清水湿润，使肉绵软，略晾，敲碎，剥取净肉即成。或置蒸笼内蒸至极烂，放箩内揉擦，去核，取肉，晒干。乌梅炭：取净乌梅用武火炒至皮肉鼓起，出现焦枯斑点为度，喷水焙干，取出放凉。"}]},{"ID":"20240612145104-33gzm9p","Type":"NodeParagraph","Properties":{"id":"20240612145104-33gzm9p","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145104-lvxb602","Type":"NodeParagraph","Properties":{"id":"20240612145104-lvxb602","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 入肝、脾、肺、大肠经。"}]},{"ID":"20240612145104-vzbij5w","Type":"NodeParagraph","Properties":{"id":"20240612145104-vzbij5w","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"①王好古：\"入脾、肺二经血分。\""}]},{"ID":"20240612145104-fc782p5","Type":"NodeParagraph","Properties":{"id":"20240612145104-fc782p5","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、肾二经。\""}]},{"ID":"20240612145104-vsxndxp","Type":"NodeParagraph","Properties":{"id":"20240612145104-vsxndxp","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"入肝。\""}]},{"ID":"20240612145104-36qln4x","Type":"NodeParagraph","Properties":{"id":"20240612145104-36qln4x","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"入肺、胃、大肠三经。\""}]},{"ID":"20240612145104-w9877nb","Type":"NodeParagraph","Properties":{"id":"20240612145104-w9877nb","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145104-m8ntw7k","Type":"NodeParagraph","Properties":{"id":"20240612145104-m8ntw7k","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 酸，温。"}]},{"ID":"20240612145104-e2cr6iw","Type":"NodeParagraph","Properties":{"id":"20240612145104-e2cr6iw","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味酸，平。\""}]},{"ID":"20240612145104-3pyk4bq","Type":"NodeParagraph","Properties":{"id":"20240612145104-3pyk4bq","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240612145104-lhxyni6","Type":"NodeParagraph","Properties":{"id":"20240612145104-lhxyni6","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"③《日华子本草》：\"暖，无毒。\""}]},{"ID":"20240612145104-42e9w6v","Type":"NodeParagraph","Properties":{"id":"20240612145104-42e9w6v","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"④《医学启源》：\"气寒，味酸。\""}]},{"ID":"20240612145104-k20ivst","Type":"NodeParagraph","Properties":{"id":"20240612145104-k20ivst","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612145104-13uosf4","Type":"NodeParagraph","Properties":{"id":"20240612145104-13uosf4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 有实邪者忌服。"}]},{"ID":"20240612145104-drozmei","Type":"NodeParagraph","Properties":{"id":"20240612145104-drozmei","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"①孟诜：\"多食损齿，\""}]},{"ID":"20240612145104-xayl1tc","Type":"NodeParagraph","Properties":{"id":"20240612145104-xayl1tc","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"②《日华子本草》：\"多啖伤骨，蚀脾胃，令人发热。\""}]},{"ID":"20240612145104-xvxlcky","Type":"NodeParagraph","Properties":{"id":"20240612145104-xvxlcky","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"③《本草经疏》：\"不宜多食，齿痛及病当发散者咸忌之。\""}]},{"ID":"20240612145104-k6171lx","Type":"NodeParagraph","Properties":{"id":"20240612145104-k6171lx","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"咳嗽初起，气实喘促，胸膈痞闷，恐酸以束邪气，戒之。\""}]},{"ID":"20240612145104-1hx0xok","Type":"NodeParagraph","Properties":{"id":"20240612145104-1hx0xok","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑤《得配本草》：\"疟痢初起者禁用。\""}]},{"ID":"20240612145104-mmc35gp","Type":"NodeParagraph","Properties":{"id":"20240612145104-mmc35gp","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145104-47seg8y","Type":"NodeParagraph","Properties":{"id":"20240612145104-47seg8y","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 收敛生津，安蛔驱虫。治久咳，虚热烦渴，久疟，久泻，痢疾，便血，尿血，血崩，蛔厥腹痛、呕吐，钩虫病，牛皮癣，胬肉。"}]},{"ID":"20240612145104-ezs4vw5","Type":"NodeParagraph","Properties":{"id":"20240612145104-ezs4vw5","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主下气，除热烦满，安心，肢体痛，偏枯不仁，死肌，去青黑痣、恶肉。\""}]},{"ID":"20240612145104-5pavg45","Type":"NodeParagraph","Properties":{"id":"20240612145104-5pavg45","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"止下痢，好唾口干。\"\"利筋脉，去痹。\""}]},{"ID":"20240612145104-0kcmss1","Type":"NodeParagraph","Properties":{"id":"20240612145104-0kcmss1","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"伤寒烦热，水渍饮汁。\""}]},{"ID":"20240612145104-tf3gih1","Type":"NodeParagraph","Properties":{"id":"20240612145104-tf3gih1","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"④孟诜：\"大便不通，气奔欲死，以乌梅十颗，置汤中，须臾挼去核，杵为丸如枣大，纳下部，少时即通。擘破水渍，以少蜜相和，止渴。霍乱心腹不安，及痢赤、治疟方多用之。\""}]},{"ID":"20240612145104-qbtrinv","Type":"NodeParagraph","Properties":{"id":"20240612145104-qbtrinv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑤《本草拾遗》：\"去痰，主疟瘴，止渴调中，除冷热痢，止吐逆。\""}]},{"ID":"20240612145104-vt24x4g","Type":"NodeParagraph","Properties":{"id":"20240612145104-vt24x4g","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑥《日华子本草》：\"除劳，治骨蒸，去烦闷，涩肠止痢，消酒毒，治偏枯皮肤麻痹，去黑点，令人得睡。又入建茶、干姜为丸，止休息痢。\""}]},{"ID":"20240612145104-5gj59ar","Type":"NodeParagraph","Properties":{"id":"20240612145104-5gj59ar","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑦《本草图经》：\"主伤寒烦热及霍乱躁（’躁’一作’燥’）渴，虚劳瘦羸，产妇气痢等方中多用之。\""}]},{"ID":"20240612145104-9taj89v","Type":"NodeParagraph","Properties":{"id":"20240612145104-9taj89v","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑧《用药心法》：\"收肺气。\""}]},{"ID":"20240612145104-gl40d1u","Type":"NodeParagraph","Properties":{"id":"20240612145104-gl40d1u","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑨《纲目》：\"敛肺涩肠，治久嗽，泻痢，反胃噎膈，蛔厥吐利，消肿，涌痰，杀虫，解鱼毒、马汗毒、硫黄毒。\""}]},{"ID":"20240612145104-idxqg7r","Type":"NodeParagraph","Properties":{"id":"20240612145104-idxqg7r","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑩《本草求原》：\"治溲血、下血、诸血证，自汗，口燥咽干。\""}]},{"ID":"20240612145104-sa4vkce","Type":"NodeParagraph","Properties":{"id":"20240612145104-sa4vkce","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145104-4o355rl","Type":"NodeParagraph","Properties":{"id":"20240612145104-4o355rl","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.8～1.5钱；或入丸、散。外用：煅研干撒或调敷。"}]},{"ID":"20240612145104-36h7qx4","Type":"NodeParagraph","Properties":{"id":"20240612145104-36h7qx4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612145104-w8pgq3x","Type":"NodeParagraph","Properties":{"id":"20240612145104-w8pgq3x","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" ①治久咳不已：乌梅肉（微炒）、罂粟壳（去筋膜，蜜炒）等分，为末。每服二钱，睡时蜜汤调下。（《纲目》）"}]},{"ID":"20240612145104-1608btz","Type":"NodeParagraph","Properties":{"id":"20240612145104-1608btz","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"②治久痢不止，肠垢已出：乌梅肉二十个，水一盏，煎六分，食前，分二服。（《肘后方》）"}]},{"ID":"20240612145104-q9gfemv","Type":"NodeParagraph","Properties":{"id":"20240612145104-q9gfemv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"③治天行下痢不能食者：黄连一升，乌梅二十枚（炙燥）。并得捣末，蜡如棋子大，蜜一升，合于微火上，令可丸，丸如梧子大。一服二丸，日三。（《补缺肘后方》，即《圣惠方》乌梅丸）"}]},{"ID":"20240612145104-7lr9oxh","Type":"NodeParagraph","Properties":{"id":"20240612145104-7lr9oxh","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"④治痢兼渴：麦门冬三两（去心），乌梅二大枚。上二味，以水一大升煮取强半，绞去滓，待冷，细细咽之，即定，仍含之。（孟诜（必效方》）"}]},{"ID":"20240612145104-auh2os3","Type":"NodeParagraph","Properties":{"id":"20240612145104-auh2os3","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑤治便痢脓血：乌梅一两，去核，烧过为末。每服二钱，米饮下。（《圣济总录》）"}]},{"ID":"20240612145104-u9mu7fc","Type":"NodeParagraph","Properties":{"id":"20240612145104-u9mu7fc","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑥治大便下血不止：乌梅三两（烧存性），为末，用好醋打米糊丸，如梧桐子大，每服七十丸，空心米饮下。（《济生方》）"}]},{"ID":"20240612145104-vacm82e","Type":"NodeParagraph","Properties":{"id":"20240612145104-vacm82e","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑦治小便尿血：乌梅烧存性，研末，醋糊丸，梧子大。每服四十丸，酒下。（《纲目》）"}]},{"ID":"20240612145104-mxs2nx4","Type":"NodeParagraph","Properties":{"id":"20240612145104-mxs2nx4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑧治妇人血崩：乌梅烧灰，为末，以乌梅汤调下。（《妇人良方》）"}]},{"ID":"20240612145104-ic8qrld","Type":"NodeParagraph","Properties":{"id":"20240612145104-ic8qrld","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑨治消渴，止烦闷：乌梅肉二两（微炒），为末。每服二钱，水二盏，煎取一盏，去滓，入豉二百粒，煎至半盏，去滓，临卧时服。（《简要济众方》）"}]},{"ID":"20240612145104-3spypjm","Type":"NodeParagraph","Properties":{"id":"20240612145104-3spypjm","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑩治伤寒四、五日，头痛壮热，胸中烦痛：乌梅十四个，辣五合。水一升，煎取一半服，吐之。（《梅师集验方》）"}]},{"ID":"20240612145104-f7u5fiu","Type":"NodeParagraph","Properties":{"id":"20240612145104-f7u5fiu","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑾治伤寒蛔厥及久痢：乌梅三百枚，细辛六两，干姜十两，黄连十六两，当归四两，附子六两（炮，去皮），蜀椒四两（出汗），桂枝（去皮）六两，人参六两，黄柏六两。上十味，异捣筛，合治之，以苦酒渍乌梅一宿，去核，蒸之五斗米下，饭熟捣成泥，和药令相得，内臼中，与蜜杵二千下，丸如梧桐子大。先食饮服十丸，日三服，稍加至二十丸。禁生冷滑物臭食等。（《伤寒论》乌梅丸）"}]},{"ID":"20240612145104-ptr232o","Type":"NodeParagraph","Properties":{"id":"20240612145104-ptr232o","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⑿治蛔虫上行口鼻：乌梅肉噙之，或煎汤饮自下。（《日用本草》）"}]},{"ID":"20240612145104-2q902tw","Type":"NodeParagraph","Properties":{"id":"20240612145104-2q902tw","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⒀治伤寒下部生匿疮：乌梅肉二两，炒令燥，捣细罗为末，炼蜜和丸，如梧桐子大。每服食前，以石榴根皮汤下十丸。（《圣惠方》）"}]},{"ID":"20240612145104-uaoo9kp","Type":"NodeParagraph","Properties":{"id":"20240612145104-uaoo9kp","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⒁治劳疟劣弱者：乌梅十四枚，豆豉二合，桃、柳枝各一虎口握，甘草三寸长，生姜一块。以童子小便二升，煎七合，温服。（《本草图经》）"}]},{"ID":"20240612145104-yn97hf4","Type":"NodeParagraph","Properties":{"id":"20240612145104-yn97hf4","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⒂治一切疮肉出：乌梅烧为灰，杵末敷上，恶肉立尽。（《刘涓子鬼遗方》）"}]},{"ID":"20240612145104-xwnupv3","Type":"NodeParagraph","Properties":{"id":"20240612145104-xwnupv3","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⒃治咽喉肿痛：乌梅一两，双花二两，雄黄四钱。共为细末，炼蜜为丸，每丸一钱。一次一丸，含化徐徐咽下，日三次。（辽宁《中草药新医疗法资料选编》）"}]},{"ID":"20240612145104-5fmpikm","Type":"NodeParagraph","Properties":{"id":"20240612145104-5fmpikm","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⒄治化脓性指头炎：乌梅肉加适量的食醋研烂，或用乌梅二份，凡士林一份，制成乌梅软膏外敷，每日上药一次。此方对脉管炎所引起的指（趾）头溃疡也有效。（《草医草药简便验方汇编》）"}]},{"ID":"20240612145104-prv7g7u","Type":"NodeParagraph","Properties":{"id":"20240612145104-prv7g7u","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"⒅治小儿头疮，积年不差：乌梅肉，烧灰细研，以生油调涂之。（《圣惠方》）"}]},{"ID":"20240612145104-0zwtc9j","Type":"NodeParagraph","Properties":{"id":"20240612145104-0zwtc9j","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612145104-36shp5g","Type":"NodeParagraph","Properties":{"id":"20240612145104-36shp5g","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" ①治疗细菌性痢疾"}]},{"ID":"20240612145104-tgqcv1z","Type":"NodeParagraph","Properties":{"id":"20240612145104-tgqcv1z","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"取乌梅18克压碎，配合香附12克，加水150毫升文火煎熬，俟药液浓缩至50毫升时过滤，早晚分2次服。治疗50人，治愈48人。服药后大便恢复正常最短1天，最长5天；发热、恶心呕吐、腹痛，里急后重等症都在1～3天内消失；服药最短者2天，最长6天。治疗过程中未发现毒性反应，早期治疗效果较好。对个别病人加大剂量（乌梅、香附各1两）可以缩短疗程。"}]},{"ID":"20240612145104-lmnai7n","Type":"NodeParagraph","Properties":{"id":"20240612145104-lmnai7n","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"②治疗钩虫病"}]},{"ID":"20240612145104-g9kw4u0","Type":"NodeParagraph","Properties":{"id":"20240612145104-g9kw4u0","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"取乌梅0.5～1两，加水500毫升，煎成120毫升，早晨空腹1次服完；二煎在午餐前1次服下。或用乌梅去核，文火焙干研末，水泛为丸，每服1～2钱，每日3次，食前服。治疗20例，服药天数最少5天，最多23天，14例大便检查钩虫卵阴性，6例阳性。据临床观察，乌梅煎剂疗效似高于丸剂。"}]},{"ID":"20240612145104-b85fqxs","Type":"NodeParagraph","Properties":{"id":"20240612145104-b85fqxs","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"③治疗牛皮癣"}]},{"ID":"20240612145104-qcs7fnf","Type":"NodeParagraph","Properties":{"id":"20240612145104-qcs7fnf","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"取乌梅5斤水煎，去核浓缩成膏约1斤，每服半汤匙（约3钱），每日3次，治疗12例，服药12～37天不等，基本治愈5例，显著好转4例。"}]},{"ID":"20240612145104-aea7i0w","Type":"NodeParagraph","Properties":{"id":"20240612145104-aea7i0w","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"④其他"}]},{"ID":"20240612145104-rtht4qr","Type":"NodeParagraph","Properties":{"id":"20240612145104-rtht4qr","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"乌梅对胆囊有收缩作用，能促进胆汁排泄，其复方可用于治疗胆道蛔虫症。"}]},{"ID":"20240612145104-29dr3qp","Type":"NodeParagraph","Properties":{"id":"20240612145104-29dr3qp","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145104-aeajf9m","Type":"NodeParagraph","Properties":{"id":"20240612145104-aeajf9m","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612145104-s36apx9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612145104-s36apx9","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"《中华本草》：乌梅"}]},{"ID":"20240612145104-btnewf0","Type":"NodeParagraph","Properties":{"id":"20240612145104-btnewf0","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612145104-seyrhfm","Type":"NodeParagraph","Properties":{"id":"20240612145104-seyrhfm","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" Wū Méi"}]},{"ID":"20240612145104-69vxbva","Type":"NodeParagraph","Properties":{"id":"20240612145104-69vxbva","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612145104-gg4b7ci","Type":"NodeParagraph","Properties":{"id":"20240612145104-gg4b7ci","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 梅实、熏梅、桔梅肉、梅、春梅。"}]},{"ID":"20240612145104-4wv2xtv","Type":"NodeParagraph","Properties":{"id":"20240612145104-4wv2xtv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612145104-nwl8mj9","Type":"NodeParagraph","Properties":{"id":"20240612145104-nwl8mj9","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" Dark Plum Fruit, Smoked Plum, Dark Plum"}]},{"ID":"20240612145104-abh34ko","Type":"NodeParagraph","Properties":{"id":"20240612145104-abh34ko","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612145104-b316wdo","Type":"NodeParagraph","Properties":{"id":"20240612145104-b316wdo","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612145104-vulxvz0","Type":"NodeParagraph","Properties":{"id":"20240612145104-vulxvz0","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"1.《品汇精要》：梅，木似杏而枝干劲脆，春初时开白花，甚清馥，花将谢而叶始生，二月结实如豆，味酸美，人皆啖之。五月采将熟大于杏者，以百草烟熏至黑色为乌梅，以盐淹暴干者为白梅也。"}]},{"ID":"20240612145104-b7humlh","Type":"NodeParagraph","Properties":{"id":"20240612145104-b7humlh","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"2.《随息居饮食谱》：梅，生时宜蘸盐食，温胆生津，孕妇多嗜之，以小满前肥脆而不带苦者佳。多食损齿，生痰助热，凡痰嗽、疳膨、痞积、胀满、外感未清，女子天癸未行，及妇女汛期、产前、产后、痧痘后"}]},{"ID":"20240612145104-8myp6bx","Type":"NodeParagraph","Properties":{"id":"20240612145104-8myp6bx","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612145104-6gbv29k","Type":"NodeParagraph","Properties":{"id":"20240612145104-6gbv29k","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物梅近成熟果实经熏焙加工而成者。"}]},{"ID":"20240612145104-1re71s0","Type":"NodeParagraph","Properties":{"id":"20240612145104-1re71s0","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Armeniaca mume Sieb. [Prunus mume Sieb.et Zucc.]"}]},{"ID":"20240612145104-x848pqq","Type":"NodeParagraph","Properties":{"id":"20240612145104-x848pqq","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月间，当果实呈黄白或青黄色，尚未完全成熟时采摘。"}]},{"ID":"20240612145104-e7vxe4m","Type":"NodeParagraph","Properties":{"id":"20240612145104-e7vxe4m","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612145104-1rgmmdy","Type":"NodeParagraph","Properties":{"id":"20240612145104-1rgmmdy","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 我国各地多已栽培，以长江流域以南各地最多。"}]},{"ID":"20240612145104-b8ja40b","Type":"NodeParagraph","Properties":{"id":"20240612145104-b8ja40b","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612145104-b6fn47d","Type":"NodeParagraph","Properties":{"id":"20240612145104-b6fn47d","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 梅 落叶小乔木，高可达10m。树皮淡灰色，小枝细长，先端刺状。单叶互生；叶柄长1.5cm，被短柔毛；托叶早落；叶片椭圆状宽卵形，春季先叶开花，有香气，1-3朵簇生于二年生侧枝叶腋。花梗短；花萼通常红褐色，但有些品种花萼为绿色或绿紫色；花瓣5白色或淡红色，直径约1.5cm，宽倒卵形；雄蕊多数。果实近球形，直径2-3cm，黄色或绿白色，被柔毛；核椭圆形，先端有小突尖，腹面和背棱上的沟槽，表面具蜂窝状孔穴。花期春季，果期5-6月。"}]},{"ID":"20240612145104-3ah4v22","Type":"NodeParagraph","Properties":{"id":"20240612145104-3ah4v22","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612145104-9zzxmik","Type":"NodeParagraph","Properties":{"id":"20240612145104-9zzxmik","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 1.生物学特性 梅的适应性较强，耐寒。喜温暖湿润气候，需阳光充足，花期温度对产量影响极大，低于-5-6℃或高于20℃对座果率有明显影响，年平均气温16-23℃，年平均降雨量在1000mm以上的地区最适宜栽培。对土壤要求不严，以疏松肥沃、土层深厚、排水良好的砂质壤土为好。怕涝，耐干旱，低畦多湿之地不宜栽植。"}]},{"ID":"20240612145104-w027dsa","Type":"NodeParagraph","Properties":{"id":"20240612145104-w027dsa","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"2.栽培技术种子、嫁接、压条等方法繁殖。种子繁殖：于6月采果后取种子秋播。或将种子沙藏越冬，翌年2-3月春播。因种子繁殖不易保持原品种特性，所以只作砧木或育种选种用。一般以嫁接繁殖为主。嫁接：采用枝接或芽接，砧木用杏、李、梅等实生苗。枝接宜于春季萌芽前进行，芽接应于8月下旬至9月上旬进行，选阴天为宜，切忌在雨天。嫁接成活后，翌年春季萌芽前出圃定植。"}]},{"ID":"20240612145104-6cdp10e","Type":"NodeParagraph","Properties":{"id":"20240612145104-6cdp10e","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"3.田间管理 定植成活后，要进行中耕除草、施肥、灌溉、排水和整枝修剪等田间管理工作。施肥量因土壤性状、树龄、生长势而异。花前肥、采果肥以速效肥为主。落叶后冬肥宜重施，以腐熟堆肥、厩肥等有机肥为主，酹以磷、钾化肥。整形修剪以疏剪、轻量剪为宜，要求枝叉分布匀称。冬季剪去徒长枝，保留短果枝。春末夏初进行抹芽、摘心，以加速树冠形成。"}]},{"ID":"20240612145104-bmqvmuz","Type":"NodeParagraph","Properties":{"id":"20240612145104-bmqvmuz","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"4.病虫害防治 病害有炭疽病，4月下旬发病，6-8月为盛发期。发病前喷1：1：100-150波尔多液1-2次，以保护新梢；发病后喷洒50%甲基托布津1000倍液或50%多菌屡灵1000倍液，每隔7d1次，喷2-3次。虫害有桃红颈天牛，蛀食树干，严重时主干蛀空，植株枯死。防治方法，人工捕杀成虫或用黑光灯诱捕成虫。桃粉蚜可用2.5%溴氰菊酯2000-3000倍液，每隔7d喷1次，连续喷2-3次。"}]},{"ID":"20240612145104-4c26w6q","Type":"NodeParagraph","Properties":{"id":"20240612145104-4c26w6q","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612145104-1y00yg9","Type":"NodeParagraph","Properties":{"id":"20240612145104-1y00yg9","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴定 核果类球形或扁球形，直径2-3cm。表面棕黑色至乌黑色，皱缩于扩大镜下可见毛茸，基部有圆形果梗痕。果肉柔软或略硬，果核坚硬，椭圆形，棕黄色，表面有凹点，内含卵圆形、淡黄色种子1粒。具焦酸气，味极酸而涩。以个大、肉厚、柔润、味极酸者为佳。"}]},{"ID":"20240612145104-n4wk555","Type":"NodeParagraph","Properties":{"id":"20240612145104-n4wk555","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 粉末特征：果肉粉要棕黑色。①非腺毛大多为单细胞，少数2-5细胞，平直或弯曲作镰九状，浅黄棕色，长32-400(-720)μm，直径16-49μm，壁厚，非木化或微木化，表面有时可见螺纹交错的纹理，基部稍圆或平直，胞腔常含棕色物。②中果皮薄壁细胞皱缩，有时含草酸钙簇晶，直径26-35μm。③纤维单个或数个成束散列于薄壁组织中，长梭形，直径6-29μm，壁厚3-9μm，非木化或微木化。④表皮细胞表面观类多角形，胞腔含黑棕色物，有时可见毛茸脱落后的疤痕。⑤石细胞少见，长方形、类圆形或类多角形，直径20-36um，胞腔含红棕色物。"}]},{"ID":"20240612145104-3pn3c9s","Type":"NodeParagraph","Properties":{"id":"20240612145104-3pn3c9s","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612145104-ntzx8iv","Type":"NodeParagraph","Properties":{"id":"20240612145104-ntzx8iv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 果实含枸缘酸(citric acid)，苹果酸(malic acid)，草酸(oxalic acid)，琥珀酸(succinic acid)和延胡索酸(fumaric acid)总酸量约4%-5.5%，以前两种有机酸的含量较多。还含5-羟甲基-2-糠醛(5-hydroxymethyl-2-furaldehyde)，为无色油状物。所含挥发性成分，主要有苯甲醛(benzaldehyde)62.40%，4-松油烯醇(terpinen-4-ol)3.97%，苯甲醇(benzyl alcohol)3.97%和十六烷酸(hexadecanoic acid)4.55%。乌梅仁含苦杏仁甙(amygdalin)约0.5%，而梅仁含约4.3%。另有报道乌梅中还含苦味酸(picric acid)和超氧化物歧化酶(SOD)。"}]},{"ID":"20240612145104-ji5csrf","Type":"NodeParagraph","Properties":{"id":"20240612145104-ji5csrf","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612145104-8enpdue","Type":"NodeParagraph","Properties":{"id":"20240612145104-8enpdue","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 1.对蛔虫的作用 乌梅对蛔虫具有兴奋和刺激蛔虫后退的作用。如将乌梅煎剂加入置有蛔虫的1%盐水和0.1%碳酸氢钠溶液内可见蛔虫活动增强。给狗通过胃管给予乌梅煎剂50g并收集其的胆汁，在厌氧条件下，将蛔虫放入一直径0.3-0.5cm的胶管内，将胶管放入38℃的水盆内，从蛔虫头端入管内滴入收集的胆汁，结果可见大部分蛔虫从管内后退，有的蛔虫头从管内退出。也有报道从223种中药热水提取液体外试验，筛选具有杀肠虫作用的药物，发现乌梅有效。"}]},{"ID":"20240612145104-y6979bv","Type":"NodeParagraph","Properties":{"id":"20240612145104-y6979bv","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"2.抗病原生物作用 体外筛选发现，乌梅对多种致病菌有抑制作用，如痢疾杆菌、大肠杆菌、伤寒杆菌、副伤寒杆菌、百日咳杆菌、脑膜炎双球菌等。对结核杆菌也有抑制性作用，这一作用可能与所含枸橼酸和苹果酸有关。对某些致病性真菌如须疮癣、絮状表皮癣菌、石膏样小芽胞菌等也有抑制作用。"}]},{"ID":"20240612145104-y6gk63v","Type":"NodeParagraph","Properties":{"id":"20240612145104-y6gk63v","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"3.其它作用 乌梅具有钙离子拮抗作用，有较强的拮抗由钾离子引起的豚鼠结肠带收缩的活性，已分离出其活性成分是5-羟甲基-2-糠醛。对胆囊乌梅煎剂口服有轻微收缩作用。体外试验，乌梅对人子宫颈癌JTC-26株有抑制作用，抑制率在90%以上。小鼠玫瑰花环试验表明，乌梅对免疫功能有增强作用。"}]},{"ID":"20240612145104-fy0h79g","Type":"NodeParagraph","Properties":{"id":"20240612145104-fy0h79g","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612145104-d06wcxn","Type":"NodeParagraph","Properties":{"id":"20240612145104-d06wcxn","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 1.净制：拣净杂质，筛去灰屑，洗净，晒干。"}]},{"ID":"20240612145104-udxk4qo","Type":"NodeParagraph","Properties":{"id":"20240612145104-udxk4qo","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"2.乌梅肉：取净乌梅微淋清水湿润，使肉绵软，略晾，敲碎，剥取净肉即成。或置蒸笼内蒸至极烂，放箩内揉擦，去核，取肉，晒干。"}]},{"ID":"20240612145104-h13s3il","Type":"NodeParagraph","Properties":{"id":"20240612145104-h13s3il","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"3.乌梅炭：取净乌梅用武火炒至皮肉鼓起，出现焦枯斑点为度，喷水焙干，取出放凉。"}]},{"ID":"20240612145104-n4wcx9m","Type":"NodeParagraph","Properties":{"id":"20240612145104-n4wcx9m","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"4.醋制：取净乌梅或乌梅肉，用醋拌匀，闷润至醋被吸尽时，置适宜的容器内密闭，隔水或用蒸气加热2-4小时，取出干燥。"}]},{"ID":"20240612145104-pk33nc2","Type":"NodeParagraph","Properties":{"id":"20240612145104-pk33nc2","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"5.蒸制：取乌梅放入瓶内盖紧，置开水锅中蒸至上气后，停火间5小时，取出晒干。"}]},{"ID":"20240612145104-gfxts1u","Type":"NodeParagraph","Properties":{"id":"20240612145104-gfxts1u","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612145104-e55p0qc","Type":"NodeParagraph","Properties":{"id":"20240612145104-e55p0qc","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 薄层色谱 取本品粗粉0.1g，加蒸馏水5ml，沸水浴中渚20min，滤过。滤液于水浴上蒸干，以乙醇1ml溶解供点样。柠檬酸和苹果酸醇溶液为对照品。分别点样于同一硅胶G薄层板上，以醋酸丁酯-甲酸-水（4：2：2）上层液展开，用0.1%溴甲酚绿醇溶液显色。供试品色谱中，在与对照品色谱的本应位置上，显相同的黄色斑点。"}]},{"ID":"20240612145104-zcp2l7a","Type":"NodeParagraph","Properties":{"id":"20240612145104-zcp2l7a","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612145104-9zys1o3","Type":"NodeParagraph","Properties":{"id":"20240612145104-9zys1o3","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 肝；脾；肺；肾；胃；大肠经"}]},{"ID":"20240612145104-ypzx2mw","Type":"NodeParagraph","Properties":{"id":"20240612145104-ypzx2mw","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612145104-m1h0ld1","Type":"NodeParagraph","Properties":{"id":"20240612145104-m1h0ld1","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 味酸；性平"}]},{"ID":"20240612145104-lqmbxup","Type":"NodeParagraph","Properties":{"id":"20240612145104-lqmbxup","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612145104-bxoe0by","Type":"NodeParagraph","Properties":{"id":"20240612145104-bxoe0by","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 有实邪者忌服，胃酸过多者慎服。"}]},{"ID":"20240612145104-dw05owu","Type":"NodeParagraph","Properties":{"id":"20240612145104-dw05owu","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612145104-ogtlnvi","Type":"NodeParagraph","Properties":{"id":"20240612145104-ogtlnvi","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 敛肺止咳；涩肠止泻；止血；生津；安蛔。主久咳；虚热烦渴；久疟；久泻；痢疾；便血；尿血；血崩；蛔厥腹痛；呕吐；钩虫病"}]},{"ID":"20240612145104-u458nn1","Type":"NodeParagraph","Properties":{"id":"20240612145104-u458nn1","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612145104-gxm0s6k","Type":"NodeParagraph","Properties":{"id":"20240612145104-gxm0s6k","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，0.8-1.5钱；或入丸、散。外用：煅研干撒或调敷。"}]},{"ID":"20240612145104-wrrvz83","Type":"NodeParagraph","Properties":{"id":"20240612145104-wrrvz83","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612145104-igd6nes","Type":"NodeParagraph","Properties":{"id":"20240612145104-igd6nes","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 1.乌梅丸(《伤寒论》)，温脏安蛔，主治蛔厥证，心烦呕吐，时发时止，食入吐蛔，手足厥冷，腹痛，久痢，久泻等证。2.理中安蛔汤(《万病回春》)，温中安蛔，治中阳不振，脾胃虚寒，便溏尿清，腹痛肠鸣，四肢不温，舌苔薄白，脉虚缓，蛔虫从口中吐出，或由大便排出。3.连梅安蛔汤(《通俗伤寒论》)，清热安蛔，治虫积腹痛，不思饮食，食则吐蛔，甚则烦燥，厥逆，且有面赤，口燥，舌红，脉数身热等症。4.固肠丸(《证治准绳》)，补益涩肠止泻。5.一服散(《世医得效方》)，敛肺化痰止咳，主治肺虚久咳。6.玉泉丸(《沈氏尊生书》)，益气养阴，生津止渴，主治虚热烦咳，多饮，多尿，烦躁失眠等症。"}]},{"ID":"20240612145104-reo0qzu","Type":"NodeParagraph","Properties":{"id":"20240612145104-reo0qzu","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612145104-13ivc3m","Type":"NodeParagraph","Properties":{"id":"20240612145104-13ivc3m","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主下气，除热烦满，安心，肢体痛，偏枯不仁，死肌，去青黑痣、恶肉。"}]},{"ID":"20240612145104-bt65r7d","Type":"NodeParagraph","Properties":{"id":"20240612145104-bt65r7d","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"2.《别录》：止下痢，好唾口干。利筋脉，去痹。"}]},{"ID":"20240612145104-ljf7g97","Type":"NodeParagraph","Properties":{"id":"20240612145104-ljf7g97","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"3.陶弘景：伤寒烦热，水渍饮汁。"}]},{"ID":"20240612145104-yjbaeus","Type":"NodeParagraph","Properties":{"id":"20240612145104-yjbaeus","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"4.盂诜：大便不通，气奔欲死，以乌梅十颗，置汤中，须臾挼去核，杵为丸如枣大，纳下部，少时即通。擘破水渍，以少蜜相和，止渴。霍乱心腹不安，及痢赤、治疟方多用之。"}]},{"ID":"20240612145104-igxej9f","Type":"NodeParagraph","Properties":{"id":"20240612145104-igxej9f","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"5.《本草拾遗》：去痰，主疟瘴，止渴调中，除冷热痢，止吐逆。"}]},{"ID":"20240612145104-fygxbyj","Type":"NodeParagraph","Properties":{"id":"20240612145104-fygxbyj","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"6.《日华子本草》：除劳，治骨蒸，去烦闷，涩肠止痢，消酒毒，治偏枯皮肤麻痹，去黑点，令人得睡。又入建茶、干姜为丸，止休息痢。"}]},{"ID":"20240612145104-jm60zp2","Type":"NodeParagraph","Properties":{"id":"20240612145104-jm60zp2","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"7.《本草图经》：主伤寒烦热及霍乱躁（'躁'一作'燥'）渴，虚劳瘦赢，产妇气痢等方中多用之。"}]},{"ID":"20240612145104-ossc9ge","Type":"NodeParagraph","Properties":{"id":"20240612145104-ossc9ge","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"8.《用药心法》：收肺气。"}]},{"ID":"20240612145104-jeldwey","Type":"NodeParagraph","Properties":{"id":"20240612145104-jeldwey","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"9.《纲目》：敛肺涩肠，治久嗽，泻痢，反胃噎膈，蛔厥吐利，消肿，涌痰，杀虫，解鱼毒、马汗毒、硫黄毒。"}]},{"ID":"20240612145104-wdgsesq","Type":"NodeParagraph","Properties":{"id":"20240612145104-wdgsesq","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"10.《本草求原》：治溲血、下血、诸血证，自汗，口燥咽干。"}]},{"ID":"20240612145104-jqe9jtx","Type":"NodeParagraph","Properties":{"id":"20240612145104-jqe9jtx","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"11.王好古：乌梅，能收肺气，治燥嗽，肺欲收，急食酸以收之。"}]},{"ID":"20240612145104-5wpofe7","Type":"NodeParagraph","Properties":{"id":"20240612145104-5wpofe7","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"12.《纲目》：乌梅、白梅所主诸病，皆取其酸收之义。惟张仲景治蛔厥乌梅丸，及虫NI方中用者，取虫得酸即止之义，稍有不同耳。《医说》载曾鲁公痢血百余日，国医不能疗，陈应之用盐水梅肉一枚，研烂，合腊茶入醋服之，一啜而安。大丞梁庄肃公亦痢血，应之用乌梅、胡黄连、灶下土等分为末，茶调服亦效。盖血得酸即敛，得寒则止，得苦则涩故也。"}]},{"ID":"20240612145104-15kevir","Type":"NodeParagraph","Properties":{"id":"20240612145104-15kevir","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"13.《本草经疏》：梅实，即今之乌梅也，最酸。《经》曰：热伤气，邪客于胸中，则气上逆而烦满，心为之不安。乌梅味酸，能敛浮热，能吸气归元，故主下气，除热烦满及安心也。下痢者，大肠虚脱也；好唾口干者，虚火上炎，津液不足也；酸能敛虚火，化津液，固肠脱，所以主之也。其主肢体痛，偏枯不仁者，盖因湿气浸于经络，则筋脉弛纵，或疼痛不仁；肝主筋，酸入肝而养筋，肝得所养，则骨正筋柔，机关通利而前证除矣。"}]},{"ID":"20240612145104-2he7lot","Type":"NodeParagraph","Properties":{"id":"20240612145104-2he7lot","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"14.《本草新编》：鸟梅，止痢断疟，每有速效。"}]},{"ID":"20240612145104-ktqkd7e","Type":"NodeParagraph","Properties":{"id":"20240612145104-ktqkd7e","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"15.《本草求真》：乌梅，酸涩而温，似有类于木瓜，但此入肺则收，入肠则涩，入筋与骨则软，入虫则伏，入于死肌、恶肉、恶痣则除，刺入肉中则拔，故于久泻久痢，气逆烦满，反胃骨蒸，无不因其收涩之性，而使下脱上逆皆治。且于痈毒可敷，中风牙关紧闭可开，蛔虫上攻眩仆可治，口渴可止，宁不为酸涩收敛之一验乎。不似木瓜功专疏泄脾胃筋骨湿热，收敛脾肺耗散之元，而于他症则不及也。但肝喜散恶收，久服酸味亦伐生气，且于诸症初起切忌。"}]},{"ID":"20240612145104-pmwy72u","Type":"NodeParagraph","Properties":{"id":"20240612145104-pmwy72u","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612145104-edhrbww","Type":"NodeParagraph","Properties":{"id":"20240612145104-edhrbww","updated":"20240612145104"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612145102-7g6ic58","Type":"NodeThematicBreak","Properties":{"id":"20240612145102-7g6ic58"}},{"ID":"20240612144801-8u901sq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612144801-8u901sq","updated":"20240612144912"},"Children":[{"Type":"NodeText","Data":"微信文章："}]},{"ID":"20240612144912-zqic8fz","Type":"NodeParagraph","Properties":{"id":"20240612144912-zqic8fz"}},{"ID":"20240612144913-oncekmc","Type":"NodeParagraph","Properties":{"id":"20240612144913-oncekmc","updated":"20240612144913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本草汇言】"}]},{"ID":"20240612144913-t63qksh","Type":"NodeParagraph","Properties":{"id":"20240612144913-t63qksh","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《神农本草经》：梅实，味酸，平。主下气，除热，烦满，安心，肢体痛，偏枯不仁，死肌，去青黑志，恶疾。生川谷。"}]},{"ID":"20240612144913-lu3lorx","Type":"NodeParagraph","Properties":{"id":"20240612144913-lu3lorx","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：梅实（《大观本草》作核）。明目，益气，（《御览》）不饥（《大观本草》，引吴氏本草）。"}]},{"ID":"20240612144913-0o3jbl0","Type":"NodeParagraph","Properties":{"id":"20240612144913-0o3jbl0","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汉中，五月采，火干。案《说文》云：（左木右上艹下尞），干梅之属，或作（左氵右上艹下尞），某、酸果也，以梅为楠。"}]},{"ID":"20240612144913-kt48k47","Type":"NodeParagraph","Properties":{"id":"20240612144913-kt48k47","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《尔雅》云：梅楠。郭璞云：似杏实酢，是以某注梅也，《周礼》笾人，馈食，笾、其实干（左木右上艹下尞）。郑云：干（左木右上艹下尞），干梅也，有桃诸梅诸，是其干者。"}]},{"ID":"20240612144913-v2xtowq","Type":"NodeParagraph","Properties":{"id":"20240612144913-v2xtowq","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《毛诗》疏云：梅暴为腊，羹臛世中，人含之以香口（《大观本草》）。上果，中品一种，旧同。"}]},{"ID":"20240612144913-memvavq","Type":"NodeParagraph","Properties":{"id":"20240612144913-memvavq","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《名医别录》：无毒。止下痢，好唾，口干"}]},{"ID":"20240612144913-3wtj631","Type":"NodeParagraph","Properties":{"id":"20240612144913-3wtj631","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《食疗本草》："}]},{"ID":"20240612144913-hhmq4my","Type":"NodeParagraph","Properties":{"id":"20240612144913-hhmq4my","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"（一）食之除闷，安神。乌梅多食损齿。〔心·嘉〕"}]},{"ID":"20240612144913-5awxnuw","Type":"NodeParagraph","Properties":{"id":"20240612144913-5awxnuw","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"（二）又，刺在肉中，嚼白梅封之，刺即出。〔嘉〕"}]},{"ID":"20240612144913-nkwaiai","Type":"NodeParagraph","Properties":{"id":"20240612144913-nkwaiai","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"（三）又，大便不通，气奔欲死：以乌梅十颗置汤中，须臾挼去核，杵为丸，如枣大。内下部，少时即通。〔嘉〕"}]},{"ID":"20240612144913-wjmozsr","Type":"NodeParagraph","Properties":{"id":"20240612144913-wjmozsr","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"（四）谨按：擘破水渍，以少蜜相和，止渴、霍乱心腹不安及痢赤。治疟方多用之。〔嘉〕"}]},{"ID":"20240612144913-eixxx9i","Type":"NodeParagraph","Properties":{"id":"20240612144913-eixxx9i","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草拾遗》：本功外，止渴，令人膈上热。乌梅去痰，主疟瘴，止渴调中，除冷热痢，止吐逆。"}]},{"ID":"20240612144913-o8mqcse","Type":"NodeParagraph","Properties":{"id":"20240612144913-o8mqcse","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《日华子本草》：暖，无毒。除劳，治骨蒸，烦闷，涩肠，止痢，消酒毒，治偏枯，皮肤麻痹，去黑点，令人得睡。"}]},{"ID":"20240612144913-25s00i6","Type":"NodeParagraph","Properties":{"id":"20240612144913-25s00i6","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《开宝本草》：味酸，平，无毒。止下痢，好唾，口干。"}]},{"ID":"20240612144913-7t3d6dr","Type":"NodeParagraph","Properties":{"id":"20240612144913-7t3d6dr","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草图经》：除痰。"}]},{"ID":"20240612144913-ih677hn","Type":"NodeParagraph","Properties":{"id":"20240612144913-ih677hn","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草衍义》： 食梅则津液泄，水生木也。津液泄，故伤齿。肾属水，外为齿，故也。王叔和曰：膀胱、肾合为津府。此语虽鄙，然理存焉。熏之为乌梅，曝干藏密器中为白梅。"}]},{"ID":"20240612144913-4dd0bxw","Type":"NodeParagraph","Properties":{"id":"20240612144913-4dd0bxw","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《药类法象》：主下气，除热烦满，安心调中，治痢止渴。以盐豉为白梅，亦入除痰药中用"}]},{"ID":"20240612144913-mjrr9gu","Type":"NodeParagraph","Properties":{"id":"20240612144913-mjrr9gu","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《汤液本草》：内容：气平，味酸。酸温，阳也。无毒。"}]},{"ID":"20240612144913-sxjf5ee","Type":"NodeParagraph","Properties":{"id":"20240612144913-sxjf5ee","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《象》云∶主下气，除热烦满，安心调中，治痢止渴。以盐为白梅，亦入除痰药。去核用。"}]},{"ID":"20240612144913-9ybcgew","Type":"NodeParagraph","Properties":{"id":"20240612144913-9ybcgew","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《心》云∶收肺气。"}]},{"ID":"20240612144913-kr8c6f5","Type":"NodeParagraph","Properties":{"id":"20240612144913-kr8c6f5","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草》云∶主肢体痛，偏枯不仁，死肌。去青黑痣恶疾，止下痢，好唾口干，去骨间热。又方，治一切恶疮肉出，以乌梅烧为灰，杵末，敷上，恶肉立尽。仲景治吐蛔下利，乌梅丸。"}]},{"ID":"20240612144913-weogdgo","Type":"NodeParagraph","Properties":{"id":"20240612144913-weogdgo","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草蒙筌》：味酸，气平。可升可降，阳也。无毒。处处栽植，夏月摘收。火熏干者色乌，日曝干者色白。因制有二，故名不同。凡欲用之，俱宜去核。乌梅收敛肺气，解渴除烦。因"}]},{"ID":"20240612144913-huou37d","Type":"NodeParagraph","Properties":{"id":"20240612144913-huou37d","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"涩大肠，禁痢止泻。却伤寒温疟，逐虚劳骨蒸。同建茶干姜为丸，治休息久痢尤验。黑痣可脱，虫痛能安。白梅杵烂成膏，敷攻恶毒。治妇人乳痈最效，拔肉中煎镞如神。中风紧闭牙关，急宜将肉摩擦。叶煮汁服，久痢亦除。"}]},{"ID":"20240612144913-hd8jmi9","Type":"NodeParagraph","Properties":{"id":"20240612144913-hd8jmi9","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草发挥》：成聊摄云：肺主气。肺欲收，急食酸以收之，乌梅之酸以收阳。"}]},{"ID":"20240612144913-d436oky","Type":"NodeParagraph","Properties":{"id":"20240612144913-d436oky","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草纲目》：所主诸病，皆取酸收之义。惟仲景治蛔厥乌梅丸及虫匿方中用者，取虫得酸即止之义，稍有不同耳。大丞梁庄肃公痢血，应用乌梅胡黄连灶下土等分为末，茶调服，亦效。盖血得酸则敛，得寒则止，得苦则涩故也。其蚀恶疮胬肉，虽是酸收，却有物理之妙。说出《本经》，其法载于《刘涓子鬼遗方》：用乌梅肉烧存性，研敷恶肉上，一夜立尽。《圣惠》用乌梅和蜜作饼贴者，其力缓。《简便方》：起臂生一痈，脓溃百日方愈，中有恶肉突起，如蚕豆大，月余不消，医治不效，因阅本草得此方，试之，一日夜去其大半，再上一日而平。"}]},{"ID":"20240612144913-xbogkll","Type":"NodeParagraph","Properties":{"id":"20240612144913-xbogkll","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"敛肺涩肠，止久嗽泻痢，反胃噎膈，蛔厥吐利，消肿涌痰，杀虫，又治泻痢烦渴，霍乱吐下，下血血崩。"}]},{"ID":"20240612144913-ghx24zz","Type":"NodeParagraph","Properties":{"id":"20240612144913-ghx24zz","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《药鉴》：气平，味酸，无毒。收敛肺气，扫除烦热，安心调中，治痢截疟，生津止渴，消痰益精。如恶疮肉出，烧灰敷上，恶肉立尽。仲景治吐蛔下痢，用乌梅丸极验。同建茶、干姜为丸，治休息痢疾甚效。"}]},{"ID":"20240612144913-bdg46de","Type":"NodeParagraph","Properties":{"id":"20240612144913-bdg46de","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草经疏》：梅实，即今之乌梅也。梅得木气之全，故其味最酸，所谓曲直作酸是也。经曰：热伤气。邪客于胸中，则气上逆而烦满，心为之不安。乌梅味酸，能敛浮热，能吸气归元，故主下气，除热烦满，及安心也。下痢者，大肠虚脱也。好唾口干者，虚火上炎，津液不足也。酸能敛虚火，化津液，固肠脱，所以主之也。其主腰体痛，偏枯不仁者，盖因湿气侵于经络，则筋脉弛纵，或疼痛不仁。肝主筋，酸入肝而养筋，肝得所养，则骨正筋柔，机关通利，而前证除矣。其主去死肌，青黑痣，恶肉者，白梅之功也。白梅味咸，咸能软坚故也。又能消痰，醒睡，止霍乱，解酒毒。弘景云：生梅、乌梅、白梅功用大约相似，第乌梅较良，资用更多。"}]},{"ID":"20240612144913-rvvpsuq","Type":"NodeParagraph","Properties":{"id":"20240612144913-rvvpsuq","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"简误：《素问》云：味过于酸，肝气以津。又云：酸走筋，筋病无多食酸。以肝主筋，性喜升发，酸味敛束，是违其性之所喜也。梅实过酸，不宜多食。齿痛及病当发散者，咸忌之。"}]},{"ID":"20240612144913-rvw834i","Type":"NodeParagraph","Properties":{"id":"20240612144913-rvw834i","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《雷公炮制药性解》：乌梅，味酸，性温，无毒，入肺、肾二经。主生津液，解烦热，止吐逆，除疟瘴，止久痢，消酒毒。又主皮肤黑点，麻痹不仁。去核用。"}]},{"ID":"20240612144913-p31m19t","Type":"NodeParagraph","Properties":{"id":"20240612144913-p31m19t","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"按：乌梅入肺者，经所谓“肺欲收，急食酸以收之”是也；肾则其所生者也，宜并入之。多食最宜损齿。风寒初起、疟痢未久者，不可骤以此收敛也。"}]},{"ID":"20240612144913-p1f5zto","Type":"NodeParagraph","Properties":{"id":"20240612144913-p1f5zto","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草乘雅半偈》：（本经中品）"}]},{"ID":"20240612144913-48va8zs","Type":"NodeParagraph","Properties":{"id":"20240612144913-48va8zs","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【气味】酸平，无毒。"}]},{"ID":"20240612144913-ym2xe8g","Type":"NodeParagraph","Properties":{"id":"20240612144913-ym2xe8g","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【主治】主下气，除热烦满，安心，止肢体痛，偏枯不仁，死肌，去青黑痣、恶肉。"}]},{"ID":"20240612144913-m24gb60","Type":"NodeParagraph","Properties":{"id":"20240612144913-m24gb60","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【核】曰∶梅叶皆似杏，叶端有尖，先春而花，凌霜傲雪，清芬袭人。其子青赤者，其材坚；其子青白者，其材脆。品类极繁，江梅遗核野生，不经栽接者，名直脚梅，凡山谷水滨，及荒凉迥绝之处，皆此本也。花小而疏瘦有韵、香烈实小而硬。早梅冬至前开，故得早名，要非风土之正。消梅其实圆小多液，惟堪青啖。古梅枝干 曲，苍藓鳞封，苔须缀枝，几长数寸，绿丝风扬，飘飘拂人。重叶梅，花瓣数层，如小白莲，花房独出，结实多双，尤为瑰异。又绿萼梅、朱梅、百叶缃梅、鸳鸯梅、檀香、玉蝶诸品，皆堪清玩。若大庾岭梅，南枝已落，北枝方开，寒燠异土，迟早顿殊。入药以野生，及未经就接者为贵。修事乌梅，取青梅篮盛，置于突上熏黑。若以稻灰淋汁润蒸，则肥泽不蠹。"}]},{"ID":"20240612144913-oia7f7z","Type":"NodeParagraph","Properties":{"id":"20240612144913-oia7f7z","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【 】曰∶梅，昧也。爽旦微明，春生之象也。先春而华，吸冰雪以自濡。色青味酸，入厥阴肝，肝色青，肝味酸故也。故主吮泄肾液，以润筋膜。经云∶味过于酸，肝气已津，谭说酢梅，口中酸出，吮泄之力可征矣。"}]},{"ID":"20240612144913-8zv653v","Type":"NodeParagraph","Properties":{"id":"20240612144913-8zv653v","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草易读》：去核炒用。"}]},{"ID":"20240612144913-6j4x6yc","Type":"NodeParagraph","Properties":{"id":"20240612144913-6j4x6yc","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"酸，涩，微寒，无毒。入足厥阴肝。下气退热，除呕杀蛔。止燥渴而泄烦满，平久嗽而住渴痢，清痰涎而消肿痛，蚀恶肉而点黑痣。收二便之下血，除偏风之不仁；松霍乱之转筋，开"}]},{"ID":"20240612144913-9bycwig","Type":"NodeParagraph","Properties":{"id":"20240612144913-9bycwig","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"痰厥之牙关。生汉中川谷。五月采实。襄汉、川蜀、江湖、淮岭皆有之。树、叶皆似杏，采梅实半黄者，以烟熏之为乌梅。取青大者，以盐汁渍之，日晒夜渍，十日则成白梅，主治略同。"}]},{"ID":"20240612144913-gmyzgg4","Type":"NodeParagraph","Properties":{"id":"20240612144913-gmyzgg4","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"诸疮肉，乌梅肉烧末敷之。（验方第一。）"}]},{"ID":"20240612144913-x7xxm4n","Type":"NodeParagraph","Properties":{"id":"20240612144913-x7xxm4n","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"渴痢，水煎代茶饮。（第二。）"}]},{"ID":"20240612144913-h8h7w8g","Type":"NodeParagraph","Properties":{"id":"20240612144913-h8h7w8g","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"痢脓血，净肉烧末，每米汤下二钱。（第三。）"}]},{"ID":"20240612144913-pax7q1v","Type":"NodeParagraph","Properties":{"id":"20240612144913-pax7q1v","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"久痢不止，净肉二十枚，水煎服。（第四。）"}]},{"ID":"20240612144913-d0ada61","Type":"NodeParagraph","Properties":{"id":"20240612144913-d0ada61","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"大便血，净肉三两，烧末醋煎，米汤丸服。（第五。）"}]},{"ID":"20240612144913-gl7hbww","Type":"NodeParagraph","Properties":{"id":"20240612144913-gl7hbww","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"小便尿血。同上。（第六。）"}]},{"ID":"20240612144913-usu1dh6","Type":"NodeParagraph","Properties":{"id":"20240612144913-usu1dh6","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"崩血不止，净肉烧末米饮下。（第七。）"}]},{"ID":"20240612144913-n93kx7p","Type":"NodeParagraph","Properties":{"id":"20240612144913-n93kx7p","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"蛔虫上行，退场门鼻，煎汤服且含之。（第八。）"}]},{"ID":"20240612144913-nztpedy","Type":"NodeParagraph","Properties":{"id":"20240612144913-nztpedy","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"心腹胀痛，短气欲绝，净肉二七枚煎沸，纳铜钱二七枚煎服。（第九。）"}]},{"ID":"20240612144913-g9msx63","Type":"NodeParagraph","Properties":{"id":"20240612144913-g9msx63","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"久嗽不已，净肉炒，蜜粟壳同炒末，蜜汤下。（第十。）"}]},{"ID":"20240612144913-qazzbey","Type":"NodeParagraph","Properties":{"id":"20240612144913-qazzbey","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"金疮折伤，烧末敷之，白者亦可。（十一。）"}]},{"ID":"20240612144913-kohhujh","Type":"NodeParagraph","Properties":{"id":"20240612144913-kohhujh","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"白梅同用。"}]},{"ID":"20240612144913-ksxc6ry","Type":"NodeParagraph","Properties":{"id":"20240612144913-ksxc6ry","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"乌梅丸乌梅 人参 细辛 桂枝 附子 黄柏 当归 川椒 黄连 干姜"}]},{"ID":"20240612144913-hw0z6e0","Type":"NodeParagraph","Properties":{"id":"20240612144913-hw0z6e0","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"治厥阴病，气上冲胸，心痛热，消渴，食即烦生而吐蛔。（诸方第一。）"}]},{"ID":"20240612144913-tn04ylm","Type":"NodeParagraph","Properties":{"id":"20240612144913-tn04ylm","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草崇原》：气味酸温平涩，无毒。主治下气，除热，烦满，安心，止肢体痛，偏枯不仁，死肌，去青黑志，蚀恶肉。（志痣同。）"}]},{"ID":"20240612144913-7fl5ki4","Type":"NodeParagraph","Properties":{"id":"20240612144913-7fl5ki4","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"（梅实将熟时，采微黄者，篮盛于突上熏黑，若以稻灰淋汁，润湿蒸过，则肥泽不蛀。）"}]},{"ID":"20240612144913-oeieggz","Type":"NodeParagraph","Properties":{"id":"20240612144913-oeieggz","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"梅花放于冬，而实熟于夏，独得先春之气，故其味酸，其气温平而涩，涩附于酸也。主下气者，得春生肝木之味，生气上升，则逆气自下矣。除热烦满者，禀冬令水阴之精，水精上滋，则烦热除而胸膈不满矣。安心者，谓烦热除而胸膈不满，则心气亦安。肢体痛，偏枯不仁，死肌，皆阳气虚微，不能熏肤充身泽毛，若雾露之溉。梅实结于春而熟于夏，主敷布阳气于肌腠，故止肢体痛，及偏枯不仁之死肌。阳气充达，则其颜光，其色鲜，故去面上之青黑痣，及身体虫蚀之恶肉。"}]},{"ID":"20240612144913-1v5591y","Type":"NodeParagraph","Properties":{"id":"20240612144913-1v5591y","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"愚按∶乌梅味酸，得东方之木味，放花于冬，成熟于夏，是禀冬令之水精而得春生之上达也。后人不体经义，不穷物理，但以乌梅为酸敛收涩之药，而春生上达之义未之讲也，惜哉。"}]},{"ID":"20240612144913-vcjrbc2","Type":"NodeParagraph","Properties":{"id":"20240612144913-vcjrbc2","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草新编》：乌梅味酸，气平，可升可降，阳也，无毒。收敛肝气，固涩大肠，止血痢，安虫痛。乃止脱之药，备之以敛滑脱可也。"}]},{"ID":"20240612144913-31gqr00","Type":"NodeParagraph","Properties":{"id":"20240612144913-31gqr00","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"按：乌梅止痢断疟，每有速功。然效速者，取快于一时，往往有变生久病而不能愈，不可不慎也。世有夏日将乌梅作汤以止渴者，腹中无暑邪者，可以敛肺而止渴。倘有暑邪未散，而结闭于肠胃之中，及至秋冬，不变为痢，必为疟矣。乌梅治蛔厥，蛔上入膈，故烦而呕，用之即定矣。"}]},{"ID":"20240612144913-wy6wrb5","Type":"NodeParagraph","Properties":{"id":"20240612144913-wy6wrb5","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本经逢原》：酸收，益津开胃，同建茶、干姜，治休息痢，能敛肺涩肠，止呕敛汗，定喘安蛔。仲景治蛔厥，乌梅丸用之，虫得酸即止。用丸不用汤者，欲留有形之物，入于虫口也。今治血痢必用之。中风惊痰，喉痹肿痛，痰厥僵仆，牙关紧闭者，取乌梅擦牙龈即开。血痢不止，以乌梅烧存性，米汤服之渐止。恶疮胬肉，亦烧灰研敷，恶肉自消。此即《本经》去死肌恶肉之验。"}]},{"ID":"20240612144913-t3m68h3","Type":"NodeParagraph","Properties":{"id":"20240612144913-t3m68h3","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草经解》：乌梅气平，秉天秋收之金气，入手太阴肺经；味酸无毒，得地东方之木味，入足厥阴肝经。气味俱降，阴也。\n肺主气，气平则降，所以下气；肝属木，木枯火炎，逆于胸中，则热而烦满，乌梅味酸,能收浮热，吸气下行，所以止烦满也。\n心者火也，木之子，味酸气平，能平肝木，木和心自安也。\n肢体属脾，脾为土，肝木克土则痛，味酸则敛，所以止痛。\n肝藏血，血枯则偏枯不仁死肌矣，味酸益肝血，血和则润，不仁死肌愈也。\n去青黑痣，及蚀恶肉，酸收之味外治，能消痣与肉也。"}]},{"ID":"20240612144913-l5jpger","Type":"NodeParagraph","Properties":{"id":"20240612144913-l5jpger","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草从新》：涩肠敛肺。"}]},{"ID":"20240612144913-fvhxa18","Type":"NodeParagraph","Properties":{"id":"20240612144913-fvhxa18","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"酸涩而温脾肺。血分之果。涩肠敛肺。（肺欲收、急食酸以收之。）止血涌痰。消肿解毒。"}]},{"ID":"20240612144913-hb31zje","Type":"NodeParagraph","Properties":{"id":"20240612144913-hb31zje","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"生 津止渴。（时珍曰∶梅、花于冬而实于夏、得木之全气、故最酸、胆为甲木、肝为乙木、人 舌下有四窍、两通胆液、故食酸则津生。）醒酒杀虫。治久嗽泻痢。（血痢尤良。梁庄肃公 血痢、陈应之用乌梅、胡黄连、灶下土等分为末、茶调服而愈、曾鲁公血痢百余日、国医不 能疗、应之用盐梅肉一枚、研烂、合腊茶入醋服、一啜而安。）瘴疟霍乱。吐逆反胃。下血血崩。安蛔厥。（蛔虫上攻而眩仆、虫得酸则伏、）去黑痣。蚀恶肉。（疽愈后有肉突起、烧存 两日而平。）病有当发表者。大忌酸收。误食必为害。青梅熏黑为 泽不蠹。大便不通、气奔欲死者、乌梅十颗、汤浸去核、丸枣大、纳入下部、少时即通。）产安吉者。肉浓多脂、最佳。（合溪者次之、长沙梅、福建梅、肉薄无脂、不堪用。）"}]},{"ID":"20240612144913-r3ya7ce","Type":"NodeParagraph","Properties":{"id":"20240612144913-r3ya7ce","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"白梅酸涩咸平。功用略同乌梅。治痰厥僵仆。牙关紧闭。（取肉揩擦牙龈、涎出即开、盖 酸先入筋、齿软即易开、若用铁器搅开、恐伤其齿。）惊痫喉痹。梅核膈气。（取半青半黄梅"}]},{"ID":"20240612144913-h4dneju","Type":"NodeParagraph","Properties":{"id":"20240612144913-h4dneju","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"子、每个用盐一两、淹一日夜、晒干、又浸又晒、至水尽乃止、用青钱三个夹二梅、麻线缚"}]},{"ID":"20240612144913-x94xv7l","Type":"NodeParagraph","Properties":{"id":"20240612144913-x94xv7l","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"定、通装磁罐内、封埋地下、百日取出、每用一枚含之、咽汁入喉即消、收一年者、治一人"}]},{"ID":"20240612144913-cgnokvt","Type":"NodeParagraph","Properties":{"id":"20240612144913-cgnokvt","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"、收二年者、治二人、神效。）敷乳痈肿毒。刺入肉中。（捣烂罨之、即出、疮中弩肉、捣饼贴之、即收。）刀箭伤肤。（捣敷、血即止。）多食损齿伤筋。（经曰∶酸走筋、筋病无多食酸、若过食而齿 者、嚼胡桃肉以解之。）盐渍为白梅。（取大青梅以盐汁渍之、日晒夜渍、十 日成矣、久乃上霜、故又名盐梅。衣生霉点者、梅叶煎汤、洗之即去、清水揉梅叶、洗蕉葛衣、经夏不脆、有验。）根叶、治休息痢及霍乱。煮浓汁饮之。"}]},{"ID":"20240612144913-j7ai9jo","Type":"NodeParagraph","Properties":{"id":"20240612144913-j7ai9jo","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《得配本草》：忌猪肉。"}]},{"ID":"20240612144913-sf69o9p","Type":"NodeParagraph","Properties":{"id":"20240612144913-sf69o9p","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"酸、涩、温。入手足太阴经气分，兼入足厥阴经血分。敛肺涩肠，生津止渴。治久嗽泻痢，反胃噎膈，虚劳骨蒸，霍乱劳疟，蛔厥吐利，止血涌痰，醒酒杀虫。去黑痣，蚀恶肉。解鱼毒硫黄毒。得川连，治赤痢肠痛。配建茶、干姜，治休息痢。佐麦冬，治产后痢渴。入补脾药，止久泄虚脱。汤浸去核，捣丸如枣大，纳入谷道，导大便不通。"}]},{"ID":"20240612144913-5cj2nb2","Type":"NodeParagraph","Properties":{"id":"20240612144913-5cj2nb2","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"去核煅炭，敷疮蚀恶肉立效。其核中仁，能清妇人子脏风气积滞。病宜发散，疟痢初起者，禁用。"}]},{"ID":"20240612144913-ctk3yjd","Type":"NodeParagraph","Properties":{"id":"20240612144913-ctk3yjd","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"怪症：下颊忽落，用乌梅口衔一枚，外用南星末，姜汁调涂两颊，一夜即上。"}]},{"ID":"20240612144913-63i8nsd","Type":"NodeParagraph","Properties":{"id":"20240612144913-63i8nsd","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草求真》：［批］入肺敛气涩肠。\n乌梅专入肺、肠，兼入肝、胆。酸涩而温。似有类于木瓜，但此入肺则收，成无己曰：肺欲收，急食酸以收之。入肠则涩，肠垢已出，《肘后》用乌梅肉二十个，水一盏，煎六分,食前服；血崩不止，用乌梅肉七枚，烧存性研末，米饮服之，日二次。庄肃公痢血，用乌梅、胡黄连、灶下土等分为末，茶调服亦效。盖血得酸则敛，得寒则止，得苦则涩故也。入筋与骨则软，酸入筋。入虫则伏，虫得酸则伏。入于死肌恶肉、恶痣则除。《鬼遗方》用乌梅肉烧存性，研敷恶肉上，一夜立尽。《圣惠》乌梅和蜜作饼贴者，其力缓。《简便方》云,起臂生一疽，脓溃百日方愈，中有恶肉突起，用此方试之，一日夜去其大半，再上一日而平，乃知世有奇方。刺入肉中则拔。故于久泻久痢，气逆烦满，反胃骨蒸，无不因其收之性,而使下脱上逆皆治。且于痈毒可敷，已溃未溃，可用此烧灰存性为末，入轻粉少许，香油.  调涂四围。中风牙关紧闭可开，取肉擦牙龈，涎出即开，以酸能入筋骨以软。蛔虫上攻眩仆可治，仲景有乌梅治蛔上攻眩仆。口渴可止，时珍曰：人之舌下有四窍，两窍通胆液，故食梅则津生者，类相感应也。《素问》云：味过于酸，肝气以泄。又云，酸走筋，筋病无多食酸，不然，物之味酸者多矣，何独梅能生津耶。宁不为酸涩收敛之一验乎。不似木瓜功专疏.  泄脾胃筋骨湿热，收敛脾肺耗散之元，而于他症则不及也。\n但肝喜散恶收，久服酸味亦伐生气，生气者，阳气也。且于诸症初起切忌。"}]},{"ID":"20240612144913-bqxnrl6","Type":"NodeParagraph","Properties":{"id":"20240612144913-bqxnrl6","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《神农本草经读》：味酸，平。主下气，除热烦满，安心，肢体痛，偏枯，不仁，死肌，去青黑誌，恶肉。"}]},{"ID":"20240612144913-k48y5s6","Type":"NodeParagraph","Properties":{"id":"20240612144913-k48y5s6","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本经疏证》：梅之花苞于盛冬，开于先春，梅之实结于初春,成于初夏，故梅之用，能吸寒水，以成制相火之功。其所以吸，则厥阴风木为之体，所以制，则少阴君火为之用。是何也？风木者,宣发之气，而其味酸则主乎收，君火者，昌明之气，而属少阴则主乎静。今夫因气逆乱不收为上气为满，相火随之以逆为烦，皆缘心不静，不能御诸气而使之降，又不能使相火听命而定而不动也。梅之实，当君火主令时，安详不扰而育其真，遂以长而成，且至于熟，安于是时者见宜于是时，是以能致心之安，心安则诸气相火咸惟命是听，上气热烦满，均毋敢作矣。虽然，上气肺病也；烦满胃病也。梅非治肺治胃者也。是又何说焉？夫肝属木，木得津润，遂畅茂条达，一身之壅塞皆除，其有不津则气乱为逆，逆于肺则为上气，逆于胃则为烦满，治之以梅，亦直探其源耳。水衰不能养木，内因也；火逼而致津枯，外因也。无间内外,皆可治以梅耶。然则梅能吸人之气以为津，不吸外来之寒湿，故因津枯而为烦为满，则内外因一也。亦又何别？特肾阴虚，不能上济者，不得用此耳。其能治肢体痛何也。是盖宜连下二句读，谓梅能主肢体痛偏枯不仁之死肌也。夫死肌有肢体不痛，不偏枯不仁者，是津气凝滞，不主滑泽肤腠也。则有肢体痛偏枯不仁者，不可知为津气枯肤腠不得滑泽耶。试观古今方书，有用梅治肢体痛偏枯不仁之方否？此无他，肢体痛偏枯不仁，是液枯，死肌则津枯也。夫液所谓谷入气满，淖泽注于骨，骨属屈伸，泄泽补益脑髓，皮肤润泽者；津所谓腠理发泄，汗出溱溱者。梅之为物，能撮气以为津，不能撮谷以为液彰彰可见也。则其治止能吸气化津，通在外之死肌，又何疑焉。且证之以下文青黑痣，与死肌何异，其所在内之肢体痛偏枯不仁，可强使之同耶，即此可以知梅之用矣。\n本经菊花主皮肤死肌，术主风寒湿痹死肌，细辛主风湿痹痛死肌，雄黄主恶疮疽痔死肌,苍耳主周痹四肢拘挛痛恶肉死肌，白癣主湿痹死肌，不可屈伸，厚朴主气血痹死肌，矾石主鼠瘘蚀疮死肌，白芨主痈肿恶疮败疽伤阴死肌，兰茹主蚀恶肉败疮死肌，地胆主鼠瘘恶疮死肌，斑猫主恶疮疽蚀死肌，蜀椒主逐骨节皮肤死肌，麋脂主痈肿恶疮死肌。由是观之，死肌之为物，因于疮痈十之六，因于风寒湿痹十之四，未有无因而致者也。有之，则藜芦之去死肌也。夫痈肿疽疮，血滞也。风寒湿痹，气闭也。藜芦之所去，痰停也。则津枯与三者不如四维之恰相配合耶，然则化为津之物多矣。乃何独取诸梅？盖以渴者言及梅而津溢，化气为津，无有速于此者，且本有津而能致之者，他物或犹能之，若于最浊最涸之余，欲思甘露之滋，舍此诚无可他求矣。且麦门冬地黄，非不生津，然其功也溥，欲令专至一处，而去些微之死肌，不能也。人参黄芪，非不能行气致津，然其力也缓，欲其不助肢体痛而不可，又何能治偏枯不仁之死肌，譬之堪大受者，不得以小知使之。惟梅技有专长，效有偏至，恰于诸木凋残已极之候，独吐气而扬其英焉。是则因梅可以明死肌之故，因死肌可以见梅之用者也。\n仲景用药，多紧贴本经，独于梅似若未尽其功能，而取其治厥治蛔，又非本经所载。殊不知只消渴气上撞心，已该下气，而心中疼热，饥不欲食，又该除热烦满安心矣。何则？梅实生青，半熟红，全熟黄，腌之则白，蒸之则黑，能具五色之全，而青时酸，红时甘酸，黄时甘多于酸，白者咸苦，黑者苦酸，五味又具其四。其所以用乌梅者，岂不以能从肝而媾心肾乎？夫黑而酸，水生木也；酸缘蒸熟而变苦，木生火也。故凡脉微而厥，肤冷，其人躁无暂安时，即非所宜。若病者本静，乃复时烦，须臾复止，得食而呕，又烦，斯为合用。是知厥为阳气不伸，吐蛔为阳气因不伸内烁津气，致蛔无所吸受而上出，故曰蛔闻食臭出。厥非脏寒，（从医宗金鉴）其实仍是气上撞心，心中疼热之现据，其用梅仍是吸水以济火，非有他也。然则谓仲景用梅，但得本经之一节则可，若谓治厥治蛔，非本经之旨，则误矣。扩而充之，后人以之治吐治利，何莫非因仲景乌梅丸推类及之。若夫白梅之蚀恶肉，仍是去死肌青黑痣之旨，黄梅浆之解暑渴，仍是安心除烦满下气之旨，特其变酸为咸苦，则致津之外，自有软坚去硬之功，变酸为甘，则致津之中，更有调变阴阳之效。循是以思，梅之功盖犹未尽乎此，而所以启人元悟，尚是仲景用梅，有以诱之耳。"}]},{"ID":"20240612144913-15vslrs","Type":"NodeParagraph","Properties":{"id":"20240612144913-15vslrs","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草便读》：酸先入肝。肺络脾经均可及。黑能走血。肠红嗽疾久堪医。因其温涩之功。虚痢可疗 汗可敛。假此酸收之品。风痰能化噤能开。蛔厥难安。得酸则伏。恶疮翻凸。捣贴能除。白霜梅。善豁痰涎。梅核膈。宜求含咽。（乌梅则青梅之半黄时用火熏黑者也。味酸性温。专 入肝家血分。脾肺大肠。皆其旁及者也。其功专主收敛止涩。故凡久咳久利。虚汗亡血等证 。皆可用之。能安蛔者。虫得酸则伏也。○白霜梅即青梅。用盐水浸之。日晒夜浸。十日后 。即有霜起乃成矣。味酸咸。性平。入肝达胃。善豁顽痰。治中风喉痹。牙关紧闭等证。以 酸咸之性。咸能润下。酸能涌泄也。开牙噤者。齿得梅则 。肝气以津液上泄之故。然最易伤肾。故多食损齿耳。）"}]},{"ID":"20240612144913-a659dgu","Type":"NodeParagraph","Properties":{"id":"20240612144913-a659dgu","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草撮要》：味酸涩温。入手足厥阴太阴经。功专敛肺固肠。解渴止吐。得建面干姜治休息痢。得 黄莲灶下土等分为末茶调服治血痢。若大便不通。气奔欲死。以乌梅数颗。汤浸去核。丸枣 大。纳入下部。少时即通。疽愈后有肉突起。烧灰存性。研末敷之即平。若痰厥僵仆。牙关紧 闭。取肉揩牙龈。涎出即开。若过食酸梅齿 者。嚼胡桃肉即解。衣生霉点者梅叶煎汤洗之即去。清水揉梅叶洗蕉葛衣。经夏不脆。"}]},{"ID":"20240612144913-etc85mw","Type":"NodeParagraph","Properties":{"id":"20240612144913-etc85mw","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草害利》："}]},{"ID":"20240612144913-6qde5q9","Type":"NodeParagraph","Properties":{"id":"20240612144913-6qde5q9","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"〔害〕病有当发表者，大忌酸收，误食必为害非浅，食梅则津液泄者，水生木也。津液泄则伤肾，肾属水，外为齿，故多食损齿伤筋，蚀脾胃，令人发膈上痰热。"}]},{"ID":"20240612144913-wv9cbef","Type":"NodeParagraph","Properties":{"id":"20240612144913-wv9cbef","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"〔利〕酸涩而温，补肝胆，入肺脾血分，定久嗽，定渴，敛肺之勋，止血痢，涩肠之力。清音去痰涎，安蛔理痰热，消酒毒，蚀恶肉。疽愈后，有肉突起，乌梅烧敷。一日减半，二日而平，真奇方也。肝以酸为泻，而又以本味，为补肝胆猛将。"}]},{"ID":"20240612144913-c28rxps","Type":"NodeParagraph","Properties":{"id":"20240612144913-c28rxps","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"〔修治〕去核微炒，或蒸熟。"}]},{"ID":"20240612144913-dtryluz","Type":"NodeParagraph","Properties":{"id":"20240612144913-dtryluz","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草分经》：酸涩而温，入脾肺血分。涩肠敛肺，止血，生津止渴，安蛔涌痰，解毒。"}]},{"ID":"20240612144913-z9prglt","Type":"NodeParagraph","Properties":{"id":"20240612144913-z9prglt","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草思辨录》：梅花苞于盛冬，梅实成于初夏。得木气之全而味酸，谓为肝药，夫何待言。然非专入肝不兼走他经也。其气平属金，其味酸中有涩，涩为辛酸之变亦属金。实熟则色黄而味带甘，乌梅乃半黄时所熏，则亦入脾胃。濒湖谓舌下有四窍，两窍通胆液，故食梅则津生。不知胆液上潮，口中必苦。观素问味过于酸，肝气以津。可知津生是生于肝不生于胆，津生亦不是肝升。譬之手巾，用热汤浸过，绞之则热气四出，巾已就敛。酸敛之能生津，理亦如是。肝何至升，且得之而复其下行之常矣，夫胆主动主升，肝主静主降。梅实熏黑，味酸而苦，虽是由肝归肾，然能激肝中之津以止渴，不能壮肾中之水以灭火。素问酸苦涌泄为阴。核之于梅，涌即津生之谓；泄则气为之下，热烦满为之除，气下热烦满除而心以安。本经固贴切之至。至止肢体痛、偏枯不仁、死肌。\n邹氏谓古今方书无用梅治肢体痛偏枯不仁之方，宜连下死肌读，为治此等之死肌。窃谓止字疑有误。或即下文去字而复出一字耳。肢体痛偏枯不仁，不过血络凝瘀，虽死肌尚有可为，故与青黑痣并足以去之也。诸家之论，有与愚相反者焉，有可以印证者焉，试胪举之：张隐庵云：其味酸，其气温平而涩，涩附于酸。主下气者。得春生肝木之味，生气上升，则逆气自下。除热烦满者，禀冬令水阴之精，水精上滋，则烦热除而胸膈不满。乌梅无生木气起肾阴之能，上已言之。张氏执是以用乌梅，必有为所误者，其弊在温平酸涩之用，全置不讲，而徒以空谈为超妙也。陈修园拾张之唾余，别无所见。卢子繇则以本经主治，一归之生津，至谓吮肾液以润筋膜。邹氏所见又与卢同，以生津为吸寒水以制火。不知本经之除热，是泄热非制热（叶氏亦云乌梅泄热，见临证指南）。酸苦涌泄之义不明，便无处不窒。其论乌梅丸治蛔厥也，曰吐蛔为阳气烁津，致蛔无所吸受而上出，则梅生津于上，岂是养蛔于上，肾阴虚不能上济者，不得用梅，则蛔本在下，何以有肾阴而不知吸，此既窒滞鲜通矣。又谓蛔厥非脏寒，即气上撞心，心中疼热之现据，不知厥阴病多阴阳错杂。沈尧封云厥阴于卦为震，一阳居二阴之下，病则阳泛于上，阴伏于下，而下寒上热之证作。蛔上入膈，是下寒之据。消渴心中疼热，是上热之据。凡吐蛔气上撞心，皆是厥阴过升之病，治宜下降其逆上之阳。\n乌梅丸，无论黄连乌梅黄柏为苦酸咸纯阴下降之药，即附子直达命门，亦何非下降，可谓精审之至矣。邹氏于厥非脏寒句，自注云从医宗金鉴，不知金鉴于林氏主脏寒之论，仍列于下，并未删驳。又尤在泾解心中疼热，食则吐蛔，统谓之邪热，姑无论于乌梅丸之治不合，即厥阴病之阴阳错杂，亦似有未察者。惟唐容川以西人空气冷热发明厥阴之道，足以上契圣心，下迪学者。空气非愚所知，不具述。其析疼热吐蛔为下寒上热也，曰消渴、气上撞心、心中疼热饥（句），为厥阴包络挟心火之热发动于上；不欲食、食则吐蛔、下之利不止，为厥阴肝气挟寒水之寒相应而起。夫吐蛔一也，知此条非纯热，即知彼条亦非纯寒。乌梅丸所以寒热并进，而非脏寒蛔不上而入膈，尚何疑乎。"}]},{"ID":"20240612144913-9vjfemr","Type":"NodeParagraph","Properties":{"id":"20240612144913-9vjfemr","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《本草择要纲目》："}]},{"ID":"20240612144913-naadh14","Type":"NodeParagraph","Properties":{"id":"20240612144913-naadh14","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【气味】 酸温平涩无毒。入脾肺二经血分。"}]},{"ID":"20240612144913-tm1wu1j","Type":"NodeParagraph","Properties":{"id":"20240612144913-tm1wu1j","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【主治】 止渴调中。去痰治疟。敛肺涩肠。噎膈蛔厥蚀恶肉。仲景治蛔厥乌梅丸及虫方中用者。取虫得酸而即止之之义也。"}]},{"ID":"20240612144913-q4k1wxb","Type":"NodeParagraph","Properties":{"id":"20240612144913-q4k1wxb","updated":"20240612144913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【来源产地】"}]},{"ID":"20240612144913-q6xbly3","Type":"NodeParagraph","Properties":{"id":"20240612144913-q6xbly3","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《雷公炮制药性解》李中梓"}]},{"ID":"20240612144913-kldgzkt","Type":"NodeParagraph","Properties":{"id":"20240612144913-kldgzkt","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"生汉中川谷。五月采，火干。"}]},{"ID":"20240612144913-exjt1tg","Type":"NodeParagraph","Properties":{"id":"20240612144913-exjt1tg","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"此亦是今乌梅也，用之去核，微熬之。伤寒烦热，水渍饮汁。生梅子及白梅亦应相似，今人多用白梅和药，以点痣，蚀恶肉也。服黄精人，云禁食梅实。"}]},{"ID":"20240612144913-v6o6jdr","Type":"NodeParagraph","Properties":{"id":"20240612144913-v6o6jdr","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》"}]},{"ID":"20240612144913-5fu1mrl","Type":"NodeParagraph","Properties":{"id":"20240612144913-5fu1mrl","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"为蔷薇科植物梅的干燥未成熟果实。5月间采摘将成熟的绿色果实（青梅），按大小分开，分别炕焙，火力不宜过大，温度保持在40℃左右。当梅子焙至六成干时，须上下翻动（勿翻破表皮），使其干燥均匀。一般炕焙2～3昼夜，至果肉呈黄褐色起皱皮为度，焙后再焖2～3天，待变成黑色即成。"}]},{"ID":"20240612144913-6phqfup","Type":"NodeParagraph","Properties":{"id":"20240612144913-6phqfup","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"全国各地均有栽培。主产四川、浙江、福建、湖南、贵州。此外，广东、湖北、云南、陕西、安徽、江苏、广西、江西、河南等地亦产。"}]},{"ID":"20240612144913-7phzspr","Type":"NodeParagraph","Properties":{"id":"20240612144913-7phzspr","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"【"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炮制】"}]},{"ID":"20240612144913-guc7kb0","Type":"NodeParagraph","Properties":{"id":"20240612144913-guc7kb0","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》"}]},{"ID":"20240612144913-3zipcup","Type":"NodeParagraph","Properties":{"id":"20240612144913-3zipcup","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"乌梅：拣净杂质，筛去灰屑，洗净，晒干。"}]},{"ID":"20240612144913-xcr8jfc","Type":"NodeParagraph","Properties":{"id":"20240612144913-xcr8jfc","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"乌梅肉：取净乌梅微淋清水湿润，使肉绵软，略晾，敲碎，剥取净肉即成。或置蒸笼内蒸至极烂，放箩内揉擦，去核，取肉，晒干。"}]},{"ID":"20240612144913-wv58o48","Type":"NodeParagraph","Properties":{"id":"20240612144913-wv58o48","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"乌梅炭：取净乌梅用武火炒至皮肉鼓起，出现焦枯斑点为度，喷水焙干，取出放凉。"}]},{"ID":"20240612144913-0l9cfqk","Type":"NodeParagraph","Properties":{"id":"20240612144913-0l9cfqk","updated":"20240612144913"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【现代药理研究】"}]},{"ID":"20240612144913-mj5otpe","Type":"NodeParagraph","Properties":{"id":"20240612144913-mj5otpe","updated":"20240612144913"},"Children":[{"Type":"NodeText","Data":"1.乌梅可刺激唾液腺、胃腺分泌，对胆囊有轻度收缩作用，可促进胆汁分泌，并可改变胆汁酸碱度。乌梅煎剂对离体兔肠有抑制作用，对奥氏括约肌有弛缓作用。\n2.乌梅对蛔虫有兴奋作用和刺激蛔虫后退作用，对其他寄生虫如钩虫、华支睾吸虫也有一定的效果。\n3.乌梅对蛋白质过敏性及组胺性休克具有减低死亡数目的作用，还具有脱敏作用。\n4.乌梅有较广泛的抗菌作用，并有一定的抗真菌作用。\n5.乌梅具有一定的抗肿瘤、抗辐射活性。\n6.乌梅果浆有明显抗氧化溶血和抗肝匀浆脂质过氧化作用，可抗衰老，抗疲劳。\n7.乌梅提取物体外具有抗凝血抗纤溶活性，小鼠免疫特异玫瑰花实验表明，乌梅能增强机体的免疫功能。\n8.乌梅成分苦味酸具有提高肝脏功能作用，苦扁桃甙具有解热、镇痛作用。"}]}]}