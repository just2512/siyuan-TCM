{"ID":"20240506100127-l9boahz","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100127-l9boahz","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100127-l9boahz\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506100127-gn4t52e\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612163051-ha9isi0\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240612163306-ud4su88\u0026quot;,\u0026quot;focusStart\u0026quot;:9,\u0026quot;focusEnd\u0026quot;:9\u0026#125;","title":"263青琅玕","type":"doc","updated":"20240822095728"},"Children":[{"ID":"20240627163614-we6avnp","Type":"NodeParagraph","Properties":{"id":"20240627163614-we6avnp","updated":"20240822095253"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青琅玕"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青琅玕-20240822095250-a0te9vg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627164031-4i85gdd","Type":"NodeParagraph","Properties":{"id":"20240627164031-4i85gdd","updated":"20240822095257"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 800px;","style":"width: 790px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青琅玕1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青琅玕1-20240627164024-x7iecw5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 790px;\" parent-style=\"width: 800px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627163900-av6fzlv","Type":"NodeParagraph","Properties":{"id":"20240627163900-av6fzlv","updated":"20240822095437"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 802px;","style":"width: 792px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿角珊瑚"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿角珊瑚-20240627163900-lid1u8s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 792px;\" parent-style=\"width: 802px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627164052-xa9k6f7","Type":"NodeParagraph","Properties":{"id":"20240627164052-xa9k6f7","updated":"20240822095455"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 804px;","style":"width: 794px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青琅玕2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青琅玕2-20240627164052-ioxysbk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 794px;\" parent-style=\"width: 804px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822095713-uuqikzd","Type":"NodeParagraph","Properties":{"id":"20240822095713-uuqikzd","updated":"20240822095713"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 805px;","style":"width: 795px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿角珊瑚 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿角珊瑚 2-20240822095713-jz5hsq5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 795px;\" parent-style=\"width: 805px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822095600-2zba816","Type":"NodeParagraph","Properties":{"id":"20240822095600-2zba816","updated":"20240822095600"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 805px;","style":"width: 795px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿角珊瑚 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿角珊瑚 1-20240822095600-o3205w9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 795px;\" parent-style=\"width: 805px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822095728-icijexd","Type":"NodeParagraph","Properties":{"id":"20240822095728-icijexd","updated":"20240822095728"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 801px;","style":"width: 791px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿角珊瑚"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿角珊瑚-20240822095425-yy7sqyy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 791px;\" parent-style=\"width: 801px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627164256-q0w4wte","Type":"NodeParagraph","Properties":{"id":"20240627164256-q0w4wte","updated":"20240627164256"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 806px;","style":"width: 796px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青琅玕5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青琅玕5-20240627164256-izcrteo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 796px;\" parent-style=\"width: 806px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612163047-u3bz9h3","Type":"NodeParagraph","Properties":{"id":"20240612163047-u3bz9h3","updated":"20240627164317"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：青琅玕为鹿角珊瑚科动物鹿角珊瑚群体的骨骼及其共肉（软体部分）。（以青者为佳，即青琅玕）"}]},{"ID":"20240612163047-kpvvmpn","Type":"NodeThematicBreak","Properties":{"id":"20240612163047-kpvvmpn"}},{"ID":"20240612163057-boz18e2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163057-boz18e2","updated":"20240612163106"},"Children":[{"Type":"NodeText","Data":"青琅玕《神农本草经》"}]},{"ID":"20240612163057-l9dwa8w","Type":"NodeParagraph","Properties":{"id":"20240612163057-l9dwa8w","updated":"20240612163057"},"Children":[{"Type":"NodeText","Data":"味辛平。"}]},{"ID":"20240612163057-zbzvkvq","Type":"NodeParagraph","Properties":{"id":"20240612163057-zbzvkvq","updated":"20240612163057"},"Children":[{"Type":"NodeText","Data":"主身痒，火创，痈伤，疥搔，死肌。一名石珠。生平泽。"}]},{"ID":"20240612163057-7vd2yhp","Type":"NodeParagraph","Properties":{"id":"20240612163057-7vd2yhp","updated":"20240612163057"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名青珠，生蜀郡，采无时。"}]},{"ID":"20240612163057-m65jwrh","Type":"NodeParagraph","Properties":{"id":"20240612163057-m65jwrh","updated":"20240612163057"},"Children":[{"Type":"NodeText","Data":"案《说文》云：琅玕似珠者，古文作。禹贡云：雍州贡璆琳琅玕.郑云：琅玕珠也。"}]},{"ID":"20240612163057-a6nr37i","Type":"NodeParagraph","Properties":{"id":"20240612163057-a6nr37i","updated":"20240612163057"},"Children":[{"Type":"NodeText","Data":"上玉石，下品九种，旧十二种，粉锡，锡镜鼻为二，戎盐，大盐，卤盐为非，三考当各为一。"}]},{"ID":"20240612163136-eny61po","Type":"NodeThematicBreak","Properties":{"id":"20240612163136-eny61po"}},{"ID":"20240612163138-wuy69dz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163138-wuy69dz","updated":"20240612163148"},"Children":[{"Type":"NodeText","Data":"青琅玕《神农本草经赞》"}]},{"ID":"20240612163138-jxjqsc6","Type":"NodeParagraph","Properties":{"id":"20240612163138-jxjqsc6","updated":"20240612163138"},"Children":[{"Type":"NodeText","Data":"味辛平，主身痒，火创痈伤，疥搔死肌，一名石珠，生平泽。"}]},{"ID":"20240612163138-rn7pwf3","Type":"NodeParagraph","Properties":{"id":"20240612163138-rn7pwf3","updated":"20240612163138"},"Children":[{"Type":"NodeText","Data":"美珍西北，气感阴阳，红浮铁网，青耀昆冈，珠非川媚，玉讶渊藏，献分楚宝，礼重东方。"}]},{"ID":"20240612163138-qo1fqzt","Type":"NodeParagraph","Properties":{"id":"20240612163138-qo1fqzt","updated":"20240612163138"},"Children":[{"Type":"NodeText","Data":"尔雅：西北之美者，有昆仑墟之璆琳琅玕。庚辛玉册：生南海崖石内，自然感阴阳之气而成。苏颂曰：取珊瑚，先作铁网沉水底，贯中而生琅玕，明莹若珠之色，而状森植。列子：珠玕之树丛生。李时珍曰：生于水者为珊瑚，生于山者为琅玕，可碾为珠，故得珠名。陆机赋：水怀珠而川媚。庄子：藏珠于渊。唐书志：楚州献宝玉十三，八曰琅玕珠。周礼：以青珪礼东方。"}]},{"ID":"20240612163226-y5cx6m9","Type":"NodeThematicBreak","Properties":{"id":"20240612163226-y5cx6m9"}},{"ID":"20240612163228-3nzhez4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163228-3nzhez4","updated":"20240612163232"},"Children":[{"Type":"NodeText","Data":"青琅《名医别录》"}]},{"ID":"20240612163228-4quj5nk","Type":"NodeParagraph","Properties":{"id":"20240612163228-4quj5nk","updated":"20240612163228"},"Children":[{"Type":"NodeText","Data":"无毒．主治白秃，侵淫在皮肤中．煮炼服之，起阴气，可化为丹．一名青珠．采无时．（杀锡毒，得水银良，畏乌鸡骨．）"}]},{"ID":"20240612163228-lm4rmyn","Type":"NodeParagraph","Properties":{"id":"20240612163228-lm4rmyn","updated":"20240612163228"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶青琅 ，味辛，平．主身痒，火疮痈伤，疥瘙死肌．一名石珠．生平泽．"}]},{"ID":"20240612163249-5r16bwb","Type":"NodeThematicBreak","Properties":{"id":"20240612163249-5r16bwb"}},{"ID":"20240612163306-ud4su88","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163306-ud4su88","updated":"20240612163407"},"Children":[{"Type":"NodeText","Data":"青琅《本草经集注》"}]},{"ID":"20240612163339-sxqiy0q","Type":"NodeParagraph","Properties":{"id":"20240612163339-sxqiy0q","updated":"20240612163339"},"Children":[{"Type":"NodeText","Data":"味辛，平，无毒。主身痒，火疮，痈伤，白秃，疥瘙，死肌。浸淫在皮肤中。煮炼服之，起阴气，可化为丹。一名石珠，一名青珠。生蜀郡平泽，采无时。"}]},{"ID":"20240612163339-28miwli","Type":"NodeParagraph","Properties":{"id":"20240612163339-28miwli","updated":"20240612163339"},"Children":[{"Type":"NodeText","Data":"杀锡毒，得水银良，畏乌鸡骨。此即《蜀都赋》所称青珠、黄环者也。黄环乃是草，苟取名类，而种族为乖。琅亦是昆山上树名，又《九真经》中太丹名也。此石今亦无用，唯以疗手足逆胪目。化丹之事，未的见其术。"}]},{"ID":"20240612163339-or5uuz5","Type":"NodeParagraph","Properties":{"id":"20240612163339-or5uuz5","updated":"20240612163339"},"Children":[{"Type":"NodeText","Data":"〔谨案〕琅，乃有数种色，是琉璃之类，火齐宝也。且琅五色，其以青者入药为胜，今出州以西乌白蛮中及于阗国也。"}]},{"ID":"20240612163156-2gedtv3","Type":"NodeThematicBreak","Properties":{"id":"20240612163156-2gedtv3"}},{"ID":"20240612163157-mm4kl94","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163157-mm4kl94","updated":"20240612163207"},"Children":[{"Type":"NodeText","Data":"青琅玕《本草纲目》"}]},{"ID":"20240612163157-gocbnon","Type":"NodeParagraph","Properties":{"id":"20240612163157-gocbnon","updated":"20240612163157"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）"}]},{"ID":"20240612163157-xde14un","Type":"NodeParagraph","Properties":{"id":"20240612163157-xde14un","updated":"20240612163157"},"Children":[{"Type":"NodeText","Data":"校正：（并入《拾遗》石阑干）"}]},{"ID":"20240612163157-wvw5rjz","Type":"NodeParagraph","Properties":{"id":"20240612163157-wvw5rjz","updated":"20240612163157"},"Children":[{"Type":"NodeText","Data":"〖释名〗石阑干（《拾遗》）　石珠（《别录》）　青珠（〔时珍曰〕琅玕，象其声也。可碾为珠，故得珠名）"}]},{"ID":"20240612163157-edh4imp","Type":"NodeParagraph","Properties":{"id":"20240612163157-edh4imp","updated":"20240612163157"},"Children":[{"Type":"NodeText","Data":"〖集解〗〔别录曰〕青琅玕生蜀郡平泽，采无时。〔弘景曰〕此《蜀都赋》所称青珠、黄环者也。琅玕亦是昆仑山上树名，又《九真经》中大丹名。〔恭曰〕琅玕有数种色，以青者入药为胜，是琉璃之类，火齐宝也。今出嶲州以西乌白蛮中，及于阗国。〔藏器曰〕石阑干生大海底，高尺余，如树，有根茎，茎上有孔，如物点之。渔人以网罾得之，初从水出微红，后渐青。〔颂曰〕今秘书中有异鱼图，载琅玕青色，生海中。云海人以网于海底取之，初出水红色，久而青黑，枝柯似珊瑚，而上有孔窍，如虫蛀，击之有金石之声，乃与珊瑚相类。其说与《别录》生蜀郡平泽，及苏恭所云不同，人莫能的识。谨按《尚书》：雍州厥贡球、琳、琅玕。《尔雅》云：西北之美者，有昆仑墟之璆、琳、琅玕。孔安国、郭璞注，皆以为石之似珠者。而《山海经》云，昆仑山有琅玕。若然是石之美者，明莹若珠之色，而状森植尔。大抵古人谓石之美者，多谓之珠，《广雅》谓琉璃、珊瑚皆为珠是也。已上所说，皆出西北山中，而今图乃云海底得之。盖珍贵之物，山海或俱产焉，今医家亦以难得而稀用也。〔宗奭曰〕《书》云：雍州厥贡球、琳、琅玕。《西域记》云，天竺国正出此物。苏恭云，是琉璃之类。琉璃乃火成之物，琅玕非火成者，安得同类。〔时珍曰〕按许慎《说文》云：琅玕，石之似玉者。孔安国云：石之似珠者。《总龟》云：生南海石崖间，状如笋，质似玉。《玉册》云：生南海崖石内，自然感阴阳之气而成，似珠而赤。《列子》云：蓬莱之山，珠KT之树丛生。据诸说，则琅玕生于西北山中及海山崖间。其云生于海底网取者，是珊瑚，非琅玕也。在山为琅玕，在水为珊瑚，珊瑚亦有碧色者。今回回地方出一种青珠，与碧靛相似，恐是琅玕所作者也。《山海经》云：开明山北有珠树。《淮南子》云：曾城九重，有珠树在其西。珠树即琅玕也。余见珊瑚下。"}]},{"ID":"20240612163157-gg3zb0w","Type":"NodeParagraph","Properties":{"id":"20240612163157-gg3zb0w","updated":"20240612163157"},"Children":[{"Type":"NodeText","Data":"〖气味〗辛，平，无毒。（〔之才曰〕杀锡毒，得水银良，畏鸡骨）"}]},{"ID":"20240612163157-cipa83l","Type":"NodeParagraph","Properties":{"id":"20240612163157-cipa83l","updated":"20240612163157"},"Children":[{"Type":"NodeText","Data":"〖主治〗身痒，火疮痈疡，疥瘙死肌。（《本经》）白秃，浸淫在皮肤中，煮炼服之，起阴气，可化为丹。（《别录》）疗手足逆胪，弘景。石阑干：主石淋，破血，产后恶血，磨服，或煮服，亦火烧投酒中服。（藏器）"}]},{"ID":"20240612163047-44e7aql","Type":"NodeThematicBreak","Properties":{"id":"20240612163047-44e7aql"}},{"ID":"20240612163049-awb9090","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612163049-awb9090","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"青琅玕"}]},{"ID":"20240612163049-2ld846b","Type":"NodeParagraph","Properties":{"id":"20240612163049-2ld846b","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612163049-ofab7na","Type":"NodeParagraph","Properties":{"id":"20240612163049-ofab7na","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" Qīnɡ Lánɡ Gān"}]},{"ID":"20240612163049-sdk1d35","Type":"NodeParagraph","Properties":{"id":"20240612163049-sdk1d35","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612163049-nm1vh64","Type":"NodeParagraph","Properties":{"id":"20240612163049-nm1vh64","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 石珠、青珠、石栏干"}]},{"ID":"20240612163049-83psrqo","Type":"NodeParagraph","Properties":{"id":"20240612163049-83psrqo","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612163049-ntxgp58","Type":"NodeParagraph","Properties":{"id":"20240612163049-ntxgp58","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 药材基源：为鹿角珊瑚科动物鹿角珊瑚群体的骨骼及其共肉。"}]},{"ID":"20240612163049-30tv1b1","Type":"NodeParagraph","Properties":{"id":"20240612163049-30tv1b1","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Acropora pulchra(Brook)2.Acropora sp."}]},{"ID":"20240612163049-o36qvq9","Type":"NodeParagraph","Properties":{"id":"20240612163049-o36qvq9","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"采收和储藏：用网采收，或用锥子、凿子等工具进行潜水采集，一般采后洗净，晾干，击碎即可。不能用淡水浸泡，以免共肉腐烂脱落。也可根据化学提取要求，用有机溶剂浸泡，或快速冷冻。"}]},{"ID":"20240612163049-zlxyp1e","Type":"NodeParagraph","Properties":{"id":"20240612163049-zlxyp1e","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612163049-k59qx71","Type":"NodeParagraph","Properties":{"id":"20240612163049-k59qx71","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 生态环境：生活时为咖啡色，有时为青绿色；基部为咖啡色。"}]},{"ID":"20240612163049-p78lj2t","Type":"NodeParagraph","Properties":{"id":"20240612163049-p78lj2t","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"鹿色珊瑚是浅水造礁石珊瑚中的主要成员。"}]},{"ID":"20240612163049-kz72iwd","Type":"NodeParagraph","Properties":{"id":"20240612163049-kz72iwd","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"资源分布：我国西沙群岛及海南岛的珊瑚礁平台和向海斜坡上，在水质清洁、底质坚硬及浪小较稳定的环境均有分布。"}]},{"ID":"20240612163049-wnbbnrc","Type":"NodeParagraph","Properties":{"id":"20240612163049-wnbbnrc","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612163049-rjl7fw0","Type":"NodeParagraph","Properties":{"id":"20240612163049-rjl7fw0","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 1.佳丽鹿角珊瑚，珊瑚骨骼树枝状，分枝短粗，由于分枝顶端渐尖，使轴珊瑚体显得更大，为显着特征。轴珊瑚体圆柱形，直径2.5-3mm，少数径2mm，杯孔1.5-2mm，突出2-3mm，第1轮隔片6个发育良好，第2轮发育不全，较狭，壁沟槽状。辐射珊瑚体半管唇状，于分枝基部为唇状突起或少数隐埋，第1轮隔发育不全，2个直接隔片显着较大，其余均为刺状或大小小不等，壁沟槽刺状或刺网状。"}]},{"ID":"20240612163049-0h7963n","Type":"NodeParagraph","Properties":{"id":"20240612163049-0h7963n","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"2.鹿角珊瑚，鹿角珊瑚绝大部分呈分枝状，在分枝或小枝顶端有一个“轴珊瑚体”和众多的“辐射珊瑚体”，其形状大小以及颜色和隔片的轮数为分类的主要特征。该属由于变异太大，是石珊瑚鉴定中最困难的一属，目前分类极为混乱。有些种名暂难统一和确定。"}]},{"ID":"20240612163049-70wc3hl","Type":"NodeParagraph","Properties":{"id":"20240612163049-70wc3hl","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612163049-dap315e","Type":"NodeParagraph","Properties":{"id":"20240612163049-dap315e","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 鹿角珊瑚虽95%以上是碳酸钙，但尚含其他海性成分，如我国南海的期氏鹿角珊瑚Acropora studeri(Brook)的活体中含有24-亚甲基胆甾醇(24-methylenccholosterol)，24-甲基胆甾醇(24-methylcholensterol)及柳珊瑚甾醇(gorgosterol)。佳丽鹿角珊瑚A.pulchra(Brook)含正十六碳醇(n-hexadecanol)，(24S)-24-甲基甾醇，胸腺嘧啶脱氧核核苷，尿嘧啶脱氧核苷，胸腺嘧啶(thymine)及尿嘧啶(uracil)。"}]},{"ID":"20240612163049-u2nkjx6","Type":"NodeParagraph","Properties":{"id":"20240612163049-u2nkjx6","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612163049-ibivpwb","Type":"NodeParagraph","Properties":{"id":"20240612163049-ibivpwb","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 对心血管系统的作用，腹腔注射柳珊瑚甾醇(Gs)对清醒和麻醉大鼠均有明显降压作用，对氯化钾引起的离体主动脉条收缩有拮抗作用，但对离体兔耳血管则有收缩作用；对离体兔心则可减少冠脉流量，减慢心率和抑制心肌收缩力；小鼠腹腔注射Gs，对乌头碱引起的心律失常有明显拮抗作用；对垂体后叶素引起的大鼠心肌缺血也有明显拮抗作用。GS尚可延和小鼠常压耐缺氧的时间。"}]},{"ID":"20240612163049-o97ic9j","Type":"NodeParagraph","Properties":{"id":"20240612163049-o97ic9j","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612163049-e0te034","Type":"NodeParagraph","Properties":{"id":"20240612163049-e0te034","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 味辛；性平"}]},{"ID":"20240612163049-mx3bywt","Type":"NodeParagraph","Properties":{"id":"20240612163049-mx3bywt","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612163049-abc431j","Type":"NodeParagraph","Properties":{"id":"20240612163049-abc431j","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 祛风止痒；解毒行瘀。主皮肤瘙痒；白秃；痈疡；产后瘀血内停；石淋"}]},{"ID":"20240612163049-z51zcpx","Type":"NodeParagraph","Properties":{"id":"20240612163049-z51zcpx","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612163049-hqjr3qa","Type":"NodeParagraph","Properties":{"id":"20240612163049-hqjr3qa","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 内服：研末，0.3-0.6g；或煎汤，15-30g。外用：适量，研末调涂。"}]},{"ID":"20240612163049-hlmlb1q","Type":"NodeParagraph","Properties":{"id":"20240612163049-hlmlb1q","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612163049-n2ltjnv","Type":"NodeParagraph","Properties":{"id":"20240612163049-n2ltjnv","updated":"20240612163049"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612163050-vzxga6u","Type":"NodeThematicBreak","Properties":{"id":"20240612163050-vzxga6u"}},{"ID":"20240612163051-ha9isi0","Type":"NodeParagraph","Properties":{"id":"20240612163051-ha9isi0"}}]}