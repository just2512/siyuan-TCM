{"ID":"20240506100128-mrve1j1","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506100128-mrve1j1","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506100128-mrve1j1\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506100128-tjvqmk7\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612162859-hscgkx6\u0026quot;,\u0026quot;scrollTop\u0026quot;:500,\u0026quot;focusId\u0026quot;:\u0026quot;20240612163016-d58js4q\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"262冬灰（草木灰、葭灰、藜灰）","type":"doc","updated":"20240822095158"},"Children":[{"ID":"20240627163054-emgskhd","Type":"NodeParagraph","Properties":{"id":"20240627163054-emgskhd","updated":"20240822094927"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 469px;","style":"width: 459px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"草木灰"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/草木灰-20240822094920-u4r8tw9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 459px;\" parent-style=\"width: 469px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822095001-jrag3g0","Type":"NodeParagraph","Properties":{"id":"20240822095001-jrag3g0","updated":"20240822095001"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"草木灰 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/草木灰 1-20240822095001-gbm9moe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240627163346-o4fya4w","Type":"NodeParagraph","Properties":{"id":"20240627163346-o4fya4w","updated":"20240822095008"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 649px;","style":"width: 639px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"冬灰"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/冬灰-20240627163346-kf9etuz.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 639px;\" parent-style=\"width: 649px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822095044-v2kagbi","Type":"NodeParagraph","Properties":{"id":"20240822095044-v2kagbi","updated":"20240822095050"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"草木灰 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/草木灰 2-20240822095044-8enn09z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822095158-0um50p9","Type":"NodeParagraph","Properties":{"id":"20240822095158-0um50p9","updated":"20240822095158"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"草木灰 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/草木灰 3-20240822095158-1xqprgn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612162935-epejuq6","Type":"NodeThematicBreak","Properties":{"id":"20240612162935-epejuq6"}},{"ID":"20240612162950-cftunl2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612162950-cftunl2","updated":"20240612162958"},"Children":[{"Type":"NodeText","Data":"冬灰《神农本草经》"}]},{"ID":"20240612162950-s5e1z8w","Type":"NodeParagraph","Properties":{"id":"20240612162950-s5e1z8w","updated":"20240612162950"},"Children":[{"Type":"NodeText","Data":"味辛微温。"}]},{"ID":"20240612162950-fdfn4b1","Type":"NodeParagraph","Properties":{"id":"20240612162950-fdfn4b1","updated":"20240612162950"},"Children":[{"Type":"NodeText","Data":"主黑子，去疣息肉，疽蚀，疥搔。一名藜灰。生川泽。"}]},{"ID":"20240612162950-h64c9oy","Type":"NodeParagraph","Properties":{"id":"20240612162950-h64c9oy","updated":"20240612162950"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生方谷。"}]},{"ID":"20240612162936-nfiwgub","Type":"NodeThematicBreak","Properties":{"id":"20240612162936-nfiwgub"}},{"ID":"20240612162936-nhxbj53","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612162936-nhxbj53","updated":"20240612162940"},"Children":[{"Type":"NodeText","Data":"冬灰《千金翼方》"}]},{"ID":"20240612162936-2d2xc89","Type":"NodeParagraph","Properties":{"id":"20240612162936-2d2xc89","updated":"20240612162936"},"Children":[{"Type":"NodeText","Data":"味辛，微温。主黑子，去疣，息肉，疽蚀，疥瘙。一名藜灰，生玄谷川泽。"}]},{"ID":"20240612163005-niwevsu","Type":"NodeThematicBreak","Properties":{"id":"20240612163005-niwevsu"}},{"ID":"20240612163006-a8tk8qy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163006-a8tk8qy","updated":"20240612163010"},"Children":[{"Type":"NodeText","Data":"冬灰《名医别录》"}]},{"ID":"20240612163006-6k14xb7","Type":"NodeParagraph","Properties":{"id":"20240612163006-6k14xb7","updated":"20240612163006"},"Children":[{"Type":"NodeText","Data":"生方谷．"}]},{"ID":"20240612163006-ti3e587","Type":"NodeParagraph","Properties":{"id":"20240612163006-ti3e587","updated":"20240612163006"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶冬灰，味辛，微温．主黑子，去疣、息肉、疽蚀、疥瘙．一名藜灰．生川泽．"}]},{"ID":"20240612163015-ofvoytl","Type":"NodeThematicBreak","Properties":{"id":"20240612163015-ofvoytl"}},{"ID":"20240612163016-d58js4q","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612163016-d58js4q","updated":"20240612163020"},"Children":[{"Type":"NodeText","Data":"冬灰《本草衍义》"}]},{"ID":"20240612163016-8zge6pi","Type":"NodeParagraph","Properties":{"id":"20240612163016-8zge6pi","updated":"20240612163016"},"Children":[{"Type":"NodeText","Data":"诸家只解灰而不解冬，亦其阙也。诸灰一烘而成，惟冬灰，则经三四月方彻炉。灰既晓夕烧灼，其力得不全燥烈乎？而又体益重。今一 而成者体轻，盖火力劣，故不及冬灰耳。若古紧面少容方中，用九烧益母灰，盖取此义。如或诸方中用桑灰，自合依本法。既用冬灰，则须尔。《唐本》注云∶冬灰本是藜灰，未知别有何说。又汤火灼，以饼炉中灰细罗，脂麻油调，羽扫，不得着水，仍避风。"}]},{"ID":"20240612162813-l3e26ev","Type":"NodeThematicBreak","Properties":{"id":"20240612162813-l3e26ev"}},{"ID":"20240612162826-vayzmfl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612162826-vayzmfl","updated":"20240612162830"},"Children":[{"Type":"NodeText","Data":"冬灰《医学入门》"}]},{"ID":"20240612162826-seqgfxz","Type":"NodeParagraph","Properties":{"id":"20240612162826-seqgfxz","updated":"20240612162826"},"Children":[{"Type":"NodeText","Data":"即浣衣黄灰。烧诸蒿藜积聚炼作之，今用灰多杂薪，蒸乃不善。《衍义》云∶诸灰一烘而成，惟冬灰则经三四月方彻，炉灰晓夕烧灼，其力燥烈而体重，今一 而成者，体轻力劣，故不及冬灰。味辛，微温。"}]},{"ID":"20240612162826-176ca7k","Type":"NodeParagraph","Properties":{"id":"20240612162826-176ca7k","updated":"20240612162826"},"Children":[{"Type":"NodeText","Data":"和锻石熬煎，以点 肉，疽蚀疥瘙。去黑子疣赘，不可广用，烂人皮肉。桑柴灰，入药绝奇。一方取鳖一个，治如食法，以桑灰汁煎如泥，和诸 瘕药重煎堪丸，众手丸如梧子大，日服十五丸， 瘕 癖无不愈者。或单淋汁服之，亦去风血 一块、水肿。锻铁炉中灰，兼得铁力，故主 瘕坚积有效。灶中热灰，和醋熨心腹冷气痛及血气绞痛，冷即易。"}]},{"ID":"20240612162813-xxfbip7","Type":"NodeThematicBreak","Properties":{"id":"20240612162813-xxfbip7"}},{"ID":"20240612162814-u7kp13r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612162814-u7kp13r","updated":"20240612162821"},"Children":[{"Type":"NodeText","Data":"冬灰《证类本草》"}]},{"ID":"20240612162814-2bybgep","Type":"NodeParagraph","Properties":{"id":"20240612162814-2bybgep","updated":"20240612162814"},"Children":[{"Type":"NodeText","Data":"味辛，微温。主黑子，去疣（音尤）息肉，疽蚀疥瘙。一名藜灰。生方谷川泽。"}]},{"ID":"20240612162814-1b0xjl7","Type":"NodeParagraph","Properties":{"id":"20240612162814-1b0xjl7","updated":"20240612162814"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此即今浣衣黄灰尔，烧诸蒿、藜，积聚炼作之，性亦烈，又荻灰尤烈。欲销黑志、疣赘，取此三种灰和水蒸以点之即去，不可广用，烂人皮肉。唐本注云∶桑薪灰，最入药用，疗黑子、疣赘，功胜冬灰。用煮小豆，大下水肿。然冬灰本是藜灰，余草不真。又有青蒿灰，烧蒿作之。柃灰，烧木叶作。并入染用，亦堪蚀恶肉。柃灰一作苓字。臣禹锡等谨按陈藏器云∶桑灰，本功外，去风血症瘕块。又主水阴淋，取酽汁作食，服三、五升。又取鳖一头，治如食法，以桑灰汁煎如泥，和诸症瘕药重煎，堪丸，众手捻成。日服十五丸，症瘕癖无不瘥者。其方文多，不具载。"}]},{"ID":"20240612162814-731urk4","Type":"NodeParagraph","Properties":{"id":"20240612162814-731urk4","updated":"20240612162814"},"Children":[{"Type":"NodeText","Data":"图经文具锻石条下。"}]},{"ID":"20240612162814-slj0d7r","Type":"NodeParagraph","Properties":{"id":"20240612162814-slj0d7r","updated":"20240612162814"},"Children":[{"Type":"NodeText","Data":"衍义曰∶冬灰，诸家只解灰而不解冬，亦其缺也。诸灰一烘而成，唯冬灰，则经三、四月方彻炉。灰既晓夕晓灼，其力得不全燥烈乎？而又体益重。今一 而成者体轻，盖火力劣，故不及冬灰耳。若古紧面少容方中，用九烧益母灰，盖取此义。如或诸方中用桑灰，自合根据本法。既用冬灰，则须尔。《唐本》注云∶冬灰本是藜灰，未知别有何说。又汤火灼，以饼炉中灰细罗，脂麻油调，羽扫，不得着水，仍避风。"}]},{"ID":"20240612162815-9pxykff","Type":"NodeThematicBreak","Properties":{"id":"20240612162815-9pxykff"}},{"ID":"20240612162856-svuybt6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612162856-svuybt6","updated":"20240612162902"},"Children":[{"Type":"NodeText","Data":"冬灰《新修本草》"}]},{"ID":"20240612162856-q2a6q3c","Type":"NodeParagraph","Properties":{"id":"20240612162856-q2a6q3c","updated":"20240612162856"},"Children":[{"Type":"NodeText","Data":"味辛，微温。主黑子、云疣、息肉、疽蚀，疥瘙。一名藜灰。生方谷川泽。"}]},{"ID":"20240612162856-y2bf441","Type":"NodeParagraph","Properties":{"id":"20240612162856-y2bf441","updated":"20240612162856"},"Children":[{"Type":"NodeText","Data":"此即今浣衣黄灰耳，烧诸蒿藜积聚炼作之，性烈，又荻灰尤烈。欲消黑痣疣赘，取此三种灰水和蒸以点之即去，不可广用，烂人皮肉。"}]},{"ID":"20240612162856-7bg7960","Type":"NodeParagraph","Properties":{"id":"20240612162856-7bg7960","updated":"20240612162922"},"Children":[{"Type":"NodeText","Data":"〔谨案〕桑薪灰，最入药用，疗黑子疣赘功胜冬灰。用煮小豆，大下水肿。然冬灰本是藜灰，余草不真。又有青蒿灰，烧蒿作之。柃灰，烧木叶作，并入染用，亦堪蚀恶肉。"}]},{"ID":"20240612162858-3segwpg","Type":"NodeThematicBreak","Properties":{"id":"20240612162858-3segwpg"}},{"ID":"20240612162859-hscgkx6","Type":"NodeParagraph","Properties":{"id":"20240612162859-hscgkx6"}}]}