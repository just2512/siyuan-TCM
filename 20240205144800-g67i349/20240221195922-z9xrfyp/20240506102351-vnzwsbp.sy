"Properties":{"parent-style":"width: 425px;","style":"width: 415px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿藿 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿藿 6-20240826095227-jl1mlpc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 415px;\" parent-style=\"width: 425px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826095706-7ehme37","Type":"NodeParagraph","Properties":{"id":"20240826095706-7ehme37","updated":"20240826095706"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 710px;","style":"width: 700px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿藿6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿藿6-20240701170218-eg1dac2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 700px;\" parent-style=\"width: 710px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 593px;","style":"width: 583px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹿藿 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹿藿 2-20240826094642-tkdk599.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 583px;\" parent-style=\"width: 593px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240613112746-p7t6xul","Type":"NodeThematicBreak","Properties":{"id":"20240613112746-p7t6xul"}},{"ID":"20240613112748-1emtfd0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112748-1emtfd0","updated":"20240613112752"},"Children":[{"Type":"NodeText","Data":"鹿藿《神农本草经》"}]},{"ID":"20240613112748-hal9xs9","Type":"NodeParagraph","Properties":{"id":"20240613112748-hal9xs9","updated":"20240613112748"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240613112748-pl4hkcz","Type":"NodeParagraph","Properties":{"id":"20240613112748-pl4hkcz","updated":"20240613112748"},"Children":[{"Type":"NodeText","Data":"主蛊毒，女子腰腹痛，不乐肠痈，瘰疠（《御览》作历），疡气。生山谷。"}]},{"ID":"20240613112748-40yfyn8","Type":"NodeParagraph","Properties":{"id":"20240613112748-40yfyn8","updated":"20240613112748"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生汶山。"}]},{"ID":"20240613112748-0wo76tf","Type":"NodeParagraph","Properties":{"id":"20240613112748-0wo76tf","updated":"20240613112748"},"Children":[{"Type":"NodeText","Data":"案《说文》云：藨，鹿藿也，读若剽。《广雅》云：藨，鹿藿也。《尔雅》云：蔨，鹿藿，其实。郭璞云：今鹿豆也，叶似大豆，根黄而香，蔓延生。"}]},{"ID":"20240613112809-xnr1sxl","Type":"NodeThematicBreak","Properties":{"id":"20240613112809-xnr1sxl"}},{"ID":"20240613112810-m12iqi6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112810-m12iqi6","updated":"20240613112814"},"Children":[{"Type":"NodeText","Data":"鹿藿《神农本草经赞》"}]},{"ID":"20240613112810-h0lu2ae","Type":"NodeParagraph","Properties":{"id":"20240613112810-h0lu2ae","updated":"20240613112810"},"Children":[{"Type":"NodeText","Data":"味苦平。主蛊毒。女子腰腹痛不乐。肠痈瘰疡气。生山谷。"}]},{"ID":"20240613112810-yo6098x","Type":"NodeParagraph","Properties":{"id":"20240613112810-yo6098x","updated":"20240613112810"},"Children":[{"Type":"NodeText","Data":"溷生麦陇。名共葛苗。蔓纷淮豌。荚缬蜀椒。黄香气润。粉紫风飘。喜招鹿饲。漫具烹调。"}]},{"ID":"20240613112810-hnb0uh1","Type":"NodeParagraph","Properties":{"id":"20240613112810-hnb0uh1","updated":"20240613112810"},"Children":[{"Type":"NodeText","Data":"（豌音剜）陶弘景曰。葛苗一名鹿藿。苏恭曰。苗似豌豆。而引蔓长。农书。豌豆大者。名淮豆。"}]},{"ID":"20240613112810-2kgfphu","Type":"NodeParagraph","Properties":{"id":"20240613112810-2kgfphu","updated":"20240613112810"},"Children":[{"Type":"NodeText","Data":"尔雅注。叶似大豆。蔓延生根黄而香。李时珍曰。多生麦地。三月开淡粉紫花。结小荚。其子大如椒子黑色。生熟皆可食。豆叶曰藿。鹿喜食之故名。陆游诗。豉香盐白自烹调。"}]},{"ID":"20240613112758-3ava6cw","Type":"NodeThematicBreak","Properties":{"id":"20240613112758-3ava6cw"}},{"ID":"20240613112759-a7j9njb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112759-a7j9njb","updated":"20240613112804"},"Children":[{"Type":"NodeText","Data":"鹿藿《新修本草》"}]},{"ID":"20240613112759-i1b6my1","Type":"NodeParagraph","Properties":{"id":"20240613112759-i1b6my1","updated":"20240613112759"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主蛊毒，女子腰腹痛不乐，肠痈，瘰 ，疡气。生汶山山谷。"}]},{"ID":"20240613112759-ecvvegk","Type":"NodeParagraph","Properties":{"id":"20240613112759-ecvvegk","updated":"20240613112759"},"Children":[{"Type":"NodeText","Data":"药方不复用，人亦罕识。葛根之苗，又一名鹿藿。"}]},{"ID":"20240613112759-tkuu6dy","Type":"NodeParagraph","Properties":{"id":"20240613112759-tkuu6dy","updated":"20240613112759"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草，所在有之，苗似豌豆，有蔓而长大，人取以为菜，亦微有豆气，名为鹿豆也。"}]},{"ID":"20240613112604-12uh2an","Type":"NodeThematicBreak","Properties":{"id":"20240613112604-12uh2an"}},{"ID":"20240613112722-b24e276","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112722-b24e276","updated":"20240613112727"},"Children":[{"Type":"NodeText","Data":"鹿藿《医学入门》"}]},{"ID":"20240613112722-cpicvxj","Type":"NodeParagraph","Properties":{"id":"20240613112722-cpicvxj","updated":"20240613112722"},"Children":[{"Type":"NodeText","Data":"苗似宛豆，有蔓而差大，根黄而香，人取以为菜，微有豆气，山人谓之鹿豆，亦堪生啖。味苦，平，无毒。主肠痈、瘰 、疮疡，杀蛊毒，止头痛及女子腰腹痛不乐。五六月采苗，日干。"}]},{"ID":"20240613112820-es1e6rb","Type":"NodeThematicBreak","Properties":{"id":"20240613112820-es1e6rb"}},{"ID":"20240613112822-36yoaio","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112822-36yoaio","updated":"20240613112826"},"Children":[{"Type":"NodeText","Data":"鹿藿《名医别录》"}]},{"ID":"20240613112822-aku93hb","Type":"NodeParagraph","Properties":{"id":"20240613112822-aku93hb","updated":"20240613112822"},"Children":[{"Type":"NodeText","Data":"无毒．生汶山．"}]},{"ID":"20240613112822-rcfkx93","Type":"NodeParagraph","Properties":{"id":"20240613112822-rcfkx93","updated":"20240613112822"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶鹿藿，味苦，平．主蛊毒，女子腰腹痛不乐，肠痈瘰 疡气．生山谷．"}]},{"ID":"20240613112604-mnjkw3o","Type":"NodeThematicBreak","Properties":{"id":"20240613112604-mnjkw3o"}},{"ID":"20240613112652-le3itka","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112652-le3itka","updated":"20240613112701"},"Children":[{"Type":"NodeText","Data":"鹿藿《千金翼方》"}]},{"ID":"20240613112652-imxfo5y","Type":"NodeParagraph","Properties":{"id":"20240613112652-imxfo5y","updated":"20240613112715"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主蛊毒，女子腰腹痛，不乐，肠痈，瘰 ，疡气。生汶山山谷。"}]},{"ID":"20240613112604-ji7bbs2","Type":"NodeThematicBreak","Properties":{"id":"20240613112604-ji7bbs2"}},{"ID":"20240613112645-heug34p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112645-heug34p","updated":"20240613112648"},"Children":[{"Type":"NodeText","Data":"鹿藿《本草纲目》"}]},{"ID":"20240613112645-tth9ucc","Type":"NodeParagraph","Properties":{"id":"20240613112645-tth9ucc","updated":"20240613112645"},"Children":[{"Type":"NodeText","Data":"「释名」鹿豆、劳豆、野绿豆。"}]},{"ID":"20240613112645-unbcndi","Type":"NodeParagraph","Properties":{"id":"20240613112645-unbcndi","updated":"20240613112645"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、无毒。"}]},{"ID":"20240613112645-mfxlowg","Type":"NodeParagraph","Properties":{"id":"20240613112645-mfxlowg","updated":"20240613112645"},"Children":[{"Type":"NodeText","Data":"「主治」肠痈、瘰疬。"}]},{"ID":"20240613112847-rfa2ara","Type":"NodeThematicBreak","Properties":{"id":"20240613112847-rfa2ara"}},{"ID":"20240613112848-idlbdyi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112848-idlbdyi","updated":"20240613112904"},"Children":[{"Type":"NodeText","Data":"鹿藿《证类本草》"}]},{"ID":"20240613112848-l4qdfpz","Type":"NodeParagraph","Properties":{"id":"20240613112848-l4qdfpz","updated":"20240613112851"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主蛊毒，女子腰腹痛，不乐，肠痈，瘰 ，疡气。生汶山谷。"}]},{"ID":"20240613112848-yyxm2ys","Type":"NodeParagraph","Properties":{"id":"20240613112848-yyxm2ys","updated":"20240617115405"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶方药不复用。人亦罕识，葛根之苗，又一名鹿藿。唐本注云∶此草所在有之，苗∶山人谓之鹿豆，亦堪生啖。今所在有。五月、六月采苗，晒干之。尔雅云∶ ，鹿藿。其实。释曰∶ ，一名鹿藿。其实名 。郭云∶鹿豆也。叶似大豆，根黄而香，蔓延生。"}]},{"ID":"20240613112848-nzspg23","Type":"NodeParagraph","Properties":{"id":"20240613112848-nzspg23","updated":"20240613112855"},"Children":[{"Type":"NodeText","Data":"梁简文帝劝医文鹿藿，止救头痛之 。"}]},{"ID":"20240613112604-l22ztmh","Type":"NodeThematicBreak","Properties":{"id":"20240613112604-l22ztmh"}},{"ID":"20240613112628-kjiw16f","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112628-kjiw16f","updated":"20240613112640"},"Children":[{"Type":"NodeText","Data":"鹿藿《本草经集注》"}]},{"ID":"20240613112628-3h0v7js","Type":"NodeParagraph","Properties":{"id":"20240613112628-3h0v7js","updated":"20240613112628"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主治蛊毒，女子腰腹痛，不乐，肠痈，瘰 ，疡气。生汶山山谷。"}]},{"ID":"20240613112628-u9ak6oo","Type":"NodeParagraph","Properties":{"id":"20240613112628-u9ak6oo","updated":"20240613112628"},"Children":[{"Type":"NodeText","Data":"方药不复用，人亦罕识。葛根之苗，又一名鹿藿。"}]},{"ID":"20240613112605-okdq0xd","Type":"NodeThematicBreak","Properties":{"id":"20240613112605-okdq0xd"}},{"ID":"20240613112606-mdnhi6o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112606-mdnhi6o","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：鹿藿"}]},{"ID":"20240613112606-8lh5xqs","Type":"NodeParagraph","Properties":{"id":"20240613112606-8lh5xqs","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613112606-muaxjal","Type":"NodeParagraph","Properties":{"id":"20240613112606-muaxjal","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" Lù Huò"}]},{"ID":"20240613112606-sf83s92","Type":"NodeParagraph","Properties":{"id":"20240613112606-sf83s92","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613112606-hcr24ym","Type":"NodeParagraph","Properties":{"id":"20240613112606-hcr24ym","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 老鼠眼、饿蚂蝗[湖南]、痰切豆"}]},{"ID":"20240613112606-if71keo","Type":"NodeParagraph","Properties":{"id":"20240613112606-if71keo","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613112606-iubdbhy","Type":"NodeParagraph","Properties":{"id":"20240613112606-iubdbhy","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 豆科鹿藿属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鹿藿"},{"Type":"NodeText","Data":"Rhynchosia volubilis Lour.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"及"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。夏秋采收，洗净切片，晒干。"}]},{"ID":"20240613112606-vcwdw74","Type":"NodeParagraph","Properties":{"id":"20240613112606-vcwdw74","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613112606-g7flmku","Type":"NodeParagraph","Properties":{"id":"20240613112606-g7flmku","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 苦、辛，平。"}]},{"ID":"20240613112606-038k2vj","Type":"NodeParagraph","Properties":{"id":"20240613112606-038k2vj","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613112606-4kfvouj","Type":"NodeParagraph","Properties":{"id":"20240613112606-4kfvouj","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 消积散结，消肿止痛，舒筋活络。用于小儿疳积，牙痛，神经性头痛，颈淋巴结结核，风湿关节炎，腰肌劳损；外用治痈疖肿毒，蛇咬伤。"}]},{"ID":"20240613112606-w5n2o2i","Type":"NodeParagraph","Properties":{"id":"20240613112606-w5n2o2i","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613112606-bo83s6b","Type":"NodeParagraph","Properties":{"id":"20240613112606-bo83s6b","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 0.5～1两；外用适量，鲜草或鲜根捣烂敷患处。"}]},{"ID":"20240613112606-cn9fnke","Type":"NodeParagraph","Properties":{"id":"20240613112606-cn9fnke","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613112606-qnidsdh","Type":"NodeParagraph","Properties":{"id":"20240613112606-qnidsdh","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613112606-lfz4gh4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112606-lfz4gh4","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：鹿藿"}]},{"ID":"20240613112606-ly0y0eb","Type":"NodeParagraph","Properties":{"id":"20240613112606-ly0y0eb","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613112606-ftlgff1","Type":"NodeParagraph","Properties":{"id":"20240613112606-ftlgff1","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" Lù Huò"}]},{"ID":"20240613112606-p83wi31","Type":"NodeParagraph","Properties":{"id":"20240613112606-p83wi31","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613112606-qstydz4","Type":"NodeParagraph","Properties":{"id":"20240613112606-qstydz4","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 鹿豆（《尔雅》郭璞注），荳豆、野绿豆（《纲目》），野黄豆（《中国主要植物图说·豆科》），老鼠眼（《广州植物志》），老鼠豆、野毛豆、门瘦、酒壶藤（《湖南药物志》），鸟眼睛豆、大叶野绿豆（《浙江天日山药植志》）。"}]},{"ID":"20240613112606-mst9na5","Type":"NodeParagraph","Properties":{"id":"20240613112606-mst9na5","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613112606-ncafxac","Type":"NodeParagraph","Properties":{"id":"20240613112606-ncafxac","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613112606-3xomi5s","Type":"NodeParagraph","Properties":{"id":"20240613112606-3xomi5s","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613112606-zmd492s","Type":"NodeParagraph","Properties":{"id":"20240613112606-zmd492s","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 为豆科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鹿藿"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"茎叶"},{"Type":"NodeText","Data":"。5～6月采，晒干。贮干燥处。"}]},{"ID":"20240613112606-nq5l9j3","Type":"NodeParagraph","Properties":{"id":"20240613112606-nq5l9j3","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613112606-5mbnnvh","Type":"NodeParagraph","Properties":{"id":"20240613112606-5mbnnvh","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 生长杂草中或附攀树上。分布四川、浙江、江西、江苏、安徽、广西、福建、台湾、湖南、湖北等地。"}]},{"ID":"20240613112606-i0e33er","Type":"NodeParagraph","Properties":{"id":"20240613112606-i0e33er","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613112606-vppnki5","Type":"NodeParagraph","Properties":{"id":"20240613112606-vppnki5","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 多年生缠绕草本，各部密被淡黄色柔毛。茎蔓长。3出羽状复；侧生小叶斜阔卵形，或斜阔椭圆形，长2～6厘米，阔1.5～4.5厘米，先端短急尖，基部圆形：顶生小叶近于圆形，长2.5～6厘米，阔2.5～6.5厘米，先端急尖或短渐尖；小叶纸质，上面疏被短柔毛，下面密被长柔毛和淡黄色透明腺点；托叶线状披针形，不脱落。总状花序腋生，有花10余朵；花黄色，长7毫米；花萼钟状，5裂；花冠蝶形，龙骨瓣有长喙；雄蕊10，2体，花药1室；子房上位，胚珠2，花柱长，基部弯曲被毛，柱头头状。荚果短矩形，红紫色，长约1.5厘米，阔约9毫米；有1～2颗黑色有光泽的种子。花期5～9月。"}]},{"ID":"20240613112606-jnx347h","Type":"NodeParagraph","Properties":{"id":"20240613112606-jnx347h","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613112606-8v2jntb","Type":"NodeParagraph","Properties":{"id":"20240613112606-8v2jntb","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 《本草经疏》：\"入足阳明、太阴、厥阴经。\""}]},{"ID":"20240613112606-cdec3an","Type":"NodeParagraph","Properties":{"id":"20240613112606-cdec3an","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613112606-ixdqs0x","Type":"NodeParagraph","Properties":{"id":"20240613112606-ixdqs0x","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味苦，平。\""}]},{"ID":"20240613112606-q1ylinf","Type":"NodeParagraph","Properties":{"id":"20240613112606-q1ylinf","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\";"}]},{"ID":"20240613112606-nbh8gso","Type":"NodeParagraph","Properties":{"id":"20240613112606-nbh8gso","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613112606-bzny2v1","Type":"NodeParagraph","Properties":{"id":"20240613112606-bzny2v1","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 凉血，解毒。治头痛，腰疼腹痛，产褥热，瘰疬，痈肿，流注。"}]},{"ID":"20240613112606-gg9xtt1","Type":"NodeParagraph","Properties":{"id":"20240613112606-gg9xtt1","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主女子腰腹痛不乐，肠痈，瘰疬，疡气。\""}]},{"ID":"20240613112606-vj22eik","Type":"NodeParagraph","Properties":{"id":"20240613112606-vj22eik","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"②江西《草药手册》：\"祛痰，解毒，杀虫，祛风湿，和血气。治肠痈，瘰疬，头痛，眼痛，腹痛。\""}]},{"ID":"20240613112606-n8fhjxm","Type":"NodeParagraph","Properties":{"id":"20240613112606-n8fhjxm","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613112606-geuaj8n","Type":"NodeParagraph","Properties":{"id":"20240613112606-geuaj8n","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 内服：放汤，3～5钱，外用：捣敷。"}]},{"ID":"20240613112606-08tm5mg","Type":"NodeParagraph","Properties":{"id":"20240613112606-08tm5mg","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613112606-ujj399j","Type":"NodeParagraph","Properties":{"id":"20240613112606-ujj399j","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" ①治惯发性头痛：鲜鹿藿七钱，水煎服。"}]},{"ID":"20240613112606-1dzlp0d","Type":"NodeParagraph","Properties":{"id":"20240613112606-1dzlp0d","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"②治妇女产褥热：鹿藿茎叶三至五钱，水煎服。"}]},{"ID":"20240613112606-bx9iw0q","Type":"NodeParagraph","Properties":{"id":"20240613112606-bx9iw0q","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"③治瘰疬：鹿藿五钱，豆腐适量，加水同煮服。"}]},{"ID":"20240613112606-5t3soen","Type":"NodeParagraph","Properties":{"id":"20240613112606-5t3soen","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"④治流注，痈肿：鲜鹿藿叶适量。捣烂，酌加烧酒捣匀。外敷。（选方出江西《草药手册》）"}]},{"ID":"20240613112606-4p1w68b","Type":"NodeParagraph","Properties":{"id":"20240613112606-4p1w68b","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613112606-sxqi8ae","Type":"NodeParagraph","Properties":{"id":"20240613112606-sxqi8ae","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 《本草经疏》：\"鹿藿，解毒凉血之药也。故主肠痈瘰疬疡气。女人以血为主，血虚有热，则腰腹痛不乐，得苦凉之气，则热退而血得所养，故主女人腰腹痛不乐也。\""}]},{"ID":"20240613112606-79h4q0w","Type":"NodeParagraph","Properties":{"id":"20240613112606-79h4q0w","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613112606-xe1jf5k","Type":"NodeParagraph","Properties":{"id":"20240613112606-xe1jf5k","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613112606-3wfy8mi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112606-3wfy8mi","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"《中华本草》：鹿藿"}]},{"ID":"20240613112606-gz4u75m","Type":"NodeParagraph","Properties":{"id":"20240613112606-gz4u75m","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613112606-sgpcup5","Type":"NodeParagraph","Properties":{"id":"20240613112606-sgpcup5","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" Lù Huò"}]},{"ID":"20240613112606-zz0nm7d","Type":"NodeParagraph","Properties":{"id":"20240613112606-zz0nm7d","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613112606-ckt09yg","Type":"NodeParagraph","Properties":{"id":"20240613112606-ckt09yg","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 蔨、鹿豆、荳豆、野绿豆、野黄豆、老鼠眼、老鼠豆、野毛豆、门瘦、酒壶藤、乌眼睛豆、大叶野绿豆、鬼豆根、藤黄豆、乌睛珠、光眼铃铃藤、山黑豆、鬼眼睛、一条根。"}]},{"ID":"20240613112606-qm48yva","Type":"NodeParagraph","Properties":{"id":"20240613112606-qm48yva","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613112606-f4y2dov","Type":"NodeParagraph","Properties":{"id":"20240613112606-f4y2dov","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" Herb of Twining Rhynchosia"}]},{"ID":"20240613112606-chw3fst","Type":"NodeParagraph","Properties":{"id":"20240613112606-chw3fst","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613112606-ebhsalc","Type":"NodeParagraph","Properties":{"id":"20240613112606-ebhsalc","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613112606-9zcf25d","Type":"NodeParagraph","Properties":{"id":"20240613112606-9zcf25d","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"1.《唐本草》：鹿藿，所在有之，苗似豌豆，有蔓而长大，人取以为菜，亦微有豆气，故为鹿豆也。"}]},{"ID":"20240613112606-fuep7ba","Type":"NodeParagraph","Properties":{"id":"20240613112606-fuep7ba","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：鹿豆即野绿豆，多生麦地田野中，苗叶似绿豆而小，引蔓生，生熟皆可食。三月开淡粉紫花，结小荚，其子大如椒子，黑色，可煮食，或磨面作饼蒸食。"}]},{"ID":"20240613112606-8yqhdw7","Type":"NodeParagraph","Properties":{"id":"20240613112606-8yqhdw7","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613112606-4bkj30h","Type":"NodeParagraph","Properties":{"id":"20240613112606-4bkj30h","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 药材基源：为豆科植物鹿藿的茎叶。"}]},{"ID":"20240613112606-krt4bjy","Type":"NodeParagraph","Properties":{"id":"20240613112606-krt4bjy","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Rhynchosia volubilis Lour."}]},{"ID":"20240613112606-49b19os","Type":"NodeParagraph","Properties":{"id":"20240613112606-49b19os","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"采收和储藏：5-6月采收，鲜用或晒干，贮干燥处。"}]},{"ID":"20240613112606-xpvqmdq","Type":"NodeParagraph","Properties":{"id":"20240613112606-xpvqmdq","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613112606-927pw53","Type":"NodeParagraph","Properties":{"id":"20240613112606-927pw53","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔400-1200m的山坡杂草中或附攀树上。"}]},{"ID":"20240613112606-npfah2t","Type":"NodeParagraph","Properties":{"id":"20240613112606-npfah2t","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于江苏、安徽、浙江、江西、福建、台湾、湖北、湖南、广东、广西、四川、贵州等地。"}]},{"ID":"20240613112606-mhurkqa","Type":"NodeParagraph","Properties":{"id":"20240613112606-mhurkqa","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613112606-dosmqyz","Type":"NodeParagraph","Properties":{"id":"20240613112606-dosmqyz","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 鹿藿 多年生缠绕草本。各部密被淡黄色柔毛。茎蔓长。3出复叶，顶生小叶近于圆形，长2.5-6cm，宽2.5-5.5cm，先端急尖或短渐尖；侧生小叶斜阔卵形，或斜阔椭圆形，长2-6cm，宽1.5-2.5cm，先端急尖，基部圆形；叶片纸质，上面疏被短柔毛，背面密被长柔毛和橘黄色透明腺点；托叶线状披针形，不脱落。"}]},{"ID":"20240613112606-p4ml3zq","Type":"NodeParagraph","Properties":{"id":"20240613112606-p4ml3zq","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"总状花序腋生，花10余朵；长约7mm；花萼钟状，5裂；花冠黄色，龙骨瓣有长喙；雄蕊10，二体，花药1室；子房上位，胚珠2，花柱长，基部弯曲，被毛，柱头头状。荚果短，长圆形，红紫色，长约1.5cm，阔约9mm；种子1-2粒，黑色，有光泽。花期5-9月，果期7-10月。"}]},{"ID":"20240613112606-oavno07","Type":"NodeParagraph","Properties":{"id":"20240613112606-oavno07","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613112606-sqbfkic","Type":"NodeParagraph","Properties":{"id":"20240613112606-sqbfkic","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 胃；脾；肝经"}]},{"ID":"20240613112606-nw9w6ub","Type":"NodeParagraph","Properties":{"id":"20240613112606-nw9w6ub","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613112606-wkmfvx7","Type":"NodeParagraph","Properties":{"id":"20240613112606-wkmfvx7","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 味苦；酸；性平"}]},{"ID":"20240613112606-oi884w5","Type":"NodeParagraph","Properties":{"id":"20240613112606-oi884w5","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613112606-19ngdq8","Type":"NodeParagraph","Properties":{"id":"20240613112606-19ngdq8","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 祛风除湿；活血；解毒。主风湿痹痛；头痛；牙痛；腰脊疼痛；瘀血腹痛；产褥热；瘰疬；痈肿疮毒；跌打损伤；烫火伤"}]},{"ID":"20240613112606-t16ulcs","Type":"NodeParagraph","Properties":{"id":"20240613112606-t16ulcs","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613112606-iil1wy3","Type":"NodeParagraph","Properties":{"id":"20240613112606-iil1wy3","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-30g。外用：适量，捣敷。"}]},{"ID":"20240613112606-iwduex8","Type":"NodeParagraph","Properties":{"id":"20240613112606-iwduex8","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613112606-m1b2x0h","Type":"NodeParagraph","Properties":{"id":"20240613112606-m1b2x0h","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" ①治惯发性头痛：鲜鹿藿七钱，水煎服。②治妇女产褥热：鹿藿茎叶三至五钱，水煎服。③治疾病：鹿藿五钱，豆腐适量，加水同煮服。④治流注，痈肿：鲜鹿藿叶适量。捣烂，酌加烧酒捣匀。外敷。(选方出江西《草药手册》)"}]},{"ID":"20240613112606-7nkzplm","Type":"NodeParagraph","Properties":{"id":"20240613112606-7nkzplm","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613112606-apfq5bj","Type":"NodeParagraph","Properties":{"id":"20240613112606-apfq5bj","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 1.《本草经疏》：鹿藿，解毒凉血之药也。故主肠痈瘰疬疡气。女人以血为主，血虚有热，则腰腹痛不乐，得苦凉之气，则热退而血得所养，故主女人腰腹痛不乐也。"}]},{"ID":"20240613112606-dcii060","Type":"NodeParagraph","Properties":{"id":"20240613112606-dcii060","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"2.《本经》：主女子腰腹痛不乐，肠痈，瘰疬，疡气。"}]},{"ID":"20240613112606-e7htajr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613112606-e7htajr","updated":"20240613112606"},"Children":[{"ID":"20240613112606-jra2q16","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240613112606-jra2q16","updated":"20240613112606"},"Children":[{"ID":"20240613112606-r78m04f","Type":"NodeParagraph","Properties":{"id":"20240613112606-r78m04f","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"江西《草药手册》：祛痰，解毒，杀虫，祛风湿，和血气。治肠痈，瘰疬，头痛，眼痛，腹痛。"}]}]}]},{"ID":"20240613112606-ab4jg0v","Type":"NodeParagraph","Properties":{"id":"20240613112606-ab4jg0v","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613112606-n2yv229","Type":"NodeParagraph","Properties":{"id":"20240613112606-n2yv229","updated":"20240613112606"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613112607-6ajs2uw","Type":"NodeThematicBreak","Properties":{"id":"20240613112607-6ajs2uw"}},{"ID":"20240613112608-ihd1qz7","Type":"NodeParagraph","Properties":{"id":"20240613112608-ihd1qz7"}}]}