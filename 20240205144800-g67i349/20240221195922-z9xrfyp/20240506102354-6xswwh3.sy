{"ID":"20240506102354-6xswwh3","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102354-6xswwh3","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102354-6xswwh3\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506102354-jcaw4aj\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613110754-2barqlk\u0026quot;,\u0026quot;scrollTop\u0026quot;:1807,\u0026quot;focusId\u0026quot;:\u0026quot;20240613110558-grw8v6v\u0026quot;,\u0026quot;focusStart\u0026quot;:52,\u0026quot;focusEnd\u0026quot;:52\u0026#125;","title":"300羊桃（鬼桃）","type":"doc","updated":"20240823171141"},"Children":[{"ID":"20240823170737-h4diiwa","Type":"NodeParagraph","Properties":{"id":"20240823170737-h4diiwa","updated":"20240823170737"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 485px;","style":"width: 475px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 3-20240823170737-mw0ln75.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 475px;\" parent-style=\"width: 485px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240701145311-ke7l3fp","Type":"NodeParagraph","Properties":{"id":"20240701145311-ke7l3fp","updated":"20240823170748"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 486px;","style":"width: 476px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃6-20240701145311-4jpx13u.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 476px;\" parent-style=\"width: 486px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823170912-3pns5zf","Type":"NodeParagraph","Properties":{"id":"20240823170912-3pns5zf","updated":"20240823170959"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 409px;","style":"width: 399px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 5-20240823170912-sae70wx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 399px;\" parent-style=\"width: 409px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 808px;","style":"width: 798px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 6-20240823170959-0f89mey.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 798px;\" parent-style=\"width: 808px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823170554-zlmu4lk","Type":"NodeParagraph","Properties":{"id":"20240823170554-zlmu4lk","updated":"20240823170554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 1-20240823170451-q5qvxzd.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 621px;","style":"width: 611px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃2-20240701144106-5p3n16s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 611px;\" parent-style=\"width: 621px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823170827-owol4vm","Type":"NodeParagraph","Properties":{"id":"20240823170827-owol4vm","updated":"20240823171011"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 4-20240823170827-izpvti9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 757px;","style":"width: 747px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃-20240701143956-th75v45.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 747px;\" parent-style=\"width: 757px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823170318-dbn4x3p","Type":"NodeParagraph","Properties":{"id":"20240823170318-dbn4x3p","updated":"20240823171011"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 491px;","style":"width: 481px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃-20240823170318-7gult55.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 481px;\" parent-style=\"width: 491px;\"}"},{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 764px;","style":"width: 754px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃3-20240701145016-uwr2tmh.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 754px;\" parent-style=\"width: 764px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823170539-ij8e6kg","Type":"NodeParagraph","Properties":{"id":"20240823170539-ij8e6kg","updated":"20240823170543"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 2-20240823170539-xhjxdxt.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 344px;","style":"width: 334px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃5-20240701145052-m2g37u2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 334px;\" parent-style=\"width: 344px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823171128-8p9u322","Type":"NodeParagraph","Properties":{"id":"20240823171128-8p9u322","updated":"20240823171141"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 375px;","style":"width: 365px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 7-20240823171128-0znh72m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 365px;\" parent-style=\"width: 375px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 874px;","style":"width: 864px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"猕猴桃 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/猕猴桃 8-20240823171141-zg7dr0z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 864px;\" parent-style=\"width: 874px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240701143805-l0vkxaa","Type":"NodeParagraph","Properties":{"id":"20240701143805-l0vkxaa","updated":"20240823170806"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：取图为猕猴桃，该篇存疑，如错误烦请指正。"}]},{"ID":"20240613110439-bldwlnx","Type":"NodeThematicBreak","Properties":{"id":"20240613110439-bldwlnx"}},{"ID":"20240613110626-p0m1zkw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110626-p0m1zkw","updated":"20240613110636"},"Children":[{"Type":"NodeText","Data":"羊桃《神农本草经》"}]},{"ID":"20240613110626-lusvhvy","Type":"NodeParagraph","Properties":{"id":"20240613110626-lusvhvy","updated":"20240613110626"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613110626-dasigqc","Type":"NodeParagraph","Properties":{"id":"20240613110626-dasigqc","updated":"20240613110626"},"Children":[{"Type":"NodeText","Data":"主熛热，身暴赤色，风水积聚，恶疡，除小儿热。一名鬼桃，一名羊肠。生川谷。"}]},{"ID":"20240613110626-bvo3vqb","Type":"NodeParagraph","Properties":{"id":"20240613110626-bvo3vqb","updated":"20240613110626"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名苌楚，一名御弋，一名铫弋，生山林及田野，二月采，阴干。"}]},{"ID":"20240613110626-vshy0yg","Type":"NodeParagraph","Properties":{"id":"20240613110626-vshy0yg","updated":"20240613110626"},"Children":[{"Type":"NodeText","Data":"案《说文》云：苌，苌楚铫弋，一名羊桃。《广雅》云：鬼桃铫戈羊桃也。《中山经》云：丰山多羊桃，状如桃而方，茎可以为皮张。《尔雅》云：长楚姚铫。郭璞云：今羊桃也，或曰鬼桃，叶似桃华，白子如小麦，亦似桃。《毛诗》云：隰有铫楚。《传》云：苌楚，铫弋也。陆玑云：今羊桃是也，叶长而狭，华紫赤色，其枝茎弱过一尺，引蔓于草上，今人以为汲灌，重而善没，不如杨柳也，近下根，刀切其皮，著热灰中，脱之，可韬笔管。"}]},{"ID":"20240613110720-jvyk16e","Type":"NodeThematicBreak","Properties":{"id":"20240613110720-jvyk16e"}},{"ID":"20240613110721-mw6e17h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110721-mw6e17h","updated":"20240613110725"},"Children":[{"Type":"NodeText","Data":"羊桃《千金翼方》"}]},{"ID":"20240613110721-36zdsrr","Type":"NodeParagraph","Properties":{"id":"20240613110721-36zdsrr","updated":"20240613110721"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有毒。主 热，身暴赤色，风水积聚，恶疡，除小儿热。去五脏五水大腹，利小便，益气。可作浴汤。一名鬼桃，一名羊肠，一名苌楚，一名御弋，一名铫弋。生山林川谷及生田野，二月采，阴干。"}]},{"ID":"20240613110439-rd70epu","Type":"NodeThematicBreak","Properties":{"id":"20240613110439-rd70epu"}},{"ID":"20240613110440-uw94lql","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110440-uw94lql","updated":"20240613110446"},"Children":[{"Type":"NodeText","Data":"羊桃《医学入门》"}]},{"ID":"20240613110440-wxfj5qg","Type":"NodeParagraph","Properties":{"id":"20240613110440-wxfj5qg","updated":"20240613110440"},"Children":[{"Type":"NodeText","Data":"山野甚多，似家桃，又非山桃，叶蔓，花赤，实如枣核。味苦，寒。有毒。主 热身暴赤色，风水积聚，除小儿热，去五脏五水大腹，利小便，益气。可作浴汤，洗风痒恶疡，诸疮肿毒。二月采阴干。"}]},{"ID":"20240613110441-vxduu7c","Type":"NodeThematicBreak","Properties":{"id":"20240613110441-vxduu7c"}},{"ID":"20240613110453-kos0txw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110453-kos0txw","updated":"20240613110500"},"Children":[{"Type":"NodeText","Data":"羊桃《本草纲目拾遗》"}]},{"ID":"20240613110453-ug5axeh","Type":"NodeParagraph","Properties":{"id":"20240613110453-ug5axeh","updated":"20240613110453"},"Children":[{"Type":"NodeText","Data":"粤语∶其种来自大洋，一曰洋桃，高五、六丈，大者数围，花红色，一蒂数子，七、八月间熟，色如蜡，一名三敛子，亦曰山敛。敛，棱也。俗语误棱为敛也，亦以其味酸能敛颜色也。有五棱者，名五敛。以糯米水浇则甜，名糯羊桃，广人以为蔬。纲目∶五敛子，即羊桃。"}]},{"ID":"20240613110453-t5kt1ki","Type":"NodeParagraph","Properties":{"id":"20240613110453-t5kt1ki","updated":"20240613110453"},"Children":[{"Type":"NodeText","Data":"惟言其主治风热，生津止渴，他功效皆未及，今依粤语补之。尔雅∶长楚铫（注∶今羊桃也），或曰，鬼桃叶似桃花，白子如小麦，亦似桃。陆机疏云∶叶长而狭，花紫赤色，其枝茎弱，过一尺引蔓于草上。郑氏曰∶藤生子赤，状如鼠粪，故亦名鼠矢。儿童食之，一名羊肠，一名御弋。蜀本图经∶子细如枣核，苗长弱蔓生，不能为树，今呼为细子，根似牡丹。群芳谱∶羊桃，福州产，其花五瓣，色青黄。诗桧风∶隰有苌楚，猗傩其枝，即指此也。"}]},{"ID":"20240613110453-iuhpfy5","Type":"NodeParagraph","Properties":{"id":"20240613110453-iuhpfy5","updated":"20240613110453"},"Children":[{"Type":"NodeText","Data":"酸甘涩平无毒，久食能辟岚瘴之毒。中蛊者，捣自然汁饮，毒即吐出；脯之或白蜜渍之，持至北方，不服水土与疟者，皆可治。岭南杂记∶有食猪肉咽喉肿痛，食羊桃即解。"}]},{"ID":"20240613110453-zln3wuk","Type":"NodeParagraph","Properties":{"id":"20240613110453-zln3wuk","updated":"20240613110453"},"Children":[{"Type":"NodeText","Data":"药性考∶羊桃生时极酸，不可食，熟则带甘，过食寒中，内热者宜之。多食冷脾胃、动泄，可晒干。歌曰∶猴桃，寒酸甘止渴调中，下气解烦，除热骨节风痛，能压丹石，通淋疗痔，瓤可煎食。"}]},{"ID":"20240613110453-cwj66tu","Type":"NodeThematicBreak","Properties":{"id":"20240613110453-cwj66tu"}},{"ID":"20240613110506-iziicp9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110506-iziicp9","updated":"20240613110518"},"Children":[{"Type":"NodeText","Data":"羊桃《本草纲目》"}]},{"ID":"20240613110506-r6oed23","Type":"NodeParagraph","Properties":{"id":"20240613110506-r6oed23","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）"}]},{"ID":"20240613110506-xkoaabn","Type":"NodeParagraph","Properties":{"id":"20240613110506-xkoaabn","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"〖释名〗鬼桃（《本经》）羊肠（同苌楚（《尔雅》）铫芅（音姚弋。或作御弋）细子（并未详）"}]},{"ID":"20240613110506-o03l8do","Type":"NodeParagraph","Properties":{"id":"20240613110506-o03l8do","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"〖集解〗〔《别录》曰〕羊桃生山林川谷及田野。二月采，阴干。〔弘景曰〕山野多有。胜似家桃，又非山桃。花甚赤。子小细而苦，不堪食。诗云，隰有苌楚，即此。方药不复用。〔保升曰〕生平泽中，处处有之。苗长而弱，不能为树。叶花皆似桃，子细如枣核，今人呼为细子，其根似牡丹。郭璞云：羊桃叶似桃，其花白色，子如小麦，亦似桃形。陆机《诗疏》云：叶长而狭，花紫赤色，其枝茎弱，过一尺引蔓于草上。今人以为汲灌，重而善没，不如杨柳也。近下根，刀切其皮，着热灰中脱之，可韬笔管也。〔时珍曰〕羊桃茎大如指，似树而弱如蔓，春长嫩条柔软。叶大如掌，上绿下白，有毛，状似苎麻而团。其条浸水有涎滑。"}]},{"ID":"20240613110506-0076g9i","Type":"NodeParagraph","Properties":{"id":"20240613110506-0076g9i","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"茎根"}]},{"ID":"20240613110506-xbpexl5","Type":"NodeParagraph","Properties":{"id":"20240613110506-xbpexl5","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"〖气味〗苦，寒，有毒。（〔藏器曰〕甘，无毒）"}]},{"ID":"20240613110506-88sv4u7","Type":"NodeParagraph","Properties":{"id":"20240613110506-88sv4u7","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"〖主治〗熛热，身暴赤色，除小儿热，风水积聚，恶疡。（《本经》）去五脏五水，大腹，利小便，益气，可作浴汤。（《别录》）煮汁，洗风痒及诸疮肿，极效。（恭）根：浸酒服，治风热羸老。（藏器）"}]},{"ID":"20240613110506-yx2uetr","Type":"NodeParagraph","Properties":{"id":"20240613110506-yx2uetr","updated":"20240613110506"},"Children":[{"Type":"NodeText","Data":"〖附方〗（旧一，新三）伤寒变[匿/虫]（四肢烦疼，不食多睡。羊桃十斤捣熟，浸热汤三斗，日正午时，入坐一炊久。不过三次愈。《千金》）伤寒毒攻（手足肿痛。羊桃煮汁，入少盐渍之。《肘后》）水气鼓胀（大小便涩。羊桃根、桑白皮、木通、大戟炒各半斤锉，水一斗，煮五升，熬如稀饧。每空心茶服一匙。二便利，食粥补之。《圣惠方》）蜘蛛咬毒（羊桃叶捣，傅之，立愈。《备急方》）"}]},{"ID":"20240613110507-hzmwezi","Type":"NodeThematicBreak","Properties":{"id":"20240613110507-hzmwezi"}},{"ID":"20240613110526-8kk9xwc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110526-8kk9xwc","updated":"20240613110532"},"Children":[{"Type":"NodeText","Data":"羊桃《名医别录》"}]},{"ID":"20240613110526-pncpoeh","Type":"NodeParagraph","Properties":{"id":"20240613110526-pncpoeh","updated":"20240613110526"},"Children":[{"Type":"NodeText","Data":"有毒．主去五脏五水，大腹，利小便，益气，可作浴汤．一名苌楚，一名御弋，一名铫弋．生山林及生田野．二月采，阴干．"}]},{"ID":"20240613110526-agsucvs","Type":"NodeParagraph","Properties":{"id":"20240613110526-agsucvs","updated":"20240613110526"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶羊桃，味苦，寒．主 热，身暴赤色，风水积聚，恶疡，除小儿热．一名鬼桃，一名羊肠．生川谷．"}]},{"ID":"20240613110526-zpupe7x","Type":"NodeThematicBreak","Properties":{"id":"20240613110526-zpupe7x"}},{"ID":"20240613110558-727qxpg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110558-727qxpg","updated":"20240613110602"},"Children":[{"Type":"NodeText","Data":"羊桃《本草经集注》"}]},{"ID":"20240613110558-3voxjxd","Type":"NodeParagraph","Properties":{"id":"20240613110558-3voxjxd","updated":"20240613110558"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有毒。主治 热，身暴赤色，风水积聚，恶疡，除小儿热。去五脏五水，大腹，利小便，益气，可作浴汤。一名鬼桃，一名羊肠，一名苌楚，一名御戈，一名铫戈。生山林川谷及生田野，二月采，阴干。"}]},{"ID":"20240613110558-grw8v6v","Type":"NodeParagraph","Properties":{"id":"20240613110558-grw8v6v","updated":"20240613110558"},"Children":[{"Type":"NodeText","Data":"山野多有，甚似家桃，又非山桃。子小细，苦不堪啖，花甚赤。《诗》云∶“隰有苌楚”者，即此也。方药亦不复用。"}]},{"ID":"20240613110608-89sj7a7","Type":"NodeThematicBreak","Properties":{"id":"20240613110608-89sj7a7"}},{"ID":"20240613110752-bl2o3mn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110752-bl2o3mn","updated":"20240613110802"},"Children":[{"Type":"NodeText","Data":"羊桃《证类本草》"}]},{"ID":"20240613110752-xyk9le5","Type":"NodeParagraph","Properties":{"id":"20240613110752-xyk9le5","updated":"20240613110803"},"Children":[{"Type":"NodeText","Data":"味苦，寒，有毒。主 热，身暴赤色，风水积聚，恶疡，除小儿热，去五脏五水大腹，利小便，益气。可作浴汤。一名鬼桃，一名羊肠，一名苌楚，一名御弋，一名铫（音姚）"}]},{"ID":"20240613110752-ivfsrni","Type":"NodeParagraph","Properties":{"id":"20240613110752-ivfsrni","updated":"20240613110752"},"Children":[{"Type":"NodeText","Data":"弋。生山林川谷及生田野。二月采，阴干。"}]},{"ID":"20240613110752-moybgku","Type":"NodeParagraph","Properties":{"id":"20240613110752-moybgku","updated":"20240617115410"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶山野多有。甚似家桃，又非山桃子。小细，苦不堪啖，花甚赤。《诗》云∶隰有苌楚者即此也。方药亦不复用。唐本注云∶此物多生沟渠隍堑之间。人取煮以洗风痒及诸疮肿，极效。剑南人名细子根也。臣禹锡等谨按蜀本图经云∶生平泽中。叶、花似桃，子细如枣核，苗长弱即蔓生，不能为树。今处处有，多生溪涧。今人呼为细子根，似牡丹。疗肿，尔雅云∶苌楚，铫弋。郭云∶今羊桃也。释云∶叶似桃，花白，子如小麦，亦似桃。陆机云∶叶长而狭，华紫赤色。其枝茎弱，过一尺引蔓于草上。今人以为汲灌，重而善没，不如杨柳也。近下根，刀切其皮，着热灰中脱之，可韬笔管也。"}]},{"ID":"20240613110752-j366xii","Type":"NodeParagraph","Properties":{"id":"20240613110752-j366xii","updated":"20240613110808"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶味甘，无毒。主风热羸老。浸酒服之。生蜀川川谷中。草高一尺，叶长小，亦云羊桃根也。肘后方∶治伤寒毒攻手足痛，煮羊桃汁渍之，杂盐豉尤好。"}]},{"ID":"20240613110753-s0vp006","Type":"NodeThematicBreak","Properties":{"id":"20240613110753-s0vp006"}},{"ID":"20240613110754-2barqlk","Type":"NodeParagraph","Properties":{"id":"20240613110754-2barqlk"}}]}