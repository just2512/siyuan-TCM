{"ID":"20240506102356-8psu1su","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102356-8psu1su","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102356-8psu1su\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240629124914-vpm76pz\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613094908-v7g6i1u\u0026quot;,\u0026quot;scrollTop\u0026quot;:0\u0026#125;","title":"288泽漆（猫眼草、五朵云）","type":"doc","updated":"20240823115948"},"Children":[{"ID":"20240629124914-vpm76pz","Type":"NodeParagraph","Properties":{"id":"20240629124914-vpm76pz","updated":"20240629124914"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 383px;","style":"width: 373px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆6-20240629124914-wgntgn4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 373px;\" parent-style=\"width: 383px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629124214-fujam24","Type":"NodeParagraph","Properties":{"id":"20240629124214-fujam24","updated":"20240823115635"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 306px;","style":"width: 296px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆-20240629124214-t2rvgrm.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 296px;\" parent-style=\"width: 306px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 389px;","style":"width: 379px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆2-20240629124333-2zgxmc4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 379px;\" parent-style=\"width: 389px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 390px;","style":"width: 380px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆 1-20240823115635-pjytwll.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 380px;\" parent-style=\"width: 390px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823115721-as6ffsi","Type":"NodeParagraph","Properties":{"id":"20240823115721-as6ffsi","updated":"20240823115732"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 495px;","style":"width: 485px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆 2-20240823115722-b5tv4q3.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 485px;\" parent-style=\"width: 495px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 333px;","style":"width: 323px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆4-20240629124558-idah4a7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 323px;\" parent-style=\"width: 333px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 380px;","style":"width: 370px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆9"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆9-20240629130035-xsu5qea.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 370px;\" parent-style=\"width: 380px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619171638-zm82qkr","Type":"NodeParagraph","Properties":{"id":"20240619171638-zm82qkr","updated":"20240823115734"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 539px;","style":"width: 529px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆-20240619171638-8xb07ro.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 529px;\" parent-style=\"width: 539px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 716px;","style":"width: 706px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆8-20240629125500-p2r7dum.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 706px;\" parent-style=\"width: 716px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823115810-gxy923p","Type":"NodeParagraph","Properties":{"id":"20240823115810-gxy923p","updated":"20240823115849"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 591px;","style":"width: 581px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆 3-20240823115810-bsufv7c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 581px;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 668px;","style":"width: 658px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆 4-20240823115849-t6ri3yn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 658px;\" parent-style=\"width: 668px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823115937-we5cuse","Type":"NodeParagraph","Properties":{"id":"20240823115937-we5cuse","updated":"20240823115937"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 786px;","style":"width: 776px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆 5-20240823115937-mwn2xpn.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 776px;\" parent-style=\"width: 786px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 431px;","style":"width: 421px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆-20240823115556-eqys327.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 421px;\" parent-style=\"width: 431px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629124955-hmexp0x","Type":"NodeParagraph","Properties":{"id":"20240629124955-hmexp0x","updated":"20240823115948"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 1220px;","style":"width: 1210px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"泽漆7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/泽漆7-20240629124955-gpznsu1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1210px;\" parent-style=\"width: 1220px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629132201-q824kbj","Type":"NodeParagraph","Properties":{"id":"20240629132201-q824kbj","updated":"20240629134748"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"甘遂、泽漆、大戟"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三者极为相似；统称为猫眼三兄弟，也就是我们所说的猫眼草。可以通过叶片区分，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"泽漆"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶片是倒卵形或者匙形的，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"甘遂"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"的叶片是狭叶披针形或线状披针形，叶片先端钝，无柄或有的有短柄，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"大戟"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"的叶片是长椭圆形的，叶片先端尖，基部近平截。另外泽漆是一年生的草本植物，甘遂和大戟则是多年生的。如下视频。"}]},{"ID":"20240629134625-radvu3v","Type":"NodeVideo","Data":"\u003cvideo controls=\"controls\" src=\"assets/甘遂、泽漆、大戟区别-20240629134624-72vhd1p.mp4\" data-src=\"assets/甘遂、泽漆、大戟区别-20240629134624-72vhd1p.mp4\" style=\"width: 400px; height: 779px;\"\u003e\u003c/video\u003e","Properties":{"id":"20240629134625-radvu3v","updated":"20240629134625"}},{"ID":"20240613095112-0zw0ewm","Type":"NodeThematicBreak","Properties":{"id":"20240613095112-0zw0ewm"}},{"ID":"20240613095200-aqshvct","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095200-aqshvct","updated":"20240613095204"},"Children":[{"Type":"NodeText","Data":"泽漆《神农本草经》"}]},{"ID":"20240613095200-ehrldkn","Type":"NodeParagraph","Properties":{"id":"20240613095200-ehrldkn","updated":"20240613095200"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240613095200-fou6nco","Type":"NodeParagraph","Properties":{"id":"20240613095200-fou6nco","updated":"20240613095200"},"Children":[{"Type":"NodeText","Data":"主皮肤热，大腹，水气，四肢面目浮肿，丈夫阴气不足。生川泽。"}]},{"ID":"20240613095200-zvva1c4","Type":"NodeParagraph","Properties":{"id":"20240613095200-zvva1c4","updated":"20240613095200"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名漆茎，大戟苗也，生太山，三月三日，七月七日，采茎叶，阴干。"}]},{"ID":"20240613095200-2oqv04c","Type":"NodeParagraph","Properties":{"id":"20240613095200-2oqv04c","updated":"20240613095200"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：黍茎，泽漆也。"}]},{"ID":"20240613095224-qqqze06","Type":"NodeThematicBreak","Properties":{"id":"20240613095224-qqqze06"}},{"ID":"20240613095225-u4cjggi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095225-u4cjggi","updated":"20240613095236"},"Children":[{"Type":"NodeText","Data":"泽漆《本草述钩元》"}]},{"ID":"20240613095225-p7fow1c","Type":"NodeParagraph","Properties":{"id":"20240613095225-p7fow1c","updated":"20240613095225"},"Children":[{"Type":"NodeText","Data":"即猫儿眼睛草。一名绿叶绿花草。又名五凤草。江湖原泽平陆多有之。柔茎如马齿苋叶如苜蓿。圆而黄绿。颇似猫睛。茎头五叶。中抽小茎五枝。每枝开细花。青绿色。复有小叶承之。掐其茎。有白汁黏人。根色白。有硬骨。或以此为大戟苗者误也。（濒湖）大戟"}]},{"ID":"20240613095225-mx05amb","Type":"NodeParagraph","Properties":{"id":"20240613095225-mx05amb","updated":"20240613095225"},"Children":[{"Type":"NodeText","Data":"茎叶"}]},{"ID":"20240613095225-zlu5kym","Type":"NodeParagraph","Properties":{"id":"20240613095225-zlu5kym","updated":"20240613095225"},"Children":[{"Type":"NodeText","Data":"气味苦辛。微寒。有小毒。治大腹水气。四肢面目浮肿。丈夫阴气不足。利大疗痢后肿满。气急喘嗽。小便如血。"}]},{"ID":"20240613095225-2k5tepi","Type":"NodeParagraph","Properties":{"id":"20240613095225-2k5tepi","updated":"20240613095225"},"Children":[{"Type":"NodeText","Data":"附方肺咳上气脉沉者。主泽漆汤。泽漆三斤。以东流水五斗。煮取一斗五升。去渣。"}]},{"ID":"20240613095225-qvjuwul","Type":"NodeParagraph","Properties":{"id":"20240613095225-qvjuwul","updated":"20240613095225"},"Children":[{"Type":"NodeText","Data":"入半服。"}]},{"ID":"20240613095225-9wo9cie","Type":"NodeParagraph","Properties":{"id":"20240613095225-9wo9cie","updated":"20240613095317"},"Children":[{"Type":"NodeText","Data":"〔论〕泽漆利水。虽与大戟相类。然大戟泄人。而泽漆更治丈夫阴气不足。《经》云：水者，阴气也。阴气下而复上，客于脏腑间，此邪水之阴，非真阴也。他味之行邪水于真阴，未能不伤，独此味行邪水而真阴反以受益。阅方书用之治肿，必与参、术、桑皮、郁李同为益脾之助，而化气开结，尤藉其前导以为功耳。然则非瞑眩之剂，洵为治水之善物。"}]},{"ID":"20240613095350-jtcv090","Type":"NodeThematicBreak","Properties":{"id":"20240613095350-jtcv090"}},{"ID":"20240613095352-03gqjcl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095352-03gqjcl","updated":"20240613095355"},"Children":[{"Type":"NodeText","Data":"泽漆《本草撮要》"}]},{"ID":"20240613095352-8w43kez","Type":"NodeParagraph","Properties":{"id":"20240613095352-8w43kez","updated":"20240613095352"},"Children":[{"Type":"NodeText","Data":"味苦辛微寒．入手足太阴经．功专利水．治大腹水气．四肢面目浮肿．下痢肿满．气急喘嗽．小便如血．得大黄、葶苈疗心下伏瘕．一名猫儿眼睛．"}]},{"ID":"20240613095426-isbr3el","Type":"NodeThematicBreak","Properties":{"id":"20240613095426-isbr3el"}},{"ID":"20240613095427-l4ejmbz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095427-l4ejmbz","updated":"20240613095433"},"Children":[{"Type":"NodeText","Data":"泽漆《证类本草》"}]},{"ID":"20240613095427-4phpizc","Type":"NodeParagraph","Properties":{"id":"20240613095427-4phpizc","updated":"20240613095427"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微寒，无毒。主皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足，利大小肠，明目，身轻。一名漆茎，大戟苗也。生泰山川泽。三月三日、七月七日采茎叶，阴干。（小豆为之使，恶薯蓣。）"}]},{"ID":"20240613095427-za7zpmw","Type":"NodeParagraph","Properties":{"id":"20240613095427-za7zpmw","updated":"20240613095427"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶此是大戟苗，生时摘叶有白汁，故名泽漆，亦能啮人肉。臣禹锡等按蜀本图经云∶五月采，日干用。药性论云∶泽漆，使，治人肌热，利小便。日华子云∶冷，微毒。止疟疾，消痰退热。此即大戟花。川泽中有。茎梗小，有叶花黄，叶似嫩菜，四、五月采之。"}]},{"ID":"20240613095427-0k4q0oy","Type":"NodeParagraph","Properties":{"id":"20240613095427-0k4q0oy","updated":"20240613095427"},"Children":[{"Type":"NodeText","Data":"图经曰∶泽漆，大戟苗也。生秦山川泽，今冀州、鼎州、明州及近道亦有之。生时摘叶有白汁出。亦能啮人，故以为名。然张仲景治肺咳上气，脉沉者，泽漆汤主之。泽漆三斤，以东流水五斗，煮取一斗五升，然后用半夏半升，紫参、生姜、白前各五两，甘草、黄芩、人参、桂各三两，八物 咀之，纳泽漆汁中，煎取五升。每服五合，日三，至夜服尽。"}]},{"ID":"20240613095427-mywfku0","Type":"NodeParagraph","Properties":{"id":"20240613095427-mywfku0","updated":"20240613095427"},"Children":[{"Type":"NodeText","Data":"唐本余∶有小毒。逐水，主蛊毒。圣惠方∶治十种水气。用泽漆十斤，于夏间取茎、嫩叶，入酒一斗，研汁约二斗，于银锅内，慢火熬如稀饧，即止，瓷器内收。每日空心温酒调下一茶匙，以愈为度。"}]},{"ID":"20240613095453-o2l0rxt","Type":"NodeThematicBreak","Properties":{"id":"20240613095453-o2l0rxt"}},{"ID":"20240613095454-y22av7r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095454-y22av7r","updated":"20240613095505"},"Children":[{"Type":"NodeText","Data":"泽漆《本经逢原》"}]},{"ID":"20240613095454-9r38v7g","Type":"NodeParagraph","Properties":{"id":"20240613095454-9r38v7g","updated":"20240613095454"},"Children":[{"Type":"NodeText","Data":"（《本经》名漆茎）"}]},{"ID":"20240613095454-dxk1571","Type":"NodeParagraph","Properties":{"id":"20240613095454-dxk1571","updated":"20240613095454"},"Children":[{"Type":"NodeText","Data":"苦，寒，小毒。《别录》《日华》、陶氏皆言是大戟苗，《纲目》名猫儿眼睛草。时珍云：江湖源泽多有之，掐茎有白汁粘人，故名。"}]},{"ID":"20240613095454-3sl3jr2","Type":"NodeParagraph","Properties":{"id":"20240613095454-3sl3jr2","updated":"20240613095454"},"Children":[{"Type":"NodeText","Data":"《本经》主皮肤大热，大腹水气，四肢面目浮肿，丈夫阴气不足。"}]},{"ID":"20240613095454-6ab6xzo","Type":"NodeParagraph","Properties":{"id":"20240613095454-6ab6xzo","updated":"20240613095454"},"Children":[{"Type":"NodeText","Data":"〔发明〕泽漆利水，功类大戟，遂误以为大戟苗。《本经》言利丈夫阴气，则与大戟不相侔也。其治皮肤大热、面浮腹大等证，兼挟表热而言，其性与大戟亦相类也。《金匮》泽漆汤，方用泽漆、半夏、紫参、白前、甘草、人参、桂心、生姜，以治肺咳上气、脉沉。《大明》言止疟疾，消痰，退热。《肘后》《圣惠》《易简》伏瘕，水肿，脚气皆用之。"}]},{"ID":"20240613095439-mnx5qzz","Type":"NodeThematicBreak","Properties":{"id":"20240613095439-mnx5qzz"}},{"ID":"20240613095440-ytzjlna","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095440-ytzjlna","updated":"20240613095447"},"Children":[{"Type":"NodeText","Data":"泽漆《增广和剂局方药性总论》"}]},{"ID":"20240613095440-8ded55z","Type":"NodeParagraph","Properties":{"id":"20240613095440-8ded55z","updated":"20240613095440"},"Children":[{"Type":"NodeText","Data":"味苦辛，微寒，无毒。主皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足，利大小肠，明目，轻身。《药性论》云∶使。治皮肌热，利小便。日华子云∶冷，微毒。止疟疾，消痰，退热。此即大戟花。一云∶大戟苗也。《唐本余》∶逐水，主蛊毒。小豆为使。恶∶薯蓣。"}]},{"ID":"20240613095415-852k44z","Type":"NodeThematicBreak","Properties":{"id":"20240613095415-852k44z"}},{"ID":"20240613095416-zgkim37","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095416-zgkim37","updated":"20240613095420"},"Children":[{"Type":"NodeText","Data":"泽漆《本草经集注》"}]},{"ID":"20240613095416-cdbla86","Type":"NodeParagraph","Properties":{"id":"20240613095416-cdbla86","updated":"20240613095416"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微寒，无毒。主治皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足。利大小肠，明目，轻身。一名漆茎，大戟苗也。生太山川泽。三月三日、七月七日采茎叶，阴干。"}]},{"ID":"20240613095416-w5nf2lt","Type":"NodeParagraph","Properties":{"id":"20240613095416-w5nf2lt","updated":"20240613095416"},"Children":[{"Type":"NodeText","Data":"（小豆为之使，恶薯蓣。）"}]},{"ID":"20240613095416-ukjwzmz","Type":"NodeParagraph","Properties":{"id":"20240613095416-ukjwzmz","updated":"20240613095416"},"Children":[{"Type":"NodeText","Data":"是大戟苗，生时摘叶有白汁，故名泽漆，亦能啮人肉。"}]},{"ID":"20240613095401-7pia4nh","Type":"NodeThematicBreak","Properties":{"id":"20240613095401-7pia4nh"}},{"ID":"20240613095402-yk8vnju","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095402-yk8vnju","updated":"20240613095407"},"Children":[{"Type":"NodeText","Data":"泽漆《得配本草》"}]},{"ID":"20240613095402-2py0cqi","Type":"NodeParagraph","Properties":{"id":"20240613095402-2py0cqi","updated":"20240613095402"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名猫儿眼睛草"}]},{"ID":"20240613095402-qtl9zu0","Type":"NodeParagraph","Properties":{"id":"20240613095402-qtl9zu0","updated":"20240613095402"},"Children":[{"Type":"NodeText","Data":"小豆为之使。恶薯蓣。"}]},{"ID":"20240613095402-01jiq83","Type":"NodeParagraph","Properties":{"id":"20240613095402-01jiq83","updated":"20240613095402"},"Children":[{"Type":"NodeText","Data":"辛、苦、微寒。入手阳明、太阳经气分。消痰行水，止疟退热。配大黄，疗伏瘕。调香油，搽癣疮。熬膏，贴瘰 。气血虚者禁用。"}]},{"ID":"20240613095340-um0rter","Type":"NodeThematicBreak","Properties":{"id":"20240613095340-um0rter"}},{"ID":"20240613095341-5kh3vtu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095341-5kh3vtu","updated":"20240613095345"},"Children":[{"Type":"NodeText","Data":"泽漆《本经逢原》"}]},{"ID":"20240613095341-ri4dysz","Type":"NodeParagraph","Properties":{"id":"20240613095341-ri4dysz","updated":"20240613095341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名漆茎"}]},{"ID":"20240613095341-ajtlst0","Type":"NodeParagraph","Properties":{"id":"20240613095341-ajtlst0","updated":"20240613095341"},"Children":[{"Type":"NodeText","Data":"苦寒，小毒。《别录》、《日华》、陶氏皆言是大戟苗，《纲目》名猫儿眼睛草。时珍云∶江湖源泽多有之，掐茎有白汁黏人故名。"}]},{"ID":"20240613095341-98zmbm4","Type":"NodeParagraph","Properties":{"id":"20240613095341-98zmbm4","updated":"20240613095341"},"Children":[{"Type":"NodeText","Data":"《本经》主皮肤大热，大腹水气，四肢面目浮肿，丈夫阴气不足。"}]},{"ID":"20240613095341-ylfds39","Type":"NodeParagraph","Properties":{"id":"20240613095341-ylfds39","updated":"20240613095341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"泽漆利水功类大戟，遂误以为大戟苗。《本经》言利丈夫阴气则与大戟不相侔也。其治皮肤大热，面浮腹大等证，兼挟表热而言，其性与大戟亦相类也。《金匮》泽漆汤，方用泽漆、半夏、紫参、白前、甘草、人参、桂心、生姜，以治肺咳上气脉沉。《大明》言止疟疾，消痰，退热。《肘后》、《圣惠》、《易简》伏瘕，水肿，香港脚皆用之。"}]},{"ID":"20240613095330-3oxacfb","Type":"NodeThematicBreak","Properties":{"id":"20240613095330-3oxacfb"}},{"ID":"20240613095331-hjffnwt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095331-hjffnwt","updated":"20240613095335"},"Children":[{"Type":"NodeText","Data":"泽漆《本草备要》"}]},{"ID":"20240613095331-m1g5fsx","Type":"NodeParagraph","Properties":{"id":"20240613095331-m1g5fsx","updated":"20240613095331"},"Children":[{"Type":"NodeText","Data":"通，行水"}]},{"ID":"20240613095331-154sa3a","Type":"NodeParagraph","Properties":{"id":"20240613095331-154sa3a","updated":"20240613095331"},"Children":[{"Type":"NodeText","Data":"辛苦微寒。消痰退热，止嗽杀虫，利大、小肠。治大腹水肿，益丈夫阴气。"}]},{"ID":"20240613095331-awfp7t3","Type":"NodeParagraph","Properties":{"id":"20240613095331-awfp7t3","updated":"20240613095331"},"Children":[{"Type":"NodeText","Data":"生平泽，叶园黄绿，颇类猫睛，一名猫儿眼睛草。茎中有白汁，黏人（时珍曰∶《别录》云是大戟苗，非也。功相类耳）。"}]},{"ID":"20240613095212-2jnpwj7","Type":"NodeThematicBreak","Properties":{"id":"20240613095212-2jnpwj7"}},{"ID":"20240613095213-qt7i9q2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095213-qt7i9q2","updated":"20240613095217"},"Children":[{"Type":"NodeText","Data":"泽漆《本草乘雅半偈》"}]},{"ID":"20240613095213-kuqi9ys","Type":"NodeParagraph","Properties":{"id":"20240613095213-kuqi9ys","updated":"20240613095213"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240613095213-raig6qn","Type":"NodeParagraph","Properties":{"id":"20240613095213-raig6qn","updated":"20240613095213"},"Children":[{"Type":"NodeText","Data":"【气味】苦，微寒，无毒。"}]},{"ID":"20240613095213-91zdops","Type":"NodeParagraph","Properties":{"id":"20240613095213-91zdops","updated":"20240613095213"},"Children":[{"Type":"NodeText","Data":"【主治】主治皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足。"}]},{"ID":"20240613095213-774onpv","Type":"NodeParagraph","Properties":{"id":"20240613095213-774onpv","updated":"20240613095213"},"Children":[{"Type":"NodeText","Data":"【核】曰∶泽漆，出太山川泽，今江湖平陆有之。春生苗，一科分枝，丛生柔茎，色碧绿，如马齿苋、苜蓿叶辈，圆黄且绿，颇似猫睛，一名猫儿眼草。茎头五叶，中抽小茎五枝，每枝作细花，色青绿，复有小叶承之，齐整如一，一名五凤草，一名六叶绿花草。茎有白汁黏人，根亦白，中心劲硬如骨。本草为大戟、乌头苗者，谬矣。"}]},{"ID":"20240613095213-zgh6o38","Type":"NodeParagraph","Properties":{"id":"20240613095213-zgh6o38","updated":"20240613095213"},"Children":[{"Type":"NodeText","Data":"【 】曰∶泻水上行之为泽，水泻欲留之为漆，水大体用两叶矣。故水亡体用者，皮肤热；水惟具体者，大腹水气、四肢面目浮肿。缘丈夫阴足而精藏，而起亟，用行体至，体至用行，两无碍焉。仲景先生金匮要略论，咳逆上气，时时吐浊，坐不欲眠，其脉沉者，泽漆汤主之。第形寒饮冷则伤肺，两邪相击，为咳为痈为痿矣。此体用两冥，至肾气独沉宣水之用，即所以辅水之体，内外合邪，泮然冰释矣。"}]},{"ID":"20240613095138-ylt447t","Type":"NodeThematicBreak","Properties":{"id":"20240613095138-ylt447t"}},{"ID":"20240613095150-s8cr1im","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095150-s8cr1im","updated":"20240613095154"},"Children":[{"Type":"NodeText","Data":"泽漆《长沙药解》"}]},{"ID":"20240613095150-lq7cn1r","Type":"NodeParagraph","Properties":{"id":"20240613095150-lq7cn1r","updated":"20240613095150"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】味苦微寒。主皮肤热，大腹，水气，四肢面目浮肿，丈夫阴气不足。生川泽。"}]},{"ID":"20240613095150-d2thnyr","Type":"NodeParagraph","Properties":{"id":"20240613095150-d2thnyr","updated":"20240613095150"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，入足太阳膀胱经。专行水饮，善止咳嗽。"}]},{"ID":"20240613095150-tua601l","Type":"NodeParagraph","Properties":{"id":"20240613095150-tua601l","updated":"20240613095150"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽漆汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"泽漆三升，半夏半升，白前五两，紫参五两，黄芩三两，人参三两，甘草三两，桂枝三两，生姜五两。"},{"Type":"NodeText","Data":"治咳而脉沉者。火浮水沉，自然之性，其脉见沉，是有里水。水邪阻格，肺气不降，金受火刑，是以作咳。人参、甘草，补中而培土，生姜、半夏，降逆而驱浊，紫参、白前，清金而破壅，桂枝、黄芩，疏木而泻火，泽漆行其水积也。"}]},{"ID":"20240613095150-1xuy4ru","Type":"NodeParagraph","Properties":{"id":"20240613095150-1xuy4ru","updated":"20240613095150"},"Children":[{"Type":"NodeText","Data":"泽漆苦寒之性，长于泻水，故能治痰饮阻格之咳。"}]},{"ID":"20240613095150-2415a7i","Type":"NodeParagraph","Properties":{"id":"20240613095150-2415a7i","updated":"20240613095150"},"Children":[{"Type":"NodeText","Data":"入药用长流水煎。"}]},{"ID":"20240613095138-1x3o8i4","Type":"NodeThematicBreak","Properties":{"id":"20240613095138-1x3o8i4"}},{"ID":"20240613095139-py48j39","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095139-py48j39","updated":"20240613095143"},"Children":[{"Type":"NodeText","Data":"泽漆《新修本草》"}]},{"ID":"20240613095139-di1e4uh","Type":"NodeParagraph","Properties":{"id":"20240613095139-di1e4uh","updated":"20240613095139"},"Children":[{"Type":"NodeText","Data":"味苦、辛，微寒，无毒。主皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足。利大小肠，明目，轻身。一名漆茎，大戟苗也。生太山川泽。三月三日、七月七日采茎叶，阴干。"}]},{"ID":"20240613095139-qsy9m22","Type":"NodeParagraph","Properties":{"id":"20240613095139-qsy9m22","updated":"20240613095139"},"Children":[{"Type":"NodeText","Data":"小豆为之使，恶薯蓣。是大戟苗，生时摘叶有白汁，故名泽漆，亦能啮人肉。"}]},{"ID":"20240613095113-nm079d4","Type":"NodeThematicBreak","Properties":{"id":"20240613095113-nm079d4"}},{"ID":"20240613095126-048otuj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095126-048otuj","updated":"20240613095132"},"Children":[{"Type":"NodeText","Data":"泽漆《本草纲目》"}]},{"ID":"20240613095126-jb8t0ne","Type":"NodeParagraph","Properties":{"id":"20240613095126-jb8t0ne","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"「释名」漆茎、猫儿眼睛草、绿叶绿花草、五凤草。"}]},{"ID":"20240613095126-dk7mc8i","Type":"NodeParagraph","Properties":{"id":"20240613095126-dk7mc8i","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"「气味」（茎、叶）苦、微寒、无毒。"}]},{"ID":"20240613095126-r1fc2rc","Type":"NodeParagraph","Properties":{"id":"20240613095126-r1fc2rc","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613095126-zulzfmq","Type":"NodeParagraph","Properties":{"id":"20240613095126-zulzfmq","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"1、咳嗽上气、脉沉。用泽漆三斤，加水五斗，煮取一斗五升，去渣，汁中再加半夏半升，紫参、白前、生姜各五两，甘草黄芩、人参、桂心各三两，最后煎成药汁五升。每服五合，一天服三次。"}]},{"ID":"20240613095126-nloxcj2","Type":"NodeParagraph","Properties":{"id":"20240613095126-nloxcj2","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"2、心下伏瘕（大如杯，不能进食）。用泽漆四两，大黄、葶苈各三两，捣烂筛细，加蜜成丸，如梧子大。每服二丸，一天服三次。"}]},{"ID":"20240613095126-6hyg5s1","Type":"NodeParagraph","Properties":{"id":"20240613095126-6hyg5s1","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"3、水所蛊病（按：此病的病象是腹满，喘息、浮肿）。用泽漆晒干，研为末，加枣肉和成丸子，如弹子大。每服二丸，白开水送下。一天服二次。如腹中觉暖、小便通畅，即为服药见效。"}]},{"ID":"20240613095126-q9pnfw7","Type":"NodeParagraph","Properties":{"id":"20240613095126-q9pnfw7","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"4、脚气赤肿，走路疼痛。用泽漆鹭鸶藤、蜂窠，等分为末。每取一两，加水五碗煎成三碗，熏洗痛处。"}]},{"ID":"20240613095126-xm6eztf","Type":"NodeParagraph","Properties":{"id":"20240613095126-xm6eztf","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"5、牙痛。用泽漆研为末，开水泡汁漱口。"}]},{"ID":"20240613095126-6ntrj4d","Type":"NodeParagraph","Properties":{"id":"20240613095126-6ntrj4d","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"6、瘰疬。用泽漆一、二捆，加水二桶，熬成一桶。去渣，再熬成膏一碗，收存瓶中。用时先以椒、葱、槐枝把患处洗净，然后用膏涂搽，几次之后好可见效。"}]},{"ID":"20240613095126-eeosl1m","Type":"NodeParagraph","Properties":{"id":"20240613095126-eeosl1m","updated":"20240613095126"},"Children":[{"Type":"NodeText","Data":"7、癣疮。用泽漆晒干，研为末，调油涂搽。"}]},{"ID":"20240613095113-vjkljxc","Type":"NodeThematicBreak","Properties":{"id":"20240613095113-vjkljxc"}},{"ID":"20240613095114-qru9qi8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095114-qru9qi8","updated":"20240613095119"},"Children":[{"Type":"NodeText","Data":"泽漆《名医别录》"}]},{"ID":"20240613095114-f1k8ga5","Type":"NodeParagraph","Properties":{"id":"20240613095114-f1k8ga5","updated":"20240613095114"},"Children":[{"Type":"NodeText","Data":"味辛，无毒．利大小肠，明目，轻身．一名漆茎，大戟苗也．生太山．三月三日、七七日采茎叶，阴干．（小豆为之使，恶薯蓣．）"}]},{"ID":"20240613095114-c8u0pvm","Type":"NodeParagraph","Properties":{"id":"20240613095114-c8u0pvm","updated":"20240613095114"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶泽漆，味苦，微寒．主皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足．生川泽．"}]},{"ID":"20240613094904-xzz7ltn","Type":"NodeThematicBreak","Properties":{"id":"20240613094904-xzz7ltn"}},{"ID":"20240613095104-jvhmu3o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095104-jvhmu3o","updated":"20240613095108"},"Children":[{"Type":"NodeText","Data":"泽漆《本草崇原》"}]},{"ID":"20240613095104-3ia5jjr","Type":"NodeParagraph","Properties":{"id":"20240613095104-3ia5jjr","updated":"20240613095104"},"Children":[{"Type":"NodeText","Data":"气味苦，微寒，无毒。主治皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足。"}]},{"ID":"20240613095104-1l4klz8","Type":"NodeParagraph","Properties":{"id":"20240613095104-1l4klz8","updated":"20240613095104"},"Children":[{"Type":"NodeText","Data":"（泽漆《本经》名漆茎，李时珍云∶《别录》、陶氏皆言泽漆是大戟苗。日华子又言是大戟花，其苗可食。然大戟苗泄人，不可为菜。今考《土宿本草》及《宝藏论》诸书并云∶泽漆是猫儿眼睛草，一名绿叶绿花草，一名五凤草。江湖原泽平陆多有之，春生苗，一科分枝成丛，柔茎如马齿苋，绿叶如苜蓿叶，叶圆而黄绿，颇似猫睛，故名猫儿眼。茎头凡五叶中分，中抽小茎五枝，每枝开细花，青绿色，复有小叶承之，齐整如一，故又名五凤草，绿叶绿花草。茎有白汁黏人，其根白色，有硬骨，以此为大戟苗者，误也。据此则泽漆是猫儿眼睛草，非大戟苗也。今方家用治水蛊、香港脚有效，尤与《神农》本文相合，自汉人集《别录》，误以名大戟苗，故诸家袭之尔。）"}]},{"ID":"20240613095104-v3btb59","Type":"NodeParagraph","Properties":{"id":"20240613095104-v3btb59","updated":"20240613095104"},"Children":[{"Type":"NodeText","Data":"（愚按∶泽漆与大戟同类，而各种用者，须知之。）"}]},{"ID":"20240613095104-8pj1x2e","Type":"NodeParagraph","Properties":{"id":"20240613095104-8pj1x2e","updated":"20240613095104"},"Children":[{"Type":"NodeText","Data":"（李时珍曰∶泽漆利水功类大戟，人又见其茎有白汁，遂误以为大戟，大戟根苗皆有毒泄人，而泽漆根硬，不可用苗，亦无毒，可作菜食，而利丈夫阴气，甚不相侔也。）"}]},{"ID":"20240613095104-kuwn718","Type":"NodeParagraph","Properties":{"id":"20240613095104-kuwn718","updated":"20240613095104"},"Children":[{"Type":"NodeText","Data":"泽漆五枝五叶，白汁白根，禀金土之精，故能制化其水，盖金生水而土制水也。气味苦寒，故主治皮肤热，土能制水，故治大腹水气，四肢面目浮肿，金能生水，故治丈夫阴气不足。"}]},{"ID":"20240613095104-dtsbk0h","Type":"NodeParagraph","Properties":{"id":"20240613095104-dtsbk0h","updated":"20240613095104"},"Children":[{"Type":"NodeText","Data":"《金匮》有泽漆汤，治咳逆上气，咳而脉浮者，浓朴麻黄汤主之，咳而脉沉者，泽漆汤主之。"}]},{"ID":"20240613094904-u4qepw1","Type":"NodeThematicBreak","Properties":{"id":"20240613094904-u4qepw1"}},{"ID":"20240613095048-i009fpf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095048-i009fpf","updated":"20240613095057"},"Children":[{"Type":"NodeText","Data":"泽漆《本草图经》"}]},{"ID":"20240613095048-38u6dto","Type":"NodeParagraph","Properties":{"id":"20240613095048-38u6dto","updated":"20240613095053"},"Children":[{"Type":"NodeText","Data":"泽漆，大戟苗也。生泰山川泽，今冀州、鼎州、明州及近道亦有之。"}]},{"ID":"20240613095048-zercvmb","Type":"NodeParagraph","Properties":{"id":"20240613095048-zercvmb","updated":"20240613095048"},"Children":[{"Type":"NodeText","Data":"生时摘叶有白汁出，亦能啮人，故以为名。然张仲景治肺咳上气，脉沉者，泽漆汤主之。泽漆三斤，以东流水五斗，煮取一斗五升，然后用半夏半升，紫参、生姜、白前各五两，甘草、黄芩、人参、桂各三两，八物 咀之，内泽漆汁中，煎取五升。每服五合，日三，至夜服尽。"}]},{"ID":"20240613094904-zxi0kfo","Type":"NodeThematicBreak","Properties":{"id":"20240613094904-zxi0kfo"}},{"ID":"20240613095037-8qwo841","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095037-8qwo841","updated":"20240613095043"},"Children":[{"Type":"NodeText","Data":"泽漆《千金翼方》"}]},{"ID":"20240613095037-rbza0kk","Type":"NodeParagraph","Properties":{"id":"20240613095037-rbza0kk","updated":"20240613095037"},"Children":[{"Type":"NodeText","Data":"味苦辛，微寒，无毒。主皮肤热，大腹，水气，四肢面目浮肿，丈夫阴气不足，肠，明目轻身。一名漆茎，大戟苗也。生太山川泽，三月三日，七月七日采茎叶，阴干。"}]},{"ID":"20240613094904-sulojal","Type":"NodeThematicBreak","Properties":{"id":"20240613094904-sulojal"}},{"ID":"20240613095029-6bntp6r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613095029-6bntp6r","updated":"20240613095033"},"Children":[{"Type":"NodeText","Data":"泽漆《本草新编》"}]},{"ID":"20240613095029-3z4ofpz","Type":"NodeParagraph","Properties":{"id":"20240613095029-3z4ofpz","updated":"20240613095029"},"Children":[{"Type":"NodeText","Data":"泽漆，大戟之苗也。味辛，气寒，阴中微阳也。退皮肤邪热，却面目浮肿，尤消水气。"}]},{"ID":"20240613095029-bo60czc","Type":"NodeParagraph","Properties":{"id":"20240613095029-bo60czc","updated":"20240613095029"},"Children":[{"Type":"NodeText","Data":"或问泽漆，气味与大戟同，既删大戟，又取泽漆，岂玉枢丹中可不用大戟，而用泽漆乎。玉枢丹若改大戟为泽漆，则其功效更神，惟其用大戟，而不用泽漆，故止可祛邪，不可调和正气。然则，何不添入泽漆。不知只用大戟，尚有正气大伤之虚，乌可增其党羽以损乎。"}]},{"ID":"20240613094904-m7rx5ci","Type":"NodeThematicBreak","Properties":{"id":"20240613094904-m7rx5ci"}},{"ID":"20240613094919-776goaq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094919-776goaq","updated":"20240613094930"},"Children":[{"Type":"NodeText","Data":"泽漆《中药学》"}]},{"ID":"20240613094919-ue6id4c","Type":"NodeParagraph","Properties":{"id":"20240613094919-ue6id4c","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【药用】大戟科草本植物泽漆EuphorbiahelioscopiaL.的地上部份。"}]},{"ID":"20240613094919-3cnfv1s","Type":"NodeParagraph","Properties":{"id":"20240613094919-3cnfv1s","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【性味与归经】辛、苦，微寒；有毒。归肺、小肠、大肠经。"}]},{"ID":"20240613094919-foj34pd","Type":"NodeParagraph","Properties":{"id":"20240613094919-foj34pd","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【功效】利水消肿，化痰散结。"}]},{"ID":"20240613094919-o8oamfu","Type":"NodeParagraph","Properties":{"id":"20240613094919-o8oamfu","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于水肿，腹水等症。"}]},{"ID":"20240613094919-c66ygrh","Type":"NodeParagraph","Properties":{"id":"20240613094919-c66ygrh","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"本品苦寒下降，具有较强的利水退肿功效，适用于大腹水肿、面目四肢浮肿，单用有效，也可与白朮、茯苓等药配合同用。"}]},{"ID":"20240613094919-k7ls42o","Type":"NodeParagraph","Properties":{"id":"20240613094919-k7ls42o","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"2.用于瘰历结核、肺热咳嗽、痰饮喘咳等症。"}]},{"ID":"20240613094919-wi6a0ai","Type":"NodeParagraph","Properties":{"id":"20240613094919-wi6a0ai","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"泽漆又有化痰散结的做用。治疗瘰历结核，熬膏内服，如已溃破，行成瘘管，可用鲜草煎膏浸纱布塞入创口。用于肺热咳嗽，咯痰黄稠及痰饮喘咳等症，具有清热化痰、止咳平喘的功效，可单用或配合鱼腥草、矮地茶、黄芩等同用。"}]},{"ID":"20240613094919-ce1qm14","Type":"NodeParagraph","Properties":{"id":"20240613094919-ce1qm14","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"此外，本品又能杀虫，用于癣疮，可用本品捣汁涂患处。"}]},{"ID":"20240613094919-f0zhbmg","Type":"NodeParagraph","Properties":{"id":"20240613094919-f0zhbmg","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【处方用名】泽漆（洗净，晒干，切碎用）"}]},{"ID":"20240613094919-bdt12kp","Type":"NodeParagraph","Properties":{"id":"20240613094919-bdt12kp","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】三钱至五钱，煎服，外用适量。"}]},{"ID":"20240613094919-8yummhz","Type":"NodeParagraph","Properties":{"id":"20240613094919-8yummhz","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"【方剂举例】泽漆汤（《证治准绳》）：泽漆、桑白皮、郁李仁、陈皮、白朮、杏仁、人参。治痢后肿满，气急喘嗽，小便如血。"}]},{"ID":"20240613094919-29naqr9","Type":"NodeParagraph","Properties":{"id":"20240613094919-29naqr9","updated":"20240613094919"},"Children":[{"Type":"NodeText","Data":"Ⅱ号抗痨煎剂（《全国中草药新医疗法展览会技术资料选编》）：泽漆、百部、蒲公英、甘草。治肺结核。"}]},{"ID":"20240613094904-7hm3mz8","Type":"NodeThematicBreak","Properties":{"id":"20240613094904-7hm3mz8"}},{"ID":"20240613094906-npiefhy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094906-npiefhy","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：泽漆"}]},{"ID":"20240613094906-l4whbuc","Type":"NodeParagraph","Properties":{"id":"20240613094906-l4whbuc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613094906-804lz57","Type":"NodeParagraph","Properties":{"id":"20240613094906-804lz57","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" Zé Qī"}]},{"ID":"20240613094906-7tzxej9","Type":"NodeParagraph","Properties":{"id":"20240613094906-7tzxej9","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613094906-sy96r06","Type":"NodeParagraph","Properties":{"id":"20240613094906-sy96r06","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 五朵云、猫眼草、五凤草、灯台草、倒毒伞、烂肠草、绿叶绿花草、五点草"}]},{"ID":"20240613094906-mtlbyvw","Type":"NodeParagraph","Properties":{"id":"20240613094906-mtlbyvw","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613094906-0pwd6jh","Type":"NodeParagraph","Properties":{"id":"20240613094906-0pwd6jh","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 大戟科大戟属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽漆"},{"Type":"NodeText","Data":"Euphorbia helioscopia L.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。春夏采集全草，晒干入药。"}]},{"ID":"20240613094906-8lkmquc","Type":"NodeParagraph","Properties":{"id":"20240613094906-8lkmquc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613094906-c2enyqk","Type":"NodeParagraph","Properties":{"id":"20240613094906-c2enyqk","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 归肺、小肠、大肠经。"}]},{"ID":"20240613094906-gbhrirp","Type":"NodeParagraph","Properties":{"id":"20240613094906-gbhrirp","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613094906-pv0kw07","Type":"NodeParagraph","Properties":{"id":"20240613094906-pv0kw07","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 辛、苦，微寒；有毒。"}]},{"ID":"20240613094906-w94y75l","Type":"NodeParagraph","Properties":{"id":"20240613094906-w94y75l","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613094906-rvuoijc","Type":"NodeParagraph","Properties":{"id":"20240613094906-rvuoijc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 利水消肿，化痰散结，杀虫。用于水肿，肝硬化腹水，细菌性痢疾；外用治淋巴结结核，结核性瘘管，神经性皮炎。并可灭蛆、孑孓。"}]},{"ID":"20240613094906-umtt1x9","Type":"NodeParagraph","Properties":{"id":"20240613094906-umtt1x9","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613094906-cu08sij","Type":"NodeParagraph","Properties":{"id":"20240613094906-cu08sij","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 1～3钱；外用适量，熬膏外涂。"}]},{"ID":"20240613094906-hy7ebzw","Type":"NodeParagraph","Properties":{"id":"20240613094906-hy7ebzw","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613094906-e59o9cf","Type":"NodeParagraph","Properties":{"id":"20240613094906-e59o9cf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" （1）用于大腹水肿、面目四肢浮肿，单用有效，也可与白朮、茯苓等药配合同用。治疗瘰历结核，熬膏内服，如已溃破，行成瘘管，可用鲜草煎膏浸纱布塞入创口。用于肺热咳嗽，咯痰黄稠及痰饮喘咳等症，具有清热化痰、止咳平喘的功效，可单用或配合鱼腥草、矮地茶、黄芩等同用。此外，本品又能杀虫，用于癣疮，可用本品捣汁涂患处。"}]},{"ID":"20240613094906-jblm2ii","Type":"NodeParagraph","Properties":{"id":"20240613094906-jblm2ii","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613094906-yy7am3z","Type":"NodeParagraph","Properties":{"id":"20240613094906-yy7am3z","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613094906-yplk69b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094906-yplk69b","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：泽漆"}]},{"ID":"20240613094906-2n6zr7g","Type":"NodeParagraph","Properties":{"id":"20240613094906-2n6zr7g","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613094906-f8badpl","Type":"NodeParagraph","Properties":{"id":"20240613094906-f8badpl","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" Zé Qī"}]},{"ID":"20240613094906-sfbshq6","Type":"NodeParagraph","Properties":{"id":"20240613094906-sfbshq6","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613094906-fx225tf","Type":"NodeParagraph","Properties":{"id":"20240613094906-fx225tf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 桼茎（《广雅》），猫儿眼睛草、五凤灵枝（《履巉岩本草》），五凤草、绿叶绿花草（《纲目》），凉伞草（《质问本草》），五盏灯、五朵云（《贵州民间方药集》），白种乳草（《福建民间草药》），五点草、五灯头草、乳浆草（《江苏植药志》），肿手棵、马虎眼（《山东中药》），倒毒伞、一把伞（《四川中药志》），乳草（《泉州本草》），龙虎草、铁骨伞（江西《草药手册》）。"}]},{"ID":"20240613094906-dwgrenu","Type":"NodeParagraph","Properties":{"id":"20240613094906-dwgrenu","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613094906-jmlx1ov","Type":"NodeParagraph","Properties":{"id":"20240613094906-jmlx1ov","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613094906-0nrrde8","Type":"NodeParagraph","Properties":{"id":"20240613094906-0nrrde8","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613094906-5zsqsvo","Type":"NodeParagraph","Properties":{"id":"20240613094906-5zsqsvo","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 为大戟科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泽漆"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。4～5月开花时采收，除去根及泥沙，晒干。"}]},{"ID":"20240613094906-036td26","Type":"NodeParagraph","Properties":{"id":"20240613094906-036td26","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613094906-atpkx02","Type":"NodeParagraph","Properties":{"id":"20240613094906-atpkx02","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 生于山沟、路边、荒野、湿地。全国大部分地区均有分布。全国大部分地区均产，以江苏、浙江产量较多。"}]},{"ID":"20240613094906-wpxwvhm","Type":"NodeParagraph","Properties":{"id":"20240613094906-wpxwvhm","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613094906-xjsrh10","Type":"NodeParagraph","Properties":{"id":"20240613094906-xjsrh10","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 二年生草本，高10～30厘米，全株含乳汁。茎无毛或仅小枝略具疏毛，基部紫红色，分枝多。单叶互生；倒卵形或匙形，长1～3厘米，宽5～18毫米，先端钝圆或微凹，基部阔楔形，边缘在中部以上有细锯齿；无柄或突狭而成短柄。杯状聚伞花序顶生，排列成复伞形；伞梗5枝，基部轮生叶状苞片5枚，形同茎叶而较大，每枝再作1～2回分枝，分枝处轮生倒卵形苞叶3枚；花单性，无花被；雄花多数和雌花1枚同生于萼状总苞内，总苞先端4裂，上有肾形腺体；雄花仅有雄蕊1；雌花在花序中央，子房有长柄，3室，柱头3裂。蒴果表面平滑。种于卵圆形，直径1.5毫米，表面有网纹，熟时褐色，花期4～5月。"}]},{"ID":"20240613094906-oy1qdq6","Type":"NodeParagraph","Properties":{"id":"20240613094906-oy1qdq6","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613094906-jh92bgu","Type":"NodeParagraph","Properties":{"id":"20240613094906-jh92bgu","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 干燥全草都切成段状，有时具黄色的肉质主根。根顶部具紧密的环纹，外表具不规则的纵纹，断面白色，木质部成放射状；茎圆柱形，鲜黄色至黄褐色，表面光滑或具不明显的纵纹，有明显的互生、褐色的条形叶痕；叶暗绿色，常皱缩，破碎或脱落；茎顶端具多数小花及灰色的蒴果；总苞片绿色，常破碎。气酸而特异、味淡。以干燥、无根者为佳。"}]},{"ID":"20240613094906-cz6xut3","Type":"NodeParagraph","Properties":{"id":"20240613094906-cz6xut3","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613094906-1u0ofa0","Type":"NodeParagraph","Properties":{"id":"20240613094906-1u0ofa0","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 含槲皮素-5，3-二-D-半乳糖甙、泽漆皂甙、三萜、丁酸、泽漆醇、β-二氢岩藻甾醇，葡萄糖、果糖、麦芽糖等。乳汁含间一羟苯基甘氨酸、3，5-二羟基苯甲酸，干乳汁含橡胶烃（聚萜烯）13％、树脂62％、水溶性物25％。"}]},{"ID":"20240613094906-bus81bp","Type":"NodeParagraph","Properties":{"id":"20240613094906-bus81bp","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"种子含水分7.74％，脂肪油32.61％，蛋白质17.43％，纤维素33.82％，糖及糖甙2.18％。脂肪油是干性油，有峻泻作用。"}]},{"ID":"20240613094906-x659l06","Type":"NodeParagraph","Properties":{"id":"20240613094906-x659l06","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613094906-nb722vl","Type":"NodeParagraph","Properties":{"id":"20240613094906-nb722vl","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 泽漆在试管中对结核杆菌无作用，或谓在很高浓度（1:50～100）时，能抑制结核杆菌的生长；此外并试验了它与链霉素、异烟肼等的协同作用，但因所用浓度过高，实际价值尚待确定。"}]},{"ID":"20240613094906-gqegncj","Type":"NodeParagraph","Properties":{"id":"20240613094906-gqegncj","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"茎叶煎剂5.4克（生药）／公斤灌胃（注射给药，作用不显着），对人工发热家兔有轻度降温作用，根制剂无明显作用，退热作用似与垂体-肾上腺系统无甚关系。根制剂对离体兔耳有血管扩张作用，对离体兔、豚鼠及小鼠肠管有兴奋作用，不能拮抗组织胺对豚鼠的毒性，但能降低毛细血管通透性。本药毒性颇小，小鼠灌胃125克／公斤亦未致死。兔服10～20％泽漆膏水制剂有刺激性。泽漆膏（每克相当生药5克）与蓖麻油（10:1）组成之油膏有预防小鼠感染血吸虫尾蚴的作用。其乳状汁液含刺激性树脂，接触局部可使皮肤发红甚至溃烂，能腐蚀疣。"}]},{"ID":"20240613094906-2xfaa4t","Type":"NodeParagraph","Properties":{"id":"20240613094906-2xfaa4t","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613094906-fim6pye","Type":"NodeParagraph","Properties":{"id":"20240613094906-fim6pye","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 入大、小肠，脾。"}]},{"ID":"20240613094906-g1mndvh","Type":"NodeParagraph","Properties":{"id":"20240613094906-g1mndvh","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"①《得配本草》：\"入手阳明、太阳经气分。\""}]},{"ID":"20240613094906-keaf7oz","Type":"NodeParagraph","Properties":{"id":"20240613094906-keaf7oz","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②《本草撮要》：\"入手足太阴经。\""}]},{"ID":"20240613094906-mkh5pci","Type":"NodeParagraph","Properties":{"id":"20240613094906-mkh5pci","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613094906-4hrn9ut","Type":"NodeParagraph","Properties":{"id":"20240613094906-4hrn9ut","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 辛苦，凉，有毒。"}]},{"ID":"20240613094906-mazsar6","Type":"NodeParagraph","Properties":{"id":"20240613094906-mazsar6","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"苦，微寒。\""}]},{"ID":"20240613094906-oqo7d4s","Type":"NodeParagraph","Properties":{"id":"20240613094906-oqo7d4s","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛，无毒。\""}]},{"ID":"20240613094906-owta3fv","Type":"NodeParagraph","Properties":{"id":"20240613094906-owta3fv","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑧《唐本草》：\"有小毒。\""}]},{"ID":"20240613094906-phmaby9","Type":"NodeParagraph","Properties":{"id":"20240613094906-phmaby9","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613094906-2yd0mml","Type":"NodeParagraph","Properties":{"id":"20240613094906-2yd0mml","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" ①《本草经集注》：\"小豆为之使。恶薯蓣。\""}]},{"ID":"20240613094906-kwp998y","Type":"NodeParagraph","Properties":{"id":"20240613094906-kwp998y","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②《得配本草》：\"气血虚者禁用。\""}]},{"ID":"20240613094906-17zc298","Type":"NodeParagraph","Properties":{"id":"20240613094906-17zc298","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613094906-hx1t7g7","Type":"NodeParagraph","Properties":{"id":"20240613094906-hx1t7g7","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 行水，消痰，杀虫，解毒。治水气肿满，痰饮喘咳，疟疾，菌痢，瘰疬，癣疮，结核性痿管，骨髓炎。"}]},{"ID":"20240613094906-dj9bbgf","Type":"NodeParagraph","Properties":{"id":"20240613094906-dj9bbgf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足。\""}]},{"ID":"20240613094906-g69yf8w","Type":"NodeParagraph","Properties":{"id":"20240613094906-g69yf8w","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"利大小肠，明目。\""}]},{"ID":"20240613094906-th47yan","Type":"NodeParagraph","Properties":{"id":"20240613094906-th47yan","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治人肌热，利小便。\""}]},{"ID":"20240613094906-vivhvfx","Type":"NodeParagraph","Properties":{"id":"20240613094906-vivhvfx","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"④《唐本草》：\"逐水。\""}]},{"ID":"20240613094906-oq77hh0","Type":"NodeParagraph","Properties":{"id":"20240613094906-oq77hh0","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"止疟疾，消痰退热。\""}]},{"ID":"20240613094906-ifxqihb","Type":"NodeParagraph","Properties":{"id":"20240613094906-ifxqihb","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑥《本草备要》：\"止咳，杀虫。\""}]},{"ID":"20240613094906-ffmo4ko","Type":"NodeParagraph","Properties":{"id":"20240613094906-ffmo4ko","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑦《植物名实图考》：\"煎熬为膏，敷无名肿毒。\""}]},{"ID":"20240613094906-wkk94ls","Type":"NodeParagraph","Properties":{"id":"20240613094906-wkk94ls","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑧《贵州民间方药集》：\"内服可除风湿，止疼痛。\""}]},{"ID":"20240613094906-p6lmhm9","Type":"NodeParagraph","Properties":{"id":"20240613094906-p6lmhm9","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑨《四川中药志》：\"治一切恶毒、梅疮。\""}]},{"ID":"20240613094906-hyjbbj8","Type":"NodeParagraph","Properties":{"id":"20240613094906-hyjbbj8","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑩江西《草药手册》：\"治淋巴结结核。\""}]},{"ID":"20240613094906-y9wlksc","Type":"NodeParagraph","Properties":{"id":"20240613094906-y9wlksc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑾《高原中草药治疗手册》：\"治骨髓炎。\""}]},{"ID":"20240613094906-fgu874b","Type":"NodeParagraph","Properties":{"id":"20240613094906-fgu874b","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613094906-22y2q30","Type":"NodeParagraph","Properties":{"id":"20240613094906-22y2q30","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；熬膏或入丸、散。外用：煎水洗、熬膏涂或研末调敷。"}]},{"ID":"20240613094906-epxln9y","Type":"NodeParagraph","Properties":{"id":"20240613094906-epxln9y","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613094906-w82mmnn","Type":"NodeParagraph","Properties":{"id":"20240613094906-w82mmnn","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" ①治水气通身洪肿，四肢无力，喘息不安，腹中响响胀满，眼不得视：泽漆根十两，鲤鱼五斤，赤小豆二升，生姜八两，茯苓三两，人参、麦门冬、甘草各二两。上八味细切，以水一斗七升，先煮鱼及豆，减七升，去滓，内药煮取四升半。一服三合，日三，人弱服二合，再服气下喘止，可至四合。晬时小便利，肿气减，或小溏下。（《千金方》泽漆汤）"}]},{"ID":"20240613094906-0ibrkqf","Type":"NodeParagraph","Properties":{"id":"20240613094906-0ibrkqf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②治水气：泽漆十斤（于夏间拣取嫩叶，入酒一斗，研取汁，约二斗）。上药以慢火熬如稀饧，即止，放瓷器内收。每日空心以温酒调下一茶匙。以愈为度。（《圣惠方》）"}]},{"ID":"20240613094906-xbodm77","Type":"NodeParagraph","Properties":{"id":"20240613094906-xbodm77","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"③治水肿盛满，气急喘嗽，小便涩赤如血者：泽漆叶（微炒）五两，桑根白皮（炙黄，锉）三两，白术一两，郁李仁（汤浸，去皮，炒熟）三两，杏仁（汤浸，去皮、尖、双仁，炒）一两半，陈橘皮（汤浸，去白，炒干）一两，人参一两半。上七味，粗捣筛。每服五钱匕，用水一盏半，生姜一枣大，拍破，煎至八分，去滓温服。以利黄水三升及小便利为度。（《圣济总录》泽漆汤）"}]},{"ID":"20240613094906-v84vr4u","Type":"NodeParagraph","Properties":{"id":"20240613094906-v84vr4u","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"④治肺原性心脏病：鲜泽漆茎叶二两。洗净切碎，加水一斤，放鸡蛋二只煮熟，去壳刺孔，再煮数分钟。先吃鸡蛋后服汤，一日一剂。（江西《草药手册》）"}]},{"ID":"20240613094906-bmwhtvd","Type":"NodeParagraph","Properties":{"id":"20240613094906-bmwhtvd","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑤治心下有物大如杯，不得食者：葶苈二两（熬），大黄二两，泽漆四两。捣筛，蜜丸，和捣千杵。服如梧子大二丸，日三服，稍加。（《补缺肘后方》）"}]},{"ID":"20240613094906-g13shcr","Type":"NodeParagraph","Properties":{"id":"20240613094906-g13shcr","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑥治脚气赤肿，行步作疼：猫儿眼睛草不以多少（锉碎），入鹭鸳藤、蜂窠各等分。每服一两重，水五碗，煎至三碗，趁热熏洗。（《履巉岩本草》）"}]},{"ID":"20240613094906-ffif4h0","Type":"NodeParagraph","Properties":{"id":"20240613094906-ffif4h0","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑦治瘰疬：猫儿眼睛草一、二捆。井水二桶，锅内熬至一桶，去滓澄清，再熬至一碗，瓶收。每以椒、葱、槐枝，煎汤冼疮净，乃搽此膏。（《便民图纂》）"}]},{"ID":"20240613094906-vc9inz7","Type":"NodeParagraph","Properties":{"id":"20240613094906-vc9inz7","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑧治骨髓炎：泽漆、秋牡丹根、铁线莲、蒲公英、紫堇、甘草。煎服。（《高原中草药治疗手册》）"}]},{"ID":"20240613094906-h1f18ve","Type":"NodeParagraph","Properties":{"id":"20240613094906-h1f18ve","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑨治癣疮有虫：猫儿眼睛草，晒干为末，香油调搽。（《卫生易简方》）"}]},{"ID":"20240613094906-qdaag2b","Type":"NodeParagraph","Properties":{"id":"20240613094906-qdaag2b","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑩治神经性皮炎：鲜泽漆白浆敷癣上或用楮树叶捣碎同敷。（《兄弟省市中草药单方验方新医疗法选编》）"}]},{"ID":"20240613094906-qxgihgr","Type":"NodeParagraph","Properties":{"id":"20240613094906-qxgihgr","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑾咳嗽上气、脉沉。用泽漆三斤，加水五斗，煮取一斗五升，去渣，汁中再加半夏半升，紫参、白前、生姜各五两，甘草黄芩、人参、桂心各三两，最后煎成药汁五升。每服五合，一天服三次。"}]},{"ID":"20240613094906-hd2lz18","Type":"NodeParagraph","Properties":{"id":"20240613094906-hd2lz18","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑿心下伏瘕（大如杯，不能进食）。用泽漆四两，大黄、葶苈各三两，捣烂筛细，加蜜成丸，如梧子大。每服二丸，一天服三次。"}]},{"ID":"20240613094906-po9zpqh","Type":"NodeParagraph","Properties":{"id":"20240613094906-po9zpqh","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⒀水所蛊病（按：此病的病象是腹满，湍息、浮肿）。用泽漆晒干，研为末，加枣肉和成丸子，如弹子大。每服二丸，白开水送下。一天服二次。如腹中觉暖、小便通畅，即为服药见效。"}]},{"ID":"20240613094906-54x7upu","Type":"NodeParagraph","Properties":{"id":"20240613094906-54x7upu","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⒁脚气赤肿，走路疼痛。用泽漆鹭鸶藤、蜂窠，等分为末。每取一两，加水五碗煎成三碗，熏洗痛处。"}]},{"ID":"20240613094906-n0g65ug","Type":"NodeParagraph","Properties":{"id":"20240613094906-n0g65ug","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⒂牙痛。用泽漆研为末，开水泡汁漱口。"}]},{"ID":"20240613094906-gqttikn","Type":"NodeParagraph","Properties":{"id":"20240613094906-gqttikn","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⒃瘰疬。用泽漆一、二捆，加水二桶，熬成一桶。去渣，再熬成膏一碗，收存瓶中。用时先以椒、葱、槐枝把患处洗净，然后用膏涂搽，几次之后好可见效。"}]},{"ID":"20240613094906-707vq3t","Type":"NodeParagraph","Properties":{"id":"20240613094906-707vq3t","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⒄癣疮。用泽漆晒干，研为末，调油涂搽。"}]},{"ID":"20240613094906-3jb9gu7","Type":"NodeParagraph","Properties":{"id":"20240613094906-3jb9gu7","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613094906-aod7uxo","Type":"NodeParagraph","Properties":{"id":"20240613094906-aod7uxo","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" ①治疗结核性瘘管"}]},{"ID":"20240613094906-w0zx76p","Type":"NodeParagraph","Properties":{"id":"20240613094906-w0zx76p","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"将猫儿眼睛草洗净，切成小段，煎沸2～3遍，得棕黄色煎汁，过滤，再以文火浓缩成棕黑色流浸膏。用时将膏涂于纱布外敷，每日1次。亦可用流浸膏2～3滴，以10～12毫升蒸馏水稀释后用纱布条浸湿塞入瘘管，日换1次。曾用于颈淋巴结结核，腰、荐椎结核（腹股沟肿块溃破）及腋下淋巴结结核渍破各1例，疗程18～88天，均获治愈。有报道用泽漆膏治疗结核性肛瘘58例，其中单纯性22例，复杂性36例，经手术切开管道，刮除腐败组织后，对较小创面直接均匀涂布，较大创面用泽漆膏纱条敷盖，分别经15～120天的治疗，全部治愈，无1例复发。但浸膏的刺激性较大，可引起不同程度的疼痛，应适当加入镇痛剂；对创面新鲜者用量宜少，对创面腐败而分泌物多者，用量要多。"}]},{"ID":"20240613094906-b43utdg","Type":"NodeParagraph","Properties":{"id":"20240613094906-b43utdg","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②治疗细菌性痢疾"}]},{"ID":"20240613094906-caivk0k","Type":"NodeParagraph","Properties":{"id":"20240613094906-caivk0k","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"㈠浓缩煎剂：取猫儿眼睛草1公斤，洗净切碎，煎煮2次过滤，浓缩至1000毫升，加适量防腐剂。成人每次5毫升，口服3次，儿童酌减。㈡冲剂：每克相当鲜猫儿眼睛草12.9克。成人每次2～3克，日服3次，儿童酌减。共治疗急性菌痢79例，显效44例，有效13例；慢性菌痢急性发作1例，无效；慢性迁延性菌痢2例，显效1例，无效1例。平均体温恢复正常1.55天，便次复常2.17天，腹痛消失2.68天，右下腹压痛消失2.46天，里急后重消失1.97天，大便成形2.7天。实验室抑菌试验证明，猫儿眼睛草浓缩煎剂对痢疾杆菌有一定的抑菌作用，但其效能较合霉素为低。"}]},{"ID":"20240613094906-9k9y8rm","Type":"NodeParagraph","Properties":{"id":"20240613094906-9k9y8rm","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"③治疗食道癌"}]},{"ID":"20240613094906-gjh2zl7","Type":"NodeParagraph","Properties":{"id":"20240613094906-gjh2zl7","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"采用20％泽漆中性皂甙注射液，每日1次，每次2毫升，肌肉注射，15天为1疗程。观察病例按初诊时进食情况分为5级：完全不能进食，能进流汁，半流汁，软饭，普通饭。治疗后进食情况上升一级者为好转，上升二级者为显著好转，能进任何饮食者看作临床治愈。按上述标准观察64例，结果临床治愈10例，显著好转18例，好转30例，无效6例。显效时间一般都在用药后3～5天。但经食道钡餐摄片检查，食道癌肿块的缩小与临床进食情况的改善颇不一致，可能是泽漆中性皂甙能使肿块变软所致。实验室检查未发现溶血现象和肝肾损害，血象亦无异常改变。对巳进行过放射治疗或局部作过活组织检查及使用过局部腐蚀性药物的病人，此药无效。"}]},{"ID":"20240613094906-sf6e96m","Type":"NodeParagraph","Properties":{"id":"20240613094906-sf6e96m","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"④防治流行性腮腺炎"}]},{"ID":"20240613094906-g3l0iv6","Type":"NodeParagraph","Properties":{"id":"20240613094906-g3l0iv6","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"取泽漆1两（干的5钱），加水300毫升，浓煎至150毫升，每次50毫升，日服3次，以愈为度。治疗140例，均于3～7天内治愈，无1例发生合并症。对高烧病孩曾配合一般对症处理。流行期间对密切接触者可试用于预防，一般按上述剂量连服3天。"}]},{"ID":"20240613094906-rzqjxr4","Type":"NodeParagraph","Properties":{"id":"20240613094906-rzqjxr4","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"⑤治疗无黄疸型传染性肝炎"}]},{"ID":"20240613094906-xb9o9wo","Type":"NodeParagraph","Properties":{"id":"20240613094906-xb9o9wo","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"用泽漆制成片剂或膏剂内服。片剂每次6～8片（每片含量0.2克），膏剂每次2克，均每日3次，饭后服。服后宜多饮开水，并休息片刻。25天为一疗程。一般病例一疗程；如病期迁延较久，且肝肿大较著、质地较硬或肝功能有显著变化者则须2～3疗程。共观察100例，经一疗程后痊愈（症状、体征消失，肝功能恢复正常）1例，基本治愈（症状、体征基本消失，肝肿在1厘米以内，肝功能正常）51例，进步（症状、体征有所改善，肝功能基本正常）10例，无变化31例。较对照组（西药）疗效为佳。认为本品对症状消退和改善、肝脾回缩及肝功能恢复具有一定疗效。远期效果尚难肯定，有待观察。治程中部分患者诉口干、多尿，未见其它不良反应。"}]},{"ID":"20240613094906-3zjybuj","Type":"NodeParagraph","Properties":{"id":"20240613094906-3zjybuj","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613094906-fhaef4f","Type":"NodeParagraph","Properties":{"id":"20240613094906-fhaef4f","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" ①《纲目》：\"泽漆利水，功类大戟，故人见其茎有白汁，遂误以为大戟，然大戟根苗皆有毒，泄人，而泽漆根硬不可用，苗亦无毒，可作菜食，而利丈夫阴气盛，不相侔也。\""}]},{"ID":"20240613094906-tkvmtex","Type":"NodeParagraph","Properties":{"id":"20240613094906-tkvmtex","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"②《本草汇言》：\"泽漆，主治功力，与大戟同，较之大戟，泽漆稍和缓，而不甚伤元气也。然性亦喜走泄，如胃虚人亦宜少用。\""}]},{"ID":"20240613094906-gtvxn5g","Type":"NodeParagraph","Properties":{"id":"20240613094906-gtvxn5g","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"③《本草述》：\"泽漆利水，既与大戟相类，然时珍谓大戟泄人，而泽漆之利水，乃更谓其利丈夫阴气，即《本经》亦云治丈夫阴气不足。《经》云：水者，阴气也。注云：邪水之阴，非真阴也，即此思之，如他味之利水者，又岂非行邪水平?而真阴未能不伤。独此云行邪水而真阴反以受益也，是遵何故哉?愚阅方书之用兹味，唯水肿上气与痢后浮肿，然观其必与白术、桑白皮、郁李仁同用，则必有以为益脾之助，而化气开结者，亦兹物相助为理，尤借其前导以为功耳。即治痢后肿满，气急喘咳，小便如血，逐诸队且同参、术以行之，则其非瞑眩之剂可知。治水之用，此味其善物哉。\""}]},{"ID":"20240613094906-w4cd44t","Type":"NodeParagraph","Properties":{"id":"20240613094906-w4cd44t","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"④《长沙药解》：\"泽漆，苦寒之性，长于泄水，故能治痰饮阻格之咳。\""}]},{"ID":"20240613094906-v4ju7tx","Type":"NodeParagraph","Properties":{"id":"20240613094906-v4ju7tx","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613094906-u2kgyoj","Type":"NodeParagraph","Properties":{"id":"20240613094906-u2kgyoj","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 泽漆是利水的名药，功效很象大戟，但泽漆的茎叶煮熟之后便没有毒，因此更宜推广利用。"}]},{"ID":"20240613094906-yob4p1t","Type":"NodeParagraph","Properties":{"id":"20240613094906-yob4p1t","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613094906-7tmwftf","Type":"NodeParagraph","Properties":{"id":"20240613094906-7tmwftf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613094906-03awfsw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613094906-03awfsw","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"《中华本草》：泽漆"}]},{"ID":"20240613094906-509052c","Type":"NodeParagraph","Properties":{"id":"20240613094906-509052c","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613094906-tekj8t1","Type":"NodeParagraph","Properties":{"id":"20240613094906-tekj8t1","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" Zé Qī"}]},{"ID":"20240613094906-ijemwp0","Type":"NodeParagraph","Properties":{"id":"20240613094906-ijemwp0","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613094906-ftw9itu","Type":"NodeParagraph","Properties":{"id":"20240613094906-ftw9itu","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 漆茎、猫儿眼睛草、五风灵枝、五风草、绿叶绿花草、凉伞草、五盏灯、五朵云、白种乳草、五点草、五灯头草、乳浆草、肿手棵、马虎眼、倒毒伞、一把伞、乳草、龙虎草、铁骨伞、九头狮子草、灯台草、癣草。"}]},{"ID":"20240613094906-300fcog","Type":"NodeParagraph","Properties":{"id":"20240613094906-300fcog","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613094906-yjhbe46","Type":"NodeParagraph","Properties":{"id":"20240613094906-yjhbe46","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" Sun Euphorbia Herb, Herb of Sun Euphorbia"}]},{"ID":"20240613094906-85unji5","Type":"NodeParagraph","Properties":{"id":"20240613094906-85unji5","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613094906-ddl02cq","Type":"NodeParagraph","Properties":{"id":"20240613094906-ddl02cq","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。《纲目》：《别录》、陶氏皆言泽漆是大戟苗，《日华子》又言是大戟花，其苗可食，然大戟苗泄人，不可为菜。今考《土宿本草》及《宝藏论》诸书，并云泽漆是猫儿眼睛草，江湖原泽平陆多有之。春生苗，一科分枝成丛，柔茎如马齿苋，绿叶如苜宿叶；叶圆而黄绿，颇似猫睛，故名猫儿眼。茎头凡五叶，中分，中抽小茎五枝，每枝开细花，青绿色，复有小叶承之，齐整如一，故又名五凤草、绿叶绿花草。梢茎有白汁粘人，其"}]},{"ID":"20240613094906-d88kh5h","Type":"NodeParagraph","Properties":{"id":"20240613094906-d88kh5h","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613094906-uli95vx","Type":"NodeParagraph","Properties":{"id":"20240613094906-uli95vx","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 药材基源：为大戟科植物泽漆的全草。"}]},{"ID":"20240613094906-m4dhooq","Type":"NodeParagraph","Properties":{"id":"20240613094906-m4dhooq","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Euphorbia helioscopia L."}]},{"ID":"20240613094906-eki5u41","Type":"NodeParagraph","Properties":{"id":"20240613094906-eki5u41","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"采收和储藏：4-5月开花时采收，除去根及泥沙，晒干。"}]},{"ID":"20240613094906-0bqcpvd","Type":"NodeParagraph","Properties":{"id":"20240613094906-0bqcpvd","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613094906-gldf2fo","Type":"NodeParagraph","Properties":{"id":"20240613094906-gldf2fo","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于山沟、路边、荒野及湿地。"}]},{"ID":"20240613094906-5cyue7k","Type":"NodeParagraph","Properties":{"id":"20240613094906-5cyue7k","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"资源分布：我国除西藏外，各地均有分布。"}]},{"ID":"20240613094906-zo0py2g","Type":"NodeParagraph","Properties":{"id":"20240613094906-zo0py2g","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613094906-nlzt8m7","Type":"NodeParagraph","Properties":{"id":"20240613094906-nlzt8m7","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 泽漆 一年生或二年生草本，高10-30cm。全株含白色乳汁。茎丛生，基部斜升，无毛或仅分枝略具疏毛，基部紫红色，上部淡绿色。叶互生；无柄或因突然狭窄而具短柄；叶片倒卵形或匙形，长1-3cm，宽0.5-1.8cm，先端钝圆，有缺刻或细锯齿，基部楔形，两面深绿色或灰绿色，被疏长毛，下部叶小，开花后渐脱落。杯状聚伞花序项生，伞梗5，每伞梗再分生2-3小便，每个伞梗又第三回分裂为2叉，伞便基部具5片轮生叶状苞片，与下部叶同形而较大；总苞杯状，先瑞4浅裂，裂片钝，腺体4，盾形，黄绿色；雄花10余朵，每花具雄蕊1，下有短柄，花药歧出，球形；雌花1，位于花序中央；子房有长柄，伸出花序之外；子房3室；花柱3，柱头2裂。蒴果球形，直径约3mm，3裂，光滑。种子褐色，卵形，长约2mm，有明显凸起网纹，具白色半圆形种阜。花期4-5月，果期5-8月。"}]},{"ID":"20240613094906-6zex5qp","Type":"NodeParagraph","Properties":{"id":"20240613094906-6zex5qp","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613094906-fingtn9","Type":"NodeParagraph","Properties":{"id":"20240613094906-fingtn9","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 全草长约30cm，茎光滑无毛，多分枝，表面黄绿色，基部呈紫红色，具纵纹，质脆。叶互生，无柄，倒卵形或匙形，长1-3cm，宽0.5-1.8cm，先端钝圆或微凹，基部广楔形或突然狭窄，边缘在中部以上具锯齿；茎顶部具5片轮生叶状苞，与下部叶相似。多歧聚伞花序顶生，有伞梗；杯状花序钟形，黄绿色。蒴果无毛。种子卵形，表面有凸起网纹。气酸而特异，味淡。以茎粗壮、黄绿色者为佳。"}]},{"ID":"20240613094906-8xm96kk","Type":"NodeParagraph","Properties":{"id":"20240613094906-8xm96kk","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：表皮一列细胞，切向延长，外被角质层。皮层为数列薄壁细胞，切向延长，细胞皱缩。韧皮部狭窄，细胞皱缩。柱鞘纤维由一至十数个纤维组成一束，作切向多单列断续排列或成环，壁木化。形成层不明显。木质部宽广，由导管、纤维、木薄壁细胞组成；导管单列放射状排列；射线细胞呈类方形、长方形、矩形，排列整齐。髓部多中空。近髓部导管细小为螺纹孔。"}]},{"ID":"20240613094906-hmtzhzt","Type":"NodeParagraph","Properties":{"id":"20240613094906-hmtzhzt","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"粉末特征：淡黄绿色。①纤维众多，多成束，稀有单个散在，直径15-35μm，木化，有的具单纹孔、螺纹；②具线纹孔、网纹孔导管，直径25-40μm。③叶表皮细胞类多角形，内含有细小的方晶或短棒状草酸钙结晶。"}]},{"ID":"20240613094906-wl4odzo","Type":"NodeParagraph","Properties":{"id":"20240613094906-wl4odzo","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613094906-p6ez5mc","Type":"NodeParagraph","Properties":{"id":"20240613094906-p6ez5mc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 本药毒性颇小，小鼠灌胃125g/kg亦未致死。兔服10-20%泽漆膏水制剂有刺激性。泽漆膏（每克相当生药5g）与蓖麻油（10∶1）组成之油膏有预防小鼠感染血吸虫尾蚴的作用。其乳状汁液含刺激性树脂，接触局部可使皮肤发红甚至溃烂，能腐蚀疣。"}]},{"ID":"20240613094906-mdc0w26","Type":"NodeParagraph","Properties":{"id":"20240613094906-mdc0w26","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613094906-hpfh4ei","Type":"NodeParagraph","Properties":{"id":"20240613094906-hpfh4ei","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 含概皮素-5，3-二-D-半乳糖甙（quercetin-5，3-di-D-galactoside），菜五凝血素（phasin），丁酸（butyric acid），泽漆醇（helioscopiol），β-二氧岩藻甾醉（β-dihydrofucosterol），葡萄糖，果糖，麦芽糖，槲皮素（quercetin），槲皮素-3-双半乳糖甙（heliosin），金丝桃甙（hyperin），没食子酸（gallic acid），琥珀酸（succinic acid），泽漆双环氧萜（euphohelin） A、B、C、D、E，大戟甙（euphornin）A、B、C、D、E、F、G、H、I、J、K，泽漆萜（euphoscopin）A、B、C、D、E、F、G、H、I、J、K、L，泽漆内酯（helioscopinolide） A、B、C，泽漆环氧萜（euphohelionone），表泽漆萜（epieuphoscopin）A、B、C、D、F，泽漆三环萜（euphoheliscopin）A、B，泽漆鞣质（helioscopinin）A、B泽漆新鞣质（helioscopin）A、B，鞣云实精（corilagin），石榴叶鞣质（punicafolin），老鹳草鞣质（geraniin），杜英鞣质（elaeocarpusin），夫罗星鞣质（furosin），原河子酸（terchebin），野梧桐鞣质灵（mauotusinin），鹅耳枥鞣质（carpinusin），泽漆平新鞣质（euphorscopin），泽漆灵新鞣质（e-uphorhelin），1-O-没食子酰-β-D-葡萄糖（1-O-galloyl-β-D-glucose），1，6-二-O-没食子酰-β-D-葡萄糖（1，6-di-O-galloyl-β-D-glucose），l，2，6-三-O-没食子酰-β-D-葡萄糖（1，2，6-tri-O-galloyl-β-D-glu-cose），1，2，3,6-四-O-没食子酰-β-D-葡萄糖（1，2，3，6-tetra-O-gal-loyl-β-D-glucose），1，3，4，6-四-O-没食子酸β-D-葡萄糖（1，3，4，6－tetra-O-galloyl-β-D-glucose），l，2，3，4，6-五-O-没食子酰-β-D-葡萄糖（1，2，3，4，6-penta-O-galloyl-β-D-glucose），三十一烷（hen-triacontane），二十八烷（octacosane），二十六醇（hexacosanol），二十八醇（ocatacosanol），十六烷酸（hexadecanioc acid），β-谷甾醇（β-sitosterol），羽扇豆醇（lupeol），乙酸羽扇豆醉酯（lupeol acetate），乳汁含间一羟苯基甘氨酸（m-hydroxyphenylglycine），3，5-二羟基苯甲酸（3，5-dihydroxybenzoic acid），干乳汁含橡胶烃（聚萜烯）13％，树脂62％，水溶性物25％。种子含水分7.74％，脂肪油32.61％，蛋白质17.43％，纤维素33.82％，糖及糖式2.18％。种子油含脂肪酸成分：软脂酸（palmitic acid），花生酸（arachidic acid），油酸（oleic acid），亚油酸（linoleic acid），山萮酸（behenic acid）。"}]},{"ID":"20240613094906-fr2xxh9","Type":"NodeParagraph","Properties":{"id":"20240613094906-fr2xxh9","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613094906-yglkhn7","Type":"NodeParagraph","Properties":{"id":"20240613094906-yglkhn7","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 泽漆在试管中对结核杆菌无作用，或谓在很高浓度（1∶50-100）时，能抑制结核杆菌的生长；此外并试验了它与链霉素、异烟肼等的协同作用，但因所用浓度过高，实际价值尚待确定。茎叶煎剂5.4g（生药）/kg灌胃（注射给药，作用不显着），对人工发热家兔有轻度降温作用，根制剂无明显作用，退热作用似与垂体－肾上腺系统无甚关系。根制剂对离体兔耳有血管扩张作用，对离体兔、豚鼠及小鼠肠管有兴奋作用，不能拮抗组织胺对豚鼠的毒性，但能降低毛细血管通透性。"}]},{"ID":"20240613094906-wx6h9ll","Type":"NodeParagraph","Properties":{"id":"20240613094906-wx6h9ll","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613094906-r9cj7ba","Type":"NodeParagraph","Properties":{"id":"20240613094906-r9cj7ba","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 理化鉴别 取本品粉末2g，加甲醇20ml，加热回流10min，趁热滤过，滤液蒸干，残渣加沸水10ml，溶解后，趁热滤过，滤液照下述方法试验：①取滤液2ml，加镁粉少许与盐酸4-5滴，加热数分钟，显樱红色。（检查黄酮）②取滤液1滴，点于滤纸上，喷以1％三氯化铝甲醇溶液，干后置紫外光灯（365nm）下观察，显黄绿色荧光斑点。（检查黄酮）"}]},{"ID":"20240613094906-nfdjxa6","Type":"NodeParagraph","Properties":{"id":"20240613094906-nfdjxa6","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613094906-8hb2vx4","Type":"NodeParagraph","Properties":{"id":"20240613094906-8hb2vx4","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 大肠；小肠；脾；肺经"}]},{"ID":"20240613094906-waoe55z","Type":"NodeParagraph","Properties":{"id":"20240613094906-waoe55z","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613094906-v8awrce","Type":"NodeParagraph","Properties":{"id":"20240613094906-v8awrce","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 味辛；苦；性微寒；有毒"}]},{"ID":"20240613094906-m64cicw","Type":"NodeParagraph","Properties":{"id":"20240613094906-m64cicw","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613094906-nnh14dn","Type":"NodeParagraph","Properties":{"id":"20240613094906-nnh14dn","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 《得配本草》：气血虚者禁用。"}]},{"ID":"20240613094906-ujmmkbf","Type":"NodeParagraph","Properties":{"id":"20240613094906-ujmmkbf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613094906-edxir01","Type":"NodeParagraph","Properties":{"id":"20240613094906-edxir01","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 行水消肿；化痰止咳；解毒杀虫。主治水气肿满；痰饮喘咳疟疾；菌痢；瘰疬；结核性瘘管；骨髓炎"}]},{"ID":"20240613094906-1rrdtuo","Type":"NodeParagraph","Properties":{"id":"20240613094906-1rrdtuo","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613094906-1qw127t","Type":"NodeParagraph","Properties":{"id":"20240613094906-1qw127t","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，3-9g；或熬膏，入丸、散用。外用：适量，煎水洗；熬膏涂或研末调敷。"}]},{"ID":"20240613094906-3eg8brx","Type":"NodeParagraph","Properties":{"id":"20240613094906-3eg8brx","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613094906-gus6qf6","Type":"NodeParagraph","Properties":{"id":"20240613094906-gus6qf6","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 泽漆汤《金匮要略》；泽漆汤《圣济总录》；泽漆汤《备急千金要方》；泽漆散《太平圣惠方》"}]},{"ID":"20240613094906-udpxqba","Type":"NodeParagraph","Properties":{"id":"20240613094906-udpxqba","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613094906-q9qlhoq","Type":"NodeParagraph","Properties":{"id":"20240613094906-q9qlhoq","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 1.《纲目》：泽漆利水，功类大戟，故人见其茎有白汁，遂误以为大戟，然大戟根苗皆有毒，泄人，而泽漆根硬不可用，苗亦无毒，可作菜食，而利丈夫阴气盛，不相侔也。"}]},{"ID":"20240613094906-fsn7rbl","Type":"NodeParagraph","Properties":{"id":"20240613094906-fsn7rbl","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"2.《长沙药解》：泽漆，苦寒之性，长于泄水，故能治痰饮阻格之咳。"}]},{"ID":"20240613094906-7lilss5","Type":"NodeParagraph","Properties":{"id":"20240613094906-7lilss5","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"3．《本经》：主皮肤热，大腹水气，四肢面目浮肿，丈夫阴气不足。"}]},{"ID":"20240613094906-vx5514s","Type":"NodeParagraph","Properties":{"id":"20240613094906-vx5514s","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"4.《别录》：利大小肠，明目。"}]},{"ID":"20240613094906-xbyak5y","Type":"NodeParagraph","Properties":{"id":"20240613094906-xbyak5y","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"5．《药性论》：治人肌热，利小便。"}]},{"ID":"20240613094906-11odoqd","Type":"NodeParagraph","Properties":{"id":"20240613094906-11odoqd","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"6.《唐本草》：逐水。"}]},{"ID":"20240613094906-hdc9tyc","Type":"NodeParagraph","Properties":{"id":"20240613094906-hdc9tyc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"7.《日华子本草》：止疟疾，消痰退热。"}]},{"ID":"20240613094906-fgquivf","Type":"NodeParagraph","Properties":{"id":"20240613094906-fgquivf","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"8.《本草备要》：止咳，杀虫。"}]},{"ID":"20240613094906-fhs2z8i","Type":"NodeParagraph","Properties":{"id":"20240613094906-fhs2z8i","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"9.《植物名实图考》：煎熬为膏，敷无名肿毒。"}]},{"ID":"20240613094906-fu2p2hb","Type":"NodeParagraph","Properties":{"id":"20240613094906-fu2p2hb","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"10.《贵州民间方药集》：内服可除风湿，止疼痛。"}]},{"ID":"20240613094906-bnapmxh","Type":"NodeParagraph","Properties":{"id":"20240613094906-bnapmxh","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"11.《四川中药志》；治一切恶毒、梅疮。"}]},{"ID":"20240613094906-70yfhec","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613094906-70yfhec","updated":"20240613094906"},"Children":[{"ID":"20240613094906-2uaimb0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTIu","Num":12},"Properties":{"id":"20240613094906-2uaimb0","updated":"20240613094906"},"Children":[{"ID":"20240613094906-tm87w7l","Type":"NodeParagraph","Properties":{"id":"20240613094906-tm87w7l","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"江西《草药手册》：治淋巴结结核。"}]}]}]},{"ID":"20240613094906-vrt1z7q","Type":"NodeParagraph","Properties":{"id":"20240613094906-vrt1z7q","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"13.《高原中草药治疗手册》：治骨髓炎。"}]},{"ID":"20240613094906-6n7mjyx","Type":"NodeParagraph","Properties":{"id":"20240613094906-6n7mjyx","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613094906-kql1xkc","Type":"NodeParagraph","Properties":{"id":"20240613094906-kql1xkc","updated":"20240613094906"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613094907-e0lnpsq","Type":"NodeThematicBreak","Properties":{"id":"20240613094907-e0lnpsq"}},{"ID":"20240613094908-v7g6i1u","Type":"NodeParagraph","Properties":{"id":"20240613094908-v7g6i1u"}}]}