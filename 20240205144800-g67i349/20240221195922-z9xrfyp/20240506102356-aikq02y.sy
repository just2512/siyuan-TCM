 606px;\" parent-style=\"width: 616px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823100622-0hqifs5","Type":"NodeParagraph","Properties":{"id":"20240823100622-0hqifs5","updated":"20240823100622"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 616px;","style":"width: 606px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 3-20240823091025-7dkh45h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 606px;\" parent-style=\"width: 616px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 616px;","style":"width: 606px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鸡骨常山"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鸡骨常山-20240823093211-g8pua1l.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 606px;\" parent-style=\"width: 616px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823100622-jlh6l4w","Type":"NodeParagraph","Properties":{"id":"20240823100622-jlh6l4w","updated":"20240823101026"},"Children":[{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 501px;","style":"width: 491px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山6-20240628152638-60j8sbu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 491px;\" parent-style=\"width: 501px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 357px;","style":"width: 347px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 6-20240823091331-m0gow9n.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 347px;\" parent-style=\"width: 357px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 329px;","style":"width: 319px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 5-20240823091145-v83x7ef.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 319px;\" parent-style=\"width: 329px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612195337-lps8jz2","Type":"NodeParagraph","Properties":{"id":"20240612195337-lps8jz2","updated":"20240823100402"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：恒山（常山）用的是根；"}]},{"ID":"20240612195337-kmvdilh","Type":"NodeThematicBreak","Properties":{"id":"20240612195337-kmvdilh"}},{"ID":"20240612195339-zmfi2gf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195339-zmfi2gf","updated":"20240612195348"},"Children":[{"Type":"NodeText","Data":"恒山《神农本草经》"}]},{"ID":"20240612195339-yc22i2m","Type":"NodeParagraph","Properties":{"id":"20240612195339-yc22i2m","updated":"20240612195339"},"Children":[{"Type":"NodeText","Data":"（旧作常山，《御览》作恒山，是）"}]},{"ID":"20240612195339-qm36od3","Type":"NodeParagraph","Properties":{"id":"20240612195339-qm36od3","updated":"20240612195339"},"Children":[{"Type":"NodeText","Data":"味苦寒。主伤寒，寒热，热发温疟，鬼毒，胸中痰结吐逆。一名互草。生川谷。"}]},{"ID":"20240612195339-7to7mck","Type":"NodeParagraph","Properties":{"id":"20240612195339-7to7mck","updated":"20240612195339"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：恒山，一名漆叶，神农岐伯苦，李氏大寒，桐君辛有毒，二月八月采。"}]},{"ID":"20240612195339-2gq8rcg","Type":"NodeParagraph","Properties":{"id":"20240612195339-2gq8rcg","updated":"20240612195339"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生盖州及汉中，八月采根，阴干。"}]},{"ID":"20240612195339-zcubp1n","Type":"NodeParagraph","Properties":{"id":"20240612195339-zcubp1n","updated":"20240612195339"},"Children":[{"Type":"NodeText","Data":"案后汉书华陀《传》云：陀授以漆叶青黏散，漆叶屑一斗，青黏十四两，以是为率，言久服去三虫，利五脏，轻体，使人头不白。"}]},{"ID":"20240612195421-yx2a4mi","Type":"NodeThematicBreak","Properties":{"id":"20240612195421-yx2a4mi"}},{"ID":"20240612195422-n2sks2a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195422-n2sks2a","updated":"20240612195428"},"Children":[{"Type":"NodeText","Data":"恒山《神农本草经赞》"}]},{"ID":"20240612195422-xzgwzts","Type":"NodeParagraph","Properties":{"id":"20240612195422-xzgwzts","updated":"20240612195422"},"Children":[{"Type":"NodeText","Data":"味苦寒。主伤寒。寒热。热发温疟鬼毒。胸中痰结。吐逆。一名互草。生山谷。（今名常山）药以山名。俨尊北岳。横节圆茎。白花青萼。就燥阳。流湿阴浊。鸡骨浮黄。功专已疟。"}]},{"ID":"20240612195422-b0uxf55","Type":"NodeParagraph","Properties":{"id":"20240612195422-b0uxf55","updated":"20240612195422"},"Children":[{"Type":"NodeText","Data":"李时珍曰。恒山乃北岳名。岂此药始产于此欤。苏恭曰。茎圆有节。二月生白花青萼。"}]},{"ID":"20240612195422-5lzi5aj","Type":"NodeParagraph","Properties":{"id":"20240612195422-5lzi5aj","updated":"20240612195422"},"Children":[{"Type":"NodeText","Data":"其草暴燥。色青白堪用。若遇阴便黑烂郁坏。易。水流湿。火就燥。陶弘景曰。细实黄者。谓之鸡骨。用之最胜。苏颂曰。此药为治疟之最要者。"}]},{"ID":"20240612195507-kwihd9u","Type":"NodeThematicBreak","Properties":{"id":"20240612195507-kwihd9u"}},{"ID":"20240612195508-sitc2cn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195508-sitc2cn","updated":"20240612195514"},"Children":[{"Type":"NodeText","Data":"恒山《千金翼方》"}]},{"ID":"20240612195508-lodwujm","Type":"NodeParagraph","Properties":{"id":"20240612195508-lodwujm","updated":"20240612195508"},"Children":[{"Type":"NodeText","Data":"味苦辛，寒，微寒，有毒。主伤寒寒热，热发温疟，鬼毒，胸中痰结吐逆。疗鬼蛊，往来水胀，洒洒恶寒，鼠 。一名互草。生益州川谷及汉中，八月采根阴干。"}]},{"ID":"20240612195447-4nvijtc","Type":"NodeThematicBreak","Properties":{"id":"20240612195447-4nvijtc"}},{"ID":"20240612195437-w57uwji","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195437-w57uwji","updated":"20240612195441"},"Children":[{"Type":"NodeText","Data":"恒山《本草经集注》"}]},{"ID":"20240612195437-d0ggzz5","Type":"NodeParagraph","Properties":{"id":"20240612195437-d0ggzz5","updated":"20240612195437"},"Children":[{"Type":"NodeText","Data":"味苦、辛，寒、微寒，有毒。主治伤寒寒热，热发温疟，鬼毒，胸中痰结吐逆。治鬼蛊往来，水胀，洒洒恶寒，鼠 。一名互草。生益州川谷及汉中。八月采根，阴干。（畏玉札。）"}]},{"ID":"20240612195437-dzsal3v","Type":"NodeParagraph","Properties":{"id":"20240612195437-dzsal3v","updated":"20240612195437"},"Children":[{"Type":"NodeText","Data":"出宜都、建平，细实黄者，呼为鸡骨恒山，用最胜。"}]},{"ID":"20240612195340-l532hic","Type":"NodeThematicBreak","Properties":{"id":"20240612195340-l532hic"}},{"ID":"20240612195357-mbzqnot","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195357-mbzqnot","updated":"20240612195401"},"Children":[{"Type":"NodeText","Data":"恒山《名医别录》"}]},{"ID":"20240612195357-pyyamwz","Type":"NodeParagraph","Properties":{"id":"20240612195357-pyyamwz","updated":"20240612195357"},"Children":[{"Type":"NodeText","Data":"味辛，微寒，有毒．主治鬼蛊往来，水胀，洒洒恶寒，鼠 ．生益州及汉中．八月采阴干．（畏玉札．）"}]},{"ID":"20240612195357-xkhwm7f","Type":"NodeParagraph","Properties":{"id":"20240612195357-xkhwm7f","updated":"20240612195357"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶恒山，味苦，寒．主伤寒寒热，热发温疟鬼毒，胸中痰结吐逆．一名互草．生川谷．"}]},{"ID":"20240612195402-kd8k19j","Type":"NodeThematicBreak","Properties":{"id":"20240612195402-kd8k19j"}},{"ID":"20240612195409-gwg3yht","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195409-gwg3yht","updated":"20240612195414"},"Children":[{"Type":"NodeText","Data":"恒山《新修本草》"}]},{"ID":"20240612195409-j62z24l","Type":"NodeParagraph","Properties":{"id":"20240612195409-j62z24l","updated":"20240612195409"},"Children":[{"Type":"NodeText","Data":"味苦、辛，寒、微寒，有毒。主伤寒寒热，热发温疟，鬼毒，胸中痰结吐逆。疗鬼蛊往来，水胀，洒洒恶寒，鼠 。"}]},{"ID":"20240612195409-tzw4mfb","Type":"NodeParagraph","Properties":{"id":"20240612195409-tzw4mfb","updated":"20240612195409"},"Children":[{"Type":"NodeText","Data":"一名互草。生益州川谷及汉中。八月采根，阴干。"}]},{"ID":"20240612195409-l27q630","Type":"NodeParagraph","Properties":{"id":"20240612195409-l27q630","updated":"20240612195409"},"Children":[{"Type":"NodeText","Data":"畏玉札。出宜都、建平，细实黄者，呼为鸡骨恒山，用最胜。"}]},{"ID":"20240612195409-0lh4qnf","Type":"NodeParagraph","Properties":{"id":"20240612195409-0lh4qnf","updated":"20240612195409"},"Children":[{"Type":"NodeText","Data":"〔谨案〕恒山叶似茗狭长，茎花，青萼。五月结实，青圆。三子为房。生山谷间，高者不过三、四尺。"}]},{"ID":"20240612195409-4kbvmxd","Type":"NodeThematicBreak","Properties":{"id":"20240612195409-4kbvmxd"}},{"ID":"20240612195616-n560cw7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195616-n560cw7","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"常山《本草崇原》"}]},{"ID":"20240612195616-dt6w7j2","Type":"NodeParagraph","Properties":{"id":"20240612195616-dt6w7j2","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"气味苦寒，有毒。主治伤寒寒热，热发温疟，鬼毒，胸中痰结，吐逆。"}]},{"ID":"20240612195616-wdgvdp3","Type":"NodeParagraph","Properties":{"id":"20240612195616-wdgvdp3","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"（常山又名恒山，出益州及汉中，今汴西、淮浙、湖南州郡皆有。生山谷间，茎高三四尺，圆而有节，其叶似茗，两两相对，二月作白花，青萼，五月结实青圆。常山者，根之名也。"}]},{"ID":"20240612195616-k9rmc25","Type":"NodeParagraph","Properties":{"id":"20240612195616-k9rmc25","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"状似荆根，细实而黄者，谓之鸡骨常山，用之最胜，其苗别名蜀漆。古时根苗皆入药用，今时但用常山，不用蜀漆，犹之赤箭、天麻，但用天麻，无有用赤箭者，盖以其苗不复远市耳。）"}]},{"ID":"20240612195616-28ma733","Type":"NodeParagraph","Properties":{"id":"20240612195616-28ma733","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"恒山，北岳也。后以汉文帝讳恒，遂改名常山。此草名常山，亦名恒山。李时珍疑其始出于常山，故得此名，余以此思常山之草，盖禀西北金水之化而气出于东南。主治伤寒之寒热者，从西北之阴而外出于阳也。热发温疟者，乃先发热之温疟。温疟病藏于肾，常山从西北而出于东南，则温疟可治也。神气乃浮，则鬼毒自散。阳气外行，则胸中痰结自消，痰结消而吐逆亦平矣。"}]},{"ID":"20240612195616-qum57xv","Type":"NodeParagraph","Properties":{"id":"20240612195616-qum57xv","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"愚按∶伤寒寒热，言伤寒之病，先寒后热也。热发温疟，言温疟之病，先热发而后寒也。"}]},{"ID":"20240612195616-q69xi7f","Type":"NodeParagraph","Properties":{"id":"20240612195616-q69xi7f","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"言不尽意，以意会之。"}]},{"ID":"20240612195616-385c9j1","Type":"NodeParagraph","Properties":{"id":"20240612195616-385c9j1","updated":"20240612195616"},"Children":[{"Type":"NodeText","Data":"《阴阳离合论》云∶圣人南面而立，前曰广明，后曰太冲，太冲之地，名曰少阴，少阴之上，名曰太阳，是太阳之气根于少阴，主于肤表。常山从少阴而达太阳之气以外出，所谓因于寒，欲如运枢，起居如惊，神气乃浮者，是也。"}]},{"ID":"20240612195617-9gj8a02","Type":"NodeThematicBreak","Properties":{"id":"20240612195617-9gj8a02"}},{"ID":"20240612195625-xpcvga6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195625-xpcvga6","updated":"20240612195632"},"Children":[{"Type":"NodeText","Data":"常山《本草述钩元》"}]},{"ID":"20240612195625-qp9j09p","Type":"NodeParagraph","Properties":{"id":"20240612195625-qp9j09p","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"苗名蜀漆。功用相同。"}]},{"ID":"20240612195625-48fm9eh","Type":"NodeParagraph","Properties":{"id":"20240612195625-48fm9eh","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"气味苦辛寒。有毒。主治伤寒寒热。热发温疟。劫痰截疟。逐老痰积饮。散山岚瘴气。"}]},{"ID":"20240612195625-pxtsi1m","Type":"NodeParagraph","Properties":{"id":"20240612195625-pxtsi1m","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"蜀漆"}]},{"ID":"20240612195625-imecckm","Type":"NodeParagraph","Properties":{"id":"20240612195625-imecckm","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"气味辛苦。纯阳有毒。生用则上行。必吐。酒蒸炒熟则气少缓。少用亦不致吐。"}]},{"ID":"20240612195625-44aq9wj","Type":"NodeParagraph","Properties":{"id":"20240612195625-44aq9wj","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"治疟及咳逆寒热。腹中坚痞。瘕聚邪气。破血。洗去腥。与苦酸同用。导胆邪。（洁古）岭南瘴气。寒热所感。多在营卫皮肉之间。欲去皮肤毛孔中瘴气根本。非常山不可。但性吐人。惟以七宝散冷服之。即不吐。且验也。（李斋）疟家痰涎黄水。或停潴心下。或结胁间。乃生寒热。法当用常山吐逐。水在上焦。常山能吐之。水在胁下。常山能破其而下其水。但须行血药品佐助之。乃收十全之功。其有纯热发疟。或蕴热内实之证。投以常山。大便点火与盖无客于助。"}]},{"ID":"20240612195625-esah0nf","Type":"NodeParagraph","Properties":{"id":"20240612195625-esah0nf","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"秘方。用清和丸如〔论〕经曰。夏伤于暑。秋为。疟。盖谓暑热郁于经络之内。入秋而束以风寒。阴阳相尤多。"}]},{"ID":"20240612195625-2u4h0bf","Type":"NodeParagraph","Properties":{"id":"20240612195625-2u4h0bf","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"为虚为治暑疟损庵治于阳而热已。是大法之不可易者也络之内。故不能即已。惟开其郁而行而经络乃大畅也。至于病在阴分然后作表汗而解。然则以苦甘寒升发。必其前未用。或更伤其胃气阴得阳之升而出尔。若未至于下陷色。知为暑伤血分。用四物加苦辛寒药。二日发唇疮而愈。是后耳。即补胃之剂。又岂得漫投于留邪未动之会乎。缪氏言确论也。丹溪又曰。若取汗而不得汗。理血而汗不足。必更求切使之离于阴阳而霍然以去。盖论药至恰中病情之处。即补益亦常山劫剂。而倚为无上妙品乎。其亦不学之甚矣。或曰。无痰治痰之药。自有应节而投。如缪氏法治之累效者。又何须是物积饮。形气充实之病为得耳。"}]},{"ID":"20240612195625-spzxoq2","Type":"NodeParagraph","Properties":{"id":"20240612195625-spzxoq2","updated":"20240612195625"},"Children":[{"Type":"NodeText","Data":"缪氏。入口即吐。其性暴悍可知。最损真气。故疟非由于瘴气。及老痰积饮所致者。弗用〔辨治〕须细实色黄。形如鸡骨者佳。生用令人大吐。酒浸一日。蒸熟。或炒。或醋浸煮"}]},{"ID":"20240612195626-25s542t","Type":"NodeThematicBreak","Properties":{"id":"20240612195626-25s542t"}},{"ID":"20240612195637-uu14fj4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195637-uu14fj4","updated":"20240612195643"},"Children":[{"Type":"NodeText","Data":"常山《本草择要纲目》"}]},{"ID":"20240612195637-rxlvd7w","Type":"NodeParagraph","Properties":{"id":"20240612195637-rxlvd7w","updated":"20240612195637"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612195637-d6iho6v","Type":"NodeParagraph","Properties":{"id":"20240612195637-d6iho6v","updated":"20240612195637"},"Children":[{"Type":"NodeText","Data":"苦寒有毒．为治疟之最要．不可多进．凡无水不作痰．无痰不成疟．水在上焦则常山能吐之．水在胁下则常山能破其辟而下其水．但得行血药为佐助．功可收其十全也．又纯热发疟．或蕴热内实之症．投以常山．大便点滴而下．大便似泄不泄者．佐以大黄泄利敷行．可获全愈也．"}]},{"ID":"20240612195717-7cl33ps","Type":"NodeThematicBreak","Properties":{"id":"20240612195717-7cl33ps"}},{"ID":"20240612195734-yi55ps0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195734-yi55ps0","updated":"20240612195740"},"Children":[{"Type":"NodeText","Data":"常山《证类本草》"}]},{"ID":"20240612195734-074bigr","Type":"NodeParagraph","Properties":{"id":"20240612195734-074bigr","updated":"20240612195734"},"Children":[{"Type":"NodeText","Data":"味苦、辛，寒、微寒，有毒。主伤寒寒热，热发，温疟鬼毒，胸中痰结，吐逆，疗鬼蛊往来，水胀，洒洒恶寒，鼠 。一名互草。生益州川谷及汉中。八月采根，阴干。（畏玉札。）"}]},{"ID":"20240612195734-94lrv6k","Type":"NodeParagraph","Properties":{"id":"20240612195734-94lrv6k","updated":"20240612195734"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶出宜都、建平。细实黄者，呼为鸡骨常山，用最胜。唐本注云∶常山，叶似茗狭长。茎圆，两叶相当。三月生白花，青萼。五月结实，青圆，三子为房。生山谷间。高者不过三、四尺。臣禹锡等谨按蜀本图经云∶树高三、四尺，根似荆根，黄色而破，今出金州、房州、梁州，五月、六月采叶，名蜀漆也。药性论云∶常山忌葱，味苦，有小毒。治诸疟，吐痰涎，去寒热。用小麦、竹叶三味合煮，小儿甚良。主疟、洒洒寒热不可进多，令人大吐，治项下瘤瘿。萧炳云∶得甘草，吐疟。日华子云∶忌菘菜。"}]},{"ID":"20240612195734-azud7ho","Type":"NodeParagraph","Properties":{"id":"20240612195734-azud7ho","updated":"20240612195734"},"Children":[{"Type":"NodeText","Data":"图经文具蜀漆条下。"}]},{"ID":"20240612195734-9w3zhuh","Type":"NodeParagraph","Properties":{"id":"20240612195734-9w3zhuh","updated":"20240612195734"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡使，春采、根、叶，夏秋冬一时，用使酒浸一宿，至明漉出，日干，熬捣，少用，勿令老人、久病服之，切忌也。外台秘要∶治疟。常山三两，以浆水三升浸经一宿，煎取一升，欲发前顿服，然后微吐。肘后方∶治疟病。常山三两捣末，以鸡子白和丸如桐子大。空腹三十丸。"}]},{"ID":"20240612195734-xqngg2u","Type":"NodeParagraph","Properties":{"id":"20240612195734-xqngg2u","updated":"20240612195734"},"Children":[{"Type":"NodeText","Data":"衍义曰∶常山，蜀漆根也。亦治疟吐痰，如鸡骨者佳。"}]},{"ID":"20240612195813-uosfns6","Type":"NodeThematicBreak","Properties":{"id":"20240612195813-uosfns6"}},{"ID":"20240612195815-1s23fl0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195815-1s23fl0","updated":"20240612195818"},"Children":[{"Type":"NodeText","Data":"常山《本草择要纲目》"}]},{"ID":"20240612195815-x4muues","Type":"NodeParagraph","Properties":{"id":"20240612195815-x4muues","updated":"20240612195815"},"Children":[{"Type":"NodeText","Data":"【气味】"}]},{"ID":"20240612195815-16q66uk","Type":"NodeParagraph","Properties":{"id":"20240612195815-16q66uk","updated":"20240612195815"},"Children":[{"Type":"NodeText","Data":"苦寒有毒．为治疟之最要．不可多进．凡无水不作痰．无痰不成疟．水在上焦则常山能吐之．水在胁下则常山能破其辟而下其水．但得行血药为佐助．功可收其十全也．又纯热发疟．或蕴热内实之症．投以常山．大便点滴而下．大便似泄不泄者．佐以大黄泄利敷行．可获全愈也．"}]},{"ID":"20240612195824-sfrxlan","Type":"NodeThematicBreak","Properties":{"id":"20240612195824-sfrxlan"}},{"ID":"20240612195825-zwko44s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195825-zwko44s","updated":"20240612195832"},"Children":[{"Type":"NodeText","Data":"常山《本草乘雅半偈》"}]},{"ID":"20240612195825-9gbkfow","Type":"NodeParagraph","Properties":{"id":"20240612195825-9gbkfow","updated":"20240612195825"},"Children":[{"Type":"NodeText","Data":"（本经下品）"}]},{"ID":"20240612195825-1udc06g","Type":"NodeParagraph","Properties":{"id":"20240612195825-1udc06g","updated":"20240612195825"},"Children":[{"Type":"NodeText","Data":"【气味】苦寒，有毒。"}]},{"ID":"20240612195825-07mj38h","Type":"NodeParagraph","Properties":{"id":"20240612195825-07mj38h","updated":"20240612195825"},"Children":[{"Type":"NodeText","Data":"【主治】主伤寒寒热，发热温疟，鬼毒，胸中痰结吐逆。"}]},{"ID":"20240612195837-xbgwfjc","Type":"NodeThematicBreak","Properties":{"id":"20240612195837-xbgwfjc"}},{"ID":"20240612195839-kbvf7nt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195839-kbvf7nt","updated":"20240612195844"},"Children":[{"Type":"NodeText","Data":"常山《本草简要方》"}]},{"ID":"20240612195839-4hd7k9y","Type":"NodeParagraph","Properties":{"id":"20240612195839-4hd7k9y","updated":"20240612195839"},"Children":[{"Type":"NodeText","Data":"主治诸种疟疾。吐痰涎。胸中邪结。常山饮。常山（醋炒）槟榔青皮（炒）甘草当归各穿山甲（）八分。黑豆四十粒。生姜七片。水酒各半煎。露一宿。侵晨热服。治疟发至夜热不止。脉实邪盛者。按此为治疟主药。内含吐剂。与甘草同服。尤属必吐。向有疟生于痰之谬说。故使之吐。其实当与半夏乌梅浓朴诸药同用。则可不吐而疟愈矣。各种疟皆可治。"}]},{"ID":"20240612195839-90hzqd4","Type":"NodeParagraph","Properties":{"id":"20240612195839-90hzqd4","updated":"20240612195839"},"Children":[{"Type":"NodeText","Data":"故截疟诸汤诸酒诸丸均用之。黄者为佳。叶之功效与根同。"}]},{"ID":"20240612195934-95du52b","Type":"NodeThematicBreak","Properties":{"id":"20240612195934-95du52b"}},{"ID":"20240612195935-yohiqvs","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195935-yohiqvs","updated":"20240612195939"},"Children":[{"Type":"NodeText","Data":"常山《本草从新》"}]},{"ID":"20240612195935-56ug16f","Type":"NodeParagraph","Properties":{"id":"20240612195935-56ug16f","updated":"20240612195935"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宣、吐痰截疟、通行水．"}]},{"ID":"20240612195935-2t3fupu","Type":"NodeParagraph","Properties":{"id":"20240612195935-2t3fupu","updated":"20240612195935"},"Children":[{"Type":"NodeText","Data":"辛苦而寒．能引吐行水．祛老痰积饮．（痰有六、风痰、寒痰、湿痰、热痰、食痰、气痰也、饮有五、流于肺为支饮、于肝为悬饮、于心为伏饮、于经络为溢饮、于肠胃为痰饮也、常山力能吐之下之．）截诸疟必效．（疟疾必有黄涎聚于胸中、故曰无痰不成疟、弦脉主痰饮、故曰疟脉自弦、常山去老痰积饮、故为诸疟要药、时珍曰∶常山蜀漆、劫痰截疟、须在发散表邪、及提出阳分之后用之、疟有经疟、脏疟、风、寒、暑、湿、痰、食、瘴、鬼之别、须分阴阳虚实、不可混治、常山蜀漆、得甘草则吐、得大黄则利、得乌梅穿山甲则入肝、得小麦竹叶则入心、得秫米麻黄则入肺、得龙骨附子则入肾、得草果槟榔则入脾、盖无痰不作疟、一物之功、亦在驱逐痰水而已、士材曰∶常山发吐、唯生用多用为然、与甘草同用亦必吐、若酒浸炒透、但用钱许、每见奇功、未见其吐也、世人泥于雷 老人久病忌服之说、使良药见疑、沉 难起、抑何愚耶．常山吐疟痰、瓜蒂吐热痰、乌附尖吐湿痰、莱菔子吐气痰、藜芦吐风痰．）性猛烈．施之藿食者多效．若肉食之人．稍稍挟虚．不可轻入．鸡骨者良．"}]},{"ID":"20240612195935-vy8kkio","Type":"NodeParagraph","Properties":{"id":"20240612195935-vy8kkio","updated":"20240612195935"},"Children":[{"Type":"NodeText","Data":"烧酒浸一宿．炒透用．栝蒌为使．忌葱茗．蜀漆（常山茎叶．）功用略同．（古方有蜀漆散、取其苗性轻扬、发散上焦之邪结．）甘草水拌蒸．"}]},{"ID":"20240612195851-6oxbv0k","Type":"NodeThematicBreak","Properties":{"id":"20240612195851-6oxbv0k"}},{"ID":"20240612195852-mb6hntx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195852-mb6hntx","updated":"20240612195856"},"Children":[{"Type":"NodeText","Data":"常山《本草撮要》"}]},{"ID":"20240612195852-1frx95e","Type":"NodeParagraph","Properties":{"id":"20240612195852-1frx95e","updated":"20240612195852"},"Children":[{"Type":"NodeText","Data":"味苦．入手太阴足阳明经．功专劫痰截疟．得知母、贝母、草果治诸疟．得丹砂能劫痰疟．得槟榔、草果治瘴疟．得甘草治肺疟．得豆豉、乌梅、竹叶治肾疟．得小麦、淡竹叶治温疟．得黄连治久疟．得云母、龙骨治牝疟独寒．得麻黄、甘草、牡蛎治牡疟独热．得甘草则吐．得大黄则利．若酒浸蒸或炒用则不吐．茎叶名蜀漆．功用略同．惟味辛．生用性升．炒黑则缓．栝蒌为使．忌葱茗．"}]},{"ID":"20240612195913-ho3dtoi","Type":"NodeThematicBreak","Properties":{"id":"20240612195913-ho3dtoi"}},{"ID":"20240612195914-lv96ces","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195914-lv96ces","updated":"20240612195919"},"Children":[{"Type":"NodeText","Data":"常山《本草衍义》"}]},{"ID":"20240612195914-8hoaovx","Type":"NodeParagraph","Properties":{"id":"20240612195914-8hoaovx","updated":"20240612195914"},"Children":[{"Type":"NodeText","Data":"蜀漆根也，亦治疟、吐痰，如鸡骨者佳。"}]},{"ID":"20240612195923-edjyxh1","Type":"NodeThematicBreak","Properties":{"id":"20240612195923-edjyxh1"}},{"ID":"20240612195924-t0hmegi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195924-t0hmegi","updated":"20240612195928"},"Children":[{"Type":"NodeText","Data":"常山《顾松园医镜》"}]},{"ID":"20240612195924-hxfz2pb","Type":"NodeParagraph","Properties":{"id":"20240612195924-hxfz2pb","updated":"20240612195924"},"Children":[{"Type":"NodeText","Data":"〔辛苦寒有毒，入肝经。酒炒令透，则不发吐。〕驱痰饮有灵，截疟疾必效，〔无痰不成疟，善祛老痰积饮，故能截积年久疟有神〕。散瘴气寒热，治项下瘿瘤。〔散瘴邪祛老痰之功。〕其性暴悍，最损真气。截疟宜同补药用。虚人及孕妇大忌。。"}]},{"ID":"20240612195858-6ovi25g","Type":"NodeThematicBreak","Properties":{"id":"20240612195858-6ovi25g"}},{"ID":"20240612195904-lfp6arr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195904-lfp6arr","updated":"20240612195908"},"Children":[{"Type":"NodeText","Data":"常山《本经逢原》"}]},{"ID":"20240612195904-g1s5v0c","Type":"NodeParagraph","Properties":{"id":"20240612195904-g1s5v0c","updated":"20240612195904"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名恒山"}]},{"ID":"20240612195904-8nbbc42","Type":"NodeParagraph","Properties":{"id":"20240612195904-8nbbc42","updated":"20240612195904"},"Children":[{"Type":"NodeText","Data":"苦辛温，有毒。川产淡黄细实如鸡骨者良，醋炒则不吐人。"}]},{"ID":"20240612195904-shd5fm0","Type":"NodeParagraph","Properties":{"id":"20240612195904-shd5fm0","updated":"20240612195904"},"Children":[{"Type":"NodeText","Data":"《本经》主伤寒寒热，发温疟鬼毒，胸中痰结吐逆。"}]},{"ID":"20240612195904-9cs82iv","Type":"NodeParagraph","Properties":{"id":"20240612195904-9cs82iv","updated":"20240612195904"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"夫疟有六经五脏痰湿、食积、风邪、瘴疫，须分阴阳虚实，不可一概论也。常山治疟有劫痰截病之功，须在发散表邪，及提出阳分之后服之得宜。生用多用则上行必吐，若酒浸炒透，则气少缓，稍用钱许亦不致吐也。得甘草则吐，得大黄则利。盖无痰不作疟，常山专在驱逐痰水。杨士赢云∶常山治疟，人皆薄之，疟家多蓄痰涎黄水，或停潴心下，或结胁间，乃生寒热。法当吐逆逐水，常山岂容不用，所以《本经》专主寒热温疟，痰结吐逆，以疟病多由伤寒寒热或时气温疫而致痰水蓄聚心下也。夫水在上焦，则常山能吐之；水在胁下，则常山能破其 而下其水。但须行血药佐之，如桃仁、莪术、穿山甲之类。其有纯热发疟或蕴热内实之证，投以常山。大便点滴而下，似泄非泄，须用大黄为佐泻利数行，然后获愈。常山阴毒之草，其性暴悍，虽有破瘴逐饮之能，然善损真气，所以仲景治疟方中从无及此。而夏伤于暑，秋必 疟，及疟在三阴元气虚寒人，则常山、穿山甲辈皆为戈戟。"}]},{"ID":"20240612195802-qi3wuoa","Type":"NodeThematicBreak","Properties":{"id":"20240612195802-qi3wuoa"}},{"ID":"20240612195803-6nhz33g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195803-6nhz33g","updated":"20240612195808"},"Children":[{"Type":"NodeText","Data":"常山《医学入门》"}]},{"ID":"20240612195803-mq3ld0g","Type":"NodeParagraph","Properties":{"id":"20240612195803-mq3ld0g","updated":"20240612195803"},"Children":[{"Type":"NodeText","Data":"常山辛苦除寒热，逐水消痰疟可截，善治腹块并项瘿，老弱虚人忌入舌，蜀漆即是常山苗，性同更医逆气结。"}]},{"ID":"20240612195803-54r9y3t","Type":"NodeParagraph","Properties":{"id":"20240612195803-54r9y3t","updated":"20240612195803"},"Children":[{"Type":"NodeText","Data":"生常山道中，微寒，有毒。主伤寒、温疟寒热，破胸腹停水水胀，胸中痰结吐逆，凡疟皆痰与水为之，故截疟必用此吐痰去水。又治疟母及腹中积聚邪气，痞结坚 ，鬼毒蛊疰，项下瘿瘤鼠 。丹溪云∶性暴悍，善驱逐伤气。老弱虚人及久病忌之。凡使，细实色黄形如鸡骨者佳。生用令人大吐，酒浸一日，蒸熟或炒，或醋浸煮熟，则善化痞而不吐，畏玉札，忌菘菜、葱。蜀漆，生蜀中，采时茎内有汁如漆，纯阳有毒。吐疟破 疗鬼疰，与常山一同，更治咳逆气结。入药用甘草水蒸二次，晒干。栝蒌、桔梗为使，恶贯众。"}]},{"ID":"20240612195752-77lcsex","Type":"NodeThematicBreak","Properties":{"id":"20240612195752-77lcsex"}},{"ID":"20240612195753-1rdb13m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195753-1rdb13m","updated":"20240612195757"},"Children":[{"Type":"NodeText","Data":"常山《本草备要》"}]},{"ID":"20240612195753-uf6tyyx","Type":"NodeParagraph","Properties":{"id":"20240612195753-uf6tyyx","updated":"20240612195753"},"Children":[{"Type":"NodeText","Data":"宣，吐痰，截疟，通，行水"}]},{"ID":"20240612195753-cooaks6","Type":"NodeParagraph","Properties":{"id":"20240612195753-cooaks6","updated":"20240612195753"},"Children":[{"Type":"NodeText","Data":"辛苦而寒，有毒。能引吐行水，祛老痰积饮（痰有六∶风痰、寒痰、湿痰、热痰、食痰、气痰也。饮有五，流于肺为支饮，于肝为悬饮，于心为伏饮，于经络为溢饮，于肠胃为痰饮也。常山力能吐之，下之），专治诸疟。然悍暴能损真气，弱者慎用（时珍曰∶常山蜀漆，韧痰截疟，须在发散表邪及提出阳分之后用之。疟有经疟、脏疟、风、寒、暑、湿、痰、食、瘴、鬼之别，须分阴、阳、虚、实，不可概论。常山蜀漆，得甘草则吐，得大黄则利，得乌梅、穿山甲则入肝，得小麦、竹叶则入心，得秫米、麻黄则入肺，得龙骨、附子则入肾，得草果、槟榔则入脾。盖无痰不作疟，一物之功，亦在驱逐痰水而已。李士材曰∶常山发吐，唯生用、多用为然。与甘草同用亦必吐。若酒浸炒透，但用钱许，每见奇功，未见其或吐也。世人泥于雷 老人久病忌服之说，使良药见疑，沉 难起，抑何愚也。常山吐疟痰，瓜蒂吐热痰，乌附尖吐湿痰，莱菔子吐气痰，藜芦吐风痰）。"}]},{"ID":"20240612195753-m9ptoxe","Type":"NodeParagraph","Properties":{"id":"20240612195753-m9ptoxe","updated":"20240612195753"},"Children":[{"Type":"NodeText","Data":"鸡骨者良。酒浸蒸或炒用。栝蒌为使。忌葱、茗。茎叶名蜀漆，功用略同（古方有蜀漆散，取其苗性轻扬，发散上焦邪结）。甘草水拌蒸。"}]},{"ID":"20240612195706-jvvjro9","Type":"NodeThematicBreak","Properties":{"id":"20240612195706-jvvjro9"}},{"ID":"20240612195708-9bk64e2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195708-9bk64e2","updated":"20240612195711"},"Children":[{"Type":"NodeText","Data":"常山《本草求真》"}]},{"ID":"20240612195708-occu2pg","Type":"NodeParagraph","Properties":{"id":"20240612195708-occu2pg","updated":"20240612195708"},"Children":[{"Type":"NodeText","Data":"（毒草）吐心下疟痰积饮"}]},{"ID":"20240612195708-g3hivro","Type":"NodeParagraph","Properties":{"id":"20240612195708-g3hivro","updated":"20240612195708"},"Children":[{"Type":"NodeText","Data":"常山（专入心下。）辛苦而寒。有毒。功专引吐行水。为除疟疾老痰积饮要药。盖疟无不挟痰挟热以成。然亦有风痰寒热食气之分。（风痰宜于星乌。寒痰宜于姜附。热痰宜于贝母。食痰宜于楂曲。气痰宜于乌药。痰在膈上经络。非吐不解。痰在四肢皮里膜外。非姜汁竹沥不达。痰在胁下。非白芥子不除。痰在骨节眼黑步艰。非萆 苦参不祛。痰在手臂肩背酸痛。非导痰加姜黄木香桂枝不和。痰在肠胃实结。非用下药不愈。）治须分其阴阳虚实表里以定。如疟果因伤寒寒热。及时气温疫。而致黄涎聚于胸中。心下牢固不解。则当用此引吐。然亦须在发散表邪。及提出阳分之后而用之。其用又当审其所见部位。及药佐使以治。如常山得甘草则吐。水在上焦者宜之。得乌梅山甲则入肝。水在胁下者宜之。得大黄则利水。邪热交结而成内实者宜之。得小麦竹叶则入心。得秫米麻黄则入肺。得龙骨附子则入肾。得草果槟榔则入脾。然此阴毒之草。其性悍暴。虽有破瘴逐饮之能。而亦终损真气。所以仲景治疟方中。从无及此。（经曰。太阴在泉。湿胜所淫。民病积饮。又曰。岁土太过。雨湿流行。甚则饮发。盖饮有五。流于肺为支饮。于肝为悬饮。于心为伏饮。于经络为溢饮。于肠胃为痰饮。）而夏伤于暑。秋必瘅疟。及疟在三阴。元气虚寒人。则常山等药皆为戈戟。或问吐药甚多。何以疟疾必用常山蜀漆？盖以常山性兼逐疫。疟疾本于湿疫。故于常山蜀漆则宜。犹之瓜蒂乌附尖莱菔子藜芦皆为吐剂。而瓜蒂则止宜于热痰。乌尖附则止宜于湿痰。莱菔子则止宜于气痰。藜芦则止宜于风痰也。酒浸炒用。根即蜀漆。功用略同。但苗性轻扬。其于上焦邪结。治之更宜。"}]},{"ID":"20240628162758-2kt7jry","Type":"NodeThematicBreak","Properties":{"id":"20240628162758-2kt7jry"}},{"ID":"20240628162759-jz127z5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240628162759-jz127z5","updated":"20240628162759"},"Children":[{"Type":"NodeText","Data":"蜀漆《本草图经》"}]},{"ID":"20240628162759-gm9mh6q","Type":"NodeParagraph","Properties":{"id":"20240628162759-gm9mh6q","updated":"20240628162759"},"Children":[{"Type":"NodeText","Data":"蜀漆，生江林山川谷及蜀汉。常山苗也。常山生益州山谷及汉中，蜀漆根也。江林山即益州江阳山名，是同处耳。今京西、淮、浙、湖南州郡亦有之。叶似茗而狭长，两两相当；茎圆有节；三月生红花，青萼；五月结实，青；三子为房；苗高者不过三、四尺；根似荆，黄色。而海州出者，叶似楸叶，八尺，有花红白色，子碧色，似山楝子而小。五月采叶，八月采根，阴干。此二味为治疟之最要。张仲景蜀漆散∶用蜀漆、云母、龙骨等分，杵末，患者至发前，以浆水和半钱服之。温疟加蜀漆半分，临发时服一钱匕。今天台山出一种草，名土常山，苗、叶极甘，人用为饮香，其味如蜜，又名蜜香草，性亦凉，饮之益人，非此常山也。"}]},{"ID":"20240612195638-v8cu35c","Type":"NodeThematicBreak","Properties":{"id":"20240612195638-v8cu35c"}},{"ID":"20240612195651-8unomlw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195651-8unomlw","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"《中国药典》：常山"}]},{"ID":"20240612195651-y9u5wob","Type":"NodeParagraph","Properties":{"id":"20240612195651-y9u5wob","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612195651-gqwjx4s","Type":"NodeParagraph","Properties":{"id":"20240612195651-gqwjx4s","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" Chánɡ Shān"}]},{"ID":"20240612195651-nyczlvs","Type":"NodeParagraph","Properties":{"id":"20240612195651-nyczlvs","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612195651-bss05au","Type":"NodeParagraph","Properties":{"id":"20240612195651-bss05au","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 黄常山、鸡骨常山、鸡骨风、风骨木、白常山、大金刀、蜀漆[叶]"}]},{"ID":"20240612195651-91b370s","Type":"NodeParagraph","Properties":{"id":"20240612195651-91b370s","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612195651-g2xgna6","Type":"NodeParagraph","Properties":{"id":"20240612195651-g2xgna6","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" RADIX DICHROAE"}]},{"ID":"20240612195651-jd68xhj","Type":"NodeParagraph","Properties":{"id":"20240612195651-jd68xhj","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612195651-je8yyxs","Type":"NodeParagraph","Properties":{"id":"20240612195651-je8yyxs","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 本品为虎耳草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"常山"},{"Type":"NodeText","Data":"Dichroa febrifuga Lour. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。其嫩叶称“"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜀漆"},{"Type":"NodeText","Data":"”，亦供药用。根秋季采挖，除去须根，洗净，晒干。枝叶夏季采集，晒干。"}]},{"ID":"20240612195651-hxqqtki","Type":"NodeParagraph","Properties":{"id":"20240612195651-hxqqtki","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612195651-28cvzoo","Type":"NodeParagraph","Properties":{"id":"20240612195651-28cvzoo","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 本品呈圆柱形，常弯曲扭转，或有分枝，长9～15cm,直径0.5～2cm。表面棕黄色，具细纵纹，外皮易剥落，剥落处露出淡黄色木部。质坚硬，不易折断，折断时有粉尘飞扬；横切面黄白色，射线类白色，呈放射状。无臭，味苦。"}]},{"ID":"20240612195651-7vlbzfm","Type":"NodeParagraph","Properties":{"id":"20240612195651-7vlbzfm","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612195651-pjc96pc","Type":"NodeParagraph","Properties":{"id":"20240612195651-pjc96pc","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 置通风干燥处。"}]},{"ID":"20240612195651-351gn8d","Type":"NodeParagraph","Properties":{"id":"20240612195651-351gn8d","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612195651-awoijlz","Type":"NodeParagraph","Properties":{"id":"20240612195651-awoijlz","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"常山"},{"Type":"NodeText","Data":"：除去杂质，分开大小，浸泡，润透，切薄片，晒干。"}]},{"ID":"20240612195651-f3j4kfk","Type":"NodeParagraph","Properties":{"id":"20240612195651-f3j4kfk","updated":"20240612195651"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"炒常山"},{"Type":"NodeText","Data":"：取常山片，照清炒法（附录Ⅱ D）炒至色变深。"}]},{"ID":"20240612195651-7v0014u","Type":"NodeParagraph","Properties":{"id":"20240612195651-7v0014u","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612195651-uvrbf6y","Type":"NodeParagraph","Properties":{"id":"20240612195651-uvrbf6y","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" （1） 本品横切面：木栓细胞数列。皮层窄，少数细胞内含树脂块或草酸钙针晶束。韧皮部较窄，草酸钙针晶束较多。形成层显不规则波状环。木质部占主要部分，均木化，射线宽窄不一；导管多角形，单个散在或数个相聚，有的含黄色侵填体。薄壁细胞含淀粉粒。"}]},{"ID":"20240612195651-oa991ob","Type":"NodeParagraph","Properties":{"id":"20240612195651-oa991ob","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末约2g，加70％乙醇10ml，加热回流15分钟，放冷，滤过，滤液蒸干，残渣加 1％盐酸溶液2ml,搅拌，滤过。取滤液，加碘化铋钾试液 2滴，即生成棕红色沉淀。"}]},{"ID":"20240612195651-qfkuyc0","Type":"NodeParagraph","Properties":{"id":"20240612195651-qfkuyc0","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612195651-h88oi13","Type":"NodeParagraph","Properties":{"id":"20240612195651-h88oi13","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 归肺、肝、心经。"}]},{"ID":"20240612195651-ene98vm","Type":"NodeParagraph","Properties":{"id":"20240612195651-ene98vm","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612195651-z2m0woh","Type":"NodeParagraph","Properties":{"id":"20240612195651-z2m0woh","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 苦、辛，寒；有毒。"}]},{"ID":"20240612195651-h5y3blb","Type":"NodeParagraph","Properties":{"id":"20240612195651-h5y3blb","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612195651-8tni7ju","Type":"NodeParagraph","Properties":{"id":"20240612195651-8tni7ju","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 有催吐副作用，用量不宜过大，孕妇慎用。"}]},{"ID":"20240612195651-kl2xwmd","Type":"NodeParagraph","Properties":{"id":"20240612195651-kl2xwmd","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612195651-g94r3el","Type":"NodeParagraph","Properties":{"id":"20240612195651-g94r3el","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 截疟，劫痰。用于疟疾。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜀漆"},{"Type":"NodeText","Data":"功能主治与常山略同，但作用稍差。"}]},{"ID":"20240612195651-l3cq4bi","Type":"NodeParagraph","Properties":{"id":"20240612195651-l3cq4bi","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612195651-pvovs70","Type":"NodeParagraph","Properties":{"id":"20240612195651-pvovs70","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 5～9g。"}]},{"ID":"20240612195651-1ri0n7w","Type":"NodeParagraph","Properties":{"id":"20240612195651-1ri0n7w","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612195651-cgpmk7u","Type":"NodeParagraph","Properties":{"id":"20240612195651-cgpmk7u","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612195651-pl9n3zp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195651-pl9n3zp","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：常山"}]},{"ID":"20240612195651-mquqfwt","Type":"NodeParagraph","Properties":{"id":"20240612195651-mquqfwt","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612195651-4q7nbi9","Type":"NodeParagraph","Properties":{"id":"20240612195651-4q7nbi9","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" Chánɡ Shān"}]},{"ID":"20240612195651-b9b88uq","Type":"NodeParagraph","Properties":{"id":"20240612195651-b9b88uq","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612195651-8ps8owt","Type":"NodeParagraph","Properties":{"id":"20240612195651-8ps8owt","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 互草（《本经》），恒山，七叶（《吴普本草》），鸡骨常山（陶弘景），翻胃木（侯宁极《药谱》）。"}]},{"ID":"20240612195651-ssc52yg","Type":"NodeParagraph","Properties":{"id":"20240612195651-ssc52yg","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612195651-zci518k","Type":"NodeParagraph","Properties":{"id":"20240612195651-zci518k","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612195651-85fjytw","Type":"NodeParagraph","Properties":{"id":"20240612195651-85fjytw","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612195651-ejo6pon","Type":"NodeParagraph","Properties":{"id":"20240612195651-ejo6pon","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 为虎耳草科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"黄常山"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"。秋季采挖，除去茎苗及须根，洗净，晒干。"}]},{"ID":"20240612195651-30qm965","Type":"NodeParagraph","Properties":{"id":"20240612195651-30qm965","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612195651-k8linl4","Type":"NodeParagraph","Properties":{"id":"20240612195651-k8linl4","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 生于林荫湿润山地，或栽培于林下。分布江西、湖北、湖南、陕西、四川、贵州、云南、广东、广西、福建等地。主严于四川、贵州、湖南。此外，湖北、广西亦产。"}]},{"ID":"20240612195651-qlbm00f","Type":"NodeParagraph","Properties":{"id":"20240612195651-qlbm00f","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612195651-jw0sg7d","Type":"NodeParagraph","Properties":{"id":"20240612195651-jw0sg7d","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 落叶灌木，高可达2米。茎枝圆形，有节，幼时被棕黄色短毛，叶对生，椭圆形，广披针形或长方状倒卵形，长5～17厘米，宽2～6厘米，先端渐尖，基部楔形，边缘有锯齿，幼时两面均疏被棕黄色短毛；叶柄长1～2厘米。伞房花序，着生于枝顶或上部的叶腋；花浅蓝色；苞片线状披针形，早落；花萼管状，淡蓝色。长约4毫米，先端5～6齿，三角形，管外密被棕色短毛；花瓣5～6，蓝色，长圆状披针形或卵形，长约8毫米；雄蕊10～12，花丝长短不等，花药蓝色；雌蕊1，蓝色，子房半下位，1室，花柱4，柱头椭圆形。浆果圆形，径5～6毫米，蓝色，有宿存萼和花柱。花期6～7月。果期8～9月。"}]},{"ID":"20240612195651-w14faut","Type":"NodeParagraph","Properties":{"id":"20240612195651-w14faut","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612195651-k98gsql","Type":"NodeParagraph","Properties":{"id":"20240612195651-k98gsql","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 干燥的根圆柱形，常分歧，弯曲扭转，长10～15厘米，直径约0.3～2厘米。表面黄棕色，有明显的细纵纹及支根痕迹，栓皮易剥落，显出淡黄色木质部。质坚硬，折断时有粉飞出。横断面黄白色，用水湿润后可见明显的类白色射线，放射状排列。根基类圆柱形而近块状。横断面除中央有髓外，其他均与根的横断面相同。气微弱，昧苦。以质坚实而重、形如鸡骨，表面及断面淡黄色、光滑者为佳，根粗长顺直、质松、色深黄、无苦味者不可入药。"}]},{"ID":"20240612195651-h5e175r","Type":"NodeParagraph","Properties":{"id":"20240612195651-h5e175r","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612195651-j5jln8d","Type":"NodeParagraph","Properties":{"id":"20240612195651-j5jln8d","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 小鼠口服常山碱乙、丙，兔及大鼠静脉注射常山碱丙均可致腹泻，小鼠甚至便血。狗口服常山水浸膏或肌肉注射其醇浸膏或皮下注射常山碱甲可致恶心、呕吐、腹泻及胃肠粘膜充血出血。预先口服草酸铈，则呕吐、腹泻均减轻，故系胃肠道刺激所致。鸽静脉注射常山碱甲、乙、丙均能引起呕吐，氯丙嗪能推迟而不能阻止其呕吐的发生。狗静脉注射小量氯丙嗪不影响常山碱乙静脉注射的催吐阈量，大量能抑制其阔剂量的呕吐，但还不能对抗大剂量常山碱乙的呕吐。破坏狗的催吐化学感应区（CTZ）并不减轻常山碱乙阈剂量的呕吐，切断两侧迷走神经则大大减弱其催吐作用，完全切除胃肠道的迷走及交感神经则能完全阻止常山碱乙的呕吐。因此常山碱乙主要是刺激胃肠道的迷走及交感神经末梢而反射地引起呕吐的。"}]},{"ID":"20240612195651-kouk8bs","Type":"NodeParagraph","Properties":{"id":"20240612195651-kouk8bs","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"小鼠连续给常山碱乙或丙14天则生长受抑制，多数有腹泻，病理解剖胃肠粘膜充血或出血，肝、肾呈黄色。另有报告，重复给小鼠常山碱丙可引起肝水肿样变性，兔静脉注射常山碱丙则能升高血糖。"}]},{"ID":"20240612195651-r3n61uq","Type":"NodeParagraph","Properties":{"id":"20240612195651-r3n61uq","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"小鼠口服常山碱半数致死量（毫克/公斤）为：乙，6.57±0.47；丙，0.45±0.31；总生物碱为7.79±1.30；乙的毒性比奎宁约大150倍，总碱的毒性约为奎宁的123倍。丙口服毒性反比静脉注射大（小鼠）。"}]},{"ID":"20240612195651-ne7nur2","Type":"NodeParagraph","Properties":{"id":"20240612195651-ne7nur2","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612195651-4isu1fm","Type":"NodeParagraph","Properties":{"id":"20240612195651-4isu1fm","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 黄常山含有效成分黄常山碱，简称常山碱，根含生物碱总量约0.1％，主要为黄常山碱甲、乙及丙，三者为互变异构体。还含黄常山定以及4-喹唑酮、伞形花内酯等。从根及叶中分离出的退热碱和异退热碱，相应地就是黄常山碱乙和黄常山碱甲。"}]},{"ID":"20240612195651-e1mp1by","Type":"NodeParagraph","Properties":{"id":"20240612195651-e1mp1by","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"叶含生物碱总置约0.5％，其中黄常山碱的含量比根中的多10～20倍。另含少量三甲胺。"}]},{"ID":"20240612195651-x18rnd8","Type":"NodeParagraph","Properties":{"id":"20240612195651-x18rnd8","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612195651-bvwe58f","Type":"NodeParagraph","Properties":{"id":"20240612195651-bvwe58f","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" ①抗疟作用"}]},{"ID":"20240612195651-vti0jud","Type":"NodeParagraph","Properties":{"id":"20240612195651-vti0jud","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"常山根水浸膏对鸡疟有显着疗效，常山叶（蜀漆）抗疟效价为根的5倍。但不能防止复发。常山全碱的抗疟效价约为奎宁的26倍。常山碱甲、乙、丙对鸡疟的效价分别为奎宁的1、100与150倍。常山碱乙对鸭疟的效价为奎宁的100倍。常山碱丙对金丝雀疟、猴疟也都有效。在过去传统抗疟方面将常山与槟榔合用，但经鸡疟试验，槟榔碱本身并无抗疟效果，既不能增强常山碱乙的抗疟效力，也不能对抗常山碱乙所致的呕吐，反能增加常山毒性。"}]},{"ID":"20240612195651-ntwkdui","Type":"NodeParagraph","Properties":{"id":"20240612195651-ntwkdui","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②抗阿米巴作用"}]},{"ID":"20240612195651-zyookbg","Type":"NodeParagraph","Properties":{"id":"20240612195651-zyookbg","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"常山碱乙体外抗阿米巴原虫的作用较依米丁为强；对幼大鼠感染阿米巴原虫后的疗效较依米丁高，治疗指数，也比依米丁大1倍。"}]},{"ID":"20240612195651-w8bcdeh","Type":"NodeParagraph","Properties":{"id":"20240612195651-w8bcdeh","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③解热作用"}]},{"ID":"20240612195651-4mdbojx","Type":"NodeParagraph","Properties":{"id":"20240612195651-4mdbojx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"常山粗制浸膏对人工发热的家兔有退热作用。大鼠口服常山碱丙，其退热作用比乙酰水杨酸还强。"}]},{"ID":"20240612195651-261cjoz","Type":"NodeParagraph","Properties":{"id":"20240612195651-261cjoz","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"④其他作用"}]},{"ID":"20240612195651-imbxg6d","Type":"NodeParagraph","Properties":{"id":"20240612195651-imbxg6d","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"麻醉狗静脉注射常山碱甲、乙、丙均能降低血压，呼吸无显著变化，脾、肾容积增加，心收缩振幅减小，对离体兔心均为抑制，故血压降低是由于内脏血管扩张及心脏抑制，对麻醉狗在位子宫、妊娠兔及大鼠的离体子宫均为兴奋，对未孕子宫作用不定，对猴的降压与收缩子宫的作用与等剂量奎宁相似。"}]},{"ID":"20240612195651-q2cpzzm","Type":"NodeParagraph","Properties":{"id":"20240612195651-q2cpzzm","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"常山水浸液体外与体内试验（小鼠），对甲型流感病毒PR6有一定的抑制作用。常山碱丙体外试验对艾氏腹水癌细胞有一定杀死作用。"}]},{"ID":"20240612195651-8ch9k54","Type":"NodeParagraph","Properties":{"id":"20240612195651-8ch9k54","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"⑤体内过程"}]},{"ID":"20240612195651-74v5aa2","Type":"NodeParagraph","Properties":{"id":"20240612195651-74v5aa2","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"大鼠内服常山碱乙吸收良好，静脉注射后很快离开血液，分布在肾最多，心、肝、肌肉、脂肪及脾次之，血中很少。只有16％左右以原形由尿排出，粪中极少，胆汁中几乎没有。"}]},{"ID":"20240612195651-1hj49hr","Type":"NodeParagraph","Properties":{"id":"20240612195651-1hj49hr","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612195651-1xcq3la","Type":"NodeParagraph","Properties":{"id":"20240612195651-1xcq3la","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 常山：拣去杂质，以水略浸泡后捞出，润透，切片，晒干。酒常山：取常山片用黄酒拌匀，稍闷润，置锅内用文火炒至略呈黄色，取出放凉，（每常山片100斤用黄酒10～20斤）醋常山：取常山片用米醋拌炒如上法。（每常山片100斤用米醋10～20斤）"}]},{"ID":"20240612195651-fdzoalg","Type":"NodeParagraph","Properties":{"id":"20240612195651-fdzoalg","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"凡使常山，春采根叶，酒浸一宿，至明漉出，日干，熬捣。\""}]},{"ID":"20240612195651-gj2ofa1","Type":"NodeParagraph","Properties":{"id":"20240612195651-gj2ofa1","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②《医学入门》：\"常山生用令人大吐，酒浸一日蒸熟或炒，或醋浸煮熟，则化痞而不吐。\""}]},{"ID":"20240612195651-bpnqp3q","Type":"NodeParagraph","Properties":{"id":"20240612195651-bpnqp3q","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612195651-y0zg3go","Type":"NodeParagraph","Properties":{"id":"20240612195651-y0zg3go","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 入肝、脾经。"}]},{"ID":"20240612195651-x4f95yi","Type":"NodeParagraph","Properties":{"id":"20240612195651-x4f95yi","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"①《雷公炮制药性解》：\"入肝经。\""}]},{"ID":"20240612195651-4aerfak","Type":"NodeParagraph","Properties":{"id":"20240612195651-4aerfak","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②《药品化义》：\"入脾经。\""}]},{"ID":"20240612195651-2khutyx","Type":"NodeParagraph","Properties":{"id":"20240612195651-2khutyx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③《要药分剂》：\"入肺、心、肝三经。\""}]},{"ID":"20240612195651-5ijghgv","Type":"NodeParagraph","Properties":{"id":"20240612195651-5ijghgv","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612195651-9cvl4o8","Type":"NodeParagraph","Properties":{"id":"20240612195651-9cvl4o8","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 苦辛，寒，有毒。"}]},{"ID":"20240612195651-lu2yhnt","Type":"NodeParagraph","Properties":{"id":"20240612195651-lu2yhnt","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，寒。\""}]},{"ID":"20240612195651-7dp1w0e","Type":"NodeParagraph","Properties":{"id":"20240612195651-7dp1w0e","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"辛，微寒，有毒。\""}]},{"ID":"20240612195651-k38f08r","Type":"NodeParagraph","Properties":{"id":"20240612195651-k38f08r","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"味苦，有小毒。\""}]},{"ID":"20240612195651-dsxx15d","Type":"NodeParagraph","Properties":{"id":"20240612195651-dsxx15d","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612195651-3doeium","Type":"NodeParagraph","Properties":{"id":"20240612195651-3doeium","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 正气虚弱，久病体弱者忌服。"}]},{"ID":"20240612195651-3va9e7c","Type":"NodeParagraph","Properties":{"id":"20240612195651-3va9e7c","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"①《雷公炮炙论》：\"勿令老人、久病服之，切忌也。\""}]},{"ID":"20240612195651-f8bkv8p","Type":"NodeParagraph","Properties":{"id":"20240612195651-f8bkv8p","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②《本草经集注》：\"畏玉札。\""}]},{"ID":"20240612195651-kd6gofk","Type":"NodeParagraph","Properties":{"id":"20240612195651-kd6gofk","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"忌葱。\""}]},{"ID":"20240612195651-q61mq52","Type":"NodeParagraph","Properties":{"id":"20240612195651-q61mq52","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"④《本草蒙筌》：\"忌鸡肉。\""}]},{"ID":"20240612195651-9ubwfhc","Type":"NodeParagraph","Properties":{"id":"20240612195651-9ubwfhc","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"⑤《本草经疏》：\"疟非由于瘴气及老痰积饮所致者勿用。\""}]},{"ID":"20240612195651-fsvr7ne","Type":"NodeParagraph","Properties":{"id":"20240612195651-fsvr7ne","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612195651-d3nvv07","Type":"NodeParagraph","Properties":{"id":"20240612195651-d3nvv07","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 除痰，截疟；治疟疾，瘰疬。"}]},{"ID":"20240612195651-sfq0206","Type":"NodeParagraph","Properties":{"id":"20240612195651-sfq0206","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主伤寒寒热，温疟，胸中痰结吐逆。\""}]},{"ID":"20240612195651-qnaiskq","Type":"NodeParagraph","Properties":{"id":"20240612195651-qnaiskq","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗水胀，洒洒恶寒，鼠瘘。\""}]},{"ID":"20240612195651-78jv0hl","Type":"NodeParagraph","Properties":{"id":"20240612195651-78jv0hl","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"治诸疟，吐痰涎，去寒热，项下瘤瘿。\""}]},{"ID":"20240612195651-xsh51ap","Type":"NodeParagraph","Properties":{"id":"20240612195651-xsh51ap","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"④《医学入门》：\"治疟母及腹中积聚，邪气痞结坚症。’"}]},{"ID":"20240612195651-zu5h5zh","Type":"NodeParagraph","Properties":{"id":"20240612195651-zu5h5zh","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"⑤《本草正》：\"治狂、痫、癫厥。\""}]},{"ID":"20240612195651-eipehxz","Type":"NodeParagraph","Properties":{"id":"20240612195651-eipehxz","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612195651-r76ns3x","Type":"NodeParagraph","Properties":{"id":"20240612195651-r76ns3x","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；或入丸、散。"}]},{"ID":"20240612195651-2hl8ci6","Type":"NodeParagraph","Properties":{"id":"20240612195651-2hl8ci6","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612195651-guoe93u","Type":"NodeParagraph","Properties":{"id":"20240612195651-guoe93u","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" ①治山岚瘴疟，寒热往来，或二日三日一发：常山（锉）、厚朴（去粗皮，生姜汁炙熟）各一两，草豆蔻（去皮），肉豆蔻（去壳）各两枚，乌梅（和核）七枚，槟榔（锉）、甘草（炙）各半两。上七味，粗捣筛，每服二钱匕，水一盏，煎至六分，去滓，候冷，未发前服，如热吃即吐。（《圣济总录》常山饮）"}]},{"ID":"20240612195651-f9g7ssi","Type":"NodeParagraph","Properties":{"id":"20240612195651-f9g7ssi","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②治阳经实疟：常山（酒炒）、草果（煨）、槟榔、厚朴、青皮、陈皮、甘草等分。水酒各半煎，露之，发日早晨温服。（《易简方》截疟七宝饮）"}]},{"ID":"20240612195651-wnighf6","Type":"NodeParagraph","Properties":{"id":"20240612195651-wnighf6","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③治胸中多痰，头疼不欲食及饮酒：常山四两，甘草半两。水七升，煮取三升，内半升蜜，服一升，不吐更服。无蜜亦可。（《补缺肘后方》）"}]},{"ID":"20240612195651-kldslhu","Type":"NodeParagraph","Properties":{"id":"20240612195651-kldslhu","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612195651-pspwk6f","Type":"NodeParagraph","Properties":{"id":"20240612195651-pspwk6f","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" ①治疗疟疾"}]},{"ID":"20240612195651-lalg54v","Type":"NodeParagraph","Properties":{"id":"20240612195651-lalg54v","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"用鸡骨常山藿香片剂，每片含常山0.08克，成人一个疗程的总量为2.64克（33片），第1天每次0.24克，第2～5天每次0.16克，日服3次，均于饭前1小时用冷开水吞服，服R后静卧半小时，服药前后1小时禁食热饮料，以防恶心呕吐。据1926例的观察：㈠症状控制：第1天观察668人，控制率59.1％；第7天观察475人，控制率91.6％。㈡疟原虫转阴：间日疟第1天观察298入，阴转率56.7％；第6天观察306人，阴转率76.8％；第7天观察304人，阴转率68.8％。三日疟第1天观察103人，阴转率25.2％；第5天观察60人，阴转率81.7％；第7天观察20人，阴转率75％。恶性疟第1天观察437人，阴转率37.1％；第5天观察412人，阴转率52.9％；第7天观察385人，阴转率47.3％。混合感染第1天观察46人，阻转率31.0％；第5天观察34人，阴转率44.1％；第7天观察29人，阴转率48.1％。㈢副作用（主要指恶心、呕吐等）：第1天观察1270人，出现率49.1％；第7天观察1033人，出现率9.3％。"}]},{"ID":"20240612195651-ynsuu3q","Type":"NodeParagraph","Properties":{"id":"20240612195651-ynsuu3q","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"常山亦可制成注射液，或配合半夏（减少呕吐反应）、柴胡等组成复方，用于治疗现症疟疾或抗复发，均有一定效果。"}]},{"ID":"20240612195651-xunzau3","Type":"NodeParagraph","Properties":{"id":"20240612195651-xunzau3","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②治疗蓝氏贾第鞭毛虫病"}]},{"ID":"20240612195651-ji4hxcs","Type":"NodeParagraph","Properties":{"id":"20240612195651-ji4hxcs","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"用常山2钱煎服，每日1次，连服7天。曾治疗1例门静脉性肝硬化腹水合并蓝氏贾第鞭毛虫病患者，服药后便溏、腹胀等症状显著改善，大便检查转阴，观察3个月未见复发。"}]},{"ID":"20240612195651-gc44k2g","Type":"NodeParagraph","Properties":{"id":"20240612195651-gc44k2g","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612195651-5eo6h9v","Type":"NodeParagraph","Properties":{"id":"20240612195651-5eo6h9v","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义补遗》：\"常山，性暴悍，善驱逐，能伤其真气，功不可偃过也。病人稍近虚怯，勿可用也。。"}]},{"ID":"20240612195651-vdrgpee","Type":"NodeParagraph","Properties":{"id":"20240612195651-vdrgpee","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"常山、蜀漆，有劫痰截疟之功，须在发散表邪及提出阳分之后，用之得宜，神效立见，用失其法，真气必伤。夫疟有六经疟，五脏疟，痰、湿、食积、瘴疫诸疟，须分阴阳虚实，不可一概论也。常山、蜀漆，生用则上行必吐，酒蒸炒熟用则气稍缓，少用亦不致吐也。得甘草则吐；得大黄则利；得乌梅、鲮鲤甲则入肝；得小麦、竹叶则入心；得秫米、麻黄则入肺；得龙骨、附子则入肾；得草果、槟榔则入脾，盖无痰不作疟，二物之功，亦在驱逐痰水而巳。杨土瀛《直指方》云，常山治疟，人皆薄之，疟家多畜痰涎黄水，或停潴心下，或结辩胁间，乃生寒热，法当吐痰逐水，常山岂容不用，水在上焦，则常山能吐之，水在胁下，则常山能破其澼而下其水，但须行血药品佐助之，必收十全之功。其有纯阳发疟，或蕴热内实之证，投以常山，大便点滴而下，似泄不泄者，须用北大黄为佐，泄利数行，然后获愈也。又李焘云，岭南瘴气，寒热所感，邪气多在营卫肉皮之间，欲去皮肤毛孔中瘴气根本，非常山不可，但性吐人，惟以七宝散冷服之，即不吐，且验也。\""}]},{"ID":"20240612195651-fpmb29y","Type":"NodeParagraph","Properties":{"id":"20240612195651-fpmb29y","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"③《本草通玄》：\"常山，世俗闻雷敦有老人、久病之戒，遂视常山为峻剂，殊不知常山发吐，惟生用与多用为然，与甘草同行，则亦必吐，若酒浸炒透，但用钱许，余每用必建奇功，未有见其或吐者也。\""}]},{"ID":"20240612195651-r62vrnk","Type":"NodeParagraph","Properties":{"id":"20240612195651-r62vrnk","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"④《药品化义》：\"常山……宣可去壅，善开结痰，凡痰滞于经络，悉能从下涌上。取味甘色黄，专入脾经而祛痰疟，盖脾虚则生痰，肝虚则发热，若三日一发者，为三阴疟，俗名三日疟是也，以此同人参小柴胡汤，去痰平肝，少用一钱，必不致于吐，即吐亦为解散，使风散食消，一二剂自愈，若不速治，因循延久，则风暑与食合为痰涎，流滞经络，名为老疟，则风暑入阴在脏，宜用血药引出阳分，而后以此截疟。第因常山气味薄而性升上，上必须吐，恐为暴悍，特酒制助其味厚，又佐以槟榔为使，沉降逐痰下行，加知母益阴，贝母清痰，共此四味为截疟神方。世嫌其性暴，不能善用，任疟至经年累月，则太愚矣，但勿多用及久用耳。\"\"常山初嚼如木无味，煎尝味甘淡带微苦，气味俱薄，亦非劫药。\""}]},{"ID":"20240612195651-1yx0mc1","Type":"NodeParagraph","Properties":{"id":"20240612195651-1yx0mc1","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"⑤《本草撮要》：\"常山，功专劫痰截疟，得知母、贝母、草果治诸疟，得丹砂能劫痰疟，得槟榔、草果治瘴疟，得甘草治肺疟，得豆豉，乌梅、竹叶治肾疟，得小麦、淡竹叶治温疟，得黄连治久疟，得云母、龙骨治牝疟独寒，得麻黄、甘草、牡蛎治牡疟独热。\""}]},{"ID":"20240612195651-yys000w","Type":"NodeParagraph","Properties":{"id":"20240612195651-yys000w","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"⑥《本草正义》：\"恒山、蜀漆，本是一物，气味皆辛苦而寒，泄热破结，降逆下气，开痰逐水，其用皆同。又《本经》、《别录》所载主治，其旨可见。《别录》乃谓蜀漆微温，恐不可信，虽《本经》以治瘴坚、痞结，积聚，似非苦寒之品所能胜任，然此物之能开结破积，皆主痰热而言，本非治凝寒积聚之痞，故所主伤寒寒热，痰结水胀，咳逆鼠瘘，邪气吐逆诸证，皆属于热痰蕴积一途，不能谓其兼疗寒证。其专主湿疟一症，则凡属疟邪往来寒热、休作有时，皆是凝痰积湿，留于经隧，古人每谓无痰不成疟、无积不成疟，若不先泄化其痰湿积滞，则病根蟠结，寒热终无休止之时。恒山之用，本为开痰迅水、涤湿化积而设，是以《本经》、《别录》均以为治疟主要之药，后人泥于仲景小柴胡汤一法，知柴胡主疟者多，而知恒山主疟者少。岂知柴胡治疟，仅主邪在经络之一部，而于痰湿积滞，不能顾及，惟渐发渐晏者为宜，而早用迟用，皆不切当；惟恒山治疟，能疏通在内之蕴结，抉其根株，则寒热之邪无所凭藉，而疟自不作，是柴胡尚治其标，而恒山乃治其本也。《仁斋直指》发明恒山主疟之真旨，最是洞澈底蕴，勘透渊微。古人又有谓其专主瘴疟者，亦以南方瘴疠之恶毒，无非湿热熏蒸，积于经隧，有以酿成此痰浊耳。李焘谓岭南瘴气感人，其邪多在营卫皮肉之间，欲去皮肤毛孔中瘴邪之根本，非常山不可。愚以为温厉之毒，多由口鼻吸入，集于肺胃，与凝痰积湿相合，遂生厉阶。恒山治瘴，亦治其在内之湿痰，非祛其在外之邪气，李氏之论，尚属似是而非。景岳并谓其治狂痫癫厥，亦取其开泄痰结，藉以镇定其火逆之上冲。惟恒山在《本草经》固明言其治吐逆，而《别录》于蜀漆条中，乃有吐出之一句，后入遂谓其为吐剂中之猛药，几有谈虎色变，望而生畏之意。虽曰蜀漆为苗，恒山为根，草木之性，每有根荄下行，茎苗上行之理，二者性质客有不同，然《本经》于蜀漆条中，亦自有治咳逆一句，既能治咳、治逆，则亦犹是泄降之品，而反谓其吐，得毋《本经》、《别录》背道而驰?惟蜀漆固自有腥涎；所以古有鸡屎草、鸭屎草之别名，其在肺胃不肃，痰饮壅积之人，触此腥涎，亦易扰动其浊气，引之作呕，而其实则能降逆开结，并不以上涌见长，抑且痰在上焦，引而越之，亦是正法，藉以祛除蕴结，夫岂不可，又安有爱而不去，养痈贻患之理?然苟洗净其涎，则止以下泄奏功，自无虑其上泛，洁古谓洗去其腥，与酸苦同用，能导胆邪，即是此旨。濒湖谓常山、蜀漆有消痰截疟之功，须在既散表邪，提出阳分之后，用之得宜，神效立见，持论极为中肯。盖常山之功，专于开泄痰浊，若邪在表分，本非其力之所及，且降逆散结，又以下行见长，若疟邪巳入阴分，则苦寒遏之，愈增抑郁之困，而更无外出之路矣。濒湖又谓生用、多用，则上行为吐，炒熟少用，亦不致吐，正以生用则腥涎未去，易于引呕，炒之则沉降之力愈专，自不上逆。又谓得甘草则吐，……分途论治，自有至理。惟破降开泄，其力亦竣，宜于实证，不宜于虚人。如久疟气虚，而无痰积者，不可妄试，丹溪已谓其性暴悍，善于驱逐，伤正气，虚怯不可用也。\""}]},{"ID":"20240612195651-u8jndld","Type":"NodeParagraph","Properties":{"id":"20240612195651-u8jndld","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612195651-z0d08r5","Type":"NodeParagraph","Properties":{"id":"20240612195651-z0d08r5","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612195651-b862s39","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195651-b862s39","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"《中华本草》：常山"}]},{"ID":"20240612195651-zv0v8vr","Type":"NodeParagraph","Properties":{"id":"20240612195651-zv0v8vr","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612195651-g33yi2k","Type":"NodeParagraph","Properties":{"id":"20240612195651-g33yi2k","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" Chánɡ Shān"}]},{"ID":"20240612195651-zwjdk33","Type":"NodeParagraph","Properties":{"id":"20240612195651-zwjdk33","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612195651-sm7nhia","Type":"NodeParagraph","Properties":{"id":"20240612195651-sm7nhia","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 互草、恒山、七叶、鸡骨常山、翻胃木、黄常山、土常山、大金刀、大常山、树盘根、一枝蓝、鸡骨风、风骨木、白常山、摆子药"}]},{"ID":"20240612195651-oaagh4j","Type":"NodeParagraph","Properties":{"id":"20240612195651-oaagh4j","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612195651-gorhuor","Type":"NodeParagraph","Properties":{"id":"20240612195651-gorhuor","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" Antifeverile Dichroa Root"}]},{"ID":"20240612195651-h6a4bm4","Type":"NodeParagraph","Properties":{"id":"20240612195651-h6a4bm4","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612195651-2rl27xi","Type":"NodeParagraph","Properties":{"id":"20240612195651-2rl27xi","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612195651-ti9bxvl","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612195651-ti9bxvl","updated":"20240612195651"},"Children":[{"ID":"20240612195651-pq2iq51","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20240612195651-pq2iq51","updated":"20240612195651"},"Children":[{"ID":"20240612195651-x63vpg8","Type":"NodeParagraph","Properties":{"id":"20240612195651-x63vpg8","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"陶弘景：常山，出宜都、建平，细实黄者，呼为鸡骨常山，用最胜。"}]}]}]},{"ID":"20240612195651-01jaa7n","Type":"NodeParagraph","Properties":{"id":"20240612195651-01jaa7n","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：常山，今京西、淮、浙、湖南州郡亦有之。海州出者，叶似楸叶，八尺，有花红白色，子碧色，似山楝子而小。五月采叶，八月采根，阴干。此二味为治疟之最要。"}]},{"ID":"20240612195651-sg398ae","Type":"NodeParagraph","Properties":{"id":"20240612195651-sg398ae","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612195651-8r5webl","Type":"NodeParagraph","Properties":{"id":"20240612195651-8r5webl","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 药材基源：为虎耳草科植物常山的根。"}]},{"ID":"20240612195651-2woan0i","Type":"NodeParagraph","Properties":{"id":"20240612195651-2woan0i","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Dichroa febrifuga Lour"}]},{"ID":"20240612195651-o0alm67","Type":"NodeParagraph","Properties":{"id":"20240612195651-o0alm67","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"采收和储藏：秋季采挖，除去茎苗及须根，洗净，晒干。"}]},{"ID":"20240612195651-3q425xh","Type":"NodeParagraph","Properties":{"id":"20240612195651-3q425xh","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612195651-tg6i5ah","Type":"NodeParagraph","Properties":{"id":"20240612195651-tg6i5ah","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔500-1200m的林缘、沟边、湿润的山地。"}]},{"ID":"20240612195651-s5obt4b","Type":"NodeParagraph","Properties":{"id":"20240612195651-s5obt4b","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"资源分布：分布江西、湖北、湖南、陕西、四川、贵州、云南、广东、福建、广西、甘肃、西藏、台湾等地。"}]},{"ID":"20240612195651-czky9t9","Type":"NodeParagraph","Properties":{"id":"20240612195651-czky9t9","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612195651-ctemf8l","Type":"NodeParagraph","Properties":{"id":"20240612195651-ctemf8l","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 常山 灌木，高1-2m。小枝绿色，常带紫色，无毛，或稀被微柔毛。叶对生；叶柄长1.5-2cm；叶形变化大，通常椭圆形、长圆形、倒卵状椭圆形，稀为披针形，长5-10cm，宽3-6cm，先端渐尖，基部楔形，边缘有密的锯齿或细锯齿；中脉上面凹陷，侧脉弯拱向上。伞房花序圆锥形；顶生，有梗；花蓝色或青紫色；花萼倒圆锥状，萼齿4-7；花瓣4-7，近肉质，花时反卷；雄蕊10-20，半数与花瓣对生，花丝扁平；子房下位，花柱5（4-6），初时基部合生。浆果蓝色，有多数种子。花期6-7月，果期8-10月。"}]},{"ID":"20240612195651-h4ng7ko","Type":"NodeParagraph","Properties":{"id":"20240612195651-h4ng7ko","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612195651-967ro62","Type":"NodeParagraph","Properties":{"id":"20240612195651-967ro62","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：喜阴凉湿润的气候，忌高温。以肥沃疏松、排水良好、腐殖质多的砂质壤土为宜。"}]},{"ID":"20240612195651-tg2x9qv","Type":"NodeParagraph","Properties":{"id":"20240612195651-tg2x9qv","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.整地：深耕30cm左右，作成高10-14cm、宽1-1.4m的高畦，如用种子繁殖，每亩可施以饼肥150-250斤及等量草木灰作基肥。"}]},{"ID":"20240612195651-i65yd22","Type":"NodeParagraph","Properties":{"id":"20240612195651-i65yd22","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.种植：可用扦插、种子、压条、分株等方法繁殖，主要是用扦插繁殖，其次是种子繁殖。"}]},{"ID":"20240612195651-28gxoa6","Type":"NodeParagraph","Properties":{"id":"20240612195651-28gxoa6","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.1.扦插繁殖法：扦插时期在每年 11月至次年3月间，剪取15cm长带有三介健全芽的插条。按行距30cm开沟，深15cm，沟的一面稍倾斜平整，将插条以3-5cm的距离排好，覆士压紧。如开穴扦插，则每穴插入3根插条，行、株距30cm见方，插后覆土压紧。"}]},{"ID":"20240612195651-k8fjjmx","Type":"NodeParagraph","Properties":{"id":"20240612195651-k8fjjmx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.2.种子繁殖法： 3月中、下旬播种。播前将种子拌和细土或细沙，均匀地撤播于苗床，稍加镇压后覆盖稻草一薄层，以保持土壤温度和湿度。幼苗生长培育至第二年秋季，按行株距30×30cm移栽。"}]},{"ID":"20240612195651-0r3t0o9","Type":"NodeParagraph","Properties":{"id":"20240612195651-0r3t0o9","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"4.田间管理：育苗期经常浇水，保持土壤湿润。清除杂草，搭棚遮荫。苗高3-4cm时，追施稀薄粪水肥1次。过密时要间苗。定植后每年须中耕除草4次，并结合培土和追肥。追肥每亩用硫酸按15斤，饼肥60斤，混合施用，或施人粪尿、过磷酸钙。在冬季则施厩肥或饼肥。"}]},{"ID":"20240612195651-mkwju8n","Type":"NodeParagraph","Properties":{"id":"20240612195651-mkwju8n","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"5.病虫害防治：病害主要为叶斑病，在发病前喷射波尔多液预防。虫害有象鼻虫、花面天蛾幼虫、金花虫、猿叶虫，发现后进行人工捕杀；并可喷射六六六粉或砒剂毒杀。"}]},{"ID":"20240612195651-59oim2g","Type":"NodeParagraph","Properties":{"id":"20240612195651-59oim2g","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612195651-vqu675u","Type":"NodeParagraph","Properties":{"id":"20240612195651-vqu675u","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 性状鉴定：干燥的根圆柱形，常分歧，弯曲扭转，长9-15cm，直径约0.5-2cm。表面黄棕色，有明显的细纵纹及支根痕迹，栓皮易剥落，显出淡黄色木质部。质坚硬，折断时有粉飞出。横断面黄白色，用水湿润后可见明显的类白色射线，放射状排列。根茎类圆柱形而近块状。横断面除中央有髓外，其他均与根的横断面相同。气微弱，味苦。以质坚实而重、形如鸡骨，表面及断面淡黄色、光滑者为佳，根粗长顺直、质松、色深黄、无苦味者不可入药。"}]},{"ID":"20240612195651-7gsb4j7","Type":"NodeParagraph","Properties":{"id":"20240612195651-7gsb4j7","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"显微鉴定：根横切面：木栓层为数列木栓细胞。皮层甚薄，少数细胞含树脂块或草酸钙针晶束。韧皮部较窄，薄壁细胞含树脂或针晶束；韧皮射线宽1-9细胞，以3-6细胞为多见。形成层成环。木质部占根的绝大部分，导管多角形，直径24-60μm，常单个散在或数个径向排列，导管内时有黄色类圆形的侵填体；木纤维小，壁强木化；木薄壁细胞多角形，壁木化；木射线宽2-9列细胞，细胞类方形。本品薄壁细胞含淀粉粒。粉末：淡黄色。"}]},{"ID":"20240612195651-yel5c7a","Type":"NodeParagraph","Properties":{"id":"20240612195651-yel5c7a","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"1.淀粉粒单粒类圆形、类椭圆形或长圆形，直径3-14μm，脐点、层纹均不明显；复粒较少，由2-3分粒组成。"}]},{"ID":"20240612195651-m8vq7hb","Type":"NodeParagraph","Properties":{"id":"20240612195651-m8vq7hb","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.草酸钙针晶多成束存在于长梭形或长圆形细胞中，针晶长约至80μm。"}]},{"ID":"20240612195651-su98uks","Type":"NodeParagraph","Properties":{"id":"20240612195651-su98uks","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.木薄壁细胞类多角形或长多角形，壁稍厚，呈连珠状，纹孔细点状，较密。"}]},{"ID":"20240612195651-4tnpzrk","Type":"NodeParagraph","Properties":{"id":"20240612195651-4tnpzrk","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"4.木纤维细长，直径12-40μm,壁稍厚，纹孔稍疏，细小。"}]},{"ID":"20240612195651-6d2cux6","Type":"NodeParagraph","Properties":{"id":"20240612195651-6d2cux6","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"5.梯状具缘纹孔导管直径约25μm.此外，可见树脂块、残存的木栓细胞。"}]},{"ID":"20240612195651-g3joldk","Type":"NodeParagraph","Properties":{"id":"20240612195651-g3joldk","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612195651-obs8pzs","Type":"NodeParagraph","Properties":{"id":"20240612195651-obs8pzs","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 小鼠口服常山碱乙、丙，兔及大鼠静脉注射常山碱丙均可致腹泻，小鼠甚至便血。狗曰服常山水浸膏或肌肉注射其酵浸膏或皮下注射常山碱甲可致恶心、呕吐、腹泻及胃肠粘膜充血出血。预先口服草酸铈，则呕吐、腹泻均减轻，故系胃肠道刺激所致。鸽静脉注射常山碱甲、乙、丙均能引起呕吐，氯丙嗪能推迟而不能阻止其呕吐的发生。狗静脉注射小量氯丙嗪不影响常山碱乙静脉注射的催吐阈量，大量能抑制其阈剂量的呕吐，但还不能对抗大剂量常山碱乙的呕吐。破坏狗的催吐化学感应区(CTZ)并不减轻常山碱乙阈剂量的呕吐，切断两侧迷走神经则大大减弱其催吐作用，完全切除胃肠道的迷走及交感神经则能完全阻止常山碱乙的呕吐。因此常山碱乙主要是刺激胃肠道的选定及交感神经末梢而反射地引起呕吐的。小鼠连续给常山碱乙或丙14天则生长受抑制，多数有腹泻，病理解剖胃肠粘膜充血或出血，肝、肾呈黄色。另有报告，重复给小鼠常1出碱丙可引起肝水肿样变性，兔静脉注射常山碱丙则能升高血糖。小鼠口服常山碱半数致死量(mg/kg)为：乙，6.57土O.47；丙，0.45土0.31；总生物碱为7.79士1.30；乙的毒性比奎宁约大150倍，总碱的毒性约为奎宁的123倍。丙口服毒性反比静脉注射大(小鼠)。"}]},{"ID":"20240612195651-tp0etps","Type":"NodeParagraph","Properties":{"id":"20240612195651-tp0etps","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"小鼠口服各种常山碱的急性半数致死量分别为：总生物碱7.79mg/kg，碱甲570mg/kg，碱乙6.57mg/kg，碱丙6.45mg/kg。小鼠静脉注射的急性半数致死量为：常山碱甲18.5mg/kg，碱乙6.5mg/kg，碱丙5mg/kg。幼龄大鼠静脉注射常山碱乙的急性MLD为20mg/kg。常山碱乙、丙各以每天0.75、0.25、0.075mg/kg给小鼠连续口服l4天，对小鼠的生长有抑制作用。在上述急性或亚急性试验中，小鼠口服常山碱后均引起腹泻，甚至便血，剖检发现胃肠粘膜充血或出血，肝、肾呈黄色。另有报道重复给小鼠服常山碱丙可引起肝水肿样变性。犬口服常山水浸膏或肌内注射其醇浸膏或皮下注射常山碱甲可致恶心、呕吐、腹泻及眉肠粘膜充血、出血。"}]},{"ID":"20240612195651-5q1mu10","Type":"NodeParagraph","Properties":{"id":"20240612195651-5q1mu10","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612195651-oypy930","Type":"NodeParagraph","Properties":{"id":"20240612195651-oypy930","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 根含总生物碱约0.1%，其中含黄常山碱乙(β-dichrorine),黄常山碱甲(α-dichrorine)及常山碱丙(γ-dichrorine)，它们是互变异构体。黄常山碱甲在加热时变为黄常山碱乙，黄常山碱乙和丙在有机溶剂中可互变。另含黄常山定碱(dichroidine),4-喹唑酮(4-puinazolinone)伞形花内酯(umbelliferone),[又名常山素(dichrin) A]和常山素(dichrin)B。从常山林中还分得草酸钙晶体，和3β-羟基-5-豆甾烯-7-酮(3βhydroxystigmast-5-en-7-one)，香草酸(vanillic acid)，八仙花酚(hydrangenol)，7-羟基-8-甲氧基香豆精(7-hydroxy-8-methoxycoumarin)，4-羟基八仙花酚(4-hydroxyhydrangenol)。"}]},{"ID":"20240612195651-dcemh89","Type":"NodeParagraph","Properties":{"id":"20240612195651-dcemh89","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612195651-it09cm4","Type":"NodeParagraph","Properties":{"id":"20240612195651-it09cm4","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 1.抗疟作用：常山水提液和醇提液对鸡疟（P. Gallinaceum）有显着疗效。常山叶（蜀漆）的抗疟效价为根的5倍但不能防止复发。常山全碱的抗疟效价约为奎宁的26倍，常山碱甲、乙、丙对鸡疟的效价分别为奎宁的1、100和150倍。常山碱乙对鸭疟（P.Lophurae）的疗效为奎宁的100倍。常山碱丙对金丝雀疟（P. Relictum）、猴疟（P. Cynomolgi）也都有效。另外，常山碱乙对鸡疟、鼠疟、猴疟都有一定的抗疟作用，对抗氯喹株也有抑制作用，其对鼠疟的50%抑制剂量为0.15±0.04mg/kg，对鸡疟为0.56±0.07mg/kg，但常山碱乙0.04mg/kg对猴疟只有轻度抑制作用。常山总提物在治疗氯喹敏感株和耐氯喹株疟原虫所致动物疟疾时，谷氨酸脱氢酶（GLDH）活力分别在治疗中的第5天和第7天消失，提示有良好疗效。"}]},{"ID":"20240612195651-a96kpfz","Type":"NodeParagraph","Properties":{"id":"20240612195651-a96kpfz","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.抗阿米巴原虫作用：常山碱乙在体外对溶组织阿米巴原虫有抑制作用，效力较盐酸依米丁强一倍。对大鼠肠阿米巴原虫，常山碱乙口服的最小有效剂量为每日1.0mg/kg，连用6天，效力大于依米丁，治疗指数也比依米丁大一倍。"}]},{"ID":"20240612195651-1mxx4g2","Type":"NodeParagraph","Properties":{"id":"20240612195651-1mxx4g2","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.抗钩端螺旋体作用：本品煎剂对钩端螺旋体有抑制作用。"}]},{"ID":"20240612195651-47a9fht","Type":"NodeParagraph","Properties":{"id":"20240612195651-47a9fht","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"4.解热作用：口服常山煎剂2g/kg，对人工发热兔有退热作用，其退热作用较柴胡显着。兔皮下注射常山醇提液0.3g/kg的解热作用与100mg/kg氨替比林相当，剂量加大到0.7g/kg时，降温程度和维持时间都超过氨替比林。大鼠口服常山碱丙，其退热作用比阿司匹林还强。"}]},{"ID":"20240612195651-cyso9cl","Type":"NodeParagraph","Properties":{"id":"20240612195651-cyso9cl","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"5.对心血管系统的作用：常山碱甲、乙、丙对麻醉狗有明显的降压作用，降压程度和持续时间与剂量有关，还有减少心收缩振幅和增加脾、肾容积的作用。对离体兔心，3种常山碱都有明显抑制作用。常山碱甲对离体蛙心，低浓度多呈现兴奋，高浓度则常呈现抑制作用，以上结果表明，常山碱的降压作用是由于心脏抑制和内脏血管扩张所致。"}]},{"ID":"20240612195651-ua46bm6","Type":"NodeParagraph","Properties":{"id":"20240612195651-ua46bm6","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"6.对平滑肌的作用：对离体兔小肠，3种常山碱均引起运动抑制。常山碱甲对离体狗小肠也有抑制作用，常山碱甲、乙对离体豚鼠小肠低浓度时抑制，高浓度时兴奋，或在短暂抑制后继以兴奋。在位犬小肠对3种常山碱的反应不一致，有时兴奋，有时抑制。常山碱对离体子宫的作用比较复杂，常山碱甲、乙对离体未孕兔与豚鼠子宫的作用一般不明显；对大鼠离体子宫，未孕者多为抑制，已孕者则常呈兴奋作用。3种常山碱对离体已孕兔子宫与在位未孕犬子宫均有兴奋作用。"}]},{"ID":"20240612195651-6uboptb","Type":"NodeParagraph","Properties":{"id":"20240612195651-6uboptb","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"7.催吐作用：鸽静脉注射常山碱甲、乙、丙可引起呕吐，常山碱乙的催吐作用与刺激胃肠道的反射作用有关。狗和猫出现呕吐的剂量分别为0.04和0.15mg/kg。"}]},{"ID":"20240612195651-g9m0ehx","Type":"NodeParagraph","Properties":{"id":"20240612195651-g9m0ehx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"8.抗病毒作用：常山水提液在试管内对流感病毒PR8有抑制作用，对感染此病毒的小鼠也有一定的治疗效果。"}]},{"ID":"20240612195651-6lt8qdx","Type":"NodeParagraph","Properties":{"id":"20240612195651-6lt8qdx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"9.抗肿瘤作用：常山总碱对小鼠艾氏腹水癌、肉瘤S180及腹水型肝癌有抑制作用。常山碱乙对小鼠艾氏腹水癌的抑瘤率为50-100%，对艾氏腹水癌实体型为45%，对肉瘤S180为45%，对小鼠黑色素瘤为75%，对大鼠腹水肝癌为55%，对大鼠肉瘤45为30%，对大鼠瓦克癌为45%。常山碱丙体外试验对艾氏腹水癌细胞也有一定杀伤作用。"}]},{"ID":"20240612195651-bux8y4o","Type":"NodeParagraph","Properties":{"id":"20240612195651-bux8y4o","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"10.其它作用：本品所含的3B-Hydroxystigmast-5-en-7-one有抗补体作用。"}]},{"ID":"20240612195651-xgxazak","Type":"NodeParagraph","Properties":{"id":"20240612195651-xgxazak","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612195651-50vyobl","Type":"NodeParagraph","Properties":{"id":"20240612195651-50vyobl","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 常山：拣去杂质，以水略浸泡后捞出，润透，切片，晒干。酒常山：取常山片用黄酒拌匀，稍闷润，置锅内用文火炒至略呈黄色，取出放凉。(每常山片100斤用黄酒10-20斤)醋常山：取常山片用米醋拌炒如上法。(每常山片100斤用米醋10-20斤)1.《雷公炮炙论》：凡使常山，春采根叶，酒浸一宿，至明漉出，日干，熬捣。"}]},{"ID":"20240612195651-405h070","Type":"NodeParagraph","Properties":{"id":"20240612195651-405h070","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.《医学入门》：常山生用令人大吐，酒浸一日蒸熟或炒，或醋浸煮熟，则化痞而不吐。"}]},{"ID":"20240612195651-6m1nv7u","Type":"NodeParagraph","Properties":{"id":"20240612195651-6m1nv7u","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612195651-0hln1kv","Type":"NodeParagraph","Properties":{"id":"20240612195651-0hln1kv","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" (1)取本品粗粉2g，加乙醇10ml，置水浴上回流15min，放冷，滤过。滤液蒸干，残渣加稀盐酸2ml搅拌，滤过。取滤液滴加碘化铋钾2滴，立即有棕红色沉淀。(检查生物碱)(2)取本品根的横断面在紫外灯(365nm)下显黄色荧光，尤以皮部更为明显。其水浸液则显天蓝色荧光，在碱性溶液中荧光加强。(检查伞形花内酯)(3)薄层色谱 取本品粗粉5g，加乙醇25ml振浸泡过夜，滤过。取滤液蒸干，加稀盐酸5ml溶解，滤过。滤液用少量氯仿振摇，分去氯仿层酸液用碳酸钠溶液中和，并调至强碱性(Ph11)，用氯仿提取2次，每次3ml，合并氯仿提取液，浓缩至约1ml，供点样用。另取常山碱甲氯仿溶液及伞形花内酯乙醚溶液点样对照。吸取两溶液点样于硅胶H-1%CMC薄层板上，氯仿-甲醇(90：10)(每5ml混合溶剂中加2滴氨水)展开，展距18cm。供试品色谱；置于紫外光灯下，在与对照品色谱中伞形花内酯相应处均显亮淡蓝色荧光；改良碘化铋钾试液显色，与对照品色谱中常山碱相应处显红色斑点。"}]},{"ID":"20240612195651-d2p6cys","Type":"NodeParagraph","Properties":{"id":"20240612195651-d2p6cys","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612195651-ebczzcu","Type":"NodeParagraph","Properties":{"id":"20240612195651-ebczzcu","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 肝；脾；肺；胃经"}]},{"ID":"20240612195651-uq8m539","Type":"NodeParagraph","Properties":{"id":"20240612195651-uq8m539","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612195651-pcgi1ng","Type":"NodeParagraph","Properties":{"id":"20240612195651-pcgi1ng","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 苦；辛；寒；有毒"}]},{"ID":"20240612195651-a5l863t","Type":"NodeParagraph","Properties":{"id":"20240612195651-a5l863t","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612195651-srw5o50","Type":"NodeParagraph","Properties":{"id":"20240612195651-srw5o50","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 正气虚弱，久病体弱者忌服。"}]},{"ID":"20240612195651-q48y4z7","Type":"NodeParagraph","Properties":{"id":"20240612195651-q48y4z7","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"1.《雷公炮炙论》：勿令老人、久病服之，切忌也。"}]},{"ID":"20240612195651-gfbpr66","Type":"NodeParagraph","Properties":{"id":"20240612195651-gfbpr66","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.《本草经集注》：畏玉札。"}]},{"ID":"20240612195651-wcbw557","Type":"NodeParagraph","Properties":{"id":"20240612195651-wcbw557","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.《药性论》：忌葱。"}]},{"ID":"20240612195651-iyfdhhv","Type":"NodeParagraph","Properties":{"id":"20240612195651-iyfdhhv","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"4.《本草蒙筌》：忌鸡肉。"}]},{"ID":"20240612195651-x8q7iog","Type":"NodeParagraph","Properties":{"id":"20240612195651-x8q7iog","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"5.《本草经疏》：疟非由于瘴气及老痰积饮所致者勿用。"}]},{"ID":"20240612195651-9btzrau","Type":"NodeParagraph","Properties":{"id":"20240612195651-9btzrau","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612195651-edq9c60","Type":"NodeParagraph","Properties":{"id":"20240612195651-edq9c60","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 劫痰；截疟。主疟疾，胸中痰饮积聚。"}]},{"ID":"20240612195651-n0sr8x2","Type":"NodeParagraph","Properties":{"id":"20240612195651-n0sr8x2","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612195651-qqmerxa","Type":"NodeParagraph","Properties":{"id":"20240612195651-qqmerxa","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤， 5-10g；或入丸、散。"}]},{"ID":"20240612195651-8w0kgv9","Type":"NodeParagraph","Properties":{"id":"20240612195651-8w0kgv9","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612195651-vzy0lvx","Type":"NodeParagraph","Properties":{"id":"20240612195651-vzy0lvx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" ①治山岚瘴疟，寒热往来，或二日三日一发： 常山(锉)、厚朴(去粗皮，生姜汁炙熟)各一两，草豆蔻(去皮)、肉豆蔻(去壳)各两枚，乌梅(和核)七枚，槟榔(锉)、甘草(炙)各半两。上七味，粗捣筛，每服二钱匕，水一盏，煎至六分，去滓，候冷，未发前服，如热吃即吐。 (《圣济总录》常山饮)②治阳经实疟： 常山(酒炒)、草果(煨)、槟榔、厚朴、青皮、陈皮、甘草等分。水酒各半煎，露之，发日早晨温服。(《易简方》截疟七宝次)③治胸中多痰，头疼不欲食及饮酒： 常山四两， 甘草半两。水七升，煮取三升，内半升蜜，服一升，不吐更服。无蜜亦可。 (《补缺肘后方》)"}]},{"ID":"20240612195651-5y35q0r","Type":"NodeParagraph","Properties":{"id":"20240612195651-5y35q0r","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612195651-99k9f39","Type":"NodeParagraph","Properties":{"id":"20240612195651-99k9f39","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 1.治疗疟疾：用鸡骨常山藿香片剂，每片含常山0.08g，成人一个疗程的总量为2.64g(33片)，第1天每次0.24g，第2-5天每次0.16g，日服3次，均于饭前 1小时用冷开水香服，服后静卧半小时，服药前后1小时禁食热饮料，以防恶心呕吐。据1926例的观察：1.1.症状控制：第 1天观察668人，控制率59.1%；第7天观察475人，控制率91.6%。"}]},{"ID":"20240612195651-zyfb85v","Type":"NodeParagraph","Properties":{"id":"20240612195651-zyfb85v","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"1.2.疟原虫转阴：间日疟第 1天观察298人，阴转率56.7%；第5天察306人，阴转率76.3%；第7天观察304人，阴转率68．8%。三日疟第1天观察103人，阴转率25.2%；第5天观察60人，阴转率81.7%；第7天观察20人，阴转率75%。恶性疟第1天观察437人，阴转率37.1%；第5天观察412人，阴转率52.9%；第7天观察385人，阴转率47.3%。混合感染第 1天观察46人，阴转率31.0%；第5天观察34人，阴转率44.1%；第7天观察29人，阴转率48.1%。"}]},{"ID":"20240612195651-4kbnzlx","Type":"NodeParagraph","Properties":{"id":"20240612195651-4kbnzlx","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"1.3.副作用(主要指恶心、呕吐等)：第1天观察1270人，出现率49.1%；第7天观察1033人，出现率9.3%。常山亦可制成注射液，或配合半夏(减少呕吐反应)、柴胡等组成复方，用于治疗观症疟疾或抗复发，均有一定效果。"}]},{"ID":"20240612195651-kmolg23","Type":"NodeParagraph","Properties":{"id":"20240612195651-kmolg23","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.治疗蓝氏贾第鞭毛虫病：用常山2钱煎服，每日1次，连服7天。曾治疗 1例门静脉性肝硬化腹水合并蓝氏贾第鞭毛虫病患者，服药后便溏、腹胀等症状显着改善，大便检查转阴，观察3个月未见复发。"}]},{"ID":"20240612195651-5543upw","Type":"NodeParagraph","Properties":{"id":"20240612195651-5543upw","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612195651-5u6m5pm","Type":"NodeParagraph","Properties":{"id":"20240612195651-5u6m5pm","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义补遗》：常山，性暴悍，善驱逐，能伤其真气，功不可偃过也。病人稍近虚怯，勿可用也。"}]},{"ID":"20240612195651-avh32e8","Type":"NodeParagraph","Properties":{"id":"20240612195651-avh32e8","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"2.《纲目》：常山、蜀漆，有劫痰截疟之功，须在发散表邪及提出阳分之后，用之得宜，神效立见，用失其法，真气必伤。夫疟有六经疟，五脏疟，痰、湿、食积、瘴疫诸疟，须分阴阳虚实，不可一概论也。常山、蜀漆，生用则上行必吐，酒蒸炒熟用则气稍缓，少用亦不致吐也。得甘草则吐；得大黄则利；得乌梅、鲮鲤甲则入肝：得小麦、竹叶则入心；得秫米、麻黄则入肺；得龙骨、附子则入肾；得草果、槟榔则入脾，盖无痰不作疟，二物之功，亦在驱逐痰水而已。杨士瀛《直指方》云，常山治疟，人皆薄之，疟家多畜痰涎黄水，或停潴心下，或结澼胁间，乃生寒热，法当吐痰逐水，常山岂容不用，水在上焦，则常山能吐之，水在胁下，则常山能破其澼而下其水，但须行血药品佐助之，必收十全之功。其有纯阳发疟，或蕴热内实之证，投以常山，大便点滴而下，似泄不泄者，须用北大黄为佐，泄利数行，然后获愈也。又李焘云，岭南瘴气，寒热所感，邪气多在营卫肉皮之间，欲去皮肤毛孔中瘴气根本，非常山不可，但性吐入，惟以七宝散冷服之，即不吐，且验也。"}]},{"ID":"20240612195651-x0jnh4o","Type":"NodeParagraph","Properties":{"id":"20240612195651-x0jnh4o","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"3.《本草通玄》：常山，世俗闻雷斆有老人、久病之戒，透视常山为峻剂，殊不知常山发吐，惟生用与多用为然，与甘草同行，则亦必吐，若酒浸炒透，但用钱许，余每用必建奇功，未有见其或吐者也。"}]},{"ID":"20240612195651-jsnn7h0","Type":"NodeParagraph","Properties":{"id":"20240612195651-jsnn7h0","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"4.《药品化义》：常山宣可去壅，善开结痰，凡痰滞于经络，悉能从下涌上。取味甘色黄，专人脾经而祛痰疟，盖脾虚则生痰，肝虚则发热，若三日一发者，为三阴疟，俗名三日疟是也，以此同人参小柴胡汤，去痰平肝，少用一钱，必不致于吐，即吐亦为解散，使风散食消，一二剂自愈，若不速治，因循延久，则风署与食台为痰涎，流滞经络，名为者疟，则风暑八阴在脏，宜用血药引出阳分，而后以此截疟。 第因常山气味薄而性升上，上必须吐，恐为暴悍，特酒制助其味厚，又佐以槟榔为使，沉降逐痰下行，加知母益阴，贝母清痰，共此四味为截疟神方。世嫌其性暴，不能善用，任疟至经年累月，则太愚矣，但匆多用及久用耳。常山初嚼如木无味，煎尝味甘淡带微苦，气味惧薄，亦非劫药。"}]},{"ID":"20240612195651-ekd1inj","Type":"NodeParagraph","Properties":{"id":"20240612195651-ekd1inj","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"5.《本草撮要》：常山，功专劫痰截疟，得知母、贝母、草果治诸疟，得丹砂能劫痰疟，得槟榔、草果治瘴疟，得甘草治肺疟，得豆豉、乌梅、竹叶治肾疟，得小麦、淡竹叶治温疟，得黄连治久疟，得云母、龙骨治牝疟独寒，得麻黄、甘草、牡蛎治牡疟独热。"}]},{"ID":"20240612195651-v47m5e0","Type":"NodeParagraph","Properties":{"id":"20240612195651-v47m5e0","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"6.《本草正义》：恒山、蜀漆，本是一物，气味皆辛苦而寒，泄热破结，降逆下气，开痰逐水，其用皆同。又《本经》、《别录》所载主治，其旨可见。《别录》乃谓蜀漆微温，恐不可信，虽《本经》以治症坚、痞结、积聚，似非苦寒之品所能胜任，然此物之能开结破积，皆主痰热而言，本非治凝寒积聚之痞，故所主伤寒寒热，痰结水胀，咳逆鼠瘘，邪气吐逆诸证，皆属于热痰蕴积一途，不能谓其兼疗寒证。其专主湿疟一症，则凡属疟邪往来寒热、休作有时，皆是凝痰积湿，留于经隧，古人每谓无痰不成疟、无积不成疟，若不先泄化其痰湿积滞，则病根蟠结，寒热终无休止之时。恒山之用，本为开痰逐水、涤湿化积而设，是以《本经》、《别录》均以为治疟主要之药，后人泥于仲景小柴胡汤一法，知柴胡主疟者多，而知恒山主疟者少。岂知柴胡治疟，仅主邪在经给之一部，而于痰湿积滞，不能顾及，惟渐发渐曼者为宜，而早用迟用，皆不切当；惟恒山治疟，能疏通在内之蕴结，抉其根株，则寒热之邪无所凭藉，而疟自不作，是柴胡尚治其标，而恒山乃治其本也。"}]},{"ID":"20240612195651-r3nzqs7","Type":"NodeParagraph","Properties":{"id":"20240612195651-r3nzqs7","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"7.《本经》：主伤寒寒热，温疟，胸中痰结吐逆。"}]},{"ID":"20240612195651-wvpa6zl","Type":"NodeParagraph","Properties":{"id":"20240612195651-wvpa6zl","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"8.《别录》：疗水胀，洒洒恶寒，鼠瘘。"}]},{"ID":"20240612195651-qyv956z","Type":"NodeParagraph","Properties":{"id":"20240612195651-qyv956z","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"9.《药性论》：治诸疟，吐痰涎，去寒热，项下瘤瘿。"}]},{"ID":"20240612195651-f4kh0bq","Type":"NodeParagraph","Properties":{"id":"20240612195651-f4kh0bq","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"10.《医学入门》：治疟母及腹中积聚，邪气痞结坚症。"}]},{"ID":"20240612195651-87kxyy5","Type":"NodeParagraph","Properties":{"id":"20240612195651-87kxyy5","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"11.《本草正》：治狂、痫、癫厥。"}]},{"ID":"20240612195651-xnk5ogz","Type":"NodeParagraph","Properties":{"id":"20240612195651-xnk5ogz","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612195651-mnfd6yh","Type":"NodeParagraph","Properties":{"id":"20240612195651-mnfd6yh","updated":"20240612195651"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612195652-pj54h93","Type":"NodeThematicBreak","Properties":{"id":"20240612195652-pj54h93"}},{"ID":"20240612195653-yxaxdiu","Type":"NodeParagraph","Properties":{"id":"20240612195653-yxaxdiu"}}]}