eCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 476px;\" parent-style=\"width: 486px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 485px;","style":"width: 475px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"常山 (14)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/常山 14-20240823094153-w5gwx5t.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 475px;\" parent-style=\"width: 485px;\"}"},{"Type":"NodeText","Data":"​​​"}]},{"ID":"20240823100622-vvtd9se","Type":"NodeParagraph","Properties":{"id":"20240823100622-vvtd9se","updated":"20240823100622"}},{"ID":"20240823100622-m7uibxq","Type":"NodeParagraph","Properties":{"id":"20240823100622-m7uibxq","updated":"20240823100622"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"鸡骨常山"}]},{"ID":"20240823100622-wiy0fz5","Type":"NodeParagraph","Properties":{"id":"20240823100622-wiy0fz5","updated":"20240823100622"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产湖南、湖北、四川、贵州等地。\n【性状】\t主根多粗直而长，有的呈圆柱形作不规则弯曲扭转，直径6"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"~"}]},{"Type":"NodeText","Data":"20mm；侧根多数，并有无数细根，表面灰棕色，具不规则纵横裂纹。质坚硬，不易折断，断面黄白色或淡黄色，皮部厚，鲜时易剥离，内面光滑，富有粘质。外形极似常山，但断面为白心，故称“白常山”。气微，味淡。饮片呈淡黄色。\n【性味】\t苦、辛，寒，有毒。\n【功效】\t解热抗疟，解毒。主治疟疾，涌吐痰涎。\n【注解】\t“鸡骨常山”：指质地坚硬，枯瘦无光，状如鸡骨的常山。"}]},{"ID":"20240823100622-rgil7ml","Type":"NodeParagraph","Properties":{"id":"20240823100622-rgil7ml","updated":"20240823100622"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206082300-5mh54f1.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​​​"}]},{"ID":