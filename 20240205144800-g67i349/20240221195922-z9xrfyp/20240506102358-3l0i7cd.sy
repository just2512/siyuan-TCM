{"ID":"20240506102358-3l0i7cd","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240506102358-3l0i7cd","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102358-3l0i7cd\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506102358-k2yq7xq\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240506102358-k2yq7xq\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240506102358-k2yq7xq\u0026quot;,\u0026quot;focusStart\u0026quot;:0,\u0026quot;focusEnd\u0026quot;:0\u0026#125;","title":"277钩吻（断肠草）","type":"doc","updated":"20240830090626"},"Children":[{"ID":"20240628132036-6mchg03","Type":"NodeParagraph","Properties":{"id":"20240628132036-6mchg03","updated":"20240628132039"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 405px;","style":"width: 395px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628132036-pjp2twk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 395px;\" parent-style=\"width: 405px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628131832-vnskoh5","Type":"NodeParagraph","Properties":{"id":"20240628131832-vnskoh5","updated":"20240628141826"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 352px;","style":"width: 342px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628131832-9gkxlyd.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 342px;\" parent-style=\"width: 352px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822175333-rrw5lo8","Type":"Node