pe":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628132340-w7fjgcr.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 600px;\" parent-style=\"width: 610px;\"}"},{"Type":"NodeText","Data":"​​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 545px;","style":"width: 535px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628142019-0ffluwe.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 535px;\" parent-style=\"width: 545px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822175445-q33t5v6","Type":"NodeParagraph","Properties":{"id":"20240822175445-q33t5v6","updated":"20240822175554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 786px;","style":"width: 776px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"钩吻"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/钩吻-20240822175445-bnxl63h.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 776px;\" parent-style=\"width: 786px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 355px;","style":"width: 345px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"钩吻 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/钩吻 1-20240822175554-t3ioqzs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 345px;\" parent-style=\"width: 355px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628142313-o5dqsde","Type":"NodeParagraph","Properties":{"id":"20240628142313-o5dqsde","updated":"20240822175650"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"钩吻 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/钩吻 2-20240822175650-gruqsyg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 507px;","style":"width: 497px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628142345-w81jj6b.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 497px;\" parent-style=\"width: 507px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240830090049-amohb6j","Type":"NodeParagraph","Properties":{"id":"20240830090049-amohb6j","updated":"20240830090230"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 398px;","style":"width: 388px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"钩吻 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/钩吻 3-20240830090049-xbe2nmk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 388px;\" parent-style=\"width: 398px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 928px;","style":"width: 918px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"钩吻 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/钩吻 4-20240830090230-jutjmuj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 918px;\" parent-style=\"width: 928px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612193613-u7k45sx","Type":"NodeParagraph","Properties":{"id":"20240612193613-u7k45sx","updated":"20240822175401"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：钩吻有剧毒，与金银花略相似，需仔细甄别。"}]},{"ID":"20240830090239-gqv4soh","Type":"NodeParagraph","Properties":{"id":"20240830090239-gqv4soh","updated":"20240830090626"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"二注："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color8);"},"TextMarkType":"strong text","TextMarkTextContent":"整理‘五指毛桃’篇过程中，发现不少视频创作者特地提到当*指毛桃两米以内出现‘断肠草’时不能将*指毛桃根部挖来煲汤，否则坐等开席（个人感觉是怕有人误挖到断肠草的根）；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color8);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"断肠草有剧毒，甚而至于有评论称山顶上有断肠草时整个山的东西都别碰，因为下雨水会携带毒性流下来，虽然这种说法略显夸张，但也反映了断肠草毒性之强；所以如果没有专业人士的指导，还是谨遵老人言，免得吃亏在眼前；"}]},{"ID":"20240612193613-pn3c4fk","Type":"NodeThematicBreak","Properties":{"id":"20240612193613-pn3c4fk"}},{"ID":"20240612193653-j3vr6py","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193653-j3vr6py","updated":"20240612193658"},"Children":[{"Type":"NodeText","Data":"钩吻《神农本草经》"}]},{"ID":"20240612193653-7hy2cmd","Type":"NodeParagraph","Properties":{"id":"20240612193653-7hy2cmd","updated":"20240612193653"},"Children":[{"Type":"NodeText","Data":"（《御览》作肠）"}]},{"ID":"20240612193653-1k1dwy2","Type":"NodeParagraph","Properties":{"id":"20240612193653-1k1dwy2","updated":"20240612193653"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240612193653-6ztob1j","Type":"NodeParagraph","Properties":{"id":"20240612193653-6ztob1j","updated":"20240612193653"},"Children":[{"Type":"NodeText","Data":"主金创乳痓，中恶风，咳逆上气，水肿，杀鬼注（旧作，《御览》作注，是）蛊毒。一名野葛。生山谷。"}]},{"ID":"20240612193653-rsdhukb","Type":"NodeParagraph","Properties":{"id":"20240612193653-rsdhukb","updated":"20240612193653"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：秦钩肠一名毒根，一名野葛，神农辛，雷公有毒杀人，生南越山，或益州，叶如葛，赤茎大如箭、方、根、黄，或生会稽东冶，正月采（《御览》）。"}]},{"ID":"20240612193653-74jzh2h","Type":"NodeParagraph","Properties":{"id":"20240612193653-74jzh2h","updated":"20240612193653"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生傅高山，及会稽东野。"}]},{"ID":"20240612193653-7phs6kj","Type":"NodeParagraph","Properties":{"id":"20240612193653-7phs6kj","updated":"20240612193653"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：莨钩吻也。《淮南子》说林训云：蝮蛇螫人，傅以和堇则愈。高诱云：和堇，野葛，毒药。《博物志》云：钩吻毒，桂心葱叶沸解之。陶宏景云：或云钩吻是毛莨。沈括补笔谈云：闽中人呼为吻莽，亦谓之野葛，岭南人谓之胡蔓，俗谓之断肠草，此草人间至毒之物，不入药用，恐本草所出别是一物，非此钩吻也。"}]},{"ID":"20240612193714-appausm","Type":"NodeThematicBreak","Properties":{"id":"20240612193714-appausm"}},{"ID":"20240612193716-05i0g4v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193716-05i0g4v","updated":"20240612193723"},"Children":[{"Type":"NodeText","Data":"钩吻《医学入门》"}]},{"ID":"20240612193716-ro8k350","Type":"NodeParagraph","Properties":{"id":"20240612193716-ro8k350","updated":"20240612193716"},"Children":[{"Type":"NodeText","Data":"得太阴之精，食之钩入喉吻。味辛、温，大毒。主中恶风，咳逆上气，水肿 积，除脚膝痹痛、四肢拘挛，杀儿疰蛊毒，金疮乳 ，恶疮疥虫，杀鸟兽。误中其毒，以桂心，葱叶沸汤解之，忌冷水。捣自然汁入膏中用，勿误饵之。"}]},{"ID":"20240612193805-ohx4nfz","Type":"NodeThematicBreak","Properties":{"id":"20240612193805-ohx4nfz"}},{"ID":"20240612193806-ughegkq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193806-ughegkq","updated":"20240612193811"},"Children":[{"Type":"NodeText","Data":"钩吻《增广和剂局方药性总论》"}]},{"ID":"20240612193806-gnhlibf","Type":"NodeParagraph","Properties":{"id":"20240612193806-gnhlibf","updated":"20240612193806"},"Children":[{"Type":"NodeText","Data":"味辛，温，有大毒。主金疮，乳 痉，中恶风，咳逆上气，水肿，杀鬼疰蛊毒，破症积除脚膝痹痛，四肢拘挛，恶疮疥虫，杀鸟兽。《蜀本》云∶主喉痹，咽中塞，声变，咳逆气，温中。半夏为使。恶∶黄芩。野葛毒草误食则用羊血解之。一名野葛。"}]},{"ID":"20240612194053-fgknys3","Type":"NodeThematicBreak","Properties":{"id":"20240612194053-fgknys3"}},{"ID":"20240612194055-mz59nka","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612194055-mz59nka","updated":"20240612194059"},"Children":[{"Type":"NodeText","Data":"钩吻《千金翼方》"}]},{"ID":"20240612194055-75c8cz0","Type":"NodeParagraph","Properties":{"id":"20240612194055-75c8cz0","updated":"20240612194055"},"Children":[{"Type":"NodeText","Data":"味辛，温，有大毒。主金疮乳 ，中恶风，咳逆上气，水肿，杀鬼疰蛊毒，破症积，除脚膝痹痛，四肢拘挛，恶疮疥虫，杀鸟兽。一名野葛。折之青烟出者名固活，甚热，不入汤。"}]},{"ID":"20240612194055-d4iy1y6","Type":"NodeParagraph","Properties":{"id":"20240612194055-d4iy1y6","updated":"20240612194055"},"Children":[{"Type":"NodeText","Data":"生傅高山谷及会稽东野。"}]},{"ID":"20240612193754-gdqi2dg","Type":"NodeThematicBreak","Properties":{"id":"20240612193754-gdqi2dg"}},{"ID":"20240612193755-6t0fe3k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193755-6t0fe3k","updated":"20240612193800"},"Children":[{"Type":"NodeText","Data":"钩吻《本经逢原》"}]},{"ID":"20240612193755-szypn3r","Type":"NodeParagraph","Properties":{"id":"20240612193755-szypn3r","updated":"20240612193755"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名野葛，红花者名火把草，黄花者名黄藤，《千金》名黄野葛"}]},{"ID":"20240612193755-oiobyzg","Type":"NodeParagraph","Properties":{"id":"20240612193755-oiobyzg","updated":"20240612193755"},"Children":[{"Type":"NodeText","Data":"辛温，大毒。"}]},{"ID":"20240612193755-a555ldh","Type":"NodeParagraph","Properties":{"id":"20240612193755-a555ldh","updated":"20240612193755"},"Children":[{"Type":"NodeText","Data":"《本经》主金疮乳 中恶风，咳逆上气，水肿，杀鬼疰蛊毒。"}]},{"ID":"20240612193755-du64kne","Type":"NodeParagraph","Properties":{"id":"20240612193755-du64kne","updated":"20240612193755"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"野葛之毒甚于戈戟，故有钩吻之名。而风毒蛊疰用之以毒攻毒，苟非大剧。亦难轻用。紫者破血结，青者破痰积。其叶与黄精叶相似，但钩吻叶有毛钩二个，黄精叶似竹叶而无毛钩，可以明辨。误食钩吻叶，饮冷水即死，以死尸悬树上汁滴在地即生菌子，收之名菌药。毒于野葛，蕹菜捣汁解之，取蕹菜汁滴野葛苗即萎死。中野葛毒，急不可得蕹菜，多饮甘草汁、人屎汁，或白鸭血、白鹅血、羊血灌之亦解。"}]},{"ID":"20240612193740-1srbzr8","Type":"NodeThematicBreak","Properties":{"id":"20240612193740-1srbzr8"}},{"ID":"20240612193741-qan4z48","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193741-qan4z48","updated":"20240612193746"},"Children":[{"Type":"NodeText","Data":"钩吻《神农本草经赞》"}]},{"ID":"20240612193741-lc78ijs","Type":"NodeParagraph","Properties":{"id":"20240612193741-lc78ijs","updated":"20240612193741"},"Children":[{"Type":"NodeText","Data":"味辛温。主金创乳。中恶风。咳逆上气。水肿。杀鬼注蛊毒。一名野葛。生山谷。"}]},{"ID":"20240612193741-b1hg9zo","Type":"NodeParagraph","Properties":{"id":"20240612193741-b1hg9zo","updated":"20240612193741"},"Children":[{"Type":"NodeText","Data":"预储蕹汁。救扑炎炀。箭喷裂吻。蔓绕屠肠。避栖飞鸟。饱饫肥羊。黄精益寿。美恶分详。"}]},{"ID":"20240612193741-pqagk8e","Type":"NodeParagraph","Properties":{"id":"20240612193741-pqagk8e","updated":"20240612193741"},"Children":[{"Type":"NodeText","Data":"陈藏器曰。蕹菜捣汁。解野葛毒。李时珍曰。滇人谓之火把花。言其性热如火。东方朔文。"}]},{"ID":"20240612193741-8trt0of","Type":"NodeParagraph","Properties":{"id":"20240612193741-8trt0of","updated":"20240612193741"},"Children":[{"Type":"NodeText","Data":"吹天火之炎炀。吴普曰。赤茎如箭。苏恭曰。蔓生与白花藤相类。苏舜钦诗。獠工裂吻燥。"}]},{"ID":"20240612193741-pufbwbt","Type":"NodeParagraph","Properties":{"id":"20240612193741-pufbwbt","updated":"20240612193741"},"Children":[{"Type":"NodeText","Data":"战国策。聂政抉目屠肠。陶弘景曰。钩人喉吻。牵挽人肠。五符经言。飞鸟不得集。苏恭曰。羊食其苗。大肥。物有相伏如此。博物志。人信钩吻杀人。不信黄精益寿。不亦惑乎。李时珍曰。此以二草。美恶对待而言。陶氏。雷氏。韩氏。言相似者误。"}]},{"ID":"20240612193728-89iry7u","Type":"NodeThematicBreak","Properties":{"id":"20240612193728-89iry7u"}},{"ID":"20240612193729-duxpim0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193729-duxpim0","updated":"20240612193733"},"Children":[{"Type":"NodeText","Data":"钩吻《本草纲目》"}]},{"ID":"20240612193850-jnn7fw3","Type":"NodeParagraph","Properties":{"id":"20240612193850-jnn7fw3","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"钩吻"}]},{"ID":"20240612193850-jgogkdp","Type":"NodeParagraph","Properties":{"id":"20240612193850-jgogkdp","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"（《本经》下品）"}]},{"ID":"20240612193850-kmo4dsb","Type":"NodeParagraph","Properties":{"id":"20240612193850-kmo4dsb","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"〖释名〗野葛（《本经》）毒根（《吴普》）胡蔓草（《图经》）断肠草（《纲目》）黄藤（《纲目》）火把花（〔弘景曰〕言其入口则钩人喉吻也。或言：吻当作挽字，牵挽人肠而绝之也。〔时珍曰〕此草虽名野葛，非葛根之野者也。或作冶葛。王充《论衡》云：冶，地名也，在东南。其说甚通。广人谓之胡蔓草，亦曰断肠草。入人畜腹内，即粘肠上，半日则黑烂，又名烂肠草。滇人谓之火把花，因其花红而性热如火也。岳州谓之黄藤）"}]},{"ID":"20240612193850-22pz5a3","Type":"NodeParagraph","Properties":{"id":"20240612193850-22pz5a3","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"〖集解〗〔《别录》曰〕钩吻生傅高山谷及会稽东野，折之青烟出者，名固活。二月、八月采。〔普曰〕秦钩吻一名除辛，生南越山及寒石山，或益州。叶如葛，赤茎大如箭而方，根黄色，正月采之。〔普曰〕野葛生桂州以南，村墟闾巷间皆有。彼人通名钩吻，亦谓苗为钩吻，根名野葛。蔓生。其叶如柿。其根新采者，皮白骨黄。宿根似地骨，嫩根如汉防己，皮节断者良。正与白花藤相类，不深别者，颇亦惑之。新者折之无尘气。经年以后则有尘起，从骨之细孔中出。今折枸杞根亦然。《本草》言折之青烟起者名固活为良，亦不达之言也。人误食其叶者致死，而羊食其苗大肥，物有相伏如此。《博物志》云，钩吻蔓生，叶似凫葵，是也。〔时珍曰〕嵇含《南方草木状》云：野葛蔓生，叶如罗勒，光而厚，一名胡蔓草。人以杂生蔬中毒人，半日辄死。段成式《酉阳杂俎》云：胡蔓草生邕州、容州之间。丛生。花扁如栀子而稍大，不成朵，色黄白。其叶稍黑。又按：《岭南卫生方》云：胡蔓草叶如茶，其花黄而小。一叶入口，百窍溃血，人无复生也。时珍又访之南人云：钩吻即胡蔓草，今人谓之断肠草是也。蔓生，叶圆而光。春夏嫩苗毒甚，秋冬枯老稍缓。五六月开花似榉柳花，数十朵作穗。生岭南者花黄，生滇南者花红，呼为火把花。此数说皆与吴普、苏恭说相合。陶弘景等别生分辨，并正于下。"}]},{"ID":"20240612193850-pwejlt6","Type":"NodeParagraph","Properties":{"id":"20240612193850-pwejlt6","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"〖正误〗〔弘景曰〕《五符经》亦言钩吻是野葛。核事而言，似是两物。野葛是根，状如牡丹，所生处亦有毒，飞鸟不得集，今人用合膏服之无嫌。钩吻别是一物，叶似黄精而茎紫，当心抽花，黄色，初生极类黄精，故人采多惑之，遂致死生之反。或云钩吻是毛茛，参错不同，未详云何?〔斅曰〕凡使黄精勿用钩吻，真似黄精，只是叶有毛钩子二个。黄精叶似竹叶。又曰：凡使钩吻，勿用地精，茎苗相同。钩吻治人身上恶毒疮，其地精杀人也。〔恭曰〕钩吻蔓生，叶如柿。陶言飞鸟不集者，妄也。黄精直生，叶似柳及龙胆草，殊非比类。毛茛乃有毛石龙芮，与钩吻何干。〔颂曰〕江南人说黄精茎苗稍类钩吻。但钩吻叶头极尖而根细，与苏恭所说不同，恐南北之产异也。〔禹锡曰〕陶说钩吻似黄精者，当是。苏说似柿叶者，别是一物也。又言苗名钩吻，根名野葛者，亦非通论。〔时珍曰〕《神农本草》钩吻一名野葛，一句已明。（《草木状》又名胡蔓草，显是藤生。吴普、苏恭所说正合本文。陶氏以藤生为野葛，又指小草为钩吻，复疑是毛茛，乃祖雷斅之说。诸家遂无定见，不辨其蔓生、小草，相去远也。然陶、雷所说亦是一种有毒小草，但不得指为钩吻尔。昔天姥对黄帝言：黄精益寿，钩吻杀人。乃是以二草善恶比对而言。陶氏不审，疑是相似，遂有此说也。余见黄精下。"}]},{"ID":"20240612193850-sh6olp8","Type":"NodeParagraph","Properties":{"id":"20240612193850-sh6olp8","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"〖气味〗辛，温，大有毒。（〔普曰〕神农：辛。雷公：有毒杀人。〔时珍曰〕其性大热。本草毒药止云有大毒，此独变文曰大有毒，可见其毒之异常也。〔之才曰〕半夏为之使，恶黄芩）"}]},{"ID":"20240612193850-h1qlu6e","Type":"NodeParagraph","Properties":{"id":"20240612193850-h1qlu6e","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"〖主治〗金疮乳痉，中恶风，咳逆上气，水肿，杀鬼疰蛊毒。（《本经》）破癥积，除脚膝痹痛，四肢拘挛，恶疮疥虫，杀鸟兽。捣汁入膏中，不入汤饮。（《别录》）主喉痹咽塞，声音变。（《吴普》）"}]},{"ID":"20240612193850-crttrl4","Type":"NodeParagraph","Properties":{"id":"20240612193850-crttrl4","updated":"20240612193850"},"Children":[{"Type":"NodeText","Data":"〖发明〗〔藏器曰〕钩吻食叶，饮冷水即死，冷水发其毒也。彼土毒死人悬尸树上，汁滴地上生菌子，收之名菌药，烈于野葛也。蕹菜捣汁，解野葛毒。取汁滴野葛苗即萎死。南人先食蕹菜，后食野葛，二物相伏，自然无苦。魏武帝啖野葛至尺，先食此菜也。〔时珍曰〕按：李石《续博物志》云：胡蔓草出二广。广人负债急，每食此草而死，以诬人。以急水吞即死急，慢水吞死稍缓。或取毒蛇杀之，覆以此草，浇水生菌，为毒药害人。葛洪《肘后方》云：凡中野葛毒口不可开者，取大竹筒洞节，以头拄其两胁及脐中。灌冷水入筒中，数易水。须臾口开，乃可下药解之。惟多饮甘草汁、人屎汁。白鸭或白鹅断头沥血，入口中，或羊血灌之。《岭南卫生方》云：即时取鸡卵抱未成雏者，研烂和麻油灌之。吐出毒物乃生，稍迟即死也。"}]},{"ID":"20240612194036-ttg1ow5","Type":"NodeThematicBreak","Properties":{"id":"20240612194036-ttg1ow5"}},{"ID":"20240612194038-3vrugva","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612194038-3vrugva","updated":"20240612194043"},"Children":[{"Type":"NodeText","Data":"钩吻《新修本草》"}]},{"ID":"20240612194038-kdq8qua","Type":"NodeParagraph","Properties":{"id":"20240612194038-kdq8qua","updated":"20240612194038"},"Children":[{"Type":"NodeText","Data":"味辛，温，有大毒。主金创乳 ，中恶风，咳逆上气，水肿，杀鬼疰蛊毒。破症积，除脚膝痹痛，四肢拘挛，恶疮疥虫，杀鸟兽。一名野葛。折之青烟出者名固活。甚热，不入汤。生秦钩吻，味辛。疗喉痹，咽中寒，声变，咳逆气，温中。一名除辛，一名毒根。生寒石山，二月、八月采。"}]},{"ID":"20240612194038-plq65vu","Type":"NodeParagraph","Properties":{"id":"20240612194038-plq65vu","updated":"20240612194038"},"Children":[{"Type":"NodeText","Data":"半夏为之使，恶黄芩。五符中亦云，钩吻是野葛，言其入口能钩人喉吻，或言吻作挽字，牵言，乃是两物。野葛是根，状如牡丹，所生处亦有毒，飞鸟不得集之，今人用合膏服之无嫌。"}]},{"ID":"20240612194038-rwi6eap","Type":"NodeParagraph","Properties":{"id":"20240612194038-rwi6eap","updated":"20240612194038"},"Children":[{"Type":"NodeText","Data":"钩吻别是一草，叶似黄精而茎紫，当心抽花，黄色，初生既极类黄精，故以为杀生之对也。或云钩吻是毛茛，此《本经》及后说皆参错不同，未详定云何？又有一物名阴命，赤色，着木悬其子，生山海中，最有大毒，入口即杀人。"}]},{"ID":"20240612194038-yo6y32o","Type":"NodeParagraph","Properties":{"id":"20240612194038-yo6y32o","updated":"20240612194038"},"Children":[{"Type":"NodeText","Data":"〔谨案〕野葛生桂州以南，村墟闾巷间皆有，彼人通名钩吻，亦谓苗名钩吻、根名野葛。蔓生。人自求死者，取挪使汁出，掬水饮，半日即死，而羊食其苗大肥。物有相伏如此，若巴豆鼠食则肥也。陶云飞鸟不得集之，妄矣，其野葛以时新采者，皮白骨黄，宿根似地骨，嫩根如汉中防己，皮节断者良。正与白花藤根相类，不深别者，颇亦惑之。其新取者，折之无尘气，经年以后，则有尘起，根骨似枸杞，有细孔久者，折之，则尘气从孔中出，令折枸杞根亦然。经言折之青烟起者名固活为良，此亦不达之言也。且黄精直生，如龙胆、泽漆，两叶或四、五叶相对，钩吻蔓生，叶如柳叶。"}]},{"ID":"20240612194038-jajdpyn","Type":"NodeParagraph","Properties":{"id":"20240612194038-jajdpyn","updated":"20240612194038"},"Children":[{"Type":"NodeText","Data":"《博物志》云∶钩吻叶似凫葵，并非黄精之类。毛茛是有毛，石龙芮何干钩吻？秦中遍访元无物，乃文外浪说耳。"}]},{"ID":"20240612193613-72o5a26","Type":"NodeThematicBreak","Properties":{"id":"20240612193613-72o5a26"}},{"ID":"20240612193624-epl5uli","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193624-epl5uli","updated":"20240612193649"},"Children":[{"Type":"NodeText","Data":"钩吻《证类本草》"}]},{"ID":"20240612193624-bj8hl8t","Type":"NodeParagraph","Properties":{"id":"20240612193624-bj8hl8t","updated":"20240612193624"},"Children":[{"Type":"NodeText","Data":"味辛，温，有大毒。主金疮，乳 ，中恶风，咳逆上气，水肿，杀鬼疰蛊毒，破症积，除脚膝痹痛，四肢拘挛，恶疮疥虫，杀鸟兽。一名野葛。折之青烟出者名固活。甚热，不入汤。生傅（音附）高山谷及会稽东野。（半夏为之使，恶黄芩。）"}]},{"ID":"20240612193624-pud729v","Type":"NodeParagraph","Properties":{"id":"20240612193624-pud729v","updated":"20240612193624"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶五符中亦云钩吻是野葛。言其入口则钩人喉吻。或言∶吻作挽字，牵挽人肠而绝之。核（胡革切）事而言，乃是两物。野葛是根，状如牡丹，所生处亦有毒，飞鸟不得集之，今人用合膏服之无嫌。钩吻别是一草。叶似黄精而茎紫，当心抽花，黄色，初生既极类黄精，故以为杀生之对也。或云钩吻是毛莨，此本及后说参错不同，未详云何？又有一物名阴命，赤色，着木悬其子，生山海中，最有大毒，入口能立杀人。唐本注云∶野葛生桂州以南，村墟闾巷间皆有。彼人通名钩吻，亦谓苗名钩吻，根名野葛，蔓生。人或误食其叶者皆致死，而羊食其苗大肥，物有相伏如此。若巴豆，鼠食则肥也。陶云∶飞鸟不得集之，妄矣。"}]},{"ID":"20240612193624-np6nkzm","Type":"NodeParagraph","Properties":{"id":"20240612193624-np6nkzm","updated":"20240612193624"},"Children":[{"Type":"NodeText","Data":"其野葛，以时新采者，皮白骨黄。宿根似地骨，嫩根如汉防己，皮节断者良。正与白花藤根相类，不深别者，颇亦惑之。其新取者，折之无尘气。经年以后则有尘起，根骨似枸杞，有细孔者。人折之则尘气从孔中出，今折枸杞根亦然。经言折之青烟起者名固活为良，此亦不达之言也。凡黄精直生如龙胆，泽漆两叶或四、五叶相对，钩吻蔓生，叶如柿叶。《博物志》云∶钩吻叶似凫葵，并非黄精之类。毛莨是有毛，石龙芮何干钩吻？臣禹锡等谨按蜀本秦钩吻，主喉痹，咽中塞，声变，咳逆气，温中。一名除辛。生寒石山。二月、八月采。谨按钩吻，一名野葛者。亦如徐长卿、赤箭、鬼箭等，并一名鬼督邮。鬼督邮自是一物。今钩吻一名野葛，则野葛自有一种，明矣。且药有名同而体异者极多，非独此也。据陶注云∶钩吻叶似黄精而茎紫，当心抽花，黄色者是。苏云∶野葛出桂州，叶似柿叶，人食之即死者。当别是一物尔。又云∶苗名钩吻，根名野葛，亦非通论。按今市人皆以叶似黄精者为钩吻。按《雷公炮炙方》云∶黄精勿令误用钩吻。钩吻叶似黄精，而头尖处有两毛若钩是也。吴氏云∶秦钩吻，一名毒根。神农∶辛。雷公∶有毒，杀人。生南越山或益州。叶如葛，赤茎，大如箭，根黄，正月采。葛洪方云∶钩吻与食芹相似，而生处无他草。其茎有毛，误食之杀人。"}]},{"ID":"20240612193624-53zdj3k","Type":"NodeParagraph","Properties":{"id":"20240612193624-53zdj3k","updated":"20240612193624"},"Children":[{"Type":"NodeText","Data":"岭表录异云∶野葛，毒草也。俗呼为胡蔓草，误食之，则用羊血解之。"}]},{"ID":"20240612193624-9ealjn6","Type":"NodeParagraph","Properties":{"id":"20240612193624-9ealjn6","updated":"20240612193624"},"Children":[{"Type":"NodeText","Data":"陈藏器云∶人食其叶，饮冷水即死。冷水发其毒也。彼人以野葛饲人，勿与冷水。至肥大，以冷水饮之，至死悬尸于树，汁滴地生菌子，收之名菌药，烈于野葛。胡蔓叶细长光润。雷公云∶凡使，勿用地精，苗茎与钩吻同。其钩吻治人身上恶毒疮，效。其地精熬人，采得后，细锉捣了，研绞取自然汁入膏中用，勿误饵之。黄帝问天老曰∶天地所生，岂有食之死者乎？天老曰∶太阴之精，名曰钩吻，不可食之，入口则死。博物志云∶钩吻，毒。桂心、葱叶涕解之。"}]},{"ID":"20240612193613-fyhrwpx","Type":"NodeThematicBreak","Properties":{"id":"20240612193613-fyhrwpx"}},{"ID":"20240612193615-bzx5hmy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193615-bzx5hmy","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：钩吻"}]},{"ID":"20240612193615-m6h7axc","Type":"NodeParagraph","Properties":{"id":"20240612193615-m6h7axc","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612193615-nswy643","Type":"NodeParagraph","Properties":{"id":"20240612193615-nswy643","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" Gōu Wěn"}]},{"ID":"20240612193615-pp3eiru","Type":"NodeParagraph","Properties":{"id":"20240612193615-pp3eiru","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612193615-i100f7f","Type":"NodeParagraph","Properties":{"id":"20240612193615-i100f7f","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 野葛（《本经》），秦钩吻、毒根（《吴普本草》），冶葛、胡蔓草（《南方草木状》），黄野葛（《千金方》），除辛（《蜀本草》），吻莽、断肠草（《梦溪笔谈》），黄藤、烂肠草（《纲目》），朝阳草（《生草药性备要》），大茶药、虎狼草（《岭南采药录》），梭葛草（《福建民间草药》），黄花苦晚藤（《广西药植图志，），黄猛菜（《广西中药志》），大茶藤、大炮叶（《中国药植图鉴》），苦晚公、荷班药（《岭南草药志》），发冷藤、大茶叶、藤黄（《广西药植名录》），大鸡苦蔓、羊带归、梭柙（《南方主要有毒植物》）。"}]},{"ID":"20240612193615-woy57m6","Type":"NodeParagraph","Properties":{"id":"20240612193615-woy57m6","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612193615-tzlcehs","Type":"NodeParagraph","Properties":{"id":"20240612193615-tzlcehs","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612193615-0ah0y2s","Type":"NodeParagraph","Properties":{"id":"20240612193615-0ah0y2s","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612193615-sqywev3","Type":"NodeParagraph","Properties":{"id":"20240612193615-sqywev3","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 为马钱科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"胡蔓藤"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。全年可采。"}]},{"ID":"20240612193615-ntl3g3h","Type":"NodeParagraph","Properties":{"id":"20240612193615-ntl3g3h","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612193615-tailto9","Type":"NodeParagraph","Properties":{"id":"20240612193615-tailto9","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 生于向阳的山坡、路边的草丛或灌丛中。分布浙江、福建、广东、广西、贵州、云南。"}]},{"ID":"20240612193615-ckiy1vl","Type":"NodeParagraph","Properties":{"id":"20240612193615-ckiy1vl","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612193615-1tfht7s","Type":"NodeParagraph","Properties":{"id":"20240612193615-1tfht7s","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 常绿藤本，枝光滑。叶对生，卵状长圆形至卵状披针形，长7～12厘米，阔2～5.5厘米，先端渐尖，基部楔形或近圆形，全缘；叶柄长1.2厘米。3歧分枝的聚伞花序，顶生或腋生；花小，黄色；苞片2，小而狭；萼片5，分离，长约3毫米；花冠漏斗状，先端5裂，长1～1.6厘米，内有较淡的红色斑点，裂片卵形，先端尖，较花筒为短；雄蕊5；子房上位，2室，花柱丝状，柱头4裂。蒴果卵状椭圆形，长10～14毫米，直径6～8毫米，分裂为2个2裂的果瓣。种子多数，有翅。花期8～11月。果期12月至翌年2月。"}]},{"ID":"20240612193615-2kvfrpd","Type":"NodeParagraph","Properties":{"id":"20240612193615-2kvfrpd","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612193615-eu7fv3y","Type":"NodeParagraph","Properties":{"id":"20240612193615-eu7fv3y","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 本品剧毒，根和叶（尤其是嫩叶）毒性最大。误服后极易引起中毒，甚或致死。中毒时主要表现：①神经肌肉症状：眩晕，言语含糊，肌肉弛缓无力，吞咽困难，呼吸肌周围神经麻痹，共济失调，昏迷等；②眼部症状：复视，视力减退，睑下垂，瞳孔散大等；③消化系症状：口腔、咽喉灼痛，恶心，呕吐，腹痛，腹泻，便秘，腹胀等；④循环及呼吸系症状：早期心跳缓慢，以后加快，呼吸困难，呼吸麻痹，虚脱等。症状出现快慢，与服法有关。用根煎水或服新鲜嫩芽，症状多立即出现，服根者症状出现较慢，有2小时始出现者。解救方法：洗胃，催吐，导泻，输液及对症治疗。中药可用三黄汤（黄芩、黄连、黄柏、甘草）灌服，蕹菜汁灌服或积雪草捣烂拌茶油灌服，金银花连叶捣烂榨汁拌黄糖灌服，细叶黄栀子（茜草科）加茅根煎水灌服。民间经验，用新鲜羊血乘热灌服解救，临床证实，确有效果。"}]},{"ID":"20240612193615-pgoi4ba","Type":"NodeParagraph","Properties":{"id":"20240612193615-pgoi4ba","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612193615-jr4qvci","Type":"NodeParagraph","Properties":{"id":"20240612193615-jr4qvci","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 根、茎、叶含生物碱钩吻素子、寅、卯、甲、丙、辰，其中钩吻素子的含量最高，钩吻素寅性剧毒，为最重要的有效成分。另报道福建产钩吻根中含钩吻素甲、子、卯、丁、戊；广东产钩吻根中含钩吻素子、卯、丁、戊。"}]},{"ID":"20240612193615-n2ie428","Type":"NodeParagraph","Properties":{"id":"20240612193615-n2ie428","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612193615-aexz6mi","Type":"NodeParagraph","Properties":{"id":"20240612193615-aexz6mi","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 根、茎、叶三部分均有剧毒。对于大茶药和北美大茶药之化学与药理，卅年代我国学者有较详尽的研究。钩吻的主要毒性成分为钩吻素子、钩吻素寅、钩吻素卯等。其作用性质与北美钩吻中所含生物碱钩吻素甲、钩吻素乙相似，但毒力稍逊，钩吻素寅对家兔之最小致死量为0.8毫克/公斤。中毒之主要症状为呼吸麻痹，轻者呼吸困难，重者死于呼吸停止。致死量之钩吻素乙使动物呼吸停止后，心脏仍继续跳动，呼吸之抑制并非中枢性，去大脑或切断迷走神经均不影响钩吻素乙对呼吸的抑制，麻黄碱、印防已毒素亦无显着解救作用。另一方面，对末梢性的神经肌肉装置，并无直接麻痹作用。钩吻素乙对连神经之离体膈肌，能抑制并停止其节律收缩，与在位膈肌之作用相同。呼吸停止后直接刺激膈神经，仍能引起膈肌收缩。此外，在动物中毒后，皆表现眼睑下垂、垂头、脚软、全身肌肉虚弱，故推测其作用在脊髓运动神经原之麻痹。"}]},{"ID":"20240612193615-p0p0f4p","Type":"NodeParagraph","Properties":{"id":"20240612193615-p0p0f4p","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"钩吻素甲对小鼠有镇痛作用，其有效剂量与中毒剂量相近。但也有报告，如与阿斯匹林合用则镇痛作用增强，胜过单用时之效力，并称在临床上也获得较好效果，推荐的剂量，阿斯匹林为300～500毫克，钩吻素甲为0.5～2毫克。"}]},{"ID":"20240612193615-lh4i0mg","Type":"NodeParagraph","Properties":{"id":"20240612193615-lh4i0mg","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"钩吻素乙对循环系统无显著作用。对离体蛙心有抑制作用，此可被氯化钡、肾上腺素所拮抗，但阿托品无效。小量时引起脉搏加速，乃由于迷走张力之降低，此时血压可仍无明显变化；大量时则抑制心脏而招致血压下降，降压主要由于心脏之抑制，部分也由于血管运动中枢兴奋性的下降；中毒量可引起心室颤动。钩吻素甲能阻断电刺激心迷走神经或注射乙酰胆碱引起之降压反应。它有微弱的5-羟色胺样作用，能加强肾上腺素的升压作用。对犬、兔小肠及子宫，小量略兴奋，大量抑制，乃对平滑肌的直接作用国产钩吻对平滑肌亦呈抑制作用，并与乙酰胆碱、氯化钡相拮抗。钩吻素甲无箭毒样作用，不麻痹神经节，亦无中枢镇静作用。国产钩吻与钩吻素甲有散大瞳孔的作用。"}]},{"ID":"20240612193615-y620jwl","Type":"NodeParagraph","Properties":{"id":"20240612193615-y620jwl","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"临床上有用钩吻素甲治疗神经痛，特别是三叉神经痛，也有用其酊剂治急性脊髓灰白质炎。由于其治疗剂量与中毒剂量相距甚近，故应用时需十分小心，严密观察，特别是呼吸的情况。局部可用于扩瞳，但刺激性大，因而限制了它的应用。"}]},{"ID":"20240612193615-1rfzmyu","Type":"NodeParagraph","Properties":{"id":"20240612193615-1rfzmyu","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612193615-j9jwi89","Type":"NodeParagraph","Properties":{"id":"20240612193615-j9jwi89","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 辛苦，温，有毒。"}]},{"ID":"20240612193615-89pbmjj","Type":"NodeParagraph","Properties":{"id":"20240612193615-89pbmjj","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"辛，温。\""}]},{"ID":"20240612193615-tcq0h0o","Type":"NodeParagraph","Properties":{"id":"20240612193615-tcq0h0o","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"②《吴普本草》：\"雷公：有毒。\""}]},{"ID":"20240612193615-z7tynpb","Type":"NodeParagraph","Properties":{"id":"20240612193615-z7tynpb","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"③《别录》：\"有大毒。\""}]},{"ID":"20240612193615-vj5khz3","Type":"NodeParagraph","Properties":{"id":"20240612193615-vj5khz3","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"④《岭南采药录》：\"苦，寒，有大毒。\""}]},{"ID":"20240612193615-5qsms2z","Type":"NodeParagraph","Properties":{"id":"20240612193615-5qsms2z","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑤《广西药植图志》：\"辛微苦，有大毒。\""}]},{"ID":"20240612193615-w7wepek","Type":"NodeParagraph","Properties":{"id":"20240612193615-w7wepek","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612193615-8vyv8aj","Type":"NodeParagraph","Properties":{"id":"20240612193615-8vyv8aj","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 本品有剧毒，只作外用，切忌内服。"}]},{"ID":"20240612193615-0vr6hn7","Type":"NodeParagraph","Properties":{"id":"20240612193615-0vr6hn7","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"《本草经集注》：\"半夏为之使，恶黄芩。\""}]},{"ID":"20240612193615-9y4ohse","Type":"NodeParagraph","Properties":{"id":"20240612193615-9y4ohse","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612193615-wayjpx1","Type":"NodeParagraph","Properties":{"id":"20240612193615-wayjpx1","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 祛风，攻毒，消肿，止痛。治疥癞，湿疹，瘰疬，痈肿，疔疮，跌打损伤，风湿痹痛，神经痛。"}]},{"ID":"20240612193615-69vkh3r","Type":"NodeParagraph","Properties":{"id":"20240612193615-69vkh3r","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主金疮，乳痓，中恶风，咳逆上气，水肿。\""}]},{"ID":"20240612193615-9ouf7ft","Type":"NodeParagraph","Properties":{"id":"20240612193615-9ouf7ft","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"破症积，脚膝痹痛，四肢拘挛，恶疮疥虫。\""}]},{"ID":"20240612193615-68d3xls","Type":"NodeParagraph","Properties":{"id":"20240612193615-68d3xls","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"③《蜀本草》：\"主喉痹咽中塞、声变，咳逆气，温中。\""}]},{"ID":"20240612193615-cc1s33d","Type":"NodeParagraph","Properties":{"id":"20240612193615-cc1s33d","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"④《生草药性备要》：\"祛风毒，洗螆癞。\""}]},{"ID":"20240612193615-54l7ujt","Type":"NodeParagraph","Properties":{"id":"20240612193615-54l7ujt","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑤《本经逢原》：\"紫者破血积，青者破痰积。\""}]},{"ID":"20240612193615-y5vx5bc","Type":"NodeParagraph","Properties":{"id":"20240612193615-y5vx5bc","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑥《岭南采药录》：\"不论根茎叶，以之煎水外洗，能散风热毒，洗疥癞及癣。凡花柳毒、下疳，以之煎浓汁，浸二、三次。\""}]},{"ID":"20240612193615-6vflg9y","Type":"NodeParagraph","Properties":{"id":"20240612193615-6vflg9y","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑦《广西药植图志》：\"捣烂外敷治跌打瘀肿，外伤出血，梅毒恶疮，风痹；制膏敷贴消肿瘤。\""}]},{"ID":"20240612193615-o2tq2wg","Type":"NodeParagraph","Properties":{"id":"20240612193615-o2tq2wg","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑧广州空军《常用中草药手册》：\"攻毒拔毒，杀虫，止痒，散瘀止痛。治皮肤湿疹，跌打损伤，闭合性骨折。\""}]},{"ID":"20240612193615-2nrkt38","Type":"NodeParagraph","Properties":{"id":"20240612193615-2nrkt38","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612193615-arivqu6","Type":"NodeParagraph","Properties":{"id":"20240612193615-arivqu6","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 外用：捣敷或研末调敷；煎水洗或烟熏。"}]},{"ID":"20240612193615-fu7q96k","Type":"NodeParagraph","Properties":{"id":"20240612193615-fu7q96k","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612193615-kifyv6c","Type":"NodeParagraph","Properties":{"id":"20240612193615-kifyv6c","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" ①治疥癞：断肠草、白芷、青黛、五倍子、枯矾、马前子、蛇退各二钱，梅片四分，松香、雄黄各一钱五分。共为细末，以蜡油熔化和药膏贴之。（《岭南草药志》）"}]},{"ID":"20240612193615-540wc2u","Type":"NodeParagraph","Properties":{"id":"20240612193615-540wc2u","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"②治瘰疬：断肠草根，红老木薯，二味酌量。共捣烂，用酸醋煎一小时取起，候冷敷患处，连敷三天。（《岭南草药志》）"}]},{"ID":"20240612193615-57b312x","Type":"NodeParagraph","Properties":{"id":"20240612193615-57b312x","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"③治痈疮肿毒：生断肠草四两，黄糖五钱。共捣敷患处。（《广西药植图志》）"}]},{"ID":"20240612193615-knwxr99","Type":"NodeParagraph","Properties":{"id":"20240612193615-knwxr99","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"④治痈疽：断肠草晒干研末后，混合凡士林，制成软膏敷患处。"}]},{"ID":"20240612193615-7zetrq7","Type":"NodeParagraph","Properties":{"id":"20240612193615-7zetrq7","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑤冶远年臁疮：鲜大茶药一斤，煎水洗患处，日洗数次，洗后将药叶一张贴疮口。"}]},{"ID":"20240612193615-civxr5n","Type":"NodeParagraph","Properties":{"id":"20240612193615-civxr5n","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑥治瘭疽：大茶药叶、石灰。二味捣烂，贴患指第三节，有脓即溃，无脓即消。（④方以下出《岭南草药志》）"}]},{"ID":"20240612193615-0nv2b8c","Type":"NodeParagraph","Properties":{"id":"20240612193615-0nv2b8c","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑦治风湿关节痛：干断肠草一两，防风二钱，独活一钱。共研粗末，用纸卷烧烟熏患处。（《广西药植图志》）"}]},{"ID":"20240612193615-gvygmk7","Type":"NodeParagraph","Properties":{"id":"20240612193615-gvygmk7","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"⑧治刀伤：断肠草捣烂，敷伤口。（《岭南草药志》）"}]},{"ID":"20240612193615-coua7ji","Type":"NodeParagraph","Properties":{"id":"20240612193615-coua7ji","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612193615-fvjczop","Type":"NodeParagraph","Properties":{"id":"20240612193615-fvjczop","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612193615-ucwfhfi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612193615-ucwfhfi","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"《中华本草》：钩吻"}]},{"ID":"20240612193615-hwqre8c","Type":"NodeParagraph","Properties":{"id":"20240612193615-hwqre8c","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612193615-gafnevp","Type":"NodeParagraph","Properties":{"id":"20240612193615-gafnevp","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" Gōu Wěn"}]},{"ID":"20240612193615-jq1ps8s","Type":"NodeParagraph","Properties":{"id":"20240612193615-jq1ps8s","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612193615-u9apz94","Type":"NodeParagraph","Properties":{"id":"20240612193615-u9apz94","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 野葛、秦钩吻、毒根、冶葛、胡蔓草、黄野葛、除辛、吻莽、断肠草、黄藤、烂肠草、朝阳草、大茶（柴）药、虎狼草、梭葛草、黄花苦晚藤、黄猛菜、大茶藤、大炮叶、苦晚公、荷班药、发冷藤、大茶叶、藤黄、大鸡苦蔓、羊带归、梭柙、狗角花、山砒霜、梭葛、大王茶"}]},{"ID":"20240612193615-2hsdhwx","Type":"NodeParagraph","Properties":{"id":"20240612193615-2hsdhwx","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612193615-crz6gj1","Type":"NodeParagraph","Properties":{"id":"20240612193615-crz6gj1","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612193615-d06hs35","Type":"NodeParagraph","Properties":{"id":"20240612193615-d06hs35","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"1.《吴普本草》： 秦钩吻，生南越山或益州。叶如葛，赤茎，大如箭，方根黄色。或生会稽东冶。正月采。"}]},{"ID":"20240612193615-jet6w1v","Type":"NodeParagraph","Properties":{"id":"20240612193615-jet6w1v","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"2.《南方草木状》：冶葛，毒草也，蔓生，叶如罗勒，光而厚，一名胡蔓草。"}]},{"ID":"20240612193615-sdvbofq","Type":"NodeParagraph","Properties":{"id":"20240612193615-sdvbofq","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"3.《雷公炮炙论》： 钩吻治恶毒疮效。其地精杀人。采得后捣绞自然汁入膏中用，勿误饵之。"}]},{"ID":"20240612193615-qfjztgh","Type":"NodeParagraph","Properties":{"id":"20240612193615-qfjztgh","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"4.《别录》： 钩吻，折之青烟出者，名固活，甚热，不入汤。生傅高山谷及会稽东野。"}]},{"ID":"20240612193615-yhohoni","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612193615-yhohoni","updated":"20240612193615"},"Children":[{"ID":"20240612193615-ppzsvpi","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20240612193615-ppzsvpi","updated":"20240612193615"},"Children":[{"ID":"20240612193615-n57ceys","Type":"NodeParagraph","Properties":{"id":"20240612193615-n57ceys","updated":"20240612193615"}}]}]},{"ID":"20240612193615-gqwhkh5","Type":"NodeParagraph","Properties":{"id":"20240612193615-gqwhkh5","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612193615-2a1lk3w","Type":"NodeParagraph","Properties":{"id":"20240612193615-2a1lk3w","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 药材基源：为马钱科植物胡蔓藤的全株。"}]},{"ID":"20240612193615-4owgrjx","Type":"NodeParagraph","Properties":{"id":"20240612193615-4owgrjx","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Gelsemium elegans （Gardn．Et Champ.）Benth．［Medicia elegans Gardn.et Champ.］"}]},{"ID":"20240612193615-3e2d3mf","Type":"NodeParagraph","Properties":{"id":"20240612193615-3e2d3mf","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"采收和储藏：全年均可采，切段，晒干或鲜用。"}]},{"ID":"20240612193615-yew8229","Type":"NodeParagraph","Properties":{"id":"20240612193615-yew8229","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612193615-15ri2cy","Type":"NodeParagraph","Properties":{"id":"20240612193615-15ri2cy","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔500-2000m的向阳山坡、路边草丛或灌丛中。"}]},{"ID":"20240612193615-hzbwaj5","Type":"NodeParagraph","Properties":{"id":"20240612193615-hzbwaj5","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于浙江、江西、福建、台湾、湖南、广东、海南、广西、贵州、云南等地。"}]},{"ID":"20240612193615-0g89mt0","Type":"NodeParagraph","Properties":{"id":"20240612193615-0g89mt0","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612193615-mmjvsry","Type":"NodeParagraph","Properties":{"id":"20240612193615-mmjvsry","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 常绿藤本，长约12m。枝光滑，幼枝具细纵棱。单叶对生;具短柄；叶片卵状长圆形至卵状披针形，长5-12cm，宽2-6cm，先端渐尖，基部楔形或近圆形，全缘。聚伞花序多顶生，三叉分枝，苞片2，短三角形；萼片5，分离，长约3mm；花小，黄色，花冠漏斗形，先端5裂，内有淡红色斑点，裂片卵形，先端尖，较花筒短；雄蕊5；子房上位，2室，花柱丝状，柱头4裂。蒴果卵状椭圆形，长10-14mm，直径6-8mm，下垂，基部有宿萼，果皮薄革质。种子长圆形，多数，具刺状突起，边缘有翅。花期5-11月，果期7月至翌年2月。"}]},{"ID":"20240612193615-7u8p7hb","Type":"NodeParagraph","Properties":{"id":"20240612193615-7u8p7hb","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612193615-1alh7nd","Type":"NodeParagraph","Properties":{"id":"20240612193615-1alh7nd","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 茎呈圆柱形，直径0．5-5cm,外皮灰黄色至黄褐色，具深纵沟及横裂隙；幼茎较光滑，黄绿色或0黄棕色，具细纵纹及纵向椭圆形突起的点状皮孔。节稍膨大,可见叶柄痕。质坚，不易折断，断面不整齐，皮部黄棕色，木部淡黄色，具放射状纹理，密布细孔，髓部褐色或中空。气微，味微苦，有毒。"}]},{"ID":"20240612193615-mahwnbb","Type":"NodeParagraph","Properties":{"id":"20240612193615-mahwnbb","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"叶不规则皱缩，完整者展平后呈卵形或卵状披针形，长4-8cm,宽2-4cm，先端渐尖，基部荐形或钝圆，叶脉于下面突起，侧脉4-5对，上面灰绿色至淡棕褐色，下面色较浅。气微，味微苦。"}]},{"ID":"20240612193615-x36mtt1","Type":"NodeParagraph","Properties":{"id":"20240612193615-x36mtt1","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"显微鉴别 茎横切面：嫩茎表皮细胞外壁明显角质增厚；较老的茎有木栓层。皮层较窄，散有纤维束。维管束双韧型，外侧韧皮部较内侧韧皮部宽，外侧韧皮部纤维或石细胞单个或数个成群散在。木质部细胞均木化，导管单个或2个径向排列，射线宽5-6列细胞。内侧韧皮部有的细胞呈压缩状，并有厚壁性的纤维状石细胞散在；有的细胞含草酸钙簇晶或方晶。髓部薄壁细胞含草酸钙方晶及簇晶。"}]},{"ID":"20240612193615-v3fzgnl","Type":"NodeParagraph","Properties":{"id":"20240612193615-v3fzgnl","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"粉末特征：黄棕色。①木纤维成束或单个散在，稍变曲，直径15-40μm，具多数人字形壁孔。②石细胞淡黄色，单个散在，短径的石细胞长方形、椭圆形或不规则分枝状。③纤维状石细胞长梭形，一端或两端钝尖或具短分叉，长400-900μm，直径20-140μm，孔沟明显，有的层纹隐约可见。④韧皮纤维单个或成束散在，多断碎，直径约15μm，壁厚，胞腔狭小。⑤导管多为网纹及螺纹，常破碎，直径100-200μm。⑥叶表皮组织碎片可见平轴式气孔，副卫细胞2个，保卫细胞及副卫细胞有的具明显的角质层纹理。①淀粉粒单粒，椭圆形、圆形、半圆形或类方形，直径5-15（-25）μm，脐点点状或裂缝状;复粒由2-4个分粒组成。⑧草酸钙簇晶，直径5－30μm，方晶长6-22μm，直径4-12μm。"}]},{"ID":"20240612193615-f9s4q33","Type":"NodeParagraph","Properties":{"id":"20240612193615-f9s4q33","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612193615-8rzfj9l","Type":"NodeParagraph","Properties":{"id":"20240612193615-8rzfj9l","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 钩吻的主要毒性成分为钩吻素子、钩吻素寅、钩吻素卯等。其作用性质与北美钩吻中所含生物碱钩吻素甲、钩吻素乙相似，但毒力稍逊，钩吻素寅对家兔之最小致死量为0.8mg/kg。中毒之主要症状为呼吸麻痹，轻者呼吸困难，重者死于呼吸停止。致死量之钩吻素乙使动物呼吸停止后，心脏仍继续跳动，呼吸之抑制并非中枢性，去大脑或切断 迷走神经均不影响钩吻素乙对呼吸的抑制。麻黄碱、印防己毒素亦无显着解救作用。另一方面，对末梢性的神经肌肉装置，并无直接麻痹作用。钩吻素乙对连神经之离体膈肌，能抑制并停止其节律收缩，与在位膈肌之作用相同。呼吸停止后直接刺激膈神经，仍能引起膈肌收缩。此外，在动物中毒后，皆表现眼睑下垂、垂头、脚软、全身肌肉虚弱，故推测其作用在脊髓运动神经原之麻痹。"}]},{"ID":"20240612193615-5s85xzg","Type":"NodeParagraph","Properties":{"id":"20240612193615-5s85xzg","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612193615-x0jmdp4","Type":"NodeParagraph","Properties":{"id":"20240612193615-x0jmdp4","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 钩吻的主要成分是生物碱，由其根中曾分离出7种单一的生物碱：钩吻碱子（koumine），钩吻碱丑（kouminine)即是钩吻碱（gelsemine），钩吻碱寅（kouminicine）,钩吻碱卯(kouminidine),钩吻碱丙即是常绿钩吻碱(sempervirine),钩吻碱丁（koumicine），钩吻碱戊（koumidine）；从茎中分离出钩吻碱子和常绿钩吻碱，从叶中分离出钩吻碱子、丑、丁和钩吻碱辰（kounidine）等[1]。"}]},{"ID":"20240612193615-9ddes44","Type":"NodeParagraph","Properties":{"id":"20240612193615-9ddes44","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"20世纪80年代以来，从根中除分离出钩吻碱子、钩吻碱和常绿钩吻碱外，又得到：胡蔓藤碱甲（humantenmine），胡蔓藤碱乙（humantenine），胡蔓藤碱丙（humantendine），胡蔓藤碱丁（hu-mantenrine）[2-4]，阿枯米定碱（akuammidine），16-表伏康树卡平碱（16－epivocarpine），19-羟基二氢-1-甲氧基钩吻碱（19－hydroxy-dihydrogelsevirine）[5]，二氢钩吻碱子（dihydrokoumine）[6]，19（R）-和19（S）钩吻醇碱（kouminol）[7]。从全株分得：N-去甲氧基兰金断肠草碱（N－desmethoxyrankinidine），11-羟基兰金断肠草碱（11-hydroxyrankinidine），11-羟基胡蔓藤碱乙（11－hydroxyhu-mantenine），11-甲氧基胡曼藤碱乙（11－methoxyhumantenine），胡蔓藤碱乙和丁[8]，N-甲氧基九节木叶山马茶碱（Nmethoxytaberpsychine,N－methoxyanhydrovobasindiol）[9]，钩吻麦定碱（gelsamydine）[10]，钩吻精碱（gelselegine），11-甲氧基-19（R）-羟基钩吻精碱[11-methoxy-19（R）-hydroxygelselegine〕[11]，19（R）-和19（S）-羟基二氢钩吻碱子hydroxydihydrokoumine）[12],20-羟基二氢兰金断肠草碱（20－hydroxydihydrorankinidine），N-去甲氧基胡蔓藤碱乙（N－desmethoxyhumantenine），15-羟基胡蔓藤碱乙（15－hydroxyhumantenine），钩吻模合于碱（gelsemoxo-nine）[13]，钩吻内酚胺（gelsemamide），11-甲氧基钩吻内酸胺（11-methoxygelsemamide）[14]，19（R）-和19（S）-羟基二氧-1-甲氧基钩吻碱（hydroxydihydrogelsevirine），19（R）-乙酸基二氢-1-甲氧基钩吻碱〔19（R）－acetyldihydrogelsevirine〕，19（R）-羟基二氢钩吻碱〔19（R）－hydroxydihydrogelsemine〕，钩吻碱，1-甲氧基钩吻碱（gel-sevirine）[15]，19（Z）-阿枯米定碱，16-表伏康卡平碱[16]。"}]},{"ID":"20240612193615-vtm3bj3","Type":"NodeParagraph","Properties":{"id":"20240612193615-vtm3bj3","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612193615-oj3av16","Type":"NodeParagraph","Properties":{"id":"20240612193615-oj3av16","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 根、茎、叶三部分均有剧毒。对于大茶药和北美大茶药之化学与药理，卅年代我国学者有较详尽的研究。钩吻素甲对小鼠有镇痛作用，其有效剂量与中毒剂量相近。但也有报告，如与阿斯匹林合用则镇痛作用增强，胜过单用时之效力，并称在临床上也获得较好效果，推荐的剂量，阿斯匹林为300-500mg，钩吻素甲为0.5-2mg。钩吻素乙对循环系统无显着作用。对离体蛙心有抑制作用，此可被氯化钡、肾上腺素所拮抗，但阿托品无效。小量时引起脉搏加速，乃由于选走张力之降低，此时血压可仍无明显变化；大量时则抑制心脏而招致血压下降，降压主要由于心脏之抑制，部分也由于血管运动中枢兴奋性的下降；中毒量可引起心室颤动。钩吻素甲能阻断电刺激心迷走神经或注射乙酰胆碱引起之降压反应。它有微弱的5-羟色胺样作用，能加强肾上腺素的升压作用。对犬、兔小肠及子宫，小量略兴奋，大量抑制，乃对平滑肌的直接作用。国产钩吻对平滑肌亦呈抑制作用，并与乙酰胆碱、氯化钡相拮抗。钩吻素甲无箭毒样作用，不麻痹神经节，亦无中枢镇静作用。国产钩吻与钩吻素甲有散大瞳孔的作用。临床上有用钩吻素甲治疗神经痛，特别是三叉神经痛，也有用其酊剂治急性脊髓灰白质炎。由于其治疗剂量与中毒剂量相距甚近，故应用时需十分小心，严密观察，特别是呼吸的情况。局部可用于扩瞳，但刺激性大，因而限制了它的应用。"}]},{"ID":"20240612193615-uwvxajp","Type":"NodeParagraph","Properties":{"id":"20240612193615-uwvxajp","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612193615-ynrrk13","Type":"NodeParagraph","Properties":{"id":"20240612193615-ynrrk13","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 辛；苦；性温；大毒"}]},{"ID":"20240612193615-asjkvg3","Type":"NodeParagraph","Properties":{"id":"20240612193615-asjkvg3","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612193615-mm4e871","Type":"NodeParagraph","Properties":{"id":"20240612193615-mm4e871","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 本品有剧毒，只作外用，切忌内服。 《本草经集注》： 半夏为之使，恶黄芩。"}]},{"ID":"20240612193615-0j83j27","Type":"NodeParagraph","Properties":{"id":"20240612193615-0j83j27","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612193615-6x30ye5","Type":"NodeParagraph","Properties":{"id":"20240612193615-6x30ye5","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 祛风攻毒；散结消肿；止痛。主疥癞；湿疹；瘰疬；痈肿；疔疮；跌打损伤；风湿痹痛；神经痛"}]},{"ID":"20240612193615-1j170dz","Type":"NodeParagraph","Properties":{"id":"20240612193615-1j170dz","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612193615-myvsn1w","Type":"NodeParagraph","Properties":{"id":"20240612193615-myvsn1w","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 外用：适量，捣敷；或研末调敷；或煎水洗；或烟熏。"}]},{"ID":"20240612193615-s4mw2up","Type":"NodeParagraph","Properties":{"id":"20240612193615-s4mw2up","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612193615-7i0k7aj","Type":"NodeParagraph","Properties":{"id":"20240612193615-7i0k7aj","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" ①治疥癞：断肠草、白芷、青黛、五倍子、枯矾、马前子、蛇退各二钱，梅片四分，松香、雄黄各一钱五分。共为细末，以蜡油熔化和药膏贴之。(《岭南草药志》)②治瘰疬：断肠草根，红老木薯，二味酌量。共捣烂，用酸醋煎一小时取起，候冷敷患处，连敷三天。 (《岭南草药志》)③治痈疮肿毒：生断肠草四两，黄糖五钱。共捣敷患处。(《广西药植图志》)④治痈疽：断肠草晒干研末后，混合凡士林，制成软膏敷患处。(《岭南草药志》)⑤治远年臁疮：鲜大茶药一斤，煎水洗患处，日洗数次，洗后将药叶一张贴疮口。(《岭南草药志》)⑥治瘭疽：大茶药叶、石灰。二味捣烂，贴患指第三节，有脓即溃，无脓即消。(《岭南草药志》)⑦治风湿关节痛：干断肠草一两，防风二钱，独活一钱。共研粗末，用纸卷烧烟熏患处。(《广西药植图志》)⑧治刀伤：断肠草捣烂，敷伤口。(《岭南草药志》)"}]},{"ID":"20240612193615-2xhrq1n","Type":"NodeParagraph","Properties":{"id":"20240612193615-2xhrq1n","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612193615-7osa048","Type":"NodeParagraph","Properties":{"id":"20240612193615-7osa048","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 1.《本经》： 主金疮，乳CE，中恶风，咳逆上气，水肿。"}]},{"ID":"20240612193615-yxh1z3m","Type":"NodeParagraph","Properties":{"id":"20240612193615-yxh1z3m","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"2.《别录》： 破症积，脚膝痹痛，四肢拘挛，恶疮疥虫。"}]},{"ID":"20240612193615-q57rxjb","Type":"NodeParagraph","Properties":{"id":"20240612193615-q57rxjb","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》： 主喉痹咽中塞、声变，咳逆气，温中。"}]},{"ID":"20240612193615-dnonwqd","Type":"NodeParagraph","Properties":{"id":"20240612193615-dnonwqd","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"4.《生草药性备要》： 祛风毒，洗螆癞。"}]},{"ID":"20240612193615-3tgtc9z","Type":"NodeParagraph","Properties":{"id":"20240612193615-3tgtc9z","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"5.《本经逢原》： 紫者破血积，青者破痰积。"}]},{"ID":"20240612193615-zku77wm","Type":"NodeParagraph","Properties":{"id":"20240612193615-zku77wm","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"6.《岭南采药录》： 不论根茎叶，以之煎水外洗，能散风热毒，洗疥癞及癣。凡花柳毒、下疳，以之煎浓汁，浸二、三次。"}]},{"ID":"20240612193615-16ltci9","Type":"NodeParagraph","Properties":{"id":"20240612193615-16ltci9","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"7.《广西药植图志》： 捣烂外敷治跌打瘀肿，外伤出血，梅毒恶疮，风痹；制膏敷贴消肿瘤。"}]},{"ID":"20240612193615-bwibg9c","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612193615-bwibg9c","updated":"20240612193615"},"Children":[{"ID":"20240612193615-d1x2nbq","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OC4=","Num":8},"Properties":{"id":"20240612193615-d1x2nbq","updated":"20240612193615"},"Children":[{"ID":"20240612193615-xi8dq78","Type":"NodeParagraph","Properties":{"id":"20240612193615-xi8dq78","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"广州空军《常用中草药手册》： 攻毒拔毒，杀虫，止痒，散瘀止痛。治皮肤湿疹，跌打损伤，闭合性骨折。"}]}]}]},{"ID":"20240612193615-de532av","Type":"NodeParagraph","Properties":{"id":"20240612193615-de532av","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612193615-94f14ve","Type":"NodeParagraph","Properties":{"id":"20240612193615-94f14ve","updated":"20240612193615"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612193616-fs16zhe","Type":"NodeThematicBreak","Properties":{"id":"20240612193616-fs16zhe"}},{"ID":"20240612193617-am5mzy3","Type":"NodeParagraph","Properties":{"id":"20240612193617-am5mzy3"}}]}