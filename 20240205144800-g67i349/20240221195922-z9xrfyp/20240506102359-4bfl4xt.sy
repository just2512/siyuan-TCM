{"ID":"20240506102359-4bfl4xt","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102359-4bfl4xt","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102359-4bfl4xt\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240701113716-7lc300k\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613103644-lnea4e9\u0026quot;,\u0026quot;scrollTop\u0026quot;:2700,\u0026quot;focusId\u0026quot;:\u0026quot;20240701114401-tp018r0\u0026quot;,\u0026quot;focusStart\u0026quot;:3,\u0026quot;focusEnd\u0026quot;:3\u0026#125;","title":"296萹蓄（匾蓄、萹竹、扁竹）","type":"doc","updated":"20240823164421"},"Children":[{"ID":"20240701113716-7lc300k","Type":"NodeParagraph","Properties":{"id":"20240701113716-7lc300k","updated":"20240701113716"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 371px;","style":"width: 361px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"萹蓄1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/萹蓄1-20240701113716-eo978a8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 361px;\" parent-style=\"width: 371px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240619191000-zp15bog","Type":"NodeParagraph","Properties":{"id":"20240619191000-zp15bog","updated":"20240823162448"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 547px;","style":"width: 537px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240619191000-nkioltf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 537px;\" parent-style=\"width: 547px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Propert