th: 442px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823163309-aptvcnm","Type":"NodeParagraph","Properties":{"id":"20240823163309-aptvcnm","updated":"20240823163451"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 313px;","style":"width: 303px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"扁蓄 (8)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/扁蓄 8-20240823163451-znpyne4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 303px;\" parent-style=\"width: 313px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 872px;","style":"width: 862px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240823163309-efgqbik.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 862px;\" parent-style=\"width: 872px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613103642-cv9uqke","Type":"NodeThematicBreak","Properties":{"id":"20240613103642-cv9uqke"}},{"ID":"20240613103801-u016g9x","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103801-u016g9x","updated":"20240613103806"},"Children":[{"Type":"NodeText","Data":"萹蓄《神农本草经》"}]},{"ID":"20240613104042-nm0nyq8","Type":"NodeParagraph","Properties":{"id":"20240613104042-nm0nyq8","updated":"20240613104048"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒．治浸淫，疥瘙，疽，痔，杀三 虫。生山谷。一名萹竹。"}]},{"ID":"20240613103801-w7u1smm","Type":"NodeParagraph","Properties":{"id":"20240613103801-w7u1smm","updated":"20240613103801"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：萹蓄一名蓄辩，一名萹蔓（《御览》）。"}]},{"ID":"20240613103801-zkaxpbo","Type":"NodeParagraph","Properties":{"id":"20240613103801-zkaxpbo","updated":"20240613103801"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生东菜，五月采，阴干。"}]},{"ID":"20240613103801-dlteyqr","Type":"NodeParagraph","Properties":{"id":"20240613103801-dlteyqr","updated":"20240613103801"},"Children":[{"Type":"NodeText","Data":"案《说文》云：萹，萹（上艹下左工右几）也，（上艹下左工右几），萹也，（上艹下左氵右毒）水萹，（上艹下左氵右毒），读若督。《尔雅》云：竹萹，蓄。郭璞云：似水藜，赤茎节，好生道旁，可食，又杀虫。《毛诗》云：绿竹猗猗。《传》云：竹，萹竹也。韩诗云：，（上艹下左氵右毒），萹（上艹下左工右几）也，石经同。"}]},{"ID":"20240613104235-14scov3","Type":"NodeThematicBreak","Properties":{"id":"20240613104235-14scov3"}},{"ID":"20240613104236-4rxy72m","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613104236-4rxy72m","updated":"20240613104240"},"Children":[{"Type":"NodeText","Data":"匾蓄《本草纲目》"}]},{"ID":"20240613104236-my5vwqq","Type":"NodeParagraph","Properties":{"id":"20240613104236-my5vwqq","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"「释名」扁竹、扁辨、扁蔓、粉节草、道生草。"}]},{"ID":"20240613104236-4ui0ib9","Type":"NodeParagraph","Properties":{"id":"20240613104236-4ui0ib9","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"「气味」苦、平、无毒。"}]},{"ID":"20240613104236-u90mfhg","Type":"NodeParagraph","Properties":{"id":"20240613104236-u90mfhg","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613104236-34t8oh8","Type":"NodeParagraph","Properties":{"id":"20240613104236-34t8oh8","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"1、热黄疸疾。用匾蓄放豉汁中，下五味，煮羹汤吃。"}]},{"ID":"20240613104236-ec28ga7","Type":"NodeParagraph","Properties":{"id":"20240613104236-ec28ga7","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"2、蛔虫病。用匾蓄十斤，锉细，加水一石煎至一斗。去渣，再次煎浓。头天晚上禁食，次日空心服一升，虫即可打下。"}]},{"ID":"20240613104236-uhuj5bo","Type":"NodeParagraph","Properties":{"id":"20240613104236-uhuj5bo","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"3、痔发肿病。用匾蓄捣烂取汁服一升。无效可再服。另取匾蓄汁和面作饼，一天吃三次。"}]},{"ID":"20240613104236-iutrty9","Type":"NodeParagraph","Properties":{"id":"20240613104236-iutrty9","updated":"20240613104236"},"Children":[{"Type":"NodeText","Data":"4、恶疮痂痒。用匾蓄捣烂封患处，痂落病愈。"}]},{"ID":"20240613103823-rmggy86","Type":"NodeThematicBreak","Properties":{"id":"20240613103823-rmggy86"}},{"ID":"20240613103824-g8s2n7p","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103824-g8s2n7p","updated":"20240613103829"},"Children":[{"Type":"NodeText","Data":"萹蓄《医学入门》"}]},{"ID":"20240613103824-kd66twp","Type":"NodeParagraph","Properties":{"id":"20240613103824-kd66twp","updated":"20240613103824"},"Children":[{"Type":"NodeText","Data":"在处有之，苗似瞿麦，叶细绿如竹，茎赤如钗，股有节，花青黄色，可食。味苦，气平。无毒。主热黄五痔，及丹石毒发冲眼肿痛，并捣汁顿服。霍乱吐利不止，以五味调和煮羹食之。又主浸淫疥瘙热肿，恶疮痒痛，并捣敷之女子阴蚀。小儿蛔虫攻心心痛，面青口中沫出欲死者，空心服之，其虫自下。五月采苗，阴干用。"}]},{"ID":"20240613103927-epck5nt","Type":"NodeThematicBreak","Properties":{"id":"20240613103927-epck5nt"}},{"ID":"20240613103928-jlpbdj9","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240613103928-jlpbdj9","updated":"20240613104156"},"Children":[{"Type":"NodeText","Data":"萹蓄《证类本草》"}]},{"ID":"20240613103928-cqh48g5","Type":"NodeParagraph","Properties":{"id":"20240613103928-cqh48g5","updated":"20240613103937"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒，主浸淫疥瘙疽痔，杀三虫，疗女子阴蚀。生东莱山谷。五月采，阴干。"}]},{"ID":"20240613103928-0w3bhpv","Type":"NodeParagraph","Properties":{"id":"20240613103928-0w3bhpv","updated":"20240613103938"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶处处有，布地生，花节间白，叶细绿，人亦呼为 竹。煮汁与小儿饮，疗蛔虫有验。臣禹锡等谨按蜀本图经云∶叶如竹，茎有节，细如钗股。生下湿地，今所在有。二月、八月采苗，日干。尔雅云∶竹， 蓄。释云∶李巡云∶一物二名也。孙炎引《诗·卫风》云∶绿竹猗猗。郭云∶似小藜，赤茎节，好生道旁，可食，又杀虫，陶注本草谓之 竹是也。药性论云∶ 竹，使，味甘。煮汁与小儿服，主蛔虫等咬心，心痛面青，口中沫出，临死者。"}]},{"ID":"20240613103928-vlv2041","Type":"NodeParagraph","Properties":{"id":"20240613103928-vlv2041","updated":"20240613103928"},"Children":[{"Type":"NodeText","Data":"取十斤细锉，以水一石煎，去滓成煎如饴。空心服，虫自下，皆尽止。主患痔疾者，常取叶捣汁服，效。治热黄，取汁顿服一升，多年者再服之，根一握洗去土，捣汁服之一升，恶丹石毒发，冲目肿痛，又敷热肿，效。"}]},{"ID":"20240613103928-mx0lz71","Type":"NodeParagraph","Properties":{"id":"20240613103928-mx0lz71","updated":"20240617115416"},"Children":[{"Type":"NodeText","Data":"图经曰∶ 蓄，亦名 竹。出东莱山谷，今在处有之。春中布地生道旁，苗似瞿麦，叶细绿如竹，赤茎如钗股，节间花出甚细，微青黄色，根如蒿根，四月、五月采苗，阴干。谨按《尔雅》云∶竹， 蓄。郭璞注云∶似小藜，赤茎节，好生道旁，可食，又杀虫。《卫诗》绿竹猗猗。说者曰∶绿王刍也。竹， 竹也，即谓此 蓄。方书亦单用治虫。葛洪小儿蛔方，煮汁令浓，饮之即瘥。"}]},{"ID":"20240613103928-0xsxht0","Type":"NodeParagraph","Properties":{"id":"20240613103928-0xsxht0","updated":"20240613103943"},"Children":[{"Type":"NodeText","Data":"食疗云∶蛔虫心痛，面青，口中沫出，临死。取叶十斤，细切。以水三石三斗，煮如饧，去滓。通寒温，空心服一升，虫即下。至重者再服，仍通宿勿食，来日平明服之。患痔，常取竹叶煮汁澄清，常用以作 。又，患热黄、五痔。捣汁顿服一升，重者再服。丹石发，冲眼目肿痛。取根一握，洗。捣以少水，绞取汁服之。若热肿处，捣根、茎敷之。外台秘要∶治痔发疼痛。捣 竹汁服一升，一、两服立瘥。若未瘥，再服效。千金翼治外痔。捣 竹绞取汁，搜面作 ，空心吃。日三度，常吃。肘后方∶恶疮连痂痒痛，捣 竹封痂落即瘥。"}]},{"ID":"20240613103928-1vpr15u","Type":"NodeParagraph","Properties":{"id":"20240613103928-1vpr15u","updated":"20240613103945"},"Children":[{"Type":"NodeText","Data":"食医心镜∶治小儿蛲虫攻下部痒。取 竹叶一握，切，以水一升，煎取五合，去滓。空腹饮之，虫即下，用其汁煮粥，亦佳。又方∶治霍乱，吐痢不止。 竹，豉汁中以五味调和，煮羹食之，佳。杨氏产乳治蛊，状如蜗牛，食下部痒。取 竹一把，水二升煮熟，五岁儿空腹服三、五合，隔宿食，明早服之，尤佳。"}]},{"ID":"20240613103836-l9d3rl9","Type":"NodeThematicBreak","Properties":{"id":"20240613103836-l9d3rl9"}},{"ID":"20240613103838-zhg72ap","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103838-zhg72ap","updated":"20240613103846"},"Children":[{"Type":"NodeText","Data":"萹蓄《本草述钩元》"}]},{"ID":"20240613103838-u9uomdc","Type":"NodeParagraph","Properties":{"id":"20240613103838-u9uomdc","updated":"20240613103838"},"Children":[{"Type":"NodeText","Data":"一名扁竹。出东莱山谷。所在有之。春仲蔓延布地，苗似瞿麦，根似蒿。弱茎促节，节紫赤似钗股，叶细绿似䈽竹。节间出花甚细，色微青黄，或淡红，似蓼蓝花状，遂结细实。（覈）"}]},{"ID":"20240613103838-rfbysxm","Type":"NodeParagraph","Properties":{"id":"20240613103838-rfbysxm","updated":"20240613103838"},"Children":[{"Type":"NodeText","Data":"气味苦平。治浸淫疥瘙疽痔，杀三虫。（《本经》）疗霍乱黄疸，利小便。（濒湖）　热淋涩痛，扁竹煎汤频饮。热黄疸疾，扁竹捣汁，顿服一升。多年者，日再服之。食疗法，治小儿蛔咬心痛，面青，口中沫出临死者。扁竹十斤，剉。以水一石，煎至一斗。去渣，煎如饧。隔宿弗食，空心服一升，虫即下。仍常煮汁作饭食。"}]},{"ID":"20240613103838-pz7r1gi","Type":"NodeParagraph","Properties":{"id":"20240613103838-pz7r1gi","updated":"20240613103838"},"Children":[{"Type":"NodeText","Data":"〔论〕萹蓄概谓为通利之药，然观其引蔓促节，节节开花，若封而辟，辟而封。当有逐节以为通，能通而必循其节者，不失之驶疾，亦不致有遗匿，更为搜微抉隐之善剂。其又主杀虫者，以虫从风化，却本于湿之不化。斯味为血分之气药，使血分不致化湿，所以能从治于湿化之风热而杀虫欤。"}]},{"ID":"20240613103838-0ribp41","Type":"NodeParagraph","Properties":{"id":"20240613103838-0ribp41","updated":"20240613103838"},"Children":[{"Type":"NodeText","Data":"蕺于历代本草，俱在菜部，至先生改隶隰草，具有特见。李氏《纲目》仍载蕺于菜部柔滑类，且引赵叔文紫蕺养猪之说，是泥于蕺菜之名，而未能更定耳。春秋时勾践有采蕺事，想犹尝胆之意。即苏恭谓江左人好生食之，然究为隰地所生，不必待人种莳，草类无疑。蒲公英、百合，先生亦自菜部改入草部。夫蒲公英、百合及生姜、干姜、蘹香、薯蓣，乃东璧氏由草部移入菜部者，今先生于姜茴等从之。至蒲公英、百合，则复归草部。是必有说，观于蕺可以类推。是书原本不必与《纲目》合符，故蔓草部白蔹，附山草白芨后，服帛部青布，附隰草青黛后者，并从其旧。而五爪龙草，昔皆不载。因其能治痈疽，并增《纲目》所未备，今亦仍以殿蔓草云。（高佑釲识。）"}]},{"ID":"20240613103642-0ptyp36","Type":"NodeThematicBreak","Properties":{"id":"20240613103642-0ptyp36"}},{"ID":"20240613103655-dzj6poe","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103655-dzj6poe","updated":"20240613103851"},"Children":[{"Type":"NodeText","Data":"萹蓄《中药学》"}]},{"ID":"20240613103655-2w1jm09","Type":"NodeParagraph","Properties":{"id":"20240613103655-2w1jm09","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"【药用】蓼科草本植物萹蓄PolygonumaviculareL.的地上部份。"}]},{"ID":"20240613103655-3n7zzw8","Type":"NodeParagraph","Properties":{"id":"20240613103655-3n7zzw8","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"【性味与归经】苦，寒。归膀胱经。"}]},{"ID":"20240613103655-kwdr54r","Type":"NodeParagraph","Properties":{"id":"20240613103655-kwdr54r","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"【功效】清热利水通淋，杀虫止痒。"}]},{"ID":"20240613103655-rjclhv0","Type":"NodeParagraph","Properties":{"id":"20240613103655-rjclhv0","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"【临床应用】1.用于热淋"}]},{"ID":"20240613103655-58bkd50","Type":"NodeParagraph","Properties":{"id":"20240613103655-58bkd50","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"本品苦行下降，能清利膀胱湿热而利水通淋，故适用于湿热下注、热淋涩痛等症，可与瞿麦、滑石、木通、车前子、栀子、甘草等同用。"}]},{"ID":"20240613103655-4fffw3m","Type":"NodeParagraph","Properties":{"id":"20240613103655-4fffw3m","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"2.用于皮肤湿疹，阴痒之蛔虫病"}]},{"ID":"20240613103655-748r608","Type":"NodeParagraph","Properties":{"id":"20240613103655-748r608","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"本品又有杀虫止痒作用，用于皮肤湿疹、阴痒等症，以本品煎汤外洗。治胆道蛔虫症，可用萹蓄和醋，加水煎服。"}]},{"ID":"20240613103655-8bo2l19","Type":"NodeParagraph","Properties":{"id":"20240613103655-8bo2l19","updated":"20240613103655"},"Children":[{"Type":"NodeText","Data":"【处方用名】萹蓄萹蓄草（洗净，晒干，切碎用）"}]},{"ID":"20240613103655-4hcqp31","Type":"NodeParagraph","Properties":{"id":"20240613103655-4hcqp31","updated":"20240613103659"},"Children":[{"Type":"NodeText","Data":"【一般用量与用法】一钱至三钱，大剂量三钱至五钱，煎服。外用适量。"}]},{"ID":"20240613103642-buy9p4l","Type":"NodeThematicBreak","Properties":{"id":"20240613103642-buy9p4l"}},{"ID":"20240613103644-oozprbr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103644-oozprbr","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"《中国药典》：萹蓄"}]},{"ID":"20240613103644-fybyfeq","Type":"NodeParagraph","Properties":{"id":"20240613103644-fybyfeq","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613103644-ylx49le","Type":"NodeParagraph","Properties":{"id":"20240613103644-ylx49le","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" Biǎn Xù"}]},{"ID":"20240613103644-sfm73ji","Type":"NodeParagraph","Properties":{"id":"20240613103644-sfm73ji","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613103644-y58f7xg","Type":"NodeParagraph","Properties":{"id":"20240613103644-y58f7xg","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 扁蓄、大萹蓄、鸟蓼、扁竹、竹节草、猪牙草、道生草"}]},{"ID":"20240613103644-dsvwdl2","Type":"NodeParagraph","Properties":{"id":"20240613103644-dsvwdl2","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613103644-vbktmrj","Type":"NodeParagraph","Properties":{"id":"20240613103644-vbktmrj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" HERBA POLYGONI AVICULARIS"}]},{"ID":"20240613103644-fa6ou1j","Type":"NodeParagraph","Properties":{"id":"20240613103644-fa6ou1j","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613103644-0nkj3w8","Type":"NodeParagraph","Properties":{"id":"20240613103644-0nkj3w8","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 本品为蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"萹蓄"},{"Type":"NodeText","Data":"Polygonum aviculare L. 的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"地上部分"},{"Type":"NodeText","Data":"。夏季叶茂盛时采收，除去根及杂质，晒干。"}]},{"ID":"20240613103644-glfqmdb","Type":"NodeParagraph","Properties":{"id":"20240613103644-glfqmdb","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613103644-xsd46uk","Type":"NodeParagraph","Properties":{"id":"20240613103644-xsd46uk","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 本品茎呈圆柱形而略扁，有分枝，长15～40cm，直径0。2～0。3cm。表面灰绿色或棕红色，有细密微突起的纵纹；节部稍膨大，有浅棕色膜质的托叶鞘，节间长约3cm；质硬，易折断，断面髓部白色。叶互生，近无柄或具短柄，叶片多脱落或皱缩、破碎，完整者展平后呈披针形，全缘，两面均呈棕绿色或灰绿色。无臭，味微苦。"}]},{"ID":"20240613103644-jz32jyz","Type":"NodeParagraph","Properties":{"id":"20240613103644-jz32jyz","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240613103644-qj5gbpj","Type":"NodeParagraph","Properties":{"id":"20240613103644-qj5gbpj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 置干燥处。"}]},{"ID":"20240613103644-twdhd2q","Type":"NodeParagraph","Properties":{"id":"20240613103644-twdhd2q","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613103644-e6jgujg","Type":"NodeParagraph","Properties":{"id":"20240613103644-e6jgujg","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 除去杂质，洗净，切段，干燥。"}]},{"ID":"20240613103644-03f79e1","Type":"NodeParagraph","Properties":{"id":"20240613103644-03f79e1","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613103644-nl87cho","Type":"NodeParagraph","Properties":{"id":"20240613103644-nl87cho","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" （1） 本品粉末灰绿色。叶上、下表皮细胞垂周壁近平直，平周壁有角质线纹。气孔主为不等式，副卫细胞3 个。叶肉断面观为两面栅栏式，薄壁细胞含草酸钙簇晶，直径18～43μm 。"}]},{"ID":"20240613103644-q8wva7d","Type":"NodeParagraph","Properties":{"id":"20240613103644-q8wva7d","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"（2） 取本品粉末5g，加70％乙醇100ml，盐酸5ml ，加热回流3 小时，滤过，滤液作为供试品溶液。另取槲皮素对照品，加乙醇制成每1ml 含0。5mg 的溶液，作为对照品溶液。照薄层色谱法（附录Ⅵ B）试验，吸取供试品溶液5μl，对照品溶液1μl，分别点于同一以羧甲基纤维素钠为黏合剂的硅胶Ｈ薄层板上，以甲苯－醋酸乙酯－甲酸（5:2:1）为展开剂，展开，取出，晾干，喷以1％ 三氯化铝乙醇溶液，置紫外光灯（365nm） 下检视。供试品色谱中，在与对照品色谱相应的位置上，显相同颜色的荧光斑点。"}]},{"ID":"20240613103644-yhayehh","Type":"NodeParagraph","Properties":{"id":"20240613103644-yhayehh","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613103644-p6hke40","Type":"NodeParagraph","Properties":{"id":"20240613103644-p6hke40","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 归膀胱经。"}]},{"ID":"20240613103644-l1w8doo","Type":"NodeParagraph","Properties":{"id":"20240613103644-l1w8doo","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613103644-mz581xf","Type":"NodeParagraph","Properties":{"id":"20240613103644-mz581xf","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 苦，微寒。"}]},{"ID":"20240613103644-0rsp30g","Type":"NodeParagraph","Properties":{"id":"20240613103644-0rsp30g","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613103644-of8m2a1","Type":"NodeParagraph","Properties":{"id":"20240613103644-of8m2a1","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 利尿通淋，杀虫，止痒。用于膀胱热淋，小便短赤，淋沥涩痛，皮肤湿疹，阴痒带下。"}]},{"ID":"20240613103644-amgwygx","Type":"NodeParagraph","Properties":{"id":"20240613103644-amgwygx","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613103644-cvfivfz","Type":"NodeParagraph","Properties":{"id":"20240613103644-cvfivfz","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 9～15g；外用适量，煎洗患处。"}]},{"ID":"20240613103644-c948uzb","Type":"NodeParagraph","Properties":{"id":"20240613103644-c948uzb","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240613103644-arksuzq","Type":"NodeParagraph","Properties":{"id":"20240613103644-arksuzq","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" （1）用于湿热下注、热淋涩痛等症，可与瞿麦、滑石、木通、车前子、栀子、甘草等同用。用于皮肤湿疹、阴痒等症，以本品煎汤外洗。治胆道蛔虫症，可用萹蓄和醋，加水煎服。"}]},{"ID":"20240613103644-0dxp73y","Type":"NodeParagraph","Properties":{"id":"20240613103644-0dxp73y","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613103644-8bc7esj","Type":"NodeParagraph","Properties":{"id":"20240613103644-8bc7esj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240613103644-c39y4co","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103644-c39y4co","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：萹蓄"}]},{"ID":"20240613103644-njxfr63","Type":"NodeParagraph","Properties":{"id":"20240613103644-njxfr63","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613103644-q7yr679","Type":"NodeParagraph","Properties":{"id":"20240613103644-q7yr679","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" Biǎn Xù"}]},{"ID":"20240613103644-yx1wri5","Type":"NodeParagraph","Properties":{"id":"20240613103644-yx1wri5","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613103644-bat0jqh","Type":"NodeParagraph","Properties":{"id":"20240613103644-bat0jqh","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 竹（《诗经》），萹竹（《本经》），萹茿（《说文》），畜辩、萹蔓（《吴普本草》），扁蓄（《局方》），地萹蓄、编竹（《履巉岩本草》），扁畜（《救荒本草》），粉节草、道生草（《纲目》），扁竹（《本草崇原》），扁竹蓼、乌蓼（《中国药植志》），大蓄片（《南京民间药草》），野铁扫把、路柳、疳积药（《贵州民间方药集》），斑鸠台（《安徽药材》），蚂蚁草、猪圈草、桌面草、路边草、七星草、铁片草、竹节草（《江苏植药志》），扁猪牙（《东北药植志》），残竹草（《滇南本草》整理本），妹子草、大铁马鞭、地蓼、牛鞭草（《中药"}]},{"ID":"20240613103644-6vqcori","Type":"NodeParagraph","Properties":{"id":"20240613103644-6vqcori","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613103644-5d9g963","Type":"NodeParagraph","Properties":{"id":"20240613103644-5d9g963","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613103644-mv0mbla","Type":"NodeParagraph","Properties":{"id":"20240613103644-mv0mbla","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613103644-l8wseme","Type":"NodeParagraph","Properties":{"id":"20240613103644-l8wseme","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 为蓼科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"萹蓄"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。芒种至小暑间，茎叶生长茂盛时采收。割取地上部分，晒干。"}]},{"ID":"20240613103644-ks25tjj","Type":"NodeParagraph","Properties":{"id":"20240613103644-ks25tjj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613103644-gmkro2t","Type":"NodeParagraph","Properties":{"id":"20240613103644-gmkro2t","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 生长于田野路旁、荒地及河边等处。全国各地均有分布。全国大部分地区均产，以河南、四川、浙江、山东、吉林、河北等地产量较大。"}]},{"ID":"20240613103644-qslwrgc","Type":"NodeParagraph","Properties":{"id":"20240613103644-qslwrgc","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613103644-i51xdsq","Type":"NodeParagraph","Properties":{"id":"20240613103644-i51xdsq","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 一年生草本，高15～50厘米。茎匍匐或斜上，基部分枝甚多，具明显的节及纵沟纹；幼枝上微有棱角。叶互生；叶柄短，约2～3毫米，亦有近于无柄者；叶片披针形至椭圆形，长5～16毫米，宽1.5～5毫米，先端钝或尖，基部楔形，全缘，绿色，两面无毛；托鞘膜质，抱茎，下部绿色，上部透明无色，具明显脉纹，其上之多数平行脉常伸出成丝状裂片。花6～10朵簇生于叶腋；花梗短；苞片及小苞片均为白色透明膜质；花被绿色，5深裂，具白色边缘，结果后，边缘变为粉红色；雄蕊通常8枚，花丝短；子房长方形，花柱短，柱头3枚。瘦果包围于宿存花被内，仅顶端小部分外露，卵形，具3棱，长2～3毫米，黑褐色，具细纹及小点。花期6～8月。果期9～10月。"}]},{"ID":"20240613103644-9vzqgue","Type":"NodeParagraph","Properties":{"id":"20240613103644-9vzqgue","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613103644-nf2a64n","Type":"NodeParagraph","Properties":{"id":"20240613103644-nf2a64n","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 干燥全草，茎呈圆柱形稍扁，多弯曲，直径约1.5～3毫米，表面棕红色或灰绿色，光滑无毛，具纵直纹理，节膨大，残存红棕色或白色薄膜状透明的托鞘，节间长短不一；近基部的茎，质坚硬，位于顶端者较柔软，折断面黄白色，中心具广大的髓邮，有时成空洞状。叶片绿褐色或灰绿色，通常脱落。花生于叶腋，红色，但多数已萎落不存；花被黄绿色，顶端边缘粉红色，内藏瘦果1枚，三角状卵形。气微弱，味清凉。以色绿、叶多、质嫩、无杂质者为佳。"}]},{"ID":"20240613103644-vxztyfr","Type":"NodeParagraph","Properties":{"id":"20240613103644-vxztyfr","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613103644-dnski04","Type":"NodeParagraph","Properties":{"id":"20240613103644-dnski04","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 萹蓄作为牧草是有毒的，可使马、羊产生皮炎及胃肠紊乱，鸽对此植物的毒性作用最敏感。猫、兔口服浸剂（10～20％）或煎剂（1：40）的最小致死量为20毫升/公斤，静脉注射水提取物（1：50）则为2毫升/公斤。"}]},{"ID":"20240613103644-d9ul9yi","Type":"NodeParagraph","Properties":{"id":"20240613103644-d9ul9yi","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613103644-bbefq8a","Type":"NodeParagraph","Properties":{"id":"20240613103644-bbefq8a","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 全草含萹蓄甙、槲皮甙、d-儿茶精、没食子酸、咖啡酸、草酸、硅酸、绿原酸、p-香豆酸、粘质、葡萄糖、果糖及蔗糖。"}]},{"ID":"20240613103644-8h5yntw","Type":"NodeParagraph","Properties":{"id":"20240613103644-8h5yntw","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"硅酸的分布：叶1.6％，茎0.6％，根0.4％（如用作硅酸盐药物，可在其整个生长期采集，如用作黄酮药物，则宜于刚开花时采集）。"}]},{"ID":"20240613103644-lp0uzmy","Type":"NodeParagraph","Properties":{"id":"20240613103644-lp0uzmy","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613103644-b4h1lrs","Type":"NodeParagraph","Properties":{"id":"20240613103644-b4h1lrs","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" ①利尿作用"}]},{"ID":"20240613103644-ol2t9cc","Type":"NodeParagraph","Properties":{"id":"20240613103644-ol2t9cc","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"实验证明，萹蓄有利尿作用，煎剂20克/公斤给予盐水负荷的大白鼠后，尿量、钠、钾排出均增加，特别是钾的排出较多，其灰分亦有同样效果，因此认为其利尿作用主要是由于钾盐所致，也有人认为是由于其中所含黄酮甙所致。"}]},{"ID":"20240613103644-w1xq0ny","Type":"NodeParagraph","Properties":{"id":"20240613103644-w1xq0ny","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"②降压作用"}]},{"ID":"20240613103644-9cu0g1i","Type":"NodeParagraph","Properties":{"id":"20240613103644-9cu0g1i","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"萹蓄的水及醇提取物静脉注射，对猫、兔、狗有降压作用。"}]},{"ID":"20240613103644-8stjunw","Type":"NodeParagraph","Properties":{"id":"20240613103644-8stjunw","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"③对子宫及止血作用"}]},{"ID":"20240613103644-sqwgoot","Type":"NodeParagraph","Properties":{"id":"20240613103644-sqwgoot","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"萹蓄水及醇提取物能加速血液凝固，使子宫张力增高，可用作流产及分娩后子宫出血的止血剂。"}]},{"ID":"20240613103644-mji8ou3","Type":"NodeParagraph","Properties":{"id":"20240613103644-mji8ou3","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"④抗菌作用"}]},{"ID":"20240613103644-7e6skp1","Type":"NodeParagraph","Properties":{"id":"20240613103644-7e6skp1","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"1：10的萹蓄浸出液，试管内对某些真菌有抑制作用，对细菌的抑制作用较弱。"}]},{"ID":"20240613103644-oad3uo5","Type":"NodeParagraph","Properties":{"id":"20240613103644-oad3uo5","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑤其他作用"}]},{"ID":"20240613103644-on4yf98","Type":"NodeParagraph","Properties":{"id":"20240613103644-on4yf98","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"能增强呼吸运动的幅度及肺换气量，有轻度收敛作用，可作创伤用药。萹蓄甙对大鼠，犬有利胆作用。给犬静脉注射半数有效量（2.57～4.26毫克/公斤），可使胆盐的排出增加"}]},{"ID":"20240613103644-292edcy","Type":"NodeParagraph","Properties":{"id":"20240613103644-292edcy","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613103644-061r0y5","Type":"NodeParagraph","Properties":{"id":"20240613103644-061r0y5","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 去净杂质及根，洗净，润软，切段晒干。"}]},{"ID":"20240613103644-ksh19iu","Type":"NodeParagraph","Properties":{"id":"20240613103644-ksh19iu","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613103644-w5p6aup","Type":"NodeParagraph","Properties":{"id":"20240613103644-w5p6aup","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 入膀胱经。"}]},{"ID":"20240613103644-2cnwwfo","Type":"NodeParagraph","Properties":{"id":"20240613103644-2cnwwfo","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"①《本草汇言》：\"入足太阳膀胱经。\""}]},{"ID":"20240613103644-f4my07u","Type":"NodeParagraph","Properties":{"id":"20240613103644-f4my07u","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"②《要药分剂》：\"入胃、膀胱二经。\""}]},{"ID":"20240613103644-ceovqmv","Type":"NodeParagraph","Properties":{"id":"20240613103644-ceovqmv","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"③《本草再新》：\"入脾、肾二经。\""}]},{"ID":"20240613103644-ghhnn9t","Type":"NodeParagraph","Properties":{"id":"20240613103644-ghhnn9t","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613103644-rh0l4r2","Type":"NodeParagraph","Properties":{"id":"20240613103644-rh0l4r2","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 苦，寒。"}]},{"ID":"20240613103644-ykree0k","Type":"NodeParagraph","Properties":{"id":"20240613103644-ykree0k","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，平。\""}]},{"ID":"20240613103644-m5h4gra","Type":"NodeParagraph","Properties":{"id":"20240613103644-m5h4gra","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613103644-zqjmtzq","Type":"NodeParagraph","Properties":{"id":"20240613103644-zqjmtzq","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"③《滇南本草》：\"性寒，味苦。\""}]},{"ID":"20240613103644-t0bemcw","Type":"NodeParagraph","Properties":{"id":"20240613103644-t0bemcw","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"④《本草正》：\"味苦涩。\""}]},{"ID":"20240613103644-oybkpkl","Type":"NodeParagraph","Properties":{"id":"20240613103644-oybkpkl","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613103644-vimzyzu","Type":"NodeParagraph","Properties":{"id":"20240613103644-vimzyzu","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 《得配本草》：\"多服泄精气。\""}]},{"ID":"20240613103644-u315vpw","Type":"NodeParagraph","Properties":{"id":"20240613103644-u315vpw","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613103644-dkcmyde","Type":"NodeParagraph","Properties":{"id":"20240613103644-dkcmyde","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 利尿，清热，杀虫。治热淋，癃闭，黄疸，阴蚀，白带，蛔虫，疳积，痔肿，湿疮。"}]},{"ID":"20240613103644-fhthmc9","Type":"NodeParagraph","Properties":{"id":"20240613103644-fhthmc9","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主浸淫，疥瘙疽痔，杀三虫。\""}]},{"ID":"20240613103644-6younbe","Type":"NodeParagraph","Properties":{"id":"20240613103644-6younbe","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗女子阴蚀。\""}]},{"ID":"20240613103644-mug82u9","Type":"NodeParagraph","Properties":{"id":"20240613103644-mug82u9","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"煮汁与小儿饮，疗蛔虫有验。\""}]},{"ID":"20240613103644-pddjtwm","Type":"NodeParagraph","Properties":{"id":"20240613103644-pddjtwm","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"主丹石毒发冲目肿痛，又敷热肿效。\""}]},{"ID":"20240613103644-8tar40o","Type":"NodeParagraph","Properties":{"id":"20240613103644-8tar40o","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑤《滇南本草》：\"利小便。治五淋白浊，热淋，瘀精涩闭关窍，并治妇人气郁，胃中湿热，或白带之症。\""}]},{"ID":"20240613103644-a4eogmu","Type":"NodeParagraph","Properties":{"id":"20240613103644-a4eogmu","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑥《纲目》：\"治霍乱，黄疸，利小便。\""}]},{"ID":"20240613103644-5cok4pn","Type":"NodeParagraph","Properties":{"id":"20240613103644-5cok4pn","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑦《贵州民间方药集》：\"治小儿疳积，消臌胀。\""}]},{"ID":"20240613103644-vsl8ssd","Type":"NodeParagraph","Properties":{"id":"20240613103644-vsl8ssd","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑧《江西中药》：\"治肛门作痒由于湿热者。\""}]},{"ID":"20240613103644-2oslvcx","Type":"NodeParagraph","Properties":{"id":"20240613103644-2oslvcx","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613103644-grbgoty","Type":"NodeParagraph","Properties":{"id":"20240613103644-grbgoty","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，2～3钱；或捣汁。外用：捣敷或煎水洗。"}]},{"ID":"20240613103644-95ri3i8","Type":"NodeParagraph","Properties":{"id":"20240613103644-95ri3i8","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613103644-8jz5kk4","Type":"NodeParagraph","Properties":{"id":"20240613103644-8jz5kk4","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" ①治热淋涩痛：扁竹煎汤频饮。（《生生编》）"}]},{"ID":"20240613103644-ohbauf4","Type":"NodeParagraph","Properties":{"id":"20240613103644-ohbauf4","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"②治大人小儿心经邪热，一切蕴毒，咽干口燥，大渴引饮，心忪面热，烦躁不宁，目赤睛疼，唇焦鼻衄，口舌生疮，咽喉肿痛。又治小便赤涩，或癃闭不通，及热淋，血淋：车前子、瞿麦、扁蓄、滑石、山栀子仁、甘草（炙）、木通、大黄（面裹煨，去面，切，焙）各一斤。上为散，每服二钱，水一盏，入灯芯煎至七分，去滓。温服，食后临卧，小儿量力少少与之。（《局方》八正散）"}]},{"ID":"20240613103644-3r0gwfa","Type":"NodeParagraph","Properties":{"id":"20240613103644-3r0gwfa","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"③治热黄：萹竹取汁顿服一升，多年者再服之。（《药性论》）"}]},{"ID":"20240613103644-y4gitpg","Type":"NodeParagraph","Properties":{"id":"20240613103644-y4gitpg","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"④治蛔虫心痛，面青，口中沫出：萹蓄十斤。细锉，以水一石，煎去滓成煎如饴。空心服，虫自下，皆尽止。（《药性论》）"}]},{"ID":"20240613103644-0b7i6nj","Type":"NodeParagraph","Properties":{"id":"20240613103644-0b7i6nj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑤治小儿蛲虫攻下部痒：萹竹叶一握。切，以水一升，煎取五合，去滓，空腹饮之，虫即下，用其汁煮粥亦佳。（《食医心镜》）"}]},{"ID":"20240613103644-lnea4e9","Type":"NodeParagraph","Properties":{"id":"20240613103644-lnea4e9","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"⑥治肛门湿痒或痔疮初起：萹蓄二、三两。煎汤，趁热先熏后洗。（《浙江民间草药》）"}]},{"ID":"20240613103644-205jnv5","Type":"NodeParagraph","Properties":{"id":"20240613103644-205jnv5","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613103644-7zur6yl","Type":"NodeParagraph","Properties":{"id":"20240613103644-7zur6yl","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" ①治疗细菌性痢疾"}]},{"ID":"20240613103644-a82saer","Type":"NodeParagraph","Properties":{"id":"20240613103644-a82saer","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"取干萹蓄制成糖浆剂，每毫升含生药1克、每次50毫升，日眼2～3次。治疗108例，治愈104例，进步4例。平均退热时间为1天，腹痛消失为4天，腹泻停止、大便恢复正常为5天，服药期间无不良反应。或用新鲜萹蓄全株4～6两（干的2～4两），制成煎剂一次顿服，早、晚饭后各服1次。治疗25例，全部治愈。"}]},{"ID":"20240613103644-h32805f","Type":"NodeParagraph","Properties":{"id":"20240613103644-h32805f","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"②治疗腮腺炎"}]},{"ID":"20240613103644-0tme4sb","Type":"NodeParagraph","Properties":{"id":"20240613103644-0tme4sb","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"取鲜萹蓄1两洗净后切细捣烂，加入适量生石灰水，再调入蛋清，涂敷患处。据20余例观察，一般敷药4小时后即可使体温下降，最长12小时。多数患者1～3天可获痊愈。"}]},{"ID":"20240613103644-6g57tha","Type":"NodeParagraph","Properties":{"id":"20240613103644-6g57tha","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613103644-pdl17oz","Type":"NodeParagraph","Properties":{"id":"20240613103644-pdl17oz","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 张寿颐：\"萹蓄，《本经》、《别录》皆以却除湿热为治。浸淫疥疮，疽痔，阴蚀，三虫，皆湿热为病也。后人以其泄化湿热，故并治溲涩淋浊。濒湖以治黄疸、霍乱，皆即清热利湿之功用。然亦惟湿阻热结为宜，而气虚之病，皆非其治。若湿热疮疡，浸淫痛痒，红肿四溢，脓水淋漓等证，尤其专职。\""}]},{"ID":"20240613103644-6qgmgc6","Type":"NodeParagraph","Properties":{"id":"20240613103644-6qgmgc6","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613103644-b38t4qn","Type":"NodeParagraph","Properties":{"id":"20240613103644-b38t4qn","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613103644-4x4904w","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613103644-4x4904w","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"《中华本草》：萹蓄"}]},{"ID":"20240613103644-wsq58n6","Type":"NodeParagraph","Properties":{"id":"20240613103644-wsq58n6","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613103644-zo86xem","Type":"NodeParagraph","Properties":{"id":"20240613103644-zo86xem","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" Biǎn Xù"}]},{"ID":"20240613103644-3f122mz","Type":"NodeParagraph","Properties":{"id":"20240613103644-3f122mz","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613103644-3w8ppi0","Type":"NodeParagraph","Properties":{"id":"20240613103644-3w8ppi0","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 竹、萹（艹巩）、蓄辩、萹蔓、萹竹、地萹蓄、编竹、粉节草、道生草、萹蓄蓼、百节、百节草、铁绵草、大蓄片、野铁扫把、路柳、斑鸠台、扁猪牙萹蓄"}]},{"ID":"20240613103644-wzk51fq","Type":"NodeParagraph","Properties":{"id":"20240613103644-wzk51fq","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613103644-liplorn","Type":"NodeParagraph","Properties":{"id":"20240613103644-liplorn","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240613103644-6d89h1b","Type":"NodeParagraph","Properties":{"id":"20240613103644-6d89h1b","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"1.《尔雅》郭璞注： 萹蓄似小藜，赤茎节，好生道傍，可食，又杀虫。"}]},{"ID":"20240613103644-y8cjrfv","Type":"NodeParagraph","Properties":{"id":"20240613103644-y8cjrfv","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"2.《本草图经》：篇蓄，今在处有之。春中布地生道傍，苗似瞿麦，叶细绿如竹，赤茎如钗股，节间花出，甚细微，青黄色，根如蒿根。四月、五月采苗阴干。方书亦单用治虫。葛洪小儿蛔方，煮汁令浓，饮之即瘥。"}]},{"ID":"20240613103644-ydbaqk3","Type":"NodeParagraph","Properties":{"id":"20240613103644-ydbaqk3","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613103644-lgm5u6d","Type":"NodeParagraph","Properties":{"id":"20240613103644-lgm5u6d","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蓼科植物萹蓄的全草。"}]},{"ID":"20240613103644-hjeyzny","Type":"NodeParagraph","Properties":{"id":"20240613103644-hjeyzny","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Polygonum aviculare L．"}]},{"ID":"20240613103644-fxwlov8","Type":"NodeParagraph","Properties":{"id":"20240613103644-fxwlov8","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"采收和储藏：在播种当年的7～8月生长旺盛时采收，齐地割取全株，除去杂草、泥沙，捆成把，晒干或鲜用。"}]},{"ID":"20240613103644-u53zh5z","Type":"NodeParagraph","Properties":{"id":"20240613103644-u53zh5z","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613103644-9km6hss","Type":"NodeParagraph","Properties":{"id":"20240613103644-9km6hss","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 生态环境：花期4-8月，果期6-9月。"}]},{"ID":"20240613103644-qrc6hiw","Type":"NodeParagraph","Properties":{"id":"20240613103644-qrc6hiw","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"资源分布：生于山坡、田野、路旁等处。分布于全国各地。"}]},{"ID":"20240613103644-wzbs4dm","Type":"NodeParagraph","Properties":{"id":"20240613103644-wzbs4dm","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613103644-7jk8bxp","Type":"NodeParagraph","Properties":{"id":"20240613103644-7jk8bxp","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 一年生或多年生草本，高10-50cm。植物体有白色粉霜。茎平卧地上或斜上伸展，基部分枝，绿色，具明显沟纹，无毛，基部圆柱形，幼校具棱角。单叶互生，几无柄；托叶鞘抱茎，膜质；叶片窄长椭圆形或披针形，长l-5cm，宽0.5-1cm，先端钝或急尖，基部楔形，两面均无毛，侧脉明显。花小，常l-5朵簇生于叶腋；花梗短，顶端有关节；花被绿色，5裂，裂片椭圆形，边缘白色或淡红色，结果后是覆瓦形包被果实；雄蕊8，花丝短。瘦果三角状卵形，棕黑色至黑色，具不明显细纹及小点，无光泽。"}]},{"ID":"20240613103644-67tmoyd","Type":"NodeParagraph","Properties":{"id":"20240613103644-67tmoyd","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240613103644-kioxyh8","Type":"NodeParagraph","Properties":{"id":"20240613103644-kioxyh8","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 生物学特性 对气候的适应性强，寒冷山区或温暖平坝都能生长。土壤以排水良好的砂质壤土较好。"}]},{"ID":"20240613103644-ll2jt3c","Type":"NodeParagraph","Properties":{"id":"20240613103644-ll2jt3c","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"栽培技术 用种子繁殖：春季播种，畦宽1．5m。撒播或穴播均可。撒播每1hm2用种子22．5kg。穴播行株距各约23cm。每1hm2用种子10．5kg。"}]},{"ID":"20240613103644-57ddg3w","Type":"NodeParagraph","Properties":{"id":"20240613103644-57ddg3w","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"田间管理 苗高7～10cm时匀苗，补苗，中耕除草，追肥2次。"}]},{"ID":"20240613103644-93u6x0b","Type":"NodeParagraph","Properties":{"id":"20240613103644-93u6x0b","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"病虫害防治病害有锈病，应注意排水，发病初期可喷97％敌锈钢300～400倍液防治。"}]},{"ID":"20240613103644-025r3e7","Type":"NodeParagraph","Properties":{"id":"20240613103644-025r3e7","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613103644-06hr3tg","Type":"NodeParagraph","Properties":{"id":"20240613103644-06hr3tg","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 性状鉴别 茎圆柱形而略扁，有分枝，长10-40cm，直径1．0-3mm。表面灰绿色或棕红色，有细密微突起的纵纹；节部稍膨大，有浅棕色膜质的托叶鞘，节间长短不一；质硬，易折断，断面髓部白色。叶互生，叶片多脱落或皱缩破碎，完整者展平后呈长椭圆形或披针形，长l-4cm，宽约5mm，全线，灰绿色或棕绿色。有时可见具宿存花被的小瘦果，黑褐色，卵状三棱形。气微．味微苦。"}]},{"ID":"20240613103644-f4v8quq","Type":"NodeParagraph","Properties":{"id":"20240613103644-f4v8quq","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"以质嫩、叶多、色灰绿者为佳。"}]},{"ID":"20240613103644-876g0tg","Type":"NodeParagraph","Properties":{"id":"20240613103644-876g0tg","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"显微鉴别 叶表面观：表皮细胞多角形，细胞壁微呈念珠状加厚，垂周壁平直或微弯曲；靠叶脉上的表皮细胞呈长圆形，平周壁可见条状纹理；上下表皮均有不等式气孔。"}]},{"ID":"20240613103644-q4ttnr3","Type":"NodeParagraph","Properties":{"id":"20240613103644-q4ttnr3","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"叶肉横切面：为两面栅栏式，薄壁细胞含有草酸钙簇晶。"}]},{"ID":"20240613103644-qvc33qc","Type":"NodeParagraph","Properties":{"id":"20240613103644-qvc33qc","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"理化鉴别 薄层色谱：取本品粗粉2g,加甲醇30ml，回流提取半小时，滤过。取滤液10ml，浓缩至2ml，作为供试品溶液。另取萹蓄甙少量，制成对照品溶液。将上述两种溶液点在聚酰胺薄膜上，以丙酮-乙醇-甲酸-水（3：2：1：3）展开，展距6.3cm，取出晾干。喷1％三氯化铝乙醇溶液后在紫外光灯（254nm）下观察，供试品色谱在与对照品色谱的相应位置，有相同颜色的荧光斑点。"}]},{"ID":"20240613103644-3e2hyhp","Type":"NodeParagraph","Properties":{"id":"20240613103644-3e2hyhp","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240613103644-nrl7cc7","Type":"NodeParagraph","Properties":{"id":"20240613103644-nrl7cc7","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 毒性：萹蓄作为牧草是有毒的，可使马、羊产生皮炎及胃肠紊乱，鸽对此植物的毒性作用最敏感。猫、兔口服浸剂(10-20%)或煎剂(1∶40)的最小致死量为20ml／kg，静脉注射水提取物(1∶50)则为2ml／kg。猫和兔口服浸剂(10-20%)或煎剂(1：40)的最小致死量为20mg／kg，静脉注射水提取物(1:50)则为2ml／kg。"}]},{"ID":"20240613103644-c5r56w9","Type":"NodeParagraph","Properties":{"id":"20240613103644-c5r56w9","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613103644-mcvbxp6","Type":"NodeParagraph","Properties":{"id":"20240613103644-mcvbxp6","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 全革含黄酮类成分：槲皮素（quercetin），萹蓄甙（avivcularin），槲皮甙（quercitrin）[1]，牡荆素（vitexin），异牡荆素（isovitexin），木犀草素（luteolin），鼠李素-3-半乳精甙（rhamnetin-3-galactoside），金丝桃甙（hyperin）[2]等。还含香豆精类成分：伞形花内酯（umbellifer－one），东莨菪素（scopoletin）[1]。又含酸性成分；阿魏酸（ferulicacid)芥子酸（sinapic acid），香草酸（vanillic acid），丁香酸（syri-ngic acid），草木犀酸（melilotic acid），对香豆酸（P－coumaric acid）；对羟基苯甲酸（p-hydroxybenzolic acid），龙胆酸（gentisic acid），咖啡酸（caffeic acid），原儿茶酸（protocatechuic acid），没食子酸（gal-lic acid），对羟基苯乙酸（p－hydroxyphenyl acetic acid），绿原酸（chlorogenic acid），水杨酸（salicylic acid），并没食子酸（ellagicacid）[3]，右旋儿茶精（catechin)，草酸（oxalic acid），硅酸（silicicacid)[4]以及蛋氨酸（methionine），脯氨酸（proline），丝氨酸（serine），苏氨酸（threonine），酪氨酸（tyrosine），苯丙氨酸（pheny-lalanine）,胱氨酸（cystine），精氨酸（arginine），缬氨酸（valine），甘氨酸（glycine），亮氨酸（leucine），赖氨酸（lysine），异亮氨酸（iso-leucine），色氨酸（tryptophan）[5,6]等。还含葡萄糖（glucose），果糖（fructose），蔗糖（sucrose）[4],水溶性多糖[7,8]。"}]},{"ID":"20240613103644-7nskpm9","Type":"NodeParagraph","Properties":{"id":"20240613103644-7nskpm9","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240613103644-n0xvnnn","Type":"NodeParagraph","Properties":{"id":"20240613103644-n0xvnnn","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 1．利尿作用 中医认为萹蓄能利小便，治五淋白浊。实验证明，萹蓄有利尿作用，煎剂20g／kg给大鼠灌喂，可使尿量、钠和钾排出增加，其灰分亦有同样作用，有入认为其利尿成分为其中的钾盐，也有人认为是萹蓄甙。"}]},{"ID":"20240613103644-yf59cki","Type":"NodeParagraph","Properties":{"id":"20240613103644-yf59cki","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用 浓度为25%的全草煎剂对福氏痢疾杆菌和宋内氏痢疾杆菌皆有抑制作用。1：10 浓度的煎剂对须疮癣菌、毛羊状小芽胞菌有抑制作用。40%水煎剂对葡萄球菌、绿脓杆菌、皮肤真菌均有抑制作用。"}]},{"ID":"20240613103644-tacvc4h","Type":"NodeParagraph","Properties":{"id":"20240613103644-tacvc4h","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"3.降压作用 萹蓄水及乙醇提取物静脉注射，对猫、兔和狗均有降压作用。"}]},{"ID":"20240613103644-rh2dpr5","Type":"NodeParagraph","Properties":{"id":"20240613103644-rh2dpr5","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"4.对子宫的作用和止血作用 萹蓄水及乙醇提取物能加速血液凝固和使子宫张力增高的作用。可用作流产及分娩后子宫出血的止血剂。"}]},{"ID":"20240613103644-bct66pj","Type":"NodeParagraph","Properties":{"id":"20240613103644-bct66pj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"5.其它作用 增强呼吸运动的幅度及肺换气量，有轻度收敛作用，可作创伤用药。萹蓄甙对大鼠、犬有利尿作用。给犬静脉注射半数有效量(2.57-4.26mg／kg)，可使胆盐的排出增加。"}]},{"ID":"20240613103644-rky4jgl","Type":"NodeParagraph","Properties":{"id":"20240613103644-rky4jgl","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240613103644-krl610r","Type":"NodeParagraph","Properties":{"id":"20240613103644-krl610r","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 去净杂质及根，洗净，润软，切段晒干。"}]},{"ID":"20240613103644-wmymps2","Type":"NodeParagraph","Properties":{"id":"20240613103644-wmymps2","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240613103644-mo2wygc","Type":"NodeParagraph","Properties":{"id":"20240613103644-mo2wygc","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 取本品粗分2g，加甲醇30ml回流提取半小时，滤过，取滤液10ml浓缩至4ml。将滤液点在滤纸上，滴加1%三氯化铝乙醇液1滴，在紫外灯(365nm)下观察为棕黄色荧光(检查黄酮)。将滤液点在滤纸上，喷0.1%溴酚蓝游泳，显黄色斑点(检查有机酸)。"}]},{"ID":"20240613103644-ykuo4a0","Type":"NodeParagraph","Properties":{"id":"20240613103644-ykuo4a0","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613103644-o33o5lm","Type":"NodeParagraph","Properties":{"id":"20240613103644-o33o5lm","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 膀胱；大肠经"}]},{"ID":"20240613103644-cgg9kil","Type":"NodeParagraph","Properties":{"id":"20240613103644-cgg9kil","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613103644-dkoih47","Type":"NodeParagraph","Properties":{"id":"20240613103644-dkoih47","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 苦；性微寒"}]},{"ID":"20240613103644-uktj6nx","Type":"NodeParagraph","Properties":{"id":"20240613103644-uktj6nx","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613103644-rgygl6y","Type":"NodeParagraph","Properties":{"id":"20240613103644-rgygl6y","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 《得配本草》：多服泄精气。"}]},{"ID":"20240613103644-y5d2foi","Type":"NodeParagraph","Properties":{"id":"20240613103644-y5d2foi","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613103644-ckurkt5","Type":"NodeParagraph","Properties":{"id":"20240613103644-ckurkt5","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 利水通淋；杀虫止痒。主淋证；小便不利；黄疸；带下；泻痢；蛔虫病；蛲虫病；钩虫病；妇女蚀；皮肤湿疮；疥癣；痔疾"}]},{"ID":"20240613103644-3rak8dw","Type":"NodeParagraph","Properties":{"id":"20240613103644-3rak8dw","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613103644-1xegat9","Type":"NodeParagraph","Properties":{"id":"20240613103644-1xegat9","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤10-15g；或入丸、散；杀虫 单用30-60g，鲜品捣汁饮50-100g。外用：适量，煎水洗，捣烂敷或捣汁搽。"}]},{"ID":"20240613103644-qpqxsko","Type":"NodeParagraph","Properties":{"id":"20240613103644-qpqxsko","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613103644-x2z3ios","Type":"NodeParagraph","Properties":{"id":"20240613103644-x2z3ios","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" ①治热淋涩痛： 扁竹煎汤频次。(《生生编》)②治大人小儿心经邪热，一切蕴毒，咽干口燥，大渴引饮，心忪面热，烦躁不宁，目赤睛疼，唇焦鼻衄，口舌生疮，咽喉肿痛。 又治小便亦涩，或癃闭不通，及热淋，血淋： 车前子、瞿麦、扁蓄、滑石、山栀子仁、甘草(炙)、木通、大黄(面裹煨，去面，切，焙)各一斤。上为散，每服二钱，水一盏，入灯芯煎至七分，去滓。温服，食后临卧，小儿量力少少与之。(《局方》八正散)③治热：ＢＩＡＮ竹取汁顿服一升，多年者再服之。 (《药性论》)④治蛔虫心痛，面青，口中沫出：BIAN蓄十斤。细锉，以水一石，煎去滓成煎如饴。空心服， 虫自下皆尽，止。(《药性论》)⑤治小儿蛲虫攻下部痒： BIAN竹叶一握。切，以水一升，煎取五合，去滓，空腹饮之，虫即下，用其汁煮粥亦佳。(《食医心镜》)⑥治肛门湿痒或痔疮初起：BIAN蓄二、三两。煎汤，趁热先熏后洗。 (《浙江民间草药》)"}]},{"ID":"20240613103644-6sbxlwc","Type":"NodeParagraph","Properties":{"id":"20240613103644-6sbxlwc","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240613103644-8ncrxru","Type":"NodeParagraph","Properties":{"id":"20240613103644-8ncrxru","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主浸淫，疥瘙疽痔，杀三虫。"}]},{"ID":"20240613103644-ny8w0zl","Type":"NodeParagraph","Properties":{"id":"20240613103644-ny8w0zl","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"2.《别录》：疗女子阴蚀。"}]},{"ID":"20240613103644-dosny2i","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240613103644-dosny2i","updated":"20240613103644"},"Children":[{"ID":"20240613103644-jqcy3h4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20240613103644-jqcy3h4","updated":"20240613103644"},"Children":[{"ID":"20240613103644-sg3ev62","Type":"NodeParagraph","Properties":{"id":"20240613103644-sg3ev62","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"陶弘景：煮汁与小儿饮，疗蛔虫有验。"}]}]}]},{"ID":"20240613103644-nk1wlo3","Type":"NodeParagraph","Properties":{"id":"20240613103644-nk1wlo3","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"4.《药性论》：主丹石毒发冲目肿痛，又敷热肿效。"}]},{"ID":"20240613103644-8q7odc0","Type":"NodeParagraph","Properties":{"id":"20240613103644-8q7odc0","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"5.《滇南本草》：利小便。治五淋白浊，热淋，瘀精涩闭关窍，并治妇人气郁，胃中湿热，或白带之症。"}]},{"ID":"20240613103644-enisoq7","Type":"NodeParagraph","Properties":{"id":"20240613103644-enisoq7","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"6.《纲目》：治霍乱，黄疸，利小便。"}]},{"ID":"20240613103644-6k9b2oj","Type":"NodeParagraph","Properties":{"id":"20240613103644-6k9b2oj","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"7.《贵州民间方药集》：治小儿疳积，消臌胀。"}]},{"ID":"20240613103644-zeuv28p","Type":"NodeParagraph","Properties":{"id":"20240613103644-zeuv28p","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"8.《江西中药》：治肛门作痒由于湿热者。细捣烂，加1-3天可获痊愈。"}]},{"ID":"20240613103644-9517v9r","Type":"NodeParagraph","Properties":{"id":"20240613103644-9517v9r","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613103644-bz057n6","Type":"NodeParagraph","Properties":{"id":"20240613103644-bz057n6","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 张寿颐：萹蓄，《本经》、《别录》皆以却除湿热为治。浸淫疥疮，疽痔，阴蚀，三虫，皆湿热为病也。后人以其泄化湿热，故并治溲涩淋浊。濒湖以治黄疸、霍乱，皆即清热利湿之功用。然亦惟湿阻热结为宜，而气虚之病，皆非其治。若湿热疮疡，浸淫痛痒；红肿四溢，脓水淋漓等证，尤其专职。。"}]},{"ID":"20240613103644-kl6igru","Type":"NodeParagraph","Properties":{"id":"20240613103644-kl6igru","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613103644-vclz2q3","Type":"NodeParagraph","Properties":{"id":"20240613103644-vclz2q3","updated":"20240613103644"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613103645-qehiatm","Type":"NodeThematicBreak","Properties":{"id":"20240613103645-qehiatm"}},{"ID":"20240613103646-jlslsjm","Type":"NodeParagraph","Properties":{"id":"20240613103646-jlslsjm"}}]}