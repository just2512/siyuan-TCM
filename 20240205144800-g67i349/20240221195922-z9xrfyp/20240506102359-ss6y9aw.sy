8owpoe.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 356px;\" parent-style=\"width: 366px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628124504-zdod5g7","Type":"NodeParagraph","Properties":{"id":"20240628124504-zdod5g7","updated":"20240822173637"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 648px;","style":"width: 638px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花4-20240628124601-ab329sl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 638px;\" parent-style=\"width: 648px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 539px;","style":"width: 529px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 1-20240807162738-wh1r0h4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 529px;\" parent-style=\"width: 539px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822173755-04yky2g","Type":"NodeParagraph","Properties":{"id":"20240822173755-04yky2g","updated":"20240822173755"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 720px;","style":"width: 710px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (7)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 7-20240822173755-7rcn46p.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 710px;\" parent-style=\"width: 720px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 457px;","style":"width: 447px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 2-20240807162841-ytjypi8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 447px;\" parent-style=\"width: 457px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628125100-h6h9wp3","Type":"NodeParagraph","Properties":{"id":"20240628125100-h6h9wp3","updated":"20240822173818"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 841px;","style":"width: 831px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花6-20240628125059-gtd2msa.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 831px;\" parent-style=\"width: 841px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 377px;","style":"width: 367px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 3-20240807162941-z59yzf9.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 367px;\" parent-style=\"width: 377px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240717191715-rzr9wny","Type":"NodeParagraph","Properties":{"id":"20240717191715-rzr9wny","updated":"20240822173819"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 842px;","style":"width: 832px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花-20240717191715-4pw3ayk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 832px;\" parent-style=\"width: 842px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628115704-u42deau","Type":"NodeParagraph","Properties":{"id":"20240628115704-u42deau","updated":"20240628125155"},"Children":[{"Type":"NodeText","Data":"二"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：长一二尺，茎柔细，叶似柳叶，花状如金钱菊，浅黄色，中心有细白绒坐丛，花圆而复下，故名旋复。诸花皆升，旋覆独降（这里的升降指药性的升降，一般来说花的质轻，服入后药性多呈现为升，而旋复花反之，为降。）质量好的旋覆花，朵大金黄，并且中心有细绒毛，且枝梗较少。"}]},{"ID":"20240628124527-0hh4u14","Type":"NodeParagraph","Properties":{"id":"20240628124527-0hh4u14"}},{"ID":"20240628114818-fjg2pqk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20240628114818-fjg2pqk","updated":"20240822173914"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"text","TextMarkTextContent":"以下为"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color6);"},"TextMarkType":"strong text","TextMarkTextContent":"（抖音创作者“百草恒益”个人见解）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color6);\"}"}]},{"ID":"20240628123307-o73hp8l","Type":"NodeParagraph","Properties":{"id":"20240628123307-o73hp8l","updated":"20240822173731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"正品"}]},{"ID":"20240628112107-7b0ln31","Type":"NodeParagraph","Properties":{"id":"20240628112107-7b0ln31","updated":"20240822173914"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 304px;","style":"width: 294px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 4-20240807163112-beh17fo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 294px;\" parent-style=\"width: 304px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 575px;","style":"width: 565px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 5-20240807163212-pjbys30.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 565px;\" parent-style=\"width: 575px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"旋覆花 (6)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/旋覆花 6-20240807163252-bbqa9ix.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628112443-qw83d66","Type":"NodeParagraph","Properties":{"id":"20240628112443-qw83d66","updated":"20240822173731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"伪品（线叶旋覆花、东北旋覆花）（花朵比真正的旋覆花小，冠毛隐约有淡红色，有严重呕吐、反胃的副作用，市场上普遍被当作旋覆花混在其中）"}]},{"ID":"20240628112502-kdjix2q","Type":"NodeParagraph","Properties":{"id":"20240628112502-kdjix2q","updated":"20240822173731"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"线叶旋覆花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/线叶旋覆花-20240807163406-bk7nuc1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240612185501-6o6ulx2","Type":"NodeParagraph","Properties":{"id":"20240612185501-6o6ulx2","updated":"20240822173731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"伪品（湖北旋覆花）"}]},{"ID":"20240628112313-uubruay","Type":"NodeParagraph","Properties":{"id":"20240628112313-uubruay","updated":"20240822173731"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"湖北旋覆花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/湖北旋覆花-20240807163453-zljhard.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628112337-5lgrdib","Type":"NodeParagraph","Properties":{"id":"20240628112337-5lgrdib","updated":"20240822173731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"伪品（水朝阳旋覆花）"}]},{"ID":"20240628112334-08cszg1","Type":"NodeParagraph","Properties":{"id":"20240628112334-08cszg1","updated":"20240822173731"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"水朝阳旋覆花"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/水朝阳旋覆花-20240807163548-2tl3dkx.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628112402-23bvtck","Type":"NodeParagraph","Properties":{"id":"20240628112402-23bvtck","updated":"20240822173731"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"伪品（山皇菊）"}]},{"ID":"20240628112400-by0iv5r","Type":"NodeParagraph","Properties":{"id":"20240628112400-by0iv5r","updated":"20240822173731"},"Children":[{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"山皇菊"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/山皇菊-20240807163645-laj1alw.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628112648-9rymum1","Type":"NodeParagraph","Properties":{"id":"20240628112648-9rymum1","updated":"20240822173900"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三注：创作者本草恒益认为，正品旋覆花1cm左右，易散开，冠毛30个，冠毛白色；线叶旋覆花花朵很小，时常显现一种淡红色；湖北旋覆花不易散开，中间微黄；水朝阳旋覆花花朵较大，不易散开，略黑；"}]},{"ID":"20240628110418-qru0t5a","Type":"NodeThematicBreak","Properties":{"id":"20240628110418-qru0t5a","updated":"20240822173731"}},{"ID":"20240628110424-stv26bq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240628110424-stv26bq","updated":"20240628110428"},"Children":[{"Type":"NodeText","Data":"旋复花《神农本草经》"}]},{"ID":"20240628110424-qz9fzdk","Type":"NodeParagraph","Properties":{"id":"20240628110424-qz9fzdk","updated":"20240628110424"},"Children":[{"Type":"NodeText","Data":"味咸温。"}]},{"ID":"20240628110424-0cia96z","Type":"NodeParagraph","Properties":{"id":"20240628110424-0cia96z","updated":"20240628110424"},"Children":[{"Type":"NodeText","Data":"主结气，胁下满，惊悸，除水，去五脏间寒热，补中下气。一名金沸草，一名盛椹。生川谷。"}]},{"ID":"20240628110424-elnqdwc","Type":"NodeParagraph","Properties":{"id":"20240628110424-elnqdwc","updated":"20240628110424"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名戴椹，生平泽，五月采花，日干，二十日成。"}]},{"ID":"20240628110424-b1ccwl4","Type":"NodeParagraph","Properties":{"id":"20240628110424-b1ccwl4","updated":"20240628110424"},"Children":[{"Type":"NodeText","Data":"案《说文》云：（上艹下复），盗庚也。《尔雅》云：盗庚：郭璞云：旋复似菊。"}]},{"ID":"20240612192648-seqniij","Type":"NodeThematicBreak","Properties":{"id":"20240612192648-seqniij"}},{"ID":"20240612192737-3hff4wo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192737-3hff4wo","updated":"20240612192742"},"Children":[{"Type":"NodeText","Data":"旋复花《本经逢原》"}]},{"ID":"20240612192737-65obm8j","Type":"NodeParagraph","Properties":{"id":"20240612192737-65obm8j","updated":"20240612192737"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名金沸草"}]},{"ID":"20240612192737-fshh2lx","Type":"NodeParagraph","Properties":{"id":"20240612192737-fshh2lx","updated":"20240612192737"},"Children":[{"Type":"NodeText","Data":"咸甘温，小毒。"}]},{"ID":"20240612192737-k7p2pi4","Type":"NodeParagraph","Properties":{"id":"20240612192737-k7p2pi4","updated":"20240612192737"},"Children":[{"Type":"NodeText","Data":"《本经》主结气胁下满惊悸，除水，去五脏间寒热，补中下气。"}]},{"ID":"20240612192737-fwk0v5e","Type":"NodeParagraph","Properties":{"id":"20240612192737-fwk0v5e","updated":"20240612192737"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"旋覆花升而能降，肺与大肠药也。其功在于开结下气，行水消痰，治惊悸，祛痞坚，除寒热，散风湿，开胃气，止呕逆，除噫气，故肺中伏饮寒嗽宜之。仲景治伤寒汗下后，心下痞坚，噫气不除，有旋复代赭石汤。《金匮》半产漏下，有旋复花汤。胡洽治痰饮在两胁胀满，有旋复花汤，皆取其能下气也。但性专温散，故阴虚劳嗽，风热燥咳，不可误用，用之嗽必愈甚。《本经》言补中下气者，甘能缓中，咸能润下，痰气下而中气安，胁下满结，寒热惊悸，水气皆除矣。"}]},{"ID":"20240612192648-rl30lom","Type":"NodeThematicBreak","Properties":{"id":"20240612192648-rl30lom"}},{"ID":"20240612192722-j9hre1s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192722-j9hre1s","updated":"20240612192731"},"Children":[{"Type":"NodeText","Data":"旋复花《千金翼方》"}]},{"ID":"20240612192722-snofzo3","Type":"NodeParagraph","Properties":{"id":"20240612192722-snofzo3","updated":"20240612192722"},"Children":[{"Type":"NodeText","Data":"味咸甘，温，微温，冷利，有小毒。主结气胁下满，惊悸，除水，去脏间寒热，补中下气，消胸上痰结，唾如胶漆，心胁痰水，膀胱留饮，风气湿痹，皮间死肉，目中眵 ，利大肠，通血脉，益色泽。一名戴椹，一名金沸草，一名盛椹。其根∶主风湿。生平泽川谷，五月采花，晒干，二十日成。"}]},{"ID":"20240612192648-hbfx1a4","Type":"NodeThematicBreak","Properties":{"id":"20240612192648-hbfx1a4"}},{"ID":"20240612192708-vr9q8nr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192708-vr9q8nr","updated":"20240612192716"},"Children":[{"Type":"NodeText","Data":"旋复花《本草图经》"}]},{"ID":"20240612192708-j7xz4io","Type":"NodeParagraph","Properties":{"id":"20240612192708-j7xz4io","updated":"20240612192710"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"旋复花"},{"Type":"NodeText","Data":"，生平泽川谷，今所在有之，二月以后生苗，多近水旁，大似红蓝而无刺；长一、二尺以来；叶如柳；茎细；六月开花如菊花，小铜钱大，深黄色；上党田野人呼为金钱花，七月、八月采花，曝干，二十日成。今近都人家园圃所莳金钱花，花叶并如上说，极易繁盛，恐即此旋复也。张仲景治伤寒汗下后，心下痞坚，噫气不除，有七物旋复代赭汤。杂治妇人有三物旋复汤。胡洽有除痰饮在两胁胀满等旋复花丸，用之尤多。"}]},{"ID":"20240612192648-vej7pox","Type":"NodeThematicBreak","Properties":{"id":"20240612192648-vej7pox"}},{"ID":"20240612192654-vl6ishw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192654-vl6ishw","updated":"20240612192701"},"Children":[{"Type":"NodeText","Data":"旋覆花《本草衍义》"}]},{"ID":"20240612192654-3ba3pan","Type":"NodeParagraph","Properties":{"id":"20240612192654-3ba3pan","updated":"20240612192654"},"Children":[{"Type":"NodeText","Data":"叶如大菊，又如艾蒿。八九月有花，大如梧桐子，花淡黄绿，繁茂，圆而覆下，亦一异也。其香过于菊，行痰水，去头目风。其味甘苦辛，亦走散之药也。其旋花四月五月有花，别一种，非此花也，第八卷已具。"}]},{"ID":"20240612185501-l48xkps","Type":"NodeThematicBreak","Properties":{"id":"20240612185501-l48xkps"}},{"ID":"20240612192629-ro8lo6y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192629-ro8lo6y","updated":"20240612192635"},"Children":[{"Type":"NodeText","Data":"旋复花《神农本草经赞》"}]},{"ID":"20240612192629-aaz87xi","Type":"NodeParagraph","Properties":{"id":"20240612192629-aaz87xi","updated":"20240612192629"},"Children":[{"Type":"NodeText","Data":"味咸温。主结气。胁下满。惊悸。除水。去五脏间寒热。补中下气。一名金沸草。"}]},{"ID":"20240612192629-gfrarh9","Type":"NodeParagraph","Properties":{"id":"20240612192629-gfrarh9","updated":"20240612192629"},"Children":[{"Type":"NodeText","Data":"一名戴椹。生川谷。"}]},{"ID":"20240612192629-icr3h3s","Type":"NodeParagraph","Properties":{"id":"20240612192629-icr3h3s","updated":"20240612192629"},"Children":[{"Type":"NodeText","Data":"菊黄柳绿。善盗庚先。旋回罗叠。覆下钱圆。金垂滴滴。水近溅溅。香芬鼻观。目忌延缘。"}]},{"ID":"20240612192629-aj9hdp7","Type":"NodeParagraph","Properties":{"id":"20240612192629-aj9hdp7","updated":"20240612192629"},"Children":[{"Type":"NodeText","Data":"苏颂曰。叶似柳根细。六月开花如菊。深黄色。尔雅。盗庚。李时珍曰。庚者金也。"}]},{"ID":"20240612192629-0fox6ma","Type":"NodeParagraph","Properties":{"id":"20240612192629-0fox6ma","updated":"20240612192629"},"Children":[{"Type":"NodeText","Data":"夏开黄花。盗窃金气也。寇宗曰。花圆而覆下。故名旋复。群芳谱。一名叠罗金。李时珍曰。"}]},{"ID":"20240612192629-9ewa7gt","Type":"NodeParagraph","Properties":{"id":"20240612192629-9ewa7gt","updated":"20240612192629"},"Children":[{"Type":"NodeText","Data":"花形如金钱菊。水泽边生。俗传露水滴下即生。故名滴滴金。赵孟诗。妙香清鼻观。酉阳杂俎。李卫公言。嗅其花能损目。庄子。延缘苇间。"}]},{"ID":"20240612192553-usqw559","Type":"NodeThematicBreak","Properties":{"id":"20240612192553-usqw559"}},{"ID":"20240612192617-nc6mk81","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192617-nc6mk81","updated":"20240612192623"},"Children":[{"Type":"NodeText","Data":"旋覆花《得配本草》"}]},{"ID":"20240612192617-qeftwab","Type":"NodeParagraph","Properties":{"id":"20240612192617-qeftwab","updated":"20240612192617"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名金沸草"}]},{"ID":"20240612192617-48ps2nb","Type":"NodeParagraph","Properties":{"id":"20240612192617-48ps2nb","updated":"20240612192617"},"Children":[{"Type":"NodeText","Data":"苦、辛，温。入手太阴、阳明经气分。降心脾伏饮，去五脏寒热，除胁下气满，破膈痰如漆。止呕逆，平惊悸。（痰水去也。）"}]},{"ID":"20240612192617-24xf0rk","Type":"NodeParagraph","Properties":{"id":"20240612192617-24xf0rk","updated":"20240612192617"},"Children":[{"Type":"NodeText","Data":"配地葱、新绛，治半产漏下。配赭石、半夏，治噫气痞硬。"}]},{"ID":"20240612192617-7az28n4","Type":"NodeParagraph","Properties":{"id":"20240612192617-7az28n4","updated":"20240612192617"},"Children":[{"Type":"NodeText","Data":"去皮蒂蕊壳，蒸用。入药须绢包煎，恐妨肺而反嗽。气虚，大肠冷利，阴虚燥咳，三者禁用。"}]},{"ID":"20240612192553-u4dpwdn","Type":"NodeThematicBreak","Properties":{"id":"20240612192553-u4dpwdn"}},{"ID":"20240612192607-cd8zhyq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192607-cd8zhyq","updated":"20240612192611"},"Children":[{"Type":"NodeText","Data":"旋覆花《长沙药解》"}]},{"ID":"20240612192607-gcce7tf","Type":"NodeParagraph","Properties":{"id":"20240612192607-gcce7tf","updated":"20240612192607"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】旋复花。味咸温。主结气，胁下满，惊悸，除水，去五脏间寒热，补中下气。一名金沸草，一名盛椹。生川谷。"}]},{"ID":"20240612192607-zvpyby7","Type":"NodeParagraph","Properties":{"id":"20240612192607-zvpyby7","updated":"20240612192607"},"Children":[{"Type":"NodeText","Data":"味咸，入手太阴肺、足阳明胃经。行凝涩而断血漏，涤瘀浊而下气逆。"}]},{"ID":"20240612192607-4952ltm","Type":"NodeParagraph","Properties":{"id":"20240612192607-4952ltm","updated":"20240612192607"},"Children":[{"Type":"NodeText","Data":"《金匮》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋覆花汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"旋覆花三两，葱白十四茎，新绛少许，煎，顿服。"},{"Type":"NodeText","Data":"治妇人半产漏下。以肝脾阳虚，胎元失养，是以半产。血瘀不升，是以漏下。旋覆行血脉之瘀，葱白通经气之滞，新绛止崩而除漏也。"}]},{"ID":"20240612192607-yavvoc1","Type":"NodeParagraph","Properties":{"id":"20240612192607-yavvoc1","updated":"20240612192607"},"Children":[{"Type":"NodeText","Data":"《伤寒》"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋覆代赭汤"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"旋覆花三两，半夏半升，代赭石一两，人参二两，甘草三两，大枣十二枚，生姜五两。"},{"Type":"NodeText","Data":"治伤寒，汗吐下后，表证已解，心下痞硬，噫气不除者。以土虚胃逆，碍甲木下行之路，胃口痞塞，浊气不降。参、甘、大枣，补其中脘，半夏，姜、赭，降其逆气，旋覆花行其瘀浊也。"}]},{"ID":"20240612192607-lzc4kwb","Type":"NodeParagraph","Properties":{"id":"20240612192607-lzc4kwb","updated":"20240612192607"},"Children":[{"Type":"NodeText","Data":"旋覆花通血脉而行瘀涩，能除漏滴，清气道而下痰饮，善止哕噫。其诸主治，逐痰饮，止呕逆，消满结，软痞硬，通血脉，消水肿。"}]},{"ID":"20240612192553-kznpbcz","Type":"NodeThematicBreak","Properties":{"id":"20240612192553-kznpbcz"}},{"ID":"20240612192554-he5kp24","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192554-he5kp24","updated":"20240612192600"},"Children":[{"Type":"NodeText","Data":"旋覆花《本草便读》"}]},{"ID":"20240612192554-xeskhxe","Type":"NodeParagraph","Properties":{"id":"20240612192554-xeskhxe","updated":"20240612192554"},"Children":[{"Type":"NodeText","Data":"咸以软坚．蠲饮化痰都有效．苦能下达．通肠导水悉皆能．具宣行肺胃之功．噫气不除．赖其辛散．有斡旋胸中之力．肝邪痹着．借以温通．（旋覆花一名金沸草．六月开细黄花．其香如菊．中有白毛．宜绢包用．咸温辛苦之性．能利大肠．软坚痰．散结气．搜肝泻肺．由胃及肠．旋覆之功．皆在咸润而已．旋覆花本为肺药．以其散结气．软坚痰．金令下行．而能及肝与肠也．）"}]},{"ID":"20240612185501-tkh5vpu","Type":"NodeThematicBreak","Properties":{"id":"20240612185501-tkh5vpu"}},{"ID":"20240612192544-1rd99mu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192544-1rd99mu","updated":"20240612192548"},"Children":[{"Type":"NodeText","Data":"旋复花《本草求真》"}]},{"ID":"20240612192544-alaonty","Type":"NodeParagraph","Properties":{"id":"20240612192544-alaonty","updated":"20240612192544"},"Children":[{"Type":"NodeText","Data":"（隰草）下肺气消痰结"}]},{"ID":"20240612192544-3vzif7x","Type":"NodeParagraph","Properties":{"id":"20240612192544-3vzif7x","updated":"20240612192544"},"Children":[{"Type":"NodeText","Data":"旋复花（专入肺大肠）。即本经所名金沸草者是也。其性虽兼辛温。凡阴虚劳嗽。风热燥咳。不可误用。用之其嗽必甚。究之味苦而咸。性主下降。凡心脾伏饮。胁下胀满。胸上痰结。唾如胶漆。风气湿痹。皮间死肉。服之即能有效。更能续筋敷伤。（筋断。捣汁滴伤处。以滓敷上。半月即愈。时珍曰。凡藤蔓之属。象人之筋。所以多治筋病。旋复花藤细如筋。可啖。故能续筋敷伤。）是以仲景之治伤寒汗下后。心下痞坚。噫气不除。有旋复代赭石汤。（噫气即嗳气也。经曰。五气所病。心为噫。又曰。寒气客于胃。厥逆从下上散。复出于胃。故为噫。噫气多属胃气虚弱。三焦失职。清无所归。浊无所降。然亦有痰有火有食。仲景立此方以治伤寒汗下后胃虚。内用人参甘草以扶正。姜枣以和中。旋复花旋转阴中阻格之阳升而上达。赭石使恋阳留滞之阴降而下行。然后参甘大枣。可收补虚之功。生姜半夏。可奏开痞之效。）并金匮半产漏下。有旋复花汤。胡洽治痰饮在两胁胀满。有旋复花汤。皆取苦能下气故耳。惟其性专主下。故书皆载病衰弱大肠虚寒者切忌。以其不禁再下故也。五月五日采花晒干。去皮蒂蕊壳用。"}]},{"ID":"20240612185502-tdxthzm","Type":"NodeThematicBreak","Properties":{"id":"20240612185502-tdxthzm"}},{"ID":"20240612192534-sq9elty","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192534-sq9elty","updated":"20240612192538"},"Children":[{"Type":"NodeText","Data":"旋复花《本草新编》"}]},{"ID":"20240612192534-rdg5mnx","Type":"NodeParagraph","Properties":{"id":"20240612192534-rdg5mnx","updated":"20240612192534"},"Children":[{"Type":"NodeText","Data":"旋复花，味酸、甘，气温，无毒。一云∶冷利，有小毒。误也。入心、肝、大小肠。治头风，明目，逐水通便，去心满、噫气、痞坚，消胸结痰涎，定惊怪，止寒热。此物有旋转乾坤之象，凡气逆者，可使之重安，但只可一用，而不可再用。至虚弱之人，尤不宜轻用也。"}]},{"ID":"20240612192534-pkb4xfp","Type":"NodeParagraph","Properties":{"id":"20240612192534-pkb4xfp","updated":"20240612192534"},"Children":[{"Type":"NodeText","Data":"或问旋复花治气逆甚神，为伤寒要药，但不识可于伤寒之外，而亦治之乎？夫气逆之症，不止伤寒，旋复花之治气，尤于伤寒之外见奇。但伤寒气逆，不必加入人参，而杂症门中之气逆，非人参不能奏功，必须共享耳。"}]},{"ID":"20240612192534-6spil9u","Type":"NodeParagraph","Properties":{"id":"20240612192534-6spil9u","updated":"20240612192534"},"Children":[{"Type":"NodeText","Data":"或问旋复花不可独用见奇功，有之乎？旋复花固不可独用也，得代赭石，则能收旋转之功。"}]},{"ID":"20240612192534-ge5jpyk","Type":"NodeParagraph","Properties":{"id":"20240612192534-ge5jpyk","updated":"20240612192534"},"Children":[{"Type":"NodeText","Data":"凡逆气而不能旋转者，必须用之，下喉而气即转矣。二者不止能转气，而且能安气，亦必须人参尤奇。"}]},{"ID":"20240612192534-egqimqu","Type":"NodeParagraph","Properties":{"id":"20240612192534-egqimqu","updated":"20240612192534"},"Children":[{"Type":"NodeText","Data":"或问旋复花谓是走散之药，然乎？夫旋复善转气，非走气也，故气逆者，得之而顺。岂气顺者，反用之而散乎。"}]},{"ID":"20240612192423-lapw5ks","Type":"NodeThematicBreak","Properties":{"id":"20240612192423-lapw5ks"}},{"ID":"20240612192523-wd2rnuz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192523-wd2rnuz","updated":"20240612192528"},"Children":[{"Type":"NodeText","Data":"旋覆花《本草蒙筌》"}]},{"ID":"20240612192523-dg9e6n2","Type":"NodeParagraph","Properties":{"id":"20240612192523-dg9e6n2","updated":"20240612192523"},"Children":[{"Type":"NodeText","Data":"味咸、甘，气温。无毒。一云冷利。有小毒。丛生深谷中，又名金沸草。颜色深黄如菊，人又呼金钱花。七月采收，曝干入药。治头风明目，逐水湿通便。去心满噫气痞坚，兼除。倘病者稍涉虚羸，防损气不宜多服。"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"叶"},{"Type":"NodeText","Data":"理金疮止血，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"主风湿续筋。"}]},{"ID":"20240612192423-9zbzrwn","Type":"NodeThematicBreak","Properties":{"id":"20240612192423-9zbzrwn"}},{"ID":"20240612192458-ffoge5g","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192458-ffoge5g","updated":"20240612192509"},"Children":[{"Type":"NodeText","Data":"旋复花《医学入门》"}]},{"ID":"20240612192458-hpaecnm","Type":"NodeParagraph","Properties":{"id":"20240612192458-hpaecnm","updated":"20240612192458"},"Children":[{"Type":"NodeText","Data":"旋复花咸甘冷烈，逐水消痰止呕噎，宽胸胁清头目风，治痹又利肠脏结。"}]},{"ID":"20240612192458-3z5zuvv","Type":"NodeParagraph","Properties":{"id":"20240612192458-3z5zuvv","updated":"20240612192458"},"Children":[{"Type":"NodeText","Data":"花如菊，淡黄绿，繁茂圆而复下，俗名金沸草。有小毒。治心胁痰水及膀胱留饮，寒热水肿，消胸上痰结、唾如胶漆，开胃，止呕逆不下食；治伤寒汗吐下后心下痞坚，噫气不止及结气胁下满，去头面风、目中眵 、风气湿痹、皮间死肌，利大肠，去五脏间寒热结气。兼通血脉，除惊，补中下气。《衍义》云∶走散之药，稍涉虚者禁用。去梗叶，蒸熟晒干。入煎药，用绢滤过，免伤人肺。叶，治金疮止血，捣敷之。根，治破斫断筋，急取捣汁滴疮中，仍用渣封疮上，过半月断筋自续。又有一种旋花，性治大同，今少识者，故不录入。"}]},{"ID":"20240612192423-veu690c","Type":"NodeThematicBreak","Properties":{"id":"20240612192423-veu690c"}},{"ID":"20240612192442-qlobnen","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192442-qlobnen","updated":"20240612192446"},"Children":[{"Type":"NodeText","Data":"旋覆花《本草经解》"}]},{"ID":"20240612192442-zvshysr","Type":"NodeParagraph","Properties":{"id":"20240612192442-zvshysr","updated":"20240612192442"},"Children":[{"Type":"NodeText","Data":"气温．味咸．有小毒．主积气．胁下满．惊悸．除水．去五脏间寒热．补中下气．旋覆气温．禀天春和之木气．入足厥阴肝经．味咸有小毒．得地北方阴惨之水味．入足少阴肾经．气味降多于升．阴也．温能散积．咸能软坚．故主结气胁下满也．水气乘心则惊悸．咸温下水．所以并主惊悸也．去五脏间寒热者．五脏藏阴者也．痰蓄五脏．则寒不藏而寒热矣．咸温可以消痰．所以去寒热也．补中者．中为脾胃．水行痰消．则中宫脾胃受补也．下气者．咸性润下也．因有小毒．所以服之必烦也．"}]},{"ID":"20240612192442-6jhasjl","Type":"NodeParagraph","Properties":{"id":"20240612192442-6jhasjl","updated":"20240612192442"},"Children":[{"Type":"NodeText","Data":"【制方】"}]},{"ID":"20240612192442-z27dnan","Type":"NodeParagraph","Properties":{"id":"20240612192442-z27dnan","updated":"20240612192442"},"Children":[{"Type":"NodeText","Data":"旋覆同人参、半夏、代赭石、甘草、生姜、大枣．治伤寒汗下后．心下痞坚．噫气不除．"}]},{"ID":"20240612192424-39owc8n","Type":"NodeThematicBreak","Properties":{"id":"20240612192424-39owc8n"}},{"ID":"20240612192429-cmpnvvz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192429-cmpnvvz","updated":"20240612192434"},"Children":[{"Type":"NodeText","Data":"旋复花《本草从新》"}]},{"ID":"20240612192429-3jg9k1t","Type":"NodeParagraph","Properties":{"id":"20240612192429-3jg9k1t","updated":"20240612192429"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一名金沸草．泻、下气消痰．"}]},{"ID":"20240612192429-9bev003","Type":"NodeParagraph","Properties":{"id":"20240612192429-9bev003","updated":"20240612192429"},"Children":[{"Type":"NodeText","Data":"苦辛．能下气行水．咸能软坚．微温．能通血脉．入肺、大肠经．消痰结坚痞．唾如胶漆．"}]},{"ID":"20240612192429-5l48m1n","Type":"NodeParagraph","Properties":{"id":"20240612192429-5l48m1n","updated":"20240612192429"},"Children":[{"Type":"NodeText","Data":"噫气不除．（噫、于介切、俗作嗳、胸中气不畅、故嗳以通之、属不足、亦有挟痰挟火者、属有余、仲景治汗吐下后、痞硬噫气者、有代赭旋复汤．）大腹水肿．风气湿痹．走散之药．冷利大肠．虚人禁之．根治风湿．叶治疔疮肿毒．傅金疮．（止血．）类金钱菊．去皮蒂蕊壳．蒸用．入煎剂．须用绢包好．（有细毛、恐射肺令人嗽．）"}]},{"ID":"20240612192310-cai0axe","Type":"NodeThematicBreak","Properties":{"id":"20240612192310-cai0axe"}},{"ID":"20240612192416-rosay25","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192416-rosay25","updated":"20240612192422"},"Children":[{"Type":"NodeText","Data":"旋复花《神农本草经读》"}]},{"ID":"20240612192416-9kgtqwq","Type":"NodeParagraph","Properties":{"id":"20240612192416-9kgtqwq","updated":"20240612192416"},"Children":[{"Type":"NodeText","Data":"气味咸、温，有小毒。主结气，胁下满，惊悸，除水，去五脏间寒热，补中益气。"}]},{"ID":"20240612192416-qjatkoo","Type":"NodeParagraph","Properties":{"id":"20240612192416-qjatkoo","updated":"20240612192416"},"Children":[{"Type":"NodeText","Data":"陈修园曰∶旋复花气温，禀风气而主散；味咸，得水味润下而坚。味胜于气，故以味为主。唯其坚，故结气胁下满等症，皆能已之；唯其润下，故停水惊悸，及五脏郁滞而生寒热等症，皆能已之。借咸降之力，上者下之，水气行，痰气消，而中焦自然受补矣。（《本经》名金沸草。《尔雅》名盗庚。七、八月开花，如金钱菊。相传叶上露水滴地即生。）桔梗气味辛、微温，有小毒。主胸胁痛如刀刺，腹满肠鸣幽幽，惊恐悸气。"}]},{"ID":"20240612192416-qh60okz","Type":"NodeParagraph","Properties":{"id":"20240612192416-qh60okz","updated":"20240612192416"},"Children":[{"Type":"NodeText","Data":"张隐庵曰∶桔梗治少阳之胁满，上焦之胸痹，中焦之腹满，下焦之肠鸣。又惊则气上，恐则气下，悸则动中，是桔梗为气分之药，上中下皆可治也。张元素不参经义，谓桔梗乃舟楫之药，载诸药而不沉。今人熟念在口，终身不忘，以元素杜撰之言为是，则《本经》几可废矣！医门豪杰之士，能明神农之《本经》、轩岐之《灵》《素》、仲祖之《论》《略》，则千百方书，皆为糟粕。设未能也，必为方书所囿，而蒙蔽一生矣。可畏哉！"}]},{"ID":"20240612192310-dr2p082","Type":"NodeThematicBreak","Properties":{"id":"20240612192310-dr2p082"}},{"ID":"20240612192358-fmt2tul","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612192358-fmt2tul","updated":"20240612192407"},"Children":[{"Type":"NodeText","Data":"旋复花《证类本草》"}]},{"ID":"20240612192358-gd3ewdf","Type":"NodeParagraph","Properties":{"id":"20240612192358-gd3ewdf","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"味咸、甘，温、微冷利，有小毒。主结气胁下满，惊悸，除水，去五脏间寒热，补中下气，消胸上痰结，唾如胶漆，心胁痰水，膀胱留饮，风气湿痹，皮间死肉，目中眵（音嗤） （音蔑），利大肠，通血脉，益色泽。一名戴椹，一名金沸草，一名盛椹。其根主风湿。生平泽川谷。五月采花，日干，二十日成。"}]},{"ID":"20240612192358-yqw78tb","Type":"NodeParagraph","Properties":{"id":"20240612192358-yqw78tb","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶出近道下湿地，似菊花而大。又别有旋 根，出河南，来北国亦有，形似芎，唯合旋 膏用之，余无所入，非此旋复花根也。唐本注云∶旋复根在中品。陶云∶苗似姜，根似高良姜而细，此是山姜。证，不是旋复根。今复道从北国来，似芎 ，芎 与高良姜全仿佛尔。臣禹锡等谨按蜀本图经云∶旋复花，叶似水苏，花黄如菊。今所在皆有，六月至九月采花。药性论云∶旋复花，使，味甘，无毒。主肋胁气下，寒热水肿，主治膀胱宿水，去逐大腹，开胃，止呕逆不下食，尔雅云∶ ，盗庚。注∶旋复似菊，疏∶ ，一名盗庚也。"}]},{"ID":"20240612192358-2bb89ht","Type":"NodeParagraph","Properties":{"id":"20240612192358-2bb89ht","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"萧炳云∶旋（平声）复用花， （音福）旋（徐愿反）用根。日华子云∶无毒。明目，治头风，通血脉。叶止金疮血。"}]},{"ID":"20240612192358-9qhivdn","Type":"NodeParagraph","Properties":{"id":"20240612192358-9qhivdn","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"图经曰∶旋复花，生平泽川谷，今所在有之。二月以后生苗，多近水旁，大似红蓝而无刺，长一、二尺以来，叶如柳，茎细。六月开花如菊花，小铜钱大，深黄色。上党田野人呼为金钱花，七月、八月采花。曝干，二十日成。今近都人家园圃所莳金钱花，花、叶并如上说，极易繁盛，恐即经旋复也。张仲景治伤寒汗下后，心下痞坚，噫气不除，有七物旋复代赭汤。"}]},{"ID":"20240612192358-xrezmv0","Type":"NodeParagraph","Properties":{"id":"20240612192358-xrezmv0","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"杂治妇人，有三物旋复汤。胡洽有除痰饮在两胁胀满等旋复花丸，用之尤多。"}]},{"ID":"20240612192358-wt64haq","Type":"NodeParagraph","Properties":{"id":"20240612192358-wt64haq","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"雷公云∶凡采得后，去裹花蕊壳皮并蒂子，取花蕊蒸，从巳至午，晒干用。外台秘要∶救急续断筋法∶取旋复花草根净洗土捣，量疮大小敷之。日一、二易，以瘥为度。又方∶破斫筋断者。"}]},{"ID":"20240612192358-hw1jpai","Type":"NodeParagraph","Properties":{"id":"20240612192358-hw1jpai","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"以旋复根捣汁沥疮中，仍用滓封疮上，十五日，即断筋便续。此方出苏景中家獠奴用，效。"}]},{"ID":"20240612192358-koj3hog","Type":"NodeParagraph","Properties":{"id":"20240612192358-koj3hog","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"经验后方∶治中风及壅滞。以旋复花洗尘令净，捣末，炼蜜丸如桐子大。夜卧以茶汤下五丸至七丸、十丸。梅师方∶治金疮止血，捣旋复花苗敷疮上。"}]},{"ID":"20240612192358-gb22xst","Type":"NodeParagraph","Properties":{"id":"20240612192358-gb22xst","updated":"20240612192358"},"Children":[{"Type":"NodeText","Data":"衍义曰∶旋复花，叶如大菊，又如艾蒿。八、九月有花，大如梧桐子，花淡黄绿，繁茂，圆而覆下，亦一异也。其香过于菊，行痰水，去头目风。其味甘、苦、辛，亦走散之药也。其旋花，四月、五月有花，别一种，非此花也。第七卷已具之。"}]},{"ID":"20240612185502-am4sv8j","Type":"NodeThematicBreak","Properties":{"id":"20240612185502-am4sv8j"}},{"ID":"20240612192255-a2dmsxo","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240612192255-a2dmsxo","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"旋复花"}]},{"ID":"20240612192255-v9rzeqq","Type":"NodeParagraph","Properties":{"id":"20240612192255-v9rzeqq","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612192255-5nnsdny","Type":"NodeParagraph","Properties":{"id":"20240612192255-5nnsdny","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" Xuán Fù Huā"}]},{"ID":"20240612192255-ihhggrz","Type":"NodeParagraph","Properties":{"id":"20240612192255-ihhggrz","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612192255-mh0strb","Type":"NodeParagraph","Properties":{"id":"20240612192255-mh0strb","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 蕧、盗庚（《尔雅，），戴椹（《本经》），飞天蕊（侯宁极《药谱》），金钱花（《本草图经》），野油花（《小儿卫生总微论方》），滴滴金、夏菊（《纲目》），金钱菊（《花史》），艾菊、迭罗黄（《群芳谱》），满天星（《岭南采药录》），六月菊（《铁岭县志》），黄熟花（《南京民间药草》），水葵花、金盏花（《贵州民间方药集》），复花（《新疆药材》），小黄花（《河北药材》），猫耳朵花、驴耳朵花（《山东中药》），金沸花、伏花、全福花（《上海常用中草药》）。"}]},{"ID":"20240612192255-tbfuz1p","Type":"NodeParagraph","Properties":{"id":"20240612192255-tbfuz1p","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612192255-clc6hv7","Type":"NodeParagraph","Properties":{"id":"20240612192255-clc6hv7","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612192255-10zz7iu","Type":"NodeParagraph","Properties":{"id":"20240612192255-10zz7iu","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612192255-28n9tvq","Type":"NodeParagraph","Properties":{"id":"20240612192255-28n9tvq","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋复花、线叶旋复花"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大花旋复花"},{"Type":"NodeText","Data":"等的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头状花序"},{"Type":"NodeText","Data":"。夏、秋采摘即将开放的花序，晒干。"}]},{"ID":"20240612192255-xwnmgov","Type":"NodeParagraph","Properties":{"id":"20240612192255-xwnmgov","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612192255-nniwdy9","Type":"NodeParagraph","Properties":{"id":"20240612192255-nniwdy9","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 主产河南、江苏、河北，浙江、安徽和黑龙江、吉林、辽宁等地。"}]},{"ID":"20240612192255-9v5muor","Type":"NodeParagraph","Properties":{"id":"20240612192255-9v5muor","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612192255-x0augm9","Type":"NodeParagraph","Properties":{"id":"20240612192255-x0augm9","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" ①旋复花，又名：驴儿草、百叶草。"}]},{"ID":"20240612192255-06r2zvj","Type":"NodeParagraph","Properties":{"id":"20240612192255-06r2zvj","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～80厘米。茎具纵棱，绿色或微带紫红色。叶互生，椭圆形、椭圆状披针形或窄长椭圆形，长6～10厘米，宽1～2.5厘米，先端尖，基部稍狭，有时呈小耳、半抱茎，全缘或具细锯齿，上面绿色，疏被糙毛，下面淡绿色，密被糙伏毛。头状花序少数或多数，顶生，呈伞房状排列，直径3～4厘米；花序梗被白毛：近花序处通常有1披针形的苞片，被柔毛；总苞半圆形，长8～10毫米，直径1～1.8厘米，总苞片数层，外层披针形，内层线状披针形或线形，干膜质，外面被毛或仅具缘毛；花托微凸；舌状花1层，黄色，雌性，花冠先端3浅裂，基部两侧稍连合呈管状，雌蕊1，子房下位，具棱，被白色短硬毛，花柱线形，柱头2裂；管状花两性，位于花序的中央。花冠先端5齿裂，裂片卵状三角形，雄蕊5，聚药，花丝分离而短，雌蕊1，花柱线形，柱头2裂。瘦果长椭圆形，被白色硬毛，冠毛白色。花期7～10月。果期8～11月。"}]},{"ID":"20240612192255-ag03buz","Type":"NodeParagraph","Properties":{"id":"20240612192255-ag03buz","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"生于山坡、路旁、田边或水旁湿地。分布东北、华北、西北及华东等地。"}]},{"ID":"20240612192255-ndv3wcq","Type":"NodeParagraph","Properties":{"id":"20240612192255-ndv3wcq","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②线叶旋复花"}]},{"ID":"20240612192255-waw2v6v","Type":"NodeParagraph","Properties":{"id":"20240612192255-waw2v6v","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"多年生草本，高30～60厘米，全体近无毛或被疏柔毛。叶互生，线状披针形残线形，长6～12厘米，宽6～12毫米，先端尖，基部稍抱茎，边缘反卷，下面淡绿色，被疏柔毛。头状花序顶生，分枝多，呈伞房状排列，花序直径1.5～2厘米；苞片披针形；总苞半圆形，总苞片3层，外层披针形，内面2层线状披针形或线形，光滑或微被缘毛；舌状花1层，黄色，花冠先端3裂，下部连合成管状，雌蕊1；管状花先端5齿裂，雄蕊5，雌蕊1。瘦果椭圆形，顶端践形，具棱，被白色疏硬毛，冠毛白色。花期6～9月。果期7～10月。"}]},{"ID":"20240612192255-lcdn4bp","Type":"NodeParagraph","Properties":{"id":"20240612192255-lcdn4bp","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"生长于山坡、路旁或田边。分布东北、华北、华东等地。"}]},{"ID":"20240612192255-eyyf4w5","Type":"NodeParagraph","Properties":{"id":"20240612192255-eyyf4w5","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"③大花旋复花，又名：毛旋复花。"}]},{"ID":"20240612192255-8ysiotx","Type":"NodeParagraph","Properties":{"id":"20240612192255-8ysiotx","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"多年生草本，高20～60厘米，全体密被细毛及白色绵毛。叶互生，叶片长椭圆形或卵状披针形，长4～10厘米。宽1.5～2.5厘米，先端渐尖，基部心形，抱茎，全缘或具微锯齿，下面密被糙伏毛。头状花序少数，顶生，呈伞房状排列，花序直径3～5厘米：花序梗密被白色绵毛或细毛；苞片披针形，被毛：总苞半圆形，直径13～22毫米，总苞片4层，外层线状披针形，内层线形，外面密被白色细毛或绵毛；舌状花1层，花冠先端3齿裂，基部连合成管状，雌蕊1：管状花先端5裂，裂片三角状卵形，雄蕊5，雌蕊1。瘦果长方椭圆形，有棱，被白色硬毛，冠毛白色。花期7～10月。果期8～11月。"}]},{"ID":"20240612192255-isdzqbu","Type":"NodeParagraph","Properties":{"id":"20240612192255-isdzqbu","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"生长于溪沟旁或山野间。分布东北、华北及新疆、青海等地。"}]},{"ID":"20240612192255-cd20nqp","Type":"NodeParagraph","Properties":{"id":"20240612192255-cd20nqp","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"以上三种植物的根（旋复花根），全草（金沸草）亦供药用，各详专条。"}]},{"ID":"20240612192255-08x5hej","Type":"NodeParagraph","Properties":{"id":"20240612192255-08x5hej","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612192255-p71m3ib","Type":"NodeParagraph","Properties":{"id":"20240612192255-p71m3ib","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 干燥头状花序呈扁球形，有时散落，直径8～15毫米（线叶旋复花较小，4～10毫米）。底部有4层（线叶旋复花3层）浅灰绿色、膜质的总苞片，有时残留花梗。外缘1层舌状花，黄色，长约1厘米，先端3齿裂，多卷曲；中央管状花密集，花冠5齿裂，子房顶端有多数白色冠毛，长约5毫米（线叶旋复花长约3毫米），质柔软，手捻易散。气微弱，味微苦咸。以朵大、金黄色、有白绒毛，无枝梗者为佳。"}]},{"ID":"20240612192255-4aqs62e","Type":"NodeParagraph","Properties":{"id":"20240612192255-4aqs62e","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612192255-1phdc8b","Type":"NodeParagraph","Properties":{"id":"20240612192255-1phdc8b","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 大花旋复花开花时期的地上部分含倍半萜内酯化合物大花旋复花素和旋复花素。花含槲皮素、异槲皮素、咖啡酸、绿原酸、菊糖及蒲公英甾醇等多种甾醇。"}]},{"ID":"20240612192255-rcm3zez","Type":"NodeParagraph","Properties":{"id":"20240612192255-rcm3zez","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612192255-xqez2ed","Type":"NodeParagraph","Properties":{"id":"20240612192255-xqez2ed","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 大花旋复花的根和地上部分之脂溶性及醚溶性部分有抗菌作用，无显着利尿作用。"}]},{"ID":"20240612192255-yrxi5k6","Type":"NodeParagraph","Properties":{"id":"20240612192255-yrxi5k6","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"绿原酸为咖啡酸与奎宁酸的缩合物，遇铁呈蓝色，与鞣质相似，以前曾名\"咖啡鞣酸\"，但与鞣质不同，不沉淀蛋白质，故无收敛作用。咖啡酸与绿原酸有较广泛的抑菌作用，但在体内能被蛋白质灭活。绿原酸与咖啡因相似，口服或腹腔注射，可提高大鼠的中枢兴奋性。绿原酸与咖啡酸口服，可增加人胃中盐酸的分泌量，并能使脉搏变慢，而奎宁酸则不能。绿原酸能显着增加大鼠、小鼠小肠的蠕动，绿原酸、咖啡酸、奎宁酸皆可增强大鼠子宫的张力，此作用可被罂粟碱所取消，而阿托品则不能影响之。咖啡酸、绿原酸还可增进大鼠的胆汁分泌。在离体兔回肠标本上，绿原酸能增强肾上腺素的作用；但对肾上腺素的升高血糖作用、预防大鼠蛋清性足踝浮肿等皆无影响。绿原酸对人有致敏作用，吸入含有绿原酸的植物的尘埃后（如在咖啡厂中），可发生气喘、皮炎等，但食入后可经小肠分泌物的作用，变为无致敏性物质，故试验致敏原时，宜用皮内法而不用口服法。咖啡酸尚有灭活硫胺（维生素B1）的作用。绿原酸毒性很小，幼大鼠口服半效致死量大于1克/公斤，腹腔注射大于0.25克/公斤。"}]},{"ID":"20240612192255-r1ydspg","Type":"NodeParagraph","Properties":{"id":"20240612192255-r1ydspg","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"同属植物Inula royleana含生物碱，能抑制呼吸、降低血压、松弛平滑肌，并有箭毒样作用，但无抗菌作用"}]},{"ID":"20240612192255-4u2mg0a","Type":"NodeParagraph","Properties":{"id":"20240612192255-4u2mg0a","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612192255-nmtkja6","Type":"NodeParagraph","Properties":{"id":"20240612192255-nmtkja6","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 旋复花：拣净杂质，除去梗叶，筛去泥土。蜜炙旋复花：取净旋复花，加炼熟蜂蜜与开水少许，拌匀，稍焖，用文火炒至黄色、不粘手为度，取出凉透。（每旋复花100斤，用炼熟蜂蜜25斤）"}]},{"ID":"20240612192255-bbgcp78","Type":"NodeParagraph","Properties":{"id":"20240612192255-bbgcp78","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612192255-kzagert","Type":"NodeParagraph","Properties":{"id":"20240612192255-kzagert","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 入肺、肝、胃经。"}]},{"ID":"20240612192255-4gm69wp","Type":"NodeParagraph","Properties":{"id":"20240612192255-4gm69wp","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"①《纲目》：\"手太阴、阳明。\""}]},{"ID":"20240612192255-s50heqp","Type":"NodeParagraph","Properties":{"id":"20240612192255-s50heqp","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②《雷公炮制药性解》：\"入肺、肝、大肠、膀胱四经。\""}]},{"ID":"20240612192255-lajodlz","Type":"NodeParagraph","Properties":{"id":"20240612192255-lajodlz","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"③《本草新编》：\"入心、肝，大、小肠。\""}]},{"ID":"20240612192255-ji5ml3e","Type":"NodeParagraph","Properties":{"id":"20240612192255-ji5ml3e","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612192255-6qg17tq","Type":"NodeParagraph","Properties":{"id":"20240612192255-6qg17tq","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 咸，温。"}]},{"ID":"20240612192255-bz4okgv","Type":"NodeParagraph","Properties":{"id":"20240612192255-bz4okgv","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味咸，温。\""}]},{"ID":"20240612192255-in5zbks","Type":"NodeParagraph","Properties":{"id":"20240612192255-in5zbks","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②《药性论》：\"味甘，无毒。\""}]},{"ID":"20240612192255-pkpbqkt","Type":"NodeParagraph","Properties":{"id":"20240612192255-pkpbqkt","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"③《本草衍义》：\"味甘苦辛。\""}]},{"ID":"20240612192255-vb1avha","Type":"NodeParagraph","Properties":{"id":"20240612192255-vb1avha","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240612192255-kqzaohl","Type":"NodeParagraph","Properties":{"id":"20240612192255-kqzaohl","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义补遗》：\"病人涉虚者不宜多服，利大肠，戒之。\""}]},{"ID":"20240612192255-sqwcjq3","Type":"NodeParagraph","Properties":{"id":"20240612192255-sqwcjq3","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②《本经逢原》：\"阴虚劳嗽，风热燥咳，不可误用。\""}]},{"ID":"20240612192255-ccyzhr1","Type":"NodeParagraph","Properties":{"id":"20240612192255-ccyzhr1","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612192255-3iyvq8f","Type":"NodeParagraph","Properties":{"id":"20240612192255-3iyvq8f","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 消痰，下气，软坚，行水。治胸中痰结，胁下胀满，咳喘，呃逆，唾如胶漆，心下痞鞕，噫气不除，大腹水肿。"}]},{"ID":"20240612192255-jb3iscj","Type":"NodeParagraph","Properties":{"id":"20240612192255-jb3iscj","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主结气，胁下满，惊悸。除水，去五脏间寒热，补中，下气。\""}]},{"ID":"20240612192255-hzh4rou","Type":"NodeParagraph","Properties":{"id":"20240612192255-hzh4rou","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"消胸上痰结，唾如胶漆，心胁痰水，膀胱留饮，风气湿痹，皮间死肉，目中眵蔑，利大肠，通血脉，益色泽。\""}]},{"ID":"20240612192255-xkrob2b","Type":"NodeParagraph","Properties":{"id":"20240612192255-xkrob2b","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主肋胁气，下寒热水肿，主治膀胱宿水，去逐大腹，开胃，止呕逆不下食。\""}]},{"ID":"20240612192255-nabor0p","Type":"NodeParagraph","Properties":{"id":"20240612192255-nabor0p","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"④《日华子本草》，：\"明目，治头风，通血脉。\""}]},{"ID":"20240612192255-lpmcqk9","Type":"NodeParagraph","Properties":{"id":"20240612192255-lpmcqk9","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑤《汤液本草》：\"发汗吐下后，心下痞，噫气不除者宜此。\""}]},{"ID":"20240612192255-ghtg1vp","Type":"NodeParagraph","Properties":{"id":"20240612192255-ghtg1vp","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑥《滇南本草》：\"祛头目诸风寒邪，止太阳、阳明头疼，行阳明乳汁不通。（治）乳岩、乳痈、红肿疼痛、暴赤火眼、目疾疼痛、祛风明目、隐涩羞明怕日，伤风寒热咳嗽、老痰如胶，走经络，止面寒腹疼，利小便，治单腹胀，风火牙根肿痛。\""}]},{"ID":"20240612192255-pb4hx1a","Type":"NodeParagraph","Properties":{"id":"20240612192255-pb4hx1a","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑦《医学入门》：\"逐水，消痰，止呕噎。\""}]},{"ID":"20240612192255-oy45246","Type":"NodeParagraph","Properties":{"id":"20240612192255-oy45246","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑧《南京民间药草》：\"花和苗，祛湿、拔毒、消肿，煎水洗患处。\""}]},{"ID":"20240612192255-q0d3uqq","Type":"NodeParagraph","Properties":{"id":"20240612192255-q0d3uqq","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612192255-q640w1z","Type":"NodeParagraph","Properties":{"id":"20240612192255-q640w1z","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤（包煎或滤去毛），1.5～3钱；或入丸、散。外用：煎水洗，研末干撒或调敷。"}]},{"ID":"20240612192255-sj1g30b","Type":"NodeParagraph","Properties":{"id":"20240612192255-sj1g30b","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612192255-8fsfsr6","Type":"NodeParagraph","Properties":{"id":"20240612192255-8fsfsr6","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" ①治伤寒中脘有痰，令人壮热，项筋紧急，时发寒热，皆类伤风，但不头痛为异：前胡三两，荆芥四两，半夏一两（洗，姜汁浸），赤芍药二两，细辛一两，甘草一两（炙），旋复花三两。上捣罗为末，每服二钱，水一盏，生姜五片，枣子一枚，同煎至六分，去滓，热服，未知再服。（《类证活人书》金沸草散）"}]},{"ID":"20240612192255-x0ey5tp","Type":"NodeParagraph","Properties":{"id":"20240612192255-x0ey5tp","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②治积年上气：旋复花（去梗，焙）一两，皂荚（炙，去皮、子）一两一分，大黄（锉、炒）一两半。上三味，捣罗为末，炼蜜丸如梧桐子大。每服十丸至十五丸，温汤下，日三服。（《圣济总录》旋复花丸）"}]},{"ID":"20240612192255-59hrkb1","Type":"NodeParagraph","Properties":{"id":"20240612192255-59hrkb1","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"③治肝着，亦治妇人半产漏下：旋复花三两，葱十四茎。新绛少许。以水三升，煮取一升，顿服之。（《金匮要略》旋复花汤）"}]},{"ID":"20240612192255-l25wvrb","Type":"NodeParagraph","Properties":{"id":"20240612192255-l25wvrb","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"④治痰饮在胸膈呕不止，心下痞粳者：旋复花、半夏、茯苓、青皮。水煎服。（《产科发蒙》旋复半夏汤）"}]},{"ID":"20240612192255-79358nu","Type":"NodeParagraph","Properties":{"id":"20240612192255-79358nu","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑤治风痰呕逆，饮食不下，头目昏闷：旋复花、枇杷叶、川芎、细辛、赤茯苓各一钱，前胡一钱五分。姜、枣水煎服。（《妇人良方》旋复花汤）"}]},{"ID":"20240612192255-ojec9yc","Type":"NodeParagraph","Properties":{"id":"20240612192255-ojec9yc","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑥治伤寒发汗，若吐若下，解后，心下痞鞕，噫气不除者：旋复花三两，人参二两，生姜五两，代赭石一两，甘草三两（炙），半夏半升（洗），大枣十二枚（擘），上七味，以水-斗，煮取六升，去滓，再煎取三升，温服一升，日三服。（《伤寒论》旋复代赭汤）"}]},{"ID":"20240612192255-fe5hcsu","Type":"NodeParagraph","Properties":{"id":"20240612192255-fe5hcsu","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑦治风湿痰饮上攻，头目眩胀眵蔑：旋复花、天麻、甘菊花各等分。为末，每晚服二钱，白汤下。（《本草汇言》）"}]},{"ID":"20240612192255-bx0bh04","Type":"NodeParagraph","Properties":{"id":"20240612192255-bx0bh04","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑧治小便不行，因痰饮留闭者：旋复花一握，捣汁，和生白酒服。（《本草汇言》）"}]},{"ID":"20240612192255-xtv744y","Type":"NodeParagraph","Properties":{"id":"20240612192255-xtv744y","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑨治单腹胀：旋复、鲤鱼。将鱼肠去净，药入鱼肚内，煎服。小便利，肿胀即消。"}]},{"ID":"20240612192255-jcz68uh","Type":"NodeParagraph","Properties":{"id":"20240612192255-jcz68uh","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑩治风火牙痛：旋复花为末，搽牙根上，良久，去其痰涎，疼止。"}]},{"ID":"20240612192255-13oilgs","Type":"NodeParagraph","Properties":{"id":"20240612192255-13oilgs","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑾治乳岩、乳痈：旋复花二钱，蒲公英一钱，甘草节八分，白芷一钱，青皮一钱。水酒为引，水煎服。（⑨方以下出《滇南本草》）"}]},{"ID":"20240612192255-rceg0za","Type":"NodeParagraph","Properties":{"id":"20240612192255-rceg0za","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑿治月蚀耳疮：旋复花烧研。羊脂和涂之。（《濒湖集简方》）"}]},{"ID":"20240612192255-au17qrk","Type":"NodeParagraph","Properties":{"id":"20240612192255-au17qrk","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612192255-aad6t2z","Type":"NodeParagraph","Properties":{"id":"20240612192255-aad6t2z","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" ①《本草衍义》：\"旋复花，行痰水，去头目风，亦走散之药也。\""}]},{"ID":"20240612192255-o386yk4","Type":"NodeParagraph","Properties":{"id":"20240612192255-o386yk4","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"②《纲目》：\"旋复所治诸病，其功只在行水、下气、通血脉尔。\""}]},{"ID":"20240612192255-hvwnaki","Type":"NodeParagraph","Properties":{"id":"20240612192255-hvwnaki","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"③《本草发明》：\"旋复花，消痰导饮、散结利气之味。其云除惊悸者，以去心下水饮，心神自定也。又治目中翳蔑头风，毕竟痰饮结滞而生风热，此能散之，头目自清也。\""}]},{"ID":"20240612192255-u99ej5z","Type":"NodeParagraph","Properties":{"id":"20240612192255-u99ej5z","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"④《本草经疏》：\"旋复花，其味首系之以咸，润下作咸，咸能软坚；《别录》加甘，甘能缓中；微温，温能通行，故主结气，胁下满；心脾伏饮则病惊悸，饮消则复常矣。除水，去五脏间寒热，及消胸上痰结，唾如胶漆，心胁痰水，膀胱留饮，风气湿痹，皮间死肌，目中眵蔑，利大肠者，皆软坚、冷利、润下、消痰饮除水之功也。其曰补中下气者，以甘能缓中，咸能润下故也。通血脉、益色泽者，盖指饮消则脾健，健则能运行，脾裹血又统血故也。\""}]},{"ID":"20240612192255-4dc84xm","Type":"NodeParagraph","Properties":{"id":"20240612192255-4dc84xm","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑤《本草汇言》：\"旋复花，消痰逐水，利气下行之药也。主心肺结气，胁下虚满，胸中结痰，痞坚噫气，或心脾伏饮，膀胱留饮，宿水等症。大抵此剂微咸以软坚散痞鞕。性利以下气行痰水，实消伐之药也。《本草》有定惊悸、补中气之说，窃思痰闭心包脾络之间，往往令人病惊，旋复破痰逐饮，痰饮去则胞络清净而无碍，五志自宁，惊悸安矣。又饮消则脾健，脾健则能运行饮食，中气自受其益而补养矣。\"又：\"童玉峰云，若热痰，则多烦热；湿痰，则多倦怠软弱；风痰，则多瘫痪奇症；惊痰，则多心痛癫疾；冷痰，则多骨痹痿疾；饮痰，则多胁痛臂痛；食积痰，则多癖块痞满。其为病状，种种变见，用旋复花，虚实寒热，随证加入，无不应手获效。\""}]},{"ID":"20240612192255-do6ts0t","Type":"NodeParagraph","Properties":{"id":"20240612192255-do6ts0t","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑥《本草正》：\"旋复花，开结气，降痰涎，通水道，消肿满，凡气壅湿热者宜之。但其性在走散，故凡见大肠不实及气虚阳衰之人，皆所忌用。\""}]},{"ID":"20240612192255-byhq8i5","Type":"NodeParagraph","Properties":{"id":"20240612192255-byhq8i5","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"⑦《本草正义》：\"旋复花，其主治当以泄散风寒，疏通脉络为专主。《别录》治风气湿痹，皮间死肉，通血脉，宗奭去头目风，皆其轻疏泄散之功也。以治风寒喘嗽，寒饮渍肺，最是正法。或谓旋复花降气，寒邪在肺者，不宜早用，则止知疏泄之力足以下降，而不知其飞扬之性本能上升。且《本经》明谓其温，寇宗奭又以为辛，则疏散寒邪，正其专职。若其开结泄水，下气降逆等治，则类皆沉重下达之义，颇嫌其与轻扬之本性，不甚符合。按《本经》，旋复花一名金沸草，疑古人本有用其茎叶，而未必皆用其花者。考草木花叶之功用，不同者甚多，或升或降，各有取义，亦其禀赋使然，不容混合。且茎则质重，花则质轻，亦物理自然之性，况旋复花之尤为轻而上扬者乎。乃今人恒用其花，而并不用茎叶，竟以重坠之功，责之轻扬之质，恐亦非古人辨别物性之真旨也。且其花专主温散，疏泄之力亦猛，宜于寒饮，而不宜于热痰，石顽已谓阴虚劳嗽，风热燥咳，误用之，嗽必愈甚，是亦以其轻杨，升泄太过.正与降气之理相反。惟其轻灵之性，流动不滞，自能流通气化而宣窒塞，固非专以升散见长。若但以逐水导湿为治，似不如兼用其茎叶较为近理，《别录》称其根专主风湿，其意可晓然也。\""}]},{"ID":"20240612192255-vje8lpk","Type":"NodeParagraph","Properties":{"id":"20240612192255-vje8lpk","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"备注"}]},{"ID":"20240612192255-wfg3obj","Type":"NodeParagraph","Properties":{"id":"20240612192255-wfg3obj","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 除上述品种外，在部分地区尚有将旋复花属其它种植物的头状花序作旋复花用，如广东、广西、湖南、江西等地用的是齿叶旋复花，其干燥花序略呈球形，直径7～12毫米。总苞灰绿色，被白色茸毛。舌状花1层，黄色或淡棕色，有时脱落；管状花密集中央，子房上的冠毛多数退化，留下鳞片状残迹，质硬。云南、贵州有些地区用的是水朝阳花（参见\"水朝阳\"条），其干燥花序的直径8～14毫米。子房上的冠毛15～20条，长约3毫米。湖北、贵州有些地区用的是湖北朝阳花，其干燥花序略呈半球形，不易散落，直径1～2厘米。总苞黄绿色或绿色，被白色短毛。舌状花1层，细长，长可达2厘米，黄色或淡棕色；中央为管状花，冠毛5～10条，长约2毫米。"}]},{"ID":"20240612192255-uptzeb5","Type":"NodeParagraph","Properties":{"id":"20240612192255-uptzeb5","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612192255-f55ba02","Type":"NodeParagraph","Properties":{"id":"20240612192255-f55ba02","updated":"20240612192255"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612185502-3pr1xs6","Type":"NodeThematicBreak","Properties":{"id":"20240612185502-3pr1xs6"}},{"ID":"20240612185503-mdsrhfw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612185503-mdsrhfw","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"《中国药典》：旋覆花"}]},{"ID":"20240612185503-901v5c1","Type":"NodeParagraph","Properties":{"id":"20240612185503-901v5c1","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612185503-5fpvpx3","Type":"NodeParagraph","Properties":{"id":"20240612185503-5fpvpx3","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" Xuán Fù Huā"}]},{"ID":"20240612185503-ilg4354","Type":"NodeParagraph","Properties":{"id":"20240612185503-ilg4354","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612185503-l7zjxu6","Type":"NodeParagraph","Properties":{"id":"20240612185503-l7zjxu6","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 金沸草[全草]、六月菊、鼓子花、滴滴金、小黄花子、金钱花、驴儿菜"}]},{"ID":"20240612185503-p94ihrv","Type":"NodeParagraph","Properties":{"id":"20240612185503-p94ihrv","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612185503-d6i2yrz","Type":"NodeParagraph","Properties":{"id":"20240612185503-d6i2yrz","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" FLOS INULAE"}]},{"ID":"20240612185503-e9agfeh","Type":"NodeParagraph","Properties":{"id":"20240612185503-e9agfeh","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612185503-zl1atsc","Type":"NodeParagraph","Properties":{"id":"20240612185503-zl1atsc","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 本品为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋覆花"},{"Type":"NodeText","Data":"Inula japonica Thunb.或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"欧亚旋覆花"},{"Type":"NodeText","Data":"Inula britannica L.的干燥"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头状花序"},{"Type":"NodeText","Data":"。夏、秋二季花开放时采收，除去杂质，阴干或晒干。"}]},{"ID":"20240612185503-rxrotjc","Type":"NodeParagraph","Properties":{"id":"20240612185503-rxrotjc","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612185503-eo48gxw","Type":"NodeParagraph","Properties":{"id":"20240612185503-eo48gxw","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 本品呈扁球形或类球形，直径1～2cm。总苞由多数苞片组成，呈覆瓦状排列，苞片披针形或条形，灰黄色，长4～11mm；总苞基部有时残留花梗，苞片及花梗表面被白色茸毛，舌状花1列，黄色，长约1cm,多卷曲，常脱落，先端3齿裂；管状花多数，棕黄色，长约5mm,先端5齿裂；子房顶端有多数白色冠毛，长5～6mm。有的可见椭圆形小瘦果。体轻，易散碎。气微，味微苦。"}]},{"ID":"20240612185503-h1xyz11","Type":"NodeParagraph","Properties":{"id":"20240612185503-h1xyz11","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"贮藏"}]},{"ID":"20240612185503-boa4zqb","Type":"NodeParagraph","Properties":{"id":"20240612185503-boa4zqb","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 置干燥处，防潮。"}]},{"ID":"20240612185503-3hzgv88","Type":"NodeParagraph","Properties":{"id":"20240612185503-3hzgv88","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612185503-jx6ag5i","Type":"NodeParagraph","Properties":{"id":"20240612185503-jx6ag5i","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋覆花"},{"Type":"NodeText","Data":"：除去梗、叶及杂质。"}]},{"ID":"20240612185503-n1qjju1","Type":"NodeParagraph","Properties":{"id":"20240612185503-n1qjju1","updated":"20240612185503"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蜜旋覆花"},{"Type":"NodeText","Data":"：取净旋覆花，照蜜炙法（附录Ⅱ D）炒至不粘手。"}]},{"ID":"20240612185503-7nvpwg1","Type":"NodeParagraph","Properties":{"id":"20240612185503-7nvpwg1","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"鉴别"}]},{"ID":"20240612185503-opyso4h","Type":"NodeParagraph","Properties":{"id":"20240612185503-opyso4h","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" （1）本品表面观：苞片非腺毛1～8细胞，多细胞者基部膨大，顶端细胞特长；内层苞片另有2～3细胞并生的非腺毛。冠毛为多列性非腺毛，边缘细胞稍向外突出。子房表皮细胞含草酸钙柱晶，长约至48μm,直径2～5μm ；子房非腺毛2 列性，1列为单细胞，另列通常2 细胞，长90～220μm。苞片、花冠腺毛棒槌状，头部多细胞，多排成2 列，围有角质囊，柄多细胞，2 列。花粉粒类球形，直径22～33μm,外壁有刺，长约3μm，具3 个萌发孔。"}]},{"ID":"20240612185503-g27ep10","Type":"NodeParagraph","Properties":{"id":"20240612185503-g27ep10","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"（2）取本品粉末2g，置具塞锥形瓶中，加石油醚（60～90℃）30ml，密塞，冷浸1小时，加热回流30分钟，放冷，滤过，滤液浓缩至近干，残渣加石油醚（60～90℃）2ml使溶解，作为供试品溶液。另取旋覆花对照药材2g，同法制成对照药材溶液。照薄层色谱法（附录Ⅵ B）试验，吸取上述两种溶液各5μl，分别点于同一硅胶G薄层板上，以石油醚（60～90℃）-醋酸乙酯（5：1）为展开剂，展开，取出，晾干,喷以5％香草醛硫酸溶液，加热至斑点显色清晰。供试品色谱中，在与对照药材色谱相应的位置上，显相同颜色的主斑点。"}]},{"ID":"20240612185503-as79qfj","Type":"NodeParagraph","Properties":{"id":"20240612185503-as79qfj","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612185503-jm7n3eo","Type":"NodeParagraph","Properties":{"id":"20240612185503-jm7n3eo","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 归肺、脾、胃、大肠经。"}]},{"ID":"20240612185503-05anppc","Type":"NodeParagraph","Properties":{"id":"20240612185503-05anppc","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612185503-cznh1in","Type":"NodeParagraph","Properties":{"id":"20240612185503-cznh1in","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 苦，辛、咸，微温。"}]},{"ID":"20240612185503-spjhuy2","Type":"NodeParagraph","Properties":{"id":"20240612185503-spjhuy2","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612185503-qehtb1g","Type":"NodeParagraph","Properties":{"id":"20240612185503-qehtb1g","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 降气，消痰，行水，止呕。用于风寒咳嗽，痰饮蓄结，胸膈痞满,喘咳痰多，呕吐噫气，心下痞硬。"}]},{"ID":"20240612185503-u5v9k3f","Type":"NodeParagraph","Properties":{"id":"20240612185503-u5v9k3f","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612185503-lxh3iya","Type":"NodeParagraph","Properties":{"id":"20240612185503-lxh3iya","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 3～9g,包煎。"}]},{"ID":"20240612185503-ynk8xga","Type":"NodeParagraph","Properties":{"id":"20240612185503-ynk8xga","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612185503-8g7fpj7","Type":"NodeParagraph","Properties":{"id":"20240612185503-8g7fpj7","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 《中国药典》"}]},{"ID":"20240612185503-3ran99b","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612185503-3ran99b","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：旋覆花"}]},{"ID":"20240612185503-9hykjeh","Type":"NodeParagraph","Properties":{"id":"20240612185503-9hykjeh","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612185503-idjhayz","Type":"NodeParagraph","Properties":{"id":"20240612185503-idjhayz","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" Xuán Fù Huā"}]},{"ID":"20240612185503-jibe68t","Type":"NodeParagraph","Properties":{"id":"20240612185503-jibe68t","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612185503-jf1a9pa","Type":"NodeParagraph","Properties":{"id":"20240612185503-jf1a9pa","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 金福花、金佛花、小黄花子"}]},{"ID":"20240612185503-abnmo9k","Type":"NodeParagraph","Properties":{"id":"20240612185503-abnmo9k","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612185503-q6lguxa","Type":"NodeParagraph","Properties":{"id":"20240612185503-q6lguxa","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" Inula Flower"}]},{"ID":"20240612185503-8inq191","Type":"NodeParagraph","Properties":{"id":"20240612185503-8inq191","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612185503-uc4dklt","Type":"NodeParagraph","Properties":{"id":"20240612185503-uc4dklt","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 为菊科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋覆花"},{"Type":"NodeText","Data":"Inula japonica Thunb.的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头状花序"},{"Type":"NodeText","Data":"。夏、秋季花开放时采收，除去杂质，阴干或晒干。"}]},{"ID":"20240612185503-m865sx8","Type":"NodeParagraph","Properties":{"id":"20240612185503-m865sx8","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612185503-zo99ej3","Type":"NodeParagraph","Properties":{"id":"20240612185503-zo99ej3","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 生于山坡、沟边、路旁湿地。分布于东北、华北、西北及浙江、江苏、四川、广东。"}]},{"ID":"20240612185503-bv0lykn","Type":"NodeParagraph","Properties":{"id":"20240612185503-bv0lykn","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612185503-20pvzt0","Type":"NodeParagraph","Properties":{"id":"20240612185503-20pvzt0","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 多年生直立草本，茎高20～60cm，不分枝，有平伏毛。基生叶及下部叶较小，中部叶披针形、长椭圆状披针形或长圆形，长5～10cm ,宽1～3cm，先端锐尖，基部急狭，无柄或半抱茎，全缘，两面有疏毛。头状花序直径2.5～3cm，多个排成伞房花序，总苞半球形，绿黄色；舌状花1层，黄色，管状花多数，密集。花期7～10月，果期8～11月。"}]},{"ID":"20240612185503-pze9723","Type":"NodeParagraph","Properties":{"id":"20240612185503-pze9723","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612185503-d3pkf09","Type":"NodeParagraph","Properties":{"id":"20240612185503-d3pkf09","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 含蒲公英甾醇 （taraxasterol, inusterol A）、槲皮素、异槲皮素、氯原酸、咖啡酸。"}]},{"ID":"20240612185503-3kxmlgt","Type":"NodeParagraph","Properties":{"id":"20240612185503-3kxmlgt","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612185503-r2ivj4e","Type":"NodeParagraph","Properties":{"id":"20240612185503-r2ivj4e","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 降气，消痰，行水，止呕。"}]},{"ID":"20240612185503-pfbuzq1","Type":"NodeParagraph","Properties":{"id":"20240612185503-pfbuzq1","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612185503-i2cdc6w","Type":"NodeParagraph","Properties":{"id":"20240612185503-i2cdc6w","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612185503-5c83xs4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612185503-5c83xs4","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"《中华本草》：旋覆花"}]},{"ID":"20240612185503-kbkbu3v","Type":"NodeParagraph","Properties":{"id":"20240612185503-kbkbu3v","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612185503-3ah2wee","Type":"NodeParagraph","Properties":{"id":"20240612185503-3ah2wee","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" Xuán Fù Huā"}]},{"ID":"20240612185503-5vme9jh","Type":"NodeParagraph","Properties":{"id":"20240612185503-5vme9jh","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612185503-pal60ts","Type":"NodeParagraph","Properties":{"id":"20240612185503-pal60ts","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 蕧、盗庚、盛椹、戴椹、飞天蕊、金钱花、野油花、滴滴金、夏菊、金钱菊、艾菊、迭罗黄、满天星、六月菊、黄熟花、水葵花、金盏花、复花、小黄花、猫耳朵花、驴耳朵花、金沸花、伏花、全福花"}]},{"ID":"20240612185503-9duyphw","Type":"NodeParagraph","Properties":{"id":"20240612185503-9duyphw","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612185503-6uis7nf","Type":"NodeParagraph","Properties":{"id":"20240612185503-6uis7nf","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" Inula Flower, flower of Japanese Inula, flower of Linearleaf Inula, flower of British Inula"}]},{"ID":"20240612185503-gq41mmc","Type":"NodeParagraph","Properties":{"id":"20240612185503-gq41mmc","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612185503-p28f8ce","Type":"NodeParagraph","Properties":{"id":"20240612185503-p28f8ce","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》"}]},{"ID":"20240612185503-t2rd4ql","Type":"NodeParagraph","Properties":{"id":"20240612185503-t2rd4ql","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612185503-zl0kmt2","Type":"NodeParagraph","Properties":{"id":"20240612185503-zl0kmt2","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 药材基源：为区科植物旋覆花或欧亚旋覆花的花序。"}]},{"ID":"20240612185503-zlsnzxe","Type":"NodeParagraph","Properties":{"id":"20240612185503-zlsnzxe","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：1.Inula japonica Thunb.[I.britanica L.var.japonica(Thunb.)Franch.et Sav.;I.britanica L.var.chinensis Regel]2.Inula britanica L."}]},{"ID":"20240612185503-wc6tnuw","Type":"NodeParagraph","Properties":{"id":"20240612185503-wc6tnuw","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7-10月分批采收花序，晒干。夏、秋采摘即将开放的花序，晒干。"}]},{"ID":"20240612185503-ksm1wb6","Type":"NodeParagraph","Properties":{"id":"20240612185503-ksm1wb6","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612185503-dy1r34e","Type":"NodeParagraph","Properties":{"id":"20240612185503-dy1r34e","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 生态环境：1.生于海拔150-2400m的山坡路旁、湿润草地、河岸和田埂上。"}]},{"ID":"20240612185503-wtp2lmr","Type":"NodeParagraph","Properties":{"id":"20240612185503-wtp2lmr","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"2.生于河岸、湿润坡地、田埂和路旁。"}]},{"ID":"20240612185503-pbiqj6l","Type":"NodeParagraph","Properties":{"id":"20240612185503-pbiqj6l","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"资源分布：1.广布于东北、华北、华东、华中及广西等地。"}]},{"ID":"20240612185503-oe5a1o6","Type":"NodeParagraph","Properties":{"id":"20240612185503-oe5a1o6","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"2.分布于东北、华北及陕西、甘肃、新疆、河南等地。"}]},{"ID":"20240612185503-j2ougaa","Type":"NodeParagraph","Properties":{"id":"20240612185503-j2ougaa","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612185503-idxrwwu","Type":"NodeParagraph","Properties":{"id":"20240612185503-idxrwwu","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 1.旋复花，多年生草本，高30-80cm。根状茎短，横走或斜升，具须根。茎单生或簇生，绿色或紫色，有细纵沟，被长伏毛。基部叶花期枯萎 ，中部叶长圆形或长圆状披针形，长4-13cm，宽1.5-4.5cm，先端尖，基部渐狭，常有圆形半抱茎的小耳，无柄，全缘或有疏齿，上面具疏毛或近无毛，下面具疏伏毛和腺点，中脉和侧脉有较密的长毛；上部叶渐小，线状披针形。头状花序，径3-4cm，多数或少数排列成疏散的伞房花序；花序梗细长；总苞半球形，径1.3-1.7cm，总苞片约5层，线状披针形，最外层带叶质而较长；外层基部革质，上部叶质；内层干膜质；舌状花黄色，较总苞长2-2.5倍；舌片线形，长10-13mm；管状花花冠长约5mm，有三有披针形裂片；冠毛白色，1轮，有20余个粗糙毛。瘦果圆柱形，长1-1.2mm，有10条纵沟，被疏短毛。花期6-10月，果期9-11月。"}]},{"ID":"20240612185503-4v8vdsb","Type":"NodeParagraph","Properties":{"id":"20240612185503-4v8vdsb","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"2.欧亚旋覆花，与旋覆花不同点在于：叶片长圆或椭圆状披针形，基部宽大，心形，有耳，半抱茎。头状花序，径2.5-5cm；总苞径1.5-2.2cm，长达1cm。瘦果圆柱形，有浅沟，被短毛。"}]},{"ID":"20240612185503-vxe64uw","Type":"NodeParagraph","Properties":{"id":"20240612185503-vxe64uw","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612185503-20n8lu9","Type":"NodeParagraph","Properties":{"id":"20240612185503-20n8lu9","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 1.气候土壤：以温暖湿润的气候最适宜。以肥沃的砂质壤土或腐殖质壤土生长良好。"}]},{"ID":"20240612185503-pqtzkxr","Type":"NodeParagraph","Properties":{"id":"20240612185503-pqtzkxr","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"2.整地：播种前应进行秋耕，同时施用基肥每亩6000-8000斤。翌年3月下旬再浅耕1次，耙平作畦，畦宽1-1.2m。"}]},{"ID":"20240612185503-cli648k","Type":"NodeParagraph","Properties":{"id":"20240612185503-cli648k","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"3.种植、种子繁殖：按行距30cm开浅沟条播，将种子均匀撒入沟内，覆上薄土，稍镇压后浇水，每亩播种量1.5-2斤，阳畦育苗，较直播提早10-15天进行，畦面整平后浇1次大水，待水渗下后，即可播种，撒播后，覆土1薄层，约10-14天出苗，待幼苗生有3-4片真叶时，按行株距30×15cm移栽。分株繁殖：4月中旬至5月上旬进行，按行株距30×15cm开穴，将母株旁边所生的新株挖出，分栽于穴中，每穴栽苗2-3株，使根部舒展于穴中，盖土压实后浇水。"}]},{"ID":"20240612185503-n9afsj3","Type":"NodeParagraph","Properties":{"id":"20240612185503-n9afsj3","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"4.田间管理：天气干旱时，要及时浇水，在炎热干旱或大雨后表土板结时，要及时松上，以减少水分蒸发。"}]},{"ID":"20240612185503-ao89scs","Type":"NodeParagraph","Properties":{"id":"20240612185503-ao89scs","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612185503-um7cano","Type":"NodeParagraph","Properties":{"id":"20240612185503-um7cano","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 性状鉴定：干燥头状花序呈扁球形，有时散落，直径8-15mm（线叶旋复花较小，4-10mm）。底部有4层（线叶旋复花3层）浅灰绿色、膜质的总苞片，有时残留花梗。外缘1层舌状花，黄色，长约1cm，先端3齿裂，多卷曲；中央管状花密集，花冠5齿裂，子房顶端有多数白色冠毛，长约5mm（线叶旋复花长约3mm），质柔软，手捻易散，气微弱，味微苦咸。以朵大、金黄色、有白绒毛、无枝梗者为佳。主产河南、江苏、河北、浙江、安徽和黑龙江、吉林、辽宁等地。除上述品种外，在部分地区尚有将旋复花属其它种植物的头状花序作旋复花用，如广东、广西。湖南、江西等地用的是齿叶旋复花Inulachrysantha Diels，其干燥花序略呈球形，直径7-12mm。总苞灰绿色，被白色茸毛，舌状花1层，黄色或淡棕色，有时脱落；管状花密集中央，子房上的冠毛多数退化，留下鳞片状残迹，质硬。云南、贵州有些地区用的是水朝阳花Inula helian-fhus- aquatilis C. Y. Wu exLing（参见水朝阳条），其干燥花序的直径8-14mm。子房上的冠毛15-20条，长约3mm。湖北。贵州有些地区用的是湖北朝阳花I. Helianthus- aquatilis C. Y. Wu ex Ling subsp. Hupe- hensis Ling，其干燥花序略呈半球形，不易散落，直径1-2cm。总苞黄绿色或绿色，被白色短毛。舌状花1层，细长，长可达2cm，黄色或淡棕色；中央为管状花，冠毛5-10条，长约2mm。"}]},{"ID":"20240612185503-ui18nl6","Type":"NodeParagraph","Properties":{"id":"20240612185503-ui18nl6","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"毒性"}]},{"ID":"20240612185503-r91msk6","Type":"NodeParagraph","Properties":{"id":"20240612185503-r91msk6","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 绿原酸毒性很小，幼大鼠口服半数致死量大于1g／kg，腹腔注射大于0.25g／kg。同属植物Inuia royleana含生物碱（C21H38O6N），能抑制呼吸。降低血压、松弛平滑肌，并有箭毒样作用，但无抗菌作用。15%旋复花煎剂腹腔注射，小鼠的急性半数致死量 约为22.5g／kg。小鼠腹腔注射煎剂2ml／只，注射后立即呼吸加快，6分钟出现兴奋、抽搐、举尾、四肢震颤、8分钟后死亡。"}]},{"ID":"20240612185503-kly8dxa","Type":"NodeParagraph","Properties":{"id":"20240612185503-kly8dxa","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612185503-po5abi8","Type":"NodeParagraph","Properties":{"id":"20240612185503-po5abi8","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 大花旋复花开花时期的地上部分含倍半萜内酯化合物大花旋复花素（Britanin）和旋复花素（Inulicin）。花含槲皮素（Quercetin）、异槲皮素（Isoquereetin）、咖啡酸（Caffeieacid）、绿原酸（lorogenic acid）、菊糖及蒲公英甾醇（Taraxasterol）等多种甾醇。花含蒲公英甾醇（taraxasterol,inusterol A-）；地上部分分离得旋覆花内酯(inulicin），另分得脱乙酰旋覆花内酯(desacetylinulicin)。"}]},{"ID":"20240612185503-r8zl9hb","Type":"NodeParagraph","Properties":{"id":"20240612185503-r8zl9hb","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"药理作用"}]},{"ID":"20240612185503-7uqttzx","Type":"NodeParagraph","Properties":{"id":"20240612185503-7uqttzx","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 1.平喘、镇咳作用：旋复花黄酮对组胺引起的豚鼠支气管痉挛性哮喘有明显的保护作用，对组胺引起的豚鼠离体气管痉挛亦有对抗作用，但较氨茶碱的作用慢而弱。小鼠氨水喷雾法和酚红排泌法实验表明，旋复花黄酮无镇咳和祛痰作用。小鼠 腹腔注射 150%旋复花煎剂0.1ml，给药后1小时有显着镇咳作用，但祛痰效果不明显。"}]},{"ID":"20240612185503-au63m78","Type":"NodeParagraph","Properties":{"id":"20240612185503-au63m78","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"2.抗菌作用：平板纸片法或挖沟法试验，1：1 旋复花煎剂对金黄色葡萄球菌、炭疽杆菌和福氏痢疾杆菌Ⅱa株有明显的抑制作用。"}]},{"ID":"20240612185503-ho0ybhg","Type":"NodeParagraph","Properties":{"id":"20240612185503-ho0ybhg","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"3.杀虫作用：体外试验0.24-7.8μg/ml的旋复花内酯对阴道滴虫和溶组织内阿米巴均有强大的杀原虫作用。"}]},{"ID":"20240612185503-s2rhel1","Type":"NodeParagraph","Properties":{"id":"20240612185503-s2rhel1","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"炮制"}]},{"ID":"20240612185503-tul1hy2","Type":"NodeParagraph","Properties":{"id":"20240612185503-tul1hy2","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 旋复花：拣净杂质，除去梗叶，筛去泥土。蜜炙旋复花：取净旋复花，加炼熟蜂蜜与开水少许，拌匀，稍炯，用文火炒至黄色、不粘手为度，取出凉透。（每旋复花100斤，用炼熟蜂蜜25斤）"}]},{"ID":"20240612185503-xg801jz","Type":"NodeParagraph","Properties":{"id":"20240612185503-xg801jz","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612185503-otg8j8v","Type":"NodeParagraph","Properties":{"id":"20240612185503-otg8j8v","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 肺；胃；大肠经"}]},{"ID":"20240612185503-rxve1fh","Type":"NodeParagraph","Properties":{"id":"20240612185503-rxve1fh","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612185503-zwwqq25","Type":"NodeParagraph","Properties":{"id":"20240612185503-zwwqq25","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 味苦；辛；咸；微温"}]},{"ID":"20240612185503-r6f93be","Type":"NodeParagraph","Properties":{"id":"20240612185503-r6f93be","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612185503-fko7x8s","Type":"NodeParagraph","Properties":{"id":"20240612185503-fko7x8s","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 消痰行水；降气止呕。主咳喘痰粘；哆嗦噫气；胸痞胁痛"}]},{"ID":"20240612185503-321fqk9","Type":"NodeParagraph","Properties":{"id":"20240612185503-321fqk9","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612185503-v2mpxsf","Type":"NodeParagraph","Properties":{"id":"20240612185503-v2mpxsf","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤(纱布包煎或滤去毛),3-10g。"}]},{"ID":"20240612185503-xx9mub4","Type":"NodeParagraph","Properties":{"id":"20240612185503-xx9mub4","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612185503-g38dr9h","Type":"NodeParagraph","Properties":{"id":"20240612185503-g38dr9h","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" ①治伤寒中脘有痰，令人壮热，项筋紧急，时发寒热，皆类伤风，但不头痛为异：前胡三两，荆芥四两，半夏一两（洗，姜汁浸），赤芍药二两，细辛一两，甘草一两（炙），旋复花三两。上捣罗为未，每服二钱，水。一盏，生姜五片，枣子一枚，同煎至六分，去滓，热服，未知再服，类证活人书》金沸草散）②治积年上气：旋复花（去梗，焙）一两，皂艾（炙，去皮。子）一两一分，大黄（挫、炒）一两半。上三味，捣罗为末，炼蜜九如梧桐子大。每服十丸至十五九，温汤下，日三服，（《圣济总录》旋复花丸）③治肝着，亦治妇人半产漏下：旋复花三两，葱十四茎，新绛少许。以水三升，煮取一升，顿服之。（《金匿要略》旋复花汤）④治痰饮在胸膈呕不止，心下痞者：旋复花、半夏、茯苓、青皮。水煎服。（《产科发蒙》旋复半夏汤）⑤治风痰呕逆，饮食不下，头目昏闷：旋复花、枇杷叶、川芎、细辛、各一钱，前胡一钱五分。姜、枣水煎服，（《妇人良方》旋复花汤）⑥治伤寒发汗，若吐若下，解后，心下痞，噫气不除者：旋复花三两，人参二两，生姜五两，代赭石一两，甘草三两（炙），半夏半升（洗），大枣十二枚（擘），上七味，以水一斗，煮取六升，去滓，再煎取三升，温服一升，日三服，（《伤寒论》旋复代赭汤）⑦治风湿痰饮上攻，头目眩胀眵：旋复花、天麻、甘菊花各等分。为末，每晚服二钱，白汤下，（《本草汇言》）⑧治小便不行，因痰饮留闭者：旋复花一握，捣汁，和生由酒服。（《本草汇言》） ⑨治单腹胀：旋复、鲤鱼。将鱼肠去净，药入鱼肚内，煎服。小便利，肿胀即消。 ⑩治风火牙痛：旋复花为末，搽牙根上，良久，去其痰涎，疼止。 11、治乳岩、乳痈：旋复花二钱，蒲公英一钱，甘草节八分，白芷一钱，青皮一钱。水酒为引，水煎服。（⑨方以下出《滇南本草》） 12、治月蚀耳疮：旋复花烧研，羊脂和涂之。（《濒湖集简方》"}]},{"ID":"20240612185503-qgrm6vg","Type":"NodeParagraph","Properties":{"id":"20240612185503-qgrm6vg","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240612185503-u0n79h9","Type":"NodeParagraph","Properties":{"id":"20240612185503-u0n79h9","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 1.《本草衍义》：旋复花，行痰水，去头目风，亦走散之药也。"}]},{"ID":"20240612185503-3qyfqyt","Type":"NodeParagraph","Properties":{"id":"20240612185503-3qyfqyt","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"2.《注解伤寒论》：鞭则气坚，咸味可以耍之，旋复之咸以耍痞鞭。"}]},{"ID":"20240612185503-cmvq5n3","Type":"NodeParagraph","Properties":{"id":"20240612185503-cmvq5n3","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：旋复所治诸病，其功只在行水、下气、通血脉尔。"}]},{"ID":"20240612185503-ay7fult","Type":"NodeParagraph","Properties":{"id":"20240612185503-ay7fult","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"4.《本草发明》：旋复花，消痰导饮、散结利气之味。其云除惊悸者，以去心下水饮，心神自定也。又治目中翳MIE头风，毕竟痰饮结滞而生风热，此能散之，头目自清也。"}]},{"ID":"20240612185503-pf72bi6","Type":"NodeParagraph","Properties":{"id":"20240612185503-pf72bi6","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"5.《本草经疏》：旋复花，其味首系之以咸，润下作咸，咸能软坚；《别录》对口甘，甘能缓中；微温，温能通行，故主结气胁下满；心脾伏饮则病惊悸，饮消则复常矣。除水，去五脏间寒热，及消胸上痰结，唾如胶漆，心胁痰水，膀恍留饮，风气湿痹，皮间死肌，目中睁，利大肠者，皆软坚、冷利、润下、消痰饮除水之功也。其曰补中下气者，以甘能缓中，咸能润下故也。通血脉、益色泽者，盖指饮消则脾健，健则能运行，脾裹血又统血故也。"}]},{"ID":"20240612185503-t3y3ck5","Type":"NodeParagraph","Properties":{"id":"20240612185503-t3y3ck5","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"6.《本草汇言》：旋复花，消痰逐水，利气下行之药也。主心肺结气，胁下虚满，胸中结痰，痞坚噫气，或心脾伏饮，膀胱留饮，宿水等症。大抵此剂微咸以软坚散痞，性利以下气行痰水，实消伐之药也。《本草》有定惊悸、补中气之说，窃思痰闭心包脾络之间，往往令人病惊，旋复破痰逐饮，痰饮去则胞络清净而无碍，五志自宁，惊悸安矣。又饮消则脾健，肿健则能运行饮食，中气自受其益而补养矣。又：童玉峰云，若热痰，则多烦热；湿痰，则多倦怠软弱；风痰，则多瘫痪奇症；'凉痰，则多心痛癫疾；冷痰，则多骨痹痿疾；饮痰，则多胁痛臂痛；食积痰，则多癖块痞满。其为病状，种种变见，用旋复花，虚实寒热，随证加入，无不应手获效。"}]},{"ID":"20240612185503-bqlxb1h","Type":"NodeParagraph","Properties":{"id":"20240612185503-bqlxb1h","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"7.《本草正》：旋复花，开结气，降痰涎，通水道，消肿满，凡气奎湿热者宜之。但其性在走散，故凡见大肠不实及气虚阳衰之人，皆所忌用。"}]},{"ID":"20240612185503-cwk48az","Type":"NodeParagraph","Properties":{"id":"20240612185503-cwk48az","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"8.《本草正义》：旋复花，其主治当以泄散风寒，疏通脉络为专主，《别录》治风气湿痹，皮间死肉，通血脉，宗爽去头目风，皆其轻疏泄散之功也。以治风寒喘嗽，寒饮渍肺，最是正法。或谓旋复花降气，寒邪在肺者，不宜早用，则止知疏泄之力足以下降，而不知其飞扬之性本能上升。且《本经》明谓其温，寇宗又以为辛，则疏散寒邪，正其专职。若其开结泄水，下气降逆等治，则类皆沉重下达之义，颇嫌其与轻扬之本性，不甚符合。按《本经》旋复花一名金沸草，疑古人本有用其茎叶，而未必皆用其花者。考草木花叶之功用，不同者甚多，或升或降，各有取义，亦其享赋使然，不容混合。且茎则质重，花则质轻，亦物理自然之性，况旋复花之尤为轻而上扬者乎。乃今人恒用其花，而并不用茎叶，竟以重坠之功，责之轻扬之质，恐亦非古人辨别物性之真旨也，且其花专主温散，疏泄之力亦猛，宜于寒饮，而不宜于热痰，石顽已谓阴虚劳嗽，风热燥咳，误用之，嗽必愈甚，是亦以其轻扬，升泄太过，正与降气之理相反。惟其轻灵之性，流动不滞，自能流通气化而宣窒塞，固非专以升散见长。若但以逐水导湿力治，似不如兼用其茎叶较为近理，《别录》称其根专主风湿，其意可晓然也。"}]},{"ID":"20240612185503-xn4lmb9","Type":"NodeParagraph","Properties":{"id":"20240612185503-xn4lmb9","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"9.《本经》：主结气，胁下满，惊悸。除水，去五脏间寒热，补中，下气。"}]},{"ID":"20240612185503-vcex6l7","Type":"NodeParagraph","Properties":{"id":"20240612185503-vcex6l7","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"10.《别录》：消胸上痰结，唾如胶漆，心胁痰水，膀胱留饮，风气湿痹，皮间死肉，目中眵MIE，利大肠，通血脉，益色泽。"}]},{"ID":"20240612185503-i81zsim","Type":"NodeParagraph","Properties":{"id":"20240612185503-i81zsim","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"11.《药性论》：主肋胁气，下寒热水肿，主治膀胱宿水，去逐大腹，开胃，止呕逆不下食。"}]},{"ID":"20240612185503-wbt27wm","Type":"NodeParagraph","Properties":{"id":"20240612185503-wbt27wm","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"12.《日华子本草》：明目，治头风，通血脉。"}]},{"ID":"20240612185503-vnugfc5","Type":"NodeParagraph","Properties":{"id":"20240612185503-vnugfc5","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"13.《汤液本草》：发汗吐下后，心下痞，噫气不除者宜此。"}]},{"ID":"20240612185503-eytnttw","Type":"NodeParagraph","Properties":{"id":"20240612185503-eytnttw","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"14.《滇南本草》：祛头日诸风寒邪，止太阳、阳明头疼，行阳明乳汁不通。（治）乳岩、乳痈、红肿疼痛、暴赤火眼、目疾疼痛、祛风明目、隐涩羞明伯日，伤风寒热咳嗽。老痰如胶，走经络，止面寒腹疼，利小便，治单腹胀，凤火牙根肿痛。"}]},{"ID":"20240612185503-klzdqtg","Type":"NodeParagraph","Properties":{"id":"20240612185503-klzdqtg","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"15.《医学人门》：逐水，消痰，止咽噎。"}]},{"ID":"20240612185503-98koxvq","Type":"NodeParagraph","Properties":{"id":"20240612185503-98koxvq","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"16.《南京民间药草》：花和苗，祛湿、拔毒、消肿，煎水洗患处。"}]},{"ID":"20240612185503-hywe816","Type":"NodeParagraph","Properties":{"id":"20240612185503-hywe816","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612185503-51byq2a","Type":"NodeParagraph","Properties":{"id":"20240612185503-51byq2a","updated":"20240612185503"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612185504-xwyf4gh","Type":"NodeThematicBreak","Properties":{"id":"20240612185504-xwyf4gh"}},{"ID":"20240612185505-ukhwogp","Type":"NodeParagraph","Properties":{"id":"20240612185505-ukhwogp"}}]}