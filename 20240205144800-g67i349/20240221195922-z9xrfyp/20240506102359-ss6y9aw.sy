{"ID":"20240506102359-ss6y9aw","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102359-ss6y9aw","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102359-ss6y9aw\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240628124654-sy57ra5\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612185505-ukhwogp\u0026quot;,\u0026quot;scrollTop\u0026quot;:5800,\u0026quot;focusId\u0026quot;:\u0026quot;20240628112648-9rymum1\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"275旋复花（旋覆花、金沸草）","type":"doc","updated":"20240822173914"},"Children":[{"ID":"20240628124941-6c5osgo","Type":"NodeParagraph","Properties":{"id":"20240628124941-6c5osgo","updated":"20240628124944"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 396px;","style":"width: 386px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628124941-f4utvox.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 386px;\" parent-style=\"width: 396px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628124726-wxhkx6d","Type":"NodeParagraph","Properties":{"id":"20240628124726-wxhkx6d"}},{"ID":"20240628115256-99kocl7","Type":"NodeParagraph","Properties":{"id":"20240628115256-99kocl7","updated":"20240628125733"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 357px;","style":"width: 347px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628115256-qxm9kya.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 347px;\" par