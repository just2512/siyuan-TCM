{"ID":"20240506102400-rdgdv94","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102400-rdgdv94","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102400-rdgdv94\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240702100849-sn6n1rs\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613114820-gzhcukp\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240702101618-273ypjv\u0026quot;,\u0026quot;focusStart\u0026quot;:7,\u0026quot;focusEnd\u0026quot;:7\u0026#125;","title":"310牛扁","type":"doc","updated":"20240826120001"},"Children":[{"ID":"20240702100849-sn6n1rs","Type":"NodeParagraph","Properties":{"id":"20240702100849-sn6n1rs"}},{"ID":"20240702100834-ty9whrk","Type":"NodeParagraph","Properties":{"id":"20240702100834-ty9whrk","updated":"20240702100838"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 323px;","style":"width: 313px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702100834-gyy4vjz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 313px;\" parent-style=\"width: 323px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 296px;","style":"width: 286px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240702100838-gk6of3y.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 286px;\" parent-style=\"width: 296px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240702101041-wmbbj99","Type":"NodeParagraph","Properties":{"id":"20240702101041-wmbbj99","updated":"2024082611