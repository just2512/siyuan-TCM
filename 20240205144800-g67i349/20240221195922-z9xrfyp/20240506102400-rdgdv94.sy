e":"width: 793px;","style":"width: 783px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛扁10"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛扁10-20240702102057-n9ttifj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 783px;\" parent-style=\"width: 793px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826115844-u4eyi02","Type":"NodeParagraph","Properties":{"id":"20240826115844-u4eyi02","updated":"20240826120001"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 354px;","style":"width: 344px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛扁 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛扁 3-20240826115953-7lgyh5r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 344px;\" parent-style=\"width: 354px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 786px;","style":"width: 776px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛扁 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛扁 2-20240826115844-fna294z.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 776px;\" parent-style=\"width: 786px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826115054-m8hzkek","Type":"NodeParagraph","Properties":{"id":"20240826115054-m8hzkek","updated":"20240826115056"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 568px;","style":"width: 558px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛扁2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛扁2-20240702101015-3lvcjlo.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 558px;\" parent-style=\"width: 568px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 568px;","style":"width: 558px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"牛扁3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/牛扁3-20240702101041-za8n0oc.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 558px;\" parent-style=\"width: 568px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613114817-8ak28xk","Type":"NodeThematicBreak","Properties":{"id":"20240613114817-8ak28xk"}},{"ID":"20240613115327-ck6ysbv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115327-ck6ysbv","updated":"20240613115330"},"Children":[{"Type":"NodeText","Data":"牛扁《神农本草经》"}]},{"ID":"20240613115327-skv5aex","Type":"NodeParagraph","Properties":{"id":"20240613115327-skv5aex","updated":"20240613115327"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240613115327-117kkiv","Type":"NodeParagraph","Properties":{"id":"20240613115327-117kkiv","updated":"20240613115327"},"Children":[{"Type":"NodeText","Data":"主身皮创，热气，可作浴汤，杀牛虱小虫，又疗牛病。生川谷。"}]},{"ID":"20240613115327-vlb4ha5","Type":"NodeParagraph","Properties":{"id":"20240613115327-vlb4ha5","updated":"20240613115327"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生桂阳。"}]},{"ID":"20240613115327-547fhyr","Type":"NodeParagraph","Properties":{"id":"20240613115327-547fhyr","updated":"20240613115327"},"Children":[{"Type":"NodeText","Data":"案陶宏景云：太常贮名扁特，或名扁毒。"}]},{"ID":"20240613115336-kqnbnba","Type":"NodeThematicBreak","Properties":{"id":"20240613115336-kqnbnba"}},{"ID":"20240613115337-tazpze1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115337-tazpze1","updated":"20240613115343"},"Children":[{"Type":"NodeText","Data":"牛扁《神农本草经赞》"}]},{"ID":"20240613115337-6dl2p3s","Type":"NodeParagraph","Properties":{"id":"20240613115337-6dl2p3s","updated":"20240613115337"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主身皮创热气。可作浴汤。杀牛虱小虫。又疗牛病。生川谷。芮堇形同。"}]},{"ID":"20240613115337-9dxdp3g","Type":"NodeParagraph","Properties":{"id":"20240613115337-9dxdp3g","updated":"20240613115337"},"Children":[{"Type":"NodeText","Data":"平芜扁毒。扪虱爬搔。牵牛觳觫。细捣油涂。含温汤沐。建草赤茎。水中短竹。"}]},{"ID":"20240613115337-iiib6mg","Type":"NodeParagraph","Properties":{"id":"20240613115337-iiib6mg","updated":"20240613115337"},"Children":[{"Type":"NodeText","Data":"苏恭曰。此药似堇草石龙芮辈。生平泽。或名扁毒。欧阳修文。不足爬搔于虮虱。孟子。"}]},{"ID":"20240613115337-ew8fiyp","Type":"NodeParagraph","Properties":{"id":"20240613115337-ew8fiyp","updated":"20240613115337"},"Children":[{"Type":"NodeText","Data":"有牵牛而过堂下者。又。吾不忍其觳觫。苏颂曰。其根苗捣末。油调杀虮虱。陈藏器曰。虱建草。茎赤。治虮虱虫疮。又水竹。叶生水中。叶如竹而短。亦去虮虱。"}]},{"ID":"20240613114817-z9w7weh","Type":"NodeThematicBreak","Properties":{"id":"20240613114817-z9w7weh"}},{"ID":"20240613115316-arcpyfj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115316-arcpyfj","updated":"20240613115321"},"Children":[{"Type":"NodeText","Data":"牛扁《医学入门》"}]},{"ID":"20240613115316-fn1u3ew","Type":"NodeParagraph","Properties":{"id":"20240613115316-fn1u3ew","updated":"20240613115316"},"Children":[{"Type":"NodeText","Data":"生下湿地。叶似石龙芮，根似秦艽而细。味苦，寒，无毒。主身皮疮热气，可作浴汤。又主牛病、牛虱。入药用根。"}]},{"ID":"20240613115401-n792nub","Type":"NodeThematicBreak","Properties":{"id":"20240613115401-n792nub"}},{"ID":"20240613115402-r8toukv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115402-r8toukv","updated":"20240613115406"},"Children":[{"Type":"NodeText","Data":"牛扁《名医别录》"}]},{"ID":"20240613115402-opm4hdz","Type":"NodeParagraph","Properties":{"id":"20240613115402-opm4hdz","updated":"20240613115402"},"Children":[{"Type":"NodeText","Data":"无毒，生桂阳．"}]},{"ID":"20240613115402-d8z8vi5","Type":"NodeParagraph","Properties":{"id":"20240613115402-d8z8vi5","updated":"20240613115402"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶牛扁，味苦，微寒．主身皮疮热气，可作浴汤，杀牛虱小虫，又疗牛病．生川谷．"}]},{"ID":"20240613114817-afxpann","Type":"NodeThematicBreak","Properties":{"id":"20240613114817-afxpann"}},{"ID":"20240613115223-of2oho4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115223-of2oho4","updated":"20240613115234"},"Children":[{"Type":"NodeText","Data":"牛扁《千金翼方》"}]},{"ID":"20240613115223-ed53m98","Type":"NodeParagraph","Properties":{"id":"20240613115223-ed53m98","updated":"20240613115415"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主身皮疮热气。可作浴汤，杀牛虱小虫。又疗牛病，生桂阳。"}]},{"ID":"20240613115420-gyn9w3f","Type":"NodeThematicBreak","Properties":{"id":"20240613115420-gyn9w3f"}},{"ID":"20240613115421-to4ns1k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115421-to4ns1k","updated":"20240613115426"},"Children":[{"Type":"NodeText","Data":"牛扁《本草经集注》"}]},{"ID":"20240613115421-73mgt93","Type":"NodeParagraph","Properties":{"id":"20240613115421-73mgt93","updated":"20240613115421"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主治身皮疮热气，可作浴汤。杀牛虱、小虫，又治牛病。生桂阳川谷。"}]},{"ID":"20240613115421-ljc115i","Type":"NodeParagraph","Properties":{"id":"20240613115421-ljc115i","updated":"20240613115421"},"Children":[{"Type":"NodeText","Data":"今人不复识此，牛疫代代不无用之。既要牛医家应用，而亦无知者。"}]},{"ID":"20240613115450-l49jyxv","Type":"NodeThematicBreak","Properties":{"id":"20240613115450-l49jyxv"}},{"ID":"20240613115453-i4u9pc6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115453-i4u9pc6","updated":"20240613115457"},"Children":[{"Type":"NodeText","Data":"牛扁《新修本草》"}]},{"ID":"20240613115453-cw3cikf","Type":"NodeParagraph","Properties":{"id":"20240613115453-cw3cikf","updated":"20240613115453"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主身皮疮热气，可作浴汤。杀牛虱小虫，又疗牛病。生桂阳川谷。"}]},{"ID":"20240613115453-3b81wkp","Type":"NodeParagraph","Properties":{"id":"20240613115453-3b81wkp","updated":"20240613115453"},"Children":[{"Type":"NodeText","Data":"今人不复识此，牛疫代代不无用之。既要牛医家应用，而亦无知者。"}]},{"ID":"20240613115453-vp6yhet","Type":"NodeParagraph","Properties":{"id":"20240613115453-vp6yhet","updated":"20240613115453"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此药，似三堇、石龙芮等，根如秦艽而细。生平泽下湿地，田野人名为牛扁。疗牛虱甚效。太常贮名扁特，或名扁毒。"}]},{"ID":"20240613115431-c9afg46","Type":"NodeThematicBreak","Properties":{"id":"20240613115431-c9afg46"}},{"ID":"20240613115433-03pbrdz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115433-03pbrdz","updated":"20240613115444"},"Children":[{"Type":"NodeText","Data":"牛扁《本草图经》"}]},{"ID":"20240613115433-4upunly","Type":"NodeParagraph","Properties":{"id":"20240613115433-4upunly","updated":"20240613115435"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"牛扁"},{"Type":"NodeText","Data":"，出桂阳川谷，今潞州、宁州亦有之。叶似三堇、石龙芮等。根如秦艽而细，多生平泽下湿地。二月、八月采根，日干。今亦稀用。按《本经》云∶杀牛虱小虫。苏恭注云∶太常贮名扁特。今潞州只一种名便特。六月有花，八月结实，采其根。捣末，油调，杀虮虱。根、苗主疗，大都相似。疑此即是牛扁。但扁便不同，岂声近而字讹乎？今以附之。"}]},{"ID":"20240613114817-8wxyso5","Type":"NodeThematicBreak","Properties":{"id":"20240613114817-8wxyso5"}},{"ID":"20240613115519-4yot1a5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613115519-4yot1a5","updated":"20240613115528"},"Children":[{"Type":"NodeText","Data":"牛扁《证类本草》"}]},{"ID":"20240613115519-377o3bs","Type":"NodeParagraph","Properties":{"id":"20240613115519-377o3bs","updated":"20240613115519"},"Children":[{"Type":"NodeText","Data":"味苦，微寒。无毒。主身皮疮热气，可作浴汤，杀牛虱小虫，又疗牛病。生桂阳川谷。"}]},{"ID":"20240613115519-er95t1t","Type":"NodeParagraph","Properties":{"id":"20240613115519-er95t1t","updated":"20240613115519"},"Children":[{"Type":"NodeText","Data":"（陶隐居云：今人不复识此，牛疫代代不无用之。既要牛医家应用，而亦无知者。唐本注云：此药似三堇、石龙芮等。根如秦艽而细。生平泽下湿地，田野人名为牛扁。疗牛虱甚效。太常贮名扁特。或名扁毒。臣禹锡等谨按蜀本《图经》云：叶似石龙芮、附子等。今出宁州。二月、八月采根，日干。）"}]},{"ID":"20240613115519-bmaru3s","Type":"NodeParagraph","Properties":{"id":"20240613115519-bmaru3s","updated":"20240613115519"},"Children":[{"Type":"NodeText","Data":"（《图经》曰：牛扁，出桂阳川谷。今潞州、宁州亦有之。叶似三堇、石龙芮等。根如秦艽而细。多生平泽下湿地。二月、八月采以日干。今亦稀用。按《本经》云：杀牛虱小虫。苏恭注云：太常贮名扁特。今潞州止一种，名便特。六月有花，八月实。采其根，捣末，油调，杀虮虱。根苗主疗大都相似。疑此即是牛扁，但扁、便不同，岂声近而字讹乎？今以附之。）"}]},{"ID":"20240613114817-uzir3z9","Type":"NodeThematicBreak","Properties":{"id":"20240613114817-uzir3z9"}},{"ID":"20240613114818-8r0ktqf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114818-8r0ktqf","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：牛扁"}]},{"ID":"20240613114818-f19q3qo","Type":"NodeParagraph","Properties":{"id":"20240613114818-f19q3qo","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613114818-zhz3qlj","Type":"NodeParagraph","Properties":{"id":"20240613114818-zhz3qlj","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" Niú Biǎn"}]},{"ID":"20240613114818-d6jlk5j","Type":"NodeParagraph","Properties":{"id":"20240613114818-d6jlk5j","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613114818-4telig4","Type":"NodeParagraph","Properties":{"id":"20240613114818-4telig4","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 曲芍"}]},{"ID":"20240613114818-788cibv","Type":"NodeParagraph","Properties":{"id":"20240613114818-788cibv","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613114818-3qnf1x0","Type":"NodeParagraph","Properties":{"id":"20240613114818-3qnf1x0","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 毛茛科乌头属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛扁"},{"Type":"NodeText","Data":"Aconitum ochranthum C. A. Mey.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"入药。春秋采挖，洗净晒干。"}]},{"ID":"20240613114818-r6dft29","Type":"NodeParagraph","Properties":{"id":"20240613114818-r6dft29","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613114818-q8lvuz1","Type":"NodeParagraph","Properties":{"id":"20240613114818-q8lvuz1","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 苦，温。有毒。"}]},{"ID":"20240613114818-8xhxkrl","Type":"NodeParagraph","Properties":{"id":"20240613114818-8xhxkrl","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613114818-qapriy2","Type":"NodeParagraph","Properties":{"id":"20240613114818-qapriy2","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 祛风止痛，止咳平喘，化痰。用于慢性支气管炎，腰腿痛，关节肿痛；外用治疥癣，淋巴结结核。"}]},{"ID":"20240613114818-np6aasb","Type":"NodeParagraph","Properties":{"id":"20240613114818-np6aasb","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613114818-cqx7a9s","Type":"NodeParagraph","Properties":{"id":"20240613114818-cqx7a9s","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 1～2钱；外用适量。"}]},{"ID":"20240613114818-zmhvj6e","Type":"NodeParagraph","Properties":{"id":"20240613114818-zmhvj6e","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613114818-2yr9cf5","Type":"NodeParagraph","Properties":{"id":"20240613114818-2yr9cf5","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613114818-5fdogg3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114818-5fdogg3","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：牛扁"}]},{"ID":"20240613114818-vhfcod3","Type":"NodeParagraph","Properties":{"id":"20240613114818-vhfcod3","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613114818-f8vj960","Type":"NodeParagraph","Properties":{"id":"20240613114818-f8vj960","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" Niú Biǎn"}]},{"ID":"20240613114818-emibb3l","Type":"NodeParagraph","Properties":{"id":"20240613114818-emibb3l","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613114818-uteevwa","Type":"NodeParagraph","Properties":{"id":"20240613114818-uteevwa","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 扁特、扁毒（《唐本草》）。"}]},{"ID":"20240613114818-z7jisjv","Type":"NodeParagraph","Properties":{"id":"20240613114818-z7jisjv","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613114818-wnkb2w9","Type":"NodeParagraph","Properties":{"id":"20240613114818-wnkb2w9","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613114818-krw6x4a","Type":"NodeParagraph","Properties":{"id":"20240613114818-krw6x4a","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613114818-26dqcnx","Type":"NodeParagraph","Properties":{"id":"20240613114818-26dqcnx","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 为毛茛科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"牛扁"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根、茎、叶"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613114818-8eyjk6i","Type":"NodeParagraph","Properties":{"id":"20240613114818-8eyjk6i","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613114818-jl86r0f","Type":"NodeParagraph","Properties":{"id":"20240613114818-jl86r0f","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 生于山地林中或林边草地。分布甘肃、陕西、山西、河北等地。"}]},{"ID":"20240613114818-6s5h0yd","Type":"NodeParagraph","Properties":{"id":"20240613114818-6s5h0yd","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613114818-im5ezks","Type":"NodeParagraph","Properties":{"id":"20240613114818-im5ezks","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 多年生草本，具直根。茎高（40～）60～110厘米，被反曲的微柔毛。基生叶1～5，与下部茎生叶具长柄；叶片圆肾形，长5.5～15厘米，宽10～22厘米，两面被短伏毛，3裂，中央裂片菱形，在中部3裂，2回裂片具狭卵形小裂片。总状花序；小苞片生花梗中部，条形；萼片5，黄色，上萼片圆筒形；花瓣2，具长爪，距与瓣片近等长；雄蕊多数；心皮3。蓇葖果3，长约8毫米。"}]},{"ID":"20240613114818-o6wkpd7","Type":"NodeParagraph","Properties":{"id":"20240613114818-o6wkpd7","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613114818-u39k9rk","Type":"NodeParagraph","Properties":{"id":"20240613114818-u39k9rk","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" ①《本经》：\"味苦，微寒。\""}]},{"ID":"20240613114818-pqnkhdm","Type":"NodeParagraph","Properties":{"id":"20240613114818-pqnkhdm","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"无毒。\""}]},{"ID":"20240613114818-qvh21n3","Type":"NodeParagraph","Properties":{"id":"20240613114818-qvh21n3","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613114818-nzk5z6t","Type":"NodeParagraph","Properties":{"id":"20240613114818-nzk5z6t","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 《本经》：\"主身皮疮热气，可作浴汤。\""}]},{"ID":"20240613114818-wv372xl","Type":"NodeParagraph","Properties":{"id":"20240613114818-wv372xl","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613114818-2crg60w","Type":"NodeParagraph","Properties":{"id":"20240613114818-2crg60w","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613114818-xagsj3l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114818-xagsj3l","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"《中华本草》《中药大辞典》：牛扁"}]},{"ID":"20240613114818-p8skhkk","Type":"NodeParagraph","Properties":{"id":"20240613114818-p8skhkk","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613114818-7odgpfs","Type":"NodeParagraph","Properties":{"id":"20240613114818-7odgpfs","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" Niú Biǎn"}]},{"ID":"20240613114818-95n16ms","Type":"NodeParagraph","Properties":{"id":"20240613114818-95n16ms","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613114818-vwfxm9s","Type":"NodeParagraph","Properties":{"id":"20240613114818-vwfxm9s","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 扁特、扁毒、扁桃叶根"}]},{"ID":"20240613114818-9f87q42","Type":"NodeParagraph","Properties":{"id":"20240613114818-9f87q42","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613114818-z83af21","Type":"NodeParagraph","Properties":{"id":"20240613114818-z83af21","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" Herb of Puberulent Monkshood"}]},{"ID":"20240613114818-um63dmw","Type":"NodeParagraph","Properties":{"id":"20240613114818-um63dmw","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613114818-36yqmrr","Type":"NodeParagraph","Properties":{"id":"20240613114818-36yqmrr","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》：牛扁，杀牛虱小虫，又疗牛病。生川谷。"}]},{"ID":"20240613114818-6tm27ap","Type":"NodeParagraph","Properties":{"id":"20240613114818-6tm27ap","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"1.《别录》：牛扁，生桂阳川谷。"}]},{"ID":"20240613114818-t8la7rc","Type":"NodeParagraph","Properties":{"id":"20240613114818-t8la7rc","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"2.《唐本草》：此药似三堇、石龙芮等，根如秦艽而细，生平泽下湿地。"}]},{"ID":"20240613114818-q1jax65","Type":"NodeParagraph","Properties":{"id":"20240613114818-q1jax65","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"3.《蜀本草》：《图经》云，牛扁叶似石龙芮、附子等，今出宁州。二月、八月采根日干。"}]},{"ID":"20240613114818-7qsxdsi","Type":"NodeParagraph","Properties":{"id":"20240613114818-7qsxdsi","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"4.《本草图经》：牛扁，今潞州、宁州亦有之。今亦稀用。……今潞州止一种，名便特；六月有花，八月结实，采其"}]},{"ID":"20240613114818-funby7w","Type":"NodeParagraph","Properties":{"id":"20240613114818-funby7w","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613114818-4wwv1hp","Type":"NodeParagraph","Properties":{"id":"20240613114818-4wwv1hp","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 药材基源：为毛茛科植物牛扁的根。"}]},{"ID":"20240613114818-4zq8mjb","Type":"NodeParagraph","Properties":{"id":"20240613114818-4zq8mjb","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Aconitum barbatum Pers.var.puberulum Ledeb.[A.ochranthum C.A.Mey.]"}]},{"ID":"20240613114818-u6lzwkd","Type":"NodeParagraph","Properties":{"id":"20240613114818-u6lzwkd","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"采收和储藏：春秋季挖根，除去残茎，洗净，晒干。"}]},{"ID":"20240613114818-b16j8xc","Type":"NodeParagraph","Properties":{"id":"20240613114818-b16j8xc","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613114818-151zsoc","Type":"NodeParagraph","Properties":{"id":"20240613114818-151zsoc","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔400-2700m的山地疏林下或较阴湿处。"}]},{"ID":"20240613114818-byb90iw","Type":"NodeParagraph","Properties":{"id":"20240613114818-byb90iw","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于内蒙古、河北、山西、陕西、新疆东部。"}]},{"ID":"20240613114818-2lnh7e3","Type":"NodeParagraph","Properties":{"id":"20240613114818-2lnh7e3","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613114818-2nsg0le","Type":"NodeParagraph","Properties":{"id":"20240613114818-2nsg0le","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 牛扁，多年生草本，具直根。茎高（40-）60-110cm，被反曲的微柔毛。基生叶1-5，与下部茎生叶具长柄；叶片圆肾形，长5.5-15cm，宽10-22cm，两面被短状毛，3裂，中央裂片菱形，在中部3裂，2回裂片具狭卵形小裂片。总状花序；小苞片生花梗中部，条形；萼片5，黄色，上萼片圆筒形；花瓣2，具长爪，距与瓣片近等长；雄蕊多数；心皮3。蓇葖果3，长约8mm。"}]},{"ID":"20240613114818-1lj9xxn","Type":"NodeParagraph","Properties":{"id":"20240613114818-1lj9xxn","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240613114818-pz3dzeh","Type":"NodeParagraph","Properties":{"id":"20240613114818-pz3dzeh","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 1.性状鉴别 根圆锥形，账10-15cm，中部直径2-4cm。表面暗棕色，外皮脱落处深棕色，粗糙，略显网纹；根头部常有多数根茎聚生，其下根分数股，每股有几个裂生根，互相扭结成辫子状。质轻而松脆，易折断，断面不平坦，木心淡黄褐色。气微，味苦、微辛。"}]},{"ID":"20240613114818-okfq43v","Type":"NodeParagraph","Properties":{"id":"20240613114818-okfq43v","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"2.显微鉴别 根横切面：上段为裂生中柱。形状不规则，常由一侧向内凹入，形成2个大的裂生中柱。后生皮层为数列木栓化细胞，2个裂生中柱间也产生木栓化细胞。每裂生中柱各由外周的内皮层包围，其外侧的外韧型维管束呈扇状排列成弧形，内侧为2-3个大小不等的分柱，均各有内皮层包围，从而形成几个大小不等的区域。中段分成10余个独立的裂生中柱；每个裂生中柱中有1-3个维管束，其外周被木栓化的后生皮层及皮层细胞所包围，整个根似由许多柱状物并生而成。下段呈原生中柱状，中央的木质部被一圈木栓化细胞包围而呈五角星状。"}]},{"ID":"20240613114818-h564fl8","Type":"NodeParagraph","Properties":{"id":"20240613114818-h564fl8","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613114818-ua7a5fn","Type":"NodeParagraph","Properties":{"id":"20240613114818-ua7a5fn","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 根含刺乌头碱（lappaconitine），毛茛叶乌头碱（ranaconitine），牛扁碱（lycaconitine），北方乌头碱（septentrionine）、北方乌头定碱（septentriodine），牛扁宁碱（puberanine），牛扁定碱（puberanidine），牛扁亭碱（puberaconitine），牛扁替定碱（puberaconitidine）。"}]},{"ID":"20240613114818-dtf3dkk","Type":"NodeParagraph","Properties":{"id":"20240613114818-dtf3dkk","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240613114818-4xiqh42","Type":"NodeParagraph","Properties":{"id":"20240613114818-4xiqh42","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 肝；肺经"}]},{"ID":"20240613114818-0jlu6et","Type":"NodeParagraph","Properties":{"id":"20240613114818-0jlu6et","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613114818-n4136kq","Type":"NodeParagraph","Properties":{"id":"20240613114818-n4136kq","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 苦；温；有毒"}]},{"ID":"20240613114818-sx3lgh9","Type":"NodeParagraph","Properties":{"id":"20240613114818-sx3lgh9","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613114818-13r9j1u","Type":"NodeParagraph","Properties":{"id":"20240613114818-13r9j1u","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 孕妇禁服。"}]},{"ID":"20240613114818-zu6vkj3","Type":"NodeParagraph","Properties":{"id":"20240613114818-zu6vkj3","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613114818-xsye86y","Type":"NodeParagraph","Properties":{"id":"20240613114818-xsye86y","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 祛风止痛；止咳化痰；平喘。主风湿关节肿痛；腰腿痛；喘咳；瘰疬；疥癣"}]},{"ID":"20240613114818-hdvfwdw","Type":"NodeParagraph","Properties":{"id":"20240613114818-hdvfwdw","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613114818-2fuxld0","Type":"NodeParagraph","Properties":{"id":"20240613114818-2fuxld0","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 内服：煎服，3-6g。外用：适量，煎汁洗。"}]},{"ID":"20240613114818-pd3q5gp","Type":"NodeParagraph","Properties":{"id":"20240613114818-pd3q5gp","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613114818-7uhk7ad","Type":"NodeParagraph","Properties":{"id":"20240613114818-7uhk7ad","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 《本经》：主身皮疮热气，可作浴汤。"}]},{"ID":"20240613114818-4x6q8rc","Type":"NodeParagraph","Properties":{"id":"20240613114818-4x6q8rc","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613114818-wj3z3hi","Type":"NodeParagraph","Properties":{"id":"20240613114818-wj3z3hi","updated":"20240613114818"},"Children":[{"Type":"NodeText","Data":" 《中华本草》《中药大辞典》"}]},{"ID":"20240613114819-jne29o7","Type":"NodeThematicBreak","Properties":{"id":"20240613114819-jne29o7"}},{"ID":"20240613114820-gzhcukp","Type":"NodeParagraph","Properties":{"id":"20240613114820-gzhcukp"}}]}