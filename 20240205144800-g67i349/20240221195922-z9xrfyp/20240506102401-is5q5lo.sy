{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/六角莲 2-20240823165840-qoc271v.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 646px;\" parent-style=\"width: 656px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 589px;","style":"width: 579px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"六角莲 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/六角莲 3-20240823165942-xbllp3k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 579px;\" parent-style=\"width: 589px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240701131755-lmql269","Type":"NodeParagraph","Properties":{"id":"20240701131755-lmql269"},"Children":[{"Type":"NodeText","Data":"​"}]},{"ID":"20240701130825-4e33xpi","Type":"NodeParagraph","Properties":{"id":"20240701130825-4e33xpi","updated":"20240701130825"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"八角莲"}]},{"ID":"20240701130940-b5w3of9","Type":"NodeParagraph","Properties":{"id":"20240701130940-b5w3of9","updated":"20240823165408"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 307px;","style":"width: 297px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角莲1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角莲1-20240701131016-jfln7st.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 297px;\" parent-style=\"width: 307px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823165412-cx8o0b2","Type":"NodeParagraph","Properties":{"id":"20240823165412-cx8o0b2","updated":"20240823165758"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 772px;","style":"width: 762px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角莲"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角莲-20240823165408-tqm5aos.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 762px;\" parent-style=\"width: 772px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 372px;","style":"width: 362px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角莲 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角莲 5-20240823165758-s2fl1h1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 362px;\" parent-style=\"width: 372px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823165501-3u63vpi","Type":"NodeParagraph","Properties":{"id":"20240823165501-3u63vpi","updated":"20240823165550"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 619px;","style":"width: 609px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角莲 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角莲 1-20240823165501-jqqbl4r.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 609px;\" parent-style=\"width: 619px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 467px;","style":"width: 457px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角莲 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角莲 3-20240823165550-rzzhsjb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 457px;\" parent-style=\"width: 467px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823165639-zstpd8o","Type":"NodeParagraph","Properties":{"id":"20240823165639-zstpd8o","updated":"20240823165647"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 553px;","style":"width: 543px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"八角莲 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/八角莲 4-20240823165639-mmwulg6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 543px;\" parent-style=\"width: 553px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 582px;","style":"width: 572px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鬼臼4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鬼臼4-20240701125735-fhwj9hy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613110103-w44qlb9","Type":"NodeParagraph","Properties":{"id":"20240613110103-w44qlb9","updated":"20240701130615"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：不要以有多少个角来区分八角莲和六角莲；六角莲比八角莲个子矮，最大的区别是开花的位置，六角莲开花位置是在中间偏下的位置开花，八角莲是在叶腋的位置。"}]},{"ID":"20240701125011-srwlrot","Type":"NodeThematicBreak","Properties":{"id":"20240701125011-srwlrot","updated":"20240701125011"}},{"ID":"20240701125011-asn9xnq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240701125011-asn9xnq","updated":"20240701125011"},"Children":[{"Type":"NodeText","Data":"鬼臼《神农本草经》"}]},{"ID":"20240701125011-asij6rl","Type":"NodeParagraph","Properties":{"id":"20240701125011-asij6rl","updated":"20240701125011"},"Children":[{"Type":"NodeText","Data":"味辛温。"}]},{"ID":"20240701125011-rlp9k8t","Type":"NodeParagraph","Properties":{"id":"20240701125011-rlp9k8t","updated":"20240701125011"},"Children":[{"Type":"NodeText","Data":"主杀蛊毒鬼注，精物，辟恶气不祥，逐邪，解百毒。一名爵犀，一名马目毒公，一名九臼。生山谷。"}]},{"ID":"20240701125011-34acosc","Type":"NodeParagraph","Properties":{"id":"20240701125011-34acosc","updated":"20240701125011"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：一名九臼，一名天臼，一名雀犀，一名马目公，一名解毒。生九真山谷及冤句，二月八月采根（《御览》）"}]},{"ID":"20240701125011-91qotbj","Type":"NodeParagraph","Properties":{"id":"20240701125011-91qotbj","updated":"20240701125011"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名天臼，一名解毒，生九真及冤句，二月八月采根。"}]},{"ID":"20240613110328-q67fuge","Type":"NodeThematicBreak","Properties":{"id":"20240613110328-q67fuge"}},{"ID":"20240613110341-ncpi6xm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110341-ncpi6xm","updated":"20240613110347"},"Children":[{"Type":"NodeText","Data":"鬼臼《证类本草》"}]},{"ID":"20240613110341-eytnpl4","Type":"NodeParagraph","Properties":{"id":"20240613110341-eytnpl4","updated":"20240613110341"},"Children":[{"Type":"NodeText","Data":"味辛，温、微温，有毒。主杀蛊毒，鬼疰精物，辟恶气不祥，逐邪，解百毒，疗咳嗽喉结，风邪烦惑，失魄妄见，去目中肤翳，杀大毒，不入汤。一名爵犀，一名马目毒公，一名九臼，一名天臼，一名解毒。生九真山谷及冤句。二月、八月采根。（畏垣衣。）"}]},{"ID":"20240613110341-hwe75c9","Type":"NodeParagraph","Properties":{"id":"20240613110341-hwe75c9","updated":"20240613110341"},"Children":[{"Type":"NodeText","Data":"陶隐居曰∶鬼臼如射干，白而味甘，温，有毒。主风邪，鬼疰，蛊毒，九臼相连，有毛者良。"}]},{"ID":"20240613110341-nczubk3","Type":"NodeParagraph","Properties":{"id":"20240613110341-nczubk3","updated":"20240613110341"},"Children":[{"Type":"NodeText","Data":"一名九臼，生山谷，八月采，阴干。又似钩吻。今马目毒公如黄精，根臼处似马眼而柔润。"}]},{"ID":"20240613110341-smqy82h","Type":"NodeParagraph","Properties":{"id":"20240613110341-smqy82h","updated":"20240613110341"},"Children":[{"Type":"NodeText","Data":"鬼臼似射干、术辈，有两种∶出钱塘、近道者，味甘，上有丛毛，最胜。出会稽、吴兴者，乃大，味苦，无丛毛，不如，略乃相似而乖异毒公。今方家多用鬼臼，少用毒公，不知此复顿乐乖越也。唐本注云∶此药生深山岩石之阴。叶如蓖麻、重楼辈。生一茎，茎端一叶，亦有两歧者。年长一茎，茎枯为一臼。假令生来二十年，则有二十臼，岂唯九臼耶？根肉皮须并似射干，今俗用皆是射干。及江南别送一物，非真者。今荆州当阳县、硖州远安县、襄州荆山县山中并有之，极难得也。臣禹锡等谨按蜀本图经云∶花生茎间，赤色。今出硖州、襄州深山，二月、八月采根，日干用之。药性论云∶鬼臼，使，味苦。能主尸疰， 劳疾，传尸瘦疾，主辟邪气，逐鬼。"}]},{"ID":"20240613110341-y3swvdy","Type":"NodeParagraph","Properties":{"id":"20240613110341-y3swvdy","updated":"20240613110341"},"Children":[{"Type":"NodeText","Data":"图经曰∶鬼臼，生九真山谷及冤句，今江宁府、滁、舒、商、齐、杭、襄、峡州、荆门军亦有之，多生深山岩石之阴。叶似蓖麻、重楼辈。初生一茎，茎端一叶，亦有两歧者，年长一茎，茎枯为一臼，二十年则二十臼也。花生茎间，赤色，三月开，后结实。根、肉、皮、须并似射干，俗用皆是射干，当细别之。七月、八月采根，曝干用。古方治五尸，鬼疰，百毒，恶气方用之。一说鬼臼生深山阴地，叶六出或五出，如雁掌。茎端一叶如伞，盖旦时东向，及暮则西倾，盖随日出没也。花红紫如荔枝，正在叶下，常为叶所蔽，未常见日。一年生一叶，既枯则为一臼，及八、九年则八、九臼矣。然一年一臼生而一臼腐，盖陈新相易也，故俗又名曰害母草。如芋魁、乌头辈亦然。新苗生则旧苗死，前年之魁腐矣。而本草注谓全似射干，今射干体状虽相似，然臼形浅溥，大异鬼臼。鬼臼如八、九天南星侧比相叠，而色理正如射干。要者，当使人求苗采之，市中不复有也。"}]},{"ID":"20240613110328-2ffk1by","Type":"NodeThematicBreak","Properties":{"id":"20240613110328-2ffk1by"}},{"ID":"20240613110329-c05u44s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110329-c05u44s","updated":"20240613110334"},"Children":[{"Type":"NodeText","Data":"鬼臼《神农本草经赞》"}]},{"ID":"20240613110329-e0z8x1g","Type":"NodeParagraph","Properties":{"id":"20240613110329-e0z8x1g","updated":"20240613110329"},"Children":[{"Type":"NodeText","Data":"味辛温。主杀蛊毒。鬼注精物。辟恶气不祥。逐邪。解百毒。一名爵犀。一名马目毒公。一名九臼。生山谷。"}]},{"ID":"20240613110329-ln5q2k5","Type":"NodeParagraph","Properties":{"id":"20240613110329-ln5q2k5","updated":"20240613110329"},"Children":[{"Type":"NodeText","Data":"羞寒自蔽。八角灵奇。面青背赤。东向西垂。繁星侧比。巨眼斜窥。琼田芝熟。三臼忘饥。"}]},{"ID":"20240613110329-5g57uto","Type":"NodeParagraph","Properties":{"id":"20240613110329-5g57uto","updated":"20240613110329"},"Children":[{"Type":"NodeText","Data":"益都方物略记。根茎缀花蔽叶。自隐名为羞寒花。李时珍曰。丹炉家采根制汞。其叶八角者最灵。高启诗。灵奇务穷搜。丹房鉴源。茎端生叶。面青背赤。苏颂曰。一叶如伞。旦时东向。及暮则西倾随日出没也。根如南星。八九枚侧比相叠。陶弘景曰。根白处如马眼而柔。"}]},{"ID":"20240613110329-rn6rnp2","Type":"NodeParagraph","Properties":{"id":"20240613110329-rn6rnp2","updated":"20240613110329"},"Children":[{"Type":"NodeText","Data":"润山谷诗注。玉芝一名琼田草。即鬼臼。煮面皮。裹一臼吞之。数日不饥。啖三臼可辟谷也。"}]},{"ID":"20240613110103-91dg5h1","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-91dg5h1"}},{"ID":"20240613110309-304lhdy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110309-304lhdy","updated":"20240613110313"},"Children":[{"Type":"NodeText","Data":"鬼臼《千金翼方》"}]},{"ID":"20240613110309-6lbczcf","Type":"NodeParagraph","Properties":{"id":"20240613110309-6lbczcf","updated":"20240613110309"},"Children":[{"Type":"NodeText","Data":"味辛，温，微温。有毒。主杀蛊毒，鬼疰精物，辟恶气不祥，逐邪，解百毒。疗喉结，风邪，烦惑，失魄妄见，去目中肤翳。杀大毒，不入汤。一名爵犀，一名马目毒公一名九臼，一名天臼，一名解毒。生九真山谷及冤句，二月八月采根。"}]},{"ID":"20240613110103-qyeeigp","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-qyeeigp"}},{"ID":"20240613110300-p6amxpc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110300-p6amxpc","updated":"20240613110304"},"Children":[{"Type":"NodeText","Data":"鬼臼《本经逢原》"}]},{"ID":"20240613110300-60sxh3q","Type":"NodeParagraph","Properties":{"id":"20240613110300-60sxh3q","updated":"20240613110300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名九臼，一名天臼，一名马目毒公，又有术律草、害母草、独脚莲、羞"}]},{"ID":"20240613110300-0y3a1a1","Type":"NodeParagraph","Properties":{"id":"20240613110300-0y3a1a1","updated":"20240613110300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天花、琼田草、山荷叶、八角盘、唐婆镜、鬼药、爵犀、解毒等名"}]},{"ID":"20240613110300-tp0k2b3","Type":"NodeParagraph","Properties":{"id":"20240613110300-tp0k2b3","updated":"20240613110300"},"Children":[{"Type":"NodeText","Data":"辛温，有毒。"}]},{"ID":"20240613110300-ollkysj","Type":"NodeParagraph","Properties":{"id":"20240613110300-ollkysj","updated":"20240613110300"},"Children":[{"Type":"NodeText","Data":"《本经》杀虫毒鬼疰精物，辟恶气不祥，逐邪解百毒。"}]},{"ID":"20240613110300-tf1s6te","Type":"NodeParagraph","Properties":{"id":"20240613110300-tf1s6te","updated":"20240613110300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"鬼臼辛温，以毒攻毒之猛药，《本经》杀鬼疰虫毒，辟恶逐邪，宁无顾名思实之意。其治邪痈阴疽蛇毒用之。《良方》一字神散，治子死腹中，无灰酒下一钱立效。射工中人寒热发疮，鬼臼叶一握，苦酒捣汁服一升，日二次效。"}]},{"ID":"20240613110103-43163s6","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-43163s6"}},{"ID":"20240613110243-1pd9tnj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110243-1pd9tnj","updated":"20240613110248"},"Children":[{"Type":"NodeText","Data":"鬼臼《医学入门》"}]},{"ID":"20240613110243-isrxdh4","Type":"NodeParagraph","Properties":{"id":"20240613110243-isrxdh4","updated":"20240613110243"},"Children":[{"Type":"NodeText","Data":"生深山岩谷之阴。叶似蓖麻，初生一茎，茎端一叶两歧，年长一茎，茎枯为一臼，二十年则二十臼也。三月开赤花，开后结实。根似射干。八月采根，日干。味辛，温，有毒。主蛊毒鬼疰精物，辟邪恶，解百毒，治传尸劳瘦，止咳嗽喉结，去目中肤翳。不入汤药。"}]},{"ID":"20240613110103-itbsjdq","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-itbsjdq"}},{"ID":"20240613110140-qk3cc8j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110140-qk3cc8j","updated":"20240613110148"},"Children":[{"Type":"NodeText","Data":"鬼臼《本草图经》"}]},{"ID":"20240613110140-pxnivyb","Type":"NodeParagraph","Properties":{"id":"20240613110140-pxnivyb","updated":"20240613110143"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"鬼臼"},{"Type":"NodeText","Data":"，生九真山谷及冤句，今江宁府、滁、舒、商、齐、杭、襄、峡州、荆门军亦有之，多生深山岩石之阴。叶似蓖麻、重楼辈；初生一茎，茎端一叶，亦有两歧者，年长一茎，茎枯为一臼，二十年则二十臼也；花生茎间，赤色，三月开，后结实，根肉皮须，并似射干，俗用皆是射干，当细别之。七月、八月采根，曝干用。古方治五尸、鬼疰、百毒、恶气方用之。一说鬼臼生深山阴地，叶六出或五出，如雁掌。茎端一叶如伞，盖旦时东向，及暮则西倾，盖随日出没也。花红紫如荔枝，正在叶下，常为叶所蔽，未常见日。一年生一叶，既枯则为一臼，及八、九年则八、九臼矣。然一年一臼生而臼腐，盖陈新相易也，故俗又名曰害母草。如芋魁、乌头辈亦然。新苗生则旧苗死，前年之魁腐矣。而本草注谓全似射干，今射干体状虽相似，然臼形浅薄，大异鬼臼。鬼臼如八、九天南星侧比相叠，而色理正如射干。要者，当使人求苗采之，市中不复有也。"}]},{"ID":"20240613110103-shp27go","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-shp27go"}},{"ID":"20240613110131-nw3k6pn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110131-nw3k6pn","updated":"20240613110134"},"Children":[{"Type":"NodeText","Data":"鬼臼《本草纲目》"}]},{"ID":"20240613110131-i7yqg24","Type":"NodeParagraph","Properties":{"id":"20240613110131-i7yqg24","updated":"20240613110131"},"Children":[{"Type":"NodeText","Data":"「释名」九说、天说、鬼药、解毒、爵犀、马目毒公、害母草、羞天花、术律草、枸田草、独脚莲、独荷草、山荷叶、旱荷、八角盘、唐婆镜。"}]},{"ID":"20240613110131-1r3dht1","Type":"NodeParagraph","Properties":{"id":"20240613110131-1r3dht1","updated":"20240613110131"},"Children":[{"Type":"NodeText","Data":"「气味」（根）辛、温、有毒。"}]},{"ID":"20240613110131-8vvke08","Type":"NodeParagraph","Properties":{"id":"20240613110131-8vvke08","updated":"20240613110131"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240613110131-6wip133","Type":"NodeParagraph","Properties":{"id":"20240613110131-6wip133","updated":"20240613110131"},"Children":[{"Type":"NodeText","Data":"1、子死腹中（胞破不生）。用鬼臼不拘多少，研为末。每服一钱，加酒一碗，煎至八成，一次服下，死胎即出。此方名“一字神散”。非常有效。"}]},{"ID":"20240613110131-qgf2tnw","Type":"NodeParagraph","Properties":{"id":"20240613110131-qgf2tnw","updated":"20240613110131"},"Children":[{"Type":"NodeText","Data":"2、发寒发热，身上长疮，古代迷信，说这是鬼怪作祟，称为“射工中人”。用鬼臼叶一把泡苦酒中，捣取汁，每服一升，一天服两次。"}]},{"ID":"20240613110103-fvwxzna","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-fvwxzna"}},{"ID":"20240613110120-kfyl5vj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613110120-kfyl5vj","updated":"20240613110125"},"Children":[{"Type":"NodeText","Data":"鬼臼《本草经集注》"}]},{"ID":"20240613110120-k8d9g7i","Type":"NodeParagraph","Properties":{"id":"20240613110120-k8d9g7i","updated":"20240613110120"},"Children":[{"Type":"NodeText","Data":"味辛，温、微温，有毒。主杀蛊毒，鬼疰，精物，辟恶气不祥，逐邪，解百毒。治咳嗽喉结，风邪烦惑，失魄妄见，去目中肤翳，杀大毒，不入汤。一名爵犀，一名马目毒公，一名九臼，一名天臼，一名解毒。生九真山谷及宛朐。二月、八月采根。（畏垣衣）"}]},{"ID":"20240613110120-kfm44jr","Type":"NodeParagraph","Properties":{"id":"20240613110120-kfm44jr","updated":"20240613110120"},"Children":[{"Type":"NodeText","Data":"鬼臼如射干，白而味甘，温，有毒。治风邪鬼疰蛊毒。九臼相连，有毛者良，一名九臼。"}]},{"ID":"20240613110120-ps0i75d","Type":"NodeParagraph","Properties":{"id":"20240613110120-ps0i75d","updated":"20240613110120"},"Children":[{"Type":"NodeText","Data":"生山谷，八月采，阴干。又似钩吻。今马目毒公如黄精，根臼处似马眼而柔润；鬼臼似射干、术辈。有两种∶出钱塘、近道者，味甘，上有丛毛，最胜；出会稽、吴兴者，乃大，味苦，无丛毛，不如，略乃相似而乖异毒公。今方家多用鬼臼，少用毒公，不知此那复顿尔乖越也。"}]},{"ID":"20240613110103-lxayrbv","Type":"NodeThematicBreak","Properties":{"id":"20240613110103-lxayrbv"}},{"ID":"20240613110104-rpzn807","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20240613110104-rpzn807","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"鬼臼"}]},{"ID":"20240613110104-ksp320j","Type":"NodeParagraph","Properties":{"id":"20240613110104-ksp320j","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613110104-6tkdxey","Type":"NodeParagraph","Properties":{"id":"20240613110104-6tkdxey","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" Guǐ Jiù"}]},{"ID":"20240613110104-nstqzjy","Type":"NodeParagraph","Properties":{"id":"20240613110104-nstqzjy","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613110104-cg0i1vr","Type":"NodeParagraph","Properties":{"id":"20240613110104-cg0i1vr","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 爵犀、马目毒公、九臼（《本经》），天臼、马目公、解毒（《吴普本草》），术律草（《丹房鉴源》），羞天花、羞寒花（《益部方物略记》），害母草（《本草图经》），八角盘（《通志》），独脚莲、独荷草（《土宿本草》），旱荷（《庚辛玉册》），山荷叶、八角镜（《纲目》），金星八角、独叶一枝花（汪连仕《采药书》），千斤锤（《福建中草药》），一碗水、江边一碗水、独荷莲（《中草药土方土法战备专辑》），独角莲（《中国高等植物图鉴》），八角乌（《药学学报》）。"}]},{"ID":"20240613110104-cnbk7zq","Type":"NodeParagraph","Properties":{"id":"20240613110104-cnbk7zq","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613110104-czhq662","Type":"NodeParagraph","Properties":{"id":"20240613110104-czhq662","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613110104-898mbmu","Type":"NodeParagraph","Properties":{"id":"20240613110104-898mbmu","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613110104-wzas2an","Type":"NodeParagraph","Properties":{"id":"20240613110104-wzas2an","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 为小檗科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"八角莲"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根茎"},{"Type":"NodeText","Data":"。秋季采挖。"}]},{"ID":"20240613110104-pu8mhad","Type":"NodeParagraph","Properties":{"id":"20240613110104-pu8mhad","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613110104-n7hbtr7","Type":"NodeParagraph","Properties":{"id":"20240613110104-n7hbtr7","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 生于山坡、林下等阴湿处。分布长江流域各省。"}]},{"ID":"20240613110104-nx2whjj","Type":"NodeParagraph","Properties":{"id":"20240613110104-nx2whjj","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613110104-wkqekgx","Type":"NodeParagraph","Properties":{"id":"20240613110104-wkqekgx","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 多年生草本。根茎横卧，棕褐色，木质化，具粗壮的须状根。茎直立，高30～50厘米。茎生叶1，有时2，分别着生于茎的近顶处和茎的中部；叶片盾状，圆形，直径达30～40厘米，5～9裂，裂片卵状矩圆形，长5～8厘米，宽5～7厘米，先端锐尖，下面疏生柔毛或无毛，边缘有针刺状细齿；叶柄长10～15厘米。伞形花序，花8～10，生于茎顶一叶的叶柄基部，下垂；萼片6，椭圆形，外面有疏长毛；花瓣6，2轮，长2厘米，深红色；雄蕊6，花丝开张，花药内向：子房上位，1室，柱头大，盾状。浆果椭圆形或卵形。种子多数。花期初夏。"}]},{"ID":"20240613110104-o0iknt8","Type":"NodeParagraph","Properties":{"id":"20240613110104-o0iknt8","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613110104-ernp1ov","Type":"NodeParagraph","Properties":{"id":"20240613110104-ernp1ov","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 根和根茎含4.2％醇溶性树脂，中含鬼臼毒素约15％，去氢鬼臼毒素约0.33％，又含山柰酚。"}]},{"ID":"20240613110104-jjg4yoi","Type":"NodeParagraph","Properties":{"id":"20240613110104-jjg4yoi","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613110104-kh6lhn8","Type":"NodeParagraph","Properties":{"id":"20240613110104-kh6lhn8","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 苦辛，平。"}]},{"ID":"20240613110104-c4lepwo","Type":"NodeParagraph","Properties":{"id":"20240613110104-c4lepwo","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味辛，温。\""}]},{"ID":"20240613110104-9zf8chk","Type":"NodeParagraph","Properties":{"id":"20240613110104-9zf8chk","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"微温，有毒。\""}]},{"ID":"20240613110104-tnhqsbd","Type":"NodeParagraph","Properties":{"id":"20240613110104-tnhqsbd","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"③陶弘景：\"味甘，温，有毒。\""}]},{"ID":"20240613110104-r5me8vl","Type":"NodeParagraph","Properties":{"id":"20240613110104-r5me8vl","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"④《药性论》：\"味苦。\""}]},{"ID":"20240613110104-urfdezr","Type":"NodeParagraph","Properties":{"id":"20240613110104-urfdezr","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613110104-7edq91d","Type":"NodeParagraph","Properties":{"id":"20240613110104-7edq91d","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" ①《本草经集庄》：\"畏垣衣。\""}]},{"ID":"20240613110104-1g9fmws","Type":"NodeParagraph","Properties":{"id":"20240613110104-1g9fmws","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"②《本草经疏》：\"凡病属阳，阳盛热极及烦惑、失魂妄见者不可用。\""}]},{"ID":"20240613110104-t11as45","Type":"NodeParagraph","Properties":{"id":"20240613110104-t11as45","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"③《福建中草药》：\"孕妇忌服。\""}]},{"ID":"20240613110104-v4wtfvl","Type":"NodeParagraph","Properties":{"id":"20240613110104-v4wtfvl","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613110104-727had4","Type":"NodeParagraph","Properties":{"id":"20240613110104-727had4","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 祛痰散结，解毒祛瘀。治痨伤，咳嗽，吐血，胃痛，瘿瘤，瘰疬，痈肿，疔疮，跌打，蛇伤。"}]},{"ID":"20240613110104-dyc1cg3","Type":"NodeParagraph","Properties":{"id":"20240613110104-dyc1cg3","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主杀蛊毒，辟恶气，逐邪解百毒。\""}]},{"ID":"20240613110104-eren3ss","Type":"NodeParagraph","Properties":{"id":"20240613110104-eren3ss","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗咳嗽喉结，风邪烦惑，失魄妄见，去目中肤翳，杀大毒。不入汤。\""}]},{"ID":"20240613110104-k33otpn","Type":"NodeParagraph","Properties":{"id":"20240613110104-k33otpn","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"主劳疾。\""}]},{"ID":"20240613110104-cz79ka2","Type":"NodeParagraph","Properties":{"id":"20240613110104-cz79ka2","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"④《纲目》：\"下死胎，治疟邪，痈疽，蛇毒，射工毒。\""}]},{"ID":"20240613110104-bcmfkvy","Type":"NodeParagraph","Properties":{"id":"20240613110104-bcmfkvy","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑤汪连仕《采药书》：\"消一切毒，力能软坚透脓。\""}]},{"ID":"20240613110104-dmh7aoz","Type":"NodeParagraph","Properties":{"id":"20240613110104-dmh7aoz","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑥《福建中草药》：\"降气祛痰，散结消肿。\""}]},{"ID":"20240613110104-xlbo9k4","Type":"NodeParagraph","Properties":{"id":"20240613110104-xlbo9k4","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑦《中草药土方土法战备专辑》：\"祛瘀，散结，解毒。\""}]},{"ID":"20240613110104-ehmfejy","Type":"NodeParagraph","Properties":{"id":"20240613110104-ehmfejy","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613110104-aiyjs4t","Type":"NodeParagraph","Properties":{"id":"20240613110104-aiyjs4t","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1～3钱；磨汁或入丸、散。外用：磨汁涂、捣敷或研末调敷。"}]},{"ID":"20240613110104-aj83k5g","Type":"NodeParagraph","Properties":{"id":"20240613110104-aj83k5g","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613110104-xqkjtmf","Type":"NodeParagraph","Properties":{"id":"20240613110104-xqkjtmf","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" ①治胃痛：八角莲根茎，泡酒服或嚼服，每服一钱。（《中草药土方土法战备专辑》）"}]},{"ID":"20240613110104-rpsv4nt","Type":"NodeParagraph","Properties":{"id":"20240613110104-rpsv4nt","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"②治瘿瘤：鬼臼（切片，姜汁浸）、海藻、昆布、海带（俱用热水洗净）、海粉（水飞过）、海螵蛸各二两，甘草一两，海螺一个（火烧醋炙，如颈下摇者用长螺，颈不摇者用圆螺）。共为极细末，炼蜜丸如梧子大。每晚临睡时，口中噙化一丸。（《海上方》）"}]},{"ID":"20240613110104-3zz4p1b","Type":"NodeParagraph","Properties":{"id":"20240613110104-3zz4p1b","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"③治瘰疬：鬼臼根研末，醋调敷患处。（《湖南药物志》）"}]},{"ID":"20240613110104-v7qwik2","Type":"NodeParagraph","Properties":{"id":"20240613110104-v7qwik2","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"④治瘰疬：鲜鬼臼根茎一两，水煎服；渣捣烂敷患处。（《福建中草药》）"}]},{"ID":"20240613110104-35y3ox6","Type":"NodeParagraph","Properties":{"id":"20240613110104-35y3ox6","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑤治疔肿痈疽：鬼臼根，醋酒磨涂；叶贴，能消痈肿。（《纲目拾遗》）"}]},{"ID":"20240613110104-b06hf13","Type":"NodeParagraph","Properties":{"id":"20240613110104-b06hf13","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑥治蛇咬：独叶一枝花根。口嚼搽疮上。（《祝穆试效方》）"}]},{"ID":"20240613110104-1512brl","Type":"NodeParagraph","Properties":{"id":"20240613110104-1512brl","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑦治蛇虫咬伤：鲜八角莲适量，捣烂外敷；或内服，每服二钱，水煎服。（《中草药土方土法战备专辑》）"}]},{"ID":"20240613110104-48xnv4v","Type":"NodeParagraph","Properties":{"id":"20240613110104-48xnv4v","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑧治跌打损伤，筋骨疼痛，劳伤：八角莲根一至三钱。研细末，用酒送服，每日两次；或泡酒服。（《中草药土方土法战备专辑》）"}]},{"ID":"20240613110104-5aax4sv","Type":"NodeParagraph","Properties":{"id":"20240613110104-5aax4sv","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"⑨治气血痰饮，积胀成蛊：鬼臼一斤（切片），生姜二两，白矾五钱。泡汤浸二日，再用酒煮，捣烂成膏；巴豆肉三钱（去油），沉香五钱，蟾酥五钱，俱为末，和入为丸，如黍米大每早晚各服二、三十丸，白汤送下。（《本草汇言》）"}]},{"ID":"20240613110104-rho0ukq","Type":"NodeParagraph","Properties":{"id":"20240613110104-rho0ukq","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613110104-qsgq1k1","Type":"NodeParagraph","Properties":{"id":"20240613110104-qsgq1k1","updated":"20240613110104"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613110105-z601dt7","Type":"NodeThematicBreak","Properties":{"id":"20240613110105-z601dt7"}},{"ID":"20240613110106-k2gxma7","Type":"NodeParagraph","Properties":{"id":"20240613110106-k2gxma7","updated":"20240613110108"}}]}