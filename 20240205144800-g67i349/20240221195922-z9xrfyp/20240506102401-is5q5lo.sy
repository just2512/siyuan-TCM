{"ID":"20240506102401-is5q5lo","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102401-is5q5lo","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102401-is5q5lo\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506102401-kmgd9kb\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613110106-k2gxma7\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240613110341-ncpi6xm\u0026quot;,\u0026quot;focusStart\u0026quot;:8,\u0026quot;focusEnd\u0026quot;:8\u0026#125;","title":"299鬼臼（六角莲、八角莲）","type":"doc","updated":"20240823170150"},"Children":[{"ID":"20240701125406-ylbkoij","Type":"NodeParagraph","Properties":{"id":"20240701125406-ylbkoij","updated":"20240701125409"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鬼臼2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鬼臼2-20240701125406-r3k3a3e.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240701125159-a0xo822","Type":"NodeParagraph","Properties":{"id":"20240701125159-a0xo822","updated":"20240701131052"},"Children":[{"Type":"NodeText","Data":"​​"}]},{"ID":"20240613110103-e5ri5dj","Type":"NodeParagraph","Properties":{"id":"20240613110103-e5ri5dj","updated":"20240701130533"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"六角莲 "}]},{"ID":"20240701131054-b72u2hj","Type":"NodeParagraph","Properties":{"id":"20240701131054-b72u2hj","updated":"20240823165117"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 362px;","style":"width: 352px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240701125540-nqmvvip.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 352px;\" parent-style=\"width: 362px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823165158-55ff17k","Type":"NodeParagraph","Properties":{"id":"20240823165158-55ff17k","updated":"20240823170135"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 621px;","style":"width: 611px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"六角莲"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/六角莲-20240823165158-tluwb58.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 611px;\" parent-style=\"width: 621px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 577px;","style":"width: 567px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"六角莲"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/六角莲-20240701131756-dz8kfro.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 567px;\" parent-style=\"width: 577px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823170148-5k0opo4","Type":"NodeParagraph","Properties":{"id":"20240823170148-5k0opo4","updated":"20240823170148"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 611px;","style":"width: 601px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"六角莲 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/六角莲 4-20240823170014-xegx0he.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 601px;\" parent-style=\"width: 611px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span