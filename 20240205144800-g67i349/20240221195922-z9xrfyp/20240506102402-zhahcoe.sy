{"ID":"20240506102402-zhahcoe","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102402-zhahcoe","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102402-zhahcoe\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240628105021-jaaevqs\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240612184826-cl5dne3\u0026quot;,\u0026quot;scrollTop\u0026quot;:0,\u0026quot;focusId\u0026quot;:\u0026quot;20240628105923-bg7ww2r\u0026quot;,\u0026quot;focusStart\u0026quot;:2,\u0026quot;focusEnd\u0026quot;:2\u0026#125;","title":"274草蒿（青蒿）","type":"doc","updated":"20240822171851"},"Children":[{"ID":"20240729153652-yrg8kuu","Type":"NodeParagraph","Properties":{"id":"20240729153652-yrg8kuu","updated":"20240729153652"},"Children":[{"Type":"NodeText","Data":"【产地】\t全国各地均产。\n【性状】\t茎圆柱形，上部多分枝，长3080cm，直径0.20.6cm，表面黄绿色或棕黄色，具纵棱线；质略硬，易折断，断面中部有髓。叶互生，暗绿色或棕绿色，卷缩，碎，完整者展平后为三回羽状深裂，裂片及小裂片矩圆形或长椭圆形，两面被短毛。气香特异，味微苦。\n【性味】\t苦、辛，寒。\n【功效】\t清透虚热，凉血除蒸，除蒸，截疟。用于暑邪发热，阴虚发热，夜热早凉，骨蒸劳热，疟疾寒热，湿热黄疸。"}]},{"ID":"20240729153652-aizpju7","Type":"NodeParagraph","Properties":{"id":"20240729153652-aizpju7","updated":"20240729153652"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206105427-1hhsnlm.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240729153652-cpw9p83","Type":"NodeParagraph","Properties":{"id":"20240729153652-cpw9p83","updated":"20240729153652"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青蒿"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青蒿-20240205155859-qljl8cl.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628105021-jaaevqs","Type":"NodeParagraph","Properties":{"id":"20240628105021-jaaevqs","updated":"20240628105021"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628105021-mwdu7ea.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20240628105311-iglawyp","Type":"NodeParagraph","Properties":{"id":"20240628105311-iglawyp","updated":"20240628105316"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 502px;","style":"width: 492px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240628105311-ul6c2mk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 492px;\" parent-style=\"width: 502px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240822164514-87au2s3","Type":"NodeParagraph","Properties":{"id":"20240822164514-87au2s3","updated":"20240822164518"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 696px;","style":"width: 686px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"青蒿7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/青蒿7-20240628105923-b3qk1ya.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 686px;\" parent-style=\"width: 696px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 461px;","style":"width: 451px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"Nod