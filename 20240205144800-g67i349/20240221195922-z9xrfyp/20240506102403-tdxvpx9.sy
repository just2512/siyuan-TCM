x;\" parent-style=\"width: 591px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823151155-4b2zj9b","Type":"NodeParagraph","Properties":{"id":"20240823151155-4b2zj9b","updated":"20240823151155"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 808px;","style":"width: 798px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草 (5)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240629162053-gapdb9y.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 798px;\" parent-style=\"width: 808px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 448px;","style":"width: 438px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草8"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草8-20240629162925-qk5qpih.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 438px;\" parent-style=\"width: 448px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823150622-ev8dbyo","Type":"NodeParagraph","Properties":{"id":"20240823150622-ev8dbyo","updated":"20240823151122"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 597px;","style":"width: 587px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草 2-20240823150622-59ywzi2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 587px;\" parent-style=\"width: 597px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 631px;","style":"width: 621px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹤草芽"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹤草芽-20240823142958-vx7eid5.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 621px;\" parent-style=\"width: 631px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629162514-kj8nty5","Type":"NodeParagraph","Properties":{"id":"20240629162514-kj8nty5","updated":"20240823151120"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草-20240619171029-1c8zam7.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 622px;","style":"width: 612px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草 (4)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草 4-20240823151109-xv95m8k.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 612px;\" parent-style=\"width: 622px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823150641-4ur8wzr","Type":"NodeParagraph","Properties":{"id":"20240823150641-4ur8wzr","updated":"20240823150833"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 589px;","style":"width: 579px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草4-20240629162221-4w5mav8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 579px;\" parent-style=\"width: 589px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 502px;","style":"width: 492px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草 3-20240823150833-esdgyol.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 492px;\" parent-style=\"width: 502px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823142820-6wgdx63","Type":"NodeParagraph","Properties":{"id":"20240823142820-6wgdx63","updated":"20240823151016"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：仙鹤草的叶子一大一小间隔生长；"}]},{"ID":"20240613101456-skr99cq","Type":"NodeThematicBreak","Properties":{"id":"20240613101456-skr99cq"}},{"ID":"20240613101513-xu8he0d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101513-xu8he0d","updated":"20240613101518"},"Children":[{"Type":"NodeText","Data":"牙子《神农本草经》"}]},{"ID":"20240613101513-6jybcp5","Type":"NodeParagraph","Properties":{"id":"20240613101513-6jybcp5","updated":"20240613101513"},"Children":[{"Type":"NodeText","Data":"味苦寒。"}]},{"ID":"20240613101513-24f7d0n","Type":"NodeParagraph","Properties":{"id":"20240613101513-24f7d0n","updated":"20240613101513"},"Children":[{"Type":"NodeText","Data":"主邪气热气，疥搔，恶疡，创痔，去白虫。一名狼牙。生川谷。"}]},{"ID":"20240613101513-xmmircj","Type":"NodeParagraph","Properties":{"id":"20240613101513-xmmircj","updated":"20240613101513"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：狼牙一名支兰，一名狼齿，一名犬牙，一名抱子，神农黄帝苦有毒，桐君或咸，岐伯雷公扁鹊苦无毒，生冤句，叶青，根黄赤，六月七月华，八月实，黑，正月八月采根（《御览》）。"}]},{"ID":"20240613101513-k8z2fv7","Type":"NodeParagraph","Properties":{"id":"20240613101513-k8z2fv7","updated":"20240613101513"},"Children":[{"Type":"NodeText","Data":"《名医》曰：一名狼齿，一名狼子，一名犬牙，生淮南及冤句，八月采根，暴干。"}]},{"ID":"20240613101513-p75tk12","Type":"NodeParagraph","Properties":{"id":"20240613101513-p75tk12","updated":"20240613101513"},"Children":[{"Type":"NodeText","Data":"案《范子计然》云：狼牙出三辅，色白者善。"}]},{"ID":"20240613101524-urkma1h","Type":"NodeThematicBreak","Properties":{"id":"20240613101524-urkma1h"}},{"ID":"20240613101525-q1ljqyy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101525-q1ljqyy","updated":"20240613101533"},"Children":[{"Type":"NodeText","Data":"牙子《千金翼方》"}]},{"ID":"20240613101525-dt3u7lw","Type":"NodeParagraph","Properties":{"id":"20240613101525-dt3u7lw","updated":"20240613101525"},"Children":[{"Type":"NodeText","Data":"味苦酸，寒，有毒。主邪气热气，疥瘙恶疡疮痔，去白虫。一名野狼牙，一名野狼齿野狼子，一名犬牙。生淮南川谷及冤句，八月采根，曝干。中湿腐烂生衣者，杀人。"}]},{"ID":"20240613101721-b8lk8f1","Type":"NodeThematicBreak","Properties":{"id":"20240613101721-b8lk8f1"}},{"ID":"20240613101722-eqg65t7","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101722-eqg65t7","updated":"20240613101726"},"Children":[{"Type":"NodeText","Data":"牙子《本草图经》"}]},{"ID":"20240613101722-ikh4jbr","Type":"NodeParagraph","Properties":{"id":"20240613101722-ikh4jbr","updated":"20240613101729"},"Children":[{"Type":"NodeText","Data":"牙子，即野狼牙子，生淮南川谷及冤句。今江东京东州郡多有之。苗似蛇莓而浓大，深绿色；根黑色，若兽之齿牙，故以名之。三月、八月采根，日干。古方多用治蛇毒。其法取独茎野狼牙，捣，腊月猪脂和，以傅上，立瘥。又杨炎《南行方》云∶六月以前用叶，以后用根，生咀，以木叶裹之， 火炮令热用，熨疮上，冷，即止。张仲景治妇人阴疮，亦单用之。"}]},{"ID":"20240613101708-1dzywns","Type":"NodeThematicBreak","Properties":{"id":"20240613101708-1dzywns"}},{"ID":"20240613101709-fwaze7z","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101709-fwaze7z","updated":"20240613101716"},"Children":[{"Type":"NodeText","Data":"牙子《本草经集注》"}]},{"ID":"20240613101709-dq79yvt","Type":"NodeParagraph","Properties":{"id":"20240613101709-dq79yvt","updated":"20240613101709"},"Children":[{"Type":"NodeText","Data":"味苦、酸，寒，有毒。主治邪气，热气，疥瘙，恶疡疮痔，去白虫。一名野狼牙，一名野狼齿，一名野狼子，一名犬牙。生淮方川谷及宛朐。八月采根，曝干。中湿腐烂生衣者，杀人。"}]},{"ID":"20240613101709-98c7d0q","Type":"NodeParagraph","Properties":{"id":"20240613101709-98c7d0q","updated":"20240613101709"},"Children":[{"Type":"NodeText","Data":"（芜荑为之使，恶地榆、枣肌。）"}]},{"ID":"20240613101709-ga2gaf8","Type":"NodeParagraph","Properties":{"id":"20240613101709-ga2gaf8","updated":"20240613101709"},"Children":[{"Type":"NodeText","Data":"近道处处有，其根牙亦似兽之牙齿也。"}]},{"ID":"20240613101655-h479gk2","Type":"NodeThematicBreak","Properties":{"id":"20240613101655-h479gk2"}},{"ID":"20240613101635-ade8nhq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101635-ade8nhq","updated":"20240613101647"},"Children":[{"Type":"NodeText","Data":"牙子《神农本草经赞》"}]},{"ID":"20240613101635-wl4fq2r","Type":"NodeParagraph","Properties":{"id":"20240613101635-wl4fq2r","updated":"20240613101635"},"Children":[{"Type":"NodeText","Data":"味苦寒，主邪气，热气，疥搔，恶疡，创痔，去白虫，一名狼牙，生川谷。"}]},{"ID":"20240613101635-hk8l09i","Type":"NodeParagraph","Properties":{"id":"20240613101635-hk8l09i","updated":"20240613101635"},"Children":[{"Type":"NodeText","Data":"拟状蛇藨，因时分选，春夏叶舒，秋冬根卷，啮猛贪狼，喙森噬犬，腐湿生衣，㕮咀删翦。"}]},{"ID":"20240613101635-1ng0ixy","Type":"NodeParagraph","Properties":{"id":"20240613101635-1ng0ixy","updated":"20240613101635"},"Children":[{"Type":"NodeText","Data":"韩保升曰：苗似蛇莓而厚大。汪机曰：蛇莓，一名蛇藨。杨炎曰：治虫疮，六月以前采叶，以后用根生㕮咀。千金方：射工中人，冬取根，夏取叶，捣汁饮。名医曰：一名狼齿，一名狼子，中湿腐烂，生衣者杀人。吴普曰：一名犬牙。吕温状：删剪奇邪。"}]},{"ID":"20240613101456-k50rgeb","Type":"NodeThematicBreak","Properties":{"id":"20240613101456-k50rgeb"}},{"ID":"20240613101458-5e0nm0c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101458-5e0nm0c","updated":"20240613101502"},"Children":[{"Type":"NodeText","Data":"牙子《名医别录》"}]},{"ID":"20240613101458-1hprxpf","Type":"NodeParagraph","Properties":{"id":"20240613101458-1hprxpf","updated":"20240613101458"},"Children":[{"Type":"NodeText","Data":"味酸，有毒．一名野狼齿，一名野狼子，一名犬牙．生淮南及宛朐．八月采根，曝干．中腐烂生衣者，杀人．（芜荑为之使，恶地榆、枣肌．）"}]},{"ID":"20240613101458-yi54c4x","Type":"NodeParagraph","Properties":{"id":"20240613101458-yi54c4x","updated":"20240613101458"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶牙子，味苦，寒．主邪气热气，疥瘙恶疡疮痔，去白虫．一名野狼牙．生川谷．"}]},{"ID":"20240613101539-xngnxxd","Type":"NodeThematicBreak","Properties":{"id":"20240613101539-xngnxxd"}},{"ID":"20240613101400-xovjr2h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101400-xovjr2h","updated":"20240613101448"},"Children":[{"Type":"NodeText","Data":"牙子《新修本草》"}]},{"ID":"20240613101400-9zsjd4j","Type":"NodeParagraph","Properties":{"id":"20240613101400-9zsjd4j","updated":"20240613101400"},"Children":[{"Type":"NodeText","Data":"味苦、酸，寒，有毒。主邪气热气，疥瘙恶疡疮痔，去白虫。一名野狼牙，一名野狼齿，一名野狼子，一名犬牙。生淮方川谷及宛朐。八月采根，曝干。中湿腐烂生衣者，杀人。"}]},{"ID":"20240613101400-7s5l073","Type":"NodeParagraph","Properties":{"id":"20240613101400-7s5l073","updated":"20240613101400"},"Children":[{"Type":"NodeText","Data":"芜荑为之使，恶地榆、枣肌。近道处处有，其根牙亦似兽之牙齿也。"}]},{"ID":"20240613101353-eh93ll0","Type":"NodeThematicBreak","Properties":{"id":"20240613101353-eh93ll0"}},{"ID":"20240613101414-v7j44s2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101414-v7j44s2","updated":"20240613101422"},"Children":[{"Type":"NodeText","Data":"牙子《医学入门》"}]},{"ID":"20240613101414-p1izhfw","Type":"NodeParagraph","Properties":{"id":"20240613101414-p1izhfw","updated":"20240613101414"},"Children":[{"Type":"NodeText","Data":"其根芽似兽之牙齿。味酸，寒，有毒。主邪气热气，疥瘙恶疡，疮痔阴蚀，金疮蛇毒，水煎洗或捣敷之。杀寸白、腹脏一切虫，止赤白痢，水煎服之。八月采根，日干。中湿腐烂生衣者杀人。芜荑为使，恶地榆。"}]},{"ID":"20240613101415-odssqof","Type":"NodeThematicBreak","Properties":{"id":"20240613101415-odssqof"}},{"ID":"20240613101428-yilt9ql","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613101428-yilt9ql","updated":"20240613101433"},"Children":[{"Type":"NodeText","Data":"牙子《证类本草》"}]},{"ID":"20240613101428-gnof9do","Type":"NodeParagraph","Properties":{"id":"20240613101428-gnof9do","updated":"20240613101428"},"Children":[{"Type":"NodeText","Data":"味苦、酸，寒，有毒。主邪气热气，疥瘙恶疡，疮痔，去白虫。一名野狼牙，一名野狼齿，一名野狼子，一名犬牙。生淮南川谷及冤句。八月采根，曝干。中湿腐烂生衣者，杀人。（芜荑为之使，恶地榆、枣肌。）"}]},{"ID":"20240613101428-evnnk74","Type":"NodeParagraph","Properties":{"id":"20240613101428-evnnk74","updated":"20240613101428"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶近道处处有之，其根牙亦似根兽之牙齿也。臣禹锡等谨按蜀本图经云∶苗似蛇莓而浓大，深绿色。根萌芽若兽之牙。今所在有之。二月、三月采牙，日干。药性论云∶野狼牙，使，味苦，能治浮风瘙痒，杀寸白虫，煎汁洗恶疮。日华子云∶杀腹脏一切虫，止赤白痢，煎服。"}]},{"ID":"20240613101428-5g8rh69","Type":"NodeParagraph","Properties":{"id":"20240613101428-5g8rh69","updated":"20240613101428"},"Children":[{"Type":"NodeText","Data":"图经曰∶牙子，即野狼牙子。生淮南川谷及冤句，今江东、京东州郡多有之。苗似蛇莓而浓大，深绿色。根黑若兽之齿牙，故以名之。三月、八月采根，日干。古方多用治蛇毒。其法∶取独茎野狼牙捣，腊月猪脂和以敷上，立瘥。又杨炎《南行方》云∶六月以前用叶，以后用根，生咀，以木叶裹之， 火炮令热，用熨疮上，冷即止。张仲景治妇人阴疮亦单用之。"}]},{"ID":"20240613101428-m3mmjym","Type":"NodeParagraph","Properties":{"id":"20240613101428-m3mmjym","updated":"20240613101428"},"Children":[{"Type":"NodeText","Data":"圣惠方∶治阴疮洗方∶用野狼牙五两细锉，水五升煮至三升，温洗之。外台秘要∶范汪治寸白虫方∶野狼牙五两，捣末，蜜丸如麻子，宿不食，明旦以浆水下一合，服尽瘥。又方∶治金疮。野狼牙草茎叶熟捣敷贴之，兼止血。又方∶治妇人阴蚀，若中烂伤。野狼牙三两 咀，以水四升煮，去滓，纳苦酒如鸡子一杯。以绵濡汤沥患处，日四、五即愈。千金方∶治小儿阴疮，浓煮野狼牙草洗之。又治射工，即水弩子也。以野狼牙叶冬取根，捣令熟敷之。"}]},{"ID":"20240629160832-5ww3p44","Type":"NodeThematicBreak","Properties":{"id":"20240629160832-5ww3p44"}},{"ID":"20240629160833-qivsiwm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240629160833-qivsiwm","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"狼牙《本草纲目》"}]},{"ID":"20240629160833-oifr8fh","Type":"NodeParagraph","Properties":{"id":"20240629160833-oifr8fh","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"「释名」牙子、狼齿、狼子、犬牙、抱牙、支兰。"}]},{"ID":"20240629160833-9lj6q4m","Type":"NodeParagraph","Properties":{"id":"20240629160833-9lj6q4m","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"「气味」（根）苦、寒、无毒。"}]},{"ID":"20240629160833-sobze9v","Type":"NodeParagraph","Properties":{"id":"20240629160833-sobze9v","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240629160833-f1xrjgq","Type":"NodeParagraph","Properties":{"id":"20240629160833-f1xrjgq","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"1、刀伤。用狼牙草的茎、叶熟捣贴伤处。"}]},{"ID":"20240629160833-ffa1a8x","Type":"NodeParagraph","Properties":{"id":"20240629160833-ffa1a8x","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"2、尿血。用狼牙草（焙干）、蚌粉（炒）、槐花、百药煎，等分为末。每服三钱，空心服，淘米水调下。"}]},{"ID":"20240629160833-qan843z","Type":"NodeParagraph","Properties":{"id":"20240629160833-qan843z","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"3、寸白虫（按：即绦虫）等。用狼牙五两，研为末，加蜜做成丸子，如麻子大。服药前一天，禁食，次日清晨，服药一合，浆水送下。全剂服完，病即愈。"}]},{"ID":"20240629160833-dt39ene","Type":"NodeParagraph","Properties":{"id":"20240629160833-dt39ene","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"4、妇女阴痒。用狼牙二两、蛇床子三两，煎水热洗。"}]},{"ID":"20240629160833-3p702ui","Type":"NodeParagraph","Properties":{"id":"20240629160833-3p702ui","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"5、妇女阴蚀（阴部溃烂）。用狼牙三两，加不四升煎取半升，洗患处。一天四至五次。"}]},{"ID":"20240629160833-i63tmkp","Type":"NodeParagraph","Properties":{"id":"20240629160833-i63tmkp","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"6、停耳出汁。用狼牙研末，裹棉中，塞耳内。"}]},{"ID":"20240629160833-o8vmh1n","Type":"NodeParagraph","Properties":{"id":"20240629160833-o8vmh1n","updated":"20240629160833"},"Children":[{"Type":"NodeText","Data":"7、毒蛇伤螫。用狼牙根或叶捣烂，加猪油调匀涂搽。"}]},{"ID":"20240613101429-mcysebw","Type":"NodeThematicBreak","Properties":{"id":"20240613101429-mcysebw"}},{"ID":"20240629160811-vnwiffw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240629160811-vnwiffw","updated":"20240629160811"},"Children":[{"Type":"NodeText","Data":"狼牙《长沙药解》"}]},{"ID":"20240629160811-hf0pzyc","Type":"NodeParagraph","Properties":{"id":"20240629160811-hf0pzyc","updated":"20240629160811"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【本经】牙子。味苦寒。主邪气热气，疥搔，恶疡，创痔，去白虫。一名狼牙。生川谷。"}]},{"ID":"20240629160811-at5ze8x","Type":"NodeParagraph","Properties":{"id":"20240629160811-at5ze8x","updated":"20240629160811"},"Children":[{"Type":"NodeText","Data":"味苦，性寒，入足厥阴肝经。清乙木之郁热，疗女子之阴疮。"}]},{"ID":"20240629160811-3b9q8bv","Type":"NodeParagraph","Properties":{"id":"20240629160811-3b9q8bv","updated":"20240629160811"},"Children":[{"Type":"NodeText","Data":"《金匮》狼牙汤，狼牙三两，水四升，煮半升，以綿缠箸如茧，浸汤沥阴，日四。治妇人少阴脉滑而数，阴中生疮，蚀烂者。尺中候肾，尺脉滑数，是木郁于水而生下热，法当阴里生疮。温热蒸腐，故剥蚀而坏烂。狼牙清郁热而达乙木，止蚀烂而消痛痒也。"}]},{"ID":"20240629160811-1q2qqj7","Type":"NodeParagraph","Properties":{"id":"20240629160811-1q2qqj7","updated":"20240629160811"},"Children":[{"Type":"NodeText","Data":"狼牙草苦寒清利，专洗一切恶疮。其诸主治，止便血，住下痢，疗疮疡蚀烂，治疥癣瘙痒，女子阴痒，理虫疮发痒，杀寸白诸虫。"}]},{"ID":"20240629160811-gff2bsu","Type":"NodeThematicBreak","Properties":{"id":"20240629160811-gff2bsu","updated":"20240629160811"}},{"ID":"20240629160823-wppnrw4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240629160823-wppnrw4","updated":"20240629160823"},"Children":[{"Type":"NodeText","Data":"野狼牙《本经逢原》"}]},{"ID":"20240629160823-r2zys4o","Type":"NodeParagraph","Properties":{"id":"20240629160823-r2zys4o","updated":"20240629160823"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"《本经》名牙子"}]},{"ID":"20240629160823-e6gx1ig","Type":"NodeParagraph","Properties":{"id":"20240629160823-e6gx1ig","updated":"20240629160823"},"Children":[{"Type":"NodeText","Data":"苦辛寒，有毒。以其形似兽牙故名。白者良。中湿糜烂生衣者杀人。"}]},{"ID":"20240629160823-d5jfwqb","Type":"NodeParagraph","Properties":{"id":"20240629160823-d5jfwqb","updated":"20240629160823"},"Children":[{"Type":"NodeText","Data":"《本经》主邪气热气，疥瘙，恶疡疮痔，去白虫。"}]},{"ID":"20240629160823-yqqv7ds","Type":"NodeParagraph","Properties":{"id":"20240629160823-yqqv7ds","updated":"20240629160823"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发明"},{"Type":"NodeText","Data":"野狼牙较野狼毒之性稍缓，而所治亦相类。《金匮》九痛丸用野狼牙，《局方》用野狼毒。方用附子三两，野狼牙、人参、吴茱萸、干姜各一两，巴霜一钱，蜜丸梧子大，日服二三丸，治九种心痛，并卒中恶腹胀满。又连年积冷流注心胸痛，及冷冲上气，落马坠车，血疾，皆主之。《本经》治邪气热气，去白虫，益心痛多有属虫积者，故前方用之亦治恶疡疮痔。"}]},{"ID":"20240629160823-3ys7fzu","Type":"NodeParagraph","Properties":{"id":"20240629160823-3ys7fzu","updated":"20240629160823"},"Children":[{"Type":"NodeText","Data":"《金匮》、《外台》、《千金》并以煎洗阴疮蚀痒，捣汁治射工溪毒，《肘后》以之捣贴金疮，《外台》以之蜜丸，浆水服一丸，治寸白虫，皆取杀虫解毒之功也。"}]},{"ID":"20240629160823-zjok9w2","Type":"NodeThematicBreak","Properties":{"id":"20240629160823-zjok9w2","updated":"20240629160823"}},{"ID":"20240629160840-a5hr1s6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240629160840-a5hr1s6","updated":"20240629160840"},"Children":[{"Type":"NodeText","Data":"野狼牙《本草述钩元》"}]},{"ID":"20240629160840-fhbo42g","Type":"NodeParagraph","Properties":{"id":"20240629160840-fhbo42g","updated":"20240629160840"},"Children":[{"Type":"NodeText","Data":"所在有之。苗似蛇莓而浓大。深绿色。根黑。若兽之牙。三八月采根。晒干用。（保出建康及三辅。色白者善。（范计然）气味苦辛酸寒。有毒。芜荑为之使。恶地榆。主治邪气热气疥瘙。恶疡疮痔。去白虫。疗浮风瘙痒。煎汁洗恶疮。杀腹脏一切虫。止赤方书治金疮出血。小便溺血。心痛胃脘痛。属口食寒物于里者。同附子巴豆人参之类温利之。"}]},{"ID":"20240629160840-0tsgc9a","Type":"NodeParagraph","Properties":{"id":"20240629160840-0tsgc9a","updated":"20240629160840"},"Children":[{"Type":"NodeText","Data":"〔论〕方书治虫。多言五脏劳热之伤。夫劳热之伤。其本固气虚也。（气虚者寒也）以故劳瘙疡痔少阴。"}]},{"ID":"20240629160840-8wvsvkc","Type":"NodeThematicBreak","Properties":{"id":"20240629160840-8wvsvkc","updated":"20240629160840"}},{"ID":"20240629160848-1qox6zi","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240629160848-1qox6zi","updated":"20240629160848"},"Children":[{"Type":"NodeText","Data":"野狼牙根《本草崇原》"}]},{"ID":"20240629160848-zvvgg8d","Type":"NodeParagraph","Properties":{"id":"20240629160848-zvvgg8d","updated":"20240629160848"},"Children":[{"Type":"NodeText","Data":"气味苦寒，有毒。主治邪气热气，疥瘙恶疡，疮痔，去白虫。"}]},{"ID":"20240629160848-546oeuk","Type":"NodeParagraph","Properties":{"id":"20240629160848-546oeuk","updated":"20240629160848"},"Children":[{"Type":"NodeText","Data":"（野狼牙《本经》名牙子，《别录》名野狼齿，《吴普本草》名犬牙，又名抱牙。始出淮南川谷及冤句，今江东州郡所在有之，其根黑色，若兽之齿牙，故有诸名。）"}]},{"ID":"20240629160848-weg0qlr","Type":"NodeParagraph","Properties":{"id":"20240629160848-weg0qlr","updated":"20240629160848"},"Children":[{"Type":"NodeText","Data":"野狼性灵知，此草根如兽之齿牙，而专以野狼名者，疑取其上下灵通之义，寒水之气上行，则能散在表之邪气热气，以及皮肤之疥瘙恶疡。苦寒之气下泄，则能除在下之疮痔，以及在内之白虫。《金匮要略》曰∶少阴脉滑而数者，阴中即生疮，阴中蚀疮烂者，野狼牙汤洗之。此草气味苦寒，禀性纯阴，故能治少阳之火热疮烂也。"}]},{"ID":"20240629160848-niiaeng","Type":"NodeThematicBreak","Properties":{"id":"20240629160848-niiaeng","updated":"20240629160848"}}]}