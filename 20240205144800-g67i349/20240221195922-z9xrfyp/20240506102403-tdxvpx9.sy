{"ID":"20240506102403-tdxvpx9","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"true","id":"20240506102403-tdxvpx9","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102403-tdxvpx9\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240506102403-a4jv8c8\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613101430-w6be4vn\u0026quot;,\u0026quot;scrollTop\u0026quot;:1042,\u0026quot;focusId\u0026quot;:\u0026quot;20240613101722-ikh4jbr\u0026quot;,\u0026quot;focusStart\u0026quot;:100,\u0026quot;focusEnd\u0026quot;:100\u0026#125;","title":"292牙子（仙鹤草、狼牙、狼齿、狼牙子、野狼子、野狼牙根、鹤草芽）","type":"doc","updated":"20240823151311"},"Children":[{"ID":"20240629161138-4e7nzni","Type":"NodeParagraph","Properties":{"id":"20240629161138-4e7nzni","updated":"20240823143053"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"别名：狼牙、狼齿、狼牙子、仙鹤草、鹤草芽"}]},{"ID":"20240705162923-g8z48b2","Type":"NodeParagraph","Properties":{"id":"20240705162923-g8z48b2","updated":"20240705162923"},"Children":[{"Type":"NodeText","Data":"【产地】\t主产浙江、江苏等地。\n【性状】\t本品长50100cm，全体被白色柔毛，茎下部圆柱形，直径46mm，红棕色，上部方柱形，四面略凹陷，绿褐色，有纵沟及棱线，有节；体轻，质硬，易折断，断面中空。单数羽状复叶互生，暗绿色，皱缩卷曲；质脆，易碎；叶片有大小2种，相间生于叶轴上，顶端小叶较大，完整小叶片展平后呈卵形或长椭圆形，先端尖，基部楔形，边缘有锯齿；托叶2，抱茎，斜卵形。总状花序细长，花萼下部呈筒状，萼筒上部有钩刺，先端5裂，花瓣黄色。气微，味微苦。\n【性味】\t苦、涩，平。\n【功效】\t收敛止血，止痢，杀虫。广泛用于各种出血之证，例如：吐血、尿血、便血、崩漏、咯血、衄血，赤白痢疾，劳伤脱力，痈肿，跌打，创伤出血等证。"}]},{"ID":"20240705162923-0oic1jy","Type":"NodeParagraph","Properties":{"id":"20240705162923-0oic1jy","updated":"20240705162923"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240206105738-vtnbqnz.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705163113-l1qvmkb","Type":"NodeParagraph","Properties":{"id":"20240705163113-l1qvmkb","updated":"20240705163113"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 557px;","style":"width: 547px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草7"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草7-20240629162757-awaood2.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 547px;\" parent-style=\"width: 557px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240705162923-z00cpkw","Type":"NodeParagraph","Properties":{"id":"20240705162923-z00cpkw","updated":"20240705163127"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草-20240205162707-evq9vcf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823142516-43cb1hs","Type":"NodeParagraph","Properties":{"id":"20240823142516-43cb1hs","updated":"20240823142517"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 560px;","style":"width: 550px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240629162701-fw60kf2.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 550px;\" parent-style=\"width: 560px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629161308-oghqx69","Type":"NodeParagraph","Properties":{"id":"20240629161308-oghqx69","updated":"20240823151311"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 372px;","style":"width: 362px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"鹤草芽"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/鹤草芽-20240629161308-gbpp94a.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 362px;\" parent-style=\"width: 372px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 462px;","style":"width: 452px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草2-20240629161941-q09cb1o.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 452px;\" parent-style=\"width: 462px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 372px;","style":"width: 362px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20240629162015-x46jwpi.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 362px;\" parent-style=\"width: 372px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240629161829-fbycist","Type":"NodeParagraph","Properties":{"id":"20240629161829-fbycist","updated":"20240823151306"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 373px;","style":"width: 363px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"仙鹤草6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/仙鹤草6-20240629162330-3mocq3m.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 363px;\" parent-style=\"width: 373px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties