}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826093647-ql2wczc","Type":"NodeParagraph","Properties":{"id":"20240826093647-ql2wczc","updated":"20240826093657"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 724px;","style":"width: 714px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌韭 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌韭 1-20240826093647-hl9jnv6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 714px;\" parent-style=\"width: 724px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 545px;","style":"width: 535px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌韭6"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌韭6-20240701164111-2to68bf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 535px;\" parent-style=\"width: 545px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826093844-6ytnsbu","Type":"NodeParagraph","Properties":{"id":"20240826093844-6ytnsbu","updated":"20240826093934"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 688px;","style":"width: 678px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌韭 (2)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌韭 2-20240826093844-m872vs1.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 678px;\" parent-style=\"width: 688px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 665px;","style":"width: 655px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌韭 (3)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌韭 3-20240826093921-xjr877g.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 655px;\" parent-style=\"width: 665px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240826093417-abdbabl","Type":"NodeParagraph","Properties":{"id":"20240826093417-abdbabl","updated":"20240826093934"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 688px;","style":"width: 678px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"乌韭5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/乌韭5-20240701163733-z505nqp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 678px;\" parent-style=\"width: 688px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613112358-y4lsppa","Type":"NodeThematicBreak","Properties":{"id":"20240613112358-y4lsppa"}},{"ID":"20240613112506-rm7ev88","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112506-rm7ev88","updated":"20240613112510"},"Children":[{"Type":"NodeText","Data":"乌韭《神农本草经》"}]},{"ID":"20240613112506-f2mf5ds","Type":"NodeParagraph","Properties":{"id":"20240613112506-f2mf5ds","updated":"20240613112506"},"Children":[{"Type":"NodeText","Data":"味甘寒。"}]},{"ID":"20240613112506-c6m5epe","Type":"NodeParagraph","Properties":{"id":"20240613112506-c6m5epe","updated":"20240613112506"},"Children":[{"Type":"NodeText","Data":"主皮肤往来寒热，利小肠膀胱气。生山谷石上。"}]},{"ID":"20240613112506-b631o2i","Type":"NodeParagraph","Properties":{"id":"20240613112506-b631o2i","updated":"20240613112506"},"Children":[{"Type":"NodeText","Data":"案《广雅》云：昔邪，乌韭也，在屋曰昔邪，在墙曰垣衣。《西山经》云：萆荔，状如乌韭。《唐本》注云：即石衣也，亦名石苔，又名石发。按《广雅》又云：石发，石衣也，未知是一否。"}]},{"ID":"20240613112358-y27o8qi","Type":"NodeThematicBreak","Properties":{"id":"20240613112358-y27o8qi"}},{"ID":"20240613112400-2j13neb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112400-2j13neb","updated":"20240613112407"},"Children":[{"Type":"NodeText","Data":"乌韭《新修本草》"}]},{"ID":"20240613112400-ia898tv","Type":"NodeParagraph","Properties":{"id":"20240613112400-ia898tv","updated":"20240613112400"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主皮肤往来寒热，利小肠膀胱气。疗黄胆，金疮内塞，补中益气，好颜垣衣亦名乌韭，而为疗异，非是此种类也。"}]},{"ID":"20240613112400-9a6kq1g","Type":"NodeParagraph","Properties":{"id":"20240613112400-9a6kq1g","updated":"20240613112400"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此物，即石衣也，亦曰石苔，又名石发，生岩石阴不见日处，与卷柏相类也。"}]},{"ID":"20240613112401-ndmdzdk","Type":"NodeThematicBreak","Properties":{"id":"20240613112401-ndmdzdk"}},{"ID":"20240613112415-q5f4ojz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112415-q5f4ojz","updated":"20240613112421"},"Children":[{"Type":"NodeText","Data":"乌韭《本草经集注》"}]},{"ID":"20240613112415-6px3lte","Type":"NodeParagraph","Properties":{"id":"20240613112415-6px3lte","updated":"20240613112415"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主治皮肤往来寒热，利小肠膀胱气。治黄胆。金疮内塞，补中益气，好颜色。生山谷石上。"}]},{"ID":"20240613112415-gmddiox","Type":"NodeParagraph","Properties":{"id":"20240613112415-gmddiox","updated":"20240613112415"},"Children":[{"Type":"NodeText","Data":"垣衣亦名乌韭，而为治异，非是此种类也。"}]},{"ID":"20240613112416-ra9yesz","Type":"NodeThematicBreak","Properties":{"id":"20240613112416-ra9yesz"}},{"ID":"20240613112427-pp84x6e","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112427-pp84x6e","updated":"20240613112432"},"Children":[{"Type":"NodeText","Data":"乌韭《证类本草》"}]},{"ID":"20240613112427-n45w2sl","Type":"NodeParagraph","Properties":{"id":"20240613112427-n45w2sl","updated":"20240613112427"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主皮肤往来寒热，利小肠膀胱气。疗黄胆，金疮内塞，补中益气，好颜色。生山谷石上。"}]},{"ID":"20240613112427-czo6q88","Type":"NodeParagraph","Properties":{"id":"20240613112427-czo6q88","updated":"20240613112427"},"Children":[{"Type":"NodeText","Data":"陶隐居云∶垣衣亦名乌韭，而为疗异，非是此种类也。唐本注云∶此物即石衣也，亦曰石苔，又名石发。生岩石阴不见日处，与卷柏相类也。今按陈藏器本草云∶乌韭，烧灰沐发令黑，生大石及木间阴处，青翠茸茸者，似苔而非苔也。臣禹锡等谨按日华子云∶石衣，涩，冷，有毒。垣衣为使，烧灰沐头长发。此即是阴湿处山石上苔，长者可四、五寸，又名乌韭。"}]},{"ID":"20240613112427-ml1y5r1","Type":"NodeParagraph","Properties":{"id":"20240613112427-ml1y5r1","updated":"20240613112427"},"Children":[{"Type":"NodeText","Data":"苏云石苔非也。"}]},{"ID":"20240613112428-xxdbw8m","Type":"NodeThematicBreak","Properties":{"id":"20240613112428-xxdbw8m"}},{"ID":"20240613112436-rjfy7ve","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112436-rjfy7ve","updated":"20240613112441"},"Children":[{"Type":"NodeText","Data":"乌韭《名医别录》"}]},{"ID":"20240613112436-b8slcaw","Type":"NodeParagraph","Properties":{"id":"20240613112436-b8slcaw","updated":"20240613112436"},"Children":[{"Type":"NodeText","Data":"无毒．主治黄胆，金疮内塞，补中益气，好颜色．生石上．"}]},{"ID":"20240613112436-wx49oum","Type":"NodeParagraph","Properties":{"id":"20240613112436-wx49oum","updated":"20240613112436"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶乌韭，味甘，寒．主皮肤往来寒热，利小肠膀胱气．生山谷．"}]},{"ID":"20240613112436-waxo7nx","Type":"NodeThematicBreak","Properties":{"id":"20240613112436-waxo7nx"}},{"ID":"20240613112445-zgnwmxd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112445-zgnwmxd","updated":"20240613112450"},"Children":[{"Type":"NodeText","Data":"乌韭《千金翼方》"}]},{"ID":"20240613112445-ukt449r","Type":"NodeParagraph","Properties":{"id":"20240613112445-ukt449r","updated":"20240613112445"},"Children":[{"Type":"NodeText","Data":"味甘，寒，无毒。主皮肤往来寒热，利小肠膀胱气。疗黄胆，金疮内塞。补中益气，好颜色。生山谷石上。"}]},{"ID":"20240613112445-9dkjpgi","Type":"NodeThematicBreak","Properties":{"id":"20240613112445-9dkjpgi"}},{"ID":"20240613112454-p3ephxk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613112454-p3ephxk","updated":"20240613112500"},"Children":[{"Type":"NodeText","Data":"乌韭《神农本草经赞》"}]},{"ID":"20240613112454-idpx5ba","Type":"NodeParagraph","Properties":{"id":"20240613112454-idpx5ba","updated":"20240613112454"},"Children":[{"Type":"NodeText","Data":"味甘寒。主皮肤。往来寒热。利小肠膀胱气。生山谷石上。"}]},{"ID":"20240613112454-8bak5dq","Type":"NodeParagraph","Properties":{"id":"20240613112454-8bak5dq","updated":"20240613112454"},"Children":[{"Type":"NodeText","Data":"漠漠斑斑。石苔熏发。青幂毛衣。翠披卷发。养爱云阴。纹添雨歇。屋飘游。幽情超越。"}]},{"ID":"20240613112454-j129e88","Type":"NodeParagraph","Properties":{"id":"20240613112454-j129e88","updated":"20240613112454"},"Children":[{"Type":"NodeText","Data":"白居易诗。漠漠斑斑石上苔。临川志熏发而起。陈藏器曰。生大石及木阴处。青翠茸茸。"}]},{"ID":"20240613112454-j171lra","Type":"NodeParagraph","Properties":{"id":"20240613112454-j171lra","updated":"20240613112454"},"Children":[{"Type":"NodeText","Data":"日华子曰。一名石衣。苏恭曰。一名石发。苏子卿诗。丹水浴毛衣。诗。卷发如虿。苏轼诗。"}]},{"ID":"20240613112454-3tsch96","Type":"NodeParagraph","Properties":{"id":"20240613112454-3tsch96","updated":"20240613112454"},"Children":[{"Type":"NodeText","Data":"昨日云除重。李白诗。野凉疏雨歇。李时珍曰。乌韭是瓦松之生于石上者。与垣衣屋游同类。崔融赋。瓦松产于屋之上。钱起诗。幽步更超越。"}]},{"ID":"20240613112455-arli1dd","Type":"NodeThematicBreak","Properties":{"id":"20240613112455-arli1dd"}},{"ID":"20240613112456-p3acr7s","Type":"NodeParagraph","Properties":{"id":"20240613112456-p3acr7s"}}]}