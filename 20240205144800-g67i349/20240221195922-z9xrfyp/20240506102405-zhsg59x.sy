0510-016zc9y.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 550px;\" parent-style=\"width: 560px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240702095940-a6logyb","Type":"NodeParagraph","Properties":{"id":"20240702095940-a6logyb","updated":"20240826115034"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 585px;","style":"width: 575px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荩草4"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荩草4-20240702100306-3ck3bgv.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 575px;\" parent-style=\"width: 585px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 656px;","style":"width: 646px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荩草1"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荩草1-20240702095940-z39lzeb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 646px;\" parent-style=\"width: 656px;\"}"},{"Type":"NodeText","Data":"​​​​"}]},{"ID":"20240826114036-1aorjgp","Type":"NodeParagraph","Properties":{"id":"20240826114036-1aorjgp","updated":"20240826115035"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 559px;","style":"width: 549px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荩草 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荩草 1-20240826114036-jq1lovg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 549px;\" parent-style=\"width: 559px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 740px;","style":"width: 730px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"荩草3"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/荩草3-20240702100238-g5jwtjk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 730px;\" parent-style=\"width: 740px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240613114252-s5f3l6v","Type":"NodeThematicBreak","Properties":{"id":"20240613114252-s5f3l6v"}},{"ID":"20240613114257-hleacbu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114257-hleacbu","updated":"20240613114447"},"Children":[{"Type":"NodeText","Data":"荩草《神农本草经》"}]},{"ID":"20240613114453-1bb3drn","Type":"NodeParagraph","Properties":{"id":"20240613114453-1bb3drn","updated":"20240613114453"},"Children":[{"Type":"NodeText","Data":"味苦平。"}]},{"ID":"20240613114453-eolsnqm","Type":"NodeParagraph","Properties":{"id":"20240613114453-eolsnqm","updated":"20240613114453"},"Children":[{"Type":"NodeText","Data":"主久咳上气喘逆，久寒，惊悸，痂疥，白秃，疡气，杀皮肤小虫。生川谷。"}]},{"ID":"20240613114453-kr9lb9u","Type":"NodeParagraph","Properties":{"id":"20240613114453-kr9lb9u","updated":"20240613114453"},"Children":[{"Type":"NodeText","Data":"《吴普》曰：王刍一名黄草，神农雷公口，生太山山谷，治身热邪气，小儿身热气（《御览》）。"}]},{"ID":"20240613114453-ew3jo89","Type":"NodeParagraph","Properties":{"id":"20240613114453-ew3jo89","updated":"20240613114453"},"Children":[{"Type":"NodeText","Data":"《名医》曰：可以染黄，作金色，生青衣，九月十月采。"}]},{"ID":"20240613114453-qqrx9vo","Type":"NodeParagraph","Properties":{"id":"20240613114453-qqrx9vo","updated":"20240613114453"},"Children":[{"Type":"NodeText","Data":"案《说文》云：荩草也，（上艹下彖），王刍也。《尔雅》云：（上艹下彖），王刍。郭璞云：（上艹下彖），蓐也，今呼鸱脚莎。《毛诗》云：绿竹猗猗。《传》云：（上艹下彖），王刍也。《唐本》注云：荩草，俗名蓐草。《尔雅》所谓王刍。"}]},{"ID":"20240613114559-4epk27w","Type":"NodeThematicBreak","Properties":{"id":"20240613114559-4epk27w"}},{"ID":"20240613114600-ap1bvdp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114600-ap1bvdp","updated":"20240613114604"},"Children":[{"Type":"NodeText","Data":"荩草《新修本草》"}]},{"ID":"20240613114600-0sx23rl","Type":"NodeParagraph","Properties":{"id":"20240613114600-0sx23rl","updated":"20240613114600"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主久咳上气喘逆，久寒惊悸，痂疥白秃疡气，杀皮肤小虫。可以染黄作金色。生青衣川谷，九月、十月采。"}]},{"ID":"20240613114600-7gllupn","Type":"NodeParagraph","Properties":{"id":"20240613114600-7gllupn","updated":"20240613114600"},"Children":[{"Type":"NodeText","Data":"畏鼠妇。青衣在益州西。"}]},{"ID":"20240613114600-lb9g8pb","Type":"NodeParagraph","Properties":{"id":"20240613114600-lb9g8pb","updated":"20240613114600"},"Children":[{"Type":"NodeText","Data":"〔谨案〕此草叶似竹而细薄，茎亦圆小。生平泽溪涧之侧，荆襄人煮以染黄，色极鲜好。"}]},{"ID":"20240613114600-n2zehxh","Type":"NodeParagraph","Properties":{"id":"20240613114600-n2zehxh","updated":"20240613114600"},"Children":[{"Type":"NodeText","Data":"洗疮有效。俗名绿蓐草。《尔雅》云∶所谓王刍者也。"}]},{"ID":"20240613114659-6ajoppa","Type":"NodeThematicBreak","Properties":{"id":"20240613114659-6ajoppa"}},{"ID":"20240613114700-m55sieo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114700-m55sieo","updated":"20240613114705"},"Children":[{"Type":"NodeText","Data":"荩草《神农本草经赞》"}]},{"ID":"20240613114700-xc5mjo7","Type":"NodeParagraph","Properties":{"id":"20240613114700-xc5mjo7","updated":"20240613114700"},"Children":[{"Type":"NodeText","Data":"味苦平。主久咳。上气喘逆。久寒惊悸。痂疥。白秃。疡气。杀皮肤小虫。生川谷。"}]},{"ID":"20240613114700-54owdqx","Type":"NodeParagraph","Properties":{"id":"20240613114700-54owdqx","updated":"20240613114700"},"Children":[{"Type":"NodeText","Data":"王刍贡草。忠荩名垂。掬盈绿采。染变金姿。服垂绶。谷访青衣。莎呼鸱脚。竹误猗猗。"}]},{"ID":"20240613114700-60h7o4t","Type":"NodeParagraph","Properties":{"id":"20240613114700-60h7o4t","updated":"20240613114700"},"Children":[{"Type":"NodeText","Data":"尔雅。绿王刍。李时珍曰。古者贡草。入染人。故谓之王刍。而尽忠者。谓之荩臣也。"}]},{"ID":"20240613114700-07liluw","Type":"NodeParagraph","Properties":{"id":"20240613114700-07liluw","updated":"20240613114700"},"Children":[{"Type":"NodeText","Data":"诗。"}]},{"ID":"20240613114700-ipj51qr","Type":"NodeParagraph","Properties":{"id":"20240613114700-ipj51qr","updated":"20240613114700"},"Children":[{"Type":"NodeText","Data":"终朝采绿。不盈一掬即此。草本绿色可染黄。名医曰。染作金色。汉书注。诸侯绶。草似艾可染。因以名绶。苏恭曰。生青衣川谷。青衣县。在益州西。掌禹锡曰。即绿蓐草也。"}]},{"ID":"20240613114700-uwq4u56","Type":"NodeParagraph","Properties":{"id":"20240613114700-uwq4u56","updated":"20240613114700"},"Children":[{"Type":"NodeText","Data":"今呼为鸱脚莎。诗云。绿竹猗猗是也。资暇集。绿竹王刍也。今为辞赋。皆引猗猗。入竹事大误。"}]},{"ID":"20240613114649-niif826","Type":"NodeThematicBreak","Properties":{"id":"20240613114649-niif826"}},{"ID":"20240613114650-l7267jr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114650-l7267jr","updated":"20240613114654"},"Children":[{"Type":"NodeText","Data":"荩草《千金翼方》"}]},{"ID":"20240613114650-aw7ut5x","Type":"NodeParagraph","Properties":{"id":"20240613114650-aw7ut5x","updated":"20240613114650"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主久咳上气，喘逆久寒，惊悸痂疥，白秃疡气，杀皮肤小虫。可以染黄作金色。生青衣川谷，九月十月采。"}]},{"ID":"20240613114624-p6r7000","Type":"NodeThematicBreak","Properties":{"id":"20240613114624-p6r7000"}},{"ID":"20240613114625-xao1gvt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114625-xao1gvt","updated":"20240613114632"},"Children":[{"Type":"NodeText","Data":"荩草《医学入门》"}]},{"ID":"20240613114625-xogwdji","Type":"NodeParagraph","Properties":{"id":"20240613114625-xogwdji","updated":"20240613114625"},"Children":[{"Type":"NodeText","Data":"生溪涧侧。叶似竹而细薄，茎亦圆小。荆襄人煮以染黄色，甚鲜。《诗》云∶绿竹猗猗是也。味苦，平，无毒。主痂疥白秃，一切恶疮疡气，杀皮肤小虫。兼治咳喘上气，久寒惊悸。九月采，阴干。畏鼠妇。"}]},{"ID":"20240613114639-kmgmk0r","Type":"NodeThematicBreak","Properties":{"id":"20240613114639-kmgmk0r"}},{"ID":"20240613114640-bl816rh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114640-bl816rh","updated":"20240613114644"},"Children":[{"Type":"NodeText","Data":"荩草《名医别录》"}]},{"ID":"20240613114640-ndfos0p","Type":"NodeParagraph","Properties":{"id":"20240613114640-ndfos0p","updated":"20240613114640"},"Children":[{"Type":"NodeText","Data":"无毒．可以染黄作金色．生青衣．九月、十月采．（畏鼠妇．）"}]},{"ID":"20240613114640-zka477y","Type":"NodeParagraph","Properties":{"id":"20240613114640-zka477y","updated":"20240613114640"},"Children":[{"Type":"NodeText","Data":"《本经》原文∶荩草，味苦，平．主久咳上气喘逆，久寒惊悸，痂疥白秃疡气，杀皮肤小虫．生川谷．"}]},{"ID":"20240613114609-h4c03ae","Type":"NodeThematicBreak","Properties":{"id":"20240613114609-h4c03ae"}},{"ID":"20240613114610-5wfz1ci","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114610-5wfz1ci","updated":"20240613114614"},"Children":[{"Type":"NodeText","Data":"荩草《本草经集注》"}]},{"ID":"20240613114610-fxygkaf","Type":"NodeParagraph","Properties":{"id":"20240613114610-fxygkaf","updated":"20240613114610"},"Children":[{"Type":"NodeText","Data":"味苦，平，无毒。主治久咳上气喘逆，久寒惊悸，痂疥白秃疡气，杀皮肤小虫。可以染黄作金色。生青衣川谷，九月、十月采。（畏鼠妇。）"}]},{"ID":"20240613114610-2kaod7q","Type":"NodeParagraph","Properties":{"id":"20240613114610-2kaod7q","updated":"20240613114610"},"Children":[{"Type":"NodeText","Data":"青衣在益州西。"}]},{"ID":"20240613114319-h9odbni","Type":"NodeThematicBreak","Properties":{"id":"20240613114319-h9odbni"}},{"ID":"20240613114428-csj2ftu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114428-csj2ftu","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：荩草"}]},{"ID":"20240613114428-9n1k1ph","Type":"NodeParagraph","Properties":{"id":"20240613114428-9n1k1ph","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613114428-16cikyg","Type":"NodeParagraph","Properties":{"id":"20240613114428-16cikyg","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" Jìn Cǎo"}]},{"ID":"20240613114428-o1q1eid","Type":"NodeParagraph","Properties":{"id":"20240613114428-o1q1eid","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613114428-pu3gbrb","Type":"NodeParagraph","Properties":{"id":"20240613114428-pu3gbrb","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 绿竹、马耳草、马耳朵草、中亚荩草"}]},{"ID":"20240613114428-rtv83no","Type":"NodeParagraph","Properties":{"id":"20240613114428-rtv83no","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613114428-h8vcy6c","Type":"NodeParagraph","Properties":{"id":"20240613114428-h8vcy6c","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 禾本科"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荩草"},{"Type":"NodeText","Data":"Arthraxon hispidus （Thunb.）Makino var. centrasiaticus Honda，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。"}]},{"ID":"20240613114428-r8hm3oe","Type":"NodeParagraph","Properties":{"id":"20240613114428-r8hm3oe","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613114428-5wmsnkc","Type":"NodeParagraph","Properties":{"id":"20240613114428-5wmsnkc","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 全国各地。"}]},{"ID":"20240613114428-22gqsu6","Type":"NodeParagraph","Properties":{"id":"20240613114428-22gqsu6","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613114428-ioq10ao","Type":"NodeParagraph","Properties":{"id":"20240613114428-ioq10ao","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 含马耳草素arthraxin C"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"21"},{"Type":"NodeText","Data":"H"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"16"},{"Type":"NodeText","Data":"O"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"9"},{"Type":"NodeText","Data":"。"}]},{"ID":"20240613114428-9phpbwh","Type":"NodeParagraph","Properties":{"id":"20240613114428-9phpbwh","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613114428-6jws7uu","Type":"NodeParagraph","Properties":{"id":"20240613114428-6jws7uu","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 苦，平。"}]},{"ID":"20240613114428-wlys5y0","Type":"NodeParagraph","Properties":{"id":"20240613114428-wlys5y0","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613114428-sdzrv0l","Type":"NodeParagraph","Properties":{"id":"20240613114428-sdzrv0l","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 清热，降逆，止咳平喘，解毒，袪风湿。主治肝炎，久咳气喘，咽喉炎，口腔炎，鼻炎，淋巴腺炎，乳腺炎。外用治疥癣，皮肤瘙痒，痈疖。"}]},{"ID":"20240613114428-zrlj4mt","Type":"NodeParagraph","Properties":{"id":"20240613114428-zrlj4mt","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613114428-scfo59b","Type":"NodeParagraph","Properties":{"id":"20240613114428-scfo59b","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 0.5～1两，水煎服。外用荩草2两，水煎外洗。"}]},{"ID":"20240613114428-2msx771","Type":"NodeParagraph","Properties":{"id":"20240613114428-2msx771","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613114428-n42hn6o","Type":"NodeParagraph","Properties":{"id":"20240613114428-n42hn6o","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240613114428-h2ld2h3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114428-h2ld2h3","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：荩草"}]},{"ID":"20240613114428-mjezw13","Type":"NodeParagraph","Properties":{"id":"20240613114428-mjezw13","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613114428-0daglxe","Type":"NodeParagraph","Properties":{"id":"20240613114428-0daglxe","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" Jìn Cǎo"}]},{"ID":"20240613114428-16pyu30","Type":"NodeParagraph","Properties":{"id":"20240613114428-16pyu30","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613114428-3nd0f3d","Type":"NodeParagraph","Properties":{"id":"20240613114428-3nd0f3d","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 菉竹（《诗经》），王刍（《毛诗传》），黄草（《吴普本草》），蓐、鸱脚莎（《尔雅》郭璞注），菉蓐草（《唐本草》），细叶莠竹、毛竹（《广州植物志》），马耳草（《吉林中草药》）。"}]},{"ID":"20240613114428-pb7x6pq","Type":"NodeParagraph","Properties":{"id":"20240613114428-pb7x6pq","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613114428-6u6bjm1","Type":"NodeParagraph","Properties":{"id":"20240613114428-6u6bjm1","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240613114428-1dmd4a7","Type":"NodeParagraph","Properties":{"id":"20240613114428-1dmd4a7","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613114428-v1sqoai","Type":"NodeParagraph","Properties":{"id":"20240613114428-v1sqoai","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 为禾本科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"荩草"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"。秋季采收。"}]},{"ID":"20240613114428-y8k4t7w","Type":"NodeParagraph","Properties":{"id":"20240613114428-y8k4t7w","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613114428-gjscfum","Type":"NodeParagraph","Properties":{"id":"20240613114428-gjscfum","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 生长山坡草地和阴湿处。全国各地都有分布。"}]},{"ID":"20240613114428-8k0buab","Type":"NodeParagraph","Properties":{"id":"20240613114428-8k0buab","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613114428-mlkllv6","Type":"NodeParagraph","Properties":{"id":"20240613114428-mlkllv6","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 一年生草本。秆细弱，无毛，基部倾斜，高30～45厘米，多节，常分枝，基部的节着土后易生根。叶鞘短于节间，生短硬疣毛；叶舌膜质，边缘具纤毛；叶片卵状披针形，长2～4厘米，宽8～15毫米，基部星心形抱茎，除下部边缘生纤毛外，余均无毛。总状花序细弱，长1.5～3厘米，2～10枚，呈指状排列或簇生于茎顶；有柄小穗退化，仅剩短柄；无柄小穗长4～4.5毫米，卵状披针形，灰绿色或带紫色；第1颖具7～9脉，先端钝；第2颖与第1颖等长，舟形，具9脉，而两侧脉不明显，先端尖；第1外稃长圆形，先端尖，长约为第1颖的2/3；第2外稃与第1外稃等长，近基部伸出1曲膝的芒；雄蕊2，花药黄色或紫色，长0.7～1毫米。颖果长圆形，与稃体几等长。花、果期8～10月。"}]},{"ID":"20240613114428-76olgsl","Type":"NodeParagraph","Properties":{"id":"20240613114428-76olgsl","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613114428-y6u0fq8","Type":"NodeParagraph","Properties":{"id":"20240613114428-y6u0fq8","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 叶和茎含乌头酸、木犀草素、木犀草素-7-葡萄糖甙、荩草素。"}]},{"ID":"20240613114428-4lwx4kc","Type":"NodeParagraph","Properties":{"id":"20240613114428-4lwx4kc","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613114428-bq7r71m","Type":"NodeParagraph","Properties":{"id":"20240613114428-bq7r71m","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" ①《本经》:\"味苦，平。\""}]},{"ID":"20240613114428-wn0j5u7","Type":"NodeParagraph","Properties":{"id":"20240613114428-wn0j5u7","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"②《别录》:\"无毒。\""}]},{"ID":"20240613114428-ek9iqm7","Type":"NodeParagraph","Properties":{"id":"20240613114428-ek9iqm7","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613114428-yormtw9","Type":"NodeParagraph","Properties":{"id":"20240613114428-yormtw9","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》:\"畏鼠妇。\""}]},{"ID":"20240613114428-f78uxyc","Type":"NodeParagraph","Properties":{"id":"20240613114428-f78uxyc","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613114428-wmsx08q","Type":"NodeParagraph","Properties":{"id":"20240613114428-wmsx08q","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 止咳、定喘，杀虫。"}]},{"ID":"20240613114428-girdc1p","Type":"NodeParagraph","Properties":{"id":"20240613114428-girdc1p","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"①《本经》:\"主久咳上气喘逆，久寒，惊悸，痂疥，白秃疡气，杀皮肤小虫。\""}]},{"ID":"20240613114428-4ombs8k","Type":"NodeParagraph","Properties":{"id":"20240613114428-4ombs8k","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"②《药性论》:\"治一切恶疮。\""}]},{"ID":"20240613114428-bq9a3tx","Type":"NodeParagraph","Properties":{"id":"20240613114428-bq9a3tx","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"③《吉林中草药》:\"驱寒定喘。\""}]},{"ID":"20240613114428-9em1ns9","Type":"NodeParagraph","Properties":{"id":"20240613114428-9em1ns9","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613114428-tqou9gi","Type":"NodeParagraph","Properties":{"id":"20240613114428-tqou9gi","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 内服:煎汤，2～4钱。外用:煎水洗或捣敷。"}]},{"ID":"20240613114428-r9nniwj","Type":"NodeParagraph","Properties":{"id":"20240613114428-r9nniwj","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613114428-2xzee30","Type":"NodeParagraph","Properties":{"id":"20240613114428-2xzee30","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" ①治气喘上气:马耳草四钱。水煎，日服二次。（《吉林中草药》）"}]},{"ID":"20240613114428-m9cr7i6","Type":"NodeParagraph","Properties":{"id":"20240613114428-m9cr7i6","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"②治恶疮疥癣:马耳草捣烂敷患处。（《吉林中草药》）"}]},{"ID":"20240613114428-stxz5yh","Type":"NodeParagraph","Properties":{"id":"20240613114428-stxz5yh","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613114428-0hq0j8t","Type":"NodeParagraph","Properties":{"id":"20240613114428-0hq0j8t","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240613114428-ula77re","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240613114428-ula77re","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"《中华本草》：荩草"}]},{"ID":"20240613114428-sg2wkf1","Type":"NodeParagraph","Properties":{"id":"20240613114428-sg2wkf1","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240613114428-bodoajk","Type":"NodeParagraph","Properties":{"id":"20240613114428-bodoajk","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" Jìn Cǎo"}]},{"ID":"20240613114428-htp93zu","Type":"NodeParagraph","Properties":{"id":"20240613114428-htp93zu","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240613114428-7sc4bpw","Type":"NodeParagraph","Properties":{"id":"20240613114428-7sc4bpw","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 菉竹、王刍、戾草、黄草、蓐、鸱脚莎、盭草、晋灼、蓐草、细叶秀竹、马耳草、马耳朵草"}]},{"ID":"20240613114428-ox7p9an","Type":"NodeParagraph","Properties":{"id":"20240613114428-ox7p9an","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240613114428-dbsz81v","Type":"NodeParagraph","Properties":{"id":"20240613114428-dbsz81v","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" Herb of Hispid Arthraxon"}]},{"ID":"20240613114428-fey89hi","Type":"NodeParagraph","Properties":{"id":"20240613114428-fey89hi","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240613114428-uci42fw","Type":"NodeParagraph","Properties":{"id":"20240613114428-uci42fw","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》《唐本草》：荩草，叶似竹而细薄，茎亦圆小。生平泽溪涧之侧，荆襄人煮以染黄，色极鲜好。"}]},{"ID":"20240613114428-mkhzqdp","Type":"NodeParagraph","Properties":{"id":"20240613114428-mkhzqdp","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240613114428-c8h47fr","Type":"NodeParagraph","Properties":{"id":"20240613114428-c8h47fr","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 药材基源：为禾本科植物荩草的全草。"}]},{"ID":"20240613114428-1mz6s23","Type":"NodeParagraph","Properties":{"id":"20240613114428-1mz6s23","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Arthraxon hispidus (Thunb.) Makino"}]},{"ID":"20240613114428-6y1f0bg","Type":"NodeParagraph","Properties":{"id":"20240613114428-6y1f0bg","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"采收和储藏：7-9月割取全草，晒干。"}]},{"ID":"20240613114428-7f1ra9r","Type":"NodeParagraph","Properties":{"id":"20240613114428-7f1ra9r","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240613114428-39as3o3","Type":"NodeParagraph","Properties":{"id":"20240613114428-39as3o3","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 生态环境：生长于山坡、草地和阴湿处。"}]},{"ID":"20240613114428-cefb9my","Type":"NodeParagraph","Properties":{"id":"20240613114428-cefb9my","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"资源分布：全国均有分布。"}]},{"ID":"20240613114428-ujvfk8u","Type":"NodeParagraph","Properties":{"id":"20240613114428-ujvfk8u","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240613114428-ornt533","Type":"NodeParagraph","Properties":{"id":"20240613114428-ornt533","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 荩草，一年生草本。秆细弱无毛，基部倾斜，高30-45cm，分枝多节。叶鞘短于节间，有短硬疣毛；叶舌膜质，边缘具纤毛；叶片卵状披针形，长2-4cm，宽8-15mm，除下部边缘生纤毛外，余均无毛。总状花序细弱，长1.5-3cm，2-10个成指状排列或簇生于秆顶，穗轴节间无毛，长为小穗的2/3-3/4，小穗挛生，有柄小穗退化成0.2-1mm的柄；无柄小穗长4-4.5mm，卵状披针形，灰绿色或带紫色；第1颖边缘带膜质，有7-9脉，脉上粗糙，先端钝；第2颖近膜质，与第1颖等长，舟形，具3脉，侧脉不明显，先端尖；第1外稃，长圆形，先端尖，长约为第1颖的2/3，第2外稃与第1外稃等长，近基部伸出1膝曲的芒，芒长6-9mm，下部扭转；雄蕊2；花黄色或紫色，长0.7-1mm。颖果长圆形，与稃体几等长。花、果期8-11月。"}]},{"ID":"20240613114428-672d20e","Type":"NodeParagraph","Properties":{"id":"20240613114428-672d20e","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240613114428-2lrwvnk","Type":"NodeParagraph","Properties":{"id":"20240613114428-2lrwvnk","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 叶和茎含乌头酸(aconiti cacid)、木犀草素(luteolin)、木犀草素-7-葡萄糖甙(luteolin-7-glucoside)、荩草素(anthraxin)。"}]},{"ID":"20240613114428-zkslke0","Type":"NodeParagraph","Properties":{"id":"20240613114428-zkslke0","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240613114428-1a29ga3","Type":"NodeParagraph","Properties":{"id":"20240613114428-1a29ga3","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 苦；平"}]},{"ID":"20240613114428-im79u9b","Type":"NodeParagraph","Properties":{"id":"20240613114428-im79u9b","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"注意"}]},{"ID":"20240613114428-9of26b6","Type":"NodeParagraph","Properties":{"id":"20240613114428-9of26b6","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 《本草经集注》：畏鼠妇。"}]},{"ID":"20240613114428-1gfrhmj","Type":"NodeParagraph","Properties":{"id":"20240613114428-1gfrhmj","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240613114428-frehlcx","Type":"NodeParagraph","Properties":{"id":"20240613114428-frehlcx","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 止咳定喘；杀虫解毒。主久咳气喘；肝炎；咽喉炎；口腔炎；鼻炎；淋巴结炎；乳腺炎；疮疡疥癣"}]},{"ID":"20240613114428-6kgvi3t","Type":"NodeParagraph","Properties":{"id":"20240613114428-6kgvi3t","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240613114428-k8082kc","Type":"NodeParagraph","Properties":{"id":"20240613114428-k8082kc","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，6-15g。外用：适量，煎水洗或捣敷。"}]},{"ID":"20240613114428-s1mc1gf","Type":"NodeParagraph","Properties":{"id":"20240613114428-s1mc1gf","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240613114428-nfz6edt","Type":"NodeParagraph","Properties":{"id":"20240613114428-nfz6edt","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" ①治气喘上气：马耳草四钱。水煎，日服二次。(《吉林中草药》)②治恶疮疥癣：马耳草捣烂敷患处，(《吉林中草药》)"}]},{"ID":"20240613114428-newh0ym","Type":"NodeParagraph","Properties":{"id":"20240613114428-newh0ym","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"各家论述"}]},{"ID":"20240613114428-79ce57a","Type":"NodeParagraph","Properties":{"id":"20240613114428-79ce57a","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 1.《本经》：主久咳上气喘逆，久寒，惊悸，痂疥，白秃疡气，杀皮肤小虫。"}]},{"ID":"20240613114428-cr74uzr","Type":"NodeParagraph","Properties":{"id":"20240613114428-cr74uzr","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"2.《药性论》：治一切恶疮。"}]},{"ID":"20240613114428-ot2hxed","Type":"NodeParagraph","Properties":{"id":"20240613114428-ot2hxed","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"3.《吉林中草药》：驱寒定喘。"}]},{"ID":"20240613114428-hj7dogc","Type":"NodeParagraph","Properties":{"id":"20240613114428-hj7dogc","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240613114428-p2tpt6y","Type":"NodeParagraph","Properties":{"id":"20240613114428-p2tpt6y","updated":"20240613114428"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240613114430-lmczb15","Type":"NodeThematicBreak","Properties":{"id":"20240613114430-lmczb15"}},{"ID":"20240613114431-lh2480g","Type":"NodeParagraph","Properties":{"id":"20240613114431-lh2480g"}}]}