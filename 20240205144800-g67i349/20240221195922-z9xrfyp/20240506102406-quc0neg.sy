"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇含 5-20240823085230-uxt3bcs.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 572px;\" parent-style=\"width: 582px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240628145408-qvmskqi","Type":"NodeParagraph","Properties":{"id":"20240628145408-qvmskqi","updated":"20240823085515"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 741px;","style":"width: 731px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇含2"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇含2-20240628144739-fiq01kg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 731px;\" parent-style=\"width: 741px;\"}"},{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 522px;","style":"width: 512px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇含"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/蛇含-20240823084600-dcbknor.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 512px;\" parent-style=\"width: 522px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823085445-fu1k59d","Type":"NodeParagraph","Properties":{"id":"20240823085445-fu1k59d","updated":"20240823085446"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 555px;","style":"width: 545px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"蛇含 (1)"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/委陵菜13-20240708123127-olsbqns.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 545px;\" parent-style=\"width: 555px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20240823085545-zfbo9sz","Type":"NodeParagraph","Properties":{"id":"20240823085545-zfbo9sz","updated":"20240823085631"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注：蛇含与蛇莓相似，蛇含有五片叶，蛇莓三片叶；蛇含不结果，蛇莓会结红色如草莓的红色果实；"}]},{"ID":"20240612194917-knl27u0","Type":"NodeThematicBreak","Properties":{"id":"20240612194917-knl27u0","updated":"20240823085515"}},{"ID":"20240628145050-dcvjpy8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240628145050-dcvjpy8","updated":"20240628145054"},"Children":[{"Type":"NodeText","Data":"蛇合《神农本草经》"}]},{"ID":"20240628145050-731izg1","Type":"NodeParagraph","Properties":{"id":"20240628145050-731izg1","updated":"20240628145050"},"Children":[{"Type":"NodeText","Data":"（原注云，合是含字）"}]},{"ID":"20240628145050-evor3ms","Type":"NodeParagraph","Properties":{"id":"20240628145050-evor3ms","updated":"20240628145050"},"Children":[{"Type":"NodeText","Data":"味苦微寒。"}]},{"ID":"20240628145050-ybvxhr2","Type":"NodeParagraph","Properties":{"id":"20240628145050-ybvxhr2","updated":"20240628145050"},"Children":[{"Type":"NodeText","Data":"主惊痫寒热邪气，除热，金创，疽痔，鼠瘘，恶创，头疡。一名蛇衔。生山谷。"}]},{"ID":"20240628145050-5h3rdx9","Type":"NodeParagraph","Properties":{"id":"20240628145050-5h3rdx9","updated":"20240628145050"},"Children":[{"Type":"NodeText","Data":"《名医》曰：生益州，八月采，阴干。"}]},{"ID":"20240628145050-1h9ffc1","Type":"NodeParagraph","Properties":{"id":"20240628145050-1h9ffc1","updated":"20240628145050"},"Children":[{"Type":"NodeText","Data":"按本草图经云：或云是雀瓢，即是萝摩之别名。据陆玑云：芄兰一名萝摩，幽州谓之雀瓢，则即《尔雅》雚芄兰也，《唐本》草，别出萝摩条，非，又见女青。"}]},{"ID":"20240612194917-ay749aw","Type":"NodeThematicBreak","Properties":{"id":"20240612194917-ay749aw"}},{"ID":"20240612195111-letqu25","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195111-letqu25","updated":"20240612195117"},"Children":[{"Type":"NodeText","Data":"蛇合《神农本草经赞》"}]},{"ID":"20240612195111-bliryej","Type":"NodeParagraph","Properties":{"id":"20240612195111-bliryej","updated":"20240612195111"},"Children":[{"Type":"NodeText","Data":"味苦微寒。主惊痫。寒热邪气。除热。金创。疽痔鼠。恶疮头疡。一名蛇衔。生山谷。（合当作含）高冈湿隰。细叶黄花。青含蛇口。紫折龙牙。伤连断指。恶剪积瘕。涩酸竟命。知时灭瑕。"}]},{"ID":"20240612195111-7h7s7yz","Type":"NodeParagraph","Properties":{"id":"20240612195111-7h7s7yz","updated":"20240612195111"},"Children":[{"Type":"NodeText","Data":"苏颂曰。生土石上或下湿地。陶弘景曰。用细叶有黄花者。李时珍曰。根名女青。叶似龙牙而小。背紫色。异苑。昔有田父。见一蛇被伤。一蛇含此草着疮上。经日蛇愈。抱朴子。蛇衔膏连已断之指。直指方。研敷身面恶癣根断。雷论。勿用有柏尖叶者。号竟命草。其味涩酸。令人吐血。速服知时子可解。淮南子。抑微灭瑕。"}]},{"ID":"20240612195034-td79snb","Type":"NodeThematicBreak","Properties":{"id":"20240612195034-td79snb"}},{"ID":"20240612195059-dkk0qqj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195059-dkk0qqj","updated":"20240612195104"},"Children":[{"Type":"NodeText","Data":"蛇含草《冯氏锦囊秘录》"}]},{"ID":"20240612195059-c234bdr","Type":"NodeParagraph","Properties":{"id":"20240612195059-c234bdr","updated":"20240612195059"},"Children":[{"Type":"NodeText","Data":"蛇含草，除心腹邪气湿痹，疽痔鼠 恶疮，蛇蝎蜂螫，又用捣烂成膏，堪续己断手指。根名女菁，研末带之，则疫瘴不犯，主蛊毒而逐邪恶，杀鬼魅以辟不详。"}]},{"ID":"20240612195035-w6upl9j","Type":"NodeThematicBreak","Properties":{"id":"20240612195035-w6upl9j"}},{"ID":"20240612195050-uswu9mu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195050-uswu9mu","updated":"20240612195055"},"Children":[{"Type":"NodeText","Data":"蛇含草《滇南本草》"}]},{"ID":"20240612195050-tcst6i2","Type":"NodeParagraph","Properties":{"id":"20240612195050-tcst6i2","updated":"20240612195050"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"蛇含草（图缺）"},{"Type":"NodeText","Data":"，生田野间有水处，软枝细藤，叶绿，结子色赤，鲜艳似荔枝，鲜而润者佳。气味甘，性平。无毒。主治除心腹邪气，湿痹，疽痔、鼠 、恶疮，蛇、蝎、蜂螫之毒。捣烂成膏。有中瘟疫者，服之亦解。亦治蛊毒。采叶，晒干为末，收磁瓦器内，黄蜡封口，遇小儿中虫毒者，吹鼻孔中，虫自鼻孔即出。或遇中风不省人事者，服之立苏，中瘟疫者，吹之可解。敷无名肿毒立效。"}]},{"ID":"20240612195035-8zq328v","Type":"NodeThematicBreak","Properties":{"id":"20240612195035-8zq328v"}},{"ID":"20240612195036-08o5kaw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195036-08o5kaw","updated":"20240612195041"},"Children":[{"Type":"NodeText","Data":"蛇含草《本草崇原》"}]},{"ID":"20240612195036-zhx3mqs","Type":"NodeParagraph","Properties":{"id":"20240612195036-zhx3mqs","updated":"20240612195036"},"Children":[{"Type":"NodeText","Data":"气味苦，微寒，无毒。主治惊痫寒热，邪气除热，金疮疽痔，鼠 恶疮，头疡。"}]},{"ID":"20240612195036-4eqgo3v","Type":"NodeParagraph","Properties":{"id":"20240612195036-4eqgo3v","updated":"20240612195036"},"Children":[{"Type":"NodeText","Data":"（蛇含草始出益州山谷，今处处有之，生土石上或下湿地，蜀中人家亦种之辟蛇。一茎五叶或七叶。有两种，细叶者，名蛇含，一名紫背龙牙。大叶者，名龙含。含，一作衔。含、衔二字义同通用。陶隐君曰∶当用细叶、有黄花者。李时珍曰∶龙含亦入疮膏用。抱朴子曰∶蛇含膏连已断之指。）"}]},{"ID":"20240612195036-rsdgft7","Type":"NodeParagraph","Properties":{"id":"20240612195036-rsdgft7","updated":"20240612195036"},"Children":[{"Type":"NodeText","Data":"蛇含草始出西川，气味苦寒，花开黄色。西川，金也。苦寒，水也。黄色，土也。禀土金水之气化，金能制风，则惊痫之寒热可治也。寒能清热，则邪气之热气可除也。土能生肌，则金疮可治也。禀土金水之气，而和在下之经脉，则治疽痔。禀土金水之气，而和在上之经脉，则治鼠 ，恶疮，头疡。"}]},{"ID":"20240612194917-tdmnp7o","Type":"NodeThematicBreak","Properties":{"id":"20240612194917-tdmnp7o"}},{"ID":"20240612195023-vwnqu8t","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195023-vwnqu8t","updated":"20240612195028"},"Children":[{"Type":"NodeText","Data":"蛇含《增广和剂局方药性总论》"}]},{"ID":"20240612195023-r3bh7lw","Type":"NodeParagraph","Properties":{"id":"20240612195023-r3bh7lw","updated":"20240612195023"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主惊痫，寒热，邪气，除热，金疮，疽痔，鼠 ，恶疮，头疡，疗心腹邪气，腹痛湿痹，养胎，利小儿。《药性论》云∶臣。有毒。能治丹疹，小儿寒热。"}]},{"ID":"20240612195023-fulxi23","Type":"NodeParagraph","Properties":{"id":"20240612195023-fulxi23","updated":"20240612195023"},"Children":[{"Type":"NodeText","Data":"日华子云∶治蛇虫蜂虺所伤及眼赤，止血，协风疹、痈肿。茎叶俱用。又名威蛇。"}]},{"ID":"20240612194918-pp2igcb","Type":"NodeThematicBreak","Properties":{"id":"20240612194918-pp2igcb"}},{"ID":"20240612195009-w94qqmm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195009-w94qqmm","updated":"20240612195017"},"Children":[{"Type":"NodeText","Data":"蛇含《本草图经》"}]},{"ID":"20240612195009-jrlwwyk","Type":"NodeParagraph","Properties":{"id":"20240612195009-jrlwwyk","updated":"20240612195013"},"Children":[{"Type":"NodeText","Data":"蛇含，生益州山谷，今近处亦有之。生土石上，或下湿地。蜀中人家亦种之。一茎五叶或七叶。此有两种，当用细叶黄色花者为佳。八月采根，阴干。《古今录验方》治赤疹，用蛇衔草，捣令极烂，傅之，瘥。赤疹者，由冷湿搏于肌中，甚即为热，乃成赤疹，得天热则剧，冷则减是也。古今诸丹毒疮肿方通用之。又下有女青条云∶蛇衔根也，生朱崖。陶隐居、苏恭皆以为∶若是蛇衔根，不应独生朱崖。或云是雀瓢，即萝摩之别名，或云二物同名，以相类故也。医家鲜用，亦稀识别，故但附着于此。"}]},{"ID":"20240612194918-y4ogkcj","Type":"NodeThematicBreak","Properties":{"id":"20240612194918-y4ogkcj"}},{"ID":"20240612195000-e60buos","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612195000-e60buos","updated":"20240612195005"},"Children":[{"Type":"NodeText","Data":"蛇含《千金翼方》"}]},{"ID":"20240612195000-yaesol2","Type":"NodeParagraph","Properties":{"id":"20240612195000-yaesol2","updated":"20240612195000"},"Children":[{"Type":"NodeText","Data":"味苦，微寒，无毒。主惊痫，寒热邪气，除热，金疮疽痔，鼠 ，恶疮头疡。疗心腹邪气，腹痛，湿痹，养胎，利小儿。一名蛇衔。生益州山谷，八月采，阴干。"}]},{"ID":"20240612194918-gqna3qn","Type":"NodeThematicBreak","Properties":{"id":"20240612194918-gqna3qn"}},{"ID":"20240612194932-tsvs1oa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612194932-tsvs1oa","updated":"20240612194953"},"Children":[{"Type":"NodeText","Data":"蛇含《本草纲目》"}]},{"ID":"20240612194932-r0749ud","Type":"NodeParagraph","Properties":{"id":"20240612194932-r0749ud","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"「释名」蛇衔、威蛇、小龙牙、紫背龙牙。"}]},{"ID":"20240612194932-7xk1w7r","Type":"NodeParagraph","Properties":{"id":"20240612194932-7xk1w7r","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"「气味」苦、微寒、无毒。"}]},{"ID":"20240612194932-gj4514f","Type":"NodeParagraph","Properties":{"id":"20240612194932-gj4514f","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"「主治」"}]},{"ID":"20240612194932-w7dttie","Type":"NodeParagraph","Properties":{"id":"20240612194932-w7dttie","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"1、产后泻痢用蛇含极一反，浓煎服下。"}]},{"ID":"20240612194932-nmxco35","Type":"NodeParagraph","Properties":{"id":"20240612194932-nmxco35","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"2、刀伤出血。用蛇含草捣烂敷伤处。"}]},{"ID":"20240612194932-mz59fde","Type":"NodeParagraph","Properties":{"id":"20240612194932-mz59fde","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"3、身面恶癣。用蛇含草加生矾研敷。"}]},{"ID":"20240612194932-1gnwyg5","Type":"NodeParagraph","Properties":{"id":"20240612194932-1gnwyg5","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"4、蜈蚣、蝎伤用蛇含划揉碎敷伤处。"}]},{"ID":"20240612194932-sjkdqcv","Type":"NodeParagraph","Properties":{"id":"20240612194932-sjkdqcv","updated":"20240612194932"},"Children":[{"Type":"NodeText","Data":"5、痈肿瘀血、产后积血等。作蛇含、大黄、附子、芍药、大戟、细辛、独活，黄芩、当归，莽草、蜀椒各一两，薤白十四枚，共研为末，在酒中泡一夜，加猪油二斤熬成膏收存，用时每服一弹丸大的经量，温酒送下。一天服两次。病在体外，则用膏敷涂。此方名“蛇含膏”。"}]},{"ID":"20240612194918-t9ou1sa","Type":"NodeThematicBreak","Properties":{"id":"20240612194918-t9ou1sa"}},{"ID":"20240612194919-194h4ry","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612194919-194h4ry","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"《全国中草药汇编》：蛇含"}]},{"ID":"20240612194919-lcznswi","Type":"NodeParagraph","Properties":{"id":"20240612194919-lcznswi","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612194919-002eda4","Type":"NodeParagraph","Properties":{"id":"20240612194919-002eda4","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" Shé Hán"}]},{"ID":"20240612194919-hatqdqc","Type":"NodeParagraph","Properties":{"id":"20240612194919-hatqdqc","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612194919-kagixny","Type":"NodeParagraph","Properties":{"id":"20240612194919-kagixny","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 五匹风、五爪龙"}]},{"ID":"20240612194919-0fmqafc","Type":"NodeParagraph","Properties":{"id":"20240612194919-0fmqafc","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612194919-l3qsk1h","Type":"NodeParagraph","Properties":{"id":"20240612194919-l3qsk1h","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 蔷薇科委陵菜属植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛇含"},{"Type":"NodeText","Data":"Potentilla kleiniana Wight et Arn.，以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"入药。夏秋采收，鲜用或晒干。"}]},{"ID":"20240612194919-9y1hff0","Type":"NodeParagraph","Properties":{"id":"20240612194919-9y1hff0","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612194919-on2r91r","Type":"NodeParagraph","Properties":{"id":"20240612194919-on2r91r","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 苦，微寒。"}]},{"ID":"20240612194919-iy98dji","Type":"NodeParagraph","Properties":{"id":"20240612194919-iy98dji","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612194919-p059kka","Type":"NodeParagraph","Properties":{"id":"20240612194919-p059kka","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 清热解毒，止咳化痰。用于外感咳嗽，百日咳，咽喉肿痛，小儿高热惊风，疟疾，痢疾；外用治腮腺炎，乳腺炎，毒蛇咬伤，带状疱疹，疔疮，痔疮，外伤出血。"}]},{"ID":"20240612194919-rnl3ox3","Type":"NodeParagraph","Properties":{"id":"20240612194919-rnl3ox3","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612194919-hh04l8h","Type":"NodeParagraph","Properties":{"id":"20240612194919-hh04l8h","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 0.3～1两；外用适量，鲜全草捣烂敷或取汁搽患处。"}]},{"ID":"20240612194919-pgrk3e7","Type":"NodeParagraph","Properties":{"id":"20240612194919-pgrk3e7","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612194919-gxzik2l","Type":"NodeParagraph","Properties":{"id":"20240612194919-gxzik2l","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 《全国中草药汇编》"}]},{"ID":"20240612194919-na2fg4l","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612194919-na2fg4l","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"《中药大辞典》：蛇含"}]},{"ID":"20240612194919-airpju9","Type":"NodeParagraph","Properties":{"id":"20240612194919-airpju9","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612194919-h2oyy95","Type":"NodeParagraph","Properties":{"id":"20240612194919-h2oyy95","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" Shé Hán"}]},{"ID":"20240612194919-yzez835","Type":"NodeParagraph","Properties":{"id":"20240612194919-yzez835","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612194919-3fa3jfd","Type":"NodeParagraph","Properties":{"id":"20240612194919-3fa3jfd","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 蛇衔（《本经》），威蛇（《日华子本草》），小龙牙（《斗门方》），紫背龙牙（《本草图经》），紫背草（《仁斋直指方》），蛇包五披风（《植物名实图考》），五匹风（《草木便方》），五皮风、地五甲、五爪龙（《分类草药性》），地五加、五爪虎、五叶莓（《贵州民间方药集》），地五爪、五虎下山（《江西民间草药》），五爪风、五星草、五虎草（《湖南药物志》），五爪金龙、五叶蛇莓（《浙江民间常用草药》）。"}]},{"ID":"20240612194919-90957zu","Type":"NodeParagraph","Properties":{"id":"20240612194919-90957zu","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612194919-22gfmwm","Type":"NodeParagraph","Properties":{"id":"20240612194919-22gfmwm","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 《本经》"}]},{"ID":"20240612194919-s6kupn4","Type":"NodeParagraph","Properties":{"id":"20240612194919-s6kupn4","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612194919-zxo8qo8","Type":"NodeParagraph","Properties":{"id":"20240612194919-zxo8qo8","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 为蔷薇科植物"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"蛇含"},{"Type":"NodeText","Data":"的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全草"},{"Type":"NodeText","Data":"或"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"带根全草"},{"Type":"NodeText","Data":"。夏季采收。"}]},{"ID":"20240612194919-sdaou4m","Type":"NodeParagraph","Properties":{"id":"20240612194919-sdaou4m","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612194919-h5jtgza","Type":"NodeParagraph","Properties":{"id":"20240612194919-h5jtgza","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 生长于山坡或湿地。全国大部分地区有分布。"}]},{"ID":"20240612194919-3cekh6m","Type":"NodeParagraph","Properties":{"id":"20240612194919-3cekh6m","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612194919-ffuuf41","Type":"NodeParagraph","Properties":{"id":"20240612194919-ffuuf41","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 蛇含，又名：蛇含委陵菜。"}]},{"ID":"20240612194919-xt6rqvx","Type":"NodeParagraph","Properties":{"id":"20240612194919-xt6rqvx","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"多年生草本。主根短，侧根如须状丛生。茎多数，细长，略匍匐，具疏生的绢状毛。基生叶具长柄，茎生叶较小，柄短；掌状复叶；小叶3～5，椭圆形或狭倒卵形，长2～4厘米，宽0.5～1.7厘米，先端浑圆或钝尖，基部楔形，边缘上部有粗锯齿，下部全缘，上面近于无毛，下面脉间有绢状毛；托叶阔披针形，基部与叶柄结合。花小，成顶生的圆锥状聚伞花序；萼片5，卵状披针形，副萼5，近线形，背面均有少许毛；花瓣5，黄色，倒心脏形，先端稍凹；雄蕊多数；雌蕊多数，着生于花托上。瘦果有纵皱，无毛。花期4～5月。"}]},{"ID":"20240612194919-t5oyopi","Type":"NodeParagraph","Properties":{"id":"20240612194919-t5oyopi","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612194919-3zd345j","Type":"NodeParagraph","Properties":{"id":"20240612194919-3zd345j","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 苦辛，凉。"}]},{"ID":"20240612194919-i8xbevv","Type":"NodeParagraph","Properties":{"id":"20240612194919-i8xbevv","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"味苦，微寒。\""}]},{"ID":"20240612194919-rnf7wau","Type":"NodeParagraph","Properties":{"id":"20240612194919-rnf7wau","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"②《本草图经》：\"味辛甘，无毒。\""}]},{"ID":"20240612194919-qtywozn","Type":"NodeParagraph","Properties":{"id":"20240612194919-qtywozn","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"③《草木便方》：\"甘，平。\""}]},{"ID":"20240612194919-iy3uw33","Type":"NodeParagraph","Properties":{"id":"20240612194919-iy3uw33","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612194919-18u56vf","Type":"NodeParagraph","Properties":{"id":"20240612194919-18u56vf","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 清热，解毒。治惊痫高热，疟疾，咳嗽，喉痛，湿痹，痈疽癣疮，丹毒，痒疹，蛇、虫咬伤。"}]},{"ID":"20240612194919-ylnnkoo","Type":"NodeParagraph","Properties":{"id":"20240612194919-ylnnkoo","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"①《本经》：\"主惊痫，寒热邪气，除热，金疮，疽痔，鼠瘘恶疮，头疡。\""}]},{"ID":"20240612194919-q98e3t9","Type":"NodeParagraph","Properties":{"id":"20240612194919-q98e3t9","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"②《别录》：\"疗心腹邪气，腹痛，湿痹。\""}]},{"ID":"20240612194919-vjvazs7","Type":"NodeParagraph","Properties":{"id":"20240612194919-vjvazs7","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"③《药性论》：\"能治丹疹，小儿寒热。\""}]},{"ID":"20240612194919-mzhaac9","Type":"NodeParagraph","Properties":{"id":"20240612194919-mzhaac9","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"④《本草拾遗》：\"主蛇咬。\""}]},{"ID":"20240612194919-zrnpysn","Type":"NodeParagraph","Properties":{"id":"20240612194919-zrnpysn","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑤《日华子本草》：\"能治蛇虫蜂虺所伤及眼赤，止血，熁风疹痈肿。\""}]},{"ID":"20240612194919-nzqxn3a","Type":"NodeParagraph","Properties":{"id":"20240612194919-nzqxn3a","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑥《本草图经》：\"治咽喉中痛，含咽之。\""}]},{"ID":"20240612194919-0u1bqrb","Type":"NodeParagraph","Properties":{"id":"20240612194919-0u1bqrb","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑦《植物名实图考》：\"治咳嗽。\""}]},{"ID":"20240612194919-ul9dmjw","Type":"NodeParagraph","Properties":{"id":"20240612194919-ul9dmjw","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑧《草木便方》：\"发汗解肌。治风痰咳嗽，惊痫，洗眼消毒。\""}]},{"ID":"20240612194919-hclnxny","Type":"NodeParagraph","Properties":{"id":"20240612194919-hclnxny","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑨《分类草药性》：\"治咳嗽，风寒湿气，跌打损伤。\""}]},{"ID":"20240612194919-ligyfge","Type":"NodeParagraph","Properties":{"id":"20240612194919-ligyfge","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑩《湖南药物志》：\"治疯狗咬伤，脚背痛，痢疾。\""}]},{"ID":"20240612194919-hcajj4p","Type":"NodeParagraph","Properties":{"id":"20240612194919-hcajj4p","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612194919-13nudwe","Type":"NodeParagraph","Properties":{"id":"20240612194919-13nudwe","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，1.5～3钱，鲜者1～2两。外用：煎水洗，捣敷或煎水含漱。"}]},{"ID":"20240612194919-jjrc8ce","Type":"NodeParagraph","Properties":{"id":"20240612194919-jjrc8ce","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612194919-ni219gt","Type":"NodeParagraph","Properties":{"id":"20240612194919-ni219gt","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" ①治小儿惊风：㈠五皮风四钱，土升麻三钱，辰砂草二钱，银花藤二钱，土瓜根二钱。煎水服。㈡五成风三钱，全虫一个，僵虫一个，朱砂五分。各药研成细末，混合成散剂，开水吞服。（《贵阳民间药草》）"}]},{"ID":"20240612194919-zunx1o6","Type":"NodeParagraph","Properties":{"id":"20240612194919-zunx1o6","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"②治温疟、发高烧、咳嗽：五匹风五钱，白蔹二钱，紫苏三钱。加水煎汤，于发疟前两小时服用，每日一剂，连服三剂。（《贵州民间方药集》）"}]},{"ID":"20240612194919-dyg282m","Type":"NodeParagraph","Properties":{"id":"20240612194919-dyg282m","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"③治疟疾：蛇含五至七株（以无毛茎细者为好），泡开水服。（《浙江民间常用草药》）"}]},{"ID":"20240612194919-wx0f6bc","Type":"NodeParagraph","Properties":{"id":"20240612194919-wx0f6bc","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"④治伤风咳嗽：五皮风、排风藤。煎水服。"}]},{"ID":"20240612194919-mfwzg8f","Type":"NodeParagraph","Properties":{"id":"20240612194919-mfwzg8f","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑤治百日咳：五皮风五钱，生姜三片。煎水服。"}]},{"ID":"20240612194919-h455gii","Type":"NodeParagraph","Properties":{"id":"20240612194919-h455gii","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑥治麻疹后热咳：五成风、白蜡花、枇杷花各三钱。研末，加蜂蜜蒸服。（④方以下出《贵阳民间药草》）"}]},{"ID":"20240612194919-pbm74n5","Type":"NodeParagraph","Properties":{"id":"20240612194919-pbm74n5","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑦治风湿麻木：五匹风、生姜。熬水洗患处。（《贵州草药》）"}]},{"ID":"20240612194919-u5tv8xt","Type":"NodeParagraph","Properties":{"id":"20240612194919-u5tv8xt","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑧治痈肿，偏头痛：蛇含全草捣汁搽，或捣烂敷患处。（《湖南药物志》）"}]},{"ID":"20240612194919-e3qtt5h","Type":"NodeParagraph","Properties":{"id":"20240612194919-e3qtt5h","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑨治金疮：蛇含草捣烂敷之。（《肘后方》）"}]},{"ID":"20240612194919-t0fgp4i","Type":"NodeParagraph","Properties":{"id":"20240612194919-t0fgp4i","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑩治赤疹：蛇含草捣令极烂，敷之。（《古今录验方》）"}]},{"ID":"20240612194919-cgjzigx","Type":"NodeParagraph","Properties":{"id":"20240612194919-cgjzigx","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑾治蛇咬伤：五爪龙、山棕子各三两，一条边一两。上药一半煮汤，一半杵烂敷伤口。（《闽东本草》）"}]},{"ID":"20240612194919-ogepy89","Type":"NodeParagraph","Properties":{"id":"20240612194919-ogepy89","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑿治蜈蚣螫人，蛇含草挼敷之。（《斗门方》）"}]},{"ID":"20240612194919-2nyj89i","Type":"NodeParagraph","Properties":{"id":"20240612194919-2nyj89i","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒀治身面恶癣：紫背草入生矾研，敷二、三次。（《仁斋直指方》）"}]},{"ID":"20240612194919-3bvd0np","Type":"NodeParagraph","Properties":{"id":"20240612194919-3bvd0np","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒁治角膜溃疡：鲜蛇含全草三株。洗净，捣烂，敷患眼眉弓，一至二日换药一次。（《浙扛民间常用草药》）"}]},{"ID":"20240612194919-csz0y4y","Type":"NodeParagraph","Properties":{"id":"20240612194919-csz0y4y","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒂治雷公藤中毒：鲜蛇含全草二至四两，鲜构树枝梢（连叶）七、八枝。捣烂取汁，加鸭蛋清四只混匀，灌服。（《浙江民间常用草药》）"}]},{"ID":"20240612194919-zo69kjd","Type":"NodeParagraph","Properties":{"id":"20240612194919-zo69kjd","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒃产后泻痢用蛇含极一反，浓煎服下。"}]},{"ID":"20240612194919-i42jc12","Type":"NodeParagraph","Properties":{"id":"20240612194919-i42jc12","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒄刀伤出血。用蛇含草捣烂敷伤处。"}]},{"ID":"20240612194919-h8veot2","Type":"NodeParagraph","Properties":{"id":"20240612194919-h8veot2","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒅身面恶癣。用蛇含草加生矾研敷。"}]},{"ID":"20240612194919-wrg14rm","Type":"NodeParagraph","Properties":{"id":"20240612194919-wrg14rm","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒆蜈蚣、蝎伤用蛇含划揉碎敷伤处。"}]},{"ID":"20240612194919-yz9vilk","Type":"NodeParagraph","Properties":{"id":"20240612194919-yz9vilk","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⒇痈肿瘀血、产后积血等。作蛇含、大黄、附子、芍药、大戟、细辛、独活，黄芩、当归，莽草、蜀椒各一两，薤白十四枚，共研为末，在夺酒中泡一夜，加猪油二斤熬成膏收存，用时每服一弹丸大的经量，温酒送下。一天服两次。病在体外，则用膏敷涂。此方名\"蛇含膏\"。"}]},{"ID":"20240612194919-crlkf09","Type":"NodeParagraph","Properties":{"id":"20240612194919-crlkf09","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612194919-s244l1c","Type":"NodeParagraph","Properties":{"id":"20240612194919-s244l1c","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 治疗肠梗阻：取鲜蛇含全株4两，捣烂绞汁，冲入等量童便，稍加热，缓缓服下。冬季用干品，每次2两作煎剂，冲等量童便内服，同样有效。服药后如有剧烈呕吐吐出药液时，应补足服药量；采取小量多次服药方法，一般第2次服药即不呕吐。临床试治数例，均在24小时内见效。"}]},{"ID":"20240612194919-y96oqbi","Type":"NodeParagraph","Properties":{"id":"20240612194919-y96oqbi","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612194919-0do0kp5","Type":"NodeParagraph","Properties":{"id":"20240612194919-0do0kp5","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 《中药大辞典》"}]},{"ID":"20240612194919-lkbboeo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20240612194919-lkbboeo","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"《中华本草》：蛇含"}]},{"ID":"20240612194919-hupk1vk","Type":"NodeParagraph","Properties":{"id":"20240612194919-hupk1vk","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"拼音注音"}]},{"ID":"20240612194919-ht6t12z","Type":"NodeParagraph","Properties":{"id":"20240612194919-ht6t12z","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" Shé Hán"}]},{"ID":"20240612194919-fkjs2af","Type":"NodeParagraph","Properties":{"id":"20240612194919-fkjs2af","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"别名"}]},{"ID":"20240612194919-rnhww2d","Type":"NodeParagraph","Properties":{"id":"20240612194919-rnhww2d","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 蛇衔、威蛇、小龙牙、紫背龙牙、紫背草、蛇含草、蛇包五披风、五匹风、五皮风、地五甲、五爪龙、地五加、五爪虎、五叶莓、地五爪、五虎下山、五爪风、五星草、五虎草、五爪金龙、五叶蛇莓、狗脚迹"}]},{"ID":"20240612194919-dbmkahn","Type":"NodeParagraph","Properties":{"id":"20240612194919-dbmkahn","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"英文名"}]},{"ID":"20240612194919-efv95mm","Type":"NodeParagraph","Properties":{"id":"20240612194919-efv95mm","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" Herb of Klein cinquefoil"}]},{"ID":"20240612194919-whgvu3q","Type":"NodeParagraph","Properties":{"id":"20240612194919-whgvu3q","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"出处"}]},{"ID":"20240612194919-ege9637","Type":"NodeParagraph","Properties":{"id":"20240612194919-ege9637","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 出自《神农本草经》。"}]},{"ID":"20240612194919-rcqlefx","Type":"NodeParagraph","Properties":{"id":"20240612194919-rcqlefx","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"1.《名医别录》：蛇含生益州山谷。八月采，阴干。"}]},{"ID":"20240612194919-co01i1f","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20240612194919-co01i1f","updated":"20240612194919"},"Children":[{"ID":"20240612194919-hr08vlj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20240612194919-hr08vlj","updated":"20240612194919"},"Children":[{"ID":"20240612194919-t7wiz4c","Type":"NodeParagraph","Properties":{"id":"20240612194919-t7wiz4c","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"陶弘景：蛇衔有两种，并生石上，当用细叶黄花者，处处有之。亦生黄土地，不必皆 生石上也。"}]}]}]},{"ID":"20240612194919-oqvut3x","Type":"NodeParagraph","Properties":{"id":"20240612194919-oqvut3x","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"3.《纲目》：蛇含，草也，其叶似龙牙而小，背紫色，故俗名小龙牙，又名紫背龙牙； 苏颂《图经》重出紫背龙牙，今并为一。此二种：细叶者名蛇衔，大叶者名龙衔，亦入疮膏用。"}]},{"ID":"20240612194919-tbevsoe","Type":"NodeParagraph","Properties":{"id":"20240612194919-tbevsoe","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"来源"}]},{"ID":"20240612194919-e7lucog","Type":"NodeParagraph","Properties":{"id":"20240612194919-e7lucog","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 药材基源：为蔷薇科植物蛇含委陵菜的带根全草。"}]},{"ID":"20240612194919-tc03h6j","Type":"NodeParagraph","Properties":{"id":"20240612194919-tc03h6j","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"拉丁植物动物矿物名：Potentilla kleiniana Wight et Arn."}]},{"ID":"20240612194919-7y7xbcn","Type":"NodeParagraph","Properties":{"id":"20240612194919-7y7xbcn","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"采收和储藏：栽种后每年可收2次，在5月和9-10月挖取全草，抖净泥沙，拣去杂质，晒干。"}]},{"ID":"20240612194919-xeziat2","Type":"NodeParagraph","Properties":{"id":"20240612194919-xeziat2","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"生境分布"}]},{"ID":"20240612194919-jl38uhi","Type":"NodeParagraph","Properties":{"id":"20240612194919-jl38uhi","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 生态环境：生于海拔200-3000m的田边、水旁、草甸及山坡草地。"}]},{"ID":"20240612194919-ywd5i0o","Type":"NodeParagraph","Properties":{"id":"20240612194919-ywd5i0o","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"资源分布：分布于华东、中南、西南及辽宁、陕西、西藏等地。"}]},{"ID":"20240612194919-x2fw3x7","Type":"NodeParagraph","Properties":{"id":"20240612194919-x2fw3x7","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"原形态"}]},{"ID":"20240612194919-wyrcbiy","Type":"NodeParagraph","Properties":{"id":"20240612194919-wyrcbiy","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 蛇含委陵菜，一年生、二年生或多年生宿根草本。多须根；茎平卧，具匍匐茎，常于节处生根并发育出新植株，花茎被疏柔毛或开展长柔毛。基生叶为近于鸟足状5小叶；叶柄被疏柔毛或开展长柔毛。基生叶为近于鸟足状5小叶；叶柄被疏柔毛或开展长柔毛，小叶近无柄稀有短柄；托叶膜质，淡褐色，外被疏柔毛或脱落近无毛；小叶片倒卵形或长圆卵形，长0.5-4cm，宽0.4-2cm，先端圆钝，基部楔形，边缘有多数急尖或圆钝锯齿，两面被疏柔毛，有时上面脱少近无毛或下面沿脉被伏生长柔毛；下部茎生叶有5小叶，上部茎生叶有3小叶，与基生相似，唯叶柄较短，托叶草质，卵形至卵状披针形，全缘，稀有1-2齿，先端急尖或渐尖，外被疏长柔毛。花两性；聚伞花序密集枝顶如假伞形，花梗密被开展长柔秘，下有茎生叶如苞片状；花直径0.5-1cm；萼片5，三角卵圆形，先端急尖或渐尖，副萼片5，披针形或椭圆披针形，先端急尖或渐尖。，花时比萼片短，果时略长或近等长，外被疏长柔毛；花瓣5，倒卵形，先端微凹。，长于萼片，黄色；花柱近顶生。瘦果近圆形，一面稍平，直径约0.5mm，具皱纹。花、果期4-9月。"}]},{"ID":"20240612194919-mms256i","Type":"NodeParagraph","Properties":{"id":"20240612194919-mms256i","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"栽培"}]},{"ID":"20240612194919-dhaii1o","Type":"NodeParagraph","Properties":{"id":"20240612194919-dhaii1o","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 生特学特性，喜阳光充足、气候温和、较湿润的环境，适应性较强，在高山同、丘陵、平坝都可栽培。对土壤无严格选择，常野生在荒地、田边或路旁，以地势向阳、较肥沃、潮湿的夹砂土栽培较好。"}]},{"ID":"20240612194919-pzq75mb","Type":"NodeParagraph","Properties":{"id":"20240612194919-pzq75mb","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"栽培技术，以分株繁殖为主。挖取老株匍匐茎上着生的新株作为种苗，每株都要带须根，春季2-3月或秋季9-10月栽种，以秋栽为好，按行窝距各20cm开窝，每窝栽苗2-3株，盖土压昆，并施稀薄人畜粪水。"}]},{"ID":"20240612194919-4qemco4","Type":"NodeParagraph","Properties":{"id":"20240612194919-4qemco4","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"田间管理，栽后要及时淋水。秋季栽种的，当年12月中耕除草、追肥1次，以后每年要随时拔除杂草，并于5月和9-10月两次收获后，浅中耕、假定肥1次。肥料用人畜粪水或硫酸铵，连续采收3-4年后，需换地栽培。"}]},{"ID":"20240612194919-er6n64g","Type":"NodeParagraph","Properties":{"id":"20240612194919-er6n64g","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"性状"}]},{"ID":"20240612194919-zxsn6v6","Type":"NodeParagraph","Properties":{"id":"20240612194919-zxsn6v6","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 性状鉴别，全体长约40cm。根茎粗短，根多数，须状。茎细长，多分枝，被疏毛。叶掌状复叶；基生叶有5小叶，小叶倒卵形或倒披针形，长1-5cm，宽0.5-1.5cm，边缘具粗锯齿，上下表面均被毛，茎生叶有3-5小叶。花多，黄色。果实表面微有皱纹。气微，味苦、微涩。"}]},{"ID":"20240612194919-9kmlrh6","Type":"NodeParagraph","Properties":{"id":"20240612194919-9kmlrh6","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"显微鉴别，叶表面观：上下表能上能下细胞垂周壁平直或微弯曲。气孔不定式或不等式。非腺毛微弯曲，长112-950μm，直径20μm。草酸钙簇晶直径28μm。"}]},{"ID":"20240612194919-4elup57","Type":"NodeParagraph","Properties":{"id":"20240612194919-4elup57","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"化学成分"}]},{"ID":"20240612194919-hjvtkq6","Type":"NodeParagraph","Properties":{"id":"20240612194919-hjvtkq6","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 全株含仙鹤草素(agrimoniin)，蛇含鞣质(potentillin)，长梗马铃素(pedunculagin)。"}]},{"ID":"20240612194919-d96io6r","Type":"NodeParagraph","Properties":{"id":"20240612194919-d96io6r","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"归经"}]},{"ID":"20240612194919-mx98z27","Type":"NodeParagraph","Properties":{"id":"20240612194919-mx98z27","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 肝；肺经"}]},{"ID":"20240612194919-dk6m8qd","Type":"NodeParagraph","Properties":{"id":"20240612194919-dk6m8qd","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"性味"}]},{"ID":"20240612194919-xa7k2ec","Type":"NodeParagraph","Properties":{"id":"20240612194919-xa7k2ec","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 味苦；性现寒"}]},{"ID":"20240612194919-jdyn8i5","Type":"NodeParagraph","Properties":{"id":"20240612194919-jdyn8i5","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"功能主治"}]},{"ID":"20240612194919-i2jhg70","Type":"NodeParagraph","Properties":{"id":"20240612194919-i2jhg70","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 清热定惊；截疟；止咳化痰；解毒活血。主高热惊风；疟疾；肺热咳嗽；百晶咳；痢疾；疮疖肿毒；咽喉肿痛；风火牙痛；带状疱疹；目赤肿痛；虫蛇咬伤；风湿麻木；跌打损伤；月经不调；外伤出血"}]},{"ID":"20240612194919-so22pt2","Type":"NodeParagraph","Properties":{"id":"20240612194919-so22pt2","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"用法用量"}]},{"ID":"20240612194919-07oaxxg","Type":"NodeParagraph","Properties":{"id":"20240612194919-07oaxxg","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 内服：煎汤，9-15g，鲜品倍量。外用：适量，煎水洗或捣敷；或捣汁涂；或煎水含漱。"}]},{"ID":"20240612194919-b4hhonr","Type":"NodeParagraph","Properties":{"id":"20240612194919-b4hhonr","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"复方"}]},{"ID":"20240612194919-l5chtg5","Type":"NodeParagraph","Properties":{"id":"20240612194919-l5chtg5","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" ①治小儿惊风： 一、五皮风四钱，土升麻三钱，辰砂草二钱，银花藤二钱，土瓜根二钱。煎水服。二、五皮风三钱，全虫一个，僵虫一个，朱砂五分。各药研成细末，混合 成散剂，开水吞服。(《贵阳民间药草》)②治温疟、发高烧、咳嗽： 五匹风五钱，白蔹二钱，紫苏三钱。加水煎汤，于发疟前两小 时服用，每日一剂，连服三剂。(《贵州民间方药集》)③治疟疾： 蛇含五至七株(以无毛茎细者为好)，泡开水服。(《浙江民间常用草药》)④治伤风咳嗽： 五皮风、排风藤。煎水服。"}]},{"ID":"20240612194919-itc3sqi","Type":"NodeParagraph","Properties":{"id":"20240612194919-itc3sqi","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑤治百日咳： 五皮风五钱，生姜三片。煎水服。"}]},{"ID":"20240612194919-c2zt6ua","Type":"NodeParagraph","Properties":{"id":"20240612194919-c2zt6ua","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"⑥治麻疹后热咳： 五皮风、白蜡花、楷杷花各三钱。研末，加蜂蜜蒸服。(④方以下出《 贵阳民间药草》)⑦治风湿麻木： 五匹风、生姜。熬水洗患处。(《贵州草药》)⑧治痈肿，偏头痛： 蛇含全草捣汁搽，或捣烂敷患处。(《湖南药物志》)⑨治金疮： 蛇含草捣烂敷之。(《肘后方》)⑩治赤疹： 蛇含草捣令极烂，敷之。 (《古今录验方》)11.治蛇咬伤： 五爪龙、山棕子各三两，一条边一两。上药一半煮汤，一半粹烂敷伤口。 (《闽东本草》)12.治螟蚁螫人，蛇含草挼敷之。(《斗门方》)13.治身面恶癣： 紫背草入生矾研，敷二、三次。(《仁斋直指方》)14.治角膜溃疡： 鲜蛇含全草三株。洗净，捣烂，敷患眼眉弓，一至二日换药一次。(《 浙江民间常用草药》)15.治雷公藤中毒：鲜蛇含全草二至四两，鲜构树枝梢(连叶)七、八枝。捣烂取汁，加鸭蛋清四只混匀，灌服。(《浙江民间常用草药》)"}]},{"ID":"20240612194919-mrcb4ci","Type":"NodeParagraph","Properties":{"id":"20240612194919-mrcb4ci","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"临床应用"}]},{"ID":"20240612194919-h4xwzq2","Type":"NodeParagraph","Properties":{"id":"20240612194919-h4xwzq2","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 治疗肠梗阻。取鲜蛇含全株4两，捣烂绞汁，冲入等量童便，稍加热，缓缓服下。冬季用干品，每次2两作煎剂，冲等量童便内服，同样有效。服药后如有剧烈呕吐吐出药液时，应补足服药量；采取小量多次服药方法，一般第2次服药即不呕吐。临床试治数例，均在24小时内见效。"}]},{"ID":"20240612194919-2x0uq30","Type":"NodeParagraph","Properties":{"id":"20240612194919-2x0uq30","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":"摘录"}]},{"ID":"20240612194919-hv3wvk9","Type":"NodeParagraph","Properties":{"id":"20240612194919-hv3wvk9","updated":"20240612194919"},"Children":[{"Type":"NodeText","Data":" 《中华本草》"}]},{"ID":"20240612194921-0d92ixl","Type":"NodeThematicBreak","Properties":{"id":"20240612194921-0d92ixl"}},{"ID":"20240612194922-fyj5jl4","Type":"NodeParagraph","Properties":{"id":"20240612194922-fyj5jl4"}}]}