{"ID":"20240506102408-a2yo2s3","Spec":"1","Type":"NodeDocument","Properties":{"custom-sy-readonly":"false","id":"20240506102408-a2yo2s3","scroll":"\u0026#123;\u0026quot;rootId\u0026quot;:\u0026quot;20240506102408-a2yo2s3\u0026quot;,\u0026quot;startId\u0026quot;:\u0026quot;20240702094922-66stmmm\u0026quot;,\u0026quot;endId\u0026quot;:\u0026quot;20240613113824-5jh09bx\u0026quot;,\u0026quot;scrollTop\u0026quot;:3400\u0026#125;","title":"308陆英（八棱麻、接骨草）","type":"doc","updated":"20240826113531"},"Children":[{"ID":"20240702094922-66stmmm","Type":"NodeParagraph","Properties":{"id":"20240702094922-66stmmm","updated":"20240826100811"},"Children":[{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 322px;","style":"width: 312px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"陆英5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/陆英5-20240702094947-xvla9rb.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 312px;\" parent-style=\"width: 322px;\"}"},{"Type":"NodeText","Data":"​​"}]},{"ID":"20240826100850-rb2vqa8","Type":"NodeParagraph","Properties":{"id":"20240826100850-rb2vqa8","updated":"20240826100850"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 391px;","style":"width: 381px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"陆英"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/陆英-20240826100850-d18gayu.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 381px;\" parent-style=\"width: 391px;\"}"},{"Type":"NodeText","Data":"​​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"width: 382px;","style":"width: 372px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","D